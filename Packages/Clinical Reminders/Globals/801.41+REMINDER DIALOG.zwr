^PXRMD(801.41,10564,25,0)="^^10^10^3141114"
^PXRMD(801.41,10564,25,1,0)="If not already done, implement steps 1-5 before further assessment:"
^PXRMD(801.41,10564,25,2,0)="\\1. Isolate patient in single room with a private bathroom and with the "
^PXRMD(801.41,10564,25,3,0)="door to hallway closed"
^PXRMD(801.41,10564,25,4,0)="\\2. Implement standard, contact, and droplet precautions (gown, facemask,"
^PXRMD(801.41,10564,25,5,0)="eye protection, and gloves) "
^PXRMD(801.41,10564,25,6,0)="\\3. Notify the hospital Infection Control Program and other appropriate"
^PXRMD(801.41,10564,25,7,0)="staff "
^PXRMD(801.41,10564,25,8,0)="\\4. Evaluate for any risk exposures for Ebola"
^PXRMD(801.41,10564,25,9,0)="\\5. IMMEDIATELY report to the health department\\"
^PXRMD(801.41,10564,25,10,0)="\\"
^PXRMD(801.41,10564,35,0)="^^10^10^3141114"
^PXRMD(801.41,10564,35,1,0)="\\Because of the presence of fever or symptoms the following steps"
