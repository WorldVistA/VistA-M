^PXRMD(801.41,15161,0)="VA-GP TEXT PNEUMOC PCV13 WARNING^^^G^^Y^2^0^0^0^1"
^PXRMD(801.41,15161,2)="^^1"
^PXRMD(801.41,15161,10,0)="^801.412IA^2^1"
^PXRMD(801.41,15161,10,2,0)="4^15163"
