^PXRMD(801.41,40360,0)="VA-HERPES ZOSTER GUIDANCE DETAILS^^^E^^^^^^^1"
^PXRMD(801.41,40360,2)="^^1"
^PXRMD(801.41,40360,25,0)="^^61^61^3160523"
^PXRMD(801.41,40360,25,1,0)="{FLD:NCP HERPES ZOSTER GUIDANCE}"
^PXRMD(801.41,40360,25,2,0)=" "
^PXRMD(801.41,40360,25,3,0)="{FLD:CDC ZOSTER VACCINE RECOMMENDATIONS} "
^PXRMD(801.41,40360,25,4,0)=" "
^PXRMD(801.41,40360,25,5,0)="RECOMMENDATION: The CDC recommends all adults aged 60 and older receive a "
^PXRMD(801.41,40360,25,6,0)="one-time dose of Herpes Zoster vaccine."
^PXRMD(801.41,40360,25,7,0)=" "
^PXRMD(801.41,40360,25,8,0)="CONTRAINDICATIONS:"
^PXRMD(801.41,40360,25,9,0)=" "
^PXRMD(801.41,40360,25,10,0)="- History of anaphylactic reaction to any components of the vaccine, "
^PXRMD(801.41,40360,25,11,0)="  including gelatin and neomycin."
^PXRMD(801.41,40360,25,12,0)=" "
^PXRMD(801.41,40360,25,13,0)="- Immunosuppressed persons (AIDS with CD4+ T-lymphocyte values <200 per "
^PXRMD(801.41,40360,25,14,0)="  mm or <15% ot total lymphocytes or other clinical manifestations of "
^PXRMD(801.41,40360,25,15,0)="  HIV, leukemia, lymphomas, or other mailgnant neoplasms affecting the "
^PXRMD(801.41,40360,25,16,0)="  bone marrow or lymphatic system.)"
^PXRMD(801.41,40360,25,17,0)=" "
^PXRMD(801.41,40360,25,18,0)="- Persons on immunosuppressive therapy, including high-dose "
^PXRMD(801.41,40360,25,19,0)="  corticosteroids (>20 mg/day of prednisone or equivalent) lasting tow or "
^PXRMD(801.41,40360,25,20,0)="  more weeks."
^PXRMD(801.41,40360,25,21,0)=" "
^PXRMD(801.41,40360,25,22,0)="- Persons receiving recombinant human immune mediators and immune "
^PXRMD(801.41,40360,25,23,0)="  modulators, especially the antitumor necrosis factor agents, such as "
^PXRMD(801.41,40360,25,24,0)="  adalimumab, infliximab, etanercept, and certolizumab pegol."
^PXRMD(801.41,40360,25,25,0)=" "
^PXRMD(801.41,40360,25,26,0)="- Persons taking chronic acyclovir, famciclovir, valacyclovir, or other "
^PXRMD(801.41,40360,25,27,0)="  antiviral therapy that inhibits varicella zoster virus replication."
^PXRMD(801.41,40360,25,28,0)=" "
^PXRMD(801.41,40360,25,29,0)="- Persons with clinical or laboratory evidence of other unspecified "
^PXRMD(801.41,40360,25,30,0)="  cellular immunodeficiency."
^PXRMD(801.41,40360,25,31,0)=" "
^PXRMD(801.41,40360,25,32,0)="- Active, untreatable tuberculosis"
^PXRMD(801.41,40360,25,33,0)=" "
^PXRMD(801.41,40360,25,34,0)="- Persons pregnant, or may be pregnant. Women should not become pregnant "
^PXRMD(801.41,40360,25,35,0)="  until at least 4 weeks after getting the Herpes Zoster vaccine."
^PXRMD(801.41,40360,25,36,0)=" "
^PXRMD(801.41,40360,25,37,0)="- Persons undergoing hematopoietic stem cell transplantation (HSCT). The "
^PXRMD(801.41,40360,25,38,0)="  experience of HSCT recipients with VZV-containing vaccines (e.g., zoster"
^PXRMD(801.41,40360,25,39,0)="  vaccine) is limited. Providers should assess the immune status of the "
^PXRMD(801.41,40360,25,40,0)="  recipient on a case-by-case basis to determine the relevant risks."
^PXRMD(801.41,40360,25,41,0)=" "
^PXRMD(801.41,40360,25,42,0)="PRECAUTIONS:"
^PXRMD(801.41,40360,25,43,0)=" "
^PXRMD(801.41,40360,25,44,0)="- Zoster vaccination of persons who have severe acute illness should be "
^PXRMD(801.41,40360,25,45,0)="  postponed until recovery. Zoster vaccine can be administered to persons "
^PXRMD(801.41,40360,25,46,0)="  who have mild acute illnesses with or without fever."
^PXRMD(801.41,40360,25,47,0)=" "
^PXRMD(801.41,40360,25,48,0)="- Breastfeeding women"
^PXRMD(801.41,40360,25,49,0)=" "
^PXRMD(801.41,40360,25,50,0)="- Patients receiving low-dose immunosuppressive medications."
^PXRMD(801.41,40360,25,51,0)=" "
^PXRMD(801.41,40360,25,52,0)="- VHA clinicians should use clinical judgment for patients on low-dose"
^PXRMD(801.41,40360,25,53,0)="  immunosuppressive therapy, including low-doses of "
^PXRMD(801.41,40360,25,54,0)="  Methotrexate (<0.4 mg/Kg/week), Azathioprine (<3.0 mg/Kg/day), or"
^PXRMD(801.41,40360,25,55,0)="  6-mercaptopurine 1.5 mg/Kg/day). "
^PXRMD(801.41,40360,25,56,0)="  These doses are not considered sufficiently immunosuppressive to create"
^PXRMD(801.41,40360,25,57,0)="  vaccine safety concerns and are not contraindications for administration"
^PXRMD(801.41,40360,25,58,0)="  of zoster vaccine. However, clinicians should have and document a "
^PXRMD(801.41,40360,25,59,0)="  conversation using shared decision making about potential benefits and"
^PXRMD(801.41,40360,25,60,0)="  harms before ordering zoster immunization in patients on low-dose "
^PXRMD(801.41,40360,25,61,0)="  immunosuppressive therapy."
^PXRMD(801.41,40360,100)="N"
^PXRMD(801.41,40360,110,0)="^801.44D^1^1"
^PXRMD(801.41,40360,110,1,0)="3160523.130632^54"
^PXRMD(801.41,40360,110,1,1,0)="^^1^1^3160523"
^PXRMD(801.41,40360,110,1,1,1,0)="Exchange Install"
