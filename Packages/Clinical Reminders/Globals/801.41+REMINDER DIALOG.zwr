^PXRMD(801.41,10552,0)="VA-TEXT TDAP VHA GUIDANCE-GENERAL^^^E^^^^^^^1"
^PXRMD(801.41,10552,1)="^^5"
^PXRMD(801.41,10552,2)="^^1"
^PXRMD(801.41,10552,25,0)="^^25^25^3160523"
^PXRMD(801.41,10552,25,1,0)="A single dose of Tetanus Toxoid, Reduced Diphtheria Toxoid and "
^PXRMD(801.41,10552,25,2,0)="Acellular Pertussis vaccine (Tdap) should be given regardless of when the"
^PXRMD(801.41,10552,25,3,0)="last Tetanus containing product was received in adults who have not"
^PXRMD(801.41,10552,25,4,0)="previously received Tdap. In addition, pregnant women should receive an"
^PXRMD(801.41,10552,25,5,0)="additional dose during each pregnancy."
^PXRMD(801.41,10552,25,6,0)=" "
^PXRMD(801.41,10552,25,7,0)="When to Administer:"
^PXRMD(801.41,10552,25,8,0)="Each pregnancy with Tdap (preferably during the third trimester)."
^PXRMD(801.41,10552,25,9,0)=" "
^PXRMD(801.41,10552,25,10,0)="Adults who have or who anticipate having close contact with an infant "
^PXRMD(801.41,10552,25,11,0)="aged <12 months (e.g., parents, grandparents, child-care providers, and "
^PXRMD(801.41,10552,25,12,0)="health care providers [HCPs]) should receive a single dose of Tdap as "
^PXRMD(801.41,10552,25,13,0)="soon as feasible if they have not previously received Tdap or if "
^PXRMD(801.41,10552,25,14,0)="immunization status is unknown. Ideally, these adults should receive Tdap "
^PXRMD(801.41,10552,25,15,0)="at least 2 weeks before beginning close contact with the infant."
^PXRMD(801.41,10552,25,16,0)=" "
^PXRMD(801.41,10552,25,17,0)="Patients who are health-care personnel (HCP) who work in hospitals or "
^PXRMD(801.41,10552,25,18,0)="ambulatory care settings and have direct patient contact should receive a "
^PXRMD(801.41,10552,25,19,0)="single dose of Tdap as soon as feasible if they have not previously "
^PXRMD(801.41,10552,25,20,0)="received Tdap."
^PXRMD(801.41,10552,25,21,0)=" "
^PXRMD(801.41,10552,25,22,0)="If a vaccine other than Tdap is also indicated, it should be administered "
^PXRMD(801.41,10552,25,23,0)="during the same visit (i.e., simultaneous vaccination). Each vaccine "
^PXRMD(801.41,10552,25,24,0)="should be administered using a separate syringe at a different anatomic "
^PXRMD(801.41,10552,25,25,0)="site."
^PXRMD(801.41,10552,100)="N^28"
^PXRMD(801.41,10552,110,0)="^801.44D^1^1"
^PXRMD(801.41,10552,110,1,0)="3160523.130624^54"
^PXRMD(801.41,10552,110,1,1,0)="^^1^1^3160523"
^PXRMD(801.41,10552,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,10552,110,"B",3160523.130624,1)=""
^PXRMD(801.41,10553,0)="VA-EBOLA RISK TRIAGE TOOL^^^R"
^PXRMD(801.41,10553,10,0)="^801.412IA^1^1"
