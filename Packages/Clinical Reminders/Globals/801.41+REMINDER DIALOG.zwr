^PXRMD(801.41,10467,0)="VA-TEXT TD/TDAP PRIOR INST^^^E^^^^^^^1"
^PXRMD(801.41,10467,1)="^^5"
^PXRMD(801.41,10467,2)="^^1"
^PXRMD(801.41,10467,25,0)="^^12^12^3160523"
^PXRMD(801.41,10467,25,1,0)="      **  If the vaccine was given PRIOR to June 1, 2005, then it was "
^PXRMD(801.41,10467,25,2,0)="          probably the Td vaccine."
^PXRMD(801.41,10467,25,3,0)="          If the vaccine was given AFTER June 1, 2005, record it as the  "
^PXRMD(801.41,10467,25,4,0)="          Tdap vaccine ONLY if the patient knows that pertussis was"
^PXRMD(801.41,10467,25,5,0)="          included in the vaccine."
^PXRMD(801.41,10467,25,6,0)=" "
^PXRMD(801.41,10467,25,7,0)="     Adults who are due for but have not yet received a dose of "
^PXRMD(801.41,10467,25,8,0)="     Tdap or whose immunization status is unknown should receive"
^PXRMD(801.41,10467,25,9,0)="     a dose of Tdap as soon as feasible. Tdap can be administered"
^PXRMD(801.41,10467,25,10,0)="     regardless of interval since the last tetanus or diphtheria"
^PXRMD(801.41,10467,25,11,0)="     containing vaccine."
^PXRMD(801.41,10467,25,12,0)="\\"
