^PXRMD(801.41,5106,25,1,0)=" "
^PXRMD(801.41,5106,25,2,0)="    Look for the Warning Signs: "
^PXRMD(801.41,5106,25,3,0)="     - Threatening to hurt or kill self"
^PXRMD(801.41,5106,25,4,0)="     - Looking for ways to kill self"
^PXRMD(801.41,5106,25,5,0)="     - Seeking access to pills, weapons, or other means"
^PXRMD(801.41,5106,25,6,0)="     - Talking or writing about death, dying or suicide"
^PXRMD(801.41,5106,25,7,0)=" "
^PXRMD(801.41,5106,25,8,0)="    Presence of any of the ABOVE warning signs requires immediate"
^PXRMD(801.41,5106,25,9,0)="    attention and referral."
^PXRMD(801.41,5106,25,10,0)=" "
^PXRMD(801.41,5106,25,11,0)="    Look for Additional Warning Signs: "
^PXRMD(801.41,5106,25,12,0)="    Hopelessness, Rage, Acting recklessly, Engaging in risky activities, "
^PXRMD(801.41,5106,25,13,0)="    Feeling trapped, Increased alcohol or drug abuse, Withdrawing from "
^PXRMD(801.41,5106,25,14,0)="    family, friends or society, Anxiety, Agitation, Inability to sleep, or"
^PXRMD(801.41,5106,25,15,0)="    Sleeping all the time, Dramatic changes in mood, Perceiving no reason"
^PXRMD(801.41,5106,25,16,0)="    for living, or No sense of purpose in life, etc."
^PXRMD(801.41,5106,25,17,0)=" "
^PXRMD(801.41,5106,25,18,0)="    For any of these additional warning signs, refer for mental health"
^PXRMD(801.41,5106,25,19,0)="    treatment or follow-up appointment."
^PXRMD(801.41,5106,100)="N"
