^PXRMD(801.41,612000457,0)="VA-TEXT HTN OBESITY (1)^^^E"
^PXRMD(801.41,612000457,25,0)="^^1^1^3061122"
^PXRMD(801.41,612000457,25,1,0)="Wt loss to within 10 percent of IBW, benefit of even 5-10 lb wt loss"
^PXRMD(801.41,612000457,35,0)="^^3^3^3061122"
^PXRMD(801.41,612000457,35,1,0)="The patient was counseled to reduce their weight to within 10 percent of"
^PXRMD(801.41,612000457,35,2,0)="their ideal body weight.   The possible improvement in BP control"
^PXRMD(801.41,612000457,35,3,0)="with even 5 to 10 pounds of weight loss was reviewed."
