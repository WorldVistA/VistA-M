^PXRMD(801.41,10564,35,3,0)="\\1.  Isolate patient in single room with a private bathroom and"
^PXRMD(801.41,10564,35,4,0)="\\    with the door to hallway closed"
^PXRMD(801.41,10564,35,5,0)="\\2.  Implement standard, contact, and droplet precautions (gown,"
^PXRMD(801.41,10564,35,6,0)="\\    facemask, eye protection, and gloves)  "
^PXRMD(801.41,10564,35,7,0)="\\3.  Notify the hospital Infection Control Program and other"
^PXRMD(801.41,10564,35,8,0)="\\    appropriate staff"
^PXRMD(801.41,10564,35,9,0)="\\4.  Evaluate for any risk exposures for Ebola"
