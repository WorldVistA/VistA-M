^PXRMD(801.41,4668,0)="VA-LST AD REVIEW INFO (E)^^^E^^^^^^^1"
^PXRMD(801.41,4668,2)="^^1"
^PXRMD(801.41,4668,25,0)="^^20^20^3170313"
^PXRMD(801.41,4668,25,1,0)="You should review documents reflecting the patient's wishes that are "
^PXRMD(801.41,4668,25,2,0)="available in the medical record or are presented to you by the patient (or"
^PXRMD(801.41,4668,25,3,0)="surrogate).  If you are provided with documents that are not found in "
^PXRMD(801.41,4668,25,4,0)="CPRS, arrange to have copies scanned into the patient's record."
^PXRMD(801.41,4668,25,5,0)=" "
^PXRMD(801.41,4668,25,6,0)="When talking with the SURROGATE:\\"
^PXRMD(801.41,4668,25,7,0)="Review documents reflecting the patient's wishes BEFORE making decisions"
^PXRMD(801.41,4668,25,8,0)="about life-sustaining treatments.  Understanding the contents of these"
^PXRMD(801.41,4668,25,9,0)="documents helps the surrogate make decisions that are consistent with the"
^PXRMD(801.41,4668,25,10,0)="patient's values and preferences."
^PXRMD(801.41,4668,25,11,0)=" "
^PXRMD(801.41,4668,25,12,0)="When talking with the PATIENT:\\"
^PXRMD(801.41,4668,25,13,0)="Review documents reflecting the patient's wishes AFTER making decisions "
^PXRMD(801.41,4668,25,14,0)="about life-sustaining treatments to ensure that they reflect the "
^PXRMD(801.41,4668,25,15,0)="patient's current values and preferences.  If they do not, discuss the "
^PXRMD(801.41,4668,25,16,0)="discrepancy with the patient, recommend the advance directive(s) "
^PXRMD(801.41,4668,25,17,0)="inconsistent with the patient's preferences be rescinded, document any "
^PXRMD(801.41,4668,25,18,0)="rescission in the record, and discontinue and re-write state-authorized "
^PXRMD(801.41,4668,25,19,0)="portable orders (e.g., POLST, MOST) and/or Life-Sustaining Treatment "
^PXRMD(801.41,4668,25,20,0)="orders so they are consistent with the patient's decisions."
^PXRMD(801.41,4668,100)="N^18"
^PXRMD(801.41,4668,110,0)="^801.44D^1^1"
^PXRMD(801.41,4668,110,1,0)="3170313.145324^54"
^PXRMD(801.41,4668,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4668,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,4668,110,"B",3170313.145324,1)=""
