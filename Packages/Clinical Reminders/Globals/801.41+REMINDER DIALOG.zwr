^PXRMD(801.41,4652,0)="VA-LST INFO DMC (G)^^^G^DECISION-MAKING CAPACITY^^4^^^1^^1"
^PXRMD(801.41,4652,2)="^^1"
^PXRMD(801.41,4652,10,0)="^801.412IA^1^1"
