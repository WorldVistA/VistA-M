^PXRMD(801.41,1338,25,2,0)="     service in Operations Enduring Freedom or Iraqi Freedom"
^PXRMD(801.41,1338,25,3,0)="WHO: All veterans who served in OEF or OIF"
^PXRMD(801.41,1338,25,4,0)="     is required and includes"
^PXRMD(801.41,1338,25,5,0)="WHAT: Screening for depression, PTSD, alcohol misuse, embedded"
^PXRMD(801.41,1338,25,6,0)="     fragments and symptoms of infection."
^PXRMD(801.41,1338,25,7,0)=" "
^PXRMD(801.41,1338,25,8,0)="A paper version of these questions is available for the Veteran to "
^PXRMD(801.41,1338,25,9,0)="complete, and the information can then be entered into the reminder "
^PXRMD(801.41,1338,25,10,0)="dialog.\\"
^PXRMD(801.41,1338,25,11,0)="  {FLD:VA OEF OIF PAPER URL}"
^PXRMD(801.41,1338,25,12,0)="<br> "
