^PXRMD(801.41,612000455,0)="VA-TEXT HTN DIET/LIPIDS (1)^^^E"
^PXRMD(801.41,612000455,25,0)="^^2^2^3061122"
^PXRMD(801.41,612000455,25,1,0)="Reduce intake of dietary fat, benefit of eating fresh fruits and "
^PXRMD(801.41,612000455,25,2,0)="vegetables, low fat diet "
^PXRMD(801.41,612000455,35,0)="^^4^4^3061122"
^PXRMD(801.41,612000455,35,1,0)="The patient was counseled to reduce intake of dietary saturated fats and"
^PXRMD(801.41,612000455,35,2,0)="cholesterol, and that a diet rich in fresh fruits and vegetables and low"
^PXRMD(801.41,612000455,35,3,0)="in dietary saturated fats and cholesterol is also beneficial in lowering"
^PXRMD(801.41,612000455,35,4,0)="blood pressure."
^PXRMD(801.41,612000455,100)="N^15"
