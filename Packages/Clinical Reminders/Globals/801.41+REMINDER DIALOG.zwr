^PXRMD(801.41,9986,25,0)="^^4^4^3150316"
^PXRMD(801.41,9986,25,1,0)="The patient or representative says the patient has an advance directive.  "
^PXRMD(801.41,9986,25,2,0)="It is on file in the patient's electronic health record. Inquired if "
^PXRMD(801.41,9986,25,3,0)="they want more information or assistance in completing a new advance "
^PXRMD(801.41,9986,25,4,0)="directive form, and directed them to that assistance, if desired. "
^PXRMD(801.41,9986,100)="N^18"
^PXRMD(801.41,9986,110,0)="^801.44D^1^1"
^PXRMD(801.41,9986,110,1,0)="3150316.160812^17"
^PXRMD(801.41,9986,110,1,1,0)="^^1^1^3150316"
^PXRMD(801.41,9986,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,9986,110,"B",3150316.160812,1)=""
^PXRMD(801.41,9987,0)="VA-ADNS WHY NEEDED (E)^^^E^^^^^^^1"
^PXRMD(801.41,9987,2)="^^1"
^PXRMD(801.41,9987,25,0)="^^24^24^3150316"
^PXRMD(801.41,9987,25,1,0)="{FLD:VA-ETHICS-LINK-HB-1004-02} requires that patients must be asked"
^PXRMD(801.41,9987,25,2,0)="whether they have an advance directive or mental health advance directive"
^PXRMD(801.41,9987,25,3,0)="at certain encounters. Advance directives are sometimes known by other"
^PXRMD(801.41,9987,25,4,0)="names such as Living Will, Durable Power of Attorney for Health Care, or"
^PXRMD(801.41,9987,25,5,0)="Psychiatric Advance Directive. Screeners can use all of these terms to"
^PXRMD(801.41,9987,25,6,0)="inquire whether a Veteran has an advance directive.  Encounters requiring"
^PXRMD(801.41,9987,25,7,0)="this screening include:\\"
^PXRMD(801.41,9987,25,8,0)="- all patients in Community Living Centers;\\ "
^PXRMD(801.41,9987,25,9,0)="- admission to VA home care or  hospice care;\\ "
^PXRMD(801.41,9987,25,10,0)="- as part of hospital discharge planning when the patient is "
^PXRMD(801.41,9987,25,11,0)="discharged to a long-term care or rehabilitation facility in the "
^PXRMD(801.41,9987,25,12,0)="community;\\"
^PXRMD(801.41,9987,25,13,0)="- at the following encounters, unless there is documentation of advance"
^PXRMD(801.41,9987,25,14,0)="directive notification and screening within the last year:"
^PXRMD(801.41,9987,25,15,0)="    - check-in for first primary care and mental health appointment(s);"
^PXRMD(801.41,9987,25,16,0)="    - check-in at VHA Ambulatory Surgery Center; "
^PXRMD(801.41,9987,25,17,0)="    - each admission to a VHA inpatient facility."
^PXRMD(801.41,9987,25,18,0)=" "
^PXRMD(801.41,9987,25,19,0)="Also, all patients and CLC residents must be asked whether they want more "
^PXRMD(801.41,9987,25,20,0)="information about advance directives and whether they want assistance in "
^PXRMD(801.41,9987,25,21,0)="completing the advance directive forms. If so, the screener must direct "
^PXRMD(801.41,9987,25,22,0)="the patient to the requested assistance. This assistance may be provided "
^PXRMD(801.41,9987,25,23,0)="by social workers or others who are appropriately trained, and must be "
^PXRMD(801.41,9987,25,24,0)="available to patients in all clinical settings."
^PXRMD(801.41,9987,100)="N^18"
^PXRMD(801.41,9987,110,0)="^801.44D^1^1"
^PXRMD(801.41,9987,110,1,0)="3150316.160813^17"
