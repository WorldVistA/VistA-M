^PXRMD(801.41,4651,25,0)="^^2^2^3170313"
^PXRMD(801.41,4651,25,1,0)="*1. Does the patient have capacity to make decisions about "
^PXRMD(801.41,4651,25,2,0)="life-sustaining treatments?"
^PXRMD(801.41,4651,35,0)="^^1^1^3170313"
^PXRMD(801.41,4651,35,1,0)="DECISION-MAKING CAPACITY"
^PXRMD(801.41,4651,100)="N^18"
^PXRMD(801.41,4651,110,0)="^801.44D^1^1"
^PXRMD(801.41,4651,110,1,0)="3170313.145326^54"
^PXRMD(801.41,4651,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4651,110,1,1,1,0)="Exchange Install"
