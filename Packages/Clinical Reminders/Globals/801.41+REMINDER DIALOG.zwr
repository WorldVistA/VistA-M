^PXRMD(801.41,10538,0)="VA-TEXT TD VHA GUIDANCE-PREGNANCY^^^E^^^^^^^1"
^PXRMD(801.41,10538,1)="^^5"
^PXRMD(801.41,10538,2)="^^0"
^PXRMD(801.41,10538,25,0)="^^19^19^3160523"
^PXRMD(801.41,10538,25,1,0)="Health care providers should administer Tdap during each pregnancy, "
^PXRMD(801.41,10538,25,2,0)="preferably during the third trimester (between 27-36 weeks gestation), "
^PXRMD(801.41,10538,25,3,0)="although Tdap may be given at any time during pregnancy.  If Tdap is not "
^PXRMD(801.41,10538,25,4,0)="administered during pregnancy, Tdap should be administered immediately "
^PXRMD(801.41,10538,25,5,0)="postpartum."
^PXRMD(801.41,10538,25,6,0)=" "
^PXRMD(801.41,10538,25,7,0)="Pregnant women who have never been vaccinated against tetanus should "
^PXRMD(801.41,10538,25,8,0)="receive 3 doses of vaccine containing tetanus and reduced diphtheria "
^PXRMD(801.41,10538,25,9,0)="toxoids (again waiting until the second trimester of pregnancy for the "
^PXRMD(801.41,10538,25,10,0)="first dose as a precaution). The recommended schedule is 0, 4 weeks, and "
^PXRMD(801.41,10538,25,11,0)="6 to 12 months. Tdap should replace 1 dose of Td, preferably during the "
^PXRMD(801.41,10538,25,12,0)="third trimester (between 27-36 weeks gestation) of pregnancy."
^PXRMD(801.41,10538,25,13,0)=" "
^PXRMD(801.41,10538,25,14,0)="The Advisory Committee on Immunization Practices (ACIP)"
^PXRMD(801.41,10538,25,15,0)="states that although no evidence exists that tetanus and diphtheria"
^PXRMD(801.41,10538,25,16,0)="toxoids are teratogenic, waiting until the second trimester of pregnancy"
^PXRMD(801.41,10538,25,17,0)="to administer a routine Td booster is a reasonable precaution for"
^PXRMD(801.41,10538,25,18,0)="minimizing any concern about the theoretical possibility of such"
^PXRMD(801.41,10538,25,19,0)="reactions."
^PXRMD(801.41,10538,100)="N^28"
^PXRMD(801.41,10538,110,0)="^801.44D^1^1"
^PXRMD(801.41,10538,110,1,0)="3160523.13063^54"
^PXRMD(801.41,10538,110,1,1,0)="^^1^1^3160523"
^PXRMD(801.41,10538,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,10538,110,"B",3160523.13063,1)=""
^PXRMD(801.41,10539,0)="VA-EBOLA FEVER=YES LOW EVD SUSP TESTING INDIC^^^E^^^^^^^1"
^PXRMD(801.41,10539,1)="^^^^6957;AUTTHF("
^PXRMD(801.41,10539,2)="^^0"
^PXRMD(801.41,10539,25,0)="^^6^6^3141114"
^PXRMD(801.41,10539,25,1,0)="TESTING IS INDICATED"
^PXRMD(801.41,10539,25,2,0)="\\The health department will arrange specimen transport and testing at a"
^PXRMD(801.41,10539,25,3,0)="Public Health Laboratory and CDC."
^PXRMD(801.41,10539,25,4,0)="\\ "
^PXRMD(801.41,10539,25,5,0)="\\The health department, in consultation with CDC, will provide guidance"
^PXRMD(801.41,10539,25,6,0)="to the hospital on all aspects of patient care and management."
^PXRMD(801.41,10539,35,0)="^^9^9^3141114"
^PXRMD(801.41,10539,35,1,0)="\\After review, Ebola Virus Disease (EVD) is SUSPECTED and TESTING"
^PXRMD(801.41,10539,35,2,0)="\\IS INDICATED."
^PXRMD(801.41,10539,35,3,0)="\\"
^PXRMD(801.41,10539,35,4,0)="\\In accordance with the CDC Algorithm:"
^PXRMD(801.41,10539,35,5,0)="\\  - The health department will arrange specimen transport and "
^PXRMD(801.41,10539,35,6,0)="\\    testing at a Public Health Laboratory and CDC."
^PXRMD(801.41,10539,35,7,0)="\\  - The health department, in consultation with CDC, will"
^PXRMD(801.41,10539,35,8,0)="\\    provide guidance to the hospital on all aspects of patient"
^PXRMD(801.41,10539,35,9,0)="\\    care and management."
^PXRMD(801.41,10539,100)="N^29"
^PXRMD(801.41,10539,110,0)="^801.44D^1^1"
^PXRMD(801.41,10539,110,1,0)="3141114.09381^17"
^PXRMD(801.41,10539,110,1,1,0)="^^1^1^3141114"
^PXRMD(801.41,10539,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,10539,110,"B",3141114.09381,1)=""
^PXRMD(801.41,10540,0)="VA-TEXT TD/TDAP VHA GUIDANCE-SPECIAL POPULATIONS^^^E^^^^^^^1"
^PXRMD(801.41,10540,1)="^^5"
^PXRMD(801.41,10540,2)="^^1"
^PXRMD(801.41,10540,25,0)="^^20^20^3160523"
^PXRMD(801.41,10540,25,1,0)="Adults who have never been vaccinated against tetanus, diphtheria, or "
^PXRMD(801.41,10540,25,2,0)="pertussis (no dose of pediatric DTP/DTaP/DT or Td) should receive a "
^PXRMD(801.41,10540,25,3,0)="series of three vaccinations containing tetanus and diphtheria toxoids. "
^PXRMD(801.41,10540,25,4,0)="The preferred schedule is a single dose of Tdap, followed by a dose of Td "
^PXRMD(801.41,10540,25,5,0)=">3 weeks after Tdap and another dose of Td 6-12 months later. However, "
^PXRMD(801.41,10540,25,6,0)="Tdap can substitute for any one of the doses of Td in the 3-dose primary "
^PXRMD(801.41,10540,25,7,0)="series. Alternatively, in situations in which the adult probably received "
^PXRMD(801.41,10540,25,8,0)="vaccination against tetanus and diphtheria but cannot produce a record, "
^PXRMD(801.41,10540,25,9,0)="vaccine providers may consider serologic testing for antibodies to "
^PXRMD(801.41,10540,25,10,0)="tetanus and diphtheria toxin to avoid unnecessary repeat of the "
^PXRMD(801.41,10540,25,11,0)="vaccination series. If tetanus and diphtheria antitoxin levels are each "
^PXRMD(801.41,10540,25,12,0)=">0.1 IU/mL, previous vaccination with tetanus and diphtheria toxoid "
^PXRMD(801.41,10540,25,13,0)="vaccine is presumed, and a single dose of Td or Tdap may be given, as "
^PXRMD(801.41,10540,25,14,0)="indicated, for booster immunization."
^PXRMD(801.41,10540,25,15,0)=" "
^PXRMD(801.41,10540,25,16,0)="Adults who received an incomplete vaccination series against tetanus and "
^PXRMD(801.41,10540,25,17,0)="diphtheria should be vaccinated with the number of doses of Tdap and/or "
^PXRMD(801.41,10540,25,18,0)="Td needed to complete the 3-dose primary series of tetanus and diphtheria "
^PXRMD(801.41,10540,25,19,0)="toxoid-containing vaccines. A single dose of Tdap can be used in the "
^PXRMD(801.41,10540,25,20,0)="series."
^PXRMD(801.41,10540,100)="N^28"
^PXRMD(801.41,10540,110,0)="^801.44D^1^1"
^PXRMD(801.41,10540,110,1,0)="3160523.130624^54"
^PXRMD(801.41,10540,110,1,1,0)="^^1^1^3160523"
^PXRMD(801.41,10540,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,10540,110,"B",3160523.130624,1)=""
