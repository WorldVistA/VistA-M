^PXRMD(801.41,7446,0)="VA-LST UNDERSTANDING QUERY INFO (E)^^^E^^^^^^^1"
^PXRMD(801.41,7446,2)="^^1"
^PXRMD(801.41,7446,25,0)="^^10^10^3170313"
^PXRMD(801.41,7446,25,1,0)="DO NOT PROCEED if the patient (or surrogate) does not have sufficient "
^PXRMD(801.41,7446,25,2,0)="understanding of the patient's condition/prognosis to make informed "
^PXRMD(801.41,7446,25,3,0)="decisions about life-sustaining treatments.  Instead, help the "
^PXRMD(801.41,7446,25,4,0)="patient (or surrogate) gain understanding, and, unless decisions need to"
^PXRMD(801.41,7446,25,5,0)="be made urgently, allow time to adjust to news about the patient's"
^PXRMD(801.41,7446,25,6,0)="condition before making shared decisions about life-sustaining treatments."
^PXRMD(801.41,7446,25,7,0)=" "
^PXRMD(801.41,7446,25,8,0)="If a patient's lack of understanding is related to a lack of "
^PXRMD(801.41,7446,25,9,0)="decision-making capacity, identify the authorized surrogate and discuss "
^PXRMD(801.41,7446,25,10,0)="goals of care and life-sustaining treatments with that individual.  "
^PXRMD(801.41,7446,100)="N^18"
^PXRMD(801.41,7446,110,0)="^801.44D^1^1"
^PXRMD(801.41,7446,110,1,0)="3170313.145324^54"
