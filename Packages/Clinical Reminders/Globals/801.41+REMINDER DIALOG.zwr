^PXRMD(801.41,13971,0)="VA-EL ONC PCA INSTRUCTIONS^^^E^^^^^^^1"
^PXRMD(801.41,13971,2)="^^1"
^PXRMD(801.41,13971,25,0)="^^20^20^3150115"
^PXRMD(801.41,13971,25,1,0)="It is recommended that the Prostate Cancer Template be initiated and used"
^PXRMD(801.41,13971,25,2,0)="for newly-diagnosed prostate cancer cases"
^PXRMD(801.41,13971,25,3,0)=" "
^PXRMD(801.41,13971,25,4,0)="Update this information periodically throughout the course of care"
^PXRMD(801.41,13971,25,5,0)=" "
^PXRMD(801.41,13971,25,6,0)="The template is not intended to be a chart abstraction tool that is only"
^PXRMD(801.41,13971,25,7,0)="filled in at the end of care, but rather to be used prospectively"
^PXRMD(801.41,13971,25,8,0)="throughout the course of care"
^PXRMD(801.41,13971,25,9,0)=" "
^PXRMD(801.41,13971,25,10,0)="When the template is opened on subsequent visits, previously"
^PXRMD(801.41,13971,25,11,0)="documented information is viewable and displayed at the beginning of the "
^PXRMD(801.41,13971,25,12,0)="template as a header"
^PXRMD(801.41,13971,25,13,0)=" "
^PXRMD(801.41,13971,25,14,0)="Header information can be updated by entering data in the corresponding"
^PXRMD(801.41,13971,25,15,0)="areas"
^PXRMD(801.41,13971,25,16,0)=" "
^PXRMD(801.41,13971,25,17,0)="NOTE: Please indicate why a standard of care was not followed"
^PXRMD(801.41,13971,25,18,0)=" "
^PXRMD(801.41,13971,25,19,0)="More detailed instructions are available in the VA-Oncology Prostate "
