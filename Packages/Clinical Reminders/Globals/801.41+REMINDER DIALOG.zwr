^PXRMD(801.41,1141,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,1141,110,"B",3140306.100511,1)=""
^PXRMD(801.41,1142,0)="VA-TEXT PNEUMOC PPSV23 SYSTEMIC CHEMO MESSAGE^^^E^^^^^^^1"
^PXRMD(801.41,1142,2)="^^1"
^PXRMD(801.41,1142,25,0)="^^4^4^3140306"
^PXRMD(801.41,1142,25,1,0)="CHEMOTHERAPY"
^PXRMD(801.41,1142,25,2,0)=" Do NOT vaccinate with PPSV23 during major systemic chemotherapy.  "
^PXRMD(801.41,1142,25,3,0)=" Vaccinate at least 2 weeks before starting chemo or defer until 3 months"
^PXRMD(801.41,1142,25,4,0)="   after chemo."
^PXRMD(801.41,1142,100)="N^3"
^PXRMD(801.41,1142,110,0)="^801.44D^1^1"
^PXRMD(801.41,1142,110,1,0)="3140306.100511^17"
^PXRMD(801.41,1142,110,1,1,0)="^^1^1^3140306"
^PXRMD(801.41,1142,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,1142,110,"B",3140306.100511,1)=""
^PXRMD(801.41,1142,"BL",0)="^801.41143I^1^1"
^PXRMD(801.41,1142,"BL",1,0)="1^543;PXRMD(811.5,^F^H"
^PXRMD(801.41,1142,"BL","B",1,1)=""
^PXRMD(801.41,1143,0)="TEXT INFO VACCINATION WHILE ON IMMUNOSUPPRESSION^^^E^^^^^^^1"
^PXRMD(801.41,1143,2)="^^1"
^PXRMD(801.41,1143,25,0)="^^14^14^3140306"
^PXRMD(801.41,1143,25,1,0)="SYSTEMIC CHEMOTHERAPY/RADIATION THERAPY:\\"
^PXRMD(801.41,1143,25,2,0)="Except for inactivated influenza vaccine and conjugate pneumococcal "
^PXRMD(801.41,1143,25,3,0)="vaccine (PCV13), vaccination during chemotherapy or radiation therapy"
^PXRMD(801.41,1143,25,4,0)="should be avoided if possible because antibody response might be"
^PXRMD(801.41,1143,25,5,0)="suboptimal. Revaccination after immune reconstitution should be "
^PXRMD(801.41,1143,25,6,0)="considered if the patient was vaccinated within 14 days before starting "
^PXRMD(801.41,1143,25,7,0)="or during treatment."
^PXRMD(801.41,1143,25,8,0)=" "
^PXRMD(801.41,1143,25,9,0)="OTHER IMMUNOSUPPRESSIVE TREATMENT:\\"
^PXRMD(801.41,1143,25,10,0)="Patients vaccinated within 14 days before starting immunosuppressive"
^PXRMD(801.41,1143,25,11,0)="therapy or while receiving immunosuppressive therapy should be considered"
^PXRMD(801.41,1143,25,12,0)="unimmunized and should be evaluated for revaccination at least 3 months"
^PXRMD(801.41,1143,25,13,0)="after therapy is discontinued if immune competence has been restored and"
^PXRMD(801.41,1143,25,14,0)="the indication for the vaccine is still present."
^PXRMD(801.41,1143,100)="L"
^PXRMD(801.41,1143,110,0)="^801.44D^1^1"
^PXRMD(801.41,1143,110,1,0)="3140306.100511^17"
^PXRMD(801.41,1143,110,1,1,0)="^^1^1^3140306"
^PXRMD(801.41,1143,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,1143,110,"B",3140306.100511,1)=""
