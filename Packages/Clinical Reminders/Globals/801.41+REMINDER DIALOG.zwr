^PXRMD(801.41,10543,35,1,0)="EBOLA EVALUATION:  POSITIVE TRAVEL OR POSITIVE EXPOSURE HISTORY"
^PXRMD(801.41,10543,35,2,0)="\\  This patient with a POSITIVE TRAVEL OR EXPOSURE HISTORY was screened"
