^PXRMD(801.41,9960,0)="VA-EL ONC LUNG INSTRUCTIONS^^^E^^^^^^^1"
^PXRMD(801.41,9960,2)="^^1"
^PXRMD(801.41,9960,25,0)="^^8^8^3150115"
^PXRMD(801.41,9960,25,1,0)="It is recommended that th VA-Oncology Lung Cancer Template be initiated"
^PXRMD(801.41,9960,25,2,0)="and used for newly-diagnosed lung cancer cases and that information is"
^PXRMD(801.41,9960,25,3,0)="updated periodically throughout the course of care. The template is not"
^PXRMD(801.41,9960,25,4,0)="intended to be a chart abstraction tool that is only filled in at the end "
^PXRMD(801.41,9960,25,5,0)="of care, but rather to be used prospectively throughout the course of "
^PXRMD(801.41,9960,25,6,0)="care. When the template is opened on subsequent visits, previously "
^PXRMD(801.41,9960,25,7,0)="documented information is viewable. This information can be updated by "
^PXRMD(801.41,9960,25,8,0)="entering data in the corresponding areas.  "
^PXRMD(801.41,9960,100)="N^39"
