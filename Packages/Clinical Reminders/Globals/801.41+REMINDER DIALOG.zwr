^PXRMD(801.41,2059,0)="VA-LST GOALS OF CARE INFO (E)^^^E^^^^^^^1"
^PXRMD(801.41,2059,2)="^^1"
^PXRMD(801.41,2059,25,0)="^^15^15^3170313"
^PXRMD(801.41,2059,25,1,0)="The patient's goals of care may include some that appear to conflict.  Do "
^PXRMD(801.41,2059,25,2,0)="not attempt to get the patient (or surrogate) to rank goals as they name "
^PXRMD(801.41,2059,25,3,0)="them.   At this point in the conversation, you just want to understand "
^PXRMD(801.41,2059,25,4,0)="which goals of care the patient would like to achieve.  Next, decision "
^PXRMD(801.41,2059,25,5,0)="will be made about which life-sustaining treatments the patient would be "
^PXRMD(801.41,2059,25,6,0)="willing to accept given the risks and odds of success of those "
^PXRMD(801.41,2059,25,7,0)="procedures, information the patient needs to make informed decisions in"
^PXRMD(801.41,2059,25,8,0)="the face of conflicting goals."
^PXRMD(801.41,2059,25,9,0)=" "
^PXRMD(801.41,2059,25,10,0)="Naming an unreachable goal after being fully informed of"
^PXRMD(801.41,2059,25,11,0)="condition/prognosis may be an indication that the patient is having"
^PXRMD(801.41,2059,25,12,0)="difficulty adjusting, and should be responded to with empathy (""I wish"
^PXRMD(801.41,2059,25,13,0)="your X could be cured, too.""). Note the goal and any related statements "
^PXRMD(801.41,2059,25,14,0)="in ""Goals in the patient's own words, or as stated by the surrogate:"" "
^PXRMD(801.41,2059,25,15,0)="section."
^PXRMD(801.41,2059,100)="N^18"
^PXRMD(801.41,2059,110,0)="^801.44D^1^1"
^PXRMD(801.41,2059,110,1,0)="3170313.145323^54"
^PXRMD(801.41,2059,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,2059,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,2059,110,"B",3170313.145323,1)=""
