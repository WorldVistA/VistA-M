^PXRMD(801.41,840,25,0)="^^1^1^3050311"
^PXRMD(801.41,840,25,1,0)="MDD Assessment Inconclusive"
^PXRMD(801.41,840,35,0)="^^3^3^3050311"
^PXRMD(801.41,840,35,1,0)="Based on additional assessment of the patient's positive screen for"
^PXRMD(801.41,840,35,2,0)="depression, it is not clear if the patient meets criteria for Major "
^PXRMD(801.41,840,35,3,0)="Depressive Disorder or not."
