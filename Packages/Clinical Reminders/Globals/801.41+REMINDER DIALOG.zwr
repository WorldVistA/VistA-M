^PXRMD(801.41,8273,0)="VA-EL CCC LUNG ECOG 2 DEF^^^E^^^^^^^1"
^PXRMD(801.41,8273,2)="^^1"
^PXRMD(801.41,8273,25,0)="^^3^3^3150115"
^PXRMD(801.41,8273,25,1,0)="1 = Restricted in physically strenuous activity but ambulatory and able to"
^PXRMD(801.41,8273,25,2,0)="carry out work of a light or sedentary nature."
^PXRMD(801.41,8273,25,3,0)="    e.g. light house work, office work"
