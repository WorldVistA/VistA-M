^PXRMD(801.41,612000456,0)="VA-TEXT HTN SALT (1)^^^E"
^PXRMD(801.41,612000456,25,0)="^^2^2^3061122"
^PXRMD(801.41,612000456,25,1,0)="Role of dietary sodium in elevated BP, limit Na to no more than 2.4g of "
^PXRMD(801.41,612000456,25,2,0)="sodium or 6g of sodium chloride"
^PXRMD(801.41,612000456,35,0)="^^3^3^3061122"
^PXRMD(801.41,612000456,35,1,0)="The contribution of dietary sodium to elevated blood pressure was"
^PXRMD(801.41,612000456,35,2,0)="reviewed.  The patient was counseled to limit sodium intake to no more"
^PXRMD(801.41,612000456,35,3,0)="than 2.4g of sodium or 6g of sodium chloride."
^PXRMD(801.41,612000456,100)="N^15"
^PXRMD(801.41,612000456,110,0)="^801.44D^1^1"
