^PXRMD(801.41,4652,25,0)="^^1^1^3170313"
^PXRMD(801.41,4652,25,1,0)="HELP ME understand decision-making capacity."
^PXRMD(801.41,4652,100)="N^18"
^PXRMD(801.41,4652,110,0)="^801.44D^1^1"
^PXRMD(801.41,4652,110,1,0)="3170313.145326^54"
^PXRMD(801.41,4652,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4652,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,4652,110,"B",3170313.145326,1)=""
^PXRMD(801.41,4653,0)="VA-LST DMC INFO (E)^^^E^^^^^^^1"
^PXRMD(801.41,4653,2)="^^1"
^PXRMD(801.41,4653,25,0)="^^26^26^3170313"
^PXRMD(801.41,4653,25,1,0)="Do not proceed before determining whether the patient has the capacity to"
^PXRMD(801.41,4653,25,2,0)="make decisions about life-sustaining treatments. Decision-making capacity"
^PXRMD(801.41,4653,25,3,0)="is a clinical judgment about a patient's ability to make a particular "
^PXRMD(801.41,4653,25,4,0)="health care decision at a particular point in time. In clinical practice"
^PXRMD(801.41,4653,25,5,0)="(and law), the decision-making capacity of an adult patient is generally"
^PXRMD(801.41,4653,25,6,0)="presumed; however, when the patient's medical condition or observed"
^PXRMD(801.41,4653,25,7,0)="behavior raises questions about the patient's decision-making capacity,"
^PXRMD(801.41,4653,25,8,0)="the responsible practitioner must make an explicit determination based on"
^PXRMD(801.41,4653,25,9,0)="assessment of the patient's ability to do all of the following:"
^PXRMD(801.41,4653,25,10,0)=" "
^PXRMD(801.41,4653,25,11,0)="1.  Understand the relevant information;"
^PXRMD(801.41,4653,25,12,0)=" "
^PXRMD(801.41,4653,25,13,0)="2.  Appreciate the situation and its consequences; "
^PXRMD(801.41,4653,25,14,0)=" "
^PXRMD(801.41,4653,25,15,0)="3.  Reason about treatment options;"
^PXRMD(801.41,4653,25,16,0)=" "
^PXRMD(801.41,4653,25,17,0)="4.  Communicate a choice."
^PXRMD(801.41,4653,25,18,0)=" "
^PXRMD(801.41,4653,25,19,0)="For all patients who are suspected of lacking decision-making capacity, "
^PXRMD(801.41,4653,25,20,0)="the practitioner must ensure that a clinical assessment of the above is "
^PXRMD(801.41,4653,25,21,0)="documented in the patient's health record."
^PXRMD(801.41,4653,25,22,0)=" "
^PXRMD(801.41,4653,25,23,0)="If a patient lacks capacity to make decisions about life-sustaining "
^PXRMD(801.41,4653,25,24,0)="treatment and the surrogate is responsible for making those decisions, "
^PXRMD(801.41,4653,25,25,0)="the patient should, to the extent possible, be included in the goals of "
^PXRMD(801.41,4653,25,26,0)="care conversation."
^PXRMD(801.41,4653,100)="N^18"
^PXRMD(801.41,4653,110,0)="^801.44D^1^1"
^PXRMD(801.41,4653,110,1,0)="3170313.145326^54"
^PXRMD(801.41,4653,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4653,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,4653,110,"B",3170313.145326,1)=""
