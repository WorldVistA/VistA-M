^PXRMD(801.41,8272,25,0)="^^2^2^3150115"
^PXRMD(801.41,8272,25,1,0)="0 = Fully active, able to carry on all pre-disease performance without "
^PXRMD(801.41,8272,25,2,0)="restriction."
^PXRMD(801.41,8272,100)="N^39"
