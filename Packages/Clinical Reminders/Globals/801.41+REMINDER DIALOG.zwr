^PXRMD(801.41,162,0)="VA-WH MAM HEADER2 - SCREEN^^^E^^^^^^^1"
^PXRMD(801.41,162,2)="^^1"
^PXRMD(801.41,162,25,0)="^^27^27^3130716"
^PXRMD(801.41,162,25,1,0)="{FLD:VA-WH MAMMOGRAM GUIDANCE}"
^PXRMD(801.41,162,25,2,0)=" "
^PXRMD(801.41,162,25,3,0)="*The VHA recommends screening for breast cancer with mammography every 2 "
^PXRMD(801.41,162,25,4,0)="years for average risk women age 50 through 74."
^PXRMD(801.41,162,25,5,0)=" "
^PXRMD(801.41,162,25,6,0)="*The decision to start regular screening every 2 years with mammography "
^PXRMD(801.41,162,25,7,0)="for average risk women age 40 to 49 years should be an individual decision"
^PXRMD(801.41,162,25,8,0)="and take the patient's values into account including  values about"
^PXRMD(801.41,162,25,9,0)="specific benefits and harms."
^PXRMD(801.41,162,25,10,0)=" "
^PXRMD(801.41,162,25,11,0)="*The VHA neither recommends for or against screening for breast cancer for"
^PXRMD(801.41,162,25,12,0)="women age 75 and older.  The current evidence is insufficient to assess"
^PXRMD(801.41,162,25,13,0)="the balance of benefits and harms of screening for breast cancer with"
^PXRMD(801.41,162,25,14,0)="mammography in women age 75 and older.  If screening for breast cancer"
^PXRMD(801.41,162,25,15,0)="with mammography is offered, patients should understand the uncertainty"
^PXRMD(801.41,162,25,16,0)="about the balance of benefits and harms."
^PXRMD(801.41,162,25,17,0)=" "
^PXRMD(801.41,162,25,18,0)="*The VHA neither recommends for or against clinician breast exam for "
^PXRMD(801.41,162,25,19,0)="breast cancer screening.  The current evidence is insufficient to assess "
^PXRMD(801.41,162,25,20,0)="the additional benefits and harms of clinical breast examination beyond"
^PXRMD(801.41,162,25,21,0)="mammography for breast cancer screening."
^PXRMD(801.41,162,25,22,0)=" "
^PXRMD(801.41,162,25,23,0)="*The VHA recommends AGAINST clinicians teaching women how to perform "
^PXRMD(801.41,162,25,24,0)="breast self-examination for breast cancer screening.  While routinely "
^PXRMD(801.41,162,25,25,0)="teaching women how to perform systematic, structured breast"
^PXRMD(801.41,162,25,26,0)="self-examinations is not recommended, women should be encouraged to report"
^PXRMD(801.41,162,25,27,0)="breast changes or abnormalities they discover to their provider."
^PXRMD(801.41,162,100)="N^12"
^PXRMD(801.41,162,110,0)="^801.44D^1^1"
^PXRMD(801.41,162,110,1,0)="3130716.102322^17"
