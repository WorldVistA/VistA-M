^PXRMD(801.41,10451,25,0)="^^2^2^3160523"
^PXRMD(801.41,10451,25,1,0)="View more detailed guidance on the use of Tetanus/Diphtheria (Td) and "
^PXRMD(801.41,10451,25,2,0)="Tetanus/Diphtheria/Pertussis for SPECIAL POPULATIONS"
^PXRMD(801.41,10451,100)="N^28"
^PXRMD(801.41,10451,110,0)="^801.44D^1^1"
^PXRMD(801.41,10451,110,1,0)="3160523.130624^54"
