^PXRMD(801.41,15161,110,"B",3140306.100516,1)=""
^PXRMD(801.41,15162,0)="VA-TEXT PNEUMOCOC PCV13 DETAILED GUIDANCE^^^E^^^^^^^1"
^PXRMD(801.41,15162,2)="^^1"
^PXRMD(801.41,15162,25,0)="^^34^34^3150202"
^PXRMD(801.41,15162,25,1,0)="{FLD:IM PNEUMOCOCCAL VACCINE NCP GUIDANCE}"
^PXRMD(801.41,15162,25,2,0)="{FLD:IM PNEUMOCOCCAL VACCINE ALGORITHM}\\"
^PXRMD(801.41,15162,25,3,0)=" "
^PXRMD(801.41,15162,25,4,0)="PCV13 (Prevnar 13) became a recommended vaccine starting in 2013 for some"
^PXRMD(801.41,15162,25,5,0)="adults.  In 2014, the ACIP added a recommendation that all patients "
^PXRMD(801.41,15162,25,6,0)="ages 65 and older receive one dose of PCV13."
^PXRMD(801.41,15162,25,7,0)=" "
^PXRMD(801.41,15162,25,8,0)="PPSV23 (Pneumovax) is a different vaccine and has been recommended for"
^PXRMD(801.41,15162,25,9,0)="some adults since 1997.  There is a separate clinical reminder for PPSV23"
^PXRMD(801.41,15162,25,10,0)="(Pneumovax)."
^PXRMD(801.41,15162,25,11,0)=" "
^PXRMD(801.41,15162,25,12,0)="* Which adults should receive PCV13 (Prevnar 13)?"
^PXRMD(801.41,15162,25,13,0)="      Those with immunocompromising conditions, nephrotic syndrome, CKD "
^PXRMD(801.41,15162,25,14,0)="        III, IV and V, renal failure, functional or anatomic asplenia, CSF"
^PXRMD(801.41,15162,25,15,0)="        leaks or cochlear implants or who are 65 and older"
^PXRMD(801.41,15162,25,16,0)=" "
^PXRMD(801.41,15162,25,17,0)="* How many doses of PCV13 should be given?"
^PXRMD(801.41,15162,25,18,0)="      One"
^PXRMD(801.41,15162,25,19,0)=" "
^PXRMD(801.41,15162,25,20,0)="* Can PCV13  (Prevnar 13) and PPSV23 (Pneumovax) be given on the same day?"
^PXRMD(801.41,15162,25,21,0)="      No. (see below for time delay needed between these two vaccines, "
^PXRMD(801.41,15162,25,22,0)="        which is different depending on which vaccine was given first)"
^PXRMD(801.41,15162,25,23,0)=" "
^PXRMD(801.41,15162,25,24,0)="* If a patient needs both PCV13 (Prevnar 13) and PPSV23 (Pneumovax), which"
^PXRMD(801.41,15162,25,25,0)="vaccine should be given first? "
^PXRMD(801.41,15162,25,26,0)="      PCV13 (Prevnar 13) should be given first.  "
^PXRMD(801.41,15162,25,27,0)="      If patient already received PPSV23 (Pneumovax), wait 12 months"
^PXRMD(801.41,15162,25,28,0)="        before giving PCV13 (Prevnar 13).  This clinical reminder"
^PXRMD(801.41,15162,25,29,0)="        automatically waits the correct amount of time if a prior dose of"
^PXRMD(801.41,15162,25,30,0)="        PPSV23 (Pneumovax) is on file at this medical center."
^PXRMD(801.41,15162,25,31,0)="      If patient received PPSV23 (Pneumovax) somewhere else, document that"
^PXRMD(801.41,15162,25,32,0)="        in this reminder and if this was within the past 1 year, finish"
^PXRMD(801.41,15162,25,33,0)="        this reminder without giving PCV13 (Prevnar 13)."
^PXRMD(801.41,15162,25,34,0)="\\"
