^PXRMD(801.41,8446,25,0)="^^20^20^3150521"
^PXRMD(801.41,8446,25,1,0)="Risk Factors for HCV\\"
^PXRMD(801.41,8446,25,2,0)="-----------------------------\\"
^PXRMD(801.41,8446,25,3,0)="- Prior or current intravenous drug use\\"
^PXRMD(801.41,8446,25,4,0)="- Blood transfusion or organ transplantation prior to 1992\\"
^PXRMD(801.41,8446,25,5,0)="- Hemodialysis\\"
^PXRMD(801.41,8446,25,6,0)="- Vietnam-era Veteran, defined by dates of service from 1964-1975\\"
^PXRMD(801.41,8446,25,7,0)="- Health care, emergency medical care, emergency medical and public "
^PXRMD(801.41,8446,25,8,0)="   safety workers after a needle stick injury or mucosal exposure to "
^PXRMD(801.41,8446,25,9,0)="   HCV-positive blood"
^PXRMD(801.41,8446,25,10,0)="- Tattoos or body-piercings obtained in non-regulated setting\\"
^PXRMD(801.41,8446,25,11,0)="- Intranasal drug user who have shared paraphernalia\\"
^PXRMD(801.41,8446,25,12,0)="- 20 or more lifetime sexual partners\\"
^PXRMD(801.41,8446,25,13,0)="- Current or past sexual exposure to an HCV-infected person\\"
^PXRMD(801.41,8446,25,14,0)="- HIV infection\\"
^PXRMD(801.41,8446,25,15,0)="- History of hemophilia and received clotting factor concentrates prior "
^PXRMD(801.41,8446,25,16,0)="   to 1987"
^PXRMD(801.41,8446,25,17,0)="- History of unexplained liver disease or abnormal liver function test\\"
