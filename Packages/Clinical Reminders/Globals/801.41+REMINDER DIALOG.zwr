^PXRMD(801.41,10543,25,0)="^^13^13^3141114"
^PXRMD(801.41,10543,25,1,0)="EBOLA EVALUATION:  POSITIVE TRAVEL OR EXPOSURE HISTORY"
^PXRMD(801.41,10543,25,2,0)="\\"
^PXRMD(801.41,10543,25,3,0)="\\************************************************************************"
^PXRMD(801.41,10543,25,4,0)="\\* This template is to be used for the initial assessment of patients   *"
^PXRMD(801.41,10543,25,5,0)="\\* identified as having travelled to an area where Ebola Virus Disease  *"
^PXRMD(801.41,10543,25,6,0)="\\* is prevalent or having had exposure to a known Ebola patient or      *"
^PXRMD(801.41,10543,25,7,0)="\\* their body fluids within the previous 21 days.   It follows the      *"
^PXRMD(801.41,10543,25,8,0)="\\* Center for Disease Control Algorithm for Evaluation of the Returned  *"
^PXRMD(801.41,10543,25,9,0)="\\* Traveler. Useful links for further information include:              *"
^PXRMD(801.41,10543,25,10,0)="\\*   {FLD:VA-EBOLA URL CDC CHECKLIST}            *"
^PXRMD(801.41,10543,25,11,0)="\\*   {FLD:VA-EBOLA URL CDC ALGORITHM}       *"
^PXRMD(801.41,10543,25,12,0)="\\*   {FLD:VA-EBOLA URL CDC AFFECTED AREAS}                       *"
^PXRMD(801.41,10543,25,13,0)="\\************************************************************************"
