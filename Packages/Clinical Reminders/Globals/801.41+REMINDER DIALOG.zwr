^PXRMD(801.41,2401,0)="VA-AH-BPR PURPOSE STATEMENT ADDL INFO^^^E^^^^^^^1"
^PXRMD(801.41,2401,2)="^^1"
^PXRMD(801.41,2401,25,0)="^^12^12^3141201"
^PXRMD(801.41,2401,25,1,0)="The Airborne Hazards and Open Burn Pit Registry consists of a"
^PXRMD(801.41,2401,25,2,0)="Self-Assessment the Veteran completes on the internet. After completing"
^PXRMD(801.41,2401,25,3,0)="the self-assessment, the Veteran may request an initial in-person AH&OBPR"
^PXRMD(801.41,2401,25,4,0)="Assessment. The encounter should be documented using this progress "
^PXRMD(801.41,2401,25,5,0)="note title and template."
^PXRMD(801.41,2401,25,6,0)=" "
^PXRMD(801.41,2401,25,7,0)="This initial clinical assessment template provides a standardized"
^PXRMD(801.41,2401,25,8,0)="framework to document health issues possibly related to exposures to "
^PXRMD(801.41,2401,25,9,0)="airborne environmental hazards during deployment. "
