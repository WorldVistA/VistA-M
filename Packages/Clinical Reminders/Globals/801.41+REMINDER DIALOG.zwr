^PXRMD(801.41,1141,25,0)="^^2^2^3140306"
^PXRMD(801.41,1141,25,1,0)="Additional information on vaccination of patients on immunosuppressive "
^PXRMD(801.41,1141,25,2,0)="therapy"
^PXRMD(801.41,1141,100)="N^3"
^PXRMD(801.41,1141,110,0)="^801.44D^1^1"
^PXRMD(801.41,1141,110,1,0)="3140306.100511^17"
