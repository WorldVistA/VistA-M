^PXRMD(801.41,4688,25,0)="^^2^2^3170313"
^PXRMD(801.41,4688,25,1,0)="*8. Who has given oral informed consent for the life-sustaining"
^PXRMD(801.41,4688,25,2,0)="treatment plan outlined above?  "
^PXRMD(801.41,4688,35,0)="^^1^1^3170313"
^PXRMD(801.41,4688,35,1,0)="INFORMED CONSENT"
^PXRMD(801.41,4688,100)="N^18"
^PXRMD(801.41,4688,110,0)="^801.44D^1^1"
^PXRMD(801.41,4688,110,1,0)="3170313.145318^54"
^PXRMD(801.41,4688,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4688,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,4688,110,"B",3170313.145318,1)=""
^PXRMD(801.41,4690,0)="VA-LST INFORMED CONSENT INFO (E)^^^E^^^^^^^1"
^PXRMD(801.41,4690,2)="^^1"
^PXRMD(801.41,4690,25,0)="^^20^20^3170313"
^PXRMD(801.41,4690,25,1,0)="If the patient (or surrogate) has agreed to the plan regarding whether or"
^PXRMD(801.41,4690,25,2,0)="not to limit life-sustaining treatment in the event of cardiopulmonary"
^PXRMD(801.41,4690,25,3,0)="arrest, or in circumstances other than cardiopulmonary arrest, they have "
^PXRMD(801.41,4690,25,4,0)="given oral informed consent.  They should not be asked to provide "
^PXRMD(801.41,4690,25,5,0)="signature consent for these decisions.  The provider should implement the "
^PXRMD(801.41,4690,25,6,0)="decisions by writing Life-Sustaining Treatment orders accordingly.  "
^PXRMD(801.41,4690,25,7,0)=" "
^PXRMD(801.41,4690,25,8,0)="INITIATING mechanical ventilation, feeding tubes, dialysis, and other "
^PXRMD(801.41,4690,25,9,0)="life-sustaining treatments requires informed consent except in "
^PXRMD(801.41,4690,25,10,0)="emergencies.  If signature informed consent is required for the "
^PXRMD(801.41,4690,25,11,0)="life-sustaining treatment(s) in question, it must be obtained before "
^PXRMD(801.41,4690,25,12,0)="specific orders are written and treatment is initiated; refer to "
^PXRMD(801.41,4690,25,13,0)="{FLD:VA-LST POLICY LINK} for information about the informed consent"
^PXRMD(801.41,4690,25,14,0)="process for life-sustaining treatments."
^PXRMD(801.41,4690,25,15,0)=" "
^PXRMD(801.41,4690,25,16,0)="Before DISCONTINUING a life-sustaining treatment that the patient is "
^PXRMD(801.41,4690,25,17,0)="currently receiving, you must discuss associated comfort measures and the "
^PXRMD(801.41,4690,25,18,0)="risks, benefits, and alternatives, and the patient (or surrogate) must"
^PXRMD(801.41,4690,25,19,0)="provide oral informed consent for discontinuing the treatment.  Separate"
^PXRMD(801.41,4690,25,20,0)="active orders must then be written and/or discontinued as appropriate."
^PXRMD(801.41,4690,100)="N^18"
^PXRMD(801.41,4690,110,0)="^801.44D^1^1"
^PXRMD(801.41,4690,110,1,0)="3170313.145318^54"
^PXRMD(801.41,4690,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4690,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,4690,110,"B",3170313.145318,1)=""
