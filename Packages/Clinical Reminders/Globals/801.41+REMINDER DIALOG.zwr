^PXRMD(801.41,4665,25,0)="^^4^4^3170313"
^PXRMD(801.41,4665,25,1,0)="I reviewed with the patient (or surrogate) all active advance"
^PXRMD(801.41,4665,25,2,0)="directive(s), state-authorized portable orders (e.g., POLST, MOST),"
^PXRMD(801.41,4665,25,3,0)="and/or Life-Sustaining Treatment notes/orders available in the record"
