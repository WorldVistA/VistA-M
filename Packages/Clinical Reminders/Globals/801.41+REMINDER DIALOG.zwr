^PXRMD(801.41,5060,0)="VA-CSP DEPRESSION SCREEN PHQ2 SCORE 3-6 FACTORS^^^E^^^^^^^1"
^PXRMD(801.41,5060,2)="^^1"
^PXRMD(801.41,5060,25,0)="^^25^25^3151002"
^PXRMD(801.41,5060,25,1,0)=" "
^PXRMD(801.41,5060,25,2,0)="    Assess for Specific Factors that may Increase or Decrease Risk for"
^PXRMD(801.41,5060,25,3,0)="    Suicide"
^PXRMD(801.41,5060,25,4,0)=" "
^PXRMD(801.41,5060,25,5,0)="    Factors that may increase risk:"
^PXRMD(801.41,5060,25,6,0)=" "
^PXRMD(801.41,5060,25,7,0)="    Current ideation, Intent, Plan, Access to means, Previous suicide "
^PXRMD(801.41,5060,25,8,0)="    attempt or attempts, Alcohol/substance abuse, Previous history of"
^PXRMD(801.41,5060,25,9,0)="    psychiatric diagnosis, Impulsiveness and poor self-control,"
^PXRMD(801.41,5060,25,10,0)="    Hopelessness - Presence, Duration, Severity, Recent losses - Physical,"
^PXRMD(801.41,5060,25,11,0)="    Financial, Personal, Recent discharge from an inpatient unit, Family"
^PXRMD(801.41,5060,25,12,0)="    history of suicide, History of abuse - Physical, Sexual or Emotional,"
^PXRMD(801.41,5060,25,13,0)="    Co-morbid health problems especially new diagnosis or worsening"
^PXRMD(801.41,5060,25,14,0)="    symptoms, Elderly or young adult, Male, White, Unmarried, Living"
^PXRMD(801.41,5060,25,15,0)="    alone, or Same sex orientation, etc."
^PXRMD(801.41,5060,25,16,0)=" "
^PXRMD(801.41,5060,25,17,0)="    Factors that may decrease risk: "
^PXRMD(801.41,5060,25,18,0)=" "
^PXRMD(801.41,5060,25,19,0)="    Positive social support, Spirituality, Sense of responsibility to"
^PXRMD(801.41,5060,25,20,0)="    family, Children in the home or Pregnancy, Life satisfaction, Reality"
^PXRMD(801.41,5060,25,21,0)="    testing ability, Positive coping skills, Positive problem solving"
^PXRMD(801.41,5060,25,22,0)="    skills, or Positive therapeutic relationship, etc."
^PXRMD(801.41,5060,25,23,0)=" "
^PXRMD(801.41,5060,25,24,0)=" "
^PXRMD(801.41,5060,25,25,0)=" Ask the Questions:"
^PXRMD(801.41,5060,100)="N"
