^PXRMD(801.41,3952,25,0)="^^7^7^3140929"
^PXRMD(801.41,3952,25,1,0)="The Veteran completed the Meaning of the Event session of Cognitive "
^PXRMD(801.41,3952,25,2,0)="Processing Therapy (CPT) for PTSD. The following therapy components were "
^PXRMD(801.41,3952,25,3,0)="addressed:"
^PXRMD(801.41,3952,25,4,0)=" "
