^PXRMD(801.41,10821,25,0)="^^3^3^3150710"
^PXRMD(801.41,10821,25,1,0)="NO RECENT - denies military sexual trauma (MST) in most recent period of "
^PXRMD(801.41,10821,25,2,0)="service"
^PXRMD(801.41,10821,25,3,0)="(answered 'NO' to BOTH questions)"
^PXRMD(801.41,10821,35,0)="^^4^4^3150710"
^PXRMD(801.41,10821,35,1,0)="Patient denies experiencing military sexual trauma (MST) in the most "
^PXRMD(801.41,10821,35,2,0)="recent period of service. MST YES REPORTS health factor has been added to"
^PXRMD(801.41,10821,35,3,0)="the encounter because patient reported MST from a previous period of "
^PXRMD(801.41,10821,35,4,0)="service and remains eligible for MST services."
^PXRMD(801.41,10821,100)="L"
