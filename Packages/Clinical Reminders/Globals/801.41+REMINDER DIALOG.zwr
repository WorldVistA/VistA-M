^PXRMD(801.41,12879,0)="VA-CSP IN-HOME INTRO1 REV^^^E^^^^^^^1"
^PXRMD(801.41,12879,2)="^^1"
^PXRMD(801.41,12879,25,0)="^^12^12^3151002"
^PXRMD(801.41,12879,25,1,0)="The Initial Home Visit is to be conducted by a VA clinician."
^PXRMD(801.41,12879,25,2,0)=" "
^PXRMD(801.41,12879,25,3,0)="This Initial In-Home Assessment must be completed within 10 days of the "
^PXRMD(801.41,12879,25,4,0)="Caregiver's successful completion of the core training curriculum."
^PXRMD(801.41,12879,25,5,0)=" "
^PXRMD(801.41,12879,25,6,0)="The assessing clinician is not responsible for developing a care plan "
^PXRMD(801.41,12879,25,7,0)="or for management of identified conditions unless an imminent safety risk "
^PXRMD(801.41,12879,25,8,0)="is present.  The assessing clinician is responsible for communicating "
^PXRMD(801.41,12879,25,9,0)="findings to the Nurse Care Manager or other appropriate clinician on the "
^PXRMD(801.41,12879,25,10,0)="Veteran's Primary Care Team for necessary medical follow-up and to the "
^PXRMD(801.41,12879,25,11,0)="CSC.  The primary intent is to be supportive of the Caregiver, and "
^PXRMD(801.41,12879,25,12,0)="maximize the likelihood that the Veteran will be cared for at home."
^PXRMD(801.41,12879,100)="N"
^PXRMD(801.41,12879,110,0)="^801.44D^1^1"
^PXRMD(801.41,12879,110,1,0)="3151002.12101^17"
