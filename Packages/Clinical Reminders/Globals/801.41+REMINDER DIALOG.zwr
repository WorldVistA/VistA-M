^PXRMD(801.41,832,25,0)="^^11^11^3051115"
^PXRMD(801.41,832,25,1,0)="DEPRESSION SCREEN  (2 question screen)"
^PXRMD(801.41,832,25,2,0)=" "
^PXRMD(801.41,832,25,3,0)="1.  During the past month, have you often been bothered"
^PXRMD(801.41,832,25,4,0)="    by feeling down, depressed, or hopeless?"
^PXRMD(801.41,832,25,5,0)=" "
^PXRMD(801.41,832,25,6,0)="2.  During the past month, have you often been bothered"
^PXRMD(801.41,832,25,7,0)="    by little interest or pleasure in doing things?"
^PXRMD(801.41,832,25,8,0)=" "
^PXRMD(801.41,832,25,9,0)=" A ""YES"" response to either question is a POSITIVE screen"
^PXRMD(801.41,832,25,10,0)="    for depression.  Further evaluation is then needed."
^PXRMD(801.41,832,25,11,0)="<br>"
^PXRMD(801.41,832,100)="N"
^PXRMD(801.41,832,110,0)="^801.44D^1^1"
^PXRMD(801.41,832,110,1,0)="3051115.161143^1"
