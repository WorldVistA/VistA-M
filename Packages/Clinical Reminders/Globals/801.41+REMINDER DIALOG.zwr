^PXRMD(801.41,15161,25,0)="^^1^1^3140306"
^PXRMD(801.41,15161,25,1,0)="{FLD:IM PCV13 WARNING}"
^PXRMD(801.41,15161,100)="N^3"
^PXRMD(801.41,15161,110,0)="^801.44D^1^1"
^PXRMD(801.41,15161,110,1,0)="3140306.100516^17"
