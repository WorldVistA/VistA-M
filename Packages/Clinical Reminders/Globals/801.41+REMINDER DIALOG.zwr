^PXRMD(801.41,612000461,25,1,0)="Goal to exercise at least 30 minutes 3 times per week, any increase may "
^PXRMD(801.41,612000461,25,2,0)="be useful"
^PXRMD(801.41,612000461,35,0)="^^3^3^3061122"
