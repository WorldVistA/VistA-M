^PXRMD(801.41,4658,110,"B",3170313.145325,1)=""
^PXRMD(801.41,4659,0)="VA-LST INFO-SURROGATE SELECTION (E)^^^E^^^^^^^1"
^PXRMD(801.41,4659,2)="^^1"
^PXRMD(801.41,4659,25,0)="^^19^19^3170313"
^PXRMD(801.41,4659,25,1,0)="By VA policy and law, the individual(s) at the highest level of the "
^PXRMD(801.41,4659,25,2,0)="surrogate hierarchy, found in the drop-down list below, is the patient's "
^PXRMD(801.41,4659,25,3,0)="authorized surrogate, provided they are willing and available to serve. "
^PXRMD(801.41,4659,25,4,0)="Start at the top of the list and work down until you identify an "
^PXRMD(801.41,4659,25,5,0)="individual who is willing and available to serve as a surrogate."
^PXRMD(801.41,4659,25,6,0)=" "
^PXRMD(801.41,4659,25,7,0)="IMPORTANT:  Inform the patient of the individual who would be authorized "
^PXRMD(801.41,4659,25,8,0)="to serve as their surrogate if they lost capacity. If a patient wishes to "
^PXRMD(801.41,4659,25,9,0)="name a different surrogate, they MUST be advised to complete a Durable "
^PXRMD(801.41,4659,25,10,0)="Power of Attorney for Health Care (DPAHC) and appoint that individual as "
^PXRMD(801.41,4659,25,11,0)="health care agent."
^PXRMD(801.41,4659,25,12,0)=" "
^PXRMD(801.41,4659,25,13,0)="If multiple individuals at the same level of the hierarchy (and thus with "
^PXRMD(801.41,4659,25,14,0)="equal standing) serve as the patient's surrogate, list names and contact "
^PXRMD(801.41,4659,25,15,0)="information for each.  If a close friend serves as the patient's "
^PXRMD(801.41,4659,25,16,0)="surrogate (without being named in a DPAHC), ensure that the record "
^PXRMD(801.41,4659,25,17,0)="contains a signed, written statement from the friend describing that "
^PXRMD(801.41,4659,25,18,0)="person's relationship to, and familiarity with, the patient, per "
^PXRMD(801.41,4659,25,19,0)="{FLD:VA-LST POLICY LINK}."
^PXRMD(801.41,4659,100)="N^18"
^PXRMD(801.41,4659,110,0)="^801.44D^1^1"
^PXRMD(801.41,4659,110,1,0)="3170313.145325^54"
^PXRMD(801.41,4659,110,1,1,0)="^^1^1^3170313"
^PXRMD(801.41,4659,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,4659,110,"B",3170313.145325,1)=""
