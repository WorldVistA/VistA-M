^PXRMD(801.41,10452,0)="VA-TEXT TD VHA GUIDANCE-GENERAL^^^E^^^^^^^1"
^PXRMD(801.41,10452,1)="^^5"
^PXRMD(801.41,10452,2)="^^1"
^PXRMD(801.41,10452,25,0)="^^14^14^3160523"
^PXRMD(801.41,10452,25,1,0)="Tetanus and Diphtheria Toxoids (Td) should be given to adults every 10 "
^PXRMD(801.41,10452,25,2,0)="years as booster doses after the primary series of three vaccinations "
^PXRMD(801.41,10452,25,3,0)="against diphtheria, tetanus, and pertussis that was received during "
^PXRMD(801.41,10452,25,4,0)="infancy and childhood. If a dose is given sooner as part of wound "
^PXRMD(801.41,10452,25,5,0)="management, the next booster is not needed until 10 years thereafter. "
^PXRMD(801.41,10452,25,6,0)=" "
^PXRMD(801.41,10452,25,7,0)="One dose should be replaced with a single dose of Tetanus "
^PXRMD(801.41,10452,25,8,0)="Toxoid, Reduced Diphtheria Toxoid and Acellular Pertussis (Tdap) vaccine"
^PXRMD(801.41,10452,25,9,0)="(unless contraindicated) against tetanus, diphtheria and pertussis for all"
^PXRMD(801.41,10452,25,10,0)="adults aged 19 and older.  Adults who are due for but have not yet"
^PXRMD(801.41,10452,25,11,0)="received a dose of Tdap or whose immunization status is unknown should"
^PXRMD(801.41,10452,25,12,0)="receive a dose of Tdap as soon as feasible. Tdap can be administered"
^PXRMD(801.41,10452,25,13,0)="regardless of interval since the last tetanus or diphtheria containing"
^PXRMD(801.41,10452,25,14,0)="vaccine."
^PXRMD(801.41,10452,100)="N^28"
^PXRMD(801.41,10452,110,0)="^801.44D^1^1"
^PXRMD(801.41,10452,110,1,0)="3160523.13063^54"
^PXRMD(801.41,10452,110,1,1,0)="^^1^1^3160523"
^PXRMD(801.41,10452,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,10452,110,"B",3160523.13063,1)=""
