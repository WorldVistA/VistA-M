^PXRMD(801.41,1140,25,0)="^^5^5^3150710"
^PXRMD(801.41,1140,25,1,0)="VA refers to this type of experience as 'military sexual trauma' or 'MST' "
^PXRMD(801.41,1140,25,2,0)="and VA offers free MST-related care for both physical and mental health "
^PXRMD(801.41,1140,25,3,0)="concerns. Would you like to speak to a provider about this care? "
^PXRMD(801.41,1140,25,4,0)=" "
^PXRMD(801.41,1140,25,5,0)="{FLD:VA-MST FACTSHEET}"
