^PXRMD(801.41,9954,0)="VA-EL ONC VSAS DESCRIPTION^^^E^^^^^^^1"
^PXRMD(801.41,9954,2)="^^1"
^PXRMD(801.41,9954,25,0)="^^36^36^3150115"
^PXRMD(801.41,9954,25,1,0)="The VA-Oncology Symptom Assessment Scale (VSAS) is a tool for "
^PXRMD(801.41,9954,25,2,0)="documentation of symptoms in Veterans with cancer."
^PXRMD(801.41,9954,25,3,0)=" "
^PXRMD(801.41,9954,25,4,0)="The tool uses a 10-point symptom scale (0 = absent and 10 = worst "
^PXRMD(801.41,9954,25,5,0)="possible) for assessment of:"
^PXRMD(801.41,9954,25,6,0)=" "
^PXRMD(801.41,9954,25,7,0)="Pain = an unpleasant sensation occurring in varying degrees of "
^PXRMD(801.41,9954,25,8,0)="severity<br>"
^PXRMD(801.41,9954,25,9,0)="Tiredness/fatigue = lack of energy<br>"
^PXRMD(801.41,9954,25,10,0)="Anorexia = loss of appetite<br>"
^PXRMD(801.41,9954,25,11,0)="Nausea = sickness at the stomach<br>"
^PXRMD(801.41,9954,25,12,0)="Vomiting = to eject part or all of the contents of the stomach through the"
^PXRMD(801.41,9954,25,13,0)="mouth<br>"
^PXRMD(801.41,9954,25,14,0)="Diarrhea = excessive and frequent evacuation of watery feces<br>"
^PXRMD(801.41,9954,25,15,0)="Constipation = difficult, incomplete, or infrequent bowel evacuation<br>"
^PXRMD(801.41,9954,25,16,0)="Shortness of breath (SOB) at rest = difficult/labored breathing while"
^PXRMD(801.41,9954,25,17,0)="at rest<br>"
^PXRMD(801.41,9954,25,18,0)="Shortness of breath (SOB) with exertion = difficult/labored breathing that"
^PXRMD(801.41,9954,25,19,0)="is out of proportion to the level of physical activity<br>"
^PXRMD(801.41,9954,25,20,0)="Drowsiness = feeling sleepy<br>"
^PXRMD(801.41,9954,25,21,0)="Depression = feeling sad<br>"
^PXRMD(801.41,9954,25,22,0)="Anxiety = feeling nervous<br>"
^PXRMD(801.41,9954,25,23,0)="Distress = feeling uneasy<br>"
^PXRMD(801.41,9954,25,24,0)="Other<br>"
^PXRMD(801.41,9954,25,25,0)=" "
^PXRMD(801.41,9954,25,26,0)="To use the tool, check the box for a symptom to expand the section and "
^PXRMD(801.41,9954,25,27,0)="enter the score (0 to 10) for that symptom.  Any symptom not checked is "
^PXRMD(801.41,9954,25,28,0)="not included in the note and not required.  A score must be entered for "
^PXRMD(801.41,9954,25,29,0)="any symptom checked to be able to complete and sign the template.  "
^PXRMD(801.41,9954,25,30,0)=" "
^PXRMD(801.41,9954,25,31,0)="The pain score entered in VSAS will appear as a pain score in the vital "
^PXRMD(801.41,9954,25,32,0)="signs.  Thus, VSAS can be used as an alternative means of entering the "
^PXRMD(801.41,9954,25,33,0)="pain score.  "
^PXRMD(801.41,9954,25,34,0)=" "
^PXRMD(801.41,9954,25,35,0)="Please see the VSAS User's Guide for suggestions on integration into "
^PXRMD(801.41,9954,25,36,0)="clinical care.  "
^PXRMD(801.41,9954,100)="N^39"
^PXRMD(801.41,9954,110,0)="^801.44D^1^1"
^PXRMD(801.41,9954,110,1,0)="3150115.125136^17"
