^PXRMD(801.41,199,0)="VA-TEXT POLYTRAUMA MARKER^^^E^^^^^^^1"
^PXRMD(801.41,199,2)="^^1"
^PXRMD(801.41,199,25,0)="^^11^11^3100602"
^PXRMD(801.41,199,25,1,0)="This reminder was activated through an algorithm which identifies "
^PXRMD(801.41,199,25,2,0)="patients who may have experienced severe Polytrauma due to OEF/OIF combat "
^PXRMD(801.41,199,25,3,0)="related injuries.  By definition, Polytrauma occurs due to a single event "
^PXRMD(801.41,199,25,4,0)="with injuries to more than one physical region or organ system, one of "
^PXRMD(801.41,199,25,5,0)="which may be life threatening, and which results in physical, cognitive, "
^PXRMD(801.41,199,25,6,0)="psychological, or psychosocial impairments and functional disability.  "
^PXRMD(801.41,199,25,7,0)="The following questions will serve as the clinical confirmation that the "
^PXRMD(801.41,199,25,8,0)="injuries experienced by this patient meet the definition of severe "
^PXRMD(801.41,199,25,9,0)="Polytrauma related to OEF/OIF combat.  Please ask the following "
^PXRMD(801.41,199,25,10,0)="questions, and direct the patient to answer based on the time frame of "
^PXRMD(801.41,199,25,11,0)="their deployment in an OEF/OIF theatre of operation."
^PXRMD(801.41,199,100)="N^24"
