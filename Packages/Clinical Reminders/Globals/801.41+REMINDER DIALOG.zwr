^PXRMD(801.41,841,0)="VA-TEXT DEPRESSION EVAL INSTRUCTIONS^^^E^^^^^^^1"
^PXRMD(801.41,841,2)="^^1"
^PXRMD(801.41,841,25,0)="^^18^18^3050311"
^PXRMD(801.41,841,25,1,0)="ASSESSMENT OF A POSITIVE SCREEN FOR DEPRESSION <br>"
^PXRMD(801.41,841,25,2,0)="Patients with a positive depression screen should be assessed  for Major"
^PXRMD(801.41,841,25,3,0)="Depressive Disorder based on DSM-IV criteria and should be assessed for"
^PXRMD(801.41,841,25,4,0)="the need for therapy, intervention and/or referral."
^PXRMD(801.41,841,25,5,0)=" "
^PXRMD(801.41,841,25,6,0)="1.  Assess if patient is at high risk (marked psychotic symptoms,"
^PXRMD(801.41,841,25,7,0)="       suicidality, potential for violence, delirium)"
^PXRMD(801.41,841,25,8,0)="2.  Further questions regarding current signs & symptoms of depression<br>"
^PXRMD(801.41,841,25,9,0)="3.  Obtain careful psychiatric history of past depressive episodes<br>"
^PXRMD(801.41,841,25,10,0)="4.  Attention to 'red flags'."
^PXRMD(801.41,841,25,11,0)=" "
^PXRMD(801.41,841,25,12,0)="Review history for substance abuse, other illness as a "
^PXRMD(801.41,841,25,13,0)="cause of depression, medication as a cause of depression "
^PXRMD(801.41,841,25,14,0)="and for the severity of the depression.  Patients who may"
^PXRMD(801.41,841,25,15,0)="fit the DSM-IV criteria for Major Depressive Disorder "
^PXRMD(801.41,841,25,16,0)="should be considered for referral to a mental health "
