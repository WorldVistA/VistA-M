^PXRMD(801.41,1126,25,1,0)="-------- DON'T FORGET -----------------\\"
^PXRMD(801.41,1126,25,2,0)="-- Add the patient's primary care provider as an additional signer.\\"
^PXRMD(801.41,1126,25,3,0)="-- Offer a copy of this progress note to the patient or surrogate (upon "
^PXRMD(801.41,1126,25,4,0)="discharge for hospitalized patients).\\"
^PXRMD(801.41,1126,25,5,0)="-- If available and if the patient resides in the community, offer a "
^PXRMD(801.41,1126,25,6,0)="state-authorized portable order (e.g., POLST, MOST) (upon discharge for"
^PXRMD(801.41,1126,25,7,0)="hospitalized patients).\\"
^PXRMD(801.41,1126,25,8,0)=" "
^PXRMD(801.41,1126,25,9,0)="-------- REQUIRED FOR SUPERVISED PRACTITIONERS ---------------"
