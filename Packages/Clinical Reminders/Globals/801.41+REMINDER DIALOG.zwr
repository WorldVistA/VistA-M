^PXRMD(801.41,161,25,0)="^^1^1^3130716"
^PXRMD(801.41,161,25,1,0)="View more information and links to VHA Guidelines:"
^PXRMD(801.41,161,100)="N^12"
^PXRMD(801.41,161,110,0)="^801.44D^1^1"
