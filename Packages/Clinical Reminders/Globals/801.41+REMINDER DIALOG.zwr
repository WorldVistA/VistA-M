^PXRMD(801.41,8274,2)="^^1"
^PXRMD(801.41,8274,25,0)="^^2^2^3150115"
^PXRMD(801.41,8274,25,1,0)="2 = Ambulatory and capable of all selfcare but unable to carry out any "
^PXRMD(801.41,8274,25,2,0)="work activities. Up and about more than 50% of waking hours."
^PXRMD(801.41,8274,100)="N^39"
