^PXRMD(801.41,10558,35,0)="^^6^6^3141114"
^PXRMD(801.41,10558,35,1,0)="\\The patient was found to be asymptomatic with a temperature"
^PXRMD(801.41,10558,35,2,0)="\\less than 100.4 F (38.0 C)."
^PXRMD(801.41,10558,35,3,0)="\\"
^PXRMD(801.41,10558,35,4,0)="\\The patient was determined to have HIGH RISK exposure of the"
