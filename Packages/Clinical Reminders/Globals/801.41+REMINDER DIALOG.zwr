^PXRMD(801.41,4658,25,0)="^^2^2^3170313"
^PXRMD(801.41,4658,25,1,0)="Authorized surrogate if/when the patient loses decision-making "
^PXRMD(801.41,4658,25,2,0)="capacity:"
^PXRMD(801.41,4658,35,0)="^^1^1^3170313"
^PXRMD(801.41,4658,35,1,0)="VA-AUTHORIZED SURROGATE IF/WHEN PATIENT LOSES DECISION-MAKING CAPACITY"
^PXRMD(801.41,4658,100)="N^18"
^PXRMD(801.41,4658,110,0)="^801.44D^1^1"
^PXRMD(801.41,4658,110,1,0)="3170313.145325^54"
^PXRMD(801.41,4658,110,1,1,0)="^^1^1^3170313"
