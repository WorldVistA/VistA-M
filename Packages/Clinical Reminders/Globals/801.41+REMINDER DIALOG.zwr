^PXRMD(801.41,7352,25,0)="^^2^2^3140306"
^PXRMD(801.41,7352,25,1,0)="View more detailed guidance on the use of Pneumococcal polysaccharide"
^PXRMD(801.41,7352,25,2,0)="vaccine PPSV23 (Pneumovax)"
^PXRMD(801.41,7352,100)="N^3"
^PXRMD(801.41,7352,110,0)="^801.44D^1^1"
^PXRMD(801.41,7352,110,1,0)="3140306.100512^17"
^PXRMD(801.41,7352,110,1,1,0)="^^1^1^3140306"
^PXRMD(801.41,7352,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,7352,110,"B",3140306.100512,1)=""
^PXRMD(801.41,7353,0)="VA-IM PNEUMOC VHA GUIDANCE LINKS^^^E^^^^^^^1"
^PXRMD(801.41,7353,2)="^^1"
^PXRMD(801.41,7353,25,0)="^^55^55^3160523"
^PXRMD(801.41,7353,25,1,0)="{FLD:IM PNEUMOCOCCAL VACCINE NCP GUIDANCE}"
^PXRMD(801.41,7353,25,2,0)="{FLD:IM PNEUMOCOCCAL VACCINE ALGORITHM}"
^PXRMD(801.41,7353,25,3,0)=" "
^PXRMD(801.41,7353,25,4,0)="PPSV23 (Pneumovax) has been recommended for some adults since 1997.  "
^PXRMD(801.41,7353,25,5,0)=" "
^PXRMD(801.41,7353,25,6,0)="PCV13 (Prevnar 13) is a different vaccine and newly recommended for "
^PXRMD(801.41,7353,25,7,0)="some adults starting in 2013 and for all adults ages 65 and older "
^PXRMD(801.41,7353,25,8,0)="beginning in 2014.  There is a separate  clinical reminder for PCV13"
^PXRMD(801.41,7353,25,9,0)="(Prevnar 13)"
^PXRMD(801.41,7353,25,10,0)=" "
^PXRMD(801.41,7353,25,11,0)="* Which adults should receive PPSV23 (Pneumovax)?"
^PXRMD(801.41,7353,25,12,0)="      All those age 65 and older "
^PXRMD(801.41,7353,25,13,0)=" "
^PXRMD(801.41,7353,25,14,0)="      Ages 19-64 if they are a smoker, live in long-term care facility,"
^PXRMD(801.41,7353,25,15,0)="       chronic lung, heart, liver or kidney disease (nephrotic syndrome,"
^PXRMD(801.41,7353,25,16,0)="       CKD III-V or renal failure), diabetes, alcoholism, have"
^PXRMD(801.41,7353,25,17,0)="       immunocompromising conditions, nephrotic syndrome, CKD Stages "
^PXRMD(801.41,7353,25,18,0)="       III, IV or V, renal failure, functional or anatomic asplenia, CSF"
^PXRMD(801.41,7353,25,19,0)="       leaks, or cochlear implants"
^PXRMD(801.41,7353,25,20,0)=" "
^PXRMD(801.41,7353,25,21,0)=" "
^PXRMD(801.41,7353,25,22,0)="* How many doses of PPSV23 (Pneumovax) should be given and when should "
^PXRMD(801.41,7353,25,23,0)="   they be given?"
^PXRMD(801.41,7353,25,24,0)="      One dose for those ages 19-64 with any indications listed above"
^PXRMD(801.41,7353,25,25,0)=" "
^PXRMD(801.41,7353,25,26,0)="      A second dose 5 years later if ages 19-64 for those have "
^PXRMD(801.41,7353,25,27,0)="       immunocompromising conditions, nephrotic syndrome, CKD Stage "
^PXRMD(801.41,7353,25,28,0)="       III, IV or V, renal failure, functional or anatomic asplenia"
^PXRMD(801.41,7353,25,29,0)=" "
^PXRMD(801.41,7353,25,30,0)="      One dose at or after age 65 for all patients, regardless of"
^PXRMD(801.41,7353,25,31,0)="       diagnoses (five years after any prior dose) "
^PXRMD(801.41,7353,25,32,0)=" "
^PXRMD(801.41,7353,25,33,0)="* Can PPSV23 (Pneumovax) and PCV13 (Prevnar 13) be given on the same day?"
^PXRMD(801.41,7353,25,34,0)="      No (see below for time delay needed between these two vaccines,"
^PXRMD(801.41,7353,25,35,0)="       which is different depending on which vaccine was given first)"
^PXRMD(801.41,7353,25,36,0)=" "
^PXRMD(801.41,7353,25,37,0)="* If a patient needs both PPSV23 (Pneumovax) and PCV13 (Prevnar 13), which"
^PXRMD(801.41,7353,25,38,0)="   vaccine should be given first? \\"
^PXRMD(801.41,7353,25,39,0)="      PCV13 (Prevnar 13) should be given first. For adults 64 and younger,"
^PXRMD(801.41,7353,25,40,0)="       or for patients who are immunocompromised, wait at least 8 weeks"
^PXRMD(801.41,7353,25,41,0)="       after a dose of PCV13 (Prevnar 13) before giving PPSV23"
^PXRMD(801.41,7353,25,42,0)="       (Pneumovax). For adults 65 and older who are not immunocompromised,"
^PXRMD(801.41,7353,25,43,0)="       wait at least 12 months after a dose of PCV13 before giving PPSV23."
^PXRMD(801.41,7353,25,44,0)=" "
^PXRMD(801.41,7353,25,45,0)="      PCV13 and PPSV23 should not be co-administered. If a dose of PPSV23"
^PXRMD(801.41,7353,25,46,0)="       is inadvertently given before the recommended time interval, it"
^PXRMD(801.41,7353,25,47,0)="       does not need to be repeated. This clinical reminder automatically"
^PXRMD(801.41,7353,25,48,0)="       waits the correct amount of time if a prior dose of PCV13 (Prevnar"
^PXRMD(801.41,7353,25,49,0)="       13) is on file at this medical center. If patient received PCV13"
^PXRMD(801.41,7353,25,50,0)="       (Prevnar 13 ) somewhere else document that. For adults 64 and"
^PXRMD(801.41,7353,25,51,0)="       younger or for immunocompromised patients, if the date of PCV13"
^PXRMD(801.41,7353,25,52,0)="       administration is at least 8 weeks in the past, PPSV23 can be"
^PXRMD(801.41,7353,25,53,0)="       given. For adults 65 and older who are not immunocompromised, if"
^PXRMD(801.41,7353,25,54,0)="       the date of PCV13 administration is at least 1 year in the past,"
^PXRMD(801.41,7353,25,55,0)="       PPSV23 can be given."
^PXRMD(801.41,7353,100)="N^3"
^PXRMD(801.41,7353,110,0)="^801.44D^1^1"
^PXRMD(801.41,7353,110,1,0)="3160523.130612^54"
^PXRMD(801.41,7353,110,1,1,0)="^^1^1^3160523"
^PXRMD(801.41,7353,110,1,1,1,0)="Exchange Install"
^PXRMD(801.41,7353,110,"B",3160523.130612,1)=""
