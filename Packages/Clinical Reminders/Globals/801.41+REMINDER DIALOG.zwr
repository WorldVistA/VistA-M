^PXRMD(801.41,612000460,25,0)="^^2^2^3061122"
^PXRMD(801.41,612000460,25,1,0)="Limited ability to exercise, increase physical activity as much as "
^PXRMD(801.41,612000460,25,2,0)="possible"
^PXRMD(801.41,612000460,35,0)="^^3^3^3061122"
^PXRMD(801.41,612000460,35,1,0)="The patient has a limited ability to exercise but was encouraged to"
^PXRMD(801.41,612000460,35,2,0)="increase physical activity as much as possible since any increase in"
^PXRMD(801.41,612000460,35,3,0)="activity may be beneficial in improving BP control."
