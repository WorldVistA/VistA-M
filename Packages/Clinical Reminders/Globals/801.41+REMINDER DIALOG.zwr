^PXRMD(801.41,4658,0)="VA-LST SURROGATE SELECTION (G)^^^G^^N^3^^^1^^1"
^PXRMD(801.41,4658,2)="^^0"
^PXRMD(801.41,4658,10,0)="^801.412IA^1^1"
^PXRMD(801.41,4658,10,1,0)="10^10655"
