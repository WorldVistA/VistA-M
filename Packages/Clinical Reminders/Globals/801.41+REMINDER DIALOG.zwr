^PXRMD(801.41,364,25,0)="^^2^2^3150710"
^PXRMD(801.41,364,25,1,0)="NO - denies prior military sexual trauma (MST)"
^PXRMD(801.41,364,25,2,0)="     (answered 'NO' to BOTH questions)"
^PXRMD(801.41,364,35,0)="^^1^1^3150710"
^PXRMD(801.41,364,35,1,0)="Patient denies experiencing military sexual trauma (MST) in the past."
