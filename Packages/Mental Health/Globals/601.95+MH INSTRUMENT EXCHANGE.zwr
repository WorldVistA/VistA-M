^YTT(601.95,106,1,32,0)="ction with other\r\n diagnostic activities and procedures.""},""scaleGroup"":[{""grid1"":0,""grid2"":0,""grid3"":0,""id"":100,""instrument"":154,""name"":""FAST Stage"",""ordInc"":1,""ordMax"":7,""ordMin"":0,""ordTitle"":""Stage"",""scale"":[{""groupId"":100,""id"":509,""na"
^YTT(601.95,106,1,33,0)="me"":""Stage"",""sequence"":2,""xLabel"":""FAST""}],""sequence"":1}],""spec"":{""entryChecksum"":3397187901,""entrySpec"":""{\""name\"": \""FAST\"", \r\n \""copyright\"": \""Copyright  (c) 1984 by Barry Reisberg, M.D.\"", \r\n \""restartDays\"": 2, \r\n \""printTitle\"""
^YTT(601.95,106,1,34,0)=": \""Functional Assessment Staging\"", \r\n \""content\"":[\r\n   {\""id\"": \""i2473\"", \""type\"": \""IntroText\"", "
^YTT(601.95,106,1,35,0)="\r\n    \""text\"": \""The FAST scale is a functional scale designed to evaluate patients at the\r\n moderate-severe stages of dementia. In the early stages the patient may be able\r\n to participate in the FAST administration but usually the "
^YTT(601.95,106,1,36,0)="information should be\r\n collected from a caregiver or, in the case of nursing home care, the nursing\r\n home staff. The FAST Stage is the highest consecutive level of disability.  For\r\n clinical purposes, in addition to staging the lev"
^YTT(601.95,106,1,37,0)="el of disability, additional,\r\n non-ordinal (nonconsecutive) deficits should be noted, since these additional\r\n deficits are of clear clinical relevance.\""\r\n    }, \r\n   {\""id\"": \""q8788\"", \""type\"": \""ChoiceQuestion\"", \""required\"":"
^YTT(601.95,106,1,38,0)=" true, \""inline\"": false, \r\n    \""text\"": \""1. Check the highest consecutive level of disability:\"", \r\n    \""intro\"": \""The FAST scale is a functional scale designed to evaluate patients at the\r\n moderate-severe stages of dementia. In"
^YTT(601.95,106,1,39,0)=" the early stages the patient may be able\r\n to participate in the FAST administration but usually the information should be\r\n collected from a caregiver or, in the case of nursing home care, the nursing\r\n home staff. The FAST Stage is"
^YTT(601.95,106,1,40,0)=" the highest consecutive level of disability.  For\r\n clinical purposes, in addition to staging the level of disability, additional,\r\n non-ordinal (nonconsecutive) deficits should be noted, since these additional\r\n deficits are of clea"
^YTT(601.95,106,1,41,0)="r clinical relevance.\"", \r\n    \""columns\"": 1, \r\n    \""choices\"":[\r\n     {\""id\"": \""c5335\"", \""text\"": \"" 1 No difficulty, either subjectively or objectively.\""}, \r\n     {\""id\"": \""c5336\"", \""text\"": \"" 2 Complains of forgetting loc"
^YTT(601.95,106,1,42,0)="ation of objects. Subjective work difficulties.\""}, \r\n     {\""id\"": \""c5337\"", \""text\"": \"" 3 Decreased job functioning evident to co-workers.  Difficulty in traveling to\r\n new locations.  Decreased organizational capacity.\""}, \r\n    "
^YTT(601.95,106,1,43,0)=" {\""id\"": \""c5338\"", \""text\"": \"" 4 Decreased ability to perform complex tasks, e.g. planning dinner for guests,\r\n handling personal finances (such as forgetting to pay bills), difficulty\r\n marketing, etc.\""}, \r\n     {\""id\"": \""c5339\"
^YTT(601.95,106,1,44,0)=""", \""text\"": \"" 5 Requires assistance in choosing proper clothing to wear for the day, season,\r\n or occasion, e.g. patient may wear the same clothing repeatedly, unless\r\n supervised.\""}, \r\n     {\""id\"": \""c5340\"", \""text\"": \"" 6a Impr"
^YTT(601.95,106,1,45,0)="operly putting on clothes without assistance or cuing (e.g. may put\r\n street clothes on over night clothes, or put shoes on wrong feet, or have\r\n difficulty buttoning clothing) occasionally or more frequently over the past\r\n weeks.\""}"
^YTT(601.95,106,1,46,0)=", \r\n     {\""id\"": \""c5341\"", \""text\"": \"" 6b Unable to bathe (shower) properly (e.g., difficulty adjusting bath-water\r\n (shower) temperature) occasionally or more frequently over the past weeks.\""}, \r\n     {\""id\"": \""c5342\"", \""text\"""
^YTT(601.95,106,1,47,0)=": \"" 6c Inability to handle mechanics of toileting (e.g., forgets to flush the\r\n toilet, does not wipe properly or properly dispose of toilet tissue)\r\n occasionally or more frequently over the past weeks.\""}, \r\n     {\""id\"": \""c5343\"""
^YTT(601.95,106,1,48,0)=", \""text\"": \"" 6d Urinary incontinence (occasionally or more frequently over the past weeks).\""}, \r\n     {\""id\"": \""c5344\"", \""text\"": \"" 6e Fecal incontinence (occasionally or more frequently over the past weeks).\""}, \r\n     {\""id\"": \"
^YTT(601.95,106,1,49,0)="""c5345\"", \""text\"": \"" 7a Ability to speak limited to approximately a half a dozen intelligible\r\n different words or fewer, in the course of an average day or in the course of an\r\n intensive interview.\""}, \r\n     {\""id\"": \""c5346\"", \"
^YTT(601.95,106,1,50,0)="""text\"": \"" 7b Speech ability limited to the use of a single intelligible word in an average\r\n day or in the course of an interview (the person may repeat the word over and\r\n over).\""}, \r\n     {\""id\"": \""c5347\"", \""text\"": \"" 7c Ambul"
^YTT(601.95,106,1,51,0)="atory ability lost (cannot walk without personal assistance).\""}, "
^YTT(601.95,106,1,52,0)="\r\n     {\""id\"": \""c5348\"", \""text\"": \"" 7d Cannot sit up without assistance (e.g., the individual will fall over if\r\n there are no lateral rests [arms] on the chair).\""}, \r\n     {\""id\"": \""c5349\"", \""text\"": \"" 7e Loss of ability to s"
^YTT(601.95,106,1,53,0)="mile.\""}, \r\n     {\""id\"": \""c5350\"", \""text\"": \"" 7f Loss of ability to hold up head independently.\""}\r\n   ]}], \r\n \""rules\"":[\r\n   {\""question\"": \""q3909\"", \""operator\"": \""EQ\"", \""value\"": \""c241\"", \r\n    \""skips\"":[\""q3916\"",\""q"
^YTT(601.95,106,1,54,0)="3917\"",\""q3918\"",\""q3919\"",\""q3920\"",\""q3921\"",\""q3922\"",\""q3923\"",\""q3924\"",\""q3925\"",\""q3926\"",\""q3927\"",\""q3928\"",\""q3929\"",\""q3932\""]}]\r\n}"",""instrument"":154,""lastUpdate"":""2022-12-19T20:44:27"",""specIen"":47},""verify"":[""601.71:154"",""601."
