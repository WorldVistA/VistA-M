^YTT(601.95,117,1,427,0)="""licenseCurrent"":false,""name"":""PCL-5 WEEKLY"",""national"":true,""normSample"":null,""operational"":""Y"",""printTitle"":""PTSD Checklist from DSM-5 Weekly"",""publicationDate"":2018,""publisher"":null,""purpose"":""PTSD Symptom Checklist for DSM 5"",""reference"
