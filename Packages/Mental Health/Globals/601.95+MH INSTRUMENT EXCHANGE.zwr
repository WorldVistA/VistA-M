^YTT(601.95,18,1,1051,0)="guish from BLUNTED AFFECT, in which deficits in facial expression, body gesture, and voice pattern are scored."",""required"":null,""responseTypeId"":1,""responseTypeText"":""MCHOICE"",""sequence"":3},{""choice"":[{""choiceId"":106380,""choiceText"":""Not Re"
