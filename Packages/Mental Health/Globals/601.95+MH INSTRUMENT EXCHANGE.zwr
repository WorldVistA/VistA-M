^YTT(601.95,18,1,1222,0)="uestionId"":7837,""scaleId"":1050,""targetText"":""Mild - Strange behavior but not obviously bizarre, e.g., infrequent head-tilting (from side to side) in a rhythmic fashion, intermittent abnormal finger movements."",""value"":2},{""id"":10175,""questi"
