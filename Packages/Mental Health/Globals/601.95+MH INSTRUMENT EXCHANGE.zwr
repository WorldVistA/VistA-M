^YTT(601.95,117,1,141,0)=":""HOWELL,LYNN"",""entryDate"":""2013-02-15"",""fullText"":true,""id"":148,""interpretiveText"":""  Guide for interpreting the PCL-5 (range 0-80):\r\n    Values with higher scores indicate more probable PTSD. "",""lastEditDate"":3230130.2358,""lastEditedBy"""
^YTT(601.95,117,1,142,0)=":""MELDRUM,KEVIN"",""legacy"":false,""licenseCurrent"":false,""name"":""PCL-5"",""national"":true,""normSample"":null,""operational"":""Y"",""printTitle"":""PCL-5 PTSD Checklist from DSM-5"",""publicationDate"":2013,""publisher"":null,""purpose"":""PTSD Symptom Checkli"
