^YTT(601.95,465,1,173,0)=""",""wasOperational"":true},""report"":{""id"":215,""instrument"":292,""template"":""|Eating Disorder Examination Questionnaire (EDE-Q)\r\n|  \r\n|   Date Given: <.Date_Given.>\r\n|   Clinician: <.Staff_Ordered_By.>\r\n|   Location:  <.Location.>\r\n| "
