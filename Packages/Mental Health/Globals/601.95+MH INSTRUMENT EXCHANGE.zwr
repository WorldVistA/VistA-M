^YTT(601.95,277,1,160,0)="above 11) calls for further examination. \r\n   A score below 13 on Protective Factors is clinically significant."",""lastEditDate"":3230817.1815,""lastEditedBy"":""Schultz, Roger"",""legacy"":false,""licenseCurrent"":false,""name"":""BAM-IOP-CSG-SUD"",""n"
