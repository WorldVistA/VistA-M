^YTT(601.712,44,1,4,0)=" ""content"":["
^YTT(601.712,44,1,5,0)="   {""id"": ""i1772"", ""type"": ""IntroText"","
^YTT(601.712,44,1,6,0)="    ""text"": ""<strong>Instructions:</strong> Below is a"
^YTT(601.712,44,1,7,0)=" list of problems that people sometimes have in response to a very stressful"
^YTT(601.712,44,1,8,0)=" experience. Please read each problem carefully and then select one of the"
^YTT(601.712,44,1,9,0)=" numbers below to indicate how much you have been bothered by that problem <u>in the"
^YTT(601.712,44,1,10,0)=" past month</u>.<br /><br /><strong>In the past month, how much were you bothered by:</strong>"""
^YTT(601.712,44,1,11,0)="    },"
^YTT(601.712,44,1,12,0)="   {""id"": ""q6841"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true,"
^YTT(601.712,44,1,13,0)="    ""text"": ""1. Repeated, disturbing, and unwanted memories of the stressful experience?"","
^YTT(601.712,44,1,14,0)="    ""intro"": ""<strong>Instructions:</strong> Below is a list of problems that people sometimes have in response"
^YTT(601.712,44,1,15,0)=" to a very stressful experience. Please read each problem carefully and then"
^YTT(601.712,44,1,16,0)=" select one of the numbers below to indicate how much you have been bothered by"
^YTT(601.712,44,1,17,0)=" that problem <u>in the past month</u>.<br /><br /><strong>In the past month, how much were you bothered by:</strong>"","
^YTT(601.712,44,1,18,0)="    ""columns"": 1,"
^YTT(601.712,44,1,19,0)="    ""choices"":["
