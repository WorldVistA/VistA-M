^YTT(601.712,91,1,92,0)="     {""id"": ""c2440"", ""text"": ""4. Moderately severe hallucinations"", ""quickKey"": 4}, "
^YTT(601.712,91,1,93,0)="     {""id"": ""c2441"", ""text"": ""5. Severe hallucinations"", ""quickKey"": 5}, "
^YTT(601.712,91,1,94,0)="     {""id"": ""c2442"", ""text"": ""6. Extremely severe hallucinations"", ""quickKey"": 6}, "
^YTT(601.712,91,1,95,0)="     {""id"": ""c2443"", ""text"": ""7. Continuous hallucinations"", ""quickKey"": 7}"
^YTT(601.712,91,1,96,0)="   ]}, "
^YTT(601.712,91,1,97,0)="   {""id"": ""q7319"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,91,1,98,0)="    ""text"": ""10. AUDITORY DISTURBANCES - Ask, \u0022Are you more aware of sounds around you?"
^YTT(601.712,91,1,99,0)=" Are they harsh? Do they frighten you? Are you hearing anything that is"
^YTT(601.712,91,1,100,0)=" disturbing to you? Are you hearing things you know are not there?\u0022"
^YTT(601.712,91,1,101,0)=" Observation: "", "
