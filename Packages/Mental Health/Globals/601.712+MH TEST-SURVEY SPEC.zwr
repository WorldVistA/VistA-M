^YTT(601.712,136,1,9,0)="   {""id"": ""q8631"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,136,1,10,0)="    ""text"": ""1. I see problems as a threat to my well-being."", "
