^YTT(601.712,54,1,18,0)="     {""id"": ""c782"", ""text"": ""2. Disagree"", ""quickKey"": 2}, "
^YTT(601.712,54,1,19,0)="     {""id"": ""c783"", ""text"": ""3. Agree"", ""quickKey"": 3}, "
^YTT(601.712,54,1,20,0)="     {""id"": ""c785"", ""text"": ""4. Strongly agree"", ""quickKey"": 4}"
