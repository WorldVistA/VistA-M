^YTT(601.712,23,1,1,0)="{""name"": ""SF36"", "
^YTT(601.712,23,1,2,0)=" ""copyright"": ""Medical Outcomes Trust"", "
^YTT(601.712,23,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,23,1,4,0)=" ""printTitle"": ""SF-36 Health Survey"","
^YTT(601.712,23,1,5,0)=" ""content"":["
^YTT(601.712,23,1,6,0)="   {""id"": ""i52"", ""type"": ""IntroText"", "
^YTT(601.712,23,1,7,0)="    ""text"": ""This survey asks for your views about your health.  This information will help"
^YTT(601.712,23,1,8,0)=" keep track of how you feel and how well you are able to do your usual"
^YTT(601.712,23,1,9,0)=" activities. Answer every question by making the appropriate selection.  If you"
^YTT(601.712,23,1,10,0)=" are unsure about how to answer a question, please give the best answer you can."""
^YTT(601.712,23,1,11,0)="    }, "
^YTT(601.712,23,1,12,0)="   {""id"": ""q3549"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,23,1,13,0)="    ""text"": ""1. In general, would you say your health is: "", "
^YTT(601.712,23,1,14,0)="    ""intro"": ""This survey asks for your views about your health.  This information will help"
^YTT(601.712,23,1,15,0)=" keep track of how you feel and how well you are able to do your usual"
^YTT(601.712,23,1,16,0)=" activities. Answer every question by making the appropriate selection.  If you"
^YTT(601.712,23,1,17,0)=" are unsure about how to answer a question, please give the best answer you can."", "
^YTT(601.712,23,1,18,0)="    "
^YTT(601.712,23,1,19,0)="    ""choices"":["
^YTT(601.712,23,1,20,0)="     {""id"": ""c1059"", ""text"": ""1. Excellent"", ""quickKey"": 1}, "
^YTT(601.712,23,1,21,0)="     {""id"": ""c1060"", ""text"": ""2. Very good"", ""quickKey"": 2}, "
^YTT(601.712,23,1,22,0)="     {""id"": ""c1061"", ""text"": ""3. Good"", ""quickKey"": 3}, "
^YTT(601.712,23,1,23,0)="     {""id"": ""c1062"", ""text"": ""4. Fair"", ""quickKey"": 4}, "
^YTT(601.712,23,1,24,0)="     {""id"": ""c1063"", ""text"": ""5. Poor"", ""quickKey"": 5}"
^YTT(601.712,23,1,25,0)="   ]}, "
^YTT(601.712,23,1,26,0)="   {""id"": ""q3550"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,23,1,27,0)="    ""text"": ""2. COMPARED TO ONE YEAR AGO, how would you rate your health in general now? "", "
^YTT(601.712,23,1,28,0)="    "
^YTT(601.712,23,1,29,0)="    ""choices"":["
^YTT(601.712,23,1,30,0)="     {""id"": ""c1064"", ""text"": ""1. Much better now than one year ago"", ""quickKey"": 1}, "
^YTT(601.712,23,1,31,0)="     {""id"": ""c1065"", ""text"": ""2. Somewhat better now than one year ago"", ""quickKey"": 2}, "
^YTT(601.712,23,1,32,0)="     {""id"": ""c1066"", ""text"": ""3. About the same as one year ago"", ""quickKey"": 3}, "
^YTT(601.712,23,1,33,0)="     {""id"": ""c1067"", ""text"": ""4. Somewhat worse now than one year ago"", ""quickKey"": 4}, "
^YTT(601.712,23,1,34,0)="     {""id"": ""c1068"", ""text"": ""5. Much worse now than one year ago"", ""quickKey"": 5}"
^YTT(601.712,23,1,35,0)="   ]}, "
^YTT(601.712,23,1,36,0)="   {""id"": ""i53"", ""type"": ""IntroText"", "
^YTT(601.712,23,1,37,0)="    ""text"": ""The following items are about activities you might do during a typical day.  Does"
^YTT(601.712,23,1,38,0)=" YOUR HEALTH NOW LIMIT YOU in the activities? If so, how much?"""
^YTT(601.712,23,1,39,0)="    }, "
^YTT(601.712,23,1,40,0)="   {""id"": ""q3551"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,23,1,41,0)="    ""text"": ""3. During a typical day, does YOUR HEALTH NOW LIMIT YOU in: VIGOROUS ACTIVITIES,"
^YTT(601.712,23,1,42,0)=" such as running, lifting heavy objects, participating in strenuous sports. "", "
^YTT(601.712,23,1,43,0)="    ""intro"": ""The following items are about activities you might do during a typical day.  Does"
^YTT(601.712,23,1,44,0)=" YOUR HEALTH NOW LIMIT YOU in the activities? If so, how much?"", "
