^YTT(601.712,197,1,1,0)="{""name"": ""MAHC-10"", "
^YTT(601.712,197,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,197,1,3,0)=" ""printTitle"": ""Missouri Alliance for Home Care - 10 questions"", "
^YTT(601.712,197,1,4,0)=" ""content"":["
^YTT(601.712,197,1,5,0)="   {""id"": ""i2616"", ""type"": ""IntroText"", "
^YTT(601.712,197,1,6,0)="    ""text"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,7,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,8,0)=" listed below, scoring should be based on your clinical judgment."""
^YTT(601.712,197,1,9,0)="    }, "
^YTT(601.712,197,1,10,0)="   {""id"": ""q9557"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,11,0)="    ""text"": ""1. Age 65+"", "
^YTT(601.712,197,1,12,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,13,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,14,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,15,0)="    ""columns"": 1, "
^YTT(601.712,197,1,16,0)="    ""choices"":["
^YTT(601.712,197,1,17,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,18,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,19,0)="   ]}, "
^YTT(601.712,197,1,20,0)="   {""id"": ""q9558"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,21,0)="    ""text"": ""2. Diagnosis (3 or more co-existing)<br /> Includes only documented medical"
^YTT(601.712,197,1,22,0)=" diagnoses"", "
^YTT(601.712,197,1,23,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,24,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,25,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,26,0)="    ""columns"": 1, "
^YTT(601.712,197,1,27,0)="    ""choices"":["
^YTT(601.712,197,1,28,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,29,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,30,0)="   ]}, "
^YTT(601.712,197,1,31,0)="   {""id"": ""q9559"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,32,0)="    ""text"": ""3. Prior history of falls within 3 months<br /> Any unintentional change in"
^YTT(601.712,197,1,33,0)=" position resulting in coming to rest on the ground or at a lower level"", "
^YTT(601.712,197,1,34,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,35,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,36,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,37,0)="    ""columns"": 1, "
^YTT(601.712,197,1,38,0)="    ""choices"":["
^YTT(601.712,197,1,39,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,40,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,41,0)="   ]}, "
^YTT(601.712,197,1,42,0)="   {""id"": ""q9560"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,43,0)="    ""text"": ""4. Incontinence<br /> Inability to make it to the bathroom or commode in timely"
^YTT(601.712,197,1,44,0)=" manner<br /> Includes frequency, urgency, and/or nocturia."", "
^YTT(601.712,197,1,45,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,46,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,47,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,48,0)="    ""columns"": 1, "
^YTT(601.712,197,1,49,0)="    ""choices"":["
^YTT(601.712,197,1,50,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,51,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,52,0)="   ]}, "
^YTT(601.712,197,1,53,0)="   {""id"": ""q9561"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,54,0)="    ""text"": ""5. Visual Impairment<br /> Includes but not limited to, macular degeneration,"
^YTT(601.712,197,1,55,0)=" diabetic retinopathies, visual field loss, age related changes, decline in"
^YTT(601.712,197,1,56,0)=" visual acuity, accommodation, glare tolerance, depth perception, and night"
^YTT(601.712,197,1,57,0)=" vision or not wearing prescribed glasses or having the correct prescription."", "
^YTT(601.712,197,1,58,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,59,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,60,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,61,0)="    ""columns"": 1, "
^YTT(601.712,197,1,62,0)="    ""choices"":["
^YTT(601.712,197,1,63,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,64,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,65,0)="   ]}, "
^YTT(601.712,197,1,66,0)="   {""id"": ""q9562"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,67,0)="    ""text"": ""6. Impaired functional mobility<br /> May include patients who need help with"
^YTT(601.712,197,1,68,0)=" IADLS or ADLS or have gait or transfer problems, arthritis, pain, fear of"
^YTT(601.712,197,1,69,0)=" falling, foot problems, impaired sensation, impaired coordination or improper"
^YTT(601.712,197,1,70,0)=" use of assistive devices."", "
^YTT(601.712,197,1,71,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,72,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,73,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,74,0)="    ""columns"": 1, "
^YTT(601.712,197,1,75,0)="    ""choices"":["
^YTT(601.712,197,1,76,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,77,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,78,0)="   ]}, "
^YTT(601.712,197,1,79,0)="   {""id"": ""q9563"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,80,0)="    ""text"": ""7. Environmental hazards<br /> May include but not limited to, poor illumination,"
^YTT(601.712,197,1,81,0)=" equipment tubing, inappropriate footwear, pets, hard to reach items, floor"
^YTT(601.712,197,1,82,0)=" surfaces that are uneven or cluttered, or outdoor entry and exits."", "
^YTT(601.712,197,1,83,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,84,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,85,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,86,0)="    ""columns"": 1, "
^YTT(601.712,197,1,87,0)="    ""choices"":["
^YTT(601.712,197,1,88,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,89,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,90,0)="   ]}, "
^YTT(601.712,197,1,91,0)="   {""id"": ""q9564"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,92,0)="    ""text"": ""8. Poly Pharmacy (4 or more prescriptions - any type)<br /> All PRESCRIPTIONS"
^YTT(601.712,197,1,93,0)=" including prescriptions for OTC meds. Drugs highly associated with fall risk"
^YTT(601.712,197,1,94,0)=" include but not limited to, sedatives, anti-depressants, tranquilizers,"
^YTT(601.712,197,1,95,0)=" narcotics, antihypertensives, cardiac meds, corticosteroids, anti-anxiety drugs,"
^YTT(601.712,197,1,96,0)=" anticholinergic drugs, and hypoglycemic drugs. "", "
^YTT(601.712,197,1,97,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,98,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,99,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,100,0)="    ""columns"": 1, "
^YTT(601.712,197,1,101,0)="    ""choices"":["
^YTT(601.712,197,1,102,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,103,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,104,0)="   ]}, "
^YTT(601.712,197,1,105,0)="   {""id"": ""q9565"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,106,0)="    ""text"": ""9. Pain affecting level of function<br /> Pain often affects an individual's"
^YTT(601.712,197,1,107,0)=" desire or ability to move or pain can be a factor in depression or compliance"
^YTT(601.712,197,1,108,0)=" with safety recommendations."", "
^YTT(601.712,197,1,109,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,110,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,111,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,112,0)="    ""columns"": 1, "
^YTT(601.712,197,1,113,0)="    ""choices"":["
^YTT(601.712,197,1,114,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,115,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,116,0)="   ]}, "
^YTT(601.712,197,1,117,0)="   {""id"": ""q9566"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,197,1,118,0)="    ""text"": ""10. Cognitive impairment<br /> Could include patients with dementia, Alzheimer's"
^YTT(601.712,197,1,119,0)=" or stroke patients or patients who are confused, use poor judgment, have"
^YTT(601.712,197,1,120,0)=" decreased comprehension, impulsivity, memory deficits. Consider patients ability"
^YTT(601.712,197,1,121,0)=" to adhere to the plan of care."", "
^YTT(601.712,197,1,122,0)="    ""intro"": ""Required Core Elements<br /> Information may be gathered from medical record,"
^YTT(601.712,197,1,123,0)=" assessment and if applicable, the patient/caregiver.  <br /> Beyond protocols"
^YTT(601.712,197,1,124,0)=" listed below, scoring should be based on your clinical judgment."", "
^YTT(601.712,197,1,125,0)="    ""columns"": 1, "
^YTT(601.712,197,1,126,0)="    ""choices"":["
^YTT(601.712,197,1,127,0)="     {""id"": ""c6173"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,197,1,128,0)="     {""id"": ""c6174"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,197,1,129,0)="   ]}]"
^YTT(601.712,197,1,130,0)="}"
