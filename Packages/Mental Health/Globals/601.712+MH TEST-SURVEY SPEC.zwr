^YTT(601.712,101,1,87,0)="}"
^YTT(601.712,102,0)="231^3220408.091323^4294232885"
^YTT(601.712,102,1,0)="^^403^403^3220408"
^YTT(601.712,102,1,1,0)="{""name"": ""BPRS-A"", "
^YTT(601.712,102,1,2,0)=" ""copyright"": ""Copyright ©2014, CDISC, all rights reserved."", "
^YTT(601.712,102,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,102,1,4,0)=" ""printTitle"": ""Brief Psychiatric Rating Scale- Anchored (BPRS-A)"","
^YTT(601.712,102,1,5,0)=" ""content"":["
^YTT(601.712,102,1,6,0)="   {""id"": ""i2364"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,7,0)="    ""text"": ""Indicate the degree to which each of the following items describes the patient's"
^YTT(601.712,102,1,8,0)=" present condition. <br /> <br /> In the past week:"""
^YTT(601.712,102,1,9,0)="    }, "
^YTT(601.712,102,1,10,0)="   {""id"": ""q7831"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,11,0)="    ""text"": ""1. Somatic Concern - Degree of concern over present bodily health is perceived as"
^YTT(601.712,102,1,12,0)=" problem by the patient, whether the complaints have a realistic basis or not. Do"
^YTT(601.712,102,1,13,0)=" not rate mere reporting of somatic symptoms. Rate only concerns for (or worrying"
^YTT(601.712,102,1,14,0)=" abou t) physical problems (real or imagined)."", "
^YTT(601.712,102,1,15,0)="    ""intro"": ""Indicate the degree to which each of the following items describes the patient's"
^YTT(601.712,102,1,16,0)=" present condition. <br /> <br /> In the past week:"", "
^YTT(601.712,102,1,17,0)="    ""columns"": 1, "
^YTT(601.712,102,1,18,0)="    ""choices"":["
^YTT(601.712,102,1,19,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,20,0)="     {""id"": ""c106381"", ""text"": ""2. Very mild - Occasionally is somewhat concerned about body, symptoms, or"
^YTT(601.712,102,1,21,0)=" physical illness."", ""quickKey"": 2}, "
^YTT(601.712,102,1,22,0)="     {""id"": ""c106382"", ""text"": ""3. Mild - Occasionally is moderately concerned about body, or often is somewhat"
^YTT(601.712,102,1,23,0)=" concerned."", ""quickKey"": 3}, "
^YTT(601.712,102,1,24,0)="     {""id"": ""c106383"", ""text"": ""4. Moderate- Occasionally is very concerned, or often is moderately concerned."", ""quickKey"": 4}, "
^YTT(601.712,102,1,25,0)="     {""id"": ""c106384"", ""text"": ""5. Moderately severe - Often is very concerned."", ""quickKey"": 5}, "
^YTT(601.712,102,1,26,0)="     {""id"": ""c106385"", ""text"": ""6. Severe - Is very concerned."", ""quickKey"": 6}, "
^YTT(601.712,102,1,27,0)="     {""id"": ""c106386"", ""text"": ""7. Very severe - Is very concerned nearly all of the time."", ""quickKey"": 7}"
^YTT(601.712,102,1,28,0)="   ]}, "
^YTT(601.712,102,1,29,0)="   {""id"": ""i2360"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,30,0)="    ""text"": ""In the past week:"""
^YTT(601.712,102,1,31,0)="    }, "
^YTT(601.712,102,1,32,0)="   {""id"": ""q7832"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,33,0)="    ""text"": ""2. Anxiety - Worry, fear, or over concern for present or future. Rate solely on"
^YTT(601.712,102,1,34,0)=" the basis of verbal report of the patient's own subjective experiences. Do not"
^YTT(601.712,102,1,35,0)=" infer anxiety from physical signs or from neurotic defense mechanisms. Do not"
^YTT(601.712,102,1,36,0)=" rate if restricted to somatic concern."", "
^YTT(601.712,102,1,37,0)="    ""intro"": ""In the past week:"", "
^YTT(601.712,102,1,38,0)="    ""columns"": 1, "
^YTT(601.712,102,1,39,0)="    ""choices"":["
^YTT(601.712,102,1,40,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,41,0)="     {""id"": ""c3664"", ""text"": ""2. Very mild - Occasionally feels somewhat anxious."", ""quickKey"": 2}, "
^YTT(601.712,102,1,42,0)="     {""id"": ""c3665"", ""text"": ""3. Mild - Occasionally feels moderately anxious, or often feels somewhat anxious."", ""quickKey"": 3}, "
^YTT(601.712,102,1,43,0)="     {""id"": ""c3666"", ""text"": ""4. Moderate - Occasionally feels very anxious, or often feels moderately anxious."", ""quickKey"": 4}, "
^YTT(601.712,102,1,44,0)="     {""id"": ""c3667"", ""text"": ""5. Moderately severe - Often feels very anxious."", ""quickKey"": 5}, "
^YTT(601.712,102,1,45,0)="     {""id"": ""c3668"", ""text"": ""6. Severe - Feels anxious most of the time."", ""quickKey"": 6}, "
^YTT(601.712,102,1,46,0)="     {""id"": ""c3669"", ""text"": ""7. Very severe - Feels very anxious nearly all of the time."", ""quickKey"": 7}"
^YTT(601.712,102,1,47,0)="   ]}, "
^YTT(601.712,102,1,48,0)="   {""id"": ""i2361"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,49,0)="    ""text"": ""In the past 3 days:"""
^YTT(601.712,102,1,50,0)="    }, "
^YTT(601.712,102,1,51,0)="   {""id"": ""q7833"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,52,0)="    ""text"": ""3. Emotional Withdrawal - Deficiency in relating to the interviewer and to the"
^YTT(601.712,102,1,53,0)=" interview situation. Overt manifestations of this deficiency include"
^YTT(601.712,102,1,54,0)=" poor/absence of eye contact, failure to orient oneself physically toward the"
^YTT(601.712,102,1,55,0)=" interviewer, and a gene ral lack of involvement or engagement in the interview."
^YTT(601.712,102,1,56,0)=" Distinguish from BLUNTED AFFECT, in which deficits in facial expression, body"
^YTT(601.712,102,1,57,0)=" gesture, and voice pattern are scored."", "
^YTT(601.712,102,1,58,0)="    ""intro"": ""In the past 3 days:"", "
^YTT(601.712,102,1,59,0)="    ""columns"": 1, "
^YTT(601.712,102,1,60,0)="    ""choices"":["
^YTT(601.712,102,1,61,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,62,0)="     {""id"": ""c3670"", ""text"": ""2. Very mild - Occasionally exhibits poor eye contact."", ""quickKey"": 2}, "
^YTT(601.712,102,1,63,0)="     {""id"": ""c3671"", ""text"": ""3. Mild- As above, but more frequent."", ""quickKey"": 3}, "
^YTT(601.712,102,1,64,0)="     {""id"": ""c3672"", ""text"": ""4. Moderate - Little eye contact, but still seems engaged in the interview and"
^YTT(601.712,102,1,65,0)=" appropriately responsive to all questions."", ""quickKey"": 4}, "
^YTT(601.712,102,1,66,0)="     {""id"": ""c3673"", ""text"": ""5. Moderately severe - Stares at floor or orients self away from interviewer, but"
^YTT(601.712,102,1,67,0)=" seems moderately engaged."", ""quickKey"": 5}, "
^YTT(601.712,102,1,68,0)="     {""id"": ""c3674"", ""text"": ""6. Severe - As above, but more persistent or pervasive."", ""quickKey"": 6}, "
^YTT(601.712,102,1,69,0)="     {""id"": ""c3675"", ""text"": ""7. Very severe - Appeared \u0022spacey\u0022 or \u0022out of it\u0022 (total"
^YTT(601.712,102,1,70,0)=" absence of emotional relatedness) and is disproportionately uninvolved or"
^YTT(601.712,102,1,71,0)=" unengaged in the interview (DO NOT SCORE IF EXPLAINED BY DISORIENTATION)."", ""quickKey"": 7}"
^YTT(601.712,102,1,72,0)="   ]}, "
^YTT(601.712,102,1,73,0)="   {""id"": ""i2365"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,74,0)="    ""text"": ""In the last 3 days:"""
^YTT(601.712,102,1,75,0)="    }, "
^YTT(601.712,102,1,76,0)="   {""id"": ""q7834"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,77,0)="    ""text"": ""4. Conceptual Disorganization - Degree of speech incomprehensibility. Include any"
^YTT(601.712,102,1,78,0)=" type of formal thought disorder (e.g., loose associations, incoherence, flight"
^YTT(601.712,102,1,79,0)=" of ideas, neologisms). DO NOT include mere circumstantiality or pressured"
^YTT(601.712,102,1,80,0)=" speech, even if marked. DO NOT rate on the patient's subjective impressions"
^YTT(601.712,102,1,81,0)=" (e.g., \u0022My thoughts are racing\u0022, \u0022I can't hold a thought\u0022,"
^YTT(601.712,102,1,82,0)=" \u0022My thinking gets all mixed up\u0022). Rate ONLY on the basis of"
^YTT(601.712,102,1,83,0)=" observations made during the interview."", "
^YTT(601.712,102,1,84,0)="    ""intro"": ""In the last 3 days:"", "
^YTT(601.712,102,1,85,0)="    ""columns"": 1, "
^YTT(601.712,102,1,86,0)="    ""choices"":["
^YTT(601.712,102,1,87,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,88,0)="     {""id"": ""c3676"", ""text"": ""2. Very mild - Somewhat vague, but of doubtful clinical significance."", ""quickKey"": 2}, "
^YTT(601.712,102,1,89,0)="     {""id"": ""c3677"", ""text"": ""3. Mild - Frequently vague, but the interview is able to progress."", ""quickKey"": 3}, "
^YTT(601.712,102,1,90,0)="     {""id"": ""c3678"", ""text"": ""4. Moderate - Occasional irrelevant statements, infrequent use of neologisms, or"
^YTT(601.712,102,1,91,0)=" moderate loosening of associations."", ""quickKey"": 4}, "
^YTT(601.712,102,1,92,0)="     {""id"": ""c3679"", ""text"": ""5. Moderately severe - As above, but more frequent."", ""quickKey"": 5}, "
^YTT(601.712,102,1,93,0)="     {""id"": ""c3680"", ""text"": ""6. Severe - Formal thought disorder is present for most of the interview, and the"
^YTT(601.712,102,1,94,0)=" interview is severely strained."", ""quickKey"": 6}, "
^YTT(601.712,102,1,95,0)="     {""id"": ""c3681"", ""text"": ""7. Very severe - Very little coherent information can be obtained."", ""quickKey"": 7}"
^YTT(601.712,102,1,96,0)="   ]}, "
^YTT(601.712,102,1,97,0)="   {""id"": ""i2360"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,98,0)="    ""text"": ""In the past week:"""
^YTT(601.712,102,1,99,0)="    }, "
^YTT(601.712,102,1,100,0)="   {""id"": ""q7835"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,101,0)="    ""text"": ""5. Guilt Feelings - Overconcern or remorse for past behavior. Rate on patient's"
^YTT(601.712,102,1,102,0)=" subjective experiences of guilt as evidenced by verbal report. Do not infer"
^YTT(601.712,102,1,103,0)=" guilt feelings from depression, anxiety, or neurotic defenses."", "
^YTT(601.712,102,1,104,0)="    ""intro"": ""In the past week:"", "
^YTT(601.712,102,1,105,0)="    ""columns"": 1, "
^YTT(601.712,102,1,106,0)="    ""choices"":["
^YTT(601.712,102,1,107,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,108,0)="     {""id"": ""c3682"", ""text"": ""2. Very mild - Occasionally feels somewhat guilty."", ""quickKey"": 2}, "
^YTT(601.712,102,1,109,0)="     {""id"": ""c3683"", ""text"": ""3. Mild - Occasionally feels moderately guilty, or often feels somewhat guilty."", ""quickKey"": 3}, "
^YTT(601.712,102,1,110,0)="     {""id"": ""c3684"", ""text"": ""4. Moderate - Occasional feels very guilty, or often feels moderately guilty."", ""quickKey"": 4}, "
^YTT(601.712,102,1,111,0)="     {""id"": ""c3685"", ""text"": ""5. Moderately severe - Often feels very guilty."", ""quickKey"": 5}, "
^YTT(601.712,102,1,112,0)="     {""id"": ""c3686"", ""text"": ""6. Severe - Feels guilty most of the time or encapsulated delusions of guilt."", ""quickKey"": 6}, "
^YTT(601.712,102,1,113,0)="     {""id"": ""c3687"", ""text"": ""7. Very severe - Agonizing, constant feeling of guilt, or pervasive delusion(s)"
^YTT(601.712,102,1,114,0)=" of guilt."", ""quickKey"": 7}"
^YTT(601.712,102,1,115,0)="   ]}, "
^YTT(601.712,102,1,116,0)="   {""id"": ""i2361"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,117,0)="    ""text"": ""In the past 3 days:"""
^YTT(601.712,102,1,118,0)="    }, "
^YTT(601.712,102,1,119,0)="   {""id"": ""q7836"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,120,0)="    ""text"": ""6. Tension - Rate motor restlessness (agitation) observed during the interview."
^YTT(601.712,102,1,121,0)=" DO NOT rate on the basis of subjective experiences reported by the patient."
^YTT(601.712,102,1,122,0)=" Disregard suspected pathogenesis (e.g., tardive dyskinesia)."", "
^YTT(601.712,102,1,123,0)="    ""intro"": ""In the past 3 days:"", "
^YTT(601.712,102,1,124,0)="    ""columns"": 1, "
^YTT(601.712,102,1,125,0)="    ""choices"":["
^YTT(601.712,102,1,126,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,127,0)="     {""id"": ""c3688"", ""text"": ""2. Very mild - Occasionally fidgets."", ""quickKey"": 2}, "
^YTT(601.712,102,1,128,0)="     {""id"": ""c3689"", ""text"": ""3. Mild - Frequently fidgets."", ""quickKey"": 3}, "
^YTT(601.712,102,1,129,0)="     {""id"": ""c3690"", ""text"": ""4. Moderate - Constantly fidgets, or frequently fidgets, wrings hands and pulls"
^YTT(601.712,102,1,130,0)=" clothing."", ""quickKey"": 4}, "
^YTT(601.712,102,1,131,0)="     {""id"": ""c3691"", ""text"": ""5. Moderately severe - Constantly fidgets. Wrings hands and pulls clothing."", ""quickKey"": 5}, "
^YTT(601.712,102,1,132,0)="     {""id"": ""c3692"", ""text"": ""6. Severe - Cannot remain seated. (i.e., must pace)."", ""quickKey"": 6}, "
^YTT(601.712,102,1,133,0)="     {""id"": ""c3693"", ""text"": ""7. Very severe - Paces in a frantic manner."", ""quickKey"": 7}"
^YTT(601.712,102,1,134,0)="   ]}, "
^YTT(601.712,102,1,135,0)="   {""id"": ""i2365"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,136,0)="    ""text"": ""In the last 3 days:"""
^YTT(601.712,102,1,137,0)="    }, "
^YTT(601.712,102,1,138,0)="   {""id"": ""q7837"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,139,0)="    ""text"": ""7. Mannerisms And Posturing - Unusual and unnatural motor behavior. Rate only"
^YTT(601.712,102,1,140,0)=" abnormality of movements; do not rate simple heightened motor activity here."
^YTT(601.712,102,1,141,0)=" Consider frequency, duration, and degree of bizarreness. Disregard suspected"
^YTT(601.712,102,1,142,0)=" pathogenesis."", "
^YTT(601.712,102,1,143,0)="    ""intro"": ""In the last 3 days:"", "
^YTT(601.712,102,1,144,0)="    ""columns"": 1, "
^YTT(601.712,102,1,145,0)="    ""choices"":["
^YTT(601.712,102,1,146,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,147,0)="     {""id"": ""c3694"", ""text"": ""2. Very mild  - Odd behavior but doubtful clinical significance, e.g., occasional"
^YTT(601.712,102,1,148,0)=" unprompted smiling, infrequent lip movements."", ""quickKey"": 2}, "
^YTT(601.712,102,1,149,0)="     {""id"": ""c3695"", ""text"": ""3. Mild - Strange behavior but not obviously bizarre, e.g., infrequent"
^YTT(601.712,102,1,150,0)=" head-tilting (from side to side) in a rhythmic fashion, intermittent abnormal"
^YTT(601.712,102,1,151,0)=" finger movements."", ""quickKey"": 3}, "
^YTT(601.712,102,1,152,0)="     {""id"": ""c3696"", ""text"": ""4. Moderate - Assumes yoga position for a brief period of time, infrequent tongue"
^YTT(601.712,102,1,153,0)=" protrusions, rocking."", ""quickKey"": 4}, "
^YTT(601.712,102,1,154,0)="     {""id"": ""c3697"", ""text"": ""5. Moderately severe - Assumes and maintains yoga position throughout interview,"
^YTT(601.712,102,1,155,0)=" unusual movements in several body areas."", ""quickKey"": 5}, "
^YTT(601.712,102,1,156,0)="     {""id"": ""c3698"", ""text"": ""6. Severe - As above, but more frequent, intense, or pervasive."", ""quickKey"": 6}, "
^YTT(601.712,102,1,157,0)="     {""id"": ""c3699"", ""text"": ""7. Very severe - Bizarre posturing throughout most of the interview. Continuous"
^YTT(601.712,102,1,158,0)=" abnormal movements in several body areas."", ""quickKey"": 7}"
^YTT(601.712,102,1,159,0)="   ]}, "
^YTT(601.712,102,1,160,0)="   {""id"": ""i2360"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,161,0)="    ""text"": ""In the past week:"""
^YTT(601.712,102,1,162,0)="    }, "
^YTT(601.712,102,1,163,0)="   {""id"": ""q7838"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,164,0)="    ""text"": ""8. Grandiosity - Inflated self-esteem (self-confidence), or inflated appraisal of"
^YTT(601.712,102,1,165,0)=" one's talents, powers, abilities, accomplishments, knowledge, importance, or"
^YTT(601.712,102,1,166,0)=" identity. Do not score mere grandiose quality of claims (e.g., \u0022I'm the"
^YTT(601.712,102,1,167,0)=" worst sinner in the world,\u0022 \u0022The entire country is trying to kill"
^YTT(601.712,102,1,168,0)=" me\u0022) unless the guilt/persecution is related to some special exaggerated"
^YTT(601.712,102,1,169,0)=" attribute of the individual. Also, the patient must claim exaggerated"
^YTT(601.712,102,1,170,0)=" attributes: e.g., If patient denies talents, powers, etc., even if he/she states"
^YTT(601.712,102,1,171,0)=" that others indicate that he/she has these attributes, this item should not be"
^YTT(601.712,102,1,172,0)=" scored."", "
^YTT(601.712,102,1,173,0)="    ""intro"": ""In the past week:"", "
^YTT(601.712,102,1,174,0)="    ""columns"": 1, "
^YTT(601.712,102,1,175,0)="    ""choices"":["
^YTT(601.712,102,1,176,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,177,0)="     {""id"": ""c3700"", ""text"": ""2. Very mild - Is more confident than most people, but of only possible clinical"
^YTT(601.712,102,1,178,0)=" significance."", ""quickKey"": 2}, "
^YTT(601.712,102,1,179,0)="     {""id"": ""c3701"", ""text"": ""3. Mild - Definitely inflated self-esteem or exaggerates talents somewhat out of"
^YTT(601.712,102,1,180,0)=" proportion to the circumstances."", ""quickKey"": 3}, "
^YTT(601.712,102,1,181,0)="     {""id"": ""c3702"", ""text"": ""4. Moderate - Inflated self-esteem clearly out of proportion to the circumstances"
^YTT(601.712,102,1,182,0)=" or suspected grandiose delusion(s)."", ""quickKey"": 4}, "
^YTT(601.712,102,1,183,0)="     {""id"": ""c3703"", ""text"": ""5. Moderately severe - A single (definite) encapsulated grandiose delusion, or"
^YTT(601.712,102,1,184,0)=" multiple (definite) fragmentary grandiose delusions."", ""quickKey"": 5}, "
^YTT(601.712,102,1,185,0)="     {""id"": ""c3704"", ""text"": ""6. Severe - A single (definite) grandiose delusion/delusional system, or multiple"
^YTT(601.712,102,1,186,0)=" (definite) grandiose delusions that the patient seems preoccupied with."", ""quickKey"": 6}, "
^YTT(601.712,102,1,187,0)="     {""id"": ""c3705"", ""text"": ""7. Very severe - As above, but nearly all conversation is directed towards the"
^YTT(601.712,102,1,188,0)=" patient's grandiose delusion(s)."", ""quickKey"": 7}"
^YTT(601.712,102,1,189,0)="   ]}, "
^YTT(601.712,102,1,190,0)="   {""id"": ""i2366"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,191,0)="    ""text"": ""In the last week:"""
^YTT(601.712,102,1,192,0)="    }, "
^YTT(601.712,102,1,193,0)="   {""id"": ""q7839"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,194,0)="    ""text"": ""9. Depressive Mood - Subjective report of feeling depressed, blue \u0022down in"
^YTT(601.712,102,1,195,0)=" the dumps,\u0022 etc. Rate only the degree of reported depression. Do not rate"
^YTT(601.712,102,1,196,0)=" on the basis of inferences concerning depression based upon general retardation"
^YTT(601.712,102,1,197,0)=" and somatic complaints."", "
^YTT(601.712,102,1,198,0)="    ""intro"": ""In the last week:"", "
^YTT(601.712,102,1,199,0)="    ""columns"": 1, "
^YTT(601.712,102,1,200,0)="    ""choices"":["
^YTT(601.712,102,1,201,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,202,0)="     {""id"": ""c3706"", ""text"": ""2. Very mild - Occasionally feels somewhat depressed."", ""quickKey"": 2}, "
^YTT(601.712,102,1,203,0)="     {""id"": ""c3707"", ""text"": ""3. Mild - Occasionally feels moderately depressed, or often feels somewhat"
^YTT(601.712,102,1,204,0)=" depressed."", ""quickKey"": 3}, "
^YTT(601.712,102,1,205,0)="     {""id"": ""c3708"", ""text"": ""4. Moderate - Occasionally feels very depressed, or often feels moderately"
^YTT(601.712,102,1,206,0)=" depressed."", ""quickKey"": 4}, "
^YTT(601.712,102,1,207,0)="     {""id"": ""c3709"", ""text"": ""5. Moderately severe - Often feels very depressed."", ""quickKey"": 5}, "
^YTT(601.712,102,1,208,0)="     {""id"": ""c3710"", ""text"": ""6. Severe - Feels very depressed most of the time."", ""quickKey"": 6}, "
^YTT(601.712,102,1,209,0)="     {""id"": ""c3711"", ""text"": ""7. Very severe - Feels very depressed nearly all of the time."", ""quickKey"": 7}"
^YTT(601.712,102,1,210,0)="   ]}, "
^YTT(601.712,102,1,211,0)="   {""id"": ""i2360"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,212,0)="    ""text"": ""In the past week:"""
^YTT(601.712,102,1,213,0)="    }, "
^YTT(601.712,102,1,214,0)="   {""id"": ""q7840"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,215,0)="    ""text"": ""10. Hostility - Animosity, contempt, belligerence, disdain for other people"
^YTT(601.712,102,1,216,0)=" outside the interview situation. Rate solely on the basis of the verbal report"
^YTT(601.712,102,1,217,0)=" of feelings and actions of the patient toward others. Do not infer hostility"
^YTT(601.712,102,1,218,0)=" from neurotic defenses, anxiety, or somatic complaints."", "
^YTT(601.712,102,1,219,0)="    ""intro"": ""In the past week:"", "
^YTT(601.712,102,1,220,0)="    ""columns"": 1, "
^YTT(601.712,102,1,221,0)="    ""choices"":["
^YTT(601.712,102,1,222,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,223,0)="     {""id"": ""c3712"", ""text"": ""2. Very mild - Occasionally feels somewhat angry."", ""quickKey"": 2}, "
^YTT(601.712,102,1,224,0)="     {""id"": ""c3713"", ""text"": ""3. Mild - Occasionally feels somewhat angry, or occasionally feels moderately"
^YTT(601.712,102,1,225,0)=" angry."", ""quickKey"": 3}, "
^YTT(601.712,102,1,226,0)="     {""id"": ""c3714"", ""text"": ""4. Moderate - Occasionally feels very angry, or often feels moderately angry."", ""quickKey"": 4}, "
^YTT(601.712,102,1,227,0)="     {""id"": ""c3715"", ""text"": ""5. Moderately severe - Often feels very angry."", ""quickKey"": 5}, "
^YTT(601.712,102,1,228,0)="     {""id"": ""c3716"", ""text"": ""6. Severe - Has acted on his anger by becoming verbally or physically abusive on"
^YTT(601.712,102,1,229,0)=" one or two occasions."", ""quickKey"": 6}, "
^YTT(601.712,102,1,230,0)="     {""id"": ""c3717"", ""text"": ""7. Very severe - Has acted on their anger on several occasions."", ""quickKey"": 7}"
^YTT(601.712,102,1,231,0)="   ]}, "
^YTT(601.712,102,1,232,0)="   {""id"": ""i2366"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,233,0)="    ""text"": ""In the last week:"""
^YTT(601.712,102,1,234,0)="    }, "
^YTT(601.712,102,1,235,0)="   {""id"": ""q7841"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,236,0)="    ""text"": ""11. Suspiciousness - Belief (delusional or otherwise) that others have now, or"
^YTT(601.712,102,1,237,0)=" have had in the past, malicious or discriminatory intent toward the patient. On"
^YTT(601.712,102,1,238,0)=" the basis of verbal report, rate only those suspicions which are currently held"
^YTT(601.712,102,1,239,0)=" whether they concern past or present circumstance."", "
^YTT(601.712,102,1,240,0)="    ""intro"": ""In the last week:"", "
^YTT(601.712,102,1,241,0)="    ""columns"": 1, "
^YTT(601.712,102,1,242,0)="    ""choices"":["
^YTT(601.712,102,1,243,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,244,0)="     {""id"": ""c3718"", ""text"": ""2. Very mild- Rare instances of distrustfulness which may or may not be warranted"
^YTT(601.712,102,1,245,0)=" by the situation."", ""quickKey"": 2}, "
^YTT(601.712,102,1,246,0)="     {""id"": ""c3719"", ""text"": ""3. Mild - Occasional instances of suspiciousness that are definitely not"
^YTT(601.712,102,1,247,0)=" warranted by the situation."", ""quickKey"": 3}, "
^YTT(601.712,102,1,248,0)="     {""id"": ""c3720"", ""text"": ""4. Moderate - More frequent suspiciousness, or transient ideas of reference."", ""quickKey"": 4}, "
^YTT(601.712,102,1,249,0)="     {""id"": ""c3721"", ""text"": ""5. Moderately severe - Pervasive suspiciousness, or frequent ideas of reference."", ""quickKey"": 5}, "
^YTT(601.712,102,1,250,0)="     {""id"": ""c3722"", ""text"": ""6. Severe - Definite delusion(s) of reference or persecution that is (are) not"
^YTT(601.712,102,1,251,0)=" wholly pervasive (e.g., an encapsulated delusion)."", ""quickKey"": 6}, "
^YTT(601.712,102,1,252,0)="     {""id"": ""c3723"", ""text"": ""7. Very severe - As above, but more widespread, frequent, or intense."", ""quickKey"": 7}"
^YTT(601.712,102,1,253,0)="   ]}, "
^YTT(601.712,102,1,254,0)="   {""id"": ""i2360"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,255,0)="    ""text"": ""In the past week:"""
^YTT(601.712,102,1,256,0)="    }, "
^YTT(601.712,102,1,257,0)="   {""id"": ""q7842"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,258,0)="    ""text"": ""12. Hallucinatory Behavior - Perceptions (in any sense modality) in absence of"
^YTT(601.712,102,1,259,0)=" identifiable external stimulus. Rate only experiences that have occurred during"
^YTT(601.712,102,1,260,0)=" the last week. DO NOT rate \u0022voices in my head\u0022 or \u0022visions in my"
^YTT(601.712,102,1,261,0)=" mind\u0022 unless the patient can differentiate between these experiences and"
^YTT(601.712,102,1,262,0)=" his or her thoughts."", "
^YTT(601.712,102,1,263,0)="    ""intro"": ""In the past week:"", "
^YTT(601.712,102,1,264,0)="    ""columns"": 1, "
^YTT(601.712,102,1,265,0)="    ""choices"":["
^YTT(601.712,102,1,266,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,267,0)="     {""id"": ""c3724"", ""text"": ""2. Very mild - Suspected hallucinations only."", ""quickKey"": 2}, "
^YTT(601.712,102,1,268,0)="     {""id"": ""c3725"", ""text"": ""3. Mild - Definite hallucinations, but insignificant, infrequent, or transient"
^YTT(601.712,102,1,269,0)=" (e.g., occasional formless visual hallucinations, a voice calling the patient's"
^YTT(601.712,102,1,270,0)=" name)."", ""quickKey"": 3}, "
^YTT(601.712,102,1,271,0)="     {""id"": ""c3726"", ""text"": ""4. Moderate - As above, but more frequent or extensive (e.g., frequently sees the"
^YTT(601.712,102,1,272,0)=" devil's face, two voices carry on a lengthy conversation)."", ""quickKey"": 4}, "
^YTT(601.712,102,1,273,0)="     {""id"": ""c3727"", ""text"": ""5. Moderately severe - Hallucinations are experienced nearly every day, or are a"
^YTT(601.712,102,1,274,0)=" source of extreme distress."", ""quickKey"": 5}, "
^YTT(601.712,102,1,275,0)="     {""id"": ""c3728"", ""text"": ""6. Severe - As above and has had a moderate impact on the patient's behavior"
^YTT(601.712,102,1,276,0)=" (e.g., concentration difficulties leading to impaired work functioning)."", ""quickKey"": 6}, "
^YTT(601.712,102,1,277,0)="     {""id"": ""c3729"", ""text"": ""7. Very severe - As above, and has had a severe impact (e.g., attempts suicide in"
^YTT(601.712,102,1,278,0)=" response to command hallucinations)."", ""quickKey"": 7}"
^YTT(601.712,102,1,279,0)="   ]}, "
^YTT(601.712,102,1,280,0)="   {""id"": ""i2361"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,281,0)="    ""text"": ""In the past 3 days:"""
^YTT(601.712,102,1,282,0)="    }, "
^YTT(601.712,102,1,283,0)="   {""id"": ""q7843"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,284,0)="    ""text"": ""13. Motor Retardation - Reduction in energy level evidenced in slowed movements."
^YTT(601.712,102,1,285,0)=" Rate on the basis of observed behavior of the patient only. Do not rate on the"
^YTT(601.712,102,1,286,0)=" basis of the patient's subjective impression of his or her own energy level."", "
^YTT(601.712,102,1,287,0)="    ""intro"": ""In the past 3 days:"", "
^YTT(601.712,102,1,288,0)="    ""columns"": 1, "
^YTT(601.712,102,1,289,0)="    ""choices"":["
^YTT(601.712,102,1,290,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,291,0)="     {""id"": ""c3730"", ""text"": ""2. Very mild - Of doubtful clinical significance."", ""quickKey"": 2}, "
^YTT(601.712,102,1,292,0)="     {""id"": ""c3731"", ""text"": ""3. Mild - Conversation is somewhat retarded, movements somewhat slowed."", ""quickKey"": 3}, "
^YTT(601.712,102,1,293,0)="     {""id"": ""c3732"", ""text"": ""4. Moderate - Conversation is notably retarded but not strained."", ""quickKey"": 4}, "
^YTT(601.712,102,1,294,0)="     {""id"": ""c3733"", ""text"": ""5. Moderately severe - Conversation is strained, moves very slowly."", ""quickKey"": 5}, "
^YTT(601.712,102,1,295,0)="     {""id"": ""c3734"", ""text"": ""6. Severe - Conversation is difficult to maintain, hardly moves at all."", ""quickKey"": 6}, "
^YTT(601.712,102,1,296,0)="     {""id"": ""c3735"", ""text"": ""7. Very severe - Conversation is almost impossible, does not move at all"
^YTT(601.712,102,1,297,0)=" throughout the interview."", ""quickKey"": 7}"
^YTT(601.712,102,1,298,0)="   ]}, "
^YTT(601.712,102,1,299,0)="   {""id"": ""i2365"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,300,0)="    ""text"": ""In the last 3 days:"""
^YTT(601.712,102,1,301,0)="    }, "
^YTT(601.712,102,1,302,0)="   {""id"": ""q7844"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,303,0)="    ""text"": ""14. Uncooperativeness - Evidence of resistance, unfriendliness, resentment, and"
^YTT(601.712,102,1,304,0)=" lack of readiness to cooperate with the interviewer. Rate solely on the basis of"
^YTT(601.712,102,1,305,0)=" the patient's attitude and responses to the interviewer and the interview"
^YTT(601.712,102,1,306,0)=" situation. Do not rate on the basis of reported resentment or uncooperativeness"
^YTT(601.712,102,1,307,0)=" outside the interview situation."", "
^YTT(601.712,102,1,308,0)="    ""intro"": ""In the last 3 days:"", "
^YTT(601.712,102,1,309,0)="    ""columns"": 1, "
^YTT(601.712,102,1,310,0)="    ""choices"":["
^YTT(601.712,102,1,311,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,312,0)="     {""id"": ""c3736"", ""text"": ""2. Very mild - Does not seem motivated."", ""quickKey"": 2}, "
^YTT(601.712,102,1,313,0)="     {""id"": ""c3737"", ""text"": ""3. Mild - Seems evasive in certain areas."", ""quickKey"": 3}, "
^YTT(601.712,102,1,314,0)="     {""id"": ""c3738"", ""text"": ""4. Moderate - As above, but evasive in many areas."", ""quickKey"": 4}, "
^YTT(601.712,102,1,315,0)="     {""id"": ""c3739"", ""text"": ""5. Moderately severe - Expresses resentment and is unfriendly throughout the"
^YTT(601.712,102,1,316,0)=" interview."", ""quickKey"": 5}, "
^YTT(601.712,102,1,317,0)="     {""id"": ""c3740"", ""text"": ""6. Severe - Refuses to answer a number of questions."", ""quickKey"": 6}, "
^YTT(601.712,102,1,318,0)="     {""id"": ""c3741"", ""text"": ""7. Very severe - Refuses to answer most questions."", ""quickKey"": 7}"
^YTT(601.712,102,1,319,0)="   ]}, "
^YTT(601.712,102,1,320,0)="   {""id"": ""i2360"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,321,0)="    ""text"": ""In the past week:"""
^YTT(601.712,102,1,322,0)="    }, "
^YTT(601.712,102,1,323,0)="   {""id"": ""q7845"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,324,0)="    ""text"": ""15. Unusual Thought Content - Severity of delusions of any type -- consider"
^YTT(601.712,102,1,325,0)=" conviction and effect on actions. Assume full conviction if patient has acted on"
^YTT(601.712,102,1,326,0)=" his or her beliefs."", "
^YTT(601.712,102,1,327,0)="    ""intro"": ""In the past week:"", "
^YTT(601.712,102,1,328,0)="    ""columns"": 1, "
^YTT(601.712,102,1,329,0)="    ""choices"":["
^YTT(601.712,102,1,330,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,331,0)="     {""id"": ""c3742"", ""text"": ""2. Very mild - Delusion(s) suspected or likely."", ""quickKey"": 2}, "
^YTT(601.712,102,1,332,0)="     {""id"": ""c3743"", ""text"": ""3. Mild - At times, patient questions his or her belief(s) (partial delusion)."", ""quickKey"": 3}, "
^YTT(601.712,102,1,333,0)="     {""id"": ""c3744"", ""text"": ""4. Moderate - Full delusional conviction, but delusion(s) has little or no"
^YTT(601.712,102,1,334,0)=" influence on behavior."", ""quickKey"": 4}, "
^YTT(601.712,102,1,335,0)="     {""id"": ""c3745"", ""text"": ""5. Moderately severe - Full delusional conviction, but delusion(s) has only"
^YTT(601.712,102,1,336,0)=" occasional impact on behavior."", ""quickKey"": 5}, "
^YTT(601.712,102,1,337,0)="     {""id"": ""c3746"", ""text"": ""6. Severe - Delusion(s) has significant effect, e.g., neglects responsibilities"
^YTT(601.712,102,1,338,0)=" because of preoccupation with belief that he/she is God."", ""quickKey"": 6}, "
^YTT(601.712,102,1,339,0)="     {""id"": ""c3747"", ""text"": ""7. Very severe - Delusion(s) has major impact, e.g., stops eating because"
^YTT(601.712,102,1,340,0)=" believes food is poisoned."", ""quickKey"": 7}"
^YTT(601.712,102,1,341,0)="   ]}, "
^YTT(601.712,102,1,342,0)="   {""id"": ""i2361"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,343,0)="    ""text"": ""In the past 3 days:"""
^YTT(601.712,102,1,344,0)="    }, "
^YTT(601.712,102,1,345,0)="   {""id"": ""q7846"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,346,0)="    ""text"": ""16. Blunted Affect - Diminished affective responsivity, as characterized by"
^YTT(601.712,102,1,347,0)=" deficits in facial expression, body gesture, and voice pattern. Distinguish from"
^YTT(601.712,102,1,348,0)=" EMOTIONAL WITHDRAWAL, in which the focus is on interpersonal impairment rather"
^YTT(601.712,102,1,349,0)=" than affect. Consider degree and consistency of impairment."", "
^YTT(601.712,102,1,350,0)="    ""intro"": ""In the past 3 days:"", "
^YTT(601.712,102,1,351,0)="    ""columns"": 1, "
^YTT(601.712,102,1,352,0)="    ""choices"":["
^YTT(601.712,102,1,353,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,354,0)="     {""id"": ""c3748"", ""text"": ""2. Very mild - Occasionally seems indifferent to material that is usually"
^YTT(601.712,102,1,355,0)=" accompanied by some show of emotion."", ""quickKey"": 2}, "
^YTT(601.712,102,1,356,0)="     {""id"": ""c3749"", ""text"": ""3. Mild - Somewhat diminished facial expression or somewhat monotonous voice or"
^YTT(601.712,102,1,357,0)=" somewhat restricted gestures."", ""quickKey"": 3}, "
^YTT(601.712,102,1,358,0)="     {""id"": ""c3750"", ""text"": ""4. Moderate - As above, but more intense, prolonged, or frequent."", ""quickKey"": 4}, "
^YTT(601.712,102,1,359,0)="     {""id"": ""c3751"", ""text"": ""5. Moderately severe - Flattening of affect, including at least two of the three"
^YTT(601.712,102,1,360,0)=" features: Severe lack of facial expression, monotonous voice, or restricted body"
^YTT(601.712,102,1,361,0)=" gestures."", ""quickKey"": 5}, "
^YTT(601.712,102,1,362,0)="     {""id"": ""c3752"", ""text"": ""6. Severe - Profound flattening affect."", ""quickKey"": 6}, "
^YTT(601.712,102,1,363,0)="     {""id"": ""c3753"", ""text"": ""7. Very severe - Totally monotonous voice and total lack of expressive gestures"
^YTT(601.712,102,1,364,0)=" throughout the evaluation."", ""quickKey"": 7}"
^YTT(601.712,102,1,365,0)="   ]}, "
^YTT(601.712,102,1,366,0)="   {""id"": ""i2365"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,367,0)="    ""text"": ""In the last 3 days:"""
^YTT(601.712,102,1,368,0)="    }, "
^YTT(601.712,102,1,369,0)="   {""id"": ""q7847"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,370,0)="    ""text"": ""17. Excitement - Heightened emotional tone, including irritability and"
^YTT(601.712,102,1,371,0)=" expansiveness (hypomanic affect). Do not infer affect from statements of"
^YTT(601.712,102,1,372,0)=" grandiose delusions."", "
^YTT(601.712,102,1,373,0)="    ""intro"": ""In the last 3 days:"", "
^YTT(601.712,102,1,374,0)="    ""columns"": 1, "
^YTT(601.712,102,1,375,0)="    ""choices"":["
^YTT(601.712,102,1,376,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,377,0)="     {""id"": ""c3754"", ""text"": ""2. Very Mild - Of doubtful clinical significance."", ""quickKey"": 2}, "
^YTT(601.712,102,1,378,0)="     {""id"": ""c3755"", ""text"": ""3. Mild - Irritable or expansive at times."", ""quickKey"": 3}, "
^YTT(601.712,102,1,379,0)="     {""id"": ""c3756"", ""text"": ""4. Moderate - Frequently irritable or expansive."", ""quickKey"": 4}, "
^YTT(601.712,102,1,380,0)="     {""id"": ""c3757"", ""text"": ""5. Moderately Severe - Constantly irritable or expansive; or, at times, enraged"
^YTT(601.712,102,1,381,0)=" or euphoric."", ""quickKey"": 5}, "
^YTT(601.712,102,1,382,0)="     {""id"": ""c3758"", ""text"": ""6. Severe - Enraged or euphoric throughout most of the interview."", ""quickKey"": 6}, "
^YTT(601.712,102,1,383,0)="     {""id"": ""c3759"", ""text"": ""7. Very Severe - As above, but to such a degree that the interview must be"
^YTT(601.712,102,1,384,0)=" terminated prematurely."", ""quickKey"": 7}"
^YTT(601.712,102,1,385,0)="   ]}, "
^YTT(601.712,102,1,386,0)="   {""id"": ""i2361"", ""type"": ""IntroText"", "
^YTT(601.712,102,1,387,0)="    ""text"": ""In the past 3 days:"""
^YTT(601.712,102,1,388,0)="    }, "
^YTT(601.712,102,1,389,0)="   {""id"": ""q7848"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,102,1,390,0)="    ""text"": ""18. Disorientation - Confusion or lack of proper association for person, place or"
^YTT(601.712,102,1,391,0)=" time."", "
^YTT(601.712,102,1,392,0)="    ""intro"": ""In the past 3 days:"", "
^YTT(601.712,102,1,393,0)="    ""columns"": 1, "
^YTT(601.712,102,1,394,0)="    ""choices"":["
^YTT(601.712,102,1,395,0)="     {""id"": ""c106380"", ""text"": ""1. Not Reported"", ""quickKey"": 1}, "
^YTT(601.712,102,1,396,0)="     {""id"": ""c3760"", ""text"": ""2. Very mild - Seems somewhat confused."", ""quickKey"": 2}, "
^YTT(601.712,102,1,397,0)="     {""id"": ""c3761"", ""text"": ""3. Mild - e.g., Indicated 2013 when, in fact, it is 2014."", ""quickKey"": 3}, "
^YTT(601.712,102,1,398,0)="     {""id"": ""c3762"", ""text"": ""4. Moderate - e.g., Indicates 1978."", ""quickKey"": 4}, "
^YTT(601.712,102,1,399,0)="     {""id"": ""c3763"", ""text"": ""5. Moderately severe - Is unsure where he/she is."", ""quickKey"": 5}, "
^YTT(601.712,102,1,400,0)="     {""id"": ""c3764"", ""text"": ""6. Severe - Has no idea where he/she is."", ""quickKey"": 6}, "
^YTT(601.712,102,1,401,0)="     {""id"": ""c3765"", ""text"": ""7. Very severe - Does not know who he/she is."", ""quickKey"": 7}"
^YTT(601.712,102,1,402,0)="   ]}]"
^YTT(601.712,102,1,403,0)="}"
