^YTT(601.712,54,1,4,0)=" ""content"":["
^YTT(601.712,54,1,5,0)="   {""id"": ""i541"", ""type"": ""IntroText"", "
^YTT(601.712,54,1,6,0)="    ""text"": ""We are going to use the term \u0022mental illness\u0022 in the rest of this"
^YTT(601.712,54,1,7,0)=" questionnaire, but please think of it as whatever you feel is the best term for"
^YTT(601.712,54,1,8,0)=" it.  """
^YTT(601.712,54,1,9,0)="    }, "
^YTT(601.712,54,1,10,0)="   {""id"": ""q5309"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,54,1,11,0)="    ""text"": ""1. I feel out of place in the world because I have a mental illness."", "
