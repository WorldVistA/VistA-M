^YTT(601.712,16,1,397,0)="   ]}, "
^YTT(601.712,16,1,398,0)="   {""id"": ""q1094"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,399,0)="    ""text"": ""49. I have been having serious thoughts about suicide."", "
