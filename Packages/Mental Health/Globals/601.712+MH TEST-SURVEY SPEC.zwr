^YTT(601.712,110,1,11,0)="   {""id"": ""q7951"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,110,1,12,0)="    ""text"": ""1. How soon after you wake up do you smoke/use your first cigarette/chew?"", "
