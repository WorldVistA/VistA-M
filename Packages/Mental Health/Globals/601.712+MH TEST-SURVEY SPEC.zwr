^YTT(601.712,17,1,872,0)="    ""text"": ""118. There have been times when I couldn't get through the day without some"
^YTT(601.712,17,1,873,0)=" street drugs."", "
^YTT(601.712,17,1,874,0)="    "
^YTT(601.712,17,1,875,0)="    ""choices"":["
