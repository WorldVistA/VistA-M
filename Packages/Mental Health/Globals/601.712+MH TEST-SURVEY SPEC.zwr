^YTT(601.712,16,1,496,0)="    ""text"": ""61. When people are bossy, I usually do the opposite of what they want."", "
^YTT(601.712,16,1,497,0)="    ""intro"": ""Please read each item carefully and answer each question as it pertains to you."", "
^YTT(601.712,16,1,498,0)="    ""columns"": 1, "
