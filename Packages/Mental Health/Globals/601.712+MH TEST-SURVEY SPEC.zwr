^YTT(601.712,84,1,83,0)="     {""id"": ""c792"", ""text"": ""1. Occasionally (1 day in 1 week)"", ""quickKey"": 1}, "
^YTT(601.712,84,1,84,0)="     {""id"": ""c793"", ""text"": ""2. Sometimes (2 to 3 days in a week)"", ""quickKey"": 2}, "
^YTT(601.712,84,1,85,0)="     {""id"": ""c795"", ""text"": ""3. Often (4 to 5 days in 1 week)"", ""quickKey"": 3}, "
^YTT(601.712,84,1,86,0)="     {""id"": ""c797"", ""text"": ""4. Very often (6 to 7 days in a week)"", ""quickKey"": 4}"
^YTT(601.712,84,1,87,0)="   ]}, "
^YTT(601.712,84,1,88,0)="   {""id"": ""q6671"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,84,1,89,0)="    ""text"": ""8. When you had RLS symptoms, how severe were they on average?"", "
