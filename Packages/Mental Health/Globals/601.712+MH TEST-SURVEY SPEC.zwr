^YTT(601.712,126,1,13,0)="    ""columns"": 1, "
^YTT(601.712,126,1,14,0)="    ""choices"":["
^YTT(601.712,126,1,15,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,16,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,17,0)="   ]}, "
^YTT(601.712,126,1,18,0)="   {""id"": ""q8461"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,19,0)="    ""text"": ""2. Did a parent or other adult in the household often or very often....Push,"
^YTT(601.712,126,1,20,0)=" grab, slap, or throw something at you? or Ever hit you <br />   so hard that you"
^YTT(601.712,126,1,21,0)=" had marks or were injured?"", "
^YTT(601.712,126,1,22,0)="    ""columns"": 1, "
^YTT(601.712,126,1,23,0)="    ""choices"":["
^YTT(601.712,126,1,24,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,25,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,26,0)="   ]}, "
^YTT(601.712,126,1,27,0)="   {""id"": ""q8462"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,28,0)="    ""text"": ""3.  Did an adult person at least 5 years older than you ever...Touch or fondle"
^YTT(601.712,126,1,29,0)=" you or have you touch their body in a sexual way?  <br />    or Attempt or"
^YTT(601.712,126,1,30,0)=" actually have oral, anal, or vaginal intercourse with you?"", "
^YTT(601.712,126,1,31,0)="    ""columns"": 1, "
^YTT(601.712,126,1,32,0)="    ""choices"":["
^YTT(601.712,126,1,33,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,34,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,35,0)="   ]}, "
^YTT(601.712,126,1,36,0)="   {""id"": ""q8463"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,37,0)="    ""text"": ""4. Did you often or very often feel that...No one in your family loved you or"
^YTT(601.712,126,1,38,0)=" thought you were important or special? or Your family <br />    didn't look out"
^YTT(601.712,126,1,39,0)=" for each other, feel close to each other, or support each other?"", "
^YTT(601.712,126,1,40,0)="    ""columns"": 1, "
^YTT(601.712,126,1,41,0)="    ""choices"":["
^YTT(601.712,126,1,42,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,43,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,44,0)="   ]}, "
^YTT(601.712,126,1,45,0)="   {""id"": ""q8464"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,46,0)="    ""text"": ""5. Did you often or very often feel that...You didn't have enough to eat, had to"
^YTT(601.712,126,1,47,0)=" wear dirty clothes, and had no one to protect you? <br />    or Your parents"
^YTT(601.712,126,1,48,0)=" were too drunk or high to take care of you or take you to the doctor if you"
^YTT(601.712,126,1,49,0)=" needed it?"", "
^YTT(601.712,126,1,50,0)="    ""columns"": 1, "
^YTT(601.712,126,1,51,0)="    ""choices"":["
^YTT(601.712,126,1,52,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,53,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,54,0)="   ]}, "
^YTT(601.712,126,1,55,0)="   {""id"": ""q8465"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,56,0)="    ""text"": ""6. Were your parents ever separated or divorced?"", "
^YTT(601.712,126,1,57,0)="    ""columns"": 1, "
^YTT(601.712,126,1,58,0)="    ""choices"":["
^YTT(601.712,126,1,59,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,60,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,61,0)="   ]}, "
^YTT(601.712,126,1,62,0)="   {""id"": ""q8466"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,63,0)="    ""text"": ""7. Was your mother or stepmother: Often or very often pushed, grabbed, slapped,"
^YTT(601.712,126,1,64,0)=" or had something thrown at her?  or Sometimes, <br />    often, or very often"
^YTT(601.712,126,1,65,0)=" kicked, bitten, hit with a fist, or hit with something hard?  or Ever repeatedly"
^YTT(601.712,126,1,66,0)=" hit at least a few minutes or <br />    threatened with a gun or knife?"", "
^YTT(601.712,126,1,67,0)="    ""columns"": 1, "
^YTT(601.712,126,1,68,0)="    ""choices"":["
^YTT(601.712,126,1,69,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,70,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,71,0)="   ]}, "
^YTT(601.712,126,1,72,0)="   {""id"": ""q8467"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,73,0)="    ""text"": ""8. Did you live with anyone who was a problem drinker or alcoholic or who used"
^YTT(601.712,126,1,74,0)=" street drugs?"", "
^YTT(601.712,126,1,75,0)="    ""columns"": 1, "
^YTT(601.712,126,1,76,0)="    ""choices"":["
^YTT(601.712,126,1,77,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,78,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,79,0)="   ]}, "
^YTT(601.712,126,1,80,0)="   {""id"": ""q8468"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,81,0)="    ""text"": ""9.  Was a household member depressed or mentally ill, or did a household member"
^YTT(601.712,126,1,82,0)=" attempt suicide?"", "
^YTT(601.712,126,1,83,0)="    ""columns"": 1, "
^YTT(601.712,126,1,84,0)="    ""choices"":["
^YTT(601.712,126,1,85,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,86,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,87,0)="   ]}, "
^YTT(601.712,126,1,88,0)="   {""id"": ""q8469"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,126,1,89,0)="    ""text"": ""10. Did a household member go to prison? "", "
^YTT(601.712,126,1,90,0)="    ""columns"": 1, "
^YTT(601.712,126,1,91,0)="    ""choices"":["
^YTT(601.712,126,1,92,0)="     {""id"": ""c4959"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,126,1,93,0)="     {""id"": ""c4958"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,126,1,94,0)="   ]}]"
^YTT(601.712,126,1,95,0)="}"
^YTT(601.712,127,0)="260^3220408.13415^3911708962"
^YTT(601.712,127,1,0)="^^150^150^3220408"
^YTT(601.712,127,1,1,0)="{""name"": ""CMQ"", "
^YTT(601.712,127,1,2,0)=" ""copyright"": ""Copyright © [1989] by the American Psychological Association. Reproduced with"
^YTT(601.712,127,1,3,0)=" permission.  The official citation that should be used in referencing this"
^YTT(601.712,127,1,4,0)=" material is [Smith CS, Reilly C, Midkiff K. Evaluation of three circadian rhythm"
^YTT(601.712,127,1,5,0)=" questionnaires with suggestions for an improved measure of morningness. J Appl"
^YTT(601.712,127,1,6,0)=" Psychol. Oct 1989;74(5):728-738]. The use of APA information does not imply"
^YTT(601.712,127,1,7,0)=" endorsement by APA."", "
^YTT(601.712,127,1,8,0)=" ""restartDays"": 2, "
^YTT(601.712,127,1,9,0)=" ""printTitle"": "" Composite Morningness Questionnaire (CMQ)"","
^YTT(601.712,127,1,10,0)=" ""content"":["
^YTT(601.712,127,1,11,0)="   {""id"": ""i2411"", ""type"": ""IntroText"", "
^YTT(601.712,127,1,12,0)="    ""text"": ""Please select the response for each item that best describes you."""
^YTT(601.712,127,1,13,0)="    }, "
^YTT(601.712,127,1,14,0)="   {""id"": ""q8470"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,15,0)="    ""text"": ""1. Considering only your own \u0022feeling best\u0022 rhythm, at what time would"
^YTT(601.712,127,1,16,0)=" you get up if you were entirely free to plan your day?"", "
^YTT(601.712,127,1,17,0)="    ""intro"": ""Please select the response for each item that best describes you."", "
^YTT(601.712,127,1,18,0)="    ""columns"": 1, "
^YTT(601.712,127,1,19,0)="    ""choices"":["
^YTT(601.712,127,1,20,0)="     {""id"": ""c4960"", ""text"": ""1. 5:00-6:30 a.m."", ""quickKey"": 1}, "
^YTT(601.712,127,1,21,0)="     {""id"": ""c4961"", ""text"": ""2. 6:30- 7:45 a.m."", ""quickKey"": 2}, "
^YTT(601.712,127,1,22,0)="     {""id"": ""c4962"", ""text"": ""3. 7:45-9:45 a.m."", ""quickKey"": 3}, "
^YTT(601.712,127,1,23,0)="     {""id"": ""c4963"", ""text"": ""4. 9:45-11:00 a.m."", ""quickKey"": 4}, "
^YTT(601.712,127,1,24,0)="     {""id"": ""c4964"", ""text"": ""5. 11:00 a.m.- 12:00 (noon)"", ""quickKey"": 5}"
^YTT(601.712,127,1,25,0)="   ]}, "
^YTT(601.712,127,1,26,0)="   {""id"": ""q8471"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,27,0)="    ""text"": ""2. Considering your only \u0022feeling best\u0022 rhythm, at what time would you"
^YTT(601.712,127,1,28,0)=" go to bed if you were entirely free to plan your evening?"", "
^YTT(601.712,127,1,29,0)="    ""columns"": 1, "
^YTT(601.712,127,1,30,0)="    ""choices"":["
^YTT(601.712,127,1,31,0)="     {""id"": ""c4965"", ""text"": ""1. 8:00-9:00 p.m."", ""quickKey"": 1}, "
^YTT(601.712,127,1,32,0)="     {""id"": ""c4966"", ""text"": ""2. 9:00-10:15 p.m."", ""quickKey"": 2}, "
^YTT(601.712,127,1,33,0)="     {""id"": ""c4967"", ""text"": ""3. 10:15 p.m.- 12:30 a.m."", ""quickKey"": 3}, "
^YTT(601.712,127,1,34,0)="     {""id"": ""c4968"", ""text"": ""4. 12:30-1:45 a.m."", ""quickKey"": 4}, "
^YTT(601.712,127,1,35,0)="     {""id"": ""c4969"", ""text"": ""5. 1:45- 3:00 a.m."", ""quickKey"": 5}"
^YTT(601.712,127,1,36,0)="   ]}, "
^YTT(601.712,127,1,37,0)="   {""id"": ""q8472"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,38,0)="    ""text"": ""3. Assuming normal circumstance, how easy do you find getting up in the morning? "", "
^YTT(601.712,127,1,39,0)="    ""columns"": 1, "
^YTT(601.712,127,1,40,0)="    ""choices"":["
^YTT(601.712,127,1,41,0)="     {""id"": ""c4970"", ""text"": ""1. Not at all easy"", ""quickKey"": 1}, "
^YTT(601.712,127,1,42,0)="     {""id"": ""c4971"", ""text"": ""2. Slightly easy"", ""quickKey"": 2}, "
^YTT(601.712,127,1,43,0)="     {""id"": ""c4972"", ""text"": ""3. Fairly easy"", ""quickKey"": 3}, "
^YTT(601.712,127,1,44,0)="     {""id"": ""c4973"", ""text"": ""4. Very easy"", ""quickKey"": 4}"
^YTT(601.712,127,1,45,0)="   ]}, "
^YTT(601.712,127,1,46,0)="   {""id"": ""q8473"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,47,0)="    ""text"": ""4. How alert do you feel during the first half hour after having awakened in the"
^YTT(601.712,127,1,48,0)=" morning?"", "
^YTT(601.712,127,1,49,0)="    ""columns"": 1, "
^YTT(601.712,127,1,50,0)="    ""choices"":["
^YTT(601.712,127,1,51,0)="     {""id"": ""c4974"", ""text"": ""1. Not at all alert"", ""quickKey"": 1}, "
^YTT(601.712,127,1,52,0)="     {""id"": ""c4975"", ""text"": ""2. Slightly alert"", ""quickKey"": 2}, "
^YTT(601.712,127,1,53,0)="     {""id"": ""c4976"", ""text"": ""3. Fairly alert"", ""quickKey"": 3}, "
^YTT(601.712,127,1,54,0)="     {""id"": ""c4977"", ""text"": ""4. Very alert"", ""quickKey"": 4}"
^YTT(601.712,127,1,55,0)="   ]}, "
^YTT(601.712,127,1,56,0)="   {""id"": ""q8474"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,57,0)="    ""text"": ""5. During the first half hour after having awakened in the morning, how tired to"
^YTT(601.712,127,1,58,0)=" you feel?"", "
^YTT(601.712,127,1,59,0)="    ""columns"": 1, "
^YTT(601.712,127,1,60,0)="    ""choices"":["
^YTT(601.712,127,1,61,0)="     {""id"": ""c4978"", ""text"": ""1. Very tired"", ""quickKey"": 1}, "
^YTT(601.712,127,1,62,0)="     {""id"": ""c4979"", ""text"": ""2. Fairly tired"", ""quickKey"": 2}, "
^YTT(601.712,127,1,63,0)="     {""id"": ""c4980"", ""text"": ""3. Fairly refreshed"", ""quickKey"": 3}, "
^YTT(601.712,127,1,64,0)="     {""id"": ""c4981"", ""text"": ""4. Very refreshed"", ""quickKey"": 4}"
^YTT(601.712,127,1,65,0)="   ]}, "
^YTT(601.712,127,1,66,0)="   {""id"": ""q8475"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,67,0)="    ""text"": ""6. You have decided to engage in some physical exercise.  A friend suggests that"
^YTT(601.712,127,1,68,0)=" you do this one hour twice a week and the best time for him is 7:00-8:00 a.m. "
^YTT(601.712,127,1,69,0)=" Bearing in mind nothing else but your own \u0022feeling best\u0022 rhythm, how"
^YTT(601.712,127,1,70,0)=" do you think you would perform?"", "
^YTT(601.712,127,1,71,0)="    ""columns"": 1, "
^YTT(601.712,127,1,72,0)="    ""choices"":["
^YTT(601.712,127,1,73,0)="     {""id"": ""c4982"", ""text"": ""1. Would be in good form"", ""quickKey"": 1}, "
^YTT(601.712,127,1,74,0)="     {""id"": ""c4983"", ""text"": ""2. Would be in reasonable form"", ""quickKey"": 2}, "
^YTT(601.712,127,1,75,0)="     {""id"": ""c4984"", ""text"": ""3. Would find it difficult"", ""quickKey"": 3}, "
^YTT(601.712,127,1,76,0)="     {""id"": ""c4985"", ""text"": ""4. Would find it very difficult"", ""quickKey"": 4}"
^YTT(601.712,127,1,77,0)="   ]}, "
^YTT(601.712,127,1,78,0)="   {""id"": ""q8476"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,79,0)="    ""text"": ""7. At what time in the evening do you feel tired and, as a result, in need of"
^YTT(601.712,127,1,80,0)=" sleep?"", "
^YTT(601.712,127,1,81,0)="    ""columns"": 1, "
^YTT(601.712,127,1,82,0)="    ""choices"":["
^YTT(601.712,127,1,83,0)="     {""id"": ""c4986"", ""text"": ""1. 8:00-9:00 p.m."", ""quickKey"": 1}, "
^YTT(601.712,127,1,84,0)="     {""id"": ""c4987"", ""text"": ""2. 9:00-10:15 p.m."", ""quickKey"": 2}, "
^YTT(601.712,127,1,85,0)="     {""id"": ""c4988"", ""text"": ""3. 10:15 p.m.-12:30 a.m."", ""quickKey"": 3}, "
^YTT(601.712,127,1,86,0)="     {""id"": ""c4989"", ""text"": ""4. 12:30-1:45 a.m."", ""quickKey"": 4}, "
^YTT(601.712,127,1,87,0)="     {""id"": ""c4990"", ""text"": ""5. 1:45-3:00 a.m."", ""quickKey"": 5}"
^YTT(601.712,127,1,88,0)="   ]}, "
^YTT(601.712,127,1,89,0)="   {""id"": ""q8477"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,90,0)="    ""text"": ""8. You wish to be at your peak performance for a test which you know is going to"
^YTT(601.712,127,1,91,0)=" be mentally exhausting and lasting for two hours.  You are entirely free to plan"
^YTT(601.712,127,1,92,0)=" your day, and considering only your own \u0022feeling best\u0022 rhythm, which"
^YTT(601.712,127,1,93,0)=" ONE of the four testing times would you choose?"", "
^YTT(601.712,127,1,94,0)="    ""columns"": 1, "
^YTT(601.712,127,1,95,0)="    ""choices"":["
^YTT(601.712,127,1,96,0)="     {""id"": ""c4991"", ""text"": ""1. 8:00-10:00 a.m."", ""quickKey"": 1}, "
^YTT(601.712,127,1,97,0)="     {""id"": ""c4992"", ""text"": ""2. 11:00 a.m.-1:00 p.m."", ""quickKey"": 2}, "
^YTT(601.712,127,1,98,0)="     {""id"": ""c4993"", ""text"": ""3. 3:00-5:00 p.m."", ""quickKey"": 3}, "
^YTT(601.712,127,1,99,0)="     {""id"": ""c4994"", ""text"": ""4. 7:00-9:00 p.m."", ""quickKey"": 4}"
^YTT(601.712,127,1,100,0)="   ]}, "
^YTT(601.712,127,1,101,0)="   {""id"": ""q8478"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,102,0)="    ""text"": ""9. One hears about \u0022morning\u0022 and \u0022evening\u0022 types of people. "
^YTT(601.712,127,1,103,0)=" Which ONE of these types do you consider yourself to be?"", "
^YTT(601.712,127,1,104,0)="    ""columns"": 1, "
^YTT(601.712,127,1,105,0)="    ""choices"":["
^YTT(601.712,127,1,106,0)="     {""id"": ""c4995"", ""text"": ""1. Definitely a morning type"", ""quickKey"": 1}, "
^YTT(601.712,127,1,107,0)="     {""id"": ""c4996"", ""text"": ""2. More a morning than an evening type"", ""quickKey"": 2}, "
^YTT(601.712,127,1,108,0)="     {""id"": ""c4997"", ""text"": ""3. More an evening than a morning type"", ""quickKey"": 3}, "
^YTT(601.712,127,1,109,0)="     {""id"": ""c4998"", ""text"": ""4. Definitely an evening type"", ""quickKey"": 4}"
^YTT(601.712,127,1,110,0)="   ]}, "
^YTT(601.712,127,1,111,0)="   {""id"": ""q8479"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,112,0)="    ""text"": ""10. When would you prefer to rise (provided you have a full day's work - 8 hours)"
^YTT(601.712,127,1,113,0)=" if you were totally free to arrange your time?"", "
^YTT(601.712,127,1,114,0)="    ""columns"": 1, "
^YTT(601.712,127,1,115,0)="    ""choices"":["
^YTT(601.712,127,1,116,0)="     {""id"": ""c4999"", ""text"": ""1. Before 6:30 a.m."", ""quickKey"": 1}, "
^YTT(601.712,127,1,117,0)="     {""id"": ""c5000"", ""text"": ""2. 6:30-7:30 a.m."", ""quickKey"": 2}, "
^YTT(601.712,127,1,118,0)="     {""id"": ""c5001"", ""text"": ""3. 7:30-8:30 a.m."", ""quickKey"": 3}, "
^YTT(601.712,127,1,119,0)="     {""id"": ""c5002"", ""text"": ""4. 8:30 a.m. or later"", ""quickKey"": 4}"
^YTT(601.712,127,1,120,0)="   ]}, "
^YTT(601.712,127,1,121,0)="   {""id"": ""q8480"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,122,0)="    ""text"": ""11. If you always had to rise at 6:00 a.m., what do you think it would be like?"", "
^YTT(601.712,127,1,123,0)="    ""columns"": 1, "
^YTT(601.712,127,1,124,0)="    ""choices"":["
^YTT(601.712,127,1,125,0)="     {""id"": ""c5003"", ""text"": ""1. Very difficult and unpleasant"", ""quickKey"": 1}, "
^YTT(601.712,127,1,126,0)="     {""id"": ""c5004"", ""text"": ""2. Rather difficult and unpleasant"", ""quickKey"": 2}, "
^YTT(601.712,127,1,127,0)="     {""id"": ""c5005"", ""text"": ""3. A little unpleasant but no great problem"", ""quickKey"": 3}, "
^YTT(601.712,127,1,128,0)="     {""id"": ""c5006"", ""text"": ""4. Easy and not unpleasant"", ""quickKey"": 4}"
^YTT(601.712,127,1,129,0)="   ]}, "
^YTT(601.712,127,1,130,0)="   {""id"": ""q8481"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,127,1,131,0)="    ""text"": ""12. How long a time does it usually take before you \u0022recover your"
^YTT(601.712,127,1,132,0)=" senses\u0022 in the morning after rising from a night's sleep?"", "
