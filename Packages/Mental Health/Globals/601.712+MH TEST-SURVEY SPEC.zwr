^YTT(601.712,169,1,156,0)="    ""controlWidth"": 60, ""min"": 0, ""max"": 30}, "
^YTT(601.712,169,1,157,0)="   {""id"": ""q9126"", ""type"": ""IntegerQuestion"", ""required"": false, "
