^YTT(601.712,11,1,166,0)="    "
^YTT(601.712,11,1,167,0)="    ""choices"":["
^YTT(601.712,11,1,168,0)="     {""id"": ""c669"", ""text"": ""0. I have not written a suicide note."", ""quickKey"": 0}, "
