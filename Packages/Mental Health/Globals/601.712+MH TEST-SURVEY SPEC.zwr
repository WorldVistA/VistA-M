^YTT(601.712,190,1,4,0)=" ""printTitle"": ""Montreal Cognitive Assessment Version 8.1"", "
^YTT(601.712,190,1,5,0)=" ""content"":["
^YTT(601.712,190,1,6,0)="   {""id"": ""i2582"", ""type"": ""IntroText"", "
^YTT(601.712,190,1,7,0)="    ""text"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,190,1,8,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,190,1,9,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,190,1,10,0)=" recorded here so that the administration can be saved in VistA."""
^YTT(601.712,190,1,11,0)="    }, "
^YTT(601.712,190,1,12,0)="   {""id"": ""q9407"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,190,1,13,0)="    ""text"": ""1. Alternating Trail Making. Correct Pattern: 1-A- 2- B- 3- C- 4- D- 5- E,"
^YTT(601.712,190,1,14,0)=" without drawing any lines that cross. Any error that is not immediately"
^YTT(601.712,190,1,15,0)=" self-corrected is scored incorrect."", "
^YTT(601.712,190,1,16,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,190,1,17,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,190,1,18,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,190,1,19,0)=" recorded here so that the administration can be saved in VistA."", "
^YTT(601.712,190,1,20,0)="    ""columns"": 1, "
^YTT(601.712,190,1,21,0)="    ""choices"":["
^YTT(601.712,190,1,22,0)="     {""id"": ""c5970"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,190,1,23,0)="     {""id"": ""c5971"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,190,1,24,0)="   ]}, "
^YTT(601.712,190,1,25,0)="   {""id"": ""q9408"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,190,1,26,0)="    ""text"": ""2. Cube-Visuoconstructional Skills. Correct: All must be present:"
^YTT(601.712,190,1,27,0)=" three-dimensional, all lines are drawn, no line is added, lines are relatively"
^YTT(601.712,190,1,28,0)=" parallel and their length is similar."", "
^YTT(601.712,190,1,29,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,190,1,30,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,190,1,31,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,190,1,32,0)=" recorded here so that the administration can be saved in VistA."", "
^YTT(601.712,190,1,33,0)="    ""columns"": 1, "
^YTT(601.712,190,1,34,0)="    ""choices"":["
^YTT(601.712,190,1,35,0)="     {""id"": ""c5970"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,190,1,36,0)="     {""id"": ""c5971"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,190,1,37,0)="   ]}, "
^YTT(601.712,190,1,38,0)="   {""id"": ""i2583"", ""type"": ""IntroText"", "
^YTT(601.712,190,1,39,0)="    ""text"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 11. """
^YTT(601.712,190,1,40,0)="    }, "
^YTT(601.712,190,1,41,0)="   {""id"": ""q9409"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,190,1,42,0)="    ""text"": ""3A. Clock face must be a circle with only minor distortion acceptable (e.g.,"
^YTT(601.712,190,1,43,0)=" slight imperfection on closing the circle)."", "
^YTT(601.712,190,1,44,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 11. "", "
^YTT(601.712,190,1,45,0)="    ""columns"": 1, "
^YTT(601.712,190,1,46,0)="    ""choices"":["
^YTT(601.712,190,1,47,0)="     {""id"": ""c5972"", ""text"": ""1. Correct circle"", ""quickKey"": 1}, "
^YTT(601.712,190,1,48,0)="     {""id"": ""c5973"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,190,1,49,0)="   ]}, "
^YTT(601.712,190,1,50,0)="   {""id"": ""q9410"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,190,1,51,0)="    ""text"": ""3B. All clock numbers must be present with no additional numbers; numbers must be"
^YTT(601.712,190,1,52,0)=" in the correct order and placed in the approximate quadrants on the clock face;"
^YTT(601.712,190,1,53,0)=" Roman numerals are acceptable; numbers can be placed outside the circle contour."", "
^YTT(601.712,190,1,54,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 11. "", "
^YTT(601.712,190,1,55,0)="    ""columns"": 1, "
^YTT(601.712,190,1,56,0)="    ""choices"":["
^YTT(601.712,190,1,57,0)="     {""id"": ""c5974"", ""text"": ""1. Correct clock numbers"", ""quickKey"": 1}, "
^YTT(601.712,190,1,58,0)="     {""id"": ""c5975"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,190,1,59,0)="   ]}, "
^YTT(601.712,190,1,60,0)="   {""id"": ""q9411"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,190,1,61,0)="    ""text"": ""3C. There must be two hands jointly indicating the correct time; the hour hand"
^YTT(601.712,190,1,62,0)=" must be clearly shorter than the minute hand; hands must be centered within the"
^YTT(601.712,190,1,63,0)=" clock face with their junction close to the clock center."", "
^YTT(601.712,190,1,64,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 11. "", "
^YTT(601.712,190,1,65,0)="    ""columns"": 1, "
^YTT(601.712,190,1,66,0)="    ""choices"":["
^YTT(601.712,190,1,67,0)="     {""id"": ""c5976"", ""text"": ""1. Correct clock hands"", ""quickKey"": 1}, "
^YTT(601.712,190,1,68,0)="     {""id"": ""c5977"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,190,1,69,0)="   ]}, "
^YTT(601.712,190,1,70,0)="   {""id"": ""i2584"", ""type"": ""IntroText"", "
^YTT(601.712,190,1,71,0)="    ""text"": ""4. Naming pictured animal. """
^YTT(601.712,190,1,72,0)="    }, "
