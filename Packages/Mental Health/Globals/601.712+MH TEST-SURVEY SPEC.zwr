^YTT(601.712,74,1,314,0)="   {""id"": ""i877"", ""type"": ""IntroText"", "
^YTT(601.712,74,1,315,0)="    ""text"": ""FRIENDS are people (not relatives) you know well and care about who have"
^YTT(601.712,74,1,316,0)=" interests and opinions like yours. FRIENDS have fun together, talk about"
^YTT(601.712,74,1,317,0)=" personal problems, and help each other out. (If you have no FRIENDS, you can"
^YTT(601.712,74,1,318,0)=" still answer these questions.)"""
^YTT(601.712,74,1,319,0)="    }, "
