^YTT(601.712,191,1,59,0)="   ]}, "
^YTT(601.712,191,1,60,0)="   {""id"": ""q9440"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,191,1,61,0)="    ""text"": ""3C. There must be two hands jointly indicating the correct time; the hour hand"
