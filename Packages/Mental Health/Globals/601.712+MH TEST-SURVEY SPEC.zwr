^YTT(601.712,38,1,4,0)=" ""content"":["
^YTT(601.712,38,1,5,0)="   {""id"": ""i597"", ""type"": ""IntroText"", "
^YTT(601.712,38,1,6,0)="    ""text"": ""Self-directed violence is behavior that is self-directed and deliberately results"
^YTT(601.712,38,1,7,0)=" in injury or the potential for injury to oneself. Please note: Behavior that is"
^YTT(601.712,38,1,8,0)=" potentially harmful (e.g. holding a  loaded gun in one's mouth) should be"
^YTT(601.712,38,1,9,0)=" classified as self-directed violence.  """
^YTT(601.712,38,1,10,0)="    }, "
^YTT(601.712,38,1,11,0)="   {""id"": ""q5339"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": true, "
^YTT(601.712,38,1,12,0)="    ""text"": ""1. Is there any indication the Veteran engaged in self-directed violent behavior?"", "
^YTT(601.712,38,1,13,0)="    ""intro"": ""Self-directed violence is behavior that is self-directed and deliberately results"
^YTT(601.712,38,1,14,0)=" in injury or the potential for injury to oneself. Please note: Behavior that is"
^YTT(601.712,38,1,15,0)=" potentially harmful (e.g. holding a  loaded gun in one's mouth) should be"
^YTT(601.712,38,1,16,0)=" classified as self-directed violence.  "", "
^YTT(601.712,38,1,17,0)="    ""columns"": 3, "
^YTT(601.712,38,1,18,0)="    ""choices"":["
^YTT(601.712,38,1,19,0)="     {""id"": ""c237"", ""text"": ""0. No"", ""quickKey"": 0}, "
^YTT(601.712,38,1,20,0)="     {""id"": ""c241"", ""text"": ""1. Yes"", ""quickKey"": 1}"
^YTT(601.712,38,1,21,0)="   ]}, "
^YTT(601.712,38,1,22,0)="   {""id"": ""i598"", ""type"": ""IntroText"", "
^YTT(601.712,38,1,23,0)="    ""text"": ""Suicidal intent: There is past or present evidence (explicit and/or implicit)"
^YTT(601.712,38,1,24,0)=" that the patient wished to die, meant to kill him/herself, and understands the"
^YTT(601.712,38,1,25,0)=" probable consequences of his/her actions  or potential actions. Suicidal intent"
^YTT(601.712,38,1,26,0)=" can be determined retrospectively  """
^YTT(601.712,38,1,27,0)="    }, "
^YTT(601.712,38,1,28,0)="   {""id"": ""q5340"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": true, "
