^YTT(601.712,27,1,25,0)="     {""id"": ""c237"", ""text"": ""1. No"", ""quickKey"": 1}, "
^YTT(601.712,27,1,26,0)="     {""id"": ""c241"", ""text"": ""2. Yes"", ""quickKey"": 2}"
^YTT(601.712,27,1,27,0)="   ]}, "
