^YTT(601.712,85,1,1,0)="{""name"": ""ASSIST-NIDA"", "
^YTT(601.712,85,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,85,1,3,0)=" ""printTitle"": ""Alcohol Smoking and Substance Involvement Screening - NIDA modified version"","
^YTT(601.712,85,1,4,0)=" ""content"":["
^YTT(601.712,85,1,5,0)="   {""id"": ""i2177"", ""type"": ""IntroText"", "
^YTT(601.712,85,1,6,0)="    ""text"": ""Instructions:<br />Following are a few questions that will help us give you"
^YTT(601.712,85,1,7,0)=" better medical care. The questions relate to your experience with alcohol,"
^YTT(601.712,85,1,8,0)=" cigarettes, and other drugs. Some of the substances listed are   prescribed by a"
^YTT(601.712,85,1,9,0)=" doctor (like pain medications). You are only asked to record those you have"
^YTT(601.712,85,1,10,0)=" taken for reasons or in doses other than prescribed. You will also be asked"
^YTT(601.712,85,1,11,0)=" about illicit or illegal drug   use - but only to better diagnose and treat you."
^YTT(601.712,85,1,12,0)=" For each substance, select the appropriate frequency of use. For example, if you"
^YTT(601.712,85,1,13,0)=" have used cocaine monthly in the past year, select Monthly for illegal drugs.<br"
^YTT(601.712,85,1,14,0)=" /><br />In the past year, how often have you used the following?  """
^YTT(601.712,85,1,15,0)="    }, "
^YTT(601.712,85,1,16,0)="   {""id"": ""q6925"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
