^YTT(601.712,16,1,478,0)="   ]}, "
^YTT(601.712,16,1,479,0)="   {""id"": ""q1104"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,480,0)="    ""text"": ""59. In this world you either push or get shoved."", "
