^YTT(601.712,191,1,49,0)="   ]}, "
^YTT(601.712,191,1,50,0)="   {""id"": ""q9439"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,191,1,51,0)="    ""text"": ""3B. All clock numbers must be present with no additional numbers; numbers must be"
^YTT(601.712,191,1,52,0)=" in the correct order and placed in the approximate quadrants on the clock face;"
^YTT(601.712,191,1,53,0)=" Roman numerals are acceptable; numbers can be placed outside the circle contour."", "
^YTT(601.712,191,1,54,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9."", "
^YTT(601.712,191,1,55,0)="    ""columns"": 1, "
