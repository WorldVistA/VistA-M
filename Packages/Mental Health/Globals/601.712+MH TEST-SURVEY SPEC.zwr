^YTT(601.712,95,1,7,0)=" ""content"":["
^YTT(601.712,95,1,8,0)="   {""id"": ""i2349"", ""type"": ""IntroText"", "
^YTT(601.712,95,1,9,0)="    ""text"": ""Please read each item carefully and give your best response. Over the past two"
^YTT(601.712,95,1,10,0)=" weeks, how often have you been bothered by any of the following problems?"""
^YTT(601.712,95,1,11,0)="    }, "
^YTT(601.712,95,1,12,0)="   {""id"": ""q7799"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,95,1,13,0)="    ""text"": ""1. Little interest or pleasure in doing things"", "
^YTT(601.712,95,1,14,0)="    ""intro"": ""Please read each item carefully and give your best response. Over the past two"
^YTT(601.712,95,1,15,0)=" weeks, how often have you been bothered by any of the following problems?"", "
^YTT(601.712,95,1,16,0)="    ""columns"": 1, "
^YTT(601.712,95,1,17,0)="    ""choices"":["
^YTT(601.712,95,1,18,0)="     {""id"": ""c3642"", ""text"": ""0. Not at all"", ""quickKey"": 0}, "
^YTT(601.712,95,1,19,0)="     {""id"": ""c3643"", ""text"": ""1. Several days"", ""quickKey"": 1}, "
^YTT(601.712,95,1,20,0)="     {""id"": ""c3644"", ""text"": ""2. More than half the days"", ""quickKey"": 2}, "
^YTT(601.712,95,1,21,0)="     {""id"": ""c3645"", ""text"": ""3. Nearly every day"", ""quickKey"": 3}"
^YTT(601.712,95,1,22,0)="   ]}, "
^YTT(601.712,95,1,23,0)="   {""id"": ""q7800"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,95,1,24,0)="    ""text"": ""2. Feeling down, depressed, or hopeless"", "
^YTT(601.712,95,1,25,0)="    ""intro"": ""Please read each item carefully and give your best response. Over the past two"
^YTT(601.712,95,1,26,0)=" weeks, how often have you been bothered by any of the following problems?"", "
^YTT(601.712,95,1,27,0)="    ""columns"": 1, "
^YTT(601.712,95,1,28,0)="    ""choices"":["
^YTT(601.712,95,1,29,0)="     {""id"": ""c3642"", ""text"": ""0. Not at all"", ""quickKey"": 0}, "
^YTT(601.712,95,1,30,0)="     {""id"": ""c3643"", ""text"": ""1. Several days"", ""quickKey"": 1}, "
^YTT(601.712,95,1,31,0)="     {""id"": ""c3644"", ""text"": ""2. More than half the days"", ""quickKey"": 2}, "
^YTT(601.712,95,1,32,0)="     {""id"": ""c3645"", ""text"": ""3. Nearly every day"", ""quickKey"": 3}"
^YTT(601.712,95,1,33,0)="   ]}, "
^YTT(601.712,95,1,34,0)="   {""id"": ""q7788"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,95,1,35,0)="    ""text"": ""3. Thoughts that you would be better off dead or of hurting yourself in some way"", "
^YTT(601.712,95,1,36,0)="    ""intro"": ""Please read each item carefully and give your best response. Over the past two"
^YTT(601.712,95,1,37,0)=" weeks, how often have you been bothered by any of the following problems?"", "
^YTT(601.712,95,1,38,0)="    ""columns"": 1, "
^YTT(601.712,95,1,39,0)="    ""choices"":["
^YTT(601.712,95,1,40,0)="     {""id"": ""c3642"", ""text"": ""0. Not at all"", ""quickKey"": 0}, "
^YTT(601.712,95,1,41,0)="     {""id"": ""c3643"", ""text"": ""1. Several days"", ""quickKey"": 1}, "
^YTT(601.712,95,1,42,0)="     {""id"": ""c3644"", ""text"": ""2. More than half the days"", ""quickKey"": 2}, "
^YTT(601.712,95,1,43,0)="     {""id"": ""c3645"", ""text"": ""3. Nearly every day"", ""quickKey"": 3}"
^YTT(601.712,95,1,44,0)="   ]}]"
^YTT(601.712,95,1,45,0)="}"
