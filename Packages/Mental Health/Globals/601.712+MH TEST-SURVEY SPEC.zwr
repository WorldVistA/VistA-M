^YTT(601.712,63,0)="175^3220408.090221^2789528456"
^YTT(601.712,63,1,0)="^^285^285^3220408"
^YTT(601.712,63,1,1,0)="{""name"": ""MOCA"", "
^YTT(601.712,63,1,2,0)=" ""copyright"": ""Copyright (c) Z. Nasreddine MD"", "
^YTT(601.712,63,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,63,1,4,0)=" ""printTitle"": ""Montreal Cognitive Assessment"","
^YTT(601.712,63,1,5,0)=" ""content"":["
^YTT(601.712,63,1,6,0)="   {""id"": ""i1239"", ""type"": ""IntroText"", "
^YTT(601.712,63,1,7,0)="    ""text"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,63,1,8,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,63,1,9,0)=" scoring of this instrument prior to  administration. The subject's scores are"
^YTT(601.712,63,1,10,0)=" recorded here so that the administration can be saved in VistA.<br /> <br />  """
^YTT(601.712,63,1,11,0)="    }, "
^YTT(601.712,63,1,12,0)="   {""id"": ""q5540"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,63,1,13,0)="    ""text"": ""1. Alternating Trail Making.  Correct Pattern: 1-A- 2- B- 3- C- 4- D- 5- E,"
^YTT(601.712,63,1,14,0)=" without drawing any lines that cross. Any error that is not immediately"
^YTT(601.712,63,1,15,0)=" self-corrected is scored incorrect."", "
^YTT(601.712,63,1,16,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,63,1,17,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,63,1,18,0)=" scoring of this instrument prior to  administration. The subject's scores are"
^YTT(601.712,63,1,19,0)=" recorded here so that the administration can be saved in VistA.<br /> <br />  "", "
^YTT(601.712,63,1,20,0)="    ""columns"": 2, "
^YTT(601.712,63,1,21,0)="    ""choices"":["
^YTT(601.712,63,1,22,0)="     {""id"": ""c2504"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,63,1,23,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,63,1,24,0)="   ]}, "
^YTT(601.712,63,1,25,0)="   {""id"": ""q5541"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,63,1,26,0)="    ""text"": ""2. Cube-Visuoconstructional Skills. Correct: All must be present:"
^YTT(601.712,63,1,27,0)=" three-dimensional, all lines are drawn, no line is added, lines are relatively"
^YTT(601.712,63,1,28,0)=" parallel and their length is similar."", "
^YTT(601.712,63,1,29,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,63,1,30,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,63,1,31,0)=" scoring of this instrument prior to  administration. The subject's scores are"
^YTT(601.712,63,1,32,0)=" recorded here so that the administration can be saved in VistA.<br /> <br />  "", "
^YTT(601.712,63,1,33,0)="    ""columns"": 2, "
^YTT(601.712,63,1,34,0)="    ""choices"":["
^YTT(601.712,63,1,35,0)="     {""id"": ""c2504"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,63,1,36,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,63,1,37,0)="   ]}, "
^YTT(601.712,63,1,38,0)="   {""id"": ""i1240"", ""type"": ""IntroText"", "
^YTT(601.712,63,1,39,0)="    ""text"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 11.  """
^YTT(601.712,63,1,40,0)="    }, "
^YTT(601.712,63,1,41,0)="   {""id"": ""q5542"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,63,1,42,0)="    ""text"": ""3A. Clock face must be a circle with only minor distortion acceptable (e.g.,"
^YTT(601.712,63,1,43,0)=" slight imperfection on closing the circle)."", "
