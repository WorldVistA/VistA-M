^YTT(601.712,161,1,780,0)="     {""id"": ""c5555"", ""text"": "" Swelling of feet / swelling of hands""},"
^YTT(601.712,161,1,781,0)="     {""id"": ""c5556"", ""text"": "" Easy bruising / bleeding""},"
