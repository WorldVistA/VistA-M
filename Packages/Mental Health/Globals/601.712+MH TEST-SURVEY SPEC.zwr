^YTT(601.712,192,1,98,0)="    ""text"": ""Read list of words to be recalled. <br /> <br />5. Attention"""
^YTT(601.712,192,1,99,0)="    }, "
^YTT(601.712,192,1,100,0)="   {""id"": ""q9473"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,192,1,101,0)="    ""text"": ""5A. Forward Digit Span."", "
^YTT(601.712,192,1,102,0)="    ""intro"": ""Read list of words to be recalled. <br /> <br />5. Attention"", "
^YTT(601.712,192,1,103,0)="    ""columns"": 1, "
^YTT(601.712,192,1,104,0)="    ""choices"":["
^YTT(601.712,192,1,105,0)="     {""id"": ""c6049"", ""text"": ""1. Correct forward digit span"", ""quickKey"": 1}, "
^YTT(601.712,192,1,106,0)="     {""id"": ""c6050"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,192,1,107,0)="   ]}, "
^YTT(601.712,192,1,108,0)="   {""id"": ""q9474"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,192,1,109,0)="    ""text"": ""5B. Backward Digit Span. Correct response for the backwards trial is 4-2-7."", "
^YTT(601.712,192,1,110,0)="    ""intro"": ""Read list of words to be recalled. <br /> <br />5. Attention"", "
^YTT(601.712,192,1,111,0)="    ""columns"": 1, "
^YTT(601.712,192,1,112,0)="    ""choices"":["
^YTT(601.712,192,1,113,0)="     {""id"": ""c6053"", ""text"": ""1. Correct backward digit span"", ""quickKey"": 1}, "
^YTT(601.712,192,1,114,0)="     {""id"": ""c6054"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,192,1,115,0)="   ]}, "
^YTT(601.712,192,1,116,0)="   {""id"": ""q9475"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,192,1,117,0)="    ""text"": ""5C. Vigilance. Correct when there is zero to one errors (an error is a tap on a"
^YTT(601.712,192,1,118,0)=" wrong letter or a failure to tap on letter A)."", "
^YTT(601.712,192,1,119,0)="    ""intro"": ""Read list of words to be recalled. <br /> <br />5. Attention"", "
^YTT(601.712,192,1,120,0)="    ""columns"": 1, "
^YTT(601.712,192,1,121,0)="    ""choices"":["
^YTT(601.712,192,1,122,0)="     {""id"": ""c6055"", ""text"": ""1. Correct vigilance"", ""quickKey"": 1}, "
^YTT(601.712,192,1,123,0)="     {""id"": ""c6056"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,192,1,124,0)="   ]}, "
^YTT(601.712,192,1,125,0)="   {""id"": ""q9476"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,192,1,126,0)="    ""text"": ""5D. Serial 7 subtraction starting at 60. Continue for five responses."", "
^YTT(601.712,192,1,127,0)="    ""intro"": ""Read list of words to be recalled. <br /> <br />5. Attention"", "
^YTT(601.712,192,1,128,0)="    ""columns"": 1, "
^YTT(601.712,192,1,129,0)="    ""choices"":["
^YTT(601.712,192,1,130,0)="     {""id"": ""c6057"", ""text"": ""0. No correct subtractions"", ""quickKey"": 0}, "
^YTT(601.712,192,1,131,0)="     {""id"": ""c6058"", ""text"": ""1. One correct subtraction"", ""quickKey"": 1}, "
^YTT(601.712,192,1,132,0)="     {""id"": ""c6059"", ""text"": ""2. Two or three correct subtractions"", ""quickKey"": 2}, "
^YTT(601.712,192,1,133,0)="     {""id"": ""c6060"", ""text"": ""3. No errors or four or more correct subtractions"", ""quickKey"": 3}"
^YTT(601.712,192,1,134,0)="   ]}, "
^YTT(601.712,192,1,135,0)="   {""id"": ""i2601"", ""type"": ""IntroText"", "
^YTT(601.712,192,1,136,0)="    ""text"": ""6. Language"""
^YTT(601.712,192,1,137,0)="    }, "
^YTT(601.712,192,1,138,0)="   {""id"": ""q9477"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,192,1,139,0)="    ""text"": ""6A. Sentence repetition. The child walked his dog in the park after midnight."", "
