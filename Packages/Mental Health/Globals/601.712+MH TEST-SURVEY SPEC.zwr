^YTT(601.712,17,1,942,0)="   ]}, "
^YTT(601.712,17,1,943,0)="   {""id"": ""q1513"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,944,0)="    ""text"": ""128. I feel deeply depressed for no reason I can figure out."", "
^YTT(601.712,17,1,945,0)="    "
^YTT(601.712,17,1,946,0)="    ""choices"":["
^YTT(601.712,17,1,947,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
