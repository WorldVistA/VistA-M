^YTT(601.712,5,1,8,0)="   {""id"": ""q83"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,5,1,9,0)="    ""text"": ""1. How often did you have a drink containing alcohol in the past year? Consider a"
^YTT(601.712,5,1,10,0)=" drink to be a 12 ounce can or bottle of regular beer, 8 ounces of malt liquor, a"
^YTT(601.712,5,1,11,0)=" 5 ounce glass of table wine, or a 1.5 ounce shot of liquor (like scotch, gin, or"
^YTT(601.712,5,1,12,0)=" vodka)."", "
^YTT(601.712,5,1,13,0)="    ""intro"": ""Please read each item carefully and select the correct answer for you."", "
