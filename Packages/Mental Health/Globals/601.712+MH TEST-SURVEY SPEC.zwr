^YTT(601.712,191,1,25,0)="   {""id"": ""q9437"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,191,1,26,0)="    ""text"": ""2. Chair-Visuoconstructional Skills. Correct: All must be present:"
^YTT(601.712,191,1,27,0)=" three-dimensional, all lines are drawn, no line is added, lines are relatively"
^YTT(601.712,191,1,28,0)=" parallel and their length is similar."", "
^YTT(601.712,191,1,29,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,191,1,30,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,191,1,31,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,191,1,32,0)=" recorded here so that the administration can be saved in VistA."", "
^YTT(601.712,191,1,33,0)="    ""columns"": 1, "
^YTT(601.712,191,1,34,0)="    ""choices"":["
^YTT(601.712,191,1,35,0)="     {""id"": ""c6003"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,191,1,36,0)="     {""id"": ""c6004"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,191,1,37,0)="   ]}, "
^YTT(601.712,191,1,38,0)="   {""id"": ""i2591"", ""type"": ""IntroText"", "
^YTT(601.712,191,1,39,0)="    ""text"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9."""
^YTT(601.712,191,1,40,0)="    }, "
^YTT(601.712,191,1,41,0)="   {""id"": ""q9438"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,191,1,42,0)="    ""text"": ""3A. Clock face must be a circle with only minor distortion acceptable (e.g.,"
^YTT(601.712,191,1,43,0)=" slight imperfection on closing the circle)."", "
^YTT(601.712,191,1,44,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9."", "
