^YTT(601.712,17,1,949,0)="   ]}, "
^YTT(601.712,17,1,950,0)="   {""id"": ""q1514"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,951,0)="    ""text"": ""129. Years later I still have nightmares about an event that was a real threat to"
^YTT(601.712,17,1,952,0)=" my life."", "
^YTT(601.712,17,1,953,0)="    "
^YTT(601.712,17,1,954,0)="    ""choices"":["
