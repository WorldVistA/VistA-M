^YTT(601.712,195,1,29,0)=" strongly you disagree with each of them. Please respond about how you have felt"
^YTT(601.712,195,1,30,0)=" or what you have experienced over the past week."", "
^YTT(601.712,195,1,31,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,195,1,32,0)="    ""legend"":[""Strongly Disagree"", ""Strongly Agree""]}, "
^YTT(601.712,195,1,33,0)="   {""id"": ""q9530"", ""type"": ""SliderQuestion"", ""required"": true, "
^YTT(601.712,195,1,34,0)="    ""text"": ""2. I have experienced fatigue."", "
