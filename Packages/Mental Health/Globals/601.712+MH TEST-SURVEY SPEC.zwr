^YTT(601.712,11,1,185,0)="   {""id"": ""q447"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,186,0)="    ""text"": ""19. Select the one statement in each group that BEST describes how you have been"
