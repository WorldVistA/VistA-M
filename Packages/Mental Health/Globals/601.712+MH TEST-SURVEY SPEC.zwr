^YTT(601.712,17,1,814,0)="    ""text"": ""110. I was on the front cover of several magazines last year."", "
^YTT(601.712,17,1,815,0)="    "
^YTT(601.712,17,1,816,0)="    ""choices"":["
^YTT(601.712,17,1,817,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,818,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,819,0)="   ]}, "
^YTT(601.712,17,1,820,0)="   {""id"": ""q1496"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,821,0)="    ""text"": ""111. I seem to have lost interest in most things that I used to find pleasurable,"
^YTT(601.712,17,1,822,0)=" such as sex."", "
^YTT(601.712,17,1,823,0)="    "
^YTT(601.712,17,1,824,0)="    ""choices"":["
^YTT(601.712,17,1,825,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,826,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,827,0)="   ]}, "
^YTT(601.712,17,1,828,0)="   {""id"": ""q1497"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,829,0)="    ""text"": ""112. I have been downhearted and sad much of my life since I was quite young."", "
^YTT(601.712,17,1,830,0)="    "
^YTT(601.712,17,1,831,0)="    ""choices"":["
^YTT(601.712,17,1,832,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,833,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,834,0)="   ]}, "
^YTT(601.712,17,1,835,0)="   {""id"": ""q1498"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,836,0)="    ""text"": ""113. I've gotten into trouble with the law a couple of times."", "
^YTT(601.712,17,1,837,0)="    "
^YTT(601.712,17,1,838,0)="    ""choices"":["
^YTT(601.712,17,1,839,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
