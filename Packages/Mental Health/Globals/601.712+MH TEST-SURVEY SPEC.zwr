^YTT(601.712,17,1,521,0)="   ]}, "
^YTT(601.712,17,1,522,0)="   {""id"": ""q1455"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,523,0)="    ""text"": ""70. I often think that I don't deserve the good things that happen to me."", "
^YTT(601.712,17,1,524,0)="    "
^YTT(601.712,17,1,525,0)="    ""choices"":["
^YTT(601.712,17,1,526,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,527,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,528,0)="   ]}, "
^YTT(601.712,17,1,529,0)="   {""id"": ""q1456"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,530,0)="    ""text"": ""71. When I'm alone, I often feel the strong presence of someone nearby who can't"
^YTT(601.712,17,1,531,0)=" be seen."", "
^YTT(601.712,17,1,532,0)="    "
^YTT(601.712,17,1,533,0)="    ""choices"":["
^YTT(601.712,17,1,534,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,535,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,536,0)="   ]}, "
^YTT(601.712,17,1,537,0)="   {""id"": ""q1457"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,538,0)="    ""text"": ""72. I feel pretty aimless and don't know where I'm going in life."", "
^YTT(601.712,17,1,539,0)="    "
^YTT(601.712,17,1,540,0)="    ""choices"":["
^YTT(601.712,17,1,541,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,542,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,543,0)="   ]}, "
