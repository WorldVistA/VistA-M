^YTT(601.712,88,1,1,0)="{""name"": ""KATZ-ADL-6PT"", "
^YTT(601.712,88,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,88,1,3,0)=" ""printTitle"": ""Modified Katz Index of ADLs"","
^YTT(601.712,88,1,4,0)=" ""content"":["
^YTT(601.712,88,1,5,0)="   {""id"": ""i2346"", ""type"": ""IntroText"", "
^YTT(601.712,88,1,6,0)="    ""text"": ""Score activities on level of independence: <br /><br />INDEPENDENCE: NO"
^YTT(601.712,88,1,7,0)=" supervision, direction or personal assistance (1 POINT) <br />DEPENDENCE: WITH"
^YTT(601.712,88,1,8,0)=" supervision, direction, personal assistance or total care (0 POINTS)"""
^YTT(601.712,88,1,9,0)="    }, "
^YTT(601.712,88,1,10,0)="   {""id"": ""q7059"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,88,1,11,0)="    ""text"": ""1. BATHING"", "
^YTT(601.712,88,1,12,0)="    ""intro"": ""Score activities on level of independence: <br /><br />INDEPENDENCE: NO"
^YTT(601.712,88,1,13,0)=" supervision, direction or personal assistance (1 POINT) <br />DEPENDENCE: WITH"
^YTT(601.712,88,1,14,0)=" supervision, direction, personal assistance or total care (0 POINTS)"", "
^YTT(601.712,88,1,15,0)="    ""columns"": 1, "
^YTT(601.712,88,1,16,0)="    ""choices"":["
^YTT(601.712,88,1,17,0)="     {""id"": ""c3358"", ""text"": ""1. Bathes self completely or needs help in bathing only a single part of the body"
^YTT(601.712,88,1,18,0)=" such as the back, genital area or disabled extremity. (1 pt)"", ""quickKey"": 1}, "
^YTT(601.712,88,1,19,0)="     {""id"": ""c3359"", ""text"": ""2. Needs help with bathing more than one part of the body, getting in or out of"
^YTT(601.712,88,1,20,0)=" the tub or shower. Requires total bathing. (0 pt)"", ""quickKey"": 2}"
^YTT(601.712,88,1,21,0)="   ]}, "
^YTT(601.712,88,1,22,0)="   {""id"": ""q7060"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,88,1,23,0)="    ""text"": ""2. DRESSING"", "
^YTT(601.712,88,1,24,0)="    ""columns"": 1, "
^YTT(601.712,88,1,25,0)="    ""choices"":["
^YTT(601.712,88,1,26,0)="     {""id"": ""c3363"", ""text"": ""1. Gets clothes from closets and drawers and puts on clothes and outer garments"
^YTT(601.712,88,1,27,0)=" complete with fasteners. May have help tying shoes. (1 pt)"", ""quickKey"": 1}, "
^YTT(601.712,88,1,28,0)="     {""id"": ""c3362"", ""text"": ""2. Needs help with dressing self or needs to be completely dressed. (0 pt)"", ""quickKey"": 2}"
^YTT(601.712,88,1,29,0)="   ]}, "
^YTT(601.712,88,1,30,0)="   {""id"": ""q7061"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,88,1,31,0)="    ""text"": ""3. TOILETING"", "
^YTT(601.712,88,1,32,0)="    ""columns"": 1, "
^YTT(601.712,88,1,33,0)="    ""choices"":["
^YTT(601.712,88,1,34,0)="     {""id"": ""c3376"", ""text"": ""1. Goes to toilet, gets on and off, arranges clothes, cleans genital area without"
^YTT(601.712,88,1,35,0)=" help. (1 pt)"", ""quickKey"": 1}, "
^YTT(601.712,88,1,36,0)="     {""id"": ""c3377"", ""text"": ""2. Needs help transferring to the toilet, cleaning self or uses bedpan or"
^YTT(601.712,88,1,37,0)=" commode. (0 pt)"", ""quickKey"": 2}"
^YTT(601.712,88,1,38,0)="   ]}, "
^YTT(601.712,88,1,39,0)="   {""id"": ""q7062"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,88,1,40,0)="    ""text"": ""4. TRANSFER"", "
^YTT(601.712,88,1,41,0)="    ""columns"": 1, "
^YTT(601.712,88,1,42,0)="    ""choices"":["
^YTT(601.712,88,1,43,0)="     {""id"": ""c3367"", ""text"": ""1. Moves in and out of bed or chair unassisted. Mechanical transferring aides are"
^YTT(601.712,88,1,44,0)=" acceptable. (1 pt)"", ""quickKey"": 1}, "
^YTT(601.712,88,1,45,0)="     {""id"": ""c3368"", ""text"": ""2. Needs help in moving from bed to chair or requires a complete transfer. (0 pt)"", ""quickKey"": 2}"
^YTT(601.712,88,1,46,0)="   ]}, "
^YTT(601.712,88,1,47,0)="   {""id"": ""q7063"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,88,1,48,0)="    ""text"": ""5. CONTINENCE"", "
^YTT(601.712,88,1,49,0)="    ""columns"": 1, "
^YTT(601.712,88,1,50,0)="    ""choices"":["
^YTT(601.712,88,1,51,0)="     {""id"": ""c3372"", ""text"": ""1. Exercises complete self control over urination and defecation. (1 pt)"", ""quickKey"": 1}, "
^YTT(601.712,88,1,52,0)="     {""id"": ""c3379"", ""text"": ""2. Is partially or totally incontinent of bowel or bladder. (0 pt)"", ""quickKey"": 2}"
^YTT(601.712,88,1,53,0)="   ]}, "
^YTT(601.712,88,1,54,0)="   {""id"": ""q7064"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,88,1,55,0)="    ""text"": ""6. FEEDING"", "
^YTT(601.712,88,1,56,0)="    ""columns"": 1, "
^YTT(601.712,88,1,57,0)="    ""choices"":["
^YTT(601.712,88,1,58,0)="     {""id"": ""c3375"", ""text"": ""1. Gets food from plate into mouth without help. Preparation of food may be done"
^YTT(601.712,88,1,59,0)=" by another person. (1 pt)"", ""quickKey"": 1}, "
^YTT(601.712,88,1,60,0)="     {""id"": ""c3373"", ""text"": ""2. Needs partial or total help with feeding or requires parenteral feeding. (0"
^YTT(601.712,88,1,61,0)=" pt)"", ""quickKey"": 2}"
^YTT(601.712,88,1,62,0)="   ]}]"
^YTT(601.712,88,1,63,0)="}"
