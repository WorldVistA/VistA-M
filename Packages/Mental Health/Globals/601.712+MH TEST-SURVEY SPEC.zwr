^YTT(601.712,108,1,1,0)="{""name"": ""EPDS"", "
^YTT(601.712,108,1,2,0)=" ""copyright"": ""Users may reproduce the scale without further permission providing they respect"
^YTT(601.712,108,1,3,0)=" copyright by quoting the names of the authors, the title and the source of the"
^YTT(601.712,108,1,4,0)=" paper in all reproduced copies."", "
^YTT(601.712,108,1,5,0)=" ""restartDays"": 2, "
^YTT(601.712,108,1,6,0)=" ""printTitle"": ""Edinburgh Postnatal Depression Scale (EPDS)"","
^YTT(601.712,108,1,7,0)=" ""content"":["
^YTT(601.712,108,1,8,0)="   {""id"": ""i2372"", ""type"": ""IntroText"", "
^YTT(601.712,108,1,9,0)="    ""text"": ""As you are pregnant or have recently had a baby, we would like to know how you"
^YTT(601.712,108,1,10,0)=" are feeling. Please check the answer that comes closest to how you have felt IN"
^YTT(601.712,108,1,11,0)=" THE PAST 7 DAYS, not just how you feel today. Here is an example, already"
^YTT(601.712,108,1,12,0)=" completed.<br /> <br /> I have felt happy:  <br /> <br />     Yes, all the time"
^YTT(601.712,108,1,13,0)=" <br />  X  Yes, most of the time (This would mean: \u0022I have felt happy most"
^YTT(601.712,108,1,14,0)=" of the time\u0022 during the past week.) <br />     No, not very often <br />   "
^YTT(601.712,108,1,15,0)="  No, not at all  <br /> <br /> Please complete the other questions in the same"
^YTT(601.712,108,1,16,0)=" way. Please complete the other questions in the same way."""
^YTT(601.712,108,1,17,0)="    }, "
^YTT(601.712,108,1,18,0)="   {""id"": ""q7934"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,108,1,19,0)="    ""text"": ""1. I have been able to laugh and see the funny side of things"", "
^YTT(601.712,108,1,20,0)="    ""intro"": ""As you are pregnant or have recently had a baby, we would like to know how you"
^YTT(601.712,108,1,21,0)=" are feeling. Please check the answer that comes closest to how you have felt IN"
^YTT(601.712,108,1,22,0)=" THE PAST 7 DAYS, not just how you feel today. Here is an example, already"
