^YTT(601.712,169,1,96,0)="   {""id"": ""q9118"", ""type"": ""IntegerQuestion"", ""required"": false, "
^YTT(601.712,169,1,97,0)="    ""text"": ""7A. Marijuana (cannabis, pot, weed)?"", "
