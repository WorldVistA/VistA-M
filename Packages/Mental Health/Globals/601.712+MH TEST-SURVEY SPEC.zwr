^YTT(601.712,101,1,5,0)=" ""content"":["
^YTT(601.712,101,1,6,0)="   {""id"": ""i2357"", ""type"": ""IntroText"", "
^YTT(601.712,101,1,7,0)="    ""text"": ""Sometimes things happen to people that are unusually or especially frightening,"
^YTT(601.712,101,1,8,0)=" horrible, or traumatic. For example:<br />  <br />              A serious"
^YTT(601.712,101,1,9,0)=" accident or fire<br />              A physical or sexual assault or abuse<br /> "
^YTT(601.712,101,1,10,0)="             An earthquake or flood<br />              A war<br />             "
^YTT(601.712,101,1,11,0)=" Seeing someone be killed or seriously injured<br />              Having a loved"
^YTT(601.712,101,1,12,0)=" one die through homicide or suicide"""
^YTT(601.712,101,1,13,0)="    }, "
^YTT(601.712,101,1,14,0)="   {""id"": ""q7822"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,101,1,15,0)="    ""text"": "" Have you ever experienced this kind of event?"", "
^YTT(601.712,101,1,16,0)="    ""intro"": ""Sometimes things happen to people that are unusually or especially frightening,"
