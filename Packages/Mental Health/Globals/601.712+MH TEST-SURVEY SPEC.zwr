^YTT(601.712,101,1,53,0)="     {""id"": ""c3657"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,101,1,54,0)="     {""id"": ""c3658"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,101,1,55,0)="   ]}, "
^YTT(601.712,101,1,56,0)="   {""id"": ""q7826"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,101,1,57,0)="    ""text"": ""4. Felt numb or detached from people, activities, or your surroundings?"", "
^YTT(601.712,101,1,58,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,101,1,59,0)="    ""columns"": 1, "
^YTT(601.712,101,1,60,0)="    ""choices"":["
^YTT(601.712,101,1,61,0)="     {""id"": ""c3657"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,101,1,62,0)="     {""id"": ""c3658"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,101,1,63,0)="   ]}, "
^YTT(601.712,101,1,64,0)="   {""id"": ""q7828"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,101,1,65,0)="    ""text"": ""5.  Felt guilty or unable to stop blaming yourself or others for the event(s) or"
^YTT(601.712,101,1,66,0)=" any  problems the event(s) may have caused?"", "
^YTT(601.712,101,1,67,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,101,1,68,0)="    ""columns"": 1, "
^YTT(601.712,101,1,69,0)="    ""choices"":["
^YTT(601.712,101,1,70,0)="     {""id"": ""c3657"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,101,1,71,0)="     {""id"": ""c3658"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,101,1,72,0)="   ]}, "
^YTT(601.712,101,1,73,0)="   {""id"": ""q7829"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,101,1,74,0)="    ""text"": ""6. Over the last 2 weeks, how often have you been bothered by thoughts that you"
^YTT(601.712,101,1,75,0)=" would be better off dead or of hurting yourself in some way?"", "
^YTT(601.712,101,1,76,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,101,1,77,0)="    ""columns"": 1, "
^YTT(601.712,101,1,78,0)="    ""choices"":["
^YTT(601.712,101,1,79,0)="     {""id"": ""c3659"", ""text"": ""0. Not at All"", ""quickKey"": 0}, "
^YTT(601.712,101,1,80,0)="     {""id"": ""c3661"", ""text"": ""1. Several Days"", ""quickKey"": 1}, "
^YTT(601.712,101,1,81,0)="     {""id"": ""c3662"", ""text"": ""2. More Than Half the Days"", ""quickKey"": 2}, "
^YTT(601.712,101,1,82,0)="     {""id"": ""c3663"", ""text"": ""3. Nearly Every Day"", ""quickKey"": 3}"
^YTT(601.712,101,1,83,0)="   ]}], "
^YTT(601.712,101,1,84,0)=" ""rules"":["
^YTT(601.712,101,1,85,0)="   {""question"": ""q7822"", ""operator"": ""EQ"", ""value"": ""c3658"", "
