^YTT(601.712,161,1,4,0)=" ""content"":["
^YTT(601.712,161,1,5,0)="   {""id"": ""i2499"", ""type"": ""IntroText"","
^YTT(601.712,161,1,6,0)="    ""text"": ""<strong>SYMPTOM SEVERITY</strong> <br /> <br /><i>Please answer the questions below to the best of"
^YTT(601.712,161,1,7,0)=" your knowledge. <br /><strong>[Now]</strong> refers to how you feel now/this week (last 7 days)."
^YTT(601.712,161,1,8,0)=" <br /><strong>[Pre-COVID]</strong> refers to how you were feeling prior to contracting the"
^YTT(601.712,161,1,9,0)=" illness. <br />If you are unable to recall this, just select </i>\u0022Don't know\u0022<i>. <br />"
^YTT(601.712,161,1,10,0)=" <br />Rate the severity of each problem on a scale of 0-3:</i>"
^YTT(601.712,161,1,11,0)=" <br /> <hr />1. Breathlessness"""
^YTT(601.712,161,1,12,0)="    },"
