^YTT(601.712,193,1,36,0)="   ]}, "
^YTT(601.712,193,1,37,0)="   {""id"": ""q9496"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,193,1,38,0)="    ""text"": ""1C. Vigilance. Correct when there is zero to one errors (an error is a tap on a"
^YTT(601.712,193,1,39,0)=" wrong letter or a failure to tap on letter A)."", "
