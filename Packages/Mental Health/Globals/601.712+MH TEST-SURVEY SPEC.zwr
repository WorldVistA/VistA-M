^YTT(601.712,187,1,1,0)="{""name"": ""SIP-AD-30_V2"", "
^YTT(601.712,187,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,187,1,3,0)=" ""printTitle"": ""SHORT INVENTORY OF PROBLEMS - AD - Version 2 (SIP-AD-30_V2)"", "
^YTT(601.712,187,1,4,0)=" ""content"":["
^YTT(601.712,187,1,5,0)="   {""id"": ""i2564"", ""type"": ""IntroText"", "
^YTT(601.712,187,1,6,0)="    ""text"": ""Here are a number of events that people sometimes experience in relation to their"
^YTT(601.712,187,1,7,0)=" use of alcohol and other drugs. Read each one carefully and indicate how often"
^YTT(601.712,187,1,8,0)=" each one has happened to you DURING THE PAST 30 DAYS by selecting the"
^YTT(601.712,187,1,9,0)=" appropriate an swer (Never, Once or a few times, etc.). If an item does not"
^YTT(601.712,187,1,10,0)=" apply to you, mark Never."""
^YTT(601.712,187,1,11,0)="    }, "
^YTT(601.712,187,1,12,0)="   {""id"": ""q9350"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,187,1,13,0)="    ""text"": ""1. I have been unhappy because of my drinking or drug use."", "
^YTT(601.712,187,1,14,0)="    ""intro"": ""Here are a number of events that people sometimes experience in relation to their"
