^YTT(601.712,62,1,95,0)="   ]}, "
^YTT(601.712,62,1,96,0)="   {""id"": ""q5539"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,62,1,97,0)="    ""text"": "" Recall of THIRD WORD"", "
^YTT(601.712,62,1,98,0)="    ""intro"": ""<strong>Step 3: Three Word Recall</strong><br /><br />Ask the person to recall the three words you"
^YTT(601.712,62,1,99,0)=" stated in Step 1. Say: \u0022What were the three words I asked you to"
^YTT(601.712,62,1,100,0)=" remember?\u0022 <br /><br /><small>[A correct response is spontaneously recalled"
^YTT(601.712,62,1,101,0)=" without cueing.]</small>"", "
