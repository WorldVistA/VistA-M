^YTT(601.712,52,1,122,0)="    ""legend"":[""Extremely low mood"", "" Extremely high mood""]}, "
^YTT(601.712,52,1,123,0)="   {""id"": ""q5209"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,52,1,124,0)="    ""text"": ""A7. On the average, how severe has your pain been during the LAST WEEK?"", "
^YTT(601.712,52,1,125,0)="    ""intro"": ""In the following 20 questions, you will be asked to describe your pain and how it"
