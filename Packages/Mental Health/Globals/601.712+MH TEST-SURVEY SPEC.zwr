^YTT(601.712,4,1,1,0)="{""name"": ""ATQ"", "
^YTT(601.712,4,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,4,1,3,0)=" ""printTitle"": ""Automatic Thoughts Questionnaire"","
^YTT(601.712,4,1,4,0)=" ""content"":["
^YTT(601.712,4,1,5,0)="   {""id"": ""i3"", ""type"": ""IntroText"", "
^YTT(601.712,4,1,6,0)="    ""text"": ""Listed below are a variety of thoughts that pop into people's heads. Please read"
^YTT(601.712,4,1,7,0)=" each thought and indicate how frequently, if at all, the thought occurred to you"
^YTT(601.712,4,1,8,0)=" over the last week.  Please read each item carefully and indicate the"
^YTT(601.712,4,1,9,0)=" appropriate number."""
^YTT(601.712,4,1,10,0)="    }, "
^YTT(601.712,4,1,11,0)="   {""id"": ""q53"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,4,1,12,0)="    ""text"": ""1. I feel like I'm up against the world."", "
^YTT(601.712,4,1,13,0)="    ""intro"": ""Listed below are a variety of thoughts that pop into people's heads. Please read"
^YTT(601.712,4,1,14,0)=" each thought and indicate how frequently, if at all, the thought occurred to you"
^YTT(601.712,4,1,15,0)=" over the last week.  Please read each item carefully and indicate the"
^YTT(601.712,4,1,16,0)=" appropriate number."", "
^YTT(601.712,4,1,17,0)="    "
^YTT(601.712,4,1,18,0)="    ""choices"":["
^YTT(601.712,4,1,19,0)="     {""id"": ""c212"", ""text"": ""1. Not at all"", ""quickKey"": 1}, "
^YTT(601.712,4,1,20,0)="     {""id"": ""c213"", ""text"": ""2. Sometimes"", ""quickKey"": 2}, "
^YTT(601.712,4,1,21,0)="     {""id"": ""c214"", ""text"": ""3. Moderately often"", ""quickKey"": 3}, "
^YTT(601.712,4,1,22,0)="     {""id"": ""c215"", ""text"": ""4. Often"", ""quickKey"": 4}, "
^YTT(601.712,4,1,23,0)="     {""id"": ""c216"", ""text"": ""5. All the time"", ""quickKey"": 5}"
^YTT(601.712,4,1,24,0)="   ]}, "
^YTT(601.712,4,1,25,0)="   {""id"": ""q54"", ""type"": ""ChoiceQuestion"", ""required"": false, "
