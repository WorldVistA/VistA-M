^YTT(601.712,38,1,326,0)="     {""id"": ""c2728"", ""text"": "" None necessary due to fatality""}, "
^YTT(601.712,38,1,327,0)="     {""id"": ""c2574"", ""text"": "" Limit the means""}, "
