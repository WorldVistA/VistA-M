^YTT(601.712,16,1,413,0)="   ]}, "
^YTT(601.712,16,1,414,0)="   {""id"": ""q1096"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,415,0)="    ""text"": ""51. There's little emotional support within my family."", "
