^YTT(601.712,125,1,4,0)=" ""printTitle"": ""Eating Attitudes Test-26 Item (EAT-26)"", "
^YTT(601.712,125,1,5,0)=" ""content"":["
^YTT(601.712,125,1,6,0)="   {""id"": ""i2406"", ""type"": ""IntroText"", "
^YTT(601.712,125,1,7,0)="    ""text"": ""This is a screening measure to help you determine whether you might have an"
^YTT(601.712,125,1,8,0)=" eating disorder that needs professional attention. This screening measure is not"
^YTT(601.712,125,1,9,0)=" designed to make a diagnosis of an eating disorder or take the place of a"
^YTT(601.712,125,1,10,0)=" professional consultation.<br /><br />Please complete the questions below as"
^YTT(601.712,125,1,11,0)=" accurately, honestly and completely as possible.  There are no right or wrong"
^YTT(601.712,125,1,12,0)=" answers. <br /><br />Part A: Complete the following questions:<br /><br"
^YTT(601.712,125,1,13,0)=" /><strong>Height:</strong>"""
^YTT(601.712,125,1,14,0)="    }, "
^YTT(601.712,125,1,15,0)="   {""id"": ""q8453"", ""type"": ""IntegerQuestion"", ""required"": true, ""inline"": true, "
^YTT(601.712,125,1,16,0)="    ""text"": "" Feet:"", "
^YTT(601.712,125,1,17,0)="    ""intro"": ""This is a screening measure to help you determine whether you might have an"
^YTT(601.712,125,1,18,0)=" eating disorder that needs professional attention. This screening measure is not"
^YTT(601.712,125,1,19,0)=" designed to make a diagnosis of an eating disorder or take the place of a"
^YTT(601.712,125,1,20,0)=" professional consultation.<br /><br />Please complete the questions below as"
^YTT(601.712,125,1,21,0)=" accurately, honestly and completely as possible.  There are no right or wrong"
^YTT(601.712,125,1,22,0)=" answers. <br /><br />Part A: Complete the following questions:<br /><br"
^YTT(601.712,125,1,23,0)=" /><strong>Height:</strong>"", "
^YTT(601.712,125,1,24,0)="    ""controlWidth"": 50, ""min"": 0, ""max"": 7}, "
