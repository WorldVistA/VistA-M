^YTT(601.712,115,1,1378,0)="   ]}, "
^YTT(601.712,115,1,1379,0)="   {""id"": ""q8203"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1380,0)="    ""text"": ""189. People would have to be exceptional themselves to understand my abilities."", "
^YTT(601.712,115,1,1381,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1382,0)="    ""choices"":["
^YTT(601.712,115,1,1383,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1384,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1385,0)="   ]}, "
^YTT(601.712,115,1,1386,0)="   {""id"": ""q8204"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1387,0)="    ""text"": ""190. I really don't understand human feelings like other people do."", "
^YTT(601.712,115,1,1388,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1389,0)="    ""choices"":["
