^YTT(601.712,100,1,7,0)=" ""content"":["
^YTT(601.712,100,1,8,0)="   {""id"": ""i2356"", ""type"": ""IntroText"", "
^YTT(601.712,100,1,9,0)="    ""text"": ""This questionnaire asks about difficulties due to health conditions. Health"
^YTT(601.712,100,1,10,0)=" conditions include diseases or illnesses, other health problems that may be"
^YTT(601.712,100,1,11,0)=" short or long lasting, injuries, mental or emotional problems, and problems with"
^YTT(601.712,100,1,12,0)=" alcohol or drugs.<br />  <br /> Think back over the past 30 days and answer"
^YTT(601.712,100,1,13,0)=" these questions, thinking  about how much difficulty you had doing the following"
^YTT(601.712,100,1,14,0)=" activities. In the past 30 days, how much DIFFICULTY did you have in:"""
^YTT(601.712,100,1,15,0)="    }, "
^YTT(601.712,100,1,16,0)="   {""id"": ""q7810"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,100,1,17,0)="    ""text"": ""S1. Standing for long periods such as 30 minutes?"", "
^YTT(601.712,100,1,18,0)="    ""intro"": ""This questionnaire asks about difficulties due to health conditions. Health"
^YTT(601.712,100,1,19,0)=" conditions include diseases or illnesses, other health problems that may be"
^YTT(601.712,100,1,20,0)=" short or long lasting, injuries, mental or emotional problems, and problems with"
^YTT(601.712,100,1,21,0)=" alcohol or drugs.<br />  <br /> Think back over the past 30 days and answer"
^YTT(601.712,100,1,22,0)=" these questions, thinking  about how much difficulty you had doing the following"
^YTT(601.712,100,1,23,0)=" activities. In the past 30 days, how much DIFFICULTY did you have in:"", "
^YTT(601.712,100,1,24,0)="    ""columns"": 2, "
^YTT(601.712,100,1,25,0)="    ""choices"":["
^YTT(601.712,100,1,26,0)="     {""id"": ""c3652"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,100,1,27,0)="     {""id"": ""c3653"", ""text"": ""1. Mild"", ""quickKey"": 1}, "
^YTT(601.712,100,1,28,0)="     {""id"": ""c3654"", ""text"": ""2. Moderate"", ""quickKey"": 2}, "
^YTT(601.712,100,1,29,0)="     {""id"": ""c3655"", ""text"": ""3. Severe"", ""quickKey"": 3}, "
^YTT(601.712,100,1,30,0)="     {""id"": ""c3656"", ""text"": ""4. Extreme or cannot do"", ""quickKey"": 4}"
^YTT(601.712,100,1,31,0)="   ]}, "
^YTT(601.712,100,1,32,0)="   {""id"": ""q7811"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,100,1,33,0)="    ""text"": ""S2. Taking care of your household responsibilities?"", "
^YTT(601.712,100,1,34,0)="    ""intro"": ""This questionnaire asks about difficulties due to health conditions. Health"
^YTT(601.712,100,1,35,0)=" conditions include diseases or illnesses, other health problems that may be"
^YTT(601.712,100,1,36,0)=" short or long lasting, injuries, mental or emotional problems, and problems with"
^YTT(601.712,100,1,37,0)=" alcohol or drugs.<br />  <br /> Think back over the past 30 days and answer"
^YTT(601.712,100,1,38,0)=" these questions, thinking  about how much difficulty you had doing the following"
^YTT(601.712,100,1,39,0)=" activities. In the past 30 days, how much DIFFICULTY did you have in:"", "
^YTT(601.712,100,1,40,0)="    ""columns"": 2, "
^YTT(601.712,100,1,41,0)="    ""choices"":["
^YTT(601.712,100,1,42,0)="     {""id"": ""c3652"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,100,1,43,0)="     {""id"": ""c3653"", ""text"": ""1. Mild"", ""quickKey"": 1}, "
^YTT(601.712,100,1,44,0)="     {""id"": ""c3654"", ""text"": ""2. Moderate"", ""quickKey"": 2}, "
^YTT(601.712,100,1,45,0)="     {""id"": ""c3655"", ""text"": ""3. Severe"", ""quickKey"": 3}, "
^YTT(601.712,100,1,46,0)="     {""id"": ""c3656"", ""text"": ""4. Extreme or cannot do"", ""quickKey"": 4}"
^YTT(601.712,100,1,47,0)="   ]}, "
^YTT(601.712,100,1,48,0)="   {""id"": ""q7812"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,100,1,49,0)="    ""text"": ""S3. Learning a new task, for example, learning how to get to a new place?"", "
^YTT(601.712,100,1,50,0)="    ""intro"": ""This questionnaire asks about difficulties due to health conditions. Health"
^YTT(601.712,100,1,51,0)=" conditions include diseases or illnesses, other health problems that may be"
^YTT(601.712,100,1,52,0)=" short or long lasting, injuries, mental or emotional problems, and problems with"
^YTT(601.712,100,1,53,0)=" alcohol or drugs.<br />  <br /> Think back over the past 30 days and answer"
