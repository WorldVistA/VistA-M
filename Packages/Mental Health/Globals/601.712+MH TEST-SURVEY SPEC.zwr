^YTT(601.712,160,1,17,0)="   {""id"": ""q8975"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": true, "
^YTT(601.712,160,1,18,0)="    ""text"": ""2. Are you short of breath when hurrying on the level or walking up a slight"
