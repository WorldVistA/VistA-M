^YTT(601.712,172,1,1,0)="{""name"": ""LVVFQ"","
^YTT(601.712,172,1,2,0)=" ""restartDays"": 2,"
^YTT(601.712,172,1,3,0)=" ""printTitle"": ""Low Vision Visual Functioning Questionnaire"","
^YTT(601.712,172,1,4,0)=" ""content"":["
^YTT(601.712,172,1,5,0)="   {""id"": ""i2472"", ""type"": ""IntroText"","
^YTT(601.712,172,1,6,0)="    ""text"": ""<strong>For each of the following <u>items</u> select one response to indicate the difficulty"
^YTT(601.712,172,1,7,0)=" level.</strong><br/><br/>These questions relate to reading and near vision"
^YTT(601.712,172,1,8,0)=" activities. Remember if you use a low vision device, adaptive device, or an"
