^YTT(601.712,16,1,390,0)="   {""id"": ""q1093"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,391,0)="    ""text"": ""48. I have a habit of making my problems sound worse than they really are."", "
