^YTT(601.712,17,1,928,0)="   ]}, "
^YTT(601.712,17,1,929,0)="   {""id"": ""q1511"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,930,0)="    ""text"": ""126. Most successful people today have been either lucky of dishonest."", "
