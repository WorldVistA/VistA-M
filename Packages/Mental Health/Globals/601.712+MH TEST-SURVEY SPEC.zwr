^YTT(601.712,89,1,9,0)="    }, "
^YTT(601.712,89,1,10,0)="   {""id"": ""q7216"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,89,1,11,0)="    ""text"": ""1. Little interest or pleasure in doing things?"", "
