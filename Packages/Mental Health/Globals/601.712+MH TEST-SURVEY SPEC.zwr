^YTT(601.712,193,1,31,0)=" of words to be recalled. <br /> <br />1. Attention"", "
^YTT(601.712,193,1,32,0)="    ""columns"": 1, "
^YTT(601.712,193,1,33,0)="    ""choices"":["
^YTT(601.712,193,1,34,0)="     {""id"": ""c6073"", ""text"": ""1. Correct backward digit span"", ""quickKey"": 1}, "
