^YTT(601.712,142,1,5,0)="   {""id"": ""i2462"", ""type"": ""IntroText"", "
^YTT(601.712,142,1,6,0)="    ""text"": ""For these questions, please consider the <strong><u>most important things</u></strong> that you do, or"
^YTT(601.712,142,1,7,0)=" wish to do, in your daily life. This might include having a job, spending time"
^YTT(601.712,142,1,8,0)=" with family and friends, participating in leisure-time activities, or managing"
^YTT(601.712,142,1,9,0)=" your health or finances. <br /><br /><strong><u>Over the past three months</u></strong>, what percentage"
^YTT(601.712,142,1,10,0)=" of the time have you been:"""
^YTT(601.712,142,1,11,0)="    }, "
