^YTT(601.712,87,1,430,0)="   {""id"": ""q7058"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,87,1,431,0)="    ""text"": ""36. When I'm upset, my emotions feel overwhelming."", "
^YTT(601.712,87,1,432,0)="    ""intro"": ""Please indicate how often the following statements apply to you by selecting the"
^YTT(601.712,87,1,433,0)=" appropriate number from the scale below each item."", "
^YTT(601.712,87,1,434,0)="    ""columns"": 1, "
^YTT(601.712,87,1,435,0)="    ""choices"":["
^YTT(601.712,87,1,436,0)="     {""id"": ""c3353"", ""text"": ""1. Almost never (0-10%)"", ""quickKey"": 1}, "
^YTT(601.712,87,1,437,0)="     {""id"": ""c3354"", ""text"": ""2. Sometimes (11-35%)"", ""quickKey"": 2}, "
^YTT(601.712,87,1,438,0)="     {""id"": ""c3355"", ""text"": ""3. About half the time (36-65%)"", ""quickKey"": 3}, "
^YTT(601.712,87,1,439,0)="     {""id"": ""c3356"", ""text"": ""4. Most of the time (66 - 90%)"", ""quickKey"": 4}, "
^YTT(601.712,87,1,440,0)="     {""id"": ""c3357"", ""text"": ""5. Almost always (91-100%)"", ""quickKey"": 5}"
^YTT(601.712,87,1,441,0)="   ]}]"
^YTT(601.712,87,1,442,0)="}"
^YTT(601.712,88,0)="210^3220408.090913^3492994842"
