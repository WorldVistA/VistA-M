^YTT(601.712,181,1,5,0)="   {""id"": ""i2555"", ""type"": ""IntroText"", "
^YTT(601.712,181,1,6,0)="    ""text"": ""Please answer the following questions as accurately as possible."""
^YTT(601.712,181,1,7,0)="    }, "
^YTT(601.712,181,1,8,0)="   {""id"": ""q9255"", ""type"": ""IntegerQuestion"", ""required"": true, "
^YTT(601.712,181,1,9,0)="    ""text"": ""1. How many days in the past 12 months have you used drugs other than alcohol?"", "
^YTT(601.712,181,1,10,0)="    ""intro"": ""Please answer the following questions as accurately as possible."", "
^YTT(601.712,181,1,11,0)="    ""controlWidth"": 662, ""min"": 0, ""max"": 365}, "
^YTT(601.712,181,1,12,0)="   {""id"": ""q9256"", ""type"": ""IntegerQuestion"", ""required"": true, "
^YTT(601.712,181,1,13,0)="    ""text"": ""2. How many days in the past 12 months have you used drugs more than you meant"
^YTT(601.712,181,1,14,0)=" to?"", "
^YTT(601.712,181,1,15,0)="    ""intro"": ""Please answer the following questions as accurately as possible."", "
^YTT(601.712,181,1,16,0)="    ""controlWidth"": 662, ""min"": 0, ""max"": 365}], "
^YTT(601.712,181,1,17,0)=" ""rules"":["
