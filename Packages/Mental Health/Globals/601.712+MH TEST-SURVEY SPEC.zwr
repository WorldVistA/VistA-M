^YTT(601.712,52,1,103,0)="    ""legend"":[""No change"", "" Extreme change""]}, "
^YTT(601.712,52,1,104,0)="   {""id"": ""q5207"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,52,1,105,0)="    ""text"": ""A5. How supportive or helpful is your spouse (significant other) to you in"
