^YTT(601.712,11,1,139,0)="    "
^YTT(601.712,11,1,140,0)="    ""choices"":["
^YTT(601.712,11,1,141,0)="     {""id"": ""c660"", ""text"": ""0. I do not have the courage or the ability to commit suicide."", ""quickKey"": 0}, "
^YTT(601.712,11,1,142,0)="     {""id"": ""c661"", ""text"": ""1. I am unsure that I have the courage or the ability to commit suicide."", ""quickKey"": 1}, "
