^YTT(601.712,124,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,124,1,3,0)=" ""printTitle"": ""Mental Health Recovery Measure-10 (MHRM-10)"","
^YTT(601.712,124,1,4,0)=" ""content"":["
^YTT(601.712,124,1,5,0)="   {""id"": ""i2405"", ""type"": ""IntroText"", "
^YTT(601.712,124,1,6,0)="    ""text"": "" The goal of this questionnaire is to find out how you view your own current"
^YTT(601.712,124,1,7,0)=" recovery process. The mental health recovery process is complex and is different"
^YTT(601.712,124,1,8,0)=" for each individual. There are no right or wrong answers. Please read each"
^YTT(601.712,124,1,9,0)=" statement carefully, with regard to your own current recovery process, and"
^YTT(601.712,124,1,10,0)=" indicate how much you agree or disagree with each item by selecting the"
^YTT(601.712,124,1,11,0)=" appropriate response."""
^YTT(601.712,124,1,12,0)="    }, "
^YTT(601.712,124,1,13,0)="   {""id"": ""q8410"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,124,1,14,0)="    ""text"": ""1. I still grow and change in positive ways despite my mental health problem."", "
