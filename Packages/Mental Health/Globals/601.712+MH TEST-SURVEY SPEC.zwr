^YTT(601.712,115,1,1415,0)="    ""text"": ""194. I tend to go along with others' opinions."", "
^YTT(601.712,115,1,1416,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1417,0)="    ""choices"":["
