^YTT(601.712,17,1,573,0)="    ""text"": ""77. I have a great deal of trouble trying to control an impulse to drink to"
^YTT(601.712,17,1,574,0)=" excess."", "
^YTT(601.712,17,1,575,0)="    "
^YTT(601.712,17,1,576,0)="    ""choices"":["
^YTT(601.712,17,1,577,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
