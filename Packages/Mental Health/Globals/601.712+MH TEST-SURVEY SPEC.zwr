^YTT(601.712,115,1,733,0)="    ""text"": ""99. I always feel self-conscious and tense at social gatherings."", "
^YTT(601.712,115,1,734,0)="    ""columns"": 1, "
^YTT(601.712,115,1,735,0)="    ""choices"":["
