^YTT(601.712,82,1,6,0)="   {""id"": ""i1778"", ""type"": ""IntroText"", "
^YTT(601.712,82,1,7,0)="    ""text"": ""This assessment asks how you feel about your quality of life, health, or other"
^YTT(601.712,82,1,8,0)=" areas of your life. Please answer all the questions. If you are unsure about"
^YTT(601.712,82,1,9,0)=" which response to give to a question,   please choose the one that appears most"
^YTT(601.712,82,1,10,0)=" appropriate. This can often be your first response.<br /><br />Please keep in"
^YTT(601.712,82,1,11,0)=" mind your standards, hopes, pleasures and concerns. We ask that you think about"
^YTT(601.712,82,1,12,0)=" your life   in the last two weeks.  """
^YTT(601.712,82,1,13,0)="    }, "
^YTT(601.712,82,1,14,0)="   {""id"": ""q6605"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,82,1,15,0)="    ""text"": ""1. How would you rate your quality of life?"", "
