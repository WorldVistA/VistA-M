^YTT(601.712,17,1,915,0)="    ""text"": ""124. When I'm alone and away from home, I often begin to feel tense and panicky."", "
^YTT(601.712,17,1,916,0)="    "
^YTT(601.712,17,1,917,0)="    ""choices"":["
^YTT(601.712,17,1,918,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
