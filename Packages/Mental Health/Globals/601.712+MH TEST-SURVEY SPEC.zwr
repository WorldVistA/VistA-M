^YTT(601.712,17,1,887,0)="    ""text"": ""120. I'll do something desperate to prevent a person I love from abandoning me."", "
^YTT(601.712,17,1,888,0)="    "
^YTT(601.712,17,1,889,0)="    ""choices"":["
