^YTT(601.712,87,1,13,0)="    ""columns"": 1, "
^YTT(601.712,87,1,14,0)="    ""choices"":["
^YTT(601.712,87,1,15,0)="     {""id"": ""c4104"", ""text"": ""1. Almost never (0-10%)"", ""quickKey"": 1}, "
^YTT(601.712,87,1,16,0)="     {""id"": ""c4105"", ""text"": ""2. Sometimes (11-35%)"", ""quickKey"": 2}, "
^YTT(601.712,87,1,17,0)="     {""id"": ""c4106"", ""text"": ""3. About half the time (36-65%)"", ""quickKey"": 3}, "
^YTT(601.712,87,1,18,0)="     {""id"": ""c4107"", ""text"": ""4. Most of the time (66 - 90%)"", ""quickKey"": 4}, "
^YTT(601.712,87,1,19,0)="     {""id"": ""c4108"", ""text"": ""5. Almost always (91-100%)"", ""quickKey"": 5}"
^YTT(601.712,87,1,20,0)="   ]}, "
