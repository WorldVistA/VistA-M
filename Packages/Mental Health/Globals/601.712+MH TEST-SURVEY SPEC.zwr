^YTT(601.712,145,1,6,0)="   {""id"": ""i2465"", ""type"": ""IntroText"", "
^YTT(601.712,145,1,7,0)="    ""text"": ""Instructions: The following questions are concerned with the past four weeks (28"
^YTT(601.712,145,1,8,0)=" days) only. <br />Please read each question carefully. Please answer all the"
^YTT(601.712,145,1,9,0)=" questions. Thank you. <br /> <br />Questions 1 to 12: Please select the"
^YTT(601.712,145,1,10,0)=" appropriate option. Remember that the questions only refer to the past four"
^YTT(601.712,145,1,11,0)=" weeks (28 days) only. <br /> <br /><strong>ON HOW MANY OF THE PAST 28 DAYS ...</strong>"""
^YTT(601.712,145,1,12,0)="    }, "
^YTT(601.712,145,1,13,0)="   {""id"": ""q8706"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,145,1,14,0)="    ""text"": ""1. Have you been deliberately <u>trying</u> to limit the amount of food you eat to"
^YTT(601.712,145,1,15,0)=" influence your shape or weight (whether or not you have succeeded)?"", "
