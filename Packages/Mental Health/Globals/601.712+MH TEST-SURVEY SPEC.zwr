^YTT(601.712,107,1,114,0)="     {""id"": ""c3790"", ""text"": ""2. NO, no change"", ""quickKey"": 2}, "
^YTT(601.712,107,1,115,0)="     {""id"": ""c3791"", ""text"": ""3. N/A, don't know"", ""quickKey"": 3}"
^YTT(601.712,107,1,116,0)="   ]}, "
^YTT(601.712,107,1,117,0)="   {""id"": ""q7933"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,107,1,118,0)="    ""text"": ""8. Daily problems with thinking and/or memory"", "
^YTT(601.712,107,1,119,0)="    ""intro"": ""The instrument may be self-administered or can be read aloud. It is preferable to"
^YTT(601.712,107,1,120,0)=" administer the AD8 to an informant, if available. If an informant is not"
^YTT(601.712,107,1,121,0)=" available, the AD8 questionnaire may be administered to the patient. Rater"
^YTT(601.712,107,1,122,0)=" should only rate changes in the patient due to cognitive problems.<br /> <br />"
^YTT(601.712,107,1,123,0)=" Remember, \u0022Yes, a change\u0022 indicates that there has been a change in"
^YTT(601.712,107,1,124,0)=" the last several years caused by cognitive (thinking and memory) problems."", "
^YTT(601.712,107,1,125,0)="    ""columns"": 1, "
^YTT(601.712,107,1,126,0)="    ""choices"":["
^YTT(601.712,107,1,127,0)="     {""id"": ""c3789"", ""text"": ""1. YES, a change"", ""quickKey"": 1}, "
^YTT(601.712,107,1,128,0)="     {""id"": ""c3790"", ""text"": ""2. NO, no change"", ""quickKey"": 2}, "
^YTT(601.712,107,1,129,0)="     {""id"": ""c3791"", ""text"": ""3. N/A, don't know"", ""quickKey"": 3}"
^YTT(601.712,107,1,130,0)="   ]}]"
^YTT(601.712,107,1,131,0)="}"
