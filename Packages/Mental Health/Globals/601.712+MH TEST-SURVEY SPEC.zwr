^YTT(601.712,113,1,324,0)="     {""id"": ""c3910"", ""text"": ""2. Somewhat Agree"", ""quickKey"": 2}, "
^YTT(601.712,113,1,325,0)="     {""id"": ""c3911"", ""text"": ""3. Somewhat Disagree"", ""quickKey"": 3}, "
