^YTT(601.712,171,1,1,0)="{""name"": ""CMAI"", "
^YTT(601.712,171,1,2,0)=" ""copyright"": ""Cohen Mansfield, 1986. All rights reserved."", "
^YTT(601.712,171,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,171,1,4,0)=" ""printTitle"": ""Cohen-Mansfield Agitation Inventory"", "
^YTT(601.712,171,1,5,0)=" ""content"":["
^YTT(601.712,171,1,6,0)="   {""id"": ""i2529"", ""type"": ""IntroText"", "
^YTT(601.712,171,1,7,0)="    ""text"": ""Please read each of the agitated behaviors, and check how often (1-5) they were"
^YTT(601.712,171,1,8,0)=" manifested by the resident over the last 2 weeks; if more than one occurred"
^YTT(601.712,171,1,9,0)=" within a group, add the occurrences. E.g. if hitting occurred on 3 days a week,"
^YTT(601.712,171,1,10,0)=" and kicking occurred on 4 days a week, 3+4=7 days, circle 4 for 'once or several"
^YTT(601.712,171,1,11,0)=" times a day."""
^YTT(601.712,171,1,12,0)="    }, "
^YTT(601.712,171,1,13,0)="   {""id"": ""q9158"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,171,1,14,0)="    ""text"": ""1. Cursing or verbal aggression"", "
^YTT(601.712,171,1,15,0)="    ""intro"": ""Please read each of the agitated behaviors, and check how often (1-5) they were"
^YTT(601.712,171,1,16,0)=" manifested by the resident over the last 2 weeks; if more than one occurred"
^YTT(601.712,171,1,17,0)=" within a group, add the occurrences. E.g. if hitting occurred on 3 days a week,"
^YTT(601.712,171,1,18,0)=" and kicking occurred on 4 days a week, 3+4=7 days, circle 4 for 'once or several"
^YTT(601.712,171,1,19,0)=" times a day."", "
^YTT(601.712,171,1,20,0)="    "
^YTT(601.712,171,1,21,0)="    ""choices"":["
^YTT(601.712,171,1,22,0)="     {""id"": ""c5677"", ""text"": ""1. Never"", ""quickKey"": 1}, "
^YTT(601.712,171,1,23,0)="     {""id"": ""c5678"", ""text"": ""2. Less than once a week"", ""quickKey"": 2}, "
^YTT(601.712,171,1,24,0)="     {""id"": ""c5679"", ""text"": ""3. Once or several times a week"", ""quickKey"": 3}, "
^YTT(601.712,171,1,25,0)="     {""id"": ""c5680"", ""text"": ""4. Once or several times a day"", ""quickKey"": 4}, "
^YTT(601.712,171,1,26,0)="     {""id"": ""c5681"", ""text"": ""5. A few times an hour or continuous for half an hour or more"", ""quickKey"": 5}"
^YTT(601.712,171,1,27,0)="   ]}, "
^YTT(601.712,171,1,28,0)="   {""id"": ""q9159"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,171,1,29,0)="    ""text"": ""2. Hitting, kicking, pushing, biting, scratching, aggressive spitting"", "
^YTT(601.712,171,1,30,0)="    ""intro"": ""Please read each of the agitated behaviors, and check how often (1-5) they were"
^YTT(601.712,171,1,31,0)=" manifested by the resident over the last 2 weeks; if more than one occurred"
^YTT(601.712,171,1,32,0)=" within a group, add the occurrences. E.g. if hitting occurred on 3 days a week,"
^YTT(601.712,171,1,33,0)=" and kicking occurred on 4 days a week, 3+4=7 days, circle 4 for 'once or several"
^YTT(601.712,171,1,34,0)=" times a day."", "
^YTT(601.712,171,1,35,0)="    "
^YTT(601.712,171,1,36,0)="    ""choices"":["
^YTT(601.712,171,1,37,0)="     {""id"": ""c5677"", ""text"": ""1. Never"", ""quickKey"": 1}, "
