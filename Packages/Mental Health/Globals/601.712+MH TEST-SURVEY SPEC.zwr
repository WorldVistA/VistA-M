^YTT(601.712,97,1,4,0)=" ""printTitle"": ""Patient Safety Secondary Screener: (PSS-3 2nd)"","
^YTT(601.712,97,1,5,0)=" ""content"":["
^YTT(601.712,97,1,6,0)="   {""id"": ""i2363"", ""type"": ""IntroText"", "
^YTT(601.712,97,1,7,0)="    ""text"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
^YTT(601.712,97,1,8,0)=" self-report.<br /> <br /> A \u0022yes\u0022 on any of the items below means the"
^YTT(601.712,97,1,9,0)=" treating physician should consider consulting a mental health professional."""
^YTT(601.712,97,1,10,0)="    }, "
^YTT(601.712,97,1,11,0)="   {""id"": ""q7849"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,97,1,12,0)="    ""text"": ""1. Did the patient screen positive on both PSS items - active ideation with a"
^YTT(601.712,97,1,13,0)=" past attempt? <br />Source: PSS screener completed by primary nurse, documented"
^YTT(601.712,97,1,14,0)=" on chart."", "
^YTT(601.712,97,1,15,0)="    ""intro"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
^YTT(601.712,97,1,16,0)=" self-report.<br /> <br /> A \u0022yes\u0022 on any of the items below means the"
^YTT(601.712,97,1,17,0)=" treating physician should consider consulting a mental health professional."", "
^YTT(601.712,97,1,18,0)="    ""columns"": 1, "
^YTT(601.712,97,1,19,0)="    ""choices"":["
^YTT(601.712,97,1,20,0)="     {""id"": ""c106376"", ""text"": "" Yes""}, "
^YTT(601.712,97,1,21,0)="     {""id"": ""c106377"", ""text"": "" No""}, "
^YTT(601.712,97,1,22,0)="     {""id"": ""c106378"", ""text"": "" Refused""}, "
^YTT(601.712,97,1,23,0)="     {""id"": ""c106379"", ""text"": "" Patient unable to complete""}"
^YTT(601.712,97,1,24,0)="   ]}, "
^YTT(601.712,97,1,25,0)="   {""id"": ""q7850"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,97,1,26,0)="    ""text"": ""2. Has the individual begun a suicide plan? <br />Source: Use patient"
^YTT(601.712,97,1,27,0)=" self-report, collateral information. <br />Suggested wording: Have you been"
^YTT(601.712,97,1,28,0)=" thinking about how you might kill yourself?"", "
^YTT(601.712,97,1,29,0)="    ""intro"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
^YTT(601.712,97,1,30,0)=" self-report.<br /> <br /> A \u0022yes\u0022 on any of the items below means the"
^YTT(601.712,97,1,31,0)=" treating physician should consider consulting a mental health professional."", "
^YTT(601.712,97,1,32,0)="    ""columns"": 1, "
^YTT(601.712,97,1,33,0)="    ""choices"":["
^YTT(601.712,97,1,34,0)="     {""id"": ""c106376"", ""text"": "" Yes""}, "
^YTT(601.712,97,1,35,0)="     {""id"": ""c106377"", ""text"": "" No""}, "
^YTT(601.712,97,1,36,0)="     {""id"": ""c106378"", ""text"": "" Refused""}, "
^YTT(601.712,97,1,37,0)="     {""id"": ""c106379"", ""text"": "" Patient unable to complete""}"
^YTT(601.712,97,1,38,0)="   ]}, "
^YTT(601.712,97,1,39,0)="   {""id"": ""q7851"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,97,1,40,0)="    ""text"": ""3. Has the individual recently had intent to act on his/her ideation? <br"
^YTT(601.712,97,1,41,0)=" />Source: Use patient self-report, collateral information. <br />Suggested"
^YTT(601.712,97,1,42,0)=" wording: Have you had some intention of acting on your thoughts?"", "
^YTT(601.712,97,1,43,0)="    ""intro"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
^YTT(601.712,97,1,44,0)=" self-report.<br /> <br /> A \u0022yes\u0022 on any of the items below means the"
^YTT(601.712,97,1,45,0)=" treating physician should consider consulting a mental health professional."", "
^YTT(601.712,97,1,46,0)="    ""columns"": 1, "
^YTT(601.712,97,1,47,0)="    ""choices"":["
^YTT(601.712,97,1,48,0)="     {""id"": ""c106376"", ""text"": "" Yes""}, "
^YTT(601.712,97,1,49,0)="     {""id"": ""c106377"", ""text"": "" No""}, "
^YTT(601.712,97,1,50,0)="     {""id"": ""c106378"", ""text"": "" Refused""}, "
^YTT(601.712,97,1,51,0)="     {""id"": ""c106379"", ""text"": "" Patient unable to complete""}"
^YTT(601.712,97,1,52,0)="   ]}, "
^YTT(601.712,97,1,53,0)="   {""id"": ""q7852"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,97,1,54,0)="    ""text"": ""4. Has the patient ever had a psychiatric hospitalization? <br />Source: Use"
^YTT(601.712,97,1,55,0)=" patient self-report, collateral information, medical records review. <br"
^YTT(601.712,97,1,56,0)=" />Suggested wording: Have you ever been hospitalized for a mental health or"
^YTT(601.712,97,1,57,0)=" substance use problem?"", "
^YTT(601.712,97,1,58,0)="    ""intro"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
^YTT(601.712,97,1,59,0)=" self-report.<br /> <br /> A \u0022yes\u0022 on any of the items below means the"
^YTT(601.712,97,1,60,0)=" treating physician should consider consulting a mental health professional."", "
^YTT(601.712,97,1,61,0)="    ""columns"": 1, "
^YTT(601.712,97,1,62,0)="    ""choices"":["
^YTT(601.712,97,1,63,0)="     {""id"": ""c106376"", ""text"": "" Yes""}, "
^YTT(601.712,97,1,64,0)="     {""id"": ""c106377"", ""text"": "" No""}, "
^YTT(601.712,97,1,65,0)="     {""id"": ""c106378"", ""text"": "" Refused""}, "
^YTT(601.712,97,1,66,0)="     {""id"": ""c106379"", ""text"": "" Patient unable to complete""}"
^YTT(601.712,97,1,67,0)="   ]}, "
^YTT(601.712,97,1,68,0)="   {""id"": ""q7853"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,97,1,69,0)="    ""text"": ""5. Does the patient have a pattern of excessive substance use? <br />Source: Use"
^YTT(601.712,97,1,70,0)=" patient self-report, collateral information, medical records review. <br"
^YTT(601.712,97,1,71,0)=" />Suggested wording: Has drinking or drug abuse ever been a problem for you? Or"
^YTT(601.712,97,1,72,0)=" administer CAGE or other standardized substance use screener."", "
^YTT(601.712,97,1,73,0)="    ""intro"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
^YTT(601.712,97,1,74,0)=" self-report.<br /> <br /> A \u0022yes\u0022 on any of the items below means the"
^YTT(601.712,97,1,75,0)=" treating physician should consider consulting a mental health professional."", "
^YTT(601.712,97,1,76,0)="    ""columns"": 1, "
