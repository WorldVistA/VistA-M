^YTT(601.712,71,1,222,0)="   {""id"": ""q5980"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,71,1,223,0)="    ""text"": ""9A. Choose the following sentence that best describes your current goal regarding"
^YTT(601.712,71,1,224,0)=" employment:"", "
^YTT(601.712,71,1,225,0)="    ""intro"": ""Below is a list of statements that describe how people sometimes feel about"
^YTT(601.712,71,1,226,0)=" themselves and their lives. Please read each one carefully and indicate the"
^YTT(601.712,71,1,227,0)=" response that best describes the extent to   which you agree or disagree with"
^YTT(601.712,71,1,228,0)=" the statement.  "", "
^YTT(601.712,71,1,229,0)="    ""columns"": 1, "
^YTT(601.712,71,1,230,0)="    ""choices"":["
^YTT(601.712,71,1,231,0)="     {""id"": ""c3045"", ""text"": ""1. I am retired and do not wish to be employed."", ""quickKey"": 1}, "
^YTT(601.712,71,1,232,0)="     {""id"": ""c3046"", ""text"": ""2. I am not retired and I do not wish to be employed in a paid job at all."", ""quickKey"": 2}, "
^YTT(601.712,71,1,233,0)="     {""id"": ""c3147"", ""text"": ""3. I do not wish to be employed in a paid job because I'm concerned about losing"
^YTT(601.712,71,1,234,0)=" my disability benefits."", ""quickKey"": 3}, "
^YTT(601.712,71,1,235,0)="     {""id"": ""c3048"", ""text"": ""4. I want to be employed in a part-time paid job. I need support from a"
^YTT(601.712,71,1,236,0)=" vocational counselor to become employed."", ""quickKey"": 4}, "
^YTT(601.712,71,1,237,0)="     {""id"": ""c3049"", ""text"": ""5. I want to be employed in a full-time paid job. I need support from a"
^YTT(601.712,71,1,238,0)=" vocational counselor to become employed."", ""quickKey"": 5}, "
^YTT(601.712,71,1,239,0)="     {""id"": ""c3050"", ""text"": ""6. I want to be employed in a part-time  paid job. I do not need support from a"
^YTT(601.712,71,1,240,0)=" vocational counselor."", ""quickKey"": 6}, "
^YTT(601.712,71,1,241,0)="     {""id"": ""c3051"", ""text"": ""7. I want to be employed in a full-time paid job.  I do not need support from a"
^YTT(601.712,71,1,242,0)=" vocational counselor."", ""quickKey"": 7}"
^YTT(601.712,71,1,243,0)="   ]}, "
