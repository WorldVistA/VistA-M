^YTT(601.712,74,1,247,0)="   {""id"": ""i875"", ""type"": ""IntroText"", "
^YTT(601.712,74,1,248,0)="    ""text"": ""HELPING means helping others in need or helping to make your community a better"
^YTT(601.712,74,1,249,0)=" place to live. HELPING can be done on your own or in a group like a church, a"
^YTT(601.712,74,1,250,0)=" neighborhood association, or a political   party. HELPING can include doing"
^YTT(601.712,74,1,251,0)=" volunteer work at a school or giving money to a good cause. HELPING means"
^YTT(601.712,74,1,252,0)=" helping people who are not your friends or relatives. """
^YTT(601.712,74,1,253,0)="    }, "
