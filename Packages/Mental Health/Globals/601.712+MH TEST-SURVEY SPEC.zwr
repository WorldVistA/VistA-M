^YTT(601.712,28,1,88,0)="     {""id"": ""c2677"", ""text"": ""0. Not present (Score 0)"", ""quickKey"": 0}, "
^YTT(601.712,28,1,89,0)="     {""id"": ""c2681"", ""text"": ""1. Nasal stuffiness or unusually moist eyes (Score 1)"", ""quickKey"": 1}, "
^YTT(601.712,28,1,90,0)="     {""id"": ""c2682"", ""text"": ""2. Nose running or tearing (Score 2)"", ""quickKey"": 2}, "
^YTT(601.712,28,1,91,0)="     {""id"": ""c2683"", ""text"": ""3. Nose constantly running or tears streaming down cheeks (Score 4)"", ""quickKey"": 3}"
^YTT(601.712,28,1,92,0)="   ]}, "
^YTT(601.712,28,1,93,0)="   {""id"": ""q4039"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,94,0)="    ""text"": ""7. GI upset: Over last half-hour."", "
