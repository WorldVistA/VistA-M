^YTT(601.712,180,1,82,0)="     {""id"": ""c5771"", ""text"": ""2 "", ""quickKey"": 2}, "
^YTT(601.712,180,1,83,0)="     {""id"": ""c5772"", ""text"": ""3 "", ""quickKey"": 3}, "
^YTT(601.712,180,1,84,0)="     {""id"": ""c5773"", ""text"": ""4 "", ""quickKey"": 4}, "
^YTT(601.712,180,1,85,0)="     {""id"": ""c5774"", ""text"": ""5 "", ""quickKey"": 5}, "
^YTT(601.712,180,1,86,0)="     {""id"": ""c5775"", ""text"": ""6 "", ""quickKey"": 6}, "
^YTT(601.712,180,1,87,0)="     {""id"": ""c5776"", ""text"": ""7 "", ""quickKey"": 7}, "
^YTT(601.712,180,1,88,0)="     {""id"": ""c5777"", ""text"": ""8 "", ""quickKey"": 8}, "
^YTT(601.712,180,1,89,0)="     {""id"": ""c5778"", ""text"": ""9 "", ""quickKey"": 9}, "
