^YTT(601.712,128,1,25,0)="     {""id"": ""c5016"", ""text"": ""1. Once or a few times"", ""quickKey"": 1}, "
^YTT(601.712,128,1,26,0)="     {""id"": ""c5017"", ""text"": ""2. Once or twice a week"", ""quickKey"": 2}, "
^YTT(601.712,128,1,27,0)="     {""id"": ""c5018"", ""text"": ""3. Daily or almost daily"", ""quickKey"": 3}"
^YTT(601.712,128,1,28,0)="   ]}, "
^YTT(601.712,128,1,29,0)="   {""id"": ""q8484"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
