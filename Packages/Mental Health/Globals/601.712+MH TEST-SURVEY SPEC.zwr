^YTT(601.712,17,1,566,0)="    ""text"": ""76. I keep having strange thoughts that I wish I could get rid of."", "
^YTT(601.712,17,1,567,0)="    "
^YTT(601.712,17,1,568,0)="    ""choices"":["
^YTT(601.712,17,1,569,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
