^YTT(601.712,189,1,125,0)="     {""id"": ""c5922"", ""text"": ""6. Push; consistently increased rate and amount; difficult to interrupt"", ""quickKey"": 6}, "
^YTT(601.712,189,1,126,0)="     {""id"": ""c5923"", ""text"": ""7.  "", ""quickKey"": 7}, "
^YTT(601.712,189,1,127,0)="     {""id"": ""c5924"", ""text"": ""8. Pressured; uninterruptible, continuous speech"", ""quickKey"": 8}"
^YTT(601.712,189,1,128,0)="   ]}, "
^YTT(601.712,189,1,129,0)="   {""id"": ""q9402"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,130,0)="    ""text"": ""7. LANGUAGE - THOUGHT DISORDER"", "
^YTT(601.712,189,1,131,0)="    ""intro"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,132,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,133,0)=" presence of only one is required to qualify for that rating. The keys provided"
^YTT(601.712,189,1,134,0)=" are guides. One can ignore the keys if that is necessary to indicate severity,"
^YTT(601.712,189,1,135,0)=" although this  should be the exception rather than the rule."", "
^YTT(601.712,189,1,136,0)="    ""columns"": 1, "
^YTT(601.712,189,1,137,0)="    ""choices"":["
^YTT(601.712,189,1,138,0)="     {""id"": ""c5925"", ""text"": "" 0 Absent""}, "
^YTT(601.712,189,1,139,0)="     {""id"": ""c5926"", ""text"": "" 0.5""}, "
^YTT(601.712,189,1,140,0)="     {""id"": ""c5927"", ""text"": "" 1 Circumstantial; mild distractibility; quick thoughts""}, "
^YTT(601.712,189,1,141,0)="     {""id"": ""c5928"", ""text"": "" 1.5""}, "
^YTT(601.712,189,1,142,0)="     {""id"": ""c5929"", ""text"": "" 2 Distractible; loses goal of thought; change topics frequently; racing thoughts""}, "
^YTT(601.712,189,1,143,0)="     {""id"": ""c5930"", ""text"": "" 2.5""}, "
^YTT(601.712,189,1,144,0)="     {""id"": ""c5931"", ""text"": "" 3 Flight of ideas; tangentiality; difficult to follow; rhyming, echolalia""}, "
^YTT(601.712,189,1,145,0)="     {""id"": ""c5932"", ""text"": "" 3.5""}, "
^YTT(601.712,189,1,146,0)="     {""id"": ""c5933"", ""text"": "" 4 Incoherent; communication impossible""}"
^YTT(601.712,189,1,147,0)="   ]}, "
^YTT(601.712,189,1,148,0)="   {""id"": ""q9403"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,149,0)="    ""text"": ""8. CONTENT"", "
^YTT(601.712,189,1,150,0)="    ""intro"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,151,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,152,0)=" presence of only one is required to qualify for that rating. The keys provided"
^YTT(601.712,189,1,153,0)=" are guides. One can ignore the keys if that is necessary to indicate severity,"
^YTT(601.712,189,1,154,0)=" although this  should be the exception rather than the rule."", "
^YTT(601.712,189,1,155,0)="    ""columns"": 1, "
^YTT(601.712,189,1,156,0)="    ""choices"":["
^YTT(601.712,189,1,157,0)="     {""id"": ""c5934"", ""text"": ""0. Normal"", ""quickKey"": 0}, "
^YTT(601.712,189,1,158,0)="     {""id"": ""c5935"", ""text"": ""1.  "", ""quickKey"": 1}, "
^YTT(601.712,189,1,159,0)="     {""id"": ""c5936"", ""text"": ""2. Questionable plans, new interests"", ""quickKey"": 2}, "
^YTT(601.712,189,1,160,0)="     {""id"": ""c5937"", ""text"": ""3.  "", ""quickKey"": 3}, "
^YTT(601.712,189,1,161,0)="     {""id"": ""c5938"", ""text"": ""4. Special project(s); hyperreligious"", ""quickKey"": 4}, "
^YTT(601.712,189,1,162,0)="     {""id"": ""c5939"", ""text"": ""5.  "", ""quickKey"": 5}, "
^YTT(601.712,189,1,163,0)="     {""id"": ""c5940"", ""text"": ""6. Grandiose or paranoid ideas; ideas of reference"", ""quickKey"": 6}, "
^YTT(601.712,189,1,164,0)="     {""id"": ""c5941"", ""text"": ""7.  "", ""quickKey"": 7}, "
^YTT(601.712,189,1,165,0)="     {""id"": ""c5942"", ""text"": ""8. Delusions; hallucinations"", ""quickKey"": 8}"
^YTT(601.712,189,1,166,0)="   ]}, "
^YTT(601.712,189,1,167,0)="   {""id"": ""q9404"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,168,0)="    ""text"": ""9. DISRUPTIVE - AGGRESSIVE BEHAVIOR"", "
^YTT(601.712,189,1,169,0)="    ""intro"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,170,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,171,0)=" presence of only one is required to qualify for that rating. The keys provided"
