^YTT(601.712,178,1,8,0)="   {""id"": ""q9229"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,178,1,9,0)="    ""text"": ""1. In the last twelve months, did you use pot (cannabis), use another street"
^YTT(601.712,178,1,10,0)=" drug, or use a prescription medication 'recreationally' (just for the feeling,"
^YTT(601.712,178,1,11,0)=" or using more than prescribed)?"", "
^YTT(601.712,178,1,12,0)="    ""intro"": ""Please answer the following question."", "
^YTT(601.712,178,1,13,0)="    ""columns"": 1, "
^YTT(601.712,178,1,14,0)="    ""choices"":["
^YTT(601.712,178,1,15,0)="     {""id"": ""c5762"", ""text"": ""1. Yes"", ""quickKey"": 1}, "
^YTT(601.712,178,1,16,0)="     {""id"": ""c5763"", ""text"": ""2. No"", ""quickKey"": 2}"
^YTT(601.712,178,1,17,0)="   ]}]"
^YTT(601.712,178,1,18,0)="}"
