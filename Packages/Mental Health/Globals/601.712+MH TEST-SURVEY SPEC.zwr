^YTT(601.712,17,1,4,0)=" ""printTitle"": ""Millon Clinical Multiaxial Inventory III"","
^YTT(601.712,17,1,5,0)=" ""content"":["
^YTT(601.712,17,1,6,0)="   {""id"": ""i33"", ""type"": ""IntroText"", "
^YTT(601.712,17,1,7,0)="    ""text"": ""A list of statements will be presented to help you in describing your feelings"
^YTT(601.712,17,1,8,0)=" and attitudes. Try to be as honest and serious as you can. Do not be concerned"
^YTT(601.712,17,1,9,0)=" if a few statements seem unusual; they are included to describe people with many"
^YTT(601.712,17,1,10,0)=" types of problems. If you agree with a statement or decide that it describes"
^YTT(601.712,17,1,11,0)=" you, answer True. If you disagree or decide that it does not describe you,"
^YTT(601.712,17,1,12,0)=" answer False. Try to mark every statement, even if you are not sure of your"
^YTT(601.712,17,1,13,0)=" choice. If you have tried your best and still cannot decide, answer False. There"
^YTT(601.712,17,1,14,0)=" is no time limit for completing the inventory, but it is best to work as rapidly"
^YTT(601.712,17,1,15,0)=" as is comfortable for you."""
^YTT(601.712,17,1,16,0)="    }, "
^YTT(601.712,17,1,17,0)="   {""id"": ""q1386"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,18,0)="    ""text"": ""1. Lately, my strength seems to be draining out of me, even in the morning."", "
^YTT(601.712,17,1,19,0)="    ""intro"": ""A list of statements will be presented to help you in describing your feelings"
^YTT(601.712,17,1,20,0)=" and attitudes. Try to be as honest and serious as you can. Do not be concerned"
^YTT(601.712,17,1,21,0)=" if a few statements seem unusual; they are included to describe people with many"
^YTT(601.712,17,1,22,0)=" types of problems. If you agree with a statement or decide that it describes"
^YTT(601.712,17,1,23,0)=" you, answer True. If you disagree or decide that it does not describe you,"
^YTT(601.712,17,1,24,0)=" answer False. Try to mark every statement, even if you are not sure of your"
^YTT(601.712,17,1,25,0)=" choice. If you have tried your best and still cannot decide, answer False. There"
^YTT(601.712,17,1,26,0)=" is no time limit for completing the inventory, but it is best to work as rapidly"
^YTT(601.712,17,1,27,0)=" as is comfortable for you."", "
^YTT(601.712,17,1,28,0)="    "
^YTT(601.712,17,1,29,0)="    ""choices"":["
^YTT(601.712,17,1,30,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,31,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,32,0)="   ]}, "
^YTT(601.712,17,1,33,0)="   {""id"": ""q1387"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,34,0)="    ""text"": ""2. I think highly of rules because they are a good guide to follow."", "
^YTT(601.712,17,1,35,0)="    "
^YTT(601.712,17,1,36,0)="    ""choices"":["
^YTT(601.712,17,1,37,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,38,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,39,0)="   ]}, "
^YTT(601.712,17,1,40,0)="   {""id"": ""q1388"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,41,0)="    ""text"": ""3. I enjoy doing so many different things that I can't make up my mind what to do"
^YTT(601.712,17,1,42,0)=" first."", "
^YTT(601.712,17,1,43,0)="    "
