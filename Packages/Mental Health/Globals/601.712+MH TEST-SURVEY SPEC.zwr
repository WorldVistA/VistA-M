^YTT(601.712,68,1,23,0)="     {""id"": ""c3009"", ""text"": ""1. Occasional accident (once per week)"", ""quickKey"": 1}, "
^YTT(601.712,68,1,24,0)="     {""id"": ""c3010"", ""text"": ""2. Continent"", ""quickKey"": 2}"
^YTT(601.712,68,1,25,0)="   ]}, "
^YTT(601.712,68,1,26,0)="   {""id"": ""q5674"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
