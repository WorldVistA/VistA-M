^YTT(601.712,72,1,57,0)="    ""legend"":[""Low agitation"", ""High agitation""]}, "
^YTT(601.712,72,1,58,0)="   {""id"": ""q6004"", ""type"": ""StringQuestion"", ""required"": false, "
^YTT(601.712,72,1,59,0)="    ""text"": ""3A). I most need to take action when:"", "
^YTT(601.712,72,1,60,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,61,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,62,0)=" five questions.  "", "
^YTT(601.712,72,1,63,0)="    ""controlWidth"": 520, ""min"": 0, ""max"": 0}, "
^YTT(601.712,72,1,64,0)="   {""id"": ""q6005"", ""type"": ""IntegerQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,72,1,65,0)="    ""text"": ""3B). Rank of importance:"", "
^YTT(601.712,72,1,66,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,67,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,68,0)=" five questions.  "", "
^YTT(601.712,72,1,69,0)="    ""controlWidth"": 50, ""min"": 1, ""max"": 5}, "
^YTT(601.712,72,1,70,0)="   {""id"": ""q6006"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,72,1,71,0)="    ""text"": ""4). RATE HOPELESSNESS (your expectation that things will not get better no matter"
^YTT(601.712,72,1,72,0)=" what you do):"", "
^YTT(601.712,72,1,73,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,74,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,75,0)=" five questions.  "", "
^YTT(601.712,72,1,76,0)="    ""min"": 1, ""max"": 5, "
^YTT(601.712,72,1,77,0)="    ""legend"":[""Low hopelessness"", "" High hopelessness""]}, "
^YTT(601.712,72,1,78,0)="   {""id"": ""q6007"", ""type"": ""StringQuestion"", ""required"": false, "
^YTT(601.712,72,1,79,0)="    ""text"": ""4A). I am most hopeless about:"", "
^YTT(601.712,72,1,80,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,81,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,82,0)=" five questions.  "", "
^YTT(601.712,72,1,83,0)="    ""controlWidth"": 520, ""min"": 0, ""max"": 0}, "
^YTT(601.712,72,1,84,0)="   {""id"": ""q6008"", ""type"": ""IntegerQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,72,1,85,0)="    ""text"": ""4B). Rank of importance:"", "
^YTT(601.712,72,1,86,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,87,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,88,0)=" five questions.  "", "
^YTT(601.712,72,1,89,0)="    ""controlWidth"": 50, ""min"": 1, ""max"": 5}, "
^YTT(601.712,72,1,90,0)="   {""id"": ""q6009"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,72,1,91,0)="    ""text"": ""5). RATE SELF-HATE (your general feeling of disliking yourself; having no"
^YTT(601.712,72,1,92,0)=" self-esteem; having no self-respect):"", "
^YTT(601.712,72,1,93,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,94,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,95,0)=" five questions.  "", "
^YTT(601.712,72,1,96,0)="    ""min"": 1, ""max"": 5, "
^YTT(601.712,72,1,97,0)="    ""legend"":[""Low self-hate"", ""High self-hate""]}, "
^YTT(601.712,72,1,98,0)="   {""id"": ""q6010"", ""type"": ""StringQuestion"", ""required"": false, "
^YTT(601.712,72,1,99,0)="    ""text"": ""5A). What I hate most about myself is:"", "
^YTT(601.712,72,1,100,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,101,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,102,0)=" five questions.  "", "
^YTT(601.712,72,1,103,0)="    ""controlWidth"": 520, ""min"": 0, ""max"": 0}, "
^YTT(601.712,72,1,104,0)="   {""id"": ""q6011"", ""type"": ""IntegerQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,72,1,105,0)="    ""text"": ""5B). Rank of importance:"", "
^YTT(601.712,72,1,106,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,107,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,108,0)=" five questions.  "", "
^YTT(601.712,72,1,109,0)="    ""controlWidth"": 50, ""min"": 1, ""max"": 5}, "
^YTT(601.712,72,1,110,0)="   {""id"": ""q6012"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,72,1,111,0)="    ""text"": ""6). RATE OVERALL RISK OF SUICIDE:"", "
^YTT(601.712,72,1,112,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,113,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,114,0)=" five questions.  "", "
