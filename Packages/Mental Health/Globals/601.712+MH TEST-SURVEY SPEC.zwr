^YTT(601.712,68,1,6,0)="   {""id"": ""i1047"", ""type"": ""IntroText"", "
^YTT(601.712,68,1,7,0)="    ""text"": ""Choose the scoring point for the statement that most closely corresponds to the"
^YTT(601.712,68,1,8,0)=" patient's current level of ability for each of the following 10 items. Record"
^YTT(601.712,68,1,9,0)=" actual, not potential, functioning.   Information can be obtained from the"
^YTT(601.712,68,1,10,0)=" patient's self-report, from a separate party who is familiar with the patient's"
^YTT(601.712,68,1,11,0)=" abilities (such as a relative), or from observation.  """
^YTT(601.712,68,1,12,0)="    }, "
^YTT(601.712,68,1,13,0)="   {""id"": ""q5673"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,68,1,14,0)="    ""text"": ""1. Bowels (preceding week):"", "
^YTT(601.712,68,1,15,0)="    ""intro"": ""Choose the scoring point for the statement that most closely corresponds to the"
^YTT(601.712,68,1,16,0)=" patient's current level of ability for each of the following 10 items. Record"
^YTT(601.712,68,1,17,0)=" actual, not potential, functioning.   Information can be obtained from the"
^YTT(601.712,68,1,18,0)=" patient's self-report, from a separate party who is familiar with the patient's"
^YTT(601.712,68,1,19,0)=" abilities (such as a relative), or from observation.  "", "
^YTT(601.712,68,1,20,0)="    ""columns"": 1, "
^YTT(601.712,68,1,21,0)="    ""choices"":["
