^YTT(601.712,12,1,4,0)=" ""printTitle"": ""Brief Symptom Inventory 18"","
^YTT(601.712,12,1,5,0)=" ""content"":["
^YTT(601.712,12,1,6,0)="   {""id"": ""i14"", ""type"": ""IntroText"", "
^YTT(601.712,12,1,7,0)="    ""text"": ""A list of problems people sometimes have will be presented. Read each one"
^YTT(601.712,12,1,8,0)=" carefully and select the answer that best describes HOW MUCH THAT PROBLEM HAS"
^YTT(601.712,12,1,9,0)=" DISTRESSED OR BOTHERED YOU DURING THE PAST 7 DAYS INCLUDING TODAY. Do not skip"
^YTT(601.712,12,1,10,0)=" any items."""
^YTT(601.712,12,1,11,0)="    }, "
^YTT(601.712,12,1,12,0)="   {""id"": ""q450"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,12,1,13,0)="    ""text"": ""1. HOW MUCH WERE YOU DISTRESSED BY: Faintness or dizziness"", "
^YTT(601.712,12,1,14,0)="    ""intro"": ""A list of problems people sometimes have will be presented. Read each one"
^YTT(601.712,12,1,15,0)=" carefully and select the answer that best describes HOW MUCH THAT PROBLEM HAS"
^YTT(601.712,12,1,16,0)=" DISTRESSED OR BOTHERED YOU DURING THE PAST 7 DAYS INCLUDING TODAY. Do not skip"
^YTT(601.712,12,1,17,0)=" any items."", "
^YTT(601.712,12,1,18,0)="    "
^YTT(601.712,12,1,19,0)="    ""choices"":["
^YTT(601.712,12,1,20,0)="     {""id"": ""c432"", ""text"": ""1. Not at all"", ""quickKey"": 1}, "
