^YTT(601.712,72,1,123,0)="    ""legend"":[""Not at all"", "" Completely""]}, "
^YTT(601.712,72,1,124,0)="   {""id"": ""q6014"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,72,1,125,0)="    ""text"": ""8). How much is being suicidal related to thoughts and feelings about others?"", "
^YTT(601.712,72,1,126,0)="    ""intro"": ""Rate and fill out each item according to how you feel right now. Then rank in"
^YTT(601.712,72,1,127,0)=" order of importance 1 to 5 (1 is most important, 5 is least important) the first"
^YTT(601.712,72,1,128,0)=" five questions.  "", "
^YTT(601.712,72,1,129,0)="    ""min"": 1, ""max"": 5, "
