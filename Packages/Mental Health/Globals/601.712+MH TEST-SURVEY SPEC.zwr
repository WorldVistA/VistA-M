^YTT(601.712,179,1,21,0)="    ""choices"":["
^YTT(601.712,179,1,22,0)="     {""id"": ""c5764"", ""text"": ""0. Not at all"", ""quickKey"": 0}, "
^YTT(601.712,179,1,23,0)="     {""id"": ""c5765"", ""text"": ""1. A little bit"", ""quickKey"": 1}, "
^YTT(601.712,179,1,24,0)="     {""id"": ""c5766"", ""text"": ""2. Moderately"", ""quickKey"": 2}, "
