^YTT(601.712,179,1,5,0)=" ""content"":["
^YTT(601.712,179,1,6,0)="   {""id"": ""i2552"", ""type"": ""IntroText"", "
^YTT(601.712,179,1,7,0)="    ""text"": ""Instructions: Below is a list of problems that people sometimes have in response"
^YTT(601.712,179,1,8,0)=" to a very stressful experience. Please read each problem and then select one of"
^YTT(601.712,179,1,9,0)=" the options to indicate how much you have been bothered by that problem in the"
^YTT(601.712,179,1,10,0)=" past day. The options include not at all, a little bit, moderately, quite a bit,"
^YTT(601.712,179,1,11,0)=" and extremely. <br /><br />In the past day, how much were you bothered by:"""
^YTT(601.712,179,1,12,0)="    }, "
^YTT(601.712,179,1,13,0)="   {""id"": ""q9230"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,179,1,14,0)="    ""text"": ""1. Repeated, disturbing, and unwanted memories of the stressful experience?"", "
