^YTT(601.712,67,1,98,0)="   {""id"": ""i1234"", ""type"": ""IntroText"", "
^YTT(601.712,67,1,99,0)="    ""text"": ""Read list of words to be recalled.<br /><br />5. Attention  """
^YTT(601.712,67,1,100,0)="    }, "
^YTT(601.712,67,1,101,0)="   {""id"": ""q5652"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,102,0)="    ""text"": ""5A. Forward Digit Span."", "
^YTT(601.712,67,1,103,0)="    ""intro"": ""Read list of words to be recalled.<br /><br />5. Attention  "", "
^YTT(601.712,67,1,104,0)="    ""columns"": 2, "
^YTT(601.712,67,1,105,0)="    ""choices"":["
^YTT(601.712,67,1,106,0)="     {""id"": ""c2956"", ""text"": ""1. Correct forward digit span"", ""quickKey"": 1}, "
^YTT(601.712,67,1,107,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,108,0)="   ]}, "
^YTT(601.712,67,1,109,0)="   {""id"": ""q5653"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,110,0)="    ""text"": ""5B. Backward Digit Span. Correct response for the backwards trial is 4-7-1."", "
^YTT(601.712,67,1,111,0)="    ""intro"": ""Read list of words to be recalled.<br /><br />5. Attention  "", "
^YTT(601.712,67,1,112,0)="    ""columns"": 2, "
^YTT(601.712,67,1,113,0)="    ""choices"":["
^YTT(601.712,67,1,114,0)="     {""id"": ""c2957"", ""text"": ""1. Correct backward digit span"", ""quickKey"": 1}, "
^YTT(601.712,67,1,115,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,116,0)="   ]}, "
^YTT(601.712,67,1,117,0)="   {""id"": ""q5654"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,118,0)="    ""text"": ""5C. Vigilance. Correct when there is zero to one errors (an error is a tap on a"
^YTT(601.712,67,1,119,0)=" wrong letter or a failure to tap on letter A)."", "
^YTT(601.712,67,1,120,0)="    ""intro"": ""Read list of words to be recalled.<br /><br />5. Attention  "", "
^YTT(601.712,67,1,121,0)="    ""columns"": 2, "
^YTT(601.712,67,1,122,0)="    ""choices"":["
^YTT(601.712,67,1,123,0)="     {""id"": ""c2958"", ""text"": ""1. Correct vigilance"", ""quickKey"": 1}, "
^YTT(601.712,67,1,124,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,125,0)="   ]}, "
^YTT(601.712,67,1,126,0)="   {""id"": ""q5655"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,67,1,127,0)="    ""text"": ""5D. Serial 7s starting at 80. Continue for five responses."", "
^YTT(601.712,67,1,128,0)="    ""intro"": ""Read list of words to be recalled.<br /><br />5. Attention  "", "
^YTT(601.712,67,1,129,0)="    ""columns"": 1, "
^YTT(601.712,67,1,130,0)="    ""choices"":["
^YTT(601.712,67,1,131,0)="     {""id"": ""c3165"", ""text"": ""0. No correct subtractions"", ""quickKey"": 0}, "
^YTT(601.712,67,1,132,0)="     {""id"": ""c3166"", ""text"": ""1. One correct subtraction"", ""quickKey"": 1}, "
^YTT(601.712,67,1,133,0)="     {""id"": ""c3167"", ""text"": ""2. Two or three correct subtractions"", ""quickKey"": 2}, "
^YTT(601.712,67,1,134,0)="     {""id"": ""c3168"", ""text"": ""3. No errors or four or more correct subtractions"", ""quickKey"": 3}"
^YTT(601.712,67,1,135,0)="   ]}, "
^YTT(601.712,67,1,136,0)="   {""id"": ""i1235"", ""type"": ""IntroText"", "
^YTT(601.712,67,1,137,0)="    ""text"": ""6. Language  """
^YTT(601.712,67,1,138,0)="    }, "
