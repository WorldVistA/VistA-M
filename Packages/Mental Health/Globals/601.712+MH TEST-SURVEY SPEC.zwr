^YTT(601.712,67,1,146,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,147,0)="   ]}, "
^YTT(601.712,67,1,148,0)="   {""id"": ""q5657"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,149,0)="    ""text"": ""6B. Sentence repetition. The little girls who were given too much candy got"
^YTT(601.712,67,1,150,0)=" stomach aches."", "
