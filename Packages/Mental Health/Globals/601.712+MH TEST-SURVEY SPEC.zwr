^YTT(601.712,11,1,5,0)=" ""printTitle"": ""Beck Scale for Suicide Ideation"","
^YTT(601.712,11,1,6,0)=" ""content"":["
^YTT(601.712,11,1,7,0)="   {""id"": ""q429"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,8,0)="    ""text"": ""1. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,9,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,10,0)="    "
^YTT(601.712,11,1,11,0)="    ""choices"":["
^YTT(601.712,11,1,12,0)="     {""id"": ""c621"", ""text"": ""0. I have a moderate to strong wish to live."", ""quickKey"": 0}, "
^YTT(601.712,11,1,13,0)="     {""id"": ""c622"", ""text"": ""1. I have a weak wish to live."", ""quickKey"": 1}, "
^YTT(601.712,11,1,14,0)="     {""id"": ""c623"", ""text"": ""2. I have no wish to live."", ""quickKey"": 2}"
^YTT(601.712,11,1,15,0)="   ]}, "
^YTT(601.712,11,1,16,0)="   {""id"": ""q430"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,17,0)="    ""text"": ""2. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,18,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,19,0)="    "
^YTT(601.712,11,1,20,0)="    ""choices"":["
^YTT(601.712,11,1,21,0)="     {""id"": ""c624"", ""text"": ""0. I have no wish to die."", ""quickKey"": 0}, "
^YTT(601.712,11,1,22,0)="     {""id"": ""c625"", ""text"": ""1. I have a weak wish to die."", ""quickKey"": 1}, "
^YTT(601.712,11,1,23,0)="     {""id"": ""c626"", ""text"": ""2. I have a moderate to strong wish to die."", ""quickKey"": 2}"
^YTT(601.712,11,1,24,0)="   ]}, "
^YTT(601.712,11,1,25,0)="   {""id"": ""q431"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,26,0)="    ""text"": ""3. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,27,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,28,0)="    "
^YTT(601.712,11,1,29,0)="    ""choices"":["
^YTT(601.712,11,1,30,0)="     {""id"": ""c627"", ""text"": ""0. My reasons for living outweigh my reasons for dying."", ""quickKey"": 0}, "
^YTT(601.712,11,1,31,0)="     {""id"": ""c628"", ""text"": ""1. My reasons for living or dying are about equal."", ""quickKey"": 1}, "
^YTT(601.712,11,1,32,0)="     {""id"": ""c629"", ""text"": ""2. My reasons for dying outweigh my reasons for living."", ""quickKey"": 2}"
^YTT(601.712,11,1,33,0)="   ]}, "
^YTT(601.712,11,1,34,0)="   {""id"": ""q432"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,35,0)="    ""text"": ""4. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,36,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,37,0)="    "
^YTT(601.712,11,1,38,0)="    ""choices"":["
^YTT(601.712,11,1,39,0)="     {""id"": ""c630"", ""text"": ""0. I have no desire to kill myself."", ""quickKey"": 0}, "
^YTT(601.712,11,1,40,0)="     {""id"": ""c631"", ""text"": ""1. I have a weak desire to kill myself."", ""quickKey"": 1}, "
^YTT(601.712,11,1,41,0)="     {""id"": ""c632"", ""text"": ""2. I have a moderate to strong desire to kill myself."", ""quickKey"": 2}"
^YTT(601.712,11,1,42,0)="   ]}, "
^YTT(601.712,11,1,43,0)="   {""id"": ""q433"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,44,0)="    ""text"": ""5. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,45,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,46,0)="    "
^YTT(601.712,11,1,47,0)="    ""choices"":["
^YTT(601.712,11,1,48,0)="     {""id"": ""c633"", ""text"": ""0. I would try to save my life if I found myself in a life-threatening situation."", ""quickKey"": 0}, "
^YTT(601.712,11,1,49,0)="     {""id"": ""c634"", ""text"": ""1. I would take a chance on life or death if I found myself in a life-threatening"
^YTT(601.712,11,1,50,0)=" situation."", ""quickKey"": 1}, "
^YTT(601.712,11,1,51,0)="     {""id"": ""c635"", ""text"": ""2. I would not take the steps necessary to avoid death if I found myself in a"
^YTT(601.712,11,1,52,0)=" life-threatening situation."", ""quickKey"": 2}"
^YTT(601.712,11,1,53,0)="   ]}, "
^YTT(601.712,11,1,54,0)="   {""id"": ""q434"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,55,0)="    ""text"": ""6. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,56,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,57,0)="    "
^YTT(601.712,11,1,58,0)="    ""choices"":["
^YTT(601.712,11,1,59,0)="     {""id"": ""c636"", ""text"": ""0. I have brief periods of thinking about killing myself which pass quickly."", ""quickKey"": 0}, "
^YTT(601.712,11,1,60,0)="     {""id"": ""c637"", ""text"": ""1. I have periods of thinking about killing myself which last for moderate"
^YTT(601.712,11,1,61,0)=" amounts of time."", ""quickKey"": 1}, "
^YTT(601.712,11,1,62,0)="     {""id"": ""c638"", ""text"": ""2. I have long periods of thinking about killing myself."", ""quickKey"": 2}"
^YTT(601.712,11,1,63,0)="   ]}, "
^YTT(601.712,11,1,64,0)="   {""id"": ""q435"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,65,0)="    ""text"": ""7. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,66,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,67,0)="    "
^YTT(601.712,11,1,68,0)="    ""choices"":["
^YTT(601.712,11,1,69,0)="     {""id"": ""c639"", ""text"": ""0. I rarely or only occasionally think about killing myself."", ""quickKey"": 0}, "
^YTT(601.712,11,1,70,0)="     {""id"": ""c640"", ""text"": ""1. I have frequent thoughts about killing myself."", ""quickKey"": 1}, "
^YTT(601.712,11,1,71,0)="     {""id"": ""c641"", ""text"": ""2. I continuously think about killing myself."", ""quickKey"": 2}"
^YTT(601.712,11,1,72,0)="   ]}, "
^YTT(601.712,11,1,73,0)="   {""id"": ""q436"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,74,0)="    ""text"": ""8. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,75,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,76,0)="    "
^YTT(601.712,11,1,77,0)="    ""choices"":["
^YTT(601.712,11,1,78,0)="     {""id"": ""c642"", ""text"": ""0. I do not accept the idea of killing myself."", ""quickKey"": 0}, "
^YTT(601.712,11,1,79,0)="     {""id"": ""c643"", ""text"": ""1. I neither accept nor reject the idea of killing myself."", ""quickKey"": 1}, "
^YTT(601.712,11,1,80,0)="     {""id"": ""c644"", ""text"": ""2. I accept the idea of killing myself."", ""quickKey"": 2}"
^YTT(601.712,11,1,81,0)="   ]}, "
^YTT(601.712,11,1,82,0)="   {""id"": ""q437"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,83,0)="    ""text"": ""9. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,84,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,85,0)="    "
^YTT(601.712,11,1,86,0)="    ""choices"":["
^YTT(601.712,11,1,87,0)="     {""id"": ""c645"", ""text"": ""0. I can keep myself from committing suicide."", ""quickKey"": 0}, "
^YTT(601.712,11,1,88,0)="     {""id"": ""c646"", ""text"": ""1. I am unsure that I can keep myself from committing suicide."", ""quickKey"": 1}, "
^YTT(601.712,11,1,89,0)="     {""id"": ""c647"", ""text"": ""2. I cannot keep myself from committing suicide."", ""quickKey"": 2}"
^YTT(601.712,11,1,90,0)="   ]}, "
^YTT(601.712,11,1,91,0)="   {""id"": ""q438"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,92,0)="    ""text"": ""10. Select the one statement in each group that BEST describes how you have been"
