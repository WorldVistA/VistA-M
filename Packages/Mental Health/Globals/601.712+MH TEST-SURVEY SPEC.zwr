^YTT(601.712,11,1,188,0)="    "
^YTT(601.712,11,1,189,0)="    ""choices"":["
^YTT(601.712,11,1,190,0)="     {""id"": ""c675"", ""text"": ""0. I have not hidden my desire to kill myself from people."", ""quickKey"": 0}, "
