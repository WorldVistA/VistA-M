^YTT(601.712,16,1,299,0)="   ]}, "
^YTT(601.712,16,1,300,0)="   {""id"": ""q1082"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,301,0)="    ""text"": ""37. I guess I've always been a fearful and inhibited person."", "
^YTT(601.712,16,1,302,0)="    ""intro"": ""Please read each item carefully and answer each question as it pertains to you."", "
^YTT(601.712,16,1,303,0)="    ""columns"": 1, "
