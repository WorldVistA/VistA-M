^YTT(601.712,16,1,437,0)="   ]}, "
^YTT(601.712,16,1,438,0)="   {""id"": ""q1099"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,439,0)="    ""text"": ""54. Very few people appreciate just how hard my life really is."", "
