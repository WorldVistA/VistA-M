^YTT(601.712,123,1,6,0)=" ""content"":["
^YTT(601.712,123,1,7,0)="   {""id"": ""i2404"", ""type"": ""IntroText"", "
^YTT(601.712,123,1,8,0)="    ""text"": ""Instructions: Below are some statements about feelings and thoughts. <br />Please"
^YTT(601.712,123,1,9,0)=" select the response that best describes your experience of each over the last 2"
^YTT(601.712,123,1,10,0)=" weeks."""
^YTT(601.712,123,1,11,0)="    }, "
^YTT(601.712,123,1,12,0)="   {""id"": ""q8403"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,123,1,13,0)="    ""text"": ""1. I've been feeling optimistic about the future."", "
^YTT(601.712,123,1,14,0)="    ""intro"": ""Instructions: Below are some statements about feelings and thoughts. <br />Please"
^YTT(601.712,123,1,15,0)=" select the response that best describes your experience of each over the last 2"
^YTT(601.712,123,1,16,0)=" weeks."", "
^YTT(601.712,123,1,17,0)="    ""columns"": 1, "
^YTT(601.712,123,1,18,0)="    ""choices"":["
^YTT(601.712,123,1,19,0)="     {""id"": ""c4917"", ""text"": ""1. None of the time"", ""quickKey"": 1}, "
^YTT(601.712,123,1,20,0)="     {""id"": ""c4918"", ""text"": ""2. Rarely"", ""quickKey"": 2}, "
^YTT(601.712,123,1,21,0)="     {""id"": ""c4919"", ""text"": ""3. Some of the time"", ""quickKey"": 3}, "
^YTT(601.712,123,1,22,0)="     {""id"": ""c4920"", ""text"": ""4. Often"", ""quickKey"": 4}, "
^YTT(601.712,123,1,23,0)="     {""id"": ""c4921"", ""text"": ""5. All of the time"", ""quickKey"": 5}"
^YTT(601.712,123,1,24,0)="   ]}, "
^YTT(601.712,123,1,25,0)="   {""id"": ""q8404"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,123,1,26,0)="    ""text"": ""2. I've been feeling useful."", "
