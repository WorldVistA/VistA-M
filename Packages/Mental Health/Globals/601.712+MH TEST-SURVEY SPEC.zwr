^YTT(601.712,173,1,1,0)="{""name"": ""PSEQ-2"", "
^YTT(601.712,173,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,173,1,3,0)=" ""printTitle"": ""Pain Self-Efficacy Questionnaire-2"", "
^YTT(601.712,173,1,4,0)=" ""content"":["
^YTT(601.712,173,1,5,0)="   {""id"": ""i2535"", ""type"": ""IntroText"", "
^YTT(601.712,173,1,6,0)="    ""text"": ""Please rate how <strong>confident</strong> you are that you can do the following things <u>at present</u>,"
^YTT(601.712,173,1,7,0)=" <strong>despite the pain</strong>, where 0 = not at all confident and 6 = completely confident."
^YTT(601.712,173,1,8,0)=" Remember, these questions are not asking whether or not you have been doing"
^YTT(601.712,173,1,9,0)=" these things, but rather <strong>how confident you are that you can do them at present,"
^YTT(601.712,173,1,10,0)=" <u>despite the pain</u></strong>."""
^YTT(601.712,173,1,11,0)="    }, "
^YTT(601.712,173,1,12,0)="   {""id"": ""q9174"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,173,1,13,0)="    ""text"": ""1. I can do some form of work, despite the pain ('work' includes housework, paid"
^YTT(601.712,173,1,14,0)=" and unpaid work)."", "
^YTT(601.712,173,1,15,0)="    ""intro"": ""Please rate how <strong>confident</strong> you are that you can do the following things <u>at present</u>,"
^YTT(601.712,173,1,16,0)=" <strong>despite the pain</strong>, where 0 = not at all confident and 6 = completely confident."
^YTT(601.712,173,1,17,0)=" Remember, these questions are not asking whether or not you have been doing"
^YTT(601.712,173,1,18,0)=" these things, but rather <strong>how confident you are that you can do them at present,"
^YTT(601.712,173,1,19,0)=" <u>despite the pain</u></strong>."","
^YTT(601.712,173,1,20,0)="    ""min"": 0, ""max"": 6, "
^YTT(601.712,173,1,21,0)="    ""legend"":[""Not at all confident"", ""Completely confident""]}, "
^YTT(601.712,173,1,22,0)="   {""id"": ""q9175"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,173,1,23,0)="    ""text"": ""2. I can live a normal lifestyle, despite the pain."", "
^YTT(601.712,173,1,24,0)="    ""intro"": ""Please rate how <strong>confident</strong> you are that you can do the following things <u>at present</u>,"
^YTT(601.712,173,1,25,0)=" <strong>despite the pain</strong>, where 0 = not at all confident and 6 = completely confident."
^YTT(601.712,173,1,26,0)=" Remember, these questions are not asking whether or not you have been doing"
^YTT(601.712,173,1,27,0)=" these things, but rather <strong>how confident you are that you can do them at present,"
^YTT(601.712,173,1,28,0)=" <u>despite the pain</u></strong>."","
^YTT(601.712,173,1,29,0)="    ""min"": 0, ""max"": 6, "
^YTT(601.712,173,1,30,0)="    ""legend"":[""Not at all confident"", ""Completely confident""]}]"
^YTT(601.712,173,1,31,0)="}"
^YTT(601.712,174,0)="321^3230906.172803^4049940015"
^YTT(601.712,174,1,0)="^^453^453^3231227"
^YTT(601.712,174,1,1,0)="{""name"": ""NPI-Q"", "
^YTT(601.712,174,1,2,0)=" ""copyright"": ""JL Cummings, 1994; all rights reserved"", "
^YTT(601.712,174,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,174,1,4,0)=" ""printTitle"": ""Neuropsychiatric Inventory - Questionnaire"", "
^YTT(601.712,174,1,5,0)=" ""content"":["
^YTT(601.712,174,1,6,0)="   {""id"": ""i2536"", ""type"": ""IntroText"", "
^YTT(601.712,174,1,7,0)="    ""text"": ""Please answer the following questions based on changes that have occurred since"
^YTT(601.712,174,1,8,0)=" the patient first began to experience memory problems.<br /><strong>Select \u0022Yes\u0022"
^YTT(601.712,174,1,9,0)=" <u>only</u> if the symptom(s) has been present <u>in the last month</u>. Otherwise, select"
^YTT(601.712,174,1,10,0)=" \u0022No\u0022. For each item marked \u0022Yes\u0022:<br /><br />a) Rate the"
^YTT(601.712,174,1,11,0)=" SEVERITY of the symptom (how it affects <u>the patient</u>).<br />b) Rate the DISTRESS"
^YTT(601.712,174,1,12,0)=" you experience due to that symptom (how it affects <u>you</u>).</strong><br /><br />Please"
^YTT(601.712,174,1,13,0)=" answer each question carefully. Ask for assistance if you have any questions.<br"
^YTT(601.712,174,1,14,0)=" /><br />Delusions"""
^YTT(601.712,174,1,15,0)="    }, "
^YTT(601.712,174,1,16,0)="   {""id"": ""q9176"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,174,1,17,0)="    ""text"": ""1a. Does the patient have false beliefs, such as thinking that others are"
^YTT(601.712,174,1,18,0)=" stealing from him/her or planning to harm him/her in some way?"", "
^YTT(601.712,174,1,19,0)="    ""intro"": ""Please answer the following questions based on changes that have occurred since"
^YTT(601.712,174,1,20,0)=" the patient first began to experience memory problems.<br /><strong>Select \u0022Yes\u0022"
^YTT(601.712,174,1,21,0)=" <u>only</u> if the symptom(s) has been present <u>in the last month</u>. Otherwise, select"
^YTT(601.712,174,1,22,0)=" \u0022No\u0022. For each item marked \u0022Yes\u0022:<br /><br />a) Rate the"
^YTT(601.712,174,1,23,0)=" SEVERITY of the symptom (how it affects <u>the patient</u>).<br />b) Rate the DISTRESS"
^YTT(601.712,174,1,24,0)=" you experience due to that symptom (how it affects <u>you</u>).</strong><br /><br />Please"
^YTT(601.712,174,1,25,0)=" answer each question carefully. Ask for assistance if you have any questions.<br"
^YTT(601.712,174,1,26,0)=" /><br />Delusions"","
^YTT(601.712,174,1,27,0)="    ""columns"": 3, "
^YTT(601.712,174,1,28,0)="    ""choices"":["
^YTT(601.712,174,1,29,0)="     {""id"": ""c5690"", ""text"": ""1. Yes"", ""quickKey"": 1}, "
^YTT(601.712,174,1,30,0)="     {""id"": ""c5691"", ""text"": ""2. No"", ""quickKey"": 2}"
^YTT(601.712,174,1,31,0)="   ]}, "
^YTT(601.712,174,1,32,0)="   {""id"": ""q9177"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,174,1,33,0)="    ""text"": ""1b. Delusions - SEVERITY"", "
^YTT(601.712,174,1,34,0)="    ""intro"": ""Please answer the following questions based on changes that have occurred since"
^YTT(601.712,174,1,35,0)=" the patient first began to experience memory problems.<br /><strong>Select \u0022Yes\u0022"
^YTT(601.712,174,1,36,0)=" <u>only</u> if the symptom(s) has been present <u>in the last month</u>. Otherwise, select"
^YTT(601.712,174,1,37,0)=" \u0022No\u0022. For each item marked \u0022Yes\u0022:<br /><br />a) Rate the"
^YTT(601.712,174,1,38,0)=" SEVERITY of the symptom (how it affects <u>the patient</u>).<br />b) Rate the DISTRESS"
^YTT(601.712,174,1,39,0)=" you experience due to that symptom (how it affects <u>you</u>).</strong><br /><br />Please"
^YTT(601.712,174,1,40,0)=" answer each question carefully. Ask for assistance if you have any questions.<br"
^YTT(601.712,174,1,41,0)=" /><br />Delusions"","
^YTT(601.712,174,1,42,0)="    ""columns"": 1, "
^YTT(601.712,174,1,43,0)="    ""choices"":["
^YTT(601.712,174,1,44,0)="     {""id"": ""c5692"", ""text"": ""1. Mild (noticeable, but not a significant change)"", ""quickKey"": 1}, "
^YTT(601.712,174,1,45,0)="     {""id"": ""c5693"", ""text"": ""2. Moderate (significant, but not a dramatic change)"", ""quickKey"": 2}, "
^YTT(601.712,174,1,46,0)="     {""id"": ""c5694"", ""text"": ""3. Severe (very marked or prominent, a dramatic change)"", ""quickKey"": 3}"
^YTT(601.712,174,1,47,0)="   ]}, "
^YTT(601.712,174,1,48,0)="   {""id"": ""q9178"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,174,1,49,0)="    ""text"": ""1c. Delusions - DISTRESS"", "
^YTT(601.712,174,1,50,0)="    ""intro"": ""Please answer the following questions based on changes that have occurred since"
^YTT(601.712,174,1,51,0)=" the patient first began to experience memory problems.<br /><strong>Select \u0022Yes\u0022"
^YTT(601.712,174,1,52,0)=" <u>only</u> if the symptom(s) has been present <u>in the last month</u>. Otherwise, select"
^YTT(601.712,174,1,53,0)=" \u0022No\u0022. For each item marked \u0022Yes\u0022:<br /><br />a) Rate the"
^YTT(601.712,174,1,54,0)=" SEVERITY of the symptom (how it affects <u>the patient</u>).<br />b) Rate the DISTRESS"
^YTT(601.712,174,1,55,0)=" you experience due to that symptom (how it affects <u>you</u>).</strong><br /><br />Please"
^YTT(601.712,174,1,56,0)=" answer each question carefully. Ask for assistance if you have any questions.<br"
^YTT(601.712,174,1,57,0)=" /><br />Delusions"","
^YTT(601.712,174,1,58,0)="    ""columns"": 1, "
^YTT(601.712,174,1,59,0)="    ""choices"":["
^YTT(601.712,174,1,60,0)="     {""id"": ""c5695"", ""text"": ""0. Not distressing at all"", ""quickKey"": 0}, "
^YTT(601.712,174,1,61,0)="     {""id"": ""c5696"", ""text"": ""1. Minimal (slightly distressing, not a problem to cope with)"", ""quickKey"": 1}, "
^YTT(601.712,174,1,62,0)="     {""id"": ""c5697"", ""text"": ""2. Mild (not very distressing, generally easy to cope with)"", ""quickKey"": 2}, "
^YTT(601.712,174,1,63,0)="     {""id"": ""c5698"", ""text"": ""3. Moderate (fairly distressing, not always easy to cope with)"", ""quickKey"": 3}, "
^YTT(601.712,174,1,64,0)="     {""id"": ""c5699"", ""text"": ""4. Severe (very distressing, difficult to cope with)"", ""quickKey"": 4}, "
^YTT(601.712,174,1,65,0)="     {""id"": ""c5700"", ""text"": ""5. Extreme or Very Severe (extremely distressing, unable to cope with)"", ""quickKey"": 5}"
^YTT(601.712,174,1,66,0)="   ]}, "
^YTT(601.712,174,1,67,0)="   {""id"": ""i2537"", ""type"": ""IntroText"", "
^YTT(601.712,174,1,68,0)="    ""text"": ""Hallucinations"""
^YTT(601.712,174,1,69,0)="    }, "
