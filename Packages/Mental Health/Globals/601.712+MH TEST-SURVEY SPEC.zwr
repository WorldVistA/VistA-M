^YTT(601.712,28,1,106,0)="   ]}, "
^YTT(601.712,28,1,107,0)="   {""id"": ""q4040"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,108,0)="    ""text"": ""8. Tremor: Observation of outstretched hands."", "
