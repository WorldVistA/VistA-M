^YTT(601.712,169,1,16,0)="   {""id"": ""i1096"", ""type"": ""IntroText"", "
^YTT(601.712,169,1,17,0)="    ""text"": ""Instructions<br />This is a standard set of questions about several areas of your"
^YTT(601.712,169,1,18,0)=" life such as your health, alcohol and drug use, etc. The questions generally ask"
^YTT(601.712,169,1,19,0)=" about the past 30 days. Please consider each question and answer as accurately"
^YTT(601.712,169,1,20,0)=" as possible.<br />  """
^YTT(601.712,169,1,21,0)="    }, "
^YTT(601.712,169,1,22,0)="   {""id"": ""q9106"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,169,1,23,0)="    ""text"": ""1. In the past 30 days, how would you say your physical health has been?"", "
