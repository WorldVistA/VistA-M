^YTT(601.712,34,1,1,0)="{""name"": ""KATZ-ADL-18PT"", "
^YTT(601.712,34,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,34,1,3,0)=" ""printTitle"": ""Katz Index of Independence in Activities of Daily Living"","
^YTT(601.712,34,1,4,0)=" ""content"":["
^YTT(601.712,34,1,5,0)="   {""id"": ""i1040"", ""type"": ""IntroText"", "
^YTT(601.712,34,1,6,0)="    ""text"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,7,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,8,0)=" assistance.)"""
^YTT(601.712,34,1,9,0)="    }, "
^YTT(601.712,34,1,10,0)="   {""id"": ""q5132"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,34,1,11,0)="    ""text"": ""1. Bathing: either sponge bath, tub bath or shower."", "
^YTT(601.712,34,1,12,0)="    ""intro"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,13,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,14,0)=" assistance.)"", "
^YTT(601.712,34,1,15,0)="    ""columns"": 1, "
^YTT(601.712,34,1,16,0)="    ""choices"":["
^YTT(601.712,34,1,17,0)="     {""id"": ""c2886"", ""text"": ""1. Receives no assistance (gets in and out of tub by self, if tub is usual means"
^YTT(601.712,34,1,18,0)=" of bathing)."", ""quickKey"": 1}, "
^YTT(601.712,34,1,19,0)="     {""id"": ""c2516"", ""text"": ""2. Receives assistance in bathing only one part of body (such as back or leg)."", ""quickKey"": 2}, "
^YTT(601.712,34,1,20,0)="     {""id"": ""c2517"", ""text"": ""3. Receives assistance in bathing more than one part of the body (or not bathed)."", ""quickKey"": 3}"
^YTT(601.712,34,1,21,0)="   ]}, "
^YTT(601.712,34,1,22,0)="   {""id"": ""q5133"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,34,1,23,0)="    ""text"": ""2. Dressing: gets clothes from closets and drawers, including under-clothes,"
^YTT(601.712,34,1,24,0)=" outer garments and using fasteners (including braces if worn)."", "
^YTT(601.712,34,1,25,0)="    ""intro"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,26,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,27,0)=" assistance.)"", "
^YTT(601.712,34,1,28,0)="    ""columns"": 1, "
^YTT(601.712,34,1,29,0)="    ""choices"":["
^YTT(601.712,34,1,30,0)="     {""id"": ""c2518"", ""text"": ""1. Gets clothes and dresses self without assistance."", ""quickKey"": 1}, "
^YTT(601.712,34,1,31,0)="     {""id"": ""c2519"", ""text"": ""2. Gets clothes and dresses self without assistance except for tying shoes."", ""quickKey"": 2}, "
^YTT(601.712,34,1,32,0)="     {""id"": ""c2887"", ""text"": ""3. Receives assistance in getting clothes, or dressing, or stays partly or"
^YTT(601.712,34,1,33,0)=" completely undressed."", ""quickKey"": 3}"
^YTT(601.712,34,1,34,0)="   ]}, "
^YTT(601.712,34,1,35,0)="   {""id"": ""q5134"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,34,1,36,0)="    ""text"": ""3. Toileting: going to the \u0022toilet room\u0022 for bowel and urine"
^YTT(601.712,34,1,37,0)=" elimination; cleaning self after elimination and arranging clothes. (May use"
^YTT(601.712,34,1,38,0)=" cane, walker, or wheelchair, and manage bedpan or commode, emptying same next"
^YTT(601.712,34,1,39,0)=" morning)."", "
^YTT(601.712,34,1,40,0)="    ""intro"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,41,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,42,0)=" assistance.)"", "
^YTT(601.712,34,1,43,0)="    ""columns"": 1, "
^YTT(601.712,34,1,44,0)="    ""choices"":["
^YTT(601.712,34,1,45,0)="     {""id"": ""c2900"", ""text"": ""1. No assistance needed."", ""quickKey"": 1}, "
^YTT(601.712,34,1,46,0)="     {""id"": ""c2901"", ""text"": ""2. Receives assistance with at least one procedure above."", ""quickKey"": 2}, "
^YTT(601.712,34,1,47,0)="     {""id"": ""c2890"", ""text"": ""3. Does not go to \u0022toilet room\u0022 for elimination procedure."", ""quickKey"": 3}"
^YTT(601.712,34,1,48,0)="   ]}, "
^YTT(601.712,34,1,49,0)="   {""id"": ""q5135"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,34,1,50,0)="    ""text"": ""4. Transfer:"", "
^YTT(601.712,34,1,51,0)="    ""intro"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,52,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,53,0)=" assistance.)"", "
^YTT(601.712,34,1,54,0)="    ""columns"": 1, "
^YTT(601.712,34,1,55,0)="    ""choices"":["
^YTT(601.712,34,1,56,0)="     {""id"": ""c2891"", ""text"": ""1. Moves in and out of bed, or chair, without assistance (may use support object"
^YTT(601.712,34,1,57,0)=" like cane or walker)."", ""quickKey"": 1}, "
^YTT(601.712,34,1,58,0)="     {""id"": ""c2892"", ""text"": ""2. Moves in and out of bed with assistance."", ""quickKey"": 2}, "
^YTT(601.712,34,1,59,0)="     {""id"": ""c2526"", ""text"": ""3. Does not get out of bed."", ""quickKey"": 3}"
^YTT(601.712,34,1,60,0)="   ]}, "
^YTT(601.712,34,1,61,0)="   {""id"": ""q5136"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,34,1,62,0)="    ""text"": ""5. Continence:"", "
^YTT(601.712,34,1,63,0)="    ""intro"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,64,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,65,0)=" assistance.)"", "
^YTT(601.712,34,1,66,0)="    ""columns"": 1, "
^YTT(601.712,34,1,67,0)="    ""choices"":["
^YTT(601.712,34,1,68,0)="     {""id"": ""c2527"", ""text"": ""1. Controls urination and bowel movement completely by self."", ""quickKey"": 1}, "
^YTT(601.712,34,1,69,0)="     {""id"": ""c2893"", ""text"": ""2. Has occasional \u0022accidents\u0022 of urination or bowels."", ""quickKey"": 2}, "
^YTT(601.712,34,1,70,0)="     {""id"": ""c2529"", ""text"": ""3. Supervision helps keep urine or bowel control: catheter is used or is"
^YTT(601.712,34,1,71,0)=" incontinent."", ""quickKey"": 3}"
^YTT(601.712,34,1,72,0)="   ]}, "
^YTT(601.712,34,1,73,0)="   {""id"": ""q5137"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,34,1,74,0)="    ""text"": ""6. Feeding:"", "
^YTT(601.712,34,1,75,0)="    ""intro"": ""For each area of functioning listed below, check description that applies. (The"
^YTT(601.712,34,1,76,0)=" word \u0022assistance\u0022 means supervision, direction of personal"
^YTT(601.712,34,1,77,0)=" assistance.)"", "
^YTT(601.712,34,1,78,0)="    ""columns"": 1, "
^YTT(601.712,34,1,79,0)="    ""choices"":["
^YTT(601.712,34,1,80,0)="     {""id"": ""c2530"", ""text"": ""1. Feeds self without assistance."", ""quickKey"": 1}, "
^YTT(601.712,34,1,81,0)="     {""id"": ""c2894"", ""text"": ""2. Feed self except for geting assistance in cutting meat or buttering bread."", ""quickKey"": 2}, "
^YTT(601.712,34,1,82,0)="     {""id"": ""c2895"", ""text"": ""3. Receives assistance in feeding, or, is fed partly or completely by tubes or"
^YTT(601.712,34,1,83,0)=" intravenous."", ""quickKey"": 3}"
^YTT(601.712,34,1,84,0)="   ]}]"
^YTT(601.712,34,1,85,0)="}"
