^YTT(601.712,16,1,1220,0)="   {""id"": ""q1196"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,1221,0)="    ""text"": ""151. Members of my family have complained recently about my drinking."", "
