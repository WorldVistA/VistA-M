^YTT(601.712,74,1,7,0)="    ""text"": ""HEALTH is being physically fit, not sick, and without pain or disability.  """
^YTT(601.712,74,1,8,0)="    }, "
^YTT(601.712,74,1,9,0)="   {""id"": ""q6367"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,74,1,10,0)="    ""text"": ""1. How important is HEALTH to your happiness?"", "
^YTT(601.712,74,1,11,0)="    ""intro"": ""HEALTH is being physically fit, not sick, and without pain or disability.  "", "
^YTT(601.712,74,1,12,0)="    ""columns"": 3, "
