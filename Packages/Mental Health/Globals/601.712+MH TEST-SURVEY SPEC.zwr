^YTT(601.712,52,1,114,0)="   {""id"": ""q5208"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,52,1,115,0)="    ""text"": ""A6. Rate your overall mood during the PAST WEEK."", "
^YTT(601.712,52,1,116,0)="    ""intro"": ""In the following 20 questions, you will be asked to describe your pain and how it"
