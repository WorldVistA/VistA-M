^YTT(601.712,73,1,7,0)=" ""content"":["
^YTT(601.712,73,1,8,0)="   {""id"": ""i1049"", ""type"": ""IntroText"", "
^YTT(601.712,73,1,9,0)="    ""text"": ""This inventory consists of numbered statements. Read each statement and decide"
^YTT(601.712,73,1,10,0)=" whether it is true as applied to you or false as applied to you. If a statement"
^YTT(601.712,73,1,11,0)=" is true or mostly true as applied to   you, choose \u0022True.\u0022 If a"
^YTT(601.712,73,1,12,0)=" statement is false or not usually true as applied to you, choose"
^YTT(601.712,73,1,13,0)=" \u0022False.\u0022 If a statement does not apply to you or if it is something"
^YTT(601.712,73,1,14,0)=" that you don't know about, go ahead to   the next statement. But try to give a"
^YTT(601.712,73,1,15,0)=" response to every statement. Remember to give your own opinion of yourself."
^YTT(601.712,73,1,16,0)=" Remember, try to respond to every statement.  """
^YTT(601.712,73,1,17,0)="    }, "
^YTT(601.712,73,1,18,0)="   {""id"": ""q6029"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,73,1,19,0)="    ""text"": ""1. I like mechanics magazines."", "
^YTT(601.712,73,1,20,0)="    ""intro"": ""This inventory consists of numbered statements. Read each statement and decide"
^YTT(601.712,73,1,21,0)=" whether it is true as applied to you or false as applied to you. If a statement"
^YTT(601.712,73,1,22,0)=" is true or mostly true as applied to   you, choose \u0022True.\u0022 If a"
