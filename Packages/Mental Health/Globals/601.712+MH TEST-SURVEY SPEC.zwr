^YTT(601.712,62,1,1,0)="{""name"": ""MINICOG"", "
^YTT(601.712,62,1,2,0)=" ""copyright"": ""S. Borson. All rights reserved."", "
^YTT(601.712,62,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,62,1,4,0)=" ""printTitle"": ""Mini-Cog"", "
^YTT(601.712,62,1,5,0)=" ""content"":["
^YTT(601.712,62,1,6,0)="   {""id"": ""i610"", ""type"": ""IntroText"", "
^YTT(601.712,62,1,7,0)="    ""text"": ""<strong>Step 1: Three Word Registration</strong><br /><br />Look directly at person and say,"
^YTT(601.712,62,1,8,0)=" \u0022Please listen carefully. I am going to say three words that I want you to"
^YTT(601.712,62,1,9,0)=" repeat back to me now and try to remember. The words are [select a list of words"
^YTT(601.712,62,1,10,0)=" from the versions below]. Please say them for me now.\u0022 If the person is"
^YTT(601.712,62,1,11,0)=" unable to repeat the words after three attempts, move on to Step 2 (clock"
^YTT(601.712,62,1,12,0)=" drawing). <br /><br />The following and other word lists have been used in one"
^YTT(601.712,62,1,13,0)=" or more clinical studies. For repeated administrations, use of an alternative"
^YTT(601.712,62,1,14,0)=" word list is recommended.<br /> <br /><i>Version 1:</i> Banana, Sunrise, Chair<br"
^YTT(601.712,62,1,15,0)=" /><i>Version 2:</i> Leader, Season, Table<br /><i>Version 3:</i> Village, Kitchen, Baby<br"
^YTT(601.712,62,1,16,0)=" /><i>Version 4:</i> River, Nation, Finger<br /><i>Version 5:</i> Captain, Garden, Picture<br"
^YTT(601.712,62,1,17,0)=" /><i>Version 6:</i> Daughter, Heaven, Mountain"""
^YTT(601.712,62,1,18,0)="    }, "
^YTT(601.712,62,1,19,0)="   {""id"": ""q9172"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,62,1,20,0)="    ""text"": "" Word List Version"", "
^YTT(601.712,62,1,21,0)="    ""intro"": ""<strong>Step 1: Three Word Registration</strong><br /><br />Look directly at person and say,"
^YTT(601.712,62,1,22,0)=" \u0022Please listen carefully. I am going to say three words that I want you to"
^YTT(601.712,62,1,23,0)=" repeat back to me now and try to remember. The words are [select a list of words"
^YTT(601.712,62,1,24,0)=" from the versions below]. Please say them for me now.\u0022 If the person is"
^YTT(601.712,62,1,25,0)=" unable to repeat the words after three attempts, move on to Step 2 (clock"
^YTT(601.712,62,1,26,0)=" drawing). <br /><br />The following and other word lists have been used in one"
^YTT(601.712,62,1,27,0)=" or more clinical studies. For repeated administrations, use of an alternative"
^YTT(601.712,62,1,28,0)=" word list is recommended.<br /> <br /><i>Version 1:</i> Banana, Sunrise, Chair<br"
^YTT(601.712,62,1,29,0)=" /><i>Version 2:</i> Leader, Season, Table<br /><i>Version 3:</i> Village, Kitchen, Baby<br"
^YTT(601.712,62,1,30,0)=" /><i>Version 4:</i> River, Nation, Finger<br /><i>Version 5:</i> Captain, Garden, Picture<br"
^YTT(601.712,62,1,31,0)=" /><i>Version 6:</i> Daughter, Heaven, Mountain"", "
^YTT(601.712,62,1,32,0)="    ""columns"": 11, "
^YTT(601.712,62,1,33,0)="    ""choices"":["
^YTT(601.712,62,1,34,0)="     {""id"": ""c5682"", ""text"": "" 1""}, "
^YTT(601.712,62,1,35,0)="     {""id"": ""c5683"", ""text"": "" 2""}, "
^YTT(601.712,62,1,36,0)="     {""id"": ""c5684"", ""text"": "" 3""}, "
^YTT(601.712,62,1,37,0)="     {""id"": ""c5685"", ""text"": "" 4""}, "
^YTT(601.712,62,1,38,0)="     {""id"": ""c5686"", ""text"": "" 5""}, "
^YTT(601.712,62,1,39,0)="     {""id"": ""c5687"", ""text"": "" 6""}"
^YTT(601.712,62,1,40,0)="   ]}, "
^YTT(601.712,62,1,41,0)="   {""id"": ""i2534"", ""type"": ""IntroText"", "
^YTT(601.712,62,1,42,0)="    ""text"": ""<strong>Step 2: Clock Drawing</strong><br /><br />Say: \u0022Next, I want you to draw a clock for"
^YTT(601.712,62,1,43,0)=" me. First, put in all of the numbers where they go.\u0022 When that is"
^YTT(601.712,62,1,44,0)=" completed, say: \u0022Now, set the hands to 10 past 11.\u0022<br /><br />Use"
^YTT(601.712,62,1,45,0)=" preprinted circle for this exercise. Repeat instructions as needed as this is"
^YTT(601.712,62,1,46,0)=" not a memory test. Move to Step 3 if the clock is not complete within three"
^YTT(601.712,62,1,47,0)=" minutes.<br /><br /><small>[A normal clock has all numbers placed in the correct"
^YTT(601.712,62,1,48,0)=" sequence and approximately correct position (e.g., 12, 3, 6 and 9 are in anchor"
^YTT(601.712,62,1,49,0)=" positions) with no missing or duplicate numbers. Hands are pointing to the 11"
^YTT(601.712,62,1,50,0)=" and 2 (11:10). Hand length is not scored.]</small>"""
^YTT(601.712,62,1,51,0)="    }, "
^YTT(601.712,62,1,52,0)="   {""id"": ""q5536"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,62,1,53,0)="    ""text"": "" Clock Drawing"", "
^YTT(601.712,62,1,54,0)="    ""intro"": ""<strong>Step 2: Clock Drawing</strong><br /><br />Say: \u0022Next, I want you to draw a clock for"
^YTT(601.712,62,1,55,0)=" me. First, put in all of the numbers where they go.\u0022 When that is"
^YTT(601.712,62,1,56,0)=" completed, say: \u0022Now, set the hands to 10 past 11.\u0022<br /><br />Use"
^YTT(601.712,62,1,57,0)=" preprinted circle for this exercise. Repeat instructions as needed as this is"
^YTT(601.712,62,1,58,0)=" not a memory test. Move to Step 3 if the clock is not complete within three"
^YTT(601.712,62,1,59,0)=" minutes.<br /><br /><small>[A normal clock has all numbers placed in the correct"
^YTT(601.712,62,1,60,0)=" sequence and approximately correct position (e.g., 12, 3, 6 and 9 are in anchor"
^YTT(601.712,62,1,61,0)=" positions) with no missing or duplicate numbers. Hands are pointing to the 11"
^YTT(601.712,62,1,62,0)=" and 2 (11:10). Hand length is not scored.]</small>"", "
^YTT(601.712,62,1,63,0)="    ""columns"": 3, "
^YTT(601.712,62,1,64,0)="    ""choices"":["
^YTT(601.712,62,1,65,0)="     {""id"": ""c2504"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,62,1,66,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,62,1,67,0)="   ]}, "
^YTT(601.712,62,1,68,0)="   {""id"": ""i2533"", ""type"": ""IntroText"", "
^YTT(601.712,62,1,69,0)="    ""text"": ""<strong>Step 3: Three Word Recall</strong><br /><br />Ask the person to recall the three words you"
^YTT(601.712,62,1,70,0)=" stated in Step 1. Say: \u0022What were the three words I asked you to"
^YTT(601.712,62,1,71,0)=" remember?\u0022 <br /><br /><small>[A correct response is spontaneously recalled"
^YTT(601.712,62,1,72,0)=" without cueing.]</small>"""
^YTT(601.712,62,1,73,0)="    }, "
^YTT(601.712,62,1,74,0)="   {""id"": ""q5537"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,62,1,75,0)="    ""text"": "" Recall of FIRST WORD"", "
^YTT(601.712,62,1,76,0)="    ""intro"": ""<strong>Step 3: Three Word Recall</strong><br /><br />Ask the person to recall the three words you"
^YTT(601.712,62,1,77,0)=" stated in Step 1. Say: \u0022What were the three words I asked you to"
^YTT(601.712,62,1,78,0)=" remember?\u0022 <br /><br /><small>[A correct response is spontaneously recalled"
^YTT(601.712,62,1,79,0)=" without cueing.]</small>"", "
