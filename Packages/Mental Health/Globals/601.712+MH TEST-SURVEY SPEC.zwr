^YTT(601.712,98,1,4,0)=" ""printTitle"": ""PTSD SCREEN - (PC PTSD 5)"","
^YTT(601.712,98,1,5,0)=" ""content"":["
^YTT(601.712,98,1,6,0)="   {""id"": ""i2352"", ""type"": ""IntroText"", "
^YTT(601.712,98,1,7,0)="    ""text"": ""Sometimes things happen to people that are unusually or especially frightening,"
^YTT(601.712,98,1,8,0)=" horrible, or traumatic. For example:<br />  <br />               A serious"
^YTT(601.712,98,1,9,0)=" accident or fire <br />               A physical or sexual assault or abuse<br"
^YTT(601.712,98,1,10,0)=" />               An earthquake or flood<br />               A war<br />         "
^YTT(601.712,98,1,11,0)="      Seeing someone be killed or seriously injured<br />               Having a"
^YTT(601.712,98,1,12,0)=" loved one die through homicide or suicide<br />"""
^YTT(601.712,98,1,13,0)="    }, "
^YTT(601.712,98,1,14,0)="   {""id"": ""q7793"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,98,1,15,0)="    ""text"": ""1. Have you ever experienced this kind of event?"", "
^YTT(601.712,98,1,16,0)="    ""intro"": ""Sometimes things happen to people that are unusually or especially frightening,"
^YTT(601.712,98,1,17,0)=" horrible, or traumatic. For example:<br />  <br />               A serious"
^YTT(601.712,98,1,18,0)=" accident or fire <br />               A physical or sexual assault or abuse<br"
^YTT(601.712,98,1,19,0)=" />               An earthquake or flood<br />               A war<br />         "
^YTT(601.712,98,1,20,0)="      Seeing someone be killed or seriously injured<br />               Having a"
^YTT(601.712,98,1,21,0)=" loved one die through homicide or suicide<br />"", "
^YTT(601.712,98,1,22,0)="    ""columns"": 1, "
^YTT(601.712,98,1,23,0)="    ""choices"":["
^YTT(601.712,98,1,24,0)="     {""id"": ""c3640"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,98,1,25,0)="     {""id"": ""c3641"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,98,1,26,0)="   ]}, "
^YTT(601.712,98,1,27,0)="   {""id"": ""i2353"", ""type"": ""IntroText"", "
^YTT(601.712,98,1,28,0)="    ""text"": ""In the past month, have you..."""
^YTT(601.712,98,1,29,0)="    }, "
^YTT(601.712,98,1,30,0)="   {""id"": ""q7794"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,98,1,31,0)="    ""text"": ""2. Had nightmares about the event(s) or thought about the event(s) when you did"
^YTT(601.712,98,1,32,0)=" not want to?"", "
^YTT(601.712,98,1,33,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,98,1,34,0)="    ""columns"": 1, "
^YTT(601.712,98,1,35,0)="    ""choices"":["
^YTT(601.712,98,1,36,0)="     {""id"": ""c3640"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,98,1,37,0)="     {""id"": ""c3641"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,98,1,38,0)="   ]}, "
^YTT(601.712,98,1,39,0)="   {""id"": ""q7795"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,98,1,40,0)="    ""text"": ""3. Tried hard not to think about the event(s) or went out of your way to avoid"
^YTT(601.712,98,1,41,0)=" situations that reminded you of the event(s)?"", "
^YTT(601.712,98,1,42,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,98,1,43,0)="    ""columns"": 1, "
^YTT(601.712,98,1,44,0)="    ""choices"":["
^YTT(601.712,98,1,45,0)="     {""id"": ""c3640"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,98,1,46,0)="     {""id"": ""c3641"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,98,1,47,0)="   ]}, "
^YTT(601.712,98,1,48,0)="   {""id"": ""q7796"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,98,1,49,0)="    ""text"": ""4. Been constantly on guard, watchful, or easily startled?"", "
^YTT(601.712,98,1,50,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,98,1,51,0)="    ""columns"": 1, "
^YTT(601.712,98,1,52,0)="    ""choices"":["
^YTT(601.712,98,1,53,0)="     {""id"": ""c3640"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,98,1,54,0)="     {""id"": ""c3641"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,98,1,55,0)="   ]}, "
^YTT(601.712,98,1,56,0)="   {""id"": ""q7797"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,98,1,57,0)="    ""text"": ""5. Felt numb or detached from people, activities, or your surroundings?"", "
^YTT(601.712,98,1,58,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,98,1,59,0)="    ""columns"": 1, "
^YTT(601.712,98,1,60,0)="    ""choices"":["
^YTT(601.712,98,1,61,0)="     {""id"": ""c3640"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,98,1,62,0)="     {""id"": ""c3641"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,98,1,63,0)="   ]}, "
^YTT(601.712,98,1,64,0)="   {""id"": ""q7798"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,98,1,65,0)="    ""text"": ""6. Felt guilty or unable to stop blaming yourself or others for the event(s) or"
^YTT(601.712,98,1,66,0)=" any problems the event(s) may have caused?"", "
^YTT(601.712,98,1,67,0)="    ""intro"": ""In the past month, have you..."", "
^YTT(601.712,98,1,68,0)="    ""columns"": 1, "
^YTT(601.712,98,1,69,0)="    ""choices"":["
^YTT(601.712,98,1,70,0)="     {""id"": ""c3640"", ""text"": ""1. YES"", ""quickKey"": 1}, "
^YTT(601.712,98,1,71,0)="     {""id"": ""c3641"", ""text"": ""2. NO"", ""quickKey"": 2}"
^YTT(601.712,98,1,72,0)="   ]}], "
