^YTT(601.712,104,1,11,0)="   {""id"": ""q7875"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,104,1,12,0)="    ""text"": ""1. How soon after you wake up do you smoke/use your first cigarette?"", "
^YTT(601.712,104,1,13,0)="    ""intro"": ""Please read each item carefully and give your best response."", "
^YTT(601.712,104,1,14,0)="    ""columns"": 1, "
^YTT(601.712,104,1,15,0)="    ""choices"":["
^YTT(601.712,104,1,16,0)="     {""id"": ""c106387"", ""text"": ""1. Less than 5 min"", ""quickKey"": 1}, "
^YTT(601.712,104,1,17,0)="     {""id"": ""c106388"", ""text"": ""2. 6-30 min"", ""quickKey"": 2}, "
^YTT(601.712,104,1,18,0)="     {""id"": ""c106389"", ""text"": ""3. 31-60 min"", ""quickKey"": 3}, "
^YTT(601.712,104,1,19,0)="     {""id"": ""c106390"", ""text"": ""4. After 1 hr."", ""quickKey"": 4}"
^YTT(601.712,104,1,20,0)="   ]}, "
^YTT(601.712,104,1,21,0)="   {""id"": ""q7876"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,104,1,22,0)="    ""text"": ""2. How many cigarettes do you smoke in a day?"", "
