^YTT(601.712,193,1,22,0)="     {""id"": ""c6071"", ""text"": ""1. Correct forward digit span"", ""quickKey"": 1}, "
^YTT(601.712,193,1,23,0)="     {""id"": ""c6072"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,193,1,24,0)="   ]}, "
^YTT(601.712,193,1,25,0)="   {""id"": ""q9495"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,193,1,26,0)="    ""text"": ""1B. Backward Digit Span. Correct response for the backwards trial is 7-4-2."", "
^YTT(601.712,193,1,27,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
