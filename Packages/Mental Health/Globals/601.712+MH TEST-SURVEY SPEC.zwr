^YTT(601.712,129,1,5,0)="   {""id"": ""i2431"", ""type"": ""IntroText"", "
^YTT(601.712,129,1,6,0)="    ""text"": ""Here are a number of events that people sometimes experience in relation to their"
^YTT(601.712,129,1,7,0)=" use of alcohol and other drugs. Read each one carefully and then a) indicate if"
^YTT(601.712,129,1,8,0)=" each one has happened to you EVER (No or Yes) in your lifetime, and b) rate how"
^YTT(601.712,129,1,9,0)=" often each has happened IN THE PAST 30 DAYS by marking the appropriate column"
^YTT(601.712,129,1,10,0)=" (Never, Once or a few times, Once or twice a week, Daily or almost daily)."""
^YTT(601.712,129,1,11,0)="    }, "
