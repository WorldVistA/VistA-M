^YTT(601.712,86,1,30,0)="     {""id"": ""c5028"", ""text"": ""3. Much"", ""quickKey"": 3}, "
^YTT(601.712,86,1,31,0)="     {""id"": ""c5029"", ""text"": ""4. Very strong"", ""quickKey"": 4}"
^YTT(601.712,86,1,32,0)="   ]}, "
