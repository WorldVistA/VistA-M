^YTT(601.712,16,1,470,0)="   ]}, "
^YTT(601.712,16,1,471,0)="   {""id"": ""q1103"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,472,0)="    ""text"": ""58. The pain I'm in has made my life feel very hopeless."", "
