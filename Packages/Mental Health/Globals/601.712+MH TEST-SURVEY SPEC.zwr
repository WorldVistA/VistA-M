^YTT(601.712,91,1,54,0)="   {""id"": ""q7322"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,91,1,55,0)="    ""text"": ""7. ANXIETY - Ask, \u0022Do you feel nervous?\u0022 Observation:"", "
^YTT(601.712,91,1,56,0)="    ""columns"": 1, "
^YTT(601.712,91,1,57,0)="    ""choices"":["
^YTT(601.712,91,1,58,0)="     {""id"": ""c2464"", ""text"": ""0. No anxiety, at ease"", ""quickKey"": 0}, "
^YTT(601.712,91,1,59,0)="     {""id"": ""c2465"", ""text"": ""1. Mildly anxious"", ""quickKey"": 1}, "
^YTT(601.712,91,1,60,0)="     {""id"": ""c2747"", ""text"": ""2. Anxiety 2"", ""quickKey"": 2}, "
^YTT(601.712,91,1,61,0)="     {""id"": ""c2748"", ""text"": ""3. Anxiety 3"", ""quickKey"": 3}, "
^YTT(601.712,91,1,62,0)="     {""id"": ""c2468"", ""text"": ""4. Moderately anxious, or guarded, so anxiety is inferred"", ""quickKey"": 4}, "
^YTT(601.712,91,1,63,0)="     {""id"": ""c2749"", ""text"": ""5. Anxiety 5"", ""quickKey"": 5}, "
^YTT(601.712,91,1,64,0)="     {""id"": ""c2750"", ""text"": ""6. Anxiety 6"", ""quickKey"": 6}, "
^YTT(601.712,91,1,65,0)="     {""id"": ""c2471"", ""text"": ""7. Equivalent to acute panic states as seen in severe delirium or acute"
^YTT(601.712,91,1,66,0)=" schizophrenic reactions"", ""quickKey"": 7}"
^YTT(601.712,91,1,67,0)="   ]}, "
^YTT(601.712,91,1,68,0)="   {""id"": ""q7324"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,91,1,69,0)="    ""text"": ""8. AGITATION - Observation:"", "
