^YTT(601.712,16,1,463,0)="   {""id"": ""q1102"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,464,0)="    ""text"": ""57. I watch out for people trying to cheat me."", "
