^YTT(601.712,156,1,80,0)="   {""id"": ""i2489"", ""type"": ""IntroText"","
^YTT(601.712,156,1,81,0)="    ""text"": ""<strong>What your Physician will need to know about your headache:</strong>"""
^YTT(601.712,156,1,82,0)="    },"
^YTT(601.712,156,1,83,0)="   {""id"": ""q8952"", ""type"": ""IntegerQuestion"", ""required"": true,"
^YTT(601.712,156,1,84,0)="    ""text"": ""A. On how many days in the last 3 months did you have a headache? (If a headache"
^YTT(601.712,156,1,85,0)=" lasted more than 1 day, count each day.)"","
^YTT(601.712,156,1,86,0)="    ""intro"": ""<strong>What your Physician will need to know about your headache:</strong>"","
^YTT(601.712,156,1,87,0)="    ""controlWidth"": 70, ""min"": 0, ""max"": 92},"
^YTT(601.712,156,1,88,0)="   {""id"": ""q8953"", ""type"": ""SliderQuestion"", ""required"": true,"
^YTT(601.712,156,1,89,0)="    ""text"": ""B. On a scale of 0 - 10, on average how painful were these headaches? (where 0 ="
^YTT(601.712,156,1,90,0)=" no pain at all, and 10 = pain as bad as it can be.)"","
^YTT(601.712,156,1,91,0)="    ""intro"": ""<strong>What your Physician will need to know about your headache:</strong>"","
^YTT(601.712,156,1,92,0)="    ""min"": 0, ""max"": 10,"
^YTT(601.712,156,1,93,0)="    ""legend"":[""no pain at all"", ""pain as bad as it can be""]}]"
