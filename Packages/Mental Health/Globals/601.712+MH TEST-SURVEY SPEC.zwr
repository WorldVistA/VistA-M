^YTT(601.712,11,1,118,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,119,0)="    "
^YTT(601.712,11,1,120,0)="    ""choices"":["
^YTT(601.712,11,1,121,0)="     {""id"": ""c654"", ""text"": ""0. I have no specific plan about how to kill myself."", ""quickKey"": 0}, "
^YTT(601.712,11,1,122,0)="     {""id"": ""c655"", ""text"": ""1. I have considered ways of killing myself, but have not worked out the details."", ""quickKey"": 1}, "
^YTT(601.712,11,1,123,0)="     {""id"": ""c656"", ""text"": ""2. I have a specific plan for killing myself."", ""quickKey"": 2}"
^YTT(601.712,11,1,124,0)="   ]}, "
^YTT(601.712,11,1,125,0)="   {""id"": ""q441"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,11,1,126,0)="    ""text"": ""13. Select the one statement in each group that BEST describes how you have been"
^YTT(601.712,11,1,127,0)=" feeling for the PAST WEEK, INCLUDING TODAY."", "
^YTT(601.712,11,1,128,0)="    "
^YTT(601.712,11,1,129,0)="    ""choices"":["
^YTT(601.712,11,1,130,0)="     {""id"": ""c657"", ""text"": ""0. I do not have access to a method or an opportunity to kill myself."", ""quickKey"": 0}, "
^YTT(601.712,11,1,131,0)="     {""id"": ""c658"", ""text"": ""1. The method that I would use for committing suicide takes time, and I really do"
