^YTT(601.712,192,1,144,0)="     {""id"": ""c6062"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,192,1,145,0)="   ]}, "
^YTT(601.712,192,1,146,0)="   {""id"": ""q9478"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,192,1,147,0)="    ""text"": ""6B. Sentence repetition. The artist finished his painting at the right moment for"
