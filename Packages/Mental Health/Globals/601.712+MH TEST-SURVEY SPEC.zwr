^YTT(601.712,182,1,1,0)="{""name"": ""CDSS"", "
^YTT(601.712,182,1,2,0)=" ""copyright"": ""Copyright 2018 (Dr. Addington) All Rights Reserved  "", "
^YTT(601.712,182,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,182,1,4,0)=" ""printTitle"": ""Calgary Depression Scale for Schizophrenia (CDSS)"", "
^YTT(601.712,182,1,5,0)=" ""content"":["
^YTT(601.712,182,1,6,0)="   {""id"": ""i2556"", ""type"": ""IntroText"", "
^YTT(601.712,182,1,7,0)="    ""text"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,8,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,9,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,10,0)=" entire interview."""
^YTT(601.712,182,1,11,0)="    }, "
^YTT(601.712,182,1,12,0)="   {""id"": ""q9257"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,13,0)="    ""text"": ""I. DEPRESSION: How would you describe your mood over the last two weeks? Do you"
^YTT(601.712,182,1,14,0)=" remain reasonably cheerful or have you been very depressed or low-spirited"
^YTT(601.712,182,1,15,0)=" recently? In the last two weeks, how often have you (own words) every day?  All"
^YTT(601.712,182,1,16,0)=" day?"", "
^YTT(601.712,182,1,17,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,18,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,19,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,20,0)=" entire interview."", "
^YTT(601.712,182,1,21,0)="    ""columns"": 1, "
^YTT(601.712,182,1,22,0)="    ""choices"":["
^YTT(601.712,182,1,23,0)="     {""id"": ""c5780"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,24,0)="     {""id"": ""c5781"", ""text"": ""1. Mild - Expresses some sadness or discouragement on questioning."", ""quickKey"": 1}, "
^YTT(601.712,182,1,25,0)="     {""id"": ""c5782"", ""text"": ""2. Moderate - Distinct depressed mood persisting up to half the time over last"
^YTT(601.712,182,1,26,0)=" two weeks: present daily."", ""quickKey"": 2}, "
^YTT(601.712,182,1,27,0)="     {""id"": ""c5783"", ""text"": ""3. Severe - Markedly depressed mood persisting daily over half the time"
^YTT(601.712,182,1,28,0)=" interfering with normal motor and social functioning."", ""quickKey"": 3}"
^YTT(601.712,182,1,29,0)="   ]}, "
^YTT(601.712,182,1,30,0)="   {""id"": ""q9258"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,31,0)="    ""text"": ""II. HOPELESSNESS: How do you see the future for yourself? Can you see any future?"
^YTT(601.712,182,1,32,0)=" Or has life seemed quite hopeless? Have you given up or does there still seem"
^YTT(601.712,182,1,33,0)=" some reason for trying?"", "
^YTT(601.712,182,1,34,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,35,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,36,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,37,0)=" entire interview."", "
^YTT(601.712,182,1,38,0)="    ""columns"": 1, "
^YTT(601.712,182,1,39,0)="    ""choices"":["
^YTT(601.712,182,1,40,0)="     {""id"": ""c5784"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,41,0)="     {""id"": ""c5785"", ""text"": ""1. Mild - Has at times felt hopeless over the last two weeks but still has some"
^YTT(601.712,182,1,42,0)=" degree of hope for the future."", ""quickKey"": 1}, "
^YTT(601.712,182,1,43,0)="     {""id"": ""c5786"", ""text"": ""2. Moderate - Persistent, moderate sense of hopelessness over the last two weeks."
^YTT(601.712,182,1,44,0)=" Can be persuaded to acknowledge possibility of things being better."", ""quickKey"": 2}, "
^YTT(601.712,182,1,45,0)="     {""id"": ""c5787"", ""text"": ""3. Severe - Persisting and distressing sense of hopelessness."", ""quickKey"": 3}"
^YTT(601.712,182,1,46,0)="   ]}, "
^YTT(601.712,182,1,47,0)="   {""id"": ""q9259"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,48,0)="    ""text"": ""III. SELF-DEPRECIATION: What is your opinion of yourself compared to other"
^YTT(601.712,182,1,49,0)=" people? Do you feel better, not as good, or about the same as others? Do you"
^YTT(601.712,182,1,50,0)=" feel inferior or even worthless?"", "
^YTT(601.712,182,1,51,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,52,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,53,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,54,0)=" entire interview."", "
^YTT(601.712,182,1,55,0)="    ""columns"": 1, "
^YTT(601.712,182,1,56,0)="    ""choices"":["
^YTT(601.712,182,1,57,0)="     {""id"": ""c5788"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,58,0)="     {""id"": ""c5789"", ""text"": ""1. Mild - Some inferiority; not amounting to feeling of worthlessness."", ""quickKey"": 1}, "
^YTT(601.712,182,1,59,0)="     {""id"": ""c5790"", ""text"": ""2. Moderate - Subject feels worthless, but less than 50% of the time."", ""quickKey"": 2}, "
^YTT(601.712,182,1,60,0)="     {""id"": ""c5791"", ""text"": ""3. Severe - Subject feels worthless more than 50% of the time.  May be challenged"
^YTT(601.712,182,1,61,0)=" to acknowledge otherwise."", ""quickKey"": 3}"
^YTT(601.712,182,1,62,0)="   ]}, "
^YTT(601.712,182,1,63,0)="   {""id"": ""q9260"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,64,0)="    ""text"": ""IV. GUILTY IDEAS OF REFERENCE: Do you have the feeling that you are being blamed"
^YTT(601.712,182,1,65,0)=" for something or even wrongly accused? What about? (Do not include justifiable"
^YTT(601.712,182,1,66,0)=" blame or accusation. Exclude delusions of guilt.)"", "
^YTT(601.712,182,1,67,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,68,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,69,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,70,0)=" entire interview."", "
^YTT(601.712,182,1,71,0)="    ""columns"": 1, "
^YTT(601.712,182,1,72,0)="    ""choices"":["
^YTT(601.712,182,1,73,0)="     {""id"": ""c5792"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,74,0)="     {""id"": ""c5793"", ""text"": ""1. Mild - Subject feels blamed but not accused less than 50% of the time."", ""quickKey"": 1}, "
^YTT(601.712,182,1,75,0)="     {""id"": ""c5794"", ""text"": ""2. Moderate - Persisting sense of being blamed, and/or occasional sense of being"
^YTT(601.712,182,1,76,0)=" accused."", ""quickKey"": 2}, "
^YTT(601.712,182,1,77,0)="     {""id"": ""c5795"", ""text"": ""3. Severe - Persistent sense of being accused. When challenged, acknowledges that"
^YTT(601.712,182,1,78,0)=" it is not so."", ""quickKey"": 3}"
^YTT(601.712,182,1,79,0)="   ]}, "
^YTT(601.712,182,1,80,0)="   {""id"": ""q9261"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,81,0)="    ""text"": ""V. PATHOLOGICAL GUILT: Do you tend to blame yourself for little things you may"
^YTT(601.712,182,1,82,0)=" have done in the past? Do you think that you deserve to be so concerned about"
^YTT(601.712,182,1,83,0)=" this?"", "
^YTT(601.712,182,1,84,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,85,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,86,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,87,0)=" entire interview."", "
^YTT(601.712,182,1,88,0)="    ""columns"": 1, "
^YTT(601.712,182,1,89,0)="    ""choices"":["
^YTT(601.712,182,1,90,0)="     {""id"": ""c5796"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,91,0)="     {""id"": ""c5797"", ""text"": ""1. Mild - Subject sometimes feels overly guilty about some minor peccadillo, but"
^YTT(601.712,182,1,92,0)=" less than 50% of time."", ""quickKey"": 1}, "
^YTT(601.712,182,1,93,0)="     {""id"": ""c5798"", ""text"": ""2. Moderate - Subject usually (over 50% of time) feels guilty about past actions"
^YTT(601.712,182,1,94,0)=" the significance of which s/he exaggerates."", ""quickKey"": 2}, "
^YTT(601.712,182,1,95,0)="     {""id"": ""c5799"", ""text"": ""3. Severe - Subject usually feels s/he is to blame for everything that has gone"
^YTT(601.712,182,1,96,0)=" wrong, even when not his/her fault."", ""quickKey"": 3}"
^YTT(601.712,182,1,97,0)="   ]}, "
^YTT(601.712,182,1,98,0)="   {""id"": ""q9262"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,99,0)="    ""text"": ""VI. MORNING DEPRESSION: When you have felt depressed over the last two weeks,"
^YTT(601.712,182,1,100,0)=" have you noticed the depression being worse at any particular time of day?"", "
^YTT(601.712,182,1,101,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,102,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,103,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,104,0)=" entire interview."", "
^YTT(601.712,182,1,105,0)="    ""columns"": 1, "
^YTT(601.712,182,1,106,0)="    ""choices"":["
^YTT(601.712,182,1,107,0)="     {""id"": ""c5800"", ""text"": ""0. Absent - No depression."", ""quickKey"": 0}, "
^YTT(601.712,182,1,108,0)="     {""id"": ""c5801"", ""text"": ""1. Mild - Depression present but no diurnal variation."", ""quickKey"": 1}, "
^YTT(601.712,182,1,109,0)="     {""id"": ""c5802"", ""text"": ""2. Moderate - Depression spontaneously mentioned to be worse in the a.m. hours."", ""quickKey"": 2}, "
^YTT(601.712,182,1,110,0)="     {""id"": ""c5803"", ""text"": ""3. Severe - Depression markedly worse in the a.m. hours, with impaired"
^YTT(601.712,182,1,111,0)=" functioning which improves in the p.m. hours."", ""quickKey"": 3}"
^YTT(601.712,182,1,112,0)="   ]}, "
^YTT(601.712,182,1,113,0)="   {""id"": ""q9263"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,114,0)="    ""text"": ""VII. EARLY WAKENING: Do you wake earlier in the morning than is normal for you?"
^YTT(601.712,182,1,115,0)=" How many times a week does this happen?"", "
^YTT(601.712,182,1,116,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,117,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,118,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,119,0)=" entire interview."", "
^YTT(601.712,182,1,120,0)="    ""columns"": 1, "
^YTT(601.712,182,1,121,0)="    ""choices"":["
^YTT(601.712,182,1,122,0)="     {""id"": ""c5804"", ""text"": ""0. Absent - No early wakening."", ""quickKey"": 0}, "
^YTT(601.712,182,1,123,0)="     {""id"": ""c5805"", ""text"": ""1. Mild - Occasionally wakes (up to twice weekly) 1 hour or more before normal"
^YTT(601.712,182,1,124,0)=" time to wake or alarm time."", ""quickKey"": 1}, "
^YTT(601.712,182,1,125,0)="     {""id"": ""c5806"", ""text"": ""2. Moderate - Often wakes early (up to 5 times weekly) 1 hour or more before"
^YTT(601.712,182,1,126,0)=" normal time to wake or alarm."", ""quickKey"": 2}, "
^YTT(601.712,182,1,127,0)="     {""id"": ""c5807"", ""text"": ""3. Severe - Daily wakes 1 hour or more before normal time."", ""quickKey"": 3}"
^YTT(601.712,182,1,128,0)="   ]}, "
^YTT(601.712,182,1,129,0)="   {""id"": ""q9264"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,130,0)="    ""text"": ""VIII. SUICIDE: Have you felt that life wasn't worth living? Did you ever feel"
^YTT(601.712,182,1,131,0)=" like ending it all? What did you think you might do? Did you actually try?"", "
^YTT(601.712,182,1,132,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,133,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,134,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,135,0)=" entire interview."", "
^YTT(601.712,182,1,136,0)="    ""columns"": 1, "
^YTT(601.712,182,1,137,0)="    ""choices"":["
^YTT(601.712,182,1,138,0)="     {""id"": ""c5808"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,139,0)="     {""id"": ""c5809"", ""text"": ""1. Mild - Frequent thoughts of being better off dead, or occasional thoughts of"
^YTT(601.712,182,1,140,0)=" suicide."", ""quickKey"": 1}, "
^YTT(601.712,182,1,141,0)="     {""id"": ""c5810"", ""text"": ""2. Moderate - Deliberately considered suicide with a plan but made no attempt."", ""quickKey"": 2}, "
^YTT(601.712,182,1,142,0)="     {""id"": ""c5811"", ""text"": ""3. Severe - Suicidal attempt apparently designed to end in death (i.e.,"
^YTT(601.712,182,1,143,0)=" accidental discovery or inefficient means)."", ""quickKey"": 3}"
^YTT(601.712,182,1,144,0)="   ]}, "
^YTT(601.712,182,1,145,0)="   {""id"": ""q9265"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,182,1,146,0)="    ""text"": ""IX. OBSERVED DEPRESSION: Based on interviewer's observations during the entire"
^YTT(601.712,182,1,147,0)=" interview. The question \u0022Do you feel like crying?\u0022, used at"
^YTT(601.712,182,1,148,0)=" appropriate points in the interview, may elicit information useful to this"
^YTT(601.712,182,1,149,0)=" observation."", "
^YTT(601.712,182,1,150,0)="    ""intro"": ""Interviewer: Ask the first question as written. Use follow-up probes or"
^YTT(601.712,182,1,151,0)=" qualifiers at your discretion.  Time frame refers to the last two weeks unless"
^YTT(601.712,182,1,152,0)=" stipulated.<br /><br />Note: The last item, # 9, is based on observations of the"
^YTT(601.712,182,1,153,0)=" entire interview."", "
^YTT(601.712,182,1,154,0)="    ""columns"": 1, "
^YTT(601.712,182,1,155,0)="    ""choices"":["
^YTT(601.712,182,1,156,0)="     {""id"": ""c5812"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,182,1,157,0)="     {""id"": ""c5813"", ""text"": ""1. Mild - Subject appears sad and mournful even during parts of the interview"
^YTT(601.712,182,1,158,0)=" involving affectively neutral discussion."", ""quickKey"": 1}, "
^YTT(601.712,182,1,159,0)="     {""id"": ""c5814"", ""text"": ""2. Moderate - Subject appears sad and mournful throughout the interview, with"
^YTT(601.712,182,1,160,0)=" gloomy monotonous voice and is tearful or close to tears at times."", ""quickKey"": 2}, "
^YTT(601.712,182,1,161,0)="     {""id"": ""c5815"", ""text"": ""3. Subject chokes on distressing topics, frequently sighs deeply and cries"
^YTT(601.712,182,1,162,0)=" openly, or is persistently in a state of frozen misery if examiner is sure that"
^YTT(601.712,182,1,163,0)=" this is present."", ""quickKey"": 3}"
^YTT(601.712,182,1,164,0)="   ]}]"
^YTT(601.712,182,1,165,0)="}"
^YTT(601.712,183,0)="331^3231218.132104^555420305"
^YTT(601.712,183,1,0)="^^397^397^3240325"
^YTT(601.712,183,1,1,0)="{""name"": ""LEC"", "
^YTT(601.712,183,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,183,1,3,0)=" ""printTitle"": ""Life Events Checklist for DSM-5 (LEC)"", "
^YTT(601.712,183,1,4,0)=" ""content"":["
^YTT(601.712,183,1,5,0)="   {""id"": ""i2557"", ""type"": ""IntroText"", "
^YTT(601.712,183,1,6,0)="    ""text"": ""Listed below are a number of difficult or stressful things that sometimes happen"
^YTT(601.712,183,1,7,0)=" to people. For each event check one or more of the boxes to the right to"
^YTT(601.712,183,1,8,0)=" indicate that: (a) \u003Cu\u003Eit happened to you\u003C/u\u003E personally; (b)"
^YTT(601.712,183,1,9,0)=" you \u003Cu\u003Ewitnessed it\u003C/u\u003E happen to someone else; (c) you"
^YTT(601.712,183,1,10,0)=" \u003Cu\u003Elearned about it\u003C/u\u003E happening to a close family member"
^YTT(601.712,183,1,11,0)=" or close friend; (d) you were exposed to it as \u003Cu\u003Epart of your"
^YTT(601.712,183,1,12,0)=" job\u003C/u\u003E (for example, paramedic, police, military, or other first"
^YTT(601.712,183,1,13,0)=" responder); (e) you're \u003Cu\u003E not sure\u003C/u\u003E if it fits; or (f)"
^YTT(601.712,183,1,14,0)=" it \u003Cu\u003Edoesn't apply\u003C/u\u003E to you. <br /><br />Be sure to"
^YTT(601.712,183,1,15,0)=" consider your entire life (growing up as well as adulthood) as you go through"
^YTT(601.712,183,1,16,0)=" the list of events."""
^YTT(601.712,183,1,17,0)="    }, "
^YTT(601.712,183,1,18,0)="   {""id"": ""q9266"", ""type"": ""CheckQuestion"", ""required"": true, ""inline"": true, "
^YTT(601.712,183,1,19,0)="    ""text"": ""1. Natural disaster (for example, flood, hurricane, tornado, earthquake)"", "
