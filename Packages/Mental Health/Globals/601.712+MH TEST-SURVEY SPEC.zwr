^YTT(601.712,17,1,586,0)="   ]}, "
^YTT(601.712,17,1,587,0)="   {""id"": ""q1464"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,588,0)="    ""text"": ""79. I am often cross and grouchy."", "
^YTT(601.712,17,1,589,0)="    "
^YTT(601.712,17,1,590,0)="    ""choices"":["
^YTT(601.712,17,1,591,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
