^YTT(601.712,122,1,1,0)="{""name"": ""CSDD-RS"", "
^YTT(601.712,122,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,122,1,3,0)=" ""printTitle"": ""Cornell Scale for Depression in Dementia - Response Sheet (CSDD-RS)"","
^YTT(601.712,122,1,4,0)=" ""content"":["
^YTT(601.712,122,1,5,0)="   {""id"": ""i2393"", ""type"": ""IntroText"", "
^YTT(601.712,122,1,6,0)="    ""text"": ""Ratings should be based on symptoms and signs occurring during the week before"
^YTT(601.712,122,1,7,0)=" interview. If symptoms result from physical disability or illness, select the"
^YTT(601.712,122,1,8,0)=" corresponding response below (response #4). Ratings are based on two"
^YTT(601.712,122,1,9,0)=" semi-structured interviews: an interview of an informant and an interview of the"
^YTT(601.712,122,1,10,0)=" patient. If there are discrepancies in ratings from the informant and the"
^YTT(601.712,122,1,11,0)=" patient interviews, the rater should re-interview both the informant and the"
^YTT(601.712,122,1,12,0)=" patient with the goal to resolve the discrepancies.The final ratings of the CSDD"
^YTT(601.712,122,1,13,0)=" items represent the rater's clinical impression rather than the responses of the"
^YTT(601.712,122,1,14,0)=" informant or the patient. The semi-structured interviews can be found at the"
^YTT(601.712,122,1,15,0)=" Geriatric Mental Health Site on the VHA Pulse or by contacting the Mental Health"
^YTT(601.712,122,1,16,0)=" Program Office."""
^YTT(601.712,122,1,17,0)="    }, "
^YTT(601.712,122,1,18,0)="   {""id"": ""q8358"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,122,1,19,0)="    ""text"": ""1. MOOD-RELATED SIGNS: Anxiety; anxious expression, rumination, worrying"", "
^YTT(601.712,122,1,20,0)="    ""intro"": ""Ratings should be based on symptoms and signs occurring during the week before"
^YTT(601.712,122,1,21,0)=" interview. If symptoms result from physical disability or illness, select the"
^YTT(601.712,122,1,22,0)=" corresponding response below (response #4). Ratings are based on two"
^YTT(601.712,122,1,23,0)=" semi-structured interviews: an interview of an informant and an interview of the"
^YTT(601.712,122,1,24,0)=" patient. If there are discrepancies in ratings from the informant and the"
^YTT(601.712,122,1,25,0)=" patient interviews, the rater should re-interview both the informant and the"
^YTT(601.712,122,1,26,0)=" patient with the goal to resolve the discrepancies.The final ratings of the CSDD"
^YTT(601.712,122,1,27,0)=" items represent the rater's clinical impression rather than the responses of the"
^YTT(601.712,122,1,28,0)=" informant or the patient. The semi-structured interviews can be found at the"
^YTT(601.712,122,1,29,0)=" Geriatric Mental Health Site on the VHA Pulse or by contacting the Mental Health"
^YTT(601.712,122,1,30,0)=" Program Office."", "
