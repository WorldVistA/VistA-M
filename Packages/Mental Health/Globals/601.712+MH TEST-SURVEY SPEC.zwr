^YTT(601.712,71,1,5,0)="   {""id"": ""i1043"", ""type"": ""IntroText"", "
^YTT(601.712,71,1,6,0)="    ""text"": ""Below is a list of statements that describe how people sometimes feel about"
^YTT(601.712,71,1,7,0)=" themselves and their lives. Please read each one carefully and indicate the"
^YTT(601.712,71,1,8,0)=" response that best describes the extent to   which you agree or disagree with"
^YTT(601.712,71,1,9,0)=" the statement.  """
^YTT(601.712,71,1,10,0)="    }, "
