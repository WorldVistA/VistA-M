^YTT(601.712,16,1,421,0)="   ]}, "
^YTT(601.712,16,1,422,0)="   {""id"": ""q1097"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,423,0)="    ""text"": ""52. I have always had a talent for being successful."", "
