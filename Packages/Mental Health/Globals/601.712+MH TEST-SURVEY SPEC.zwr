^YTT(601.712,99,1,6,0)=" ""content"":["
^YTT(601.712,99,1,7,0)="   {""id"": ""i2354"", ""type"": ""IntroText"", "
^YTT(601.712,99,1,8,0)="    ""text"": ""Provide the responses to the following questions for the time period designated."""
^YTT(601.712,99,1,9,0)="    }, "
^YTT(601.712,99,1,10,0)="   {""id"": ""q7801"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,11,0)="    ""text"": ""1. Over the past month, have you wished you were dead or wished you could go to"
^YTT(601.712,99,1,12,0)=" sleep and not wake up?"", "
^YTT(601.712,99,1,13,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,14,0)="    ""columns"": 1, "
^YTT(601.712,99,1,15,0)="    ""choices"":["
^YTT(601.712,99,1,16,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,17,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,18,0)="   ]}, "
^YTT(601.712,99,1,19,0)="   {""id"": ""q7802"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,20,0)="    ""text"": ""2. Over the past month, have you had any actual thoughts of killing yourself?"", "
^YTT(601.712,99,1,21,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,22,0)="    ""columns"": 1, "
^YTT(601.712,99,1,23,0)="    ""choices"":["
^YTT(601.712,99,1,24,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,25,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,26,0)="   ]}, "
^YTT(601.712,99,1,27,0)="   {""id"": ""q7803"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,28,0)="    ""text"": ""3. Over the past month, have you been thinking about how you might do this? "", "
^YTT(601.712,99,1,29,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,30,0)="    ""columns"": 1, "
^YTT(601.712,99,1,31,0)="    ""choices"":["
^YTT(601.712,99,1,32,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,33,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,34,0)="   ]}, "
^YTT(601.712,99,1,35,0)="   {""id"": ""q7804"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,36,0)="    ""text"": ""4. Over the past month, have you had these thoughts and had some intention of"
^YTT(601.712,99,1,37,0)=" acting on them?"", "
^YTT(601.712,99,1,38,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,39,0)="    ""columns"": 1, "
^YTT(601.712,99,1,40,0)="    ""choices"":["
^YTT(601.712,99,1,41,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,42,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,43,0)="   ]}, "
^YTT(601.712,99,1,44,0)="   {""id"": ""q7805"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,45,0)="    ""text"": ""5. Over the past month, have you started to work out or worked out the details of"
^YTT(601.712,99,1,46,0)=" how to kill yourself?"", "
^YTT(601.712,99,1,47,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,48,0)="    ""columns"": 1, "
^YTT(601.712,99,1,49,0)="    ""choices"":["
^YTT(601.712,99,1,50,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,51,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,52,0)="   ]}, "
^YTT(601.712,99,1,53,0)="   {""id"": ""q7806"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,54,0)="    ""text"": ""6. If yes, at any time in the past month did you intend to carry out this plan?"", "
^YTT(601.712,99,1,55,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,56,0)="    ""columns"": 1, "
^YTT(601.712,99,1,57,0)="    ""choices"":["
^YTT(601.712,99,1,58,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,59,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,60,0)="   ]}, "
^YTT(601.712,99,1,61,0)="   {""id"": ""q7807"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,99,1,62,0)="    ""text"": ""7. In your lifetime, have you ever done anything, started to do anything, or"
^YTT(601.712,99,1,63,0)=" prepared to do anything to end your life (for example, collected pills, obtained"
^YTT(601.712,99,1,64,0)=" a gun, gave away valuables, went to the roof but didn't jump)?"", "
^YTT(601.712,99,1,65,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,66,0)="    ""columns"": 1, "
^YTT(601.712,99,1,67,0)="    ""choices"":["
^YTT(601.712,99,1,68,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,69,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,70,0)="   ]}, "
^YTT(601.712,99,1,71,0)="   {""id"": ""q7808"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,99,1,72,0)="    ""text"": ""8. If YES, was this within the past 3 months?"", "
^YTT(601.712,99,1,73,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,99,1,74,0)="    ""columns"": 1, "
^YTT(601.712,99,1,75,0)="    ""choices"":["
^YTT(601.712,99,1,76,0)="     {""id"": ""c3650"", ""text"": "" Yes""}, "
^YTT(601.712,99,1,77,0)="     {""id"": ""c3651"", ""text"": "" No""}"
^YTT(601.712,99,1,78,0)="   ]}], "
^YTT(601.712,99,1,79,0)=" ""rules"":["
^YTT(601.712,99,1,80,0)="   {""question"": ""q7802"", ""operator"": ""EQ"", ""value"": ""c3651"", "
^YTT(601.712,99,1,81,0)="    ""skips"":[""q7803"",""q7804"",""q7805"",""q7806""]}, "
^YTT(601.712,99,1,82,0)="   {""question"": ""q7805"", ""operator"": ""EQ"", ""value"": ""c3651"", "
^YTT(601.712,99,1,83,0)="    ""skips"":[""q7806""]}, "
^YTT(601.712,99,1,84,0)="   {""question"": ""q7807"", ""operator"": ""EQ"", ""value"": ""c3651"", "
^YTT(601.712,99,1,85,0)="    ""skips"":[""q7808""]}]"
^YTT(601.712,99,1,86,0)="}"
