^YTT(601.712,187,1,22,0)="     {""id"": ""c5852"", ""text"": ""1. Once or a few times"", ""quickKey"": 1}, "
^YTT(601.712,187,1,23,0)="     {""id"": ""c5853"", ""text"": ""2. Once or twice a week"", ""quickKey"": 2}, "
