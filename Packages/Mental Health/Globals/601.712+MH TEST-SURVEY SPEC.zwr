^YTT(601.712,16,1,382,0)="   {""id"": ""q1092"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,383,0)="    ""text"": ""47. I've always preferred to have a quiet and inactive life."", "
^YTT(601.712,16,1,384,0)="    ""intro"": ""Please read each item carefully and answer each question as it pertains to you."", "
^YTT(601.712,16,1,385,0)="    ""columns"": 1, "
