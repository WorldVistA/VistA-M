^YTT(601.712,9,1,8,0)="    ""text"": ""This questionnaire consists of 20 statements.  Please read each statement"
^YTT(601.712,9,1,9,0)=" carefully.  If the statement describes your attitude for the PAST WEEK INCLUDING"
^YTT(601.712,9,1,10,0)=" TODAY, select '1' indicating True. If the statement does not describe your"
^YTT(601.712,9,1,11,0)=" attitude select '2' indicating False.  Please read each statement carefully."""
^YTT(601.712,9,1,12,0)="    }, "
^YTT(601.712,9,1,13,0)="   {""id"": ""q391"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,9,1,14,0)="    ""text"": ""1. I look forward to the future with hope and enthusiasm."", "
^YTT(601.712,9,1,15,0)="    ""intro"": ""This questionnaire consists of 20 statements.  Please read each statement"
^YTT(601.712,9,1,16,0)=" carefully.  If the statement describes your attitude for the PAST WEEK INCLUDING"
^YTT(601.712,9,1,17,0)=" TODAY, select '1' indicating True. If the statement does not describe your"
^YTT(601.712,9,1,18,0)=" attitude select '2' indicating False.  Please read each statement carefully."", "
^YTT(601.712,9,1,19,0)="    "
