^YTT(601.712,115,1,921,0)="   ]}, "
^YTT(601.712,115,1,922,0)="   {""id"": ""q8139"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,923,0)="    ""text"": ""125. My current life is still upset by flashbacks of something terrible that"
^YTT(601.712,115,1,924,0)=" happened to me."", "
^YTT(601.712,115,1,925,0)="    ""columns"": 1, "
^YTT(601.712,115,1,926,0)="    ""choices"":["
^YTT(601.712,115,1,927,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,928,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,929,0)="   ]}, "
^YTT(601.712,115,1,930,0)="   {""id"": ""q8140"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,931,0)="    ""text"": ""126. I often ruin the good things that happen to me."", "
^YTT(601.712,115,1,932,0)="    ""columns"": 1, "
^YTT(601.712,115,1,933,0)="    ""choices"":["
^YTT(601.712,115,1,934,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,935,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,936,0)="   ]}, "
^YTT(601.712,115,1,937,0)="   {""id"": ""q8141"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,938,0)="    ""text"": ""127. Evil voices are trying to take over my mind."", "
^YTT(601.712,115,1,939,0)="    ""columns"": 1, "
^YTT(601.712,115,1,940,0)="    ""choices"":["
^YTT(601.712,115,1,941,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,942,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,943,0)="   ]}, "
^YTT(601.712,115,1,944,0)="   {""id"": ""q8142"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,945,0)="    ""text"": ""128. I feel very guilty when I lose my temper. "", "
^YTT(601.712,115,1,946,0)="    ""columns"": 1, "
^YTT(601.712,115,1,947,0)="    ""choices"":["
^YTT(601.712,115,1,948,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,949,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,950,0)="   ]}, "
^YTT(601.712,115,1,951,0)="   {""id"": ""q8143"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,952,0)="    ""text"": ""129. My enthusiasm for the work I do never really diminishes."", "
^YTT(601.712,115,1,953,0)="    ""columns"": 1, "
^YTT(601.712,115,1,954,0)="    ""choices"":["
^YTT(601.712,115,1,955,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,956,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,957,0)="   ]}, "
^YTT(601.712,115,1,958,0)="   {""id"": ""q8144"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,959,0)="    ""text"": ""130. I guess I'm no different from my parents in becoming somewhat of an"
^YTT(601.712,115,1,960,0)=" alcoholic."", "
^YTT(601.712,115,1,961,0)="    ""columns"": 1, "
^YTT(601.712,115,1,962,0)="    ""choices"":["
^YTT(601.712,115,1,963,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,964,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,965,0)="   ]}, "
^YTT(601.712,115,1,966,0)="   {""id"": ""q8145"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,967,0)="    ""text"": ""131. Lately, I have had to think things over and over again for no good reason."", "
^YTT(601.712,115,1,968,0)="    ""columns"": 1, "
^YTT(601.712,115,1,969,0)="    ""choices"":["
^YTT(601.712,115,1,970,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,971,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,972,0)="   ]}, "
^YTT(601.712,115,1,973,0)="   {""id"": ""q8146"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,974,0)="    ""text"": ""132. I encourage people to admire the things I say or do."", "
^YTT(601.712,115,1,975,0)="    ""columns"": 1, "
^YTT(601.712,115,1,976,0)="    ""choices"":["
^YTT(601.712,115,1,977,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,978,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,979,0)="   ]}, "
^YTT(601.712,115,1,980,0)="   {""id"": ""q8147"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,981,0)="    ""text"": ""133. I give up doing things when I have to do them alone."", "
^YTT(601.712,115,1,982,0)="    ""columns"": 1, "
^YTT(601.712,115,1,983,0)="    ""choices"":["
^YTT(601.712,115,1,984,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,985,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,986,0)="   ]}, "
^YTT(601.712,115,1,987,0)="   {""id"": ""q8148"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,988,0)="    ""text"": ""134. I have tried to commit suicide."", "
^YTT(601.712,115,1,989,0)="    ""columns"": 1, "
^YTT(601.712,115,1,990,0)="    ""choices"":["
^YTT(601.712,115,1,991,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,992,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,993,0)="   ]}, "
^YTT(601.712,115,1,994,0)="   {""id"": ""q8149"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,995,0)="    ""text"": ""135. I am a fearful and inhibited person."", "
^YTT(601.712,115,1,996,0)="    ""columns"": 1, "
^YTT(601.712,115,1,997,0)="    ""choices"":["
^YTT(601.712,115,1,998,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,999,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1000,0)="   ]}, "
^YTT(601.712,115,1,1001,0)="   {""id"": ""q8150"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1002,0)="    ""text"": ""136. People who are supposed to be my friends would like to do me harm."", "
^YTT(601.712,115,1,1003,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1004,0)="    ""choices"":["
^YTT(601.712,115,1,1005,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1006,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1007,0)="   ]}, "
^YTT(601.712,115,1,1008,0)="   {""id"": ""q8151"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1009,0)="    ""text"": ""137. I often let my angry feelings out and then feel very guilty about it."", "
^YTT(601.712,115,1,1010,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1011,0)="    ""choices"":["
^YTT(601.712,115,1,1012,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1013,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1014,0)="   ]}, "
^YTT(601.712,115,1,1015,0)="   {""id"": ""q8152"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1016,0)="    ""text"": ""138. I very often hear things so well that it bothers me."", "
^YTT(601.712,115,1,1017,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1018,0)="    ""choices"":["
^YTT(601.712,115,1,1019,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1020,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1021,0)="   ]}, "
^YTT(601.712,115,1,1022,0)="   {""id"": ""q8153"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1023,0)="    ""text"": ""139. Other than my family, I have very few close relationships."", "
^YTT(601.712,115,1,1024,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1025,0)="    ""choices"":["
^YTT(601.712,115,1,1026,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1027,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1028,0)="   ]}, "
^YTT(601.712,115,1,1029,0)="   {""id"": ""q8154"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1030,0)="    ""text"": ""140. Disorganization makes me feel very uncomfortable. "", "
^YTT(601.712,115,1,1031,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1032,0)="    ""choices"":["
^YTT(601.712,115,1,1033,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1034,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1035,0)="   ]}, "
^YTT(601.712,115,1,1036,0)="   {""id"": ""q8155"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1037,0)="    ""text"": ""141. I often criticize people strongly if they annoy me."", "
^YTT(601.712,115,1,1038,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1039,0)="    ""choices"":["
^YTT(601.712,115,1,1040,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1041,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1042,0)="   ]}, "
^YTT(601.712,115,1,1043,0)="   {""id"": ""q8156"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1044,0)="    ""text"": ""142. I have many talents that others wish they had."", "
^YTT(601.712,115,1,1045,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1046,0)="    ""choices"":["
^YTT(601.712,115,1,1047,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1048,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1049,0)="   ]}, "
^YTT(601.712,115,1,1050,0)="   {""id"": ""q8157"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1051,0)="    ""text"": ""143. There are terrible events from my past that come back repeatedly to haunt my"
^YTT(601.712,115,1,1052,0)=" thoughts and dreams."", "
^YTT(601.712,115,1,1053,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1054,0)="    ""choices"":["
^YTT(601.712,115,1,1055,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1056,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1057,0)="   ]}, "
^YTT(601.712,115,1,1058,0)="   {""id"": ""q8158"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1059,0)="    ""text"": ""144. I know I've spent more money than I should buying illegal drugs."", "
^YTT(601.712,115,1,1060,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1061,0)="    ""choices"":["
^YTT(601.712,115,1,1062,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1063,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1064,0)="   ]}, "
^YTT(601.712,115,1,1065,0)="   {""id"": ""q8159"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1066,0)="    ""text"": ""145. Before I know it, I often start shouting angrily at friends and family."", "
^YTT(601.712,115,1,1067,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1068,0)="    ""choices"":["
^YTT(601.712,115,1,1069,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1070,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1071,0)="   ]}, "
^YTT(601.712,115,1,1072,0)="   {""id"": ""q8160"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1073,0)="    ""text"": ""146. It bothers me that my body gets worn out very quickly."", "
^YTT(601.712,115,1,1074,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1075,0)="    ""choices"":["
^YTT(601.712,115,1,1076,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1077,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1078,0)="   ]}, "
^YTT(601.712,115,1,1079,0)="   {""id"": ""q8161"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1080,0)="    ""text"": ""147. It's all right to get around the law if you're not likely to get caught."", "
^YTT(601.712,115,1,1081,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1082,0)="    ""choices"":["
^YTT(601.712,115,1,1083,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1084,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1085,0)="   ]}, "
^YTT(601.712,115,1,1086,0)="   {""id"": ""q8162"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1087,0)="    ""text"": ""148. I believe I'm being plotted against."", "
^YTT(601.712,115,1,1088,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1089,0)="    ""choices"":["
^YTT(601.712,115,1,1090,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1091,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1092,0)="   ]}, "
^YTT(601.712,115,1,1093,0)="   {""id"": ""q8163"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1094,0)="    ""text"": ""149. I'm a loner and I don't mind it."", "
^YTT(601.712,115,1,1095,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1096,0)="    ""choices"":["
^YTT(601.712,115,1,1097,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1098,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1099,0)="   ]}, "
^YTT(601.712,115,1,1100,0)="   {""id"": ""q8164"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1101,0)="    ""text"": ""150. I still feel terrified when I think of a traumatic experience I had years"
^YTT(601.712,115,1,1102,0)=" ago."", "
^YTT(601.712,115,1,1103,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1104,0)="    ""choices"":["
^YTT(601.712,115,1,1105,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1106,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1107,0)="   ]}, "
^YTT(601.712,115,1,1108,0)="   {""id"": ""q8165"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1109,0)="    ""text"": ""151. For some time now, I've been feeling very guilty because I can't do things"
^YTT(601.712,115,1,1110,0)=" right anymore."", "
^YTT(601.712,115,1,1111,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1112,0)="    ""choices"":["
^YTT(601.712,115,1,1113,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1114,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1115,0)="   ]}, "
^YTT(601.712,115,1,1116,0)="   {""id"": ""q8166"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1117,0)="    ""text"": ""152. Punishment never stopped me from doing what I wanted."", "
^YTT(601.712,115,1,1118,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1119,0)="    ""choices"":["
^YTT(601.712,115,1,1120,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1121,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1122,0)="   ]}, "
^YTT(601.712,115,1,1123,0)="   {""id"": ""q8167"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1124,0)="    ""text"": ""153. I rarely believe what people tell me."", "
^YTT(601.712,115,1,1125,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1126,0)="    ""choices"":["
^YTT(601.712,115,1,1127,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,115,1,1128,0)="     {""id"": ""c3920"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,115,1,1129,0)="   ]}, "
^YTT(601.712,115,1,1130,0)="   {""id"": ""q8168"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,115,1,1131,0)="    ""text"": ""154. I'm a very sociable and outgoing person."", "
^YTT(601.712,115,1,1132,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1133,0)="    ""choices"":["
^YTT(601.712,115,1,1134,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
