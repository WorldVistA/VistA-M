^YTT(601.712,108,1,29,0)="    ""choices"":["
^YTT(601.712,108,1,30,0)="     {""id"": ""c3792"", ""text"": ""1. As much as I always could"", ""quickKey"": 1}, "
^YTT(601.712,108,1,31,0)="     {""id"": ""c3793"", ""text"": ""2. Not quite so much now"", ""quickKey"": 2}, "
^YTT(601.712,108,1,32,0)="     {""id"": ""c3794"", ""text"": ""3. Definitely not so much now"", ""quickKey"": 3}, "
^YTT(601.712,108,1,33,0)="     {""id"": ""c3795"", ""text"": ""4. Not at all"", ""quickKey"": 4}"
^YTT(601.712,108,1,34,0)="   ]}, "
^YTT(601.712,108,1,35,0)="   {""id"": ""q7935"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,108,1,36,0)="    ""text"": ""2. I have looked forward with enjoyment to things"", "
