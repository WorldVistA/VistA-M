^YTT(601.712,198,1,1,0)="{""name"": ""NSI FOR TBI"", "
^YTT(601.712,198,1,2,0)=" ""copyright"": ""Used with permission: Cicerone,KD: J Head Tr Rehabil 1995;10(3):1-17"", "
^YTT(601.712,198,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,198,1,4,0)=" ""printTitle"": ""Neurobehavioral Symptom Inventory for Traumatic Brain Injury"", "
^YTT(601.712,198,1,5,0)=" ""content"":["
^YTT(601.712,198,1,6,0)="   {""id"": ""i2617"", ""type"": ""IntroText"", "
^YTT(601.712,198,1,7,0)="    ""text"": ""Symptom Report <br />Please rate the following symptoms with regard to how much"
^YTT(601.712,198,1,8,0)=" they have disturbed you SINCE YOUR INJURY.  The purpose of this inventory is to"
^YTT(601.712,198,1,9,0)=" track symptoms over time. Please do not attempt to score."""
^YTT(601.712,198,1,10,0)="    }, "
^YTT(601.712,198,1,11,0)="   {""id"": ""q9567"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,198,1,12,0)="    ""text"": ""1. Feeling dizzy"", "
^YTT(601.712,198,1,13,0)="    ""intro"": ""Symptom Report <br />Please rate the following symptoms with regard to how much"
^YTT(601.712,198,1,14,0)=" they have disturbed you SINCE YOUR INJURY.  The purpose of this inventory is to"
^YTT(601.712,198,1,15,0)=" track symptoms over time. Please do not attempt to score."", "
^YTT(601.712,198,1,16,0)="    ""columns"": 1, "
^YTT(601.712,198,1,17,0)="    ""choices"":["
^YTT(601.712,198,1,18,0)="     {""id"": ""c6175"", ""text"": ""0. None - Rarely if ever present; not a problem at all"", ""quickKey"": 0}, "
^YTT(601.712,198,1,19,0)="     {""id"": ""c6176"", ""text"": ""1. Mild - Occasionally present, but it does not disrupt my activities; I can"
^YTT(601.712,198,1,20,0)=" usually continue what I'm doing; doesn't really concern me."", ""quickKey"": 1}, "
^YTT(601.712,198,1,21,0)="     {""id"": ""c6177"", ""text"": ""2. Moderate - Often present, occasionally disrupts my activities; I can usually"
^YTT(601.712,198,1,22,0)=" continue what I'm doing with some effort; I feel somewhat concerned."", ""quickKey"": 2}, "
^YTT(601.712,198,1,23,0)="     {""id"": ""c6178"", ""text"": ""3. Severe -  Frequently present and disrupts activities; I can only do things"
^YTT(601.712,198,1,24,0)=" that are fairly simple or take little effort; I feel I need help."", ""quickKey"": 3}, "
^YTT(601.712,198,1,25,0)="     {""id"": ""c6179"", ""text"": ""4. Very Severe - Almost always present and I have been unable to perform at work,"
^YTT(601.712,198,1,26,0)=" school or home due to this."", ""quickKey"": 4}"
^YTT(601.712,198,1,27,0)="   ]}, "
^YTT(601.712,198,1,28,0)="   {""id"": ""q9568"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,198,1,29,0)="    ""text"": ""2. Loss of balance"", "
^YTT(601.712,198,1,30,0)="    ""intro"": ""Symptom Report <br />Please rate the following symptoms with regard to how much"
^YTT(601.712,198,1,31,0)=" they have disturbed you SINCE YOUR INJURY.  The purpose of this inventory is to"
^YTT(601.712,198,1,32,0)=" track symptoms over time. Please do not attempt to score."", "
^YTT(601.712,198,1,33,0)="    ""columns"": 1, "
^YTT(601.712,198,1,34,0)="    ""choices"":["
^YTT(601.712,198,1,35,0)="     {""id"": ""c6175"", ""text"": ""0. None - Rarely if ever present; not a problem at all"", ""quickKey"": 0}, "
^YTT(601.712,198,1,36,0)="     {""id"": ""c6176"", ""text"": ""1. Mild - Occasionally present, but it does not disrupt my activities; I can"
^YTT(601.712,198,1,37,0)=" usually continue what I'm doing; doesn't really concern me."", ""quickKey"": 1}, "
^YTT(601.712,198,1,38,0)="     {""id"": ""c6177"", ""text"": ""2. Moderate - Often present, occasionally disrupts my activities; I can usually"
^YTT(601.712,198,1,39,0)=" continue what I'm doing with some effort; I feel somewhat concerned."", ""quickKey"": 2}, "
^YTT(601.712,198,1,40,0)="     {""id"": ""c6178"", ""text"": ""3. Severe -  Frequently present and disrupts activities; I can only do things"
^YTT(601.712,198,1,41,0)=" that are fairly simple or take little effort; I feel I need help."", ""quickKey"": 3}, "
^YTT(601.712,198,1,42,0)="     {""id"": ""c6179"", ""text"": ""4. Very Severe - Almost always present and I have been unable to perform at work,"
^YTT(601.712,198,1,43,0)=" school or home due to this."", ""quickKey"": 4}"
^YTT(601.712,198,1,44,0)="   ]}, "
^YTT(601.712,198,1,45,0)="   {""id"": ""q9569"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,198,1,46,0)="    ""text"": ""3. Poor coordination, clumsy"", "
^YTT(601.712,198,1,47,0)="    ""intro"": ""Symptom Report <br />Please rate the following symptoms with regard to how much"
^YTT(601.712,198,1,48,0)=" they have disturbed you SINCE YOUR INJURY.  The purpose of this inventory is to"
^YTT(601.712,198,1,49,0)=" track symptoms over time. Please do not attempt to score."", "
^YTT(601.712,198,1,50,0)="    ""columns"": 1, "
^YTT(601.712,198,1,51,0)="    ""choices"":["
^YTT(601.712,198,1,52,0)="     {""id"": ""c6175"", ""text"": ""0. None - Rarely if ever present; not a problem at all"", ""quickKey"": 0}, "
^YTT(601.712,198,1,53,0)="     {""id"": ""c6176"", ""text"": ""1. Mild - Occasionally present, but it does not disrupt my activities; I can"
^YTT(601.712,198,1,54,0)=" usually continue what I'm doing; doesn't really concern me."", ""quickKey"": 1}, "
