^YTT(601.712,160,1,9,0)="   {""id"": ""q8974"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": true, "
^YTT(601.712,160,1,10,0)="    ""text"": ""1. Are you ever troubled by breathlessness except on strenuous exertion?"", "
