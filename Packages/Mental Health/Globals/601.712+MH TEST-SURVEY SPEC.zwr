^YTT(601.712,7,1,7,0)="   {""id"": ""i8"", ""type"": ""IntroText"", "
^YTT(601.712,7,1,8,0)="    ""text"": ""A list of common symptoms of anxiety will be presented. Please read each item"
^YTT(601.712,7,1,9,0)=" carefully. Indicate how much you have been bothered by each symptom during the"
^YTT(601.712,7,1,10,0)=" PAST WEEK, INCLUDING TODAY."""
