^YTT(601.712,31,1,9,0)="    }, "
^YTT(601.712,31,1,10,0)="   {""id"": ""q4015"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,31,1,11,0)="    ""text"": ""1. Little interest or pleasure in doing things"", "
^YTT(601.712,31,1,12,0)="    ""intro"": ""Over the past two weeks, how often have you been bothered by the following"
^YTT(601.712,31,1,13,0)=" problems?"", "
^YTT(601.712,31,1,14,0)="    ""columns"": 1, "
^YTT(601.712,31,1,15,0)="    ""choices"":["
^YTT(601.712,31,1,16,0)="     {""id"": ""c212"", ""text"": ""1. Not at all"", ""quickKey"": 1}, "
^YTT(601.712,31,1,17,0)="     {""id"": ""c1008"", ""text"": ""2. Several days"", ""quickKey"": 2}, "
^YTT(601.712,31,1,18,0)="     {""id"": ""c1009"", ""text"": ""3. More than half the days"", ""quickKey"": 3}, "
^YTT(601.712,31,1,19,0)="     {""id"": ""c1010"", ""text"": ""4. Nearly every day"", ""quickKey"": 4}"
^YTT(601.712,31,1,20,0)="   ]}, "
^YTT(601.712,31,1,21,0)="   {""id"": ""i966"", ""type"": ""IntroText"", "
^YTT(601.712,31,1,22,0)="    ""text"": ""Over the past two weeks, how often have you been bothered by the following"
^YTT(601.712,31,1,23,0)=" problems?"""
^YTT(601.712,31,1,24,0)="    }, "
^YTT(601.712,31,1,25,0)="   {""id"": ""q4016"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,31,1,26,0)="    ""text"": ""2. Feeling down, depressed, or hopeless"", "
^YTT(601.712,31,1,27,0)="    ""intro"": ""Over the past two weeks, how often have you been bothered by the following"
^YTT(601.712,31,1,28,0)=" problems?"", "
