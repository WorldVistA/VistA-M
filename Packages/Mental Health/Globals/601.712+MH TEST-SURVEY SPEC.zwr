^YTT(601.712,17,1,545,0)="    ""text"": ""73. I often allow others to make important decisions for me."", "
^YTT(601.712,17,1,546,0)="    "
^YTT(601.712,17,1,547,0)="    ""choices"":["
^YTT(601.712,17,1,548,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
