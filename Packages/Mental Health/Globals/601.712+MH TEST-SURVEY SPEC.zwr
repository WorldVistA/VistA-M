^YTT(601.712,180,1,63,0)="     {""id"": ""c5778"", ""text"": ""9 "", ""quickKey"": 9}, "
^YTT(601.712,180,1,64,0)="     {""id"": ""c5779"", ""text"": ""10 "", ""quickKey"": 10}"
^YTT(601.712,180,1,65,0)="   ]}, "
^YTT(601.712,180,1,66,0)="   {""id"": ""q9252"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,180,1,67,0)="    ""text"": ""3. Functioning your best in the most important things you do?"", "
^YTT(601.712,180,1,68,0)="    ""intro"": ""For these questions, please consider the most important things that you do, or"
^YTT(601.712,180,1,69,0)=" wish to do, in your daily life. <br /><i>[This might include having a job,"
^YTT(601.712,180,1,70,0)=" managing your health and finances, spending time with family and friends,"
^YTT(601.712,180,1,71,0)=" or participating in leisure-time activities.] </i><br /> <br /><strong>If you are not"
^YTT(601.712,180,1,72,0)=" sure which response to choose, please make your best guess.</strong>  <br /> <br /><strong>Over"
^YTT(601.712,180,1,73,0)=" the past month,</strong> on average how often have you been: <br /> <br />Use the following"
^YTT(601.712,180,1,74,0)=" scale <br />0    -    1    -    2    -    3    -    4    -    5    -    6    -  "
^YTT(601.712,180,1,75,0)="  7    -    8    -    9    -    10 <br />None of the Time                        "
^YTT(601.712,180,1,76,0)="                                           All of the time "
^YTT(601.712,180,1,77,0)=" "", "
^YTT(601.712,180,1,78,0)="    ""columns"": 11, "
^YTT(601.712,180,1,79,0)="    ""choices"":["
^YTT(601.712,180,1,80,0)="     {""id"": ""c5769"", ""text"": ""0 "", ""quickKey"": 0}, "
