^YTT(601.712,96,1,5,0)=" ""printTitle"": ""Patient Safety Screener 3 (PSS-3)"","
^YTT(601.712,96,1,6,0)=" ""content"":["
^YTT(601.712,96,1,7,0)="   {""id"": ""i2350"", ""type"": ""IntroText"", "
^YTT(601.712,96,1,8,0)="    ""text"": ""Please read each item carefully and give your best response."""
^YTT(601.712,96,1,9,0)="    }, "
^YTT(601.712,96,1,10,0)="   {""id"": ""q7789"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,96,1,11,0)="    ""text"": ""1. Over the past 2 weeks, have you felt down, depressed, or hopeless?"", "
^YTT(601.712,96,1,12,0)="    ""intro"": ""Please read each item carefully and give your best response."", "
^YTT(601.712,96,1,13,0)="    ""columns"": 1, "
^YTT(601.712,96,1,14,0)="    ""choices"":["
^YTT(601.712,96,1,15,0)="     {""id"": ""c3632"", ""text"": ""1. Yes"", ""quickKey"": 1}, "
^YTT(601.712,96,1,16,0)="     {""id"": ""c3633"", ""text"": ""2. No"", ""quickKey"": 2}"
^YTT(601.712,96,1,17,0)="   ]}, "
^YTT(601.712,96,1,18,0)="   {""id"": ""q7790"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,96,1,19,0)="    ""text"": ""2. Over the past 2 weeks, have you had thoughts of killing yourself?"", "
^YTT(601.712,96,1,20,0)="    ""intro"": ""Please read each item carefully and give your best response."", "
^YTT(601.712,96,1,21,0)="    ""columns"": 1, "
^YTT(601.712,96,1,22,0)="    ""choices"":["
^YTT(601.712,96,1,23,0)="     {""id"": ""c3632"", ""text"": ""1. Yes"", ""quickKey"": 1}, "
^YTT(601.712,96,1,24,0)="     {""id"": ""c3633"", ""text"": ""2. No"", ""quickKey"": 2}"
^YTT(601.712,96,1,25,0)="   ]}, "
^YTT(601.712,96,1,26,0)="   {""id"": ""q7791"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,96,1,27,0)="    ""text"": ""3. In your lifetime, have you ever attempted to kill yourself?"", "
^YTT(601.712,96,1,28,0)="    ""columns"": 1, "
^YTT(601.712,96,1,29,0)="    ""choices"":["
^YTT(601.712,96,1,30,0)="     {""id"": ""c3632"", ""text"": ""1. Yes"", ""quickKey"": 1}, "
^YTT(601.712,96,1,31,0)="     {""id"": ""c3633"", ""text"": ""2. No"", ""quickKey"": 2}"
^YTT(601.712,96,1,32,0)="   ]}, "
^YTT(601.712,96,1,33,0)="   {""id"": ""q7792"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,96,1,34,0)="    ""text"": ""3.1. If \u0022Yes\u0022: When was the last time you attempted to kill yourself?"", "
^YTT(601.712,96,1,35,0)="    ""columns"": 1, "
^YTT(601.712,96,1,36,0)="    ""choices"":["
^YTT(601.712,96,1,37,0)="     {""id"": ""c3635"", ""text"": ""1. Within the past 24 hours (including today)"", ""quickKey"": 1}, "
^YTT(601.712,96,1,38,0)="     {""id"": ""c3636"", ""text"": ""2. Within the last month (but not today)  "", ""quickKey"": 2}, "
^YTT(601.712,96,1,39,0)="     {""id"": ""c3637"", ""text"": ""3. Between 1 and 6 months ago  "", ""quickKey"": 3}, "
^YTT(601.712,96,1,40,0)="     {""id"": ""c3638"", ""text"": ""4. More than 6 months ago"", ""quickKey"": 4}, "
^YTT(601.712,96,1,41,0)="     {""id"": ""c3639"", ""text"": ""5. I Don't Know"", ""quickKey"": 5}"
^YTT(601.712,96,1,42,0)="   ]}], "
^YTT(601.712,96,1,43,0)=" ""rules"":["
^YTT(601.712,96,1,44,0)="   {""question"": ""q7791"", ""operator"": ""EQ"", ""value"": ""c3633"", "
^YTT(601.712,96,1,45,0)="    ""skips"":[""q7792""]}]"
^YTT(601.712,96,1,46,0)="}"
