^YTT(601.712,28,1,1,0)="{""name"": ""COWS"", "
^YTT(601.712,28,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,28,1,3,0)=" ""printTitle"": ""Clinical Opiate Withdrawal Scale"","
^YTT(601.712,28,1,4,0)=" ""content"":["
^YTT(601.712,28,1,5,0)="   {""id"": ""i512"", ""type"": ""IntroText"", "
^YTT(601.712,28,1,6,0)="    ""text"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,7,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,8,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,9,0)=" assessment, the increase pulse rate would not add to the score.  """
^YTT(601.712,28,1,10,0)="    }, "
^YTT(601.712,28,1,11,0)="   {""id"": ""q4022"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,12,0)="    ""text"": ""1. Resting Pulse Rate: Measured after patient is sitting or lying for one minute."", "
^YTT(601.712,28,1,13,0)="    ""intro"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,14,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,15,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,16,0)=" assessment, the increase pulse rate would not add to the score.  "", "
^YTT(601.712,28,1,17,0)="    ""columns"": 1, "
^YTT(601.712,28,1,18,0)="    ""choices"":["
^YTT(601.712,28,1,19,0)="     {""id"": ""c2628"", ""text"": ""0. Pulse rate 80 or below (Score 0)"", ""quickKey"": 0}, "
^YTT(601.712,28,1,20,0)="     {""id"": ""c2629"", ""text"": ""1. Pulse rate 81 - 100 (Score 1)"", ""quickKey"": 1}, "
^YTT(601.712,28,1,21,0)="     {""id"": ""c2662"", ""text"": ""2. Pulse rate 101 - 120 (Score 2)"", ""quickKey"": 2}, "
^YTT(601.712,28,1,22,0)="     {""id"": ""c2663"", ""text"": ""3. Pulse rate greater than 120 (Score 4)"", ""quickKey"": 3}"
^YTT(601.712,28,1,23,0)="   ]}, "
^YTT(601.712,28,1,24,0)="   {""id"": ""q4033"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,25,0)="    ""text"": ""2. Sweating: Over past half-hour, not accounted for by room temperature or"
^YTT(601.712,28,1,26,0)=" patient activity."", "
^YTT(601.712,28,1,27,0)="    ""intro"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,28,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,29,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,30,0)=" assessment, the increase pulse rate would not add to the score.  "", "
^YTT(601.712,28,1,31,0)="    ""columns"": 1, "
^YTT(601.712,28,1,32,0)="    ""choices"":["
^YTT(601.712,28,1,33,0)="     {""id"": ""c2664"", ""text"": ""0. No report of chills or flushing (Score 0)"", ""quickKey"": 0}, "
^YTT(601.712,28,1,34,0)="     {""id"": ""c2665"", ""text"": ""1. Subjective report of chills or flushing (Score 1)"", ""quickKey"": 1}, "
^YTT(601.712,28,1,35,0)="     {""id"": ""c2666"", ""text"": ""2. Flushed or observable moistness on face (Score 2)"", ""quickKey"": 2}, "
^YTT(601.712,28,1,36,0)="     {""id"": ""c2667"", ""text"": ""3. Beads of sweat on brow or face (Score 3)"", ""quickKey"": 3}, "
^YTT(601.712,28,1,37,0)="     {""id"": ""c2668"", ""text"": ""4. Sweat streaming off face (Score 4)"", ""quickKey"": 4}"
^YTT(601.712,28,1,38,0)="   ]}, "
^YTT(601.712,28,1,39,0)="   {""id"": ""q4035"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,40,0)="    ""text"": ""3. Restlessness: Observation during assessment."", "
^YTT(601.712,28,1,41,0)="    ""intro"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,42,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,43,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,44,0)=" assessment, the increase pulse rate would not add to the score.  "", "
^YTT(601.712,28,1,45,0)="    ""columns"": 1, "
^YTT(601.712,28,1,46,0)="    ""choices"":["
^YTT(601.712,28,1,47,0)="     {""id"": ""c2669"", ""text"": ""0. Able to sit still (Score 0)"", ""quickKey"": 0}, "
^YTT(601.712,28,1,48,0)="     {""id"": ""c2670"", ""text"": ""1. Reports difficulty sitting still, but is able to do so (Score 1)"", ""quickKey"": 1}, "
^YTT(601.712,28,1,49,0)="     {""id"": ""c2671"", ""text"": ""2. Frequent shifting or extraneous movements of legs/arms (Score 3)"", ""quickKey"": 2}, "
^YTT(601.712,28,1,50,0)="     {""id"": ""c2672"", ""text"": ""3. Unable to sit still for more than a few seconds (Score 5)"", ""quickKey"": 3}"
^YTT(601.712,28,1,51,0)="   ]}, "
^YTT(601.712,28,1,52,0)="   {""id"": ""q4036"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,53,0)="    ""text"": ""4. Pupil size."", "
^YTT(601.712,28,1,54,0)="    ""intro"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,55,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,56,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,57,0)=" assessment, the increase pulse rate would not add to the score.  "", "
^YTT(601.712,28,1,58,0)="    ""columns"": 1, "
^YTT(601.712,28,1,59,0)="    ""choices"":["
^YTT(601.712,28,1,60,0)="     {""id"": ""c2673"", ""text"": ""0. Pupils pinned or normal size for room light (Score 0)"", ""quickKey"": 0}, "
^YTT(601.712,28,1,61,0)="     {""id"": ""c2674"", ""text"": ""1. Pupils possibly larger than normal for room light (Score 1)"", ""quickKey"": 1}, "
^YTT(601.712,28,1,62,0)="     {""id"": ""c2675"", ""text"": ""2. Pupils moderately dilated (Score 2)"", ""quickKey"": 2}, "
^YTT(601.712,28,1,63,0)="     {""id"": ""c2676"", ""text"": ""3. Pupils so dilated that only the rim of the iris is visible (Score 5)"", ""quickKey"": 3}"
^YTT(601.712,28,1,64,0)="   ]}, "
^YTT(601.712,28,1,65,0)="   {""id"": ""q4037"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,66,0)="    ""text"": ""5. Bone or joint aches: If patient was having pain previously, only the"
^YTT(601.712,28,1,67,0)=" additional component attributed to opiates withdrawal is scored."", "
^YTT(601.712,28,1,68,0)="    ""intro"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,69,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,70,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,71,0)=" assessment, the increase pulse rate would not add to the score.  "", "
^YTT(601.712,28,1,72,0)="    ""columns"": 1, "
^YTT(601.712,28,1,73,0)="    ""choices"":["
^YTT(601.712,28,1,74,0)="     {""id"": ""c2677"", ""text"": ""0. Not present (Score 0)"", ""quickKey"": 0}, "
^YTT(601.712,28,1,75,0)="     {""id"": ""c2678"", ""text"": ""1. Mild diffuse discomfort (Score 1)"", ""quickKey"": 1}, "
^YTT(601.712,28,1,76,0)="     {""id"": ""c2679"", ""text"": ""2. Patient reports severe diffuse aching of joints or muscles (Score 2)"", ""quickKey"": 2}, "
^YTT(601.712,28,1,77,0)="     {""id"": ""c2680"", ""text"": ""3. Patient is rubbing joints or muscles and is unable to sit still because of"
^YTT(601.712,28,1,78,0)=" discomfort (Score 4)"", ""quickKey"": 3}"
^YTT(601.712,28,1,79,0)="   ]}, "
^YTT(601.712,28,1,80,0)="   {""id"": ""q4038"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,28,1,81,0)="    ""text"": ""6. Runny nose or tearing: Not accounted for by cold symptoms or allergies."", "
^YTT(601.712,28,1,82,0)="    ""intro"": ""For each item, select the best description of the patient's signs or symptom."
^YTT(601.712,28,1,83,0)=" Rate on just the apparent relationship to opiate withdrawal. For example, if"
^YTT(601.712,28,1,84,0)=" heart rate is increased because the patient  was jogging just prior to"
^YTT(601.712,28,1,85,0)=" assessment, the increase pulse rate would not add to the score.  "", "
^YTT(601.712,28,1,86,0)="    ""columns"": 1, "
