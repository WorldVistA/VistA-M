^YTT(601.712,62,1,84,0)="   ]}, "
^YTT(601.712,62,1,85,0)="   {""id"": ""q5538"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,62,1,86,0)="    ""text"": "" Recall of SECOND WORD"", "
^YTT(601.712,62,1,87,0)="    ""intro"": ""<strong>Step 3: Three Word Recall</strong><br /><br />Ask the person to recall the three words you"
^YTT(601.712,62,1,88,0)=" stated in Step 1. Say: \u0022What were the three words I asked you to"
^YTT(601.712,62,1,89,0)=" remember?\u0022 <br /><br /><small>[A correct response is spontaneously recalled"
