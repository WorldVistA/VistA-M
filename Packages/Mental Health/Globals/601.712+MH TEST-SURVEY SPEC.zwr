^YTT(601.712,128,1,34,0)="     {""id"": ""c5016"", ""text"": ""1. Once or a few times"", ""quickKey"": 1}, "
^YTT(601.712,128,1,35,0)="     {""id"": ""c5017"", ""text"": ""2. Once or twice a week"", ""quickKey"": 2}, "
^YTT(601.712,128,1,36,0)="     {""id"": ""c5018"", ""text"": ""3. Daily or almost daily"", ""quickKey"": 3}"
^YTT(601.712,128,1,37,0)="   ]}, "
