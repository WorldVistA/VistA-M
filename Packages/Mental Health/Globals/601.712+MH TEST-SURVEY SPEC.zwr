^YTT(601.712,193,1,6,0)="   {""id"": ""i2606"", ""type"": ""IntroText"", "
^YTT(601.712,193,1,7,0)="    ""text"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,193,1,8,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,193,1,9,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,193,1,10,0)=" recorded here so that the administration can be saved in VistA. <br /> Read list"
^YTT(601.712,193,1,11,0)=" of words to be recalled. <br /> <br />1. Attention"""
^YTT(601.712,193,1,12,0)="    }, "
^YTT(601.712,193,1,13,0)="   {""id"": ""q9494"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,193,1,14,0)="    ""text"": ""1A. Forward Digit Span."", "
^YTT(601.712,193,1,15,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,193,1,16,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
