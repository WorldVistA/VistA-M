^YTT(601.712,35,1,6,0)="   {""id"": ""q5260"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,35,1,7,0)="    ""text"": ""1. Do you feel that because of the time you spend with your relative that you do"
