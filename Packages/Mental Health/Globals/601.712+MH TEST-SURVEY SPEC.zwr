^YTT(601.712,121,1,6,0)="   {""id"": ""i2392"", ""type"": ""IntroText"", "
^YTT(601.712,121,1,7,0)="    ""text"": ""This questionnaire will help you and your healthcare professional measure the"
^YTT(601.712,121,1,8,0)=" impact COPD (Chronic Obstructive Pulmonary Disease) is having on your well-being"
^YTT(601.712,121,1,9,0)=" and daily life. Your answers, and test score, can be used by you and your"
^YTT(601.712,121,1,10,0)=" healthcare professional to help improve the management of your COPD and get the"
^YTT(601.712,121,1,11,0)=" greatest benefit from treatment.<br /><br /> For each item below, select the"
^YTT(601.712,121,1,12,0)=" number that best describes you currently."""
^YTT(601.712,121,1,13,0)="    }, "
