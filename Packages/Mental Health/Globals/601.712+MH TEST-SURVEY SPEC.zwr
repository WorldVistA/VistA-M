^YTT(601.712,127,1,135,0)="     {""id"": ""c5007"", ""text"": ""1. 0-10 minutes"", ""quickKey"": 1}, "
^YTT(601.712,127,1,136,0)="     {""id"": ""c5008"", ""text"": ""2. 11-20 minutes"", ""quickKey"": 2}, "
^YTT(601.712,127,1,137,0)="     {""id"": ""c5009"", ""text"": ""3. 21-40 minutes"", ""quickKey"": 3}, "
^YTT(601.712,127,1,138,0)="     {""id"": ""c5010"", ""text"": ""4. More than 40 minutes"", ""quickKey"": 4}"
^YTT(601.712,127,1,139,0)="   ]}, "
^YTT(601.712,127,1,140,0)="   {""id"": ""q8482"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
