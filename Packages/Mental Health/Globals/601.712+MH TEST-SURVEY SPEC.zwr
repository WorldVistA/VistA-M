^YTT(601.712,74,1,383,0)=" doing things together like visiting, talking on the telephone, or helping each"
^YTT(601.712,74,1,384,0)=" other out.(If you have no living RELATIVES, answer question 25 as \u0022Not"
^YTT(601.712,74,1,385,0)=" Important\u0022 and do not answer question 26). """
^YTT(601.712,74,1,386,0)="    }, "
