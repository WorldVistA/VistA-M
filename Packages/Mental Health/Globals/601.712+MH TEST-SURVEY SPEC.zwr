^YTT(601.712,139,1,5,0)=" ""content"":["
^YTT(601.712,139,1,6,0)="   {""id"": ""i2460"", ""type"": ""IntroText"", "
^YTT(601.712,139,1,7,0)="    ""text"": ""After reading some statements about employment, please rank the following by"
^YTT(601.712,139,1,8,0)=" selecting a number on a scale of 0 to 10, <br />where 0 indicates strong"
^YTT(601.712,139,1,9,0)=" disagreement to the statement, 10 indicates strong agreement, and 5 indicates"
^YTT(601.712,139,1,10,0)=" neutral."""
^YTT(601.712,139,1,11,0)="    }, "
^YTT(601.712,139,1,12,0)="   {""id"": ""q8651"", ""type"": ""SliderQuestion"", ""required"": true, "
^YTT(601.712,139,1,13,0)="    ""text"": ""1. When working or looking for a job, I am respectful towards who I am."", "
^YTT(601.712,139,1,14,0)="    ""intro"": ""After reading some statements about employment, please rank the following by"
^YTT(601.712,139,1,15,0)=" selecting a number on a scale of 0 to 10, <br />where 0 indicates strong"
^YTT(601.712,139,1,16,0)=" disagreement to the statement, 10 indicates strong agreement, and 5 indicates"
^YTT(601.712,139,1,17,0)=" neutral."", "
^YTT(601.712,139,1,18,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,139,1,19,0)="    ""legend"":[""Strongly disagree"", ""Neutral"", ""Strongly agree""]}, "
^YTT(601.712,139,1,20,0)="   {""id"": ""q8652"", ""type"": ""SliderQuestion"", ""required"": true, "
^YTT(601.712,139,1,21,0)="    ""text"": ""2. I am worthy of working in a good job."", "
