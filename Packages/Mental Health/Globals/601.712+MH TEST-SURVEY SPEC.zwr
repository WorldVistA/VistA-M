^YTT(601.712,52,1,1,0)="{""name"": ""WHYMPI"", "
^YTT(601.712,52,1,2,0)=" ""copyright"": ""Copyright (c) 1985, Robert D. Kerns, Dennis C. Turk and Thomas E. Rudy."", "
^YTT(601.712,52,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,52,1,4,0)=" ""printTitle"": ""West Haven-Yale Multidimensional Pain Inventory"","
^YTT(601.712,52,1,5,0)=" ""content"":["
^YTT(601.712,52,1,6,0)="   {""id"": ""i585"", ""type"": ""IntroText"", "
^YTT(601.712,52,1,7,0)="    ""text"": ""Some of the questions in this questionnaire refer to your \u0022significant"
^YTT(601.712,52,1,8,0)=" other.\u0022 A significant other is a person with whom you feel closest. This"
^YTT(601.712,52,1,9,0)=" includes anyone that you relate to on a regular or  infrequent basis. It is very"
^YTT(601.712,52,1,10,0)=" important that you identify someone as your \u0022significant other.\u0022  """
^YTT(601.712,52,1,11,0)="    }, "
^YTT(601.712,52,1,12,0)="   {""id"": ""q5199"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,52,1,13,0)="    ""text"": ""1. Please indicate who your significant other is:"", "
^YTT(601.712,52,1,14,0)="    ""intro"": ""Some of the questions in this questionnaire refer to your \u0022significant"
^YTT(601.712,52,1,15,0)=" other.\u0022 A significant other is a person with whom you feel closest. This"
^YTT(601.712,52,1,16,0)=" includes anyone that you relate to on a regular or  infrequent basis. It is very"
^YTT(601.712,52,1,17,0)=" important that you identify someone as your \u0022significant other.\u0022  "", "
^YTT(601.712,52,1,18,0)="    ""columns"": 2, "
^YTT(601.712,52,1,19,0)="    ""choices"":["
^YTT(601.712,52,1,20,0)="     {""id"": ""c2140"", ""text"": ""1. Spouse"", ""quickKey"": 1}, "
^YTT(601.712,52,1,21,0)="     {""id"": ""c2588"", ""text"": ""2. Partner/Companion"", ""quickKey"": 2}, "
^YTT(601.712,52,1,22,0)="     {""id"": ""c2589"", ""text"": ""3. House/Roommate"", ""quickKey"": 3}, "
^YTT(601.712,52,1,23,0)="     {""id"": ""c2590"", ""text"": ""4. Friend"", ""quickKey"": 4}, "
^YTT(601.712,52,1,24,0)="     {""id"": ""c2591"", ""text"": ""5. Neighbor"", ""quickKey"": 5}, "
^YTT(601.712,52,1,25,0)="     {""id"": ""c2592"", ""text"": ""6. Parent/Child/Other relative"", ""quickKey"": 6}, "
^YTT(601.712,52,1,26,0)="     {""id"": ""c2593"", ""text"": ""7. Other (please describe)"", ""quickKey"": 7}"
^YTT(601.712,52,1,27,0)="   ]}, "
^YTT(601.712,52,1,28,0)="   {""id"": ""q5200"", ""type"": ""StringQuestion"", ""required"": false, "
^YTT(601.712,52,1,29,0)="    ""text"": "" Significant other:"", "
^YTT(601.712,52,1,30,0)="    ""intro"": ""Some of the questions in this questionnaire refer to your \u0022significant"
^YTT(601.712,52,1,31,0)=" other.\u0022 A significant other is a person with whom you feel closest. This"
^YTT(601.712,52,1,32,0)=" includes anyone that you relate to on a regular or  infrequent basis. It is very"
^YTT(601.712,52,1,33,0)=" important that you identify someone as your \u0022significant other.\u0022  "", "
^YTT(601.712,52,1,34,0)="    ""controlWidth"": 500, ""min"": 0, ""max"": 0}, "
^YTT(601.712,52,1,35,0)="   {""id"": ""q5201"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,52,1,36,0)="    ""text"": ""2. Do you currently live with this person?"", "
^YTT(601.712,52,1,37,0)="    ""intro"": ""Some of the questions in this questionnaire refer to your \u0022significant"
^YTT(601.712,52,1,38,0)=" other.\u0022 A significant other is a person with whom you feel closest. This"
^YTT(601.712,52,1,39,0)=" includes anyone that you relate to on a regular or  infrequent basis. It is very"
^YTT(601.712,52,1,40,0)=" important that you identify someone as your \u0022significant other.\u0022  "", "
^YTT(601.712,52,1,41,0)="    ""columns"": 2, "
^YTT(601.712,52,1,42,0)="    ""choices"":["
^YTT(601.712,52,1,43,0)="     {""id"": ""c241"", ""text"": ""1. Yes"", ""quickKey"": 1}, "
^YTT(601.712,52,1,44,0)="     {""id"": ""c237"", ""text"": ""2. No"", ""quickKey"": 2}"
^YTT(601.712,52,1,45,0)="   ]}, "
^YTT(601.712,52,1,46,0)="   {""id"": ""i586"", ""type"": ""IntroText"", "
^YTT(601.712,52,1,47,0)="    ""text"": ""A.<br />In the following 20 questions, you will be asked to describe your pain"
^YTT(601.712,52,1,48,0)=" and how it affects your life. Under each question is a scale to record your"
^YTT(601.712,52,1,49,0)=" answer. Read each question carefully and then select  the number on the scale to"
^YTT(601.712,52,1,50,0)=" indicate how that specific question applies to you. You can click on the number"
^YTT(601.712,52,1,51,0)=" with the mouse or enter the number on the key board.  """
^YTT(601.712,52,1,52,0)="    }, "
^YTT(601.712,52,1,53,0)="   {""id"": ""q5202"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,52,1,54,0)="    ""text"": ""A1. Rate the level of your pain at the present moment."", "
^YTT(601.712,52,1,55,0)="    ""intro"": ""In the following 20 questions, you will be asked to describe your pain and how it"
^YTT(601.712,52,1,56,0)=" affects your life. Under each question is a scale to record your answer. Read"
^YTT(601.712,52,1,57,0)=" each question carefully and then select  the number on the scale to indicate how"
^YTT(601.712,52,1,58,0)=" that specific question applies to you. You can click on the number with the"
^YTT(601.712,52,1,59,0)=" mouse or enter the number on the key board.  "", "
^YTT(601.712,52,1,60,0)="    ""min"": 0, ""max"": 6, "
^YTT(601.712,52,1,61,0)="    ""legend"":[""No pain"", "" Very intense pain""]}, "
^YTT(601.712,52,1,62,0)="   {""id"": ""q5203"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,52,1,63,0)="    ""text"": ""A2. In general, how much does your pain problem interfere with your day to day"
^YTT(601.712,52,1,64,0)=" activities?"", "
^YTT(601.712,52,1,65,0)="    ""intro"": ""In the following 20 questions, you will be asked to describe your pain and how it"
^YTT(601.712,52,1,66,0)=" affects your life. Under each question is a scale to record your answer. Read"
^YTT(601.712,52,1,67,0)=" each question carefully and then select  the number on the scale to indicate how"
^YTT(601.712,52,1,68,0)=" that specific question applies to you. You can click on the number with the"
^YTT(601.712,52,1,69,0)=" mouse or enter the number on the key board.  "", "
^YTT(601.712,52,1,70,0)="    ""min"": 0, ""max"": 6, "
^YTT(601.712,52,1,71,0)="    ""legend"":[""No interference"", ""Extreme interference""]}, "
^YTT(601.712,52,1,72,0)="   {""id"": ""q5204"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,52,1,73,0)="    ""text"": "" Are you retired from work for reasons other than your pain problem?"", "
^YTT(601.712,52,1,74,0)="    ""intro"": ""In the following 20 questions, you will be asked to describe your pain and how it"
^YTT(601.712,52,1,75,0)=" affects your life. Under each question is a scale to record your answer. Read"
