^YTT(601.712,151,1,3,0)=" ""printTitle"": ""Safety Behavior Assessment Form"","
^YTT(601.712,151,1,4,0)=" ""content"":["
^YTT(601.712,151,1,5,0)="   {""id"": ""i2482"", ""type"": ""IntroText"","
^YTT(601.712,151,1,6,0)="    ""text"": ""<strong><i>VIGILANCE</i></strong><br /> <br />Below is a list of behaviors that people sometimes use to"
^YTT(601.712,151,1,7,0)=" make themselves feel more comfortable. <br />For each behavior please pick the"
^YTT(601.712,151,1,8,0)=" response that most accurately describes how often or frequently you engage in"
^YTT(601.712,151,1,9,0)=" that behavior."""
^YTT(601.712,151,1,10,0)="    },"
^YTT(601.712,151,1,11,0)="   {""id"": ""q8864"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false,"
^YTT(601.712,151,1,12,0)="    ""text"": ""1. Scope places out before entering"","
