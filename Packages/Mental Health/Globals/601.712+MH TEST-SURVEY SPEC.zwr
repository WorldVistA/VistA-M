^YTT(601.712,97,1,81,0)="     {""id"": ""c106379"", ""text"": "" Patient unable to complete""}"
^YTT(601.712,97,1,82,0)="   ]}, "
^YTT(601.712,97,1,83,0)="   {""id"": ""q7854"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,97,1,84,0)="    ""text"": ""6. Is the patient irritable, agitated, or aggressive? <br />Source: Use current"
^YTT(601.712,97,1,85,0)=" observations, collateral information, medical records review."", "
^YTT(601.712,97,1,86,0)="    ""intro"": ""This is a clinician rating, based on the PSS3 scoring, not designed for"
