^YTT(601.712,94,1,172,0)="    ""legend"":[""Discouraging"", "" Hopeful""]}, "
^YTT(601.712,94,1,173,0)="   {""id"": ""q7294"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,94,1,174,0)="    ""text"": ""17. My relationship is miserable vs. enjoyable:"", "
^YTT(601.712,94,1,175,0)="    ""intro"": ""For each of the following items, select the answer that best describes how you"
