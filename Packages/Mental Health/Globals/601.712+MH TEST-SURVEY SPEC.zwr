^YTT(601.712,104,1,28,0)="     {""id"": ""c106393"", ""text"": ""3. 21-30"", ""quickKey"": 3}, "
^YTT(601.712,104,1,29,0)="     {""id"": ""c106394"", ""text"": ""4. 31 or more"", ""quickKey"": 4}"
^YTT(601.712,104,1,30,0)="   ]}]"
