^YTT(601.712,161,1,786,0)="     {""id"": ""c5561"", ""text"": "" Weakness or movement problems or coordination problems in limbs""},"
^YTT(601.712,161,1,787,0)="     {""id"": ""c5562"", ""text"": "" Tinnitus""},"
