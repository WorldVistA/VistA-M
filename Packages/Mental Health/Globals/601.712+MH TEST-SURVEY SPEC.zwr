^YTT(601.712,94,1,160,0)="    ""text"": ""15. My relationship is fragile vs. sturdy:"", "
^YTT(601.712,94,1,161,0)="    ""intro"": ""For each of the following items, select the answer that best describes how you"
^YTT(601.712,94,1,162,0)=" feel about your relationship. Base your responses on your first impressions and"
^YTT(601.712,94,1,163,0)=" immediate feelings about the item.  "", "
^YTT(601.712,94,1,164,0)="    ""min"": 0, ""max"": 5, "
^YTT(601.712,94,1,165,0)="    ""legend"":[""Fragile"", "" Sturdy""]}, "
^YTT(601.712,94,1,166,0)="   {""id"": ""q6736"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,94,1,167,0)="    ""text"": ""16. My relationship is discouraging vs. hopeful:"", "
