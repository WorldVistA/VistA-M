^YTT(601.712,18,1,4,0)=" ""content"":["
^YTT(601.712,18,1,5,0)="   {""id"": ""i34"", ""type"": ""IntroText"", "
^YTT(601.712,18,1,6,0)="    ""text"": ""Please answer the following questions concerning your attitudes about your"
^YTT(601.712,18,1,7,0)=" health."""
^YTT(601.712,18,1,8,0)="    }, "
^YTT(601.712,18,1,9,0)="   {""id"": ""q1561"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,18,1,10,0)="    ""text"": ""1. If I get sick, it is my own behavior which determines how soon I get well"
^YTT(601.712,18,1,11,0)=" again."", "
^YTT(601.712,18,1,12,0)="    ""intro"": ""Please answer the following questions concerning your attitudes about your"
^YTT(601.712,18,1,13,0)=" health."", "
^YTT(601.712,18,1,14,0)="    "
^YTT(601.712,18,1,15,0)="    ""choices"":["
^YTT(601.712,18,1,16,0)="     {""id"": ""c780"", ""text"": ""1. Strongly disagree"", ""quickKey"": 1}, "
^YTT(601.712,18,1,17,0)="     {""id"": ""c781"", ""text"": ""2. Moderately disagree"", ""quickKey"": 2}, "
^YTT(601.712,18,1,18,0)="     {""id"": ""c964"", ""text"": ""3. Slightly disagree"", ""quickKey"": 3}, "
^YTT(601.712,18,1,19,0)="     {""id"": ""c965"", ""text"": ""4. Slightly agree"", ""quickKey"": 4}, "
^YTT(601.712,18,1,20,0)="     {""id"": ""c784"", ""text"": ""5. Moderately agree"", ""quickKey"": 5}, "
^YTT(601.712,18,1,21,0)="     {""id"": ""c785"", ""text"": ""6. Strongly agree"", ""quickKey"": 6}"
^YTT(601.712,18,1,22,0)="   ]}, "
^YTT(601.712,18,1,23,0)="   {""id"": ""q1562"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,18,1,24,0)="    ""text"": ""2. No matter what I do, if I am going to get sick, I will get sick."", "
^YTT(601.712,18,1,25,0)="    "
^YTT(601.712,18,1,26,0)="    ""choices"":["
^YTT(601.712,18,1,27,0)="     {""id"": ""c780"", ""text"": ""1. Strongly disagree"", ""quickKey"": 1}, "
