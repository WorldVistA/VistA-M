^YTT(601.712,110,1,16,0)="     {""id"": ""c3882"", ""text"": ""1. Less than 5 min."", ""quickKey"": 1}, "
^YTT(601.712,110,1,17,0)="     {""id"": ""c3883"", ""text"": ""2. 6-30 min."", ""quickKey"": 2}, "
^YTT(601.712,110,1,18,0)="     {""id"": ""c3884"", ""text"": ""3. 31-60 min."", ""quickKey"": 3}, "
^YTT(601.712,110,1,19,0)="     {""id"": ""c3885"", ""text"": ""4. After 1 hr."", ""quickKey"": 4}"
^YTT(601.712,110,1,20,0)="   ]}, "
