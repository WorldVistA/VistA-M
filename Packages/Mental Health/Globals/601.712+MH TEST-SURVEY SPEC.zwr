^YTT(601.712,148,1,1,0)="{""name"": ""FAST-ORIGINAL"", "
^YTT(601.712,148,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,148,1,3,0)=" ""printTitle"": ""Placeholder for original FAST questions, choices, and rules"", "
^YTT(601.712,148,1,4,0)=" ""content"":["
^YTT(601.712,148,1,5,0)="   {""id"": ""i584"", ""type"": ""IntroText"", "
^YTT(601.712,148,1,6,0)="    ""text"": ""The FAST scale is a functional scale designed to evaluate patients at the more"
^YTT(601.712,148,1,7,0)=" moderate-severe stages of dementia when the MMSE no longer can reflect changes"
^YTT(601.712,148,1,8,0)=" in a meaningful clinical way. In the early stages the patient may be able to"
^YTT(601.712,148,1,9,0)=" participate in the FAST administration but usually the information should be"
^YTT(601.712,148,1,10,0)=" collected from a caregiver or, in the case of nursing home care, the nursing"
^YTT(601.712,148,1,11,0)=" home staff. The FAST Stage is the highest consecutive level of disability.  For"
^YTT(601.712,148,1,12,0)=" clinical purposes, in addition to staging the level of disability, additional,"
^YTT(601.712,148,1,13,0)=" non-ordinal (nonconsecutive) deficits should be noted, since these additional"
^YTT(601.712,148,1,14,0)=" deficits are of clear clinical relevance."""
^YTT(601.712,148,1,15,0)="    }, "
^YTT(601.712,148,1,16,0)="   {""id"": ""q3909"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,148,1,17,0)="    ""text"": ""1. No difficulties, either subjectively or objectively."", "
^YTT(601.712,148,1,18,0)="    ""intro"": ""The FAST scale is a functional scale designed to evaluate patients at the more"
^YTT(601.712,148,1,19,0)=" moderate-severe stages of dementia when the MMSE no longer can reflect changes"
