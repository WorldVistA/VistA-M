^YTT(601.712,191,1,5,0)=" ""content"":["
^YTT(601.712,191,1,6,0)="   {""id"": ""i2590"", ""type"": ""IntroText"", "
^YTT(601.712,191,1,7,0)="    ""text"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,191,1,8,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,191,1,9,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,191,1,10,0)=" recorded here so that the administration can be saved in VistA."""
^YTT(601.712,191,1,11,0)="    }, "
^YTT(601.712,191,1,12,0)="   {""id"": ""q9436"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,191,1,13,0)="    ""text"": ""1. Alternating Trail Making. Correct Pattern: 1-A- 2- B- 3- C- 4- D- 5- E,"
^YTT(601.712,191,1,14,0)=" without drawing any lines that cross. Any error that is not immediately"
^YTT(601.712,191,1,15,0)=" self-corrected is scored incorrect."", "
^YTT(601.712,191,1,16,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,191,1,17,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,191,1,18,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,191,1,19,0)=" recorded here so that the administration can be saved in VistA."", "
