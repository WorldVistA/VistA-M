^YTT(601.712,8,1,5,0)=" ""printTitle"": ""Beck Depression Inventory--Second Edition"","
^YTT(601.712,8,1,6,0)=" ""content"":["
^YTT(601.712,8,1,7,0)="   {""id"": ""i10"", ""type"": ""IntroText"", "
^YTT(601.712,8,1,8,0)="    ""text"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,9,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,10,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,11,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,12,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,13,0)=" number for that group."""
^YTT(601.712,8,1,14,0)="    }, "
^YTT(601.712,8,1,15,0)="   {""id"": ""q370"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,16,0)="    ""text"": ""1. SADNESS"", "
^YTT(601.712,8,1,17,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,18,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,19,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,20,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,21,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,22,0)=" number for that group."", "
^YTT(601.712,8,1,23,0)="    "
^YTT(601.712,8,1,24,0)="    ""choices"":["
^YTT(601.712,8,1,25,0)="     {""id"": ""c522"", ""text"": ""0. I do not feel sad."", ""quickKey"": 0}, "
^YTT(601.712,8,1,26,0)="     {""id"": ""c523"", ""text"": ""1. I feel sad much of the time."", ""quickKey"": 1}, "
^YTT(601.712,8,1,27,0)="     {""id"": ""c524"", ""text"": ""2. I am sad all the time."", ""quickKey"": 2}, "
^YTT(601.712,8,1,28,0)="     {""id"": ""c525"", ""text"": ""3. I am so sad or unhappy that I can't stand it."", ""quickKey"": 3}"
^YTT(601.712,8,1,29,0)="   ]}, "
^YTT(601.712,8,1,30,0)="   {""id"": ""q371"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,31,0)="    ""text"": ""2. PESSIMISM"", "
^YTT(601.712,8,1,32,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,33,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,34,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,35,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,36,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,37,0)=" number for that group."", "
^YTT(601.712,8,1,38,0)="    ""columns"": 1, "
^YTT(601.712,8,1,39,0)="    ""choices"":["
^YTT(601.712,8,1,40,0)="     {""id"": ""c526"", ""text"": ""0. I am not discouraged about my future."", ""quickKey"": 0}, "
^YTT(601.712,8,1,41,0)="     {""id"": ""c527"", ""text"": ""1. I feel more discouraged about my future than I used to be."", ""quickKey"": 1}, "
^YTT(601.712,8,1,42,0)="     {""id"": ""c528"", ""text"": ""2. I do not expect things to work out for me."", ""quickKey"": 2}, "
^YTT(601.712,8,1,43,0)="     {""id"": ""c529"", ""text"": ""3. I feel my future is hopeless and will only get worse."", ""quickKey"": 3}"
^YTT(601.712,8,1,44,0)="   ]}, "
^YTT(601.712,8,1,45,0)="   {""id"": ""q372"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,46,0)="    ""text"": ""3. PAST FAILURE"", "
^YTT(601.712,8,1,47,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,48,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,49,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,50,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,51,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,52,0)=" number for that group."", "
^YTT(601.712,8,1,53,0)="    ""columns"": 1, "
^YTT(601.712,8,1,54,0)="    ""choices"":["
^YTT(601.712,8,1,55,0)="     {""id"": ""c530"", ""text"": ""0. I do not feel like a failure."", ""quickKey"": 0}, "
^YTT(601.712,8,1,56,0)="     {""id"": ""c531"", ""text"": ""1. I have failed more than I should have."", ""quickKey"": 1}, "
^YTT(601.712,8,1,57,0)="     {""id"": ""c532"", ""text"": ""2. As I look back, I see a lot of failures."", ""quickKey"": 2}, "
^YTT(601.712,8,1,58,0)="     {""id"": ""c533"", ""text"": ""3. I feel I am a total failure as a person."", ""quickKey"": 3}"
^YTT(601.712,8,1,59,0)="   ]}, "
^YTT(601.712,8,1,60,0)="   {""id"": ""q373"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,61,0)="    ""text"": ""4. LOSS OF PLEASURE"", "
^YTT(601.712,8,1,62,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,63,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,64,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,65,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,66,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,67,0)=" number for that group."", "
^YTT(601.712,8,1,68,0)="    ""columns"": 1, "
^YTT(601.712,8,1,69,0)="    ""choices"":["
^YTT(601.712,8,1,70,0)="     {""id"": ""c534"", ""text"": ""0. I get as much pleasure as I ever did from the things I enjoy."", ""quickKey"": 0}, "
^YTT(601.712,8,1,71,0)="     {""id"": ""c535"", ""text"": ""1. I don't enjoy things as much as I used to."", ""quickKey"": 1}, "
^YTT(601.712,8,1,72,0)="     {""id"": ""c536"", ""text"": ""2. I get very little pleasure from the things I used to enjoy."", ""quickKey"": 2}, "
^YTT(601.712,8,1,73,0)="     {""id"": ""c537"", ""text"": ""3. I can't get any pleasure from the things I used to enjoy."", ""quickKey"": 3}"
^YTT(601.712,8,1,74,0)="   ]}, "
^YTT(601.712,8,1,75,0)="   {""id"": ""q374"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,76,0)="    ""text"": ""5. GUILTY FEELINGS"", "
^YTT(601.712,8,1,77,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,78,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,79,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,80,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,81,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,82,0)=" number for that group."", "
^YTT(601.712,8,1,83,0)="    ""columns"": 1, "
^YTT(601.712,8,1,84,0)="    ""choices"":["
^YTT(601.712,8,1,85,0)="     {""id"": ""c538"", ""text"": ""0. I don't feel particularly guilty."", ""quickKey"": 0}, "
^YTT(601.712,8,1,86,0)="     {""id"": ""c539"", ""text"": ""1. I feel guilty over many things I have done or should have done."", ""quickKey"": 1}, "
^YTT(601.712,8,1,87,0)="     {""id"": ""c540"", ""text"": ""2. I feel quite guilty most of the time."", ""quickKey"": 2}, "
^YTT(601.712,8,1,88,0)="     {""id"": ""c541"", ""text"": ""3. I feel guilty all of the time."", ""quickKey"": 3}"
^YTT(601.712,8,1,89,0)="   ]}, "
^YTT(601.712,8,1,90,0)="   {""id"": ""q375"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,91,0)="    ""text"": ""6. PUNISHMENT FEELINGS"", "
^YTT(601.712,8,1,92,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,93,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,94,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,95,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,96,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,97,0)=" number for that group."", "
^YTT(601.712,8,1,98,0)="    ""columns"": 1, "
^YTT(601.712,8,1,99,0)="    ""choices"":["
^YTT(601.712,8,1,100,0)="     {""id"": ""c542"", ""text"": ""0. I don't feel I am being punished."", ""quickKey"": 0}, "
^YTT(601.712,8,1,101,0)="     {""id"": ""c543"", ""text"": ""1. I feel I may be punished."", ""quickKey"": 1}, "
^YTT(601.712,8,1,102,0)="     {""id"": ""c544"", ""text"": ""2. I expect to be punished."", ""quickKey"": 2}, "
^YTT(601.712,8,1,103,0)="     {""id"": ""c545"", ""text"": ""3. I feel I am being punished."", ""quickKey"": 3}"
^YTT(601.712,8,1,104,0)="   ]}, "
^YTT(601.712,8,1,105,0)="   {""id"": ""q376"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,106,0)="    ""text"": ""7. SELF-DISLIKE"", "
^YTT(601.712,8,1,107,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,108,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,109,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,110,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,111,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,112,0)=" number for that group."", "
^YTT(601.712,8,1,113,0)="    ""columns"": 1, "
^YTT(601.712,8,1,114,0)="    ""choices"":["
^YTT(601.712,8,1,115,0)="     {""id"": ""c546"", ""text"": ""0. I feel the same about myself as ever."", ""quickKey"": 0}, "
^YTT(601.712,8,1,116,0)="     {""id"": ""c547"", ""text"": ""1. I have lost confidence in myself."", ""quickKey"": 1}, "
^YTT(601.712,8,1,117,0)="     {""id"": ""c548"", ""text"": ""2. I am disappointed in myself."", ""quickKey"": 2}, "
^YTT(601.712,8,1,118,0)="     {""id"": ""c549"", ""text"": ""3. I dislike myself."", ""quickKey"": 3}"
^YTT(601.712,8,1,119,0)="   ]}, "
^YTT(601.712,8,1,120,0)="   {""id"": ""q377"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,121,0)="    ""text"": ""8. SELF-CRITICALNESS"", "
^YTT(601.712,8,1,122,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,123,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,124,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,125,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,126,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,127,0)=" number for that group."", "
^YTT(601.712,8,1,128,0)="    ""columns"": 1, "
^YTT(601.712,8,1,129,0)="    ""choices"":["
^YTT(601.712,8,1,130,0)="     {""id"": ""c550"", ""text"": ""0. I don't criticize or blame myself more than usual."", ""quickKey"": 0}, "
^YTT(601.712,8,1,131,0)="     {""id"": ""c551"", ""text"": ""1. I am more critical of myself than I used to be."", ""quickKey"": 1}, "
^YTT(601.712,8,1,132,0)="     {""id"": ""c552"", ""text"": ""2. I criticize myself for all my faults."", ""quickKey"": 2}, "
^YTT(601.712,8,1,133,0)="     {""id"": ""c553"", ""text"": ""3. I blame myself for everything bad that happens."", ""quickKey"": 3}"
^YTT(601.712,8,1,134,0)="   ]}, "
^YTT(601.712,8,1,135,0)="   {""id"": ""q378"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,136,0)="    ""text"": ""9. SUICIDAL THOUGHTS OR WISHES"", "
^YTT(601.712,8,1,137,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,138,0)=" of statements carefully, and then pick out the one statement in each group that"
^YTT(601.712,8,1,139,0)=" best describes the way you have been feeling during the PAST TWO WEEKS,"
^YTT(601.712,8,1,140,0)=" INCLUDING TODAY. Select the number beside the statement you have picked.  If"
^YTT(601.712,8,1,141,0)=" several statements in the group seem to apply equally well, select the highest"
^YTT(601.712,8,1,142,0)=" number for that group."", "
^YTT(601.712,8,1,143,0)="    ""columns"": 1, "
^YTT(601.712,8,1,144,0)="    ""choices"":["
^YTT(601.712,8,1,145,0)="     {""id"": ""c554"", ""text"": ""0. I don't have any thoughts of killing myself."", ""quickKey"": 0}, "
^YTT(601.712,8,1,146,0)="     {""id"": ""c555"", ""text"": ""1. I have thoughts of killing myself, but I would not carry them out."", ""quickKey"": 1}, "
^YTT(601.712,8,1,147,0)="     {""id"": ""c556"", ""text"": ""2. I would like to kill myself."", ""quickKey"": 2}, "
^YTT(601.712,8,1,148,0)="     {""id"": ""c557"", ""text"": ""3. I would kill myself if I had the chance."", ""quickKey"": 3}"
^YTT(601.712,8,1,149,0)="   ]}, "
^YTT(601.712,8,1,150,0)="   {""id"": ""q379"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,8,1,151,0)="    ""text"": ""10. CRYING"", "
^YTT(601.712,8,1,152,0)="    ""intro"": ""This questionnaire consists of 21 groups of statements.  Please read each group"
^YTT(601.712,8,1,153,0)=" of statements carefully, and then pick out the one statement in each group that"
