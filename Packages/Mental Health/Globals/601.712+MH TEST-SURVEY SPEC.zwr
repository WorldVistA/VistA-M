^YTT(601.712,23,1,47,0)="     {""id"": ""c1069"", ""text"": ""1. Yes, limited a lot."", ""quickKey"": 1}, "
^YTT(601.712,23,1,48,0)="     {""id"": ""c1070"", ""text"": ""2. Yes, limited a little."", ""quickKey"": 2}, "
