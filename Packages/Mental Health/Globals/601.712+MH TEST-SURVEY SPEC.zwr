^YTT(601.712,86,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,86,1,3,0)=" ""printTitle"": ""Borderline Symptom List 23 - (BSL-23)"","
^YTT(601.712,86,1,4,0)=" ""content"":["
^YTT(601.712,86,1,5,0)="   {""id"": ""i1724"", ""type"": ""IntroText"", "
^YTT(601.712,86,1,6,0)="    ""text"": "" In the following questions you will find a set of difficulties and problems"
^YTT(601.712,86,1,7,0)=" which possibly describe you. Please work through the questionnaire and decide"
^YTT(601.712,86,1,8,0)=" how much you suffered from each problem in the course of the last week. In case"
^YTT(601.712,86,1,9,0)=" you have no feelings at all at the present moment, please answer according to"
^YTT(601.712,86,1,10,0)=" how you think you might have felt. Please answer honestly. All questions refer"
^YTT(601.712,86,1,11,0)=" to the last week. If you felt different ways at different times in the week,"
^YTT(601.712,86,1,12,0)=" give a rating for how things were for you on average. Please be sure to answer"
^YTT(601.712,86,1,13,0)=" each question."""
^YTT(601.712,86,1,14,0)="    }, "
^YTT(601.712,86,1,15,0)="   {""id"": ""q7000"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,86,1,16,0)="    ""text"": ""1. In the course of last week...It was hard for me to concentrate."", "
^YTT(601.712,86,1,17,0)="    ""intro"": "" In the following questions you will find a set of difficulties and problems"
