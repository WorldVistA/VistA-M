^YTT(601.712,11,1,157,0)="    "
^YTT(601.712,11,1,158,0)="    ""choices"":["
^YTT(601.712,11,1,159,0)="     {""id"": ""c666"", ""text"": ""0. I have made no preparations for committing suicide."", ""quickKey"": 0}, "
