^YTT(601.712,20,1,7,0)="    }, "
^YTT(601.712,20,1,8,0)="   {""id"": ""q1783"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,20,1,9,0)="    ""text"": ""1. Before I entered the military I had more close friends than I have now. "", "
