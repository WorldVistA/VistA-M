^YTT(601.712,17,1,843,0)="    ""text"": ""114. A good way to avoid mistakes is to have a routine for doing things."", "
^YTT(601.712,17,1,844,0)="    "
^YTT(601.712,17,1,845,0)="    ""choices"":["
^YTT(601.712,17,1,846,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,847,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,848,0)="   ]}, "
^YTT(601.712,17,1,849,0)="   {""id"": ""q1500"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,850,0)="    ""text"": ""115. Other people often blame me for things I didn't do."", "
^YTT(601.712,17,1,851,0)="    "
^YTT(601.712,17,1,852,0)="    ""choices"":["
^YTT(601.712,17,1,853,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
^YTT(601.712,17,1,854,0)="     {""id"": ""c689"", ""text"": ""2. False"", ""quickKey"": 2}"
^YTT(601.712,17,1,855,0)="   ]}, "
