^YTT(601.712,51,1,5,0)="   {""id"": ""q5138"", ""type"": ""DateQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,51,1,6,0)="    ""text"": ""1. Today's date:"", "
^YTT(601.712,51,1,7,0)="    ""controlWidth"": 120, ""daysBack"": 30, ""daysAhead"": 0}, "
^YTT(601.712,51,1,8,0)="   {""id"": ""q5139"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,9,0)="    ""text"": ""2. On a scale of 0 to 10, with 0 being no pain at all and 10 being the worst"
^YTT(601.712,51,1,10,0)=" possible pain, how would you rate your pain on the AVERAGE during the LAST WEEK?"", "
^YTT(601.712,51,1,11,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,12,0)="    ""legend"":[""no pain at all"", "" worse possible pain""]}, "
^YTT(601.712,51,1,13,0)="   {""id"": ""q5140"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,14,0)="    ""text"": ""3. Does your pain interfere with your ability to walk?"", "
^YTT(601.712,51,1,15,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,16,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,17,0)="   {""id"": ""q5141"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,18,0)="    ""text"": ""4. Does your pain interfere with your ability to carry/handle everyday objects"
^YTT(601.712,51,1,19,0)=" such as a bag of groceries or books?"", "
^YTT(601.712,51,1,20,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,21,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,22,0)="   {""id"": ""q5142"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,23,0)="    ""text"": ""5. Does your pain interfere with your ability to climb stairs?"", "
^YTT(601.712,51,1,24,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,25,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,26,0)="   {""id"": ""q5143"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,27,0)="    ""text"": ""6. Does your pain require you to use a cane, walker, wheelchair or other devices?"", "
^YTT(601.712,51,1,28,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,29,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,30,0)="   {""id"": ""q5144"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,31,0)="    ""text"": ""7. Does your pain interfere with your ability to bathe yourself?"", "
^YTT(601.712,51,1,32,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,33,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,34,0)="   {""id"": ""q5145"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,35,0)="    ""text"": ""8. Does your pain interfere with your ability to dress yourself?"", "
^YTT(601.712,51,1,36,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,37,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,38,0)="   {""id"": ""q5146"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,39,0)="    ""text"": ""9. Does your pain interfere with your ability to use the bathroom?"", "
^YTT(601.712,51,1,40,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,41,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,42,0)="   {""id"": ""q5147"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,43,0)="    ""text"": ""10. Does your pain interfere with your ability to manage your personal grooming"
^YTT(601.712,51,1,44,0)=" (for example, combing your hair, brushing your teeth, etc.)?"", "
^YTT(601.712,51,1,45,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,46,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,47,0)="   {""id"": ""q5148"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,48,0)="    ""text"": ""11. Does your pain affect your self-esteem or self-worth?"", "
^YTT(601.712,51,1,49,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,50,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,51,0)="   {""id"": ""q5149"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,52,0)="    ""text"": ""12. How would you rate your physical activity?"", "
^YTT(601.712,51,1,53,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,54,0)="    ""legend"":[""significant limitation in basic activities"", "" can perform vigorous activities without limitation""]}, "
^YTT(601.712,51,1,55,0)="   {""id"": ""q5150"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,56,0)="    ""text"": ""13. How would you rate your overall energy?"", "
^YTT(601.712,51,1,57,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,58,0)="    ""legend"":[""totally worn out"", "" most energy ever""]}, "
^YTT(601.712,51,1,59,0)="   {""id"": ""q5151"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,60,0)="    ""text"": ""14. How would you rate your strength and endurance TODAY?"", "
^YTT(601.712,51,1,61,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,62,0)="    ""legend"":[""very poor strength and endurance"", ""very high strength and endurance""]}, "
^YTT(601.712,51,1,63,0)="   {""id"": ""q5152"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,64,0)="    ""text"": ""15. How would you rate your feelings of depression TODAY?"", "
^YTT(601.712,51,1,65,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,66,0)="    ""legend"":[""not depressed at all"", ""extremely depressed""]}, "
^YTT(601.712,51,1,67,0)="   {""id"": ""q5153"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,68,0)="    ""text"": ""16. How would you rate your feelings of anxiety TODAY?"", "
^YTT(601.712,51,1,69,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,70,0)="    ""legend"":[""not anxious at all"", "" extremely anxious""]}, "
^YTT(601.712,51,1,71,0)="   {""id"": ""q5154"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,72,0)="    ""text"": ""17. How much do you worry about re-injuring yourself if you are more active?"", "
^YTT(601.712,51,1,73,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,74,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,75,0)="   {""id"": ""q5155"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,76,0)="    ""text"": ""18. How safe do you think it is for you to exercise?"", "
^YTT(601.712,51,1,77,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,78,0)="    ""legend"":[""not safe at all"", "" extremely safe""]}, "
^YTT(601.712,51,1,79,0)="   {""id"": ""q5156"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,80,0)="    ""text"": ""19. Do you have problems concentrating on things TODAY?"", "
^YTT(601.712,51,1,81,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,82,0)="    ""legend"":[""Not at all"", ""All the time""]}, "
^YTT(601.712,51,1,83,0)="   {""id"": ""q5157"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,51,1,84,0)="    ""text"": ""20. How often do you feel tense?"", "
^YTT(601.712,51,1,85,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,51,1,86,0)="    ""legend"":[""Not at all"", ""All the time""]}], "
