^YTT(601.712,65,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,65,1,3,0)=" ""printTitle"": ""Veterans RAND 12 Item Health Survey"","
^YTT(601.712,65,1,4,0)=" ""content"":["
^YTT(601.712,65,1,5,0)="   {""id"": ""i680"", ""type"": ""IntroText"", "
^YTT(601.712,65,1,6,0)="    ""text"": ""Instructions: This questionnaire asks for your views about your health. This"
^YTT(601.712,65,1,7,0)=" information will help keep track of how you feel and how well you are able to do"
^YTT(601.712,65,1,8,0)=" your usual activities. Answer every question by marking the answer as indicated."
^YTT(601.712,65,1,9,0)=" If you are unsure how to answer a question, please give the best answer you can."
^YTT(601.712,65,1,10,0)="  """
^YTT(601.712,65,1,11,0)="    }, "
^YTT(601.712,65,1,12,0)="   {""id"": ""q5600"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,65,1,13,0)="    ""text"": ""1. In general, would you say your health is:"", "
^YTT(601.712,65,1,14,0)="    ""intro"": ""Instructions: This questionnaire asks for your views about your health. This"
^YTT(601.712,65,1,15,0)=" information will help keep track of how you feel and how well you are able to do"
^YTT(601.712,65,1,16,0)=" your usual activities. Answer every question by marking the answer as indicated."
^YTT(601.712,65,1,17,0)=" If you are unsure how to answer a question, please give the best answer you can."
^YTT(601.712,65,1,18,0)="  "", "
^YTT(601.712,65,1,19,0)="    ""columns"": 5, "
^YTT(601.712,65,1,20,0)="    ""choices"":["
^YTT(601.712,65,1,21,0)="     {""id"": ""c3776"", ""text"": ""1. Excellent"", ""quickKey"": 1}, "
^YTT(601.712,65,1,22,0)="     {""id"": ""c3777"", ""text"": ""2. Very good"", ""quickKey"": 2}, "
^YTT(601.712,65,1,23,0)="     {""id"": ""c3778"", ""text"": ""3. Good"", ""quickKey"": 3}, "
^YTT(601.712,65,1,24,0)="     {""id"": ""c3779"", ""text"": ""4. Fair"", ""quickKey"": 4}, "
^YTT(601.712,65,1,25,0)="     {""id"": ""c3780"", ""text"": ""5. Poor"", ""quickKey"": 5}"
^YTT(601.712,65,1,26,0)="   ]}, "
^YTT(601.712,65,1,27,0)="   {""id"": ""i681"", ""type"": ""IntroText"", "
^YTT(601.712,65,1,28,0)="    ""text"": ""2. The following questions are about activities you might do during a typical"
^YTT(601.712,65,1,29,0)=" day. Does your health now limit you in these activities? If so, how much?  """
^YTT(601.712,65,1,30,0)="    }, "
