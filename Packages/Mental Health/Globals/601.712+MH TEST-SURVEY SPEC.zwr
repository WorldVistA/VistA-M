^YTT(601.712,17,1,908,0)="    ""text"": ""123. I've always had a hard time stopping myself from feeling blue and unhappy."", "
^YTT(601.712,17,1,909,0)="    "
^YTT(601.712,17,1,910,0)="    ""choices"":["
