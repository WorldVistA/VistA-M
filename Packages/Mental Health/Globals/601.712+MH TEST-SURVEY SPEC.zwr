^YTT(601.712,195,1,1,0)="{""name"": ""ALSSQOL-SF"", "
^YTT(601.712,195,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,195,1,3,0)=" ""printTitle"": ""ALS-Specific Quality of Life Questionnaire - Short Form"", "
^YTT(601.712,195,1,4,0)=" ""content"":["
^YTT(601.712,195,1,5,0)="   {""id"": ""i2615"", ""type"": ""IntroText"", "
^YTT(601.712,195,1,6,0)="    ""text"": ""The questions in this questionnaire begin with a statement followed by two"
^YTT(601.712,195,1,7,0)=" opposite answers.  Numbers extend from one extreme answer to its opposite."
^YTT(601.712,195,1,8,0)=" Please select the number between 0 and 10 which is most true for you. There are"
^YTT(601.712,195,1,9,0)=" no right or wrong answers. Completely honest answers will be most helpful."""
^YTT(601.712,195,1,10,0)="    }, "
^YTT(601.712,195,1,11,0)="   {""id"": ""q9556"", ""type"": ""SliderQuestion"", ""required"": false, "
^YTT(601.712,195,1,12,0)="    ""text"": "" Please assess your overall quality of life over the past week (7 days)."
^YTT(601.712,195,1,13,0)=" Considering all parts of my life - physical, emotional, social, spiritual, and"
^YTT(601.712,195,1,14,0)=" financial - over the past week, the quality of my life has been:"", "
^YTT(601.712,195,1,15,0)="    ""intro"": ""The questions in this questionnaire begin with a statement followed by two"
^YTT(601.712,195,1,16,0)=" opposite answers.  Numbers extend from one extreme answer to its opposite."
^YTT(601.712,195,1,17,0)=" Please circle the number between 0 and 10 which is most true for you. There are"
^YTT(601.712,195,1,18,0)=" no right or wrong answers. Completely honest answers will be most helpful."", "
^YTT(601.712,195,1,19,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,195,1,20,0)="    ""legend"":[""Very bad"", ""Excellent""]}, "
^YTT(601.712,195,1,21,0)="   {""id"": ""i2613"", ""type"": ""IntroText"", "
^YTT(601.712,195,1,22,0)="    ""text"": ""Please rate the following statements according to how strongly you agree or how"
^YTT(601.712,195,1,23,0)=" strongly you disagree with each of them. Please respond about how you have felt"
^YTT(601.712,195,1,24,0)=" or what you have experienced over the past week."""
^YTT(601.712,195,1,25,0)="    }, "
^YTT(601.712,195,1,26,0)="   {""id"": ""q9529"", ""type"": ""SliderQuestion"", ""required"": true, "
^YTT(601.712,195,1,27,0)="    ""text"": ""1. I have experienced pain."", "
