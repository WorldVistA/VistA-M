^YTT(601.712,196,1,94,0)="   {""id"": ""q9555"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,196,1,95,0)="    ""text"": ""7. Worries get in the way of my success."", "
