^YTT(601.712,189,1,1,0)="{""name"": ""YMRS"", "
^YTT(601.712,189,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,189,1,3,0)=" ""printTitle"": ""YOUNG MANIA RATING SCALE"", "
^YTT(601.712,189,1,4,0)=" ""content"":["
^YTT(601.712,189,1,5,0)="   {""id"": ""i2581"", ""type"": ""IntroText"", "
^YTT(601.712,189,1,6,0)="    ""text"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,7,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,8,0)=" presence of only one is required to qualify for that rating. The keys provided"
^YTT(601.712,189,1,9,0)=" are guides. One can ignore the keys if that is necessary to indicate severity,"
^YTT(601.712,189,1,10,0)=" although this  should be the exception rather than the rule."""
^YTT(601.712,189,1,11,0)="    }, "
^YTT(601.712,189,1,12,0)="   {""id"": ""q9396"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,13,0)="    ""text"": ""1. ELEVATED MOOD"", "
^YTT(601.712,189,1,14,0)="    ""intro"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,15,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,16,0)=" presence of only one is required to qualify for that rating. The keys provided"
^YTT(601.712,189,1,17,0)=" are guides. One can ignore the keys if that is necessary to indicate severity,"
^YTT(601.712,189,1,18,0)=" although this  should be the exception rather than the rule."", "
^YTT(601.712,189,1,19,0)="    ""columns"": 1, "
^YTT(601.712,189,1,20,0)="    ""choices"":["
^YTT(601.712,189,1,21,0)="     {""id"": ""c5869"", ""text"": "" 0 Absent""}, "
^YTT(601.712,189,1,22,0)="     {""id"": ""c5870"", ""text"": "" 0.5""}, "
^YTT(601.712,189,1,23,0)="     {""id"": ""c5871"", ""text"": "" 1 Mildly or possibly increased on questioning""}, "
^YTT(601.712,189,1,24,0)="     {""id"": ""c5872"", ""text"": "" 1.5""}, "
^YTT(601.712,189,1,25,0)="     {""id"": ""c5873"", ""text"": "" 2 Definite subjective elevation; optimistic, self-confident; cheerful;"
^YTT(601.712,189,1,26,0)=" appropriate to content""}, "
^YTT(601.712,189,1,27,0)="     {""id"": ""c5874"", ""text"": "" 2.5""}, "
^YTT(601.712,189,1,28,0)="     {""id"": ""c5875"", ""text"": "" 3 Elevated, inappropriate to content; humorous""}, "
^YTT(601.712,189,1,29,0)="     {""id"": ""c5876"", ""text"": "" 3.5""}, "
^YTT(601.712,189,1,30,0)="     {""id"": ""c5877"", ""text"": "" 4 Euphoric; inappropriate laughter; singing""}"
^YTT(601.712,189,1,31,0)="   ]}, "
^YTT(601.712,189,1,32,0)="   {""id"": ""q9397"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,33,0)="    ""text"": ""2. INCREASED MOTOR ACTIVITY ENERGY"", "
