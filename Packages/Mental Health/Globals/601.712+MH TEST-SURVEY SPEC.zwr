^YTT(601.712,143,1,6,0)="   {""id"": ""i2463"", ""type"": ""IntroText"", "
^YTT(601.712,143,1,7,0)="    ""text"": ""Select the option that best describes how you have felt and conducted yourself"
^YTT(601.712,143,1,8,0)=" over the past 6 months."""
^YTT(601.712,143,1,9,0)="    }, "
^YTT(601.712,143,1,10,0)="   {""id"": ""q8695"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,143,1,11,0)="    ""text"": ""1. How often do you have difficulty concentrating on what people say to you, even"
^YTT(601.712,143,1,12,0)=" when they are speaking to you directly?"", "
^YTT(601.712,143,1,13,0)="    ""intro"": ""Select the option that best describes how you have felt and conducted yourself"
^YTT(601.712,143,1,14,0)=" over the past 6 months."", "
^YTT(601.712,143,1,15,0)="    ""columns"": 1, "
^YTT(601.712,143,1,16,0)="    ""choices"":["
^YTT(601.712,143,1,17,0)="     {""id"": ""c5262"", ""text"": ""1. Never"", ""quickKey"": 1}, "
^YTT(601.712,143,1,18,0)="     {""id"": ""c5263"", ""text"": ""2. Rarely"", ""quickKey"": 2}, "
^YTT(601.712,143,1,19,0)="     {""id"": ""c5264"", ""text"": ""3. Sometimes"", ""quickKey"": 3}, "
^YTT(601.712,143,1,20,0)="     {""id"": ""c5265"", ""text"": ""4. Often"", ""quickKey"": 4}, "
^YTT(601.712,143,1,21,0)="     {""id"": ""c5266"", ""text"": ""5. Very Often"", ""quickKey"": 5}"
^YTT(601.712,143,1,22,0)="   ]}, "
^YTT(601.712,143,1,23,0)="   {""id"": ""q8696"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,143,1,24,0)="    ""text"": ""2. How often do you leave your seat in meetings or other situations in which you"
