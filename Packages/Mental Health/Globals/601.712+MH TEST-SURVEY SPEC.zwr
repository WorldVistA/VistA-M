^YTT(601.712,11,1,94,0)="    "
^YTT(601.712,11,1,95,0)="    ""choices"":["
^YTT(601.712,11,1,96,0)="     {""id"": ""c648"", ""text"": ""0. I would not kill myself because of my family, friends, religion, possible"
^YTT(601.712,11,1,97,0)=" injury from an unsuccessful attempt, etc."", ""quickKey"": 0}, "
