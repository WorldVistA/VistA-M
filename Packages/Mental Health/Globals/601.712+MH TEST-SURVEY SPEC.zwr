^YTT(601.712,139,1,24,0)=" disagreement to the statement, 10 indicates strong agreement, and 5 indicates"
^YTT(601.712,139,1,25,0)=" neutral."", "
^YTT(601.712,139,1,26,0)="    ""min"": 0, ""max"": 10, "
^YTT(601.712,139,1,27,0)="    ""legend"":[""Strongly disagree"", ""Neutral"", ""Strongly agree""]}, "
^YTT(601.712,139,1,28,0)="   {""id"": ""q8653"", ""type"": ""SliderQuestion"", ""required"": true, "
^YTT(601.712,139,1,29,0)="    ""text"": ""3. I am capable of working in a good job."", "
^YTT(601.712,139,1,30,0)="    ""intro"": ""After reading some statements about employment, please rank the following by"
^YTT(601.712,139,1,31,0)=" selecting a number on a scale of 0 to 10, <br />where 0 indicates strong"
