^YTT(601.712,113,1,317,0)="   {""id"": ""q8000"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,113,1,318,0)="    ""text"": ""29. Working makes me feel like I'm needed."", "
