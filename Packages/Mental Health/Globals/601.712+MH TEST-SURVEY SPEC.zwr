^YTT(601.712,189,1,173,0)=" although this  should be the exception rather than the rule."", "
^YTT(601.712,189,1,174,0)="    ""columns"": 1, "
^YTT(601.712,189,1,175,0)="    ""choices"":["
^YTT(601.712,189,1,176,0)="     {""id"": ""c5943"", ""text"": ""0. Absent, cooperative"", ""quickKey"": 0}, "
^YTT(601.712,189,1,177,0)="     {""id"": ""c5944"", ""text"": ""1.  "", ""quickKey"": 1}, "
^YTT(601.712,189,1,178,0)="     {""id"": ""c5945"", ""text"": ""2. Sarcastic; loud at times, guarded"", ""quickKey"": 2}, "
^YTT(601.712,189,1,179,0)="     {""id"": ""c5946"", ""text"": ""3.  "", ""quickKey"": 3}, "
^YTT(601.712,189,1,180,0)="     {""id"": ""c5947"", ""text"": ""4. Demanding; threats on ward"", ""quickKey"": 4}, "
^YTT(601.712,189,1,181,0)="     {""id"": ""c5948"", ""text"": ""5.  "", ""quickKey"": 5}, "
^YTT(601.712,189,1,182,0)="     {""id"": ""c5949"", ""text"": ""6. Threatens interviewer; shouting; interview difficult"", ""quickKey"": 6}, "
^YTT(601.712,189,1,183,0)="     {""id"": ""c5950"", ""text"": ""7.  "", ""quickKey"": 7}, "
^YTT(601.712,189,1,184,0)="     {""id"": ""c5951"", ""text"": ""8. Assaultive; destructive; interview impossible"", ""quickKey"": 8}"
^YTT(601.712,189,1,185,0)="   ]}, "
^YTT(601.712,189,1,186,0)="   {""id"": ""q9405"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,187,0)="    ""text"": ""10. APPEARANCE"", "
^YTT(601.712,189,1,188,0)="    ""intro"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,189,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,190,0)=" presence of only one is required to qualify for that rating. The keys provided"
^YTT(601.712,189,1,191,0)=" are guides. One can ignore the keys if that is necessary to indicate severity,"
^YTT(601.712,189,1,192,0)=" although this  should be the exception rather than the rule."", "
^YTT(601.712,189,1,193,0)="    ""columns"": 1, "
^YTT(601.712,189,1,194,0)="    ""choices"":["
^YTT(601.712,189,1,195,0)="     {""id"": ""c5952"", ""text"": "" 0 Appropriate dress and grooming""}, "
^YTT(601.712,189,1,196,0)="     {""id"": ""c5953"", ""text"": "" 0.5""}, "
^YTT(601.712,189,1,197,0)="     {""id"": ""c5954"", ""text"": "" 1 Minimally unkempt""}, "
^YTT(601.712,189,1,198,0)="     {""id"": ""c5955"", ""text"": "" 1.5""}, "
^YTT(601.712,189,1,199,0)="     {""id"": ""c5956"", ""text"": "" 2 Poorly groomed; moderately dishevelled; overdressed""}, "
^YTT(601.712,189,1,200,0)="     {""id"": ""c5957"", ""text"": "" 2.5""}, "
^YTT(601.712,189,1,201,0)="     {""id"": ""c5958"", ""text"": "" 3 Dishevelled; partly clothed; garish make-up""}, "
^YTT(601.712,189,1,202,0)="     {""id"": ""c5959"", ""text"": "" 3.5""}, "
^YTT(601.712,189,1,203,0)="     {""id"": ""c5960"", ""text"": "" 4 Completely unkempt; decorated; bizarre garb""}"
^YTT(601.712,189,1,204,0)="   ]}, "
^YTT(601.712,189,1,205,0)="   {""id"": ""q9406"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,189,1,206,0)="    ""text"": ""11. INSIGHT"", "
^YTT(601.712,189,1,207,0)="    ""intro"": ""The purpose of each item is to rate the severity of that abnormality in the"
^YTT(601.712,189,1,208,0)=" patient. When several keys are given for a particular grade of severity, the"
^YTT(601.712,189,1,209,0)=" presence of only one is required to qualify for that rating. The keys provided"
^YTT(601.712,189,1,210,0)=" are guides. One can ignore the keys if that is necessary to indicate severity,"
^YTT(601.712,189,1,211,0)=" although this  should be the exception rather than the rule."", "
^YTT(601.712,189,1,212,0)="    ""columns"": 1, "
^YTT(601.712,189,1,213,0)="    ""choices"":["
^YTT(601.712,189,1,214,0)="     {""id"": ""c5961"", ""text"": "" 0 Present; admits illness; agrees with need for treatment""}, "
^YTT(601.712,189,1,215,0)="     {""id"": ""c5962"", ""text"": "" 0.5""}, "
^YTT(601.712,189,1,216,0)="     {""id"": ""c5963"", ""text"": "" 1 Possibly ill""}, "
^YTT(601.712,189,1,217,0)="     {""id"": ""c5964"", ""text"": "" 1.5""}, "
^YTT(601.712,189,1,218,0)="     {""id"": ""c5965"", ""text"": "" 2 Admits behavior change, but denies illness""}, "
^YTT(601.712,189,1,219,0)="     {""id"": ""c5966"", ""text"": "" 2.5""}, "
^YTT(601.712,189,1,220,0)="     {""id"": ""c5967"", ""text"": "" 3 Admits possible change in behavior, but denies illness""}, "
^YTT(601.712,189,1,221,0)="     {""id"": ""c5968"", ""text"": "" 3.5""}, "
^YTT(601.712,189,1,222,0)="     {""id"": ""c5969"", ""text"": "" 4 Denies any behavior change""}"
^YTT(601.712,189,1,223,0)="   ]}]"
^YTT(601.712,189,1,224,0)="}"
