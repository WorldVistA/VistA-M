^YTT(601.712,169,1,127,0)="    ""controlWidth"": 60, ""min"": 0, ""max"": 30}, "
^YTT(601.712,169,1,128,0)="   {""id"": ""q9107"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,169,1,129,0)="    ""text"": ""8. In the past 30 days, how much were you bothered by cravings or urges to drink"
