^YTT(601.712,31,1,30,0)="    ""choices"":["
^YTT(601.712,31,1,31,0)="     {""id"": ""c212"", ""text"": ""1. Not at all"", ""quickKey"": 1}, "
^YTT(601.712,31,1,32,0)="     {""id"": ""c1008"", ""text"": ""2. Several days"", ""quickKey"": 2}, "
^YTT(601.712,31,1,33,0)="     {""id"": ""c1009"", ""text"": ""3. More than half the days"", ""quickKey"": 3}, "
