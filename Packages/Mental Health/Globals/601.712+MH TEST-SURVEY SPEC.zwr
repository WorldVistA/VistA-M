^YTT(601.712,107,1,5,0)=" ""restartDays"": 2, "
^YTT(601.712,107,1,6,0)=" ""printTitle"": ""Ascertain Dementia 8-item Informant Questionnaire (AD8)"","
^YTT(601.712,107,1,7,0)=" ""content"":["
^YTT(601.712,107,1,8,0)="   {""id"": ""i2371"", ""type"": ""IntroText"", "
^YTT(601.712,107,1,9,0)="    ""text"": ""The instrument may be self-administered or can be read aloud. It is preferable to"
^YTT(601.712,107,1,10,0)=" administer the AD8 to an informant, if available. If an informant is not"
^YTT(601.712,107,1,11,0)=" available, the AD8 questionnaire may be administered to the patient. Rater"
^YTT(601.712,107,1,12,0)=" should only rate changes in the patient due to cognitive problems.<br /> <br />"
^YTT(601.712,107,1,13,0)=" Remember, \u0022Yes, a change\u0022 indicates that there has been a change in"
^YTT(601.712,107,1,14,0)=" the last several years caused by cognitive (thinking and memory) problems."""
^YTT(601.712,107,1,15,0)="    }, "
^YTT(601.712,107,1,16,0)="   {""id"": ""q7926"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,107,1,17,0)="    ""text"": ""1. Problems with judgement (e.g., problems making decisions, bad financial"
^YTT(601.712,107,1,18,0)=" decisions, problems with thinking)"", "
^YTT(601.712,107,1,19,0)="    ""intro"": ""The instrument may be self-administered or can be read aloud. It is preferable to"
^YTT(601.712,107,1,20,0)=" administer the AD8 to an informant, if available. If an informant is not"
^YTT(601.712,107,1,21,0)=" available, the AD8 questionnaire may be administered to the patient. Rater"
^YTT(601.712,107,1,22,0)=" should only rate changes in the patient due to cognitive problems.<br /> <br />"
^YTT(601.712,107,1,23,0)=" Remember, \u0022Yes, a change\u0022 indicates that there has been a change in"
^YTT(601.712,107,1,24,0)=" the last several years caused by cognitive (thinking and memory) problems."", "
^YTT(601.712,107,1,25,0)="    ""columns"": 1, "
^YTT(601.712,107,1,26,0)="    ""choices"":["
^YTT(601.712,107,1,27,0)="     {""id"": ""c3789"", ""text"": ""1. YES, a change"", ""quickKey"": 1}, "
^YTT(601.712,107,1,28,0)="     {""id"": ""c3790"", ""text"": ""2. NO, no change"", ""quickKey"": 2}, "
^YTT(601.712,107,1,29,0)="     {""id"": ""c3791"", ""text"": ""3. N/A, don't know"", ""quickKey"": 3}"
^YTT(601.712,107,1,30,0)="   ]}, "
