^YTT(601.712,16,1,194,0)="   ]}, "
^YTT(601.712,16,1,195,0)="   {""id"": ""q1069"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,196,0)="    ""text"": ""24. I've found that this society is too hard on people who don't conform."", "
