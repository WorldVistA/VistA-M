^YTT(601.712,74,1,117,0)="   {""id"": ""i871"", ""type"": ""IntroText"", "
^YTT(601.712,74,1,118,0)="    ""text"": ""WORK means your career or how you spend most of your time. You may work at a job,"
^YTT(601.712,74,1,119,0)=" at home taking care of your family, or at school as a student. WORK includes"
^YTT(601.712,74,1,120,0)=" your duties on the job, the money you earn (if any), and the people you work"
^YTT(601.712,74,1,121,0)=" with. (If you are unemployed, retired, or can't work, you can still answer these"
^YTT(601.712,74,1,122,0)=" questions.)"""
^YTT(601.712,74,1,123,0)="    }, "
