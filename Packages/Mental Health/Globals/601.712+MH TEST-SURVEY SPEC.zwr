^YTT(601.712,56,1,4,0)=" ""printTitle"": ""Lawton-Brody Instrumental Activities of Daily Living Scale"","
^YTT(601.712,56,1,5,0)=" ""content"":["
^YTT(601.712,56,1,6,0)="   {""id"": ""q4864"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,7,0)="    ""text"": ""1. Ability to use telephone"", "
^YTT(601.712,56,1,8,0)="    ""columns"": 1, "
^YTT(601.712,56,1,9,0)="    ""choices"":["
^YTT(601.712,56,1,10,0)="     {""id"": ""c2902"", ""text"": ""1. Operates telephone on own initiative; looks up and dials numbers, etc."", ""quickKey"": 1}, "
^YTT(601.712,56,1,11,0)="     {""id"": ""c2903"", ""text"": ""2. Dials a few well-known numbers."", ""quickKey"": 2}, "
^YTT(601.712,56,1,12,0)="     {""id"": ""c2904"", ""text"": ""3. Answers telephone but does not dial."", ""quickKey"": 3}, "
^YTT(601.712,56,1,13,0)="     {""id"": ""c2905"", ""text"": ""4. Does not use telephone at all."", ""quickKey"": 4}"
^YTT(601.712,56,1,14,0)="   ]}, "
^YTT(601.712,56,1,15,0)="   {""id"": ""q5131"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,16,0)="    ""text"": ""2. Shopping"", "
^YTT(601.712,56,1,17,0)="    ""columns"": 1, "
^YTT(601.712,56,1,18,0)="    ""choices"":["
^YTT(601.712,56,1,19,0)="     {""id"": ""c2906"", ""text"": ""1. Takes care of all shopping needs independently."", ""quickKey"": 1}, "
^YTT(601.712,56,1,20,0)="     {""id"": ""c2907"", ""text"": ""2. Shops independently for small purchases."", ""quickKey"": 2}, "
^YTT(601.712,56,1,21,0)="     {""id"": ""c2908"", ""text"": ""3. Needs to be accompanied on any shopping trip."", ""quickKey"": 3}, "
^YTT(601.712,56,1,22,0)="     {""id"": ""c2909"", ""text"": ""4. Completely unable to shop."", ""quickKey"": 4}"
^YTT(601.712,56,1,23,0)="   ]}, "
^YTT(601.712,56,1,24,0)="   {""id"": ""q5177"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,25,0)="    ""text"": ""3. Food Preparation"", "
^YTT(601.712,56,1,26,0)="    ""columns"": 1, "
^YTT(601.712,56,1,27,0)="    ""choices"":["
^YTT(601.712,56,1,28,0)="     {""id"": ""c2910"", ""text"": ""1. Plans, prepares and serves adequate meals independently."", ""quickKey"": 1}, "
^YTT(601.712,56,1,29,0)="     {""id"": ""c2911"", ""text"": ""2. Prepares adequate meals if supplied with ingredients."", ""quickKey"": 2}, "
^YTT(601.712,56,1,30,0)="     {""id"": ""c2912"", ""text"": ""3. Heats, serves and prepares meals or prepares meals but does not maintain"
^YTT(601.712,56,1,31,0)=" adequate diet."", ""quickKey"": 3}, "
^YTT(601.712,56,1,32,0)="     {""id"": ""c2913"", ""text"": ""4. Needs to have meals prepared and served."", ""quickKey"": 4}"
^YTT(601.712,56,1,33,0)="   ]}, "
^YTT(601.712,56,1,34,0)="   {""id"": ""q5179"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,35,0)="    ""text"": ""4. Housekeeping"", "
^YTT(601.712,56,1,36,0)="    ""columns"": 1, "
^YTT(601.712,56,1,37,0)="    ""choices"":["
^YTT(601.712,56,1,38,0)="     {""id"": ""c2914"", ""text"": ""1. Maintains house alone or with occasional assistance (e.g. heavy work domestic"
^YTT(601.712,56,1,39,0)=" help)."", ""quickKey"": 1}, "
^YTT(601.712,56,1,40,0)="     {""id"": ""c2915"", ""text"": ""2. Performs light daily tasks such as dishwashing, bed making."", ""quickKey"": 2}, "
^YTT(601.712,56,1,41,0)="     {""id"": ""c2916"", ""text"": ""3. Performs light daily tasks but cannot maintain acceptable level of"
^YTT(601.712,56,1,42,0)=" cleanliness."", ""quickKey"": 3}, "
^YTT(601.712,56,1,43,0)="     {""id"": ""c2917"", ""text"": ""4. Needs help with all home maintenance tasks."", ""quickKey"": 4}, "
^YTT(601.712,56,1,44,0)="     {""id"": ""c2918"", ""text"": ""5. Does not participate in any housekeeping tasks."", ""quickKey"": 5}"
^YTT(601.712,56,1,45,0)="   ]}, "
^YTT(601.712,56,1,46,0)="   {""id"": ""q5183"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,47,0)="    ""text"": ""5. Laundry"", "
^YTT(601.712,56,1,48,0)="    ""columns"": 1, "
^YTT(601.712,56,1,49,0)="    ""choices"":["
^YTT(601.712,56,1,50,0)="     {""id"": ""c2919"", ""text"": ""1. Does personal laundry completely."", ""quickKey"": 1}, "
^YTT(601.712,56,1,51,0)="     {""id"": ""c2920"", ""text"": ""2. Launders small items; rinses stockings, etc."", ""quickKey"": 2}, "
^YTT(601.712,56,1,52,0)="     {""id"": ""c2921"", ""text"": ""3. All laundry must be done by others."", ""quickKey"": 3}"
^YTT(601.712,56,1,53,0)="   ]}, "
^YTT(601.712,56,1,54,0)="   {""id"": ""q5184"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,55,0)="    ""text"": ""6. Mode of Transportation"", "
^YTT(601.712,56,1,56,0)="    ""columns"": 1, "
^YTT(601.712,56,1,57,0)="    ""choices"":["
^YTT(601.712,56,1,58,0)="     {""id"": ""c2922"", ""text"": ""1. Travels independently on public transportation or drives own car."", ""quickKey"": 1}, "
^YTT(601.712,56,1,59,0)="     {""id"": ""c2923"", ""text"": ""2. Arranges own travel via taxi, but does not otherwise use public"
^YTT(601.712,56,1,60,0)=" transportation."", ""quickKey"": 2}, "
^YTT(601.712,56,1,61,0)="     {""id"": ""c2924"", ""text"": ""3. Travels on public transportation when accompanied by another."", ""quickKey"": 3}, "
^YTT(601.712,56,1,62,0)="     {""id"": ""c2925"", ""text"": ""4. Travel limited to taxi or automobile with assistance of another."", ""quickKey"": 4}, "
^YTT(601.712,56,1,63,0)="     {""id"": ""c2926"", ""text"": ""5. Does not travel at all."", ""quickKey"": 5}"
^YTT(601.712,56,1,64,0)="   ]}, "
^YTT(601.712,56,1,65,0)="   {""id"": ""q5185"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,66,0)="    ""text"": ""7. Responsibility for own medications"", "
^YTT(601.712,56,1,67,0)="    ""columns"": 1, "
^YTT(601.712,56,1,68,0)="    ""choices"":["
^YTT(601.712,56,1,69,0)="     {""id"": ""c2927"", ""text"": ""1. Is responsible for taking medication in correct dosages at correct time."", ""quickKey"": 1}, "
^YTT(601.712,56,1,70,0)="     {""id"": ""c2928"", ""text"": ""2. Takes responsibility if medication is prepared in advance in separate dosage."", ""quickKey"": 2}, "
^YTT(601.712,56,1,71,0)="     {""id"": ""c2929"", ""text"": ""3. Is not capable of dispensing own medication."", ""quickKey"": 3}"
^YTT(601.712,56,1,72,0)="   ]}, "
^YTT(601.712,56,1,73,0)="   {""id"": ""q5190"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,56,1,74,0)="    ""text"": ""8. Ability to Handle Finances"", "
^YTT(601.712,56,1,75,0)="    ""columns"": 1, "
^YTT(601.712,56,1,76,0)="    ""choices"":["
^YTT(601.712,56,1,77,0)="     {""id"": ""c2941"", ""text"": ""1. Manages financial matters independently (budgets, writes checks, goes to"
^YTT(601.712,56,1,78,0)=" bank)."", ""quickKey"": 1}, "
^YTT(601.712,56,1,79,0)="     {""id"": ""c2931"", ""text"": ""2. Manages day-to-day purchases, but needs help with banking, major purchases,"
^YTT(601.712,56,1,80,0)=" etc."", ""quickKey"": 2}, "
^YTT(601.712,56,1,81,0)="     {""id"": ""c2932"", ""text"": ""3. Incapable if handling money."", ""quickKey"": 3}"
^YTT(601.712,56,1,82,0)="   ]}]"
^YTT(601.712,56,1,83,0)="}"
