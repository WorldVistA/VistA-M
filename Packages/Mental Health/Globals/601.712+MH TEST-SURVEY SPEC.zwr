^YTT(601.712,3,1,93,0)="   ]}, "
^YTT(601.712,3,1,94,0)="   {""id"": ""q8"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,95,0)="    ""text"": ""8. Global Judgments Severity of abnormal movements. "", "
