^YTT(601.712,43,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,43,1,3,0)=" ""printTitle"": ""Florida Obsessive Compulsive Inventory (FOCI)"","
^YTT(601.712,43,1,4,0)=" ""content"":["
^YTT(601.712,43,1,5,0)="   {""id"": ""i1712"", ""type"": ""IntroText"", "
^YTT(601.712,43,1,6,0)="    ""text"": ""General Instructions:  The questions below are designed to help health"
^YTT(601.712,43,1,7,0)=" professionals evaluate anxiety symptoms.  Keep in mind, a high score on this"
^YTT(601.712,43,1,8,0)=" questionnaire does<br /> not necessarily mean you have an anxiety disorder- only"
^YTT(601.712,43,1,9,0)=" an evaluation by a health professional can make this determination.  Answer"
^YTT(601.712,43,1,10,0)=" these questions as accurately as you can.<br /> <br /> Part A Instructions: "
^YTT(601.712,43,1,11,0)=" Please respond Yes or No for the following questions, based on your experience"
^YTT(601.712,43,1,12,0)=" in the past MONTH:<br /> <br /> Have you been bothered by unpleasant thoughts or"
^YTT(601.712,43,1,13,0)=" images that repeatedly enter your mind, such as:"""
^YTT(601.712,43,1,14,0)="    }, "
^YTT(601.712,43,1,15,0)="   {""id"": ""q6814"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,43,1,16,0)="    ""text"": ""1. Concerns with contamination (dirt, germs, chemicals, radiation) or acquiring a"
^YTT(601.712,43,1,17,0)=" serious illness such as AIDS?"", "
