^YTT(601.712,16,1,429,0)="   ]}, "
^YTT(601.712,16,1,430,0)="   {""id"": ""q1098"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,431,0)="    ""text"": ""53. I have told lies to my family to conceal my use of drugs."", "
