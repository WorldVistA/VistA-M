^YTT(601.712,71,1,207,0)="    ""columns"": 1, "
^YTT(601.712,71,1,208,0)="    ""choices"":["
^YTT(601.712,71,1,209,0)="     {""id"": ""c3041"", ""text"": ""1. I live in a hospital or other place where staff are there all the time and I"
^YTT(601.712,71,1,210,0)=" rarely leave."", ""quickKey"": 1}, "
^YTT(601.712,71,1,211,0)="     {""id"": ""c3042"", ""text"": ""2. I live in a place in the community (group home or room or apartment or house)"
^YTT(601.712,71,1,212,0)=" that provides meals and staff to help me with my activities."", ""quickKey"": 2}, "
^YTT(601.712,71,1,213,0)="     {""id"": ""c3043"", ""text"": ""3. I live by myself or with other people getting mental health care, where I am"
^YTT(601.712,71,1,214,0)=" responsible for taking care of my needs with occasional visits from a mental"
^YTT(601.712,71,1,215,0)=" health provider."", ""quickKey"": 3}, "
^YTT(601.712,71,1,216,0)="     {""id"": ""c3154"", ""text"": ""4. I live by myself or with people I choose and only see mental health staff when"
^YTT(601.712,71,1,217,0)=" I choose."", ""quickKey"": 4}"
^YTT(601.712,71,1,218,0)="   ]}, "
^YTT(601.712,71,1,219,0)="   {""id"": ""s1319"", ""type"": ""IntroText"", "
^YTT(601.712,71,1,220,0)="    ""text"": ""EMPLOYMENT"""
