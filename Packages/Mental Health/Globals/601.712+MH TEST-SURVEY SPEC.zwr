^YTT(601.712,196,1,88,0)="     {""id"": ""c6166"", ""text"": ""3. Seldom True"", ""quickKey"": 3}, "
^YTT(601.712,196,1,89,0)="     {""id"": ""c6167"", ""text"": ""4. Sometimes True"", ""quickKey"": 4}, "
^YTT(601.712,196,1,90,0)="     {""id"": ""c6168"", ""text"": ""5. Frequently True"", ""quickKey"": 5}, "
