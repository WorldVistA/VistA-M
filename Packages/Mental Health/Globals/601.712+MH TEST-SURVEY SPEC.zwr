^YTT(601.712,17,1,937,0)="    ""text"": ""127. I won't get involved with people unless I'm sure they'll like me."", "
^YTT(601.712,17,1,938,0)="    "
^YTT(601.712,17,1,939,0)="    ""choices"":["
^YTT(601.712,17,1,940,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
