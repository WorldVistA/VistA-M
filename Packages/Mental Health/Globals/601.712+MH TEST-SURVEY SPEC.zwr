^YTT(601.712,17,1,557,0)="   ]}, "
^YTT(601.712,17,1,558,0)="   {""id"": ""q1460"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,559,0)="    ""text"": ""75. Lately, I've been sweating a great deal and feel very tense."", "
^YTT(601.712,17,1,560,0)="    "
^YTT(601.712,17,1,561,0)="    ""choices"":["
^YTT(601.712,17,1,562,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
