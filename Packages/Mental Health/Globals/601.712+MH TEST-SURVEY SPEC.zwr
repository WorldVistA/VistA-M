^YTT(601.712,17,1,878,0)="   ]}, "
^YTT(601.712,17,1,879,0)="   {""id"": ""q1504"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,880,0)="    ""text"": ""119. People are trying to make me believe that I'm crazy."", "
^YTT(601.712,17,1,881,0)="    "
^YTT(601.712,17,1,882,0)="    ""choices"":["
