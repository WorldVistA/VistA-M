^YTT(601.712,61,1,1,0)="{""name"": ""GPCOG"", "
^YTT(601.712,61,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,61,1,3,0)=" ""printTitle"": ""General Practitioner Assessment of Cognition"","
^YTT(601.712,61,1,4,0)=" ""content"":["
^YTT(601.712,61,1,5,0)="   {""id"": ""i607"", ""type"": ""IntroText"", "
^YTT(601.712,61,1,6,0)="    ""text"": ""I am going to give you a name and address. After I have said it, I want you to"
^YTT(601.712,61,1,7,0)=" repeat it. Remember this name and address because I am going to ask you to tell"
^YTT(601.712,61,1,8,0)=" it to me again in a few minutes: John  Brown, 42 West Street, Kensington. (Allow"
^YTT(601.712,61,1,9,0)=" a maximum of 4 attempts to memorize.)  """
^YTT(601.712,61,1,10,0)="    }, "
^YTT(601.712,61,1,11,0)="   {""id"": ""q5527"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,61,1,12,0)="    ""text"": ""1. What is the date? (Answer must be exact.)"", "
^YTT(601.712,61,1,13,0)="    ""intro"": ""I am going to give you a name and address. After I have said it, I want you to"
^YTT(601.712,61,1,14,0)=" repeat it. Remember this name and address because I am going to ask you to tell"
^YTT(601.712,61,1,15,0)=" it to me again in a few minutes: John  Brown, 42 West Street, Kensington. (Allow"
^YTT(601.712,61,1,16,0)=" a maximum of 4 attempts to memorize.)  "", "
