^YTT(601.712,89,1,17,0)="     {""id"": ""c3449"", ""text"": ""1. Slight/rare, less than a day or two"", ""quickKey"": 1}, "
^YTT(601.712,89,1,18,0)="     {""id"": ""c3450"", ""text"": ""2. Mild/several days"", ""quickKey"": 2}, "
^YTT(601.712,89,1,19,0)="     {""id"": ""c3451"", ""text"": ""3. Moderate/more than half the days"", ""quickKey"": 3}, "
