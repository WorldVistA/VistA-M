^YTT(601.712,3,1,1,0)="{""name"": ""AIMS"", "
^YTT(601.712,3,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,3,1,3,0)=" ""printTitle"": ""Abnormal Involuntary Movement Scale"","
^YTT(601.712,3,1,4,0)=" ""content"":["
^YTT(601.712,3,1,5,0)="   {""id"": ""i1"", ""type"": ""IntroText"", "
^YTT(601.712,3,1,6,0)="    ""text"": "" Complete Examination Procedure before making ratings. MOVEMENT RATINGS: Rate"
^YTT(601.712,3,1,7,0)=" highest severity observed. Rate movements that occur upon activation one LESS"
^YTT(601.712,3,1,8,0)=" than those observed spontaneously."""
^YTT(601.712,3,1,9,0)="    }, "
^YTT(601.712,3,1,10,0)="   {""id"": ""q1"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,11,0)="    ""text"": ""1. Facial and Oral Movements  Muscles of facial expression, e.g., movements of"
^YTT(601.712,3,1,12,0)=" forehead, eyebrows, periorbital area, cheeks. Include frowning, blinking,"
^YTT(601.712,3,1,13,0)=" grimacing of upper face. "", "
^YTT(601.712,3,1,14,0)="    ""intro"": "" Complete Examination Procedure before making ratings. MOVEMENT RATINGS: Rate"
^YTT(601.712,3,1,15,0)=" highest severity observed. Rate movements that occur upon activation one LESS"
^YTT(601.712,3,1,16,0)=" than those observed spontaneously."", "
^YTT(601.712,3,1,17,0)="    "
^YTT(601.712,3,1,18,0)="    ""choices"":["
^YTT(601.712,3,1,19,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,3,1,20,0)="     {""id"": ""c2"", ""text"": ""1. Minimal, may be extreme normal"", ""quickKey"": 1}, "
^YTT(601.712,3,1,21,0)="     {""id"": ""c3"", ""text"": ""2. Mild"", ""quickKey"": 2}, "
^YTT(601.712,3,1,22,0)="     {""id"": ""c4"", ""text"": ""3. Moderate"", ""quickKey"": 3}, "
^YTT(601.712,3,1,23,0)="     {""id"": ""c5"", ""text"": ""4. Severe"", ""quickKey"": 4}"
^YTT(601.712,3,1,24,0)="   ]}, "
^YTT(601.712,3,1,25,0)="   {""id"": ""q2"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,26,0)="    ""text"": ""2. Facial and Oral Movements Lips and perioral area, e.g., puckering, pouting,"
^YTT(601.712,3,1,27,0)=" smacking. "", "
^YTT(601.712,3,1,28,0)="    "
^YTT(601.712,3,1,29,0)="    ""choices"":["
^YTT(601.712,3,1,30,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,3,1,31,0)="     {""id"": ""c2"", ""text"": ""1. Minimal, may be extreme normal"", ""quickKey"": 1}, "
^YTT(601.712,3,1,32,0)="     {""id"": ""c3"", ""text"": ""2. Mild"", ""quickKey"": 2}, "
^YTT(601.712,3,1,33,0)="     {""id"": ""c4"", ""text"": ""3. Moderate"", ""quickKey"": 3}, "
^YTT(601.712,3,1,34,0)="     {""id"": ""c5"", ""text"": ""4. Severe"", ""quickKey"": 4}"
^YTT(601.712,3,1,35,0)="   ]}, "
^YTT(601.712,3,1,36,0)="   {""id"": ""q3"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,37,0)="    ""text"": ""3. Facial and Oral Movements Jaw, e.g., biting, clenching, chewing, mouth"
^YTT(601.712,3,1,38,0)=" opening, lateral movement. "", "
^YTT(601.712,3,1,39,0)="    "
^YTT(601.712,3,1,40,0)="    ""choices"":["
^YTT(601.712,3,1,41,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,3,1,42,0)="     {""id"": ""c2"", ""text"": ""1. Minimal, may be extreme normal"", ""quickKey"": 1}, "
^YTT(601.712,3,1,43,0)="     {""id"": ""c3"", ""text"": ""2. Mild"", ""quickKey"": 2}, "
^YTT(601.712,3,1,44,0)="     {""id"": ""c4"", ""text"": ""3. Moderate"", ""quickKey"": 3}, "
^YTT(601.712,3,1,45,0)="     {""id"": ""c5"", ""text"": ""4. Severe"", ""quickKey"": 4}"
^YTT(601.712,3,1,46,0)="   ]}, "
^YTT(601.712,3,1,47,0)="   {""id"": ""q4"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,48,0)="    ""text"": ""4. Facial and Oral Movements Tongue. Rate only increase in movement both in and"
^YTT(601.712,3,1,49,0)=" out of mouth, not inability to sustain movement. "", "
^YTT(601.712,3,1,50,0)="    "
^YTT(601.712,3,1,51,0)="    ""choices"":["
^YTT(601.712,3,1,52,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,3,1,53,0)="     {""id"": ""c2"", ""text"": ""1. Minimal, may be extreme normal"", ""quickKey"": 1}, "
^YTT(601.712,3,1,54,0)="     {""id"": ""c3"", ""text"": ""2. Mild"", ""quickKey"": 2}, "
^YTT(601.712,3,1,55,0)="     {""id"": ""c4"", ""text"": ""3. Moderate"", ""quickKey"": 3}, "
^YTT(601.712,3,1,56,0)="     {""id"": ""c5"", ""text"": ""4. Severe"", ""quickKey"": 4}"
^YTT(601.712,3,1,57,0)="   ]}, "
^YTT(601.712,3,1,58,0)="   {""id"": ""q5"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,59,0)="    ""text"": ""5. Extremity Movements Upper (arms, wrists, hands, fingers). Include movements"
^YTT(601.712,3,1,60,0)=" that are choreic (rapid, objectively purposeless, Irregular, spontaneous) or"
^YTT(601.712,3,1,61,0)=" athetoid (slow, irregular, complex, serpentine). Do not include tremor"
^YTT(601.712,3,1,62,0)=" (repetitive, regular, rhythmic movements). "", "
^YTT(601.712,3,1,63,0)="    "
^YTT(601.712,3,1,64,0)="    ""choices"":["
^YTT(601.712,3,1,65,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,3,1,66,0)="     {""id"": ""c2"", ""text"": ""1. Minimal, may be extreme normal"", ""quickKey"": 1}, "
^YTT(601.712,3,1,67,0)="     {""id"": ""c3"", ""text"": ""2. Mild"", ""quickKey"": 2}, "
^YTT(601.712,3,1,68,0)="     {""id"": ""c4"", ""text"": ""3. Moderate"", ""quickKey"": 3}, "
^YTT(601.712,3,1,69,0)="     {""id"": ""c5"", ""text"": ""4. Severe"", ""quickKey"": 4}"
^YTT(601.712,3,1,70,0)="   ]}, "
^YTT(601.712,3,1,71,0)="   {""id"": ""q6"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,72,0)="    ""text"": ""6. Extremity Movements Lower (legs, knees, ankles, toes), e.g., lateral knee"
^YTT(601.712,3,1,73,0)=" movement, foot tapping, heel dropping, foot squirming, Inversion and eversion of"
^YTT(601.712,3,1,74,0)=" foot. "", "
^YTT(601.712,3,1,75,0)="    "
^YTT(601.712,3,1,76,0)="    ""choices"":["
^YTT(601.712,3,1,77,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,3,1,78,0)="     {""id"": ""c2"", ""text"": ""1. Minimal, may be extreme normal"", ""quickKey"": 1}, "
^YTT(601.712,3,1,79,0)="     {""id"": ""c3"", ""text"": ""2. Mild"", ""quickKey"": 2}, "
^YTT(601.712,3,1,80,0)="     {""id"": ""c4"", ""text"": ""3. Moderate"", ""quickKey"": 3}, "
^YTT(601.712,3,1,81,0)="     {""id"": ""c5"", ""text"": ""4. Severe"", ""quickKey"": 4}"
^YTT(601.712,3,1,82,0)="   ]}, "
^YTT(601.712,3,1,83,0)="   {""id"": ""q7"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,3,1,84,0)="    ""text"": ""7. Trunk Movements Neck, shoulders, hips, e.g., rocking, twisting, squirming,"
^YTT(601.712,3,1,85,0)=" pelvic gyrations. Include diaphragmatic movements. "", "
^YTT(601.712,3,1,86,0)="    "
