^YTT(601.712,120,1,4,0)=" ""printTitle"": ""Illness Management and Recovery Scales (IMRS) - Client Self-Rating"","
^YTT(601.712,120,1,5,0)=" ""content"":["
^YTT(601.712,120,1,6,0)="   {""id"": ""i2391"", ""type"": ""IntroText"", "
^YTT(601.712,120,1,7,0)="    ""text"": ""Please take a few minutes to fill out this survey. We are interested in the way"
^YTT(601.712,120,1,8,0)=" things are for you, so there is no right or wrong answer. If you are not sure"
^YTT(601.712,120,1,9,0)=" about a question, just answer it as best as you can. Just select the number of"
^YTT(601.712,120,1,10,0)=" the answer that fits you best."""
^YTT(601.712,120,1,11,0)="    }, "
^YTT(601.712,120,1,12,0)="   {""id"": ""q8335"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,120,1,13,0)="    ""text"": ""1. Progress towards personal goals: In the past 3 months, I have come up with..."", "
^YTT(601.712,120,1,14,0)="    ""intro"": ""Please take a few minutes to fill out this survey. We are interested in the way"
^YTT(601.712,120,1,15,0)=" things are for you, so there is no right or wrong answer. If you are not sure"
^YTT(601.712,120,1,16,0)=" about a question, just answer it as best as you can. Just select the number of"
^YTT(601.712,120,1,17,0)=" the answer that fits you best."", "
^YTT(601.712,120,1,18,0)="    ""columns"": 1, "
^YTT(601.712,120,1,19,0)="    ""choices"":["
^YTT(601.712,120,1,20,0)="     {""id"": ""c3971"", ""text"": ""1. No personal goals"", ""quickKey"": 1}, "
^YTT(601.712,120,1,21,0)="     {""id"": ""c3972"", ""text"": ""2. A personal goal, but have not done anything to finish my goal "", ""quickKey"": 2}, "
^YTT(601.712,120,1,22,0)="     {""id"": ""c3973"", ""text"": ""3. A personal goal and made it a little way towards finishing it"", ""quickKey"": 3}, "
^YTT(601.712,120,1,23,0)="     {""id"": ""c3974"", ""text"": ""4. A personal goal and have gotten pretty far in finishing my goal"", ""quickKey"": 4}, "
^YTT(601.712,120,1,24,0)="     {""id"": ""c3975"", ""text"": ""5. A personal goal and have finished it"", ""quickKey"": 5}"
^YTT(601.712,120,1,25,0)="   ]}, "
^YTT(601.712,120,1,26,0)="   {""id"": ""q8336"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,120,1,27,0)="    ""text"": ""2. Knowledge: How much do you feel like you know about symptoms, treatment,"
^YTT(601.712,120,1,28,0)=" coping strategies (coping methods), and medication? "", "
^YTT(601.712,120,1,29,0)="    ""intro"": ""Please take a few minutes to fill out this survey. We are interested in the way"
^YTT(601.712,120,1,30,0)=" things are for you, so there is no right or wrong answer. If you are not sure"
^YTT(601.712,120,1,31,0)=" about a question, just answer it as best as you can. Just select the number of"
^YTT(601.712,120,1,32,0)=" the answer that fits you best."", "
^YTT(601.712,120,1,33,0)="    ""columns"": 1, "
^YTT(601.712,120,1,34,0)="    ""choices"":["
^YTT(601.712,120,1,35,0)="     {""id"": ""c3976"", ""text"": ""1. Not very much "", ""quickKey"": 1}, "
^YTT(601.712,120,1,36,0)="     {""id"": ""c3977"", ""text"": ""2. A little"", ""quickKey"": 2}, "
^YTT(601.712,120,1,37,0)="     {""id"": ""c3978"", ""text"": ""3. Some"", ""quickKey"": 3}, "
^YTT(601.712,120,1,38,0)="     {""id"": ""c3979"", ""text"": ""4. Quite a bit "", ""quickKey"": 4}, "
^YTT(601.712,120,1,39,0)="     {""id"": ""c3980"", ""text"": ""5. A great deal "", ""quickKey"": 5}"
^YTT(601.712,120,1,40,0)="   ]}, "
^YTT(601.712,120,1,41,0)="   {""id"": ""q8337"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,120,1,42,0)="    ""text"": ""3. Involvement of family and friends in my mental health treatment: How much are"
^YTT(601.712,120,1,43,0)=" family members, friends, boyfriend/girlfriend, and other people who are"
^YTT(601.712,120,1,44,0)=" important to you (outside your mental health agency) involved in your mental"
^YTT(601.712,120,1,45,0)=" health treatment? "", "
^YTT(601.712,120,1,46,0)="    ""intro"": ""Please take a few minutes to fill out this survey. We are interested in the way"
^YTT(601.712,120,1,47,0)=" things are for you, so there is no right or wrong answer. If you are not sure"
^YTT(601.712,120,1,48,0)=" about a question, just answer it as best as you can. Just select the number of"
