^YTT(601.712,67,1,2,0)=" ""copyright"": ""Copyright (c) Z. Nasreddine MD"", "
^YTT(601.712,67,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,67,1,4,0)=" ""printTitle"": ""Montreal Cognitive Assessment, Alternate 2"","
^YTT(601.712,67,1,5,0)=" ""content"":["
^YTT(601.712,67,1,6,0)="   {""id"": ""i1231"", ""type"": ""IntroText"", "
^YTT(601.712,67,1,7,0)="    ""text"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,67,1,8,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,67,1,9,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,67,1,10,0)=" recorded here so that the administration can be saved in VistA.<br />  <br />   """
^YTT(601.712,67,1,11,0)="    }, "
^YTT(601.712,67,1,12,0)="   {""id"": ""q5644"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,13,0)="    ""text"": ""1. Alternating Trail Making.  Correct Pattern: 1-A- 2- B- 3- C- 4- D- 5- E,"
^YTT(601.712,67,1,14,0)=" without drawing any lines that cross. Any error that is not immediately"
^YTT(601.712,67,1,15,0)=" self-corrected is scored incorrect."", "
^YTT(601.712,67,1,16,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,67,1,17,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,67,1,18,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,67,1,19,0)=" recorded here so that the administration can be saved in VistA.<br />  <br />   "", "
^YTT(601.712,67,1,20,0)="    ""columns"": 2, "
^YTT(601.712,67,1,21,0)="    ""choices"":["
^YTT(601.712,67,1,22,0)="     {""id"": ""c2504"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,67,1,23,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,24,0)="   ]}, "
^YTT(601.712,67,1,25,0)="   {""id"": ""q5645"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,26,0)="    ""text"": ""2. Cylinder-Visuoconstructional Skills. Correct: All must be present:"
^YTT(601.712,67,1,27,0)=" three-dimensional, all lines are drawn, no line is added, lines are relatively"
^YTT(601.712,67,1,28,0)=" parallel and their length is similar."", "
^YTT(601.712,67,1,29,0)="    ""intro"": ""The administration of the Montreal Cognitive Assessment requires the use of a"
^YTT(601.712,67,1,30,0)=" pencil-and-paper answer sheet. Please be familiar with the instructions and"
^YTT(601.712,67,1,31,0)=" scoring of this instrument prior to administration. The subject's scores are"
^YTT(601.712,67,1,32,0)=" recorded here so that the administration can be saved in VistA.<br />  <br />   "", "
^YTT(601.712,67,1,33,0)="    ""columns"": 2, "
^YTT(601.712,67,1,34,0)="    ""choices"":["
^YTT(601.712,67,1,35,0)="     {""id"": ""c2504"", ""text"": ""1. Correct"", ""quickKey"": 1}, "
^YTT(601.712,67,1,36,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,37,0)="   ]}, "
^YTT(601.712,67,1,38,0)="   {""id"": ""i1232"", ""type"": ""IntroText"", "
^YTT(601.712,67,1,39,0)="    ""text"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9.  """
^YTT(601.712,67,1,40,0)="    }, "
^YTT(601.712,67,1,41,0)="   {""id"": ""q5646"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,42,0)="    ""text"": ""3A. Clock face must be a circle with only minor distortion acceptable (e.g.,"
^YTT(601.712,67,1,43,0)=" slight imperfection on closing the circle)."", "
^YTT(601.712,67,1,44,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9.  "", "
^YTT(601.712,67,1,45,0)="    ""columns"": 2, "
^YTT(601.712,67,1,46,0)="    ""choices"":["
^YTT(601.712,67,1,47,0)="     {""id"": ""c2950"", ""text"": ""1. Correct circle"", ""quickKey"": 1}, "
^YTT(601.712,67,1,48,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,49,0)="   ]}, "
^YTT(601.712,67,1,50,0)="   {""id"": ""q5647"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,51,0)="    ""text"": ""3B. All clock numbers must be present with no additional numbers; numbers must be"
^YTT(601.712,67,1,52,0)=" in the correct order and placed in the approximate quadrants on the clock face;"
^YTT(601.712,67,1,53,0)=" Roman numerals are acceptable; numbers can be placed outside the circle contour."
^YTT(601.712,67,1,54,0)=" "", "
^YTT(601.712,67,1,55,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9.  "", "
^YTT(601.712,67,1,56,0)="    ""columns"": 2, "
^YTT(601.712,67,1,57,0)="    ""choices"":["
^YTT(601.712,67,1,58,0)="     {""id"": ""c2951"", ""text"": ""1. Correct clock numbers"", ""quickKey"": 1}, "
^YTT(601.712,67,1,59,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,60,0)="   ]}, "
^YTT(601.712,67,1,61,0)="   {""id"": ""q5648"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,67,1,62,0)="    ""text"": ""3C. There must be two hands jointly indicating the correct time; the hour hand"
^YTT(601.712,67,1,63,0)=" must be clearly shorter than the minute hand; hands must be centered within the"
^YTT(601.712,67,1,64,0)=" clock face with their junction close to the clock center. "", "
^YTT(601.712,67,1,65,0)="    ""intro"": ""3. Draw a clock. Put in all the numbers and set the time to 10 past 9.  "", "
^YTT(601.712,67,1,66,0)="    ""columns"": 2, "
^YTT(601.712,67,1,67,0)="    ""choices"":["
^YTT(601.712,67,1,68,0)="     {""id"": ""c2952"", ""text"": ""1. Correct clock hands"", ""quickKey"": 1}, "
^YTT(601.712,67,1,69,0)="     {""id"": ""c2503"", ""text"": ""2. Incorrect"", ""quickKey"": 2}"
^YTT(601.712,67,1,70,0)="   ]}, "
^YTT(601.712,67,1,71,0)="   {""id"": ""i1233"", ""type"": ""IntroText"", "
^YTT(601.712,67,1,72,0)="    ""text"": ""4. Naming pictured animals.  """
^YTT(601.712,67,1,73,0)="    }, "
