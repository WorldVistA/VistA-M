^YTT(601.712,17,1,862,0)="   ]}, "
^YTT(601.712,17,1,863,0)="   {""id"": ""q1502"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,864,0)="    ""text"": ""117. People think I sometimes talk about strange or different things than they"
^YTT(601.712,17,1,865,0)=" do."", "
^YTT(601.712,17,1,866,0)="    "
^YTT(601.712,17,1,867,0)="    ""choices"":["
^YTT(601.712,17,1,868,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
