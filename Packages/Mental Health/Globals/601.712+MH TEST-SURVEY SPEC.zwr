^YTT(601.712,169,1,106,0)="    ""text"": ""7C. Cocaine and/or Crack?"", "
^YTT(601.712,169,1,107,0)="    ""intro"": ""7. In the past 30 days, how many days did you use any of the following drugs:  "", "
^YTT(601.712,169,1,108,0)="    ""controlWidth"": 60, ""min"": 0, ""max"": 30}, "
