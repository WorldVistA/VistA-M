^YTT(601.712,5,1,16,0)="     {""id"": ""c217"", ""text"": ""1. Never"", ""quickKey"": 1}, "
^YTT(601.712,5,1,17,0)="     {""id"": ""c218"", ""text"": ""2. Monthly or less"", ""quickKey"": 2}, "
^YTT(601.712,5,1,18,0)="     {""id"": ""c219"", ""text"": ""3. Two to four times a month"", ""quickKey"": 3}, "
^YTT(601.712,5,1,19,0)="     {""id"": ""c220"", ""text"": ""4. Two to three times per week"", ""quickKey"": 4}, "
^YTT(601.712,5,1,20,0)="     {""id"": ""c221"", ""text"": ""5. Four or more times a week"", ""quickKey"": 5}"
^YTT(601.712,5,1,21,0)="   ]}, "
^YTT(601.712,5,1,22,0)="   {""id"": ""q84"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,5,1,23,0)="    ""text"": ""2. How many drinks containing alcohol did you have on a typical day when you were"
