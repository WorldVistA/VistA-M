^YTT(601.712,27,1,5,0)="   {""id"": ""i69"", ""type"": ""IntroText"", "
^YTT(601.712,27,1,6,0)="    ""text"": ""Have you ever had any experience that was so frightening, horrible or upsetting"
^YTT(601.712,27,1,7,0)=" that, IN THE PAST MONTH, you:"""
^YTT(601.712,27,1,8,0)="    }, "
^YTT(601.712,27,1,9,0)="   {""id"": ""q3826"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,27,1,10,0)="    ""text"": ""1. Have had any nightmares about it or thought about it when you did not want to?"", "
