^YTT(601.712,53,1,5,0)=" ""content"":["
^YTT(601.712,53,1,6,0)="   {""id"": ""i596"", ""type"": ""IntroText"", "
^YTT(601.712,53,1,7,0)="    ""text"": ""Instructions: Below is a list of statements and questions about experiences"
^YTT(601.712,53,1,8,0)=" people might have with their therapy or therapist. Think about your experience"
^YTT(601.712,53,1,9,0)=" in therapy, and decide which category best  describes your own experience."
^YTT(601.712,53,1,10,0)=" Please click on your choice or use a number key to indicate your answer."
^YTT(601.712,53,1,11,0)=" IMPORTANT!!! Please take your time to consider each question carefully.  """
^YTT(601.712,53,1,12,0)="    }, "
^YTT(601.712,53,1,13,0)="   {""id"": ""q5434"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,53,1,14,0)="    ""text"": ""1. As a result of these sessions I am clearer as to how I might be able to"
^YTT(601.712,53,1,15,0)=" change."", "
^YTT(601.712,53,1,16,0)="    ""intro"": ""Instructions: Below is a list of statements and questions about experiences"
^YTT(601.712,53,1,17,0)=" people might have with their therapy or therapist. Think about your experience"
^YTT(601.712,53,1,18,0)=" in therapy, and decide which category best  describes your own experience."
^YTT(601.712,53,1,19,0)=" Please click on your choice or use a number key to indicate your answer."
^YTT(601.712,53,1,20,0)=" IMPORTANT!!! Please take your time to consider each question carefully.  "", "
^YTT(601.712,53,1,21,0)="    ""columns"": 2, "
^YTT(601.712,53,1,22,0)="    ""choices"":["
^YTT(601.712,53,1,23,0)="     {""id"": ""c2865"", ""text"": ""1. Seldom"", ""quickKey"": 1}, "
