^YTT(601.712,17,1,552,0)="    ""text"": ""74. I can't seem to sleep, and wake up just as tired as when I went to bed."", "
^YTT(601.712,17,1,553,0)="    "
^YTT(601.712,17,1,554,0)="    ""choices"":["
^YTT(601.712,17,1,555,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
