^YTT(601.712,130,0)="263^3220408.134243^4010786293"
^YTT(601.712,130,1,0)="^^86^86^3220408"
^YTT(601.712,130,1,1,0)="{""name"": ""NUDESC"", "
^YTT(601.712,130,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,130,1,3,0)=" ""printTitle"": ""Nursing Delirium Screening Scale - (NUDESC)"","
^YTT(601.712,130,1,4,0)=" ""content"":["
^YTT(601.712,130,1,5,0)="   {""id"": ""i2433"", ""type"": ""IntroText"", "
^YTT(601.712,130,1,6,0)="    ""text"": ""This is an observational screening tool. Please use your best judgment as to what"
^YTT(601.712,130,1,7,0)=" the patient is demonstrating. Each item contains 3 descriptors to choose"
^YTT(601.712,130,1,8,0)=" from.<br />"""
^YTT(601.712,130,1,9,0)="    }, "
^YTT(601.712,130,1,10,0)="   {""id"": ""q8530"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,130,1,11,0)="    ""text"": ""1. DISORIENTATION. Verbal or behavioral manifestation of not being oriented to"
^YTT(601.712,130,1,12,0)=" time or place or misperceiving persons in the environment."", "
^YTT(601.712,130,1,13,0)="    ""intro"": ""This is an observational screening tool. Please use your best judgment as to what"
^YTT(601.712,130,1,14,0)=" the patient is demonstrating. Each item contains 3 descriptors to choose"
^YTT(601.712,130,1,15,0)=" from.<br />"", "
^YTT(601.712,130,1,16,0)="    "
^YTT(601.712,130,1,17,0)="    ""choices"":["
^YTT(601.712,130,1,18,0)="     {""id"": ""c5035"", ""text"": ""0. Absent. No signs of item present. Patient is orientated to time place and"
^YTT(601.712,130,1,19,0)=" person."", ""quickKey"": 0}, "
^YTT(601.712,130,1,20,0)="     {""id"": ""c5036"", ""text"": ""1. Mild to moderate. Barely expressed and noticeable through to being"
^YTT(601.712,130,1,21,0)=" present/undeniable. Pt still can provide some orientating information to time,"
^YTT(601.712,130,1,22,0)=" place and/or person."", ""quickKey"": 1}, "
^YTT(601.712,130,1,23,0)="     {""id"": ""c5037"", ""text"": ""2. Moderate to severe. Pt not orientated to time/place; i.e., not able to tell"
^YTT(601.712,130,1,24,0)=" you the date, month, day, year, season, floor, name of hospital, city, state,"
^YTT(601.712,130,1,25,0)=" country."", ""quickKey"": 2}"
^YTT(601.712,130,1,26,0)="   ]}, "
^YTT(601.712,130,1,27,0)="   {""id"": ""q8531"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,130,1,28,0)="    ""text"": ""2. INAPPROPRIATE BEHAVIOR. Behavior inappropriate to place and/or for the person;"
^YTT(601.712,130,1,29,0)=" e.g., pulling at tubes or dressings, attempting to get out of bed when it is"
^YTT(601.712,130,1,30,0)=" contraindicated, and the like."", "
^YTT(601.712,130,1,31,0)="    ""intro"": ""This is an observational screening tool. Please use your best judgment as to what"
^YTT(601.712,130,1,32,0)=" the patient is demonstrating. Each item contains 3 descriptors to choose"
^YTT(601.712,130,1,33,0)=" from.<br />"", "
^YTT(601.712,130,1,34,0)="    "
^YTT(601.712,130,1,35,0)="    ""choices"":["
^YTT(601.712,130,1,36,0)="     {""id"": ""c5038"", ""text"": ""0. Absent. No signs of item present."", ""quickKey"": 0}, "
^YTT(601.712,130,1,37,0)="     {""id"": ""c5039"", ""text"": ""1. Mild to moderate. Hyperactivity is barely noticeable or appears as simple"
^YTT(601.712,130,1,38,0)=" restlessness, to undeniable, subject moves frequently."", ""quickKey"": 1}, "
^YTT(601.712,130,1,39,0)="     {""id"": ""c5040"", ""text"": ""2. Moderate to severe. Hyperactivity is severe; patient is constantly moving,"
^YTT(601.712,130,1,40,0)=" overreacts to stimuli, requires surveillance and/or restraint."", ""quickKey"": 2}"
^YTT(601.712,130,1,41,0)="   ]}, "
^YTT(601.712,130,1,42,0)="   {""id"": ""q8532"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,130,1,43,0)="    ""text"": ""3. INAPPROPRIATE COMMUNICATION. Behavior inappropriate to place and/or for the"
^YTT(601.712,130,1,44,0)=" person; e.g., incoherence, non-communicativeness, nonsensical or unintelligible"
^YTT(601.712,130,1,45,0)=" speech."", "
^YTT(601.712,130,1,46,0)="    ""intro"": ""This is an observational screening tool. Please use your best judgment as to what"
^YTT(601.712,130,1,47,0)=" the patient is demonstrating. Each item contains 3 descriptors to choose"
^YTT(601.712,130,1,48,0)=" from.<br />"", "
^YTT(601.712,130,1,49,0)="    "
^YTT(601.712,130,1,50,0)="    ""choices"":["
^YTT(601.712,130,1,51,0)="     {""id"": ""c5041"", ""text"": ""0. Absent. No sign of items present. Patient's speech is coherent and"
^YTT(601.712,130,1,52,0)=" goal-directed."", ""quickKey"": 0}, "
^YTT(601.712,130,1,53,0)="     {""id"": ""c5042"", ""text"": ""1. Mild to moderate. Patient's speech is slightly difficult to follow; responses"
^YTT(601.712,130,1,54,0)=" to questions are slightly off target, to disorganized speech being clearly"
^YTT(601.712,130,1,55,0)=" present."", ""quickKey"": 1}, "
^YTT(601.712,130,1,56,0)="     {""id"": ""c5043"", ""text"": ""2. Mod to severe. Conversation impossible due to disorganized thinking or speech"
^YTT(601.712,130,1,57,0)=" (e.g., irrelevant, incoherent speech, or tangential, circumstantial, or faulty"
^YTT(601.712,130,1,58,0)=" reasoning)."", ""quickKey"": 2}"
^YTT(601.712,130,1,59,0)="   ]}, "
^YTT(601.712,130,1,60,0)="   {""id"": ""q8533"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,130,1,61,0)="    ""text"": ""4. ILLUSIONS/HALLUCINATIONS. Seeing or hearing things that are not there;"
^YTT(601.712,130,1,62,0)=" distortions of visual objects."", "
^YTT(601.712,130,1,63,0)="    ""intro"": ""This is an observational screening tool. Please use your best judgment as to what"
^YTT(601.712,130,1,64,0)=" the patient is demonstrating. Each item contains 3 descriptors to choose"
^YTT(601.712,130,1,65,0)=" from.<br />"", "
^YTT(601.712,130,1,66,0)="    "
^YTT(601.712,130,1,67,0)="    ""choices"":["
^YTT(601.712,130,1,68,0)="     {""id"": ""c5044"", ""text"": ""0. Absent. No sign of items present."", ""quickKey"": 0}, "
^YTT(601.712,130,1,69,0)="     {""id"": ""c5045"", ""text"": ""1. Mild to moderate. Misperceptions or illusions related to sleep, fleeting"
^YTT(601.712,130,1,70,0)=" hallucinations."", ""quickKey"": 1}, "
^YTT(601.712,130,1,71,0)="     {""id"": ""c5046"", ""text"": ""2. Moderate to severe. Frequent or intense illusions or hallucinations that"
^YTT(601.712,130,1,72,0)=" disrupts care, function or is associated with inappropriate behavior."", ""quickKey"": 2}"
^YTT(601.712,130,1,73,0)="   ]}, "
^YTT(601.712,130,1,74,0)="   {""id"": ""q8534"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,130,1,75,0)="    ""text"": ""5. PSYCHOMOTOR RETARDATION. Delayed responsiveness; few or no spontaneous"
^YTT(601.712,130,1,76,0)=" actions/words; e.g., when the patient is prodded, reaction is deferred and/or"
^YTT(601.712,130,1,77,0)=" the patient is unarousable."", "
^YTT(601.712,130,1,78,0)="    "
^YTT(601.712,130,1,79,0)="    ""choices"":["
^YTT(601.712,130,1,80,0)="     {""id"": ""c5047"", ""text"": ""0. Absent. No sign of items present."", ""quickKey"": 0}, "
^YTT(601.712,130,1,81,0)="     {""id"": ""c5048"", ""text"": ""1. Mild to moderate. Hypoactivity is barely noticeable, expressed as slightly"
^YTT(601.712,130,1,82,0)=" slowing of movement, to moderate slowing of movements."", ""quickKey"": 1}, "
^YTT(601.712,130,1,83,0)="     {""id"": ""c5049"", ""text"": ""2. Moderate to severe. Hypoactivity is severe; patient does not move or speak"
^YTT(601.712,130,1,84,0)=" without prodding or is catatonic."", ""quickKey"": 2}"
^YTT(601.712,130,1,85,0)="   ]}]"
^YTT(601.712,130,1,86,0)="}"
^YTT(601.712,131,0)="264^3220408.134259^798971424"
^YTT(601.712,131,1,0)="^^276^276^3220408"
^YTT(601.712,131,1,1,0)="{""name"": ""CASE MIX"", "
^YTT(601.712,131,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,131,1,3,0)=" ""printTitle"": ""Case Mix & Budget Tool"","
^YTT(601.712,131,1,4,0)=" ""content"":["
^YTT(601.712,131,1,5,0)="   {""id"": ""q8580"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,131,1,6,0)="    ""text"": "" Type of Evaluation"", "
^YTT(601.712,131,1,7,0)="    ""columns"": 1, "
^YTT(601.712,131,1,8,0)="    ""choices"":["
^YTT(601.712,131,1,9,0)="     {""id"": ""c5155"", ""text"": ""1. Initial"", ""quickKey"": 1}, "
^YTT(601.712,131,1,10,0)="     {""id"": ""c5156"", ""text"": ""2. 6 month"", ""quickKey"": 2}, "
^YTT(601.712,131,1,11,0)="     {""id"": ""c5157"", ""text"": ""3. Annual"", ""quickKey"": 3}, "
^YTT(601.712,131,1,12,0)="     {""id"": ""c5158"", ""text"": ""4. Change in level of care"", ""quickKey"": 4}"
^YTT(601.712,131,1,13,0)="   ]}, "
^YTT(601.712,131,1,14,0)="   {""id"": ""q8581"", ""type"": ""DateQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,131,1,15,0)="    ""text"": "" Anticipated Start Date &nbsp;&nbsp;"", "
^YTT(601.712,131,1,16,0)="    ""controlWidth"": 120, ""daysBack"": 30, ""daysAhead"": 365}, "
^YTT(601.712,131,1,17,0)="   {""id"": ""q8582"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,131,1,18,0)="    ""text"": "" Anticipated Length of Service"", "
^YTT(601.712,131,1,19,0)="    ""columns"": 1, "
^YTT(601.712,131,1,20,0)="    ""choices"":["
^YTT(601.712,131,1,21,0)="     {""id"": ""c5159"", ""text"": ""1. Less than 90 days"", ""quickKey"": 1}, "
^YTT(601.712,131,1,22,0)="     {""id"": ""c5160"", ""text"": ""2. 3 months"", ""quickKey"": 2}, "
^YTT(601.712,131,1,23,0)="     {""id"": ""c5161"", ""text"": ""3. 6 months"", ""quickKey"": 3}, "
^YTT(601.712,131,1,24,0)="     {""id"": ""c5162"", ""text"": ""4. 12 months"", ""quickKey"": 4}"
^YTT(601.712,131,1,25,0)="   ]}, "
^YTT(601.712,131,1,26,0)="   {""id"": ""i2434"", ""type"": ""IntroText"", "
^YTT(601.712,131,1,27,0)="    ""text"": ""   """
^YTT(601.712,131,1,28,0)="    }, "
^YTT(601.712,131,1,29,0)="   {""id"": ""q8535"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,30,0)="    ""text"": ""Q1. DRESSING<br /> How well are you able to manage dressing? By dressing, we mean"
^YTT(601.712,131,1,31,0)=" laying out the clothes and<br /> putting them on, including shoes, and fastening"
^YTT(601.712,131,1,32,0)=" clothes. Would you say that you:"", "
^YTT(601.712,131,1,33,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,34,0)="    ""columns"": 1, "
^YTT(601.712,131,1,35,0)="    ""choices"":["
^YTT(601.712,131,1,36,0)="     {""id"": ""c5056"", ""text"": ""0. Can dress without help of any kind?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,37,0)="     {""id"": ""c5057"", ""text"": ""1. Need and get minimal supervision or reminding?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,38,0)="     {""id"": ""c5058"", ""text"": ""2. * Need some help from another person to put your clothes on?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,39,0)="     {""id"": ""c5059"", ""text"": ""3. * Cannot dress yourself and somebody dresses you?"", ""quickKey"": 3}, "
^YTT(601.712,131,1,40,0)="     {""id"": ""c5060"", ""text"": ""4. * Are never dressed?"", ""quickKey"": 4}"
^YTT(601.712,131,1,41,0)="   ]}, "
^YTT(601.712,131,1,42,0)="   {""id"": ""q8536"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,43,0)="    ""text"": ""Q2. GROOMING<br /> Now I have some questions about how you manage with grooming"
^YTT(601.712,131,1,44,0)=" activities like combing your hair,<br /> putting on makeup, shaving, and"
^YTT(601.712,131,1,45,0)=" brushing your teeth. Would you say that you:"", "
^YTT(601.712,131,1,46,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,47,0)="    ""columns"": 1, "
^YTT(601.712,131,1,48,0)="    ""choices"":["
^YTT(601.712,131,1,49,0)="     {""id"": ""c5061"", ""text"": ""0. Can comb your hair, wash your face, shave or brush your teeth without help of"
^YTT(601.712,131,1,50,0)=" any kind?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,51,0)="     {""id"": ""c5062"", ""text"": ""1. Need and get supervision or reminding or grooming activities?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,52,0)="     {""id"": ""c5063"", ""text"": ""2. * Needs and get daily help from another person?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,53,0)="     {""id"": ""c5064"", ""text"": ""3. * Are completely groomed by somebody else?"", ""quickKey"": 3}"
^YTT(601.712,131,1,54,0)="   ]}, "
^YTT(601.712,131,1,55,0)="   {""id"": ""q8537"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,56,0)="    ""text"": ""Q3. BATHING<br /> How well can you bathe or shower yourself? (Bathing or"
^YTT(601.712,131,1,57,0)=" showering by yourself means running<br /> the water, taking the bath or shower"
^YTT(601.712,131,1,58,0)=" without any help, and washing all parts of the body, including<br /> our hair"
^YTT(601.712,131,1,59,0)=" and face.) Would you say that you:"", "
^YTT(601.712,131,1,60,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,61,0)="    ""columns"": 1, "
^YTT(601.712,131,1,62,0)="    ""choices"":["
^YTT(601.712,131,1,63,0)="     {""id"": ""c5065"", ""text"": ""0. Can bathe or shower without any help?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,64,0)="     {""id"": ""c5066"", ""text"": ""1. Need and get minimal supervision or reminding?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,65,0)="     {""id"": ""c5067"", ""text"": ""2. Need and get supervision only?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,66,0)="     {""id"": ""c5068"", ""text"": ""3. Need and get help getting in and out of the tub?"", ""quickKey"": 3}, "
^YTT(601.712,131,1,67,0)="     {""id"": ""c5069"", ""text"": ""4. * Need and get help washing and drying your body?"", ""quickKey"": 4}, "
^YTT(601.712,131,1,68,0)="     {""id"": ""c5070"", ""text"": ""5. * Cannot bathe or shower, need complete help?"", ""quickKey"": 5}"
^YTT(601.712,131,1,69,0)="   ]}, "
^YTT(601.712,131,1,70,0)="   {""id"": ""q8538"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,71,0)="    ""text"": ""Q4. EATING<br /> How well can you manage eating by yourself? Eating by yourself"
^YTT(601.712,131,1,72,0)=" means drinking and eating without<br /> help from anybody else, but you can use"
^YTT(601.712,131,1,73,0)=" special utensils and straws. It also means cutting most foods<br /> on your own."
^YTT(601.712,131,1,74,0)=" Would you say that you:"", "
^YTT(601.712,131,1,75,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,76,0)="    ""columns"": 1, "
^YTT(601.712,131,1,77,0)="    ""choices"":["
^YTT(601.712,131,1,78,0)="     {""id"": ""c5071"", ""text"": ""0. Can eat without help of any kind?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,79,0)="     {""id"": ""c5072"", ""text"": ""1. Need and get minimal reminding or supervision?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,80,0)="     {""id"": ""c5073"", ""text"": ""2. * Need and get help in cutting food, buttering bread or arranging food?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,81,0)="     {""id"": ""c5074"", ""text"": ""3. * Need and get some personal help with feeding or someone needs to be sure"
^YTT(601.712,131,1,82,0)=" that you don't choke?"", ""quickKey"": 3}, "
^YTT(601.712,131,1,83,0)="     {""id"": ""c5075"", ""text"": ""4. * Need to be fed completely or tube feeding or IV feeding?"", ""quickKey"": 4}"
^YTT(601.712,131,1,84,0)="   ]}, "
^YTT(601.712,131,1,85,0)="   {""id"": ""q8539"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,86,0)="    ""text"": ""Q5. BED MOBILITY<br /> How well can you manage sitting up or moving around in"
^YTT(601.712,131,1,87,0)=" bed? Would you say that you:"", "
^YTT(601.712,131,1,88,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,89,0)="    ""columns"": 1, "
^YTT(601.712,131,1,90,0)="    ""choices"":["
^YTT(601.712,131,1,91,0)="     {""id"": ""c5076"", ""text"": ""0. Can move in bed without any help?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,92,0)="     {""id"": ""c5077"", ""text"": ""1. Need and get help sometimes to sit up?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,93,0)="     {""id"": ""c5078"", ""text"": ""2. * Always need and get help to sit up?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,94,0)="     {""id"": ""c5079"", ""text"": ""3. * Always need and get help to be turned or change positions?"", ""quickKey"": 3}"
^YTT(601.712,131,1,95,0)="   ]}, "
^YTT(601.712,131,1,96,0)="   {""id"": ""q8540"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,97,0)="    ""text"": ""Q6. TRANSFERRING<br /> How well can you get in and out of a bed or chair? Would"
^YTT(601.712,131,1,98,0)=" you say that you:"", "
^YTT(601.712,131,1,99,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,100,0)="    ""columns"": 1, "
^YTT(601.712,131,1,101,0)="    ""choices"":["
^YTT(601.712,131,1,102,0)="     {""id"": ""c5080"", ""text"": ""0. Can get in and out of a bed or chair without help of any kind?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,103,0)="     {""id"": ""c5081"", ""text"": ""1. Need somebody to be there to guide you but can move in and out of a bed or"
^YTT(601.712,131,1,104,0)=" chair?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,105,0)="     {""id"": ""c5082"", ""text"": ""2. * Need one other person to help you?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,106,0)="     {""id"": ""c5083"", ""text"": ""3. * Need two other people or a mechanical aid to help you?"", ""quickKey"": 3}, "
^YTT(601.712,131,1,107,0)="     {""id"": ""c5084"", ""text"": ""4. * Never get out of a bed or chair?"", ""quickKey"": 4}"
^YTT(601.712,131,1,108,0)="   ]}, "
^YTT(601.712,131,1,109,0)="   {""id"": ""q8541"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,110,0)="    ""text"": ""Q7. WALKING<br /> How well are you able to walk around, either without any help"
^YTT(601.712,131,1,111,0)=" or with a cane or walker, but not<br /> including a wheelchair? (If asked,"
^YTT(601.712,131,1,112,0)=" clarify that independence in walking refers to the ability to walk<br /> short"
^YTT(601.712,131,1,113,0)=" distances around the house. Independence in walking does not include climbing"
^YTT(601.712,131,1,114,0)=" stairs.) <br /> Would you say that you:"", "
^YTT(601.712,131,1,115,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,116,0)="    ""columns"": 1, "
^YTT(601.712,131,1,117,0)="    ""choices"":["
^YTT(601.712,131,1,118,0)="     {""id"": ""c5085"", ""text"": ""0. Walk without help of any kind?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,119,0)="     {""id"": ""c5086"", ""text"": ""1. Can walk with help of a cane, walker, crutch, or push wheelchair?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,120,0)="     {""id"": ""c5087"", ""text"": ""2. * Need and get help from one person to help you walk?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,121,0)="     {""id"": ""c5088"", ""text"": ""3. * Need and get help from two people to help you walk?"", ""quickKey"": 3}, "
^YTT(601.712,131,1,122,0)="     {""id"": ""c5089"", ""text"": ""4. * Cannot walk at all?"", ""quickKey"": 4}"
^YTT(601.712,131,1,123,0)="   ]}, "
^YTT(601.712,131,1,124,0)="   {""id"": ""q8542"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,125,0)="    ""text"": ""Q8. BEHAVIOR"", "
^YTT(601.712,131,1,126,0)="    ""intro"": ""   "","
^YTT(601.712,131,1,127,0)="    ""columns"": 1, "
^YTT(601.712,131,1,128,0)="    ""choices"":["
^YTT(601.712,131,1,129,0)="     {""id"": ""c5090"", ""text"": ""0. Behavior requires no intervention."", ""quickKey"": 0}, "
^YTT(601.712,131,1,130,0)="     {""id"": ""c5091"", ""text"": ""1. Needs and receives occasional staff intervention in the form of cues"
^YTT(601.712,131,1,131,0)=" because the person is anxious, irritable, lethargic or demanding. Person responds to cues."", ""quickKey"": 1}, "
^YTT(601.712,131,1,132,0)="     {""id"": ""c5092"", ""text"": ""2. * Needs and receives regular staff intervention in the form of redirection"
^YTT(601.712,131,1,133,0)=" because the person has episodes of disorientation, hallucinates, wanders, is withdrawn or exhibits similar"
^YTT(601.712,131,1,134,0)=" behaviors. Person may be resistive but responds to redirection."", ""quickKey"": 2}, "
^YTT(601.712,131,1,135,0)="     {""id"": ""c5093"", ""text"": ""3. * Needs and receives behavior management and staff intervention because"
^YTT(601.712,131,1,136,0)=" person exhibits disruptive behavior such as verbally abusing others, wandering into private areas,"
^YTT(601.712,131,1,137,0)=" removing or destroying property, or acts in a sexually aggressive manner. Person may be resistant to redirection."","
^YTT(601.712,131,1,138,0)=" ""quickKey"": 3}, "
^YTT(601.712,131,1,139,0)="     {""id"": ""c5094"", ""text"": ""4. * Needs and receives behavior management and staff intervention because person is"
^YTT(601.712,131,1,140,0)=" physically abusive to self and others. Person may physically resist redirection."", ""quickKey"": 4}"
^YTT(601.712,131,1,141,0)="   ]}, "
^YTT(601.712,131,1,142,0)="   {""id"": ""q8543"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,131,1,143,0)="    ""text"": ""Q9. COMMUNICATION<br /> How effective are you at making yourself understood?"
^YTT(601.712,131,1,144,0)=" Would you say that on a regular basis you are:"", "
^YTT(601.712,131,1,145,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,146,0)="    ""columns"": 1, "
^YTT(601.712,131,1,147,0)="    ""choices"":["
^YTT(601.712,131,1,148,0)="     {""id"": ""c5095"", ""text"": ""0. Understood?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,149,0)="     {""id"": ""c5096"", ""text"": ""1. Usually Understood?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,150,0)="     {""id"": ""c5097"", ""text"": ""2. Sometimes Understood?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,151,0)="     {""id"": ""c5098"", ""text"": ""3. Rarely/Never Understood?"", ""quickKey"": 3}"
^YTT(601.712,131,1,152,0)="   ]}, "
^YTT(601.712,131,1,153,0)="   {""id"": ""q8544"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,131,1,154,0)="    ""text"": ""Q10. TOILETING<br /> How well can you manage using the toilet? (Using the toilet"
^YTT(601.712,131,1,155,0)=" independently includes<br /> adjusting clothing, getting to and on the toilet,"
^YTT(601.712,131,1,156,0)=" and cleaning one's self. If reminders<br /> are needed to use the toilet this"
^YTT(601.712,131,1,157,0)=" counts as some help.) Would you say that you:"", "
^YTT(601.712,131,1,158,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,159,0)="    ""columns"": 1, "
^YTT(601.712,131,1,160,0)="    ""choices"":["
^YTT(601.712,131,1,161,0)="     {""id"": ""c5099"", ""text"": ""0. Can use the toilet without help, including adjusting clothing?"", ""quickKey"": 0}, "
^YTT(601.712,131,1,162,0)="     {""id"": ""c5100"", ""text"": ""1. * Need some help to get to and on the toilet but don't have accidents?"", ""quickKey"": 1}, "
^YTT(601.712,131,1,163,0)="     {""id"": ""c5101"", ""text"": ""2. * Have accidents sometimes, but not more than once a week?"", ""quickKey"": 2}, "
^YTT(601.712,131,1,164,0)="     {""id"": ""c5102"", ""text"": ""3. * Only have accidents at night?"", ""quickKey"": 3}, "
^YTT(601.712,131,1,165,0)="     {""id"": ""c5103"", ""text"": ""4. * Have accidents more than once a week?"", ""quickKey"": 4}, "
^YTT(601.712,131,1,166,0)="     {""id"": ""c5104"", ""text"": ""5. * Have bowel movements in your clothes more than once a week?"", ""quickKey"": 5}, "
^YTT(601.712,131,1,167,0)="     {""id"": ""c5105"", ""text"": ""6. * Wet your pants and have bowel movements in your clothes very often?"", ""quickKey"": 6}, "
^YTT(601.712,131,1,168,0)="     {""id"": ""c5106"", ""text"": ""7. * Are enrolled in VA Bowel and Bladder Program?"", ""quickKey"": 7}"
^YTT(601.712,131,1,169,0)="   ]}, "
^YTT(601.712,131,1,170,0)="   {""id"": ""q8545"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,131,1,171,0)="    ""text"": ""Q11. MDS HC 2.0/CPS Cognitive Skill for Daily Decision Making"", "
^YTT(601.712,131,1,172,0)="    ""intro"": ""   "", "
^YTT(601.712,131,1,173,0)="    ""columns"": 1, "
^YTT(601.712,131,1,174,0)="    ""choices"":["
^YTT(601.712,131,1,175,0)="     {""id"": ""c5107"", ""text"": ""0. Independent - decisions consistent/reasonable."", ""quickKey"": 0}, "
^YTT(601.712,131,1,176,0)="     {""id"": ""c5108"", ""text"": ""1. Modified Independence - some difficulty in new situations only."", ""quickKey"": 1}, "
^YTT(601.712,131,1,177,0)="     {""id"": ""c5109"", ""text"": ""2. Moderately Impaired - decisions poor; cues/supervision required."", ""quickKey"": 2}, "
^YTT(601.712,131,1,178,0)="     {""id"": ""c5110"", ""text"": ""3. Severely Impaired - never/rarely made decisions."", ""quickKey"": 3}"
^YTT(601.712,131,1,179,0)="   ]}, "
