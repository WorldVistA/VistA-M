^YTT(601.712,112,1,1,0)="{""name"": ""MPI-PAIN-INTRF"", "
^YTT(601.712,112,1,2,0)=" ""copyright"": ""Copyright © 1985, Robert D. Kerns, Dennis C. Turk, and Thomas E. Rudy."", "
