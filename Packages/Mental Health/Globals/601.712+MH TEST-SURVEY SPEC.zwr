^YTT(601.712,139,1,35,0)="    ""legend"":[""Strongly disagree"", ""Neutral"", ""Strongly agree""]}, "
^YTT(601.712,139,1,36,0)="   {""id"": ""q8654"", ""type"": ""SliderQuestion"", ""required"": true, "
^YTT(601.712,139,1,37,0)="    ""text"": ""4. I have the strength to overcome any obstacles when it comes to working."", "
