^YTT(601.712,180,1,1,0)="{""name"": ""WBS_V2"", "
^YTT(601.712,180,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,180,1,3,0)=" ""printTitle"": ""Well-Being Signs Version 2"", "
^YTT(601.712,180,1,4,0)=" ""content"":["
^YTT(601.712,180,1,5,0)="   {""id"": ""i2553"", ""type"": ""IntroText"", "
^YTT(601.712,180,1,6,0)="    ""text"": ""For these questions, please consider the <strong><u>most important</strong></u> things that you do, or"
^YTT(601.712,180,1,7,0)=" wish to do, in your daily life. <br /><i>[This might include having a job,"
^YTT(601.712,180,1,8,0)=" managing your health and finances, spending time with family and friends,"
^YTT(601.712,180,1,9,0)=" or participating in leisure-time activities.]</i> <br /><br /><strong>If you are not"
^YTT(601.712,180,1,10,0)=" sure which response to choose, please make your best guess.</strong> <br /> <br /><strong>Over"
^YTT(601.712,180,1,11,0)=" the past month,</strong> on average how often have you been: <br /><br />Use the following"
^YTT(601.712,180,1,12,0)=" scale <br />0    -    1    -    2    -    3    -    4    -    5    -    6    -  "
^YTT(601.712,180,1,13,0)="  7    -    8    -    9    -    10 <br />None of the Time                        "
^YTT(601.712,180,1,14,0)="                                           All of the time"""
^YTT(601.712,180,1,15,0)="    }, "
^YTT(601.712,180,1,16,0)="   {""id"": ""q9250"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
