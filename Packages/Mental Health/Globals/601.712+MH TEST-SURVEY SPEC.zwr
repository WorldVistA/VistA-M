^YTT(601.712,122,1,32,0)="    ""choices"":["
^YTT(601.712,122,1,33,0)="     {""id"": ""c4067"", ""text"": ""0. Absent"", ""quickKey"": 0}, "
^YTT(601.712,122,1,34,0)="     {""id"": ""c4068"", ""text"": ""1. Mild to Intermittent"", ""quickKey"": 1}, "
^YTT(601.712,122,1,35,0)="     {""id"": ""c4069"", ""text"": ""2. Severe"", ""quickKey"": 2}, "
^YTT(601.712,122,1,36,0)="     {""id"": ""c4070"", ""text"": ""3. Unable to evaluate"", ""quickKey"": 3}, "
^YTT(601.712,122,1,37,0)="     {""id"": ""c4071"", ""text"": ""4. Symptoms result from physical disability or illness"", ""quickKey"": 4}"
^YTT(601.712,122,1,38,0)="   ]}, "
^YTT(601.712,122,1,39,0)="   {""id"": ""q8359"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,122,1,40,0)="    ""text"": ""2. MOOD-RELATED SIGNS: Sadness; sad expression, sad voice, tearfulness"", "
^YTT(601.712,122,1,41,0)="    ""intro"": ""Ratings should be based on symptoms and signs occurring during the week before"
