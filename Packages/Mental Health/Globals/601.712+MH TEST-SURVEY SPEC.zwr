^YTT(601.712,194,1,1,0)="{""name"": ""ALSFRS-R"", "
^YTT(601.712,194,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,194,1,3,0)=" ""printTitle"": ""ALS Functional Rating Scale Revised"", "
^YTT(601.712,194,1,4,0)=" ""content"":["
^YTT(601.712,194,1,5,0)="   {""id"": ""i2612"", ""type"": ""IntroText"", "
^YTT(601.712,194,1,6,0)="    ""text"": ""The ALSFRS-R measures 12 aspects of physical function, ranging from one's ability"
^YTT(601.712,194,1,7,0)=" to swallow and use utensils to climbing stairs and breathing. Each function is"
^YTT(601.712,194,1,8,0)=" scored from 4 (normal) to 0 (no ability), with a maximum total score of 48 and a"
^YTT(601.712,194,1,9,0)=" minimum total score of 0."""
^YTT(601.712,194,1,10,0)="    }, "
^YTT(601.712,194,1,11,0)="   {""id"": ""q9515"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,194,1,12,0)="    ""text"": ""1. Speech"", "
^YTT(601.712,194,1,13,0)="    ""intro"": ""The ALSFRS-R measures 12 aspects of physical function, ranging from one's ability"
^YTT(601.712,194,1,14,0)=" to swallow and use utensils to climbing stairs and breathing. Each function is"
^YTT(601.712,194,1,15,0)=" scored from 4 (normal) to 0 (no ability), with a maximum total score of 48 and a"
^YTT(601.712,194,1,16,0)=" minimum total score of 0."", "
^YTT(601.712,194,1,17,0)="    ""columns"": 1, "
^YTT(601.712,194,1,18,0)="    ""choices"":["
^YTT(601.712,194,1,19,0)="     {""id"": ""c6095"", ""text"": "" 4 - Normal speech process"", ""quickKey"": 4}, "
^YTT(601.712,194,1,20,0)="     {""id"": ""c6096"", ""text"": "" 3 - Detectable speech disturbance"", ""quickKey"": 3}, "
^YTT(601.712,194,1,21,0)="     {""id"": ""c6097"", ""text"": "" 2 - Intelligible with repeating"", ""quickKey"": 2}, "
^YTT(601.712,194,1,22,0)="     {""id"": ""c6098"", ""text"": "" 1 - Speech combined with nonvocal communication"", ""quickKey"": 1}, "
^YTT(601.712,194,1,23,0)="     {""id"": ""c6099"", ""text"": "" 0 - Loss of useful speech"", ""quickKey"": 0}"
^YTT(601.712,194,1,24,0)="   ]}, "
^YTT(601.712,194,1,25,0)="   {""id"": ""q9516"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,194,1,26,0)="    ""text"": ""2. Salivation"", "
^YTT(601.712,194,1,27,0)="    ""intro"": ""The ALSFRS-R measures 12 aspects of physical function, ranging from one's ability"
^YTT(601.712,194,1,28,0)=" to swallow and use utensils to climbing stairs and breathing. Each function is"
^YTT(601.712,194,1,29,0)=" scored from 4 (normal) to 0 (no ability), with a maximum total score of 48 and a"
^YTT(601.712,194,1,30,0)=" minimum total score of 0."", "
^YTT(601.712,194,1,31,0)="    ""columns"": 1, "
^YTT(601.712,194,1,32,0)="    ""choices"":["
^YTT(601.712,194,1,33,0)="     {""id"": ""c6100"", ""text"": "" 4 - Normal"", ""quickKey"": 4}, "
^YTT(601.712,194,1,34,0)="     {""id"": ""c6101"", ""text"": "" 3 - Slight but definite excess of saliva in mouth; may have nighttime drooling"", ""quickKey"": 3}, "
^YTT(601.712,194,1,35,0)="     {""id"": ""c6102"", ""text"": "" 2 - Moderately excessive saliva; may have minimal drooling"", ""quickKey"": 2}, "
^YTT(601.712,194,1,36,0)="     {""id"": ""c6103"", ""text"": "" 1 - Marked excess of saliva with some drooling"", ""quickKey"": 1}, "
^YTT(601.712,194,1,37,0)="     {""id"": ""c6104"", ""text"": "" 0 - Marked drooling; requires constant tissue or handkerchief"", ""quickKey"": 0}"
^YTT(601.712,194,1,38,0)="   ]}, "
^YTT(601.712,194,1,39,0)="   {""id"": ""q9517"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,194,1,40,0)="    ""text"": ""3. Swallowing"", "
^YTT(601.712,194,1,41,0)="    ""intro"": ""The ALSFRS-R measures 12 aspects of physical function, ranging from one's ability"
^YTT(601.712,194,1,42,0)=" to swallow and use utensils to climbing stairs and breathing. Each function is"
^YTT(601.712,194,1,43,0)=" scored from 4 (normal) to 0 (no ability), with a maximum total score of 48 and a"
^YTT(601.712,194,1,44,0)=" minimum total score of 0."", "
^YTT(601.712,194,1,45,0)="    ""columns"": 1, "
^YTT(601.712,194,1,46,0)="    ""choices"":["
^YTT(601.712,194,1,47,0)="     {""id"": ""c6105"", ""text"": "" 4 - Normal eating habits"", ""quickKey"": 4}, "
^YTT(601.712,194,1,48,0)="     {""id"": ""c6106"", ""text"": "" 3 - Early eating problems - occasional choking"", ""quickKey"": 3}, "
^YTT(601.712,194,1,49,0)="     {""id"": ""c6107"", ""text"": "" 2 - Dietary consistency changes"", ""quickKey"": 2}, "
^YTT(601.712,194,1,50,0)="     {""id"": ""c6108"", ""text"": "" 1 - Needs supplemental tube feedings"", ""quickKey"": 1}, "
^YTT(601.712,194,1,51,0)="     {""id"": ""c6109"", ""text"": "" 0 - NPO (exclusively parenteral or enteral feeding)"", ""quickKey"": 0}"
^YTT(601.712,194,1,52,0)="   ]}, "
^YTT(601.712,194,1,53,0)="   {""id"": ""q9518"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,194,1,54,0)="    ""text"": ""4. Handwriting"", "
^YTT(601.712,194,1,55,0)="    ""intro"": ""The ALSFRS-R measures 12 aspects of physical function, ranging from one's ability"
