^YTT(601.712,32,0)="76^3220408.081407^726014280"
^YTT(601.712,32,1,0)="^^178^178^3220408"
^YTT(601.712,32,1,1,0)="{""name"": ""BRADEN SCALE"", "
^YTT(601.712,32,1,2,0)=" ""copyright"": ""Copyright Barbara Braden & Nancy Bergstrom, 1988"", "
^YTT(601.712,32,1,3,0)=" ""restartDays"": 2, "
^YTT(601.712,32,1,4,0)=" ""printTitle"": ""Braden Scale for Predicting Pressure Ulcer Risk"","
^YTT(601.712,32,1,5,0)=" ""content"":["
^YTT(601.712,32,1,6,0)="   {""id"": ""i708"", ""type"": ""IntroText"", "
^YTT(601.712,32,1,7,0)="    ""text"": ""Terms used in the next item. COMPLETELY LIMITED: Unresponsive (doesn't moan,"
^YTT(601.712,32,1,8,0)=" flinch, or gasp) to painful stimuli due to diminished level of consciousness or"
^YTT(601.712,32,1,9,0)=" sedation or limited ability to feel pain over most of body. VERY LIMITED:"
^YTT(601.712,32,1,10,0)=" Responds only to painful stimuli. Cannot communicate discomfort except by"
^YTT(601.712,32,1,11,0)=" moaning or restlessness or has a sensory impairment that limits the ability to"
^YTT(601.712,32,1,12,0)=" feel pain or discomfort over half of body. SLIGHTLY LIMITED: Responds to verbal"
^YTT(601.712,32,1,13,0)=" commands, but cannot always communicate discomfort of the need to be turned or"
^YTT(601.712,32,1,14,0)=" has some sensory impairment that limits ability to feel pain or discomfort in"
^YTT(601.712,32,1,15,0)=" one or two extremities. NO IMPAIRMENT: Responds to verbal commands. Has no"
^YTT(601.712,32,1,16,0)=" sensory deficit that would limit ability to feel pain or voice pain or"
^YTT(601.712,32,1,17,0)=" discomfort."""
^YTT(601.712,32,1,18,0)="    }, "
^YTT(601.712,32,1,19,0)="   {""id"": ""q5427"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,32,1,20,0)="    ""text"": "" Sensory perception -- ability to respond meaningfully to pressure-related"
^YTT(601.712,32,1,21,0)=" discomfort"", "
^YTT(601.712,32,1,22,0)="    ""intro"": ""Terms used in the next item. COMPLETELY LIMITED: Unresponsive (doesn't moan,"
^YTT(601.712,32,1,23,0)=" flinch, or gasp) to painful stimuli due to diminished level of consciousness or"
^YTT(601.712,32,1,24,0)=" sedation or limited ability to feel pain over most of body. VERY LIMITED:"
^YTT(601.712,32,1,25,0)=" Responds only to painful stimuli. Cannot communicate discomfort except by"
^YTT(601.712,32,1,26,0)=" moaning or restlessness or has a sensory impairment that limits the ability to"
^YTT(601.712,32,1,27,0)=" feel pain or discomfort over half of body. SLIGHTLY LIMITED: Responds to verbal"
^YTT(601.712,32,1,28,0)=" commands, but cannot always communicate discomfort of the need to be turned or"
^YTT(601.712,32,1,29,0)=" has some sensory impairment that limits ability to feel pain or discomfort in"
^YTT(601.712,32,1,30,0)=" one or two extremities. NO IMPAIRMENT: Responds to verbal commands. Has no"
^YTT(601.712,32,1,31,0)=" sensory deficit that would limit ability to feel pain or voice pain or"
^YTT(601.712,32,1,32,0)=" discomfort."", "
^YTT(601.712,32,1,33,0)="    ""columns"": 1, "
^YTT(601.712,32,1,34,0)="    ""choices"":["
^YTT(601.712,32,1,35,0)="     {""id"": ""c1203"", ""text"": ""1. Completely limited."", ""quickKey"": 1}, "
^YTT(601.712,32,1,36,0)="     {""id"": ""c1204"", ""text"": ""2. Very limited."", ""quickKey"": 2}, "
^YTT(601.712,32,1,37,0)="     {""id"": ""c1205"", ""text"": ""3. Slightly limited."", ""quickKey"": 3}, "
^YTT(601.712,32,1,38,0)="     {""id"": ""c1206"", ""text"": ""4. No impairment."", ""quickKey"": 4}"
^YTT(601.712,32,1,39,0)="   ]}, "
^YTT(601.712,32,1,40,0)="   {""id"": ""i787"", ""type"": ""IntroText"", "
^YTT(601.712,32,1,41,0)="    ""text"": ""Terms used in next item. CONSTANTLY MOIST: Skin is kept moist almost constantly"
^YTT(601.712,32,1,42,0)=" by perspiration, urine, etc. Dampness is detected every time patient is moved or"
^YTT(601.712,32,1,43,0)=" turned. VERY MOIST: Skin is often, but  not always, moist. Linen must be changed"
^YTT(601.712,32,1,44,0)=" at least once a shift. OCCASIONALLY MOIST: Skin is occasionally moist, requiring"
^YTT(601.712,32,1,45,0)=" an extra linen change about once a day. RARELY MOIST: Skin is usually dry; "
^YTT(601.712,32,1,46,0)=" linen requires changing at routine intervals."""
^YTT(601.712,32,1,47,0)="    }, "
^YTT(601.712,32,1,48,0)="   {""id"": ""q5428"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,32,1,49,0)="    ""text"": "" Moisture -- degree to which skin is exposed to moisture"", "
^YTT(601.712,32,1,50,0)="    ""intro"": ""Terms used in next item. CONSTANTLY MOIST: Skin is kept moist almost constantly"
^YTT(601.712,32,1,51,0)=" by perspiration, urine, etc. Dampness is detected every time patient is moved or"
^YTT(601.712,32,1,52,0)=" turned. VERY MOIST: Skin is often, but  not always, moist. Linen must be changed"
^YTT(601.712,32,1,53,0)=" at least once a shift. OCCASIONALLY MOIST: Skin is occasionally moist, requiring"
^YTT(601.712,32,1,54,0)=" an extra linen change about once a day. RARELY MOIST: Skin is usually dry; "
^YTT(601.712,32,1,55,0)=" linen requires changing at routine intervals."", "
^YTT(601.712,32,1,56,0)="    ""columns"": 1, "
^YTT(601.712,32,1,57,0)="    ""choices"":["
^YTT(601.712,32,1,58,0)="     {""id"": ""c1234"", ""text"": ""1. Constantly moist."", ""quickKey"": 1}, "
^YTT(601.712,32,1,59,0)="     {""id"": ""c1227"", ""text"": ""2. Very moist."", ""quickKey"": 2}, "
^YTT(601.712,32,1,60,0)="     {""id"": ""c1228"", ""text"": ""3. Occasionally moist."", ""quickKey"": 3}, "
^YTT(601.712,32,1,61,0)="     {""id"": ""c1229"", ""text"": ""4. Rarely moist."", ""quickKey"": 4}"
^YTT(601.712,32,1,62,0)="   ]}, "
^YTT(601.712,32,1,63,0)="   {""id"": ""i788"", ""type"": ""IntroText"", "
^YTT(601.712,32,1,64,0)="    ""text"": ""Terms used in next item. BEDFAST: Confined to bed. CHAIR FAST: Ability to walk"
^YTT(601.712,32,1,65,0)=" severely limited or nonexistent. Cannot bear own weight or must be assisted into"
^YTT(601.712,32,1,66,0)=" chair or wheelchair. WALKS  OCCASIONALLY: Walks occasionally during day but for"
^YTT(601.712,32,1,67,0)=" very short distances, with or without assistance. Spends most of each shift in"
^YTT(601.712,32,1,68,0)=" bed or chair. WALKS FREQUENTLY: Walks outside room at least twice a  day and"
^YTT(601.712,32,1,69,0)=" inside room at least once every 2 hours during waking hours."""
^YTT(601.712,32,1,70,0)="    }, "
^YTT(601.712,32,1,71,0)="   {""id"": ""q5429"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,32,1,72,0)="    ""text"": "" Activity -- ability to change and control body position"", "
^YTT(601.712,32,1,73,0)="    ""intro"": ""Terms used in next item. BEDFAST: Confined to bed. CHAIR FAST: Ability to walk"
^YTT(601.712,32,1,74,0)=" severely limited or nonexistent. Cannot bear own weight or must be assisted into"
^YTT(601.712,32,1,75,0)=" chair or wheelchair. WALKS  OCCASIONALLY: Walks occasionally during day but for"
^YTT(601.712,32,1,76,0)=" very short distances, with or without assistance. Spends most of each shift in"
^YTT(601.712,32,1,77,0)=" bed or chair. WALKS FREQUENTLY: Walks outside room at least twice a  day and"
^YTT(601.712,32,1,78,0)=" inside room at least once every 2 hours during waking hours."", "
^YTT(601.712,32,1,79,0)="    ""columns"": 1, "
^YTT(601.712,32,1,80,0)="    ""choices"":["
^YTT(601.712,32,1,81,0)="     {""id"": ""c1230"", ""text"": ""1. Bedfast."", ""quickKey"": 1}, "
^YTT(601.712,32,1,82,0)="     {""id"": ""c1231"", ""text"": ""2. Chair fast."", ""quickKey"": 2}, "
^YTT(601.712,32,1,83,0)="     {""id"": ""c1232"", ""text"": ""3. Walks occasionally."", ""quickKey"": 3}, "
^YTT(601.712,32,1,84,0)="     {""id"": ""c1233"", ""text"": ""4. Walks frequently."", ""quickKey"": 4}"
^YTT(601.712,32,1,85,0)="   ]}, "
^YTT(601.712,32,1,86,0)="   {""id"": ""i789"", ""type"": ""IntroText"", "
^YTT(601.712,32,1,87,0)="    ""text"": ""Terms used in next item. COMPLETLY IMMOBILE:  Doesn't make even slight changes in"
^YTT(601.712,32,1,88,0)=" body or extremity position without assistance. VERY LIMITED: Makes occasional"
^YTT(601.712,32,1,89,0)=" slight changes in body or extremity position but can't make frequent or"
^YTT(601.712,32,1,90,0)=" significant  changes independently. SLIGHTLY LIMITED: Makes frequent though"
^YTT(601.712,32,1,91,0)=" slight changes in body or extremity position independently. NO LIMITATION: Makes"
^YTT(601.712,32,1,92,0)=" major and frequent changes in position without  assistance."""
^YTT(601.712,32,1,93,0)="    }, "
^YTT(601.712,32,1,94,0)="   {""id"": ""q5430"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,32,1,95,0)="    ""text"": "" Mobility -- ability to change and control body position"", "
^YTT(601.712,32,1,96,0)="    ""intro"": ""Terms used in next item. COMPLETLY IMMOBILE:  Doesn't make even slight changes in"
^YTT(601.712,32,1,97,0)=" body or extremity position without assistance. VERY LIMITED: Makes occasional"
^YTT(601.712,32,1,98,0)=" slight changes in body or extremity position but can't make frequent or"
^YTT(601.712,32,1,99,0)=" significant  changes independently. SLIGHTLY LIMITED: Makes frequent though"
^YTT(601.712,32,1,100,0)=" slight changes in body or extremity position independently. NO LIMITATION: Makes"
^YTT(601.712,32,1,101,0)=" major and frequent changes in position without  assistance."", "
^YTT(601.712,32,1,102,0)="    ""columns"": 1, "
^YTT(601.712,32,1,103,0)="    ""choices"":["
^YTT(601.712,32,1,104,0)="     {""id"": ""c1235"", ""text"": ""1. Completely immobile."", ""quickKey"": 1}, "
^YTT(601.712,32,1,105,0)="     {""id"": ""c1204"", ""text"": ""2. Very limited."", ""quickKey"": 2}, "
^YTT(601.712,32,1,106,0)="     {""id"": ""c1205"", ""text"": ""3. Slightly limited."", ""quickKey"": 3}, "
^YTT(601.712,32,1,107,0)="     {""id"": ""c1236"", ""text"": ""4. No limitation."", ""quickKey"": 4}"
^YTT(601.712,32,1,108,0)="   ]}, "
^YTT(601.712,32,1,109,0)="   {""id"": ""i890"", ""type"": ""IntroText"", "
^YTT(601.712,32,1,110,0)="    ""text"": ""Terms used in next item. VERY POOR: Never eats a complete meal. Rarely eats more"
^YTT(601.712,32,1,111,0)=" than half of any food offered. Eats two servings or less of protein (meat or"
^YTT(601.712,32,1,112,0)=" dairy products) per day. Takes fluids poorly. Doesn't take a liquid dietary"
^YTT(601.712,32,1,113,0)=" supplement or is N.P.O. or maintained on clear liquids or I.V. solution for more"
^YTT(601.712,32,1,114,0)=" than 5 days. PROBABLY INADEQUATE: Rarely eats a complete meal and generally eats"
^YTT(601.712,32,1,115,0)=" only about half of any food offered. Eats three servings of protein (meat or"
^YTT(601.712,32,1,116,0)=" dairy products) per day. Occasionally will take a dietary supplement or receives"
^YTT(601.712,32,1,117,0)=" less than optimum amount of liquid diet or tube feeding. ADEQUATE: Eats over"
^YTT(601.712,32,1,118,0)=" half of most meals. Eats four servings of protein (meat or dairy products) per"
^YTT(601.712,32,1,119,0)=" day. Occasionally will refuse a meal, but will usually take a supplement when"
^YTT(601.712,32,1,120,0)=" offered or is on a tube feeding or total parenteral nutrition regime that"
^YTT(601.712,32,1,121,0)=" probably meets most of nutritional needs. EXCELLENT: Eats most every meal. Never"
^YTT(601.712,32,1,122,0)=" refuses a meal. Eats four or more servings of protein (meat or dairy products)"
^YTT(601.712,32,1,123,0)=" per day. Occasionally eats between meals. Doesn't require supplementations."""
^YTT(601.712,32,1,124,0)="    }, "
^YTT(601.712,32,1,125,0)="   {""id"": ""q5431"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,32,1,126,0)="    ""text"": "" Nutrition -- usual food intake patterns"", "
^YTT(601.712,32,1,127,0)="    ""intro"": ""Terms used in next item. VERY POOR: Never eats a complete meal. Rarely eats more"
^YTT(601.712,32,1,128,0)=" than half of any food offered. Eats two servings or less of protein (meat or"
^YTT(601.712,32,1,129,0)=" dairy products) per day. Takes fluids poorly. Doesn't take a liquid dietary"
^YTT(601.712,32,1,130,0)=" supplement or is N.P.O. or maintained on clear liquids or I.V. solution for more"
^YTT(601.712,32,1,131,0)=" than 5 days. PROBABLY INADEQUATE: Rarely eats a complete meal and generally eats"
^YTT(601.712,32,1,132,0)=" only about half of any food offered. Eats three servings of protein (meat or"
^YTT(601.712,32,1,133,0)=" dairy products) per day. Occasionally will take a dietary supplement or receives"
^YTT(601.712,32,1,134,0)=" less than optimum amount of liquid diet or tube feeding. ADEQUATE: Eats over"
^YTT(601.712,32,1,135,0)=" half of most meals. Eats four servings of protein (meat or dairy products) per"
^YTT(601.712,32,1,136,0)=" day. Occasionally will refuse a meal, but will usually take a supplement when"
^YTT(601.712,32,1,137,0)=" offered or is on a tube feeding or total parenteral nutrition regime that"
^YTT(601.712,32,1,138,0)=" probably meets most of nutritional needs. EXCELLENT: Eats most every meal. Never"
^YTT(601.712,32,1,139,0)=" refuses a meal. Eats four or more servings of protein (meat or dairy products)"
^YTT(601.712,32,1,140,0)=" per day. Occasionally eats between meals. Doesn't require supplementations."", "
^YTT(601.712,32,1,141,0)="    ""columns"": 1, "
^YTT(601.712,32,1,142,0)="    ""choices"":["
^YTT(601.712,32,1,143,0)="     {""id"": ""c1237"", ""text"": ""1. Very poor."", ""quickKey"": 1}, "
^YTT(601.712,32,1,144,0)="     {""id"": ""c1238"", ""text"": ""2. Probably inadequate."", ""quickKey"": 2}, "
^YTT(601.712,32,1,145,0)="     {""id"": ""c1239"", ""text"": ""3. Adequate."", ""quickKey"": 3}, "
^YTT(601.712,32,1,146,0)="     {""id"": ""c1240"", ""text"": ""4. Excellent."", ""quickKey"": 4}"
^YTT(601.712,32,1,147,0)="   ]}, "
^YTT(601.712,32,1,148,0)="   {""id"": ""i790"", ""type"": ""IntroText"", "
^YTT(601.712,32,1,149,0)="    ""text"": ""Terms used in next item. PROBLEM: Requires moderate to maximum assistance in"
^YTT(601.712,32,1,150,0)=" moving. Complete lifting without sliding against sheets is impossible."
^YTT(601.712,32,1,151,0)=" Frequently slides down in bed or chair, requiring  frequent respositioning with"
^YTT(601.712,32,1,152,0)=" maximum assistance. Spasticity, contractures, or agitation leads to almost"
^YTT(601.712,32,1,153,0)=" constant friction. POTENTIAL PROBLEM: Moves feebly or requires minimum"
^YTT(601.712,32,1,154,0)=" assistance. During a  move, skin probably slides to some extent against sheets,"
^YTT(601.712,32,1,155,0)=" chair, restraints or other devices. Maintains relatively good position in chair"
^YTT(601.712,32,1,156,0)=" or bed most of the time but occasionally slides down. NO APPARENT PROBLEM: Moves"
^YTT(601.712,32,1,157,0)=" in bed and in chair independently and has sufficient muscle strength to lift up"
^YTT(601.712,32,1,158,0)=" completely during move. Maintains good position in bed or chair."""
^YTT(601.712,32,1,159,0)="    }, "
^YTT(601.712,32,1,160,0)="   {""id"": ""q5432"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,32,1,161,0)="    ""text"": "" Friction and shear"", "
^YTT(601.712,32,1,162,0)="    ""intro"": ""Terms used in next item. PROBLEM: Requires moderate to maximum assistance in"
^YTT(601.712,32,1,163,0)=" moving. Complete lifting without sliding against sheets is impossible."
^YTT(601.712,32,1,164,0)=" Frequently slides down in bed or chair, requiring  frequent respositioning with"
^YTT(601.712,32,1,165,0)=" maximum assistance. Spasticity, contractures, or agitation leads to almost"
^YTT(601.712,32,1,166,0)=" constant friction. POTENTIAL PROBLEM: Moves feebly or requires minimum"
^YTT(601.712,32,1,167,0)=" assistance. During a  move, skin probably slides to some extent against sheets,"
^YTT(601.712,32,1,168,0)=" chair, restraints or other devices. Maintains relatively good position in chair"
^YTT(601.712,32,1,169,0)=" or bed most of the time but occasionally slides down. NO APPARENT PROBLEM: Moves"
^YTT(601.712,32,1,170,0)=" in bed and in chair independently and has sufficient muscle strength to lift up"
^YTT(601.712,32,1,171,0)=" completely during move. Maintains good position in bed or chair."", "
^YTT(601.712,32,1,172,0)="    ""columns"": 1, "
^YTT(601.712,32,1,173,0)="    ""choices"":["
^YTT(601.712,32,1,174,0)="     {""id"": ""c1241"", ""text"": ""1. Problem."", ""quickKey"": 1}, "
^YTT(601.712,32,1,175,0)="     {""id"": ""c1242"", ""text"": ""2. Potential problem."", ""quickKey"": 2}, "
^YTT(601.712,32,1,176,0)="     {""id"": ""c1243"", ""text"": ""3. No apparent problem."", ""quickKey"": 3}"
^YTT(601.712,32,1,177,0)="   ]}]"
^YTT(601.712,32,1,178,0)="}"
^YTT(601.712,33,0)="78^3220408.081435^831369406"
^YTT(601.712,33,1,0)="^^367^367^3220408"
^YTT(601.712,33,1,1,0)="{""name"": ""MHLC-C"", "
^YTT(601.712,33,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,33,1,3,0)=" ""printTitle"": ""Multidimensional Health Locus of Control: Form C"","
^YTT(601.712,33,1,4,0)=" ""content"":["
^YTT(601.712,33,1,5,0)="   {""id"": ""i583"", ""type"": ""IntroText"", "
^YTT(601.712,33,1,6,0)="    ""text"": ""Each item below is a belief statement about your medical condition with which you"
^YTT(601.712,33,1,7,0)=" may agree or disagree. Each statement has a scale which ranges from strongly"
^YTT(601.712,33,1,8,0)=" disagree (1) to strongly agree (6). For  each item we would like you to pick the"
