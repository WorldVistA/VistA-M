^YTT(601.712,128,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,128,1,3,0)=" ""printTitle"": ""SHORT INVENTORY OF PROBLEMS - AD (SIP-AD-30)"","
^YTT(601.712,128,1,4,0)=" ""content"":["
^YTT(601.712,128,1,5,0)="   {""id"": ""i2432"", ""type"": ""IntroText"", "
^YTT(601.712,128,1,6,0)="    ""text"": "" Here are a number of events that people sometimes experience in relation to"
^YTT(601.712,128,1,7,0)=" their use of alcohol and other drugs. Read each one carefully and then indicate"
^YTT(601.712,128,1,8,0)=" how often each one has happened to you IN THE PAST 30 DAYS by selecting the"
^YTT(601.712,128,1,9,0)=" appropriate response (Never, Once or a few times, Once or twice a week, Daily or"
^YTT(601.712,128,1,10,0)=" almost daily). If any item does not apply to you select Never."""
^YTT(601.712,128,1,11,0)="    }, "
^YTT(601.712,128,1,12,0)="   {""id"": ""q8529"", ""type"": ""StringQuestion"", ""required"": false, ""inline"": true, "
^YTT(601.712,128,1,13,0)="    ""text"": "" Session number:"", "
^YTT(601.712,128,1,14,0)="    ""intro"": "" Here are a number of events that people sometimes experience in relation to"
^YTT(601.712,128,1,15,0)=" their use of alcohol and other drugs. Read each one carefully and then indicate"
^YTT(601.712,128,1,16,0)=" how often each one has happened to you IN THE PAST 30 DAYS by selecting the"
^YTT(601.712,128,1,17,0)=" appropriate response (Never, Once or a few times, Once or twice a week, Daily or"
^YTT(601.712,128,1,18,0)=" almost daily). If any item does not apply to you select Never."", "
^YTT(601.712,128,1,19,0)="    ""controlWidth"": 50}, "
^YTT(601.712,128,1,20,0)="   {""id"": ""q8483"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,128,1,21,0)="    ""text"": ""1. In the past 30 days, I have been unhappy because of my drinking or drug use."", "
