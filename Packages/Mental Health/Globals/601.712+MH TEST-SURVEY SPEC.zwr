^YTT(601.712,87,1,8,0)="    }, "
^YTT(601.712,87,1,9,0)="   {""id"": ""q7023"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,87,1,10,0)="    ""text"": ""1. I am clear about my feelings."", "
^YTT(601.712,87,1,11,0)="    ""intro"": ""Please indicate how often the following statements apply to you by selecting the"
