^YTT(601.712,91,1,82,0)="   {""id"": ""q7317"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,91,1,83,0)="    ""text"": ""9. TACTILE DISTURBANCES - Ask, \u0022Have you any itching, pins and needles"
^YTT(601.712,91,1,84,0)=" sensations, any burning, any numbness, or do you feel bugs crawling on or under"
^YTT(601.712,91,1,85,0)=" your skin?\u0022 Observation:"", "
^YTT(601.712,91,1,86,0)="    ""columns"": 1, "
^YTT(601.712,91,1,87,0)="    ""choices"":["
^YTT(601.712,91,1,88,0)="     {""id"": ""c1"", ""text"": ""0. None"", ""quickKey"": 0}, "
^YTT(601.712,91,1,89,0)="     {""id"": ""c2437"", ""text"": ""1. Very mild itching, pins and needles, burning or numbness"", ""quickKey"": 1}, "
^YTT(601.712,91,1,90,0)="     {""id"": ""c2438"", ""text"": ""2. Mild itching, pins and needles, burning or numbness"", ""quickKey"": 2}, "
