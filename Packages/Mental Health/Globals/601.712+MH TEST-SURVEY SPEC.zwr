^YTT(601.712,119,1,4,0)=" ""printTitle"": ""Internal State Scale - Version 2 (ISS-2)"", "
^YTT(601.712,119,1,5,0)=" ""content"":["
^YTT(601.712,119,1,6,0)="   {""id"": ""i2389"", ""type"": ""IntroText"", "
^YTT(601.712,119,1,7,0)="    ""text"": ""For each of the following statements, please select the number that best"
^YTT(601.712,119,1,8,0)=" describes the way you have felt over the past 24 hours. While there may have"
^YTT(601.712,119,1,9,0)=" been some change during that time, try to give a single summary rating for each"
^YTT(601.712,119,1,10,0)=" item.<br /> <br /> Use the following to describe your feelings:<br /> <br /> 0  "
^YTT(601.712,119,1,11,0)="  -    10    -    20    -    30    -    40    -    50    -    60    -    70    - "
^YTT(601.712,119,1,12,0)="   80    -   90    -    100<br /> Not at all/Rarely                              "
^YTT(601.712,119,1,13,0)="                             Very Much So/Much of the time"""
^YTT(601.712,119,1,14,0)="    }, "
^YTT(601.712,119,1,15,0)="   {""id"": ""q8319"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": true, "
