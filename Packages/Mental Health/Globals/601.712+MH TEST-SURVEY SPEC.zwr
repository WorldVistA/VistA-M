^YTT(601.712,71,1,268,0)="   {""id"": ""q5982"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,71,1,269,0)="    ""text"": ""10A. Choose the following sentence that best describes your current interest in"
^YTT(601.712,71,1,270,0)=" being involved in the community:"", "
^YTT(601.712,71,1,271,0)="    ""intro"": ""Below is a list of statements that describe how people sometimes feel about"
^YTT(601.712,71,1,272,0)=" themselves and their lives. Please read each one carefully and indicate the"
^YTT(601.712,71,1,273,0)=" response that best describes the extent to   which you agree or disagree with"
^YTT(601.712,71,1,274,0)=" the statement.  "", "
^YTT(601.712,71,1,275,0)="    ""columns"": 1, "
^YTT(601.712,71,1,276,0)="    ""choices"":["
^YTT(601.712,71,1,277,0)="     {""id"": ""c3059"", ""text"": ""1. I don't want to participate in community activities in any way."", ""quickKey"": 1}, "
^YTT(601.712,71,1,278,0)="     {""id"": ""c3060"", ""text"": ""2. I only want to participate in community activities that my mental health"
^YTT(601.712,71,1,279,0)=" providers recommend."", ""quickKey"": 2}, "
^YTT(601.712,71,1,280,0)="     {""id"": ""c3061"", ""text"": ""3. I want to be involved in a range of community activities in addition to, or"
^YTT(601.712,71,1,281,0)=" instead of, those discussed with my mental health providers."", ""quickKey"": 3}, "
^YTT(601.712,71,1,282,0)="     {""id"": ""c3062"", ""text"": ""4. In addition to participating in community activities, I want to be a volunteer"
^YTT(601.712,71,1,283,0)=" and contribute my time to some community activity."", ""quickKey"": 4}"
^YTT(601.712,71,1,284,0)="   ]}, "
^YTT(601.712,71,1,285,0)="   {""id"": ""q5983"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,71,1,286,0)="    ""text"": ""10B. Choose the following sentence that best describes your current situation:"", "
