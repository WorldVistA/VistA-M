^YTT(601.712,114,1,6,0)=" ""content"":["
^YTT(601.712,114,1,7,0)="   {""id"": ""i2379"", ""type"": ""IntroText"", "
^YTT(601.712,114,1,8,0)="    ""text"": ""Provide the responses to the following questions for the time period designated."""
^YTT(601.712,114,1,9,0)="    }, "
^YTT(601.712,114,1,10,0)="   {""id"": ""q8004"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,11,0)="    ""text"": ""1. Over the past 2 weeks, how often have you had thoughts that you would be"
^YTT(601.712,114,1,12,0)=" better off dead or of hurting yourself in some way?"", "
^YTT(601.712,114,1,13,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,14,0)="    ""columns"": 1, "
^YTT(601.712,114,1,15,0)="    ""choices"":["
^YTT(601.712,114,1,16,0)="     {""id"": ""c3913"", ""text"": ""0. Not at all"", ""quickKey"": 0}, "
^YTT(601.712,114,1,17,0)="     {""id"": ""c3914"", ""text"": ""1. Several days"", ""quickKey"": 1}, "
^YTT(601.712,114,1,18,0)="     {""id"": ""c3915"", ""text"": ""2. More than half the days"", ""quickKey"": 2}, "
^YTT(601.712,114,1,19,0)="     {""id"": ""c3916"", ""text"": ""3. Nearly every day"", ""quickKey"": 3}"
^YTT(601.712,114,1,20,0)="   ]}, "
^YTT(601.712,114,1,21,0)="   {""id"": ""q8005"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,22,0)="    ""text"": ""2. Over the past month, have you wished you were dead or wished you could go to"
^YTT(601.712,114,1,23,0)=" sleep and not wake up?"", "
^YTT(601.712,114,1,24,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,25,0)="    ""columns"": 1, "
^YTT(601.712,114,1,26,0)="    ""choices"":["
^YTT(601.712,114,1,27,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,28,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,29,0)="   ]}, "
^YTT(601.712,114,1,30,0)="   {""id"": ""q8006"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,31,0)="    ""text"": ""3. Over the past month, have you had any actual thoughts of killing yourself?"", "
^YTT(601.712,114,1,32,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,33,0)="    ""columns"": 1, "
^YTT(601.712,114,1,34,0)="    ""choices"":["
^YTT(601.712,114,1,35,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,36,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,37,0)="   ]}, "
^YTT(601.712,114,1,38,0)="   {""id"": ""q8007"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,39,0)="    ""text"": ""4. Over the past month, have you been thinking about how you might do this?"", "
^YTT(601.712,114,1,40,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,41,0)="    ""columns"": 1, "
^YTT(601.712,114,1,42,0)="    ""choices"":["
^YTT(601.712,114,1,43,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,44,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,45,0)="   ]}, "
^YTT(601.712,114,1,46,0)="   {""id"": ""q8008"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,47,0)="    ""text"": ""5. Over the past month, have you had these thoughts and had some intention of"
^YTT(601.712,114,1,48,0)=" acting on them? "", "
^YTT(601.712,114,1,49,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,50,0)="    ""columns"": 1, "
^YTT(601.712,114,1,51,0)="    ""choices"":["
^YTT(601.712,114,1,52,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,53,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,54,0)="   ]}, "
^YTT(601.712,114,1,55,0)="   {""id"": ""q8009"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,56,0)="    ""text"": ""6. Over the past month, have you started to work out or worked out the details of"
^YTT(601.712,114,1,57,0)=" how to kill yourself?"", "
^YTT(601.712,114,1,58,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,59,0)="    ""columns"": 1, "
^YTT(601.712,114,1,60,0)="    ""choices"":["
^YTT(601.712,114,1,61,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,62,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,63,0)="   ]}, "
^YTT(601.712,114,1,64,0)="   {""id"": ""q8010"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,65,0)="    ""text"": ""7. If yes, at any time in the past month did you intend to carry out this plan?"", "
^YTT(601.712,114,1,66,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,67,0)="    ""columns"": 1, "
^YTT(601.712,114,1,68,0)="    ""choices"":["
^YTT(601.712,114,1,69,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,70,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,71,0)="   ]}, "
^YTT(601.712,114,1,72,0)="   {""id"": ""q8011"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,73,0)="    ""text"": ""8. In your lifetime, have you ever done anything, started to do anything, or"
^YTT(601.712,114,1,74,0)=" prepared to do anything to end your life (for example, collected pills, obtained"
^YTT(601.712,114,1,75,0)=" a gun, gave away valuables, went to the roof but didn't jump)?"", "
^YTT(601.712,114,1,76,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,77,0)="    ""columns"": 1, "
^YTT(601.712,114,1,78,0)="    ""choices"":["
^YTT(601.712,114,1,79,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,80,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,81,0)="   ]}, "
^YTT(601.712,114,1,82,0)="   {""id"": ""q8012"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,114,1,83,0)="    ""text"": ""9. If YES, was this within the past 3 months?"", "
^YTT(601.712,114,1,84,0)="    ""intro"": ""Provide the responses to the following questions for the time period designated."", "
^YTT(601.712,114,1,85,0)="    ""columns"": 1, "
^YTT(601.712,114,1,86,0)="    ""choices"":["
^YTT(601.712,114,1,87,0)="     {""id"": ""c3917"", ""text"": "" Yes""}, "
^YTT(601.712,114,1,88,0)="     {""id"": ""c3918"", ""text"": "" No""}"
^YTT(601.712,114,1,89,0)="   ]}], "
^YTT(601.712,114,1,90,0)=" ""rules"":["
^YTT(601.712,114,1,91,0)="   {""question"": ""q8004"", ""operator"": ""EQ"", ""value"": ""c3913"", "
^YTT(601.712,114,1,92,0)="    ""skips"":[""q8005"",""q8006"",""q8007"",""q8008"",""q8009"",""q8010"",""q8011"",""q8012""]}, "
^YTT(601.712,114,1,93,0)="   {""question"": ""q8007"", ""operator"": ""EQ"", ""value"": ""c3918"", "
^YTT(601.712,114,1,94,0)="    ""skips"":[""q8007"",""q8008"",""q8009"",""q8010""]}, "
^YTT(601.712,114,1,95,0)="   {""question"": ""q8009"", ""operator"": ""EQ"", ""value"": ""c3918"", "
^YTT(601.712,114,1,96,0)="    ""skips"":[""q8010""]}, "
^YTT(601.712,114,1,97,0)="   {""question"": ""q8011"", ""operator"": ""EQ"", ""value"": ""c3918"", "
^YTT(601.712,114,1,98,0)="    ""skips"":[""q8012""]}]"
^YTT(601.712,114,1,99,0)="}"
