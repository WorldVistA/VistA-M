^YTT(601.712,17,1,922,0)="    ""text"": ""125. People sometimes get annoyed with me because they say I talk too much or too"
^YTT(601.712,17,1,923,0)=" fast for them."", "
^YTT(601.712,17,1,924,0)="    "
^YTT(601.712,17,1,925,0)="    ""choices"":["
^YTT(601.712,17,1,926,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
