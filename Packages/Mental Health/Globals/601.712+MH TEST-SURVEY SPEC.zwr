^YTT(601.712,106,1,6,0)=" ""content"":["
^YTT(601.712,106,1,7,0)="   {""id"": ""i2370"", ""type"": ""IntroText"", "
^YTT(601.712,106,1,8,0)="    ""text"": ""The goal of this questionnaire is to find out how you view your own current"
^YTT(601.712,106,1,9,0)=" recovery process. The mental health recovery process is complex and is different"
^YTT(601.712,106,1,10,0)=" for each individual. There are no right or wrong answers.<br /> <br /> Please"
^YTT(601.712,106,1,11,0)=" read each statement carefully, with regard to your own current recovery process."
^YTT(601.712,106,1,12,0)=" For each question, indicate the statement that best represents the way you"
^YTT(601.712,106,1,13,0)=" feel:<br /> <br /> 1. Strongly Disagree 2. Disagree 3. Not sure 4. Agree 5."
^YTT(601.712,106,1,14,0)=" Strongly Agree"""
^YTT(601.712,106,1,15,0)="    }, "
^YTT(601.712,106,1,16,0)="   {""id"": ""q7891"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,106,1,17,0)="    ""text"": ""1. I work hard toward my mental health recovery."", "
^YTT(601.712,106,1,18,0)="    ""intro"": ""The goal of this questionnaire is to find out how you view your own current"
^YTT(601.712,106,1,19,0)=" recovery process. The mental health recovery process is complex and is different"
^YTT(601.712,106,1,20,0)=" for each individual. There are no right or wrong answers.<br /> <br /> Please"
^YTT(601.712,106,1,21,0)=" read each statement carefully, with regard to your own current recovery process."
^YTT(601.712,106,1,22,0)=" For each question, indicate the statement that best represents the way you"
^YTT(601.712,106,1,23,0)=" feel:<br /> <br /> 1. Strongly Disagree 2. Disagree 3. Not sure 4. Agree 5."
^YTT(601.712,106,1,24,0)=" Strongly Agree"", "
