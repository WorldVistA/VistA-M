^YTT(601.712,155,1,1,0)="{""name"": ""MIOS+B-IPF"","
^YTT(601.712,155,1,2,0)=" ""restartDays"": 2,"
^YTT(601.712,155,1,3,0)=" ""printTitle"": ""Moral Injury Outcome Scale"","
^YTT(601.712,155,1,4,0)=" ""content"":["
^YTT(601.712,155,1,5,0)="   {""id"": ""i2485"", ""type"": ""IntroText"","
^YTT(601.712,155,1,6,0)="    ""text"": ""This questionnaire asks about experiences you may have had after a very stressful"
^YTT(601.712,155,1,7,0)=" experience in which you: (A) did something (or failed to do something) that went"
^YTT(601.712,155,1,8,0)=" against your moral code or values; or (B) you saw someone (or people) do"
^YTT(601.712,155,1,9,0)=" something or fail to do something that went against your moral code or values;"
^YTT(601.712,155,1,10,0)=" or (C) you were directly affected by someone doing something or failing to do"
^YTT(601.712,155,1,11,0)=" something that went against your moral code or values (e.g., being betrayed by"
^YTT(601.712,155,1,12,0)=" someone you trusted)."""
^YTT(601.712,155,1,13,0)="    },"
^YTT(601.712,155,1,14,0)="   {""id"": ""q8922"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false,"
^YTT(601.712,155,1,15,0)="    ""text"": "" Have you had at least one experience like this that troubles you currently?"","
^YTT(601.712,155,1,16,0)="    ""intro"": ""This questionnaire asks about experiences you may have had after a very stressful"
^YTT(601.712,155,1,17,0)=" experience in which you: (A) did something (or failed to do something) that went"
^YTT(601.712,155,1,18,0)=" against your moral code or values; or (B) you saw someone (or people) do"
^YTT(601.712,155,1,19,0)=" something or fail to do something that went against your moral code or values;"
^YTT(601.712,155,1,20,0)=" or (C) you were directly affected by someone doing something or failing to do"
^YTT(601.712,155,1,21,0)=" something that went against your moral code or values (e.g., being betrayed by"
^YTT(601.712,155,1,22,0)=" someone you trusted)."","
