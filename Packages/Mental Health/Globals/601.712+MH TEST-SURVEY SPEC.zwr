^YTT(601.712,17,1,857,0)="    ""text"": ""116. I have had to be really rough with some people to keep them in line."", "
^YTT(601.712,17,1,858,0)="    "
^YTT(601.712,17,1,859,0)="    ""choices"":["
^YTT(601.712,17,1,860,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
