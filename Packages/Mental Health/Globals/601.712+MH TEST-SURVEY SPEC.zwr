^YTT(601.712,115,1,1394,0)="    ""text"": ""191. Too many rules get in the way of doing what I want."", "
^YTT(601.712,115,1,1395,0)="    ""columns"": 1, "
^YTT(601.712,115,1,1396,0)="    ""choices"":["
^YTT(601.712,115,1,1397,0)="     {""id"": ""c3919"", ""text"": ""1. True"", ""quickKey"": 1}, "
