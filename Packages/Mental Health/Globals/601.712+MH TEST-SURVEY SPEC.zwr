^YTT(601.712,157,1,1,0)="{""name"": ""HIT-6"","
^YTT(601.712,157,1,2,0)=" ""copyright"": ""2001 QualityMetric, Inc. and GlaxoSmithKline Group of Companies. All rights"
^YTT(601.712,157,1,3,0)=" reserved."","
^YTT(601.712,157,1,4,0)=" ""restartDays"": 2,"
^YTT(601.712,157,1,5,0)=" ""printTitle"": ""Headache  Impact Test"","
^YTT(601.712,157,1,6,0)=" ""content"":["
^YTT(601.712,157,1,7,0)="   {""id"": ""i2490"", ""type"": ""IntroText"","
^YTT(601.712,157,1,8,0)="    ""text"": ""HIT is a tool used to measure the impact headaches have on your ability to"
^YTT(601.712,157,1,9,0)=" function on the job, at school, at home  and in social situations. Your score"
^YTT(601.712,157,1,10,0)=" shows you the effect that headaches have on normal daily life and your ability"
^YTT(601.712,157,1,11,0)=" to function. HIT was developed by an international team of headache experts from"
^YTT(601.712,157,1,12,0)=" neurology and primary care medicine in collaboration with the psychometricians"
^YTT(601.712,157,1,13,0)=" who developed the SF-36 health assessment tool. This questionnaire was designed"
^YTT(601.712,157,1,14,0)=" to help you describe and communicate the way you feel and what you cannot do"
^YTT(601.712,157,1,15,0)=" because of headaches. <br /><br /><i>To complete, please select one answer for each"
^YTT(601.712,157,1,16,0)=" question.</i>"""
^YTT(601.712,157,1,17,0)="    },"
