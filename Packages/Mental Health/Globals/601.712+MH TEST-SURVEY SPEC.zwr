^YTT(601.712,71,1,179,0)="   {""id"": ""s1309"", ""type"": ""IntroText"", "
^YTT(601.712,71,1,180,0)="    ""text"": ""HOUSING"""
^YTT(601.712,71,1,181,0)="    }, "
^YTT(601.712,71,1,182,0)="   {""id"": ""q5978"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,71,1,183,0)="    ""text"": ""8A. Choose the following sentence that best describes your current goal about"
^YTT(601.712,71,1,184,0)=" your housing:"", "
^YTT(601.712,71,1,185,0)="    ""intro"": ""Below is a list of statements that describe how people sometimes feel about"
^YTT(601.712,71,1,186,0)=" themselves and their lives. Please read each one carefully and indicate the"
^YTT(601.712,71,1,187,0)=" response that best describes the extent to   which you agree or disagree with"
^YTT(601.712,71,1,188,0)=" the statement.  "", "
^YTT(601.712,71,1,189,0)="    ""columns"": 1, "
^YTT(601.712,71,1,190,0)="    ""choices"":["
^YTT(601.712,71,1,191,0)="     {""id"": ""c3037"", ""text"": ""1. I want to live in a hospital or other place where staff are there all the time"
^YTT(601.712,71,1,192,0)=" and I rarely leave."", ""quickKey"": 1}, "
^YTT(601.712,71,1,193,0)="     {""id"": ""c3038"", ""text"": ""2. I want to live in a place (group home, or room or apartment or house) in the"
^YTT(601.712,71,1,194,0)=" community that provides meals and staff to help me with my activities."", ""quickKey"": 2}, "
^YTT(601.712,71,1,195,0)="     {""id"": ""c3039"", ""text"": ""3. I want to live by myself or with other people getting mental health care,"
^YTT(601.712,71,1,196,0)=" where I am responsible for taking care of my needs with occasional home visits"
^YTT(601.712,71,1,197,0)=" from a mental health provider."", ""quickKey"": 3}, "
^YTT(601.712,71,1,198,0)="     {""id"": ""c3153"", ""text"": ""4. I want to live by myself or with people I choose and only see mental health"
^YTT(601.712,71,1,199,0)=" staff when I choose."", ""quickKey"": 4}"
^YTT(601.712,71,1,200,0)="   ]}, "
^YTT(601.712,71,1,201,0)="   {""id"": ""q5979"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,71,1,202,0)="    ""text"": ""8B. Choose the following sentence that best describes your current situation:"", "
^YTT(601.712,71,1,203,0)="    ""intro"": ""Below is a list of statements that describe how people sometimes feel about"
^YTT(601.712,71,1,204,0)=" themselves and their lives. Please read each one carefully and indicate the"
