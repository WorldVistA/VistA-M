^YTT(601.712,184,1,1,0)="{""name"": ""MIOS+B-IPF_V2"", "
^YTT(601.712,184,1,2,0)=" ""restartDays"": 2, "
^YTT(601.712,184,1,3,0)=" ""printTitle"": ""Moral Injury Outcome Scale and Brief Inventory of Psychological Functioning"
^YTT(601.712,184,1,4,0)=" (MIOS+B-IPF_V2)"", "
^YTT(601.712,184,1,5,0)=" ""content"":["
^YTT(601.712,184,1,6,0)="   {""id"": ""i2558"", ""type"": ""IntroText"", "
^YTT(601.712,184,1,7,0)="    ""text"": ""<br />"""
^YTT(601.712,184,1,8,0)="    }, "
^YTT(601.712,184,1,9,0)="   {""id"": ""q9283"", ""type"": ""CheckQuestion"", ""required"": true, ""inline"": false, "
^YTT(601.712,184,1,10,0)="    ""text"": ""1. This questionnaire asks about experiences you may have had after a very"
^YTT(601.712,184,1,11,0)=" stressful experience.  Please indicate whether you had at least one experience"
^YTT(601.712,184,1,12,0)=" as described below that is currently distressing (select all that apply).<br"
^YTT(601.712,184,1,13,0)=" /><br />Select one or more:"", "
^YTT(601.712,184,1,14,0)="    ""intro"": ""<br />"", "
^YTT(601.712,184,1,15,0)="    ""columns"": 1, "
^YTT(601.712,184,1,16,0)="    ""choices"":["
^YTT(601.712,184,1,17,0)="     {""id"": ""c5822"", ""text"": ""1. I did something (or failed to do something) that went against my moral code or"
^YTT(601.712,184,1,18,0)=" values."", ""quickKey"": 1}, "
^YTT(601.712,184,1,19,0)="     {""id"": ""c5823"", ""text"": ""2. I saw something (or people) do something or fail to do something that went"
^YTT(601.712,184,1,20,0)=" against my moral code or values."", ""quickKey"": 2}, "
^YTT(601.712,184,1,21,0)="     {""id"": ""c5824"", ""text"": ""3. I was directly affected by someone doing something or failing to do something"
^YTT(601.712,184,1,22,0)=" that went against my moral code or values."", ""quickKey"": 3}, "
^YTT(601.712,184,1,23,0)="     {""id"": ""c5825"", ""text"": ""4. None of these apply. (If so, for the remaining items, please think about"
^YTT(601.712,184,1,24,0)=" another type of very stressful event that is currently distressing and answer"
^YTT(601.712,184,1,25,0)=" questions while keeping in mind the worst and most currently distressing event.)"", ""quickKey"": 4}"
^YTT(601.712,184,1,26,0)="   ]}, "
^YTT(601.712,184,1,27,0)="   {""id"": ""i2559"", ""type"": ""IntroText"", "
^YTT(601.712,184,1,28,0)="    ""text"": ""Keeping this (or these) experience(s) in mind, please indicate how much you agree"
^YTT(601.712,184,1,29,0)=" with the following statements in terms of the impact of this experience (or"
^YTT(601.712,184,1,30,0)=" experiences) in the last month."""
^YTT(601.712,184,1,31,0)="    }, "
^YTT(601.712,184,1,32,0)="   {""id"": ""q9284"", ""type"": ""ChoiceQuestion"", ""required"": true, ""inline"": false, "
