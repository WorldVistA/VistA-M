^YTT(601.712,16,1,405,0)="   ]}, "
^YTT(601.712,16,1,406,0)="   {""id"": ""q1095"", ""type"": ""ChoiceQuestion"", ""required"": false, ""inline"": false, "
^YTT(601.712,16,1,407,0)="    ""text"": ""50. I like to arrange things down to the last detail."", "
