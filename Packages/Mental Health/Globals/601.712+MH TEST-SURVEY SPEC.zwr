^YTT(601.712,17,1,899,0)="   ]}, "
^YTT(601.712,17,1,900,0)="   {""id"": ""q1507"", ""type"": ""ChoiceQuestion"", ""required"": false, "
^YTT(601.712,17,1,901,0)="    ""text"": ""122. I seem to make a mess of good opportunities that come my way."", "
^YTT(601.712,17,1,902,0)="    "
^YTT(601.712,17,1,903,0)="    ""choices"":["
^YTT(601.712,17,1,904,0)="     {""id"": ""c688"", ""text"": ""1. True"", ""quickKey"": 1}, "
