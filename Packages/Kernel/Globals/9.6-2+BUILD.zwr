^XPD(9.6,14126,1,1,0)="This patch addresses the following issues:"
^XPD(9.6,14126,1,2,0)=" "
^XPD(9.6,14126,1,3,0)="1.INC29145882 -VISTAOR-37982 -Clinic infusion medication are displayed in "
^XPD(9.6,14126,1,4,0)="the ""Infusions"" package as "
^XPD(9.6,14126,1,5,0)="opposed to ""Clinic Infusions"" in CPRS."
^XPD(9.6,14126,1,6,0)=" "
^XPD(9.6,14126,1,7,0)="2.INC26174672 - VISTAOR-33937 - Multiple VIS Sheets Not Showing."
^XPD(9.6,14126,1,8,0)=" "
^XPD(9.6,14126,1,9,0)="3.INC28822263 -VISTAOR-35454 -Mumps error <COMMAND>OUT+5^ORMPS1"
^XPD(9.6,14126,1,10,0)=" "
^XPD(9.6,14126,1,11,0)="4.INC31681077- VISTAOR-37164 - HITPS-11291- R3 - (CMS)Bug in Medication "
^XPD(9.6,14126,1,12,0)="Package - Vista/CPRS "
^XPD(9.6,14126,1,13,0)="        Duplicate(s): INC32306932, INC32507532, INC33118775, INC33589172, "
