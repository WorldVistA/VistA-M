^XPD(9.6,13628,0)="SD*5.3*871^48^0^3240221^y"
^XPD(9.6,13628,1,0)="^^141^141^3240215^"
^XPD(9.6,13628,1,1,0)="VSE Increment 8.20 - SD_5_3_871 - GUI v 1.7.54"
^XPD(9.6,13628,1,2,0)="=============================================="
^XPD(9.6,13628,1,3,0)=" "
^XPD(9.6,13628,1,4,0)="VSE-5278: JS - Update the code to add ENDDATE to the list of variables to "
^XPD(9.6,13628,1,5,0)="          save."
^XPD(9.6,13628,1,6,0)="VSE-6278: LB - VistA: Modify the appointment object to return a flag if "
^XPD(9.6,13628,1,7,0)="          the appointment was created from an MRTC request, add the"
^XPD(9.6,13628,1,8,0)="          patient Ward, and do not return a subscript error when variable"
^XPD(9.6,13628,1,9,0)="          DFN is used."
^XPD(9.6,13628,1,10,0)="VSE-6490: BB - SDES2 Priority 16: Rewrite SDES UNDO NOSHOW in the SDES2 "
^XPD(9.6,13628,1,11,0)="          namespace."
^XPD(9.6,13628,1,12,0)="VSE-6491: BB - SDES2 Priority 17: Rewrite SDES NOSHOW in the SDES2 "
^XPD(9.6,13628,1,13,0)="          namespace."
^XPD(9.6,13628,1,14,0)="VSE-6497: TB - SDES2 Priority 22: Rewrite SDES BLOCK AND MOVE in the "
^XPD(9.6,13628,1,15,0)="          SDES2 namespace."
^XPD(9.6,13628,1,16,0)="VSE-6499: AP - SDES2 Priority 24: Rewrite SDES SPACEBAR VVS PRO in the "
^XPD(9.6,13628,1,17,0)="          SDES2 namespace."
^XPD(9.6,13628,1,18,0)="VSE-6500: AP - SDES2 Priority 25: Rewrite SDES GETVVSMAKEINFO JSON in the "
^XPD(9.6,13628,1,19,0)="          SDES2 namespace."
^XPD(9.6,13628,1,20,0)="VSE-6824: TB - SDES2 Priority 28: Rewrite SDES GET RECALL BY IEN in the "
^XPD(9.6,13628,1,21,0)="          SDES2 namespace to address sensitive patient records."
^XPD(9.6,13628,1,22,0)="VSE-6883: JS - VistA: Correct incorrect filing of the MRTC CALC PREF DATE "
^XPD(9.6,13628,1,23,0)="          onto the child request."
^XPD(9.6,13628,1,24,0)="VSE-7008: MB - VistA: Modify function $$GET44RECORDIENS^SDESCANCELAPPTS "
^XPD(9.6,13628,1,25,0)="          to filter past cancelled appointments."
^XPD(9.6,13628,1,26,0)="VSE-7011: BF - VistA: Discovery: The SDAM background job is creating "
^XPD(9.6,13628,1,27,0)="          appointments the next day."
^XPD(9.6,13628,1,28,0)="VSE-7014: LB - VistA: Rewrite SDEC SCHUSR RPC in the SDES2 namespace"
^XPD(9.6,13628,1,29,0)="VSE-7025: BB - VistA: Update the appropriate RPCs to incorporate new"
^XPD(9.6,13628,1,30,0)="          fields to support PBSP."
^XPD(9.6,13628,1,31,0)="VSE-7076: JJ - VistA: SDES CANCEL CLINIC AVAILABILITY results in creating "
^XPD(9.6,13628,1,32,0)="          erroneous availability."
^XPD(9.6,13628,1,33,0)="VSE-7100: BF - VistA: Update the appropriate RPCs to incorporate new"
^XPD(9.6,13628,1,34,0)="          fields to support PBSP."
^XPD(9.6,13628,1,35,0)="VSE-7101: LB - VistA: Update the appropriate RPCs to incorporate new "
^XPD(9.6,13628,1,36,0)="          fields to support PBSP."
^XPD(9.6,13628,1,37,0)="VSE-7102: VistA: Update the appropriate RPCs to incorporate new fields to "
^XPD(9.6,13628,1,38,0)="          support PBSP."
^XPD(9.6,13628,1,39,0)="VSE-7161: LB - VistA: Modify SDES2 CREATE PROVIDER RESOURCE so that the "
^XPD(9.6,13628,1,40,0)="          clinic IEN is no longer required"
^XPD(9.6,13628,1,41,0)="VSE-7218: LB - VistA: Fixes an issue with SDES2 GET RESOURCE IEN "
^XPD(9.6,13628,1,42,0)="          returning an empty ""ResourceIEN"" field  instead of the correct"
^XPD(9.6,13628,1,43,0)="          field, ""Resource"""
^XPD(9.6,13628,1,44,0)="VSE-7245: LB - VistA: Change input parameter ""SDIEN"" to ""APPPOINTMENT IEN"""
^XPD(9.6,13628,1,45,0)="          in SDES2 SET APPT CHECKIN and correct logic to accept status"
^XPD(9.6,13628,1,46,0)="          name"
^XPD(9.6,13628,1,47,0)="VSE-7310: TB - VistA: Fix issue with Undefined variable CLINICIEN in "
^XPD(9.6,13628,1,48,0)="          SDES2APPTUTIL."
^XPD(9.6,13628,1,49,0)="VSE-7326: BB - VistA: Correct the tag for the SDES2 GET PATIENT CLIN "
^XPD(9.6,13628,1,50,0)="          STATUS RPC."
^XPD(9.6,13628,1,51,0)="VSE-7344: JS - VistA: Modify SDES2 Cancel Appointment to utilize the "
^XPD(9.6,13628,1,52,0)="          ""Acheron Audit ID"" instead of ""EAS"""
^XPD(9.6,13628,1,53,0)="VSE-7345: JS - VistA: Modify SDES2 CREATE WALKIN APPT to utilize the "
^XPD(9.6,13628,1,54,0)="          ""Acheron Audit ID"" and verify all INPUT parameters exist"
^XPD(9.6,13628,1,55,0)="VSE-7346: BB - VistA: Correct SDES2 CREATE VET REQ AND APPT definition to "
^XPD(9.6,13628,1,56,0)="          remove the EAS input parameter"
^XPD(9.6,13628,1,57,0)=" "
