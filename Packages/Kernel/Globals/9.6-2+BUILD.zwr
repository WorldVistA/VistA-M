^XPD(9.6,13919,0)="PSO*7.0*776^60^0^3241202^y"
^XPD(9.6,13919,1,0)="^^215^215^3241125^"
^XPD(9.6,13919,1,1,0)="This patch distributes the Remote Procedure Call (RPC), routine, and"
^XPD(9.6,13919,1,2,0)="component updates that facilitate temporary and mailing address changes"
^XPD(9.6,13919,1,3,0)="to the PATIENT FILE (#2). These components support the VA Health Connect"
^XPD(9.6,13919,1,4,0)="Customer Relations Management (VAHC CRM) pharmacy project."
^XPD(9.6,13919,1,5,0)=" "
^XPD(9.6,13919,1,6,0)="The RPC's provide functionality to retrieve and update the temporary and "
^XPD(9.6,13919,1,7,0)="mailing addresses. The RPC's also provide the functionality to delete the"
^XPD(9.6,13919,1,8,0)="temporary address and update the TEMPORARY ADDRESS ACTIVE? (FILE "
^XPD(9.6,13919,1,9,0)="#2,.12105)"
^XPD(9.6,13919,1,10,0)="flag."
^XPD(9.6,13919,1,11,0)="The patch also removes the now defunct RPC's PSO GET TEMPORARY ADDRESS and"
^XPD(9.6,13919,1,12,0)="PSO TEMP ADDRESS UPDATE which have been superseded by PSO GET ADDRESS and"
^XPD(9.6,13919,1,13,0)="PSO ADDRESS UPDATE respectively."
^XPD(9.6,13919,1,14,0)=" "
^XPD(9.6,13919,1,15,0)=" "
^XPD(9.6,13919,1,16,0)="Patch Components:"
^XPD(9.6,13919,1,17,0)="-----------------"
^XPD(9.6,13919,1,18,0)=" "
^XPD(9.6,13919,1,19,0)=" "
^XPD(9.6,13919,1,20,0)="Files & Fields Associated:"
^XPD(9.6,13919,1,21,0)=" "
^XPD(9.6,13919,1,22,0)="File Name (Number)          Field Name (Number)       New/Modified/Deleted"
^XPD(9.6,13919,1,23,0)="------------------          -------------------       --------------------"
