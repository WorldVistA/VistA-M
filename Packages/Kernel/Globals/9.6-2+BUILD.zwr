^XPD(9.6,14022,1,4,0)="ORDER REQUIRES ELEC SIGNATURE"
^XPD(9.6,14022,1,5,0)="notification sent by Audio RENEWAL goes to original provider"
^XPD(9.6,14022,1,6,0)=" "
^XPD(9.6,14022,1,7,0)="2. INC17990929 - CPRS Provider NPI Display Issue"
^XPD(9.6,14022,1,8,0)=" "
^XPD(9.6,14022,1,9,0)="3. INC30979000 - ORB3 RECIP NOTIFICATIONS"
