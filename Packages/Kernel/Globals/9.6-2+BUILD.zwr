^XPD(9.6,14188,1,4,0)="Tickets:"
^XPD(9.6,14188,1,5,0)="========"
^XPD(9.6,14188,1,6,0)="VSE-11339: TB - VistA: Modify APPOINTMENTTYPE file to inactivate WORLD "
^XPD(9.6,14188,1,7,0)="           WAR II."
^XPD(9.6,14188,1,8,0)="VSE-11345: MB - VistA: SDES2 GET MISSION ACT AVAIL is returning back the "
^XPD(9.6,14188,1,9,0)="           system time offset for each return."
^XPD(9.6,14188,1,10,0)="VSE-11433: GW - VistA: Modify SDES2 PATIENT SEARCH to check for merged "
^XPD(9.6,14188,1,11,0)="           record."
^XPD(9.6,14188,1,12,0)="VSE-11440: RN - VistA: Modify SDES2 GET CLINIC BY STOP CODE to not "
^XPD(9.6,14188,1,13,0)="           require primary stop code but make it optional."
^XPD(9.6,14188,1,14,0)="VSE-11448: RN - VistA: Create a post install to generate a report with "
^XPD(9.6,14188,1,15,0)="           Clinic Name, Clinic IEN and Default Appointment Type details "
^XPD(9.6,14188,1,16,0)="           that have appointment type WORLD WAR II assigned as a default."
^XPD(9.6,14188,1,17,0)="VSE-11449: TB - VistA: Update create clinic and edit clinic to validate "
^XPD(9.6,14188,1,18,0)="           the appointment type."
^XPD(9.6,14188,1,19,0)="VSE-11531: RN - VistA: Modify SDES GET APPT BY APPT IEN to call "
^XPD(9.6,14188,1,20,0)="           SDES2 version of the get of the appointment object"
^XPD(9.6,14188,1,21,0)="VSE-11536: TB - VistA: Modify SDES2 CREATE APPOINTMENT to correctly "
^XPD(9.6,14188,1,22,0)="           handle errors"
