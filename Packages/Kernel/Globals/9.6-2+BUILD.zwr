^XPD(9.6,14079,0)="PRC*5.1*244^52^0^3250808^y"
^XPD(9.6,14079,1,0)="^^6^6^3250808^"
^XPD(9.6,14079,1,1,0)="This patch adds the ability to define and store the ABC Classification "
^XPD(9.6,14079,1,2,0)="code for inventory items. A new field, ABC INVENTORY CLASSIFICATION "
^XPD(9.6,14079,1,3,0)="(#.45) in the INVENTORY ITEM (#445.01) subfile of the GENERIC INVENTORY "
^XPD(9.6,14079,1,4,0)="(#445) file, has been added to store the ABC Classification, and the "
^XPD(9.6,14079,1,5,0)="PRCPEILM, PRCPEITE, and PRCPEIL1 routines have been updated to access and "
^XPD(9.6,14079,1,6,0)="store to this variable when editing Inventory Items."
^XPD(9.6,14079,4,0)="^9.64PA^445^1"
^XPD(9.6,14079,4,445,0)=445
