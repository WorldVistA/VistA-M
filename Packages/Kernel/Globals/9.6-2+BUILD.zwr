^XPD(9.6,13600,0)="SD*5.3*866^48^0^3240110^y"
^XPD(9.6,13600,1,0)="^^88^88^3240110^"
^XPD(9.6,13600,1,1,0)="VSE Increment 8.15 - SD*5*3*866 - GUI v 1.7.52"
^XPD(9.6,13600,1,2,0)="=============================================="
^XPD(9.6,13600,1,3,0)=" "
^XPD(9.6,13600,1,4,0)="VSE-6406: BB - Clinic Special Instructions are alphabetized, rather than "
^XPD(9.6,13600,1,5,0)="          being saved sequentially"
^XPD(9.6,13600,1,6,0)="VSE-6456: BB - VistA: Modify SDES BLOCK AND MOVE to send output as "
^XPD(9.6,13600,1,7,0)="          properly formatted JSON"
^XPD(9.6,13600,1,8,0)="VSE-6457: BB - VistA: Modify SDES SEARCH CLINIC ATTRIBUTES to have an "
^XPD(9.6,13600,1,9,0)="          optional input parameter"
^XPD(9.6,13600,1,10,0)="VSE-6470: TB - VistA: Rewrite SDES CREATE RECALL REQ 2 in the SDES2 "
^XPD(9.6,13600,1,11,0)="          namespace"
^XPD(9.6,13600,1,12,0)="VSE-6474: TB - VistA: Rewrite SDES EDIT RECALL REQ 2 in the SDES2 "
^XPD(9.6,13600,1,13,0)="          namespace"
^XPD(9.6,13600,1,14,0)="VSE-6475: AP - VistA: Rewrite SDES DISPOSITION APPT REQ in the SDES2 "
^XPD(9.6,13600,1,15,0)="          namespace"
^XPD(9.6,13600,1,16,0)="VSE-6479: BF - Vista: Rewrite SDES DISPOSITION RECALL REQ in the SDES"
^XPD(9.6,13600,1,17,0)="          namespace"
^XPD(9.6,13600,1,18,0)="VSE-6484: BB - SDES2 Priority 10: Rewrite SDES CREATE APPOINTMENTS in the"
^XPD(9.6,13600,1,19,0)="          SDES2 namespace"
^XPD(9.6,13600,1,20,0)="VSE-6485: TB - VistA: Rewrite SDES CHECKIN in the SDES2 namespace"
^XPD(9.6,13600,1,21,0)="VSE-6552: BB - VistA: Modify SDES READ CLINIC GROUP to return CLINIC IEN "
^XPD(9.6,13600,1,22,0)="          or PROVIDER IEN based on the RESOURCE TYPE"
^XPD(9.6,13600,1,23,0)="VSE-6589: BB - VistA: Create SDES2 RPC for Patient Information"
^XPD(9.6,13600,1,24,0)="VSE-6591: LB - VistA: Modify SDES CREATE WALKIN APPT to call new check in "
^XPD(9.6,13600,1,25,0)="          routine"
^XPD(9.6,13600,1,26,0)="VSE-6593: LB - VistA: New SDES2 RPC return back - has the given clinic "
^XPD(9.6,13600,1,27,0)="          ever had any availability defined?"
^XPD(9.6,13600,1,28,0)="VSE-6606: MD - VistA: Update SDES2 EDIT CLINIC to allow for the editing "
^XPD(9.6,13600,1,29,0)="          of the holiday field"
^XPD(9.6,13600,1,30,0)="VSE-6673: LB - VistA: Modify SDES2 GET LAST SELECTED PAT to use SDCONTEXT "
^XPD(9.6,13600,1,31,0)="          USER DUZ"
^XPD(9.6,13600,1,32,0)="VSE-6906: MD - VistA: Create a new SDES2 RPC to return all future canceled"
^XPD(9.6,13600,1,33,0)="          slots given a clinic ID."
^XPD(9.6,13600,1,34,0)="VSE-7001: BF - VistA: Update SDES2 EDIT CLINIC to allow removal of default"
^XPD(9.6,13600,1,35,0)="          designation from both provider and diagnosis."
^XPD(9.6,13600,1,36,0)="VSE-7021: VistA: Correct issue with neurology service not saving on "
^XPD(9.6,13600,1,37,0)="          creation or edit."
^XPD(9.6,13600,1,38,0)=" "
