^XPD(9.6,13470,1,10,0)="VSE-5564: BB - VistA: Rewrite SDES CREATE APPT BLK AND MOVE to accept a "
^XPD(9.6,13470,1,11,0)="               clinic IEN"
^XPD(9.6,13470,1,12,0)="VSE-5566: JS - VistA: Create a new SDES2 RPC to get the medication list"
^XPD(9.6,13470,1,13,0)="VSE-5576: BF - VistA: Create RPC to return all open appt requests, "
^XPD(9.6,13470,1,14,0)="               consults, and recall reminders for a given institution"
^XPD(9.6,13470,1,15,0)="VSE-5620: LB - VistA: Create new versions of SDES CONTACT ADD/UPDATE and "
^XPD(9.6,13470,1,16,0)="               SDES CONTACT DISPLAY RPCs to include a context/metadata"
^XPD(9.6,13470,1,17,0)="               array as the first input parameter"
^XPD(9.6,13470,1,18,0)="VSE-5701: TB - VSE Error when scheduling walk in appts between 12a-1am"
^XPD(9.6,13470,1,19,0)="VSE-5742: BF - VistA: Create a new SDES2 GET HOLIDAYS to allow for an "
^XPD(9.6,13470,1,20,0)="               optional end date"
^XPD(9.6,13470,1,21,0)="VSE-5819: AP - VistA: Create a new RPC to return patient registration "
^XPD(9.6,13470,1,22,0)="               data for the ids passed in"
^XPD(9.6,13470,1,23,0)="VSE-5873: AP - VistA: Modify SDESCHECKOUT routine to lock/unlock record "
^XPD(9.6,13470,1,24,0)="               in SDE file"
^XPD(9.6,13470,1,25,0)="VSE-5889: DS - VistA: Modify SDES GET PATIENT REGISTRATION2 to return the "
^XPD(9.6,13470,1,26,0)="               Date of Death"
