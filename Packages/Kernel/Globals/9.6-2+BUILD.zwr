^XPD(9.6,13681,"REQB",0)="^9.611^^"
^XPD(9.6,13682,0)="PSJ*5.0*451^77^0^3240227^y"
^XPD(9.6,13682,1,0)="^^69^69^3240227^"
^XPD(9.6,13682,1,1,0)=" "
^XPD(9.6,13682,1,2,0)="This patch addresses the following two incident tickets:"
^XPD(9.6,13682,1,3,0)=" "
^XPD(9.6,13682,1,4,0)="1. INC30646734 - VISTA PSJ UNDEFINED ERROR AFTER COPYING UD ORDER WITH "
^XPD(9.6,13682,1,5,0)="REMOVAL REQUIRED."
^XPD(9.6,13682,1,6,0)=" "
^XPD(9.6,13682,1,7,0)="2. INC31233823 - VISTA PSJ UNDEFINED ERROR AFTER EDITING START TIME "
^XPD(9.6,13682,1,8,0)="BEFORE ACCEPTING UD ORDER REQUIRING REMOVAL."
^XPD(9.6,13682,1,9,0)=" "
^XPD(9.6,13682,1,10,0)=" "
^XPD(9.6,13682,1,11,0)="Problem(s):"
^XPD(9.6,13682,1,12,0)="-----------"
^XPD(9.6,13682,1,13,0)="1. INC30646734 - Albany VA Medical Center (NY) reported an undefined "
^XPD(9.6,13682,1,14,0)="error that occurs in VistA backdoor pharmacy (inpatient order entry), "
^XPD(9.6,13682,1,15,0)="when you copy an active unit dose order, that has a transdermal patch "
^XPD(9.6,13682,1,16,0)="orderable item field ""Prompt for removal in BCMA"",  set to ""Removal "
^XPD(9.6,13682,1,17,0)="Period Required Prior to Next Administration"", edit the start date/time, "
^XPD(9.6,13682,1,18,0)="and then choose to edit the admin time,  say NO to the prompt ""Is this "
^XPD(9.6,13682,1,19,0)="correct"", then enter in a new ADMIN time. The system hard errors and "
^XPD(9.6,13682,1,20,0)="kicks you out of Vista. Hard error is <UNDEFINED>DONE+3^PSGOE91 "
^XPD(9.6,13682,1,21,0)="*PSGOEEF(41)."
^XPD(9.6,13682,1,22,0)=" "
^XPD(9.6,13682,1,23,0)="2. INC31233823 - Albany VA Medical Center (NY) reported an undefined "
^XPD(9.6,13682,1,24,0)="error that occurs in VistA backdoor pharmacy (inpatient order entry) when "
^XPD(9.6,13682,1,25,0)="editing the start date before accepting an active unit dose order "
^XPD(9.6,13682,1,26,0)="(without a copy). Hard error is <UNDEFINED>DONE+3^PSGOE81 *PSGOEEF(39)."
^XPD(9.6,13682,1,27,0)=" "
^XPD(9.6,13682,1,28,0)=" "
^XPD(9.6,13682,1,29,0)="Resolution:"
^XPD(9.6,13682,1,30,0)="-----------"
^XPD(9.6,13682,1,31,0)="1. INC30646734 - Adding a check for data in the PSGOE91 routine DONE tag "
^XPD(9.6,13682,1,32,0)="for the PSGOEEF(PSGF2) variable.  In some cases, there is no data and the "
^XPD(9.6,13682,1,33,0)="variable is not defined therefore causing a hard error and kicking the "
^XPD(9.6,13682,1,34,0)="user out.  Adding the check will allow the logic to continue to process "
^XPD(9.6,13682,1,35,0)="the UD order without a hard error.  Also adding a change to the PSGOE91 "
^XPD(9.6,13682,1,36,0)="routine A10 tag, so the date/time will display appropriately. Currently "
^XPD(9.6,13682,1,37,0)="it shows the correct date and then an up caret with the internal date."
^XPD(9.6,13682,1,38,0)=" "
^XPD(9.6,13682,1,39,0)="2. INC31233823 - Adding a check for data in the PSGOE81 routine for the "
^XPD(9.6,13682,1,40,0)="PSGOEEF(PSGF2) variable.  In some cases, there is no data and the "
^XPD(9.6,13682,1,41,0)="variable is not defined therefore causing a hard error and kicking the "
^XPD(9.6,13682,1,42,0)="user out.  Adding the check will allow the logic to continue to process "
^XPD(9.6,13682,1,43,0)="the UD order without a hard error."
^XPD(9.6,13682,1,44,0)=" "
^XPD(9.6,13682,1,45,0)=" "
^XPD(9.6,13682,1,46,0)="Technical Resolution:"
^XPD(9.6,13682,1,47,0)="---------------------"
^XPD(9.6,13682,1,48,0)="1. INC30646734 - Routine PSGOE91 is modified at line to check for data in "
^XPD(9.6,13682,1,49,0)="the variable causing the undefined error, and correcting the format of "
^XPD(9.6,13682,1,50,0)="the date."
^XPD(9.6,13682,1,51,0)=" "
^XPD(9.6,13682,1,52,0)="Line DONE+3"
^XPD(9.6,13682,1,53,0)="   I PSGOEE G:'PSGOEEF(PSGF2) @BACK S PSGOEE=PSGOEEF(PSGF2)"
^XPD(9.6,13682,1,54,0)="To"
^XPD(9.6,13682,1,55,0)="   I PSGOEE G:'$G(PSGOEEF(PSGF2)) @BACK S PSGOEE=PSGOEEF(PSGF2)"
^XPD(9.6,13682,1,56,0)=" "
^XPD(9.6,13682,1,57,0)="Line A10+6"
^XPD(9.6,13682,1,58,0)="   I X="""",PSGSD W ""  ""_PSGSDN G DONE"
^XPD(9.6,13682,1,59,0)="To"
^XPD(9.6,13682,1,60,0)="   I X="""",PSGSD W ""  ""_$P(PSGSDN,""^"") G DONE"
^XPD(9.6,13682,1,61,0)=" "
^XPD(9.6,13682,1,62,0)=" "
^XPD(9.6,13682,1,63,0)="2. INC31233823 - Routine PSGOE81 is modified to check for data in the "
^XPD(9.6,13682,1,64,0)="variable causing the undefined error."
^XPD(9.6,13682,1,65,0)=" "
^XPD(9.6,13682,1,66,0)="Line DONE+3"
^XPD(9.6,13682,1,67,0)="   I PSGOEE G:'PSGOEEF(PSGF2) @BACK S PSGOEE=PSGOEEF(PSGF2)"
^XPD(9.6,13682,1,68,0)="To"
^XPD(9.6,13682,1,69,0)="   I PSGOEE G:'$G(PSGOEEF(PSGF2)) @BACK S PSGOEE=PSGOEEF(PSGF2)"
^XPD(9.6,13682,4,0)="^9.64PA^^"
^XPD(9.6,13682,6)="^388"
^XPD(9.6,13682,6.3)=1
