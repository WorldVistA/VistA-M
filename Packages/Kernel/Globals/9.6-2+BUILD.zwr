^XPD(9.6,14019,1,146,0)="Defect Tracking System Ticket(s) & Overview: "
^XPD(9.6,14019,1,147,0)="============================================"
^XPD(9.6,14019,1,148,0)=" "
^XPD(9.6,14019,1,149,0)="1. Patient address and primary phone displayed on the Single eRx View screen"
^XPD(9.6,14019,1,150,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,14019,1,151,0)="   To easily confirm the patient's identity, the patient's address and"
^XPD(9.6,14019,1,152,0)="   phone number are included on both the eRx and VistA sides of the Single"
^XPD(9.6,14019,1,153,0)="   eRx View/Display landing page, as shown below (without the reverse or"
^XPD(9.6,14019,1,154,0)="   highlighted video features)."
^XPD(9.6,14019,1,155,0)="   "
^XPD(9.6,14019,1,156,0)="   Single eRx View/Display       Oct 25, 2024@10:49:03     Page:    1 of    3"
^XPD(9.6,14019,1,157,0)="   ---------------------------------------------------------------------------"
