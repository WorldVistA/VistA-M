^XPD(9.6,14135,0)="DVBA*2.7*255^93^0^3260114^y"
^XPD(9.6,14135,1,0)="^^278^278^3260113^"
^XPD(9.6,14135,1,1,0)="Patch DVBA*2.7*255 is introducing Batch Printing capabilities and "
^XPD(9.6,14135,1,2,0)="transitioning AMIE VistA Options and functions to the CAPRI GUI.  This "
^XPD(9.6,14135,1,3,0)="patch is also replacing the usage of Secure Blackbox within the CAPRI "
^XPD(9.6,14135,1,4,0)="codebase and updating that codebase to Delphi 12."
^XPD(9.6,14135,1,5,0)=" "
^XPD(9.6,14135,1,6,0)="In addition, the following items for support of Content Management Tool "
^XPD(9.6,14135,1,7,0)="(CMT) system functionality are being included:"
^XPD(9.6,14135,1,8,0)=" "
^XPD(9.6,14135,1,9,0)="1. Capability to support conditional logic for future CMT DBQ IEPD's"
^XPD(9.6,14135,1,10,0)="2. Autosave DBQ Data Entered into Free Text Field"
^XPD(9.6,14135,1,11,0)="3. Addition of Scroll Bar within DBQ PDF Text Field for Max View Limit"
^XPD(9.6,14135,1,12,0)="4. Updates for Conditional Logic for Autofill with Checkboxes"
^XPD(9.6,14135,1,13,0)="5. Set Target Field Text Edit Box to Read-Only for Copy Condition"
^XPD(9.6,14135,1,14,0)="6. Full Header IEPD Validation on DBQ Transmissions"
^XPD(9.6,14135,1,15,0)="7. ""Date of Examination"" field in a DBQ PDF no longer auto-populates with "
^XPD(9.6,14135,1,16,0)="   the current date when a DBQ is created"
^XPD(9.6,14135,1,17,0)=" "
^XPD(9.6,14135,1,18,0)=" "
^XPD(9.6,14135,1,19,0)="The following SNOW tickets are being addressed:"
^XPD(9.6,14135,1,20,0)=" "
^XPD(9.6,14135,1,21,0)="1. INC40155755: DBQs are showing as editable in VBMS eFolder"
^XPD(9.6,14135,1,22,0)="2. INC40032912, INC40054773, INC40070450, INC40076207, INC40293176: "
^XPD(9.6,14135,1,23,0)="   Partial EDIPI and/or single zero EDIPI value in DBQ XML Header causing"
^XPD(9.6,14135,1,24,0)="   DBQ transmission to fail reaching VBMS eFolder"
^XPD(9.6,14135,1,25,0)="3. INC40104480: Transmission List not Displaying during Failed "
^XPD(9.6,14135,1,26,0)="   Transmission"
^XPD(9.6,14135,1,27,0)="4. INC40220293: CAPRI Report-CNH Display Error"
^XPD(9.6,14135,1,28,0)="5. INC40098921, INC40246093, INC40205143: User unable to transmit DBQs, "
^XPD(9.6,14135,1,29,0)="   receives error ""RPC DVBA CAPRI SAVE EXAM PDF could not be accessed!"
^XPD(9.6,14135,1,30,0)="   Error encountered."""
^XPD(9.6,14135,1,31,0)="6. INC40205143: Cannot Submit DBQ"
^XPD(9.6,14135,1,32,0)="7. INC40433009: submitting a 7131 in East Orange Capri will not let me "
^XPD(9.6,14135,1,33,0)="   select routing location to submit"
^XPD(9.6,14135,1,34,0)=" "
^XPD(9.6,14135,1,35,0)=" "
^XPD(9.6,14135,1,36,0)=" "
^XPD(9.6,14135,1,37,0)=" "
^XPD(9.6,14135,1,38,0)="EHRM Impact Statement:"
^XPD(9.6,14135,1,39,0)="----------------------"
^XPD(9.6,14135,1,40,0)="This patch should have no EHRM impact, and can be installed at all sites, "
^XPD(9.6,14135,1,41,0)="including EHRM converted sites. "
^XPD(9.6,14135,1,42,0)=" "
