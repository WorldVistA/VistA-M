^XPD(9.6,13983,1,5,0)="VSE-9624: BB - VistA: Modify SDES GET CLINIC ORIGINAL AVAIL to correct "
^XPD(9.6,13983,1,6,0)="          calculations of original availability"
^XPD(9.6,13983,1,7,0)="VSE-9639: TB - VistA: Create a new SDES2 RPC to return back the time "
^XPD(9.6,13983,1,8,0)="          slots that have been cancelled for a clinic"
^XPD(9.6,13983,1,9,0)="VSE-9656: BB - VistA: SDES2 CLONE CLINIC SLOTS to return back the first "
^XPD(9.6,13983,1,10,0)="          future date for the day of the week."
