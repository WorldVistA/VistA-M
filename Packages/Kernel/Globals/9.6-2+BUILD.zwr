^XPD(9.6,13707,1,0)="^^62^62^3240522^"
^XPD(9.6,13707,1,1,0)="VSE Increment 9.4 - SD*5.3*878 - GUI v 1.7.56"
^XPD(9.6,13707,1,2,0)="============================================="
^XPD(9.6,13707,1,3,0)=" "
^XPD(9.6,13707,1,4,0)="Jira Tickets:"
^XPD(9.6,13707,1,5,0)="============="
^XPD(9.6,13707,1,6,0)=" "
^XPD(9.6,13707,1,7,0)="VSE-7631: MB - VistA: Modify SDES2 GET CONTACT ATTEMPT RPC to correct an "
^XPD(9.6,13707,1,8,0)="                issue with the error return "
^XPD(9.6,13707,1,9,0)="VSE-7648: AP - VistA: Modify SDES2 GET EXPANDED ENTRY 2 to return "
^XPD(9.6,13707,1,10,0)="                Yes/No/NA for IsClassificationActive"
^XPD(9.6,13707,1,11,0)="VSE-7666: BF - VistA: Modify SDESUTIL to recognize that there may be "
^XPD(9.6,13707,1,12,0)="                times when there are both active and inactive AMIS stop"
^XPD(9.6,13707,1,13,0)="                codes"
^XPD(9.6,13707,1,14,0)="VSE-7680: JS - VistA: Create 2 new routines in the SDES2 namespace"
^XPD(9.6,13707,1,15,0)="VSE-7692: BB - VistA: Modify SDEC07A routine to rewrite the logic around "
^XPD(9.6,13707,1,16,0)="                consults"
^XPD(9.6,13707,1,17,0)="VSE-7712: BF - VistA: Fix an issue with the query tool "
^XPD(9.6,13707,1,18,0)="VSE-7739: BF - VistA: Backup SD PURGE menu option and then remove it "
^XPD(9.6,13707,1,19,0)="                form the menu"
^XPD(9.6,13707,1,20,0)="VSE-7862: BF - VistA: Rewrite SDES GET APPT REQ BY TYPE VET into the SDES2"
^XPD(9.6,13707,1,21,0)="               namespace"
^XPD(9.6,13707,1,22,0)="VSE-7867: TB - VistA: Modify SDES2 ADD CONTACT ATTEMPT and SDES2 GET"
^XPD(9.6,13707,1,23,0)="               CONTACT ATTEMPTS so that date time entered is in system"
^XPD(9.6,13707,1,24,0)="               time"
^XPD(9.6,13707,1,25,0)="VSE-7869: LB - VistA: Modify SDES2 CANCEL APPOINTMENT RPC to correctly "
^XPD(9.6,13707,1,26,0)="               update recall request pointers"
^XPD(9.6,13707,1,27,0)="VSE-7876: MD - VistA: Update the Privileged User validation in routine "
^XPD(9.6,13707,1,28,0)="               SDES2VAL44A"
^XPD(9.6,13707,1,29,0)="VSE-7943: BF - VistA: Modify SDES2 GET DEMOGRAPHICS to only send active "
^XPD(9.6,13707,1,30,0)="               race and ethnicity values"
^XPD(9.6,13707,1,31,0)=" "
^XPD(9.6,13707,1,32,0)="Files:"
^XPD(9.6,13707,1,33,0)="======"
