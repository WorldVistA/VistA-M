^XPD(9.6,14012,1,1,0)="Fix PSS-3 Report"
^XPD(9.6,14012,1,2,0)=" - Fix line breaks in disclaimer"
^XPD(9.6,14012,1,3,0)="Fix PSS-3-2ND Report"
^XPD(9.6,14012,1,4,0)=" - Answer_7778 was capitalized, causing it to not translate in the report."
^XPD(9.6,14012,1,5,0)=" - Fix line breaks in disclaimer"
^XPD(9.6,14012,1,6,0)="Fix EPDS Report"
^XPD(9.6,14012,1,7,0)=" - Interpretive text ""mothers who score 10"" instead of 13."
^XPD(9.6,14012,1,8,0)="Fix PROMIS10"
^XPD(9.6,14012,1,9,0)=" - The last question was not being translated correctly into the pain "
^XPD(9.6,14012,1,10,0)="   scale."
^XPD(9.6,14012,1,11,0)="Fix IADL Interpretive text"
^XPD(9.6,14012,1,12,0)="Fix CCSA-DSM5"
^XPD(9.6,14012,1,13,0)=" - Add space in report after 11/suicidal ideation"
^XPD(9.6,14012,1,14,0)="Fix GAD-7"
^XPD(9.6,14012,1,15,0)=" - Interpretive text line breaks to match cloud format."
^XPD(9.6,14012,1,16,0)="Fix ZBI SHORT and ZBI SCREEN"
^XPD(9.6,14012,1,17,0)=" - Change Interpretive text from ""followup"" to ""follow up."""
^XPD(9.6,14012,1,18,0)="Fix SF36"
^XPD(9.6,14012,1,19,0)=" - Add missing scale Reported Health Transition to MH SCALES."
^XPD(9.6,14012,1,20,0)="Fix CES"
^XPD(9.6,14012,1,21,0)=" - Add missing note titles"
^XPD(9.6,14012,1,22,0)=" "
^XPD(9.6,14012,1,23,0)="Fix User preference Parameter to find exact IEN if two names are the same."
^XPD(9.6,14012,1,24,0)="Added keep-alive RPC in Patient Entry."
^XPD(9.6,14012,1,25,0)=" "
^XPD(9.6,14012,1,26,0)="Update the data dictionary for MH ADMINISTRATIONS to add the boolean "
^XPD(9.6,14012,1,27,0)="field, PROGRESS NOTE GENERATED. 1=Yes, 0/null=No."
^XPD(9.6,14012,1,28,0)="Update the RPC GET /api/mha/instrument/list/:dfn to return this property."
^XPD(9.6,14012,1,29,0)="Fix legacy instrument scoring to save MH RESULTS."
^XPD(9.6,14012,1,30,0)="Update the RPC POST /api/mha/cdb/instrument/admin to handle tscores."
^XPD(9.6,14012,1,31,0)="Update the RPC for user assignment preferences to quit with no action if "
^XPD(9.6,14012,1,32,0)="error in incoming data detected."
^XPD(9.6,14012,1,33,0)="Update user timeout RPC to return correct user level timeout."
^XPD(9.6,14012,1,34,0)="Update the scoring routine to handle non-unique scale sequence "
^XPD(9.6,14012,1,35,0)="identifiers."
^XPD(9.6,14012,1,36,0)=" "
^XPD(9.6,14012,1,37,0)="Create MENTAL HEALTH ASSISTANT Remote Application entry."
