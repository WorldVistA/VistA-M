^XPD(9.6,13521,1,0)="^^9^9^3230628^"
^XPD(9.6,13521,1,1,0)="The patch addresses one (1) issue: "
^XPD(9.6,13521,1,2,0)=" "
^XPD(9.6,13521,1,3,0)="Under certain circumstances, the CULTURES title/data does not display on "
^XPD(9.6,13521,1,4,0)="the Nurse Intraoperative Report using the VistA Nurse Intraoperative "
^XPD(9.6,13521,1,5,0)="Report display/print option or on the SURGERY tab in CPRS.  This occurs "
^XPD(9.6,13521,1,6,0)="when the NURSE INTRAOP REPORT field (#29) in the SURGERY SITE PARAMETERS "
^XPD(9.6,13521,1,7,0)="FILE (#133) is set to ""PRINT TITLES WITH INFO ONLY"" and the CULTURES "
^XPD(9.6,13521,1,8,0)="field (#64) in the SURGERY FILE (#130) contains data and the SPECIMENS "
^XPD(9.6,13521,1,9,0)="field (#49) does not."
^XPD(9.6,13521,4,0)="^9.64PA^^"
^XPD(9.6,13521,6)="^197"
