^XPD(9.6,14178,0)="PSS*1.0*268^164^0^3251016^y"
^XPD(9.6,14178,1,0)="^^20^20^3251016^^"
^XPD(9.6,14178,1,1,0)="This patch includes the following updates required for the upgrade from"
^XPD(9.6,14178,1,2,0)="First Databank (FDB) MedKnowledge Framework (Fwk) version 3.3 to version"
^XPD(9.6,14178,1,3,0)="4.5. It also includes a fix for a possible undefined error when running"
^XPD(9.6,14178,1,4,0)="the Check PEPS Services Setup [PSS CHECK PEPS SERVICES SETUP] Option."
^XPD(9.6,14178,1,5,0)=" "
^XPD(9.6,14178,1,6,0)=" "
^XPD(9.6,14178,1,7,0)="(1) The Dosing Order checks are updated to show General Dosing Range"
^XPD(9.6,14178,1,8,0)="    messaging information when applicable. There are some scenarios where"
^XPD(9.6,14178,1,9,0)="    that information should display but does not."
^XPD(9.6,14178,1,10,0)=" "
^XPD(9.6,14178,1,11,0)="(2) Updates the DESCRIPTION and HELP-PROMPT of the DOSING CHECK FREQUENCY"
^XPD(9.6,14178,1,12,0)="    (#11) Field of the ADMINISTRATION SCHEDULE (#51.1) File."
^XPD(9.6,14178,1,13,0)=" "
^XPD(9.6,14178,1,14,0)="(3) Adds a description to the SYNONYM (#51.242) Subfile of the DOSE "
^XPD(9.6,14178,1,15,0)="    UNITS (#51.24) File."
^XPD(9.6,14178,1,16,0)=" "
^XPD(9.6,14178,1,17,0)="(4) Fixes an error that sometimes occurs when running the Check PEPS"
^XPD(9.6,14178,1,18,0)="    Services Setup [PSS CHECK PEPS SERVICES SETUP] Option, located under"
^XPD(9.6,14178,1,19,0)="    the Peps Services [PSS PEPS SERVICES] Menu Option, located under the"
^XPD(9.6,14178,1,20,0)="    Pharmacy Data Management [PSS MGR] Menu Option."
^XPD(9.6,14178,4,0)="^9.64PA^51.24^2"
^XPD(9.6,14178,4,51.1,0)=51.1
^XPD(9.6,14178,4,51.1,2,0)="^9.641^51.1^1"
^XPD(9.6,14178,4,51.1,2,51.1,0)="ADMINISTRATION SCHEDULE  (File-top level)"
^XPD(9.6,14178,4,51.1,2,51.1,1,0)="^9.6411^11^1"
^XPD(9.6,14178,4,51.1,2,51.1,1,11,0)="DOSING CHECK FREQUENCY"
^XPD(9.6,14178,4,51.1,222)="y^n^p^^^^n^^n"
