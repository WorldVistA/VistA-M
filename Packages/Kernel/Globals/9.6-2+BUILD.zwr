^XPD(9.6,14096,1,3,0)=" "
^XPD(9.6,14096,1,4,0)="VSE-10911: TW - VistA: Modify SDES2 CANCEL APPOINTMENT to back out"
^XPD(9.6,14096,1,5,0)="                cancel if subsequent files error out."
^XPD(9.6,14096,1,6,0)="VSE-10912: TB - VistA: Modify SDES2 CREATE APPOINTMENT to check the "
^XPD(9.6,14096,1,7,0)="                Patient file for existing appointment"
^XPD(9.6,14096,1,8,0)="VSE-10969: BB - VistA: Update SDES2 CREATE CLIN AVAIL2 to correctly store"
^XPD(9.6,14096,1,9,0)="                availability that is sent in."
^XPD(9.6,14096,1,10,0)="VSE-10986: TW - VistA: logic will fail and send the wrong offset on the "
^XPD(9.6,14096,1,11,0)="                date that daylight savings day ends"
^XPD(9.6,14096,1,12,0)="VSE-11056: LB - VistA: Modify SDES2 GET CLINICS BY STATION to return"
^XPD(9.6,14096,1,13,0)="                back all clinics that are associated to the parent"
^XPD(9.6,14096,1,14,0)="                station number sent in."
