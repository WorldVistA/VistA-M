^XPD(9.6,13776,1,1,0)="Jira Tickets Sprint 10.5 - VS GUI 1.7.61 - SD*5.3*887"
^XPD(9.6,13776,1,2,0)="======================================================"
^XPD(9.6,13776,1,3,0)=" "
^XPD(9.6,13776,1,4,0)="VSE-8228: JS - VistA: Modify GET CLIN* RPCs to return the new Veteran "
^XPD(9.6,13776,1,5,0)="          Self Cancel field."
^XPD(9.6,13776,1,6,0)="VSE-8230: JS - VistA: Add Veteran self-cancel to the clinic object "
^XPD(9.6,13776,1,7,0)="          returned by SDES2 GET APPT* RPC's"
^XPD(9.6,13776,1,8,0)="VSE-8231: JS - VistA: Create a post-install routine that will set the "
^XPD(9.6,13776,1,9,0)="          Veteran self-cancel flag for clinics"
^XPD(9.6,13776,1,10,0)="VSE-8234: TB - VistA: Modify $$INACTIVE^SDESUTIL to call "
^XPD(9.6,13776,1,11,0)="          $$INACTIVE^SDES2UTIL"
^XPD(9.6,13776,1,12,0)="VSE-8246: JJ - VistA: Modify SDES2 SEARCH CLINIC ATTRIBUTES to correct"
^XPD(9.6,13776,1,13,0)="          the empty object name and routine documentation"
^XPD(9.6,13776,1,14,0)="VSE-8259: BF - VistA: Modify SDES2 GET CLINIC AVAIL BY SVC to adjust the "
^XPD(9.6,13776,1,15,0)="          way the Maximum records returned is calculated"
^XPD(9.6,13776,1,16,0)="VSE-8402: JS - VistA: Modify SDES2 GET DISP CONT ATTEMPTS to fix an "
^XPD(9.6,13776,1,17,0)="          erroneous service IEN value"
^XPD(9.6,13776,1,18,0)=" "
