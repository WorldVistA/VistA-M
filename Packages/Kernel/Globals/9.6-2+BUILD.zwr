^XPD(9.6,13467,0)="PSO*7.0*725^60^0^3230511^y"
^XPD(9.6,13467,1,0)="^^30^30^3230511^"
^XPD(9.6,13467,1,1,0)="This patch addresses the following issue:"
^XPD(9.6,13467,1,2,0)=" "
^XPD(9.6,13467,1,3,0)="NEW RX IS ERRONEOUSLY GETTING SIG BUILT WITH VERB FROM LAST EDITED RX"
^XPD(9.6,13467,1,4,0)=" "
^XPD(9.6,13467,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13467,1,6,0)=" "
^XPD(9.6,13467,1,7,0)="1. INC27051655 - NEW RX IS ERRONEOUSLY GETTING SIG BUILT WITH VERB "
^XPD(9.6,13467,1,8,0)="                 FROM LAST EDITED RX"
^XPD(9.6,13467,1,9,0)=" "
^XPD(9.6,13467,1,10,0)="Problem:"
^XPD(9.6,13467,1,11,0)="--------"
^XPD(9.6,13467,1,12,0)="When editing an active prescription which has INJECT as a verb, and "
^XPD(9.6,13467,1,13,0)="finishing that Rx appropriately, the pharmacist then moves to another "
^XPD(9.6,13467,1,14,0)="patient and enters a new Rx, and the verb moves inappropriately to that "
^XPD(9.6,13467,1,15,0)="new Rx. The problem is seen when the verb for each RX is different."
^XPD(9.6,13467,1,16,0)=" "
^XPD(9.6,13467,1,17,0)="Resolution:"
^XPD(9.6,13467,1,18,0)="-----------"
^XPD(9.6,13467,1,19,0)="The problem is caused by the variable VERB not getting deleted when "
^XPD(9.6,13467,1,20,0)="quitting from routine PSOORED3.  At MW+9^PSOORED3, the processing quits "
^XPD(9.6,13467,1,21,0)="out without killing any variables.  All other places that quit out of the "
^XPD(9.6,13467,1,22,0)="routine quit via EX or EX1 that kill variables before quitting out of the "
^XPD(9.6,13467,1,23,0)="routine. "
^XPD(9.6,13467,1,24,0)=" "
^XPD(9.6,13467,1,25,0)="Technical Resolution:"
^XPD(9.6,13467,1,26,0)="---------------------"
^XPD(9.6,13467,1,27,0)="MW+9^PSOORED3 is changed from"
^XPD(9.6,13467,1,28,0)="   K QTYHLD Q:$G(PSOVER)!($G(PSOREEDQ))"
^XPD(9.6,13467,1,29,0)="To"
^XPD(9.6,13467,1,30,0)="   K QTYHLD G:$G(PSOVER)!($G(PSOREEDQ)) EX1"
^XPD(9.6,13467,4,0)="^9.64PA^^"
^XPD(9.6,13467,6)="^604"
^XPD(9.6,13467,6.3)=1
^XPD(9.6,13467,"ABPKG")="n"
^XPD(9.6,13467,"KRN",0)="^9.67PA^1.5^25"
^XPD(9.6,13467,"KRN",.4,0)=.4
