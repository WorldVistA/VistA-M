^XPD(9.6,14139,1,1,0)="This patch addresses the following issues:"
^XPD(9.6,14139,1,2,0)=" "
^XPD(9.6,14139,1,3,0)="1. INC39104376 - GMTS-1447 - In CPRS, the printout display does not match "
^XPD(9.6,14139,1,4,0)="the display in the reports tab for the MRT2 Health Summary Report."
^XPD(9.6,14139,1,5,0)="   Duplicates: INC38680134 "
^XPD(9.6,14139,1,6,0)=" "
^XPD(9.6,14139,1,7,0)="2. INC32167156 - GMTS-1272 - Remote Outpatient RXS on hold at Central "
^XPD(9.6,14139,1,8,0)="Alabama HCS not displaying on Essential Med. List for Review."
^XPD(9.6,14139,4,0)="^9.64PA^^"
