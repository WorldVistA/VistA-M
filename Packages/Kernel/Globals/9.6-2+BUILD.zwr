^XPD(9.6,13817,0)="OR*3.0*535^35^0^3240912^y"
^XPD(9.6,13817,1,0)="^^26^26^3240912^^^^"
^XPD(9.6,13817,1,1,0)="This patch introduces the following modifications:"
^XPD(9.6,13817,1,2,0)=" "
^XPD(9.6,13817,1,3,0)="1. This patch creates a new Glucophage/Metformin Order Check that uses an"
^XPD(9.6,13817,1,4,0)="estimated Glomerular Filtration Rate (eGFR) calculation instead of using"
^XPD(9.6,13817,1,5,0)="the Serum Creatinine as the current Order Check does."
^XPD(9.6,13817,1,6,0)=" "
^XPD(9.6,13817,1,7,0)="2. A problem was discovered in the Computerized Patient Record System"
^XPD(9.6,13817,1,8,0)="(CPRS) v31b release with the display of ordering providers in the alert"
^XPD(9.6,13817,1,9,0)="list. This patch will correct this issue."
^XPD(9.6,13817,1,10,0)=" "
^XPD(9.6,13817,1,11,0)="3. The Care Management Package has been decommissioned. There are"
^XPD(9.6,13817,1,12,0)="remaining API calls to Care Management routines in the Order"
^XPD(9.6,13817,1,13,0)="Entry/Results Reporting (OE/RR) package. This patch removes those API"
^XPD(9.6,13817,1,14,0)="calls."
^XPD(9.6,13817,1,15,0)=" "
^XPD(9.6,13817,1,16,0)="4. It adds a new option to allow sites to edit the ORDER CHECK OVERRIDE"
^XPD(9.6,13817,1,17,0)="REASONS (#100.04) file."
^XPD(9.6,13817,1,18,0)=" "
^XPD(9.6,13817,1,19,0)="5. It corrects the display of the patient's name in the View Patient"
^XPD(9.6,13817,1,20,0)="Notifications alert detail dialog."
^XPD(9.6,13817,1,21,0)=" "
^XPD(9.6,13817,1,22,0)="6. It corrects an Integration Control Registrations (ICR) documentation"
^XPD(9.6,13817,1,23,0)="issue recently discovered during development activities."
^XPD(9.6,13817,1,24,0)=" "
^XPD(9.6,13817,1,25,0)="7. It adds a new entry to the ORDER CHECK OVERRIDE REASONS (#100.04)"
^XPD(9.6,13817,1,26,0)="file."
^XPD(9.6,13817,4,0)="^9.64PA^100.04^2"
^XPD(9.6,13817,4,100.04,0)=100.04
^XPD(9.6,13817,4,100.04,222)="y^y^f^^^^n^^n"
^XPD(9.6,13817,4,100.04,224)=""
^XPD(9.6,13817,4,100.8,0)=100.8
^XPD(9.6,13817,4,100.8,222)="n^y^f^^n^^y^o^n"
^XPD(9.6,13817,4,100.8,224)="I Y=100"
^XPD(9.6,13817,4,"B",100.04,100.04)=""
^XPD(9.6,13817,4,"B",100.8,100.8)=""
