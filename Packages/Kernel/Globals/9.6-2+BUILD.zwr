^XPD(9.6,14125,1,47,0)="========="
^XPD(9.6,14125,1,48,0)="SDECAR             - VSE-11008 (MODIFIED)"
^XPD(9.6,14125,1,49,0)="SDESGETPATINQUIR   - VSE-11042 (MODIFIED)"
^XPD(9.6,14125,1,50,0)="SDES927P           - VSE-10970,11069 (NEW)"
