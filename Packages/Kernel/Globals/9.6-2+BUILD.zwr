^XPD(9.6,13673,0)="PSO*7.0*736^60^0^3240307^y"
^XPD(9.6,13673,1,0)="^^37^37^3240307^^^"
^XPD(9.6,13673,1,1,0)="The OneVA Pharmacy application provides the Veterans Health "
^XPD(9.6,13673,1,2,0)="Administration (VHA) with the capability to allow Veterans travelling "
^XPD(9.6,13673,1,3,0)="across the United States to refill/partial fill their active VA"
^XPD(9.6,13673,1,4,0)="prescription at any VA Pharmacy regardless of where the prescription"
^XPD(9.6,13673,1,5,0)="originated. The OneVA Pharmacy application design consists of 3 main"
^XPD(9.6,13673,1,6,0)="components: VistA Medication Profile screen, Health Data Record Clinical"
^XPD(9.6,13673,1,7,0)="Data Service (HDR/CDS), and OneVA Pharmacy message flow. The VistA"
^XPD(9.6,13673,1,8,0)="Medication Profile screen expands available pharmacy information in VistA"
^XPD(9.6,13673,1,9,0)="to provide pharmacists direct access to query, and refill/partial fill"
^XPD(9.6,13673,1,10,0)="patient's active and refillable prescriptions. The HDR/CDS provides a"
^XPD(9.6,13673,1,11,0)="patient's active and refillable prescriptions. The OneVA Pharmacy message"
^XPD(9.6,13673,1,12,0)="flow enables the secure, bi-directional exchange of electronic health"
^XPD(9.6,13673,1,13,0)="records between local/remote VistA Servers, and between VistA servers and"
^XPD(9.6,13673,1,14,0)="HDR."
^XPD(9.6,13673,1,15,0)=" "
^XPD(9.6,13673,1,16,0)="The OneVA software currently uses IBM Websphere as the messaging system. "
^XPD(9.6,13673,1,17,0)="The IBM Websphere messaging system is being decommissioned. This patch "
^XPD(9.6,13673,1,18,0)="provides the move from using IBM Websphere to using the Veterans Data "
^XPD(9.6,13673,1,19,0)="Information Exchange (VDIF)."
^XPD(9.6,13673,1,20,0)=" "
^XPD(9.6,13673,1,21,0)="The software changes include the following:"
^XPD(9.6,13673,1,22,0)="1. Routine PSORRX1 - DNS value modified at REMOTERX+18"
^XPD(9.6,13673,1,23,0)="2. Routine PSORRX1 - modified argument list and corresponding references "
^XPD(9.6,13673,1,24,0)="   to the DRUGMTCH function"
^XPD(9.6,13673,1,25,0)="3. Routine PSORRX1 - modified to handle HL7 messages with possible "
^XPD(9.6,13673,1,26,0)="   overflow nodes at RXPRSE+4"
^XPD(9.6,13673,1,27,0)="4. Routine PSOHLDS6 - modified to handle HL7 messages with possible"
^XPD(9.6,13673,1,28,0)="   overflow nodes at HOST+2 "
^XPD(9.6,13673,1,29,0)="5. Routine PSOORUT1 - modified ""PROVIDER HOLD"" status abbreviation from "
^XPD(9.6,13673,1,30,0)="   ""PH"" to ""HP"" at SHOWREM+13"
^XPD(9.6,13673,1,31,0)="6. Routine PSOORUT1 - added ""DISCONTINUED BY PROVIDER"", ""DISCONTINUED"
^XPD(9.6,13673,1,32,0)="   (EDIT)"", and ""NON-VERIFIED"" status abbreviations at SHOWREM+13"
^XPD(9.6,13673,1,33,0)="7. HL LOGICAL LINK entry - the post-install routine POST^PSO736PO updates"
^XPD(9.6,13673,1,34,0)="   the PSORRXSEND entry of the HL LOGICAL LINK (#870) file.  The following"
^XPD(9.6,13673,1,35,0)="   fields will be updated to reflect VDIF production IP address and port "
^XPD(9.6,13673,1,36,0)="   values when installed in the site's production account:  DNS DOMAIN,"
^XPD(9.6,13673,1,37,0)="   TCP/IP ADDRESS, and TCP/IP PORT"
^XPD(9.6,13673,4,0)="^9.64PA^^"
^XPD(9.6,13673,6)="^619"
^XPD(9.6,13673,6.3)=19
^XPD(9.6,13673,"ABPKG")="n"
^XPD(9.6,13673,"INID")="^n"
^XPD(9.6,13673,"INIT")="POST^PSO736PO"
^XPD(9.6,13673,"KRN",0)="^9.67PA^1.5^25"
^XPD(9.6,13673,"KRN",.4,0)=.4
