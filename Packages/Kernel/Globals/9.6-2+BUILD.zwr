^XPD(9.6,13864,1,1,0)="This patch addresses one issue:"
^XPD(9.6,13864,1,2,0)=" "
^XPD(9.6,13864,1,3,0)="In certain instances, when creating a new HBHC admission with the VistA "
^XPD(9.6,13864,1,4,0)="option Evaluation/Admission Data Entry [HBHCADM], the default home state "
^XPD(9.6,13864,1,5,0)="that is displayed for the patient's STATE CODE is not the same as the "
^XPD(9.6,13864,1,6,0)="patient's home state."
^XPD(9.6,13864,4,0)="^9.64PA^^"
^XPD(9.6,13864,6)="^31"
^XPD(9.6,13864,6.3)=1
