^XPD(9.6,13635,1,7,0)="VSE-6483: LB - SDES2 Priority 9: Rewrite SDES GET APPTS BY RESOURCE in "
^XPD(9.6,13635,1,8,0)="          the SDES2 namespace."
^XPD(9.6,13635,1,9,0)="VSE-6837: TB - SDES2 Priority 32: Rewrite SDES GET PATIENT REGISTRATION2 "
^XPD(9.6,13635,1,10,0)="          in the SDES2 namespace to address sensitive patient records."
^XPD(9.6,13635,1,11,0)="VSE-6848: BF - SDES2 Priority 35: Rewrite SDES GET APPT REQ LIST BY DFN, "
^XPD(9.6,13635,1,12,0)="          SDES GET CONSULTS BY DFN, SDES GET CONSULTS BY IEN, SDES GET"
^XPD(9.6,13635,1,13,0)="          APPT REQ BY DFN, and SDES GET APPT REQ BY IEN in the SDES2"
^XPD(9.6,13635,1,14,0)="          namespace to address sensitive patient records."
^XPD(9.6,13635,1,15,0)="VSE-6887: JS - VistA: Modify SDEC and SDES code to return an error when "
^XPD(9.6,13635,1,16,0)="          MRTC child request has a duplicate PID."
^XPD(9.6,13635,1,17,0)="VSE-7118: BB - VistA: Modify SDES GET APPT REQ RPCs to return child "
^XPD(9.6,13635,1,18,0)="          sequence field."
^XPD(9.6,13635,1,19,0)="VSE-7306: LB - VistA: Modify SDES2 GET CONTACT ATTEMPTS to quit out when "
^XPD(9.6,13635,1,20,0)="          no contact is found."
^XPD(9.6,13635,1,21,0)="VSE-7451: BF - VistA: Modify SDES2 QUERY APPT REQUESTS and associated "
^XPD(9.6,13635,1,22,0)="          SDES2 RPCs"
^XPD(9.6,13635,1,23,0)="VSE-7465: BB - VistA: Fix issue with SDES2 CREATE APPOINTMENT where "
^XPD(9.6,13635,1,24,0)="          Inpatients are not idenified"
^XPD(9.6,13635,1,25,0)="VSE-7466: BB - VistA: Fix issue with SDES2 CANCEL CLINC AVAIL to prevent "
^XPD(9.6,13635,1,26,0)="          <UNDEFINED> error"
^XPD(9.6,13635,1,27,0)=" "
^XPD(9.6,13635,1,28,0)="Files:"
^XPD(9.6,13635,1,29,0)="======"
