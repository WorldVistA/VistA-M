^XPD(9.6,14147,1,1,0)="This patch addresses the following issues:"
^XPD(9.6,14147,1,2,0)="1. INC31115306 - VISTAOR-36624 - Anticoagulation Management Tool software "
^XPD(9.6,14147,1,3,0)="reverting dosing matrix to previous value."
^XPD(9.6,14147,1,4,0)=" "
^XPD(9.6,14147,1,5,0)="2. INC32051845 - VISTAOR-36623 - Anti-coagulation Management Tool (AMT) "
^XPD(9.6,14147,1,6,0)="needs to be rebuilt with a newer version of broker."
^XPD(9.6,14147,1,7,0)=" "
^XPD(9.6,14147,1,8,0)="3. INC35910518 - VISTAOR-38601 - ""floating point value"" Error when adding"
^XPD(9.6,14147,1,9,0)="new warfarin patient to the Anticoagulation Management Tool."
^XPD(9.6,14147,1,10,0)=" "
^XPD(9.6,14147,1,11,0)="4. N/A - VISTAOR-38467 - ICR 10060 Violation - direct global read "
^XPD(9.6,14147,1,12,0)="^VA(200,IEN,0) in ORAM1"
^XPD(9.6,14147,4,0)="^9.64PA^^"
^XPD(9.6,14147,6)="^538"
^XPD(9.6,14147,6.3)=5
