^XPD(9.6,13829,0)="SD*5.3*890^48^0^3241023^y"
^XPD(9.6,13829,1,0)="^^82^82^3241023^"
^XPD(9.6,13829,1,1,0)=" "
^XPD(9.6,13829,1,2,0)="Jira Tickets Sprint 10.7 - VS GUI 1.7.63 - SD*5.3*890"
^XPD(9.6,13829,1,3,0)="======================================================"
^XPD(9.6,13829,1,4,0)=" "
^XPD(9.6,13829,1,5,0)="VSE-7980: BB - VistA: Support re-opening length of appointment field as "
^XPD(9.6,13829,1,6,0)="          needed"
^XPD(9.6,13829,1,7,0)="VSE-8000: BB - VistA: Keep previously canceled timeslots in place when "
^XPD(9.6,13829,1,8,0)="          overwriting new clinic availability"
^XPD(9.6,13829,1,9,0)="VSE-8310: JS - VistA: Write 3 RPCs into SDES2 namespace and return error "
^XPD(9.6,13829,1,10,0)="          message for inactive users for all User Profile RPCs."
^XPD(9.6,13829,1,11,0)="VSE-8406: BF - VistA: Create a new RPC that sends back the set of code "
^XPD(9.6,13829,1,12,0)="          stored in the HOSPITAL LOCATION (#44) file, SERVICE (#9) field"
^XPD(9.6,13829,1,13,0)="          and the description for those codes"
^XPD(9.6,13829,1,14,0)="VSE-8408: BF - VistA: Create a Post init routine that would compare the "
^XPD(9.6,13829,1,15,0)="          Gold Standard for HOSPITAL LOCATION (#44), SERVICE (#9) field"
^XPD(9.6,13829,1,16,0)="VSE-8409: BF - VistA: lock down File 44 to prevent third party changes to "
^XPD(9.6,13829,1,17,0)="          the file"
^XPD(9.6,13829,1,18,0)="VSE-8610: JDJ - VistA: PtCSch request creation failed: Modify SDES2 CREATE"
^XPD(9.6,13829,1,19,0)="          RECALL REQUEST to correct and error with APPOINTMENT TYPE"
^XPD(9.6,13829,1,20,0)=" "
^XPD(9.6,13829,1,21,0)=" "
^XPD(9.6,13829,1,22,0)="Jira Tickets Sprint 11.1 - VS GUI 1.7.63 - SD*5.3*890"
^XPD(9.6,13829,1,23,0)="======================================================"
^XPD(9.6,13829,1,24,0)="VSE-8441: BF - VistA: Add new text field DUPLICATE REASON to the SDEC"
^XPD(9.6,13829,1,25,0)="          APPT REQUEST file"
^XPD(9.6,13829,1,26,0)="VSE-8478: TB - VistA: Modify SDES2 INACTIVATE CLINIC to check to see if "
^XPD(9.6,13829,1,27,0)="          there is a current reactivate date on the clinic that is less"
^XPD(9.6,13829,1,28,0)="          than or equal to the passed in inactivate date"
^XPD(9.6,13829,1,29,0)="VSE-8728: LB - VistA: Modifications to SDES2APPTUTIL to fix a leaking "
^XPD(9.6,13829,1,30,0)="          variable"
^XPD(9.6,13829,1,31,0)=" "
