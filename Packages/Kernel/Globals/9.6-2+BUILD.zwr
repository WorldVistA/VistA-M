^XPD(9.6,13752,1,3,0)=" "
^XPD(9.6,13752,1,4,0)="VSE-7966: JS - VistA: Create a new SDES2 RPC to return all contact "
^XPD(9.6,13752,1,5,0)="               attempts per patient not per appointment or request"
^XPD(9.6,13752,1,6,0)="VSE-8036: BF - VistA: Create a new field for Veteran Self Cancel and add "
^XPD(9.6,13752,1,7,0)="               create/edit clinic"
^XPD(9.6,13752,1,8,0)="VSE-8063: FF - VS GUI: Issue between GUI and ISS when creating and "
^XPD(9.6,13752,1,9,0)="               editing VVS appointments"
^XPD(9.6,13752,1,10,0)="VSE-8101: JJ - VistA: Update to SDECAUD for change from date to date.time"
^XPD(9.6,13752,1,11,0)="VSE-8172: BF - VistA: Modify SDES2QRYAPREQSA to use the new index, only "
^XPD(9.6,13752,1,12,0)="               looking at 'open' records. "
^XPD(9.6,13752,1,13,0)="VSE-8196: BB - VistA: Wrong PID Is being displayed after cancelling an "
