^XPD(9.6,14019,1,576,0)="11.Search by Remove Reason codes"
^XPD(9.6,14019,1,577,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,14019,1,578,0)="   The search query option MESSAGE TYPE has been modified. Upon entering"
^XPD(9.6,14019,1,579,0)="   certain eRx Status (RM and RJ) as listed below, the user will be prompted"
^XPD(9.6,14019,1,580,0)="   to enter the corresponding REMOVAL or REJECT REASON CODE as indicated. In"
^XPD(9.6,14019,1,581,0)="   this prompt, users have the option to choose ALL to view all REMOVAL or"
^XPD(9.6,14019,1,582,0)="   REJECT REASON CODE or select a specific response type as shown below. For"
^XPD(9.6,14019,1,583,0)="   additional details on this new change, please refer to the user manual "
^XPD(9.6,14019,1,584,0)="   documentation."
^XPD(9.6,14019,1,585,0)=" "
^XPD(9.6,14019,1,586,0)="    . . ."
^XPD(9.6,14019,1,587,0)="    SEARCH BY: 5  ERX STATUS"
