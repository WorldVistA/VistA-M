^XPD(9.6,13613,1,0)="^^76^76^3240111^"
^XPD(9.6,13613,1,1,0)="VSE Increment 8.17 - SD*5*3*867 - GUI v 1.7.53"
^XPD(9.6,13613,1,2,0)="=============================================="
^XPD(9.6,13613,1,3,0)=" "
^XPD(9.6,13613,1,4,0)="Tickets:"
^XPD(9.6,13613,1,5,0)="========"
^XPD(9.6,13613,1,6,0)="VSE-6482: TB - SDES2 Priority 8: Rewrite SDES GET APPTS BY CLINIEN LIST "
^XPD(9.6,13613,1,7,0)="          in the SDES2 namespace."
^XPD(9.6,13613,1,8,0)="VSE-6486: JS - SDES2 Priority 12: Rewrite SDES CHECKOUT in the SDES2 "
^XPD(9.6,13613,1,9,0)="          namespace."
^XPD(9.6,13613,1,10,0)="VSE-6487: BB - SDES2 Priority 13: Rewrite SDES CREATE VET REQ SCHED APPT "
^XPD(9.6,13613,1,11,0)="          in the SDES2 namespace."
^XPD(9.6,13613,1,12,0)="VSE-6550: LB - VistA: Create a new SDES2 RPC that accepts a Resource Type "
^XPD(9.6,13613,1,13,0)="          and IEN and returns RESOURCE IEN"
^XPD(9.6,13613,1,14,0)="VSE-6682: AP - VistA: Modify SDES2 GET PATIENT EP to return all dates in "
^XPD(9.6,13613,1,15,0)="          ISO 8601 format."
^XPD(9.6,13613,1,16,0)="VSE-6725: LB - VistA: Modify SDES GET APPT REQ* RPCs and SDES2 GET "
^XPD(9.6,13613,1,17,0)="          REQUESTS BY INST to return stop codes for consults and"
^XPD(9.6,13613,1,18,0)="          procedures."
^XPD(9.6,13613,1,19,0)="VSE-6726: AP - VistA: Modify SDES01C routine to remove lines 58 though 61 "
^XPD(9.6,13613,1,20,0)="          and skip looking at abbreviations in the C cross reference."
^XPD(9.6,13613,1,21,0)="VSE-6791: MD - VistA: Update the RPC definition for SDES CREATE APPT REQ"
^XPD(9.6,13613,1,22,0)="          in FileMan to add the properly formatted JSON return."
^XPD(9.6,13613,1,23,0)="VSE-6817: LB - VistA: Modify SDES GET CLINIC INFO2 to return the Resource "
^XPD(9.6,13613,1,24,0)="          IEN to the return object"
^XPD(9.6,13613,1,25,0)="VSE-6831: LB - VistA: Modify SDES GET CANCEL REASONS to return back the "
^XPD(9.6,13613,1,26,0)="          REOPEN UPON CANCELLATION field"
^XPD(9.6,13613,1,27,0)="VSE-6835: BB - VistA: Modify SDES2 GET EXPANDED ENTRY to return the "
^XPD(9.6,13613,1,28,0)="          diagnostic code with the diagnosis"
^XPD(9.6,13613,1,29,0)="VSE-6840: LB - VistA: Modify SDAMUTDT routine to correctly recognize a "
^XPD(9.6,13613,1,30,0)="          ""zero offset"" clinic"
^XPD(9.6,13613,1,31,0)="VSE-6877: LB - VistA: Issue with block and move"
^XPD(9.6,13613,1,32,0)="VSE-7054: BB - VistA: Modify SDES2 GET RESOURCE GROUP to include resources"
^XPD(9.6,13613,1,33,0)="          that have been inactivated in the past"
^XPD(9.6,13613,1,34,0)=" "
