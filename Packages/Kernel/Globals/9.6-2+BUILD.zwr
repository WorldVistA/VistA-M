^XPD(9.6,14218,1,6,0)="VSE-11120: MB - VistA: Update SDES2 GET APPT BY APPT IEN and all SDES2 "
^XPD(9.6,14218,1,7,0)="           GET APPTS* RPCS to strip out invalid and control characters."
^XPD(9.6,14218,1,8,0)="VSE-11174: GW - VistA: Modify SDES2 UNDO CHECKOUT so that it no longer "
^XPD(9.6,14218,1,9,0)="           updates the DATA ENTRY CLERK (#.08) field in the SDEC"
^XPD(9.6,14218,1,10,0)="           APPOINTMENT (#409.84) file when completing an undo checkout"
^XPD(9.6,14218,1,11,0)="           request"
^XPD(9.6,14218,1,12,0)="VSE-11419: MB - VistA: Return full object back on edit of appointment - "
