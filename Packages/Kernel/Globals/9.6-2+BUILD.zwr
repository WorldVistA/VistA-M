^XPD(9.6,13727,1,715,0)="12.(HDSO-7772) Jump to eRx Patient from Backdoor"
^XPD(9.6,13727,1,716,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13727,1,717,0)="   A new hidden action called Jump to eRx Patient (JE) is being added to the"
^XPD(9.6,13727,1,718,0)="   Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option. It will be"
^XPD(9.6,13727,1,719,0)="   available in the Patient Information screen as well as in the Medication "
^XPD(9.6,13727,1,720,0)="   Profile screen. This option will allow the user to jump to the eRx Holding"
^XPD(9.6,13727,1,721,0)="   Queue in the eRx Single Patient Queue.  "
^XPD(9.6,13727,1,722,0)="  "
^XPD(9.6,13727,1,723,0)="13.(HDSO-7773) View Suggestions for Patient, Provider and Drug"
^XPD(9.6,13727,1,724,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13727,1,725,0)="   A new hidden action called View Suggestion(s) (VS) is being added to the"
^XPD(9.6,13727,1,726,0)="   Validate Patient, Validate Provider and Validate Drug screens. This feature"
^XPD(9.6,13727,1,727,0)="   will allow users to view and manage suggestions at any time, before or"
^XPD(9.6,13727,1,728,0)="   after the eRx has been accepted/processed. Below are some examples for each"
