^XPD(9.6,13994,0)="SD*5.3*907^48^0^3250527^y"
^XPD(9.6,13994,1,0)="^^61^61^3250516^"
^XPD(9.6,13994,1,1,0)=" "
^XPD(9.6,13994,1,2,0)=" Jira Tickets Sprint 12.8 - SD*5.3*907"
^XPD(9.6,13994,1,3,0)="===================================================== "
^XPD(9.6,13994,1,4,0)="VSE-9509: JJ - VistA: Update the veteran crisis line telephone number to"
^XPD(9.6,13994,1,5,0)="               ""988 x 1"", so that ISS reflects the preference set from"
^XPD(9.6,13994,1,6,0)="VSE-9574: MB - VistA: Modify SDES2 GET CLINIC INFO to include the "
^XPD(9.6,13994,1,7,0)="               diagnosis multiple and privileged user multiple IVC."
^XPD(9.6,13994,1,8,0)="VSE-9575: JC - VistA: Create a new SDES2 RPC to replace SDES GET VISTA "
^XPD(9.6,13994,1,9,0)="               DEVICES "
^XPD(9.6,13994,1,10,0)="VSE-9691: TB - VistA: The SDES REACTIVATE CLINIC has logic to check for"
^XPD(9.6,13994,1,11,0)="               an error returned by FileMan but it is flawed"
^XPD(9.6,13994,1,12,0)="VSE-9700: JJ - VistA: Modify the SDES2 SEARCH CLIN BY STOP CODE RPC to "
^XPD(9.6,13994,1,13,0)="               prevent the return of a null return, which causes a 500"
^XPD(9.6,13994,1,14,0)="               error in CCMM"
^XPD(9.6,13994,1,15,0)="VSE-9701: JV - VistA: MRTC parent requests were left open even though "
^XPD(9.6,13994,1,16,0)="               all the children requests have been dispositioned"
^XPD(9.6,13994,1,17,0)="VSE-9702: JS - VistA: Update SDES2 EDIT APPOINTMENT RPC to prevent null "
^XPD(9.6,13994,1,18,0)="               Note values in the Note Audit section"
^XPD(9.6,13994,1,19,0)="VSE-9711: MB - VistA: Users are unable to inactivate a clinic at the "
^XPD(9.6,13994,1,20,0)="               exact 6 month mark"
^XPD(9.6,13994,1,21,0)="VSE-9747: LB - VistA: Modify FMTISO API to no longer use the kernel "
^XPD(9.6,13994,1,22,0)="               logic to convert date"
^XPD(9.6,13994,1,23,0)="VSE-9995: LB - VistA: Modify SDES2 GET CANCELLED SLOTS RPC to return"
^XPD(9.6,13994,1,24,0)="               back a Boolean fullDayCancelled flag "
^XPD(9.6,13994,1,25,0)=" "
^XPD(9.6,13994,1,26,0)=" "
^XPD(9.6,13994,1,27,0)="Files:"
^XPD(9.6,13994,1,28,0)="======"
