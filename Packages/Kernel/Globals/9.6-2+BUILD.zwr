^XPD(9.6,13570,0)="PSO*7.0*723^60^0^3231003^y"
^XPD(9.6,13570,1,0)="^^135^135^3230920^"
^XPD(9.6,13570,1,1,0)="This patch addresses the following issue:"
^XPD(9.6,13570,1,2,0)=" "
^XPD(9.6,13570,1,3,0)="ECDSA Key creation"
^XPD(9.6,13570,1,4,0)=" "
^XPD(9.6,13570,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13570,1,6,0)=" "
^XPD(9.6,13570,1,7,0)="1. INC26749697 - ECDSA KEY CREATION"
^XPD(9.6,13570,1,8,0)=" "
^XPD(9.6,13570,1,9,0)="Patch Components:"
^XPD(9.6,13570,1,10,0)="-----------------"
^XPD(9.6,13570,1,11,0)=" "
^XPD(9.6,13570,1,12,0)="Files & Fields Associated:"
^XPD(9.6,13570,1,13,0)=" "
^XPD(9.6,13570,1,14,0)="File Name (Number)         Field Name (Number)        New/Modified/Deleted"
^XPD(9.6,13570,1,15,0)="------------------         -------------------        --------------------"
^XPD(9.6,13570,1,16,0)="SPMP STATE PARAMETERS      SFTP SSH KEY ENCRYPTION    Modified"
^XPD(9.6,13570,1,17,0)="(#58.41)                   (#19)                    "
^XPD(9.6,13570,1,18,0)=" "
^XPD(9.6,13570,1,19,0)="Problem:"
^XPD(9.6,13570,1,20,0)="--------"
^XPD(9.6,13570,1,21,0)="With the implementation of Red Hat Enterprise Linux (RHEL 8) stronger "
^XPD(9.6,13570,1,22,0)="encryption keys ECDSA & EDDSA are now available and supported. SPMP "
^XPD(9.6,13570,1,23,0)="application currently is using RSA type SSH key for connecting to the "
^XPD(9.6,13570,1,24,0)="SPMP server to send data. "
^XPD(9.6,13570,1,25,0)=" "
^XPD(9.6,13570,1,26,0)="New keys added:"
^XPD(9.6,13570,1,27,0)="Elliptic Curve Digital Signature Algorithm (ECDSA)"
^XPD(9.6,13570,1,28,0)="Edward-curve Digital Signature Algorithm (ed25519)"
^XPD(9.6,13570,1,29,0)=" "
^XPD(9.6,13570,1,30,0)="EDDSA is also known as ed25519 "
^XPD(9.6,13570,1,31,0)=" "
^XPD(9.6,13570,1,32,0)="Necessary changes are required to allow creation of ECDSA & EDDSA keys "
^XPD(9.6,13570,1,33,0)="for the SPMP application. Support for RSA keys are anticipated to be "
^XPD(9.6,13570,1,34,0)="deprecated in the future, so to maintain Vista's security posture and "
^XPD(9.6,13570,1,35,0)="ensure continuous operation of required Vista processes, software "
^XPD(9.6,13570,1,36,0)="utilizing SSH PKI user keys must be updated to support the stronger ECDSA "
^XPD(9.6,13570,1,37,0)="& EDDSA encryption keys. "
^XPD(9.6,13570,1,38,0)=" "
^XPD(9.6,13570,1,39,0)="The modification should allow the creation of any ECDSA & EDDSA keys to "
^XPD(9.6,13570,1,40,0)="be "
^XPD(9.6,13570,1,41,0)="forward compatible when Red Hat Enterprise Linux (RHEL 8) is implemented."
^XPD(9.6,13570,1,42,0)=" "
^XPD(9.6,13570,1,43,0)="Resolution:"
^XPD(9.6,13570,1,44,0)="-----------"
^XPD(9.6,13570,1,45,0)="File SPMP STATE PARAMETERS (#58.41) field SFTP SSH KEY ENCRYPTION (#19) is"
^XPD(9.6,13570,1,46,0)="modified to add code ECDSA (Elliptic Curve Digital Signature Algorithm) & "
^XPD(9.6,13570,1,47,0)="EDDSA (Edward-curve Digital Signature Algorithm)."
^XPD(9.6,13570,1,48,0)=" "
^XPD(9.6,13570,1,49,0)="Modify PSOSPMKY to allow ECDSA or EDDSA (ed25519) key to be created,"
^XPD(9.6,13570,1,50,0)="viewed, deleted, and update the help text."
^XPD(9.6,13570,1,51,0)=" "
^XPD(9.6,13570,1,52,0)=" "
^XPD(9.6,13570,1,53,0)="Technical Resolution:"
^XPD(9.6,13570,1,54,0)="---------------------"
^XPD(9.6,13570,1,55,0)="Add Code ECDSA (Elliptic Curve Digital Signature Algorithm) & EDDSA "
^XPD(9.6,13570,1,56,0)="(Edward-curve Digital Signature Algorithm) to the set of codes for field "
^XPD(9.6,13570,1,57,0)="#19 in file #58.41"
^XPD(9.6,13570,1,58,0)=" "
^XPD(9.6,13570,1,59,0)="Routine PSOSPMKY is modified as follows"
^XPD(9.6,13570,1,60,0)=" "
^XPD(9.6,13570,1,61,0)="ACTION+24 is changed from"
^XPD(9.6,13570,1,62,0)="  . S DIR(0)=""S^DSA:Digital Signature Algorithm (DSA);RSA:Rivest, Shamir "
^XPD(9.6,13570,1,63,0)="& Adleman (RSA)"""
^XPD(9.6,13570,1,64,0)="To"
^XPD(9.6,13570,1,65,0)="  . S DIR(0)=""S^RSA:Rivest, Shamir & Adleman (RSA);DSA:Digital Signature "
^XPD(9.6,13570,1,66,0)="Algorithm (DSA);ECDSA:Elliptic Curve Digital Signature Algorithm "
^XPD(9.6,13570,1,67,0)="(ECDSA);EDDSA:Edward-curve Digital Signature Algorithm (ed25519)"" ;p723"
^XPD(9.6,13570,1,68,0)=" "
^XPD(9.6,13570,1,69,0)="ACTION+26 changed from"
^XPD(9.6,13570,1,70,0)="  .S ENCRTYPE=Y"
^XPD(9.6,13570,1,71,0)="To"
^XPD(9.6,13570,1,72,0)=" .S ENCRTYPE=Y I Y=""DSA"" D  Q"
^XPD(9.6,13570,1,73,0)=" .. W !!,$G(IOBON),""WARNING:"",$G(IOBOFF),"" 'DSA' SSH keys are no longer "
^XPD(9.6,13570,1,74,0)="supported."",$C(7)  "
^XPD(9.6,13570,1,75,0)=" "
^XPD(9.6,13570,1,76,0)="NEWKEY+9 is changed from"
^XPD(9.6,13570,1,77,0)="  I $G(ENCRTYPE)'=""DSA"",$G(ENCRTYPE)'=""RSA"" S ENCRTYPE=""RSA"""
^XPD(9.6,13570,1,78,0)="To"
^XPD(9.6,13570,1,79,0)="   S "
^XPD(9.6,13570,1,80,0)="ENCRTYPE=$S($G(ENCRTYPE)=""ECDSA"":""ECDSA"",$G(ENCRTYPE)=""EDDSA"":""ed25519"",1:"
^XPD(9.6,13570,1,81,0)="""RSA"")"
^XPD(9.6,13570,1,82,0)=" "
^XPD(9.6,13570,1,83,0)="NEWKEY+63 is changed from"
^XPD(9.6,13570,1,84,0)="  S DR=""18///""_$S(PSOOS[""VMS"":""SSH2"",1:""OSSH"")_"";19///""_ENCRTYPE D ^DIE"
^XPD(9.6,13570,1,85,0)="To "
^XPD(9.6,13570,1,86,0)="  S DR=""18///""_$S(PSOOS[""VMS"":""SSH2"",1:""OSSH"")_"";19////""_ENCRTYPE D ^DIE"
^XPD(9.6,13570,1,87,0)=" "
^XPD(9.6,13570,1,88,0)="The Help text is change to:"
^XPD(9.6,13570,1,89,0)=" "
^XPD(9.6,13570,1,90,0)="Secure SHell (SSH) Encryption Keys are used to automate the data "
^XPD(9.6,13570,1,91,0)="transmission"
^XPD(9.6,13570,1,92,0)="to the State Prescription Monitoring Programs (SPMPs). Follow the steps "
^XPD(9.6,13570,1,93,0)="below"
^XPD(9.6,13570,1,94,0)="to successfully setup SPMP transmissions from VistA to the state/vendor "
^XPD(9.6,13570,1,95,0)="server:"
^XPD(9.6,13570,1,96,0)=" "
^XPD(9.6,13570,1,97,0)="Step 1: Select the 'N' (Create New SSH Key Pair) Action and follow the "
^XPD(9.6,13570,1,98,0)="prompts"
^XPD(9.6,13570,1,99,0)="        to create a new pair of SSH keys. If you already have an existing "
^XPD(9.6,13570,1,100,0)="SSH"
^XPD(9.6,13570,1,101,0)="        Key Pair you can skip this step. You can check whether you already"
^XPD(9.6,13570,1,102,0)="        have an existing SSH Key Pair through the 'V' (View Public SSH "
^XPD(9.6,13570,1,103,0)="Key)"
^XPD(9.6,13570,1,104,0)="        Action."
^XPD(9.6,13570,1,105,0)=" "
^XPD(9.6,13570,1,106,0)="        Encryption Type: DSA, RSA, ECDSA or EDDSA?"
^XPD(9.6,13570,1,107,0)="        -----------------------------------"
^XPD(9.6,13570,1,108,0)="        Digital Signature Algorithm (DSA) (No longer supported) and "
^XPD(9.6,13570,1,109,0)="Rivest,"
^XPD(9.6,13570,1,110,0)="        Shamir & Adleman (RSA) have been two of the most common encryption"
^XPD(9.6,13570,1,111,0)="        algorithms used by the IT industry for securely sharing data. "
^XPD(9.6,13570,1,112,0)="        Elliptic Curve Digital Signature Algorithm (ECDSA) and "
^XPD(9.6,13570,1,113,0)="Edward-curve"
^XPD(9.6,13570,1,114,0)="        Digital Signature Algorithm (ed25519) are more complex public key"
^XPD(9.6,13570,1,115,0)="        cryptography encryption algorithms that are now supported by the "
^XPD(9.6,13570,1,116,0)="VA."
^XPD(9.6,13570,1,117,0)="        Many of SPMP servers can handle all types; however there are "
^XPD(9.6,13570,1,118,0)="vendors"
^XPD(9.6,13570,1,119,0)="        that accept only one specific type. You will need to contact the "
^XPD(9.6,13570,1,120,0)="SPMP"
^XPD(9.6,13570,1,121,0)="        vendor support to determine which type to select."
^XPD(9.6,13570,1,122,0)=" "
^XPD(9.6,13570,1,123,0)="Step 2: Share the Public SSH Key content with the state/vendor. In order "
^XPD(9.6,13570,1,124,0)="to"
^XPD(9.6,13570,1,125,0)="        successfully establish SPMP transmissions the state/vendor will "
^XPD(9.6,13570,1,126,0)="have"
^XPD(9.6,13570,1,127,0)="        to install/configure the new SSH Key created in step 1 for the"
^XPD(9.6,13570,1,128,0)="        user id they assigned to your site. Use the 'V' (View Public SSH "
^XPD(9.6,13570,1,129,0)="Key)"
^XPD(9.6,13570,1,130,0)="        Action to retrieve the content of the Public SSH key. The Public "
^XPD(9.6,13570,1,131,0)="SSH"
^XPD(9.6,13570,1,132,0)="        Key should not contain line-feed characters, therefore after you "
^XPD(9.6,13570,1,133,0)="copy"
^XPD(9.6,13570,1,134,0)="        & paste it from the terminal emulator into an email or text editor"
^XPD(9.6,13570,1,135,0)="        make sure it contains only one line of text (no wrapping)."
