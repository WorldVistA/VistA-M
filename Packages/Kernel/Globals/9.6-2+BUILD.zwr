^XPD(9.6,14023,1,1,0)="--------------------------------------------------------------------- "
^XPD(9.6,14023,1,2,0)="POP-10707 4.2A: Add Baseline Standard Version to View/Edit ASAP"
^XPD(9.6,14023,1,3,0)="Definitions Option"
^XPD(9.6,14023,1,4,0)="-----------------------------------------------------------------------"
^XPD(9.6,14023,1,5,0)=" "
^XPD(9.6,14023,1,6,0)="DDs/Data"
^XPD(9.6,14023,1,7,0)="---------"
^XPD(9.6,14023,1,8,0)="no DD modifications but an additional entry at the VER multiple (58.4001) "
^XPD(9.6,14023,1,9,0)="stored at the 1 subscript (for the Baseline or STANDARD definition) e.g.,"
^XPD(9.6,14023,1,10,0)="^PS(58.4,1,0)=""STANDARD ASAP DEFINITION"""
^XPD(9.6,14023,1,11,0)="^PS(58.4,1,""VER"",0)=""^58.4001^n^n"""
^XPD(9.6,14023,1,12,0)="^PS(58.4,1,""VER"",+1,0)=""4.2A"""
^XPD(9.6,14023,1,13,0)=" "
^XPD(9.6,14023,1,14,0)="Routines"
^XPD(9.6,14023,1,15,0)="--------"
^XPD(9.6,14023,1,16,0)="PSOASAP"
^XPD(9.6,14023,1,17,0)="PSOASAP0 "
^XPD(9.6,14023,1,18,0)="PSOASAP1"
^XPD(9.6,14023,1,19,0)=" "
^XPD(9.6,14023,1,20,0)="Post-Install routine that adds the 4.2A Standard version to ""VER"" subfile"
^XPD(9.6,14023,1,21,0)="(#58.4001) of the SPMP ASAP RECORD DEFINITION file (#58.4)."
^XPD(9.6,14023,1,22,0)=" "
^XPD(9.6,14023,1,23,0)="------------------------------------------------------------------------"
^XPD(9.6,14023,1,24,0)="POP-10722 SPMP 4.2A: Add new Zero Report to View/Edit ASAP Definitions "
^XPD(9.6,14023,1,25,0)="Option"
^XPD(9.6,14023,1,26,0)="-----------------------------------------------------------------------"
