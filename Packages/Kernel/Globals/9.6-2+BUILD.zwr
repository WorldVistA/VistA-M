^XPD(9.6,13460,1,2,0)="============================================="
^XPD(9.6,13460,1,3,0)=" "
^XPD(9.6,13460,1,4,0)="Jira Tickets:"
^XPD(9.6,13460,1,5,0)="============="
^XPD(9.6,13460,1,6,0)="VSE-5545: DS - VistA: Modify SDES GET CLINIC INFO2 and SDES GET CLINICS "
^XPD(9.6,13460,1,7,0)="          BY CLIN LIST to return clinic status"
^XPD(9.6,13460,1,8,0)="VSE-5770: BB - VistA: Do not allow the PID to be edited in VistA and VSE "
^XPD(9.6,13460,1,9,0)="          GUI for a consult or procedure"
^XPD(9.6,13460,1,10,0)="VSE-5792: AP - VistA: Modify SDES GET PATIENT REGISTRATION2 to return "
^XPD(9.6,13460,1,11,0)="          eligibility codes"
^XPD(9.6,13460,1,12,0)=" "
^XPD(9.6,13460,1,13,0)=" "
^XPD(9.6,13460,1,14,0)="VSE Increment 8.7 - SD_5_3_851 - GUI v 1.7.45"
^XPD(9.6,13460,1,15,0)="============================================="
^XPD(9.6,13460,1,16,0)="VSE-5565: TB - VistA: Modify SDES GET APPT REQ RPCs to return PID CHANGE "
^XPD(9.6,13460,1,17,0)="          ALLOWED (#49) field value"
^XPD(9.6,13460,1,18,0)="VSE-5670: BF - VistA: Modify SDES SEARCH CLINIC ATTRIBUTES to return "
^XPD(9.6,13460,1,19,0)="          clinic abbreviation and array of provider names"
^XPD(9.6,13460,1,20,0)="VSE-5736: TB - Update SDES SEARCH CLINIC to return correct Resource Status"
^XPD(9.6,13460,1,21,0)="VSE-5775: AP - VistA: Modify VistA open Veteran requests report to remove"
^XPD(9.6,13460,1,22,0)="          Patient Comments column"
^XPD(9.6,13460,1,23,0)="VSE-5818: BB - VistA: Update the slot logic within SDES CANCEL "
^XPD(9.6,13460,1,24,0)="          APPOINTMENT 2 and SDES CREATE APPOINTMENTS RPCs"
^XPD(9.6,13460,1,25,0)="VSE-5896: JS - VistA: SDES GET APPTS BY PATIENT DFN3 is giving errors"
^XPD(9.6,13460,1,26,0)="VSE-5941: BF - VistA: Contact attempts are being returned for incorrect "
^XPD(9.6,13460,1,27,0)="          appointment request"
