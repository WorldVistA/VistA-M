^XPD(9.6,13847,1,1,0)="Updates to MHA Functionality."
^XPD(9.6,13847,1,2,0)="Update for User Preference Parameters to validate Last Assignment."
^XPD(9.6,13847,1,3,0)="Update MH REPORT to have new message if restricted instrument."
^XPD(9.6,13847,1,4,0)="Update Instrument Exchange to handle Orlando progress note titles of"
^XPD(9.6,13847,1,5,0)="MH DIAGNOSTIC STUDY NOTE and MH CONSULT NOTE"
^XPD(9.6,13847,1,6,0)="Update BOMC report."
^XPD(9.6,13847,1,7,0)="Update PSS-3-2ND report."
^XPD(9.6,13847,1,8,0)="Fix EAT-26 scoring for zero height."
^XPD(9.6,13847,1,9,0)="Fix CCSA-DSM5 skipped question error in scoring."
^XPD(9.6,13847,1,10,0)="Fix YMRS response item number."
^XPD(9.6,13847,1,11,0)=" "
^XPD(9.6,13847,1,12,0)="Add AAQ-II-7"
^XPD(9.6,13847,1,13,0)="Add ALSFRS-R"
^XPD(9.6,13847,1,14,0)="Add ALSSQOL-SF"
^XPD(9.6,13847,1,15,0)="Reactivate BBHI-2"
^XPD(9.6,13847,1,16,0)=" "
^XPD(9.6,13847,1,17,0)="Add Parameter YS MHA LOG APPLICATION ERRORS to control error trapping for"
^XPD(9.6,13847,1,18,0)="administrations.  It is implemented turned off by default, deactivating "
^XPD(9.6,13847,1,19,0)="error trapping for administration double click errors. Double clicking is "
^XPD(9.6,13847,1,20,0)="deactivated in the web application itself."
