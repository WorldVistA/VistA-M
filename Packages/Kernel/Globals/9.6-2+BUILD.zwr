^XPD(9.6,13466,0)="PSD*3.0*93^83^0^3230608^y"
^XPD(9.6,13466,1,0)="^^6^6^3230531^^"
^XPD(9.6,13466,1,1,0)="This patch will fix the following issue:"
^XPD(9.6,13466,1,2,0)=" "
^XPD(9.6,13466,1,3,0)="An issue was reported that when using the VistA option Outpatient Rx's "
^XPD(9.6,13466,1,4,0)="[PSD OUTPATIENT] to sign out a controlled substance after a refill was "
^XPD(9.6,13466,1,5,0)="previously returned to stock, a user is presented with the opportunity to "
^XPD(9.6,13466,1,6,0)="sign out the original fill even though it had previously been signed out."
^XPD(9.6,13466,4,0)="^9.64PA^^"
