^XPD(9.6,14183,1,0)="^^65^65^3260305^"
^XPD(9.6,14183,1,1,0)=" "
^XPD(9.6,14183,1,2,0)="PI 14.4 10/30-11/12 - SD*5.3*929"
^XPD(9.6,14183,1,3,0)="================================"
^XPD(9.6,14183,1,4,0)=" "
^XPD(9.6,14183,1,5,0)="Tickets:"
^XPD(9.6,14183,1,6,0)="========"
^XPD(9.6,14183,1,7,0)="VSE-11035: LB - VistA: Modify SDES2 DISPOSITION APPT REQ and SDES2 CANCEL "
^XPD(9.6,14183,1,8,0)="                APPOINTMENT to remove the child request from the parent on"
^XPD(9.6,14183,1,9,0)="                MRTC requests."
^XPD(9.6,14183,1,10,0)="VSE-11401: JJ - VistA: Modify SDES2 BLOCK AND MOVE to correctly identify"
^XPD(9.6,14183,1,11,0)="                MRTC requests"
^XPD(9.6,14183,1,12,0)="VSE-11409: RN - VistA: Modify SDES2 GET APPTS BY CLINIC LIST to add the "
^XPD(9.6,14183,1,13,0)="                Preferred Name to the return output"
^XPD(9.6,14183,1,14,0)="VSE-11434: MB - VistA: When a childs station number is sent in alone, the"
^XPD(9.6,14183,1,15,0)="                RPC is not returning back the clinics"
^XPD(9.6,14183,1,16,0)="VSE-11455: BB - VistA: Create a post install to identify slot counts that"
^XPD(9.6,14183,1,17,0)="                are not correct for a subset of clinics"
^XPD(9.6,14183,1,18,0)="VSE-11437: RN - VistA: Modify the SDES2 GET APPT(s) RPCs to send only"
^XPD(9.6,14183,1,19,0)="                active local and active national flags"
^XPD(9.6,14183,1,20,0)="VSE-10898: LB - VistA: Create a MRTC Clean up utility to rebuild "
^XPD(9.6,14183,1,21,0)="                corrupted parent requests."
^XPD(9.6,14183,1,22,0)="VSE-11571: LB - VistA: Modify SDES2 NO-SHOW to remove appointment "
^XPD(9.6,14183,1,23,0)="                information and SDES2 UNDO NO-SHOW to re-add appointment"
^XPD(9.6,14183,1,24,0)="                information"
^XPD(9.6,14183,1,25,0)=" "
^XPD(9.6,14183,1,26,0)=" "
