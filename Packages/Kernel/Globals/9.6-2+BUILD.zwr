^XPD(9.6,13710,0)="PSO*7.0*754^60^0^3240222^y"
^XPD(9.6,13710,1,0)="^^68^68^3240222^"
^XPD(9.6,13710,1,1,0)="This patch addresses the following issue:"
^XPD(9.6,13710,1,2,0)=" "
^XPD(9.6,13710,1,3,0)="ISSUE WITH COPYING A LIMITED DURATION ORDER"
^XPD(9.6,13710,1,4,0)=" "
^XPD(9.6,13710,1,5,0)=" "
^XPD(9.6,13710,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13710,1,7,0)=" "
^XPD(9.6,13710,1,8,0)="1.      INC31444921 - ISSUE WITH COPYING A LIMITED DURATION ORDER"
^XPD(9.6,13710,1,9,0)=" "
^XPD(9.6,13710,1,10,0)=" "
^XPD(9.6,13710,1,11,0)="Problem:"
^XPD(9.6,13710,1,12,0)="--------"
^XPD(9.6,13710,1,13,0)="When copying a titration order, at the duration prompt, which was 2W "
^XPD(9.6,13710,1,14,0)="(2weeks). It did not honor the defaults. It kept on repeating no more "
^XPD(9.6,13710,1,15,0)="than 2 days. And the user is stuck on the Limited Duration prompt."
^XPD(9.6,13710,1,16,0)=" "
^XPD(9.6,13710,1,17,0)="The problem was found to be due to code from patch PSO*7*457, which was "
^XPD(9.6,13710,1,18,0)="part of a clozapine enhancement that is no longer valid and was only "
^XPD(9.6,13710,1,19,0)="meant for a clozapine order.  Patch PSO*7*574 added logic that skips the "
^XPD(9.6,13710,1,20,0)="logic added by PSO*7*457, unfortunately, it causes problems when copying "
^XPD(9.6,13710,1,21,0)="an order defined with a limited duration."
^XPD(9.6,13710,1,22,0)=" "
^XPD(9.6,13710,1,23,0)="Resolution:"
^XPD(9.6,13710,1,24,0)="-----------"
^XPD(9.6,13710,1,25,0)="The resolution is to comment out the logic from PSO*7*457 in DUR^PSOORED5."
^XPD(9.6,13710,1,26,0)=" "
^XPD(9.6,13710,1,27,0)=" "
^XPD(9.6,13710,1,28,0)="Technical Resolution:"
^XPD(9.6,13710,1,29,0)="---------------------"
^XPD(9.6,13710,1,30,0)="The code found at line DUR+8^PSOORED5 through line DUR+17^PSOORED5 is "
^XPD(9.6,13710,1,31,0)="commented out."
^XPD(9.6,13710,1,32,0)=" "
^XPD(9.6,13710,1,33,0)="The code is changed from:"
^XPD(9.6,13710,1,34,0)=" "
^XPD(9.6,13710,1,35,0)=" "
^XPD(9.6,13710,1,36,0)=";/RBN Begin modification for #326 ;/MZR Added a message and correct "
^XPD(9.6,13710,1,37,0)="checking for Hours/Minutes"
^XPD(9.6,13710,1,38,0)=" I $G(DIR(""B""))!$G(PSORXED(""DURATION"",ENT)) N Z,MAX D  I Z>MAX S "
^XPD(9.6,13710,1,39,0)="PSORXED(""DURATION"",$G(PSORXED(""ENT"")))=MAX G DUR"
^XPD(9.6,13710,1,40,0)=" .I X=+X S Z=X"
^XPD(9.6,13710,1,41,0)=" .E  S "
^XPD(9.6,13710,1,42,0)="Z=$E(X,$L(X)),Z=$S(Z=""L"":30*X,Z=""W"":7*X,Z=""H"":X/24,Z=""M"":X/1440,1:+X)"
^XPD(9.6,13710,1,43,0)=" .S MAX=$S($G(DIR(""B"")):+DIR(""B""),1:$G(PSORXED(""DURATION"",ENT)))"
^XPD(9.6,13710,1,44,0)=" .I Z>MAX D"
^XPD(9.6,13710,1,45,0)=" ..W "" "
^XPD(9.6,13710,1,46,0)="(""_$S(X[""L"":""MONTHS"",X[""W"":""WEEKS"",X[""H"":""HOURS"",X[""M"":""MINUTES"",1:""DAYS"")"
^XPD(9.6,13710,1,47,0)="_"")"""
^XPD(9.6,13710,1,48,0)=" ..W !,""NOT MORE THAN "",MAX,"" DAYS"""
^XPD(9.6,13710,1,49,0)=" ;; END NCC REMEDIATION << 457*RJS"
^XPD(9.6,13710,1,50,0)=" "
^XPD(9.6,13710,1,51,0)="To:"
^XPD(9.6,13710,1,52,0)=" "
^XPD(9.6,13710,1,53,0)=" ;PSO*7*754 comment out code added with PSO*7*457"
^XPD(9.6,13710,1,54,0)=" ;; START NCC REMEDIATION >> 457*RJS - ADJUST FOR 4 DAY SUPPLY"
^XPD(9.6,13710,1,55,0)=" ;/RBN Begin modification for #326 ;/MZR Added a message and correct "
^XPD(9.6,13710,1,56,0)="checking for Hours/Minutes"
^XPD(9.6,13710,1,57,0)=" ;I $G(DIR(""B""))!$G(PSORXED(""DURATION"",ENT)) N Z,MAX D I Z>MAX S "
^XPD(9.6,13710,1,58,0)="PSORXED(""DURATION"",$G(PSORXED(""ENT"")))=MAX G DUR"
^XPD(9.6,13710,1,59,0)=" ;.I X=+X S Z=X"
^XPD(9.6,13710,1,60,0)=" ;.E S "
^XPD(9.6,13710,1,61,0)="Z=$E(X,$L(X)),Z=$S(Z=""L"":30*X,Z=""W"":7*X,Z=""H"":X/24,Z=""M"":X/1440,1:+X)"
^XPD(9.6,13710,1,62,0)=" ;.S MAX=$S($G(DIR(""B"")):+DIR(""B""),1:$G(PSORXED(""DURATION"",ENT)))"
^XPD(9.6,13710,1,63,0)=" ;.I Z>MAX D"
^XPD(9.6,13710,1,64,0)=" ;..W "" "
^XPD(9.6,13710,1,65,0)="(""_$S(X[""L"":""MONTHS"",X[""W"":""WEEKS"",X[""H"":""HOURS"",X[""M"":""MINUTES"",1:""DAYS"")"
^XPD(9.6,13710,1,66,0)="_"")"""
^XPD(9.6,13710,1,67,0)=" ;..W !,""NOT MORE THAN "",MAX,"" DAYS"""
^XPD(9.6,13710,1,68,0)=" ;; END NCC REMEDIATION << 457*RJS"
^XPD(9.6,13710,4,0)="^9.64PA^^"
^XPD(9.6,13710,6)="^625"
^XPD(9.6,13710,6.3)=1
