^XPD(9.6,13720,1,1,0)="This patch addresses the following issue:"
^XPD(9.6,13720,1,2,0)=" "
^XPD(9.6,13720,1,3,0)="ECDSA/EDDSA Key creation"
^XPD(9.6,13720,1,4,0)=" "
^XPD(9.6,13720,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13720,1,6,0)=" "
^XPD(9.6,13720,1,7,0)="1.      INC26749697 - ECDSA KEY CREATION"
^XPD(9.6,13720,1,8,0)=" "
