^XPD(9.6,14102,1,2,0)="========================="
^XPD(9.6,14102,1,3,0)="1) TMP-2084: Allow a user to search for Clinics to include in the Advanced"
^XPD(9.6,14102,1,4,0)="             Clinic Search report."
^XPD(9.6,14102,1,5,0)=" "
^XPD(9.6,14102,1,6,0)="2) TMP-3560: Provide the Advanced Clinic Search report in the Telehealth "
^XPD(9.6,14102,1,7,0)="             Management Toolbox"
^XPD(9.6,14102,1,8,0)=" "
^XPD(9.6,14102,1,9,0)="3) TMP-3613: Updates to Advanced Clinic Search"
^XPD(9.6,14102,1,10,0)=" "
^XPD(9.6,14102,1,11,0)="4) TMP-3668: Add total number of results in the Advanced Clinic Search"
^XPD(9.6,14102,1,12,0)="             report"
^XPD(9.6,14102,1,13,0)=" "
^XPD(9.6,14102,1,14,0)="5) TMP-3669: Add a legend in the Advanced Clinic Search report"
^XPD(9.6,14102,1,15,0)=" "
^XPD(9.6,14102,1,16,0)="6) TMP-3670: Display indicator in the Advanced Clinic Search report if"
^XPD(9.6,14102,1,17,0)="             clinics are available in patient facing apps"
^XPD(9.6,14102,1,18,0)=" "
^XPD(9.6,14102,1,19,0)="7) TMP-3672: Stop Code search updates in the Advanced Clinic Search"
^XPD(9.6,14102,1,20,0)=" "
^XPD(9.6,14102,1,21,0)="8) TMP-3676: Correctly derive institution and Station"
^XPD(9.6,14102,1,22,0)=" "
^XPD(9.6,14102,1,23,0)="9) TMP-3027: Search for Appointment Requests using ICN instead of DFN"
