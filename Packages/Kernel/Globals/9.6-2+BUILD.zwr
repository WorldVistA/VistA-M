^XPD(9.6,13897,0)="EDP*2.0*31^212^0^3250116^y"
^XPD(9.6,13897,1,0)="^^46^46^3250116^"
^XPD(9.6,13897,1,1,0)="This patch is one part of a GUI patch that contains fixes for the issues "
^XPD(9.6,13897,1,2,0)="listed below:"
^XPD(9.6,13897,1,3,0)=" "
^XPD(9.6,13897,1,4,0)=" "
^XPD(9.6,13897,1,5,0)=" "
^XPD(9.6,13897,1,6,0)="1. INC36508590: Patient stuck in a hidden room in EDIS. "
^XPD(9.6,13897,1,7,0)=" "
^XPD(9.6,13897,1,8,0)="Problem:"
^XPD(9.6,13897,1,9,0)="--------"
^XPD(9.6,13897,1,10,0)="When a Room/Bed is marked as never display any patient assigned to that"
^XPD(9.6,13897,1,11,0)="Room or Bed will disappear from the CPE board. This occurs because the "
^XPD(9.6,13897,1,12,0)="drop down boxes that Rooms/Beds can be selected from still included those "
^XPD(9.6,13897,1,13,0)="that are marked to not be displayed on the board. Once this happens the "
^XPD(9.6,13897,1,14,0)="only way to find the patient is to move their location in VistA or mark "
^XPD(9.6,13897,1,15,0)="the Room/Bed as visible on the Board through the configuration page."
^XPD(9.6,13897,1,16,0)=" "
^XPD(9.6,13897,1,17,0)="Resolution:"
^XPD(9.6,13897,1,18,0)="-----------"
^XPD(9.6,13897,1,19,0)="Added a check to exclude Rooms/Beds from the Room/Bed selection drop "
^XPD(9.6,13897,1,20,0)="down when the field ""DISPLAY WHEN"" (FILE #231.8 FIELD .07) is set as"
^XPD(9.6,13897,1,21,0)="""Never"". "
^XPD(9.6,13897,1,22,0)=" "
^XPD(9.6,13897,1,23,0)="2. INC33193019: Delay Summary Report Changes. "
^XPD(9.6,13897,1,24,0)=" "
^XPD(9.6,13897,1,25,0)="Problem:"
^XPD(9.6,13897,1,26,0)="--------"
^XPD(9.6,13897,1,27,0)="On the ""Delay Summary Report"" in the reports tab there are several "
^XPD(9.6,13897,1,28,0)="changes the business required to be made for certain metrics and layout. "
^XPD(9.6,13897,1,29,0)="First the headers needed to be more defined so users can distinguish "
^XPD(9.6,13897,1,30,0)="between the various data types. Second various metrics have had their "
^XPD(9.6,13897,1,31,0)="time values adjusted."
^XPD(9.6,13897,1,32,0)=" "
^XPD(9.6,13897,1,33,0)="Resolution:"
^XPD(9.6,13897,1,34,0)="-----------"
^XPD(9.6,13897,1,35,0)="Added underlining to the headers for ""All ED Visits"", ""VA Admitted"", and "
^XPD(9.6,13897,1,36,0)="""Not VA Admitted"". Changed the labels on the JAVA GUI and data values for "
^XPD(9.6,13897,1,37,0)="the following:"
^XPD(9.6,13897,1,38,0)=" "
^XPD(9.6,13897,1,39,0)="All ED Visits:"
^XPD(9.6,13897,1,40,0)="""Total Visits Over Six Hours"" to ""Total Visits Over 240 Minutes"""
^XPD(9.6,13897,1,41,0)=" "
^XPD(9.6,13897,1,42,0)="VA Admitted:"
^XPD(9.6,13897,1,43,0)="""Total Visits Over Six Hours"" to ""Total Visits Over 360 Minutes"""
^XPD(9.6,13897,1,44,0)="""Average Delay Time"" to ""Average Admit Delay Time"""
^XPD(9.6,13897,1,45,0)="""Number of Admit Delays Over Six Hours"" to ""Number of Admit Delays Over "
^XPD(9.6,13897,1,46,0)="150 Minutes"""
^XPD(9.6,13897,4,0)="^9.64PA^^"
^XPD(9.6,13897,6)="^25"
^XPD(9.6,13897,6.3)=4
