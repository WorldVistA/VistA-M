^XPD(9.6,13696,0)="PSO*7.0*755^60^0^3240405^y"
^XPD(9.6,13696,1,0)="^^35^35^3240405^"
^XPD(9.6,13696,1,1,0)="This patch addresses the following incident ticket:"
^XPD(9.6,13696,1,2,0)=" "
^XPD(9.6,13696,1,3,0)="INC24400778 - Missing DEA number in Order DEA Archive the ORDER DEA "
^XPD(9.6,13696,1,4,0)="ARCHIVE file (#101.52)."
^XPD(9.6,13696,1,5,0)=" "
^XPD(9.6,13696,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13696,1,7,0)="--------------------------------------------"
^XPD(9.6,13696,1,8,0)="INC24400778 - Missing DEA number in Order DEA Archive File #101.52."
^XPD(9.6,13696,1,9,0)=" "
^XPD(9.6,13696,1,10,0)=" "
^XPD(9.6,13696,1,11,0)="Problem(s):"
^XPD(9.6,13696,1,12,0)="-----------"
^XPD(9.6,13696,1,13,0)="For eRx prescriptions, the ORDER DEA ARCHIVE file (#101.52) DEA # field "
^XPD(9.6,13696,1,14,0)="(#10) is missing. When an eRx order is accepted in the eRx Holding "
^XPD(9.6,13696,1,15,0)="Queue, the DEA # is not populated when sending the data to file "
^XPD(9.6,13696,1,16,0)="(#101.52). The logic currently does not populate the DEA # when the"
^XPD(9.6,13696,1,17,0)="Provider's expiration date is the same date as the eRx prescription's"
^XPD(9.6,13696,1,18,0)="written date.  "
^XPD(9.6,13696,1,19,0)=" "
^XPD(9.6,13696,1,20,0)=" "
^XPD(9.6,13696,1,21,0)="Resolution:"
^XPD(9.6,13696,1,22,0)="-----------"
^XPD(9.6,13696,1,23,0)="This will need to be addressed with changes to Outpatient Pharmacy code"
^XPD(9.6,13696,1,24,0)="routine PSOHLSNC is modified to send the DEA# in the RXE segment piece 14,"
^XPD(9.6,13696,1,25,0)="which is already mapped on the CPRS side (according to the ORDEA Routine)."
^XPD(9.6,13696,1,26,0)=" "
^XPD(9.6,13696,1,27,0)=" "
^XPD(9.6,13696,1,28,0)="Technical Resolution:"
^XPD(9.6,13696,1,29,0)="---------------------"
^XPD(9.6,13696,1,30,0)="Routine PSOHLSNC is modified starting at RXE tag line 12:"
^XPD(9.6,13696,1,31,0)=" "
^XPD(9.6,13696,1,32,0)="New logic added:"
^XPD(9.6,13696,1,33,0)=" I $$GET1^DIQ(52.49,PSOIEN,95.1,""I""),$$CS^PSOERXA0(PSOHNDD) D"
^XPD(9.6,13696,1,34,0)=" . S PSOWRDT=$$GET1^DIQ(52.49,PSOIEN,5.9,""I"") S "
^XPD(9.6,13696,1,35,0)="PSOXFLD(13)=$P($$DEA^XUSER(0,PSOHPRO,PSOWRDT),""-"",1)"
^XPD(9.6,13696,4,0)="^9.64PA^^"
^XPD(9.6,13696,6)="^624"
^XPD(9.6,13696,6.3)=4
