^XPD(9.6,13516,1,1,0)="VSE Increment 8.10 - SD*5.3*860 - GUI v 1.7.48"
^XPD(9.6,13516,1,2,0)="----------------------------------------------"
^XPD(9.6,13516,1,3,0)=" "
^XPD(9.6,13516,1,4,0)="Jira Tickets:"
^XPD(9.6,13516,1,5,0)="============="
^XPD(9.6,13516,1,6,0)="VSE-5537: AP - VistA: Post-install to update null e-checkin allowed and "
^XPD(9.6,13516,1,7,0)="          pre-checkin allowed to ""No""."
^XPD(9.6,13516,1,8,0)="VSE-5620: LB - VistA: Create new versions of SDES CONTACT ADD/UPDATE and "
^XPD(9.6,13516,1,9,0)="          SDES CONTACT DISPLAY RPCs to include a context/metadata array as"
^XPD(9.6,13516,1,10,0)="          the first input parameter."
^XPD(9.6,13516,1,11,0)="VSE-6013: BB - VistA: Modify SDES GET CLINIC ORIGINAL AVAIL to correct "
^XPD(9.6,13516,1,12,0)="          defects."
^XPD(9.6,13516,1,13,0)="VSE-6060: DS - VistA: Modify the description for SDES SEARCH CLINIC "
^XPD(9.6,13516,1,14,0)="          ATTRIBUTES."
^XPD(9.6,13516,1,15,0)="VSE-6061: BF - VistA: Return Request Type in the SDES GET APPT */SDES GET "
^XPD(9.6,13516,1,16,0)="          APPTS * RPCs."
^XPD(9.6,13516,1,17,0)="VSE-6147: AP - VistA: Inactive stop codes can be sent into SDES EDIT "
^XPD(9.6,13516,1,18,0)="          CLINIC and SDES CREATE CLINIC RPCs."
^XPD(9.6,13516,1,19,0)="VSE-6177: BF - VistA: Update SDES2 GET HOLIDAYS RPC definition."
^XPD(9.6,13516,1,20,0)="VSE-6219: MD - VistA: Modify RPC definition in File #8994 for SDES2 "
^XPD(9.6,13516,1,21,0)="          CREATE CLINIC."
^XPD(9.6,13516,1,22,0)="VSE-6220: BF - VistA: Modify RPC definition in file #8994 for SDES2 EDIT "
^XPD(9.6,13516,1,23,0)="          CLINIC RPC."
^XPD(9.6,13516,1,24,0)="VSE-6305: MD - Fix bug in the SDES2 CREATE CLINIC filing logic for the "
^XPD(9.6,13516,1,25,0)="          multiple fields."
^XPD(9.6,13516,1,26,0)=" "
