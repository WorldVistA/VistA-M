^XPD(9.6,13588,1,0)="^^134^134^3240101^"
^XPD(9.6,13588,1,1,0)="VSE Increment 8.13 - SD*5.3*862 - GUI v 1.7.50"
^XPD(9.6,13588,1,2,0)="----------------------------------------------"
^XPD(9.6,13588,1,3,0)=" "
^XPD(9.6,13588,1,4,0)="Jira Tickets"
^XPD(9.6,13588,1,5,0)="============"
^XPD(9.6,13588,1,6,0)="VSE-6204: TB - VistA: Rewrite SDES INACTIVATE/ZZ CLINIC to add a cancel "
^XPD(9.6,13588,1,7,0)="          date in the SDES2 namespace"
^XPD(9.6,13588,1,8,0)="VSE-6280: LB - VistA: Fix issue where CA do not display in RM Grid for "
^XPD(9.6,13588,1,9,0)="          cancelled appointments"
^XPD(9.6,13588,1,10,0)="VSE-6310: AP - VistA: Refactor SDES PATIENT SEARCH RPC in the SDES2 "
^XPD(9.6,13588,1,11,0)="          namespace"
^XPD(9.6,13588,1,12,0)="VSE-6316: VS GUI: Select patient from patient search should not open "
^XPD(9.6,13588,1,13,0)="          multiple dialogs if the user multi clicks"
^XPD(9.6,13588,1,14,0)="VSE-6317: DR - VistA: Update SCMSVUT3 to account for new Agent Orange "
^XPD(9.6,13588,1,15,0)="          exposure locales"
^XPD(9.6,13588,1,16,0)="VSE-6329: TB - VistA: Create a new RPC to return active appointment types "
^XPD(9.6,13588,1,17,0)="          for a selected patient"
^XPD(9.6,13588,1,18,0)="VSE-6335: BB - VistA: SDESCANAPPT2 throws an error when using cancel "
^XPD(9.6,13588,1,19,0)="          reasons that don't reopen the request"
^XPD(9.6,13588,1,20,0)="VSE-6343: AP - VistA: Modify Appointment Object to return Last 4 SSN, "
^XPD(9.6,13588,1,21,0)="          DOB, and Date of Death"
^XPD(9.6,13588,1,22,0)="VSE-6351: JW - VistA: Return the VVC STOP CODE values from SDEC SETTINGS"
^XPD(9.6,13588,1,23,0)="VSE-6365: MD - VistA: Default Priority to ASAP in SDES CREATE APPT REQ."
^XPD(9.6,13588,1,24,0)="VSE-6372: TB - VistA: Modify SDES GET APPTYPES to return only Active "
^XPD(9.6,13588,1,25,0)="          appointment types"
^XPD(9.6,13588,1,26,0)="VSE-6571: LB - Invalid Error Message displaying if the date/time is "
^XPD(9.6,13588,1,27,0)="          missing during Cancel Restore"
^XPD(9.6,13588,1,28,0)="VSE-6584: TB - Modify SDES2 REACTIVATE CLINIC"
^XPD(9.6,13588,1,29,0)="VSE-6614: BB - VistA: Modify SDES CREATE CLIN AVAILABILITY and SDES EDIT "
^XPD(9.6,13588,1,30,0)=" "
^XPD(9.6,13588,1,31,0)=" "
^XPD(9.6,13588,1,32,0)="VSE Increment 8.14 - SD_5_3_864 - GUI v 1.7.51"
^XPD(9.6,13588,1,33,0)="=============================================="
^XPD(9.6,13588,1,34,0)=" "
^XPD(9.6,13588,1,35,0)="Jira Tickets:"
^XPD(9.6,13588,1,36,0)="============="
^XPD(9.6,13588,1,37,0)="VSE-6208: BB - VistA - Updating Special Needs and Preferences is saving "
^XPD(9.6,13588,1,38,0)="          the proxy user instead of the original requestor"
^XPD(9.6,13588,1,39,0)="VSE-6386: MD - VistA - Correct issue where SDES GET CLIN AVAILABILITY "
^XPD(9.6,13588,1,40,0)="          does not return a time zone offset"
^XPD(9.6,13588,1,41,0)="VSE-6399: DS - VistA - Modify SDES CREATE CLINIC and SDES EDIT CLINIC to "
^XPD(9.6,13588,1,42,0)="          specify which stop code is inactive"
^XPD(9.6,13588,1,43,0)="VSE-6405: JS - VistA - Modify SDES GET CLINIC INFO2 to return Provider "
^XPD(9.6,13588,1,44,0)="          IEN as an output object"
^XPD(9.6,13588,1,45,0)="VSE-6421: BF - VistA - Modify documentation for SDES DISPOSITION APPT REQ "
^XPD(9.6,13588,1,46,0)="          to update DISPBY to the User IEN"
^XPD(9.6,13588,1,47,0)="VSE-6424: TB - VistA - Rewrite SDES CREATE LAST SELECTED PAT in the SDES2 "
^XPD(9.6,13588,1,48,0)="          namespace"
^XPD(9.6,13588,1,49,0)="VSE-6425: LB VistA - Modify SDES CREATE APPOINTMENTS to pull PID from the "
^XPD(9.6,13588,1,50,0)="          request if there is no PID sent in"
^XPD(9.6,13588,1,51,0)="VSE-6428: AP - VistA - Modify SDES CANCEL APPOINTMENT 2 to store ""O"" not "
^XPD(9.6,13588,1,52,0)="          ""OPEN"""
^XPD(9.6,13588,1,53,0)="VSE-6429: AP - VistA - Modify SDES UNDO NOSHOW to update the status with "
^XPD(9.6,13588,1,54,0)="          ""C"" for Closed"
^XPD(9.6,13588,1,55,0)="VSE-6435: AP - VistA - Modify SDES NOSHOW to store ""O"" instead of OPEN"
^XPD(9.6,13588,1,56,0)="VSE-6438: LB - VistA - The SDCANCEL option needs to be modified to "
^XPD(9.6,13588,1,57,0)="          prevent the ""ST"" record from being created when user erroneously"
^XPD(9.6,13588,1,58,0)="          enters a date that is not defined in the availability."
^XPD(9.6,13588,1,59,0)="VSE-6443: JS - Modify the GETDPROIEN Tag of SDECVVS to pull the default "
^XPD(9.6,13588,1,60,0)="          provider from provider multiple of the HOSPITAL LOCATION."
^XPD(9.6,13588,1,61,0)="VSE-6509: TB - VistA: Create a new RPC to get recall disposition"
^XPD(9.6,13588,1,62,0)="          reasons from 403.56 "
^XPD(9.6,13588,1,63,0)="VSE-6608: LB - VistA: Modify Wait Time Standard calculations "
