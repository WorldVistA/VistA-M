^XPD(9.6,14021,1,0)="^9.61A^7^7^3250409^^"
^XPD(9.6,14021,1,1,0)="When an attempt to assign an NPI to a Non/Other VA Provider using the "
^XPD(9.6,14021,1,2,0)="IBCE PROVIDER MAINT option. And a previous record in the Institution File "
^XPD(9.6,14021,1,3,0)="#4 used the NPI has no effective date yet retains the ""ANPI"" cross"
^XPD(9.6,14021,1,4,0)="reference in file four, an incorrect error is presented and the user is "
^XPD(9.6,14021,1,5,0)="not allowed to assign the NPI again. This remediation now checks for an "
^XPD(9.6,14021,1,6,0)="effective date before allowing the message to present and denial of "
^XPD(9.6,14021,1,7,0)="re-assignment of the NPI."
^XPD(9.6,14021,4,0)="^9.64PA^^"
