^XPD(9.6,13684,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13684,1,2,0)=" "
^XPD(9.6,13684,1,3,0)="1.      INC28842900 - <SUBSCRIPT>COMPILE+24^PSODEARV"
^XPD(9.6,13684,1,4,0)=" "
^XPD(9.6,13684,1,5,0)=" "
^XPD(9.6,13684,1,6,0)="Problem:"
^XPD(9.6,13684,1,7,0)="--------"
^XPD(9.6,13684,1,8,0)="When running the report DEA Expiration Date Report [PSO EPCS EXPIRE DATE "
^XPD(9.6,13684,1,9,0)="REPORT] a subscript error <SUBSCRIPT>COMPILE+24^PSODEARV can occur when a "
^XPD(9.6,13684,1,10,0)="record in the file DEA NUMBERS (#8991,9) is encountered that has no value "
^XPD(9.6,13684,1,11,0)="for the NAME (PROVIDER OR INSTITUTION) field (#1.1). This error can occur "
^XPD(9.6,13684,1,12,0)="when running the report as a Delimited File.  The error does not happen "
^XPD(9.6,13684,1,13,0)="when the report is run as a Report."
^XPD(9.6,13684,1,14,0)=" "
^XPD(9.6,13684,1,15,0)=" "
^XPD(9.6,13684,1,16,0)="Resolution:"
^XPD(9.6,13684,1,17,0)="-----------"
^XPD(9.6,13684,1,18,0)="The error occurs because the Delimited File output uses the NAME field "
^XPD(9.6,13684,1,19,0)="1.1 in the DEA NUMBERS file #8991.9, which can be null.  The Report "
^XPD(9.6,13684,1,20,0)="output uses the NAME field #.01 in the NEW PERSON file which is always "
^XPD(9.6,13684,1,21,0)="populated.  This patch prevents the error by modifying routine PSODEARV "
^XPD(9.6,13684,1,22,0)="to use the NAME field #.01 in the NEW PERSON file when building the "
^XPD(9.6,13684,1,23,0)="delimited output."
^XPD(9.6,13684,4,0)="^9.64PA^^"
^XPD(9.6,13684,6)="^620"
^XPD(9.6,13684,6.3)=3
