^XPD(9.6,13862,0)="DVBA*2.7*252^93^0^3241217^y"
^XPD(9.6,13862,1,0)="^^40^40^3241202^"
^XPD(9.6,13862,1,1,0)="Patch DVBA*2.7*252 introduces the Progress Notes Constructin Set (PNCS) "
^XPD(9.6,13862,1,2,0)="replacement,Content Management Tool (CMT) system. This allows the Medical"
^XPD(9.6,13862,1,3,0)="Disability Examination Office (MDEO) to create/update DBQ forms as"
^XPD(9.6,13862,1,4,0)="needed.  With the introduction of CMT, Compensation and Pension"
^XPD(9.6,13862,1,5,0)="Record Interchange (CAPRI) will also allow users to create and edit "
^XPD(9.6,13862,1,6,0)="Disability Benefits Questionnaires (DBQ) in a Portable Document Format"
^XPD(9.6,13862,1,7,0)="(PDF)."
^XPD(9.6,13862,1,8,0)=" "
^XPD(9.6,13862,1,9,0)="Patch DVBA*2.7*252 will also be addressing 508 issues and the following:"
^XPD(9.6,13862,1,10,0)=" "
^XPD(9.6,13862,1,11,0)="INC27409886: Deleting an Open Template"
^XPD(9.6,13862,1,12,0)="INC23389024: Disabled users still able to connect to claims.domain.ext"
^XPD(9.6,13862,1,13,0)="INC30600763: Cannot access CAPRI Training Site"
^XPD(9.6,13862,1,14,0)="INC34120499: CAPRI default/timeout window is ""save and exit"" rather than "
^XPD(9.6,13862,1,15,0)="             ""keep working"" which causes issues"
^XPD(9.6,13862,1,16,0)="CAPRI 8151:  When the User Runs the Report Builder, Blank Drug Classes "
^XPD(9.6,13862,1,17,0)="             will be Populated with Incorrect Data"
^XPD(9.6,13862,1,18,0)="CAPRI-7883:  Resizing Voc-Rehab Medical Services Request Dialog"
^XPD(9.6,13862,1,19,0)="CAPRI-7884:  Resizing Address Verification"
^XPD(9.6,13862,1,20,0)="CAPRI-7879:  Exam Reference Error in VistA-When the requested exam is "
^XPD(9.6,13862,1,21,0)="             opened, the field labeled 'Exam Reference' is being filled"
^XPD(9.6,13862,1,22,0)="             with the record number instead of the actual exam reference"
^XPD(9.6,13862,1,23,0)="             number based in VistA"
^XPD(9.6,13862,1,24,0)="CAPRI-7867:  Report Builder-data from the Diet tab appears in another "
^XPD(9.6,13862,1,25,0)="             patients data "
^XPD(9.6,13862,1,26,0)="CAPRI-8244:  Deprecate the CAPRI Manifest Query Going to DAS to Support "
^XPD(9.6,13862,1,27,0)="             DAS Release"
^XPD(9.6,13862,1,28,0)="CAPRI-11150: Surgery Report error message encountered: DVBAB OPERATION "
^XPD(9.6,13862,1,29,0)="             REPORT could not be accessed!"
^XPD(9.6,13862,1,30,0)="CAPRI-10958: Empty window displaying on screen during CAPRI worksheet "
^XPD(9.6,13862,1,31,0)="             signing process"
^XPD(9.6,13862,1,32,0)="CAPRI-12105: Surgery Report Ok Button Active without Report Selected, Out "
^XPD(9.6,13862,1,33,0)="             of Bound error message received"
^XPD(9.6,13862,1,34,0)="CAPRI-10314: Capability to Sort and Filter the Edit Local Tab in DBQ Push "
^XPD(9.6,13862,1,35,0)="             Utility using an RPC"
^XPD(9.6,13862,1,36,0)="CAPRI-11496: EFolder Transmission message for for Remote Users"
^XPD(9.6,13862,1,37,0)="CAPRI-11586: Display Error Message for Users for Missing SecID in the NEW "
^XPD(9.6,13862,1,38,0)="             PERSON File"
^XPD(9.6,13862,1,39,0)="CAPRI-11938: SecID and SSN Validation based on VistA DVBA CAPRI SECURITY "
^XPD(9.6,13862,1,40,0)="             TOGGLE"
^XPD(9.6,13862,4,0)="^9.64PA^396.17^1"
