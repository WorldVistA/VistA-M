^XPD(9.6,14003,0)="IB*2.0*826^49^0^3250521^y"
^XPD(9.6,14003,1,0)="^^8^8^3250521^"
^XPD(9.6,14003,1,1,0)="The purpose of the patch is to remove the HEADER code from the List "
^XPD(9.6,14003,1,2,0)="Template IBNCPDP LSTMN CT. The Current code in this field is D "
^XPD(9.6,14003,1,3,0)="HDR^IBNCPDPC this line in the routine IBNCPDPC no longer exists. The call "
^XPD(9.6,14003,1,4,0)="replacing this in D HDR^IBTRED, which is the current header call for "
^XPD(9.6,14003,1,5,0)="claims tracking. The error occurs in the worklflow of a user "
^XPD(9.6,14003,1,6,0)="processingclaims in the 'ECME User Screen' option, then the call the "
^XPD(9.6,14003,1,7,0)="'IBNCPDP LSTMNCT' from this option to add comments then tries to return "
^XPD(9.6,14003,1,8,0)="to the 'ECMEUser Screen'"
^XPD(9.6,14003,4,0)="^9.64PA^^"
