^XPD(9.6,13786,0)="ROR*1.5*42^186^0^3240410^y"
^XPD(9.6,13786,1,0)="^^25^25^3240410^^"
^XPD(9.6,13786,1,1,0)="This patch includes the following changes to the Clinical Case Registries"
^XPD(9.6,13786,1,2,0)="(CCR) package."
^XPD(9.6,13786,1,3,0)=" "
^XPD(9.6,13786,1,4,0)=" 1. One drug is added to the ROR GENERIC DRUG (#799.51) file for use by "
^XPD(9.6,13786,1,5,0)="    the VA HIV registry. The drug is LENACAPAVIR."
^XPD(9.6,13786,1,6,0)=" "
^XPD(9.6,13786,1,7,0)=" 2. The VA TRANSGENDER registry is inactivated. The REGISTRY STATUS field"
^XPD(9.6,13786,1,8,0)="    (#11) of the ROR REGISTRY PARAMETERS (#798.1) file for this registry  "
^XPD(9.6,13786,1,9,0)="    is set to 1 (i.e., INACTIVE). The daily update process will no longer"
^XPD(9.6,13786,1,10,0)="    update this registry. Also, this registry will no longer appear in the"
^XPD(9.6,13786,1,11,0)="    list of registries displayed to the users so they will not be able to"
^XPD(9.6,13786,1,12,0)="    select it."
^XPD(9.6,13786,1,13,0)=" "
^XPD(9.6,13786,1,14,0)=" 3. The Graphical User Interface (GUI) now supports the latest changes to"
^XPD(9.6,13786,1,15,0)="    the RPC Broker package. The latest Personal Identity Verification"
^XPD(9.6,13786,1,16,0)="    (PIV) certificate will be selected automatically, however, a new"
^XPD(9.6,13786,1,17,0)="    ""/showcerts"" command line switch was added to allow the user to"
^XPD(9.6,13786,1,18,0)="    display the PIV certificate selection screen in case it is needed."
^XPD(9.6,13786,1,19,0)=" "
^XPD(9.6,13786,1,20,0)=" 4. The version of the CCR software is updated to 1.5.42."
^XPD(9.6,13786,1,21,0)=" "
^XPD(9.6,13786,1,22,0)=" "
^XPD(9.6,13786,1,23,0)="    NOTE: This patch should be installed at sites that run CERNER, too."
^XPD(9.6,13786,1,24,0)="          However, CERNER sites do not need to have the ROR TASK option"
^XPD(9.6,13786,1,25,0)="          scheduled."
^XPD(9.6,13786,4,0)="^9.64PA^799.51^1"
^XPD(9.6,13786,4,799.51,0)=799.51
^XPD(9.6,13786,4,799.51,222)="n^y^f^^y^^y^o^n"
^XPD(9.6,13786,4,799.51,224)="N ROR S ROR=$P($G(^(0)),U) I ROR=""LENACAPAVIR"""
^XPD(9.6,13786,4,"B",799.51,799.51)=""
^XPD(9.6,13786,6)="^42"
