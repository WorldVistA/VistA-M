^XPD(9.6,14125,1,0)="^^62^62^3251229^"
^XPD(9.6,14125,1,1,0)="PI 14.4 - 10/30-11/12 - SD*5.3*927"
^XPD(9.6,14125,1,2,0)="=================================="
^XPD(9.6,14125,1,3,0)=" "
^XPD(9.6,14125,1,4,0)="Tickets:"
^XPD(9.6,14125,1,5,0)="========"
^XPD(9.6,14125,1,6,0)="VSE-10498: JS - VistA: Duplicate encounter/visit fix."
^XPD(9.6,14125,1,7,0)="VSE-10970: HC - VistA: Correct any invalid cancel message entries to"
^XPD(9.6,14125,1,8,0)="           the correct format. (SDES927P - Post-Install)"
^XPD(9.6,14125,1,9,0)="VSE-10974: GW - VistA: Correct an issue with SDES2 GET CANCELLED SLOTS "
^XPD(9.6,14125,1,10,0)="           for inactive clinics."
^XPD(9.6,14125,1,11,0)="VSE-11069: HC - VistA: Create a post-install to report on clinics that"
^XPD(9.6,14125,1,12,0)="           cannot determine time zone. (SDES927P - Post-Install)"
^XPD(9.6,14125,1,13,0)=" "
^XPD(9.6,14125,1,14,0)=" "
^XPD(9.6,14125,1,15,0)="PI 14.5 11/13-11/26 - SD*5.3*927"
^XPD(9.6,14125,1,16,0)="================================"
^XPD(9.6,14125,1,17,0)=" "
^XPD(9.6,14125,1,18,0)="Tickets:"
^XPD(9.6,14125,1,19,0)="========"
^XPD(9.6,14125,1,20,0)="VSE-10971: HC - VistA: When returning clinics for a provider the RPC is "
^XPD(9.6,14125,1,21,0)="           returning all records from the HOSPITAL LOCATION (#44) file"
^XPD(9.6,14125,1,22,0)="           regardless of type."
^XPD(9.6,14125,1,23,0)="VSE-11008: GW - VistA: Modify SDCANCEL to open a closed MRTC Parent if the"
^XPD(9.6,14125,1,24,0)="           child request was reopened when appointments were cancelled."
^XPD(9.6,14125,1,25,0)="VSE-11034: TB - VistA: Modify SDES2 NO-SHOW and SDES2 UNDO NO-SHOW RPCs "
^XPD(9.6,14125,1,26,0)="           to remove and add back Appointment IEN for MRTC."
^XPD(9.6,14125,1,27,0)="VSE-11042: HC - VistA: Modify SDES GET PATIENT INQUIRY to recognize names"
^XPD(9.6,14125,1,28,0)="           with hyphen when stripping out SSN."
^XPD(9.6,14125,1,29,0)="VSE-11101: JJ - VistA: Modify SDES2CLININFO to include the IEN in the"
^XPD(9.6,14125,1,30,0)="           return object for PreApptLetter, CancelLetter, and"
^XPD(9.6,14125,1,31,0)="           ApptCancelLetter."
^XPD(9.6,14125,1,32,0)=" "
^XPD(9.6,14125,1,33,0)=" "
^XPD(9.6,14125,1,34,0)="PI 14.6 11/28-12/10 - SD*5.3*927"
^XPD(9.6,14125,1,35,0)="================================"
^XPD(9.6,14125,1,36,0)=" "
^XPD(9.6,14125,1,37,0)="Tickets:"
^XPD(9.6,14125,1,38,0)="========"
^XPD(9.6,14125,1,39,0)="VSE-11148: GW - VistA: Modify SDES2 QUERY APPT REQUESTS to fix an issue "
^XPD(9.6,14125,1,40,0)="                where the query returns more records than requested."
^XPD(9.6,14125,1,41,0)=" "
^XPD(9.6,14125,1,42,0)="Option:"
^XPD(9.6,14125,1,43,0)="======="
^XPD(9.6,14125,1,44,0)=" "
^XPD(9.6,14125,1,45,0)=" "
