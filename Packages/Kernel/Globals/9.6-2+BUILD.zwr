^XPD(9.6,13770,0)="SD*5.3*886^48^0^3240819^y"
^XPD(9.6,13770,1,0)="^^88^88^3240819^"
^XPD(9.6,13770,1,1,0)="Jira Tickets Sprint 10.3 - VS GUI 1.7.60 - SD*5.3*886"
^XPD(9.6,13770,1,2,0)="====================================================="
^XPD(9.6,13770,1,3,0)=" "
^XPD(9.6,13770,1,4,0)="VSE-7951: BF - VistA: Create a new RPC in the SDES2 namespace to get "
^XPD(9.6,13770,1,5,0)="          clinics by station number"
^XPD(9.6,13770,1,6,0)="VSE-7967: JDJ - VistA: Add an ""Other"" option to the preference file"
^XPD(9.6,13770,1,7,0)="VSE-8067: JS - VistA: Create a new SDES2 RPC to retrieve clinic data by "
^XPD(9.6,13770,1,8,0)="          division and stop code ranges"
^XPD(9.6,13770,1,9,0)="VSE-8173: JS - VistA: Modify SDES2 CANCEL CLINIC AVAILABILITY to correct "
^XPD(9.6,13770,1,10,0)="          discovered defects"
^XPD(9.6,13770,1,11,0)="VSE-8187: VistA: BB - DISCOVERY - Identify consecutive blocks of times "
^XPD(9.6,13770,1,12,0)="          for scheduling bases on predetermined intervals"
^XPD(9.6,13770,1,13,0)="VSE-8188: FF - VSE GUI: New PID erroneously entered in original "
^XPD(9.6,13770,1,14,0)="          appointment"
^XPD(9.6,13770,1,15,0)="VSE-8205: TB - VistA: Modify SDES2 GET PATIENT EP to return back an "
^XPD(9.6,13770,1,16,0)="          external date string for fields that allow no day"
^XPD(9.6,13770,1,17,0)="VSE-8250: BF - VistA: Modify SDES2GETSTATUS to fix the status of a "
^XPD(9.6,13770,1,18,0)="          cancelled inpatient appointment"
^XPD(9.6,13770,1,19,0)="VSE-8254: BB - VistA: Modify SDES2 GET PATIENT INFO to use the"
^XPD(9.6,13770,1,20,0)="          SDCONTEXT(""USER DUZ"") to pass into POPULATE^SDES2PATSEARCH"
^XPD(9.6,13770,1,21,0)="VSE-8280: BB - VistA: PID not editable when rebooking a cancelled "
^XPD(9.6,13770,1,22,0)="          appointment and the incorrect status on an inpatient appt"
^XPD(9.6,13770,1,23,0)=" "
^XPD(9.6,13770,1,24,0)="Jira Tickets Sprint 10.4 - VS GUI 1.7.60 - SD*5.3*886"
^XPD(9.6,13770,1,25,0)="======================================================"
^XPD(9.6,13770,1,26,0)=" "
^XPD(9.6,13770,1,27,0)="VSE-3869: BB - VistA: Modify SDES CREATE APPT BLK AND MOVE to call new "
^XPD(9.6,13770,1,28,0)="          SDES2 version"
^XPD(9.6,13770,1,29,0)="VSE-7395: TB - VistA: Modify SCMSVUT3 routine tag RADMTHD to allow "
^XPD(9.6,13770,1,30,0)="          additional radiation values"
^XPD(9.6,13770,1,31,0)="VSE-7967: JJ - VistA: Add an ""Other"" option to the preference file"
^XPD(9.6,13770,1,32,0)="VSE-8038: FF - VS GUI: Determine if veteran has successfully participated "
^XPD(9.6,13770,1,33,0)="          in a remote visit"
^XPD(9.6,13770,1,34,0)="VSE-8143: BF - VistA: Modify SDES CLIN PRECAN to correct date range "
^XPD(9.6,13770,1,35,0)="          validation"
^XPD(9.6,13770,1,36,0)="VSE-8177: TB - VistA: Create a new version of SDES2 GET APPTS BY PATIENT "
^XPD(9.6,13770,1,37,0)="          DFN and deprecate the current one"
^XPD(9.6,13770,1,38,0)="VSE-8197: BF - VistA: Modify SDES2 CANCEL APPOINTMENT to check for a lock "
^XPD(9.6,13770,1,39,0)="          in the order vs the lock on the patient"
^XPD(9.6,13770,1,40,0)="          VSE-8221: FF - VS GUI: Add ""Other"" to SNAP"
^XPD(9.6,13770,1,41,0)="VSE-8281: BF - VistA: Fix an issue where SDEC APPDEL is sometimes causing"
^XPD(9.6,13770,1,42,0)="          mis-matched status values in 409.84 and 2.98"
^XPD(9.6,13770,1,43,0)="VSE-8300: JS - VistA: Modify SDES2 GET DISP CONT ATTEMPTS to add new "
^XPD(9.6,13770,1,44,0)="          fields"
^XPD(9.6,13770,1,45,0)="        "
^XPD(9.6,13770,1,46,0)=" "
