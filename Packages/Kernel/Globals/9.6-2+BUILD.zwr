^XPD(9.6,14010,1,6,0)="VSE-10078: JJ - VistA: Clinic availability cannot be deleted using the"
^XPD(9.6,14010,1,7,0)="           SDES2 CREATE CLINIC AVAIL 2 RPC, Updated validation"
^XPD(9.6,14010,1,8,0)="VSE-10133: MD - VistA: HOSPITAL LOCATION file needs EAS Field added"
^XPD(9.6,14010,1,9,0)="VSE-10188: MB -VistA: When a range of dates are sent in the remark is only"
^XPD(9.6,14010,1,10,0)="           being saved on the first day of the range"
