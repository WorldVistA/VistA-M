^XPD(9.6,14221,0)="TIU*1.0*369^163^0^3250929^y"
^XPD(9.6,14221,1,0)="^^22^22^3250922^"
^XPD(9.6,14221,1,1,0)="This patch addresses the following issues:"
^XPD(9.6,14221,1,2,0)=" "
^XPD(9.6,14221,1,3,0)="1. INC24223358 - TIU-1662 - A defect was found in how VistA handles "
^XPD(9.6,14221,1,4,0)="removing alerts for TIU Text Event Alerts"
^XPD(9.6,14221,1,5,0)=" "
^XPD(9.6,14221,1,6,0)="2. INC39192675 - TIU-2084 - Getting logged off of VistA in the middle of "
^XPD(9.6,14221,1,7,0)="running a report - TIU COPY/PASTE TRACKING REPORT DETAIL1+122^TIUCOPR1 "
^XPD(9.6,14221,1,8,0)="^DPT("""")"
^XPD(9.6,14221,1,9,0)=" "
^XPD(9.6,14221,1,10,0)="3. INC39470303 - TIU-2094 - <SUBSCRIPT>BLD+7^TIUSRVT3 ^TIU(8927,"""") "
^XPD(9.6,14221,1,11,0)="occurring nightly when the auto-deactivate option runs"
^XPD(9.6,14221,1,12,0)=" "
^XPD(9.6,14221,1,13,0)="4. INC39986468 - TIU-2103 - <UNDEFINED>ORPHAN+8^TIUFLF4 *Y error running "
^XPD(9.6,14221,1,14,0)="a FM report from 8925.1 to look for documents with ORPHAN=YES"
^XPD(9.6,14221,1,15,0)=" "
^XPD(9.6,14221,1,16,0)="5. INC34507410 - TIU-2104 - Description discrepancies for START OF ADD "
^XPD(9.6,14221,1,17,0)="SGNR ALERT PERIOD field in TIU BASIC PARAMETERS in Vista"
^XPD(9.6,14221,1,18,0)=" "
^XPD(9.6,14221,1,19,0)="6. N/A - TIU-2095 - ICR 10060 Violation - direct global read ^VA(200,IEN) "
^XPD(9.6,14221,1,20,0)="in TIUSRVT3"
^XPD(9.6,14221,1,21,0)=" "
^XPD(9.6,14221,1,22,0)="7. N/A - TIU-2099 - ICR Violations in TIUCOPR1"
^XPD(9.6,14221,4,0)="^9.64PA^8925.99^1"
^XPD(9.6,14221,4,8925.99,0)=8925.99
^XPD(9.6,14221,4,8925.99,2,0)="^9.641^8925.99^1"
