^XPD(9.6,13741,0)="PSO*7.0*762^60^0^3240703^y"
^XPD(9.6,13741,1,0)="^^13^13^3240703^"
^XPD(9.6,13741,1,1,0)="Problem:"
^XPD(9.6,13741,1,2,0)="--------"
^XPD(9.6,13741,1,3,0)="When running options Add New Providers [PSO PROVIDER], Edit Provider [PSO "
^XPD(9.6,13741,1,4,0)="PROVIDER EDIT], or View Provider [PSO PROVIDER INQUIRE], the heading for "
^XPD(9.6,13741,1,5,0)="the provider scrolls off the page when the provider has more than 2 DEA "
^XPD(9.6,13741,1,6,0)="numbers."
^XPD(9.6,13741,1,7,0)=" "
^XPD(9.6,13741,1,8,0)="Resolution:"
^XPD(9.6,13741,1,9,0)="-----------"
^XPD(9.6,13741,1,10,0)="Modify routine PSOPRVW and change the calculation used to determine if "
^XPD(9.6,13741,1,11,0)="printing has reached the bottom of the page. This will allow the "
^XPD(9.6,13741,1,12,0)="provider name to be displayed on each page of the output.  Data for 2 DEA "
^XPD(9.6,13741,1,13,0)="numbers will be displayed on each page."
^XPD(9.6,13741,4,0)="^9.64PA^^"
^XPD(9.6,13741,6)="^629"
