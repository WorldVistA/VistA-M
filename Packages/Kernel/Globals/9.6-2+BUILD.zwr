^XPD(9.6,13737,0)="SD*5.3*881^48^0^3240716^y"
^XPD(9.6,13737,1,0)="^^77^77^3240716^"
^XPD(9.6,13737,1,1,0)="VSE Increment 10.1 - SD*5.3*881 - GUI v 1.7.58"
^XPD(9.6,13737,1,2,0)=" "
^XPD(9.6,13737,1,3,0)=" "
^XPD(9.6,13737,1,4,0)="Jira Tickets:"
^XPD(9.6,13737,1,5,0)="============="
^XPD(9.6,13737,1,6,0)=" "
^XPD(9.6,13737,1,7,0)="VSE-7988: BF - VistA: Create a new appointment type, World War II"
^XPD(9.6,13737,1,8,0)="VSE-8050: JJ - VistA: Modify SDES2 EDIT PAT DEMOGRAPHICS to fix an"
^XPD(9.6,13737,1,9,0)="               inconsistent response"
^XPD(9.6,13737,1,10,0)="VSE-8074: MD - VistA: Update existing SDES2 RPCs so that the ACHERON"
^XPD(9.6,13737,1,11,0)="               AUDIT ID is in the input parameter description"
^XPD(9.6,13737,1,12,0)="VSE-8079: BF - VistA: Update Patient Search RPC to return -1 to 4"
^XPD(9.6,13737,1,13,0)="VSE-8080: TB - VistA: Modify create appointment RPCs to change the"
^XPD(9.6,13737,1,14,0)="               validation on the maximum appointment length from 120 to"
^XPD(9.6,13737,1,15,0)="               240"
^XPD(9.6,13737,1,16,0)="VSE-8095: MD - VistA: Update SDES GETVVSMAKEINFO JSON and SDES SEARCH "
^XPD(9.6,13737,1,17,0)="               VVS PROVIDERS JSON so that the APP PROXY ALLOWED field is"
^XPD(9.6,13737,1,18,0)="               set to Yes"
^XPD(9.6,13737,1,19,0)="VSE-8106: JS - VistA: Discovery and fix if possible - figure out why "
^XPD(9.6,13737,1,20,0)="               SDESCLINICAVAIL is not returning back the midnight"
^XPD(9.6,13737,1,21,0)="               timeslots for the clinic for Monday"
^XPD(9.6,13737,1,22,0)="VSE-8156: MD - VistA: Modify SDES GET VISTA DEVICES RPC to be updated to "
^XPD(9.6,13737,1,23,0)="               return all matches for the search string passed in."
^XPD(9.6,13737,1,24,0)="VSE-8226: BB - VistA: Modify the check in SDES2 CREATE APPOINTMENT RPC to "
^XPD(9.6,13737,1,25,0)="               verify that appointment is not cancelled"
^XPD(9.6,13737,1,26,0)=" "
^XPD(9.6,13737,1,27,0)="Files:"
^XPD(9.6,13737,1,28,0)="======"
^XPD(9.6,13737,1,29,0)=" "
^XPD(9.6,13737,1,30,0)=" "
