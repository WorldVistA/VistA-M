^XPD(9.6,13840,1,3,0)=" "
^XPD(9.6,13840,1,4,0)="VSE-8448: BB - VistA: Need Full Day Cancel Reason text to be returned "
^XPD(9.6,13840,1,5,0)="          from VSE"
^XPD(9.6,13840,1,6,0)="VSE-8449: BB - VistA: need to remove language seen in the Add/Modify pop "
^XPD(9.6,13840,1,7,0)="          up modal window ""Cancelled Until xxxxxxx.xxx"""
^XPD(9.6,13840,1,8,0)="VSE-8567: JS - VistA: User Comment Tracking"
^XPD(9.6,13840,1,9,0)="VSE-8574: TB - VistA: Modify the new VET SELF CANCEL flag"
^XPD(9.6,13840,1,10,0)="VSE-8614: MB - VistA: WWII Appointment Type is showing as non-billable"
^XPD(9.6,13840,1,11,0)="VSE-8723: BF - VistA: Fix an issue with user erroneously receiving "
^XPD(9.6,13840,1,12,0)="               ""Patient has an appointment at this time in another time "
^XPD(9.6,13840,1,13,0)="               zone."
^XPD(9.6,13840,1,14,0)="VSE-8799: BB - VistA: Update SDES2 CANCEL CLIN AVAILABILITY  to cancel "
^XPD(9.6,13840,1,15,0)="               appointments before cancel availability"
^XPD(9.6,13840,1,16,0)=" "
