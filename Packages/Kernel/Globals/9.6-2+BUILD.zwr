^XPD(9.6,14032,0)="EDP*2.0*37^212^0^3250627^y"
^XPD(9.6,14032,1,0)="^^28^28^3250522^"
^XPD(9.6,14032,1,1,0)="1) EDIS-1252 - Integrated site fix for scheduling applications."
^XPD(9.6,14032,1,2,0)=" "
^XPD(9.6,14032,1,3,0)="Problem:"
^XPD(9.6,14032,1,4,0)="--------"
^XPD(9.6,14032,1,5,0)="Scheduling applications Vista Scheduling Graphic User Interface (VS GUI) "
^XPD(9.6,14032,1,6,0)="and Integrated Scheduling Solution (ISS) are not supported for integrated "
^XPD(9.6,14032,1,7,0)="sites with multiple divisions by EDIS. For example, if a site like 561 "
^XPD(9.6,14032,1,8,0)="has another division 561A4 it is currently not possible to add the "
^XPD(9.6,14032,1,9,0)="patient in the 561A4 site in EDIS. This happens because EDIS is coded to "
^XPD(9.6,14032,1,10,0)="assume the user is always at the primary site regardless of which "
^XPD(9.6,14032,1,11,0)="division the clinic they are trying to add the patient to."
^XPD(9.6,14032,1,12,0)=" "
^XPD(9.6,14032,1,13,0)="Technical explanation:"
^XPD(9.6,14032,1,14,0)="--------"
^XPD(9.6,14032,1,15,0)="In the Mumps code where EDIS listens to the SDAM APPOINTMENT EVENTS "
^XPD(9.6,14032,1,16,0)="protocol for patient check-ins the site value for the check-in uses the "
^XPD(9.6,14032,1,17,0)="local variable DUZ(2). This value is from the CONNECTOREDIS proxy account "
^XPD(9.6,14032,1,18,0)="the EDIS JAVA GUI uses to add information to Vista. The problem is sites "
^XPD(9.6,14032,1,19,0)="only have one of these accounts and it is typically located in the "
^XPD(9.6,14032,1,20,0)="primary site. As the example above states if the connector proxy account "
^XPD(9.6,14032,1,21,0)="is at 561 then EDIS uses it's DUZ(2) value even for patients at 561A4. "
^XPD(9.6,14032,1,22,0)="Since the correct site code is never assigned to that patient they never "
^XPD(9.6,14032,1,23,0)="appear in the other division's display board. "
^XPD(9.6,14032,1,24,0)=" "
^XPD(9.6,14032,1,25,0)="Resolution:"
^XPD(9.6,14032,1,26,0)="-----------"
^XPD(9.6,14032,1,27,0)="EDIS now adds patients to sites based on the clinics location rather than "
^XPD(9.6,14032,1,28,0)="the location of the connector proxy account. "
^XPD(9.6,14032,4,0)="^9.64PA^^"
^XPD(9.6,14032,6)="^32"
^XPD(9.6,14032,6.3)=3
