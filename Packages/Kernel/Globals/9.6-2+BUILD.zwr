^XPD(9.6,13848,0)="SD*5.3*895^48^0^3241203^y"
^XPD(9.6,13848,1,0)="^^123^123^3241202^"
^XPD(9.6,13848,1,1,0)="Jira Tickets Sprint 11.3 - SD*5.3*895"
^XPD(9.6,13848,1,2,0)="======================================================"
^XPD(9.6,13848,1,3,0)=" "
^XPD(9.6,13848,1,4,0)="VSE-8649: TB - VistA: Fix an issue so that GUI and ISS work the same with "
^XPD(9.6,13848,1,5,0)="          special needs and preferences"
^XPD(9.6,13848,1,6,0)="VSE-8650: FF - VS GUI: User facing change in VS GUI so that SNAP works "
^XPD(9.6,13848,1,7,0)="          the same with GUI and ISS"
^XPD(9.6,13848,1,8,0)="VSE-8672: BF - VistA: Modify SDES2 QUERY APPT REQ to increase the total "
^XPD(9.6,13848,1,9,0)="          number of records searched to 201"
^XPD(9.6,13848,1,10,0)="VSE-8674: JJ - VistA: Modify SDES2BLDAPPT44 to prevent ISS from failing "
^XPD(9.6,13848,1,11,0)="          when pulling up the patient appointments."
^XPD(9.6,13848,1,12,0)="VSE-8726: BB - Vista: SDES2 BLOCK AND MOVE erroneously returns back the "
^XPD(9.6,13848,1,13,0)="               error: ""Cannot block and move from slots that originated"
^XPD(9.6,13848,1,14,0)="               with more than 1 available appointment slot"""
^XPD(9.6,13848,1,15,0)="VSE-8732: LB -VistA: User information being sent in the SDCONTEXT array "
^XPD(9.6,13848,1,16,0)="          is finding issues with the ASECID cross reference "
^XPD(9.6,13848,1,17,0)=" "
^XPD(9.6,13848,1,18,0)=" "
^XPD(9.6,13848,1,19,0)="Jira Tickets Sprint 11.4 - SD*5.3*896"
^XPD(9.6,13848,1,20,0)="====================================="
^XPD(9.6,13848,1,21,0)=" "
^XPD(9.6,13848,1,22,0)="VSE-6586: MD - VistA: Modify SDAMEP1, SDAMEP2, and SDM4 routines to "
^XPD(9.6,13848,1,23,0)="          include a call to PXCOMPACT"
^XPD(9.6,13848,1,24,0)="VSE-8451: JS - VistA: Create a sub specialty and a sub sub specialty"
^XPD(9.6,13848,1,25,0)="VSE-8704: TB - VistA: Create SDES2 PRINT APPT LETTER and SDES2 PRINT APPT "
^XPD(9.6,13848,1,26,0)="          LETTERS to send parts of the letter"
^XPD(9.6,13848,1,27,0)="VSE-8802: BB - VistA: DATA CLEAN UP - ""Update SDES2 CANCEL CLIN"
^XPD(9.6,13848,1,28,0)="          AVAILABILITY to cancel appointments before cancel availability"""
^XPD(9.6,13848,1,29,0)="VSE-8885: JS - VistA: Modify SDEC EDITAPPT, SDES2 EDIT"
^XPD(9.6,13848,1,30,0)="          APPOINTMENT, SDEC ARSET, SDES2 EDIT APPT REQ (User Comment"
^XPD(9.6,13848,1,31,0)="          tracking - coding change)"
^XPD(9.6,13848,1,32,0)="VSE-8933: JS - VistA: Update PtCSch create and edit to audit comments"
