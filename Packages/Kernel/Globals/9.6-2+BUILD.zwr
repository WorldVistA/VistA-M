^XPD(9.6,13621,0)="PSO*7.0*750^60^0^3240111^y"
^XPD(9.6,13621,1,0)="^^49^49^3240111^^"
^XPD(9.6,13621,1,1,0)="This patch is being released to address a few small eRx related issues"
^XPD(9.6,13621,1,2,0)="encountered after the patch PSO*7*700 was released:"
^XPD(9.6,13621,1,3,0)=" "
^XPD(9.6,13621,1,4,0)=" - eRx statuses CAH (CANCEL COMPLETED IN HOLDING QUEUE) and CAO (CANCEL"
^XPD(9.6,13621,1,5,0)="   PROCESS COMPLETE) not being treated as 'Actionable' in the new eRx Holding"
^XPD(9.6,13621,1,6,0)="   Queue Processing option [PSO ERX QUEUE PROCESSING]"
^XPD(9.6,13621,1,7,0)=" - Hidden Action RR (RxRenewal Request) under OTH disappeared"
^XPD(9.6,13621,1,8,0)=" - <UNDEFINED> error at VIDEO+4^PSOERUT0"
^XPD(9.6,13621,1,9,0)=" - CPRS ORDERING INSTITUTION prompt"
^XPD(9.6,13621,1,10,0)="  "
^XPD(9.6,13621,1,11,0)="1. eRx statuses CAH (CANCEL COMPLETED IN HOLDING QUEUE) and CAO (CANCEL"
^XPD(9.6,13621,1,12,0)="   PROCESS COMPLETE) not being treated as 'Actionable' in the new eRx Holding"
^XPD(9.6,13621,1,13,0)="   Queue Processing option [PSO ERX QUEUE PROCESSING]"
^XPD(9.6,13621,1,14,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13621,1,15,0)="   The new eRx Holding Queue Processing [PSO ERX QUEUE PROCESSING] option was"
^XPD(9.6,13621,1,16,0)="   not considering eRx records with the statuses CAH and CAO as actionable."
^XPD(9.6,13621,1,17,0)="   This caused patients not to be listed on the Patient Centric view when they"
^XPD(9.6,13621,1,18,0)="   only had these types of actionable records. This patch fixes this problem"
^XPD(9.6,13621,1,19,0)="   by treating CAH and CAO statuses as actionable."
^XPD(9.6,13621,1,20,0)=" "
^XPD(9.6,13621,1,21,0)="2. Hidden Action RR (RxRenewal Request) under OTH disappeared"
^XPD(9.6,13621,1,22,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13621,1,23,0)="   After the installation of PSO*7*700 the hidden action RR (RxRenewal"
^XPD(9.6,13621,1,24,0)="   Request) was unintentionally removed from the Other OP Action (OTH hidden"
^XPD(9.6,13621,1,25,0)="   action) when the user was viewing a single prescription in Backdoor "
^XPD(9.6,13621,1,26,0)="   Pharmacy (options PSO LM BACKDOOR ORDERS and PSO LMOE FINISH). This patch"
^XPD(9.6,13621,1,27,0)="   adds the RR hidden action back."
^XPD(9.6,13621,1,28,0)=" "
^XPD(9.6,13621,1,29,0)="3. <UNDEFINED> error at VIDEO+4^PSOERUT0"
^XPD(9.6,13621,1,30,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13621,1,31,0)="   An <UNDEFINED> was being recorded when the user ran the Complete Orders"
^XPD(9.6,13621,1,32,0)="   from OERR and selected NO at the prompt 'Do you want to see Medication"
^XPD(9.6,13621,1,33,0)="   Profile?' when there were patient with eRx pending orders to be finished."
^XPD(9.6,13621,1,34,0)="   This patch will fix this issue and the error will no longer happen."
^XPD(9.6,13621,1,35,0)=" "
^XPD(9.6,13621,1,36,0)="4. CPRS ORDERING INSTITUTION prompt"
^XPD(9.6,13621,1,37,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13621,1,38,0)="   Upon entering the new eRx Holding Queue Processing [PSO ERX QUEUE"
^XPD(9.6,13621,1,39,0)="   PROCESSING] option the users of some sites were being prompt for the CPRS"
^XPD(9.6,13621,1,40,0)="   ORDERSING INSTITUTION as shown below."
^XPD(9.6,13621,1,41,0)=" "
^XPD(9.6,13621,1,42,0)="      There are multiple Institutions associated with this Outpatient Site for"
^XPD(9.6,13621,1,43,0)="      finishing orders entered through CPRS. Select the Institution for which"
^XPD(9.6,13621,1,44,0)="      to finish orders from.  Enter '?' to see all choices."
^XPD(9.6,13621,1,45,0)="  "
^XPD(9.6,13621,1,46,0)="      Select CPRS ORDERING INSTITUTION: BEDFORD VAMC//   "
^XPD(9.6,13621,1,47,0)=" "
^XPD(9.6,13621,1,48,0)="   This prompt was accidentally added to this option and it will be removed"
^XPD(9.6,13621,1,49,0)="   with this patch."
^XPD(9.6,13621,4,0)="^9.64PA^^"
