^XPD(9.6,13774,1,0)="^^6^6^3240521^"
^XPD(9.6,13774,1,1,0)="This patch fixes an issue that causes an error in the VistA error trap"
^XPD(9.6,13774,1,2,0)="when an appointment for a consult can't be made because the consult status"
^XPD(9.6,13774,1,3,0)="is not either active or pending. The appointment is rejected and an HL7 "
^XPD(9.6,13774,1,4,0)="NAK message is returned to HSRM, but then the code doesn't quit as it"
^XPD(9.6,13774,1,5,0)="should. As a result, the code continues into a block of code that should"
^XPD(9.6,13774,1,6,0)="Jnot run and that code results in the error: <UNDEFINED>MAKE+39^SDCCRSEN1"
^XPD(9.6,13774,4,0)="^9.64PA^^"
^XPD(9.6,13774,6)="^734"
^XPD(9.6,13774,6.3)=55
