^XPD(9.6,13801,0)="PSO*7.0*769^60^0^3240906^y"
^XPD(9.6,13801,1,0)="^^118^118^3240829^^^^"
^XPD(9.6,13801,1,1,0)="This patch is being released to address a few small eRx related issues"
^XPD(9.6,13801,1,2,0)="encountered after the patch PSO*7*746 was released:"
^XPD(9.6,13801,1,3,0)=" "
^XPD(9.6,13801,1,4,0)="1. Written Date with Time display issue"
^XPD(9.6,13801,1,5,0)="2. Changed ADDITIONAL NOTE TO PROVIDER prompt to SUGGESTED PROVIDER NOTE "
^XPD(9.6,13801,1,6,0)="   (FOR RESPONSE RX) + Default for eRx drug selection"
^XPD(9.6,13801,1,7,0)="3. View Suggestion(s) action fix"
^XPD(9.6,13801,1,8,0)="4. DUE (Drug Use Evaluation) Override Reason display issue"
^XPD(9.6,13801,1,9,0)="5. Print action fixes"
^XPD(9.6,13801,1,10,0)="6. NDC code included in the Requested Medication section of the eRx Rx Change"
^XPD(9.6,13801,1,11,0)="   Request"
^XPD(9.6,13801,1,12,0)="7. Complete Orders from eRx [PSO ERX FINISH] option removal"
^XPD(9.6,13801,1,13,0)="8. SIG over 512 characters cause a <SUBSRCIPT> error"
^XPD(9.6,13801,1,14,0)="    "
^XPD(9.6,13801,1,15,0)="1. Written Date with Time display issue"
^XPD(9.6,13801,1,16,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,17,0)="   Some prescribers send eRx's with a timestamp for the Written Date and "
^XPD(9.6,13801,1,18,0)="   this causes a display issue which overwrites the 'eRx Status' label as "
^XPD(9.6,13801,1,19,0)="   shown below:"
^XPD(9.6,13801,1,20,0)=" "
^XPD(9.6,13801,1,21,0)="   Single eRx View/Display       Aug 10, 2024@10:28:15        Page:  1 of  2"
^XPD(9.6,13801,1,22,0)="   eRx Patient: PATIENT,TEST                     eRx Reference #: 999999999"
^XPD(9.6,13801,1,23,0)="   eRx Msg Type: NEWRX                                     Written: 08/23/24"
^XPD(9.6,13801,1,24,0)="   @11:11:11s: W - WAIT"
^XPD(9.6,13801,1,25,0)="   ^^^^^^^^^"
^XPD(9.6,13801,1,26,0)=" "
^XPD(9.6,13801,1,27,0)="2. Changed ADDITIONAL NOTE TO PROVIDER prompt to SUGGESTED PROVIDER NOTE"
^XPD(9.6,13801,1,28,0)="   (FOR RESPONSE RX) + Default for eRx drug selection"
^XPD(9.6,13801,1,29,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,30,0)="   After verifying data from several Rx Responses from the prescriber it "
^XPD(9.6,13801,1,31,0)="   was determined that the prompt ADDITIONAL NOTE TO PROVIDER was wrongly"
^XPD(9.6,13801,1,32,0)="   worded. This field is not supposed to be used by Pharmacy to "
^XPD(9.6,13801,1,33,0)="   communicate with the prescriber, the correct use is for pharmacy to"
^XPD(9.6,13801,1,34,0)="   enter a suggested Provider Note content that the prescriber will then "
^XPD(9.6,13801,1,35,0)="   decide to keep, change or delete when adopting the requested medication."
^XPD(9.6,13801,1,36,0)="   Additionally, when the user is building the requested medication, if the"
^XPD(9.6,13801,1,37,0)="   user selects E (use eRx Drug) the Provider Notes content (if any) will"
^XPD(9.6,13801,1,38,0)="   be given as default for the Provider Notes in the medication requested,"
^XPD(9.6,13801,1,39,0)="   as shown below:"
^XPD(9.6,13801,1,40,0)="  "
^XPD(9.6,13801,1,41,0)="     SUGGESTED PROVIDER NOTE (FOR RESPONSE RX): Suggested Packaging: 2.0 "
^XPD(9.6,13801,1,42,0)="     Milliliters syringe.  Replace ??"
^XPD(9.6,13801,1,43,0)=" "
^XPD(9.6,13801,1,44,0)="      This is the suggested Provider Note that will be sent back with Rx "
^XPD(9.6,13801,1,45,0)="      Response if this drug option is selected by the outside Provider. It"
^XPD(9.6,13801,1,46,0)="      may be edited/removed by the Provider before sending the response"
^XPD(9.6,13801,1,47,0)="      back."
^XPD(9.6,13801,1,48,0)="  "
^XPD(9.6,13801,1,49,0)="3. View Suggestion(s) action fix"
^XPD(9.6,13801,1,50,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,51,0)="   Sometimes the VS (View Suggestion(s)) action does not show any suggestions"
^XPD(9.6,13801,1,52,0)="   and does not say 'No suggestions found' either. This is being fixed with"
^XPD(9.6,13801,1,53,0)="   this patch."
^XPD(9.6,13801,1,54,0)=" "
^XPD(9.6,13801,1,55,0)="4. DUE (Drug Use Evaluation) Override Reason display issue"
^XPD(9.6,13801,1,56,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,57,0)="   When the Override field from a DUE is longer than 28 characters it"
^XPD(9.6,13801,1,58,0)="   'spills' over into the next section (VistA), as shown below: "
^XPD(9.6,13801,1,59,0)=" "
^XPD(9.6,13801,1,60,0)="     Prescriber Drug Use Evaluation:        |________________________________"
^XPD(9.6,13801,1,61,0)="     Co-Agent:                              |3)Patient Instructions: "
^XPD(9.6,13801,1,62,0)="     Reason: Product Selection Opportunity  |                       "
^XPD(9.6,13801,1,63,0)="     Result:                                |                       "
^XPD(9.6,13801,1,64,0)="     Override: Substitute as necessary, ple |                       "
^XPD(9.6,13801,1,65,0)="                      ase provide documentat|on to                  "
^XPD(9.6,13801,1,66,0)="                       patient for assistanc|               "
^XPD(9.6,13801,1,67,0)="     "
^XPD(9.6,13801,1,68,0)="     After fix:"
^XPD(9.6,13801,1,69,0)="     --------- "
^XPD(9.6,13801,1,70,0)="     Prescriber Drug Use Evaluation:        |________________________________"
^XPD(9.6,13801,1,71,0)="     Co-Agent:                              |3)Patient Instructions: "
^XPD(9.6,13801,1,72,0)="     Reason: Product Selection Opportunity  |                       "
^XPD(9.6,13801,1,73,0)="     Result:                                |                       "
^XPD(9.6,13801,1,74,0)="     Override: Substitute as necessary, plea|                       "
^XPD(9.6,13801,1,75,0)="               se provide documentation to p|                  "
^XPD(9.6,13801,1,76,0)="               atient for assistance        |               "
^XPD(9.6,13801,1,77,0)=" "
^XPD(9.6,13801,1,78,0)="5. Print action fixes"
^XPD(9.6,13801,1,79,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,80,0)="   Two small changes were made to the Print action in the PATIENT INFORMATION"
^XPD(9.6,13801,1,81,0)="   section:"
^XPD(9.6,13801,1,82,0)="    - Fixed a misspelling of the label 'Nane:' to 'Name:'"
^XPD(9.6,13801,1,83,0)="    - Changed label 'Primary Telephone' to 'Primary Phone'"
^XPD(9.6,13801,1,84,0)=" "
^XPD(9.6,13801,1,85,0)="6. NDC code included in the Requested Medication section of the eRx Rx Change"
^XPD(9.6,13801,1,86,0)="   Request"
^XPD(9.6,13801,1,87,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,88,0)="   Sometimes when an RX Change Request is sent the outside prescriber "
^XPD(9.6,13801,1,89,0)="   software returns an error saying the drug suggested is not recognized."
^XPD(9.6,13801,1,90,0)="   This issue happens when the user selects a VistA drug for the Requested "
^XPD(9.6,13801,1,91,0)="   Medication and the VistA NDC for this drug is not recognized by the "
^XPD(9.6,13801,1,92,0)="   prescriber software. In order to facilitate the troubleshooting of such"
^XPD(9.6,13801,1,93,0)="   issue the NDC sent to the prescriber for the Requested Medication will "
^XPD(9.6,13801,1,94,0)="   now be displayed in the Requested Medication of the Rx Change Request"
^XPD(9.6,13801,1,95,0)="   section, as shown below:"
^XPD(9.6,13801,1,96,0)="   "
^XPD(9.6,13801,1,97,0)="    --------------------------MEDICATION REQUESTED 1-------------------------"
^XPD(9.6,13801,1,98,0)="    Drug: NAPROXEN 250MG TAB                                                 "
^XPD(9.6,13801,1,99,0)="    Substitutions: YES                                    NDC: 77771-0434-05"
^XPD(9.6,13801,1,100,0)="    Note: Aware of Allergy. Patient Tolerates                        "
^XPD(9.6,13801,1,101,0)="    Qty: 30                Refills: 5           Days Supply: 180     "
^XPD(9.6,13801,1,102,0)="    Quantity Unit Of Measure: TABLET DOSING UNIT                "
^XPD(9.6,13801,1,103,0)="    Sig: TAKE 1 TAB PO DAILY                                    "
^XPD(9.6,13801,1,104,0)="    ------------------------------------------------------------------------"
^XPD(9.6,13801,1,105,0)=" "
^XPD(9.6,13801,1,106,0)="7. Complete Orders from eRx [PSO ERX FINISH] option removal"
^XPD(9.6,13801,1,107,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,108,0)="   The Complete Orders from eRx [PSO ERX FINISH] option was put Out-of-Order "
^XPD(9.6,13801,1,109,0)="   by the PSO*7*746 patch because its functionality has been fully replaced"
^XPD(9.6,13801,1,110,0)="   by the eRx Holding Queue Processing [PSO ERX QUEUE PROCESSING] option. "
^XPD(9.6,13801,1,111,0)="   This patch will now remove/delete this obsolete option from your menu."
^XPD(9.6,13801,1,112,0)="   "
^XPD(9.6,13801,1,113,0)="8. SIG over 512 characters cause a <SUBSRCIPT> error"
^XPD(9.6,13801,1,114,0)="   --------------------------------------------------------------------------"
^XPD(9.6,13801,1,115,0)="   When the user tried to select the VistA drug to match the eRx drug and"
^XPD(9.6,13801,1,116,0)="   a VistA suggestion exists with a SIG that is longer than 512 characters"
^XPD(9.6,13801,1,117,0)="   they software throws a <SUBSCRIPT> error, which will be addressed by this"
^XPD(9.6,13801,1,118,0)="   patch."
