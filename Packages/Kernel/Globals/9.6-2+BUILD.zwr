^XPD(9.6,13718,1,0)="^^110^110^3240613^"
^XPD(9.6,13718,1,1,0)="VSE Increment 9.7 & 9.8 * 10.0 - SD_5_3_880 - VS GUI 1.7.57"
^XPD(9.6,13718,1,2,0)=" "
^XPD(9.6,13718,1,3,0)=" "
^XPD(9.6,13718,1,4,0)="Jira Tickets 9.7:"
^XPD(9.6,13718,1,5,0)="================="
^XPD(9.6,13718,1,6,0)="VSE-7567: LB - VistA: Modify SDES GET APPTS and SDES2 GET APPTS RPCs"
^XPD(9.6,13718,1,7,0)="VSE-7706: TB - VistA: Create an SDES2 version of SDES GET CLINICS BY "
^XPD(9.6,13718,1,8,0)="               PROVIDER to add an input parameter flag for Inactive Clinic"
^XPD(9.6,13718,1,9,0)="VSE-7707: LB - VistA: Modify SDES2 GET RESOURCE GOUP to add an input"
^XPD(9.6,13718,1,10,0)="               parameter flag for inactive clinic"
^XPD(9.6,13718,1,11,0)="VSE-7763: AP - VistA: Modification to SDES2 CREATE APPOINTMENT to update "
^XPD(9.6,13718,1,12,0)="               MRTC PARENT logic."
^XPD(9.6,13718,1,13,0)=" "
^XPD(9.6,13718,1,14,0)="Jira Tickets 9.8:"
^XPD(9.6,13718,1,15,0)="================="
^XPD(9.6,13718,1,16,0)="VSE-7775: TB - Blocked slot reopened on remapping clinic availability."
^XPD(9.6,13718,1,17,0)="VSE-7807: BF - VistA: Create a new RPC to return open availability for a"
^XPD(9.6,13718,1,18,0)="               given service type"
^XPD(9.6,13718,1,19,0)="VSE-7856: JS - VistA: Discovery and Code if possible Modify SDES2 GET "
^XPD(9.6,13718,1,20,0)="               CANCELLED SLOTS RPC so that it also pass back the reason"
^XPD(9.6,13718,1,21,0)="               that a particular slot was cancelled in the first place"
^XPD(9.6,13718,1,22,0)="VSE-7866: AP - VistA: Modify SDES2SETCHECKOUT.INT so that the data we are "
^XPD(9.6,13718,1,23,0)="               trying to file will pass the input transform"
^XPD(9.6,13718,1,24,0)="VSE-7911: TB - VistA: Create an SDES2 version of SDES SEARCH RECALL "
^XPD(9.6,13718,1,25,0)="               PROVIDER's RPC and change the way search is done"
^XPD(9.6,13718,1,26,0)="VSE-7924: LB - VistA: Create a new SDES2 GET APPTS BY CLINIC LIST RPC so "
^XPD(9.6,13718,1,27,0)="               that it returns back the full ""Appointment"" object"
^XPD(9.6,13718,1,28,0)="VSE-7963: BF - VistA: Modify SDES GET CLINIC STOPCD to add 'Restriction "
^XPD(9.6,13718,1,29,0)="               Type'"
^XPD(9.6,13718,1,30,0)="VSE-8049: BB - VistA: Modify SDES2 CANCEL CLINIC AVAILBILITY validation"
^XPD(9.6,13718,1,31,0)="               to add an equal sign to logic so that it doesn't check the"
^XPD(9.6,13718,1,32,0)="               next time slot."
^XPD(9.6,13718,1,33,0)=" "
^XPD(9.6,13718,1,34,0)="Jira Tickets 10.0:"
^XPD(9.6,13718,1,35,0)="=================="
^XPD(9.6,13718,1,36,0)="VSE-7546: FF - VS GUI: Time zone dropdown not working when creating VVC "
^XPD(9.6,13718,1,37,0)="          appointments"
^XPD(9.6,13718,1,38,0)="VSE-7885: BB - VistA: The system is allowing two appointments that are "
^XPD(9.6,13718,1,39,0)="          converted to the same FileMan date.time to be entered in for a"
^XPD(9.6,13718,1,40,0)="          patient"
^XPD(9.6,13718,1,41,0)="VSE-7918: MB - VistA: Modify SDES2 GET PATIENT EP RPC to fix a typo "
^XPD(9.6,13718,1,42,0)="          ""uknown"""
^XPD(9.6,13718,1,43,0)="VSE-7944: JJ - VistA: Modify SDES2 GET PATIENT DEMOGRAPHICS to update the "
^XPD(9.6,13718,1,44,0)="          object when there is no race defined"
^XPD(9.6,13718,1,45,0)="VSE-7961: BF - VistA: A data clean up is needed to add the ""MES"" node to "
^XPD(9.6,13718,1,46,0)="          the clinic for time slots canceled via SDES/SDES2 code."
^XPD(9.6,13718,1,47,0)="VSE-7983: TB - VistA: Fix the logic to prevent <UNDEFINED> error in "
^XPD(9.6,13718,1,48,0)="          SDESCLNSETAVAIL"
^XPD(9.6,13718,1,49,0)="VSE-8061: BB - VistA: Correct logic in SDES2CANCELAPPT to correctly "
^XPD(9.6,13718,1,50,0)="          remove all encounters created for an appointment when"
^XPD(9.6,13718,1,51,0)="          appointment is being cancelled"
^XPD(9.6,13718,1,52,0)="VSE-8062: BF - VistA: Correct logic in SDES2 GET APPT REQ BY TYP VET to "
^XPD(9.6,13718,1,53,0)="          handle SDDUZ and pass it through to the GETREQUEST call"
^XPD(9.6,13718,1,54,0)=" "
