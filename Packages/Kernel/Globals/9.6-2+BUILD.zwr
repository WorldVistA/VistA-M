^XPD(9.6,13742,0)="SR*3.0*205^127^0^3231121^y"
^XPD(9.6,13742,1,0)="^^50^50^3231121^^^"
^XPD(9.6,13742,1,1,0)="This enhancement to the VistA Surgery package includes:"
^XPD(9.6,13742,1,2,0)=" "
^XPD(9.6,13742,1,3,0)="1. An update to the SET OF CODES for the DONOR VESSEL DISPOSITION (#665)"
^XPD(9.6,13742,1,4,0)="field in the SURGERY (#130) file"
^XPD(9.6,13742,1,5,0)=" "
^XPD(9.6,13742,1,6,0)="'NA - NOT APPLICABLE' has been added to the set of codes that can be"
^XPD(9.6,13742,1,7,0)="selected for the DONOR VESSEL DISPOSITION (#665) field in the SURGERY "
^XPD(9.6,13742,1,8,0)="(#130) file.  Surgery Risk Assessment transmissions have been modified to"
^XPD(9.6,13742,1,9,0)="accommodate the new 2 character code."
^XPD(9.6,13742,1,10,0)=" "
^XPD(9.6,13742,1,11,0)="STORED IN ^SRF(  (XX ENTRIES)   SITE: XXXXXXX                UCI: XXXXXXX"
^XPD(9.6,13742,1,12,0)="                                                              (VERSION 3)"
^XPD(9.6,13742,1,13,0)="DATA          NAME                  GLOBAL        DATA"
^XPD(9.6,13742,1,14,0)="ELEMENT       TITLE                 LOCATION      TYPE"
^XPD(9.6,13742,1,15,0)="-------------------------------------------------------------------------"
^XPD(9.6,13742,1,16,0)=" "
^XPD(9.6,13742,1,17,0)="130,665       DONOR VESSEL DISPOSITION VER1;16 SET"
^XPD(9.6,13742,1,18,0)=" "
^XPD(9.6,13742,1,19,0)="              Donor Vessel Disposition if not used   "
^XPD(9.6,13742,1,20,0)="                                'N' FOR NO DONOR VESSELS RECEIVED; "
^XPD(9.6,13742,1,21,0)="                                'D' FOR DISCARDED; "
^XPD(9.6,13742,1,22,0)="                                'R' FOR RETURNED TO OPO; "
^XPD(9.6,13742,1,23,0)="                                'S' FOR STORED; "
^XPD(9.6,13742,1,24,0)="                               *'NA' FOR NOT APPLICABLE; <--"
^XPD(9.6,13742,1,25,0)="              LAST EDITED:      MAY 18, 2022 "
^XPD(9.6,13742,1,26,0)="              HELP-PROMPT:      Enter disposition of donor vessels. "
^XPD(9.6,13742,1,27,0)="              DESCRIPTION:"
^XPD(9.6,13742,1,28,0)="                                Document disposition of donor vessels."
^XPD(9.6,13742,1,29,0)=" "
^XPD(9.6,13742,1,30,0)="2. Input template (order of menu options) realignment"
^XPD(9.6,13742,1,31,0)=" "
^XPD(9.6,13742,1,32,0)="The SRONRPT, SRONRPT1, and SRONRPT2 input templates that are executed when"
^XPD(9.6,13742,1,33,0)="the Nurse Intraoperative Report [SRONRPT] option is selected have been"
^XPD(9.6,13742,1,34,0)="updated to follow the order of menu options requested by the National"
^XPD(9.6,13742,1,35,0)="Surgery Office (NSO)."
^XPD(9.6,13742,1,36,0)=" "
^XPD(9.6,13742,1,37,0)="3. Deactivation of the POSSIBLE ITEM RETENTION (#630) field in the SURGERY"
^XPD(9.6,13742,1,38,0)="(#130) file"
^XPD(9.6,13742,1,39,0)=" "
^XPD(9.6,13742,1,40,0)="The POSSIBLE ITEM RETENTION (#630) field has been marked as "
^XPD(9.6,13742,1,41,0)="UNEDITABLE in the SURGERY (#130) file and will no longer be included in"
^XPD(9.6,13742,1,42,0)="any VistA Surgery input templates for entry or editing. This field will"
^XPD(9.6,13742,1,43,0)="also no longer be required to electronically sign the Nurse Intraoperative"
^XPD(9.6,13742,1,44,0)="report. It will, however, continue to display in completed Nurse"
^XPD(9.6,13742,1,45,0)="Intraoperative Reports for historical cases."
^XPD(9.6,13742,1,46,0)=" "
^XPD(9.6,13742,1,47,0)="4. Correction of spelling for GLASSES/GOOGLES to GLASSES/GOGGLES in the "
^XPD(9.6,13742,1,48,0)="PATIENT PRECAUTIONS (#15) subfield of the LASER PERFORMED (#130.11)"
^XPD(9.6,13742,1,49,0)="multiple in the SURGERY (#130) file for display/print in the Nurse"
^XPD(9.6,13742,1,50,0)="Intraoperative Report."
^XPD(9.6,13742,4,0)="^9.64PA^130^1"
^XPD(9.6,13742,4,130,0)=130
