^XPD(9.6,13669,1,1,0)="VSE Increment 9.2 - SD*5.3*875"
^XPD(9.6,13669,1,2,0)="=============================="
^XPD(9.6,13669,1,3,0)=" "
^XPD(9.6,13669,1,4,0)=" "
^XPD(9.6,13669,1,5,0)="Jira Tickets:"
^XPD(9.6,13669,1,6,0)="============="
^XPD(9.6,13669,1,7,0)="VSE-7046: JS - VistA - Modify SDES2 SEARCH CLINIC ATTRIBUTES RPCs to "
^XPD(9.6,13669,1,8,0)="               return active flag for providers and prohibited clinic flag"
^XPD(9.6,13669,1,9,0)="VSE-7091: BB - VistA - Create an RPC to block PBSP clinic availability"
^XPD(9.6,13669,1,10,0)="VSE-7115: BB - VistA - Modify the appointment request object to return "
^XPD(9.6,13669,1,11,0)="               last 4 of SSN"
^XPD(9.6,13669,1,12,0)="VSE-7140: AP - VistA - Modify SDES GET MISSION ACT AVAIL to return the "
^XPD(9.6,13669,1,13,0)="               Provider ID, and clinic timezone"
^XPD(9.6,13669,1,14,0)="VSE-7288: MD - VistA - Create a cross-reference for the field, PBSP ID , "
^XPD(9.6,13669,1,15,0)="               in the HOSPITAL LOCATION file"
^XPD(9.6,13669,1,16,0)="VSE-7384: BF - VistA - Modify SDES GET CLINICS BY CLIN LIST to return the "
^XPD(9.6,13669,1,17,0)="               properly formatted JSON"
^XPD(9.6,13669,1,18,0)="VSE-7413: LB - VistA - Modify SDES SEARCH CLINIC"
^XPD(9.6,13669,1,19,0)="VSE-7470: LB - VistA - Modify SDES2 UNDO NOSHOW to only close the parent "
^XPD(9.6,13669,1,20,0)="               when all children requests are closed"
^XPD(9.6,13669,1,21,0)="VSE-7485: BB - VistA - Modify SDES2 EDIT CLINIC so that the Proxy user "
^XPD(9.6,13669,1,22,0)="               (SDESOITEAS,SRV) is able to modify the privileged user"
^XPD(9.6,13669,1,23,0)="VSE-7495: BF - VistA - Modify SDES2 QUERY APPT REQUESTS RPC to update the "
^XPD(9.6,13669,1,24,0)="               wait time calculation for recalls"
^XPD(9.6,13669,1,25,0)="VSE-7510: LB - VistA - Modify SDES2 GET APPTS BY CLINIC IEN to return an "
^XPD(9.6,13669,1,26,0)="               error message instead of a hard error"
^XPD(9.6,13669,1,27,0)="VSE-7512: TB - VistA - Update SDES2 CREATE APPT REQ to recognize when the "
^XPD(9.6,13669,1,28,0)="               parent request associated with the RTC being created has an"
^XPD(9.6,13669,1,29,0)="               ORDER ID"
^XPD(9.6,13669,1,30,0)="VSE-7513: BF - VistA - Rewrite SDECRMG2 URGENCY into the SDES2 namespace"
^XPD(9.6,13669,1,31,0)="VSE-7525: BF - VistA - Modify SDES2 QUERY APPT REQUESTS RPC to change the "
^XPD(9.6,13669,1,32,0)="               input parameter to accept the AMIS stop code and convert"
^XPD(9.6,13669,1,33,0)="               the AMIS stop code to the stop code IEN for filtering"
^XPD(9.6,13669,1,34,0)="               records"
^XPD(9.6,13669,1,35,0)="VSE-7529: TB - VistA - SDEC07 Error: invalid provider ID when trying to "
^XPD(9.6,13669,1,36,0)="               schedule Recall (PtCSch) appointment"
^XPD(9.6,13669,1,37,0)="VSE-7550: BB - VistA - Modify SDEC and SDES2 code to not re-sequence the "
^XPD(9.6,13669,1,38,0)="               MRTC children on a cancel where the cancellation reason"
^XPD(9.6,13669,1,39,0)="               does not reopen the children."
^XPD(9.6,13669,1,40,0)="VSE-7552: JS - VistA - Modify SDES2 NO-SHOW RPC to add a flag that will "
^XPD(9.6,13669,1,41,0)="               identify the No-Show as a Recall Appt as opposed to a"
^XPD(9.6,13669,1,42,0)="               regular appt"
^XPD(9.6,13669,1,43,0)="VSE-7553: LB - VistA - Modify SDES2 DISPOSITION APPT REQ RPC logic to"
^XPD(9.6,13669,1,44,0)="               store SDDUZ when calling into the HL7 logic"
^XPD(9.6,13669,1,45,0)="VSE-7554: JS - VistA - Modify SDES2 CREATE APPOINTMENT RPC to fulfill the "
^XPD(9.6,13669,1,46,0)="               parent when all children are dispositioned"
^XPD(9.6,13669,1,47,0)="VSE-7558: TB - VistA - Modify SDES2APPTUTIL to convert FM date to NET "
^XPD(9.6,13669,1,48,0)="               date before calling REQSET^SDEC07A"
^XPD(9.6,13669,1,49,0)="VSE-7647: JS - VistA: Modify SDES2 CREATE APPT REQUEST and SDES Versions "
^XPD(9.6,13669,1,50,0)="VSE-7660: LB - VistA: Update SDES2 CANCEL CLINIC AVAILABILITY to quit out "
^XPD(9.6,13669,1,51,0)="               when DATETIME greater than or equal to ENDDATETIME"
^XPD(9.6,13669,1,52,0)="VSE-7662: DR - VistA: Update data dictionary to allow length of Appt up "
^XPD(9.6,13669,1,53,0)="               to 240"
^XPD(9.6,13669,1,54,0)="VSE-7667: TB - Modify SDES2 CREATE APPOINTMENT"
^XPD(9.6,13669,1,55,0)="VSE-7683: BB - VistA: Rewrite SDES BLOCK AND MOVE in the SDES2 namespace"
^XPD(9.6,13669,1,56,0)=" "
^XPD(9.6,13669,1,57,0)=" "
