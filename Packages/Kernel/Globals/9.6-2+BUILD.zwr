^XPD(9.6,13720,1,76,0)="Additional Information:"
^XPD(9.6,13720,1,77,0)="-----------------------"
^XPD(9.6,13720,1,78,0)="New Service Requests (NSRs):"
^XPD(9.6,13720,1,79,0)="N/A"
^XPD(9.6,13720,1,80,0)=" "
^XPD(9.6,13720,1,81,0)="Patient Safety Issues (PSIs):"
^XPD(9.6,13720,1,82,0)="-----------------------------"
^XPD(9.6,13720,1,83,0)="N/A"
^XPD(9.6,13720,1,84,0)=" "
^XPD(9.6,13720,1,85,0)=" "
^XPD(9.6,13720,1,86,0)="Problem:"
^XPD(9.6,13720,1,87,0)="--------"
^XPD(9.6,13720,1,88,0)="With the implementation of Red Hat Enterprise Linux (RHEL 8) stronger "
^XPD(9.6,13720,1,89,0)="encryption key ECDSA is now available and supported. PPS-N "
^XPD(9.6,13720,1,90,0)="application at this time is using RSA type SSH key for connecting to the "
^XPD(9.6,13720,1,91,0)="PPS-N server to receive the dat file that is used for updating Nation "
^XPD(9.6,13720,1,92,0)="Drug files."
^XPD(9.6,13720,1,93,0)=" "
^XPD(9.6,13720,1,94,0)="New keys added:"
^XPD(9.6,13720,1,95,0)="Elliptic Curve Digital Signature Algorithm (ECDSA)"
^XPD(9.6,13720,1,96,0)=" "
^XPD(9.6,13720,1,97,0)="ECDSA keys can created for encryption length of 256, 384 or 521 bits."
^XPD(9.6,13720,1,98,0)=" "
^XPD(9.6,13720,1,99,0)="Necessary changes are required to allow creation of ECDSA key "
^XPD(9.6,13720,1,100,0)="for the PPS-N application. Support for RSA keys are anticipated to be "
^XPD(9.6,13720,1,101,0)="deprecated in the future, so to maintain Vista's security posture and "
^XPD(9.6,13720,1,102,0)="ensure continuous operation of required Vista processes, software "
^XPD(9.6,13720,1,103,0)="utilizing SSH PKI user keys must be updated to support the stronger ECDSA "
^XPD(9.6,13720,1,104,0)="encryption key. "
^XPD(9.6,13720,1,105,0)=" "
^XPD(9.6,13720,1,106,0)="The modification should allow the creation of any ECDSA keys to be forward"
^XPD(9.6,13720,1,107,0)="compatible when Red Hat Enterprise Linux (RHEL 8) is implemented."
^XPD(9.6,13720,1,108,0)=" "
^XPD(9.6,13720,1,109,0)="Resolution:"
^XPD(9.6,13720,1,110,0)="-----------"
^XPD(9.6,13720,1,111,0)="File PPS-N UPDATE CONTROL (#57.23) field SFTP SSH KEY ENCRYPTION (#41) is "
^XPD(9.6,13720,1,112,0)="modified to add code ECDSA (Elliptic Curve Digital Signature Algorithm)."
^XPD(9.6,13720,1,113,0)=" "
^XPD(9.6,13720,1,114,0)="Modify PSNOSKEY to allow the ECDSA key to be created, viewed, "
^XPD(9.6,13720,1,115,0)="deleted, and update the help text."
^XPD(9.6,13720,1,116,0)=" "
^XPD(9.6,13720,1,117,0)="Routine PSNPARM is modified to use new field ECDSA (#11) in the "
^XPD(9.6,13720,1,118,0)="PPS-N UPDATE CONTROL FILE (#57.23) in option PPS-N Site Parameters "
^XPD(9.6,13720,1,119,0)="(Enter/Edit) to set if ECDSA keys are allowed to be created."
^XPD(9.6,13720,4,0)="^9.64PA^57.23^1"
