^XPD(9.6,13727,1,860,0)="15.(HDSO-????) Diagnosis and Drug Use Evaluation (DUE) info on eRx Print"
^XPD(9.6,13727,1,861,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13727,1,862,0)="   The eRx Print action in the eRx Holding Queue was changed to include two"
^XPD(9.6,13727,1,863,0)="   new sections: Diagnosis and DUE information. These sections will only be"
^XPD(9.6,13727,1,864,0)="   included when the information exists in the eRx. They will look like the"
^XPD(9.6,13727,1,865,0)="   examples below:"
^XPD(9.6,13727,1,866,0)=" "
^XPD(9.6,13727,1,867,0)="   *************************DIAGNOSIS INFORMATION**************************"
^XPD(9.6,13727,1,868,0)="   Primary Dx:"
^XPD(9.6,13727,1,869,0)="   ICD-10 A01.01 TYPHOID MENINGITIS"
^XPD(9.6,13727,1,870,0)="   Typhoid meningitis_Test primary diagnosis"
^XPD(9.6,13727,1,871,0)="   ........................................................................"
^XPD(9.6,13727,1,872,0)="   Secondary Dx:"
^XPD(9.6,13727,1,873,0)="   ICD-10 E11.21 TYPE 2 DIABETES MELLITUS WITH DIABETIC NEPHROPATHY"
^XPD(9.6,13727,1,874,0)="   Test secondary Diagnosis"
^XPD(9.6,13727,1,875,0)=" "
^XPD(9.6,13727,1,876,0)="   *********************PRESCRIBER DRUG USE EVALUATION*********************"
^XPD(9.6,13727,1,877,0)="   Co-Agent: Nsaids (Non-Steroidal Anti-Inflammatory Drug)"
^XPD(9.6,13727,1,878,0)="   Reason: Drug-Allergy"
^XPD(9.6,13727,1,879,0)="   Result: Prescribed w/ acknowledgements"
^XPD(9.6,13727,1,880,0)="   Override: Previously Tolerated"
^XPD(9.6,13727,1,881,0)="   ************************************************************************"
^XPD(9.6,13727,1,882,0)="  "
^XPD(9.6,13727,1,883,0)="16. INC26069186 - eRx Prescription # wrong in file ###.## Order DEA Archive"
^XPD(9.6,13727,1,884,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13727,1,885,0)="   For eRx prescriptions, file #101.52 ORDER DEA ARCHIVE field #1 "
^XPD(9.6,13727,1,886,0)="   PRESCRIPTION NUMBER is storing the wrong value. The value stored is the "
^XPD(9.6,13727,1,887,0)="   IEN of the eRx's pending order from file 52.41 OUTPATIENT PENDING ORDER "
^XPD(9.6,13727,1,888,0)="   before it is finished. "
^XPD(9.6,13727,1,889,0)="  "
^XPD(9.6,13727,1,890,0)="   When viewed from a global listing, the node 0 piece 2 shows an IEN "
^XPD(9.6,13727,1,891,0)="   appended with an ""S"", which is how file 100 stores a PACKAGE REFERENCE to "
^XPD(9.6,13727,1,892,0)="   a PENDING OUTPATIENT ORDERS file #52.41."
^XPD(9.6,13727,1,893,0)="    "
^XPD(9.6,13727,1,894,0)="   This erroneous display occurs when completing the eRX order in Complete "
^XPD(9.6,13727,1,895,0)="   Orders from eRx [PSO ERX FINISH] and can be viewed both before and after "
^XPD(9.6,13727,1,896,0)="   finishing the prescription in Patient Prescription Processing [PSO LM "
^XPD(9.6,13727,1,897,0)="   BACKDOOR ORDERS]."
^XPD(9.6,13727,1,898,0)="  "
^XPD(9.6,13727,1,899,0)="   Resolution:"
^XPD(9.6,13727,1,900,0)="   -----------"
^XPD(9.6,13727,1,901,0)="   This will need to be addressed with changes to Pharmacy code as well as "
^XPD(9.6,13727,1,902,0)="   CPRS code.  This patch will address the pharmacy changes. This patch "
^XPD(9.6,13727,1,903,0)="   does not address the existing PENDING OUTPATIENT ORDERS file #52.41 that"
^XPD(9.6,13727,1,904,0)="   exist in ORDER DEA ARCHIVE INFO file #101.52, that will be addressed by"
^XPD(9.6,13727,1,905,0)="   a follow up patch from CPRS.  This patch corrects the field value going "
^XPD(9.6,13727,1,906,0)="   forward."
^XPD(9.6,13727,1,907,0)="   "
^XPD(9.6,13727,1,908,0)="   Routine PSOORFI1 is modified to allow array PSOCSP to be setup for eRX "
^XPD(9.6,13727,1,909,0)="   orders the same as they are for pending orders signed in CPRS.  This "
^XPD(9.6,13727,1,910,0)="   array is needed in the Patient Prescription Processing finishing process."
^XPD(9.6,13727,1,911,0)="    "
^XPD(9.6,13727,1,912,0)="   Routine PSON52 is modified to allow eRX orders that do not have a "
^XPD(9.6,13727,1,913,0)="   SIGNATURE STATUS field #117 set in PENDING OUTPATIENT ORDERS file "
^XPD(9.6,13727,1,914,0)="   #52.41.  This will allow the process to flow into code that allows the "
^XPD(9.6,13727,1,915,0)="   PRESCRIPTION file #52 IEN to be set into the PRESCRIPTION NUMBER field"
^XPD(9.6,13727,1,916,0)="   #1 of the ORDER DEA ARCHIVE INFO file #101.52"
^XPD(9.6,13727,1,917,0)="  "
^XPD(9.6,13727,1,918,0)="   Routine PSOERX1F is modified to delete the PRESCRIPTION NUMBER field #1"
^XPD(9.6,13727,1,919,0)="   of the ORDER DEA ARCHIVE INFO file #101.52 after processing returns from "
^XPD(9.6,13727,1,920,0)="   calling protocol PS EVSEND OR via routine EN^PSOHLSNC during PSO ERX "
^XPD(9.6,13727,1,921,0)="   FINISH processing.  This removes the #52.41 IEN and thus allows PSON52 to "
^XPD(9.6,13727,1,922,0)="   update it with the correct IEN to file #52.  This change will likely not "
^XPD(9.6,13727,1,923,0)="   be released but is necessary for testing this patch until the CPRS "
^XPD(9.6,13727,1,924,0)="   release is ready."
