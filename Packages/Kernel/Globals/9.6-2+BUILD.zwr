^XPD(9.6,14019,1,889,0)="    AS DIRECTED BY PROVIDER AFTER SURGERY | DAILY"
^XPD(9.6,14019,1,890,0)="   _______________________________________|___________________________________"
^XPD(9.6,14019,1,891,0)="   Quantity: 28                           |Quantity: 28"
^XPD(9.6,14019,1,892,0)="   Dispense Unit:                         |Dispense Unit: TAB"
^XPD(9.6,14019,1,893,0)="   _______________________________________|__________________________________"
^XPD(9.6,14019,1,894,0)="   Days Supply: 14     Refills: 0         |Days Supply: 14     Refills: 11"
^XPD(9.6,14019,1,895,0)="   _______________________________________|__________________________________"
^XPD(9.6,14019,1,896,0)="   ACTION on SUGGESTION: (A)CCEPT  (V)IEW RX  (F)ORGET  (E)XIT: EXIT// V"
^XPD(9.6,14019,1,897,0)=" "
^XPD(9.6,14019,1,898,0)="    _____________________________NOTICE______________________________________   "
^XPD(9.6,14019,1,899,0)="                                   "
^XPD(9.6,14019,1,900,0)="    You will be taken to the VistA Rx#9999999 that was entered in the past "
^XPD(9.6,14019,1,901,0)="    for the same Product (NDC/SIG/Qty/Days Supply/# of Refills/Substitution) "
^XPD(9.6,14019,1,902,0)="    for a different eRx. This VistA Rx may or may not be for the same patient"
^XPD(9.6,14019,1,903,0)="    in this eRx being processed."
^XPD(9.6,14019,1,904,0)="    _________________________________________________________________________"
