^XPD(9.6,13915,1,1,0)="Jira Tickets Sprint 12.2 - SD*5.3*901"
^XPD(9.6,13915,1,2,0)="===================================================== "
^XPD(9.6,13915,1,3,0)="VSE-9049: MB - VistA: Update the SDES2 PRINT APPT LETTERS RPC to process "
^XPD(9.6,13915,1,4,0)="          all Appointment IENs in the SDINPUT(""Appointment IEN"") array"
^XPD(9.6,13915,1,5,0)="VSE-9106: JS - VistA: Modify SDES2 EDIT PAT DEMOGRAPHICS to update "
^XPD(9.6,13915,1,6,0)="          temporary address fields"
^XPD(9.6,13915,1,7,0)="VSE-9301: BB - VistA: Create a new SDES2 RPC that returns the letter "
^XPD(9.6,13915,1,8,0)="          types and modify SDES2ENTERLETTER routine to not use $$FIND1"
^XPD(9.6,13915,1,9,0)="          when finding letter type"
^XPD(9.6,13915,1,10,0)="VSE-9353: JV - VistA: Update all SDES RPCs for restrictions"
^XPD(9.6,13915,1,11,0)="VSE-9356: JC - VistA: Update all SDES2 RPCs for restrictions"
^XPD(9.6,13915,1,12,0)="VSE-9373: JJ - VistA: Prevent null comment/note audit logs for Create and "
^XPD(9.6,13915,1,13,0)="               Edit Recall/Appt Request and Appointments for SDES/SDES2"
^XPD(9.6,13915,1,14,0)="VSE-9384: JV - VistA: Modify SDES2 GET CLINIC AVAIL BY SVC to only return "
^XPD(9.6,13915,1,15,0)="          on exact matches"
^XPD(9.6,13915,1,16,0)="VSE-9466: LB - VistA: Remove SDES2 GET CONSULT CLINIC INFO from production"
^XPD(9.6,13915,1,17,0)="          as it was never released"
^XPD(9.6,13915,1,18,0)=" "
^XPD(9.6,13915,1,19,0)=" "
