^XPD(9.6,13652,0)="PSB*3.0*145^177^0^3240229^y"
^XPD(9.6,13652,1,0)="^^34^34^3240229^"
^XPD(9.6,13652,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^XPD(9.6,13652,1,2,0)=" "
^XPD(9.6,13652,1,3,0)="1. INC30190209 - SATURDAY SCHEDULE PROMPT BCMA VDL TO ADMINISTER DRUG SAT "
^XPD(9.6,13652,1,4,0)="AND TUESDAY"
^XPD(9.6,13652,1,5,0)=" "
^XPD(9.6,13652,1,6,0)="Problem:"
^XPD(9.6,13652,1,7,0)="--------"
^XPD(9.6,13652,1,8,0)="SATURDAY, pharmacy standard schedule prompts BCMA Virtual Due List to "
^XPD(9.6,13652,1,9,0)="also administer the drug on Tuesday."
^XPD(9.6,13652,1,10,0)=" "
^XPD(9.6,13652,1,11,0)="Resolution:"
^XPD(9.6,13652,1,12,0)="-----------"
^XPD(9.6,13652,1,13,0)="The BCMA code (routine PSBVDLU1) was trying to decide if the med should "
^XPD(9.6,13652,1,14,0)="be given on Tuesday using the 2 letter code TU, the schedule name "
^XPD(9.6,13652,1,15,0)="SATURDAY contains TU and determines that it should be given on Tuesday, "
^XPD(9.6,13652,1,16,0)="which was incorrect.  The code is modified to prevent this from occurring."
^XPD(9.6,13652,1,17,0)=" "
^XPD(9.6,13652,1,18,0)="Technical Resolution:"
^XPD(9.6,13652,1,19,0)="---------------------"
^XPD(9.6,13652,1,20,0)="Lines OKAY+40 through OKAY+43 is changed from"
^XPD(9.6,13652,1,21,0)=" S PSBDOW=$P(""SU^MO^TU^WE^TH^FR^SA"",U,%Y+1) ;p145"
^XPD(9.6,13652,1,22,0)=" I $F(PSBSCH,PSBDOW)>0 S PSBOKAY=1 Q PSBOKAY"
^XPD(9.6,13652,1,23,0)=" S PSBOKAY=0"
^XPD(9.6,13652,1,24,0)=" Q PSBOKAY"
^XPD(9.6,13652,1,25,0)=" "
^XPD(9.6,13652,1,26,0)="To"
^XPD(9.6,13652,1,27,0)=" ;PSB*3*145 Prevent Saturday schedule from being given on Tuesday"
^XPD(9.6,13652,1,28,0)=" N PSBSCH1 S PSBSCH1=PSBSCH"
^XPD(9.6,13652,1,29,0)=" I PSBSCH1[""SATU"" S PSBSCH1=$TR(PSBSCH1,""SATU"",""SATA"")"
^XPD(9.6,13652,1,30,0)=" S PSBDOW=$P(""SU^MO^TU^WE^TH^FR^SA"",U,%Y+1)"
^XPD(9.6,13652,1,31,0)=" ;I $F(PSBSCH,PSBDOW)>0 S PSBOKAY=1 Q PSBOKAY"
^XPD(9.6,13652,1,32,0)=" I $F(PSBSCH1,PSBDOW)>0 S PSBOKAY=1 Q PSBOKAY"
^XPD(9.6,13652,1,33,0)=" S PSBOKAY=0"
^XPD(9.6,13652,1,34,0)=" Q PSBOKAY"
^XPD(9.6,13652,4,0)="^9.64PA^^"
^XPD(9.6,13652,6)="^125"
^XPD(9.6,13652,6.3)=2
