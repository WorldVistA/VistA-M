^XPD(9.6,13560,1,885,0)="19.Ticket INC28342622  - PSOERXR1 - DEA # display"
^XPD(9.6,13560,1,886,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13560,1,887,0)="   After the release of patch PSO*7*545 it was reported that the VistA "
^XPD(9.6,13560,1,888,0)="   Provider DEA# was no long being displayed on the eRx Holding Queue Display"
^XPD(9.6,13560,1,889,0)="   screen. This addresses the problem."
^XPD(9.6,13560,1,890,0)=" "
^XPD(9.6,13560,1,891,0)="20.Ticket INC28554236 - Un-Accept/EC/HC Hold Issue"
^XPD(9.6,13560,1,892,0)="   ---------------------------------------------------------------------------"
^XPD(9.6,13560,1,893,0)="   It was reported that an eRx record was wrongly automatically being marked"
^XPD(9.6,13560,1,894,0)="   as PR (PROCESSED) after the user un-accepted an order from the Pending "
^XPD(9.6,13560,1,895,0)="   Queue back into the eRx Holding Queue and a placed a Change Request for it."
^XPD(9.6,13560,1,896,0)="   The PR status was assigned as soon as the user removed the eRx record from"
^XPD(9.6,13560,1,897,0)="   Hold."
^XPD(9.6,13560,4,0)="^9.64PA^52.49^2"
^XPD(9.6,13560,4,52.35,0)=52.35
^XPD(9.6,13560,4,52.35,222)="y^y^f^^^^n"
