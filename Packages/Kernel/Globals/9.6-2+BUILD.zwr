^XPD(9.6,13627,0)="SR*3.0*214^127^0^3231205^y"
^XPD(9.6,13627,1,0)="^^16^16^3231204^"
^XPD(9.6,13627,1,1,0)="The patch addresses one (2) issues: "
^XPD(9.6,13627,1,2,0)=" "
^XPD(9.6,13627,1,3,0)="1. In certain circumstances if a value is entered in the REFERRING"
^XPD(9.6,13627,1,4,0)="PHYSICIAN field (#23) of the SURGERY FILE (#130) in a surgery case the"
^XPD(9.6,13627,1,5,0)="value is carried over and DISPLAYS in the SPECIAL EQUIPMENT (#680),"
^XPD(9.6,13627,1,6,0)="PLANNED IMPLANTS (#681), SPECIAL SUPPLIES (#682), SPECIAL INSTRUMENTS"
^XPD(9.6,13627,1,7,0)="(#683) or PHARMACY ITEMS (#684) fields."
^XPD(9.6,13627,1,8,0)=" "
^XPD(9.6,13627,1,9,0)="2. In certain circumstances ""Select Surgical Specialty:"" displays "
^XPD(9.6,13627,1,10,0)="erroneously instead of the field name/title when adding a new entry to "
^XPD(9.6,13627,1,11,0)="several multiples in the SURGERY file (#130) when entering a new surgery "
^XPD(9.6,13627,1,12,0)="case using the ""Operation Menu"".  The multiples are: OTHER PROCEDURES "
^XPD(9.6,13627,1,13,0)="(#.42), OTHER PREOP DIAGNOISIS (#.72)"
^XPD(9.6,13627,1,14,0)="SURGERY POSITION (#65), REQ BLOOD KIND (#1.05), SPECIAL EQUIPMENT (#680), "
^XPD(9.6,13627,1,15,0)="PLANNED IMPLANTS (#681), SPECIAL SUPPLIES (#682), SPECIAL INSTRUMENTS "
^XPD(9.6,13627,1,16,0)="(#683), PHARMACY ITEMS (#684), and REFERRING PHYSICIAN (#23)."
^XPD(9.6,13627,4,0)="^9.64PA^^"
^XPD(9.6,13627,6)="^199"
^XPD(9.6,13627,6.3)=3
