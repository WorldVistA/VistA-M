^XPD(9.6,13861,0)="CPRS PACT Act Updates 1.0^^1^3241206^y"
^XPD(9.6,13861,1,0)="^^7^7^3241004^^"
^XPD(9.6,13861,1,1,0)="This is the combined build for PACT Act updates."
^XPD(9.6,13861,1,2,0)=" "
^XPD(9.6,13861,1,3,0)="Please see the associated patch descriptions on FORUM for full details."
^XPD(9.6,13861,1,4,0)=" "
^XPD(9.6,13861,1,5,0)=" - OR*3.0*628"
^XPD(9.6,13861,1,6,0)=" - TIU*1.0*370"
^XPD(9.6,13861,1,7,0)=" - PXRM*2.0*89"
^XPD(9.6,13861,6)=2
^XPD(9.6,13861,6.3)=13
^XPD(9.6,13861,10,0)="^9.63^3^3"
^XPD(9.6,13861,10,1,0)="OR*3.0*628^1"
^XPD(9.6,13861,10,2,0)="TIU*1.0*370^1"
^XPD(9.6,13861,10,3,0)="PXRM*2.0*89^1"
