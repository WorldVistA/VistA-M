^XPD(9.6,13886,1,1,0)="Jira Tickets Sprint 11.7 - VS GUI 1.7.64 - SD*5.3*898"
^XPD(9.6,13886,1,2,0)="===================================================== "
^XPD(9.6,13886,1,3,0)=" "
^XPD(9.6,13886,1,4,0)="VSE-7857: TB - VistA: Return both provider name and title in the clinic "
^XPD(9.6,13886,1,5,0)="          object"
^XPD(9.6,13886,1,6,0)="VSE-8858: BF - Vista: User is unable to cancel entire day of timeslots for"
^XPD(9.6,13886,1,7,0)="          a second time."
^XPD(9.6,13886,1,8,0)="VSE-8958: JJ - VistA: Modify SDES2 REACTIVATE CLINIC to allow todays date"
^XPD(9.6,13886,1,9,0)="VSE-9000: TB - VistA: Modify SDES2 GET CLINICS BY CLIN LIST to process "
^XPD(9.6,13886,1,10,0)="          all clinics IENs in the CLINIC array"
^XPD(9.6,13886,1,11,0)="VSE-9045: JS - VistA: Create 3 new SDES2 RPC's - SDES2 CREATE LETTER, "
^XPD(9.6,13886,1,12,0)="          SDES2 EDIT LETTER and SDES2 DELETE LETTER"
^XPD(9.6,13886,1,13,0)="VSE-9067: MB - VistA: The end user is receiving an error when trying to "
^XPD(9.6,13886,1,14,0)="          schedule in ISS- {""Appointment"": {""IEN"":""""}"
^XPD(9.6,13886,1,15,0)="VSE-9071: JS - VistA: Create an SDES2 SEARCH LETTER RPC to return back "
^XPD(9.6,13886,1,16,0)="          the IEN and names of letters"
^XPD(9.6,13886,1,17,0)="VSE-9076: BF - VistA: Block and move error validation"
^XPD(9.6,13886,1,18,0)="VSE-9077: TB - VistA: The SDES2 print appointment letters does not print "
^XPD(9.6,13886,1,19,0)="          a temporary address that is active on a patient record"
^XPD(9.6,13886,1,20,0)=" "
^XPD(9.6,13886,1,21,0)=" "
^XPD(9.6,13886,1,22,0)="Files:"
^XPD(9.6,13886,1,23,0)="======"
^XPD(9.6,13886,1,24,0)="SDES ERROR CODES - VSE-9045  (620-630)"
^XPD(9.6,13886,1,25,0)="                 - VSE-9071  (631"
