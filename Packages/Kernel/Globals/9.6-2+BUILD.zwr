^XPD(9.6,14113,1,10,0)="                request."
^XPD(9.6,14113,1,11,0)="VSE-10960: MB - MRTC Parent Appt IEN is not updated when Blocking and"
^XPD(9.6,14113,1,12,0)="                Moving an existing appt."
^XPD(9.6,14113,1,13,0)="VSE-10962: LB - Create a Post install report of all Appointments with an"
^XPD(9.6,14113,1,14,0)="                EAS number that were made prior to the installation of"
^XPD(9.6,14113,1,15,0)="                patch 910 that start date is between 3/1/2026 and"
^XPD(9.6,14113,1,16,0)="                3/8/2026. "
^XPD(9.6,14113,1,17,0)="VSE-10967: BB - Consecutive slots being returned are not being returned at"
^XPD(9.6,14113,1,18,0)="                a 5 week interval."
^XPD(9.6,14113,1,19,0)=" "
^XPD(9.6,14113,1,20,0)=" "
^XPD(9.6,14113,1,21,0)="PI 14.3 - 10/16-10/29 - SD*5.3*922"
^XPD(9.6,14113,1,22,0)="=================================="
^XPD(9.6,14113,1,23,0)=" "
^XPD(9.6,14113,1,24,0)="14.3 Tickets:"
^XPD(9.6,14113,1,25,0)="============="
^XPD(9.6,14113,1,26,0)="VSE-10472: TB - Remove the Initial of the Patient's Last Name and Last 4"
^XPD(9.6,14113,1,27,0)="                Numbers of their SSN from Scheduling Letters."
^XPD(9.6,14113,1,28,0)="VSE-10543: JJ - Modify the validation within create clinic availability "
^XPD(9.6,14113,1,29,0)="                to allow for a slot to be 0 if the stop code is 130"
^XPD(9.6,14113,1,30,0)="                EMERGENCY DEPT."
^XPD(9.6,14113,1,31,0)="VSE-10892: TW - VistA: Update SDEC logic that deals with creating a new"
^XPD(9.6,14113,1,32,0)="                contact attempt to use the SDES2 logic."
^XPD(9.6,14113,1,33,0)="VSE-10930: GW - VistA: Modify SDES2 CANCEL CLINIC AVAIL to strip out any"
^XPD(9.6,14113,1,34,0)="                control character if it is sent in as an input parameter"
^XPD(9.6,14113,1,35,0)="VSE-11000: MD - Update SDES2 CANCEL CLINIC AVAIL description."
^XPD(9.6,14113,1,36,0)="VSE-11002: HC - VistA: Modify SDES2 GET APPT RPCs to include the NonCount"
^XPD(9.6,14113,1,37,0)="                value in the clinic object."
^XPD(9.6,14113,1,38,0)="VSE-11058: BB - VistA: Modify SDES2 GET APPT REQ RPCs to get the MRTC "
^XPD(9.6,14113,1,39,0)="                PatientIndicatedDate from the child request, not the"
^XPD(9.6,14113,1,40,0)="                parents list."
^XPD(9.6,14113,1,41,0)=" "
^XPD(9.6,14113,1,42,0)="Option:"
^XPD(9.6,14113,1,43,0)="======="
^XPD(9.6,14113,1,44,0)=" "
