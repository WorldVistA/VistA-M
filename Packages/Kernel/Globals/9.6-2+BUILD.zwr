^XPD(9.6,14043,0)="PSN*4.0*576^59^0^3250724^y"
^XPD(9.6,14043,1,0)="^^7^7^3250427^"
^XPD(9.6,14043,1,1,0)="This patch, along with other patches, adds Pharmacogenomic (PGx) order"
^XPD(9.6,14043,1,2,0)="checking to medication orders entered through Inpatient Medications,"
^XPD(9.6,14043,1,3,0)="Outpatient Pharmacy and Computerized Patient Record System (CPRS). A "
^XPD(9.6,14043,1,4,0)="patient's genomic test results will be retrieved from the Health Data"
^XPD(9.6,14043,1,5,0)="Repository (HDR), and along with the prospective drug(s) of a medication"
^XPD(9.6,14043,1,6,0)="order is sent to the vendor to retrieve interactions between the patient's"
^XPD(9.6,14043,1,7,0)="genes and the prospective drug(s)."
