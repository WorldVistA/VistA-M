^XPD(9.6,13901,1,0)="^^50^50^3250206^"
^XPD(9.6,13901,1,1,0)="Jira Tickets Sprint 12.1 - SD*5.3*899"
^XPD(9.6,13901,1,2,0)="====================================================="
^XPD(9.6,13901,1,3,0)=" "
^XPD(9.6,13901,1,4,0)="VSE-8975: TB - VistA: Modify SDES2CREATECLIN to correctly return an error "
^XPD(9.6,13901,1,5,0)="          when saving the clinic fails "
^XPD(9.6,13901,1,6,0)="VSE-9024  JV - VistA: Modify the RPC documentation for SDES2 EDIT CLINIC "
^XPD(9.6,13901,1,7,0)="VSE-9042: MB - VistA: Blocking and moving without a appointment IEN is "
^XPD(9.6,13901,1,8,0)="          causing an error"
^XPD(9.6,13901,1,9,0)="VSE-9156: JJ - VistA: Modify SDES2 CREATE APPT REQ to update the "
^XPD(9.6,13901,1,10,0)="          DATE/TIME ENTERED (field 9.5)"
^XPD(9.6,13901,1,11,0)="VSE-9281: MB - VistA: Long search strings are sometime erroneously sent "
^XPD(9.6,13901,1,12,0)="          in and causing a <SUBSCRIPT>error"
^XPD(9.6,13901,1,13,0)="VSE-9296: JJ - VistA: Modify SDES2 CREATE CLINIC AVAIL to quit error and "
^XPD(9.6,13901,1,14,0)="          quit out if length of appointment is missing"
^XPD(9.6,13901,1,15,0)="VSE-9340: BF - VistA: Create SDES2 version of SDES GET DIVISION LIST "
^XPD(9.6,13901,1,16,0)="VSE-9348: BB - VistA: When multiple clinics are searched the results are "
^XPD(9.6,13901,1,17,0)="          including incomplete results from the previous clinic."
^XPD(9.6,13901,1,18,0)="VSE-9349: TB - VistA: Last name initial missing from letter"
^XPD(9.6,13901,1,19,0)="VSE-9364: LB - VistA: Banner for decommissioning Set Up A Clinic option"
^XPD(9.6,13901,1,20,0)=" "
