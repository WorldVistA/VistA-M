^XPD(9.6,14023,1,217,0)="Remove Copied (Custom) ASAP Definitions in Restore (Backout) Process"
^XPD(9.6,14023,1,218,0)="--------------------------------------------------------------------------"
^XPD(9.6,14023,1,219,0)="PSO77244"
^XPD(9.6,14023,1,220,0)=" "
^XPD(9.6,14023,1,221,0)="--------------------------------------------------------------------------"
^XPD(9.6,14023,1,222,0)="Change ""Version"" to ""Ver"" in PSO SPMP ASAP DEFINITIONS Screen Title"
^XPD(9.6,14023,1,223,0)="-------------------------------------------------------------------"
^XPD(9.6,14023,1,224,0)=" The Screen Title in the View/Edit ASAP Definitions [PSO SPMP ASAP "
^XPD(9.6,14023,1,225,0)=" DEFINITIONS] option has been changed to display the word ""Ver"" instead of"
^XPD(9.6,14023,1,226,0)=" ""Version"" to accomodate long ASAP definition names, and to avoid "
^XPD(9.6,14023,1,227,0)=" truncating the ASAP definition name or the asterisk indicating the "
^XPD(9.6,14023,1,228,0)=" definition is a custom copied version."
^XPD(9.6,14023,1,229,0)=" "
^XPD(9.6,14023,1,230,0)="--------------------------------------------------------------------------"
^XPD(9.6,14023,1,231,0)="Environment Check"
^XPD(9.6,14023,1,232,0)="--------------------------------------------------------------------------"
^XPD(9.6,14023,1,233,0)="An environment check runs during the loading of this patch (prior to "
^XPD(9.6,14023,1,234,0)="installation) to verify there are no custom versions of ASAP definitions "
^XPD(9.6,14023,1,235,0)="4.2A, 4.2B, or 5.0 in the STANDARD sub-file (#58.4001) of the SPMP ASAP"
^XPD(9.6,14023,1,236,0)="RECORD DEFINITION file (#58.4). If custom versions of any of these ASAP "
^XPD(9.6,14023,1,237,0)="definitions are found, the installation is halted and the installer is "
^XPD(9.6,14023,1,238,0)="instructed to have the definitions removed or renamed prior to installing "
^XPD(9.6,14023,1,239,0)="the patch."
^XPD(9.6,14023,4,0)="^9.64PA^58.4^1"
^XPD(9.6,14023,4,58.4,0)=58.4
