^XPD(9.6,14019,1,293,0)="   Copy PATIENT INSTRUCTIONS from Rx #3004815? YES// "
^XPD(9.6,14019,1,294,0)=" "
^XPD(9.6,14019,1,295,0)="   a)If YES is chosen by the user, all fields on the eRx Drug Validation screen"
^XPD(9.6,14019,1,296,0)="     will have its fields updated with any available data."
^XPD(9.6,14019,1,297,0)="     "
