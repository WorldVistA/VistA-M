^XPD(9.6,13560,1,518,0)="    *******************************   WARNING(S)  ***************************"
^XPD(9.6,13560,1,519,0)="    The following VistA Patient(s) has been identified as potential"
^XPD(9.6,13560,1,520,0)="    duplicate(s):"
^XPD(9.6,13560,1,521,0)="      42211-PHWWDY,QLYJH H  09/30/1930  101097105  CASA GRANDA,FL"
^XPD(9.6,13560,1,522,0)="      42737-PHWWDY,QLYJH H  05/04/1934  101068053  SHADY GROVE,DE"
