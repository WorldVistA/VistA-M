^XPD(9.6,14118,0)="HBH*1.0*36^152^0^3250410^y"
^XPD(9.6,14118,1,0)="^^6^6^3250410^^"
^XPD(9.6,14118,1,1,0)="This patch addresses one issue:"
^XPD(9.6,14118,1,2,0)=" "
^XPD(9.6,14118,1,3,0)="It is possible to run options ""Build/Verify Transmission File"" [HBHCFILE] "
^XPD(9.6,14118,1,4,0)="and ""Transmit File to Austin"" [HBHCXMT] simultaneously.  When this "
^XPD(9.6,14118,1,5,0)="happens, the Build/Verify job can delete the HBHC TRANSMIT (#634) file "
^XPD(9.6,14118,1,6,0)="out from underneath the Transmit job and cause hard error DQ^HBHCXMT.   "
^XPD(9.6,14118,4,0)="^9.64PA^^"
^XPD(9.6,14118,6)="^32"
^XPD(9.6,14118,6.3)=1
^XPD(9.6,14118,"ABPKG")="n"
^XPD(9.6,14118,"KRN",0)="^9.67PA^18.12^26"
