^XPD(9.6,13561,0)="GMRA*4.0*70^71^0^3230921^y"
^XPD(9.6,13561,1,0)="^^11^11^3230912^^"
^XPD(9.6,13561,1,1,0)="This patch will resolve the following issue:"
^XPD(9.6,13561,1,2,0)="  "
^XPD(9.6,13561,1,3,0)="It was reported that a hard error was encountered when the reporting "
^XPD(9.6,13561,1,4,0)="site, using CPRS, placed an inpatient medication order for hydroxyzine "
^XPD(9.6,13561,1,5,0)="for a patient that has noted severe allergic reactions to hydroxyzine. "
^XPD(9.6,13561,1,6,0)="The error caused CPRS to shut down and prevented the user from further "
^XPD(9.6,13561,1,7,0)="processing the order. "
^XPD(9.6,13561,1,8,0)=" "
^XPD(9.6,13561,1,9,0)="The error encountered is as follows: "
^XPD(9.6,13561,1,10,0)=" "
^XPD(9.6,13561,1,11,0)="<SUBSCRIPT>DRUG+95^GMRAOR *ITEMS() Subscript 1 > 511"
