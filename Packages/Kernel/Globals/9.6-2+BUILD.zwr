^XPD(9.6,13566,1,3,0)=" "
^XPD(9.6,13566,1,4,0)="Jira Tickets:"
^XPD(9.6,13566,1,5,0)="============="
^XPD(9.6,13566,1,6,0)="VSE-5546: TB - VistA - Create a new RPC in the SDES2 namespace to return"
^XPD(9.6,13566,1,7,0)="          the national and local help links"
^XPD(9.6,13566,1,8,0)="VSE-5829: BB - VistA is duplicating appointments in PCE and "
^XPD(9.6,13566,1,9,0)="          disassociating progress notes from the original encounter (Guam)"
^XPD(9.6,13566,1,10,0)="VSE-6127: BF - VistA - Possible defect in SDES CREATE RECALL REQ 2"
^XPD(9.6,13566,1,11,0)="VSE-6143: JS- VistA: Create a new RPC in the SDES2 namespace to record "
^XPD(9.6,13566,1,12,0)="          demographics verified date"
^XPD(9.6,13566,1,13,0)="VSE-6176: TB - VistA - Modify appointment request object to return the "
^XPD(9.6,13566,1,14,0)="          clinic stop code"
^XPD(9.6,13566,1,15,0)="VSE-6201: AP - VistA - Rewrite SDEC EP PT INFO in the SDES2 namespace"
^XPD(9.6,13566,1,16,0)="VSE-6276: BF - VistA - Fix <UNDEFINED> error in SDES2VALUTIL"
^XPD(9.6,13566,1,17,0)=" "
^XPD(9.6,13566,1,18,0)=" "
^XPD(9.6,13566,1,19,0)="VSE Increment 8.12 - SD*5.3*861 - GUI v 1.7.49"
