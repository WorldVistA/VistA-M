^XPD(9.6,13566,1,21,0)=" "
^XPD(9.6,13566,1,22,0)="Jira Tickets:"
^XPD(9.6,13566,1,23,0)="============="
^XPD(9.6,13566,1,24,0)="VSE-5530: AP - VistA: Create a new version of SDES GET APPTREQ BY INST to "
^XPD(9.6,13566,1,25,0)="          retrieve appointment requests for Consults and Recall Reminders"
^XPD(9.6,13566,1,26,0)="VSE-6141: BB - VistA: Add the patient search return to SDES2 GET LAST "
^XPD(9.6,13566,1,27,0)="          SELECTED PAT"
^XPD(9.6,13566,1,28,0)="VSE-6205: TB - VistA: Rewrite SDES REACTIVATE CLINIC in SDES2 namespace"
^XPD(9.6,13566,1,29,0)="          to return an error if a duplicate clinic will be created"
^XPD(9.6,13566,1,30,0)="VSE-6206: BF - VistA: Modify SDES SEARCH CLINIC ATTRIBUTES to search for "
^XPD(9.6,13566,1,31,0)="          a clinic by abbreviation"
^XPD(9.6,13566,1,32,0)="VSE-6279: LB - VistA: Create a new RPC in the SDES2 namespace to restore "
^XPD(9.6,13566,1,33,0)="          clinic availability"
^XPD(9.6,13566,1,34,0)="VSE-6294: BB - VistA: Create a new RPC in the SDES2 namespace to return "
^XPD(9.6,13566,1,35,0)="          Expanded Entry Fields"
^XPD(9.6,13566,1,36,0)="VSE-6328: JS - VistA: Modify SDES2 GET PATIENT MED LIST"
