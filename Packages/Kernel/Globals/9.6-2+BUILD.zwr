^XPD(9.6,13843,0)="VIAB*1.0*24^223^0^3231218^y"
^XPD(9.6,13843,1,0)="^^18^18^3231218^"
^XPD(9.6,13843,1,1,0)="Description:"
^XPD(9.6,13843,1,2,0)="==========="
^XPD(9.6,13843,1,3,0)=" "
^XPD(9.6,13843,1,4,0)="This patch addresses the return text value from the Bed Management System"
^XPD(9.6,13843,1,5,0)="(BMS) LISTORDERACTIONS call when the result string exceeds a number of "
^XPD(9.6,13843,1,6,0)="characters."
^XPD(9.6,13843,1,7,0)=" "
^XPD(9.6,13843,1,8,0)="Problem: LISTORDERACTIONS uses the LIST^DIC call within its code.  If the"
^XPD(9.6,13843,1,9,0)="size of the Order's Order Text field is too wordy and exceeds a number of"
^XPD(9.6,13843,1,10,0)="characters, LIST^DIC returns an 'overflow' error ""The data requested for"
^XPD(9.6,13843,1,11,0)="the record is too long to pack together."" and the result doesn't pass over"
^XPD(9.6,13843,1,12,0)="to BMS."
^XPD(9.6,13843,1,13,0)=" "
^XPD(9.6,13843,1,14,0)="Resolution: In an effort to pass the result to BMS, the text will get "
^XPD(9.6,13843,1,15,0)="truncated after 3675 characters with the trailing tag:"
^XPD(9.6,13843,1,16,0)=" "
^XPD(9.6,13843,1,17,0)="""<*NOTE: order text reached max length, please check appropriate system "
^XPD(9.6,13843,1,18,0)="for full order text*>"""
^XPD(9.6,13843,4,0)="^9.64PA^^"
^XPD(9.6,13843,6)="^23"
^XPD(9.6,13843,6.3)=3
^XPD(9.6,13843,"ABPKG")="n"
^XPD(9.6,13843,"KRN",0)="^9.67PA^1.5^25"
