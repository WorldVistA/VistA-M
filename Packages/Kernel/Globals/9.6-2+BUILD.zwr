^XPD(9.6,13620,0)="SD*5.3*869^48^0^3240201^y"
^XPD(9.6,13620,1,0)="^^115^115^3240201^"
^XPD(9.6,13620,1,1,0)="VSE Increment 8.18 - SD_5_3_869 - GUI v 1.7.53"
^XPD(9.6,13620,1,2,0)=" "
^XPD(9.6,13620,1,3,0)="Tickets:"
^XPD(9.6,13620,1,4,0)="========"
^XPD(9.6,13620,1,5,0)="VSE-6139: TB - VistA: Retire RPCs 90 days post patch 853"
^XPD(9.6,13620,1,6,0)="VSE-6469: BF - SDES2 Priority 1: Rewrite SDES CREATE APPT REQ in the "
^XPD(9.6,13620,1,7,0)="          SDES2 namespace."
^XPD(9.6,13620,1,8,0)="VSE-6473: BF - SDES2 Priority 3: Rewrite SDES EDIT APPT REQ in the SDES2 "
^XPD(9.6,13620,1,9,0)="          namespace."
^XPD(9.6,13620,1,10,0)="VSE-6481: TB - SDES2 Priority 7: Rewrite SDES GET APPTS BY CLIN LIST2 in "
^XPD(9.6,13620,1,11,0)="          the SDES2 namespace."
^XPD(9.6,13620,1,12,0)="VSE-6492: AP - SDES2 Priority 18: Rewrite SDES SET APPT CHECK-IN STEP in "
^XPD(9.6,13620,1,13,0)="          the SDES2 namespace."
^XPD(9.6,13620,1,14,0)="VSE-6493: AP - SDES2 Priority 19: Rewrite SDES SET CHECK-IN STEP in the "
^XPD(9.6,13620,1,15,0)="          SDES2 namespace."
^XPD(9.6,13620,1,16,0)="VSE-6494: JS - SDES2 Priority 20: Rewrite SDES CANCEL APPOINTMENT 2 in "
^XPD(9.6,13620,1,17,0)="          the SDES2 namespace."
^XPD(9.6,13620,1,18,0)="VSE-6878: BB - VistA: Fix issues in SDES CREATE APPOINTMENTS RPC and SDEC "
^XPD(9.6,13620,1,19,0)="          APPADD."
^XPD(9.6,13620,1,20,0)=" "
^XPD(9.6,13620,1,21,0)=" "
^XPD(9.6,13620,1,22,0)="VSE Increment 8.19 - SD_5_3_869 - GUI v 1.7.53"
^XPD(9.6,13620,1,23,0)="=============================================="
^XPD(9.6,13620,1,24,0)="VSE-6418: BF - VistA: Create an RPC in the SDES2 namespace to add"
^XPD(9.6,13620,1,25,0)="          additional fields to the Query Search Tool"
^XPD(9.6,13620,1,26,0)="VSE-6488: JS - SDES2 Priority 14: Rewrite SDES CREATE WALKIN APPT in "
^XPD(9.6,13620,1,27,0)="          the SDES2 namespace"
^XPD(9.6,13620,1,28,0)="VSE-6495: BB - SDES2 Priority 21: Rewrite SDES CANCEL CLIN AVAILABILITY in"
^XPD(9.6,13620,1,29,0)="          the SDES2 namespace"
^XPD(9.6,13620,1,30,0)="VSE-6624: JJ - VistA: Modify SDES CREATE APPT REQ to verify the patient "
^XPD(9.6,13620,1,31,0)="          DFN on both the child request and parent request match"
^XPD(9.6,13620,1,32,0)="VSE-6821: MD - VistA: Modify SDES2 EDIT CLINIC to allow removal of "
^XPD(9.6,13620,1,33,0)="          inactive diagnostic codes"
^XPD(9.6,13620,1,34,0)="          APPADD"
^XPD(9.6,13620,1,35,0)="VSE-6884: BB - VistA: Create a new RPC in the SDES2 namespace to look back"
^XPD(9.6,13620,1,36,0)="          36 months to determine established patients"
^XPD(9.6,13620,1,37,0)="VSE-6988: MB - VistA: Correct spelling mistakes in the Remote Procedures"
^XPD(9.6,13620,1,38,0)="          file for SDES ADD CLNGRP ITEM and SDES SEARCH PROVIDER"
^XPD(9.6,13620,1,39,0)="VSE-6989: LB - VistA: Create a new RPC in the SDES2 namespace to create"
^XPD(9.6,13620,1,40,0)="          a provider resource"
^XPD(9.6,13620,1,41,0)="VSE-6990: LB - VistA: Create a new RPC in the SDES2 namespace to edit a "
^XPD(9.6,13620,1,42,0)="          provider resource"
^XPD(9.6,13620,1,43,0)="VSE-7007: AP - VistA: SDES CHECKOUT is working intermittently"
^XPD(9.6,13620,1,44,0)="VSE-7024: MD - VistA: Add appropriate fields to VistA files"
^XPD(9.6,13620,1,45,0)="VSE-7037: LB - VistA: Create a new RPC that returns back Eligibility of"
^XPD(9.6,13620,1,46,0)="          Visits values from file #8"
^XPD(9.6,13620,1,47,0)="VSE-7065: LB - VistA: Modify SDES2 CHECK CLIN AVAIL DEFINED RPC to not "
^XPD(9.6,13620,1,48,0)="          return an undefined error"
^XPD(9.6,13620,1,49,0)="VSE-7138: BB - VistA: Modify SDES2 CREATE APPOINTMENT to convert start "
^XPD(9.6,13620,1,50,0)="          date to ISO format correctly"
^XPD(9.6,13620,1,51,0)="VSE-7151: BB - VistA: Modify the return error response in SDES2 CREATE "
^XPD(9.6,13620,1,52,0)="          VET REQ AND APPT."
^XPD(9.6,13620,1,53,0)=" "
^XPD(9.6,13620,1,54,0)=" "
