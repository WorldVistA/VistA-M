^XPD(9.6,14141,1,4,0)="Tickets:"
^XPD(9.6,14141,1,5,0)="========"
^XPD(9.6,14141,1,6,0)="VSE-10988 - TAW - VistA: Modify Daylight Savings time calculations to "
^XPD(9.6,14141,1,7,0)="            include time"
^XPD(9.6,14141,1,8,0)="VSE-11051 - TAW - VistA: Modify date/time logic to add validation that "
^XPD(9.6,14141,1,9,0)="            seconds and hours are not greater than 60"
^XPD(9.6,14141,1,10,0)="VSE-11052 - TAW - VistA: Modify SDES2UTIL Routine under the SENSITIVE tag "
^XPD(9.6,14141,1,11,0)="            to default SDDUZ to DUZ if no value is passed in"
^XPD(9.6,14141,1,12,0)="VSE-11321 - TAW - VistA: Modify SD RECEIVE OR Protocol to prevent it from "
^XPD(9.6,14141,1,13,0)="            popula ting the MRTC CALC PREF DATES"
