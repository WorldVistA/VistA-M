^XPD(9.6,13758,0)="CRHD*1.0*11^204^0^3240216^y"
^XPD(9.6,13758,1,0)="^^50^50^3231027^"
^XPD(9.6,13758,1,1,0)="This patch addresses the following issue:"
^XPD(9.6,13758,1,2,0)=" "
^XPD(9.6,13758,1,3,0)="INCORRECT DRUG LINKED IN AUTOMATED DISPENSING SYSTEM FROM ONEVA"
^XPD(9.6,13758,1,4,0)=" "
^XPD(9.6,13758,1,5,0)=" "
^XPD(9.6,13758,1,6,0)="Defect"
^XPD(9.6,13758,1,7,0)="Tracking System Ticket(s) & Overview:"
^XPD(9.6,13758,1,8,0)=" "
^XPD(9.6,13758,1,9,0)="1. INC29032277 - Long Med List causes Endless Loop on Med Detail Display "
^XPD(9.6,13758,1,10,0)=" "
^XPD(9.6,13758,1,11,0)=" "
^XPD(9.6,13758,1,12,0)="Problem:"
^XPD(9.6,13758,1,13,0)="--------"
^XPD(9.6,13758,1,14,0)="When a patient has long list of active and recently expired meds creating "
^XPD(9.6,13758,1,15,0)="an array of 1000+ nodes (approximately 200 meds), and Shift Handoff Tool "
^XPD(9.6,13758,1,16,0)="is using the ""Med Detail"" data object, then the RPC Broker call CRHD PAT "
^XPD(9.6,13758,1,17,0)="ACTMEDS can get stuck in an endless loop."
^XPD(9.6,13758,1,18,0)=" "
^XPD(9.6,13758,1,19,0)="If a Shift Hand Off patient has 200+ meds and is causing an endless loop, "
^XPD(9.6,13758,1,20,0)="then sites can change the display to ""Med Summary"" as a temporary work "
^XPD(9.6,13758,1,21,0)="around.  Once the patient is discharged, they can switch back to the ""Med "
^XPD(9.6,13758,1,22,0)="Details"" display."
^XPD(9.6,13758,1,23,0)=" "
^XPD(9.6,13758,1,24,0)=" "
^XPD(9.6,13758,1,25,0)="Resolution:"
^XPD(9.6,13758,1,26,0)="-----------"
^XPD(9.6,13758,1,27,0)="Routine CRHDAM is modified to prevent the endless loop from occurring.  "
^XPD(9.6,13758,1,28,0)="The existing logic could end up resetting a counter node which caused the "
^XPD(9.6,13758,1,29,0)="loop to start over at the top of the meds list.  This is occurring "
^XPD(9.6,13758,1,30,0)="because the logic did not take into account the array of meds may contain "
^XPD(9.6,13758,1,31,0)="different number of lines for each Unit Dose, IV, and non-VA meds with in "
^XPD(9.6,13758,1,32,0)="the array and therefor didn't count correctly in some situations. "
^XPD(9.6,13758,1,33,0)=" "
^XPD(9.6,13758,1,34,0)=" "
^XPD(9.6,13758,1,35,0)="Technical Resolution:"
^XPD(9.6,13758,1,36,0)="---------------------"
^XPD(9.6,13758,1,37,0)="There was logic that was attempting to limit the number of meds that were "
^XPD(9.6,13758,1,38,0)="reviewed to 998 lines of the array. No reason for this can be determined "
^XPD(9.6,13758,1,39,0)="plus it didn't work and when it didn't it reset the node to -1 which "
^XPD(9.6,13758,1,40,0)="caused the loop to start over from the top of the array of meds."
^XPD(9.6,13758,1,41,0)=" "
^XPD(9.6,13758,1,42,0)="Line PSGI+7 is changed from "
^XPD(9.6,13758,1,43,0)="S CRHDNUM=0 F  S CRHDNUM=$O(CRHDLST(CRHDNUM)) Q:'CRHDNUM!('CRHDFG) D "
^XPD(9.6,13758,1,44,0)="To"
^XPD(9.6,13758,1,45,0)="S CRHDNUM=0 F  S CRHDNUM=$O(CRHDLST(CRHDNUM)) Q:'CRHDNUM  D"
^XPD(9.6,13758,1,46,0)=" "
^XPD(9.6,13758,1,47,0)="Line PSGI+16 is changed from "
^XPD(9.6,13758,1,48,0)="..I CRHDNUM2=CRHDLSTR S CRHDFG=0"
^XPD(9.6,13758,1,49,0)="To"
^XPD(9.6,13758,1,50,0)="..;I CRHDNUM2=CRHDLSTR S CRHDFG=0"
^XPD(9.6,13758,4,0)="^9.64PA^^"
^XPD(9.6,13758,6)="^8"
^XPD(9.6,13758,6.3)=4
^XPD(9.6,13758,"ABPKG")="n"
^XPD(9.6,13758,"INID")="^y"
^XPD(9.6,13758,"INIT")="EN^CRHD11PI"
^XPD(9.6,13758,"KRN",0)="^9.67PA^1.5^25"
