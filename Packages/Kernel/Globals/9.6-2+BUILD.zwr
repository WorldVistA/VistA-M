^XPD(9.6,13693,1,1,0)=" "
^XPD(9.6,13693,1,2,0)=" "
^XPD(9.6,13693,1,3,0)="VSE Increment 9.3/9.4 - SD*5.3*877 - GUI v 1.7.55"
^XPD(9.6,13693,1,4,0)=" "
^XPD(9.6,13693,1,5,0)="Jira Tickets:"
^XPD(9.6,13693,1,6,0)="============="
^XPD(9.6,13693,1,7,0)="VSE-6642: JS - VistA: <SUBSCRIPT>EN+17^SDMHPRO1 at Connecticut/"
^XPD(9.6,13693,1,8,0)="          West-Haven(689)"
^XPD(9.6,13693,1,9,0)="VSE-6810: AP - VistA: Modify logic within SDESUTIL"
^XPD(9.6,13693,1,10,0)="VSE-6995: ME - VistA: SCMCMHTC routine needs to be remediated"
^XPD(9.6,13693,1,11,0)="VSE-7171: BB - VistA: Create a new RPC to unblock PBSP clinic availability"
^XPD(9.6,13693,1,12,0)="VSE-7362: MD - VistA: Modify SDES2 INACTIVATE CLINIC RPC and SDES2 "
^XPD(9.6,13693,1,13,0)="          REACTIVATE RPC to allow the user to modify the date that the"
^XPD(9.6,13693,1,14,0)="          clinic is set to be inactivated, even if the clinic date is"
^XPD(9.6,13693,1,15,0)="          already set to be inactivated"
^XPD(9.6,13693,1,16,0)="VSE-7389: BB - VistA: Update CID when provider changes the CID in CPRS"
^XPD(9.6,13693,1,17,0)="VSE-7447: BF - VistA: Identify and change the SDES2 routines that are "
^XPD(9.6,13693,1,18,0)="          calling GETREQUEST^SDESGETAPPTREQ, and 2 others to call the new"
^XPD(9.6,13693,1,19,0)="          SDES2 versions of these routines"
^XPD(9.6,13693,1,20,0)="          SPEC NEEDS to allow remarks for each preference"
^XPD(9.6,13693,1,21,0)="VSE-7469: BB - VistA: Modify SDES2 CREATE SPEC NEEDS PREFS and SDES2 EDIT"
^XPD(9.6,13693,1,22,0)="          SPEC NEEDS to allow remarks for each preference"
^XPD(9.6,13693,1,23,0)="VSE-7514: MB - VistA: Modify SDES CANCEL CLIN PRECAN LIST RPC to work"
^XPD(9.6,13693,1,24,0)="          during a date range and return all the appointments within it"
^XPD(9.6,13693,1,25,0)="VSE-7594: LB - VistA: Update User DUZ in file 409.68 and the VISIT file"
^XPD(9.6,13693,1,26,0)="VSE-7595: BB - VistA: Modify SDES2 GET PATIENT EP to return the Last"
^XPD(9.6,13693,1,27,0)="          Disch./Lodger Date"
^XPD(9.6,13693,1,28,0)="VSE-7601: AP - VistA: Modify SDES2 CREATE APPOINTMENT to correct the user"
^XPD(9.6,13693,1,29,0)="          being stored when the request is being dispositioned"
^XPD(9.6,13693,1,30,0)="VSE-7626: MD - VistA: Modify SDES2 CREATE VET REQ AND APPT RPC to return"
^XPD(9.6,13693,1,31,0)="          a date instead of a date/time"
^XPD(9.6,13693,1,32,0)="VSE-7630: TB - VistA: Add SDES2 UNDO CHECKOUT to the SDESRPC menu option"
^XPD(9.6,13693,1,33,0)="VSE-7649: JS - VistA: Modify SDES2 CREATE APPT REQ error message so that "
^XPD(9.6,13693,1,34,0)="          it says ""Provider is inactive"""
^XPD(9.6,13693,1,35,0)="VSE-7657: TB - Discovery/Fix issue with Recall provider list not "
^XPD(9.6,13693,1,36,0)="          including all providers"
^XPD(9.6,13693,1,37,0)="VSE-7664: BF - VistA: Modify SDES2UTIL to recognize that there may be "
^XPD(9.6,13693,1,38,0)="          times when there are both active and inactive AMIS stop codes"
^XPD(9.6,13693,1,39,0)="VSE-7665: BF - Vista: Modify SDES2 QUERY APPT REQUESTS to accept a SubType"
^XPD(9.6,13693,1,40,0)="          for APPT appointment request types"
^XPD(9.6,13693,1,41,0)="VSE-7682: BB - VistA: Modify SDES2 CANCEL APPOINTMENT to ensure the "
^XPD(9.6,13693,1,42,0)="          requesting user is stored in the database"
^XPD(9.6,13693,1,43,0)="VSE-7684: TB - VistA Discovery and Code 409.84 field .09 should store"
^XPD(9.6,13693,1,44,0)="          Date and Time"
^XPD(9.6,13693,1,45,0)="VSE-7690: JS - VistA: Modify all SDES2 GET REQ RPCs to return the "
^XPD(9.6,13693,1,46,0)="          telephone number"
^XPD(9.6,13693,1,47,0)="VSE-7699: JS - VistA: Modify SDES2 CREATE LAST SELECTED PAT"
^XPD(9.6,13693,1,48,0)="VSE-7700: LB - The order file is not being populated correctly when an "
^XPD(9.6,13693,1,49,0)="          appointment is being created Using an RTC Request"
^XPD(9.6,13693,1,50,0)="VSE-7701: BB - VistA: Create a new SDES2 RPC to read demographics data"
^XPD(9.6,13693,1,51,0)="VSE-7711: JS - VistA: SDES GET PATIENT INQUIRY is returning full SSN"
^XPD(9.6,13693,1,52,0)="VSE-7713: JS - VistA: Add sensitive patient flag to SDES2 GET APPTS BY "
^XPD(9.6,13693,1,53,0)="          PATIENT DFN"
^XPD(9.6,13693,1,54,0)="VSE-7732: LB - SDES2 CREATE APPOINTMENT does not count after hours slot "
^XPD(9.6,13693,1,55,0)="          correctly"
^XPD(9.6,13693,1,56,0)="VSE-7789: TB - Code file 44 APPOINTMENT (field 1900) multiple sub file "
^XPD(9.6,13693,1,57,0)="          44.003 - field 8 to store the date and time for when the"
^XPD(9.6,13693,1,58,0)="          appointment was made"
^XPD(9.6,13693,1,59,0)="VSE-7823: BF - VistA: Rewrite SDEC RECAPGET in the SDES2 namespace"
^XPD(9.6,13693,1,60,0)="VSE-7853: BF - Vista: Correct an issue with time zone in expanded entry"
^XPD(9.6,13693,1,61,0)="                           "
