^XPD(9.6,13877,1,7,0)="          savings"
^XPD(9.6,13877,1,8,0)="VSE-8783: BF - VistA: Modify SDES2 CREATE APPT REQUEST to update the new "
^XPD(9.6,13877,1,9,0)="          duplicate reason"
^XPD(9.6,13877,1,10,0)="VSE-8819: BF - VistA: Modify SDES2 CREATE CLIN AVAILABILITY to add an "
^XPD(9.6,13877,1,11,0)="          error check"
^XPD(9.6,13877,1,12,0)="VSE-8820: FF - VS GUI: Modify the call to SDES GET MISSION ACT ELIG so "
^XPD(9.6,13877,1,13,0)="          that the system is passing the FileEntryDate date instead of the"
^XPD(9.6,13877,1,14,0)="          PID date"
^XPD(9.6,13877,1,15,0)="VSE-8857: BF - VistA: Modify block and move functionality to allow a "
^XPD(9.6,13877,1,16,0)="          variable length appointment to be moved to another variable"
^XPD(9.6,13877,1,17,0)="          length clinic"
^XPD(9.6,13877,1,18,0)="VSE-8923: JS - VistA: User is receiving a 500 error when pulling up a "
^XPD(9.6,13877,1,19,0)="          specific patient and has to restart ISS"
^XPD(9.6,13877,1,20,0)="VSE-8956: JS - VistA: Create a Post install to cleanup control characters"
