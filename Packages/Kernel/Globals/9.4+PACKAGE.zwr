^DIC(9.4,14,22,5.9,"PAH",148,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,5,0)="This patch implements a request from Decision Support System to expand "
^DIC(9.4,14,22,5.9,"PAH",148,1,6,0)="the LAB DSS LAR EXTRACT (#64.036) file to include the passing ordering "
^DIC(9.4,14,22,5.9,"PAH",148,1,7,0)="provider in DSS LAR API. The companion DSS patch is ECX*3.0*71. "
^DIC(9.4,14,22,5.9,"PAH",148,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,9,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*326 does not "
^DIC(9.4,14,22,5.9,"PAH",148,1,10,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",148,1,11,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",148,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,13,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*326 does not "
^DIC(9.4,14,22,5.9,"PAH",148,1,14,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",148,1,15,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",148,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,17,0)="RISK ANALYSIS: Changes made by patch LR*5.2*326 have no effect on Blood  "
^DIC(9.4,14,22,5.9,"PAH",148,1,18,0)="software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",148,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,21,0)="Routine Description:"
^DIC(9.4,14,22,5.9,"PAH",148,1,22,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",148,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,24,0)="The LRCAPDAR routine has been enhanced to capture the ordering provider "
^DIC(9.4,14,22,5.9,"PAH",148,1,25,0)="for each accession being passed to DSS LAR API."
^DIC(9.4,14,22,5.9,"PAH",148,1,26,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,27,0)="Option Description:"
^DIC(9.4,14,22,5.9,"PAH",148,1,28,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",148,1,29,0)="There is no option attached to this functionality. The data extraction in "
^DIC(9.4,14,22,5.9,"PAH",148,1,30,0)="activated by ECX DSS API."
^DIC(9.4,14,22,5.9,"PAH",148,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,32,0)="Data Dictionary Changes:"
^DIC(9.4,14,22,5.9,"PAH",148,1,33,0)="======================="
^DIC(9.4,14,22,5.9,"PAH",148,1,34,0)="An additional field will be installed with this patch."
^DIC(9.4,14,22,5.9,"PAH",148,1,35,0)="PROVIDER (#12) field will be added to LAB DSS LAR EXTRACT (#64.036) file."
^DIC(9.4,14,22,5.9,"PAH",148,1,36,0)="This field will be populated by the Laboratory DSS LAR API."
^DIC(9.4,14,22,5.9,"PAH",148,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,40,0)="NOTE: This patch is a companion to the ECX*3.0*71 patch."
^DIC(9.4,14,22,5.9,"PAH",148,1,41,0)="      LR*5.2*326 is not called by any menu option and does not"
^DIC(9.4,14,22,5.9,"PAH",148,1,42,0)="      have any user interface.  Patch LR*5.2*326 MUST"
^DIC(9.4,14,22,5.9,"PAH",148,1,43,0)="      be installed for the ECX*3.0*71 patch to work properly."
^DIC(9.4,14,22,5.9,"PAH",148,1,44,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,45,0)="Test Sites"
^DIC(9.4,14,22,5.9,"PAH",148,1,46,0)="=========="
