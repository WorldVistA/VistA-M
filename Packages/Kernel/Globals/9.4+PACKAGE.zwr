^DIC(9.4,3,22,21,"PAH",131,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,43,0)="Rtn Nm         Chksum Before     Chksum After            Patch List"
^DIC(9.4,3,22,21,"PAH",131,1,44,0)="===================================================================="
^DIC(9.4,3,22,21,"PAH",131,1,45,0)="XUS1A                5446713          7137988               153"
^DIC(9.4,3,22,21,"PAH",131,1,46,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,48,0)="Installation Instruction:"
^DIC(9.4,3,22,21,"PAH",131,1,49,0)="========================"
^DIC(9.4,3,22,21,"PAH",131,1,50,0)="1. Users ARE NOT allowed to be on the system during the Installation."
^DIC(9.4,3,22,21,"PAH",131,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,52,0)="2. Routine mapping is NOT recommended for these routines.  If you"
^DIC(9.4,3,22,21,"PAH",131,1,53,0)="are using routine mapping, review your mapped set and ensure that"
^DIC(9.4,3,22,21,"PAH",131,1,54,0)="these routines are NOT in your mapped routine set before proceeding"
^DIC(9.4,3,22,21,"PAH",131,1,55,0)="and rebuild your map set afterward before reactivating TaskMan."
^DIC(9.4,3,22,21,"PAH",131,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,57,0)="3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,3,22,21,"PAH",131,1,58,0)="loads the patch into a Transport Global onto your system."
^DIC(9.4,3,22,21,"PAH",131,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,60,0)="4. You Do Not need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",131,1,61,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,63,0)="5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,3,22,21,"PAH",131,1,64,0)="   following options to install the Transport Global:"
^DIC(9.4,3,22,21,"PAH",131,1,65,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,66,0)="  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",131,1,67,0)="  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",131,1,68,0)="  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",131,1,69,0)="  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",131,1,70,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,71,0)="  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",131,1,72,0)="             INSTALL NAME:  XU*8.0*153"
^DIC(9.4,3,22,21,"PAH",131,1,73,0)="                            =========="
^DIC(9.4,3,22,21,"PAH",131,1,74,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,75,0)="  Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",131,1,76,0)="                                                        =="
^DIC(9.4,3,22,21,"PAH",131,1,77,0)="  Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,3,22,21,"PAH",131,1,78,0)="  Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",131,1,79,0)="                   ==   "
^DIC(9.4,3,22,21,"PAH",131,1,80,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,81,0)="6. DSM/AXP Sites - Answer NO to the question ""Want to MOVE routines"
^DIC(9.4,3,22,21,"PAH",131,1,82,0)="   to other CPUs?"""
^DIC(9.4,3,22,21,"PAH",131,1,83,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,84,0)="7. DSM/AXP Sites: If the routines were unmapped per STEP #2, the"
^DIC(9.4,3,22,21,"PAH",131,1,85,0)="   mapped set should be rebuilt once the installation has run to"
^DIC(9.4,3,22,21,"PAH",131,1,86,0)="   completion."
^DIC(9.4,3,22,21,"PAH",132,0)="164 SEQ #138^3000711^1"
^DIC(9.4,3,22,21,"PAH",132,1,0)="^^66^66^3000711"
^DIC(9.4,3,22,21,"PAH",132,1,1,0)="1.  PUG-1299-50101."
^DIC(9.4,3,22,21,"PAH",132,1,2,0)="    When an alert is sent to a user the Forward and Renew prompts are"
^DIC(9.4,3,22,21,"PAH",132,1,3,0)="    displayed as F(orward) or R(enew).  Changing to display as (F)orward"
^DIC(9.4,3,22,21,"PAH",132,1,4,0)="    or (R)enew."
^DIC(9.4,3,22,21,"PAH",132,1,5,0)=" "
