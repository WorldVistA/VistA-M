^DIC(9.4,48,22,5.28,"PAH",363,0)="496 SEQ #412^3070905.010848^1"
^DIC(9.4,48,22,5.28,"PAH",363,1,0)="^^3^3^3070905"
^DIC(9.4,48,22,5.28,"PAH",363,1,1,0)="This patch addresses several issues related to Scheduling, including one"
