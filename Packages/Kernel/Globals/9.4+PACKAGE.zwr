^DIC(9.4,120,"VERSION")="2.0"
^DIC(9.4,121,0)="LIBRARY^LBR^LIBRARY SERIALS PACKAGE^"
^DIC(9.4,121,1,0)="^^12^12^2970625^^^^"
^DIC(9.4,121,1,1,0)="The first module to be developed in an intergrated library system is the"
^DIC(9.4,121,1,2,0)="Serials Management Module. It automates the tedious manual serial title"
^DIC(9.4,121,1,3,0)="check-in and distribution. It integrates previously scattered data (check-in"
^DIC(9.4,121,1,4,0)="history, local holdings, subscription data, and bibliographic data) into"
^DIC(9.4,121,1,5,0)="a single title record.  It provides many outputs previously unavailable"
^DIC(9.4,121,1,6,0)="without hours of manual assembly and repetitive typing.  It extends online"
^DIC(9.4,121,1,7,0)="hospital staff access to library holdings and services."
^DIC(9.4,121,1,8,0)=" "
^DIC(9.4,121,1,9,0)="Basic functions to be included in the first version of the package are:"
^DIC(9.4,121,1,10,0)="Check-in by number of copies ordered or copy by copy, automatic routing,"
^DIC(9.4,121,1,11,0)="title entry/edit, claims list, inquire to holdings, automatic prediction"
^DIC(9.4,121,1,12,0)="of next issue for check-in, issue history and various other reports."
^DIC(9.4,121,4,0)="^9.44PA^30^20"
