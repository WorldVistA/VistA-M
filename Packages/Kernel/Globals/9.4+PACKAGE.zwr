^DIC(9.4,59,22,5,"PAH",530,0)="513 SEQ #531^3180201.160625^54"
^DIC(9.4,59,22,5,"PAH",531,0)="563 SEQ #545^3180601.162227^54"
^DIC(9.4,59,22,5,"PAH",531,1,0)="^^2^2^3180601"
^DIC(9.4,59,22,5,"PAH",531,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,59,22,5,"PAH",531,1,2,0)="under PSN*4*563."
^DIC(9.4,59,22,5,"PAH",532,0)="541 SEQ #546^3181102.152953^54"
^DIC(9.4,59,22,5,"PAH",532,1,0)="^^9^9^3181102"
^DIC(9.4,59,22,5,"PAH",532,1,1,0)="This patch has the following enhancements for Clinical Ancillary Services"
^DIC(9.4,59,22,5,"PAH",532,1,2,0)="(CAS) Enhancements (RXSU2)."
^DIC(9.4,59,22,5,"PAH",532,1,3,0)=" "
^DIC(9.4,59,22,5,"PAH",532,1,4,0)="1.  Manage Lookup List Inactive Entries"
^DIC(9.4,59,22,5,"PAH",532,1,5,0)=" "
^DIC(9.4,59,22,5,"PAH",532,1,6,0)="    The following files have added a new field identifier to their data"
^DIC(9.4,59,22,5,"PAH",532,1,7,0)="    dictionaries to indicate if they are marked as Inactive entries."
^DIC(9.4,59,22,5,"PAH",532,1,8,0)=" "
^DIC(9.4,59,22,5,"PAH",532,1,9,0)="    a.  VA PRODUCT file (#50.68) the INACTIVATION DATE field (#21)."
^DIC(9.4,59,22,5,"PAH",533,0)="565 SEQ #547^3181206.155324^54"
^DIC(9.4,59,22,5,"PAH",533,1,0)="^^2^2^3181206"
^DIC(9.4,59,22,5,"PAH",533,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,59,22,5,"PAH",533,1,2,0)="under PSN*4*565."
^DIC(9.4,59,22,5,"PAH",534,0)="566 SEQ #548^3190402.14282^54"
^DIC(9.4,59,22,5,"PAH",534,1,0)="^^2^2^3190402"
^DIC(9.4,59,22,5,"PAH",534,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,59,22,5,"PAH",534,1,2,0)="under PSN*4*566."
^DIC(9.4,59,22,5,"PAH",535,0)="567 SEQ #549^3190708.164052^65"
^DIC(9.4,59,22,5,"PAH",535,1,0)="^^6^6^3190708"
^DIC(9.4,59,22,5,"PAH",535,1,1,0)="The purpose of this patch is to distribute the data dictionary for the VA "
^DIC(9.4,59,22,5,"PAH",535,1,2,0)="DRUG CLASS file (#50.605) in order to set the APPLICATION GROUP of GMTS "
^DIC(9.4,59,22,5,"PAH",535,1,3,0)="to allow selection in Health Summary."
^DIC(9.4,59,22,5,"PAH",535,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",535,1,5,0)="In addition, a new API is being distributed to allow selection of drug "
^DIC(9.4,59,22,5,"PAH",535,1,6,0)="classes in Ad Hoc reporting as well as Health Summary collections."
^DIC(9.4,59,22,5,"PAH",536,0)="568 SEQ #550^3190708.215704^65"
^DIC(9.4,59,22,5,"PAH",536,1,0)="^^2^2^3190708"
^DIC(9.4,59,22,5,"PAH",536,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,59,22,5,"PAH",536,1,2,0)="under PSN*4*568."
^DIC(9.4,59,22,5,"PAH",537,0)="569 SEQ #551^3200624.140332^65"
^DIC(9.4,59,22,5,"PAH",537,1,0)="^^49^49^3200624"
^DIC(9.4,59,22,5,"PAH",537,1,1,0)="This patch, along with patch PSS*1*243 will address the following ePrescribing"
^DIC(9.4,59,22,5,"PAH",537,1,2,0)="(eRx) issue: "
^DIC(9.4,59,22,5,"PAH",537,1,3,0)="   "
^DIC(9.4,59,22,5,"PAH",537,1,4,0)="1. INC9317643 - We have noticed a number of drugs that do not auto match for"
^DIC(9.4,59,22,5,"PAH",537,1,5,0)="   inbound eRx orders"
^DIC(9.4,59,22,5,"PAH",537,1,6,0)="   "
^DIC(9.4,59,22,5,"PAH",537,1,7,0)="   DUPLICATE - INC9105989 - erx software auto-matched wrong drug product"
^DIC(9.4,59,22,5,"PAH",537,1,8,0)="  "
^DIC(9.4,59,22,5,"PAH",537,1,9,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,59,22,5,"PAH",537,1,10,0)="--------------------------------------------"
^DIC(9.4,59,22,5,"PAH",537,1,11,0)="1. INC9317643 - We have noticed a number of drugs that do not auto match for"
^DIC(9.4,59,22,5,"PAH",537,1,12,0)="   inbound eRx orders"
^DIC(9.4,59,22,5,"PAH",537,1,13,0)=" "
^DIC(9.4,59,22,5,"PAH",537,1,14,0)="   DUPLICATE - INC9105989 - erx software auto-matched wrong drug product"
^DIC(9.4,59,22,5,"PAH",537,1,15,0)="  "
^DIC(9.4,59,22,5,"PAH",537,1,16,0)="Problem: "
^DIC(9.4,59,22,5,"PAH",537,1,17,0)="--------"
^DIC(9.4,59,22,5,"PAH",537,1,18,0)="The VA Health Administration Center Denver reported and issue with incoming"
^DIC(9.4,59,22,5,"PAH",537,1,19,0)="ePrescribing orders (eRx) not automatically matching the ordered drug with a"
^DIC(9.4,59,22,5,"PAH",537,1,20,0)="VistA corresponding Dispense Drug, even when the NDC received matches 1 to 1"
^DIC(9.4,59,22,5,"PAH",537,1,21,0)="with a specific VA Product entry. They also noticed the issue to be more"
^DIC(9.4,59,22,5,"PAH",537,1,22,0)="prevalent with dispense drugs that have been recently re-matched to a "
^DIC(9.4,59,22,5,"PAH",537,1,23,0)="different VA Product entry due to changes from MG to MGC in the strength. "
^DIC(9.4,59,22,5,"PAH",537,1,24,0)="After researching this issue it was determined that the root cause of the"
^DIC(9.4,59,22,5,"PAH",537,1,25,0)="problem was a 'corruption' of the ""APR"" cross-reference in the DRUG file (#50)"
^DIC(9.4,59,22,5,"PAH",537,1,26,0)="which was not properly set or killed after Dispense Drugs were matched,"
^DIC(9.4,59,22,5,"PAH",537,1,27,0)="un-matched or re-matched to VA Product entries. Such cross-reference is used"
^DIC(9.4,59,22,5,"PAH",537,1,28,0)="by the eRx drug auto-matching processing and that's the reason it failed"
^DIC(9.4,59,22,5,"PAH",537,1,29,0)="for some drugs. It turned out that two other cross-references ""AND"" and ""APN"""
^DIC(9.4,59,22,5,"PAH",537,1,30,0)="also had the same issue. No user functionality side-effects have been"
^DIC(9.4,59,22,5,"PAH",537,1,31,0)="reported related to these other two cross-references though."
^DIC(9.4,59,22,5,"PAH",537,1,32,0)=" "
^DIC(9.4,59,22,5,"PAH",537,1,33,0)=" "
^DIC(9.4,59,22,5,"PAH",537,1,34,0)="Resolution: "
^DIC(9.4,59,22,5,"PAH",537,1,35,0)="-----------"
^DIC(9.4,59,22,5,"PAH",537,1,36,0)="The setting and killing of the ""APR"", ""AND"" and ""APN"" cross-reference have"
^DIC(9.4,59,22,5,"PAH",537,1,37,0)="been completely reviewed at every point where a Dispense Drug is matched,"
^DIC(9.4,59,22,5,"PAH",537,1,38,0)="un-matched or re-matched to a VA Product and after this patch is installed"
^DIC(9.4,59,22,5,"PAH",537,1,39,0)="they should be properly maintained. Furthermore, a post-install routine"
^DIC(9.4,59,22,5,"PAH",537,1,40,0)="will completely kill off the 3 cross-references and re-build them completely."
^DIC(9.4,59,22,5,"PAH",537,1,41,0)="The patch PSS*1*243 is also being released along with this patch because the"
^DIC(9.4,59,22,5,"PAH",537,1,42,0)="NDF (National Drug File) matching functionality is available in both"
^DIC(9.4,59,22,5,"PAH",537,1,43,0)="applications, NDF and PDM (Pharmacy Data Management). "
^DIC(9.4,59,22,5,"PAH",537,1,44,0)=" "
^DIC(9.4,59,22,5,"PAH",537,1,45,0)="        "
^DIC(9.4,59,22,5,"PAH",537,1,46,0)="Technical Resolution: "
^DIC(9.4,59,22,5,"PAH",537,1,47,0)="---------------------"
^DIC(9.4,59,22,5,"PAH",537,1,48,0)="Changed the routines PSNHELP1, PSNMRG, PSNPPSNU and PSNPPSNW to kill and set"
^DIC(9.4,59,22,5,"PAH",537,1,49,0)="the cross-references ""AND"", ""APN"" and ""APR"" properly."
^DIC(9.4,59,22,5,"PAH",538,0)="571 SEQ #552^3210211.130741^17"
^DIC(9.4,59,22,5,"PAH",538,1,0)="^^66^66^3210211"
^DIC(9.4,59,22,5,"PAH",538,1,1,0)="This patch will address the following issue: "
^DIC(9.4,59,22,5,"PAH",538,1,2,0)="   "
^DIC(9.4,59,22,5,"PAH",538,1,3,0)="1. INC12620504 - Requesting Assistance with an issue with PPS NEW 62"
^DIC(9.4,59,22,5,"PAH",538,1,4,0)="  "
^DIC(9.4,59,22,5,"PAH",538,1,5,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,59,22,5,"PAH",538,1,6,0)="--------------------------------------------"
^DIC(9.4,59,22,5,"PAH",538,1,7,0)="1. INC12620504 - Requesting Assistance with an issue with PPS NEW 62"
^DIC(9.4,59,22,5,"PAH",538,1,8,0)="   "
^DIC(9.4,59,22,5,"PAH",538,1,9,0)="Problem: "
^DIC(9.4,59,22,5,"PAH",538,1,10,0)="--------"
^DIC(9.4,59,22,5,"PAH",538,1,11,0)="The Clinical Product Support Team 1 (Clin 1) reported that after the release"
^DIC(9.4,59,22,5,"PAH",538,1,12,0)="of PPS-N file #62 they received communication that the VA PRODUCT file"
^DIC(9.4,59,22,5,"PAH",538,1,13,0)="(#50.68) contained additional entries that did not look correct. Most of the"
^DIC(9.4,59,22,5,"PAH",538,1,14,0)="problems reported, if not all, seem to be related to non-production accounts"
^DIC(9.4,59,22,5,"PAH",538,1,15,0)="but not all non-production accounts presented the problem."
^DIC(9.4,59,22,5,"PAH",538,1,16,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,17,0)="Resolution: "
^DIC(9.4,59,22,5,"PAH",538,1,18,0)="-----------"
^DIC(9.4,59,22,5,"PAH",538,1,19,0)="After some extensive research it was determined that the cause of the specific"
^DIC(9.4,59,22,5,"PAH",538,1,20,0)="problem reported is related to concurrent (grouped) installation of PPS-N"
^DIC(9.4,59,22,5,"PAH",538,1,21,0)="file #62 and #63. Residual/temporary data from the file #62 installation is"
^DIC(9.4,59,22,5,"PAH",538,1,22,0)="not properly cleaned up before proceeding to the installation of file #63 and"
^DIC(9.4,59,22,5,"PAH",538,1,23,0)="it throws off the installation causing it to add thousands of corrupted "
^DIC(9.4,59,22,5,"PAH",538,1,24,0)="records to the VA PRODUCT file (#50.68)."
^DIC(9.4,59,22,5,"PAH",538,1,25,0)="        "
^DIC(9.4,59,22,5,"PAH",538,1,26,0)="Technical Resolution: "
^DIC(9.4,59,22,5,"PAH",538,1,27,0)="---------------------"
^DIC(9.4,59,22,5,"PAH",538,1,28,0)="Line tag CKDIR+15^PSNPPSNF was using variable X22 instead of X2 in order to "
^DIC(9.4,59,22,5,"PAH",538,1,29,0)="determine whether it should kill the ^TMP nodes used during installation of"
^DIC(9.4,59,22,5,"PAH",538,1,30,0)="each file or not. Because of the wrong variable was used the software was"
^DIC(9.4,59,22,5,"PAH",538,1,31,0)="not killing off the ^TMP nodes before starting installation of the next file. "
^DIC(9.4,59,22,5,"PAH",538,1,32,0)="The solution applied was to ALWAYS kill off the ^TMP nodes after each file"
^DIC(9.4,59,22,5,"PAH",538,1,33,0)="installation when multiple files are being installed at once."
^DIC(9.4,59,22,5,"PAH",538,1,34,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,35,0)="Data Clean-Up:"
^DIC(9.4,59,22,5,"PAH",538,1,36,0)="--------------"
^DIC(9.4,59,22,5,"PAH",538,1,37,0)="The corrupted records will be removed from the VA PRODUCT file (#50.68) "
^DIC(9.4,59,22,5,"PAH",538,1,38,0)="through a post-install routine with the following criteria:"
^DIC(9.4,59,22,5,"PAH",538,1,39,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,40,0)=" 1) The latest released PPS-N file was #70 released on 10/26/2020 and the"
^DIC(9.4,59,22,5,"PAH",538,1,41,0)="    last VA PRODUCT file (#50.68) record IEN was 30495."
^DIC(9.4,59,22,5,"PAH",538,1,42,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,43,0)=" 2) A post-install routine will start looking at records with an IEN greater"
^DIC(9.4,59,22,5,"PAH",538,1,44,0)="    than 32900 as the first corrupted record was assigned the IEN 32926 as"
^DIC(9.4,59,22,5,"PAH",538,1,45,0)="    shown below:"
^DIC(9.4,59,22,5,"PAH",538,1,46,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,47,0)="     Global ^PSNDF(50.68,32000:,0 -- NOTE: translation in effect"
^DIC(9.4,59,22,5,"PAH",538,1,48,0)="     ^PSNDF(50.68,32926,0)=""6610,1,1^3200624.15171^43,.02,.01^360^A"""
^DIC(9.4,59,22,5,"PAH",538,1,49,0)="     ^PSNDF(50.68,33094,0)=""16647,1,1^3200624.15713^43,.02,.01^360^A"""
^DIC(9.4,59,22,5,"PAH",538,1,50,0)="     ^PSNDF(50.68,59087,0)=""7647,1,1^3200624.15153^43,.02,.01^360^A"""
^DIC(9.4,59,22,5,"PAH",538,1,51,0)="     ..."
^DIC(9.4,59,22,5,"PAH",538,1,52,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,53,0)=" 3) For each record with an IEN greater than 32900 the post-install will"
^DIC(9.4,59,22,5,"PAH",538,1,54,0)="    check if each of the following required fields below has a valid value"
^DIC(9.4,59,22,5,"PAH",538,1,55,0)="    (numeric value corresponding to a valid entry in the file it points to). "
^DIC(9.4,59,22,5,"PAH",538,1,56,0)="    If at least one field is found to be valid, the record will be skipped,"
^DIC(9.4,59,22,5,"PAH",538,1,57,0)="    otherwise it will be deleted from the VA PRODUCT file (#50.68)."
^DIC(9.4,59,22,5,"PAH",538,1,58,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,59,0)="     Field #    Field Name                Points to"
^DIC(9.4,59,22,5,"PAH",538,1,60,0)="     ----------------------------------------------------------------"
^DIC(9.4,59,22,5,"PAH",538,1,61,0)="      .05       VA GENERIC NAME           VA GENERIC (#50.6)"
^DIC(9.4,59,22,5,"PAH",538,1,62,0)="       1        DOSAGE FORM               DOSAGE FORM (#50.606)"
^DIC(9.4,59,22,5,"PAH",538,1,63,0)="       3        UNITS                     DRUG UNITS (#50.607)"
^DIC(9.4,59,22,5,"PAH",538,1,64,0)=" "
^DIC(9.4,59,22,5,"PAH",538,1,65,0)="  4) All deleted records will be backed up to ^XTMP(""PSN571PI"") global and"
^DIC(9.4,59,22,5,"PAH",538,1,66,0)="     will set to remain on the database for 365 days."
^DIC(9.4,59,22,5,"PAH",539,0)="573b^3210326"
^DIC(9.4,59,22,5,"PAH",539,1,0)="^^5^5^3210326"
^DIC(9.4,59,22,5,"PAH",539,1,1,0)="Backup of PSN*4.0*573 on Mar 26, 2021"
^DIC(9.4,59,22,5,"PAH",539,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",539,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,59,22,5,"PAH",539,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,59,22,5,"PAH",539,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,59,22,5,"PAH",540,0)="573 SEQ #554^3210326.104452^17"
^DIC(9.4,59,22,5,"PAH",540,1,0)="^^5^5^3210326"
^DIC(9.4,59,22,5,"PAH",540,1,1,0)="Sites transitioning from Cache to Iris - NOL "
^DIC(9.4,59,22,5,"PAH",540,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",540,1,3,0)="This patch will resolve the following issue:"
^DIC(9.4,59,22,5,"PAH",540,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",540,1,5,0)="INC11884678 - Sites transitioning from CACHE to IRIS "
^DIC(9.4,59,22,5,"PAH",541,0)="572 SEQ #555^3220503.111956^86"
^DIC(9.4,59,22,5,"PAH",541,1,0)="^^4^4^3220503"
^DIC(9.4,59,22,5,"PAH",541,1,1,0)="The On-demand functionality of the FDA Med Guides is being retired. "
^DIC(9.4,59,22,5,"PAH",541,1,2,0)="Instead of automatically opening the guide in the user's browser if they "
^DIC(9.4,59,22,5,"PAH",541,1,3,0)="have the required software now all users will need to copy the link given "
^DIC(9.4,59,22,5,"PAH",541,1,4,0)="in the Med Guide option to their own browser."
^DIC(9.4,59,22,5,"PAH",542,0)="574 SEQ #556^3221201.114652^89"
^DIC(9.4,59,22,5,"PAH",542,1,0)="^^4^4^3221201"
^DIC(9.4,59,22,5,"PAH",542,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,59,22,5,"PAH",542,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",542,1,3,0)="When an allergy is entered to a Coflex product, the allergy is incorrectly"
^DIC(9.4,59,22,5,"PAH",542,1,4,0)="interpreted as being to ""orphenadrine""."
^DIC(9.4,59,22,5,"PAH",543,0)="575 SEQ #557^3240726.103457^89"
^DIC(9.4,59,22,5,"PAH",543,1,0)="^^119^119^3240726"
^DIC(9.4,59,22,5,"PAH",543,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,59,22,5,"PAH",543,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,3,0)="ECDSA/EDDSA Key creation"
^DIC(9.4,59,22,5,"PAH",543,1,4,0)=" "
