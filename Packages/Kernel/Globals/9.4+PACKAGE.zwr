^DIC(9.4,59,22,5,"PAH",116,1,5,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",116,1,6,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",116,1,7,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",116,1,8,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",116,1,9,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",116,1,10,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",116,1,11,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",116,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",116,1,13,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",116,1,14,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",116,1,15,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",116,1,16,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",116,1,17,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",116,1,18,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",117,0)="110 SEQ #117^3061211.160001^1"
^DIC(9.4,59,22,5,"PAH",117,1,0)="^^24^24^3061211"
^DIC(9.4,59,22,5,"PAH",117,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",117,1,2,0)="Under certain circumstances, entries in the ACTIVE INGREDIENTS multiple"
^DIC(9.4,59,22,5,"PAH",117,1,3,0)="field (#14) in the VA PRODUCT file (#50.68) were not being deleted when"
^DIC(9.4,59,22,5,"PAH",117,1,4,0)="they should have been.  Patch PSN*4*78 corrected the flaw in the data"
^DIC(9.4,59,22,5,"PAH",117,1,5,0)="update process for subsequent releases.  This patch deletes those entries"
^DIC(9.4,59,22,5,"PAH",117,1,6,0)="that should have been deleted by updates prior to patch PSN*4*58."
^DIC(9.4,59,22,5,"PAH",117,1,7,0)=" "
^DIC(9.4,59,22,5,"PAH",117,1,8,0)="The products involved are"
^DIC(9.4,59,22,5,"PAH",117,1,9,0)="4-MIXED TRACE ELEMENTS INJ"
^DIC(9.4,59,22,5,"PAH",117,1,10,0)="APAP 500MG/DM 10MG/DOXYLAMINE 6.25MG/PSEUDEFED 30MG/15ML LIQUID"
^DIC(9.4,59,22,5,"PAH",117,1,11,0)="ATROPINE 2MG/PRALIDOXIME CL 300MG AUTO INJECTOR (MARK I)"
^DIC(9.4,59,22,5,"PAH",117,1,12,0)="CHLORHEXIDINE GLUCONATE 0.12% RINSE,ORAL"
^DIC(9.4,59,22,5,"PAH",117,1,13,0)="CLOVE OIL"
^DIC(9.4,59,22,5,"PAH",117,1,14,0)="COBRA POWERFUL MEN'S PREFORMANCE ENHANCER CAP/TAB"
^DIC(9.4,59,22,5,"PAH",117,1,15,0)="DRESSING,AQUACEL AG 2IN X 2IN C#403706"
^DIC(9.4,59,22,5,"PAH",117,1,16,0)="HYDROXYCUT ADVANCED WEIGHT LOSS FORMULA, EPHEDRA-FREE"
^DIC(9.4,59,22,5,"PAH",117,1,17,0)="MONONESSA TAB,28"
^DIC(9.4,59,22,5,"PAH",117,1,18,0)="RELACORE STRESS REDUCER/MOOD ELEVATOR"
^DIC(9.4,59,22,5,"PAH",117,1,19,0)="TABACCO"
^DIC(9.4,59,22,5,"PAH",117,1,20,0)="TOTAL LEAN EPHEDRA-FREE CAP/TAB"
^DIC(9.4,59,22,5,"PAH",117,1,21,0)="TRACE METALS ADDITIVE INJ"
^DIC(9.4,59,22,5,"PAH",117,1,22,0)=" "
^DIC(9.4,59,22,5,"PAH",117,1,23,0)="This patch also makes the VUID field (#99.99) in the DRUG INGREDIENTS"
^DIC(9.4,59,22,5,"PAH",117,1,24,0)="file (#50.416) uneditable."
