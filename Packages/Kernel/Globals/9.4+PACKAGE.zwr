^DIC(9.4,11,22,5.03,"PAH",45,1,116,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,118,0)="Software and Documentation Retrieval Information"
^DIC(9.4,11,22,5.03,"PAH",45,1,119,0)=" =============================="
^DIC(9.4,11,22,5.03,"PAH",45,1,120,0)="VistA Laboratory patch LR*5.2*458 software is distributed by Host File, "
^DIC(9.4,11,22,5.03,"PAH",45,1,121,0)="along with LA*5.2*88.  Software is available on the ANONYMOUS.SOFTWARE "
^DIC(9.4,11,22,5.03,"PAH",45,1,122,0)="directory at one of the following Office of Information (OI) Field "
^DIC(9.4,11,22,5.03,"PAH",45,1,123,0)="Offices.  The preferred is to retrieve the file using Secure File Transfer"
^DIC(9.4,11,22,5.03,"PAH",45,1,124,0)="Protocol (SFTP) from download.vista.domain.ext, which transmits files from"
^DIC(9.4,11,22,5.03,"PAH",45,1,125,0)="the first available FTP server. Sites may also select to retrieve"
^DIC(9.4,11,22,5.03,"PAH",45,1,126,0)="documentation directly from a specific server as follows: "
^DIC(9.4,11,22,5.03,"PAH",45,1,127,0)="        Albany                     ftp.fo-albany.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",45,1,128,0)="        Hines                      ftp.fo-hines.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",45,1,129,0)="        Salt Lake City             ftp.fo-slc.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",45,1,130,0)="                                   "
^DIC(9.4,11,22,5.03,"PAH",45,1,131,0)="File Name                   Contents               Retrieval Format"
^DIC(9.4,11,22,5.03,"PAH",45,1,132,0)="------------------          --------------------   ----------------"
^DIC(9.4,11,22,5.03,"PAH",45,1,133,0)="LAB_AUTORELEASE_1_0.KID     Host File containing       ASCII"
^DIC(9.4,11,22,5.03,"PAH",45,1,134,0)="                            KIDS software distribution"
^DIC(9.4,11,22,5.03,"PAH",45,1,135,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,136,0)="The VistA Documentation Library (VDL) web site will also contain "
^DIC(9.4,11,22,5.03,"PAH",45,1,137,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,138,0)="LR_52_458_LA_52_88 Release Notes                       Binary"
