^DIC(9.4,161,"VERSION")="6.0"
^DIC(9.4,162,0)="AUTHORIZATION/SUBSCRIPTION^USR^User Authorization"
^DIC(9.4,162,5)="SALT LAKE"
^DIC(9.4,162,7)="^^I"
^DIC(9.4,162,20,0)="^9.402P^^"
^DIC(9.4,162,22,0)="^9.49I^1^1"
^DIC(9.4,162,22,1,0)="1.0^3051119^2971006^1"
^DIC(9.4,162,22,1,1,0)="^^38^38^3051119"
^DIC(9.4,162,22,1,1,1,0)="Authorization/Subscription Utility version 1.0"
^DIC(9.4,162,22,1,1,2,0)=" "
^DIC(9.4,162,22,1,1,3,0)="This package implements a User Class Hierarchy which is useful for"
^DIC(9.4,162,22,1,1,4,0)="identifying the roles that different users fulfill within the hospital,"
^DIC(9.4,162,22,1,1,5,0)="and allows for the specification of business rules for the handling of"
^DIC(9.4,162,22,1,1,6,0)="documents by members of such groups. ASU provides a method for identifying"
^DIC(9.4,162,22,1,1,7,0)="who is AUTHORIZED to do something to a particular kind of document in a"
^DIC(9.4,162,22,1,1,8,0)="given status (e.g., An UNSIGNED CLINICAL DOCUMENT may be EDITED by a"
^DIC(9.4,162,22,1,1,9,0)="PROVIDER who is also the EXPECTED SIGNER of the document).  When such"
^DIC(9.4,162,22,1,1,10,0)="rules are defined at a general level in either the Document Definition or"
^DIC(9.4,162,22,1,1,11,0)="User Class Hierarchies, they are ""inherited"" by more specfic ""descendent"""
^DIC(9.4,162,22,1,1,12,0)="classes or TITLES."
^DIC(9.4,162,22,1,1,13,0)=" "
^DIC(9.4,162,22,1,1,14,0)="Features"
^DIC(9.4,162,22,1,1,15,0)=" "
^DIC(9.4,162,22,1,1,16,0)="+ ASU lets you define, populate, and retrieve information about user"
^DIC(9.4,162,22,1,1,17,0)="  classes. These user classes can be defined hospital-wide or more"
^DIC(9.4,162,22,1,1,18,0)="  narrowly for a specific service and can be used across DHCP to replace"
^DIC(9.4,162,22,1,1,19,0)="  and/or complement keys. "
^DIC(9.4,162,22,1,1,20,0)=" "
^DIC(9.4,162,22,1,1,21,0)="+ ASU lets you link user classes with orders and order events or with"
^DIC(9.4,162,22,1,1,22,0)="  TIU Document Definitions and document events. This part of ASU defines"
^DIC(9.4,162,22,1,1,23,0)="  behavior for orders and TIU documents only. In a future version, it may"
^DIC(9.4,162,22,1,1,24,0)="  be extended to define behavior for other clinical entitites."
^DIC(9.4,162,22,1,1,25,0)=" "
^DIC(9.4,162,22,1,1,26,0)="+ User classes can be populated via a multiple field in the New Person"
^DIC(9.4,162,22,1,1,27,0)="  file pointing to the User Class file. "
^DIC(9.4,162,22,1,1,28,0)=" "
^DIC(9.4,162,22,1,1,29,0)="+ Class members may be active or inactive. "
^DIC(9.4,162,22,1,1,30,0)=" "
^DIC(9.4,162,22,1,1,31,0)="+ The Authorization/Subscription file links events (e.g., Sign) with"
^DIC(9.4,162,22,1,1,32,0)="  Document/Order type (e.g., Clinical Warning Note) with User Classes"
^DIC(9.4,162,22,1,1,33,0)="  (e.g., Provider Class). "
^DIC(9.4,162,22,1,1,34,0)=" "
^DIC(9.4,162,22,1,1,35,0)="+ ASU allows  infinite hierarchies of subclasses."
^DIC(9.4,162,22,1,1,36,0)=" "
^DIC(9.4,162,22,1,1,37,0)="+ ASU allows one level of document type to inherit document definition"
^DIC(9.4,162,22,1,1,38,0)="  from a higher level."
^DIC(9.4,162,22,1,"PAH",0)="^9.4901^33^33"
^DIC(9.4,162,22,1,"PAH",1,0)="1^2971222^1"
^DIC(9.4,162,22,1,"PAH",1,1,0)="^^2^2^2971222"
^DIC(9.4,162,22,1,"PAH",1,1,1,0)="ASU patch 1, USR*1.0*1. This patch removes broken subclass pointers"
^DIC(9.4,162,22,1,"PAH",1,1,2,0)="from file 8930 the USR CLASS FILE."
^DIC(9.4,162,22,1,"PAH",2,0)="2^2980423^1"
^DIC(9.4,162,22,1,"PAH",2,1,0)="^^3^3^2980423"
^DIC(9.4,162,22,1,"PAH",2,1,1,0)="ASU patch 2, USR*1.0*2. This patch prevents ""terminated"" users from"
^DIC(9.4,162,22,1,"PAH",2,1,2,0)="being selected for class membership. See the National Patch module for"
^DIC(9.4,162,22,1,"PAH",2,1,3,0)="a complete description."
^DIC(9.4,162,22,1,"PAH",3,0)="3^2980622^1"
^DIC(9.4,162,22,1,"PAH",3,1,0)="^^2^2^2980622"
^DIC(9.4,162,22,1,"PAH",3,1,1,0)="ASU patch 3, USR*1.0*3. This patch removes TIU dependencies from ASU."
^DIC(9.4,162,22,1,"PAH",3,1,2,0)="See the National Patch module for a complete description."
^DIC(9.4,162,22,1,"PAH",4,0)="4^2980622^1"
^DIC(9.4,162,22,1,"PAH",4,1,0)="^^3^3^2980622"
^DIC(9.4,162,22,1,"PAH",4,1,1,0)="ASU patch 4, USR*1.0*4. This patch adds options that allow examination"
^DIC(9.4,162,22,1,"PAH",4,1,2,0)="of class memberships without editing capabilites. See the National"
^DIC(9.4,162,22,1,"PAH",4,1,3,0)="Patch module for a complete description."
^DIC(9.4,162,22,1,"PAH",5,0)="5^2980625^1"
^DIC(9.4,162,22,1,"PAH",5,1,0)="^^2^2^2980625"
^DIC(9.4,162,22,1,"PAH",5,1,1,0)="ASU patch 5, USR*1.0*5. This patch eliminates multiple prompting for"
^DIC(9.4,162,22,1,"PAH",5,1,2,0)="User Classes with that have multiple matches."
^DIC(9.4,162,22,1,"PAH",6,0)="6^2980831^1"
^DIC(9.4,162,22,1,"PAH",6,1,0)="^^3^3^2980831"
^DIC(9.4,162,22,1,"PAH",6,1,1,0)="ASU patch 6, USR*1.0*6. This patch changes the display of user class"
^DIC(9.4,162,22,1,"PAH",6,1,2,0)="membership so that all instances of class membership will be displayed."
^DIC(9.4,162,22,1,"PAH",6,1,3,0)="See the National Patch Module for a complete description."
^DIC(9.4,162,22,1,"PAH",7,0)="7^2980923^1"
^DIC(9.4,162,22,1,"PAH",7,1,0)="^^2^2^2980923"
^DIC(9.4,162,22,1,"PAH",7,1,1,0)="ASU patch 7, USR*1.0*7. This patch changes expanding/collapsing of"
^DIC(9.4,162,22,1,"PAH",7,1,2,0)="class trees. See the National Patch Module for a complete description."
^DIC(9.4,162,22,1,"PAH",8,0)="8^2981007^1"
^DIC(9.4,162,22,1,"PAH",8,1,0)="^^2^2^2981007"
^DIC(9.4,162,22,1,"PAH",8,1,1,0)="ASU patch 8, USR*1.0*8. This patch allows for two users to have the same"
^DIC(9.4,162,22,1,"PAH",8,1,2,0)="name. See the National Patch Module for a complete description."
^DIC(9.4,162,22,1,"PAH",9,0)="9^2981016^1"
^DIC(9.4,162,22,1,"PAH",9,1,0)="^^3^3^2981016"
^DIC(9.4,162,22,1,"PAH",9,1,1,0)="ASU patch 9, USR*1.0*9. This patch changes the display name from the"
^DIC(9.4,162,22,1,"PAH",9,1,2,0)="SIGNATURE NAME PRINTED BLOCK to the .01 field of file 200. See the"
^DIC(9.4,162,22,1,"PAH",9,1,3,0)="National Patch Module for a complete description."
^DIC(9.4,162,22,1,"PAH",10,0)="10^2981026^1"
^DIC(9.4,162,22,1,"PAH",10,1,0)="^^3^3^2981026"
^DIC(9.4,162,22,1,"PAH",10,1,1,0)="ASU patch 10, USR*1.0*10. This patch fixes a problem with an undefined"
^DIC(9.4,162,22,1,"PAH",10,1,2,0)="when removing a user from class membership. See the National Patch Module"
^DIC(9.4,162,22,1,"PAH",10,1,3,0)="for a complete description."
^DIC(9.4,162,22,1,"PAH",11,0)="11 SEQ #11^2991003^1"
^DIC(9.4,162,22,1,"PAH",11,1,0)="^^2^2^2991003"
^DIC(9.4,162,22,1,"PAH",11,1,1,0)="ASU patch 11, USR*1.0*11. Make data element 8930,.03 required. See the"
^DIC(9.4,162,22,1,"PAH",11,1,2,0)="National Patch Module for a complete description."
^DIC(9.4,162,22,1,"PAH",12,0)="12 SEQ #12^2991210^1"
^DIC(9.4,162,22,1,"PAH",12,1,0)="^^3^3^2991210"
^DIC(9.4,162,22,1,"PAH",12,1,1,0)="AUS patch 12.  USR*1.0*12.  This patch fixes the problem of entering"
^DIC(9.4,162,22,1,"PAH",12,1,2,0)="the Expiration date less than the Effective date.  BUILD CAN BE FOUND"
^DIC(9.4,162,22,1,"PAH",12,1,3,0)="ON THE NATIONAL PATCH MODULE UNDER PATCH USR*1.0*12."
^DIC(9.4,162,22,1,"PAH",13,0)="13 SEQ #13^3000417^1"
^DIC(9.4,162,22,1,"PAH",13,1,0)="^^19^19^3000417"
^DIC(9.4,162,22,1,"PAH",13,1,1,0)="This patch fixes the problem that was detected by patch USR*1.0*12.  Field "
^DIC(9.4,162,22,1,"PAH",13,1,2,0)=".04 (Expiration Date) in global ^USR(8930.3) is a date only field and is "
^DIC(9.4,162,22,1,"PAH",13,1,3,0)="showing some invalid entries when a VA Fileman validate is run.  When a "
^DIC(9.4,162,22,1,"PAH",13,1,4,0)="clinician is terminated the USR CLASS MEMBERSHIP expiration field is "
^DIC(9.4,162,22,1,"PAH",13,1,5,0)="automatically entered with the termination date and time.  This patch will "
^DIC(9.4,162,22,1,"PAH",13,1,6,0)="correct the auto termination routine (USRLM) from including the termination "
^DIC(9.4,162,22,1,"PAH",13,1,7,0)="time when a clinician is terminated."
^DIC(9.4,162,22,1,"PAH",13,1,8,0)=" "
^DIC(9.4,162,22,1,"PAH",13,1,9,0)="The process of correcting the global will be done with a utility (USRFIX) "
^DIC(9.4,162,22,1,"PAH",13,1,10,0)="that will be run during the Post-Install.  This utility routine will print "
^DIC(9.4,162,22,1,"PAH",13,1,11,0)="the total number of corrections made to the global ^USR(8930.3)."
^DIC(9.4,162,22,1,"PAH",13,1,12,0)=" "
^DIC(9.4,162,22,1,"PAH",13,1,13,0)="This patch will also correct the problem of entering a Authorized/Subscription "
^DIC(9.4,162,22,1,"PAH",13,1,14,0)="Effective date that is greater than the Expriation date.  This change is "
^DIC(9.4,162,22,1,"PAH",13,1,15,0)="changing the routine USRU and the DD(8930.3) input transform on the .04 "
^DIC(9.4,162,22,1,"PAH",13,1,16,0)="field."
^DIC(9.4,162,22,1,"PAH",13,1,17,0)=""
^DIC(9.4,162,22,1,"PAH",13,1,18,0)="A description of the this build can be found on the NATIONAL PATCH MODULE "
^DIC(9.4,162,22,1,"PAH",13,1,19,0)="UNDER USR*1.0*13. "
^DIC(9.4,162,22,1,"PAH",14,0)="14 SEQ #14^3000516^1"
^DIC(9.4,162,22,1,"PAH",14,1,0)="^^13^13^3000516"
^DIC(9.4,162,22,1,"PAH",14,1,1,0)="This patch corrects a potential problem of a bad cross reference in the "
^DIC(9.4,162,22,1,"PAH",14,1,2,0)="^USR(8930.3) global.  The patch will change routine USRUMMBR to not abort "
^DIC(9.4,162,22,1,"PAH",14,1,3,0)="with a undefined variable USRCHNG when a bad 0 node pointer is discovered.  "
^DIC(9.4,162,22,1,"PAH",14,1,4,0)="Instead of the routine aborting it will send a email message to the user "
^DIC(9.4,162,22,1,"PAH",14,1,5,0)="DUZ reflecting the bad pointer.  The message will require forwarding to "
^DIC(9.4,162,22,1,"PAH",14,1,6,0)="a IRM representative at that site to review the USR(8930.3) global."
^DIC(9.4,162,22,1,"PAH",14,1,7,0)=""
^DIC(9.4,162,22,1,"PAH",14,1,8,0)="Also provided with this patch will be a Post-Install routine that will scan "
^DIC(9.4,162,22,1,"PAH",14,1,9,0)="the global and delete any bad AUC or ACU cross references.  The Post-Install "
^DIC(9.4,162,22,1,"PAH",14,1,10,0)="will display the cross reference being deleted and also a count."
^DIC(9.4,162,22,1,"PAH",14,1,11,0)=""
^DIC(9.4,162,22,1,"PAH",14,1,12,0)="A description of this build can be found on the NATIONAL PATCH MODULE UNDER "
^DIC(9.4,162,22,1,"PAH",14,1,13,0)="USR*1.0*14."
^DIC(9.4,162,22,1,"PAH",15,0)="16 SEQ #15^3000905^1"
^DIC(9.4,162,22,1,"PAH",15,1,0)="^^3^3^3000905"
^DIC(9.4,162,22,1,"PAH",15,1,1,0)=""
