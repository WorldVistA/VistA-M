^DIC(9.4,4,22,1,"PAH",146,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,3,0)="Test Site:  FORUM; Clarksburg, WV"
^DIC(9.4,4,22,1,"PAH",146,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,5,0)="NOIS: ISL-0299-52128"
^DIC(9.4,4,22,1,"PAH",146,1,6,0)="Increase from 8 to 9, the number of characters of the device name that is"
^DIC(9.4,4,22,1,"PAH",146,1,7,0)="kept in field 6, NETWORK DEVICE, of file 4.2999, MESSAGE STATISTICS."
^DIC(9.4,4,22,1,"PAH",146,1,8,0)="That way, there is less of a chance that important information is dropped."
^DIC(9.4,4,22,1,"PAH",146,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,10,0)="The following options are improved:"
^DIC(9.4,4,22,1,"PAH",146,1,11,0)="XMQHIST        Historical Queue Data/Stats Report"
^DIC(9.4,4,22,1,"PAH",146,1,12,0)="XMQUEUED       Queues with Messages to Transmit Report"
^DIC(9.4,4,22,1,"PAH",146,1,13,0)="XMQACTIVE      Actively Transmitting/Receiving Queues Report"
^DIC(9.4,4,22,1,"PAH",146,1,14,0)="XMSTARTQUE-ALL Transmit All Queues"
^DIC(9.4,4,22,1,"PAH",146,1,15,0)="XMQDISP        Display Active & Inactive Message Queues"
^DIC(9.4,4,22,1,"PAH",146,1,16,0)="The pre-init deletes some fields (ENTRY ACTION, EXIT ACTION) which are"
^DIC(9.4,4,22,1,"PAH",146,1,17,0)="no longer used in options XMQUEUED & XMQDISP."
^DIC(9.4,4,22,1,"PAH",146,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,19,0)="The following field is updated.  The field is larger and no longer accepts"
^DIC(9.4,4,22,1,"PAH",146,1,20,0)="digits after the decimal point."
^DIC(9.4,4,22,1,"PAH",146,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,22,0)="STANDARD DATA DICTIONARY #4.2999 -- MESSAGE STATISTICS FILE"
^DIC(9.4,4,22,1,"PAH",146,1,23,0)="STORED IN ^XMBS(4.2999,"
^DIC(9.4,4,22,1,"PAH",146,1,24,0)="DATA      NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",146,1,25,0)="ELEMENT   TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",146,1,26,0)="---------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",146,1,27,0)="4.2999,5  RATE OF TRANSMISSION   3;5 NUMBER"
^DIC(9.4,4,22,1,"PAH",146,1,28,0)="          INPUT TRANSFORM:  K:+X'=X!(X>999999999)!(X<0)!(X?.E1"".""1N.N) X"
^DIC(9.4,4,22,1,"PAH",146,1,29,0)="          LAST EDITED:      MAR 20, 2001 "
^DIC(9.4,4,22,1,"PAH",146,1,30,0)="          HELP-PROMPT:      Type a Number between 0 and 999999999, 0 Decimal "
^DIC(9.4,4,22,1,"PAH",146,1,31,0)="                            Digits "
^DIC(9.4,4,22,1,"PAH",146,1,32,0)="          DESCRIPTION:      This is the transmission rate in characters per"
^DIC(9.4,4,22,1,"PAH",146,1,33,0)="                            second for the current transmission.  It may be"
^DIC(9.4,4,22,1,"PAH",146,1,34,0)="                            for a single line or for a block or for the"
^DIC(9.4,4,22,1,"PAH",146,1,35,0)="                            entire message.  It is updated regularly during"
^DIC(9.4,4,22,1,"PAH",146,1,36,0)="                            the transmission.  "
^DIC(9.4,4,22,1,"PAH",146,1,37,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,38,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",146,1,39,0)="is at a minimum.  It requires MailMan patches XM*7.1*142 & XM*7.1*176."
^DIC(9.4,4,22,1,"PAH",146,1,40,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",146,1,41,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,42,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",146,1,43,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",146,1,44,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",146,1,45,0)=" "
^DIC(9.4,4,22,1,"PAH",146,1,46,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",146,1,47,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",146,1,48,0)="-------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",146,1,49,0)="XMLSTAT        1232153         1231749        173"
^DIC(9.4,4,22,1,"PAH",146,1,50,0)="XMS4           2836511         2449556        50,173"
^DIC(9.4,4,22,1,"PAH",146,1,51,0)="XMS5          13300220        10992631        13,8,23,27,55,58,50,142,173"
^DIC(9.4,4,22,1,"PAH",146,1,52,0)="XMS5A          3571279         3634911        55,50,173"
^DIC(9.4,4,22,1,"PAH",146,1,53,0)="XMSMAIL        4266359         4266449        59,50,107,176,173"
^DIC(9.4,4,22,1,"PAH",146,1,54,0)="XMYPRE8         228290          275167        142,173"
^DIC(9.4,4,22,1,"PAH",146,1,55,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,56,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",146,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,58,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",146,1,59,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",146,1,60,0)=" "
^DIC(9.4,4,22,1,"PAH",146,1,61,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",146,1,62,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",146,1,63,0)="is at a minimum.  It requires MailMan patches XM*7.1*142 & XM*7.1*176."
^DIC(9.4,4,22,1,"PAH",146,1,64,0)="1.  Users should not be on the system during patch installation."
^DIC(9.4,4,22,1,"PAH",146,1,65,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",146,1,66,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",146,1,67,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",146,1,68,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",146,1,69,0)="4.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",146,1,70,0)="    option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",146,1,71,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",146,1,72,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",146,1,73,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",146,1,74,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",146,1,75,0)="5.  Stop TaskMan.  Shut down the listeners.  You may also wish to shut down"
^DIC(9.4,4,22,1,"PAH",146,1,76,0)="    HL7 filers/LLP's and other background tasks which may attempt to create"
^DIC(9.4,4,22,1,"PAH",146,1,77,0)="    new messages.  During the installation of this patch, we do not want any"
^DIC(9.4,4,22,1,"PAH",146,1,78,0)="    messages coming in or going out.  Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",146,1,79,0)="6.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",146,1,80,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",146,1,81,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",146,1,82,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",146,1,83,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",146,1,84,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",146,1,85,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",146,1,86,0)=" Select INSTALL NAME:    XM*7.1*173     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",146,1,87,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",146,1,88,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",146,1,89,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,4,22,1,"PAH",146,1,90,0)="                                                                   ==="
^DIC(9.4,4,22,1,"PAH",146,1,91,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,4,22,1,"PAH",146,1,92,0)="                                                       ==="
^DIC(9.4,4,22,1,"PAH",146,1,93,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// YES"
^DIC(9.4,4,22,1,"PAH",146,1,94,0)="                                                                       ==="
^DIC(9.4,4,22,1,"PAH",146,1,95,0)=" Enter options you wish to mark as 'Out Of Order': XMUSER       MailMan Menu"
^DIC(9.4,4,22,1,"PAH",146,1,96,0)="                                                   ======"
^DIC(9.4,4,22,1,"PAH",146,1,97,0)=" Enter options you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",146,1,98,0)="                                                   =============="
^DIC(9.4,4,22,1,"PAH",146,1,99,0)=" Enter protocols you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",146,1,100,0)="                                                     =============="
^DIC(9.4,4,22,1,"PAH",146,1,101,0)=" Delay Install (Minutes):  (0-60): 0// <press return>"
^DIC(9.4,4,22,1,"PAH",146,1,102,0)="                                       =============="
^DIC(9.4,4,22,1,"PAH",146,1,103,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",146,1,104,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",146,1,105,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",146,1,106,0)=""
^DIC(9.4,4,22,1,"PAH",146,1,107,0)=" DEVICE: HOME// <Do not queue this.>"
^DIC(9.4,4,22,1,"PAH",146,1,108,0)="                --------------------"
^DIC(9.4,4,22,1,"PAH",146,1,109,0)="7.  Start TaskMan.  If you shut down HL7 filers/LLP's and other"
^DIC(9.4,4,22,1,"PAH",146,1,110,0)="    background tasks in step 4, be sure to restart them, too."
^DIC(9.4,4,22,1,"PAH",146,1,111,0)="8.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",146,1,112,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",146,1,113,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",146,1,114,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",146,1,115,0)="9.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",146,1,116,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",147,0)="177 SEQ #172^3010517^1"
^DIC(9.4,4,22,1,"PAH",147,1,0)="^^92^92^3010517"
^DIC(9.4,4,22,1,"PAH",147,1,1,0)="Patch XM*7.1*177"
^DIC(9.4,4,22,1,"PAH",147,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",147,1,3,0)="NOIS: IVM-0301-32726, BAY-0101-30908"
^DIC(9.4,4,22,1,"PAH",147,1,4,0)="Test Site: HEC-ATLANTA; Bay Pines, FL"
^DIC(9.4,4,22,1,"PAH",147,1,5,0)="At times of high messaging activity, contention in getting locks on the"
^DIC(9.4,4,22,1,"PAH",147,1,6,0)="MESSAGE file causes problems.  This patch attempts to ameliorate that"
^DIC(9.4,4,22,1,"PAH",147,1,7,0)="problem by removing MailMan's locking of the MESSAGE file, and letting"
^DIC(9.4,4,22,1,"PAH",147,1,8,0)="FileMan handle it alone.  You will never again see the message, ""We're"
^DIC(9.4,4,22,1,"PAH",147,1,9,0)="having problems getting a lock on the MESSAGE file, do you want to wait?"""
^DIC(9.4,4,22,1,"PAH",147,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",147,1,11,0)="Additionally, the group message actions have been made more efficient."
^DIC(9.4,4,22,1,"PAH",147,1,12,0)="Actions involving new messages are faster.  Actions involving moving"
^DIC(9.4,4,22,1,"PAH",147,1,13,0)="messages out of a basket are faster.  So, 'New Toggle', 'Delete',"
^DIC(9.4,4,22,1,"PAH",147,1,14,0)="'Terminate', 'Filter', and 'Save' are faster."
^DIC(9.4,4,22,1,"PAH",147,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",147,1,16,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",147,1,17,0)="minimum.  It requires MailMan patches XM*7.1*126, *136, *143, *151, *168, &"
^DIC(9.4,4,22,1,"PAH",147,1,18,0)="*172."
^DIC(9.4,4,22,1,"PAH",147,1,19,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",147,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",147,1,21,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",147,1,22,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",147,1,23,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",147,1,24,0)=" "
