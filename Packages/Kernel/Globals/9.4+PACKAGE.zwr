^DIC(9.4,217,22,1,"PAH",4,1,1,0)="VPS*1*4 includes:"
^DIC(9.4,217,22,1,"PAH",4,1,2,0)="1. New RPC to Print Patient Wristband with option to print EDIPI/SSN"
^DIC(9.4,217,22,1,"PAH",4,1,3,0)="barcode"
^DIC(9.4,217,22,1,"PAH",4,1,4,0)="2  New RPC to print Patient label with option to print EDIPI/SSN barcode  "
^DIC(9.4,217,22,1,"PAH",4,1,5,0)="3. New RPCs to integrate with Howdy package"
^DIC(9.4,217,22,1,"PAH",4,1,6,0)="4. New RPC to integrate with Patient Clinical Reminders"
^DIC(9.4,217,22,1,"PAH",4,1,7,0)="5. Enhancement to Patient Demographic"
^DIC(9.4,217,22,1,"PAH",5,0)="5^3150805.104911^17"
^DIC(9.4,217,22,1,"PAH",6,0)="3^3150805.104912^17"
