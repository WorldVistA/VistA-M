^DIC(9.4,13,22,7,"PAH",22,1,214,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,215,0)="     To test if the transport has been corrupted, you can use the"
^DIC(9.4,13,22,7,"PAH",22,1,216,0)="     ""Verify Package Integrity"" option.  This option is under"
^DIC(9.4,13,22,7,"PAH",22,1,217,0)="     Utilities under the KIDS menu.  It will compare the checksums"
^DIC(9.4,13,22,7,"PAH",22,1,218,0)="     in the build with the current checksums and list any that"
^DIC(9.4,13,22,7,"PAH",22,1,219,0)="     differ."
^DIC(9.4,13,22,7,"PAH",22,1,220,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,221,0)="Installation Instructions:"
^DIC(9.4,13,22,7,"PAH",22,1,222,0)="=========================="
^DIC(9.4,13,22,7,"PAH",22,1,223,0)="NOTE any instructions that are different for DSM sites."
^DIC(9.4,13,22,7,"PAH",22,1,224,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,225,0)="     1.   Users ARE NOT allowed to be on the system during the"
^DIC(9.4,13,22,7,"PAH",22,1,226,0)="     installation."
^DIC(9.4,13,22,7,"PAH",22,1,227,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,228,0)="     2.   Place TaskMan in a WAIT state."
^DIC(9.4,13,22,7,"PAH",22,1,229,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,230,0)="     3.   DSM sites: Disable routine mapping (DIC1, DIR, DIR1, &"
^DIC(9.4,13,22,7,"PAH",22,1,231,0)="     DIR2 are usually mapped)."
^DIC(9.4,13,22,7,"PAH",22,1,232,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,233,0)="     4.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan"
^DIC(9.4,13,22,7,"PAH",22,1,234,0)="     menu. This option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",22,1,235,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,236,0)="     5.   The patch has now been loaded into a Transport global on"
^DIC(9.4,13,22,7,"PAH",22,1,237,0)="     your system. You now need to use KIDS to install the Transport"
^DIC(9.4,13,22,7,"PAH",22,1,238,0)="     global."
^DIC(9.4,13,22,7,"PAH",22,1,239,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,240,0)="     6.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",22,1,241,0)="     following options:"
^DIC(9.4,13,22,7,"PAH",22,1,242,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,243,0)="           Verify Checksums in Transport Global"
^DIC(9.4,13,22,7,"PAH",22,1,244,0)="           Print Transport Global"
^DIC(9.4,13,22,7,"PAH",22,1,245,0)="           Compare Transport Global to Current System"
^DIC(9.4,13,22,7,"PAH",22,1,246,0)="           Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",22,1,247,0)="           Install Package(s)"
^DIC(9.4,13,22,7,"PAH",22,1,248,0)="           INSTALL NAME: DI*21.0*41"
^DIC(9.4,13,22,7,"PAH",22,1,249,0)="                         =========="
^DIC(9.4,13,22,7,"PAH",22,1,250,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,251,0)="     7.   DSM sites: Rebuild your mapped routine set."
^DIC(9.4,13,22,7,"PAH",22,1,252,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,253,0)="     8.   Remove TaskMan from its WAIT state."
^DIC(9.4,13,22,7,"PAH",23,0)="12 SEQ #17^2980319^1"
^DIC(9.4,13,22,7,"PAH",24,0)="43^2970710"
^DIC(9.4,13,22,7,"PAH",24,1,0)="^^72^72^2980408"
^DIC(9.4,13,22,7,"PAH",24,1,1,0)=" Description:"
^DIC(9.4,13,22,7,"PAH",24,1,2,0)=" ============"
^DIC(9.4,13,22,7,"PAH",24,1,3,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,4,0)="      This patch fixes a problem introduced by patch DI*21*29,"
^DIC(9.4,13,22,7,"PAH",24,1,5,0)="      an invalid subscript error that could occur when editing"
^DIC(9.4,13,22,7,"PAH",24,1,6,0)="      a long line of M code in an input template. This problem"
^DIC(9.4,13,22,7,"PAH",24,1,7,0)="      was reported as NOIS ISW-0497-21817."
^DIC(9.4,13,22,7,"PAH",24,1,8,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,9,0)=" Test Sites :"
^DIC(9.4,13,22,7,"PAH",24,1,10,0)=" ============"
^DIC(9.4,13,22,7,"PAH",24,1,11,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,12,0)="      Albany ISC"
^DIC(9.4,13,22,7,"PAH",24,1,13,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,14,0)=" Routine Summary :"
^DIC(9.4,13,22,7,"PAH",24,1,15,0)=" ================="
^DIC(9.4,13,22,7,"PAH",24,1,16,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,17,0)="      The following is a list of the routines included in this patch."
^DIC(9.4,13,22,7,"PAH",24,1,18,0)="      The second line of each of these routines now looks like:"
^DIC(9.4,13,22,7,"PAH",24,1,19,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,20,0)="      <tab>;;21.0;VA FileMan;**patch list**;Dec 28, 1994"
^DIC(9.4,13,22,7,"PAH",24,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,22,0)=" Checksums According to CHECK^XTSUMBLD:"
^DIC(9.4,13,22,7,"PAH",24,1,23,0)=" ======================================"
^DIC(9.4,13,22,7,"PAH",24,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,25,0)="   Rtn Nm   Chksum Before   Chksum After  Patch List"
^DIC(9.4,13,22,7,"PAH",24,1,26,0)="   ------   -------------   ------------  ----------"
^DIC(9.4,13,22,7,"PAH",24,1,27,0)="   DICF     7724491         7752413       29,43"
^DIC(9.4,13,22,7,"PAH",24,1,28,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,29,0)="      To test if the transport has been corrupted, you can use the"
^DIC(9.4,13,22,7,"PAH",24,1,30,0)="      ""Verify Package Integrity"" option.  This option is under Utilities"
^DIC(9.4,13,22,7,"PAH",24,1,31,0)="      under the KIDS menu.  It will compare the checksums in the build"
^DIC(9.4,13,22,7,"PAH",24,1,32,0)="      with the current checksums and list any that differ."
^DIC(9.4,13,22,7,"PAH",24,1,33,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,34,0)=" Installation Instructions:"
^DIC(9.4,13,22,7,"PAH",24,1,35,0)=" =========================="
^DIC(9.4,13,22,7,"PAH",24,1,36,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,37,0)=" NOTE any instructions that are different for 486 or Alpha sites."
^DIC(9.4,13,22,7,"PAH",24,1,38,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,39,0)="      1.   Users ARE NOT allowed to be on the system during the"
^DIC(9.4,13,22,7,"PAH",24,1,40,0)="      installation."
^DIC(9.4,13,22,7,"PAH",24,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,42,0)="      2.   DO place TaskMan in a WAIT state."
^DIC(9.4,13,22,7,"PAH",24,1,43,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,44,0)="      3.   This routine is not usually mapped on systems that allow"
^DIC(9.4,13,22,7,"PAH",24,1,45,0)="      it so you will probably not have to disable mapping."
^DIC(9.4,13,22,7,"PAH",24,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,47,0)="      4.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,13,22,7,"PAH",24,1,48,0)="      This option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",24,1,49,0)=" "
^DIC(9.4,13,22,7,"PAH",24,1,50,0)="      5.   The patch has now been loaded into a Transport global on your"
^DIC(9.4,13,22,7,"PAH",24,1,51,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,13,22,7,"PAH",24,1,52,0)="  "
^DIC(9.4,13,22,7,"PAH",24,1,53,0)="      6.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",24,1,54,0)="      following options:"
^DIC(9.4,13,22,7,"PAH",24,1,55,0)="  "
^DIC(9.4,13,22,7,"PAH",24,1,56,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,7,"PAH",24,1,57,0)="            Print Transport Global"
^DIC(9.4,13,22,7,"PAH",24,1,58,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,7,"PAH",24,1,59,0)="            Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",24,1,60,0)="            Install Package(s)"
^DIC(9.4,13,22,7,"PAH",24,1,61,0)="            INSTALL NAME: DI*21.0*43"
^DIC(9.4,13,22,7,"PAH",24,1,62,0)="                          =========="
^DIC(9.4,13,22,7,"PAH",24,1,63,0)="  "
^DIC(9.4,13,22,7,"PAH",24,1,64,0)="      7.   MSM Sites - Answer YES to the question 'Want to MOVE"
^DIC(9.4,13,22,7,"PAH",24,1,65,0)="      routines to other CPUs?'. Enter the names of your Compute and"
^DIC(9.4,13,22,7,"PAH",24,1,66,0)="      Print server(s)."
^DIC(9.4,13,22,7,"PAH",24,1,67,0)="  "
^DIC(9.4,13,22,7,"PAH",24,1,68,0)="           AXP Sites - Answer NO to this question."
^DIC(9.4,13,22,7,"PAH",24,1,69,0)="  "
^DIC(9.4,13,22,7,"PAH",24,1,70,0)="      8.   Rebuild your mapped set if necessary."
^DIC(9.4,13,22,7,"PAH",24,1,71,0)="  "
^DIC(9.4,13,22,7,"PAH",24,1,72,0)="      9.   DO remove TaskMan from a WAIT state."
^DIC(9.4,13,22,7,"PAH",25,0)="41^2980312"
^DIC(9.4,13,22,7,"PAH",25,1,0)="^^253^253^2980408"
^DIC(9.4,13,22,7,"PAH",25,1,1,0)="Description:"
^DIC(9.4,13,22,7,"PAH",25,1,2,0)="============"
^DIC(9.4,13,22,7,"PAH",25,1,3,0)="     This patch contains critical bug fixes requested by package "
^DIC(9.4,13,22,7,"PAH",25,1,4,0)="     developers in need of the fixes for their own patches or "
^DIC(9.4,13,22,7,"PAH",25,1,5,0)="     package releases."
^DIC(9.4,13,22,7,"PAH",25,1,6,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,7,0)="     Compiled Routines"
^DIC(9.4,13,22,7,"PAH",25,1,8,0)="     -----------------"
^DIC(9.4,13,22,7,"PAH",25,1,9,0)="     1. Compiled Routines: problem uncompiling xrefs: DIPZ0 (for "
^DIC(9.4,13,22,7,"PAH",25,1,10,0)="     Mike Hendry). Mr. Hendry reported that uncompiling cross-"
^DIC(9.4,13,22,7,"PAH",25,1,11,0)="     references didn't work if the file had whole file-cross-"
^DIC(9.4,13,22,7,"PAH",25,1,12,0)="     references on one of its subfiles. Reported in NOIS ISL-0897-"
^DIC(9.4,13,22,7,"PAH",25,1,13,0)="     51962."
^DIC(9.4,13,22,7,"PAH",25,1,14,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,15,0)="     2. Compiled Routines: problem uncompiling input templates: "
^DIC(9.4,13,22,7,"PAH",25,1,16,0)="     DIEZ (for Cindy Heuer). Ms. Heuer reported that uncompiled "
^DIC(9.4,13,22,7,"PAH",25,1,17,0)="     input templates would recompile themselves when the "
^DIC(9.4,13,22,7,"PAH",25,1,18,0)="     definitions of fields within those templates were changed. "
^DIC(9.4,13,22,7,"PAH",25,1,19,0)="     Reported in FORUM msg # 23842872."
^DIC(9.4,13,22,7,"PAH",25,1,20,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,21,0)="     Reader"
^DIC(9.4,13,22,7,"PAH",25,1,22,0)="     ------"
^DIC(9.4,13,22,7,"PAH",25,1,23,0)="     3. Reader: case sensitivity with codes: DIR1 (for Marcia"
^DIC(9.4,13,22,7,"PAH",25,1,24,0)="     Insley). Ms. Insley reported that the Reader converted the"
^DIC(9.4,13,22,7,"PAH",25,1,25,0)="     case of the user's input for the external form of the codes,"
^DIC(9.4,13,22,7,"PAH",25,1,26,0)="     but not for the internal. Reported in Forum msg # 23931868."
^DIC(9.4,13,22,7,"PAH",25,1,27,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,28,0)="     4. Reader: list and range problems: DIR3 (for Gary Beuschel)."
^DIC(9.4,13,22,7,"PAH",25,1,29,0)="     Mr. Beuschel reported problem was that the Reader rejects"
^DIC(9.4,13,22,7,"PAH",25,1,30,0)="     lists that contain consecutive numbers out of order, such as"
^DIC(9.4,13,22,7,"PAH",25,1,31,0)="     50,49; I found that it also rejected a number followed by a"
^DIC(9.4,13,22,7,"PAH",25,1,32,0)="     range ending in that number, such as 50,40-50. Reported in"
^DIC(9.4,13,22,7,"PAH",25,1,33,0)="     ISC-SF msg #s 1190657, 1193613, and 1193773."
^DIC(9.4,13,22,7,"PAH",25,1,34,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,35,0)="     5. Reader: problems with help for dates: DIR, DIR2 (for Gary "
^DIC(9.4,13,22,7,"PAH",25,1,36,0)="     Beuschel). Mr. Beuschel reported that the help for dates is "
^DIC(9.4,13,22,7,"PAH",25,1,37,0)="     scanty compared to what the %DT utility provides. It has been "
^DIC(9.4,13,22,7,"PAH",25,1,38,0)="     brought in line with %DT's, and also made responsive to the "
^DIC(9.4,13,22,7,"PAH",25,1,39,0)="     date parameters passed in the second ^-piece of DIR(0). "
^DIC(9.4,13,22,7,"PAH",25,1,40,0)="     Reported by phone."
^DIC(9.4,13,22,7,"PAH",25,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,42,0)="     6. Reader: DIR(""PRE"") parameter: DIR (for Gary Beuschel). Mr."
^DIC(9.4,13,22,7,"PAH",25,1,43,0)="     Beuschel needed a programming hook to let him intercept the"
^DIC(9.4,13,22,7,"PAH",25,1,44,0)="     user's input before the Reader begins its data type"
^DIC(9.4,13,22,7,"PAH",25,1,45,0)="     validation. The new supported input parameter DIR(""PRE"") is a"
^DIC(9.4,13,22,7,"PAH",25,1,46,0)="     pre-validation transform that can either change X, in which"
^DIC(9.4,13,22,7,"PAH",25,1,47,0)="     case the Reader will proceed as though the new value is what"
^DIC(9.4,13,22,7,"PAH",25,1,48,0)="     the user entered, or can kill X, in which case the Reader will"
^DIC(9.4,13,22,7,"PAH",25,1,49,0)="     behave as though the user entered an illegal value. DIR(""PRE"")"
^DIC(9.4,13,22,7,"PAH",25,1,50,0)="     executes almost immediately after the READ takes place, just"
^DIC(9.4,13,22,7,"PAH",25,1,51,0)="     after DTOUT is set and before any other checking is done. The"
^DIC(9.4,13,22,7,"PAH",25,1,52,0)="     only inputs are X and DTOUT, and the only outputs are X and"
^DIC(9.4,13,22,7,"PAH",25,1,53,0)="     DTOUT. Reported in phone conversation with Mr. Beuschel."
^DIC(9.4,13,22,7,"PAH",25,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,55,0)="     Lookup"
^DIC(9.4,13,22,7,"PAH",25,1,56,0)="     ------"
^DIC(9.4,13,22,7,"PAH",25,1,57,0)="     7. Classic Lookup: echo & match lists: DIC1 (for Marcia "
^DIC(9.4,13,22,7,"PAH",25,1,58,0)="     Insley, Tana Defa, and Melissa Hughes). Ms. Insley reported "
^DIC(9.4,13,22,7,"PAH",25,1,59,0)="     during testing of CPRS that Puget Sound needed a change to how "
^DIC(9.4,13,22,7,"PAH",25,1,60,0)="     DIC's E flag works. The E flag, which normally ensures a "
^DIC(9.4,13,22,7,"PAH",25,1,61,0)="     user's response is echoed back, did not do so when the user "
^DIC(9.4,13,22,7,"PAH",25,1,62,0)="     picked from a match list, a time when typos are therefore "
^DIC(9.4,13,22,7,"PAH",25,1,63,0)="     difficult to notice but easy to make. This was changed to "
^DIC(9.4,13,22,7,"PAH",25,1,64,0)="     make E work with match list selections. Reported in Forum msg "
^DIC(9.4,13,22,7,"PAH",25,1,65,0)="     # 24573804."
^DIC(9.4,13,22,7,"PAH",25,1,66,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,67,0)="     8. Finder: `IEN lookup problem: DICF1 (for Gary Beuschel). Mr. "
^DIC(9.4,13,22,7,"PAH",25,1,68,0)="     Beuschel reported that the Finder's `IEN lookup is only "
^DIC(9.4,13,22,7,"PAH",25,1,69,0)="     allowing IENs that are integers, disallowing such IENs as the "
^DIC(9.4,13,22,7,"PAH",25,1,70,0)="     Postmaster's (.5). This was fixed. Reported in phone "
^DIC(9.4,13,22,7,"PAH",25,1,71,0)="     conversation with Mr. Beuschel."
^DIC(9.4,13,22,7,"PAH",25,1,72,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,73,0)="     9. Finder: illegal number error: DICF3 (for Bob Fuller). Mr. "
^DIC(9.4,13,22,7,"PAH",25,1,74,0)="     Fuller reported an illegal number error caused by the Finder's "
^DIC(9.4,13,22,7,"PAH",25,1,75,0)="     vulnerability to input that looks like an exponential. The "
^DIC(9.4,13,22,7,"PAH",25,1,76,0)="     Finder has been bullet-proofed. Reported in NOIS # BRX-0397-"
^DIC(9.4,13,22,7,"PAH",25,1,77,0)="     12605."
^DIC(9.4,13,22,7,"PAH",25,1,78,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,79,0)="     10. Finder & Lister: tolerate empty indexes: DICF2, DICF3, "
^DIC(9.4,13,22,7,"PAH",25,1,80,0)="     DICF5, DICL1 (for Rob Whelan, Deborah Gorman, Diane McCance, "
^DIC(9.4,13,22,7,"PAH",25,1,81,0)="     and Gary Beuschel). Reported in NOIS #s BHH-0897-41483 and "
^DIC(9.4,13,22,7,"PAH",25,1,82,0)="     CLE-0797-42276, and in phone conversations with Mr. Whelan and "
^DIC(9.4,13,22,7,"PAH",25,1,83,0)="     Mr. Beuschel. "
^DIC(9.4,13,22,7,"PAH",25,1,84,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,85,0)="     Enter & Edit"
^DIC(9.4,13,22,7,"PAH",25,1,86,0)="     ------------"
^DIC(9.4,13,22,7,"PAH",25,1,87,0)="     11. Filer: prevent variable problem: DIEFU (for Joel Ivey). "
^DIC(9.4,13,22,7,"PAH",25,1,88,0)="     Mr. Joel reported that during testing of Patient Merge, the "
^DIC(9.4,13,22,7,"PAH",25,1,89,0)="     Filer did not adequately protect its own variables from deeply "
^DIC(9.4,13,22,7,"PAH",25,1,90,0)="     recursive calls, playing havoc during Merge. This was fixed. "
^DIC(9.4,13,22,7,"PAH",25,1,91,0)="     Reported in phone conversation with Mr. Ivey."
^DIC(9.4,13,22,7,"PAH",25,1,92,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,93,0)="     12. Filer: allow deletion of top-level records: DIEF (for & by "
^DIC(9.4,13,22,7,"PAH",25,1,94,0)="     Danila Manapsal). Ms. Manapsal reported that the FileMan "
^DIC(9.4,13,22,7,"PAH",25,1,95,0)="     Components need the ability to delete records through the "
^DIC(9.4,13,22,7,"PAH",25,1,96,0)="     Filer. She corrected the Filer to allow this. Reported in "
^DIC(9.4,13,22,7,"PAH",25,1,97,0)="     phone conversation with Ms. Manapsal."
^DIC(9.4,13,22,7,"PAH",25,1,98,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,99,0)="     13. Updater: allow deletion of top-level records: DICA1 (for "
^DIC(9.4,13,22,7,"PAH",25,1,100,0)="     Danila Manapsal). This change is also for the FileMan "
^DIC(9.4,13,22,7,"PAH",25,1,101,0)="     Components."
^DIC(9.4,13,22,7,"PAH",25,1,102,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,103,0)="     14. Updater: allow deletion of fields: DICA1 (for Michael "
^DIC(9.4,13,22,7,"PAH",25,1,104,0)="     Ogi). Mr. Ogi reported that the Updater is needlessly blocking "
^DIC(9.4,13,22,7,"PAH",25,1,105,0)="     the ability to delete fields, something the Filer (which it "
^DIC(9.4,13,22,7,"PAH",25,1,106,0)="     calls) allows. This was changed. Reported in phone "
^DIC(9.4,13,22,7,"PAH",25,1,107,0)="     conversation with Mr. Ogi."
^DIC(9.4,13,22,7,"PAH",25,1,108,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,109,0)="     15. Updater: subentry problem: DICA1 (for Mike Kilmade). Mr. "
^DIC(9.4,13,22,7,"PAH",25,1,110,0)="     Kilmade reported during development of PCMM that the Updater "
^DIC(9.4,13,22,7,"PAH",25,1,111,0)="     was preventing deletion of subfile entries if the same FDA "
^DIC(9.4,13,22,7,"PAH",25,1,112,0)="     added another subentry. This was fixed. Reported in Forum msg "
^DIC(9.4,13,22,7,"PAH",25,1,113,0)="     # 19707244."
^DIC(9.4,13,22,7,"PAH",25,1,114,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,115,0)="     16. Updater: process LAYGO Finding nodes before Adding nodes: "
^DIC(9.4,13,22,7,"PAH",25,1,116,0)="     DICA2 (for Michael Ogi). Mr. Ogi reported during testing of "
^DIC(9.4,13,22,7,"PAH",25,1,117,0)="     the Udpater that a bug prevented it from processing FDA nodes "
^DIC(9.4,13,22,7,"PAH",25,1,118,0)="     in the order specified, which occasionally caused undefined "
^DIC(9.4,13,22,7,"PAH",25,1,119,0)="     errors. The documented order was reestablished. Reported in "
^DIC(9.4,13,22,7,"PAH",25,1,120,0)="     phone conversation with Mr. Ogi."
^DIC(9.4,13,22,7,"PAH",25,1,121,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,122,0)="     17. Updater: return 0 nodes for LAYGO Finding nodes: DICA (for "
^DIC(9.4,13,22,7,"PAH",25,1,123,0)="     Michael Ogi). Mr. Ogi reported during testing of the Updater "
^DIC(9.4,13,22,7,"PAH",25,1,124,0)="     that it was not returning 0 nodes for LAYGO Finding nodes as "
^DIC(9.4,13,22,7,"PAH",25,1,125,0)="     documented. The documented order was reestablished. Reported "
^DIC(9.4,13,22,7,"PAH",25,1,126,0)="     in phone conversation with Mr. Ogi."
^DIC(9.4,13,22,7,"PAH",25,1,127,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,128,0)="     18. Updater: stop errors with LAYGO Finding nodes: DICA1 (for "
^DIC(9.4,13,22,7,"PAH",25,1,129,0)="     Alan Chan). Mr. Chan reported that under some circumstances "
^DIC(9.4,13,22,7,"PAH",25,1,130,0)="     LAYGO Finding nodes were reporting errors instead of finding "
^DIC(9.4,13,22,7,"PAH",25,1,131,0)="     existing entries. The errors were stopped, and LAYGO Finding "
^DIC(9.4,13,22,7,"PAH",25,1,132,0)="     nodes now properly find existing entries. Reported in ISC-SF "
^DIC(9.4,13,22,7,"PAH",25,1,133,0)="     msg # 1170164."
^DIC(9.4,13,22,7,"PAH",25,1,134,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,135,0)="     19. Updater: stop multiple Updaters interference: DICA1 (for "
^DIC(9.4,13,22,7,"PAH",25,1,136,0)="     Travis Torres). Mr. Torres reported that Updaters running "
^DIC(9.4,13,22,7,"PAH",25,1,137,0)="     simultaneously in different processes on the same machine "
^DIC(9.4,13,22,7,"PAH",25,1,138,0)="     could occasionally process each other's FDAs. The code was "
^DIC(9.4,13,22,7,"PAH",25,1,139,0)="     changed to better segregate their data structures. Reported in "
^DIC(9.4,13,22,7,"PAH",25,1,140,0)="     phone conversation with Mr. Torres."
^DIC(9.4,13,22,7,"PAH",25,1,141,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,142,0)="     Output"
^DIC(9.4,13,22,7,"PAH",25,1,143,0)="     ------"
^DIC(9.4,13,22,7,"PAH",25,1,144,0)="     20. Sort: remove duplicates from prints: DIO0 (for David "
^DIC(9.4,13,22,7,"PAH",25,1,145,0)="     Alexander, John Harvey, Nancy Nagle, Dan Petit, Daniel "
^DIC(9.4,13,22,7,"PAH",25,1,146,0)="     Schramm, Ellen Zufall, Fil Beza). Many sites reported problems "
^DIC(9.4,13,22,7,"PAH",25,1,147,0)="     with prints in which mnemonic cross-reference entries in the B "
^DIC(9.4,13,22,7,"PAH",25,1,148,0)="     index were creating false positives in reports. Ms. Zufall and "
^DIC(9.4,13,22,7,"PAH",25,1,149,0)="     Mr. Beza identified the problem as introduced by patch "
^DIC(9.4,13,22,7,"PAH",25,1,150,0)="     DI*21*35, and Ms. Zufall fixed it. Reported in ISC-SF msg # "
^DIC(9.4,13,22,7,"PAH",25,1,151,0)="     1198710, FORUM msg #s 25464901 and 25149562, and NOIS #s SFC-"
^DIC(9.4,13,22,7,"PAH",25,1,152,0)="     0198-60115, TOP-0198-40108, & WBP-1297-21797."
^DIC(9.4,13,22,7,"PAH",25,1,153,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,154,0)="     21. Transfer: improve performance: DITR, and DITR1 (for Dave "
^DIC(9.4,13,22,7,"PAH",25,1,155,0)="     Bolduc). Mr. Bolduc reported slow performance on large "
^DIC(9.4,13,22,7,"PAH",25,1,156,0)="     transfers, and identified a fix to the problem that was "
^DIC(9.4,13,22,7,"PAH",25,1,157,0)="     gratefully accepted. Reported in NOIS # AIM-0797-N2065."
^DIC(9.4,13,22,7,"PAH",25,1,158,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,159,0)="     Special thanks go to Dave Alexander, whose keen eye for bugs"
^DIC(9.4,13,22,7,"PAH",25,1,160,0)="     saved the rest of the VA a lot of grief with this patch.  :)"
^DIC(9.4,13,22,7,"PAH",25,1,161,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,162,0)="Test Sites :"
^DIC(9.4,13,22,7,"PAH",25,1,163,0)="============"
^DIC(9.4,13,22,7,"PAH",25,1,164,0)="     AIM Center"
^DIC(9.4,13,22,7,"PAH",25,1,165,0)="     Boston VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,166,0)="     Bronx VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,167,0)="     Dublin VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,168,0)="     Huntington VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,169,0)="     Oklahoma City VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,170,0)="     Prescott VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,171,0)="     Puget Sound HCS"
^DIC(9.4,13,22,7,"PAH",25,1,172,0)="     San Francisco VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,173,0)="     Tuscaloosa VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,174,0)="     Washington VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,175,0)="     West Palm Beach VAMC"
^DIC(9.4,13,22,7,"PAH",25,1,176,0)="     Birmingham CIOFO"
^DIC(9.4,13,22,7,"PAH",25,1,177,0)="     Hines CIOFO"
^DIC(9.4,13,22,7,"PAH",25,1,178,0)="     Salt Lake City CIOFO"
^DIC(9.4,13,22,7,"PAH",25,1,179,0)="     San Francisco CIOFO"
^DIC(9.4,13,22,7,"PAH",25,1,180,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,181,0)="Routine Summary :"
^DIC(9.4,13,22,7,"PAH",25,1,182,0)="================="
^DIC(9.4,13,22,7,"PAH",25,1,183,0)="     The following is a list of the routines included in this"
^DIC(9.4,13,22,7,"PAH",25,1,184,0)="     patch."
^DIC(9.4,13,22,7,"PAH",25,1,185,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,186,0)="     The second line of each of these routines now looks like:"
^DIC(9.4,13,22,7,"PAH",25,1,187,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,188,0)="     <tab>;;21.0;VA FileMan;**patch list**;Dec 28, 1994"
^DIC(9.4,13,22,7,"PAH",25,1,189,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,190,0)="     (Checksums According to CHECK^XTSUMBLD)"
^DIC(9.4,13,22,7,"PAH",25,1,191,0)=" "
