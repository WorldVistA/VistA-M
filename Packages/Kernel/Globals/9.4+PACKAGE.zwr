^DIC(9.4,35,22,3,"PAH",405,1,180,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,181,0)="Patch Installation:"
^DIC(9.4,35,22,3,"PAH",405,1,182,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,183,0)="Installation Instructions"
^DIC(9.4,35,22,3,"PAH",405,1,184,0)="-------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,185,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,35,22,3,"PAH",405,1,186,0)="recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,35,22,3,"PAH",405,1,187,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,35,22,3,"PAH",405,1,188,0)="minutes to install. "
^DIC(9.4,35,22,3,"PAH",405,1,189,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,190,0)="Pre-Installation Instructions"
^DIC(9.4,35,22,3,"PAH",405,1,191,0)="-----------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,192,0)="N/A"
^DIC(9.4,35,22,3,"PAH",405,1,193,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,194,0)="Installation Instructions"
^DIC(9.4,35,22,3,"PAH",405,1,195,0)="-----------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,196,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,197,0)="1.  Choose the PackMan message containing this patch."
^DIC(9.4,35,22,3,"PAH",405,1,198,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,199,0)="2.  Choose the INSTALL/CHECK MESSAGE PackMan option. "
^DIC(9.4,35,22,3,"PAH",405,1,200,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,201,0)="3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,35,22,3,"PAH",405,1,202,0)="    the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,35,22,3,"PAH",405,1,203,0)="    following option. When prompted for the INSTALL enter patch "
^DIC(9.4,35,22,3,"PAH",405,1,204,0)="    OR*3.0*490:"
^DIC(9.4,35,22,3,"PAH",405,1,205,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,206,0)="    a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,35,22,3,"PAH",405,1,207,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,35,22,3,"PAH",405,1,208,0)="        backup any other changes such as DD's or templates."
^DIC(9.4,35,22,3,"PAH",405,1,209,0)="    b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,35,22,3,"PAH",405,1,210,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,35,22,3,"PAH",405,1,211,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,35,22,3,"PAH",405,1,212,0)="        (routines, DD's, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",405,1,213,0)="    c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,35,22,3,"PAH",405,1,214,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,35,22,3,"PAH",405,1,215,0)="        transport global."
^DIC(9.4,35,22,3,"PAH",405,1,216,0)="    "
^DIC(9.4,35,22,3,"PAH",405,1,217,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,35,22,3,"PAH",405,1,218,0)="    choose the patch to install."
^DIC(9.4,35,22,3,"PAH",405,1,219,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,220,0)="5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,35,22,3,"PAH",405,1,221,0)="    Install? NO//NO  "
^DIC(9.4,35,22,3,"PAH",405,1,222,0)="   "
^DIC(9.4,35,22,3,"PAH",405,1,223,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,35,22,3,"PAH",405,1,224,0)="    NO// "
^DIC(9.4,35,22,3,"PAH",405,1,225,0)="                                                                "
^DIC(9.4,35,22,3,"PAH",405,1,226,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,35,22,3,"PAH",405,1,227,0)="    and Protocols? NO//"
^DIC(9.4,35,22,3,"PAH",405,1,228,0)="  "
^DIC(9.4,35,22,3,"PAH",405,1,229,0)="8.  If prompted ""Delay Install (Minutes):  (0 - 60): 0// respond 0."
^DIC(9.4,35,22,3,"PAH",405,1,230,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,231,0)="Post-Installation Instructions"
^DIC(9.4,35,22,3,"PAH",405,1,232,0)="------------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,233,0)="For all users who will need to be able to perform the task detailed "
^DIC(9.4,35,22,3,"PAH",405,1,234,0)="above, these users will need the ""GMRC ADMIN RBP TO CC"" security key."
^DIC(9.4,35,22,3,"PAH",405,1,235,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,236,0)="Backout and Rollback Procedure:"
^DIC(9.4,35,22,3,"PAH",405,1,237,0)="-------------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,238,0)="This patch contains three RA routines.  The decision to back-out or "
^DIC(9.4,35,22,3,"PAH",405,1,239,0)="rollback software will be a joint decision between development team, VA "
^DIC(9.4,35,22,3,"PAH",405,1,240,0)="site/region personnel and other appropriate VA personnel."
^DIC(9.4,35,22,3,"PAH",405,1,241,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,242,0)="Prior to installing an updated KIDS package, the site/region should have "
^DIC(9.4,35,22,3,"PAH",405,1,243,0)="saved a backup of the routines in a mail message using the Backup a "
^DIC(9.4,35,22,3,"PAH",405,1,244,0)="Transport Global [XPD BACKUP] menu option (this is done at time of "
^DIC(9.4,35,22,3,"PAH",405,1,245,0)="install).The message containing the backed-up routines can be loaded with "
^DIC(9.4,35,22,3,"PAH",405,1,246,0)="the ""XtractPackMan"" function at the Message Action prompt. The Packman "
^DIC(9.4,35,22,3,"PAH",405,1,247,0)="function ""INSTALL/CHECK MESSAGE"" is then used to install the backed-up "
^DIC(9.4,35,22,3,"PAH",405,1,248,0)="routines onto the VistA System. "
^DIC(9.4,35,22,3,"PAH",405,1,249,0)="  "
^DIC(9.4,35,22,3,"PAH",405,1,250,0)="Validation of Roll Back Procedure:"
^DIC(9.4,35,22,3,"PAH",405,1,251,0)="----------------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,252,0)="The Roll Back Procedure can be verified by printing the first 2 lines of "
^DIC(9.4,35,22,3,"PAH",405,1,253,0)="the three RA routines contained in this patch using the option First Line "
^DIC(9.4,35,22,3,"PAH",405,1,254,0)="Routine Print  [XU FIRST LINE PRINT]. Once the routines contained in the "
^DIC(9.4,35,22,3,"PAH",405,1,255,0)="OR*3.0*490 patch have been rolled back, the first two lines of the "
^DIC(9.4,35,22,3,"PAH",405,1,256,0)="Routines will no longer contain the designation of patch OR*3.0*490 in "
^DIC(9.4,35,22,3,"PAH",405,1,257,0)="the patch list section on line 2."
^DIC(9.4,35,22,3,"PAH",405,1,258,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,259,0)="Back-out/Rollback Strategy:"
^DIC(9.4,35,22,3,"PAH",405,1,260,0)="---------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,261,0)="In the event of a catastrophic failure, the Facility CIO may make the "
^DIC(9.4,35,22,3,"PAH",405,1,262,0)="decision to back-out the patch."
^DIC(9.4,35,22,3,"PAH",405,1,263,0)="    "
^DIC(9.4,35,22,3,"PAH",405,1,264,0)="It is imperative that you have performed a backup of the routines "
^DIC(9.4,35,22,3,"PAH",405,1,265,0)="included in this patch prior to installation."
^DIC(9.4,35,22,3,"PAH",405,1,266,0)="   "
^DIC(9.4,35,22,3,"PAH",405,1,267,0)="The back-out plan is to restore the routines from the backup created."
^DIC(9.4,35,22,3,"PAH",405,1,268,0)="   "
^DIC(9.4,35,22,3,"PAH",405,1,269,0)="No data was modified by this patch installation and, therefore, no "
^DIC(9.4,35,22,3,"PAH",405,1,270,0)="rollback strategy is required."
^DIC(9.4,35,22,3,"PAH",405,1,271,0)="   "
^DIC(9.4,35,22,3,"PAH",405,1,272,0)="To verify the back-out completed successfully, ensure the checksum "
^DIC(9.4,35,22,3,"PAH",405,1,273,0)="matches the pre-patch checksum from the patch descriptions."
^DIC(9.4,35,22,3,"PAH",406,0)="494 SEQ #417^3190102.174459^54"
^DIC(9.4,35,22,3,"PAH",406,1,0)="^^35^35^3190102"
^DIC(9.4,35,22,3,"PAH",406,1,1,0)="INC2101638: Missing Text on ""Return to Clinic"" Orders"
^DIC(9.4,35,22,3,"PAH",406,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,3,0)="Problem:"
^DIC(9.4,35,22,3,"PAH",406,1,4,0)="-------"
^DIC(9.4,35,22,3,"PAH",406,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,6,0)="When a ""Return to Clinic"" order is copied, the text ""on or around"" is "
^DIC(9.4,35,22,3,"PAH",406,1,7,0)="missing before the date.  Example: The order should state ""Return to "
^DIC(9.4,35,22,3,"PAH",406,1,8,0)="Clinic ABC on or around (Sep 24, 2018) for a total of 1 appointment(s).""  "
^DIC(9.4,35,22,3,"PAH",406,1,9,0)="Instead, a copied order will state ""Return to Clinic ABC Sep 24, 2018 for "
^DIC(9.4,35,22,3,"PAH",406,1,10,0)="a total of 1 appointment(s)."""
^DIC(9.4,35,22,3,"PAH",406,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,12,0)="Resolution: "
^DIC(9.4,35,22,3,"PAH",406,1,13,0)="----------"
^DIC(9.4,35,22,3,"PAH",406,1,14,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,15,0)="Modify routine ORWDXM1 to force the user to edit the order which will "
^DIC(9.4,35,22,3,"PAH",406,1,16,0)="include entering a new date. (The same date may be entered for the copied "
^DIC(9.4,35,22,3,"PAH",406,1,17,0)="order if that complies with procedures to have two ""Return to Clinic"" "
^DIC(9.4,35,22,3,"PAH",406,1,18,0)="orders for the same clinic and same date.)"
^DIC(9.4,35,22,3,"PAH",406,1,19,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,20,0)="INC2105632: RTC orders canceled when INTERVAL is zero (0)"
^DIC(9.4,35,22,3,"PAH",406,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,22,0)="Problem:"
^DIC(9.4,35,22,3,"PAH",406,1,23,0)="--------"
^DIC(9.4,35,22,3,"PAH",406,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,25,0)="When a using the VISTA CPRS CLINICIAN MENU option OR OE/RR MENU CLINICIAN "
^DIC(9.4,35,22,3,"PAH",406,1,26,0)="to place a RTC order and the Number of Appointments is greater than one "
^DIC(9.4,35,22,3,"PAH",406,1,27,0)="(1), the Interval should not be allowed to be zero (0)."
^DIC(9.4,35,22,3,"PAH",406,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,29,0)="Resolution:"
^DIC(9.4,35,22,3,"PAH",406,1,30,0)="-----------"
^DIC(9.4,35,22,3,"PAH",406,1,31,0)=" "
^DIC(9.4,35,22,3,"PAH",406,1,32,0)="The patch modifies the INTERVAL item (OR GTX SCH INTERVAL) for the ORDER "
^DIC(9.4,35,22,3,"PAH",406,1,33,0)="DIALOG SD RTC in the ORDER DIALOG file (#101.41).  The modification makes "
^DIC(9.4,35,22,3,"PAH",406,1,34,0)="the INTERVAL a required field when the value of the Number of "
^DIC(9.4,35,22,3,"PAH",406,1,35,0)="Appointments field is greater than one (1)."
^DIC(9.4,35,22,3,"PAH",407,0)="493 SEQ #418^3190201.14484^54"
^DIC(9.4,35,22,3,"PAH",408,0)="479 SEQ #419^3190201.160713^54"
^DIC(9.4,35,22,3,"PAH",408,1,0)="^^1^1^3190201"
^DIC(9.4,35,22,3,"PAH",408,1,1,0)="VSR RPC BACKDOOR UPDATES"
^DIC(9.4,35,22,3,"PAH",409,0)="489 SEQ #420^3190301.154248^54"
^DIC(9.4,35,22,3,"PAH",410,0)="472 SEQ #421^3190305.144201^54"
^DIC(9.4,35,22,3,"PAH",410,1,0)="^^12^12^3190305"
^DIC(9.4,35,22,3,"PAH",410,1,1,0)="The Mental Health Suicide Prevention - Suicide High Risk Patient "
^DIC(9.4,35,22,3,"PAH",410,1,2,0)="Enhancements (SHRPE) effort incorporates enhancements that will modify the"
^DIC(9.4,35,22,3,"PAH",410,1,3,0)="VistA Registration application and CPRS."
^DIC(9.4,35,22,3,"PAH",410,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",410,1,5,0)="The Disruptive Behavior Reporting System (DBRS) record numbers can now be "
^DIC(9.4,35,22,3,"PAH",410,1,6,0)="recorded in the Registration (DG) files that are related to Patient Record"
^DIC(9.4,35,22,3,"PAH",410,1,7,0)="Flags (PRF) which now provides a convenient reference between VistA and "
^DIC(9.4,35,22,3,"PAH",410,1,8,0)="the DBRS. The ""Patient Record Flags"" screen in CPRS is updated to display"
^DIC(9.4,35,22,3,"PAH",410,1,9,0)="DBRS numbers entered for the patient."
^DIC(9.4,35,22,3,"PAH",410,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",410,1,11,0)="This patch implements the functionality that allows CPRS to display the "
^DIC(9.4,35,22,3,"PAH",410,1,12,0)="DBRS data stored in VistA Registration database."
^DIC(9.4,35,22,3,"PAH",411,0)="503 SEQ #422^3190501.155235^54"
^DIC(9.4,35,22,3,"PAH",411,1,0)="^^7^7^3190501"
^DIC(9.4,35,22,3,"PAH",411,1,1,0)="This patch addresses two issues:"
^DIC(9.4,35,22,3,"PAH",411,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",411,1,3,0)="1. The C index in the OE/RR NOTIFICATIONS file (#100.9) contains entries"
^DIC(9.4,35,22,3,"PAH",411,1,4,0)="   for the .01 NAME field."
^DIC(9.4,35,22,3,"PAH",411,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",411,1,6,0)="2. A Lab VBECS component might have a modifier filed when there should be "
^DIC(9.4,35,22,3,"PAH",411,1,7,0)="   no modifier."
^DIC(9.4,35,22,3,"PAH",412,0)="444 SEQ #423^3190501.155732^54"
^DIC(9.4,35,22,3,"PAH",412,1,0)="^^1^1^3190501"
^DIC(9.4,35,22,3,"PAH",412,1,1,0)="This patch is for NSR20130714 Unified Action Profile"
^DIC(9.4,35,22,3,"PAH",413,0)="509 SEQ #424^3190604.175545^54"
^DIC(9.4,35,22,3,"PAH",413,1,0)="^^1^1^3190604"
^DIC(9.4,35,22,3,"PAH",413,1,1,0)="CPRS GUI corrections for Windows 10"
^DIC(9.4,35,22,3,"PAH",414,0)="505 SEQ #425^3190604.180041^54"
^DIC(9.4,35,22,3,"PAH",415,0)="495^3190722.171056^65"
^DIC(9.4,35,22,3,"PAH",415,1,0)="^^2^2^3190722"
^DIC(9.4,35,22,3,"PAH",415,1,1,0)="OR*3.0*495 - Please refer to the patch description in Forum for "
^DIC(9.4,35,22,3,"PAH",415,1,2,0)="installation instructions."
^DIC(9.4,35,22,3,"PAH",416,0)="510 SEQ #428^3190904.100515^65"
^DIC(9.4,35,22,3,"PAH",416,1,0)="^^7^7^3190904"
^DIC(9.4,35,22,3,"PAH",416,1,1,0)="The patch addresses two (2) issues:"
^DIC(9.4,35,22,3,"PAH",416,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",416,1,3,0)="1. Lab order checking for order frequency does not occur for future "
^DIC(9.4,35,22,3,"PAH",416,1,4,0)="   orders."
^DIC(9.4,35,22,3,"PAH",416,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",416,1,6,0)="2. Lab order checking for duplicate orders does not occur for future "
^DIC(9.4,35,22,3,"PAH",416,1,7,0)="orders."
^DIC(9.4,35,22,3,"PAH",417,0)="496 SEQ #429^3190916.094225^65"
^DIC(9.4,35,22,3,"PAH",417,1,0)="^^2^2^3190916"
^DIC(9.4,35,22,3,"PAH",417,1,1,0)="This patch adds the VETERAN VIDEO CALL URL field to the Hospital Location "
^DIC(9.4,35,22,3,"PAH",417,1,2,0)="file, Appointment multiple."
^DIC(9.4,35,22,3,"PAH",418,0)="427^3190930.103654^65"
^DIC(9.4,35,22,3,"PAH",418,1,0)="^^1^1^3190930"
^DIC(9.4,35,22,3,"PAH",418,1,1,0)="MENTAL HEALTH NCC PROJECT 5.01"
^DIC(9.4,35,22,3,"PAH",419,0)="500 SEQ #430^3191003.155416^65"
^DIC(9.4,35,22,3,"PAH",419,1,0)="^^2^2^3191003"
^DIC(9.4,35,22,3,"PAH",419,1,1,0)="View Alerts Optimization.  Please see OR*3.0*500 Patch Description for "
^DIC(9.4,35,22,3,"PAH",419,1,2,0)="details."
^DIC(9.4,35,22,3,"PAH",420,0)="397 SEQ #431^3191028.121557^65"
^DIC(9.4,35,22,3,"PAH",421,0)="514 SEQ #432^3191219.135837^65"
^DIC(9.4,35,22,3,"PAH",421,1,0)="^^1^1^3191219"
^DIC(9.4,35,22,3,"PAH",421,1,1,0)="See the patch description for a full listing of functionality and changes."
^DIC(9.4,35,22,3,"PAH",422,0)="516 SEQ #433^3200211.095415^65"
^DIC(9.4,35,22,3,"PAH",423,0)="518 SEQ #434^3200228.125728^65"
^DIC(9.4,35,22,3,"PAH",423,1,0)="^^1^1^3200228"
^DIC(9.4,35,22,3,"PAH",423,1,1,0)="Please see the patch description for OR*3.0*518."
^DIC(9.4,35,22,3,"PAH",424,0)="485^3200420.124059^70"
^DIC(9.4,35,22,3,"PAH",424,1,0)="^^1^1^3200420"
^DIC(9.4,35,22,3,"PAH",424,1,1,0)="COVID-19 GUI changes supporting patch."
^DIC(9.4,35,22,3,"PAH",425,0)="377^3200624.121449^65"
^DIC(9.4,35,22,3,"PAH",425,1,0)="^^3^3^3200624"
^DIC(9.4,35,22,3,"PAH",425,1,1,0)="This patch is the M side of CPRS GUI v31B. This patch will be distributed "
^DIC(9.4,35,22,3,"PAH",425,1,2,0)="as part of a multi-package build. Please see the entry in the National "
^DIC(9.4,35,22,3,"PAH",425,1,3,0)="Patch Module for detailed information about this patch and CPRS GUI v31B."
^DIC(9.4,35,22,3,"PAH",426,0)="515 SEQ #438^3200707.160705^65"
^DIC(9.4,35,22,3,"PAH",426,1,0)="^^1^1^3200707"
^DIC(9.4,35,22,3,"PAH",426,1,1,0)="Refer to the patch description."
^DIC(9.4,35,22,3,"PAH",427,0)="531^3200713.171131^65"
^DIC(9.4,35,22,3,"PAH",428,0)="523 SEQ #440^3200803.112142^65"
^DIC(9.4,35,22,3,"PAH",429,0)="525 SEQ #441^3200810.125404^65"
^DIC(9.4,35,22,3,"PAH",429,1,0)="^^1^1^3200810"
^DIC(9.4,35,22,3,"PAH",429,1,1,0)="See patch description."
