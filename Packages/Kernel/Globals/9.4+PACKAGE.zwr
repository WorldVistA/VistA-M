^DIC(9.4,14,22,5.9,"PAH",108,1,197,0)="Options:"
^DIC(9.4,14,22,5.9,"PAH",108,1,198,0)="==================="
^DIC(9.4,14,22,5.9,"PAH",108,1,199,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,200,0)="This patch will install a new option 'NLT Mapped Code Search' [LRCAP64S]"
^DIC(9.4,14,22,5.9,"PAH",108,1,201,0)="This option is designed to assist in management of national codes linked"
^DIC(9.4,14,22,5.9,"PAH",108,1,202,0)="to WKLD CODE (#64) file entries."
^DIC(9.4,14,22,5.9,"PAH",108,1,203,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,204,0)="NAME: LRCAP64S            MENU TEXT: NLT Mapped Code Search"
^DIC(9.4,14,22,5.9,"PAH",108,1,205,0)="  TYPE: run routine                     CREATOR: STALLING,FRANK"
^DIC(9.4,14,22,5.9,"PAH",108,1,206,0)="  PACKAGE: LAB SERVICE"
^DIC(9.4,14,22,5.9,"PAH",108,1,207,0)=" DESCRIPTION:   This option is useful when determining what codes are"
^DIC(9.4,14,22,5.9,"PAH",108,1,208,0)="linked to what entry in the WKLD CODE (#64) file. Several national coding"
^DIC(9.4,14,22,5.9,"PAH",108,1,209,0)="schemes (i.e. CPT, LOINC, MORPHOLOGY) can be linked to the WKLD CODE file."
^DIC(9.4,14,22,5.9,"PAH",108,1,210,0)="This option will search the entire WKLD CODE file to determine if specific"
^DIC(9.4,14,22,5.9,"PAH",108,1,211,0)="national codes are linked.  "
^DIC(9.4,14,22,5.9,"PAH",108,1,212,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,213,0)="The search can be done for as many codes of the same set as required. The"
^DIC(9.4,14,22,5.9,"PAH",108,1,214,0)="report will list the national code(s) and any WKLD CODE(s) linked.  "
^DIC(9.4,14,22,5.9,"PAH",108,1,215,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,216,0)="This option can be used to assist when a particular national code should"
^DIC(9.4,14,22,5.9,"PAH",108,1,217,0)="be changed or deleted."
^DIC(9.4,14,22,5.9,"PAH",108,1,218,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,219,0)="   LRMENU     Laboratory DHCP Menu"
^DIC(9.4,14,22,5.9,"PAH",108,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,221,0)="Select Laboratory DHCP Menu Option:  Supervisor menu"
