^DIC(9.4,33,22,1.4,"PAH",57,1,1,0)="Patch HL*1.6*62"
^DIC(9.4,33,22,1.4,"PAH",57,1,2,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,3,0)="NOIS: LAS-0100-61912, GRJ-0400-51133, HIN-0501-42418"
^DIC(9.4,33,22,1.4,"PAH",57,1,4,0)="Test Sites: Las Vegas, NV; Grand Junction, CO"
^DIC(9.4,33,22,1.4,"PAH",57,1,5,0)="This patch increases the amount of time between checks to see if the filers"
^DIC(9.4,33,22,1.4,"PAH",57,1,6,0)="have been asked to stop.  In most cases, the check is performed at most"
^DIC(9.4,33,22,1.4,"PAH",57,1,7,0)="once a minute."
^DIC(9.4,33,22,1.4,"PAH",57,1,8,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,9,0)="For serial connections, this patch also improves the efficiency of the"
^DIC(9.4,33,22,1.4,"PAH",57,1,10,0)="inbound filers.  A whole file cross reference has been added to message"
^DIC(9.4,33,22,1.4,"PAH",57,1,11,0)="STATUS field of the IN QUEUE multiple of the HL LOGICAL LINK FILE, #870."
^DIC(9.4,33,22,1.4,"PAH",57,1,12,0)="The inbound filers can now go directly to the logical links which have"
^DIC(9.4,33,22,1.4,"PAH",57,1,13,0)="inbound messages pending, instead of constantly checking each logical"
^DIC(9.4,33,22,1.4,"PAH",57,1,14,0)="link to see if any messages are pending."
^DIC(9.4,33,22,1.4,"PAH",57,1,15,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,16,0)="The post-init for this patch will go through file 870 and fire the new xref."
^DIC(9.4,33,22,1.4,"PAH",57,1,17,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,18,0)="Here's the updated field with its new xref:"
^DIC(9.4,33,22,1.4,"PAH",57,1,19,0)="* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,33,22,1.4,"PAH",57,1,20,0)="STANDARD DATA DICTIONARY #870.019 -- IN QUEUE SUB-FILE"
^DIC(9.4,33,22,1.4,"PAH",57,1,21,0)="STORED IN ^HLCS(870,"
^DIC(9.4,33,22,1.4,"PAH",57,1,22,0)="DATA        NAME               GLOBAL        DATA"
^DIC(9.4,33,22,1.4,"PAH",57,1,23,0)="ELEMENT     TITLE              LOCATION      TYPE"
^DIC(9.4,33,22,1.4,"PAH",57,1,24,0)="--------------------------------------------------------------------------"
^DIC(9.4,33,22,1.4,"PAH",57,1,25,0)="870.019,1   STATUS              0;2 SET"
^DIC(9.4,33,22,1.4,"PAH",57,1,26,0)="                           'P' FOR PENDING; "
^DIC(9.4,33,22,1.4,"PAH",57,1,27,0)="                           'D' FOR DONE PROCESSING; "
^DIC(9.4,33,22,1.4,"PAH",57,1,28,0)="                           'S' FOR STUB RECORD; "
^DIC(9.4,33,22,1.4,"PAH",57,1,29,0)="            LAST EDITED:   MAY 08, 2000 "
^DIC(9.4,33,22,1.4,"PAH",57,1,30,0)="            HELP-PROMPT:   This is the status of an individual message in "
^DIC(9.4,33,22,1.4,"PAH",57,1,31,0)="                           the queue. These statuses control the flow and "
^DIC(9.4,33,22,1.4,"PAH",57,1,32,0)="                           processing of the message. "
^DIC(9.4,33,22,1.4,"PAH",57,1,33,0)="            DESCRIPTION:   Status of a particular message. Can be Stub,"
^DIC(9.4,33,22,1.4,"PAH",57,1,34,0)="                           Pending, or Done.  These statuses control the"
^DIC(9.4,33,22,1.4,"PAH",57,1,35,0)="                           processing of a message. For example, a stub"
^DIC(9.4,33,22,1.4,"PAH",57,1,36,0)="                           record is created when a message is enqueued,"
^DIC(9.4,33,22,1.4,"PAH",57,1,37,0)="                           and cannot be processed until its status is"
^DIC(9.4,33,22,1.4,"PAH",57,1,38,0)="                           changed from 'stub' to 'pending'.  Changing"
^DIC(9.4,33,22,1.4,"PAH",57,1,39,0)="                           this status is the last thing the Low Layer"
^DIC(9.4,33,22,1.4,"PAH",57,1,40,0)="                           Protocol does after reading in a message. "
^DIC(9.4,33,22,1.4,"PAH",57,1,41,0)="                           Finally, once the message has been processed,"
^DIC(9.4,33,22,1.4,"PAH",57,1,42,0)="                           its status is changed to 'done'.  "
^DIC(9.4,33,22,1.4,"PAH",57,1,43,0)="            CROSS-REFERENCE:  870^AISTAT "
^DIC(9.4,33,22,1.4,"PAH",57,1,44,0)="                           1)= S ^HLCS(870,""AISTAT"",$E(X,1,30),DA(1),DA)="""""
^DIC(9.4,33,22,1.4,"PAH",57,1,45,0)="                           2)= K ^HLCS(870,""AISTAT"",$E(X,1,30),DA(1),DA)"
^DIC(9.4,33,22,1.4,"PAH",57,1,46,0)="                           Used to quickly identify links with messages"
^DIC(9.4,33,22,1.4,"PAH",57,1,47,0)="                           in any status, thus improving performance."
^DIC(9.4,33,22,1.4,"PAH",57,1,48,0)="* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,33,22,1.4,"PAH",57,1,49,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,50,0)="The option, HL PURGE TRANSMISSIONS, is updated to improve the description"
^DIC(9.4,33,22,1.4,"PAH",57,1,51,0)="and to set the SCHEDULING RECOMMENDED field to YES."
^DIC(9.4,33,22,1.4,"PAH",57,1,52,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,53,0)="Here's the updated option:"
^DIC(9.4,33,22,1.4,"PAH",57,1,54,0)="* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,33,22,1.4,"PAH",57,1,55,0)="NAME: HL PURGE TRANSMISSIONS            MENU TEXT: Purge Messages"
^DIC(9.4,33,22,1.4,"PAH",57,1,56,0)="TYPE: run routine                     CREATOR: DIMICELI,RON"
^DIC(9.4,33,22,1.4,"PAH",57,1,57,0)="PACKAGE: HEALTH LEVEL SEVEN"
^DIC(9.4,33,22,1.4,"PAH",57,1,58,0)="DESCRIPTION:   This option purges entries from the HL7 message files: "
^DIC(9.4,33,22,1.4,"PAH",57,1,59,0)=" 773 - HL7 MESSAGE ADMINISTRATION "
^DIC(9.4,33,22,1.4,"PAH",57,1,60,0)=" 772 - HL7 MESSAGE TEXT "
^DIC(9.4,33,22,1.4,"PAH",57,1,61,0)="  "
^DIC(9.4,33,22,1.4,"PAH",57,1,62,0)="These files contain a record of all outgoing HL7 transmissions and their "
^DIC(9.4,33,22,1.4,"PAH",57,1,63,0)="status.  Messages are purged if they are in a certain status and are a"
^DIC(9.4,33,22,1.4,"PAH",57,1,64,0)="certain number of days old.  The default parameters (number of days) are"
^DIC(9.4,33,22,1.4,"PAH",57,1,65,0)="taken from fields in file 869.3, HL COMMUNICATION SERVER PARAMETERS.  The"
^DIC(9.4,33,22,1.4,"PAH",57,1,66,0)="fields should be set such that a balance is struck between the need to"
^DIC(9.4,33,22,1.4,"PAH",57,1,67,0)="keep disk space from filling up and the need to keep messages around long"
^DIC(9.4,33,22,1.4,"PAH",57,1,68,0)="enough so that they can be investigated in case problems arise.  Please"
^DIC(9.4,33,22,1.4,"PAH",57,1,69,0)="see the descriptions of these fields for more information: "
^DIC(9.4,33,22,1.4,"PAH",57,1,70,0)="  41 - PURGE COMPLETED MESSAGES "
^DIC(9.4,33,22,1.4,"PAH",57,1,71,0)="  42 - PURGE AWAITING ACK MESSAGES "
^DIC(9.4,33,22,1.4,"PAH",57,1,72,0)="  43 - PURGE ALL MESSAGES "
^DIC(9.4,33,22,1.4,"PAH",57,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",57,1,74,0)="Note that the number of days in field 43 must be greater than or equal to"
^DIC(9.4,33,22,1.4,"PAH",57,1,75,0)="the number of days in field 42, which must be greater than or equal to the"
^DIC(9.4,33,22,1.4,"PAH",57,1,76,0)="number of days in field 41.  If any of the fields violates this rule, then"
^DIC(9.4,33,22,1.4,"PAH",57,1,77,0)="the default values of these fields will be used, instead.  "
^DIC(9.4,33,22,1.4,"PAH",57,1,78,0)=" "
^DIC(9.4,33,22,1.4,"PAH",57,1,79,0)="To purge entries in an error status, run this option directly and answer"
^DIC(9.4,33,22,1.4,"PAH",57,1,80,0)="'Yes' to the question about purging them.  It is recommended that entries in"
^DIC(9.4,33,22,1.4,"PAH",57,1,81,0)="an error status be reviewed before purging.  For this reason, such messages"
^DIC(9.4,33,22,1.4,"PAH",57,1,82,0)="are NOT purged by automatically recurring scheduled runs of this option.  "
^DIC(9.4,33,22,1.4,"PAH",57,1,83,0)=" "
^DIC(9.4,33,22,1.4,"PAH",57,1,84,0)="It is recommended that this option be scheduled to run once a day to keep"
^DIC(9.4,33,22,1.4,"PAH",57,1,85,0)="the files from getting too large.  On TaskMan's 'Edit Option Schedule', the"
^DIC(9.4,33,22,1.4,"PAH",57,1,86,0)="TASK PARAMETERS field is ignored.  Instead, the parameters are taken from"
^DIC(9.4,33,22,1.4,"PAH",57,1,87,0)="the fields in file 869.3, noted above.  "
^DIC(9.4,33,22,1.4,"PAH",57,1,88,0)="ROUTINE: PURGE^HLUOPT1                TIMESTAMP: 55644,54515"
^DIC(9.4,33,22,1.4,"PAH",57,1,89,0)="SCHEDULING RECOMMENDED: YES           UPPERCASE MENU TEXT: PURGE MESSAGES"
^DIC(9.4,33,22,1.4,"PAH",57,1,90,0)="* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,33,22,1.4,"PAH",57,1,91,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,92,0)="NOTE: This patch should be installed during off hours, when activity is at"
^DIC(9.4,33,22,1.4,"PAH",57,1,93,0)="a minimum.  It requires HL7 patches HL*1.6*28, *34, & *47."
^DIC(9.4,33,22,1.4,"PAH",57,1,94,0)="============================================================================"
^DIC(9.4,33,22,1.4,"PAH",57,1,95,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,96,0)="ROUTINES:"
^DIC(9.4,33,22,1.4,"PAH",57,1,97,0)="The second line of the routine now looks like:"
^DIC(9.4,33,22,1.4,"PAH",57,1,98,0)="       ;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;JUL 17,1995"
^DIC(9.4,33,22,1.4,"PAH",57,1,99,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,100,0)="             Before       After"
^DIC(9.4,33,22,1.4,"PAH",57,1,101,0)="Name         Checksum     Checksum     Patch List"
^DIC(9.4,33,22,1.4,"PAH",57,1,102,0)="---------------------------------------------------------------------"
^DIC(9.4,33,22,1.4,"PAH",57,1,103,0)="HLCSDR1      10571563      8554313     2,22,27,30,34,62"
^DIC(9.4,33,22,1.4,"PAH",57,1,104,0)="HLCSDR2       5218053      4813200     2,9,62"
^DIC(9.4,33,22,1.4,"PAH",57,1,105,0)="HLCSIN        2517664      4825867     2,30,14,19,62"
^DIC(9.4,33,22,1.4,"PAH",57,1,106,0)="HLCSOUT       4118513      4765416     25,30,62     "
^DIC(9.4,33,22,1.4,"PAH",57,1,107,0)="HLCSUTL2      2181860      2309661     18,28,62"
^DIC(9.4,33,22,1.4,"PAH",57,1,108,0)="HLPAT62        *NEW*        236063     62"
^DIC(9.4,33,22,1.4,"PAH",57,1,109,0)="HLUOPT1      13112533     12526225     10,13,21,36,19,47,62"
^DIC(9.4,33,22,1.4,"PAH",57,1,110,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,33,22,1.4,"PAH",57,1,111,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,112,0)="This patch introduces the following new routine:"
^DIC(9.4,33,22,1.4,"PAH",57,1,113,0)="HLPAT62 - post-init for this patch has no user-callable entry points"
^DIC(9.4,33,22,1.4,"PAH",57,1,114,0)="============================================================================"
^DIC(9.4,33,22,1.4,"PAH",57,1,115,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,116,0)="INSTALLATION:"
^DIC(9.4,33,22,1.4,"PAH",57,1,117,0)="NOTE: This patch should be installed during off hours, when activity is at"
^DIC(9.4,33,22,1.4,"PAH",57,1,118,0)="a minimum.  It requires HL7 patches HL*1.6*28, *34, & *47."
^DIC(9.4,33,22,1.4,"PAH",57,1,119,0)="1. Users may be on the system during the installation of this patch."
^DIC(9.4,33,22,1.4,"PAH",57,1,120,0)="2. DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,33,22,1.4,"PAH",57,1,121,0)="   affected routine(s)."
^DIC(9.4,33,22,1.4,"PAH",57,1,122,0)="3. Shutdown all Logical Links and incoming and outgoing filers, and"
^DIC(9.4,33,22,1.4,"PAH",57,1,123,0)="   the Link Manager. Use the options:"
^DIC(9.4,33,22,1.4,"PAH",57,1,124,0)=" "
^DIC(9.4,33,22,1.4,"PAH",57,1,125,0)="     Filer and Link Management Options -> "
^DIC(9.4,33,22,1.4,"PAH",57,1,126,0)="         SA     Stop All Messaging Background Processes"
^DIC(9.4,33,22,1.4,"PAH",57,1,127,0)="         LM     TCP/IP Link Manager Start/Stop"
^DIC(9.4,33,22,1.4,"PAH",57,1,128,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,129,0)="4. DSM sites: Disable all HL7 UCX Services for this installation."
^DIC(9.4,33,22,1.4,"PAH",57,1,130,0)="5. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu to load the"
^DIC(9.4,33,22,1.4,"PAH",57,1,131,0)="   KIDS package into a Transport global on your system.  "
^DIC(9.4,33,22,1.4,"PAH",57,1,132,0)="6. On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,33,22,1.4,"PAH",57,1,133,0)="   Transport Global:"
^DIC(9.4,33,22,1.4,"PAH",57,1,134,0)="         2 Verify Checksums in Transport Global "
^DIC(9.4,33,22,1.4,"PAH",57,1,135,0)="         3 Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",57,1,136,0)="         4 Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",57,1,137,0)="         5 Backup a Transport Global "
^DIC(9.4,33,22,1.4,"PAH",57,1,138,0)="         6 Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",57,1,139,0)=" Select INSTALL NAME: HL*1.6*62     Loaded from Distribution  <date/time>"
^DIC(9.4,33,22,1.4,"PAH",57,1,140,0)="                      ========="
^DIC(9.4,33,22,1.4,"PAH",57,1,141,0)=" Install Questions for HL*1.6*62"
^DIC(9.4,33,22,1.4,"PAH",57,1,142,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,143,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,33,22,1.4,"PAH",57,1,144,0)="                                                                   ==="
^DIC(9.4,33,22,1.4,"PAH",57,1,145,0)=" Want KIDS to INHIBIT LOGONS during the install? YES// NO"
^DIC(9.4,33,22,1.4,"PAH",57,1,146,0)="                                                       =="
^DIC(9.4,33,22,1.4,"PAH",57,1,147,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,33,22,1.4,"PAH",57,1,148,0)="                                                                       =="
^DIC(9.4,33,22,1.4,"PAH",57,1,149,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,33,22,1.4,"PAH",57,1,150,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,33,22,1.4,"PAH",57,1,151,0)=" Enter a '^' to abort the install."
^DIC(9.4,33,22,1.4,"PAH",57,1,152,0)=""
^DIC(9.4,33,22,1.4,"PAH",57,1,153,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,33,22,1.4,"PAH",57,1,154,0)="                ------------------"
^DIC(9.4,33,22,1.4,"PAH",57,1,155,0)="7. Startup all Logical Links and incoming and outgoing filers. Use the "
^DIC(9.4,33,22,1.4,"PAH",57,1,156,0)=" "
^DIC(9.4,33,22,1.4,"PAH",57,1,157,0)="     Filer and Link Management Options ->"
^DIC(9.4,33,22,1.4,"PAH",57,1,158,0)="         RA     Restart/Start All Links and Filers"
^DIC(9.4,33,22,1.4,"PAH",57,1,159,0)="   (Note: Links which do not have ""autostart"" enabled will need to"
^DIC(9.4,33,22,1.4,"PAH",57,1,160,0)="          be restarted manually)"
^DIC(9.4,33,22,1.4,"PAH",57,1,161,0)="   "
^DIC(9.4,33,22,1.4,"PAH",57,1,162,0)="8. DSM Sites: If you previously disabled an HL7 UCX Service for this"
^DIC(9.4,33,22,1.4,"PAH",57,1,163,0)="   installation, you may now enable it."
^DIC(9.4,33,22,1.4,"PAH",57,1,164,0)="9. DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",57,1,165,0)="10. Start Link Manager using the option: ""TCP/IP Link Manager Start/Stop."""
^DIC(9.4,33,22,1.4,"PAH",58,0)="78 SEQ #73^3020204^1"
^DIC(9.4,33,22,1.4,"PAH",58,1,0)="^^98^98^3020204"
^DIC(9.4,33,22,1.4,"PAH",58,1,1,0)="Test sites:    San Francisco VAMC, Bay Pines VAMC, Nashville VAMC"
^DIC(9.4,33,22,1.4,"PAH",58,1,2,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,3,0)="NOIS:          ISH-0701-40476, Incorrect field separator in BTS segment"
^DIC(9.4,33,22,1.4,"PAH",58,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,5,0)="Note:          This patch requires that KIDS build HL*1.6*19"
^DIC(9.4,33,22,1.4,"PAH",58,1,6,0)="               be installed."
^DIC(9.4,33,22,1.4,"PAH",58,1,7,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,8,0)="NOIS call ISH-0701-40476 reported the existence of the Circumflex"
^DIC(9.4,33,22,1.4,"PAH",58,1,9,0)="character (^) hard-coded as the field separator in the BTS segment when"
^DIC(9.4,33,22,1.4,"PAH",58,1,10,0)="creating HL7 batch messages. A mismatch in field separator characters will"
^DIC(9.4,33,22,1.4,"PAH",58,1,11,0)="occur in a message if a VistA application specifies a field separator"
^DIC(9.4,33,22,1.4,"PAH",58,1,12,0)="character other than the Circumflex."
^DIC(9.4,33,22,1.4,"PAH",58,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,14,0)="This patch removes the dependency on hard-coded field separator characters"
^DIC(9.4,33,22,1.4,"PAH",58,1,15,0)="in VistA HL7. This change will accommodate VistA applications that use"
^DIC(9.4,33,22,1.4,"PAH",58,1,16,0)="field separator characters other than the Circumflex, ensuring that batch"
^DIC(9.4,33,22,1.4,"PAH",58,1,17,0)="messages will have the same field separator character in all their"
^DIC(9.4,33,22,1.4,"PAH",58,1,18,0)="segments."
^DIC(9.4,33,22,1.4,"PAH",58,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,20,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,21,0)="Routine Information:"
^DIC(9.4,33,22,1.4,"PAH",58,1,22,0)="====================="
^DIC(9.4,33,22,1.4,"PAH",58,1,23,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,24,0)="The following routine is included in this patch.  The second line of the"
^DIC(9.4,33,22,1.4,"PAH",58,1,25,0)="routine now looks like this:"
^DIC(9.4,33,22,1.4,"PAH",58,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,27,0)=";;1.6;HEALTH LEVEL SEVEN;<PATCHLIST>; Oct 13, 1995."
^DIC(9.4,33,22,1.4,"PAH",58,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,29,0)="The VA Kernel checksums for this routine (calculated using "
^DIC(9.4,33,22,1.4,"PAH",58,1,30,0)="CHECK^XTSUMBLD) are listed below:"
^DIC(9.4,33,22,1.4,"PAH",58,1,31,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,32,0)="                Checksum        Checksum        "
^DIC(9.4,33,22,1.4,"PAH",58,1,33,0)="  Routine Name  Before Patch    After Patch     Patch List"
^DIC(9.4,33,22,1.4,"PAH",58,1,34,0)="  ============  ============    ===========     ====================="
^DIC(9.4,33,22,1.4,"PAH",58,1,35,0)="  HLTF1         9479987         9693677         **5,8,22,25,19,78**"
^DIC(9.4,33,22,1.4,"PAH",58,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,37,0)="Sites should use CHECK^XTSUMBLD to verify checksums after the patch"
^DIC(9.4,33,22,1.4,"PAH",58,1,38,0)="has been installed."
^DIC(9.4,33,22,1.4,"PAH",58,1,39,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,40,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",58,1,41,0)=" =========================="
^DIC(9.4,33,22,1.4,"PAH",58,1,42,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,43,0)="   1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",58,1,44,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,45,0)="   2.  AXP/DSM SITES: Review your mapped routine set.  If any of the"
^DIC(9.4,33,22,1.4,"PAH",58,1,46,0)="       routines listed in the ROUTINE SUMMARY section are mapped, they"
^DIC(9.4,33,22,1.4,"PAH",58,1,47,0)="       should be removed from the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",58,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,49,0)="   3.  Shutdown all Logical Links, incoming and outgoing filers, and"
^DIC(9.4,33,22,1.4,"PAH",58,1,50,0)="       the Link Manager using the Filer and Link Management options"
^DIC(9.4,33,22,1.4,"PAH",58,1,51,0)="       listed below:"
^DIC(9.4,33,22,1.4,"PAH",58,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,53,0)="         Stop All Messaging Background Processes [HL STOP ALL]"
^DIC(9.4,33,22,1.4,"PAH",58,1,54,0)="         TCP Link Manager Start/Stop [HL START/STOP LINK MANAGER]"
^DIC(9.4,33,22,1.4,"PAH",58,1,55,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,56,0)="       AXP/DSM SITES ONLY: Disable all HL7 UCX Services for this"
^DIC(9.4,33,22,1.4,"PAH",58,1,57,0)="       installation."
^DIC(9.4,33,22,1.4,"PAH",58,1,58,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,59,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",58,1,60,0)="       option will load the KIDS package onto your system."
^DIC(9.4,33,22,1.4,"PAH",58,1,61,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,62,0)="  5.  This patch is now loaded into a transport global on your"
^DIC(9.4,33,22,1.4,"PAH",58,1,63,0)="       system. The next step is to use KIDS to install the Transport"
^DIC(9.4,33,22,1.4,"PAH",58,1,64,0)="       global. To do this, use the 'Installation [XPD INSTALLATION "
^DIC(9.4,33,22,1.4,"PAH",58,1,65,0)="       MENU]' menu.  You should use each of the following 'Installation'"
^DIC(9.4,33,22,1.4,"PAH",58,1,66,0)="       menu options in the order shown below:"
^DIC(9.4,33,22,1.4,"PAH",58,1,67,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,68,0)="   2  Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",58,1,69,0)="   3  Print Transport Global"
^DIC(9.4,33,22,1.4,"PAH",58,1,70,0)="   4  Compare Transport Global to Current System"
^DIC(9.4,33,22,1.4,"PAH",58,1,71,0)="   5  Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",58,1,72,0)="   6  Install Package(s)"
^DIC(9.4,33,22,1.4,"PAH",58,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,74,0)="       When using the 'Install Package(s)' menu option to install "
^DIC(9.4,33,22,1.4,"PAH",58,1,75,0)="       the patch build, you will be asked several questions.  The "
^DIC(9.4,33,22,1.4,"PAH",58,1,76,0)="       questions asked, and the answers you should supply, are "
^DIC(9.4,33,22,1.4,"PAH",58,1,77,0)="       shown below."
^DIC(9.4,33,22,1.4,"PAH",58,1,78,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,79,0)="         INSTALL NAME: <HL*1.6*78>"
^DIC(9.4,33,22,1.4,"PAH",58,1,80,0)="         Want KIDS to INHIBIT LOGONS during the install?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",58,1,81,0)="         Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,33,22,1.4,"PAH",58,1,82,0)="         Protocols?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",58,1,83,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,84,0)="   6.  Start up all Logical Links and incoming and outgoing filers using"
^DIC(9.4,33,22,1.4,"PAH",58,1,85,0)="       the Filer and Link Management Option's 'Restart/Start All Links"
^DIC(9.4,33,22,1.4,"PAH",58,1,86,0)="       and Filers [HL TASK RESTART]' menu option."
^DIC(9.4,33,22,1.4,"PAH",58,1,87,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,88,0)="       (Note that links that do not have ""autostart"" enabled will need"
^DIC(9.4,33,22,1.4,"PAH",58,1,89,0)="       to be restarted manually.)"
^DIC(9.4,33,22,1.4,"PAH",58,1,90,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,91,0)="       AXP/DSM SITES ONLY: If you previously disabled an HL7 UCX Service"
^DIC(9.4,33,22,1.4,"PAH",58,1,92,0)="       for this installation, you may enable it now."
^DIC(9.4,33,22,1.4,"PAH",58,1,93,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,94,0)="   7.  AXP/DSM Sites:  After the patch has been installed, rebuild your"
^DIC(9.4,33,22,1.4,"PAH",58,1,95,0)="       map set, if necessary."
^DIC(9.4,33,22,1.4,"PAH",58,1,96,0)=" "
^DIC(9.4,33,22,1.4,"PAH",58,1,97,0)="   8.  Start Link Manager using the 'TCP Link Manager Start/Stop [HL"
^DIC(9.4,33,22,1.4,"PAH",58,1,98,0)="       START/STOP LINK MANAGER]' menu option. "
^DIC(9.4,33,22,1.4,"PAH",59,0)="71 SEQ #74^3020315^1"
^DIC(9.4,33,22,1.4,"PAH",59,1,0)="^^115^115^3020315"
^DIC(9.4,33,22,1.4,"PAH",59,1,1,0)="Test sites: Bay Pines, Grand Junction, Sheridan, Tampa,"
^DIC(9.4,33,22,1.4,"PAH",59,1,2,0)="            Milwaukee, and Iron Mountain"
^DIC(9.4,33,22,1.4,"PAH",59,1,3,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,4,0)="Patch HL*1.6*71 addresses the following NOIS:"
^DIC(9.4,33,22,1.4,"PAH",59,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,6,0)="   1. ISH-1100-40056  mpi/pd: commit ack issue, 'MSH' multiple corruption"
^DIC(9.4,33,22,1.4,"PAH",59,1,7,0)="   2. MAC-0101-61601  corrupted MSH multiple (773) "
^DIC(9.4,33,22,1.4,"PAH",59,1,8,0)="   3. ISA-1101-11782  HL7 MESSAGE TRUNCATED ON REMOTE USER LOGGING"
^DIC(9.4,33,22,1.4,"PAH",59,1,9,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,11,0)="Description:"
^DIC(9.4,33,22,1.4,"PAH",59,1,12,0)="============"
^DIC(9.4,33,22,1.4,"PAH",59,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,14,0)="Patch HL*1.6*71 fixes the corruption of the MSH Header where the MSH segment "
^DIC(9.4,33,22,1.4,"PAH",59,1,15,0)="is received a second time after the body of the HL7 message has been received.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,16,0)="What occurs is the current VistA HL7 TCP/IP code attempts to reset itself when "
^DIC(9.4,33,22,1.4,"PAH",59,1,17,0)="incomplete data is received.  This usually happens when a timeout has expired "
^DIC(9.4,33,22,1.4,"PAH",59,1,18,0)="and the complete MSH segment has not been received. When this happens, VistA "
^DIC(9.4,33,22,1.4,"PAH",59,1,19,0)="HL7 drops original MSH Header. The original body of the message is now left "
^DIC(9.4,33,22,1.4,"PAH",59,1,20,0)="without the header. Next, the sender of the original message resends a repeat "
^DIC(9.4,33,22,1.4,"PAH",59,1,21,0)="of the original MSH Header and the body again. The outcome is shown below:"
^DIC(9.4,33,22,1.4,"PAH",59,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,23,0)="  1) Message body."
^DIC(9.4,33,22,1.4,"PAH",59,1,24,0)="  2) Message (MSH) header."
^DIC(9.4,33,22,1.4,"PAH",59,1,25,0)="  3) Message body. "
^DIC(9.4,33,22,1.4,"PAH",59,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,27,0)="VistA HL7 now read 1) the Message body and 2) the Message Header as the"
^DIC(9.4,33,22,1.4,"PAH",59,1,28,0)="original message header itself. "
^DIC(9.4,33,22,1.4,"PAH",59,1,29,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,30,0)="After the installation of this patch (HL*1.6*71), VistA HL7 listeners will no "
^DIC(9.4,33,22,1.4,"PAH",59,1,31,0)="longer attempt to reset after timeouts have occurred, once a start block has"
^DIC(9.4,33,22,1.4,"PAH",59,1,32,0)="been received."
^DIC(9.4,33,22,1.4,"PAH",59,1,33,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,34,0)="This patch also fixes the problem where VistA HL7 will attempt to process an "
^DIC(9.4,33,22,1.4,"PAH",59,1,35,0)="incomplete message.  These incomplete messages are the result of a timeout "
^DIC(9.4,33,22,1.4,"PAH",59,1,36,0)="occurring before the end-block character (<EB>) is reached while reading"
^DIC(9.4,33,22,1.4,"PAH",59,1,37,0)="inbound data.  Also, network performance issues may contribute to the"
^DIC(9.4,33,22,1.4,"PAH",59,1,38,0)="occurrence of Read timeouts.  Furthermore, large inbound messages (100 lines"
^DIC(9.4,33,22,1.4,"PAH",59,1,39,0)="or more) with relatively short Read timeouts on the receiving side"
^DIC(9.4,33,22,1.4,"PAH",59,1,40,0)="can also increase the likelihood of receiving incomplete messages."
^DIC(9.4,33,22,1.4,"PAH",59,1,41,0)="This patch will discard all incomplete messages as if no data"
^DIC(9.4,33,22,1.4,"PAH",59,1,42,0)="had been received. At which point, the sender of the HL7 message needs "
^DIC(9.4,33,22,1.4,"PAH",59,1,43,0)="to resend the message again to ensure guaranteed delivery."
^DIC(9.4,33,22,1.4,"PAH",59,1,44,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,45,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,46,0)="Routine Information:"
^DIC(9.4,33,22,1.4,"PAH",59,1,47,0)="===================="
^DIC(9.4,33,22,1.4,"PAH",59,1,48,0)="The following routines are included in this patch.  The second line"
^DIC(9.4,33,22,1.4,"PAH",59,1,49,0)="of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",59,1,50,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,51,0)="  ;;1.6;HEALTH LEVEL SEVEN;<patchlist>;JUL 17,1995"
^DIC(9.4,33,22,1.4,"PAH",59,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,53,0)="                   Checksum"
^DIC(9.4,33,22,1.4,"PAH",59,1,54,0)="  Routine         Old         New            2nd Line"
^DIC(9.4,33,22,1.4,"PAH",59,1,55,0)="  ========     ========     ========     =====================     "
^DIC(9.4,33,22,1.4,"PAH",59,1,56,0)="  HLCSTCP1      5081718      5982461     **19,43,57,64,71**"
^DIC(9.4,33,22,1.4,"PAH",59,1,57,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,58,0)="  List of preceding patches: 64"
^DIC(9.4,33,22,1.4,"PAH",59,1,59,0)="  Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,33,22,1.4,"PAH",59,1,60,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,61,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,62,0)="Installation Instructions: "
^DIC(9.4,33,22,1.4,"PAH",59,1,63,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",59,1,64,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,65,0)="  1.  Users are allowed to be on the system during the installation.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,66,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,67,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",59,1,68,0)="      the Routine Summary section are mapped, they should be removed from "
^DIC(9.4,33,22,1.4,"PAH",59,1,69,0)="      the mapped set at this time.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,70,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,71,0)="  3.  Shutdown all Logical Links and incoming and outgoing filers, and"
^DIC(9.4,33,22,1.4,"PAH",59,1,72,0)="      the Link Manager. Use the options:"
^DIC(9.4,33,22,1.4,"PAH",59,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,74,0)="        Filer and Link Management Options -> "
^DIC(9.4,33,22,1.4,"PAH",59,1,75,0)="            SA     Stop All Messaging Background Processes"
^DIC(9.4,33,22,1.4,"PAH",59,1,76,0)="            LM     TCP/IP Link Manager Start/Stop"
^DIC(9.4,33,22,1.4,"PAH",59,1,77,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,78,0)="      For DSM sites ONLY, disabled all HL7 UCX Services "
^DIC(9.4,33,22,1.4,"PAH",59,1,79,0)="      for this installation."
^DIC(9.4,33,22,1.4,"PAH",59,1,80,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,81,0)="  4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,33,22,1.4,"PAH",59,1,82,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,83,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,84,0)="  5.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,33,22,1.4,"PAH",59,1,85,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,86,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,33,22,1.4,"PAH",59,1,87,0)="      options: "
^DIC(9.4,33,22,1.4,"PAH",59,1,88,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,89,0)="         2 Verify Checksums in Transport Global "
^DIC(9.4,33,22,1.4,"PAH",59,1,90,0)="         3 Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",59,1,91,0)="         4 Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",59,1,92,0)="         5 Backup a Transport Global "
^DIC(9.4,33,22,1.4,"PAH",59,1,93,0)="         6 Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",59,1,94,0)="             INSTALL NAME: HL*1.6*71 "
^DIC(9.4,33,22,1.4,"PAH",59,1,95,0)="                           ========="
^DIC(9.4,33,22,1.4,"PAH",59,1,96,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,97,0)="        Answer 'NO' to 'Want KIDS to INHIBIT LOGONS during the install?'.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,98,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,99,0)="        Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,33,22,1.4,"PAH",59,1,100,0)="         and Protocols?'.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,101,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,102,0)="  6.  Startup all Logical Links and incoming and outgoing filers. Use the "
^DIC(9.4,33,22,1.4,"PAH",59,1,103,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,104,0)="        Filer and Link Management Options -> "
^DIC(9.4,33,22,1.4,"PAH",59,1,105,0)="            RA     Restart/Start All Links and Filers "
^DIC(9.4,33,22,1.4,"PAH",59,1,106,0)="        (Note that links that do not have ""autostart"" enabled will need to "
^DIC(9.4,33,22,1.4,"PAH",59,1,107,0)="        be restarted manually) "
^DIC(9.4,33,22,1.4,"PAH",59,1,108,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,109,0)="      For DSM sites ONLY, if you previously disabled an HL7 UCX Service "
^DIC(9.4,33,22,1.4,"PAH",59,1,110,0)="      for this installation, you may now enable it.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,111,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,112,0)="  7.  DSM Sites: Rebuild your mapped set if necessary.  "
^DIC(9.4,33,22,1.4,"PAH",59,1,113,0)=" "
^DIC(9.4,33,22,1.4,"PAH",59,1,114,0)="  8.  Start Link Manager using the option: ""TCP/IP "
^DIC(9.4,33,22,1.4,"PAH",59,1,115,0)="        Link Manager Start/Stop."" "
^DIC(9.4,33,22,1.4,"PAH",60,0)="89 SEQ #75^3020423^1"
^DIC(9.4,33,22,1.4,"PAH",60,1,0)="^^82^82^3020423"
^DIC(9.4,33,22,1.4,"PAH",60,1,1,0)="Test sites:    MPI"
^DIC(9.4,33,22,1.4,"PAH",60,1,2,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,3,0)="NOIS:          ISF-0102-62265"
^DIC(9.4,33,22,1.4,"PAH",60,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,5,0)="Note:          This patch requires that KIDS build HL*1.6*43"
^DIC(9.4,33,22,1.4,"PAH",60,1,6,0)="               be installed."
^DIC(9.4,33,22,1.4,"PAH",60,1,7,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,8,0)="The Master Patient Index (MPI) system sometimes experiences an undefined"
^DIC(9.4,33,22,1.4,"PAH",60,1,9,0)="error at MPIDIRQ+5^MPIDIRQ.  The undefined variable is the local variable"
^DIC(9.4,33,22,1.4,"PAH",60,1,10,0)="TMP(""HCSI"",$J,1).  Inadequate coding in the Health Level Seven (HL7)"
^DIC(9.4,33,22,1.4,"PAH",60,1,11,0)="package's direct connect software is the cause of this problem.  Patch"
^DIC(9.4,33,22,1.4,"PAH",60,1,12,0)="HL*1.6*89 fixes this undefined error condition."
^DIC(9.4,33,22,1.4,"PAH",60,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,14,0)="The routine HLCSAS is included in this patch.  The first and second"
^DIC(9.4,33,22,1.4,"PAH",60,1,15,0)="lines of this routine are shown below."
^DIC(9.4,33,22,1.4,"PAH",60,1,16,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,17,0)="   HLCSAS  ;ISCSF/RWF - MPI direct connect server ;02/19/99  11:44"
^DIC(9.4,33,22,1.4,"PAH",60,1,18,0)="           ;;1.6;HEALTH LEVEL SEVEN;**43,89**;Jul 17,1995"
^DIC(9.4,33,22,1.4,"PAH",60,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,20,0)="The VA Kernel checksum for the routine included in this patch"
^DIC(9.4,33,22,1.4,"PAH",60,1,21,0)="(calculated using CHECK^XTSUMBLD) is listed below."
^DIC(9.4,33,22,1.4,"PAH",60,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,23,0)="                Checksum        Checksum"
^DIC(9.4,33,22,1.4,"PAH",60,1,24,0)="  Routine Name  Before Patch    After Patch     Patch List"
^DIC(9.4,33,22,1.4,"PAH",60,1,25,0)="  ============  ============    ===========     ====================="
^DIC(9.4,33,22,1.4,"PAH",60,1,26,0)="  HLCSAS        2943880         3066068         43,89"
^DIC(9.4,33,22,1.4,"PAH",60,1,27,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,28,0)="Sites should use CHECK^XTSUMBLD to verify checksums after patch"
^DIC(9.4,33,22,1.4,"PAH",60,1,29,0)="installation."
^DIC(9.4,33,22,1.4,"PAH",60,1,30,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,31,0)=" Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",60,1,32,0)=" =========================="
^DIC(9.4,33,22,1.4,"PAH",60,1,33,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,34,0)="   NOTICE:  Do not proceed unless patch HL*1.6*43 has been installed."
^DIC(9.4,33,22,1.4,"PAH",60,1,35,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,36,0)="   1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",60,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,38,0)="   2.  AXP/DSM SITES: Review your mapped routine set.  If the"
^DIC(9.4,33,22,1.4,"PAH",60,1,39,0)="       routine listed in the ROUTINE SUMMARY section is mapped, it"
^DIC(9.4,33,22,1.4,"PAH",60,1,40,0)="       should be removed from the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",60,1,41,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,42,0)="   3.  Shutdown all Logical Links, incoming and outgoing filers, and"
^DIC(9.4,33,22,1.4,"PAH",60,1,43,0)="       the Link Manager using the Filer and Link Management options"
^DIC(9.4,33,22,1.4,"PAH",60,1,44,0)="       listed below."
^DIC(9.4,33,22,1.4,"PAH",60,1,45,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,46,0)="          Stop All Messaging Background Processes [HL STOP ALL]"
^DIC(9.4,33,22,1.4,"PAH",60,1,47,0)="          TCP/IP Link Manager Start/Stop [HL START/STOP LINK MANAGER]"
^DIC(9.4,33,22,1.4,"PAH",60,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,49,0)="      AXP/DSM SITES ONLY: Disable all HL7 UCX Services for this"
^DIC(9.4,33,22,1.4,"PAH",60,1,50,0)="      installation."
^DIC(9.4,33,22,1.4,"PAH",60,1,51,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,52,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",60,1,53,0)="       option will load the KIDS package onto your system."
^DIC(9.4,33,22,1.4,"PAH",60,1,54,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,55,0)="   5.  This patch is now loaded into a transport global on your"
^DIC(9.4,33,22,1.4,"PAH",60,1,56,0)="       system. The next step is to use KIDS to install the Transport"
^DIC(9.4,33,22,1.4,"PAH",60,1,57,0)="       global. This is done using the 'Installation' menu's 'Install"
^DIC(9.4,33,22,1.4,"PAH",60,1,58,0)="       Package(s) [XPD INSTALL BUILD]' menu option. When using this"
^DIC(9.4,33,22,1.4,"PAH",60,1,59,0)="       menu option to install the patch build, you will be asked"
^DIC(9.4,33,22,1.4,"PAH",60,1,60,0)="       several questions.  The questions, and the answers you should"
^DIC(9.4,33,22,1.4,"PAH",60,1,61,0)="       supply, are shown below."
^DIC(9.4,33,22,1.4,"PAH",60,1,62,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,63,0)="       INSTALL NAME: <HL*1.6*89>"
^DIC(9.4,33,22,1.4,"PAH",60,1,64,0)="       Want KIDS to INHIBIT LOGONS during the install?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",60,1,65,0)="       Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",60,1,66,0)="         and Protocols?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",60,1,67,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,68,0)="   6.  Start up all Logical Links and incoming and outgoing filers using"
^DIC(9.4,33,22,1.4,"PAH",60,1,69,0)="       the Filer and Link Management Option's 'Restart/Start All Links"
^DIC(9.4,33,22,1.4,"PAH",60,1,70,0)="       and Filers [HL TASK RESTART]' menu option."
^DIC(9.4,33,22,1.4,"PAH",60,1,71,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,72,0)="       (Note that links that do not have ""autostart"" enabled will need"
^DIC(9.4,33,22,1.4,"PAH",60,1,73,0)="       to be restarted manually.)"
^DIC(9.4,33,22,1.4,"PAH",60,1,74,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,75,0)="      AXP/DSM SITES ONLY: If you previously disabled an HL7 UCX Service"
^DIC(9.4,33,22,1.4,"PAH",60,1,76,0)="      for this installation, you may enable it now."
^DIC(9.4,33,22,1.4,"PAH",60,1,77,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,78,0)="   7.  AXP/DSM Sites:  After the patch has been installed, rebuild your"
^DIC(9.4,33,22,1.4,"PAH",60,1,79,0)="       map set, if necessary."
^DIC(9.4,33,22,1.4,"PAH",60,1,80,0)=" "
^DIC(9.4,33,22,1.4,"PAH",60,1,81,0)="   8.  Start Link Manager using the 'TCP/IP Link Manager Start/Stop [HL"
^DIC(9.4,33,22,1.4,"PAH",60,1,82,0)="       START/STOP LINK MANAGER]' menu option."
^DIC(9.4,33,22,1.4,"PAH",61,0)="92 SEQ #76^3020506^1"
^DIC(9.4,33,22,1.4,"PAH",61,1,0)="^^136^136^3020506"
^DIC(9.4,33,22,1.4,"PAH",61,1,1,0)="The purpose of this patch is to export the VAFHIE entry in the"
^DIC(9.4,33,22,1.4,"PAH",61,1,2,0)="HL LOGICAL LINK (#870) file.  The VAFHIE node is distributed"
^DIC(9.4,33,22,1.4,"PAH",61,1,3,0)="with data in the following fields:"
^DIC(9.4,33,22,1.4,"PAH",61,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,5,0)="    NODE: VAFHIE"
^DIC(9.4,33,22,1.4,"PAH",61,1,6,0)="    INSTITUTION: AUSTIN"
^DIC(9.4,33,22,1.4,"PAH",61,1,7,0)="    LLP TYPE: TCP"
^DIC(9.4,33,22,1.4,"PAH",61,1,8,0)="    DOMAIN: FHIE.DOMAIN.EXT"
^DIC(9.4,33,22,1.4,"PAH",61,1,9,0)="    EXCEED RE-TRANSMIT ACTION: restart"
^DIC(9.4,33,22,1.4,"PAH",61,1,10,0)="    ACK TIMEOUT: 240"
^DIC(9.4,33,22,1.4,"PAH",61,1,11,0)="    TCP/IP ADDRESS: 127.0.0.1           "
^DIC(9.4,33,22,1.4,"PAH",61,1,12,0)="    TCP/IP PORT: 5000"
^DIC(9.4,33,22,1.4,"PAH",61,1,13,0)="    TCP/IP SERVICE TYPE: CLIENT (SENDER)"
^DIC(9.4,33,22,1.4,"PAH",61,1,14,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,15,0)="The Federal Heath Information Exchange (FHIE) will"
^DIC(9.4,33,22,1.4,"PAH",61,1,16,0)="require this enhancement for viewing data from facilities outside"
^DIC(9.4,33,22,1.4,"PAH",61,1,17,0)="the Veteran's Health Administration (VHA).  Patch HL*1.6*92 is"
^DIC(9.4,33,22,1.4,"PAH",61,1,18,0)="distributed as an EMERGENCY patch because it needs to be in place"
^DIC(9.4,33,22,1.4,"PAH",61,1,19,0)="at all facilities to enable FHIE to begin data transmissions by April 25,"
^DIC(9.4,33,22,1.4,"PAH",61,1,20,0)="2002."
^DIC(9.4,33,22,1.4,"PAH",61,1,21,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,22,0)="Instructions in patch XM*999*148 must be followed prior to"
^DIC(9.4,33,22,1.4,"PAH",61,1,23,0)="installing patch HL*1.6*92.  XM*999*148 is an informational patch"
^DIC(9.4,33,22,1.4,"PAH",61,1,24,0)="with directions for creating the FHIE.DOMAIN.EXT domain."
^DIC(9.4,33,22,1.4,"PAH",61,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,26,0)="Test Sites:"
^DIC(9.4,33,22,1.4,"PAH",61,1,27,0)="==========="
^DIC(9.4,33,22,1.4,"PAH",61,1,28,0)="El Paso VAMC"
^DIC(9.4,33,22,1.4,"PAH",61,1,29,0)="San Francisco VAMC"
^DIC(9.4,33,22,1.4,"PAH",61,1,30,0)="Puget Sound HCS"
^DIC(9.4,33,22,1.4,"PAH",61,1,31,0)="Washington VAMC"
^DIC(9.4,33,22,1.4,"PAH",61,1,32,0)="  "
^DIC(9.4,33,22,1.4,"PAH",61,1,33,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",61,1,34,0)="================"
^DIC(9.4,33,22,1.4,"PAH",61,1,35,0)="The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",61,1,36,0)="second line of each of these routine(s) will look like:"
^DIC(9.4,33,22,1.4,"PAH",61,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,38,0)=";;1.6;HEALTH LEVEL SEVEN;**[Patch List]**;JUL 17, 1995"
^DIC(9.4,33,22,1.4,"PAH",61,1,39,0)="CHECK^XTSUMBLD results:"
^DIC(9.4,33,22,1.4,"PAH",61,1,40,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,41,0)="Routine       Before Patch       After Patch      "
^DIC(9.4,33,22,1.4,"PAH",61,1,42,0)="--------      ------------       ------------     "
^DIC(9.4,33,22,1.4,"PAH",61,1,43,0)="HLP92             N/A              7643045         "
^DIC(9.4,33,22,1.4,"PAH",61,1,44,0)="HLP92ENV          N/A              1183086        "
^DIC(9.4,33,22,1.4,"PAH",61,1,45,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,46,0)="Environment Check Routine HLP92ENV:"
^DIC(9.4,33,22,1.4,"PAH",61,1,47,0)="==================================="
^DIC(9.4,33,22,1.4,"PAH",61,1,48,0)="The environment check routine, HLP92ENV, checks to see if patch"
^DIC(9.4,33,22,1.4,"PAH",61,1,49,0)="XM*999*148 is in place.  It does this by checking for the existence"
^DIC(9.4,33,22,1.4,"PAH",61,1,50,0)="of the FHIE.DOMAIN.EXT entry in the DOMAIN (#4.2) file.  If the"
^DIC(9.4,33,22,1.4,"PAH",61,1,51,0)="entry is not found, the routine aborts with the following message:"
^DIC(9.4,33,22,1.4,"PAH",61,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,53,0)="    ""No DOMAIN (#4.2) file entry was found for FHIE.DOMAIN.EXT."
^DIC(9.4,33,22,1.4,"PAH",61,1,54,0)="    Follow the instructions in VA MailMan patch XM*999*148 to create"
^DIC(9.4,33,22,1.4,"PAH",61,1,55,0)="    this new entry in the DOMAIN (#4.2) file.  After the new DOMAIN"
^DIC(9.4,33,22,1.4,"PAH",61,1,56,0)="    has been created, re-install patch HL*1.6*92."""
^DIC(9.4,33,22,1.4,"PAH",61,1,57,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,58,0)="Pre-Install Routine PRE^HLP92:"
^DIC(9.4,33,22,1.4,"PAH",61,1,59,0)="=============================="
^DIC(9.4,33,22,1.4,"PAH",61,1,60,0)="The pre-install routine, PRE^HLP92, looks for the AUSTIN (Station Number"
^DIC(9.4,33,22,1.4,"PAH",61,1,61,0)="200) entry in the INSTITUTION (#4) file.  If the entry is present, the"
^DIC(9.4,33,22,1.4,"PAH",61,1,62,0)="pre-install is done.  If the entry does not exist, it is created.  This"
^DIC(9.4,33,22,1.4,"PAH",61,1,63,0)="entry is pointed to from the HL LOGICAL LINK (#870) file by the VAFHIE"
^DIC(9.4,33,22,1.4,"PAH",61,1,64,0)="entry distributed in this patch."
^DIC(9.4,33,22,1.4,"PAH",61,1,65,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,66,0)="Post-Install Routine PST^HLP92:"
^DIC(9.4,33,22,1.4,"PAH",61,1,67,0)="==============================="
^DIC(9.4,33,22,1.4,"PAH",61,1,68,0)="The post-install routine, PST^HLP92, sets the AUTOSTART (#4.5) field"
^DIC(9.4,33,22,1.4,"PAH",61,1,69,0)="to Enabled for the VAFHIE entry in the HL LOGICAL LINK (#870) file."
^DIC(9.4,33,22,1.4,"PAH",61,1,70,0)="Then, it examines the system to determine if it is the production or"
^DIC(9.4,33,22,1.4,"PAH",61,1,71,0)="test account.  If it is the production account, the post-install is"
^DIC(9.4,33,22,1.4,"PAH",61,1,72,0)="finished.  If it is a test account, the TCP/IP ADDRESS (#400.01) and"
^DIC(9.4,33,22,1.4,"PAH",61,1,73,0)="DOMAIN (#.03) fields for the VAFHIE entry in the HL LOGICAL LINK (#870)"
^DIC(9.4,33,22,1.4,"PAH",61,1,74,0)="file are removed to ensure that messaging does not occur from a test"
^DIC(9.4,33,22,1.4,"PAH",61,1,75,0)="account."
^DIC(9.4,33,22,1.4,"PAH",61,1,76,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,77,0)="When Installing in Test Account:"
^DIC(9.4,33,22,1.4,"PAH",61,1,78,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",61,1,79,0)="Before installing this patch in your test account, confirm that the"
^DIC(9.4,33,22,1.4,"PAH",61,1,80,0)="DEFAULT PROCESSING ID (#.03) field in the HL COMMUNICATION SERVER"
^DIC(9.4,33,22,1.4,"PAH",61,1,81,0)="PARAMETERS (#869.3) file is set up properly according to the instructions"
^DIC(9.4,33,22,1.4,"PAH",61,1,82,0)="for the creation of a mirror account.  In programmer mode, enter the"
^DIC(9.4,33,22,1.4,"PAH",61,1,83,0)="following command."
^DIC(9.4,33,22,1.4,"PAH",61,1,84,0)="  "
^DIC(9.4,33,22,1.4,"PAH",61,1,85,0)=">W $$PARAM^HLCS2"
^DIC(9.4,33,22,1.4,"PAH",61,1,86,0)="45^FO-SLC.DOMAIN.EXT^T^51^ISC SALT LAKE CITY^^3^HL7^25^30^85^30"
^DIC(9.4,33,22,1.4,"PAH",61,1,87,0)="  "
^DIC(9.4,33,22,1.4,"PAH",61,1,88,0)="If the third piece of the returned data is NOT ""T"", then the steps for"
^DIC(9.4,33,22,1.4,"PAH",61,1,89,0)="mirroring a test account should be reviewed and updated."
^DIC(9.4,33,22,1.4,"PAH",61,1,90,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,91,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",61,1,92,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",61,1,93,0)="This patch may be loaded with users on the system.  You may wish"
^DIC(9.4,33,22,1.4,"PAH",61,1,94,0)="to install it during non-peak hours.  Installation will take less"
^DIC(9.4,33,22,1.4,"PAH",61,1,95,0)="than 3 minutes."
^DIC(9.4,33,22,1.4,"PAH",61,1,96,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,97,0)="1.  Use the INSTALL/CHECK MESSAGE option on the Packman menu.  [Note: "
^DIC(9.4,33,22,1.4,"PAH",61,1,98,0)="    TEXT PRINT/DISPLAY option in the PackMan menu will display the "
^DIC(9.4,33,22,1.4,"PAH",61,1,99,0)="    patch text only.]"
^DIC(9.4,33,22,1.4,"PAH",61,1,100,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,101,0)="2.  The routines for this patch are new and can be deleted after"
^DIC(9.4,33,22,1.4,"PAH",61,1,102,0)="    installation; therefore routine mapping is not an issue for"
^DIC(9.4,33,22,1.4,"PAH",61,1,103,0)="    this patch."
^DIC(9.4,33,22,1.4,"PAH",61,1,104,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,105,0)="3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,33,22,1.4,"PAH",61,1,106,0)="    the Installation menu."
^DIC(9.4,33,22,1.4,"PAH",61,1,107,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,108,0)="4.  From this menu, you may elect to use the following options (when"
^DIC(9.4,33,22,1.4,"PAH",61,1,109,0)="    prompted for the INSTALL NAME, enter HL*1.6*92)."
^DIC(9.4,33,22,1.4,"PAH",61,1,110,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,111,0)="    (a)  Backup a Transport Global - this option will create a backup"
^DIC(9.4,33,22,1.4,"PAH",61,1,112,0)="         message of any routines exported with the patch.  It will NOT"
^DIC(9.4,33,22,1.4,"PAH",61,1,113,0)="         backup any other changes such as DDs or templates."
^DIC(9.4,33,22,1.4,"PAH",61,1,114,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,115,0)="    (b)  Compare Transport Global to Current System - this option will"
^DIC(9.4,33,22,1.4,"PAH",61,1,116,0)="         allow you to view all changes that will be made when the"
^DIC(9.4,33,22,1.4,"PAH",61,1,117,0)="         patch is installed.  It compares all components of the patch"
^DIC(9.4,33,22,1.4,"PAH",61,1,118,0)="         (routines, DDs, templates, etc.)."
^DIC(9.4,33,22,1.4,"PAH",61,1,119,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,120,0)="    (c)  Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,33,22,1.4,"PAH",61,1,121,0)="         you to ensure the integrity of the routines that are in the"
^DIC(9.4,33,22,1.4,"PAH",61,1,122,0)="         transport global."
^DIC(9.4,33,22,1.4,"PAH",61,1,123,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,124,0)="    (d)  Print Transport Global - this option will allow you to view the"
^DIC(9.4,33,22,1.4,"PAH",61,1,125,0)="         components of the KIDS build."
^DIC(9.4,33,22,1.4,"PAH",61,1,126,0)=" "
^DIC(9.4,33,22,1.4,"PAH",61,1,127,0)="5.  Use the Install Package(s) option and select the package HL*1.6*92."
^DIC(9.4,33,22,1.4,"PAH",61,1,128,0)="   "
^DIC(9.4,33,22,1.4,"PAH",61,1,129,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//',"
^DIC(9.4,33,22,1.4,"PAH",61,1,130,0)="    respond NO."
^DIC(9.4,33,22,1.4,"PAH",61,1,131,0)="  "
^DIC(9.4,33,22,1.4,"PAH",61,1,132,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,33,22,1.4,"PAH",61,1,133,0)="    Protocols? YES//', respond NO."
^DIC(9.4,33,22,1.4,"PAH",61,1,134,0)="  "
^DIC(9.4,33,22,1.4,"PAH",61,1,135,0)="8.  Routines HLP92ENV and HLP92 can be deleted from your system after"
^DIC(9.4,33,22,1.4,"PAH",61,1,136,0)="     successful installation of this patch."
^DIC(9.4,33,22,1.4,"PAH",62,0)="91 SEQ #77^3020528^1"
^DIC(9.4,33,22,1.4,"PAH",62,1,0)="^^219^219^3020528"
^DIC(9.4,33,22,1.4,"PAH",62,1,1,0)="Test sites:    Greater Los Angeles Regional Healthcare (West Los Angeles),"
^DIC(9.4,33,22,1.4,"PAH",62,1,2,0)="               Grand Junction, Sheridan"
^DIC(9.4,33,22,1.4,"PAH",62,1,3,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,4,0)="NOIS:          None"
^DIC(9.4,33,22,1.4,"PAH",62,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,6,0)="Note:          This patch requires that KIDS builds HL*1.6*47, HL*1.6*57,"
^DIC(9.4,33,22,1.4,"PAH",62,1,7,0)="               HL*1.6*59, and HL*1.6*82 be installed."
^DIC(9.4,33,22,1.4,"PAH",62,1,8,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,9,0)="OVERVIEW"
^DIC(9.4,33,22,1.4,"PAH",62,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,11,0)="The Health Level 7 (HL7) messages sent and received by sites are being"
^DIC(9.4,33,22,1.4,"PAH",62,1,12,0)="increasingly studied for workflow patterns and totals.  This evaluation of"
^DIC(9.4,33,22,1.4,"PAH",62,1,13,0)="HL7 data by clients of the HL7 package has resulted in the request for HL7"
^DIC(9.4,33,22,1.4,"PAH",62,1,14,0)="totals subdivided by the namespace of the message's originating package."
^DIC(9.4,33,22,1.4,"PAH",62,1,15,0)="Unfortunately, the namespace of a message is not always determinable."
^DIC(9.4,33,22,1.4,"PAH",62,1,16,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,17,0)="This patch provides a method for HL7 clients to pass their namespace into"
^DIC(9.4,33,22,1.4,"PAH",62,1,18,0)="the HL7 APIs that create messages or acknowledgements. When this is done,"
^DIC(9.4,33,22,1.4,"PAH",62,1,19,0)="the provided namespace will be stored with the message, enabling"
^DIC(9.4,33,22,1.4,"PAH",62,1,20,0)="subsequent totaling by namespace.  Additional details of this patch are"
^DIC(9.4,33,22,1.4,"PAH",62,1,21,0)="provided next."
^DIC(9.4,33,22,1.4,"PAH",62,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,23,0)="DETAILS"
^DIC(9.4,33,22,1.4,"PAH",62,1,24,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,25,0)="There are three supported HL7 APIs by which HL7 messages are created:"
^DIC(9.4,33,22,1.4,"PAH",62,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,27,0)=" - GENERATE^HLMA(HLEID,HLARYTYP,HLFORMAT,.HLRESLT,HLMTIEN,.HLP)"
^DIC(9.4,33,22,1.4,"PAH",62,1,28,0)=" - GENACK^HLMA1(HLEID,HLMTIENS,HLEIDS,HLARYTYP,HLFORMAT,"
^DIC(9.4,33,22,1.4,"PAH",62,1,29,0)="               .HLRESLTA,HLMTIENA,.HLP)"
^DIC(9.4,33,22,1.4,"PAH",62,1,30,0)=" - DIRECT^HLMA(HLEID,HLARYTYP,HLFORMAT,.HLRESLT,HLMTIEN,.HLP)"
^DIC(9.4,33,22,1.4,"PAH",62,1,31,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,32,0)="In all three APIs, the last parameter HLP is passed by reference.  Prior"
^DIC(9.4,33,22,1.4,"PAH",62,1,33,0)="to calling these APIs, the client package may set HLP array elements and"
^DIC(9.4,33,22,1.4,"PAH",62,1,34,0)="then pass these by reference into the API.  An example call using the HLP"
^DIC(9.4,33,22,1.4,"PAH",62,1,35,0)="array is shown below."
^DIC(9.4,33,22,1.4,"PAH",62,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,37,0)="  <tab>S HLP(""SECURITY"")=1214315"
^DIC(9.4,33,22,1.4,"PAH",62,1,38,0)="  <tab>D GENERATE^HLMA(HLEID,HLARYTYP,HLFORMAT,.HLRESLT,HLMTIEN,.HLP)"
^DIC(9.4,33,22,1.4,"PAH",62,1,39,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,40,0)="These APIs, including the HLP pass-by-reference array, are documented in"
^DIC(9.4,33,22,1.4,"PAH",62,1,41,0)="section 12.1.2, 12.1.3, and 12.1.4 of the VistA HL7 Site Manager &"
^DIC(9.4,33,22,1.4,"PAH",62,1,42,0)="Developer Manual."
^DIC(9.4,33,22,1.4,"PAH",62,1,43,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,44,0)="After patch HL*1.6*91 is installed, an additional HLP array element may"
^DIC(9.4,33,22,1.4,"PAH",62,1,45,0)="be defined before calling these APIs by which the namespace of the client"
^DIC(9.4,33,22,1.4,"PAH",62,1,46,0)="process can be made known to the API code.  This additional HLP array"
^DIC(9.4,33,22,1.4,"PAH",62,1,47,0)="element is HLP(""NAMESPACE"").  An example call using this new array"
^DIC(9.4,33,22,1.4,"PAH",62,1,48,0)="element is shown below."
^DIC(9.4,33,22,1.4,"PAH",62,1,49,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,50,0)="  <tab>S HLP(""NAMESPACE"")=""DG"""
^DIC(9.4,33,22,1.4,"PAH",62,1,51,0)="  <tab>S HLP(""SECURITY"")=1214315"
^DIC(9.4,33,22,1.4,"PAH",62,1,52,0)="  <tab>D GENERATE^HLMA(HLEID,HLARYTYP,HLFORMAT,.HLRESLT,HLMTIEN,.HLP)"
^DIC(9.4,33,22,1.4,"PAH",62,1,53,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,54,0)="(The array contained in these three APIs is HLP, and this patch"
^DIC(9.4,33,22,1.4,"PAH",62,1,55,0)="documentation consistently refers to HLP.  However, since this is a"
^DIC(9.4,33,22,1.4,"PAH",62,1,56,0)="pass-by-reference array, any array name may be selected by the client"
^DIC(9.4,33,22,1.4,"PAH",62,1,57,0)="process calling these APIs.)"
^DIC(9.4,33,22,1.4,"PAH",62,1,58,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,59,0)="Patch HL*1.6*91 creates a new field in the HL7 Message Text file (#772)"
^DIC(9.4,33,22,1.4,"PAH",62,1,60,0)="to store the client process namespace when it is passed as described"
^DIC(9.4,33,22,1.4,"PAH",62,1,61,0)="above.  This new field's definition is shown below."
^DIC(9.4,33,22,1.4,"PAH",62,1,62,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,63,0)="'NAMESPACE' FIELD STANDARD DATA DICTIONARY LISTING"
^DIC(9.4,33,22,1.4,"PAH",62,1,64,0)="--------------------------------------------------"
^DIC(9.4,33,22,1.4,"PAH",62,1,65,0)="772,16        NAMESPACE              0;13 FREE TEXT"
^DIC(9.4,33,22,1.4,"PAH",62,1,66,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,67,0)="       INPUT TRANSFORM:  K:$L(X)>4!($L(X)<1)!'(X?1U1.3NU) X"
^DIC(9.4,33,22,1.4,"PAH",62,1,68,0)="       LAST EDITED:      FEB 15, 2002"
^DIC(9.4,33,22,1.4,"PAH",62,1,69,0)="       HELP-PROMPT:      Answer must be 1-4 characters in length,"
^DIC(9.4,33,22,1.4,"PAH",62,1,70,0)="                         and start with 1 uppercase letter,"
^DIC(9.4,33,22,1.4,"PAH",62,1,71,0)="                         followed by up to 3 uppercase letters and"
^DIC(9.4,33,22,1.4,"PAH",62,1,72,0)="                         numerics."
^DIC(9.4,33,22,1.4,"PAH",62,1,73,0)="       DESCRIPTION:      This field must not be filled in"
^DIC(9.4,33,22,1.4,"PAH",62,1,74,0)="                         manually.  It will be filled in"
^DIC(9.4,33,22,1.4,"PAH",62,1,75,0)="                         automatically by the HL7 processes that"
^DIC(9.4,33,22,1.4,"PAH",62,1,76,0)="                         create entries in the HL7 Message Text"
^DIC(9.4,33,22,1.4,"PAH",62,1,77,0)="                         file (#772).  In most instances,"
^DIC(9.4,33,22,1.4,"PAH",62,1,78,0)="                         applications will call GENERATE^HLMA,"
^DIC(9.4,33,22,1.4,"PAH",62,1,79,0)="                         GENACK^HLMA, or DIRECT^HLMA.  When they"
^DIC(9.4,33,22,1.4,"PAH",62,1,80,0)="                         do, they will pass by reference into the"
^DIC(9.4,33,22,1.4,"PAH",62,1,81,0)="                         last OPTIONS (in the documentation)"
^DIC(9.4,33,22,1.4,"PAH",62,1,82,0)="                         parameter the value of the namespace."
^DIC(9.4,33,22,1.4,"PAH",62,1,83,0)="                         The value of the namespace will be in the"
^DIC(9.4,33,22,1.4,"PAH",62,1,84,0)="                         form of OPTIONS(""NAMESPACE"")=NAMESPACE."
^DIC(9.4,33,22,1.4,"PAH",62,1,85,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,86,0)="                         Please note that the calls to the three"
^DIC(9.4,33,22,1.4,"PAH",62,1,87,0)="                         APIs mentioned above use the variable HLP"
^DIC(9.4,33,22,1.4,"PAH",62,1,88,0)="                         to hold the passed in by reference array."
^DIC(9.4,33,22,1.4,"PAH",62,1,89,0)="                         So, in the HLMA code (and other code"
^DIC(9.4,33,22,1.4,"PAH",62,1,90,0)="                         invoked by HLMA), the actual variable"
^DIC(9.4,33,22,1.4,"PAH",62,1,91,0)="                         used is HLP(""NAMESPACE"")."
^DIC(9.4,33,22,1.4,"PAH",62,1,92,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,93,0)="                         This field is populated by UPDATE^HLTF0."
^DIC(9.4,33,22,1.4,"PAH",62,1,94,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,95,0)="When the client process defines HLP(""NAMESPACE"") prior to the API call,"
^DIC(9.4,33,22,1.4,"PAH",62,1,96,0)="and passes in the HLP array (as shown in the above example), the defined"
^DIC(9.4,33,22,1.4,"PAH",62,1,97,0)="namespace is stored in the HL7 Message Text file (#772) entry created."
^DIC(9.4,33,22,1.4,"PAH",62,1,98,0)="The code that actually stores HLP(""NAMESPACE"") in this file is contained"
^DIC(9.4,33,22,1.4,"PAH",62,1,99,0)="in UPDATE^HLTF0."
^DIC(9.4,33,22,1.4,"PAH",62,1,100,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,101,0)="All HLP array elements are optional; they are not required when these"
^DIC(9.4,33,22,1.4,"PAH",62,1,102,0)="APIs are called.  However, it is strongly recommended that the"
^DIC(9.4,33,22,1.4,"PAH",62,1,103,0)="HLP(""NAMESPACE"") array element be defined whenever it is possible to"
^DIC(9.4,33,22,1.4,"PAH",62,1,104,0)="determine the proper namespace."
^DIC(9.4,33,22,1.4,"PAH",62,1,105,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,106,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,107,0)="Note: HL7 messaging by the Master Patient Index (MPI) application occurs"
^DIC(9.4,33,22,1.4,"PAH",62,1,108,0)="      using the EN^HLCSAC API.  The private use of this API by the MPI"
^DIC(9.4,33,22,1.4,"PAH",62,1,109,0)="      application is covered by Integration Agreement 3471.  It is"
^DIC(9.4,33,22,1.4,"PAH",62,1,110,0)="      important that MPI HL7 messages be assigned the correct namespace,"
^DIC(9.4,33,22,1.4,"PAH",62,1,111,0)="      and this is done automatically now.  There is no need for the"
^DIC(9.4,33,22,1.4,"PAH",62,1,112,0)="      MPI application to pass their namespace into the EN^HLCSAC API."
^DIC(9.4,33,22,1.4,"PAH",62,1,113,0)="      In the future, if this API is opened up to other applications,"
^DIC(9.4,33,22,1.4,"PAH",62,1,114,0)="      there is a way to override the MPI namespace saved.  If the"
^DIC(9.4,33,22,1.4,"PAH",62,1,115,0)="      local variable HLP(""NAMESPACE"") is defined before calling the"
^DIC(9.4,33,22,1.4,"PAH",62,1,116,0)="      EN^HLCSAC API, the value of HLP(""NAMESPACE"") will be saved in"
^DIC(9.4,33,22,1.4,"PAH",62,1,117,0)="      the message as the namespace."
^DIC(9.4,33,22,1.4,"PAH",62,1,118,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,119,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,120,0)="The first and second lines of the routines included in this patch are"
^DIC(9.4,33,22,1.4,"PAH",62,1,121,0)="shown below."
^DIC(9.4,33,22,1.4,"PAH",62,1,122,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,123,0)="HLCSAS1 ;ISCSF/RWF - Read data ;08/24/99  08:06"
^DIC(9.4,33,22,1.4,"PAH",62,1,124,0)="        ;;1.6;HEALTH LEVEL SEVEN;**43,57,91**;Jul 17,1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,125,0)="HLMA    ;AISC/SAW-Message Administration Module ;09/20/2001  12:34"
^DIC(9.4,33,22,1.4,"PAH",62,1,126,0)="        ;;1.6;HEALTH LEVEL SEVEN;**19,43,58,63,66,82,91**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,127,0)="HLMA1   ;AISC/SAW-Message Administration Module (Cont'd) ;04/06/99"
^DIC(9.4,33,22,1.4,"PAH",62,1,128,0)="          10:56"
^DIC(9.4,33,22,1.4,"PAH",62,1,129,0)="        ;;1.6;HEALTH LEVEL SEVEN;**19,43,91**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,130,0)="HLMA2   ;AISC/SAW-Message Administration Module ;09/20/2001  12:35"
^DIC(9.4,33,22,1.4,"PAH",62,1,131,0)="        ;;1.6;HEALTH LEVEL SEVEN;**19,43,57,58,64,65,76,82,91**;"
^DIC(9.4,33,22,1.4,"PAH",62,1,132,0)="          Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,133,0)="HLTF0   ;AISC/SAW,JRP - File Data in Message Text File ;"
^DIC(9.4,33,22,1.4,"PAH",62,1,134,0)="          05/05/2000 09:01"
^DIC(9.4,33,22,1.4,"PAH",62,1,135,0)="        ;;1.6;HEALTH LEVEL SEVEN;**12,19,64,91**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,136,0)="HLTP1   ;AISC/SAW-Transaction Processor Module (Cont'd) ;04/21/98  09:38"
^DIC(9.4,33,22,1.4,"PAH",62,1,137,0)="        ;;1.6;HEALTH LEVEL SEVEN;**34,47,91**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,138,0)="HLTP4   ;SFIRMFO/RSD - Transaction Processor for TCP ;03/07/2000  17:41"
^DIC(9.4,33,22,1.4,"PAH",62,1,139,0)="        ;;1.6;HEALTH LEVEL SEVEN;**19,57,59,91**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",62,1,140,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,141,0)="The VA Kernel checksum for the routine included in this patch"
^DIC(9.4,33,22,1.4,"PAH",62,1,142,0)="(calculated using CHECK^XTSUMBLD) is listed below."
^DIC(9.4,33,22,1.4,"PAH",62,1,143,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,144,0)="                Checksum        Checksum"
^DIC(9.4,33,22,1.4,"PAH",62,1,145,0)="  Routine Name  Before Patch    After Patch     Patch List"
^DIC(9.4,33,22,1.4,"PAH",62,1,146,0)="  ============  ============    ===========     ====================="
^DIC(9.4,33,22,1.4,"PAH",62,1,147,0)="  HLCSAS1       1743950         2183617         43,57,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,148,0)="  HLMA          9200711         9200711         19,43,58,63,66,82,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,149,0)="  HLMA1         3849338         3849338         19,43,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,150,0)="  HLMA2         8331015         8331015         19,43,57,58,64,65,76,82,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,151,0)="  HLTF0         3232637         3415603         12,19,64,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,152,0)="  HLTP1         4286011         4286011         34,47,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,153,0)="  HLTP4         7964901         7964901         19,57,59,91"
^DIC(9.4,33,22,1.4,"PAH",62,1,154,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,155,0)="Sites should use CHECK^XTSUMBLD to verify checksums after patch"
^DIC(9.4,33,22,1.4,"PAH",62,1,156,0)="installation."
^DIC(9.4,33,22,1.4,"PAH",62,1,157,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,158,0)="There are five routines above whose checksums will not change after this"
^DIC(9.4,33,22,1.4,"PAH",62,1,159,0)="patch is installed; HLMA, HLMA1, HLMA2, HLTP1, and HLTP4.  The only"
^DIC(9.4,33,22,1.4,"PAH",62,1,160,0)="changes made to these routines is the addition of comment lines"
^DIC(9.4,33,22,1.4,"PAH",62,1,161,0)="documenting the new HLP(""NAMESPACE"") array element.  Since comment lines"
^DIC(9.4,33,22,1.4,"PAH",62,1,162,0)="are not counted in a routine's checksum, the addition of these comment"
^DIC(9.4,33,22,1.4,"PAH",62,1,163,0)="lines do not affect the routine's checksums."
^DIC(9.4,33,22,1.4,"PAH",62,1,164,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,165,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",62,1,166,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",62,1,167,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,168,0)="   NOTICE:  Do not proceed unless patches HL*1.6*47, HL*1.6*57,"
^DIC(9.4,33,22,1.4,"PAH",62,1,169,0)="            HL*1.6*59, and HL*1.6*82 have been installed."
^DIC(9.4,33,22,1.4,"PAH",62,1,170,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,171,0)="   1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",62,1,172,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,173,0)="   2.  AXP/DSM SITES: Review your mapped routine set.  If the"
^DIC(9.4,33,22,1.4,"PAH",62,1,174,0)="       routine listed in the ROUTINE SUMMARY section is mapped, it"
^DIC(9.4,33,22,1.4,"PAH",62,1,175,0)="       should be removed from the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",62,1,176,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,177,0)="   3.  Stop all background processes (logical links and incoming"
^DIC(9.4,33,22,1.4,"PAH",62,1,178,0)="       and outgoing filers) using the 'Filer and Link Management"
^DIC(9.4,33,22,1.4,"PAH",62,1,179,0)="       Option's 'Stop All Messaging Background Processes [HL STOP ALL]'"
^DIC(9.4,33,22,1.4,"PAH",62,1,180,0)="       menu option."
^DIC(9.4,33,22,1.4,"PAH",62,1,181,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,182,0)="   4.  Stop the link manager using the 'TCP Link Manager Start/Stop"
^DIC(9.4,33,22,1.4,"PAH",62,1,183,0)="       [HL START/STOP LINK MANAGER]' menu option."
^DIC(9.4,33,22,1.4,"PAH",62,1,184,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,185,0)="   5.  AXP/DSM SITES ONLY: Disable all HL7 UCX Services for this"
^DIC(9.4,33,22,1.4,"PAH",62,1,186,0)="       installation."
^DIC(9.4,33,22,1.4,"PAH",62,1,187,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,188,0)="   6.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",62,1,189,0)="       option will load the KIDS package onto your system."
^DIC(9.4,33,22,1.4,"PAH",62,1,190,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,191,0)="   7.  This patch is now loaded into a transport global on your"
^DIC(9.4,33,22,1.4,"PAH",62,1,192,0)="       system. The next step is to use KIDS to install the Transport"
^DIC(9.4,33,22,1.4,"PAH",62,1,193,0)="       global. This is done using the 'Installation' menu's 'Install"
^DIC(9.4,33,22,1.4,"PAH",62,1,194,0)="       Package(s) [XPD INSTALL BUILD]' menu option. When using this"
^DIC(9.4,33,22,1.4,"PAH",62,1,195,0)="       menu option to install the patch build, you will be asked"
^DIC(9.4,33,22,1.4,"PAH",62,1,196,0)="       several questions.  The questions, and the answers you should"
^DIC(9.4,33,22,1.4,"PAH",62,1,197,0)="       supply, are shown below."
^DIC(9.4,33,22,1.4,"PAH",62,1,198,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,199,0)="       INSTALL NAME: <HL*1.6*91>"
^DIC(9.4,33,22,1.4,"PAH",62,1,200,0)="       Want KIDS to INHIBIT LOGONS during the install?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",62,1,201,0)="       Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",62,1,202,0)="         and Protocols?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",62,1,203,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,204,0)="   8.  Start all background processes (logical links and incoming"
^DIC(9.4,33,22,1.4,"PAH",62,1,205,0)="       and outgoing filers) using the Filer and Link Management"
^DIC(9.4,33,22,1.4,"PAH",62,1,206,0)="       Option's 'Restart/Start All Links and Filers [HL TASK RESTART]'"
^DIC(9.4,33,22,1.4,"PAH",62,1,207,0)="       menu option."
^DIC(9.4,33,22,1.4,"PAH",62,1,208,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,209,0)="       (Note that links that do not have ""autostart"" enabled will need"
^DIC(9.4,33,22,1.4,"PAH",62,1,210,0)="       to be restarted manually.)"
^DIC(9.4,33,22,1.4,"PAH",62,1,211,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,212,0)="   9. AXP/DSM SITES ONLY: If you previously disabled an HL7 UCX Service"
^DIC(9.4,33,22,1.4,"PAH",62,1,213,0)="      for this installation, you may enable it now."
^DIC(9.4,33,22,1.4,"PAH",62,1,214,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,215,0)="  10.  AXP/DSM SITES ONLY: After the patch has been installed, rebuild"
^DIC(9.4,33,22,1.4,"PAH",62,1,216,0)="       your map set, if necessary."
^DIC(9.4,33,22,1.4,"PAH",62,1,217,0)=" "
^DIC(9.4,33,22,1.4,"PAH",62,1,218,0)="  11.  Start the link manager using the 'TCP Link Manager Start/Stop"
^DIC(9.4,33,22,1.4,"PAH",62,1,219,0)="       [HL START/STOP LINK MANAGER]' menu option."
^DIC(9.4,33,22,1.4,"PAH",63,0)="85 SEQ #78^3020605^1"
^DIC(9.4,33,22,1.4,"PAH",63,1,0)="^^1^1^3020605"
^DIC(9.4,33,22,1.4,"PAH",63,1,1,0)="Refer to the Forum patch text on patch HL*1.6*85 for patch information."
^DIC(9.4,33,22,1.4,"PAH",64,0)="87 SEQ #79^3020626^1"
^DIC(9.4,33,22,1.4,"PAH",64,1,0)="^^110^110^3020626"
^DIC(9.4,33,22,1.4,"PAH",64,1,1,0)="Associated Patches:  This patch requires that KIDS build HL*1.6*77 be "
^DIC(9.4,33,22,1.4,"PAH",64,1,2,0)="                     installed."
^DIC(9.4,33,22,1.4,"PAH",64,1,3,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,4,0)="Test sites:    Oklahoma City VAMC, Muskogee VAMC, San Francisco VAMC"
^DIC(9.4,33,22,1.4,"PAH",64,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,6,0)="NOIS:    OKL-1201-70586   VA* Logical Links not transmitting"
^DIC(9.4,33,22,1.4,"PAH",64,1,7,0)="         ISF-0700-62124   Duplicate Entries for messages"
^DIC(9.4,33,22,1.4,"PAH",64,1,8,0)="         SDC-0301-60090   Message stuck in 'Awaiting ACK' status"
^DIC(9.4,33,22,1.4,"PAH",64,1,9,0)="         ISF-0400-62120   Excessive Retransmissions"
^DIC(9.4,33,22,1.4,"PAH",64,1,10,0)="         ISH-0900-40469   re-transmissions for a message awaiting an ack"
^DIC(9.4,33,22,1.4,"PAH",64,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,12,0)="This patch fixes the problem where a TCP client logical link and its "
^DIC(9.4,33,22,1.4,"PAH",64,1,13,0)="corresponding listener logical link lose synchronization.  Loss of "
^DIC(9.4,33,22,1.4,"PAH",64,1,14,0)="synchronization creates excessive retransmission of messages and their "
^DIC(9.4,33,22,1.4,"PAH",64,1,15,0)="acknowledgements, causing side effects: one is that the client link gets "
^DIC(9.4,33,22,1.4,"PAH",64,1,16,0)="stuck in a ""Reading"" state because its TCP receive buffer fills up; "
^DIC(9.4,33,22,1.4,"PAH",64,1,17,0)="another is that the disk on both the sending and the receiving sides "
^DIC(9.4,33,22,1.4,"PAH",64,1,18,0)="fills up at a faster rate."
^DIC(9.4,33,22,1.4,"PAH",64,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,20,0)="This patch makes corrections in the way the TCP client logical link "
^DIC(9.4,33,22,1.4,"PAH",64,1,21,0)="retransmits a message when its corresponding acknowledgement does not "
^DIC(9.4,33,22,1.4,"PAH",64,1,22,0)="arrive in time or receives an incorrect acknowledgement.  Previous HL7 "
^DIC(9.4,33,22,1.4,"PAH",64,1,23,0)="code allowed the logical link to retransmit a message when the "
^DIC(9.4,33,22,1.4,"PAH",64,1,24,0)="acknowledgement message was incorrect, including an ""incorrect msg id"" "
^DIC(9.4,33,22,1.4,"PAH",64,1,25,0)="acknowledgement.  This patch corrects the code to allow retransmission of "
^DIC(9.4,33,22,1.4,"PAH",64,1,26,0)="a message only when the logical link does not receive an acknowledgement "
^DIC(9.4,33,22,1.4,"PAH",64,1,27,0)="in time (timed out) and ignores incorrect acknowledgements."
^DIC(9.4,33,22,1.4,"PAH",64,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,29,0)="Routine Information:"
^DIC(9.4,33,22,1.4,"PAH",64,1,30,0)="====================="
^DIC(9.4,33,22,1.4,"PAH",64,1,31,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,32,0)="The following routine is included in this patch.  The second line of the "
^DIC(9.4,33,22,1.4,"PAH",64,1,33,0)="routine now looks like this:"
^DIC(9.4,33,22,1.4,"PAH",64,1,34,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,35,0)=";;1.6;HEALTH LEVEL SEVEN;**19,43,49,57,63,64,66,67,76,77,87**;JUL 17,1995."
^DIC(9.4,33,22,1.4,"PAH",64,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,37,0)="The VA Kernel checksums for this routine (calculated using "
^DIC(9.4,33,22,1.4,"PAH",64,1,38,0)="CHECK^XTSUMBLD) are listed below:"
^DIC(9.4,33,22,1.4,"PAH",64,1,39,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,40,0)="  Routine     Checksum        Checksum        "
^DIC(9.4,33,22,1.4,"PAH",64,1,41,0)="  Name        Before Patch    After Patch     "
^DIC(9.4,33,22,1.4,"PAH",64,1,42,0)="  ========    ============    ===========     "
^DIC(9.4,33,22,1.4,"PAH",64,1,43,0)="  HLCSTCP2    12129232        12913767 "
^DIC(9.4,33,22,1.4,"PAH",64,1,44,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,45,0)="  Patch List"
^DIC(9.4,33,22,1.4,"PAH",64,1,46,0)="  ====================="
^DIC(9.4,33,22,1.4,"PAH",64,1,47,0)="  **19,43,49,57,63,64,66,67,76,77,87**;"
^DIC(9.4,33,22,1.4,"PAH",64,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,49,0)="Sites should use CHECK^XTSUMBLD to verify checksums after the patch"
^DIC(9.4,33,22,1.4,"PAH",64,1,50,0)="has been installed."
^DIC(9.4,33,22,1.4,"PAH",64,1,51,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,52,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",64,1,53,0)=" =========================="
^DIC(9.4,33,22,1.4,"PAH",64,1,54,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,55,0)="   1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",64,1,56,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,57,0)="   2.  AXP/DSM SITES: Review your mapped routine set.  If any of the"
^DIC(9.4,33,22,1.4,"PAH",64,1,58,0)="       routines listed in the ROUTINE SUMMARY section are mapped, they"
^DIC(9.4,33,22,1.4,"PAH",64,1,59,0)="       should be removed from the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",64,1,60,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,61,0)="   3.  Shutdown all Logical Links, incoming and outgoing filers, and"
^DIC(9.4,33,22,1.4,"PAH",64,1,62,0)="       the Link Manager using the Filer and Link Management options"
^DIC(9.4,33,22,1.4,"PAH",64,1,63,0)="       listed below:"
^DIC(9.4,33,22,1.4,"PAH",64,1,64,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,65,0)="         Stop All Messaging Background Processes [HL STOP ALL]"
^DIC(9.4,33,22,1.4,"PAH",64,1,66,0)="         TCP Link Manager Start/Stop [HL START/STOP LINK MANAGER]"
^DIC(9.4,33,22,1.4,"PAH",64,1,67,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,68,0)="       AXP/DSM SITES ONLY: Disable all HL7 UCX Services for this"
^DIC(9.4,33,22,1.4,"PAH",64,1,69,0)="       installation."
^DIC(9.4,33,22,1.4,"PAH",64,1,70,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,71,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",64,1,72,0)="       option will load the KIDS package onto your system."
^DIC(9.4,33,22,1.4,"PAH",64,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,74,0)="  5.  This patch is now loaded into a transport global on your"
^DIC(9.4,33,22,1.4,"PAH",64,1,75,0)="       system. The next step is to use KIDS to install the Transport"
^DIC(9.4,33,22,1.4,"PAH",64,1,76,0)="       global. To do this, use the 'Installation [XPD INSTALLATION "
^DIC(9.4,33,22,1.4,"PAH",64,1,77,0)="       MENU]' menu.  You should use each of the following 'Installation'"
^DIC(9.4,33,22,1.4,"PAH",64,1,78,0)="       menu options in the order shown below:"
^DIC(9.4,33,22,1.4,"PAH",64,1,79,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,80,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",64,1,81,0)="         Print Transport Global"
^DIC(9.4,33,22,1.4,"PAH",64,1,82,0)="         Compare Transport Global to Current System"
^DIC(9.4,33,22,1.4,"PAH",64,1,83,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",64,1,84,0)="         Install Package(s)"
^DIC(9.4,33,22,1.4,"PAH",64,1,85,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,86,0)="       When using the 'Install Package(s)' menu option to install "
^DIC(9.4,33,22,1.4,"PAH",64,1,87,0)="       the patch build, you will be asked several questions.  The "
^DIC(9.4,33,22,1.4,"PAH",64,1,88,0)="       questions asked, and the answers you should supply, are "
^DIC(9.4,33,22,1.4,"PAH",64,1,89,0)="       shown below."
^DIC(9.4,33,22,1.4,"PAH",64,1,90,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,91,0)="         INSTALL NAME: <HL*1.6*87>"
^DIC(9.4,33,22,1.4,"PAH",64,1,92,0)="         Want KIDS to INHIBIT LOGONS during the install?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",64,1,93,0)="         Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,33,22,1.4,"PAH",64,1,94,0)="         Protocols?  <NO>"
^DIC(9.4,33,22,1.4,"PAH",64,1,95,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,96,0)="   6.  Start up all Logical Links and incoming and outgoing filers using"
^DIC(9.4,33,22,1.4,"PAH",64,1,97,0)="       the Filer and Link Management Option's 'Restart/Start All Links"
^DIC(9.4,33,22,1.4,"PAH",64,1,98,0)="       and Filers [HL TASK RESTART]' menu option."
^DIC(9.4,33,22,1.4,"PAH",64,1,99,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,100,0)="       (Note that links that do not have ""autostart"" enabled will need"
^DIC(9.4,33,22,1.4,"PAH",64,1,101,0)="       to be restarted manually.)"
^DIC(9.4,33,22,1.4,"PAH",64,1,102,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,103,0)="       AXP/DSM SITES ONLY: If you previously disabled an HL7 UCX Service"
^DIC(9.4,33,22,1.4,"PAH",64,1,104,0)="       for this installation, you may enable it now."
^DIC(9.4,33,22,1.4,"PAH",64,1,105,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,106,0)="   7.  AXP/DSM Sites:  After the patch has been installed, rebuild your"
^DIC(9.4,33,22,1.4,"PAH",64,1,107,0)="       map set, if necessary."
^DIC(9.4,33,22,1.4,"PAH",64,1,108,0)=" "
^DIC(9.4,33,22,1.4,"PAH",64,1,109,0)="   8.  Start Link Manager using the 'TCP Link Manager Start/Stop [HL"
^DIC(9.4,33,22,1.4,"PAH",64,1,110,0)="       START/STOP LINK MANAGER]' menu option. "
