^DIC(9.4,111,22,1,"PAH",134,1,1,0)="CONSULT/SCHEDULING APPOINTMENT LINK INTERFACE"
^DIC(9.4,111,22,1,"PAH",135,0)="157 SEQ #137^3060923^1"
^DIC(9.4,111,22,1,"PAH",135,1,0)="^^6^6^3060923"
^DIC(9.4,111,22,1,"PAH",135,1,1,0)="1. Text editing/alignment in PXTT EDIT EDUCATION TOPICS not displaying"
