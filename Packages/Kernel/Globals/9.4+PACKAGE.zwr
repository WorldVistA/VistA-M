^DIC(9.4,14,22,5.9,"PAH",148,1,49,0)="Portland, OR"
^DIC(9.4,14,22,5.9,"PAH",148,1,50,0)="Minneapolis, MN"
^DIC(9.4,14,22,5.9,"PAH",148,1,51,0)=" "
