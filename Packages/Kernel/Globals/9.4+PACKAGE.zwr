^DIC(9.4,120,22,12,"PAH",97,1,1,0)="IVM*2*120"
^DIC(9.4,120,22,12,"PAH",98,0)="105^3070905.005628^1"
^DIC(9.4,120,22,12,"PAH",99,0)="124 SEQ #104^3070905.010805^1"
^DIC(9.4,120,22,12,"PAH",100,0)="127^3080526.143925^1"
^DIC(9.4,120,22,12,"PAH",101,0)="128 SEQ #106^3080526.154406^1"
^DIC(9.4,120,22,12,"PAH",102,0)="123 SEQ #107^3080526.160317^1"
^DIC(9.4,120,22,12,"PAH",102,1,0)="^^2^2^3080526"
^DIC(9.4,120,22,12,"PAH",102,1,1,0)="Please refer to the National Patch Module for details of the changes"
^DIC(9.4,120,22,12,"PAH",102,1,2,0)="contained in this build."
^DIC(9.4,120,22,12,"PAH",103,0)="130 SEQ #108^3090420.160448^1"
^DIC(9.4,120,22,12,"PAH",104,0)="126 SEQ #109^3090421.135337^17"
^DIC(9.4,120,22,12,"PAH",105,0)="132 SEQ #110^3090422.124015^17"
^DIC(9.4,120,22,12,"PAH",105,1,0)="^^4^4^3090422"
^DIC(9.4,120,22,12,"PAH",105,1,1,0)="This patch takes out the check for field #5 CHECK/DON'T CHECK, in file #38.6"
^DIC(9.4,120,22,12,"PAH",105,1,2,0)="INCONSISTENT DATA ELEMENTS when sending data in a Z07."
^DIC(9.4,120,22,12,"PAH",105,1,3,0)="This patch also changes the call from $$DT^XLFDT"
^DIC(9.4,120,22,12,"PAH",105,1,4,0)="to $$NOW^XLFDT in routine IVMZ7CR to pass the inconsistency check for Z07.  "
^DIC(9.4,120,22,12,"PAH",106,0)="134 SEQ #111^3090422.163844^17"
^DIC(9.4,120,22,12,"PAH",106,1,0)="^^3^3^3090422"
^DIC(9.4,120,22,12,"PAH",106,1,1,0)="This patch removes code in IVMZ07C that makes reference to field (#5)"
^DIC(9.4,120,22,12,"PAH",106,1,2,0)="CHECK/DON'T CHECK in the INCONSITENCY DATA file (38.6)"
^DIC(9.4,120,22,12,"PAH",106,1,3,0)="in preventing the transmission of a Z07."
^DIC(9.4,120,22,12,"PAH",107,0)="133 SEQ #112^3090423.111353^17"
^DIC(9.4,120,22,12,"PAH",108,0)="115^3090423.134023^17"
^DIC(9.4,120,22,12,"PAH",108,1,0)="^^2^2^3090423"
^DIC(9.4,120,22,12,"PAH",108,1,1,0)="See the Patch Description for IVM*2*115 as generated out of the Forum "
^DIC(9.4,120,22,12,"PAH",108,1,2,0)="Patch Module."
^DIC(9.4,120,22,12,"PAH",109,0)="140 SEQ #114^3090527.174522^17"
^DIC(9.4,120,22,12,"PAH",110,0)="131 SEQ #115^3090609.120151^17"
^DIC(9.4,120,22,12,"PAH",111,0)="129 SEQ #116^3090701.145831^17"
^DIC(9.4,120,22,12,"PAH",111,1,0)="^^3^3^3090701"
^DIC(9.4,120,22,12,"PAH",111,1,1,0)="This patch corrects the bulletin sent as a result of an HL7 message 'AE'"
^DIC(9.4,120,22,12,"PAH",111,1,2,0)="error being received in VistA.  Please refer to the National Patch Module"
^DIC(9.4,120,22,12,"PAH",111,1,3,0)="(NPM) for a full description of the contents of this patch."
^DIC(9.4,120,22,12,"PAH",112,0)="135 SEQ #117^3091214.123855^17"
^DIC(9.4,120,22,12,"PAH",112,1,0)="^^23^23^3091214"
^DIC(9.4,120,22,12,"PAH",112,1,1,0)="This patch is being implemented in support of the Insurance Capture Buffer"
^DIC(9.4,120,22,12,"PAH",112,1,2,0)="(ICB) application which will provide a GUI front end to the Integrated"
^DIC(9.4,120,22,12,"PAH",112,1,3,0)="Billing (IB) insurance update/editing functionality. The ICB application"
^DIC(9.4,120,22,12,"PAH",112,1,4,0)="requires that there be no write statements or interactive reads when using"
^DIC(9.4,120,22,12,"PAH",112,1,5,0)="the existing IB ACCEPT/REJECT Insurance Buffer logic. Currently, there is"
^DIC(9.4,120,22,12,"PAH",112,1,6,0)="ICR 2530 is the supported interface between IB and IVM. The"
^DIC(9.4,120,22,12,"PAH",112,1,7,0)="UPDATE^IVMLINS4 API needs to be updated to comply with ICBs requirements."
^DIC(9.4,120,22,12,"PAH",112,1,8,0)=" "
^DIC(9.4,120,22,12,"PAH",112,1,9,0)="This patch will add two additional input parameters to the UPDATE^IVMLINS4"
^DIC(9.4,120,22,12,"PAH",112,1,10,0)="API as follows:"
^DIC(9.4,120,22,12,"PAH",112,1,11,0)="     UPDATE(DFN,IVMINSST,IVMID,IVMREPTR,IVMSUPPR)"
^DIC(9.4,120,22,12,"PAH",112,1,12,0)=" "
^DIC(9.4,120,22,12,"PAH",112,1,13,0)="The IVMREPTR variable is an input variable to pass the IVM REASONS FOR NOT"
^DIC(9.4,120,22,12,"PAH",112,1,14,0)="UPLOADING (#301.91) Internal Entry Number into this application. This"
^DIC(9.4,120,22,12,"PAH",112,1,15,0)="variable will be optional. When an Insurance Segment is rejected based on"
^DIC(9.4,120,22,12,"PAH",112,1,16,0)="the ICB application rejecting an IVM Insurance entry from the IVM"
^DIC(9.4,120,22,12,"PAH",112,1,17,0)="application, the pointer value for the reason it isn't uploaded will be"
^DIC(9.4,120,22,12,"PAH",112,1,18,0)="pass and store in the REASON NOT UPLOADING INSURANCE (#.08) field of the"
^DIC(9.4,120,22,12,"PAH",112,1,19,0)="IVM PATIENT (#301.5) file."
^DIC(9.4,120,22,12,"PAH",112,1,20,0)=" "
^DIC(9.4,120,22,12,"PAH",112,1,21,0)="The IVMSUPPR variable is an input variable which when passed will suppress"
^DIC(9.4,120,22,12,"PAH",112,1,22,0)="what is written to the screen and the interactive read of the IVM REASON"
^DIC(9.4,120,22,12,"PAH",112,1,23,0)="FOR NOT UPLOADING (#301.91) file within the UPDATE API."
^DIC(9.4,120,22,12,"PAH",113,0)="136 SEQ #118^3100208.1203^17"
^DIC(9.4,120,22,12,"PAH",113,1,0)="^^3^3^3100208"
^DIC(9.4,120,22,12,"PAH",113,1,1,0)="This patch fixes a hard error when uploading a means test from a"
^DIC(9.4,120,22,12,"PAH",113,1,2,0)="Z10 message.  Please refer to the National Patch Module for a full"
^DIC(9.4,120,22,12,"PAH",113,1,3,0)="description of the contents of this patch."
^DIC(9.4,120,22,12,"PAH",114,0)="139 SEQ #119^3100226.105211^17"
^DIC(9.4,120,22,12,"PAH",115,0)="144 SEQ #120^3100226.105234^17"
^DIC(9.4,120,22,12,"PAH",116,0)="142 SEQ #121^3100518.152312^17"
^DIC(9.4,120,22,12,"PAH",116,1,0)="^^1^1^3100518"
^DIC(9.4,120,22,12,"PAH",116,1,1,0)="This patch prevents test patients from sending Z07 transmissions."
