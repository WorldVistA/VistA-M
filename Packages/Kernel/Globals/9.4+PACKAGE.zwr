^DIC(9.4,100,22,15,"PAH",21,1,220,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,221,0)="Example of GAF Batch Transmission"
^DIC(9.4,100,22,15,"PAH",21,1,222,0)="---------------------------------"
^DIC(9.4,100,22,15,"PAH",21,1,223,0)="   >D EN^YSGAFTR"
^DIC(9.4,100,22,15,"PAH",21,1,224,0)="    "
^DIC(9.4,100,22,15,"PAH",21,1,225,0)="       [At the prompt, enter the start date, this] "
^DIC(9.4,100,22,15,"PAH",21,1,226,0)="       [date will be the beginning date range    ] "
^DIC(9.4,100,22,15,"PAH",21,1,227,0)="       [used in the selection criteria.          ]"
^DIC(9.4,100,22,15,"PAH",21,1,228,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,229,0)="   >Enter start date :  (10/1/97 - 12/31/99): 10/1/97  (OCT 01, 1997)"
^DIC(9.4,100,22,15,"PAH",21,1,230,0)="                                              -------"
^DIC(9.4,100,22,15,"PAH",21,1,231,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,232,0)="       [At the prompt, enter the stop date, this ]"
^DIC(9.4,100,22,15,"PAH",21,1,233,0)="       [date will be the ending date range       ] "
^DIC(9.4,100,22,15,"PAH",21,1,234,0)="       [used in the selection criteria.          ]"
^DIC(9.4,100,22,15,"PAH",21,1,235,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,236,0)="   >Enter stop date :  (10/1/97 - 12/31/99): 12/31/99  (DEC 31, 1999)"
^DIC(9.4,100,22,15,"PAH",22,0)="47 SEQ #41^2990201^1"
^DIC(9.4,100,22,15,"PAH",22,1,0)="^^21^21^2990201"
^DIC(9.4,100,22,15,"PAH",22,1,1,0)="This patch updates the Clozapine reporting software as required by the"
^DIC(9.4,100,22,15,"PAH",22,1,2,0)="CLOZAPINE PATIENT MANAGEMENT PROTOCOL (CPMP)."
^DIC(9.4,100,22,15,"PAH",22,1,3,0)=" These changes include:"
^DIC(9.4,100,22,15,"PAH",22,1,4,0)=" 1. Reporting Absolute Neutrophil Count (Calculated from percentage"
^DIC(9.4,100,22,15,"PAH",22,1,5,0)="    reported at the site).  "
^DIC(9.4,100,22,15,"PAH",22,1,6,0)="      The CLOZAPINE LAB TEST (#603.02) file has been created to facilitate"
^DIC(9.4,100,22,15,"PAH",22,1,7,0)="      this report.  The Neutrophil Count (#1) field in the CLOZAPINE LAB"
^DIC(9.4,100,22,15,"PAH",22,1,8,0)="      TEST (#603.02) file indicates the proper Neutrophil Count test to be"
^DIC(9.4,100,22,15,"PAH",22,1,9,0)="      used."
^DIC(9.4,100,22,15,"PAH",22,1,10,0)=" 2. Update Site Number reporting to comply with integrated site"
^DIC(9.4,100,22,15,"PAH",22,1,11,0)="    requirements.  "
^DIC(9.4,100,22,15,"PAH",22,1,12,0)="      References to the DEFAULT INSTITUTION (#217) field in the KERNEL"
^DIC(9.4,100,22,15,"PAH",22,1,13,0)="      SITE PARAMETERS (#4.3) are no longer supported.  These references"
^DIC(9.4,100,22,15,"PAH",22,1,14,0)="      were changed to the supported call $$SITE^VASITE referenced in"
^DIC(9.4,100,22,15,"PAH",22,1,15,0)="      DBIA#10112."
^DIC(9.4,100,22,15,"PAH",22,1,16,0)=" 3. Extend reporting time for White Blood Count to six months. Changes are"
^DIC(9.4,100,22,15,"PAH",22,1,17,0)="    also included to improve the reporting of the White Blood Count."
^DIC(9.4,100,22,15,"PAH",22,1,18,0)="      The CLOZAPINE LAB TEST (#603.02) file has been created to facilitate"
^DIC(9.4,100,22,15,"PAH",22,1,19,0)="      this report.  The White Blood Count (#.01) field in the CLOZAPINE"
^DIC(9.4,100,22,15,"PAH",22,1,20,0)="      LAB TEST (#603.02) file indicates the proper White Blood Count test"
^DIC(9.4,100,22,15,"PAH",22,1,21,0)="      to be used."
^DIC(9.4,100,22,15,"PAH",23,0)="39 SEQ #42^2990223^1"
^DIC(9.4,100,22,15,"PAH",23,1,0)="^^2^2^2990223"
^DIC(9.4,100,22,15,"PAH",23,1,1,0)="This patch will now allow a progress note to be built using TIU V. 1.0.  This"
^DIC(9.4,100,22,15,"PAH",23,1,2,0)="patch can only be installed if TIU V. 1.0 has been installed at your site."
^DIC(9.4,100,22,15,"PAH",24,0)="50 SEQ #43^2990329^1"
^DIC(9.4,100,22,15,"PAH",25,0)="48 SEQ #44^2990602^1"
^DIC(9.4,100,22,15,"PAH",25,1,0)="^^79^79^2990602"
^DIC(9.4,100,22,15,"PAH",25,1,1,0)="This patch enhances the management report, Global Assessment of Functioning"
^DIC(9.4,100,22,15,"PAH",25,1,2,0)="(GAF).  The new option GAF Case Finder [YSGAF CASE FINDER] has been added as"
^DIC(9.4,100,22,15,"PAH",25,1,3,0)="an item to the MENU Global Assessment of Functioning [YSGAF MAIN]."
^DIC(9.4,100,22,15,"PAH",25,1,4,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,5,0)="The GAF report now lists all patients that have not been given a GAF score"
^DIC(9.4,100,22,15,"PAH",25,1,6,0)="within the last 90 days.  The user is given the option to sort the report"
^DIC(9.4,100,22,15,"PAH",25,1,7,0)="by patient name or by provider.  The results of this report are sent to the"
^DIC(9.4,100,22,15,"PAH",25,1,8,0)="MAILMAN system and are returned the user as a MAILMAN message.  It is also"
^DIC(9.4,100,22,15,"PAH",25,1,9,0)="recommended to queue the report during non-peak or after-hours."
^DIC(9.4,100,22,15,"PAH",25,1,10,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,11,0)="The following is an example of the generated report:"
^DIC(9.4,100,22,15,"PAH",25,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,13,0)="               GAF Case Finder"
^DIC(9.4,100,22,15,"PAH",25,1,14,0)="Begining Date: DEC 1,1998"
^DIC(9.4,100,22,15,"PAH",25,1,15,0)="  Ending Date: MAR 18,1999"
^DIC(9.4,100,22,15,"PAH",25,1,16,0)="     Facility: Dallas CIOFO"
^DIC(9.4,100,22,15,"PAH",25,1,17,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,18,0)="The following is a list of all patients who had a Mental Health Outpatient"
^DIC(9.4,100,22,15,"PAH",25,1,19,0)="Encounter between the above dates but do not have a GAF score WITHIN 90"
^DIC(9.4,100,22,15,"PAH",25,1,20,0)="DAYS.  Last MH (non-telephonic) Outpatient Encounter in date range is listed."
^DIC(9.4,100,22,15,"PAH",25,1,21,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,22,0)="Name                 SSN     Date                Location         Provider"
^DIC(9.4,100,22,15,"PAH",25,1,23,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,24,0)="0 MH patients without a GAF."
^DIC(9.4,100,22,15,"PAH",25,1,25,0)="0 MH patients had a GAF."
^DIC(9.4,100,22,15,"PAH",25,1,26,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,27,0)="    NOIS calls:     none"
^DIC(9.4,100,22,15,"PAH",25,1,28,0)="    Test Site(s):   Dallas, TX"
^DIC(9.4,100,22,15,"PAH",25,1,29,0)="                    Salt Lake City, UT"
^DIC(9.4,100,22,15,"PAH",25,1,30,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,31,0)="    ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",25,1,32,0)="    ================"
^DIC(9.4,100,22,15,"PAH",25,1,33,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,34,0)="    The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",25,1,35,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,36,0)="    <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",25,1,37,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,38,0)="                                    Checksum Values"
^DIC(9.4,100,22,15,"PAH",25,1,39,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,40,0)="    Routine Name       Before Patch        After Patch         Patch List"
^DIC(9.4,100,22,15,"PAH",25,1,41,0)="    ------------       ------------        -----------         ----------"
^DIC(9.4,100,22,15,"PAH",25,1,42,0)="    YSGAF3                 N/A                12209534                 48"
^DIC(9.4,100,22,15,"PAH",25,1,43,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,44,0)="    Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",25,1,45,0)="    =========================="
^DIC(9.4,100,22,15,"PAH",25,1,46,0)="         1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",25,1,47,0)="            This option will load the KIDS package in this message onto your"
^DIC(9.4,100,22,15,"PAH",25,1,48,0)="            system."
^DIC(9.4,100,22,15,"PAH",25,1,49,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,50,0)="         2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",25,1,51,0)="            system. You now need to use KIDS to install the Transport"
^DIC(9.4,100,22,15,"PAH",25,1,52,0)="            global.  The transport global will remain on the system until"
^DIC(9.4,100,22,15,"PAH",25,1,53,0)="            installed or manually deleted."
^DIC(9.4,100,22,15,"PAH",25,1,54,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,55,0)="         3. On the KIDS menu, under the 'Installation' menu, use"
^DIC(9.4,100,22,15,"PAH",25,1,56,0)="            the following options:"
^DIC(9.4,100,22,15,"PAH",25,1,57,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,58,0)="                 Print Transport Global"
^DIC(9.4,100,22,15,"PAH",25,1,59,0)="                 Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",25,1,60,0)="                 Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",25,1,61,0)="                 Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",25,1,62,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,63,0)="         4. Installation of this patch should be at off peak hours."
^DIC(9.4,100,22,15,"PAH",25,1,64,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,65,0)="         5. Users may remain on the system."
^DIC(9.4,100,22,15,"PAH",25,1,66,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,67,0)="         6. Installation will take less than five minutes and requires no"
^DIC(9.4,100,22,15,"PAH",25,1,68,0)="            additional memory space."
^DIC(9.4,100,22,15,"PAH",25,1,69,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,70,0)="         7. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",25,1,71,0)="            'Install Package(s)' Select the package 'YS*5.01*48' and"
^DIC(9.4,100,22,15,"PAH",25,1,72,0)="            proceed with install."
^DIC(9.4,100,22,15,"PAH",25,1,73,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,74,0)="         8. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,100,22,15,"PAH",25,1,75,0)="            Install? YES//', respond NO.  However, it is advised that menus"
^DIC(9.4,100,22,15,"PAH",25,1,76,0)="            be rebuilt at a later time."
^DIC(9.4,100,22,15,"PAH",25,1,77,0)=" "
^DIC(9.4,100,22,15,"PAH",25,1,78,0)="         9. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,100,22,15,"PAH",25,1,79,0)="            and Protocols? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",26,0)="31^2990622^1"
^DIC(9.4,100,22,15,"PAH",26,1,0)="^^152^152^2990622"
^DIC(9.4,100,22,15,"PAH",26,1,1,0)="1. Patch YS*5.01*31 releases several new psychological tests/interviews to "
^DIC(9.4,100,22,15,"PAH",26,1,2,0)="   the Mental Health package.  These tests are accessed via menu item "
^DIC(9.4,100,22,15,"PAH",26,1,3,0)="   'Psychological tests/interviews (administer) [YSADMTEST].'  The new "
^DIC(9.4,100,22,15,"PAH",26,1,4,0)="   tests are as follows:"
^DIC(9.4,100,22,15,"PAH",26,1,5,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,6,0)="   a. Test Name:  CAGE"
^DIC(9.4,100,22,15,"PAH",26,1,7,0)="      Description:  A quick alcohol screening measure."
^DIC(9.4,100,22,15,"PAH",26,1,8,0)="      Number of Questions:  4"
^DIC(9.4,100,22,15,"PAH",26,1,9,0)="      Number of Scales:  1"
^DIC(9.4,100,22,15,"PAH",26,1,10,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,11,0)="   b. Test Name:  AUDIT"
^DIC(9.4,100,22,15,"PAH",26,1,12,0)="      Description:  Alcohol Use Disorders Identification Test"
^DIC(9.4,100,22,15,"PAH",26,1,13,0)="      Number of Questions:  10"
^DIC(9.4,100,22,15,"PAH",26,1,14,0)="      Number of Scales:  1"
^DIC(9.4,100,22,15,"PAH",26,1,15,0)="  "
^DIC(9.4,100,22,15,"PAH",26,1,16,0)="   c. Test Name:  SMAST"
^DIC(9.4,100,22,15,"PAH",26,1,17,0)="      Description:  Short Michigan Alcoholism Screening Test"
^DIC(9.4,100,22,15,"PAH",26,1,18,0)="      Number of Questions:  13"
^DIC(9.4,100,22,15,"PAH",26,1,19,0)="      Number of Scales:  1"
^DIC(9.4,100,22,15,"PAH",26,1,20,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,21,0)="   d. Test Name:  DOM80"
^DIC(9.4,100,22,15,"PAH",26,1,22,0)="      Description:  Depression Outcome Module: Patient Screen 8.0 "
^DIC(9.4,100,22,15,"PAH",26,1,23,0)="      Number of Questions:  4"
^DIC(9.4,100,22,15,"PAH",26,1,24,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,25,0)="   e. Test Name:  DOM81"
^DIC(9.4,100,22,15,"PAH",26,1,26,0)="      Description:  Depression Outcome Module: Patient Baseline 8.1"
^DIC(9.4,100,22,15,"PAH",26,1,27,0)="      Number of Questions:  69"
^DIC(9.4,100,22,15,"PAH",26,1,28,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,29,0)="   f. Test Name:  DOM82"
^DIC(9.4,100,22,15,"PAH",26,1,30,0)="      Description:  Depression Outcome Module: Clinician Baseline 8.2"
^DIC(9.4,100,22,15,"PAH",26,1,31,0)="      Number of Questions:  23"
^DIC(9.4,100,22,15,"PAH",26,1,32,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,33,0)="   g. Test Name:  DOMG"
^DIC(9.4,100,22,15,"PAH",26,1,34,0)="      Description:  Depression Outcome Module: Geriatric Screen"
^DIC(9.4,100,22,15,"PAH",26,1,35,0)="      Number of Questions: 5"
^DIC(9.4,100,22,15,"PAH",26,1,36,0)="      Number of Scales:  1"
^DIC(9.4,100,22,15,"PAH",26,1,37,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,38,0)="   h. Test Name:  SAI"
^DIC(9.4,100,22,15,"PAH",26,1,39,0)="      Description:  Spiritual Assessment Inventory"
^DIC(9.4,100,22,15,"PAH",26,1,40,0)="      Number of Questions: 14"
^DIC(9.4,100,22,15,"PAH",26,1,41,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,42,0)="These tests are stored as new entries in the MH INSTRUMENT FILE (#601)."
^DIC(9.4,100,22,15,"PAH",26,1,43,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,44,0)="2. Patch YS*5.01*31 also includes six additional scales added to the test"
^DIC(9.4,100,22,15,"PAH",26,1,45,0)="   MMPI2 - Minnesota Multiphasic Personality Inventory-2.  The new scales"
^DIC(9.4,100,22,15,"PAH",26,1,46,0)="   are as follows:"
^DIC(9.4,100,22,15,"PAH",26,1,47,0)="  "
^DIC(9.4,100,22,15,"PAH",26,1,48,0)="      MDS - Marital Distress Scale"
^DIC(9.4,100,22,15,"PAH",26,1,49,0)="      APS - Addiction Potential Scale"
^DIC(9.4,100,22,15,"PAH",26,1,50,0)="      AAS - Addiction Admission Scale"
^DIC(9.4,100,22,15,"PAH",26,1,51,0)="      S   - Superlative Self-Presentation"
^DIC(9.4,100,22,15,"PAH",26,1,52,0)="      Fp  - Infrequency-Psychopathology"
^DIC(9.4,100,22,15,"PAH",26,1,53,0)="      Ho  - Hostility"
^DIC(9.4,100,22,15,"PAH",26,1,54,0)=""
^DIC(9.4,100,22,15,"PAH",26,1,55,0)="3. Five new routines are included in patch YS*5.01*31.  They are:"
^DIC(9.4,100,22,15,"PAH",26,1,56,0)="  "
^DIC(9.4,100,22,15,"PAH",26,1,57,0)="   YS31ENV     -  YS*5.01*31 Patch Environment Check Routine"
^DIC(9.4,100,22,15,"PAH",26,1,58,0)="   YS31POST    -  YS*5.01*31 Patch Post Routine"
^DIC(9.4,100,22,15,"PAH",26,1,59,0)="   YTALUSE     -  Test-Audit Alcohol Screen"
^DIC(9.4,100,22,15,"PAH",26,1,60,0)="   YTDOMR      -  Depression Outcome Module Report"
^DIC(9.4,100,22,15,"PAH",26,1,61,0)="   YTDOMR1     -  Extended Interview Reporter"
^DIC(9.4,100,22,15,"PAH",26,1,62,0)=""
^DIC(9.4,100,22,15,"PAH",26,1,63,0)="4. One edited routine:"
^DIC(9.4,100,22,15,"PAH",26,1,64,0)=""
^DIC(9.4,100,22,15,"PAH",26,1,65,0)="   YTMMPI2B    -  MMPI2 Harris:Lingos,Crit,OS"
^DIC(9.4,100,22,15,"PAH",26,1,66,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,67,0)="   Test Site(s):  Dallas, TX"
^DIC(9.4,100,22,15,"PAH",26,1,68,0)="                  Cleveland, OH"
^DIC(9.4,100,22,15,"PAH",26,1,69,0)="                  Minneapolis, MN"
^DIC(9.4,100,22,15,"PAH",26,1,70,0)="                  Asheville, NC"
^DIC(9.4,100,22,15,"PAH",26,1,71,0)="                  Portland, OR"
^DIC(9.4,100,22,15,"PAH",26,1,72,0)="                  Canadaigua, NY"
^DIC(9.4,100,22,15,"PAH",26,1,73,0)="                  Little Rock, AR     "
^DIC(9.4,100,22,15,"PAH",26,1,74,0)="   "
^DIC(9.4,100,22,15,"PAH",26,1,75,0)="  ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",26,1,76,0)="  ================"
^DIC(9.4,100,22,15,"PAH",26,1,77,0)="   "
^DIC(9.4,100,22,15,"PAH",26,1,78,0)="  The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",26,1,79,0)="  "
^DIC(9.4,100,22,15,"PAH",26,1,80,0)="  <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",26,1,81,0)="   "
^DIC(9.4,100,22,15,"PAH",26,1,82,0)="                                  Checksum Values"
^DIC(9.4,100,22,15,"PAH",26,1,83,0)="   "
^DIC(9.4,100,22,15,"PAH",26,1,84,0)="  Routine Name       Before Patch        After Patch         Patch List"
^DIC(9.4,100,22,15,"PAH",26,1,85,0)="  ------------       ------------        -----------         ----------"
^DIC(9.4,100,22,15,"PAH",26,1,86,0)="  YS31ENV                 N/A                2399932         31"
^DIC(9.4,100,22,15,"PAH",26,1,87,0)="  YS31POST                N/A                 133706         31"
^DIC(9.4,100,22,15,"PAH",26,1,88,0)="  YTALUSE                 N/A                 744349         31"
^DIC(9.4,100,22,15,"PAH",26,1,89,0)="  YTDOMR                  N/A               11177067         31"
^DIC(9.4,100,22,15,"PAH",26,1,90,0)="  YTDOMR1                 N/A                4728910         31"
^DIC(9.4,100,22,15,"PAH",26,1,91,0)="  YTMMPI2B           14737364               15991750         10,31"
^DIC(9.4,100,22,15,"PAH",26,1,92,0)="  "
^DIC(9.4,100,22,15,"PAH",26,1,93,0)="  SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",26,1,94,0)="  ==================="
^DIC(9.4,100,22,15,"PAH",26,1,95,0)="  The software files are available on one of the following CIO Field Offices'"
^DIC(9.4,100,22,15,"PAH",26,1,96,0)="  ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",26,1,97,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,98,0)="  All sites are encouraged to use their FTP capability to obtain these "
^DIC(9.4,100,22,15,"PAH",26,1,99,0)="  files."
^DIC(9.4,100,22,15,"PAH",26,1,100,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,101,0)="      IRM FIELD OFFICE     FTP ADDRESS        DIRECTORY"
^DIC(9.4,100,22,15,"PAH",26,1,102,0)="      ================     ===========        ========="
^DIC(9.4,100,22,15,"PAH",26,1,103,0)="      ALBANY               152.127.1.5        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",26,1,104,0)="      HINES                152.129.1.110      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",26,1,105,0)="      SALT LAKE            152.131.2.1        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",26,1,106,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,107,0)="  The software can be found in a file named MH_501_31.KID."
^DIC(9.4,100,22,15,"PAH",26,1,108,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,109,0)="  Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",26,1,110,0)="  =========================="
^DIC(9.4,100,22,15,"PAH",26,1,111,0)="  This patch should be installed during 'OFF PEAK' hours when few or no users"
^DIC(9.4,100,22,15,"PAH",26,1,112,0)="  are on the system.  Installation of the patch will take less than 5 minutes."
^DIC(9.4,100,22,15,"PAH",26,1,113,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,114,0)="  1.  START UP KIDS"
^DIC(9.4,100,22,15,"PAH",26,1,115,0)="      From the KERNEL Installation and Distribution Systems (KIDS)"
^DIC(9.4,100,22,15,"PAH",26,1,116,0)="      Menu, select the Installation menu [XPD INSTALLATION MENU]:  "
^DIC(9.4,100,22,15,"PAH",26,1,117,0)="         Installation"
^DIC(9.4,100,22,15,"PAH",26,1,118,0)="         Edits and Distribution ..."
^DIC(9.4,100,22,15,"PAH",26,1,119,0)="         Utilities ..."
^DIC(9.4,100,22,15,"PAH",26,1,120,0)="         Installation ..."
^DIC(9.4,100,22,15,"PAH",26,1,121,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,122,0)="  2.  SELECT INSTALLATION OPTION"
^DIC(9.4,100,22,15,"PAH",26,1,123,0)="      Select Installation Option:  Load a Distribution"
^DIC(9.4,100,22,15,"PAH",26,1,124,0)="      Enter a Host File: MH_501_31.KID"
^DIC(9.4,100,22,15,"PAH",26,1,125,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,126,0)="      This Distribution contains Transport Globals for the following"
^DIC(9.4,100,22,15,"PAH",26,1,127,0)="      Package(s):"
^DIC(9.4,100,22,15,"PAH",26,1,128,0)="         YS*5.01*31"
^DIC(9.4,100,22,15,"PAH",26,1,129,0)="      Use INSTALL NAME: YS*5.01*31 to install the Distribution."
^DIC(9.4,100,22,15,"PAH",26,1,130,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,131,0)="      NOTE:  The following are OPTIONAL:"
^DIC(9.4,100,22,15,"PAH",26,1,132,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,133,0)="      a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,100,22,15,"PAH",26,1,134,0)="          message of any routines exported with this patch. It will not"
^DIC(9.4,100,22,15,"PAH",26,1,135,0)="          backup any other changes, such as DDs or templates."
^DIC(9.4,100,22,15,"PAH",26,1,136,0)="      b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,100,22,15,"PAH",26,1,137,0)="          allow you to view all changes that will be made when this patch"
^DIC(9.4,100,22,15,"PAH",26,1,138,0)="          is installed.  It compares all components of this patch"
^DIC(9.4,100,22,15,"PAH",26,1,139,0)="          (routines, DDs, templates, etc.)."
^DIC(9.4,100,22,15,"PAH",26,1,140,0)="      c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,100,22,15,"PAH",26,1,141,0)="          you to ensure the integrity of the routines that are in the"
^DIC(9.4,100,22,15,"PAH",26,1,142,0)="          transport global."
^DIC(9.4,100,22,15,"PAH",26,1,143,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,144,0)="  3.  SELECT INSTALLATION OPTION: Install Package(s)"
^DIC(9.4,100,22,15,"PAH",26,1,145,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,146,0)="      Select KIDS OPTION:  INSTALL PACKAGE(S)"
^DIC(9.4,100,22,15,"PAH",26,1,147,0)="      Select INSTALL NAME: YS*5.01*31"
^DIC(9.4,100,22,15,"PAH",26,1,148,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,149,0)="  4.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,100,22,15,"PAH",26,1,150,0)="      Protocols? YES//, respond  NO"
^DIC(9.4,100,22,15,"PAH",26,1,151,0)=" "
^DIC(9.4,100,22,15,"PAH",26,1,152,0)="  5.  Delete routines YS31POST and YS31ENV."
^DIC(9.4,100,22,15,"PAH",27,0)="51 SEQ #46^2990803^1"
^DIC(9.4,100,22,15,"PAH",28,0)="52 SEQ #47^2990914^1"
^DIC(9.4,100,22,15,"PAH",29,0)="49 SEQ #48^2991003^1"
^DIC(9.4,100,22,15,"PAH",29,1,0)="^^13^13^2991003"
^DIC(9.4,100,22,15,"PAH",29,1,1,0)="Patch YS*5.01*49 has been created to perform the following functions:"
^DIC(9.4,100,22,15,"PAH",29,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",29,1,3,0)="1)  Evaluate all Global Assessment of Functioning (GAF) data for fiscal"
^DIC(9.4,100,22,15,"PAH",29,1,4,0)="    years 1998 & 1999, and verify that all necessary pieces of information"
^DIC(9.4,100,22,15,"PAH",29,1,5,0)="    exist for each record."
^DIC(9.4,100,22,15,"PAH",29,1,6,0)="2)  Retransmit all GAF scores for Fiscal Years 1998 & 1999 to the National"
^DIC(9.4,100,22,15,"PAH",29,1,7,0)="    Patient Care Database (NPCD) at the Austin Automated Center (AAC)."
^DIC(9.4,100,22,15,"PAH",29,1,8,0)="3)  Correct a filing error in the Mental Health ENTER DIAGNOSE [YSDIAGE]"
^DIC(9.4,100,22,15,"PAH",29,1,9,0)="    menu option."
^DIC(9.4,100,22,15,"PAH",29,1,10,0)="4)  Correct problem with the PATSTAT^YSDX3B call that returns the patient"
^DIC(9.4,100,22,15,"PAH",29,1,11,0)="    status (In-patient or Out-patient.)"
^DIC(9.4,100,22,15,"PAH",29,1,12,0)="5)  Correct an undefined error occurring in menu option GAF CASE FINDER [YSGAF"
^DIC(9.4,100,22,15,"PAH",29,1,13,0)="    CASE FINDER]."
^DIC(9.4,100,22,15,"PAH",30,0)="56^2991213^1"
^DIC(9.4,100,22,15,"PAH",31,0)="53 SEQ #49^3000204^1"
^DIC(9.4,100,22,15,"PAH",31,1,0)="^^410^410^3000204"
^DIC(9.4,100,22,15,"PAH",31,1,1,0)="Seven new Psychological Testing APIs/RPCs have been developed to allow reading "
^DIC(9.4,100,22,15,"PAH",31,1,2,0)="and saving of psychological testing data. This data normally resides in the "
^DIC(9.4,100,22,15,"PAH",31,1,3,0)="PSYCH INSTRUMENT PATIENT file (#601.2) for patient responses and the"
^DIC(9.4,100,22,15,"PAH",31,1,4,0)="MH INSTRUMENT file (#601) for test and interviews.  In addition, the"
^DIC(9.4,100,22,15,"PAH",31,1,5,0)="APIs/RPCs retrieve ADDICTION SEVERITY INDEX data found in the ADDICTION"
^DIC(9.4,100,22,15,"PAH",31,1,6,0)="SEVERITY INDEX file (#604) and Global Assessment of Functioning (GAF) data"
^DIC(9.4,100,22,15,"PAH",31,1,7,0)="found in the DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8)."
^DIC(9.4,100,22,15,"PAH",31,1,8,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,9,0)="This patch contains:"
^DIC(9.4,100,22,15,"PAH",31,1,10,0)="       one new file MH MULTIPLE SCORING (#601.6).  This file allows the"
^DIC(9.4,100,22,15,"PAH",31,1,11,0)="       user to score multiple instruments."
^DIC(9.4,100,22,15,"PAH",31,1,12,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,13,0)="       eleven new routines YSGAFAPI, YSMTI, YSMTI0, YSMTI1, YSMTI3"
^DIC(9.4,100,22,15,"PAH",31,1,14,0)="       YSMTI4, YSMTI5, YTAPI, YTAPI1, YTAPI2 and YTAPI3."
^DIC(9.4,100,22,15,"PAH",31,1,15,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,16,0)="       one new option Multiple Psych Testing [YT MTI] displays history of"
^DIC(9.4,100,22,15,"PAH",31,1,17,0)="       psychological testing for an individual patient."
^DIC(9.4,100,22,15,"PAH",31,1,18,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,19,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,20,0)="Documentation for APIs and RPCs"
^DIC(9.4,100,22,15,"PAH",31,1,21,0)="-------------------------------"
^DIC(9.4,100,22,15,"PAH",31,1,22,0)="1. LISTALL"
^DIC(9.4,100,22,15,"PAH",31,1,23,0)="       RPC: YTAPI LISTALL"
^DIC(9.4,100,22,15,"PAH",31,1,24,0)="         M: LISTALL^YTAPI"
^DIC(9.4,100,22,15,"PAH",31,1,25,0)="This API returns all psychological test administrations for a specified "
^DIC(9.4,100,22,15,"PAH",31,1,26,0)="patient during a specified time period. No scoring is returned."
^DIC(9.4,100,22,15,"PAH",31,1,27,0)="               "
^DIC(9.4,100,22,15,"PAH",31,1,28,0)="Input: "
^DIC(9.4,100,22,15,"PAH",31,1,29,0)="      DFN : Patient internal identifier"
^DIC(9.4,100,22,15,"PAH",31,1,30,0)="     BEGIN: Inclusive date in %DT acceptable format (11/11/2011) "
^DIC(9.4,100,22,15,"PAH",31,1,31,0)="            to begin search [optional]"
^DIC(9.4,100,22,15,"PAH",31,1,32,0)="       END: Inclusive date in %DT acceptable format (11/11/2011) "
^DIC(9.4,100,22,15,"PAH",31,1,33,0)="            to end search  [optional]"
^DIC(9.4,100,22,15,"PAH",31,1,34,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,35,0)="Output:"
^DIC(9.4,100,22,15,"PAH",31,1,36,0)="Array= internal administration date^external administration date^test code "
^DIC(9.4,100,22,15,"PAH",31,1,37,0)="Data is sorted in order of most recent administration to the oldest"
^DIC(9.4,100,22,15,"PAH",31,1,38,0)="administration. If no administrations are f,ound Array(2) will not be "
^DIC(9.4,100,22,15,"PAH",31,1,39,0)="returned. If patient has no PSYCH INSTRUMENT PATIENT file (#601.2) data,"
^DIC(9.4,100,22,15,"PAH",31,1,40,0)="an error will be returned."
^DIC(9.4,100,22,15,"PAH",31,1,41,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,42,0)="Example:"
^DIC(9.4,100,22,15,"PAH",31,1,43,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,44,0)="-----"
^DIC(9.4,100,22,15,"PAH",31,1,45,0)="YS(""DFN"")=6"
^DIC(9.4,100,22,15,"PAH",31,1,46,0)="YS(""BEGIN"")=""10/01/89"""
^DIC(9.4,100,22,15,"PAH",31,1,47,0)="YS(""END"")=""06/08/1999"""
^DIC(9.4,100,22,15,"PAH",31,1,48,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,49,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,50,0)="------"
^DIC(9.4,100,22,15,"PAH",31,1,51,0)="YSDATA(1)=[DATA]  "
^DIC(9.4,100,22,15,"PAH",31,1,52,0)="YSDATA(2)=2901120^11/20/1990^AOR"
^DIC(9.4,100,22,15,"PAH",31,1,53,0)="YSDATA(3)=2900730^07/30/1990^ALCO"
^DIC(9.4,100,22,15,"PAH",31,1,54,0)="YSDATA(4)=2900730^07/30/1990^HX2"
^DIC(9.4,100,22,15,"PAH",31,1,55,0)="YSDATA(5)=2900730^07/30/1990^MROS"
^DIC(9.4,100,22,15,"PAH",31,1,56,0)="YSDATA(6)=2900730^07/30/1990^PSOC"
^DIC(9.4,100,22,15,"PAH",31,1,57,0)="YSDATA(7)=2900730^07/30/1990^TRMT"
^DIC(9.4,100,22,15,"PAH",31,1,58,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,59,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,60,0)="2. LISTONE"
^DIC(9.4,100,22,15,"PAH",31,1,61,0)="       RPC: YTAPI LISTONE"
^DIC(9.4,100,22,15,"PAH",31,1,62,0)="         M: LISTONE^YTAPI"
^DIC(9.4,100,22,15,"PAH",31,1,63,0)="an error will be returned."
^DIC(9.4,100,22,15,"PAH",31,1,64,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,65,0)="Example: "
^DIC(9.4,100,22,15,"PAH",31,1,66,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,67,0)="-----"
^DIC(9.4,100,22,15,"PAH",31,1,68,0)="YS(""DFN"")=83"
^DIC(9.4,100,22,15,"PAH",31,1,69,0)="YS(""CODE"")=MMPI2"
^DIC(9.4,100,22,15,"PAH",31,1,70,0)="YS(""SCALE"")=2"
^DIC(9.4,100,22,15,"PAH",31,1,71,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,72,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,73,0)="------"
^DIC(9.4,100,22,15,"PAH",31,1,74,0)="YSDATA(1)=[DATA]"
^DIC(9.4,100,22,15,"PAH",31,1,75,0)="YSDATA(2)=2940509^05/09/1994^MMPI2^F Infrequency^19^95"
^DIC(9.4,100,22,15,"PAH",31,1,76,0)="YSDATA(3)=2920925^09/25/1992^MMPI2^F Infrequency^26^116"
^DIC(9.4,100,22,15,"PAH",31,1,77,0)="YSDATA(4)=2920924^09/24/1992^MMPI2^F Infrequency^25^113"
^DIC(9.4,100,22,15,"PAH",31,1,78,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,79,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,80,0)="3. SCOREIT"
^DIC(9.4,100,22,15,"PAH",31,1,81,0)="       RPC: YTAPI SCOREIT"
^DIC(9.4,100,22,15,"PAH",31,1,82,0)="         M: SCOREIT^YTAPI2"
^DIC(9.4,100,22,15,"PAH",31,1,83,0)="This API returns all scoring information for a specified patient given a "
^DIC(9.4,100,22,15,"PAH",31,1,84,0)="specified administration date for a specified test or instrument.  User "
^DIC(9.4,100,22,15,"PAH",31,1,85,0)="must have adequate privileges to receive this information (i.e. often the "
^DIC(9.4,100,22,15,"PAH",31,1,86,0)="YSP KEY)."
^DIC(9.4,100,22,15,"PAH",31,1,87,0)="       "
^DIC(9.4,100,22,15,"PAH",31,1,88,0)="Input: "
^DIC(9.4,100,22,15,"PAH",31,1,89,0)="      DFN : Patient internal identifier"
^DIC(9.4,100,22,15,"PAH",31,1,90,0)="      CODE: Test code from MH INSTRUMENT file (#601) or ""ASI"""
^DIC(9.4,100,22,15,"PAH",31,1,91,0)="            e.g. ""CAGE"", ""BDI"""
^DIC(9.4,100,22,15,"PAH",31,1,92,0)="     ADATE: Inclusive administration date in %DT acceptable format (11/11/2011)"
^DIC(9.4,100,22,15,"PAH",31,1,93,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,94,0)="Output:"
^DIC(9.4,100,22,15,"PAH",31,1,95,0)="Array(2)= Patient Name^Test Code^Test Title^Internal Admin date^External "
^DIC(9.4,100,22,15,"PAH",31,1,96,0)="Admin Date ^Ordered by"
^DIC(9.4,100,22,15,"PAH",31,1,97,0)="Array(3)=R1^Responses 1-200 undelimited"
^DIC(9.4,100,22,15,"PAH",31,1,98,0)="Array(4)=R2^ Responses 201-400 undelimited (even if less than 200)"
^DIC(9.4,100,22,15,"PAH",31,1,99,0)="Array(5)=R3^ Responses 401-600 undelimited"
^DIC(9.4,100,22,15,"PAH",31,1,100,0)="Array(6)=S1^Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",31,1,101,0)="Array(7)=S2^ Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",31,1,102,0)="And onward as needed."
^DIC(9.4,100,22,15,"PAH",31,1,103,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,104,0)="Example: "
^DIC(9.4,100,22,15,"PAH",31,1,105,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,106,0)="-----"
^DIC(9.4,100,22,15,"PAH",31,1,107,0)="YS(""DFN"")=83"
^DIC(9.4,100,22,15,"PAH",31,1,108,0)="YS(""CODE"")=MMPI2"
^DIC(9.4,100,22,15,"PAH",31,1,109,0)="YS(""ADATE"")=05/09/1994"
^DIC(9.4,100,22,15,"PAH",31,1,110,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,111,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,112,0)="------"
^DIC(9.4,100,22,15,"PAH",31,1,113,0)="YSDATA(1)=[DATA]"
^DIC(9.4,100,22,15,"PAH",31,1,114,0)="YSDATA(2)=CAPP,ANDY W^MMPI2^--- Minnesota Multiphasic Personality Inventory-2 --"
^DIC(9.4,100,22,15,"PAH",31,1,115,0)="-^2940509^05/09/1994^CAULFIELD,MARY A"
^DIC(9.4,100,22,15,"PAH",31,1,116,0)="YSDATA(3)=R1^TTTFTTFTTTFTTFFFFFFTTFFFFFFFTFFFFFFFFFFFFFFFFFFFFFFTFFFFFFFFFFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,117,0)="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFTTTTTTFFFFFFFFFFFFFFFFFFFFFFFFFFFFFTTTTFFFTTFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,118,0)="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,119,0)="YSDATA(4)=R2^FFFFFFFFFFFFFFFFFFFFFFFFFTTTTTTTTTTTTTTTTFFFFFFFFFFFFFFFFFFFFFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,120,0)="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,121,0)="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFTTT"
^DIC(9.4,100,22,15,"PAH",31,1,122,0)="YSDATA(5)=R3^TTTTTTTTTTTTTTTTTTTTTTTFFFFFFFFFFFFFFFFFFFFTTFFFTFTFTFTFTFTFTFTFTFF"
^DIC(9.4,100,22,15,"PAH",31,1,123,0)="FTFTFTFTFTFTFTFTFTFTFTFTTFTFTFTFFFFTFFTFTFTFTFTFTFFTFTFTFTFTFFFFFFFFFFFFFFFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,124,0)="FFFFFFFFFFFFFFFFFFFF"
^DIC(9.4,100,22,15,"PAH",31,1,125,0)="YSDATA(6)=S1^L Lie^12^87"
^DIC(9.4,100,22,15,"PAH",31,1,126,0)="YSDATA(7)=S2^F Infrequency^19^95"
^DIC(9.4,100,22,15,"PAH",31,1,127,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,128,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,129,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,130,0)="YSDATA(89)=S84^Ma-S Hypomania, Subtle^10^50"
^DIC(9.4,100,22,15,"PAH",31,1,131,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,132,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,133,0)="4. SAVEIT"
^DIC(9.4,100,22,15,"PAH",31,1,134,0)="      RPC: YTAPI SAVEIT"
^DIC(9.4,100,22,15,"PAH",31,1,135,0)="       M: SAVEIT^YTAPI1"
^DIC(9.4,100,22,15,"PAH",31,1,136,0)="This API allows saving of patient responses to a test or interview in the"
^DIC(9.4,100,22,15,"PAH",31,1,137,0)="PSYCH INSTRUMENT PATIENT file (#601.2). The patient ien, the test code,"
^DIC(9.4,100,22,15,"PAH",31,1,138,0)="and administration date is required along with the responses. All responses"
^DIC(9.4,100,22,15,"PAH",31,1,139,0)="are checked for validity. No scoring is returned but successful addition"
^DIC(9.4,100,22,15,"PAH",31,1,140,0)="to the PSYCH INSTRUMENT PATIENT file (#601.2) is indicated."
^DIC(9.4,100,22,15,"PAH",31,1,141,0)="               "
^DIC(9.4,100,22,15,"PAH",31,1,142,0)="Input: "
^DIC(9.4,100,22,15,"PAH",31,1,143,0)="     DFN : Patient internal identifier"
^DIC(9.4,100,22,15,"PAH",31,1,144,0)="     CODE: Test code from file 601 or ""ASI"" e.g. ""CAGE"", ""BDI"""
^DIC(9.4,100,22,15,"PAH",31,1,145,0)="    ADATE: Inclusive administration date in %DT acceptable format (11/11/2011)"
^DIC(9.4,100,22,15,"PAH",31,1,146,0)="    Staff: DUZ of professional ordering the test"
^DIC(9.4,100,22,15,"PAH",31,1,147,0)="       R1: String of patient responses 1-200"
^DIC(9.4,100,22,15,"PAH",31,1,148,0)="       R2: String of patient responses 201-400 [as needed]"
^DIC(9.4,100,22,15,"PAH",31,1,149,0)="       R3: String of patient responses 401-600 [as needed]"
^DIC(9.4,100,22,15,"PAH",31,1,150,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,151,0)="Output:"
^DIC(9.4,100,22,15,"PAH",31,1,152,0)="Array(1)=[DATA] indicates successful call"
^DIC(9.4,100,22,15,"PAH",31,1,153,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,154,0)="Example:"
^DIC(9.4,100,22,15,"PAH",31,1,155,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,156,0)="-----"
^DIC(9.4,100,22,15,"PAH",31,1,157,0)="YS(""DFN"")=6"
^DIC(9.4,100,22,15,"PAH",31,1,158,0)="YS(""ADATE"")=""T"""
^DIC(9.4,100,22,15,"PAH",31,1,159,0)="YS(""CODE"")=""ZUNG"""
^DIC(9.4,100,22,15,"PAH",31,1,160,0)="YS(""STAFF"")=67"
^DIC(9.4,100,22,15,"PAH",31,1,161,0)="YS(""R1"")=""12121212121212121212"""
^DIC(9.4,100,22,15,"PAH",31,1,162,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,163,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,164,0)="------"
^DIC(9.4,100,22,15,"PAH",31,1,165,0)="YSDATA(1)=[DATA]"
^DIC(9.4,100,22,15,"PAH",31,1,166,0)="YSDATA(2)=saved "
^DIC(9.4,100,22,15,"PAH",31,1,167,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,168,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,169,0)="5. SHOWIT"
^DIC(9.4,100,22,15,"PAH",31,1,170,0)="      RPC: YTAPI SHOWIT"
^DIC(9.4,100,22,15,"PAH",31,1,171,0)="        M: SHOWIT^YTAPI3"
^DIC(9.4,100,22,15,"PAH",31,1,172,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,173,0)="This API returns the text, bottom, introduction and possible correct "
^DIC(9.4,100,22,15,"PAH",31,1,174,0)="responses for a specified test item in MH INSTRUMENT file (#601). It will"
^DIC(9.4,100,22,15,"PAH",31,1,175,0)="work only for tests as opposed to interviews or batteries. The ASI is"
^DIC(9.4,100,22,15,"PAH",31,1,176,0)="not supported."
^DIC(9.4,100,22,15,"PAH",31,1,177,0)="               "
^DIC(9.4,100,22,15,"PAH",31,1,178,0)="Input: "
^DIC(9.4,100,22,15,"PAH",31,1,179,0)="     CODE: Test code from in the MH INSTRUMENT file (#601) e.g. ""CAGE"", ""BDI"""
^DIC(9.4,100,22,15,"PAH",31,1,180,0)="     ITEM: A positive whole number between 1 and the highest item number"
^DIC(9.4,100,22,15,"PAH",31,1,181,0)="           for the specified test."
^DIC(9.4,100,22,15,"PAH",31,1,182,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,183,0)="Output:"
^DIC(9.4,100,22,15,"PAH",31,1,184,0)="Array(1)=[DATA] ;indicates successful  call"
^DIC(9.4,100,22,15,"PAH",31,1,185,0)="Array(2)=MMPI2 item: 1 ;SECOND LINE IS TEST CODE AND ITEM NUMBER"
^DIC(9.4,100,22,15,"PAH",31,1,186,0)="Array(3)=[BEGIN ITEM]; BEGINS EACH ITEM"
^DIC(9.4,100,22,15,"PAH",31,1,187,0)="Array(4)=MMPI2^1 ;CODE^ITEM NUMBER"
^DIC(9.4,100,22,15,"PAH",31,1,188,0)="Array(5)=[INTRO];HEADER ALWAYS PRESENT OPTIONALY FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,189,0)="Array(12)=[TEXT];HEADER ALWAYS PRESENT ALWAYS FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,190,0)="Array(14)=[BOTTOM];HEADER ALWAYS PRESENT OPTIONALY FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,191,0)="Array(18)=[RESPONSE];HEADER ALWAYS PRESENT ALWAYS FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,192,0)="Array(21)=[END ITEM]; ENDS EACH ITEM"
^DIC(9.4,100,22,15,"PAH",31,1,193,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,194,0)="Example:"
^DIC(9.4,100,22,15,"PAH",31,1,195,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,196,0)="-----"
^DIC(9.4,100,22,15,"PAH",31,1,197,0)="YS(""CODE"")=""MMPI2"""
^DIC(9.4,100,22,15,"PAH",31,1,198,0)="YS(""ITEM"")=1"
^DIC(9.4,100,22,15,"PAH",31,1,199,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,200,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,201,0)="------"
^DIC(9.4,100,22,15,"PAH",31,1,202,0)="YSDATA(1)=[DATA]"
^DIC(9.4,100,22,15,"PAH",31,1,203,0)="YSDATA(2)=[BEGIN ITEM]"
^DIC(9.4,100,22,15,"PAH",31,1,204,0)="YSDATA(3)=MMPI2^1"
^DIC(9.4,100,22,15,"PAH",31,1,205,0)="YSDATA(4)=[INTRO]"
^DIC(9.4,100,22,15,"PAH",31,1,206,0)="YSDATA(5)=Please read each statement carefully and decide whether it is true"
^DIC(9.4,100,22,15,"PAH",31,1,207,0)="YSDATA(6)=as applied to you or false as applied to you."
^DIC(9.4,100,22,15,"PAH",31,1,208,0)="YSDATA(7)= "
^DIC(9.4,100,22,15,"PAH",31,1,209,0)="YSDATA(8)=If a statement is true or mostly true, as applied to you, answer 'T'."
^DIC(9.4,100,22,15,"PAH",31,1,210,0)="YSDATA(9)=If a statement is false or not usually true, as applied to you, "
^DIC(9.4,100,22,15,"PAH",31,1,211,0)="answer"
^DIC(9.4,100,22,15,"PAH",31,1,212,0)="YSDATA(10)='F'."
^DIC(9.4,100,22,15,"PAH",31,1,213,0)="YSDATA(11)= "
^DIC(9.4,100,22,15,"PAH",31,1,214,0)="YSDATA(12)=Remember to give your own opinion of yourself."
^DIC(9.4,100,22,15,"PAH",31,1,215,0)="YSDATA(13)=[TEXT]"
^DIC(9.4,100,22,15,"PAH",31,1,216,0)="YSDATA(14)=I like mechanics magazines."
^DIC(9.4,100,22,15,"PAH",31,1,217,0)="YSDATA(15)=[BOTTOM]"
^DIC(9.4,100,22,15,"PAH",31,1,218,0)="YSDATA(16)=T= True"
^DIC(9.4,100,22,15,"PAH",31,1,219,0)="YSDATA(17)=F= False"
^DIC(9.4,100,22,15,"PAH",31,1,220,0)="YSDATA(18)=Answer= "
^DIC(9.4,100,22,15,"PAH",31,1,221,0)="YSDATA(19)=[RESPONSE]"
^DIC(9.4,100,22,15,"PAH",31,1,222,0)="YSDATA(20)=TFX"
^DIC(9.4,100,22,15,"PAH",31,1,223,0)="YSDATA(21)=[END ITEM]"
^DIC(9.4,100,22,15,"PAH",31,1,224,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,225,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,226,0)="6. SHOWALL"
^DIC(9.4,100,22,15,"PAH",31,1,227,0)="       RPC: YTAPI SHOWALL"
^DIC(9.4,100,22,15,"PAH",31,1,228,0)="         M: SHOWALL^YTAPI3"
^DIC(9.4,100,22,15,"PAH",31,1,229,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,230,0)="This API returns the text, bottom, introduction and possible correct "
^DIC(9.4,100,22,15,"PAH",31,1,231,0)="responses for all items in a test in the MH INSTRUMENT file (#601). It"
^DIC(9.4,100,22,15,"PAH",31,1,232,0)="will work only for tests as opposed to interviews or batteries."
^DIC(9.4,100,22,15,"PAH",31,1,233,0)="The ASI is not supported."
^DIC(9.4,100,22,15,"PAH",31,1,234,0)="               "
^DIC(9.4,100,22,15,"PAH",31,1,235,0)="Input: "
^DIC(9.4,100,22,15,"PAH",31,1,236,0)="     CODE: Test code from the MH INSTRUMENT file (#601).  e.g. ""CAGE"", ""BDI"""
^DIC(9.4,100,22,15,"PAH",31,1,237,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,238,0)="Output:"
^DIC(9.4,100,22,15,"PAH",31,1,239,0)="Array(1)=[DATA] ;indicates successful  call"
