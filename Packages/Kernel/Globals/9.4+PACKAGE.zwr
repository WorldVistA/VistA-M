^DIC(9.4,197,22,1,"PAH",28,1,124,0)="Pre/Post Installation Overview"
^DIC(9.4,197,22,1,"PAH",28,1,125,0)="------------------------------"
^DIC(9.4,197,22,1,"PAH",28,1,126,0)="There are no Pre/Post installation routines associated with this patch."
^DIC(9.4,197,22,1,"PAH",28,1,127,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,128,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,129,0)="Pre-Installation Instructions"
^DIC(9.4,197,22,1,"PAH",28,1,130,0)="-------------------------"
^DIC(9.4,197,22,1,"PAH",28,1,131,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,197,22,1,"PAH",28,1,132,0)="recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,197,22,1,"PAH",28,1,133,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,197,22,1,"PAH",28,1,134,0)="minutes to install."
^DIC(9.4,197,22,1,"PAH",28,1,135,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,136,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,137,0)="Installation Instructions"
^DIC(9.4,197,22,1,"PAH",28,1,138,0)="-----------------------------"
^DIC(9.4,197,22,1,"PAH",28,1,139,0)="1.      Choose the PackMan message containing this patch."
^DIC(9.4,197,22,1,"PAH",28,1,140,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,141,0)="2.      Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,197,22,1,"PAH",28,1,142,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,143,0)="3.      From the Kernel Installation and Distribution System Menu, select "
^DIC(9.4,197,22,1,"PAH",28,1,144,0)="        the Installation Menu.  From this menu, you may elect to use the "
^DIC(9.4,197,22,1,"PAH",28,1,145,0)="        following options. When prompted for the INSTALL NAME enter"
^DIC(9.4,197,22,1,"PAH",28,1,146,0)="        MD*1.0*42."
^DIC(9.4,197,22,1,"PAH",28,1,147,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,148,0)="        a.  Verify Checksums in Transport Global - This option will "
^DIC(9.4,197,22,1,"PAH",28,1,149,0)="            allow you to ensure the integrity of the routines that are in"
^DIC(9.4,197,22,1,"PAH",28,1,150,0)="            the transport global."
^DIC(9.4,197,22,1,"PAH",28,1,151,0)="        b.  Print Transport Global - This option will allow you to view"
^DIC(9.4,197,22,1,"PAH",28,1,152,0)="            the components of the KIDS build."
^DIC(9.4,197,22,1,"PAH",28,1,153,0)="        c.  Compare Transport Global to Current System - This option will"
^DIC(9.4,197,22,1,"PAH",28,1,154,0)="            allow you to view all changes that will be made when this "
^DIC(9.4,197,22,1,"PAH",28,1,155,0)="            patch is installed.  It compares all components of this patch"
^DIC(9.4,197,22,1,"PAH",28,1,156,0)="            (routines, DD's, templates, etc.)."
^DIC(9.4,197,22,1,"PAH",28,1,157,0)="        d.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,197,22,1,"PAH",28,1,158,0)="            message of any routines exported with this patch. It will not"
^DIC(9.4,197,22,1,"PAH",28,1,159,0)="            backup any other changes such as DD's or templates."
^DIC(9.4,197,22,1,"PAH",28,1,160,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,161,0)="4.      From the Installation Menu, select the Install Package(s) option "
^DIC(9.4,197,22,1,"PAH",28,1,162,0)="        and choose the patch to install."
^DIC(9.4,197,22,1,"PAH",28,1,163,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,164,0)="5.      When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,197,22,1,"PAH",28,1,165,0)="        Install? NO// Press <Enter>"
^DIC(9.4,197,22,1,"PAH",28,1,166,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,167,0)="6.      When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,197,22,1,"PAH",28,1,168,0)="        NO// Press <Enter>"
^DIC(9.4,197,22,1,"PAH",28,1,169,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,170,0)="7.      When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,197,22,1,"PAH",28,1,171,0)="        and Protocols? NO// Press <Enter>"
^DIC(9.4,197,22,1,"PAH",28,1,172,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,173,0)="8.      If prompted ""Delay Install (Minutes):  (0 - 60): 0// respond 0."
^DIC(9.4,197,22,1,"PAH",28,1,174,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,175,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,176,0)="Post-Installation Instructions"
^DIC(9.4,197,22,1,"PAH",28,1,177,0)="------------------------------"
^DIC(9.4,197,22,1,"PAH",28,1,178,0)="N/A"
^DIC(9.4,197,22,1,"PAH",28,1,179,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,180,0)=" "
