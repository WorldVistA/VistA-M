^DIC(9.4,35,22,3,"PAH",159,1,1,0)="Updates to Event Delayed Order code."
^DIC(9.4,35,22,3,"PAH",159,1,2,0)="See FORUM patch description for complete details."
^DIC(9.4,35,22,3,"PAH",160,0)="178 SEQ #163^3030417^1"
^DIC(9.4,35,22,3,"PAH",161,0)="175 SEQ #164^3030417^1"
^DIC(9.4,35,22,3,"PAH",161,1,0)="^^1^1^3030417"
^DIC(9.4,35,22,3,"PAH",161,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",162,0)="153 SEQ #165^3030430^1"
^DIC(9.4,35,22,3,"PAH",162,1,0)="^^59^59^3030430"
^DIC(9.4,35,22,3,"PAH",162,1,1,0)="Description:"
^DIC(9.4,35,22,3,"PAH",162,1,2,0)="==========="
^DIC(9.4,35,22,3,"PAH",162,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",162,1,4,0)="This patch provides server side updates for the CPRS Query Tool.  This"
^DIC(9.4,35,22,3,"PAH",162,1,5,0)="tool allows queries to be created for Orders, Documents, Appointments,"
^DIC(9.4,35,22,3,"PAH",162,1,6,0)="and Visits."
^DIC(9.4,35,22,3,"PAH",162,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",162,1,8,0)="ROUTINE SUMMARY:"
^DIC(9.4,35,22,3,"PAH",162,1,9,0)="================"
^DIC(9.4,35,22,3,"PAH",162,1,10,0)="The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,35,22,3,"PAH",162,1,11,0)="second line of each of these routine(s) will look like:"
^DIC(9.4,35,22,3,"PAH",162,1,12,0)="  "
^DIC(9.4,35,22,3,"PAH",162,1,13,0)="<tab>;;3.0;ORDER ENTRY/RESULTS REPORTING;**<patch list>**;Dec 17, 1997"
^DIC(9.4,35,22,3,"PAH",162,1,14,0)="  "
^DIC(9.4,35,22,3,"PAH",162,1,15,0)="                            CHECK^XTSUMBLD results"
^DIC(9.4,35,22,3,"PAH",162,1,16,0)=" Routine name         Before Patch      After Patch          Patch List"
^DIC(9.4,35,22,3,"PAH",162,1,17,0)=" ============         ============      ===========          =========="
^DIC(9.4,35,22,3,"PAH",162,1,18,0)=" ORMGMRC                                   12946666      3,26,68,92,153"
^DIC(9.4,35,22,3,"PAH",162,1,19,0)=" ORMLR                                     15500365            3,92,153"
^DIC(9.4,35,22,3,"PAH",162,1,20,0)=" ORMRA                                     16479106 3,53,92,110,136,153"
^DIC(9.4,35,22,3,"PAH",162,1,21,0)=" ORQRY                                     10982388                 153"
^DIC(9.4,35,22,3,"PAH",162,1,22,0)=" "
^DIC(9.4,35,22,3,"PAH",162,1,23,0)="Installation Instructions:"
^DIC(9.4,35,22,3,"PAH",162,1,24,0)="=========================="
^DIC(9.4,35,22,3,"PAH",162,1,25,0)=" "
^DIC(9.4,35,22,3,"PAH",162,1,26,0)="Installation of this patch will take less than 2 minutes.  Although"
^DIC(9.4,35,22,3,"PAH",162,1,27,0)="users need not be off the system when applying this patch, it should be"
^DIC(9.4,35,22,3,"PAH",162,1,28,0)="installed at a nonpeak time to minimize disruption to users."
^DIC(9.4,35,22,3,"PAH",162,1,29,0)="  "
^DIC(9.4,35,22,3,"PAH",162,1,30,0)=" 1.   Use the INSTALL/CHECK MESSAGE option on the Packman Menu, to "
^DIC(9.4,35,22,3,"PAH",162,1,31,0)="      load the KIDS Transport Distribution global.  "
^DIC(9.4,35,22,3,"PAH",162,1,32,0)="   "
^DIC(9.4,35,22,3,"PAH",162,1,33,0)=" 2.   Review your mapped set.  If any of the routines listed in the "
^DIC(9.4,35,22,3,"PAH",162,1,34,0)="      ROUTINE SUMMARY section are mapped, they should be removed "
^DIC(9.4,35,22,3,"PAH",162,1,35,0)="      from the mapped set at this time.  "
^DIC(9.4,35,22,3,"PAH",162,1,36,0)="   "
^DIC(9.4,35,22,3,"PAH",162,1,37,0)=" 3.   From the Kernel Installation and Distribution System (KIDS) Menu, "
^DIC(9.4,35,22,3,"PAH",162,1,38,0)="      select the Installation menu.  "
^DIC(9.4,35,22,3,"PAH",162,1,39,0)="   "
^DIC(9.4,35,22,3,"PAH",162,1,40,0)=" 4.   From the installation menu, you may elect to use the following "
^DIC(9.4,35,22,3,"PAH",162,1,41,0)="      options (when prompted for INSTALL NAME, enter OR*3.0*153): "
^DIC(9.4,35,22,3,"PAH",162,1,42,0)="   "
^DIC(9.4,35,22,3,"PAH",162,1,43,0)="      a.  Backup a Transport Global"
^DIC(9.4,35,22,3,"PAH",162,1,44,0)="      b.  Compare Transport Global to Current System"
^DIC(9.4,35,22,3,"PAH",162,1,45,0)="      c.  Verify Checksums in Transport Global"
^DIC(9.4,35,22,3,"PAH",162,1,46,0)="   "
^DIC(9.4,35,22,3,"PAH",162,1,47,0)=" 5.   Use the Install Package(s) option and select the package "
^DIC(9.4,35,22,3,"PAH",162,1,48,0)="      OR*3.0*153."
^DIC(9.4,35,22,3,"PAH",162,1,49,0)="  "
^DIC(9.4,35,22,3,"PAH",162,1,50,0)=" 6.   When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,35,22,3,"PAH",162,1,51,0)="      YES//', respond 'NO'."
^DIC(9.4,35,22,3,"PAH",162,1,52,0)="  "
^DIC(9.4,35,22,3,"PAH",162,1,53,0)=" 7.   When prompted 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,35,22,3,"PAH",162,1,54,0)="      Options, and Protocols? YES//', respond 'YES', and disable"
^DIC(9.4,35,22,3,"PAH",162,1,55,0)="      OR* Options and Protocols."
^DIC(9.4,35,22,3,"PAH",162,1,56,0)="  "
^DIC(9.4,35,22,3,"PAH",162,1,57,0)=" 8.   If routines were unmapped as part of step 2, they should "
^DIC(9.4,35,22,3,"PAH",162,1,58,0)="      be returned to the mapped set once the installation has "
^DIC(9.4,35,22,3,"PAH",162,1,59,0)="      run to completion."
^DIC(9.4,35,22,3,"PAH",163,0)="185 SEQ #166^3030520^1"
