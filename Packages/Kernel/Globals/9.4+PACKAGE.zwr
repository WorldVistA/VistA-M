^DIC(9.4,47,22,5.9,"PAH",567,1,0)="^^3^3^3070627"
^DIC(9.4,47,22,5.9,"PAH",567,1,1,0)="  This patch resolves problems related to the patient's address, the "
^DIC(9.4,47,22,5.9,"PAH",567,1,2,0)="emergency contact work phone, the principal investigator report, "
^DIC(9.4,47,22,5.9,"PAH",567,1,3,0)="and the patient name change bulletin."
^DIC(9.4,47,22,5.9,"PAH",568,0)="732 SEQ #655^3070629.19203^1"
