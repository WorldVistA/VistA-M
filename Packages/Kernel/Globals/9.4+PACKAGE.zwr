^DIC(9.4,13,22,8,"PAH",12,1,96,0)="    10.  Enable users' login."
^DIC(9.4,13,22,8,"PAH",13,0)="22 SEQ #13^2991210^1"
^DIC(9.4,13,22,8,"PAH",13,1,0)="^^98^98^2991210"
^DIC(9.4,13,22,8,"PAH",13,1,1,0)="This patch fixes the following problem: If a new-style cross-reference is"
^DIC(9.4,13,22,8,"PAH",13,1,2,0)="defined on a field, ^DIE or FileMan's 'ENTER OR EDIT FILE ENTRIES' is"
^DIC(9.4,13,22,8,"PAH",13,1,3,0)="used to edit a multiple field and the field with the new-style"
^DIC(9.4,13,22,8,"PAH",13,1,4,0)="cross-reference, then the X1 array (which contains the old values of the"
^DIC(9.4,13,22,8,"PAH",13,1,5,0)="fields in the cross-references) may be set incorrectly after the user"
^DIC(9.4,13,22,8,"PAH",13,1,6,0)="descends into and back out of the multiple."
^DIC(9.4,13,22,8,"PAH",13,1,7,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,8,0)="For example, suppose MFIELD is a multiple field, a new-style"
^DIC(9.4,13,22,8,"PAH",13,1,9,0)="cross-reference contains field MFIELD1, and you edit the fields as"
^DIC(9.4,13,22,8,"PAH",13,1,10,0)="follows:"
^DIC(9.4,13,22,8,"PAH",13,1,11,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,12,0)="  Select MFIELD: ENTRY 1// <RET>"
^DIC(9.4,13,22,8,"PAH",13,1,13,0)="    MFIELD1: TEST 1// <RET>"
^DIC(9.4,13,22,8,"PAH",13,1,14,0)="  Select MFIELD: <RET>"
^DIC(9.4,13,22,8,"PAH",13,1,15,0)="  FIELD1: first// second"
^DIC(9.4,13,22,8,"PAH",13,1,16,0)="  "
^DIC(9.4,13,22,8,"PAH",13,1,17,0)="When the new-style cross reference on FIELD1 is executed, X1 and X1(1)"
^DIC(9.4,13,22,8,"PAH",13,1,18,0)="contain 'second' instead of 'first'."
^DIC(9.4,13,22,8,"PAH",13,1,19,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,20,0)="Y2K Waiver ID#:    Y2KW0001"
^DIC(9.4,13,22,8,"PAH",13,1,21,0)="Y2K Waiver Status: Approved"
^DIC(9.4,13,22,8,"PAH",13,1,22,0)="==========================="
^DIC(9.4,13,22,8,"PAH",13,1,23,0)="     *  This patch may be installed during the Y2K Moratorium, either"
^DIC(9.4,13,22,8,"PAH",13,1,24,0)="        BEFORE 12/15/99 or AFTER 1/15/2000."
^DIC(9.4,13,22,8,"PAH",13,1,25,0)="     *  This patch MAY NOT be installed between 12/15/1999 and 1/15/2000"
^DIC(9.4,13,22,8,"PAH",13,1,26,0)="        (the Y2K Lockdown Period)."
^DIC(9.4,13,22,8,"PAH",13,1,27,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,28,0)="NOIS"
^DIC(9.4,13,22,8,"PAH",13,1,29,0)="===="
^DIC(9.4,13,22,8,"PAH",13,1,30,0)="ISA-1199-12633"
^DIC(9.4,13,22,8,"PAH",13,1,31,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,32,0)="Routine Summary:"
^DIC(9.4,13,22,8,"PAH",13,1,33,0)="==============="
^DIC(9.4,13,22,8,"PAH",13,1,34,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,8,"PAH",13,1,35,0)="these routines now look like:"
^DIC(9.4,13,22,8,"PAH",13,1,36,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,37,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999"
^DIC(9.4,13,22,8,"PAH",13,1,38,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,39,0)="CHECK^XTSUMBLD results:"
^DIC(9.4,13,22,8,"PAH",13,1,40,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,41,0)="  Routine Name    Before Patch    After Patch    Patch List "
^DIC(9.4,13,22,8,"PAH",13,1,42,0)="  ============    ============    ===========    =========="
^DIC(9.4,13,22,8,"PAH",13,1,43,0)="  DIKC              11836728       11879894         1,22"
^DIC(9.4,13,22,8,"PAH",13,1,44,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,45,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,46,0)="Installation Instructions:"
^DIC(9.4,13,22,8,"PAH",13,1,47,0)="=========================="
^DIC(9.4,13,22,8,"PAH",13,1,48,0)=" ***********************************************************************"
^DIC(9.4,13,22,8,"PAH",13,1,49,0)=" *  It is HIGHLY recommended that ALL Users and VISTA Background jobs  *"
^DIC(9.4,13,22,8,"PAH",13,1,50,0)=" *  be STOPPED. Failure to do so may result in a 'source routine       *"
^DIC(9.4,13,22,8,"PAH",13,1,51,0)=" *  edited' error. Edits will be lost and records may be left in an    *"
^DIC(9.4,13,22,8,"PAH",13,1,52,0)=" *  inconsistent state.                                                *"
^DIC(9.4,13,22,8,"PAH",13,1,53,0)=" ***********************************************************************"
^DIC(9.4,13,22,8,"PAH",13,1,54,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,55,0)="     1.  AXP sites: Review your mapped routine set. If any of the"
^DIC(9.4,13,22,8,"PAH",13,1,56,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, they should"
^DIC(9.4,13,22,8,"PAH",13,1,57,0)="be removed from the mapped set at this time."
^DIC(9.4,13,22,8,"PAH",13,1,58,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,59,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,8,"PAH",13,1,60,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,8,"PAH",13,1,61,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,62,0)="         The Environment Check Routine DIENVWRN will run automatically."
^DIC(9.4,13,22,8,"PAH",13,1,63,0)="Routine DIENVWRN is sent in order to prevent inadvertent queuing during"
^DIC(9.4,13,22,8,"PAH",13,1,64,0)="the installation of this patch."
^DIC(9.4,13,22,8,"PAH",13,1,65,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,66,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,8,"PAH",13,1,67,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",13,1,68,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,69,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",13,1,70,0)="following options: "
^DIC(9.4,13,22,8,"PAH",13,1,71,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,72,0)="            Print Transport Global"
^DIC(9.4,13,22,8,"PAH",13,1,73,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,8,"PAH",13,1,74,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,8,"PAH",13,1,75,0)="            Backup a Transport Global"
^DIC(9.4,13,22,8,"PAH",13,1,76,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,77,0)="     5.  Inhibit users from login into the system."
^DIC(9.4,13,22,8,"PAH",13,1,78,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,79,0)="     6.  AXP Sites - Place TaskMan in a WAIT State."
^DIC(9.4,13,22,8,"PAH",13,1,80,0)="         OpenM/Cache Sites - STOP TaskMan.   "
^DIC(9.4,13,22,8,"PAH",13,1,81,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,82,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",13,1,83,0)="following option:"
^DIC(9.4,13,22,8,"PAH",13,1,84,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,85,0)="            Select Installation Option: Install Package(s)"
^DIC(9.4,13,22,8,"PAH",13,1,86,0)="            Select INSTALL NAME: DI*22.0*22"
^DIC(9.4,13,22,8,"PAH",13,1,87,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",13,1,88,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,89,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,8,"PAH",13,1,90,0)="and Protocols?"
^DIC(9.4,13,22,8,"PAH",13,1,91,0)="        "
^DIC(9.4,13,22,8,"PAH",13,1,92,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,8,"PAH",13,1,93,0)="set, if necessary."
^DIC(9.4,13,22,8,"PAH",13,1,94,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,95,0)="     9.  AXP Sites - Remove TaskMan from WAIT State."
^DIC(9.4,13,22,8,"PAH",13,1,96,0)="         OpenM/Cache Sites - Restart TaskMan."
^DIC(9.4,13,22,8,"PAH",13,1,97,0)=" "
^DIC(9.4,13,22,8,"PAH",13,1,98,0)="    10.  Enable users' login."
^DIC(9.4,13,22,8,"PAH",14,0)="23 SEQ #14^2991220^1"
^DIC(9.4,13,22,8,"PAH",14,1,0)="^^80^80^2991220"
^DIC(9.4,13,22,8,"PAH",14,1,1,0)="Bug Fixes"
^DIC(9.4,13,22,8,"PAH",14,1,2,0)="========="
^DIC(9.4,13,22,8,"PAH",14,1,3,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,4,0)="1.  An error of <SUBSCRIPT>HDR^DIO4:3 would occurr if the following"
^DIC(9.4,13,22,8,"PAH",14,1,5,0)="conditions were true:"
^DIC(9.4,13,22,8,"PAH",14,1,6,0)=" A.  After Sorting there were No Records To Be Printed."
^DIC(9.4,13,22,8,"PAH",14,1,7,0)=" and"
^DIC(9.4,13,22,8,"PAH",14,1,8,0)=" B.  If the Header was a Print Template that contained Fields that were to"
^DIC(9.4,13,22,8,"PAH",14,1,9,0)="be printed."
^DIC(9.4,13,22,8,"PAH",14,1,10,0)=" Nois: SPO-1299-50519; BRX-1299-10679; SUX-1299-40851; DUB-1299-31316"
^DIC(9.4,13,22,8,"PAH",14,1,11,0)=" Routine: DIO0"
^DIC(9.4,13,22,8,"PAH",14,1,12,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,13,0)="2.  During SQA it was also found that If you answer:"
^DIC(9.4,13,22,8,"PAH",14,1,14,0)=" HEADING: TEST LIST //  [<sp>"
^DIC(9.4,13,22,8,"PAH",14,1,15,0)=" where you are telling FileMan to use the space-bar retrieval of the"
^DIC(9.4,13,22,8,"PAH",14,1,16,0)="Template previously named, FileMan would use the ""["" as the header."
^DIC(9.4,13,22,8,"PAH",14,1,17,0)=" Routine: DIP3"
^DIC(9.4,13,22,8,"PAH",14,1,18,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,19,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,20,0)="NOISes "
^DIC(9.4,13,22,8,"PAH",14,1,21,0)="======"
^DIC(9.4,13,22,8,"PAH",14,1,22,0)=" SPO-1299-50519"
^DIC(9.4,13,22,8,"PAH",14,1,23,0)=" BRX-1299-10679"
^DIC(9.4,13,22,8,"PAH",14,1,24,0)=" SUX-1299-40851"
^DIC(9.4,13,22,8,"PAH",14,1,25,0)=" DUB-1299-31316"
^DIC(9.4,13,22,8,"PAH",14,1,26,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,27,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",14,1,28,0)="===================="
^DIC(9.4,13,22,8,"PAH",14,1,29,0)=" Spokane, WA"
^DIC(9.4,13,22,8,"PAH",14,1,30,0)=" Bronx, NY"
^DIC(9.4,13,22,8,"PAH",14,1,31,0)=" Sioux Falls, SD"
^DIC(9.4,13,22,8,"PAH",14,1,32,0)=" Dublin, GA"
^DIC(9.4,13,22,8,"PAH",14,1,33,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,34,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",14,1,35,0)="================"
^DIC(9.4,13,22,8,"PAH",14,1,36,0)=" The following routines are included in this patch.  The second line of "
^DIC(9.4,13,22,8,"PAH",14,1,37,0)="these routines now look like: "
^DIC(9.4,13,22,8,"PAH",14,1,38,0)="  "
^DIC(9.4,13,22,8,"PAH",14,1,39,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",14,1,40,0)="  "
^DIC(9.4,13,22,8,"PAH",14,1,41,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",14,1,42,0)="  "
^DIC(9.4,13,22,8,"PAH",14,1,43,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",14,1,44,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",14,1,45,0)="  DIO0           9464280         9610303         2,23"
^DIC(9.4,13,22,8,"PAH",14,1,46,0)="  DIP3           10828796        10830710        23"
^DIC(9.4,13,22,8,"PAH",14,1,47,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,48,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",14,1,49,0)="=========================="
^DIC(9.4,13,22,8,"PAH",14,1,50,0)="This patch can be installed with VISTA users online.  However, it is "
^DIC(9.4,13,22,8,"PAH",14,1,51,0)="recommended that it be Queued for a time of generally least activity.  "
^DIC(9.4,13,22,8,"PAH",14,1,52,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,53,0)="     1.  AXP sites: Review your mapped routine set.  If any of the "
^DIC(9.4,13,22,8,"PAH",14,1,54,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, they "
^DIC(9.4,13,22,8,"PAH",14,1,55,0)="should be removed from the mapped set at this time.  "
^DIC(9.4,13,22,8,"PAH",14,1,56,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,57,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  "
^DIC(9.4,13,22,8,"PAH",14,1,58,0)="This option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,8,"PAH",14,1,59,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,60,0)="     3.  The patch has now been loaded into a transport global on your "
^DIC(9.4,13,22,8,"PAH",14,1,61,0)="system. You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,8,"PAH",14,1,62,0)="  "
^DIC(9.4,13,22,8,"PAH",14,1,63,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,8,"PAH",14,1,64,0)="following options: "
^DIC(9.4,13,22,8,"PAH",14,1,65,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",14,1,66,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",14,1,67,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",14,1,68,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",14,1,69,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,70,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,8,"PAH",14,1,71,0)="following option: "
^DIC(9.4,13,22,8,"PAH",14,1,72,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",14,1,73,0)="            Select INSTALL NAME: DI*22.0*23"
^DIC(9.4,13,22,8,"PAH",14,1,74,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",14,1,75,0)="  "
^DIC(9.4,13,22,8,"PAH",14,1,76,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,13,22,8,"PAH",14,1,77,0)="Options, and Protocols? "
^DIC(9.4,13,22,8,"PAH",14,1,78,0)=" "
^DIC(9.4,13,22,8,"PAH",14,1,79,0)="     6.  AXP Sites - After the patch has been installed, rebuild your "
^DIC(9.4,13,22,8,"PAH",14,1,80,0)="map set, if necessary.  "
^DIC(9.4,13,22,8,"PAH",15,0)="27 SEQ #15^3000125^1"
^DIC(9.4,13,22,8,"PAH",15,1,0)="^^2^2^3000125"
^DIC(9.4,13,22,8,"PAH",15,1,1,0)="See patch DI*22*27 in the National Patch Module for complete information"
^DIC(9.4,13,22,8,"PAH",15,1,2,0)="on this patch."
^DIC(9.4,13,22,8,"PAH",16,0)="24 SEQ #16^3000204^1"
^DIC(9.4,13,22,8,"PAH",16,1,0)="^^2^2^3000204"
^DIC(9.4,13,22,8,"PAH",16,1,1,0)="See patch DI*22*24 in the National Patch Module for complete information"
^DIC(9.4,13,22,8,"PAH",16,1,2,0)="on this patch."
^DIC(9.4,13,22,8,"PAH",17,0)="25 SEQ #17^3000204^1"
^DIC(9.4,13,22,8,"PAH",17,1,0)="^^2^2^3000204"
^DIC(9.4,13,22,8,"PAH",17,1,1,0)="See patch DI*22*25 in the National Patch Module for complete information"
^DIC(9.4,13,22,8,"PAH",17,1,2,0)="on this patch."
^DIC(9.4,13,22,8,"PAH",18,0)="20 SEQ #18^3000204^1"
^DIC(9.4,13,22,8,"PAH",18,1,0)="^^219^219^3000204"
^DIC(9.4,13,22,8,"PAH",18,1,1,0)="Fixes several bugs in the FileMan lookup ^DIC routines and the finder"
^DIC(9.4,13,22,8,"PAH",18,1,2,0)="FIND^DIC."
^DIC(9.4,13,22,8,"PAH",18,1,3,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,4,0)="Y2K Waiver ID#:  Y2KW0001               Y2K Waiver Status: Approved"
^DIC(9.4,13,22,8,"PAH",18,1,5,0)=" => This patch MAY NOT be installed between 12/15/1999 and 1/15/2000"
^DIC(9.4,13,22,8,"PAH",18,1,6,0)="    (the Y2K Lockdown Period)."
^DIC(9.4,13,22,8,"PAH",18,1,7,0)=" => This patch may be installed during the Y2K Moratorium"
^DIC(9.4,13,22,8,"PAH",18,1,8,0)="    - AFTER 1/15/2000."
^DIC(9.4,13,22,8,"PAH",18,1,9,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,10,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,11,0)="Routines: DIC1, DIC2, DIC5 "
^DIC(9.4,13,22,8,"PAH",18,1,12,0)="=========================="
^DIC(9.4,13,22,8,"PAH",18,1,13,0)="When the ""T"" flag in DIC(0) is used, FileMan displays the field on which a "
^DIC(9.4,13,22,8,"PAH",18,1,14,0)="match is made, as it presents the entries. This was happening even when DIC(0)"
^DIC(9.4,13,22,8,"PAH",18,1,15,0)="did not contain ""E"". This patch prevents the display unless DIC(0) contains"
^DIC(9.4,13,22,8,"PAH",18,1,16,0)="""E"".   (Found by Gary Beuschel, MailMan developer)."
^DIC(9.4,13,22,8,"PAH",18,1,17,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,18,0)="Routines: DIC3, DICF, DICF2, DICL2"
^DIC(9.4,13,22,8,"PAH",18,1,19,0)="==========================="
^DIC(9.4,13,22,8,"PAH",18,1,20,0)="A .01 field that was 240 characters long caused a SUBSCRIPT error to occur"
^DIC(9.4,13,22,8,"PAH",18,1,21,0)="in the Finder FIND^DIC calls. I also found a similar problem in ^DIC if"
^DIC(9.4,13,22,8,"PAH",18,1,22,0)="the lookup value was very long. This patch corrects both problems."
^DIC(9.4,13,22,8,"PAH",18,1,23,0)="(Reported by Hellevi, Ruonamaa of Finland.)"
^DIC(9.4,13,22,8,"PAH",18,1,24,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,25,0)="Routines: DICM3"
^DIC(9.4,13,22,8,"PAH",18,1,26,0)="==============="
^DIC(9.4,13,22,8,"PAH",18,1,27,0)="When doing a lookup on an indexed variable pointer field where the pointer"
^DIC(9.4,13,22,8,"PAH",18,1,28,0)="had a screen, the screen logic wasn't being honored during lookup on the"
^DIC(9.4,13,22,8,"PAH",18,1,29,0)="pointed-to file. Found by Frank Stalling and Paul Sharp. NOIS:"
^DIC(9.4,13,22,8,"PAH",18,1,30,0)="ISD-1199-72724, SLC-1299-51331."
^DIC(9.4,13,22,8,"PAH",18,1,31,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,32,0)="Routines: DICM0"
^DIC(9.4,13,22,8,"PAH",18,1,33,0)="==============="
^DIC(9.4,13,22,8,"PAH",18,1,34,0)="If a New Style index on the .01 field has a TRANSFORM FOR STORAGE on it,"
^DIC(9.4,13,22,8,"PAH",18,1,35,0)="then don't allow LAYGO to the file while the value is in it's format after"
^DIC(9.4,13,22,8,"PAH",18,1,36,0)="going through the transform, as it may not be proper internal storage"
^DIC(9.4,13,22,8,"PAH",18,1,37,0)="format. An example is a date transformed to backwards collating sequence,"
^DIC(9.4,13,22,8,"PAH",18,1,38,0)="9999999-2991214. Found by developer."
^DIC(9.4,13,22,8,"PAH",18,1,39,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,40,0)="Routines: DIC, DIC0"
^DIC(9.4,13,22,8,"PAH",18,1,41,0)="==================="
^DIC(9.4,13,22,8,"PAH",18,1,42,0)="The new feature that makes ^DIC set DIC(""P"") so that it doesn't have to be"
^DIC(9.4,13,22,8,"PAH",18,1,43,0)="set as an input variable by the developer when allowing LAYGO to"
^DIC(9.4,13,22,8,"PAH",18,1,44,0)="multiples, wasn't working correctly. Found by Jerald F Rutherford. NOIS:"
^DIC(9.4,13,22,8,"PAH",18,1,45,0)="ISL-1299-51117."
^DIC(9.4,13,22,8,"PAH",18,1,46,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,47,0)="Routines: DIC1, DIC2, DICM, DICM1"
^DIC(9.4,13,22,8,"PAH",18,1,48,0)="================================="
^DIC(9.4,13,22,8,"PAH",18,1,49,0)="In the process of testing the Name Standardization project for the New"
^DIC(9.4,13,22,8,"PAH",18,1,50,0)="Person file, it was discovered that when there was a transform on the ""B"""
^DIC(9.4,13,22,8,"PAH",18,1,51,0)="index, the index value wasn't being displayed correctly during lookup."
^DIC(9.4,13,22,8,"PAH",18,1,52,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,53,0)="Routines: DIC4"
^DIC(9.4,13,22,8,"PAH",18,1,54,0)="=============="
^DIC(9.4,13,22,8,"PAH",18,1,55,0)="When the new ""T"" flag was used in DIC(0), developer discovered that a hard"
^DIC(9.4,13,22,8,"PAH",18,1,56,0)="error could occur if one of the indexes was a new style index with"
^DIC(9.4,13,22,8,"PAH",18,1,57,0)="TRANSFORM FOR STORAGE code. The error happened during the code that"
^DIC(9.4,13,22,8,"PAH",18,1,58,0)="executes the transform against the lookup value, then does a second lookup"
^DIC(9.4,13,22,8,"PAH",18,1,59,0)="on the index looking for a match to the transformed lookup value."
^DIC(9.4,13,22,8,"PAH",18,1,60,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,61,0)="Routines: DIC3"
^DIC(9.4,13,22,8,"PAH",18,1,62,0)="=============="
^DIC(9.4,13,22,8,"PAH",18,1,63,0)="Entries were not being found doing lookup when DIC(0) contained the"
^DIC(9.4,13,22,8,"PAH",18,1,64,0)="undocumented flag ""U"", as it is when doing a relational jump using a"
^DIC(9.4,13,22,8,"PAH",18,1,65,0)="backwards pointer. NOIS: BIL-1299-32021"
^DIC(9.4,13,22,8,"PAH",18,1,66,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,67,0)="Routine: DICUIX"
^DIC(9.4,13,22,8,"PAH",18,1,68,0)="==============="
^DIC(9.4,13,22,8,"PAH",18,1,69,0)="Look for the new field 'TRANSFORM FOR LOOKUP' in the INDEX file."
^DIC(9.4,13,22,8,"PAH",18,1,70,0)="Previously during lookup, if FileMan failed to find a match to the lookup"
^DIC(9.4,13,22,8,"PAH",18,1,71,0)="value, and if a lookup index had TRANSFORM FOR STORAGE code, FileMan"
^DIC(9.4,13,22,8,"PAH",18,1,72,0)="executed that against the lookup value and tried to find a match with the"
^DIC(9.4,13,22,8,"PAH",18,1,73,0)="new transformed value. Now it uses the TRANSFORM FOR LOOKUP code instead."
^DIC(9.4,13,22,8,"PAH",18,1,74,0)="The TRANSFORM FOR STORAGE code is used only to transform an entries field"
^DIC(9.4,13,22,8,"PAH",18,1,75,0)="value before storing it in the index for that entry."
^DIC(9.4,13,22,8,"PAH",18,1,76,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,77,0)="Routines: DIC3, DIC5, DICM"
^DIC(9.4,13,22,8,"PAH",18,1,78,0)="==========================="
^DIC(9.4,13,22,8,"PAH",18,1,79,0)="Because of the place where the DICR array was being NEWed when DIC(0)"
^DIC(9.4,13,22,8,"PAH",18,1,80,0)="contained the new ""T"" flag, I was losing a flag that told me I asked the"
^DIC(9.4,13,22,8,"PAH",18,1,81,0)="user whether they wanted to add a new entry while I had an internal,"
^DIC(9.4,13,22,8,"PAH",18,1,82,0)="transformed lookup value to stuff in the .01 field. This was causing me to"
^DIC(9.4,13,22,8,"PAH",18,1,83,0)="ask again whether they wanted to add a new entry, after all the transforms"
^DIC(9.4,13,22,8,"PAH",18,1,84,0)="were done.  Found by developer."
^DIC(9.4,13,22,8,"PAH",18,1,85,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,86,0)="Routine: DIKCFORM"
^DIC(9.4,13,22,8,"PAH",18,1,87,0)="================="
^DIC(9.4,13,22,8,"PAH",18,1,88,0)="When a new-style index is created and a TRANSFORM FOR STORAGE code was"
^DIC(9.4,13,22,8,"PAH",18,1,89,0)="defined on one of the cross-reference values, the TRANSFORM FOR DISPLAY"
^DIC(9.4,13,22,8,"PAH",18,1,90,0)="field was made required. This change makes the TRANSFORM FOR DISPLAY"
^DIC(9.4,13,22,8,"PAH",18,1,91,0)="optional, even if a TRANSFORM FOR STORAGE is defined, since the internal"
^DIC(9.4,13,22,8,"PAH",18,1,92,0)="form of the index value may already be readable to the user."
^DIC(9.4,13,22,8,"PAH",18,1,93,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,94,0)="Routines: DINIT2A3, DINIT2A4, DINIT0FA, DINIT0FB"
^DIC(9.4,13,22,8,"PAH",18,1,95,0)="================================================"
^DIC(9.4,13,22,8,"PAH",18,1,96,0)="Add a new field to the Index file (#.11), Cross-References Values multiple"
^DIC(9.4,13,22,8,"PAH",18,1,97,0)="(#.114). The field is TRANSFORM FOR LOOKUP (#5.3) and is used by FileMan's"
^DIC(9.4,13,22,8,"PAH",18,1,98,0)="lookup utilities (see change to routine DICUIX above). Note that this new"
^DIC(9.4,13,22,8,"PAH",18,1,99,0)="field is transported as part of the KIDS build for this patch, so there is"
^DIC(9.4,13,22,8,"PAH",18,1,100,0)="no need to re-run DINIT to get the new field installed."
^DIC(9.4,13,22,8,"PAH",18,1,101,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,102,0)="Routines: DINIT0FA, DINIT0FB"
^DIC(9.4,13,22,8,"PAH",18,1,103,0)="============================"
^DIC(9.4,13,22,8,"PAH",18,1,104,0)="When a new-style cross-reference is edited, provide a default for"
^DIC(9.4,13,22,8,"PAH",18,1,105,0)="Subscript Number only for Regular-type indexes, not MUMPS-type indexes."
^DIC(9.4,13,22,8,"PAH",18,1,106,0)="Also, set the Subscript Length to 30 for Free Text and MUMPS fields only"
^DIC(9.4,13,22,8,"PAH",18,1,107,0)="if the the field is used as a subscript. Note that these changes to the"
^DIC(9.4,13,22,8,"PAH",18,1,108,0)="ScreenMan form for editing new-style cross-references is transported as"
^DIC(9.4,13,22,8,"PAH",18,1,109,0)="part of the KIDS build for this patch, so there is no need to re-run DINIT"
^DIC(9.4,13,22,8,"PAH",18,1,110,0)="to get these changes."
^DIC(9.4,13,22,8,"PAH",18,1,111,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,112,0)="Routine: DIKCP1"
^DIC(9.4,13,22,8,"PAH",18,1,113,0)="==============="
^DIC(9.4,13,22,8,"PAH",18,1,114,0)="Include the new field TRANSFORM FOR LOOKUP (#5.3) in Data Dictionary"
^DIC(9.4,13,22,8,"PAH",18,1,115,0)="Listings."
^DIC(9.4,13,22,8,"PAH",18,1,116,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,117,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,118,0)="NOIS "
^DIC(9.4,13,22,8,"PAH",18,1,119,0)="===="
^DIC(9.4,13,22,8,"PAH",18,1,120,0)="BIL-1299-32021"
^DIC(9.4,13,22,8,"PAH",18,1,121,0)="ISD-1199-72724"
^DIC(9.4,13,22,8,"PAH",18,1,122,0)="ISL-1299-51117"
^DIC(9.4,13,22,8,"PAH",18,1,123,0)="SLC-1299-51331 "
^DIC(9.4,13,22,8,"PAH",18,1,124,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,125,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,126,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",18,1,127,0)="===================="
^DIC(9.4,13,22,8,"PAH",18,1,128,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,129,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",18,1,130,0)="================"
^DIC(9.4,13,22,8,"PAH",18,1,131,0)="The following routines are included in this patch.  The second line of these"
^DIC(9.4,13,22,8,"PAH",18,1,132,0)="routines now looks like: "
^DIC(9.4,13,22,8,"PAH",18,1,133,0)="  "
^DIC(9.4,13,22,8,"PAH",18,1,134,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",18,1,135,0)="  "
^DIC(9.4,13,22,8,"PAH",18,1,136,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",18,1,137,0)="  "
^DIC(9.4,13,22,8,"PAH",18,1,138,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",18,1,139,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",18,1,140,0)="  DIC            9925689         9515778         4,17,20"
^DIC(9.4,13,22,8,"PAH",18,1,141,0)="  DIC0           4839635         5249546         4,20"
