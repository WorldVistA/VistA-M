^DIC(9.4,162,22,1,"PAH",18,1,2,0)="Module."
^DIC(9.4,162,22,1,"PAH",19,0)="20 SEQ #19^3010815^1"
^DIC(9.4,162,22,1,"PAH",19,1,0)="^^2^2^3010815"
^DIC(9.4,162,22,1,"PAH",19,1,1,0)="A description of this build can be found on the NATIONAL PATCH MODULE under "
^DIC(9.4,162,22,1,"PAH",19,1,2,0)="USR*1.0*20."
^DIC(9.4,162,22,1,"PAH",20,0)="21 SEQ #20^3010906^1"
^DIC(9.4,162,22,1,"PAH",20,1,0)="^^2^2^3010906"
^DIC(9.4,162,22,1,"PAH",20,1,1,0)="A description of this build can be found on the NATIONAL PATCH MODULE under "
^DIC(9.4,162,22,1,"PAH",20,1,2,0)="USR*1.0*21."
^DIC(9.4,162,22,1,"PAH",21,0)="22 SEQ #21^3010926^1"
^DIC(9.4,162,22,1,"PAH",21,1,0)="^^2^2^3010926"
^DIC(9.4,162,22,1,"PAH",21,1,1,0)="A description of this build can be found on the NATIONAL PATCH MODULE under "
^DIC(9.4,162,22,1,"PAH",21,1,2,0)="USR*1.0*22."
^DIC(9.4,162,22,1,"PAH",22,0)="19^3020626^1"
^DIC(9.4,162,22,1,"PAH",22,1,0)="^^2^2^3020626"
^DIC(9.4,162,22,1,"PAH",22,1,1,0)="A description of this build can be found on the NATIONAL PATCH MODULE UNDER "
^DIC(9.4,162,22,1,"PAH",22,1,2,0)="USR*1*19."
^DIC(9.4,162,22,1,"PAH",23,0)="23^3030912^1"
^DIC(9.4,162,22,1,"PAH",23,1,0)="^^2^2^3030912"
^DIC(9.4,162,22,1,"PAH",23,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,162,22,1,"PAH",23,1,2,0)="under patch USR*1*23."
^DIC(9.4,162,22,1,"PAH",24,0)="24^3030924^1"
^DIC(9.4,162,22,1,"PAH",24,1,0)="^^2^2^3030924"
^DIC(9.4,162,22,1,"PAH",24,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,162,22,1,"PAH",24,1,2,0)="under patch USR*1*24."
^DIC(9.4,162,22,1,"PAH",25,0)="25 SEQ #26^3050118^1"
^DIC(9.4,162,22,1,"PAH",25,1,0)="^^2^2^3050118"
^DIC(9.4,162,22,1,"PAH",25,1,1,0)="The description of this patch may be found under the National Patch Module "
^DIC(9.4,162,22,1,"PAH",25,1,2,0)="under USR*1.0*25."
^DIC(9.4,162,22,1,"PAH",26,0)="27^3060505^1"
^DIC(9.4,162,22,1,"PAH",26,1,0)="^^2^2^3060505"
^DIC(9.4,162,22,1,"PAH",26,1,1,0)="The description for this build can be found in the National Patch Module "
^DIC(9.4,162,22,1,"PAH",26,1,2,0)="under USR*1*27."
^DIC(9.4,162,22,1,"PAH",27,0)="30^3061227.144555^1"
^DIC(9.4,162,22,1,"PAH",27,1,0)="^^1^1^3061227"
^DIC(9.4,162,22,1,"PAH",27,1,1,0)="See patch USR*1*30 in the National Patch Module."
^DIC(9.4,162,22,1,"PAH",28,0)="28 SEQ #29^3070627.221756^1"
^DIC(9.4,162,22,1,"PAH",28,1,0)="^^11^11^3070627"
^DIC(9.4,162,22,1,"PAH",28,1,1,0)="This patch corrects three issues with MEMBERHSIP by USER and USER CLASS."
^DIC(9.4,162,22,1,"PAH",28,1,2,0)=" "
^DIC(9.4,162,22,1,"PAH",28,1,3,0)=" "
^DIC(9.4,162,22,1,"PAH",28,1,4,0)="Issue #1-- When looking at Manage Business Rules you will notice "
^DIC(9.4,162,22,1,"PAH",28,1,5,0)="when you hit ""Add Rule"" selection, notice the system defaults to "
^DIC(9.4,162,22,1,"PAH",28,1,6,0)="a TIU Object / TITLE when nothing was selected."
^DIC(9.4,162,22,1,"PAH",28,1,7,0)=" "
^DIC(9.4,162,22,1,"PAH",28,1,8,0)="Issue #2-- In ""List Membership by User""  the dates are "
^DIC(9.4,162,22,1,"PAH",28,1,9,0)="list from most current to oldest."
^DIC(9.4,162,22,1,"PAH",28,1,10,0)="In ""List Membership by Class"" only the Expired"
^DIC(9.4,162,22,1,"PAH",28,1,11,0)="Member listed, not the Active Member."
^DIC(9.4,162,22,1,"PAH",29,0)="29 SEQ #31^3090423.134925^17"
^DIC(9.4,162,22,1,"PAH",29,1,0)="^^10^10^3090423"
^DIC(9.4,162,22,1,"PAH",29,1,1,0)="his patch prevents incomplete business rules and duplicate business rules"
^DIC(9.4,162,22,1,"PAH",29,1,2,0)="from being created.  It also corrects the document hierarchy issue that"
^DIC(9.4,162,22,1,"PAH",29,1,3,0)="allowed user access to a note due to a rule at a higher level.  This patch"
^DIC(9.4,162,22,1,"PAH",29,1,4,0)="includes updates to FileMan fields STATUS (#.02) and ACTION (#.03) in"
^DIC(9.4,162,22,1,"PAH",29,1,5,0)="AUTHORIZATION/SUBSCRIPTION file (#8930.1) to now require these fields when"
^DIC(9.4,162,22,1,"PAH",29,1,6,0)="creating rules.  It also includes an updated INPUT TEMPLATE for USR"
^DIC(9.4,162,22,1,"PAH",29,1,7,0)="AUTHORIZATION/SUBSCRIPTION (#8930.1) to perform requirement matching on"
^DIC(9.4,162,22,1,"PAH",29,1,8,0)="fields USER CLASS (#.04), AND FLAG (#.05), and USER ROLE (#.06).  The "
^DIC(9.4,162,22,1,"PAH",29,1,9,0)="patch prevents the error ""Already a member of this class"" from being "
^DIC(9.4,162,22,1,"PAH",29,1,10,0)="generated when the search string already matches a member in that class."
^DIC(9.4,162,22,1,"PAH",30,0)="33^3100602.104625^17"
^DIC(9.4,162,22,1,"PAH",30,1,0)="^^2^2^3100602"
^DIC(9.4,162,22,1,"PAH",30,1,1,0)="The description of this build can be found under patch USR*1*33 in the "
^DIC(9.4,162,22,1,"PAH",30,1,2,0)="National Patch Module."
^DIC(9.4,162,22,1,"PAH",31,0)="37^3160407.160229^54"
^DIC(9.4,162,22,1,"PAH",32,0)="39 SEQ #36^3191024.12161^65"
^DIC(9.4,162,22,1,"PAH",32,1,0)="^^1^1^3191024"
^DIC(9.4,162,22,1,"PAH",32,1,1,0)="PLEASE REFER TO THE PATCH DESCRIPTION FOR USR*1.0*39 FOR DETAILS."
^DIC(9.4,162,22,1,"PAH",33,0)="41 SEQ #37^3211201.155517^17"
^DIC(9.4,162,22,1,"PAH",33,1,0)="^^4^4^3211201"
^DIC(9.4,162,22,1,"PAH",33,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,162,22,1,"PAH",33,1,2,0)=" "
^DIC(9.4,162,22,1,"PAH",33,1,3,0)="The word ""granted"" is spelled ""grated"" in help text displayed by options "
^DIC(9.4,162,22,1,"PAH",33,1,4,0)="""USR LIST MEMBERSHIP BY CLASS"" and ""USR LIST MEMBERSHIP BY USER""."
^DIC(9.4,162,22,1,"PAH","B",1,1)=""
^DIC(9.4,162,22,1,"PAH","B",2,2)=""
^DIC(9.4,162,22,1,"PAH","B",3,3)=""
^DIC(9.4,162,22,1,"PAH","B",4,4)=""
^DIC(9.4,162,22,1,"PAH","B",5,5)=""
^DIC(9.4,162,22,1,"PAH","B",6,6)=""
^DIC(9.4,162,22,1,"PAH","B",7,7)=""
