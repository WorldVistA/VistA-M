^DIC(9.4,4,22,1,"PAH",45,1,35,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",45,1,36,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",45,1,37,0)="       Backup a Transport Global"
