^DIC(9.4,14,22,5.9,"PAH",79,1,673,0)=" "
^DIC(9.4,14,22,5.9,"PAH",79,1,674,0)="Select LAB DESCRIPTIONS NAME: Repeat .."
^DIC(9.4,14,22,5.9,"PAH",79,1,675,0)=" "
^DIC(9.4,14,22,5.9,"PAH",79,1,676,0)="YOU SHOULD NOW VERIFY THAT THE LAB DESCRIPTIONS ARE EXPANDING"
^DIC(9.4,14,22,5.9,"PAH",79,1,677,0)="APPROPRIATELY."
^DIC(9.4,14,22,5.9,"PAH",79,1,678,0)=" "
^DIC(9.4,14,22,5.9,"PAH",79,1,679,0)="32. The ""ORDERED TEST COST BY PROVIDER"" [LR ORDERED TESTS BY PHY] option"
^DIC(9.4,14,22,5.9,"PAH",79,1,680,0)="has been enhanced to allow selection of accessioning division or any given"
^DIC(9.4,14,22,5.9,"PAH",79,1,681,0)="order. This will allow a report based on where the specimen was"
^DIC(9.4,14,22,5.9,"PAH",79,1,682,0)="accessioned. The report will be based on the division of the user"
^DIC(9.4,14,22,5.9,"PAH",79,1,683,0)="accessioning the specimen. If no division is selected, all divisions will"
^DIC(9.4,14,22,5.9,"PAH",79,1,684,0)="be included on the report."
^DIC(9.4,14,22,5.9,"PAH",80,0)="212 SEQ #179^2990719^1"
^DIC(9.4,14,22,5.9,"PAH",80,1,0)="^^4^4^2990719"
^DIC(9.4,14,22,5.9,"PAH",80,1,1,0)="This patch corrects issues both with Y2K and also makes the Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",80,1,2,0)="package compatible with changes being exported with VA FileMan version 22."
^DIC(9.4,14,22,5.9,"PAH",80,1,3,0)=" For a complete description of the patch contents, see the Description of"
^DIC(9.4,14,22,5.9,"PAH",80,1,4,0)="the patch in the FORUM Patch Module."
^DIC(9.4,14,22,5.9,"PAH",81,0)="238 SEQ #180^2990803^1"
^DIC(9.4,14,22,5.9,"PAH",81,1,0)="^^3^3^2990803"
^DIC(9.4,14,22,5.9,"PAH",81,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",81,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",81,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",82,0)="230 SEQ #181^2991019^1"
^DIC(9.4,14,22,5.9,"PAH",82,1,0)="^^2^2^2991019"
^DIC(9.4,14,22,5.9,"PAH",82,1,1,0)="See patch LR*5.2*230 in the National Patch Module for a description of"
^DIC(9.4,14,22,5.9,"PAH",82,1,2,0)="this build."
^DIC(9.4,14,22,5.9,"PAH",83,0)="229 SEQ #182^2991210^1"
^DIC(9.4,14,22,5.9,"PAH",83,1,0)="^^3^3^2991210"
^DIC(9.4,14,22,5.9,"PAH",83,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",83,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",83,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",84,0)="244 SEQ #183^2991210^1"
^DIC(9.4,14,22,5.9,"PAH",84,1,0)="^^3^3^2991210"
^DIC(9.4,14,22,5.9,"PAH",84,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",84,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",84,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",85,0)="241 SEQ #184^2991210^1"
^DIC(9.4,14,22,5.9,"PAH",85,1,0)="^^3^3^2991210"
^DIC(9.4,14,22,5.9,"PAH",85,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",85,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",85,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",86,0)="247^2991210^1"
^DIC(9.4,14,22,5.9,"PAH",86,1,0)="^^195^195^2991210"
^DIC(9.4,14,22,5.9,"PAH",86,1,1,0)="Below is a brief description only of changes included in this patch.  For"
^DIC(9.4,14,22,5.9,"PAH",86,1,2,0)="a full description please see the Patch Description in the Forum Patch"
^DIC(9.4,14,22,5.9,"PAH",86,1,3,0)="Module."
^DIC(9.4,14,22,5.9,"PAH",86,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,5,0)=" Problem # 1:  "
^DIC(9.4,14,22,5.9,"PAH",86,1,6,0)=" It was determined by the VistA IV&V Y2K testing analysis that several"
^DIC(9.4,14,22,5.9,"PAH",86,1,7,0)=" displays within the Blood Bank software that historically displayed"
^DIC(9.4,14,22,5.9,"PAH",86,1,8,0)=" Month/Day only needed to also display a 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",86,1,9,0)=" NOIS:  ISP-0899-N0355"
^DIC(9.4,14,22,5.9,"PAH",86,1,10,0)=" - Resolution:  Screen displays associated with the ordering and"
^DIC(9.4,14,22,5.9,"PAH",86,1,11,0)="   processing of blood components for a patient have been modified to"
^DIC(9.4,14,22,5.9,"PAH",86,1,12,0)="   always include a 4 digit year, even if no year was previously"
^DIC(9.4,14,22,5.9,"PAH",86,1,13,0)="   displayed."
^DIC(9.4,14,22,5.9,"PAH",86,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,15,0)=" Problem # 2:"
^DIC(9.4,14,22,5.9,"PAH",86,1,16,0)=" It was discovered during Y2K testing of the Donor module of the Blood"
^DIC(9.4,14,22,5.9,"PAH",86,1,17,0)=" Bank package that when donor collection information is entered into the"
^DIC(9.4,14,22,5.9,"PAH",86,1,18,0)=" computer, future times are allowed when entering the fields DATE/TIME"
^DIC(9.4,14,22,5.9,"PAH",86,1,19,0)=" COLLECTION STARTED (#65.54,4.2) and DATE/TIME COLLECTION COMPLETED"
^DIC(9.4,14,22,5.9,"PAH",86,1,20,0)=" (#65.54,4.3).  This posed a problem during testing in the system being"
^DIC(9.4,14,22,5.9,"PAH",86,1,21,0)=" used for Y2K testing.  The scenario where a unit is collected on"
^DIC(9.4,14,22,5.9,"PAH",86,1,22,0)=" 12-31-1999 but data is not entered until 12-1-2000 and the date/times"
^DIC(9.4,14,22,5.9,"PAH",86,1,23,0)=" being entered as 12-31@0800 defaults to the current year, which is a"
^DIC(9.4,14,22,5.9,"PAH",86,1,24,0)=" future time.  This should not be allowed."
^DIC(9.4,14,22,5.9,"PAH",86,1,25,0)=" NOIS:  ISA-1099-13117"
^DIC(9.4,14,22,5.9,"PAH",86,1,26,0)=" - Resolution:  The input transforms of the affected fields will be edited"
^DIC(9.4,14,22,5.9,"PAH",86,1,27,0)="   so that no future dates are allowed."
^DIC(9.4,14,22,5.9,"PAH",86,1,28,0)="   "
^DIC(9.4,14,22,5.9,"PAH",86,1,29,0)=" Problem # 3:"
^DIC(9.4,14,22,5.9,"PAH",86,1,30,0)=" It was reported by a site via an Outlook message that when logging in"
^DIC(9.4,14,22,5.9,"PAH",86,1,31,0)=" units using the option Log-in regular (invoices)  [LRBLILR] and the"
^DIC(9.4,14,22,5.9,"PAH",86,1,32,0)=" barcode scanner is used, if a site's supplier uses Expiration Date"
^DIC(9.4,14,22,5.9,"PAH",86,1,33,0)=" barcodes utilizing a 4 digit year, then the display to the user seems to"
^DIC(9.4,14,22,5.9,"PAH",86,1,34,0)=" indicate that the scanner did not interpret the code correctly.  The"
^DIC(9.4,14,22,5.9,"PAH",86,1,35,0)=" correct expiration date was in fact being assigned to the unit, however,"
^DIC(9.4,14,22,5.9,"PAH",86,1,36,0)=" the software was interpreting the input as if the user was manually"
^DIC(9.4,14,22,5.9,"PAH",86,1,37,0)=" inputting the expiration date.  This could cause some confusion at sites."
^DIC(9.4,14,22,5.9,"PAH",86,1,38,0)=" - Resolution:  The routine which interprets barcodes has been modified so"
^DIC(9.4,14,22,5.9,"PAH",86,1,39,0)="   that the barcode scanner itself is interpreting the expiration date."
^DIC(9.4,14,22,5.9,"PAH",86,1,40,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,41,0)=" Problem # 4:  "
^DIC(9.4,14,22,5.9,"PAH",86,1,42,0)=" The input screen for the fields DIVISION in the BLOOD INVENTORY File"
^DIC(9.4,14,22,5.9,"PAH",86,1,43,0)=" (#65,.16) and ASSOCIATED DIVISION in the BLOOD PRODUCT File (#66.1,.01)"
^DIC(9.4,14,22,5.9,"PAH",86,1,44,0)=" incorrectly made the assumption that a site's division was dinumed to the"
^DIC(9.4,14,22,5.9,"PAH",86,1,45,0)=" INSTITUTION File (#4). "
^DIC(9.4,14,22,5.9,"PAH",86,1,46,0)=" NOIS: WPB-1196-31737"
^DIC(9.4,14,22,5.9,"PAH",86,1,47,0)=" - Resolution:  The screen in the following input transforms have been"
^DIC(9.4,14,22,5.9,"PAH",86,1,48,0)="   changed to S DIC(""S"")=""I +$G(^DIC(4,+Y,99))=+$P($$SITE^VASITE,U,3)"""
^DIC(9.4,14,22,5.9,"PAH",86,1,49,0)="                          D ^DIC K DIC S DIC=DIE,X=+Y K:Y<0 X"""
^DIC(9.4,14,22,5.9,"PAH",86,1,50,0)="   BLOOD INVENTORY File (#65) field DIVISION (#65,.16)"
^DIC(9.4,14,22,5.9,"PAH",86,1,51,0)="   BLOOD PRODUCT File (#66) field ASSOCIATED DIVISION (# 66.1,.01)"
^DIC(9.4,14,22,5.9,"PAH",86,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,53,0)=" Problem # 5:  "
^DIC(9.4,14,22,5.9,"PAH",86,1,54,0)=" In a multidivisional site, if the report Patient transfusions &"
^DIC(9.4,14,22,5.9,"PAH",86,1,55,0)=" hematology results [LRBLPCH] crashed for any reason, it could not be"
^DIC(9.4,14,22,5.9,"PAH",86,1,56,0)=" restarted if the name of the Blood Bank accession area was not BLOOD"
^DIC(9.4,14,22,5.9,"PAH",86,1,57,0)=" BANK.  This is because in order to restart the crashed report, the option"
^DIC(9.4,14,22,5.9,"PAH",86,1,58,0)=" Delete a user's patient list [LRBLSDPL] needed to be run first.  This"
^DIC(9.4,14,22,5.9,"PAH",86,1,59,0)=" option had the accession area hard coded to be BLOOD BANK therefore would"
^DIC(9.4,14,22,5.9,"PAH",86,1,60,0)=" not always work in a multidivisional site with more than one Blood Bank."
^DIC(9.4,14,22,5.9,"PAH",86,1,61,0)=" NOIS:  BHS-0899-12185"
^DIC(9.4,14,22,5.9,"PAH",86,1,62,0)=" - Resolution:  The option Delete a user's patient list [LRBLSDPL] was"
^DIC(9.4,14,22,5.9,"PAH",86,1,63,0)="   modified to determine the accession area for the Blood Bank based on"
^DIC(9.4,14,22,5.9,"PAH",86,1,64,0)="   the user's division at sign-on.  Previously, the accession area was"
^DIC(9.4,14,22,5.9,"PAH",86,1,65,0)="   hard-coded to be BLOOD BANK."
^DIC(9.4,14,22,5.9,"PAH",86,1,66,0)=" NOTE-- the resolution to this problem will not be validated at the sites"
^DIC(9.4,14,22,5.9,"PAH",86,1,67,0)="        as it is not practical to ask sites to force a system crash.  The"
^DIC(9.4,14,22,5.9,"PAH",86,1,68,0)="        validity of the fix for this will be internally verified by"
^DIC(9.4,14,22,5.9,"PAH",86,1,69,0)="        development under controlled conditions only.  This option does"
^DIC(9.4,14,22,5.9,"PAH",86,1,70,0)="        not contain any safety critical functions for the blood bank."
^DIC(9.4,14,22,5.9,"PAH",86,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,72,0)=" Problem # 6:  "
^DIC(9.4,14,22,5.9,"PAH",86,1,73,0)=" When a unit which was originally scanned during log-in is modified, such"
^DIC(9.4,14,22,5.9,"PAH",86,1,74,0)=" as thawing or irradiating, the unit could no longer be processed using a"
^DIC(9.4,14,22,5.9,"PAH",86,1,75,0)=" scanner.  This affected both the Blood Bank as well as the Surgical Risk"
^DIC(9.4,14,22,5.9,"PAH",86,1,76,0)=" Initiative."
^DIC(9.4,14,22,5.9,"PAH",86,1,77,0)=" NOIS:  HIN-1196-40687     ALB-0298-52583"
^DIC(9.4,14,22,5.9,"PAH",86,1,78,0)=" - Resolution: When a unit is modified using the option Disposition -not"
^DIC(9.4,14,22,5.9,"PAH",86,1,79,0)="   transfused [LRBLIDN] and the Unit ID remains the same (i.e. unit not"
^DIC(9.4,14,22,5.9,"PAH",86,1,80,0)="   pooled or split) the ^LRD(65,""C"", cross-reference is now built if the"
^DIC(9.4,14,22,5.9,"PAH",86,1,81,0)="   scanner was used to process the modification."
^DIC(9.4,14,22,5.9,"PAH",86,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,83,0)=" Problem # 7:"
^DIC(9.4,14,22,5.9,"PAH",86,1,84,0)=" It was discovered during internal testing by the developer that units"
^DIC(9.4,14,22,5.9,"PAH",86,1,85,0)=" that are modified in error, and the option Edit unit log in [LRBLSEL] is"
^DIC(9.4,14,22,5.9,"PAH",86,1,86,0)=" used to either edit or delete the modified unit, the ^LRD(65,""C"","
^DIC(9.4,14,22,5.9,"PAH",86,1,87,0)=" cross-reference was not being updated appropriately."
^DIC(9.4,14,22,5.9,"PAH",86,1,88,0)="  - Resolution:  Coding was changed to update the ^LRD(65,""C"""
^DIC(9.4,14,22,5.9,"PAH",86,1,89,0)="    cross-reference as appropriate when units are edited."
^DIC(9.4,14,22,5.9,"PAH",86,1,90,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,91,0)=" Problem # 8:"
^DIC(9.4,14,22,5.9,"PAH",86,1,92,0)=" When executing the option Print all BB patient reports on print queue"
^DIC(9.4,14,22,5.9,"PAH",86,1,93,0)=" [LRBLP PRINT ALL ON QUEUE] if for some reason the first patient blood"
^DIC(9.4,14,22,5.9,"PAH",86,1,94,0)=" bank report added to the print queue doesn't have a PROVIDER the report"
^DIC(9.4,14,22,5.9,"PAH",86,1,95,0)=" bombs with an undefined and none of the reports will print.  Also, if a"
^DIC(9.4,14,22,5.9,"PAH",86,1,96,0)=" patient blood bank report added in the middle of the queue doesn't have a"
^DIC(9.4,14,22,5.9,"PAH",86,1,97,0)=" provider, the report will print the provider of the report just"
^DIC(9.4,14,22,5.9,"PAH",86,1,98,0)=" previously added to the queue."
^DIC(9.4,14,22,5.9,"PAH",86,1,99,0)=" NOIS:  ALB-0899-52597"
^DIC(9.4,14,22,5.9,"PAH",86,1,100,0)=" - Resolution:  Regardless of where in the queue a report is added, if the"
^DIC(9.4,14,22,5.9,"PAH",86,1,101,0)="   report record does not have the provider listed for any reason, the"
^DIC(9.4,14,22,5.9,"PAH",86,1,102,0)="   word ""UNKNOWN"" will be stuffed as the provider."
^DIC(9.4,14,22,5.9,"PAH",86,1,103,0)="   NOTE--this issue has only been reported at one site and is not easily"
^DIC(9.4,14,22,5.9,"PAH",86,1,104,0)="         reproducible. The validity of the fix for this will be internally"
^DIC(9.4,14,22,5.9,"PAH",86,1,105,0)="         verified by development under controlled conditions only.  This"
^DIC(9.4,14,22,5.9,"PAH",86,1,106,0)="         option does not contain any safety critical functions for the"
^DIC(9.4,14,22,5.9,"PAH",86,1,107,0)="         blood bank."
^DIC(9.4,14,22,5.9,"PAH",86,1,108,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,109,0)=" Problem # 9:"
^DIC(9.4,14,22,5.9,"PAH",86,1,110,0)=" When using the option Disposition - relocation [LRBLIDR] there were a"
^DIC(9.4,14,22,5.9,"PAH",86,1,111,0)=" variety of reported problems with the lookup for LOCATION to relocate"
^DIC(9.4,14,22,5.9,"PAH",86,1,112,0)=" blood to."
^DIC(9.4,14,22,5.9,"PAH",86,1,113,0)=" NOIS:  IND-1296-40311   BRX-0597-11400   LEB-0199-20568"
^DIC(9.4,14,22,5.9,"PAH",86,1,114,0)=" - Resolution:  The lookup routine LRUC was rewritten.  It now uses"
^DIC(9.4,14,22,5.9,"PAH",86,1,115,0)="   FileMan utilities to look up valid locations based on the division of"
^DIC(9.4,14,22,5.9,"PAH",86,1,116,0)="   the user at sign-on."
^DIC(9.4,14,22,5.9,"PAH",86,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,118,0)=" Problem # 10:"
^DIC(9.4,14,22,5.9,"PAH",86,1,119,0)=" During the option Log-in regular (invoices) [LRBLILR], when the user is"
^DIC(9.4,14,22,5.9,"PAH",86,1,120,0)=" presented the screen to edit units just logged in, if a unit had been"
^DIC(9.4,14,22,5.9,"PAH",86,1,121,0)=" accidentally logged in with an expiration date the same date as the log"
^DIC(9.4,14,22,5.9,"PAH",86,1,122,0)=" in, and the expiration date is edited correctly, the unit is still"
^DIC(9.4,14,22,5.9,"PAH",86,1,123,0)=" flagged as expiring today when re-displayed to the user. This was ONLY a"
^DIC(9.4,14,22,5.9,"PAH",86,1,124,0)=" flag problem.  The actual expiration date of the unit always reflected"
^DIC(9.4,14,22,5.9,"PAH",86,1,125,0)=" the date correctly as input."
^DIC(9.4,14,22,5.9,"PAH",86,1,126,0)=" NOIS:  LEX-0197-40288"
^DIC(9.4,14,22,5.9,"PAH",86,1,127,0)=" - Resolution:  The option has been edited so that the flags for units"
^DIC(9.4,14,22,5.9,"PAH",86,1,128,0)="   expiring the same day work appropriately."
^DIC(9.4,14,22,5.9,"PAH",86,1,129,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,130,0)=" Problem # 11:"
^DIC(9.4,14,22,5.9,"PAH",86,1,131,0)=" During the background process of collecting workload for Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",86,1,132,0)=" accessions, result data was being inappropriately stuffed into fields"
^DIC(9.4,14,22,5.9,"PAH",86,1,133,0)=" which had been starred for deletion.  This data was then printing on the"
^DIC(9.4,14,22,5.9,"PAH",86,1,134,0)=" Accession area worklist [LRUWL] report."
^DIC(9.4,14,22,5.9,"PAH",86,1,135,0)=" NOIS:  ATG-0895-32603"
^DIC(9.4,14,22,5.9,"PAH",86,1,136,0)=" -Resolution: The collection of workload data no longer stuffs result data"
^DIC(9.4,14,22,5.9,"PAH",86,1,137,0)="  into inappropriate fields."
^DIC(9.4,14,22,5.9,"PAH",86,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,139,0)=" Problem # 12:"
^DIC(9.4,14,22,5.9,"PAH",86,1,140,0)=" As of April 23, 1999 the VistA BLOOD BANK Software (v 5.2) is classified"
^DIC(9.4,14,22,5.9,"PAH",86,1,141,0)=" as a Medical Device # BK970021 with the FDA.  According to VHA Directive"
^DIC(9.4,14,22,5.9,"PAH",86,1,142,0)=" 97-033, Section 4. ACTION part b., the CIOFO would embed in the form of a"
^DIC(9.4,14,22,5.9,"PAH",86,1,143,0)=" comment in routines that contain the controlled software a statement that"
^DIC(9.4,14,22,5.9,"PAH",86,1,144,0)=" the routine should not be modified.  According to FDA, if a facility"
^DIC(9.4,14,22,5.9,"PAH",86,1,145,0)=" other than the original software manufacturer makes any changes to the"
^DIC(9.4,14,22,5.9,"PAH",86,1,146,0)=" cleared device, including changes to the software components of the"
^DIC(9.4,14,22,5.9,"PAH",86,1,147,0)=" medical device, this software no longer represents the cleared medical"
^DIC(9.4,14,22,5.9,"PAH",86,1,148,0)=" device and the facility making the modification becomes the medical"
^DIC(9.4,14,22,5.9,"PAH",86,1,149,0)=" device manufacturer of a new medical device.   "
^DIC(9.4,14,22,5.9,"PAH",86,1,150,0)=" - Resolution:  Routines classified as Group A in VHA Directive 97-033"
^DIC(9.4,14,22,5.9,"PAH",86,1,151,0)="   will have the following verbiage inserted in the third line:"
^DIC(9.4,14,22,5.9,"PAH",86,1,152,0)="   ; Per VHA Directive 97-033, this routine should not be modified."
^DIC(9.4,14,22,5.9,"PAH",86,1,153,0)="     Medical Device # BK970021"
^DIC(9.4,14,22,5.9,"PAH",86,1,154,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,155,0)=" Problem # 13:"
^DIC(9.4,14,22,5.9,"PAH",86,1,156,0)=" The Patient Merge software introduced a problem in the database"
^DIC(9.4,14,22,5.9,"PAH",86,1,157,0)=" that has affected the way some of the Lab routines determine the"
^DIC(9.4,14,22,5.9,"PAH",86,1,158,0)=" LABORATORY REFERENCE field (#2,63) from the PATIENT File (#2).  "
^DIC(9.4,14,22,5.9,"PAH",86,1,159,0)=" - Resolution:  Routines LRBLPAB and LRBLPD1 have been modified to use the"
^DIC(9.4,14,22,5.9,"PAH",86,1,160,0)="   function $$LRDFN^L7OR1(DFN) to determine a patient's LRDFN.  This"
^DIC(9.4,14,22,5.9,"PAH",86,1,161,0)="   function was introduced in LR*5.2*230 as a defensive programming"
^DIC(9.4,14,22,5.9,"PAH",86,1,162,0)="   measure to prevent an undefined error from occurring when attempting to"
^DIC(9.4,14,22,5.9,"PAH",86,1,163,0)="   determine the LRDFN from the ^DPT(DFN,""LR"") node."
^DIC(9.4,14,22,5.9,"PAH",86,1,164,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,165,0)=" Problem # 14:"
^DIC(9.4,14,22,5.9,"PAH",86,1,166,0)=" There may be some old post-init or otherwise unnecessary routines at"
^DIC(9.4,14,22,5.9,"PAH",86,1,167,0)=" sites.  These will be removed during the KIDS install if they are"
^DIC(9.4,14,22,5.9,"PAH",86,1,168,0)=" present."
^DIC(9.4,14,22,5.9,"PAH",86,1,169,0)=" -Resolution:  If present on a system, routines LRBLFIX, LRBLFX72,"
^DIC(9.4,14,22,5.9,"PAH",86,1,170,0)="  LRBLJ, LRBLPOST, LRBLCON and LRBLXREF will be removed as part of the"
^DIC(9.4,14,22,5.9,"PAH",86,1,171,0)="  KIDS Install."
^DIC(9.4,14,22,5.9,"PAH",86,1,172,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,173,0)=" Problem # 15:"
^DIC(9.4,14,22,5.9,"PAH",86,1,174,0)=" It was reported by Milwaukee via a mail message that when a blood bank"
^DIC(9.4,14,22,5.9,"PAH",86,1,175,0)=" specimen is drawn on one day but not actually accessioned until the next"
^DIC(9.4,14,22,5.9,"PAH",86,1,176,0)=" day, under certain circumstances an undefined error would occur when a"
^DIC(9.4,14,22,5.9,"PAH",86,1,177,0)=" tech attempts to assign units which require crossmatch using the option"
^DIC(9.4,14,22,5.9,"PAH",86,1,178,0)=" Select units for patients [LRBLPIC].  Upon further investigation it was"
^DIC(9.4,14,22,5.9,"PAH",86,1,179,0)=" discovered that the option was attempting to update the field COMPLETION"
^DIC(9.4,14,22,5.9,"PAH",86,1,180,0)=" TIME (#68.14,1) for workload purposes.  It was further determined that"
^DIC(9.4,14,22,5.9,"PAH",86,1,181,0)=" when the error did not occur, the incorrect workload record was being"
^DIC(9.4,14,22,5.9,"PAH",86,1,182,0)=" updated.  It is actually inappropriate to update this field as it is set"
^DIC(9.4,14,22,5.9,"PAH",86,1,183,0)=" when the original accession has the ABO/Rh and ABS results entered."
^DIC(9.4,14,22,5.9,"PAH",86,1,184,0)=" -Resolution:  Coding has been changed so that the field COMPLETION DATE"
^DIC(9.4,14,22,5.9,"PAH",86,1,185,0)=" (#68.14,1)is no longer updated as a result of using the option Select"
^DIC(9.4,14,22,5.9,"PAH",86,1,186,0)=" units for patients [LRBLPIC]."
^DIC(9.4,14,22,5.9,"PAH",86,1,187,0)=" "
^DIC(9.4,14,22,5.9,"PAH",86,1,188,0)=" Problem # 16:"
^DIC(9.4,14,22,5.9,"PAH",86,1,189,0)=" The patch LR*5.2*72 inadvertently exported a change in the length of the"
^DIC(9.4,14,22,5.9,"PAH",86,1,190,0)=" text allowed in the BLOOD PRODUCT File (#66) field SYNONYM (#66.021,.01)."
^DIC(9.4,14,22,5.9,"PAH",86,1,191,0)=" This resulted in sites being restricted to 5 character synonyms for"
^DIC(9.4,14,22,5.9,"PAH",86,1,192,0)=" entries made to this field after installation of that patch.  "
^DIC(9.4,14,22,5.9,"PAH",86,1,193,0)=" -Resolution:  The data dictionary for this field is being re-exported and"
^DIC(9.4,14,22,5.9,"PAH",86,1,194,0)=" the SYNONYM field (#66.021,.01) field will now be allowed to accept"
^DIC(9.4,14,22,5.9,"PAH",86,1,195,0)=" entries from 1-25 characters."
^DIC(9.4,14,22,5.9,"PAH",87,0)="250 SEQ #186^2991220^1"
^DIC(9.4,14,22,5.9,"PAH",87,1,0)="^^3^3^2991220"
^DIC(9.4,14,22,5.9,"PAH",87,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",87,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",87,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",88,0)="251 SEQ #187^3000103^1"
^DIC(9.4,14,22,5.9,"PAH",88,1,0)="^^3^3^3000103"
^DIC(9.4,14,22,5.9,"PAH",88,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",88,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",88,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",89,0)="242 SEQ #188^3000103^1"
^DIC(9.4,14,22,5.9,"PAH",89,1,0)="^^104^104^3000103"
^DIC(9.4,14,22,5.9,"PAH",89,1,1,0)=" Y2K Waiver Exemption ID#: Y2KWE0040"
^DIC(9.4,14,22,5.9,"PAH",89,1,2,0)=" This patch may be installed at any time during the Y2K "
^DIC(9.4,14,22,5.9,"PAH",89,1,3,0)=" Moratorium (including the 12/15/1999 thru 1/15/2000 Y2K lockdown)."
^DIC(9.4,14,22,5.9,"PAH",89,1,4,0)=""
^DIC(9.4,14,22,5.9,"PAH",89,1,5,0)=" This patch corrects two problems:"
^DIC(9.4,14,22,5.9,"PAH",89,1,6,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,7,0)=" 1. The Indian Health Service reported a possible Y2K problem.  Some of the"
^DIC(9.4,14,22,5.9,"PAH",89,1,8,0)=" Microbiology and Anatomic Pathology routines were using an unreliable"
^DIC(9.4,14,22,5.9,"PAH",89,1,9,0)=" method of converting the internal year format to an external 4 digit"
^DIC(9.4,14,22,5.9,"PAH",89,1,10,0)=" format. This calculation is now done using verified FileMan utilities."
^DIC(9.4,14,22,5.9,"PAH",89,1,11,0)=""
^DIC(9.4,14,22,5.9,"PAH",89,1,12,0)=" 2. The Patient Merge software introduced a problem in the database that"
^DIC(9.4,14,22,5.9,"PAH",89,1,13,0)=" has affected the way many of the Lab routines get the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",89,1,14,0)=" Patient identifier (LABORATORY REFERENCE field (#63) in the PATIENT"
^DIC(9.4,14,22,5.9,"PAH",89,1,15,0)=" file (#2) also known as the LRDFN). The Patient Merge developers are"
^DIC(9.4,14,22,5.9,"PAH",89,1,16,0)=" working on a solution for the problem created in the database and the"
^DIC(9.4,14,22,5.9,"PAH",89,1,17,0)=" cause of the problem.  Patch LR*5.2*242 is being created as a defensive "
^DIC(9.4,14,22,5.9,"PAH",89,1,18,0)=" measure against this problem and any possible future changes that may "
^DIC(9.4,14,22,5.9,"PAH",89,1,19,0)=" affect the problem global node: ^DPT(DFN,""LR"")."
^DIC(9.4,14,22,5.9,"PAH",89,1,20,0)=""
^DIC(9.4,14,22,5.9,"PAH",89,1,21,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,22,0)=" This patch to the Laboratory package does not contain any changes to the"
^DIC(9.4,14,22,5.9,"PAH",89,1,23,0)=" VISTA BLOOD BANK Software as defined by VHA DIRECTIVE 97-033 titled VISTA"
^DIC(9.4,14,22,5.9,"PAH",89,1,24,0)=" BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",89,1,25,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,26,0)=" PROBLEM:   The Patient Merge software introduced a problem in the database"
^DIC(9.4,14,22,5.9,"PAH",89,1,27,0)=" that has affected the way many of the Lab routines determine the"
^DIC(9.4,14,22,5.9,"PAH",89,1,28,0)=" LABORATORY REFERENCE field (#2,63) from the PATIENT File (#2).  Patch "
^DIC(9.4,14,22,5.9,"PAH",89,1,29,0)=" LR*5.2*242 is created as a defensive measure against this problem and any"
^DIC(9.4,14,22,5.9,"PAH",89,1,30,0)=" possible future changes that may affect the problem global node"
^DIC(9.4,14,22,5.9,"PAH",89,1,31,0)=" ^DPT(DFN,""LR"").  "
^DIC(9.4,14,22,5.9,"PAH",89,1,32,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,33,0)=" RISK ANALYSIS:   Changes made by patch LR*5.2*242 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",89,1,34,0)=" Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",89,1,35,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,36,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS:  Patch LR*5.2*242 does not"
^DIC(9.4,14,22,5.9,"PAH",89,1,37,0)=" alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",89,1,38,0)=" functions."
^DIC(9.4,14,22,5.9,"PAH",89,1,39,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,40,0)=" POTENTIAL IMPACT ON SITES:  Patch LR*5.2*242 contains no changes to "
^DIC(9.4,14,22,5.9,"PAH",89,1,41,0)=" routines identified in Veterans Health Administration (VHA) Directive "
^DIC(9.4,14,22,5.9,"PAH",89,1,42,0)=" 97-033. There is no adverse potential to sites."
^DIC(9.4,14,22,5.9,"PAH",89,1,43,0)="  "
^DIC(9.4,14,22,5.9,"PAH",89,1,44,0)=" VALIDATION REQUIREMENTS BY OPTION:  There are no required validation"
^DIC(9.4,14,22,5.9,"PAH",89,1,45,0)=" scenarios to be completed by sites after installing LR*5.2*242."
^DIC(9.4,14,22,5.9,"PAH",89,1,46,0)=""
^DIC(9.4,14,22,5.9,"PAH",89,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",89,1,48,0)=" Related NOIS: LEX-0599-42692"
^DIC(9.4,14,22,5.9,"PAH",89,1,49,0)="               BHS-0799-12636"
^DIC(9.4,14,22,5.9,"PAH",89,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",89,1,51,0)=" Test site(s): Oklahoma City, OK"
^DIC(9.4,14,22,5.9,"PAH",89,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",89,1,53,0)=" ROUTINE SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",89,1,54,0)=" ================"
^DIC(9.4,14,22,5.9,"PAH",89,1,55,0)=" The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,14,22,5.9,"PAH",89,1,56,0)=" second line of each of these routine(s) will look like:"
^DIC(9.4,14,22,5.9,"PAH",89,1,57,0)=" "
