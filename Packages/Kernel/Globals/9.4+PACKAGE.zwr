^DIC(9.4,48,22,5.28,"PAH",684,1,8,0)="VSE-8783: BF - VistA: Modify SDES2 CREATE APPT REQUEST to update the new "
^DIC(9.4,48,22,5.28,"PAH",684,1,9,0)="          duplicate reason"
^DIC(9.4,48,22,5.28,"PAH",684,1,10,0)="VSE-8819: BF - VistA: Modify SDES2 CREATE CLIN AVAILABILITY to add an "
^DIC(9.4,48,22,5.28,"PAH",684,1,11,0)="          error check"
^DIC(9.4,48,22,5.28,"PAH",684,1,12,0)="VSE-8820: FF - VS GUI: Modify the call to SDES GET MISSION ACT ELIG so "
^DIC(9.4,48,22,5.28,"PAH",684,1,13,0)="          that the system is passing the FileEntryDate date instead of the"
^DIC(9.4,48,22,5.28,"PAH",684,1,14,0)="          PID date"
^DIC(9.4,48,22,5.28,"PAH",684,1,15,0)="VSE-8857: BF - VistA: Modify block and move functionality to allow a "
^DIC(9.4,48,22,5.28,"PAH",684,1,16,0)="          variable length appointment to be moved to another variable"
