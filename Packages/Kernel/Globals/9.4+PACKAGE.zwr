^DIC(9.4,14,22,5.9,"PAH",170,1,1,0)="VISTA Laboratory Clinical Indicator Data Capture (Patch LR*5.2*291)"
^DIC(9.4,14,22,5.9,"PAH",171,0)="355 SEQ #269^3060608^1"
