^DIC(9.4,99,22,8,"PAH",4,0)="10^2961017^1"
^DIC(9.4,99,22,8,"PAH",4,1,0)="^^1^1^2961017"
^DIC(9.4,99,22,8,"PAH",4,1,1,0)="This distribution provides the ability to close and delete EEO cases."
^DIC(9.4,99,22,8,"PAH",5,0)="12 SEQ #10^3250204.153122^89"
^DIC(9.4,99,22,8,"PAH",5,1,0)="^^6^6^3250204"
^DIC(9.4,99,22,8,"PAH",5,1,1,0)=" "
^DIC(9.4,99,22,8,"PAH",5,1,2,0)="EEO patch EEO*2*12 will mark all EEO Complaint Tracking Options "
^DIC(9.4,99,22,8,"PAH",5,1,3,0)="out of order with the following message: "
^DIC(9.4,99,22,8,"PAH",5,1,4,0)="""Diabled-use EEO Eco-Case Management System (eSquared CSM)"". "
^DIC(9.4,99,22,8,"PAH",5,1,5,0)="It will also dequeue the EEO TASKED BULLETIN option which transmits"
^DIC(9.4,99,22,8,"PAH",5,1,6,0)="formal complaints marked for transmission."
