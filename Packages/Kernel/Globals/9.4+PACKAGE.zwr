^DIC(9.4,14,22,5.9,"PAH",117,1,95,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,96,0)="   The following software and documentation files are exported as part of"
^DIC(9.4,14,22,5.9,"PAH",117,1,97,0)="   this patch:"
^DIC(9.4,14,22,5.9,"PAH",117,1,98,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,99,0)="    File Name           Contents                         Retrieval Format"
^DIC(9.4,14,22,5.9,"PAH",117,1,100,0)="    ---------           --------                         ----------------"
^DIC(9.4,14,22,5.9,"PAH",117,1,101,0)="    LAB_LEDI_II.KID     LA*5.2*46 KIDS build                 ASCII"
^DIC(9.4,14,22,5.9,"PAH",117,1,102,0)="                        LR*5.2*222 KIDS build"
^DIC(9.4,14,22,5.9,"PAH",117,1,103,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,104,0)="    LAB_LEDI_II_IG.PDF  LABORATORY ELECTRONIC DATA           BINARY"
^DIC(9.4,14,22,5.9,"PAH",117,1,105,0)="    LAB_LEDI_II_IG.DOC   INTERCHANGE PHASE II (LEDI II)"
^DIC(9.4,14,22,5.9,"PAH",117,1,106,0)="                         INSTALLATION GUIDE"
^DIC(9.4,14,22,5.9,"PAH",117,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,108,0)="    LAB_LEDI_II_UM.PDF  LABORATORY ELECTRONIC DATA           BINARY"
^DIC(9.4,14,22,5.9,"PAH",117,1,109,0)="    LAB_LEDI_II_UM.DOC   INTERCHANGE PHASE II (LEDI II)"
^DIC(9.4,14,22,5.9,"PAH",117,1,110,0)="                         USER MANUAL"
^DIC(9.4,14,22,5.9,"PAH",117,1,111,0)="  "
^DIC(9.4,14,22,5.9,"PAH",117,1,112,0)="   The software files are available on one of the following OI Field"
^DIC(9.4,14,22,5.9,"PAH",117,1,113,0)="   Offices' ANONYMOUS.SOFTWARE directories."
^DIC(9.4,14,22,5.9,"PAH",117,1,114,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,115,0)="   All sites are encouraged to use their FTP capability to obtain these"
^DIC(9.4,14,22,5.9,"PAH",117,1,116,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,14,22,5.9,"PAH",117,1,117,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,14,22,5.9,"PAH",117,1,118,0)="   are located."
^DIC(9.4,14,22,5.9,"PAH",117,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,120,0)="      OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,14,22,5.9,"PAH",117,1,121,0)="      ===============    ===========                ========="
^DIC(9.4,14,22,5.9,"PAH",117,1,122,0)="      ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,14,22,5.9,"PAH",117,1,123,0)="      HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,14,22,5.9,"PAH",117,1,124,0)="      SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,14,22,5.9,"PAH",117,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,127,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,128,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",117,1,129,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",117,1,130,0)="  The instructions for installation of the software are included in the"
^DIC(9.4,14,22,5.9,"PAH",117,1,131,0)="  installation guide."
^DIC(9.4,14,22,5.9,"PAH",117,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,134,0)="POST-INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",117,1,135,0)="------------------------------"
^DIC(9.4,14,22,5.9,"PAH",117,1,136,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,137,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,138,0)="  The post-instructions for installation of the software are included in"
^DIC(9.4,14,22,5.9,"PAH",117,1,139,0)="  the installation guide."
^DIC(9.4,14,22,5.9,"PAH",117,1,140,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,141,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,142,0)="INSTALLATION EXAMPLE"
^DIC(9.4,14,22,5.9,"PAH",117,1,143,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",117,1,144,0)=" "
^DIC(9.4,14,22,5.9,"PAH",117,1,145,0)="  An installation example is included in the installation guide."
^DIC(9.4,14,22,5.9,"PAH",118,0)="279 SEQ #216^3020315^1"
^DIC(9.4,14,22,5.9,"PAH",118,1,0)="^^582^582^3020315"
^DIC(9.4,14,22,5.9,"PAH",118,1,1,0)="VISTA Laboratory Package patch LR*5.2*279 contains no changes to "
^DIC(9.4,14,22,5.9,"PAH",118,1,2,0)="software controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK "
^DIC(9.4,14,22,5.9,"PAH",118,1,3,0)="SOFTWARE."
^DIC(9.4,14,22,5.9,"PAH",118,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,5,0)="The patch provides the following:"
^DIC(9.4,14,22,5.9,"PAH",118,1,6,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,7,0)=" 1.      Historical LOINC mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,8,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,9,0)="This patch contains options and software required to perform historical "
^DIC(9.4,14,22,5.9,"PAH",118,1,10,0)="LOINC mapping of CH subscripted verified results. The software will use "
^DIC(9.4,14,22,5.9,"PAH",118,1,11,0)="the existing LOINC mapping configuration defined in WKLD CODE (#64) file. "
^DIC(9.4,14,22,5.9,"PAH",118,1,12,0)="This file's definition will be used to determine the LOINC code to be "
^DIC(9.4,14,22,5.9,"PAH",118,1,13,0)="assigned to a given result. The historical mapping process extends to the "
^DIC(9.4,14,22,5.9,"PAH",118,1,14,0)="past 5-6 years of verified 'CH' subscripted data."
^DIC(9.4,14,22,5.9,"PAH",118,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,16,0)=" Information on the historical LOINC mapping process:"
^DIC(9.4,14,22,5.9,"PAH",118,1,17,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,18,0)="The historical mapping is an option that cannot be queued. Installation "
^DIC(9.4,14,22,5.9,"PAH",118,1,19,0)="of this patch provides options to perform historical mapping of verified  "
^DIC(9.4,14,22,5.9,"PAH",118,1,20,0)="'CH' subscripted tests."
^DIC(9.4,14,22,5.9,"PAH",118,1,21,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,22,0)="Historical LOINC mapping is a disk and system intensive process."
^DIC(9.4,14,22,5.9,"PAH",118,1,23,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,24,0)="Journaling has not been a problem at test sites, but with any conversion "
^DIC(9.4,14,22,5.9,"PAH",118,1,25,0)="process, journal files should be monitored.  Temporary data is stored in "
^DIC(9.4,14,22,5.9,"PAH",118,1,26,0)="the ^XTMP Global. A significant amount of LOINC code related data will be "
^DIC(9.4,14,22,5.9,"PAH",118,1,27,0)="set into the ^LR( global."
^DIC(9.4,14,22,5.9,"PAH",118,1,28,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,29,0)="The Historical Mapper functions should be run during a 24 hour period of "
^DIC(9.4,14,22,5.9,"PAH",118,1,30,0)="low system demand. Typically this would be during a week end."
^DIC(9.4,14,22,5.9,"PAH",118,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,32,0)="2.    Installs 'LRRESOURCE' Resource Device"
^DIC(9.4,14,22,5.9,"PAH",118,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,34,0)="This patch will install a new resource device called 'LRRESOURCE'. This "
^DIC(9.4,14,22,5.9,"PAH",118,1,35,0)="device is installed with eight slots. The number of slots determines the "
^DIC(9.4,14,22,5.9,"PAH",118,1,36,0)="number of active LOINC mapping background tasks. The maximum number of "
^DIC(9.4,14,22,5.9,"PAH",118,1,37,0)="concurrently running background tasks is eight, the number of slots "
^DIC(9.4,14,22,5.9,"PAH",118,1,38,0)="defined in LRRESOURCE. If the user adjusts the number slots of the "
^DIC(9.4,14,22,5.9,"PAH",118,1,39,0)="resource device, it must have at least one slot to initiate the mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,40,0)="process. Reducing the number of slots will increase the total mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,41,0)="processing time. Increasing the number of resource slots may NOT reduce "
^DIC(9.4,14,22,5.9,"PAH",118,1,42,0)="the total mapping processing time."
^DIC(9.4,14,22,5.9,"PAH",118,1,43,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,44,0)="  The Mapping Process in Detail"
^DIC(9.4,14,22,5.9,"PAH",118,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,46,0)="The LOINC mapping processes are divided in to batches of 20,000 LRDFN "
^DIC(9.4,14,22,5.9,"PAH",118,1,47,0)="records each. The number of batches are determined by the number of "
^DIC(9.4,14,22,5.9,"PAH",118,1,48,0)="records found in the LAB DATA (#63) file. One could estimate the number "
^DIC(9.4,14,22,5.9,"PAH",118,1,49,0)="of batches by dividing the number of LRDFN records by 20,000. If more "
^DIC(9.4,14,22,5.9,"PAH",118,1,50,0)="than eight mapping tasks are required, the remainder tasks will "
^DIC(9.4,14,22,5.9,"PAH",118,1,51,0)="automatically start when a resource slot becomes available. Resource "
^DIC(9.4,14,22,5.9,"PAH",118,1,52,0)="slots become available when a mapping sequence batch runs to completion."
^DIC(9.4,14,22,5.9,"PAH",118,1,53,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,54,0)="The objective of the mapping batch size and number is to ensure mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,55,0)="is completed within twenty-four (24) hours. After benchmarking timing "
^DIC(9.4,14,22,5.9,"PAH",118,1,56,0)="exercises, it has been determined that eight batch jobs of 20,000 records "
^DIC(9.4,14,22,5.9,"PAH",118,1,57,0)="each would achieve the mapping time goal."
^DIC(9.4,14,22,5.9,"PAH",118,1,58,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,59,0)="Each LRDFN in a batch that is not from LAB CONTROL NAME (#62.3) file, is "
^DIC(9.4,14,22,5.9,"PAH",118,1,60,0)="checked to determine if NEW PERSON CONVERSION (.12) field of sub-multiple "
^DIC(9.4,14,22,5.9,"PAH",118,1,61,0)="CHEM, HEM, TOX, RIA, SER, etc. (#4) of the LAB DATA (#63) file has a "
^DIC(9.4,14,22,5.9,"PAH",118,1,62,0)="designation of 2. If the check is satisfied the process continues for "
^DIC(9.4,14,22,5.9,"PAH",118,1,63,0)="that LRDFN's inverse date time sub-file."
^DIC(9.4,14,22,5.9,"PAH",118,1,64,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,65,0)="Each data name (test) of the CH subscript is subjected to a lookup "
^DIC(9.4,14,22,5.9,"PAH",118,1,66,0)="process to determine the RESULT NLT CODE (#64.1) field of the LABORATORY "
^DIC(9.4,14,22,5.9,"PAH",118,1,67,0)="TEST (#60) file."
^DIC(9.4,14,22,5.9,"PAH",118,1,68,0)="This value is stored in the "
^DIC(9.4,14,22,5.9,"PAH",118,1,69,0)=" ^XTMP(""LRLNC63"",1,DATANAME IEN)=Result NLT Code."
^DIC(9.4,14,22,5.9,"PAH",118,1,70,0)=" ^XTMP(""LRLNC63"",1,2) = 84330.0000"
^DIC(9.4,14,22,5.9,"PAH",118,1,71,0)=" ^XTMP(""LRLNC63"",1,3) = 84520.0000"
^DIC(9.4,14,22,5.9,"PAH",118,1,72,0)=" ^XTMP(""LRLNC63"",1,4) = 82565.0000"
^DIC(9.4,14,22,5.9,"PAH",118,1,73,0)=" ^XTMP(""LRLNC63"",1,5) = 84295.0000"
^DIC(9.4,14,22,5.9,"PAH",118,1,74,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,75,0)="The software then performs a LOINC lookup using the data from the "
^DIC(9.4,14,22,5.9,"PAH",118,1,76,0)="DATANAME subscripted node [^XTMP(""LRLNC63"", 1,DATANAME)] global and the "
^DIC(9.4,14,22,5.9,"PAH",118,1,77,0)="file definitions of WKLD CODE file to determine the LOINC code for the "
^DIC(9.4,14,22,5.9,"PAH",118,1,78,0)="result. If a LOINC code is found the value is stored in the third '^' "
^DIC(9.4,14,22,5.9,"PAH",118,1,79,0)="piece in the third piece of '!' delimited field."
^DIC(9.4,14,22,5.9,"PAH",118,1,80,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,81,0)=" ^LR(713,""CH"",6979880.8746,357)=75^^84009.0000!84009.0000!"
^DIC(9.4,14,22,5.9,"PAH",118,1,82,0)=" [27057]!3103!1^104^72!50!220!!!!UG/ML!!!75^^^^170^1 "
^DIC(9.4,14,22,5.9,"PAH",118,1,83,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,84,0)=" Where [27057] is the LOINC code."
^DIC(9.4,14,22,5.9,"PAH",118,1,85,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,86,0)="The last LRDFN processed record for each batch (sequence) is stored in "
^DIC(9.4,14,22,5.9,"PAH",118,1,87,0)="the ^XTMP(""LRLNC63"",""SEQ"",#). Where '#' is the batch sequence number in "
^DIC(9.4,14,22,5.9,"PAH",118,1,88,0)="increments of 20,000."
^DIC(9.4,14,22,5.9,"PAH",118,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,90,0)="Other information stored in the ^XTMP global are:"
^DIC(9.4,14,22,5.9,"PAH",118,1,91,0)=" ^XTMP(""LRLNC63"",""SEQ"",#,""START"")=FileMan date/time"
^DIC(9.4,14,22,5.9,"PAH",118,1,92,0)=" ^XTMP(""LRLNC63"",""SEQ"",#,""END"")=FileMan date/time"
^DIC(9.4,14,22,5.9,"PAH",118,1,93,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,94,0)="The time difference between the START and END nodes represent the lapse "
^DIC(9.4,14,22,5.9,"PAH",118,1,95,0)="time for that batch's LOINC mapping."
^DIC(9.4,14,22,5.9,"PAH",118,1,96,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,97,0)="Status activity of the mapping process is reported to the LMI mail group "
^DIC(9.4,14,22,5.9,"PAH",118,1,98,0)="via VistA Alerts. An alert is generated when each batch process is "
^DIC(9.4,14,22,5.9,"PAH",118,1,99,0)="started. An alert is also generated when each batch reaches completion or "
^DIC(9.4,14,22,5.9,"PAH",118,1,100,0)="is terminated by the user. If the process runs successfully to "
^DIC(9.4,14,22,5.9,"PAH",118,1,101,0)="completion, there will be an END alert for each START alert for each "
^DIC(9.4,14,22,5.9,"PAH",118,1,102,0)="batch sequence number."
^DIC(9.4,14,22,5.9,"PAH",118,1,103,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,104,0)="It has been seen at some test sites that the LRDFN may not be in the "
^DIC(9.4,14,22,5.9,"PAH",118,1,105,0)="proper form.  Test sites have seen the LRDFN set to an inverse date/time "
^DIC(9.4,14,22,5.9,"PAH",118,1,106,0)="(LRIDT) value, and in some cases the LRDFN contained a decimal "
^DIC(9.4,14,22,5.9,"PAH",118,1,107,0)="(ex.123.5). If such a situation is discovered during the LOINC mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,108,0)="process, a properly formatted LRDFN will be created in the ^LR(0) global"
^DIC(9.4,14,22,5.9,"PAH",118,1,109,0)="as the next available LRDFN."
^DIC(9.4,14,22,5.9,"PAH",118,1,110,0)="There is a special sequence number (9999999) assigned to those LRDFNs"
^DIC(9.4,14,22,5.9,"PAH",118,1,111,0)="having LRIDT like format. This sequence will only be established if"
^DIC(9.4,14,22,5.9,"PAH",118,1,112,0)="required. "
^DIC(9.4,14,22,5.9,"PAH",118,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,114,0)="Most sites will not have a 9999999 batch sequence number."
^DIC(9.4,14,22,5.9,"PAH",118,1,115,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,116,0)=" NEW OPTIONS:"
^DIC(9.4,14,22,5.9,"PAH",118,1,117,0)=" ============"
^DIC(9.4,14,22,5.9,"PAH",118,1,118,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,119,0)="The following options are provided to manage the LOINC mapping processes. "
^DIC(9.4,14,22,5.9,"PAH",118,1,120,0)="They are contained on the LOINC Historical Mapping Menu [LR LOINC "
^DIC(9.4,14,22,5.9,"PAH",118,1,121,0)="HISTORICAL MAP MENU]. This menu is locked with the XUPROGMODE security "
^DIC(9.4,14,22,5.9,"PAH",118,1,122,0)="key and located under the LOINC Mapping Utility Menu [LR LOINC UTILITY]."
^DIC(9.4,14,22,5.9,"PAH",118,1,123,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,124,0)="It is highly recommend that options provided by this patch be run during "
^DIC(9.4,14,22,5.9,"PAH",118,1,125,0)="a 24 hour period of low system usage. Normally this would be during the "
^DIC(9.4,14,22,5.9,"PAH",118,1,126,0)="week end. "
^DIC(9.4,14,22,5.9,"PAH",118,1,127,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,129,0)="A. LAB DATA LOINC Mapping [LR LOINC HISTORICAL MAPPER 63] option"
^DIC(9.4,14,22,5.9,"PAH",118,1,130,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,131,0)="This is the primary historical LOINC mapping option that must be run at "
^DIC(9.4,14,22,5.9,"PAH",118,1,132,0)="least once to update ^LR with appropriate LOINC mapping codes. This "
^DIC(9.4,14,22,5.9,"PAH",118,1,133,0)="option can be run multiple times if required. This option will initiate "
^DIC(9.4,14,22,5.9,"PAH",118,1,134,0)="the required number of background tasks to inspect the entire LAB DATA "
^DIC(9.4,14,22,5.9,"PAH",118,1,135,0)="file and map verified CH subscripted tests with LOINC codes. This option "
^DIC(9.4,14,22,5.9,"PAH",118,1,136,0)="should only be run during a 24-hour period when the system has low user "
^DIC(9.4,14,22,5.9,"PAH",118,1,137,0)="activity. Note: This option is used also to restart the mapping process "
^DIC(9.4,14,22,5.9,"PAH",118,1,138,0)="from the point of interruption. The mapping process will continue until "
^DIC(9.4,14,22,5.9,"PAH",118,1,139,0)="all LRDFNs have been inspected."
^DIC(9.4,14,22,5.9,"PAH",118,1,140,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,141,0)="The option is Locked by the XUPROGMODE security key."
^DIC(9.4,14,22,5.9,"PAH",118,1,142,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,143,0)="Example of the option: User's responce inclosed in < >"
^DIC(9.4,14,22,5.9,"PAH",118,1,144,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,145,0)="Select LOINC Mapping Utility Menu Option:"
^DIC(9.4,14,22,5.9,"PAH",118,1,146,0)="   LOINC Historical Mapping Menu"
^DIC(9.4,14,22,5.9,"PAH",118,1,147,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,148,0)=" Select LOINC Historical Mapping Menu Option: ?"
^DIC(9.4,14,22,5.9,"PAH",118,1,149,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,150,0)="    1       LAB DATA LOINC Mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,151,0)="    2       Restart LOINC Historical Mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,152,0)="    3       STOP LOINC Mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,153,0)="    4       Modify LOINC Historical Mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,154,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,155,0)=" Select LOINC Historical Mapping Menu Option: <1>  "
^DIC(9.4,14,22,5.9,"PAH",118,1,156,0)=" D STOP^LRLNC63 to stop all background historical mapping.         "
^DIC(9.4,14,22,5.9,"PAH",118,1,157,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,158,0)=" This option should be run during 24 hour off peak time frame!!"
^DIC(9.4,14,22,5.9,"PAH",118,1,159,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,160,0)="  This option will queue multiple tasks to LOINC map               "
^DIC(9.4,14,22,5.9,"PAH",118,1,161,0)="          historical data in the LAB DATA (#63).                     "
^DIC(9.4,14,22,5.9,"PAH",118,1,162,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,163,0)=" Are you certain you wish to proceed? <YES>"
^DIC(9.4,14,22,5.9,"PAH",118,1,164,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,165,0)=" LRDFN Conversion Sequence 1-20001 Task number is 8718"
^DIC(9.4,14,22,5.9,"PAH",118,1,166,0)=" LRDFN Conversion Sequence 20001-40001 Task number is 8719"
^DIC(9.4,14,22,5.9,"PAH",118,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,168,0)="End of Option example:"
^DIC(9.4,14,22,5.9,"PAH",118,1,169,0)="=========="
^DIC(9.4,14,22,5.9,"PAH",118,1,170,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,171,0)="After successful completion of LOINC mapping for all tasks, the members "
^DIC(9.4,14,22,5.9,"PAH",118,1,172,0)="of the G.LMI mail group will receive two types of notifications:"
^DIC(9.4,14,22,5.9,"PAH",118,1,173,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,174,0)="1. MailMan message containing all tests that were not LOINC mapped"
^DIC(9.4,14,22,5.9,"PAH",118,1,175,0)="2. Mailman message containing all tests that were mapped. This message is "
^DIC(9.4,14,22,5.9,"PAH",118,1,176,0)="designed to be imported into a non VistA spread sheet program."
^DIC(9.4,14,22,5.9,"PAH",118,1,177,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,178,0)="Using these two reports, the LIM will be able to determine mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,179,0)="completeness and identify systematic mapping errors."
^DIC(9.4,14,22,5.9,"PAH",118,1,180,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,181,0)="Here is an example of each."
^DIC(9.4,14,22,5.9,"PAH",118,1,182,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,183,0)="Subj: LOINC Historical Mapping Exception Report  [#89761] 15 Feb 02 10:29"
^DIC(9.4,14,22,5.9,"PAH",118,1,184,0)="From: POSTMASTER (Sender: )  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,14,22,5.9,"PAH",118,1,185,0)="--------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",118,1,186,0)="List of tests missing RNLT codes in LABORTORY TEST (#60) file,"
^DIC(9.4,14,22,5.9,"PAH",118,1,187,0)="found during LOINC Historical Mapping process."
^DIC(9.4,14,22,5.9,"PAH",118,1,188,0)="These test(s) will have no historical LOINC mapping performed."
^DIC(9.4,14,22,5.9,"PAH",118,1,189,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,190,0)="[Test IEN]  Test Name  Type "
^DIC(9.4,14,22,5.9,"PAH",118,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,192,0)="[37] BLEEDING TIME -- Type: BOTH"
^DIC(9.4,14,22,5.9,"PAH",118,1,193,0)="[353] SPHEROCYTES -- Type: OUTPUT (CAN BE DISPLAYED)"
^DIC(9.4,14,22,5.9,"PAH",118,1,194,0)="[356] HYPERSEGMENTED NEUTROPHILS -- Type: BOTH"
^DIC(9.4,14,22,5.9,"PAH",118,1,195,0)="[357] SMUDGE CELLS -- Type: BOTH"
^DIC(9.4,14,22,5.9,"PAH",118,1,196,0)="[137] RPR -- Type: BOTH"
^DIC(9.4,14,22,5.9,"PAH",118,1,197,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,198,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,199,0)="Subj: LOINC Historical Mapped LOINC tests  [#89762] 15 Feb 02 10:29"
^DIC(9.4,14,22,5.9,"PAH",118,1,200,0)="From: POSTMASTER (Sender:)  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,14,22,5.9,"PAH",118,1,201,0)="--------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",118,1,202,0)="List of test mapped to LOINC codes formatted with '^' as field delimiter."
^DIC(9.4,14,22,5.9,"PAH",118,1,203,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,204,0)="DataName#^Test Name^Specimen^Specimen IEN^RNLT^NLT suffix^LOINC Code"
^DIC(9.4,14,22,5.9,"PAH",118,1,205,0)="2^GLUCOSE^PHARYNX^60^84330.0000^0^2339-0"
^DIC(9.4,14,22,5.9,"PAH",118,1,206,0)="2^GLUCOSE^BLOOD^70^84330.0000^0^2339-0"
