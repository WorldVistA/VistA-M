^DIC(9.4,48,22,5.28,"PAH",713,1,6,0)="VSE-10498: JS - VistA: Duplicate encounter/visit fix."
^DIC(9.4,48,22,5.28,"PAH",713,1,7,0)="VSE-10970: HC - VistA: Correct any invalid cancel message entries to"
^DIC(9.4,48,22,5.28,"PAH",713,1,8,0)="           the correct format. (SDES927P - Post-Install)"
^DIC(9.4,48,22,5.28,"PAH",713,1,9,0)="VSE-10974: GW - VistA: Correct an issue with SDES2 GET CANCELLED SLOTS "
^DIC(9.4,48,22,5.28,"PAH",713,1,10,0)="           for inactive clinics."
^DIC(9.4,48,22,5.28,"PAH",713,1,11,0)="VSE-11069: HC - VistA: Create a post-install to report on clinics that"
^DIC(9.4,48,22,5.28,"PAH",713,1,12,0)="           cannot determine time zone. (SDES927P - Post-Install)"
^DIC(9.4,48,22,5.28,"PAH",713,1,13,0)=" "
