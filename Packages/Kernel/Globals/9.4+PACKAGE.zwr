^DIC(9.4,184,5)="TROY"
^DIC(9.4,184,22,0)="^9.49I^1^1"
^DIC(9.4,184,22,1,0)="1.0^3051119^3020408^1"
^DIC(9.4,184,22,1,1,0)="^^2^2^3051119"
^DIC(9.4,184,22,1,1,1,0)="Beneficiary Travel v1.0.  Breakout of Beneficiary Travel (DGBT) from"
^DIC(9.4,184,22,1,1,2,0)="Registration (DG) v5.3."
^DIC(9.4,184,22,1,"PAH",0)="^9.4901^32^32"
^DIC(9.4,184,22,1,"PAH",1,0)="1 SEQ #1^3020506^1"
^DIC(9.4,184,22,1,"PAH",1,1,0)="^^12^12^3020506"
^DIC(9.4,184,22,1,"PAH",1,1,1,0)="Patch corrects mistyped calling routine when queuing report in option "
^DIC(9.4,184,22,1,"PAH",1,1,2,0)="'Standard Claims Output' in menu REPORT OF CLAIM AMOUNTS."
^DIC(9.4,184,22,1,"PAH",1,1,3,0)=" "
^DIC(9.4,184,22,1,"PAH",1,1,4,0)="QUE+2^DGBTUTQ (old)"
^DIC(9.4,184,22,1,"PAH",1,1,5,0)=" "
^DIC(9.4,184,22,1,"PAH",1,1,6,0)="I '$D(ZTRTN) S DGPGM=$S($D(DGPGM):DGPGM,$D(PGM):PGM,1:"""") G:DGPGM="""" CLO "
^DIC(9.4,184,22,1,"PAH",1,1,7,0)="SE S ZTRTN=""DQ^DGJUTQ"" "
^DIC(9.4,184,22,1,"PAH",1,1,8,0)=" "
^DIC(9.4,184,22,1,"PAH",1,1,9,0)="QUE+2^DGBTUTQ (new)"
^DIC(9.4,184,22,1,"PAH",1,1,10,0)=" "
^DIC(9.4,184,22,1,"PAH",1,1,11,0)="I '$D(ZTRTN) S DGPGM=$S($D(DGPGM):DGPGM,$D(PGM):PGM,1:"""") G:DGPGM="""" CLO "
^DIC(9.4,184,22,1,"PAH",1,1,12,0)="SE S ZTRTN=""DQ^DGBTUTQ"""
^DIC(9.4,184,22,1,"PAH",2,0)="2 SEQ #2^3030520^1"
^DIC(9.4,184,22,1,"PAH",2,1,0)="^^77^77^3030520"
^DIC(9.4,184,22,1,"PAH",2,1,1,0)="This patch provides Beneficiary Travel with the interface capabilities to"
^DIC(9.4,184,22,1,"PAH",2,1,2,0)="the Core Financial Logististics System (coreFLS).  coreFLS will replace"
^DIC(9.4,184,22,1,"PAH",2,1,3,0)="the Integrated Funds Distribution, Control Point Activity, and Procurement"
^DIC(9.4,184,22,1,"PAH",2,1,4,0)="(IFCAP) package."
^DIC(9.4,184,22,1,"PAH",2,1,5,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,6,0)="Vendor information for coreFLS will be remotely held on a national"
^DIC(9.4,184,22,1,"PAH",2,1,7,0)="database.  To aliviate traffic over a network system, a local vendor file,"
^DIC(9.4,184,22,1,"PAH",2,1,8,0)="LOCAL VENDOR (#392.31) will be accessed to retrieve frequently used"
^DIC(9.4,184,22,1,"PAH",2,1,9,0)="vendors."
^DIC(9.4,184,22,1,"PAH",2,1,10,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,11,0)="A new field is added to the Parameter Rates Enter/Edit option that will be"
^DIC(9.4,184,22,1,"PAH",2,1,12,0)="used to activate the coreFLS interface:"
^DIC(9.4,184,22,1,"PAH",2,1,13,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,14,0)="COREFLS ACTIVE:?"
^DIC(9.4,184,22,1,"PAH",2,1,15,0)="     Enter 'Yes' if using the coreFLS system for vendors."
^DIC(9.4,184,22,1,"PAH",2,1,16,0)="     Choose from: "
^DIC(9.4,184,22,1,"PAH",2,1,17,0)="       1        YES"
^DIC(9.4,184,22,1,"PAH",2,1,18,0)="       0        NO"
^DIC(9.4,184,22,1,"PAH",2,1,19,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,20,0)="Technical information."
^DIC(9.4,184,22,1,"PAH",2,1,21,0)="----------------------"
^DIC(9.4,184,22,1,"PAH",2,1,22,0)="Majority of coding enhancements are done in the DR strings of the DIE"
^DIC(9.4,184,22,1,"PAH",2,1,23,0)="call.  Each DR string calls a new routine, DGBTCLS. When a prompt for"
^DIC(9.4,184,22,1,"PAH",2,1,24,0)="COREFLS VENDOR is given an Output Tranform will set up a variable for its"
^DIC(9.4,184,22,1,"PAH",2,1,25,0)="previous entry.  If a response is given at the vendor prompt no Query to"
^DIC(9.4,184,22,1,"PAH",2,1,26,0)="coreFLS is given.  If the previous entry is the same as the current"
^DIC(9.4,184,22,1,"PAH",2,1,27,0)="response (including a <return>) the Query to coreFLS is given.  Reason for"
^DIC(9.4,184,22,1,"PAH",2,1,28,0)="this is:  New entries through Fileman to the local vendor file, LOCAL"
^DIC(9.4,184,22,1,"PAH",2,1,29,0)="VENDOR (#392.31) is forbidden (no LAYGO).  Adding new entries is done"
^DIC(9.4,184,22,1,"PAH",2,1,30,0)="only by querying and accepting a vendor through coreFLS.  Due to the local"
^DIC(9.4,184,22,1,"PAH",2,1,31,0)="file being no LAYGO and adding vendors is done through a different file"
^DIC(9.4,184,22,1,"PAH",2,1,32,0)="interface, the rule of querying coreFLS if the current and previous"
^DIC(9.4,184,22,1,"PAH",2,1,33,0)="entries are the same is used.  Example of this is:  User is prompted for"
^DIC(9.4,184,22,1,"PAH",2,1,34,0)="coreFLS Vendor and enters a name not found in the local vendor file, the"
^DIC(9.4,184,22,1,"PAH",2,1,35,0)="response is ??, the user must hit the <return> key to pass through.  At"
^DIC(9.4,184,22,1,"PAH",2,1,36,0)="this time previous and current values of vendor are the same, so the"
^DIC(9.4,184,22,1,"PAH",2,1,37,0)="prompt to Query coreFLS is given.  Only draw back is getting the prompt"
^DIC(9.4,184,22,1,"PAH",2,1,38,0)="when user is in edit mode and gets the Query coreFLS prompt when hitting"
^DIC(9.4,184,22,1,"PAH",2,1,39,0)="<return> through accepted reponses."
^DIC(9.4,184,22,1,"PAH",2,1,40,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,41,0)="View the DR strings to display executed calls."
^DIC(9.4,184,22,1,"PAH",2,1,42,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,43,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,44,0)="New Fields added with Output Transforms"
^DIC(9.4,184,22,1,"PAH",2,1,45,0)="---------------------------------------"
^DIC(9.4,184,22,1,"PAH",2,1,46,0)="File: BENEFICIARY TRAVEL CLAIM (#392)"
^DIC(9.4,184,22,1,"PAH",2,1,47,0)="   New Fields added: COREFLS CARRIER (#14)"
^DIC(9.4,184,22,1,"PAH",2,1,48,0)="   Output Transform: K DGBTPRV S DGBTPRV=$$PREV^DGBTCLS(.Y)"
^DIC(9.4,184,22,1,"PAH",2,1,49,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,50,0)="File: MAS PARAMETERS (#43)"
^DIC(9.4,184,22,1,"PAH",2,1,51,0)="   New Fields added: COREFLS ACTIVE (#723)"
^DIC(9.4,184,22,1,"PAH",2,1,52,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,53,0)="Options effected."
^DIC(9.4,184,22,1,"PAH",2,1,54,0)="-----------------"
^DIC(9.4,184,22,1,"PAH",2,1,55,0)="Parameter Rates Enter/Edit"
^DIC(9.4,184,22,1,"PAH",2,1,56,0)="Enter a Claim"
^DIC(9.4,184,22,1,"PAH",2,1,57,0)="Edit a Claim"
^DIC(9.4,184,22,1,"PAH",2,1,58,0)="Display a Claim"
^DIC(9.4,184,22,1,"PAH",2,1,59,0)="Standard Claims Output (by Carrier)"
^DIC(9.4,184,22,1,"PAH",2,1,60,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,61,0)="New menus added."
^DIC(9.4,184,22,1,"PAH",2,1,62,0)="----------------"
^DIC(9.4,184,22,1,"PAH",2,1,63,0)="Add a local vendor (COREFLS)"
^DIC(9.4,184,22,1,"PAH",2,1,64,0)="Update Local Vendor (COREFLS)"
^DIC(9.4,184,22,1,"PAH",2,1,65,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,66,0)="New Security key"
^DIC(9.4,184,22,1,"PAH",2,1,67,0)="----------------"
^DIC(9.4,184,22,1,"PAH",2,1,68,0)="DGBT LOCAL VENDOR"
^DIC(9.4,184,22,1,"PAH",2,1,69,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,70,0)="New Fields added with Output Transforms"
^DIC(9.4,184,22,1,"PAH",2,1,71,0)="---------------------------------------"
^DIC(9.4,184,22,1,"PAH",2,1,72,0)="File: BENEFICIARY TRAVEL CLAIM (#392)"
^DIC(9.4,184,22,1,"PAH",2,1,73,0)="   New Fields added: COREFLS CARRIER (#14)"
^DIC(9.4,184,22,1,"PAH",2,1,74,0)="   Output Transform: K DGBTPRV S DGBTPRV=$$PREV^DGBTCSL(.Y)"
^DIC(9.4,184,22,1,"PAH",2,1,75,0)=" "
^DIC(9.4,184,22,1,"PAH",2,1,76,0)="File: MAS PARAMETERS (#43)"
^DIC(9.4,184,22,1,"PAH",2,1,77,0)="   New Fields added: COREFLS ACTIVE (#723)"
^DIC(9.4,184,22,1,"PAH",3,0)="3 SEQ #3^3031107^1"
^DIC(9.4,184,22,1,"PAH",3,1,0)="^^4^4^3031107"
^DIC(9.4,184,22,1,"PAH",3,1,1,0)="1.  Correct 'BB' key index, then re-index cross reference."
^DIC(9.4,184,22,1,"PAH",3,1,2,0)=" "
^DIC(9.4,184,22,1,"PAH",3,1,3,0)="2.  Edit changes to the new 'BB' cross reference in routines; DGBTCSL and"
^DIC(9.4,184,22,1,"PAH",3,1,4,0)="    DGBTVUP."
^DIC(9.4,184,22,1,"PAH",4,0)="4 SEQ #4^3031126^1"
^DIC(9.4,184,22,1,"PAH",4,1,0)="^^7^7^3031126"
^DIC(9.4,184,22,1,"PAH",4,1,1,0)="This patch removes the [DGBT LOCAL VENDOR ADD] Add a local vendor "
^DIC(9.4,184,22,1,"PAH",4,1,2,0)="(COREFLS) and [DGBT LOCAL VENDOR UPDATE] Update a local vendor (COREFLS) "
^DIC(9.4,184,22,1,"PAH",4,1,3,0)="from the [DGBT BENE TRAVEL MENU] Beneficiary Travel Menu."
^DIC(9.4,184,22,1,"PAH",4,1,4,0)=" "
^DIC(9.4,184,22,1,"PAH",4,1,5,0)="It add a new menu option [DGBT LOCAL VENDOR MENU] Local Vendor (Task) "
^DIC(9.4,184,22,1,"PAH",4,1,6,0)="Menu with options [DGBT LOCAL VENDOR ADD] Add a local vendor (COREFLS) "
^DIC(9.4,184,22,1,"PAH",4,1,7,0)="and [DGBT LOCAL VENDOR UPDATE] Update a local vendor (COREFLS)."
^DIC(9.4,184,22,1,"PAH",5,0)="5 SEQ #5^3040131^1"
^DIC(9.4,184,22,1,"PAH",5,1,0)="^^3^3^3040131"
^DIC(9.4,184,22,1,"PAH",5,1,1,0)="This patch corrects the COMMA+3^%DTC:2, %DSM-E-STRLEN generated in the "
^DIC(9.4,184,22,1,"PAH",5,1,2,0)="STANDARD CLAIMS OUTPUT REPORT caused by leftover variable X3 from other "
^DIC(9.4,184,22,1,"PAH",5,1,3,0)="options."
^DIC(9.4,184,22,1,"PAH",6,0)="6 SEQ #6^3040330^1"
^DIC(9.4,184,22,1,"PAH",6,1,0)="^^6^6^3040330"
^DIC(9.4,184,22,1,"PAH",6,1,1,0)="Local Vendor (Task) Menu [DGBT LOCAL VENDOR MENU] will be renamed Local "
^DIC(9.4,184,22,1,"PAH",6,1,2,0)="Vendor Menu (COREFLS) [DGBT LOCAL VENDOR MENU] and added to the "
^DIC(9.4,184,22,1,"PAH",6,1,3,0)="Beneficiary Travel Menu [DGBT BENE TRAVEL MENU].  The key DGBT LOCAL "
^DIC(9.4,184,22,1,"PAH",6,1,4,0)="VENDOR will be added to the Local Vendor Menu (COREFLS) [DGBT LOCAL "
^DIC(9.4,184,22,1,"PAH",6,1,5,0)="VENDOR "
^DIC(9.4,184,22,1,"PAH",6,1,6,0)="MENU]."
^DIC(9.4,184,22,1,"PAH",7,0)="7 SEQ #7^3040702^1"
^DIC(9.4,184,22,1,"PAH",7,1,0)="^^2^2^3040702"
^DIC(9.4,184,22,1,"PAH",7,1,1,0)="Correct DGBT calls to COMMA^%DTC to confirm that the variable X3 used"
^DIC(9.4,184,22,1,"PAH",7,1,2,0)="is a clean copy."
^DIC(9.4,184,22,1,"PAH",8,0)="9 SEQ #8^3041111^1"
^DIC(9.4,184,22,1,"PAH",8,1,0)="^^1^1^3041111"
^DIC(9.4,184,22,1,"PAH",8,1,1,0)="Disable Corefls/Reversion back to VistA software ONLY."
^DIC(9.4,184,22,1,"PAH",9,0)="8^3041228^1"
^DIC(9.4,184,22,1,"PAH",10,0)="12 SEQ #10^3050212^1"
^DIC(9.4,184,22,1,"PAH",11,0)="11^3051115^1"
^DIC(9.4,184,22,1,"PAH",12,0)="13^3070629.195117^1"
^DIC(9.4,184,22,1,"PAH",12,1,0)="^^4^4^3070629"
^DIC(9.4,184,22,1,"PAH",12,1,1,0)="This patch contain routines that have been modified"
^DIC(9.4,184,22,1,"PAH",12,1,2,0)="to call the Scheduling Encapsulation API SDAPI^SDAMA301"
^DIC(9.4,184,22,1,"PAH",12,1,3,0)="instead of referencing the global for appointment data retrieval. "
^DIC(9.4,184,22,1,"PAH",12,1,4,0)="This patch also addresses the error handling when an error occurs."
^DIC(9.4,184,22,1,"PAH",13,0)="14 SEQ #15^3080203.224902^1"
^DIC(9.4,184,22,1,"PAH",13,1,0)="^^4^4^3080203"
^DIC(9.4,184,22,1,"PAH",13,1,1,0)=" "
^DIC(9.4,184,22,1,"PAH",13,1,2,0)="This patch removes the ability to edit Beneficiary Travel"
^DIC(9.4,184,22,1,"PAH",13,1,3,0)="reimbursement rates and inserts the 02/01/2008 rates into"
^DIC(9.4,184,22,1,"PAH",13,1,4,0)="the MAS EVENT RATES (#43.1) file."
^DIC(9.4,184,22,1,"PAH",14,0)="16 SEQ #17^3090422.130302^17"
^DIC(9.4,184,22,1,"PAH",14,1,0)="^^2^2^3090422"
^DIC(9.4,184,22,1,"PAH",14,1,1,0)="THIS PATCH WILL INSERT THE 11/17/2008 RATES INTO THE MAS EVENT RATES "
^DIC(9.4,184,22,1,"PAH",14,1,2,0)="(43.1) FILE"
^DIC(9.4,184,22,1,"PAH",15,0)="17 SEQ #18^3090422.162233^17"
^DIC(9.4,184,22,1,"PAH",15,1,0)="^^1^1^3090422"
^DIC(9.4,184,22,1,"PAH",15,1,1,0)="Update Beneficiary Travel Deductible Rates"
^DIC(9.4,184,22,1,"PAH",16,0)="18 SEQ #19^3120329.183135^17"
^DIC(9.4,184,22,1,"PAH",16,1,0)="^^6^6^3120329"
^DIC(9.4,184,22,1,"PAH",16,1,1,0)="This patch addresses these issues:"
^DIC(9.4,184,22,1,"PAH",16,1,2,0)="- updates the DD in the Beneficiary Travel Claim File (#392) to meet "
^DIC(9.4,184,22,1,"PAH",16,1,3,0)="VA SAC in regards to $NEXT commands."
^DIC(9.4,184,22,1,"PAH",16,1,4,0)="- Prints the second line of an address in the VA 70-3542d form"
^DIC(9.4,184,22,1,"PAH",16,1,5,0)="- Corrects the calculations used to find the default mileage value."
^DIC(9.4,184,22,1,"PAH",16,1,6,0)="- Allows a lowercase ""p"" to print the VA 70-3542d form."
^DIC(9.4,184,22,1,"PAH",17,0)="19 SEQ #20^3120829.125814^17"
^DIC(9.4,184,22,1,"PAH",17,1,0)="^^1^1^3120829"
^DIC(9.4,184,22,1,"PAH",17,1,1,0)="Beneficiary Travel Dashboard"
^DIC(9.4,184,22,1,"PAH",18,0)="20^3130312.135443^17"
^DIC(9.4,184,22,1,"PAH",18,1,0)="^^2^2^3130312"
^DIC(9.4,184,22,1,"PAH",18,1,1,0)="Contains enhancements for Beneficiary Travel Package and "
^DIC(9.4,184,22,1,"PAH",18,1,2,0)="Mileage Reporting System."
^DIC(9.4,184,22,1,"PAH",19,0)="21 SEQ #23^3131217.105542^17"
^DIC(9.4,184,22,1,"PAH",19,1,0)="^^15^15^3131217"
^DIC(9.4,184,22,1,"PAH",19,1,1,0)="This patch addresses 4 issues:"
^DIC(9.4,184,22,1,"PAH",19,1,2,0)=" "
^DIC(9.4,184,22,1,"PAH",19,1,3,0)="   1. A subscript error occurs when printing the ""Standard Claims Output"""
^DIC(9.4,184,22,1,"PAH",19,1,4,0)="      report from the Report of Claim Amounts [DGBT BENE TRAVEL REPORT] "
^DIC(9.4,184,22,1,"PAH",19,1,5,0)="      option."
^DIC(9.4,184,22,1,"PAH",19,1,6,0)=" "
^DIC(9.4,184,22,1,"PAH",19,1,7,0)="   2. Entry cannot be processed since the seconds portion of the Claim"
^DIC(9.4,184,22,1,"PAH",19,1,8,0)="      DATE/TIME (#.(#.01) field of the BENEFICIARY TRAVEL CLAIM (#392) "
^DIC(9.4,184,22,1,"PAH",19,1,9,0)="      file is equal to 60.  "
^DIC(9.4,184,22,1,"PAH",19,1,10,0)=" "
^DIC(9.4,184,22,1,"PAH",19,1,11,0)="   3. The CBO has requested that the Default Mileage be removed when using"
^DIC(9.4,184,22,1,"PAH",19,1,12,0)="      the Claim Enter/Edit [DGBT BENE TRAVEL SCREEN] option."
^DIC(9.4,184,22,1,"PAH",19,1,13,0)=" "
^DIC(9.4,184,22,1,"PAH",19,1,14,0)="   4. When using the View of Claim [DGBT BENE TRAVEL VIEW] option, the "
^DIC(9.4,184,22,1,"PAH",19,1,15,0)="      ""Auth. Person"" will change to whoever is printing the report."
^DIC(9.4,184,22,1,"PAH",20,0)="24^3140324.154004^17"
^DIC(9.4,184,22,1,"PAH",20,1,0)="^^2^2^3140324"
^DIC(9.4,184,22,1,"PAH",20,1,1,0)="Modifications to the Beneficiary Travel Claims screen<1> for Veterans"
^DIC(9.4,184,22,1,"PAH",20,1,2,0)="Financial Assesment discontinuation of Means Test Expirations."
^DIC(9.4,184,22,1,"PAH",21,0)="22 SEQ #25^3140519.112414^17"
^DIC(9.4,184,22,1,"PAH",21,1,0)="^^16^16^3140519"
^DIC(9.4,184,22,1,"PAH",21,1,1,0)="This patch addresses five issues:"
^DIC(9.4,184,22,1,"PAH",21,1,2,0)=" "
^DIC(9.4,184,22,1,"PAH",21,1,3,0)="1. After the release of patch DGBT*1.0*20, it is possible to "
^DIC(9.4,184,22,1,"PAH",21,1,4,0)="   inadvertently modify the Division of existing claims."
^DIC(9.4,184,22,1,"PAH",21,1,5,0)=" "
^DIC(9.4,184,22,1,"PAH",21,1,6,0)="2. Special Mode claims are being rejected, with a generic  ""DATA DID "
^DIC(9.4,184,22,1,"PAH",21,1,7,0)="   NOT FILE DUE TO ERRORS"" message."
^DIC(9.4,184,22,1,"PAH",21,1,8,0)="     "
^DIC(9.4,184,22,1,"PAH",21,1,9,0)="3. Users are reporting getting an <UNDEFINED>COMPLT+3^DGBTE *% error "
^DIC(9.4,184,22,1,"PAH",21,1,10,0)="   when entering claims."
^DIC(9.4,184,22,1,"PAH",21,1,11,0)="   "
^DIC(9.4,184,22,1,"PAH",21,1,12,0)="4. A subscript error occurs when using the View of Claim "
^DIC(9.4,184,22,1,"PAH",21,1,13,0)="   [DGBT BENE TRAVEL VIEW] option."
^DIC(9.4,184,22,1,"PAH",21,1,14,0)=" "
^DIC(9.4,184,22,1,"PAH",21,1,15,0)="5. Users are being returned to the Beneficiary Travel Menu [DGBT BENE "
^DIC(9.4,184,22,1,"PAH",21,1,16,0)="   TRAVEL MENU] after completing a claim."
^DIC(9.4,184,22,1,"PAH",22,0)="25 SEQ #27^3150916.112545^17"
^DIC(9.4,184,22,1,"PAH",22,1,0)="^^17^17^3150916"
^DIC(9.4,184,22,1,"PAH",22,1,1,0)="This patch addresses 6 issues:"
^DIC(9.4,184,22,1,"PAH",22,1,2,0)="  "
^DIC(9.4,184,22,1,"PAH",22,1,3,0)="    1. Beneficiary Travel is not correctly calculating the total monthly "
^DIC(9.4,184,22,1,"PAH",22,1,4,0)="       deductible."
^DIC(9.4,184,22,1,"PAH",22,1,5,0)="  "
^DIC(9.4,184,22,1,"PAH",22,1,6,0)="    2. The WHO ENTERED INTO FILE (#12) and DATE ENTERED INTO THE FILE "
^DIC(9.4,184,22,1,"PAH",22,1,7,0)="       (#13) fields of the BENEFICIARY TRAVEL CLAIM (#392) file are blank."
^DIC(9.4,184,22,1,"PAH",22,1,8,0)="  "
^DIC(9.4,184,22,1,"PAH",22,1,9,0)="    3. A correction is needed for the help text when entering a Special "
^DIC(9.4,184,22,1,"PAH",22,1,10,0)="       Mode claim."
^DIC(9.4,184,22,1,"PAH",22,1,11,0)="  "
^DIC(9.4,184,22,1,"PAH",22,1,12,0)="    4. The departure and destination information is missing."
^DIC(9.4,184,22,1,"PAH",22,1,13,0)="  "
^DIC(9.4,184,22,1,"PAH",22,1,14,0)="    5. Special Mode accounts are not being selected correctly."
^DIC(9.4,184,22,1,"PAH",22,1,15,0)=" "
^DIC(9.4,184,22,1,"PAH",22,1,16,0)="    6. The proper Division is not being retained when editing the denial "
^DIC(9.4,184,22,1,"PAH",22,1,17,0)="       letter."
^DIC(9.4,184,22,1,"PAH",23,0)="28 SEQ #30^3161007.150832^54"
^DIC(9.4,184,22,1,"PAH",23,1,0)="^^18^18^3161007"
^DIC(9.4,184,22,1,"PAH",23,1,1,0)=" This patch addresses 7 issues:"
^DIC(9.4,184,22,1,"PAH",23,1,2,0)="  "
^DIC(9.4,184,22,1,"PAH",23,1,3,0)="    1. The Report Of Claim Amounts report is not displaying values for "
^DIC(9.4,184,22,1,"PAH",23,1,4,0)="       Special Mode claims."
^DIC(9.4,184,22,1,"PAH",23,1,5,0)="  "
^DIC(9.4,184,22,1,"PAH",23,1,6,0)="    2. The Bene Travel software is incorrectly displaying 9 digit zip "
^DIC(9.4,184,22,1,"PAH",23,1,7,0)="       codes."
^DIC(9.4,184,22,1,"PAH",23,1,8,0)="  "
^DIC(9.4,184,22,1,"PAH",23,1,9,0)="    3. The denial letter is not printing the correct user name."
^DIC(9.4,184,22,1,"PAH",23,1,10,0)="  "
^DIC(9.4,184,22,1,"PAH",23,1,11,0)="    4. There is duplicate wording in the denial letter template."
^DIC(9.4,184,22,1,"PAH",23,1,12,0)=" "
^DIC(9.4,184,22,1,"PAH",23,1,13,0)="    5. Special Mode claims are incorrectly displaying 'One Way' every "
^DIC(9.4,184,22,1,"PAH",23,1,14,0)="       time."
^DIC(9.4,184,22,1,"PAH",23,1,15,0)=" "
^DIC(9.4,184,22,1,"PAH",23,1,16,0)="    6. An undefined error occurs when there is single division."
^DIC(9.4,184,22,1,"PAH",23,1,17,0)=" "
^DIC(9.4,184,22,1,"PAH",23,1,18,0)="    7. Existing claims are being erased."
^DIC(9.4,184,22,1,"PAH",24,0)="30 SEQ #31^3161220.150231^54"
^DIC(9.4,184,22,1,"PAH",24,1,0)="^^5^5^3161220"
^DIC(9.4,184,22,1,"PAH",24,1,1,0)="This patch addresses 2 issues:"
^DIC(9.4,184,22,1,"PAH",24,1,2,0)="  "
^DIC(9.4,184,22,1,"PAH",24,1,3,0)="    1. Bene Travel is incorrectly granting deductible waivers."
^DIC(9.4,184,22,1,"PAH",24,1,4,0)="  "
^DIC(9.4,184,22,1,"PAH",24,1,5,0)="    2. Claim deductibles are being modified after payment."
^DIC(9.4,184,22,1,"PAH",25,0)="33 SEQ #33^3171128.12511^54"
^DIC(9.4,184,22,1,"PAH",25,1,0)="^^7^7^3171128"
^DIC(9.4,184,22,1,"PAH",25,1,1,0)="This patch addresses 3 issues:"
^DIC(9.4,184,22,1,"PAH",25,1,2,0)="  "
^DIC(9.4,184,22,1,"PAH",25,1,3,0)="    1. The mileage fee cap is too low."
^DIC(9.4,184,22,1,"PAH",25,1,4,0)="    "
^DIC(9.4,184,22,1,"PAH",25,1,5,0)="    2. The Beneficiary Travel denial letter template is incorrect."
^DIC(9.4,184,22,1,"PAH",25,1,6,0)="  "
^DIC(9.4,184,22,1,"PAH",25,1,7,0)="    3. The Beneficiary Travel application is running slow. "
^DIC(9.4,184,22,1,"PAH",26,0)="34 SEQ #34^3180601.151725^54"
^DIC(9.4,184,22,1,"PAH",26,1,0)="^^5^5^3180601"
^DIC(9.4,184,22,1,"PAH",26,1,1,0)="Patch DGBT*1*34 will address the following 2 issues:"
^DIC(9.4,184,22,1,"PAH",26,1,2,0)=" "
^DIC(9.4,184,22,1,"PAH",26,1,3,0)="    1. Denial Letter is printing the wrong Division"
^DIC(9.4,184,22,1,"PAH",26,1,4,0)="    "
^DIC(9.4,184,22,1,"PAH",26,1,5,0)="    2. The Claim Enter/Edit option is freezing/slow"
^DIC(9.4,184,22,1,"PAH",27,0)="38 SEQ #36^3190708.171021^65"
^DIC(9.4,184,22,1,"PAH",27,1,0)="^^2^2^3190708"
^DIC(9.4,184,22,1,"PAH",27,1,1,0)="  1. Beneficiary Travel (BT) Error <UNDEFINED>MANRQ+11^DGBTRDVW *DGBTA is "
^DIC(9.4,184,22,1,"PAH",27,1,2,0)="     occurring at many R4 sites."
^DIC(9.4,184,22,1,"PAH",28,0)="35^3190722.171056^65"
^DIC(9.4,184,22,1,"PAH",28,1,0)="^^2^2^3190722"
^DIC(9.4,184,22,1,"PAH",28,1,1,0)="DGBT*1.0*35 - Please refer to the patch description in Forum for "
^DIC(9.4,184,22,1,"PAH",28,1,2,0)="installation instructions."
^DIC(9.4,184,22,1,"PAH",29,0)="37 SEQ #38^3190926.110635^65"
^DIC(9.4,184,22,1,"PAH",29,1,0)="^^1^1^3190926"
^DIC(9.4,184,22,1,"PAH",29,1,1,0)="Please refer to patch description on FORUM for installation purposes."
^DIC(9.4,184,22,1,"PAH",30,0)="39 SEQ #39^3201015.12343^17"
^DIC(9.4,184,22,1,"PAH",30,1,0)="^^2^2^3201015"
^DIC(9.4,184,22,1,"PAH",30,1,1,0)="This patch will update the Beneficiary Travel (BT) Package to utilize the "
^DIC(9.4,184,22,1,"PAH",30,1,2,0)="new Residential Address components introduced with patch DG*5.3*941."
^DIC(9.4,184,22,1,"PAH",31,0)="40 SEQ #40^3231215.132514^89"
^DIC(9.4,184,22,1,"PAH",31,1,0)="^^2^2^3231215"
^DIC(9.4,184,22,1,"PAH",31,1,1,0)="This patch will disable the Mileage claim related functionality"
^DIC(9.4,184,22,1,"PAH",31,1,2,0)="within the Beneficiary Travel package."
^DIC(9.4,184,22,1,"PAH",32,0)="41 SEQ #41^3240304.101238^89"
^DIC(9.4,184,22,1,"PAH",32,1,0)="^^3^3^3240304"
^DIC(9.4,184,22,1,"PAH",32,1,1,0)="DGBT*1.0*41 is a decommission patch for the special mode processing "
^DIC(9.4,184,22,1,"PAH",32,1,2,0)="portion of the Beneficiary Travel (BT) application. This patch will "
^DIC(9.4,184,22,1,"PAH",32,1,3,0)="remove the use of several options. "
