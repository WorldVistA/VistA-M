^DIC(9.4,181,22,1,"PAH",74,1,0)="^^1^1^3090423"
^DIC(9.4,181,22,1,"PAH",74,1,1,0)="MEANS TEST - EVC RELEASE 2"
^DIC(9.4,181,22,1,"PAH",75,0)="94 SEQ #75^3090423.140852^17"
^DIC(9.4,181,22,1,"PAH",76,0)="81 SEQ #77^3091020.163315^17"
^DIC(9.4,181,22,1,"PAH",76,1,0)="^^8^8^3091020"
^DIC(9.4,181,22,1,"PAH",76,1,1,0)="This patch fixes a subscript error that is encountered when printing the"
^DIC(9.4,181,22,1,"PAH",76,1,2,0)="1010EZ.  It also fixes a prompt to look for a Y instead of a YES."
^DIC(9.4,181,22,1,"PAH",76,1,3,0)="This patch adds code to ask the user if the patient is the correct patient "
^DIC(9.4,181,22,1,"PAH",76,1,4,0)="when processing the 1010EZ from the web. If not,  the code"
^DIC(9.4,181,22,1,"PAH",76,1,5,0)="will allow the patient with the same name to be added if entered in"
^DIC(9.4,181,22,1,"PAH",76,1,6,0)="double quotation marks."
^DIC(9.4,181,22,1,"PAH",76,1,7,0)="This patch also removes the word ""Enclosure"" from the 0 and 30 day"
^DIC(9.4,181,22,1,"PAH",76,1,8,0)="Means Test letters."
^DIC(9.4,181,22,1,"PAH",77,0)="98^3100105.165833^17"
^DIC(9.4,181,22,1,"PAH",77,1,0)="^^1^1^3100105"
^DIC(9.4,181,22,1,"PAH",77,1,1,0)="2010 GMT THRESHOLDS UPDATE"
^DIC(9.4,181,22,1,"PAH",78,0)="93 SEQ #79^3100226.10522^17"
^DIC(9.4,181,22,1,"PAH",78,1,0)="^^2^2^3100226"
^DIC(9.4,181,22,1,"PAH",78,1,1,0)="Fixes errors reported by ^XINDEX utility due to LOCK commands withou "
^DIC(9.4,181,22,1,"PAH",78,1,2,0)="timeouts"
^DIC(9.4,181,22,1,"PAH",79,0)="88 SEQ #80^3100513.122829^17"
^DIC(9.4,181,22,1,"PAH",79,1,0)="^^2^2^3100513"
^DIC(9.4,181,22,1,"PAH",79,1,1,0)="This patch a problem where users are experiencing a COMMAND system error"
^DIC(9.4,181,22,1,"PAH",79,1,2,0)="when working with Long Term Care (LTC) means tests."
^DIC(9.4,181,22,1,"PAH",80,0)="86^3100901.114315^17"
^DIC(9.4,181,22,1,"PAH",80,1,0)="^^1^1^3100901"
^DIC(9.4,181,22,1,"PAH",80,1,1,0)=" "
^DIC(9.4,181,22,1,"PAH",81,0)="100 SEQ #82^3101026.100944^17"
^DIC(9.4,181,22,1,"PAH",81,1,0)="^^8^8^3101026"
^DIC(9.4,181,22,1,"PAH",81,1,1,0)="This patch will fix issues that were caused due to patch EAS*1.0*81 "
^DIC(9.4,181,22,1,"PAH",81,1,2,0)="for the 1010EZ web application."
^DIC(9.4,181,22,1,"PAH",81,1,3,0)="Also, the statement ""A monthly amount can be entered"
^DIC(9.4,181,22,1,"PAH",81,1,4,0)="with an '*' after it."" is taken out of the double"
^DIC(9.4,181,22,1,"PAH",81,1,5,0)="question mark help text for ALL OTHER INCOME"
^DIC(9.4,181,22,1,"PAH",81,1,6,0)="field (.17) of file INDIVIDUAL ANNUAL INCOME (408.21)."
^DIC(9.4,181,22,1,"PAH",81,1,7,0)="This patch also fixes the correct filing of the relation of the child"
^DIC(9.4,181,22,1,"PAH",81,1,8,0)="if the child is a step son or daughter."
^DIC(9.4,181,22,1,"PAH",82,0)="102^3110104.143219^17"
^DIC(9.4,181,22,1,"PAH",83,0)="103 SEQ #84^3110817.103035^17"
^DIC(9.4,181,22,1,"PAH",83,1,0)="^^6^6^3110817"
^DIC(9.4,181,22,1,"PAH",83,1,1,0)="This patch corrects a <STORE> error inadverdently introduced by an IB"
^DIC(9.4,181,22,1,"PAH",83,1,2,0)="patch with the collection of eIV Eligibility/Benefit data from third"
^DIC(9.4,181,22,1,"PAH",83,1,3,0)="parties.  A call in the 10-10 Print option can potentially trigger the"
^DIC(9.4,181,22,1,"PAH",83,1,4,0)="<STORE> error if there are an inordinate number of these eIV Eligibility/"
^DIC(9.4,181,22,1,"PAH",83,1,5,0)="Benefit entries.  This patch adjusts the original call to reduce the "
^DIC(9.4,181,22,1,"PAH",83,1,6,0)="data collection and size of the local parameter being created."
^DIC(9.4,181,22,1,"PAH",84,0)="104^3111215.125541^17"
^DIC(9.4,181,22,1,"PAH",85,0)="92^3120329.183625^17"
^DIC(9.4,181,22,1,"PAH",85,1,0)="^^1^1^3120329"
^DIC(9.4,181,22,1,"PAH",85,1,1,0)="1010EZ changes for the Military Service Data Sharing (MSDS) project."
^DIC(9.4,181,22,1,"PAH",86,0)="108^3130103.114459^17"
^DIC(9.4,181,22,1,"PAH",87,0)="105 SEQ #88^3131203.152359^17"
^DIC(9.4,181,22,1,"PAH",87,1,0)="^^6^6^3131203"
^DIC(9.4,181,22,1,"PAH",87,1,1,0)="This patch addresses the issue that the Calculated LTC Copayments "
^DIC(9.4,181,22,1,"PAH",87,1,2,0)="Print report [EASEC LTC COPAY PRINT], can in certain circumstances "
^DIC(9.4,181,22,1,"PAH",87,1,3,0)="provide estimates that are different from what the actual billing option "
^DIC(9.4,181,22,1,"PAH",87,1,4,0)="LTC Billing Clock [IBAEC LTC CLOCK INQURIY] generates. A disclaimer has "
^DIC(9.4,181,22,1,"PAH",87,1,5,0)="been inserted stating that the Calculated LTC Copayments Print report "
^DIC(9.4,181,22,1,"PAH",87,1,6,0)="provides projected estimates."
^DIC(9.4,181,22,1,"PAH",88,0)="114^3140106.162439^17"
^DIC(9.4,181,22,1,"PAH",89,0)="106^3140324.154003^17"
^DIC(9.4,181,22,1,"PAH",89,1,0)="^^3^3^3140324"
^DIC(9.4,181,22,1,"PAH",89,1,1,0)="This patch contains VistA changes to support technology and"
^DIC(9.4,181,22,1,"PAH",89,1,2,0)="business changes that are occurring with the implementation of "
^DIC(9.4,181,22,1,"PAH",89,1,3,0)="Discontinue Annual Means Test Renewal."
^DIC(9.4,181,22,1,"PAH",90,0)="110^3140522.155457^17"
^DIC(9.4,181,22,1,"PAH",90,1,0)="^^4^4^3140522"
^DIC(9.4,181,22,1,"PAH",90,1,1,0)="This patch addresses the following:"
^DIC(9.4,181,22,1,"PAH",90,1,2,0)=" "
^DIC(9.4,181,22,1,"PAH",90,1,3,0)="- Updates the Executable Help Text for ALL OTHER INCOME (#.17) in the "
^DIC(9.4,181,22,1,"PAH",90,1,4,0)="  INDIVIDUAL ANNUAL INCOME (#408.21) file."
^DIC(9.4,181,22,1,"PAH",91,0)="96^3140709.153311^17"
^DIC(9.4,181,22,1,"PAH",91,1,0)="^^5^5^3140709"
^DIC(9.4,181,22,1,"PAH",91,1,1,0)="Enrollment System Redesign (ESR) became the official System "
^DIC(9.4,181,22,1,"PAH",91,1,2,0)="of Record on March 29, 2009. The Health Eligibility Center Legacy (HECL)"
^DIC(9.4,181,22,1,"PAH",91,1,3,0)="system will be decommissioned.  This patch will inactivate the HL7"
^DIC(9.4,181,22,1,"PAH",91,1,4,0)="protocols used for messaging with the HECL and will be installed shortly"
^DIC(9.4,181,22,1,"PAH",91,1,5,0)="before the HECL is decommissioned."
^DIC(9.4,181,22,1,"PAH",92,0)="125^3150106.115626^17"
^DIC(9.4,181,22,1,"PAH",92,1,0)="^^4^4^3150106"
^DIC(9.4,181,22,1,"PAH",92,1,1,0)="The Geographic-Based Means Test thresholds for Calendar Year 2015 are"
^DIC(9.4,181,22,1,"PAH",92,1,2,0)="distributed with this patch. The updated values for the GMT THRESHOLDS"
^DIC(9.4,181,22,1,"PAH",92,1,3,0)="file (#712.5) are used in the determination of a veteran's GMT Threshold"
^DIC(9.4,181,22,1,"PAH",92,1,4,0)="for a given income year, based on locality and number of dependents."
^DIC(9.4,181,22,1,"PAH",93,0)="107^3160105.120853^54"
^DIC(9.4,181,22,1,"PAH",94,0)="111^3160105.120853^54"
^DIC(9.4,181,22,1,"PAH",94,1,0)="^^1^1^3160105"
^DIC(9.4,181,22,1,"PAH",94,1,1,0)="VFA ESR 3.12 Receive Conversion/Reversal Tests from ES Project."
^DIC(9.4,181,22,1,"PAH",95,0)="113^3160105.12114^54"
^DIC(9.4,181,22,1,"PAH",95,1,0)="^^58^58^3160105"
^DIC(9.4,181,22,1,"PAH",95,1,1,0)="  The Health Eligibility Center (HEC) requested modifications to the "
^DIC(9.4,181,22,1,"PAH",95,1,2,0)="  Enrollment System (ES) and VistA Registration, Enrollment and"
^DIC(9.4,181,22,1,"PAH",95,1,3,0)="  Eligibility (VistA REE) software to support the requirements of the"
^DIC(9.4,181,22,1,"PAH",95,1,4,0)="  Veterans Financial Assessment (VFA) projects."
^DIC(9.4,181,22,1,"PAH",95,1,5,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,6,0)="  This patch modifies the Enrollment Application System V1.0 application"
^DIC(9.4,181,22,1,"PAH",95,1,7,0)="  as described below:"
^DIC(9.4,181,22,1,"PAH",95,1,8,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,9,0)="     Add a Beneficiary Travel Bulletin."
^DIC(9.4,181,22,1,"PAH",95,1,10,0)="  ----------------------------------------------------------"
^DIC(9.4,181,22,1,"PAH",95,1,11,0)="  Due to the Income Verification Match (IVM) process, the BT CLAIMS"
^DIC(9.4,181,22,1,"PAH",95,1,12,0)="  PROCESSING Mailgroup will be automatically created in VistA with the"
^DIC(9.4,181,22,1,"PAH",95,1,13,0)="  installation of this patch at each VistA Site. VistA users are"
^DIC(9.4,181,22,1,"PAH",95,1,14,0)="  responsible for adding the appropriate members to the Mailgroup.  The"
^DIC(9.4,181,22,1,"PAH",95,1,15,0)="  appropriate VistA staff are added to the Mailgroup when they want to be"
^DIC(9.4,181,22,1,"PAH",95,1,16,0)="  notified of a change in the Veteran's BT Financial Indicator status."
^DIC(9.4,181,22,1,"PAH",95,1,17,0)="  The bulletin that will be loaded with this patch is called EAS BT CLAIMS"
^DIC(9.4,181,22,1,"PAH",95,1,18,0)="  PROCESSING."
^DIC(9.4,181,22,1,"PAH",95,1,19,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,20,0)="  The bulletin will be sent to each member of the Mailgroup and will"
^DIC(9.4,181,22,1,"PAH",95,1,21,0)="  contain the following information:"
^DIC(9.4,181,22,1,"PAH",95,1,22,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,23,0)="  Mail Message From: Health EligibilityCenter    Date: MM/DD/YYYY HH:MM"
^DIC(9.4,181,22,1,"PAH",95,1,24,0)="  Subject: IVM-Beneficiary Travel Financial Indicator upload FOR<DFN>"
^DIC(9.4,181,22,1,"PAH",95,1,25,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,26,0)="  An Income Verification Match verified Beneficiary Travel information"
^DIC(9.4,181,22,1,"PAH",95,1,27,0)="  has been uploaded for the following patient."
^DIC(9.4,181,22,1,"PAH",95,1,28,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,29,0)="  Patient Name:"
^DIC(9.4,181,22,1,"PAH",95,1,30,0)="  LAST 4 OF SSN:  "
^DIC(9.4,181,22,1,"PAH",95,1,31,0)="  ICN:"
^DIC(9.4,181,22,1,"PAH",95,1,32,0)="  DFN:"
^DIC(9.4,181,22,1,"PAH",95,1,33,0)="  STATION NUMBER:"
^DIC(9.4,181,22,1,"PAH",95,1,34,0)="  Prev Category:"
^DIC(9.4,181,22,1,"PAH",95,1,35,0)="  New Category:"
^DIC(9.4,181,22,1,"PAH",95,1,36,0)="  Date of Test:"
^DIC(9.4,181,22,1,"PAH",95,1,37,0)="  Income Year of Conversion:"
^DIC(9.4,181,22,1,"PAH",95,1,38,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,39,0)="  - When a converted/reversal Rx Copay Test is received from IVM, a"
^DIC(9.4,181,22,1,"PAH",95,1,40,0)="    check will be done to see if the new copay exemption status is"
^DIC(9.4,181,22,1,"PAH",95,1,41,0)="    different than the old copay exemption status (e.g. the new status is"
^DIC(9.4,181,22,1,"PAH",95,1,42,0)="    NON-EXEMPT and the old status is EXEMPT, or the new status is EXEMPT"
^DIC(9.4,181,22,1,"PAH",95,1,43,0)="    and the old status is NON-EXEMPT)."
^DIC(9.4,181,22,1,"PAH",95,1,44,0)="  - If the status has changed, a check will be done to see if the "
^DIC(9.4,181,22,1,"PAH",95,1,45,0)="    Beneficiary Travel indicator has changed.  If indicator changed, a"
^DIC(9.4,181,22,1,"PAH",95,1,46,0)="    a bulletin will be sent to the BT CLAIMS PROCESSING Mailgroup."
^DIC(9.4,181,22,1,"PAH",95,1,47,0)=" "
^DIC(9.4,181,22,1,"PAH",95,1,48,0)="   HL7 Changes"
^DIC(9.4,181,22,1,"PAH",95,1,49,0)="  ----------------------------------------------------------"
^DIC(9.4,181,22,1,"PAH",95,1,50,0)="  This patch supports HL7 enhancements that sends BT Financial Indicator "
^DIC(9.4,181,22,1,"PAH",95,1,51,0)="  Z06 ZMT-32 and Contributed to Spouse Z10 ZIR-2 and stores them in the "
^DIC(9.4,181,22,1,"PAH",95,1,52,0)="  database. Supports HL7 Z07 ZIR-15 that sends VistA Contributed to Spouse"
^DIC(9.4,181,22,1,"PAH",95,1,53,0)="  changes to ES. Patch DG*5.3*890 will be released in conjunction with"
^DIC(9.4,181,22,1,"PAH",95,1,54,0)="  this EAS patch."
^DIC(9.4,181,22,1,"PAH",95,1,55,0)="  Modified Z07 message builder to include the Contributed to Spouse "
^DIC(9.4,181,22,1,"PAH",95,1,56,0)="  indicator on the ORU Z07 ZIR segment."
^DIC(9.4,181,22,1,"PAH",95,1,57,0)="  Added a trigger for an ORF Z07 message when a change is made to "
^DIC(9.4,181,22,1,"PAH",95,1,58,0)="  the Contributed to Spouse indicator."
^DIC(9.4,181,22,1,"PAH",96,0)="134^3160107.151021^54"
^DIC(9.4,181,22,1,"PAH",96,1,0)="^^4^4^3160107"
^DIC(9.4,181,22,1,"PAH",96,1,1,0)="The Geographic-Based Means Test thresholds for Calendar Year 2016 are "
^DIC(9.4,181,22,1,"PAH",96,1,2,0)="distributed with this patch.  The updated values for the GMT THRESHOLDS "
^DIC(9.4,181,22,1,"PAH",96,1,3,0)="file (712.5) are used in the determination of a veteran's GMT Threshold "
^DIC(9.4,181,22,1,"PAH",96,1,4,0)="for a given income year, based on locality and number of dependents."
^DIC(9.4,181,22,1,"PAH",97,0)="122 SEQ #115^3161201.154725^54"
^DIC(9.4,181,22,1,"PAH",97,1,0)="^^6^6^3161201"
^DIC(9.4,181,22,1,"PAH",97,1,1,0)="Patch EAS*1*122 addresses 1 issue:"
^DIC(9.4,181,22,1,"PAH",97,1,2,0)="      "
^DIC(9.4,181,22,1,"PAH",97,1,3,0)="       1.  When using the Integrated Billing LTC Billing Clock"
^DIC(9.4,181,22,1,"PAH",97,1,4,0)="           Maintenance [IBAEC LTC CLOCK EDIT] menu option"
^DIC(9.4,181,22,1,"PAH",97,1,5,0)="           and after entering ""?"" or ""??"" at the ""Select PATIENT"
^DIC(9.4,181,22,1,"PAH",97,1,6,0)="           Name"" prompt users might encounter an undefined error."
^DIC(9.4,181,22,1,"PAH",98,0)="144^3170123.145631^54"
^DIC(9.4,181,22,1,"PAH",98,1,0)="^^4^4^3170123"
^DIC(9.4,181,22,1,"PAH",98,1,1,0)="The Geographic-Based Means Test thresholds for Calendar Year 2017 are "
^DIC(9.4,181,22,1,"PAH",98,1,2,0)="distributed with this patch.  The updated values for the GMT THRESHOLDS "
^DIC(9.4,181,22,1,"PAH",98,1,3,0)="file (712.5) are used in the determination of a veteran's GMT Threshold "
^DIC(9.4,181,22,1,"PAH",98,1,4,0)="for a given income year, based on locality and number of dependents."
^DIC(9.4,181,22,1,"PAH",99,0)="146^3170203.154117^54"
^DIC(9.4,181,22,1,"PAH",99,1,0)="^^11^11^3170203"
^DIC(9.4,181,22,1,"PAH",99,1,1,0)="This patch corrects the Geographic-Based Means Test thresholds for "
^DIC(9.4,181,22,1,"PAH",99,1,2,0)="Calendar Year 2017 previously sent in patch EAS*1.0*144. The updated"
^DIC(9.4,181,22,1,"PAH",99,1,3,0)="values for the GMT THRESHOLDS file (#712.5) are used in the determination"
^DIC(9.4,181,22,1,"PAH",99,1,4,0)="of a veteran's GMT Threshold for a given income year, based on locality"
^DIC(9.4,181,22,1,"PAH",99,1,5,0)="and number of dependents."
^DIC(9.4,181,22,1,"PAH",99,1,6,0)="  "
^DIC(9.4,181,22,1,"PAH",99,1,7,0)="Geographical income level thresholds are set yearly by the U.S. Department"
^DIC(9.4,181,22,1,"PAH",99,1,8,0)="of Housing and Urban Development (HUD). This large set of income"
^DIC(9.4,181,22,1,"PAH",99,1,9,0)="thresholds is usually referred to as the HUD index. The geographic based"
^DIC(9.4,181,22,1,"PAH",99,1,10,0)="income limits for Income Year (IY) 2016 can be found January 1, 2017 at:"
^DIC(9.4,181,22,1,"PAH",99,1,11,0)="https://www.huduser.gov/portal/datasets/il.html#2016"
^DIC(9.4,181,22,1,"PAH",100,0)="154^3171228.171639^54"
^DIC(9.4,181,22,1,"PAH",100,1,0)="^^2^2^3171228"
^DIC(9.4,181,22,1,"PAH",100,1,1,0)="The GMT THRESHOLDS (#712.5) file needs to be updated for the 2018"
^DIC(9.4,181,22,1,"PAH",100,1,2,0)="calendar year (income year 2017). "
^DIC(9.4,181,22,1,"PAH",101,0)="152 SEQ #129^3180228.171539^54"
^DIC(9.4,181,22,1,"PAH",101,1,0)="^^4^4^3180228"
^DIC(9.4,181,22,1,"PAH",101,1,1,0)="This patch will enable the ORU~Z10 HL7 message to process when the "
^DIC(9.4,181,22,1,"PAH",101,1,2,0)="previous means test on file was a converted means test and the means test "
^DIC(9.4,181,22,1,"PAH",101,1,3,0)="on the ORU~Z10 message is for an income year after the converted means "
^DIC(9.4,181,22,1,"PAH",101,1,4,0)="test."
^DIC(9.4,181,22,1,"PAH",102,0)="151^3190103.170115^54"
^DIC(9.4,181,22,1,"PAH",102,1,0)="^^2^2^3190103"
^DIC(9.4,181,22,1,"PAH",102,1,1,0)="Please see the EAS*1.0*151 patch description for detailed information "
^DIC(9.4,181,22,1,"PAH",102,1,2,0)="regarding this patch."
^DIC(9.4,181,22,1,"PAH",103,0)="170^3190103.171127^54"
^DIC(9.4,181,22,1,"PAH",103,1,0)="^^16^16^3190103"
^DIC(9.4,181,22,1,"PAH",103,1,1,0)="The Geographic-Based Means Test thresholds for Calendar Year 2019 are"
^DIC(9.4,181,22,1,"PAH",103,1,2,0)="distributed with this patch. The updated values for the GMT THRESHOLDS"
^DIC(9.4,181,22,1,"PAH",103,1,3,0)="file (#712.5) are used in the determination of a veteran's GMT Threshold"
^DIC(9.4,181,22,1,"PAH",103,1,4,0)="for a given income year, based on locality and number of dependents."
^DIC(9.4,181,22,1,"PAH",103,1,5,0)="  "
^DIC(9.4,181,22,1,"PAH",103,1,6,0)="Geographical income level thresholds are set yearly by the U.S. Department"
^DIC(9.4,181,22,1,"PAH",103,1,7,0)="of Housing and Urban Development (HUD). This large set of income"
^DIC(9.4,181,22,1,"PAH",103,1,8,0)="thresholds is usually referred to as the HUD index. The geographic based"
^DIC(9.4,181,22,1,"PAH",103,1,9,0)="income limits for Income Year (IY) 2018 can be found January 1, 2019 at:"
^DIC(9.4,181,22,1,"PAH",103,1,10,0)="http://www.domain.ext/healthbenefits/cost/income_thresholds.asp"
^DIC(9.4,181,22,1,"PAH",103,1,11,0)=" "
^DIC(9.4,181,22,1,"PAH",103,1,12,0)="This patch, EAS*1.0*170, is one of three VistA 2019 threshold patches.  It"
^DIC(9.4,181,22,1,"PAH",103,1,13,0)="addresses the annual updates for the GMT Thresholds. Patch DG*5.3*973 will"
^DIC(9.4,181,22,1,"PAH",103,1,14,0)="update the thresholds for the Means Tests and the Maximum Annual Pension"
^DIC(9.4,181,22,1,"PAH",103,1,15,0)="Rate. Patch IB*2.0*635 will address the annual updates for the Pharmacy"
^DIC(9.4,181,22,1,"PAH",103,1,16,0)="Copay Thresholds."
^DIC(9.4,181,22,1,"PAH",104,0)="172^3190201.125643^54"
