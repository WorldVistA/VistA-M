^DIC(9.4,84,22,6,0)="2.0^2931203^2960718"
^DIC(9.4,84,22,6,"PAH",0)="^9.4901^2^2"
^DIC(9.4,84,22,6,"PAH",1,0)="8^2970206^1"
^DIC(9.4,84,22,6,"PAH",1,1,0)="^^1^1^2970206"
^DIC(9.4,84,22,6,"PAH",1,1,1,0)="Fix undefined error reported in NOIS#."
^DIC(9.4,84,22,6,"PAH",2,0)="9^2970630^1"
