^DIC(9.4,165,"DEV")="Birmingham"
^DIC(9.4,165,"VERSION")="3.0"
^DIC(9.4,166,0)="NDBI^A7R^Software to support integrated sites."
^DIC(9.4,166,1,0)="^^21^21^2980515^^^^"
^DIC(9.4,166,1,1,0)=" The National Database Integration System (NDBI) is an application"
^DIC(9.4,166,1,2,0)="developed for the VA medical center integrations. This package contains"
^DIC(9.4,166,1,3,0)="the files used at the legacy and primary sites. The entire application"
^DIC(9.4,166,1,4,0)="consists of files, options, routines located in the A7R namespace, which"
^DIC(9.4,166,1,5,0)="comprises the utilities used to consolidate the data extracted from the"
^DIC(9.4,166,1,6,0)="VISTA applications."
^DIC(9.4,166,1,7,0)="  "
^DIC(9.4,166,1,8,0)=" The actual distribution of the application is sectioned into two builds."
^DIC(9.4,166,1,9,0)="One is the NDBI PRIMARY SYSTEM, consisting of all NDBI files, A7R*"
^DIC(9.4,166,1,10,0)="routines, A7RP* options and A7RC* options. The other build is NDBI LEGACY"
^DIC(9.4,166,1,11,0)="SYSTEM, consisting of all NDBI files, A7R* routines, A7RL* options and"
^DIC(9.4,166,1,12,0)="A7RC* options.  "
^DIC(9.4,166,1,13,0)="   "
^DIC(9.4,166,1,14,0)=" The options are in the namespace of A7RC, A7RL and A7RP. The A7RC*"
^DIC(9.4,166,1,15,0)="options are Common options used at the legacy and primary sites. They"
^DIC(9.4,166,1,16,0)="consist of utilities that are used for the New Person and Patient files,"
^DIC(9.4,166,1,17,0)="and our NDBI Event Log utilities. The A7RL* options are Legacy options"
^DIC(9.4,166,1,18,0)="used to collect and process data from the legacy site only. The A7RP*"
^DIC(9.4,166,1,19,0)="options are Primary options used to preview, merge and process the data"
^DIC(9.4,166,1,20,0)="collected from legacy system. These A7RP* options are used on the primary"
^DIC(9.4,166,1,21,0)="site only.  "
^DIC(9.4,166,5)="DALLAS"
^DIC(9.4,166,20,0)="^9.402P^2^1"
^DIC(9.4,166,20,2,0)="2^^A7RXDRPT"
^DIC(9.4,166,20,2,1)=""
^DIC(9.4,166,20,"B",2,2)=""
^DIC(9.4,166,22,0)="^9.49I^1^1"
^DIC(9.4,166,22,1,0)="1.0^2980501^2980527^1"
^DIC(9.4,166,22,1,1,0)="^^17^17^2981112^"
^DIC(9.4,166,22,1,1,1,0)=" This package contains a National Database Integration (NDBI) routine,"
^DIC(9.4,166,22,1,1,2,0)=" A7RXDRPT which will be referenced by the Duplicate Record Merge patch"
^DIC(9.4,166,22,1,1,3,0)=" (XT*7.3*23). It must be installed at all sites. When installed it will"
^DIC(9.4,166,22,1,1,4,0)=" populate the PACKAGE (#9.4) file with the new entry of NDBI and the"
^DIC(9.4,166,22,1,1,5,0)=" fields AFFECTS RECORD MERGE (#20), FILE AFFECTED (#.01) with 'PATIENT'"
^DIC(9.4,166,22,1,1,6,0)=" and NAME OF MERGE ROUTINE (#3) with 'A7RXDRPT'."
^DIC(9.4,166,22,1,1,7,0)=" "
^DIC(9.4,166,22,1,1,8,0)=" When the Duplicate Resolution options, exported by the XT*7.3*23"
^DIC(9.4,166,22,1,1,9,0)=" patch, are run for the PATIENT (#2) file, the routine exported in this"
^DIC(9.4,166,22,1,1,10,0)=" build will perform an environment check to determine if the site is an"
^DIC(9.4,166,22,1,1,11,0)=" integrated facility (NDBI site).  If so, NDBI data files will be updated,"
^DIC(9.4,166,22,1,1,12,0)=" as necessary, with corrected entries."
^DIC(9.4,166,22,1,1,13,0)=" "
^DIC(9.4,166,22,1,1,14,0)=" This can be installed at any time while users are on the system and"
^DIC(9.4,166,22,1,1,15,0)=" will take no more than a few minutes to complete."
^DIC(9.4,166,22,1,1,16,0)=" "
^DIC(9.4,166,22,1,1,17,0)=" The checksum value for this routine is 73468."
^DIC(9.4,166,22,1,"PAH",0)="^9.4901^^0"
^DIC(9.4,166,22,"B","1.0",1)=""
^DIC(9.4,166,"DEV")="NDBI"
^DIC(9.4,166,"VERSION")="1.0"
^DIC(9.4,167,0)="ASISTS^OOPS^Automated Safety Incident Surveillance Tracking System"
^DIC(9.4,167,7)="^^I"
