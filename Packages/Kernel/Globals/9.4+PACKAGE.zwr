^DIC(9.4,155,22,1,"PAH",31,1,0)="^^6^6^3050212"
^DIC(9.4,155,22,1,"PAH",31,1,1,0)="The Health Insurance Portability and Accessibility Act (HIPAA) stipulates "
^DIC(9.4,155,22,1,"PAH",31,1,2,0)="that diagnostic and procedure codes used for billing purposes must be the "
^DIC(9.4,155,22,1,"PAH",31,1,3,0)="codes that were applicable at the time the service was provided.  The"
^DIC(9.4,155,22,1,"PAH",31,1,4,0)="data supporting Code Sets (date-sensitive codes) for the ICD-9-CM "
^DIC(9.4,155,22,1,"PAH",31,1,5,0)="diagnostic classification system and the Diagnosis Related Groups (DRG)"
^DIC(9.4,155,22,1,"PAH",31,1,6,0)="Grouper are exported in this patch."
