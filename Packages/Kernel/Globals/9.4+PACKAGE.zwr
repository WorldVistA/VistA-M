^DIC(9.4,76,22,2,"PAH",48,1,1,0)="Encounter Forms update."
^DIC(9.4,76,22,2,"PAH",49,0)="62 SEQ #55^3101115.104416^17"
^DIC(9.4,76,22,2,"PAH",50,0)="64 SEQ #56^3130904.09454^17"
^DIC(9.4,76,22,2,"PAH",50,1,0)="^^1^1^3130904"
^DIC(9.4,76,22,2,"PAH",50,1,1,0)="UPDATE FOR UNSUPPORTED ICD FIELDS"
^DIC(9.4,76,22,2,"PAH",51,0)="63 SEQ #57^3140618.123315^17"
^DIC(9.4,76,22,2,"PAH",51,1,0)="^^1^1^3140618"
^DIC(9.4,76,22,2,"PAH",51,1,1,0)="AICS ICD-10 CLASS 1 REMEDIATION"
^DIC(9.4,76,22,2,"PAH",52,0)="66^3150128.155431^17"
^DIC(9.4,76,22,2,"PAH",53,0)="68 SEQ #59^3151211.144153^17"
^DIC(9.4,76,22,2,"PAH",53,1,0)="^^6^6^3151211"
^DIC(9.4,76,22,2,"PAH",53,1,1,0)="A request was made to update the SHORT NAME (field #.015) in the  "
^DIC(9.4,76,22,2,"PAH",53,1,2,0)="TYPE OF VISIT (#357.69) file. This field is computed using a pointer to "
^DIC(9.4,76,22,2,"PAH",53,1,3,0)="the SHORT NAME (#2) field in the CPT (#81) file; a field that is being "
^DIC(9.4,76,22,2,"PAH",53,1,4,0)="removed by patch ICPT*6.0*46. This patch will redefine the computed "
^DIC(9.4,76,22,2,"PAH",53,1,5,0)="expression used in the .015 field to use an API to populate the SHORT "
^DIC(9.4,76,22,2,"PAH",53,1,6,0)="NAME data."
^DIC(9.4,76,22,2,"PAH",54,0)="69 SEQ #60^3200730.151226^65"
^DIC(9.4,76,22,2,"PAH",54,1,0)="^^3^3^3200730"
^DIC(9.4,76,22,2,"PAH",54,1,1,0)="(1) This patch fixes the field QUANTITY (#.09) in file SELECTION (#357.3) "
^DIC(9.4,76,22,2,"PAH",54,1,2,0)="not being pushed to CPRS when added through the option Edit Encounter "
^DIC(9.4,76,22,2,"PAH",54,1,3,0)="Forms [IBDF EDIT ENCOUNTER FORMS]."
^DIC(9.4,76,22,2,"PAH",55,0)="70b^3210512"
^DIC(9.4,76,22,2,"PAH",55,1,0)="^^5^5^3210512"
^DIC(9.4,76,22,2,"PAH",55,1,1,0)="Backup of IBD*3.0*70 on May 12, 2021"
^DIC(9.4,76,22,2,"PAH",55,1,2,0)=" "
^DIC(9.4,76,22,2,"PAH",55,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,76,22,2,"PAH",55,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,76,22,2,"PAH",55,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,76,22,2,"PAH",56,0)="70 SEQ #61^3210512.151522^17"
^DIC(9.4,76,22,2,"PAH",56,1,0)="^^5^5^3210512"
^DIC(9.4,76,22,2,"PAH",56,1,1,0)="This patch updates the Maintenance Utility for Active/Inactive Codes "
^DIC(9.4,76,22,2,"PAH",56,1,2,0)="[IBDF UTIL MAINTENANCE UTILITY] option. It update the software to store "
^DIC(9.4,76,22,2,"PAH",56,1,3,0)="the report run for future use within the next 30 days. Also, the software"
^DIC(9.4,76,22,2,"PAH",56,1,4,0)="has been modified to allow the user to delete or replace a single inactive"
^DIC(9.4,76,22,2,"PAH",56,1,5,0)="code across all forms."
^DIC(9.4,76,22,2,"PAH",57,0)="72 SEQ #62^3250529.080527^90"
^DIC(9.4,76,22,2,"PAH",57,1,0)="^^1^1^3250529"
^DIC(9.4,76,22,2,"PAH",57,1,1,0)="Patch IBD*3*72 Removes GAF functionality from AICS."
^DIC(9.4,76,22,2,"PAH",58,0)="71 SEQ #63^3251022.134813^90"
^DIC(9.4,76,22,2,"PAH",58,1,0)="^^8^8^3251022"
^DIC(9.4,76,22,2,"PAH",58,1,1,0)="This patch updates Evaluation and Management codes in the TYPE OF VISIT"
^DIC(9.4,76,22,2,"PAH",58,1,2,0)="file (#357.69).  These codes are a subset of the Current Procedural"
^DIC(9.4,76,22,2,"PAH",58,1,3,0)="Terminology codes published by the American Medical Association and they"
^DIC(9.4,76,22,2,"PAH",58,1,4,0)="are used to describe the level of care for an outpatient visit."
^DIC(9.4,76,22,2,"PAH",58,1,5,0)=" "
^DIC(9.4,76,22,2,"PAH",58,1,6,0)="In addition, an enhancement will be made to default in the CPT short name"
^DIC(9.4,76,22,2,"PAH",58,1,7,0)="instead of the Recommended Header/Text when adding Type of Visit codes to"
^DIC(9.4,76,22,2,"PAH",58,1,8,0)="a Visit Type selection list within an encounter form."
