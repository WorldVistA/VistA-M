^DIC(9.4,3,"VERSION")="8.0"
^DIC(9.4,4,0)="MAILMAN^XM^Electronic Mail, both local and networked"
^DIC(9.4,4,1,0)="^^5^5^2940602^"
^DIC(9.4,4,1,1,0)="MailMan is a communications package that can be used by software"
^DIC(9.4,4,1,2,0)="and hardware.  In its' user mode it operates in a kind of mode that"
^DIC(9.4,4,1,3,0)="is very nice for asynchronous teleconferencing.  It has many functions"
^DIC(9.4,4,1,4,0)="that can be used by software, including the ability to address messages"
^DIC(9.4,4,1,5,0)="to software (servers) and extract data from message fields."
^DIC(9.4,4,4,0)="^9.44PA^22^19"
