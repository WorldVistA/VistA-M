^DIC(9.4,14,22,5.9,"PAH",68,0)="225 SEQ #166^2990210^1"
^DIC(9.4,14,22,5.9,"PAH",68,1,0)="^^15^15^2990210"
^DIC(9.4,14,22,5.9,"PAH",68,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",68,1,2,0)="  Patch 201 inadvertently removed the indicator that designated which"
^DIC(9.4,14,22,5.9,"PAH",68,1,3,0)="  comment went with which result on the cumulative reports.  This only"
^DIC(9.4,14,22,5.9,"PAH",68,1,4,0)="  affected the horizontally formatted reports.  The following is an"
^DIC(9.4,14,22,5.9,"PAH",68,1,5,0)="  example of the output prior to patch 201."
^DIC(9.4,14,22,5.9,"PAH",68,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",68,1,7,0)="ERD   a 07/30/98 09:32                  4.0 L  5.0     12 L   13 L   14 L"
^DIC(9.4,14,22,5.9,"PAH",68,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",68,1,9,0)="  After patch 201 the output resembled:"
^DIC(9.4,14,22,5.9,"PAH",68,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",68,1,11,0)="ERD   07/30/1998 09:32                  4.0 L  5.0     12 L   13 L   14 L"
^DIC(9.4,14,22,5.9,"PAH",68,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",68,1,13,0)="  Patch 225 corrects the output to look like:"
^DIC(9.4,14,22,5.9,"PAH",68,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",68,1,15,0)="ERD   a 07/30/1998 09:32                4.0 L  5.0     12 L   13 L   14 L"
