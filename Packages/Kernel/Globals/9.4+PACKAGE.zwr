^DIC(9.4,48,22,5.28,"PAH",682,1,8,0)="VSE-8567: JS - VistA: User Comment Tracking"
^DIC(9.4,48,22,5.28,"PAH",682,1,9,0)="VSE-8574: TB - VistA: Modify the new VET SELF CANCEL flag"
^DIC(9.4,48,22,5.28,"PAH",682,1,10,0)="VSE-8614: MB - VistA: WWII Appointment Type is showing as non-billable"
^DIC(9.4,48,22,5.28,"PAH",682,1,11,0)="VSE-8723: BF - VistA: Fix an issue with user erroneously receiving "
