^DIC(9.4,49,22,10,"PAH",290,1,1,0)="Reasonable Charges v3.0: Remove RC Discounts"
^DIC(9.4,49,22,10,"PAH",291,0)="395 SEQ #359^3080526.153918^1"
^DIC(9.4,49,22,10,"PAH",291,1,0)="^^1^1^3080526"
^DIC(9.4,49,22,10,"PAH",291,1,1,0)="PHARMACY NPI FIX (REPLACES IB*2*388)"
^DIC(9.4,49,22,10,"PAH",292,0)="392 SEQ #360^3080526.190227^1"
^DIC(9.4,49,22,10,"PAH",292,1,0)="^^11^11^3080526"
^DIC(9.4,49,22,10,"PAH",292,1,1,0)="Modifications in this patch will allow users to continue to send out "
^DIC(9.4,49,22,10,"PAH",292,1,2,0)="claims without taxonomies for type 1 and type 2 providers where the "
^DIC(9.4,49,22,10,"PAH",292,1,3,0)="taxonomies are not sent in the 837 transmission from the Financial "
^DIC(9.4,49,22,10,"PAH",292,1,4,0)="Services Center (FSC) in Austin to the clearinghouse. There is currently "
^DIC(9.4,49,22,10,"PAH",292,1,5,0)="code in Vista that will change the warnings that users receive when "
^DIC(9.4,49,22,10,"PAH",292,1,6,0)="taxonomies are missing to fatal edits for all providers effective "
^DIC(9.4,49,22,10,"PAH",292,1,7,0)="05/23/2008, and hence prevent the claims from being submitted.  This "
^DIC(9.4,49,22,10,"PAH",292,1,8,0)="patch will produce fatal edits when the Attending, Rendering or Referring "
^DIC(9.4,49,22,10,"PAH",292,1,9,0)="Provider taxonomies are missing on or after 5/23/2008.  It will produce "
^DIC(9.4,49,22,10,"PAH",292,1,10,0)="non-fatal warnings when Other, Operating, Supervising, Billing Provider, "
^DIC(9.4,49,22,10,"PAH",292,1,11,0)="Purchased Service or Lab/Facility taxonomies are missing."
^DIC(9.4,49,22,10,"PAH",293,0)="377 SEQ #361^3080722.075242^1"
^DIC(9.4,49,22,10,"PAH",293,1,0)="^^1^1^3080722"
^DIC(9.4,49,22,10,"PAH",293,1,1,0)="eClaims Plus Iteration 3, phase 2"
^DIC(9.4,49,22,10,"PAH",294,0)="398 SEQ #362^3080722.075326^1"
^DIC(9.4,49,22,10,"PAH",294,1,0)="^^3^3^3080722"
^DIC(9.4,49,22,10,"PAH",294,1,1,0)=" "
^DIC(9.4,49,22,10,"PAH",294,1,2,0)="Update Stop Codes 372 and 373 from BASIC CARE ($15 copay) to"
^DIC(9.4,49,22,10,"PAH",294,1,3,0)="NON-BILLABLE (no copay)."
^DIC(9.4,49,22,10,"PAH",295,0)="389 SEQ #363^3080722.080731^1"
^DIC(9.4,49,22,10,"PAH",295,1,0)="^^1^1^3080722"
^DIC(9.4,49,22,10,"PAH",295,1,1,0)="Prosthetics Item Replacement."
^DIC(9.4,49,22,10,"PAH",296,0)="397 SEQ #365^3090420.154939^1"
^DIC(9.4,49,22,10,"PAH",296,1,0)="^^2^2^3090420"
^DIC(9.4,49,22,10,"PAH",296,1,1,0)="This patch is addressing an issue regarding bills not automatically "
^DIC(9.4,49,22,10,"PAH",296,1,2,0)="audited by the Auto Audit process in Accounts Receivable package."
^DIC(9.4,49,22,10,"PAH",297,0)="391 SEQ #366^3090420.160953^1"
^DIC(9.4,49,22,10,"PAH",297,1,0)="^^2^2^3090420"
^DIC(9.4,49,22,10,"PAH",297,1,1,0)="Modifications to allow NPI to be ACTIVE in both the #200 file and the "
^DIC(9.4,49,22,10,"PAH",297,1,2,0)="#355.93 file at the same time."
^DIC(9.4,49,22,10,"PAH",298,0)="401 SEQ #367^3090420.161024^1"
^DIC(9.4,49,22,10,"PAH",298,1,0)="^^4^4^3090420"
^DIC(9.4,49,22,10,"PAH",298,1,1,0)="The Chief Business Office has requested to revert the fatal errors"
^DIC(9.4,49,22,10,"PAH",298,1,2,0)="for the NPI of the Division and the Service Facility to a warning"
^DIC(9.4,49,22,10,"PAH",298,1,3,0)="message, and also to change a missing Taxonomy of the Billing Provider"
^DIC(9.4,49,22,10,"PAH",298,1,4,0)="back to a fatal error."
^DIC(9.4,49,22,10,"PAH",299,0)="383 SEQ #368^3090421.162246^17"
^DIC(9.4,49,22,10,"PAH",300,0)="406 SEQ #369^3090422.120853^17"
^DIC(9.4,49,22,10,"PAH",300,1,0)="^^1^1^3090422"
^DIC(9.4,49,22,10,"PAH",300,1,1,0)="Update Stop Codes to reflect Fiscal Year 2009 changes."
^DIC(9.4,49,22,10,"PAH",301,0)="409 SEQ #370^3090422.123124^17"
^DIC(9.4,49,22,10,"PAH",301,1,0)="^^2^2^3090422"
^DIC(9.4,49,22,10,"PAH",301,1,1,0)="Update the IB CLINIC STOP CODE BILLABLE TYPES file (#352.5) for STOP CODE "
^DIC(9.4,49,22,10,"PAH",301,1,2,0)="351 with an effective date of 10/10/08 to reflect no copay."
^DIC(9.4,49,22,10,"PAH",302,0)="405 SEQ #371^3090422.154727^17"
^DIC(9.4,49,22,10,"PAH",302,1,0)="^^1^1^3090422"
^DIC(9.4,49,22,10,"PAH",302,1,1,0)="ePHARMACY TRICARE/'N'/CT FIX"
^DIC(9.4,49,22,10,"PAH",303,0)="408 SEQ #372^3090422.155418^17"
^DIC(9.4,49,22,10,"PAH",303,1,0)="^^1^1^3090422"
^DIC(9.4,49,22,10,"PAH",303,1,1,0)="Reasonable Charges v3.2"
^DIC(9.4,49,22,10,"PAH",304,0)="402 SEQ #373^3090422.161943^17"
^DIC(9.4,49,22,10,"PAH",304,1,0)="^^10^10^3090422"
^DIC(9.4,49,22,10,"PAH",304,1,1,0)=" "
^DIC(9.4,49,22,10,"PAH",304,1,2,0)="There are three fixes in this patch: The first issue concerns an undefined"
^DIC(9.4,49,22,10,"PAH",304,1,3,0)="error in the Enter/Edit Billing Information [IB EDIT BILLING INFO] option"
^DIC(9.4,49,22,10,"PAH",304,1,4,0)="when site entered a number greater than the default procedure unit which"
^DIC(9.4,49,22,10,"PAH",304,1,5,0)="is 1. The second issue is that user cannot add charges for FEE LTC OPT"
^DIC(9.4,49,22,10,"PAH",304,1,6,0)="RESPITE charge in the Cancel/Edit/Add Patient Charges [IB CANCEL/EDIT/ADD"
^DIC(9.4,49,22,10,"PAH",304,1,7,0)="CHARGES] option. The last issue is when a provider was inactivated in the"
^DIC(9.4,49,22,10,"PAH",304,1,8,0)="NEW PERSON (#200) file and his person class was no longer valid, IB sent"
^DIC(9.4,49,22,10,"PAH",304,1,9,0)="an ATT/REND PROV SPECIALTY value of 99 for the provider causing the claim"
^DIC(9.4,49,22,10,"PAH",304,1,10,0)="rejection."
^DIC(9.4,49,22,10,"PAH",305,0)="372 SEQ #374^3090422.161958^17"
^DIC(9.4,49,22,10,"PAH",305,1,0)="^^2^2^3090422"
^DIC(9.4,49,22,10,"PAH",305,1,1,0)="In cases where outpatient encounter dates have no time recorded"
^DIC(9.4,49,22,10,"PAH",305,1,2,0)="it will default to 00.00 to prevent subscript errors."
^DIC(9.4,49,22,10,"PAH",306,0)="403 SEQ #375^3090422.162017^17"
^DIC(9.4,49,22,10,"PAH",306,1,0)="^^1^1^3090422"
^DIC(9.4,49,22,10,"PAH",306,1,1,0)="eClaims Plus - Diagnosis Present on Admission (POA) Indicator."
^DIC(9.4,49,22,10,"PAH",307,0)="410^3090422.163054^17"
^DIC(9.4,49,22,10,"PAH",308,0)="412 SEQ #377^3090423.110205^17"
^DIC(9.4,49,22,10,"PAH",308,1,0)="^^1^1^3090423"
^DIC(9.4,49,22,10,"PAH",308,1,1,0)="Reasonable Charges v3.3"
^DIC(9.4,49,22,10,"PAH",309,0)="414 SEQ #378^3090429.140424^17"
^DIC(9.4,49,22,10,"PAH",309,1,0)="^^2^2^3090429"
^DIC(9.4,49,22,10,"PAH",309,1,1,0)="This patch allows 9 digit zip codes to be transmitted on bills sent"
^DIC(9.4,49,22,10,"PAH",309,1,2,0)="electronically to Trailblazers so they will no longer be rejected. "
^DIC(9.4,49,22,10,"PAH",310,0)="384^3090714.091235^17"
^DIC(9.4,49,22,10,"PAH",310,1,0)="^^1^1^3090714"
^DIC(9.4,49,22,10,"PAH",310,1,1,0)="E-PHARMACY ENHANCEMENTS"
^DIC(9.4,49,22,10,"PAH",311,0)="399 SEQ #380^3090714.091347^17"
^DIC(9.4,49,22,10,"PAH",311,1,0)="^^1^1^3090714"
^DIC(9.4,49,22,10,"PAH",311,1,1,0)="Reasonable Charges Billing Enhancements II"
^DIC(9.4,49,22,10,"PAH",312,0)="415 SEQ #381^3090727.113008^17"
^DIC(9.4,49,22,10,"PAH",312,1,0)="^^2^2^3090727"
^DIC(9.4,49,22,10,"PAH",312,1,1,0)="Add the Disability Evaluation System (DES) exam STOP CODE (488) to the"
^DIC(9.4,49,22,10,"PAH",312,1,2,0)="IB CLINIC STOP CODE BILLABLE TYPES (#352.5) file."
^DIC(9.4,49,22,10,"PAH",313,0)="400 SEQ #382^3090813.155332^17"
^DIC(9.4,49,22,10,"PAH",313,1,0)="^^1^1^3090813"
^DIC(9.4,49,22,10,"PAH",313,1,1,0)="eClaims Additional Claim Form and Transmission Data (EAD)"
^DIC(9.4,49,22,10,"PAH",314,0)="419 SEQ #383^3090828.100944^17"
^DIC(9.4,49,22,10,"PAH",314,1,0)="^^1^1^3090828"
^DIC(9.4,49,22,10,"PAH",314,1,1,0)="Fee Basis Billing Provider"
^DIC(9.4,49,22,10,"PAH",315,0)="417 SEQ #384^3090901.124748^17"
^DIC(9.4,49,22,10,"PAH",315,1,0)="^^2^2^3090901"
^DIC(9.4,49,22,10,"PAH",315,1,1,0)="This patch is to exclude the MRA's filing errors from the MRA patient"
^DIC(9.4,49,22,10,"PAH",315,1,2,0)="responsibility calculation."
^DIC(9.4,49,22,10,"PAH",316,0)="422 SEQ #385^3090917.150324^17"
^DIC(9.4,49,22,10,"PAH",316,1,0)="^^6^6^3090917"
^DIC(9.4,49,22,10,"PAH",316,1,1,0)="IB*2.0*422 is being released to support the Treating Specialty changes "
^DIC(9.4,49,22,10,"PAH",316,1,2,0)="released in patch: DG*5.3*813."
^DIC(9.4,49,22,10,"PAH",316,1,3,0)="   "
^DIC(9.4,49,22,10,"PAH",316,1,4,0)="Treating Specialties in the SPECIALTY (#42.4) file are being updated by "
^DIC(9.4,49,22,10,"PAH",316,1,5,0)="patch DG*5.3*813.  This patch (IB*2.0*422) updates Integrated Billing to "
^DIC(9.4,49,22,10,"PAH",316,1,6,0)="properly handle the billing of the new Treating Specialties."
^DIC(9.4,49,22,10,"PAH",317,0)="407 SEQ #386^3091020.163304^17"
^DIC(9.4,49,22,10,"PAH",317,1,0)="^^4^4^3091020"
^DIC(9.4,49,22,10,"PAH",317,1,1,0)="This patch addresses the issue regarding site not receiving the Medicare "
^DIC(9.4,49,22,10,"PAH",317,1,2,0)="Remittance Advice (MRA) payments as noted on the Bill Status Report. Site"
^DIC(9.4,49,22,10,"PAH",317,1,3,0)="runs the report on a daily to weekly basis to generate a summary of bill"
^DIC(9.4,49,22,10,"PAH",317,1,4,0)="rate types and statuses."
^DIC(9.4,49,22,10,"PAH",318,0)="376 SEQ #387^3091029.123945^17"
^DIC(9.4,49,22,10,"PAH",318,1,0)="^^4^4^3091029"
^DIC(9.4,49,22,10,"PAH",318,1,1,0)="This patch modifies the extract code for the Date Of Similar"
^DIC(9.4,49,22,10,"PAH",318,1,2,0)="Illness and adds a cross reference to update the ""ON"
^DIC(9.4,49,22,10,"PAH",318,1,3,0)="HOLD DATE"" cross reference after a patient merge to stay"
^DIC(9.4,49,22,10,"PAH",318,1,4,0)="consistent with the new patients info."
^DIC(9.4,49,22,10,"PAH",319,0)="421 SEQ #388^3091104.164125^17"
^DIC(9.4,49,22,10,"PAH",319,1,0)="^^1^1^3091104"
^DIC(9.4,49,22,10,"PAH",319,1,1,0)="Update Stop Codes to reflect Fiscal Year 2010 changes."
^DIC(9.4,49,22,10,"PAH",320,0)="423 SEQ #389^3091110.153718^17"
^DIC(9.4,49,22,10,"PAH",320,1,0)="^^1^1^3091110"
^DIC(9.4,49,22,10,"PAH",320,1,1,0)="Reasonable Charges v3.4"
^DIC(9.4,49,22,10,"PAH",321,0)="393 SEQ #390^3091123.150326^17"
^DIC(9.4,49,22,10,"PAH",321,1,0)="^^2^2^3091123"
^DIC(9.4,49,22,10,"PAH",321,1,1,0)="The purpose of this patch is to update the MCCR Utility file and the"
^DIC(9.4,49,22,10,"PAH",321,1,2,0)="Revenue Code file."
^DIC(9.4,49,22,10,"PAH",322,0)="413 SEQ #391^3091214.123927^17"
^DIC(9.4,49,22,10,"PAH",322,1,0)="^^34^34^3091214"
^DIC(9.4,49,22,10,"PAH",322,1,1,0)="This build provides three new APIs for the Insurance Capture Buffer "
^DIC(9.4,49,22,10,"PAH",322,1,2,0)="application. There are two APIs that are to be used to move Insurance "
^DIC(9.4,49,22,10,"PAH",322,1,3,0)="Buffer (#355.33) file data to other Integrated Billing files or reject "
^DIC(9.4,49,22,10,"PAH",322,1,4,0)="this data. These APIs provide a front end into the existing ACCEPT and "
^DIC(9.4,49,22,10,"PAH",322,1,5,0)="REJECT Insurance Buffer APIs which suppresses all write statements and "
^DIC(9.4,49,22,10,"PAH",322,1,6,0)="interactive fileman calls within the existing code."
^DIC(9.4,49,22,10,"PAH",322,1,7,0)=" "
^DIC(9.4,49,22,10,"PAH",322,1,8,0)="The Insurance Buffer (#355.33) file data is moved to the following files: "
^DIC(9.4,49,22,10,"PAH",322,1,9,0)="     Insurance Company (#36) file"
^DIC(9.4,49,22,10,"PAH",322,1,10,0)="     Group Insurance Plan (#355.3) file"
^DIC(9.4,49,22,10,"PAH",322,1,11,0)="     Patient Insurance Type (#2.312) subfile"
^DIC(9.4,49,22,10,"PAH",322,1,12,0)=" "
^DIC(9.4,49,22,10,"PAH",322,1,13,0)="There is also an API (UPDTICB) which will allow for fields that are not "
^DIC(9.4,49,22,10,"PAH",322,1,14,0)="stored in the insurance buffer to be updated into the IB Insurance Files."
^DIC(9.4,49,22,10,"PAH",322,1,15,0)=" "
^DIC(9.4,49,22,10,"PAH",322,1,16,0)="These APIs are documented in Integration Control Registration (ICR) "
^DIC(9.4,49,22,10,"PAH",322,1,17,0)="#5353, (Accept/Reject Insurance Buffer data APIs)."
^DIC(9.4,49,22,10,"PAH",322,1,18,0)=" "
^DIC(9.4,49,22,10,"PAH",322,1,19,0)="The three new APIs are:"
^DIC(9.4,49,22,10,"PAH",322,1,20,0)="       "
^DIC(9.4,49,22,10,"PAH",322,1,21,0)="   "
^DIC(9.4,49,22,10,"PAH",322,1,22,0)="   ACCEPAPI^IBCNICB(RESULT,IBBUFDA,DFN,IBINSDA,IBGRPDA,IBPOLDA,IBMVINS,"
^DIC(9.4,49,22,10,"PAH",322,1,23,0)="                    IBMVGRP,IBMVPOL,IBNEWINS,IBNEWGRP,IBNEWPOL,IVMREPTR)"
^DIC(9.4,49,22,10,"PAH",322,1,24,0)="   REJECAPI^IBCNICB(RESULT,IBBUFDA,IVMREPTR) "
^DIC(9.4,49,22,10,"PAH",322,1,25,0)="   UPDTICB^IBCNICB (RESULT,DFN,IBPOLDA,IBGRPDA,IBPOLCOM,IBPOLBIL,IBPLAN,"
^DIC(9.4,49,22,10,"PAH",322,1,26,0)="                    IBELEC,IBGPCOM,IBFTF,IBFTFVAL)"
^DIC(9.4,49,22,10,"PAH",322,1,27,0)=" "
^DIC(9.4,49,22,10,"PAH",322,1,28,0)="This patch removes the Traditional Regular type ""B"" cross-reference on the"
^DIC(9.4,49,22,10,"PAH",322,1,29,0)="TYPE OF PLAN (#355.1) file since this cross-reference only contains the"
^DIC(9.4,49,22,10,"PAH",322,1,30,0)="first 30 characters of the NAME (#.01) field. This cross-reference"
^DIC(9.4,49,22,10,"PAH",322,1,31,0)="limitation may create problems when using the Fileman DBS calls. A New"
^DIC(9.4,49,22,10,"PAH",322,1,32,0)="Style Regular ""B"" cross-reference will be added that will contain all"
^DIC(9.4,49,22,10,"PAH",322,1,33,0)="characters to the field limit of 40 characters. In a post install the"
^DIC(9.4,49,22,10,"PAH",322,1,34,0)="patch will build the new ""B"" cross-reference on the file."
^DIC(9.4,49,22,10,"PAH",323,0)="425^3100105.165833^17"
^DIC(9.4,49,22,10,"PAH",323,1,0)="^^1^1^3100105"
^DIC(9.4,49,22,10,"PAH",323,1,1,0)="2010 RX COPAY THRESHOLDS UPDATE"
^DIC(9.4,49,22,10,"PAH",324,0)="373 SEQ #393^3100105.165908^17"
^DIC(9.4,49,22,10,"PAH",324,1,0)="^^5^5^3100105"
^DIC(9.4,49,22,10,"PAH",324,1,1,0)="There are two fixes in this patch: First, in the Enter/Edit Billing"
^DIC(9.4,49,22,10,"PAH",324,1,2,0)="Information [IB EDIT BILLING INFO] option on screen #3, all of the valid "
^DIC(9.4,49,22,10,"PAH",324,1,3,0)="SUBSCRIBER PRIMARY IDs are now allowed (one that wasn't was the letter "
^DIC(9.4,49,22,10,"PAH",324,1,4,0)="""A"" followed by 6 numbers). Second, there is a fix for a bad"
^DIC(9.4,49,22,10,"PAH",324,1,5,0)="cross-reference in the GROUP INSURANCE PLAN (#355.3) file."
^DIC(9.4,49,22,10,"PAH",325,0)="428 SEQ #394^3100128.144735^17"
^DIC(9.4,49,22,10,"PAH",325,1,0)="^^1^1^3100128"
^DIC(9.4,49,22,10,"PAH",325,1,1,0)="Correction to the 2010 Medicare Deductible"
^DIC(9.4,49,22,10,"PAH",326,0)="426 SEQ #395^3100128.144753^17"
^DIC(9.4,49,22,10,"PAH",326,1,0)="^^6^6^3100128"
^DIC(9.4,49,22,10,"PAH",326,1,1,0)="IB*2.0*426 is being released to support the Treating Specialty changes "
^DIC(9.4,49,22,10,"PAH",326,1,2,0)="released in patch: DG*5.3*819."
^DIC(9.4,49,22,10,"PAH",326,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",326,1,4,0)="Treating Specialties in the SPECIALTY (#42.4) file are being updated by "
^DIC(9.4,49,22,10,"PAH",326,1,5,0)="patch DG*5.3*819.  This patch IB*2.0*426 updates Integrated Billing to "
^DIC(9.4,49,22,10,"PAH",326,1,6,0)="properly handle the billing of the new Treating Specialties."
^DIC(9.4,49,22,10,"PAH",327,0)="427 SEQ #396^3100223.162554^17"
^DIC(9.4,49,22,10,"PAH",327,1,0)="^^1^1^3100223"
^DIC(9.4,49,22,10,"PAH",327,1,1,0)="Reasonable Charges v3.5"
^DIC(9.4,49,22,10,"PAH",328,0)="424 SEQ #397^3100421.102645^17"
^DIC(9.4,49,22,10,"PAH",328,1,0)="^^2^2^3100421"
^DIC(9.4,49,22,10,"PAH",328,1,1,0)="This patch addresses one issue regarding new Rate Schedules for the Rate"
^DIC(9.4,49,22,10,"PAH",328,1,2,0)="Types of CHAMPVA and CHAMPVA REIMB. INS.."
^DIC(9.4,49,22,10,"PAH",329,0)="429 SEQ #398^3100610.100032^17"
^DIC(9.4,49,22,10,"PAH",329,1,0)="^^1^1^3100610"
^DIC(9.4,49,22,10,"PAH",329,1,1,0)="RX COPAY PRIORITY GROUP 7&8 INCREASE"
^DIC(9.4,49,22,10,"PAH",330,0)="430 SEQ #399^3100716.092236^17"
^DIC(9.4,49,22,10,"PAH",330,1,0)="^^1^1^3100716"
^DIC(9.4,49,22,10,"PAH",330,1,1,0)="UPDATE PLACE OF SERVICE FILE (#353.1) WITH 16 NEW ENTRIES."
^DIC(9.4,49,22,10,"PAH",331,0)="420 SEQ #400^3100727.153543^17"
^DIC(9.4,49,22,10,"PAH",331,1,0)="^^3^3^3100727"
^DIC(9.4,49,22,10,"PAH",331,1,1,0)="This patch addressed two issues. The first issue is to change the"
