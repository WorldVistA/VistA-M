^DIC(9.4,85,22,0)="^9.49I^2^1"
^DIC(9.4,85,22,1.5,0)="1.5^3051119^2960722"
^DIC(9.4,85,22,1.5,"PAH",0)="^9.4901^20^20"
^DIC(9.4,85,22,1.5,"PAH",1,0)="24 SEQ #22^2970409^1"
^DIC(9.4,85,22,1.5,"PAH",1,1,0)="^^84^84^2970409"
^DIC(9.4,85,22,1.5,"PAH",1,1,1,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,2,0)="1.  When extracting the PDX*MAS data segment, all data pertaining to the"
^DIC(9.4,85,22,1.5,"PAH",1,1,3,0)="    patient's PERIOD OF SERVICE was not able to upload using the LD or LF"
^DIC(9.4,85,22,1.5,"PAH",1,1,4,0)="    of the LOAD/EDIT.  Routine VAQDBII1 has been modified to correct this"
^DIC(9.4,85,22,1.5,"PAH",1,1,5,0)="    problem.  This was reported in NOIS CAN-0595-10112."
^DIC(9.4,85,22,1.5,"PAH",1,1,6,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,7,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,8,0)="IMPORTANT NOTICE:"
^DIC(9.4,85,22,1.5,"PAH",1,1,9,0)="================="
^DIC(9.4,85,22,1.5,"PAH",1,1,10,0)="Once installation of this patch is complete, should your site continue to"
^DIC(9.4,85,22,1.5,"PAH",1,1,11,0)="receive Second/Third Period of Service errors, patient data will have to"
^DIC(9.4,85,22,1.5,"PAH",1,1,12,0)="be re-Requested/Unsolicited.  This is due to the Period of Service fields"
^DIC(9.4,85,22,1.5,"PAH",1,1,13,0)="having a value of null when transmitted.  Routine has been properly"
^DIC(9.4,85,22,1.5,"PAH",1,1,14,0)="corrected to include a 'Yes' or 'No' value when transmission occurs."
^DIC(9.4,85,22,1.5,"PAH",1,1,15,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,16,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,17,0)="ROUTINE SUMMARY:"
^DIC(9.4,85,22,1.5,"PAH",1,1,18,0)="================"
^DIC(9.4,85,22,1.5,"PAH",1,1,19,0)="Below is the routine included in this patch.  The second line of this"
^DIC(9.4,85,22,1.5,"PAH",1,1,20,0)="routine will look like:"
^DIC(9.4,85,22,1.5,"PAH",1,1,21,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,22,0)="    <tab>;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993 "
^DIC(9.4,85,22,1.5,"PAH",1,1,23,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,24,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,25,0)="                            CHECK^XTSUMBLD results"
^DIC(9.4,85,22,1.5,"PAH",1,1,26,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,27,0)="           ROUTINE NAME   BEFORE PATCH    AFTER PATCH     PATCH LIST"
^DIC(9.4,85,22,1.5,"PAH",1,1,28,0)="           =============  =============   ============    =========="
^DIC(9.4,85,22,1.5,"PAH",1,1,29,0)="           VAQDBII1             2772903        2817374      13,24"
^DIC(9.4,85,22,1.5,"PAH",1,1,30,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,31,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,32,0)="       INSTALLATION INSTRUCTIONS"
^DIC(9.4,85,22,1.5,"PAH",1,1,33,0)="       =========================="
^DIC(9.4,85,22,1.5,"PAH",1,1,34,0)="       1.  This patch can be loaded with users on the system. Installation"
^DIC(9.4,85,22,1.5,"PAH",1,1,35,0)="       will take less than 5 minutes.  Use the INSTALL/CHECK MESSAGE"
^DIC(9.4,85,22,1.5,"PAH",1,1,36,0)="       option on the PackMan menu.  This option will load the KIDS package"
^DIC(9.4,85,22,1.5,"PAH",1,1,37,0)="       onto your system."
^DIC(9.4,85,22,1.5,"PAH",1,1,38,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,39,0)="       2.  Review your mapped set.  If any of the routines listed in the"
^DIC(9.4,85,22,1.5,"PAH",1,1,40,0)="       ROUTINE SUMMARY section are mapped, they should be removed from the"
^DIC(9.4,85,22,1.5,"PAH",1,1,41,0)="       mapped set at this time."
^DIC(9.4,85,22,1.5,"PAH",1,1,42,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,43,0)="       3.  From the Kernel Installation and Distribution System Menu,"
^DIC(9.4,85,22,1.5,"PAH",1,1,44,0)="       Select the Installation menu."
^DIC(9.4,85,22,1.5,"PAH",1,1,45,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,46,0)="       4.  From this menu, you may elect to use the following options"
^DIC(9.4,85,22,1.5,"PAH",1,1,47,0)="       (when prompted for INSTALL NAME, enter VAQ*1.5*24):"
^DIC(9.4,85,22,1.5,"PAH",1,1,48,0)="                                              =========="
^DIC(9.4,85,22,1.5,"PAH",1,1,49,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,50,0)="       a.  Backup a Transport Global - this option will create a backup"
^DIC(9.4,85,22,1.5,"PAH",1,1,51,0)="       message of any routines exported with the patch.  It will NOT"
^DIC(9.4,85,22,1.5,"PAH",1,1,52,0)="       backup any other changes such as DDs or templates."
^DIC(9.4,85,22,1.5,"PAH",1,1,53,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,54,0)="       b.  Compare Transport Global to Current System - this option will"
^DIC(9.4,85,22,1.5,"PAH",1,1,55,0)="       allow you to view all changes that will be made when the patch is"
^DIC(9.4,85,22,1.5,"PAH",1,1,56,0)="       installed.  It compares all components of the patch (routines, DDs,"
^DIC(9.4,85,22,1.5,"PAH",1,1,57,0)="       templates, etc.)."
^DIC(9.4,85,22,1.5,"PAH",1,1,58,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,59,0)="       c.  Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,85,22,1.5,"PAH",1,1,60,0)="       you to ensure the integrity of the routines that are in the"
^DIC(9.4,85,22,1.5,"PAH",1,1,61,0)="       transport global."
^DIC(9.4,85,22,1.5,"PAH",1,1,62,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,63,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,64,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,65,0)="       5.  Use the Install Package(s) option and select the package"
^DIC(9.4,85,22,1.5,"PAH",1,1,66,0)="       VAQ*1.5*24"
^DIC(9.4,85,22,1.5,"PAH",1,1,67,0)="       =========="
^DIC(9.4,85,22,1.5,"PAH",1,1,68,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,69,0)="       6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,85,22,1.5,"PAH",1,1,70,0)="       and Protocols?  YES//', respond YES.  When prompted to select the"
^DIC(9.4,85,22,1.5,"PAH",1,1,71,0)="                                       ==="
^DIC(9.4,85,22,1.5,"PAH",1,1,72,0)="       options you would like to place out of order, enter the following:"
^DIC(9.4,85,22,1.5,"PAH",1,1,73,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,74,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,75,0)="                        VAQ (MENU) MAIN       Patient Data Exchange"
^DIC(9.4,85,22,1.5,"PAH",1,1,76,0)="                        ==============="
^DIC(9.4,85,22,1.5,"PAH",1,1,77,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,78,0)="       7.  MSM sites:  Please ensure you answer YES when asked if you want"
^DIC(9.4,85,22,1.5,"PAH",1,1,79,0)="       to move the routines to other systems and indicated the appropriate"
^DIC(9.4,85,22,1.5,"PAH",1,1,80,0)="       CPUs."
^DIC(9.4,85,22,1.5,"PAH",1,1,81,0)=" "
^DIC(9.4,85,22,1.5,"PAH",1,1,82,0)="       8.  If routines were unmapped as part of step 2, they should be"
^DIC(9.4,85,22,1.5,"PAH",1,1,83,0)="       returned to the mapped set once the installation has run to"
^DIC(9.4,85,22,1.5,"PAH",1,1,84,0)="       completion."
^DIC(9.4,85,22,1.5,"PAH",2,0)="26 SEQ #24^2991210^1"
^DIC(9.4,85,22,1.5,"PAH",2,1,0)="^^67^67^2991210"
^DIC(9.4,85,22,1.5,"PAH",2,1,1,0)="1. Y2K Waiver Request ID#:Y2KW0001     Y2K Waiver Status: Approved"
^DIC(9.4,85,22,1.5,"PAH",2,1,2,0)="   This patch may be installed during the Y2K Moratorium, either"
^DIC(9.4,85,22,1.5,"PAH",2,1,3,0)="   BEFORE 12/15/99 or AFTER 1/15/2000.  This patch MAY NOT be"
^DIC(9.4,85,22,1.5,"PAH",2,1,4,0)="   installed between 12/15/99 and 1/15/2000(the Y2K Lockdown Period)."
^DIC(9.4,85,22,1.5,"PAH",2,1,5,0)=" "
^DIC(9.4,85,22,1.5,"PAH",2,1,6,0)="   BRK-0596-12069,EKH-0498-42577,EKH-1298-40432,NAS-0998-32328."
^DIC(9.4,85,22,1.5,"PAH",2,1,7,0)="   Several sites have indicated that VAQ-TRANSACTION FILE(394.61)"
^DIC(9.4,85,22,1.5,"PAH",2,1,8,0)="   periodically creates duplicate Transaction numbers.  Routines"
^DIC(9.4,85,22,1.5,"PAH",2,1,9,0)="   VAQFILE and VAQREQ06 have been revised to ensure Lock of file"
^DIC(9.4,85,22,1.5,"PAH",2,1,10,0)="   until creation of IEN and Transaction number."
^DIC(9.4,85,22,1.5,"PAH",2,1,11,0)=" "
^DIC(9.4,85,22,1.5,"PAH",2,1,12,0)=" "
^DIC(9.4,85,22,1.5,"PAH",2,1,13,0)="Test Sites:"
^DIC(9.4,85,22,1.5,"PAH",2,1,14,0)="=========="
