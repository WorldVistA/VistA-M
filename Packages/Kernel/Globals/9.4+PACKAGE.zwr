^DIC(9.4,14,22,5.9,"PAH",121,1,171,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",121,1,172,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",121,1,173,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",121,1,174,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",121,1,175,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",121,1,176,0)=" "
^DIC(9.4,14,22,5.9,"PAH",121,1,177,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",121,1,178,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",121,1,179,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",121,1,180,0)="   LR7OB3           12268913       12535845       **121,187,272**"
