^DIC(9.4,14,22,5.9,"PAH",226,1,101,0)="        30          EXCLUDE URGENCY                     NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,102,0)="        32          GREETING                            NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,103,0)="        40          WELCOME TO                          NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,104,0)="        42          YOUR HOST IS                        NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,105,0)="        44          HOST TITLE                          NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,106,0)="        45          SPACER LABEL PRINTER                NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,107,0)="        50          ATLERNATIVE LABEL ROUTINE           NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,108,0)="        51          NUMBER OF SCAN RE-TRY               NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,109,0)="        52          DELETE SAME DAY DUPLICATES          NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,110,0)="        54          BINGO BOARD DEVICE                  NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,111,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,112,0)="HOWDY SPECIMEN TIMES BY UID FILE(#69.87): This file is used to capture and"
^DIC(9.4,14,22,5.9,"PAH",226,1,113,0)="retain the specimen demographics."
^DIC(9.4,14,22,5.9,"PAH",226,1,114,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,115,0)="FILE #   FIELD #    FIELD NAME                 NEW/MODIFIED item(s)"
