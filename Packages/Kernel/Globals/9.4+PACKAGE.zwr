^DIC(9.4,11,22,5.03,"PAH",47,1,133,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,134,0)="Below shows the Data Dictionary as modified with the installation of this"
^DIC(9.4,11,22,5.03,"PAH",47,1,135,0)="Patch for the Auto Instrument File. "
^DIC(9.4,11,22,5.03,"PAH",47,1,136,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,137,0)="STANDARD DATA DICTIONARY #62.41 -- LABORATORY TESTS SUB-FILE   "
^DIC(9.4,11,22,5.03,"PAH",47,1,138,0)="                                               JUN 8,2016@12:37:17  PAGE 1"
^DIC(9.4,11,22,5.03,"PAH",47,1,139,0)="STORED IN ^LAB(62.4,D0,3,   SITE: TEST.CHEYENNE.DOMAIN.EXT   UCI: "
^DIC(9.4,11,22,5.03,"PAH",47,1,140,0)="VISTA,ROU"
^DIC(9.4,11,22,5.03,"PAH",47,1,141,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,142,0)="DATA          NAME                  GLOBAL        DATA"
^DIC(9.4,11,22,5.03,"PAH",47,1,143,0)="ELEMENT       TITLE                 LOCATION      TYPE"
^DIC(9.4,11,22,5.03,"PAH",47,1,144,0)="--------------------------------------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,145,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,146,0)="62.41,.01     TEST                   0;1 POINTER TO LABORATORY TEST FILE ("
^DIC(9.4,11,22,5.03,"PAH",47,1,147,0)="                                #60) (Required) (Multiply asked)"
^DIC(9.4,11,22,5.03,"PAH",47,1,148,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,149,0)="              INPUT TRANSFORM:  S DIC(""S"")=""I $D(^LAB(60,Y,.2))!(""""MI""""[$P"
^DIC(9.4,11,22,5.03,"PAH",47,1,150,0)="                                (^LAB(60,Y,0),U,4))"" D ^DIC K DIC S DIC=DI"
^DIC(9.4,11,22,5.03,"PAH",47,1,151,0)="                                E,X=+Y K:Y<0 X"
^DIC(9.4,11,22,5.03,"PAH",47,1,152,0)="              LAST EDITED:      JUN 07, 2016 "
^DIC(9.4,11,22,5.03,"PAH",47,1,153,0)="              HELP-PROMPT:      Enter the name of a test for which the "
^DIC(9.4,11,22,5.03,"PAH",47,1,154,0)="                                instrument will send data. "
^DIC(9.4,11,22,5.03,"PAH",47,1,155,0)="              DESCRIPTION:      This contains the test names for this"
^DIC(9.4,11,22,5.03,"PAH",47,1,156,0)="                                instrument.  "
^DIC(9.4,11,22,5.03,"PAH",47,1,157,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,158,0)="              SCREEN:           S DIC(""S"")=""I $D(^LAB(60,Y,.2))!(""""MI""""[$P"
^DIC(9.4,11,22,5.03,"PAH",47,1,159,0)="                                (^LAB(60,Y,0),U,4))"""
^DIC(9.4,11,22,5.03,"PAH",47,1,160,0)="              EXPLANATION:      Allow CH atomic test or Microbiology subsc"
^DIC(9.4,11,22,5.03,"PAH",47,1,161,0)="                                ript test"
^DIC(9.4,11,22,5.03,"PAH",47,1,162,0)="              FIELD INDEX:      AD (#867)    MUMPS    IR    ACTION"
^DIC(9.4,11,22,5.03,"PAH",47,1,163,0)="                  Short Descr:  Set ""ROUTINE STORAGE"" field with CH"
^DIC(9.4,11,22,5.03,"PAH",47,1,164,0)="                                subscripted test data name number"
^DIC(9.4,11,22,5.03,"PAH",47,1,165,0)="                  Description:  This trigger cross reference will only"
^DIC(9.4,11,22,5.03,"PAH",47,1,166,0)="                                populate the ""ROUTINE STORAGE"" field with"
^DIC(9.4,11,22,5.03,"PAH",47,1,167,0)="                                63.04 data location file number for CH"
^DIC(9.4,11,22,5.03,"PAH",47,1,168,0)="                                (Chemistry) atomic subscripted test having"
^DIC(9.4,11,22,5.03,"PAH",47,1,169,0)="                                data name field populated. See example"
^DIC(9.4,11,22,5.03,"PAH",47,1,170,0)="                                below.  MI (Microbiology) subscripted test"
^DIC(9.4,11,22,5.03,"PAH",47,1,171,0)="                                have no data name, therefore the ""AUTO "
^DIC(9.4,11,22,5.03,"PAH",47,1,172,0)="                                INSTRUMENT"" file # 62.4, ""TEST"" field #30,"
^DIC(9.4,11,22,5.03,"PAH",47,1,173,0)="                                (#62.41), subfile #62.41, ""ROUTINE"
^DIC(9.4,11,22,5.03,"PAH",47,1,174,0)="                                STORAGE"" file #11 will NOT be set.  "
^DIC(9.4,11,22,5.03,"PAH",47,1,175,0)="                                 "
^DIC(9.4,11,22,5.03,"PAH",47,1,176,0)="                                EXAMPLE: CH subscripted test having DATA"
^DIC(9.4,11,22,5.03,"PAH",47,1,177,0)="                                NAME will populate the ROUTINE STORAGE "
^DIC(9.4,11,22,5.03,"PAH",47,1,178,0)="                                field with: TV(#,1) MI subscripted test"
^DIC(9.4,11,22,5.03,"PAH",47,1,179,0)="                                will NOT set the ROUTINE STORAGE field.  "
^DIC(9.4,11,22,5.03,"PAH",47,1,180,0)="                    Set Logic:  S $P(^LAB(62.4,DA(1),3,DA,1),U)=""TV(""_X2(3"
^DIC(9.4,11,22,5.03,"PAH",47,1,181,0)="                                )_"",1)"""
^DIC(9.4,11,22,5.03,"PAH",47,1,182,0)="                     Set Cond:  S X=(X2(2)=""CH"")&(X2(3)'="""")"
^DIC(9.4,11,22,5.03,"PAH",47,1,183,0)="                   Kill Logic:  S $P(^LAB(62.4,DA(1),3,DA,1),U)="""""
^DIC(9.4,11,22,5.03,"PAH",47,1,184,0)="                         X(1):  TEST  (62.41,.01)  (Subscr 1)  (Len 10)"
^DIC(9.4,11,22,5.03,"PAH",47,1,185,0)="                                (forwards)"
^DIC(9.4,11,22,5.03,"PAH",47,1,186,0)="                                  Transform (Display):   "
^DIC(9.4,11,22,5.03,"PAH",47,1,187,0)="                         X(2):  Computed Code: S X=$P($G(^LAB(60,X(1),0)),"
^DIC(9.4,11,22,5.03,"PAH",47,1,188,0)="                                U,4)"
^DIC(9.4,11,22,5.03,"PAH",47,1,189,0)="                                  (Subscr 2)"
^DIC(9.4,11,22,5.03,"PAH",47,1,190,0)="                         X(3):  Computed Code: S X=$P($G(^LAB(60,X(1),.2))"
^DIC(9.4,11,22,5.03,"PAH",47,1,191,0)="                                ,U)"
^DIC(9.4,11,22,5.03,"PAH",47,1,192,0)="                                  (Subscr 3)"
^DIC(9.4,11,22,5.03,"PAH",47,1,193,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,194,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,195,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,196,0)="      FILES POINTED TO                      FIELDS"
^DIC(9.4,11,22,5.03,"PAH",47,1,197,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,198,0)="LABORATORY TEST (#60)             TEST (#.01)"
