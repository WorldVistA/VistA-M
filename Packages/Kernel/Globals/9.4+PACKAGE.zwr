^DIC(9.4,100,22,15,"PAH",51,1,35,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,36,0)="Subject: YS TEST USAGE"
^DIC(9.4,100,22,15,"PAH",51,1,37,0)="You may enter the text of the message..."
^DIC(9.4,100,22,15,"PAH",51,1,38,0)="Input file does not exist"
^DIC(9.4,100,22,15,"PAH",51,1,39,0)="[EOB]"
^DIC(9.4,100,22,15,"PAH",51,1,40,0)="*C"
^DIC(9.4,100,22,15,"PAH",51,1,41,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,42,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,43,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,44,0)="3031001^3040930           <--------- The dates requested to do the search "
^DIC(9.4,100,22,15,"PAH",51,1,45,0)="                                     must be in VA FILEMAN's conventional"
^DIC(9.4,100,22,15,"PAH",51,1,46,0)="[EOB]                                internal format. The first date is the"
^DIC(9.4,100,22,15,"PAH",51,1,47,0)="                                     start date and the second date is the "
^DIC(9.4,100,22,15,"PAH",51,1,48,0)="                                     end date for the request."
^DIC(9.4,100,22,15,"PAH",51,1,49,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,50,0)="*EX"
^DIC(9.4,100,22,15,"PAH",51,1,51,0)="USER$:[XXXXXXX]DIWE$545444715.TMP;1 1 line"
^DIC(9.4,100,22,15,"PAH",51,1,52,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,53,0)="Send mail to: XXXXXX,XXXX X// S.YS TEST USAGE       Mental Health Test "
^DIC(9.4,100,22,15,"PAH",51,1,54,0)="Usage Server                  ---------------         "
^DIC(9.4,100,22,15,"PAH",51,1,55,0)="And Send to:                  The form of the mail message is identical to "
^DIC(9.4,100,22,15,"PAH",51,1,56,0)="                              any other mail message except that it is "
^DIC(9.4,100,22,15,"PAH",51,1,57,0)="                              addressed to S.<option name>. The ""S."" routes "
^DIC(9.4,100,22,15,"PAH",51,1,58,0)="                              the message to the server request software."
^DIC(9.4,100,22,15,"PAH",51,1,59,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,60,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,61,0)="The output from the server request is returned in the form of a MAILMAN "
^DIC(9.4,100,22,15,"PAH",51,1,62,0)="message.  This is an example of the server request to S.YS TEST USAGE."
^DIC(9.4,100,22,15,"PAH",51,1,63,0)="                                                      ---------------"
^DIC(9.4,100,22,15,"PAH",51,1,64,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,65,0)="Subj: MH testing Statictics: YS TEST USAGE  [#79130] 09/15/04@14:39"
