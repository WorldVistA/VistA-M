^DIC(9.4,96,22,1.2,"PAH",21,1,189,0)="   DENTVAU     2285628      2840803        38,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,190,0)="   DENTVDD1    5137431      5150464        31,38,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,191,0)="   DENTVIP1    8645242      7061918        33,34,35,36,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,192,0)="   DENTVIP2    14330152     14335172       36,39"
