^DIC(9.4,73,22,9,"PAH",20,1,38,0)="This patch introduces no new routines."
^DIC(9.4,73,22,9,"PAH",20,1,39,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",20,1,40,0)=" "
^DIC(9.4,73,22,9,"PAH",20,1,41,0)="INSTALLATION:"
^DIC(9.4,73,22,9,"PAH",20,1,42,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",20,1,43,0)="is at a minimum.  It requires patch AFJX*5.1*31."
^DIC(9.4,73,22,9,"PAH",20,1,44,0)="1.  Users may be on the system during installation of this patch."
