^DIC(9.4,48,22,5.28,"PAH",680,1,24,0)="VSE-8441: BF - VistA: Add new text field DUPLICATE REASON to the SDEC"
^DIC(9.4,48,22,5.28,"PAH",680,1,25,0)="          APPT REQUEST file"
^DIC(9.4,48,22,5.28,"PAH",680,1,26,0)="VSE-8478: TB - VistA: Modify SDES2 INACTIVATE CLINIC to check to see if "
^DIC(9.4,48,22,5.28,"PAH",680,1,27,0)="          there is a current reactivate date on the clinic that is less"
^DIC(9.4,48,22,5.28,"PAH",680,1,28,0)="          than or equal to the passed in inactivate date"
^DIC(9.4,48,22,5.28,"PAH",680,1,29,0)="VSE-8728: LB - VistA: Modifications to SDES2APPTUTIL to fix a leaking "
^DIC(9.4,48,22,5.28,"PAH",680,1,30,0)="          variable"
