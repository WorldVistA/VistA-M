^DIC(9.4,14,22,5.9,"PAH",98,1,431,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,432,0)="                 Relinking NATIONAL VA LAB CODES TO WKLD CODE"
^DIC(9.4,14,22,5.9,"PAH",98,1,433,0)="                                   LR*5.2*263"
^DIC(9.4,14,22,5.9,"PAH",98,1,434,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,435,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,436,0)=" "
