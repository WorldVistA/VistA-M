^DIC(9.4,14,22,5.9,"PAH",152,1,728,0)="                          MODIFY WHAT FILE: WKLD CODE"
^DIC(9.4,14,22,5.9,"PAH",152,1,729,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,730,0)="                            VERIFY WHICH FIELD: ALL"
^DIC(9.4,14,22,5.9,"PAH",152,1,731,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,732,0)="                  DO YOU MEAN ALL THE FIELDS IN THE FILE? YES           "
^DIC(9.4,14,22,5.9,"PAH",152,1,733,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,734,0)=" "
