^DIC(9.4,4,22,1,"PAH",75,0)="90 SEQ #100^2991104^1"
^DIC(9.4,4,22,1,"PAH",75,1,0)="^^60^60^2991104"
^DIC(9.4,4,22,1,"PAH",75,1,1,0)="Patch XM*7.1*90"
^DIC(9.4,4,22,1,"PAH",75,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",75,1,3,0)="NOIS:  AMA-0399-70162, BHS-0799-11263, BOI-0499-50453, CMO-0397-42224,"
^DIC(9.4,4,22,1,"PAH",75,1,4,0)="       GRJ-0899-50198"
^DIC(9.4,4,22,1,"PAH",75,1,5,0)="Test Sites:  DSS: Bay Pines, FL"
^DIC(9.4,4,22,1,"PAH",75,1,6,0)="             PDX: Grand Junction, CO; Boston HCS"
^DIC(9.4,4,22,1,"PAH",75,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",75,1,8,0)="This patch fixes problems experienced in the PDX and DSS packages."
^DIC(9.4,4,22,1,"PAH",75,1,9,0)="This patch removes the string length restriction for TCP/IP transmissions."
^DIC(9.4,4,22,1,"PAH",75,1,10,0)="Note that the restriction is only removed at the sending site."
^DIC(9.4,4,22,1,"PAH",75,1,11,0)="(At the receiving site, the restriction is unchanged.  If MailMan receives"
^DIC(9.4,4,22,1,"PAH",75,1,12,0)="a line over 255 characters, it chops it up into as many lines as needed.)"
^DIC(9.4,4,22,1,"PAH",75,1,13,0)=""
