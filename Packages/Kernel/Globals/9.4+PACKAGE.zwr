^DIC(9.4,4,22,1,"PAH",160,1,149,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,150,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",160,1,151,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",160,1,152,0)=" "
^DIC(9.4,4,22,1,"PAH",160,1,153,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",160,1,154,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",160,1,155,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",160,1,156,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",160,1,157,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",160,1,158,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",160,1,159,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",160,1,160,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",160,1,161,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",160,1,162,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",160,1,163,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",160,1,164,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",160,1,165,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",160,1,166,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",160,1,167,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",160,1,168,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",160,1,169,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",160,1,170,0)=" Select INSTALL NAME:    XM*7.1*179    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",160,1,171,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",160,1,172,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",160,1,173,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",160,1,174,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",160,1,175,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",160,1,176,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",160,1,177,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",160,1,178,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",160,1,179,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",160,1,180,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,181,0)=" DEVICE: HOME// <It's up to you, you may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",160,1,182,0)="                -----------------------------------------------"
^DIC(9.4,4,22,1,"PAH",160,1,183,0)=" (Just don't queue it for a time when XMCLEAN, XMAUTOPURGE, or XMUT-CHKFIL"
^DIC(9.4,4,22,1,"PAH",160,1,184,0)="  will be running!)"
^DIC(9.4,4,22,1,"PAH",160,1,185,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",160,1,186,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",161,0)="190 SEQ #186^3010802^1"
^DIC(9.4,4,22,1,"PAH",161,1,0)="^^61^61^3010802"
^DIC(9.4,4,22,1,"PAH",161,1,1,0)="Patch XM*7.1*190"
^DIC(9.4,4,22,1,"PAH",161,1,2,0)=" "
^DIC(9.4,4,22,1,"PAH",161,1,3,0)="NOIS BHH-0701-40720"
^DIC(9.4,4,22,1,"PAH",161,1,4,0)="Test Sites: BLACK HILLS HCS"
^DIC(9.4,4,22,1,"PAH",161,1,5,0)="Currently, broadcast message replies are delivered, but are not seen as"
^DIC(9.4,4,22,1,"PAH",161,1,6,0)="new to the users.  This is because such broadcasts do not have recipient"
^DIC(9.4,4,22,1,"PAH",161,1,7,0)="lists (under QD), and MailMan uses recipient lists to deliver replies."
^DIC(9.4,4,22,1,"PAH",161,1,8,0)="To fix this, MailMan will no longer permit a reply to such broadcasts."
^DIC(9.4,4,22,1,"PAH",161,1,9,0)="A new broadcast message will have to be sent, in lieu of a reply.  This"
^DIC(9.4,4,22,1,"PAH",161,1,10,0)="will ensure that all recipients, even those with forwarding addresses,"
^DIC(9.4,4,22,1,"PAH",161,1,11,0)="see the intended reply."
^DIC(9.4,4,22,1,"PAH",161,1,12,0)=" "
^DIC(9.4,4,22,1,"PAH",161,1,13,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",161,1,14,0)="is at a minimum.  It requires MailMan patch XM*7.1*172."
^DIC(9.4,4,22,1,"PAH",161,1,15,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",161,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",161,1,17,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",161,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",161,1,19,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",161,1,20,0)=" "
