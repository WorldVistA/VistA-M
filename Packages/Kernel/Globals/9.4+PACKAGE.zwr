^DIC(9.4,196,0)="HERBAL/OTC/NON-VA MEDS^PSH^Non-VA Medications"
^DIC(9.4,197,0)="CLINICAL PROCEDURES^MD^Clinical Procedures"
^DIC(9.4,197,1,0)="^9.41A^5^5^3070402^^^^"
^DIC(9.4,197,1,1,0)="Clinical Procedures (CP) primarily functions as a conduit for passing final"
^DIC(9.4,197,1,2,0)="patient results, using HL7 messaging, between vendor clinical information"
^DIC(9.4,197,1,3,0)="systems (CIS), and the VISTA hospital information system.  Clinical"
^DIC(9.4,197,1,4,0)="Procedures was developed in conjunction with Consults, CPRS, TIU and"
^DIC(9.4,197,1,5,0)="VISTA Imaging and is fully integrated with these packages."
^DIC(9.4,197,5)="Hines"
^DIC(9.4,197,7)="^^I"
