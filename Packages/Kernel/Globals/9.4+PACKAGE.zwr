^DIC(9.4,4,22,1,"PAH",147,1,47,0)=" "
^DIC(9.4,4,22,1,"PAH",147,1,48,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",147,1,49,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",147,1,50,0)="minimum.  It requires MailMan patches XM*7.1*126, *136, *143, *151, *168, &"
^DIC(9.4,4,22,1,"PAH",147,1,51,0)="*172."
^DIC(9.4,4,22,1,"PAH",147,1,52,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",147,1,53,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",147,1,54,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",147,1,55,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",147,1,56,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",147,1,57,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,1,"PAH",147,1,58,0)="    but you should stop the background filer."
^DIC(9.4,4,22,1,"PAH",147,1,59,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",147,1,60,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",147,1,61,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",147,1,62,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",147,1,63,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",147,1,64,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",147,1,65,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",147,1,66,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",147,1,67,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",147,1,68,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",147,1,69,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",147,1,70,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",147,1,71,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",147,1,72,0)=" Select INSTALL NAME:    XM*7.1*177     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",147,1,73,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",147,1,74,0)=" Install Questions for XM*7.1*177"
^DIC(9.4,4,22,1,"PAH",147,1,75,0)=""
^DIC(9.4,4,22,1,"PAH",147,1,76,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",147,1,77,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",147,1,78,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",147,1,79,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",147,1,80,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",147,1,81,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",147,1,82,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",147,1,83,0)=""
^DIC(9.4,4,22,1,"PAH",147,1,84,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,1,"PAH",147,1,85,0)="                ------------------"
^DIC(9.4,4,22,1,"PAH",147,1,86,0)="6.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",147,1,87,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",147,1,88,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",147,1,89,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",147,1,90,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",147,1,91,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",147,1,92,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",148,0)="159 SEQ #173^3010517^1"
^DIC(9.4,4,22,1,"PAH",148,1,0)="^^222^222^3010517"
^DIC(9.4,4,22,1,"PAH",148,1,1,0)="Patch XM*7.1*159"
^DIC(9.4,4,22,1,"PAH",148,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,3,0)="Test Sites:  FORUM, Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",148,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,5,0)="E3R: 3753"
^DIC(9.4,4,22,1,"PAH",148,1,6,0)="Recognize and support the vaporize days field which is in file #3.6,"
^DIC(9.4,4,22,1,"PAH",148,1,7,0)="BULLETIN.  (This is field #5, RETENTION DAYS, which has been there since"
^DIC(9.4,4,22,1,"PAH",148,1,8,0)="1994, but never used!) If the field is filled in, the bulletin will be set"
^DIC(9.4,4,22,1,"PAH",148,1,9,0)="to vaporize that many days from the time the bulletin is sent. "
^DIC(9.4,4,22,1,"PAH",148,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,11,0)="NOIS: PUG-0800-50981"
^DIC(9.4,4,22,1,"PAH",148,1,12,0)="E3R: 2736, 2765, 3286, 8959, 10302, 12540"
^DIC(9.4,4,22,1,"PAH",148,1,13,0)="Warn the user of an impending purge-by-date a certain number of days before"
^DIC(9.4,4,22,1,"PAH",148,1,14,0)="the messages are actually purged.  The warning will be a broadcast bulletin,"
^DIC(9.4,4,22,1,"PAH",148,1,15,0)="which will vaporize on the purge date.  This patch includes updated options"
^DIC(9.4,4,22,1,"PAH",148,1,16,0)="XMKSP and XMPURGE-BY-DATE, new bulletin XM DATE PURGE WARNING, and two new"
^DIC(9.4,4,22,1,"PAH",148,1,17,0)="fields in file #4.3, MAILMAN SITE PARAMETERS.  Read on for details."
^DIC(9.4,4,22,1,"PAH",148,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,19,0)="Two new fields have been added to file #4.3 MAILMAN SITE PARAMETERS.  The"
^DIC(9.4,4,22,1,"PAH",148,1,20,0)="option XMKSP, to edit those parameters, has been updated to include them."
^DIC(9.4,4,22,1,"PAH",148,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,22,0)="STANDARD DATA DICTIONARY #4.3 -- MAILMAN SITE PARAMETERS FILE"
^DIC(9.4,4,22,1,"PAH",148,1,23,0)="STORED IN ^XMB(1,"
^DIC(9.4,4,22,1,"PAH",148,1,24,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",148,1,25,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",148,1,26,0)="----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",148,1,27,0)="4.3,10.03  DATE PURGE CUTOFF DAYS .18;1 NUMBER"
^DIC(9.4,4,22,1,"PAH",148,1,28,0)="           INPUT TRANSFORM:  K:+X'=X!(X>9999)!(X<365)!(X?.E1"".""1N.N) X"
^DIC(9.4,4,22,1,"PAH",148,1,29,0)="           LAST EDITED:      NOV 17, 2000 "
^DIC(9.4,4,22,1,"PAH",148,1,30,0)="           HELP-PROMPT:      Type a Number between 365 and 9999, 0 Decimal "
^DIC(9.4,4,22,1,"PAH",148,1,31,0)="                             Digits "
^DIC(9.4,4,22,1,"PAH",148,1,32,0)="           DESCRIPTION:      This field is used by the option"
^DIC(9.4,4,22,1,"PAH",148,1,33,0)="                             XMPURGE-BY-DATE.  When this option is run, the"
^DIC(9.4,4,22,1,"PAH",148,1,34,0)="                             date purge will be set to purge all messages"
^DIC(9.4,4,22,1,"PAH",148,1,35,0)="                             originating this many days ago and before.  "
^DIC(9.4,4,22,1,"PAH",148,1,36,0)="                                 "
^DIC(9.4,4,22,1,"PAH",148,1,37,0)="                             If this field is null, the default will be 730"
^DIC(9.4,4,22,1,"PAH",148,1,38,0)="                             days (2 years).  "
^DIC(9.4,4,22,1,"PAH",148,1,39,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,40,0)="4.3,10.04  DATE PURGE GRACE PERIOD .18;2 NUMBER"
^DIC(9.4,4,22,1,"PAH",148,1,41,0)="           INPUT TRANSFORM:  K:+X'=X!(X>31)!(X<3)!(X?.E1"".""1N.N) X"
^DIC(9.4,4,22,1,"PAH",148,1,42,0)="           LAST EDITED:      NOV 17, 2000 "
^DIC(9.4,4,22,1,"PAH",148,1,43,0)="           HELP-PROMPT:      Type a Number between 3 and 31, 0 Decimal "
^DIC(9.4,4,22,1,"PAH",148,1,44,0)="                             Digits "
^DIC(9.4,4,22,1,"PAH",148,1,45,0)="           DESCRIPTION:      This is the number of days' warning the users"
^DIC(9.4,4,22,1,"PAH",148,1,46,0)="                             get before the date purge, XMPURGE-BY-DATE, is"
^DIC(9.4,4,22,1,"PAH",148,1,47,0)="                             run.  "
^DIC(9.4,4,22,1,"PAH",148,1,48,0)="                                 "
^DIC(9.4,4,22,1,"PAH",148,1,49,0)="                             This field is used by the option"
^DIC(9.4,4,22,1,"PAH",148,1,50,0)="                             XMPURGE-BY-DATE only if that option is"
^DIC(9.4,4,22,1,"PAH",148,1,51,0)="                             scheduled, not if it is run interactively.  "
^DIC(9.4,4,22,1,"PAH",148,1,52,0)="                                "
^DIC(9.4,4,22,1,"PAH",148,1,53,0)="                             At the scheduled date/time, the bulletin, XM"
^DIC(9.4,4,22,1,"PAH",148,1,54,0)="                             DATE PURGE WARNING, is broadcast to all users"
^DIC(9.4,4,22,1,"PAH",148,1,55,0)="                             to warn them of the coming date purge, and the"
^DIC(9.4,4,22,1,"PAH",148,1,56,0)="                             actual date purge is then queued to run this"
^DIC(9.4,4,22,1,"PAH",148,1,57,0)="                             many days later.  "
^DIC(9.4,4,22,1,"PAH",148,1,58,0)="                                 "
^DIC(9.4,4,22,1,"PAH",148,1,59,0)="                             If this field is null, the date purge will run"
^DIC(9.4,4,22,1,"PAH",148,1,60,0)="                             at the scheduled date/time, and no bulletin"
^DIC(9.4,4,22,1,"PAH",148,1,61,0)="                             will be sent.  "
^DIC(9.4,4,22,1,"PAH",148,1,62,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,63,0)="You are now able to schedule the option XMPURGE-BY-DATE.  You couldn't do"
^DIC(9.4,4,22,1,"PAH",148,1,64,0)="that before."
^DIC(9.4,4,22,1,"PAH",148,1,65,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,66,0)="NAME: XMPURGE-BY-DATE"
^DIC(9.4,4,22,1,"PAH",148,1,67,0)="  MENU TEXT: Purge Messages by Origination Date"
^DIC(9.4,4,22,1,"PAH",148,1,68,0)="  TYPE: run routine                     CREATOR: POSTMASTER"
^DIC(9.4,4,22,1,"PAH",148,1,69,0)="  LOCK: XMMGR                           PACKAGE: MAILMAN"
^DIC(9.4,4,22,1,"PAH",148,1,70,0)=" DESCRIPTION:   You must hold the XMMGR and XMSTAR keys to run this option.  "
^DIC(9.4,4,22,1,"PAH",148,1,71,0)="  "
^DIC(9.4,4,22,1,"PAH",148,1,72,0)=" XMPURGE-BY-DATE will delete *all* messages originating before a cutoff"
^DIC(9.4,4,22,1,"PAH",148,1,73,0)=" date. It will delete those messages from users' mailboxes, and then delete"
^DIC(9.4,4,22,1,"PAH",148,1,74,0)=" them from the MESSAGE file, along with any responses chained to them. This"
^DIC(9.4,4,22,1,"PAH",148,1,75,0)=" flexible option can be run interactively or scheduled to run on a"
^DIC(9.4,4,22,1,"PAH",148,1,76,0)=" recurring basis, the cutoff date can be controlled, users may or may not"
^DIC(9.4,4,22,1,"PAH",148,1,77,0)=" be sent a warning bulletin to warn them of the purge ahead of time, and"
^DIC(9.4,4,22,1,"PAH",148,1,78,0)=" the option may produce a report to show how many messages and responses it"
^DIC(9.4,4,22,1,"PAH",148,1,79,0)=" deleted."
^DIC(9.4,4,22,1,"PAH",148,1,80,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,81,0)=" When the option is run interactively:"
^DIC(9.4,4,22,1,"PAH",148,1,82,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,83,0)=" 1) It asks for the cutoff date. The default is based on the DATE PURGE"
^DIC(9.4,4,22,1,"PAH",148,1,84,0)=" CUTOFF DAYS field (10.03) in the MAILMAN SITE PARAMETERS file (4.3). If"
^DIC(9.4,4,22,1,"PAH",148,1,85,0)=" that field is null, it defaults to 730 days (2 years) in the past."
^DIC(9.4,4,22,1,"PAH",148,1,86,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,87,0)=" 2) It asks whether to run the option in Test mode. In Test mode, the"
^DIC(9.4,4,22,1,"PAH",148,1,88,0)=" option will not purge any messages, just report how many and which would"
^DIC(9.4,4,22,1,"PAH",148,1,89,0)=" have been purged."
^DIC(9.4,4,22,1,"PAH",148,1,90,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,91,0)=" 3) It asks for the output device on which to print the report. The purge"
^DIC(9.4,4,22,1,"PAH",148,1,92,0)=" and report can be queued here to run later."
^DIC(9.4,4,22,1,"PAH",148,1,93,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,94,0)=" 4) If it's queued more than 3 days in the future, the option immediately"
^DIC(9.4,4,22,1,"PAH",148,1,95,0)=" broadcasts the XM DATE PURGE WARNING bulletin to all users to notify them"
^DIC(9.4,4,22,1,"PAH",148,1,96,0)=" of the upcoming purge and give them a chance to save off old messages"
^DIC(9.4,4,22,1,"PAH",148,1,97,0)=" beforehand."
^DIC(9.4,4,22,1,"PAH",148,1,98,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,99,0)=" 5) If it's queued less than 3 days in the future, or is not queued, no"
^DIC(9.4,4,22,1,"PAH",148,1,100,0)=" bulletin is sent."
^DIC(9.4,4,22,1,"PAH",148,1,101,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,102,0)=" When the option is scheduled:"
^DIC(9.4,4,22,1,"PAH",148,1,103,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,104,0)=" 1) The option runs at the scheduled time, as specified by the QUEUED TO"
^DIC(9.4,4,22,1,"PAH",148,1,105,0)=" RUN AT WHAT TIME field (2) of the OPTION SCHEDULING file (19.2)."
^DIC(9.4,4,22,1,"PAH",148,1,106,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,107,0)=" 2) If the RESCHEDULING FREQUENCY field (6) of file 19.2 is set, the option"
^DIC(9.4,4,22,1,"PAH",148,1,108,0)=" is scheduled to run repeatedly."
^DIC(9.4,4,22,1,"PAH",148,1,109,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,110,0)=" 3) It uses the DATE PURGE CUTOFF DAYS field, or the default of 730 days if"
^DIC(9.4,4,22,1,"PAH",148,1,111,0)=" it's empty, to calculate the cutoff date."
^DIC(9.4,4,22,1,"PAH",148,1,112,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,113,0)=" 4) It does not run in Test mode."
^DIC(9.4,4,22,1,"PAH",148,1,114,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,115,0)=" 5) If the DATE PURGE GRACE PERIOD field (10.04) of file 4.3 is empty, the"
^DIC(9.4,4,22,1,"PAH",148,1,116,0)=" purge runs at the time for which the option is scheduled."
^DIC(9.4,4,22,1,"PAH",148,1,117,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,118,0)=" 6) Otherwise, at the scheduled time the option only broadcasts the XM DATE"
^DIC(9.4,4,22,1,"PAH",148,1,119,0)=" PURGE WARNING bulletin to all users and queues a second task to perform"
^DIC(9.4,4,22,1,"PAH",148,1,120,0)=" the date purge GRACE PERIOD number of days later."
^DIC(9.4,4,22,1,"PAH",148,1,121,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,122,0)=" 7) If the DEVICE FOR QUEUED JOB OUTPUT field (3) of file 19.2 is empty,"
^DIC(9.4,4,22,1,"PAH",148,1,123,0)=" the purge runs without printing a report."
^DIC(9.4,4,22,1,"PAH",148,1,124,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,125,0)=" 8) Otherwise it prints the report on the selected device."
^DIC(9.4,4,22,1,"PAH",148,1,126,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,127,0)=" *Messages in SHARED,MAIL's mailbox and messages in the POSTMASTER's remote"
^DIC(9.4,4,22,1,"PAH",148,1,128,0)=" transmit queues and server baskets (including released patch messages on"
^DIC(9.4,4,22,1,"PAH",148,1,129,0)=" FORUM) are exempt from the purge.  "
^DIC(9.4,4,22,1,"PAH",148,1,130,0)="  ROUTINE: ENTER^XMA32                  SCHEDULING RECOMMENDED: YES"
^DIC(9.4,4,22,1,"PAH",148,1,131,0)="  UPPERCASE MENU TEXT: PURGE MESSAGES BY ORIGINATION "
^DIC(9.4,4,22,1,"PAH",148,1,132,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,133,0)="Here's the new warning bulletin:"
^DIC(9.4,4,22,1,"PAH",148,1,134,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,135,0)="OUTPUT FROM WHAT FILE: BULLETIN// "
^DIC(9.4,4,22,1,"PAH",148,1,136,0)="NAME: XM DATE PURGE WARNING             SUBJECT: Date Purge Scheduled for |1|"
^DIC(9.4,4,22,1,"PAH",148,1,137,0)="  PRIORITY?: YES"
^DIC(9.4,4,22,1,"PAH",148,1,138,0)=" MESSAGE:   Attention!  On |1|, all* messages (and their responses) sent on"
^DIC(9.4,4,22,1,"PAH",148,1,139,0)=" or before |2| will be  deleted from the system.  They will be gone forever."
^DIC(9.4,4,22,1,"PAH",148,1,140,0)="  "
^DIC(9.4,4,22,1,"PAH",148,1,141,0)=" You can find out if this will affect any messages in your mailbox and take"
^DIC(9.4,4,22,1,"PAH",148,1,142,0)=" appropriate measures.  "
^DIC(9.4,4,22,1,"PAH",148,1,143,0)="  "
^DIC(9.4,4,22,1,"PAH",148,1,144,0)=" From the main MailMan menu, respond to the prompts as follows: "
^DIC(9.4,4,22,1,"PAH",148,1,145,0)="  "
^DIC(9.4,4,22,1,"PAH",148,1,146,0)=" Select MailMan Menu Option: Query/Search for Messages "
^DIC(9.4,4,22,1,"PAH",148,1,147,0)="                             ="
^DIC(9.4,4,22,1,"PAH",148,1,148,0)=" Select message search method: M  Search my Mailbox by multiple criteria "
^DIC(9.4,4,22,1,"PAH",148,1,149,0)="                               ="
^DIC(9.4,4,22,1,"PAH",148,1,150,0)=" Select search action: Enter 'Subject contains' string// DB  Enter 'Message"
^DIC(9.4,4,22,1,"PAH",148,1,151,0)=" sent on or before' date                                 =="
^DIC(9.4,4,22,1,"PAH",148,1,152,0)=" Message sent on or before: |2| "
^DIC(9.4,4,22,1,"PAH",148,1,153,0)="                            |3|"
^DIC(9.4,4,22,1,"PAH",148,1,154,0)="  "
^DIC(9.4,4,22,1,"PAH",148,1,155,0)=" This search will find all of your messages which will be deleted.  "
^DIC(9.4,4,22,1,"PAH",148,1,156,0)="  "
^DIC(9.4,4,22,1,"PAH",148,1,157,0)=" * Messages in SHARED,MAIL's mailbox, and messages in the POSTMASTER's remote"
^DIC(9.4,4,22,1,"PAH",148,1,158,0)=" transmit queues and server baskets (includes released patches on FORUM) are"
^DIC(9.4,4,22,1,"PAH",148,1,159,0)=" exempt from the purge.  "
^DIC(9.4,4,22,1,"PAH",148,1,160,0)=" DESCRIPTION:   This is the warning bulletin that is broadcast to all users"
^DIC(9.4,4,22,1,"PAH",148,1,161,0)=" whenever option XMPURGE-BY-DATE is used to purge messages older than a"
^DIC(9.4,4,22,1,"PAH",148,1,162,0)=" certain  date.  See that option for more information."
^DIC(9.4,4,22,1,"PAH",148,1,163,0)="PARAMETER: 1"
^DIC(9.4,4,22,1,"PAH",148,1,164,0)=" DESCRIPTION:   The date that the date purge will run.  "
^DIC(9.4,4,22,1,"PAH",148,1,165,0)="PARAMETER: 2"
^DIC(9.4,4,22,1,"PAH",148,1,166,0)=" DESCRIPTION:   All messages this date and older will be purged.  "
^DIC(9.4,4,22,1,"PAH",148,1,167,0)="PARAMETER: 3"
^DIC(9.4,4,22,1,"PAH",148,1,168,0)=" DESCRIPTION:   A line of '=' as long as parameter 2"
^DIC(9.4,4,22,1,"PAH",148,1,169,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,170,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",148,1,171,0)="is at a minimum.  It requires MailMan patches XM*7.1*120 & XM*7.1*136."
^DIC(9.4,4,22,1,"PAH",148,1,172,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",148,1,173,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,174,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",148,1,175,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",148,1,176,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",148,1,177,0)=" "
^DIC(9.4,4,22,1,"PAH",148,1,178,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",148,1,179,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",148,1,180,0)="--------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",148,1,181,0)="XMA32          6537619         8333956        37,50,159"
^DIC(9.4,4,22,1,"PAH",148,1,182,0)="XMA32A         9915667         9150003        27,37,44,55,50,136,159"
^DIC(9.4,4,22,1,"PAH",148,1,183,0)="XMXBULL        5258679         5447862        50,107,120,159"
^DIC(9.4,4,22,1,"PAH",148,1,184,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",148,1,185,0)=""
^DIC(9.4,4,22,1,"PAH",148,1,186,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",148,1,187,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",148,1,188,0)=" "
^DIC(9.4,4,22,1,"PAH",148,1,189,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",148,1,190,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",148,1,191,0)="is at a minimum.  It requires MailMan patches XM*7.1*120 & XM*7.1*136."
^DIC(9.4,4,22,1,"PAH",148,1,192,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",148,1,193,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",148,1,194,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",148,1,195,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",148,1,196,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",148,1,197,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",148,1,198,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",148,1,199,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",148,1,200,0)="    Transport Global:"
