^DIC(9.4,35,22,3,1,1,0)="This build contains Order Entry/Results Reporting version 3.0.  It"
^DIC(9.4,35,22,3,1,2,0)="is exported as part of the release of CPRS."
^DIC(9.4,35,22,3,"PAH",0)="^9.4901^525^525"
^DIC(9.4,35,22,3,"PAH",1,0)="1^2990416^1"
^DIC(9.4,35,22,3,"PAH",1,1,0)="^^2^2^2990416"
^DIC(9.4,35,22,3,"PAH",1,1,1,0)="This patch corrects OPENERR errors which occur in DEL^%ZISH when no data"
^DIC(9.4,35,22,3,"PAH",1,1,2,0)="is returned for a CPRS report."
^DIC(9.4,35,22,3,"PAH",2,0)="5^2990416^1"
^DIC(9.4,35,22,3,"PAH",2,1,0)="^^2^2^2990416"
^DIC(9.4,35,22,3,"PAH",2,1,1,0)="This patch corrects a problem of getting a Null Subscript error when"
^DIC(9.4,35,22,3,"PAH",2,1,2,0)="printing orders that have no order text."
^DIC(9.4,35,22,3,"PAH",3,0)="2^2990416^1"
^DIC(9.4,35,22,3,"PAH",3,1,0)="^^1^1^2990416"
^DIC(9.4,35,22,3,"PAH",3,1,1,0)="This patch is described in the National Patch Module under OR*3*2."
