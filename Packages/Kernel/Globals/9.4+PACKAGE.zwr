^DIC(9.4,13,22,8,"PAH",65,1,0)="^^7^7^3010625"
^DIC(9.4,13,22,8,"PAH",65,1,1,0)="When a file or subfile is deleted, clean up ""PT"" nodes on pointed to "
^DIC(9.4,13,22,8,"PAH",65,1,2,0)="files, ""TRB"" node on fields triggered in other other files, and ""IX"" nodes"
^DIC(9.4,13,22,8,"PAH",65,1,3,0)="for whole file cross-references. Also clean up ""PT"" nodes when a variable"
^DIC(9.4,13,22,8,"PAH",65,1,4,0)="pointer field is created, and then made into a multiple."
^DIC(9.4,13,22,8,"PAH",65,1,5,0)=" "
^DIC(9.4,13,22,8,"PAH",65,1,6,0)="See patch DI*22*52 in the National Patch Module on FORUM for complete"
