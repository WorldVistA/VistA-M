^DIC(9.4,73,22,9,"PAH",14,1,4,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,5,0)="  Subject:"
^DIC(9.4,73,22,9,"PAH",14,1,6,0)="     Correcting wrong data on the report"
^DIC(9.4,73,22,9,"PAH",14,1,7,0)=" "
^DIC(9.4,73,22,9,"PAH",14,1,8,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,9,0)="  Category:"
^DIC(9.4,73,22,9,"PAH",14,1,10,0)="     Routine"
^DIC(9.4,73,22,9,"PAH",14,1,11,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,12,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,13,0)="  Description:"
^DIC(9.4,73,22,9,"PAH",14,1,14,0)="  ============"
^DIC(9.4,73,22,9,"PAH",14,1,15,0)="     NOIS: NAS-0700-32185, TAM-0600-30805"
^DIC(9.4,73,22,9,"PAH",14,1,16,0)="         It was reported that there were times that sites"
^DIC(9.4,73,22,9,"PAH",14,1,17,0)="     had received incorrect data for a patient; however,"
^DIC(9.4,73,22,9,"PAH",14,1,18,0)="     when the user tries to make another NHE request for the"
^DIC(9.4,73,22,9,"PAH",14,1,19,0)="     same patient, the user gets the correct result."
^DIC(9.4,73,22,9,"PAH",14,1,20,0)="     This problem is intermittent.  Routines were modified"
^DIC(9.4,73,22,9,"PAH",14,1,21,0)="     to ensure that data being transferred from the spooler"
^DIC(9.4,73,22,9,"PAH",14,1,22,0)="     would be unique for each patient."
^DIC(9.4,73,22,9,"PAH",14,1,23,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,24,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,25,0)="  "
