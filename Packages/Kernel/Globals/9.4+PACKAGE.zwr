^DIC(9.4,33,22,1.4,"PAH",35,1,214,0)=" HLERCHK          NEW            12063792       57"
^DIC(9.4,33,22,1.4,"PAH",35,1,215,0)=" HLFNC2           5393929         5397412       2,26,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,216,0)=" HLMA2            3410765         7268935       19,43,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,217,0)=" HLPAT57          NEW             1630585       57"
^DIC(9.4,33,22,1.4,"PAH",35,1,218,0)=" HLSUB            4535863         5277110       14,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,219,0)=" HLTP01           5245980         5262489       2,25,34,47,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,220,0)=" HLTP3           12440103        14050232       19,43,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,221,0)=" HLTP31           NEW             1680845       57"
^DIC(9.4,33,22,1.4,"PAH",35,1,222,0)=" HLTP4            7754632         7805100       19,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,223,0)=" HLTPCK1A         7334335        14402537       2,25,34,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,224,0)=" HLTPCK2A        11350701        15262342       19,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,225,0)=" HLUOPT          11331726        11707096       57"
^DIC(9.4,33,22,1.4,"PAH",35,1,226,0)=" HLUTIL            134301         2643574       36,19,57"
