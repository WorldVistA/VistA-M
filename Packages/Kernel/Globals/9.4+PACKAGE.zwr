^DIC(9.4,4,22,1,"PAH",131,1,3,0)="NOIS: WRJ-1100-10829"
^DIC(9.4,4,22,1,"PAH",131,1,4,0)="Test Site:  White River Junction, VT"
^DIC(9.4,4,22,1,"PAH",131,1,5,0)="Somehow, the bulletin XMDATANO got corrupted.  This patch restores that"
^DIC(9.4,4,22,1,"PAH",131,1,6,0)="bulletin to what it should be."
