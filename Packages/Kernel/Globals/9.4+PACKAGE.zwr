^DIC(9.4,85,22,1.5,"PAH",5,1,16,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",5,1,17,0)=" "
^DIC(9.4,85,22,1.5,"PAH",5,1,18,0)="             Before        After"
^DIC(9.4,85,22,1.5,"PAH",5,1,19,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,85,22,1.5,"PAH",5,1,20,0)="-----------------------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",5,1,21,0)="VAQFILE     3917792      3972067     22,26,28,32"
^DIC(9.4,85,22,1.5,"PAH",5,1,22,0)="VAQREQ06    4782978      4486600     4,20,26,32"
^DIC(9.4,85,22,1.5,"PAH",5,1,23,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,85,22,1.5,"PAH",5,1,24,0)=" "
^DIC(9.4,85,22,1.5,"PAH",5,1,25,0)="This patch introduces no new routines."
^DIC(9.4,85,22,1.5,"PAH",5,1,26,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",5,1,27,0)=" "
^DIC(9.4,85,22,1.5,"PAH",5,1,28,0)="INSTALLATION:"
^DIC(9.4,85,22,1.5,"PAH",5,1,29,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",5,1,30,0)="is at a minimum.  It requires patch VAQ*1.5*28."
^DIC(9.4,85,22,1.5,"PAH",5,1,31,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,85,22,1.5,"PAH",5,1,32,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,85,22,1.5,"PAH",5,1,33,0)="    affected routine(s).  "
^DIC(9.4,85,22,1.5,"PAH",5,1,34,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,85,22,1.5,"PAH",5,1,35,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,85,22,1.5,"PAH",5,1,36,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,85,22,1.5,"PAH",5,1,37,0)="    Users may be on the system."
^DIC(9.4,85,22,1.5,"PAH",5,1,38,0)="5.  On the KIDS:Installation menu, use the following options to install"
^DIC(9.4,85,22,1.5,"PAH",5,1,39,0)="    the Transport Global."
