^DIC(9.4,85,22,1.5,"PAH",5,1,1,0)="Patch VAQ*1.5*32"
^DIC(9.4,85,22,1.5,"PAH",5,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",5,1,3,0)="NOIS CLE-0701-40883"
^DIC(9.4,85,22,1.5,"PAH",5,1,4,0)="Test Site: Cleveland, OH"
^DIC(9.4,85,22,1.5,"PAH",5,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",5,1,6,0)="This patch stops PDX from locking file 394.61 when $$NEWTRAN^VAQFILE is"
^DIC(9.4,85,22,1.5,"PAH",5,1,7,0)="called to add a new record to the file.  ^DIC provides the appropriate"
^DIC(9.4,85,22,1.5,"PAH",5,1,8,0)="locking, so PDX doesn't have to."
^DIC(9.4,85,22,1.5,"PAH",5,1,9,0)=" "
^DIC(9.4,85,22,1.5,"PAH",5,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",5,1,11,0)="is at a minimum.  It requires patch VAQ*1.5*28."
^DIC(9.4,85,22,1.5,"PAH",5,1,12,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",5,1,13,0)=" "
