^DIC(9.4,100,22,15,"PAH",21,1,97,0)="   Routine Name       Before Patch        After Patch         Patch List"
^DIC(9.4,100,22,15,"PAH",21,1,98,0)="   ------------       ------------        -----------         ----------"
^DIC(9.4,100,22,15,"PAH",21,1,99,0)="   YS43POST               N/A                  237811         43"
^DIC(9.4,100,22,15,"PAH",21,1,100,0)="   YSDX3B                 11950549           11117228         33,43"
^DIC(9.4,100,22,15,"PAH",21,1,101,0)="   YSGAF                  13001186           13161211         33,37,40,42,43"
^DIC(9.4,100,22,15,"PAH",21,1,102,0)="   YSGAFHL7               N/A                 5831582         43"
^DIC(9.4,100,22,15,"PAH",21,1,103,0)="   YSGAFOBX               N/A                 3398570         43"
