^DIC(9.4,4,22,1,"PAH",47,1,5,0)="This patch fixes the $$CONVERT^XMXUTIL1 function.  If the date/time to be"
^DIC(9.4,4,22,1,"PAH",47,1,6,0)="converted did not include a time zone, the function reported an invalid"
^DIC(9.4,4,22,1,"PAH",47,1,7,0)="date/time.  Now, the time zone is assumed to be the current one."
^DIC(9.4,4,22,1,"PAH",47,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",47,1,9,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",47,1,10,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",47,1,11,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",47,1,12,0)=""
