^DIC(9.4,73,22,9,"PAH",10,1,37,0)="    ------------     -------------    ------------      ----------"
^DIC(9.4,73,22,9,"PAH",10,1,38,0)="    AFJXREW          8174307           8173723          15,17,18"
^DIC(9.4,73,22,9,"PAH",10,1,39,0)="    AFJXTRF          5380483           5221348          17,18"
