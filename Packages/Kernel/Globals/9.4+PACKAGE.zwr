^DIC(9.4,73,22,9,"PAH",15,1,84,0)="     6.  DSM/AXP Sites - Answer NO to the question ""Want to MOVE"
^DIC(9.4,73,22,9,"PAH",15,1,85,0)="          routines to other CPUs?"""
^DIC(9.4,73,22,9,"PAH",15,1,86,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,87,0)="     7.  DSM/AXP sites:  If the routines were unmapped, the mapped"
^DIC(9.4,73,22,9,"PAH",15,1,88,0)="         set should be rebuilt once the installation has run"
^DIC(9.4,73,22,9,"PAH",15,1,89,0)="         to completion."
^DIC(9.4,73,22,9,"PAH",15,1,90,0)=" "
