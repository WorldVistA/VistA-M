^DIC(9.4,73,22,9,"PAH",10,1,1,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,2,0)=" Subject:"
^DIC(9.4,73,22,9,"PAH",10,1,3,0)="    Correcting no display of Outpatient Pharmacy information"
^DIC(9.4,73,22,9,"PAH",10,1,4,0)="    on NHE request."
^DIC(9.4,73,22,9,"PAH",10,1,5,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,6,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,7,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,8,0)=" Category:"
^DIC(9.4,73,22,9,"PAH",10,1,9,0)="    Routine"
^DIC(9.4,73,22,9,"PAH",10,1,10,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,11,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,12,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",10,1,13,0)=" ============"
^DIC(9.4,73,22,9,"PAH",10,1,14,0)="    NOIS MAD-0300-41149:  Madison reported that they are not"
^DIC(9.4,73,22,9,"PAH",10,1,15,0)="    receiving any Outpatient Pharmacy information when they"
^DIC(9.4,73,22,9,"PAH",10,1,16,0)="    selected 'Brief (12 Months) Pharmacy' from the Network Health"
^DIC(9.4,73,22,9,"PAH",10,1,17,0)="    Exchange menu.  Routine AFJXREW and AFJXTRF were modified to"
^DIC(9.4,73,22,9,"PAH",10,1,18,0)="    correct this problem."
^DIC(9.4,73,22,9,"PAH",10,1,19,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,21,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,22,0)="  List of Test Sites:"
^DIC(9.4,73,22,9,"PAH",10,1,23,0)="  =================="
^DIC(9.4,73,22,9,"PAH",10,1,24,0)="     Madison, Hines, Salt-Lake, Tomah, N-Chicago"
^DIC(9.4,73,22,9,"PAH",10,1,25,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,26,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,27,0)=" "
