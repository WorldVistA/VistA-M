^DIC(9.4,60,22,13,"PAH",626,1,217,0)="Remove Copied (Custom) ASAP Definitions in Restore (Backout) Process"
^DIC(9.4,60,22,13,"PAH",626,1,218,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",626,1,219,0)="PSO77244"
^DIC(9.4,60,22,13,"PAH",626,1,220,0)=" "
^DIC(9.4,60,22,13,"PAH",626,1,221,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",626,1,222,0)="Change ""Version"" to ""Ver"" in PSO SPMP ASAP DEFINITIONS Screen Title"
^DIC(9.4,60,22,13,"PAH",626,1,223,0)="-------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",626,1,224,0)=" The Screen Title in the View/Edit ASAP Definitions [PSO SPMP ASAP "
^DIC(9.4,60,22,13,"PAH",626,1,225,0)=" DEFINITIONS] option has been changed to display the word ""Ver"" instead of"
^DIC(9.4,60,22,13,"PAH",626,1,226,0)=" ""Version"" to accomodate long ASAP definition names, and to avoid "
^DIC(9.4,60,22,13,"PAH",626,1,227,0)=" truncating the ASAP definition name or the asterisk indicating the "
^DIC(9.4,60,22,13,"PAH",626,1,228,0)=" definition is a custom copied version."
^DIC(9.4,60,22,13,"PAH",626,1,229,0)=" "
^DIC(9.4,60,22,13,"PAH",626,1,230,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",626,1,231,0)="Environment Check"
^DIC(9.4,60,22,13,"PAH",626,1,232,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",626,1,233,0)="An environment check runs during the loading of this patch (prior to "
^DIC(9.4,60,22,13,"PAH",626,1,234,0)="installation) to verify there are no custom versions of ASAP definitions "
^DIC(9.4,60,22,13,"PAH",626,1,235,0)="4.2A, 4.2B, or 5.0 in the STANDARD sub-file (#58.4001) of the SPMP ASAP"
^DIC(9.4,60,22,13,"PAH",626,1,236,0)="RECORD DEFINITION file (#58.4). If custom versions of any of these ASAP "
^DIC(9.4,60,22,13,"PAH",626,1,237,0)="definitions are found, the installation is halted and the installer is "
^DIC(9.4,60,22,13,"PAH",626,1,238,0)="instructed to have the definitions removed or renamed prior to installing "
^DIC(9.4,60,22,13,"PAH",626,1,239,0)="the patch."
^DIC(9.4,60,22,13,"PAH",627,0)="774 SEQ #656^3250903.08003^90"
^DIC(9.4,60,22,13,"PAH",627,1,0)="^^1^1^3250903"
^DIC(9.4,60,22,13,"PAH",627,1,1,0)="See FORUM for patch description details."
^DIC(9.4,60,22,13,"PAH",628,0)="737^3251119.084847^90"
^DIC(9.4,60,22,13,"PAH",628,1,0)="^^7^7^3251119"
^DIC(9.4,60,22,13,"PAH",628,1,1,0)="This patch, along with other patches, adds Pharmacogenomic (PGx) order"
^DIC(9.4,60,22,13,"PAH",628,1,2,0)="checking to medication orders entered through Inpatient Medications,"
^DIC(9.4,60,22,13,"PAH",628,1,3,0)="Outpatient Pharmacy and Computerized Patient Record System (CPRS). A "
^DIC(9.4,60,22,13,"PAH",628,1,4,0)="patient's genomic test results will be retrieved from the Health Data"
^DIC(9.4,60,22,13,"PAH",628,1,5,0)="Repository (HDR), and along with the prospective drug(s) of a medication"
^DIC(9.4,60,22,13,"PAH",628,1,6,0)="order is sent to the vendor to retrieve interactions between the patient's"
^DIC(9.4,60,22,13,"PAH",628,1,7,0)="genes and the prospective drug(s)."
^DIC(9.4,60,22,13,"PAH",629,0)="766^3250903.085325^90"
