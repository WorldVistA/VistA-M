^DIC(9.4,3,22,21,"PAH",281,0)="352 SEQ #291^3041015^1"
^DIC(9.4,3,22,21,"PAH",281,1,0)="^^2^2^3041015"
^DIC(9.4,3,22,21,"PAH",281,1,1,0)="Kernel Patch XU*8.0*352 'NEW PERSON FILE MODIFICATIONS'."
^DIC(9.4,3,22,21,"PAH",281,1,2,0)="Please refer to the Description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",282,0)="268^3041015^1"
^DIC(9.4,3,22,21,"PAH",282,1,0)="^^12^12^3041015"
^DIC(9.4,3,22,21,"PAH",282,1,1,0)="See patch XU*8.0*268 in the National Patch Module on FORUM for complete "
^DIC(9.4,3,22,21,"PAH",282,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",282,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",282,1,4,0)="This patch is being released by Capacity Planning (CP) for installation of"
^DIC(9.4,3,22,21,"PAH",282,1,5,0)="modifications to the %ZOSVK* collection routines that are used by the "
^DIC(9.4,3,22,21,"PAH",282,1,6,0)="Statistical Analysis of Global Growth (SAGG) Version 1.8 software package."
^DIC(9.4,3,22,21,"PAH",282,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",282,1,8,0)="NOTE: SAGG patch KMPS*1.8*3 must be installed AFTER installation of this"
^DIC(9.4,3,22,21,"PAH",282,1,9,0)="      patch."
^DIC(9.4,3,22,21,"PAH",282,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",282,1,11,0)="All DSM, Cache for Windows NT and Cache for OpenVMS sites are instructed "
^DIC(9.4,3,22,21,"PAH",282,1,12,0)="to install this patch."
^DIC(9.4,3,22,21,"PAH",283,0)="356 SEQ #294^3041015^1"
^DIC(9.4,3,22,21,"PAH",283,1,0)="^^2^2^3041015"
^DIC(9.4,3,22,21,"PAH",283,1,1,0)="See patch XU*8*356 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",283,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",284,0)="354^3041018^1"
^DIC(9.4,3,22,21,"PAH",284,1,0)="^^2^2^3041018"
^DIC(9.4,3,22,21,"PAH",284,1,1,0)="See patch XU*8*354 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",284,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",285,0)="346 SEQ #295^3041015^1"
^DIC(9.4,3,22,21,"PAH",286,0)="347 SEQ #296^3041029^1"
^DIC(9.4,3,22,21,"PAH",286,1,0)="^^2^2^3041029"
^DIC(9.4,3,22,21,"PAH",286,1,1,0)="See patch XU*8*347 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",286,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",287,0)="284 SEQ #298^3041111^1"
^DIC(9.4,3,22,21,"PAH",287,1,0)="^^157^157^3041111"
^DIC(9.4,3,22,21,"PAH",287,1,1,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,2,0)="Patch Tracking #: 37387952"
^DIC(9.4,3,22,21,"PAH",287,1,3,0)="Test Sites: FORUM, NORTHERN CALIFORNIA HCS, Boston Healthcare System "
^DIC(9.4,3,22,21,"PAH",287,1,4,0)="            CPRS v25 t12 test sites.  Blood Bank Clearance: 3/18/2004 "
^DIC(9.4,3,22,21,"PAH",287,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,6,0)="This patch adds two parameters to XUP with SYS or USR values that can be set to"
^DIC(9.4,3,22,21,"PAH",287,1,7,0)="control XUP. The first is ""XUS-XUP SET ERROR TRAP"".  If set this will set an"
^DIC(9.4,3,22,21,"PAH",287,1,8,0)="error trap to return to XUP and ask if the error should be recorded. The other"
^DIC(9.4,3,22,21,"PAH",287,1,9,0)="is ""XUS-XUP VPE"" for users that like to work in the VPE environment, setting"
^DIC(9.4,3,22,21,"PAH",287,1,10,0)="this parameter will cause XUP, if the Select OPTION NAME: is skipped, to branch"
^DIC(9.4,3,22,21,"PAH",287,1,11,0)="to the VPE environment.  "
^DIC(9.4,3,22,21,"PAH",287,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,13,0)="NOIS: ISL-0103-52332 This Patch adds a new API in a new routine for"
^DIC(9.4,3,22,21,"PAH",287,1,14,0)="applications to use to check and see if they are running in a PRODUCTION"
^DIC(9.4,3,22,21,"PAH",287,1,15,0)="account or a TEST account.  Integration #: 4440 "
^DIC(9.4,3,22,21,"PAH",287,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,17,0)="The new API is: "
^DIC(9.4,3,22,21,"PAH",287,1,18,0)=" $$PROD^XUPROD([force]) "
^DIC(9.4,3,22,21,"PAH",287,1,19,0)="  It returns 1 if the current account is a production account.  "
^DIC(9.4,3,22,21,"PAH",287,1,20,0)="  It returns 0 if it is a TEST account.  "
^DIC(9.4,3,22,21,"PAH",287,1,21,0)="  "
^DIC(9.4,3,22,21,"PAH",287,1,22,0)="  The parameter value of 1, allows an application to force a full test.  "
^DIC(9.4,3,22,21,"PAH",287,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,24,0)="These is a new Menu item under the ""Kernel Management Menu"", ""Ask if Production"
^DIC(9.4,3,22,21,"PAH",287,1,25,0)="Account"" (XU SID ASK) this option will ask if the current account is the"
^DIC(9.4,3,22,21,"PAH",287,1,26,0)="Production account.  If the answer is ""Yes"" then the current SID is set as the"
^DIC(9.4,3,22,21,"PAH",287,1,27,0)="production SID so checks will return 1.  If account is not the production"
^DIC(9.4,3,22,21,"PAH",287,1,28,0)="account then a fake value is stored so that the check will return 0.  The first"
^DIC(9.4,3,22,21,"PAH",287,1,29,0)="check each day will force a full test.  "
^DIC(9.4,3,22,21,"PAH",287,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,31,0)="The option ""Startup PROD check"" (XU SID STARTUP) should be added to the Taskman"
^DIC(9.4,3,22,21,"PAH",287,1,32,0)="scheduling file and scheduled for startup so that when Taskman start the SID is"
^DIC(9.4,3,22,21,"PAH",287,1,33,0)="also checked.  "
^DIC(9.4,3,22,21,"PAH",287,1,34,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,35,0)="Other required patches: For GT.M sites, XU*8*275 has the needed change "
^DIC(9.4,3,22,21,"PAH",287,1,36,0)="to ZOSVGTM.  "
^DIC(9.4,3,22,21,"PAH",287,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,38,0)="New fields in the KERNEL SYSTEM PARAMETERS file (8989.3).  "
^DIC(9.4,3,22,21,"PAH",287,1,39,0)="STANDARD DATA DICTIONARY #8989.3 -- KERNEL SYSTEM PARAMETERS FILE   "
^DIC(9.4,3,22,21,"PAH",287,1,40,0)="STORED IN ^XTV(8989.3, (1 ENTRY)   SITE: SF CIOFO, KERNEL PATCH ACCOUNT "
^DIC(9.4,3,22,21,"PAH",287,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,42,0)="DATA          NAME                  GLOBAL        DATA"
^DIC(9.4,3,22,21,"PAH",287,1,43,0)="ELEMENT       TITLE                 LOCATION      TYPE "
^DIC(9.4,3,22,21,"PAH",287,1,44,0)="-------------------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",287,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,46,0)="8989.3,501    PRODUCTION             SID;1 SET (Required) "
^DIC(9.4,3,22,21,"PAH",287,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,48,0)="              Production                "
^DIC(9.4,3,22,21,"PAH",287,1,49,0)="                                '0' FOR No; "
^DIC(9.4,3,22,21,"PAH",287,1,50,0)="                                '1' FOR Yes; "
^DIC(9.4,3,22,21,"PAH",287,1,51,0)="              LAST EDITED:      OCT 22, 2003 "
^DIC(9.4,3,22,21,"PAH",287,1,52,0)="              DESCRIPTION:      This field holds a flag to indicate if this is "
^DIC(9.4,3,22,21,"PAH",287,1,53,0)="                                a Production account.  It is a Yes/No flag with "
^DIC(9.4,3,22,21,"PAH",287,1,54,0)="                                internal values of 1 = Yes, 0 = No.  It is set "
^DIC(9.4,3,22,21,"PAH",287,1,55,0)="                                by the system after comparing the System ID "
^DIC(9.4,3,22,21,"PAH",287,1,56,0)="                                with the current System ID, at some point in "
^DIC(9.4,3,22,21,"PAH",287,1,57,0)="                                the future will be checked against a master "
^DIC(9.4,3,22,21,"PAH",287,1,58,0)="                                system.  "
^DIC(9.4,3,22,21,"PAH",287,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,60,0)="8989.3,502    System ID              SID;2 FREE TEXT "
^DIC(9.4,3,22,21,"PAH",287,1,61,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,62,0)="              INPUT TRANSFORM:  K:$L(X)>100!($L(X)<8) X "
^DIC(9.4,3,22,21,"PAH",287,1,63,0)="              LAST EDITED:      OCT 22, 2003 "
^DIC(9.4,3,22,21,"PAH",287,1,64,0)="              HELP-PROMPT:      Answer must be 8-100 characters in length "
^DIC(9.4,3,22,21,"PAH",287,1,65,0)="              DESCRIPTION:      This field holds the SYSTEM ID, if this is a "
^DIC(9.4,3,22,21,"PAH",287,1,66,0)="                                production system.  This value is compared "
^DIC(9.4,3,22,21,"PAH",287,1,67,0)="                                with the current system value and at some point "
^DIC(9.4,3,22,21,"PAH",287,1,68,0)="                                in the future will be checked against a master "
^DIC(9.4,3,22,21,"PAH",287,1,69,0)="                                system.  "
^DIC(9.4,3,22,21,"PAH",287,1,70,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,71,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,72,0)="8989.3,503    SID LAST CHECKED       SID;3 DATE "
^DIC(9.4,3,22,21,"PAH",287,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,74,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,75,0)="              INPUT TRANSFORM:  S %DT=""ETX"" D ^%DT S X=Y K:Y<1 X "
^DIC(9.4,3,22,21,"PAH",287,1,76,0)="              LAST EDITED:      JUN 30, 2003 "
^DIC(9.4,3,22,21,"PAH",287,1,77,0)="              DESCRIPTION:      This field holds the date/time that the SID was "
^DIC(9.4,3,22,21,"PAH",287,1,78,0)="                                last checked.  If the SID has not been "
^DIC(9.4,3,22,21,"PAH",287,1,79,0)="                                compared with the stored one today a full "
^DIC(9.4,3,22,21,"PAH",287,1,80,0)="                                check will be done, otherwise the PROD api will "
^DIC(9.4,3,22,21,"PAH",287,1,81,0)="                                just return the current value.  "
^DIC(9.4,3,22,21,"PAH",287,1,82,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,83,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,84,0)="Routine Summary The following routines are included in this patch.  The second"
^DIC(9.4,3,22,21,"PAH",287,1,85,0)="line of each of these routines now looks like: "
^DIC(9.4,3,22,21,"PAH",287,1,86,0)=" ;;8.0;KERNEL;**[Patch List]**;Jul 10, 1995 "
^DIC(9.4,3,22,21,"PAH",287,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,88,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",287,1,89,0)="Routine         Old       New      Patch List"
^DIC(9.4,3,22,21,"PAH",287,1,90,0)="XUP           4983304   5169232    **208,258,284**"
^DIC(9.4,3,22,21,"PAH",287,1,91,0)="XUPROD            n/a   1670496    **284**"
^DIC(9.4,3,22,21,"PAH",287,1,92,0)="ZOSVVXD       7675098   8031174    **13,65,71,94,107,118,136,215,284**"
^DIC(9.4,3,22,21,"PAH",287,1,93,0)="ZOSVONT       6784414   6775555    **34,94,107,118,136,215,293,284** "
^DIC(9.4,3,22,21,"PAH",287,1,94,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,95,0)="List of preceding patches: 215, 258, 293"
^DIC(9.4,3,22,21,"PAH",287,1,96,0)="Sites should use CHECK^XTSUMBLD to verify checksums.  "
^DIC(9.4,3,22,21,"PAH",287,1,97,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,98,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",287,1,99,0)="Installation: "
^DIC(9.4,3,22,21,"PAH",287,1,100,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,101,0)=">>>Allow KIDS to Inhibit logon's during the install.  "
^DIC(9.4,3,22,21,"PAH",287,1,102,0)=">>>TaskMan does *not* need to be stopped.  "
^DIC(9.4,3,22,21,"PAH",287,1,103,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,104,0)="  1.  DSM sites - If any of these routines are mapped, "
^DIC(9.4,3,22,21,"PAH",287,1,105,0)="      you will need to disable mapping for the affected routines.  "
^DIC(9.4,3,22,21,"PAH",287,1,106,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,107,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",287,1,108,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",287,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,110,0)="  3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",287,1,111,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,3,22,21,"PAH",287,1,112,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,3,22,21,"PAH",287,1,113,0)="      options: "
^DIC(9.4,3,22,21,"PAH",287,1,114,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,115,0)="         Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",287,1,116,0)="         Print Transport Global "
^DIC(9.4,3,22,21,"PAH",287,1,117,0)="         Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",287,1,118,0)="         Backup a Transport Global "
^DIC(9.4,3,22,21,"PAH",287,1,119,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,120,0)=" 4.   Allow KIDS to Inhibit logon's during the install. (There is a small"
^DIC(9.4,3,22,21,"PAH",287,1,121,0)="      chance that a few users could get CLOBER errors.) "
^DIC(9.4,3,22,21,"PAH",287,1,122,0)="      TaskMan does not need to be stopped.  "
^DIC(9.4,3,22,21,"PAH",287,1,123,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,124,0)="  5.  Installation will take less than 2 minutes.  "
^DIC(9.4,3,22,21,"PAH",287,1,125,0)="      In Programmer mode: "
^DIC(9.4,3,22,21,"PAH",287,1,126,0)="      Use ""D ^XPDKRN"" then "
^DIC(9.4,3,22,21,"PAH",287,1,127,0)="         Install Package(s)  'XU*8.0*284' "
^DIC(9.4,3,22,21,"PAH",287,1,128,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",287,1,129,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,130,0)="      Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES "
^DIC(9.4,3,22,21,"PAH",287,1,131,0)="        "
^DIC(9.4,3,22,21,"PAH",287,1,132,0)="      Want KIDS to INHIBIT LOGONs during the install? YES// YES "
^DIC(9.4,3,22,21,"PAH",287,1,133,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,134,0)="      Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO "
^DIC(9.4,3,22,21,"PAH",287,1,135,0)="      "
^DIC(9.4,3,22,21,"PAH",287,1,136,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",287,1,137,0)="      Cache/GTM Sites - you don't need to move anything, skip this step.  "
^DIC(9.4,3,22,21,"PAH",287,1,138,0)="      DSM sites - you need to move one routine from "
^DIC(9.4,3,22,21,"PAH",287,1,139,0)="      your production account to each manager account: ZOSVVXD "
^DIC(9.4,3,22,21,"PAH",287,1,140,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,141,0)="  9.  DSM in the manager account,  (Cache/GTM sites remain in VAH) "
^DIC(9.4,3,22,21,"PAH",287,1,142,0)="      All sites: "
^DIC(9.4,3,22,21,"PAH",287,1,143,0)="      DO RELOAD^ZTMGRSET "
^DIC(9.4,3,22,21,"PAH",287,1,144,0)="      Select the System "
^DIC(9.4,3,22,21,"PAH",287,1,145,0)="      Patch number to load: 284 "
^DIC(9.4,3,22,21,"PAH",287,1,146,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",287,1,147,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,148,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set.  "
^DIC(9.4,3,22,21,"PAH",287,1,149,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,150,0)=" 11.  In the VAH account: "
^DIC(9.4,3,22,21,"PAH",287,1,151,0)="      Please run the Memu option ""Ask if  Production Account"" (XU SID ASK).  "
^DIC(9.4,3,22,21,"PAH",287,1,152,0)="      This will ask if the current account is the Production account.  "
^DIC(9.4,3,22,21,"PAH",287,1,153,0)="      Please answer acordinly. "
^DIC(9.4,3,22,21,"PAH",287,1,154,0)=" "
^DIC(9.4,3,22,21,"PAH",287,1,155,0)="      The Option ""Startup PROD check"" (XU SID STARTUP) should be scheduled "
^DIC(9.4,3,22,21,"PAH",287,1,156,0)="      for startup so that when TaskMan starts the SID is checked.      "
^DIC(9.4,3,22,21,"PAH",287,1,157,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",288,0)="363 SEQ #299^3041111^1"
