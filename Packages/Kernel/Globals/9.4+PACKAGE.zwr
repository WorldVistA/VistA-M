^DIC(9.4,47,22,5.9,"PAH",801,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",802,0)="1017 SEQ #896^3201105.085616^17"
^DIC(9.4,47,22,5.9,"PAH",802,1,0)="^^4^4^3201105"
^DIC(9.4,47,22,5.9,"PAH",802,1,1,0)="Patch DG*5.3*1017 addresses an issue of an incorrect display of a PRF "
^DIC(9.4,47,22,5.9,"PAH",802,1,2,0)="Assignment status. This issue occurs when using the Record Flag Manual "
^DIC(9.4,47,22,5.9,"PAH",802,1,3,0)="Query [DGPF MANUAL QUERY] option because the current code does not "
^DIC(9.4,47,22,5.9,"PAH",802,1,4,0)="account for a status that was updated via REFRESH INACTIVE."
^DIC(9.4,47,22,5.9,"PAH",803,0)="1014^3201208.082756^17"
^DIC(9.4,47,22,5.9,"PAH",803,1,0)="^^2^2^3201208"
^DIC(9.4,47,22,5.9,"PAH",803,1,1,0)="Please see the DG*5.3*1014 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",803,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",804,0)="1020 SEQ #898^3201208.083045^17"
^DIC(9.4,47,22,5.9,"PAH",804,1,0)="^^9^9^3201208"
^DIC(9.4,47,22,5.9,"PAH",804,1,1,0)="This patch corrects issues identified during the warranty period for "
^DIC(9.4,47,22,5.9,"PAH",804,1,2,0)="Computerized Patient Record System (CPRS) v31b."
^DIC(9.4,47,22,5.9,"PAH",804,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",804,1,4,0)="It also modifies the SCHEDULED ADMISSION file (#41.1), enabling it to"
^DIC(9.4,47,22,5.9,"PAH",804,1,5,0)="notify other software packages when an entry is added, updated or removed."
^DIC(9.4,47,22,5.9,"PAH",804,1,6,0)="There are no end-user functionality changes in this patch."
^DIC(9.4,47,22,5.9,"PAH",804,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",804,1,8,0)="Please refer to the patch description for the list of issues and "
^DIC(9.4,47,22,5.9,"PAH",804,1,9,0)="additional details."
^DIC(9.4,47,22,5.9,"PAH",805,0)="1025^3201218.152446^17"
^DIC(9.4,47,22,5.9,"PAH",805,1,0)="^^8^8^3201218"
^DIC(9.4,47,22,5.9,"PAH",805,1,1,0)="DG*5.3*1025 (Registration) is bundled with IB*2.0*685 (Integrated "
^DIC(9.4,47,22,5.9,"PAH",805,1,2,0)="Billing) in host file."
^DIC(9.4,47,22,5.9,"PAH",805,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",805,1,4,0)="This patch introduces report to identify Former Service Members whose"
^DIC(9.4,47,22,5.9,"PAH",805,1,5,0)="Primary Eligibility changed from EXPANDED MH CARE NON-ENROLLEE to a new"
^DIC(9.4,47,22,5.9,"PAH",805,1,6,0)="Primary Eligibility with a verified eligibility status. These patients are"
^DIC(9.4,47,22,5.9,"PAH",805,1,7,0)="no longer treated under the Other Than Honorable (OTH) authority (VHA"
^DIC(9.4,47,22,5.9,"PAH",805,1,8,0)="Directive 1601A.02)."
^DIC(9.4,47,22,5.9,"PAH",806,0)="1041 SEQ #900^3201218.152659^17"
^DIC(9.4,47,22,5.9,"PAH",806,1,0)="^^2^2^3201218"
^DIC(9.4,47,22,5.9,"PAH",806,1,1,0)="Please see the DG*5.3*1041 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",806,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",807,0)="1037 SEQ #901^3201218.15271^17"
^DIC(9.4,47,22,5.9,"PAH",808,0)="1039 SEQ #902^3201231.14013^65"
^DIC(9.4,47,22,5.9,"PAH",808,1,0)="^^7^7^3201231"
^DIC(9.4,47,22,5.9,"PAH",808,1,1,0)="The Means Test thresholds for Calendar Year 2021 are distributed with this"
^DIC(9.4,47,22,5.9,"PAH",808,1,2,0)="patch. The post-installation routine, DG531039P, will create a new "
^DIC(9.4,47,22,5.9,"PAH",808,1,3,0)="subentry (or replace an existing one) for calendar year 2021 in the MEANS"
^DIC(9.4,47,22,5.9,"PAH",808,1,4,0)="TEST DATA (#250) multiple field of the MAS PARAMETERS (#43) file."
^DIC(9.4,47,22,5.9,"PAH",808,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",808,1,6,0)="Patch DG*5.3*1039 updates the thresholds for the Means Tests and the "
^DIC(9.4,47,22,5.9,"PAH",808,1,7,0)="Maximum Annual Pension Rate."
^DIC(9.4,47,22,5.9,"PAH",809,0)="1033 SEQ #903^3210121.16395^17"
^DIC(9.4,47,22,5.9,"PAH",809,1,0)="^^3^3^3210121"
^DIC(9.4,47,22,5.9,"PAH",809,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENT - SIGI UPDATES"
^DIC(9.4,47,22,5.9,"PAH",809,1,2,0)="Refer to patch DG*5.3*1033 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",809,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",810,0)="1023 SEQ #904^3210121.164218^17"
^DIC(9.4,47,22,5.9,"PAH",810,1,0)="^^3^3^3210121"
^DIC(9.4,47,22,5.9,"PAH",810,1,1,0)="Patch DG*5.3*1023 addresses an issue where the Collateral Patient's "
^DIC(9.4,47,22,5.9,"PAH",810,1,2,0)="address is not being copied from the sponsor and will not display in the "
^DIC(9.4,47,22,5.9,"PAH",810,1,3,0)="RF1 segment of the transmitted HL7 Z07 message."
^DIC(9.4,47,22,5.9,"PAH",811,0)="1036 SEQ #905^3210218.143939^17"
^DIC(9.4,47,22,5.9,"PAH",811,1,0)="^^9^9^3210218"
^DIC(9.4,47,22,5.9,"PAH",811,1,1,0)="When comparing the Date of Death with the current date during the "
^DIC(9.4,47,22,5.9,"PAH",811,1,2,0)="validation process from an incoming Z11 message, it gets rejected with an "
^DIC(9.4,47,22,5.9,"PAH",811,1,3,0)="error message ""Date of Death cannot be a future date"", even if the date "
^DIC(9.4,47,22,5.9,"PAH",811,1,4,0)="of death is at the same day with current date."
^DIC(9.4,47,22,5.9,"PAH",811,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",811,1,6,0)="The issue will occur when the Date of Death for inpatients contains date "
^DIC(9.4,47,22,5.9,"PAH",811,1,7,0)="and time, e.g., 3201028.0701. The code compares the Date of Death to the "
^DIC(9.4,47,22,5.9,"PAH",811,1,8,0)="current date format (variable DT), which does not include time, e.g., "
^DIC(9.4,47,22,5.9,"PAH",811,1,9,0)="3201028."
^DIC(9.4,47,22,5.9,"PAH",812,0)="1029^3210322.124637^17"
^DIC(9.4,47,22,5.9,"PAH",812,1,0)="^^4^4^3210322"
^DIC(9.4,47,22,5.9,"PAH",812,1,1,0)="The patch modifies DG routines to provide data for OR RPC to display on "
^DIC(9.4,47,22,5.9,"PAH",812,1,2,0)="CPRS screens and windows the following:"
^DIC(9.4,47,22,5.9,"PAH",812,1,3,0)="-Presumptive Psychosis button and related information,"
^DIC(9.4,47,22,5.9,"PAH",812,1,4,0)="-inactive Patient Record Flags indicator and related information."
^DIC(9.4,47,22,5.9,"PAH",813,0)="1048b^3210322"
^DIC(9.4,47,22,5.9,"PAH",813,1,0)="^^5^5^3210322"
