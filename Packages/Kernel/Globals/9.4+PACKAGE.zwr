^DIC(9.4,14,22,5.9,"PAH",278,1,56,0)="Blood Bank Review:"
^DIC(9.4,14,22,5.9,"PAH",278,1,57,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",278,1,58,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*469 does not "
^DIC(9.4,14,22,5.9,"PAH",278,1,59,0)="contain any changes to the VISTA BLOOD BANK Software as defined by ProPath"
^DIC(9.4,14,22,5.9,"PAH",278,1,60,0)="standard titled: BBM Team Review of VistA Patches."
^DIC(9.4,14,22,5.9,"PAH",278,1,61,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,62,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*469 does not "
^DIC(9.4,14,22,5.9,"PAH",278,1,63,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",278,1,64,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",278,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,66,0)="RISK ANALYSIS: Changes made by patch LR*5.2*469 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",278,1,67,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",278,1,68,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,69,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",278,1,70,0)="made, no specific validation requirements exist as a result of"
^DIC(9.4,14,22,5.9,"PAH",278,1,71,0)="installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",278,1,72,0)=" "
