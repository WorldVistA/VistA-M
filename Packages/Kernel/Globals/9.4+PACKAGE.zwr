^DIC(9.4,48,22,5.28,"PAH",362,1,0)="^^4^4^3070905"
^DIC(9.4,48,22,5.28,"PAH",362,1,1,0)="Inactivate menu option SD TRANS RX CANC APPT REPORT per HSD&D request.  "
^DIC(9.4,48,22,5.28,"PAH",362,1,2,0)="Also, fix errors occurring with several Scheduling options:  Clinic "
