^DIC(9.4,203,0)="ELECTRONIC SIGNATURE^XOBE^Foundations electronic signature code utilities."
^DIC(9.4,203,1,0)="^9.41A^3^3^3060711^^^^"
^DIC(9.4,203,1,1,0)="Contains the M-side portion of the electronic signature methods for "
^DIC(9.4,203,1,2,0)="rehosted applications that validate, store, and retrieve electronic "
^DIC(9.4,203,1,3,0)="signature data."
^DIC(9.4,203,22,0)="^9.49I^1^1"
^DIC(9.4,203,22,1,0)="1.0^3060714^3061211^1"
^DIC(9.4,203,22,1,1,0)="^^4^4^3061211"
^DIC(9.4,203,22,1,1,1,0)="This build contains the routine(s), RPC context option, and remote "
^DIC(9.4,203,22,1,1,2,0)="procedures used by the Electronic Signature (XOBE) package."
^DIC(9.4,203,22,1,1,3,0)=" "
^DIC(9.4,203,22,1,1,4,0)="[Build: 1.0.0.024]"
^DIC(9.4,203,22,"B","1.0",1)=""
^DIC(9.4,203,"VERSION")="1.0"
^DIC(9.4,204,0)="SHIFT CHANGE HANDOFF TOOL^CRHD^CAIRO PRODUCT CONVERSION TO CLASS I PRODUCT"
^DIC(9.4,204,5)="SLC"
^DIC(9.4,204,7)="^^I"
^DIC(9.4,204,20,0)="^9.402P^^"
^DIC(9.4,204,22,0)="^9.49I^1^1"
^DIC(9.4,204,22,1,0)="1.0^3080513^3080722^1"
^DIC(9.4,204,22,1,"PAH",0)="^9.4901^6^6"
^DIC(9.4,204,22,1,"PAH",1,0)="2 SEQ #1^3110208.093306^17"
^DIC(9.4,204,22,1,"PAH",1,1,0)="^^2^2^3110208"
^DIC(9.4,204,22,1,"PAH",1,1,1,0)="DO NOT RESUSCITATE (DNR) DISPLAY PROBLEMS AND HOT LIST DUPLICATE PATIENT "
^DIC(9.4,204,22,1,"PAH",1,1,2,0)="DISPLAY ISSUE"
^DIC(9.4,204,22,1,"PAH",2,0)="4 SEQ #2^3120306.091111^17"
^DIC(9.4,204,22,1,"PAH",2,1,0)="^^1^1^3120306"
^DIC(9.4,204,22,1,"PAH",2,1,1,0)="VARIOUS GUI MODIFICATIONS"
^DIC(9.4,204,22,1,"PAH",3,0)="7 SEQ #4^3180129.165615^54"
^DIC(9.4,204,22,1,"PAH",4,0)="8 SEQ #6^3190708.164817^65"
^DIC(9.4,204,22,1,"PAH",5,0)="10 SEQ #7^3220411.144344^86"
^DIC(9.4,204,22,1,"PAH",6,0)="11 SEQ #8^3240903.103246^89"
^DIC(9.4,204,22,1,"PAH",6,1,0)="^^50^50^3240903"
^DIC(9.4,204,22,1,"PAH",6,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,204,22,1,"PAH",6,1,2,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,3,0)="INCORRECT DRUG LINKED IN AUTOMATED DISPENSING SYSTEM FROM ONEVA"
^DIC(9.4,204,22,1,"PAH",6,1,4,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,5,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,6,0)="Defect"
^DIC(9.4,204,22,1,"PAH",6,1,7,0)="Tracking System Ticket(s) & Overview:"
^DIC(9.4,204,22,1,"PAH",6,1,8,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,9,0)="1. INC29032277 - Long Med List causes Endless Loop on Med Detail Display "
^DIC(9.4,204,22,1,"PAH",6,1,10,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,11,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,12,0)="Problem:"
^DIC(9.4,204,22,1,"PAH",6,1,13,0)="--------"
^DIC(9.4,204,22,1,"PAH",6,1,14,0)="When a patient has long list of active and recently expired meds creating "
^DIC(9.4,204,22,1,"PAH",6,1,15,0)="an array of 1000+ nodes (approximately 200 meds), and Shift Handoff Tool "
^DIC(9.4,204,22,1,"PAH",6,1,16,0)="is using the ""Med Detail"" data object, then the RPC Broker call CRHD PAT "
^DIC(9.4,204,22,1,"PAH",6,1,17,0)="ACTMEDS can get stuck in an endless loop."
^DIC(9.4,204,22,1,"PAH",6,1,18,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,19,0)="If a Shift Hand Off patient has 200+ meds and is causing an endless loop, "
^DIC(9.4,204,22,1,"PAH",6,1,20,0)="then sites can change the display to ""Med Summary"" as a temporary work "
^DIC(9.4,204,22,1,"PAH",6,1,21,0)="around.  Once the patient is discharged, they can switch back to the ""Med "
^DIC(9.4,204,22,1,"PAH",6,1,22,0)="Details"" display."
^DIC(9.4,204,22,1,"PAH",6,1,23,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,24,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,25,0)="Resolution:"
^DIC(9.4,204,22,1,"PAH",6,1,26,0)="-----------"
^DIC(9.4,204,22,1,"PAH",6,1,27,0)="Routine CRHDAM is modified to prevent the endless loop from occurring.  "
^DIC(9.4,204,22,1,"PAH",6,1,28,0)="The existing logic could end up resetting a counter node which caused the "
^DIC(9.4,204,22,1,"PAH",6,1,29,0)="loop to start over at the top of the meds list.  This is occurring "
^DIC(9.4,204,22,1,"PAH",6,1,30,0)="because the logic did not take into account the array of meds may contain "
^DIC(9.4,204,22,1,"PAH",6,1,31,0)="different number of lines for each Unit Dose, IV, and non-VA meds with in "
^DIC(9.4,204,22,1,"PAH",6,1,32,0)="the array and therefor didn't count correctly in some situations. "
^DIC(9.4,204,22,1,"PAH",6,1,33,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,34,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,35,0)="Technical Resolution:"
^DIC(9.4,204,22,1,"PAH",6,1,36,0)="---------------------"
^DIC(9.4,204,22,1,"PAH",6,1,37,0)="There was logic that was attempting to limit the number of meds that were "
^DIC(9.4,204,22,1,"PAH",6,1,38,0)="reviewed to 998 lines of the array. No reason for this can be determined "
^DIC(9.4,204,22,1,"PAH",6,1,39,0)="plus it didn't work and when it didn't it reset the node to -1 which "
^DIC(9.4,204,22,1,"PAH",6,1,40,0)="caused the loop to start over from the top of the array of meds."
^DIC(9.4,204,22,1,"PAH",6,1,41,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,42,0)="Line PSGI+7 is changed from "
^DIC(9.4,204,22,1,"PAH",6,1,43,0)="S CRHDNUM=0 F  S CRHDNUM=$O(CRHDLST(CRHDNUM)) Q:'CRHDNUM!('CRHDFG) D "
^DIC(9.4,204,22,1,"PAH",6,1,44,0)="To"
^DIC(9.4,204,22,1,"PAH",6,1,45,0)="S CRHDNUM=0 F  S CRHDNUM=$O(CRHDLST(CRHDNUM)) Q:'CRHDNUM  D"
^DIC(9.4,204,22,1,"PAH",6,1,46,0)=" "
^DIC(9.4,204,22,1,"PAH",6,1,47,0)="Line PSGI+16 is changed from "
^DIC(9.4,204,22,1,"PAH",6,1,48,0)="..I CRHDNUM2=CRHDLSTR S CRHDFG=0"
^DIC(9.4,204,22,1,"PAH",6,1,49,0)="To"
^DIC(9.4,204,22,1,"PAH",6,1,50,0)="..;I CRHDNUM2=CRHDLSTR S CRHDFG=0"
^DIC(9.4,204,22,1,"PAH","B","10 SEQ #7",5)=""
^DIC(9.4,204,22,1,"PAH","B","11 SEQ #8",6)=""
^DIC(9.4,204,22,1,"PAH","B","2 SEQ #1",1)=""
^DIC(9.4,204,22,1,"PAH","B","4 SEQ #2",2)=""
^DIC(9.4,204,22,1,"PAH","B","7 SEQ #4",3)=""
^DIC(9.4,204,22,1,"PAH","B","8 SEQ #6",4)=""
^DIC(9.4,204,22,"B","1.0",1)=""
^DIC(9.4,204,"VERSION")="1.0"
^DIC(9.4,205,0)="VISTA WEB^WEBV^VISTA WEB"
^DIC(9.4,205,20,0)="^9.402P^^"
