^DIC(9.4,48,22,5.28,"PAH",37,1,0)="^^1^1^2970218"
^DIC(9.4,48,22,5.28,"PAH",37,1,1,0)="Check-Out API Bullet-proofing.  For complete details, see NPM."
^DIC(9.4,48,22,5.28,"PAH",38,0)="87 SEQ #76^2970221^1"
^DIC(9.4,48,22,5.28,"PAH",38,1,0)="^^3^3^2970221"
^DIC(9.4,48,22,5.28,"PAH",38,1,1,0)="Fixes non-printing of Inpatient Provider in Inpatient MailMan messages."
^DIC(9.4,48,22,5.28,"PAH",38,1,2,0)="Fixes subjects for PCMM MailMan messages removes full name and full SSN"
