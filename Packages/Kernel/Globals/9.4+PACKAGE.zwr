^DIC(9.4,96,22,1.2,"PAH",49,1,1,0)="This is the yearly Lexicon release for 2017."
^DIC(9.4,96,22,1.2,"PAH",50,0)="71 SEQ #68^3180102.164425^54"
^DIC(9.4,96,22,1.2,"PAH",50,1,0)="^^13^13^3180102"
^DIC(9.4,96,22,1.2,"PAH",50,1,1,0)="The purpose of this patch is to update the DENTAL RECORD MANAGER CPT"
^DIC(9.4,96,22,1.2,"PAH",50,1,2,0)="CODE MAPPING (#228) file to comply with the changes introduced for "
^DIC(9.4,96,22,1.2,"PAH",50,1,3,0)="Fiscal Year (FY) 18, Quarter (Q) 1."
^DIC(9.4,96,22,1.2,"PAH",50,1,4,0)=" "
^DIC(9.4,96,22,1.2,"PAH",50,1,5,0)="The patch also updates Coding Standards as approved by the Office of"
^DIC(9.4,96,22,1.2,"PAH",50,1,6,0)="Dentistry."
^DIC(9.4,96,22,1.2,"PAH",50,1,7,0)=" "
^DIC(9.4,96,22,1.2,"PAH",50,1,8,0)="A Mailman message will be sent to DENTV ADA CODE MAPPING mail group to"
^DIC(9.4,96,22,1.2,"PAH",50,1,9,0)="identify new and modified ADA/CPT codes at the site. The patch contains"
^DIC(9.4,96,22,1.2,"PAH",50,1,10,0)="a post-installation routine to perform the updates and notification."
^DIC(9.4,96,22,1.2,"PAH",50,1,11,0)=" "
^DIC(9.4,96,22,1.2,"PAH",50,1,12,0)="This patch requires DENT*1.2*70 to be installed."
^DIC(9.4,96,22,1.2,"PAH",50,1,13,0)="This patch requires LEX*2.0*113 to be installed."
^DIC(9.4,96,22,1.2,"PAH",51,0)="69 SEQ #69^3180601.150616^54"
^DIC(9.4,96,22,1.2,"PAH",52,0)="73 SEQ #71^3190401.151316^54"
^DIC(9.4,96,22,1.2,"PAH",53,0)="75 SEQ #73^3200122.152842^65"
^DIC(9.4,96,22,1.2,"PAH",53,1,0)="^^1^1^3200122"
^DIC(9.4,96,22,1.2,"PAH",53,1,1,0)="This release is for the annual CPT code release for 2020."
^DIC(9.4,96,22,1.2,"PAH",54,0)="77 SEQ #74^3200623.18163^65"
^DIC(9.4,96,22,1.2,"PAH",54,1,0)="^^5^5^3200623"
^DIC(9.4,96,22,1.2,"PAH",54,1,1,0)="The purpose of this patch is to include functionality to return a dental "
^DIC(9.4,96,22,1.2,"PAH",54,1,2,0)="patient as ""inactive"" if the patient has a date of death set."
^DIC(9.4,96,22,1.2,"PAH",54,1,3,0)=" "
^DIC(9.4,96,22,1.2,"PAH",54,1,4,0)="Additionally, a message revision was made to the D9630 coding check as "
^DIC(9.4,96,22,1.2,"PAH",54,1,5,0)="well as a change to the RVU value of the 94760 Dental CPT code."
^DIC(9.4,96,22,1.2,"PAH",55,0)="79 SEQ #76^3201218.15283^17"
^DIC(9.4,96,22,1.2,"PAH",55,1,0)="^^1^1^3201218"
^DIC(9.4,96,22,1.2,"PAH",55,1,1,0)="This release is for the annual CPT code release for 2021."
^DIC(9.4,96,22,1.2,"PAH",56,0)="84 SEQ #78^3220321.185733^86"
^DIC(9.4,96,22,1.2,"PAH",56,1,0)="^^1^1^3220321"
^DIC(9.4,96,22,1.2,"PAH",56,1,1,0)="This release is for the annual CPT code release for 2022."
^DIC(9.4,96,22,1.2,"PAH",57,0)="87 SEQ #80^3221227.112827^90"
^DIC(9.4,96,22,1.2,"PAH",58,0)="86 SEQ #81^3230509.173809^89"
^DIC(9.4,96,22,1.2,"PAH",59,0)="89 SEQ #83^3231215.132135^89"
^DIC(9.4,96,22,1.2,"PAH",60,0)="92 SEQ #85^3250212.152205^89"
^DIC(9.4,96,22,1.2,"PAH",60,1,0)="^^1^1^3250212"
^DIC(9.4,96,22,1.2,"PAH",60,1,1,0)="This is the annual DRM Plus procedure code update patch for 2025."
^DIC(9.4,96,22,1.2,"PAH",61,0)="91 SEQ #86^3250403.081846^90"
^DIC(9.4,96,22,1.2,"PAH",61,1,0)="^^2^2^3250403"
^DIC(9.4,96,22,1.2,"PAH",61,1,1,0)="The purpose of this build is to add functionality to screen deceased "
^DIC(9.4,96,22,1.2,"PAH",61,1,2,0)="patients from various dental reports."
^DIC(9.4,96,22,1.2,"PAH",62,0)="93 SEQ #87^3260327.104041^90"
^DIC(9.4,96,22,1.2,"PAH",62,1,0)="^^10^10^3260327"
^DIC(9.4,96,22,1.2,"PAH",62,1,1,0)="The purpose of this patch is to update the DENTAL CPT CODE MAPPING  "
^DIC(9.4,96,22,1.2,"PAH",62,1,2,0)="(#228) file to comply with the changes introduced for Fiscal Year "
^DIC(9.4,96,22,1.2,"PAH",62,1,3,0)="(FY) 26, Quarter (Q) 1."
^DIC(9.4,96,22,1.2,"PAH",62,1,4,0)=" "
^DIC(9.4,96,22,1.2,"PAH",62,1,5,0)="The patch also updates Coding Standards as approved by the Office of"
^DIC(9.4,96,22,1.2,"PAH",62,1,6,0)="Dentistry."
^DIC(9.4,96,22,1.2,"PAH",62,1,7,0)=" "
^DIC(9.4,96,22,1.2,"PAH",62,1,8,0)="A Mailman message will be sent to DENTV ADA CODE MAPPING mail group to"
^DIC(9.4,96,22,1.2,"PAH",62,1,9,0)="identify new and modified ADA/CPT codes at the site. The patch contains"
^DIC(9.4,96,22,1.2,"PAH",62,1,10,0)="a post-installation routine to perform the updates and notification."
