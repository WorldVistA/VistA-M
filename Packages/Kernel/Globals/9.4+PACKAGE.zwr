^DIC(9.4,28,22,6,"PAH",3,1,69,0)="Bedford, MA - 518"
^DIC(9.4,28,22,6,"PAH",3,1,70,0)="Shreveport, LA - 667"
^DIC(9.4,28,22,6,"PAH",3,1,71,0)="Moutain Home, TN - 621"
^DIC(9.4,28,22,6,"PAH",3,1,72,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,73,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,74,0)="Routine Summary:"
