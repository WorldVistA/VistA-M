^DIC(9.4,4,22,1,"PAH",76,0)="104 SEQ #101^2991104^1"
^DIC(9.4,4,22,1,"PAH",76,1,0)="^^76^76^2991104"
^DIC(9.4,4,22,1,"PAH",76,1,1,0)="Patch XM*7.1*104"
^DIC(9.4,4,22,1,"PAH",76,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",76,1,3,0)="Y2K Waiver Exemption ID: WE0008"
^DIC(9.4,4,22,1,"PAH",76,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",76,1,5,0)="NOIS:  MAD-1099-41351"
^DIC(9.4,4,22,1,"PAH",76,1,6,0)="Test Site:  Madison, WI"
^DIC(9.4,4,22,1,"PAH",76,1,7,0)="Routines: ^XMXADDR, ^XMXADDR1, ^XMXADDRD"
^DIC(9.4,4,22,1,"PAH",76,1,8,0)="If a user enters an address, which is a device name or option name or remote"
^DIC(9.4,4,22,1,"PAH",76,1,9,0)="address which has exact, as well as partial matches in the DEVICE, OPTION, or"
^DIC(9.4,4,22,1,"PAH",76,1,10,0)="DOMAIN files, MailMan rightly asks the user to select one. "
^DIC(9.4,4,22,1,"PAH",76,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",76,1,12,0)="If a mail group contains a device name or option name or remote address"
^DIC(9.4,4,22,1,"PAH",76,1,13,0)="which has exact, as well as partial matches, MailMan should automatically"
^DIC(9.4,4,22,1,"PAH",76,1,14,0)="select the exact match.  However, it doesn't.  This patch makes MailMan"
^DIC(9.4,4,22,1,"PAH",76,1,15,0)="select the exact match."
^DIC(9.4,4,22,1,"PAH",76,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",76,1,17,0)="Also in this patch,"
^DIC(9.4,4,22,1,"PAH",76,1,18,0)="^XMDF     - Correct code which is never executed."
^DIC(9.4,4,22,1,"PAH",76,1,19,0)="^XMGAPI3  - Prepare for name change from DOMAIN.EXT to DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",76,1,20,0)="^XMJMD    - Correct how largest message number is obtained."
^DIC(9.4,4,22,1,"PAH",76,1,21,0)="^XMVGROUP - If a site has faxing enabled, allow mail group edit options"
^DIC(9.4,4,22,1,"PAH",76,1,22,0)="            to edit fax multiples in mail group file."
^DIC(9.4,4,22,1,"PAH",76,1,23,0)="^XMXADDR1 - Don't accept broadcast messages from remote sites."
^DIC(9.4,4,22,1,"PAH",76,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",76,1,25,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",76,1,26,0)="minimum.  It requires MailMan patch XM*7.1*101."
^DIC(9.4,4,22,1,"PAH",76,1,27,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",76,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",76,1,29,0)="ROUTINES:"
