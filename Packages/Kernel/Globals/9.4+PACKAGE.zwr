^DIC(9.4,49,22,10,"PAH",670,1,1,0)="*** Please Note: This patch has a shortened compliance date of 7 days. ***"
^DIC(9.4,49,22,10,"PAH",670,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",670,1,3,0)="Integrated Billing patch, IB*2.0*815, will update the administrative"
