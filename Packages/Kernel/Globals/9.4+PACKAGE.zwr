^DIC(9.4,85,22,1.5,"PAH",4,1,58,0)="     3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu."
^DIC(9.4,85,22,1.5,"PAH",4,1,59,0)="        This loads the patch into a Transport Global onto your system."
^DIC(9.4,85,22,1.5,"PAH",4,1,60,0)="    "
^DIC(9.4,85,22,1.5,"PAH",4,1,61,0)="     4. You DO NOT need to stop TaskMan or the background filers."
