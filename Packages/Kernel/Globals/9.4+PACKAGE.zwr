^DIC(9.4,14,22,5.9,"PAH",273,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",273,1,2,0)="package by the Vista Maintenance team that addresses"
^DIC(9.4,14,22,5.9,"PAH",273,1,3,0)="issues with Howdy:"
^DIC(9.4,14,22,5.9,"PAH",273,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",273,1,5,0)="1.      INC000001085378   -  Draw time: 0"
^DIC(9.4,14,22,5.9,"PAH",273,1,6,0)="2.      INC000001056020   -  Processed tests showing as ""active"""
^DIC(9.4,14,22,5.9,"PAH",273,1,7,0)="3.      I7997705FY16      -  Tests accessioned from excluded locations"
^DIC(9.4,14,22,5.9,"PAH",274,0)="451^3161006.130034^54"
