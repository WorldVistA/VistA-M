^DIC(9.4,8,22,12,0)="15.0^2980105^2980302^1"
^DIC(9.4,8,22,12,"PAH",0)="^9.4901^1^1"
^DIC(9.4,8,22,12,"PAH",1,0)="1^2981026^1"
^DIC(9.4,8,22,12,"PAH",1,1,0)="^^4^4^2981026"
^DIC(9.4,8,22,12,"PAH",1,1,1,0)="This patch contains the FY99 updates to the ICD9 and ICD0 files,"
^DIC(9.4,8,22,12,"PAH",1,1,2,0)="as well as the new DRGs 504-511."
^DIC(9.4,8,22,12,"PAH",1,1,3,0)=" "
^DIC(9.4,8,22,12,"PAH",1,1,4,0)="See National Patch Module for details."
^DIC(9.4,8,22,12,"PAH","B",1,1)=""
^DIC(9.4,8,22,13,0)="16.0^2981215^2990201^1"
^DIC(9.4,8,22,13,1,0)="^^1^1^2990201"
^DIC(9.4,8,22,13,1,1,0)="This build contains the DRG Grouper V16.0 release."
^DIC(9.4,8,22,13,"PAH",0)="^9.4901^1^1"
^DIC(9.4,8,22,13,"PAH",1,0)="1 SEQ #1^3000125^1"
^DIC(9.4,8,22,13,"PAH",1,1,0)="^^1^1^3000125"
^DIC(9.4,8,22,13,"PAH",1,1,1,0)="DRG Grouper Version 17 Released as Patch"
^DIC(9.4,8,22,13,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,8,22,14,0)="18.0^3051119^3001106^1"
^DIC(9.4,8,22,14,1,0)="^^1^1^3051119"
^DIC(9.4,8,22,14,1,1,0)="This build contains the ICD V18.0 release."
^DIC(9.4,8,22,14,"PAH",0)="^9.4901^103^103"
^DIC(9.4,8,22,14,"PAH",1,0)="1 SEQ #1^3010122^1"
^DIC(9.4,8,22,14,"PAH",1,1,0)="^^5^5^3010122"
^DIC(9.4,8,22,14,"PAH",1,1,1,0)="This patch contains the DRG Reclassification changes published in"
^DIC(9.4,8,22,14,"PAH",1,1,2,0)="the Federal Register, Vol. 65, No. 148, dated August 1, 2000,"
^DIC(9.4,8,22,14,"PAH",1,1,3,0)="with an effective date of October 1,2000.  See pp. 47057."
^DIC(9.4,8,22,14,"PAH",1,1,4,0)="It also contains changes made in response to NOISes or other "
^DIC(9.4,8,22,14,"PAH",1,1,5,0)="reported problems in connection with the DRG Grouper."
^DIC(9.4,8,22,14,"PAH",2,0)="2 SEQ #2^3011106^1"
^DIC(9.4,8,22,14,"PAH",3,0)="3 SEQ #3^3011231^1"
^DIC(9.4,8,22,14,"PAH",4,0)="4 SEQ #4^3021108^1"
^DIC(9.4,8,22,14,"PAH",4,1,0)="^^4^4^3021108"
^DIC(9.4,8,22,14,"PAH",4,1,1,0)="This patch provides the annual update to the ICD9 codes, creates two additinal"
^DIC(9.4,8,22,14,"PAH",4,1,2,0)="fields SEX and AGE in the ICD DIAGNOSIS file and updates that file with the"
^DIC(9.4,8,22,14,"PAH",4,1,3,0)="indicated values if applicable."
^DIC(9.4,8,22,14,"PAH",4,1,4,0)=""
^DIC(9.4,8,22,14,"PAH",5,0)="5 SEQ #5^3030109^1"
^DIC(9.4,8,22,14,"PAH",5,1,0)="^^19^19^3030109"
^DIC(9.4,8,22,14,"PAH",5,1,1,0)="   The patch provides the annual update to the DRG Grouper v20.0."
^DIC(9.4,8,22,14,"PAH",5,1,2,0)=" "
^DIC(9.4,8,22,14,"PAH",5,1,3,0)="   There will be no new version package release.  All necessary changes "
^DIC(9.4,8,22,14,"PAH",5,1,4,0)="are covered by this patch."
^DIC(9.4,8,22,14,"PAH",5,1,5,0)=" "
^DIC(9.4,8,22,14,"PAH",5,1,6,0)="   No code files are included in the patch, as all changes are handled "
^DIC(9.4,8,22,14,"PAH",5,1,7,0)="programmatically through the pre-init routine."
^DIC(9.4,8,22,14,"PAH",5,1,8,0)=" "
^DIC(9.4,8,22,14,"PAH",5,1,9,0)="   The changes were published in the Federal Register, Vol.67, No.148, "
^DIC(9.4,8,22,14,"PAH",5,1,10,0)="dated August 1, 2002, with the effective date of October 1, 2002.  DRG "
^DIC(9.4,8,22,14,"PAH",5,1,11,0)="Reclassification changes are in pp.49985-50008."
^DIC(9.4,8,22,14,"PAH",5,1,12,0)=" "
^DIC(9.4,8,22,14,"PAH",5,1,13,0)="   Changes include:"
^DIC(9.4,8,22,14,"PAH",5,1,14,0)=" "
^DIC(9.4,8,22,14,"PAH",5,1,15,0)="I.    New/revised DRG codes (file #80.2)."
^DIC(9.4,8,22,14,"PAH",5,1,16,0)="II.   DRG Reclassification changes to the Grouper."
^DIC(9.4,8,22,14,"PAH",5,1,17,0)="III.  Miscellaneous modifications to the Grouper, discovered in the"
^DIC(9.4,8,22,14,"PAH",5,1,18,0)="      course of internal testing."
^DIC(9.4,8,22,14,"PAH",5,1,19,0)="IV.   New DRG Weights & Trims."
^DIC(9.4,8,22,14,"PAH",6,0)="6^3030924^1"
^DIC(9.4,8,22,14,"PAH",6,1,0)="^^2^2^3030924"
^DIC(9.4,8,22,14,"PAH",6,1,1,0)="Please see the National Patch Module for details of the enhancements "
^DIC(9.4,8,22,14,"PAH",6,1,2,0)="included in this patch."
^DIC(9.4,8,22,14,"PAH",7,0)="7^3030924^1"
^DIC(9.4,8,22,14,"PAH",7,1,0)="^^2^2^3030924"
^DIC(9.4,8,22,14,"PAH",7,1,1,0)="Please see the National Patch Module for details"
^DIC(9.4,8,22,14,"PAH",7,1,2,0)="       of the enhancements included in this patch."
^DIC(9.4,8,22,14,"PAH",8,0)="10 SEQ #10^3031231^1"
^DIC(9.4,8,22,14,"PAH",8,1,0)="^^3^3^3031231"
^DIC(9.4,8,22,14,"PAH",8,1,1,0)="DRG RECLASSIFICATION FOR FY 04"
^DIC(9.4,8,22,14,"PAH",8,1,2,0)=" "
^DIC(9.4,8,22,14,"PAH",8,1,3,0)="WEIGHTS AND TRIMS FOR FY 04"
^DIC(9.4,8,22,14,"PAH",9,0)="11 SEQ #11^3040131^1"
^DIC(9.4,8,22,14,"PAH",9,1,0)="^^2^2^3040131"
^DIC(9.4,8,22,14,"PAH",9,1,1,0)="Please see the National Patch Module for details"
^DIC(9.4,8,22,14,"PAH",9,1,2,0)="of the enhancements included in this patch."
^DIC(9.4,8,22,14,"PAH",10,0)="12^3041015^1"
^DIC(9.4,8,22,14,"PAH",10,1,0)="^9.49011^2^2^3041015"
^DIC(9.4,8,22,14,"PAH",10,1,1,0)="Please see the National Patch Module for details of the enhancements "
^DIC(9.4,8,22,14,"PAH",10,1,2,0)="included in this patch."
^DIC(9.4,8,22,14,"PAH",11,0)="14^3050212^1"
^DIC(9.4,8,22,14,"PAH",11,1,0)="^^11^11^3050212"
^DIC(9.4,8,22,14,"PAH",11,1,1,0)="The Health Insurance Portability and Accessibility Act (HIPAA) stipulates "
^DIC(9.4,8,22,14,"PAH",11,1,2,0)="that diagnostic and procedure codes used for billing purposes must be the "
^DIC(9.4,8,22,14,"PAH",11,1,3,0)="codes that were applicable at the time the service was provided.  Code "
^DIC(9.4,8,22,14,"PAH",11,1,4,0)="sets required by the HIPAA legislation to be date-sensitive and included "
^DIC(9.4,8,22,14,"PAH",11,1,5,0)="in this request are:"
^DIC(9.4,8,22,14,"PAH",11,1,6,0)=" "
^DIC(9.4,8,22,14,"PAH",11,1,7,0)="o ICD-9-CM (International Classification of Diseases-9-Clinical "
^DIC(9.4,8,22,14,"PAH",11,1,8,0)="Modifications)"
^DIC(9.4,8,22,14,"PAH",11,1,9,0)=" "
^DIC(9.4,8,22,14,"PAH",11,1,10,0)="o DRG Codes (Diagnostic Related Group which is part of the ICD-9"
^DIC(9.4,8,22,14,"PAH",11,1,11,0)="code set)"
^DIC(9.4,8,22,14,"PAH",12,0)="16 SEQ #15^3050426^1"
^DIC(9.4,8,22,14,"PAH",12,1,0)="^^2^2^3050426"
^DIC(9.4,8,22,14,"PAH",12,1,1,0)="Fixes a system error which occurs when entering certain ICD9 codes "
^DIC(9.4,8,22,14,"PAH",12,1,2,0)="in the 701 screen of the PTF LOAD/EDIT option."
^DIC(9.4,8,22,14,"PAH",13,0)="15^3050611^1"
^DIC(9.4,8,22,14,"PAH",13,1,0)="^^2^2^3050611"
^DIC(9.4,8,22,14,"PAH",13,1,1,0)="Please see the National Patch Module for details of the enhancements "
^DIC(9.4,8,22,14,"PAH",13,1,2,0)="included in this patch."
^DIC(9.4,8,22,14,"PAH",14,0)="17 SEQ #17^3050813^1"
^DIC(9.4,8,22,14,"PAH",14,1,0)="^^16^16^3050813"
^DIC(9.4,8,22,14,"PAH",14,1,1,0)="  This patch 1) adds data to the Identifier field (#2) of three "
^DIC(9.4,8,22,14,"PAH",14,1,2,0)="ICD OPERATION/PROCEDURE file (#80.1) records, 2) adds a DRG "
^DIC(9.4,8,22,14,"PAH",14,1,3,0)="calculation for bone marrow transplants, 3) corrects the"
^DIC(9.4,8,22,14,"PAH",14,1,4,0)="DRG code associated with diagnosis 309.81 to be DRG 427,"
^DIC(9.4,8,22,14,"PAH",14,1,5,0)="4) corrects the DRG codes associated with procedure code 51.23,"
^DIC(9.4,8,22,14,"PAH",14,1,6,0)="5) removes the entry under DRG Grouper Effective Date for"
^DIC(9.4,8,22,14,"PAH",14,1,7,0)="October 1,2004 for operation code 80.51, 6) removes the ""F"""
^DIC(9.4,8,22,14,"PAH",14,1,8,0)="from the Identifier field (#2) of ICD OPERATION/PROCEDURE"
^DIC(9.4,8,22,14,"PAH",14,1,9,0)="FILE (#80.1) for code 81.61, 7) associates the correct DRG "
^DIC(9.4,8,22,14,"PAH",14,1,10,0)="when using operation/procedure code 96.72, 8) associates the"
^DIC(9.4,8,22,14,"PAH",14,1,11,0)="correct DRG when using diagnosis 402.91 or 428.32 with card "
^DIC(9.4,8,22,14,"PAH",14,1,12,0)="cath procedures, 9) associates the correct DRG when using "
^DIC(9.4,8,22,14,"PAH",14,1,13,0)="operation/procedure 01.59, and reviews DRG 1,2,3,528 and 543"
^DIC(9.4,8,22,14,"PAH",14,1,14,0)="for proper assignment, 10) corrects the MDC field (#5)"
^DIC(9.4,8,22,14,"PAH",14,1,15,0)="for diagnosis 250.70, 11) Adds missing data to diagnosis 428.0 "
^DIC(9.4,8,22,14,"PAH",14,1,16,0)="(Congestive Heart Failure Unspecified)"
^DIC(9.4,8,22,14,"PAH",15,0)="20 SEQ #19^3051221^1"
^DIC(9.4,8,22,14,"PAH",15,1,0)="^^2^2^3051221"
^DIC(9.4,8,22,14,"PAH",15,1,1,0)="Provides the annual update of the DRG Grouper for FY 2006 and"
^DIC(9.4,8,22,14,"PAH",15,1,2,0)="resolves Remedy tickets.  "
^DIC(9.4,8,22,14,"PAH",16,0)="22 SEQ #21^3060923^1"
^DIC(9.4,8,22,14,"PAH",16,1,0)="^^2^2^3060923"
^DIC(9.4,8,22,14,"PAH",16,1,1,0)="This patch fixes several problems all related to the wrong DRG being "
^DIC(9.4,8,22,14,"PAH",16,1,2,0)="calculated by the VistA DRG Grouper."
^DIC(9.4,8,22,14,"PAH",17,0)="24 SEQ #24^3061211.161248^1"
^DIC(9.4,8,22,14,"PAH",17,1,0)="^^1^1^3061211"
^DIC(9.4,8,22,14,"PAH",17,1,1,0)="Provides the annual update of the DRG Grouper for FY 2007."
^DIC(9.4,8,22,14,"PAH",18,0)="26 SEQ #25^3070627.23165^1"
^DIC(9.4,8,22,14,"PAH",18,1,0)="^^2^2^3070627"
^DIC(9.4,8,22,14,"PAH",18,1,1,0)="This patch fixes procedure code 96.04 so its use will not generate "
^DIC(9.4,8,22,14,"PAH",18,1,2,0)="DRG 470 (ungroupable).  "
^DIC(9.4,8,22,14,"PAH",19,0)="28^3070905.000425^1"
^DIC(9.4,8,22,14,"PAH",19,1,0)="^^2^2^3070905"
^DIC(9.4,8,22,14,"PAH",19,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,8,22,14,"PAH",19,1,2,0)="included in this patch."
^DIC(9.4,8,22,14,"PAH",20,0)="27 SEQ #27^3070905.013828^1"
^DIC(9.4,8,22,14,"PAH",20,1,0)="^^2^2^3070905"
^DIC(9.4,8,22,14,"PAH",20,1,1,0)="This patch corrects the VistA DRG Grouper to conform to the "
^DIC(9.4,8,22,14,"PAH",20,1,2,0)="Quadramed encoder for cases explained in the Remedy tickets."
^DIC(9.4,8,22,14,"PAH",21,0)="30 SEQ #28^3071212.221107^1"
^DIC(9.4,8,22,14,"PAH",21,1,0)="^^1^1^3071212"
^DIC(9.4,8,22,14,"PAH",21,1,1,0)="Patch fixes DRG calculations."
^DIC(9.4,8,22,14,"PAH",22,0)="29^3071212.224824^1"
^DIC(9.4,8,22,14,"PAH",22,1,0)="^^12^12^3071212"
^DIC(9.4,8,22,14,"PAH",22,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,8,22,14,"PAH",22,1,2,0)="included in this patch.  This patch is part of a multi-package "
^DIC(9.4,8,22,14,"PAH",22,1,3,0)="distribution and includes the following patches installed in"
^DIC(9.4,8,22,14,"PAH",22,1,4,0)="the following order:"
^DIC(9.4,8,22,14,"PAH",22,1,5,0)=" "
^DIC(9.4,8,22,14,"PAH",22,1,6,0)=" LEX*2.0*52   Fixes for Lexicon, ICD and CPT problems"
^DIC(9.4,8,22,14,"PAH",22,1,7,0)=" ICPT*6.0*37  Routine ICPTMOD and ICPTMOD2"
^DIC(9.4,8,22,14,"PAH",22,1,8,0)=" ICD*18.0*29  Routine ICPTCODE and #80 Data Dictionary changes to file #80"
^DIC(9.4,8,22,14,"PAH",22,1,9,0)=" LEX*2.0*53   FY08 1st quarter ICD/CPT update"
^DIC(9.4,8,22,14,"PAH",22,1,10,0)=" ICPT*6.0*38  Informational patch installed with LEX*2.0*53"
^DIC(9.4,8,22,14,"PAH",22,1,11,0)=" "
^DIC(9.4,8,22,14,"PAH",22,1,12,0)="Please see patch LEX*2.0*52 for install instructions"
^DIC(9.4,8,22,14,"PAH",23,0)="31 SEQ #30^3080203.21531^1"
^DIC(9.4,8,22,14,"PAH",24,0)="32 SEQ #31^3080526.150446^1"
^DIC(9.4,8,22,14,"PAH",25,0)="33 SEQ #32^3090420.161007^1"
^DIC(9.4,8,22,14,"PAH",25,1,0)="^^1^1^3090420"
^DIC(9.4,8,22,14,"PAH",25,1,1,0)="DRG CORRECTIONS"
^DIC(9.4,8,22,14,"PAH",26,0)="36 SEQ #34^3090422.113314^17"
^DIC(9.4,8,22,14,"PAH",26,1,0)="^^3^3^3090422"
^DIC(9.4,8,22,14,"PAH",26,1,1,0)="This patch contains changes to correctly calculate bilateral knee and hip "
^DIC(9.4,8,22,14,"PAH",26,1,2,0)="procedures. Also corrects descriptions on DRG GROUPER [ICD DRG GROUPER] "
^DIC(9.4,8,22,14,"PAH",26,1,3,0)="option."
