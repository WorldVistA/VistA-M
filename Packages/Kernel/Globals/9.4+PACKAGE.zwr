^DIC(9.4,11,22,5.03,"PAH",21,1,305,0)=" #13785 - LRPHMAN & LRPHEXCPT BOTH SENDING HL7 MESSAGE"
^DIC(9.4,11,22,5.03,"PAH",21,1,306,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,307,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,308,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",21,1,309,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",21,1,310,0)=" Asheville VAMC"
^DIC(9.4,11,22,5.03,"PAH",21,1,311,0)=" Boston HCS"
^DIC(9.4,11,22,5.03,"PAH",21,1,312,0)=" Central Plains HCS"
^DIC(9.4,11,22,5.03,"PAH",21,1,313,0)=" Indianapolis VAMC"
^DIC(9.4,11,22,5.03,"PAH",21,1,314,0)=" Milwaukee VAMC "
^DIC(9.4,11,22,5.03,"PAH",21,1,315,0)=" South Texas HCS "
^DIC(9.4,11,22,5.03,"PAH",21,1,316,0)=" Tennessee Valley HCS"
^DIC(9.4,11,22,5.03,"PAH",21,1,317,0)=" Upstate New York HCS (VISN 2)"
