^DIC(9.4,13,22,7,"PAH",15,1,39,0)="Installation Instructions:"
^DIC(9.4,13,22,7,"PAH",15,1,40,0)="=========================="
^DIC(9.4,13,22,7,"PAH",15,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,42,0)="NOTE the instructions that are different for DSM sites."
^DIC(9.4,13,22,7,"PAH",15,1,43,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,44,0)="     1.   Users ARE NOT allowed to be on the system during the "
^DIC(9.4,13,22,7,"PAH",15,1,45,0)="     installation."
^DIC(9.4,13,22,7,"PAH",15,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,47,0)="     2.   DO place TaskMan in a WAIT state."
^DIC(9.4,13,22,7,"PAH",15,1,48,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,49,0)="     3.   DSM Sites: These routines are not usually mapped so you will"
^DIC(9.4,13,22,7,"PAH",15,1,50,0)="     probably not have to disable mapping."
^DIC(9.4,13,22,7,"PAH",15,1,51,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,52,0)="     4.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,13,22,7,"PAH",15,1,53,0)="     This option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",15,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,55,0)="     5.   The patch has now been loaded into a Transport global on your "
^DIC(9.4,13,22,7,"PAH",15,1,56,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,13,22,7,"PAH",15,1,57,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,58,0)="     6.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",15,1,59,0)="     following options: "
^DIC(9.4,13,22,7,"PAH",15,1,60,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,61,0)="           Verify Checksums in Transport Global"
^DIC(9.4,13,22,7,"PAH",15,1,62,0)="           Print Transport Global "
^DIC(9.4,13,22,7,"PAH",15,1,63,0)="           Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",15,1,64,0)="           Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",15,1,65,0)="           Install Package(s) "
^DIC(9.4,13,22,7,"PAH",15,1,66,0)="           INSTALL NAME: DI*21.0*28"
^DIC(9.4,13,22,7,"PAH",15,1,67,0)="                         =========="
^DIC(9.4,13,22,7,"PAH",15,1,68,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,69,0)="     8.   DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,13,22,7,"PAH",15,1,70,0)=" "
^DIC(9.4,13,22,7,"PAH",15,1,71,0)="     9.   DO remove TaskMan from a WAIT state."
^DIC(9.4,13,22,7,"PAH",16,0)="26 SEQ #34^2970922^1"
^DIC(9.4,13,22,7,"PAH",17,0)="30 SEQ #35^2970922^1"
^DIC(9.4,13,22,7,"PAH",17,1,0)="^^120^120^2970922"
^DIC(9.4,13,22,7,"PAH",17,1,1,0)="Description:"
^DIC(9.4,13,22,7,"PAH",17,1,2,0)="============"
^DIC(9.4,13,22,7,"PAH",17,1,3,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,4,0)="This patch implements new VA FileMan functionality: the Import Tool.  "
^DIC(9.4,13,22,7,"PAH",17,1,5,0)="The Import Tool will move data from an ASCII host file into a VA FileMan "
^DIC(9.4,13,22,7,"PAH",17,1,6,0)="file.  The uses and limitations of the Import Tool are described in the "
^DIC(9.4,13,22,7,"PAH",17,1,7,0)="documentation. The location of the documentation is given below."
^DIC(9.4,13,22,7,"PAH",17,1,8,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,9,0)="The Import Tool consists of a new option and a programmer API.  A new "
^DIC(9.4,13,22,7,"PAH",17,1,10,0)="file is installed, too."
^DIC(9.4,13,22,7,"PAH",17,1,11,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,12,0)="A.  Import Data option"
^DIC(9.4,13,22,7,"PAH",17,1,13,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,14,0)="The new option is the Import Data option found on the Other Options "
^DIC(9.4,13,22,7,"PAH",17,1,15,0)="submenu (DIOTHER) on the VA FileMan menu.  This option invokes a "
^DIC(9.4,13,22,7,"PAH",17,1,16,0)="ScreenMan form used to define the import.  In addition to moving data "
^DIC(9.4,13,22,7,"PAH",17,1,17,0)="from a host file into a VA FileMan file, the Import Tool produces a "
^DIC(9.4,13,22,7,"PAH",17,1,18,0)="report of the import activity."
^DIC(9.4,13,22,7,"PAH",17,1,19,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,20,0)="Documentation of the Import Tool is located in a revised Chapter 18 of "
^DIC(9.4,13,22,7,"PAH",17,1,21,0)="the VA FileMan User Manual.  Previously, that chapter documented the "
^DIC(9.4,13,22,7,"PAH",17,1,22,0)="Data Export Tool.  Now, Chapter 18 documents both the Import and Export "
^DIC(9.4,13,22,7,"PAH",17,1,23,0)="Tools.  The National Center for Documentation will be distributing this "
^DIC(9.4,13,22,7,"PAH",17,1,24,0)="revised chapter.  Acrobat versions of both the change pages, and the "
^DIC(9.4,13,22,7,"PAH",17,1,25,0)="User Manual updated with the change pages, are available at"
^DIC(9.4,13,22,7,"PAH",17,1,26,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,27,0)=" http://www.vista.domain.ext/softserv/infrastr.uct/fileman/docs/"
^DIC(9.4,13,22,7,"PAH",17,1,28,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,29,0)="The new chapter is also available in HTML format at:"
^DIC(9.4,13,22,7,"PAH",17,1,30,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,31,0)=" http://www.vista.domain.ext/softserv/infrastr.uct/fileman/docs/u2/"
^DIC(9.4,13,22,7,"PAH",17,1,32,0)=" (access the Import/Export Tools chapter)"
^DIC(9.4,13,22,7,"PAH",17,1,33,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,34,0)="B. FILE^DDMP API"
^DIC(9.4,13,22,7,"PAH",17,1,35,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,36,0)="The programmer API consists of a single call: FILE^DDMP.  Functionally, "
^DIC(9.4,13,22,7,"PAH",17,1,37,0)="it is equivalent to the user option.  The API allows the programmer to "
^DIC(9.4,13,22,7,"PAH",17,1,38,0)="specify the parameters of the data import."
^DIC(9.4,13,22,7,"PAH",17,1,39,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,40,0)="Documentation in HTML format for the API can be found at:"
^DIC(9.4,13,22,7,"PAH",17,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,42,0)="      http://www.vista.domain.ext/softserv/infrastr.uct/fileman/docs/"
^DIC(9.4,13,22,7,"PAH",17,1,43,0)="      pm/ft_ddmpf.htm"
^DIC(9.4,13,22,7,"PAH",17,1,44,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,45,0)="C. Import Template file"
^DIC(9.4,13,22,7,"PAH",17,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,47,0)="A new file is added by this patch: the Import Template file (#.46).  The "
^DIC(9.4,13,22,7,"PAH",17,1,48,0)="file's data is stored in an existing global -- root: ^DIST(.46.  No data "
^DIC(9.4,13,22,7,"PAH",17,1,49,0)="for the file is contained in this patch.  "
^DIC(9.4,13,22,7,"PAH",17,1,50,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,51,0)="Routine Summary:"
^DIC(9.4,13,22,7,"PAH",17,1,52,0)="================"
^DIC(9.4,13,22,7,"PAH",17,1,53,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,54,0)="The following routines are included in this patch.  Checksums are "
^DIC(9.4,13,22,7,"PAH",17,1,55,0)="CHECK^XTSUMBLD results."
^DIC(9.4,13,22,7,"PAH",17,1,56,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,57,0)=" Routine Name         Before Patch     After Patch     Patch List"
^DIC(9.4,13,22,7,"PAH",17,1,58,0)=" ============         ============     ===========     =========="
^DIC(9.4,13,22,7,"PAH",17,1,59,0)=" DDMP                 <NEW>            11685139        30"
^DIC(9.4,13,22,7,"PAH",17,1,60,0)=" DDMP1                <NEW>            9723042         30"
^DIC(9.4,13,22,7,"PAH",17,1,61,0)=" DDMP2                <NEW>            9285380         30"
^DIC(9.4,13,22,7,"PAH",17,1,62,0)=" DDMPSM               <NEW>            7179788         30"
^DIC(9.4,13,22,7,"PAH",17,1,63,0)=" DDMPSM1              <NEW>            3485759         30"
^DIC(9.4,13,22,7,"PAH",17,1,64,0)=" DDMPU                <NEW>            8199841         30"
^DIC(9.4,13,22,7,"PAH",17,1,65,0)=" DII1                 455555           468832          30"
^DIC(9.4,13,22,7,"PAH",17,1,66,0)=" DINIT6               3176942          3570355         30"
^DIC(9.4,13,22,7,"PAH",17,1,67,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,68,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,69,0)="The DDMP* routines contain the Import Tool.  DII1 is included to add the "
^DIC(9.4,13,22,7,"PAH",17,1,70,0)="Import Data option to the Other menu when VA FileMan is accessed from "
^DIC(9.4,13,22,7,"PAH",17,1,71,0)="Programmer mode.  DINIT6 assures that the Data Import option will not be "
^DIC(9.4,13,22,7,"PAH",17,1,72,0)="removed from the Kernel menus if ^DINIT is rerun.  It is NOT necessary "
^DIC(9.4,13,22,7,"PAH",17,1,73,0)="to rerun ^DINIT to implement this patch."
^DIC(9.4,13,22,7,"PAH",17,1,74,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,75,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",17,1,76,0)="=========================="
^DIC(9.4,13,22,7,"PAH",17,1,77,0)="  "
^DIC(9.4,13,22,7,"PAH",17,1,78,0)="1.  Neither of the pre-existing routines in this patch are typically "
^DIC(9.4,13,22,7,"PAH",17,1,79,0)="mapped. It is NOT recommended that any of the DDMP* routines be mapped."
^DIC(9.4,13,22,7,"PAH",17,1,80,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,81,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,13,22,7,"PAH",17,1,82,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",17,1,83,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,84,0)="3.  The patch has now been loaded into a transport global on your "
^DIC(9.4,13,22,7,"PAH",17,1,85,0)="system.  You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,7,"PAH",17,1,86,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,87,0)="4.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,13,22,7,"PAH",17,1,88,0)="options: "
^DIC(9.4,13,22,7,"PAH",17,1,89,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,90,0)="           Print Transport Global "
^DIC(9.4,13,22,7,"PAH",17,1,91,0)="           Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",17,1,92,0)="           Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",17,1,93,0)="           Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",17,1,94,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,95,0)="5.  Users may remain on the system when this patch is installed.  "
^DIC(9.4,13,22,7,"PAH",17,1,96,0)="TaskMan should remain running."
^DIC(9.4,13,22,7,"PAH",17,1,97,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,98,0)="6.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,13,22,7,"PAH",17,1,99,0)="option: "
^DIC(9.4,13,22,7,"PAH",17,1,100,0)="           Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",17,1,101,0)="           Select INSTALL NAME: DI*21.0*30 "
^DIC(9.4,13,22,7,"PAH",17,1,102,0)="                                =========="
^DIC(9.4,13,22,7,"PAH",17,1,103,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,104,0)="Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,13,22,7,"PAH",17,1,105,0)="Protocols?' question. "
^DIC(9.4,13,22,7,"PAH",17,1,106,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,107,0)="7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to "
^DIC(9.4,13,22,7,"PAH",17,1,108,0)="other CPUs?'. Then enter the names of your other Compute and Print "
^DIC(9.4,13,22,7,"PAH",17,1,109,0)="server(s)."
^DIC(9.4,13,22,7,"PAH",17,1,110,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,111,0)="8.  KIDS will load the patch without further intervention.  During the"
^DIC(9.4,13,22,7,"PAH",17,1,112,0)="KIDS install, KIDS will produce the following messages:"
^DIC(9.4,13,22,7,"PAH",17,1,113,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,114,0)="        Data Dictionary for File #.403 not installed."
^DIC(9.4,13,22,7,"PAH",17,1,115,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,116,0)="        Data Dictionary for File #.404 not installed."
^DIC(9.4,13,22,7,"PAH",17,1,117,0)=" "
^DIC(9.4,13,22,7,"PAH",17,1,118,0)="These message do NOT indicate an error condition.  They are reporting that"
^DIC(9.4,13,22,7,"PAH",17,1,119,0)="new Data Dictionaries for the Form and Block files are not being installed"
^DIC(9.4,13,22,7,"PAH",17,1,120,0)="although data for those files is being updated.  This is correct."
^DIC(9.4,13,22,7,"PAH",18,0)="35 SEQ #36^2970922^1"
^DIC(9.4,13,22,7,"PAH",19,0)="38 SEQ #37^2980129^1"
^DIC(9.4,13,22,7,"PAH",19,1,0)="^^191^191^2980129"
^DIC(9.4,13,22,7,"PAH",19,1,1,0)="VA FileMan SQLI Interface (SQLI) "
^DIC(9.4,13,22,7,"PAH",19,1,2,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,3,0)="This patch installs the foundation for building an interface between VA"
^DIC(9.4,13,22,7,"PAH",19,1,4,0)="FileMan's data dictionaries and a vendor's M-based SQL data dictionaries."
^DIC(9.4,13,22,7,"PAH",19,1,5,0)="This patch will bring in a new global, ^DMSQ, and several new routines and"
^DIC(9.4,13,22,7,"PAH",19,1,6,0)="options in the DMSQ namespace."
^DIC(9.4,13,22,7,"PAH",19,1,7,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,8,0)="The new files (in ^DMSQ) are in the 1.52 to 1.53 number range.  Each one"
^DIC(9.4,13,22,7,"PAH",19,1,9,0)="begins with SQLI, e.g. the SQLI_TABLE file.  None of the files includes"
^DIC(9.4,13,22,7,"PAH",19,1,10,0)="data.  After installing this patch, note that the DMSQ MENU will not be"
^DIC(9.4,13,22,7,"PAH",19,1,11,0)="attached to any other existing menu; it is stand-alone, to be assigned as"
^DIC(9.4,13,22,7,"PAH",19,1,12,0)="needed."
^DIC(9.4,13,22,7,"PAH",19,1,13,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,14,0)="The installation of this patch is mandatory because the software includes"
^DIC(9.4,13,22,7,"PAH",19,1,15,0)="supported references (entry points and DD structures) that may be called"
^DIC(9.4,13,22,7,"PAH",19,1,16,0)="by application code.  So, even if you don't plan to implement"
^DIC(9.4,13,22,7,"PAH",19,1,17,0)="SQLI as a basis for a vendor SQL product, you still should install this"
^DIC(9.4,13,22,7,"PAH",19,1,18,0)="patch.  "
^DIC(9.4,13,22,7,"PAH",19,1,19,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,20,0)="The installation instructions for loading this patch are entirely"
^DIC(9.4,13,22,7,"PAH",19,1,21,0)="contained below.  You don't need to get the SQLI documentation for this"
^DIC(9.4,13,22,7,"PAH",19,1,22,0)="purpose.  (The SQLI documentation doesn't include installation"
^DIC(9.4,13,22,7,"PAH",19,1,23,0)="instructions for loading this patch.)"
^DIC(9.4,13,22,7,"PAH",19,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,25,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,26,0)="Documentation for Implementing SQLI"
^DIC(9.4,13,22,7,"PAH",19,1,27,0)="==================================="
^DIC(9.4,13,22,7,"PAH",19,1,28,0)="Implementing SQLI is optional.  See the VA FileMan SQLI Site Manual for"
^DIC(9.4,13,22,7,"PAH",19,1,29,0)="more information about populating the SQLI files and, furthermore,"
^DIC(9.4,13,22,7,"PAH",19,1,30,0)="incorporating vendor SQL products and building an SQL system.  This manual"
^DIC(9.4,13,22,7,"PAH",19,1,31,0)="is to be reproduced and distributed by the National Center for"
^DIC(9.4,13,22,7,"PAH",19,1,32,0)="Documetation (NCD).  This manual will also be available in Acrobat PDF"
^DIC(9.4,13,22,7,"PAH",19,1,33,0)="format from the SQLI home page:"
^DIC(9.4,13,22,7,"PAH",19,1,34,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,35,0)="         http://www.vista.domain.ext/softserv/infrastr.uct/sqli"
^DIC(9.4,13,22,7,"PAH",19,1,36,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,37,0)="The SQLI home page will be a source of current information, including case"
^DIC(9.4,13,22,7,"PAH",19,1,38,0)="studies of how sites have chosen to implement SQL access to their systems."
^DIC(9.4,13,22,7,"PAH",19,1,39,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,40,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,41,0)="Test Sites "
^DIC(9.4,13,22,7,"PAH",19,1,42,0)="=========="
^DIC(9.4,13,22,7,"PAH",19,1,43,0)="Two test sites have loaded this SQLI patch and have implemented a full SQL"
^DIC(9.4,13,22,7,"PAH",19,1,44,0)="system (with the additional vendor software that's needed).  These are the"
^DIC(9.4,13,22,7,"PAH",19,1,45,0)="VA medical facilities at San Francisco (VISN 21) and Brooklyn (VISN 3).  "
^DIC(9.4,13,22,7,"PAH",19,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,47,0)="Four additional test sites are in the process of establishing a system"
^DIC(9.4,13,22,7,"PAH",19,1,48,0)="that is based on SQLI:  VA medical facilities at Seattle (VISN 20),"
^DIC(9.4,13,22,7,"PAH",19,1,49,0)="Phoenix (VISN 18), West Haven (VISN 3), and Palo Alto (VISN 21).  "
^DIC(9.4,13,22,7,"PAH",19,1,50,0)="  "
^DIC(9.4,13,22,7,"PAH",19,1,51,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,52,0)="Supported References"
^DIC(9.4,13,22,7,"PAH",19,1,53,0)="===================="
^DIC(9.4,13,22,7,"PAH",19,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,55,0)="DATA DICTIONARIES  "
^DIC(9.4,13,22,7,"PAH",19,1,56,0)="All the files, fields, and cross-references included in this patch can be"
^DIC(9.4,13,22,7,"PAH",19,1,57,0)="referenced directly without integration agreements.  This enables vendors"
^DIC(9.4,13,22,7,"PAH",19,1,58,0)="to create mapping utilities using the SQLI structures.  Specifically,"
^DIC(9.4,13,22,7,"PAH",19,1,59,0)="these are the files in the 1.52 to 1.53 number range, all stored in ^DMSQ."
^DIC(9.4,13,22,7,"PAH",19,1,60,0)="See the SQLI Vendor Manual on the SQLI home page for more specific"
^DIC(9.4,13,22,7,"PAH",19,1,61,0)="information."
^DIC(9.4,13,22,7,"PAH",19,1,62,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,63,0)="CALLABLE ENTRY POINTS"
^DIC(9.4,13,22,7,"PAH",19,1,64,0)="The following routine entry points may be called in application code."
^DIC(9.4,13,22,7,"PAH",19,1,65,0)="They are primarily designed for use in vendor mapping code.  See the SQLI"
^DIC(9.4,13,22,7,"PAH",19,1,66,0)="Site Manual and SQLI Vendor manual for more information."
^DIC(9.4,13,22,7,"PAH",19,1,67,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,68,0)="Populating SQLI files (Projecting the Interface)"
^DIC(9.4,13,22,7,"PAH",19,1,69,0)="         ALLF^DMSQF - non-interactive call"
^DIC(9.4,13,22,7,"PAH",19,1,70,0)="         SETUP^DMSQ - interactive call (used in the DMSQ PROJECT option)"
^DIC(9.4,13,22,7,"PAH",19,1,71,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,72,0)="Populating the SQLI_KEY_WORD file (with the SQL vendor's keywords)"
^DIC(9.4,13,22,7,"PAH",19,1,73,0)="         KW^DMSQD - loads keywords from a specified global"
^DIC(9.4,13,22,7,"PAH",19,1,74,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,75,0)="Populate the SQLI_TABLE and SQLI_PRIMARY_KEY row counts (to accumulate"
^DIC(9.4,13,22,7,"PAH",19,1,76,0)="statistics that vendors may want to use to optimize queries)"
^DIC(9.4,13,22,7,"PAH",19,1,77,0)="         ALLS^DMSQS - all tables"
^DIC(9.4,13,22,7,"PAH",19,1,78,0)="         STATS^DMSQS - one table "
^DIC(9.4,13,22,7,"PAH",19,1,79,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,80,0)="Naming algorithms to generate SQL-compatible names"
^DIC(9.4,13,22,7,"PAH",19,1,81,0)="         $$SQLI^DMSQU - general check"
^DIC(9.4,13,22,7,"PAH",19,1,82,0)="         $$SQLK^DMSQU - general check including keyword check"
^DIC(9.4,13,22,7,"PAH",19,1,83,0)="         $$FNB^DMSQU - specific check for table names"
^DIC(9.4,13,22,7,"PAH",19,1,84,0)="         $$CN^DMSQU - specific check for column names"
^DIC(9.4,13,22,7,"PAH",19,1,85,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,86,0)="DIRECT MODE UTILITIES (also available via the DMSQ MENU option)"
^DIC(9.4,13,22,7,"PAH",19,1,87,0)="These calls are for direct mode use only (issued interactively at the"
^DIC(9.4,13,22,7,"PAH",19,1,88,0)="programmer prompt).  They are not supported for use in application code."
^DIC(9.4,13,22,7,"PAH",19,1,89,0)="See the SQLI Site Manual for more information."
^DIC(9.4,13,22,7,"PAH",19,1,90,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,91,0)="         MAIN^DMSQE - lists files/fields that couldn't be projected"
^DIC(9.4,13,22,7,"PAH",19,1,92,0)="         RUNONE^DMSQ - re-run projection for one file (for testing only)"
^DIC(9.4,13,22,7,"PAH",19,1,93,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,94,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,95,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",19,1,96,0)="================"
^DIC(9.4,13,22,7,"PAH",19,1,97,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,7,"PAH",19,1,98,0)="these routines will look like: "
^DIC(9.4,13,22,7,"PAH",19,1,99,0)="   "
^DIC(9.4,13,22,7,"PAH",19,1,100,0)="   <tab>;;21.0;VA FileMan;**38**;July 28, 1997 "
^DIC(9.4,13,22,7,"PAH",19,1,101,0)="   "
^DIC(9.4,13,22,7,"PAH",19,1,102,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",19,1,103,0)="   "
^DIC(9.4,13,22,7,"PAH",19,1,104,0)="   Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",19,1,105,0)="   ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",19,1,106,0)="   DMSQ            new routine     10102863          38 "
^DIC(9.4,13,22,7,"PAH",19,1,107,0)="   DMSQD           new routine     8773388           38 "
^DIC(9.4,13,22,7,"PAH",19,1,108,0)="   DMSQE           new routine     843826            38 "
^DIC(9.4,13,22,7,"PAH",19,1,109,0)="   DMSQF           new routine     9792265           38 "
^DIC(9.4,13,22,7,"PAH",19,1,110,0)="   DMSQF1          new routine     8310046           38 "
^DIC(9.4,13,22,7,"PAH",19,1,111,0)="   DMSQF2          new routine     8370804           38 "
^DIC(9.4,13,22,7,"PAH",19,1,112,0)="   DMSQP           new routine     2371815           38 "
^DIC(9.4,13,22,7,"PAH",19,1,113,0)="   DMSQP1          new routine     3565656           38 "
^DIC(9.4,13,22,7,"PAH",19,1,114,0)="   DMSQP2          new routine     6721470           38 "
^DIC(9.4,13,22,7,"PAH",19,1,115,0)="   DMSQP3          new routine     11874271          38 "
^DIC(9.4,13,22,7,"PAH",19,1,116,0)="   DMSQP4          new routine     2151271           38 "
^DIC(9.4,13,22,7,"PAH",19,1,117,0)="   DMSQP5          new routine     5423594           38 "
^DIC(9.4,13,22,7,"PAH",19,1,118,0)="   DMSQP6          new routine     10074783          38 "
^DIC(9.4,13,22,7,"PAH",19,1,119,0)="   DMSQS           new routine     3197279           38 "
^DIC(9.4,13,22,7,"PAH",19,1,120,0)="   DMSQT           new routine     11672859          38 "
^DIC(9.4,13,22,7,"PAH",19,1,121,0)="   DMSQT1          new routine     1181888           38 "
^DIC(9.4,13,22,7,"PAH",19,1,122,0)="   DMSQU           new routine     10589283          38"
^DIC(9.4,13,22,7,"PAH",19,1,123,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,124,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",19,1,125,0)="=========================="
^DIC(9.4,13,22,7,"PAH",19,1,126,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,127,0)="Before starting:  Place and protect ^DMSQ"
^DIC(9.4,13,22,7,"PAH",19,1,128,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,129,0)="This patch brings in a new global, ^DMSQ.  As usual with new globals,"
^DIC(9.4,13,22,7,"PAH",19,1,130,0)="place it before running the install (the default location of the install"
^DIC(9.4,13,22,7,"PAH",19,1,131,0)="will otherwise be used).  You can translate it for ease of access."
^DIC(9.4,13,22,7,"PAH",19,1,132,0)="Journaling is unnecessary."
^DIC(9.4,13,22,7,"PAH",19,1,133,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,134,0)="For global protection, a standard approach can be used, such as the"
^DIC(9.4,13,22,7,"PAH",19,1,135,0)="following:"
^DIC(9.4,13,22,7,"PAH",19,1,136,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,137,0)="     DSM for OpenVMS - System (RWD), World (RW), Group (RW), and User (RW)"
^DIC(9.4,13,22,7,"PAH",19,1,138,0)="     OpenM - Owner (RWD), Network (RWD), Group (N), World (N)"
^DIC(9.4,13,22,7,"PAH",19,1,139,0)="     MSM-DOS - System (RWD), World (RWD), Group (RWD), User (RWD)"
^DIC(9.4,13,22,7,"PAH",19,1,140,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,141,0)="NOTE: Users may remain on the system during this installation.  There's no"
^DIC(9.4,13,22,7,"PAH",19,1,142,0)="need to disable logons either."
^DIC(9.4,13,22,7,"PAH",19,1,143,0)="   "
^DIC(9.4,13,22,7,"PAH",19,1,144,0)="1.  There's no need to disable mapping (these routines won't need to be"
^DIC(9.4,13,22,7,"PAH",19,1,145,0)="    mapped)."
^DIC(9.4,13,22,7,"PAH",19,1,146,0)="  "
^DIC(9.4,13,22,7,"PAH",19,1,147,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,7,"PAH",19,1,148,0)="    option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,7,"PAH",19,1,149,0)="   "
^DIC(9.4,13,22,7,"PAH",19,1,150,0)="3.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,13,22,7,"PAH",19,1,151,0)="    You now need to use KIDS to install the Transport global.  "
^DIC(9.4,13,22,7,"PAH",19,1,152,0)="  "
^DIC(9.4,13,22,7,"PAH",19,1,153,0)="4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,7,"PAH",19,1,154,0)="    options: "
^DIC(9.4,13,22,7,"PAH",19,1,155,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",19,1,156,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",19,1,157,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",19,1,158,0)="            Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",19,1,159,0)="  "
^DIC(9.4,13,22,7,"PAH",19,1,160,0)="(5.  Users don't need to logoff.  They may remain on the system while this"
^DIC(9.4,13,22,7,"PAH",19,1,161,0)="     patch is installed.) "
^DIC(9.4,13,22,7,"PAH",19,1,162,0)="  "
^DIC(9.4,13,22,7,"PAH",19,1,163,0)="(6.  There isn't any need to place TaskMan in a WAIT state.) "
^DIC(9.4,13,22,7,"PAH",19,1,164,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,165,0)="7.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,7,"PAH",19,1,166,0)="    option: "
^DIC(9.4,13,22,7,"PAH",19,1,167,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,168,0)="            Install Package(s): "
^DIC(9.4,13,22,7,"PAH",19,1,169,0)="            INSTALL NAME: DI*21.0*38 "
^DIC(9.4,13,22,7,"PAH",19,1,170,0)="                          =========="
^DIC(9.4,13,22,7,"PAH",19,1,171,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,172,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,13,22,7,"PAH",19,1,173,0)="            Options, and Protocols?' "
^DIC(9.4,13,22,7,"PAH",19,1,174,0)="  "
^DIC(9.4,13,22,7,"PAH",19,1,175,0)="8.  MSM Sites - Answer YES to the question 'Want to MOVE routines to other"
^DIC(9.4,13,22,7,"PAH",19,1,176,0)="    CPUs?'. Enter the names of your Compute and Print server(s).  "
^DIC(9.4,13,22,7,"PAH",19,1,177,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,178,0)="9.  MSM Sites - After the installation begins, you will be prompted to"
^DIC(9.4,13,22,7,"PAH",19,1,179,0)="    enter a DEVICE.  After the device has been entered, KIDS will pause."
^DIC(9.4,13,22,7,"PAH",19,1,180,0)="    At this time, you need to go to each of the CPUs that were identified"
^DIC(9.4,13,22,7,"PAH",19,1,181,0)="    in the previous step and start a job that will allow them to receive"
^DIC(9.4,13,22,7,"PAH",19,1,182,0)="    the routines included in the patch.  On each CPU, do the following:"
^DIC(9.4,13,22,7,"PAH",19,1,183,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,184,0)="         a) >D ^XUP     - to set up the programming environment "
^DIC(9.4,13,22,7,"PAH",19,1,185,0)="             ======"
^DIC(9.4,13,22,7,"PAH",19,1,186,0)="         b) >D ^XPDCPU  - to start the job that receives the routines "
^DIC(9.4,13,22,7,"PAH",19,1,187,0)="             ========="
^DIC(9.4,13,22,7,"PAH",19,1,188,0)="         c) Select INSTALL NAME: DI*21.0*38 "
^DIC(9.4,13,22,7,"PAH",19,1,189,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",19,1,190,0)=" "
^DIC(9.4,13,22,7,"PAH",19,1,191,0)="This completes the installation instructions."
^DIC(9.4,13,22,7,"PAH",20,0)="44 SEQ #38^2980220^1"
^DIC(9.4,13,22,7,"PAH",20,1,0)="^^202^202^2980220"
^DIC(9.4,13,22,7,"PAH",20,1,1,0)=" This patch makes a few minor bug fixes and contains some enhancements to"
^DIC(9.4,13,22,7,"PAH",20,1,2,0)=" ensure compliance with year 2000 issues.  The changes are as follows:"
^DIC(9.4,13,22,7,"PAH",20,1,3,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,4,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,5,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,6,0)=" DDMP2  Changed to call internal FileMan date formatting routines (DILIBF)"
^DIC(9.4,13,22,7,"PAH",20,1,7,0)="     rather than Kernel date formatting routines (XLFDT) to take"
^DIC(9.4,13,22,7,"PAH",20,1,8,0)="     advantage of changes made to DILIBF (described below)."
^DIC(9.4,13,22,7,"PAH",20,1,9,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,10,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,11,0)=" DIDT (%DT)  Two minor bugs were corrected.  "
^DIC(9.4,13,22,7,"PAH",20,1,12,0)="     One is that before, if %DT input variable contained ""X"", and if user"
^DIC(9.4,13,22,7,"PAH",20,1,13,0)="     entered a date like MMDDYY where the year was ""00"", the date was"
^DIC(9.4,13,22,7,"PAH",20,1,14,0)="     rejected. "
^DIC(9.4,13,22,7,"PAH",20,1,15,0)="     The other is that one of the algorithms was incorrectly treating the"
^DIC(9.4,13,22,7,"PAH",20,1,16,0)="     year 2100 as a leap year."
^DIC(9.4,13,22,7,"PAH",20,1,17,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,18,0)="     In addition, an enhancement was made that will change the current"
^DIC(9.4,13,22,7,"PAH",20,1,19,0)="     behavior. Currently, as documented, if a user enters only 2 digits of"
^DIC(9.4,13,22,7,"PAH",20,1,20,0)="     the year and if %DT is not set up by the developer to contain either"
^DIC(9.4,13,22,7,"PAH",20,1,21,0)="     an ""F"" (future) or ""P"" (past), then FileMan assumes the current"
^DIC(9.4,13,22,7,"PAH",20,1,22,0)="     century.  Thus in 1997, if a user enters 01/01/00, FileMan assumes"
^DIC(9.4,13,22,7,"PAH",20,1,23,0)="     01/01/1900."
^DIC(9.4,13,22,7,"PAH",20,1,24,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,25,0)="     NEW BEHAVIOR for DIDT (%DT):"
^DIC(9.4,13,22,7,"PAH",20,1,26,0)="     note that this new behavior only applies when the user enters"
^DIC(9.4,13,22,7,"PAH",20,1,27,0)="     a 2-digit year, causing FileMan to guess the century.  Note"
^DIC(9.4,13,22,7,"PAH",20,1,28,0)="     also that the ""F"" and ""P"" flags will behave as they always have--this"
^DIC(9.4,13,22,7,"PAH",20,1,29,0)="     new behavior is only used when neither of those flags is set."
^DIC(9.4,13,22,7,"PAH",20,1,30,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,31,0)="     If using the current century causes the date to be more than 80 years"
^DIC(9.4,13,22,7,"PAH",20,1,32,0)="     in the past, then FileMan will assume the next century.  Thus in 1997"
^DIC(9.4,13,22,7,"PAH",20,1,33,0)="     if a user enters a year of 0 through 16, FileMan will assume the"
^DIC(9.4,13,22,7,"PAH",20,1,34,0)="     years 2000 through 2016, because 1900 through 1916 are more than 80"
^DIC(9.4,13,22,7,"PAH",20,1,35,0)="     years in the past."
^DIC(9.4,13,22,7,"PAH",20,1,36,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,37,0)="     If using the current century causes the date to be more than 20 years"
^DIC(9.4,13,22,7,"PAH",20,1,38,0)="     in the future, then FileMan will assume the previous century.  Thus"
^DIC(9.4,13,22,7,"PAH",20,1,39,0)="     in the year 2000, if the user enters 21 through 99, FileMan will"
^DIC(9.4,13,22,7,"PAH",20,1,40,0)="     assume the years 1921 through 1999, because 2021 through 2099 are"
^DIC(9.4,13,22,7,"PAH",20,1,41,0)="     more than 20 years in the future."
^DIC(9.4,13,22,7,"PAH",20,1,42,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,43,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,44,0)=" DIDTC (%DTC)  Although all of the code properly handled dates up to 2100,"
^DIC(9.4,13,22,7,"PAH",20,1,45,0)="     the code was treating 2100 as a leap year.  This has been corrected."
^DIC(9.4,13,22,7,"PAH",20,1,46,0)="     Also, online help for dates (HELP^%DTC) was changed to reflect the"
^DIC(9.4,13,22,7,"PAH",20,1,47,0)="     change in functionality described in ^%DT above."
^DIC(9.4,13,22,7,"PAH",20,1,48,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,49,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,50,0)=" DIEH1  Online help for dates used by the DataBase Server calls (DT^DIEH1)"
^DIC(9.4,13,22,7,"PAH",20,1,51,0)="     was changed to reflect the change in functionality described in"
^DIC(9.4,13,22,7,"PAH",20,1,52,0)="     ^%DT above.  In support of this routine change is a change to entry"
^DIC(9.4,13,22,7,"PAH",20,1,53,0)="     #9110 in the DIALOG file."
^DIC(9.4,13,22,7,"PAH",20,1,54,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,55,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,56,0)=" DILIBF  Old algorithms were treating the year 2100 as a leap year.  This"
^DIC(9.4,13,22,7,"PAH",20,1,57,0)="     has been corrected."
^DIC(9.4,13,22,7,"PAH",20,1,58,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,59,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,60,0)=" DINVMSM  This routine contains operating system-specific code and is used"
^DIC(9.4,13,22,7,"PAH",20,1,61,0)="     by stand-alone FileMan sites only.  Routine SET was setting DT using"
^DIC(9.4,13,22,7,"PAH",20,1,62,0)="     an MSM-specific call that would not have worked properly in the year"
^DIC(9.4,13,22,7,"PAH",20,1,63,0)="     2000. This has been corrected."
^DIC(9.4,13,22,7,"PAH",20,1,64,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,65,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,66,0)=" DIP12  In the PRINT option, if the user chose to print the sort criteria"
^DIC(9.4,13,22,7,"PAH",20,1,67,0)="     in the header of the report, and if any of the sort fields were"
^DIC(9.4,13,22,7,"PAH",20,1,68,0)="     dates, the date was previously printed with a 2-digit year. That is"
^DIC(9.4,13,22,7,"PAH",20,1,69,0)="     changed so that the date is now printed with a 4-digit year for"
^DIC(9.4,13,22,7,"PAH",20,1,70,0)="     clarity."
^DIC(9.4,13,22,7,"PAH",20,1,71,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,72,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,73,0)=" DIQGU  Old algorithms were treating the year 2100 as a leap year.  This"
^DIC(9.4,13,22,7,"PAH",20,1,74,0)="     has been corrected."
^DIC(9.4,13,22,7,"PAH",20,1,75,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,76,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,77,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,78,0)=" CHANGE TO ENTRY IN DIALOG FILE:  In support of new online help for dates"
^DIC(9.4,13,22,7,"PAH",20,1,79,0)="     to reflect the new behavior of ^%DT, entry number 9110 has been"
^DIC(9.4,13,22,7,"PAH",20,1,80,0)="     changed. This entry is called from routine DIEH1."
^DIC(9.4,13,22,7,"PAH",20,1,81,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,82,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,83,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,84,0)=" NEW FILEMAN FUNCTIONS: NUMDATE4 and NUMYEAR4"
^DIC(9.4,13,22,7,"PAH",20,1,85,0)="     The new FileMan Functions NUMDATE4 and NUMYEAR4 have been added to"
^DIC(9.4,13,22,7,"PAH",20,1,86,0)="     the list of FileMan Functions that are available for use within"
^DIC(9.4,13,22,7,"PAH",20,1,87,0)="     FileMan.  They behave as follows:"
^DIC(9.4,13,22,7,"PAH",20,1,88,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,89,0)="   NUMDATE4"
^DIC(9.4,13,22,7,"PAH",20,1,90,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,91,0)="        Format:  NUMDATE4(datexp)"
^DIC(9.4,13,22,7,"PAH",20,1,92,0)="        Where:   datexp is an expression with a date/time value"
^DIC(9.4,13,22,7,"PAH",20,1,93,0)="        Use:     This function returns the date in datexp, in MM/DD/YYYY"
^DIC(9.4,13,22,7,"PAH",20,1,94,0)="                 format."
^DIC(9.4,13,22,7,"PAH",20,1,95,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,96,0)="        Example:  NUMDATE4(DATE OF BIRTH)==> 03/07/1949"
^DIC(9.4,13,22,7,"PAH",20,1,97,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,98,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,99,0)="   NUMYEAR4"
^DIC(9.4,13,22,7,"PAH",20,1,100,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,101,0)="        Format:   NUMYEAR4(datexp)"
^DIC(9.4,13,22,7,"PAH",20,1,102,0)="        Where:    datexp is an expression with a date/time value"
^DIC(9.4,13,22,7,"PAH",20,1,103,0)="        Use:      This function returns the 4 digit year in datexp as a  "
^DIC(9.4,13,22,7,"PAH",20,1,104,0)="                  number."
^DIC(9.4,13,22,7,"PAH",20,1,105,0)="  "
^DIC(9.4,13,22,7,"PAH",20,1,106,0)="        Example:  NUMYEAR4(DATE OF BIRTH)==> 1949"
^DIC(9.4,13,22,7,"PAH",20,1,107,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,108,0)="   "
^DIC(9.4,13,22,7,"PAH",20,1,109,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",20,1,110,0)="================"
^DIC(9.4,13,22,7,"PAH",20,1,111,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,112,0)="  Routine Name         Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",20,1,113,0)="  ============         ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",20,1,114,0)="  DDMP2                9285380         9295425         30,44 "
^DIC(9.4,13,22,7,"PAH",20,1,115,0)="  DIDT (%DT)           6367783         6481242         18,24,37,44 "
^DIC(9.4,13,22,7,"PAH",20,1,116,0)="  DIDTC (%DTC)         7334026         7099203         18,44 "
^DIC(9.4,13,22,7,"PAH",20,1,117,0)="  DIEH1                1151210         1201975         44 "
^DIC(9.4,13,22,7,"PAH",20,1,118,0)="  DIENV (env.check)     129370          129370         44"
^DIC(9.4,13,22,7,"PAH",20,1,119,0)="  DILIBF               6348908         6194115         44 "
^DIC(9.4,13,22,7,"PAH",20,1,120,0)="  DINVMSM              8405664         8320664         44 "
^DIC(9.4,13,22,7,"PAH",20,1,121,0)="  DIP12                4793451         4793661         2,9,16,44 "
^DIC(9.4,13,22,7,"PAH",20,1,122,0)="  DIQGU                4937798         4828002         8,44 "
^DIC(9.4,13,22,7,"PAH",20,1,123,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,124,0)="      To test if the transport has been corrupted, you can use the ""Verify"
^DIC(9.4,13,22,7,"PAH",20,1,125,0)="Package Integrity"" option.  This option is under Utilities under the KIDS"
^DIC(9.4,13,22,7,"PAH",20,1,126,0)="menu.  It will compare the checksums in the build with the current"
^DIC(9.4,13,22,7,"PAH",20,1,127,0)="checksums and list any that differ.  "
^DIC(9.4,13,22,7,"PAH",20,1,128,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,129,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,130,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,131,0)=" Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",20,1,132,0)=" =========================="
^DIC(9.4,13,22,7,"PAH",20,1,133,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,134,0)=" NOTE the instructions that are different for your M implementation.  "
^DIC(9.4,13,22,7,"PAH",20,1,135,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,136,0)="      1.   NOTE: Users ARE NOT allowed to be on the system during the "
^DIC(9.4,13,22,7,"PAH",20,1,137,0)="installation.  "
^DIC(9.4,13,22,7,"PAH",20,1,138,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,139,0)="   --- Pre Installation steps --- "
^DIC(9.4,13,22,7,"PAH",20,1,140,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,141,0)="      2.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,13,22,7,"PAH",20,1,142,0)="This option will load the KIDS package onto your system.  The environment"
^DIC(9.4,13,22,7,"PAH",20,1,143,0)="check routine DIENV will run automatically."
^DIC(9.4,13,22,7,"PAH",20,1,144,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,145,0)="     DIENV is sent to prevent the inadvertent queuing of the installation"
^DIC(9.4,13,22,7,"PAH",20,1,146,0)="of this patch."
^DIC(9.4,13,22,7,"PAH",20,1,147,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,148,0)="      3.   The patch has now been loaded into a Transport global on your "
^DIC(9.4,13,22,7,"PAH",20,1,149,0)="system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,13,22,7,"PAH",20,1,150,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,151,0)="      4.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",20,1,152,0)="following options:"
^DIC(9.4,13,22,7,"PAH",20,1,153,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",20,1,154,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",20,1,155,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",20,1,156,0)="            Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",20,1,157,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,158,0)="   --- Actual Installation --- "
^DIC(9.4,13,22,7,"PAH",20,1,159,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,160,0)="      5.   Users ARE NOT allowed to be on the system during the"
^DIC(9.4,13,22,7,"PAH",20,1,161,0)="installation. Inhibit users from login into the system.  %DT, %DTC, DILIBF"
^DIC(9.4,13,22,7,"PAH",20,1,162,0)="and DIP12 in particular are used heavily in VISTA applications.  The"
^DIC(9.4,13,22,7,"PAH",20,1,163,0)="consequences of installing this patch while users are on the system are"
^DIC(9.4,13,22,7,"PAH",20,1,164,0)="that users may get a 'source routine edited' error."
^DIC(9.4,13,22,7,"PAH",20,1,165,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,166,0)="      6.   DO place TaskMan in a WAIT state.  "
^DIC(9.4,13,22,7,"PAH",20,1,167,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,168,0)="      7.   DSM Sites: The routines %DT, %DTC and DILIBF are usually mapped"
^DIC(9.4,13,22,7,"PAH",20,1,169,0)="on systems that allow mapping, so you will need to disable mapping for"
^DIC(9.4,13,22,7,"PAH",20,1,170,0)="these routines."
^DIC(9.4,13,22,7,"PAH",20,1,171,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,172,0)="      8.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",20,1,173,0)="following option:"
^DIC(9.4,13,22,7,"PAH",20,1,174,0)="            Install Package(s) "
^DIC(9.4,13,22,7,"PAH",20,1,175,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,176,0)="            INSTALL NAME: DI*21.0*44 "
^DIC(9.4,13,22,7,"PAH",20,1,177,0)="                          =========="
^DIC(9.4,13,22,7,"PAH",20,1,178,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,179,0)="       Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,7,"PAH",20,1,180,0)="and Protocols?'"
^DIC(9.4,13,22,7,"PAH",20,1,181,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,182,0)="      9. DSM and MSM sites: After installing this patch, you need to move"
^DIC(9.4,13,22,7,"PAH",20,1,183,0)="the routines DIDT and DIDTC from your production account into your manager"
^DIC(9.4,13,22,7,"PAH",20,1,184,0)="account. Then, in the manager account, rename:"
^DIC(9.4,13,22,7,"PAH",20,1,185,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,186,0)="       DIDT to %DT "
^DIC(9.4,13,22,7,"PAH",20,1,187,0)="       DIDTC to %DTC "
^DIC(9.4,13,22,7,"PAH",20,1,188,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,189,0)="       Example: ZL DIDT ZS %DT "
^DIC(9.4,13,22,7,"PAH",20,1,190,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,191,0)="     10. Open M sites: Rename: "
^DIC(9.4,13,22,7,"PAH",20,1,192,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,193,0)="       DIDT to %DT "
^DIC(9.4,13,22,7,"PAH",20,1,194,0)="       DIDTC to %DTC "
^DIC(9.4,13,22,7,"PAH",20,1,195,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,196,0)="       Example: ZL DIDT ZS %DT "
^DIC(9.4,13,22,7,"PAH",20,1,197,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,198,0)="     11.  DSM Sites: Rebuild your mapped set if necessary.  "
^DIC(9.4,13,22,7,"PAH",20,1,199,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,200,0)="     12.  DO remove TaskMan from a WAIT state.  "
^DIC(9.4,13,22,7,"PAH",20,1,201,0)=" "
^DIC(9.4,13,22,7,"PAH",20,1,202,0)="     13.  Enable users' login.  "
^DIC(9.4,13,22,7,"PAH",21,0)="43 SEQ #39^2980318^1"
^DIC(9.4,13,22,7,"PAH",21,1,0)="^^72^72^2980318"
^DIC(9.4,13,22,7,"PAH",21,1,1,0)=" Description:"
^DIC(9.4,13,22,7,"PAH",21,1,2,0)=" ============"
^DIC(9.4,13,22,7,"PAH",21,1,3,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,4,0)="      This patch fixes a problem introduced by patch DI*21*29,"
^DIC(9.4,13,22,7,"PAH",21,1,5,0)="      an invalid subscript error that could occur when editing"
^DIC(9.4,13,22,7,"PAH",21,1,6,0)="      a long line of M code in an input template. This problem"
^DIC(9.4,13,22,7,"PAH",21,1,7,0)="      was reported as NOIS ISW-0497-21817."
^DIC(9.4,13,22,7,"PAH",21,1,8,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,9,0)=" Test Sites :"
^DIC(9.4,13,22,7,"PAH",21,1,10,0)=" ============"
^DIC(9.4,13,22,7,"PAH",21,1,11,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,12,0)="      Albany ISC"
^DIC(9.4,13,22,7,"PAH",21,1,13,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,14,0)=" Routine Summary :"
^DIC(9.4,13,22,7,"PAH",21,1,15,0)=" ================="
^DIC(9.4,13,22,7,"PAH",21,1,16,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,17,0)="      The following is a list of the routines included in this patch."
^DIC(9.4,13,22,7,"PAH",21,1,18,0)="      The second line of each of these routines now looks like:"
^DIC(9.4,13,22,7,"PAH",21,1,19,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,20,0)="      <tab>;;21.0;VA FileMan;**patch list**;Dec 28, 1994"
^DIC(9.4,13,22,7,"PAH",21,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,22,0)=" Checksums According to CHECK^XTSUMBLD:"
^DIC(9.4,13,22,7,"PAH",21,1,23,0)=" ======================================"
^DIC(9.4,13,22,7,"PAH",21,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,25,0)="   Rtn Nm   Chksum Before   Chksum After  Patch List"
^DIC(9.4,13,22,7,"PAH",21,1,26,0)="   ------   -------------   ------------  ----------"
^DIC(9.4,13,22,7,"PAH",21,1,27,0)="   DICF     7724491         7752413       29,43"
^DIC(9.4,13,22,7,"PAH",21,1,28,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,29,0)="      To test if the transport has been corrupted, you can use the"
^DIC(9.4,13,22,7,"PAH",21,1,30,0)="      ""Verify Package Integrity"" option.  This option is under Utilities"
^DIC(9.4,13,22,7,"PAH",21,1,31,0)="      under the KIDS menu.  It will compare the checksums in the build"
^DIC(9.4,13,22,7,"PAH",21,1,32,0)="      with the current checksums and list any that differ."
^DIC(9.4,13,22,7,"PAH",21,1,33,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,34,0)=" Installation Instructions:"
^DIC(9.4,13,22,7,"PAH",21,1,35,0)=" =========================="
^DIC(9.4,13,22,7,"PAH",21,1,36,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,37,0)=" NOTE any instructions that are different for 486 or Alpha sites."
^DIC(9.4,13,22,7,"PAH",21,1,38,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,39,0)="      1.   Users ARE NOT allowed to be on the system during the"
^DIC(9.4,13,22,7,"PAH",21,1,40,0)="      installation."
^DIC(9.4,13,22,7,"PAH",21,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,42,0)="      2.   DO place TaskMan in a WAIT state."
^DIC(9.4,13,22,7,"PAH",21,1,43,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,44,0)="      3.   This routine is not usually mapped on systems that allow"
^DIC(9.4,13,22,7,"PAH",21,1,45,0)="      it so you will probably not have to disable mapping."
^DIC(9.4,13,22,7,"PAH",21,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,47,0)="      4.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,13,22,7,"PAH",21,1,48,0)="      This option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",21,1,49,0)=" "
^DIC(9.4,13,22,7,"PAH",21,1,50,0)="      5.   The patch has now been loaded into a Transport global on your"
^DIC(9.4,13,22,7,"PAH",21,1,51,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,13,22,7,"PAH",21,1,52,0)="  "
^DIC(9.4,13,22,7,"PAH",21,1,53,0)="      6.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",21,1,54,0)="      following options:"
^DIC(9.4,13,22,7,"PAH",21,1,55,0)="  "
^DIC(9.4,13,22,7,"PAH",21,1,56,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,7,"PAH",21,1,57,0)="            Print Transport Global"
^DIC(9.4,13,22,7,"PAH",21,1,58,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,7,"PAH",21,1,59,0)="            Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",21,1,60,0)="            Install Package(s)"
^DIC(9.4,13,22,7,"PAH",21,1,61,0)="            INSTALL NAME: DI*21.0*43"
^DIC(9.4,13,22,7,"PAH",21,1,62,0)="                          =========="
^DIC(9.4,13,22,7,"PAH",21,1,63,0)="  "
^DIC(9.4,13,22,7,"PAH",21,1,64,0)="      7.   MSM Sites - Answer YES to the question 'Want to MOVE"
^DIC(9.4,13,22,7,"PAH",21,1,65,0)="      routines to other CPUs?'. Enter the names of your Compute and"
^DIC(9.4,13,22,7,"PAH",21,1,66,0)="      Print server(s)."
^DIC(9.4,13,22,7,"PAH",21,1,67,0)="  "
^DIC(9.4,13,22,7,"PAH",21,1,68,0)="           AXP Sites - Answer NO to this question."
^DIC(9.4,13,22,7,"PAH",21,1,69,0)="  "
^DIC(9.4,13,22,7,"PAH",21,1,70,0)="      8.   Rebuild your mapped set if necessary."
^DIC(9.4,13,22,7,"PAH",21,1,71,0)="  "
^DIC(9.4,13,22,7,"PAH",21,1,72,0)="      9.   DO remove TaskMan from a WAIT state."
^DIC(9.4,13,22,7,"PAH",22,0)="41 SEQ #40^2980318^1"
^DIC(9.4,13,22,7,"PAH",22,1,0)="^^253^253^2980318"
^DIC(9.4,13,22,7,"PAH",22,1,1,0)="Description:"
^DIC(9.4,13,22,7,"PAH",22,1,2,0)="============"
^DIC(9.4,13,22,7,"PAH",22,1,3,0)="     This patch contains critical bug fixes requested by package "
^DIC(9.4,13,22,7,"PAH",22,1,4,0)="     developers in need of the fixes for their own patches or "
^DIC(9.4,13,22,7,"PAH",22,1,5,0)="     package releases."
^DIC(9.4,13,22,7,"PAH",22,1,6,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,7,0)="     Compiled Routines"
^DIC(9.4,13,22,7,"PAH",22,1,8,0)="     -----------------"
^DIC(9.4,13,22,7,"PAH",22,1,9,0)="     1. Compiled Routines: problem uncompiling xrefs: DIPZ0 (for "
^DIC(9.4,13,22,7,"PAH",22,1,10,0)="     Mike Hendry). Mr. Hendry reported that uncompiling cross-"
^DIC(9.4,13,22,7,"PAH",22,1,11,0)="     references didn't work if the file had whole file-cross-"
^DIC(9.4,13,22,7,"PAH",22,1,12,0)="     references on one of its subfiles. Reported in NOIS ISL-0897-"
^DIC(9.4,13,22,7,"PAH",22,1,13,0)="     51962."
^DIC(9.4,13,22,7,"PAH",22,1,14,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,15,0)="     2. Compiled Routines: problem uncompiling input templates: "
^DIC(9.4,13,22,7,"PAH",22,1,16,0)="     DIEZ (for Cindy Heuer). Ms. Heuer reported that uncompiled "
^DIC(9.4,13,22,7,"PAH",22,1,17,0)="     input templates would recompile themselves when the "
^DIC(9.4,13,22,7,"PAH",22,1,18,0)="     definitions of fields within those templates were changed. "
^DIC(9.4,13,22,7,"PAH",22,1,19,0)="     Reported in FORUM msg # 23842872."
^DIC(9.4,13,22,7,"PAH",22,1,20,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,21,0)="     Reader"
^DIC(9.4,13,22,7,"PAH",22,1,22,0)="     ------"
^DIC(9.4,13,22,7,"PAH",22,1,23,0)="     3. Reader: case sensitivity with codes: DIR1 (for Marcia"
^DIC(9.4,13,22,7,"PAH",22,1,24,0)="     Insley). Ms. Insley reported that the Reader converted the"
^DIC(9.4,13,22,7,"PAH",22,1,25,0)="     case of the user's input for the external form of the codes,"
^DIC(9.4,13,22,7,"PAH",22,1,26,0)="     but not for the internal. Reported in Forum msg # 23931868."
^DIC(9.4,13,22,7,"PAH",22,1,27,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,28,0)="     4. Reader: list and range problems: DIR3 (for Gary Beuschel)."
^DIC(9.4,13,22,7,"PAH",22,1,29,0)="     Mr. Beuschel reported problem was that the Reader rejects"
^DIC(9.4,13,22,7,"PAH",22,1,30,0)="     lists that contain consecutive numbers out of order, such as"
^DIC(9.4,13,22,7,"PAH",22,1,31,0)="     50,49; I found that it also rejected a number followed by a"
^DIC(9.4,13,22,7,"PAH",22,1,32,0)="     range ending in that number, such as 50,40-50. Reported in"
^DIC(9.4,13,22,7,"PAH",22,1,33,0)="     ISC-SF msg #s 1190657, 1193613, and 1193773."
^DIC(9.4,13,22,7,"PAH",22,1,34,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,35,0)="     5. Reader: problems with help for dates: DIR, DIR2 (for Gary "
^DIC(9.4,13,22,7,"PAH",22,1,36,0)="     Beuschel). Mr. Beuschel reported that the help for dates is "
^DIC(9.4,13,22,7,"PAH",22,1,37,0)="     scanty compared to what the %DT utility provides. It has been "
^DIC(9.4,13,22,7,"PAH",22,1,38,0)="     brought in line with %DT's, and also made responsive to the "
^DIC(9.4,13,22,7,"PAH",22,1,39,0)="     date parameters passed in the second ^-piece of DIR(0). "
^DIC(9.4,13,22,7,"PAH",22,1,40,0)="     Reported by phone."
^DIC(9.4,13,22,7,"PAH",22,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,42,0)="     6. Reader: DIR(""PRE"") parameter: DIR (for Gary Beuschel). Mr."
^DIC(9.4,13,22,7,"PAH",22,1,43,0)="     Beuschel needed a programming hook to let him intercept the"
^DIC(9.4,13,22,7,"PAH",22,1,44,0)="     user's input before the Reader begins its data type"
^DIC(9.4,13,22,7,"PAH",22,1,45,0)="     validation. The new supported input parameter DIR(""PRE"") is a"
^DIC(9.4,13,22,7,"PAH",22,1,46,0)="     pre-validation transform that can either change X, in which"
^DIC(9.4,13,22,7,"PAH",22,1,47,0)="     case the Reader will proceed as though the new value is what"
^DIC(9.4,13,22,7,"PAH",22,1,48,0)="     the user entered, or can kill X, in which case the Reader will"
^DIC(9.4,13,22,7,"PAH",22,1,49,0)="     behave as though the user entered an illegal value. DIR(""PRE"")"
^DIC(9.4,13,22,7,"PAH",22,1,50,0)="     executes almost immediately after the READ takes place, just"
^DIC(9.4,13,22,7,"PAH",22,1,51,0)="     after DTOUT is set and before any other checking is done. The"
^DIC(9.4,13,22,7,"PAH",22,1,52,0)="     only inputs are X and DTOUT, and the only outputs are X and"
^DIC(9.4,13,22,7,"PAH",22,1,53,0)="     DTOUT. Reported in phone conversation with Mr. Beuschel."
^DIC(9.4,13,22,7,"PAH",22,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,55,0)="     Lookup"
^DIC(9.4,13,22,7,"PAH",22,1,56,0)="     ------"
^DIC(9.4,13,22,7,"PAH",22,1,57,0)="     7. Classic Lookup: echo & match lists: DIC1 (for Marcia "
^DIC(9.4,13,22,7,"PAH",22,1,58,0)="     Insley, Tana Defa, and Melissa Hughes). Ms. Insley reported "
^DIC(9.4,13,22,7,"PAH",22,1,59,0)="     during testing of CPRS that Puget Sound needed a change to how "
^DIC(9.4,13,22,7,"PAH",22,1,60,0)="     DIC's E flag works. The E flag, which normally ensures a "
^DIC(9.4,13,22,7,"PAH",22,1,61,0)="     user's response is echoed back, did not do so when the user "
^DIC(9.4,13,22,7,"PAH",22,1,62,0)="     picked from a match list, a time when typos are therefore "
^DIC(9.4,13,22,7,"PAH",22,1,63,0)="     difficult to notice but easy to make. This was changed to "
^DIC(9.4,13,22,7,"PAH",22,1,64,0)="     make E work with match list selections. Reported in Forum msg "
^DIC(9.4,13,22,7,"PAH",22,1,65,0)="     # 24573804."
^DIC(9.4,13,22,7,"PAH",22,1,66,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,67,0)="     8. Finder: `IEN lookup problem: DICF1 (for Gary Beuschel). Mr. "
^DIC(9.4,13,22,7,"PAH",22,1,68,0)="     Beuschel reported that the Finder's `IEN lookup is only "
^DIC(9.4,13,22,7,"PAH",22,1,69,0)="     allowing IENs that are integers, disallowing such IENs as the "
^DIC(9.4,13,22,7,"PAH",22,1,70,0)="     Postmaster's (.5). This was fixed. Reported in phone "
^DIC(9.4,13,22,7,"PAH",22,1,71,0)="     conversation with Mr. Beuschel."
^DIC(9.4,13,22,7,"PAH",22,1,72,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,73,0)="     9. Finder: illegal number error: DICF3 (for Bob Fuller). Mr. "
^DIC(9.4,13,22,7,"PAH",22,1,74,0)="     Fuller reported an illegal number error caused by the Finder's "
^DIC(9.4,13,22,7,"PAH",22,1,75,0)="     vulnerability to input that looks like an exponential. The "
^DIC(9.4,13,22,7,"PAH",22,1,76,0)="     Finder has been bullet-proofed. Reported in NOIS # BRX-0397-"
^DIC(9.4,13,22,7,"PAH",22,1,77,0)="     12605."
^DIC(9.4,13,22,7,"PAH",22,1,78,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,79,0)="     10. Finder & Lister: tolerate empty indexes: DICF2, DICF3, "
^DIC(9.4,13,22,7,"PAH",22,1,80,0)="     DICF5, DICL1 (for Rob Whelan, Deborah Gorman, Diane McCance, "
^DIC(9.4,13,22,7,"PAH",22,1,81,0)="     and Gary Beuschel). Reported in NOIS #s BHH-0897-41483 and "
^DIC(9.4,13,22,7,"PAH",22,1,82,0)="     CLE-0797-42276, and in phone conversations with Mr. Whelan and "
^DIC(9.4,13,22,7,"PAH",22,1,83,0)="     Mr. Beuschel. "
^DIC(9.4,13,22,7,"PAH",22,1,84,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,85,0)="     Enter & Edit"
^DIC(9.4,13,22,7,"PAH",22,1,86,0)="     ------------"
^DIC(9.4,13,22,7,"PAH",22,1,87,0)="     11. Filer: prevent variable problem: DIEFU (for Joel Ivey). "
^DIC(9.4,13,22,7,"PAH",22,1,88,0)="     Mr. Joel reported that during testing of Patient Merge, the "
^DIC(9.4,13,22,7,"PAH",22,1,89,0)="     Filer did not adequately protect its own variables from deeply "
^DIC(9.4,13,22,7,"PAH",22,1,90,0)="     recursive calls, playing havoc during Merge. This was fixed. "
^DIC(9.4,13,22,7,"PAH",22,1,91,0)="     Reported in phone conversation with Mr. Ivey."
^DIC(9.4,13,22,7,"PAH",22,1,92,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,93,0)="     12. Filer: allow deletion of top-level records: DIEF (for & by "
^DIC(9.4,13,22,7,"PAH",22,1,94,0)="     Danila Manapsal). Ms. Manapsal reported that the FileMan "
^DIC(9.4,13,22,7,"PAH",22,1,95,0)="     Components need the ability to delete records through the "
^DIC(9.4,13,22,7,"PAH",22,1,96,0)="     Filer. She corrected the Filer to allow this. Reported in "
^DIC(9.4,13,22,7,"PAH",22,1,97,0)="     phone conversation with Ms. Manapsal."
^DIC(9.4,13,22,7,"PAH",22,1,98,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,99,0)="     13. Updater: allow deletion of top-level records: DICA1 (for "
^DIC(9.4,13,22,7,"PAH",22,1,100,0)="     Danila Manapsal). This change is also for the FileMan "
^DIC(9.4,13,22,7,"PAH",22,1,101,0)="     Components."
^DIC(9.4,13,22,7,"PAH",22,1,102,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,103,0)="     14. Updater: allow deletion of fields: DICA1 (for Michael "
^DIC(9.4,13,22,7,"PAH",22,1,104,0)="     Ogi). Mr. Ogi reported that the Updater is needlessly blocking "
^DIC(9.4,13,22,7,"PAH",22,1,105,0)="     the ability to delete fields, something the Filer (which it "
^DIC(9.4,13,22,7,"PAH",22,1,106,0)="     calls) allows. This was changed. Reported in phone "
^DIC(9.4,13,22,7,"PAH",22,1,107,0)="     conversation with Mr. Ogi."
^DIC(9.4,13,22,7,"PAH",22,1,108,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,109,0)="     15. Updater: subentry problem: DICA1 (for Mike Kilmade). Mr. "
^DIC(9.4,13,22,7,"PAH",22,1,110,0)="     Kilmade reported during development of PCMM that the Updater "
^DIC(9.4,13,22,7,"PAH",22,1,111,0)="     was preventing deletion of subfile entries if the same FDA "
^DIC(9.4,13,22,7,"PAH",22,1,112,0)="     added another subentry. This was fixed. Reported in Forum msg "
^DIC(9.4,13,22,7,"PAH",22,1,113,0)="     # 19707244."
^DIC(9.4,13,22,7,"PAH",22,1,114,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,115,0)="     16. Updater: process LAYGO Finding nodes before Adding nodes: "
^DIC(9.4,13,22,7,"PAH",22,1,116,0)="     DICA2 (for Michael Ogi). Mr. Ogi reported during testing of "
^DIC(9.4,13,22,7,"PAH",22,1,117,0)="     the Udpater that a bug prevented it from processing FDA nodes "
^DIC(9.4,13,22,7,"PAH",22,1,118,0)="     in the order specified, which occasionally caused undefined "
^DIC(9.4,13,22,7,"PAH",22,1,119,0)="     errors. The documented order was reestablished. Reported in "
^DIC(9.4,13,22,7,"PAH",22,1,120,0)="     phone conversation with Mr. Ogi."
^DIC(9.4,13,22,7,"PAH",22,1,121,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,122,0)="     17. Updater: return 0 nodes for LAYGO Finding nodes: DICA (for "
^DIC(9.4,13,22,7,"PAH",22,1,123,0)="     Michael Ogi). Mr. Ogi reported during testing of the Updater "
^DIC(9.4,13,22,7,"PAH",22,1,124,0)="     that it was not returning 0 nodes for LAYGO Finding nodes as "
^DIC(9.4,13,22,7,"PAH",22,1,125,0)="     documented. The documented order was reestablished. Reported "
^DIC(9.4,13,22,7,"PAH",22,1,126,0)="     in phone conversation with Mr. Ogi."
^DIC(9.4,13,22,7,"PAH",22,1,127,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,128,0)="     18. Updater: stop errors with LAYGO Finding nodes: DICA1 (for "
^DIC(9.4,13,22,7,"PAH",22,1,129,0)="     Alan Chan). Mr. Chan reported that under some circumstances "
^DIC(9.4,13,22,7,"PAH",22,1,130,0)="     LAYGO Finding nodes were reporting errors instead of finding "
^DIC(9.4,13,22,7,"PAH",22,1,131,0)="     existing entries. The errors were stopped, and LAYGO Finding "
^DIC(9.4,13,22,7,"PAH",22,1,132,0)="     nodes now properly find existing entries. Reported in ISC-SF "
^DIC(9.4,13,22,7,"PAH",22,1,133,0)="     msg # 1170164."
^DIC(9.4,13,22,7,"PAH",22,1,134,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,135,0)="     19. Updater: stop multiple Updaters interference: DICA1 (for "
^DIC(9.4,13,22,7,"PAH",22,1,136,0)="     Travis Torres). Mr. Torres reported that Updaters running "
^DIC(9.4,13,22,7,"PAH",22,1,137,0)="     simultaneously in different processes on the same machine "
^DIC(9.4,13,22,7,"PAH",22,1,138,0)="     could occasionally process each other's FDAs. The code was "
^DIC(9.4,13,22,7,"PAH",22,1,139,0)="     changed to better segregate their data structures. Reported in "
^DIC(9.4,13,22,7,"PAH",22,1,140,0)="     phone conversation with Mr. Torres."
^DIC(9.4,13,22,7,"PAH",22,1,141,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,142,0)="     Output"
^DIC(9.4,13,22,7,"PAH",22,1,143,0)="     ------"
^DIC(9.4,13,22,7,"PAH",22,1,144,0)="     20. Sort: remove duplicates from prints: DIO0 (for David "
^DIC(9.4,13,22,7,"PAH",22,1,145,0)="     Alexander, John Harvey, Nancy Nagle, Dan Petit, Daniel "
^DIC(9.4,13,22,7,"PAH",22,1,146,0)="     Schramm, Ellen Zufall, Fil Beza). Many sites reported problems "
^DIC(9.4,13,22,7,"PAH",22,1,147,0)="     with prints in which mnemonic cross-reference entries in the B "
^DIC(9.4,13,22,7,"PAH",22,1,148,0)="     index were creating false positives in reports. Ms. Zufall and "
^DIC(9.4,13,22,7,"PAH",22,1,149,0)="     Mr. Beza identified the problem as introduced by patch "
^DIC(9.4,13,22,7,"PAH",22,1,150,0)="     DI*21*35, and Ms. Zufall fixed it. Reported in ISC-SF msg # "
^DIC(9.4,13,22,7,"PAH",22,1,151,0)="     1198710, FORUM msg #s 25464901 and 25149562, and NOIS #s SFC-"
^DIC(9.4,13,22,7,"PAH",22,1,152,0)="     0198-60115, TOP-0198-40108, & WBP-1297-21797."
^DIC(9.4,13,22,7,"PAH",22,1,153,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,154,0)="     21. Transfer: improve performance: DITR, and DITR1 (for Dave "
^DIC(9.4,13,22,7,"PAH",22,1,155,0)="     Bolduc). Mr. Bolduc reported slow performance on large "
^DIC(9.4,13,22,7,"PAH",22,1,156,0)="     transfers, and identified a fix to the problem that was "
^DIC(9.4,13,22,7,"PAH",22,1,157,0)="     gratefully accepted. Reported in NOIS # AIM-0797-N2065."
^DIC(9.4,13,22,7,"PAH",22,1,158,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,159,0)="     Special thanks go to Dave Alexander, whose keen eye for bugs"
^DIC(9.4,13,22,7,"PAH",22,1,160,0)="     saved the rest of the VA a lot of grief with this patch.  :)"
^DIC(9.4,13,22,7,"PAH",22,1,161,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,162,0)="Test Sites :"
^DIC(9.4,13,22,7,"PAH",22,1,163,0)="============"
^DIC(9.4,13,22,7,"PAH",22,1,164,0)="     AIM Center"
^DIC(9.4,13,22,7,"PAH",22,1,165,0)="     Boston VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,166,0)="     Bronx VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,167,0)="     Dublin VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,168,0)="     Huntington VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,169,0)="     Oklahoma City VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,170,0)="     Prescott VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,171,0)="     Puget Sound HCS"
^DIC(9.4,13,22,7,"PAH",22,1,172,0)="     San Francisco VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,173,0)="     Tuscaloosa VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,174,0)="     Washington VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,175,0)="     West Palm Beach VAMC"
^DIC(9.4,13,22,7,"PAH",22,1,176,0)="     Birmingham CIOFO"
^DIC(9.4,13,22,7,"PAH",22,1,177,0)="     Hines CIOFO"
^DIC(9.4,13,22,7,"PAH",22,1,178,0)="     Salt Lake City CIOFO"
^DIC(9.4,13,22,7,"PAH",22,1,179,0)="     San Francisco CIOFO"
^DIC(9.4,13,22,7,"PAH",22,1,180,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,181,0)="Routine Summary :"
^DIC(9.4,13,22,7,"PAH",22,1,182,0)="================="
^DIC(9.4,13,22,7,"PAH",22,1,183,0)="     The following is a list of the routines included in this"
^DIC(9.4,13,22,7,"PAH",22,1,184,0)="     patch."
^DIC(9.4,13,22,7,"PAH",22,1,185,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,186,0)="     The second line of each of these routines now looks like:"
^DIC(9.4,13,22,7,"PAH",22,1,187,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,188,0)="     <tab>;;21.0;VA FileMan;**patch list**;Dec 28, 1994"
^DIC(9.4,13,22,7,"PAH",22,1,189,0)=" "
^DIC(9.4,13,22,7,"PAH",22,1,190,0)="     (Checksums According to CHECK^XTSUMBLD)"
^DIC(9.4,13,22,7,"PAH",22,1,191,0)=" "
