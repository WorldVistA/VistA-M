^DIC(9.4,207,22,1,"PAH",1,1,39,0)=" HEARTLAND-EAST HCS"
^DIC(9.4,207,22,1,"PAH",1,1,40,0)=" PHILADELPHIA, PA"
^DIC(9.4,207,22,1,"PAH",1,1,41,0)=" SAN DIEGO, CA"
^DIC(9.4,207,22,1,"PAH",1,1,42,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,43,0)=" Installation Information:"
^DIC(9.4,207,22,1,"PAH",1,1,44,0)="=========================="
^DIC(9.4,207,22,1,"PAH",1,1,45,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,46,0)="VBEC*1*1 is being exported as part of the VBECS package release.  The "
^DIC(9.4,207,22,1,"PAH",1,1,47,0)="installation of VBEC*1*1 will be controlled by phase a phased release.  "
^DIC(9.4,207,22,1,"PAH",1,1,48,0)="An Implementation Manager will be assigned to your site and will contact "
^DIC(9.4,207,22,1,"PAH",1,1,49,0)="your POC for VBECS and will provide your site with the location of the "
^DIC(9.4,207,22,1,"PAH",1,1,50,0)="KIDS Host Files prior to your scheduled installation date. "
^DIC(9.4,207,22,1,"PAH",1,1,51,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,52,0)="Installation Sequence"
^DIC(9.4,207,22,1,"PAH",1,1,53,0)="====================="
^DIC(9.4,207,22,1,"PAH",1,1,54,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,55,0)="The patches listed below represent those that will be part of the "
^DIC(9.4,207,22,1,"PAH",1,1,56,0)="controlled phased release.  Follow the sequence listed below when your "
^DIC(9.4,207,22,1,"PAH",1,1,57,0)="phased installation occurs."
^DIC(9.4,207,22,1,"PAH",1,1,58,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,59,0)="  1. LR*5.2*335"
^DIC(9.4,207,22,1,"PAH",1,1,60,0)="  2. LR*5.2*367"
^DIC(9.4,207,22,1,"PAH",1,1,61,0)="  3. VBECS Bundle (consisting of VBEC*1*0 and LR*5.2*325)"
^DIC(9.4,207,22,1,"PAH",1,1,62,0)="  4. VBEC*1.0*1"
^DIC(9.4,207,22,1,"PAH",1,1,63,0)="  5. OR*3.0*212"
^DIC(9.4,207,22,1,"PAH",1,1,64,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,65,0)=" Installation File:"
^DIC(9.4,207,22,1,"PAH",1,1,66,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,67,0)="VBEC_1_1.KID "
^DIC(9.4,207,22,1,"PAH",1,1,68,0)="The VBEC_1_1.KID file will be made available by the Implementation "
^DIC(9.4,207,22,1,"PAH",1,1,69,0)="Manager prior to your site's implementation schedule along with "
^DIC(9.4,207,22,1,"PAH",1,1,70,0)="instruction to retrieve. "
^DIC(9.4,207,22,1,"PAH",1,1,71,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,72,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,73,0)="Documentation Retrieval:"
^DIC(9.4,207,22,1,"PAH",1,1,74,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,75,0)="Documentation is available for the entire VBECS package on the "
^DIC(9.4,207,22,1,"PAH",1,1,76,0)="ANONYMOUS.SOFTWRE directory at one of the following Office of Information "
^DIC(9.4,207,22,1,"PAH",1,1,77,0)="(OI) Field Offices.  Sites may retrieve documentation in either "".PDF"" or "
^DIC(9.4,207,22,1,"PAH",1,1,78,0)="""DOC"" format in one of the following ways:"
^DIC(9.4,207,22,1,"PAH",1,1,79,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,80,0)="1.      The preferred method is to FTP the files from :"
^DIC(9.4,207,22,1,"PAH",1,1,81,0)="Download.vista.domain.ext"
^DIC(9.4,207,22,1,"PAH",1,1,82,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,83,0)="2.      Sites may also elect to retrieve documentation directly from a "
^DIC(9.4,207,22,1,"PAH",1,1,84,0)="specific server as follows:"
^DIC(9.4,207,22,1,"PAH",1,1,85,0)="       Albany                  ftp.fo-albany.domain.ext"
^DIC(9.4,207,22,1,"PAH",1,1,86,0)="       Hines                   ftp.fo-hines.domain.ext"
^DIC(9.4,207,22,1,"PAH",1,1,87,0)="       Salt Lake City          ftp.fo-slc.domain.ext"
^DIC(9.4,207,22,1,"PAH",1,1,88,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,89,0)="NOTE:  The documentation files listed below will be listed in each of the "
^DIC(9.4,207,22,1,"PAH",1,1,90,0)="VBECS and LR patches that are part of the VBECS package and associate "
^DIC(9.4,207,22,1,"PAH",1,1,91,0)="patches, they only need to be downloaded once."
^DIC(9.4,207,22,1,"PAH",1,1,92,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,93,0)="File Name                                   Retrieval format:  Binary"
^DIC(9.4,207,22,1,"PAH",1,1,94,0)="===========                                 =========================="
