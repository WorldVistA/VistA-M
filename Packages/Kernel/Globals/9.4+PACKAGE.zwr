^DIC(9.4,14,22,5.9,"PAH",148,1,170,0)="END OF INSTALLATION EXAMPLE"
^DIC(9.4,14,22,5.9,"PAH",148,1,171,0)="=========================== "
^DIC(9.4,14,22,5.9,"PAH",149,0)="321 SEQ #247^3050212^1"
^DIC(9.4,14,22,5.9,"PAH",149,1,0)="^^8^8^3050212"
^DIC(9.4,14,22,5.9,"PAH",149,1,1,0)="This patch resolves a problem introduced with coding changes in the "
^DIC(9.4,14,22,5.9,"PAH",149,1,2,0)="routine LRMIBUG in patch LR*5.2*318 that causes an undefined variable "
^DIC(9.4,14,22,5.9,"PAH",149,1,3,0)="error. This error will occur when the user adds antibiotics to the list "
^DIC(9.4,14,22,5.9,"PAH",149,1,4,0)="of antibiotics in an ordered panel."
^DIC(9.4,14,22,5.9,"PAH",149,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",149,1,6,0)="This problem was reported in NOIS calls:"
^DIC(9.4,14,22,5.9,"PAH",149,1,7,0)=" BHS-1204-10061     $ZE= <UNDEFINED>DELINT+6~LRMIBUG"
^DIC(9.4,14,22,5.9,"PAH",149,1,8,0)=" ALT-1204-20766     UNDEFINED ERROR IN MICRO"
^DIC(9.4,14,22,5.9,"PAH",150,0)="303 SEQ #248^3050212^1"
^DIC(9.4,14,22,5.9,"PAH",150,1,0)="^^257^257^3050212"
^DIC(9.4,14,22,5.9,"PAH",150,1,1,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*303 does not"
^DIC(9.4,14,22,5.9,"PAH",150,1,2,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,14,22,5.9,"PAH",150,1,3,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",150,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,5,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*303 does not"
^DIC(9.4,14,22,5.9,"PAH",150,1,6,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",150,1,7,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",150,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,9,0)="RISK ANALYSIS: Changes made by patch LR*5.2*303 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",150,1,10,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",150,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,12,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes"
^DIC(9.4,14,22,5.9,"PAH",150,1,13,0)="made, no specific validation requirements exist as a result of installation"
^DIC(9.4,14,22,5.9,"PAH",150,1,14,0)="of this patch."
^DIC(9.4,14,22,5.9,"PAH",150,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,16,0)="The Laboratory package, in support of the VA Health Data Repository (HDR)"
^DIC(9.4,14,22,5.9,"PAH",150,1,17,0)="efforts, has developed the following reports to support VA Data"
^DIC(9.4,14,22,5.9,"PAH",150,1,18,0)="Standardization of laboratory results. These reports/extracts will"
^DIC(9.4,14,22,5.9,"PAH",150,1,19,0)="facilitate centralized mapping and data validation of National Laboratory"
^DIC(9.4,14,22,5.9,"PAH",150,1,20,0)="Test (NLT) and Logical Observation Identifiers Names and Codes (LOINC)"
^DIC(9.4,14,22,5.9,"PAH",150,1,21,0)="within VistA Laboratory."
^DIC(9.4,14,22,5.9,"PAH",150,1,22,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,23,0)="************************************************************************** "
^DIC(9.4,14,22,5.9,"PAH",150,1,24,0)="This patch must be installed within five days of receipt in order to"
^DIC(9.4,14,22,5.9,"PAH",150,1,25,0)="provide information to a centralized LOINC mapping team which will use"
^DIC(9.4,14,22,5.9,"PAH",150,1,26,0)="this information to provide recommended NLT and LOINC mappings for CH"
^DIC(9.4,14,22,5.9,"PAH",150,1,27,0)="subscript - chemistry, hematology, coagulation, urinalysis, serology type"
^DIC(9.4,14,22,5.9,"PAH",150,1,28,0)="results) used by each facility.  These recommendations will be sent back"
^DIC(9.4,14,22,5.9,"PAH",150,1,29,0)="to the facility for review and action. Installation of this patch is for"
^DIC(9.4,14,22,5.9,"PAH",150,1,30,0)="this reporting purpose only and has no effect on current laboratory"
^DIC(9.4,14,22,5.9,"PAH",150,1,31,0)="functionality."
^DIC(9.4,14,22,5.9,"PAH",150,1,32,0)="************************************************************************** "
^DIC(9.4,14,22,5.9,"PAH",150,1,33,0)=""
^DIC(9.4,14,22,5.9,"PAH",150,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,35,0)="1. These LRLABSERVER server reports are available with this patch:"
^DIC(9.4,14,22,5.9,"PAH",150,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,37,0)="LOCAL REPORT"
^DIC(9.4,14,22,5.9,"PAH",150,1,38,0)=" Send a message to: S.LRLABSERVER@domain name"
^DIC(9.4,14,22,5.9,"PAH",150,1,39,0)="           Subject:LOCAL REPORT"
^DIC(9.4,14,22,5.9,"PAH",150,1,40,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,41,0)="   The body of the message will be ignored.  This will scan the database"
^DIC(9.4,14,22,5.9,"PAH",150,1,42,0)="for mapped LOINC data and return the results to the person sending the"
^DIC(9.4,14,22,5.9,"PAH",150,1,43,0)="mail message request."
^DIC(9.4,14,22,5.9,"PAH",150,1,44,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,46,0)="LOCAL REPORT DELIMIT"
^DIC(9.4,14,22,5.9,"PAH",150,1,47,0)="  Send a message to: S.LRLABSERVER@domain name"
^DIC(9.4,14,22,5.9,"PAH",150,1,48,0)="            Subject: LOCAL REPORT DELIMIT"
^DIC(9.4,14,22,5.9,"PAH",150,1,49,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,50,0)="  The body of the message will be ignored. This will scan the database"
^DIC(9.4,14,22,5.9,"PAH",150,1,51,0)="for mapped NLT and LOINC data. Results are returned to the person sending"
^DIC(9.4,14,22,5.9,"PAH",150,1,52,0)="the mail message request. The extracted data is returned as an attached"
^DIC(9.4,14,22,5.9,"PAH",150,1,53,0)="file in a delimited format using the ""|"" character as the field delimiter."
^DIC(9.4,14,22,5.9,"PAH",150,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,55,0)="  Record legend for attached file: Station #-64 ien-61 ien-Time Aspect|NLT"
^DIC(9.4,14,22,5.9,"PAH",150,1,56,0)=" Code|NLT Name|Default LOINC Code|Default LOINC Name|Default Test|Time"
^DIC(9.4,14,22,5.9,"PAH",150,1,57,0)=" Aspect|Specimen|Data Location|Data Type|Input Transform|Units|Test Name|"
^DIC(9.4,14,22,5.9,"PAH",150,1,58,0)=" LOINC Code|LOINC Name|Reference Low|Reference High|Therapeutic Low|"
^DIC(9.4,14,22,5.9,"PAH",150,1,59,0)=" Therapeutic High|Subscript|Lab Section|"
^DIC(9.4,14,22,5.9,"PAH",150,1,60,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,61,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,62,0)="RELMA"
^DIC(9.4,14,22,5.9,"PAH",150,1,63,0)="  Send a message to: S.LRLABSERVER@domain name"
^DIC(9.4,14,22,5.9,"PAH",150,1,64,0)="            Subject: RELMA"
^DIC(9.4,14,22,5.9,"PAH",150,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,66,0)="  The body of the message will be ignored. This will scan the local site's"
^DIC(9.4,14,22,5.9,"PAH",150,1,67,0)="LABORATORY TEST file (#60) and ANTIMICROBIAL SUSCEPTIBILITY file (#62.06)"
^DIC(9.4,14,22,5.9,"PAH",150,1,68,0)="and extract data in a format for input into the Regenstrief LOINC Mapping"
^DIC(9.4,14,22,5.9,"PAH",150,1,69,0)="Assistant (RELMA) mapping tool. Results are returned to the person sending"
^DIC(9.4,14,22,5.9,"PAH",150,1,70,0)="the mail message request. The extracted data is returned as an attached"
^DIC(9.4,14,22,5.9,"PAH",150,1,71,0)="file in a delimited format using the ""|"" character as the field delimiter."
^DIC(9.4,14,22,5.9,"PAH",150,1,72,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,73,0)=" Record legend for attached file:  Station #-60 ien-Spec ien|TestName|Spec"
^DIC(9.4,14,22,5.9,"PAH",150,1,74,0)=" |Time Aspect|Units|LOINC|NLT #|Battery Code|Battery Description|Lab"
^DIC(9.4,14,22,5.9,"PAH",150,1,75,0)=" Section|Subscript|Comments|Data Type|Reference low|Reference high|"
^DIC(9.4,14,22,5.9,"PAH",150,1,76,0)=" Therapeutic low|Therapeutic high|"
^DIC(9.4,14,22,5.9,"PAH",150,1,77,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,79,0)="2. Lab server mail messages will be purged after successful completion of"
^DIC(9.4,14,22,5.9,"PAH",150,1,80,0)="the server request. Supported MailMan API ZAPSERV^XMXAPI will be called to"
^DIC(9.4,14,22,5.9,"PAH",150,1,81,0)="delete the message from POSTMASTER server basket S.LRLABSERVER."
^DIC(9.4,14,22,5.9,"PAH",150,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,83,0)=" "
