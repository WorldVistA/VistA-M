^DIC(9.4,48,22,5.28,"PAH",166,0)="227 SEQ #207^3001027^1"
^DIC(9.4,48,22,5.28,"PAH",166,1,0)="^^1^1^3001027"
^DIC(9.4,48,22,5.28,"PAH",166,1,1,0)="Encounter Date/Time Trans error 421 issues."
^DIC(9.4,48,22,5.28,"PAH",167,0)="224 SEQ #208^3001027^1"
^DIC(9.4,48,22,5.28,"PAH",168,0)="220 SEQ #209^3010103^1"
^DIC(9.4,48,22,5.28,"PAH",168,1,0)="^^1^1^3010103"
