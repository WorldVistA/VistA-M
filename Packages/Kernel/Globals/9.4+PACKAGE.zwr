^DIC(9.4,14,22,5.9,"PAH",281,1,142,0)="Software and Documentation Retrieval Information "
^DIC(9.4,14,22,5.9,"PAH",281,1,143,0)="=============================="
^DIC(9.4,14,22,5.9,"PAH",281,1,144,0)="VistA Laboratory patch LR*5.2*474 software is distributed by Host File,"
^DIC(9.4,14,22,5.9,"PAH",281,1,145,0)="along with LA*5.2*90.  "
^DIC(9.4,14,22,5.9,"PAH",281,1,146,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,147,0)="The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,14,22,5.9,"PAH",281,1,148,0)="This transmits the files from the first available server. Sites may "
^DIC(9.4,14,22,5.9,"PAH",281,1,149,0)="also elect to retrieve files directly from a specific server. "
^DIC(9.4,14,22,5.9,"PAH",281,1,150,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,151,0)="Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,14,22,5.9,"PAH",281,1,152,0)="Secure File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory"
^DIC(9.4,14,22,5.9,"PAH",281,1,153,0)="at the following OI Field Offices:"
^DIC(9.4,14,22,5.9,"PAH",281,1,154,0)="   "
^DIC(9.4,14,22,5.9,"PAH",281,1,155,0)="Albany:                 fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",281,1,156,0)="Hines:                  fo-hines.domain.ext    "
^DIC(9.4,14,22,5.9,"PAH",281,1,157,0)="Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",281,1,158,0)="                                   "
^DIC(9.4,14,22,5.9,"PAH",281,1,159,0)="File Name                   Contents               Retrieval Format "
^DIC(9.4,14,22,5.9,"PAH",281,1,160,0)="------------------          --------------------   ----------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,161,0)="LAB_MICRO_INTERFACE_        Host File containing   ASCII"
^DIC(9.4,14,22,5.9,"PAH",281,1,162,0)="RELEASE_1_0.KID             KIDS software distribution "
^DIC(9.4,14,22,5.9,"PAH",281,1,163,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,164,0)="LAB_MICRO_INTERFACE_RELEASE_1_0_DOCS.ZIP, which contains both .pdf and "
^DIC(9.4,14,22,5.9,"PAH",281,1,165,0)=".doc formatted file of the following documents. Retrieval format is "
^DIC(9.4,14,22,5.9,"PAH",281,1,166,0)="BINARY:"
^DIC(9.4,14,22,5.9,"PAH",281,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,168,0)="Lab Micro Interface Release 1.0 User Guide"
^DIC(9.4,14,22,5.9,"PAH",281,1,169,0)="Lab Micro Interface Release 1.0 Technical Manual and Security Guide     "
^DIC(9.4,14,22,5.9,"PAH",281,1,170,0)="Lab Micro Deployment, Installation, Back-Out, and Rollback "
^DIC(9.4,14,22,5.9,"PAH",281,1,171,0)="Guide           "
^DIC(9.4,14,22,5.9,"PAH",281,1,172,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,173,0)="The VistA Documentation Library (VDL) web site will also contain the "
^DIC(9.4,14,22,5.9,"PAH",281,1,174,0)="above referenced documents. This website is usually updated within 1-3"
^DIC(9.4,14,22,5.9,"PAH",281,1,175,0)="days of the patch release date. The VDL web address for Laboratory"
^DIC(9.4,14,22,5.9,"PAH",281,1,176,0)="Universal Interface user documentation is:"
^DIC(9.4,14,22,5.9,"PAH",281,1,177,0)="http://www.domain.ext/vdl/application.asp?appid=120"
^DIC(9.4,14,22,5.9,"PAH",281,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,179,0)="Note: These previously released documents contain configuration and"
^DIC(9.4,14,22,5.9,"PAH",281,1,180,0)="mapping information that is useful to the implementation of the Universal"
^DIC(9.4,14,22,5.9,"PAH",281,1,181,0)="Interface for Microbiology tests."
^DIC(9.4,14,22,5.9,"PAH",281,1,182,0)="------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,183,0)="LEDI IV Installation Guide     LAB_LEDI_IV_IG.PDF            binary"
^DIC(9.4,14,22,5.9,"PAH",281,1,184,0)="LEDI IV User Manual            LAB_LEDI_IV_UM.PDF            binary"
^DIC(9.4,14,22,5.9,"PAH",281,1,185,0)="LEDI IV Update AP/MICRO        LEDI_IV__AP__MICRO_           binary"
^DIC(9.4,14,22,5.9,"PAH",281,1,186,0)="Configuration Guide            CONFIGURATION_GUIDE.PDF       binary"
^DIC(9.4,14,22,5.9,"PAH",281,1,187,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,188,0)="     "
^DIC(9.4,14,22,5.9,"PAH",281,1,189,0)="Patch Installation:"
^DIC(9.4,14,22,5.9,"PAH",281,1,190,0)="-------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,192,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,193,0)="Pre/Post Installation Overview:"
^DIC(9.4,14,22,5.9,"PAH",281,1,194,0)="-------------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,195,0)="This patch, LR*5.2*474 is part of a combined build for the Laboratory "
^DIC(9.4,14,22,5.9,"PAH",281,1,196,0)="Microbiology Interface Enhancement patch."
^DIC(9.4,14,22,5.9,"PAH",281,1,197,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,198,0)="This patch install must be coordinated with the Laboratory ADPAC to "
^DIC(9.4,14,22,5.9,"PAH",281,1,199,0)="ensure that all Lab Interface related activities are halted."
^DIC(9.4,14,22,5.9,"PAH",281,1,200,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,201,0)="This installation will modify the Enter/verify data (auto instrument)"
^DIC(9.4,14,22,5.9,"PAH",281,1,202,0)="option for the Microbiology Universal Interface process by providing the"
^DIC(9.4,14,22,5.9,"PAH",281,1,203,0)="following release options:"
^DIC(9.4,14,22,5.9,"PAH",281,1,204,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,205,0)="Select RELEASE action: Edit (full)// ?"
^DIC(9.4,14,22,5.9,"PAH",281,1,206,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,207,0)="Entering 0 will abort review/release."
^DIC(9.4,14,22,5.9,"PAH",281,1,208,0)="Entering 1 will allow release 'as is' with no editing."
^DIC(9.4,14,22,5.9,"PAH",281,1,209,0)="Entering 2 will allow you to enter/edit comments then release."
^DIC(9.4,14,22,5.9,"PAH",281,1,210,0)="Entering 3 will allow you to enter full edit, similar to 'Results entry' "
^DIC(9.4,14,22,5.9,"PAH",281,1,211,0)="option."
^DIC(9.4,14,22,5.9,"PAH",281,1,212,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,213,0)="Selections 1-3 will allow editing of status and approved date/time."
^DIC(9.4,14,22,5.9,"PAH",281,1,214,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,215,0)="     Select one of the following:"
^DIC(9.4,14,22,5.9,"PAH",281,1,216,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,217,0)="          0         Quit"
^DIC(9.4,14,22,5.9,"PAH",281,1,218,0)="          1         Release"
^DIC(9.4,14,22,5.9,"PAH",281,1,219,0)="          2         Comments/Release"
^DIC(9.4,14,22,5.9,"PAH",281,1,220,0)="          3         Edit (full)"
^DIC(9.4,14,22,5.9,"PAH",281,1,221,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,223,0)="Pre-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",281,1,224,0)="------------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,225,0)="Ensure that all Lab Interface activity has been halted !!"
^DIC(9.4,14,22,5.9,"PAH",281,1,226,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,227,0)="This would include:"
^DIC(9.4,14,22,5.9,"PAH",281,1,228,0)="-Editing of an Auto Instrument file entry, "
^DIC(9.4,14,22,5.9,"PAH",281,1,229,0)="-Turn off the Auto Downloading process to prevent the building and "
^DIC(9.4,14,22,5.9,"PAH",281,1,230,0)="downloading "
^DIC(9.4,14,22,5.9,"PAH",281,1,231,0)="of a Load/Worklist to the Instrument Manager. "
^DIC(9.4,14,22,5.9,"PAH",281,1,232,0)="-Shut down all LA7UI logical links and any other HL7 process (HLZTCP or "
^DIC(9.4,14,22,5.9,"PAH",281,1,233,0)="HLLP processes) "
^DIC(9.4,14,22,5.9,"PAH",281,1,234,0)="to prevent the processing of result messages from the IM."
^DIC(9.4,14,22,5.9,"PAH",281,1,235,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,236,0)="This patch may be installed with users on the system as long as the above "
^DIC(9.4,14,22,5.9,"PAH",281,1,237,0)="process controls have been followed."
^DIC(9.4,14,22,5.9,"PAH",281,1,238,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,239,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,240,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",281,1,241,0)="--------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,242,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,14,22,5.9,"PAH",281,1,243,0)=" recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,14,22,5.9,"PAH",281,1,244,0)=" potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,14,22,5.9,"PAH",281,1,245,0)=" minutes to install."
^DIC(9.4,14,22,5.9,"PAH",281,1,246,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,247,0)="   "
^DIC(9.4,14,22,5.9,"PAH",281,1,248,0)="1.      DOWNLOAD HOST KIDS FILE "
^DIC(9.4,14,22,5.9,"PAH",281,1,249,0)="        ----------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,250,0)="        Download the KIDS file LAB_MICRO_INTERFACE_RELEASE_1_0.KID from "
^DIC(9.4,14,22,5.9,"PAH",281,1,251,0)="        the ANONYMOUS.SOFTWARE directory of Albany, Hines, or the Salt"
^DIC(9.4,14,22,5.9,"PAH",281,1,252,0)="        Lake OIFO to the appropriate directory on your system."
^DIC(9.4,14,22,5.9,"PAH",281,1,253,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,254,0)="2.      LOAD DISTRIBUTION "
^DIC(9.4,14,22,5.9,"PAH",281,1,255,0)="        -----------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,256,0)="        Use the 'LOAD A DISTRIBUTION' option on the KIDS "
^DIC(9.4,14,22,5.9,"PAH",281,1,257,0)="        INSTALLATION menu, and enter:  the directory onto which you "
^DIC(9.4,14,22,5.9,"PAH",281,1,258,0)="        have downloaded the host file, followed by "
^DIC(9.4,14,22,5.9,"PAH",281,1,259,0)="        LAB_MICRO_INTERFACE_RELEASE_1_0.KID, the host file name. "
^DIC(9.4,14,22,5.9,"PAH",281,1,260,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,261,0)="3.      START UP KIDS "
^DIC(9.4,14,22,5.9,"PAH",281,1,262,0)="        -------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,263,0)="        Start up the Kernel Installation and Distribution System Menu "
^DIC(9.4,14,22,5.9,"PAH",281,1,264,0)="        [XPD MAIN]:"
^DIC(9.4,14,22,5.9,"PAH",281,1,265,0)="        Edits and Distribution ...  "
^DIC(9.4,14,22,5.9,"PAH",281,1,266,0)="        Utilities ...  "
^DIC(9.4,14,22,5.9,"PAH",281,1,267,0)="        Installation ...  "
^DIC(9.4,14,22,5.9,"PAH",281,1,268,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,269,0)="        Select Kernel Installation & Distribution System Option: "
^DIC(9.4,14,22,5.9,"PAH",281,1,270,0)="        Installation "
^DIC(9.4,14,22,5.9,"PAH",281,1,271,0)="        -------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,272,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,273,0)="            Load a Distribution "
^DIC(9.4,14,22,5.9,"PAH",281,1,274,0)="            Print Transport Global "
^DIC(9.4,14,22,5.9,"PAH",281,1,275,0)="            Compare Transport Global to Current System "
^DIC(9.4,14,22,5.9,"PAH",281,1,276,0)="            Verify Checksums in Transport Global "
^DIC(9.4,14,22,5.9,"PAH",281,1,277,0)="            Install Package(s) "
^DIC(9.4,14,22,5.9,"PAH",281,1,278,0)="            Restart Install of Package(s) "
^DIC(9.4,14,22,5.9,"PAH",281,1,279,0)="            Unload a Distribution "
^DIC(9.4,14,22,5.9,"PAH",281,1,280,0)="            Backup a Transport Global "
^DIC(9.4,14,22,5.9,"PAH",281,1,281,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,282,0)="4.      Select Installation Option: "
^DIC(9.4,14,22,5.9,"PAH",281,1,283,0)="     ---------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,284,0)="   "
^DIC(9.4,14,22,5.9,"PAH",281,1,285,0)="   a.   Use the Load a Distribution and select Host File: "
^DIC(9.4,14,22,5.9,"PAH",281,1,286,0)="        LAB_MICRO_INTERFACE_RELEASE_1_0.KID"
^DIC(9.4,14,22,5.9,"PAH",281,1,287,0)="        b.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,14,22,5.9,"PAH",281,1,288,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,14,22,5.9,"PAH",281,1,289,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,14,22,5.9,"PAH",281,1,290,0)="        c.  Compare Transport Global to Current System - This option will"
^DIC(9.4,14,22,5.9,"PAH",281,1,291,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,14,22,5.9,"PAH",281,1,292,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,14,22,5.9,"PAH",281,1,293,0)="        (routines, DDs, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",281,1,294,0)="        d.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,14,22,5.9,"PAH",281,1,295,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,14,22,5.9,"PAH",281,1,296,0)="        transport global."
^DIC(9.4,14,22,5.9,"PAH",281,1,297,0)="     "
^DIC(9.4,14,22,5.9,"PAH",281,1,298,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,299,0)="5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",281,1,300,0)="    Install? NO//'     "
^DIC(9.4,14,22,5.9,"PAH",281,1,301,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",281,1,302,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,303,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,14,22,5.9,"PAH",281,1,304,0)="    NO//'"
^DIC(9.4,14,22,5.9,"PAH",281,1,305,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",281,1,306,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,307,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,14,22,5.9,"PAH",281,1,308,0)="    and Protocols? NO//' "
^DIC(9.4,14,22,5.9,"PAH",281,1,309,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",281,1,310,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,311,0)="8.  If prompted 'Delay Install (Minutes): (0 - 60): 0//' "
^DIC(9.4,14,22,5.9,"PAH",281,1,312,0)="    Respond: 0."
^DIC(9.4,14,22,5.9,"PAH",281,1,313,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,314,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,315,0)="Post-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",281,1,316,0)="-------------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,317,0)="ADPAC and Microbiology Tech instructions:"
^DIC(9.4,14,22,5.9,"PAH",281,1,318,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,319,0)="1.      After data has been received from the Data Innovations for an "
^DIC(9.4,14,22,5.9,"PAH",281,1,320,0)="automated Microbiology instrument, the releasing Microbiology Technologist"
^DIC(9.4,14,22,5.9,"PAH",281,1,321,0)="will be presented with the following options:"
^DIC(9.4,14,22,5.9,"PAH",281,1,322,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,323,0)="Select RELEASE action: Edit (full)// ?"
^DIC(9.4,14,22,5.9,"PAH",281,1,324,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,325,0)="Entering 0 will abort review/release."
^DIC(9.4,14,22,5.9,"PAH",281,1,326,0)="Entering 1 will allow release 'as is' with no editing."
^DIC(9.4,14,22,5.9,"PAH",281,1,327,0)="Entering 2 will allow you to enter/edit comments then release."
^DIC(9.4,14,22,5.9,"PAH",281,1,328,0)="Entering 3 will allow you to enter full edit, similar to 'Results entry' "
^DIC(9.4,14,22,5.9,"PAH",281,1,329,0)="option."
^DIC(9.4,14,22,5.9,"PAH",281,1,330,0)="Selections 1-3 will allow editing of status and approved date/time."
^DIC(9.4,14,22,5.9,"PAH",281,1,331,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,332,0)="     Select one of the following:"
^DIC(9.4,14,22,5.9,"PAH",281,1,333,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,334,0)="          0         Quit"
^DIC(9.4,14,22,5.9,"PAH",281,1,335,0)="          1         Release"
^DIC(9.4,14,22,5.9,"PAH",281,1,336,0)="          2         Comments/Release"
^DIC(9.4,14,22,5.9,"PAH",281,1,337,0)="          3         Edit (full)"
^DIC(9.4,14,22,5.9,"PAH",281,1,338,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,339,0)="Select RELEASE action: Edit (full)// 0  Quit"
^DIC(9.4,14,22,5.9,"PAH",281,1,340,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,341,0)="Do you want to PURGE these results? NO//"
^DIC(9.4,14,22,5.9,"PAH",281,1,342,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,343,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,344,0)="2.       A new parameter LR MI UI RELEASE DEFAULT is included with this "
^DIC(9.4,14,22,5.9,"PAH",281,1,345,0)="patch and it provides the VAMC site the ability to set the release default"
^DIC(9.4,14,22,5.9,"PAH",281,1,346,0)="at the package and user levels."
^DIC(9.4,14,22,5.9,"PAH",281,1,347,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,348,0)="Example configuration:"
^DIC(9.4,14,22,5.9,"PAH",281,1,349,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,350,0)="Select OE/RR interface parameters <TEST ACCOUNT> Option: Select Lab"
^DIC(9.4,14,22,5.9,"PAH",281,1,351,0)=" liaison menu <TEST ACCOUNT> Option: OE/RR interface parameters"
^DIC(9.4,14,22,5.9,"PAH",281,1,352,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,353,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,354,0)="   EH     Edit HOSPITAL SITE parameters"
^DIC(9.4,14,22,5.9,"PAH",281,1,355,0)="   AS     Edit a lab administration schedule"
^DIC(9.4,14,22,5.9,"PAH",281,1,356,0)="   IL     Inquire to a Lab administration schedule"
^DIC(9.4,14,22,5.9,"PAH",281,1,357,0)="   CC     Update CPRS Parameters ..."
^DIC(9.4,14,22,5.9,"PAH",281,1,358,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,359,0)="Select OE/RR interface parameters <TEST ACCOUNT> Option: CC Update CPRS"
^DIC(9.4,14,22,5.9,"PAH",281,1,360,0)="Parameters"
^DIC(9.4,14,22,5.9,"PAH",281,1,361,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,362,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,363,0)="   PA     Update CPRS with Lab order parameters"
^DIC(9.4,14,22,5.9,"PAH",281,1,364,0)="   SI     Update CPRS with Single Lab test"
^DIC(9.4,14,22,5.9,"PAH",281,1,365,0)="   UP     Update CPRS with all Lab test parameters"
^DIC(9.4,14,22,5.9,"PAH",281,1,366,0)="   DO     Domain Level Parameter Edit"
^DIC(9.4,14,22,5.9,"PAH",281,1,367,0)="   LO     Location Level Parameter Edit"
^DIC(9.4,14,22,5.9,"PAH",281,1,368,0)="   PP     Package Level Parameter Edit"
^DIC(9.4,14,22,5.9,"PAH",281,1,369,0)="   UL     Display Lab User Parameters"
^DIC(9.4,14,22,5.9,"PAH",281,1,370,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,371,0)="Select Update CPRS Parameters <TEST ACCOUNT> Option: PP Package Level "
^DIC(9.4,14,22,5.9,"PAH",281,1,372,0)="Parameter Edit"
^DIC(9.4,14,22,5.9,"PAH",281,1,373,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,374,0)="Lab Package Level Parameters for Package: LAB SERVICE"
^DIC(9.4,14,22,5.9,"PAH",281,1,375,0)="--------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",281,1,376,0)="Collect on Monday                                 YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,377,0)="Collect on Tuesday                                YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,378,0)="Collect on Wednesday                              YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,379,0)="Collect on Thursday                               YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,380,0)="Collect on Friday                                 YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,381,0)="Collect on Saturday                               YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,382,0)="Collect on Sunday                                 YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,383,0)="Lab Collects on Holidays                          YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,384,0)="Lab Collect Days Allowed in Future                7"
