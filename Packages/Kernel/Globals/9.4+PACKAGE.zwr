^DIC(9.4,4,22,1,"PAH",61,1,75,0)="^DD(3.9,0,""IX"",""AW"",3.914,2) = "
^DIC(9.4,4,22,1,"PAH",61,1,76,0)="^DD(3.9,0,""IX"",""B"",3.9,.01) = "
^DIC(9.4,4,22,1,"PAH",61,1,77,0)="^DD(3.9,0,""IX"",""C"",3.9,31) = "
^DIC(9.4,4,22,1,"PAH",61,1,78,0)="^DD(3.9,0,""IX"",""I"",3.9,9) =      <-- bogus!  This appears to be a precursor"
^DIC(9.4,4,22,1,"PAH",61,1,79,0)="                                     to the ""AI"" xref, and was never properly"
^DIC(9.4,4,22,1,"PAH",61,1,80,0)="                                     deleted."
