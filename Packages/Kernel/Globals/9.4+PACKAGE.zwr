^DIC(9.4,70,22,2,"PAH",18,1,374,0)="BAPI32.bas | 08-20-1997 | 17:50:44 | | 1899 | 3f2f8fe1"
^DIC(9.4,70,22,2,"PAH",18,1,375,0)="egcho.bas | 08-11-1997 | 11:03:44 | | 148 | 3dce23c9"
