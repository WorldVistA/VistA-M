^DIC(9.4,60,22,13,"PAH",584,1,862,0)="   Effective Date:                        |2) Fill Date: Sep 12, 2023"
^DIC(9.4,60,22,13,"PAH",584,1,863,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,864,0)="   Days Supply: 30                        |Days Supply: 30"
^DIC(9.4,60,22,13,"PAH",584,1,865,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,866,0)="   Quantity: 30                           |QTY (TAB): 30"
^DIC(9.4,60,22,13,"PAH",584,1,867,0)="   Dispense Unit:                         |"
^DIC(9.4,60,22,13,"PAH",584,1,868,0)="   Qty Qualifier: Original Quantity       |"
^DIC(9.4,60,22,13,"PAH",584,1,869,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,870,0)="   Refills: 11                            |3) Refills: 11"
^DIC(9.4,60,22,13,"PAH",584,1,871,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,872,0)="                                          |4) Routing: MAIL"
^DIC(9.4,60,22,13,"PAH",584,1,873,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,874,0)="                                          |5) Clinic: "
^DIC(9.4,60,22,13,"PAH",584,1,875,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,876,0)="   Provider: TESTONE,USER02               |6) Provider: TESTONE,USER02"
^DIC(9.4,60,22,13,"PAH",584,1,877,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,878,0)="                                          |7) Copies: 1"
^DIC(9.4,60,22,13,"PAH",584,1,879,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,880,0)="                                          |8) Remarks: "
^DIC(9.4,60,22,13,"PAH",584,1,881,0)="                                          | RENEWED FROM RX # 2297959"
^DIC(9.4,60,22,13,"PAH",584,1,882,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,883,0)="   eRx Received on 9/20/23@11:44 | Accepted by TESTONE,USER01 on 9/26/23@10:30    "
^DIC(9.4,60,22,13,"PAH",584,1,884,0)="  "
^DIC(9.4,60,22,13,"PAH",584,1,885,0)="19.Ticket INC28342622  - PSOERXR1 - DEA # display"
^DIC(9.4,60,22,13,"PAH",584,1,886,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,887,0)="   After the release of patch PSO*7*545 it was reported that the VistA "
^DIC(9.4,60,22,13,"PAH",584,1,888,0)="   Provider DEA# was no long being displayed on the eRx Holding Queue Display"
^DIC(9.4,60,22,13,"PAH",584,1,889,0)="   screen. This addresses the problem."
^DIC(9.4,60,22,13,"PAH",584,1,890,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,891,0)="20.Ticket INC28554236 - Un-Accept/EC/HC Hold Issue"
^DIC(9.4,60,22,13,"PAH",584,1,892,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,893,0)="   It was reported that an eRx record was wrongly automatically being marked"
^DIC(9.4,60,22,13,"PAH",584,1,894,0)="   as PR (PROCESSED) after the user un-accepted an order from the Pending "
^DIC(9.4,60,22,13,"PAH",584,1,895,0)="   Queue back into the eRx Holding Queue and a placed a Change Request for it."
^DIC(9.4,60,22,13,"PAH",584,1,896,0)="   The PR status was assigned as soon as the user removed the eRx record from"
^DIC(9.4,60,22,13,"PAH",584,1,897,0)="   Hold."
^DIC(9.4,60,22,13,"PAH",585,0)="723 SEQ #612^3231215.132542^89"
^DIC(9.4,60,22,13,"PAH",585,1,0)="^^135^135^3231215"
^DIC(9.4,60,22,13,"PAH",585,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,60,22,13,"PAH",585,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,3,0)="ECDSA Key creation"
^DIC(9.4,60,22,13,"PAH",585,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",585,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,7,0)="1. INC26749697 - ECDSA KEY CREATION"
^DIC(9.4,60,22,13,"PAH",585,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,9,0)="Patch Components:"
^DIC(9.4,60,22,13,"PAH",585,1,10,0)="-----------------"
^DIC(9.4,60,22,13,"PAH",585,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,12,0)="Files & Fields Associated:"
^DIC(9.4,60,22,13,"PAH",585,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,14,0)="File Name (Number)         Field Name (Number)        New/Modified/Deleted"
^DIC(9.4,60,22,13,"PAH",585,1,15,0)="------------------         -------------------        --------------------"
^DIC(9.4,60,22,13,"PAH",585,1,16,0)="SPMP STATE PARAMETERS      SFTP SSH KEY ENCRYPTION    Modified"
^DIC(9.4,60,22,13,"PAH",585,1,17,0)="(#58.41)                   (#19)                    "
^DIC(9.4,60,22,13,"PAH",585,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,19,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",585,1,20,0)="--------"
^DIC(9.4,60,22,13,"PAH",585,1,21,0)="With the implementation of Red Hat Enterprise Linux (RHEL 8) stronger "
^DIC(9.4,60,22,13,"PAH",585,1,22,0)="encryption keys ECDSA & EDDSA are now available and supported. SPMP "
^DIC(9.4,60,22,13,"PAH",585,1,23,0)="application currently is using RSA type SSH key for connecting to the "
^DIC(9.4,60,22,13,"PAH",585,1,24,0)="SPMP server to send data. "
^DIC(9.4,60,22,13,"PAH",585,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,26,0)="New keys added:"
^DIC(9.4,60,22,13,"PAH",585,1,27,0)="Elliptic Curve Digital Signature Algorithm (ECDSA)"
^DIC(9.4,60,22,13,"PAH",585,1,28,0)="Edward-curve Digital Signature Algorithm (ed25519)"
^DIC(9.4,60,22,13,"PAH",585,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,30,0)="EDDSA is also known as ed25519 "
^DIC(9.4,60,22,13,"PAH",585,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,32,0)="Necessary changes are required to allow creation of ECDSA & EDDSA keys "
^DIC(9.4,60,22,13,"PAH",585,1,33,0)="for the SPMP application. Support for RSA keys are anticipated to be "
^DIC(9.4,60,22,13,"PAH",585,1,34,0)="deprecated in the future, so to maintain Vista's security posture and "
^DIC(9.4,60,22,13,"PAH",585,1,35,0)="ensure continuous operation of required Vista processes, software "
^DIC(9.4,60,22,13,"PAH",585,1,36,0)="utilizing SSH PKI user keys must be updated to support the stronger ECDSA "
^DIC(9.4,60,22,13,"PAH",585,1,37,0)="& EDDSA encryption keys. "
^DIC(9.4,60,22,13,"PAH",585,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,39,0)="The modification should allow the creation of any ECDSA & EDDSA keys to "
^DIC(9.4,60,22,13,"PAH",585,1,40,0)="be "
^DIC(9.4,60,22,13,"PAH",585,1,41,0)="forward compatible when Red Hat Enterprise Linux (RHEL 8) is implemented."
^DIC(9.4,60,22,13,"PAH",585,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,43,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",585,1,44,0)="-----------"
^DIC(9.4,60,22,13,"PAH",585,1,45,0)="File SPMP STATE PARAMETERS (#58.41) field SFTP SSH KEY ENCRYPTION (#19) is"
^DIC(9.4,60,22,13,"PAH",585,1,46,0)="modified to add code ECDSA (Elliptic Curve Digital Signature Algorithm) & "
^DIC(9.4,60,22,13,"PAH",585,1,47,0)="EDDSA (Edward-curve Digital Signature Algorithm)."
^DIC(9.4,60,22,13,"PAH",585,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,49,0)="Modify PSOSPMKY to allow ECDSA or EDDSA (ed25519) key to be created,"
^DIC(9.4,60,22,13,"PAH",585,1,50,0)="viewed, deleted, and update the help text."
^DIC(9.4,60,22,13,"PAH",585,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,53,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",585,1,54,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",585,1,55,0)="Add Code ECDSA (Elliptic Curve Digital Signature Algorithm) & EDDSA "
^DIC(9.4,60,22,13,"PAH",585,1,56,0)="(Edward-curve Digital Signature Algorithm) to the set of codes for field "
^DIC(9.4,60,22,13,"PAH",585,1,57,0)="#19 in file #58.41"
^DIC(9.4,60,22,13,"PAH",585,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,59,0)="Routine PSOSPMKY is modified as follows"
^DIC(9.4,60,22,13,"PAH",585,1,60,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,61,0)="ACTION+24 is changed from"
^DIC(9.4,60,22,13,"PAH",585,1,62,0)="  . S DIR(0)=""S^DSA:Digital Signature Algorithm (DSA);RSA:Rivest, Shamir "
^DIC(9.4,60,22,13,"PAH",585,1,63,0)="& Adleman (RSA)"""
^DIC(9.4,60,22,13,"PAH",585,1,64,0)="To"
^DIC(9.4,60,22,13,"PAH",585,1,65,0)="  . S DIR(0)=""S^RSA:Rivest, Shamir & Adleman (RSA);DSA:Digital Signature "
^DIC(9.4,60,22,13,"PAH",585,1,66,0)="Algorithm (DSA);ECDSA:Elliptic Curve Digital Signature Algorithm "
^DIC(9.4,60,22,13,"PAH",585,1,67,0)="(ECDSA);EDDSA:Edward-curve Digital Signature Algorithm (ed25519)"" ;p723"
^DIC(9.4,60,22,13,"PAH",585,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,69,0)="ACTION+26 changed from"
^DIC(9.4,60,22,13,"PAH",585,1,70,0)="  .S ENCRTYPE=Y"
^DIC(9.4,60,22,13,"PAH",585,1,71,0)="To"
^DIC(9.4,60,22,13,"PAH",585,1,72,0)=" .S ENCRTYPE=Y I Y=""DSA"" D  Q"
^DIC(9.4,60,22,13,"PAH",585,1,73,0)=" .. W !!,$G(IOBON),""WARNING:"",$G(IOBOFF),"" 'DSA' SSH keys are no longer "
^DIC(9.4,60,22,13,"PAH",585,1,74,0)="supported."",$C(7)  "
^DIC(9.4,60,22,13,"PAH",585,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,76,0)="NEWKEY+9 is changed from"
^DIC(9.4,60,22,13,"PAH",585,1,77,0)="  I $G(ENCRTYPE)'=""DSA"",$G(ENCRTYPE)'=""RSA"" S ENCRTYPE=""RSA"""
^DIC(9.4,60,22,13,"PAH",585,1,78,0)="To"
^DIC(9.4,60,22,13,"PAH",585,1,79,0)="   S "
^DIC(9.4,60,22,13,"PAH",585,1,80,0)="ENCRTYPE=$S($G(ENCRTYPE)=""ECDSA"":""ECDSA"",$G(ENCRTYPE)=""EDDSA"":""ed25519"",1:"
^DIC(9.4,60,22,13,"PAH",585,1,81,0)="""RSA"")"
^DIC(9.4,60,22,13,"PAH",585,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,83,0)="NEWKEY+63 is changed from"
^DIC(9.4,60,22,13,"PAH",585,1,84,0)="  S DR=""18///""_$S(PSOOS[""VMS"":""SSH2"",1:""OSSH"")_"";19///""_ENCRTYPE D ^DIE"
^DIC(9.4,60,22,13,"PAH",585,1,85,0)="To "
^DIC(9.4,60,22,13,"PAH",585,1,86,0)="  S DR=""18///""_$S(PSOOS[""VMS"":""SSH2"",1:""OSSH"")_"";19////""_ENCRTYPE D ^DIE"
^DIC(9.4,60,22,13,"PAH",585,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,88,0)="The Help text is change to:"
^DIC(9.4,60,22,13,"PAH",585,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,90,0)="Secure SHell (SSH) Encryption Keys are used to automate the data "
^DIC(9.4,60,22,13,"PAH",585,1,91,0)="transmission"
^DIC(9.4,60,22,13,"PAH",585,1,92,0)="to the State Prescription Monitoring Programs (SPMPs). Follow the steps "
^DIC(9.4,60,22,13,"PAH",585,1,93,0)="below"
^DIC(9.4,60,22,13,"PAH",585,1,94,0)="to successfully setup SPMP transmissions from VistA to the state/vendor "
^DIC(9.4,60,22,13,"PAH",585,1,95,0)="server:"
^DIC(9.4,60,22,13,"PAH",585,1,96,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,97,0)="Step 1: Select the 'N' (Create New SSH Key Pair) Action and follow the "
^DIC(9.4,60,22,13,"PAH",585,1,98,0)="prompts"
^DIC(9.4,60,22,13,"PAH",585,1,99,0)="        to create a new pair of SSH keys. If you already have an existing "
^DIC(9.4,60,22,13,"PAH",585,1,100,0)="SSH"
^DIC(9.4,60,22,13,"PAH",585,1,101,0)="        Key Pair you can skip this step. You can check whether you already"
^DIC(9.4,60,22,13,"PAH",585,1,102,0)="        have an existing SSH Key Pair through the 'V' (View Public SSH "
^DIC(9.4,60,22,13,"PAH",585,1,103,0)="Key)"
^DIC(9.4,60,22,13,"PAH",585,1,104,0)="        Action."
^DIC(9.4,60,22,13,"PAH",585,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,106,0)="        Encryption Type: DSA, RSA, ECDSA or EDDSA?"
^DIC(9.4,60,22,13,"PAH",585,1,107,0)="        -----------------------------------"
^DIC(9.4,60,22,13,"PAH",585,1,108,0)="        Digital Signature Algorithm (DSA) (No longer supported) and "
^DIC(9.4,60,22,13,"PAH",585,1,109,0)="Rivest,"
^DIC(9.4,60,22,13,"PAH",585,1,110,0)="        Shamir & Adleman (RSA) have been two of the most common encryption"
^DIC(9.4,60,22,13,"PAH",585,1,111,0)="        algorithms used by the IT industry for securely sharing data. "
^DIC(9.4,60,22,13,"PAH",585,1,112,0)="        Elliptic Curve Digital Signature Algorithm (ECDSA) and "
^DIC(9.4,60,22,13,"PAH",585,1,113,0)="Edward-curve"
^DIC(9.4,60,22,13,"PAH",585,1,114,0)="        Digital Signature Algorithm (ed25519) are more complex public key"
^DIC(9.4,60,22,13,"PAH",585,1,115,0)="        cryptography encryption algorithms that are now supported by the "
^DIC(9.4,60,22,13,"PAH",585,1,116,0)="VA."
^DIC(9.4,60,22,13,"PAH",585,1,117,0)="        Many of SPMP servers can handle all types; however there are "
^DIC(9.4,60,22,13,"PAH",585,1,118,0)="vendors"
^DIC(9.4,60,22,13,"PAH",585,1,119,0)="        that accept only one specific type. You will need to contact the "
^DIC(9.4,60,22,13,"PAH",585,1,120,0)="SPMP"
^DIC(9.4,60,22,13,"PAH",585,1,121,0)="        vendor support to determine which type to select."
^DIC(9.4,60,22,13,"PAH",585,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",585,1,123,0)="Step 2: Share the Public SSH Key content with the state/vendor. In order "
^DIC(9.4,60,22,13,"PAH",585,1,124,0)="to"
^DIC(9.4,60,22,13,"PAH",585,1,125,0)="        successfully establish SPMP transmissions the state/vendor will "
^DIC(9.4,60,22,13,"PAH",585,1,126,0)="have"
^DIC(9.4,60,22,13,"PAH",585,1,127,0)="        to install/configure the new SSH Key created in step 1 for the"
^DIC(9.4,60,22,13,"PAH",585,1,128,0)="        user id they assigned to your site. Use the 'V' (View Public SSH "
^DIC(9.4,60,22,13,"PAH",585,1,129,0)="Key)"
^DIC(9.4,60,22,13,"PAH",585,1,130,0)="        Action to retrieve the content of the Public SSH key. The Public "
^DIC(9.4,60,22,13,"PAH",585,1,131,0)="SSH"
^DIC(9.4,60,22,13,"PAH",585,1,132,0)="        Key should not contain line-feed characters, therefore after you "
^DIC(9.4,60,22,13,"PAH",585,1,133,0)="copy"
^DIC(9.4,60,22,13,"PAH",585,1,134,0)="        & paste it from the terminal emulator into an email or text editor"
^DIC(9.4,60,22,13,"PAH",585,1,135,0)="        make sure it contains only one line of text (no wrapping)."
^DIC(9.4,60,22,13,"PAH",586,0)="729 SEQ #613^3240125.114815^89"
^DIC(9.4,60,22,13,"PAH",586,1,0)="^^111^111^3240125"
^DIC(9.4,60,22,13,"PAH",586,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,60,22,13,"PAH",586,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,3,0)="INCORRECT DRUG LINKED IN AUTOMATED DISPENSING SYSTEM FROM ONEVA"
^DIC(9.4,60,22,13,"PAH",586,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",586,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,8,0)="1. INC27427008 - INCORRECT DRUG LINKED IN AUTOMATED DISPENSING "
^DIC(9.4,60,22,13,"PAH",586,1,9,0)="                 SYSTEM FROM ONEVA"
^DIC(9.4,60,22,13,"PAH",586,1,10,0)=" Duplicate: INC26949869"
^DIC(9.4,60,22,13,"PAH",586,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,13,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",586,1,14,0)="--------"
^DIC(9.4,60,22,13,"PAH",586,1,15,0)="The original reported issue was that the drug matching logic "
^DIC(9.4,60,22,13,"PAH",586,1,16,0)="forced an incorrect drug selection. The OneVA Rx sent dose for Nasal "
^DIC(9.4,60,22,13,"PAH",586,1,17,0)="Spray. The pharmacist inadvertently accepted the bad drug with dose form"
^DIC(9.4,60,22,13,"PAH",586,1,18,0)="tablet, likely because it was the only choice offered."
^DIC(9.4,60,22,13,"PAH",586,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,21,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",586,1,22,0)="-----------"
^DIC(9.4,60,22,13,"PAH",586,1,23,0)="This patch will enhance the drug lookup logic. The pharmacist will be "
^DIC(9.4,60,22,13,"PAH",586,1,24,0)="presented with local Drug file lookup. Routine PSORRX1 is modified "
^DIC(9.4,60,22,13,"PAH",586,1,25,0)="to mostly rewrite the DRUGMTCH subroutine."
^DIC(9.4,60,22,13,"PAH",586,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,28,0)="Here is a list of requirements that are requested"
^DIC(9.4,60,22,13,"PAH",586,1,29,0)="  1. If VA Product Identifier is received from HDR, the user is "
^DIC(9.4,60,22,13,"PAH",586,1,30,0)="     presented with the message:"
^DIC(9.4,60,22,13,"PAH",586,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,32,0)="     Remote site VA PRODUCT IDENTIFIER: VA Product Identifier *** NOT"
^DIC(9.4,60,22,13,"PAH",586,1,33,0)="     FOUND ***"""
^DIC(9.4,60,22,13,"PAH",586,1,34,0)="  2.  The VA Product Identifier that is returned from the HDR for then"
^DIC(9.4,60,22,13,"PAH",586,1,35,0)="     host site drug item is used to identify the VA Product that the host"
^DIC(9.4,60,22,13,"PAH",586,1,36,0)="     site drug is matched to. If the VA PRODUCT ID matches a product in  "
^DIC(9.4,60,22,13,"PAH",586,1,37,0)="     file VA PRODUCT (#50.68) that is marked as a controlled substance in"
^DIC(9.4,60,22,13,"PAH",586,1,38,0)="     field CS FEDERAL SCHEDULE (#19) (1-5), a message indicates that"
^DIC(9.4,60,22,13,"PAH",586,1,39,0)="     Controlled substances are not allowed for ONEVA dispensing, and"
^DIC(9.4,60,22,13,"PAH",586,1,40,0)="     processing stops."
^DIC(9.4,60,22,13,"PAH",586,1,41,0)="  3. If there is a single drug match using the Drug name returned from "
^DIC(9.4,60,22,13,"PAH",586,1,42,0)="     HDR and the VA PRODUCT ID, that is active, for outpatient use,"
^DIC(9.4,60,22,13,"PAH",586,1,43,0)="     associated with a Pharmacy Orderable Item, and and not a "
^DIC(9.4,60,22,13,"PAH",586,1,44,0)="     controlled substance in file #50, it is presented to the"
^DIC(9.4,60,22,13,"PAH",586,1,45,0)="     user, with the prompt, 'Would you like to use the system matched drug"
^DIC(9.4,60,22,13,"PAH",586,1,46,0)="     for this refill/partial fill? NO//' If the drug presented is not"
^DIC(9.4,60,22,13,"PAH",586,1,47,0)="     accepted or there was more than one drug found that was a match,"
^DIC(9.4,60,22,13,"PAH",586,1,48,0)="     processing will continue to step 3."
^DIC(9.4,60,22,13,"PAH",586,1,49,0)="  4. Next through the ""APR"" cross-reference in the Drug File which is on "
^DIC(9.4,60,22,13,"PAH",586,1,50,0)="     the PSNDF VA PRODUCT NAME ENTRY Field (#22) is used to find all drug"
^DIC(9.4,60,22,13,"PAH",586,1,51,0)="     entries at the dispensing site that are matched to the same VA"
^DIC(9.4,60,22,13,"PAH",586,1,52,0)="     Product as the host site drug selected for OneVA processing. "
^DIC(9.4,60,22,13,"PAH",586,1,53,0)="     Eliminate any that are inactive, not marked for outpatient use, does"
^DIC(9.4,60,22,13,"PAH",586,1,54,0)="     not have a Pharmacy Orderable Item or is a controlled substance in "
^DIC(9.4,60,22,13,"PAH",586,1,55,0)="     file #50. Present the drugs and prompt the user to 'Select "
^DIC(9.4,60,22,13,"PAH",586,1,56,0)="     drug from list (#-#) or <enter> to make a new selection:'"
^DIC(9.4,60,22,13,"PAH",586,1,57,0)="  5. If no matching drug could be located, a drug wasn't selected or "
^DIC(9.4,60,22,13,"PAH",586,1,58,0)="     no drugs were found, the user is presented the message:"
^DIC(9.4,60,22,13,"PAH",586,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,60,0)="         No other local match could be found for  DRUG NAME"
^DIC(9.4,60,22,13,"PAH",586,1,61,0)="         You may need to update your Drug file to process this order"""
^DIC(9.4,60,22,13,"PAH",586,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,63,0)="         Type <Enter> to continue or '^' to exit:"
^DIC(9.4,60,22,13,"PAH",586,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,65,0)="     NOTE: If no VA Product Identifier is received from HDR this message"
^DIC(9.4,60,22,13,"PAH",586,1,66,0)="           will display after the message in step 1."
^DIC(9.4,60,22,13,"PAH",586,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,69,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,70,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",586,1,71,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",586,1,72,0)="Routine PSORRX1 is modified to mostly rewrite the DRUGMTCH subroutine."
^DIC(9.4,60,22,13,"PAH",586,1,73,0)="Here is how the logic will function after the patch: "
^DIC(9.4,60,22,13,"PAH",586,1,74,0)="  - Look for VAPID in ^PSNDF(50.68,""C"" index and "
^DIC(9.4,60,22,13,"PAH",586,1,75,0)="    S VAPIEN=$O(^PSNDF(50.68,""C"",VAPID,0))"
^DIC(9.4,60,22,13,"PAH",586,1,76,0)="  - Check if the product found in file 50.68 is for a controlled "
^DIC(9.4,60,22,13,"PAH",586,1,77,0)="    substance. Using field CS FEDERAL SCHEDULE (#19). If the field"
^DIC(9.4,60,22,13,"PAH",586,1,78,0)="    contains any value less then 6 and greater than 0, display message"
^DIC(9.4,60,22,13,"PAH",586,1,79,0)="    and quit:"
^DIC(9.4,60,22,13,"PAH",586,1,80,0)="    S CSSCH=$$GET1^DIQ(50.68,VAPIEN,19,""I"")"
^DIC(9.4,60,22,13,"PAH",586,1,81,0)="    I +CSSCH>0,+CSSCH<6 D  Q 0"
^DIC(9.4,60,22,13,"PAH",586,1,82,0)="    . W !!,""Controlled substances are not allowed for ONEVA dispensing."",!"
^DIC(9.4,60,22,13,"PAH",586,1,83,0)="    . D PAUSE^VALM1"
^DIC(9.4,60,22,13,"PAH",586,1,84,0)="  - If the received VA PRODUCT ID is not found, display ""Remote site"
^DIC(9.4,60,22,13,"PAH",586,1,85,0)="    VA PRODUCT IDENTIFIER: xxxxxxx *** NOT FOUND ***"" (processing will"
^DIC(9.4,60,22,13,"PAH",586,1,86,0)="    quit out when VAPID not found after skipping over the )"
^DIC(9.4,60,22,13,"PAH",586,1,87,0)="  - Then use DRGNM and loop thru ^PSDRUG(""B"",DRGNM) and save"
^DIC(9.4,60,22,13,"PAH",586,1,88,0)="    any entries found into DRGARY(LDIEN) and increment counter DRLCNT.  "
^DIC(9.4,60,22,13,"PAH",586,1,89,0)="    filter out drugs that are inactive, not for outpatient, not "
^DIC(9.4,60,22,13,"PAH",586,1,90,0)="    associated with a Pharmacy Orderable Item, not linked to the VA"
^DIC(9.4,60,22,13,"PAH",586,1,91,0)="    Product ID, and is not a controlled in file #50."
^DIC(9.4,60,22,13,"PAH",586,1,92,0)="  - If only one product is found matching the above criteria, present "
^DIC(9.4,60,22,13,"PAH",586,1,93,0)="    it to the user with the prompt 'Would you like to use the system"
^DIC(9.4,60,22,13,"PAH",586,1,94,0)="    matched drug for this refill/partial fill? NO//'"
^DIC(9.4,60,22,13,"PAH",586,1,95,0)="  - If the user answers Yes processing ends by returning the product's "
^DIC(9.4,60,22,13,"PAH",586,1,96,0)="    IEN to the calling process."
^DIC(9.4,60,22,13,"PAH",586,1,97,0)=" "
^DIC(9.4,60,22,13,"PAH",586,1,98,0)="The following are only done when VAPIEN exists:"
^DIC(9.4,60,22,13,"PAH",586,1,99,0)="  - Loop thru the APR index of file 50 and filter out inactive, not for "
^DIC(9.4,60,22,13,"PAH",586,1,100,0)="    Outpatient, not linked to Pharmacy orderable item, & not a "
^DIC(9.4,60,22,13,"PAH",586,1,101,0)="    controlled substance in #50."
^DIC(9.4,60,22,13,"PAH",586,1,102,0)="    I '$D(DRGARY(LDIEN)) S DRGARY(LDIEN)="""",DRLCNT=DRLCNT+1"
^DIC(9.4,60,22,13,"PAH",586,1,103,0)="  - At this point if DRLCNT>0, I send all matched drugs in DRGARY "
^DIC(9.4,60,22,13,"PAH",586,1,104,0)="    (minus the drug already presented to the user) to ^DIR and prompt to"
^DIC(9.4,60,22,13,"PAH",586,1,105,0)="    Select Drug from list (#-#) or <enter> to make a new selection:   "
^DIC(9.4,60,22,13,"PAH",586,1,106,0)="  - If a drug is selected then ask, Would you like to use this drug?"
^DIC(9.4,60,22,13,"PAH",586,1,107,0)="    If the answer is Y, then that drug IEN is returned "
^DIC(9.4,60,22,13,"PAH",586,1,108,0)="  - If the user answers N or DRLCNT=0 after all the matching logic,"
^DIC(9.4,60,22,13,"PAH",586,1,109,0)="    call SELECT and prompt to 'Select Drug:' and do not offer any that are"
^DIC(9.4,60,22,13,"PAH",586,1,110,0)="    inactive, not for outpatient use, not associated with a Pharmacy "
^DIC(9.4,60,22,13,"PAH",586,1,111,0)="    Orderable Item or a controlled drug (DEA Schedules 2-5) in file #50."
^DIC(9.4,60,22,13,"PAH",587,0)="729b^3240129.123525^89"
^DIC(9.4,60,22,13,"PAH",587,1,0)="^^5^5^3240129"
^DIC(9.4,60,22,13,"PAH",587,1,1,0)="Backup of PSO*7.0*729 on Jan 25, 2024"
^DIC(9.4,60,22,13,"PAH",587,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",587,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,60,22,13,"PAH",587,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,60,22,13,"PAH",587,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,60,22,13,"PAH",588,0)="734 SEQ #614^3240221.101827^89"
^DIC(9.4,60,22,13,"PAH",588,1,0)="^^4^4^3240221"
^DIC(9.4,60,22,13,"PAH",588,1,1,0)="This patch addresses one issue:"
^DIC(9.4,60,22,13,"PAH",588,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",588,1,3,0)="When editing the drug on a prescription, the drug is not saved if more "
^DIC(9.4,60,22,13,"PAH",588,1,4,0)="than one prescription was specified at the start of the editing process."
^DIC(9.4,60,22,13,"PAH",589,0)="750 SEQ #615^3240304.10112^89"
^DIC(9.4,60,22,13,"PAH",589,1,0)="^^49^49^3240304"
^DIC(9.4,60,22,13,"PAH",589,1,1,0)="This patch is being released to address a few small eRx related issues"
^DIC(9.4,60,22,13,"PAH",589,1,2,0)="encountered after the patch PSO*7*700 was released:"
^DIC(9.4,60,22,13,"PAH",589,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",589,1,4,0)=" - eRx statuses CAH (CANCEL COMPLETED IN HOLDING QUEUE) and CAO (CANCEL"
^DIC(9.4,60,22,13,"PAH",589,1,5,0)="   PROCESS COMPLETE) not being treated as 'Actionable' in the new eRx Holding"
^DIC(9.4,60,22,13,"PAH",589,1,6,0)="   Queue Processing option [PSO ERX QUEUE PROCESSING]"
^DIC(9.4,60,22,13,"PAH",589,1,7,0)=" - Hidden Action RR (RxRenewal Request) under OTH disappeared"
^DIC(9.4,60,22,13,"PAH",589,1,8,0)=" - <UNDEFINED> error at VIDEO+4^PSOERUT0"
^DIC(9.4,60,22,13,"PAH",589,1,9,0)=" - CPRS ORDERING INSTITUTION prompt"
^DIC(9.4,60,22,13,"PAH",589,1,10,0)="  "
^DIC(9.4,60,22,13,"PAH",589,1,11,0)="1. eRx statuses CAH (CANCEL COMPLETED IN HOLDING QUEUE) and CAO (CANCEL"
^DIC(9.4,60,22,13,"PAH",589,1,12,0)="   PROCESS COMPLETE) not being treated as 'Actionable' in the new eRx Holding"
^DIC(9.4,60,22,13,"PAH",589,1,13,0)="   Queue Processing option [PSO ERX QUEUE PROCESSING]"
^DIC(9.4,60,22,13,"PAH",589,1,14,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",589,1,15,0)="   The new eRx Holding Queue Processing [PSO ERX QUEUE PROCESSING] option was"
^DIC(9.4,60,22,13,"PAH",589,1,16,0)="   not considering eRx records with the statuses CAH and CAO as actionable."
^DIC(9.4,60,22,13,"PAH",589,1,17,0)="   This caused patients not to be listed on the Patient Centric view when they"
^DIC(9.4,60,22,13,"PAH",589,1,18,0)="   only had these types of actionable records. This patch fixes this problem"
^DIC(9.4,60,22,13,"PAH",589,1,19,0)="   by treating CAH and CAO statuses as actionable."
^DIC(9.4,60,22,13,"PAH",589,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",589,1,21,0)="2. Hidden Action RR (RxRenewal Request) under OTH disappeared"
^DIC(9.4,60,22,13,"PAH",589,1,22,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",589,1,23,0)="   After the installation of PSO*7*700 the hidden action RR (RxRenewal"
^DIC(9.4,60,22,13,"PAH",589,1,24,0)="   Request) was unintentionally removed from the Other OP Action (OTH hidden"
^DIC(9.4,60,22,13,"PAH",589,1,25,0)="   action) when the user was viewing a single prescription in Backdoor "
^DIC(9.4,60,22,13,"PAH",589,1,26,0)="   Pharmacy (options PSO LM BACKDOOR ORDERS and PSO LMOE FINISH). This patch"
^DIC(9.4,60,22,13,"PAH",589,1,27,0)="   adds the RR hidden action back."
^DIC(9.4,60,22,13,"PAH",589,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",589,1,29,0)="3. <UNDEFINED> error at VIDEO+4^PSOERUT0"
^DIC(9.4,60,22,13,"PAH",589,1,30,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",589,1,31,0)="   An <UNDEFINED> was being recorded when the user ran the Complete Orders"
^DIC(9.4,60,22,13,"PAH",589,1,32,0)="   from OERR and selected NO at the prompt 'Do you want to see Medication"
^DIC(9.4,60,22,13,"PAH",589,1,33,0)="   Profile?' when there were patient with eRx pending orders to be finished."
^DIC(9.4,60,22,13,"PAH",589,1,34,0)="   This patch will fix this issue and the error will no longer happen."
^DIC(9.4,60,22,13,"PAH",589,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",589,1,36,0)="4. CPRS ORDERING INSTITUTION prompt"
^DIC(9.4,60,22,13,"PAH",589,1,37,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",589,1,38,0)="   Upon entering the new eRx Holding Queue Processing [PSO ERX QUEUE"
^DIC(9.4,60,22,13,"PAH",589,1,39,0)="   PROCESSING] option the users of some sites were being prompt for the CPRS"
^DIC(9.4,60,22,13,"PAH",589,1,40,0)="   ORDERSING INSTITUTION as shown below."
^DIC(9.4,60,22,13,"PAH",589,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",589,1,42,0)="      There are multiple Institutions associated with this Outpatient Site for"
^DIC(9.4,60,22,13,"PAH",589,1,43,0)="      finishing orders entered through CPRS. Select the Institution for which"
^DIC(9.4,60,22,13,"PAH",589,1,44,0)="      to finish orders from.  Enter '?' to see all choices."
^DIC(9.4,60,22,13,"PAH",589,1,45,0)="  "
^DIC(9.4,60,22,13,"PAH",589,1,46,0)="      Select CPRS ORDERING INSTITUTION: BEDFORD VAMC//   "
^DIC(9.4,60,22,13,"PAH",589,1,47,0)=" "
^DIC(9.4,60,22,13,"PAH",589,1,48,0)="   This prompt was accidentally added to this option and it will be removed"
^DIC(9.4,60,22,13,"PAH",589,1,49,0)="   with this patch."
^DIC(9.4,60,22,13,"PAH",590,0)="671 SEQ #617^3240325.095716^89"
^DIC(9.4,60,22,13,"PAH",590,1,0)="^^7^7^3240325"
^DIC(9.4,60,22,13,"PAH",590,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,60,22,13,"PAH",590,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",590,1,3,0)="An error is preventing users from finishing pending CPRS orders on VistA "
^DIC(9.4,60,22,13,"PAH",590,1,4,0)="when utilizing option 'Complete Orders from OERR' (PSO LMOE FINISH)."
^DIC(9.4,60,22,13,"PAH",590,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",590,1,6,0)="The error occurs when the user selects controlled substances as a "
^DIC(9.4,60,22,13,"PAH",590,1,7,0)="secondary filter along with one of the schedule options."
^DIC(9.4,60,22,13,"PAH",591,0)="671b^3240411.122122^89"
^DIC(9.4,60,22,13,"PAH",591,1,0)="^^5^5^3240411"
^DIC(9.4,60,22,13,"PAH",591,1,1,0)="Backup of PSO*7.0*671 on Mar 25, 2024"
^DIC(9.4,60,22,13,"PAH",591,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",591,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,60,22,13,"PAH",591,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,60,22,13,"PAH",591,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,60,22,13,"PAH",592,0)="742 SEQ #618^3240506.120132^89"
^DIC(9.4,60,22,13,"PAH",592,1,0)="^^5^5^3240506"
^DIC(9.4,60,22,13,"PAH",592,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,60,22,13,"PAH",592,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",592,1,3,0)="A site reported that when they fill some OneVA prescriptions from other "
^DIC(9.4,60,22,13,"PAH",592,1,4,0)="VA host sites into their ScriptPro via OPAI interface, the dispense drug"
^DIC(9.4,60,22,13,"PAH",592,1,5,0)="comes across as UNKNOWN in ScriptPro.  "
^DIC(9.4,60,22,13,"PAH",593,0)="736 SEQ #619^3240506.1204^89"
^DIC(9.4,60,22,13,"PAH",593,1,0)="^^37^37^3240506"
^DIC(9.4,60,22,13,"PAH",593,1,1,0)="The OneVA Pharmacy application provides the Veterans Health "
^DIC(9.4,60,22,13,"PAH",593,1,2,0)="Administration (VHA) with the capability to allow Veterans travelling "
^DIC(9.4,60,22,13,"PAH",593,1,3,0)="across the United States to refill/partial fill their active VA"
^DIC(9.4,60,22,13,"PAH",593,1,4,0)="prescription at any VA Pharmacy regardless of where the prescription"
^DIC(9.4,60,22,13,"PAH",593,1,5,0)="originated. The OneVA Pharmacy application design consists of 3 main"
^DIC(9.4,60,22,13,"PAH",593,1,6,0)="components: VistA Medication Profile screen, Health Data Record Clinical"
^DIC(9.4,60,22,13,"PAH",593,1,7,0)="Data Service (HDR/CDS), and OneVA Pharmacy message flow. The VistA"
^DIC(9.4,60,22,13,"PAH",593,1,8,0)="Medication Profile screen expands available pharmacy information in VistA"
^DIC(9.4,60,22,13,"PAH",593,1,9,0)="to provide pharmacists direct access to query, and refill/partial fill"
^DIC(9.4,60,22,13,"PAH",593,1,10,0)="patient's active and refillable prescriptions. The HDR/CDS provides a"
^DIC(9.4,60,22,13,"PAH",593,1,11,0)="patient's active and refillable prescriptions. The OneVA Pharmacy message"
^DIC(9.4,60,22,13,"PAH",593,1,12,0)="flow enables the secure, bi-directional exchange of electronic health"
^DIC(9.4,60,22,13,"PAH",593,1,13,0)="records between local/remote VistA Servers, and between VistA servers and"
^DIC(9.4,60,22,13,"PAH",593,1,14,0)="HDR."
^DIC(9.4,60,22,13,"PAH",593,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",593,1,16,0)="The OneVA software currently uses IBM Websphere as the messaging system. "
^DIC(9.4,60,22,13,"PAH",593,1,17,0)="The IBM Websphere messaging system is being decommissioned. This patch "
^DIC(9.4,60,22,13,"PAH",593,1,18,0)="provides the move from using IBM Websphere to using the Veterans Data "
^DIC(9.4,60,22,13,"PAH",593,1,19,0)="Information Exchange (VDIF)."
^DIC(9.4,60,22,13,"PAH",593,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",593,1,21,0)="The software changes include the following:"
^DIC(9.4,60,22,13,"PAH",593,1,22,0)="1. Routine PSORRX1 - DNS value modified at REMOTERX+18"
^DIC(9.4,60,22,13,"PAH",593,1,23,0)="2. Routine PSORRX1 - modified argument list and corresponding references "
^DIC(9.4,60,22,13,"PAH",593,1,24,0)="   to the DRUGMTCH function"
^DIC(9.4,60,22,13,"PAH",593,1,25,0)="3. Routine PSORRX1 - modified to handle HL7 messages with possible "
^DIC(9.4,60,22,13,"PAH",593,1,26,0)="   overflow nodes at RXPRSE+4"
^DIC(9.4,60,22,13,"PAH",593,1,27,0)="4. Routine PSOHLDS6 - modified to handle HL7 messages with possible"
^DIC(9.4,60,22,13,"PAH",593,1,28,0)="   overflow nodes at HOST+2 "
^DIC(9.4,60,22,13,"PAH",593,1,29,0)="5. Routine PSOORUT1 - modified ""PROVIDER HOLD"" status abbreviation from "
^DIC(9.4,60,22,13,"PAH",593,1,30,0)="   ""PH"" to ""HP"" at SHOWREM+13"
^DIC(9.4,60,22,13,"PAH",593,1,31,0)="6. Routine PSOORUT1 - added ""DISCONTINUED BY PROVIDER"", ""DISCONTINUED"
^DIC(9.4,60,22,13,"PAH",593,1,32,0)="   (EDIT)"", and ""NON-VERIFIED"" status abbreviations at SHOWREM+13"
^DIC(9.4,60,22,13,"PAH",593,1,33,0)="7. HL LOGICAL LINK entry - the post-install routine POST^PSO736PO updates"
^DIC(9.4,60,22,13,"PAH",593,1,34,0)="   the PSORRXSEND entry of the HL LOGICAL LINK (#870) file.  The following"
^DIC(9.4,60,22,13,"PAH",593,1,35,0)="   fields will be updated to reflect VDIF production IP address and port "
^DIC(9.4,60,22,13,"PAH",593,1,36,0)="   values when installed in the site's production account:  DNS DOMAIN,"
^DIC(9.4,60,22,13,"PAH",593,1,37,0)="   TCP/IP ADDRESS, and TCP/IP PORT"
^DIC(9.4,60,22,13,"PAH",594,0)="756 SEQ #620^3240517.102322^89"
^DIC(9.4,60,22,13,"PAH",594,1,0)="^^23^23^3240517"
^DIC(9.4,60,22,13,"PAH",594,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",594,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",594,1,3,0)="1.      INC28842900 - <SUBSCRIPT>COMPILE+24^PSODEARV"
^DIC(9.4,60,22,13,"PAH",594,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",594,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",594,1,6,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",594,1,7,0)="--------"
^DIC(9.4,60,22,13,"PAH",594,1,8,0)="When running the report DEA Expiration Date Report [PSO EPCS EXPIRE DATE "
^DIC(9.4,60,22,13,"PAH",594,1,9,0)="REPORT] a subscript error <SUBSCRIPT>COMPILE+24^PSODEARV can occur when a "
^DIC(9.4,60,22,13,"PAH",594,1,10,0)="record in the file DEA NUMBERS (#8991,9) is encountered that has no value "
^DIC(9.4,60,22,13,"PAH",594,1,11,0)="for the NAME (PROVIDER OR INSTITUTION) field (#1.1). This error can occur "
^DIC(9.4,60,22,13,"PAH",594,1,12,0)="when running the report as a Delimited File.  The error does not happen "
^DIC(9.4,60,22,13,"PAH",594,1,13,0)="when the report is run as a Report."
^DIC(9.4,60,22,13,"PAH",594,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",594,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",594,1,16,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",594,1,17,0)="-----------"
^DIC(9.4,60,22,13,"PAH",594,1,18,0)="The error occurs because the Delimited File output uses the NAME field "
^DIC(9.4,60,22,13,"PAH",594,1,19,0)="1.1 in the DEA NUMBERS file #8991.9, which can be null.  The Report "
^DIC(9.4,60,22,13,"PAH",594,1,20,0)="output uses the NAME field #.01 in the NEW PERSON file which is always "
^DIC(9.4,60,22,13,"PAH",594,1,21,0)="populated.  This patch prevents the error by modifying routine PSODEARV "
^DIC(9.4,60,22,13,"PAH",594,1,22,0)="to use the NAME field #.01 in the NEW PERSON file when building the "
^DIC(9.4,60,22,13,"PAH",594,1,23,0)="delimited output."
^DIC(9.4,60,22,13,"PAH",595,0)="703^3240528.105202^89"
^DIC(9.4,60,22,13,"PAH",596,0)="745 SEQ #622^3240528.105405^89"
^DIC(9.4,60,22,13,"PAH",596,1,0)="^^6^6^3240528"
^DIC(9.4,60,22,13,"PAH",596,1,1,0)="The Application Programmer Interface (API PSOVCCA) used by CRM/VSE for"
^DIC(9.4,60,22,13,"PAH",596,1,2,0)="refilling a prescription, there is a rare possibility that the "
^DIC(9.4,60,22,13,"PAH",596,1,3,0)="prescription may be locked in VistA, which means updates aren't "
^DIC(9.4,60,22,13,"PAH",596,1,4,0)="permitted at that time. This is not properly communicated back to the"
^DIC(9.4,60,22,13,"PAH",596,1,5,0)="calling program. This patch will now return ""-8 - Prescription unavailable"
^DIC(9.4,60,22,13,"PAH",596,1,6,0)="- try again later""."
^DIC(9.4,60,22,13,"PAH",597,0)="743 SEQ #623^3240528.105425^89"
^DIC(9.4,60,22,13,"PAH",597,1,0)="^^1^1^3240528"
^DIC(9.4,60,22,13,"PAH",597,1,1,0)="See FORUM patch description."
^DIC(9.4,60,22,13,"PAH",598,0)="755 SEQ #624^3240611.11152^89"
^DIC(9.4,60,22,13,"PAH",598,1,0)="^^35^35^3240611"
^DIC(9.4,60,22,13,"PAH",598,1,1,0)="This patch addresses the following incident ticket:"
^DIC(9.4,60,22,13,"PAH",598,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,3,0)="INC24400778 - Missing DEA number in Order DEA Archive the ORDER DEA "
^DIC(9.4,60,22,13,"PAH",598,1,4,0)="ARCHIVE file (#101.52)."
^DIC(9.4,60,22,13,"PAH",598,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",598,1,7,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",598,1,8,0)="INC24400778 - Missing DEA number in Order DEA Archive File #101.52."
^DIC(9.4,60,22,13,"PAH",598,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,11,0)="Problem(s):"
^DIC(9.4,60,22,13,"PAH",598,1,12,0)="-----------"
^DIC(9.4,60,22,13,"PAH",598,1,13,0)="For eRx prescriptions, the ORDER DEA ARCHIVE file (#101.52) DEA # field "
^DIC(9.4,60,22,13,"PAH",598,1,14,0)="(#10) is missing. When an eRx order is accepted in the eRx Holding "
^DIC(9.4,60,22,13,"PAH",598,1,15,0)="Queue, the DEA # is not populated when sending the data to file "
^DIC(9.4,60,22,13,"PAH",598,1,16,0)="(#101.52). The logic currently does not populate the DEA # when the"
^DIC(9.4,60,22,13,"PAH",598,1,17,0)="Provider's expiration date is the same date as the eRx prescription's"
^DIC(9.4,60,22,13,"PAH",598,1,18,0)="written date.  "
^DIC(9.4,60,22,13,"PAH",598,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,21,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",598,1,22,0)="-----------"
^DIC(9.4,60,22,13,"PAH",598,1,23,0)="This will need to be addressed with changes to Outpatient Pharmacy code"
^DIC(9.4,60,22,13,"PAH",598,1,24,0)="routine PSOHLSNC is modified to send the DEA# in the RXE segment piece 14,"
^DIC(9.4,60,22,13,"PAH",598,1,25,0)="which is already mapped on the CPRS side (according to the ORDEA Routine)."
^DIC(9.4,60,22,13,"PAH",598,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,28,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",598,1,29,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",598,1,30,0)="Routine PSOHLSNC is modified starting at RXE tag line 12:"
^DIC(9.4,60,22,13,"PAH",598,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",598,1,32,0)="New logic added:"
^DIC(9.4,60,22,13,"PAH",598,1,33,0)=" I $$GET1^DIQ(52.49,PSOIEN,95.1,""I""),$$CS^PSOERXA0(PSOHNDD) D"
^DIC(9.4,60,22,13,"PAH",598,1,34,0)=" . S PSOWRDT=$$GET1^DIQ(52.49,PSOIEN,5.9,""I"") S "
^DIC(9.4,60,22,13,"PAH",598,1,35,0)="PSOXFLD(13)=$P($$DEA^XUSER(0,PSOHPRO,PSOWRDT),""-"",1)"
^DIC(9.4,60,22,13,"PAH",599,0)="754 SEQ #625^3240627.130539^89"
^DIC(9.4,60,22,13,"PAH",599,1,0)="^^68^68^3240627"
^DIC(9.4,60,22,13,"PAH",599,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,60,22,13,"PAH",599,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,3,0)="ISSUE WITH COPYING A LIMITED DURATION ORDER"
^DIC(9.4,60,22,13,"PAH",599,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",599,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,8,0)="1.      INC31444921 - ISSUE WITH COPYING A LIMITED DURATION ORDER"
^DIC(9.4,60,22,13,"PAH",599,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,11,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",599,1,12,0)="--------"
^DIC(9.4,60,22,13,"PAH",599,1,13,0)="When copying a titration order, at the duration prompt, which was 2W "
^DIC(9.4,60,22,13,"PAH",599,1,14,0)="(2weeks). It did not honor the defaults. It kept on repeating no more "
^DIC(9.4,60,22,13,"PAH",599,1,15,0)="than 2 days. And the user is stuck on the Limited Duration prompt."
^DIC(9.4,60,22,13,"PAH",599,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,17,0)="The problem was found to be due to code from patch PSO*7*457, which was "
^DIC(9.4,60,22,13,"PAH",599,1,18,0)="part of a clozapine enhancement that is no longer valid and was only "
^DIC(9.4,60,22,13,"PAH",599,1,19,0)="meant for a clozapine order.  Patch PSO*7*574 added logic that skips the "
^DIC(9.4,60,22,13,"PAH",599,1,20,0)="logic added by PSO*7*457, unfortunately, it causes problems when copying "
^DIC(9.4,60,22,13,"PAH",599,1,21,0)="an order defined with a limited duration."
^DIC(9.4,60,22,13,"PAH",599,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,23,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",599,1,24,0)="-----------"
^DIC(9.4,60,22,13,"PAH",599,1,25,0)="The resolution is to comment out the logic from PSO*7*457 in DUR^PSOORED5."
^DIC(9.4,60,22,13,"PAH",599,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,28,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",599,1,29,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",599,1,30,0)="The code found at line DUR+8^PSOORED5 through line DUR+17^PSOORED5 is "
^DIC(9.4,60,22,13,"PAH",599,1,31,0)="commented out."
^DIC(9.4,60,22,13,"PAH",599,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,33,0)="The code is changed from:"
^DIC(9.4,60,22,13,"PAH",599,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,36,0)=";/RBN Begin modification for #326 ;/MZR Added a message and correct "
^DIC(9.4,60,22,13,"PAH",599,1,37,0)="checking for Hours/Minutes"
^DIC(9.4,60,22,13,"PAH",599,1,38,0)=" I $G(DIR(""B""))!$G(PSORXED(""DURATION"",ENT)) N Z,MAX D  I Z>MAX S "
^DIC(9.4,60,22,13,"PAH",599,1,39,0)="PSORXED(""DURATION"",$G(PSORXED(""ENT"")))=MAX G DUR"
^DIC(9.4,60,22,13,"PAH",599,1,40,0)=" .I X=+X S Z=X"
^DIC(9.4,60,22,13,"PAH",599,1,41,0)=" .E  S "
^DIC(9.4,60,22,13,"PAH",599,1,42,0)="Z=$E(X,$L(X)),Z=$S(Z=""L"":30*X,Z=""W"":7*X,Z=""H"":X/24,Z=""M"":X/1440,1:+X)"
^DIC(9.4,60,22,13,"PAH",599,1,43,0)=" .S MAX=$S($G(DIR(""B"")):+DIR(""B""),1:$G(PSORXED(""DURATION"",ENT)))"
^DIC(9.4,60,22,13,"PAH",599,1,44,0)=" .I Z>MAX D"
^DIC(9.4,60,22,13,"PAH",599,1,45,0)=" ..W "" "
^DIC(9.4,60,22,13,"PAH",599,1,46,0)="(""_$S(X[""L"":""MONTHS"",X[""W"":""WEEKS"",X[""H"":""HOURS"",X[""M"":""MINUTES"",1:""DAYS"")"
^DIC(9.4,60,22,13,"PAH",599,1,47,0)="_"")"""
^DIC(9.4,60,22,13,"PAH",599,1,48,0)=" ..W !,""NOT MORE THAN "",MAX,"" DAYS"""
^DIC(9.4,60,22,13,"PAH",599,1,49,0)=" ;; END NCC REMEDIATION << 457*RJS"
^DIC(9.4,60,22,13,"PAH",599,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,51,0)="To:"
^DIC(9.4,60,22,13,"PAH",599,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",599,1,53,0)=" ;PSO*7*754 comment out code added with PSO*7*457"
^DIC(9.4,60,22,13,"PAH",599,1,54,0)=" ;; START NCC REMEDIATION >> 457*RJS - ADJUST FOR 4 DAY SUPPLY"
^DIC(9.4,60,22,13,"PAH",599,1,55,0)=" ;/RBN Begin modification for #326 ;/MZR Added a message and correct "
^DIC(9.4,60,22,13,"PAH",599,1,56,0)="checking for Hours/Minutes"
^DIC(9.4,60,22,13,"PAH",599,1,57,0)=" ;I $G(DIR(""B""))!$G(PSORXED(""DURATION"",ENT)) N Z,MAX D I Z>MAX S "
^DIC(9.4,60,22,13,"PAH",599,1,58,0)="PSORXED(""DURATION"",$G(PSORXED(""ENT"")))=MAX G DUR"
^DIC(9.4,60,22,13,"PAH",599,1,59,0)=" ;.I X=+X S Z=X"
^DIC(9.4,60,22,13,"PAH",599,1,60,0)=" ;.E S "
^DIC(9.4,60,22,13,"PAH",599,1,61,0)="Z=$E(X,$L(X)),Z=$S(Z=""L"":30*X,Z=""W"":7*X,Z=""H"":X/24,Z=""M"":X/1440,1:+X)"
^DIC(9.4,60,22,13,"PAH",599,1,62,0)=" ;.S MAX=$S($G(DIR(""B"")):+DIR(""B""),1:$G(PSORXED(""DURATION"",ENT)))"
^DIC(9.4,60,22,13,"PAH",599,1,63,0)=" ;.I Z>MAX D"
^DIC(9.4,60,22,13,"PAH",599,1,64,0)=" ;..W "" "
^DIC(9.4,60,22,13,"PAH",599,1,65,0)="(""_$S(X[""L"":""MONTHS"",X[""W"":""WEEKS"",X[""H"":""HOURS"",X[""M"":""MINUTES"",1:""DAYS"")"
^DIC(9.4,60,22,13,"PAH",599,1,66,0)="_"")"""
^DIC(9.4,60,22,13,"PAH",599,1,67,0)=" ;..W !,""NOT MORE THAN "",MAX,"" DAYS"""
^DIC(9.4,60,22,13,"PAH",599,1,68,0)=" ;; END NCC REMEDIATION << 457*RJS"
^DIC(9.4,60,22,13,"PAH",600,0)="740 SEQ #626^3240726.103655^89"
^DIC(9.4,60,22,13,"PAH",600,1,0)="^^1^1^3240726"
^DIC(9.4,60,22,13,"PAH",600,1,1,0)="See FORUM for patch description."
^DIC(9.4,60,22,13,"PAH",601,0)="704^3240726.103911^89"
^DIC(9.4,60,22,13,"PAH",602,0)="746 SEQ #627^3240726.103938^89"
^DIC(9.4,60,22,13,"PAH",602,1,0)="^^924^924^3240726"
^DIC(9.4,60,22,13,"PAH",602,1,1,0)="The Inbound Electronic Prescribing (eRx) Phase 2 Enhancements delivered in this"
^DIC(9.4,60,22,13,"PAH",602,1,2,0)="patch is a continuation effort to convert all of the MbM Class 3 modifications"
^DIC(9.4,60,22,13,"PAH",602,1,3,0)="into Class 1. Below is a summary of the changes being delivered in this patch."
^DIC(9.4,60,22,13,"PAH",602,1,4,0)="For a more comprehensive description of the changes please refer to the"
^DIC(9.4,60,22,13,"PAH",602,1,5,0)="documents listed in the Documentation section of this description.  "
^DIC(9.4,60,22,13,"PAH",602,1,6,0)=" "
