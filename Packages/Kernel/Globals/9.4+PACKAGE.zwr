^DIC(9.4,185,22,"B","1.0",1)=""
^DIC(9.4,185,"DEV")="MRY"
^DIC(9.4,185,"EX",0)="^9.432^1^1"
^DIC(9.4,185,"EX",1,0)="DGJZ"
^DIC(9.4,185,"VERSION")="1.0"
^DIC(9.4,186,0)="CLINICAL CASE REGISTRIES^ROR^CLINICAL REGISTRIES"
^DIC(9.4,186,20,0)="^9.402P^^"
^DIC(9.4,186,22,0)="^9.49I^2^2"
^DIC(9.4,186,22,1,0)="1.0^3051119^3020528^1"
^DIC(9.4,186,22,1,1,0)="^9.54^12^12^3060427^"
^DIC(9.4,186,22,1,1,1,0)="The Clinical Case Registry package automatically collects and creates"
^DIC(9.4,186,22,1,1,2,0)="local registries of patients using the predefined search criteria."
^DIC(9.4,186,22,1,1,3,0)=" "
^DIC(9.4,186,22,1,1,4,0)="This release contains the infrastructure and definitions of the Hepatitis"
^DIC(9.4,186,22,1,1,5,0)="C registry. The software will search for patients that pass the"
^DIC(9.4,186,22,1,1,6,0)="pre-defined selection rules that identify a patient with Hepatitis C"
^DIC(9.4,186,22,1,1,7,0)="(e.g., ICD-9 code relating to Hepatitis C, positive laboratory serology"
^DIC(9.4,186,22,1,1,8,0)="test results for Hepatitis C testing)."
^DIC(9.4,186,22,1,1,9,0)=" "
^DIC(9.4,186,22,1,1,10,0)="Local sites have the ability to review the local registry list before"
^DIC(9.4,186,22,1,1,11,0)="automated data extraction and transmission. Data extraction and"
^DIC(9.4,186,22,1,1,12,0)="transmission will be timed daily and will not require manual intervention."
^DIC(9.4,186,22,1,"PAH",0)="^9.4901^7^7"
^DIC(9.4,186,22,1,"PAH",1,0)="2 SEQ #2^3021008^1"
^DIC(9.4,186,22,1,"PAH",1,1,0)="^^3^3^3021008"
^DIC(9.4,186,22,1,"PAH",1,1,1,0)="This patch fixes various problems discovered during the installation and"
^DIC(9.4,186,22,1,"PAH",1,1,2,0)="implementation of the Clinical Case Registries v1.0 package. It also"
^DIC(9.4,186,22,1,"PAH",1,1,3,0)="contains some enhancements."
^DIC(9.4,186,22,1,"PAH",2,0)="3 SEQ #3^3030301^1"
^DIC(9.4,186,22,1,"PAH",2,1,0)="^^2^2^3030301"
^DIC(9.4,186,22,1,"PAH",2,1,1,0)="This build contains modifications required by the new Race & Ethnicity "
^DIC(9.4,186,22,1,"PAH",2,1,2,0)="data model."
^DIC(9.4,186,22,1,"PAH",3,0)="4 SEQ #4^3030628^1"
^DIC(9.4,186,22,1,"PAH",3,1,0)="^^2^2^3030628"
^DIC(9.4,186,22,1,"PAH",3,1,1,0)="This build fixes the code that causes very long execution of the nightly"
^DIC(9.4,186,22,1,"PAH",3,1,2,0)="data extraction process and a couple of other data extraction problems."
^DIC(9.4,186,22,1,"PAH",4,0)="5^3040330^1"
^DIC(9.4,186,22,1,"PAH",4,1,0)="^^2^2^3040330"
^DIC(9.4,186,22,1,"PAH",4,1,1,0)="This build introduces Immunology Case Registry v3.0 and several fixes for "
^DIC(9.4,186,22,1,"PAH",4,1,2,0)="the the Clinical Case Registries."
^DIC(9.4,186,22,1,"PAH",5,0)="7 SEQ #6^3041015^1"
^DIC(9.4,186,22,1,"PAH",5,1,0)="^^1^1^3041015"
^DIC(9.4,186,22,1,"PAH",5,1,1,0)="Updates for the Code Text Descriptors project."
^DIC(9.4,186,22,1,"PAH",6,0)="6 SEQ #7^3041111^1"
^DIC(9.4,186,22,1,"PAH",6,1,0)="^^2^2^3041111"
^DIC(9.4,186,22,1,"PAH",6,1,1,0)="This patch fixes problems discovered during the implementation of the"
^DIC(9.4,186,22,1,"PAH",6,1,2,0)="Immunology Case Registry in the Clinical Case Registries framework."
^DIC(9.4,186,22,1,"PAH",7,0)="8 SEQ #8^3050506^1"
^DIC(9.4,186,22,1,"PAH",7,1,0)="^^2^2^3050506"
^DIC(9.4,186,22,1,"PAH",7,1,1,0)="Immunology Case (ICR) and Hepatitis C (Hep C) registries historical data"
^DIC(9.4,186,22,1,"PAH",7,1,2,0)="extraction and HL7 context management (CCOW)."
^DIC(9.4,186,22,1,"PAH","B",5,4)=""
