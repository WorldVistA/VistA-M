^DIC(9.4,3,22,21,"PAH",208,0)="239 SEQ #215^3021025^1"
^DIC(9.4,3,22,21,"PAH",208,1,0)="^^264^264^3021025"
^DIC(9.4,3,22,21,"PAH",208,1,1,0)="This patch is in support of the Hui/VHA CIO SD&D Pharmacy Data "
^DIC(9.4,3,22,21,"PAH",208,1,2,0)="Interchange project. The project provides a method for the one-way "
^DIC(9.4,3,22,21,"PAH",208,1,3,0)="electronic transfer of prescription orders from an external system to "
^DIC(9.4,3,22,21,"PAH",208,1,4,0)="VistA."
^DIC(9.4,3,22,21,"PAH",208,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,6,0)="This patch transports the following entries:"
^DIC(9.4,3,22,21,"PAH",208,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,8,0)="- XUHUIHL7 (routine)"
^DIC(9.4,3,22,21,"PAH",208,1,9,0)="- XUHUI FIELD CHANGE EVENT (protocol from the Protocol, #101, file)"
^DIC(9.4,3,22,21,"PAH",208,1,10,0)="- XUHUI SEND HL7 MESSAGE (protocol from the Protocol, #101, file)"
^DIC(9.4,3,22,21,"PAH",208,1,11,0)="- XUHUI MFN and XUHUI MFK (HL7 protocols from the Protocol, #101, file)"
^DIC(9.4,3,22,21,"PAH",208,1,12,0)="- XUHUI MFN and XUHUI MFK (HL7 applications from the HL7 Application "
^DIC(9.4,3,22,21,"PAH",208,1,13,0)="Parameter, #771, file)"
^DIC(9.4,3,22,21,"PAH",208,1,14,0)="- HUI PROV (logical links from the HL7 Logical Link, #870, file)"
^DIC(9.4,3,22,21,"PAH",208,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,16,0)="    **Take special notice of the special post installation**"
^DIC(9.4,3,22,21,"PAH",208,1,17,0)="    **instructions      "
^DIC(9.4,3,22,21,"PAH",208,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,19,0)="Test Sites: "
^DIC(9.4,3,22,21,"PAH",208,1,20,0)="================"
^DIC(9.4,3,22,21,"PAH",208,1,21,0)="Palo Alto, Clarksburg WV, North Chicago, and Oklahoma City."
^DIC(9.4,3,22,21,"PAH",208,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,23,0)="Blood Bank Team Coordination: "
