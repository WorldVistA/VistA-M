^DIC(9.4,77,22,17,"PAH",245,1,86,0)="PSJ LM ECO HIDDEN ACTIONS"
^DIC(9.4,77,22,17,"PAH",245,1,87,0)="PSJ LM ECO IM PR"
^DIC(9.4,77,22,17,"PAH",245,1,88,0)="PSJ LM ECO MENU"
^DIC(9.4,77,22,17,"PAH",245,1,89,0)="PSJ LM ECO RANGE"
^DIC(9.4,77,22,17,"PAH",245,1,90,0)="PSJ LM ECO SELECT"
^DIC(9.4,77,22,17,"PAH",245,1,91,0)="PSJ LM ECO START"
^DIC(9.4,77,22,17,"PAH",245,1,92,0)="PSJ LM VIEW ORDER DETAIL"
^DIC(9.4,77,22,17,"PAH",245,1,93,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,94,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,95,0)="Security Keys Associated:"
^DIC(9.4,77,22,17,"PAH",245,1,96,0)="None. "
