^DIC(9.4,135,22,14,"PAH",13,0)="21 SEQ #20^3000516^1"
^DIC(9.4,135,22,14,"PAH",13,1,0)="^^4^4^3000516"
^DIC(9.4,135,22,14,"PAH",13,1,1,0)="This patch will correct the Problem in LM of Problem List comments not being "
^DIC(9.4,135,22,14,"PAH",13,1,2,0)="displayed for all Divisions."
^DIC(9.4,135,22,14,"PAH",13,1,3,0)=""
^DIC(9.4,135,22,14,"PAH",13,1,4,0)="Build can be found on the National Patch Module under Patch GMPL*2.0*21."
^DIC(9.4,135,22,14,"PAH",14,0)="22 SEQ #21^3000516^1"
^DIC(9.4,135,22,14,"PAH",14,1,0)="^^6^6^3000516"
^DIC(9.4,135,22,14,"PAH",14,1,1,0)="Patient Problem description in Health Summary does not match the description"
^DIC(9.4,135,22,14,"PAH",14,1,2,0)="in Problem List.  This patch will modify routine GMPLHS to include the "
^DIC(9.4,135,22,14,"PAH",14,1,3,0)="field (1.01), ""POINTER TO EXPRESSIONS FILE (#757.01)"" in the API to aid HS "
^DIC(9.4,135,22,14,"PAH",14,1,4,0)="in correcting this discrepancy.  "
^DIC(9.4,135,22,14,"PAH",14,1,5,0)=""
^DIC(9.4,135,22,14,"PAH",14,1,6,0)="Build can be found on the National Patch Module under Patch GMPL*2.0*22."
^DIC(9.4,135,22,14,"PAH",15,0)="23 SEQ #22^3000516^1"
^DIC(9.4,135,22,14,"PAH",15,1,0)="^^2^2^3000516"
^DIC(9.4,135,22,14,"PAH",15,1,1,0)="See the Build description in the National Patch module under patch "
^DIC(9.4,135,22,14,"PAH",15,1,2,0)="GMPL*2*23."
^DIC(9.4,135,22,14,"PAH",16,0)="20 SEQ #23^3000816^1"
^DIC(9.4,135,22,14,"PAH",16,1,0)="^^5^5^3000816"
^DIC(9.4,135,22,14,"PAH",16,1,1,0)="This patch was developed to make the Clinician more aware of the ICD "
^DIC(9.4,135,22,14,"PAH",16,1,2,0)="code of 799.9 being assigned to patient problems when no match is found in "
^DIC(9.4,135,22,14,"PAH",16,1,3,0)="Lexicon."
^DIC(9.4,135,22,14,"PAH",16,1,4,0)=""
^DIC(9.4,135,22,14,"PAH",16,1,5,0)="Build can be found on the National Patch Module under Patch GMPL*2.0*20."
