^DIC(9.4,137,22,0)="^9.49I^3^1"
^DIC(9.4,137,22,3,0)="3.0^3051119^2960924"
^DIC(9.4,137,22,3,"PAH",0)="^9.4901^18^18"
^DIC(9.4,137,22,3,"PAH",1,0)="48 SEQ #45^2970408^1"
^DIC(9.4,137,22,3,"PAH",1,1,0)="^^2^2^2970408"
^DIC(9.4,137,22,3,"PAH",1,1,1,0)="This patch corrects the date on the Referral report and the line"
^DIC(9.4,137,22,3,"PAH",1,1,2,0)="count on the RCH address labels."
^DIC(9.4,137,22,3,"PAH",2,0)="49 SEQ #46^2970409^1"
^DIC(9.4,137,22,3,"PAH",2,1,0)="^^6^6^2970409"
^DIC(9.4,137,22,3,"PAH",2,1,1,0)="This build contains modified routines (SOWKND, SOWKOPT, SOWKPREI) for"
^DIC(9.4,137,22,3,"PAH",2,1,2,0)="patch SOW*3*49.  Changes were required to eliminate parts of the"
^DIC(9.4,137,22,3,"PAH",2,1,3,0)="pre-initialization and post-initialization conversion which referenced the"
^DIC(9.4,137,22,3,"PAH",2,1,4,0)="PERSON file (16). The PERSON file (16), along with the USER file (3) and"
^DIC(9.4,137,22,3,"PAH",2,1,5,0)="PROVIDER file (6), will be eliminated in the future and the previous"
^DIC(9.4,137,22,3,"PAH",2,1,6,0)="conversion process for Social Work will be rendered inoperable."
^DIC(9.4,137,22,3,"PAH",3,0)="46 SEQ #47^2970610^1"
^DIC(9.4,137,22,3,"PAH",3,1,0)="^^2^2^2970610"
^DIC(9.4,137,22,3,"PAH",3,1,1,0)="This build merges the Event Capture data entry and report menus with the"
^DIC(9.4,137,22,3,"PAH",3,1,2,0)="Social Work menus."
^DIC(9.4,137,22,3,"PAH",4,0)="52 SEQ #48^2970922^1"
^DIC(9.4,137,22,3,"PAH",4,1,0)="^^3^3^2970922"
^DIC(9.4,137,22,3,"PAH",4,1,1,0)="This KIDS build contains the routine SOWKOPEN, which has been modified"
^DIC(9.4,137,22,3,"PAH",4,1,2,0)="for patch SOW*3.0*52, to resolve a problem causing corruption on the zero"
^DIC(9.4,137,22,3,"PAH",4,1,3,0)="nodes of entries in the SOCIAL WORK PATIENT file (655)."
^DIC(9.4,137,22,3,"PAH",5,0)="40 SEQ #49^2971231^1"
^DIC(9.4,137,22,3,"PAH",5,1,0)="^^8^8^2971231"
^DIC(9.4,137,22,3,"PAH",5,1,1,0)="This patch updates the RCS 10-0173 (80 COLUMNS) Report to only report"
^DIC(9.4,137,22,3,"PAH",5,1,2,0)="information as it pertains to the open date to the home and close date to"
^DIC(9.4,137,22,3,"PAH",5,1,3,0)="the home.  After the patch is installed the open and close dates to the"
^DIC(9.4,137,22,3,"PAH",5,1,4,0)="program will will no longer be used to determine any of the information"
^DIC(9.4,137,22,3,"PAH",5,1,5,0)="reported on the RCS 10-0173. The report will now display an accurate"
^DIC(9.4,137,22,3,"PAH",5,1,6,0)="number for veterans remaining at the end of the quarter as well as the"
^DIC(9.4,137,22,3,"PAH",5,1,7,0)="total bed days of care regardless of case openings, case closings,"
^DIC(9.4,137,22,3,"PAH",5,1,8,0)="programs opening, and program closing."
^DIC(9.4,137,22,3,"PAH",6,0)="51 SEQ #50^2980129^1"
^DIC(9.4,137,22,3,"PAH",6,1,0)="^^4^4^2980129"
^DIC(9.4,137,22,3,"PAH",6,1,1,0)=" This patch addresses NOIS CLE-0597-42170 regarding the request made by"
^DIC(9.4,137,22,3,"PAH",6,1,2,0)=" Mental Health VACO (FORUM msg #1107156) to set up the CDR Accounts."
^DIC(9.4,137,22,3,"PAH",6,1,3,0)=" Three of the CDC Codes, (2312.00, 2314.00 and 2315.00) were previously"
^DIC(9.4,137,22,3,"PAH",6,1,4,0)=" marked for deletion by patch SOW*3*36 in December of 1994."
^DIC(9.4,137,22,3,"PAH",7,0)="53 SEQ #51^2980403^1"
^DIC(9.4,137,22,3,"PAH",7,1,0)="^^281^281^2980403"
^DIC(9.4,137,22,3,"PAH",7,1,1,0)=" This patch makes the following changes to address Year 2000 compliance "
^DIC(9.4,137,22,3,"PAH",7,1,2,0)=" issues in the Social Work package.  "
