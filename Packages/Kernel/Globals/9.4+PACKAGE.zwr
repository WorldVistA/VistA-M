^DIC(9.4,151,22,1,"PAH",133,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,151,22,1,"PAH",134,0)="153 SEQ #145^3210326.104427^17"
^DIC(9.4,151,22,1,"PAH",134,1,0)="^^2^2^3210326"
^DIC(9.4,151,22,1,"PAH",134,1,1,0)="This patch updates forty four (44) procedure codes to reflect Fiscal Year "
^DIC(9.4,151,22,1,"PAH",134,1,2,0)="2021 mid-year changes, effective April 1, 2021."
