^DIC(9.4,3,22,21,"PAH",115,1,96,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",115,1,97,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,98,0)="  3.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",115,1,99,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",115,1,100,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,101,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",115,1,102,0)="      option:"
^DIC(9.4,3,22,21,"PAH",115,1,103,0)="        Install Package(s)  'XU*8.0*135'"
^DIC(9.4,3,22,21,"PAH",115,1,104,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",115,1,105,0)=" "
