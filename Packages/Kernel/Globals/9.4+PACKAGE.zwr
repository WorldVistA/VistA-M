^DIC(9.4,5,22,13,"PAH",36,1,32,0)="XURTLK           5622442     4991557      **53,19**"
^DIC(9.4,5,22,13,"PAH",36,1,33,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,34,0)="List of preceding patches: 53"
^DIC(9.4,5,22,13,"PAH",36,1,35,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,5,22,13,"PAH",36,1,36,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,37,0)="      "
^DIC(9.4,5,22,13,"PAH",36,1,38,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",36,1,39,0)="============"
^DIC(9.4,5,22,13,"PAH",36,1,40,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,41,0)=">>>Users may remain on the system."
^DIC(9.4,5,22,13,"PAH",36,1,42,0)=">>>TaskMan does not need to be stopped."
^DIC(9.4,5,22,13,"PAH",36,1,43,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,44,0)="  1.  DSM sites - Some of the routines may be mapped so you may need to"
^DIC(9.4,5,22,13,"PAH",36,1,45,0)="      disable mapping for the routines listed within this patch."
^DIC(9.4,5,22,13,"PAH",36,1,46,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,47,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",36,1,48,0)="      option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",36,1,49,0)="       "
^DIC(9.4,5,22,13,"PAH",36,1,50,0)="  3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,5,22,13,"PAH",36,1,51,0)="      system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",36,1,52,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,53,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,5,22,13,"PAH",36,1,54,0)="      options: "
^DIC(9.4,5,22,13,"PAH",36,1,55,0)="        "
^DIC(9.4,5,22,13,"PAH",36,1,56,0)="         Verify Checksums in Transport Global "
^DIC(9.4,5,22,13,"PAH",36,1,57,0)="         Print Transport Global "
^DIC(9.4,5,22,13,"PAH",36,1,58,0)="         Compare Transport Global to Current System "
^DIC(9.4,5,22,13,"PAH",36,1,59,0)="         Backup a Transport Global "
^DIC(9.4,5,22,13,"PAH",36,1,60,0)="        "
^DIC(9.4,5,22,13,"PAH",36,1,61,0)="  4.  You do not need to inhibit users from login into the system."
^DIC(9.4,5,22,13,"PAH",36,1,62,0)="      TaskMan can remain running."
^DIC(9.4,5,22,13,"PAH",36,1,63,0)="        "
^DIC(9.4,5,22,13,"PAH",36,1,64,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the 'Install"
^DIC(9.4,5,22,13,"PAH",36,1,65,0)="      Package(s)' option and select the package "
^DIC(9.4,5,22,13,"PAH",36,1,66,0)="  "
^DIC(9.4,5,22,13,"PAH",36,1,67,0)="          XT*7.3*19 "
^DIC(9.4,5,22,13,"PAH",36,1,68,0)="          =========         "
^DIC(9.4,5,22,13,"PAH",36,1,69,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,70,0)="      Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,5,22,13,"PAH",36,1,71,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,72,0)="      Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,5,22,13,"PAH",36,1,73,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,74,0)="      No Options or Protocols need to be placed out-of-order."
^DIC(9.4,5,22,13,"PAH",36,1,75,0)="      Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,5,22,13,"PAH",36,1,76,0)="        "
^DIC(9.4,5,22,13,"PAH",36,1,77,0)="  7.  DSM sites: After patch has installed, rebuild your map set if"
^DIC(9.4,5,22,13,"PAH",36,1,78,0)="      necessary."
^DIC(9.4,5,22,13,"PAH",36,1,79,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,80,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,81,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,82,0)="NOIS fixed:"
^DIC(9.4,5,22,13,"PAH",36,1,83,0)="=========="
^DIC(9.4,5,22,13,"PAH",36,1,84,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,85,0)="COS-0596-40601  Fix 'Enable/Disable RT Logging' [XURTL] option to point to"
^DIC(9.4,5,22,13,"PAH",36,1,86,0)="                the LOG SYSTEM RT? field under the VOLUME SET multiple"
^DIC(9.4,5,22,13,"PAH",36,1,87,0)="                field in the KERNEL SYSTEM PARAMETERS file."
^DIC(9.4,5,22,13,"PAH",36,1,88,0)="                "
^DIC(9.4,5,22,13,"PAH",36,1,89,0)="BRX-0598-10869  Fix the division by zero error in the 'Graphic RT Report"
^DIC(9.4,5,22,13,"PAH",36,1,90,0)="                Print' [XURTLPG] option."
^DIC(9.4,5,22,13,"PAH",37,0)="55 SEQ #45^3011106^1"
^DIC(9.4,5,22,13,"PAH",38,0)="56 SEQ #46^3011210^1"
^DIC(9.4,5,22,13,"PAH",39,0)="60 SEQ #47^3020506^1"
^DIC(9.4,5,22,13,"PAH",39,1,0)="^^76^76^3020506"
^DIC(9.4,5,22,13,"PAH",39,1,1,0)="Test sites: CPRS (ANDERSON,CURTIS)"
^DIC(9.4,5,22,13,"PAH",39,1,2,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,3,0)="NOIS: CHA-0701-32256, WRJ-0199-12466, UNY-0202-12683, NOIS: ISL-0499-52452"
^DIC(9.4,5,22,13,"PAH",39,1,4,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,5,0)="1.  Problem: Allocation errors in ENVAR^XPAR.  This call returns all parameter "
^DIC(9.4,5,22,13,"PAH",39,1,6,0)="instances."
^DIC(9.4,5,22,13,"PAH",39,1,7,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,8,0)="Fix: An additional parameter was added to the call.  The new parameter, if "
^DIC(9.4,5,22,13,"PAH",39,1,9,0)="defined changes the first parameter from a return array to a closed global "
^DIC(9.4,5,22,13,"PAH",39,1,10,0)="root to accept the data."
^DIC(9.4,5,22,13,"PAH",39,1,11,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,12,0)="Make the new call is like this: D ENVAL^XPAR($NA(^TMP($J)),206,,.XERR,1)"
^DIC(9.4,5,22,13,"PAH",39,1,13,0)="Note the Closed Global Root in the first parameter and the new fifth parameter."
^DIC(9.4,5,22,13,"PAH",39,1,14,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,15,0)="2.  Problem: Parameter entries in file 8989.5 for a individual user are not "
^DIC(9.4,5,22,13,"PAH",39,1,16,0)="deleted when the user is terminated."
^DIC(9.4,5,22,13,"PAH",39,1,17,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,18,0)="Fix: New entry point DELUSR^XPAR3(ien) that will be called from XUSTERM."
^DIC(9.4,5,22,13,"PAH",39,1,19,0)="This will start working when both patch XU*8*222 and XT*7.3*60 are installed."
^DIC(9.4,5,22,13,"PAH",39,1,20,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,21,0)="Routine Summary"
^DIC(9.4,5,22,13,"PAH",39,1,22,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,5,22,13,"PAH",39,1,23,0)="of these routines now looks like:"
^DIC(9.4,5,22,13,"PAH",39,1,24,0)=" ;;7.3;TOOLKIT;<patchlist>;Apr 25, 1995"
^DIC(9.4,5,22,13,"PAH",39,1,25,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,26,0)="                 Checksum"
^DIC(9.4,5,22,13,"PAH",39,1,27,0)="Routine         Old       New      2nd Line"
^DIC(9.4,5,22,13,"PAH",39,1,28,0)="XPAR          4083493   4223213    **26,60**"
^DIC(9.4,5,22,13,"PAH",39,1,29,0)="XPAR3             n/a    236816    **60**"
^DIC(9.4,5,22,13,"PAH",39,1,30,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,31,0)="List of preceding patches: 26"
^DIC(9.4,5,22,13,"PAH",39,1,32,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,5,22,13,"PAH",39,1,33,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,34,0)="========================================================================="
^DIC(9.4,5,22,13,"PAH",39,1,35,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",39,1,36,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,37,0)=">>>Do not allow users to log in to the system during installation."
^DIC(9.4,5,22,13,"PAH",39,1,38,0)=">>>If you accept a slight risk of jobs getting a CLOBER/EDITED error"
^DIC(9.4,5,22,13,"PAH",39,1,39,0)=">>>users and TaskMan may remain running.  Otherwise stop all other"
^DIC(9.4,5,22,13,"PAH",39,1,40,0)=">>>jobs on the system."
^DIC(9.4,5,22,13,"PAH",39,1,41,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,42,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,5,22,13,"PAH",39,1,43,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,5,22,13,"PAH",39,1,44,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,45,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",39,1,46,0)="      option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",39,1,47,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,48,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",39,1,49,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",39,1,50,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",39,1,51,0)="      options:"
^DIC(9.4,5,22,13,"PAH",39,1,52,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,53,0)="         Verify Checksums in Transport Global"
^DIC(9.4,5,22,13,"PAH",39,1,54,0)="         Print Transport Global"
^DIC(9.4,5,22,13,"PAH",39,1,55,0)="         Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",39,1,56,0)="         Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",39,1,57,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,58,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,5,22,13,"PAH",39,1,59,0)="      users are on the system and the possibility of some CLOBER/NOSOURCE"
^DIC(9.4,5,22,13,"PAH",39,1,60,0)="      errors is acceptable, then users can stay on the system.)"
^DIC(9.4,5,22,13,"PAH",39,1,61,0)="      TaskMan can remain running."
^DIC(9.4,5,22,13,"PAH",39,1,62,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,63,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",39,1,64,0)="      option:"
^DIC(9.4,5,22,13,"PAH",39,1,65,0)="        Install Package(s)  'XT*7.3*60'"
^DIC(9.4,5,22,13,"PAH",39,1,66,0)="                             ========="
^DIC(9.4,5,22,13,"PAH",39,1,67,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,68,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,5,22,13,"PAH",39,1,69,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,70,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,5,22,13,"PAH",39,1,71,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,5,22,13,"PAH",39,1,72,0)="                                                                        =="
^DIC(9.4,5,22,13,"PAH",39,1,73,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,74,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,5,22,13,"PAH",39,1,75,0)=" "
^DIC(9.4,5,22,13,"PAH",39,1,76,0)="========================================================================="
^DIC(9.4,5,22,13,"PAH",40,0)="62 SEQ #48^3020627^1"
^DIC(9.4,5,22,13,"PAH",41,0)="58 SEQ #49^3020710^1"
^DIC(9.4,5,22,13,"PAH",41,1,0)="^^109^109^3020710"
^DIC(9.4,5,22,13,"PAH",41,1,1,0)="This patch releases a XML parser that was commissioned by the VA architects."
^DIC(9.4,5,22,13,"PAH",41,1,2,0)="Developer documentation can be found on the VistA Documentation Library"
^DIC(9.4,5,22,13,"PAH",41,1,3,0)="under Infrastructure in the Kernel ToolKit session."
^DIC(9.4,5,22,13,"PAH",41,1,4,0)="Here is the URL: http://vista.domain.ext/vdl/#App12"
^DIC(9.4,5,22,13,"PAH",41,1,5,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,6,0)="Sample Use: "
^DIC(9.4,5,22,13,"PAH",41,1,7,0)="Create a XML file:"
^DIC(9.4,5,22,13,"PAH",41,1,8,0)="^TMP($J,1) = <?xml version='1.0'?>"
^DIC(9.4,5,22,13,"PAH",41,1,9,0)="^TMP($J,2) = <!DOCTYPE BOOK>"
^DIC(9.4,5,22,13,"PAH",41,1,10,0)="^TMP($J,3) = <BOOK>"
^DIC(9.4,5,22,13,"PAH",41,1,11,0)="^TMP($J,4) = <TITLE>Design Patterns</TITLE>"
^DIC(9.4,5,22,13,"PAH",41,1,12,0)="^TMP($J,5) = <AUTHOR>Gamma</AUTHOR>"
^DIC(9.4,5,22,13,"PAH",41,1,13,0)="^TMP($J,6) = <AUTHOR>Helm</AUTHOR>"
^DIC(9.4,5,22,13,"PAH",41,1,14,0)="^TMP($J,7) = <AUTHOR>Johnson</AUTHOR>"
^DIC(9.4,5,22,13,"PAH",41,1,15,0)="^TMP($J,8) = <AUTHOR>Vlissides</AUTHOR>"
^DIC(9.4,5,22,13,"PAH",41,1,16,0)="^TMP($J,9) = </BOOK>"
^DIC(9.4,5,22,13,"PAH",41,1,17,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,18,0)="Invoke the SAX interface:"
^DIC(9.4,5,22,13,"PAH",41,1,19,0)="D EN^MXMLTEST($NA(^TMP($J)),""V"")"
^DIC(9.4,5,22,13,"PAH",41,1,20,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,21,0)=". . . See what happens."
^DIC(9.4,5,22,13,"PAH",41,1,22,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,23,0)="Check the DOM interface:"
^DIC(9.4,5,22,13,"PAH",41,1,24,0)=">S HDL=$$EN^MXMLDOM($NA(^TMP($J)))"
^DIC(9.4,5,22,13,"PAH",41,1,25,0)=">W $$NAME^MXMLDOM(HDL,1)    <<Write the name of the first node"
^DIC(9.4,5,22,13,"PAH",41,1,26,0)="BOOK"
^DIC(9.4,5,22,13,"PAH",41,1,27,0)=">S CHD=$$CHILD^MXMLDOM(HDL,1)  <<Get the child of the node"
^DIC(9.4,5,22,13,"PAH",41,1,28,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,29,0)=">W $$NAME^MXMLDOM(HDL,CHD)  <<Write the child name"
^DIC(9.4,5,22,13,"PAH",41,1,30,0)="TITLE"
^DIC(9.4,5,22,13,"PAH",41,1,31,0)="W $$TEXT^MXMLDOM(HDL,CHD,$NA(VV))  <<Get the text of the child"
^DIC(9.4,5,22,13,"PAH",41,1,32,0)=1
^DIC(9.4,5,22,13,"PAH",41,1,33,0)=">ZW VV"
^DIC(9.4,5,22,13,"PAH",41,1,34,0)="VV(1)=Design Patterns"
^DIC(9.4,5,22,13,"PAH",41,1,35,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,36,0)="List all the sibling nodes"
^DIC(9.4,5,22,13,"PAH",41,1,37,0)=">S CHD=$$CHILD^MXMLDOM(HDL,1)"
^DIC(9.4,5,22,13,"PAH",41,1,38,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,39,0)=">S SIB=CHD"
^DIC(9.4,5,22,13,"PAH",41,1,40,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,41,0)=">F  S SIB=$$SIBLING^MXMLDOM(HDL,SIB) Q:SIB'>0  W !,SIB,?4,$$NAME^MXMLDOM(HDL,SIB)"
^DIC(9.4,5,22,13,"PAH",41,1,42,0)="3   AUTHOR"
^DIC(9.4,5,22,13,"PAH",41,1,43,0)="4   AUTHOR"
^DIC(9.4,5,22,13,"PAH",41,1,44,0)="5   AUTHOR"
^DIC(9.4,5,22,13,"PAH",41,1,45,0)="6   AUTHOR"
^DIC(9.4,5,22,13,"PAH",41,1,46,0)=">"
^DIC(9.4,5,22,13,"PAH",41,1,47,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,48,0)="Some notes, Defined values are case sensitive, In the first line, <?xml must "
^DIC(9.4,5,22,13,"PAH",41,1,49,0)="be in lowercase."
^DIC(9.4,5,22,13,"PAH",41,1,50,0)="Lines can only be broken at whitespace."
^DIC(9.4,5,22,13,"PAH",41,1,51,0)="Here is a URL for more data from Microsoft and their XML notepad:"
^DIC(9.4,5,22,13,"PAH",41,1,52,0)="http://msdn.microsoft.com/library/default.asp?url=/library/en-us/dnxml/html/xmlpadrun.asp"
^DIC(9.4,5,22,13,"PAH",41,1,53,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,54,0)="Routine Summary"
^DIC(9.4,5,22,13,"PAH",41,1,55,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,5,22,13,"PAH",41,1,56,0)="of these routines now looks like:"
^DIC(9.4,5,22,13,"PAH",41,1,57,0)=" ;;7.3;TOOLKIT;<patchlist>;Apr 25, 1995"
^DIC(9.4,5,22,13,"PAH",41,1,58,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,59,0)="                 Checksum"
^DIC(9.4,5,22,13,"PAH",41,1,60,0)="Routine         Old       New      2nd Line"
^DIC(9.4,5,22,13,"PAH",41,1,61,0)="MXMLDOM           n/a   2273946    **58**"
^DIC(9.4,5,22,13,"PAH",41,1,62,0)="MXMLPRS0          n/a   7296844    **58**"
^DIC(9.4,5,22,13,"PAH",41,1,63,0)="MXMLPRS1          n/a   4193331    **58**"
^DIC(9.4,5,22,13,"PAH",41,1,64,0)="MXMLPRSE          n/a   7947708    **58**"
^DIC(9.4,5,22,13,"PAH",41,1,65,0)="MXMLTEST          n/a   1892022    **58**"
^DIC(9.4,5,22,13,"PAH",41,1,66,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,67,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,5,22,13,"PAH",41,1,68,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,69,0)="========================================================================="
^DIC(9.4,5,22,13,"PAH",41,1,70,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",41,1,71,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,72,0)=">>>Users may remain on the system."
^DIC(9.4,5,22,13,"PAH",41,1,73,0)=">>>TaskMan does *not* need to be stopped."
^DIC(9.4,5,22,13,"PAH",41,1,74,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,75,0)="  1.  DSM sites - These are new routines."
^DIC(9.4,5,22,13,"PAH",41,1,76,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,77,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",41,1,78,0)="      option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",41,1,79,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,80,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",41,1,81,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",41,1,82,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",41,1,83,0)="      options:"
^DIC(9.4,5,22,13,"PAH",41,1,84,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,85,0)="         Verify Checksums in Transport Global"
^DIC(9.4,5,22,13,"PAH",41,1,86,0)="         Print Transport Global"
^DIC(9.4,5,22,13,"PAH",41,1,87,0)="         Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",41,1,88,0)="         Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",41,1,89,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,90,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,5,22,13,"PAH",41,1,91,0)="      time."
^DIC(9.4,5,22,13,"PAH",41,1,92,0)="      This patch can be queued and installed at any time."
^DIC(9.4,5,22,13,"PAH",41,1,93,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,5,22,13,"PAH",41,1,94,0)="      TaskMan can remain running."
^DIC(9.4,5,22,13,"PAH",41,1,95,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,96,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",41,1,97,0)="      option:"
^DIC(9.4,5,22,13,"PAH",41,1,98,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,99,0)="        Install Package(s)  'XT*7.3*58'"
^DIC(9.4,5,22,13,"PAH",41,1,100,0)="                             =========="
^DIC(9.4,5,22,13,"PAH",41,1,101,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,102,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,5,22,13,"PAH",41,1,103,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,104,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,5,22,13,"PAH",41,1,105,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,5,22,13,"PAH",41,1,106,0)="                                                                        =="
^DIC(9.4,5,22,13,"PAH",41,1,107,0)=""
^DIC(9.4,5,22,13,"PAH",41,1,108,0)="========================================================================="
^DIC(9.4,5,22,13,"PAH",41,1,109,0)=""
