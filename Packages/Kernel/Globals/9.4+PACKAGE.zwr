^DIC(9.4,4,22,1,"PAH",169,0)="199 SEQ #194^3011121^1"
^DIC(9.4,4,22,1,"PAH",169,1,0)="^^86^86^3011121"
^DIC(9.4,4,22,1,"PAH",169,1,1,0)="Patch XM*7.1*199"
^DIC(9.4,4,22,1,"PAH",169,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",169,1,3,0)="NOIS none"
^DIC(9.4,4,22,1,"PAH",169,1,4,0)="Test Sites: FORUM; OIFO Oakland"
^DIC(9.4,4,22,1,"PAH",169,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",169,1,6,0)="If you send a message to an AOL account, AOL reports to the recipient that"
^DIC(9.4,4,22,1,"PAH",169,1,7,0)="the message is from an unknown sender at an unknown domain.  Testing has"
^DIC(9.4,4,22,1,"PAH",169,1,8,0)="shown that this is because the header fields do not have a space after the"
^DIC(9.4,4,22,1,"PAH",169,1,9,0)="colon.  This patch inserts a space after the colon, to make AOL happy."
^DIC(9.4,4,22,1,"PAH",169,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",169,1,11,0)="This patch also:"
^DIC(9.4,4,22,1,"PAH",169,1,12,0)="- changes *7 to $C(7)."
^DIC(9.4,4,22,1,"PAH",169,1,13,0)="- makes the menus appear faster by setting invalid choices to dialog file"
^DIC(9.4,4,22,1,"PAH",169,1,14,0)="entry numbers, instead of dialog file text."
^DIC(9.4,4,22,1,"PAH",169,1,15,0)="- improves the file check of file 3.9 by checking the entire ""C"" xref of the"
^DIC(9.4,4,22,1,"PAH",169,1,16,0)="recipient multiple.  Previously, only those related to local recipients were"
^DIC(9.4,4,22,1,"PAH",169,1,17,0)="checked; now, those of remote recipients are included, too."
^DIC(9.4,4,22,1,"PAH",169,1,18,0)="- uses dialog file entries in places they hadn't been used before."
^DIC(9.4,4,22,1,"PAH",169,1,19,0)="- makes the choices line up better when becoming a surrogate."
^DIC(9.4,4,22,1,"PAH",169,1,20,0)="- warns users who are sending a message Later that if they minused anyone"
^DIC(9.4,4,22,1,"PAH",169,1,21,0)="from any groups, those minuses will be ignored.  If they want the minuses"
^DIC(9.4,4,22,1,"PAH",169,1,22,0)="to be honored, they must transmit the message now."
^DIC(9.4,4,22,1,"PAH",169,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",169,1,24,0)="NOTE: This patch should be installed during off hours, when user activity is"
^DIC(9.4,4,22,1,"PAH",169,1,25,0)="at a minimum.  It requires MailMan patches XM*7.1*155,*161,*170,*190 & *194."
^DIC(9.4,4,22,1,"PAH",169,1,26,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",169,1,27,0)=""
