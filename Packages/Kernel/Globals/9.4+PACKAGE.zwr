^DIC(9.4,47,22,5.9,"PAH",599,0)="781 SEQ #686^3080526.154626^1"
^DIC(9.4,47,22,5.9,"PAH",599,1,0)="^^1^1^3080526"
^DIC(9.4,47,22,5.9,"PAH",599,1,1,0)="Correcting missing Treating Specialty code in PTF Census transmissions."
^DIC(9.4,47,22,5.9,"PAH",600,0)="766 SEQ #687^3080526.160446^1"
^DIC(9.4,47,22,5.9,"PAH",600,1,0)="^^5^5^3080526"
^DIC(9.4,47,22,5.9,"PAH",600,1,1,0)="This patch addresses the following:"
^DIC(9.4,47,22,5.9,"PAH",600,1,2,0)="- corrects hours and minutes of the 'date last treated' for MPI"
^DIC(9.4,47,22,5.9,"PAH",600,1,3,0)="- requires precise dates for the Confidential Address Start and"
^DIC(9.4,47,22,5.9,"PAH",600,1,4,0)="  End dates"
^DIC(9.4,47,22,5.9,"PAH",600,1,5,0)="- retires the Patient Data Review (PDR) functionality in MPI   "
^DIC(9.4,47,22,5.9,"PAH",601,0)="778 SEQ #688^3080526.193012^1"
^DIC(9.4,47,22,5.9,"PAH",602,0)="644 SEQ #689^3080722.075001^1"
^DIC(9.4,47,22,5.9,"PAH",603,0)="782 SEQ #690^3080722.143415^1"
^DIC(9.4,47,22,5.9,"PAH",603,1,0)="^^1^1^3080722"
^DIC(9.4,47,22,5.9,"PAH",603,1,1,0)="Update to RELIGION file (#13)."
^DIC(9.4,47,22,5.9,"PAH",604,0)="779 SEQ #691^3090420.154855^1"
^DIC(9.4,47,22,5.9,"PAH",605,0)="783 SEQ #692^3090420.160508^1"
^DIC(9.4,47,22,5.9,"PAH",605,1,0)="^^3^3^3090420"
^DIC(9.4,47,22,5.9,"PAH",605,1,1,0)="This patch changes the default for the prompt ""Do you wish to proceed"
^DIC(9.4,47,22,5.9,"PAH",605,1,2,0)="with the Means Test"" from ""YES"" to ""NO"" when the prompt displays for option"
^DIC(9.4,47,22,5.9,"PAH",605,1,3,0)="options in the pre-registration menu."
^DIC(9.4,47,22,5.9,"PAH",606,0)="763 SEQ #693^3090420.160544^1"
^DIC(9.4,47,22,5.9,"PAH",607,0)="785 SEQ #694^3090421.163523^17"
^DIC(9.4,47,22,5.9,"PAH",607,1,0)="^^2^2^3090421"
^DIC(9.4,47,22,5.9,"PAH",607,1,1,0)="This patch allows for data entry changes to correctly calculate bilateral "
^DIC(9.4,47,22,5.9,"PAH",607,1,2,0)="knee and hip procedures."
^DIC(9.4,47,22,5.9,"PAH",608,0)="784 SEQ #695^3090422.120352^17"
^DIC(9.4,47,22,5.9,"PAH",608,1,0)="^^9^9^3090422"
^DIC(9.4,47,22,5.9,"PAH",608,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",608,1,2,0)="Modified DISCHARGE DATE field (#70) and DISCHARGE SPECIALTY "
^DIC(9.4,47,22,5.9,"PAH",608,1,3,0)="field (#71) of the PTF file (#45)."
^DIC(9.4,47,22,5.9,"PAH",608,1,4,0)="Updated technical descriptions for LOSING SPECIALTY field (#2) and the"
^DIC(9.4,47,22,5.9,"PAH",608,1,5,0)="MOVEMENT DATE field (#10) of the 501 multiple subfile (#45.02) of the PTF"
^DIC(9.4,47,22,5.9,"PAH",608,1,6,0)="file (#45)."
^DIC(9.4,47,22,5.9,"PAH",608,1,7,0)="Updates eligibility for an ASIH movement.  "
^DIC(9.4,47,22,5.9,"PAH",608,1,8,0)="Recreated the trigger for the LOSING SPECIALTY field (#2) of the "
^DIC(9.4,47,22,5.9,"PAH",608,1,9,0)="501 multiple subfile (#45.02).  "
^DIC(9.4,47,22,5.9,"PAH",609,0)="769 SEQ #696^3090422.120457^17"
^DIC(9.4,47,22,5.9,"PAH",609,1,0)="^^2^2^3090422"
^DIC(9.4,47,22,5.9,"PAH",609,1,1,0)="  This patch addresses issues regarding the patient sensitivity/security"
^DIC(9.4,47,22,5.9,"PAH",609,1,2,0)="check, and the check for same last name and last 4 digits of SSN."
^DIC(9.4,47,22,5.9,"PAH",610,0)="791 SEQ #697^3090422.123919^17"
^DIC(9.4,47,22,5.9,"PAH",610,1,0)="^^10^10^3090422"
^DIC(9.4,47,22,5.9,"PAH",610,1,1,0)="VIC HL7 LOGICAL LINK UPDATE - VIC NCMD"
^DIC(9.4,47,22,5.9,"PAH",610,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",610,1,3,0)="PURPOSE: Update 'VIC NCMD' Logical Link for TCP/IP transmissions.  The "
^DIC(9.4,47,22,5.9,"PAH",610,1,4,0)="current definition has a hard coded IP Address.  The existing Data will "
^DIC(9.4,47,22,5.9,"PAH",610,1,5,0)="be removed and replaced by a DNS domain name in HLCS(870"
^DIC(9.4,47,22,5.9,"PAH",610,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",610,1,7,0)="The routine will find the IEN by looking at HLCS(870,'B','VIC NCMD',ien"
^DIC(9.4,47,22,5.9,"PAH",610,1,8,0)="Then the first data piece ('^') will be updated with the new data."
^DIC(9.4,47,22,5.9,"PAH",610,1,9,0)=" "
^DIC(9.4,47,22,5.9,"PAH",610,1,10,0)="This Routine will only be run once."
^DIC(9.4,47,22,5.9,"PAH",611,0)="789 SEQ #698^3090422.124004^17"
^DIC(9.4,47,22,5.9,"PAH",611,1,0)="^^6^6^3090422"
^DIC(9.4,47,22,5.9,"PAH",611,1,1,0)="This patch makes field #6 USE FOR Z07 in file #38.6 IN"
^DIC(9.4,47,22,5.9,"PAH",611,1,2,0)="INCONSISTENT DATA ELEMENTS undeditable. It also updates the"
^DIC(9.4,47,22,5.9,"PAH",611,1,3,0)="data to correspond with the values that were sent out with the"
^DIC(9.4,47,22,5.9,"PAH",611,1,4,0)="VHA Directive."
^DIC(9.4,47,22,5.9,"PAH",611,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",611,1,6,0)="This patch also modifies the VADPT0 routine."
^DIC(9.4,47,22,5.9,"PAH",612,0)="798^3090422.162515^17"
^DIC(9.4,47,22,5.9,"PAH",613,0)="796 SEQ #701^3090423.111758^17"
^DIC(9.4,47,22,5.9,"PAH",613,1,0)="^^1^1^3090423"
^DIC(9.4,47,22,5.9,"PAH",613,1,1,0)="PTF PSEUDO DISCHARGE FIX, MISSING ROUTINE FIX, MAILMAN MESSAGE FIX FOR PDX"
^DIC(9.4,47,22,5.9,"PAH",614,0)="688^3090423.134023^17"
^DIC(9.4,47,22,5.9,"PAH",614,1,0)="^^4^4^3090423"
^DIC(9.4,47,22,5.9,"PAH",614,1,1,0)="Patch for ENROLLMENT VISTA CHANGES TO SUPPORT ESR (RELEASE 2)."
^DIC(9.4,47,22,5.9,"PAH",614,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",614,1,3,0)="See the Patch description for DG*5.3*688 as documented in the Forum Patch "
^DIC(9.4,47,22,5.9,"PAH",614,1,4,0)="Module."
^DIC(9.4,47,22,5.9,"PAH",615,0)="664^3090423.134101^17"
^DIC(9.4,47,22,5.9,"PAH",615,1,0)="^^4^4^3090423"
^DIC(9.4,47,22,5.9,"PAH",615,1,1,0)="PROJECT 112/SHAD."
^DIC(9.4,47,22,5.9,"PAH",615,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",615,1,3,0)="PIMS REGISTRATION"
^DIC(9.4,47,22,5.9,"PAH",615,1,4,0)="        PTF CHANGES"
^DIC(9.4,47,22,5.9,"PAH",616,0)="806 SEQ #704^3090423.134441^17"
^DIC(9.4,47,22,5.9,"PAH",617,0)="807 SEQ #705^3090423.1357^17"
^DIC(9.4,47,22,5.9,"PAH",618,0)="788 SEQ #708^3090527.17454^17"
^DIC(9.4,47,22,5.9,"PAH",619,0)="808 SEQ #706^3090527.174515^17"
^DIC(9.4,47,22,5.9,"PAH",620,0)="793 SEQ #707^3090527.174533^17"
^DIC(9.4,47,22,5.9,"PAH",621,0)="786 SEQ #709^3090608.104128^17"
^DIC(9.4,47,22,5.9,"PAH",621,1,0)="^^14^14^3090608"
^DIC(9.4,47,22,5.9,"PAH",621,1,1,0)="DG*5.3*786 does the following:"
^DIC(9.4,47,22,5.9,"PAH",621,1,2,0)="- modifies the data dictionary for the CPT MODIFIER field (#.03) in the"
^DIC(9.4,47,22,5.9,"PAH",621,1,3,0)="  INPATIENT CPT CODE file (#46). "
^DIC(9.4,47,22,5.9,"PAH",621,1,4,0)="- corrects routine DGRPCF to increment the file header for the "
^DIC(9.4,47,22,5.9,"PAH",621,1,5,0)="  INCONSISTENT DATA file (#38.5) only when a record is added."
^DIC(9.4,47,22,5.9,"PAH",621,1,6,0)="- modifies routines DGRRLUA and DGRRLU6 to account for providers whose"
^DIC(9.4,47,22,5.9,"PAH",621,1,7,0)="  names contain apostrophes."
^DIC(9.4,47,22,5.9,"PAH",621,1,8,0)="- modifies the ADGRU09 cross reference in the PATIENT MOVEMENT file"
^DIC(9.4,47,22,5.9,"PAH",621,1,9,0)="  (#405) to fix a problem when using ^DIK to delete certain records."
^DIC(9.4,47,22,5.9,"PAH",621,1,10,0)="- modifies the ROUTING LOGIC in the DG HOME TELEHEALTH ADT-A03 CLIENT "
^DIC(9.4,47,22,5.9,"PAH",621,1,11,0)="  protocol. "
^DIC(9.4,47,22,5.9,"PAH",621,1,12,0)="- modifies the DNS DOMAIN for the HL7 LOGICAL LINKS for HOME "
^DIC(9.4,47,22,5.9,"PAH",621,1,13,0)="  TELEHEALTH."
^DIC(9.4,47,22,5.9,"PAH",621,1,14,0)="- recompiles the input template for the 501 screen.    "
^DIC(9.4,47,22,5.9,"PAH",622,0)="803 SEQ #710^3090610.10201^17"
^DIC(9.4,47,22,5.9,"PAH",622,1,0)="^^1^1^3090610"
^DIC(9.4,47,22,5.9,"PAH",622,1,1,0)="Please refer to the patch description in this patch on FORUM"
^DIC(9.4,47,22,5.9,"PAH",623,0)="792 SEQ #711^3090615.115718^17"
^DIC(9.4,47,22,5.9,"PAH",623,1,0)="^^5^5^3090615"
^DIC(9.4,47,22,5.9,"PAH",623,1,1,0)="This patch corrects the erroneous calculation of the CV End date on the"
^DIC(9.4,47,22,5.9,"PAH",623,1,2,0)="Unsupported CV end date report.  The code was changed from calculating a"
^DIC(9.4,47,22,5.9,"PAH",623,1,3,0)="2 year window to calculating a 3 or 5 year window.  Please refer to the"
^DIC(9.4,47,22,5.9,"PAH",623,1,4,0)="national patch module on Forum for a full description of the problems"
^DIC(9.4,47,22,5.9,"PAH",623,1,5,0)="corrected with this patch."
^DIC(9.4,47,22,5.9,"PAH",624,0)="809 SEQ #712^3090623.16153^17"
^DIC(9.4,47,22,5.9,"PAH",625,0)="536 SEQ #713^3090624.144112^17"
^DIC(9.4,47,22,5.9,"PAH",626,0)="712 SEQ #714^3090714.090658^17"
^DIC(9.4,47,22,5.9,"PAH",626,1,0)="^^5^5^3090714"
^DIC(9.4,47,22,5.9,"PAH",626,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",626,1,2,0)="ADD FILE 2 X-REFS: "
^DIC(9.4,47,22,5.9,"PAH",626,1,3,0)="EMAIL ADDRESS, CELL PHONE NUMBER, AND BAD ADDRESS INDICATOR"
^DIC(9.4,47,22,5.9,"PAH",626,1,4,0)="Refer to patch DG*5.3*712 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",626,1,5,0)="description."
^DIC(9.4,47,22,5.9,"PAH",627,0)="671^3090714.152133^17"
^DIC(9.4,47,22,5.9,"PAH",627,1,0)="^^16^16^3090714"
^DIC(9.4,47,22,5.9,"PAH",627,1,1,0)="This patch addresses a request which supports the Pharmacy Benefits"
^DIC(9.4,47,22,5.9,"PAH",627,1,2,0)="Management (PBM)Extracts Enhancement #3 project. In order to allow the"
^DIC(9.4,47,22,5.9,"PAH",627,1,3,0)="retransmission of only those patients who have had demographic updates,"
^DIC(9.4,47,22,5.9,"PAH",627,1,4,0)="Outpatient Pharmacy V. 7.0, Inpatient Medications V. 5.0, Registration"
^DIC(9.4,47,22,5.9,"PAH",627,1,5,0)="V. 5.3 and Pharmacy Data Management V. 1.0 were modified to build an"
^DIC(9.4,47,22,5.9,"PAH",627,1,6,0)="entry for re-transmission in PBM PATIENT DEMOGRAPHICS File #59.9."
^DIC(9.4,47,22,5.9,"PAH",627,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",627,1,8,0)="This patch will introduce six (6) new fields to the DG Field Monitor Event"
^DIC(9.4,47,22,5.9,"PAH",627,1,9,0)="driver. This will enhance the PBM extract process anytime these fields"
^DIC(9.4,47,22,5.9,"PAH",627,1,10,0)="are accessed and updated. The six fields are:"
^DIC(9.4,47,22,5.9,"PAH",627,1,11,0)="   SEX  (#.02)"
^DIC(9.4,47,22,5.9,"PAH",627,1,12,0)="   PRIMARY ELIGIBILITY CODE (#.361)"
^DIC(9.4,47,22,5.9,"PAH",627,1,13,0)="   CURRENT MEANS TEST STATUS (#.14)"
^DIC(9.4,47,22,5.9,"PAH",627,1,14,0)="   CURRENT ENROLLMENT (#27.01)"
^DIC(9.4,47,22,5.9,"PAH",627,1,15,0)="   PROVIDER (#.104)"
^DIC(9.4,47,22,5.9,"PAH",627,1,16,0)="   DATE ENTERED INTO FILE (#.097)"
^DIC(9.4,47,22,5.9,"PAH",628,0)="750 SEQ #716^3090729.12365^17"
^DIC(9.4,47,22,5.9,"PAH",628,1,0)="^^8^8^3090729"
^DIC(9.4,47,22,5.9,"PAH",628,1,1,0)="This patch corrects the following:"
^DIC(9.4,47,22,5.9,"PAH",628,1,2,0)="Ensures that the Registration package will store long patient "
^DIC(9.4,47,22,5.9,"PAH",628,1,3,0)="names properly. "
^DIC(9.4,47,22,5.9,"PAH",628,1,4,0)="Catastrophic edit warning will not be displayed if only the "
^DIC(9.4,47,22,5.9,"PAH",628,1,5,0)="pseudo Social Security Number is being changed. "
^DIC(9.4,47,22,5.9,"PAH",628,1,6,0)="Catastrophic edit warning will be displayed if two or more edits to any"
^DIC(9.4,47,22,5.9,"PAH",628,1,7,0)="potential CE field(patient name, ssn, dob, sex) have been done on the "
^DIC(9.4,47,22,5.9,"PAH",628,1,8,0)="same day."
^DIC(9.4,47,22,5.9,"PAH",629,0)="813 SEQ #717^3090917.150349^17"
^DIC(9.4,47,22,5.9,"PAH",629,1,0)="^^1^1^3090917"
^DIC(9.4,47,22,5.9,"PAH",629,1,1,0)="TREATING SPECIALTY UPDATES FOR FY10"
^DIC(9.4,47,22,5.9,"PAH",630,0)="759 SEQ #718^3090924.104751^17"
^DIC(9.4,47,22,5.9,"PAH",630,1,0)="^^1^1^3090924"
^DIC(9.4,47,22,5.9,"PAH",630,1,1,0)="FIXES FOR PTF 501 DISPLAY AND WAIT LIST ERROR"
^DIC(9.4,47,22,5.9,"PAH",631,0)="790 SEQ #719^3090924.104802^17"
^DIC(9.4,47,22,5.9,"PAH",631,1,0)="^^6^6^3090924"
^DIC(9.4,47,22,5.9,"PAH",631,1,1,0)="This patch corrects:"
^DIC(9.4,47,22,5.9,"PAH",631,1,2,0)="1. Correcting Record index of 3 fields in patient file"
^DIC(9.4,47,22,5.9,"PAH",631,1,3,0)="   to use DA instead of DFN."
^DIC(9.4,47,22,5.9,"PAH",631,1,4,0)="2. Determination of radiation method for SVC^VADPT API."
^DIC(9.4,47,22,5.9,"PAH",631,1,5,0)="3. Change Patient Type Update[DG PATIENT TYPE PARAMETER EDIT] option to "
^DIC(9.4,47,22,5.9,"PAH",631,1,6,0)="   prevent users from adding a new patient type."
^DIC(9.4,47,22,5.9,"PAH",632,0)="810 SEQ #720^3090928.113239^17"
^DIC(9.4,47,22,5.9,"PAH",633,0)="804 SEQ #721^3091005.162906^17"
^DIC(9.4,47,22,5.9,"PAH",633,1,0)="^^1^1^3091005"
^DIC(9.4,47,22,5.9,"PAH",633,1,1,0)="Fix errors caused by DGRPCE1 and DGRPE1."
^DIC(9.4,47,22,5.9,"PAH",634,0)="816 SEQ #722^3091130.140257^17"
^DIC(9.4,47,22,5.9,"PAH",634,1,0)="^^1^1^3091130"
^DIC(9.4,47,22,5.9,"PAH",634,1,1,0)="TREATING SPECIALTY SERVICE UPDATE"
^DIC(9.4,47,22,5.9,"PAH",635,0)="818^3100105.165434^17"
^DIC(9.4,47,22,5.9,"PAH",635,1,0)="^^1^1^3100105"
^DIC(9.4,47,22,5.9,"PAH",635,1,1,0)="2010 Means Test Threshold Updates"
