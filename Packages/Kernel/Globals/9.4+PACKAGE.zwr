^DIC(9.4,3,22,21,"PAH",37,1,45,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",37,1,46,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",37,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,48,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",37,1,49,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",37,1,50,0)="      "
^DIC(9.4,3,22,21,"PAH",37,1,51,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",37,1,52,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",37,1,53,0)="      "
^DIC(9.4,3,22,21,"PAH",37,1,54,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",37,1,55,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",37,1,56,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",37,1,57,0)="      options:"
^DIC(9.4,3,22,21,"PAH",37,1,58,0)="      "
^DIC(9.4,3,22,21,"PAH",37,1,59,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",37,1,60,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",37,1,61,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",37,1,62,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",37,1,63,0)="         "
^DIC(9.4,3,22,21,"PAH",37,1,64,0)="  4.  Inhibit users from login into system. "
^DIC(9.4,3,22,21,"PAH",37,1,65,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",37,1,66,0)="            "
^DIC(9.4,3,22,21,"PAH",37,1,67,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",37,1,68,0)="      option:"
^DIC(9.4,3,22,21,"PAH",37,1,69,0)="         Install Package(s)  'XU*8.0*59'"
^DIC(9.4,3,22,21,"PAH",37,1,70,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",37,1,71,0)="               "
^DIC(9.4,3,22,21,"PAH",37,1,72,0)=" 6.  DSM/MSM Sites - Move the following two routines to the MGR account."
^DIC(9.4,3,22,21,"PAH",37,1,73,0)="      ZIS4MSM"
^DIC(9.4,3,22,21,"PAH",37,1,74,0)="      ZIS4ONT"
^DIC(9.4,3,22,21,"PAH",37,1,75,0)="      ZIS4VXD"
^DIC(9.4,3,22,21,"PAH",37,1,76,0)="      ZISTCP"
^DIC(9.4,3,22,21,"PAH",37,1,77,0)="      And in the manager account, (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",37,1,78,0)="       "
^DIC(9.4,3,22,21,"PAH",37,1,79,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",37,1,80,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",37,1,81,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",37,1,82,0)="      Patch number to load: 59"
^DIC(9.4,3,22,21,"PAH",37,1,83,0)="                            =="
^DIC(9.4,3,22,21,"PAH",37,1,84,0)="       "
^DIC(9.4,3,22,21,"PAH",37,1,85,0)="  8.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",37,1,86,0)="  9.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",37,1,87,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",37,1,88,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,89,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",37,1,90,0)=""
^DIC(9.4,3,22,21,"PAH",38,0)="70 SEQ #52^2971201^1"
^DIC(9.4,3,22,21,"PAH",38,1,0)="^^58^58^2971201"
^DIC(9.4,3,22,21,"PAH",38,1,1,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,2,0)="*** Patch XU*8*59 MUST be installed before this patch           ***"
^DIC(9.4,3,22,21,"PAH",38,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,4,0)="A problem was found when using a Broker v1.0 application on Windows 95"
^DIC(9.4,3,22,21,"PAH",38,1,5,0)="and server side has Broker v1.1 with Auto sign-on.  The 16bit app will"
^DIC(9.4,3,22,21,"PAH",38,1,6,0)="prevent the server from contacting the ClientAgent, this will cause the"
^DIC(9.4,3,22,21,"PAH",38,1,7,0)="16 bit PCMM to time-out and close the sign-on."
^DIC(9.4,3,22,21,"PAH",38,1,8,0)="The fix is to disable the auto sign-on if the client is Broker v1.0"
^DIC(9.4,3,22,21,"PAH",38,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,10,0)="It was found that the Broker sign-on were allowed even when Logon were"
^DIC(9.4,3,22,21,"PAH",38,1,11,0)="inhibited."
^DIC(9.4,3,22,21,"PAH",38,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,13,0)="Both problems fixed by patching XUSRB"
^DIC(9.4,3,22,21,"PAH",38,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,15,0)="SFC-1197-61181  XUSRA  The SQLI interface was making use of a call in"
^DIC(9.4,3,22,21,"PAH",38,1,16,0)="                       XUSRA that called an entry point in XUS that had "
^DIC(9.4,3,22,21,"PAH",38,1,17,0)="                       chaged with patch 59.  This is now fixed."
^DIC(9.4,3,22,21,"PAH",38,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,19,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",38,1,20,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",38,1,21,0)="XUSRA         1213791   1890066    **70**"
^DIC(9.4,3,22,21,"PAH",38,1,22,0)="XUSRB         4666750   5125201    **11,16,28,32,59,70**"
^DIC(9.4,3,22,21,"PAH",38,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,24,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",38,1,25,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",38,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,27,0)="  1.  DSM sites - One of these routines may by mapped,"
^DIC(9.4,3,22,21,"PAH",38,1,28,0)="      so you will need to disable mapping for the effected routine. "
^DIC(9.4,3,22,21,"PAH",38,1,29,0)="     "
^DIC(9.4,3,22,21,"PAH",38,1,30,0)=" 2.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",38,1,31,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",38,1,32,0)="     "
^DIC(9.4,3,22,21,"PAH",38,1,33,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",38,1,34,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",38,1,35,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",38,1,36,0)="      options:"
^DIC(9.4,3,22,21,"PAH",38,1,37,0)="      "
^DIC(9.4,3,22,21,"PAH",38,1,38,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",38,1,39,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",38,1,40,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",38,1,41,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",38,1,42,0)="     "
^DIC(9.4,3,22,21,"PAH",38,1,43,0)=" 4.   Users can remain on the system."
^DIC(9.4,3,22,21,"PAH",38,1,44,0)="      Stop the Broker listener to prevent the possibility of some CLOBER"
^DIC(9.4,3,22,21,"PAH",38,1,45,0)="      errors."
^DIC(9.4,3,22,21,"PAH",38,1,46,0)="     "
^DIC(9.4,3,22,21,"PAH",38,1,47,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",38,1,48,0)="      option:"
^DIC(9.4,3,22,21,"PAH",38,1,49,0)="        Install Package(s)  'XU*8.0*70'"
^DIC(9.4,3,22,21,"PAH",38,1,50,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",38,1,51,0)="        "
^DIC(9.4,3,22,21,"PAH",38,1,52,0)=" 6.   MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",38,1,53,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",38,1,54,0)="     "
^DIC(9.4,3,22,21,"PAH",38,1,55,0)=" 7.   DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",38,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",38,1,57,0)=" 8.   All sites, Restart the Broker listener."
^DIC(9.4,3,22,21,"PAH",38,1,58,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",39,0)="62 SEQ #53^2980220^1"
^DIC(9.4,3,22,21,"PAH",39,1,0)="^^18^18^2980220"
^DIC(9.4,3,22,21,"PAH",39,1,1,0)="Enhancements to Unwinder routines (XQOR*) in support of CPRS 1.0"
^DIC(9.4,3,22,21,"PAH",39,1,2,0)="These enhancements include:"
^DIC(9.4,3,22,21,"PAH",39,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",39,1,4,0)="  1) A new parameter which may be passed to XQORM - XQORM(""ALT"")"
^DIC(9.4,3,22,21,"PAH",39,1,5,0)="     This allows the calling routine to supply an alternative lookup"
^DIC(9.4,3,22,21,"PAH",39,1,6,0)="     to be used if the user types something that does not appear on"
^DIC(9.4,3,22,21,"PAH",39,1,7,0)="     the menu."
^DIC(9.4,3,22,21,"PAH",39,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",39,1,9,0)="  2) Fixed a bug that caused the menu to be exited if numeric ranges"
^DIC(9.4,3,22,21,"PAH",39,1,10,0)="     were allowed, the user erroneously entered something like 1-4B,"
^DIC(9.4,3,22,21,"PAH",39,1,11,0)="     and then typed a return at 'For entry 1-4B enter: ""."
^DIC(9.4,3,22,21,"PAH",39,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",39,1,13,0)="  3) Added ""E"" as a flag for XQORM(0).  It will allow ambiguous lookups"
^DIC(9.4,3,22,21,"PAH",39,1,14,0)="     to be resolved interactively when XQORM is called without XQORM(0)"
^DIC(9.4,3,22,21,"PAH",39,1,15,0)="     containing an ""A""."
^DIC(9.4,3,22,21,"PAH",39,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",39,1,17,0)="  4) Made a change that sets full screen earlier when being called by"
^DIC(9.4,3,22,21,"PAH",39,1,18,0)="     list manager so that selection lists are properly displayed."
^DIC(9.4,3,22,21,"PAH",40,0)="68 SEQ #54^2980318^1"
^DIC(9.4,3,22,21,"PAH",40,1,0)="^^74^74^2980318"
^DIC(9.4,3,22,21,"PAH",40,1,1,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",40,1,2,0)="    ****** This patch must be QUEUED during the install process ******"
^DIC(9.4,3,22,21,"PAH",40,1,3,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",40,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",40,1,5,0)="This patch contains fixes that were identified by mail messages and E3R"
^DIC(9.4,3,22,21,"PAH",40,1,6,0)=" -A patch will not be installed if the site is not running the correct version"
^DIC(9.4,3,22,21,"PAH",40,1,7,0)="  for the package."
^DIC(9.4,3,22,21,"PAH",40,1,8,0)=" -Multiple Build definition will now be sent to the site, along with all the"
^DIC(9.4,3,22,21,"PAH",40,1,9,0)="  builds that make up the Multiple Build."
^DIC(9.4,3,22,21,"PAH",40,1,10,0)="  E3R #10306."
^DIC(9.4,3,22,21,"PAH",40,1,11,0)=" -Protocols will now delete properly at the site."
^DIC(9.4,3,22,21,"PAH",40,1,12,0)=" -The variable XPDABORT will correctly abort the install in both the Pre &"
^DIC(9.4,3,22,21,"PAH",40,1,13,0)="  Post install routines."
^DIC(9.4,3,22,21,"PAH",40,1,14,0)=" -The variable DIR is newed before call to environment check routine."
^DIC(9.4,3,22,21,"PAH",40,1,15,0)="  ISW-0597-21778"
^DIC(9.4,3,22,21,"PAH",40,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",40,1,17,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",40,1,18,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",40,1,19,0)="   Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",40,1,20,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",40,1,21,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",40,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",40,1,23,0)="            Before          After           Patch"
^DIC(9.4,3,22,21,"PAH",40,1,24,0)="Routine     Checksum        Checksum        List"
^DIC(9.4,3,22,21,"PAH",40,1,25,0)="----------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",40,1,26,0)="XPDDP       11584192        11970878     **21,28,44,68**"
^DIC(9.4,3,22,21,"PAH",40,1,27,0)="XPDE        15041471        15253053     **2,15,21,44,51,68**"
^DIC(9.4,3,22,21,"PAH",40,1,28,0)="XPDI        13319818        13691537     **10,21,39,41,44,58,68**"
^DIC(9.4,3,22,21,"PAH",40,1,29,0)="XPDIA       13293339        13299802     **10,15,21,28,44,58,68**"
^DIC(9.4,3,22,21,"PAH",40,1,30,0)="XPDIA1       7937994         9226085     **2,44,51,58,68**"
^DIC(9.4,3,22,21,"PAH",40,1,31,0)="XPDIA2       3520152         6372331     **68**"
^DIC(9.4,3,22,21,"PAH",40,1,32,0)="XPDIJ       10173098        10435806     **2,21,28,41,44,68**"
^DIC(9.4,3,22,21,"PAH",40,1,33,0)="XPDIJ1       8772642         9316977     **41,68**"
^DIC(9.4,3,22,21,"PAH",40,1,34,0)="XPDIL       11156235        11193690     **15,44,58,68**"
^DIC(9.4,3,22,21,"PAH",40,1,35,0)="XPDIL1       8519937         9389594     **15,17,39,41,44,66,68**"
^DIC(9.4,3,22,21,"PAH",40,1,36,0)="XPDIPM       1817853         1853883     **21,28,68**"
^DIC(9.4,3,22,21,"PAH",40,1,37,0)="XPDT        19357441        18817747     **2,10,28,41,44,51,58,66,68**"
^DIC(9.4,3,22,21,"PAH",40,1,38,0)="XPDTA1       4760350         4948004     **44,68**"
^DIC(9.4,3,22,21,"PAH",40,1,39,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",40,1,40,0)="                     **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",40,1,41,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",40,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",40,1,43,0)=" This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",40,1,44,0)=" should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",40,1,45,0)=" Since this patch is an update to KIDS, no other patches should be installed"
^DIC(9.4,3,22,21,"PAH",40,1,46,0)=" during the installation of this patch."
^DIC(9.4,3,22,21,"PAH",40,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",40,1,48,0)="    ****** This patch must be QUEUED during the install process ******"
^DIC(9.4,3,22,21,"PAH",40,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",40,1,50,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",40,1,51,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",40,1,52,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",40,1,53,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",40,1,54,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",40,1,55,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",40,1,56,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",40,1,57,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",40,1,58,0)="      global."
^DIC(9.4,3,22,21,"PAH",40,1,59,0)="  4.  Users can remain on the system. This patch can be queued and installed"
^DIC(9.4,3,22,21,"PAH",40,1,60,0)="      at any time.  TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",40,1,61,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",40,1,62,0)="      options:"
^DIC(9.4,3,22,21,"PAH",40,1,63,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",40,1,64,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",40,1,65,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",40,1,66,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",40,1,67,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",40,1,68,0)="              INSTALL NAME: XU*8.0*68"
^DIC(9.4,3,22,21,"PAH",40,1,69,0)="                            ========="
^DIC(9.4,3,22,21,"PAH",40,1,70,0)="  6.  At the device prompt, make sure you queue the install:"
^DIC(9.4,3,22,21,"PAH",40,1,71,0)="              DEVICE: HOME// QUEUE TO PRINT ON"
^DIC(9.4,3,22,21,"PAH",40,1,72,0)="                             ="
^DIC(9.4,3,22,21,"PAH",40,1,73,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",40,1,74,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",41,0)="63 SEQ #55^2980330^1"
^DIC(9.4,3,22,21,"PAH",41,1,0)="^^67^67^2980330"
^DIC(9.4,3,22,21,"PAH",41,1,1,0)="This patch was requested because of different errors that needed to be "
^DIC(9.4,3,22,21,"PAH",41,1,2,0)="screened at the OpenM site."
^DIC(9.4,3,22,21,"PAH",41,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",41,1,4,0)="This patch updates the error routines and Taskman to use a common place to"
^DIC(9.4,3,22,21,"PAH",41,1,5,0)="check to see if errors should NOT be recorded or should be screened from"
^DIC(9.4,3,22,21,"PAH",41,1,6,0)="the normal XTER listing.  The current ERROR MESSAGE file has been enhanced"
^DIC(9.4,3,22,21,"PAH",41,1,7,0)="to control this action.  The %ZTER routine checks the list and will not"
^DIC(9.4,3,22,21,"PAH",41,1,8,0)="record errors that are flagged not to record."
^DIC(9.4,3,22,21,"PAH",41,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",41,1,10,0)="Sites can add their own entries to the file.  There is a field to allow"
^DIC(9.4,3,22,21,"PAH",41,1,11,0)="the advanced strings that Taskman has been using.  Current entries in"
^DIC(9.4,3,22,21,"PAH",41,1,12,0)="Taskmans error screen file are moved to the new file as part of the"
^DIC(9.4,3,22,21,"PAH",41,1,13,0)="install."
^DIC(9.4,3,22,21,"PAH",41,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",41,1,15,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",41,1,16,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",41,1,17,0)="XTER         17066911  17970380    **63**"
^DIC(9.4,3,22,21,"PAH",41,1,18,0)="XTER1A       16667281  16315266    **63**"
^DIC(9.4,3,22,21,"PAH",41,1,19,0)="XUINPCH       2465171   3137390    **20,36,49,63**"
^DIC(9.4,3,22,21,"PAH",41,1,20,0)="XUTMKE1       5103401   3519416    **63**"
^DIC(9.4,3,22,21,"PAH",41,1,21,0)="XUTMKE2       9221275   2696336    **63**"
^DIC(9.4,3,22,21,"PAH",41,1,22,0)="ZTER         18727059  19357862    **8,18,32,24,36,34,63**"
^DIC(9.4,3,22,21,"PAH",41,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",41,1,24,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",41,1,25,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",41,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",41,1,27,0)="1.  There is no need for these routines to be mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",41,1,28,0)="mapping."
^DIC(9.4,3,22,21,"PAH",41,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",41,1,30,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",41,1,31,0)="option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",41,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",41,1,33,0)="3.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,3,22,21,"PAH",41,1,34,0)="You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",41,1,35,0)="On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",41,1,36,0)="options:"
^DIC(9.4,3,22,21,"PAH",41,1,37,0)="          Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",41,1,38,0)="          Print Transport Global"
^DIC(9.4,3,22,21,"PAH",41,1,39,0)="          Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",41,1,40,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",41,1,41,0)="  "
^DIC(9.4,3,22,21,"PAH",41,1,42,0)="4.  Users can remain on the system. This patch can be queued and"
^DIC(9.4,3,22,21,"PAH",41,1,43,0)="installed at any time.  "
^DIC(9.4,3,22,21,"PAH",41,1,44,0)=""
^DIC(9.4,3,22,21,"PAH",41,1,45,0)="5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",41,1,46,0)="option:"
^DIC(9.4,3,22,21,"PAH",41,1,47,0)="          Install Package(s)  'XU*8.0*63'"
^DIC(9.4,3,22,21,"PAH",41,1,48,0)="                               ========="
^DIC(9.4,3,22,21,"PAH",41,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",41,1,50,0)="6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to other"
^DIC(9.4,3,22,21,"PAH",41,1,51,0)="CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",41,1,52,0)="       "
^DIC(9.4,3,22,21,"PAH",41,1,53,0)="7.  After installing this patch, you need to move one routine from "
^DIC(9.4,3,22,21,"PAH",41,1,54,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",41,1,55,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",41,1,56,0)="    "
^DIC(9.4,3,22,21,"PAH",41,1,57,0)="      And in the manager account,"
^DIC(9.4,3,22,21,"PAH",41,1,58,0)="       "
^DIC(9.4,3,22,21,"PAH",41,1,59,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",41,1,60,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",41,1,61,0)="      Patch number to load: 63"
^DIC(9.4,3,22,21,"PAH",41,1,62,0)="                            =="
^DIC(9.4,3,22,21,"PAH",41,1,63,0)="      MSM Site - Move these MGR routines to your other CPU's."
^DIC(9.4,3,22,21,"PAH",41,1,64,0)="       "
^DIC(9.4,3,22,21,"PAH",41,1,65,0)=""
^DIC(9.4,3,22,21,"PAH",41,1,66,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",41,1,67,0)=""
^DIC(9.4,3,22,21,"PAH",42,0)="65 SEQ #56^2980330^1"
^DIC(9.4,3,22,21,"PAH",42,1,0)="^^98^98^2980330"
^DIC(9.4,3,22,21,"PAH",42,1,1,0)="HUN-0396-21050  XQAL*   Fix several small problems that cause errors in "
^DIC(9.4,3,22,21,"PAH",42,1,2,0)="HUN-0996-21721          special cases. Changed to use TMP from XUTL."
^DIC(9.4,3,22,21,"PAH",42,1,3,0)="Forum 24021577          If the user has a mix of Info and action alerts,"
^DIC(9.4,3,22,21,"PAH",42,1,4,0)="                        during processing of alerts the display will "
^DIC(9.4,3,22,21,"PAH",42,1,5,0)="                        stop before doing an action that could cause"
^DIC(9.4,3,22,21,"PAH",42,1,6,0)="                        info to scroll off the top."
^DIC(9.4,3,22,21,"PAH",42,1,7,0)="                      "
^DIC(9.4,3,22,21,"PAH",42,1,8,0)="CIRN            ZISHMSM  Fix the way that %ZISH under MSM open's multiple"
^DIC(9.4,3,22,21,"PAH",42,1,9,0)="                         host files."
^DIC(9.4,3,22,21,"PAH",42,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,11,0)="TUA-0997-30470  ZISH*    Fix to use the DEFAULT DIRECTORY FOR HFS field"
^DIC(9.4,3,22,21,"PAH",42,1,12,0)="CHY-1097-52881           in file 8989.3 (KSP). Fix use of recordsize to"
^DIC(9.4,3,22,21,"PAH",42,1,13,0)="                         match CIRN."
^DIC(9.4,3,22,21,"PAH",42,1,14,0)="                         "
^DIC(9.4,3,22,21,"PAH",42,1,15,0)="LAK-0897-30499           DEVICE file $I field length increased to 40 char.          "
^DIC(9.4,3,22,21,"PAH",42,1,16,0)="                         "
^DIC(9.4,3,22,21,"PAH",42,1,17,0)="AXP TEAM        ZOSFVXD  Disable priority changing, This has caused performance"
^DIC(9.4,3,22,21,"PAH",42,1,18,0)="                ZOSVVXD  problems when lower priority jobs hold locks on"
^DIC(9.4,3,22,21,"PAH",42,1,19,0)="                         critical code sections."
^DIC(9.4,3,22,21,"PAH",42,1,20,0)="                         "
^DIC(9.4,3,22,21,"PAH",42,1,21,0)="CHY-0597-50132   XUS91   Made a fix to make the code more robust."
^DIC(9.4,3,22,21,"PAH",42,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,23,0)="                         Fix description for rescheduling frequency. "
^DIC(9.4,3,22,21,"PAH",42,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,25,0)="               XUWORKDY  Fix problem if HOLIDAY file is missing."
^DIC(9.4,3,22,21,"PAH",42,1,26,0)="  "
^DIC(9.4,3,22,21,"PAH",42,1,27,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",42,1,28,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",42,1,29,0)="XQALDEL      13827021  12561210    **6,24,65**"
^DIC(9.4,3,22,21,"PAH",42,1,30,0)="XQALDOIT     10428734   9852030    **1,6,65**"
^DIC(9.4,3,22,21,"PAH",42,1,31,0)="XQALERT       5798541   5307017    **1,65**"
^DIC(9.4,3,22,21,"PAH",42,1,32,0)="XQALERT1     19524336  18178207    **20,65**"
^DIC(9.4,3,22,21,"PAH",42,1,33,0)="XQALFWD      10036386  10058961    **6,65**"
^DIC(9.4,3,22,21,"PAH",42,1,34,0)="XQALSET      13085815  12680442    **1,6,65**"
^DIC(9.4,3,22,21,"PAH",42,1,35,0)="XUINPCH       3256791   3950316    **20,36,43,49,63,65**"
^DIC(9.4,3,22,21,"PAH",42,1,36,0)="XUPARAM                 1006391    **65**"
^DIC(9.4,3,22,21,"PAH",42,1,37,0)="XUS91                   8526517    **18,65**"
^DIC(9.4,3,22,21,"PAH",42,1,38,0)="XUTMG43                  921517    **18,65**"
^DIC(9.4,3,22,21,"PAH",42,1,39,0)="XUWORKDY      1331031   1179273    **65**"
^DIC(9.4,3,22,21,"PAH",42,1,40,0)="ZISHMSM       5354551   5685657    **24,36,49,65**"
^DIC(9.4,3,22,21,"PAH",42,1,41,0)="ZISHONT                 5001907    **34,65**"
^DIC(9.4,3,22,21,"PAH",42,1,42,0)="ZISHVXD                 6891389    **24,36,65**"
^DIC(9.4,3,22,21,"PAH",42,1,43,0)="ZOSFVXD       7401132   7407077    **65**"
^DIC(9.4,3,22,21,"PAH",42,1,44,0)="ZOSVVXD       7519714   7658715    **13,65**"
^DIC(9.4,3,22,21,"PAH",42,1,45,0)="ZTPTCH        4509174   4561379    **44,65**"
^DIC(9.4,3,22,21,"PAH",42,1,46,0)="                                              "
^DIC(9.4,3,22,21,"PAH",42,1,47,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",42,1,48,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",42,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,50,0)=" 1.  Some of these routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",42,1,51,0)="     so you will need to disable mapping for the effected routines. "
^DIC(9.4,3,22,21,"PAH",42,1,52,0)="     "
^DIC(9.4,3,22,21,"PAH",42,1,53,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",42,1,54,0)="     option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",42,1,55,0)="     "
^DIC(9.4,3,22,21,"PAH",42,1,56,0)=" 3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",42,1,57,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",42,1,58,0)="     "
^DIC(9.4,3,22,21,"PAH",42,1,59,0)=" 4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",42,1,60,0)="      user are on the system and the possibility of some CLOBER/EDITED"
^DIC(9.4,3,22,21,"PAH",42,1,61,0)="      errors is acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",42,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,63,0)="     "
^DIC(9.4,3,22,21,"PAH",42,1,64,0)=" 5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",42,1,65,0)="     options:"
^DIC(9.4,3,22,21,"PAH",42,1,66,0)="     "
^DIC(9.4,3,22,21,"PAH",42,1,67,0)="        Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",42,1,68,0)="        Print Transport Global"
^DIC(9.4,3,22,21,"PAH",42,1,69,0)="        Compare Transport Global to Current System      "
^DIC(9.4,3,22,21,"PAH",42,1,70,0)="        Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",42,1,71,0)="        Install Package(s)  'XU*8.0*65'"
^DIC(9.4,3,22,21,"PAH",42,1,72,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",42,1,73,0)="        "
^DIC(9.4,3,22,21,"PAH",42,1,74,0)=" 6.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",42,1,75,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",42,1,76,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",42,1,77,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",42,1,78,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,79,0)="      ZISHMSM"
^DIC(9.4,3,22,21,"PAH",42,1,80,0)="      ZISHONT"
^DIC(9.4,3,22,21,"PAH",42,1,81,0)="      ZISHVXD"
^DIC(9.4,3,22,21,"PAH",42,1,82,0)="      ZOSFVXD"
^DIC(9.4,3,22,21,"PAH",42,1,83,0)="      ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",42,1,84,0)="    "
^DIC(9.4,3,22,21,"PAH",42,1,85,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",42,1,86,0)="      "
^DIC(9.4,3,22,21,"PAH",42,1,87,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",42,1,88,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",42,1,89,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",42,1,90,0)="      Patch number to load: 65"
^DIC(9.4,3,22,21,"PAH",42,1,91,0)="                            =="
^DIC(9.4,3,22,21,"PAH",42,1,92,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,93,0)=" 7.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",42,1,94,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,95,0)=" 8.   Enable user's login."
^DIC(9.4,3,22,21,"PAH",42,1,96,0)=""
^DIC(9.4,3,22,21,"PAH",42,1,97,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",42,1,98,0)=""
^DIC(9.4,3,22,21,"PAH",43,0)="73 SEQ #57^2980330^1"
^DIC(9.4,3,22,21,"PAH",43,1,0)="^^79^79^2980330"
^DIC(9.4,3,22,21,"PAH",43,1,1,0)="*** This patch is a high priority because it is needed by the OpenM ***"
^DIC(9.4,3,22,21,"PAH",43,1,2,0)="*** sites to adjust to changes made by Intersystem in build 52e that***"
^DIC(9.4,3,22,21,"PAH",43,1,3,0)="*** is going out to the sites.                                      ***"
^DIC(9.4,3,22,21,"PAH",43,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",43,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",43,1,6,0)="ISL-0198-51102  XUSTERM  Didn't have code to call the extended-action option"
^DIC(9.4,3,22,21,"PAH",43,1,7,0)="                         in XUSTERM2."
^DIC(9.4,3,22,21,"PAH",43,1,8,0)="                         "
^DIC(9.4,3,22,21,"PAH",43,1,9,0)="                XQ33    Fix from IHS about deleting options."
^DIC(9.4,3,22,21,"PAH",43,1,10,0)="                   "
^DIC(9.4,3,22,21,"PAH",43,1,11,0)="                ZTER    Change to allow OpenM sites to use the new error"
^DIC(9.4,3,22,21,"PAH",43,1,12,0)="                        trapping.  The check was conditional because early"
^DIC(9.4,3,22,21,"PAH",43,1,13,0)="                        versions didn't support this.  Then OpenM started"
^DIC(9.4,3,22,21,"PAH",43,1,14,0)="                        changing its name with each version. Fixed to remove"
^DIC(9.4,3,22,21,"PAH",43,1,15,0)="                        version checking, assume all VA site running current"
^DIC(9.4,3,22,21,"PAH",43,1,16,0)="                        version that supports standard error trapping."
^DIC(9.4,3,22,21,"PAH",43,1,17,0)="                        "
^DIC(9.4,3,22,21,"PAH",43,1,18,0)="                        The options XUDEV RES-ONE and XUDEV RES-CLEAR didn't"
^DIC(9.4,3,22,21,"PAH",43,1,19,0)="                        get linked to the XUTIO menu in patch 49."
^DIC(9.4,3,22,21,"PAH",43,1,20,0)="                        Resending to link them up."
^DIC(9.4,3,22,21,"PAH",43,1,21,0)="                        "
^DIC(9.4,3,22,21,"PAH",43,1,22,0)="BIL-0298-30193          Alert tracking file 8992.1 was missing field .08"
^DIC(9.4,3,22,21,"PAH",43,1,23,0)="                        to control retention of alerts."
^DIC(9.4,3,22,21,"PAH",43,1,24,0)="                        "
^DIC(9.4,3,22,21,"PAH",43,1,25,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",43,1,26,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",43,1,27,0)="XQ33          8946889   9007179    **49,73**"
^DIC(9.4,3,22,21,"PAH",43,1,28,0)="XUSTERM                14376497    **36,73**"
^DIC(9.4,3,22,21,"PAH",43,1,29,0)="ZTER         18727059  19441177    **8,18,32,24,36,63,73**"
^DIC(9.4,3,22,21,"PAH",43,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",43,1,31,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",43,1,32,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",43,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",43,1,34,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",43,1,35,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",43,1,36,0)="      "
^DIC(9.4,3,22,21,"PAH",43,1,37,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",43,1,38,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",43,1,39,0)="      "
^DIC(9.4,3,22,21,"PAH",43,1,40,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",43,1,41,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",43,1,42,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",43,1,43,0)="      options:"
^DIC(9.4,3,22,21,"PAH",43,1,44,0)="      "
^DIC(9.4,3,22,21,"PAH",43,1,45,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",43,1,46,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",43,1,47,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",43,1,48,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",43,1,49,0)="         "
^DIC(9.4,3,22,21,"PAH",43,1,50,0)=" 4.   Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",43,1,51,0)="      non-peek time."
^DIC(9.4,3,22,21,"PAH",43,1,52,0)="      "
^DIC(9.4,3,22,21,"PAH",43,1,53,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",43,1,54,0)="      option:"
^DIC(9.4,3,22,21,"PAH",43,1,55,0)="         Install Package(s)  'XU*8.0*73'"
^DIC(9.4,3,22,21,"PAH",43,1,56,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",43,1,57,0)="         "
^DIC(9.4,3,22,21,"PAH",43,1,58,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",43,1,59,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",43,1,60,0)="      "
^DIC(9.4,3,22,21,"PAH",43,1,61,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",43,1,62,0)="      DSM/MSM sites - you need to move one routines from "
^DIC(9.4,3,22,21,"PAH",43,1,63,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",43,1,64,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",43,1,65,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",43,1,66,0)="      "
^DIC(9.4,3,22,21,"PAH",43,1,67,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",43,1,68,0)="       "
^DIC(9.4,3,22,21,"PAH",43,1,69,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",43,1,70,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",43,1,71,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",43,1,72,0)="      Patch number to load: 73"
^DIC(9.4,3,22,21,"PAH",43,1,73,0)="                            =="
^DIC(9.4,3,22,21,"PAH",43,1,74,0)="       "
^DIC(9.4,3,22,21,"PAH",43,1,75,0)="  9.  MSM sites move these routines to the MGR accounts on other CPU's."
^DIC(9.4,3,22,21,"PAH",43,1,76,0)="        "
^DIC(9.4,3,22,21,"PAH",43,1,77,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",43,1,78,0)=" "
^DIC(9.4,3,22,21,"PAH",43,1,79,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",44,0)="60 SEQ #58^2980330^1"
^DIC(9.4,3,22,21,"PAH",44,1,0)="^^108^108^2980330"
^DIC(9.4,3,22,21,"PAH",44,1,1,0)="Prerequisites:"
^DIC(9.4,3,22,21,"PAH",44,1,2,0)="=========== "
^DIC(9.4,3,22,21,"PAH",44,1,3,0)="     The following patches must be installed before this patch: 44"
^DIC(9.4,3,22,21,"PAH",44,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,6,0)="Subject:"
^DIC(9.4,3,22,21,"PAH",44,1,7,0)="======"
^DIC(9.4,3,22,21,"PAH",44,1,8,0)="     XU*8*60   CORRECT NAMESPACE PROBLEM/FIX MICROSURGERY"
^DIC(9.4,3,22,21,"PAH",44,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,10,0)="     When the routine XUSHSHP was written to hash the signature block in"
^DIC(9.4,3,22,21,"PAH",44,1,11,0)="     file 200, several local variables were used which were not within the"
^DIC(9.4,3,22,21,"PAH",44,1,12,0)="     Kernel namespace.  As would be expected, at least one of the"
^DIC(9.4,3,22,21,"PAH",44,1,13,0)="     variables is now another namespace and conflicts have arisen.  This"
^DIC(9.4,3,22,21,"PAH",44,1,14,0)="     patch uses the NEW command to limit the scope of these incorrectly"
^DIC(9.4,3,22,21,"PAH",44,1,15,0)="     namespaced variables to the code in which they are used, and will"
^DIC(9.4,3,22,21,"PAH",44,1,16,0)="     prevent future problems with other packages due to this error."
^DIC(9.4,3,22,21,"PAH",44,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,18,0)="     Several alpha sites reported unusually high activity associated"
^DIC(9.4,3,22,21,"PAH",44,1,19,0)="     with the XUTL global.  This was identified as a problem related to "
^DIC(9.4,3,22,21,"PAH",44,1,20,0)="     a spuriously high date value being set into the ""AT"" cross "
^DIC(9.4,3,22,21,"PAH",44,1,21,0)="     reference in file 19.  Since this date was always ahead of NOW,"
^DIC(9.4,3,22,21,"PAH",44,1,22,0)="     micro-surgery would restart as soon as it had completed.  To "
^DIC(9.4,3,22,21,"PAH",44,1,23,0)="     correct this problem, this patch contains a change to XQ83 which "
^DIC(9.4,3,22,21,"PAH",44,1,24,0)="     will reset any of these spurious future nodes to NOW and stop this "
^DIC(9.4,3,22,21,"PAH",44,1,25,0)="     excess activity.  A change is also made in XQ7 which will prevent "
^DIC(9.4,3,22,21,"PAH",44,1,26,0)="     these nodes being set incorrectly in the future."
^DIC(9.4,3,22,21,"PAH",44,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,28,0)="     There have also been some reports of problems [NOIS CLA-0397-22395]"
^DIC(9.4,3,22,21,"PAH",44,1,29,0)="     associated with the value of ZTCPU being reset as a result of a call"
^DIC(9.4,3,22,21,"PAH",44,1,30,0)="     to KICK^XQ7 during KIDS installations.  This problem is corrected by"
^DIC(9.4,3,22,21,"PAH",44,1,31,0)="     NEWING the value ZTCPU before it is used in KICK^XQ7."
^DIC(9.4,3,22,21,"PAH",44,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,34,0)="Category:"
^DIC(9.4,3,22,21,"PAH",44,1,35,0)="======="
^DIC(9.4,3,22,21,"PAH",44,1,36,0)="     Routine"
^DIC(9.4,3,22,21,"PAH",44,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,39,0)="Test Sites :"
^DIC(9.4,3,22,21,"PAH",44,1,40,0)="=============="
^DIC(9.4,3,22,21,"PAH",44,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,43,0)="Routine Summary :"
^DIC(9.4,3,22,21,"PAH",44,1,44,0)="=============="
^DIC(9.4,3,22,21,"PAH",44,1,45,0)="     The following is a list of the routines included in this patch.  The"
^DIC(9.4,3,22,21,"PAH",44,1,46,0)="     second line of each of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",44,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,48,0)="    XQ7             <tab>;;8.0;KERNEL;**44,60**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",44,1,49,0)="    XQ83            <tab>;;8.0;KERNEL;**60**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",44,1,50,0)="    XUSHSHP         <tab>;;8.0;KERNEL;**60**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",44,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,53,0)="Routine Name                      Patch List"
^DIC(9.4,3,22,21,"PAH",44,1,54,0)="------------                     --------------"
^DIC(9.4,3,22,21,"PAH",44,1,55,0)="XQ7                                44,60"
^DIC(9.4,3,22,21,"PAH",44,1,56,0)="XQ83                               60"
^DIC(9.4,3,22,21,"PAH",44,1,57,0)="XUSHSHP                            60"
^DIC(9.4,3,22,21,"PAH",44,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,59,0)="Checksums:"
^DIC(9.4,3,22,21,"PAH",44,1,60,0)="========="
^DIC(9.4,3,22,21,"PAH",44,1,61,0)="  Rtn Nm           Chksum Before        Chksum After         Patch List"
^DIC(9.4,3,22,21,"PAH",44,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,63,0)="  XQ7                2506259              2523046             44,60"
^DIC(9.4,3,22,21,"PAH",44,1,64,0)="  XQ83               9490213             10007662             60"
^DIC(9.4,3,22,21,"PAH",44,1,65,0)="  XUSHSHP           11148336             11486766             60"
^DIC(9.4,3,22,21,"PAH",44,1,66,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,67,0)="  _X_ Used CHECK^XTSUMBLD     (or)    ___ Used KIDS option"
^DIC(9.4,3,22,21,"PAH",44,1,68,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,69,0)="     To test if the transport has been corrupted, you can use the "
^DIC(9.4,3,22,21,"PAH",44,1,70,0)="     ""Verify Package Integrity"" option.  This option is under Utilities "
^DIC(9.4,3,22,21,"PAH",44,1,71,0)="     under the KIDS menu.  It will compare the checksums in the build "
^DIC(9.4,3,22,21,"PAH",44,1,72,0)="     with the current checksums and list any that differ."
^DIC(9.4,3,22,21,"PAH",44,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,74,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,75,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",44,1,76,0)="==================="
^DIC(9.4,3,22,21,"PAH",44,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,78,0)="     1.   Users ARE allowed to be on the system during the "
^DIC(9.4,3,22,21,"PAH",44,1,79,0)="          installation.  However, since XQ83 is referenced during the"
^DIC(9.4,3,22,21,"PAH",44,1,80,0)="          log-on procedure, BRIEFLY INHIBITING LOGONS while the patch is"
^DIC(9.4,3,22,21,"PAH",44,1,81,0)="          installed is recommended"
^DIC(9.4,3,22,21,"PAH",44,1,82,0)="     2.   DO NOT place TaskMan in a WAIT/STOP state. "
^DIC(9.4,3,22,21,"PAH",44,1,83,0)="     3.   The routines in this patch are used in the background and"
^DIC(9.4,3,22,21,"PAH",44,1,84,0)="          will not normally affect journaling, compiled templates, or"
^DIC(9.4,3,22,21,"PAH",44,1,85,0)="          option usage."
^DIC(9.4,3,22,21,"PAH",44,1,86,0)="     4.   These routines are usually mapped on systems that allow "
^DIC(9.4,3,22,21,"PAH",44,1,87,0)="          mapping, so you will need to disable mapping for the affected"
^DIC(9.4,3,22,21,"PAH",44,1,88,0)="          routines."
^DIC(9.4,3,22,21,"PAH",44,1,89,0)="     5.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,3,22,21,"PAH",44,1,90,0)="          This option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",44,1,91,0)="     6.   The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",44,1,92,0)="          system. You now need to use KIDS to install the Transport"
^DIC(9.4,3,22,21,"PAH",44,1,93,0)="          global.  "
^DIC(9.4,3,22,21,"PAH",44,1,94,0)="     7.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,3,22,21,"PAH",44,1,95,0)="             following options: "
^DIC(9.4,3,22,21,"PAH",44,1,96,0)=" "
^DIC(9.4,3,22,21,"PAH",44,1,97,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",44,1,98,0)="           Print Transport Global "
^DIC(9.4,3,22,21,"PAH",44,1,99,0)="           Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",44,1,100,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",44,1,101,0)="           Install Package(s) "
^DIC(9.4,3,22,21,"PAH",44,1,102,0)="           INSTALL NAME: XU*8.0*60"
^DIC(9.4,3,22,21,"PAH",44,1,103,0)="                                          ========="
^DIC(9.4,3,22,21,"PAH",44,1,104,0)="     8.   MSM Sites - Answer YES to the question 'Want to MOVE "
^DIC(9.4,3,22,21,"PAH",44,1,105,0)="                      routines to other CPUs?'. Enter the names of your "
^DIC(9.4,3,22,21,"PAH",44,1,106,0)="                      Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",44,1,107,0)="           AXP Sites - Answer NO to this question."
^DIC(9.4,3,22,21,"PAH",44,1,108,0)="     9.   Rebuild your mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",45,0)="71 SEQ #59^2980330^1"
^DIC(9.4,3,22,21,"PAH",45,1,0)="^^104^104^2980330"
^DIC(9.4,3,22,21,"PAH",45,1,1,0)="This patch includes routines that either needed change because of Y2K"
^DIC(9.4,3,22,21,"PAH",45,1,2,0)="analysis or provide new date formats for others to use."
^DIC(9.4,3,22,21,"PAH",45,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",45,1,4,0)="See the Web page to see the new formats available with FMTE^XLFDT and"
^DIC(9.4,3,22,21,"PAH",45,1,5,0)="HTE^XLFDT. "
^DIC(9.4,3,22,21,"PAH",45,1,6,0)=" http://www.vista.domain.ext/softserv/infrastr.uct/kernel/y2k/index.html"
^DIC(9.4,3,22,21,"PAH",45,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",45,1,8,0)="Here is a sample,  Note the NEW values for y.  5, 6, 7 "
^DIC(9.4,3,22,21,"PAH",45,1,9,0)="$$FMTE(x[,y])"
^DIC(9.4,3,22,21,"PAH",45,1,10,0)="VA FileMan to External"
^DIC(9.4,3,22,21,"PAH",45,1,11,0)="       Return conversion to an external format of a date in VA FileMan format."
^DIC(9.4,3,22,21,"PAH",45,1,12,0)="       arguments:  x  VA FileMan date"
^DIC(9.4,3,22,21,"PAH",45,1,13,0)="                   y  [optional] Affects output as follows:"
^DIC(9.4,3,22,21,"PAH",45,1,14,0)="               If '$D(y) then return standard VA FileMan format."
^DIC(9.4,3,22,21,"PAH",45,1,15,0)="               If +y = 1 then return standard VA FileMan format."
^DIC(9.4,3,22,21,"PAH",45,1,16,0)="               If +y = 2 then return MM/DD/YY@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",45,1,17,0)="               If +y = 3 then return DD/MM/YY@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",45,1,18,0)="               If +y = 4 then return YY/MM/DD@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",45,1,19,0)="               If +y = 5 then return MM/DD/YYYYHH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",45,1,20,0)="               If +y = 6 then return DD/MM/YYYY@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",45,1,21,0)="               If +y = 7 then return YYYY/MM/DD@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",45,1,22,0)="               If y contains ""D"" then Date only."
^DIC(9.4,3,22,21,"PAH",45,1,23,0)="               If y contains ""F"" then output date with leading blanks."
^DIC(9.4,3,22,21,"PAH",45,1,24,0)="               If y contains ""P"" then output ""HH:MM:SS am/pm""."
^DIC(9.4,3,22,21,"PAH",45,1,25,0)="               If y contains ""M"" then output ""HH:MM"" only."
^DIC(9.4,3,22,21,"PAH",45,1,26,0)="               If y contains ""S"" then force seconds in the output."
^DIC(9.4,3,22,21,"PAH",45,1,27,0)="               If y contains ""Z"" then output date with leading zeros."
^DIC(9.4,3,22,21,"PAH",45,1,28,0)="               "
^DIC(9.4,3,22,21,"PAH",45,1,29,0)="               W $$HTE^XLFDT(""54786,40523"")      --> Dec 31, 1990@11:15:23"
^DIC(9.4,3,22,21,"PAH",45,1,30,0)="               W $$HTE^XLFDT(""54786,40523"",2)    --> 12/31/90@11:15:23"
^DIC(9.4,3,22,21,"PAH",45,1,31,0)="               W $$FMTE^XLFDT(2940629.105744,1)  --> Jun 29, 1994@10:57:44"
^DIC(9.4,3,22,21,"PAH",45,1,32,0)="               W $$FMTE^XLFDT(2940629.105744,""2M"") --> 6/29/94@10:57"
^DIC(9.4,3,22,21,"PAH",45,1,33,0)="               W $$FMTE^XLFDT(2940629.1057,""2S"") --> 6/29/94@10:57:00"
^DIC(9.4,3,22,21,"PAH",45,1,34,0)="               W $$FMTE^XLFDT(2940629.1057,""4D"") --> 94/6/29"
^DIC(9.4,3,22,21,"PAH",45,1,35,0)="               W $$FMTE^XLFDT(2940629.1057,""1P"") --> Jun 29, 1994 10:57 am"
^DIC(9.4,3,22,21,"PAH",45,1,36,0)="               W $$FMTE^XLFDT(2940629.1057,""2P"") --> 6/29/94 10:57 am"
^DIC(9.4,3,22,21,"PAH",45,1,37,0)="               W $$FMTE^XLFDT(3000229.1105,""5"")  --> 2/29/2000@11:05"
^DIC(9.4,3,22,21,"PAH",45,1,38,0)="               W $$FMTE^XLFDT(3000229.1105,""5ZP"") --> 02/29/2000 11:05 am"
^DIC(9.4,3,22,21,"PAH",45,1,39,0)="               W $$FMTE^XLFDT(3000229.1105,""5F"") -->  2/29/2000@11:05"
^DIC(9.4,3,22,21,"PAH",45,1,40,0)="               W $$FMTE^XLFDT(3000229.1105,""6Z"") --> 29/02/2000@11:05"
^DIC(9.4,3,22,21,"PAH",45,1,41,0)="               W $$FMTE^XLFDT(3000301.1105,""7"")  --> 2000/3/1@11:05"
^DIC(9.4,3,22,21,"PAH",45,1,42,0)=""
