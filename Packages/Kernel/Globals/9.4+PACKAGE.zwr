^DIC(9.4,73,22,9,"PAH",14,1,27,0)="   =================="
^DIC(9.4,73,22,9,"PAH",14,1,28,0)="     Nasville, Tampa"
^DIC(9.4,73,22,9,"PAH",14,1,29,0)="  "
