^DIC(9.4,28,11)="2100^2101"
^DIC(9.4,28,22,0)="^9.49I^6^1"
^DIC(9.4,28,22,6,0)="2.0^3051119^2960611"
^DIC(9.4,28,22,6,"PAH",0)="^9.4901^20^20"
^DIC(9.4,28,22,6,"PAH",1,0)="17 SEQ #16^2980725^1"
^DIC(9.4,28,22,6,"PAH",1,1,0)="^^112^112^2980725"
^DIC(9.4,28,22,6,"PAH",1,1,1,0)="1. CTX-0798-70193, WBP-0798-20679."
^DIC(9.4,28,22,6,"PAH",1,1,2,0)="This patch(GEC*2.0*17) will correct problems associated with"
^DIC(9.4,28,22,6,"PAH",1,1,3,0)="patch(GEC*2.0*16).  Patch 16 was designed to allow Generic Code Sheet to"
^DIC(9.4,28,22,6,"PAH",1,1,4,0)="accept four (4) digits for the year (ex. 1998).  These changes were not"
^DIC(9.4,28,22,6,"PAH",1,1,5,0)="compatible with Austin, TX and certain AMIS code sheets were rejected."
^DIC(9.4,28,22,6,"PAH",1,1,6,0)="Patch GEC*2.0*16 has been entered in error.  Patch (GEC*2.0*17) contains"
^DIC(9.4,28,22,6,"PAH",1,1,7,0)="fields from file 2100 which will allow entry and acceptance of two (2)"
^DIC(9.4,28,22,6,"PAH",1,1,8,0)="digits for the year (ex. 98).  Below are a list of instructions for sites"
^DIC(9.4,28,22,6,"PAH",1,1,9,0)="to follow:"
^DIC(9.4,28,22,6,"PAH",1,1,10,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,11,0)="SITES THAT HAVE NOT INSTALLED PATCH GEC*2.0*16, SHOULD NOT INSTALL THIS"
^DIC(9.4,28,22,6,"PAH",1,1,12,0)="PATCH."
^DIC(9.4,28,22,6,"PAH",1,1,13,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,14,0)="SITES THAT HAVE INSTALLED GEC*2.0*16 SHOULD INSTALL PATCH GEC*2.0*17, THIS"
^DIC(9.4,28,22,6,"PAH",1,1,15,0)="PATCH INCLUDES FIELDS THAT ARE CHANGED BACK TO THEIR ORIGINAL STATE PRIOR"
^DIC(9.4,28,22,6,"PAH",1,1,16,0)="TO PATCH 16."
^DIC(9.4,28,22,6,"PAH",1,1,17,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,18,0)="SITES THAT HAD PROBLEMS WITH FEE BASIS CODE SHEETS 994.10 AFTER"
^DIC(9.4,28,22,6,"PAH",1,1,19,0)="INSTALLATION OF GEC*2.0*16, SHOULD INSTALL THIS PATCH.  THEN CREATE,"
^DIC(9.4,28,22,6,"PAH",1,1,20,0)="MARK, BATCH AND TRANSMIT CODE SHEETS AGAIN TO ENSURE ACCEPTANCE OF"
^DIC(9.4,28,22,6,"PAH",1,1,21,0)="NEW CODE SHEETS."
^DIC(9.4,28,22,6,"PAH",1,1,22,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,23,0)="ALL AMIS CODE SHEETS THAT REJECTED AFTER INSTALLATION OF PATCH GEC*2.0*16"
^DIC(9.4,28,22,6,"PAH",1,1,24,0)="SHOULD CREATE, MARK, BATCH AND TRANSMIT CODE SHEETS AGAIN TO ENSURE"
^DIC(9.4,28,22,6,"PAH",1,1,25,0)="ACCEPTANCE OF NEW CODE SHEETS."
^DIC(9.4,28,22,6,"PAH",1,1,26,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,27,0)="Below is listing of fields that were revised."
^DIC(9.4,28,22,6,"PAH",1,1,28,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,29,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,30,0)="Field number      Field name                Patch 16        Patch 17"
^DIC(9.4,28,22,6,"PAH",1,1,31,0)="============      ==========                ========        ========"
^DIC(9.4,28,22,6,"PAH",1,1,32,0)="208               Birth Date                mmyyyy          mmyy"
