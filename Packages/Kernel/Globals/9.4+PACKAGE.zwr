^DIC(9.4,14,22,5.9,"PAH",249,0)="424 SEQ #347^3140306.100432^17"
^DIC(9.4,14,22,5.9,"PAH",249,1,0)="^^6^6^3140306"
^DIC(9.4,14,22,5.9,"PAH",249,1,1,0)="This patch will resolve the following issues in the Laboratory package:"
^DIC(9.4,14,22,5.9,"PAH",249,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",249,1,3,0)="-Lab test accessioned without appropriate accession area"
^DIC(9.4,14,22,5.9,"PAH",249,1,4,0)="-<SUBSCRIPT> error when using Enter/verify data (auto instrument) option"
^DIC(9.4,14,22,5.9,"PAH",249,1,5,0)="-<UNDEFINED> error when editing Autopsy Acc #"
^DIC(9.4,14,22,5.9,"PAH",249,1,6,0)="-LOINC code not appearing in panel tests"
^DIC(9.4,14,22,5.9,"PAH",250,0)="434 SEQ #348^3140319.112907^17"
^DIC(9.4,14,22,5.9,"PAH",250,1,0)="^^8^8^3140319"
^DIC(9.4,14,22,5.9,"PAH",250,1,1,0)="This patch is a VM patch that addresses 2 issues in the Lab package."
^DIC(9.4,14,22,5.9,"PAH",250,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",250,1,3,0)="1. Incomplete test definition leads to ""ghost"" tests showing up in"
^DIC(9.4,14,22,5.9,"PAH",250,1,4,0)="   CPRS (Computerized Patient Record System)."
^DIC(9.4,14,22,5.9,"PAH",250,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",250,1,6,0)="2. Panel tests sometimes get wrong urgency stored in file"
^DIC(9.4,14,22,5.9,"PAH",250,1,7,0)="   #68 (ACCESSION) when ordered with an atomic test with a higher"
^DIC(9.4,14,22,5.9,"PAH",250,1,8,0)="   urgency than the panel test."
^DIC(9.4,14,22,5.9,"PAH",251,0)="440 SEQ #349^3140709.153322^17"
^DIC(9.4,14,22,5.9,"PAH",251,1,0)="^^8^8^3140709"
^DIC(9.4,14,22,5.9,"PAH",251,1,1,0)="This patch is a VM patch that addresses 3 issues in the Lab package:"
^DIC(9.4,14,22,5.9,"PAH",251,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",251,1,3,0)="1.      Some data in file 69 is overlaid (wiped out) during"
^DIC(9.4,14,22,5.9,"PAH",251,1,4,0)="        accessioning."
^DIC(9.4,14,22,5.9,"PAH",251,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",251,1,6,0)="2.      A DC'ed test (discontinued) was accessioned."
^DIC(9.4,14,22,5.9,"PAH",251,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",251,1,8,0)="3.      Some panel tests not going to PCE."
^DIC(9.4,14,22,5.9,"PAH",252,0)="428 SEQ #350^3140807.100802^17"
^DIC(9.4,14,22,5.9,"PAH",252,1,0)="^^3^3^3140807"
^DIC(9.4,14,22,5.9,"PAH",252,1,1,0)="1. Cannot add NHCU station number to Associated Division in File #68"
^DIC(9.4,14,22,5.9,"PAH",252,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",252,1,3,0)="2. AP Edit Log-In option handles patient location edit incorrect"
^DIC(9.4,14,22,5.9,"PAH",253,0)="422 SEQ #351^3140818.120322^17"
^DIC(9.4,14,22,5.9,"PAH",254,0)="421 SEQ #352^3140818.12033^17"
^DIC(9.4,14,22,5.9,"PAH",254,1,0)="^^3^3^3140818"
^DIC(9.4,14,22,5.9,"PAH",254,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",254,1,2,0)="This patch will modify routine LRPHLIST (collection label print)"
^DIC(9.4,14,22,5.9,"PAH",254,1,3,0)="to allow the print job to be queued to a printer through TASKMAN."
^DIC(9.4,14,22,5.9,"PAH",255,0)="437 SEQ #353^3140910.105954^17"
^DIC(9.4,14,22,5.9,"PAH",255,1,0)="^^8^8^3140910"
^DIC(9.4,14,22,5.9,"PAH",255,1,1,0)="This patch is a VM patch that addresses 3 issues in the Lab package."
^DIC(9.4,14,22,5.9,"PAH",255,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",255,1,3,0)="1.      Execute code does not perform correctly when a lab test is added "
^DIC(9.4,14,22,5.9,"PAH",255,1,4,0)="        to a previously verified accession."
^DIC(9.4,14,22,5.9,"PAH",255,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",255,1,6,0)="2.      Convert delta checks to new format."
^DIC(9.4,14,22,5.9,"PAH",255,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",255,1,8,0)="3.      <STORE> error when array fills up in micro"
^DIC(9.4,14,22,5.9,"PAH",256,0)="441 SEQ #354^3141031.155642^17"
^DIC(9.4,14,22,5.9,"PAH",257,0)="446 SEQ #355^3141208.165729^17"
^DIC(9.4,14,22,5.9,"PAH",257,1,0)="^^7^7^3141208"
^DIC(9.4,14,22,5.9,"PAH",257,1,1,0)="This patch is a VM patch that addresses 3 issues in the Lab package:"
^DIC(9.4,14,22,5.9,"PAH",257,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",257,1,3,0)="1.      Semi-colon in lab test name prevents results entry."
^DIC(9.4,14,22,5.9,"PAH",257,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",257,1,5,0)="2.      Confusing times in phlebotomy log."
^DIC(9.4,14,22,5.9,"PAH",257,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",257,1,7,0)="3.      No warnings when panel test can't be accessioned."
^DIC(9.4,14,22,5.9,"PAH",258,0)="444 SEQ #356^3150108.101935^17"
^DIC(9.4,14,22,5.9,"PAH",258,1,0)="^^13^13^3150108"
^DIC(9.4,14,22,5.9,"PAH",258,1,1,0)="This patch is a VM patch that addresses 5 issues in the Lab package:"
^DIC(9.4,14,22,5.9,"PAH",258,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",258,1,3,0)="1.      Properly defined tests on an order not accessioning when one"
^DIC(9.4,14,22,5.9,"PAH",258,1,4,0)="        test is not properly defined."
^DIC(9.4,14,22,5.9,"PAH",258,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",258,1,6,0)="2.      Improperly defined test causes subsequent tests/orders to not"
^DIC(9.4,14,22,5.9,"PAH",258,1,7,0)="        be accessioned."
^DIC(9.4,14,22,5.9,"PAH",258,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",258,1,9,0)="3.      No warnings when panel test can't be accessioned."
^DIC(9.4,14,22,5.9,"PAH",258,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",258,1,11,0)="4.      Howdy accessioning sometimes generates an <UNDEFINED> error."
^DIC(9.4,14,22,5.9,"PAH",258,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",258,1,13,0)="5.      Accession labels sometimes don't print in Howdy."
^DIC(9.4,14,22,5.9,"PAH",259,0)="439 SEQ #357^3150108.161047^17"
^DIC(9.4,14,22,5.9,"PAH",259,1,0)="^^5^5^3150108"
^DIC(9.4,14,22,5.9,"PAH",259,1,1,0)="This patch is a VM patch that addresses 2 issues in the Lab package."
^DIC(9.4,14,22,5.9,"PAH",259,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",259,1,3,0)="1.      Results can be entered on a test that is being cancelled."
^DIC(9.4,14,22,5.9,"PAH",259,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",259,1,5,0)="2.      Problems with a date/time stamp in LRUMDP."
^DIC(9.4,14,22,5.9,"PAH",260,0)="438 SEQ #358^3150223.124551^17"
^DIC(9.4,14,22,5.9,"PAH",260,1,0)="^^134^134^3150223"
^DIC(9.4,14,22,5.9,"PAH",260,1,1,0)="The patch addresses three (3) issues:"
^DIC(9.4,14,22,5.9,"PAH",260,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,3,0)="1.      Users report being unable to perform MRSA testing on deceased "
^DIC(9.4,14,22,5.9,"PAH",260,1,4,0)="patients but they are allowed to proceed through the accessioning process "
^DIC(9.4,14,22,5.9,"PAH",260,1,5,0)="without an early warning that the test has been cancelled."
^DIC(9.4,14,22,5.9,"PAH",260,1,6,0)="2.      LRGEN skips rows of results when the SITE/SPECIMEN prompt is "
^DIC(9.4,14,22,5.9,"PAH",260,1,7,0)="answered with the default (ANY) and it frequently displays/prints "
^DIC(9.4,14,22,5.9,"PAH",260,1,8,0)="unnecessary headers."
^DIC(9.4,14,22,5.9,"PAH",260,1,9,0)="3.      Under certain circumstances, the Group Verify (GA) option allows "
^DIC(9.4,14,22,5.9,"PAH",260,1,10,0)="the verification of results marked as Not Performed."
^DIC(9.4,14,22,5.9,"PAH",260,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,12,0)="Associated NSR(s):"
^DIC(9.4,14,22,5.9,"PAH",260,1,13,0)="------------------"
^DIC(9.4,14,22,5.9,"PAH",260,1,14,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",260,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,16,0)="Associated Remedy ticket(s):"
^DIC(9.4,14,22,5.9,"PAH",260,1,17,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",260,1,18,0)="1.      INC000000500271 - MRSA testing on death"
^DIC(9.4,14,22,5.9,"PAH",260,1,19,0)="2.      INC000000069164 - LRGEN missing results"
^DIC(9.4,14,22,5.9,"PAH",260,1,20,0)="-       INC000000069285 (d)"
^DIC(9.4,14,22,5.9,"PAH",260,1,21,0)="-       INC000000069419 (d)"
^DIC(9.4,14,22,5.9,"PAH",260,1,22,0)="-       INC000000180798 (d)"
^DIC(9.4,14,22,5.9,"PAH",260,1,23,0)="-       INC000000069205 (d)"
^DIC(9.4,14,22,5.9,"PAH",260,1,24,0)="3. INC000000937699 - Group Verify ignoring NP"
^DIC(9.4,14,22,5.9,"PAH",260,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,26,0)="Associated NSR(s):"
^DIC(9.4,14,22,5.9,"PAH",260,1,27,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",260,1,28,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",260,1,29,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,30,0)="Participating Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",260,1,31,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",260,1,32,0)="TBD"
^DIC(9.4,14,22,5.9,"PAH",260,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,34,0)="Remedy Overview:"
^DIC(9.4,14,22,5.9,"PAH",260,1,35,0)="================"
^DIC(9.4,14,22,5.9,"PAH",260,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,37,0)="1.      INC000000500271 - MRSA Testing on Death"
^DIC(9.4,14,22,5.9,"PAH",260,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,39,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",260,1,40,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",260,1,41,0)="Laboratory staff indicates that they are not able to perform MRSA testing "
^DIC(9.4,14,22,5.9,"PAH",260,1,42,0)="on patients who are deceased.  The application will not allow them to "
^DIC(9.4,14,22,5.9,"PAH",260,1,43,0)="accession specimens or enter results for the MRSA test on deceased "
^DIC(9.4,14,22,5.9,"PAH",260,1,44,0)="patients. Further, the user is allowed to progress through the "
^DIC(9.4,14,22,5.9,"PAH",260,1,45,0)="accessioning session without an early warning that an order has been "
^DIC(9.4,14,22,5.9,"PAH",260,1,46,0)="canceled."
^DIC(9.4,14,22,5.9,"PAH",260,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,48,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",260,1,49,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",260,1,50,0)="To avoid having MRSA tests cancelled at either patient death or "
^DIC(9.4,14,22,5.9,"PAH",260,1,51,0)="discharge, the desired test should be added as an Exempt Orderable Item "
^DIC(9.4,14,22,5.9,"PAH",260,1,52,0)="for the Death and/or Discharge event in the Delayed Orders/Auto-DC Set-up "
^DIC(9.4,14,22,5.9,"PAH",260,1,53,0)="function."
^DIC(9.4,14,22,5.9,"PAH",260,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,55,0)="Additionally, the routine LROE is modified to provide clear, early "
^DIC(9.4,14,22,5.9,"PAH",260,1,56,0)="feedback to the user that a test has been cancelled and will not be "
^DIC(9.4,14,22,5.9,"PAH",260,1,57,0)="accessioned."
^DIC(9.4,14,22,5.9,"PAH",260,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,59,0)="2.      INC000000069164 - LRGEN Missing Results"
^DIC(9.4,14,22,5.9,"PAH",260,1,60,0)="  "
^DIC(9.4,14,22,5.9,"PAH",260,1,61,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",260,1,62,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",260,1,63,0)="The defect occurs when using the LRGEN option (General report for "
^DIC(9.4,14,22,5.9,"PAH",260,1,64,0)="selected tests) and when there are more than six (6) analytes on the "
^DIC(9.4,14,22,5.9,"PAH",260,1,65,0)="selected tests.  When the SITE/SPECIMEN prompt is answered with the "
^DIC(9.4,14,22,5.9,"PAH",260,1,66,0)="default (ANY), the application only displays the first set of headings "
^DIC(9.4,14,22,5.9,"PAH",260,1,67,0)="and results - that is: it only properly displays the first six results "
^DIC(9.4,14,22,5.9,"PAH",260,1,68,0)="and skips the remaining results.  This typically occurs on the results "
^DIC(9.4,14,22,5.9,"PAH",260,1,69,0)="for the last date of service.  Though no results are displayed, "
^DIC(9.4,14,22,5.9,"PAH",260,1,70,0)="unnecessary headers are displayed or printed."
^DIC(9.4,14,22,5.9,"PAH",260,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,72,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",260,1,73,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",260,1,74,0)="Multiple modifications and the addition of a function to routine LRGEN1, "
^DIC(9.4,14,22,5.9,"PAH",260,1,75,0)="correct the missing results and unnecessary header issues."
^DIC(9.4,14,22,5.9,"PAH",260,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,77,0)="3.      INC000000937699 - Group Verify Ignoring NP"
^DIC(9.4,14,22,5.9,"PAH",260,1,78,0)="  "
^DIC(9.4,14,22,5.9,"PAH",260,1,79,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",260,1,80,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",260,1,81,0)="When Group Verify (GA) is used to verify results for a Work Load Area "
^DIC(9.4,14,22,5.9,"PAH",260,1,82,0)="that contains accessions that have tests that have been marked as Not "
^DIC(9.4,14,22,5.9,"PAH",260,1,83,0)="Performed on a prior date, the option can erroneously verify results that "
^DIC(9.4,14,22,5.9,"PAH",260,1,84,0)="may have been entered for the accession."
^DIC(9.4,14,22,5.9,"PAH",260,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,86,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",260,1,87,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",260,1,88,0)="A modification to routine LRGV2 prevents the verification of any results "
^DIC(9.4,14,22,5.9,"PAH",260,1,89,0)="that may be associated with Not Performed test(s)."
^DIC(9.4,14,22,5.9,"PAH",260,1,90,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,91,0)="Components:"
^DIC(9.4,14,22,5.9,"PAH",260,1,92,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",260,1,93,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",260,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,95,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",260,1,96,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",260,1,97,0)="   The install time for this patch is less than 2 minutes. This patch can"
^DIC(9.4,14,22,5.9,"PAH",260,1,98,0)="   be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",260,1,99,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,100,0)="   NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",260,1,101,0)="         problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",260,1,102,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,103,0)="   1. Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",260,1,104,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",260,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,106,0)="   2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",260,1,107,0)="      system. You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",260,1,108,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,109,0)="   3. On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",260,1,110,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",260,1,111,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,112,0)="   4. Use the 'Verify Checksum in Transport Global' option and verify"
^DIC(9.4,14,22,5.9,"PAH",260,1,113,0)="      that all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",260,1,114,0)="    "
^DIC(9.4,14,22,5.9,"PAH",260,1,115,0)="   5. On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",260,1,116,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",260,1,117,0)="              Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",260,1,118,0)="              Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",260,1,119,0)="              Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",260,1,120,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,121,0)="      To preserve a copy of the routines exported in this patch prior to "
^DIC(9.4,14,22,5.9,"PAH",260,1,122,0)="      installation, you should use the 'Backup a Transport Global' option "
^DIC(9.4,14,22,5.9,"PAH",260,1,123,0)="      at this time. You may also compare the routines in your production"
^DIC(9.4,14,22,5.9,"PAH",260,1,124,0)="      account to the routines in the patch by using the 'Compare a"
^DIC(9.4,14,22,5.9,"PAH",260,1,125,0)="      Transport Global to Current System' option."
^DIC(9.4,14,22,5.9,"PAH",260,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,127,0)="   6. Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",260,1,128,0)="      and select the package 'LR*5.2*438'."
^DIC(9.4,14,22,5.9,"PAH",260,1,129,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,130,0)="      If prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//,"
^DIC(9.4,14,22,5.9,"PAH",260,1,131,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",260,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",260,1,133,0)="      If prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",260,1,134,0)="      Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",261,0)="449 SEQ #359^3150303.103803^17"
^DIC(9.4,14,22,5.9,"PAH",261,1,0)="^^7^7^3150303"
^DIC(9.4,14,22,5.9,"PAH",261,1,1,0)="This patch is a VM patch that addresses 3 issues in the Lab package:"
^DIC(9.4,14,22,5.9,"PAH",261,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",261,1,3,0)="1.      Time ignored in searching date/time period."
^DIC(9.4,14,22,5.9,"PAH",261,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",261,1,5,0)="2.      Units can be wrong in Search options."
^DIC(9.4,14,22,5.9,"PAH",261,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",261,1,7,0)="3.      EGRF issue related to patient sex."
^DIC(9.4,14,22,5.9,"PAH",262,0)="448 SEQ #360^3150316.160913^17"
^DIC(9.4,14,22,5.9,"PAH",262,1,0)="^^6^6^3150316"
^DIC(9.4,14,22,5.9,"PAH",262,1,1,0)="This patch is a VM patch that addresses 2 issues related to CPT coding"
^DIC(9.4,14,22,5.9,"PAH",262,1,2,0)="(Current Procedural Terminology) in the Laboratory package:"
^DIC(9.4,14,22,5.9,"PAH",262,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",262,1,4,0)="1.      Problems with ES Display List selections."
^DIC(9.4,14,22,5.9,"PAH",262,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",262,1,6,0)="2.      Active CPT codes in file 64 are rejected as inactive."
^DIC(9.4,14,22,5.9,"PAH",263,0)="445 SEQ #361^3150323.110231^17"
^DIC(9.4,14,22,5.9,"PAH",263,1,0)="^^10^10^3150323"
^DIC(9.4,14,22,5.9,"PAH",263,1,1,0)="The patch addresses four (4) issues:"
^DIC(9.4,14,22,5.9,"PAH",263,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",263,1,3,0)="1.      Clinical Reminder programs are referencing an incorrect subfield "
^DIC(9.4,14,22,5.9,"PAH",263,1,4,0)="when retrieving a lab test pointer."
^DIC(9.4,14,22,5.9,"PAH",263,1,5,0)="2.      When printing Future Labels, a Unique Identifier (UID) for an"
^DIC(9.4,14,22,5.9,"PAH",263,1,6,0)="unrelated order can occasionally print on the label."
^DIC(9.4,14,22,5.9,"PAH",263,1,7,0)="3.      In certain circumstances, lab results are not transmitted to the "
^DIC(9.4,14,22,5.9,"PAH",263,1,8,0)="Health Data Repository (HDR)."
^DIC(9.4,14,22,5.9,"PAH",263,1,9,0)="4.      When the Infection Control Survey Report is run specifying "
^DIC(9.4,14,22,5.9,"PAH",263,1,10,0)="un-queued output to P-Message, a Cache NOT OPEN error occurs."
^DIC(9.4,14,22,5.9,"PAH",264,0)="442^3150916.111011^17"
^DIC(9.4,14,22,5.9,"PAH",265,0)="450 SEQ #363^3150929.141044^17"
^DIC(9.4,14,22,5.9,"PAH",265,1,0)="^^8^8^3150929"
^DIC(9.4,14,22,5.9,"PAH",265,1,1,0)="The patch addresses three (3) issues:"
^DIC(9.4,14,22,5.9,"PAH",265,1,2,0)="1. Under certain conditions, the Anatomic Pathology option LRAPKILL"
^DIC(9.4,14,22,5.9,"PAH",265,1,3,0)="   (Delete accession #, anat path) gives the user ambiguous feedback"
^DIC(9.4,14,22,5.9,"PAH",265,1,4,0)="   about whether the delete of the accession was successful."
^DIC(9.4,14,22,5.9,"PAH",265,1,5,0)="2. The ORDERED TESTS BY PHY option misses AP and Howdy tests when an"
^DIC(9.4,14,22,5.9,"PAH",265,1,6,0)="   Accessioning Division is specified."
^DIC(9.4,14,22,5.9,"PAH",265,1,7,0)="3. Orders generated in CPRS and rejected in VBECS can be accessioned"
^DIC(9.4,14,22,5.9,"PAH",265,1,8,0)="   in VistA Lab."
^DIC(9.4,14,22,5.9,"PAH",266,0)="459 SEQ #364^3151015.122249^17"
^DIC(9.4,14,22,5.9,"PAH",266,1,0)="^^5^5^3151015"
^DIC(9.4,14,22,5.9,"PAH",266,1,1,0)="This patch is a VM patch that addresses 2 issues in the Lab package."
^DIC(9.4,14,22,5.9,"PAH",266,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",266,1,3,0)="1.      Lab results search routine expands start/end search times."
^DIC(9.4,14,22,5.9,"PAH",266,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",266,1,5,0)="2.      QC labels print with accession labels."
^DIC(9.4,14,22,5.9,"PAH",267,0)="455 SEQ #365^3151103.104122^17"
^DIC(9.4,14,22,5.9,"PAH",268,0)="453 SEQ #366^3160105.130303^54"
^DIC(9.4,14,22,5.9,"PAH",268,1,0)="^^18^18^3160105"
^DIC(9.4,14,22,5.9,"PAH",268,1,1,0)="This patch addresses four (4) issues:"
^DIC(9.4,14,22,5.9,"PAH",268,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",268,1,3,0)="1. The shipping manifest identifier is not shown on the Incomplete Status "
^DIC(9.4,14,22,5.9,"PAH",268,1,4,0)="   List (LRWRKINC) when printing the extended display."
^DIC(9.4,14,22,5.9,"PAH",268,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",268,1,6,0)="2. The test status may not be correctly reflected on the Incomplete "
^DIC(9.4,14,22,5.9,"PAH",268,1,7,0)="   Status List (LRWRKINC)."
^DIC(9.4,14,22,5.9,"PAH",268,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",268,1,9,0)="3. Information such as report release date and time, performing "
^DIC(9.4,14,22,5.9,"PAH",268,1,10,0)="   laboratory, and ordering provider are displaying in CPRS Laboratory"
^DIC(9.4,14,22,5.9,"PAH",268,1,11,0)="   progress notes for a patient's ordered test even though results are not"
^DIC(9.4,14,22,5.9,"PAH",268,1,12,0)="   verified for that test."
^DIC(9.4,14,22,5.9,"PAH",268,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",268,1,14,0)="4. Multiple updates to Microbiology preliminary comments sent by the "
^DIC(9.4,14,22,5.9,"PAH",268,1,15,0)="   Laboratory Electronic Data Interchange (LEDI) host site are not stored"
^DIC(9.4,14,22,5.9,"PAH",268,1,16,0)="   by the LEDI collecting site in the patient's record if the STORE"
^DIC(9.4,14,22,5.9,"PAH",268,1,17,0)="   DUPLICATE COMMENTS (#2.2) sub-field of the PROFILE (#50) field in the"
^DIC(9.4,14,22,5.9,"PAH",268,1,18,0)="   LOAD/WORKLIST (#68.2) file is set to ""YES""."
^DIC(9.4,14,22,5.9,"PAH",269,0)="457 SEQ #367^3160323.1153^54"
^DIC(9.4,14,22,5.9,"PAH",269,1,0)="^^5^5^3160323"
^DIC(9.4,14,22,5.9,"PAH",269,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",269,1,2,0)="package by the Vista Maintenance team that addresses"
^DIC(9.4,14,22,5.9,"PAH",269,1,3,0)="issues with the Howdy software relating to exclusionary"
^DIC(9.4,14,22,5.9,"PAH",269,1,4,0)="functionality for clinics, deleting of same day duplicate"
^DIC(9.4,14,22,5.9,"PAH",269,1,5,0)="tests and some other minor Howdy issues."
^DIC(9.4,14,22,5.9,"PAH",270,0)="460 SEQ #368^3160418.151501^54"
^DIC(9.4,14,22,5.9,"PAH",270,1,0)="^^4^4^3160418"
^DIC(9.4,14,22,5.9,"PAH",270,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",270,1,2,0)="package by the Vista Maintenance team that addresses"
^DIC(9.4,14,22,5.9,"PAH",270,1,3,0)="issues with the collection times on the order report, CPT"
^DIC(9.4,14,22,5.9,"PAH",270,1,4,0)="code entry in AP, and the SNOMED extract."
^DIC(9.4,14,22,5.9,"PAH",271,0)="466 SEQ #369^3160510.154109^54"
^DIC(9.4,14,22,5.9,"PAH",271,1,0)="^^5^5^3160510"
^DIC(9.4,14,22,5.9,"PAH",271,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",271,1,2,0)="package by the Vista Maintenance team that addresses"
^DIC(9.4,14,22,5.9,"PAH",271,1,3,0)="issues with accessioned lab tests marked as uncollected,"
^DIC(9.4,14,22,5.9,"PAH",271,1,4,0)="and with accessioning creating erroneous nodes in the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",271,1,5,0)="Order Entry file (#69)."
^DIC(9.4,14,22,5.9,"PAH",272,0)="458^3160803.141817^54"
^DIC(9.4,14,22,5.9,"PAH",272,1,0)="^^231^231^3160803"
^DIC(9.4,14,22,5.9,"PAH",272,1,1,0)="Associated Patches:(v)LR*5.2*446 <<= must be installed BEFORE `LR*5.2*458'"
^DIC(9.4,14,22,5.9,"PAH",272,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,3,0)="Subject:  LABORATORY AUTO VERICATION & AUTO RELEASE"
^DIC(9.4,14,22,5.9,"PAH",272,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,5,0)="Category:       ROUTINE"
^DIC(9.4,14,22,5.9,"PAH",272,1,6,0)="                ENHANCEMENT"
^DIC(9.4,14,22,5.9,"PAH",272,1,7,0)="                DATA DICTIONARY"
^DIC(9.4,14,22,5.9,"PAH",272,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,9,0)="Description:"
^DIC(9.4,14,22,5.9,"PAH",272,1,10,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",272,1,11,0)="The build for this patch is distributed as part of a multi-package build "
^DIC(9.4,14,22,5.9,"PAH",272,1,12,0)="that contains LR*5.2*458 and LA*5.2*88 and contains functionality to "
^DIC(9.4,14,22,5.9,"PAH",272,1,13,0)="enable Auto Verification and Auto Release of normal lab results.  "
^DIC(9.4,14,22,5.9,"PAH",272,1,14,0)="Initially developed at the Kansas City VAMC, this new process involves "
^DIC(9.4,14,22,5.9,"PAH",272,1,15,0)="automatic review and release of test results based on lab-established set "
^DIC(9.4,14,22,5.9,"PAH",272,1,16,0)="of boundaries, also referred as rules, rule sets, and algorithms.  Lab "
^DIC(9.4,14,22,5.9,"PAH",272,1,17,0)="results that are in a ""normal"" range, as pre-determined by the "
^DIC(9.4,14,22,5.9,"PAH",272,1,18,0)="laboratory, will transmit directly from the middleware to VistA lab files "
^DIC(9.4,14,22,5.9,"PAH",272,1,19,0)="and on to Computerized Patient Record System (CPRS) without the "
^DIC(9.4,14,22,5.9,"PAH",272,1,20,0)="intermediate step of requiring a lab technologist to manually review and "
^DIC(9.4,14,22,5.9,"PAH",272,1,21,0)="sign off on these normal lab results.  This process will eliminate the "
^DIC(9.4,14,22,5.9,"PAH",272,1,22,0)="need for a qualified technologist to manually approve all ""normal"" "
^DIC(9.4,14,22,5.9,"PAH",272,1,23,0)="results before those results are filed in VistA Lab files and available "
^DIC(9.4,14,22,5.9,"PAH",272,1,24,0)="for clinicians to view in CPRS. "
^DIC(9.4,14,22,5.9,"PAH",272,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,26,0)="Each VAMC site will determine which instruments will use this "
^DIC(9.4,14,22,5.9,"PAH",272,1,27,0)="functionality as it can set up on an instrument by instrument basis.  "
^DIC(9.4,14,22,5.9,"PAH",272,1,28,0)="Essentially VistA Lab instruments are set up as either being available "
^DIC(9.4,14,22,5.9,"PAH",272,1,29,0)="for auto verification or not available for auto verification.  If an "
^DIC(9.4,14,22,5.9,"PAH",272,1,30,0)="instrument is set up for auto verification, then a lab result passing the "
^DIC(9.4,14,22,5.9,"PAH",272,1,31,0)="rule set will be filed by the middleware in VistA lab files and available "
^DIC(9.4,14,22,5.9,"PAH",272,1,32,0)="in CPRS and a lab result that cannot pass the rule set will be held in "
^DIC(9.4,14,22,5.9,"PAH",272,1,33,0)="the middleware system for review by a lab technologist. "
^DIC(9.4,14,22,5.9,"PAH",272,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,35,0)="In support of this auto verification and auto release functionality, this "
^DIC(9.4,14,22,5.9,"PAH",272,1,36,0)="patch will add two new application proxy users.  LRLAB AUTO RELEASE is "
^DIC(9.4,14,22,5.9,"PAH",272,1,37,0)="used to indicate that the results in VistA Lab were released by an "
^DIC(9.4,14,22,5.9,"PAH",272,1,38,0)="automated Lab process without human interventions.  LRLAB, AUTO VERIFY is "
^DIC(9.4,14,22,5.9,"PAH",272,1,39,0)="used to indicate that the results were ""approved"" by an automated process "
^DIC(9.4,14,22,5.9,"PAH",272,1,40,0)="using a rules based system."
^DIC(9.4,14,22,5.9,"PAH",272,1,41,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,42,0)="--------------------------------------------------------------------------"
