^DIC(9.4,14,22,5.9,"PAH",207,1,424,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 Installation "
^DIC(9.4,14,22,5.9,"PAH",207,1,425,0)="Guide.doc"
^DIC(9.4,14,22,5.9,"PAH",207,1,426,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 Installation "
^DIC(9.4,14,22,5.9,"PAH",207,1,427,0)="Guide.pdf"
