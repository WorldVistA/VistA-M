^DIC(9.4,96,22,1.2,"PAH",4,1,82,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,83,0)="Press return when you are ready to re-edit this treatment data entry."
^DIC(9.4,96,22,1.2,"PAH",4,1,84,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,85,0)="DATE: OCT 17,1997@11:14:06// @"
^DIC(9.4,96,22,1.2,"PAH",4,1,86,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,87,0)="   SURE YOU WANT TO DELETE THE ENTIRE DENTAL TREATMENT (AMIS)? Y  (Yes)"
^DIC(9.4,96,22,1.2,"PAH",4,1,88,0)="  "
^DIC(9.4,96,22,1.2,"PAH",4,1,89,0)="%DSM-E-UNDEF, undefined variable DA"
^DIC(9.4,96,22,1.2,"PAH",4,1,90,0)="-DSM-I-ECODE, MUMPS error code: M6"
^DIC(9.4,96,22,1.2,"PAH",4,1,91,0)="%DSM-I-ATLABEL, DENTEC+2^DENTEC:1       G:'$D(^DENT(221,DA,0)) EXIT1 S"
^DIC(9.4,96,22,1.2,"PAH",4,1,92,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,93,0)="G=^DENT(221,DA,0),X=$P(G,""^"",19),E="""",M=""ERROR-- """
^DIC(9.4,96,22,1.2,"PAH",4,1,94,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,95,0)=">"
^DIC(9.4,96,22,1.2,"PAH",4,1,96,0)="                                                                         "
^DIC(9.4,96,22,1.2,"PAH",4,1,97,0)="    Routine DENTEC is modified to fix this error.                       "
^DIC(9.4,96,22,1.2,"PAH",4,1,98,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,99,0)=" 2) NOIS TOG-0897-11099  DATA ENTRY SCREEN NOT REPAINTING "
^DIC(9.4,96,22,1.2,"PAH",4,1,100,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,101,0)="    ROUTINE MODIFIED: DENTDML, DENTDNJ, DENTDNJ1, DENTDNJ2, DENTDNK, and "
^DIC(9.4,96,22,1.2,"PAH",4,1,102,0)="                      DENTDNQ                                            "
^DIC(9.4,96,22,1.2,"PAH",4,1,103,0)="                                                                          "
^DIC(9.4,96,22,1.2,"PAH",4,1,104,0)="    OPTIONS: Treatment Data Enter/Edit (Full Screen)         [DENTTREAT"
^DIC(9.4,96,22,1.2,"PAH",4,1,105,0)="                                                                   EDIT] "
^DIC(9.4,96,22,1.2,"PAH",4,1,106,0)="             Class I-VI (type 3) Admin Info Enter/Edit       [DENTADM"
^DIC(9.4,96,22,1.2,"PAH",4,1,107,0)="                                                                   EDIT] "
^DIC(9.4,96,22,1.2,"PAH",4,1,108,0)="             Personnel Info (type 4) Enter/Edit              [DENTPERS"
^DIC(9.4,96,22,1.2,"PAH",4,1,109,0)="                                                                   EDIT]"
^DIC(9.4,96,22,1.2,"PAH",4,1,110,0)="             Applications and Dental Fee (type 5) Enter/Edit [DENTFEE"
^DIC(9.4,96,22,1.2,"PAH",4,1,111,0)="                                                                   EDIT] "
^DIC(9.4,96,22,1.2,"PAH",4,1,112,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,113,0)="    FILES:   DENTAL TREATMENT (AMIS) (#221)  FIELD: STATION.DIVISION (#.3)"
^DIC(9.4,96,22,1.2,"PAH",4,1,114,0)="             DENTAL FEE BASIS (AMIS) (#222)  FIELD: STATION.DIVISION (#.3)"
^DIC(9.4,96,22,1.2,"PAH",4,1,115,0)="             DENTAL CLASS I-VI (AMIS) (#223) FIELD: STATION.DIVISION (#.3)"
^DIC(9.4,96,22,1.2,"PAH",4,1,116,0)="             DENTAL PERSONNEL (AMIS) (#224)  FIELD: STATION.DIVISION (#.3)"
^DIC(9.4,96,22,1.2,"PAH",4,1,117,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,118,0)="    The COMMANDS, displayed at the bottom of the screen, does not get "
^DIC(9.4,96,22,1.2,"PAH",4,1,119,0)="    re-displayed after the user enters in a ""?"", ""@"", or data in any field"
^DIC(9.4,96,22,1.2,"PAH",4,1,120,0)="    while using any one of the options mentioned above.                   "
^DIC(9.4,96,22,1.2,"PAH",4,1,121,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,122,0)="    The routines listed above was modified to fix this."
^DIC(9.4,96,22,1.2,"PAH",4,1,123,0)="    Fields #.3, STATION.DIVISION, in files #221, 222, 223, and 224 was"
^DIC(9.4,96,22,1.2,"PAH",4,1,124,0)="    modified to fix this."
^DIC(9.4,96,22,1.2,"PAH",4,1,125,0)=" "
