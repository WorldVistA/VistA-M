^DIC(9.4,202,22,1,"PAH",10,1,6,0)=" MHV Secure Messaging (SM)"
^DIC(9.4,202,22,1,"PAH",10,1,7,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,8,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,9,0)="EMERGENCY Issues Fix."
^DIC(9.4,202,22,1,"PAH",10,1,10,0)="Issue Description:"
^DIC(9.4,202,22,1,"PAH",10,1,11,0)="=================="
^DIC(9.4,202,22,1,"PAH",10,1,12,0)="JAZZ Story: 409966"
^DIC(9.4,202,22,1,"PAH",10,1,13,0)="This patch addresses the issue related to retrieving User Name Components "
^DIC(9.4,202,22,1,"PAH",10,1,14,0)="that contain space characters, and  enhancing the user query by "
^DIC(9.4,202,22,1,"PAH",10,1,15,0)="retrieving more fields from New User File #200."
^DIC(9.4,202,22,1,"PAH",10,1,16,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,17,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,18,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,19,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,20,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,21,0)=" "
^DIC(9.4,202,22,1,"PAH",10,1,22,0)="Business Impact Description:"
^DIC(9.4,202,22,1,"PAH",10,1,23,0)="============================"
^DIC(9.4,202,22,1,"PAH",10,1,24,0)="The  impact for the providers who are using SM cannot be added to the "
^DIC(9.4,202,22,1,"PAH",10,1,25,0)="SM Triage Groups if their names  contain a space."
