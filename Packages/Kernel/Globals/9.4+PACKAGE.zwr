^DIC(9.4,14,22,5.9,"PAH",99,1,277,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,278,0)="  The following is a list of routines included in this patch. The second"
^DIC(9.4,14,22,5.9,"PAH",99,1,279,0)="  line of each routine now looks like:"
^DIC(9.4,14,22,5.9,"PAH",99,1,280,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,281,0)="  <tab>;;5.2;LAB SERVICE;**[patch list]**; Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",99,1,282,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,283,0)="                   CHECK^XTSUMBLD results"
^DIC(9.4,14,22,5.9,"PAH",99,1,284,0)="                    Checksum       Checksum"
