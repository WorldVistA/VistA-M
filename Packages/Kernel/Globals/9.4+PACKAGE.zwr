^DIC(9.4,4,22,1,"PAH",10,1,53,0)=" DATA DICTIONARY:  Partial DD"
^DIC(9.4,4,22,1,"PAH",10,1,54,0)=""
^DIC(9.4,4,22,1,"PAH",10,1,55,0)="  File:  DOMAIN #4.2"
^DIC(9.4,4,22,1,"PAH",10,1,56,0)=""
^DIC(9.4,4,22,1,"PAH",10,1,57,0)="   Field:"
^DIC(9.4,4,22,1,"PAH",10,1,58,0)="    1.61   NEW VALIDATION NUMBER"
^DIC(9.4,4,22,1,"PAH",10,1,59,0)="               This field is used for security.  It is a temporary value,"
^DIC(9.4,4,22,1,"PAH",10,1,60,0)="               it is set when a new validation number is negotiated with"
^DIC(9.4,4,22,1,"PAH",10,1,61,0)="               another Domain. It is moved to the Validation Number,"
^DIC(9.4,4,22,1,"PAH",10,1,62,0)="               field 1.6, after it is confirmed by the other Domain."
^DIC(9.4,4,22,1,"PAH",10,1,63,0)=""
^DIC(9.4,4,22,1,"PAH",11,0)="37 SEQ #32^2970306^1"
^DIC(9.4,4,22,1,"PAH",11,1,0)="^^147^147^2970306"
^DIC(9.4,4,22,1,"PAH",11,1,1,0)="We recommend that you run option XMAUTOPURGE daily to purge your system of"
^DIC(9.4,4,22,1,"PAH",11,1,2,0)="unreferenced messages.  It runs approximately 40 minutes per 100,000 messages."
^DIC(9.4,4,22,1,"PAH",11,1,3,0)="Your mileage may vary."
^DIC(9.4,4,22,1,"PAH",11,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,5,0)="Option XMSTAT will show you the results of the last 20 purges: purge type,"
^DIC(9.4,4,22,1,"PAH",11,1,6,0)="when they were run and how long they took, and how many messages were purged."
^DIC(9.4,4,22,1,"PAH",11,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,8,0)="MailMan patch XM*7.1*37 contains the following enhancements and bug fixes:"
^DIC(9.4,4,22,1,"PAH",11,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,10,0)="NOIS:  LAK-0396-31177"
^DIC(9.4,4,22,1,"PAH",11,1,11,0)="Rtns:  ^XMA32,^XMA32A"
^DIC(9.4,4,22,1,"PAH",11,1,12,0)="These ""date purge"" routines have been changed to"
^DIC(9.4,4,22,1,"PAH",11,1,13,0)="- improve efficiency"
^DIC(9.4,4,22,1,"PAH",11,1,14,0)="- make the coding clearer"
^DIC(9.4,4,22,1,"PAH",11,1,15,0)="- recognize more internet date formats"
^DIC(9.4,4,22,1,"PAH",11,1,16,0)="- purge messages which think they are responses but really aren't"
^DIC(9.4,4,22,1,"PAH",11,1,17,0)="- purge responses which think they are original messages but really aren't"
^DIC(9.4,4,22,1,"PAH",11,1,18,0)="- recognize and comply with a task stop request"
^DIC(9.4,4,22,1,"PAH",11,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,20,0)="NOIS:  NYN-0996-10302"
^DIC(9.4,4,22,1,"PAH",11,1,21,0)="Rtns:  ^XMA3"
^DIC(9.4,4,22,1,"PAH",11,1,22,0)="DD:    file 4.3, field #4.304, 'MESSAGES NOT TO PURGE WEEKDAYS'"
^DIC(9.4,4,22,1,"PAH",11,1,23,0)="Makes the documentation in the routine and DD match the code in the routine."
^DIC(9.4,4,22,1,"PAH",11,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,25,0)="NOIS:  MIN-0195-40075"
^DIC(9.4,4,22,1,"PAH",11,1,26,0)="Rtns:  ^XMA3,^XMA30,^XMA31"
^DIC(9.4,4,22,1,"PAH",11,1,27,0)="Make sure that messages within the no-purge-days buffer aren't deleted."
^DIC(9.4,4,22,1,"PAH",11,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,29,0)="NOIS:  WBP-0996-22202"
^DIC(9.4,4,22,1,"PAH",11,1,30,0)="Rtns:  ^XMA3,^XMA30,^XMA31"
^DIC(9.4,4,22,1,"PAH",11,1,31,0)="DD:    file 4.3, new field #142, 'NO-PURGE DAYS BUFFER'"
^DIC(9.4,4,22,1,"PAH",11,1,32,0)="Lets the site specify the no-purge number of days."
^DIC(9.4,4,22,1,"PAH",11,1,33,0)="Routines are modified to improve efficiency and clarity."
^DIC(9.4,4,22,1,"PAH",11,1,34,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,35,0)="STANDARD DATA DICTIONARY #4.3 -- KERNEL SITE PARAMETERS FILE   11/1/96  PAGE 127"
^DIC(9.4,4,22,1,"PAH",11,1,36,0)="STORED IN ^XMB(1,  (1 ENTRY)   SITE: MAILMAN RELEASED   UCI: REL,NMM (VERSION 7."
^DIC(9.4,4,22,1,"PAH",11,1,37,0)="1)   "
^DIC(9.4,4,22,1,"PAH",11,1,38,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,39,0)="DATA          NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",11,1,40,0)="ELEMENT       TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",11,1,41,0)="-------------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",11,1,42,0)="4.3,142       NO-PURGE DAYS BUFFER   .14;2 NUMBER"
^DIC(9.4,4,22,1,"PAH",11,1,43,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,44,0)="              INPUT TRANSFORM:  K:+X'=X!(X>10)!(X<1)!(X?.E1"".""1N.N) X"
^DIC(9.4,4,22,1,"PAH",11,1,45,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,46,0)="              LAST EDITED:      OCT 08, 1996 "
^DIC(9.4,4,22,1,"PAH",11,1,47,0)="              HELP-PROMPT:      Type a Number between 1 and 10, 0 Decimal "
^DIC(9.4,4,22,1,"PAH",11,1,48,0)="                                Digits "
^DIC(9.4,4,22,1,"PAH",11,1,49,0)="              DESCRIPTION:      This field is used during the"
^DIC(9.4,4,22,1,"PAH",11,1,50,0)="                                un-referenced-messages purge to avoid purging"
^DIC(9.4,4,22,1,"PAH",11,1,51,0)="                                the last few messages in the message file,"
^DIC(9.4,4,22,1,"PAH",11,1,52,0)="                                according to their send date."
^DIC(9.4,4,22,1,"PAH",11,1,53,0)="                                We subtract the NO-PURGE DAYS BUFFER from"
^DIC(9.4,4,22,1,"PAH",11,1,54,0)="                                today's date, giving a 'no-purge date'.  Local"
^DIC(9.4,4,22,1,"PAH",11,1,55,0)="                                messages which were created on or after that"
^DIC(9.4,4,22,1,"PAH",11,1,56,0)="                                date are not subject to purge.  Messages from"
^DIC(9.4,4,22,1,"PAH",11,1,57,0)="                                other sites are not affected by this buffer.  "
^DIC(9.4,4,22,1,"PAH",11,1,58,0)="                                If this field is not filled in, it defaults to"
^DIC(9.4,4,22,1,"PAH",11,1,59,0)="                                7 days.  One day is probably all that is"
^DIC(9.4,4,22,1,"PAH",11,1,60,0)="                                needed, however.  "
^DIC(9.4,4,22,1,"PAH",11,1,61,0)="                                One situation in which this buffer may be"
^DIC(9.4,4,22,1,"PAH",11,1,62,0)="                                useful is in the case of a message sent only to"
^DIC(9.4,4,22,1,"PAH",11,1,63,0)="                                a remote site.  Such a message is unreferenced"
^DIC(9.4,4,22,1,"PAH",11,1,64,0)="                                and would otherwise be subject to purge.  If a"
^DIC(9.4,4,22,1,"PAH",11,1,65,0)="                                reply came from the remote site after the"
^DIC(9.4,4,22,1,"PAH",11,1,66,0)="                                original message had been purged, the sender"
^DIC(9.4,4,22,1,"PAH",11,1,67,0)="                                would have access only to the reply and not to"
^DIC(9.4,4,22,1,"PAH",11,1,68,0)="                                the original message.  The NO-PURGE DAYS BUFFER"
^DIC(9.4,4,22,1,"PAH",11,1,69,0)="                                could be set to a reasonable number of days to"
^DIC(9.4,4,22,1,"PAH",11,1,70,0)="                                allow for a reply."
^DIC(9.4,4,22,1,"PAH",11,1,71,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,72,0)="NOIS:  WBP-0596-21011"
^DIC(9.4,4,22,1,"PAH",11,1,73,0)="Rtns:  ^XMDIRSND,^XMDIRRCV"
^DIC(9.4,4,22,1,"PAH",11,1,74,0)="Delete Server messages from Postmaster's Mailbox after processing them."
^DIC(9.4,4,22,1,"PAH",11,1,75,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,76,0)="NOIS:  MCM-1295-51144"
^DIC(9.4,4,22,1,"PAH",11,1,77,0)="Rtns:  ^XMA3"
^DIC(9.4,4,22,1,"PAH",11,1,78,0)="While cleaning out Postmaster's ARRIVING basket, deletes any message which"
^DIC(9.4,4,22,1,"PAH",11,1,79,0)="is still arriving after 'NO-PURGE DAYS BUFFER' number of days."
^DIC(9.4,4,22,1,"PAH",11,1,80,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,81,0)="NOIS:  None"
^DIC(9.4,4,22,1,"PAH",11,1,82,0)="Rtns:  ^XMADJF1B,^XMYPOST7"
^DIC(9.4,4,22,1,"PAH",11,1,83,0)="This problem was revealed during testing of this patch.  MailMan does not"
^DIC(9.4,4,22,1,"PAH",11,1,84,0)="use FileMan to add messages to a user's basket; he does it himself, and that"
^DIC(9.4,4,22,1,"PAH",11,1,85,0)="includes updating the zero node.  Up 'til now, when MM delivered a message to"
^DIC(9.4,4,22,1,"PAH",11,1,86,0)="a user's basket, he put the message number (not the number of messages) into"
^DIC(9.4,4,22,1,"PAH",11,1,87,0)="piece 4 of the zero node of the message multiple.  This patch corrects that"
^DIC(9.4,4,22,1,"PAH",11,1,88,0)="mistake.  ^XMYPOST7 goes through all message multiples of everyone's mailbox"
^DIC(9.4,4,22,1,"PAH",11,1,89,0)="and corrects the message multiple zero nodes."
^DIC(9.4,4,22,1,"PAH",11,1,90,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,91,0)="NOIS:  DAY-0196-41801"
^DIC(9.4,4,22,1,"PAH",11,1,92,0)="Rtns:  ^XMA30"
^DIC(9.4,4,22,1,"PAH",11,1,93,0)="The user status report now includes 'last sign on', as well as 'last mail use'."
^DIC(9.4,4,22,1,"PAH",11,1,94,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,95,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",11,1,96,0)="This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",11,1,97,0)="minimum.  You should put the XMUSER Option out of order.  No one should be"
^DIC(9.4,4,22,1,"PAH",11,1,98,0)="using MailMan.  The filers (mail delivery tasks) should not be running."
^DIC(9.4,4,22,1,"PAH",11,1,99,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,100,0)="The post-install routine, ^XMYPOST7, will run about 3 minutes per"
^DIC(9.4,4,22,1,"PAH",11,1,101,0)="1000 mailboxes.  See the description above about what it will be doing."
^DIC(9.4,4,22,1,"PAH",11,1,102,0)="*NOTE*:  It will try to lock ^XMB(3.7).  If it cannot lock it, it will not"
^DIC(9.4,4,22,1,"PAH",11,1,103,0)="run, and you will have to run it manually at a future time.  So if you see"
^DIC(9.4,4,22,1,"PAH",11,1,104,0)="that ^XMYPOST7 stopped running as soon as it started, then you know it could"
^DIC(9.4,4,22,1,"PAH",11,1,105,0)="not get a lock. "
^DIC(9.4,4,22,1,"PAH",11,1,106,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,107,0)="^XMYPOST8 will not run.  Do not run it."
^DIC(9.4,4,22,1,"PAH",11,1,108,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",11,1,109,0)=" "
^DIC(9.4,4,22,1,"PAH",11,1,110,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",11,1,111,0)="1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",11,1,112,0)="    so you will need to disable mapping for the affected routine."
^DIC(9.4,4,22,1,"PAH",11,1,113,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",11,1,114,0)="    option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",11,1,115,0)="3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",11,1,116,0)="    system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",11,1,117,0)="4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",11,1,118,0)="    options:"
^DIC(9.4,4,22,1,"PAH",11,1,119,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",11,1,120,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",11,1,121,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",11,1,122,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",11,1,123,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",11,1,124,0)="5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",11,1,125,0)="    other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",11,1,126,0)="6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",11,1,127,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",11,1,128,0)="  "
^DIC(9.4,4,22,1,"PAH",11,1,129,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",11,1,130,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",11,1,131,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",11,1,132,0)=" "
^DIC(9.4,4,22,1,"PAH",11,1,133,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",11,1,134,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",11,1,135,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",11,1,136,0)="XMA3          11195689        14547045         37"
^DIC(9.4,4,22,1,"PAH",11,1,137,0)="XMA30          5617809         7561526         37"
^DIC(9.4,4,22,1,"PAH",11,1,138,0)="XMA31          2140577            1080         27,37"
^DIC(9.4,4,22,1,"PAH",11,1,139,0)="XMA32         13342847        12437801         37"
^DIC(9.4,4,22,1,"PAH",11,1,140,0)="XMA32A        11841830         9601895         27,37"
^DIC(9.4,4,22,1,"PAH",11,1,141,0)="XMADJF1B       4665477         4754529         10,16,37"
^DIC(9.4,4,22,1,"PAH",11,1,142,0)="XMDIRRCV       1862431         1909690         37"
^DIC(9.4,4,22,1,"PAH",11,1,143,0)="XMDIRSND       1508027         1583505         37"
^DIC(9.4,4,22,1,"PAH",11,1,144,0)="XMYPOST7       **new**          959425         37"
^DIC(9.4,4,22,1,"PAH",11,1,145,0)="XMYPOST8       **new**          649189         37"
^DIC(9.4,4,22,1,"PAH",11,1,146,0)=""
^DIC(9.4,4,22,1,"PAH",11,1,147,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",12,0)="39 SEQ #33^2970306^1"
^DIC(9.4,4,22,1,"PAH",12,1,0)="^^41^41^2970306"
^DIC(9.4,4,22,1,"PAH",12,1,1,0)=" This MailMan patch will change how an 'ANSWER' message looks. The message"
^DIC(9.4,4,22,1,"PAH",12,1,2,0)=" will now show the users response, the users network signature, and then"
^DIC(9.4,4,22,1,"PAH",12,1,3,0)=" the original message. The orignal message with be preceded with a '>'."
^DIC(9.4,4,22,1,"PAH",12,1,4,0)=" The user can now edit the entire message, including the original message,"
^DIC(9.4,4,22,1,"PAH",12,1,5,0)=" by using the 'Edit' option at the 'TRANSMIT option: ' prompt."
^DIC(9.4,4,22,1,"PAH",12,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",12,1,7,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",12,1,8,0)=" This patch should be installed after hours, when there is minimum users on"
^DIC(9.4,4,22,1,"PAH",12,1,9,0)=" the system.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",12,1,10,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",12,1,11,0)=" "
^DIC(9.4,4,22,1,"PAH",12,1,12,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",12,1,13,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",12,1,14,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,4,22,1,"PAH",12,1,15,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",12,1,16,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",12,1,17,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",12,1,18,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",12,1,19,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",12,1,20,0)="      options:"
^DIC(9.4,4,22,1,"PAH",12,1,21,0)="        2 Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",12,1,22,0)="        3 Print Transport Global"
^DIC(9.4,4,22,1,"PAH",12,1,23,0)="        4 Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",12,1,24,0)="        5 Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",12,1,25,0)="        6 Install Package(s)"
^DIC(9.4,4,22,1,"PAH",12,1,26,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",12,1,27,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",12,1,28,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",12,1,29,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",12,1,30,0)="  "
^DIC(9.4,4,22,1,"PAH",12,1,31,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",12,1,32,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",12,1,33,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",12,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",12,1,35,0)="               Before          After"
^DIC(9.4,4,22,1,"PAH",12,1,36,0)=" Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",12,1,37,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",12,1,38,0)=" XMA11B         3291121         3593034        39"
^DIC(9.4,4,22,1,"PAH",12,1,39,0)=" XMA2          10106075        10059315        5,6,10,15,39"
^DIC(9.4,4,22,1,"PAH",12,1,40,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",12,1,41,0)=""
^DIC(9.4,4,22,1,"PAH",13,0)="42 SEQ #34^2970417^1"
^DIC(9.4,4,22,1,"PAH",13,1,0)="^^53^53^2970417"
^DIC(9.4,4,22,1,"PAH",13,1,1,0)=" Prerequisites: none"
^DIC(9.4,4,22,1,"PAH",13,1,2,0)="=========================================================================== "
^DIC(9.4,4,22,1,"PAH",13,1,3,0)=" This MailMan patch is in response to the following:"
^DIC(9.4,4,22,1,"PAH",13,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",13,1,5,0)="IOW-0397-40004, MWV-0297-20667, BAY-0397-30178, FAV-0397-71157"
^DIC(9.4,4,22,1,"PAH",13,1,6,0)=" KIDS messages were losing the Message Type field during transmission."
^DIC(9.4,4,22,1,"PAH",13,1,7,0)=" When the user installed the patch they would get an 'UNDEFINDED"
^DIC(9.4,4,22,1,"PAH",13,1,8,0)=" FUNCTION' error."
^DIC(9.4,4,22,1,"PAH",13,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",13,1,10,0)="ANN-0397-41843  Sites were sometimes getting a '550 Domain file locked'"
^DIC(9.4,4,22,1,"PAH",13,1,11,0)=" message after installing patch XM*7.1*34"
^DIC(9.4,4,22,1,"PAH",13,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",13,1,13,0)="This patch also contains code which lays the groundwork for the upcoming"
^DIC(9.4,4,22,1,"PAH",13,1,14,0)="domain name changes."
^DIC(9.4,4,22,1,"PAH",13,1,15,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",13,1,16,0)=" This patch should be installed during off-peak hours when network mail"
^DIC(9.4,4,22,1,"PAH",13,1,17,0)=" activity is low. This patch can be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",13,1,18,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",13,1,19,0)=" "
^DIC(9.4,4,22,1,"PAH",13,1,20,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",13,1,21,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",13,1,22,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,4,22,1,"PAH",13,1,23,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",13,1,24,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",13,1,25,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",13,1,26,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",13,1,27,0)="  4.  Users can remain on the system. This patch can be queued and should be"
^DIC(9.4,4,22,1,"PAH",13,1,28,0)="      installed during off-peak hours.  TaskMan can remain running."
^DIC(9.4,4,22,1,"PAH",13,1,29,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",13,1,30,0)="      options:"
^DIC(9.4,4,22,1,"PAH",13,1,31,0)="         2 Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",13,1,32,0)="         3 Print Transport Global"
^DIC(9.4,4,22,1,"PAH",13,1,33,0)="         4 Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",13,1,34,0)="         5 Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",13,1,35,0)="         6 Install Package(s)"
^DIC(9.4,4,22,1,"PAH",13,1,36,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",13,1,37,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",13,1,38,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",13,1,39,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",13,1,40,0)="  "
^DIC(9.4,4,22,1,"PAH",13,1,41,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",13,1,42,0)="   Checksums were calculated with CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",13,1,43,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",13,1,44,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",13,1,45,0)=" "
^DIC(9.4,4,22,1,"PAH",13,1,46,0)="               Before          After"
^DIC(9.4,4,22,1,"PAH",13,1,47,0)=" Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",13,1,48,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",13,1,49,0)=" XM0            5124637         3346676         4,42"
^DIC(9.4,4,22,1,"PAH",13,1,50,0)=" XMP2A          9900587        10037244         24,42"
^DIC(9.4,4,22,1,"PAH",13,1,51,0)=" XMR0B          9558225         9580242         4,6,13,34,42"
^DIC(9.4,4,22,1,"PAH",13,1,52,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",13,1,53,0)=""
^DIC(9.4,4,22,1,"PAH",14,0)="32 SEQ #35^2970528^1"
^DIC(9.4,4,22,1,"PAH",14,1,0)="^^51^51^2970528"
^DIC(9.4,4,22,1,"PAH",14,1,1,0)="This MailMan patch is in response to a problem noted on FORUM."
^DIC(9.4,4,22,1,"PAH",14,1,2,0)=" "
^DIC(9.4,4,22,1,"PAH",14,1,3,0)="A description of the problem:"
^DIC(9.4,4,22,1,"PAH",14,1,4,0)="Site A (from outside the VA) sends a message to Site B (in the VA)."
^DIC(9.4,4,22,1,"PAH",14,1,5,0)="User at Site B forwards the message to Site C (in the VA)."
^DIC(9.4,4,22,1,"PAH",14,1,6,0)="Site C has records in ^XMBX(4.501 (do not accept messages from domains"
^DIC(9.4,4,22,1,"PAH",14,1,7,0)="which match)."
^DIC(9.4,4,22,1,"PAH",14,1,8,0)="Site C rejects the message because the originating domain (Site A)"
^DIC(9.4,4,22,1,"PAH",14,1,9,0)="partial-matches the 'do not accept' record."
^DIC(9.4,4,22,1,"PAH",14,1,10,0)="MailMan sends a message to Site A about the rejection."
^DIC(9.4,4,22,1,"PAH",14,1,11,0)="MailMan keeps trying to forward the message from Site B to Site C"
^DIC(9.4,4,22,1,"PAH",14,1,12,0)="and keeps sending rejection messages to Site A, ad infinitum, ad nauseum."
^DIC(9.4,4,22,1,"PAH",14,1,13,0)="MailMan does not notify the user at Site B who forwarded the message."
^DIC(9.4,4,22,1,"PAH",14,1,14,0)=" "
^DIC(9.4,4,22,1,"PAH",14,1,15,0)="This patch does two things:"
^DIC(9.4,4,22,1,"PAH",14,1,16,0)="1. Sends the reject message to the user who forwarded the message."
^DIC(9.4,4,22,1,"PAH",14,1,17,0)="2. Changes the status of the message so that MailMan does not attempt to"
^DIC(9.4,4,22,1,"PAH",14,1,18,0)="send it again."
^DIC(9.4,4,22,1,"PAH",14,1,19,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",14,1,20,0)=" "
^DIC(9.4,4,22,1,"PAH",14,1,21,0)=" This patch can be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",14,1,22,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",14,1,23,0)=" "
^DIC(9.4,4,22,1,"PAH",14,1,24,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",14,1,25,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",14,1,26,0)="      so you will need to disable mapping for the effected routine."
^DIC(9.4,4,22,1,"PAH",14,1,27,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",14,1,28,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",14,1,29,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",14,1,30,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",14,1,31,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",14,1,32,0)="      options:"
^DIC(9.4,4,22,1,"PAH",14,1,33,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",14,1,34,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",14,1,35,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",14,1,36,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",14,1,37,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",14,1,38,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",14,1,39,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",14,1,40,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",14,1,41,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",14,1,42,0)="  "
^DIC(9.4,4,22,1,"PAH",14,1,43,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",14,1,44,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",14,1,45,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",14,1,46,0)=" "
^DIC(9.4,4,22,1,"PAH",14,1,47,0)="               Before          After"
^DIC(9.4,4,22,1,"PAH",14,1,48,0)=" Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",14,1,49,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",14,1,50,0)=" XMSERR        2286812         3651687          32"
^DIC(9.4,4,22,1,"PAH",14,1,51,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",15,0)="35 SEQ #36^2970528^1"
^DIC(9.4,4,22,1,"PAH",15,1,0)="^^39^39^2970528"
^DIC(9.4,4,22,1,"PAH",15,1,1,0)=" "
^DIC(9.4,4,22,1,"PAH",15,1,2,0)=" This MailMan patch contains the following bug fix:"
^DIC(9.4,4,22,1,"PAH",15,1,3,0)=" "
^DIC(9.4,4,22,1,"PAH",15,1,4,0)="-Prevents XUTESTUSER option from being able to complete a user's unsent"
^DIC(9.4,4,22,1,"PAH",15,1,5,0)=" message or response.  NOIS WWW-0796-51230"
^DIC(9.4,4,22,1,"PAH",15,1,6,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",15,1,7,0)=" "
^DIC(9.4,4,22,1,"PAH",15,1,8,0)=" This patch should be installed after hours, when there is minimum users on"
^DIC(9.4,4,22,1,"PAH",15,1,9,0)=" the system.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",15,1,10,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",15,1,11,0)=" "
^DIC(9.4,4,22,1,"PAH",15,1,12,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",15,1,13,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",15,1,14,0)="      so you will need to disable mapping for the effected routine."
^DIC(9.4,4,22,1,"PAH",15,1,15,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",15,1,16,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",15,1,17,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",15,1,18,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",15,1,19,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",15,1,20,0)="      options:"
^DIC(9.4,4,22,1,"PAH",15,1,21,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",15,1,22,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",15,1,23,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",15,1,24,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",15,1,25,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",15,1,26,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",15,1,27,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",15,1,28,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",15,1,29,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",15,1,30,0)="  "
^DIC(9.4,4,22,1,"PAH",15,1,31,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",15,1,32,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",15,1,33,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
