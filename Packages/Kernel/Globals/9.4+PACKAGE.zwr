^DIC(9.4,73,22,9,"PAH",13,1,1,0)="    NOIS SDC-0999-62404, MAN-0799-11140"
^DIC(9.4,73,22,9,"PAH",13,1,2,0)="        Since Network Health Exchange has interfaced"
^DIC(9.4,73,22,9,"PAH",13,1,3,0)="        with Health Summary package, the information"
