^DIC(9.4,59,22,5,"PAH",248,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",248,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",248,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",248,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",248,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",248,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",248,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",248,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",248,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",248,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",248,1,16,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",249,0)="257^3101027.104059^17"
^DIC(9.4,59,22,5,"PAH",249,1,0)="^^4^4^3101027"
^DIC(9.4,59,22,5,"PAH",249,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",249,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",249,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",249,1,4,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",250,0)="258^3101108.11081^17"
^DIC(9.4,59,22,5,"PAH",250,1,0)="^^17^17^3101108"
^DIC(9.4,59,22,5,"PAH",250,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",250,1,2,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",250,1,3,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",250,1,4,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",250,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",250,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",250,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",250,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",250,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",250,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",250,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",250,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",250,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",250,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",250,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",250,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",250,1,17,0)="The source of the data for the PMIs is First Data Bank."
