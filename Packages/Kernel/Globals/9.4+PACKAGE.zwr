^DIC(9.4,70,22,2,"PAH",3,1,1,0)="DAY-0898-41587   XWBSEC  Under CPRS when the DG routines call OP^XQCHK"
^DIC(9.4,70,22,2,"PAH",3,1,2,0)="                         to record what option is used it was getting"
^DIC(9.4,70,22,2,"PAH",3,1,3,0)="                         back ""unknown"".  The broker created context"
^DIC(9.4,70,22,2,"PAH",3,1,4,0)="                         needed to set the variable XQY."
^DIC(9.4,70,22,2,"PAH",3,1,5,0)="                         "
^DIC(9.4,70,22,2,"PAH",3,1,6,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",3,1,7,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",3,1,8,0)="XWBSEC        1126915   1317713    **3**"
^DIC(9.4,70,22,2,"PAH",3,1,9,0)=""
^DIC(9.4,70,22,2,"PAH",3,1,10,0)="Checksum's calculated by CHECK^XTSUMBLD"
^DIC(9.4,70,22,2,"PAH",3,1,11,0)=""
^DIC(9.4,70,22,2,"PAH",3,1,12,0)="========================================================================= "
^DIC(9.4,70,22,2,"PAH",3,1,13,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",3,1,14,0)=""
^DIC(9.4,70,22,2,"PAH",3,1,15,0)="  1.  DSM sites - This routines is usually mapped,"
^DIC(9.4,70,22,2,"PAH",3,1,16,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,70,22,2,"PAH",3,1,17,0)="     "
^DIC(9.4,70,22,2,"PAH",3,1,18,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",3,1,19,0)="      option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",3,1,20,0)="     "
^DIC(9.4,70,22,2,"PAH",3,1,21,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",3,1,22,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",3,1,23,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",3,1,24,0)="      options:"
^DIC(9.4,70,22,2,"PAH",3,1,25,0)="      "
^DIC(9.4,70,22,2,"PAH",3,1,26,0)="         Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",3,1,27,0)="         Print Transport Global"
^DIC(9.4,70,22,2,"PAH",3,1,28,0)="         Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",3,1,29,0)="         Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",3,1,30,0)="     "
^DIC(9.4,70,22,2,"PAH",3,1,31,0)="  4.  Users can remain on the system. "
^DIC(9.4,70,22,2,"PAH",3,1,32,0)="      Stop the Broker server(s), Stop any broker clients. "
^DIC(9.4,70,22,2,"PAH",3,1,33,0)="      (Each RPC call passes through this routine.)"
^DIC(9.4,70,22,2,"PAH",3,1,34,0)=""
^DIC(9.4,70,22,2,"PAH",3,1,35,0)="     "
^DIC(9.4,70,22,2,"PAH",3,1,36,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",3,1,37,0)="      option:"
^DIC(9.4,70,22,2,"PAH",3,1,38,0)="        Install Package(s)  'XWB*1.1*3'"
^DIC(9.4,70,22,2,"PAH",3,1,39,0)="                             ========="
^DIC(9.4,70,22,2,"PAH",3,1,40,0)="                             "
^DIC(9.4,70,22,2,"PAH",3,1,41,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",3,1,42,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",3,1,43,0)="                                                                        =="
^DIC(9.4,70,22,2,"PAH",3,1,44,0)="     "
^DIC(9.4,70,22,2,"PAH",3,1,45,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,70,22,2,"PAH",3,1,46,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",3,1,47,0)=""
^DIC(9.4,70,22,2,"PAH",4,0)="5 SEQ #4^2990417^1"
^DIC(9.4,70,22,2,"PAH",4,1,0)="^^42^42^2990417"
^DIC(9.4,70,22,2,"PAH",4,1,1,0)="This patch is for the support of RUM.  This will allow the trapping of"
^DIC(9.4,70,22,2,"PAH",4,1,2,0)="data for Remote Procedure Calls (RPCs) and the RPCBroker handler."
^DIC(9.4,70,22,2,"PAH",4,1,3,0)=" "
^DIC(9.4,70,22,2,"PAH",4,1,4,0)="                  Checksum"
^DIC(9.4,70,22,2,"PAH",4,1,5,0)=" Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",4,1,6,0)=" XWBBRK2       2982680   3134294      **5**"
^DIC(9.4,70,22,2,"PAH",4,1,7,0)=" XWBTCPC       8099567   8239171    **2,5**"
^DIC(9.4,70,22,2,"PAH",4,1,8,0)=" "
^DIC(9.4,70,22,2,"PAH",4,1,9,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,10,0)="  INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",4,1,11,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,12,0)="  1.  DSM sites - The Broker routines are not usually mapped.  Disable"
^DIC(9.4,70,22,2,"PAH",4,1,13,0)="mapping if necessary."
^DIC(9.4,70,22,2,"PAH",4,1,14,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,15,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",4,1,16,0)="option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",4,1,17,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,18,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",4,1,19,0)="system. You now need to use KIDS to install the Transport global. On the"
^DIC(9.4,70,22,2,"PAH",4,1,20,0)="KIDS menu, under the 'Installation' menu, use the following options:"
^DIC(9.4,70,22,2,"PAH",4,1,21,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,22,0)="          Verify Checksum's in Transport Global"
^DIC(9.4,70,22,2,"PAH",4,1,23,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",4,1,24,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",4,1,25,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",4,1,26,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,27,0)="  4.  All RPC Broker users should log off. Since no changes are made to"
^DIC(9.4,70,22,2,"PAH",4,1,28,0)="the main server routines, sites do not need to shut down the listener"
^DIC(9.4,70,22,2,"PAH",4,1,29,0)="jobs, BUT sites may choose to do if it makes it easier to control users"
^DIC(9.4,70,22,2,"PAH",4,1,30,0)="trying to log on during the routine update.  Every RPC call passes through"
^DIC(9.4,70,22,2,"PAH",4,1,31,0)="these routines."
^DIC(9.4,70,22,2,"PAH",4,1,32,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,33,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",4,1,34,0)="option:"
^DIC(9.4,70,22,2,"PAH",4,1,35,0)="         Install Package(s)  'XWB*1.1*5'"
^DIC(9.4,70,22,2,"PAH",4,1,36,0)="                              ========="
^DIC(9.4,70,22,2,"PAH",4,1,37,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",4,1,38,0)="other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,70,22,2,"PAH",4,1,39,0)="  "
^DIC(9.4,70,22,2,"PAH",4,1,40,0)="  7.  DSM Sites - Rebuild your map set if necessary."
^DIC(9.4,70,22,2,"PAH",4,1,41,0)=" "
^DIC(9.4,70,22,2,"PAH",4,1,42,0)="  8.  Restart the Broker Listener if necessary."
^DIC(9.4,70,22,2,"PAH",5,0)="7 SEQ #5^2990622^1"
^DIC(9.4,70,22,2,"PAH",5,1,0)="^^101^101^2990622"
^DIC(9.4,70,22,2,"PAH",5,1,1,0)="This patch addresses two problems:"
^DIC(9.4,70,22,2,"PAH",5,1,2,0)="A command error occuring at RESTART+17^XWBTCPL when the Broker tries to"
^DIC(9.4,70,22,2,"PAH",5,1,3,0)="reopen a device that is not closed.  This seems to be a problem with Cache"
^DIC(9.4,70,22,2,"PAH",5,1,4,0)="sites only.  The result of this error causes the Broker Listener to stop."
^DIC(9.4,70,22,2,"PAH",5,1,5,0)="This fix is in XWBTCPL routine."
^DIC(9.4,70,22,2,"PAH",5,1,6,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,7,0)="The other problem deals with available slots.  The listener doesn't check"
^DIC(9.4,70,22,2,"PAH",5,1,8,0)="for available slots before starting a new process.  The listener will now"
^DIC(9.4,70,22,2,"PAH",5,1,9,0)="check the MAX SIGNON ALLOWED field of the VOLUME SET multiple in the"
^DIC(9.4,70,22,2,"PAH",5,1,10,0)="KERNEL SYSTEM PARAMETERS file, the same one used by Kernel logon.  This"
^DIC(9.4,70,22,2,"PAH",5,1,11,0)="fix is also in XWBTCPL."
^DIC(9.4,70,22,2,"PAH",5,1,12,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,13,0)=" <<THIS IS A SERVER SIDE PATCH ONLY.>>"
^DIC(9.4,70,22,2,"PAH",5,1,14,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,16,0)=" NOISs:"
^DIC(9.4,70,22,2,"PAH",5,1,17,0)=" ====="
^DIC(9.4,70,22,2,"PAH",5,1,18,0)=" MRN-1198-42547  -  Broker Listener"
^DIC(9.4,70,22,2,"PAH",5,1,19,0)=" WIC-0399-42263  -  Broker Listener"
^DIC(9.4,70,22,2,"PAH",5,1,20,0)=" MAR-0499-20186  -  Broker Listener"
^DIC(9.4,70,22,2,"PAH",5,1,21,0)=" CHY-1298-52305  -  Broker Listener"
^DIC(9.4,70,22,2,"PAH",5,1,22,0)=" CTX-0499-70598  -  Available Slots"
^DIC(9.4,70,22,2,"PAH",5,1,23,0)=" PUG-0399-51484  -  Available Slots"
^DIC(9.4,70,22,2,"PAH",5,1,24,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,26,0)=" Routine Summary:"
^DIC(9.4,70,22,2,"PAH",5,1,27,0)=" The following routine is included in this patch.  The second line of"
^DIC(9.4,70,22,2,"PAH",5,1,28,0)=" this routine now looks like:"
^DIC(9.4,70,22,2,"PAH",5,1,29,0)="  ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",5,1,30,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,31,0)="                  Checksum"
^DIC(9.4,70,22,2,"PAH",5,1,32,0)=" Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",5,1,33,0)=" XWBTCPL       8215020   8850625    **1,7**"
^DIC(9.4,70,22,2,"PAH",5,1,34,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,35,0)=" List of preceeding patches: 1"
^DIC(9.4,70,22,2,"PAH",5,1,36,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",5,1,37,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,38,0)=" ========================================================================="
^DIC(9.4,70,22,2,"PAH",5,1,39,0)=" Installation:"
^DIC(9.4,70,22,2,"PAH",5,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,41,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,42,0)="   1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",5,1,43,0)="       PCMM) during the installation.  No Broker-based client/server"
^DIC(9.4,70,22,2,"PAH",5,1,44,0)="       software should be running while installing this patch on the"
^DIC(9.4,70,22,2,"PAH",5,1,45,0)="       server.  To identify these jobs, check the system status and verify"
^DIC(9.4,70,22,2,"PAH",5,1,46,0)="       if any XWBTCPC routines are running (i.e., Broker Handler).  Once"
^DIC(9.4,70,22,2,"PAH",5,1,47,0)="       identified, notify users to logoff or forcex the jobs.  Active"
^DIC(9.4,70,22,2,"PAH",5,1,48,0)="       users may get NOSOURCE or CLOBBER errors."
^DIC(9.4,70,22,2,"PAH",5,1,49,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,50,0)="   2.  Stop the Broker Listener on the server.  Check the system status"
^DIC(9.4,70,22,2,"PAH",5,1,51,0)="       and verify if the XWBTCPL routine is running (i.e., Broker"
^DIC(9.4,70,22,2,"PAH",5,1,52,0)="       Listener).  If it is running stop it.  To stop the Listener, do the"
^DIC(9.4,70,22,2,"PAH",5,1,53,0)="       following:"
^DIC(9.4,70,22,2,"PAH",5,1,54,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,55,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",5,1,56,0)="           b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",5,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,58,0)="               >D STOP^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",5,1,59,0)="               (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",5,1,60,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,61,0)="   3.  Broker routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",5,1,62,0)="       you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",5,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,64,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",5,1,65,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",5,1,66,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,67,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",5,1,68,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",5,1,69,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",5,1,70,0)="       options:"
^DIC(9.4,70,22,2,"PAH",5,1,71,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,72,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",5,1,73,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",5,1,74,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",5,1,75,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",5,1,76,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,77,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,78,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",5,1,79,0)="       option:"
^DIC(9.4,70,22,2,"PAH",5,1,80,0)="         Install Package(s)  'XWB*1.1*7'"
^DIC(9.4,70,22,2,"PAH",5,1,81,0)="                              ========="
^DIC(9.4,70,22,2,"PAH",5,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,83,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",5,1,84,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",5,1,85,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",5,1,86,0)="                                                                        "
^DIC(9.4,70,22,2,"PAH",5,1,87,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,88,0)="   7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",5,1,89,0)="       other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,70,22,2,"PAH",5,1,90,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,91,0)="   8.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",5,1,92,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",5,1,93,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,94,0)="   9.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",5,1,95,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",5,1,96,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",5,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,98,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",5,1,99,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",5,1,100,0)=" "
^DIC(9.4,70,22,2,"PAH",5,1,101,0)="======================================================================"
^DIC(9.4,70,22,2,"PAH",6,0)="4 SEQ #6^2990624^1"
^DIC(9.4,70,22,2,"PAH",6,1,0)="^^157^157^2990624"
^DIC(9.4,70,22,2,"PAH",6,1,1,0)="This patch:"
^DIC(9.4,70,22,2,"PAH",6,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,3,0)="1.  Introduces a shorter timeout when logging in via any GUI application"
^DIC(9.4,70,22,2,"PAH",6,1,4,0)="that is using the Broker.  The server listener process will timeout after"
^DIC(9.4,70,22,2,"PAH",6,1,5,0)="90 seconds if the user has not passed in his/her access and verify codes."
^DIC(9.4,70,22,2,"PAH",6,1,6,0)="Users of existing GUI applications which were compiled under an older"
^DIC(9.4,70,22,2,"PAH",6,1,7,0)="version of the BDK will not see the shorter timeout unless the GUI"
^DIC(9.4,70,22,2,"PAH",6,1,8,0)="application is recompiled.  It is highly recommended that applications be"
^DIC(9.4,70,22,2,"PAH",6,1,9,0)="recompiled using the new BDK to take advantage of the shorter timeout"
^DIC(9.4,70,22,2,"PAH",6,1,10,0)="during login."
^DIC(9.4,70,22,2,"PAH",6,1,11,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,12,0)="2.  Updates the Broker's programmer client workstation software -- also"
^DIC(9.4,70,22,2,"PAH",6,1,13,0)="known as the Broker Development Kit (BDK) -- adding support for Delphi 4"
^DIC(9.4,70,22,2,"PAH",6,1,14,0)="development."
^DIC(9.4,70,22,2,"PAH",6,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,16,0)="3.  Fixes a bug in which the title bar of the Kernel login form was being"
^DIC(9.4,70,22,2,"PAH",6,1,17,0)="changed when a user started entering their access code."
^DIC(9.4,70,22,2,"PAH",6,1,18,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,19,0)="IMPORTANT NOTES:"
^DIC(9.4,70,22,2,"PAH",6,1,20,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,21,0)="This patch consists of 2 parts:"
^DIC(9.4,70,22,2,"PAH",6,1,22,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,23,0)=" - Packman message containing the XWB*1.1*4 KIDS build."
^DIC(9.4,70,22,2,"PAH",6,1,24,0)=" - An updated BDK (programmer client workstation software)."
^DIC(9.4,70,22,2,"PAH",6,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,26,0)="1.  Packman message containing the XWB*1.1*4 KIDS build. It installs 2"
^DIC(9.4,70,22,2,"PAH",6,1,27,0)="modified XWB* routines used by the Broker server. This part of the patch"
^DIC(9.4,70,22,2,"PAH",6,1,28,0)="is mandatory."
^DIC(9.4,70,22,2,"PAH",6,1,29,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,30,0)=" ROUTINE SUMMARY:"
^DIC(9.4,70,22,2,"PAH",6,1,31,0)=" ================"
^DIC(9.4,70,22,2,"PAH",6,1,32,0)=" The following is a list of the routines included in this patch.  The"
^DIC(9.4,70,22,2,"PAH",6,1,33,0)=" second line of each of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",6,1,34,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,35,0)=" <tab>;;1.1;RPC BROKER;[patch list];date"
^DIC(9.4,70,22,2,"PAH",6,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,37,0)=" CHECK^XTSUMBLD results:"
^DIC(9.4,70,22,2,"PAH",6,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,39,0)=" Routine Name      Before Patch     After Patch     Patch List"
^DIC(9.4,70,22,2,"PAH",6,1,40,0)=" XWBBRK            4562161          4567623         2,4"
^DIC(9.4,70,22,2,"PAH",6,1,41,0)=" XWBTCPC           8239171          7518635         2,5,4"
^DIC(9.4,70,22,2,"PAH",6,1,42,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,43,0)="2. Updated BDK (programmer client workstation software). All sites"
^DIC(9.4,70,22,2,"PAH",6,1,44,0)="doing Broker development are encouraged to retrieve the patched BDK. Note"
^DIC(9.4,70,22,2,"PAH",6,1,45,0)="that this version of the BDK only supports Delphi 4 and Delphi 3."
^DIC(9.4,70,22,2,"PAH",6,1,46,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,47,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE AT"
^DIC(9.4,70,22,2,"PAH",6,1,48,0)="END-USER CLIENT WORKSTATIONS.  If you are not using the BDK in any local"
^DIC(9.4,70,22,2,"PAH",6,1,49,0)="or national development, you do not need to retrieve the Broker's"
^DIC(9.4,70,22,2,"PAH",6,1,50,0)="programmer client workstation software. The software does not update the"
^DIC(9.4,70,22,2,"PAH",6,1,51,0)="Broker software that is running at end-user client workstations."
^DIC(9.4,70,22,2,"PAH",6,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,53,0)="The software distribution includes:"
^DIC(9.4,70,22,2,"PAH",6,1,54,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,55,0)="FILE NAMES      DESCRIPTION                     Blocks          Bytes"
^DIC(9.4,70,22,2,"PAH",6,1,56,0)="XWB1_1P4PG.EXE  BDK Self-Installing Executable    2944        1507118"
^DIC(9.4,70,22,2,"PAH",6,1,57,0)="XWB1_1P4IG.PDF  Installation Guide                 382         195583"
^DIC(9.4,70,22,2,"PAH",6,1,58,0)="XWB1_1RM.TXT    Readme text file                    15           7355"
^DIC(9.4,70,22,2,"PAH",6,1,59,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,60,0)="Note:  Use Binary mode for .PDF, and .EXE files"
^DIC(9.4,70,22,2,"PAH",6,1,61,0)="       Use ASCII mode for .TXT file."
^DIC(9.4,70,22,2,"PAH",6,1,62,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,63,0)="To access the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",6,1,64,0)="the following CIO Field Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,70,22,2,"PAH",6,1,65,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,66,0)="       CIO FIELD OFFICE                FTP Address"
^DIC(9.4,70,22,2,"PAH",6,1,67,0)="       Hines                           152.129.1.110"
^DIC(9.4,70,22,2,"PAH",6,1,68,0)="       Albany                          152.127.1.5"
^DIC(9.4,70,22,2,"PAH",6,1,69,0)="       Salt Lake City                  152.131.2.1"
^DIC(9.4,70,22,2,"PAH",6,1,70,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,71,0)="BROKER-DEPENDENT COMPONENTS:"
^DIC(9.4,70,22,2,"PAH",6,1,72,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,73,0)="Some components, such as the FileMan Delphi Components, reference the"
^DIC(9.4,70,22,2,"PAH",6,1,74,0)="TRPCBroker component.  If you use such components for development, be"
^DIC(9.4,70,22,2,"PAH",6,1,75,0)="aware that installing a new version of the TRPCBroker component (i.e. a"
^DIC(9.4,70,22,2,"PAH",6,1,76,0)="new BDK) may cause incompatibilities in Delphi, resulting in a compile"
^DIC(9.4,70,22,2,"PAH",6,1,77,0)="failure of the unit containing the Broker-dependent component and the"
^DIC(9.4,70,22,2,"PAH",6,1,78,0)="following compilation error:"
^DIC(9.4,70,22,2,"PAH",6,1,79,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,80,0)="       Unit <unit1> was compiled with a different version of <unit2>."
^DIC(9.4,70,22,2,"PAH",6,1,81,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,82,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",6,1,83,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",6,1,84,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,85,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",6,1,86,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,87,0)="b) You can obtain a new version of the component that is compatible."
^DIC(9.4,70,22,2,"PAH",6,1,88,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,89,0)="For the FileMan Delphi Components (FMDC), patch FMDC*1.0*1 brings in a new"
^DIC(9.4,70,22,2,"PAH",6,1,90,0)="version of FMDC compatible with the updated BDK.  Please refer to the"
^DIC(9.4,70,22,2,"PAH",6,1,91,0)="Patch Module for more information on this FMDC patch."
^DIC(9.4,70,22,2,"PAH",6,1,92,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,93,0)="INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",6,1,94,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,95,0)="Server Side:"
^DIC(9.4,70,22,2,"PAH",6,1,96,0)="============"
^DIC(9.4,70,22,2,"PAH",6,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,98,0)="Use the following instructions in installing this server-side RPC Broker"
^DIC(9.4,70,22,2,"PAH",6,1,99,0)="patch.  Do NOT follow the M Server Installation Instructions in the RPC"
^DIC(9.4,70,22,2,"PAH",6,1,100,0)="Broker Installation Guide to install the server portion of this patch. The"
^DIC(9.4,70,22,2,"PAH",6,1,101,0)="instructions in the Installation Guide are for virgin server installations"
^DIC(9.4,70,22,2,"PAH",6,1,102,0)="and server version upgrades only."
^DIC(9.4,70,22,2,"PAH",6,1,103,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,104,0)=" 1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",6,1,105,0)="PCMM) during the installation.  No Broker-based client/server software"
^DIC(9.4,70,22,2,"PAH",6,1,106,0)="should be running while installing this patch on the server.  To identify"
^DIC(9.4,70,22,2,"PAH",6,1,107,0)="these jobs, check the system status and verify if any XWBTCPC routine is"
^DIC(9.4,70,22,2,"PAH",6,1,108,0)="running (i.e., Broker Handler).  Once identified, notify users to logoff"
^DIC(9.4,70,22,2,"PAH",6,1,109,0)="or forcex the jobs.  Active users may get NOSOURCE or CLOBBER errors."
^DIC(9.4,70,22,2,"PAH",6,1,110,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,111,0)=" 2.  Stop the Broker Listener on the server.  Check the system status and"
^DIC(9.4,70,22,2,"PAH",6,1,112,0)="verify if the XWBTCPL routine is running (i.e., Broker Listener).  If it"
^DIC(9.4,70,22,2,"PAH",6,1,113,0)="is running stop it.  To stop the Listener, do the following:"
^DIC(9.4,70,22,2,"PAH",6,1,114,0)="       a.  Log into your M server."
^DIC(9.4,70,22,2,"PAH",6,1,115,0)="       b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",6,1,116,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,117,0)="       >D STOP^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",6,1,118,0)="       (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",6,1,119,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,120,0)=" 3.  These routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",6,1,121,0)="you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",6,1,122,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,123,0)=" 4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",6,1,124,0)="option will load the KIDS (Kernel Installation and Distribution System)"
^DIC(9.4,70,22,2,"PAH",6,1,125,0)="package onto your system."
^DIC(9.4,70,22,2,"PAH",6,1,126,0)="    "
^DIC(9.4,70,22,2,"PAH",6,1,127,0)=" 5.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,70,22,2,"PAH",6,1,128,0)="On the KIDS menu, select the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",6,1,129,0)="options:"
^DIC(9.4,70,22,2,"PAH",6,1,130,0)="         Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",6,1,131,0)="         Print Transport Global"
^DIC(9.4,70,22,2,"PAH",6,1,132,0)="         Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",6,1,133,0)="         Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",6,1,134,0)="    "
^DIC(9.4,70,22,2,"PAH",6,1,135,0)=" 6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",6,1,136,0)="option:"
^DIC(9.4,70,22,2,"PAH",6,1,137,0)="        Install Package(s)  'XWB*1.1*4'"
^DIC(9.4,70,22,2,"PAH",6,1,138,0)="                             ========="
^DIC(9.4,70,22,2,"PAH",6,1,139,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,140,0)=" 7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",6,1,141,0)="other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,70,22,2,"PAH",6,1,142,0)="     AXP Sites - Answer NO to this question."
^DIC(9.4,70,22,2,"PAH",6,1,143,0)="    "
^DIC(9.4,70,22,2,"PAH",6,1,144,0)=" 8.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",6,1,145,0)="should be rebuilt once the installation has run to completion."
^DIC(9.4,70,22,2,"PAH",6,1,146,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,147,0)=" 9.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",6,1,148,0)="       a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",6,1,149,0)="       b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",6,1,150,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,151,0)="       >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",6,1,152,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,153,0)="Client Side:"
^DIC(9.4,70,22,2,"PAH",6,1,154,0)="============"
^DIC(9.4,70,22,2,"PAH",6,1,155,0)=" "
^DIC(9.4,70,22,2,"PAH",6,1,156,0)="Please follow the 'Programmer Client Workstation Installation"
^DIC(9.4,70,22,2,"PAH",6,1,157,0)="Instructions' in the RPC Broker Installation Guide (XWB1_1P4IG.PDF)."
^DIC(9.4,70,22,2,"PAH",7,0)="6 SEQ #7^2990914^1"
^DIC(9.4,70,22,2,"PAH",7,1,0)="^^227^227^2990914"
^DIC(9.4,70,22,2,"PAH",7,1,1,0)="This patch eliminates server Broker jobs for which there is no client"
^DIC(9.4,70,22,2,"PAH",7,1,2,0)="application.  These 'ghost' jobs have occurred when client processes are"
^DIC(9.4,70,22,2,"PAH",7,1,3,0)="ended in a non-standard way - for example, by pressing the PC's reset"
^DIC(9.4,70,22,2,"PAH",7,1,4,0)="button.  "
^DIC(9.4,70,22,2,"PAH",7,1,5,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,6,0)="Note:  The server side of this patch is effective only for client"
^DIC(9.4,70,22,2,"PAH",7,1,7,0)="applications (like CPRS-GUI) that have been recompiled with the Broker"
^DIC(9.4,70,22,2,"PAH",7,1,8,0)="Development Kit portion of the patch.  So, installing the server patch"
^DIC(9.4,70,22,2,"PAH",7,1,9,0)="alone will not eliminate the ghost jobs for client applications that have"
^DIC(9.4,70,22,2,"PAH",7,1,10,0)="not been upgraded."
^DIC(9.4,70,22,2,"PAH",7,1,11,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,12,0)="Prior to this patch, these jobs would wait for 10 hours to receive data"
^DIC(9.4,70,22,2,"PAH",7,1,13,0)="from the client application that no longer exists.  Two significant"
^DIC(9.4,70,22,2,"PAH",7,1,14,0)="negative effects of the ghost jobs are 1) consumption of a licensed"
^DIC(9.4,70,22,2,"PAH",7,1,15,0)="process, reducing the available number of user jobs and 2) retention of"
^DIC(9.4,70,22,2,"PAH",7,1,16,0)="application resources (particularly LOCKs) that interferes with subsequent"
^DIC(9.4,70,22,2,"PAH",7,1,17,0)="user actions.  Other than waiting 10 hours for these jobs to finally"
^DIC(9.4,70,22,2,"PAH",7,1,18,0)="timeout, the only way to get rid of the ghost jobs was for IRM to manually"
^DIC(9.4,70,22,2,"PAH",7,1,19,0)="kill them."
^DIC(9.4,70,22,2,"PAH",7,1,20,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,21,0)="This patch changes the time that the server waits for the client to"
^DIC(9.4,70,22,2,"PAH",7,1,22,0)="contact it.  The length of the timeout is controlled by a new field in the"
^DIC(9.4,70,22,2,"PAH",7,1,23,0)="Kernel System Parameters file: BROKER ACTIVITY TIMEOUT.  That field is"
^DIC(9.4,70,22,2,"PAH",7,1,24,0)="distributed by Kernel patch XU*8.0*115 with a default value of"
^DIC(9.4,70,22,2,"PAH",7,1,25,0)="approximately 3 minutes.  By setting the timeout to a duration much"
^DIC(9.4,70,22,2,"PAH",7,1,26,0)="shorter than 10 hours, the ghost jobs are eliminated quickly if the client"
^DIC(9.4,70,22,2,"PAH",7,1,27,0)="application is no longer running.  See the help for the BROKER ACTIVITY"
^DIC(9.4,70,22,2,"PAH",7,1,28,0)="TIMEOUT field for advice regarding changing the value for this field."
^DIC(9.4,70,22,2,"PAH",7,1,29,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,30,0)="In order to let the server know that the client application is still"
^DIC(9.4,70,22,2,"PAH",7,1,31,0)="active, the client portion of this patch initiates a periodic, background"
^DIC(9.4,70,22,2,"PAH",7,1,32,0)="contact with the server.  This 'polling' of the server by the client"
^DIC(9.4,70,22,2,"PAH",7,1,33,0)="resets the timeout so that the server job is not stopped when the client"
^DIC(9.4,70,22,2,"PAH",7,1,34,0)="still exists.  Any client application compiled with the RPCBroker"
^DIC(9.4,70,22,2,"PAH",7,1,35,0)="component distributed with this patch automatically polls.  No developer"
^DIC(9.4,70,22,2,"PAH",7,1,36,0)="or user intervention is necessary, and this polling activity affects"
^DIC(9.4,70,22,2,"PAH",7,1,37,0)="neither the application nor the user."
^DIC(9.4,70,22,2,"PAH",7,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,39,0)="This patch specifically resolves problems raised in the following NOISs:"
^DIC(9.4,70,22,2,"PAH",7,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,41,0)="BIR-0399-32032     GUI LOCKES UP ON USERS"
^DIC(9.4,70,22,2,"PAH",7,1,42,0)="OKL-1298-70542     LOCKOUT FROM GUI"
^DIC(9.4,70,22,2,"PAH",7,1,43,0)="HUN-0898-21008     Providers are locked out of record"
^DIC(9.4,70,22,2,"PAH",7,1,44,0)="SAG-0898-40564     TIMEOUT MANAGMENT ON GUI"
^DIC(9.4,70,22,2,"PAH",7,1,45,0)="DAY-0798-40953     No DTIME in XWBTCPC"
^DIC(9.4,70,22,2,"PAH",7,1,46,0)="TUA-0598-30739     GUI JOBS HANGING AROUND"
^DIC(9.4,70,22,2,"PAH",7,1,47,0)="WAS-0198-20958     SYSTEM NOT RELEASING USER AFTER CLOSING CHART"
^DIC(9.4,70,22,2,"PAH",7,1,48,0)="BIR-0699-31167     BROKER TIMEOUT"
^DIC(9.4,70,22,2,"PAH",7,1,49,0)="SDC-0499-62471     PATIENT RECORDS LOCKED UP"
^DIC(9.4,70,22,2,"PAH",7,1,50,0)="ALB-0499-52063     Patient Record Locked"
^DIC(9.4,70,22,2,"PAH",7,1,51,0)="HIN-0599-42485     CPRS CONNECTIONS REMAIN ACTIVE AFTER LOGOUT"
^DIC(9.4,70,22,2,"PAH",7,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,53,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,54,0)="It also fulfills a request made in the following E3R:"
^DIC(9.4,70,22,2,"PAH",7,1,55,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,56,0)="9646               CHANGE OF MAIN TIMED READ FOR BROKER"
^DIC(9.4,70,22,2,"PAH",7,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,58,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,59,0)="IMPORTANT NOTES: "
^DIC(9.4,70,22,2,"PAH",7,1,60,0)="========= ====="
^DIC(9.4,70,22,2,"PAH",7,1,61,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,62,0)="This patch consists of 2 parts: "
^DIC(9.4,70,22,2,"PAH",7,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,64,0)=" - Packman message containing the XWB*1.1*6 KIDS build.  "
^DIC(9.4,70,22,2,"PAH",7,1,65,0)=" - An updated Broker Development Kit (programmer workstation software).  "
^DIC(9.4,70,22,2,"PAH",7,1,66,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,67,0)="1. The packman message containing the XWB*1.1*6 KIDS build installs 3"
^DIC(9.4,70,22,2,"PAH",7,1,68,0)="modified XWB* routines and a new RPC (entry in the Remote Procedure file)"
^DIC(9.4,70,22,2,"PAH",7,1,69,0)="used by the Broker server. This part of the patch is mandatory.  "
^DIC(9.4,70,22,2,"PAH",7,1,70,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,71,0)="Routine Summary: "
^DIC(9.4,70,22,2,"PAH",7,1,72,0)="======= ========"
^DIC(9.4,70,22,2,"PAH",7,1,73,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,74,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,70,22,2,"PAH",7,1,75,0)="second line of each of these routines now looks like: "
^DIC(9.4,70,22,2,"PAH",7,1,76,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,77,0)="<tab>;;1.1;RPC BROKER;[patch list];date "
^DIC(9.4,70,22,2,"PAH",7,1,78,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,79,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,70,22,2,"PAH",7,1,80,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,81,0)="Routine Name      Before Patch     After Patch     Patch List "
^DIC(9.4,70,22,2,"PAH",7,1,82,0)="XWBTCPC             7518635         7635440          2,5,4,6  "
^DIC(9.4,70,22,2,"PAH",7,1,83,0)="XWBLIB              674092          720789           6        "
^DIC(9.4,70,22,2,"PAH",7,1,84,0)="XWBSEC              1317713         2113752          3,6      "
^DIC(9.4,70,22,2,"PAH",7,1,85,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,86,0)="2. Updated BDK (programmer client workstation software). All sites doing"
^DIC(9.4,70,22,2,"PAH",7,1,87,0)="Broker development are encouraged to retrieve the patched BDK. Note that"
^DIC(9.4,70,22,2,"PAH",7,1,88,0)="this version of the BDK only supports Delphi 4 and Delphi 3.  "
^DIC(9.4,70,22,2,"PAH",7,1,89,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,90,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE ON END-USER"
^DIC(9.4,70,22,2,"PAH",7,1,91,0)="CLIENT WORKSTATIONS.  If you are not using the BDK in any local or"
^DIC(9.4,70,22,2,"PAH",7,1,92,0)="national development, you do not need to retrieve the Broker's programmer"
^DIC(9.4,70,22,2,"PAH",7,1,93,0)="client workstation software.  The patch does not update the Broker"
^DIC(9.4,70,22,2,"PAH",7,1,94,0)="software that is running at end-user client workstations.  "
^DIC(9.4,70,22,2,"PAH",7,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,96,0)="The software distribution includes: "
^DIC(9.4,70,22,2,"PAH",7,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,98,0)="FILE NAMES      DESCRIPTION                              BYTES"
^DIC(9.4,70,22,2,"PAH",7,1,99,0)="XWB1_1P6PG.EXE  BDK Self-Installing Executable           1,500,607"
^DIC(9.4,70,22,2,"PAH",7,1,100,0)="XWB1_1P4IG.PDF  Installation Guide                       195,583"
^DIC(9.4,70,22,2,"PAH",7,1,101,0)="XWB1_1RM.TXT    Readme text file                         13,428*"
^DIC(9.4,70,22,2,"PAH",7,1,102,0)="*The size of this file will change in the future as additions are made."
^DIC(9.4,70,22,2,"PAH",7,1,103,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,104,0)="Note:  Use Binary mode to retrieve .PDF, and .EXE files "
^DIC(9.4,70,22,2,"PAH",7,1,105,0)="       Use ASCII mode to retrieve .TXT file.  "
^DIC(9.4,70,22,2,"PAH",7,1,106,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,107,0)="To obtain the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",7,1,108,0)="the following CIO Field Offices' ANONYMOUS.SOFTWARE directories: "
^DIC(9.4,70,22,2,"PAH",7,1,109,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,110,0)="       CIO FIELD OFFICE              FTP Address "
^DIC(9.4,70,22,2,"PAH",7,1,111,0)="       Hines                         152.129.1.110 (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",7,1,112,0)="       Albany                        152.127.1.5   (isc-albany.domain.ext)"
^DIC(9.4,70,22,2,"PAH",7,1,113,0)="       Salt Lake City                152.131.2.1   (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",7,1,114,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,115,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,116,0)="COMPATIBILITY WITH PRIOR VERSIONS"
^DIC(9.4,70,22,2,"PAH",7,1,117,0)="============= ==== ===== ========"
^DIC(9.4,70,22,2,"PAH",7,1,118,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,119,0)="The server portion of this patch is backwards compatible with client"
^DIC(9.4,70,22,2,"PAH",7,1,120,0)="applications compiled with previous versions of the Broker.  So, client"
^DIC(9.4,70,22,2,"PAH",7,1,121,0)="applications do not have to be recompiled when this patch is installed on"
^DIC(9.4,70,22,2,"PAH",7,1,122,0)="the server. The server retains a 10 hour timeout for those client"
^DIC(9.4,70,22,2,"PAH",7,1,123,0)="applications compiled with previous Broker versions; that is, they"
^DIC(9.4,70,22,2,"PAH",7,1,124,0)="continue to work as they did before the patch is installed."
^DIC(9.4,70,22,2,"PAH",7,1,125,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,126,0)="If an application is compiled with the BDK for XWB*1.1*6, the server"
^DIC(9.4,70,22,2,"PAH",7,1,127,0)="XWB*1.1*6 patch MUST be installed for that application to run.  That is,"
^DIC(9.4,70,22,2,"PAH",7,1,128,0)="client portion of this patch requires that the server portion be"
^DIC(9.4,70,22,2,"PAH",7,1,129,0)="installed."
^DIC(9.4,70,22,2,"PAH",7,1,130,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,131,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,132,0)="BROKER-DEPENDENT COMPONENTS"
^DIC(9.4,70,22,2,"PAH",7,1,133,0)="================ =========="
^DIC(9.4,70,22,2,"PAH",7,1,134,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,135,0)="The following comments apply only to those developing applications with"
^DIC(9.4,70,22,2,"PAH",7,1,136,0)="the BDK (programmer workstation software).  They are not relevant to"
^DIC(9.4,70,22,2,"PAH",7,1,137,0)="server operation."
^DIC(9.4,70,22,2,"PAH",7,1,138,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,139,0)="Some components, such as the FileMan Delphi Components, reference the"
^DIC(9.4,70,22,2,"PAH",7,1,140,0)="TRPCBroker component.  If you use such components for development, be"
^DIC(9.4,70,22,2,"PAH",7,1,141,0)="aware that installing a new version of the TRPCBroker component (i.e., a"
^DIC(9.4,70,22,2,"PAH",7,1,142,0)="new BDK) may cause incompatibilities in Delphi, resulting in a compile"
^DIC(9.4,70,22,2,"PAH",7,1,143,0)="failure of the unit containing the Broker-dependent component and the"
^DIC(9.4,70,22,2,"PAH",7,1,144,0)="following compilation error:"
^DIC(9.4,70,22,2,"PAH",7,1,145,0)="  "
^DIC(9.4,70,22,2,"PAH",7,1,146,0)="        Unit <unit1> was compiled with a different version of <unit2>."
^DIC(9.4,70,22,2,"PAH",7,1,147,0)="  "
^DIC(9.4,70,22,2,"PAH",7,1,148,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",7,1,149,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",7,1,150,0)="  "
^DIC(9.4,70,22,2,"PAH",7,1,151,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",7,1,152,0)="  "
^DIC(9.4,70,22,2,"PAH",7,1,153,0)="b) You can obtain a new version of the component that is compatible, or"
^DIC(9.4,70,22,2,"PAH",7,1,154,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,155,0)="c) You have the source (.pas, .dfm, .dpk, etc.) files available so that"
^DIC(9.4,70,22,2,"PAH",7,1,156,0)="the component can be recompiled successfully."
^DIC(9.4,70,22,2,"PAH",7,1,157,0)="  "
^DIC(9.4,70,22,2,"PAH",7,1,158,0)="For the FileMan Delphi Components (FMDC), patch FMDC*1.0*1 brings in a new"
^DIC(9.4,70,22,2,"PAH",7,1,159,0)="version of the FMDC that includes the source files.  Please refer to the"
^DIC(9.4,70,22,2,"PAH",7,1,160,0)="Patch Module for more information on this FMDC patch.  Additional"
^DIC(9.4,70,22,2,"PAH",7,1,161,0)="instructions regarding installing and recompiling FMDC when the Broker is"
^DIC(9.4,70,22,2,"PAH",7,1,162,0)="upgraded are in XWB1_1RM.TXT found in the ANONYMOUS.SOFTWARE directories"
^DIC(9.4,70,22,2,"PAH",7,1,163,0)="mentioned above and on the FMDC web page."
^DIC(9.4,70,22,2,"PAH",7,1,164,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,165,0)="INSTALLATION: "
^DIC(9.4,70,22,2,"PAH",7,1,166,0)="============"
^DIC(9.4,70,22,2,"PAH",7,1,167,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,168,0)="Server Side: "
^DIC(9.4,70,22,2,"PAH",7,1,169,0)="====== ===="
^DIC(9.4,70,22,2,"PAH",7,1,170,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,171,0)="The following are the installation instructions for the KIDS distribution"
^DIC(9.4,70,22,2,"PAH",7,1,172,0)="for XWB*1.1*6: "
^DIC(9.4,70,22,2,"PAH",7,1,173,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,174,0)=" 1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",7,1,175,0)="PCMM) during the installation.  No Broker-based client/server software"
^DIC(9.4,70,22,2,"PAH",7,1,176,0)="should be running while installing this patch on the server.  To identify"
^DIC(9.4,70,22,2,"PAH",7,1,177,0)="these jobs, check the system status and see if any XWBTCPC routine is"
^DIC(9.4,70,22,2,"PAH",7,1,178,0)="running (i.e., Broker Handler).  Once identified, notify users to logoff"
^DIC(9.4,70,22,2,"PAH",7,1,179,0)="or forcex the jobs.  Active users may get NOSOURCE or CLOBBER errors.  "
^DIC(9.4,70,22,2,"PAH",7,1,180,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,181,0)=" 2.  Stop the Broker Listener on the server.  Check the system status and"
^DIC(9.4,70,22,2,"PAH",7,1,182,0)="see if the XWBTCPL routine is running (i.e., Broker Listener).  If it is"
^DIC(9.4,70,22,2,"PAH",7,1,183,0)="running stop it.  To stop the Listener, do the following: "
^DIC(9.4,70,22,2,"PAH",7,1,184,0)="       a.  Log into your M server.  "
^DIC(9.4,70,22,2,"PAH",7,1,185,0)="       b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",7,1,186,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,187,0)="       >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",7,1,188,0)="       (Typically, the Listener port is 9200"
^DIC(9.4,70,22,2,"PAH",7,1,189,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,190,0)=" 3.  These routines are not usually mapped on systems that support"
^DIC(9.4,70,22,2,"PAH",7,1,191,0)="mapping; so, you will probably not have to disable mapping.  "
^DIC(9.4,70,22,2,"PAH",7,1,192,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,193,0)=" 4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",7,1,194,0)="option will load the KIDS (Kernel Installation and Distribution System)"
^DIC(9.4,70,22,2,"PAH",7,1,195,0)="package onto your system.  "
^DIC(9.4,70,22,2,"PAH",7,1,196,0)="    "
^DIC(9.4,70,22,2,"PAH",7,1,197,0)=" 5.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,70,22,2,"PAH",7,1,198,0)=" On the KIDS menu, select the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",7,1,199,0)="options: "
^DIC(9.4,70,22,2,"PAH",7,1,200,0)="         Verify Checksum's in Transport Global "
^DIC(9.4,70,22,2,"PAH",7,1,201,0)="         Print Transport Global "
^DIC(9.4,70,22,2,"PAH",7,1,202,0)="         Compare Transport Global to Current System "
^DIC(9.4,70,22,2,"PAH",7,1,203,0)="         Backup a Transport Global "
^DIC(9.4,70,22,2,"PAH",7,1,204,0)="    "
^DIC(9.4,70,22,2,"PAH",7,1,205,0)=" 6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",7,1,206,0)="option: "
^DIC(9.4,70,22,2,"PAH",7,1,207,0)="        Install Package(s)  'XWB*1.1*6' "
^DIC(9.4,70,22,2,"PAH",7,1,208,0)="                             ========="
^DIC(9.4,70,22,2,"PAH",7,1,209,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,210,0)=" 7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",7,1,211,0)="other CPUs?'. Enter the names of your Compute and Print server(s).  "
^DIC(9.4,70,22,2,"PAH",7,1,212,0)="     AXP Sites - Answer NO to this question.  "
^DIC(9.4,70,22,2,"PAH",7,1,213,0)="    "
^DIC(9.4,70,22,2,"PAH",7,1,214,0)=" 8.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",7,1,215,0)="should be rebuilt once the installation has run to completion.  "
^DIC(9.4,70,22,2,"PAH",7,1,216,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,217,0)=" 9.  Restart the Broker Listener on the Server: "
^DIC(9.4,70,22,2,"PAH",7,1,218,0)="       a.  Log into your M server "
^DIC(9.4,70,22,2,"PAH",7,1,219,0)="       b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",7,1,220,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,221,0)="       >D STRT^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",7,1,222,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,223,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,224,0)="Client Side: "
^DIC(9.4,70,22,2,"PAH",7,1,225,0)=" "
^DIC(9.4,70,22,2,"PAH",7,1,226,0)="Please follow the instructions in the most recent Broker 1.1 Installation"
^DIC(9.4,70,22,2,"PAH",7,1,227,0)="Guide."
^DIC(9.4,70,22,2,"PAH",8,0)="8 SEQ #8^2991213^1"
^DIC(9.4,70,22,2,"PAH",8,1,0)="^^89^89^2991213"
^DIC(9.4,70,22,2,"PAH",8,1,1,0)="**  Y2K WAIVER - #Y2KW0001  **"
^DIC(9.4,70,22,2,"PAH",8,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,3,0)="This patch supports GUI Multi-Divisional signon.  If a user has more"
^DIC(9.4,70,22,2,"PAH",8,1,4,0)="than one division to choose from, the user must select one  before"
^DIC(9.4,70,22,2,"PAH",8,1,5,0)="continuing with signon.  If the user has only one division in file 200,"
^DIC(9.4,70,22,2,"PAH",8,1,6,0)="this division will be used; else, the default institution in the"
^DIC(9.4,70,22,2,"PAH",8,1,7,0)="Kernel System Parameters file will be used."
^DIC(9.4,70,22,2,"PAH",8,1,8,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,9,0)="This patch specifically resolves problems reported in the following NOISs:"
^DIC(9.4,70,22,2,"PAH",8,1,10,0)=" EKH-1298-40440     Divisional Parameters"
^DIC(9.4,70,22,2,"PAH",8,1,11,0)=" EKH-0399-40543     WHEN ENTERING THROUGH THE GUI the submit request"
^DIC(9.4,70,22,2,"PAH",8,1,12,0)=" HVH-0699-12732     GUI ONLY USES PRIMARY SITE FIELDS: IC LAB ORDERS"
^DIC(9.4,70,22,2,"PAH",8,1,13,0)=" FGH-0299-32563     MultiDivisional Capabilities"
^DIC(9.4,70,22,2,"PAH",8,1,14,0)=" BHH-0799-41993     Lab Collection Printing Problem for Integrated Sites"
^DIC(9.4,70,22,2,"PAH",8,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,16,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,17,0)="IMPORTANT NOTES: "
^DIC(9.4,70,22,2,"PAH",8,1,18,0)="================="
^DIC(9.4,70,22,2,"PAH",8,1,19,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,20,0)="This patch consists of 1 part ONLY: "
^DIC(9.4,70,22,2,"PAH",8,1,21,0)="- An updated Broker Development Kit (BDK), the programmer workstation"
^DIC(9.4,70,22,2,"PAH",8,1,22,0)="software.  All sites doing Broker development are encouraged to retrieve"
^DIC(9.4,70,22,2,"PAH",8,1,23,0)="the patched BDK. Note that this version of the BDK only supports Delphi 4"
^DIC(9.4,70,22,2,"PAH",8,1,24,0)="and Delphi 3.  This patch doesn't support Delphi 5."
^DIC(9.4,70,22,2,"PAH",8,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,26,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE ON END-USER"
^DIC(9.4,70,22,2,"PAH",8,1,27,0)="CLIENT WORKSTATIONS.  If you are not using the BDK in any local or"
^DIC(9.4,70,22,2,"PAH",8,1,28,0)="national development, you do not need to retrieve the Broker's programmer"
^DIC(9.4,70,22,2,"PAH",8,1,29,0)="client workstation software.  The patch does not update the Broker"
^DIC(9.4,70,22,2,"PAH",8,1,30,0)="software that is running at end-user client workstations.  "
^DIC(9.4,70,22,2,"PAH",8,1,31,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,32,0)="The software distribution includes: "
^DIC(9.4,70,22,2,"PAH",8,1,33,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,34,0)="FILE NAMES      DESCRIPTION                       Bytes "
^DIC(9.4,70,22,2,"PAH",8,1,35,0)="XWB1_1P8PG.EXE  BDK Self-Installing Executable    1,636,409"
^DIC(9.4,70,22,2,"PAH",8,1,36,0)="XWB1_1P4IG.PDF  Installation Guide                195,583      "
^DIC(9.4,70,22,2,"PAH",8,1,37,0)="XWB1_1RM.TXT    Readme text file                  13,428*"
^DIC(9.4,70,22,2,"PAH",8,1,38,0)="*The size of this file will change in the future as additions are made."
^DIC(9.4,70,22,2,"PAH",8,1,39,0)="      "
^DIC(9.4,70,22,2,"PAH",8,1,40,0)="Note:  Use Binary mode to retrieve .PDF, and .EXE files "
^DIC(9.4,70,22,2,"PAH",8,1,41,0)="       Use ASCII mode to retrieve .TXT file.  "
^DIC(9.4,70,22,2,"PAH",8,1,42,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,43,0)="To obtain the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",8,1,44,0)="the following CIO Field Offices' ANONYMOUS.SOFTWARE directories: "
^DIC(9.4,70,22,2,"PAH",8,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,46,0)="       CIO FIELD OFFICE                FTP Address "
^DIC(9.4,70,22,2,"PAH",8,1,47,0)="       Hines                           152.129.1.110 (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",8,1,48,0)="       Albany                          152.127.1.5 (isc-albany.domain.ext)"
^DIC(9.4,70,22,2,"PAH",8,1,49,0)="       Salt Lake City                  152.131.2.1 (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",8,1,50,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,51,0)="BROKER-DEPENDENT COMPONENTS"
^DIC(9.4,70,22,2,"PAH",8,1,52,0)="==========================="
^DIC(9.4,70,22,2,"PAH",8,1,53,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,54,0)="The following comments apply only to those developing applications with"
^DIC(9.4,70,22,2,"PAH",8,1,55,0)="the BDK (programmer workstation software).  They are not relevant to"
^DIC(9.4,70,22,2,"PAH",8,1,56,0)="server operation."
^DIC(9.4,70,22,2,"PAH",8,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,58,0)="WARNING:"
^DIC(9.4,70,22,2,"PAH",8,1,59,0)="Some components, such as the FileMan Delphi Components, reference the"
^DIC(9.4,70,22,2,"PAH",8,1,60,0)="TRPCBroker component.  If you use such components for development, be"
^DIC(9.4,70,22,2,"PAH",8,1,61,0)="aware that installing a new version of the TRPCBroker component (i.e., a"
^DIC(9.4,70,22,2,"PAH",8,1,62,0)="new BDK) may cause incompatibilities in Delphi, resulting in a compile"
^DIC(9.4,70,22,2,"PAH",8,1,63,0)="failure of the unit containing the Broker-dependent component and the"
^DIC(9.4,70,22,2,"PAH",8,1,64,0)="following compilation error:"
^DIC(9.4,70,22,2,"PAH",8,1,65,0)="  "
^DIC(9.4,70,22,2,"PAH",8,1,66,0)="        Unit <unit1> was compiled with a different version of <unit2>."
^DIC(9.4,70,22,2,"PAH",8,1,67,0)="  "
^DIC(9.4,70,22,2,"PAH",8,1,68,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",8,1,69,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",8,1,70,0)="  "
^DIC(9.4,70,22,2,"PAH",8,1,71,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",8,1,72,0)="  "
^DIC(9.4,70,22,2,"PAH",8,1,73,0)="b) You can obtain a new version of the component that is compatible, or"
^DIC(9.4,70,22,2,"PAH",8,1,74,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,75,0)="c) You have the source (.pas) files available so that the component can be"
^DIC(9.4,70,22,2,"PAH",8,1,76,0)="recompiled successfully."
^DIC(9.4,70,22,2,"PAH",8,1,77,0)="  "
^DIC(9.4,70,22,2,"PAH",8,1,78,0)="For the FileMan Delphi Components (FMDC), patch FMDC*1.0*1 brings in a new"
^DIC(9.4,70,22,2,"PAH",8,1,79,0)="version of the FMDC that includes the source files.  Please refer to the"
^DIC(9.4,70,22,2,"PAH",8,1,80,0)="Patch Module for more information on this FMDC patch.  Additional"
^DIC(9.4,70,22,2,"PAH",8,1,81,0)="instructions regarding installing and recompiling FMDC when the Broker is"
^DIC(9.4,70,22,2,"PAH",8,1,82,0)="upgraded are in XWB1_1RM.TXT found in the ANONYMOUS.SOFTWARE directories"
^DIC(9.4,70,22,2,"PAH",8,1,83,0)="mentioned above and on the FMDC web page."
^DIC(9.4,70,22,2,"PAH",8,1,84,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,85,0)="CLIENT SIDE INSTALLATION: "
^DIC(9.4,70,22,2,"PAH",8,1,86,0)="========================"
^DIC(9.4,70,22,2,"PAH",8,1,87,0)=" "
^DIC(9.4,70,22,2,"PAH",8,1,88,0)="THIS IS A CLIENT SIDE PATCH ONLY.  Please follow the instructions in the"
^DIC(9.4,70,22,2,"PAH",8,1,89,0)="most recent Broker 1.1 Installation Guide."
^DIC(9.4,70,22,2,"PAH",9,0)="9 SEQ #9^3000125^1"
^DIC(9.4,70,22,2,"PAH",9,1,0)="^^164^164^3000125"
^DIC(9.4,70,22,2,"PAH",9,1,1,0)="This patch fixes the following: "
^DIC(9.4,70,22,2,"PAH",9,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,3,0)="1.  Intersystems License.    This is the patch that works with patch"
^DIC(9.4,70,22,2,"PAH",9,1,4,0)="XU*8*118. The code to share licenses when GUI and Telnet users from the"
^DIC(9.4,70,22,2,"PAH",9,1,5,0)="same workstation are connected is in place and ZU now calls it.  This"
^DIC(9.4,70,22,2,"PAH",9,1,6,0)="patch adds a similar call from XWBTCPC.  "
^DIC(9.4,70,22,2,"PAH",9,1,7,0)="              "
^DIC(9.4,70,22,2,"PAH",9,1,8,0)="2.  This patch brings a new XWB LISTENER STOP ALL option for shutting down"
^DIC(9.4,70,22,2,"PAH",9,1,9,0)="multiple listeners.  It also brings a modified option XWB LISTENER STARTER"
^DIC(9.4,70,22,2,"PAH",9,1,10,0)="for starting Broker listeners."
^DIC(9.4,70,22,2,"PAH",9,1,11,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,12,0)="These changes fulfill the functionality requested in the following E3Rs:"
^DIC(9.4,70,22,2,"PAH",9,1,13,0)="    11934, RPC BROKER FILE SHOWS RUNNING ON OPENM FAILOVER"
^DIC(9.4,70,22,2,"PAH",9,1,14,0)="    10705, LISTENERS NOT STOPPED WILL NOT START UP"
^DIC(9.4,70,22,2,"PAH",9,1,15,0)="     8789, CREATE MENU STARTUP AND SHUTDOWN OPTIONS"
^DIC(9.4,70,22,2,"PAH",9,1,16,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,17,0)="The changes also resolve the problems reported in the following NOIS"
^DIC(9.4,70,22,2,"PAH",9,1,18,0)="calls:"
^DIC(9.4,70,22,2,"PAH",9,1,19,0)="    DAY-0796-40646, Startup Queue of Listener"
^DIC(9.4,70,22,2,"PAH",9,1,20,0)="    FRE-0299-60491, Broker Not Starting Automatically"
^DIC(9.4,70,22,2,"PAH",9,1,21,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,22,0)="Here are the definitions of the options:"
^DIC(9.4,70,22,2,"PAH",9,1,23,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,24,0)="NAME: XWB LISTENER STARTER      MENU TEXT: Start All RPC Broker Listeners"
^DIC(9.4,70,22,2,"PAH",9,1,25,0)="  TYPE: run routine                     CREATOR: "
^DIC(9.4,70,22,2,"PAH",9,1,26,0)="  PACKAGE: RPC BROKER                   DELEGABLE: YES"
^DIC(9.4,70,22,2,"PAH",9,1,27,0)=" DESCRIPTION:   This option will Start/Restart all the RPC Broker"
^DIC(9.4,70,22,2,"PAH",9,1,28,0)="listeners under the control of the RPC BROKER SITE PARAMETERS file.  It is"
^DIC(9.4,70,22,2,"PAH",9,1,29,0)="normally setup as a STARTUP type option in the taskman option scheduling"
^DIC(9.4,70,22,2,"PAH",9,1,30,0)="file. This option will first STOP ALL listeners and then START ALL the"
^DIC(9.4,70,22,2,"PAH",9,1,31,0)="listeners through Taskman.  (VMS sites need to be running Taskman in DCL"
^DIC(9.4,70,22,2,"PAH",9,1,32,0)="context).  The XWB LISTENER STARTER cannot be used to start one particular"
^DIC(9.4,70,22,2,"PAH",9,1,33,0)="listener.  To do this, in programmer mode, use STRT^XWBTCP(portnumber) on"
^DIC(9.4,70,22,2,"PAH",9,1,34,0)="the node the listener needs to run on. Or use the XWB LISTENER EDIT option"
^DIC(9.4,70,22,2,"PAH",9,1,35,0)="to change the status of the one listener."
^DIC(9.4,70,22,2,"PAH",9,1,36,0)="  ROUTINE: RESTART^XWBTCP               SCHEDULING RECOMMENDED: STARTUP"
^DIC(9.4,70,22,2,"PAH",9,1,37,0)="  UPPERCASE MENU TEXT: START ALL RPC BROKER LISTENERS"
^DIC(9.4,70,22,2,"PAH",9,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,39,0)="NAME: XWB LISTENER STOP ALL       MENU TEXT: Stop All RPC Broker Listeners"
^DIC(9.4,70,22,2,"PAH",9,1,40,0)="  TYPE: run routine                     CREATOR: "
^DIC(9.4,70,22,2,"PAH",9,1,41,0)="  PACKAGE: RPC BROKER                   DELEGABLE: YES"
^DIC(9.4,70,22,2,"PAH",9,1,42,0)=" DESCRIPTION:   This option will Stop all the RPC Broker listeners under"
^DIC(9.4,70,22,2,"PAH",9,1,43,0)="the control of the RPC BROKER SITE PARAMETERS file."
^DIC(9.4,70,22,2,"PAH",9,1,44,0)="  ROUTINE: STOPALL^XWBTCP"
^DIC(9.4,70,22,2,"PAH",9,1,45,0)="  UPPERCASE MENU TEXT: STOP ALL RPC BROKER LISTENERS"
^DIC(9.4,70,22,2,"PAH",9,1,46,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,47,0)="3.  The code called by the XWB LISTENER STARTER option had a bug that"
^DIC(9.4,70,22,2,"PAH",9,1,48,0)="caused it to start the listeners on the default port of 9000.  This"
^DIC(9.4,70,22,2,"PAH",9,1,49,0)="problem is fixed.  The following NOIS calls reported the bug."
^DIC(9.4,70,22,2,"PAH",9,1,50,0)="              "
^DIC(9.4,70,22,2,"PAH",9,1,51,0)="    BEC-0999-21188   XWB  LISTENER STARTER "
^DIC(9.4,70,22,2,"PAH",9,1,52,0)="    STX-0999-71581   BROKER STARTING 9000 IGNORING PARAME "
^DIC(9.4,70,22,2,"PAH",9,1,53,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,54,0)="4.  A new menu option, XWB MAIN MENU, is included in this patch.  Another"
^DIC(9.4,70,22,2,"PAH",9,1,55,0)="option, XWB LISTENER EDIT, is also included.  Here are the option"
^DIC(9.4,70,22,2,"PAH",9,1,56,0)="definitions:"
^DIC(9.4,70,22,2,"PAH",9,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,58,0)="NAME: XWB MENU                     MENU TEXT: RPC Broker Management Menu"
^DIC(9.4,70,22,2,"PAH",9,1,59,0)="  TYPE: menu                            CREATOR: "
^DIC(9.4,70,22,2,"PAH",9,1,60,0)="  PACKAGE: RPC BROKER                   DELEGABLE: NO"
^DIC(9.4,70,22,2,"PAH",9,1,61,0)=" DESCRIPTION:   This is the main menu for RPC Broker.  "
^DIC(9.4,70,22,2,"PAH",9,1,62,0)="ITEM: XWB LISTENER STOP ALL             DISPLAY ORDER: 3"
^DIC(9.4,70,22,2,"PAH",9,1,63,0)="ITEM: XWB LISTENER EDIT                 DISPLAY ORDER: 1"
^DIC(9.4,70,22,2,"PAH",9,1,64,0)="ITEM: XWB LISTENER STARTER              DISPLAY ORDER: 2"
^DIC(9.4,70,22,2,"PAH",9,1,65,0)="  TIMESTAMP: 58079,48431"
^DIC(9.4,70,22,2,"PAH",9,1,66,0)="  UPPERCASE MENU TEXT: RPC BROKER MANAGEMENT MENU"
^DIC(9.4,70,22,2,"PAH",9,1,67,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,68,0)="NAME: XWB LISTENER EDIT                 MENU TEXT: RPC Listener Edit"
^DIC(9.4,70,22,2,"PAH",9,1,69,0)="  TYPE: edit                            CREATOR:"
^DIC(9.4,70,22,2,"PAH",9,1,70,0)="  PACKAGE: RPC BROKER                   DELEGABLE: NO"
^DIC(9.4,70,22,2,"PAH",9,1,71,0)=" DESCRIPTION:   This option allows for editing the RPC BROKER SITE"
^DIC(9.4,70,22,2,"PAH",9,1,72,0)="PARAMETERS file (#8994.1)."
^DIC(9.4,70,22,2,"PAH",9,1,73,0)="  DIC {DIC}: XWB(8994.1,                DIC(0): AEMQ"
^DIC(9.4,70,22,2,"PAH",9,1,74,0)="  DIE: XWB(8994.1,                      DR {DIE}: [XWB LISTENER EDIT]"
^DIC(9.4,70,22,2,"PAH",9,1,75,0)="  TIMESTAMP OF PRIMARY MENU: 58078,56469"
^DIC(9.4,70,22,2,"PAH",9,1,76,0)="  UPPERCASE MENU TEXT: RPC LISTENER EDIT"
^DIC(9.4,70,22,2,"PAH",9,1,77,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,78,0)="             <<<<<<THIS IS A SERVER SIDE ONLY PATCH>>>>>>"
^DIC(9.4,70,22,2,"PAH",9,1,79,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,80,0)="The updated Broker Systems Manual and the Broker Technical Manual may be"
^DIC(9.4,70,22,2,"PAH",9,1,81,0)="retrieved at the following CIO Field Offices' ANONYMOUS.SOFTWARE"
^DIC(9.4,70,22,2,"PAH",9,1,82,0)="directories:"
^DIC(9.4,70,22,2,"PAH",9,1,83,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,84,0)="        Hines           152.129.1.110  (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",9,1,85,0)="        Albany          152.127.1.5    (isc-albany.domain.ext)"
^DIC(9.4,70,22,2,"PAH",9,1,86,0)="        Salt Lake City  152.131.2.1    (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",9,1,87,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,88,0)="Use Binary mode for these .PDF files:"
^DIC(9.4,70,22,2,"PAH",9,1,89,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,90,0)="XWB1_1P9SM.PDF          Broker Systems Manual           See patch desc."
^DIC(9.4,70,22,2,"PAH",9,1,91,0)="XWB1_1P9TM.PDF          Broker Technical Manual         See patch desc."
^DIC(9.4,70,22,2,"PAH",9,1,92,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,93,0)="Routine Summary:"
^DIC(9.4,70,22,2,"PAH",9,1,94,0)="================"
^DIC(9.4,70,22,2,"PAH",9,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,96,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,70,22,2,"PAH",9,1,97,0)="of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",9,1,98,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",9,1,99,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,100,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",9,1,101,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",9,1,102,0)="XWBTCP        9081629  10677300    **1,9**"
^DIC(9.4,70,22,2,"PAH",9,1,103,0)="XWBTCPC       7635440   7568523    **2,5,4,6,9**"
^DIC(9.4,70,22,2,"PAH",9,1,104,0)="XWBTCPL       8850625   8934371    **1,7,9**"
^DIC(9.4,70,22,2,"PAH",9,1,105,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,106,0)="List of preceding patches: 6, 7"
^DIC(9.4,70,22,2,"PAH",9,1,107,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",9,1,108,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,109,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",9,1,110,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,111,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",9,1,112,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,113,0)="   1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",9,1,114,0)="       PCMM) during the installation.  No Broker-based client/server "
^DIC(9.4,70,22,2,"PAH",9,1,115,0)="       software should be running while installing this patch on the "
^DIC(9.4,70,22,2,"PAH",9,1,116,0)="       server.  To identify these jobs, check the system status and verify"
^DIC(9.4,70,22,2,"PAH",9,1,117,0)="       if any XWBTCPC routines are running (i.e., Broker Handler).  Once "
^DIC(9.4,70,22,2,"PAH",9,1,118,0)="       identified, notify users to logoff or forcex the jobs.  Active "
^DIC(9.4,70,22,2,"PAH",9,1,119,0)="       users may get NOSOURCE or CLOBBER errors.  "
^DIC(9.4,70,22,2,"PAH",9,1,120,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,121,0)="   2.  Stop the Broker Listener on the server.  Check the system status "
^DIC(9.4,70,22,2,"PAH",9,1,122,0)="       and verify if the XWBTCPL routine is running (i.e., Broker "
^DIC(9.4,70,22,2,"PAH",9,1,123,0)="       Listener).  If it is running stop it.  To stop the Listener, do the"
^DIC(9.4,70,22,2,"PAH",9,1,124,0)="       following: "
^DIC(9.4,70,22,2,"PAH",9,1,125,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,126,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",9,1,127,0)="           b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",9,1,128,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,129,0)="               >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",9,1,130,0)="               (Typically, the Listener port is 9200) "
^DIC(9.4,70,22,2,"PAH",9,1,131,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,132,0)="   3.  Broker routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",9,1,133,0)="       you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",9,1,134,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,135,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",9,1,136,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",9,1,137,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,138,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",9,1,139,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",9,1,140,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",9,1,141,0)="       options:"
^DIC(9.4,70,22,2,"PAH",9,1,142,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,143,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",9,1,144,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",9,1,145,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",9,1,146,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",9,1,147,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,148,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",9,1,149,0)="       option:"
^DIC(9.4,70,22,2,"PAH",9,1,150,0)="         Install Package(s)  'XWB*1.1*9'"
^DIC(9.4,70,22,2,"PAH",9,1,151,0)="                              ========="
^DIC(9.4,70,22,2,"PAH",9,1,152,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",9,1,153,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",9,1,154,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",9,1,155,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,156,0)="   7.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",9,1,157,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",9,1,158,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,159,0)="   8.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",9,1,160,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",9,1,161,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",9,1,162,0)=" "
^DIC(9.4,70,22,2,"PAH",9,1,163,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",9,1,164,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",10,0)="11 SEQ #10^3000125^1"
^DIC(9.4,70,22,2,"PAH",10,1,0)="^^100^100^3000125"
^DIC(9.4,70,22,2,"PAH",10,1,1,0)="** Y2K WAIVER - #Y2K0001 **"
^DIC(9.4,70,22,2,"PAH",10,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,3,0)="This patch updates the Broker's programmer client workstation software --"
^DIC(9.4,70,22,2,"PAH",10,1,4,0)="also known as the Broker Development Kit (BDK) -- adding support for"
^DIC(9.4,70,22,2,"PAH",10,1,5,0)="Delphi 5 development."
^DIC(9.4,70,22,2,"PAH",10,1,6,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,7,0)="IMPORTANT NOTES:"
^DIC(9.4,70,22,2,"PAH",10,1,8,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,9,0)="This patch consists of 2 parts:"
^DIC(9.4,70,22,2,"PAH",10,1,10,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,11,0)="1.  Packman message containing the XWB*1.1*11 KIDS build.  The packman"
^DIC(9.4,70,22,2,"PAH",10,1,12,0)="message simply updates the version multiple of the package."
^DIC(9.4,70,22,2,"PAH",10,1,13,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,14,0)="2.  Updated BDK (programmer client workstation software). All sites doing"
^DIC(9.4,70,22,2,"PAH",10,1,15,0)="Broker development are encouraged to retrieve the patched BDK.  This"
^DIC(9.4,70,22,2,"PAH",10,1,16,0)="version of the BDK supports Delphi 5, Delphi 4, and Delphi 3."
^DIC(9.4,70,22,2,"PAH",10,1,17,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,18,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE AT END-USER"
^DIC(9.4,70,22,2,"PAH",10,1,19,0)="CLIENT WORKSTATIONS.  If you are not using the BDK in any local or"
^DIC(9.4,70,22,2,"PAH",10,1,20,0)="national development, you do not need to retrieve the Broker's programmer"
^DIC(9.4,70,22,2,"PAH",10,1,21,0)="client workstation software. The software does not update the Broker"
^DIC(9.4,70,22,2,"PAH",10,1,22,0)="software that is running at end-user client workstations."
^DIC(9.4,70,22,2,"PAH",10,1,23,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,24,0)="The software distribution includes:"
^DIC(9.4,70,22,2,"PAH",10,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,26,0)="FILE NAMES       DESCRIPTION                       Bytes"
^DIC(9.4,70,22,2,"PAH",10,1,27,0)="XWB1_1P11PG.EXE  BDK Self-Installing Executable 2,200,099"
^DIC(9.4,70,22,2,"PAH",10,1,28,0)="XWB1_1P11IG.PDF  Installation Guide               185,092"
^DIC(9.4,70,22,2,"PAH",10,1,29,0)="XWB1_1RM.TXT     Readme text file                  13,915*"
^DIC(9.4,70,22,2,"PAH",10,1,30,0)="The size of this file will change in the future as additions are made."
^DIC(9.4,70,22,2,"PAH",10,1,31,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,32,0)="Note:  Use Binary mode for .PDF, and .EXE files"
^DIC(9.4,70,22,2,"PAH",10,1,33,0)="       Use ASCII mode for .TXT file."
^DIC(9.4,70,22,2,"PAH",10,1,34,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,35,0)="To obtain the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",10,1,36,0)="the following CIO Field Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,70,22,2,"PAH",10,1,37,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,38,0)="       CIO FIELD OFFICE                FTP Address "
^DIC(9.4,70,22,2,"PAH",10,1,39,0)="       Hines                           152.129.1.110 (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",10,1,40,0)="       Albany                          152.127.1.5 (isc-albany.domain.ext)"
^DIC(9.4,70,22,2,"PAH",10,1,41,0)="       Salt Lake City                  152.131.2.1 (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",10,1,42,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,43,0)="BROKER-DEPENDENT COMPONENTS:"
^DIC(9.4,70,22,2,"PAH",10,1,44,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,45,0)="The following comments apply only to those developing applications with"
^DIC(9.4,70,22,2,"PAH",10,1,46,0)="the BDK (programmer workstation software).  They are not relevant to"
^DIC(9.4,70,22,2,"PAH",10,1,47,0)="server operation."
^DIC(9.4,70,22,2,"PAH",10,1,48,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,49,0)="Warning:"
^DIC(9.4,70,22,2,"PAH",10,1,50,0)="Some components, such as the FileMan Delphi Components, reference the"
^DIC(9.4,70,22,2,"PAH",10,1,51,0)="TRPCBroker component.  If you use such components for development, be"
^DIC(9.4,70,22,2,"PAH",10,1,52,0)="aware that installing a new version of the TRPCBroker component (i.e. a"
^DIC(9.4,70,22,2,"PAH",10,1,53,0)="new BDK) may cause incompatibilities in Delphi, resulting in a compile"
^DIC(9.4,70,22,2,"PAH",10,1,54,0)="failure of the unit containing the Broker-dependent component and the"
^DIC(9.4,70,22,2,"PAH",10,1,55,0)="following compilation error:"
^DIC(9.4,70,22,2,"PAH",10,1,56,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,57,0)="       Unit <unit1> was compiled with a different version of <unit2>."
^DIC(9.4,70,22,2,"PAH",10,1,58,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,59,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",10,1,60,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",10,1,61,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,62,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",10,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,64,0)="b) You can obtain a new version of the component that is compatible."
^DIC(9.4,70,22,2,"PAH",10,1,65,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,66,0)="c) You have the source (.pas, .dfm, .dpk, etc.) files available so that"
^DIC(9.4,70,22,2,"PAH",10,1,67,0)="the component can be recompiled successfully."
^DIC(9.4,70,22,2,"PAH",10,1,68,0)="  "
^DIC(9.4,70,22,2,"PAH",10,1,69,0)="If you're using the FileMan Delphi Components (FMDC), please note that the"
^DIC(9.4,70,22,2,"PAH",10,1,70,0)="FMDC source code includes references to RPC Broker Development Kit (BDK)"
^DIC(9.4,70,22,2,"PAH",10,1,71,0)="code. When you install a new version of the BDK, you will need to"
^DIC(9.4,70,22,2,"PAH",10,1,72,0)="recompile the FMDC."
^DIC(9.4,70,22,2,"PAH",10,1,73,0)="      "
^DIC(9.4,70,22,2,"PAH",10,1,74,0)="As of patch FMDC*1.0*1, source code for FMDC is provided, allowing you"
^DIC(9.4,70,22,2,"PAH",10,1,75,0)="to recompile FMDC if necessary. For instructions on how to recompile FMDC,"
^DIC(9.4,70,22,2,"PAH",10,1,76,0)="please refer to FMDC*1.0*2."
^DIC(9.4,70,22,2,"PAH",10,1,77,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,78,0)="INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",10,1,79,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,80,0)="Server Side:"
^DIC(9.4,70,22,2,"PAH",10,1,81,0)="============"
^DIC(9.4,70,22,2,"PAH",10,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,83,0)="Use the following instructions in installing this server-side RPC Broker"
^DIC(9.4,70,22,2,"PAH",10,1,84,0)="patch.  Do NOT follow the M Server Installation Instructions in the RPC"
^DIC(9.4,70,22,2,"PAH",10,1,85,0)="Broker Installation Guide to install the server portion of this patch."
^DIC(9.4,70,22,2,"PAH",10,1,86,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,87,0)="1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",10,1,88,0)="option will load the KIDS (Kernel Installation and Distribution System)"
^DIC(9.4,70,22,2,"PAH",10,1,89,0)="package onto your system.  "
^DIC(9.4,70,22,2,"PAH",10,1,90,0)="    "
^DIC(9.4,70,22,2,"PAH",10,1,91,0)="2.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",10,1,92,0)="option:"
^DIC(9.4,70,22,2,"PAH",10,1,93,0)="        Install Package(s)  'XWB*1.1*11'"
^DIC(9.4,70,22,2,"PAH",10,1,94,0)="                            ============"
^DIC(9.4,70,22,2,"PAH",10,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,96,0)="Client Side:"
^DIC(9.4,70,22,2,"PAH",10,1,97,0)="============"
^DIC(9.4,70,22,2,"PAH",10,1,98,0)=" "
^DIC(9.4,70,22,2,"PAH",10,1,99,0)="Please follow the instructions in the most recent Broker 1.1 Installation"
^DIC(9.4,70,22,2,"PAH",10,1,100,0)="Guide."
^DIC(9.4,70,22,2,"PAH",11,0)="15 SEQ #11^3000417^1"
^DIC(9.4,70,22,2,"PAH",11,1,0)="^^84^84^3000417"
^DIC(9.4,70,22,2,"PAH",11,1,1,0)="ALL SITES SHOULD INSTALL THIS PATCH!"
^DIC(9.4,70,22,2,"PAH",11,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,3,0)="This patch should correct a problem on Cache sites with the Broker looping"
^DIC(9.4,70,22,2,"PAH",11,1,4,0)="with COMMAND errors.  This error is caused when the Broker tries to open"
^DIC(9.4,70,22,2,"PAH",11,1,5,0)="the TCP port and the port is already open by the broker."
^DIC(9.4,70,22,2,"PAH",11,1,6,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,7,0)="This patch resolves the following NOIS calls: "
^DIC(9.4,70,22,2,"PAH",11,1,8,0)="        SPO-0300-51693"
^DIC(9.4,70,22,2,"PAH",11,1,9,0)="        MUR-0300-32581"
^DIC(9.4,70,22,2,"PAH",11,1,10,0)="        WCO-0300-51724"
^DIC(9.4,70,22,2,"PAH",11,1,11,0)="        WRJ-1299-10856"
^DIC(9.4,70,22,2,"PAH",11,1,12,0)="        MPI-1299-60581"
^DIC(9.4,70,22,2,"PAH",11,1,13,0)="        FTL-0200-51217"
^DIC(9.4,70,22,2,"PAH",11,1,14,0)="        BOI-0300-50946"
^DIC(9.4,70,22,2,"PAH",11,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,16,0)="Routine Summary:"
^DIC(9.4,70,22,2,"PAH",11,1,17,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,18,0)="The following routine is included in this patch.  The second line of this"
^DIC(9.4,70,22,2,"PAH",11,1,19,0)="routine now looks like:"
^DIC(9.4,70,22,2,"PAH",11,1,20,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",11,1,21,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,22,0)="               Checksum"
^DIC(9.4,70,22,2,"PAH",11,1,23,0)=" Routine     Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",11,1,24,0)=" XWBTCPL   8934371   9128997    **1,7,9,15**"
^DIC(9.4,70,22,2,"PAH",11,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,26,0)=" List of preceding patches: 9"
^DIC(9.4,70,22,2,"PAH",11,1,27,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",11,1,28,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,29,0)="========================================================================= "
^DIC(9.4,70,22,2,"PAH",11,1,30,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,31,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",11,1,32,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,33,0)="   1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",11,1,34,0)="       PCMM) during the installation.  No Broker-based client/server "
^DIC(9.4,70,22,2,"PAH",11,1,35,0)="       software should be running while installing this patch on the "
^DIC(9.4,70,22,2,"PAH",11,1,36,0)="       server.  To identify these jobs, check the system status and verify"
^DIC(9.4,70,22,2,"PAH",11,1,37,0)="       if any XWBTCPC routines are running (i.e., Broker Handler).  Once "
^DIC(9.4,70,22,2,"PAH",11,1,38,0)="       identified, notify users to logoff or forcex the jobs.  Active "
^DIC(9.4,70,22,2,"PAH",11,1,39,0)="       users may get NOSOURCE or CLOBBER errors.  "
^DIC(9.4,70,22,2,"PAH",11,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,41,0)="   2.  Stop the Broker Listener on the server.  Check the system status "
^DIC(9.4,70,22,2,"PAH",11,1,42,0)="       and verify if the XWBTCPL routine is running (i.e., Broker "
^DIC(9.4,70,22,2,"PAH",11,1,43,0)="       Listener).  If it is running stop it.  To stop the Listener, do the"
^DIC(9.4,70,22,2,"PAH",11,1,44,0)="       following: "
^DIC(9.4,70,22,2,"PAH",11,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,46,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",11,1,47,0)="           b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",11,1,48,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,49,0)="               >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",11,1,50,0)="               (Typically, the Listener port is 9200) "
^DIC(9.4,70,22,2,"PAH",11,1,51,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,52,0)="   3.  Broker routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",11,1,53,0)="       you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",11,1,54,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,55,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",11,1,56,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",11,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,58,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",11,1,59,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",11,1,60,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",11,1,61,0)="       options:"
^DIC(9.4,70,22,2,"PAH",11,1,62,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,63,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",11,1,64,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",11,1,65,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",11,1,66,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",11,1,67,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,68,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",11,1,69,0)="       option:"
^DIC(9.4,70,22,2,"PAH",11,1,70,0)="         Install Package(s)  'XWB*1.1*15'"
^DIC(9.4,70,22,2,"PAH",11,1,71,0)="                              ========="
^DIC(9.4,70,22,2,"PAH",11,1,72,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",11,1,73,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",11,1,74,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",11,1,75,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,76,0)="   7.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",11,1,77,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",11,1,78,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,79,0)="   8.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",11,1,80,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",11,1,81,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",11,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",11,1,83,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",11,1,84,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",12,0)="10 SEQ #12^3000816^1"
^DIC(9.4,70,22,2,"PAH",12,1,0)="^^131^131^3000816"
^DIC(9.4,70,22,2,"PAH",12,1,1,0)="This patch gives greater information about and control of RPCs.  Specific"
^DIC(9.4,70,22,2,"PAH",12,1,2,0)="new abilities are:"
^DIC(9.4,70,22,2,"PAH",12,1,3,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,4,0)="1. Blocking an RPC either locally*, remotely*, or in both contexts by"
^DIC(9.4,70,22,2,"PAH",12,1,5,0)="setting a value in the INACTIVE field of the Remote Procedure file.  The"
^DIC(9.4,70,22,2,"PAH",12,1,6,0)="field can be set either by a package developer and exported by KIDS or by"
^DIC(9.4,70,22,2,"PAH",12,1,7,0)="a site manager using FileMan.  (Prior to this patch, values in this field"
^DIC(9.4,70,22,2,"PAH",12,1,8,0)="had no effect.)"
^DIC(9.4,70,22,2,"PAH",12,1,9,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,10,0)="2. Assuring that an RPC is at least a specified version when it is run"
^DIC(9.4,70,22,2,"PAH",12,1,11,0)="remotely* by setting a value in the new VERSION field of the Remote"
^DIC(9.4,70,22,2,"PAH",12,1,12,0)="Procedure file."
^DIC(9.4,70,22,2,"PAH",12,1,13,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,14,0)="3. Querying a server regarding the status of RPCs by using new Remote"
^DIC(9.4,70,22,2,"PAH",12,1,15,0)="Procedures: XWB IS RPC AVAILABLE and XWB ARE RPCS AVAILABLE."
^DIC(9.4,70,22,2,"PAH",12,1,16,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,17,0)="Please see the on-line descriptions of the INACTIVE and VERSION fields in"
^DIC(9.4,70,22,2,"PAH",12,1,18,0)="the Remote Procedure file and of the XWB IS RPC AVAILABLE and XWB ARE RPCS"
^DIC(9.4,70,22,2,"PAH",12,1,19,0)="AVAILABLE Remote Procedure file entries for details of the use of the new"
^DIC(9.4,70,22,2,"PAH",12,1,20,0)="functionality."
^DIC(9.4,70,22,2,"PAH",12,1,21,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,22,0)="In addition, this patch stops M errors from occurring when a client"
^DIC(9.4,70,22,2,"PAH",12,1,23,0)="application 1) attempts to create a context that does not exist on the"
^DIC(9.4,70,22,2,"PAH",12,1,24,0)="server or 2) attempts to run a remote procedure that does not exist on the"
^DIC(9.4,70,22,2,"PAH",12,1,25,0)="server.  With this patch in both these situations, the user is shown a"
^DIC(9.4,70,22,2,"PAH",12,1,26,0)="specific error message explaining the problem.  Several developers have"
^DIC(9.4,70,22,2,"PAH",12,1,27,0)="requested this fix, and the following NOIS calls are resolved:"
^DIC(9.4,70,22,2,"PAH",12,1,28,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,29,0)="ISP-0399-N2813     Broker Error When Client Calls Non-Existent RPC"
^DIC(9.4,70,22,2,"PAH",12,1,30,0)="MWV-1099-20408     Error encountered with XWBBRK"
^DIC(9.4,70,22,2,"PAH",12,1,31,0)="MWV-0499-21483     broker error since *169"
^DIC(9.4,70,22,2,"PAH",12,1,32,0)="SLC-1298-50740     NULL SUBSCRIPT ERROR"
^DIC(9.4,70,22,2,"PAH",12,1,33,0)="TOM-0798-41277     RPC ERRORS"
^DIC(9.4,70,22,2,"PAH",12,1,34,0)="DES-1296-40252     ERROR AT PRSA+18^XWBBRK"
^DIC(9.4,70,22,2,"PAH",12,1,35,0)="DAY-1196-42040     Error when PCMM not installed in the environment"
^DIC(9.4,70,22,2,"PAH",12,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,37,0)="--------"
^DIC(9.4,70,22,2,"PAH",12,1,38,0)="*'Locally' means an RPC is being run at the site which the user is logged"
^DIC(9.4,70,22,2,"PAH",12,1,39,0)="on to; 'remotely' means an RPC is being run at a site the user is not"
^DIC(9.4,70,22,2,"PAH",12,1,40,0)="directly logged on to."
^DIC(9.4,70,22,2,"PAH",12,1,41,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,42,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,43,0)="NOTES: "
^DIC(9.4,70,22,2,"PAH",12,1,44,0)="====="
^DIC(9.4,70,22,2,"PAH",12,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,46,0)="1. The packman message containing the XWB*1.1*10 KIDS build installs 3"
^DIC(9.4,70,22,2,"PAH",12,1,47,0)="modified XWB* routines, one modified and one new field in the Remote"
^DIC(9.4,70,22,2,"PAH",12,1,48,0)="Procedure file, and two new RPCs (entries in the Remote Procedure file).  "
^DIC(9.4,70,22,2,"PAH",12,1,49,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,50,0)="Routine Summary: "
^DIC(9.4,70,22,2,"PAH",12,1,51,0)="======= ========"
^DIC(9.4,70,22,2,"PAH",12,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,53,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,70,22,2,"PAH",12,1,54,0)="second line of each of these routines now looks like: "
^DIC(9.4,70,22,2,"PAH",12,1,55,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,56,0)="<tab>;;1.1;RPC BROKER;[patch list];date "
^DIC(9.4,70,22,2,"PAH",12,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,58,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,70,22,2,"PAH",12,1,59,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,60,0)="Routine Name      Before Patch     After Patch     Patch List "
^DIC(9.4,70,22,2,"PAH",12,1,61,0)="XWBBRK              4567623          5912545         2,4,10"
^DIC(9.4,70,22,2,"PAH",12,1,62,0)="XWBLIB              720789           3253016         6,10        "
^DIC(9.4,70,22,2,"PAH",12,1,63,0)="XWBSEC              2113752          2425405         3,6,10"
^DIC(9.4,70,22,2,"PAH",12,1,64,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,65,0)="Fields in Remote Procedure file (#8994):"
^DIC(9.4,70,22,2,"PAH",12,1,66,0)="====== == ====== ========= ==== "
^DIC(9.4,70,22,2,"PAH",12,1,67,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,68,0)="INACTIVE (#.06) is modified"
^DIC(9.4,70,22,2,"PAH",12,1,69,0)="VERSION  (#.09) is new"
^DIC(9.4,70,22,2,"PAH",12,1,70,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,71,0)="Remote Procedure:"
^DIC(9.4,70,22,2,"PAH",12,1,72,0)="====== ========="
^DIC(9.4,70,22,2,"PAH",12,1,73,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,74,0)="XWB IS RPC AVAILABLE is new"
^DIC(9.4,70,22,2,"PAH",12,1,75,0)="XWB ARE RPCS AVAILABLE is new"
^DIC(9.4,70,22,2,"PAH",12,1,76,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,77,0)="2. There is no client portion of this patch."
^DIC(9.4,70,22,2,"PAH",12,1,78,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,79,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,80,0)="INSTALLATION: "
^DIC(9.4,70,22,2,"PAH",12,1,81,0)="============"
^DIC(9.4,70,22,2,"PAH",12,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,83,0)="1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",12,1,84,0)="PCMM) during the installation.  No Broker-based client/server software"
^DIC(9.4,70,22,2,"PAH",12,1,85,0)="should be running while installing this patch on the server.  To identify"
^DIC(9.4,70,22,2,"PAH",12,1,86,0)="these jobs, check the system status and see if any XWBTCPC routine is"
^DIC(9.4,70,22,2,"PAH",12,1,87,0)="running (i.e., Broker Handler).  Once identified, notify users to logoff"
^DIC(9.4,70,22,2,"PAH",12,1,88,0)="or forcex the jobs.  Active users may get NOSOURCE or CLOBBER errors.  "
^DIC(9.4,70,22,2,"PAH",12,1,89,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,90,0)=" 2.  Stop the Broker Listener(s) on the server.  Check the system status"
^DIC(9.4,70,22,2,"PAH",12,1,91,0)="and see if the XWBTCPL routine is running (i.e., Broker Listener).  If it"
^DIC(9.4,70,22,2,"PAH",12,1,92,0)="is running stop it.  There are several ways to stop the Listeners -- see"
^DIC(9.4,70,22,2,"PAH",12,1,93,0)="the current version of the RPC Broker System Manual for details."
^DIC(9.4,70,22,2,"PAH",12,1,94,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,95,0)=" 3.  These routines are not usually mapped on systems that support"
^DIC(9.4,70,22,2,"PAH",12,1,96,0)="mapping; so, you will probably not have to disable mapping.  "
^DIC(9.4,70,22,2,"PAH",12,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,98,0)=" 4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",12,1,99,0)="option will load the KIDS (Kernel Installation and Distribution System)"
^DIC(9.4,70,22,2,"PAH",12,1,100,0)="package onto your system.  "
^DIC(9.4,70,22,2,"PAH",12,1,101,0)="    "
^DIC(9.4,70,22,2,"PAH",12,1,102,0)=" 5.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,70,22,2,"PAH",12,1,103,0)=" On the KIDS menu, select the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",12,1,104,0)="options: "
^DIC(9.4,70,22,2,"PAH",12,1,105,0)="         Verify Checksum's in Transport Global "
^DIC(9.4,70,22,2,"PAH",12,1,106,0)="         Print Transport Global "
^DIC(9.4,70,22,2,"PAH",12,1,107,0)="         Compare Transport Global to Current System "
^DIC(9.4,70,22,2,"PAH",12,1,108,0)="         Backup a Transport Global "
^DIC(9.4,70,22,2,"PAH",12,1,109,0)="    "
^DIC(9.4,70,22,2,"PAH",12,1,110,0)=" 6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",12,1,111,0)="option: "
^DIC(9.4,70,22,2,"PAH",12,1,112,0)="        Install Package(s)  'XWB*1.1*10' "
^DIC(9.4,70,22,2,"PAH",12,1,113,0)="                             =========="
^DIC(9.4,70,22,2,"PAH",12,1,114,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,115,0)=" 7.  When asked, answer these questions NO:"
^DIC(9.4,70,22,2,"PAH",12,1,116,0)="  "
^DIC(9.4,70,22,2,"PAH",12,1,117,0)="   Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",12,1,118,0)="                                                         =="
^DIC(9.4,70,22,2,"PAH",12,1,119,0)="   Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,70,22,2,"PAH",12,1,120,0)="     YES// NO"
^DIC(9.4,70,22,2,"PAH",12,1,121,0)="           =="
^DIC(9.4,70,22,2,"PAH",12,1,122,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,123,0)=" 8.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",12,1,124,0)="other CPUs?'. Enter the names of your Compute and Print server(s).  "
^DIC(9.4,70,22,2,"PAH",12,1,125,0)="     AXP Sites - Answer NO to this question.  "
^DIC(9.4,70,22,2,"PAH",12,1,126,0)="    "
^DIC(9.4,70,22,2,"PAH",12,1,127,0)=" 9.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",12,1,128,0)="should be rebuilt once the installation has run to completion.  "
^DIC(9.4,70,22,2,"PAH",12,1,129,0)=" "
^DIC(9.4,70,22,2,"PAH",12,1,130,0)=" 10. Restart the Broker Listener on the Server: see the current RPC Broker"
^DIC(9.4,70,22,2,"PAH",12,1,131,0)="System Manual for details."
^DIC(9.4,70,22,2,"PAH",13,0)="12 SEQ #13^3000816^1"
^DIC(9.4,70,22,2,"PAH",13,1,0)="^^98^98^3000816"
^DIC(9.4,70,22,2,"PAH",13,1,1,0)="This patch is in support of the CPRS Remote Data Views project. The"
^DIC(9.4,70,22,2,"PAH",13,1,2,0)="RPC Broker is used to facilitate invocation of Remote Procedure calls on a"
^DIC(9.4,70,22,2,"PAH",13,1,3,0)="remote server.  The RPC Broker uses Vista HL7 as the vehicle to pass RPC"
^DIC(9.4,70,22,2,"PAH",13,1,4,0)="name and parameters from a local server to a remote server.  On the return"
^DIC(9.4,70,22,2,"PAH",13,1,5,0)="path, Vista HL7 is also used to send results from the remote server back"
^DIC(9.4,70,22,2,"PAH",13,1,6,0)="to the local server."
^DIC(9.4,70,22,2,"PAH",13,1,7,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,8,0)="The following is the list of required patches: "
^DIC(9.4,70,22,2,"PAH",13,1,9,0)="HL*1.6*54      "
^DIC(9.4,70,22,2,"PAH",13,1,10,0)="HL*1.6*57      "
^DIC(9.4,70,22,2,"PAH",13,1,11,0)="HL*1.6*58      "
^DIC(9.4,70,22,2,"PAH",13,1,12,0)="XU*8.0*131 "
^DIC(9.4,70,22,2,"PAH",13,1,13,0)="XU*8.0*165     "
^DIC(9.4,70,22,2,"PAH",13,1,14,0)="XWB*1.1*10"
^DIC(9.4,70,22,2,"PAH",13,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,16,0)="To facilitate the running of  server to server  RPCs, new RPCs are sent"
^DIC(9.4,70,22,2,"PAH",13,1,17,0)="out in this patch.  The documentation on how to use these RPCs can be"
^DIC(9.4,70,22,2,"PAH",13,1,18,0)="found on Forum's DBA menu. Please reference the following Integration"
^DIC(9.4,70,22,2,"PAH",13,1,19,0)="Agreements:"
^DIC(9.4,70,22,2,"PAH",13,1,20,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,21,0)=" #3032 Direct RPCs - controlled subscription"
^DIC(9.4,70,22,2,"PAH",13,1,22,0)=" #3031 Remote RPCs - controlled subscription"
^DIC(9.4,70,22,2,"PAH",13,1,23,0)=" #3033 Deferred RPCs - supported"
^DIC(9.4,70,22,2,"PAH",13,1,24,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,25,0)="New Remote Procedure entries: "
^DIC(9.4,70,22,2,"PAH",13,1,26,0)=" 1. XWB REMOTE RPC "
^DIC(9.4,70,22,2,"PAH",13,1,27,0)=" 2. XWB REMOTE STATUS CHECK "
^DIC(9.4,70,22,2,"PAH",13,1,28,0)=" 3. XWB REMOTE GETDATA "
^DIC(9.4,70,22,2,"PAH",13,1,29,0)=" 4. XWB REMOTE CLEAR"
^DIC(9.4,70,22,2,"PAH",13,1,30,0)=" 5. XWB DEFERRED CLEAR"
^DIC(9.4,70,22,2,"PAH",13,1,31,0)=" 6. XWB DEFERRED CLEARALL"
^DIC(9.4,70,22,2,"PAH",13,1,32,0)=" 7. XWB DEFERRED RPC "
^DIC(9.4,70,22,2,"PAH",13,1,33,0)=" 8. XWB DEFERRED GETDATA "
^DIC(9.4,70,22,2,"PAH",13,1,34,0)=" 9. XWB DEFERRED STATUS "
^DIC(9.4,70,22,2,"PAH",13,1,35,0)=" 10. XWB DIRECT RPC "
^DIC(9.4,70,22,2,"PAH",13,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,37,0)="New Protocol entries: "
^DIC(9.4,70,22,2,"PAH",13,1,38,0)=" 1. XWB RPC EVENT "
^DIC(9.4,70,22,2,"PAH",13,1,39,0)=" 2. XWB RPC SUBSCRIBER "
^DIC(9.4,70,22,2,"PAH",13,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,41,0)="New HL7 Application Parameter entries: "
^DIC(9.4,70,22,2,"PAH",13,1,42,0)=" 1. XWB RECEIVER "
^DIC(9.4,70,22,2,"PAH",13,1,43,0)=" 2. XWB SENDER "
^DIC(9.4,70,22,2,"PAH",13,1,44,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,45,0)="This 'Server to Server RPC' functionality is currently limited to sites"
^DIC(9.4,70,22,2,"PAH",13,1,46,0)="that have implemented CIRN.  CIRN makes it possible for an application to"
^DIC(9.4,70,22,2,"PAH",13,1,47,0)="know a patient's current list of treating facilities. Furthermore, CIRN"
^DIC(9.4,70,22,2,"PAH",13,1,48,0)="has assumed responsibility for supervising the proper configuration and"
^DIC(9.4,70,22,2,"PAH",13,1,49,0)="activation of the VA network nodes that will be used for HL7 message"
^DIC(9.4,70,22,2,"PAH",13,1,50,0)="exchange."
^DIC(9.4,70,22,2,"PAH",13,1,51,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,52,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",13,1,53,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,70,22,2,"PAH",13,1,54,0)="of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",13,1,55,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",13,1,56,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,57,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",13,1,58,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",13,1,59,0)="XWB2HL7                 9722375    **12**"
^DIC(9.4,70,22,2,"PAH",13,1,60,0)="XWB2HL7A                6313853    **12**"
^DIC(9.4,70,22,2,"PAH",13,1,61,0)="XWB2HL7B                9424236    **12**"
^DIC(9.4,70,22,2,"PAH",13,1,62,0)="XWBDRPC                 4972286    **12**"
^DIC(9.4,70,22,2,"PAH",13,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,64,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",13,1,65,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,66,0)="========================================================================= "
^DIC(9.4,70,22,2,"PAH",13,1,67,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",13,1,68,0)=" "
^DIC(9.4,70,22,2,"PAH",13,1,69,0)=">>>Users may remain on the system."
^DIC(9.4,70,22,2,"PAH",13,1,70,0)="   This patch brings in new functionality."
^DIC(9.4,70,22,2,"PAH",13,1,71,0)="   No existing package is affected by the installation"
^DIC(9.4,70,22,2,"PAH",13,1,72,0)="     "
^DIC(9.4,70,22,2,"PAH",13,1,73,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",13,1,74,0)="      option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",13,1,75,0)="     "
^DIC(9.4,70,22,2,"PAH",13,1,76,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",13,1,77,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",13,1,78,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",13,1,79,0)="      options:"
^DIC(9.4,70,22,2,"PAH",13,1,80,0)="      "
^DIC(9.4,70,22,2,"PAH",13,1,81,0)="         Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",13,1,82,0)="         Print Transport Global"
^DIC(9.4,70,22,2,"PAH",13,1,83,0)="         Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",13,1,84,0)="         Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",13,1,85,0)="     "
^DIC(9.4,70,22,2,"PAH",13,1,86,0)="  3.  Users can remain on the system."
^DIC(9.4,70,22,2,"PAH",13,1,87,0)="      This patch can be queued and installed at any time."
^DIC(9.4,70,22,2,"PAH",13,1,88,0)="     "
^DIC(9.4,70,22,2,"PAH",13,1,89,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",13,1,90,0)="      option:"
^DIC(9.4,70,22,2,"PAH",13,1,91,0)="        Install Package(s)  'XWB*1.1*12'"
^DIC(9.4,70,22,2,"PAH",13,1,92,0)="                             =========="
^DIC(9.4,70,22,2,"PAH",13,1,93,0)="                             "
^DIC(9.4,70,22,2,"PAH",13,1,94,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",13,1,95,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",13,1,96,0)="                                                                        =="
^DIC(9.4,70,22,2,"PAH",13,1,97,0)="     "
^DIC(9.4,70,22,2,"PAH",13,1,98,0)=" ========================================================================="
^DIC(9.4,70,22,2,"PAH",14,0)="18 SEQ #14^3001027^1"
^DIC(9.4,70,22,2,"PAH",14,1,0)="^^77^77^3001027"
^DIC(9.4,70,22,2,"PAH",14,1,1,0)="LOM-0800-62301  XWB2HL7  If there are problems associated with the remote  "
^DIC(9.4,70,22,2,"PAH",14,1,2,0)="PRO-0800-12778           site's HL7 definitions -- specifically the receiving "
^DIC(9.4,70,22,2,"PAH",14,1,3,0)="                         application. "
^DIC(9.4,70,22,2,"PAH",14,1,4,0)="                         Then the RPC XWB REMOTE STATUS CHECK will get a "
^DIC(9.4,70,22,2,"PAH",14,1,5,0)="                         UNDEF error on the variable Z. This has been fixed."
^DIC(9.4,70,22,2,"PAH",14,1,6,0)="                         "
^DIC(9.4,70,22,2,"PAH",14,1,7,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,8,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",14,1,9,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,70,22,2,"PAH",14,1,10,0)="of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",14,1,11,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",14,1,12,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,13,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",14,1,14,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",14,1,15,0)="XWB2HL7       9722375   9756388    **12,18**"
^DIC(9.4,70,22,2,"PAH",14,1,16,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,17,0)="List of preceding patches: 12"
^DIC(9.4,70,22,2,"PAH",14,1,18,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",14,1,19,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,20,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",14,1,21,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",14,1,22,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,23,0)="   1.  Do not run any RPC-Broker-based Client/Server software (e.g., CPRS,"
^DIC(9.4,70,22,2,"PAH",14,1,24,0)="       PCMM) during the installation.  No Broker-based client/server "
^DIC(9.4,70,22,2,"PAH",14,1,25,0)="       software should be running while installing this patch on the "
^DIC(9.4,70,22,2,"PAH",14,1,26,0)="       server.  To identify these jobs, check the system status and verify"
^DIC(9.4,70,22,2,"PAH",14,1,27,0)="       if any XWBTCPC routines are running (i.e., Broker Handler).  Once "
^DIC(9.4,70,22,2,"PAH",14,1,28,0)="       identified, notify users to logoff or forcex the jobs.  Active "
^DIC(9.4,70,22,2,"PAH",14,1,29,0)="       users may get NOSOURCE or CLOBBER errors.  "
^DIC(9.4,70,22,2,"PAH",14,1,30,0)=" "
^DIC(9.4,70,22,2,"PAH",14,1,31,0)="   2.  Stop the Broker Listener on the server.  Check the system status "
^DIC(9.4,70,22,2,"PAH",14,1,32,0)="       and verify if the XWBTCPL routine is running (i.e., Broker "
^DIC(9.4,70,22,2,"PAH",14,1,33,0)="       Listener).  If it is running stop it.  To stop the Listener, do the"
^DIC(9.4,70,22,2,"PAH",14,1,34,0)="       following: "
^DIC(9.4,70,22,2,"PAH",14,1,35,0)=" "
^DIC(9.4,70,22,2,"PAH",14,1,36,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",14,1,37,0)="           b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",14,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",14,1,39,0)="               >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",14,1,40,0)="               (Typically, the Listener port is 9200) "
^DIC(9.4,70,22,2,"PAH",14,1,41,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,42,0)="   3.  Broker routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",14,1,43,0)="       you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",14,1,44,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,45,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",14,1,46,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",14,1,47,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,48,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",14,1,49,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",14,1,50,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",14,1,51,0)="       options:"
^DIC(9.4,70,22,2,"PAH",14,1,52,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,53,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",14,1,54,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",14,1,55,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",14,1,56,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",14,1,57,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,58,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",14,1,59,0)="       option:"
^DIC(9.4,70,22,2,"PAH",14,1,60,0)="         Install Package(s)  'XWB*1.1*18'"
^DIC(9.4,70,22,2,"PAH",14,1,61,0)="                              =========="
^DIC(9.4,70,22,2,"PAH",14,1,62,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",14,1,63,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",14,1,64,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",14,1,65,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,66,0)="   7.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",14,1,67,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",14,1,68,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,69,0)="   8.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",14,1,70,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",14,1,71,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",14,1,72,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,73,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",14,1,74,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",14,1,75,0)=""
^DIC(9.4,70,22,2,"PAH",14,1,76,0)="============================================================================"
^DIC(9.4,70,22,2,"PAH",14,1,77,0)=""
^DIC(9.4,70,22,2,"PAH",15,0)="14 SEQ #15^3001027^1"
^DIC(9.4,70,22,2,"PAH",15,1,0)="^^156^156^3001027"
^DIC(9.4,70,22,2,"PAH",15,1,1,0)="This patch updates the Broker's programmer client workstation software --"
^DIC(9.4,70,22,2,"PAH",15,1,2,0)="also known as the Broker Development Kit (BDK).  It adds no new"
^DIC(9.4,70,22,2,"PAH",15,1,3,0)="functionality."
^DIC(9.4,70,22,2,"PAH",15,1,4,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,5,0)="This patch:"
^DIC(9.4,70,22,2,"PAH",15,1,6,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,7,0)="- releases the source code for the BDK"
^DIC(9.4,70,22,2,"PAH",15,1,8,0)="- splits the VistaBroker package into separate design- and run-time"
^DIC(9.4,70,22,2,"PAH",15,1,9,0)="packages."
^DIC(9.4,70,22,2,"PAH",15,1,10,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,11,0)="The release of the source code does not affect how a developer uses the"
^DIC(9.4,70,22,2,"PAH",15,1,12,0)="Broker Component or other parts of the BDK.  Modified BDK source code"
^DIC(9.4,70,22,2,"PAH",15,1,13,0)="should NOT be used to create VistA GUI applications.  Suggestions for"
^DIC(9.4,70,22,2,"PAH",15,1,14,0)="changes to the BDK should be done via NOIS (for bugs ) or E3R (for"
^DIC(9.4,70,22,2,"PAH",15,1,15,0)="enhancements) for review and possible inclusion in another patch."
^DIC(9.4,70,22,2,"PAH",15,1,16,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,17,0)="The BDK now has separate run-time and design-time packages.  There is no"
^DIC(9.4,70,22,2,"PAH",15,1,18,0)="longer a VistaBroker package.  The new packages are XWB_Dxx and XWB_Rxx,"
^DIC(9.4,70,22,2,"PAH",15,1,19,0)="where D means Design-time and R means Run-time and where xx is two digits"
^DIC(9.4,70,22,2,"PAH",15,1,20,0)="indicating the version of Delphi with which it should be used (e.g.,"
^DIC(9.4,70,22,2,"PAH",15,1,21,0)="XWB_D50 is the design-time package for Delphi 5.0).  Splitting the BDK"
^DIC(9.4,70,22,2,"PAH",15,1,22,0)="into separate packages resolves certain compatibility problems that arose"
^DIC(9.4,70,22,2,"PAH",15,1,23,0)="from having a single run- and design-time package.  It also eliminates a"
^DIC(9.4,70,22,2,"PAH",15,1,24,0)="certain problem with Delphi 5.0's dsgnintf unit that prevented users of"
^DIC(9.4,70,22,2,"PAH",15,1,25,0)="the Standard edition of Delphi 5.0 from using the Broker."
^DIC(9.4,70,22,2,"PAH",15,1,26,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,27,0)="The run-time package should not be used to create executables that depend"
^DIC(9.4,70,22,2,"PAH",15,1,28,0)="on a separate XWB_Rxx.bpl installed on client workstations.  There is no"
^DIC(9.4,70,22,2,"PAH",15,1,29,0)="procedure in place at this time to reliably install the correct version of"
^DIC(9.4,70,22,2,"PAH",15,1,30,0)="the run-time bpl on client workstations.  Do NOT compile your project so"
^DIC(9.4,70,22,2,"PAH",15,1,31,0)="that it relies on dynamic linking with the BDK's run-time package; that"
^DIC(9.4,70,22,2,"PAH",15,1,32,0)="is, do NOT check the 'Build with runtime packages' box on the Packages tab"
^DIC(9.4,70,22,2,"PAH",15,1,33,0)="of the Project Options dialog.    "
^DIC(9.4,70,22,2,"PAH",15,1,34,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,35,0)="This patch addresses issues raised in the following NOISs:"
^DIC(9.4,70,22,2,"PAH",15,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,37,0)="POR-0200-51902     Can't install CPRSDTTM package in Delphi 4"
^DIC(9.4,70,22,2,"PAH",15,1,38,0)="POR-0200-50554     When is the source code being distributed ?"
^DIC(9.4,70,22,2,"PAH",15,1,39,0)="POR-0400-51704     RPC Broker Source Code"
^DIC(9.4,70,22,2,"PAH",15,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,41,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,42,0)="IMPORTANT NOTES:"
^DIC(9.4,70,22,2,"PAH",15,1,43,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,44,0)="This patch consists of 2 parts:"
^DIC(9.4,70,22,2,"PAH",15,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,46,0)="1.  Packman message containing the XWB*1.1*14 KIDS build.  The packman"
^DIC(9.4,70,22,2,"PAH",15,1,47,0)="message simply updates the version multiple of the package."
^DIC(9.4,70,22,2,"PAH",15,1,48,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,49,0)="2.  Updated BDK (programmer client workstation software). This version of"
^DIC(9.4,70,22,2,"PAH",15,1,50,0)="the BDK supports Delphi 5, Delphi 4, and Delphi 3.  "
^DIC(9.4,70,22,2,"PAH",15,1,51,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,52,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE ON END-USER"
^DIC(9.4,70,22,2,"PAH",15,1,53,0)="CLIENT WORKSTATIONS.  If you are not using the BDK in any local or"
^DIC(9.4,70,22,2,"PAH",15,1,54,0)="national development, you do not need to retrieve the Broker's programmer"
^DIC(9.4,70,22,2,"PAH",15,1,55,0)="client workstation software. The software does not update the Broker"
^DIC(9.4,70,22,2,"PAH",15,1,56,0)="software that is running at end-user client workstations. Further, since"
^DIC(9.4,70,22,2,"PAH",15,1,57,0)="no new functionality is added to the BDK by this patch, you do not have to"
^DIC(9.4,70,22,2,"PAH",15,1,58,0)="retrieve and install it on programmer workstations unless you either want"
^DIC(9.4,70,22,2,"PAH",15,1,59,0)="to see the BDK source code or need to use separate run- and design-time"
^DIC(9.4,70,22,2,"PAH",15,1,60,0)="packages."
^DIC(9.4,70,22,2,"PAH",15,1,61,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,62,0)="The software distribution includes:"
^DIC(9.4,70,22,2,"PAH",15,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,64,0)="FILE NAMES       DESCRIPTION                         Bytes "
^DIC(9.4,70,22,2,"PAH",15,1,65,0)="XWB1_1P14PG.EXE  BDK Self-Installing Executable      2,905,311"
^DIC(9.4,70,22,2,"PAH",15,1,66,0)="XWB1_1P14IG.PDF  Installation Guide                    171,945"
^DIC(9.4,70,22,2,"PAH",15,1,67,0)="XWB1_1RM.TXT     Readme text file                       15,686*"
^DIC(9.4,70,22,2,"PAH",15,1,68,0)="*The size of this file will change in the future as additions are made."
^DIC(9.4,70,22,2,"PAH",15,1,69,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,70,0)="Note:  Use Binary mode for .PDF, and .EXE files.  "
^DIC(9.4,70,22,2,"PAH",15,1,71,0)="       Use ASCII mode for .TXT file."
^DIC(9.4,70,22,2,"PAH",15,1,72,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,73,0)="To obtain the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",15,1,74,0)="the following CIO Field Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,70,22,2,"PAH",15,1,75,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,76,0)="       CIO FIELD OFFICE                FTP Address         "
^DIC(9.4,70,22,2,"PAH",15,1,77,0)="Hines                           152.129.1.110 (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",15,1,78,0)="Albany                          152.127.1.5 (isc-albany.domain.ext)        "
^DIC(9.4,70,22,2,"PAH",15,1,79,0)="Salt Lake City                  152.131.2.1 (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",15,1,80,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,81,0)="PACKAGE DEPENDENCIES:"
^DIC(9.4,70,22,2,"PAH",15,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,83,0)="A Package may have been defined to require the Broker package.  Patch"
^DIC(9.4,70,22,2,"PAH",15,1,84,0)="XWB*1.1*14 changes the identity of the Broker design-time package. If you"
^DIC(9.4,70,22,2,"PAH",15,1,85,0)="try to install a package into the Delphi IDE that requires the Broker, you"
^DIC(9.4,70,22,2,"PAH",15,1,86,0)="may receive an error message like:"
^DIC(9.4,70,22,2,"PAH",15,1,87,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,88,0)="      Can't load package <Package1>."
^DIC(9.4,70,22,2,"PAH",15,1,89,0)="      One of the library files needed to run this package cannot be found."
^DIC(9.4,70,22,2,"PAH",15,1,90,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,91,0)="To resolve this problem, Open the dpk file associated with that package;"
^DIC(9.4,70,22,2,"PAH",15,1,92,0)="delete the reference to the old version of the Broker in the Requires"
^DIC(9.4,70,22,2,"PAH",15,1,93,0)="section; add a reference to the new design-time Broker package (XWB_Dxx)"
^DIC(9.4,70,22,2,"PAH",15,1,94,0)="into the Requires section; recompile and install the package."
^DIC(9.4,70,22,2,"PAH",15,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,96,0)="BROKER-DEPENDENT COMPONENTS:"
^DIC(9.4,70,22,2,"PAH",15,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,98,0)="Warning: Some components, such as the FileMan Delphi Components, reference"
^DIC(9.4,70,22,2,"PAH",15,1,99,0)="the TRPCBroker component.  If you use such components for development, be"
^DIC(9.4,70,22,2,"PAH",15,1,100,0)="aware that installing a new version of the TRPCBroker component (i.e. a"
^DIC(9.4,70,22,2,"PAH",15,1,101,0)="new BDK) may cause incompatibilities in Delphi, resulting in a compile"
^DIC(9.4,70,22,2,"PAH",15,1,102,0)="failure of the unit containing the Broker-dependent component and the"
^DIC(9.4,70,22,2,"PAH",15,1,103,0)="following compilation error:"
^DIC(9.4,70,22,2,"PAH",15,1,104,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,105,0)="       Unit <unit1> was compiled with a different version of <unit2>."
^DIC(9.4,70,22,2,"PAH",15,1,106,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,107,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",15,1,108,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",15,1,109,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,110,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",15,1,111,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,112,0)="b) You can obtain a new version of the component that is compatible."
^DIC(9.4,70,22,2,"PAH",15,1,113,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,114,0)="c) You have the source (.pas, .dfm, .dpk, etc.) files available so that"
^DIC(9.4,70,22,2,"PAH",15,1,115,0)="the component can be recompiled successfully.    If you're using the"
^DIC(9.4,70,22,2,"PAH",15,1,116,0)="FileMan Delphi Components (FMDC), please note that the FMDC source code"
^DIC(9.4,70,22,2,"PAH",15,1,117,0)="includes references to RPC Broker Development Kit (BDK) code. When you"
^DIC(9.4,70,22,2,"PAH",15,1,118,0)="install a new version of the BDK, you will need to recompile the FMDC."
^DIC(9.4,70,22,2,"PAH",15,1,119,0)="   As of patch FMDC*1.0*1, source code for FMDC is provided, allowing you"
^DIC(9.4,70,22,2,"PAH",15,1,120,0)="to recompile FMDC if necessary. For instructions on how to recompile FMDC,"
^DIC(9.4,70,22,2,"PAH",15,1,121,0)="please refer to FMDC*1.0*2."
^DIC(9.4,70,22,2,"PAH",15,1,122,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,123,0)="INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",15,1,124,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,125,0)="Server Side: "
^DIC(9.4,70,22,2,"PAH",15,1,126,0)="============"
^DIC(9.4,70,22,2,"PAH",15,1,127,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,128,0)="Use the following instructions in installing this server-side RPC Broker"
^DIC(9.4,70,22,2,"PAH",15,1,129,0)="patch.  Do NOT follow the M Server Installation Instructions in the RPC"
^DIC(9.4,70,22,2,"PAH",15,1,130,0)="Broker Installation Guide to install the server portion of this patch."
^DIC(9.4,70,22,2,"PAH",15,1,131,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,132,0)="No routines or other package components are added or modified on the"
^DIC(9.4,70,22,2,"PAH",15,1,133,0)="server by this patch."
^DIC(9.4,70,22,2,"PAH",15,1,134,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,135,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option"
^DIC(9.4,70,22,2,"PAH",15,1,136,0)="will load the KIDS (Kernel Installation and Distribution System) package"
^DIC(9.4,70,22,2,"PAH",15,1,137,0)="onto your system.        "
^DIC(9.4,70,22,2,"PAH",15,1,138,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,139,0)="2. On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",15,1,140,0)="option:"
^DIC(9.4,70,22,2,"PAH",15,1,141,0)="Install Package(s)  'XWB*1.1*14'"
^DIC(9.4,70,22,2,"PAH",15,1,142,0)="                     =========="
^DIC(9.4,70,22,2,"PAH",15,1,143,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,144,0)="Answer the install questions like this:"
^DIC(9.4,70,22,2,"PAH",15,1,145,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,146,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",15,1,147,0)="                                                      =="
^DIC(9.4,70,22,2,"PAH",15,1,148,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,70,22,2,"PAH",15,1,149,0)="                                                                      =="
^DIC(9.4,70,22,2,"PAH",15,1,150,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,151,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,152,0)="Client Side: "
^DIC(9.4,70,22,2,"PAH",15,1,153,0)="============"
^DIC(9.4,70,22,2,"PAH",15,1,154,0)=" "
^DIC(9.4,70,22,2,"PAH",15,1,155,0)="Please follow the instructions in the most recent Broker 1.1 Installation"
^DIC(9.4,70,22,2,"PAH",15,1,156,0)="Guide. "
^DIC(9.4,70,22,2,"PAH",16,0)="20 SEQ #16^3010515^1"
^DIC(9.4,70,22,2,"PAH",16,1,0)="^^92^92^3010515"
^DIC(9.4,70,22,2,"PAH",16,1,1,0)="NOIS Calls: LAS-1000-62717"
^DIC(9.4,70,22,2,"PAH",16,1,2,0)="            BOI-1000-52970"
^DIC(9.4,70,22,2,"PAH",16,1,3,0)="            LOM-1200-62234"
^DIC(9.4,70,22,2,"PAH",16,1,4,0)="            ANN-1200-41924"
^DIC(9.4,70,22,2,"PAH",16,1,5,0)="            WRJ-1100-11904"
^DIC(9.4,70,22,2,"PAH",16,1,6,0)="            BEC-1100-20841"
^DIC(9.4,70,22,2,"PAH",16,1,7,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,8,0)="ROUTINE: XWB2HL7 "
^DIC(9.4,70,22,2,"PAH",16,1,9,0)="During the early testing of RDV (Remote Data View), the DUZ value was hard set "
^DIC(9.4,70,22,2,"PAH",16,1,10,0)="to .5 just before the call to the RPC. This was done because the code to set"
^DIC(9.4,70,22,2,"PAH",16,1,11,0)="up the user at the remote site wasn't ready. When the code was fixed to "
^DIC(9.4,70,22,2,"PAH",16,1,12,0)="properly set the DUZ, the old code was never removed.  This has been fixed "
^DIC(9.4,70,22,2,"PAH",16,1,13,0)="in the routine XWB2HL7.  If data was left in the ^XUTL(""XQ"",$J,""IO"")node it "
^DIC(9.4,70,22,2,"PAH",16,1,14,0)="could cause problems when HOME^%ZIS is called by some RPC's, so this ^XUTL "
^DIC(9.4,70,22,2,"PAH",16,1,15,0)="node is killed off before the RPC is called."
^DIC(9.4,70,22,2,"PAH",16,1,16,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,17,0)="In a E-mail message from CPRS developers: The global that may be used to "
^DIC(9.4,70,22,2,"PAH",16,1,18,0)="pass data back to the RPC was not killed before its use.  This was fixed in "
^DIC(9.4,70,22,2,"PAH",16,1,19,0)="the routine XWBDRPC."
^DIC(9.4,70,22,2,"PAH",16,1,20,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,21,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",16,1,22,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,70,22,2,"PAH",16,1,23,0)="of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",16,1,24,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",16,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,26,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",16,1,27,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",16,1,28,0)="XWB2HL7       9756388   9762168    **12,18,20**"
^DIC(9.4,70,22,2,"PAH",16,1,29,0)="XWBDRPC       4972286   5069845    **12,20**"
^DIC(9.4,70,22,2,"PAH",16,1,30,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,31,0)="List of preceding patches: 12, 18"
^DIC(9.4,70,22,2,"PAH",16,1,32,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",16,1,33,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,34,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",16,1,35,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",16,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,37,0)="   1.  Do not run any RPC-Broker-based Remote Data View software "
^DIC(9.4,70,22,2,"PAH",16,1,38,0)="       (e.g., CPRS, PCMM) during the installation.  Do not allow any "
^DIC(9.4,70,22,2,"PAH",16,1,39,0)="       incoming HL7 RDV messages. To identify these jobs, check the "
^DIC(9.4,70,22,2,"PAH",16,1,40,0)="       system status and verify if any XWBTCPC routines are running "
^DIC(9.4,70,22,2,"PAH",16,1,41,0)="       (i.e., Broker Handler).  Once identified, notify users to logoff "
^DIC(9.4,70,22,2,"PAH",16,1,42,0)="       or forcex the jobs.  Active users may get NOSOURCE or CLOBBER "
^DIC(9.4,70,22,2,"PAH",16,1,43,0)="       error messages .  "
^DIC(9.4,70,22,2,"PAH",16,1,44,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,45,0)="   2.  Stop the Broker Listener on the server.  Check the system status "
^DIC(9.4,70,22,2,"PAH",16,1,46,0)="       and verify if the XWBTCPL routine is running (i.e., Broker "
^DIC(9.4,70,22,2,"PAH",16,1,47,0)="       Listener).  If it is running stop it.  To stop the Listener, do the"
^DIC(9.4,70,22,2,"PAH",16,1,48,0)="       following: "
^DIC(9.4,70,22,2,"PAH",16,1,49,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,50,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",16,1,51,0)="           b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",16,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,53,0)="               >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",16,1,54,0)="               (Typically, the Listener port is 9200) "
^DIC(9.4,70,22,2,"PAH",16,1,55,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,56,0)="   3.  Broker routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",16,1,57,0)="       you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",16,1,58,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,59,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",16,1,60,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",16,1,61,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,62,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",16,1,63,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",16,1,64,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",16,1,65,0)="       options:"
^DIC(9.4,70,22,2,"PAH",16,1,66,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,67,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",16,1,68,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",16,1,69,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",16,1,70,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",16,1,71,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,72,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",16,1,73,0)="       option:"
^DIC(9.4,70,22,2,"PAH",16,1,74,0)="         Install Package(s)  'XWB*1.1*20'"
^DIC(9.4,70,22,2,"PAH",16,1,75,0)="                              =========="
^DIC(9.4,70,22,2,"PAH",16,1,76,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",16,1,77,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",16,1,78,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",16,1,79,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,80,0)="   7.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",16,1,81,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",16,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,83,0)="   8.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",16,1,84,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",16,1,85,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",16,1,86,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,87,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",16,1,88,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",16,1,89,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,90,0)="============================================================================"
^DIC(9.4,70,22,2,"PAH",16,1,91,0)=" "
^DIC(9.4,70,22,2,"PAH",16,1,92,0)=" "
^DIC(9.4,70,22,2,"PAH",17,0)="22 SEQ #17^3011016^1"
^DIC(9.4,70,22,2,"PAH",17,1,0)="^^94^94^3011016"
^DIC(9.4,70,22,2,"PAH",17,1,1,0)="NOIS: BRX-0401-12377, ISA-0401-12369"
^DIC(9.4,70,22,2,"PAH",17,1,2,0)="The calling site had a New Person File entry with a phone number containing a "
^DIC(9.4,70,22,2,"PAH",17,1,3,0)="trailing backslash (\).  As part of Remote Data Views (RDV) this data was then "
^DIC(9.4,70,22,2,"PAH",17,1,4,0)="encoded and sent to the remote site."
^DIC(9.4,70,22,2,"PAH",17,1,5,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,6,0)="At the remote site, a bug caused the backslash (\) to be appended to the "
^DIC(9.4,70,22,2,"PAH",17,1,7,0)="end of several other strings, which then caused the reported error.  This was "
^DIC(9.4,70,22,2,"PAH",17,1,8,0)="fixed by correcting the decoding routine."
^DIC(9.4,70,22,2,"PAH",17,1,9,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,10,0)="Because the error occurred before RDV was setup to handle an error, it caused"
^DIC(9.4,70,22,2,"PAH",17,1,11,0)="the calling site to keep sending the same message repeatedly.  This has been "
^DIC(9.4,70,22,2,"PAH",17,1,12,0)="fixed by setting an error trap at the beginning of RDV.  "
^DIC(9.4,70,22,2,"PAH",17,1,13,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,14,0)="If the application does not set some data into the return variable,"
^DIC(9.4,70,22,2,"PAH",17,1,15,0)="XWB2HL7 will return a string starting with ""-1^""."
^DIC(9.4,70,22,2,"PAH",17,1,16,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,17,0)="The XWB EXAMPLE option, RPC's and routine (XWBEXMPL) are included to"
^DIC(9.4,70,22,2,"PAH",17,1,18,0)="add an entry point for testing that will record the symbol table in the error"
^DIC(9.4,70,22,2,"PAH",17,1,19,0)="trap."
^DIC(9.4,70,22,2,"PAH",17,1,20,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,21,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",17,1,22,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,70,22,2,"PAH",17,1,23,0)="of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",17,1,24,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",17,1,25,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,26,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",17,1,27,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",17,1,28,0)="XWB2HL7       9762168  10783627    **12,18,20,22**"
^DIC(9.4,70,22,2,"PAH",17,1,29,0)="XWB2HL7B      9424236   9524542    **12,22**"
^DIC(9.4,70,22,2,"PAH",17,1,30,0)="XWBEXMPL      1244483   1441211    **22**"
^DIC(9.4,70,22,2,"PAH",17,1,31,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,32,0)="List of preceding patches: 20"
^DIC(9.4,70,22,2,"PAH",17,1,33,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",17,1,34,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",17,1,35,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",17,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,37,0)="   1.  Do not run any RPC-Broker-based Remote Data View software "
^DIC(9.4,70,22,2,"PAH",17,1,38,0)="       (e.g., CPRS, PCMM) during the installation.  Do not allow any "
^DIC(9.4,70,22,2,"PAH",17,1,39,0)="       incoming HL7 RDV messages. To identify these jobs, check the "
^DIC(9.4,70,22,2,"PAH",17,1,40,0)="       system status and verify if any XWBTCPC routines are running "
^DIC(9.4,70,22,2,"PAH",17,1,41,0)="       (i.e., Broker Handler).  Once identified, notify users to logoff "
^DIC(9.4,70,22,2,"PAH",17,1,42,0)="       or forcex the jobs.  Active users may get NOSOURCE or CLOBBER "
^DIC(9.4,70,22,2,"PAH",17,1,43,0)="       error messages .  "
^DIC(9.4,70,22,2,"PAH",17,1,44,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,45,0)="   2.  Stop the Broker Listener on the server.  Check the system status "
^DIC(9.4,70,22,2,"PAH",17,1,46,0)="       and verify if the XWBTCPL routine is running (i.e., Broker "
^DIC(9.4,70,22,2,"PAH",17,1,47,0)="       Listener).  If it is running stop it.  To stop the Listener, do the"
^DIC(9.4,70,22,2,"PAH",17,1,48,0)="       following: "
^DIC(9.4,70,22,2,"PAH",17,1,49,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,50,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",17,1,51,0)="           b.  Enter the following at the M prompt: "
^DIC(9.4,70,22,2,"PAH",17,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,53,0)="               >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",17,1,54,0)="               (Typically, the Listener port is 9200) "
^DIC(9.4,70,22,2,"PAH",17,1,55,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,56,0)="   3.  Broker routines are not usually mapped on systems that allow it, so"
^DIC(9.4,70,22,2,"PAH",17,1,57,0)="       you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",17,1,58,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,59,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",17,1,60,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",17,1,61,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,62,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",17,1,63,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",17,1,64,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",17,1,65,0)="       options:"
^DIC(9.4,70,22,2,"PAH",17,1,66,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,67,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",17,1,68,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",17,1,69,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",17,1,70,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",17,1,71,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,72,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",17,1,73,0)="       option:"
^DIC(9.4,70,22,2,"PAH",17,1,74,0)="         Install Package(s)  'XWB*1.1*22'"
^DIC(9.4,70,22,2,"PAH",17,1,75,0)="                              =========="
^DIC(9.4,70,22,2,"PAH",17,1,76,0)="                              "
^DIC(9.4,70,22,2,"PAH",17,1,77,0)="       Want KIDS to INHIBIT LOGONs during the install? YES//"
^DIC(9.4,70,22,2,"PAH",17,1,78,0)="       "
^DIC(9.4,70,22,2,"PAH",17,1,79,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",17,1,80,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",17,1,81,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",17,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,83,0)="   7.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",17,1,84,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",17,1,85,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,86,0)="   8.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",17,1,87,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",17,1,88,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",17,1,89,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,90,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",17,1,91,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",17,1,92,0)=" "
^DIC(9.4,70,22,2,"PAH",17,1,93,0)="============================================================================"
^DIC(9.4,70,22,2,"PAH",17,1,94,0)=" "
^DIC(9.4,70,22,2,"PAH",18,0)="24 SEQ #18^3011121^1"
^DIC(9.4,70,22,2,"PAH",18,1,0)="^^379^379^3011121"
^DIC(9.4,70,22,2,"PAH",18,1,1,0)="This patch supports only Delphi V. 4 and Delphi V. 5.  Although Delphi V."
^DIC(9.4,70,22,2,"PAH",18,1,2,0)="3 is no longer supported, the code written for Delphi V. 3 is correct and"
^DIC(9.4,70,22,2,"PAH",18,1,3,0)="this patch does not affect that code."
^DIC(9.4,70,22,2,"PAH",18,1,4,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,5,0)="Due to version-dependent code, a problem was recently encountered that is"
^DIC(9.4,70,22,2,"PAH",18,1,6,0)="associated with reading the Window's registry in programs compiled with"
^DIC(9.4,70,22,2,"PAH",18,1,7,0)="Delphi V. 5.  Because a conditional test was specifically looking for"
^DIC(9.4,70,22,2,"PAH",18,1,8,0)="Delphi V. 4-based applications, Delphi V. 5-based applications ended up"
^DIC(9.4,70,22,2,"PAH",18,1,9,0)="using Broker code for Delphi V. 3.  This can result in users having"
^DIC(9.4,70,22,2,"PAH",18,1,10,0)="limited privileges, preventing their ability to read data from the"
^DIC(9.4,70,22,2,"PAH",18,1,11,0)="registry.  This has been observed when a user with limited NT privileges"
^DIC(9.4,70,22,2,"PAH",18,1,12,0)="attempts to select a location for the RPC Broker connection, and it"
^DIC(9.4,70,22,2,"PAH",18,1,13,0)="results in the use of the default BrokerServer/9200.  However, users with"
^DIC(9.4,70,22,2,"PAH",18,1,14,0)="higher levels of NT access do not see this problem."
^DIC(9.4,70,22,2,"PAH",18,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,16,0)="The BDK now has separate run-time and design-time packages.  There is no"
^DIC(9.4,70,22,2,"PAH",18,1,17,0)="longer a VistaBroker package.  The new packages are XWB_Dxx and XWB_Rxx,"
^DIC(9.4,70,22,2,"PAH",18,1,18,0)="where ""D"" means Design-time, ""R"" means Run-time and ""xx"" represents two"
^DIC(9.4,70,22,2,"PAH",18,1,19,0)="digits indicating the version of Delphi with which it should be used"
^DIC(9.4,70,22,2,"PAH",18,1,20,0)="(e.g., XWB_D50 is the design-time package for Delphi V. 5.0)."
^DIC(9.4,70,22,2,"PAH",18,1,21,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,22,0)="The run-time package should not be used to create executables that depend"
^DIC(9.4,70,22,2,"PAH",18,1,23,0)="on a separate XWB_Rxx.bpl installed on client workstations.  There is no"
^DIC(9.4,70,22,2,"PAH",18,1,24,0)="procedure in place at this time to reliably install the correct version of"
^DIC(9.4,70,22,2,"PAH",18,1,25,0)="the run-time bpl on client workstations.  Do NOT compile your project so"
^DIC(9.4,70,22,2,"PAH",18,1,26,0)="that it relies on dynamic linking with the BDK's run-time package; that"
^DIC(9.4,70,22,2,"PAH",18,1,27,0)="is, do NOT check the ""Build with runtime packages"" box on the Packages tab"
^DIC(9.4,70,22,2,"PAH",18,1,28,0)="of the Project Options dialog."
^DIC(9.4,70,22,2,"PAH",18,1,29,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,30,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,31,0)="This patch addresses issues raised in the following NOISs:"
^DIC(9.4,70,22,2,"PAH",18,1,32,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,33,0)="MAC-0601-62549  Broker host list from CPRS"
^DIC(9.4,70,22,2,"PAH",18,1,34,0)="MIW-0601-41984  Host not found error"
^DIC(9.4,70,22,2,"PAH",18,1,35,0)="MOU-0601-32241  CPRS GUI and serverlist.exe file"
^DIC(9.4,70,22,2,"PAH",18,1,36,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,37,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,38,0)="IMPORTANT NOTES:"
^DIC(9.4,70,22,2,"PAH",18,1,39,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,40,0)="This patch consists of two parts:"
^DIC(9.4,70,22,2,"PAH",18,1,41,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,42,0)="1.  Packman message containing the XWB*1.1*24 KIDS build.  The packman"
^DIC(9.4,70,22,2,"PAH",18,1,43,0)="message simply updates the version multiple of the package."
^DIC(9.4,70,22,2,"PAH",18,1,44,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,45,0)="2.  Updated BDK (programmer client workstation software). This version of"
^DIC(9.4,70,22,2,"PAH",18,1,46,0)="the BDK supports Delphi V. 5 and Delphi V. 4.  DELPHI V. 3 IS NO LONGER"
^DIC(9.4,70,22,2,"PAH",18,1,47,0)="SUPPORTED."
^DIC(9.4,70,22,2,"PAH",18,1,48,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,49,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE ON END-USER"
^DIC(9.4,70,22,2,"PAH",18,1,50,0)="CLIENT WORKSTATIONS.  If you are not using the BDK in any local or"
^DIC(9.4,70,22,2,"PAH",18,1,51,0)="national development, you do not need to retrieve the Broker's programmer"
^DIC(9.4,70,22,2,"PAH",18,1,52,0)="client workstation software. The software does not update the Broker"
^DIC(9.4,70,22,2,"PAH",18,1,53,0)="software that is running on end-user client workstations. Further, no new"
^DIC(9.4,70,22,2,"PAH",18,1,54,0)="functionality is added to the BDK by this patch."
^DIC(9.4,70,22,2,"PAH",18,1,55,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,56,0)="The software distribution includes:"
^DIC(9.4,70,22,2,"PAH",18,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,58,0)="FILE NAMES       DESCRIPTION                            Bytes "
^DIC(9.4,70,22,2,"PAH",18,1,59,0)="XWB1_1P24PG.EXE  BDK Self-Installing Executable         2,117,952"
^DIC(9.4,70,22,2,"PAH",18,1,60,0)="XWB1_1P14IG.PDF  Installation Guide                     171,945"
^DIC(9.4,70,22,2,"PAH",18,1,61,0)="XWB1_1RM.TXT     Readme text file                       16,213*"
^DIC(9.4,70,22,2,"PAH",18,1,62,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,63,0)="*The size of this file will change in the future as additions are made."
^DIC(9.4,70,22,2,"PAH",18,1,64,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,65,0)="Note:  Use Binary mode for .PDF, and .EXE files."
^DIC(9.4,70,22,2,"PAH",18,1,66,0)="       Use ASCII mode for .TXT file."
^DIC(9.4,70,22,2,"PAH",18,1,67,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,68,0)="To obtain the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",18,1,69,0)="the following OI Field Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,70,22,2,"PAH",18,1,70,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,71,0)="       OI FIELD OFFICE             FTP Address         "
^DIC(9.4,70,22,2,"PAH",18,1,72,0)="Hines                        152.129.1.110 (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",18,1,73,0)="Albany                       152.127.1.5 (isc-albany.domain.ext)        "
^DIC(9.4,70,22,2,"PAH",18,1,74,0)="Salt Lake City               152.131.2.1 (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",18,1,75,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,76,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,77,0)="PACKAGE DEPENDENCIES:"
^DIC(9.4,70,22,2,"PAH",18,1,78,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,79,0)="A Package may have been defined to require the Broker package.  Patch"
^DIC(9.4,70,22,2,"PAH",18,1,80,0)="XWB*1.1*24 changes the identity of the Broker design-time package.  If you"
^DIC(9.4,70,22,2,"PAH",18,1,81,0)="try to install a package into the Delphi IDE that requires the Broker, you"
^DIC(9.4,70,22,2,"PAH",18,1,82,0)="may receive an error message like:"
^DIC(9.4,70,22,2,"PAH",18,1,83,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,84,0)="      Can't load package <Package1>."
^DIC(9.4,70,22,2,"PAH",18,1,85,0)="      One of the library files needed to run this package cannot"
^DIC(9.4,70,22,2,"PAH",18,1,86,0)="      be found."
^DIC(9.4,70,22,2,"PAH",18,1,87,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,88,0)="To resolve this problem:"
^DIC(9.4,70,22,2,"PAH",18,1,89,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,90,0)="1.  Open the dpk file associated with that package."
^DIC(9.4,70,22,2,"PAH",18,1,91,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,92,0)="2.  Delete the reference to the old version of the Broker in the Requires"
^DIC(9.4,70,22,2,"PAH",18,1,93,0)="section."
^DIC(9.4,70,22,2,"PAH",18,1,94,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,95,0)="3.  Add a reference to the new design-time Broker package (XWB_Dxx) into"
^DIC(9.4,70,22,2,"PAH",18,1,96,0)="the Requires section."
^DIC(9.4,70,22,2,"PAH",18,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,98,0)="4.  Recompile and install the package."
^DIC(9.4,70,22,2,"PAH",18,1,99,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,100,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,101,0)="BROKER-DEPENDENT COMPONENTS:"
^DIC(9.4,70,22,2,"PAH",18,1,102,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,103,0)="Warning: Some components, such as the FileMan Delphi Components (FMDC),"
^DIC(9.4,70,22,2,"PAH",18,1,104,0)="reference the TRPCBroker component.  If you use such components for"
^DIC(9.4,70,22,2,"PAH",18,1,105,0)="development, be aware that installing a new version of the TRPCBroker"
^DIC(9.4,70,22,2,"PAH",18,1,106,0)="component (i.e., a new BDK) may cause incompatibilities in Delphi,"
^DIC(9.4,70,22,2,"PAH",18,1,107,0)="resulting in a compile failure of the unit containing the Broker-dependent"
^DIC(9.4,70,22,2,"PAH",18,1,108,0)="component and the following compilation error:"
^DIC(9.4,70,22,2,"PAH",18,1,109,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,110,0)="       Unit <unit1> was compiled with a different version of "
^DIC(9.4,70,22,2,"PAH",18,1,111,0)="       <unit2>."
^DIC(9.4,70,22,2,"PAH",18,1,112,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,113,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",18,1,114,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",18,1,115,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,116,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",18,1,117,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,118,0)="b) You can obtain a new version of the component that is compatible."
^DIC(9.4,70,22,2,"PAH",18,1,119,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,120,0)="c) You have the source (.pas, .dfm, .dpk, etc.) files available so that"
^DIC(9.4,70,22,2,"PAH",18,1,121,0)="the component can be recompiled successfully.  If you're using the FileMan"
^DIC(9.4,70,22,2,"PAH",18,1,122,0)="Delphi Components (FMDC), please note that the FMDC source code includes"
^DIC(9.4,70,22,2,"PAH",18,1,123,0)="references to RPC Broker Development Kit (BDK) code. When you install a"
^DIC(9.4,70,22,2,"PAH",18,1,124,0)="new version of the BDK, you will need to recompile the FMDC."
^DIC(9.4,70,22,2,"PAH",18,1,125,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,126,0)="   As of patch FMDC*1.0*1, source code for FMDC is provided, allowing you"
^DIC(9.4,70,22,2,"PAH",18,1,127,0)="to recompile FMDC if necessary. For instructions on how to recompile FMDC,"
^DIC(9.4,70,22,2,"PAH",18,1,128,0)="please refer to FMDC*1.0*2."
^DIC(9.4,70,22,2,"PAH",18,1,129,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,130,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,131,0)="INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",18,1,132,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,133,0)="Server Side:"
^DIC(9.4,70,22,2,"PAH",18,1,134,0)="============"
^DIC(9.4,70,22,2,"PAH",18,1,135,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,136,0)="Use the following instructions in installing this server-side RPC Broker"
^DIC(9.4,70,22,2,"PAH",18,1,137,0)="patch.  Do NOT follow the M Server Installation Instructions in the RPC"
^DIC(9.4,70,22,2,"PAH",18,1,138,0)="Broker Installation Guide to install the server portion of this patch."
^DIC(9.4,70,22,2,"PAH",18,1,139,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,140,0)="No routines or other package components are added or modified on the"
^DIC(9.4,70,22,2,"PAH",18,1,141,0)="server by this patch."
^DIC(9.4,70,22,2,"PAH",18,1,142,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,143,0)="1. Use the INSTALL/CHECK MESSAGE option on the PackMan menu. This option"
^DIC(9.4,70,22,2,"PAH",18,1,144,0)="will load the KIDS (Kernel Installation and Distribution System) package"
^DIC(9.4,70,22,2,"PAH",18,1,145,0)="onto your system."
^DIC(9.4,70,22,2,"PAH",18,1,146,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,147,0)="2. On the KIDS menu, under the Installation menu, use the following"
^DIC(9.4,70,22,2,"PAH",18,1,148,0)="option:"
^DIC(9.4,70,22,2,"PAH",18,1,149,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,150,0)="Install Package(s)  ""XWB*1.1*24"""
^DIC(9.4,70,22,2,"PAH",18,1,151,0)="                     =========="
^DIC(9.4,70,22,2,"PAH",18,1,152,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,153,0)="Answer the install questions like this:"
^DIC(9.4,70,22,2,"PAH",18,1,154,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,155,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",18,1,156,0)="                                                      =="
^DIC(9.4,70,22,2,"PAH",18,1,157,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,70,22,2,"PAH",18,1,158,0)="      =="
^DIC(9.4,70,22,2,"PAH",18,1,159,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,160,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,161,0)="Client Side:"
^DIC(9.4,70,22,2,"PAH",18,1,162,0)="============"
^DIC(9.4,70,22,2,"PAH",18,1,163,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,164,0)="Please follow the instructions in the most recent Broker 1.1 Installation"
^DIC(9.4,70,22,2,"PAH",18,1,165,0)="Guide."
^DIC(9.4,70,22,2,"PAH",18,1,166,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,167,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,168,0)="Client Routine Information:"
^DIC(9.4,70,22,2,"PAH",18,1,169,0)="=========================="
^DIC(9.4,70,22,2,"PAH",18,1,170,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,171,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,172,0)="The following information is based on the LOG file for a complete"
^DIC(9.4,70,22,2,"PAH",18,1,173,0)="installation (i.e., all options checked).  A line shows the directory"
^DIC(9.4,70,22,2,"PAH",18,1,174,0)="involved, based on the default installation directory.  Each file is shown"
^DIC(9.4,70,22,2,"PAH",18,1,175,0)="on a separate line, with data shown for:"
^DIC(9.4,70,22,2,"PAH",18,1,176,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,177,0)="filename                file       file     version     bytes    CRC32"
^DIC(9.4,70,22,2,"PAH",18,1,178,0)="                        date       time    if present"
^DIC(9.4,70,22,2,"PAH",18,1,179,0)="                        "
^DIC(9.4,70,22,2,"PAH",18,1,180,0)="file_date, file_time and bytes can be obtained from looking at NT or"
^DIC(9.4,70,22,2,"PAH",18,1,181,0)="Windows Explorer (or similar file management program) or from examining"
^DIC(9.4,70,22,2,"PAH",18,1,182,0)="Properties for the file."
^DIC(9.4,70,22,2,"PAH",18,1,183,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,184,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,185,0)="C:\Program Files\VISTA\BDK32\D5"
^DIC(9.4,70,22,2,"PAH",18,1,186,0)=" "
^DIC(9.4,70,22,2,"PAH",18,1,187,0)="frmSignonMessage.dcu | 04-06-2000 | 16:49:16 | | 3575 | 7ebbde9c"
^DIC(9.4,70,22,2,"PAH",18,1,188,0)="frmSignonMessage.dfm | 03-24-1999 | 16:30:38 | | 2503 | c99d9a3f"
^DIC(9.4,70,22,2,"PAH",18,1,189,0)="Hash.dcu | 04-06-2000 | 16:49:16 | | 3407 | 6e11e4db"
^DIC(9.4,70,22,2,"PAH",18,1,190,0)="Loginfrm.dcu | 04-06-2000 | 16:49:16 | | 10278 | e6ea9af7"
^DIC(9.4,70,22,2,"PAH",18,1,191,0)="Loginfrm.dfm | 03-30-2000 | 15:09:42 | | 10723 | 189eb9ab"
^DIC(9.4,70,22,2,"PAH",18,1,192,0)="Mfunstr.dcu | 04-06-2000 | 16:49:16 | | 1278 | 519212c6"
^DIC(9.4,70,22,2,"PAH",18,1,193,0)="Rpcbedtr.dcu | 07-26-2001 | 10:36:46 | | 5759 | d229eed1"
