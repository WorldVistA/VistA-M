^DIC(9.4,14,22,5.9,"PAH",278,1,769,0)="PKG: ORDER ENTRY/RESULTS REPOR  69         CLINIC MEDICATIONS"
^DIC(9.4,14,22,5.9,"PAH",278,1,770,0)="PKG: ORDER ENTRY/RESULTS REPOR  70         INPATIENT MEDICATIONS"
^DIC(9.4,14,22,5.9,"PAH",278,1,771,0)="PKG: ORDER ENTRY/RESULTS REPOR  74         ANATOMIC PATHOLOGY"
^DIC(9.4,14,22,5.9,"PAH",278,1,772,0)="PKG: ORDER ENTRY/RESULTS REPOR  75         LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",278,1,773,0)="PKG: ORDER ENTRY/RESULTS REPOR  80         IMAGING"
^DIC(9.4,14,22,5.9,"PAH",278,1,774,0)="PKG: ORDER ENTRY/RESULTS REPOR  90         CONSULTS"
^DIC(9.4,14,22,5.9,"PAH",278,1,775,0)="PKG: ORDER ENTRY/RESULTS REPOR  100        PROCEDURES"
^DIC(9.4,14,22,5.9,"PAH",278,1,776,0)="PKG: ORDER ENTRY/RESULTS REPOR  110        SURGERY"
^DIC(9.4,14,22,5.9,"PAH",278,1,777,0)="PKG: ORDER ENTRY/RESULTS REPOR  120        OTHER HOSPITAL SERVICES"
^DIC(9.4,14,22,5.9,"PAH",278,1,778,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,779,0)="Enter RETURN to continue or '^' to exit: "
^DIC(9.4,14,22,5.9,"PAH",278,1,780,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,781,0)="Parameter                       Instance   Value"
^DIC(9.4,14,22,5.9,"PAH",278,1,782,0)="-----------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,783,0)="PKG: ORDER ENTRY/RESULTS REPOR  130        SUPPLIES/DEVICES"
^DIC(9.4,14,22,5.9,"PAH",278,1,784,0)="PKG: ORDER ENTRY/RESULTS REPOR  135        CLINIC SCHEDULING"
^DIC(9.4,14,22,5.9,"PAH",278,1,785,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,786,0)="Enter RETURN to continue or '^' to exit: "
^DIC(9.4,14,22,5.9,"PAH",278,1,787,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,788,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,789,0)="   LV     List Values for a Selected Parameter"
^DIC(9.4,14,22,5.9,"PAH",278,1,790,0)="   LE     List Values for a Selected Entity"
^DIC(9.4,14,22,5.9,"PAH",278,1,791,0)="   LP     List Values for a Selected Package"
^DIC(9.4,14,22,5.9,"PAH",278,1,792,0)="   LT     List Values for a Selected Template"
^DIC(9.4,14,22,5.9,"PAH",278,1,793,0)="   EP     Edit Parameter Values"
^DIC(9.4,14,22,5.9,"PAH",278,1,794,0)="   ET     Edit Parameter Values with Template"
^DIC(9.4,14,22,5.9,"PAH",278,1,795,0)="   EK     Edit Parameter Definition Keyword"
^DIC(9.4,14,22,5.9,"PAH",278,1,796,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,797,0)="Select General Parameter Tools <TEST ACCOUNT> Option:"
^DIC(9.4,14,22,5.9,"PAH",278,1,798,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,799,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",278,1,800,0)="------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,801,0)="This installation will add the LR AP DIALOG CONFIG file (#69.73) and "
^DIC(9.4,14,22,5.9,"PAH",278,1,802,0)="configure it for the Order Dialogs and Specimens listed in the environment"
^DIC(9.4,14,22,5.9,"PAH",278,1,803,0)="check."
^DIC(9.4,14,22,5.9,"PAH",278,1,804,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,805,0)="1.  Choose the PackMan message containing this patch."
^DIC(9.4,14,22,5.9,"PAH",278,1,806,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,807,0)="2.  Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,14,22,5.9,"PAH",278,1,808,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,809,0)="3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,14,22,5.9,"PAH",278,1,810,0)="    the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,14,22,5.9,"PAH",278,1,811,0)="    following options. When prompted for the INSTALL NAME enter the patch "
^DIC(9.4,14,22,5.9,"PAH",278,1,812,0)="    LR*5.2*469:"
^DIC(9.4,14,22,5.9,"PAH",278,1,813,0)="    a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,14,22,5.9,"PAH",278,1,814,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,14,22,5.9,"PAH",278,1,815,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,14,22,5.9,"PAH",278,1,816,0)="    b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,14,22,5.9,"PAH",278,1,817,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,14,22,5.9,"PAH",278,1,818,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,14,22,5.9,"PAH",278,1,819,0)="        (routines, DDs, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",278,1,820,0)="    c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,14,22,5.9,"PAH",278,1,821,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,14,22,5.9,"PAH",278,1,822,0)="        transport global."
^DIC(9.4,14,22,5.9,"PAH",278,1,823,0)="     "
^DIC(9.4,14,22,5.9,"PAH",278,1,824,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,14,22,5.9,"PAH",278,1,825,0)="    choose the patch to install."
^DIC(9.4,14,22,5.9,"PAH",278,1,826,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,827,0)="5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",278,1,828,0)="    Install? NO//'     "
^DIC(9.4,14,22,5.9,"PAH",278,1,829,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",278,1,830,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,831,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,14,22,5.9,"PAH",278,1,832,0)="    NO//'"
^DIC(9.4,14,22,5.9,"PAH",278,1,833,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",278,1,834,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,835,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,14,22,5.9,"PAH",278,1,836,0)="    and Protocols? NO//' "
^DIC(9.4,14,22,5.9,"PAH",278,1,837,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",278,1,838,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,839,0)="8.  If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,14,22,5.9,"PAH",278,1,840,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,841,0)="Post-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",278,1,842,0)="---------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,843,0)="N/A"
