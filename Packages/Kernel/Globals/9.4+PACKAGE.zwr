^DIC(9.4,14,22,5.9,"PAH",152,1,213,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,214,0)="Resolving FM Verify Fields warnings instructions"
^DIC(9.4,14,22,5.9,"PAH",152,1,215,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,216,0)="The most common verify field errors are:"
^DIC(9.4,14,22,5.9,"PAH",152,1,217,0)="1. Fields not properly cross referenced. This can be resolved by "
^DIC(9.4,14,22,5.9,"PAH",152,1,218,0)="re-indexing the file."
^DIC(9.4,14,22,5.9,"PAH",152,1,219,0)="2. Fields failing input transform. This can be resolved by either editing "
^DIC(9.4,14,22,5.9,"PAH",152,1,220,0)="the field and entering appropriate data; or deleting the existing data in "
^DIC(9.4,14,22,5.9,"PAH",152,1,221,0)="the field."
^DIC(9.4,14,22,5.9,"PAH",152,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,223,0)="Note: When performing FM Verify fields, an error will be produced in the "
^DIC(9.4,14,22,5.9,"PAH",152,1,224,0)="TOPOGRAPHY FIELD((#61) file, SNOMED CODE (#2)field by the input transform "
^DIC(9.4,14,22,5.9,"PAH",152,1,225,0)="logic error."
^DIC(9.4,14,22,5.9,"PAH",152,1,226,0)="Example:"
^DIC(9.4,14,22,5.9,"PAH",152,1,227,0)="ENTRY#    NAME                          ERROR"
^DIC(9.4,14,22,5.9,"PAH",152,1,228,0)="1         RIGHT LUNG                    ""28100"" fails Input Transform"
^DIC(9.4,14,22,5.9,"PAH",152,1,229,0)=" ALREADY AN ENTRY"
^DIC(9.4,14,22,5.9,"PAH",152,1,230,0)="This input transform logic error will be corrected with the installation "
^DIC(9.4,14,22,5.9,"PAH",152,1,231,0)="of this patch."
^DIC(9.4,14,22,5.9,"PAH",152,1,232,0)="** NO PRE-INSTALL CORRECTIVE ACTION IS REQUIRED. **"
^DIC(9.4,14,22,5.9,"PAH",152,1,233,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,234,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,235,0)="When the Verify Field option is run on the various files, several "
^DIC(9.4,14,22,5.9,"PAH",152,1,236,0)="different kinds of warnings can be generated. It isn't possible to "
^DIC(9.4,14,22,5.9,"PAH",152,1,237,0)="describe a resolution method for the type of warning discovered using the "
^DIC(9.4,14,22,5.9,"PAH",152,1,238,0)="FM Verify field option, but here are some techniques used during testing. "
^DIC(9.4,14,22,5.9,"PAH",152,1,239,0)="If you require additional technical assistance, contact the EVS group."
^DIC(9.4,14,22,5.9,"PAH",152,1,240,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,241,0)="Known problems:"
^DIC(9.4,14,22,5.9,"PAH",152,1,242,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,243,0)="WKLD CODE (#64)"
^DIC(9.4,14,22,5.9,"PAH",152,1,244,0)="========================"
^DIC(9.4,14,22,5.9,"PAH",152,1,245,0)="--UNIT FOR COUNT--   POINTER"
^DIC(9.4,14,22,5.9,"PAH",152,1,246,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,247,0)="ENTRY#    PROCEDURE                     ERROR"
