^DIC(9.4,110,22,1,"PAH",4,1,0)="^^7^7^2990602"
^DIC(9.4,110,22,1,"PAH",4,1,1,0)="VHA Directive 98-058, ""Sexual Trauma Counseling Care and Services"""
^DIC(9.4,110,22,1,"PAH",4,1,2,0)="requires that VHA provide care and counseling to veterans determined to"
^DIC(9.4,110,22,1,"PAH",4,1,3,0)="have been a victim of sexual trauma while the veteran was serving on"
^DIC(9.4,110,22,1,"PAH",4,1,4,0)="active duty.  This patch will focus on the data collection for this"
^DIC(9.4,110,22,1,"PAH",4,1,5,0)="directive."
^DIC(9.4,110,22,1,"PAH",4,1,6,0)=" "
^DIC(9.4,110,22,1,"PAH",4,1,7,0)="This is the VSIT portion of the overall patch.  See DG*5.3*195"
