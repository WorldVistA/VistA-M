^DIC(9.4,14,22,5.9,"PAH",103,1,57,0)="       Hines                      152.129.1.110      ANONYMOUS.SOFTWARE"
^DIC(9.4,14,22,5.9,"PAH",103,1,58,0)="       Salt Lake City             152.131.2.1        ANONYMOUS.SOFTWARE"
^DIC(9.4,14,22,5.9,"PAH",103,1,59,0)=" "
^DIC(9.4,14,22,5.9,"PAH",103,1,60,0)="The NOIS calls addressed are:"
^DIC(9.4,14,22,5.9,"PAH",103,1,61,0)="        Refer to OR*3*97"
^DIC(9.4,14,22,5.9,"PAH",103,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",103,1,63,0)="  Requesting Site: Central Office, Washington, DC"
^DIC(9.4,14,22,5.9,"PAH",103,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",103,1,65,0)="  "
^DIC(9.4,14,22,5.9,"PAH",103,1,66,0)="     Test Site(s): "
^DIC(9.4,14,22,5.9,"PAH",103,1,67,0)="        Refer to OR*3*97"
^DIC(9.4,14,22,5.9,"PAH",103,1,68,0)=" "
^DIC(9.4,14,22,5.9,"PAH",103,1,69,0)="   Reference NOIS: "
^DIC(9.4,14,22,5.9,"PAH",103,1,70,0)="        Refer to OR*3*97"
^DIC(9.4,14,22,5.9,"PAH",103,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",103,1,72,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",103,1,73,0)=" ==============="
^DIC(9.4,14,22,5.9,"PAH",103,1,74,0)="  The following Laboratory package routines are distributed and installed"
^DIC(9.4,14,22,5.9,"PAH",103,1,75,0)="with CPRS patch OR*3*97."
^DIC(9.4,14,22,5.9,"PAH",103,1,76,0)=" "
