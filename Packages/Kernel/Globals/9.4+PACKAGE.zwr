^DIC(9.4,44,22,3,"PAH",102,1,150,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,151,0)="Additional Information:"
^DIC(9.4,44,22,3,"PAH",102,1,152,0)="NEW PARAMETER  This data is held in the Parameter Definition File "
^DIC(9.4,44,22,3,"PAH",102,1,153,0)="(#8989.51)"
^DIC(9.4,44,22,3,"PAH",102,1,154,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,155,0)="Parameter - GMRC IFC REGIONAL ROUTER "
^DIC(9.4,44,22,3,"PAH",102,1,156,0)="This Parameter contains the one Logical Link for the programmatically "
^DIC(9.4,44,22,3,"PAH",102,1,157,0)="determined VDIF Regional Router. The Links are ""GMRC IFC1"" - ""GMRC IFC4"""
^DIC(9.4,44,22,3,"PAH",102,1,158,0)="for production, and ""GMRC IFC0"" to be used for testing. This Parameter"
^DIC(9.4,44,22,3,"PAH",102,1,159,0)="points to the HL LOGICAL LINK File (#870). "
^DIC(9.4,44,22,3,"PAH",102,1,160,0)=" "
