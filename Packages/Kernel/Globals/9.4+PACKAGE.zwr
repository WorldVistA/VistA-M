^DIC(9.4,164,22,1,"PAH",220,1,0)="^^5^5^3210809"
^DIC(9.4,164,22,1,"PAH",220,1,1,0)="Backup of PSS*1.0*247 on Aug 09, 2021"
^DIC(9.4,164,22,1,"PAH",220,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",220,1,3,0)="Warning:  Installing this backup patch message will install older versions"
