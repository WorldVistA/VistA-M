^DIC(9.4,77,22,17,"PAH",220,1,46,0)="------------------           -------------------    --------------------"
^DIC(9.4,77,22,17,"PAH",220,1,47,0)="Non-Verified Orders (#53.1)  Schedule Type (#7)     Modified"
^DIC(9.4,77,22,17,"PAH",220,1,48,0)=" "
^DIC(9.4,77,22,17,"PAH",220,1,49,0)="Pharmacy Patient (#55)       Unit Dose (#62)(Multiple)"
^DIC(9.4,77,22,17,"PAH",220,1,50,0)="                              Intervention (#132)   Modified"
^DIC(9.4,77,22,17,"PAH",220,1,51,0)=" "
^DIC(9.4,77,22,17,"PAH",220,1,52,0)="Pharmacy Patient (#55)       IV (#100)(Multiple)"
^DIC(9.4,77,22,17,"PAH",220,1,53,0)="                              Intervention (#153)   Modified"
^DIC(9.4,77,22,17,"PAH",220,1,54,0)=" "
