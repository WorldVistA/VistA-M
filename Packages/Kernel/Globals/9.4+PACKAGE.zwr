^DIC(9.4,11,22,5.03,"PAH",45,1,149,0)=" Specifications Document "
^DIC(9.4,11,22,5.03,"PAH",45,1,150,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,151,0)="This website is usually updated within 1-3 days of the patch release date."
^DIC(9.4,11,22,5.03,"PAH",45,1,152,0)="The VDL web address for Laboratory Universal Interface user documentation"
^DIC(9.4,11,22,5.03,"PAH",45,1,153,0)="is: http://www.domain.ext/vdl/application.asp?appid=120"
^DIC(9.4,11,22,5.03,"PAH",45,1,154,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,155,0)="Installation Instructions"
^DIC(9.4,11,22,5.03,"PAH",45,1,156,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",45,1,157,0)="This patch, LA*5.2*88, is part of a combined build for Laboratory "
^DIC(9.4,11,22,5.03,"PAH",45,1,158,0)="Autoverification.  "
^DIC(9.4,11,22,5.03,"PAH",45,1,159,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,160,0)="Please refer to patch LR*5.2*458 for installation instructions."
^DIC(9.4,11,22,5.03,"PAH",45,1,161,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,162,0)="Routine Information:"
^DIC(9.4,11,22,5.03,"PAH",45,1,163,0)="===================="
^DIC(9.4,11,22,5.03,"PAH",45,1,164,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,165,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,166,0)="The second line of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",45,1,167,0)=";;5.2;AUTOMATED LAB INSTRUMENTS;**[Patch List]**;Sep 27, 1994;Build 10"
^DIC(9.4,11,22,5.03,"PAH",45,1,168,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,169,0)="The checksums below are new checksums, and"
^DIC(9.4,11,22,5.03,"PAH",45,1,170,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,11,22,5.03,"PAH",45,1,171,0)=" "
