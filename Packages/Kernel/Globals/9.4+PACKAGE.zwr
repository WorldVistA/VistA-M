^DIC(9.4,48,22,5.28,"PAH",169,1,1,0)="See National Patch Module (NPM)"
^DIC(9.4,48,22,5.28,"PAH",170,0)="189 SEQ #211^3010202^1"
^DIC(9.4,48,22,5.28,"PAH",170,1,0)="^^1^1^3010202"
^DIC(9.4,48,22,5.28,"PAH",170,1,1,0)="APPOINTMENT MANAGEMENT DISPLAY FULL CLINIC NAME"
^DIC(9.4,48,22,5.28,"PAH",171,0)="186 SEQ #212^3010227^1"
^DIC(9.4,48,22,5.28,"PAH",171,1,0)="^^20^20^3010227"
^DIC(9.4,48,22,5.28,"PAH",171,1,1,0)="1)  This patch addresses a problem with the SDCANCEL, 'Cancel Clinic"
^DIC(9.4,48,22,5.28,"PAH",171,1,2,0)="Availability' option.  The problem exists in the auto rebook section that"
^DIC(9.4,48,22,5.28,"PAH",171,1,3,0)="runs by answering (Yes) to the 'Want to auto-rebook appointments now?'"
^DIC(9.4,48,22,5.28,"PAH",171,1,4,0)="question.  If a patient has an additional appointment for the same day at"
^DIC(9.4,48,22,5.28,"PAH",171,1,5,0)="another clinic that is set at an earlier time, then only the appointment"
^DIC(9.4,48,22,5.28,"PAH",171,1,6,0)="with the cancelled clinic would display on the CANCELLED CLINIC"
^DIC(9.4,48,22,5.28,"PAH",171,1,7,0)="AUTO-REBOOK REPORT.  However, if the other appointment was set for a later"
^DIC(9.4,48,22,5.28,"PAH",171,1,8,0)="time on the same day, then the MULTIPLE APPNTS. ON CANCELLED DATE message"
^DIC(9.4,48,22,5.28,"PAH",171,1,9,0)="would appear on the report.  The logic has been changed to check for other"
^DIC(9.4,48,22,5.28,"PAH",171,1,10,0)="""NON-CANCELLED"" appointments that same day, both earlier and later and"
^DIC(9.4,48,22,5.28,"PAH",171,1,11,0)="across all clinics. This problem was identified in NOIS NWI-0400-42186."
^DIC(9.4,48,22,5.28,"PAH",171,1,12,0)=" "
^DIC(9.4,48,22,5.28,"PAH",171,1,13,0)="2)  The other problem occurred when making new appointments in SDM, 'Make"
^DIC(9.4,48,22,5.28,"PAH",171,1,14,0)="Appointment'.  When the option to display clinic availability was run and"
^DIC(9.4,48,22,5.28,"PAH",171,1,15,0)="a 'M' was entered at the 'DATE/TIME:' prompt to show additional days.  If"
^DIC(9.4,48,22,5.28,"PAH",171,1,16,0)="the end of one month were on the screen, the first day of the next month"
^DIC(9.4,48,22,5.28,"PAH",171,1,17,0)="would sometimes get skipped.  This would happen more for clinics that were"
^DIC(9.4,48,22,5.28,"PAH",171,1,18,0)="only open one or two days per week.  The logic has been changed to include"
^DIC(9.4,48,22,5.28,"PAH",171,1,19,0)="the missing day.  This problem was identified in NOIS BRX-0500-11068 and"
^DIC(9.4,48,22,5.28,"PAH",171,1,20,0)="BHH-0500-40921."
^DIC(9.4,48,22,5.28,"PAH",172,0)="223 SEQ #213^3010227^1"
^DIC(9.4,48,22,5.28,"PAH",172,1,0)="^^1^1^3010227"
^DIC(9.4,48,22,5.28,"PAH",172,1,1,0)="Clinic Wait Time revisions"
^DIC(9.4,48,22,5.28,"PAH",173,0)="235^3010228^1"
^DIC(9.4,48,22,5.28,"PAH",174,0)="237 SEQ #215^3010305^1"
^DIC(9.4,48,22,5.28,"PAH",174,1,0)="^^1^1^3010305"
^DIC(9.4,48,22,5.28,"PAH",174,1,1,0)="CWT fix"
^DIC(9.4,48,22,5.28,"PAH",175,0)="234 SEQ #216^3010405^1"
^DIC(9.4,48,22,5.28,"PAH",175,1,0)="^^2^2^3010405"
^DIC(9.4,48,22,5.28,"PAH",175,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,48,22,5.28,"PAH",175,1,2,0)="section of patch SD*5.3*234 in the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",176,0)="232 SEQ #217^3010507^1"
^DIC(9.4,48,22,5.28,"PAH",176,1,0)="^^14^14^3010507"
^DIC(9.4,48,22,5.28,"PAH",176,1,1,0)="This patch addresses ACRP Ad Hoc Report, [SCRPW AD HOC REPORT], issues as"
^DIC(9.4,48,22,5.28,"PAH",176,1,2,0)="follows:"
^DIC(9.4,48,22,5.28,"PAH",176,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",176,1,4,0)="1. NOIS call REN-0900-61733 reported a ""<PARAMETER>^SCRPW25"" error."
^DIC(9.4,48,22,5.28,"PAH",176,1,5,0)="   The absence of a ""QUIT"" statement at the end of the"
^DIC(9.4,48,22,5.28,"PAH",176,1,6,0)="   routine CPQ^SCRPW25 caused the error. Patch SD*5.3*232 resolves this"
^DIC(9.4,48,22,5.28,"PAH",176,1,7,0)="   issue."
^DIC(9.4,48,22,5.28,"PAH",176,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",176,1,9,0)="2. NOIS calls  MAD-0400-41755,HIN-0500-41434,SDC-0800-61974,and"
^DIC(9.4,48,22,5.28,"PAH",176,1,10,0)="   ELP-0800-72223 reported ""DISK FULL"", ""Report Looping"", reports"
^DIC(9.4,48,22,5.28,"PAH",176,1,11,0)="   ""stopped irregularly"", and inappropriate resource consumption"
^DIC(9.4,48,22,5.28,"PAH",176,1,12,0)="   problems when using the 'ACRP Ad Hoc Report' option.  These problems"
^DIC(9.4,48,22,5.28,"PAH",176,1,13,0)="   were the result of a variable not being ""New""ed or reset within"
^DIC(9.4,48,22,5.28,"PAH",176,1,14,0)="   routine IPRT^SCRPW28. Patch SD*5.3*232 resolves these issues."
^DIC(9.4,48,22,5.28,"PAH",177,0)="231 SEQ #218^3010529^1"
^DIC(9.4,48,22,5.28,"PAH",177,1,0)="^^2^2^3010529"
^DIC(9.4,48,22,5.28,"PAH",177,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,48,22,5.28,"PAH",177,1,2,0)="section of patch SD*5.3*231 in the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",178,0)="219 SEQ #219^3010608^1"
^DIC(9.4,48,22,5.28,"PAH",178,1,0)="^^3^3^3010608"
^DIC(9.4,48,22,5.28,"PAH",178,1,1,0)="This patch changes the add/edit encounter building and transmission logic"
^DIC(9.4,48,22,5.28,"PAH",178,1,2,0)="to include both primary and secondary stop code values (if defined for the"
^DIC(9.4,48,22,5.28,"PAH",178,1,3,0)="corresponding hospital location)."
^DIC(9.4,48,22,5.28,"PAH",179,0)="199 SEQ #220^3010625^1"
^DIC(9.4,48,22,5.28,"PAH",179,1,0)="^^1^1^3010625"
^DIC(9.4,48,22,5.28,"PAH",179,1,1,0)="Miscelaneous ACRP report issues"
^DIC(9.4,48,22,5.28,"PAH",180,0)="217 SEQ #221^3010710^1"
^DIC(9.4,48,22,5.28,"PAH",180,1,0)="^^4^4^3010710"
^DIC(9.4,48,22,5.28,"PAH",180,1,1,0)="Can't Edit Disposition Location."
^DIC(9.4,48,22,5.28,"PAH",180,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",180,1,3,0)="A description for this build can be found on the National Patch Module"
^DIC(9.4,48,22,5.28,"PAH",180,1,4,0)="under Patch SD*5.3*217."
^DIC(9.4,48,22,5.28,"PAH",181,0)="222 SEQ #222^3010906^1"
^DIC(9.4,48,22,5.28,"PAH",181,1,0)="^^9^9^3010906"
^DIC(9.4,48,22,5.28,"PAH",181,1,1,0)="ACRP ENCOUNTER ISSUES"
^DIC(9.4,48,22,5.28,"PAH",181,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",181,1,3,0)="1.  Properly display and update Encounter classifications for Service"
^DIC(9.4,48,22,5.28,"PAH",181,1,4,0)="    Connected 50 to 100% patients."
^DIC(9.4,48,22,5.28,"PAH",181,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",181,1,6,0)="2.  Substitute difficult to interpret messages on the Encounter 'Action"
^DIC(9.4,48,22,5.28,"PAH",181,1,7,0)="    Required' Report."
^DIC(9.4,48,22,5.28,"PAH",181,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",181,1,9,0)="3.  Corrected MST validation logic for codes 7040, 704, 706 and 903."
^DIC(9.4,48,22,5.28,"PAH",182,0)="241 SEQ #223^3010906^1"
^DIC(9.4,48,22,5.28,"PAH",182,1,0)="^^1^1^3010906"
^DIC(9.4,48,22,5.28,"PAH",182,1,1,0)="Clinic Wait Time issues"
^DIC(9.4,48,22,5.28,"PAH",183,0)="248 SEQ #224^3010926^1"
^DIC(9.4,48,22,5.28,"PAH",183,1,0)="^^4^4^3010926"
^DIC(9.4,48,22,5.28,"PAH",183,1,1,0)="FY 2002 Update workload closeout dates."
^DIC(9.4,48,22,5.28,"PAH",183,1,2,0)="This patch will add the 2002 dates to the existing table."
^DIC(9.4,48,22,5.28,"PAH",183,1,3,0)="The database closeout fields for FY 2000 and 2001 will also"
^DIC(9.4,48,22,5.28,"PAH",183,1,4,0)="be updated to allow the current plus 2 previous years."
^DIC(9.4,48,22,5.28,"PAH",184,0)="242 SEQ #225^3010926^1"
^DIC(9.4,48,22,5.28,"PAH",184,1,0)="^^1^1^3010926"
^DIC(9.4,48,22,5.28,"PAH",184,1,1,0)="N XQORS INSTEAD OF K TO PRESERVE ORIGINAL VALUE."
^DIC(9.4,48,22,5.28,"PAH",185,0)="252 SEQ #226^3011016^1"
^DIC(9.4,48,22,5.28,"PAH",185,1,0)="^^1^1^3011016"
^DIC(9.4,48,22,5.28,"PAH",185,1,1,0)="Retransmit ACRP for July 26-29, 2001."
^DIC(9.4,48,22,5.28,"PAH",186,0)="251 SEQ #227^3011016^1"
^DIC(9.4,48,22,5.28,"PAH",186,1,0)="^^1^1^3011016"
^DIC(9.4,48,22,5.28,"PAH",186,1,1,0)="See patch SD*5.3*231 in the NPM for complete information on this patch."
^DIC(9.4,48,22,5.28,"PAH",187,0)="244^3011210^1"
^DIC(9.4,48,22,5.28,"PAH",187,1,0)="^^3^3^3011210"
^DIC(9.4,48,22,5.28,"PAH",187,1,1,0)="The changes included in this patch are described in the description of"
^DIC(9.4,48,22,5.28,"PAH",187,1,2,0)="patch SD*5.3*244 (Mill Bill - LTC/Visit/Medication Co-Pay) in the National"
^DIC(9.4,48,22,5.28,"PAH",187,1,3,0)="Patch Module."
^DIC(9.4,48,22,5.28,"PAH",188,0)="249 SEQ #229^3011231^1"
^DIC(9.4,48,22,5.28,"PAH",188,1,0)="^^1^1^3011231"
^DIC(9.4,48,22,5.28,"PAH",188,1,1,0)="Clinic Wait time enhancements."
^DIC(9.4,48,22,5.28,"PAH",189,0)="239^3011231^1"
^DIC(9.4,48,22,5.28,"PAH",190,0)="255 SEQ #231^3011231^1"
^DIC(9.4,48,22,5.28,"PAH",191,0)="247 SEQ #232^3020226^1"
^DIC(9.4,48,22,5.28,"PAH",191,1,0)="^^3^3^3020226"
^DIC(9.4,48,22,5.28,"PAH",191,1,1,0)="This patch allows for calculation of the related close-out dates and for"
^DIC(9.4,48,22,5.28,"PAH",191,1,2,0)="generating appropriate messages if applicable."
^DIC(9.4,48,22,5.28,"PAH",191,1,3,0)=""
^DIC(9.4,48,22,5.28,"PAH",192,0)="256^3020408^1"
^DIC(9.4,48,22,5.28,"PAH",193,0)="250^3020423^1"
^DIC(9.4,48,22,5.28,"PAH",193,1,0)="^^9^9^3020423"
^DIC(9.4,48,22,5.28,"PAH",193,1,1,0)="This patch is in response to Item #22 in the Rossio Report.  In the area"
^DIC(9.4,48,22,5.28,"PAH",193,1,2,0)="of Means Test (MT) Deficiencies, Item #22 required that the Veterans"
^DIC(9.4,48,22,5.28,"PAH",193,1,3,0)="Health Administration (VHA) identify best practices for means testing and"
^DIC(9.4,48,22,5.28,"PAH",193,1,4,0)="acquiring veterans' signatures at the local level and explore the"
^DIC(9.4,48,22,5.28,"PAH",193,1,5,0)="promulgation of these best practices throughout the system.  This patch"
^DIC(9.4,48,22,5.28,"PAH",193,1,6,0)="incorporates into the scheduling software an Enrollment Application"
^DIC(9.4,48,22,5.28,"PAH",193,1,7,0)="Systems (EAS) API which will inidcate whether to block or allow future"
^DIC(9.4,48,22,5.28,"PAH",193,1,8,0)="appointments and appointment check-in/out for veterans based on their"
^DIC(9.4,48,22,5.28,"PAH",193,1,9,0)="current means test status."
^DIC(9.4,48,22,5.28,"PAH",194,0)="262^3020626^1"
^DIC(9.4,48,22,5.28,"PAH",194,1,0)="^^59^59^3020626"
^DIC(9.4,48,22,5.28,"PAH",194,1,1,0)="Associated patches: (v)YS*5.01*71 install with patch       `SD*5.3*262'"
^DIC(9.4,48,22,5.28,"PAH",194,1,2,0)="                    (v)XU*8*234   install with patch       `SD*5.3*262'"
^DIC(9.4,48,22,5.28,"PAH",194,1,3,0)="                    (v)DG*5.3*447 install with patch       `SD*5.3*262'"
^DIC(9.4,48,22,5.28,"PAH",194,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,5,0)="This patch is being release in support of Mental Health patch "
^DIC(9.4,48,22,5.28,"PAH",194,1,6,0)="YS*5.01*71.  Please refer to the information contained in that patch for "
^DIC(9.4,48,22,5.28,"PAH",194,1,7,0)="installation instructions."
^DIC(9.4,48,22,5.28,"PAH",194,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,9,0)="This patch adds routine SDWU.  This routine adds the following general "
^DIC(9.4,48,22,5.28,"PAH",194,1,10,0)="windows utilities."
^DIC(9.4,48,22,5.28,"PAH",194,1,11,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,12,0)="LABEL                 FUNCTION"
^DIC(9.4,48,22,5.28,"PAH",194,1,13,0)="=====                 ========"
^DIC(9.4,48,22,5.28,"PAH",194,1,14,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,15,0)="ACTLOC(LOC)           Returns TRUE if active hospital location is"
^DIC(9.4,48,22,5.28,"PAH",194,1,16,0)="                      referenced in variable LOC."
^DIC(9.4,48,22,5.28,"PAH",194,1,17,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,18,0)="CLINLOC(Y,FROM,DIR)   Return a set of clinics from HOSPITAL"
^DIC(9.4,48,22,5.28,"PAH",194,1,19,0)="                      LOCATION"
^DIC(9.4,48,22,5.28,"PAH",194,1,20,0)="                      (Y=returned list, FROM=text to $O from, DIR=$O"
^DIC(9.4,48,22,5.28,"PAH",194,1,21,0)="                       direction)"
^DIC(9.4,48,22,5.28,"PAH",194,1,22,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,23,0)="INPLOC(Y,FROM,DIR)    Return a set of wards from HOSPITAL LOCATION"
^DIC(9.4,48,22,5.28,"PAH",194,1,24,0)="                      (Y=returned list, FROM=text to $O from, DIR=$O"
^DIC(9.4,48,22,5.28,"PAH",194,1,25,0)="                       direction)"
^DIC(9.4,48,22,5.28,"PAH",194,1,26,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,27,0)="HOSPLOC(Y,FROM,DIR)   Return a set of locations from HOSPITAL LOCATION"
^DIC(9.4,48,22,5.28,"PAH",194,1,28,0)="                      (Y=returned list, FROM=text to $O from, DIR=$O"
^DIC(9.4,48,22,5.28,"PAH",194,1,29,0)="                       direction)"
^DIC(9.4,48,22,5.28,"PAH",194,1,30,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,31,0)="Associated NOIS:"
^DIC(9.4,48,22,5.28,"PAH",194,1,32,0)=" ================"
^DIC(9.4,48,22,5.28,"PAH",194,1,33,0)=" NONE"
^DIC(9.4,48,22,5.28,"PAH",194,1,34,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,35,0)="Test Sites:"
^DIC(9.4,48,22,5.28,"PAH",194,1,36,0)=" ==========="
^DIC(9.4,48,22,5.28,"PAH",194,1,37,0)=" Minneapolis VAMC, MN"
^DIC(9.4,48,22,5.28,"PAH",194,1,38,0)=" Salt Lake City HCS, UT"
^DIC(9.4,48,22,5.28,"PAH",194,1,39,0)=" VA Health Care Network Upstate New York"
