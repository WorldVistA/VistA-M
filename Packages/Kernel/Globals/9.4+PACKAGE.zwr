^DIC(9.4,48,22,5.28,"PAH",396,1,0)="^^1^1^3090423"
^DIC(9.4,48,22,5.28,"PAH",396,1,1,0)="Fiscal Year 2009 Supplemental Update to the Clinic Stop (#40.7) file."
^DIC(9.4,48,22,5.28,"PAH",397,0)="441^3090423.134059^17"
^DIC(9.4,48,22,5.28,"PAH",397,1,0)="^^3^3^3090423"
^DIC(9.4,48,22,5.28,"PAH",397,1,1,0)="PROJ 112/SHAD"
^DIC(9.4,48,22,5.28,"PAH",397,1,2,0)="AGENT ORANGE/KOREAN DMZ"
^DIC(9.4,48,22,5.28,"PAH",397,1,3,0)="FOREIGN ADDRESS"
^DIC(9.4,48,22,5.28,"PAH",398,0)="551 SEQ #448^3090423.13443^17"
^DIC(9.4,48,22,5.28,"PAH",399,0)="552 SEQ #449^3090423.140651^17"
^DIC(9.4,48,22,5.28,"PAH",400,0)="545 SEQ #450^3090512.114445^17"
^DIC(9.4,48,22,5.28,"PAH",400,1,0)="^^2^2^3090512"
^DIC(9.4,48,22,5.28,"PAH",400,1,1,0)="This patch corrects errors with the Display Appointments and Cancel "
^DIC(9.4,48,22,5.28,"PAH",400,1,2,0)="Clinic Availability (the Pre-Cancellation list build) menu options."
^DIC(9.4,48,22,5.28,"PAH",401,0)="541 SEQ #451^3090527.174503^17"
^DIC(9.4,48,22,5.28,"PAH",401,1,0)="^^3^3^3090527"
^DIC(9.4,48,22,5.28,"PAH",401,1,1,0)="This patch will fix any appointment records within the Appointment "
^DIC(9.4,48,22,5.28,"PAH",401,1,2,0)="sub-file of the Patient file where the Purpose of Visit field contains an "
^DIC(9.4,48,22,5.28,"PAH",401,1,3,0)="invalid value.  All such invalid values will be changed to a value of 3."
^DIC(9.4,48,22,5.28,"PAH",402,0)="555 SEQ #452^3090617.091331^17"
^DIC(9.4,48,22,5.28,"PAH",402,1,0)="^^1^1^3090617"
^DIC(9.4,48,22,5.28,"PAH",402,1,1,0)="Fix SDLT routine for Scheduling letters"
^DIC(9.4,48,22,5.28,"PAH",403,0)="535 SEQ #453^3090630.112029^17"
^DIC(9.4,48,22,5.28,"PAH",403,1,0)="^^6^6^3090630"
^DIC(9.4,48,22,5.28,"PAH",403,1,1,0)="This patch contains fixes for the following issues:"
^DIC(9.4,48,22,5.28,"PAH",403,1,2,0)="Computed date fields not printing the year when doing a Fileman inquiry"
^DIC(9.4,48,22,5.28,"PAH",403,1,3,0)="Turn off option DPA Detailed Patient Assignments[SC PCMM DETAILED LIST "
^DIC(9.4,48,22,5.28,"PAH",403,1,4,0)="PTS]"
^DIC(9.4,48,22,5.28,"PAH",403,1,5,0)="Practitioners Patients report header issue"
^DIC(9.4,48,22,5.28,"PAH",403,1,6,0)="Roll and scroll problem with PCMM enrollment"
^DIC(9.4,48,22,5.28,"PAH",404,0)="538 SEQ #454^3090811.125536^17"
^DIC(9.4,48,22,5.28,"PAH",404,1,0)="^^9^9^3090811"
^DIC(9.4,48,22,5.28,"PAH",404,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,48,22,5.28,"PAH",404,1,2,0)="1) Functionality related to matching an appointment with EWL entries if "
^DIC(9.4,48,22,5.28,"PAH",404,1,3,0)="   the non-removal reason is already in place. "
^DIC(9.4,48,22,5.28,"PAH",404,1,4,0)="2) Calculation and printing report: 30, Over 30, Over 120 Day Report to"
^DIC(9.4,48,22,5.28,"PAH",404,1,5,0)="   a spooler."
^DIC(9.4,48,22,5.28,"PAH",404,1,6,0)="3) Proper identification and notification of only open EWL entries"
^DIC(9.4,48,22,5.28,"PAH",404,1,7,0)="   existing for a particular clinic."
^DIC(9.4,48,22,5.28,"PAH",404,1,8,0)="4) Update the EWL USER MANUAL to reflect correctly a new functionality, "
^DIC(9.4,48,22,5.28,"PAH",404,1,9,0)="   see 1)."
^DIC(9.4,48,22,5.28,"PAH",405,0)="557 SEQ #455^3090915.112526^17"
^DIC(9.4,48,22,5.28,"PAH",405,1,0)="^^1^1^3090915"
^DIC(9.4,48,22,5.28,"PAH",405,1,1,0)="FY2010 updates to the CLINIC STOP (#40.7) file."
^DIC(9.4,48,22,5.28,"PAH",406,0)="536^3090924.104729^17"
^DIC(9.4,48,22,5.28,"PAH",406,1,0)="^^1^1^3090924"
^DIC(9.4,48,22,5.28,"PAH",406,1,1,0)="See National Patch Module, SD*5.3*536"
^DIC(9.4,48,22,5.28,"PAH",407,0)="549 SEQ #457^3091215.153547^17"
^DIC(9.4,48,22,5.28,"PAH",407,1,0)="^^4^4^3091215"
^DIC(9.4,48,22,5.28,"PAH",407,1,1,0)="Fix Audit Trail in Hospital Location file (#44) for field 2505 - "
^DIC(9.4,48,22,5.28,"PAH",407,1,2,0)="Inactivate Date.  Also, fix option Find Next Available Appointment when "
^DIC(9.4,48,22,5.28,"PAH",407,1,3,0)="doing lookup by Team, so that it uses the new multiple field (#5 - "
^DIC(9.4,48,22,5.28,"PAH",407,1,4,0)="Associated Clinic) in the Team Position file (#404.57)."
^DIC(9.4,48,22,5.28,"PAH",408,0)="565 SEQ #458^3100128.144742^17"
^DIC(9.4,48,22,5.28,"PAH",408,1,0)="^^1^1^3100128"
^DIC(9.4,48,22,5.28,"PAH",408,1,1,0)="FY2010 Supplemental update to Clinic Stop file (#40.7)."
^DIC(9.4,48,22,5.28,"PAH",409,0)="543 SEQ #459^3100308.152426^17"
^DIC(9.4,48,22,5.28,"PAH",409,1,0)="^^3^3^3100308"
^DIC(9.4,48,22,5.28,"PAH",409,1,1,0)="Fix to validation logic for Ambcare transmissions to allow 3 new values"
^DIC(9.4,48,22,5.28,"PAH",409,1,2,0)="which were added to the Radiation Exposure Method field (#.3212) in the"
^DIC(9.4,48,22,5.28,"PAH",409,1,3,0)="Patient file (#2) with patch DG*5.3*659."
^DIC(9.4,48,22,5.28,"PAH",410,0)="547 SEQ #460^3100316.142821^17"
^DIC(9.4,48,22,5.28,"PAH",410,1,0)="^^4^4^3100316"
^DIC(9.4,48,22,5.28,"PAH",410,1,1,0)="Add new Help text at the date prompts to inform users that past dates "
^DIC(9.4,48,22,5.28,"PAH",410,1,2,0)="must include the year when input, do not allow appts to be made prior to"
^DIC(9.4,48,22,5.28,"PAH",410,1,3,0)="date a new day of the week is added to clinic pattern and fix "
^DIC(9.4,48,22,5.28,"PAH",410,1,4,0)="Nonconforming Clinic report to indicate when a stop code was Inactivated."
^DIC(9.4,48,22,5.28,"PAH",411,0)="509 SEQ #462^3100504.095757^17"
^DIC(9.4,48,22,5.28,"PAH",411,1,0)="^^2^2^3100504"
^DIC(9.4,48,22,5.28,"PAH",411,1,1,0)="Corrects errors that occur when printing Routing Slips and Display Clinic"
^DIC(9.4,48,22,5.28,"PAH",411,1,2,0)="Availability report."
^DIC(9.4,48,22,5.28,"PAH",412,0)="544 SEQ #463^3100505.095154^17"
^DIC(9.4,48,22,5.28,"PAH",412,1,0)="^^7^7^3100505"
^DIC(9.4,48,22,5.28,"PAH",412,1,1,0)="- Fixes the entry for the DATA ENTRY CLERK (#7) field in the HOSPITAL"
^DIC(9.4,48,22,5.28,"PAH",412,1,2,0)="  LOCATION FILE (#44)."
^DIC(9.4,48,22,5.28,"PAH",412,1,3,0)="- Deletes the CATEGORY OF VISIT (#1.5) field of the ENROLLMENT CLINIC "
^DIC(9.4,48,22,5.28,"PAH",412,1,4,0)="  multiple (#2.001) in the PATIENT FILE (#2)."
^DIC(9.4,48,22,5.28,"PAH",412,1,5,0)="- Fixes the entry for the DATA ENTRY CLERK (#19) field in the PATIENT FILE"
^DIC(9.4,48,22,5.28,"PAH",412,1,6,0)="  (#2)."
^DIC(9.4,48,22,5.28,"PAH",412,1,7,0)="- Corrects a problem when passing service connected types through Quasar. "
^DIC(9.4,48,22,5.28,"PAH",413,0)="570 SEQ #464^3100921.150745^17"
^DIC(9.4,48,22,5.28,"PAH",413,1,0)="^^1^1^3100921"
^DIC(9.4,48,22,5.28,"PAH",413,1,1,0)="FY2011 updates to the Clinic Stop file (#40.7)."
^DIC(9.4,48,22,5.28,"PAH",414,0)="556 SEQ #465^3101115.104423^17"
^DIC(9.4,48,22,5.28,"PAH",414,1,0)="^^2^2^3101115"
^DIC(9.4,48,22,5.28,"PAH",414,1,1,0)="Update Scheduling routines to use replacement API's for unsupported/deleted"
^DIC(9.4,48,22,5.28,"PAH",414,1,2,0)="data dictionary fields in the ICD files."
^DIC(9.4,48,22,5.28,"PAH",415,0)="561 SEQ #466^3101130.150609^17"
^DIC(9.4,48,22,5.28,"PAH",415,1,0)="^^7^7^3101130"
^DIC(9.4,48,22,5.28,"PAH",415,1,1,0)="Fix for several Recall Reminder issues: case sensitivity issue when "
^DIC(9.4,48,22,5.28,"PAH",415,1,2,0)="making a Recall Reminder entry, incorrect wording in message display in "
^DIC(9.4,48,22,5.28,"PAH",415,1,3,0)="CPRS, date range issue with Printing letters by team, an <Undefined> "
^DIC(9.4,48,22,5.28,"PAH",415,1,4,0)="error that occurs with Print Letters by Clinic or by Provider if an "
^DIC(9.4,48,22,5.28,"PAH",415,1,5,0)="up-arrow is entered at the date range prompt and extraneous text that "
^DIC(9.4,48,22,5.28,"PAH",415,1,6,0)="prints at the top of the Letter for Nonresponsive Patients and displaying "
^DIC(9.4,48,22,5.28,"PAH",415,1,7,0)="the full clinic name on the CPRS Cover Sheet."
^DIC(9.4,48,22,5.28,"PAH",416,0)="559 SEQ #467^3101203.102326^17"
^DIC(9.4,48,22,5.28,"PAH",416,1,0)="^^2^2^3101203"
^DIC(9.4,48,22,5.28,"PAH",416,1,1,0)="Patch fixes 2 discrepancies with the ACRP Ad Hoc report."
^DIC(9.4,48,22,5.28,"PAH",416,1,2,0)="."
^DIC(9.4,48,22,5.28,"PAH",417,0)="568 SEQ #468^3101214.142709^17"
^DIC(9.4,48,22,5.28,"PAH",418,0)="573 SEQ #469^3110225.123927^17"
^DIC(9.4,48,22,5.28,"PAH",418,1,0)="^^2^2^3110225"
^DIC(9.4,48,22,5.28,"PAH",418,1,1,0)="This patch provides mid-Fiscal Year 2011 updates to the CLINIC STOP"
^DIC(9.4,48,22,5.28,"PAH",418,1,2,0)="file (#40.7) as requested by the Decision Support Office (DSO)."
^DIC(9.4,48,22,5.28,"PAH",419,0)="569 SEQ #470^3110802.141122^17"
^DIC(9.4,48,22,5.28,"PAH",419,1,0)="^^8^8^3110802"
^DIC(9.4,48,22,5.28,"PAH",419,1,1,0)="This patch will allow printing only one ""second"" letter or card for the "
^DIC(9.4,48,22,5.28,"PAH",419,1,2,0)="nonresponsive patients."
^DIC(9.4,48,22,5.28,"PAH",419,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",419,1,4,0)="This patch will also correct the words for the Lab test(s) line that do"
^DIC(9.4,48,22,5.28,"PAH",419,1,5,0)="not wrap properly problem when manually printing recall reminder letters."
^DIC(9.4,48,22,5.28,"PAH",419,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",419,1,7,0)="Last, this patch will fix the issue for patient's clinic does not match "
^DIC(9.4,48,22,5.28,"PAH",419,1,8,0)="the selected hospital location for the letter."
^DIC(9.4,48,22,5.28,"PAH",420,0)="562 SEQ #471^3110810.112035^17"
^DIC(9.4,48,22,5.28,"PAH",420,1,0)="^^12^12^3110810"
^DIC(9.4,48,22,5.28,"PAH",420,1,1,0)="Fix issue with ACRP CUSS report involving whole days that have been"
^DIC(9.4,48,22,5.28,"PAH",420,1,2,0)="cancelled.  Report erroneously calculates clinic capacity using a zero for"
^DIC(9.4,48,22,5.28,"PAH",420,1,3,0)="whole days that have been cancelled.  The normal number of available slots"
^DIC(9.4,48,22,5.28,"PAH",420,1,4,0)="should be used for the clinic capacity and only the number of open slots"
^DIC(9.4,48,22,5.28,"PAH",420,1,5,0)="should reflect zero for that day.  Also, the patch fixes an erroneous"
^DIC(9.4,48,22,5.28,"PAH",420,1,6,0)="column heading for the ACRP Ad Hoc report when run for a delimited"
^DIC(9.4,48,22,5.28,"PAH",420,1,7,0)="format for export to a spreadsheet, also the use of a single character"
^DIC(9.4,48,22,5.28,"PAH",420,1,8,0)="variable name, an error that causes the Ambcare nightly transmission to"
^DIC(9.4,48,22,5.28,"PAH",420,1,9,0)="fail due to an invalid eligibility code, an error that occurs with the"
^DIC(9.4,48,22,5.28,"PAH",420,1,10,0)="ACRP Ad Hoc report when data is missing in the Patient Enrollment file"
^DIC(9.4,48,22,5.28,"PAH",420,1,11,0)="and an error that occurs with the Patient Activity by Appointment"
^DIC(9.4,48,22,5.28,"PAH",420,1,12,0)="Frequency report."
^DIC(9.4,48,22,5.28,"PAH",421,0)="577 SEQ #472^3110822.112119^17"
^DIC(9.4,48,22,5.28,"PAH",421,1,0)="^^1^1^3110822"
^DIC(9.4,48,22,5.28,"PAH",421,1,1,0)="Fixes undefined variable error - <Undefined>EN+15^SCENIA0."
^DIC(9.4,48,22,5.28,"PAH",422,0)="583 SEQ #474^3110930.132013^17"
^DIC(9.4,48,22,5.28,"PAH",422,1,0)="^^2^2^3110930"
^DIC(9.4,48,22,5.28,"PAH",422,1,1,0)="Fiscal Year 2011 Table Maintenance updates to the Clinic Stop file "
^DIC(9.4,48,22,5.28,"PAH",422,1,2,0)="(#40.7)."
^DIC(9.4,48,22,5.28,"PAH",423,0)="504 SEQ #473^3111003.143731^17"
^DIC(9.4,48,22,5.28,"PAH",423,1,0)="^^3^3^3111003"
^DIC(9.4,48,22,5.28,"PAH",423,1,1,0)="This patch enhances PCMM (Patient Care Management Module) functionality."
^DIC(9.4,48,22,5.28,"PAH",423,1,2,0)="Please .  Please "
^DIC(9.4,48,22,5.28,"PAH",423,1,3,0)="review the FORUM patch module for a complete description."
^DIC(9.4,48,22,5.28,"PAH",424,0)="567 SEQ #475^3111129.095154^17"
^DIC(9.4,48,22,5.28,"PAH",424,1,0)="^^6^6^3111129"
^DIC(9.4,48,22,5.28,"PAH",424,1,1,0)="Fixes to kill some variables that are not killed after exiting Expand "
^DIC(9.4,48,22,5.28,"PAH",424,1,2,0)="Entry, correct incorrect appointment status that displays after running "
^DIC(9.4,48,22,5.28,"PAH",424,1,3,0)="the Purge Scheduling Data option, fix Data Dictionary discrepancy for the "
^DIC(9.4,48,22,5.28,"PAH",424,1,4,0)="Special Availability Flag field (#3) of the sub-file #44.005 in the "
^DIC(9.4,48,22,5.28,"PAH",424,1,5,0)="Hospital Location file (#44) and fix undefined error that occasionally "
^DIC(9.4,48,22,5.28,"PAH",424,1,6,0)="occurs in routine SDM2A when attempting to make an appointment."
^DIC(9.4,48,22,5.28,"PAH",425,0)="560 SEQ #476^3120104.091043^17"
^DIC(9.4,48,22,5.28,"PAH",425,1,0)="^^2^2^3120104"
^DIC(9.4,48,22,5.28,"PAH",425,1,1,0)="Fix several issues that exist with the IEMM option Edit Outpatient"
^DIC(9.4,48,22,5.28,"PAH",425,1,2,0)="Encounter [SCENI OP ENCOUNTER EDIT].                  "
^DIC(9.4,48,22,5.28,"PAH",426,0)="571 SEQ #477^3120112.143721^17"
^DIC(9.4,48,22,5.28,"PAH",426,1,0)="^^3^3^3120112"
^DIC(9.4,48,22,5.28,"PAH",426,1,1,0)="This patch will fix an issue with the security key for providers, an "
^DIC(9.4,48,22,5.28,"PAH",426,1,2,0)="issue with displaying recall reminders on the CPRS cover sheet and "
^DIC(9.4,48,22,5.28,"PAH",426,1,3,0)="prohibit selecting an inactive provider when adding a new recall reminder."
^DIC(9.4,48,22,5.28,"PAH",427,0)="572 SEQ #478^3120118.100044^17"
^DIC(9.4,48,22,5.28,"PAH",427,1,0)="^^10^10^3120118"
^DIC(9.4,48,22,5.28,"PAH",427,1,1,0)="Patch fixes incorrect time that occasionally occurs when an appointment "
^DIC(9.4,48,22,5.28,"PAH",427,1,2,0)="is cancelled, also 'No Action Taken' appointments not appearing on the No "
^DIC(9.4,48,22,5.28,"PAH",427,1,3,0)="Show report (when requested).  Finally, patch fixes a few issues with the "
^DIC(9.4,48,22,5.28,"PAH",427,1,4,0)="Appointment List.  If one clinic is selected and availability has not "
^DIC(9.4,48,22,5.28,"PAH",427,1,5,0)="been set up for the selected date, the clinic name does not print in the "
^DIC(9.4,48,22,5.28,"PAH",427,1,6,0)="report header.  If all clinics or a list of clinics are selected, any "
^DIC(9.4,48,22,5.28,"PAH",427,1,7,0)="clinics not set up with availability for the selected date are ignored "
^DIC(9.4,48,22,5.28,"PAH",427,1,8,0)="and not included on the report.  Finally, by design, inactive clinics can "
^DIC(9.4,48,22,5.28,"PAH",427,1,9,0)="be selected for the report, but no indication is given to the user to let "
^DIC(9.4,48,22,5.28,"PAH",427,1,10,0)="them know a selected clinic is inactive."
^DIC(9.4,48,22,5.28,"PAH",428,0)="584 SEQ #479^3120125.114124^17"
^DIC(9.4,48,22,5.28,"PAH",429,0)="575 SEQ #480^3120213.140632^17"
^DIC(9.4,48,22,5.28,"PAH",430,0)="587 SEQ #481^3120320.120749^17"
^DIC(9.4,48,22,5.28,"PAH",430,1,0)="^^2^2^3120320"
^DIC(9.4,48,22,5.28,"PAH",430,1,1,0)="Mid-Fiscal Year 2012 table maintenance updates to the Clinic Stop file "
^DIC(9.4,48,22,5.28,"PAH",430,1,2,0)="(#40.7)."
^DIC(9.4,48,22,5.28,"PAH",431,0)="578^3120323.125235^17"
^DIC(9.4,48,22,5.28,"PAH",431,1,0)="^^2^2^3120323"
^DIC(9.4,48,22,5.28,"PAH",431,1,1,0)="Two new reports for high risk mental health, Ad Hoc no show report"
^DIC(9.4,48,22,5.28,"PAH",431,1,2,0)="and the nightly background job no show report."
^DIC(9.4,48,22,5.28,"PAH",432,0)="591 SEQ #483^3120402.180145^17"
^DIC(9.4,48,22,5.28,"PAH",432,1,0)="^^1^1^3120402"
^DIC(9.4,48,22,5.28,"PAH",432,1,1,0)="Fixes subscript error introduced with patch SD*5.3*567."
^DIC(9.4,48,22,5.28,"PAH",433,0)="554 SEQ #484^3120412.095422^17"
^DIC(9.4,48,22,5.28,"PAH",433,1,0)="^^5^5^3120412"
^DIC(9.4,48,22,5.28,"PAH",433,1,1,0)="This patch addresses the following issues: A date without a year will no"
^DIC(9.4,48,22,5.28,"PAH",433,1,2,0)="longer bring up a past date. A cancelled appointment will now bring up "
^DIC(9.4,48,22,5.28,"PAH",433,1,3,0)="the Electronic Wait List if the patient has other pending appointments."
^DIC(9.4,48,22,5.28,"PAH",433,1,4,0)="The INACTIVATION DATE ENTERED BY Field will no longer be filled when the"
^DIC(9.4,48,22,5.28,"PAH",433,1,5,0)="user views a clinic."
^DIC(9.4,48,22,5.28,"PAH",434,0)="566 SEQ #485^3120829.103137^17"
^DIC(9.4,48,22,5.28,"PAH",434,1,0)="^^9^9^3120829"
^DIC(9.4,48,22,5.28,"PAH",434,1,1,0)="Patch makes the Clinic Field (#4.5) a required field in the Recall "
^DIC(9.4,48,22,5.28,"PAH",434,1,2,0)="Reminders file (#403.5) and includes post-init routine SD53P566 which "
^DIC(9.4,48,22,5.28,"PAH",434,1,3,0)="will provide a report of all entries in file #403.5 that do not have a "
^DIC(9.4,48,22,5.28,"PAH",434,1,4,0)="clinic.  Also prohibits users from entering patients into the Patient "
^DIC(9.4,48,22,5.28,"PAH",434,1,5,0)="file (#2) through the SDRR CARD ADD and SDRR PATIENT INQUIRY options.  "
^DIC(9.4,48,22,5.28,"PAH",434,1,6,0)="Finally, the patch includes a couple of fixes to the SDRR PATIENT INQUIRY "
^DIC(9.4,48,22,5.28,"PAH",434,1,7,0)="option - displaying ""User Who Entered"" field incorrectly and displaying a "
^DIC(9.4,48,22,5.28,"PAH",434,1,8,0)="Date Reminder Sent for all a patient's reminders, even those that have "
^DIC(9.4,48,22,5.28,"PAH",434,1,9,0)="not been sent yet."
^DIC(9.4,48,22,5.28,"PAH",435,0)="539 SEQ #486^3120829.121947^17"
^DIC(9.4,48,22,5.28,"PAH",435,1,0)="^^16^16^3120829"
^DIC(9.4,48,22,5.28,"PAH",435,1,1,0)="This patch addresses several issues related to PCMM, and EWL as follows:"
^DIC(9.4,48,22,5.28,"PAH",435,1,2,0)="- Properly reflect patient inactivation rules on the PCMM inactivation"
^DIC(9.4,48,22,5.28,"PAH",435,1,3,0)="  messages generated by SCMC PCMM NIGHTLY TASK"
^DIC(9.4,48,22,5.28,"PAH",435,1,4,0)="- The SD WAIT LIST CLEANUP report was modified to:"
^DIC(9.4,48,22,5.28,"PAH",435,1,5,0)="  - evaluate only opened EWL entries"
^DIC(9.4,48,22,5.28,"PAH",435,1,6,0)="  - close any incomplete entries without the CURRENT STATUS field (# 23)"
^DIC(9.4,48,22,5.28,"PAH",435,1,7,0)="    of the SD WAIT LIST file (# 409.3) being populated at all."
^DIC(9.4,48,22,5.28,"PAH",435,1,8,0)="    Those entries will be closed with code ER:ENTERED IN ERROR populated"
^DIC(9.4,48,22,5.28,"PAH",435,1,9,0)="    in the DISPOSITION field (# 21)."
^DIC(9.4,48,22,5.28,"PAH",435,1,10,0)="  - eliminate any closed EWL entries from evaluation of any 'NULL' values"
^DIC(9.4,48,22,5.28,"PAH",435,1,11,0)="    in their required fields, and do not display closed entries at all"
^DIC(9.4,48,22,5.28,"PAH",435,1,12,0)="- The SD WAIT LIST OPEN CLOSED ENTRY option was modified not to allow"
^DIC(9.4,48,22,5.28,"PAH",435,1,13,0)="  opening of close EWL entries with code ER:ENTERED IN ERROR"
^DIC(9.4,48,22,5.28,"PAH",435,1,14,0)="- Routine SDRPA20 was modified to populate null only in the Admission Type"
^DIC(9.4,48,22,5.28,"PAH",435,1,15,0)="  sequence of the PV1 segment, if no Appointment Type  is coming with the"
^DIC(9.4,48,22,5.28,"PAH",435,1,16,0)="  appointment record."
^DIC(9.4,48,22,5.28,"PAH",436,0)="581 SEQ #487^3120829.122317^17"
^DIC(9.4,48,22,5.28,"PAH",436,1,0)="^^4^4^3120829"
^DIC(9.4,48,22,5.28,"PAH",436,1,1,0)="This patch provides the ability to store Capacity and FTEE for all roles "
^DIC(9.4,48,22,5.28,"PAH",436,1,2,0)="in PCMM including primary care and non-primary care teams and to enter "
^DIC(9.4,48,22,5.28,"PAH",436,1,3,0)="and retrieve them in PCMM GUI. The FTEE and Panel Size report colum titles"
^DIC(9.4,48,22,5.28,"PAH",436,1,4,0)="will be modified accordingly."
^DIC(9.4,48,22,5.28,"PAH",437,0)="576 SEQ #488^3120829.122845^17"
^DIC(9.4,48,22,5.28,"PAH",437,1,0)="^^3^3^3120829"
^DIC(9.4,48,22,5.28,"PAH",437,1,1,0)="Patch fixes an error that occasionally occurs with the ACRP Ad Hoc "
^DIC(9.4,48,22,5.28,"PAH",437,1,2,0)="report.  It also fixes a misspelling in the description in the Option "
^DIC(9.4,48,22,5.28,"PAH",437,1,3,0)="file (#19) for ACRP option Retransmit Ambulatory Data by Date Range."
^DIC(9.4,48,22,5.28,"PAH",438,0)="597 SEQ #490^3120910.135737^17"
^DIC(9.4,48,22,5.28,"PAH",438,1,0)="^^7^7^3120910"
^DIC(9.4,48,22,5.28,"PAH",438,1,1,0)="1. When cancelling an appointment within the Appointment Management Module"
^DIC(9.4,48,22,5.28,"PAH",438,1,2,0)="   [SDAM APPT MGT] option, if another user cancels the same appointment "
^DIC(9.4,48,22,5.28,"PAH",438,1,3,0)="   at the same time an undefined error occurs.   "
^DIC(9.4,48,22,5.28,"PAH",438,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",438,1,5,0)="2. If an appointment is cancelled ""by clinic"" within the Appointment "
^DIC(9.4,48,22,5.28,"PAH",438,1,6,0)="   Management Module [SDAM APPT MGT] option, the Appointment Management "
^DIC(9.4,48,22,5.28,"PAH",438,1,7,0)="   Module reverts to patient view instead of clinic view."
^DIC(9.4,48,22,5.28,"PAH",439,0)="596 SEQ #491^3120924.152459^17"
^DIC(9.4,48,22,5.28,"PAH",439,1,0)="^^1^1^3120924"
^DIC(9.4,48,22,5.28,"PAH",439,1,1,0)="Fiscal Year 2013 Table Maintenance for CLINIC STOP file (#40.7)."
^DIC(9.4,48,22,5.28,"PAH",440,0)="563 SEQ #492^3130103.115111^17"
^DIC(9.4,48,22,5.28,"PAH",440,1,0)="^^11^11^3130103"
^DIC(9.4,48,22,5.28,"PAH",440,1,1,0)="1. An error that occurs when un-assigning a patient with a future dated"
^DIC(9.4,48,22,5.28,"PAH",440,1,2,0)="   assignment."
^DIC(9.4,48,22,5.28,"PAH",440,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",440,1,4,0)="2. No warning message is displayed when Assigning/Re-assigning a deceased"
^DIC(9.4,48,22,5.28,"PAH",440,1,5,0)="   patient."
^DIC(9.4,48,22,5.28,"PAH",440,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",440,1,7,0)="3. The user has the ability to assign/unassign a deceased patient"
^DIC(9.4,48,22,5.28,"PAH",440,1,8,0)="   to a team or position after their date of death."
^DIC(9.4,48,22,5.28,"PAH",440,1,9,0)=" "
^DIC(9.4,48,22,5.28,"PAH",440,1,10,0)="4. An error that occurs when a user enters ""^^"" at the prompt ""Enter response:"
^DIC(9.4,48,22,5.28,"PAH",440,1,11,0)="   1//"" using the PCMM Assign or Unassign protocol."
^DIC(9.4,48,22,5.28,"PAH",441,0)="589 SEQ #493^3130110.160728^17"
^DIC(9.4,48,22,5.28,"PAH",442,0)="599 SEQ #494^3130228.105413^17"
^DIC(9.4,48,22,5.28,"PAH",442,1,0)="^^4^4^3130228"
^DIC(9.4,48,22,5.28,"PAH",442,1,1,0)="This patch addresses one Scheduling issue:"
^DIC(9.4,48,22,5.28,"PAH",442,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",442,1,3,0)="1. Previously deleted unused fields were reinstalled into system from "
^DIC(9.4,48,22,5.28,"PAH",442,1,4,0)="patch SD*5.3*568."
^DIC(9.4,48,22,5.28,"PAH",443,0)="601 SEQ #495^3130325.111124^17"
^DIC(9.4,48,22,5.28,"PAH",443,1,0)="^^2^2^3130325"
^DIC(9.4,48,22,5.28,"PAH",443,1,1,0)="This patch provides Fiscal Year 2013 Mid Year updates to the CLINIC STOP"
^DIC(9.4,48,22,5.28,"PAH",443,1,2,0)="(#40.7) file as requested by the Decision Support Office (DSO)."
^DIC(9.4,48,22,5.28,"PAH",444,0)="588^3130516.125604^17"
^DIC(9.4,48,22,5.28,"PAH",444,1,0)="^^4^4^3130516"
^DIC(9.4,48,22,5.28,"PAH",444,1,1,0)="This patch has code changes for increment 3 for the no show reports.  It"
^DIC(9.4,48,22,5.28,"PAH",444,1,2,0)="also has new increment 3 functionality to look at the PRF flag as a CAT 1"
^DIC(9.4,48,22,5.28,"PAH",444,1,3,0)="National flag and also has two new reports,  the ad hoc proactive report"
^DIC(9.4,48,22,5.28,"PAH",444,1,4,0)="and the nightly job proactive report."
^DIC(9.4,48,22,5.28,"PAH",445,0)="574 SEQ #497^3130530.104025^17"
^DIC(9.4,48,22,5.28,"PAH",445,1,0)="^^13^13^3130530"
^DIC(9.4,48,22,5.28,"PAH",445,1,1,0)="IMPORTANT NOTE: "
^DIC(9.4,48,22,5.28,"PAH",445,1,2,0)="If site has not finished the conversion from Class III to Class I yet"
^DIC(9.4,48,22,5.28,"PAH",445,1,3,0)="and Patch SD*5.3*536 has not been installed; please DO NOT install this"
^DIC(9.4,48,22,5.28,"PAH",445,1,4,0)="patch."
^DIC(9.4,48,22,5.28,"PAH",445,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",445,1,6,0)="This patch will prevent the input date value from being accepted for the "
^DIC(9.4,48,22,5.28,"PAH",445,1,7,0)="RECALL DATE (#5) and RECALL DATE (PER PATIENT) (#5.5) fields in the"
^DIC(9.4,48,22,5.28,"PAH",445,1,8,0)="RECALL REMINDERS (#403.5) file if it is before or current date."
^DIC(9.4,48,22,5.28,"PAH",445,1,9,0)=" "
^DIC(9.4,48,22,5.28,"PAH",445,1,10,0)="This patch will fix the problem of allowing entry of a month and year"
^DIC(9.4,48,22,5.28,"PAH",445,1,11,0)="for the recall dates that result in no letter printing."
^DIC(9.4,48,22,5.28,"PAH",445,1,12,0)=" "
^DIC(9.4,48,22,5.28,"PAH",445,1,13,0)="This patch will also disable the Recall Reminders conversion options."
^DIC(9.4,48,22,5.28,"PAH",446,0)="598 SEQ #498^3130617.123216^17"
^DIC(9.4,48,22,5.28,"PAH",446,1,0)="^^12^12^3130617"
^DIC(9.4,48,22,5.28,"PAH",446,1,1,0)=" "
^DIC(9.4,48,22,5.28,"PAH",446,1,2,0)="1. The user has the ability to reactivate an automatically inactivated "
^DIC(9.4,48,22,5.28,"PAH",446,1,3,0)="   patient to an inactive team and position."
^DIC(9.4,48,22,5.28,"PAH",446,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",446,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",446,1,6,0)="2. The user has the ability to reactivate an automatically inactivated "
^DIC(9.4,48,22,5.28,"PAH",446,1,7,0)="   deceased patient to their previously assigned team and position."
^DIC(9.4,48,22,5.28,"PAH",446,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",446,1,9,0)=" "
^DIC(9.4,48,22,5.28,"PAH",446,1,10,0)="3. When running the Historical Provider Position Assignment Listing "
^DIC(9.4,48,22,5.28,"PAH",446,1,11,0)="   report by provider no assignment data is returned due to an incorrect "
^DIC(9.4,48,22,5.28,"PAH",446,1,12,0)="   variable name."
^DIC(9.4,48,22,5.28,"PAH",447,0)="608 SEQ #499^3130916.160851^17"
^DIC(9.4,48,22,5.28,"PAH",447,1,0)="^^2^2^3130916"
^DIC(9.4,48,22,5.28,"PAH",447,1,1,0)="This patch provides Fiscal Year 2014 updates to the CLINIC STOP (#40.7) "
^DIC(9.4,48,22,5.28,"PAH",447,1,2,0)="file as requested by the Decision Support Office (DSO)."
^DIC(9.4,48,22,5.28,"PAH",448,0)="592 SEQ #500^3131023.161739^17"
^DIC(9.4,48,22,5.28,"PAH",448,1,0)="^^6^6^3131023"
^DIC(9.4,48,22,5.28,"PAH",448,1,1,0)=" "
^DIC(9.4,48,22,5.28,"PAH",448,1,2,0)="1. When an appointment is cancelled, the software rounds and files the"
^DIC(9.4,48,22,5.28,"PAH",448,1,3,0)="   cancellation date/time rather than filing the precise time."
^DIC(9.4,48,22,5.28,"PAH",448,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",448,1,5,0)="2. When a user attempts to cancel a checked out appointment, a warning"
^DIC(9.4,48,22,5.28,"PAH",448,1,6,0)="   message is displayed with the incorrect appointment number."
^DIC(9.4,48,22,5.28,"PAH",449,0)="609 SEQ #502^3140317.150802^17"
^DIC(9.4,48,22,5.28,"PAH",449,1,0)="^^2^2^3140317"
^DIC(9.4,48,22,5.28,"PAH",449,1,1,0)="This patch provides Fiscal Year 2014 Mid Year updates to the CLINIC STOP "
^DIC(9.4,48,22,5.28,"PAH",449,1,2,0)="(#40.7) file as requested by the Decision Support Office (DSO)."
^DIC(9.4,48,22,5.28,"PAH",450,0)="594 SEQ #503^3140320.095027^17"
^DIC(9.4,48,22,5.28,"PAH",450,1,0)="^^7^7^3140320"
^DIC(9.4,48,22,5.28,"PAH",450,1,1,0)="This patch addresses two Electronic Waitlist(EWL) issues:"
^DIC(9.4,48,22,5.28,"PAH",450,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",450,1,3,0)="1. The system does not allow a user to create an appointment with an "
^DIC(9.4,48,22,5.28,"PAH",450,1,4,0)="   appointment date that is greater than 120 days from the desired date."
^DIC(9.4,48,22,5.28,"PAH",450,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",450,1,6,0)="2. The current Electronic Waitlist (EWL) User Manual reflects incorrect "
^DIC(9.4,48,22,5.28,"PAH",450,1,7,0)="   instructions for canceling an appointment."
^DIC(9.4,48,22,5.28,"PAH",451,0)="579 SEQ #504^3140603.103727^17"
^DIC(9.4,48,22,5.28,"PAH",451,1,0)="^^19^19^3140603"
^DIC(9.4,48,22,5.28,"PAH",451,1,1,0)="This patch will fix the following several issues:"
^DIC(9.4,48,22,5.28,"PAH",451,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,3,0)="1. Add date letter printed and first letter of patient's last name and"
^DIC(9.4,48,22,5.28,"PAH",451,1,4,0)="   last four digits of patient's social security number to the recall "
^DIC(9.4,48,22,5.28,"PAH",451,1,5,0)="   letters."
^DIC(9.4,48,22,5.28,"PAH",451,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,7,0)="2. Fix <UNDEFINED>DATE+21^SDRRTSK error."
^DIC(9.4,48,22,5.28,"PAH",451,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,9,0)="3. Fix <UNDEFINED>DQD1+7^SDRRRECL error."
^DIC(9.4,48,22,5.28,"PAH",451,1,10,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,11,0)="4. Fix <UNDEFINED>DQD4+7^SDRRRECL error."
^DIC(9.4,48,22,5.28,"PAH",451,1,12,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,13,0)="5. Fix <UNDEFINED>START+17^SDRRTSK1 error."
^DIC(9.4,48,22,5.28,"PAH",451,1,14,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,15,0)="6. Fix the problem of the suffix in a patient's name is printing before"
^DIC(9.4,48,22,5.28,"PAH",451,1,16,0)="   the last name in the letter salutation."
^DIC(9.4,48,22,5.28,"PAH",451,1,17,0)=" "
^DIC(9.4,48,22,5.28,"PAH",451,1,18,0)="7. Remove the comma between city and state when printing recall patient's "
^DIC(9.4,48,22,5.28,"PAH",451,1,19,0)="   address."
^DIC(9.4,48,22,5.28,"PAH",452,0)="585 SEQ #505^3140708.112956^17"
^DIC(9.4,48,22,5.28,"PAH",452,1,0)="^^7^7^3140708"
^DIC(9.4,48,22,5.28,"PAH",452,1,1,0)="This patch will fix the following issues with locally created codes in "
^DIC(9.4,48,22,5.28,"PAH",452,1,2,0)="the ELIGIBILITY CODE file (#8):"
^DIC(9.4,48,22,5.28,"PAH",452,1,3,0)="1) OUT OF SYNC problem when making an appointment."
^DIC(9.4,48,22,5.28,"PAH",452,1,4,0)="2) OUT OF SYNC problem when adding a patient to the electronic wait list."
^DIC(9.4,48,22,5.28,"PAH",452,1,5,0)="3) Ambulatory Care Nightly Transmission generating reject errors due to "
^DIC(9.4,48,22,5.28,"PAH",452,1,6,0)="software not recognizing local eligibility codes having an Internal Entry "
^DIC(9.4,48,22,5.28,"PAH",452,1,7,0)="Number (IEN) greater than 99."
^DIC(9.4,48,22,5.28,"PAH",453,0)="595 SEQ #506^3140710.094635^17"
^DIC(9.4,48,22,5.28,"PAH",453,1,0)="^^8^8^3140710"
^DIC(9.4,48,22,5.28,"PAH",453,1,1,0)="This patch will fix a functionality issue that was introduced with patch"
^DIC(9.4,48,22,5.28,"PAH",453,1,2,0)="SD*5.3*591, whereby the incorrect status for an appointment is being"
^DIC(9.4,48,22,5.28,"PAH",453,1,3,0)="displayed in Appointment Management when an appointment has only been"
^DIC(9.4,48,22,5.28,"PAH",453,1,4,0)="partially Checked out. The original request pointed to incorrect displayed"
^DIC(9.4,48,22,5.28,"PAH",453,1,5,0)="status of an appointment if it was purged. Additionally the List by "
^DIC(9.4,48,22,5.28,"PAH",453,1,6,0)="Appointment protocol was evaluated to provide a consistent appointment "
^DIC(9.4,48,22,5.28,"PAH",453,1,7,0)="status display when this protocol is executed in PXCE ENCOUNTER ENTRY "
^DIC(9.4,48,22,5.28,"PAH",453,1,8,0)="option in Patient Care Encounter (PCE)."
^DIC(9.4,48,22,5.28,"PAH",454,0)="564 SEQ #507^3140717.094013^17"
^DIC(9.4,48,22,5.28,"PAH",454,1,0)="^^7^7^3140717"
^DIC(9.4,48,22,5.28,"PAH",454,1,1,0)="This patch will address several inconsistencies in a list of patients"
^DIC(9.4,48,22,5.28,"PAH",454,1,2,0)="selected and displayed as available ones for multi assignment by "
^DIC(9.4,48,22,5.28,"PAH",454,1,3,0)="appointment in a clinic. That list of patients is available in PCMM GUI."
^DIC(9.4,48,22,5.28,"PAH",454,1,4,0)="Additionally this patch will address a problem with incorrect indication "
^DIC(9.4,48,22,5.28,"PAH",454,1,5,0)="of the patient Primary Care assignment if a hanging cross-reference in "
^DIC(9.4,48,22,5.28,"PAH",454,1,6,0)="the Patient Team Position Assignment file (# 404.43) is evaluated as a "
^DIC(9.4,48,22,5.28,"PAH",454,1,7,0)="valid one."
^DIC(9.4,48,22,5.28,"PAH",455,0)="593 SEQ #508^3140805.163604^17"
^DIC(9.4,48,22,5.28,"PAH",455,1,0)="^^2^2^3140805"
^DIC(9.4,48,22,5.28,"PAH",455,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,48,22,5.28,"PAH",455,1,2,0)="included in this patch."
^DIC(9.4,48,22,5.28,"PAH",456,0)="586 SEQ #509^3140805.16374^17"
^DIC(9.4,48,22,5.28,"PAH",456,1,0)="^^1^1^3140805"
^DIC(9.4,48,22,5.28,"PAH",456,1,1,0)="Scheduling - ICD10 Remediation"
^DIC(9.4,48,22,5.28,"PAH",457,0)="613 SEQ #510^3140807.100755^17"
^DIC(9.4,48,22,5.28,"PAH",457,1,0)="^^1^1^3140807"
^DIC(9.4,48,22,5.28,"PAH",457,1,1,0)="Scheduling changes for VIA project. See patch description for details."
^DIC(9.4,48,22,5.28,"PAH",458,0)="615 SEQ #511^3140917.095334^17"
^DIC(9.4,48,22,5.28,"PAH",458,1,0)="^^3^3^3140917"
^DIC(9.4,48,22,5.28,"PAH",458,1,1,0)="This patch provides Fiscal Year 2015 updates to the CLINIC STOP "
^DIC(9.4,48,22,5.28,"PAH",458,1,2,0)="file (#40.7) as requested by the Office of Finance, Managerial Cost "
^DIC(9.4,48,22,5.28,"PAH",458,1,3,0)="Accounting Office (MCAO)."
^DIC(9.4,48,22,5.28,"PAH",459,0)="582 SEQ #512^3140930.112039^17"
^DIC(9.4,48,22,5.28,"PAH",459,1,0)="^^10^10^3140930"
^DIC(9.4,48,22,5.28,"PAH",459,1,1,0)="This patch will fix the following issues:"
^DIC(9.4,48,22,5.28,"PAH",459,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",459,1,3,0)="1. an issue that allows users to select clinics for recall reminders that"
^DIC(9.4,48,22,5.28,"PAH",459,1,4,0)="   are inactive or scheduled to be inactive on the selected recall date.  "
^DIC(9.4,48,22,5.28,"PAH",459,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",459,1,6,0)="2. an issue with menu option Convert Retired Providers/Clinic Recalls"
^DIC(9.4,48,22,5.28,"PAH",459,1,7,0)="   [SDRR CONVERT ENTRIES]."
^DIC(9.4,48,22,5.28,"PAH",459,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",459,1,9,0)="3. a display issue with the Date Second Reminder Sent field when doing a"
^DIC(9.4,48,22,5.28,"PAH",459,1,10,0)="   Recall Patient Inquiry [SDRR PATIENT INQUIRY]."
^DIC(9.4,48,22,5.28,"PAH",460,0)="605 SEQ #513^3141022.143144^17"
^DIC(9.4,48,22,5.28,"PAH",460,1,0)="^^6^6^3141022"
^DIC(9.4,48,22,5.28,"PAH",460,1,1,0)="This patch will address two issues:"
^DIC(9.4,48,22,5.28,"PAH",460,1,2,0)="- Duplicate encounters are being created for visits causing patient data "
^DIC(9.4,48,22,5.28,"PAH",460,1,3,0)="to not link correctly."
^DIC(9.4,48,22,5.28,"PAH",460,1,4,0)="- The display in the Make Consult Appointment [SC MAKE CONSULT "
^DIC(9.4,48,22,5.28,"PAH",460,1,5,0)="APPOINTMENT] is truncating the Consult Name, causing incorrect consults "
^DIC(9.4,48,22,5.28,"PAH",460,1,6,0)="to be scheduled."
^DIC(9.4,48,22,5.28,"PAH",461,0)="616 SEQ #514^3141031.155635^17"
^DIC(9.4,48,22,5.28,"PAH",462,0)="618 SEQ #515^3141124.150942^17"
^DIC(9.4,48,22,5.28,"PAH",462,1,0)="^^9^9^3141124"
^DIC(9.4,48,22,5.28,"PAH",462,1,1,0)="This patch will fix/update the following three (3) issues:"
^DIC(9.4,48,22,5.28,"PAH",462,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",462,1,3,0)="1. Patient names are not sorted in alphabetical order for the Appointment "
^DIC(9.4,48,22,5.28,"PAH",462,1,4,0)="   List."
^DIC(9.4,48,22,5.28,"PAH",462,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",462,1,6,0)="2. The description for appointment type Organ Donors."
^DIC(9.4,48,22,5.28,"PAH",462,1,7,0)=" "
^DIC(9.4,48,22,5.28,"PAH",462,1,8,0)="3. The length of the data field Clinic IEN Number in the Patient"
^DIC(9.4,48,22,5.28,"PAH",462,1,9,0)="   Appointment Information Transmission (PAIT) documentation."
^DIC(9.4,48,22,5.28,"PAH",463,0)="611 SEQ #516^3141201.154856^17"
^DIC(9.4,48,22,5.28,"PAH",463,1,0)="^^14^14^3141201"
^DIC(9.4,48,22,5.28,"PAH",463,1,1,0)="This patch addresses four Electronic Wait List [EWL] issues:"
^DIC(9.4,48,22,5.28,"PAH",463,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",463,1,3,0)="1. Clinics with an inactive dates in the SD WL CLINIC LOCATION file  "
^DIC(9.4,48,22,5.28,"PAH",463,1,4,0)="   (#409.32) can create wait list entries when using the MAKE APPOINTMENT "
^DIC(9.4,48,22,5.28,"PAH",463,1,5,0)="   [SDAM APPT MAKE] protocol."
^DIC(9.4,48,22,5.28,"PAH",463,1,6,0)="2. When creating an entry using the ENTER/EDIT WAIT LIST (Sch/PCMM) [SD "
^DIC(9.4,48,22,5.28,"PAH",463,1,7,0)="   WAIT LIST ENTER/EDIT] option with the PCMM TEAM ASSIGN wait list type "
^DIC(9.4,48,22,5.28,"PAH",463,1,8,0)="   an undefined error occurs."
^DIC(9.4,48,22,5.28,"PAH",463,1,9,0)="3. When using the INQUIRE WAIT LIST (Sch/PCMM) [SD WAIT LIST INQUIRY] "
^DIC(9.4,48,22,5.28,"PAH",463,1,10,0)="   option the user is prompted to select an entry to view but all entries "
^DIC(9.4,48,22,5.28,"PAH",463,1,11,0)="   are displayed."
^DIC(9.4,48,22,5.28,"PAH",463,1,12,0)="4. When using the Enrollment Wait List (Sch/PCMM) Statistic Report [SD "
^DIC(9.4,48,22,5.28,"PAH",463,1,13,0)="   WAIT LIST ENROLL REPORT] option there is a calculation error in the "
^DIC(9.4,48,22,5.28,"PAH",463,1,14,0)="   DO NOT REMOVE DATE COLUMN."
^DIC(9.4,48,22,5.28,"PAH",464,0)="621 SEQ #517^3150212.10314^17"
^DIC(9.4,48,22,5.28,"PAH",465,0)="620 SEQ #518^3150310.133733^17"
^DIC(9.4,48,22,5.28,"PAH",465,1,0)="^^3^3^3150310"
^DIC(9.4,48,22,5.28,"PAH",465,1,1,0)="This build includes legacy PCMM data extract routines used for comparison "
^DIC(9.4,48,22,5.28,"PAH",465,1,2,0)="to PCMM Web for data validation. The routines have been added as options"
^DIC(9.4,48,22,5.28,"PAH",465,1,3,0)="to the SCMC PCMM Extracts menu."
^DIC(9.4,48,22,5.28,"PAH",466,0)="623 SEQ #519^3150316.16092^17"
^DIC(9.4,48,22,5.28,"PAH",466,1,0)="^^3^3^3150316"
^DIC(9.4,48,22,5.28,"PAH",466,1,1,0)="This patch provides Fiscal Year 2015 Mid-Year updates to the CLINIC "
^DIC(9.4,48,22,5.28,"PAH",466,1,2,0)="STOP file (#40.7) as requested by the Office of Finance, Managerial "
^DIC(9.4,48,22,5.28,"PAH",466,1,3,0)="Cost Accounting Office (MCAO)."
^DIC(9.4,48,22,5.28,"PAH",467,0)="630 SEQ #520^3150413.132117^17"
^DIC(9.4,48,22,5.28,"PAH",467,1,0)="^^7^7^3150413"
^DIC(9.4,48,22,5.28,"PAH",467,1,1,0)="Patch SD*5.3*630 addresses the following 2 issues:"
^DIC(9.4,48,22,5.28,"PAH",467,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",467,1,3,0)="- Duplicate encounters show on the PCE Encounter List screen for a future"
^DIC(9.4,48,22,5.28,"PAH",467,1,4,0)="  appointment that has notes associated with it before the date of the "
^DIC(9.4,48,22,5.28,"PAH",467,1,5,0)="  visit."
^DIC(9.4,48,22,5.28,"PAH",467,1,6,0)="- Consult Service names are being truncated in the Make Consult"
^DIC(9.4,48,22,5.28,"PAH",467,1,7,0)="  Appointment [SC MAKE CONSULT APPOINTMENT] option"
^DIC(9.4,48,22,5.28,"PAH",468,0)="622 SEQ #522^3150623.115515^17"
^DIC(9.4,48,22,5.28,"PAH",468,1,0)="^^1^1^3150623"
^DIC(9.4,48,22,5.28,"PAH",468,1,1,0)="Build for Scheduling Enhancement #4"
^DIC(9.4,48,22,5.28,"PAH",469,0)="624 SEQ #523^3150624.112604^17"
^DIC(9.4,48,22,5.28,"PAH",469,1,0)="^^1^1^3150624"
^DIC(9.4,48,22,5.28,"PAH",469,1,1,0)="SHUTDOWN OF HL7 FOR PCMM."
^DIC(9.4,48,22,5.28,"PAH",470,0)="635 SEQ #524^3150708.151306^17"
^DIC(9.4,48,22,5.28,"PAH",470,1,0)="^^23^23^3150708"
^DIC(9.4,48,22,5.28,"PAH",470,1,1,0)="This patch addresses adding three (3) new fields to the HOSPITAL LOCATION "
^DIC(9.4,48,22,5.28,"PAH",470,1,2,0)="File (#44) to compensate for defects that exist in the current VistA "
^DIC(9.4,48,22,5.28,"PAH",470,1,3,0)="Scheduling package. This effort was requested by the Veterans Health"
^DIC(9.4,48,22,5.28,"PAH",470,1,4,0)="Administration (VHA) Access and Clinic Administrative Program (ACAP) "
^DIC(9.4,48,22,5.28,"PAH",470,1,5,0)="in support of the VistA Scheduling Enhancements (VSE) project."
^DIC(9.4,48,22,5.28,"PAH",470,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",470,1,7,0)="The purpose of this work is to add VistA Scheduling fields to "
^DIC(9.4,48,22,5.28,"PAH",470,1,8,0)=" 1) control the clinics that are exposed to Veterans for direct patient "
^DIC(9.4,48,22,5.28,"PAH",470,1,9,0)="    scheduling of appointments, "
^DIC(9.4,48,22,5.28,"PAH",470,1,10,0)=" 2) control the clinics that display appointment information to Veterans "
^DIC(9.4,48,22,5.28,"PAH",470,1,11,0)="    and "
^DIC(9.4,48,22,5.28,"PAH",470,1,12,0)=" 3) improve the clinic information that is exposed to patients so that it "
^DIC(9.4,48,22,5.28,"PAH",470,1,13,0)="    is meaningful and relevant to clinical care."
^DIC(9.4,48,22,5.28,"PAH",470,1,14,0)=" "
^DIC(9.4,48,22,5.28,"PAH",470,1,15,0)="This patch adds three (3) new fields and modifies two (2) Scheduling "
^DIC(9.4,48,22,5.28,"PAH",470,1,16,0)="options. "
^DIC(9.4,48,22,5.28,"PAH",470,1,17,0)="1. Three (3) new fields were added to the HOSPITAL LOCATION File (#44)."
^DIC(9.4,48,22,5.28,"PAH",470,1,18,0)="   - PATIENT FRIENDLY NAME"
^DIC(9.4,48,22,5.28,"PAH",470,1,19,0)="   - DIRECT PATIENT SCHEDULING?"
^DIC(9.4,48,22,5.28,"PAH",470,1,20,0)="   - DISPLAY CLIN APPT TO PATIENTS?"
^DIC(9.4,48,22,5.28,"PAH",470,1,21,0)=" "
^DIC(9.4,48,22,5.28,"PAH",470,1,22,0)="2. The Set up a Clinic [SDBUILD] and Clinic Profile [SDCLINIC] options "
^DIC(9.4,48,22,5.28,"PAH",470,1,23,0)="   were modified to display the three new fields."
^DIC(9.4,48,22,5.28,"PAH",471,0)="637 SEQ #525^3150916.142421^17"
^DIC(9.4,48,22,5.28,"PAH",471,1,0)="^^3^3^3150916"
^DIC(9.4,48,22,5.28,"PAH",471,1,1,0)="This patch provides Fiscal Year 2016 updates to the CLINIC STOP (#40.7) "
^DIC(9.4,48,22,5.28,"PAH",471,1,2,0)="file as requested by the Office of Finance, Managerial Cost Accounting "
^DIC(9.4,48,22,5.28,"PAH",471,1,3,0)="Office (MCAO)."
^DIC(9.4,48,22,5.28,"PAH",472,0)="634 SEQ #526^3150924.121952^17"
^DIC(9.4,48,22,5.28,"PAH",472,1,0)="^^14^14^3150924"
^DIC(9.4,48,22,5.28,"PAH",472,1,1,0)="In preparation for the VA's transition from Internet Protocol version 4 "
^DIC(9.4,48,22,5.28,"PAH",472,1,2,0)="(IPv4) to Internet Protocol version 6 (IPv6), the Patient Appointment "
^DIC(9.4,48,22,5.28,"PAH",472,1,3,0)="Information Transmission (PAIT) package will require modifications to "
^DIC(9.4,48,22,5.28,"PAH",472,1,4,0)="make it IPv6 ready."
^DIC(9.4,48,22,5.28,"PAH",472,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",472,1,6,0)="IPv6 is the latest version of the Internet Protocol (IP), the "
^DIC(9.4,48,22,5.28,"PAH",472,1,7,0)="communications protocol that provides an identification and location "
^DIC(9.4,48,22,5.28,"PAH",472,1,8,0)="system for computers on networks and routes traffic across the Internet. "
^DIC(9.4,48,22,5.28,"PAH",472,1,9,0)="IPv6 was developed by the Internet Engineering Task Force (IETF) to deal "
^DIC(9.4,48,22,5.28,"PAH",472,1,10,0)="with the long-anticipated problem of IPv4 address exhaustion. IPv6 is "
^DIC(9.4,48,22,5.28,"PAH",472,1,11,0)="intended to replace IPv4."
^DIC(9.4,48,22,5.28,"PAH",472,1,12,0)=" "
^DIC(9.4,48,22,5.28,"PAH",472,1,13,0)="VistA is only compatible with IPv4 currently and this effort is to "
^DIC(9.4,48,22,5.28,"PAH",472,1,14,0)="prepare for IPv6 compatibility."
^DIC(9.4,48,22,5.28,"PAH",473,0)="633 SEQ #527^3151103.104139^17"
^DIC(9.4,48,22,5.28,"PAH",474,0)="603^3151211.143606^17"
^DIC(9.4,48,22,5.28,"PAH",474,1,0)="^^2^2^3151211"
^DIC(9.4,48,22,5.28,"PAH",474,1,1,0)="This is the KIDS build for SD*5.3*603.  It contains the modifications to "
^DIC(9.4,48,22,5.28,"PAH",474,1,2,0)="VistA to support PCMM Web."
^DIC(9.4,48,22,5.28,"PAH",475,0)="639 SEQ #529^3160225.141705^54"
^DIC(9.4,48,22,5.28,"PAH",475,1,0)="^^2^2^3160225"
^DIC(9.4,48,22,5.28,"PAH",475,1,1,0)="This patch stops sending appointment data for bi-monthly transmission "
^DIC(9.4,48,22,5.28,"PAH",475,1,2,0)="from VistA to the Austin Information Technology Center (AITC)."
^DIC(9.4,48,22,5.28,"PAH",476,0)="644 SEQ #530^3160316.131938^54"
^DIC(9.4,48,22,5.28,"PAH",476,1,0)="^^3^3^3160316"
^DIC(9.4,48,22,5.28,"PAH",476,1,1,0)="This patch provides Fiscal Year 2016 Mid-Year updates to the CLINIC STOP "
^DIC(9.4,48,22,5.28,"PAH",476,1,2,0)="(#40.7) file as requested by the Office of Finance, Managerial Cost "
^DIC(9.4,48,22,5.28,"PAH",476,1,3,0)="Accounting Office (MACO)."
^DIC(9.4,48,22,5.28,"PAH",477,0)="638 SEQ #531^3160323.115328^54"
^DIC(9.4,48,22,5.28,"PAH",477,1,0)="^^12^12^3160323"
^DIC(9.4,48,22,5.28,"PAH",477,1,1,0)="Patch SD*5.3*638 addresses three Remedy ticket issues:"
^DIC(9.4,48,22,5.28,"PAH",477,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",477,1,3,0)="1. A request has been made to discontinue the bi-monthly EWL transmissions"
^DIC(9.4,48,22,5.28,"PAH",477,1,4,0)="to Austin. This process is handled through the SD WAIT LIST TRANS TO AAC "
^DIC(9.4,48,22,5.28,"PAH",477,1,5,0)="[SD Wait List Trans to AAC] option. "
^DIC(9.4,48,22,5.28,"PAH",477,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",477,1,7,0)="2. Users are unable to remove data from the DATE INACTIVATED (#3) field "
^DIC(9.4,48,22,5.28,"PAH",477,1,8,0)="in the SD WL CLINIC LOCATION (#409.32) file if there are open wait list "
^DIC(9.4,48,22,5.28,"PAH",477,1,9,0)="entries."
^DIC(9.4,48,22,5.28,"PAH",477,1,10,0)=" "
^DIC(9.4,48,22,5.28,"PAH",477,1,11,0)="3. When adding wait list entries by service specialty, if a specific "
^DIC(9.4,48,22,5.28,"PAH",477,1,12,0)="clinic is added and auditing is on, a subscript error will occur."
^DIC(9.4,48,22,5.28,"PAH",478,0)="647 SEQ #532^3160421.113741^54"
^DIC(9.4,48,22,5.28,"PAH",478,1,0)="^^14^14^3160421"
^DIC(9.4,48,22,5.28,"PAH",478,1,1,0)="Veterans Health Administration (VHA) created over 2.5 million "
^DIC(9.4,48,22,5.28,"PAH",478,1,2,0)="authorizations for Veterans to receive care in the community in fiscal "
^DIC(9.4,48,22,5.28,"PAH",478,1,3,0)="year 2015 - an 8.6% increase in authorizations when compared to fiscal "
^DIC(9.4,48,22,5.28,"PAH",478,1,4,0)="year 2014."
^DIC(9.4,48,22,5.28,"PAH",478,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",478,1,6,0)="The Access and Clinic Administration Program (ACAP) requested that the "
^DIC(9.4,48,22,5.28,"PAH",478,1,7,0)="Stop Code Council establish a new Stop Code to track Community Care "
^DIC(9.4,48,22,5.28,"PAH",478,1,8,0)="Consults. Tracking Community Care Consults is a high priority of the "
^DIC(9.4,48,22,5.28,"PAH",478,1,9,0)="Secretary of the VA and Congress. The enormous volume and importance of "
^DIC(9.4,48,22,5.28,"PAH",478,1,10,0)="Community Care Consults means that VA needs a tracking mechanism to "
^DIC(9.4,48,22,5.28,"PAH",478,1,11,0)="identify these consults. Due to the urgent necessity to track care in the "
^DIC(9.4,48,22,5.28,"PAH",478,1,12,0)="community consults, this patch adds a new stop code 669, COMMUNITY CARE "
^DIC(9.4,48,22,5.28,"PAH",478,1,13,0)="CONSULT, to the CLINIC STOP (#40.7) file as requested by the Office of "
^DIC(9.4,48,22,5.28,"PAH",478,1,14,0)="Finance, Managerial Cost Accounting Office (MCAO)."
^DIC(9.4,48,22,5.28,"PAH",479,0)="627 SEQ #533^3160504.130345^54"
^DIC(9.4,48,22,5.28,"PAH",480,0)="628 SEQ #534^3160504.130408^54"
^DIC(9.4,48,22,5.28,"PAH",480,1,0)="^9.49011^38^38^3170322^"
^DIC(9.4,48,22,5.28,"PAH",480,1,1,0)="Description:"
^DIC(9.4,48,22,5.28,"PAH",480,1,2,0)="==========="
^DIC(9.4,48,22,5.28,"PAH",480,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,4,0)="This patch contains server side functionality for the Vista Scheduling"
^DIC(9.4,48,22,5.28,"PAH",480,1,5,0)="Enhancements (VSE) Enhancements 3 (E3) project. The VSE E3 project "
^DIC(9.4,48,22,5.28,"PAH",480,1,6,0)="implements a GUI reporting application designed to run on user"
^DIC(9.4,48,22,5.28,"PAH",480,1,7,0)="workstations, and launched via a ""Dashboard"" button in the Reports"
^DIC(9.4,48,22,5.28,"PAH",480,1,8,0)="tab in the VSE Enhancement 1 (E1) Clinical Scheduler GUI application."
^DIC(9.4,48,22,5.28,"PAH",480,1,9,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,10,0)="This patch contains server functionality to perform the following "
^DIC(9.4,48,22,5.28,"PAH",480,1,11,0)="tasks:"
^DIC(9.4,48,22,5.28,"PAH",480,1,12,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,13,0)="1) Extract appointment and encounter data from Vista Scheduling."
^DIC(9.4,48,22,5.28,"PAH",480,1,14,0)="2) Aggregate extracted data for a specified date range."
^DIC(9.4,48,22,5.28,"PAH",480,1,15,0)="3) Format the aggregated data in a predefined XML schema."
^DIC(9.4,48,22,5.28,"PAH",480,1,16,0)="4) Send the XML data to a requesting application through the RPC Broker."
^DIC(9.4,48,22,5.28,"PAH",480,1,17,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,18,0)="The report is not available from any legacy VistA option."
^DIC(9.4,48,22,5.28,"PAH",480,1,19,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,20,0)="The only functionality available within legacy VistA is an option to "
^DIC(9.4,48,22,5.28,"PAH",480,1,21,0)="queue the data extraction and compilation process via VistA option BUILD "
^DIC(9.4,48,22,5.28,"PAH",480,1,22,0)="XML DATA [SD VSE REPORT DATA]. This option has also been added to the"
^DIC(9.4,48,22,5.28,"PAH",480,1,23,0)="Option Scheduling (#19.2) file to run nightly as a regularly scheduled"
^DIC(9.4,48,22,5.28,"PAH",480,1,24,0)="background task. The compiled data is stored in the ^TMP global and is "
^DIC(9.4,48,22,5.28,"PAH",480,1,25,0)="deleted completely and recompiled when the SD VSE REPORT DATA option is "
^DIC(9.4,48,22,5.28,"PAH",480,1,26,0)="run."
^DIC(9.4,48,22,5.28,"PAH",480,1,27,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,28,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,29,0)="VistA Remote Procedure Call (RPC) SD VSE FILTER RPC is available for the"
^DIC(9.4,48,22,5.28,"PAH",480,1,30,0)="VSE Clinical Scheduler application to return the list of Report Types"
^DIC(9.4,48,22,5.28,"PAH",480,1,31,0)="(Mental Health, Primary Care, Specialty Care), the list of available date"
^DIC(9.4,48,22,5.28,"PAH",480,1,32,0)="aggregates (Year, Quarter, Month, Week, Date), and the date range"
^DIC(9.4,48,22,5.28,"PAH",480,1,33,0)="corresponding to the selected date aggregate. The values returned by SD"
^DIC(9.4,48,22,5.28,"PAH",480,1,34,0)="VSE FILTER RPC are used to populate the corresponding E3 report filters."
^DIC(9.4,48,22,5.28,"PAH",480,1,35,0)=" "
^DIC(9.4,48,22,5.28,"PAH",480,1,36,0)="Vista Remote Procedure Call (RPC) SD VSE REPORT RPC returns the report "
^DIC(9.4,48,22,5.28,"PAH",480,1,37,0)="data corresponding to the values selected by the initial three filters "
^DIC(9.4,48,22,5.28,"PAH",480,1,38,0)="(Report Type, Date Aggregate, Date Range). "
^DIC(9.4,48,22,5.28,"PAH",481,0)="643 SEQ #535^3160504.130643^54"
^DIC(9.4,48,22,5.28,"PAH",481,1,0)="^^1^1^3160504"
^DIC(9.4,48,22,5.28,"PAH",481,1,1,0)="VistA Scheduling GUI Release 3"
^DIC(9.4,48,22,5.28,"PAH",482,0)="642 SEQ #536^3160504.135946^54"
^DIC(9.4,48,22,5.28,"PAH",483,0)="645 SEQ #537^3160504.140006^54"
^DIC(9.4,48,22,5.28,"PAH",483,1,0)="^^7^7^3160504"
^DIC(9.4,48,22,5.28,"PAH",483,1,1,0)="Build for adding 'CID/PREFERRED DATE' to the title field in files #2,  "
^DIC(9.4,48,22,5.28,"PAH",483,1,2,0)="#409.3, and #409.36. It also updates input and output routines where"
^DIC(9.4,48,22,5.28,"PAH",483,1,3,0)="'desired date' has been shown to the user. From this patch forward,"
^DIC(9.4,48,22,5.28,"PAH",483,1,4,0)="'desired date' is replaced with 'CID/Preferred Date' and 'CID/PD' in "
^DIC(9.4,48,22,5.28,"PAH",483,1,5,0)="reports where there is a space restriction. The field name"
^DIC(9.4,48,22,5.28,"PAH",483,1,6,0)="'DESIRED DATE OF APPOINTMENT' and the title 'CID/PREFERRED DATE' have the "
^DIC(9.4,48,22,5.28,"PAH",483,1,7,0)="same meaning."
^DIC(9.4,48,22,5.28,"PAH",484,0)="641 SEQ #539^3160719.165621^54"
^DIC(9.4,48,22,5.28,"PAH",484,1,0)="^^8^8^3160719"
^DIC(9.4,48,22,5.28,"PAH",484,1,1,0)="This patch release includes two bug fixes:"
^DIC(9.4,48,22,5.28,"PAH",484,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",484,1,3,0)="1. Fixes an issue that caused patient's Date of Death warning message not"
^DIC(9.4,48,22,5.28,"PAH",484,1,4,0)="   always showing when changing to a different patient in the Appointment"
^DIC(9.4,48,22,5.28,"PAH",484,1,5,0)="   Management."
^DIC(9.4,48,22,5.28,"PAH",484,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",484,1,7,0)="2. Fixes an issue that prevented clinic's telephone number from printing"
^DIC(9.4,48,22,5.28,"PAH",484,1,8,0)="   an extra character on a scheduling letter."
^DIC(9.4,48,22,5.28,"PAH",485,0)="649^3160923.152042^54"
^DIC(9.4,48,22,5.28,"PAH",485,1,0)="^^5^5^3160923"
^DIC(9.4,48,22,5.28,"PAH",485,1,1,0)="This patch provides Fiscal Year 2017 updates to the CLINIC STOP (#40.7) "
^DIC(9.4,48,22,5.28,"PAH",485,1,2,0)="file as requested by the Office of Finance, Managerial Cost Accounting "
^DIC(9.4,48,22,5.28,"PAH",485,1,3,0)="Office (MCAO). Associated patch EC*2.0*133 inactivates any DSS Units in "
^DIC(9.4,48,22,5.28,"PAH",485,1,4,0)="Event Capture set to Send No Records to PCE with an associated Stop Code "
^DIC(9.4,48,22,5.28,"PAH",485,1,5,0)="being inactivated by the SD patch."
^DIC(9.4,48,22,5.28,"PAH",486,0)="661 SEQ #541^3170313.144203^54"
^DIC(9.4,48,22,5.28,"PAH",486,1,0)="^^12^12^3170313"
^DIC(9.4,48,22,5.28,"PAH",486,1,1,0)="SD*5.3*661 adds four new Stop Codes to the CLINIC STOP (#40.7) file as "
^DIC(9.4,48,22,5.28,"PAH",486,1,2,0)="requested by the Office of Finance, Managerial Cost Accounting Office "
^DIC(9.4,48,22,5.28,"PAH",486,1,3,0)="(MCAO)."
^DIC(9.4,48,22,5.28,"PAH",486,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",486,1,5,0)="The Comprehensive Addiction and Recovery Act (CARA) of 2016 directs the "
^DIC(9.4,48,22,5.28,"PAH",486,1,6,0)="Department of Veterans Affairs to expand its opioid safety initiative to "
^DIC(9.4,48,22,5.28,"PAH",486,1,7,0)="include all VA medical facilities.  CARA exempts Veterans from paying a "
^DIC(9.4,48,22,5.28,"PAH",486,1,8,0)="copayment to the VA for education on opioid safety to include overdose "
^DIC(9.4,48,22,5.28,"PAH",486,1,9,0)="prevention and treatment for overdose.  In order to schedule, track and "
^DIC(9.4,48,22,5.28,"PAH",486,1,10,0)="exempt from copayments these opioid education visits, designated clinics"
^DIC(9.4,48,22,5.28,"PAH",486,1,11,0)="must be established.  An emergency Stop Code patch is required to "
^DIC(9.4,48,22,5.28,"PAH",486,1,12,0)="implement these clinics by March 15, 2017."
^DIC(9.4,48,22,5.28,"PAH",487,0)="619^3170313.144852^54"
^DIC(9.4,48,22,5.28,"PAH",487,1,0)="^^2^2^3170313"
^DIC(9.4,48,22,5.28,"PAH",487,1,1,0)="This patch allows capturing of language data during the making of an "
^DIC(9.4,48,22,5.28,"PAH",487,1,2,0)="appointment if no value is on file."
^DIC(9.4,48,22,5.28,"PAH",488,0)="657^3170328.154941^54"
^DIC(9.4,48,22,5.28,"PAH",488,1,0)="^^3^3^3170328"
^DIC(9.4,48,22,5.28,"PAH",488,1,1,0)="SD*5.3*657 provides Fiscal Year 2017 Mid-Year updates to the CLINIC STOP "
^DIC(9.4,48,22,5.28,"PAH",488,1,2,0)="(#40.7) file as requested by the Office of Finance, Managerial Cost "
^DIC(9.4,48,22,5.28,"PAH",488,1,3,0)="Accounting Office (MCAO)."
^DIC(9.4,48,22,5.28,"PAH",489,0)="651 SEQ #544^3170427.170606^54"
^DIC(9.4,48,22,5.28,"PAH",490,0)="658 SEQ #545^3170427.170852^54"
^DIC(9.4,48,22,5.28,"PAH",491,0)="659 SEQ #548^3170504.174253^54"
^DIC(9.4,48,22,5.28,"PAH",491,1,0)="^^50^50^3170504"
^DIC(9.4,48,22,5.28,"PAH",491,1,1,0)="This patch will delete the ""trigger"" cross references listed below and"
^DIC(9.4,48,22,5.28,"PAH",491,1,2,0)="delete data in the PCMM HL7 EVENT FILE."
^DIC(9.4,48,22,5.28,"PAH",491,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",491,1,4,0)="Files:"
^DIC(9.4,48,22,5.28,"PAH",491,1,5,0)="PATIENT TEAM POSITION ASSIGNMENT FILE (#404.43)"
