^DIC(9.4,47,22,5.9,"PAH",640,1,0)="^^4^4^3100622"
^DIC(9.4,47,22,5.9,"PAH",640,1,1,0)="This patch corrects a problem where a consistency check error for error"
^DIC(9.4,47,22,5.9,"PAH",640,1,2,0)="55 is displayed when a patient actually HAS income data on file for the year."
