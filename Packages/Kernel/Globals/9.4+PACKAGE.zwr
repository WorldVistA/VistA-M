^DIC(9.4,177,"VERSION")="3.0"
^DIC(9.4,178,0)="OS-OPENM^OSI^This is a place-holder for OpenM information patches"
^DIC(9.4,178,20,0)="^9.402P^^"
^DIC(9.4,178,22,0)="^9.49I^2^2"
^DIC(9.4,178,22,1,0)="2.0"
^DIC(9.4,178,22,1,"PAH",0)="^9.4901^3^3"
^DIC(9.4,178,22,1,"PAH",1,0)="11^3000410^520628471"
^DIC(9.4,178,22,1,"PAH",1,1,0)="^^8^8^3000410"
^DIC(9.4,178,22,1,"PAH",1,1,1,0)="The pre-installation for this patch runs routine ^NVS11PRE.  This routine"
^DIC(9.4,178,22,1,"PAH",1,1,2,0)="updates the PACKAGE file (#9.4) to ensure that there is a version 2.0"
^DIC(9.4,178,22,1,"PAH",1,1,3,0)="entry for the record for the ""OS-OPENM"" package reocrd."
^DIC(9.4,178,22,1,"PAH",1,1,4,0)=" "
^DIC(9.4,178,22,1,"PAH",1,1,5,0)="The core function of this patch removes Y2K monitoring routines and server"
^DIC(9.4,178,22,1,"PAH",1,1,6,0)="options. This patch also contains a revised routine ^NVSMSG.  The repair"
^DIC(9.4,178,22,1,"PAH",1,1,7,0)="is to date format during the creation of a VA MailMan message.  Various"
^DIC(9.4,178,22,1,"PAH",1,1,8,0)="other clean up has been done to NVSMSG."
^DIC(9.4,178,22,1,"PAH",2,0)="11 SEQ #10^3000417^1"
^DIC(9.4,178,22,1,"PAH",2,1,0)="^^8^8^3000417"
^DIC(9.4,178,22,1,"PAH",2,1,1,0)="The pre-installation for this patch runs routine ^NVS11PRE.  This routine"
^DIC(9.4,178,22,1,"PAH",2,1,2,0)="updates the PACKAGE file (#9.4) to ensure that there is a version 2.0"
^DIC(9.4,178,22,1,"PAH",2,1,3,0)="entry for the record for the ""OS-OPENM"" package reocrd."
^DIC(9.4,178,22,1,"PAH",2,1,4,0)=" "
^DIC(9.4,178,22,1,"PAH",2,1,5,0)="The core function of this patch removes Y2K monitoring routines and server"
^DIC(9.4,178,22,1,"PAH",2,1,6,0)="options. This patch also contains a revised routine ^NVSMSG.  The repair"
^DIC(9.4,178,22,1,"PAH",2,1,7,0)="is to date format during the creation of a VA MailMan message.  Various"
^DIC(9.4,178,22,1,"PAH",2,1,8,0)="other clean up has been done to NVSMSG."
^DIC(9.4,178,22,1,"PAH",3,0)="12 SEQ #11^3000516^1"
^DIC(9.4,178,22,1,"PAH",3,1,0)="^^2^2^3000516"
^DIC(9.4,178,22,1,"PAH",3,1,1,0)="This build contains revised Avanti System backup procedure routines"
^DIC(9.4,178,22,1,"PAH",3,1,2,0)="for patch OSI*2.0*12."
^DIC(9.4,178,22,1,"PAH","B",11,1)=""
^DIC(9.4,178,22,1,"PAH","B","11 SEQ #10",2)=""
^DIC(9.4,178,22,1,"PAH","B","12 SEQ #11",3)=""
^DIC(9.4,178,22,2,0)="4.0"
^DIC(9.4,178,22,2,"PAH",0)="^9.4901^1^1"
^DIC(9.4,178,22,2,"PAH",1,0)="3 SEQ #2^3031231^1"
^DIC(9.4,178,22,2,"PAH",1,1,0)="^^8^8^3031231"
^DIC(9.4,178,22,2,"PAH",1,1,1,0)="This build contains a single routine that is run as a post-installation "
^DIC(9.4,178,22,2,"PAH",1,1,2,0)="process.  This routine is only appropriate for VMS/Cache systems and a "
^DIC(9.4,178,22,2,"PAH",1,1,3,0)="specific check for that environment is made before any processing is done."
^DIC(9.4,178,22,2,"PAH",1,1,4,0)=" "
^DIC(9.4,178,22,2,"PAH",1,1,5,0)="If appropriate, the routine examines the Terminal Type file (#3.2) for any"
^DIC(9.4,178,22,2,"PAH",1,1,6,0)="entries containing the name prefix P-MESSAGE.  If any are found, the OPEN "
^DIC(9.4,178,22,2,"PAH",1,1,7,0)="EXECUTE and CLOSE EXECUTE fields are modified to match current VistA "
^DIC(9.4,178,22,2,"PAH",1,1,8,0)="standards for VMS/Cache installations."
^DIC(9.4,178,22,2,"PAH","B","3 SEQ #2",1)=""
^DIC(9.4,178,22,"B","2.0",1)=""
^DIC(9.4,178,22,"B","4.0",2)=""
^DIC(9.4,178,"VERSION")=2
^DIC(9.4,179,0)="LAB MESSAGE^LA7"
^DIC(9.4,179,"VERSION")=5.2
^DIC(9.4,180,0)="CLINICAL REMINDERS^PXRM^Clinical Reminders^^^3000614"
^DIC(9.4,180,5)="SALT LAKE CITY"
^DIC(9.4,180,7)="^^I"
^DIC(9.4,180,22,0)="^9.49I^2^2"
^DIC(9.4,180,22,1,0)="1.5^3000619^3000626^1"
^DIC(9.4,180,22,1,1,0)="^^2^2^3000626"
^DIC(9.4,180,22,1,1,1,0)="This build installs Clinical Reminders V1.5 as a separate package from the"
^DIC(9.4,180,22,1,1,2,0)="Patient Care Encounter (PCE) package. "
^DIC(9.4,180,22,1,"PAH",0)="^9.4901^20^20"
^DIC(9.4,180,22,1,"PAH",1,0)="1^3000905^1"
^DIC(9.4,180,22,1,"PAH",1,1,0)="^^256^256^3000905"
^DIC(9.4,180,22,1,"PAH",1,1,1,0)="  This patch adds:"
^DIC(9.4,180,22,1,"PAH",1,1,2,0)="    * 2 new reminder definitions to the REMINDER DEFINITION file (811.9)"
^DIC(9.4,180,22,1,"PAH",1,1,3,0)="    * 18 new national terms to the REMINDER TERM file (811.5)"
^DIC(9.4,180,22,1,"PAH",1,1,4,0)="    * 1 new file, REMINDER EXTRACT SUMMARY (810.3), that temporarily"
^DIC(9.4,180,22,1,"PAH",1,1,5,0)="      stores data extracted from reminder evaluation processing when"
^DIC(9.4,180,22,1,"PAH",1,1,6,0)="      updating the EPI database. This temporary data can be used to"
^DIC(9.4,180,22,1,"PAH",1,1,7,0)="      compare to data in HL7 messages sent to the EPI database, and"
^DIC(9.4,180,22,1,"PAH",1,1,8,0)="      validate that the appropriate data is extracted."
^DIC(9.4,180,22,1,"PAH",1,1,9,0)="    * 2 new options added to the PXRM REMINDER REPORTS option menu to"
^DIC(9.4,180,22,1,"PAH",1,1,10,0)="      print data from the REMINDER EXTRACT SUMMARY file (810.3)"
^DIC(9.4,180,22,1,"PAH",1,1,11,0)="    * 2 new sort templates, one to identify terms to distribute and one"
^DIC(9.4,180,22,1,"PAH",1,1,12,0)="      for the REMINDER EXTRACT SUMMARY file"
^DIC(9.4,180,22,1,"PAH",1,1,13,0)="    * 3 new print templates, all related to reporting the EPI findings"
^DIC(9.4,180,22,1,"PAH",1,1,14,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,15,0)="  This patch modifies the:"
^DIC(9.4,180,22,1,"PAH",1,1,16,0)="    * description in the VA-HEP C RISK ASSESSMENT reminder definition"
^DIC(9.4,180,22,1,"PAH",1,1,17,0)="    * description for 3 previously distributed Reminder Terms"
^DIC(9.4,180,22,1,"PAH",1,1,18,0)="    * name and description for the Reminder Term PREV POSITIVE TEST FOR"
^DIC(9.4,180,22,1,"PAH",1,1,19,0)="      HEP C, which is renamed PREVIOUSLY ASSESSED HEP C RISK"
^DIC(9.4,180,22,1,"PAH",1,1,20,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,21,0)="  This patch will work with the LR*5.2*260 patch and two pharmacy"
^DIC(9.4,180,22,1,"PAH",1,1,22,0)="  patches (PSO*7*45 and PSJ*5*48) to extract Hepatitis C risk"
^DIC(9.4,180,22,1,"PAH",1,1,23,0)="  assessment, laboratory and medication data. The extracted data will be"
^DIC(9.4,180,22,1,"PAH",1,1,24,0)="  used to update the EPI database at the AAC."
^DIC(9.4,180,22,1,"PAH",1,1,25,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,26,0)=" General Overview:"
^DIC(9.4,180,22,1,"PAH",1,1,27,0)=" ================="
^DIC(9.4,180,22,1,"PAH",1,1,28,0)="  This patch is released in response to Congressional reporting"
^DIC(9.4,180,22,1,"PAH",1,1,29,0)="  requirements and a policy letter distributed by the Under Secretary"
^DIC(9.4,180,22,1,"PAH",1,1,30,0)="  of Health addressing treatment of Hepatitis patients."
^DIC(9.4,180,22,1,"PAH",1,1,31,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,32,0)="  The data extracted for Risk Assessment is based on the VA-HEP C RISK"
^DIC(9.4,180,22,1,"PAH",1,1,33,0)="  ASSESSMENT reminder definition.  The data extracted from laboratory is"
^DIC(9.4,180,22,1,"PAH",1,1,34,0)="  based on the VA-NATIONAL EPI LAB EXTRACT reminder, previously"
^DIC(9.4,180,22,1,"PAH",1,1,35,0)="  distributed as VA-NATIONAL EPI DB UPDATE.  Both of these reminders were"
^DIC(9.4,180,22,1,"PAH",1,1,36,0)="  first released in the Clinical Reminders V.1.5 package. A new reminder"
^DIC(9.4,180,22,1,"PAH",1,1,37,0)="  definition, VA-NATIONAL EPI RX EXTRACT, is distributed in this patch for"
^DIC(9.4,180,22,1,"PAH",1,1,38,0)="  extracting medications. These three reminder definitions provide the"
^DIC(9.4,180,22,1,"PAH",1,1,39,0)="  criteria for extracting the risk assessment, lab, and medication data."
^DIC(9.4,180,22,1,"PAH",1,1,40,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,41,0)="  The reminder evaluation and update to the EPI database occurs on the"
^DIC(9.4,180,22,1,"PAH",1,1,42,0)="  15th of the month following the reporting month. The option that manages"
^DIC(9.4,180,22,1,"PAH",1,1,43,0)="  this update is the LREPI NIGHTLY TASK.  This task currently runs nightly"
^DIC(9.4,180,22,1,"PAH",1,1,44,0)="  at each site. Note: The monthly task on the 15th occurs because the LAG"
^DIC(9.4,180,22,1,"PAH",1,1,45,0)="  DAYS field in the LAB SEARCH/EXTRACT file (69.5) is set to ""15"" for each"
^DIC(9.4,180,22,1,"PAH",1,1,46,0)="  pathogen. The LR*5.2*260 patch contains new processing logic that sends"
^DIC(9.4,180,22,1,"PAH",1,1,47,0)="  data extracted from reminder extract results to the EPI database."
^DIC(9.4,180,22,1,"PAH",1,1,48,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,49,0)="  This patch also fixes a problem where CUSTOMIZED PATIENT COHORT LOGIC"
^DIC(9.4,180,22,1,"PAH",1,1,50,0)="was "
^DIC(9.4,180,22,1,"PAH",1,1,51,0)="  not being used in the reminder evaluation. (NOIS SLC-0600-52703)."
^DIC(9.4,180,22,1,"PAH",1,1,52,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,53,0)=" NOIS Messages:"
^DIC(9.4,180,22,1,"PAH",1,1,54,0)=" =============="
^DIC(9.4,180,22,1,"PAH",1,1,55,0)=" SLC-0600-52703"
^DIC(9.4,180,22,1,"PAH",1,1,56,0)=" MON-0800-50154"
^DIC(9.4,180,22,1,"PAH",1,1,57,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,58,0)="  "
^DIC(9.4,180,22,1,"PAH",1,1,59,0)=" Build Components:"
^DIC(9.4,180,22,1,"PAH",1,1,60,0)=" ================="
^DIC(9.4,180,22,1,"PAH",1,1,61,0)="  Data Dictionary for three files:"
^DIC(9.4,180,22,1,"PAH",1,1,62,0)="      REMINDER EXTRACT SUMMARY (810.3) (new) "
^DIC(9.4,180,22,1,"PAH",1,1,63,0)="      REMINDER DEFINITION (811.9)"
^DIC(9.4,180,22,1,"PAH",1,1,64,0)="      REMINDER TERM (811.5)"
^DIC(9.4,180,22,1,"PAH",1,1,65,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,66,0)="  Option:"
^DIC(9.4,180,22,1,"PAH",1,1,67,0)="      PXRM REMINDER REPORTS menu (description change; lists new options)"
^DIC(9.4,180,22,1,"PAH",1,1,68,0)="      PXRM REMINDERS DUE (no change, just attach to menu)"
^DIC(9.4,180,22,1,"PAH",1,1,69,0)="      PXRM EXTRACT EPI TOTALS (new)"
^DIC(9.4,180,22,1,"PAH",1,1,70,0)="      PXRM EXTRACT EPI FINDING LIST (new)"
^DIC(9.4,180,22,1,"PAH",1,1,71,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,72,0)="  Print Templates to print data from the REMINDER EXTRACT SUMMARY:"
^DIC(9.4,180,22,1,"PAH",1,1,73,0)="      PXRM EXTRACT EPI FINDING LIST (new)"
^DIC(9.4,180,22,1,"PAH",1,1,74,0)="      PXRM EXTRACT EPI FINDING HDR (new)"
^DIC(9.4,180,22,1,"PAH",1,1,75,0)="      PXRM EXTRACT EPI FINDING TOT (new) "
^DIC(9.4,180,22,1,"PAH",1,1,76,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,77,0)="  Sort Templates:"
^DIC(9.4,180,22,1,"PAH",1,1,78,0)="      PXRM EPI LAB AND MED TERMS (new)(identifies reminder terms to"
^DIC(9.4,180,22,1,"PAH",1,1,79,0)="        include in this patch)"
^DIC(9.4,180,22,1,"PAH",1,1,80,0)="      PXRM EXTRACT EPI BY FIND_PT (new)(sorts the extract data in the"
^DIC(9.4,180,22,1,"PAH",1,1,81,0)="        REMINDER EXTRACT SUMMARY file)"
^DIC(9.4,180,22,1,"PAH",1,1,82,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,83,0)="  Routines:"
^DIC(9.4,180,22,1,"PAH",1,1,84,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,85,0)="   The second line of each routine looks like:"
^DIC(9.4,180,22,1,"PAH",1,1,86,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,87,0)="   <tab>;;1.5;CLINICAL REMINDERS;**1**;June 19, 2000"
^DIC(9.4,180,22,1,"PAH",1,1,88,0)=" "
^DIC(9.4,180,22,1,"PAH",1,1,89,0)="   Routine         Old Checksum    New Checksum    Patch List"
^DIC(9.4,180,22,1,"PAH",1,1,90,0)="   =======         ============    ============    =========="
^DIC(9.4,180,22,1,"PAH",1,1,91,0)="   PXRMLOGX          3009219          3005995        **1**"
^DIC(9.4,180,22,1,"PAH",1,1,92,0)="   PXRMP1I               n/a          2412825        **1** "
^DIC(9.4,180,22,1,"PAH",1,1,93,0)="   PXRMP1IE              n/a           349212        **1**"
