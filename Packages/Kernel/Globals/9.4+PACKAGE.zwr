^DIC(9.4,4,22,1,"PAH",81,1,10,0)="A message being received on FORUM from another site caused an abort when"
^DIC(9.4,4,22,1,"PAH",81,1,11,0)="the addressee equated to null.  MailMan now checks for a null addressee."
^DIC(9.4,4,22,1,"PAH",81,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",81,1,13,0)="NOTE: This patch should be installed after hours, when network mail activity"
^DIC(9.4,4,22,1,"PAH",81,1,14,0)="is at a minimum.  It requires MailMan patch XM*7.1*50. "
^DIC(9.4,4,22,1,"PAH",81,1,15,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",81,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",81,1,17,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",81,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",81,1,19,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",81,1,20,0)=" "
^DIC(9.4,4,22,1,"PAH",81,1,21,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",81,1,22,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",81,1,23,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",81,1,24,0)="XMR           14031423        14137871        30,34,65,50,113"
^DIC(9.4,4,22,1,"PAH",81,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",81,1,26,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",81,1,27,0)=""
^DIC(9.4,4,22,1,"PAH",81,1,28,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",81,1,29,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",81,1,30,0)=" "
^DIC(9.4,4,22,1,"PAH",81,1,31,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",81,1,32,0)="NOTE: This patch should be installed after hours, when network mail activity"
^DIC(9.4,4,22,1,"PAH",81,1,33,0)="is at a minimum.  It requires MailMan patch XM*7.1*50. "
^DIC(9.4,4,22,1,"PAH",81,1,34,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",81,1,35,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",81,1,36,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",81,1,37,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",81,1,38,0)="3.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",81,1,39,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",81,1,40,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",81,1,41,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",81,1,42,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",81,1,43,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",81,1,44,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",81,1,45,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",81,1,46,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",81,1,47,0)=" Select INSTALL NAME:    XM*7.1*113    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",81,1,48,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",81,1,49,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",81,1,50,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",81,1,51,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",81,1,52,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",81,1,53,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",81,1,54,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",81,1,55,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",81,1,56,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",81,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",81,1,58,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",81,1,59,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",81,1,60,0)="5.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",81,1,61,0)="==========================================================================="
