^DIC(9.4,147,22,0)="^9.49I^2^2"
^DIC(9.4,147,22,1.13,0)="2.0^2950530^2970625^1"
^DIC(9.4,147,22,1.13,"PAH",0)="^9.4901^386^17"
^DIC(9.4,147,22,1.13,"PAH",1,0)="7 SEQ #3^2970711^1"
^DIC(9.4,147,22,1.13,"PAH",1,1,0)="^^1^1^2970711"
^DIC(9.4,147,22,1.13,"PAH",1,1,1,0)="This patch changes ^RMPFET10 so that RMPFSTAP is only set if not defined."
^DIC(9.4,147,22,1.13,"PAH",2,0)="3 SEQ #4^2970827^1"
^DIC(9.4,147,22,1.13,"PAH",2,1,0)="^^1^1^2970827"
^DIC(9.4,147,22,1.13,"PAH",2,1,1,0)="PROBLEM WITH REMOVING AN ORDER FROM A TRANSMISSION BATCH AND RE-APPROVING"
^DIC(9.4,147,22,1.13,"PAH",3,0)="8 SEQ #5^2971204^1"
^DIC(9.4,147,22,1.13,"PAH",3,1,0)="^^1^1^2971204"
^DIC(9.4,147,22,1.13,"PAH",3,1,1,0)="This patch fixes problems with screen displays and printouts."
^DIC(9.4,147,22,1.13,"PAH",4,0)="9 SEQ #6^2980129^1"
^DIC(9.4,147,22,1.13,"PAH",4,1,0)="^^2^2^2980129"
^DIC(9.4,147,22,1.13,"PAH",4,1,1,0)="This patch includes the new hearing aid contract items that can be ordered"
^DIC(9.4,147,22,1.13,"PAH",4,1,2,0)="through ROES.  The new contract period begins 2-1-98."
^DIC(9.4,147,22,1.13,"PAH",5,0)="10 SEQ #7^2980403^1"
^DIC(9.4,147,22,1.13,"PAH",5,1,0)="^^2^2^2980403"
^DIC(9.4,147,22,1.13,"PAH",5,1,1,0)="This patch ensures all dates are Y2K compliant and corrects formatting of"
^DIC(9.4,147,22,1.13,"PAH",5,1,2,0)="reports and displays for Y2K compliant dates."
^DIC(9.4,147,22,1.13,"PAH",6,0)="4 SEQ #8^2980403^1"
^DIC(9.4,147,22,1.13,"PAH",6,1,0)="^^1^1^2980403"
^DIC(9.4,147,22,1.13,"PAH",6,1,1,0)="PATCH TO FIX A PROBLEM WITH THE DISPLAY A BATCH OPTION"
^DIC(9.4,147,22,1.13,"PAH",7,0)="11 SEQ #9^2980403^1"
^DIC(9.4,147,22,1.13,"PAH",8,0)="5 SEQ #10^2980618^1"
^DIC(9.4,147,22,1.13,"PAH",8,1,0)="^^2^2^2980618"
^DIC(9.4,147,22,1.13,"PAH",8,1,1,0)="This patch fixes a typo that makes required fields mandatory and changes"
^DIC(9.4,147,22,1.13,"PAH",8,1,2,0)="the order code in the Component File to be a required field."
^DIC(9.4,147,22,1.13,"PAH",9,0)="12 SEQ #11^2980618^1"
^DIC(9.4,147,22,1.13,"PAH",10,0)="13 SEQ #12^2980629^1"
^DIC(9.4,147,22,1.13,"PAH",10,1,0)="^^2^2^2980629"
^DIC(9.4,147,22,1.13,"PAH",10,1,1,0)="This patch adds a .E to a patern match used in the server option that"
^DIC(9.4,147,22,1.13,"PAH",10,1,2,0)="reads in file updates."
^DIC(9.4,147,22,1.13,"PAH",11,0)="15 SEQ #14^2990602^1"
^DIC(9.4,147,22,1.13,"PAH",11,1,0)="^^2^2^2990602"
^DIC(9.4,147,22,1.13,"PAH",11,1,1,0)="This patch gets the patient sensitivity information and sends it with the"
^DIC(9.4,147,22,1.13,"PAH",11,1,2,0)="ROES order."
^DIC(9.4,147,22,1.13,"PAH",12,0)="2 SEQ #2"
^DIC(9.4,147,22,1.13,"PAH",382,0)="16 SEQ #15^3000816^1"
^DIC(9.4,147,22,1.13,"PAH",382,1,0)="^^18^18^3000816"
^DIC(9.4,147,22,1.13,"PAH",382,1,1,0)="This patch addresses three issues."
^DIC(9.4,147,22,1.13,"PAH",382,1,2,0)="1.  When a facility name is changed in the Institution File (^DIC(4)),"
^DIC(9.4,147,22,1.13,"PAH",382,1,3,0)="ROES users have a problem bringing up their existing ROES orders because"
^DIC(9.4,147,22,1.13,"PAH",382,1,4,0)="ROES uses the facility name as an identifier.  This patch will change the"
^DIC(9.4,147,22,1.13,"PAH",382,1,5,0)="facility lookup routines to look at the facility number instead of the"
^DIC(9.4,147,22,1.13,"PAH",382,1,6,0)="name.  This becomes a major issue with the release of the Institution Gold"
^DIC(9.4,147,22,1.13,"PAH",382,1,7,0)="File which will standardize facility names across the VA."
^DIC(9.4,147,22,1.13,"PAH",382,1,8,0)="2.  Secondly, this patch will fix some MailMan message addressing"
^DIC(9.4,147,22,1.13,"PAH",382,1,9,0)="problems. Sections of obsolete code will be removed and some new MailMan"
^DIC(9.4,147,22,1.13,"PAH",382,1,10,0)="API's will be incorporated into the routines. These changes will fix the"
^DIC(9.4,147,22,1.13,"PAH",382,1,11,0)="errors some sites reported when resequencing the Postmaster's inbox."
^DIC(9.4,147,22,1.13,"PAH",382,1,12,0)="3.  Finally, the print request is ignored when a user enters a lowercase"
^DIC(9.4,147,22,1.13,"PAH",382,1,13,0)="""p"" when queueing the ""List Orders by Patient or Status"" Report.  This has"
^DIC(9.4,147,22,1.13,"PAH",382,1,14,0)="been fixed so the user may use either case."
^DIC(9.4,147,22,1.13,"PAH",382,1,15,0)=" "
^DIC(9.4,147,22,1.13,"PAH",382,1,16,0)="ROES V2.0 patches 1,2,7,8 and 15 are required to be installed prior to"
^DIC(9.4,147,22,1.13,"PAH",382,1,17,0)="this patch.  Since RMPF*2.0*1 was not a KIDS Build, KIDS will not look for"
^DIC(9.4,147,22,1.13,"PAH",382,1,18,0)="it during the installation process."
^DIC(9.4,147,22,1.13,"PAH",383,0)="17 SEQ #16^3010710^1"
^DIC(9.4,147,22,1.13,"PAH",383,1,0)="^^34^34^3010710"
^DIC(9.4,147,22,1.13,"PAH",383,1,1,0)="This patch addresses 2 issues regarding the ROES 2.0 package:"
^DIC(9.4,147,22,1.13,"PAH",383,1,2,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,3,0)="1.  DAY-0201-40031 <ENDOFILE>READ+1^RMPFDE Error"
^DIC(9.4,147,22,1.13,"PAH",383,1,4,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,5,0)="        o  The end of file error has been corrected.  This was happening"
^DIC(9.4,147,22,1.13,"PAH",383,1,6,0)="           because of the extra print that was printing on the bottom of"
^DIC(9.4,147,22,1.13,"PAH",383,1,7,0)="           the report.  This should have been printing on the screen."
^DIC(9.4,147,22,1.13,"PAH",383,1,8,0)="           This text has been removed from the report."
^DIC(9.4,147,22,1.13,"PAH",383,1,9,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,10,0)="        o  The ability to print the report has been added for partial"
^DIC(9.4,147,22,1.13,"PAH",383,1,11,0)="           screen displays."
^DIC(9.4,147,22,1.13,"PAH",383,1,12,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,13,0)="        o  The error occurring when print to a slave printer has been"
^DIC(9.4,147,22,1.13,"PAH",383,1,14,0)="           corrected.  This was a problem in the code not returning back"
^DIC(9.4,147,22,1.13,"PAH",383,1,15,0)="           to the proper line tag."
^DIC(9.4,147,22,1.13,"PAH",383,1,16,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,17,0)="2.  Enhancements for Bundled Pricing"
^DIC(9.4,147,22,1.13,"PAH",383,1,18,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,19,0)="        o  2nd year warrenty is the only extra component available on new"
^DIC(9.4,147,22,1.13,"PAH",383,1,20,0)="           Custom Hearing Aid Orders.  This patch will add a new field,"
^DIC(9.4,147,22,1.13,"PAH",383,1,21,0)="           ""AVAILABLE W/BUNDLED PRICING"", to the 791811.2 file.  This"
^DIC(9.4,147,22,1.13,"PAH",383,1,22,0)="           field will be the 4th piece of the zero node.  This patch"
^DIC(9.4,147,22,1.13,"PAH",383,1,23,0)="           will set this field for 2nd year warranty to ""yes"", and all"
^DIC(9.4,147,22,1.13,"PAH",383,1,24,0)="           other extra components will be set to ""no"", or left blank."
^DIC(9.4,147,22,1.13,"PAH",383,1,25,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,26,0)="        o  This patch will add the field ""AVAIL WITH EXTRA COMP ORDER"""
^DIC(9.4,147,22,1.13,"PAH",383,1,27,0)="           field in 791811.2 file.  This field will be the 5th piece"
^DIC(9.4,147,22,1.13,"PAH",383,1,28,0)="           of the zero node.  The only extra component that is not"
^DIC(9.4,147,22,1.13,"PAH",383,1,29,0)="           available after the initial Custom Hearing Aid Purchase is"
^DIC(9.4,147,22,1.13,"PAH",383,1,30,0)="           the 2nd year warranty.  This field for the 2nd year warranty"
^DIC(9.4,147,22,1.13,"PAH",383,1,31,0)="           will be set to 1, for ""NO""."
^DIC(9.4,147,22,1.13,"PAH",383,1,32,0)=" "
^DIC(9.4,147,22,1.13,"PAH",383,1,33,0)="        o  The Product file, and Component file will be updated with the"
^DIC(9.4,147,22,1.13,"PAH",383,1,34,0)="           new contract items."
^DIC(9.4,147,22,1.13,"PAH",384,0)="18 SEQ #17^3010710^1"
^DIC(9.4,147,22,1.13,"PAH",384,1,0)="^^5^5^3010710"
^DIC(9.4,147,22,1.13,"PAH",384,1,1,0)="This patch will fix a looping error with was transmitted with patch"
^DIC(9.4,147,22,1.13,"PAH",384,1,2,0)="RMPF*2*17.  When processing elgibility determinations, if the use would"
^DIC(9.4,147,22,1.13,"PAH",384,1,3,0)="select an order and process, they are returned to the eligibility screen"
^DIC(9.4,147,22,1.13,"PAH",384,1,4,0)="and stuck in a loop.  This has been corrected, a kill was added at the"
^DIC(9.4,147,22,1.13,"PAH",384,1,5,0)="start of the routine."
^DIC(9.4,147,22,1.13,"PAH",385,0)="19 SEQ #18^3010906^1"
^DIC(9.4,147,22,1.13,"PAH",385,1,0)="^^6^6^3010906"
^DIC(9.4,147,22,1.13,"PAH",385,1,1,0)="This patch is for the addition of a new vendor for the Remote Order"
^DIC(9.4,147,22,1.13,"PAH",385,1,2,0)="Entry Contract that went into place on July 1st.  It will add new"
^DIC(9.4,147,22,1.13,"PAH",385,1,3,0)="entries into the REMOTE INVENTORY PRODUCT (791811) and to the HEARING"
^DIC(9.4,147,22,1.13,"PAH",385,1,4,0)="AID COMPONENTS (791811.2) files.  This contract addition starts on"
^DIC(9.4,147,22,1.13,"PAH",385,1,5,0)="September 1st, 2001.  This patch must be installed between COB August"
^DIC(9.4,147,22,1.13,"PAH",385,1,6,0)="31st, 2001 and the morning of September 2nd, 2001."
^DIC(9.4,147,22,1.13,"PAH",386,0)="20 SEQ #19^3020327^1"
^DIC(9.4,147,22,1.13,"PAH",386,1,0)="^^4^4^3020327"
^DIC(9.4,147,22,1.13,"PAH",386,1,1,0)="This patch is for the inactivation of Custom Hearing Aids that are"
^DIC(9.4,147,22,1.13,"PAH",386,1,2,0)="under the old contract.  It will inactivate them, and remove all the"
^DIC(9.4,147,22,1.13,"PAH",386,1,3,0)="components.  It will also disable the ability to do adjustments on"
^DIC(9.4,147,22,1.13,"PAH",386,1,4,0)="previous CHA orders under the old contract."
^DIC(9.4,147,22,1.13,"PAH","B","10 SEQ #7",5)=""
^DIC(9.4,147,22,1.13,"PAH","B","11 SEQ #9",7)=""
^DIC(9.4,147,22,1.13,"PAH","B","12 SEQ #11",9)=""
^DIC(9.4,147,22,1.13,"PAH","B","13 SEQ #12",10)=""
^DIC(9.4,147,22,1.13,"PAH","B","15 SEQ #14",11)=""
^DIC(9.4,147,22,1.13,"PAH","B","16 SEQ #15",382)=""
^DIC(9.4,147,22,1.13,"PAH","B","17 SEQ #16",383)=""
^DIC(9.4,147,22,1.13,"PAH","B","18 SEQ #17",384)=""
^DIC(9.4,147,22,1.13,"PAH","B","19 SEQ #18",385)=""
^DIC(9.4,147,22,1.13,"PAH","B","2 SEQ #2",12)=""
^DIC(9.4,147,22,1.13,"PAH","B","20 SEQ #19",386)=""
^DIC(9.4,147,22,1.13,"PAH","B","3 SEQ #4",2)=""
^DIC(9.4,147,22,1.13,"PAH","B","4 SEQ #8",6)=""
^DIC(9.4,147,22,1.13,"PAH","B","5 SEQ #10",8)=""
^DIC(9.4,147,22,1.13,"PAH","B","7 SEQ #3",1)=""
^DIC(9.4,147,22,1.13,"PAH","B","8 SEQ #5",3)=""
^DIC(9.4,147,22,1.13,"PAH","B","9 SEQ #6",4)=""
^DIC(9.4,147,22,2,0)="3.0^3051119^3031023^1"
^DIC(9.4,147,22,2,1,0)="^^169^169^3031023"
^DIC(9.4,147,22,2,1,1,0)=" "
^DIC(9.4,147,22,2,1,2,0)="The Remote Order Entry System (ROES) version 3.0 was developed"
^DIC(9.4,147,22,2,1,3,0)="at the VA Denver Distribution Center(DDC).  It is a changeover to"
^DIC(9.4,147,22,2,1,4,0)="a GUI(windows) based product that allows ordering of goods and"
^DIC(9.4,147,22,2,1,5,0)="services over the internet and greatly reduces the amount of "
^DIC(9.4,147,22,2,1,6,0)="maintenance and support at the local sites.  All of the product"
^DIC(9.4,147,22,2,1,7,0)="and service information will be kept and maintained at the"
^DIC(9.4,147,22,2,1,8,0)="DDC, with real-time information on orders and inventory."
^DIC(9.4,147,22,2,1,9,0)="  "
^DIC(9.4,147,22,2,1,10,0)="There are 2 new GUI applications: ROES3.exe and ROES3DeskTop.exe."
^DIC(9.4,147,22,2,1,11,0)="  "
^DIC(9.4,147,22,2,1,12,0)="*****Please refer to the INSTALLATION GUIDE and TECHNICAL MANUAL"
^DIC(9.4,147,22,2,1,13,0)="for installation and setup directions *****"
^DIC(9.4,147,22,2,1,14,0)="  "
^DIC(9.4,147,22,2,1,15,0)="(1) ROES3.exe is designed to be attached to the CPRS Tools Menu. This"
^DIC(9.4,147,22,2,1,16,0)="application uses the currently selected patient, looks up the current"
^DIC(9.4,147,22,2,1,17,0)="eligibility information and connects to the DDC ROES 3 web site.  If an"
^DIC(9.4,147,22,2,1,18,0)="accepted eligibility is not found, the user selects a proposed eligibility"
^DIC(9.4,147,22,2,1,19,0)="and triggers the sending of the request to PSAS for approval."
^DIC(9.4,147,22,2,1,20,0)="  "
^DIC(9.4,147,22,2,1,21,0)="(2) ROES3DeskTop.exe is designed to be referenced from the user's "
^DIC(9.4,147,22,2,1,22,0)="desktop, as it is not tied to a particular patient.  It is used for"
^DIC(9.4,147,22,2,1,23,0)="station orders, parameter setting, and certain updates to already"
^DIC(9.4,147,22,2,1,24,0)="existing patient orders."
^DIC(9.4,147,22,2,1,25,0)="  "
^DIC(9.4,147,22,2,1,26,0)="NOIS references addressed in this patch"
^DIC(9.4,147,22,2,1,27,0)="======================================="
^DIC(9.4,147,22,2,1,28,0)="There are no NOIS or E3R references"
^DIC(9.4,147,22,2,1,29,0)="  "
^DIC(9.4,147,22,2,1,30,0)="Test Sites"
^DIC(9.4,147,22,2,1,31,0)="=========="
^DIC(9.4,147,22,2,1,32,0)="Denver"
^DIC(9.4,147,22,2,1,33,0)="New York"
^DIC(9.4,147,22,2,1,34,0)="Columbia"
^DIC(9.4,147,22,2,1,35,0)="Mountain Home"
^DIC(9.4,147,22,2,1,36,0)="Atlanta"
^DIC(9.4,147,22,2,1,37,0)="Nashville"
^DIC(9.4,147,22,2,1,38,0)="Washington DC"
^DIC(9.4,147,22,2,1,39,0)="  "
^DIC(9.4,147,22,2,1,40,0)="FTP Software and Documentation"
^DIC(9.4,147,22,2,1,41,0)="=============================="
^DIC(9.4,147,22,2,1,42,0)="  "
^DIC(9.4,147,22,2,1,43,0)="  "
^DIC(9.4,147,22,2,1,44,0)="This patch contains the following enhancements:"
^DIC(9.4,147,22,2,1,45,0)="==============================================="
^DIC(9.4,147,22,2,1,46,0)=" "
^DIC(9.4,147,22,2,1,47,0)=" "
^DIC(9.4,147,22,2,1,48,0)=" "
^DIC(9.4,147,22,2,1,49,0)=" ROUTINE SUMMARY"
^DIC(9.4,147,22,2,1,50,0)="================"
^DIC(9.4,147,22,2,1,51,0)="The second line of all listed routines will look like:"
^DIC(9.4,147,22,2,1,52,0)=" <tab> ;;3.0;REMOTE ORDER ENTRY SYSTEM;;"
^DIC(9.4,147,22,2,1,53,0)="  "
^DIC(9.4,147,22,2,1,54,0)="CHECK^XTSUMBLD results:"
^DIC(9.4,147,22,2,1,55,0)="  "
^DIC(9.4,147,22,2,1,56,0)="RMPFRPC0     checksum = 14317184"
^DIC(9.4,147,22,2,1,57,0)="RMPFRPC1     checksum = 4846679"
^DIC(9.4,147,22,2,1,58,0)="RMPFRPC3     checksum = 2795744"
^DIC(9.4,147,22,2,1,59,0)="RMPFDE2      checksum = 4775274"
^DIC(9.4,147,22,2,1,60,0)="RMPFDE3      checksum = 6656730"
^DIC(9.4,147,22,2,1,61,0)="RMPFDE4      checksum = 1968602"
^DIC(9.4,147,22,2,1,62,0)="  "
^DIC(9.4,147,22,2,1,63,0)="Technical Description"
^DIC(9.4,147,22,2,1,64,0)="====================="
^DIC(9.4,147,22,2,1,65,0)="  "
^DIC(9.4,147,22,2,1,66,0)="1. New file introduced with this patch:"
^DIC(9.4,147,22,2,1,67,0)="  "
^DIC(9.4,147,22,2,1,68,0)="  The ROES ELIGIBILITY CONFIRMATION file (#791814) is introduced to"
^DIC(9.4,147,22,2,1,69,0)="  store the eligibility request information."
^DIC(9.4,147,22,2,1,70,0)="  "
^DIC(9.4,147,22,2,1,71,0)="2. New VistA Options introduced with this patch:"
^DIC(9.4,147,22,2,1,72,0)=" "
^DIC(9.4,147,22,2,1,73,0)="   a) RMPF ROES3 is used to establish a context and allow access to"
^DIC(9.4,147,22,2,1,74,0)="     the 2 new executables.  It must be assigned to all users of "
^DIC(9.4,147,22,2,1,75,0)="     the CPRS Tools or DeskTop applications."
^DIC(9.4,147,22,2,1,76,0)=" "
^DIC(9.4,147,22,2,1,77,0)="   b) RMPFDE2 is used by PSAS to accept/edit/reject eligibility for"
^DIC(9.4,147,22,2,1,78,0)="     ROES3 orders.  This is a standard VistA option and must be"
^DIC(9.4,147,22,2,1,79,0)="     placed on a user's menu."
^DIC(9.4,147,22,2,1,80,0)=" "
^DIC(9.4,147,22,2,1,81,0)="   c) RMPFDE4 is the option to be scheduled to remind all PSAS users"
^DIC(9.4,147,22,2,1,82,0)="     in the RMPF ROES UPDATES (PSAS) mail group that requests for"
^DIC(9.4,147,22,2,1,83,0)="     eligibility approval are waiting for approval."
^DIC(9.4,147,22,2,1,84,0)=" "
^DIC(9.4,147,22,2,1,85,0)="3. New VistA Remote Procedures introduced with this patch:"
^DIC(9.4,147,22,2,1,86,0)=" "
^DIC(9.4,147,22,2,1,87,0)="   a) RMPFDEMOG collects demographic data for transmission to the DDC"
^DIC(9.4,147,22,2,1,88,0)="     for the site, user and patient."
^DIC(9.4,147,22,2,1,89,0)=" "
^DIC(9.4,147,22,2,1,90,0)="   b) RMPFELIG calculates the approved ROES 3 eligibility."
^DIC(9.4,147,22,2,1,91,0)=" "
^DIC(9.4,147,22,2,1,92,0)="   c) RMPF ELIG MSG sends the suggested eligibility to PSAS for approval."
^DIC(9.4,147,22,2,1,93,0)=" "
^DIC(9.4,147,22,2,1,94,0)="4. Mail groups in ROES 3"
^DIC(9.4,147,22,2,1,95,0)=" "
^DIC(9.4,147,22,2,1,96,0)="   a) The ROES 2 mail group RMPF ROES UPDATES (ASPS) continues to be"
^DIC(9.4,147,22,2,1,97,0)="      used, only this time it is to alert audiologists when a request"
^DIC(9.4,147,22,2,1,98,0)="      for eligibility approval has been acted upon."
^DIC(9.4,147,22,2,1,99,0)=" "
^DIC(9.4,147,22,2,1,100,0)="   b) The ROES 2 mail group RMPF ROES UPDATES (PSAS) continues to be"
^DIC(9.4,147,22,2,1,101,0)="      used in ROES 3 to receive notification that a request for eligibility"
^DIC(9.4,147,22,2,1,102,0)="      is waiting to be processed."
^DIC(9.4,147,22,2,1,103,0)=" "
^DIC(9.4,147,22,2,1,104,0)="Installation Instructions:"
^DIC(9.4,147,22,2,1,105,0)="=========================="
^DIC(9.4,147,22,2,1,106,0)="  "
^DIC(9.4,147,22,2,1,107,0)="This patch was created with Kernel V8 KIDS."
^DIC(9.4,147,22,2,1,108,0)="***Please refer to the complete instructions in the Installation Guide***"
^DIC(9.4,147,22,2,1,109,0)="  "
^DIC(9.4,147,22,2,1,110,0)="1. This is a completely new installation, so it will not affect any"
^DIC(9.4,147,22,2,1,111,0)="current ROES 2 users or others on the system. It can be run parallel"
^DIC(9.4,147,22,2,1,112,0)="to the existing ROES 2 system, until ROES 2 is no longer supported."
^DIC(9.4,147,22,2,1,113,0)="You do not need to restrict users from signing on or to lock any"
^DIC(9.4,147,22,2,1,114,0)="options."
^DIC(9.4,147,22,2,1,115,0)="  "
^DIC(9.4,147,22,2,1,116,0)="2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,147,22,2,1,117,0)="This option will load the KIDS package onto your system."
^DIC(9.4,147,22,2,1,118,0)="                           "
^DIC(9.4,147,22,2,1,119,0)="3. You DO NOT need to stop Taskman or the background filers. None"
^DIC(9.4,147,22,2,1,120,0)="of the routines require mapping, so mapping does not need to be"
^DIC(9.4,147,22,2,1,121,0)="disabled."
^DIC(9.4,147,22,2,1,122,0)=" "
^DIC(9.4,147,22,2,1,123,0)="4. Using the Kernel Installation and Distribution System menu"
^DIC(9.4,147,22,2,1,124,0)="(KIDS), you may choose the following options prior to installing"
^DIC(9.4,147,22,2,1,125,0)="this patch:"
^DIC(9.4,147,22,2,1,126,0)=" "
^DIC(9.4,147,22,2,1,127,0)="  a) All routines are new, so there should be no need to Backup"
^DIC(9.4,147,22,2,1,128,0)="     the Transport Global."
^DIC(9.4,147,22,2,1,129,0)=" "
^DIC(9.4,147,22,2,1,130,0)="  b) Again, this is an all new module, so there should be no"
^DIC(9.4,147,22,2,1,131,0)="     need to Compare the Transport Global to the Current System."
^DIC(9.4,147,22,2,1,132,0)=" "
^DIC(9.4,147,22,2,1,133,0)="  c) Verify Checksums in the Transport Global.  This option will"
^DIC(9.4,147,22,2,1,134,0)="     allow you to ensure the integrity of the routines that are"
^DIC(9.4,147,22,2,1,135,0)="     in the Transport Global."
^DIC(9.4,147,22,2,1,136,0)=" "
^DIC(9.4,147,22,2,1,137,0)="5. Use the 'Install Package(s)' option under the 'Installation'"
^DIC(9.4,147,22,2,1,138,0)="   menu."
^DIC(9.4,147,22,2,1,139,0)="  "
^DIC(9.4,147,22,2,1,140,0)="   a) Select INSTALL NAME: ROES 3.0"
^DIC(9.4,147,22,2,1,141,0)=" "
^DIC(9.4,147,22,2,1,142,0)="   b) When prompted 'Want KIDS to Rebuild Menu Trees Upon"
^DIC(9.4,147,22,2,1,143,0)="      completion of install?' YES// respond ""NO"""
^DIC(9.4,147,22,2,1,144,0)=" "
^DIC(9.4,147,22,2,1,145,0)="   c) When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,147,22,2,1,146,0)="      install?' YES// respond ""NO"""
^DIC(9.4,147,22,2,1,147,0)=" "
^DIC(9.4,147,22,2,1,148,0)="   d) When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,147,22,2,1,149,0)="      Options and Protocols?' NO// respond ""NO"""
^DIC(9.4,147,22,2,1,150,0)=" "
^DIC(9.4,147,22,2,1,151,0)="   e) When prompted 'Want to MOVE routines to other CPUs?' YES//"
^DIC(9.4,147,22,2,1,152,0)="      respond ""NO"""
^DIC(9.4,147,22,2,1,153,0)="  "
^DIC(9.4,147,22,2,1,154,0)="6. Confirm the presence of the two mail groups described under 'Technical"
^DIC(9.4,147,22,2,1,155,0)="   Description' and enter the names of the respective mail group"
^DIC(9.4,147,22,2,1,156,0)="   coordinators if necessary."
^DIC(9.4,147,22,2,1,157,0)=" "
^DIC(9.4,147,22,2,1,158,0)="7. Unzip the ROES3.ZIP file containing the 2 new executables: "
^DIC(9.4,147,22,2,1,159,0)="   ROES3.exe and ROES3DeskTop.exe"
^DIC(9.4,147,22,2,1,160,0)="   They can be placed on the network according to local policy,"
^DIC(9.4,147,22,2,1,161,0)="   in a place where they can be referenced from CPRS Tools and"
^DIC(9.4,147,22,2,1,162,0)="   from the user's workstation."
^DIC(9.4,147,22,2,1,163,0)="  "
^DIC(9.4,147,22,2,1,164,0)="8. Assign the Broker option RMPF ROES3 to users of either application."
^DIC(9.4,147,22,2,1,165,0)=" "
^DIC(9.4,147,22,2,1,166,0)="9. Add the application ROES3.exe to the CPRS Tools menu."
^DIC(9.4,147,22,2,1,167,0)=" "
^DIC(9.4,147,22,2,1,168,0)="10. Add a link to the ROES3DeskTop application on the selected user's"
^DIC(9.4,147,22,2,1,169,0)="   workstation desktop."
^DIC(9.4,147,22,2,"PAH",0)="^9.4901^2^2"
^DIC(9.4,147,22,2,"PAH",1,0)="1 SEQ #1^3040903^1"
^DIC(9.4,147,22,2,"PAH",1,1,0)="^^232^232^3040903"
^DIC(9.4,147,22,2,"PAH",1,1,1,0)="This patch addresses several issues that have come up at VAMC stations"
^DIC(9.4,147,22,2,"PAH",1,1,2,0)="as a result of the release of the ROES 3.0 package. All issues"
^DIC(9.4,147,22,2,"PAH",1,1,3,0)="addressed in this patch are related to the ROES3.exe application that"
^DIC(9.4,147,22,2,"PAH",1,1,4,0)="runs from the CPRS Tools menu, as opposed to the ROES3DeskTop.exe"
^DIC(9.4,147,22,2,"PAH",1,1,5,0)="application."
^DIC(9.4,147,22,2,"PAH",1,1,6,0)=" Issues addressed in this patch are:"
^DIC(9.4,147,22,2,"PAH",1,1,7,0)="- A disruption of the parameters passed to the Denver Distribution"
^DIC(9.4,147,22,2,"PAH",1,1,8,0)="  Center(DDC) if the patient's phone number contained a '#' sign."
^DIC(9.4,147,22,2,"PAH",1,1,9,0)="- A failure to pass the priority group to the DDC if the patient had a"
^DIC(9.4,147,22,2,"PAH",1,1,10,0)="  calculated ROES eligibility of SC or COM."
^DIC(9.4,147,22,2,"PAH",1,1,11,0)="- The ""Date of Death"" was not being transmitted consistently."
^DIC(9.4,147,22,2,"PAH",1,1,12,0)="- The inability to exit the ""Display ROES3 Eligibility Requests[RMPFDE2]"""
^DIC(9.4,147,22,2,"PAH",1,1,13,0)="  option by entering a circumflex(^)."
^DIC(9.4,147,22,2,"PAH",1,1,14,0)="- The ""Display ROES3 Eligibility Requests[RMPFDE2]"" option did not allow"
^DIC(9.4,147,22,2,"PAH",1,1,15,0)="  printing to a slave device."
^DIC(9.4,147,22,2,"PAH",1,1,16,0)="- The selection of a proposed eligibility is now mandatory before the"
^DIC(9.4,147,22,2,"PAH",1,1,17,0)="  request for determination will be submitted."
^DIC(9.4,147,22,2,"PAH",1,1,18,0)="- The eligibility request date, the requesting user and the date the"
^DIC(9.4,147,22,2,"PAH",1,1,19,0)="  request was acted on were added to the popup message."
^DIC(9.4,147,22,2,"PAH",1,1,20,0)="- The removal of the ability to do a patient lookup. The application"
^DIC(9.4,147,22,2,"PAH",1,1,21,0)="  should be run from CPRS Tools where the patient is already known."
^DIC(9.4,147,22,2,"PAH",1,1,22,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,23,0)="In addition, the Audiology and Speech Pathology Service(ASPS) National"
^DIC(9.4,147,22,2,"PAH",1,1,24,0)="Program Office requested that:"
^DIC(9.4,147,22,2,"PAH",1,1,25,0)="- PG4 be added as a selectable eligibility. This includes veterans who"
^DIC(9.4,147,22,2,"PAH",1,1,26,0)="  have a Catastrophic Disability and are in Priority Group 4."
^DIC(9.4,147,22,2,"PAH",1,1,27,0)="- The text 'Veterans receiving benefits under 38 U.S.C. 1151 (benefits for"
^DIC(9.4,147,22,2,"PAH",1,1,28,0)="  individuals disabled by treatment or vocational rehabilitation)' be"
^DIC(9.4,147,22,2,"PAH",1,1,29,0)="  added to the help text for category EP3."
^DIC(9.4,147,22,2,"PAH",1,1,30,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,31,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,32,0)="Functional Change"
^DIC(9.4,147,22,2,"PAH",1,1,33,0)="================="
^DIC(9.4,147,22,2,"PAH",1,1,34,0)="The Black Hills Health Care System reported a problem with the ROES3.exe"
^DIC(9.4,147,22,2,"PAH",1,1,35,0)="application causing excessive CPU usage on the desktop systems. The"
^DIC(9.4,147,22,2,"PAH",1,1,36,0)="problem was isolated to the part of the application that waited for"
^DIC(9.4,147,22,2,"PAH",1,1,37,0)="Internet Explorer to exit and then automatically pulled information from"
^DIC(9.4,147,22,2,"PAH",1,1,38,0)="the clipboard and formatted it as text for CPRS Notes.  This"
^DIC(9.4,147,22,2,"PAH",1,1,39,0)="functionality is removed by this patch. By removing this 'listener', the"
^DIC(9.4,147,22,2,"PAH",1,1,40,0)="user will no longer be able to paste the 'formatted' order information"
^DIC(9.4,147,22,2,"PAH",1,1,41,0)="into a note in CPRS. Users will continue to have the ability to highlight"
^DIC(9.4,147,22,2,"PAH",1,1,42,0)="the order information and copy and paste the unformatted information.  The"
^DIC(9.4,147,22,2,"PAH",1,1,43,0)="DDC is looking into more efficient ways to restore this functionality in a"
^DIC(9.4,147,22,2,"PAH",1,1,44,0)="future enhancement if it is still desired by the user community."
^DIC(9.4,147,22,2,"PAH",1,1,45,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,46,0)="NOIS references addressed in this patch"
^DIC(9.4,147,22,2,"PAH",1,1,47,0)="======================================="
^DIC(9.4,147,22,2,"PAH",1,1,48,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,49,0)="MAC-0104-61099"
^DIC(9.4,147,22,2,"PAH",1,1,50,0)="problem:"
^DIC(9.4,147,22,2,"PAH",1,1,51,0)="When a '#' sign was returned by the ADD^VADPT call in the patient's phone"
^DIC(9.4,147,22,2,"PAH",1,1,52,0)="number, it created a break in the URL that was used in establishing a"
^DIC(9.4,147,22,2,"PAH",1,1,53,0)="browser session to the ROES 3.0 web application from CPRS Tools. This"
^DIC(9.4,147,22,2,"PAH",1,1,54,0)="usually showed up as an eligibility error at the DDC."
^DIC(9.4,147,22,2,"PAH",1,1,55,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,56,0)="resolution:"
^DIC(9.4,147,22,2,"PAH",1,1,57,0)="Routine RMPFRPC1 was modified to screen out any special characters from"
^DIC(9.4,147,22,2,"PAH",1,1,58,0)="the values used by the URL in ROES3.exe. The executable also has an added"
^DIC(9.4,147,22,2,"PAH",1,1,59,0)="function that verifies the removal of those characters."
^DIC(9.4,147,22,2,"PAH",1,1,60,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,61,0)="SBY-0404-30089"
^DIC(9.4,147,22,2,"PAH",1,1,62,0)="problem:"
^DIC(9.4,147,22,2,"PAH",1,1,63,0)="When the user attempted to print the ROES 3 Eligibility Request list to"
^DIC(9.4,147,22,2,"PAH",1,1,64,0)="a slave printer, it produced an error at LIST^RMPFDE2 and didn't print."
^DIC(9.4,147,22,2,"PAH",1,1,65,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,66,0)="resolution:"
^DIC(9.4,147,22,2,"PAH",1,1,67,0)="When the print routine was updated, the slave printer part was overlooked."
^DIC(9.4,147,22,2,"PAH",1,1,68,0)="This problem has been fixed in routine RMPFDE2."
^DIC(9.4,147,22,2,"PAH",1,1,69,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,70,0)="WRJ-0104-10319 and MAC-0304-61626"
^DIC(9.4,147,22,2,"PAH",1,1,71,0)="problem:"
^DIC(9.4,147,22,2,"PAH",1,1,72,0)="ROES3 message boxes or the application itself were coming up behind the"
^DIC(9.4,147,22,2,"PAH",1,1,73,0)="CPRS screens."
^DIC(9.4,147,22,2,"PAH",1,1,74,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,75,0)="resolution:"
^DIC(9.4,147,22,2,"PAH",1,1,76,0)="A splash screen was added to the ROES3.exe application and it will give"
^DIC(9.4,147,22,2,"PAH",1,1,77,0)="focus to the ROES 3.0 application in most instances. Situations may"
^DIC(9.4,147,22,2,"PAH",1,1,78,0)="exist where other applications have priority."
^DIC(9.4,147,22,2,"PAH",1,1,79,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,80,0)="E3R references addressed in this patch"
^DIC(9.4,147,22,2,"PAH",1,1,81,0)="======================================"
^DIC(9.4,147,22,2,"PAH",1,1,82,0)="None."
^DIC(9.4,147,22,2,"PAH",1,1,83,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,84,0)="Test Sites"
^DIC(9.4,147,22,2,"PAH",1,1,85,0)="=========="
^DIC(9.4,147,22,2,"PAH",1,1,86,0)="Black Hills     ALPHA/ISM (NT)"
^DIC(9.4,147,22,2,"PAH",1,1,87,0)="Mountain Home   ALPHA/DSM"
^DIC(9.4,147,22,2,"PAH",1,1,88,0)="New York        VMS/CACHE"
^DIC(9.4,147,22,2,"PAH",1,1,89,0)="Salisbury       ALPHA/DSM"
^DIC(9.4,147,22,2,"PAH",1,1,90,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,91,0)="Required Builds"
^DIC(9.4,147,22,2,"PAH",1,1,92,0)="==============="
^DIC(9.4,147,22,2,"PAH",1,1,93,0)="ROES 3.0  (RMPF*3.0)"
^DIC(9.4,147,22,2,"PAH",1,1,94,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,95,0)="This patch contains the following enhancements and problem resolutions:"
^DIC(9.4,147,22,2,"PAH",1,1,96,0)="======================================================================="
^DIC(9.4,147,22,2,"PAH",1,1,97,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,98,0)="The following routines and program have been modified:"
^DIC(9.4,147,22,2,"PAH",1,1,99,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,100,0)="1. RMPFDE2 - This routine was modified to allow Prosthetics and"
^DIC(9.4,147,22,2,"PAH",1,1,101,0)="   Sensory Aids Service(PSAS) users to exit the 'Display ROES 3"
^DIC(9.4,147,22,2,"PAH",1,1,102,0)="   Eligibility Requests[RMPFDE2]' option by entering '^' as well as the"
^DIC(9.4,147,22,2,"PAH",1,1,103,0)="   <Q>uit. The print of the eligibility request list to a slave printer"
^DIC(9.4,147,22,2,"PAH",1,1,104,0)="   was not working and has now been fixed."
^DIC(9.4,147,22,2,"PAH",1,1,105,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,106,0)="2. RMPFDE3 - 'Eligibility' was added to the VistA message text."
^DIC(9.4,147,22,2,"PAH",1,1,107,0)="   Catastrophically disabled veterans in Priority Group 4 have"
^DIC(9.4,147,22,2,"PAH",1,1,108,0)="   been added to the selectable eligibilities."
^DIC(9.4,147,22,2,"PAH",1,1,109,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,110,0)="3. RMPFRPC0 - In the original release priority groups 1 and 2 were"
^DIC(9.4,147,22,2,"PAH",1,1,111,0)="   omitted from the message transmission because the priority group"
^DIC(9.4,147,22,2,"PAH",1,1,112,0)="   was not obtained before the determination of SC or COM eligibility."
^DIC(9.4,147,22,2,"PAH",1,1,113,0)="   This oversight has been corrected.  Also, in the pop-up message"
^DIC(9.4,147,22,2,"PAH",1,1,114,0)="   from PSAS, the eligibility request date, the requesting user and the"
^DIC(9.4,147,22,2,"PAH",1,1,115,0)="   date action was taken were added."
^DIC(9.4,147,22,2,"PAH",1,1,116,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,117,0)="4. RMPFRPC1 - A section was added to remove special characters"
^DIC(9.4,147,22,2,"PAH",1,1,118,0)="   (@#%?&/\) from the values that are used in the URL. Also, the"
^DIC(9.4,147,22,2,"PAH",1,1,119,0)="   failure of the 'Date of Death' to be transmitted to the DDC has"
^DIC(9.4,147,22,2,"PAH",1,1,120,0)="   been corrected."
^DIC(9.4,147,22,2,"PAH",1,1,121,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,122,0)="5. The ROES 3 CPRS Tools option executable(ROES3.exe) was modified"
^DIC(9.4,147,22,2,"PAH",1,1,123,0)="   to:"
^DIC(9.4,147,22,2,"PAH",1,1,124,0)="   -Correct the spelling of 'priority'."
^DIC(9.4,147,22,2,"PAH",1,1,125,0)="   -The title of the selection box was changed to 'You must select a"
^DIC(9.4,147,22,2,"PAH",1,1,126,0)="    Proposed Eligibility', and a selection was made mandatory."
^DIC(9.4,147,22,2,"PAH",1,1,127,0)="   -A splash screen was added to the executable to help alleviate the"
^DIC(9.4,147,22,2,"PAH",1,1,128,0)="    problem of the application not getting focus in front of the CPRS"
^DIC(9.4,147,22,2,"PAH",1,1,129,0)="    screens. Circumstances may still exist where the CPRS screen has"
^DIC(9.4,147,22,2,"PAH",1,1,130,0)="    priority. In those situations the user can <Alt><Tab> to view the"
^DIC(9.4,147,22,2,"PAH",1,1,131,0)="    Audiogram screen."
^DIC(9.4,147,22,2,"PAH",1,1,132,0)="   -The portion of the module that was used by developers to lookup a"
^DIC(9.4,147,22,2,"PAH",1,1,133,0)="    patient was removed. That section was not meant to be used by"
^DIC(9.4,147,22,2,"PAH",1,1,134,0)="    field stations."
^DIC(9.4,147,22,2,"PAH",1,1,135,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,136,0)="ROUTINE SUMMARY:"
^DIC(9.4,147,22,2,"PAH",1,1,137,0)="==============="
^DIC(9.4,147,22,2,"PAH",1,1,138,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,139,0)="The following routines are included with this patch.  The second line"
^DIC(9.4,147,22,2,"PAH",1,1,140,0)="of these routines will look like:"
^DIC(9.4,147,22,2,"PAH",1,1,141,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,142,0)=" ;;3.0;REMOTE ORDER/ENTRY SYSTEM;**1**;11/1/02"
^DIC(9.4,147,22,2,"PAH",1,1,143,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,144,0)="CHECK^XTSUMBLD results:"
^DIC(9.4,147,22,2,"PAH",1,1,145,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,146,0)=" Routine Name        Before Patch        After Patch        Patch List"
^DIC(9.4,147,22,2,"PAH",1,1,147,0)="  RMPFDE2              4775274              4811678               1"
^DIC(9.4,147,22,2,"PAH",1,1,148,0)="  RMPFDE3              6656730              7069797               1"
^DIC(9.4,147,22,2,"PAH",1,1,149,0)="  RMPFRPC0            14317184             13128624               1"
^DIC(9.4,147,22,2,"PAH",1,1,150,0)="  RMPFRPC1             4846679              5112865               1"
^DIC(9.4,147,22,2,"PAH",1,1,151,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,152,0)="SOFTWARE RETRIEVAL"
^DIC(9.4,147,22,2,"PAH",1,1,153,0)="=================="
^DIC(9.4,147,22,2,"PAH",1,1,154,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,155,0)="This patch will be distributed in a PackMan message through the"
^DIC(9.4,147,22,2,"PAH",1,1,156,0)="National Patch Module. The patch zip file containing the ROES3.exe file"
^DIC(9.4,147,22,2,"PAH",1,1,157,0)="can be retrieved from the following FTP address:"
^DIC(9.4,147,22,2,"PAH",1,1,158,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,159,0)="  download.vista.domain.ext"
^DIC(9.4,147,22,2,"PAH",1,1,160,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,161,0)="This transmits the files from the first available FTP server.  Sites may"
^DIC(9.4,147,22,2,"PAH",1,1,162,0)="also elect to retrieve software directly from a specific server as"
^DIC(9.4,147,22,2,"PAH",1,1,163,0)="follows:"
^DIC(9.4,147,22,2,"PAH",1,1,164,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,165,0)="OI FIELD OFFICE         FTP ADDRESS                     DIRECTORY"
^DIC(9.4,147,22,2,"PAH",1,1,166,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,167,0)="Albany                  ftp.fo-albany.domain.ext        anonymous.software"
^DIC(9.4,147,22,2,"PAH",1,1,168,0)="Hines                   ftp.fo-hines.domain.ext         anonymous.software"
^DIC(9.4,147,22,2,"PAH",1,1,169,0)="Salt Lake City          ftp.fo-slc.domain.ext           anonymous.software"
^DIC(9.4,147,22,2,"PAH",1,1,170,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,171,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,172,0)="FILE NAME               DESCRIPTION/TITLE               RETRIEVAL FORMAT"
^DIC(9.4,147,22,2,"PAH",1,1,173,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,174,0)="RMPF3_P1.ZIP[1.33 MB]   ROES3 CPRS Tools Executable     BINARY"
^DIC(9.4,147,22,2,"PAH",1,1,175,0)="                        containing ROES3.exe"
^DIC(9.4,147,22,2,"PAH",1,1,176,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,177,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,178,0)="INSTALLATION INSTRUCTIONS:"
^DIC(9.4,147,22,2,"PAH",1,1,179,0)="========================="
^DIC(9.4,147,22,2,"PAH",1,1,180,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,181,0)="ROES users should be off the system while these routines are being"
^DIC(9.4,147,22,2,"PAH",1,1,182,0)="installed. This patch should be installed during non-peak hours to"
^DIC(9.4,147,22,2,"PAH",1,1,183,0)="minimize disruption. Installation will take approximately 5 minutes"
^DIC(9.4,147,22,2,"PAH",1,1,184,0)="or more, depending on the CPRS Tools menu structure at your site."
^DIC(9.4,147,22,2,"PAH",1,1,185,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,186,0)=" 1.  Use the INSTALL/CHECK MESSAGE option on the PackMan menu.  Answer"
^DIC(9.4,147,22,2,"PAH",1,1,187,0)="     YES to the prompt 'Want to Continue with Load? YES//'.  This"
^DIC(9.4,147,22,2,"PAH",1,1,188,0)="     will load the KIDS package onto your system."
^DIC(9.4,147,22,2,"PAH",1,1,189,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,190,0)=" 2.  Review your mapped set.  If the routines listed in the ROUTINE"
^DIC(9.4,147,22,2,"PAH",1,1,191,0)="     SUMMARY section are mapped, they should be removed from the mapped"
^DIC(9.4,147,22,2,"PAH",1,1,192,0)="     set at this time."
^DIC(9.4,147,22,2,"PAH",1,1,193,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,194,0)=" 3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,147,22,2,"PAH",1,1,195,0)="     the Installation menu."
^DIC(9.4,147,22,2,"PAH",1,1,196,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,197,0)=" 4.  From this menu, you may elect to use the following options (when"
^DIC(9.4,147,22,2,"PAH",1,1,198,0)="     prompted for INSTALL NAME, enter RMPF*3.0*1):"
^DIC(9.4,147,22,2,"PAH",1,1,199,0)="     a.  Backup a Transport Global - this option will create a backup"
^DIC(9.4,147,22,2,"PAH",1,1,200,0)="         message of any routines exported with the patch."
^DIC(9.4,147,22,2,"PAH",1,1,201,0)="     b.  Compare Transport Global to Current System - this option will"
^DIC(9.4,147,22,2,"PAH",1,1,202,0)="         allow you to view all changes to routines that will be made when"
^DIC(9.4,147,22,2,"PAH",1,1,203,0)="         the patch is installed."
^DIC(9.4,147,22,2,"PAH",1,1,204,0)="     c.  Verify Checksums in Transport Global - this option will allow you"
^DIC(9.4,147,22,2,"PAH",1,1,205,0)="         to ensure the integrity of the routines that are in the Transport"
^DIC(9.4,147,22,2,"PAH",1,1,206,0)="         Global."
^DIC(9.4,147,22,2,"PAH",1,1,207,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,208,0)=" 5.  Use the Install Package(s) option and select the package RMPF*3.0*1."
^DIC(9.4,147,22,2,"PAH",1,1,209,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,210,0)=" 6.  When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,147,22,2,"PAH",1,1,211,0)="     YES//"", respond ""NO."""
^DIC(9.4,147,22,2,"PAH",1,1,212,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,213,0)=" 7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,147,22,2,"PAH",1,1,214,0)="     Protocols? YES//', respond ""YES"". When prompted to select the"
^DIC(9.4,147,22,2,"PAH",1,1,215,0)="     options you would like to place out of order, enter the following:"
^DIC(9.4,147,22,2,"PAH",1,1,216,0)="          Display ROES3 Eligibility Requests   RMPFDE2"
^DIC(9.4,147,22,2,"PAH",1,1,217,0)="          ROES3 OPTION ACCESS                  RMPF ROES3"
^DIC(9.4,147,22,2,"PAH",1,1,218,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,219,0)=" 8.  When prompted 'Delay Install (Minutes):  (0-60): 0//; respond '0.'"
^DIC(9.4,147,22,2,"PAH",1,1,220,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,221,0)=" 9.  If routines were unmapped as part of step 2, they should be returned"
^DIC(9.4,147,22,2,"PAH",1,1,222,0)="     to the mapped set once the installation is complete."
^DIC(9.4,147,22,2,"PAH",1,1,223,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,224,0)="10.  Retrieve the file rmpf3_p1.zip and extract file ROES3.exe."
^DIC(9.4,147,22,2,"PAH",1,1,225,0)="     ROES3DeskTop.exe is not included in this patch because it is"
^DIC(9.4,147,22,2,"PAH",1,1,226,0)="     unchanged from the initial release."
^DIC(9.4,147,22,2,"PAH",1,1,227,0)=" "
^DIC(9.4,147,22,2,"PAH",1,1,228,0)="11.  Copy the ROES3.exe file over all existing copies of ROES3.exe"
^DIC(9.4,147,22,2,"PAH",1,1,229,0)="     currently used by any staff.  DO NOT copy it over any existing"
^DIC(9.4,147,22,2,"PAH",1,1,230,0)="     ROES3DeskTop.exe applications. The command line option from"
^DIC(9.4,147,22,2,"PAH",1,1,231,0)="     CPRS Tools should continue to work as intended, without further"
^DIC(9.4,147,22,2,"PAH",1,1,232,0)="     modification."
^DIC(9.4,147,22,2,"PAH",2,0)="4 SEQ #4^3130702.130327^17"
^DIC(9.4,147,22,2,"PAH",2,1,0)="^^226^226^3130702"
^DIC(9.4,147,22,2,"PAH",2,1,1,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,2,0)="This patch addresses several issues that have come up at the VA Medical "
^DIC(9.4,147,22,2,"PAH",2,1,3,0)="Centers since the first release of the ROES package. All issues addressed "
^DIC(9.4,147,22,2,"PAH",2,1,4,0)="in this patch are related to the ROES application that runs from the CPRS "
^DIC(9.4,147,22,2,"PAH",2,1,5,0)="Tools menu (ROES3.exe). The ROES Desktop application (ROES3Desktop.exe) "
^DIC(9.4,147,22,2,"PAH",2,1,6,0)="is only included for issues 2 and 3 below."
^DIC(9.4,147,22,2,"PAH",2,1,7,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,8,0)=" Issues addressed in this patch are:"
^DIC(9.4,147,22,2,"PAH",2,1,9,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,10,0)="1. As approved by the PSAS Program Office, all Veteran eligibility "
^DIC(9.4,147,22,2,"PAH",2,1,11,0)="determinations calculated by the software will be automatically "
^DIC(9.4,147,22,2,"PAH",2,1,12,0)="approved.  Veteran eligibility requests will no longer be sent to the "
^DIC(9.4,147,22,2,"PAH",2,1,13,0)="Prosthetic and Sensory Aids Service (PSAS) staff for approval.  Changes "
^DIC(9.4,147,22,2,"PAH",2,1,14,0)="in the background calculations for Veteran eligibility are detailed in "
^DIC(9.4,147,22,2,"PAH",2,1,15,0)="the Release Notes for this patch."
^DIC(9.4,147,22,2,"PAH",2,1,16,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,17,0)="2. For added security, the web connection has been changed from "
^DIC(9.4,147,22,2,"PAH",2,1,18,0)="clear http to secure http using the https protocol identifier."
^DIC(9.4,147,22,2,"PAH",2,1,19,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,20,0)="3. Adjustments were made for 64 bit terminal servers to access and "
^DIC(9.4,147,22,2,"PAH",2,1,21,0)="use the ROES web site."
^DIC(9.4,147,22,2,"PAH",2,1,22,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,23,0)="4. Connections from CPRS to the ROES web server will only be allowed to "
^DIC(9.4,147,22,2,"PAH",2,1,24,0)="actually enter the web site if they are from a VistA production account to"
^DIC(9.4,147,22,2,"PAH",2,1,25,0)="prevent false Veteran information from becoming a part of the national"
^DIC(9.4,147,22,2,"PAH",2,1,26,0)="database."
^DIC(9.4,147,22,2,"PAH",2,1,27,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,28,0)="5. Menu options, routines, remote procedure calls and security keys "
^DIC(9.4,147,22,2,"PAH",2,1,29,0)="from prior versions of ROES that are no longer needed will be removed."
^DIC(9.4,147,22,2,"PAH",2,1,30,0)="        Obsolete Options removed:  RMPFDE2 and RMPFDE4"
^DIC(9.4,147,22,2,"PAH",2,1,31,0)="        Obsolete Routines removed:  RMPFDE1,RMPFDE2,RMPFDE3 and RMPFDE4"
^DIC(9.4,147,22,2,"PAH",2,1,32,0)="        Obsolete Keys removed:  RMPF SUPERVISOR and RMPF SYSTEM MANAGER"
^DIC(9.4,147,22,2,"PAH",2,1,33,0)="        Obsolete Remote Procedures removed: RMPF ELIG MSG and RMPFELIG"
^DIC(9.4,147,22,2,"PAH",2,1,34,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,35,0)="6. Modifications for VistA and Delphi coding standards are included."
^DIC(9.4,147,22,2,"PAH",2,1,36,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,37,0)="7. Documentation has been updated regarding the removal of the "
^DIC(9.4,147,22,2,"PAH",2,1,38,0)="eligibility interactions before connecting to ROES."
^DIC(9.4,147,22,2,"PAH",2,1,39,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,40,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,41,0)=" Associated Remedy Tickets:"
^DIC(9.4,147,22,2,"PAH",2,1,42,0)=" ====================================== "
^DIC(9.4,147,22,2,"PAH",2,1,43,0)=" N/A"
^DIC(9.4,147,22,2,"PAH",2,1,44,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,45,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,46,0)=" E3R references addressed in this patch"
^DIC(9.4,147,22,2,"PAH",2,1,47,0)=" ======================================"
^DIC(9.4,147,22,2,"PAH",2,1,48,0)=" N/A"
^DIC(9.4,147,22,2,"PAH",2,1,49,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,50,0)=" Test Sites"
^DIC(9.4,147,22,2,"PAH",2,1,51,0)=" ========"
^DIC(9.4,147,22,2,"PAH",2,1,52,0)=" Miami "
^DIC(9.4,147,22,2,"PAH",2,1,53,0)=" Omaha"
^DIC(9.4,147,22,2,"PAH",2,1,54,0)=" Phoenix"
^DIC(9.4,147,22,2,"PAH",2,1,55,0)=" Columbia (SC)"
^DIC(9.4,147,22,2,"PAH",2,1,56,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,57,0)=" Required Builds"
^DIC(9.4,147,22,2,"PAH",2,1,58,0)=" ============="
^DIC(9.4,147,22,2,"PAH",2,1,59,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,60,0)=" RMPF*3.0*1"
^DIC(9.4,147,22,2,"PAH",2,1,61,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,62,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,63,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,64,0)=" This patch contains the following enhancements and problem resolutions:"
^DIC(9.4,147,22,2,"PAH",2,1,65,0)=" =========================================================="
^DIC(9.4,147,22,2,"PAH",2,1,66,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,67,0)=" The ROES application requires that the user's browser have JAVA"
^DIC(9.4,147,22,2,"PAH",2,1,68,0)=" available and enabled in order to function.  Sun has not developed a"
^DIC(9.4,147,22,2,"PAH",2,1,69,0)=" 64-bit version of JAVA, so on 64-bit terminal server installations the"
^DIC(9.4,147,22,2,"PAH",2,1,70,0)=" browser is not JAVA capable. This may prevent some ROES features from"
^DIC(9.4,147,22,2,"PAH",2,1,71,0)=" working properly. 64-bit installations also have a 32-bit browser"
^DIC(9.4,147,22,2,"PAH",2,1,72,0)=" which resides at a location different from the normal 32-bit location."
^DIC(9.4,147,22,2,"PAH",2,1,73,0)=" That new location is:"
^DIC(9.4,147,22,2,"PAH",2,1,74,0)="        C:\Program Files (x86)\Internet Explorer\IEXPLORE.EXE."
^DIC(9.4,147,22,2,"PAH",2,1,75,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,76,0)=" The ROES executables that connect to the internet application have been"
^DIC(9.4,147,22,2,"PAH",2,1,77,0)=" modified to check for the 32-bit Internet Explorer at that location."
^DIC(9.4,147,22,2,"PAH",2,1,78,0)=" This change will not affect any current 32-bit installations because, if "
^DIC(9.4,147,22,2,"PAH",2,1,79,0)=" Internet Explorer is not found at that location, ROES will look in the"
^DIC(9.4,147,22,2,"PAH",2,1,80,0)=" usual installation directories:"
^DIC(9.4,147,22,2,"PAH",2,1,81,0)="        C:\Program Files\Internet Explorer\IEXPLORE.EXE or"
^DIC(9.4,147,22,2,"PAH",2,1,82,0)="        C:\Program Files\PLUS!\Microsoft Internet\IEXPLORE.EXE"
^DIC(9.4,147,22,2,"PAH",2,1,83,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,84,0)=" On a 64-Bit installation, if the ROES application still does not work"
^DIC(9.4,147,22,2,"PAH",2,1,85,0)=" properly after installing the new executable, please ensure the path"
^DIC(9.4,147,22,2,"PAH",2,1,86,0)=" ""C:\Program Files (x86)\Internet Explorer\IEXPLORE.EXE"" does exist on"
^DIC(9.4,147,22,2,"PAH",2,1,87,0)=" the workstation."
^DIC(9.4,147,22,2,"PAH",2,1,88,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,89,0)=" All workstations accessing the ROES application from either CPRS or the"
^DIC(9.4,147,22,2,"PAH",2,1,90,0)=" desktop need to have the RPCBroker Listener running, as in the previous"
^DIC(9.4,147,22,2,"PAH",2,1,91,0)=" releases of ROES. Refer to the RPCBroker Installation Guide for further"
^DIC(9.4,147,22,2,"PAH",2,1,92,0)=" direction, if needed. It can be retrieved from http://www.domain.ext/vdl."
^DIC(9.4,147,22,2,"PAH",2,1,93,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,94,0)=" The following VistA routines have been modified to address new standards"
^DIC(9.4,147,22,2,"PAH",2,1,95,0)=" guidelines."
^DIC(9.4,147,22,2,"PAH",2,1,96,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,97,0)=" 1. RMPFRPC0 - Eligibility calculations were modified for new rules and"
^DIC(9.4,147,22,2,"PAH",2,1,98,0)="    categories and is now called directly from RMPFRPC1 instead of from"
^DIC(9.4,147,22,2,"PAH",2,1,99,0)="    remote procedure call RMPFELIG."
^DIC(9.4,147,22,2,"PAH",2,1,100,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,101,0)=" 2. RMPFRPC1 - DDC changed to DALC. Added check to see if running from a"
^DIC(9.4,147,22,2,"PAH",2,1,102,0)="    production account. Comments were added and clarified."
^DIC(9.4,147,22,2,"PAH",2,1,103,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,104,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,105,0)=" SOFTWARE RETRIEVAL:"
^DIC(9.4,147,22,2,"PAH",2,1,106,0)=" ====================="
^DIC(9.4,147,22,2,"PAH",2,1,107,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,108,0)=" The following software files are exported as part of this patch:"
^DIC(9.4,147,22,2,"PAH",2,1,109,0)="       "
^DIC(9.4,147,22,2,"PAH",2,1,110,0)="     File Name             Contents                         Transfer"
^DIC(9.4,147,22,2,"PAH",2,1,111,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,112,0)="     RMPF3_4.KID           VistA modifications              ASCII"
^DIC(9.4,147,22,2,"PAH",2,1,113,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,114,0)="     RMPF3_0P4.ZIP         Updated executables (354 KB)     BINARY"
^DIC(9.4,147,22,2,"PAH",2,1,115,0)="       Containing the following files:"
^DIC(9.4,147,22,2,"PAH",2,1,116,0)="       ROES3.exe           CPRS link to ROES web application     37 KB"
^DIC(9.4,147,22,2,"PAH",2,1,117,0)="       ROES3DeskTop.exe    Desktop link to ROES web application  708 KB"
^DIC(9.4,147,22,2,"PAH",2,1,118,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,119,0)="     RMPF3_0P4_DOC.ZIP     Updated documentation (1.816 MB) BINARY"
^DIC(9.4,147,22,2,"PAH",2,1,120,0)="       Containing the following files:"
^DIC(9.4,147,22,2,"PAH",2,1,121,0)="       RMPF3_0P4IG.PDF      Installation Guide"
^DIC(9.4,147,22,2,"PAH",2,1,122,0)="       RMPF3_0P4SG.PDF      Security Guide"
^DIC(9.4,147,22,2,"PAH",2,1,123,0)="       RMPF3_0P4TM.PDF      Technical Manual"
^DIC(9.4,147,22,2,"PAH",2,1,124,0)="       RMPF3_0P4UM.PDF      User Manual"
^DIC(9.4,147,22,2,"PAH",2,1,125,0)="       RMPF3_0P4RN.PDF      Release Notes"
^DIC(9.4,147,22,2,"PAH",2,1,126,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,127,0)=" The KIDS part of the patch will be distributed in a PackMan message. It "
^DIC(9.4,147,22,2,"PAH",2,1,128,0)=" and the zip file containing the executables can also be downloaded from"
^DIC(9.4,147,22,2,"PAH",2,1,129,0)=" the national download directory at:"
^DIC(9.4,147,22,2,"PAH",2,1,130,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,131,0)="     download.vista.domain.ext"
^DIC(9.4,147,22,2,"PAH",2,1,132,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,133,0)=" This site transmits the files from the first available FTP server.  "
^DIC(9.4,147,22,2,"PAH",2,1,134,0)=" Sites may also elect to retrieve software directly from a specific server"
^DIC(9.4,147,22,2,"PAH",2,1,135,0)=" as follows:"
^DIC(9.4,147,22,2,"PAH",2,1,136,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,137,0)=" OI FIELD OFFICE       FTP ADDRESS                     DIRECTORY"
^DIC(9.4,147,22,2,"PAH",2,1,138,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,139,0)=" Albany                ftp.fo-albany.domain.ext   anonymous.software"
^DIC(9.4,147,22,2,"PAH",2,1,140,0)=" Hines                 ftp.fo-hines.domain.ext    anonymous.software"
^DIC(9.4,147,22,2,"PAH",2,1,141,0)=" Salt Lake City        ftp.fo-slc.domain.ext      anonymous.software"
^DIC(9.4,147,22,2,"PAH",2,1,142,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,143,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,144,0)=" INSTALLATION INSTRUCTIONS:"
^DIC(9.4,147,22,2,"PAH",2,1,145,0)=" ========================="
^DIC(9.4,147,22,2,"PAH",2,1,146,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,147,0)=" Make a backup copy of the current ROES3.exe and ROES3Desktop.exe"
^DIC(9.4,147,22,2,"PAH",2,1,148,0)=" files (from a location where they currently are being used) to a"
^DIC(9.4,147,22,2,"PAH",2,1,149,0)=" backup location. Note the locations where all instances of those"
^DIC(9.4,147,22,2,"PAH",2,1,150,0)=" executables exist, for future maintenance."
^DIC(9.4,147,22,2,"PAH",2,1,151,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,152,0)=" All obsolete options, routines, remote procedure calls and files from"
^DIC(9.4,147,22,2,"PAH",2,1,153,0)=" previous ROES versions will be removed during the installation. The list"
^DIC(9.4,147,22,2,"PAH",2,1,154,0)=" items being removed is listed in the ROUTINE SUMMARY SECTION of the"
^DIC(9.4,147,22,2,"PAH",2,1,155,0)=" build."
^DIC(9.4,147,22,2,"PAH",2,1,156,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,157,0)=" Only ROES users need be off the system while ROES*3.0*4 is being"
^DIC(9.4,147,22,2,"PAH",2,1,158,0)=" installed. This patch should be installed during non-peak hours to"
^DIC(9.4,147,22,2,"PAH",2,1,159,0)=" minimize disruption. The total installation may take 15 minutes or more,"
^DIC(9.4,147,22,2,"PAH",2,1,160,0)=" depending on the CPRS Tools menu structure and number of ROES and"
^DIC(9.4,147,22,2,"PAH",2,1,161,0)=" ROES Desktop executables to update at your site. Be sure that the KIDS"
^DIC(9.4,147,22,2,"PAH",2,1,162,0)=" install (steps 1-9) are completed before updating the executables (steps"
^DIC(9.4,147,22,2,"PAH",2,1,163,0)=" 10-11). The KIDS install will run in less than 2 minutes."
^DIC(9.4,147,22,2,"PAH",2,1,164,0)="  "
^DIC(9.4,147,22,2,"PAH",2,1,165,0)=" Review your mapped set.  If the routines listed in the ROUTINE SUMMARY"
^DIC(9.4,147,22,2,"PAH",2,1,166,0)=" section of the build are mapped, they should be removed from the mapped"
^DIC(9.4,147,22,2,"PAH",2,1,167,0)=" set at this time."
^DIC(9.4,147,22,2,"PAH",2,1,168,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,169,0)="  1.  Choose the INSTALL/CHECK MESSAGE option on the PackMan menu. "
^DIC(9.4,147,22,2,"PAH",2,1,170,0)="      Answer YES to the prompt 'Want to Continue with Load? YES//'.  This"
^DIC(9.4,147,22,2,"PAH",2,1,171,0)="      will load the KIDS package onto your system."
^DIC(9.4,147,22,2,"PAH",2,1,172,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,173,0)="  2.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,147,22,2,"PAH",2,1,174,0)="      the Installation menu."
^DIC(9.4,147,22,2,"PAH",2,1,175,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,176,0)="  3.  From this menu, you may elect to use the following options (when"
^DIC(9.4,147,22,2,"PAH",2,1,177,0)="      prompted for INSTALL NAME, enter RMPF*3.0*4):"
^DIC(9.4,147,22,2,"PAH",2,1,178,0)="      a. Backup a Transport Global - this option will create a backup"
^DIC(9.4,147,22,2,"PAH",2,1,179,0)="         message of any routines exported with the patch. It will not"
^DIC(9.4,147,22,2,"PAH",2,1,180,0)="         backup any changes to DD's."
^DIC(9.4,147,22,2,"PAH",2,1,181,0)="      b. Compare Transport Global to Current System - this option will"
^DIC(9.4,147,22,2,"PAH",2,1,182,0)="         allow you to view all changes to routines that will be made "
^DIC(9.4,147,22,2,"PAH",2,1,183,0)="         when the patch is installed."
^DIC(9.4,147,22,2,"PAH",2,1,184,0)="      c. Verify Checksums in Transport Global - this option will allow you"
^DIC(9.4,147,22,2,"PAH",2,1,185,0)="         to ensure the integrity of the routines that are in the "
^DIC(9.4,147,22,2,"PAH",2,1,186,0)="         Transport Global."
^DIC(9.4,147,22,2,"PAH",2,1,187,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,188,0)="  4.  Then choose the Install Package(s) option and select RMPF*3.0*4."
^DIC(9.4,147,22,2,"PAH",2,1,189,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,190,0)="  5.  When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,147,22,2,"PAH",2,1,191,0)="      NO//"", respond NO (unless otherwise indicated)"
^DIC(9.4,147,22,2,"PAH",2,1,192,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,193,0)="  6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,147,22,2,"PAH",2,1,194,0)="      and Protocols? YES//', respond ""YES"". When prompted to select the"
^DIC(9.4,147,22,2,"PAH",2,1,195,0)="      options you would like to place out of order, enter the following:"
^DIC(9.4,147,22,2,"PAH",2,1,196,0)="           "
^DIC(9.4,147,22,2,"PAH",2,1,197,0)="             ROES3 OPTION ACCESS          [RMPF ROES3]"
^DIC(9.4,147,22,2,"PAH",2,1,198,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,199,0)="  7.  If prompted 'Enter protocols you wish to mark as 'Out of Order': "
^DIC(9.4,147,22,2,"PAH",2,1,200,0)="      press <return>."
^DIC(9.4,147,22,2,"PAH",2,1,201,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,202,0)="  8.  When prompted 'Delay Install (Minutes):  (0-60): 0//; respond '0.'"
^DIC(9.4,147,22,2,"PAH",2,1,203,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,204,0)="  9.  If you unmapped routines at the start, those SENT TO SITE"
^DIC(9.4,147,22,2,"PAH",2,1,205,0)="      should be returned to the mapped set once this part of the"
^DIC(9.4,147,22,2,"PAH",2,1,206,0)="      installation is complete."
^DIC(9.4,147,22,2,"PAH",2,1,207,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,208,0)=" 10.  Retrieve the file RMPF3_0P4.ZIP and extract files ROES3.exe and"
^DIC(9.4,147,22,2,"PAH",2,1,209,0)="      ROES3DeskTop.exe."
^DIC(9.4,147,22,2,"PAH",2,1,210,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,211,0)=" 11.  All existing instances of ROES3.exe and ROES3DeskTop.exe need to"
^DIC(9.4,147,22,2,"PAH",2,1,212,0)="      be replaced, regardless of whether they reside on server(s) or"
^DIC(9.4,147,22,2,"PAH",2,1,213,0)="      individual workstation(s)."
^DIC(9.4,147,22,2,"PAH",2,1,214,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,215,0)="      To do this, copy the new executable files to those locations,"
^DIC(9.4,147,22,2,"PAH",2,1,216,0)="      replacing the existing version. Take care NOT to inadvertently "
^DIC(9.4,147,22,2,"PAH",2,1,217,0)="      replace the ROES3.exe file with the ROES3DeskTop.exe file,"
^DIC(9.4,147,22,2,"PAH",2,1,218,0)="      or vice versa. When this is completed properly, the command line"
^DIC(9.4,147,22,2,"PAH",2,1,219,0)="      option from CPRS Tools and the desktop links to ROES should continue"
^DIC(9.4,147,22,2,"PAH",2,1,220,0)="      to work without any modifications."
^DIC(9.4,147,22,2,"PAH",2,1,221,0)=" "
^DIC(9.4,147,22,2,"PAH",2,1,222,0)=" If additional guidance is needed for the GUI installation, please refer"
^DIC(9.4,147,22,2,"PAH",2,1,223,0)=" to the ROES 3 Installation Guide on the System Design and Development "
^DIC(9.4,147,22,2,"PAH",2,1,224,0)=" web page at:  http://www.domain.ext/vdl. Within the Clinical section look for"
^DIC(9.4,147,22,2,"PAH",2,1,225,0)=" 'Remote Order Entry System (ROES)'.  Under that option you will find the"
^DIC(9.4,147,22,2,"PAH",2,1,226,0)=" Installation Guide, Security Guide, Technical Manual and User Manual."
^DIC(9.4,147,22,2,"PAH","B","1 SEQ #1",1)=""
