^DIC(9.4,111,22,1,"PAH",45,0)="51 SEQ #46^2980616^1"
^DIC(9.4,111,22,1,"PAH",45,1,0)="^^3^3^2980616"
^DIC(9.4,111,22,1,"PAH",45,1,1,0)="PCE patch 51, PX*1.0*51, clinical reminders. This patch adds a screen"
^DIC(9.4,111,22,1,"PAH",45,1,2,0)="to the APPLY LOGIC field to check for valid entries."
^DIC(9.4,111,22,1,"PAH",45,1,3,0)="See the National Patch Module for a complete description."
^DIC(9.4,111,22,1,"PAH",46,0)="54 SEQ #47^2980725^1"
