^DIC(9.4,177,22,3,"PAH",109,0)="108^3210713.092328^17"
^DIC(9.4,177,22,3,"PAH",109,1,0)="^^2^2^3210713"
^DIC(9.4,177,22,3,"PAH",109,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,177,22,3,"PAH",109,1,2,0)="under PSB*3*108."
^DIC(9.4,177,22,3,"PAH",110,0)="82b^3210809"
^DIC(9.4,177,22,3,"PAH",110,1,0)="^^5^5^3210809"
^DIC(9.4,177,22,3,"PAH",110,1,1,0)="Backup of PSB*3.0*82 on Aug 09, 2021"
^DIC(9.4,177,22,3,"PAH",110,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",110,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,177,22,3,"PAH",110,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,177,22,3,"PAH",110,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,177,22,3,"PAH",111,0)="82 SEQ #111^3210809.123957^17"
^DIC(9.4,177,22,3,"PAH",111,1,0)="^^6^6^3210809"
^DIC(9.4,177,22,3,"PAH",111,1,1,0)="The following enhancements were made in this patch:"
^DIC(9.4,177,22,3,"PAH",111,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",111,1,3,0)="1. The Status and Schedule Type will have their own columns with their"
^DIC(9.4,177,22,3,"PAH",111,1,4,0)="   values spelled out, e.g., G will be 'Given' and P will be 'PRN'."
^DIC(9.4,177,22,3,"PAH",111,1,5,0)="2. Units Ordered is being added as a new column."
^DIC(9.4,177,22,3,"PAH",111,1,6,0)="3. Previous statuses will be displayed in reverse chronological order."
^DIC(9.4,177,22,3,"PAH",112,0)="129^3210929.145044^17"
^DIC(9.4,177,22,3,"PAH",112,1,0)="^^16^16^3210929"
^DIC(9.4,177,22,3,"PAH",112,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,177,22,3,"PAH",112,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",112,1,3,0)="1) INC15616683 - BCMA (Bar Code Medication Administration) Backup (BCBU)"
^DIC(9.4,177,22,3,"PAH",112,1,4,0)="                 workstation patient prints out and order display is"
^DIC(9.4,177,22,3,"PAH",112,1,5,0)="                 incorrect for the field name ""SUPPLEMENTAL COMMENTS"""
^DIC(9.4,177,22,3,"PAH",112,1,6,0)="                 in BCMA BACKUP DATA file (#53.7)"
^DIC(9.4,177,22,3,"PAH",112,1,7,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",112,1,8,0)="--------"
^DIC(9.4,177,22,3,"PAH",112,1,9,0)="The Honolulu VA Pacific Islands Health Care System reported the Barcode "
^DIC(9.4,177,22,3,"PAH",112,1,10,0)="Backup (BCBU) is pulling information from vista incorrectly into the "
^DIC(9.4,177,22,3,"PAH",112,1,11,0)="BCMA BACKUP DATA file (#53.7) for the field name ""SUPPLEMENTAL COMMENTS""."
^DIC(9.4,177,22,3,"PAH",112,1,12,0)="This field contains all special instructions, provider comments, or other "
^DIC(9.4,177,22,3,"PAH",112,1,13,0)="print information pertinent to this order.  The NTE notes segment in the "
^DIC(9.4,177,22,3,"PAH",112,1,14,0)="HL7 message (i.e. ""NTE^6^L"" and ""NTE^21^L"") is not removing the data"
^DIC(9.4,177,22,3,"PAH",112,1,15,0)="correctly when it gets an update into the BCMA BACKUP DATA file (#53.7).  "
^DIC(9.4,177,22,3,"PAH",112,1,16,0)="This is the reason why it is displaying incorrectly in BCBU workstation.  "
^DIC(9.4,177,22,3,"PAH",113,0)="131 SEQ #113^3211012.113146^17"
^DIC(9.4,177,22,3,"PAH",113,1,0)="^^2^2^3211012"
^DIC(9.4,177,22,3,"PAH",113,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,177,22,3,"PAH",113,1,2,0)="under PSB*3*131."
^DIC(9.4,177,22,3,"PAH",114,0)="133 SEQ #114^3220103.124552^17"
^DIC(9.4,177,22,3,"PAH",114,1,0)="^^1^1^3220103"
^DIC(9.4,177,22,3,"PAH",114,1,1,0)="INC1980869 - BCMA Status code is not avaiable in BCMA for the MAH report"
^DIC(9.4,177,22,3,"PAH",115,0)="132 SEQ #115^3220126.113517^17"
^DIC(9.4,177,22,3,"PAH",115,1,0)="^^40^40^3220126"
^DIC(9.4,177,22,3,"PAH",115,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,177,22,3,"PAH",115,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,3,0)="1. INC19372204 - Missing ""B"" index for solution, Addictive in File 53.68"
^DIC(9.4,177,22,3,"PAH",115,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",115,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,8,0)="1.  INC19372204 - Missing ""B"" index for solution, Addictive in File 53.68"
^DIC(9.4,177,22,3,"PAH",115,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,10,0)="Problem:"
^DIC(9.4,177,22,3,"PAH",115,1,11,0)="--------"
^DIC(9.4,177,22,3,"PAH",115,1,12,0)="The ""B"" index for fields ADDITIVES or SOLUTIONS is not created when the "
^DIC(9.4,177,22,3,"PAH",115,1,13,0)="IEN of either is 1.  The ADDITIVES field points to the IV ADDITIVES file "
^DIC(9.4,177,22,3,"PAH",115,1,14,0)="#52.6 and the SOLUTIONS field points to the IV SOLUTIONS file #52.7.  In "
^DIC(9.4,177,22,3,"PAH",115,1,15,0)="routine PSBMD these fields are set to a value of 1 as a placeholder "
^DIC(9.4,177,22,3,"PAH",115,1,16,0)="before the filer routine (FILE^DIE) is called.  When the IEN of the field "
^DIC(9.4,177,22,3,"PAH",115,1,17,0)="is also 1 (pointer in file #52.6 or file #52.7) the index does not get "
^DIC(9.4,177,22,3,"PAH",115,1,18,0)="created because the filer routine doesn't detect a change and doesn't set "
^DIC(9.4,177,22,3,"PAH",115,1,19,0)="the index.  This issue was found while analyzing another ticket. "
^DIC(9.4,177,22,3,"PAH",115,1,20,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,21,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,22,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",115,1,23,0)="-----------"
^DIC(9.4,177,22,3,"PAH",115,1,24,0)="Routine PSBMD is modified to set the value of the placeholder to 0 "
^DIC(9.4,177,22,3,"PAH",115,1,25,0)="instead of 1.  This ensures that the filer routine will create the ""B"" "
^DIC(9.4,177,22,3,"PAH",115,1,26,0)="index correctly. "
^DIC(9.4,177,22,3,"PAH",115,1,27,0)=" "
^DIC(9.4,177,22,3,"PAH",115,1,28,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",115,1,29,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",115,1,30,0)="Lines modified: RPC+37, RPC+39, RPC+42, RPC+43"
^DIC(9.4,177,22,3,"PAH",115,1,31,0)="Before this patch these lines set the following"
^DIC(9.4,177,22,3,"PAH",115,1,32,0)="   ^PSB(53.68,+PSBIENS,.6,I,0)=I"
^DIC(9.4,177,22,3,"PAH",115,1,33,0)="   ^PSB(53.68,+PSBIENS,.7,I,0)=I"
^DIC(9.4,177,22,3,"PAH",115,1,34,0)="   ^PSB(53.68,+PSBIENS,.6,I,0)=X"
^DIC(9.4,177,22,3,"PAH",115,1,35,0)="   ^PSB(53.68,+PSBIENS,.7,I,0)=X"
^DIC(9.4,177,22,3,"PAH",115,1,36,0)="After the patch these lines set the following:"
^DIC(9.4,177,22,3,"PAH",115,1,37,0)="   ^PSB(53.68,+PSBIENS,.6,I,0)=0"
^DIC(9.4,177,22,3,"PAH",115,1,38,0)="   ^PSB(53.68,+PSBIENS,.7,I,0)=0"
^DIC(9.4,177,22,3,"PAH",115,1,39,0)="   ^PSB(53.68,+PSBIENS,.6,I,0)=0"
^DIC(9.4,177,22,3,"PAH",115,1,40,0)="   ^PSB(53.68,+PSBIENS,.7,I,0)=0"
^DIC(9.4,177,22,3,"PAH",116,0)="134 SEQ #116^3220315.1315^86"
^DIC(9.4,177,22,3,"PAH",116,1,0)="^^2^2^3220315"
^DIC(9.4,177,22,3,"PAH",116,1,1,0)="INC20442596 - Unable to generate Expired/DC'd/Expiring Order Report in "
^DIC(9.4,177,22,3,"PAH",116,1,2,0)="BCMA"
^DIC(9.4,177,22,3,"PAH",117,0)="135^3220811.151608^86"
^DIC(9.4,177,22,3,"PAH",117,1,0)="^^43^43^3220811"
^DIC(9.4,177,22,3,"PAH",117,1,1,0)="Description:"
^DIC(9.4,177,22,3,"PAH",117,1,2,0)="==========="
^DIC(9.4,177,22,3,"PAH",117,1,3,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,4,0)="This patch addresses the following issues:"
^DIC(9.4,177,22,3,"PAH",117,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,6,0)="1. INC21077835 - BCBU NOT SHOWING ACCURATE PRN MEDICATION EXPIRE DATE"
^DIC(9.4,177,22,3,"PAH",117,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,8,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,11,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",117,1,12,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,13,0)="1.  INC21077835 - BCBU NOT SHOWING ACCURATE PRN MEDICATION EXPIRE DATE"
^DIC(9.4,177,22,3,"PAH",117,1,14,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,15,0)="Problem:"
^DIC(9.4,177,22,3,"PAH",117,1,16,0)="--------"
^DIC(9.4,177,22,3,"PAH",117,1,17,0)="Patient with 2 PRN medications (both oral medications) set to expire "
^DIC(9.4,177,22,3,"PAH",117,1,18,0)="1/21/22@2359 printed contingency MAR that shows medication expires "
^DIC(9.4,177,22,3,"PAH",117,1,19,0)="1/20/22@2359.  Further testing showed that the same issue is seen with IV "
^DIC(9.4,177,22,3,"PAH",117,1,20,0)="orders."
^DIC(9.4,177,22,3,"PAH",117,1,21,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,22,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,23,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",117,1,24,0)="-----------"
^DIC(9.4,177,22,3,"PAH",117,1,25,0)="Modify routine ALPBFRM1 so that the column for the day of the stop will "
^DIC(9.4,177,22,3,"PAH",117,1,26,0)="not be asterisks."
^DIC(9.4,177,22,3,"PAH",117,1,27,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,28,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",117,1,29,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",117,1,30,0)="Routine ALPBFRM1 is modified as follows:"
^DIC(9.4,177,22,3,"PAH",117,1,31,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,32,0)="Line added at ADMTIM+16:"
^DIC(9.4,177,22,3,"PAH",117,1,33,0)=" . . S "
^DIC(9.4,177,22,3,"PAH",117,1,34,0)="ALPBNOAS=$S(ALPBPRNG:0,$$OTYP^ALPBUTL($P($G(DATA(3)),""^""))=""IV"":0,1:1)"
^DIC(9.4,177,22,3,"PAH",117,1,35,0)="This line sets ALPBNOAS to 0 when the order is PRN or IV"
^DIC(9.4,177,22,3,"PAH",117,1,36,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,37,0)="Line ADMTIM+17 is modified:"
^DIC(9.4,177,22,3,"PAH",117,1,38,0)="&ALPBNOAS is added to the IF condition so time is not stripped from "
^DIC(9.4,177,22,3,"PAH",117,1,39,0)="START/STOP times when the order is PRN or IV"
^DIC(9.4,177,22,3,"PAH",117,1,40,0)=" "
^DIC(9.4,177,22,3,"PAH",117,1,41,0)="Line ASTER+3 is modified:"
^DIC(9.4,177,22,3,"PAH",117,1,42,0)="&(ALPBNOAS) is added to the IF condition so that '******' is not "
^DIC(9.4,177,22,3,"PAH",117,1,43,0)="populated in the column on STOP day"
^DIC(9.4,177,22,3,"PAH",118,0)="93^3221005.145507^89"
^DIC(9.4,177,22,3,"PAH",118,1,0)="^^4^4^3221005"
^DIC(9.4,177,22,3,"PAH",118,1,1,0)="This build introduces changes to allow the BCMA GUI to display additional "
^DIC(9.4,177,22,3,"PAH",118,1,2,0)="allergy information in the Patient Allergy List, add the CPRS Order Check "
^DIC(9.4,177,22,3,"PAH",118,1,3,0)="to the Display Order report, and add remote allergies to the VDL "
^DIC(9.4,177,22,3,"PAH",118,1,4,0)="Allergies list."
^DIC(9.4,177,22,3,"PAH",119,0)="136 SEQ #120^3221214.13405^89"
^DIC(9.4,177,22,3,"PAH",119,1,0)="^^1^1^3221214"
^DIC(9.4,177,22,3,"PAH",119,1,1,0)="INC20967576 - Data is not showing in BCMA Medication History Report"
^DIC(9.4,177,22,3,"PAH",120,0)="139 SEQ #121^3221214.135211^89"
^DIC(9.4,177,22,3,"PAH",120,1,0)="^^1^1^3221214"
^DIC(9.4,177,22,3,"PAH",120,1,1,0)="INC23089823 - Error in BCMA Medication Overview Report"
^DIC(9.4,177,22,3,"PAH",121,0)="142 SEQ #122^3230817.111639^89"
^DIC(9.4,177,22,3,"PAH",121,1,0)="^^1^1^3230817"
^DIC(9.4,177,22,3,"PAH",121,1,1,0)="See FORUM patch description."
^DIC(9.4,177,22,3,"PAH",122,0)="140 SEQ #123^3240102.143956^89"
^DIC(9.4,177,22,3,"PAH",123,0)="144^3240125.115652^89"
^DIC(9.4,177,22,3,"PAH",123,1,0)="^^3^3^3240125"
^DIC(9.4,177,22,3,"PAH",123,1,1,0)="This patch addresses one issue:"
^DIC(9.4,177,22,3,"PAH",123,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",123,1,3,0)="Users with a future termination date are not allowed to access BCBU."
^DIC(9.4,177,22,3,"PAH",124,0)="145 SEQ #125^3240411.121547^89"
^DIC(9.4,177,22,3,"PAH",124,1,0)="^^34^34^3240411"
^DIC(9.4,177,22,3,"PAH",124,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",124,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",124,1,3,0)="1. INC30190209 - SATURDAY SCHEDULE PROMPT BCMA VDL TO ADMINISTER DRUG SAT "
^DIC(9.4,177,22,3,"PAH",124,1,4,0)="AND TUESDAY"
^DIC(9.4,177,22,3,"PAH",124,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",124,1,6,0)="Problem:"
^DIC(9.4,177,22,3,"PAH",124,1,7,0)="--------"
^DIC(9.4,177,22,3,"PAH",124,1,8,0)="SATURDAY, pharmacy standard schedule prompts BCMA Virtual Due List to "
^DIC(9.4,177,22,3,"PAH",124,1,9,0)="also administer the drug on Tuesday."
^DIC(9.4,177,22,3,"PAH",124,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",124,1,11,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",124,1,12,0)="-----------"
^DIC(9.4,177,22,3,"PAH",124,1,13,0)="The BCMA code (routine PSBVDLU1) was trying to decide if the med should "
^DIC(9.4,177,22,3,"PAH",124,1,14,0)="be given on Tuesday using the 2 letter code TU, the schedule name "
^DIC(9.4,177,22,3,"PAH",124,1,15,0)="SATURDAY contains TU and determines that it should be given on Tuesday, "
^DIC(9.4,177,22,3,"PAH",124,1,16,0)="which was incorrect.  The code is modified to prevent this from occurring."
^DIC(9.4,177,22,3,"PAH",124,1,17,0)=" "
^DIC(9.4,177,22,3,"PAH",124,1,18,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",124,1,19,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",124,1,20,0)="Lines OKAY+40 through OKAY+43 is changed from"
^DIC(9.4,177,22,3,"PAH",124,1,21,0)=" S PSBDOW=$P(""SU^MO^TU^WE^TH^FR^SA"",U,%Y+1) ;p145"
^DIC(9.4,177,22,3,"PAH",124,1,22,0)=" I $F(PSBSCH,PSBDOW)>0 S PSBOKAY=1 Q PSBOKAY"
^DIC(9.4,177,22,3,"PAH",124,1,23,0)=" S PSBOKAY=0"
^DIC(9.4,177,22,3,"PAH",124,1,24,0)=" Q PSBOKAY"
^DIC(9.4,177,22,3,"PAH",124,1,25,0)=" "
^DIC(9.4,177,22,3,"PAH",124,1,26,0)="To"
^DIC(9.4,177,22,3,"PAH",124,1,27,0)=" ;PSB*3*145 Prevent Saturday schedule from being given on Tuesday"
^DIC(9.4,177,22,3,"PAH",124,1,28,0)=" N PSBSCH1 S PSBSCH1=PSBSCH"
^DIC(9.4,177,22,3,"PAH",124,1,29,0)=" I PSBSCH1[""SATU"" S PSBSCH1=$TR(PSBSCH1,""SATU"",""SATA"")"
^DIC(9.4,177,22,3,"PAH",124,1,30,0)=" S PSBDOW=$P(""SU^MO^TU^WE^TH^FR^SA"",U,%Y+1)"
^DIC(9.4,177,22,3,"PAH",124,1,31,0)=" ;I $F(PSBSCH,PSBDOW)>0 S PSBOKAY=1 Q PSBOKAY"
^DIC(9.4,177,22,3,"PAH",124,1,32,0)=" I $F(PSBSCH1,PSBDOW)>0 S PSBOKAY=1 Q PSBOKAY"
^DIC(9.4,177,22,3,"PAH",124,1,33,0)=" S PSBOKAY=0"
^DIC(9.4,177,22,3,"PAH",124,1,34,0)=" Q PSBOKAY"
^DIC(9.4,177,22,3,"PAH",125,0)="147 SEQ #126^3240627.130317^89"
^DIC(9.4,177,22,3,"PAH",125,1,0)="^^1^1^3240627"
^DIC(9.4,177,22,3,"PAH",125,1,1,0)="INC30094266 - BCMA show ml/hl for unit dose tab."
