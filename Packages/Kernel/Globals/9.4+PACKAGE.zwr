^DIC(9.4,96,22,1.2,"PAH",23,1,94,0)="    99201   99202   99203   99204   99205   99211   99212   99213   99214"
^DIC(9.4,96,22,1.2,"PAH",23,1,95,0)="    99215   99241   99242   99243   99244   99245   99251   99252   99253"
