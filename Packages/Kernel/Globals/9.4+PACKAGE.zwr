^DIC(9.4,14,22,5.9,"PAH",10,1,398,0)="NUMBER: 657                             NAME: LAB DIV 600 OOS ID 108"
^DIC(9.4,14,22,5.9,"PAH",10,1,399,0)="  TYPE: CLINIC                          INSTITUTION: LONG BEACH, CA"
^DIC(9.4,14,22,5.9,"PAH",10,1,400,0)="  STOP CODE NUMBER: LABORATORY          SERVICE: NONE"
^DIC(9.4,14,22,5.9,"PAH",10,1,401,0)="  DIVISION: VA MEDICAL CENTER, LONG BEACH"
^DIC(9.4,14,22,5.9,"PAH",10,1,402,0)="  NON-COUNT CLINIC? (Y OR N): NO        CLINIC MEETS AT THIS FACILITY?:"
