^DIC(9.4,48,22,5.28,"PAH",374,1,2,0)="complete description of this patch."
^DIC(9.4,48,22,5.28,"PAH",375,0)="527 SEQ #425^3071212.220456^1"
^DIC(9.4,48,22,5.28,"PAH",375,1,0)="^^11^11^3071212"
^DIC(9.4,48,22,5.28,"PAH",375,1,1,0)=" This is an intermediate solution that has to prevent incorrect "
^DIC(9.4,48,22,5.28,"PAH",375,1,2,0)="inactivation."
^DIC(9.4,48,22,5.28,"PAH",375,1,3,0)=" Routines SCMCTSK1 and SCMCTSK2 are restored to their original code which"
^DIC(9.4,48,22,5.28,"PAH",375,1,4,0)=" will force the functionality being active before installation of"
^DIC(9.4,48,22,5.28,"PAH",375,1,5,0)=" patch SD*5.3*498."
^DIC(9.4,48,22,5.28,"PAH",375,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",375,1,7,0)=" Patients assigned to the Team Position with providers change will be"
^DIC(9.4,48,22,5.28,"PAH",375,1,8,0)=" excluded from evaluation for potential inactivation, as it was introduced"
^DIC(9.4,48,22,5.28,"PAH",375,1,9,0)=" with patch SD*5.3*297, and no patient will be incorrectly marked for"
^DIC(9.4,48,22,5.28,"PAH",375,1,10,0)=" inactivation. The checksum of both routines is the same as before "
^DIC(9.4,48,22,5.28,"PAH",375,1,11,0)="installation of patch SD*5.3*498."
^DIC(9.4,48,22,5.28,"PAH",376,0)="525 SEQ #426^3071212.22402^1"
^DIC(9.4,48,22,5.28,"PAH",376,1,0)="^^3^3^3071212"
^DIC(9.4,48,22,5.28,"PAH",376,1,1,0)="EWL ENROLLEE RE-CALCULATION. REPLACEMENT PATCH FOR SD*5.3*486 WHICH "
^DIC(9.4,48,22,5.28,"PAH",376,1,2,0)="ENTERED IN ERROR DUE TO A CORRUPT 'B' CROSS-REFERENCE IN EWL CLEAN-UP "
^DIC(9.4,48,22,5.28,"PAH",376,1,3,0)="file (#409.39)."
^DIC(9.4,48,22,5.28,"PAH",377,0)="510 SEQ #427^3080203.223242^1"
^DIC(9.4,48,22,5.28,"PAH",377,1,0)="^^3^3^3080203"
^DIC(9.4,48,22,5.28,"PAH",377,1,1,0)="Outpatient Encounter Workload Statistics report includes non-count clinic "
^DIC(9.4,48,22,5.28,"PAH",377,1,2,0)="encounters and it should not.  There is also a fix to the Trend of "
^DIC(9.4,48,22,5.28,"PAH",377,1,3,0)="Facility Uniques by 12 Month report for an <Undefined> error."
^DIC(9.4,48,22,5.28,"PAH",378,0)="521 SEQ #428^3080203.223657^1"
^DIC(9.4,48,22,5.28,"PAH",378,1,0)="^^1^1^3080203"
^DIC(9.4,48,22,5.28,"PAH",378,1,1,0)="Fix problem with ACRP transmission validation logic."
^DIC(9.4,48,22,5.28,"PAH",379,0)="531 SEQ #429^3080526.130802^1"
^DIC(9.4,48,22,5.28,"PAH",379,1,0)="^^2^2^3080526"
^DIC(9.4,48,22,5.28,"PAH",379,1,1,0)="FY08 Supplemental Update to the Clinic Stop (#40.7) file.  Adding 1 new "
^DIC(9.4,48,22,5.28,"PAH",379,1,2,0)="code."
^DIC(9.4,48,22,5.28,"PAH",380,0)="524 SEQ #430^3080526.151304^1"
^DIC(9.4,48,22,5.28,"PAH",380,1,0)="^^5^5^3080526"
^DIC(9.4,48,22,5.28,"PAH",380,1,1,0)="This patch address three enhancements to the EWL Wait List. First, a new "
^DIC(9.4,48,22,5.28,"PAH",380,1,2,0)="report is created to break down the wait list specialties/locations by "
^DIC(9.4,48,22,5.28,"PAH",380,1,3,0)="<30,>30, and >120 totals. Second, the Wait List Static report will "
^DIC(9.4,48,22,5.28,"PAH",380,1,4,0)="exclude 'PREVIOUS REMAINING' and '# REMAINING'. Finally, the EWL display "
^DIC(9.4,48,22,5.28,"PAH",380,1,5,0)="output will ask if only 'OPEN' entries are to be displayed."
^DIC(9.4,48,22,5.28,"PAH",381,0)="526 SEQ #431^3080526.151828^1"
^DIC(9.4,48,22,5.28,"PAH",382,0)="523 SEQ #432^3080526.155846^1"
^DIC(9.4,48,22,5.28,"PAH",382,1,0)="^^2^2^3080526"
^DIC(9.4,48,22,5.28,"PAH",382,1,1,0)="Fix several issues including problem with cancelling clinic availability, "
^DIC(9.4,48,22,5.28,"PAH",382,1,2,0)="the Clinic Assignment listing and the No Show report."
^DIC(9.4,48,22,5.28,"PAH",383,0)="499 SEQ #433^3080526.193656^1"
^DIC(9.4,48,22,5.28,"PAH",383,1,0)="^^6^6^3080526"
^DIC(9.4,48,22,5.28,"PAH",383,1,1,0)="This patch adresses the following PCMM issues:"
^DIC(9.4,48,22,5.28,"PAH",383,1,2,0)="- Proper unflagging both patients and providers if criteria are met"
^DIC(9.4,48,22,5.28,"PAH",383,1,3,0)="- Verification of patients assigned to a position with changed providers"
^DIC(9.4,48,22,5.28,"PAH",383,1,4,0)="- Multiple providers verification for a valid appointment"
^DIC(9.4,48,22,5.28,"PAH",383,1,5,0)="- Any scheduled time on the 15th and the last day of a month for the SCMC"
^DIC(9.4,48,22,5.28,"PAH",383,1,6,0)="  PCMM NIGHTLY TASK should generate expected messages. "
^DIC(9.4,48,22,5.28,"PAH",384,0)="529 SEQ #434^3080722.074414^1"
^DIC(9.4,48,22,5.28,"PAH",384,1,0)="^^2^2^3080722"
^DIC(9.4,48,22,5.28,"PAH",384,1,1,0)="Makes corrections to Remap a Clinic, Clinic Availability report, Clinic "
^DIC(9.4,48,22,5.28,"PAH",384,1,2,0)="Workload report and the Provider/Diagnosis report."
^DIC(9.4,48,22,5.28,"PAH",385,0)="520 SEQ #435^3080722.080819^1"
^DIC(9.4,48,22,5.28,"PAH",385,1,0)="^^4^4^3080722"
^DIC(9.4,48,22,5.28,"PAH",385,1,1,0)="This patch corrects"
^DIC(9.4,48,22,5.28,"PAH",385,1,2,0)="1 The Associated Clinic display for PCMM reports."
^DIC(9.4,48,22,5.28,"PAH",385,1,3,0)="2 The display of appointment information on PCMM reports."
^DIC(9.4,48,22,5.28,"PAH",385,1,4,0)="3 Correct lookup if position IEN is 1."
^DIC(9.4,48,22,5.28,"PAH",386,0)="458 SEQ #436^3090420.1606^1"
^DIC(9.4,48,22,5.28,"PAH",386,1,0)="^^23^23^3090420"
^DIC(9.4,48,22,5.28,"PAH",386,1,1,0)="This patch will correct a problem with the Patient Team/Position"
^DIC(9.4,48,22,5.28,"PAH",386,1,2,0)="assignments not showing correctly within the CPRS package. The following"
^DIC(9.4,48,22,5.28,"PAH",386,1,3,0)="error will also be fixed: <SUBSCRIPT>SORT+39^SCMCHLR2 while working in the"
^DIC(9.4,48,22,5.28,"PAH",386,1,4,0)="PCMM Error Processing option."
^DIC(9.4,48,22,5.28,"PAH",386,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",386,1,6,0)="The Outpatient Profile file (404.41) fields 201-204 will be distributed"
^DIC(9.4,48,22,5.28,"PAH",386,1,7,0)="with the proper documentation as currently it states incorrectly that"
^DIC(9.4,48,22,5.28,"PAH",386,1,8,0)="these fields are ""Not Implemented""."
^DIC(9.4,48,22,5.28,"PAH",386,1,9,0)=" "
^DIC(9.4,48,22,5.28,"PAH",386,1,10,0)="Additionally, the patch will update SD WAIT LIST REPORTS MENU with all"
^DIC(9.4,48,22,5.28,"PAH",386,1,11,0)="expected thirteen options. Five of them were unintentionally detached with"
^DIC(9.4,48,22,5.28,"PAH",386,1,12,0)="previously released patch SD*5.3*297."
^DIC(9.4,48,22,5.28,"PAH",386,1,13,0)=" "
^DIC(9.4,48,22,5.28,"PAH",386,1,14,0)="A problem with the Preceptor Link being updated correctly will also be "
^DIC(9.4,48,22,5.28,"PAH",386,1,15,0)="corrected. In some cases, the user receives a message that the Preceptor "
^DIC(9.4,48,22,5.28,"PAH",386,1,16,0)="Position requires a staff assignment. In other case, the user just isn't "
^DIC(9.4,48,22,5.28,"PAH",386,1,17,0)="allowed to remove the staff assignment or the preceptor assignment. The "
^DIC(9.4,48,22,5.28,"PAH",386,1,18,0)="confusion comes in as the Preceptor Team Position may be inactive but the "
^DIC(9.4,48,22,5.28,"PAH",386,1,19,0)="status of the Preceptor link may see it as active since it was not "
^DIC(9.4,48,22,5.28,"PAH",386,1,20,0)="updated correctly. Changes are not saved because the ""AD"" MUMPS "
^DIC(9.4,48,22,5.28,"PAH",386,1,21,0)="cross-reference is not being updated correctly. This cross-reference is "
^DIC(9.4,48,22,5.28,"PAH",386,1,22,0)="triggered by the PRECEPTOR TEAM POSITION (#.06) field of the PRECEPTOR "
^DIC(9.4,48,22,5.28,"PAH",386,1,23,0)="ASSIGNMENT HISTORY (#404.53) file."
^DIC(9.4,48,22,5.28,"PAH",387,0)="491 SEQ #437^3090421.140326^17"
^DIC(9.4,48,22,5.28,"PAH",387,1,0)="^^1^1^3090421"
^DIC(9.4,48,22,5.28,"PAH",387,1,1,0)="This patch addresses several EWL, PAIT, and Scheduling issues."
^DIC(9.4,48,22,5.28,"PAH",388,0)="537 SEQ #438^3090421.161626^17"
^DIC(9.4,48,22,5.28,"PAH",388,1,0)="^^2^2^3090421"
^DIC(9.4,48,22,5.28,"PAH",388,1,1,0)="Provide Fiscal Year 2009 updates to the CLINIC STOP (#40.7) file, as "
^DIC(9.4,48,22,5.28,"PAH",388,1,2,0)="requested by the Decision Support Services (DSS) office."
^DIC(9.4,48,22,5.28,"PAH",389,0)="530 SEQ #439^3090422.120411^17"
^DIC(9.4,48,22,5.28,"PAH",389,1,0)="^^7^7^3090422"
^DIC(9.4,48,22,5.28,"PAH",389,1,1,0)="Fix two <Undefined> errors which occur when running the ACRP Ad Hoc "
^DIC(9.4,48,22,5.28,"PAH",389,1,2,0)="Report with Current Enrollment Status or Perf Monitor Date Signed"
^DIC(9.4,48,22,5.28,"PAH",389,1,3,0)="as one of the Report Limitations."
^DIC(9.4,48,22,5.28,"PAH",389,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",389,1,5,0)="This patch also fixes a <SYNTAX> error which occurs when running the"
^DIC(9.4,48,22,5.28,"PAH",389,1,6,0)="ACRP Ad Hoc Report with Perf Monitor Acceptable Provider as one of the"
^DIC(9.4,48,22,5.28,"PAH",389,1,7,0)="Report Limitations."
^DIC(9.4,48,22,5.28,"PAH",390,0)="540 SEQ #440^3090422.120442^17"
^DIC(9.4,48,22,5.28,"PAH",390,1,0)="^^2^2^3090422"
^DIC(9.4,48,22,5.28,"PAH",390,1,1,0)="Fixes to the Clinic Utilization Statistical Summary and Clinic Workload "
^DIC(9.4,48,22,5.28,"PAH",390,1,2,0)="reports."
^DIC(9.4,48,22,5.28,"PAH",391,0)="505 SEQ #441^3090422.120844^17"
^DIC(9.4,48,22,5.28,"PAH",391,1,0)="^^1^1^3090422"
^DIC(9.4,48,22,5.28,"PAH",391,1,1,0)="PCMM Phase III Enhancements."
^DIC(9.4,48,22,5.28,"PAH",392,0)="533 SEQ #442^3090422.123954^17"
^DIC(9.4,48,22,5.28,"PAH",392,1,0)="^^3^3^3090422"
^DIC(9.4,48,22,5.28,"PAH",392,1,1,0)="This patch corrects the Appointment Listing, so that clinic names print "
^DIC(9.4,48,22,5.28,"PAH",392,1,2,0)="and also corrects Set Up a Clinic so that a Midnight to 8am clinic can be "
^DIC(9.4,48,22,5.28,"PAH",392,1,3,0)="set up."
^DIC(9.4,48,22,5.28,"PAH",393,0)="528 SEQ #443^3090422.1553^17"
^DIC(9.4,48,22,5.28,"PAH",393,1,0)="^^1^1^3090422"
^DIC(9.4,48,22,5.28,"PAH",393,1,1,0)="This patch addresses five fixes related to PCMM, EWL and PAIT. "
^DIC(9.4,48,22,5.28,"PAH",394,0)="534 SEQ #444^3090422.164158^17"
^DIC(9.4,48,22,5.28,"PAH",394,1,0)="^^11^11^3090422"
^DIC(9.4,48,22,5.28,"PAH",394,1,1,0)="This patch addresses several EWL, PCMM and Scheduling issues reported in "
^DIC(9.4,48,22,5.28,"PAH",394,1,2,0)="the following Remedy tickets, and update to PCMM and PAIT documentation."
^DIC(9.4,48,22,5.28,"PAH",394,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",394,1,4,0)="1)  HD0000000188897 - SD AMB PROC MGMT REPORT not accurate"
^DIC(9.4,48,22,5.28,"PAH",394,1,5,0)="2)  HD0000000192037 - Truncated text in file 44, Appointment,"
^DIC(9.4,48,22,5.28,"PAH",394,1,6,0)="                      Patient, OTHER fld 3"
^DIC(9.4,48,22,5.28,"PAH",394,1,7,0)="                238195 (d)"
^DIC(9.4,48,22,5.28,"PAH",394,1,8,0)="3)  HD0000000243629 - Incorrect person class"
^DIC(9.4,48,22,5.28,"PAH",394,1,9,0)="4)  HD0000000209762 - Rejection code 850 not in file 404.472"
^DIC(9.4,48,22,5.28,"PAH",394,1,10,0)="                230475 (d)"
^DIC(9.4,48,22,5.28,"PAH",394,1,11,0)="5)  HD0000000271138 - Existing PAIT documentation updates."
