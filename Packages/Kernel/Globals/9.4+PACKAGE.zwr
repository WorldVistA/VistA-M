^DIC(9.4,4,22,1,"PAH",100,1,3,0)="NOIS: MAD-0500-41856"
^DIC(9.4,4,22,1,"PAH",100,1,4,0)="Test Site:  Madison, WI"
^DIC(9.4,4,22,1,"PAH",100,1,5,0)="If a message with no text is received from a remote site, accept it, instead"
^DIC(9.4,4,22,1,"PAH",100,1,6,0)="of aborting."
^DIC(9.4,4,22,1,"PAH",100,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",100,1,8,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",100,1,9,0)="is at a minimum.  It requires MailMan patch XM*7.1*123."
^DIC(9.4,4,22,1,"PAH",100,1,10,0)="============================================================================ "
