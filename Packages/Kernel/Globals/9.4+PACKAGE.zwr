^DIC(9.4,3,22,21,"PAH",142,1,38,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",142,1,39,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",142,1,40,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,41,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",142,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,43,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",142,1,44,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",142,1,45,0)="     "
^DIC(9.4,3,22,21,"PAH",142,1,46,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",142,1,47,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",142,1,48,0)="     "
^DIC(9.4,3,22,21,"PAH",142,1,49,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",142,1,50,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",142,1,51,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",142,1,52,0)="      options:"
^DIC(9.4,3,22,21,"PAH",142,1,53,0)="      "
^DIC(9.4,3,22,21,"PAH",142,1,54,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",142,1,55,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",142,1,56,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",142,1,57,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",142,1,58,0)="     "
^DIC(9.4,3,22,21,"PAH",142,1,59,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",142,1,60,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",142,1,61,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",142,1,62,0)="      Taskman can remain running.      "
^DIC(9.4,3,22,21,"PAH",142,1,63,0)="     "
^DIC(9.4,3,22,21,"PAH",142,1,64,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",142,1,65,0)="      option:"
^DIC(9.4,3,22,21,"PAH",142,1,66,0)="        Install Package(s)  'XU*8.0*150'"
^DIC(9.4,3,22,21,"PAH",142,1,67,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",142,1,68,0)="                             "
^DIC(9.4,3,22,21,"PAH",142,1,69,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",142,1,70,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",142,1,71,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",142,1,72,0)="     "
^DIC(9.4,3,22,21,"PAH",142,1,73,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",142,1,74,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",142,1,75,0)=""
^DIC(9.4,3,22,21,"PAH",143,0)="178 SEQ #150^3001027^1"
^DIC(9.4,3,22,21,"PAH",143,1,0)="^^2^2^3001027"
^DIC(9.4,3,22,21,"PAH",143,1,1,0)="See patch XU*8*178 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",143,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",144,0)="149 SEQ #151^3001106^1"
^DIC(9.4,3,22,21,"PAH",144,1,0)="^^69^69^3001106"
^DIC(9.4,3,22,21,"PAH",144,1,1,0)="HUN-0800-22470  The change that patch XU*8*153 made to ""prohibited "
^DIC(9.4,3,22,21,"PAH",144,1,2,0)="BAY-0600-31674  times for sign-on"" did not work as planed. This patch"
^DIC(9.4,3,22,21,"PAH",144,1,3,0)="                also add a new message to tell the user that is blocked"
^DIC(9.4,3,22,21,"PAH",144,1,4,0)="                from sign-on what the prohibited time are."
^DIC(9.4,3,22,21,"PAH",144,1,5,0)="                "
^DIC(9.4,3,22,21,"PAH",144,1,6,0)="ANN-0598-41422  The message of ""No Access Allowed for this User"""
^DIC(9.4,3,22,21,"PAH",144,1,7,0)="                was not helpful so a new message has been added to "
^DIC(9.4,3,22,21,"PAH",144,1,8,0)="                the sign-on to report that the user doesn't have a"
^DIC(9.4,3,22,21,"PAH",144,1,9,0)="                PRIMARY MENU or KEY to assist IRM with evaluating"
^DIC(9.4,3,22,21,"PAH",144,1,10,0)="                user problems. Here is the new message:"
^DIC(9.4,3,22,21,"PAH",144,1,11,0)="                "
^DIC(9.4,3,22,21,"PAH",144,1,12,0)="     No PRIMARY MENU assigned to user or User is missing KEY to menu!"
^DIC(9.4,3,22,21,"PAH",144,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",144,1,14,0)="                "
^DIC(9.4,3,22,21,"PAH",144,1,15,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",144,1,16,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",144,1,17,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",144,1,18,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",144,1,19,0)=""
