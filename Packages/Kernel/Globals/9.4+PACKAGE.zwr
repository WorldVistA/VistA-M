^DIC(9.4,60,22,13,"PAH",584,1,145,0)="6. VistA Medication (Drug, Dosage, Qty, etc...) Suggestion"
^DIC(9.4,60,22,13,"PAH",584,1,146,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,147,0)="   When matching the eRx Drug to a corresponding VistA Drug before the "
^DIC(9.4,60,22,13,"PAH",584,1,148,0)="   user is prompted for the VistA entry it will first be presented with "
^DIC(9.4,60,22,13,"PAH",584,1,149,0)="   suggestion (if any) based on the following logic:"
^DIC(9.4,60,22,13,"PAH",584,1,150,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,151,0)="  - Once an eRx is accepted, it moves to the Pending Queue as a Pending Order."
^DIC(9.4,60,22,13,"PAH",584,1,152,0)="    After the Pending Order is finished it becomes an Active prescription. At"
^DIC(9.4,60,22,13,"PAH",584,1,153,0)="    this point the software will ""create a memory"" of how the prescription was"
^DIC(9.4,60,22,13,"PAH",584,1,154,0)="    entered (Drug, Dosage, Days Supply, Qty, # of refills, etc). "
^DIC(9.4,60,22,13,"PAH",584,1,155,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,156,0)="  - When a new eRx prescription is received for the same eRx Drug, NDC"
^DIC(9.4,60,22,13,"PAH",584,1,157,0)="    Code, SIG, Qty, Days Supply, # of Refills and Substitution allowance. the"
^DIC(9.4,60,22,13,"PAH",584,1,158,0)="    ""remembered"" VistA fields are then presented as suggestions for the"
^DIC(9.4,60,22,13,"PAH",584,1,159,0)="    user to select, as shown below (Validate Drug Screen - Edit action):"
^DIC(9.4,60,22,13,"PAH",584,1,160,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,161,0)="    Select Item(s): Next Screen// E   Edit  "
^DIC(9.4,60,22,13,"PAH",584,1,162,0)=" "
