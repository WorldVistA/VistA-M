^DIC(9.4,197,22,1,"PAH",27,1,1,0)="CLINICAL PROCEDURES TERMINOLOGY FILE UPDATES"
^DIC(9.4,197,22,1,"PAH",28,0)="42 SEQ #29^3160303.154325^54"
^DIC(9.4,197,22,1,"PAH",28,1,0)="^^196^196^3160303"
^DIC(9.4,197,22,1,"PAH",28,1,1,0)="Test patch MD*1.0*42 v2   August 18, 2015"
^DIC(9.4,197,22,1,"PAH",28,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,3,0)="======================================================"
^DIC(9.4,197,22,1,"PAH",28,1,4,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,5,0)="Description:"
^DIC(9.4,197,22,1,"PAH",28,1,6,0)="==========="
^DIC(9.4,197,22,1,"PAH",28,1,7,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,8,0)="The NSR20131203 Clinical Procedures Uni-directional Configuration Option "
^DIC(9.4,197,22,1,"PAH",28,1,9,0)="enhancement entails changing the current VistA functionality to add a "
^DIC(9.4,197,22,1,"PAH",28,1,10,0)="flag to the Clinical Procedures (CP) Instrument File so that CP will send "
^DIC(9.4,197,22,1,"PAH",28,1,11,0)="only an ""outbound"" Health Level 7 (HL7) message containing Computerized "
^DIC(9.4,197,22,1,"PAH",28,1,12,0)="Patient Record System (CPRS) patient information to the medical "
^DIC(9.4,197,22,1,"PAH",28,1,13,0)="instrument. The CP procedure is automatically placed in Completed status "
^DIC(9.4,197,22,1,"PAH",28,1,14,0)="after the HL7 message is sent, thus preventing an ""inbound"" HL7 message "
^DIC(9.4,197,22,1,"PAH",28,1,15,0)="containing the test results from being sent back to the CPRS Consult "
^DIC(9.4,197,22,1,"PAH",28,1,16,0)="Note.   "
^DIC(9.4,197,22,1,"PAH",28,1,17,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,18,0)="The physician can then edit the Consult Note by manually pasting in data "
^DIC(9.4,197,22,1,"PAH",28,1,19,0)="from a test result reporting system to complete the Consult.  "
^DIC(9.4,197,22,1,"PAH",28,1,20,0)="This modification is beneficial for users of reporting systems-such as "
^DIC(9.4,197,22,1,"PAH",28,1,21,0)="the Clinical Assessment, Reporting, and Tracking System for Cardiac "
^DIC(9.4,197,22,1,"PAH",28,1,22,0)="Catheterization Laboratories (CART-CL) application-who do not want the "
^DIC(9.4,197,22,1,"PAH",28,1,23,0)="test results from the medical instrument to populate the CPRS Consult "
^DIC(9.4,197,22,1,"PAH",28,1,24,0)="Note, but prefer to manually paste the test results from the reporting "
^DIC(9.4,197,22,1,"PAH",28,1,25,0)="system into the Consult Note.  "
^DIC(9.4,197,22,1,"PAH",28,1,26,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,27,0)="The CONSULT KEEP OPEN field in the CP INSTRUMENT File (#702.09) must be "
^DIC(9.4,197,22,1,"PAH",28,1,28,0)="set to Yes for this functionality to work.  This triggers the routines "
^DIC(9.4,197,22,1,"PAH",28,1,29,0)="that put the CP procedure in Completed status to interrupt the "
^DIC(9.4,197,22,1,"PAH",28,1,30,0)="bi-directional flow."
^DIC(9.4,197,22,1,"PAH",28,1,31,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,32,0)=" "
