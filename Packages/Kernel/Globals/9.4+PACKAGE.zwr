^DIC(9.4,107,0)="GEN. MED. REC. - GENERATOR^GMRG^TEXT GENERATOR"
^DIC(9.4,107,1,0)="^^11^11^2950829^^^^"
^DIC(9.4,107,1,1,0)="The Text Generator allows for the codifying/boilerplating of clinical"
^DIC(9.4,107,1,2,0)="forms.  Patient data for these forms are then collected via a menu driven"
^DIC(9.4,107,1,3,0)="data entry system.  Output is generated from this collection in an"
^DIC(9.4,107,1,4,0)="outline or paragraph format.  There are two major components to the Text"
^DIC(9.4,107,1,5,0)="Generator:  1) Content Building, and  2) Patient Data Enter/Edit.  The"
^DIC(9.4,107,1,6,0)="data reporting mechanism is currently a part of the Patient Data"
^DIC(9.4,107,1,7,0)="Enter/Edit, but will become its own component in the future.  The Text"
^DIC(9.4,107,1,8,0)="Generator is currently used by the Nursing Package to generate Nursing"
^DIC(9.4,107,1,9,0)="Care Plans.  Future plans include the use by Mental Health for the"
^DIC(9.4,107,1,10,0)="development of treatment plans, and as a front end to generate progress"
^DIC(9.4,107,1,11,0)="notes for patients."
^DIC(9.4,107,4,0)="^9.44PA^4^4"
^DIC(9.4,107,4,1,0)=124.2
