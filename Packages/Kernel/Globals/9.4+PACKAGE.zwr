^DIC(9.4,164,22,1,"PAH",157,0)="172 SEQ #158^3131212.141131^17"
^DIC(9.4,164,22,1,"PAH",157,1,0)="^^2^2^3131212"
^DIC(9.4,164,22,1,"PAH",157,1,1,0)="IMR6 - HIGH RISK/ALERT MEDICATION FIELD ADDED TO PHARMACY ORDERABLE ITEM "
^DIC(9.4,164,22,1,"PAH",157,1,2,0)="FILE #50.7"
^DIC(9.4,164,22,1,"PAH",158,0)="160^3140407.172255^17"
^DIC(9.4,164,22,1,"PAH",158,1,0)="^^73^73^3140407"
^DIC(9.4,164,22,1,"PAH",158,1,1,0)="This patch will activate the new Dosing Order Check functionality for"
^DIC(9.4,164,22,1,"PAH",158,1,2,0)="Single Dose checking only for Inpatient Medications, Outpatient Pharmacy,"
^DIC(9.4,164,22,1,"PAH",158,1,3,0)="and Computerized Patient Record System (CPRS). A message will be displayed"
^DIC(9.4,164,22,1,"PAH",158,1,4,0)="to the user if the Single Dose entered for the medication order and all"
^DIC(9.4,164,22,1,"PAH",158,1,5,0)="the other pertinent data is able to be properly converted for a valid"
^DIC(9.4,164,22,1,"PAH",158,1,6,0)="Dosing Check, and the result is an out-of-range warning. An error message"
^DIC(9.4,164,22,1,"PAH",158,1,7,0)="will be displayed if for any reason the Single Dose check cannot be "
^DIC(9.4,164,22,1,"PAH",158,1,8,0)="performed."
^DIC(9.4,164,22,1,"PAH",158,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",158,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",158,1,11,0)="This patch addresses the following New Service Request (NSR):"
^DIC(9.4,164,22,1,"PAH",158,1,12,0)="-------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",158,1,13,0)="There is no NSR associated with this patch. "
^DIC(9.4,164,22,1,"PAH",158,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",158,1,15,0)=" "
