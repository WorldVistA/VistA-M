^DIC(9.4,52,22,29,0)="5.1^3051119^3001027^1"
^DIC(9.4,52,22,29,1,0)="^^2^2^3051119"
^DIC(9.4,52,22,29,1,1,0)="This KIDS Build contains the definition for maintenance release IFCAP"
^DIC(9.4,52,22,29,1,2,0)="v 5.1."
^DIC(9.4,52,22,29,"PAH",0)="^9.4901^208^208"
^DIC(9.4,52,22,29,"PAH",1,0)="7 SEQ #2^3010202^1"
^DIC(9.4,52,22,29,"PAH",1,1,0)="^^5^5^3010202"
^DIC(9.4,52,22,29,"PAH",1,1,1,0)="This patch resolves various problems associated with Purchase Orders and"
^DIC(9.4,52,22,29,"PAH",1,1,2,0)="the use of vendors on those orders.  It also addresses shortcomings in"
^DIC(9.4,52,22,29,"PAH",1,1,3,0)="Vendor entry/edit as well as device selection during the printing of"
^DIC(9.4,52,22,29,"PAH",1,1,4,0)="Purchase Orders.  NOIS addressed are ISW-1000-20548, UNY-0500-12573,"
^DIC(9.4,52,22,29,"PAH",1,1,5,0)="SPO-0200-52561 and POR-0600-50419."
^DIC(9.4,52,22,29,"PAH",2,0)="6 SEQ #3^3010228^1"
^DIC(9.4,52,22,29,"PAH",2,1,0)="^^22^22^3010228"
^DIC(9.4,52,22,29,"PAH",2,1,1,0)="This patch resolves the following 2 NOIS:"
^DIC(9.4,52,22,29,"PAH",2,1,2,0)="     1. CTX-0296-70401 (Amendment for Line Item Edit)"
^DIC(9.4,52,22,29,"PAH",2,1,3,0)="     2. NCH-0998-41392 (undef QQ^PRCHAMYA)"
^DIC(9.4,52,22,29,"PAH",2,1,4,0)=""
^DIC(9.4,52,22,29,"PAH",2,1,5,0)="======================================================================"
^DIC(9.4,52,22,29,"PAH",2,1,6,0)=""
^DIC(9.4,52,22,29,"PAH",2,1,7,0)="PROBLEM:"
^DIC(9.4,52,22,29,"PAH",2,1,8,0)="CTX-0296-70401 (Amendment for Line Item Edit)"
^DIC(9.4,52,22,29,"PAH",2,1,9,0)="    PO item descriptions were amended, but the new description"
^DIC(9.4,52,22,29,"PAH",2,1,10,0)="    did not display on the PO."
^DIC(9.4,52,22,29,"PAH",2,1,11,0)=""
^DIC(9.4,52,22,29,"PAH",2,1,12,0)="SOLUTION:"
^DIC(9.4,52,22,29,"PAH",2,1,13,0)="   Modify routine PRCHAMYA"
^DIC(9.4,52,22,29,"PAH",2,1,14,0)=""
^DIC(9.4,52,22,29,"PAH",2,1,15,0)="======================================================================"
^DIC(9.4,52,22,29,"PAH",2,1,16,0)=""
^DIC(9.4,52,22,29,"PAH",2,1,17,0)="PROBLEM:"
^DIC(9.4,52,22,29,"PAH",2,1,18,0)="NCH-0998-41392 (undef QQ^PRCHAMYA)"
^DIC(9.4,52,22,29,"PAH",2,1,19,0)="    Undefined error occurred because the array DIR(A) does not exist."
^DIC(9.4,52,22,29,"PAH",2,1,20,0)=""
^DIC(9.4,52,22,29,"PAH",2,1,21,0)="SOLUTION:"
^DIC(9.4,52,22,29,"PAH",2,1,22,0)="    The DIR(A) array should be DIR(""A"")."
^DIC(9.4,52,22,29,"PAH",3,0)="5 SEQ #4^3010228^1"
^DIC(9.4,52,22,29,"PAH",3,1,0)="^^9^9^3010228"
^DIC(9.4,52,22,29,"PAH",3,1,1,0)="This patch restores the link between the Deactivate a User [XUSERDEACT]"
^DIC(9.4,52,22,29,"PAH",3,1,2,0)="option, and the IFCAP application.  This link was severed by Kernel patch"
^DIC(9.4,52,22,29,"PAH",3,1,3,0)="XU*8*117.  A new action type option named PRCS TERMINATE was created."
^DIC(9.4,52,22,29,"PAH",3,1,4,0)="It has been linked with the Kernel 'extended action' option XU USER TERMINATE."
^DIC(9.4,52,22,29,"PAH",3,1,5,0)="This link is needed so that a terminated user is removed from all IFCAP"
^DIC(9.4,52,22,29,"PAH",3,1,6,0)="control points."
^DIC(9.4,52,22,29,"PAH",3,1,7,0)=""
^DIC(9.4,52,22,29,"PAH",3,1,8,0)="This patch also ensures that deactivated users within multiple stations are"
^DIC(9.4,52,22,29,"PAH",3,1,9,0)="removed from all control points."
^DIC(9.4,52,22,29,"PAH",4,0)="1 SEQ #5^3010228^1"
^DIC(9.4,52,22,29,"PAH",4,1,0)="^^3^3^3010228"
^DIC(9.4,52,22,29,"PAH",4,1,1,0)="This patch contains all of the components necessary to add the inventory"
^DIC(9.4,52,22,29,"PAH",4,1,2,0)="interface that allows GIP to communicate with purchased/rented supply"
^DIC(9.4,52,22,29,"PAH",4,1,3,0)="stations."
^DIC(9.4,52,22,29,"PAH",5,0)="9 SEQ #6^3010228^1"
^DIC(9.4,52,22,29,"PAH",5,1,0)="^^7^7^3010228"
^DIC(9.4,52,22,29,"PAH",5,1,1,0)="Update for clause 52.219-1 (Oct. 2000)"
^DIC(9.4,52,22,29,"PAH",5,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",5,1,3,0)="12/20/2000: Modified routine PRCHP184 to reformat the clause 52.219-1."
^DIC(9.4,52,22,29,"PAH",5,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",5,1,5,0)="01/08/2001: Modified routine PRCHP184 to reformat the clause 52.219-1."
^DIC(9.4,52,22,29,"PAH",5,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",5,1,7,0)="02/27/2001: Added ""**"" to the 2nd line."
^DIC(9.4,52,22,29,"PAH",6,0)="15 SEQ #7^3010319^1"
^DIC(9.4,52,22,29,"PAH",6,1,0)="^^22^22^3010319"
^DIC(9.4,52,22,29,"PAH",6,1,1,0)="This patch resolves the following two NOIS(s)."
^DIC(9.4,52,22,29,"PAH",6,1,2,0)="1. GRJ-1199-52228"
^DIC(9.4,52,22,29,"PAH",6,1,3,0)="2. PRO-1100-12536"
^DIC(9.4,52,22,29,"PAH",6,1,4,0)=""
^DIC(9.4,52,22,29,"PAH",6,1,5,0)="=============================================================================="
^DIC(9.4,52,22,29,"PAH",6,1,6,0)=""
^DIC(9.4,52,22,29,"PAH",6,1,7,0)="NOIS             DESCRIPTION"
^DIC(9.4,52,22,29,"PAH",6,1,8,0)="----             -----------"
^DIC(9.4,52,22,29,"PAH",6,1,9,0)="GRJ-1199-52228   Problem with Incomplete Purchase Orders.  If a user exits"
^DIC(9.4,52,22,29,"PAH",6,1,10,0)="                 the New Purchase Order option before an authorized buyer"
^DIC(9.4,52,22,29,"PAH",6,1,11,0)="                 is entered, then the PO will not appear an the Incomplete"
^DIC(9.4,52,22,29,"PAH",6,1,12,0)="                 Purchase Orders Report."
^DIC(9.4,52,22,29,"PAH",6,1,13,0)=""
^DIC(9.4,52,22,29,"PAH",6,1,14,0)=""
^DIC(9.4,52,22,29,"PAH",6,1,15,0)="NOIS             DESCRIPTION"
^DIC(9.4,52,22,29,"PAH",6,1,16,0)="----             -----------"
^DIC(9.4,52,22,29,"PAH",6,1,17,0)="PRO-1100-12536    If 2 new purchase orders are entered for the same item on"
^DIC(9.4,52,22,29,"PAH",6,1,18,0)="                  the same day with the same control point, only one of these"
^DIC(9.4,52,22,29,"PAH",6,1,19,0)="                  purchase orders will appear on the HISTORY OF ITEM DISPLAY"
^DIC(9.4,52,22,29,"PAH",6,1,20,0)="                  report."
^DIC(9.4,52,22,29,"PAH",6,1,21,0)="=============================================================================="
^DIC(9.4,52,22,29,"PAH",6,1,22,0)=""
^DIC(9.4,52,22,29,"PAH",7,0)="12 SEQ #8^3010319^1"
^DIC(9.4,52,22,29,"PAH",7,1,0)="^^1^1^3010319"
^DIC(9.4,52,22,29,"PAH",7,1,1,0)="Fix error in [PRCP UNDO CONVERSION]"
^DIC(9.4,52,22,29,"PAH",8,0)="4 SEQ #9^3010326^1"
^DIC(9.4,52,22,29,"PAH",8,1,0)="^^1^1^3010326"
^DIC(9.4,52,22,29,"PAH",8,1,1,0)="ISSUE BOOK SOFTWARE CHANGES"
^DIC(9.4,52,22,29,"PAH",9,0)="17 SEQ #10^3010326^1"
^DIC(9.4,52,22,29,"PAH",9,1,0)="^^1^1^3010326"
^DIC(9.4,52,22,29,"PAH",9,1,1,0)="LINKS FSC TO STOCK STATUS REPORT"
^DIC(9.4,52,22,29,"PAH",10,0)="20 SEQ #11^3010412^1"
^DIC(9.4,52,22,29,"PAH",10,1,0)="^^1^1^3010412"
^DIC(9.4,52,22,29,"PAH",10,1,1,0)="Build for patch PRC*5.1*20."
^DIC(9.4,52,22,29,"PAH",11,0)="11 SEQ #12^3010507^1"
^DIC(9.4,52,22,29,"PAH",11,1,0)="^^1^1^3010507"
^DIC(9.4,52,22,29,"PAH",11,1,1,0)="This patch will fix the problem with Item Display menu option."
^DIC(9.4,52,22,29,"PAH",12,0)="8 SEQ #13^3010529^1"
^DIC(9.4,52,22,29,"PAH",12,1,0)="^^1^1^3010529"
^DIC(9.4,52,22,29,"PAH",12,1,1,0)="Build for PRC*5.1*8, DDC and SAMS access to Purchase Card information."
^DIC(9.4,52,22,29,"PAH",13,0)="29 SEQ #14^3010608^1"
^DIC(9.4,52,22,29,"PAH",13,1,0)="^^1^1^3010608"
^DIC(9.4,52,22,29,"PAH",13,1,1,0)="Extract IFCAP user counts by roles."
^DIC(9.4,52,22,29,"PAH",14,0)="3 SEQ #15^3010608^1"
^DIC(9.4,52,22,29,"PAH",14,1,0)="^^2^2^3010608"
^DIC(9.4,52,22,29,"PAH",14,1,1,0)="12/08/2000:"
^DIC(9.4,52,22,29,"PAH",14,1,2,0)="This patch will fix the problem with Selected Control Points Menu Option."
^DIC(9.4,52,22,29,"PAH",15,0)="28 SEQ #16^3010608^1"
^DIC(9.4,52,22,29,"PAH",15,1,0)="^^4^4^3010608"
^DIC(9.4,52,22,29,"PAH",15,1,1,0)="This patch will correct the problem of being able to edit a substation in"
^DIC(9.4,52,22,29,"PAH",15,1,2,0)="the Site Parameters menu option.  It also contains a change that will not"
^DIC(9.4,52,22,29,"PAH",15,1,3,0)="allow a user to enter a different station ID at the STATION NUMBER and"
^DIC(9.4,52,22,29,"PAH",15,1,4,0)="STATION prompt in the same menu option."
^DIC(9.4,52,22,29,"PAH",16,0)="16 SEQ #17^3010625^1"
^DIC(9.4,52,22,29,"PAH",16,1,0)="^^1^1^3010625"
^DIC(9.4,52,22,29,"PAH",16,1,1,0)="Build for New Socioeconomic Groups."
^DIC(9.4,52,22,29,"PAH",17,0)="18 SEQ #18^3010625^1"
^DIC(9.4,52,22,29,"PAH",17,1,0)="^^1^1^3010625"
^DIC(9.4,52,22,29,"PAH",17,1,1,0)="Build for 'AMENDING A PC ORDER STATUS'."
^DIC(9.4,52,22,29,"PAH",18,0)="22 SEQ #19^3010802^1"
^DIC(9.4,52,22,29,"PAH",18,1,0)="^^1^1^3010802"
^DIC(9.4,52,22,29,"PAH",18,1,1,0)="Extended receipt totals; Delivery Order errors"
^DIC(9.4,52,22,29,"PAH",19,0)="25 SEQ #20^3010802^1"
^DIC(9.4,52,22,29,"PAH",19,1,0)="^^1^1^3010802"
^DIC(9.4,52,22,29,"PAH",19,1,1,0)="Build for PRC*5.1*25, 'Purchase Card Transactions on Build Lists'."
^DIC(9.4,52,22,29,"PAH",20,0)="14 SEQ #21^3010802^1"
^DIC(9.4,52,22,29,"PAH",20,1,0)="^^3^3^3010802"
^DIC(9.4,52,22,29,"PAH",20,1,1,0)="This patch resolves a variety of print issues: adjustment voucher printing"
^DIC(9.4,52,22,29,"PAH",20,1,2,0)="problems, <UNDEFINED> errors and print device handling at integrated sites"
^DIC(9.4,52,22,29,"PAH",20,1,3,0)="utilizing substation functionality."
^DIC(9.4,52,22,29,"PAH",21,0)="32 SEQ #22^3010815^1"
^DIC(9.4,52,22,29,"PAH",21,1,0)="^^1^1^3010815"
^DIC(9.4,52,22,29,"PAH",21,1,1,0)="PATIENT DISTRIBUTION COST REPORT FIX"
^DIC(9.4,52,22,29,"PAH",22,0)="33 SEQ #23^3010815^1"
^DIC(9.4,52,22,29,"PAH",22,1,0)="^^1^1^3010815"
^DIC(9.4,52,22,29,"PAH",22,1,1,0)="FIX LAST DATE RECEIVED IN POST"
^DIC(9.4,52,22,29,"PAH",23,0)="27 SEQ #24^3010906^1"
^DIC(9.4,52,22,29,"PAH",23,1,0)="^^2^2^3010906"
^DIC(9.4,52,22,29,"PAH",23,1,1,0)="FIXES FOR USAGE DEMAND ITEM REPORT AND NO PROGRAM ERRORS; ADD PAGE BREAK"
^DIC(9.4,52,22,29,"PAH",23,1,2,0)="BETWEEN CASE CARTS AND INSTRUMENT KITS"
^DIC(9.4,52,22,29,"PAH",24,0)="31 SEQ #25^3010926^1"
^DIC(9.4,52,22,29,"PAH",24,1,0)="^^2^2^3010926"
^DIC(9.4,52,22,29,"PAH",24,1,1,0)="This patch will fix the problem with PPM Status of Transaction Report"
^DIC(9.4,52,22,29,"PAH",24,1,2,0)="and problem with selected Fund Control Point menu option."
^DIC(9.4,52,22,29,"PAH",25,0)="24 SEQ #26^3011016^1"
^DIC(9.4,52,22,29,"PAH",25,1,0)="^^9^9^3011016"
^DIC(9.4,52,22,29,"PAH",25,1,1,0)="This patch contains enhancements and bug fixes to the Point of Use"
^DIC(9.4,52,22,29,"PAH",25,1,2,0)="interface.  It enhances the interface by allowing GIP on-hand totals to"
^DIC(9.4,52,22,29,"PAH",25,1,3,0)="automatically match what is in the supply station.  This functionality"
^DIC(9.4,52,22,29,"PAH",25,1,4,0)="requires a single request per one-time adjustment."
^DIC(9.4,52,22,29,"PAH",25,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",25,1,6,0)="The fixes are to an undef error in PRCPHLPO occuring when the order is"
^DIC(9.4,52,22,29,"PAH",25,1,7,0)="deleted prior to its refill transaction updating the GIP files and to"
^DIC(9.4,52,22,29,"PAH",25,1,8,0)="enable the item update transactions to build 'add' transactions when they"
^DIC(9.4,52,22,29,"PAH",25,1,9,0)="are requested."
^DIC(9.4,52,22,29,"PAH",26,0)="35 SEQ #27^3011016^1"
^DIC(9.4,52,22,29,"PAH",26,1,0)="^^1^1^3011016"
^DIC(9.4,52,22,29,"PAH",26,1,1,0)="Build for patch PRC*5.1*35, Unapproved Reconciliations."
^DIC(9.4,52,22,29,"PAH",27,0)="39 SEQ #28^3011106^1"
^DIC(9.4,52,22,29,"PAH",27,1,0)="^^7^7^3011106"
^DIC(9.4,52,22,29,"PAH",27,1,1,0)="This patch resolves a problem created by IFCAP patch PRC*5.1*28.  At the"
^DIC(9.4,52,22,29,"PAH",27,1,2,0)="'STATION NUMBER:' prompt in the Site Parameters [PRCH SITE EDIT] menu"
^DIC(9.4,52,22,29,"PAH",27,1,3,0)="option, if a user enters ""???"" or any combination thereof, a list of"
^DIC(9.4,52,22,29,"PAH",27,1,4,0)="available station numbers does not display.  Instead, the only data that"
^DIC(9.4,52,22,29,"PAH",27,1,5,0)="displays is the help text.  Patch PRC*5.1*39 corrects this so that the"
^DIC(9.4,52,22,29,"PAH",27,1,6,0)="available station numbers will now display when ""?"" or ""??"" or ""???"" is"
^DIC(9.4,52,22,29,"PAH",27,1,7,0)="entered."
^DIC(9.4,52,22,29,"PAH",28,0)="40 SEQ #29^3011121^1"
^DIC(9.4,52,22,29,"PAH",28,1,0)="^^2^2^3011121"
^DIC(9.4,52,22,29,"PAH",28,1,1,0)="This is a patch that limits the display of the warning message that was a"
^DIC(9.4,52,22,29,"PAH",28,1,2,0)="part of PRC*5.1*22."
^DIC(9.4,52,22,29,"PAH",29,0)="36 SEQ #30^3011121^1"
^DIC(9.4,52,22,29,"PAH",29,1,0)="^^4^4^3011121"
^DIC(9.4,52,22,29,"PAH",29,1,1,0)="This patch will fix the problem with the Purchase Order shipping amount."
^DIC(9.4,52,22,29,"PAH",29,1,2,0)="If user creates a Purchase Card Order with a Shipping amount, the system"
^DIC(9.4,52,22,29,"PAH",29,1,3,0)="does not add the shipping amount to the total amount. This will allow the"
^DIC(9.4,52,22,29,"PAH",29,1,4,0)="user to exceed the Single Purchase limit amount."
^DIC(9.4,52,22,29,"PAH",30,0)="30 SEQ #31^3011121^1"
^DIC(9.4,52,22,29,"PAH",30,1,0)="^^4^4^3011121"
^DIC(9.4,52,22,29,"PAH",30,1,1,0)="This patch increases the maximum length of the IFCAP Vendor Payment"
^DIC(9.4,52,22,29,"PAH",30,1,2,0)="Address fields from 23 characters to 30 characters.  This change is in"
^DIC(9.4,52,22,29,"PAH",30,1,3,0)="accordance with the IFCAP FMS Address Information project.  There are no"
^DIC(9.4,52,22,29,"PAH",30,1,4,0)="NOIS associated with this patch."
^DIC(9.4,52,22,29,"PAH",31,0)="44 SEQ #32^3011231^1"
^DIC(9.4,52,22,29,"PAH",31,1,0)="^^3^3^3011231"
^DIC(9.4,52,22,29,"PAH",31,1,1,0)="This patch corrects the problem where using the Change Existing"
^DIC(9.4,52,22,29,"PAH",31,1,2,0)="Transaction Number [PRCSANTN] menu option can result in dollar amounts"
^DIC(9.4,52,22,29,"PAH",31,1,3,0)="doubling on the Year to Date Accrual [PRCB YEAR TO DATE ACCRUAL]."
^DIC(9.4,52,22,29,"PAH",32,0)="21 SEQ #33^3011231^1"
^DIC(9.4,52,22,29,"PAH",32,1,0)="^^15^15^3011231"
^DIC(9.4,52,22,29,"PAH",32,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,52,22,29,"PAH",32,1,2,0)=""
^DIC(9.4,52,22,29,"PAH",32,1,3,0)="Problem 1: The purchase order does not appear under the vendor"
^DIC(9.4,52,22,29,"PAH",32,1,4,0)="           name listing if the vendor has been changed."
^DIC(9.4,52,22,29,"PAH",32,1,5,0)=""
^DIC(9.4,52,22,29,"PAH",32,1,6,0)="Problem 2: Contract number does not show in block 14 of the"
^DIC(9.4,52,22,29,"PAH",32,1,7,0)="           Amendment."
^DIC(9.4,52,22,29,"PAH",32,1,8,0)=""
^DIC(9.4,52,22,29,"PAH",32,1,9,0)="Problem 3: Change in vendor does not prompt the user to change"
^DIC(9.4,52,22,29,"PAH",32,1,10,0)="           vendor specific line item information."
^DIC(9.4,52,22,29,"PAH",32,1,11,0)=""
^DIC(9.4,52,22,29,"PAH",32,1,12,0)="Problem 4: Change in source code and the deletion of the contract"
^DIC(9.4,52,22,29,"PAH",32,1,13,0)="           number was not reflected in the purchase order display."
^DIC(9.4,52,22,29,"PAH",32,1,14,0)=""
^DIC(9.4,52,22,29,"PAH",32,1,15,0)=""
^DIC(9.4,52,22,29,"PAH",33,0)="34 SEQ #34^3020204^1"
^DIC(9.4,52,22,29,"PAH",33,1,0)="^^3^3^3020204"
^DIC(9.4,52,22,29,"PAH",33,1,1,0)="This patch will fix the problem with Due-ins not updating in inventory"
^DIC(9.4,52,22,29,"PAH",33,1,2,0)="points. It also add a new functionality to the 'Purchase Order Receiving"
^DIC(9.4,52,22,29,"PAH",33,1,3,0)="To Inventory Point' menu option."
^DIC(9.4,52,22,29,"PAH",34,0)="37 SEQ #35^3020226^1"
^DIC(9.4,52,22,29,"PAH",34,1,0)="^^2^2^3020226"
^DIC(9.4,52,22,29,"PAH",34,1,1,0)="This patch resolves a problem that EDI orders cannot be released to"
^DIC(9.4,52,22,29,"PAH",34,1,2,0)="vendors without Fiscal Review."
^DIC(9.4,52,22,29,"PAH",35,0)="50 SEQ #36^3020315^1"
^DIC(9.4,52,22,29,"PAH",35,1,0)="^^3^3^3020315"
^DIC(9.4,52,22,29,"PAH",35,1,1,0)="The option, IMPAC Account Information [PRCH IMPACT], is not displaying"
^DIC(9.4,52,22,29,"PAH",35,1,2,0)="information for approving officials whose last names begin with Z. The"
^DIC(9.4,52,22,29,"PAH",35,1,3,0)="sort template [PRCH IMPAC SORT] has been modified to go from A to ZZ."
^DIC(9.4,52,22,29,"PAH",36,0)="47 SEQ #37^3020315^1"
^DIC(9.4,52,22,29,"PAH",36,1,0)="^^4^4^3020315"
^DIC(9.4,52,22,29,"PAH",36,1,1,0)="This patch eliminates the hanging of List Distribution Orders To/From"
^DIC(9.4,52,22,29,"PAH",36,1,2,0)="Inventory Points [PRCP DIST ORDER LIST TO/FROM] when one of the"
^DIC(9.4,52,22,29,"PAH",36,1,3,0)="distribution orders to be released is being edited at the same time the"
^DIC(9.4,52,22,29,"PAH",36,1,4,0)="option is run."
^DIC(9.4,52,22,29,"PAH",37,0)="48 SEQ #38^3020408^1"
^DIC(9.4,52,22,29,"PAH",37,1,0)="^^11^11^3020408"
^DIC(9.4,52,22,29,"PAH",37,1,1,0)="This patch addresses 2 issues:"
^DIC(9.4,52,22,29,"PAH",37,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",37,1,3,0)="(1) If the Fund Control Point (FCP) on a purchase order is a Supply Fund"
^DIC(9.4,52,22,29,"PAH",37,1,4,0)="FCP and the purchase order is being sent EDI, the BI segment in the EDI"
^DIC(9.4,52,22,29,"PAH",37,1,5,0)="transaction will not contain the value the user entered in the INVOICE"
^DIC(9.4,52,22,29,"PAH",37,1,6,0)="ADDRESS field (#.04) in the PROCURMENT & ACCOUNTING TRANSACTIONS file"
^DIC(9.4,52,22,29,"PAH",37,1,7,0)="(#442) on the purchase order."
^DIC(9.4,52,22,29,"PAH",37,1,8,0)=" "
^DIC(9.4,52,22,29,"PAH",37,1,9,0)="(2) If a user is not flagged as a Supply employee in the NEW PERSON file"
^DIC(9.4,52,22,29,"PAH",37,1,10,0)="(#200) and that user attempts to access the menu option EDI/RFQ Reports"
^DIC(9.4,52,22,29,"PAH",37,1,11,0)="[PRCO EDI REPORTS], an <UNDEFINED> error is generated."
^DIC(9.4,52,22,29,"PAH",38,0)="13 SEQ #39^3020423^1"
^DIC(9.4,52,22,29,"PAH",38,1,0)="^^11^11^3020423"
^DIC(9.4,52,22,29,"PAH",38,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,52,22,29,"PAH",38,1,2,0)=""
^DIC(9.4,52,22,29,"PAH",38,1,3,0)="Problem 1: An undefined error occurred in routine PRCSUT2, while the user was"
^DIC(9.4,52,22,29,"PAH",38,1,4,0)="           in the Generating Request from Repetitive Item List option."
^DIC(9.4,52,22,29,"PAH",38,1,5,0)=""
^DIC(9.4,52,22,29,"PAH",38,1,6,0)="Problem 2: While creating a purchase card order from a repetitive item list,"
^DIC(9.4,52,22,29,"PAH",38,1,7,0)="           the item information fails to appear in the enter/edit template."
^DIC(9.4,52,22,29,"PAH",38,1,8,0)=""
^DIC(9.4,52,22,29,"PAH",38,1,9,0)="Problem 3: An undefined error in routine PRCH442A, while the user was"
^DIC(9.4,52,22,29,"PAH",38,1,10,0)="           Creating a Purchase Card Order from a RIL.  The error occurred"
^DIC(9.4,52,22,29,"PAH",38,1,11,0)="           because 2 of the vendors have the same name."
^DIC(9.4,52,22,29,"PAH",39,0)="26 SEQ #40^3020423^1"
^DIC(9.4,52,22,29,"PAH",39,1,0)="^^6^6^3020423"
^DIC(9.4,52,22,29,"PAH",39,1,1,0)="This patch addessess the following problems:"
^DIC(9.4,52,22,29,"PAH",39,1,2,0)=""
^DIC(9.4,52,22,29,"PAH",39,1,3,0)="PROBLEM 1: Purchase Order Display is not consistant using the fund"
^DIC(9.4,52,22,29,"PAH",39,1,4,0)="           control point. (FCP)"
^DIC(9.4,52,22,29,"PAH",39,1,5,0)=""
^DIC(9.4,52,22,29,"PAH",39,1,6,0)="PROBLEM 2: The appropriation date is missing from the purchase card order."
^DIC(9.4,52,22,29,"PAH",40,0)="52 SEQ #41^3020516^1"
^DIC(9.4,52,22,29,"PAH",40,1,0)="^^3^3^3020516"
^DIC(9.4,52,22,29,"PAH",40,1,1,0)="This patch contains fixes for edits made to items in supply station "
^DIC(9.4,52,22,29,"PAH",40,1,2,0)="secondary inventory points and bulletins regarding deleted distribution "
^DIC(9.4,52,22,29,"PAH",40,1,3,0)="orders."
^DIC(9.4,52,22,29,"PAH",41,0)="51 SEQ #42^3020516^1"
^DIC(9.4,52,22,29,"PAH",41,1,0)="^^2^2^3020516"
^DIC(9.4,52,22,29,"PAH",41,1,1,0)="This patch will give users enhanced control over EDI transmission of "
^DIC(9.4,52,22,29,"PAH",41,1,2,0)="orders."
^DIC(9.4,52,22,29,"PAH",42,0)="46 SEQ #43^3020516^1"
^DIC(9.4,52,22,29,"PAH",42,1,0)="^^9^9^3020516"
^DIC(9.4,52,22,29,"PAH",42,1,1,0)="While entering new 1358's, a message is appearing in error.  The message"
^DIC(9.4,52,22,29,"PAH",42,1,2,0)="reads:"
^DIC(9.4,52,22,29,"PAH",42,1,3,0)="     ""This is not a new 1358.  Adjustments may only be entered through the"
^DIC(9.4,52,22,29,"PAH",42,1,4,0)="     adjustment option."""
^DIC(9.4,52,22,29,"PAH",42,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",42,1,6,0)="When entering a new 1358 number, the common numbering series is not being"
^DIC(9.4,52,22,29,"PAH",42,1,7,0)="verified.  Routine, PRCHPAT, does not check for common numbering series.  "
^DIC(9.4,52,22,29,"PAH",42,1,8,0)=" "
^DIC(9.4,52,22,29,"PAH",42,1,9,0)="Both of these issues are being fixed."
^DIC(9.4,52,22,29,"PAH",43,0)="23 SEQ #44^3020626^1"
^DIC(9.4,52,22,29,"PAH",43,1,0)="^^13^13^3020626"
^DIC(9.4,52,22,29,"PAH",43,1,1,0)="This patch addresses 5 separate issues:"
^DIC(9.4,52,22,29,"PAH",43,1,2,0)="  "
^DIC(9.4,52,22,29,"PAH",43,1,3,0)="(1)     MWV-1200-20958, Incorrect 1358 mail message."
^DIC(9.4,52,22,29,"PAH",43,1,4,0)="  "
^DIC(9.4,52,22,29,"PAH",43,1,5,0)="(2)     ANC-0201-51570, Unable to exit  Edit 1358 Request ."
^DIC(9.4,52,22,29,"PAH",43,1,6,0)="  "
^DIC(9.4,52,22,29,"PAH",43,1,7,0)="(3)     BRX-1099-10192 & DUR-0500-30008,  Over Commit Switch  is not"
^DIC(9.4,52,22,29,"PAH",43,1,8,0)="working."
^DIC(9.4,52,22,29,"PAH",43,1,9,0)="  "
^DIC(9.4,52,22,29,"PAH",43,1,10,0)="(4)     MAC-0300-61151, Variable  Y  undefined in routine PRCEADJ1 when"
^DIC(9.4,52,22,29,"PAH",43,1,11,0)="processing AR rebuild."
^DIC(9.4,52,22,29,"PAH",43,1,12,0)="  "
^DIC(9.4,52,22,29,"PAH",43,1,13,0)="(5)     BIR-1000-32436, Rebuild incorrect document total."
^DIC(9.4,52,22,29,"PAH",44,0)="43 SEQ #45^3020710^1"
^DIC(9.4,52,22,29,"PAH",44,1,0)="^^4^4^3020710"
^DIC(9.4,52,22,29,"PAH",44,1,1,0)="When two users use the option Selected Control Points [PRCB PRINT "
^DIC(9.4,52,22,29,"PAH",44,1,2,0)="SELECTED FCP] at the same time, one of them will error out."
^DIC(9.4,52,22,29,"PAH",44,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",44,1,4,0)="Undefined error, EN2+12^PRCBP, Undefined variable NOLCK"
^DIC(9.4,52,22,29,"PAH",45,0)="38 SEQ #46^3020724^1"
^DIC(9.4,52,22,29,"PAH",45,1,0)="^^5^5^3020724"
^DIC(9.4,52,22,29,"PAH",45,1,1,0)="Sites have reported misleading information printing in the Receiving "
^DIC(9.4,52,22,29,"PAH",45,1,2,0)="Report.  When an adjustment voucher is used to back out the receipt of "
^DIC(9.4,52,22,29,"PAH",45,1,3,0)="items, the person approving the adjustment voucher is not displayed in "
^DIC(9.4,52,22,29,"PAH",45,1,4,0)="the Receiving Report.  Procurement documents are legal documents and "
^DIC(9.4,52,22,29,"PAH",45,1,5,0)="should display the person who actually signed and processed the entry."
^DIC(9.4,52,22,29,"PAH",46,0)="53 SEQ #47^3020814^1"
^DIC(9.4,52,22,29,"PAH",46,1,0)="^^1^1^3020814"
^DIC(9.4,52,22,29,"PAH",46,1,1,0)="This patch fixes NOIS HEH-0502-40043."
^DIC(9.4,52,22,29,"PAH",47,0)="58 SEQ #48^3030301^1"
^DIC(9.4,52,22,29,"PAH",47,1,0)="^^2^2^3030301"
^DIC(9.4,52,22,29,"PAH",47,1,1,0)="This patch will allow IFCAP to look for amendment fund in the correct "
^DIC(9.4,52,22,29,"PAH",47,1,2,0)="fiscal quarter."
^DIC(9.4,52,22,29,"PAH",48,0)="57 SEQ #49^3030329^1"
^DIC(9.4,52,22,29,"PAH",48,1,0)="^^3^3^3030329"
^DIC(9.4,52,22,29,"PAH",48,1,1,0)=" "
^DIC(9.4,52,22,29,"PAH",48,1,2,0)="This patch will ensure an item under an FCP that has a leading zero appears"
^DIC(9.4,52,22,29,"PAH",48,1,3,0)="in both formats of the Item History report."
^DIC(9.4,52,22,29,"PAH",49,0)="60 SEQ #50^3030403^1"
^DIC(9.4,52,22,29,"PAH",49,1,0)="^^14^14^3030403"
^DIC(9.4,52,22,29,"PAH",49,1,1,0)="This patch is in support of the site preparation steps for CoreFLS "
^DIC(9.4,52,22,29,"PAH",49,1,2,0)="deployment. It contains a new menu, option, and security key. During"
^DIC(9.4,52,22,29,"PAH",49,1,3,0)="the installation, the CoreFLS Data Cleansing Menu [PRCL COREFLS DATA "
^DIC(9.4,52,22,29,"PAH",49,1,4,0)="CLEANSING] is attached to the IFCAP Application Coordinator Menu"
^DIC(9.4,52,22,29,"PAH",49,1,5,0)="[PRCHUSER COORDINATOR]. Do not assign the security key to any users"
^DIC(9.4,52,22,29,"PAH",49,1,6,0)="until directed to do so by a future official CoreFLS Action Request."
^DIC(9.4,52,22,29,"PAH",49,1,7,0)="Instructions for the use of this option will also be included with"
^DIC(9.4,52,22,29,"PAH",49,1,8,0)="the CoreFLS Action Request."
^DIC(9.4,52,22,29,"PAH",49,1,9,0)=" "
^DIC(9.4,52,22,29,"PAH",49,1,10,0)="The compile option examines the IFCAP VENDOR FILE (#440) and other files "
^DIC(9.4,52,22,29,"PAH",49,1,11,0)="to determine which vendor records will be converted into the CoreFLS "
^DIC(9.4,52,22,29,"PAH",49,1,12,0)="system. Once the compile has been done, various reports may be run to "
^DIC(9.4,52,22,29,"PAH",49,1,13,0)="show in summary or detail format the data fields that do not conform to "
^DIC(9.4,52,22,29,"PAH",49,1,14,0)="the established CoreFLS data cleansing guidelines."
^DIC(9.4,52,22,29,"PAH",50,0)="64 SEQ #51^3030403^1"
^DIC(9.4,52,22,29,"PAH",50,1,0)="^^1^1^3030403"
^DIC(9.4,52,22,29,"PAH",50,1,1,0)="Change overlap for EOAM from four days to one."
^DIC(9.4,52,22,29,"PAH",51,0)="49 SEQ #52^3030430^1"
^DIC(9.4,52,22,29,"PAH",51,1,0)="^^1^1^3030430"
^DIC(9.4,52,22,29,"PAH",51,1,1,0)="FIX FOR CASE CART/INSTRUMENT KIT PRINTS."
^DIC(9.4,52,22,29,"PAH",52,0)="62 SEQ #54^3030520^1"
^DIC(9.4,52,22,29,"PAH",52,1,0)="^^10^10^3030520"
^DIC(9.4,52,22,29,"PAH",52,1,1,0)="This report has been modified to ensure that the information provided"
^DIC(9.4,52,22,29,"PAH",52,1,2,0)="is move useful to the user community.  The following changes have been"
^DIC(9.4,52,22,29,"PAH",52,1,3,0)="implemented."
^DIC(9.4,52,22,29,"PAH",52,1,4,0)=""
^DIC(9.4,52,22,29,"PAH",52,1,5,0)="1. Purchase Card Orders with the following status will NOT appear"
^DIC(9.4,52,22,29,"PAH",52,1,6,0)="   on this report:"
^DIC(9.4,52,22,29,"PAH",52,1,7,0)="   a. Order not completely prepared"
^DIC(9.4,52,22,29,"PAH",52,1,8,0)=""
^DIC(9.4,52,22,29,"PAH",52,1,9,0)="2. A date range has been added."
^DIC(9.4,52,22,29,"PAH",52,1,10,0)=""
^DIC(9.4,52,22,29,"PAH",53,0)="56 SEQ #55^3030520^1"
^DIC(9.4,52,22,29,"PAH",53,1,0)="^^1^1^3030520"
^DIC(9.4,52,22,29,"PAH",53,1,1,0)="Remove 'Do you want to send this EDI?:' prompt."
^DIC(9.4,52,22,29,"PAH",54,0)="59 SEQ #56^3030802^1"
^DIC(9.4,52,22,29,"PAH",54,1,0)="^^6^6^3030802"
^DIC(9.4,52,22,29,"PAH",54,1,1,0)="This patch addresses 2 NOIS(s).  The 1st NOIS deals with a type 12 amendment"
^DIC(9.4,52,22,29,"PAH",54,1,2,0)="for a purchase order.  In a type 12 amendment, a new purchase order is created,"
^DIC(9.4,52,22,29,"PAH",54,1,3,0)="and the old purchase order is cancelled.  Currently, if a type 12 amendment is"
^DIC(9.4,52,22,29,"PAH",54,1,4,0)="performed, the new [PRCH DISPLAY PO] option.  In the second NOIS, users have"
^DIC(9.4,52,22,29,"PAH",54,1,5,0)="difficulty editing the socio-economic group for a vendor."
^DIC(9.4,52,22,29,"PAH",54,1,6,0)=""
^DIC(9.4,52,22,29,"PAH",55,0)="71 SEQ #57^3030924^1"
^DIC(9.4,52,22,29,"PAH",55,1,0)="^^3^3^3030924"
^DIC(9.4,52,22,29,"PAH",55,1,1,0)="This patch will change the way the transmission date gets assigned on the "
^DIC(9.4,52,22,29,"PAH",55,1,2,0)="SV code sheet generated by the Accrual (Monthly) [PRCB MONTHLY ACCRUAL] "
^DIC(9.4,52,22,29,"PAH",55,1,3,0)="option."
^DIC(9.4,52,22,29,"PAH",56,0)="61 SEQ #58^3031002^1"
^DIC(9.4,52,22,29,"PAH",56,1,0)="^^10^10^3031002"
^DIC(9.4,52,22,29,"PAH",56,1,1,0)="This patch is in support of the site preparation steps for CoreFLS"
^DIC(9.4,52,22,29,"PAH",56,1,2,0)="deployment. It should be installed as a normal patch. A new option will"
^DIC(9.4,52,22,29,"PAH",56,1,3,0)="be installed under the CoreFLS Data Cleansing menu [PRCL COREFLS DATA"
^DIC(9.4,52,22,29,"PAH",56,1,4,0)="CLEANSING] with the same security key as the other options. Instructions"
^DIC(9.4,52,22,29,"PAH",56,1,5,0)="for the use of this option will be included in an official CoreFLS Action"
^DIC(9.4,52,22,29,"PAH",56,1,6,0)="Request."
^DIC(9.4,52,22,29,"PAH",56,1,7,0)=" "
^DIC(9.4,52,22,29,"PAH",56,1,8,0)="This option contains various reports that show in summary or detail"
^DIC(9.4,52,22,29,"PAH",56,1,9,0)="format the data fields for records in the GENERIC INVENTORY file (#445)"
^DIC(9.4,52,22,29,"PAH",56,1,10,0)="that do not conform to the established CoreFLS data cleansing guidelines."
^DIC(9.4,52,22,29,"PAH",57,0)="66 SEQ #59^3031002^1"
^DIC(9.4,52,22,29,"PAH",57,1,0)="^^11^11^3031002"
^DIC(9.4,52,22,29,"PAH",57,1,1,0)="This patch is in support of the site preparation steps for CoreFLS"
^DIC(9.4,52,22,29,"PAH",57,1,2,0)="deployment. It should be installed as a normal patch. A new option will"
^DIC(9.4,52,22,29,"PAH",57,1,3,0)="be installed under the CoreFLS Data Cleansing menu [PRCL COREFLS DATA"
^DIC(9.4,52,22,29,"PAH",57,1,4,0)="CLEANSING] with the same security key as the other options. Instructions"
^DIC(9.4,52,22,29,"PAH",57,1,5,0)="for the use of this option will be included in an official CoreFLS Action"
^DIC(9.4,52,22,29,"PAH",57,1,6,0)="Request."
^DIC(9.4,52,22,29,"PAH",57,1,7,0)=" "
^DIC(9.4,52,22,29,"PAH",57,1,8,0)="This option contains various reports that show in summary or detail"
^DIC(9.4,52,22,29,"PAH",57,1,9,0)="format the data fields for records in the PROCUREMENT & ACCOUNTING"
^DIC(9.4,52,22,29,"PAH",57,1,10,0)="TRANSACTIONS file (#442) that do not conform to the established CoreFLS"
^DIC(9.4,52,22,29,"PAH",57,1,11,0)="data cleansing guidelines."
^DIC(9.4,52,22,29,"PAH",58,0)="69 SEQ #60^3031002^1"
^DIC(9.4,52,22,29,"PAH",58,1,0)="^^13^13^3031002"
^DIC(9.4,52,22,29,"PAH",58,1,1,0)="This patch is in support of the site preparation steps for CoreFLS"
^DIC(9.4,52,22,29,"PAH",58,1,2,0)="deployment. A new option, Local Vendor Data Cleansing Reports [PRCL"
^DIC(9.4,52,22,29,"PAH",58,1,3,0)="LOCAL VENDOR], is added to the CoreFLS Data Cleansing [PRCL COREFLS"
^DIC(9.4,52,22,29,"PAH",58,1,4,0)="DATA CLEANSING] menu as part of the installation of this patch."
^DIC(9.4,52,22,29,"PAH",58,1,5,0)="Instructions for the use of this option will be included with the "
^DIC(9.4,52,22,29,"PAH",58,1,6,0)="CoreFLS Action Request."
^DIC(9.4,52,22,29,"PAH",58,1,7,0)="  "
^DIC(9.4,52,22,29,"PAH",58,1,8,0)="The compile routine examines the IFCAP PROCUREMENT & ACCOUNTING"
^DIC(9.4,52,22,29,"PAH",58,1,9,0)="TRANSACTIONS FILE (#442) to determine which local vendor "
^DIC(9.4,52,22,29,"PAH",58,1,10,0)="purchasing records will be converted into the CoreFLS system. Once "
^DIC(9.4,52,22,29,"PAH",58,1,11,0)="the compile has been done, various reports may be run to show, in "
^DIC(9.4,52,22,29,"PAH",58,1,12,0)="summary or detail format, the open POs for current or previous "
^DIC(9.4,52,22,29,"PAH",58,1,13,0)="fiscal years."
^DIC(9.4,52,22,29,"PAH",59,0)="72 SEQ #61^3031121^1"
^DIC(9.4,52,22,29,"PAH",59,1,0)="^^1^1^3031121"
^DIC(9.4,52,22,29,"PAH",59,1,1,0)="CHANGING OVERLAP DAYS AT END OF ACCOUNTING MONTH TO ZERO."
^DIC(9.4,52,22,29,"PAH",60,0)="55 SEQ #62^3031121^1"
^DIC(9.4,52,22,29,"PAH",60,1,0)="^^1^1^3031121"
^DIC(9.4,52,22,29,"PAH",60,1,1,0)="MISLEADING OPTION HELP TEXT/MISPELLED VARIABLE"
^DIC(9.4,52,22,29,"PAH",61,0)="76 SEQ #63^3040330^1"
^DIC(9.4,52,22,29,"PAH",61,1,0)="^^11^11^3040330"
^DIC(9.4,52,22,29,"PAH",61,1,1,0)="The purpose of this patch is to modify the Funds Distribution module"
^DIC(9.4,52,22,29,"PAH",61,1,2,0)="of IFCAP allowing the VHA (Veterans Health Administration) to comply"
^DIC(9.4,52,22,29,"PAH",61,1,3,0)="with the FY2004 Omnibus Appropriations Bill."
^DIC(9.4,52,22,29,"PAH",61,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",61,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",61,1,6,0)="Rationale"
^DIC(9.4,52,22,29,"PAH",61,1,7,0)="---------"
^DIC(9.4,52,22,29,"PAH",61,1,8,0)="The Fiscal Year 2004 Omnibus Appropriations bill, mandated by Congress,"
^DIC(9.4,52,22,29,"PAH",61,1,9,0)="has reclassified VHA funds for distribution, obligations, and expenses."
^DIC(9.4,52,22,29,"PAH",61,1,10,0)="The new funding will be implemented April 1, 2004, and is retroactive"
^DIC(9.4,52,22,29,"PAH",61,1,11,0)="to October 1, 2003."
^DIC(9.4,52,22,29,"PAH",62,0)="74 SEQ #64^3040702^1"
^DIC(9.4,52,22,29,"PAH",62,1,0)="^^6^6^3040702"
^DIC(9.4,52,22,29,"PAH",62,1,1,0)="This patch will ensure that the ""D"" cross reference for the PROCUREMENT"
^DIC(9.4,52,22,29,"PAH",62,1,2,0)="& ACCOUNTING TRANSACTIONS file (#442) gets updated when amending a P.O."
^DIC(9.4,52,22,29,"PAH",62,1,3,0)="with multiple edits."
^DIC(9.4,52,22,29,"PAH",62,1,4,0)=""
^DIC(9.4,52,22,29,"PAH",62,1,5,0)="There is also a Post-Install routine that removes a non-namespaced"
^DIC(9.4,52,22,29,"PAH",62,1,6,0)="global introduced by PRC*5.1*76.  The name of the global is ^NIXON."
^DIC(9.4,52,22,29,"PAH",63,0)="70 SEQ #65^3040702^1"
^DIC(9.4,52,22,29,"PAH",63,1,0)="^^1^1^3040702"
^DIC(9.4,52,22,29,"PAH",63,1,1,0)="UNDEFINED VARIABLE 'LNCT'/INVALID CLASSIFICATION OF REQUEST"
^DIC(9.4,52,22,29,"PAH",64,0)="78 SEQ #66^3050118^1"
^DIC(9.4,52,22,29,"PAH",64,1,0)="^^5^5^3050118"
^DIC(9.4,52,22,29,"PAH",64,1,1,0)="The operational test site using CoreFLS was reverted to its pre-CoreFLS "
^DIC(9.4,52,22,29,"PAH",64,1,2,0)="state and the CoreFLS project was suspended.  Consequently halting data "
^DIC(9.4,52,22,29,"PAH",64,1,3,0)="cleansing efforts and requiring that components of the data cleansing "
^DIC(9.4,52,22,29,"PAH",64,1,4,0)="patches (PRC*5.1*60, PRC*5.1*61, PRC*5.1*66, PRC*5.1*69) be removed at "
^DIC(9.4,52,22,29,"PAH",64,1,5,0)="each site."
^DIC(9.4,52,22,29,"PAH",65,0)="75 SEQ #67^3050525^1"
^DIC(9.4,52,22,29,"PAH",65,1,0)="^^11^11^3050525"
^DIC(9.4,52,22,29,"PAH",65,1,1,0)="This software extracts from IFCAP for National Item File (NIF) processing"
^DIC(9.4,52,22,29,"PAH",65,1,2,0)="those active items which have been purchased within the previous 12 "
^DIC(9.4,52,22,29,"PAH",65,1,3,0)="months, which have been received, issued, assembled, or manually adjusted"
^DIC(9.4,52,22,29,"PAH",65,1,4,0)="in a Generic Inventory Package (GIP) inventory point within the previous "
^DIC(9.4,52,22,29,"PAH",65,1,5,0)="12 months, which are flagged in the ITEM MASTER file (#441) as reusable,"
^DIC(9.4,52,22,29,"PAH",65,1,6,0)="or which are active components of active case carts or active instrument"
^DIC(9.4,52,22,29,"PAH",65,1,7,0)="kits. At the user's option, GIP physical inventory count transactions "
^DIC(9.4,52,22,29,"PAH",65,1,8,0)="within the previous 12 months are also included in the analysis of "
^DIC(9.4,52,22,29,"PAH",65,1,9,0)="items to export.  The software then writes item data and associated last"
^DIC(9.4,52,22,29,"PAH",65,1,10,0)="vendor data to a host file in a record format mutually agreed upon with"
^DIC(9.4,52,22,29,"PAH",65,1,11,0)="the NIF contractor."
^DIC(9.4,52,22,29,"PAH",66,0)="81^3050813^1"
^DIC(9.4,52,22,29,"PAH",66,1,0)="^^2^2^3050813"
^DIC(9.4,52,22,29,"PAH",66,1,1,0)="This patch contains the software required to run the DynaMed-IFCAP "
^DIC(9.4,52,22,29,"PAH",66,1,2,0)="Interface."
^DIC(9.4,52,22,29,"PAH",67,0)="84 SEQ #69^3050813^1"
^DIC(9.4,52,22,29,"PAH",67,1,0)="^^2^2^3050813"
^DIC(9.4,52,22,29,"PAH",67,1,1,0)="This patch corrects some inconsistencies and M errors associated with"
^DIC(9.4,52,22,29,"PAH",67,1,2,0)="the date range selection for some of the Generic Inventory reports."
^DIC(9.4,52,22,29,"PAH",68,0)="68 SEQ #70^3050813^1"
^DIC(9.4,52,22,29,"PAH",68,1,0)="^^1^1^3050813"
^DIC(9.4,52,22,29,"PAH",68,1,1,0)="Prosthetics to IFCAP interface routines."
^DIC(9.4,52,22,29,"PAH",69,0)="77 SEQ #71^3050924^1"
^DIC(9.4,52,22,29,"PAH",69,1,0)="^^1^1^3050924"
^DIC(9.4,52,22,29,"PAH",69,1,1,0)="ADJUSTMENT VOUCHER SCROLLING PROBLEM"
^DIC(9.4,52,22,29,"PAH",70,0)="63 SEQ #72^3051020^1"
^DIC(9.4,52,22,29,"PAH",70,1,0)="^^11^11^3051020"
^DIC(9.4,52,22,29,"PAH",70,1,1,0)="This patch installs software in support of the National Item File - Phase "
^DIC(9.4,52,22,29,"PAH",70,1,2,0)="1 initiative, as defined by IT Service Request #20020708."
^DIC(9.4,52,22,29,"PAH",70,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",70,1,4,0)="IFCAP has been enhanced to receive via an X12 Item Maintenance 888 "
^DIC(9.4,52,22,29,"PAH",70,1,5,0)="transaction, the National Item File (NIF)'s item number, short description"
^DIC(9.4,52,22,29,"PAH",70,1,6,0)="and extended description and store them in the corresponding entry of the"
^DIC(9.4,52,22,29,"PAH",70,1,7,0)="local IFCAP system's ITEM MASTER file (#441). The NIF item number now is "
^DIC(9.4,52,22,29,"PAH",70,1,8,0)="a write identifier for this file.  One can now also select entries using "
^DIC(9.4,52,22,29,"PAH",70,1,9,0)="the NIF item number.  In addition, the NIF item number is now sent in the "
^DIC(9.4,52,22,29,"PAH",70,1,10,0)="'IT' segment of the PHA transaction for inclusion in OA&MM's Procurement "
^DIC(9.4,52,22,29,"PAH",70,1,11,0)="History database at the Austin Automation Center (AAC)."
^DIC(9.4,52,22,29,"PAH",71,0)="85 SEQ #73^3051115^1"
^DIC(9.4,52,22,29,"PAH",71,1,0)="^^5^5^3051115"
^DIC(9.4,52,22,29,"PAH",71,1,1,0)="This patch modifies the PRCS APPROVE REQUEST print template to resolve"
^DIC(9.4,52,22,29,"PAH",71,1,2,0)="an issue which was causing the APPROVE REQUEST option to fail when an"
^DIC(9.4,52,22,29,"PAH",71,1,3,0)="item description contained a vertical bar (pipe) character.  It also "
^DIC(9.4,52,22,29,"PAH",71,1,4,0)="distributes a new copy of PRCPSFSV which contains a new set of FMS "
^DIC(9.4,52,22,29,"PAH",71,1,5,0)="transmission codes."
^DIC(9.4,52,22,29,"PAH",72,0)="86 SEQ #74^3051115^1"
^DIC(9.4,52,22,29,"PAH",72,1,0)="^^5^5^3051115"
^DIC(9.4,52,22,29,"PAH",72,1,1,0)=" This patch corrects two issues related to the interface between the"
^DIC(9.4,52,22,29,"PAH",72,1,2,0)=" DynaMed inventory system and IFCAP."
^DIC(9.4,52,22,29,"PAH",72,1,3,0)=" The first issue relates to the inappropriate use of BOC 2696 and the "
^DIC(9.4,52,22,29,"PAH",72,1,4,0)=" second to a problem that occurs when a Receiving Report is deleted"
^DIC(9.4,52,22,29,"PAH",72,1,5,0)=" prior to being signed."
^DIC(9.4,52,22,29,"PAH",73,0)="87 SEQ #75^3051202^1"
^DIC(9.4,52,22,29,"PAH",73,1,0)="^^4^4^3051202"
^DIC(9.4,52,22,29,"PAH",73,1,1,0)="This patch updates the PRCPPOLM routine to correct a problem with "
^DIC(9.4,52,22,29,"PAH",73,1,2,0)="Purchase Card orders.  The patch also changes the data type of the HL7 "
^DIC(9.4,52,22,29,"PAH",73,1,3,0)="TRANSACTION NUMBERS field in file #447.1 and modifies the input transform "
^DIC(9.4,52,22,29,"PAH",73,1,4,0)="for that field."
^DIC(9.4,52,22,29,"PAH",74,0)="89 SEQ #76^3051221^1"
^DIC(9.4,52,22,29,"PAH",74,1,0)="^^3^3^3051221"
^DIC(9.4,52,22,29,"PAH",74,1,1,0)="This patchs corrects a problem with the PUBLIC LAW 100-322 REPORT."
^DIC(9.4,52,22,29,"PAH",74,1,2,0)="The report failed with a Null Subscript error if there were no"
^DIC(9.4,52,22,29,"PAH",74,1,3,0)="records to report."
^DIC(9.4,52,22,29,"PAH",75,0)="93 SEQ #77^3060112^1"
^DIC(9.4,52,22,29,"PAH",75,1,0)="^^1^1^3060112"
^DIC(9.4,52,22,29,"PAH",75,1,1,0)="<NULLSUBSCR> CP+12^PRCSUT"
^DIC(9.4,52,22,29,"PAH",76,0)="92 SEQ #78^3060213^1"
^DIC(9.4,52,22,29,"PAH",76,1,0)="^^3^3^3060213"
^DIC(9.4,52,22,29,"PAH",76,1,1,0)="This patch will correct a coding error in which invalid entries were "
^DIC(9.4,52,22,29,"PAH",76,1,2,0)="being added to the ""C"" cross reference of file #442.  This had the "
^DIC(9.4,52,22,29,"PAH",76,1,3,0)="potential to cause problems with the PURCHASE ORDER DISPLAY option."
^DIC(9.4,52,22,29,"PAH",77,0)="83 SEQ #79^3060308^1"
^DIC(9.4,52,22,29,"PAH",77,1,0)="^^6^6^3060308"
^DIC(9.4,52,22,29,"PAH",77,1,1,0)="This patch will enhance the Integrated Funds Distribution, Control Point "
^DIC(9.4,52,22,29,"PAH",77,1,2,0)="Activity, Accounting, and Procurement (IFCAP) package to capture "
^DIC(9.4,52,22,29,"PAH",77,1,3,0)="Purchase Order (PO) Activity and Generic Inventory Package (GIP) module"
^DIC(9.4,52,22,29,"PAH",77,1,4,0)="data so the data can be rolled up at the Veterans Integrated Services"
^DIC(9.4,52,22,29,"PAH",77,1,5,0)="Network (VISN) and national levels for analysis by the Prosthetic and"
^DIC(9.4,52,22,29,"PAH",77,1,6,0)="Clinical Logistics Office (PCLO)."
^DIC(9.4,52,22,29,"PAH",78,0)="79^3060308^1"
^DIC(9.4,52,22,29,"PAH",78,1,0)="^^6^6^3060308"
^DIC(9.4,52,22,29,"PAH",78,1,1,0)="This patch will address new requirements for reporting VISTA procurement "
^DIC(9.4,52,22,29,"PAH",78,1,2,0)="information to the FPDS system at the Austin Automation Center (AAC)."
^DIC(9.4,52,22,29,"PAH",78,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",78,1,4,0)="New Product Service Codes (PSC) and Federal Supply Classification "
^DIC(9.4,52,22,29,"PAH",78,1,5,0)="(FSC) codes with corresponding ""groups"" are added to files #441.2 and"
^DIC(9.4,52,22,29,"PAH",78,1,6,0)="#441.3. "
^DIC(9.4,52,22,29,"PAH",79,0)="91 SEQ #81^3060410^1"
^DIC(9.4,52,22,29,"PAH",79,1,0)="^^3^3^3060410"
^DIC(9.4,52,22,29,"PAH",79,1,1,0)="This patch corrects a Null Subscript error that can occur when a user "
^DIC(9.4,52,22,29,"PAH",79,1,2,0)="processes multiple Purchase Order amendments without exiting the option "
^DIC(9.4,52,22,29,"PAH",79,1,3,0)="prior to each amendment."
^DIC(9.4,52,22,29,"PAH",80,0)="41 SEQ #82^3060526^1"
^DIC(9.4,52,22,29,"PAH",80,1,0)="^^1^1^3060526"
^DIC(9.4,52,22,29,"PAH",80,1,1,0)="GIP, CASE CART AND INSTRUMENT KIT FIXES"
^DIC(9.4,52,22,29,"PAH",81,0)="97 SEQ #83^3060608^1"
^DIC(9.4,52,22,29,"PAH",81,1,0)="^^9^9^3060608"
^DIC(9.4,52,22,29,"PAH",81,1,1,0)="There are two issues being addressed with this patch, the first is an"
^DIC(9.4,52,22,29,"PAH",81,1,2,0)="error in the code that ran the option PRCB CPA RUNNING BALANCE.  The error"
^DIC(9.4,52,22,29,"PAH",81,1,3,0)="was involves the setting of the DIC screen when certain conditions are "
^DIC(9.4,52,22,29,"PAH",81,1,4,0)="met.  The current code causes a runtime syntax error.  The second issue "
^DIC(9.4,52,22,29,"PAH",81,1,5,0)="involves a change in functionality that will allow users of the option"
^DIC(9.4,52,22,29,"PAH",81,1,6,0)="'AMENDMENT TO PURCHASE ORDER' to exit the user prompts while performing a"
^DIC(9.4,52,22,29,"PAH",81,1,7,0)="'Line Item Add'.  The user will be able to use the standard '^' to exit "
^DIC(9.4,52,22,29,"PAH",81,1,8,0)="the prompts. If the user did not enter a value for the Quantity field, "
^DIC(9.4,52,22,29,"PAH",81,1,9,0)="the line item is deleted."
^DIC(9.4,52,22,29,"PAH",82,0)="100 SEQ #84^3060824^1"
^DIC(9.4,52,22,29,"PAH",82,1,0)="^^2^2^3060824"
^DIC(9.4,52,22,29,"PAH",82,1,1,0)="This patch addresses issues with the new functionality introduced by the "
^DIC(9.4,52,22,29,"PAH",82,1,2,0)="patch PRC*5.1*79 and reported via the Remedy system."
^DIC(9.4,52,22,29,"PAH",83,0)="96 SEQ #85^3060923^1"
^DIC(9.4,52,22,29,"PAH",83,1,0)="^^9^9^3060923"
^DIC(9.4,52,22,29,"PAH",83,1,1,0)="This patch corrects an issue with FMS transactions that have a Transcode "
^DIC(9.4,52,22,29,"PAH",83,1,2,0)="of PR (payroll).  The issue occurs when payroll transactions use the same "
^DIC(9.4,52,22,29,"PAH",83,1,3,0)="common number series for transaction numbers as Purchase Orders.  The "
^DIC(9.4,52,22,29,"PAH",83,1,4,0)="code initially look at file 442 to find a transaction number match, if "
^DIC(9.4,52,22,29,"PAH",83,1,5,0)="one did not exist it then searched for payroll transactions.  "
^DIC(9.4,52,22,29,"PAH",83,1,6,0)="Unfortunately, if the same common number series was used to create both "
^DIC(9.4,52,22,29,"PAH",83,1,7,0)="types of transactions there are instances where two separate transactions "
^DIC(9.4,52,22,29,"PAH",83,1,8,0)="have the same exact transaction number causing an incorrect posting of "
^DIC(9.4,52,22,29,"PAH",83,1,9,0)="payroll data to Purchase Order transactions."
^DIC(9.4,52,22,29,"PAH",84,0)="104 SEQ #86^3061122.182053^1"
^DIC(9.4,52,22,29,"PAH",84,1,0)="^^4^4^3061122"
^DIC(9.4,52,22,29,"PAH",84,1,1,0)="Making a change to how data is extracted from file 442.  Originally the "
^DIC(9.4,52,22,29,"PAH",84,1,2,0)="extracts were run from the first of the month and at least 45 days prior "
^DIC(9.4,52,22,29,"PAH",84,1,3,0)="to the extract date.  The change will now run the extract from the"
^DIC(9.4,52,22,29,"PAH",84,1,4,0)="beginning of the Fiscal Year until the date of the extract (NOW)."
^DIC(9.4,52,22,29,"PAH",85,0)="90 SEQ #87^3061122.222704^1"
^DIC(9.4,52,22,29,"PAH",85,1,0)="^^8^8^3061122"
^DIC(9.4,52,22,29,"PAH",85,1,1,0)="This patch corrects two issues. The first involves the inability of the "
^DIC(9.4,52,22,29,"PAH",85,1,2,0)="Display/Print 1358 option to find an obligation number when the user had "
^DIC(9.4,52,22,29,"PAH",85,1,3,0)="previously used this option and then backed completely "
^DIC(9.4,52,22,29,"PAH",85,1,4,0)="out.                 "
^DIC(9.4,52,22,29,"PAH",85,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",85,1,6,0)="The second issue involves the Running Balances option.  A blank page "
^DIC(9.4,52,22,29,"PAH",85,1,7,0)="precedes the printing of the report and the page number is wrapping to "
^DIC(9.4,52,22,29,"PAH",85,1,8,0)="the next line."
^DIC(9.4,52,22,29,"PAH",86,0)="106 SEQ #88^3061122.231946^1"
^DIC(9.4,52,22,29,"PAH",86,1,0)="^^8^8^3061122"
^DIC(9.4,52,22,29,"PAH",86,1,1,0)="This patch addresses three issues.  The first issue is  with the option"
^DIC(9.4,52,22,29,"PAH",86,1,2,0)="PRCH CREATE PURCHASE CARD which creates a purchase card order from a"
^DIC(9.4,52,22,29,"PAH",86,1,3,0)="Repetitive Item List (RIL). An undefined error occurs when one user"
^DIC(9.4,52,22,29,"PAH",86,1,4,0)="deletes an RIL that is being used by another user.  The second issue is an"
^DIC(9.4,52,22,29,"PAH",86,1,5,0)="<undefined> error when running the option Mandatory Sources 850"
^DIC(9.4,52,22,29,"PAH",86,1,6,0)="Undelivered Orders when there are 0 records to report.  The third issue "
^DIC(9.4,52,22,29,"PAH",86,1,7,0)="is a <undefined> error when the user tries to quit the report display "
^DIC(9.4,52,22,29,"PAH",86,1,8,0)="with an '^' at the start of a new page."
^DIC(9.4,52,22,29,"PAH",87,0)="101 SEQ #89^3061211.161439^1"
^DIC(9.4,52,22,29,"PAH",87,1,0)="^^7^7^3061211"
^DIC(9.4,52,22,29,"PAH",87,1,1,0)="This patch corrects two issues.  The first issue involves a FRAMESTACK "
^DIC(9.4,52,22,29,"PAH",87,1,2,0)="error in running the BOC Totals report when the number of obligations in "
^DIC(9.4,52,22,29,"PAH",87,1,3,0)="a selected quarter approaches 3,000.  The second issue occurs when "
^DIC(9.4,52,22,29,"PAH",87,1,4,0)="running the option Generate Requests From Repetitive Item List Entry "
^DIC(9.4,52,22,29,"PAH",87,1,5,0)="[PRCSRI GENERATE].  An Undefined Error occurs when the default device for "
^DIC(9.4,52,22,29,"PAH",87,1,6,0)="the station selected for the given type of order (example:  Supply) is "
^DIC(9.4,52,22,29,"PAH",87,1,7,0)="either out-of-date or is non-existent.  "
^DIC(9.4,52,22,29,"PAH",88,0)="95 SEQ #90^3061227.14314^1"
^DIC(9.4,52,22,29,"PAH",88,1,0)="^^1^1^3061227"
^DIC(9.4,52,22,29,"PAH",88,1,1,0)="CLEANUP IFCAP ARCHIVE/PURGE PROCESS"
^DIC(9.4,52,22,29,"PAH",89,0)="98 SEQ #91^3070904.224338^1"
^DIC(9.4,52,22,29,"PAH",89,1,0)="^^2^2^3070904"
^DIC(9.4,52,22,29,"PAH",89,1,1,0)="This patch addresses an enhancement request to modify IFCAP to properly "
^DIC(9.4,52,22,29,"PAH",89,1,2,0)="classify On Demand Items (ODI)."
^DIC(9.4,52,22,29,"PAH",90,0)="103 SEQ #92^3070905.003224^1"
^DIC(9.4,52,22,29,"PAH",90,1,0)="^^3^3^3070905"
^DIC(9.4,52,22,29,"PAH",90,1,1,0)="THIS IFCAP PATCH WILL DISPLAY DATA FROM IFCAP FILES #441 AND #442"
^DIC(9.4,52,22,29,"PAH",90,1,2,0)="AND FROM PROSTHETICS FILE #664. DBIA #4345 AUTHORIZES READ ACCESS TO"
^DIC(9.4,52,22,29,"PAH",90,1,3,0)="FILE #664."
^DIC(9.4,52,22,29,"PAH",91,0)="105 SEQ #93^3070905.005645^1"
^DIC(9.4,52,22,29,"PAH",91,1,0)="^^9^9^3070905"
^DIC(9.4,52,22,29,"PAH",91,1,1,0)="This patch addresses three issues.  The first issue involves contract"
^DIC(9.4,52,22,29,"PAH",91,1,2,0)="numbers not being sent in the FPDS HL7 message of Amendments to Delivery"
^DIC(9.4,52,22,29,"PAH",91,1,3,0)="Orders.  Because the contract number is not sent the orders are being"
^DIC(9.4,52,22,29,"PAH",91,1,4,0)="interpreted as an open market order causing problems in Austin."
^DIC(9.4,52,22,29,"PAH",91,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",91,1,6,0)="The second and third issues are related to the DUN & Bradstreet DUNS#'s "
^DIC(9.4,52,22,29,"PAH",91,1,7,0)="changing format.  Formerly DUNS#'s used the 9th digit as a check "
^DIC(9.4,52,22,29,"PAH",91,1,8,0)="digit and lengths were variable.  Now the 9th digit will no longer be "
^DIC(9.4,52,22,29,"PAH",91,1,9,0)="used as a check digit and valid lengths are either 9 or 13 numbers only."
^DIC(9.4,52,22,29,"PAH",92,0)="108 SEQ #94^3070905.005731^1"
^DIC(9.4,52,22,29,"PAH",92,1,0)="^^19^19^3070905"
^DIC(9.4,52,22,29,"PAH",92,1,1,0)="The first issue involves the input transform of the "
^DIC(9.4,52,22,29,"PAH",92,1,2,0)="Appropriation field in the Fund Distribution file (#421)."
^DIC(9.4,52,22,29,"PAH",92,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",92,1,4,0)="The second issue involves allowing all users of the New Detailed Purchase "
^DIC(9.4,52,22,29,"PAH",92,1,5,0)="Card Order option to enter an Item Discount."
^DIC(9.4,52,22,29,"PAH",92,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",92,1,7,0)="The third item is a fix to the help text display at the prompt:"
^DIC(9.4,52,22,29,"PAH",92,1,8,0)="""Do you want to request a refresh of the supply station QOH?"""
^DIC(9.4,52,22,29,"PAH",92,1,9,0)=" "
^DIC(9.4,52,22,29,"PAH",92,1,10,0)="The fourth item fixes a problem that could occur when editing the"
^DIC(9.4,52,22,29,"PAH",92,1,11,0)="CONTRACT/BOA # field on an amendment."
^DIC(9.4,52,22,29,"PAH",92,1,12,0)=" "
^DIC(9.4,52,22,29,"PAH",92,1,13,0)="The fifth item fixes a problem with ^-jumping at the CONTRACT/BOA #"
^DIC(9.4,52,22,29,"PAH",92,1,14,0)="field in the Edit an Incomplete Purchase Order option."
^DIC(9.4,52,22,29,"PAH",92,1,15,0)=" "
^DIC(9.4,52,22,29,"PAH",92,1,16,0)="The sixth item updates the Purchase Card limit to $3,000."
^DIC(9.4,52,22,29,"PAH",92,1,17,0)=" "
^DIC(9.4,52,22,29,"PAH",92,1,18,0)="The seventh item corrects two spelling errors in an"
^DIC(9.4,52,22,29,"PAH",92,1,19,0)="IFCAP Option File entry."
^DIC(9.4,52,22,29,"PAH",93,0)="111 SEQ #95^3070905.013533^1"
^DIC(9.4,52,22,29,"PAH",93,1,0)="^^1^1^3070905"
^DIC(9.4,52,22,29,"PAH",93,1,1,0)="  Updates the 'Stock On Hand Report Greater Than Range' from 90 to 270."
^DIC(9.4,52,22,29,"PAH",94,0)="114 SEQ #96^3080526.154131^1"
^DIC(9.4,52,22,29,"PAH",94,1,0)="^^10^10^3080526"
^DIC(9.4,52,22,29,"PAH",94,1,1,0)="1. Involves the addition of a new Federal Supply Classification (FSC) "
^DIC(9.4,52,22,29,"PAH",94,1,2,0)="   Code to the FEDERAL SUPPLY CLASSIFICATION (#441.2) file."
^DIC(9.4,52,22,29,"PAH",94,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",94,1,4,0)="2. A correction to an improper reference to the Vendor Product Number"
^DIC(9.4,52,22,29,"PAH",94,1,5,0)="   during the transmission of the Electronic Request for Quotation (RFQ)."
^DIC(9.4,52,22,29,"PAH",94,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",94,1,7,0)="3. The creation of a new option that cleans out all record types in "
^DIC(9.4,52,22,29,"PAH",94,1,8,0)="   CALM/LOG CODE SHEET (#423) file and CALM/LOG TRANSMISSION"
^DIC(9.4,52,22,29,"PAH",94,1,9,0)="   RECORD (#421.2) file for a given time frame.  This is needed to "
^DIC(9.4,52,22,29,"PAH",94,1,10,0)="   cleanup old data.  "
^DIC(9.4,52,22,29,"PAH",95,0)="113 SEQ #97^3080526.155933^1"
^DIC(9.4,52,22,29,"PAH",95,1,0)="^^17^17^3080526"
^DIC(9.4,52,22,29,"PAH",95,1,1,0)="1.  Issue involves the inability of the Approving Official or Alternate "
^DIC(9.4,52,22,29,"PAH",95,1,2,0)="    Approving Official to cancel incomplete PC orders.  Currently, only "
^DIC(9.4,52,22,29,"PAH",95,1,3,0)="    the individual who placed the order can cancel the order. If the user"
^DIC(9.4,52,22,29,"PAH",95,1,4,0)="    who placed the order has left the VA there is no proper way to handle"
^DIC(9.4,52,22,29,"PAH",95,1,5,0)="    the canceling of the order.  "
^DIC(9.4,52,22,29,"PAH",95,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",95,1,7,0)="2. A correction to edits of the Edit/Remove Reconciliation "
^DIC(9.4,52,22,29,"PAH",95,1,8,0)="   [RECONCILIATION  PRCH P.C.O. ED/REMO RECONCILE] option which was"
^DIC(9.4,52,22,29,"PAH",95,1,9,0)="   affecting the Delinquent Approval Report."
^DIC(9.4,52,22,29,"PAH",95,1,10,0)=" "
^DIC(9.4,52,22,29,"PAH",95,1,11,0)="3. Issue is with a Source Code Amendment to a purchase order. When the"
^DIC(9.4,52,22,29,"PAH",95,1,12,0)="   Source Code is amended to Federal Contract there is no screen in "
^DIC(9.4,52,22,29,"PAH",95,1,13,0)="   place to make sure the item on the purchase order has a contract "
^DIC(9.4,52,22,29,"PAH",95,1,14,0)="   associated with it before approving the amendment.  "
^DIC(9.4,52,22,29,"PAH",95,1,15,0)=" "
^DIC(9.4,52,22,29,"PAH",95,1,16,0)="4. Issue involves the ability to select inactive Fund Control Point"
^DIC(9.4,52,22,29,"PAH",95,1,17,0)="   (FCP) when creating Purchase Card Orders."
^DIC(9.4,52,22,29,"PAH",96,0)="107 SEQ #98^3080526.160035^1"
^DIC(9.4,52,22,29,"PAH",96,1,0)="^^19^19^3080526"
^DIC(9.4,52,22,29,"PAH",96,1,1,0)="1. Involves the phone number extension in ELECTRONIC SIGNATURE "
^DIC(9.4,52,22,29,"PAH",96,1,2,0)="   BLOCKS.  IFCAP software is set up to display a 4 digit extension,"
^DIC(9.4,52,22,29,"PAH",96,1,3,0)="   but some sites now have a 5 digit extension.  The new 5 digit "
^DIC(9.4,52,22,29,"PAH",96,1,4,0)="   extension causes the number to not be displayed."
^DIC(9.4,52,22,29,"PAH",96,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",96,1,6,0)="2. Problem with adding a Generic Inventory point through the Manager"
^DIC(9.4,52,22,29,"PAH",96,1,7,0)="   For Supply Warehouse Inventory Point Menu [MANAGER FOR SUPPLY"
^DIC(9.4,52,22,29,"PAH",96,1,8,0)="   WAREHOUSE I] option."
^DIC(9.4,52,22,29,"PAH",96,1,9,0)=" "
^DIC(9.4,52,22,29,"PAH",96,1,10,0)="3. Problem updating the Prompt Pay Type (#4) field in the INVOICE "
^DIC(9.4,52,22,29,"PAH",96,1,11,0)="   TRACKING (#421.5) file.  This Prompt Pay Type needs to match the"
^DIC(9.4,52,22,29,"PAH",96,1,12,0)="   Financial Management System (FMS) PPAY Table.  Currently it "
^DIC(9.4,52,22,29,"PAH",96,1,13,0)="   does not."
^DIC(9.4,52,22,29,"PAH",96,1,14,0)=" "
^DIC(9.4,52,22,29,"PAH",96,1,15,0)="4. Involves the inability to delete partial orders in a given state.  The "
^DIC(9.4,52,22,29,"PAH",96,1,16,0)="   problem is not with the functionality, but with the error message that"
^DIC(9.4,52,22,29,"PAH",96,1,17,0)="   is displayed.  Currently when the user tries to delete they get a beep"
^DIC(9.4,52,22,29,"PAH",96,1,18,0)="   and ""??"".  The user should see a valid error message properly"
^DIC(9.4,52,22,29,"PAH",96,1,19,0)="   explaining the issue."
^DIC(9.4,52,22,29,"PAH",97,0)="110 SEQ #99^3080526.190808^1"
^DIC(9.4,52,22,29,"PAH",97,1,0)="^^8^8^3080526"
^DIC(9.4,52,22,29,"PAH",97,1,1,0)="1)  Resolves <FRAMESTACK> error in PRCPUSEL by eliminating the"
^DIC(9.4,52,22,29,"PAH",97,1,2,0)="    possibility of an infinite loop which had occurred at some sites."
^DIC(9.4,52,22,29,"PAH",97,1,3,0)="  "
^DIC(9.4,52,22,29,"PAH",97,1,4,0)="2)  Corrects a problem with ""Generate 2237 Requests from Repetitive"
^DIC(9.4,52,22,29,"PAH",97,1,5,0)="    Item List Entry"" (RIL) for a DynaMed RIL."
^DIC(9.4,52,22,29,"PAH",97,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",97,1,7,0)="3)  Alters the PRCHNREQ Input Template to look for the new VA FSC"
^DIC(9.4,52,22,29,"PAH",97,1,8,0)="    address rather than the old FMS address."
^DIC(9.4,52,22,29,"PAH",98,0)="112 SEQ #100^3080526.193917^1"
^DIC(9.4,52,22,29,"PAH",98,1,0)="^^7^7^3080526"
^DIC(9.4,52,22,29,"PAH",98,1,1,0)="Patch PRC*5.1*112 fixes the following:"
^DIC(9.4,52,22,29,"PAH",98,1,2,0)="a)  A rounding problem with some of the numbers in the CLO GIP"
^DIC(9.4,52,22,29,"PAH",98,1,3,0)="    REPORTS (CLRS) report."
^DIC(9.4,52,22,29,"PAH",98,1,4,0)="b)  A <SYNTAX> error when a line item list doesn't exactly match"
^DIC(9.4,52,22,29,"PAH",98,1,5,0)="    the requested format."
^DIC(9.4,52,22,29,"PAH",98,1,6,0)="c)  A cross reference in file 420.14 (PRCD FUND) which was causing"
^DIC(9.4,52,22,29,"PAH",98,1,7,0)="    wrong records to be pulled up."
^DIC(9.4,52,22,29,"PAH",99,0)="119 SEQ #101^3090421.140553^17"
^DIC(9.4,52,22,29,"PAH",99,1,0)="^^9^9^3090421"
^DIC(9.4,52,22,29,"PAH",99,1,1,0)="Description:"
^DIC(9.4,52,22,29,"PAH",99,1,2,0)="==========="
^DIC(9.4,52,22,29,"PAH",99,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",99,1,4,0)="This patch is addressing the issue regarding an <UNDEFINED> error that"
^DIC(9.4,52,22,29,"PAH",99,1,5,0)="occurred in the Bay Pines' DynaMed/IFCAP interface. Bay Pines is the only"
^DIC(9.4,52,22,29,"PAH",99,1,6,0)="site that is running the DynaMed/IFCAP interface. With the help from the"
^DIC(9.4,52,22,29,"PAH",99,1,7,0)="VistA Interface Engine (VIE) group and DynaMed, a test link between "
^DIC(9.4,52,22,29,"PAH",99,1,8,0)="DynaMed and IFCAP was created to complete the secondary review test in "
^DIC(9.4,52,22,29,"PAH",99,1,9,0)="the Bay Pines test environment."
