^DIC(9.4,4,22,1,"PAH",16,0)="43 SEQ #37^2970528^1"
^DIC(9.4,4,22,1,"PAH",16,1,0)="^^40^40^2970528"
^DIC(9.4,4,22,1,"PAH",16,1,1,0)="MailMan patch XM*7.1*43 contains the following bug fix:"
^DIC(9.4,4,22,1,"PAH",16,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",16,1,3,0)="NOIS:       DAY-0397-41813"
^DIC(9.4,4,22,1,"PAH",16,1,4,0)="Rtns:       ^XMAI1"
^DIC(9.4,4,22,1,"PAH",16,1,5,0)="Test Site:  Dayton,OH"
^DIC(9.4,4,22,1,"PAH",16,1,6,0)="Translate the date of a remote-originated message to FileMan before comparing"
^DIC(9.4,4,22,1,"PAH",16,1,7,0)="it to the purge date."
^DIC(9.4,4,22,1,"PAH",16,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",16,1,9,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",16,1,10,0)="This patch may be installed at any time, except when the IN-BASKET-PURGE"
^DIC(9.4,4,22,1,"PAH",16,1,11,0)="is running."
^DIC(9.4,4,22,1,"PAH",16,1,12,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",16,1,13,0)=" "
^DIC(9.4,4,22,1,"PAH",16,1,14,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",16,1,15,0)="1.  If any of these routines is mapped (on systems which allow mapping),"
^DIC(9.4,4,22,1,"PAH",16,1,16,0)="    disable mapping for the affected routine(s)."
^DIC(9.4,4,22,1,"PAH",16,1,17,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads"
^DIC(9.4,4,22,1,"PAH",16,1,18,0)="    the patch into a Transport Global on your system."
^DIC(9.4,4,22,1,"PAH",16,1,19,0)="3.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",16,1,20,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",16,1,21,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",16,1,22,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",16,1,23,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",16,1,24,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",16,1,25,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",16,1,26,0)="4.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",16,1,27,0)="    other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",16,1,28,0)="5.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",16,1,29,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",16,1,30,0)="  "
^DIC(9.4,4,22,1,"PAH",16,1,31,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",16,1,32,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",16,1,33,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",16,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",16,1,35,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",16,1,36,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",16,1,37,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",16,1,38,0)="XMAI1          7933692         8026797        43"
^DIC(9.4,4,22,1,"PAH",16,1,39,0)=""
^DIC(9.4,4,22,1,"PAH",16,1,40,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",17,0)="36 SEQ #38^2970528^1"
^DIC(9.4,4,22,1,"PAH",17,1,0)="^^323^323^2970528"
^DIC(9.4,4,22,1,"PAH",17,1,1,0)="MailMan patch XM*7.1*36 contains the following enhancements and bug fixes:"
^DIC(9.4,4,22,1,"PAH",17,1,2,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,3,0)="NOIS: ISF-0195-60010      Routine: ^XMAH0"
^DIC(9.4,4,22,1,"PAH",17,1,4,0)="Message range will no longer delete when user times out answering question,"
^DIC(9.4,4,22,1,"PAH",17,1,5,0)="""Are you sure?"""
^DIC(9.4,4,22,1,"PAH",17,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,7,0)="NOIS: PHO-0896-61825      Routine: ^XMA21A"
^DIC(9.4,4,22,1,"PAH",17,1,8,0)="Domain names starting with a number are valid and will no longer be rejected."
^DIC(9.4,4,22,1,"PAH",17,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,10,0)="NOIS: NOL-0896-70074      Routine: ^XMAD1A"
^DIC(9.4,4,22,1,"PAH",17,1,11,0)="Ensures that recipient multiple records start from 1."
^DIC(9.4,4,22,1,"PAH",17,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,13,0)="E3R: 7039,8898            Routine: ^XMA21A,^XMA21G"
^DIC(9.4,4,22,1,"PAH",17,1,14,0)="Users holding new security key ""XM GROUP PRIORITY"" may forward priority"
^DIC(9.4,4,22,1,"PAH",17,1,15,0)="mail to groups."
^DIC(9.4,4,22,1,"PAH",17,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,17,0)="NOIS: PIH-0496-21979      Routine: ^XMA21A"
^DIC(9.4,4,22,1,"PAH",17,1,18,0)="If NETWORK - MAX LINES @ SEND TO field is null in the KERNEL SITE PARAMETERS"
^DIC(9.4,4,22,1,"PAH",17,1,19,0)="file, the default maximum message lines is no longer 2000 - it is unlimited. "
^DIC(9.4,4,22,1,"PAH",17,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,21,0)="In connection with this, I am passing on a request from Brenda Bishop (via Hal"
^DIC(9.4,4,22,1,"PAH",17,1,22,0)="Whitley) @ ISC-BIRM.DOMAIN.EXT to all sites running CMOP (the Consolidated Mail"
^DIC(9.4,4,22,1,"PAH",17,1,23,0)="Outpatient Pharmacy Package): "
^DIC(9.4,4,22,1,"PAH",17,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,25,0)="""Sites using the Consolidated Mail Outpatient Pharmacy (CMOP) package are"
^DIC(9.4,4,22,1,"PAH",17,1,26,0)="advised to set the Kernel site parameter field [NETWORK - MAX LINES @"
^DIC(9.4,4,22,1,"PAH",17,1,27,0)="SEND TO] field to Null (without value)."""
^DIC(9.4,4,22,1,"PAH",17,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,29,0)="NOIS: TUC-0395-60417      Routine: ^XMA7G"
^DIC(9.4,4,22,1,"PAH",17,1,30,0)="                          DD: file 3.8, field .01 - add ""LAYGO"" node"
^DIC(9.4,4,22,1,"PAH",17,1,31,0)="Prevents users from adding a private mail group with the same name as a"
^DIC(9.4,4,22,1,"PAH",17,1,32,0)="public one."
^DIC(9.4,4,22,1,"PAH",17,1,33,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,34,0)="NOIS: SPO-0595-50655      Routine: ^XMYPOST6"
^DIC(9.4,4,22,1,"PAH",17,1,35,0)="                          DD:  file 3.8, field .01 - remove identifier node"
^DIC(9.4,4,22,1,"PAH",17,1,36,0)="Removes the identifier (Coordinator field) from the .01 field of the Mail"
^DIC(9.4,4,22,1,"PAH",17,1,37,0)="Group file.  (DBIA #1622)"
^DIC(9.4,4,22,1,"PAH",17,1,38,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,39,0)="NOIS: None                Routine: ^XMYPOST6"
^DIC(9.4,4,22,1,"PAH",17,1,40,0)="                          DD:  file 3.7, field 2   - add a cross reference"
^DIC(9.4,4,22,1,"PAH",17,1,41,0)="Add a new cross reference (F) on the FORWARDING ADDRESS field of the MAIL BOX"
^DIC(9.4,4,22,1,"PAH",17,1,42,0)="file.  This enables the site manager to easily find and remedy bad forwarding"
^DIC(9.4,4,22,1,"PAH",17,1,43,0)="addresses."
^DIC(9.4,4,22,1,"PAH",17,1,44,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,45,0)="NOIS: SBY-0695-30284      Routine: ^XMAP"
^DIC(9.4,4,22,1,"PAH",17,1,46,0)="If the user's institution field is set to null, '()' will no longer appear"
^DIC(9.4,4,22,1,"PAH",17,1,47,0)="after the user's name when showing institutions on mail messages."
^DIC(9.4,4,22,1,"PAH",17,1,48,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,49,0)="NOIS: ATG-0495-30025      Routine: ^XMA0"
^DIC(9.4,4,22,1,"PAH",17,1,50,0)="If you save a group of messages to a new mailbox, the zero node of the"
^DIC(9.4,4,22,1,"PAH",17,1,51,0)="message multiple will be created.  Previously, it hadn't been."
^DIC(9.4,4,22,1,"PAH",17,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,53,0)="NOIS: DAY-1096-41348      Routine: ^XMA1"
^DIC(9.4,4,22,1,"PAH",17,1,54,0)="If '^' is contained in the response to 'Select message action' prompt,"
^DIC(9.4,4,22,1,"PAH",17,1,55,0)="MM will up-arrow out."
^DIC(9.4,4,22,1,"PAH",17,1,56,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,57,0)="NOIS: None                Routine: ^XMA5A,^XMAI2,^XMAPHOST,^XMUT5G"
^DIC(9.4,4,22,1,"PAH",17,1,58,0)="Remove references to the old user file:  ^DIC(3"
^DIC(9.4,4,22,1,"PAH",17,1,59,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,60,0)="NOIS: SDC-1296-61151      Routine: ^XMA0,^XMA1"
^DIC(9.4,4,22,1,"PAH",17,1,61,0)="Correct MailMan's response if the user chooses not to proceed with message"
^DIC(9.4,4,22,1,"PAH",17,1,62,0)="termination."
^DIC(9.4,4,22,1,"PAH",17,1,63,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,64,0)="NOIS: None                Routine: ^XMA21G"
^DIC(9.4,4,22,1,"PAH",17,1,65,0)="Reference mail message #22778858 on FORUM from Milt Roberson.  MM aborted"
^DIC(9.4,4,22,1,"PAH",17,1,66,0)="when trying to expand a group which included a remote member at a numeric"
^DIC(9.4,4,22,1,"PAH",17,1,67,0)="address at compuserve.com.  This fixes that."
^DIC(9.4,4,22,1,"PAH",17,1,68,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,69,0)="NOIS: BRX-0197-10241      Routine: ^XMA0,^XMA01"
^DIC(9.4,4,22,1,"PAH",17,1,70,0)="At the <save,delete,terminate,print> ""which messages"" prompt, if the user's"
^DIC(9.4,4,22,1,"PAH",17,1,71,0)="answer includes ^, then the function is aborted."
^DIC(9.4,4,22,1,"PAH",17,1,72,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,73,0)="E3R: 9311                 Routine: ^XMA7G"
^DIC(9.4,4,22,1,"PAH",17,1,74,0)="Users enrolled in a mail group which does not allow self-enrollment can no"
^DIC(9.4,4,22,1,"PAH",17,1,75,0)="longer disenroll themselves."
^DIC(9.4,4,22,1,"PAH",17,1,76,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,77,0)="NOIS: None                Routine: ^XMR1A"
^DIC(9.4,4,22,1,"PAH",17,1,78,0)="Prevent subscript in global reference from being more than 64 characters long."
^DIC(9.4,4,22,1,"PAH",17,1,79,0)="Reference FORUM msg #23054338."
^DIC(9.4,4,22,1,"PAH",17,1,80,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,81,0)="NOIS: MEM-0197-70649      Routine: ^XMBGRP"
^DIC(9.4,4,22,1,"PAH",17,1,82,0)="Routine no longer attempts to write to the screen during 'silent' calls."
^DIC(9.4,4,22,1,"PAH",17,1,83,0)="Documentation corrected.  Parameter 'D' in call to function $$MG^XMBGRP,"
^DIC(9.4,4,22,1,"PAH",17,1,84,0)="if set to 0 will not allow self-enrollment in a group; 1 will allow."
^DIC(9.4,4,22,1,"PAH",17,1,85,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,86,0)="Replace the description of $$MG^XMBGRP on page 31 of the Programmer Reference"
^DIC(9.4,4,22,1,"PAH",17,1,87,0)="Manual with the following: "
^DIC(9.4,4,22,1,"PAH",17,1,88,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,89,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",17,1,90,0)="$$MG^XMBGRP"
^DIC(9.4,4,22,1,"PAH",17,1,91,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,92,0)="This extrinsic function is used to create a new mail group or to add members"
^DIC(9.4,4,22,1,"PAH",17,1,93,0)="to an existing mail group.  Only local users may be enrolled as members with"
^DIC(9.4,4,22,1,"PAH",17,1,94,0)="this function."
^DIC(9.4,4,22,1,"PAH",17,1,95,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,96,0)="Usage:  S X=$$MG^XMBGRP(A,B,C,D,.E,.F,G)"
^DIC(9.4,4,22,1,"PAH",17,1,97,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,98,0)="(B,C,D,.F are ignored if the mail group previously exists.)"
^DIC(9.4,4,22,1,"PAH",17,1,99,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,100,0)="If successful, X will have the value of the mail group internal entry number."
^DIC(9.4,4,22,1,"PAH",17,1,101,0)="If unsuccessful, X will be zero."
^DIC(9.4,4,22,1,"PAH",17,1,102,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,103,0)="Where:"
^DIC(9.4,4,22,1,"PAH",17,1,104,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,105,0)="A =Mail group name (if new group)"
^DIC(9.4,4,22,1,"PAH",17,1,106,0)="   Mail group internal entry number (if existing group)"
^DIC(9.4,4,22,1,"PAH",17,1,107,0)="B =Mail group type flag (0=public; 1=private)"
^DIC(9.4,4,22,1,"PAH",17,1,108,0)="C =DUZ of organizer (.5=Postmaster assumed, if 0 passed)"
^DIC(9.4,4,22,1,"PAH",17,1,109,0)="D =Self enrollment allowed flag (0=no; 1=yes)"
^DIC(9.4,4,22,1,"PAH",17,1,110,0)=".E=Array of members to be enrolled."
^DIC(9.4,4,22,1,"PAH",17,1,111,0)="   Members must be local users."
^DIC(9.4,4,22,1,"PAH",17,1,112,0)="   Array must consist of DUZ's only; not names."
^DIC(9.4,4,22,1,"PAH",17,1,113,0)="   E(n)="""", where n is the member's DUZ."
^DIC(9.4,4,22,1,"PAH",17,1,114,0)=".F=Mail group description array."
^DIC(9.4,4,22,1,"PAH",17,1,115,0)="   F(1)=""first line"""
^DIC(9.4,4,22,1,"PAH",17,1,116,0)="   F(2)=""second line"""
^DIC(9.4,4,22,1,"PAH",17,1,117,0)="   etc."
^DIC(9.4,4,22,1,"PAH",17,1,118,0)="G =Silent flag (0=interactive; 1=silent)"
^DIC(9.4,4,22,1,"PAH",17,1,119,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",17,1,120,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,121,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",17,1,122,0)="Reference message #23076068 on FORUM from Skip Williams.  Correct the"
^DIC(9.4,4,22,1,"PAH",17,1,123,0)="documentation on page 46 of the 'Programmer Reference Manual'."
^DIC(9.4,4,22,1,"PAH",17,1,124,0)="In the Example, Step 3 -- Deliver Message to Recipients, the last line of"
^DIC(9.4,4,22,1,"PAH",17,1,125,0)="code should be:"
^DIC(9.4,4,22,1,"PAH",17,1,126,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,127,0)="        D ENT1^XMD ; Call for MailMan Delivery"
^DIC(9.4,4,22,1,"PAH",17,1,128,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,129,0)="NOIS: none                Routines: ^XMA21G,^XMA7G,^XMAD1,"
^DIC(9.4,4,22,1,"PAH",17,1,130,0)="                                    ^XMAD1A,^XMA5A,^XMFAX"
^DIC(9.4,4,22,1,"PAH",17,1,131,0)="                          DD:  file 3.8, field 14 (new)"
^DIC(9.4,4,22,1,"PAH",17,1,132,0)="                               file 3.8, field 15 (new)"
^DIC(9.4,4,22,1,"PAH",17,1,133,0)="                               file 3.9, (within Recipient multiple)"
^DIC(9.4,4,22,1,"PAH",17,1,134,0)="                                         field 13 (new)"
^DIC(9.4,4,22,1,"PAH",17,1,135,0)="                               file 3.9, (within Recipient multiple)"
^DIC(9.4,4,22,1,"PAH",17,1,136,0)="                                         field 14 (new)"
^DIC(9.4,4,22,1,"PAH",17,1,137,0)="                               file 4.3, field 143 (new)"
^DIC(9.4,4,22,1,"PAH",17,1,138,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,139,0)="MailMan, with this patch, is now able to fax messages.  Currently, only FORUM"
^DIC(9.4,4,22,1,"PAH",17,1,140,0)="(to my knowledge) is able to take advantage of this new capability, which"
^DIC(9.4,4,22,1,"PAH",17,1,141,0)="requires the presence of the AKF* suite of fax software and files and fax"
^DIC(9.4,4,22,1,"PAH",17,1,142,0)="capability.  The site manager should indicate whether or not the site is"
^DIC(9.4,4,22,1,"PAH",17,1,143,0)="fax-enabled by setting the new field #143 in file 4.3 (default is ""no""). "
^DIC(9.4,4,22,1,"PAH",17,1,144,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,145,0)="Two new mail group multiples have been added to the Mail Group file:  Fax"
^DIC(9.4,4,22,1,"PAH",17,1,146,0)="Recipient, and Fax Group.  These multiples point to associated files in the fax"
^DIC(9.4,4,22,1,"PAH",17,1,147,0)="(AKF*) suite.  These files (^AKF(""FAXR"", Fax Rolodex, and ^AKF(""FAXG"", Fax"
^DIC(9.4,4,22,1,"PAH",17,1,148,0)="Group) must be populated through the fax suite.  LAYGO through MailMan is not"
^DIC(9.4,4,22,1,"PAH",17,1,149,0)="permitted. "
^DIC(9.4,4,22,1,"PAH",17,1,150,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,151,0)="When a mail message is sent (or forwarded) to a mail group with these fax"
^DIC(9.4,4,22,1,"PAH",17,1,152,0)="multiples populated, the message is also transferred to the fax suite, and a"
^DIC(9.4,4,22,1,"PAH",17,1,153,0)="task is queued to fax the message to those recipients pointed to by the group. "
^DIC(9.4,4,22,1,"PAH",17,1,154,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,155,0)="Fax recipients are faxed only the original message.  Replies to mail messages"
^DIC(9.4,4,22,1,"PAH",17,1,156,0)="are not faxed. Replies are not delivered as e-mail to fax recipients, unless"
^DIC(9.4,4,22,1,"PAH",17,1,157,0)="they are also on the message as ""normal"" recipients. "
^DIC(9.4,4,22,1,"PAH",17,1,158,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,159,0)="MailMan faxes do not have a cover page.  They print in much the same way as a"
^DIC(9.4,4,22,1,"PAH",17,1,160,0)="message is printed on a printer. "
^DIC(9.4,4,22,1,"PAH",17,1,161,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,162,0)="Individual fax recipients are stored in the recipient multiple of the message"
^DIC(9.4,4,22,1,"PAH",17,1,163,0)="(identified as F.<fax recipient>).  A ""Query"" of the message will reveal that"
^DIC(9.4,4,22,1,"PAH",17,1,164,0)="the message was sent to the Mail Group.  A ""Query Detail"" will reveal fax"
^DIC(9.4,4,22,1,"PAH",17,1,165,0)="recipients, when the message was transferred to the fax suite, and the fax ID"
^DIC(9.4,4,22,1,"PAH",17,1,166,0)="assigned to it by the fax suite, but will not reveal the transmission status. "
^DIC(9.4,4,22,1,"PAH",17,1,167,0)="(The user can ascertain the transmission status via the fax suite and the fax"
^DIC(9.4,4,22,1,"PAH",17,1,168,0)="ID.) "
^DIC(9.4,4,22,1,"PAH",17,1,169,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,170,0)="!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
^DIC(9.4,4,22,1,"PAH",17,1,171,0)="NOT INCLUDED in this patch is:"
^DIC(9.4,4,22,1,"PAH",17,1,172,0)="1) a necessary change to ^AKFAX to enable it to"
^DIC(9.4,4,22,1,"PAH",17,1,173,0)="recognize a MailMan Fax so that it can suppress the cover page for MailMan"
^DIC(9.4,4,22,1,"PAH",17,1,174,0)="faxes and address the fax to the recipient (""MailMan Fax for ... "")."
^DIC(9.4,4,22,1,"PAH",17,1,175,0)="2) a new field in file #589500 - ^AKF(""FAX"", FAX TRANSMISSION FILE"
^DIC(9.4,4,22,1,"PAH",17,1,176,0)="589500,3    MAILMAN FAX       0;4 SET OF CODES"
^DIC(9.4,4,22,1,"PAH",17,1,177,0)="                              '0' FOR NO;"
^DIC(9.4,4,22,1,"PAH",17,1,178,0)="                              '1' FOR YES;"
^DIC(9.4,4,22,1,"PAH",17,1,179,0)="            HELP-PROMPT:      Is this a MailMan-generated fax?"
^DIC(9.4,4,22,1,"PAH",17,1,180,0)="            DESCRIPTION:      Routine ^AKFAX checks this field to see if the"
^DIC(9.4,4,22,1,"PAH",17,1,181,0)="                              fax is a MailMan generated fax.  If it is, then"
^DIC(9.4,4,22,1,"PAH",17,1,182,0)="                              1) the fax cover sheet is suppressed and"
^DIC(9.4,4,22,1,"PAH",17,1,183,0)="                              2) two additional lines are added to the top of"
^DIC(9.4,4,22,1,"PAH",17,1,184,0)="                              the fax, identifying the recipient and the fax ID."
^DIC(9.4,4,22,1,"PAH",17,1,185,0)="!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
^DIC(9.4,4,22,1,"PAH",17,1,186,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,187,0)="Following are DD extracts of the new fields:"
^DIC(9.4,4,22,1,"PAH",17,1,188,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,189,0)="STANDARD DATA DICTIONARY #4.3 -- KERNEL SITE PARAMETERS FILE STORED IN ^XMB(1,"
^DIC(9.4,4,22,1,"PAH",17,1,190,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,191,0)="4.3,143     FAX ENABLED       0;19 SET OF CODES"
^DIC(9.4,4,22,1,"PAH",17,1,192,0)="                              '0' FOR no; "
^DIC(9.4,4,22,1,"PAH",17,1,193,0)="                              '1' FOR yes; "
^DIC(9.4,4,22,1,"PAH",17,1,194,0)="            HELP-PROMPT:      Is your site fax enabled? "
^DIC(9.4,4,22,1,"PAH",17,1,195,0)="            DESCRIPTION:      Your site is fax enabled if you have the suite"
^DIC(9.4,4,22,1,"PAH",17,1,196,0)="                              of fax software and files (^AKF) and fax"
^DIC(9.4,4,22,1,"PAH",17,1,197,0)="                              capability and you choose to allow faxes to be"
^DIC(9.4,4,22,1,"PAH",17,1,198,0)="                              sent via MailMan.  "
^DIC(9.4,4,22,1,"PAH",17,1,199,0)="                              To send faxes via MailMan, Mail groups (file"
^DIC(9.4,4,22,1,"PAH",17,1,200,0)="                              3.8) must first be populated in the fax"
^DIC(9.4,4,22,1,"PAH",17,1,201,0)="                              recipient and fax group multiples.  Then, when"
^DIC(9.4,4,22,1,"PAH",17,1,202,0)="                              a user sends a message to a mail group, the"
^DIC(9.4,4,22,1,"PAH",17,1,203,0)="                              message is also faxed to any fax recipients in"
^DIC(9.4,4,22,1,"PAH",17,1,204,0)="                              that mail group."
^DIC(9.4,4,22,1,"PAH",17,1,205,0)="                              Responses to the message are not faxed."
^DIC(9.4,4,22,1,"PAH",17,1,206,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,207,0)="STANDARD DATA DICTIONARY #3.8 -- MAIL GROUP FILE          STORED IN ^XMB(3.8, "
^DIC(9.4,4,22,1,"PAH",17,1,208,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,209,0)="3.8,14      FAX RECIPIENT     8;0 POINTER Multiple #3.814"
^DIC(9.4,4,22,1,"PAH",17,1,210,0)="3.814,.01     FAX RECIPIENT     0;1 POINTER TO FAX ROLODEX FILE (#589499)"
^DIC(9.4,4,22,1,"PAH",17,1,211,0)="                                 (Multiply asked)"
^DIC(9.4,4,22,1,"PAH",17,1,212,0)="              HELP-PROMPT:      Enter the fax recipient who should receive "
^DIC(9.4,4,22,1,"PAH",17,1,213,0)="                                faxes sent to this mail group. "
^DIC(9.4,4,22,1,"PAH",17,1,214,0)="              DESCRIPTION:      This is a list of individual recipients who"
^DIC(9.4,4,22,1,"PAH",17,1,215,0)="                                will receive by fax any mail sent to this"
^DIC(9.4,4,22,1,"PAH",17,1,216,0)="                                mail group.  They receive the original"
^DIC(9.4,4,22,1,"PAH",17,1,217,0)="                                message only.  They do not receive responses."
^DIC(9.4,4,22,1,"PAH",17,1,218,0)="              CROSS-REFERENCE:  3.814^B "
^DIC(9.4,4,22,1,"PAH",17,1,219,0)="                                1)= S ^XMB(3.8,DA(1),8,""B"",$E(X,1,30),DA)="""""
^DIC(9.4,4,22,1,"PAH",17,1,220,0)="                                2)= K ^XMB(3.8,DA(1),8,""B"",$E(X,1,30),DA)"
^DIC(9.4,4,22,1,"PAH",17,1,221,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,222,0)="3.8,15      FAX GROUP           9;0 POINTER Multiple #3.815"
^DIC(9.4,4,22,1,"PAH",17,1,223,0)="3.815,.01     FAX GROUP           0;1 POINTER TO FAX GROUP FILE (#589498)"
^DIC(9.4,4,22,1,"PAH",17,1,224,0)="                                 (Multiply asked)"
^DIC(9.4,4,22,1,"PAH",17,1,225,0)="              INPUT TRANSFORM:  S DIC(""S"")=""N XM S XM=$G(^(3)) I $P(XM,U,2)!("
^DIC(9.4,4,22,1,"PAH",17,1,226,0)="                                $G(XMDUZ,DUZ)=+XM)"" D ^DIC K DIC S DIC=DIE,X="
^DIC(9.4,4,22,1,"PAH",17,1,227,0)="                                +Y K:Y<0 X"
^DIC(9.4,4,22,1,"PAH",17,1,228,0)="              HELP-PROMPT:      Enter the fax group which should receive "
^DIC(9.4,4,22,1,"PAH",17,1,229,0)="                                faxes sent to this mail group. "
^DIC(9.4,4,22,1,"PAH",17,1,230,0)="              DESCRIPTION:      Each member of the fax group will receive by"
^DIC(9.4,4,22,1,"PAH",17,1,231,0)="                                fax any message sent to this mail group. "
^DIC(9.4,4,22,1,"PAH",17,1,232,0)="                                Only the original message will be faxed. "
^DIC(9.4,4,22,1,"PAH",17,1,233,0)="                                Responses will not be faxed.  "
^DIC(9.4,4,22,1,"PAH",17,1,234,0)="              SCREEN:           S DIC(""S"")=""N XM S XM=$G(^(3))"
^DIC(9.4,4,22,1,"PAH",17,1,235,0)="                                           I $P(XM,U,2)!($G(XMDUZ,DUZ)=+XM)"""
^DIC(9.4,4,22,1,"PAH",17,1,236,0)="              EXPLANATION:      Group must be public or user must be"
^DIC(9.4,4,22,1,"PAH",17,1,237,0)="                                (surrogate of) creator of group."
^DIC(9.4,4,22,1,"PAH",17,1,238,0)="              CROSS-REFERENCE:  3.815^B "
^DIC(9.4,4,22,1,"PAH",17,1,239,0)="                                1)= S ^XMB(3.8,DA(1),9,""B"",$E(X,1,30),DA)="""""
^DIC(9.4,4,22,1,"PAH",17,1,240,0)="                                2)= K ^XMB(3.8,DA(1),9,""B"",$E(X,1,30),DA)"
^DIC(9.4,4,22,1,"PAH",17,1,241,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,242,0)="STANDARD DATA DICTIONARY #3.9 -- MESSAGE FILE     STORED IN ^XMB(3.9,"
^DIC(9.4,4,22,1,"PAH",17,1,243,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,244,0)="3.91,13   FAX RECIPIENT         0;11 POINTER TO FAX ROLODEX FILE (#589499)"
^DIC(9.4,4,22,1,"PAH",17,1,245,0)="              HELP-PROMPT:      Enter the fax recipient "
^DIC(9.4,4,22,1,"PAH",17,1,246,0)="              DESCRIPTION:      When the message is addressed to a fax"
^DIC(9.4,4,22,1,"PAH",17,1,247,0)="                                recipient, this field points to the fax"
^DIC(9.4,4,22,1,"PAH",17,1,248,0)="                                rolodex file.  After the message is handed"
^DIC(9.4,4,22,1,"PAH",17,1,249,0)="                                off to the fax software, the pointer in this"
^DIC(9.4,4,22,1,"PAH",17,1,250,0)="                                field is deleted, the STATUS field is deleted,"
^DIC(9.4,4,22,1,"PAH",17,1,251,0)="                                and the FAX ID field is set to the fax ID"
^DIC(9.4,4,22,1,"PAH",17,1,252,0)="                                number assigned to it by the fax software."
^DIC(9.4,4,22,1,"PAH",17,1,253,0)="              CROSS-REFERENCE:  3.91^AFAX "
^DIC(9.4,4,22,1,"PAH",17,1,254,0)="                                1)= S ^XMB(3.9,DA(1),1,""AFAX"",$E(X,1,30),DA)="""""
^DIC(9.4,4,22,1,"PAH",17,1,255,0)="                                2)= K ^XMB(3.9,DA(1),1,""AFAX"",$E(X,1,30),DA)"
^DIC(9.4,4,22,1,"PAH",17,1,256,0)="                                This cross reference makes it possible for"
^DIC(9.4,4,22,1,"PAH",17,1,257,0)="                                MailMan to immediately find the recipients"
^DIC(9.4,4,22,1,"PAH",17,1,258,0)="                                to fax a message to."
^DIC(9.4,4,22,1,"PAH",17,1,259,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,260,0)="3.91,14   FAX ID                0;12 FREE TEXT (1-14 CHARS)"
^DIC(9.4,4,22,1,"PAH",17,1,261,0)="              HELP-PROMPT:      Enter the fax ID"
^DIC(9.4,4,22,1,"PAH",17,1,262,0)="              DESCRIPTION:      This is the fax ID as assigned to it by the"
^DIC(9.4,4,22,1,"PAH",17,1,263,0)="                                fax software (^AKF*)."
^DIC(9.4,4,22,1,"PAH",17,1,264,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,265,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",17,1,266,0)=""
^DIC(9.4,4,22,1,"PAH",17,1,267,0)=" This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",17,1,268,0)=" minimum.  You should put the XMUSER Option out of order and shut down"
^DIC(9.4,4,22,1,"PAH",17,1,269,0)=" mail delivery tasks.  A cross reference (""F"", on FORWARDING ADDRESS) is"
^DIC(9.4,4,22,1,"PAH",17,1,270,0)=" being added to the MAIL BOX file, and a lock must be placed on the whole"
^DIC(9.4,4,22,1,"PAH",17,1,271,0)=" global for the duration of the indexing.  If the lock cannot be obtained,"
^DIC(9.4,4,22,1,"PAH",17,1,272,0)=" the indexing of the new cross reference will not run.  If the indexing does"
^DIC(9.4,4,22,1,"PAH",17,1,273,0)=" not run, you can do it later by running ^XMYPOST6 yourself.  ^XMYPOST6"
^DIC(9.4,4,22,1,"PAH",17,1,274,0)=" will take about 1 minute per 2500 users in the ^XMB(3.7 global."
^DIC(9.4,4,22,1,"PAH",17,1,275,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",17,1,276,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,277,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",17,1,278,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",17,1,279,0)="      so you will need to disable mapping for the effected routine."
^DIC(9.4,4,22,1,"PAH",17,1,280,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",17,1,281,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",17,1,282,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",17,1,283,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",17,1,284,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",17,1,285,0)="      options:"
^DIC(9.4,4,22,1,"PAH",17,1,286,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",17,1,287,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",17,1,288,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",17,1,289,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",17,1,290,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",17,1,291,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",17,1,292,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",17,1,293,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",17,1,294,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",17,1,295,0)="  "
^DIC(9.4,4,22,1,"PAH",17,1,296,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",17,1,297,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",17,1,298,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",17,1,299,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,300,0)="                Before          After"
^DIC(9.4,4,22,1,"PAH",17,1,301,0)=" Name          Checksum       Checksum          Patch List"
^DIC(9.4,4,22,1,"PAH",17,1,302,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",17,1,303,0)=" "
^DIC(9.4,4,22,1,"PAH",17,1,304,0)=" XMA0           9701230       10480365          15,36"
