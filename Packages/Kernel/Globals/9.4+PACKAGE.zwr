^DIC(9.4,13,22,8,"PAH",9,1,250,0)="    "
^DIC(9.4,13,22,8,"PAH",9,1,251,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",9,1,252,0)="=========================="
^DIC(9.4,13,22,8,"PAH",9,1,253,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to be"
^DIC(9.4,13,22,8,"PAH",9,1,254,0)="   STOPPED. Failure to do so may result in a 'source routine edited'"
^DIC(9.4,13,22,8,"PAH",9,1,255,0)="   error, the edits will be lost and records may be left in an"
^DIC(9.4,13,22,8,"PAH",9,1,256,0)="   inconsistent state."
^DIC(9.4,13,22,8,"PAH",9,1,257,0)="**"
^DIC(9.4,13,22,8,"PAH",9,1,258,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,259,0)="     1.  AXP sites: Review your mapped routine set.  If any of the routine(s)"
^DIC(9.4,13,22,8,"PAH",9,1,260,0)="listed in the ROUTINE SUMMARY section are mapped, they should be removed from"
^DIC(9.4,13,22,8,"PAH",9,1,261,0)="the mapped set at this time."
^DIC(9.4,13,22,8,"PAH",9,1,262,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,263,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,13,22,8,"PAH",9,1,264,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,8,"PAH",9,1,265,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,266,0)="The environment check routine DIENVWRN will run automatically.  Routine "
^DIC(9.4,13,22,8,"PAH",9,1,267,0)="DIENVWRN is sent in order to prevent the inadvertent queuing during the "
^DIC(9.4,13,22,8,"PAH",9,1,268,0)="installation of this patch."
^DIC(9.4,13,22,8,"PAH",9,1,269,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,270,0)="     3.  The patch has now been loaded into a transport global on your system."
^DIC(9.4,13,22,8,"PAH",9,1,271,0)="You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",9,1,272,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,273,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",9,1,274,0)="following options:"
^DIC(9.4,13,22,8,"PAH",9,1,275,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,276,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",9,1,277,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",9,1,278,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",9,1,279,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",9,1,280,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,281,0)="     5.  Inhibit users' login into the system.  The consequence of having"
^DIC(9.4,13,22,8,"PAH",9,1,282,0)="users on the system while installing this patch are that users editing"
^DIC(9.4,13,22,8,"PAH",9,1,283,0)="records will get a 'source routine edited' error, the edits will be lost"
^DIC(9.4,13,22,8,"PAH",9,1,284,0)="and records may be left in an inconsistent state.  Note that most of these"
^DIC(9.4,13,22,8,"PAH",9,1,285,0)="routines are heavily used in DHCP applications."
^DIC(9.4,13,22,8,"PAH",9,1,286,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,287,0)="     6.  AXP Sites - Place TaskMan in a WAIT State.  "
^DIC(9.4,13,22,8,"PAH",9,1,288,0)="         OpenM/Cache Sites - STOP TaskMan.  "
^DIC(9.4,13,22,8,"PAH",9,1,289,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,290,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,8,"PAH",9,1,291,0)="option: "
^DIC(9.4,13,22,8,"PAH",9,1,292,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",9,1,293,0)="            Select INSTALL NAME: DI*22.0*4"
^DIC(9.4,13,22,8,"PAH",9,1,294,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",9,1,295,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,296,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,8,"PAH",9,1,297,0)="and Protocols? "
^DIC(9.4,13,22,8,"PAH",9,1,298,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,299,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,300,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map set,"
^DIC(9.4,13,22,8,"PAH",9,1,301,0)="if necessary. "
^DIC(9.4,13,22,8,"PAH",9,1,302,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,303,0)="     9.  AXP Sites - Remove TaskMan from WAIT State.  "
^DIC(9.4,13,22,8,"PAH",9,1,304,0)="         OpenM/Cache Sites - Restart TaskMan.  "
^DIC(9.4,13,22,8,"PAH",9,1,305,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,306,0)="    10.  Enable users' login.  "
^DIC(9.4,13,22,8,"PAH",10,0)="2 SEQ #10^2991210^1"
^DIC(9.4,13,22,8,"PAH",10,1,0)="^^170^170^2991210"
^DIC(9.4,13,22,8,"PAH",10,1,1,0)="Y2K Waiver ID#:  Y2KW0001               Y2K Waiver Status: Approved"
^DIC(9.4,13,22,8,"PAH",10,1,2,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,3,0)=">>              This patch may be installed during the Y2K Moratorium,"
^DIC(9.4,13,22,8,"PAH",10,1,4,0)="either BEFORE 12/15/99 or AFTER 1/15/2000."
^DIC(9.4,13,22,8,"PAH",10,1,5,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,6,0)=">>             This patch MAY NOT be installed between 12/15/1999 and"
^DIC(9.4,13,22,8,"PAH",10,1,7,0)="1/15/2000 (the Y2K Lockdown Period)."
^DIC(9.4,13,22,8,"PAH",10,1,8,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,9,0)="Bug Fix: "
^DIC(9.4,13,22,8,"PAH",10,1,10,0)="========"
^DIC(9.4,13,22,8,"PAH",10,1,11,0)="1.  If a user specified a print field whose data type definition is a"
^DIC(9.4,13,22,8,"PAH",10,1,12,0)="Date/Time and they used a date Function along with the Count(!) operator,"
^DIC(9.4,13,22,8,"PAH",10,1,13,0)="the FileMan internal representation would be printed.  For example,"
^DIC(9.4,13,22,8,"PAH",10,1,14,0)="!MONTH(DATE FIELD)"
^DIC(9.4,13,22,8,"PAH",10,1,15,0)="    (NOIS: SAJ-1198-72266)"
^DIC(9.4,13,22,8,"PAH",10,1,16,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,17,0)="2.  Previous to this patch FileMan Sorts were limited to 7 levels."
^DIC(9.4,13,22,8,"PAH",10,1,18,0)="With this patch the maximum number of Sort levels has been increased to"
^DIC(9.4,13,22,8,"PAH",10,1,19,0)="15.  "
^DIC(9.4,13,22,8,"PAH",10,1,20,0)="    (NOIS: WBP-0795-21830; DAY-0297-41337)"
^DIC(9.4,13,22,8,"PAH",10,1,21,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,22,0)="3.  When computing global length and comparing it to what was set in the"
^DIC(9.4,13,22,8,"PAH",10,1,23,0)="MUMPS OPERATING SYSTEM file, Global Subscript truncation would begin"
^DIC(9.4,13,22,8,"PAH",10,1,24,0)="before it was necessary."
^DIC(9.4,13,22,8,"PAH",10,1,25,0)="    (NOIS: IOW-0998-40306)"
^DIC(9.4,13,22,8,"PAH",10,1,26,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,27,0)="4.  When a Sort contain a Boolean expression, for example, MY FIELD[""A"","
^DIC(9.4,13,22,8,"PAH",10,1,28,0)="the Boolean operator was getting concatenated with the field name such"
^DIC(9.4,13,22,8,"PAH",10,1,29,0)="that a user could not edit the Sort template."
^DIC(9.4,13,22,8,"PAH",10,1,30,0)="    (NOIS: ISA-0395-10001)"
^DIC(9.4,13,22,8,"PAH",10,1,31,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,32,0)="5.  Improvement to Descriptive Statistics and correction to Histogram"
^DIC(9.4,13,22,8,"PAH",10,1,33,0)="report header."
^DIC(9.4,13,22,8,"PAH",10,1,34,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,35,0)="6.  If a user used the dot syntax for a date and the field is a DATE type"
^DIC(9.4,13,22,8,"PAH",10,1,36,0)="and the TIME can be entered, an ""????Invalid Entry"" error message would be"
^DIC(9.4,13,22,8,"PAH",10,1,37,0)="displayed or the data would not be displayed even though there was data"
^DIC(9.4,13,22,8,"PAH",10,1,38,0)="that should have been displayed.  For example:"
^DIC(9.4,13,22,8,"PAH",10,1,39,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,40,0)="    GO TO FOIA REQUESTED DATE: LAST// 1.MAR.97"
^DIC(9.4,13,22,8,"PAH",10,1,41,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,42,0)="    (NOIS: CLA-0197-20856, VAC-1197-21817)"
^DIC(9.4,13,22,8,"PAH",10,1,43,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,44,0)="7.  If a user was using the ""!"" in a print field and printed the same"
^DIC(9.4,13,22,8,"PAH",10,1,45,0)="field again, an erroneous Count was reported which was twice the number of"
^DIC(9.4,13,22,8,"PAH",10,1,46,0)="counted items."
^DIC(9.4,13,22,8,"PAH",10,1,47,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,48,0)="    Example #1: In this example the output is correct as documentated the"
^DIC(9.4,13,22,8,"PAH",10,1,49,0)="    v22 Getting Started Manual, Section: Printing Statistics Only."
^DIC(9.4,13,22,8,"PAH",10,1,50,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,51,0)=" Select OPTION:    PRINT FILE ENTRIES"
^DIC(9.4,13,22,8,"PAH",10,1,52,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,53,0)=" OUTPUT FROM WHAT FILE: NUMBER AND KIDS// "
^DIC(9.4,13,22,8,"PAH",10,1,54,0)=" SORT BY: NAME// "
^DIC(9.4,13,22,8,"PAH",10,1,55,0)=" START WITH NAME: FIRST// "
^DIC(9.4,13,22,8,"PAH",10,1,56,0)=" FIRST PRINT FIELD: !NAME  "
^DIC(9.4,13,22,8,"PAH",10,1,57,0)=" THEN PRINT FIELD: "
^DIC(9.4,13,22,8,"PAH",10,1,58,0)=" Heading (S/C): NUMBER AND KIDS STATISTICS  Replace "
^DIC(9.4,13,22,8,"PAH",10,1,59,0)=" DEVICE:   Telnet terminal"
^DIC(9.4,13,22,8,"PAH",10,1,60,0)=" NUMBER AND KIDS STATISTICS                JUL 23,1999  13:34    PAGE 1"
^DIC(9.4,13,22,8,"PAH",10,1,61,0)="          NAME"
^DIC(9.4,13,22,8,"PAH",10,1,62,0)=" -------------------------------------------------------------------------"
^DIC(9.4,13,22,8,"PAH",10,1,63,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,64,0)=" COUNT     3"
^DIC(9.4,13,22,8,"PAH",10,1,65,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,66,0)="    Example #2: This is an example of the fixed output.  Please note the"
^DIC(9.4,13,22,8,"PAH",10,1,67,0)="    PRINT FIELD entry order does not matter."
^DIC(9.4,13,22,8,"PAH",10,1,68,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,69,0)=" OUTPUT FROM WHAT FILE: MUMPS OPERATING SYSTEM// "
^DIC(9.4,13,22,8,"PAH",10,1,70,0)=" SORT BY: NAME// "
^DIC(9.4,13,22,8,"PAH",10,1,71,0)=" START WITH NAME: FIRST// "
^DIC(9.4,13,22,8,"PAH",10,1,72,0)=" FIRST PRINT FIELD: !NAME  "
^DIC(9.4,13,22,8,"PAH",10,1,73,0)=" THEN PRINT FIELD: NAME  "
^DIC(9.4,13,22,8,"PAH",10,1,74,0)=" THEN PRINT FIELD: "
^DIC(9.4,13,22,8,"PAH",10,1,75,0)=" Heading (S/C): MUMPS OPERATING SYSTEM STATISTICS  Replace "
^DIC(9.4,13,22,8,"PAH",10,1,76,0)=" DEVICE:   SYSTEM"
^DIC(9.4,13,22,8,"PAH",10,1,77,0)=" MUMPS OPERATING SYSTEM STATISTICS          SEP 14,1999  07:06    PAGE 1"
^DIC(9.4,13,22,8,"PAH",10,1,78,0)="          NAME                            NAME"
^DIC(9.4,13,22,8,"PAH",10,1,79,0)=" -------------------------------------------------------------------------"
^DIC(9.4,13,22,8,"PAH",10,1,80,0)=" "
