^DIC(9.4,13,22,9,"PAH",10,1,74,0)="FileMan 22.2 Technical Manual  FM22_2TM.PDF              Binary"
^DIC(9.4,13,22,9,"PAH",10,1,75,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,76,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,77,0)="Patch Installation:"
^DIC(9.4,13,22,9,"PAH",10,1,78,0)="-------------------"
^DIC(9.4,13,22,9,"PAH",10,1,79,0)="Software is being released as a host file, DI_222_9_VPR_1_8.KID.  The host"
^DIC(9.4,13,22,9,"PAH",10,1,80,0)="file contains two patches; DI*22.2*9 and VPR*1*8."
^DIC(9.4,13,22,9,"PAH",10,1,81,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,82,0)="Patches DI*22.2*9 and VPR*1*8 are scheduled to be released nationally as a"
^DIC(9.4,13,22,9,"PAH",10,1,83,0)="bundle.  Installation of these patches into Production within the first 15"
^DIC(9.4,13,22,9,"PAH",10,1,84,0)="days from the National Release date is requested. The VA leadership has asked"
^DIC(9.4,13,22,9,"PAH",10,1,85,0)="for an expedited release to comply with the schedule for the high profile"
^DIC(9.4,13,22,9,"PAH",10,1,86,0)="Mission Act.  Certain functionality has to be loaded into production in 130"
^DIC(9.4,13,22,9,"PAH",10,1,87,0)="VA Medical Centers within a short timeframe.  We appreciate your cooperation."
^DIC(9.4,13,22,9,"PAH",10,1,88,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,89,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,90,0)="Pre-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",10,1,91,0)="------------------------------"
^DIC(9.4,13,22,9,"PAH",10,1,92,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,13,22,9,"PAH",10,1,93,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,13,22,9,"PAH",10,1,94,0)="potential disruption to users.  This patch should take less than"
^DIC(9.4,13,22,9,"PAH",10,1,95,0)="2 minutes to install."
^DIC(9.4,13,22,9,"PAH",10,1,96,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,97,0)="NOTE: This patch was created with VA FileMan 22.2, so please ensure"
^DIC(9.4,13,22,9,"PAH",10,1,98,0)="the target system has also been upgraded to this version, otherwise"
^DIC(9.4,13,22,9,"PAH",10,1,99,0)="installation will fail."
^DIC(9.4,13,22,9,"PAH",10,1,100,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,101,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,102,0)="Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",10,1,103,0)="--------------------------"
^DIC(9.4,13,22,9,"PAH",10,1,104,0)=" 1.  From the Kernel Installation and Distribution System (KIDS) Menu,"
^DIC(9.4,13,22,9,"PAH",10,1,105,0)="     select the Installation menu. "
^DIC(9.4,13,22,9,"PAH",10,1,106,0)=" 2.  Use Load a Distribution. You may need to precede the host file name"
^DIC(9.4,13,22,9,"PAH",10,1,107,0)="     with a directory name."
^DIC(9.4,13,22,9,"PAH",10,1,108,0)=" 3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,13,22,9,"PAH",10,1,109,0)="     the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,13,22,9,"PAH",10,1,110,0)="     following options. When prompted for the INSTALL NAME, enter DI*22.2*9."
^DIC(9.4,13,22,9,"PAH",10,1,111,0)="   a.  Backup a Transport Global - This option will create a backup message"
^DIC(9.4,13,22,9,"PAH",10,1,112,0)="       of any routines exported with this patch. It will not backup any other"
^DIC(9.4,13,22,9,"PAH",10,1,113,0)="       changes such as DDs or templates."
^DIC(9.4,13,22,9,"PAH",10,1,114,0)="   b.  Compare Transport Global to Current System - This option will allow"
^DIC(9.4,13,22,9,"PAH",10,1,115,0)="       you to view all changes that will be made when this patch is installed."
^DIC(9.4,13,22,9,"PAH",10,1,116,0)="       It compares all components of this patch."
^DIC(9.4,13,22,9,"PAH",10,1,117,0)="   c.  Verify Checksums in Transport Global - This option will allow you to"
^DIC(9.4,13,22,9,"PAH",10,1,118,0)="       ensure the integrity of the routines that are in the transport global."
^DIC(9.4,13,22,9,"PAH",10,1,119,0)=" 4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,13,22,9,"PAH",10,1,120,0)="     when prompted for the INSTALL NAME, enter DI*22.2*9."
^DIC(9.4,13,22,9,"PAH",10,1,121,0)=" 5.  When prompted ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,13,22,9,"PAH",10,1,122,0)="     Install? NO//"" enter NO."
^DIC(9.4,13,22,9,"PAH",10,1,123,0)=" 6.  When prompted ""Want KIDS to INHIBIT LOGONs during the install? NO//"""
^DIC(9.4,13,22,9,"PAH",10,1,124,0)="     enter NO."
^DIC(9.4,13,22,9,"PAH",10,1,125,0)=" 7.  When prompted ""Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,9,"PAH",10,1,126,0)="     and Protocols? NO//"" enter NO."
^DIC(9.4,13,22,9,"PAH",10,1,127,0)=" 8.  If prompted ""Delay Install (Minutes):  (0  60): 0//"" enter 0."
^DIC(9.4,13,22,9,"PAH",10,1,128,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,129,0)=" "
