^DIC(9.4,73,22,9,"PAH",20,1,69,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,73,22,9,"PAH",20,1,70,0)="                ------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",20,1,71,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if"
^DIC(9.4,73,22,9,"PAH",20,1,72,0)="    necessary."
^DIC(9.4,73,22,9,"PAH",20,1,73,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",21,0)="33 SEQ #28^3030301^1"
^DIC(9.4,73,22,9,"PAH",21,1,0)="^^65^65^3030301"
^DIC(9.4,73,22,9,"PAH",21,1,1,0)="Patch AFJX*5.1*33"
^DIC(9.4,73,22,9,"PAH",21,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",21,1,3,0)="NOIS: FNC-0103-30068"
^DIC(9.4,73,22,9,"PAH",21,1,4,0)="Test Site: Fayetteville, NC"
^DIC(9.4,73,22,9,"PAH",21,1,5,0)=""
^DIC(9.4,73,22,9,"PAH",21,1,6,0)="If the NETWORK,HEALTH EXCHANGE user has been terminated, requests that"
^DIC(9.4,73,22,9,"PAH",21,1,7,0)="users make are not delivered to the NETWORK,HEALTH EXCHANGE user."
^DIC(9.4,73,22,9,"PAH",21,1,8,0)="Consequently, it is not possible to print or view completed requests"
^DIC(9.4,73,22,9,"PAH",21,1,9,0)="which were made after termination.  In order to remedy this, a check will"
^DIC(9.4,73,22,9,"PAH",21,1,10,0)="be made of the status of the NETWORK,HEALTH EXCHANGE user every time a"
^DIC(9.4,73,22,9,"PAH",21,1,11,0)="user enters option AFJXNHEX REQUEST (Network Health Exchange Options ...),"
^DIC(9.4,73,22,9,"PAH",21,1,12,0)="and if the NETWORK,HEALTH EXCHANGE user is terminated, the option will not"
^DIC(9.4,73,22,9,"PAH",21,1,13,0)="be usable."
^DIC(9.4,73,22,9,"PAH",21,1,14,0)=""
^DIC(9.4,73,22,9,"PAH",21,1,15,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",21,1,16,0)="is at a minimum.  It requires patch AFJX*5.1*32."
^DIC(9.4,73,22,9,"PAH",21,1,17,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",21,1,18,0)=" "
^DIC(9.4,73,22,9,"PAH",21,1,19,0)="ROUTINES:"
