^DIC(9.4,60,22,13,"PAH",273,1,43,0)="              SIG: TAKE ONE CAPSULE BY MOUTH EVERY DAY"
^DIC(9.4,60,22,13,"PAH",273,1,44,0)="              PROVIDER: PSOPROVIDER,TEN"
