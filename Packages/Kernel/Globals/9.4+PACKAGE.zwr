^DIC(9.4,3,22,21,"PAH",144,1,49,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",144,1,50,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",144,1,51,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",144,1,52,0)="     "
^DIC(9.4,3,22,21,"PAH",144,1,53,0)="  4.  Current users can remain on the system."
^DIC(9.4,3,22,21,"PAH",144,1,54,0)="      Inhibit new users from login into the system."
^DIC(9.4,3,22,21,"PAH",144,1,55,0)=""
^DIC(9.4,3,22,21,"PAH",144,1,56,0)="     "
^DIC(9.4,3,22,21,"PAH",144,1,57,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",144,1,58,0)="      option:"
^DIC(9.4,3,22,21,"PAH",144,1,59,0)="        Install Package(s)  'XU*8.0*149'"
^DIC(9.4,3,22,21,"PAH",144,1,60,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",144,1,61,0)="                             "
^DIC(9.4,3,22,21,"PAH",144,1,62,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",144,1,63,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",144,1,64,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",144,1,65,0)="     "
^DIC(9.4,3,22,21,"PAH",144,1,66,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
