^DIC(9.4,14,22,5.9,"PAH",90,1,65,0)="              Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",90,1,66,0)="       4. Users may remain on the system, but installation should be"
^DIC(9.4,14,22,5.9,"PAH",90,1,67,0)="          done at off peak hours."
^DIC(9.4,14,22,5.9,"PAH",90,1,68,0)="       5. No options need to be placed out of service."
