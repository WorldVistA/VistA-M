^DIC(9.4,14,22,5.9,"PAH",67,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",67,1,2,0)="A detailed description of this patch is included in the patch"
