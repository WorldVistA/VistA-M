^DIC(9.4,14,22,5.9,"PAH",97,1,828,0)="THERE ARE PROCEDURES IN PCE BUT NO RECORD IN SCHEDULING **"
^DIC(9.4,14,22,5.9,"PAH",97,1,829,0)=" "
