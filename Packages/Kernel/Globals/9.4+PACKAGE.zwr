^DIC(9.4,100,22,15,"PAH",35,1,50,0)=" "
^DIC(9.4,100,22,15,"PAH",35,1,51,0)="    5. Installation will take less than five minutes. Installation"
^DIC(9.4,100,22,15,"PAH",35,1,52,0)="       of this patch requires no additional memory space."
^DIC(9.4,100,22,15,"PAH",35,1,53,0)=" "
^DIC(9.4,100,22,15,"PAH",35,1,54,0)="    6. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",35,1,55,0)="      'Install Package(s)' Select the package 'YS*5.01*63' and"
^DIC(9.4,100,22,15,"PAH",35,1,56,0)="       proceed with install."
^DIC(9.4,100,22,15,"PAH",35,1,57,0)=""
^DIC(9.4,100,22,15,"PAH",35,1,58,0)="    7. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",35,1,59,0)="       install? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",35,1,60,0)=" "
^DIC(9.4,100,22,15,"PAH",35,1,61,0)="    8. When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,100,22,15,"PAH",35,1,62,0)="       Options, and Protocols? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",36,0)="61 SEQ #55^3000417^1"
^DIC(9.4,100,22,15,"PAH",36,1,0)="^^141^141^3000417"
^DIC(9.4,100,22,15,"PAH",36,1,1,0)="This patch adds the NDC (National Drug Code) from the NDC field (#27) in"
^DIC(9.4,100,22,15,"PAH",36,1,2,0)="the PRESCRIPTION file (#52) to the Clozapine reporting software and clears"
^DIC(9.4,100,22,15,"PAH",36,1,3,0)="the problems listed in the associated NOIS's."
^DIC(9.4,100,22,15,"PAH",36,1,4,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,5,0)=" 1. BIL-0299-32473"
^DIC(9.4,100,22,15,"PAH",36,1,6,0)="    PUG-0399-52312"
^DIC(9.4,100,22,15,"PAH",36,1,7,0)="    GNH-0699-42000"
^DIC(9.4,100,22,15,"PAH",36,1,8,0)="    BOS-0799-10563"
^DIC(9.4,100,22,15,"PAH",36,1,9,0)="    ALT-1099-22157"
^DIC(9.4,100,22,15,"PAH",36,1,10,0)="    ALT-0799-21661"
^DIC(9.4,100,22,15,"PAH",36,1,11,0)="    CHS-1099-40369"
^DIC(9.4,100,22,15,"PAH",36,1,12,0)="         These NOIS calls reported an undefined variable (YSCLR) that was"
^DIC(9.4,100,22,15,"PAH",36,1,13,0)="         causing problems with the weekly transmissions, measures have"
^DIC(9.4,100,22,15,"PAH",36,1,14,0)="         been taken to prevent this error."
^DIC(9.4,100,22,15,"PAH",36,1,15,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,16,0)=" 2. PRO-0399-12547"
^DIC(9.4,100,22,15,"PAH",36,1,17,0)="    CLE-0799-41665"
^DIC(9.4,100,22,15,"PAH",36,1,18,0)="    PRO-0799-12531"
^DIC(9.4,100,22,15,"PAH",36,1,19,0)="        These NOIS calls reported a problem with the confirmation message"
^DIC(9.4,100,22,15,"PAH",36,1,20,0)="        that is sent to the site to report the number of patient data"
^DIC(9.4,100,22,15,"PAH",36,1,21,0)="        records transmitted to the national database and any errors."
^DIC(9.4,100,22,15,"PAH",36,1,22,0)="        Errors were being reported in these messages, but the details were"
^DIC(9.4,100,22,15,"PAH",36,1,23,0)="        omitted.  A sequence was established to ensure that the details"
^DIC(9.4,100,22,15,"PAH",36,1,24,0)="        will be included."
^DIC(9.4,100,22,15,"PAH",36,1,25,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,26,0)=" 3. SYR-0799-10193"
^DIC(9.4,100,22,15,"PAH",36,1,27,0)="    LEX-0899-41770"
^DIC(9.4,100,22,15,"PAH",36,1,28,0)="        These NOIS calls reported a problem with the patients registration"
^DIC(9.4,100,22,15,"PAH",36,1,29,0)="        in the CLOZAPINE PATIENT LIST file (#603.01).  Patients were being"
^DIC(9.4,100,22,15,"PAH",36,1,30,0)="        dropped from the file and could not be reregistered.  Changes were"
^DIC(9.4,100,22,15,"PAH",36,1,31,0)="        made to allow the NCCC to reregister the patients."
^DIC(9.4,100,22,15,"PAH",36,1,32,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,33,0)=" 4. SUX-0899-41033"
^DIC(9.4,100,22,15,"PAH",36,1,34,0)="    PRO-1099-11959"
^DIC(9.4,100,22,15,"PAH",36,1,35,0)="    ALN-0300-10936"
^DIC(9.4,100,22,15,"PAH",36,1,36,0)="        These NOIS calls reported a problem with the patients status"
^DIC(9.4,100,22,15,"PAH",36,1,37,0)="        changing from ""Active"" to ""discontinued"" each week.  A more"
^DIC(9.4,100,22,15,"PAH",36,1,38,0)="        accurate method of determining active prescriptions has been"
^DIC(9.4,100,22,15,"PAH",36,1,39,0)="        implemented."
^DIC(9.4,100,22,15,"PAH",36,1,40,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,41,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,42,0)=" Requesting Site: Washington, DC"
^DIC(9.4,100,22,15,"PAH",36,1,43,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,44,0)="    Test Site(s): Sioux Falls"
^DIC(9.4,100,22,15,"PAH",36,1,45,0)="                  Chicago"
^DIC(9.4,100,22,15,"PAH",36,1,46,0)="                  Lexington "
^DIC(9.4,100,22,15,"PAH",36,1,47,0)="                  Biloxi"
^DIC(9.4,100,22,15,"PAH",36,1,48,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,49,0)="  Reference NOIS: BIL-0299-32473"
^DIC(9.4,100,22,15,"PAH",36,1,50,0)="                  PUG-0399-52312"
^DIC(9.4,100,22,15,"PAH",36,1,51,0)="                  PRO-0399-12547"
^DIC(9.4,100,22,15,"PAH",36,1,52,0)="                  GNH-0699-42000"
^DIC(9.4,100,22,15,"PAH",36,1,53,0)="                  SYR-0799-10193"
^DIC(9.4,100,22,15,"PAH",36,1,54,0)="                  BOS-0799-10563"
^DIC(9.4,100,22,15,"PAH",36,1,55,0)="                  CLE-0799-41665"
^DIC(9.4,100,22,15,"PAH",36,1,56,0)="                  PRO-0799-12531"
^DIC(9.4,100,22,15,"PAH",36,1,57,0)="                  SUX-0899-41033"
^DIC(9.4,100,22,15,"PAH",36,1,58,0)="                  LEX-0899-41770"
^DIC(9.4,100,22,15,"PAH",36,1,59,0)="                  PRO-1099-11959"
^DIC(9.4,100,22,15,"PAH",36,1,60,0)="                  ALT-1099-22157"
^DIC(9.4,100,22,15,"PAH",36,1,61,0)="                  ALT-0799-21661"
^DIC(9.4,100,22,15,"PAH",36,1,62,0)="                  CHS-1099-40369"
^DIC(9.4,100,22,15,"PAH",36,1,63,0)="                  ALN-0300-10936"
^DIC(9.4,100,22,15,"PAH",36,1,64,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,65,0)="  ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",36,1,66,0)="  ================"
^DIC(9.4,100,22,15,"PAH",36,1,67,0)="   "
^DIC(9.4,100,22,15,"PAH",36,1,68,0)="  The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",36,1,69,0)="   "
^DIC(9.4,100,22,15,"PAH",36,1,70,0)="  <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30,1994"
^DIC(9.4,100,22,15,"PAH",36,1,71,0)="   "
^DIC(9.4,100,22,15,"PAH",36,1,72,0)="                              Checksum Values"
^DIC(9.4,100,22,15,"PAH",36,1,73,0)="   "
^DIC(9.4,100,22,15,"PAH",36,1,74,0)="  Routine Name      Before Patch         After Patch     Patch List"
^DIC(9.4,100,22,15,"PAH",36,1,75,0)="  ------------      ------------         -----------     ----------"
^DIC(9.4,100,22,15,"PAH",36,1,76,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,77,0)="  YSCLPRE             NEW                 4869409        61"
^DIC(9.4,100,22,15,"PAH",36,1,78,0)="  YSCLSERV          27353057             33969291        18,22,26,47,61"
^DIC(9.4,100,22,15,"PAH",36,1,79,0)="  YSCLSRV1            NEW                 1286296        61"
^DIC(9.4,100,22,15,"PAH",36,1,80,0)="  YSCLTEST           8757130              9052437        18,22,26,47,61"
^DIC(9.4,100,22,15,"PAH",36,1,81,0)="  YSCLTST1          12256509             12553719        18,22,25,26,47,61"
^DIC(9.4,100,22,15,"PAH",36,1,82,0)="  YSCLTST2          11047742             11500297        18,22,26,47,61"
^DIC(9.4,100,22,15,"PAH",36,1,83,0)="  YSCLTST3          11776458             12171877        18,22,25,26,47,61"
^DIC(9.4,100,22,15,"PAH",36,1,84,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,85,0)="         Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",36,1,86,0)="         =========================="
^DIC(9.4,100,22,15,"PAH",36,1,87,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,88,0)="  NOTE: This KIDS install does not place any options out of service"
^DIC(9.4,100,22,15,"PAH",36,1,89,0)="        during the install and no user options are affected."
^DIC(9.4,100,22,15,"PAH",36,1,90,0)="        If KIDS prompts:"
^DIC(9.4,100,22,15,"PAH",36,1,91,0)="  "
^DIC(9.4,100,22,15,"PAH",36,1,92,0)="        ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,100,22,15,"PAH",36,1,93,0)="         Install? YES// NO"""
^DIC(9.4,100,22,15,"PAH",36,1,94,0)="        ""Want KIDS to INHIBIT LOGONs during the install? YES// NO"""
^DIC(9.4,100,22,15,"PAH",36,1,95,0)="        ""Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,100,22,15,"PAH",36,1,96,0)="         YES// NO"""
^DIC(9.4,100,22,15,"PAH",36,1,97,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,98,0)="        The site should answer ""NO"" to all three questions."
^DIC(9.4,100,22,15,"PAH",36,1,99,0)="            Note: You may not receive all three prompts at your site.  "
^DIC(9.4,100,22,15,"PAH",36,1,100,0)="  "
^DIC(9.4,100,22,15,"PAH",36,1,101,0)="         1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",36,1,102,0)="            This option will load the KIDS package in this message onto"
^DIC(9.4,100,22,15,"PAH",36,1,103,0)="            your system."
^DIC(9.4,100,22,15,"PAH",36,1,104,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,105,0)="         2. Review your mapped set.  If the routines are mapped, they"
^DIC(9.4,100,22,15,"PAH",36,1,106,0)="            should be removed from the mapped set at this time."
^DIC(9.4,100,22,15,"PAH",36,1,107,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,108,0)="         3. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",36,1,109,0)="            system. You now need to use KIDS to install the Transport "
^DIC(9.4,100,22,15,"PAH",36,1,110,0)="            global."
^DIC(9.4,100,22,15,"PAH",36,1,111,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,112,0)="            On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,100,22,15,"PAH",36,1,113,0)="            following options:"
^DIC(9.4,100,22,15,"PAH",36,1,114,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,115,0)="                Print Transport Global"
^DIC(9.4,100,22,15,"PAH",36,1,116,0)="                Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",36,1,117,0)="                Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",36,1,118,0)="                Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",36,1,119,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,120,0)="         4. Users may remain on the system, installation may be done at"
^DIC(9.4,100,22,15,"PAH",36,1,121,0)="            any time except during the time scheduled for the Clozapine"
^DIC(9.4,100,22,15,"PAH",36,1,122,0)="            roll-up."
^DIC(9.4,100,22,15,"PAH",36,1,123,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,124,0)="         5. No options need to be placed out of service."
^DIC(9.4,100,22,15,"PAH",36,1,125,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,126,0)="         6. Installation time is less than 2 minutes during off peak hours"
^DIC(9.4,100,22,15,"PAH",36,1,127,0)="            and less than 5 minutes during peak hours."
^DIC(9.4,100,22,15,"PAH",36,1,128,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,129,0)="         7. Installation of this patch requires no additional memory"
^DIC(9.4,100,22,15,"PAH",36,1,130,0)="            space."
^DIC(9.4,100,22,15,"PAH",36,1,131,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,132,0)="         8. From the 'Installation Menu' of the KIDS menu, run the option "
^DIC(9.4,100,22,15,"PAH",36,1,133,0)="            'Install Package(s)' Select the package 'YS*5.01*61' and"
^DIC(9.4,100,22,15,"PAH",36,1,134,0)="            proceed with the install."
^DIC(9.4,100,22,15,"PAH",36,1,135,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,136,0)="         9. If any routines were unmapped as part of step 2, they should"
^DIC(9.4,100,22,15,"PAH",36,1,137,0)="            be returned to the mapped set once the installation has run to"
^DIC(9.4,100,22,15,"PAH",36,1,138,0)="            completion."
^DIC(9.4,100,22,15,"PAH",36,1,139,0)=" "
^DIC(9.4,100,22,15,"PAH",36,1,140,0)="        10. The routine YSCLPRE will be automatically deleted after the"
^DIC(9.4,100,22,15,"PAH",36,1,141,0)="            installation has run to completion."
^DIC(9.4,100,22,15,"PAH",37,0)="62 SEQ #56^3000626^1"
^DIC(9.4,100,22,15,"PAH",37,1,0)="^^275^275^3000626"
^DIC(9.4,100,22,15,"PAH",37,1,1,0)="Two new Psychological Testing APIs/RPCs have been developed to allow reading"
^DIC(9.4,100,22,15,"PAH",37,1,2,0)="and saving of psychological testing data. This data normally resides in the "
^DIC(9.4,100,22,15,"PAH",37,1,3,0)="PSYCH INSTRUMENT PATIENT file (#601.2) for patient responses and the"
^DIC(9.4,100,22,15,"PAH",37,1,4,0)="MH INSTRUMENT file (#601) for test and interviews.  In addition, the"
^DIC(9.4,100,22,15,"PAH",37,1,5,0)="APIs/RPCs retrieve ADDICTION SEVERITY INDEX data found in the ADDICTION"
^DIC(9.4,100,22,15,"PAH",37,1,6,0)="SEVERITY INDEX file (#604) and Global Assessment of Functioning (GAF) data"
^DIC(9.4,100,22,15,"PAH",37,1,7,0)="found in the DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8)."
^DIC(9.4,100,22,15,"PAH",37,1,8,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,9,0)="This patch contains:"
^DIC(9.4,100,22,15,"PAH",37,1,10,0)="     Four new fields have been added to file MH MULTIPLE SCORING (#601.6)."
^DIC(9.4,100,22,15,"PAH",37,1,11,0)="     The new fields are OUTCOMES (#5) and RESULTS (#6) a multiple containing"
^DIC(9.4,100,22,15,"PAH",37,1,12,0)="     sub-fields RESULTS NUMBER (#.01), RESULTS DESCRIPTION (#1) and RESULTS"
^DIC(9.4,100,22,15,"PAH",37,1,13,0)="     TEXT (#2)."
^DIC(9.4,100,22,15,"PAH",37,1,14,0)="     Four new routines YSMTI2, YSMTI6, YTAPI4 and YTAPI5."
^DIC(9.4,100,22,15,"PAH",37,1,15,0)="     One modified routine YTAPI2."
^DIC(9.4,100,22,15,"PAH",37,1,16,0)="     Two new APIs and Remote Procedures YTAPI PREVIEW and YTAPI OUTNOTE."
^DIC(9.4,100,22,15,"PAH",37,1,17,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,18,0)="Documentation for APIs and RPCs"
^DIC(9.4,100,22,15,"PAH",37,1,19,0)="-------------------------------"
^DIC(9.4,100,22,15,"PAH",37,1,20,0)="1.  PREVIEW"
^DIC(9.4,100,22,15,"PAH",37,1,21,0)="       RPC: YTAPI PREVIEW"
^DIC(9.4,100,22,15,"PAH",37,1,22,0)="       M:   PREVIEW^YTAPI4"
^DIC(9.4,100,22,15,"PAH",37,1,23,0)="This API allows scoring of patient responses to a test or interview without "
^DIC(9.4,100,22,15,"PAH",37,1,24,0)="making changes in the M database. The patient ien, the test code, and "
^DIC(9.4,100,22,15,"PAH",37,1,25,0)="administration date is required along with the responses. All responses are "
^DIC(9.4,100,22,15,"PAH",37,1,26,0)="checked for validity. Scoring is returned in the output documented in the "
^DIC(9.4,100,22,15,"PAH",37,1,27,0)="SCOREIT API."
^DIC(9.4,100,22,15,"PAH",37,1,28,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,29,0)="Input: "
^DIC(9.4,100,22,15,"PAH",37,1,30,0)="------"
^DIC(9.4,100,22,15,"PAH",37,1,31,0)="DFN: patient internal identifier"
^DIC(9.4,100,22,15,"PAH",37,1,32,0)="CODE: Test code from file 601 or ""ASI"" e.g. ""CAGE"", ""BDI"""
^DIC(9.4,100,22,15,"PAH",37,1,33,0)="ADATE: inclusive administration date in %DT acceptable format (11/11/2011)"
^DIC(9.4,100,22,15,"PAH",37,1,34,0)="Staff: DUZ of professional ordering the test"
^DIC(9.4,100,22,15,"PAH",37,1,35,0)="R1: string of patient responses 1-200"
^DIC(9.4,100,22,15,"PAH",37,1,36,0)="R2: string of patient responses 201-400 [as needed]"
^DIC(9.4,100,22,15,"PAH",37,1,37,0)="R3: string of patient responses 401-600 [as needed]"
^DIC(9.4,100,22,15,"PAH",37,1,38,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,39,0)="Output:"
^DIC(9.4,100,22,15,"PAH",37,1,40,0)="-------"
^DIC(9.4,100,22,15,"PAH",37,1,41,0)="Array(2)= Patient Name^Test Code^Test Title^Internal Admin date^External "
^DIC(9.4,100,22,15,"PAH",37,1,42,0)="Admin Date ^Ordered by"
^DIC(9.4,100,22,15,"PAH",37,1,43,0)="Array(3)=R1^Responses 1-200 undelimited"
^DIC(9.4,100,22,15,"PAH",37,1,44,0)="Array(4)=R2^ Responses 201-400 undelimited (even if less than 200)"
^DIC(9.4,100,22,15,"PAH",37,1,45,0)="Array(5)=R3^ Responses 401-600 undelimited"
^DIC(9.4,100,22,15,"PAH",37,1,46,0)="Array(6)=S1^Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",37,1,47,0)="Array(7)=S2^ Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",37,1,48,0)="          ."
^DIC(9.4,100,22,15,"PAH",37,1,49,0)="          ."
^DIC(9.4,100,22,15,"PAH",37,1,50,0)="  And onward as needed"
^DIC(9.4,100,22,15,"PAH",37,1,51,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,52,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,53,0)="Example:"
^DIC(9.4,100,22,15,"PAH",37,1,54,0)="--------"
^DIC(9.4,100,22,15,"PAH",37,1,55,0)="Input"
^DIC(9.4,100,22,15,"PAH",37,1,56,0)="-----"
^DIC(9.4,100,22,15,"PAH",37,1,57,0)="YS(""DFN"")=6"
