^DIC(9.4,163,22,1,"PAH",318,0)="366 SEQ #325^3240627.130211^89"
^DIC(9.4,163,22,1,"PAH",319,0)="367 SEQ #326^3240801.144518^89"
^DIC(9.4,163,22,1,"PAH",319,1,0)="^^2^2^3240801"
^DIC(9.4,163,22,1,"PAH",319,1,1,0)="When printing the progress notes, a specific string of characters in the "
