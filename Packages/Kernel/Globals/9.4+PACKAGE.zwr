^DIC(9.4,101,22,0)="^9.49I^6^1"
^DIC(9.4,101,22,6,0)="4.0^3051119^2960822"
^DIC(9.4,101,22,6,"PAH",0)="^9.4901^130^130"
^DIC(9.4,101,22,6,"PAH",1,0)="16^2960822^1"
^DIC(9.4,101,22,6,"PAH",1,1,0)="^^12^12^2960822"
^DIC(9.4,101,22,6,"PAH",1,1,1,0)="- This message contains modified routines:"
^DIC(9.4,101,22,6,"PAH",1,1,2,0)="     PRSRAU1, PRSREX1, PRSRTLPR, PRSRL4, PRSRLSOR, PRSRUTL."
^DIC(9.4,101,22,6,"PAH",1,1,3,0)="- PRSRAU1 and PRSREX1 save the SW variable before queueing the reports."
^DIC(9.4,101,22,6,"PAH",1,1,4,0)="- PRSRTLPR adds three $GET's at line label HDR to protect against the"
^DIC(9.4,101,22,6,"PAH",1,1,5,0)="  case in which there are no Supervisors, Timekeepers or OT/CT sups for a "
^DIC(9.4,101,22,6,"PAH",1,1,6,0)="  T&L unit."
^DIC(9.4,101,22,6,"PAH",1,1,7,0)="- PRSRL4, PRSRLSOR are modified to bullet proof the display of an employee"
^DIC(9.4,101,22,6,"PAH",1,1,8,0)="  cost center/organization.  If the pointer in the PAID codes file to"
^DIC(9.4,101,22,6,"PAH",1,1,9,0)="  454.1 is missing the code will be displayed instead of the description."
^DIC(9.4,101,22,6,"PAH",1,1,10,0)="- Also a bulletin will be sent to G.PAD to inform them of a needed update"
^DIC(9.4,101,22,6,"PAH",1,1,11,0)="  from routine PRSRUTL."
^DIC(9.4,101,22,6,"PAH",1,1,12,0)=""
^DIC(9.4,101,22,6,"PAH",2,0)="18 SEQ #17^2970204^1"
^DIC(9.4,101,22,6,"PAH",3,0)="21 SEQ #18^2970303^1"
^DIC(9.4,101,22,6,"PAH",4,0)="20 SEQ #19^2970617^1"
^DIC(9.4,101,22,6,"PAH",4,1,0)="^^1^1^2970617"
^DIC(9.4,101,22,6,"PAH",4,1,1,0)="Education Tracking Report fixes."
^DIC(9.4,101,22,6,"PAH",5,0)="23 SEQ #20^2970819^1"
^DIC(9.4,101,22,6,"PAH",5,1,0)="^^1^1^2970819"
^DIC(9.4,101,22,6,"PAH",5,1,1,0)="Education Tracking Patch <PRS*4*23>"
^DIC(9.4,101,22,6,"PAH",6,0)="25 SEQ #21^2970922^1"
^DIC(9.4,101,22,6,"PAH",6,1,0)="^^3^3^2970922"
^DIC(9.4,101,22,6,"PAH",6,1,1,0)="This is a patch to the education tracking module of the PAID 4.0 package."
^DIC(9.4,101,22,6,"PAH",6,1,2,0)="It is an enhancement that allows holders of the PRSE CORD key to report"
^DIC(9.4,101,22,6,"PAH",6,1,3,0)="individual training by one, many or all services.  "
^DIC(9.4,101,22,6,"PAH",7,0)="26 SEQ #22^2971006^1"
^DIC(9.4,101,22,6,"PAH",7,1,0)="^^8^8^2971006"
^DIC(9.4,101,22,6,"PAH",7,1,1,0)="Fixes for PAID reports."
^DIC(9.4,101,22,6,"PAH",7,1,2,0)=" 1. Employee Leave Requested report"
^DIC(9.4,101,22,6,"PAH",7,1,3,0)="    - Include multiple requests by employee with same From Date."
^DIC(9.4,101,22,6,"PAH",7,1,4,0)="    - Include all requests the overlap the report's date range."
^DIC(9.4,101,22,6,"PAH",7,1,5,0)=" 2. Expenditures report"
^DIC(9.4,101,22,6,"PAH",7,1,6,0)="    - Replace 'Total Earnings' by 'Gross Pay'. Fix Benefits calculation."
^DIC(9.4,101,22,6,"PAH",7,1,7,0)=" 3. Reports that show payperiod exceptions (e.g. List Daily Exceptions)"
^DIC(9.4,101,22,6,"PAH",7,1,8,0)="    - Improve identification of OT/CT exceptions when multiple requests."
^DIC(9.4,101,22,6,"PAH",8,0)="22 SEQ #23^2971021^1"
^DIC(9.4,101,22,6,"PAH",9,0)="31 SEQ #24^2971118^1"
^DIC(9.4,101,22,6,"PAH",9,1,0)="^^2^2^2971118"
^DIC(9.4,101,22,6,"PAH",9,1,1,0)="Patch to update PAID ETA to conform to new public law which revokes premium pay"
^DIC(9.4,101,22,6,"PAH",9,1,2,0)="for employees in a leave status. "
^DIC(9.4,101,22,6,"PAH",10,0)="28 SEQ #25^2971127^1"
^DIC(9.4,101,22,6,"PAH",10,1,0)="^^4^4^2971127"
^DIC(9.4,101,22,6,"PAH",10,1,1,0)=" o Modify OT/CT Report to only include the specified year. Also, allow"
^DIC(9.4,101,22,6,"PAH",10,1,2,0)="   users to select a range of pay periods."
^DIC(9.4,101,22,6,"PAH",10,1,3,0)=" o Modify Display Pay Period output to pause during screen display."
^DIC(9.4,101,22,6,"PAH",10,1,4,0)=" o Add text to download statistics message concerning SSN corrections."
^DIC(9.4,101,22,6,"PAH",11,0)="33 SEQ #26^2971213^1"
^DIC(9.4,101,22,6,"PAH",11,1,0)="^^10^10^2971213"
^DIC(9.4,101,22,6,"PAH",11,1,1,0)="President Clinton made December 26th, 1997 a Holiday.  This was granted since"
^DIC(9.4,101,22,6,"PAH",11,1,2,0)="the Christmas Holiday falls on a Thursday in 1997.  This patch enhances the"
^DIC(9.4,101,22,6,"PAH",11,1,3,0)="PAID ETA v4.0 software to add December 26,1997 as a Holiday.  The Holiday"
^DIC(9.4,101,22,6,"PAH",11,1,4,0)="will be used by the PAID software in functions such as opening Pay Period"
^DIC(9.4,101,22,6,"PAH",11,1,5,0)="97-26 and setting tours of duty to Holiday Excused in Time Cards."
^DIC(9.4,101,22,6,"PAH",11,1,6,0)="The only routine modification necessary to facilitate this is to routine"
^DIC(9.4,101,22,6,"PAH",11,1,7,0)="PRS8HD which is a procedure that is called by other PAID options to determine"
^DIC(9.4,101,22,6,"PAH",11,1,8,0)="a singular holiday or to determine holidays for a year or to determine all the"
^DIC(9.4,101,22,6,"PAH",11,1,9,0)="holidays within a year of a particular date."
^DIC(9.4,101,22,6,"PAH",11,1,10,0)=""
^DIC(9.4,101,22,6,"PAH",12,0)="24 SEQ #27^2971215^1"
^DIC(9.4,101,22,6,"PAH",12,1,0)="^^14^14^2971215"
^DIC(9.4,101,22,6,"PAH",12,1,1,0)="The following 3 items are included in this patch."
^DIC(9.4,101,22,6,"PAH",12,1,2,0)=""
^DIC(9.4,101,22,6,"PAH",12,1,3,0)="1. The 8B Edit Checks, [PRSA EDIT], option is updated to stop"
^DIC(9.4,101,22,6,"PAH",12,1,4,0)="reporting errors when wage grade employees earn and use compensatory time. "
^DIC(9.4,101,22,6,"PAH",12,1,5,0)=""
^DIC(9.4,101,22,6,"PAH",12,1,6,0)="2. On the Timekeeper Main Menu, [PRSA TK MENU], the option menu text for "
^DIC(9.4,101,22,6,"PAH",12,1,7,0)="the Cancel OT Request [PRSA OT CAN] option has been edited to Cancel "
^DIC(9.4,101,22,6,"PAH",12,1,8,0)="OT/CT Request."
^DIC(9.4,101,22,6,"PAH",12,1,9,0)=""
^DIC(9.4,101,22,6,"PAH",12,1,10,0)="3.  Fix for undefined error at CCORG+15^PRSRUTL when an employee is"
^DIC(9.4,101,22,6,"PAH",12,1,11,0)="associated with a deleted cost center/organization in the PAID CODES"
^DIC(9.4,101,22,6,"PAH",12,1,12,0)="file (#454).  The error occurs while running the Employee Leave Pattern"
^DIC(9.4,101,22,6,"PAH",12,1,13,0)="[PRSRSU-LEV-PATR] report. "
^DIC(9.4,101,22,6,"PAH",12,1,14,0)=""
^DIC(9.4,101,22,6,"PAH",13,0)="30 SEQ #28^2971218^1"
^DIC(9.4,101,22,6,"PAH",13,1,0)="^^9^9^2971218"
^DIC(9.4,101,22,6,"PAH",13,1,1,0)="1. Fix 8B string for code CA (Calendar Year Adjustment):"
^DIC(9.4,101,22,6,"PAH",13,1,2,0)="   a. Don't send CA when value is 0000 because it will reject at AAC."
^DIC(9.4,101,22,6,"PAH",13,1,3,0)="2. Fix 8B string for code CY (SF 2806 Adjustment):"
^DIC(9.4,101,22,6,"PAH",13,1,4,0)="   a. Revise 8B Edit Check from"
^DIC(9.4,101,22,6,"PAH",13,1,5,0)="     'If Normal Hours are 00 or 01, then CY cannot exceed 13.0; otherwise,"
^DIC(9.4,101,22,6,"PAH",13,1,6,0)="      CY cannot exceed Normal Hours + (UN + US) - (NO + NP)'"
^DIC(9.4,101,22,6,"PAH",13,1,7,0)="                           to"
^DIC(9.4,101,22,6,"PAH",13,1,8,0)="     'If Normal Hours are 01, then CY cannot exceed 13.0; otherwise, CY"
^DIC(9.4,101,22,6,"PAH",13,1,9,0)="      cannot exceed Normal Hours + (UN + US) - (NO + NP)'"
^DIC(9.4,101,22,6,"PAH",14,0)="27 SEQ #29^2980120^1"
^DIC(9.4,101,22,6,"PAH",14,1,0)="^^10^10^2980120"
^DIC(9.4,101,22,6,"PAH",14,1,1,0)=" o When a tour of duty is edited and the next pay period is selected, the"
^DIC(9.4,101,22,6,"PAH",14,1,2,0)="   default value for the compressed tour indicator was occassionally"
^DIC(9.4,101,22,6,"PAH",14,1,3,0)="   different than the actual value of the employees' compressed tour"
^DIC(9.4,101,22,6,"PAH",14,1,4,0)="   indicator. After the patch is installed, an appropriate default value"
^DIC(9.4,101,22,6,"PAH",14,1,5,0)="   will be presented."
^DIC(9.4,101,22,6,"PAH",14,1,6,0)=" o The Decomposition of Time output for the Pay Period Certification and"
^DIC(9.4,101,22,6,"PAH",14,1,7,0)="   Decompose Time options will note when the Compressed Tour Indicator has"
^DIC(9.4,101,22,6,"PAH",14,1,8,0)="   been changed since the previous pay period."
^DIC(9.4,101,22,6,"PAH",14,1,9,0)=" o Corrects undefined error when the Employee Overtime/Comptime Report"
^DIC(9.4,101,22,6,"PAH",14,1,10,0)="   is generated for a single employee and the output is queued."
^DIC(9.4,101,22,6,"PAH",15,0)="32 SEQ #30^2980220^1"
^DIC(9.4,101,22,6,"PAH",15,1,0)="^^5^5^2980220"
^DIC(9.4,101,22,6,"PAH",15,1,1,0)="1.  This patch updates the PAID download server to accept and store year"
^DIC(9.4,101,22,6,"PAH",15,1,2,0)="2000 dates."
^DIC(9.4,101,22,6,"PAH",15,1,3,0)=" "
^DIC(9.4,101,22,6,"PAH",15,1,4,0)="2.  The date selection function (DATSEL^PRSEUTL) has been modified to"
^DIC(9.4,101,22,6,"PAH",15,1,5,0)="handle year 2000 dates.  Users must enter 4 digit years."
^DIC(9.4,101,22,6,"PAH",16,0)="36 SEQ #31^2980330^1"
^DIC(9.4,101,22,6,"PAH",16,1,0)="^^2^2^2980330"
^DIC(9.4,101,22,6,"PAH",16,1,1,0)="Update the PAID CODE FILES for the performance/proficiency rating entry."
^DIC(9.4,101,22,6,"PAH",16,1,2,0)=""
^DIC(9.4,101,22,6,"PAH",17,0)="35 SEQ #32^2980330^1"
^DIC(9.4,101,22,6,"PAH",17,1,0)="^^1^1^2980330"
^DIC(9.4,101,22,6,"PAH",17,1,1,0)="Year 2000 updates to routines, data dictionaries, options, etc."
^DIC(9.4,101,22,6,"PAH",18,0)="38 SEQ #33^2980430^1"
^DIC(9.4,101,22,6,"PAH",18,1,0)="^^2^2^2980430"
^DIC(9.4,101,22,6,"PAH",18,1,1,0)="Corrects problems with the ""ASX"" cross-reference (T&L WHICH CERTIFIES"
^DIC(9.4,101,22,6,"PAH",18,1,2,0)="SUPERVISOR) in the T&L UNIT file."
^DIC(9.4,101,22,6,"PAH",19,0)="39 SEQ #34^2980430^1"
^DIC(9.4,101,22,6,"PAH",19,1,0)="^^2^2^2980430"
^DIC(9.4,101,22,6,"PAH",19,1,1,0)=" o Fix Employee Leave Used report."
^DIC(9.4,101,22,6,"PAH",19,1,2,0)=" o Fix Employee Leave Requested report."
^DIC(9.4,101,22,6,"PAH",20,0)="37 SEQ #35^2980604^1"
^DIC(9.4,101,22,6,"PAH",20,1,0)="^^5^5^2980604"
^DIC(9.4,101,22,6,"PAH",20,1,1,0)="1.  Add warning messages to certification of timecards option when the "
^DIC(9.4,101,22,6,"PAH",20,1,2,0)="    decomp calculates more overtime than what is approved."
^DIC(9.4,101,22,6,"PAH",20,1,3,0)="2.  Add same warning to Payroll option ""Pay Period exceptions""."
^DIC(9.4,101,22,6,"PAH",20,1,4,0)="3.  Update Armitage reversal, removing types of time as payable for Sunday"
^DIC(9.4,101,22,6,"PAH",20,1,5,0)="    premiums.  Types of time removed are COP, Hol Excused, Comp Used."
^DIC(9.4,101,22,6,"PAH",21,0)="29 SEQ #36^2980616^1"
^DIC(9.4,101,22,6,"PAH",21,1,0)="^^7^7^2980616"
^DIC(9.4,101,22,6,"PAH",21,1,1,0)="This KIDS build modifies the PAID 4.0 decomposition routines in order to"
^DIC(9.4,101,22,6,"PAH",21,1,2,0)="correct a bug in the software.  The bug occurs when a part time employee"
^DIC(9.4,101,22,6,"PAH",21,1,3,0)="works a full 40 hour week.  In addition the employee works compensatory"
^DIC(9.4,101,22,6,"PAH",21,1,4,0)="time at some point in the week, thereby working over 40 hours during the "
^DIC(9.4,101,22,6,"PAH",21,1,5,0)="week.  When the decomposition calculates the segments of time at the end"
^DIC(9.4,101,22,6,"PAH",21,1,6,0)="of the week after the total time has reached 40 hours, the employee is"
^DIC(9.4,101,22,6,"PAH",21,1,7,0)="incorrectly credited with overtime pay.  This patch corrects this anomoly."
^DIC(9.4,101,22,6,"PAH",22,0)="41 SEQ #37^2980712^1"
^DIC(9.4,101,22,6,"PAH",22,1,0)="^^6^6^2980712"
^DIC(9.4,101,22,6,"PAH",22,1,1,0)=" Fix Education Tracking Reports"
^DIC(9.4,101,22,6,"PAH",22,1,2,0)=" 1. Fix several reports so classes that occur on last day of reporting"
^DIC(9.4,101,22,6,"PAH",22,1,3,0)="    period (CY or FY) and have both a date and time specified will be"
^DIC(9.4,101,22,6,"PAH",22,1,4,0)="    included in the output."
^DIC(9.4,101,22,6,"PAH",22,1,5,0)=" 2. Modify PRSE-MI-LIST option so Service prompt is obtained by DIC call"
^DIC(9.4,101,22,6,"PAH",22,1,6,0)="    instead of DIE call."
^DIC(9.4,101,22,6,"PAH",23,0)="40 SEQ #38^2980923^1"
^DIC(9.4,101,22,6,"PAH",23,1,0)="^^1^1^2980923"
^DIC(9.4,101,22,6,"PAH",23,1,1,0)="Fix decomposition problems with night (shift and tour) differentials."
^DIC(9.4,101,22,6,"PAH",24,0)="43 SEQ #39^2981026^1"
^DIC(9.4,101,22,6,"PAH",24,1,0)="^^22^22^2981026"
^DIC(9.4,101,22,6,"PAH",24,1,1,0)="Patch makes three basic changes to the package:"
^DIC(9.4,101,22,6,"PAH",24,1,2,0)=""
^DIC(9.4,101,22,6,"PAH",24,1,3,0)="  1.  Supervisor's choice of canceling a leave request is removed."
^DIC(9.4,101,22,6,"PAH",24,1,4,0)="  2.  ListManager options to manage overtime (OT) warnings that appear "
^DIC(9.4,101,22,6,"PAH",24,1,5,0)="      on Pay Period Exceptions report are added to the package."
^DIC(9.4,101,22,6,"PAH",24,1,6,0)="  3.  Payroll Main Menu is reorganized by moving several options"
^DIC(9.4,101,22,6,"PAH",24,1,7,0)="      into a submenu on the Main Menu."
^DIC(9.4,101,22,6,"PAH",24,1,8,0)=""
^DIC(9.4,101,22,6,"PAH",24,1,9,0)="As item 2 above states, functionality to handle OT warnings is added.  The"
^DIC(9.4,101,22,6,"PAH",24,1,10,0)="patch adds a new file to store overtime warnings.  When the supervisor "
^DIC(9.4,101,22,6,"PAH",24,1,11,0)="approves a time card without resolving the descrepancy between approved "
^DIC(9.4,101,22,6,"PAH",24,1,12,0)="overtime for a week of the pay period and overtime calculated in the 8B "
^DIC(9.4,101,22,6,"PAH",24,1,13,0)="string, then a warning will be filed in the new OVERTIME WARNINGS file.  "
^DIC(9.4,101,22,6,"PAH",24,1,14,0)="A new option that uses List Manager will be available to Payroll so that "
^DIC(9.4,101,22,6,"PAH",24,1,15,0)="they can view these warnings.  Prior to this patch the warnings appeared "
^DIC(9.4,101,22,6,"PAH",24,1,16,0)="on the Pay Period Exceptions option on the payroll main menu.  Since "
^DIC(9.4,101,22,6,"PAH",24,1,17,0)="even when a corrected time card was done no change is made to the 8B "
^DIC(9.4,101,22,6,"PAH",24,1,18,0)="string these warnings continue to appear on the exceptions report.  "
^DIC(9.4,101,22,6,"PAH",24,1,19,0)="After the patch the exceptions report will first check to see if payroll "
^DIC(9.4,101,22,6,"PAH",24,1,20,0)="has cleared the warning (via the new list manager option) before "
^DIC(9.4,101,22,6,"PAH",24,1,21,0)="displaying it on the exceptions report."
^DIC(9.4,101,22,6,"PAH",24,1,22,0)=""
^DIC(9.4,101,22,6,"PAH",25,0)="44 SEQ #40^2981104^1"
^DIC(9.4,101,22,6,"PAH",25,1,0)="^^6^6^2981104"
^DIC(9.4,101,22,6,"PAH",25,1,1,0)=" Fix Education Tracking Module problems:"
^DIC(9.4,101,22,6,"PAH",25,1,2,0)=" 1. Inaccurate and Inconsistent Report Results."
^DIC(9.4,101,22,6,"PAH",25,1,3,0)=" 2. Class Registration Calendar Report ILLEGAL NUMBER error."
^DIC(9.4,101,22,6,"PAH",25,1,4,0)=" 3. Student Registration and Class Limit."
^DIC(9.4,101,22,6,"PAH",25,1,5,0)=" 4. Enter/Edit Ward/Unit-Location Training UNDEF error."
^DIC(9.4,101,22,6,"PAH",25,1,6,0)=" 5. Fix Mandatory Deficiency reports so 13th month not displayed."
^DIC(9.4,101,22,6,"PAH",26,0)="42 SEQ #41^2981112^1"
^DIC(9.4,101,22,6,"PAH",26,1,0)="^^5^5^2981112"
^DIC(9.4,101,22,6,"PAH",26,1,1,0)="Fix decompsition problems related to:"
^DIC(9.4,101,22,6,"PAH",26,1,2,0)=" o Sunday premium: Wage grade 2-day tour that crosses pay periods."
^DIC(9.4,101,22,6,"PAH",26,1,3,0)=" o Sunday premium: GS with 'pre-scheduled' OT."
^DIC(9.4,101,22,6,"PAH",26,1,4,0)=" o Sunday premium: Nurse with premium OT/CT that extends into weekend."
^DIC(9.4,101,22,6,"PAH",26,1,5,0)=" o Part-Time hours when >80 hours in pay period and on compressed tour."
^DIC(9.4,101,22,6,"PAH",27,0)="47 SEQ #42^2981229^1"
^DIC(9.4,101,22,6,"PAH",27,1,0)="^^8^8^2981229"
^DIC(9.4,101,22,6,"PAH",27,1,1,0)="This patch contains a post installation routine (PRSXP47) that will set"
^DIC(9.4,101,22,6,"PAH",27,1,2,0)="December 24, 1998 as a Holiday Benefit day for employees who are"
^DIC(9.4,101,22,6,"PAH",27,1,3,0)="scheduled to work on that day.  Special instruction from VACO Payroll"
^DIC(9.4,101,22,6,"PAH",27,1,4,0)="Policy will be necessary in conjuction with this patch.  These"
^DIC(9.4,101,22,6,"PAH",27,1,5,0)="instruction will direct timekeepers to post the second half of these "
^DIC(9.4,101,22,6,"PAH",27,1,6,0)="employee's tours as Holiday excused.  Nothing should be posted for the "
^DIC(9.4,101,22,6,"PAH",27,1,7,0)="first half of the tour."
^DIC(9.4,101,22,6,"PAH",27,1,8,0)=""
^DIC(9.4,101,22,6,"PAH",28,0)="46 SEQ #43^2990417^1"
^DIC(9.4,101,22,6,"PAH",28,1,0)="^^3^3^2990417"
^DIC(9.4,101,22,6,"PAH",28,1,1,0)="1.  Fix Expenditures report to include employees with only benefits."
^DIC(9.4,101,22,6,"PAH",28,1,2,0)="2.  Fix 8B Edit Checks to check appropriate employees."
^DIC(9.4,101,22,6,"PAH",28,1,3,0)="3.  Correct second line in routines with invalid formats or release dates."
^DIC(9.4,101,22,6,"PAH",29,0)="48 SEQ #44^2990419^1"
^DIC(9.4,101,22,6,"PAH",29,1,0)="^^1^1^2990419"
^DIC(9.4,101,22,6,"PAH",29,1,1,0)="FEGLI PROGRAM AND RATE STRUCTURE CHANGES"
^DIC(9.4,101,22,6,"PAH",30,0)="34 SEQ #45^2990510^1"
^DIC(9.4,101,22,6,"PAH",30,1,0)="^^17^17^2990510"
^DIC(9.4,101,22,6,"PAH",30,1,1,0)="It has been decided that the way Alternate Work Schedule Credit"
^DIC(9.4,101,22,6,"PAH",30,1,2,0)="Hours will be handled will be through the use of the Compensatory"
^DIC(9.4,101,22,6,"PAH",30,1,3,0)="Time field.  All rules governing Comp Time will be applied to Credit"
^DIC(9.4,101,22,6,"PAH",30,1,4,0)="Hours, e.g., pre approval and expiration after 7 pay periods, etc.  "
^DIC(9.4,101,22,6,"PAH",30,1,5,0)="To make the dual use of this field more clear to employees, "
^DIC(9.4,101,22,6,"PAH",30,1,6,0)="supervisors and Payroll/HR, the displayed name of the field should "
^DIC(9.4,101,22,6,"PAH",30,1,7,0)="be changed to reflect the actual contents of the field, Compensatory "
^DIC(9.4,101,22,6,"PAH",30,1,8,0)="Time and Credit Hours."
^DIC(9.4,101,22,6,"PAH",30,1,9,0)=""
^DIC(9.4,101,22,6,"PAH",30,1,10,0)="In order to distinguish between comp time and credit hours new "
^DIC(9.4,101,22,6,"PAH",30,1,11,0)="""time remarks"" will be added to the TIME REMARKS file (# 457.4).  "
^DIC(9.4,101,22,6,"PAH",30,1,12,0)="The new remarks will be applicable to the type of time formerly "
^DIC(9.4,101,22,6,"PAH",30,1,13,0)="known as comptime, but now known as comptime/credit hours.  The "
^DIC(9.4,101,22,6,"PAH",30,1,14,0)="new remarks will consist of ""comp time - no remarks"" and ""credit "
^DIC(9.4,101,22,6,"PAH",30,1,15,0)="hours"".  When posting comp/credit hours the timekeeper will now be "
^DIC(9.4,101,22,6,"PAH",30,1,16,0)="required to enter one of the valid remarks."
^DIC(9.4,101,22,6,"PAH",30,1,17,0)=""
^DIC(9.4,101,22,6,"PAH",31,0)="51 SEQ #46^2990914^1"
^DIC(9.4,101,22,6,"PAH",31,1,0)="^^1^1^2990914"
^DIC(9.4,101,22,6,"PAH",31,1,1,0)="REQUIRE TIME REMARK CODE WHEN CU IS POSTED FOR ENTIRE DAY"
^DIC(9.4,101,22,6,"PAH",32,0)="50 SEQ #47^2991019^1"
^DIC(9.4,101,22,6,"PAH",32,1,0)="^^10^10^2991019"
^DIC(9.4,101,22,6,"PAH",32,1,1,0)="Fix Education Tracking problems related to:"
^DIC(9.4,101,22,6,"PAH",32,1,2,0)=""
^DIC(9.4,101,22,6,"PAH",32,1,3,0)="o  Attendance when the class name is 53 characters long."
^DIC(9.4,101,22,6,"PAH",32,1,4,0)=""
^DIC(9.4,101,22,6,"PAH",32,1,5,0)="o  Fix undefined variable when using the  Enter/Edit Ward/Unit-Location"
^DIC(9.4,101,22,6,"PAH",32,1,6,0)="   Training [PRSE-W.I.] menu."
^DIC(9.4,101,22,6,"PAH",32,1,7,0)=""
^DIC(9.4,101,22,6,"PAH",32,1,8,0)="o  Use the appropriate variable for FileMan call."
^DIC(9.4,101,22,6,"PAH",32,1,9,0)=""
^DIC(9.4,101,22,6,"PAH",32,1,10,0)=""
^DIC(9.4,101,22,6,"PAH",33,0)="45 SEQ #48^2991019^1"
^DIC(9.4,101,22,6,"PAH",33,1,0)="^^15^15^2991019"
^DIC(9.4,101,22,6,"PAH",33,1,1,0)="This build modifies PAID version 4.0 to allow three types of firefighters.  "
^DIC(9.4,101,22,6,"PAH",33,1,2,0)="Prior to this software enhancement the software treats all firefighters "
^DIC(9.4,101,22,6,"PAH",33,1,3,0)="as a single type.  Two new types of firefighters will be created with "
^DIC(9.4,101,22,6,"PAH",33,1,4,0)="new entitlements and new time and attendance processing.  The third type "
^DIC(9.4,101,22,6,"PAH",33,1,5,0)="of fire fighter is the fire fighter type that exists before this "
^DIC(9.4,101,22,6,"PAH",33,1,6,0)="software enhancement."
^DIC(9.4,101,22,6,"PAH",33,1,7,0)=""
^DIC(9.4,101,22,6,"PAH",33,1,8,0)="This patch provides software changes for the following:"
^DIC(9.4,101,22,6,"PAH",33,1,9,0)="  1.  Update entitlements entries and modify the entitlement lookup routine."
^DIC(9.4,101,22,6,"PAH",33,1,10,0)="  2.  Add new type of time, Additional Firefighter Hours."
^DIC(9.4,101,22,6,"PAH",33,1,11,0)="  3.  Report new type of time--Base Tour Non Pay Hours--for non pay during a "
^DIC(9.4,101,22,6,"PAH",33,1,12,0)="      firefighters regularly scheduled hours."
^DIC(9.4,101,22,6,"PAH",33,1,13,0)="  4.  Calculate overtime and unscheduled time for all firefighters."
^DIC(9.4,101,22,6,"PAH",33,1,14,0)="  5.  Add new TT8B edits for the new types of firefighters."
^DIC(9.4,101,22,6,"PAH",33,1,15,0)=""
^DIC(9.4,101,22,6,"PAH",34,0)="54 SEQ #49^2991210^1"
^DIC(9.4,101,22,6,"PAH",34,1,0)="^^14^14^2991210"
^DIC(9.4,101,22,6,"PAH",34,1,1,0)="Firefighter fixes."
^DIC(9.4,101,22,6,"PAH",34,1,2,0)="o Fix decomp so NT/NH not counted for code R firefighters."
^DIC(9.4,101,22,6,"PAH",34,1,3,0)="o Fix decomp so code R and C firefighter overtime and/or unschedule"
^DIC(9.4,101,22,6,"PAH",34,1,4,0)="  regular is not undercounted when comptime used has been posted."
^DIC(9.4,101,22,6,"PAH",34,1,5,0)="o Fix 8B Edit Checks so the following checks are only made for code R or C"
^DIC(9.4,101,22,6,"PAH",34,1,6,0)="  firefighters."
^DIC(9.4,101,22,6,"PAH",34,1,7,0)="    error #175   RA hours may not exceed PT hours minus 53."
^DIC(9.4,101,22,6,"PAH",34,1,8,0)="    error #176   RE hours may not exceed PH hours minus 53."
^DIC(9.4,101,22,6,"PAH",34,1,9,0)="o Fix 8B Edit Checkks so the follow check is not made for code R or C"
^DIC(9.4,101,22,6,"PAH",34,1,10,0)="  firefighters."
^DIC(9.4,101,22,6,"PAH",34,1,11,0)="    error #55    Sum of RA + RB + RC or RE + RF + RG cannot exceed 20.0"
^DIC(9.4,101,22,6,"PAH",34,1,12,0)="o Modify Pay Period Exceptions so firefighters with premium pay code R or"
^DIC(9.4,101,22,6,"PAH",34,1,13,0)="  C do not need approved overtime requests for RA/RE (regular hours at OT"
^DIC(9.4,101,22,6,"PAH",34,1,14,0)="  rate) in the 8B string."
^DIC(9.4,101,22,6,"PAH",35,0)="49 SEQ #50^2991210^1"
^DIC(9.4,101,22,6,"PAH",35,1,0)="^^2^2^2991210"
^DIC(9.4,101,22,6,"PAH",35,1,1,0)="This enhancement will add a 30 day prior window lookup to the Leave Request "
^DIC(9.4,101,22,6,"PAH",35,1,2,0)="[PRSA LV REQ] menu option."
^DIC(9.4,101,22,6,"PAH",36,0)="53 SEQ #51^3000229^1"
^DIC(9.4,101,22,6,"PAH",36,1,0)="^^5^5^3000229"
^DIC(9.4,101,22,6,"PAH",36,1,1,0)="Update Class Registration Enter/Delete to use $$ADD^XUSERNEW instead of"
^DIC(9.4,101,22,6,"PAH",36,1,2,0)="FILE^DICN to add entries to the NEW PERSON file.  Require programmer"
^DIC(9.4,101,22,6,"PAH",36,1,3,0)="access or security key PRSE CORD in addition to the package parameter"
^DIC(9.4,101,22,6,"PAH",36,1,4,0)="before allowing entries to be added to the NEW PERSON file.  Improve how"
^DIC(9.4,101,22,6,"PAH",36,1,5,0)="locks are managed."
^DIC(9.4,101,22,6,"PAH",37,0)="55 SEQ #52^3000502^1"
^DIC(9.4,101,22,6,"PAH",37,1,0)="^^2^2^3000502"
^DIC(9.4,101,22,6,"PAH",37,1,1,0)=" 1. Fix supervisor disapproval of a tour change to the next pay period."
^DIC(9.4,101,22,6,"PAH",37,1,2,0)=" 2. Don't ask for confirmation when selecting a tour of duty."
^DIC(9.4,101,22,6,"PAH",38,0)="57 SEQ #53^3000516^1"
^DIC(9.4,101,22,6,"PAH",38,1,0)="^^7^7^3000516"
^DIC(9.4,101,22,6,"PAH",38,1,1,0)=" Fixes for Post Employee Time [PRSA TK POST] option."
^DIC(9.4,101,22,6,"PAH",38,1,2,0)=" o Allow the OT/CT on Premium T&L remark to be used with RG (regular time)"
^DIC(9.4,101,22,6,"PAH",38,1,3,0)="   so weekend premiums can be paid without also paying night differential."
^DIC(9.4,101,22,6,"PAH",38,1,4,0)=" o Exit the alphabetical employee loop if timekeeper enters '^' at prompt"
^DIC(9.4,101,22,6,"PAH",38,1,5,0)="   when an employee's pay period record is locked."
^DIC(9.4,101,22,6,"PAH",38,1,6,0)=" o Modify screen edit validation so posting of NOON as a time does not"
^DIC(9.4,101,22,6,"PAH",38,1,7,0)="   result in some validation checks being skipped."
^DIC(9.4,101,22,6,"PAH",39,0)="59 SEQ #54^3000711^1"
^DIC(9.4,101,22,6,"PAH",39,1,0)="^^4^4^3000711"
^DIC(9.4,101,22,6,"PAH",39,1,1,0)="Update Post Miscellaneous Data option to not allow a request for a"
^DIC(9.4,101,22,6,"PAH",39,1,2,0)="Record of Salary Payments on an employee with pay plan F (Fee Basis)."
^DIC(9.4,101,22,6,"PAH",39,1,3,0)="Also correct descriptions of Followup codes 04 and 20 in PAID"
^DIC(9.4,101,22,6,"PAH",39,1,4,0)="CODE FILE #454."
^DIC(9.4,101,22,6,"PAH",40,0)="52 SEQ #55^3000816^1"
^DIC(9.4,101,22,6,"PAH",40,1,0)="^^7^7^3000816"
^DIC(9.4,101,22,6,"PAH",40,1,1,0)="This patch corrects several problems with the PAID decomposition for"
^DIC(9.4,101,22,6,"PAH",40,1,2,0)="part-time employees who have Overtime (OT), Comptime (CT), Regular"
^DIC(9.4,101,22,6,"PAH",40,1,3,0)="Time (RG), Leave Without Pay (WP) or Non-Pay (NP)."
^DIC(9.4,101,22,6,"PAH",40,1,4,0)=""
^DIC(9.4,101,22,6,"PAH",40,1,5,0)="This patch addresses the following NOIS message:  VAC-0998-21654"
^DIC(9.4,101,22,6,"PAH",40,1,6,0)=""
^DIC(9.4,101,22,6,"PAH",40,1,7,0)="                  "
^DIC(9.4,101,22,6,"PAH",41,0)="58 SEQ #56^3000816^1"
^DIC(9.4,101,22,6,"PAH",41,1,0)="^^6^6^3000816"
^DIC(9.4,101,22,6,"PAH",41,1,1,0)="The Set Holiday Benefit Day incorrectly calculates the 5 day future window"
^DIC(9.4,101,22,6,"PAH",41,1,2,0)="when the option is run withing 5 days of the end of the month."
^DIC(9.4,101,22,6,"PAH",41,1,3,0)=""
^DIC(9.4,101,22,6,"PAH",41,1,4,0)="This patch will correct this calculation."
^DIC(9.4,101,22,6,"PAH",41,1,5,0)=""
^DIC(9.4,101,22,6,"PAH",41,1,6,0)="This patch addresses the problem reported on NOIS ISW-0100-20373."
^DIC(9.4,101,22,6,"PAH",42,0)="60 SEQ #57^3001004^1"
^DIC(9.4,101,22,6,"PAH",42,1,0)="^^1^1^3001004"
^DIC(9.4,101,22,6,"PAH",42,1,1,0)="EMPLOYEE PPA REPORT NOT DISPLAYING DATA CORRECTLY"
^DIC(9.4,101,22,6,"PAH",43,0)="56 SEQ #58^3001004^1"
^DIC(9.4,101,22,6,"PAH",43,1,0)="^^3^3^3001004"
^DIC(9.4,101,22,6,"PAH",43,1,1,0)="This patch will address several NOIS that have been reported dealing with how"
^DIC(9.4,101,22,6,"PAH",43,1,2,0)="the software automatically posts various types of leave for Full Time Doctors"
^DIC(9.4,101,22,6,"PAH",43,1,3,0)="(title 38)."
^DIC(9.4,101,22,6,"PAH",44,0)="61 SEQ #59^3001012^1"
^DIC(9.4,101,22,6,"PAH",44,1,0)="^^2^2^3001012"
^DIC(9.4,101,22,6,"PAH",44,1,1,0)="This patch corrects a few minor problems with leave used reports and the"
^DIC(9.4,101,22,6,"PAH",44,1,2,0)="validation of leave requests."
^DIC(9.4,101,22,6,"PAH",45,0)="64 SEQ #60^3010228^1"
^DIC(9.4,101,22,6,"PAH",45,1,0)="^^1^1^3010228"
^DIC(9.4,101,22,6,"PAH",45,1,1,0)="PPA PROCESSING PROBLEM AND %DT(0) LEAKAGE"
^DIC(9.4,101,22,6,"PAH",46,0)="62 SEQ #61^3010228^1"
^DIC(9.4,101,22,6,"PAH",46,1,0)="^^2^2^3010228"
^DIC(9.4,101,22,6,"PAH",46,1,1,0)="This patch stops SSN's from being printed on the Class Roster. It also"
^DIC(9.4,101,22,6,"PAH",46,1,2,0)="prevents an undefined error that can occur when class names are edited."
^DIC(9.4,101,22,6,"PAH",47,0)="65 SEQ #62^3010405^1"
^DIC(9.4,101,22,6,"PAH",47,1,0)="^^3^3^3010405"
^DIC(9.4,101,22,6,"PAH",47,1,1,0)="This patch adds additional logic to the Sunday Premium pay calculation and will"
^DIC(9.4,101,22,6,"PAH",47,1,2,0)="allow the software to correctly differentiate between work performed on shift"
^DIC(9.4,101,22,6,"PAH",47,1,3,0)="1, 2 or 3."
^DIC(9.4,101,22,6,"PAH",48,0)="63 SEQ #63^3010625^1"
^DIC(9.4,101,22,6,"PAH",48,1,0)="^^3^3^3010625"
^DIC(9.4,101,22,6,"PAH",48,1,1,0)="This patch will address several NOIS that have been reported dealing with how"
^DIC(9.4,101,22,6,"PAH",48,1,2,0)="the PAID software posts callback Overtime (OA/OE) and Comp Time Earned (CE/CT)"
^DIC(9.4,101,22,6,"PAH",48,1,3,0)="while On-Call."
^DIC(9.4,101,22,6,"PAH",49,0)="66 SEQ #64^3010710^1"
^DIC(9.4,101,22,6,"PAH",49,1,0)="^^1^1^3010710"
^DIC(9.4,101,22,6,"PAH",49,1,1,0)="EMPLOYEE CREDITED WITH EXTRA HOLIDAYS"
^DIC(9.4,101,22,6,"PAH",50,0)="69 SEQ #65^3011016^1"
^DIC(9.4,101,22,6,"PAH",50,1,0)="^^14^14^3011016"
^DIC(9.4,101,22,6,"PAH",50,1,1,0)="With the passing of Public Law 106-554 most employee who are elgible to take"
^DIC(9.4,101,22,6,"PAH",50,1,2,0)="Military Leave (ML) will now be elgible to take this type of leave in hours"
^DIC(9.4,101,22,6,"PAH",50,1,3,0)="instead of days."
^DIC(9.4,101,22,6,"PAH",50,1,4,0)=" "
^DIC(9.4,101,22,6,"PAH",50,1,5,0)="This patch updates the Vista PAID software to be compliant with this Public"
^DIC(9.4,101,22,6,"PAH",50,1,6,0)="Law.  Changes will include:"
^DIC(9.4,101,22,6,"PAH",50,1,7,0)=""
^DIC(9.4,101,22,6,"PAH",50,1,8,0)="1. Updates to the Data Dictionary."
^DIC(9.4,101,22,6,"PAH",50,1,9,0)="2. Updating the interface between Central PAID and Vista PAID."
^DIC(9.4,101,22,6,"PAH",50,1,10,0)="3. Updating the Leave Request and Edit Leave Request portion of the software."
^DIC(9.4,101,22,6,"PAH",50,1,11,0)="4. Updating the Supervisory Approvals."
^DIC(9.4,101,22,6,"PAH",50,1,12,0)="5. Updating the Timekeeper postings."
^DIC(9.4,101,22,6,"PAH",50,1,13,0)="6. Updating the Decomposition."
^DIC(9.4,101,22,6,"PAH",50,1,14,0)="7. Updating the various reporting programs that display Military Leave."
^DIC(9.4,101,22,6,"PAH",51,0)="70 SEQ #66^3011016^1"
^DIC(9.4,101,22,6,"PAH",51,1,0)="^^3^3^3011016"
^DIC(9.4,101,22,6,"PAH",51,1,1,0)="This patch will correct a problem that went out in patch PRS*4.0*69."
^DIC(9.4,101,22,6,"PAH",51,1,2,0)=""
^DIC(9.4,101,22,6,"PAH",51,1,3,0)="It consists of one routine PRSATIM."
^DIC(9.4,101,22,6,"PAH",52,0)="72 SEQ #67^3011231^1"
^DIC(9.4,101,22,6,"PAH",52,1,0)="^^12^12^3011231"
^DIC(9.4,101,22,6,"PAH",52,1,1,0)="On 12/6/2001 President Bush signed an executive order that excuses"
^DIC(9.4,101,22,6,"PAH",52,1,2,0)="executive branch employees from duty on the Monday before Christmas Day"
^DIC(9.4,101,22,6,"PAH",52,1,3,0)="(12/24/2001) except where agency officials decide they must remain open"
^DIC(9.4,101,22,6,"PAH",52,1,4,0)="because of national security or defense or other public reasons."
^DIC(9.4,101,22,6,"PAH",52,1,5,0)=""
^DIC(9.4,101,22,6,"PAH",52,1,6,0)="This patch enhances the PAID/ETA v4.0 software to add December 24,2001 as"
^DIC(9.4,101,22,6,"PAH",52,1,7,0)="a holiday.  The holiday will be used by the PAID/ETA software during the"
^DIC(9.4,101,22,6,"PAH",52,1,8,0)="opening of Pay Period 01-25 at which time the tours of duty for Monday"
^DIC(9.4,101,22,6,"PAH",52,1,9,0)="12/24/2001 will be set to Holiday Excused (HX)."
^DIC(9.4,101,22,6,"PAH",52,1,10,0)=""
^DIC(9.4,101,22,6,"PAH",52,1,11,0)="The only routine modification necessary to facilitate this is"
^DIC(9.4,101,22,6,"PAH",52,1,12,0)="to routine PRS8HD."
^DIC(9.4,101,22,6,"PAH",53,0)="71 SEQ #68^3011231^1"
^DIC(9.4,101,22,6,"PAH",53,1,0)="^^9^9^3011231"
^DIC(9.4,101,22,6,"PAH",53,1,1,0)="This patch will address a problem that has been reported dealing with the"
^DIC(9.4,101,22,6,"PAH",53,1,2,0)="8B edit for Full Time doctors taking Military Leave (ML)."
^DIC(9.4,101,22,6,"PAH",53,1,3,0)=" "
^DIC(9.4,101,22,6,"PAH",53,1,4,0)="The patch will also remove the code that was added to routine PRSATIM by"
^DIC(9.4,101,22,6,"PAH",53,1,5,0)="patch PRS*4*69.  These modifications were intended to force users to"
^DIC(9.4,101,22,6,"PAH",53,1,6,0)="request at least one hour when entering a leave request for Military"
^DIC(9.4,101,22,6,"PAH",53,1,7,0)="Leave (ML).  This restraint was later modified and the appropriate"
^DIC(9.4,101,22,6,"PAH",53,1,8,0)="checks were added to the Pay Period Certification portion of the software."
^DIC(9.4,101,22,6,"PAH",53,1,9,0)=" "
^DIC(9.4,101,22,6,"PAH",54,0)="74 SEQ #69^3020226^1"
^DIC(9.4,101,22,6,"PAH",54,1,0)="^^11^11^3020226"
^DIC(9.4,101,22,6,"PAH",54,1,1,0)="On January 23, 2002, the President signed into law H.R. 3447, becoming"
^DIC(9.4,101,22,6,"PAH",54,1,2,0)="P.L. 107-135.  Section 121 of the bill modifies 38 USC 7454(b) to provide"
^DIC(9.4,101,22,6,"PAH",54,1,3,0)="weekend (i.e., Saturday and Sunday) premium pay for certain ""health care"
^DIC(9.4,101,22,6,"PAH",54,1,4,0)="professionals"".  In VA terms, ""hybrid employees"" MUST now receive"
^DIC(9.4,101,22,6,"PAH",54,1,5,0)="Saturday and Sunday premium pay under title 38 rules.  This change"
^DIC(9.4,101,22,6,"PAH",54,1,6,0)="""appl(ies) with respect to pay periods beginning on or after the date of"
^DIC(9.4,101,22,6,"PAH",54,1,7,0)="enactment of this Act""."
^DIC(9.4,101,22,6,"PAH",54,1,8,0)=""
^DIC(9.4,101,22,6,"PAH",54,1,9,0)="This patch updates the PAID/ETA v4.0 software to ecomply with this Public Law."
^DIC(9.4,101,22,6,"PAH",54,1,10,0)=""
^DIC(9.4,101,22,6,"PAH",54,1,11,0)="For a full description of the patch please refer to patch PRS*4*74 on Forum."
^DIC(9.4,101,22,6,"PAH",55,0)="75 SEQ #70^3020327^1"
^DIC(9.4,101,22,6,"PAH",55,1,0)="^^13^13^3020327"
^DIC(9.4,101,22,6,"PAH",55,1,1,0)="On January 23, 2002, the President signed into law H.R. 3447, becoming"
^DIC(9.4,101,22,6,"PAH",55,1,2,0)="P.L. 107-135.  Section 121 of the bill modifies 38 USC 7454(b) to provide"
^DIC(9.4,101,22,6,"PAH",55,1,3,0)="weekend (i.e., Saturday and Sunday) premium pay for certain ""health care"
^DIC(9.4,101,22,6,"PAH",55,1,4,0)="professionals"".  In VA terms, ""hybrid employees"" MUST now receive"
^DIC(9.4,101,22,6,"PAH",55,1,5,0)="Saturday and Sunday premium pay under title 38 rules.  This change"
^DIC(9.4,101,22,6,"PAH",55,1,6,0)="""appl(ies) with respect to pay periods beginning on or after the date of"
^DIC(9.4,101,22,6,"PAH",55,1,7,0)="enactment of this Act""."
^DIC(9.4,101,22,6,"PAH",55,1,8,0)=""
^DIC(9.4,101,22,6,"PAH",55,1,9,0)="This patch adds the remainder of the functionality to comply with Public Law"
^DIC(9.4,101,22,6,"PAH",55,1,10,0)="P.L 107-135."
^DIC(9.4,101,22,6,"PAH",55,1,11,0)=""
^DIC(9.4,101,22,6,"PAH",55,1,12,0)="See the patch descriptions of PRS*4.0*74 and PRS*4.0*75 on Forum for full "
^DIC(9.4,101,22,6,"PAH",55,1,13,0)="details of what these two patches added to the VistA PAID/ETA software."
^DIC(9.4,101,22,6,"PAH",56,0)="76 SEQ #71^3020408^1"
^DIC(9.4,101,22,6,"PAH",56,1,0)="^^15^15^3020408"
^DIC(9.4,101,22,6,"PAH",56,1,1,0)="This patch will address OCCUPATION SERIES & TITLE codes ending in an Alpha"
^DIC(9.4,101,22,6,"PAH",56,1,2,0)="character for the Hybrid employees defined in Public Law 107-134."
^DIC(9.4,101,22,6,"PAH",56,1,3,0)=""
^DIC(9.4,101,22,6,"PAH",56,1,4,0)="Beginning in fiscal year 2002 some of the OCCUPATION SERIES & TITLE"
^DIC(9.4,101,22,6,"PAH",56,1,5,0)="codes end in an Alpha character.  These Alpha characters correspond to an"
^DIC(9.4,101,22,6,"PAH",56,1,6,0)="existing numeric code.  The $$HYBRID^PRSAENT extrinsic function was"
^DIC(9.4,101,22,6,"PAH",56,1,7,0)="modified to convert OCCUPATION SERIES & TITLE codes ending in an Alpha"
^DIC(9.4,101,22,6,"PAH",56,1,8,0)="character into its numeric equivalent before determining if the employee"
^DIC(9.4,101,22,6,"PAH",56,1,9,0)="is a Hybrid as described by Public Law 107-134."
^DIC(9.4,101,22,6,"PAH",56,1,10,0)=""
^DIC(9.4,101,22,6,"PAH",56,1,11,0)="The OCCUPATION SERIES & TITLE (#16) field is stored in the PAID EMPLOYEE"
^DIC(9.4,101,22,6,"PAH",56,1,12,0)="(#450) file."
^DIC(9.4,101,22,6,"PAH",56,1,13,0)=""
^DIC(9.4,101,22,6,"PAH",56,1,14,0)="See the patch description of PRS*4*76 on Forum for full details on the"
^DIC(9.4,101,22,6,"PAH",56,1,15,0)="additions and changes this patch made to the VistA PAID/ETA software."
^DIC(9.4,101,22,6,"PAH",57,0)="79 SEQ #72^3020906^1"
^DIC(9.4,101,22,6,"PAH",57,1,0)="^^4^4^3020906"
^DIC(9.4,101,22,6,"PAH",57,1,1,0)="This patch will compile information on the hours worked by nurses for the"
^DIC(9.4,101,22,6,"PAH",57,1,2,0)="years 1997 through 2001."
^DIC(9.4,101,22,6,"PAH",57,1,3,0)=""
^DIC(9.4,101,22,6,"PAH",57,1,4,0)="For a complete description of the report see the patch description on Forum."
^DIC(9.4,101,22,6,"PAH",58,0)="68 SEQ #73^3020906^1"
^DIC(9.4,101,22,6,"PAH",58,1,0)="^^7^7^3020906"
^DIC(9.4,101,22,6,"PAH",58,1,1,0)="This patch will address several NOIS related to how leave is credited and"
^DIC(9.4,101,22,6,"PAH",58,1,2,0)="charged.  The first NOIS addresses a problem with how Full Time doctors"
^DIC(9.4,101,22,6,"PAH",58,1,3,0)="are charged Non Duty days for weeks where they only work 2 days.  The"
^DIC(9.4,101,22,6,"PAH",58,1,4,0)="second NOIS addresses a problem with how General Schedule employees are"
^DIC(9.4,101,22,6,"PAH",58,1,5,0)="credited for Holiday Worked time.  The final NOIS describes a problem"
^DIC(9.4,101,22,6,"PAH",58,1,6,0)="where a menu option's description does not accurately reflect the output"
^DIC(9.4,101,22,6,"PAH",58,1,7,0)="of its report."
^DIC(9.4,101,22,6,"PAH",59,0)="77 SEQ #74^3030301^1"
^DIC(9.4,101,22,6,"PAH",59,1,0)="^^3^3^3030301"
^DIC(9.4,101,22,6,"PAH",59,1,1,0)="This patch will update the input transform for the CODE (#.01) field of the"
^DIC(9.4,101,22,6,"PAH",59,1,2,0)="OCCUPATION SERIES/TITLE (#454.01) multiple in the PAID CODE FILES (#454) file."
^DIC(9.4,101,22,6,"PAH",59,1,3,0)=""
^DIC(9.4,101,22,6,"PAH",60,0)="80 SEQ #75^3030329^1"
^DIC(9.4,101,22,6,"PAH",60,1,0)="^^2^2^3030329"
^DIC(9.4,101,22,6,"PAH",60,1,1,0)="This patch will update the logic that determines whether or not to pay the 2"
^DIC(9.4,101,22,6,"PAH",60,1,2,0)="hour minimum for work performed on a holiday."
^DIC(9.4,101,22,6,"PAH",61,0)="78 SEQ #76^3030417^1"
^DIC(9.4,101,22,6,"PAH",61,1,0)="^^3^3^3030417"
^DIC(9.4,101,22,6,"PAH",61,1,1,0)="This patch adds all of the necessary changes to the VistA PAID/ETA software to"
^DIC(9.4,101,22,6,"PAH",61,1,2,0)="be in compliance with Central PAID Service Request 02-436.  Please see the"
^DIC(9.4,101,22,6,"PAH",61,1,3,0)="patch description for complete details of these changes."
^DIC(9.4,101,22,6,"PAH",62,0)="83 SEQ #77^3030430^1"
