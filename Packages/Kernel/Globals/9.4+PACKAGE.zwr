^DIC(9.4,14,22,5.9,"PAH",143,1,88,0)="   "
^DIC(9.4,14,22,5.9,"PAH",143,1,89,0)="**********************************************************************"
^DIC(9.4,14,22,5.9,"PAH",143,1,90,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,91,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,92,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",143,1,93,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",143,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,95,0)="  The install time for this patch is less than 2 minutes. This patch"
^DIC(9.4,14,22,5.9,"PAH",143,1,96,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",143,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,98,0)="NOTE: Kernel patches must be current on the target system"
^DIC(9.4,14,22,5.9,"PAH",143,1,99,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",143,1,100,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,101,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",143,1,102,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",143,1,103,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,104,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",143,1,105,0)="      system.  You now need to use KIDS to install the transport   "
^DIC(9.4,14,22,5.9,"PAH",143,1,106,0)="      global."
^DIC(9.4,14,22,5.9,"PAH",143,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,108,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",143,1,109,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",143,1,110,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,111,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify "
^DIC(9.4,14,22,5.9,"PAH",143,1,112,0)="      that all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",143,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,114,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the   "
^DIC(9.4,14,22,5.9,"PAH",143,1,115,0)="      following options:"
^DIC(9.4,14,22,5.9,"PAH",143,1,116,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",143,1,117,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",143,1,118,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",143,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,120,0)="      If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,14,22,5.9,"PAH",143,1,121,0)="      patch prior to installation, you should use the 'Backup a "
^DIC(9.4,14,22,5.9,"PAH",143,1,122,0)="      Transport Global' option at this time.  You may also compare the  "
^DIC(9.4,14,22,5.9,"PAH",143,1,123,0)="      routines in your production account to the routines in the patch  "
^DIC(9.4,14,22,5.9,"PAH",143,1,124,0)="      by using the 'Compare a Transport Global to Current System' "
^DIC(9.4,14,22,5.9,"PAH",143,1,125,0)="      option."
^DIC(9.4,14,22,5.9,"PAH",143,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,127,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,128,0)="  6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",143,1,129,0)="      and select the package 'LR*5.2*320'."
^DIC(9.4,14,22,5.9,"PAH",143,1,130,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,131,0)="      If prompted ' Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",143,1,132,0)="      Install? YES//' choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",143,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,134,0)="      If prompted ' Want KIDS to INHIBIT LOGONs during the install?  "
^DIC(9.4,14,22,5.9,"PAH",143,1,135,0)="      YES// ' choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",143,1,136,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,137,0)="      If prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",143,1,138,0)="      Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",143,1,139,0)="  "
^DIC(9.4,14,22,5.9,"PAH",143,1,140,0)="  7.  Routine LR320 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",143,1,141,0)=""
^DIC(9.4,14,22,5.9,"PAH",144,0)="316 SEQ #242^3041029^1"
^DIC(9.4,14,22,5.9,"PAH",144,1,0)="^^3^3^3041029"
^DIC(9.4,14,22,5.9,"PAH",144,1,1,0)="This patch will prevent a user from entering the ; and : characters when"
^DIC(9.4,14,22,5.9,"PAH",144,1,2,0)="defining or modifying a data name using menu options Add a new data name"
^DIC(9.4,14,22,5.9,"PAH",144,1,3,0)="[LRWU5] and Modify an existing data name [LRWU6]."
^DIC(9.4,14,22,5.9,"PAH",145,0)="318 SEQ #243^3041228^1"
^DIC(9.4,14,22,5.9,"PAH",145,1,0)="^^4^4^3041228"
^DIC(9.4,14,22,5.9,"PAH",145,1,1,0)="This patch addresses 2 NOIS calls:"
^DIC(9.4,14,22,5.9,"PAH",145,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",145,1,3,0)="1) BRK-1095-12897  PROBLEMS WITH SUMMARY LIST (SUPERVISORS')"
^DIC(9.4,14,22,5.9,"PAH",145,1,4,0)="2) ECH-0404-50682  ERROR AT P1+10^LRLISTE"
^DIC(9.4,14,22,5.9,"PAH",146,0)="295^3041228^1"
^DIC(9.4,14,22,5.9,"PAH",146,1,0)="^^156^156^3041228"
^DIC(9.4,14,22,5.9,"PAH",146,1,1,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,2,0)=" This project consists of 12 patches that work together to create a new"
^DIC(9.4,14,22,5.9,"PAH",146,1,3,0)=" Clinical Reminders index global. The purpose of this index is to provide"
^DIC(9.4,14,22,5.9,"PAH",146,1,4,0)=" rapid access to clinical data. All of the standard Clinical Reminders"
^DIC(9.4,14,22,5.9,"PAH",146,1,5,0)=" finding types are included in the index."
^DIC(9.4,14,22,5.9,"PAH",146,1,6,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,7,0)=" The 12 patches that comprise this project are:"
^DIC(9.4,14,22,5.9,"PAH",146,1,8,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,9,0)="   Package                                 Patch"
^DIC(9.4,14,22,5.9,"PAH",146,1,10,0)="   -------                                 -----"
^DIC(9.4,14,22,5.9,"PAH",146,1,11,0)="   Clinical Reminders                      PXRM*1.5*12"
^DIC(9.4,14,22,5.9,"PAH",146,1,12,0)="   Inpatient Pharmacy                      PSJ*5*90"
^DIC(9.4,14,22,5.9,"PAH",146,1,13,0)="   Laboratory                              LR*5.2*295"
^DIC(9.4,14,22,5.9,"PAH",146,1,14,0)="   Mental Health                           YS*5.01*77"
^DIC(9.4,14,22,5.9,"PAH",146,1,15,0)="   Order Entry/Results Reporting (OE/RR)   OR*3*157"
^DIC(9.4,14,22,5.9,"PAH",146,1,16,0)="   Outpatient Pharmacy                     PSO*7*118"
^DIC(9.4,14,22,5.9,"PAH",146,1,17,0)="   Patient Care Encounter (PCE)            PX*1.0*119"
^DIC(9.4,14,22,5.9,"PAH",146,1,18,0)="   Pharmacy Data Management                PSS*1*62"
^DIC(9.4,14,22,5.9,"PAH",146,1,19,0)="   PIMS/Scheduling                         DG*5.3*478"
^DIC(9.4,14,22,5.9,"PAH",146,1,20,0)="   Problem List                            GMPL*2*27"
^DIC(9.4,14,22,5.9,"PAH",146,1,21,0)="   Radiology                               RA*5*33"
^DIC(9.4,14,22,5.9,"PAH",146,1,22,0)="   Vitals                                  GMRV*4*15"
^DIC(9.4,14,22,5.9,"PAH",146,1,23,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,24,0)=" This patch (LR*5.2*295) provides the description of the Lab"
^DIC(9.4,14,22,5.9,"PAH",146,1,25,0)=" routines, but not the Lab routines themselves, which must be loaded"
^DIC(9.4,14,22,5.9,"PAH",146,1,26,0)=" from the main multi-build host file. PXRM*1.5*12 distributes these Lab"
^DIC(9.4,14,22,5.9,"PAH",146,1,27,0)=" routines. This patch provides a new global ^PXRMINDX where Lab data"
^DIC(9.4,14,22,5.9,"PAH",146,1,28,0)=" are indexed in ^PXRMINDX(63, for fast retrieval. Lab APIs are provided"
^DIC(9.4,14,22,5.9,"PAH",146,1,29,0)=" to provide easy access. APIs are documented in DBIAs 4245 and 4246."
^DIC(9.4,14,22,5.9,"PAH",146,1,30,0)=" Changes were made to existing Lab routines that update the indexes"
^DIC(9.4,14,22,5.9,"PAH",146,1,31,0)=" whenever Lab data is added, edited, or deleted."
^DIC(9.4,14,22,5.9,"PAH",146,1,32,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,33,0)=" Note: This patch is informational; the build (LR*5.2*295) will be"
^DIC(9.4,14,22,5.9,"PAH",146,1,34,0)=" distributed as part of a multi-package build,"
^DIC(9.4,14,22,5.9,"PAH",146,1,35,0)=" CLINICAL_REMINDERS_INDEX.KID."
^DIC(9.4,14,22,5.9,"PAH",146,1,36,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,37,0)="  Blood Bank Clearance:"
^DIC(9.4,14,22,5.9,"PAH",146,1,38,0)="  ====================="
^DIC(9.4,14,22,5.9,"PAH",146,1,39,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,40,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*295 does not "
^DIC(9.4,14,22,5.9,"PAH",146,1,41,0)=" contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",146,1,42,0)=" DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",146,1,43,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,44,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*295 does not "
^DIC(9.4,14,22,5.9,"PAH",146,1,45,0)=" alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",146,1,46,0)=" elements functions."
^DIC(9.4,14,22,5.9,"PAH",146,1,47,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,48,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*295 have no effect on "
^DIC(9.4,14,22,5.9,"PAH",146,1,49,0)=" Blood Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",146,1,50,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,51,0)=" VALIDATION REQUIREMENTS BY OPTION:  Because of the nature of the "
^DIC(9.4,14,22,5.9,"PAH",146,1,52,0)=" changes made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",146,1,53,0)=" installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",146,1,54,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,55,0)="  Documentation:"
^DIC(9.4,14,22,5.9,"PAH",146,1,56,0)="  =============="
^DIC(9.4,14,22,5.9,"PAH",146,1,57,0)=" An installation guide, PXRMIG-P12.PDF, and a technical manual,"
^DIC(9.4,14,22,5.9,"PAH",146,1,58,0)=" PXRMTM-P12.PDF, are available. This documentation will be in the form"
^DIC(9.4,14,22,5.9,"PAH",146,1,59,0)=" of Adobe Acrobat files. The documentation can also be found on the"
^DIC(9.4,14,22,5.9,"PAH",146,1,60,0)=" Health System Design and Development Web page: (http://vista.domain.ext/vdl/)."
^DIC(9.4,14,22,5.9,"PAH",146,1,61,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,62,0)=" The preferred method is to FTP the files from download.vista.domain.ext."
^DIC(9.4,14,22,5.9,"PAH",146,1,63,0)=" This transmits the files from the first available FTP server. Sites"
^DIC(9.4,14,22,5.9,"PAH",146,1,64,0)=" may also elect to retrieve documents directly from a specific server as"
^DIC(9.4,14,22,5.9,"PAH",146,1,65,0)=" follows:"
^DIC(9.4,14,22,5.9,"PAH",146,1,66,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,67,0)=" Albany          ftp.fo-albany.domain.ext  <ftp://ftp.fo-albany.domain.ext>"
^DIC(9.4,14,22,5.9,"PAH",146,1,68,0)=" Hines           ftp.fo-hines.domain.ext   <ftp://ftp.fo-hines.domain.ext>"
^DIC(9.4,14,22,5.9,"PAH",146,1,69,0)=" Salt Lake City  ftp.fo-slc.domain.ext     <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,14,22,5.9,"PAH",146,1,70,0)="  "
^DIC(9.4,14,22,5.9,"PAH",146,1,71,0)="  Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",146,1,72,0)="  ==========="
^DIC(9.4,14,22,5.9,"PAH",146,1,73,0)="  Anchorage"
^DIC(9.4,14,22,5.9,"PAH",146,1,74,0)="  Augusta"
