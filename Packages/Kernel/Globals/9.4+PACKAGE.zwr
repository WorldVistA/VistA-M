^DIC(9.4,33,22,1.4,"PAH",4,0)="17 SEQ #10^2961104^1"
^DIC(9.4,33,22,1.4,"PAH",4,1,0)="^^90^90^2961104"
^DIC(9.4,33,22,1.4,"PAH",4,1,1,0)="The ^HLCS global is reported to be growing rapidly and uncontrollably."
^DIC(9.4,33,22,1.4,"PAH",4,1,2,0)="Mailman-type Logical Links are growing continuously because messages are"
^DIC(9.4,33,22,1.4,"PAH",4,1,3,0)="never set to a 'done' status after it is handed off to Mailman."
^DIC(9.4,33,22,1.4,"PAH",4,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,5,0)="This patch corrects the problem of uncontrolled growth of file 870."
^DIC(9.4,33,22,1.4,"PAH",4,1,6,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,7,0)="Further, it corrects the following miscellaneous problems:"
^DIC(9.4,33,22,1.4,"PAH",4,1,8,0)="-The date field of the zero node in ^XMB(3.9 is set incorrectly if the"
^DIC(9.4,33,22,1.4,"PAH",4,1,9,0)="background job has been running for several days. It is now updated with a"
^DIC(9.4,33,22,1.4,"PAH",4,1,10,0)="call to $$DT^XLFDT."
^DIC(9.4,33,22,1.4,"PAH",4,1,11,0)="-The subject field of the message has been modified slightly. The sending"
^DIC(9.4,33,22,1.4,"PAH",4,1,12,0)="facility now derives the site name from the ^VASITE call."
^DIC(9.4,33,22,1.4,"PAH",4,1,13,0)="-An effort has been made to optimize the transfer of message text from"
^DIC(9.4,33,22,1.4,"PAH",4,1,14,0)="^HLCS to ^XMB. It now uses the merge command to move text 100 lines at a"
^DIC(9.4,33,22,1.4,"PAH",4,1,15,0)="time into ^XMB. Please note that any benefit derived from this change has"
^DIC(9.4,33,22,1.4,"PAH",4,1,16,0)="not been proven yet."
^DIC(9.4,33,22,1.4,"PAH",4,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,18,0)="This patch contains the following routine:"
^DIC(9.4,33,22,1.4,"PAH",4,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,20,0)="^HLCSMM"
^DIC(9.4,33,22,1.4,"PAH",4,1,21,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,22,0)="The second line now looks like this:"
^DIC(9.4,33,22,1.4,"PAH",4,1,23,0)="           ;;1.6;HEALTH LEVEL SEVEN;**17**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",4,1,24,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,26,0)="Installation"
^DIC(9.4,33,22,1.4,"PAH",4,1,27,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,28,0)="o      Disable all HL7 version 1.6 OUTBOUND FILERS and"
^DIC(9.4,33,22,1.4,"PAH",4,1,29,0)="wait for the process' to disappear from the system status."
^DIC(9.4,33,22,1.4,"PAH",4,1,30,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,31,0)="   Select V1.6 OPTIONS Option: COMmunications Server"
^DIC(9.4,33,22,1.4,"PAH",4,1,32,0)="   1      Edit Communication Server parameters"
^DIC(9.4,33,22,1.4,"PAH",4,1,33,0)="   2      Manage incoming & outgoing filers ..."
^DIC(9.4,33,22,1.4,"PAH",4,1,34,0)="   3      Monitor incoming & outgoing filers"
^DIC(9.4,33,22,1.4,"PAH",4,1,35,0)="   4      Start LLP"
^DIC(9.4,33,22,1.4,"PAH",4,1,36,0)="   5      Stop LLP"
^DIC(9.4,33,22,1.4,"PAH",4,1,37,0)="   6      Systems Link Monitor"
^DIC(9.4,33,22,1.4,"PAH",4,1,38,0)="   7      Logical Link Queue Management ..."
^DIC(9.4,33,22,1.4,"PAH",4,1,39,0)="   8      Report"
^DIC(9.4,33,22,1.4,"PAH",4,1,40,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,41,0)="Select Communications Server Option: 2"
^DIC(9.4,33,22,1.4,"PAH",4,1,42,0)="                                     ="
^DIC(9.4,33,22,1.4,"PAH",4,1,43,0)="   1      Start default number of incoming & outgoing filers"
^DIC(9.4,33,22,1.4,"PAH",4,1,44,0)="   2      Start an incoming filer"
^DIC(9.4,33,22,1.4,"PAH",4,1,45,0)="   3      Start an outgoing filer"
^DIC(9.4,33,22,1.4,"PAH",4,1,46,0)="   4      Stop all incoming filers"
^DIC(9.4,33,22,1.4,"PAH",4,1,47,0)="   5      Stop all outgoing filers"
^DIC(9.4,33,22,1.4,"PAH",4,1,48,0)="   6      Stop an incoming filer"
^DIC(9.4,33,22,1.4,"PAH",4,1,49,0)="   7      Stop an outgoing filer"
^DIC(9.4,33,22,1.4,"PAH",4,1,50,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,51,0)="Select Manage incoming & outgoing filers Option: 5"
^DIC(9.4,33,22,1.4,"PAH",4,1,52,0)="                                                 ="
^DIC(9.4,33,22,1.4,"PAH",4,1,53,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,54,0)="Use the option, SYSTEMS LINK MONITOR to check the status of messages being"
^DIC(9.4,33,22,1.4,"PAH",4,1,55,0)="processed out of your active Logical Links. It will look SIMILAR to this:"
^DIC(9.4,33,22,1.4,"PAH",4,1,56,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,57,0)="                MESSAGES  MESSAGES   MESSAGES  MESSAGES  DEVICE  "
^DIC(9.4,33,22,1.4,"PAH",4,1,58,0)="     NODE       RECEIVED  PROCESSED  TO SEND   SENT      ON-LINE  STATE   "
^DIC(9.4,33,22,1.4,"PAH",4,1,59,0)="AMB-CARE        0         0          1         1            Y     OUT QUEUE"
^DIC(9.4,33,22,1.4,"PAH",4,1,60,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,61,0)="Notice that MESSAGES TO SEND and MESSAGES SENT are equal. As long as the"
^DIC(9.4,33,22,1.4,"PAH",4,1,62,0)="filers are disabled, no new messages will be queued. It is now safe to"
^DIC(9.4,33,22,1.4,"PAH",4,1,63,0)="CLEAR THE QUEUE OF ALL ENTRIES."
^DIC(9.4,33,22,1.4,"PAH",4,1,64,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,65,0)="Select the option LOGICAL LINK QUEUE MANAGEMENT, then"
^DIC(9.4,33,22,1.4,"PAH",4,1,66,0)="select CLEAR A QUEUE OF ALL ENTRIES. Use this option to clear out all of"
^DIC(9.4,33,22,1.4,"PAH",4,1,67,0)="your 'Mailman' type links."
^DIC(9.4,33,22,1.4,"PAH",4,1,68,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,69,0)="Now disable the logical links you have just cleared and prepare to install"
^DIC(9.4,33,22,1.4,"PAH",4,1,70,0)="this patch. Use the option, STOP LLP to shut down the links."
^DIC(9.4,33,22,1.4,"PAH",4,1,71,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,72,0)="o AXP sites should check and remove HL* from their map sets."
^DIC(9.4,33,22,1.4,"PAH",4,1,73,0)="       (Mapping of HL7 1.6 routines is not recommended at this time)"
^DIC(9.4,33,22,1.4,"PAH",4,1,74,0)="o Users may remain on the system."
^DIC(9.4,33,22,1.4,"PAH",4,1,75,0)="o Load the KIDS BUILD FILE using the Packman option INSTALL/CHECK MESSAGE."
^DIC(9.4,33,22,1.4,"PAH",4,1,76,0)="o On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,33,22,1.4,"PAH",4,1,77,0)="       option: "
^DIC(9.4,33,22,1.4,"PAH",4,1,78,0)="         Select Installation Option:  Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",4,1,79,0)="                                     =================="
^DIC(9.4,33,22,1.4,"PAH",4,1,80,0)="         Select INSTALL NAME:  HL*1.6*17 "
^DIC(9.4,33,22,1.4,"PAH",4,1,81,0)="                              ========="
^DIC(9.4,33,22,1.4,"PAH",4,1,82,0)="         Answer 'NO' to 'Want to DISABLE Schedule Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",4,1,83,0)="         and Protocols?' "
^DIC(9.4,33,22,1.4,"PAH",4,1,84,0)="o MSM Sites - Answer 'YES' to the question 'Want to MOVE routines to"
^DIC(9.4,33,22,1.4,"PAH",4,1,85,0)="       other CPUs?' Then enter the names of your other Compute and Print"
^DIC(9.4,33,22,1.4,"PAH",4,1,86,0)="       server(s).  "
^DIC(9.4,33,22,1.4,"PAH",4,1,87,0)=" "
^DIC(9.4,33,22,1.4,"PAH",4,1,88,0)="After the KIDS installation has completed, remember to re-enable all"
^DIC(9.4,33,22,1.4,"PAH",4,1,89,0)="previously disabled Logical Links (START LLP) and re-start your default"
^DIC(9.4,33,22,1.4,"PAH",4,1,90,0)="number of INBOUND and OUTBOUND filers."
^DIC(9.4,33,22,1.4,"PAH",5,0)="21 SEQ #13^2970122^1"
^DIC(9.4,33,22,1.4,"PAH",5,1,0)="^^2^2^2970122"
^DIC(9.4,33,22,1.4,"PAH",5,1,1,0)="This patch enhances the purge utility by supporting a 'vaporization date'"
^DIC(9.4,33,22,1.4,"PAH",5,1,2,0)="for HL7 messages. See the patch module for details."
^DIC(9.4,33,22,1.4,"PAH",6,0)="18 SEQ #15^2970307^1"
^DIC(9.4,33,22,1.4,"PAH",6,1,0)="^^52^52^2970307"
^DIC(9.4,33,22,1.4,"PAH",6,1,1,0)="The Inbound and Outbound filers can be forced into an infinite loop if"
^DIC(9.4,33,22,1.4,"PAH",6,1,2,0)="entries in file 869.3 (HL COMMUNICATION SERVER PARAMETERS) are deleted."
^DIC(9.4,33,22,1.4,"PAH",6,1,3,0)="The file and related monitors will then not provide accurate information"
^DIC(9.4,33,22,1.4,"PAH",6,1,4,0)="regarding the number of filers actually running on your system."
^DIC(9.4,33,22,1.4,"PAH",6,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,6,0)="The routine ^HLCSUTL2 has been modified to signal a filer to stop whether"
^DIC(9.4,33,22,1.4,"PAH",6,1,7,0)="the user sets the stop flag or actually deletes the entry from the file."
^DIC(9.4,33,22,1.4,"PAH",6,1,8,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,9,0)="The second line of HLCSUTL2 now looks like:"
^DIC(9.4,33,22,1.4,"PAH",6,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,11,0)="        ;;1.6;HEALTH LEVEL SEVEN;**18**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",6,1,12,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,13,0)="To install this patch"
^DIC(9.4,33,22,1.4,"PAH",6,1,14,0)="====================="
^DIC(9.4,33,22,1.4,"PAH",6,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,16,0)="1. Stop all running filers (select options 4 and 5, below)"
^DIC(9.4,33,22,1.4,"PAH",6,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,18,0)="Select Communications Server Option: MANage incoming & outgoing filers"
^DIC(9.4,33,22,1.4,"PAH",6,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,20,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,21,0)="   1      Start default number of incoming & outgoing filers"
^DIC(9.4,33,22,1.4,"PAH",6,1,22,0)="   2      Start an incoming filer"
^DIC(9.4,33,22,1.4,"PAH",6,1,23,0)="   3      Start an outgoing filer"
^DIC(9.4,33,22,1.4,"PAH",6,1,24,0)="   4      Stop all incoming filers"
^DIC(9.4,33,22,1.4,"PAH",6,1,25,0)="   5      Stop all outgoing filers"
^DIC(9.4,33,22,1.4,"PAH",6,1,26,0)="   6      Stop an incoming filer"
^DIC(9.4,33,22,1.4,"PAH",6,1,27,0)="   7      Stop an outgoing filer"
^DIC(9.4,33,22,1.4,"PAH",6,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,29,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,30,0)="2. AXP sites should check and remove HL* from their map sets."
^DIC(9.4,33,22,1.4,"PAH",6,1,31,0)="       (Mapping of HL7 1.6 routines is not recommended at this time)"
^DIC(9.4,33,22,1.4,"PAH",6,1,32,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,33,0)="3. Users may remain on the system."
^DIC(9.4,33,22,1.4,"PAH",6,1,34,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,35,0)="4. Load the KIDS BUILD FILE using the Packman option INSTALL/CHECK"
^DIC(9.4,33,22,1.4,"PAH",6,1,36,0)="MESSAGE."
^DIC(9.4,33,22,1.4,"PAH",6,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,38,0)="5. On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,33,22,1.4,"PAH",6,1,39,0)="       option: "
^DIC(9.4,33,22,1.4,"PAH",6,1,40,0)="         Select Installation Option:  Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",6,1,41,0)="                                     =================="
^DIC(9.4,33,22,1.4,"PAH",6,1,42,0)="         Select INSTALL NAME:  HL*1.6*18 "
^DIC(9.4,33,22,1.4,"PAH",6,1,43,0)="                              ========="
^DIC(9.4,33,22,1.4,"PAH",6,1,44,0)="         Answer 'NO' to 'Want to DISABLE Schedule Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",6,1,45,0)="         and Protocols?' "
^DIC(9.4,33,22,1.4,"PAH",6,1,46,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,47,0)="6. MSM Sites - Answer 'YES' to the question 'Want to MOVE routines to"
^DIC(9.4,33,22,1.4,"PAH",6,1,48,0)="       other CPUs?' Then enter the names of your other Compute and Print"
^DIC(9.4,33,22,1.4,"PAH",6,1,49,0)="       server(s).  "
^DIC(9.4,33,22,1.4,"PAH",6,1,50,0)=" "
^DIC(9.4,33,22,1.4,"PAH",6,1,51,0)="7. After the KIDS installation has completed, remember to re-start your"
^DIC(9.4,33,22,1.4,"PAH",6,1,52,0)="default number of INBOUND and OUTBOUND filers. (option 1 above)"
^DIC(9.4,33,22,1.4,"PAH",7,0)="25 SEQ #18^2970321^1"
^DIC(9.4,33,22,1.4,"PAH",7,1,0)="^^68^68^2970321"
^DIC(9.4,33,22,1.4,"PAH",7,1,1,0)="This patch is used to fix the problems described in NOIS calls: "
^DIC(9.4,33,22,1.4,"PAH",7,1,2,0)="HUN-0297-21666, LEX-0297-41531, BAC-0297-40046, IND-0197-42390,"
^DIC(9.4,33,22,1.4,"PAH",7,1,3,0)="JAC-0297-71674, MAR-0297-20929, etc. The filers erred out abnormally when"
^DIC(9.4,33,22,1.4,"PAH",7,1,4,0)="unexpected data were encountered. This patch will catch these unexpected"
^DIC(9.4,33,22,1.4,"PAH",7,1,5,0)="data to prevent these errors."
^DIC(9.4,33,22,1.4,"PAH",7,1,6,0)="  "
^DIC(9.4,33,22,1.4,"PAH",7,1,7,0)="It will fix the problems for the outgoing filer as follows:"
^DIC(9.4,33,22,1.4,"PAH",7,1,8,0)=" -catch the erroneous client message entry with incorrect Logical Link."
^DIC(9.4,33,22,1.4,"PAH",7,1,9,0)=" -catch the erroneous client message entry with parent message missing."
^DIC(9.4,33,22,1.4,"PAH",7,1,10,0)="- catch the erroneous client message entry with  illegal message type."
^DIC(9.4,33,22,1.4,"PAH",7,1,11,0)="    "
^DIC(9.4,33,22,1.4,"PAH",7,1,12,0)="It will fix the problems for the incoming filer as follows:"
^DIC(9.4,33,22,1.4,"PAH",7,1,13,0)=" -mock MSA segment error when a batch message is received."
^DIC(9.4,33,22,1.4,"PAH",7,1,14,0)=" -missing original outgoing message of the incoming message error."
^DIC(9.4,33,22,1.4,"PAH",7,1,15,0)=" -missing Event Type Protocol pointer error."
^DIC(9.4,33,22,1.4,"PAH",7,1,16,0)="  "
^DIC(9.4,33,22,1.4,"PAH",7,1,17,0)="   "
^DIC(9.4,33,22,1.4,"PAH",7,1,18,0)="ROUTINE INFORMATION "
^DIC(9.4,33,22,1.4,"PAH",7,1,19,0)="===================="
^DIC(9.4,33,22,1.4,"PAH",7,1,20,0)="  "
^DIC(9.4,33,22,1.4,"PAH",7,1,21,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,33,22,1.4,"PAH",7,1,22,0)=" these routines now look like:"
^DIC(9.4,33,22,1.4,"PAH",7,1,23,0)="   "
^DIC(9.4,33,22,1.4,"PAH",7,1,24,0)="   <tab>;;1.6;HEALTH LEVEL SEVEN;**Patch List**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",7,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",7,1,26,0)="              CHECK^XTSUMBLD results"
^DIC(9.4,33,22,1.4,"PAH",7,1,27,0)="   "
^DIC(9.4,33,22,1.4,"PAH",7,1,28,0)="   Routine Name     Before Patch     After Patch       Patch List"
^DIC(9.4,33,22,1.4,"PAH",7,1,29,0)="   ------------     ------------     -----------       ----------"
^DIC(9.4,33,22,1.4,"PAH",7,1,30,0)="    HLCSOUT           3686510          4104234             25"
^DIC(9.4,33,22,1.4,"PAH",7,1,31,0)="    HLTF1            13439654          9700889          5,8,22,25"
^DIC(9.4,33,22,1.4,"PAH",7,1,32,0)="    HLTF2               N/A            4516843             25"
^DIC(9.4,33,22,1.4,"PAH",7,1,33,0)="    HLTP0             3059568          3059585             25"
^DIC(9.4,33,22,1.4,"PAH",7,1,34,0)="    HLTP01            3988246          3987933            2,25"
^DIC(9.4,33,22,1.4,"PAH",7,1,35,0)="    HLTPCK1A         10899550          9629334            2,25"
^DIC(9.4,33,22,1.4,"PAH",7,1,36,0)="     "
^DIC(9.4,33,22,1.4,"PAH",7,1,37,0)="     "
^DIC(9.4,33,22,1.4,"PAH",7,1,38,0)="INSTALLATION INSTRUCTIONS "
^DIC(9.4,33,22,1.4,"PAH",7,1,39,0)="========================="
^DIC(9.4,33,22,1.4,"PAH",7,1,40,0)="1. Users may remain on the system during the installation of this "
^DIC(9.4,33,22,1.4,"PAH",7,1,41,0)="   patch. "
^DIC(9.4,33,22,1.4,"PAH",7,1,42,0)="2. Shut down all the incoming and outgoing filers by using the "
^DIC(9.4,33,22,1.4,"PAH",7,1,43,0)="   options: 'Stop all incoming filers' and 'Stop all outgoing filers'"
^DIC(9.4,33,22,1.4,"PAH",7,1,44,0)="3. For mapped AXP sites, disable mapping for these routines."
^DIC(9.4,33,22,1.4,"PAH",7,1,45,0)="4. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,33,22,1.4,"PAH",7,1,46,0)="   option will load the KIDS package onto your system."
^DIC(9.4,33,22,1.4,"PAH",7,1,47,0)="5. On the KIDS menu, under the 'Installation' menu,"
^DIC(9.4,33,22,1.4,"PAH",7,1,48,0)="   use the following options:"
^DIC(9.4,33,22,1.4,"PAH",7,1,49,0)=" "
^DIC(9.4,33,22,1.4,"PAH",7,1,50,0)="            Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",7,1,51,0)="            Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",7,1,52,0)="            Verify Checksums in Transport Global "
^DIC(9.4,33,22,1.4,"PAH",7,1,53,0)="            Backup a Transport Global "
^DIC(9.4,33,22,1.4,"PAH",7,1,54,0)=" "
^DIC(9.4,33,22,1.4,"PAH",7,1,55,0)="6. On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,33,22,1.4,"PAH",7,1,56,0)="   option: "
^DIC(9.4,33,22,1.4,"PAH",7,1,57,0)="     Select Installation Option: Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",7,1,58,0)="                                 ================"
^DIC(9.4,33,22,1.4,"PAH",7,1,59,0)="     Select INSTALL NAME: HL*1.6*25 "
^DIC(9.4,33,22,1.4,"PAH",7,1,60,0)="                          ========="
^DIC(9.4,33,22,1.4,"PAH",7,1,61,0)="     Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,33,22,1.4,"PAH",7,1,62,0)="     and Protocols?'. "
^DIC(9.4,33,22,1.4,"PAH",7,1,63,0)="7. MSM Sites - Answer 'YES' to the question 'Want to"
^DIC(9.4,33,22,1.4,"PAH",7,1,64,0)="   MOVE routines to other CPUs?'.  "
^DIC(9.4,33,22,1.4,"PAH",7,1,65,0)="   Then enter the names of your other Compute and Print server(s).  "
^DIC(9.4,33,22,1.4,"PAH",7,1,66,0)="8. AXP Sites - After the patch has been installed, rebuild your map "
^DIC(9.4,33,22,1.4,"PAH",7,1,67,0)="   set. "
^DIC(9.4,33,22,1.4,"PAH",7,1,68,0)="9. Restart the incoming and outgoing filers."
^DIC(9.4,33,22,1.4,"PAH",8,0)="26 SEQ #20^2970610^1"
^DIC(9.4,33,22,1.4,"PAH",8,1,0)="^^100^100^2970610"
^DIC(9.4,33,22,1.4,"PAH",8,1,1,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,2,0)="Prerequisites:"
^DIC(9.4,33,22,1.4,"PAH",8,1,3,0)="=========== "
^DIC(9.4,33,22,1.4,"PAH",8,1,4,0)="     None"
^DIC(9.4,33,22,1.4,"PAH",8,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,6,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,7,0)="Subject:"
^DIC(9.4,33,22,1.4,"PAH",8,1,8,0)="======"
^DIC(9.4,33,22,1.4,"PAH",8,1,9,0)="    "
^DIC(9.4,33,22,1.4,"PAH",8,1,10,0)="HL*1.6*26"
^DIC(9.4,33,22,1.4,"PAH",8,1,11,0)="Recognize 'out-of-order' server protocols"
^DIC(9.4,33,22,1.4,"PAH",8,1,12,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,13,0)="Category:"
^DIC(9.4,33,22,1.4,"PAH",8,1,14,0)="======="
^DIC(9.4,33,22,1.4,"PAH",8,1,15,0)="*     Routine"
^DIC(9.4,33,22,1.4,"PAH",8,1,16,0)="     Enhancement (Mandatory)"
^DIC(9.4,33,22,1.4,"PAH",8,1,17,0)="*     Data Dictionary"
^DIC(9.4,33,22,1.4,"PAH",8,1,18,0)="     Sort Template"
^DIC(9.4,33,22,1.4,"PAH",8,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,20,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,21,0)="Description:"
^DIC(9.4,33,22,1.4,"PAH",8,1,22,0)="========="
^DIC(9.4,33,22,1.4,"PAH",8,1,23,0)="This patch enables recognition of HL7 Server Protocols that have been"
^DIC(9.4,33,22,1.4,"PAH",8,1,24,0)="placed out of order as well as those Server Protocols that have no"
^DIC(9.4,33,22,1.4,"PAH",8,1,25,0)="clients. This information is returned to the HL7 calling application as an"
^DIC(9.4,33,22,1.4,"PAH",8,1,26,0)="error message while calling the entry point, INIT^HLFNC2. Two new error"
^DIC(9.4,33,22,1.4,"PAH",8,1,27,0)="messages have been added to file 771.7, HL7 ERROR MESSAGE. They are:"
^DIC(9.4,33,22,1.4,"PAH",8,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,29,0)="CODE: 15                                SHORT TEXT: No client"
^DIC(9.4,33,22,1.4,"PAH",8,1,30,0)="DESCRIPTION:   No clients are defined for this server protocol. Unless the"
^DIC(9.4,33,22,1.4,"PAH",8,1,31,0)="application intends to submit a specific client using the HLL(""LINKS"")"
^DIC(9.4,33,22,1.4,"PAH",8,1,32,0)="array, this message should not be sent.  "
^DIC(9.4,33,22,1.4,"PAH",8,1,33,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,34,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,35,0)="CODE: 16                                SHORT TEXT: Server Protocol"
^DIC(9.4,33,22,1.4,"PAH",8,1,36,0)="Disabled"
^DIC(9.4,33,22,1.4,"PAH",8,1,37,0)="DESCRIPTION:   The server protocol has been placed OUT OF SERVICE. The"
^DIC(9.4,33,22,1.4,"PAH",8,1,38,0)="message has been rejected by the HL7 Message Service. The sending"
^DIC(9.4,33,22,1.4,"PAH",8,1,39,0)="application must retain the message for later transmission.  "
^DIC(9.4,33,22,1.4,"PAH",8,1,40,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,41,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,42,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,43,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,44,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,45,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,46,0)="Test Sites :"
^DIC(9.4,33,22,1.4,"PAH",8,1,47,0)="=============="
^DIC(9.4,33,22,1.4,"PAH",8,1,48,0)="Requested by CIRN Developers"
^DIC(9.4,33,22,1.4,"PAH",8,1,49,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,50,0)="Routine Summary :"
^DIC(9.4,33,22,1.4,"PAH",8,1,51,0)="=============="
^DIC(9.4,33,22,1.4,"PAH",8,1,52,0)="         <tab ;;1.6;HEALTH LEVEL SEVEN;**2,26**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",8,1,53,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,54,0)="Routine Name                      Patch List"
^DIC(9.4,33,22,1.4,"PAH",8,1,55,0)="-----------------               --------------"
^DIC(9.4,33,22,1.4,"PAH",8,1,56,0)="HLFNC2                                 2,26"
^DIC(9.4,33,22,1.4,"PAH",8,1,57,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,58,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",8,1,59,0)="========="
^DIC(9.4,33,22,1.4,"PAH",8,1,60,0)="  Rtn Nm           Chksum Before      Chksum After        "
^DIC(9.4,33,22,1.4,"PAH",8,1,61,0)=" HLFNC2                5211111         5393929"
^DIC(9.4,33,22,1.4,"PAH",8,1,62,0)="                            "
^DIC(9.4,33,22,1.4,"PAH",8,1,63,0)="FROM CHECK^XTSUMBLD    "
^DIC(9.4,33,22,1.4,"PAH",8,1,64,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,65,0)="     To test if the transport has been corrupted, you can use the "
^DIC(9.4,33,22,1.4,"PAH",8,1,66,0)="     ""Verify Package Integrity"" option.  This option is under Utilities "
^DIC(9.4,33,22,1.4,"PAH",8,1,67,0)="     under the KIDS menu.  It will compare the checksums in the build "
^DIC(9.4,33,22,1.4,"PAH",8,1,68,0)="     with the current checksums and list any that differ."
^DIC(9.4,33,22,1.4,"PAH",8,1,69,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,70,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,71,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",8,1,72,0)="==================="
^DIC(9.4,33,22,1.4,"PAH",8,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,74,0)="NOTE any instructions that are different for 486 or Alpha sites."
^DIC(9.4,33,22,1.4,"PAH",8,1,75,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,76,0)="     1.   Users ARE allowed to be on the system during the "
^DIC(9.4,33,22,1.4,"PAH",8,1,77,0)="          installation. "
^DIC(9.4,33,22,1.4,"PAH",8,1,78,0)="     2.   You DO NOT need to place TaskMan in a WAIT/STOP state.  "
^DIC(9.4,33,22,1.4,"PAH",8,1,79,0)="     3.   Review your mapped set. If any of the routines listed in the"
^DIC(9.4,33,22,1.4,"PAH",8,1,80,0)="          Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",8,1,81,0)="          the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",8,1,82,0)="     4.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,33,22,1.4,"PAH",8,1,83,0)="          This option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",8,1,84,0)="     5.   The patch has now been loaded into a Transport global on your "
^DIC(9.4,33,22,1.4,"PAH",8,1,85,0)="          system. You now need to use KIDS to install the Transport"
^DIC(9.4,33,22,1.4,"PAH",8,1,86,0)="          global."
^DIC(9.4,33,22,1.4,"PAH",8,1,87,0)="     6.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,33,22,1.4,"PAH",8,1,88,0)="          following options:"
^DIC(9.4,33,22,1.4,"PAH",8,1,89,0)=" "
^DIC(9.4,33,22,1.4,"PAH",8,1,90,0)="           Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",8,1,91,0)="           Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",8,1,92,0)="           Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",8,1,93,0)="           Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",8,1,94,0)="           Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",8,1,95,0)="           INSTALL NAME: HL*1.6*26"
^DIC(9.4,33,22,1.4,"PAH",8,1,96,0)="     7.   MSM Sites - Answer YES to the question 'Want to MOVE "
^DIC(9.4,33,22,1.4,"PAH",8,1,97,0)="     routines to other CPUs?'. Enter the names of your Compute and "
^DIC(9.4,33,22,1.4,"PAH",8,1,98,0)="     Print server(s)."
^DIC(9.4,33,22,1.4,"PAH",8,1,99,0)="     AXP Sites - Answer NO to this question."
^DIC(9.4,33,22,1.4,"PAH",8,1,100,0)="     8.   Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",9,0)="28 SEQ #21^2970610^1"
^DIC(9.4,33,22,1.4,"PAH",9,1,0)="^^1^1^2970610"
^DIC(9.4,33,22,1.4,"PAH",9,1,1,0)="More control over Inbound/Outbound Filer processes"
^DIC(9.4,33,22,1.4,"PAH",10,0)="29 SEQ #22^2970610^1"
^DIC(9.4,33,22,1.4,"PAH",10,1,0)="^^56^56^2970610"
^DIC(9.4,33,22,1.4,"PAH",10,1,1,0)="This patch fixes the problems as described in NOIS #BRX-0896-12049."
^DIC(9.4,33,22,1.4,"PAH",10,1,2,0)="The problems come from the ""date.time"" subscript of the ^TMP(""HL"","
^DIC(9.4,33,22,1.4,"PAH",10,1,3,0)="^TMP(""HLR"", and ^TMP(""HLS"", which is not correctly set to comply with"
^DIC(9.4,33,22,1.4,"PAH",10,1,4,0)="the FileMan format."
^DIC(9.4,33,22,1.4,"PAH",10,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,6,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,7,0)="Test Sites:"
^DIC(9.4,33,22,1.4,"PAH",10,1,8,0)="==========="
^DIC(9.4,33,22,1.4,"PAH",10,1,9,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,11,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",10,1,12,0)="================"
^DIC(9.4,33,22,1.4,"PAH",10,1,13,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",10,1,14,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",10,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,16,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",10,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,18,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,19,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",10,1,20,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",10,1,21,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,22,0)="  Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",10,1,23,0)="  ------------     ---------------     --------------       ----------"
^DIC(9.4,33,22,1.4,"PAH",10,1,24,0)="      HLLP            13472823           13466846            1,12,29"
^DIC(9.4,33,22,1.4,"PAH",10,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,26,0)=" From CHECK^XTSUMBLD  "
^DIC(9.4,33,22,1.4,"PAH",10,1,27,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,29,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",10,1,30,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",10,1,31,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",10,1,32,0)="  2.  Stop all the HLLP logical links for v 1.5 interface.  "
^DIC(9.4,33,22,1.4,"PAH",10,1,33,0)="  3.  AXP SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",10,1,34,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",10,1,35,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",10,1,36,0)="  4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",10,1,37,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",10,1,38,0)="  5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",10,1,39,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",10,1,40,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",10,1,41,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",10,1,42,0)=" "
^DIC(9.4,33,22,1.4,"PAH",10,1,43,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",10,1,44,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",10,1,45,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",10,1,46,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",10,1,47,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",10,1,48,0)="         INSTALL NAME: HL*1.6*29"
^DIC(9.4,33,22,1.4,"PAH",10,1,49,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",10,1,50,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",10,1,51,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",10,1,52,0)="  6.  MSM Sites - Answer 'YES' to the question 'Want to MOVE routines to"
^DIC(9.4,33,22,1.4,"PAH",10,1,53,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,33,22,1.4,"PAH",10,1,54,0)="  7.  AXP Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",10,1,55,0)="  8.  Restart all the HLLP logical links which have been stopped at step"
^DIC(9.4,33,22,1.4,"PAH",10,1,56,0)="      2."
^DIC(9.4,33,22,1.4,"PAH",11,0)="23^2970708^1"
^DIC(9.4,33,22,1.4,"PAH",11,1,0)="^^29^29^2970708"
^DIC(9.4,33,22,1.4,"PAH",11,1,1,0)="This patch adds a new entry into the Country Code file (#779.004) to"
^DIC(9.4,33,22,1.4,"PAH",11,1,2,0)="solve the problem as describled in NOIS ISF-0297-60099. This new entry"
^DIC(9.4,33,22,1.4,"PAH",11,1,3,0)="contains a 2-character Country Code, ""US"" (United States of America), in"
^DIC(9.4,33,22,1.4,"PAH",11,1,4,0)="order to conform to the ISO 3166 standard."
^DIC(9.4,33,22,1.4,"PAH",11,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",11,1,6,0)=" "
^DIC(9.4,33,22,1.4,"PAH",11,1,7,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",11,1,8,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",11,1,9,0)=" "
^DIC(9.4,33,22,1.4,"PAH",11,1,10,0)="  1.   Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",11,1,11,0)="  2.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",11,1,12,0)="       option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",11,1,13,0)="  3.   The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",11,1,14,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",11,1,15,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",11,1,16,0)="       options:"
^DIC(9.4,33,22,1.4,"PAH",11,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",11,1,18,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",11,1,19,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",11,1,20,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",11,1,21,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",11,1,22,0)="         Install Package(s)"
^DIC(9.4,33,22,1.4,"PAH",11,1,23,0)="         INSTALL NAME: HL*1.6*23"
^DIC(9.4,33,22,1.4,"PAH",11,1,24,0)="                       =========="
^DIC(9.4,33,22,1.4,"PAH",11,1,25,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",11,1,26,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",11,1,27,0)=" "
^DIC(9.4,33,22,1.4,"PAH",11,1,28,0)="  4.   MSM Sites - Answer 'NO' to the question 'Want to MOVE routines to"
^DIC(9.4,33,22,1.4,"PAH",11,1,29,0)="       other CPUs?'."
^DIC(9.4,33,22,1.4,"PAH",12,0)="24^2970717^1"
^DIC(9.4,33,22,1.4,"PAH",12,1,0)="^^44^44^2970717"
^DIC(9.4,33,22,1.4,"PAH",12,1,1,0)="This patch will do the following to correct the problems found in DD and"
^DIC(9.4,33,22,1.4,"PAH",12,1,2,0)="data in files #772 and #771.7:"
^DIC(9.4,33,22,1.4,"PAH",12,1,3,0)="  1.  Rewrite the KILL logic for the 'AXMITOUT1' cross-reference of"
^DIC(9.4,33,22,1.4,"PAH",12,1,4,0)="      'Logical Link' field (#772,11) in the HL7 Message Text file (#772)."
^DIC(9.4,33,22,1.4,"PAH",12,1,5,0)="  2.  Rewrite the KILL logic for the 'AXMITOUT2' cross-reference of"
^DIC(9.4,33,22,1.4,"PAH",12,1,6,0)="      'Status' field (#772,20) in the HL7 Message Text file (#772)."
^DIC(9.4,33,22,1.4,"PAH",12,1,7,0)="  3.  Modify DD of 'Error Type' field (#772,23) in the HL7 Message Text"
^DIC(9.4,33,22,1.4,"PAH",12,1,8,0)="      file (#772)."
^DIC(9.4,33,22,1.4,"PAH",12,1,9,0)="  4.  Modify data of the entry, CODE=1, in the HL7 Error Message file"
^DIC(9.4,33,22,1.4,"PAH",12,1,10,0)="      (#771.7)."
^DIC(9.4,33,22,1.4,"PAH",12,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",12,1,12,0)="Test Sites :"
^DIC(9.4,33,22,1.4,"PAH",12,1,13,0)="=============="
^DIC(9.4,33,22,1.4,"PAH",12,1,14,0)=" "
^DIC(9.4,33,22,1.4,"PAH",12,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",12,1,16,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",12,1,17,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",12,1,18,0)="  1.   Patch HL*1.6*26 must be installed before this patch."
^DIC(9.4,33,22,1.4,"PAH",12,1,19,0)="  2.   Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",12,1,20,0)="  3.   Shut down all the outgoing filers."
^DIC(9.4,33,22,1.4,"PAH",12,1,21,0)="  4.   Shut down all the incoming filers."
^DIC(9.4,33,22,1.4,"PAH",12,1,22,0)="  5.   No routine mapping for this patch."
^DIC(9.4,33,22,1.4,"PAH",12,1,23,0)="  6.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,33,22,1.4,"PAH",12,1,24,0)="       This option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",12,1,25,0)="  7.   The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",12,1,26,0)="       system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",12,1,27,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",12,1,28,0)="       options:"
^DIC(9.4,33,22,1.4,"PAH",12,1,29,0)=" "
^DIC(9.4,33,22,1.4,"PAH",12,1,30,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",12,1,31,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",12,1,32,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",12,1,33,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",12,1,34,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",12,1,35,0)="         INSTALL NAME: HL*1.6*24"
^DIC(9.4,33,22,1.4,"PAH",12,1,36,0)="                       =========="
^DIC(9.4,33,22,1.4,"PAH",12,1,37,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",12,1,38,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",12,1,39,0)="  8.   MSM Sites - Answer 'NO' to the question 'Want to MOVE routines"
^DIC(9.4,33,22,1.4,"PAH",12,1,40,0)="          to other CPUs?'."
^DIC(9.4,33,22,1.4,"PAH",12,1,41,0)="  9.   Restart all the outgoing and incoming filers which have been shut"
^DIC(9.4,33,22,1.4,"PAH",12,1,42,0)="       down at step 2 and 3."
^DIC(9.4,33,22,1.4,"PAH",12,1,43,0)=" 10.   You may delete the post-install routine 'HLPAT24' after you have"
^DIC(9.4,33,22,1.4,"PAH",12,1,44,0)="       successfully installed this patch."
^DIC(9.4,33,22,1.4,"PAH",13,0)="33 SEQ #26^2970828^1"
^DIC(9.4,33,22,1.4,"PAH",13,1,0)="^^128^128^2970828"
^DIC(9.4,33,22,1.4,"PAH",13,1,1,0)="This patch provides two new features, ""Don't Purge"" and ""Reprocessing"""
^DIC(9.4,33,22,1.4,"PAH",13,1,2,0)="messages, which were requested by the CIRN project.  The new extrinsic"
^DIC(9.4,33,22,1.4,"PAH",13,1,3,0)="function calls allow the VISTA/DHCP applications to interface with HL7"
^DIC(9.4,33,22,1.4,"PAH",13,1,4,0)="in the following ways:"
^DIC(9.4,33,22,1.4,"PAH",13,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,6,0)="  1.  Set the new flag field ""DON'T PURGE"" (#772,15) to prevent a message"
^DIC(9.4,33,22,1.4,"PAH",13,1,7,0)="      being purged by the ""HL PURGE TRANSMISSIONS"" option.  Either of the"
^DIC(9.4,33,22,1.4,"PAH",13,1,8,0)="      following two extrinsic functions may be used for this purpose:"
^DIC(9.4,33,22,1.4,"PAH",13,1,9,0)="               $$DONTPURG^HLCIRN or $$SETPURG^HLCIRN(1)"
^DIC(9.4,33,22,1.4,"PAH",13,1,10,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,11,0)="  2.  Clear the flag field ""DON'T PURGE"" (#772,15) to allow the message"
^DIC(9.4,33,22,1.4,"PAH",13,1,12,0)="      to be purged by the ""HL PURGE TRANSMISSIONS"" option. Either of the"
^DIC(9.4,33,22,1.4,"PAH",13,1,13,0)="      following two extrinsic functions may be used for this purpose:"
^DIC(9.4,33,22,1.4,"PAH",13,1,14,0)="               $$TOPURG^HLCIRN or $$SETPURG^HLCIRN(0)"
^DIC(9.4,33,22,1.4,"PAH",13,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,16,0)="  3.  Reprocessing the message by calling the extrinsic function:"
^DIC(9.4,33,22,1.4,"PAH",13,1,17,0)="                  $$REPROC^HLCIRN(IEN,RTN)"
^DIC(9.4,33,22,1.4,"PAH",13,1,18,0)="        where:  IEN is the child message IEN (or the parent message IEN)."
^DIC(9.4,33,22,1.4,"PAH",13,1,19,0)="                RTN is the routine to be Xecuted for reprocessing the"
^DIC(9.4,33,22,1.4,"PAH",13,1,20,0)="                message."
^DIC(9.4,33,22,1.4,"PAH",13,1,21,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,23,0)="These extrinsic functions and their associated parameters, return values,"
^DIC(9.4,33,22,1.4,"PAH",13,1,24,0)="and results are described as follows:"
^DIC(9.4,33,22,1.4,"PAH",13,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,26,0)="  $$DONTPURG^HLCIRN():"
^DIC(9.4,33,22,1.4,"PAH",13,1,27,0)="     purpose:       to set the ""DON'T PURGE"" field (#772,15)."
^DIC(9.4,33,22,1.4,"PAH",13,1,28,0)="     input:         none"
^DIC(9.4,33,22,1.4,"PAH",13,1,29,0)="     return value:  1   means field has been successfully set"
^DIC(9.4,33,22,1.4,"PAH",13,1,30,0)="                    -1  means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",13,1,31,0)="  "
^DIC(9.4,33,22,1.4,"PAH",13,1,32,0)="  $$TOPURG^HLCIRN():"
^DIC(9.4,33,22,1.4,"PAH",13,1,33,0)="     purpose:       to clear the ""DON'T PURGE"" field (#772,15)."
^DIC(9.4,33,22,1.4,"PAH",13,1,34,0)="     input:         none"
^DIC(9.4,33,22,1.4,"PAH",13,1,35,0)="     return value:  0   means field has been successfully cleared"
^DIC(9.4,33,22,1.4,"PAH",13,1,36,0)="                    -1  means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",13,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,38,0)="  $$SETPURG^HLCIRN(STATUS):"
^DIC(9.4,33,22,1.4,"PAH",13,1,39,0)="     purpose:       either to set (STATUS=1) or to clear (STATUS=0) the"
^DIC(9.4,33,22,1.4,"PAH",13,1,40,0)="                    ""DON'T PURGE"" field (#772,15)."
^DIC(9.4,33,22,1.4,"PAH",13,1,41,0)="     input:         STATUS=1  used to set the ""DON'T PURGE"" field."
^DIC(9.4,33,22,1.4,"PAH",13,1,42,0)="                    STATUS=0  used to clear the ""DON'T PURGE"" field."
^DIC(9.4,33,22,1.4,"PAH",13,1,43,0)="     return value:  1   means field has been successfully set"
^DIC(9.4,33,22,1.4,"PAH",13,1,44,0)="                    0   means field has been successfully cleared"
^DIC(9.4,33,22,1.4,"PAH",13,1,45,0)="                    -1  means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",13,1,46,0)="  "
^DIC(9.4,33,22,1.4,"PAH",13,1,47,0)="  $$REPROC^HLCIRN(IEN,RTN):"
^DIC(9.4,33,22,1.4,"PAH",13,1,48,0)="     purpose:       to reprocess message."
^DIC(9.4,33,22,1.4,"PAH",13,1,49,0)="     input:         IEN= the child message IEN (or the parent message"
^DIC(9.4,33,22,1.4,"PAH",13,1,50,0)="                         IEN) of file #772."
^DIC(9.4,33,22,1.4,"PAH",13,1,51,0)="                    RTN= routine, to be Xecuted for reprocessing the"
^DIC(9.4,33,22,1.4,"PAH",13,1,52,0)="                         message."
^DIC(9.4,33,22,1.4,"PAH",13,1,53,0)="     return value:  0  means call has been successfully completed"
^DIC(9.4,33,22,1.4,"PAH",13,1,54,0)="                    -1 means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",13,1,55,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,56,0)="The extrinsic functions, $$DONTPURG^HLCIRN(), $$TOPURG^HLCIRN(), and"
^DIC(9.4,33,22,1.4,"PAH",13,1,57,0)="$$SETPURG^HLCIRN(STATUS) should be called by one of the following"
^DIC(9.4,33,22,1.4,"PAH",13,1,58,0)="routines:"
^DIC(9.4,33,22,1.4,"PAH",13,1,59,0)="    - RTN routine, which is provided to $$REPROC^HLCIRN(IEN,RTN)."
^DIC(9.4,33,22,1.4,"PAH",13,1,60,0)="    - routine stored in field ""GENERATE/PROCESS ROUTINE""(#101,771)."
^DIC(9.4,33,22,1.4,"PAH",13,1,61,0)="    - routine stored in field ""GENERATE/PROCESS ACK ROUTINE""(#101,772). "
^DIC(9.4,33,22,1.4,"PAH",13,1,62,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,63,0)="When called by these routines, HL7 assumes that the variables,"
^DIC(9.4,33,22,1.4,"PAH",13,1,64,0)="HLMTIENS(child message IEN of file #772) and HLMTIEN(parent message IEN of"
^DIC(9.4,33,22,1.4,"PAH",13,1,65,0)="file #772), are already properly defined.  Otherwise, if they are called"
^DIC(9.4,33,22,1.4,"PAH",13,1,66,0)="elsewhere, at least the HLMTIEN should be defined in order to make them to"
^DIC(9.4,33,22,1.4,"PAH",13,1,67,0)="work.  If only HLMTIEN is defined, then the call will only update the"
^DIC(9.4,33,22,1.4,"PAH",13,1,68,0)="entry of parent message. Of course, having only a defined HLMTIENS is"
^DIC(9.4,33,22,1.4,"PAH",13,1,69,0)="enough for HL7 to find the corresponding value for HLMTIEN, and"
^DIC(9.4,33,22,1.4,"PAH",13,1,70,0)="consequently HL7 will update entries for both child and parent massages."
^DIC(9.4,33,22,1.4,"PAH",13,1,71,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,72,0)="The IEN, which is provided to $$REPROC^HLCIRN(IEN,RTN) should be the child"
^DIC(9.4,33,22,1.4,"PAH",13,1,73,0)="message IEN of file #772.  This will make HL7 update the ""STATUS"" for both"
^DIC(9.4,33,22,1.4,"PAH",13,1,74,0)="child and parent message entries.  If the IEN is the parent message IEN,"
^DIC(9.4,33,22,1.4,"PAH",13,1,75,0)="then only the ""STATUS"" of the parent message entry will be updated."
^DIC(9.4,33,22,1.4,"PAH",13,1,76,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,77,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,78,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",13,1,79,0)="================"
^DIC(9.4,33,22,1.4,"PAH",13,1,80,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",13,1,81,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",13,1,82,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,83,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",13,1,84,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,85,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,86,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",13,1,87,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",13,1,88,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,89,0)="    Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",13,1,90,0)="    ------------     ---------------     --------------      ------------"
^DIC(9.4,33,22,1.4,"PAH",13,1,91,0)="      HLCIRN               N/A              4336697               33"
^DIC(9.4,33,22,1.4,"PAH",13,1,92,0)="      HLTPCK1            4288888            4143076               8,33"
^DIC(9.4,33,22,1.4,"PAH",13,1,93,0)="      HLUOPT1            9958836            9990663           10,13,21,33"
^DIC(9.4,33,22,1.4,"PAH",13,1,94,0)=" "
^DIC(9.4,33,22,1.4,"PAH",13,1,95,0)="   From CHECK^XTSUMBLD  "
^DIC(9.4,33,22,1.4,"PAH",13,1,96,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,97,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,98,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",13,1,99,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",13,1,100,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",13,1,101,0)="  2.  Check and make sure that the 'HL PURGE TRANSMISSIONS' option is not"
^DIC(9.4,33,22,1.4,"PAH",13,1,102,0)="      scheduled during the time of installation."
^DIC(9.4,33,22,1.4,"PAH",13,1,103,0)="  3.  Stop all the incoming filers.  "
^DIC(9.4,33,22,1.4,"PAH",13,1,104,0)="  4.  AXP SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",13,1,105,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",13,1,106,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",13,1,107,0)="  5.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",13,1,108,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",13,1,109,0)="  6.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",13,1,110,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",13,1,111,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",13,1,112,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",13,1,113,0)="   "
^DIC(9.4,33,22,1.4,"PAH",13,1,114,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",13,1,115,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",13,1,116,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",13,1,117,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",13,1,118,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",13,1,119,0)="         INSTALL NAME: HL*1.6*33"
^DIC(9.4,33,22,1.4,"PAH",13,1,120,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",13,1,121,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",13,1,122,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",13,1,123,0)="  7.  MSM Sites - Answer 'YES' to the question 'Want to MOVE routines to"
^DIC(9.4,33,22,1.4,"PAH",13,1,124,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,33,22,1.4,"PAH",13,1,125,0)="  8.  AXP Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",13,1,126,0)="  9.  Restart all the incoming filers, which have been stopped in step #3."
^DIC(9.4,33,22,1.4,"PAH",13,1,127,0)=" 10.  Re-schedule 'HL PURGE TRANSMISSIONS' option if this option was"
^DIC(9.4,33,22,1.4,"PAH",13,1,128,0)="      scheduled and has been stopped in step #2. "
^DIC(9.4,33,22,1.4,"PAH",14,0)="35 SEQ #27^2980511^1"
^DIC(9.4,33,22,1.4,"PAH",14,1,0)="^^3^3^2980511"
^DIC(9.4,33,22,1.4,"PAH",14,1,1,0)="This patch contains changes to the Mailman LLP to further improve"
^DIC(9.4,33,22,1.4,"PAH",14,1,2,0)="performance and IO issues and ensure the process dies off after a shutdown"
^DIC(9.4,33,22,1.4,"PAH",14,1,3,0)="request."
^DIC(9.4,33,22,1.4,"PAH",15,0)="36 SEQ #28^2980616^1"
^DIC(9.4,33,22,1.4,"PAH",15,1,0)="^^116^116^2980616"
^DIC(9.4,33,22,1.4,"PAH",15,1,1,0)="This patch provides two new features, ""Don't Purge"" and ""Reprocessing"""
^DIC(9.4,33,22,1.4,"PAH",15,1,2,0)="messages, which were originally requested by the CIRN project.  The new"
^DIC(9.4,33,22,1.4,"PAH",15,1,3,0)="extrinsic function calls allow the VISTA/DHCP applications to interface"
^DIC(9.4,33,22,1.4,"PAH",15,1,4,0)="with HL7 in the following ways:"
^DIC(9.4,33,22,1.4,"PAH",15,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,6,0)="  1.  Set the new flag field ""DON'T PURGE"" (#772,15) to prevent a message"
^DIC(9.4,33,22,1.4,"PAH",15,1,7,0)="      being purged by the ""HL PURGE TRANSMISSIONS"" option.  The following"
^DIC(9.4,33,22,1.4,"PAH",15,1,8,0)="      extrinsic function may be used for this purpose:"
^DIC(9.4,33,22,1.4,"PAH",15,1,9,0)="               $$DONTPURG^HLUTIL()"
^DIC(9.4,33,22,1.4,"PAH",15,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,11,0)=" 2.  Clear the flag field ""DON'T PURGE"" (#772,15) to allow the message"
^DIC(9.4,33,22,1.4,"PAH",15,1,12,0)="      to be purged by the ""HL PURGE TRANSMISSIONS"" option. The following"
^DIC(9.4,33,22,1.4,"PAH",15,1,13,0)="      extrinsic function may be used for this purpose:"
^DIC(9.4,33,22,1.4,"PAH",15,1,14,0)="               $$TOPURG^HLUTIL()"
^DIC(9.4,33,22,1.4,"PAH",15,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,16,0)="  3.  Reprocessing the message by calling the extrinsic function:"
^DIC(9.4,33,22,1.4,"PAH",15,1,17,0)="                  $$REPROC^HLUTIL(IEN,RTN)"
^DIC(9.4,33,22,1.4,"PAH",15,1,18,0)="        where:  IEN is the child message IEN (or the parent message IEN)."
^DIC(9.4,33,22,1.4,"PAH",15,1,19,0)="                RTN is the routine to be Xecuted for reprocessing the"
^DIC(9.4,33,22,1.4,"PAH",15,1,20,0)="                message."
^DIC(9.4,33,22,1.4,"PAH",15,1,21,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,23,0)=" These extrinsic functions and their associated parameters, return values,"
^DIC(9.4,33,22,1.4,"PAH",15,1,24,0)=" and results are described as follows:"
^DIC(9.4,33,22,1.4,"PAH",15,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,26,0)="  $$DONTPURG^HLUTIL():"
^DIC(9.4,33,22,1.4,"PAH",15,1,27,0)="     purpose:       to set the ""DON'T PURGE"" field (#772,15)."
^DIC(9.4,33,22,1.4,"PAH",15,1,28,0)="     input:         none"
^DIC(9.4,33,22,1.4,"PAH",15,1,29,0)="     return value:  1   means field has been successfully set"
^DIC(9.4,33,22,1.4,"PAH",15,1,30,0)="                    -1  means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",15,1,31,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,32,0)="  $$TOPURG^HLUTIL():"
^DIC(9.4,33,22,1.4,"PAH",15,1,33,0)="     purpose:       to clear the ""DON'T PURGE"" field (#772,15)."
^DIC(9.4,33,22,1.4,"PAH",15,1,34,0)="     input:         none"
^DIC(9.4,33,22,1.4,"PAH",15,1,35,0)="     return value:  0   means field has been successfully cleared"
^DIC(9.4,33,22,1.4,"PAH",15,1,36,0)="                    -1  means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",15,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,38,0)="  $$REPROC^HLUTIL(IEN,RTN):"
^DIC(9.4,33,22,1.4,"PAH",15,1,39,0)="     purpose:       to reprocess message."
^DIC(9.4,33,22,1.4,"PAH",15,1,40,0)="     input:         IEN= the child message IEN (or the parent message"
^DIC(9.4,33,22,1.4,"PAH",15,1,41,0)="                         IEN) of file #772."
^DIC(9.4,33,22,1.4,"PAH",15,1,42,0)="                    RTN= routine, to be Xecuted for reprocessing the"
^DIC(9.4,33,22,1.4,"PAH",15,1,43,0)="                         message."
^DIC(9.4,33,22,1.4,"PAH",15,1,44,0)="     return value:  0  means call has been successfully completed"
^DIC(9.4,33,22,1.4,"PAH",15,1,45,0)="                    -1 means call has failed; nothing has been changed"
^DIC(9.4,33,22,1.4,"PAH",15,1,46,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,47,0)="The extrinsic functions, $$DONTPURG^HLUTIL(), $$TOPURG^HLUTIL(), should be"
^DIC(9.4,33,22,1.4,"PAH",15,1,48,0)="called by one of the following routines:"
^DIC(9.4,33,22,1.4,"PAH",15,1,49,0)="    - RTN routine, which is provided to $$REPROC^HLUTIL(IEN,RTN)."
^DIC(9.4,33,22,1.4,"PAH",15,1,50,0)="    - routine stored in field ""GENERATE/PROCESS ROUTINE""(#101,771)."
^DIC(9.4,33,22,1.4,"PAH",15,1,51,0)="    - routine stored in field ""GENERATE/PROCESS ACK ROUTINE""(#101,772). "
^DIC(9.4,33,22,1.4,"PAH",15,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,53,0)="When called by these routines, HL7 assumes that the variables,"
^DIC(9.4,33,22,1.4,"PAH",15,1,54,0)="HLMTIENS(child message IEN of file #772) and HLMTIEN(parent message IEN of"
^DIC(9.4,33,22,1.4,"PAH",15,1,55,0)="file #772), are already properly defined.  Otherwise, if they are called"
^DIC(9.4,33,22,1.4,"PAH",15,1,56,0)="elsewhere, at least the HLMTIEN should be defined in order to make them to"
^DIC(9.4,33,22,1.4,"PAH",15,1,57,0)="work.  If only HLMTIEN is defined, then the call will only update the"
^DIC(9.4,33,22,1.4,"PAH",15,1,58,0)="entry of parent message. Of course, having only a defined HLMTIENS is"
^DIC(9.4,33,22,1.4,"PAH",15,1,59,0)="enough for HL7 to find the corresponding value for HLMTIEN, and"
^DIC(9.4,33,22,1.4,"PAH",15,1,60,0)="consequently HL7 will update entries for both child and parent massages."
^DIC(9.4,33,22,1.4,"PAH",15,1,61,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,62,0)="The IEN, which is provided to $$REPROC^HLUTIL(IEN,RTN) should be the child"
^DIC(9.4,33,22,1.4,"PAH",15,1,63,0)="message IEN of file #772.  This will make HL7 update the ""STATUS"" for both"
^DIC(9.4,33,22,1.4,"PAH",15,1,64,0)="child and parent message entries.  If the IEN is the parent message IEN,"
^DIC(9.4,33,22,1.4,"PAH",15,1,65,0)="then only the ""STATUS"" of the parent message entry will be updated."
^DIC(9.4,33,22,1.4,"PAH",15,1,66,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,67,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,68,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",15,1,69,0)="================"
^DIC(9.4,33,22,1.4,"PAH",15,1,70,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",15,1,71,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",15,1,72,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,73,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",15,1,74,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,75,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,76,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",15,1,77,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",15,1,78,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,79,0)="    Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",15,1,80,0)="    ------------     ---------------     --------------       -----------"
^DIC(9.4,33,22,1.4,"PAH",15,1,81,0)="      HLUTIL               N/A               4603738              36"
^DIC(9.4,33,22,1.4,"PAH",15,1,82,0)="      HLTPCK1            4288888             4288888             8,36"
^DIC(9.4,33,22,1.4,"PAH",15,1,83,0)="      HLUOPT1            9958836             9990663          10,13,21,36"
^DIC(9.4,33,22,1.4,"PAH",15,1,84,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,85,0)=" From CHECK^XTSUMBLD"
^DIC(9.4,33,22,1.4,"PAH",15,1,86,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,87,0)=" "
^DIC(9.4,33,22,1.4,"PAH",15,1,88,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",15,1,89,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",15,1,90,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",15,1,91,0)="  2.  Check and make sure that the 'HL PURGE TRANSMISSIONS' option is not"
^DIC(9.4,33,22,1.4,"PAH",15,1,92,0)="      scheduled during the time of installation."
^DIC(9.4,33,22,1.4,"PAH",15,1,93,0)="  3.  Stop all the incoming filers."
^DIC(9.4,33,22,1.4,"PAH",15,1,94,0)="  4.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",15,1,95,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",15,1,96,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",15,1,97,0)="  5.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",15,1,98,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",15,1,99,0)="  6.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",15,1,100,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",15,1,101,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",15,1,102,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",15,1,103,0)="   "
^DIC(9.4,33,22,1.4,"PAH",15,1,104,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",15,1,105,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",15,1,106,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",15,1,107,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",15,1,108,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",15,1,109,0)="         INSTALL NAME: HL*1.6*36"
^DIC(9.4,33,22,1.4,"PAH",15,1,110,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",15,1,111,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",15,1,112,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",15,1,113,0)="  7.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",15,1,114,0)="  8.  Restart all the incoming filers, which have been stopped in step #3."
^DIC(9.4,33,22,1.4,"PAH",15,1,115,0)="  9.  Re-schedule 'HL PURGE TRANSMISSIONS' option if this option was"
^DIC(9.4,33,22,1.4,"PAH",15,1,116,0)="      scheduled and has been stopped in step #2. "
^DIC(9.4,33,22,1.4,"PAH",16,0)="38 SEQ #29^2980616^1"
^DIC(9.4,33,22,1.4,"PAH",16,1,0)="^^52^52^2980616"
^DIC(9.4,33,22,1.4,"PAH",16,1,1,0)="This patch solves the following problems:"
^DIC(9.4,33,22,1.4,"PAH",16,1,2,0)="  NOIS ISF-1097-61155: The M10 and M11 check digit algorithms do not"
^DIC(9.4,33,22,1.4,"PAH",16,1,3,0)="                       comply with the HL7 Standard."
^DIC(9.4,33,22,1.4,"PAH",16,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",16,1,5,0)="The two extrinsic functions, $$M10^HLFNC(X,HLECDE) and"
^DIC(9.4,33,22,1.4,"PAH",16,1,6,0)="$$M11^HLFNC(X,HLECDE) are calls for the new and HL7 Standardized"
^DIC(9.4,33,22,1.4,"PAH",16,1,7,0)="algorithms for M10 and M11, respectively."
^DIC(9.4,33,22,1.4,"PAH",16,1,8,0)="  "
^DIC(9.4,33,22,1.4,"PAH",16,1,9,0)="However, old and non-Standard algorithms calls has been moved to calls,"
^DIC(9.4,33,22,1.4,"PAH",16,1,10,0)="$$OLDM10^HLFNC(X,HLECDE) and $$OLDM11^HLFNC(X,HLECDE)."
^DIC(9.4,33,22,1.4,"PAH",16,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",16,1,12,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",16,1,13,0)="================"
^DIC(9.4,33,22,1.4,"PAH",16,1,14,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",16,1,15,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",16,1,16,0)="   "
^DIC(9.4,33,22,1.4,"PAH",16,1,17,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",16,1,18,0)="   "
^DIC(9.4,33,22,1.4,"PAH",16,1,19,0)="   "
^DIC(9.4,33,22,1.4,"PAH",16,1,20,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",16,1,21,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",16,1,22,0)="   "
^DIC(9.4,33,22,1.4,"PAH",16,1,23,0)="    Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",16,1,24,0)="    ------------     ---------------     --------------      ------------"
^DIC(9.4,33,22,1.4,"PAH",16,1,25,0)="      HLFNC              5564618             6477455             38"
^DIC(9.4,33,22,1.4,"PAH",16,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",16,1,27,0)="    From CHECK^XTSUMBLD "
^DIC(9.4,33,22,1.4,"PAH",16,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",16,1,29,0)="   "
^DIC(9.4,33,22,1.4,"PAH",16,1,30,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",16,1,31,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",16,1,32,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",16,1,33,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",16,1,34,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",16,1,35,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",16,1,36,0)="  3.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",16,1,37,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",16,1,38,0)="  4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",16,1,39,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",16,1,40,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",16,1,41,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",16,1,42,0)="   "
^DIC(9.4,33,22,1.4,"PAH",16,1,43,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",16,1,44,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",16,1,45,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",16,1,46,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",16,1,47,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",16,1,48,0)="         INSTALL NAME: HL*1.6*38"
^DIC(9.4,33,22,1.4,"PAH",16,1,49,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",16,1,50,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",16,1,51,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",16,1,52,0)="  5.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",17,0)="34 SEQ #30^2980616^1"
^DIC(9.4,33,22,1.4,"PAH",17,1,0)="^^14^14^2980616"
^DIC(9.4,33,22,1.4,"PAH",17,1,1,0)="This patch solves the following problems:"
^DIC(9.4,33,22,1.4,"PAH",17,1,2,0)="  1.  IND-0797-40843: A corrupted message with message ID missing crashed"
^DIC(9.4,33,22,1.4,"PAH",17,1,3,0)="                      the HL7 incoming filer."
^DIC(9.4,33,22,1.4,"PAH",17,1,4,0)="  2.  SLC-0897-50592: eliminates priority setting in HLLP processes."
^DIC(9.4,33,22,1.4,"PAH",17,1,5,0)="  3.  STX-0897-70964: An unexpected message block sequence, issued by the"
^DIC(9.4,33,22,1.4,"PAH",17,1,6,0)="                      VIC machine, blew out the HL7 LLP process."
^DIC(9.4,33,22,1.4,"PAH",17,1,7,0)="  4.  IND-0198-40985: system monitor/process priority."
^DIC(9.4,33,22,1.4,"PAH",17,1,8,0)="  5.  Fixes the problem with undefined application name in fields (MSH;3)"
^DIC(9.4,33,22,1.4,"PAH",17,1,9,0)="                      and/or (MSH;5)."
^DIC(9.4,33,22,1.4,"PAH",17,1,10,0)="  6.  Corrects a problem with messages that are dynamically addressed over"
^DIC(9.4,33,22,1.4,"PAH",17,1,11,0)="      mailman-type logical link (see patch 14 documentation). The system"
^DIC(9.4,33,22,1.4,"PAH",17,1,12,0)="      link monitor was not updated correctly."
^DIC(9.4,33,22,1.4,"PAH",17,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",17,1,14,0)="PLEASE SEE THE PATCH MODULE FOR DETAILS. "
^DIC(9.4,33,22,1.4,"PAH",18,0)="41 SEQ #31^2980618^1"
^DIC(9.4,33,22,1.4,"PAH",18,1,0)="^^1^1^2980618"
^DIC(9.4,33,22,1.4,"PAH",18,1,1,0)="PATCH FOR PATCH 34. Missing routine HLUTIL3."
^DIC(9.4,33,22,1.4,"PAH",19,0)="42 SEQ #32^2980831^1"
^DIC(9.4,33,22,1.4,"PAH",19,1,0)="^^76^76^2980831"
^DIC(9.4,33,22,1.4,"PAH",19,1,1,0)="This patch solves the following problems:"
^DIC(9.4,33,22,1.4,"PAH",19,1,2,0)="  NOIS PHI-0798-20072 and PHI-0698-22536: Patient ID with alphanumeric"
^DIC(9.4,33,22,1.4,"PAH",19,1,3,0)="                                          data type."
^DIC(9.4,33,22,1.4,"PAH",19,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,5,0)="The two extrinsic functions, $$M10^HLFNC(X,HLECDE) and"
^DIC(9.4,33,22,1.4,"PAH",19,1,6,0)="$$M11^HLFNC(X,HLECDE) have been improved for the input ID with"
^DIC(9.4,33,22,1.4,"PAH",19,1,7,0)="alphanumeric data type.  The additional output will be as follows:"
^DIC(9.4,33,22,1.4,"PAH",19,1,8,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,9,0)=" 1. Return X concatenated with encoding characters, if X is alphanumeric."
^DIC(9.4,33,22,1.4,"PAH",19,1,10,0)=" 2. Return the input X only, if encoding character is not defined."
^DIC(9.4,33,22,1.4,"PAH",19,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,12,0)="Nothing has been changed for the numeric data type input with encoding"
^DIC(9.4,33,22,1.4,"PAH",19,1,13,0)="character, its result will contain the X with its corresponding check"
^DIC(9.4,33,22,1.4,"PAH",19,1,14,0)="digit and algorithms."
^DIC(9.4,33,22,1.4,"PAH",19,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,16,0)="For example,"
^DIC(9.4,33,22,1.4,"PAH",19,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,18,0)="      >W $$M10^HLFNC(""12345"",""|"")"
^DIC(9.4,33,22,1.4,"PAH",19,1,19,0)="       12345|5|M10"
^DIC(9.4,33,22,1.4,"PAH",19,1,20,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,21,0)="      >W $$M10^HLFNC(""9999"",""^"")"
^DIC(9.4,33,22,1.4,"PAH",19,1,22,0)="       9999^4^M10"
^DIC(9.4,33,22,1.4,"PAH",19,1,23,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,24,0)="      >W $$M11^HLFNC(""128952"",""^"")"
^DIC(9.4,33,22,1.4,"PAH",19,1,25,0)="       128952^7^M11"
^DIC(9.4,33,22,1.4,"PAH",19,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,27,0)="      >W $$M11^HLFNC(""1234567"",""|"")"
^DIC(9.4,33,22,1.4,"PAH",19,1,28,0)="       1234567|4|M11"
^DIC(9.4,33,22,1.4,"PAH",19,1,29,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,30,0)="      >W $$M11^HLFNC(""1234-F"",""|"")"
^DIC(9.4,33,22,1.4,"PAH",19,1,31,0)="       1234-F||"
^DIC(9.4,33,22,1.4,"PAH",19,1,32,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,33,0)="      >W $$M10^HLFNC(""401-56-1234"",""^"")"
^DIC(9.4,33,22,1.4,"PAH",19,1,34,0)="       401-56-1234^^"
^DIC(9.4,33,22,1.4,"PAH",19,1,35,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,37,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",19,1,38,0)="================"
^DIC(9.4,33,22,1.4,"PAH",19,1,39,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",19,1,40,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",19,1,41,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,42,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",19,1,43,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,44,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",19,1,45,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",19,1,46,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,47,0)="    Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",19,1,48,0)="    ------------     ---------------     --------------      ------------"
^DIC(9.4,33,22,1.4,"PAH",19,1,49,0)="      HLFNC              6477455             6494537             38,42"
^DIC(9.4,33,22,1.4,"PAH",19,1,50,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,51,0)="    From CHECK^XTSUMBLD "
^DIC(9.4,33,22,1.4,"PAH",19,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,53,0)=" "
^DIC(9.4,33,22,1.4,"PAH",19,1,54,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",19,1,55,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",19,1,56,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",19,1,57,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",19,1,58,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",19,1,59,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",19,1,60,0)="  3.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",19,1,61,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",19,1,62,0)="  4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",19,1,63,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",19,1,64,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",19,1,65,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",19,1,66,0)="   "
^DIC(9.4,33,22,1.4,"PAH",19,1,67,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",19,1,68,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",19,1,69,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",19,1,70,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",19,1,71,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",19,1,72,0)="         INSTALL NAME: HL*1.6*42"
^DIC(9.4,33,22,1.4,"PAH",19,1,73,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",19,1,74,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",19,1,75,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",19,1,76,0)="  5.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",20,0)="14 SEQ #33^2981026^1"
^DIC(9.4,33,22,1.4,"PAH",20,1,0)="^^13^13^2981026"
^DIC(9.4,33,22,1.4,"PAH",20,1,1,0)=" "
^DIC(9.4,33,22,1.4,"PAH",20,1,2,0)="HL*1.6*14 introduces the following new features as part of the CIRN"
^DIC(9.4,33,22,1.4,"PAH",20,1,3,0)="project and addresses a number of NOIS related issues:"
^DIC(9.4,33,22,1.4,"PAH",20,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",20,1,5,0)="1.  Dynamic addressing of messages"
^DIC(9.4,33,22,1.4,"PAH",20,1,6,0)="2.  Subscription registry (new file and APIs)"
^DIC(9.4,33,22,1.4,"PAH",20,1,7,0)="3.  Auto-restart of logical links"
^DIC(9.4,33,22,1.4,"PAH",20,1,8,0)="4.  Mapping of logical links to institutions (and related api's)"
^DIC(9.4,33,22,1.4,"PAH",20,1,9,0)="5.  A new option to shut down all logical links"
^DIC(9.4,33,22,1.4,"PAH",20,1,10,0)="6.  HL7 reference file updates to support draft 2 of HEALTH LEVEL SEVEN, "
^DIC(9.4,33,22,1.4,"PAH",20,1,11,0)="    Version 2.3"
^DIC(9.4,33,22,1.4,"PAH",20,1,12,0)=" "
^DIC(9.4,33,22,1.4,"PAH",20,1,13,0)="Please see the patch module on Forum for details."
^DIC(9.4,33,22,1.4,"PAH",21,0)="37 SEQ #34^2981026^1"
^DIC(9.4,33,22,1.4,"PAH",21,1,0)="^^53^53^2981026"
^DIC(9.4,33,22,1.4,"PAH",21,1,1,0)="This patch solves the following problems:"
^DIC(9.4,33,22,1.4,"PAH",21,1,2,0)=" NOIS ISB-1097-32281: Batch message transmission problems for both initial"
^DIC(9.4,33,22,1.4,"PAH",21,1,3,0)=" and acknowledgement messages with missing acknowledgement code, reference"
^DIC(9.4,33,22,1.4,"PAH",21,1,4,0)=" batch control ID, etc.  This was causing UNDEFINED variable errors in"
^DIC(9.4,33,22,1.4,"PAH",21,1,5,0)=" HLTP01+47^HLTP01."
^DIC(9.4,33,22,1.4,"PAH",21,1,6,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,7,0)=" Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",21,1,8,0)=" ================"
^DIC(9.4,33,22,1.4,"PAH",21,1,9,0)=" The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",21,1,10,0)=" second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",21,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,12,0)="      <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",21,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,14,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,15,0)=" Checksums:"
^DIC(9.4,33,22,1.4,"PAH",21,1,16,0)=" =========="
^DIC(9.4,33,22,1.4,"PAH",21,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,18,0)="     Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",21,1,19,0)="     ------------     ---------------     --------------      ------------"
^DIC(9.4,33,22,1.4,"PAH",21,1,20,0)="       HLCSHDR           5439890             6047496              37"
^DIC(9.4,33,22,1.4,"PAH",21,1,21,0)="       HLTP0             3059585             3159167             25,37"
^DIC(9.4,33,22,1.4,"PAH",21,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,23,0)="     From CHECK^XTSUMBLD "
^DIC(9.4,33,22,1.4,"PAH",21,1,24,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,26,0)=" Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",21,1,27,0)=" =========================="
^DIC(9.4,33,22,1.4,"PAH",21,1,28,0)="   1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",21,1,29,0)="   2.  Stop all the outgoing and incoming filers by using the HL7 ""Stop"
^DIC(9.4,33,22,1.4,"PAH",21,1,30,0)="       all incoming filers"" and ""Stop all outgoing filers"" options."
^DIC(9.4,33,22,1.4,"PAH",21,1,31,0)="   3.  DSM SITES: Review your mapped set.  If any of the routines listed"
^DIC(9.4,33,22,1.4,"PAH",21,1,32,0)="       in the Routine Summary section are mapped, they should be removed"
^DIC(9.4,33,22,1.4,"PAH",21,1,33,0)="       from the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",21,1,34,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",21,1,35,0)="       option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",21,1,36,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",21,1,37,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",21,1,38,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",21,1,39,0)="       options:"
^DIC(9.4,33,22,1.4,"PAH",21,1,40,0)=" "
^DIC(9.4,33,22,1.4,"PAH",21,1,41,0)="          Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",21,1,42,0)="          Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",21,1,43,0)="          Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",21,1,44,0)="          Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",21,1,45,0)="          Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",21,1,46,0)="          INSTALL NAME: HL*1.6*37"
^DIC(9.4,33,22,1.4,"PAH",21,1,47,0)="                        ========="
^DIC(9.4,33,22,1.4,"PAH",21,1,48,0)="          Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",21,1,49,0)="          and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",21,1,50,0)="   6.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",21,1,51,0)="   7.  Restart the outgoing and incoming filers, by using the HL7 ""Start"
^DIC(9.4,33,22,1.4,"PAH",21,1,52,0)="       default number of incoming & outgoing filer"" option, which have"
^DIC(9.4,33,22,1.4,"PAH",21,1,53,0)="       been stopped in step #2."
^DIC(9.4,33,22,1.4,"PAH",22,0)="15 SEQ #14^2970122^1"
^DIC(9.4,33,22,1.4,"PAH",23,0)="40 SEQ #35^2981119^1"
^DIC(9.4,33,22,1.4,"PAH",23,1,0)="^^26^26^2981119"
^DIC(9.4,33,22,1.4,"PAH",23,1,1,0)="DEVELOPERS: SEE BELOW FOR DESCRIPTION OF A NEW API"
^DIC(9.4,33,22,1.4,"PAH",23,1,2,0)="Summary:"
^DIC(9.4,33,22,1.4,"PAH",23,1,3,0)=" "
^DIC(9.4,33,22,1.4,"PAH",23,1,4,0)="1. Enhancements to Systems Link Monitor:"
^DIC(9.4,33,22,1.4,"PAH",23,1,5,0)="       -more information in header to help distinguish multiple displays."
^DIC(9.4,33,22,1.4,"PAH",23,1,6,0)="       -provides both a full and abbreviated display format, as well as a"
^DIC(9.4,33,22,1.4,"PAH",23,1,7,0)="        help screen"
^DIC(9.4,33,22,1.4,"PAH",23,1,8,0)="2. Additional required Messaging site parameters added to file 869.3."
^DIC(9.4,33,22,1.4,"PAH",23,1,9,0)="3. Updated option ""Edit Communication Server Parameters"" to support new"
^DIC(9.4,33,22,1.4,"PAH",23,1,10,0)="   site parameters."
^DIC(9.4,33,22,1.4,"PAH",23,1,11,0)="4. New field in 869.3 to support a local mail group for Messaging system"
^DIC(9.4,33,22,1.4,"PAH",23,1,12,0)="   alerts and notifications."
^DIC(9.4,33,22,1.4,"PAH",23,1,13,0)="5. New public FUNCTION CALL to retrieve an application-specific mail group"
^DIC(9.4,33,22,1.4,"PAH",23,1,14,0)="   for alerts and notifications pertaining to initiating or processing a"
^DIC(9.4,33,22,1.4,"PAH",23,1,15,0)="   particular transaction. The second piece returned is the"
^DIC(9.4,33,22,1.4,"PAH",23,1,16,0)="   active/inactive flag."
^DIC(9.4,33,22,1.4,"PAH",23,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",23,1,18,0)="GETAPP^HLCS2(HLAPP)"
^DIC(9.4,33,22,1.4,"PAH",23,1,19,0)="  ;Function to Retrieve parameters pertaining to a specific"
^DIC(9.4,33,22,1.4,"PAH",23,1,20,0)="sending or receiving application"
^DIC(9.4,33,22,1.4,"PAH",23,1,21,0)="        ;HLAPP=APPLICATION NAME OR IEN OF FILE 771"
^DIC(9.4,33,22,1.4,"PAH",23,1,22,0)="        ;Returns MAIL GROUP NAME^'a' or 'i' (active or inactive) "
^DIC(9.4,33,22,1.4,"PAH",23,1,23,0)=" "
^DIC(9.4,33,22,1.4,"PAH",23,1,24,0)="EXAMPLE:KRN,KDE>S ZZPARMS=$$GETAPP^HLCS2(""JC TEST SERVER"") W ZZPARMS"
^DIC(9.4,33,22,1.4,"PAH",23,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",23,1,26,0)="RESULT: ZZPARMS=JOHN^a"
^DIC(9.4,33,22,1.4,"PAH",24,0)="19 SEQ #36^2990223^1"
^DIC(9.4,33,22,1.4,"PAH",24,1,0)="^^166^166^2990223"
^DIC(9.4,33,22,1.4,"PAH",24,1,1,0)="============================================================================="
^DIC(9.4,33,22,1.4,"PAH",24,1,2,0)="Description:"
^DIC(9.4,33,22,1.4,"PAH",24,1,3,0)="============"
^DIC(9.4,33,22,1.4,"PAH",24,1,4,0)="This patch introduces TCP/IP as a transport layer for the HL7 package. "
^DIC(9.4,33,22,1.4,"PAH",24,1,5,0)="For information on how to work with TCP/IP HL7 interfaces, see the new "
^DIC(9.4,33,22,1.4,"PAH",24,1,6,0)="""DHCP HL7 User Manual: TCP/IP Supplement"", which is in the file"
^DIC(9.4,33,22,1.4,"PAH",24,1,7,0)="HL71_6P19.PDF, available from the Customer Service anonymous directories."
^DIC(9.4,33,22,1.4,"PAH",24,1,8,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,9,0)="This patch will convert the messages in HL7 MESSAGE ADMINISTRATION, file 773,"
^DIC(9.4,33,22,1.4,"PAH",24,1,10,0)="and in HL7 MESSAGE TEXT, file 772. To speed up the conversion, run the"
^DIC(9.4,33,22,1.4,"PAH",24,1,11,0)="'Purge Message Text File Entries' option to remove old messages."
^DIC(9.4,33,22,1.4,"PAH",24,1,12,0)="  "
^DIC(9.4,33,22,1.4,"PAH",24,1,13,0)="Earlier version of Patch 19, prior to test version 25, are Uni-directional."
^DIC(9.4,33,22,1.4,"PAH",24,1,14,0)="All TCP Logical Links must be redefined to work with this version of patch"
^DIC(9.4,33,22,1.4,"PAH",24,1,15,0)="19.  Messages might also need to be modified."
^DIC(9.4,33,22,1.4,"PAH",24,1,16,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,17,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,18,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,19,0)="Routine Modifications:"
^DIC(9.4,33,22,1.4,"PAH",24,1,20,0)="======================"
^DIC(9.4,33,22,1.4,"PAH",24,1,21,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,33,22,1.4,"PAH",24,1,22,0)="these routines now look like:"
^DIC(9.4,33,22,1.4,"PAH",24,1,23,0)="  "
^DIC(9.4,33,22,1.4,"PAH",24,1,24,0)="  <tab>;;1.6;HEALTH LEVEL SEVEN;**19**;JUL 17, 1995"
^DIC(9.4,33,22,1.4,"PAH",24,1,25,0)=""
