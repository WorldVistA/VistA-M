^DIC(9.4,14,22,5.9,"PAH",132,1,1,0)="This patch is being released in support of the VBECS (Vista Blood "
^DIC(9.4,14,22,5.9,"PAH",132,1,2,0)="Establishment Computer Software) Blood Bank Modernization Project.  In "
^DIC(9.4,14,22,5.9,"PAH",132,1,3,0)="the future, data will be transitioned from the existing M database to a "
^DIC(9.4,14,22,5.9,"PAH",132,1,4,0)="Microsoft SQL database.  The API's release in this patch will allow CPRS "
^DIC(9.4,14,22,5.9,"PAH",132,1,5,0)="and the Lab packages to transition to the new database when it is "
^DIC(9.4,14,22,5.9,"PAH",132,1,6,0)="released."
^DIC(9.4,14,22,5.9,"PAH",132,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,8,0)="   Get ABORh"
^DIC(9.4,14,22,5.9,"PAH",132,1,9,0)="         ABORH^VBECA1       Retrieve the ABO & Rh for a patient DFN."
^DIC(9.4,14,22,5.9,"PAH",132,1,10,0)="                            If none is on file, return NULL"
^DIC(9.4,14,22,5.9,"PAH",132,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,12,0)="   Get ABO"
^DIC(9.4,14,22,5.9,"PAH",132,1,13,0)="         ABO^VBECA1         Retrieve the ABO for a patient DFN."
^DIC(9.4,14,22,5.9,"PAH",132,1,14,0)="                            If none is on file, return NULL"
^DIC(9.4,14,22,5.9,"PAH",132,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,16,0)="   Get Rh"
^DIC(9.4,14,22,5.9,"PAH",132,1,17,0)="         RH^VBECA1          Retrieve the Rh for a patient DFN."
^DIC(9.4,14,22,5.9,"PAH",132,1,18,0)="                            If none is on file, return NULL"
^DIC(9.4,14,22,5.9,"PAH",132,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,20,0)="   Get RBC Antigens Present"
^DIC(9.4,14,22,5.9,"PAH",132,1,21,0)="         AGPRES^VBECA1      Retrieve the antigens previously found"
^DIC(9.4,14,22,5.9,"PAH",132,1,22,0)="                            for the patient.  If none are found,"
^DIC(9.4,14,22,5.9,"PAH",132,1,23,0)="                            return empty array."
^DIC(9.4,14,22,5.9,"PAH",132,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,25,0)="   Get Antibodies Identified"
^DIC(9.4,14,22,5.9,"PAH",132,1,26,0)="         ABID^VBECA1        Retrieve the antibodies previously found"
^DIC(9.4,14,22,5.9,"PAH",132,1,27,0)="                            for the patient.  If none are found,"
^DIC(9.4,14,22,5.9,"PAH",132,1,28,0)="                            return empty array."
^DIC(9.4,14,22,5.9,"PAH",132,1,29,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,30,0)="   Get RBC Antigens Absent"
^DIC(9.4,14,22,5.9,"PAH",132,1,31,0)="         AGAB^VBECA1        Retrieve the absent antigens previously"
^DIC(9.4,14,22,5.9,"PAH",132,1,32,0)="                            recorded.  If none are on record, return"
^DIC(9.4,14,22,5.9,"PAH",132,1,33,0)="                            empty array."
^DIC(9.4,14,22,5.9,"PAH",132,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,35,0)="   Get Transfusion Reactions"
^DIC(9.4,14,22,5.9,"PAH",132,1,36,0)="         TRRX^VBECA1        Retrieve any previously recorded transfusion"
^DIC(9.4,14,22,5.9,"PAH",132,1,37,0)="                            reactions.  If none are on record, return"
^DIC(9.4,14,22,5.9,"PAH",132,1,38,0)="                            empty array."
^DIC(9.4,14,22,5.9,"PAH",132,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,40,0)="   Get Blood Bank Comments"
^DIC(9.4,14,22,5.9,"PAH",132,1,41,0)="         BBCMT^VBECA1       Retrieve blood bank comments on the patient."
^DIC(9.4,14,22,5.9,"PAH",132,1,42,0)="                            If none are on record, return empty array."
^DIC(9.4,14,22,5.9,"PAH",132,1,43,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,44,0)="   Get Available Autologous Units"
^DIC(9.4,14,22,5.9,"PAH",132,1,45,0)="         AUTO^VBECA1        Return quantity and component class of units"
^DIC(9.4,14,22,5.9,"PAH",132,1,46,0)="                            available.  If none are on record return"
^DIC(9.4,14,22,5.9,"PAH",132,1,47,0)="                            empty array."
^DIC(9.4,14,22,5.9,"PAH",132,1,48,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,49,0)="   Get CPRS Report Data"
^DIC(9.4,14,22,5.9,"PAH",132,1,50,0)="         DFN^VBECA3A        The following fields are retrieved in"
^DIC(9.4,14,22,5.9,"PAH",132,1,51,0)="                            support of the CPRS Blood Bank reports."
^DIC(9.4,14,22,5.9,"PAH",132,1,52,0)="         CPRS^VBECA3B       This API converts the arrays produced in"
^DIC(9.4,14,22,5.9,"PAH",132,1,53,0)="                            VBECA3A into a single cohesive array for"
^DIC(9.4,14,22,5.9,"PAH",132,1,54,0)="                            use by CPRS."
^DIC(9.4,14,22,5.9,"PAH",132,1,55,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,56,0)="      Component Request"
^DIC(9.4,14,22,5.9,"PAH",132,1,57,0)="         63.084,.01  (Blood Component Request)"
^DIC(9.4,14,22,5.9,"PAH",132,1,58,0)="         63.084,.04  (Number of Units)"
^DIC(9.4,14,22,5.9,"PAH",132,1,59,0)="         63.084,.03  (Request Date/Time)"
^DIC(9.4,14,22,5.9,"PAH",132,1,60,0)="         63.084,.05  (Date/Time Units Wanted)"
^DIC(9.4,14,22,5.9,"PAH",132,1,61,0)="         63.084,.09  (Requesting Person)"
^DIC(9.4,14,22,5.9,"PAH",132,1,62,0)="         63,.084,.08 (Entering Person DUZ)"
^DIC(9.4,14,22,5.9,"PAH",132,1,63,0)=" "
