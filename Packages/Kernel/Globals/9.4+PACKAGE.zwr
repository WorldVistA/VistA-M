^DIC(9.4,167,"DEV")="CHOU/HINES"
^DIC(9.4,167,"VERSION")="2.0"
^DIC(9.4,168,0)="VISUAL IMPAIRMENT SERVICE TEAM^ANRV^VIST Roster with patient data and AMIS report."
^DIC(9.4,168,1,0)="^^2^2^2980420^^^^"
^DIC(9.4,168,1,1,0)="A database file of Visual Impairment Services Team (VIST) patients"
^DIC(9.4,168,1,2,0)="at this VA facility."
^DIC(9.4,168,7)="^^III"
^DIC(9.4,168,20,0)="^9.402P^^"
^DIC(9.4,168,22,0)="^9.49I^3^3"
^DIC(9.4,168,22,1,0)="4.0^3051119^2980722^1"
^DIC(9.4,168,22,1,1,0)="^^1^1^3051119"
^DIC(9.4,168,22,1,1,1,0)="Visual Impairment Service Team (VIST) V 4.0."
^DIC(9.4,168,22,1,"PAH",0)="^9.4901^5^5"
^DIC(9.4,168,22,1,"PAH",1,0)="1^2990119^1"
^DIC(9.4,168,22,1,"PAH",1,1,0)="^^3^3^2990119"
^DIC(9.4,168,22,1,"PAH",1,1,1,0)="A null subscript error was reported when trying to run several of the"
^DIC(9.4,168,22,1,"PAH",1,1,2,0)="reports under the option VIST ROSTER SORTS.  This patch will correct this"
^DIC(9.4,168,22,1,"PAH",1,1,3,0)="problem."
^DIC(9.4,168,22,1,"PAH",2,0)="2 SEQ #2^2990622^1"
^DIC(9.4,168,22,1,"PAH",2,1,0)="^^1^1^2990622"
^DIC(9.4,168,22,1,"PAH",2,1,1,0)="Transmit AMIS report electronically."
^DIC(9.4,168,22,1,"PAH",3,0)="3 SEQ #3^3001004^1"
^DIC(9.4,168,22,1,"PAH",3,1,0)="^^3^3^3001004"
^DIC(9.4,168,22,1,"PAH",3,1,1,0)="An incomplete data set was being displayed in the VARO Report.  An error"
^DIC(9.4,168,22,1,"PAH",3,1,2,0)="was found in the routine ^ANRVRP9 that caused this problem.  This patch"
^DIC(9.4,168,22,1,"PAH",3,1,3,0)="contains a fix to this routine."
^DIC(9.4,168,22,1,"PAH",4,0)="5 SEQ #4^3030603^1"
^DIC(9.4,168,22,1,"PAH",4,1,0)="^^1^1^3030603"
^DIC(9.4,168,22,1,"PAH",4,1,1,0)="This is the Patch for Version 4.0 of Patient Reviews."
^DIC(9.4,168,22,1,"PAH",5,0)="6 SEQ #5^3040131^1"
^DIC(9.4,168,22,1,"PAH",5,1,0)="^^1^1^3040131"
^DIC(9.4,168,22,1,"PAH",5,1,1,0)="This patch fixes the problem with the NEXT button on the last page of section 3 of the GUI client."
^DIC(9.4,168,22,1,"PAH","B",1,1)=""
^DIC(9.4,168,22,1,"PAH","B","2 SEQ #2",2)=""
^DIC(9.4,168,22,1,"PAH","B","3 SEQ #3",3)=""
^DIC(9.4,168,22,1,"PAH","B","5 SEQ #4",4)=""
^DIC(9.4,168,22,1,"PAH","B","6 SEQ #5",5)=""
^DIC(9.4,168,22,2,0)="5.0^3060607^3061211^1"
^DIC(9.4,168,22,2,1,0)="^^2^2^3061211"
^DIC(9.4,168,22,2,1,1,0)="This build contains the routines, options and rpc's necessary for the "
^DIC(9.4,168,22,2,1,2,0)="Blind Rehabilitation/VIST V5.0 Java software."
^DIC(9.4,168,22,2,"PAH",0)="^9.4901^1^1"
^DIC(9.4,168,22,2,"PAH",1,0)="1 SEQ #1^3061211.180801^1"
^DIC(9.4,168,22,2,"PAH",1,1,0)="^^2^2^3061211"
^DIC(9.4,168,22,2,"PAH",1,1,1,0)="See patch ANRV*5*1 in the National Patch Module for complete information "
^DIC(9.4,168,22,2,"PAH",1,1,2,0)="on this patch."
^DIC(9.4,168,22,2,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,168,22,3,0)=5.1
^DIC(9.4,168,22,3,"PAH",0)="^9.4901^1^1"
^DIC(9.4,168,22,3,"PAH",1,0)="1 SEQ #1^3220815.133057^86"
^DIC(9.4,168,22,3,"PAH",1,1,0)="^^10^10^3220815"
^DIC(9.4,168,22,3,"PAH",1,1,1,0)="The Blind Rehabilitation System (BRS) is a VHA-wide application used to "
^DIC(9.4,168,22,3,"PAH",1,1,2,0)="track and manage the delivery of care to visually impaired patients."
^DIC(9.4,168,22,3,"PAH",1,1,3,0)=" "
^DIC(9.4,168,22,3,"PAH",1,1,4,0)="The purpose of this patch:"
^DIC(9.4,168,22,3,"PAH",1,1,5,0)="       -Re-engineer the BRS application for compliance with VA "
^DIC(9.4,168,22,3,"PAH",1,1,6,0)="        Technical Reference Model (TRM) and secure coding standards."
^DIC(9.4,168,22,3,"PAH",1,1,7,0)="       -Release the new version of BRS to production for use by VA "
^DIC(9.4,168,22,3,"PAH",1,1,8,0)="        staff with Two Factor Authentication (2FA) "
^DIC(9.4,168,22,3,"PAH",1,1,9,0)="        capability."
^DIC(9.4,168,22,3,"PAH",1,1,10,0)="       -Migrate the BRS application to the VA Enterprise Cloud (VAEC)."
^DIC(9.4,168,22,3,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,168,22,"B",5.1,3)=""
^DIC(9.4,168,22,"B","4.0",1)=""
^DIC(9.4,168,22,"B","5.0",2)=""
^DIC(9.4,168,"DEV")="MARILYN WATTS/MUSKOGEE,OK"
^DIC(9.4,168,"VERSION")=5.1
^DIC(9.4,169,0)="WOMEN'S HEALTH^WV^Tracks health issues specific to female patients."
^DIC(9.4,169,20,0)="^9.402P^^"
^DIC(9.4,169,22,0)="^9.49I^1^1"
^DIC(9.4,169,22,1,0)="1.0^3051119^2981006^1"
^DIC(9.4,169,22,1,1,0)="^^2^2^3051119"
^DIC(9.4,169,22,1,1,1,0)="This KIDS Build contains all the components needed to install the Women's"
^DIC(9.4,169,22,1,1,2,0)="Health v1.0 software package."
^DIC(9.4,169,22,1,"PAH",0)="^9.4901^26^26"
^DIC(9.4,169,22,1,"PAH",1,0)="3^2981229^1"
^DIC(9.4,169,22,1,"PAH",1,1,0)="^^2^2^2981229"
^DIC(9.4,169,22,1,"PAH",1,1,1,0)="This patch fixes several reported bugs. Please see the patch description"
^DIC(9.4,169,22,1,"PAH",1,1,2,0)="for WV*1*3 on FORUM for a full description of this patch."
^DIC(9.4,169,22,1,"PAH",2,0)="4^2990119^1"
^DIC(9.4,169,22,1,"PAH",2,1,0)="^^2^2^2990119"
^DIC(9.4,169,22,1,"PAH",2,1,1,0)="Please read the WV*1*4 patch description on FORUM for an explanation of"
^DIC(9.4,169,22,1,"PAH",2,1,2,0)="what this patch does."
^DIC(9.4,169,22,1,"PAH",3,0)="5 SEQ #5^2990322^1"
^DIC(9.4,169,22,1,"PAH",3,1,0)="^^2^2^2990322"
^DIC(9.4,169,22,1,"PAH",3,1,1,0)="Please read the WV*1*5 patch description on FORUM for an explanation of"
^DIC(9.4,169,22,1,"PAH",3,1,2,0)="what this patch does."
^DIC(9.4,169,22,1,"PAH",4,0)="6 SEQ #6^2990602^1"
^DIC(9.4,169,22,1,"PAH",4,1,0)="^^2^2^2990602"
^DIC(9.4,169,22,1,"PAH",4,1,1,0)="Please read the WV*1*6 patch description on FORUM for an explanation of"
^DIC(9.4,169,22,1,"PAH",4,1,2,0)="what this patch does."
^DIC(9.4,169,22,1,"PAH",5,0)="7 SEQ #7^2991019^1"
^DIC(9.4,169,22,1,"PAH",5,1,0)="^^2^2^2991019"
^DIC(9.4,169,22,1,"PAH",5,1,1,0)="Please read the WV*1*7 patch description on FORUM for an explanation of"
^DIC(9.4,169,22,1,"PAH",5,1,2,0)="what this patch does."
