^DIC(9.4,4,22,2,"PAH",9,1,0)="^^59^59^3021220"
^DIC(9.4,4,22,2,"PAH",9,1,1,0)="Patch XM*8.0*12"
^DIC(9.4,4,22,2,"PAH",9,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",9,1,3,0)="NOIS: HIN-1202-41276"
^DIC(9.4,4,22,2,"PAH",9,1,4,0)="Test Site: Hines"
^DIC(9.4,4,22,2,"PAH",9,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",9,1,6,0)="If you D ^XMC from the programmer prompt, select '1' to enter MailMan,"
^DIC(9.4,4,22,2,"PAH",9,1,7,0)="and upon exiting MailMan, press RETURN to exit ^XMC, the routine aborts"
^DIC(9.4,4,22,2,"PAH",9,1,8,0)="with an undefined XMABORT.  This patch fixes that."
^DIC(9.4,4,22,2,"PAH",9,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",9,1,10,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,2,"PAH",9,1,11,0)="It has no patch prerequisites, except that MailMan 8 must be installed."
^DIC(9.4,4,22,2,"PAH",9,1,12,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",9,1,13,0)=""
^DIC(9.4,4,22,2,"PAH",9,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",9,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",9,1,16,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",9,1,17,0)=""
