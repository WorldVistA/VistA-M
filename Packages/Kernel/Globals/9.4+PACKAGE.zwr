^DIC(9.4,4,22,1,"PAH",150,1,19,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",150,1,20,0)="-----------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",150,1,21,0)="XMUTERM    13549078     13770249     50,125,180"
