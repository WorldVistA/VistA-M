^DIC(9.4,154,22,"B","1.0",1)=""
^DIC(9.4,154,"DEV")="ACORD,ARLIS"
^DIC(9.4,154,"VERSION")="1.0"
^DIC(9.4,155,0)="LEXICON UTILITY^LEX^Medical and Biomedical Terminology System."
^DIC(9.4,155,1,0)="^^10^10^2980714^^^^"
^DIC(9.4,155,1,1,0)="The Lexicon contains medical and biomedical major concepts.  Each major "
^DIC(9.4,155,1,2,0)="concept can be expressed in numerous forms (major concepts, and synonyms "
^DIC(9.4,155,1,3,0)="or lexical variants to the major concepts).  These expressions are updated"
^DIC(9.4,155,1,4,0)="using VA terminology sources.  These sources include the various disciplines"
^DIC(9.4,155,1,5,0)="not well represented to date (i.e., Social Work, Nursing, etc.) and the"
^DIC(9.4,155,1,6,0)="Lexicon itself through the capturing of terms not found within the file."
^DIC(9.4,155,1,7,0)=" "
^DIC(9.4,155,1,8,0)="Updates to the Lexicon will be simultaneously sent to all sites, providing"
^DIC(9.4,155,1,9,0)="them with the ability to communicate medical concepts across disciplines "
^DIC(9.4,155,1,10,0)="and computer systems."
^DIC(9.4,155,5)="SLC IRM FLD OFFICE"
^DIC(9.4,155,7)="^^I"
^DIC(9.4,155,14,0)="^9.4014^1^1"
^DIC(9.4,155,14,1,0)="GMPT"
^DIC(9.4,155,14,"B","GMPT",1)=""
^DIC(9.4,155,20,0)="^9.402P^^"
^DIC(9.4,155,22,0)="^9.49I^1^1"
^DIC(9.4,155,22,1,0)="2.0^3051119^2961016^1"
^DIC(9.4,155,22,1,1,0)="^^5^5^3051119"
^DIC(9.4,155,22,1,1,1,0)="The Lexicon is a dictionary of medical and biomedical terminology.  This"
^DIC(9.4,155,22,1,1,2,0)="terminology is represented by major concepts which can be expressed in "
^DIC(9.4,155,22,1,1,3,0)="numerous forms (concept, synonyms or lexical variants).  These terms are "
^DIC(9.4,155,22,1,1,4,0)="mapped to coding schemes such as ICD, SNOMED or CPT.  The Lexicon can be"
^DIC(9.4,155,22,1,1,5,0)="searched by keywords or by code."
^DIC(9.4,155,22,1,"PAH",0)="^9.4901^150^150"
