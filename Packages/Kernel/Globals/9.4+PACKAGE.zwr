^DIC(9.4,14,22,5.9,"PAH",5,1,215,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,216,0)="Select Accession WKLD if appropriate ^"
^DIC(9.4,14,22,5.9,"PAH",5,1,217,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,218,0)="================================================================"
^DIC(9.4,14,22,5.9,"PAH",5,1,219,0)="Example of the PCE ^TMP(""LRPXAPI"") which is built by the LRCAPPH1 routine."
^DIC(9.4,14,22,5.9,"PAH",5,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,221,0)="^TMP(""LRPXAPI"",545275466,""ENCOUNTER"",1,""ENC D/T"") = 2960709.140053"
^DIC(9.4,14,22,5.9,"PAH",5,1,222,0)="^TMP(""LRPXAPI"",545275466,""ENCOUNTER"",1,""ENCOUNTER TYPE"") = A"
^DIC(9.4,14,22,5.9,"PAH",5,1,223,0)="^TMP(""LRPXAPI"",545275466,""ENCOUNTER"",1,""HOS LOC"") = 41"
^DIC(9.4,14,22,5.9,"PAH",5,1,224,0)="^TMP(""LRPXAPI"",545275466,""ENCOUNTER"",1,""INSTITUTION"") = 5000"
^DIC(9.4,14,22,5.9,"PAH",5,1,225,0)="^TMP(""LRPXAPI"",545275466,""ENCOUNTER"",1,""PATIENT"") = 230"
^DIC(9.4,14,22,5.9,"PAH",5,1,226,0)="^TMP(""LRPXAPI"",545275466,""ENCOUNTER"",1,""SERVICE CATEGORY"") = X"
^DIC(9.4,14,22,5.9,"PAH",5,1,227,0)="^TMP(""LRPXAPI"",545275466,""PROCEDURE"",1,""ENC PROVIDER"") = 31"
^DIC(9.4,14,22,5.9,"PAH",5,1,228,0)="^TMP(""LRPXAPI"",545275466,""PROCEDURE"",1,""PROCEDURE"") = 12345"
^DIC(9.4,14,22,5.9,"PAH",5,1,229,0)="^TMP(""LRPXAPI"",545275466,""PROCEDURE"",1,""QTY"") = 1"
^DIC(9.4,14,22,5.9,"PAH",5,1,230,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,231,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,232,0)="ROUTINE SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",5,1,233,0)="================="
^DIC(9.4,14,22,5.9,"PAH",5,1,234,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,235,0)=" Routine Name           Before Patch      After Patch       Patch List"
^DIC(9.4,14,22,5.9,"PAH",5,1,236,0)="LR7OU4                  NA                12072536          127"
^DIC(9.4,14,22,5.9,"PAH",5,1,237,0)="LR7OU5                  NA                13069620          127"
^DIC(9.4,14,22,5.9,"PAH",5,1,238,0)="LRCAPDSS                NA                5467821           127"
^DIC(9.4,14,22,5.9,"PAH",5,1,239,0)="LRCAPFDS                6562403           8630651           105,119,127"
