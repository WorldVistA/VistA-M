^DIC(9.4,48,22,5.28,"PAH",713,1,20,0)="VSE-10971: HC - VistA: When returning clinics for a provider the RPC is "
^DIC(9.4,48,22,5.28,"PAH",713,1,21,0)="           returning all records from the HOSPITAL LOCATION (#44) file"
^DIC(9.4,48,22,5.28,"PAH",713,1,22,0)="           regardless of type."
^DIC(9.4,48,22,5.28,"PAH",713,1,23,0)="VSE-11008: GW - VistA: Modify SDCANCEL to open a closed MRTC Parent if the"
^DIC(9.4,48,22,5.28,"PAH",713,1,24,0)="           child request was reopened when appointments were cancelled."
^DIC(9.4,48,22,5.28,"PAH",713,1,25,0)="VSE-11034: TB - VistA: Modify SDES2 NO-SHOW and SDES2 UNDO NO-SHOW RPCs "
^DIC(9.4,48,22,5.28,"PAH",713,1,26,0)="           to remove and add back Appointment IEN for MRTC."
^DIC(9.4,48,22,5.28,"PAH",713,1,27,0)="VSE-11042: HC - VistA: Modify SDES GET PATIENT INQUIRY to recognize names"
^DIC(9.4,48,22,5.28,"PAH",713,1,28,0)="           with hyphen when stripping out SSN."
^DIC(9.4,48,22,5.28,"PAH",713,1,29,0)="VSE-11101: JJ - VistA: Modify SDES2CLININFO to include the IEN in the"
^DIC(9.4,48,22,5.28,"PAH",713,1,30,0)="           return object for PreApptLetter, CancelLetter, and"
^DIC(9.4,48,22,5.28,"PAH",713,1,31,0)="           ApptCancelLetter."
^DIC(9.4,48,22,5.28,"PAH",713,1,32,0)=" "
^DIC(9.4,48,22,5.28,"PAH",713,1,33,0)=" "
^DIC(9.4,48,22,5.28,"PAH",713,1,34,0)="PI 14.6 11/28-12/10 - SD*5.3*927"
