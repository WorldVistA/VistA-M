^DIC(9.4,4,22,1,"PAH",156,1,3,0)="NOIS: SBY-0501-32200"
^DIC(9.4,4,22,1,"PAH",156,1,4,0)="Test Site:  Salisbury, NC"
^DIC(9.4,4,22,1,"PAH",156,1,5,0)="If a user is working on the same message in two differents sessions, an"
^DIC(9.4,4,22,1,"PAH",156,1,6,0)="abort my occur if the user attempts to save the message in both sessions."
^DIC(9.4,4,22,1,"PAH",156,1,7,0)=" "
^DIC(9.4,4,22,1,"PAH",156,1,8,0)="NOTE: This patch should be installed during off hours, when user activity"
