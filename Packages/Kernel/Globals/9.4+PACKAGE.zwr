^DIC(9.4,47,22,5.9,"PAH",165,1,0)="^^2^2^3000405"
^DIC(9.4,47,22,5.9,"PAH",165,1,1,0)="Addresses NOIS NCH-0999-43030. Remove Cease Enrollment option from "
^DIC(9.4,47,22,5.9,"PAH",165,1,2,0)="[DGEN PATIENT ENROLLMENT] ListMan interface."
^DIC(9.4,47,22,5.9,"PAH",166,0)="280 SEQ #243^3000405^1"
^DIC(9.4,47,22,5.9,"PAH",166,1,0)="^^2^2^3000405"
^DIC(9.4,47,22,5.9,"PAH",166,1,1,0)="This patch updates the PTF CENSUS DATE (#45.86) file for the 2nd quarter"
^DIC(9.4,47,22,5.9,"PAH",166,1,2,0)="of FY 2000 census."
^DIC(9.4,47,22,5.9,"PAH",167,0)="272 SEQ #244^3000405^1"
^DIC(9.4,47,22,5.9,"PAH",167,1,0)="^^1^1^3000405"
^DIC(9.4,47,22,5.9,"PAH",167,1,1,0)="See National Patch Module for details. "
^DIC(9.4,47,22,5.9,"PAH",168,0)="245 SEQ #245^3000417^1"
^DIC(9.4,47,22,5.9,"PAH",168,1,0)="^^6^6^3000417"
^DIC(9.4,47,22,5.9,"PAH",168,1,1,0)="This patch eliminates the undefined error when execution returns to"
^DIC(9.4,47,22,5.9,"PAH",168,1,2,0)="the routine DGREG after the DINUM variable has been newed in the routine"
^DIC(9.4,47,22,5.9,"PAH",168,1,3,0)="DIR1 at IT+1 and set to an inversed date/time."
^DIC(9.4,47,22,5.9,"PAH",168,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",168,1,5,0)="The changes included in this patch are described in the description of"
^DIC(9.4,47,22,5.9,"PAH",168,1,6,0)="patch DG*5.3*245 in the National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",169,0)="284 SEQ #246^3000502^1"
^DIC(9.4,47,22,5.9,"PAH",169,1,0)="^^1^1^3000502"
^DIC(9.4,47,22,5.9,"PAH",169,1,1,0)="See National Patch Module for details."
^DIC(9.4,47,22,5.9,"PAH",170,0)="223 SEQ #247^3000502^1"
^DIC(9.4,47,22,5.9,"PAH",170,1,0)="^^1^1^3000502"
^DIC(9.4,47,22,5.9,"PAH",170,1,1,0)="PATIENT file DD change"
^DIC(9.4,47,22,5.9,"PAH",171,0)="281 SEQ #248^3000516^1"
^DIC(9.4,47,22,5.9,"PAH",171,1,0)="^^5^5^3000516"
^DIC(9.4,47,22,5.9,"PAH",171,1,1,0)="If the DGSENFLG variable is set by the calling program, the patient's"
^DIC(9.4,47,22,5.9,"PAH",171,1,2,0)="sensitive record status should not be checked during a patient look up."
^DIC(9.4,47,22,5.9,"PAH",171,1,3,0)="This patch modifies routines DGSEC and DGSEC4 restoring this process to"
^DIC(9.4,47,22,5.9,"PAH",171,1,4,0)="its original functionality prior to DG*5.3*249, DGSEC MODIFICATIONS &"
^DIC(9.4,47,22,5.9,"PAH",171,1,5,0)="PRIVACY ACT COMPLIANCE FOR EMPLOYEES."
^DIC(9.4,47,22,5.9,"PAH",172,0)="243^3000516^1"
^DIC(9.4,47,22,5.9,"PAH",172,1,0)="^^1^1^3000516"
^DIC(9.4,47,22,5.9,"PAH",172,1,1,0)="CPT MODIFIERS AND MST"
^DIC(9.4,47,22,5.9,"PAH",173,0)="271 SEQ #250^3000516^1"
^DIC(9.4,47,22,5.9,"PAH",173,1,0)="^^2^2^3000516"
^DIC(9.4,47,22,5.9,"PAH",173,1,1,0)="Resolve Issue with invalid Receiving Facility and Undefined Variable DGX"
^DIC(9.4,47,22,5.9,"PAH",173,1,2,0)="in DGPMV301"
^DIC(9.4,47,22,5.9,"PAH",174,0)="261 SEQ #251^3000516^1"
^DIC(9.4,47,22,5.9,"PAH",174,1,0)="^^3^3^3000516"
^DIC(9.4,47,22,5.9,"PAH",174,1,1,0)="CPRS REMOTE DATA VIEWS"
^DIC(9.4,47,22,5.9,"PAH",174,1,2,0)="Refer to patch DG*5.3*261 in the FORUM Patch Module for a complete"
