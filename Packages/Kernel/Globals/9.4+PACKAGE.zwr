^DIC(9.4,177,22,3,"PAH",21,0)="13 SEQ #21^3060824^1"
^DIC(9.4,177,22,3,"PAH",21,1,0)="^^117^117^3060824"
^DIC(9.4,177,22,3,"PAH",21,1,1,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,2,0)="***"
^DIC(9.4,177,22,3,"PAH",21,1,3,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,4,0)="This patch is a component of the Bar Code Medication Administration "
^DIC(9.4,177,22,3,"PAH",21,1,5,0)="(BCMA) Version 3.0.  The main function of PSB*3.0*13 and the "
^DIC(9.4,177,22,3,"PAH",21,1,6,0)="corresponding BCMA Graphical User Interface (GUI) software (BCMA Version 3"
^DIC(9.4,177,22,3,"PAH",21,1,7,0)="Patch 13 [3.0.13]) is to support BCMA v3.0 Clinical Context Object "
^DIC(9.4,177,22,3,"PAH",21,1,8,0)="Workgroup (CCOW) compliance. The PSB*3.0*13 GUI and this Character User "
^DIC(9.4,177,22,3,"PAH",21,1,9,0)="Interface (CHUI) software (PSB*3.0*13) also support Patient Safety "
^DIC(9.4,177,22,3,"PAH",21,1,10,0)="Issues (PSI) and Remedy Ticket resolution and BCMA Coversheet refinement."
^DIC(9.4,177,22,3,"PAH",21,1,11,0)="***"
^DIC(9.4,177,22,3,"PAH",21,1,12,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,13,0)="1.   Problem: PSI-05-064"
^DIC(9.4,177,22,3,"PAH",21,1,14,0)="     BCMA functionality enables a BCMA user to edit the free text "
^DIC(9.4,177,22,3,"PAH",21,1,15,0)="     BCMA MEDICATION LOG FILE-DISPENSE DRUG SUBFILE (# 53.795) ""Units"
^DIC(9.4,177,22,3,"PAH",21,1,16,0)="     of Administration"" (field #.04) for an administered medication, when "
^DIC(9.4,177,22,3,"PAH",21,1,17,0)="     using the Edit Medication Log.  Consequently, the GUI Edit "
^DIC(9.4,177,22,3,"PAH",21,1,18,0)="     Medication Log (Edit Med Log) allows a BCMA user to modify text in "
^DIC(9.4,177,22,3,"PAH",21,1,19,0)="     the field labeled ""Units"" of the ""BCMA - Edit Med Log"" dialog box.  "
^DIC(9.4,177,22,3,"PAH",21,1,20,0)="     The user is able to change the ""Units"" from ""PATCH"" to any other text"
^DIC(9.4,177,22,3,"PAH",21,1,21,0)="     value.  Changing a ""PATCH"" medication to some other ""Units"", causes "
^DIC(9.4,177,22,3,"PAH",21,1,22,0)="     BCMA to not process the administration properly; and causes the BCMA "
^DIC(9.4,177,22,3,"PAH",21,1,23,0)="     Virtual Due List (VDL) to not present the administration properly."
^DIC(9.4,177,22,3,"PAH",21,1,24,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,25,0)="     Corrective Action:"
^DIC(9.4,177,22,3,"PAH",21,1,26,0)="     The BCMA GUI Edit Med Log will not allow any BCMA user to edit the "
^DIC(9.4,177,22,3,"PAH",21,1,27,0)="     BCMA MEDICATION LOG FILE/DISPENSE DRUG SUBFILE (# 53.795) ""Units "
^DIC(9.4,177,22,3,"PAH",21,1,28,0)="     of Administration"" (field # .04) of an administered ""PATCH"" "
^DIC(9.4,177,22,3,"PAH",21,1,29,0)="     medication."
^DIC(9.4,177,22,3,"PAH",21,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,31,0)="2.   Problem: PSI-05-032"
^DIC(9.4,177,22,3,"PAH",21,1,32,0)="     The VDL displays a GIVEN medication patch until it has been marked as"
^DIC(9.4,177,22,3,"PAH",21,1,33,0)="     ""REMOVED"".  This is causing some confusion to users."
^DIC(9.4,177,22,3,"PAH",21,1,34,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,35,0)="     Corrective Action:"
^DIC(9.4,177,22,3,"PAH",21,1,36,0)="     BCMA will provide a site parameter that will specify the number of "
^DIC(9.4,177,22,3,"PAH",21,1,37,0)="     days (7-14) a GIVEN patch will display on the VDL.  The count of "
^DIC(9.4,177,22,3,"PAH",21,1,38,0)="     days the GIVEN patch displays on the VDL begins when the "
^DIC(9.4,177,22,3,"PAH",21,1,39,0)="     medication order expires.  This parameter may be set to """""
^DIC(9.4,177,22,3,"PAH",21,1,40,0)="     (null) to allow GIVEN patches to display on the VDL until it is "
^DIC(9.4,177,22,3,"PAH",21,1,41,0)="     marked as REMOVED."
^DIC(9.4,177,22,3,"PAH",21,1,42,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,43,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,44,0)="3.   Problem: PSI-05-115"
^DIC(9.4,177,22,3,"PAH",21,1,45,0)="     The Special Instructions on the VDL will display the entire Special "
^DIC(9.4,177,22,3,"PAH",21,1,46,0)="     Instructions by wrapping the text as needed using the spaces in the "
^DIC(9.4,177,22,3,"PAH",21,1,47,0)="     Special Instructions. However, ff a word or phrase (without spaces) "
^DIC(9.4,177,22,3,"PAH",21,1,48,0)="     in the Special Instructions can not be wrapped due to the word or "
^DIC(9.4,177,22,3,"PAH",21,1,49,0)="     phrase being longer then the width of the column, the text would be "
^DIC(9.4,177,22,3,"PAH",21,1,50,0)="     truncated when the text ran into the right side of the column. In "
^DIC(9.4,177,22,3,"PAH",21,1,51,0)="     addition, when the above happens, some of the ending words in the "
^DIC(9.4,177,22,3,"PAH",21,1,52,0)="     special instructions may be omitted as well."
^DIC(9.4,177,22,3,"PAH",21,1,53,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,54,0)="     Correction Action:"
^DIC(9.4,177,22,3,"PAH",21,1,55,0)="     When a word or phrase (without spaces) can not be wrapped and does "
^DIC(9.4,177,22,3,"PAH",21,1,56,0)="     not fit in the column width, the text will be truncated with an "
^DIC(9.4,177,22,3,"PAH",21,1,57,0)="     ellipsis to indicate that a portion of the word or phrase was "
^DIC(9.4,177,22,3,"PAH",21,1,58,0)="     truncated. The occasional omission of ending words in the special "
^DIC(9.4,177,22,3,"PAH",21,1,59,0)="     instructions will be corrected. "
^DIC(9.4,177,22,3,"PAH",21,1,60,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,61,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,62,0)="4.   Problem:  HD0000000121694"
^DIC(9.4,177,22,3,"PAH",21,1,63,0)="     While a medication patch is being ""administered"" using Manual "
^DIC(9.4,177,22,3,"PAH",21,1,64,0)="     Medication Entry[PSB MED LOG NEW ENTRY], that particular scheduled "
^DIC(9.4,177,22,3,"PAH",21,1,65,0)="     administration does not display on the BCMA Virtual Due List (VDL)."
^DIC(9.4,177,22,3,"PAH",21,1,66,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,67,0)="     Corrective Action:"
^DIC(9.4,177,22,3,"PAH",21,1,68,0)="     Display the saved ""action status"" of an administration, while it is "
^DIC(9.4,177,22,3,"PAH",21,1,69,0)="     being administered using Manual Medication Entry [PSB MED LOG NEW "
^DIC(9.4,177,22,3,"PAH",21,1,70,0)="     ENTRY]"
^DIC(9.4,177,22,3,"PAH",21,1,71,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,72,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,73,0)="5.   Problem:  HD0000000127625"
^DIC(9.4,177,22,3,"PAH",21,1,74,0)="     An error occurs when the BCMA coversheet is to display data for one "
^DIC(9.4,177,22,3,"PAH",21,1,75,0)="     order only; and that order is an expired, large volume IV."
^DIC(9.4,177,22,3,"PAH",21,1,76,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,77,0)="     Corrective Action:"
^DIC(9.4,177,22,3,"PAH",21,1,78,0)="     The BCMA Coversheet will display without error when the only order "
^DIC(9.4,177,22,3,"PAH",21,1,79,0)="     information to display on the BCMA coversheet pertains to an expired,"
^DIC(9.4,177,22,3,"PAH",21,1,80,0)="     large volume IV."
^DIC(9.4,177,22,3,"PAH",21,1,81,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,82,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,83,0)="6.   Problem:  HD0000000132184"
^DIC(9.4,177,22,3,"PAH",21,1,84,0)="     An error occurs when the BCMA GUI Computerized Patient Record System "
^DIC(9.4,177,22,3,"PAH",21,1,85,0)="     (CPRS)/BCMA Medication Order Button (MOB) is used and ORDER "
^DIC(9.4,177,22,3,"PAH",21,1,86,0)="     File (#100) PATIENT LOCATION (field #6) data does not link to a "
^DIC(9.4,177,22,3,"PAH",21,1,87,0)="     WARD LOCATION File (#42) entry."
^DIC(9.4,177,22,3,"PAH",21,1,88,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,89,0)="     Corrective Action:"
^DIC(9.4,177,22,3,"PAH",21,1,90,0)="     BCMA will provide HOSPITAL LOCATION File (#44) data per ORDER File "
^DIC(9.4,177,22,3,"PAH",21,1,91,0)="     (#100) PATIENT LOCATION (field #6) data when the CPRS/BCMA MOB is "
^DIC(9.4,177,22,3,"PAH",21,1,92,0)="     used.  CPRS will ORDER File (#100) PATIENT LOCATION (field #6) data "
^DIC(9.4,177,22,3,"PAH",21,1,93,0)="     to a HOSPITAL LOCATION File (#44) entry "
^DIC(9.4,177,22,3,"PAH",21,1,94,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,95,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,96,0)="7.   Enhancement:  CCOW compliancy"
^DIC(9.4,177,22,3,"PAH",21,1,97,0)="     This patch (PSB*3.0*13) will enable BCMA CCOW compliancy."
^DIC(9.4,177,22,3,"PAH",21,1,98,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,99,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,100,0)="8.   Enhancement:  Enhanced ""*UNKNOWN* Action Status"" support."
^DIC(9.4,177,22,3,"PAH",21,1,101,0)="     BCMA Medication Log File (File #53.79) entries having unknown "
^DIC(9.4,177,22,3,"PAH",21,1,102,0)="     Action Status (field #.09) data can be maintained via the GUI BCMA "
^DIC(9.4,177,22,3,"PAH",21,1,103,0)="     Edit Med Log only. These entries may be maintained by persons holding"
^DIC(9.4,177,22,3,"PAH",21,1,104,0)="     the BCMA manager's key [PSB MANAGER] or that user unable to complete "
^DIC(9.4,177,22,3,"PAH",21,1,105,0)="     the original administration.  PSB*3.0*13 supports the VISTA ""Unknown "
^DIC(9.4,177,22,3,"PAH",21,1,106,0)="     Action Status Report"" option [PSBO XA].  The [PSBO XA] option "
^DIC(9.4,177,22,3,"PAH",21,1,107,0)="     provides persons holding the BCMA manager's key [PSB MANAGER] "
^DIC(9.4,177,22,3,"PAH",21,1,108,0)="     resource to generate a report to display BCMA Medication Log File "
^DIC(9.4,177,22,3,"PAH",21,1,109,0)="     (#53.79) entries having ""unknown"" Action Status (field #.09) data.  "
^DIC(9.4,177,22,3,"PAH",21,1,110,0)="     Users holding the BCMA manager's key [PSB MANAGER] can access the "
^DIC(9.4,177,22,3,"PAH",21,1,111,0)="     PSBO XA report via the BCMA GUI as well.  BCMA has been enhanced to "
^DIC(9.4,177,22,3,"PAH",21,1,112,0)="     display a ""pop-up box"" when a user begins an action on an order "
^DIC(9.4,177,22,3,"PAH",21,1,113,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,114,0)=" "
^DIC(9.4,177,22,3,"PAH",21,1,115,0)="9.   Enhancement:  Saved Coversheet Personal Parameters"
^DIC(9.4,177,22,3,"PAH",21,1,116,0)="     PSB*3.0*13 will maintain personal parameters per BCMA Coversheet "
^DIC(9.4,177,22,3,"PAH",21,1,117,0)="     views to be saved and retrieved when using BCMA. "
^DIC(9.4,177,22,3,"PAH",22,0)="26 SEQ #22^3060824^1"
^DIC(9.4,177,22,3,"PAH",22,1,0)="^^1^1^3060824"
^DIC(9.4,177,22,3,"PAH",22,1,1,0)="This patch corrects display problems with the Missed Med Rpt"
^DIC(9.4,177,22,3,"PAH",23,0)="17 SEQ #23^3061211.155835^1"
^DIC(9.4,177,22,3,"PAH",23,1,0)="^^1^1^3061211"
^DIC(9.4,177,22,3,"PAH",23,1,1,0)="Problem with Medication History Report."
^DIC(9.4,177,22,3,"PAH",24,0)="10 SEQ #24^3070627.231224^1"
^DIC(9.4,177,22,3,"PAH",24,1,0)="^^33^33^3070627"
^DIC(9.4,177,22,3,"PAH",24,1,1,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,2,0)="Problem #HD0000000159234 - Means Test Pop-up Does Not Display:"
^DIC(9.4,177,22,3,"PAH",24,1,3,0)="   Bar Code Medication Administration (BCMA) Graphical User Interface"
^DIC(9.4,177,22,3,"PAH",24,1,4,0)="  (GUI) Means Test Pop-Up Does Not Display after the installation of"
^DIC(9.4,177,22,3,"PAH",24,1,5,0)="   BCMA GUI Version 3 Patch 13. "
^DIC(9.4,177,22,3,"PAH",24,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,7,0)="Corrective Action:"
^DIC(9.4,177,22,3,"PAH",24,1,8,0)="   Modify the BCMA GUI to allow the BCMA GUI Means Test Pop-up to display"
^DIC(9.4,177,22,3,"PAH",24,1,9,0)="   when appropriate. "
^DIC(9.4,177,22,3,"PAH",24,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,11,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,12,0)="Enhancement - Compliance with Section 508 of the Rehabilitation Act of"
^DIC(9.4,177,22,3,"PAH",24,1,13,0)="              1973:"
^DIC(9.4,177,22,3,"PAH",24,1,14,0)="   PSB*3.0*10 and its corresponding BCMA GUI[Version 3 Patch 10 "
^DIC(9.4,177,22,3,"PAH",24,1,15,0)="   (3.0.10.9)] will assure BCMA is compliant with Section 508 of the "
^DIC(9.4,177,22,3,"PAH",24,1,16,0)="   Rehabilitation Act of 1973, after proper installation as defined in "
^DIC(9.4,177,22,3,"PAH",24,1,17,0)="   the BCMA 508 Software Requirements Specifications."
^DIC(9.4,177,22,3,"PAH",24,1,18,0)="   "
^DIC(9.4,177,22,3,"PAH",24,1,19,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,20,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,21,0)="Enhancement - Signal BCMA Idle Timeout:"
^DIC(9.4,177,22,3,"PAH",24,1,22,0)="   BCMA GUI Version 3 Patch 10 will signal to the user as BCMA Idle "
^DIC(9.4,177,22,3,"PAH",24,1,23,0)="   Timeout limit is approaching. There will be an audible ""beep"" thirty"
^DIC(9.4,177,22,3,"PAH",24,1,24,0)="   (30) seconds, twenty (20) seconds, and ten (10) seconds prior to the"
^DIC(9.4,177,22,3,"PAH",24,1,25,0)="   idle time limit set via the ""BCMA Idle Timeout"" site parameter."
^DIC(9.4,177,22,3,"PAH",24,1,26,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,27,0)=" "
^DIC(9.4,177,22,3,"PAH",24,1,28,0)="Enhancement - Indication When not all Drugs Have Been Scanned Per a"
^DIC(9.4,177,22,3,"PAH",24,1,29,0)="              Multiple Drug Order :"
^DIC(9.4,177,22,3,"PAH",24,1,30,0)="   BCMA GUI Version 3 Patch 10 will display a message box when"
^DIC(9.4,177,22,3,"PAH",24,1,31,0)="   the user has not scanned all the dispensed drugs per a medication "
^DIC(9.4,177,22,3,"PAH",24,1,32,0)="   order that includes multiple dispensed drugs.  The message box will "
^DIC(9.4,177,22,3,"PAH",24,1,33,0)="   display, requesting user confirmation."
^DIC(9.4,177,22,3,"PAH",25,0)="39 SEQ #25^3070904.235855^1"
^DIC(9.4,177,22,3,"PAH",25,1,0)="^^1^1^3070904"
^DIC(9.4,177,22,3,"PAH",25,1,1,0)="Edit Med Log creates duplicate entries"
^DIC(9.4,177,22,3,"PAH",26,0)="38 SEQ #26^3070905.012504^1"
^DIC(9.4,177,22,3,"PAH",26,1,0)="^^1^1^3070905"
^DIC(9.4,177,22,3,"PAH",26,1,1,0)="Med Route display issues"
^DIC(9.4,177,22,3,"PAH",27,0)="41 SEQ #27^3071212.204827^1"
^DIC(9.4,177,22,3,"PAH",27,1,0)="^^1^1^3071212"
^DIC(9.4,177,22,3,"PAH",27,1,1,0)="Unable to Edit Med Log in BCMA"
^DIC(9.4,177,22,3,"PAH",28,0)="32 SEQ #28^3071212.212437^1"
^DIC(9.4,177,22,3,"PAH",28,1,0)="^^77^77^3071212"
^DIC(9.4,177,22,3,"PAH",28,1,1,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,3,0)="This patch is a component of the Bar Code Medication Administration "
^DIC(9.4,177,22,3,"PAH",28,1,4,0)="(BCMA) Health Systems Committee (HSC) Phase III project.  The main"
^DIC(9.4,177,22,3,"PAH",28,1,5,0)="function of PSB*3*32 and the corresponding BCMA Graphical User"
^DIC(9.4,177,22,3,"PAH",28,1,6,0)="Interface (GUI) software (BCMA Version 3 Patch 32 [3.0.32.*]) is to"
^DIC(9.4,177,22,3,"PAH",28,1,7,0)="provide the BCMA user with additional BCMA Coversheet and reporting "
^DIC(9.4,177,22,3,"PAH",28,1,8,0)="support."
^DIC(9.4,177,22,3,"PAH",28,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,11,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,12,0)="1.  Problem:  PSI-06-029/HD0000000126326"
^DIC(9.4,177,22,3,"PAH",28,1,13,0)="    Processing the BCMA Missed Medications Report causes the client to "
^DIC(9.4,177,22,3,"PAH",28,1,14,0)="    ""time-out"" when the report is to display within the BCMA GUI "
^DIC(9.4,177,22,3,"PAH",28,1,15,0)="    Application and prior to sending the report to a printer."
^DIC(9.4,177,22,3,"PAH",28,1,16,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,17,0)="    Corrective Action:"
^DIC(9.4,177,22,3,"PAH",28,1,18,0)="    Make the Missed Medications Report process faster so the client "
^DIC(9.4,177,22,3,"PAH",28,1,19,0)="    does not ""time-out""."
^DIC(9.4,177,22,3,"PAH",28,1,20,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,21,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,22,0)="2.  Problem:  PSI-06-019/HD0000000130671"
^DIC(9.4,177,22,3,"PAH",28,1,23,0)="    There is difficulty determining the application of a medical patch "
^DIC(9.4,177,22,3,"PAH",28,1,24,0)="    that has not been marked as REMOVED when that order has expired or "
^DIC(9.4,177,22,3,"PAH",28,1,25,0)="    discontinued."
^DIC(9.4,177,22,3,"PAH",28,1,26,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,27,0)="    Corrective Action:"
^DIC(9.4,177,22,3,"PAH",28,1,28,0)="    Allow the user to view and act on patches for expired or discontinued "
^DIC(9.4,177,22,3,"PAH",28,1,29,0)="    orders when the patient's BCMA Virtual Due List (VDL) first opens."
^DIC(9.4,177,22,3,"PAH",28,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,31,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,32,0)="3.  Problem:  PSI-06-056/HD0000000131075"
^DIC(9.4,177,22,3,"PAH",28,1,33,0)="    Issues related to extra Pro Re Nata (PRN) doses of medication "
^DIC(9.4,177,22,3,"PAH",28,1,34,0)="    ordered as QDPRN or BIDPRN and reports of nurses missing the last "
^DIC(9.4,177,22,3,"PAH",28,1,35,0)="    administration time, have cause patient safety concerns. "
^DIC(9.4,177,22,3,"PAH",28,1,36,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,37,0)="    Corrective Action:"
^DIC(9.4,177,22,3,"PAH",28,1,38,0)="    The BCMA PRN administration dialog box will be enhanced to provide the"
^DIC(9.4,177,22,3,"PAH",28,1,39,0)="    following features for all PRN administrations:  Icon, Schedule, Last"
^DIC(9.4,177,22,3,"PAH",28,1,40,0)="    Given and Reminder checkbox and statement."
^DIC(9.4,177,22,3,"PAH",28,1,41,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,42,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,43,0)="4.  Problem:  PSI-06-014/HD0000000128909"
^DIC(9.4,177,22,3,"PAH",28,1,44,0)="    Administration problems have been caused when Med Route abbreviations"
^DIC(9.4,177,22,3,"PAH",28,1,45,0)="    on the VDL have been confused."
^DIC(9.4,177,22,3,"PAH",28,1,46,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,47,0)="    Corrective Action:"
^DIC(9.4,177,22,3,"PAH",28,1,48,0)="    Display the expanded version of the Med Route."
^DIC(9.4,177,22,3,"PAH",28,1,49,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,50,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,51,0)="5.  Problem:  PSI-06-060/HD0000000143603"
^DIC(9.4,177,22,3,"PAH",28,1,52,0)="    Due to a limitation in the Delphi application, there is a 255-pixel"
^DIC(9.4,177,22,3,"PAH",28,1,53,0)="    limit on the row height in the BCMA GUI VDL that results in truncation"
^DIC(9.4,177,22,3,"PAH",28,1,54,0)="    of an order when there are a large number of additives/solutions on"
^DIC(9.4,177,22,3,"PAH",28,1,55,0)="    the order."
^DIC(9.4,177,22,3,"PAH",28,1,56,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,57,0)="    Corrective Action:"
^DIC(9.4,177,22,3,"PAH",28,1,58,0)="    Adjust display area of medications on the VDL to compensate for orders"
^DIC(9.4,177,22,3,"PAH",28,1,59,0)="    with a large number of items to display."
^DIC(9.4,177,22,3,"PAH",28,1,60,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,61,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,62,0)="6.  Enhancement:  New Coversheet Overview Reports."
^DIC(9.4,177,22,3,"PAH",28,1,63,0)="    As a part of the BCMA HSC Phase III, patch PSB*3.0*32 and "
^DIC(9.4,177,22,3,"PAH",28,1,64,0)="    PSB.3.0.32 GUI will provide BCMA users with reports that display "
^DIC(9.4,177,22,3,"PAH",28,1,65,0)="    Coversheet Overview data.  There is a new Coversheet Report for each "
^DIC(9.4,177,22,3,"PAH",28,1,66,0)="    Coversheet Overview."
^DIC(9.4,177,22,3,"PAH",28,1,67,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,68,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,69,0)="7.  Enhancement:  Global Report Enhancements."
^DIC(9.4,177,22,3,"PAH",28,1,70,0)="    Various enhancements have been made to BCMA reports in general.  These"
^DIC(9.4,177,22,3,"PAH",28,1,71,0)="    enhancements are presented in BCMA HSC Phase III documentation."
^DIC(9.4,177,22,3,"PAH",28,1,72,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,73,0)=" "
^DIC(9.4,177,22,3,"PAH",28,1,74,0)="8.  Enhancement:  Coversheet and Other Miscellaneous Enhancements."
^DIC(9.4,177,22,3,"PAH",28,1,75,0)="    A variety of new Coversheet and miscellaneous feature will be "
^DIC(9.4,177,22,3,"PAH",28,1,76,0)="    supported with the installation of this patch.  The BCMA HSC Phase "
^DIC(9.4,177,22,3,"PAH",28,1,77,0)="    III documentation provides details of these new features."
^DIC(9.4,177,22,3,"PAH",29,0)="31 SEQ #29^3071212.221746^1"
^DIC(9.4,177,22,3,"PAH",29,1,0)="^^1^1^3071212"
^DIC(9.4,177,22,3,"PAH",29,1,1,0)="Can't enter Manual Med entry for discharged patient."
^DIC(9.4,177,22,3,"PAH",30,0)="2 SEQ #30^3080526.190926^1"
^DIC(9.4,177,22,3,"PAH",30,1,0)="^^4^4^3080526"
^DIC(9.4,177,22,3,"PAH",30,1,1,0)="This patch will add the new Barcode Label Print [PSBO BZ] option "
^DIC(9.4,177,22,3,"PAH",30,1,2,0)="to the Bar Code Medication Administration application.  Review "
^DIC(9.4,177,22,3,"PAH",30,1,3,0)="the patch description for detail functionality. "
^DIC(9.4,177,22,3,"PAH",30,1,4,0)=""
^DIC(9.4,177,22,3,"PAH",31,0)="37 SEQ #31^3080722.075042^1"
^DIC(9.4,177,22,3,"PAH",31,1,0)="^^10^10^3080722"
^DIC(9.4,177,22,3,"PAH",31,1,1,0)="This patch contains miscellaneous fixes for the BCMA Contingency plan "
^DIC(9.4,177,22,3,"PAH",31,1,2,0)="backup system."
^DIC(9.4,177,22,3,"PAH",31,1,3,0)=" "
^DIC(9.4,177,22,3,"PAH",31,1,4,0)="This patch addresses the following remedy tickets:"
^DIC(9.4,177,22,3,"PAH",31,1,5,0)="HD139965 -- Patient data not available on clients after PSB*3.0*8"
^DIC(9.4,177,22,3,"PAH",31,1,6,0)="HD150133 -- Problem with new Contigency set up."
^DIC(9.4,177,22,3,"PAH",31,1,7,0)="HD189870 -- Variable needs to be NEW'd"
^DIC(9.4,177,22,3,"PAH",31,1,8,0)=" "
^DIC(9.4,177,22,3,"PAH",31,1,9,0)="This patch also contains an enhancement to the BCBU user init "
^DIC(9.4,177,22,3,"PAH",31,1,10,0)="functionality."
^DIC(9.4,177,22,3,"PAH",32,0)="43 SEQ #32^3090421.160047^17"
^DIC(9.4,177,22,3,"PAH",32,1,0)="^^1^1^3090421"
^DIC(9.4,177,22,3,"PAH",32,1,1,0)="Med Admin History report intermittently displays"
^DIC(9.4,177,22,3,"PAH",33,0)="25 SEQ #33^3090422.163809^17"
^DIC(9.4,177,22,3,"PAH",33,1,0)="^^1^1^3090422"
^DIC(9.4,177,22,3,"PAH",33,1,1,0)="DUE LIST DISPLAYED MED NOT DUE"
^DIC(9.4,177,22,3,"PAH",34,0)="40 SEQ #34^3090423.102902^17"
^DIC(9.4,177,22,3,"PAH",34,1,0)="^^6^6^3090423"
^DIC(9.4,177,22,3,"PAH",34,1,1,0)="This patch corrects the following remedy tickets for BCMA issues:"
^DIC(9.4,177,22,3,"PAH",34,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",34,1,3,0)=" "
^DIC(9.4,177,22,3,"PAH",34,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",34,1,5,0)="HD189271 - A piece of code in PSBOPM needs to be changed."
^DIC(9.4,177,22,3,"PAH",34,1,6,0)="HD167891 - Medication Administration History display problem in CPRS"
^DIC(9.4,177,22,3,"PAH",35,0)="28 SEQ #35^3090423.122507^17"
^DIC(9.4,177,22,3,"PAH",35,1,0)="^^49^49^3090423"
^DIC(9.4,177,22,3,"PAH",35,1,1,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,2,0)="ATTENTION: This patch includes a new Graphical User Interface (GUI)"
^DIC(9.4,177,22,3,"PAH",35,1,3,0)="executable file. Installation of this GUI is required immediately"
^DIC(9.4,177,22,3,"PAH",35,1,4,0)="after the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",35,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,6,0)="For retrieval and installation instructions, please see the Client"
^DIC(9.4,177,22,3,"PAH",35,1,7,0)="Installation Instructions section."
^DIC(9.4,177,22,3,"PAH",35,1,8,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,9,0)="This patch is a component of the Bar Code Medication Administration (BCMA)"
^DIC(9.4,177,22,3,"PAH",35,1,10,0)="Version 3.0 Managing Scanning Failures (MSF) project.  The main function"
^DIC(9.4,177,22,3,"PAH",35,1,11,0)="of PSB*3*28 and the corresponding BCMA GUI software (BCMA Version 3 Patch"
^DIC(9.4,177,22,3,"PAH",35,1,12,0)="28 [3.0.28]) is to document scanning failures during BCMA patient and"
^DIC(9.4,177,22,3,"PAH",35,1,13,0)="medication verification. Please see Release Notes document for more "
^DIC(9.4,177,22,3,"PAH",35,1,14,0)="details on the following enhancements."
^DIC(9.4,177,22,3,"PAH",35,1,15,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,16,0)="1. Enhancement:  Document Unable to Scan events. This patch will enable"
^DIC(9.4,177,22,3,"PAH",35,1,17,0)="   the user to document Unable to Scan events that occur during BCMA"
^DIC(9.4,177,22,3,"PAH",35,1,18,0)="   patient and medication verification.  The Computerized Patient Record"
^DIC(9.4,177,22,3,"PAH",35,1,19,0)="   System Medical Order Button and the creation of ward stock orders in"
^DIC(9.4,177,22,3,"PAH",35,1,20,0)="   BCMA will not be fully supported by the Unable to Scan functionality."
^DIC(9.4,177,22,3,"PAH",35,1,21,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,22,0)="2. Enhancement:  Send a MailMan message for each Unable to Scan event."
^DIC(9.4,177,22,3,"PAH",35,1,23,0)="   When a user documents an Unable to Scan event, a message will"
^DIC(9.4,177,22,3,"PAH",35,1,24,0)="   be sent to persons who are members of the mail group established"
^DIC(9.4,177,22,3,"PAH",35,1,25,0)="   via the BCMA Site Parameter's Unable to Scan mail group field"
^DIC(9.4,177,22,3,"PAH",35,1,26,0)="   setting. This message will also be sent to the user submitting"
^DIC(9.4,177,22,3,"PAH",35,1,27,0)="   the Unable to Scan event documentation."
^DIC(9.4,177,22,3,"PAH",35,1,28,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,29,0)="3. Enhancement:  Add two new Unable to Scan Reports."
^DIC(9.4,177,22,3,"PAH",35,1,30,0)="   Detailed and summary reports of BCMA Unable to Scan data may be"
^DIC(9.4,177,22,3,"PAH",35,1,31,0)="   executed by persons holding the PSB UNABLE TO SCAN security key."
^DIC(9.4,177,22,3,"PAH",35,1,32,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,33,0)="4. Enhancement: Added Division Filtering to Unable to Scan Reports."
^DIC(9.4,177,22,3,"PAH",35,1,34,0)="   The user's division is detected upon login, and used to filter"
^DIC(9.4,177,22,3,"PAH",35,1,35,0)="   Entire Facility and Nurse Unit options on the Summary Report, and All"
^DIC(9.4,177,22,3,"PAH",35,1,36,0)="   Patients/Wards option on the Detailed Report."
^DIC(9.4,177,22,3,"PAH",35,1,37,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,38,0)="5. Enhancement: Added new PSB*3*32 functionality to the MSF reports."
^DIC(9.4,177,22,3,"PAH",35,1,39,0)="   Patch PSB*3*32 created new report functionality requirements, such as"
^DIC(9.4,177,22,3,"PAH",35,1,40,0)="   allowing a start and stop time, and report preview. For consistency,"
^DIC(9.4,177,22,3,"PAH",35,1,41,0)="   these have been included in the MSF reports."
^DIC(9.4,177,22,3,"PAH",35,1,42,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,43,0)="6. Enhancement: Usability."
^DIC(9.4,177,22,3,"PAH",35,1,44,0)="   Made changes based on feedback from the MSF usability study."
^DIC(9.4,177,22,3,"PAH",35,1,45,0)=" "
^DIC(9.4,177,22,3,"PAH",35,1,46,0)="7. Enhancement: Allow Action on Infusing or Stopped IV Bags."
^DIC(9.4,177,22,3,"PAH",35,1,47,0)="   Added Take Action on Bag option to the IV Bag Chronology Window to"
^DIC(9.4,177,22,3,"PAH",35,1,48,0)="   allow user to take action on infusing or stopped bags without having"
^DIC(9.4,177,22,3,"PAH",35,1,49,0)="   to rescan the IV bag."
^DIC(9.4,177,22,3,"PAH",36,0)="45 SEQ #36^3090623.145046^17"
^DIC(9.4,177,22,3,"PAH",36,1,0)="^^9^9^3090623"
^DIC(9.4,177,22,3,"PAH",36,1,1,0)="This patch will correct the following issues."
^DIC(9.4,177,22,3,"PAH",36,1,2,0)="HD226037 - Initials don't show on MAH or Med log for first action on med"
^DIC(9.4,177,22,3,"PAH",36,1,3,0)="HD190817 - Record needs to show the initials of the nurse who "
^DIC(9.4,177,22,3,"PAH",36,1,4,0)="           administered the medication not the initials of nurse who "
^DIC(9.4,177,22,3,"PAH",36,1,5,0)="           created the error."
^DIC(9.4,177,22,3,"PAH",36,1,6,0)="HD255639 - Missing Field Definition."
^DIC(9.4,177,22,3,"PAH",36,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",36,1,8,0)="Partial Correction for"
^DIC(9.4,177,22,3,"PAH",36,1,9,0)="HD260760 - Routine's Don't meet 1995 M standard."
^DIC(9.4,177,22,3,"PAH",37,0)="33 SEQ #37^3091109.112531^17"
^DIC(9.4,177,22,3,"PAH",37,1,0)="^^1^1^3091109"
^DIC(9.4,177,22,3,"PAH",37,1,1,0)="ONE-TIME PRN CAN BE GIVEN MULTIPLE TIMES."
^DIC(9.4,177,22,3,"PAH",38,0)="47 SEQ #38^3091201.142558^17"
^DIC(9.4,177,22,3,"PAH",38,1,0)="^^8^8^3091201"
^DIC(9.4,177,22,3,"PAH",38,1,1,0)="This patch provides the components for the Class III to Class I conversion"
^DIC(9.4,177,22,3,"PAH",38,1,2,0)="project Immunizations Documentation by BCMA."
^DIC(9.4,177,22,3,"PAH",38,1,3,0)=" "
^DIC(9.4,177,22,3,"PAH",38,1,4,0)="Included in this patch is a new option named Immunizations Documentation"
^DIC(9.4,177,22,3,"PAH",38,1,5,0)="by BCMA Nightly Task [PSB PX BCMA2PCE TASK]."
^DIC(9.4,177,22,3,"PAH",38,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",38,1,7,0)="Patch PSS*1*141 provides the Pharmacy Data Management portion of the"
^DIC(9.4,177,22,3,"PAH",38,1,8,0)="project."
^DIC(9.4,177,22,3,"PAH",39,0)="46 SEQ #39^3100105.170023^17"
^DIC(9.4,177,22,3,"PAH",39,1,0)="^^2^2^3100105"
^DIC(9.4,177,22,3,"PAH",39,1,1,0)="This patch will correct errors generated when BCMA is used in "
^DIC(9.4,177,22,3,"PAH",39,1,2,0)="environments with mixed Operating Systems (OS)"
^DIC(9.4,177,22,3,"PAH",40,0)="51 SEQ #40^3101116.170003^17"
^DIC(9.4,177,22,3,"PAH",40,1,0)="^^8^8^3101116"
^DIC(9.4,177,22,3,"PAH",40,1,1,0)="This patch addresses 4 issues:"
^DIC(9.4,177,22,3,"PAH",40,1,2,0)="1. The PRN EFFECTIVENESS field (#.22) does not show up on the ""Medication "
^DIC(9.4,177,22,3,"PAH",40,1,3,0)="   Admin History"" report but does on the ""Medication Log"" report."
^DIC(9.4,177,22,3,"PAH",40,1,4,0)="2. MANUAL MEDICATION ENTRY [PSB MED LOG NEW ENTRY] Issue/Unknown Status"
^DIC(9.4,177,22,3,"PAH",40,1,5,0)="   Report."
^DIC(9.4,177,22,3,"PAH",40,1,6,0)="3. ""Missed Medications"" report in BCMA did not display a missed"
^DIC(9.4,177,22,3,"PAH",40,1,7,0)="   medication."
^DIC(9.4,177,22,3,"PAH",40,1,8,0)="4. Problems with ""Missed Medication"" report."
^DIC(9.4,177,22,3,"PAH",41,0)="56 SEQ #41^3101129.150036^17"
^DIC(9.4,177,22,3,"PAH",41,1,0)="^^10^10^3101129"
^DIC(9.4,177,22,3,"PAH",41,1,1,0)=" This Patch Addresses 4 issues:"
^DIC(9.4,177,22,3,"PAH",41,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",41,1,3,0)=" 1.  An invalid MUMPS date (a date prior to 12/31/1840) entered for the"
^DIC(9.4,177,22,3,"PAH",41,1,4,0)="     BCMA Administration Times report creates an infinite loop which sends"
^DIC(9.4,177,22,3,"PAH",41,1,5,0)="     out BCMA Order Problem emails."
^DIC(9.4,177,22,3,"PAH",41,1,6,0)=" 2.  An undefined error occurs at PTLKUP+16^PSBMLLKU when a Nursing Ward"
^DIC(9.4,177,22,3,"PAH",41,1,7,0)="     contains lowercase letters."
^DIC(9.4,177,22,3,"PAH",41,1,8,0)=" 3.  Orders with a Status of On Call do not print on the BCMA Missed Meds "
^DIC(9.4,177,22,3,"PAH",41,1,9,0)="     Report or the BCMA Administration Times Report"
^DIC(9.4,177,22,3,"PAH",41,1,10,0)=" 4.  Patients are Duplicating on Reports for wards with similar names."
^DIC(9.4,177,22,3,"PAH",42,0)="50 SEQ #42^3101206.102805^17"
^DIC(9.4,177,22,3,"PAH",42,1,0)="^^15^15^3101206"
^DIC(9.4,177,22,3,"PAH",42,1,1,0)="This patch addresses Patient Safety issue PSPO #1401 and three"
^DIC(9.4,177,22,3,"PAH",42,1,2,0)="additional issues in Bar Code Medication Administration (BCMA):"
^DIC(9.4,177,22,3,"PAH",42,1,3,0)=" "
^DIC(9.4,177,22,3,"PAH",42,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",42,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",42,1,6,0)="1. PSPO #1401 - When a pain score is entered through BCMA and then marked "
^DIC(9.4,177,22,3,"PAH",42,1,7,0)="""entered in error"" in Vitals, the errant pain score still shows on the "
^DIC(9.4,177,22,3,"PAH",42,1,8,0)="BCMA Coversheet and other reports."
^DIC(9.4,177,22,3,"PAH",42,1,9,0)="2. Receiving an error ""Error - <UNDEFINED>SCANFAIL+9^PSBMLEN1"" when "
^DIC(9.4,177,22,3,"PAH",42,1,10,0)="running the MANUAL MEDICATION ENTRY [PSB MED LOG NEW ENTRY] option."
^DIC(9.4,177,22,3,"PAH",42,1,11,0)="3. Receiving error ""<SUBSCRIPT>EN+12^PSBOMH1"" when running the Medication "
^DIC(9.4,177,22,3,"PAH",42,1,12,0)="Administration History (MAH) report when the nurse has given a medication "
^DIC(9.4,177,22,3,"PAH",42,1,13,0)="and does not have his/her initials in the NEW PERSON file (#200)."
^DIC(9.4,177,22,3,"PAH",42,1,14,0)="4. The Medication Therapy report does not contain PRN Effectiveness "
^DIC(9.4,177,22,3,"PAH",42,1,15,0)="information."
^DIC(9.4,177,22,3,"PAH",43,0)="42 SEQ #43^3110216.095611^17"
^DIC(9.4,177,22,3,"PAH",43,1,0)="^^51^51^3110216"
^DIC(9.4,177,22,3,"PAH",43,1,1,0)="ATTENTION: This patch includes a new Graphical User Interface (GUI)"
^DIC(9.4,177,22,3,"PAH",43,1,2,0)="executable file. Installation of this GUI is required immediately after"
^DIC(9.4,177,22,3,"PAH",43,1,3,0)="the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",43,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,6,0)="This enhancement is intended to enable the BCMA application to recognize"
^DIC(9.4,177,22,3,"PAH",43,1,7,0)="whether it is operating in the Indian Health Service (IHS) or Veterans"
^DIC(9.4,177,22,3,"PAH",43,1,8,0)="Health Administration (VHA) environment, and respond by recognizing and"
^DIC(9.4,177,22,3,"PAH",43,1,9,0)="displaying the patient identifier appropriate to the environment."
^DIC(9.4,177,22,3,"PAH",43,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,11,0)="This enhancement will also bring the BCMA application compliant to"
^DIC(9.4,177,22,3,"PAH",43,1,12,0)="Section 508 of the Rehabilitation Act of 1973 and Rehabilitation Act"
^DIC(9.4,177,22,3,"PAH",43,1,13,0)="Amendments of 1998, which mandates that all software developed by federal"
^DIC(9.4,177,22,3,"PAH",43,1,14,0)="agencies allow access to and use of information and data by individuals"
^DIC(9.4,177,22,3,"PAH",43,1,15,0)="with disabilities."
^DIC(9.4,177,22,3,"PAH",43,1,16,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,17,0)="Please see the Release Notes for more details on the following"
^DIC(9.4,177,22,3,"PAH",43,1,18,0)="enhancements."
^DIC(9.4,177,22,3,"PAH",43,1,19,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,20,0)="1. Enhancement: This will enable a single version of BCMA to be"
^DIC(9.4,177,22,3,"PAH",43,1,21,0)="   maintained by VHA and yet be installed and operate in a ""plug and play"""
^DIC(9.4,177,22,3,"PAH",43,1,22,0)="   fashion in an IHS or Tribal facility running Resource and Patient"
^DIC(9.4,177,22,3,"PAH",43,1,23,0)="   Management System (RPMS)."
^DIC(9.4,177,22,3,"PAH",43,1,24,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,25,0)="2. Enhancement: The BCMA Graphical User Interface (GUI) will display"
^DIC(9.4,177,22,3,"PAH",43,1,26,0)="   vital measurements from the Veterans Administration (VA)"
^DIC(9.4,177,22,3,"PAH",43,1,27,0)="   VITALS/MEASUREMENTS package for VHA sites or optionally use the"
^DIC(9.4,177,22,3,"PAH",43,1,28,0)="   IHS PCC SUITE (APC) package which supports the V MEASURMENT file, if"
^DIC(9.4,177,22,3,"PAH",43,1,29,0)="   operating at an IHS facility and that facility is configured to use the"
^DIC(9.4,177,22,3,"PAH",43,1,30,0)="   V MEASUREMENT file."
^DIC(9.4,177,22,3,"PAH",43,1,31,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,32,0)="3. Enhancement: Section 508 Compliance including Edit Med Log"
^DIC(9.4,177,22,3,"PAH",43,1,33,0)="   Administration Selection form and a list of forms which have labels"
^DIC(9.4,177,22,3,"PAH",43,1,34,0)="   which will be converted to VA508StaticText."
^DIC(9.4,177,22,3,"PAH",43,1,35,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,36,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,37,0)="This Patch also Addresses 7 reported issues:"
^DIC(9.4,177,22,3,"PAH",43,1,38,0)=" "
^DIC(9.4,177,22,3,"PAH",43,1,39,0)="1. PSI-07-223 (PSPO-823) - If an IV order is already infusing when it is"
^DIC(9.4,177,22,3,"PAH",43,1,40,0)="   placed on provider hold, the IV can be stopped and then infused again"
^DIC(9.4,177,22,3,"PAH",43,1,41,0)="   while still on provider hold."
^DIC(9.4,177,22,3,"PAH",43,1,42,0)="2. PSPO-1678 - The MULTIPLE DOSE pop up form blocks the dosage on the"
^DIC(9.4,177,22,3,"PAH",43,1,43,0)="   Virtual Due List (VDL)."
^DIC(9.4,177,22,3,"PAH",43,1,44,0)="3. All BCMA reports have a default date based on the Laptop Time instead"
^DIC(9.4,177,22,3,"PAH",43,1,45,0)="   of the Server Time."
^DIC(9.4,177,22,3,"PAH",43,1,46,0)="4. The MedLog form in BCMA will accept a space for the required comment."
^DIC(9.4,177,22,3,"PAH",43,1,47,0)="5. 3 Missing Dose request reasons are missing from the Reason drop down"
^DIC(9.4,177,22,3,"PAH",43,1,48,0)="   box on the BCMA Missing Dose form."
^DIC(9.4,177,22,3,"PAH",43,1,49,0)="6. Remove the obsolete Scratch HFS Directory from the BCMA Parameters GUI."
^DIC(9.4,177,22,3,"PAH",43,1,50,0)="7. The units ordered do not display on the BCMA Medication Log report"
^DIC(9.4,177,22,3,"PAH",43,1,51,0)="   when a missing dose is requested and the order is held and then given."
^DIC(9.4,177,22,3,"PAH",44,0)="57 SEQ #45^3110913.12433^17"
^DIC(9.4,177,22,3,"PAH",44,1,0)="^^11^11^3110913"
^DIC(9.4,177,22,3,"PAH",44,1,1,0)="This Patch Addresses 3 issues:"
^DIC(9.4,177,22,3,"PAH",44,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",44,1,3,0)="1.      PSPO #1648 - The BCMA Medication Administration History Report "
^DIC(9.4,177,22,3,"PAH",44,1,4,0)="(MAH) does not line up the action taken on a medication with the "
^DIC(9.4,177,22,3,"PAH",44,1,5,0)="scheduled time of that administration."
^DIC(9.4,177,22,3,"PAH",44,1,6,0)="2.     The BCMA MAH displays active medications on hold when an order is "
^DIC(9.4,177,22,3,"PAH",44,1,7,0)="placed on Provider Hold, an additional action is taken in Inpatient Meds,"
^DIC(9.4,177,22,3,"PAH",44,1,8,0)="and then the order taken off provider hold."
^DIC(9.4,177,22,3,"PAH",44,1,9,0)="3.      When an order is created with a start date of today and a first"
^DIC(9.4,177,22,3,"PAH",44,1,10,0)="Scheduled administration time of tomorrow, the BCMA MAH shows"
^DIC(9.4,177,22,3,"PAH",44,1,11,0)="a medication as scheduled to be given today."
^DIC(9.4,177,22,3,"PAH",45,0)="63 SEQ #46^3111004.173301^17"
^DIC(9.4,177,22,3,"PAH",45,1,0)="^^12^12^3111004"
^DIC(9.4,177,22,3,"PAH",45,1,1,0)="This Patch Addresses 2 issues:"
^DIC(9.4,177,22,3,"PAH",45,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",45,1,3,0)="1.     When a user logs into BCMA and their device time is exactly "
^DIC(9.4,177,22,3,"PAH",45,1,4,0)="midnight, VistA will add the value of $H to the current time to "
^DIC(9.4,177,22,3,"PAH",45,1,5,0)="get the BCMA server time.  This server time will be greater than "
^DIC(9.4,177,22,3,"PAH",45,1,6,0)="the highest allowable Fileman date, which is October 15, 2114.  "
^DIC(9.4,177,22,3,"PAH",45,1,7,0)="If the BCMA Due List Report is run with the invalid default server "
^DIC(9.4,177,22,3,"PAH",45,1,8,0)="time, an infinite loop will be creating, eventually causing a ""Disk Full"""
^DIC(9.4,177,22,3,"PAH",45,1,9,0)="error."
^DIC(9.4,177,22,3,"PAH",45,1,10,0)="2.     A schedule with a frequency of greater than 1440 minutes "
^DIC(9.4,177,22,3,"PAH",45,1,11,0)="(24 hours) and a start date after today does not display as a Future"
^DIC(9.4,177,22,3,"PAH",45,1,12,0)="Order on the BCMA Due List Report. "
^DIC(9.4,177,22,3,"PAH",46,0)="60 SEQ #47^3111122.130329^17"
^DIC(9.4,177,22,3,"PAH",46,1,0)="^^10^10^3111122"
^DIC(9.4,177,22,3,"PAH",46,1,1,0)="This Patch Addresses 3 issues:"
^DIC(9.4,177,22,3,"PAH",46,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",46,1,3,0)="1.     The  error ""<SUBSCRIPT>ADM+3^PSBCSUTX"" occurs"
^DIC(9.4,177,22,3,"PAH",46,1,4,0)="when selecting the BCMA Coversheet tab if the patient"
^DIC(9.4,177,22,3,"PAH",46,1,5,0)="only has an IV Order and no Unit Dose Orders."
^DIC(9.4,177,22,3,"PAH",46,1,6,0)="2.     The BCMA Medication Variance Report does not paginate"
^DIC(9.4,177,22,3,"PAH",46,1,7,0)="correctly."
^DIC(9.4,177,22,3,"PAH",46,1,8,0)="3.     The BCMA Medication Variance Report displays a variance"
^DIC(9.4,177,22,3,"PAH",46,1,9,0)="when a patch is removed, even if the patch was given on"
^DIC(9.4,177,22,3,"PAH",46,1,10,0)="time."
^DIC(9.4,177,22,3,"PAH",47,0)="52 SEQ #48^3111213.152053^17"
^DIC(9.4,177,22,3,"PAH",47,1,0)="^^10^10^3111213"
^DIC(9.4,177,22,3,"PAH",47,1,1,0)="This Patch Addresses 3 issues:"
^DIC(9.4,177,22,3,"PAH",47,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",47,1,3,0)="1.     An error occurs when running the BCMA Unable to Scan Detailed "
^DIC(9.4,177,22,3,"PAH",47,1,4,0)="       report, causing BCMA to shut down."
^DIC(9.4,177,22,3,"PAH",47,1,5,0)="2.     The Missed Medications Report is displaying invalid Start and"
^DIC(9.4,177,22,3,"PAH",47,1,6,0)="       Stop Date and Date/Times for One Time orders."
^DIC(9.4,177,22,3,"PAH",47,1,7,0)="3.     The Missed Medications Report is displaying an invalid comment and"
^DIC(9.4,177,22,3,"PAH",47,1,8,0)="       status for a given medication."
^DIC(9.4,177,22,3,"PAH",47,1,9,0)="4.     The BCMA ""Filing Transaction MEDPASS"" error message does not "
^DIC(9.4,177,22,3,"PAH",47,1,10,0)="       indicate what is causing the error."
^DIC(9.4,177,22,3,"PAH",48,0)="58 SEQ #49^3120130.10431^17"
^DIC(9.4,177,22,3,"PAH",48,1,0)="^^35^35^3120130"
^DIC(9.4,177,22,3,"PAH",48,1,1,0)="ATTENTION: This patch includes a new Graphical User Interface (GUI) "
^DIC(9.4,177,22,3,"PAH",48,1,2,0)="executable file. Installation of this GUI is required immediately after "
^DIC(9.4,177,22,3,"PAH",48,1,3,0)="the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",48,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,5,0)="For retrieval and installation instructions, please see the Client"
^DIC(9.4,177,22,3,"PAH",48,1,6,0)="Installation Instructions section."
^DIC(9.4,177,22,3,"PAH",48,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,8,0)="The Allergy and Alerts Project addresses enhancements identified during "
^DIC(9.4,177,22,3,"PAH",48,1,9,0)="Inpatient Medications Requirementxs for Special Focus Group Initial "
^DIC(9.4,177,22,3,"PAH",48,1,10,0)="Request Analysis (IMR SFG IRA) Phase III/Phase IV, as well as "
^DIC(9.4,177,22,3,"PAH",48,1,11,0)="modifications requested by the BCMA and Inpatient Medications "
^DIC(9.4,177,22,3,"PAH",48,1,12,0)="workgroups.  The Inpatient Pharmacy patch PSJ*5*153 is also being "
^DIC(9.4,177,22,3,"PAH",48,1,13,0)="released as part of these enhancements.  "
^DIC(9.4,177,22,3,"PAH",48,1,14,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,15,0)="1. In order to allow facilities to select a timeframe that better matches"
^DIC(9.4,177,22,3,"PAH",48,1,16,0)="   their site policies, the site parameter that sets the amount of time"
^DIC(9.4,177,22,3,"PAH",48,1,17,0)="   that nurses have to document the PRN Effectiveness assessment is being"
^DIC(9.4,177,22,3,"PAH",48,1,18,0)="   expanded from 240 to 960 minutes."
^DIC(9.4,177,22,3,"PAH",48,1,19,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,20,0)="2. A new site parameter was added to the PARAMETERS file (#8989.5) & "
^DIC(9.4,177,22,3,"PAH",48,1,21,0)="   PARAMETERS DEFINTION file (#8989.51) to allow sites to prohibit "
^DIC(9.4,177,22,3,"PAH",48,1,22,0)="   administration of non-nurse verified medication orders, or to display a"
^DIC(9.4,177,22,3,"PAH",48,1,23,0)="   warning before administering non-nurse verified medication orders. "
^DIC(9.4,177,22,3,"PAH",48,1,24,0)="   Facilities will be able to set this option by division. "
^DIC(9.4,177,22,3,"PAH",48,1,25,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,26,0)="3. The Missed Medications report will now include a ""Verified"" column that"
^DIC(9.4,177,22,3,"PAH",48,1,27,0)="   will contain the initials of the nurse who verified the order, or three"
^DIC(9.4,177,22,3,"PAH",48,1,28,0)="   asterisks, indicating that the order was not nurse verified."
^DIC(9.4,177,22,3,"PAH",48,1,29,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,30,0)="4. A visual indicator will be displayed on the BCMA Virtual Due List (VDL)"
^DIC(9.4,177,22,3,"PAH",48,1,31,0)="   which will reflect whether an order has provider override reasons"
^DIC(9.4,177,22,3,"PAH",48,1,32,0)="   associated with the order. "
^DIC(9.4,177,22,3,"PAH",48,1,33,0)=" "
^DIC(9.4,177,22,3,"PAH",48,1,34,0)="5. If the override information exists for an order, it will also be"
^DIC(9.4,177,22,3,"PAH",48,1,35,0)="   displayed on the order detail report."
^DIC(9.4,177,22,3,"PAH",49,0)="61 SEQ #50^3120829.103841^17"
^DIC(9.4,177,22,3,"PAH",49,1,0)="^^14^14^3120829"
^DIC(9.4,177,22,3,"PAH",49,1,1,0)="This Patch Addresses 4 issues:"
^DIC(9.4,177,22,3,"PAH",49,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",49,1,3,0)="1.  The PSB BAG DETAIL RPC is returning duplicate entries for"
^DIC(9.4,177,22,3,"PAH",49,1,4,0)="a single action, causing the action to be displayed twice in"
^DIC(9.4,177,22,3,"PAH",49,1,5,0)="the Details section of the BCMA IV Tab."
^DIC(9.4,177,22,3,"PAH",49,1,6,0)="2.  The message ""Error @ -100"" is seen in Details section "
^DIC(9.4,177,22,3,"PAH",49,1,7,0)="on the BCMA IV Tab if a site has the optional AU05 cross "
^DIC(9.4,177,22,3,"PAH",49,1,8,0)="reference turned on."
^DIC(9.4,177,22,3,"PAH",49,1,9,0)="3.  The Units Given fields on the PRN Effectiveness Log and "
^DIC(9.4,177,22,3,"PAH",49,1,10,0)="the BCMA Medication Log forms omit the leading zero if the Units"
^DIC(9.4,177,22,3,"PAH",49,1,11,0)="Given field value is a decimal less than one."
^DIC(9.4,177,22,3,"PAH",49,1,12,0)="4.  PSPO #2015 - BCMA is accepting ""Spacebar"" as a valid"
^DIC(9.4,177,22,3,"PAH",49,1,13,0)="input for scanning a Drug IEN and returning the last"
^DIC(9.4,177,22,3,"PAH",49,1,14,0)="medication the BCMA User Scanned."
^DIC(9.4,177,22,3,"PAH",50,0)="48^3120829.111102^17"
^DIC(9.4,177,22,3,"PAH",50,1,0)="^^20^20^3120829"
^DIC(9.4,177,22,3,"PAH",50,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,177,22,3,"PAH",50,1,2,0)="1. Future medication orders display on the Bar Code Medication"
^DIC(9.4,177,22,3,"PAH",50,1,3,0)="   Administration Backup System (BCBU) Medication Administration Record "
^DIC(9.4,177,22,3,"PAH",50,1,4,0)="   (MAR) as current. An asterisk should be displaying in the"
^DIC(9.4,177,22,3,"PAH",50,1,5,0)="   administration time fields until the actual start dates have"
^DIC(9.4,177,22,3,"PAH",50,1,6,0)="   been reached. "
^DIC(9.4,177,22,3,"PAH",50,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",50,1,8,0)="2. Held medications are currently being displayed on the BCBU MAR option "
^DIC(9.4,177,22,3,"PAH",50,1,9,0)="   Print MAR for a Selected Patient. Held medications should not be"
^DIC(9.4,177,22,3,"PAH",50,1,10,0)="   displayed on the BCBU MAR report. PSPO# 1613"
^DIC(9.4,177,22,3,"PAH",50,1,11,0)=" "
^DIC(9.4,177,22,3,"PAH",50,1,12,0)="3. A prompt and help message in VistA under the BCMA Backup System "
^DIC(9.4,177,22,3,"PAH",50,1,13,0)="   [PSB BCBU WRKSTN MAIN] option is currently not displaying properly"
^DIC(9.4,177,22,3,"PAH",50,1,14,0)="   or consistently among the following three BCBU MAR print options "
^DIC(9.4,177,22,3,"PAH",50,1,15,0)="   Print MAR for All Wards, Print MAR for Selected Patient, and Print MAR "
^DIC(9.4,177,22,3,"PAH",50,1,16,0)="   for Selected Ward."
^DIC(9.4,177,22,3,"PAH",50,1,17,0)=" "
^DIC(9.4,177,22,3,"PAH",50,1,18,0)="4. While using Room/Bed sort in the BCMA Backup System (Wrkstn) option "
^DIC(9.4,177,22,3,"PAH",50,1,19,0)="   Print MAR for Selected Ward, the system produces an error if a patient"
^DIC(9.4,177,22,3,"PAH",50,1,20,0)="   has no Room or Bed assigned."
^DIC(9.4,177,22,3,"PAH",51,0)="67 SEQ #53^3120829.113308^17"
^DIC(9.4,177,22,3,"PAH",51,1,0)="^^12^12^3120829"
^DIC(9.4,177,22,3,"PAH",51,1,1,0)="This Patch Addresses 3 issues:"
^DIC(9.4,177,22,3,"PAH",51,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",51,1,3,0)="1.     PSPO 2134 - A Given dose does not display on the BCMA "
^DIC(9.4,177,22,3,"PAH",51,1,4,0)="Medication Administration History (MAH) report when another dose is"
^DIC(9.4,177,22,3,"PAH",51,1,5,0)="given for the same Administration time on the wrong day."
^DIC(9.4,177,22,3,"PAH",51,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",51,1,7,0)="2.     A given dose of an IVPB will not display on the BCMA MAH report"
^DIC(9.4,177,22,3,"PAH",51,1,8,0)="if the time given is edited to a time prior to the original given time"
^DIC(9.4,177,22,3,"PAH",51,1,9,0)="of the medication."
^DIC(9.4,177,22,3,"PAH",51,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",51,1,11,0)="3.     The BCMA MAH displays all meds as not due until the day after"
^DIC(9.4,177,22,3,"PAH",51,1,12,0)="the start date."
^DIC(9.4,177,22,3,"PAH",52,0)="62 SEQ #54^3120829.122815^17"
^DIC(9.4,177,22,3,"PAH",52,1,0)="^^9^9^3120829"
^DIC(9.4,177,22,3,"PAH",52,1,1,0)="This Patch Addresses 2 issues:"
^DIC(9.4,177,22,3,"PAH",52,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",52,1,3,0)="1.  The BCMA Missed Medications Report may be inconsistent"
^DIC(9.4,177,22,3,"PAH",52,1,4,0)="    when run for a whole day versus incremental times if"
^DIC(9.4,177,22,3,"PAH",52,1,5,0)="    the order's Administration Times are edited."
^DIC(9.4,177,22,3,"PAH",52,1,6,0)="2.  The Initials of the Nurse who marked an IV Bag infusing"
^DIC(9.4,177,22,3,"PAH",52,1,7,0)="    do not display in the Legend of the BCMA IV Overview"
^DIC(9.4,177,22,3,"PAH",52,1,8,0)="    Coversheet report when a different Nurse marks the bag"
^DIC(9.4,177,22,3,"PAH",52,1,9,0)="    Stopped or Completed."
^DIC(9.4,177,22,3,"PAH",53,0)="68 SEQ #55^3120912.162627^17"
^DIC(9.4,177,22,3,"PAH",53,1,0)="^^95^95^3120912"
^DIC(9.4,177,22,3,"PAH",53,1,1,0)="*************************************************************************"
^DIC(9.4,177,22,3,"PAH",53,1,2,0)=" IMPORTANT: PATCH PSJ*5*267 MUST BE INSTALLED BEFORE THE INSTALLATION "
^DIC(9.4,177,22,3,"PAH",53,1,3,0)="            OF THIS PATCH."
^DIC(9.4,177,22,3,"PAH",53,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,5,0)=" BCMA patch PSB*3*68 contains changes that will not function until patch "
^DIC(9.4,177,22,3,"PAH",53,1,6,0)=" PSJ*5*267 is installed. Both patches, PSJ*5*267 and PSB*3*68 need to be"
^DIC(9.4,177,22,3,"PAH",53,1,7,0)=" installed for Inpatient Medications and BCMA to function correctly."
^DIC(9.4,177,22,3,"PAH",53,1,8,0)="*************************************************************************"
^DIC(9.4,177,22,3,"PAH",53,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,10,0)="ATTENTION: This patch includes a new Graphical User Interface (GUI) "
^DIC(9.4,177,22,3,"PAH",53,1,11,0)="executable file. Installation of this GUI is required immediately after "
^DIC(9.4,177,22,3,"PAH",53,1,12,0)="the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",53,1,13,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,14,0)="This version of BCMA was successfully tested in the field against Wireless"
^DIC(9.4,177,22,3,"PAH",53,1,15,0)="Medication Administration version 4.8 at Pittsburgh and Loma Linda."
^DIC(9.4,177,22,3,"PAH",53,1,16,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,17,0)="For retrieval and installation instructions, please see the Client"
^DIC(9.4,177,22,3,"PAH",53,1,18,0)="Installation Instructions section."
^DIC(9.4,177,22,3,"PAH",53,1,19,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,20,0)="The Special Instructions and Other Print Info Project addresses "
^DIC(9.4,177,22,3,"PAH",53,1,21,0)="enhancements identified during Inpatient Medications Requirements for "
^DIC(9.4,177,22,3,"PAH",53,1,22,0)="Special Focus Group Initial Request Analysis (IMR SFG IRA) Phase "
^DIC(9.4,177,22,3,"PAH",53,1,23,0)="III/Phase IV, as well as modifications requested by the Bar Code"
^DIC(9.4,177,22,3,"PAH",53,1,24,0)="Medication Administration (BCMA) and Inpatient Medications workgroups.  "
^DIC(9.4,177,22,3,"PAH",53,1,25,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,26,0)="The Inpatient Pharmacy patch PSJ*5*267 is also being released as part of"
^DIC(9.4,177,22,3,"PAH",53,1,27,0)="these enhancements.  The projects purpose is to Standardize the character"
^DIC(9.4,177,22,3,"PAH",53,1,28,0)="length between CPRS Provider's Comment, Inpatient Medications Special"
^DIC(9.4,177,22,3,"PAH",53,1,29,0)="Instructions, and the IV Pharmacy Other Print Information fields."
^DIC(9.4,177,22,3,"PAH",53,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,31,0)="The Inpatient Pharmacy patch PSJ*5*267 will add new fields to Inpatient "
^DIC(9.4,177,22,3,"PAH",53,1,32,0)="Medication to support an unlimited amount of text for Special "
^DIC(9.4,177,22,3,"PAH",53,1,33,0)="Instructions and Other Print Info (SI/OPI). "
^DIC(9.4,177,22,3,"PAH",53,1,34,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,35,0)="1. BCMA Remote Procedure Calls (RPC) will be modified to send over the new"
^DIC(9.4,177,22,3,"PAH",53,1,36,0)="   Inpatient Medications SI/OPI fields in an unlimited format to the BCMA"
^DIC(9.4,177,22,3,"PAH",53,1,37,0)="   GUI client."
^DIC(9.4,177,22,3,"PAH",53,1,38,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,39,0)="2. For backwards compatibility, of existing Active orders on file that"
^DIC(9.4,177,22,3,"PAH",53,1,40,0)="   were using the old fixed length SI/OPI fields, then this information "
^DIC(9.4,177,22,3,"PAH",53,1,41,0)="   will be included in the new unlimited format also."
^DIC(9.4,177,22,3,"PAH",53,1,42,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,43,0)="3. Modify the following reports to print the unlimited SI/OPI information:"
^DIC(9.4,177,22,3,"PAH",53,1,44,0)="    a. Medication Administration History (MAH) Report"
^DIC(9.4,177,22,3,"PAH",53,1,45,0)="    b. Display Order detail Report"
^DIC(9.4,177,22,3,"PAH",53,1,46,0)="    c. Due List Report"
^DIC(9.4,177,22,3,"PAH",53,1,47,0)="    d. IV Bag Status Report"
^DIC(9.4,177,22,3,"PAH",53,1,48,0)="    e. Cover Sheet Report - Medication Overview Report"
^DIC(9.4,177,22,3,"PAH",53,1,49,0)="    f. Cover Sheet Report - PRN Overview Report"
^DIC(9.4,177,22,3,"PAH",53,1,50,0)="    g. Cover Sheet Report - IV Overview Report"
^DIC(9.4,177,22,3,"PAH",53,1,51,0)="    h. Cover Sheet Report - Expired/DC'd/Expiring Report"
^DIC(9.4,177,22,3,"PAH",53,1,52,0)="    i. BCMA Backup System (BCBU) Print MAR for All Wards"
^DIC(9.4,177,22,3,"PAH",53,1,53,0)="    j. BCMA Backup System (BCBU) Print MAR for Selected Patient"
^DIC(9.4,177,22,3,"PAH",53,1,54,0)="    k. BCMA Backup System (BCBU) Print MAR for Selected Ward"
^DIC(9.4,177,22,3,"PAH",53,1,55,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,56,0)="4. Add new check box field to allow if the unlimited text will be printed"
^DIC(9.4,177,22,3,"PAH",53,1,57,0)="   on the following reports:"
^DIC(9.4,177,22,3,"PAH",53,1,58,0)="    a. Due List Report"
^DIC(9.4,177,22,3,"PAH",53,1,59,0)="    b. IV Bag Status Report"
^DIC(9.4,177,22,3,"PAH",53,1,60,0)="    c. Cover Sheet Report - Medication Overview Report"
^DIC(9.4,177,22,3,"PAH",53,1,61,0)="    d. Cover Sheet Report - PRN Overview Report"
^DIC(9.4,177,22,3,"PAH",53,1,62,0)="    e. Cover Sheet Report - IV Overview Report"
^DIC(9.4,177,22,3,"PAH",53,1,63,0)="    f. Cover Sheet Report - Expired/DC'd/Expiring Report"
^DIC(9.4,177,22,3,"PAH",53,1,64,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,65,0)="5. BCMA Client:"
^DIC(9.4,177,22,3,"PAH",53,1,66,0)="    a. Added window to display unlimited Special Instructions / Other"
^DIC(9.4,177,22,3,"PAH",53,1,67,0)="       Print Info via menu, right-click, and function key (F6).  This"
^DIC(9.4,177,22,3,"PAH",53,1,68,0)="       window is also used to display Special Instructions / Other Print"
^DIC(9.4,177,22,3,"PAH",53,1,69,0)="       Info when an order is flagged in Inpatient Medications and is given"
^DIC(9.4,177,22,3,"PAH",53,1,70,0)="       in BCMA."
^DIC(9.4,177,22,3,"PAH",53,1,71,0)="    b. Fields which displayed Special Instructions / Other Print Info in"
^DIC(9.4,177,22,3,"PAH",53,1,72,0)="       forms were widened to 80 characters and have vertical scroll."
^DIC(9.4,177,22,3,"PAH",53,1,73,0)="    c. Added Last Injections Site column to the Unit Dose VDL to show the "
^DIC(9.4,177,22,3,"PAH",53,1,74,0)="       what the last site was per Orderable item."
^DIC(9.4,177,22,3,"PAH",53,1,75,0)="    d. Enhanced the Injection Site dialog window to show two "
^DIC(9.4,177,22,3,"PAH",53,1,76,0)="       history tables."
^DIC(9.4,177,22,3,"PAH",53,1,77,0)="          1) To show the last 4 sites per the medication being given."
^DIC(9.4,177,22,3,"PAH",53,1,78,0)="          2) To show last 10 sites per the patient for any medication."
^DIC(9.4,177,22,3,"PAH",53,1,79,0)="      The tables above will use a new Division parameter, ""Injection Site "
^DIC(9.4,177,22,3,"PAH",53,1,80,0)="      History Max Hours"", added with this patch that controls how many"
^DIC(9.4,177,22,3,"PAH",53,1,81,0)="      hours to look back when compiling these history tables.  The default"
^DIC(9.4,177,22,3,"PAH",53,1,82,0)="      will be initialized to 72 hours, with this patch."
^DIC(9.4,177,22,3,"PAH",53,1,83,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,84,0)="This Patch also Addresses 3 reported Remedy ticket issues:"
^DIC(9.4,177,22,3,"PAH",53,1,85,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,86,0)="1. After scanning a medication that requires multiple doses"
^DIC(9.4,177,22,3,"PAH",53,1,87,0)="   or dosage strengths, the multiple dose dialog box's "
^DIC(9.4,177,22,3,"PAH",53,1,88,0)="   invalid medication pop-up functionality appears to be broken."
^DIC(9.4,177,22,3,"PAH",53,1,89,0)="2. Unable to view all allergies/ADRs on BCMA GUI for patient with"
^DIC(9.4,177,22,3,"PAH",53,1,90,0)="   numerous allergies/ADRs."
^DIC(9.4,177,22,3,"PAH",53,1,91,0)="3. The Patient Record Flag changes from Red to Black if you lock"
^DIC(9.4,177,22,3,"PAH",53,1,92,0)="   your computer. "
^DIC(9.4,177,22,3,"PAH",53,1,93,0)=" "
^DIC(9.4,177,22,3,"PAH",53,1,94,0)="Please refer to the release notes for a full detailed list and examples "
^DIC(9.4,177,22,3,"PAH",53,1,95,0)="of items included in this patch."
^DIC(9.4,177,22,3,"PAH",54,0)="69^3120912.162655^17"
^DIC(9.4,177,22,3,"PAH",54,1,0)="^^30^30^3120912"
^DIC(9.4,177,22,3,"PAH",54,1,1,0)="***********************************************************************"
^DIC(9.4,177,22,3,"PAH",54,1,2,0)="IMPORTANT: PATCH PSJ*5*267 MUST BE INSTALLED IMMEDIATELY BEFORE"
^DIC(9.4,177,22,3,"PAH",54,1,3,0)="INSTALLATION OF THIS PATCH."
^DIC(9.4,177,22,3,"PAH",54,1,4,0)=" "
^DIC(9.4,177,22,3,"PAH",54,1,5,0)=" If the site is running the BCMA Contingency software then this patch"
^DIC(9.4,177,22,3,"PAH",54,1,6,0)=" must also be installed on the workstations. Once installed it is "
^DIC(9.4,177,22,3,"PAH",54,1,7,0)=" suggested that the sites review the Contingency system MAR reports."
^DIC(9.4,177,22,3,"PAH",54,1,8,0)="***********************************************************************"
^DIC(9.4,177,22,3,"PAH",54,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",54,1,10,0)="The Special Instructions and Other Print Info Project addresses "
^DIC(9.4,177,22,3,"PAH",54,1,11,0)="enhancements identified during Inpatient Medications Requirements for "
^DIC(9.4,177,22,3,"PAH",54,1,12,0)="Special Focus Group Initial Request Analysis (IMR SFG IRA) Phase "
^DIC(9.4,177,22,3,"PAH",54,1,13,0)="III/Phase IV, as well as modifications requested by the Bar Code"
^DIC(9.4,177,22,3,"PAH",54,1,14,0)="Medication Administration (BCMA) and Inpatient Medications workgroups.  "
^DIC(9.4,177,22,3,"PAH",54,1,15,0)=" "
^DIC(9.4,177,22,3,"PAH",54,1,16,0)="The Inpatient Pharmacy patch PSJ*5*267 is also being released as part of"
^DIC(9.4,177,22,3,"PAH",54,1,17,0)="these enhancements.  The projects purpose is to Standardize the character"
^DIC(9.4,177,22,3,"PAH",54,1,18,0)="length between CPRS Provider's Comment, Inpatient Medications Special"
^DIC(9.4,177,22,3,"PAH",54,1,19,0)="Instructions, and the IV Pharmacy Other Print Information fields."
^DIC(9.4,177,22,3,"PAH",54,1,20,0)=" "
^DIC(9.4,177,22,3,"PAH",54,1,21,0)="The Inpatient Pharmacy patch PSJ*5*267 will add new fields to Inpatient "
^DIC(9.4,177,22,3,"PAH",54,1,22,0)="Medication to support an unlimited amount of text for Special "
^DIC(9.4,177,22,3,"PAH",54,1,23,0)="Instructions and Other Print Info (SI/OPI)."
^DIC(9.4,177,22,3,"PAH",54,1,24,0)=" "
^DIC(9.4,177,22,3,"PAH",54,1,25,0)="The enhacnement in this patch will support the new unlimited lines of "
^DIC(9.4,177,22,3,"PAH",54,1,26,0)="text that will now be sent by Inpatient Medications to the BCMA"
^DIC(9.4,177,22,3,"PAH",54,1,27,0)="Contingency software workstations, in the HL7 NTE|21 segement."
^DIC(9.4,177,22,3,"PAH",54,1,28,0)=" "
^DIC(9.4,177,22,3,"PAH",54,1,29,0)="Please refer to the release notes for a full detailed list and examples "
^DIC(9.4,177,22,3,"PAH",54,1,30,0)="of items included in this patch."
^DIC(9.4,177,22,3,"PAH",55,0)="66 SEQ #57^3130225.115503^17"
^DIC(9.4,177,22,3,"PAH",55,1,0)="^^7^7^3130225"
^DIC(9.4,177,22,3,"PAH",55,1,1,0)=" This Patch Addresses 2 issues:"
^DIC(9.4,177,22,3,"PAH",55,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",55,1,3,0)="1. PSPO 2012 - IV Bag Parameters are not defined for an Institution"
^DIC(9.4,177,22,3,"PAH",55,1,4,0)="   which contains active wards."
^DIC(9.4,177,22,3,"PAH",55,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",55,1,6,0)="2. After Multiple edits of solutions, invalid IV bags in BCMA may be"
^DIC(9.4,177,22,3,"PAH",55,1,7,0)="   administered."
^DIC(9.4,177,22,3,"PAH",56,0)="64 SEQ #58^3130626.171246^17"
^DIC(9.4,177,22,3,"PAH",56,1,0)="^^10^10^3130626"
^DIC(9.4,177,22,3,"PAH",56,1,1,0)="This Patch Addresses 3 issues:"
^DIC(9.4,177,22,3,"PAH",56,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",56,1,3,0)="1.  An order with an Unknown Action status is unavailable"
^DIC(9.4,177,22,3,"PAH",56,1,4,0)="    when using the Edit Med Log option if another user runs"
^DIC(9.4,177,22,3,"PAH",56,1,5,0)="    the BCMA Medication Administration History (MAH) report."
^DIC(9.4,177,22,3,"PAH",56,1,6,0)="2.  A fatal error occurs when using the Unable to Scan function"
^DIC(9.4,177,22,3,"PAH",56,1,7,0)="    in BCMA and then scanning another medication. "
^DIC(9.4,177,22,3,"PAH",56,1,8,0)="3.  A fatal error occurs when clicking on the BCMA Coversheet if "
^DIC(9.4,177,22,3,"PAH",56,1,9,0)="    a patient's only current order is an IV Piggyback which has a "
^DIC(9.4,177,22,3,"PAH",56,1,10,0)="    day of the week schedule."
^DIC(9.4,177,22,3,"PAH",57,0)="74 SEQ #59^3130710.161555^17"
^DIC(9.4,177,22,3,"PAH",57,1,0)="^^9^9^3130710"
^DIC(9.4,177,22,3,"PAH",57,1,1,0)="This Patch Addresses 3 issues:"
^DIC(9.4,177,22,3,"PAH",57,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",57,1,3,0)="1.  A broker error occurs when attempting to open BCMA (Bar Code"
^DIC(9.4,177,22,3,"PAH",57,1,4,0)="    Medication Administration) for a patient who has and Intravenous"
^DIC(9.4,177,22,3,"PAH",57,1,5,0)="    Piggyback (IVPB) medication with an unknown Action Status. "
^DIC(9.4,177,22,3,"PAH",57,1,6,0)="2.  The header on several reports do not delineate a patient's room"
^DIC(9.4,177,22,3,"PAH",57,1,7,0)="    number with a colon."
^DIC(9.4,177,22,3,"PAH",57,1,8,0)="3.  The BCMA Missed Medications Report does not contain meds that"
^DIC(9.4,177,22,3,"PAH",57,1,9,0)="    are held or refused when run in VistA."
^DIC(9.4,177,22,3,"PAH",58,0)="54 SEQ #60^3131105.160031^17"
^DIC(9.4,177,22,3,"PAH",58,1,0)="^^11^11^3131105"
^DIC(9.4,177,22,3,"PAH",58,1,1,0)="This Patch Addresses 2 issues:"
^DIC(9.4,177,22,3,"PAH",58,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",58,1,3,0)="1.     An Undefined error occurs at LINE+13^PSBOML when the "
^DIC(9.4,177,22,3,"PAH",58,1,4,0)="       BCMA Med Log report is run and finds a BCMA MED LOG "
^DIC(9.4,177,22,3,"PAH",58,1,5,0)="       (#53.79) entry without a corresponding PHARMACY PATIENT (#55)"
^DIC(9.4,177,22,3,"PAH",58,1,6,0)="       entry."
^DIC(9.4,177,22,3,"PAH",58,1,7,0)="2.     When giving an IV via the Unable to Scan feature, the user will"
^DIC(9.4,177,22,3,"PAH",58,1,8,0)="       receive a ""Incomplete Data Returned from Vista"" pop up box if the"
^DIC(9.4,177,22,3,"PAH",58,1,9,0)="       data attempting to be stored in the ORDERABLE ITEM (#15) field of"
^DIC(9.4,177,22,3,"PAH",58,1,10,0)="       the BCMA UNABLE TO SCAN LOG (#53.77) file is greater than 40"
^DIC(9.4,177,22,3,"PAH",58,1,11,0)="       characters."
^DIC(9.4,177,22,3,"PAH",59,0)="59^3131125.121039^17"
^DIC(9.4,177,22,3,"PAH",59,1,0)="^^2^2^3131125"
^DIC(9.4,177,22,3,"PAH",59,1,1,0)=" Please see the National Patch Module for details of the changes"
^DIC(9.4,177,22,3,"PAH",59,1,2,0)=" included in this patch."
^DIC(9.4,177,22,3,"PAH",60,0)="70 SEQ #62^3131212.141234^17"
^DIC(9.4,177,22,3,"PAH",60,1,0)="^^1^1^3131212"
^DIC(9.4,177,22,3,"PAH",60,1,1,0)="Clinic Order and Witness for High Risk / High Alert drugs."
^DIC(9.4,177,22,3,"PAH",61,0)="75 SEQ #63^3140114.151832^17"
^DIC(9.4,177,22,3,"PAH",61,1,0)="^^12^12^3140114"
^DIC(9.4,177,22,3,"PAH",61,1,1,0)="This Patch Addresses 2 issues."
^DIC(9.4,177,22,3,"PAH",61,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",61,1,3,0)="1.  When the INFUSION RATE field (#.08) in the PHARMACY PATIENT IV subfile"
^DIC(9.4,177,22,3,"PAH",61,1,4,0)="    (#55.01) is greater than 27 characters (30 character max) for an "
^DIC(9.4,177,22,3,"PAH",61,1,5,0)="    Intravenous Piggyback (IVPB) order, the text added by the software "
^DIC(9.4,177,22,3,"PAH",61,1,6,0)="    will cause the infusion rate to exceed the 47 character maximum"
^DIC(9.4,177,22,3,"PAH",61,1,7,0)="    in BCMA."
^DIC(9.4,177,22,3,"PAH",61,1,8,0)=" "
^DIC(9.4,177,22,3,"PAH",61,1,9,0)="2.  An IVPB order with a SCHEDULE (#.09) and a STATUS (#100) of ""On Call"" "
^DIC(9.4,177,22,3,"PAH",61,1,10,0)="    in the PHARMACY PATIENT IV subfile (#55.01) cannot be marked"
^DIC(9.4,177,22,3,"PAH",61,1,11,0)="    as given using the Manual Medication Entry [PSB MED LOG NEW ENTRY] "
^DIC(9.4,177,22,3,"PAH",61,1,12,0)="    option."
^DIC(9.4,177,22,3,"PAH",62,0)="73^3140121.154258^17"
^DIC(9.4,177,22,3,"PAH",62,1,0)="^^1^1^3140121"
^DIC(9.4,177,22,3,"PAH",62,1,1,0)="IMR6 CLINIC ORDER ENHANCEMENT FOR BCBU"
^DIC(9.4,177,22,3,"PAH",63,0)="78 SEQ #65^3140306.13465^17"
^DIC(9.4,177,22,3,"PAH",63,1,0)="^^10^10^3140306"
^DIC(9.4,177,22,3,"PAH",63,1,1,0)="This Patch Addresses 2 issues:"
^DIC(9.4,177,22,3,"PAH",63,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",63,1,3,0)="1. An order will not display on the Bar Code Medication"
^DIC(9.4,177,22,3,"PAH",63,1,4,0)="Administration (BCMA) Virtual Due List (VDL) properly "
^DIC(9.4,177,22,3,"PAH",63,1,5,0)="if the order has its first administration time not on the"
^DIC(9.4,177,22,3,"PAH",63,1,6,0)="hour and the start date and time are not exactly on the hour."
^DIC(9.4,177,22,3,"PAH",63,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",63,1,8,0)="2. The BCMA PRN Effectiveness Report and Medication"
^DIC(9.4,177,22,3,"PAH",63,1,9,0)="Variance Report do not display the ward name when"
^DIC(9.4,177,22,3,"PAH",63,1,10,0)="printed by ward."
^DIC(9.4,177,22,3,"PAH",64,0)="76 SEQ #66^3141210.114349^17"
^DIC(9.4,177,22,3,"PAH",64,1,0)="^^16^16^3141210"
^DIC(9.4,177,22,3,"PAH",64,1,1,0)="This Patch Addresses 6 issues:"
^DIC(9.4,177,22,3,"PAH",64,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",64,1,3,0)="1. The Bar Code Medication Administration (BCMA) Missed Medications"
^DIC(9.4,177,22,3,"PAH",64,1,4,0)="report does not include orders with a status of ""Renewed"" "
^DIC(9.4,177,22,3,"PAH",64,1,5,0)="2. BCMA incorrectly rounds a patient's height down on the BCMA Virtual"
^DIC(9.4,177,22,3,"PAH",64,1,6,0)="Due List (VDL) and on report headers, and incorrectly calculates a "
^DIC(9.4,177,22,3,"PAH",64,1,7,0)="patient's weight on report headers."
^DIC(9.4,177,22,3,"PAH",64,1,8,0)="3. Orders with a start time exactly the same as the last administration"
^DIC(9.4,177,22,3,"PAH",64,1,9,0)="time will display as not due in the BCMA Medication Administration "
^DIC(9.4,177,22,3,"PAH",64,1,10,0)="History (MAH) report."
^DIC(9.4,177,22,3,"PAH",64,1,11,0)="4. The undefined error <UNDEFINED>FILEIT+10^PSBML *PSBHDR occurs"
^DIC(9.4,177,22,3,"PAH",64,1,12,0)="when logging into BCMA."
^DIC(9.4,177,22,3,"PAH",64,1,13,0)="5. Immunizations given as Clinic orders in BCMA are not recorded in the "
^DIC(9.4,177,22,3,"PAH",64,1,14,0)="V IMMUNIZATIONS (#9000010.11) file."
^DIC(9.4,177,22,3,"PAH",64,1,15,0)="6. BCMA accepts a partial scan of a patient's SSN when scanning a "
^DIC(9.4,177,22,3,"PAH",64,1,16,0)="patient's wristband."
^DIC(9.4,177,22,3,"PAH",65,0)="81 SEQ #67^3150413.13211^17"
^DIC(9.4,177,22,3,"PAH",65,1,0)="^^17^17^3150413"
^DIC(9.4,177,22,3,"PAH",65,1,1,0)="This Patch Addresses 5 issues:"
^DIC(9.4,177,22,3,"PAH",65,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",65,1,3,0)="1. The Bar Code Medication Administration (BCMA) Medication History"
^DIC(9.4,177,22,3,"PAH",65,1,4,0)="report displays data prior to the report start date when run in the"
^DIC(9.4,177,22,3,"PAH",65,1,5,0)="Computerized Records System (CPRS) application.  "
^DIC(9.4,177,22,3,"PAH",65,1,6,0)="2. BCMA Labels for Unit dose drugs are missing the Indian Health "
^DIC(9.4,177,22,3,"PAH",65,1,7,0)="Services (HIS) Health Record Number (HRN) in place of Last 4 digits of a"
^DIC(9.4,177,22,3,"PAH",65,1,8,0)="patient's Social Security Number (SSN) as the patient Identifier."
^DIC(9.4,177,22,3,"PAH",65,1,9,0)="3. The BCMA Unknown Actions Report does not display IHS HRN in place"
^DIC(9.4,177,22,3,"PAH",65,1,10,0)="of Last 4 digits of a patient's Social Security Number (SSN) as the "
^DIC(9.4,177,22,3,"PAH",65,1,11,0)="patient identifier."
^DIC(9.4,177,22,3,"PAH",65,1,12,0)="4. A dangling ""AADT"" index causes an undefined error to occur when"
^DIC(9.4,177,22,3,"PAH",65,1,13,0)="a site runs the BCMA Extract (ECXBCM) option. "
^DIC(9.4,177,22,3,"PAH",65,1,14,0)="5. The Meds on Patient section of the BCMA Virtual Due List (VDL) "
^DIC(9.4,177,22,3,"PAH",65,1,15,0)="displays an Intravenous (IV) bag as infusing after it has been marked"
^DIC(9.4,177,22,3,"PAH",65,1,16,0)="completed if the Action Date/Time was edited using the Edit Med Log"
^DIC(9.4,177,22,3,"PAH",65,1,17,0)="option."
^DIC(9.4,177,22,3,"PAH",66,0)="72 SEQ #69^3150421.085039^17"
^DIC(9.4,177,22,3,"PAH",66,1,0)="^^18^18^3150421"
^DIC(9.4,177,22,3,"PAH",66,1,1,0)="This Patch Addresses 7 issues:"
^DIC(9.4,177,22,3,"PAH",66,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",66,1,3,0)="1. The Medication History report in Bar Code Medication "
^DIC(9.4,177,22,3,"PAH",66,1,4,0)="Administration (BCMA) displays amounts in the Units Given"
^DIC(9.4,177,22,3,"PAH",66,1,5,0)="field for an order that has not been given. "
^DIC(9.4,177,22,3,"PAH",66,1,6,0)="2. When a user makes a change to an order using the Edit Med Log"
^DIC(9.4,177,22,3,"PAH",66,1,7,0)="option which does not change the action status, several reports "
^DIC(9.4,177,22,3,"PAH",66,1,8,0)="display the initials of the person who edited the order instead of"
^DIC(9.4,177,22,3,"PAH",66,1,9,0)="who created the action on the order."
^DIC(9.4,177,22,3,"PAH",66,1,10,0)="3. The BCMA Medication Log and Medication Variance report headers"
^DIC(9.4,177,22,3,"PAH",66,1,11,0)="do not display the time frame of the report."
^DIC(9.4,177,22,3,"PAH",66,1,12,0)="4. The BCMA AUDIT LOG (#53.799) sub-file does not include an entry "
^DIC(9.4,177,22,3,"PAH",66,1,13,0)="for Pro Re Nada (PRN) Effectiveness when a PRN is ""Un-Given"""
^DIC(9.4,177,22,3,"PAH",66,1,14,0)="5. The Legend of the Medication Therapy report does not include users"
^DIC(9.4,177,22,3,"PAH",66,1,15,0)="who entered comments for an order."
^DIC(9.4,177,22,3,"PAH",66,1,16,0)="6. The 2nd line of routine PSBOPE has an invalid format."
^DIC(9.4,177,22,3,"PAH",66,1,17,0)="7. Update the unsupported $$UCASE^XUSG Application Programming "
^DIC(9.4,177,22,3,"PAH",66,1,18,0)="Interface (API) to the supported API $$UP^XLFSTR in routine PSBMLLKU."
^DIC(9.4,177,22,3,"PAH",67,0)="80 SEQ #70^3150423.084612^17"
^DIC(9.4,177,22,3,"PAH",67,1,0)="^^17^17^3150423"
^DIC(9.4,177,22,3,"PAH",67,1,1,0)="This Patch Addresses 6 issues:"
^DIC(9.4,177,22,3,"PAH",67,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",67,1,3,0)="1. The Bar Code Medication Administration (BCMA) MEDICATION"
^DIC(9.4,177,22,3,"PAH",67,1,4,0)="VARIANCE LOG (#53.78) file does not save data in DRUG SCANNED"
^DIC(9.4,177,22,3,"PAH",67,1,5,0)="(#.07) field."
^DIC(9.4,177,22,3,"PAH",67,1,6,0)="2. BCMA stores the initials of the user who viewed the patient's record"
^DIC(9.4,177,22,3,"PAH",67,1,7,0)="instead of the initials of the user who marked a Vital Entered in Error."
^DIC(9.4,177,22,3,"PAH",67,1,8,0)="3. The BCMA Unable to Scan Detailed report does not display any data"
^DIC(9.4,177,22,3,"PAH",67,1,9,0)="when run for a Nursing Ward if the user running the report is logged into "
^DIC(9.4,177,22,3,"PAH",67,1,10,0)="a different division. "
^DIC(9.4,177,22,3,"PAH",67,1,11,0)="4. The BCMA Administration Times report does not display historical"
^DIC(9.4,177,22,3,"PAH",67,1,12,0)="data when run by ward."
^DIC(9.4,177,22,3,"PAH",67,1,13,0)="5. The BCMA Clinical Reminders tab does not display that a PRN "
^DIC(9.4,177,22,3,"PAH",67,1,14,0)="Effectiveness is needed when the PRN is given on the same day as the "
^DIC(9.4,177,22,3,"PAH",67,1,15,0)="patient is admitted."
^DIC(9.4,177,22,3,"PAH",67,1,16,0)="6. The Unable to Scan detailed report does not display the full Health "
^DIC(9.4,177,22,3,"PAH",67,1,17,0)="Record Number (HRN) for Indian Health Services (IHS) sites."
^DIC(9.4,177,22,3,"PAH",68,0)="86 SEQ #71^3151102.135551^17"
^DIC(9.4,177,22,3,"PAH",68,1,0)="^^18^18^3151102"
^DIC(9.4,177,22,3,"PAH",68,1,1,0)="This Patch Addresses 7 issues:"
^DIC(9.4,177,22,3,"PAH",68,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",68,1,3,0)="1.  An Undefined error occurs at SCANPT+49^PSBRPC if an accent (`) mark is"
^DIC(9.4,177,22,3,"PAH",68,1,4,0)="    passed in when manually keying in a patient's wristband."
^DIC(9.4,177,22,3,"PAH",68,1,5,0)="2.  Bar Code Medication Administration (BCMA) report headers display the"
^DIC(9.4,177,22,3,"PAH",68,1,6,0)="    last ward and room/bed the patient was admitted to after they are "
^DIC(9.4,177,22,3,"PAH",68,1,7,0)="    discharged."
^DIC(9.4,177,22,3,"PAH",68,1,8,0)="3.  BCMA report headers and the BCMA Virtual Due List (VDL) round a"
^DIC(9.4,177,22,3,"PAH",68,1,9,0)="    patient's weight to less significant digits than the Computerized "
^DIC(9.4,177,22,3,"PAH",68,1,10,0)="    Record System (CPRS) application when converting weight from pounds"
^DIC(9.4,177,22,3,"PAH",68,1,11,0)="    to kilograms."
^DIC(9.4,177,22,3,"PAH",68,1,12,0)="4.  BCMA report headers display the diagnosis for a patient's last"
^DIC(9.4,177,22,3,"PAH",68,1,13,0)="    admission after the patient has been discharged. "
^DIC(9.4,177,22,3,"PAH",68,1,14,0)="5.  The BCMA Coversheet is loading slowly for long term care patients."
^DIC(9.4,177,22,3,"PAH",68,1,15,0)="6.  The Unit Dose tab of the BCMA VDL loads slowly for long term care"
^DIC(9.4,177,22,3,"PAH",68,1,16,0)="    patients."
^DIC(9.4,177,22,3,"PAH",68,1,17,0)="7.  The BCMA Medication Variance report displays the medication name twice"
^DIC(9.4,177,22,3,"PAH",68,1,18,0)="    under the medication field of the report"
^DIC(9.4,177,22,3,"PAH",69,0)="79^3160407.160228^54"
^DIC(9.4,177,22,3,"PAH",69,1,0)="^^1^1^3160407"
^DIC(9.4,177,22,3,"PAH",69,1,1,0)="See patch description for details."
^DIC(9.4,177,22,3,"PAH",70,0)="94 SEQ #74^3160510.154136^54"
^DIC(9.4,177,22,3,"PAH",71,0)="83 SEQ #75^3161220.144409^54"
^DIC(9.4,177,22,3,"PAH",71,1,0)="^^138^138^3161220"
^DIC(9.4,177,22,3,"PAH",71,1,1,0)="******************************* ATTENTION ********************************"
^DIC(9.4,177,22,3,"PAH",71,1,2,0)="  "
^DIC(9.4,177,22,3,"PAH",71,1,3,0)="Clinical Ancillary Services (CAS) Development-Delivery of Pharmacy "
^DIC(9.4,177,22,3,"PAH",71,1,4,0)="Enhancements (DDPE) VA Inpatient Medication Administration - Transdermal"
^DIC(9.4,177,22,3,"PAH",71,1,5,0)="enhancement includes 5 patches which must be installed in the following"
^DIC(9.4,177,22,3,"PAH",71,1,6,0)="order:"
^DIC(9.4,177,22,3,"PAH",71,1,7,0)="  "
^DIC(9.4,177,22,3,"PAH",71,1,8,0)="1.      PSS*1*191"
^DIC(9.4,177,22,3,"PAH",71,1,9,0)="2.      PSJ*5*315"
^DIC(9.4,177,22,3,"PAH",71,1,10,0)="3.      PSB*3*83"
^DIC(9.4,177,22,3,"PAH",71,1,11,0)="4.      OR*3*417"
^DIC(9.4,177,22,3,"PAH",71,1,12,0)="5.      PSB*3*87"
^DIC(9.4,177,22,3,"PAH",71,1,13,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,14,0)="ATTENTION: This enhancement also includes a new Graphical User Interface"
^DIC(9.4,177,22,3,"PAH",71,1,15,0)="(GUI) executable, BCMA GUI PSB3_P083.EXE. Installation of this GUI is"
^DIC(9.4,177,22,3,"PAH",71,1,16,0)="required immediately after the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",71,1,17,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,18,0)="For retrieval and installation instructions, please see the Client "
^DIC(9.4,177,22,3,"PAH",71,1,19,0)="Installation Instructions section."
^DIC(9.4,177,22,3,"PAH",71,1,20,0)="**************************************************************************"
^DIC(9.4,177,22,3,"PAH",71,1,21,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,22,0)="The Clinical Ancillary Services Development-Delivery of Pharmacy "
^DIC(9.4,177,22,3,"PAH",71,1,23,0)="Enhancements (CAS DDPE) project addresses several NSR's, which center "
^DIC(9.4,177,22,3,"PAH",71,1,24,0)="around providing a means for properly handling Transdermal Medications "
^DIC(9.4,177,22,3,"PAH",71,1,25,0)="Requiring Removal (MRR) beyond the current medications of dosage form "
^DIC(9.4,177,22,3,"PAH",71,1,26,0)="Patch.  These enhancements interface with Inpatient Pharmacy package, "
^DIC(9.4,177,22,3,"PAH",71,1,27,0)="which will be storing Scheduled Removal Times, for inpatient orders that "
^DIC(9.4,177,22,3,"PAH",71,1,28,0)="are designated as MRR type medications.  See associated patches PSS*1*191 "
^DIC(9.4,177,22,3,"PAH",71,1,29,0)="and PSJ*5*315, for details on how MRR medications are designated."
^DIC(9.4,177,22,3,"PAH",71,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,31,0)="This BCMA enhancement also includes a new Graphical User Interface (GUI) "
^DIC(9.4,177,22,3,"PAH",71,1,32,0)="executable, BCMA GUI PSB3_P083.EXE. Installation of this GUI is required "
^DIC(9.4,177,22,3,"PAH",71,1,33,0)="immediately after the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",71,1,34,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,35,0)="Features of the BCMA GUI provided by this project are listed below."
^DIC(9.4,177,22,3,"PAH",71,1,36,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,37,0)=" 1. Change the current GUI Unit Dose tab column labeled ""Admin Time"" to "
^DIC(9.4,177,22,3,"PAH",71,1,38,0)="    ""Next Dose Action""."
^DIC(9.4,177,22,3,"PAH",71,1,39,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,40,0)=" 2. The ""Next Dose Action"" column will now contain both the next admin"
^DIC(9.4,177,22,3,"PAH",71,1,41,0)="    times for scheduled administrations as well as the next Removal time"
^DIC(9.4,177,22,3,"PAH",71,1,42,0)="    for MRR type medications. The initial login to BCMA, will sort the"
^DIC(9.4,177,22,3,"PAH",71,1,43,0)="    Unit Dose tab in ascending order by this column, so older actions for"
^DIC(9.4,177,22,3,"PAH",71,1,44,0)="    medications will be at the top of the VDL display."
^DIC(9.4,177,22,3,"PAH",71,1,45,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,46,0)="      a. The Next Action of an administration will contain the word ""DUE"""
^DIC(9.4,177,22,3,"PAH",71,1,47,0)="         followed by the scheduled admin time in the standard date@admin"
^DIC(9.4,177,22,3,"PAH",71,1,48,0)="         time format currently in use."
^DIC(9.4,177,22,3,"PAH",71,1,49,0)="      b. The Next Action of a removal will contain the word ""REMOVE"""
^DIC(9.4,177,22,3,"PAH",71,1,50,0)="         followed by the scheduled removal time in the standard"
^DIC(9.4,177,22,3,"PAH",71,1,51,0)="         date@time format."
^DIC(9.4,177,22,3,"PAH",71,1,52,0)="      c. The Next Action of an administration that is past due to be"
^DIC(9.4,177,22,3,"PAH",71,1,53,0)="         given will contain the word ""LATE"" followed by the scheduled"
^DIC(9.4,177,22,3,"PAH",71,1,54,0)="         admin time in the standard date@admin time format currently in"
^DIC(9.4,177,22,3,"PAH",71,1,55,0)="         use.                "
^DIC(9.4,177,22,3,"PAH",71,1,56,0)="      d. The Next Action of a removal that is past due to be removed will"
^DIC(9.4,177,22,3,"PAH",71,1,57,0)="         contain the word ""LATE-RM"" followed by the scheduled removal time"
^DIC(9.4,177,22,3,"PAH",71,1,58,0)="         in the standard date@time format."
^DIC(9.4,177,22,3,"PAH",71,1,59,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,60,0)=" 3. Change the current GUI column labeled ""Wit"" to ""Alert""."
^DIC(9.4,177,22,3,"PAH",71,1,61,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,62,0)=" 4. The Alert column will still have the ability to display the Witness "
^DIC(9.4,177,22,3,"PAH",71,1,63,0)="    required icon and will also be able to display a new Remove icon.  "
^DIC(9.4,177,22,3,"PAH",71,1,64,0)="      a. The icon is displayed only for MRR type meds that were Given and"
^DIC(9.4,177,22,3,"PAH",71,1,65,0)="         their next Action is for Removal."
^DIC(9.4,177,22,3,"PAH",71,1,66,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,67,0)=" 5. Early/Late warnings will also be associated with medications being "
^DIC(9.4,177,22,3,"PAH",71,1,68,0)="    removed early or late using the same early late time range that is"
^DIC(9.4,177,22,3,"PAH",71,1,69,0)="    used for early or late medication admins."
^DIC(9.4,177,22,3,"PAH",71,1,70,0)="      a. User comments are prompted for and stored upon continuing with"
^DIC(9.4,177,22,3,"PAH",71,1,71,0)="         the Early/Late removal action."
^DIC(9.4,177,22,3,"PAH",71,1,72,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,73,0)=" 6. Variances will also be tracked for Early/Late Removals in the same "
^DIC(9.4,177,22,3,"PAH",71,1,74,0)="    manner as they are currently for Early/Late medication"
^DIC(9.4,177,22,3,"PAH",71,1,75,0)="    administrations and will appear on the Medication Variance Log report."
^DIC(9.4,177,22,3,"PAH",71,1,76,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,77,0)=" 7. BCMA Medication Administration History (MAH) report will now print"
^DIC(9.4,177,22,3,"PAH",71,1,78,0)="    the associated Give, which was previously overwritten by the Remove"
^DIC(9.4,177,22,3,"PAH",71,1,79,0)="    action, chronologically after the Remove for the Print by Patient "
^DIC(9.4,177,22,3,"PAH",71,1,80,0)="    report. The print by Ward report will now include the count of"
^DIC(9.4,177,22,3,"PAH",71,1,81,0)="    Removals scheduled for the report time period."
^DIC(9.4,177,22,3,"PAH",71,1,82,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,83,0)=" 8. BMCA Medication Log will now show the historical Give date/time below "
^DIC(9.4,177,22,3,"PAH",71,1,84,0)="    the current status of the medication, which shows the Remove"
^DIC(9.4,177,22,3,"PAH",71,1,85,0)="    date/time."
^DIC(9.4,177,22,3,"PAH",71,1,86,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,87,0)=" 9. BCMA Missed Medications report will also show Removals that were"
^DIC(9.4,177,22,3,"PAH",71,1,88,0)="    missed or up and coming, similar to how missed Gives are currently"
^DIC(9.4,177,22,3,"PAH",71,1,89,0)="    notated.  The column Heading has been changed from ""Admin Date/Time"""
^DIC(9.4,177,22,3,"PAH",71,1,90,0)="    to ""Missed Date/Time""."
^DIC(9.4,177,22,3,"PAH",71,1,91,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,92,0)="10. BCMA Display Order report now includes the Removal Times for this"
^DIC(9.4,177,22,3,"PAH",71,1,93,0)="    order directly below the current Admin Times."
^DIC(9.4,177,22,3,"PAH",71,1,94,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,95,0)="11. BCMA Medication History report now includes a prior Give line item"
^DIC(9.4,177,22,3,"PAH",71,1,96,0)="    directly below the current status line item of Remove (RM). The Remove"
^DIC(9.4,177,22,3,"PAH",71,1,97,0)="    last action on this administration overwrites the Give information and"
^DIC(9.4,177,22,3,"PAH",71,1,98,0)="    was no longer printing on this report.  This information is now being"
^DIC(9.4,177,22,3,"PAH",71,1,99,0)="    retrieved from the Audit log and printed on this report."
^DIC(9.4,177,22,3,"PAH",71,1,100,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,101,0)="12. BCMA Due List report now includes Remove Times on the report below "
^DIC(9.4,177,22,3,"PAH",71,1,102,0)="    the admin times that are due per Medication."
^DIC(9.4,177,22,3,"PAH",71,1,103,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,104,0)="13. BCMA Coversheet Medication Overview report and the Coversheet "
^DIC(9.4,177,22,3,"PAH",71,1,105,0)="    Expired/DC'd/Expiring Orders report will now include Missed-Removals "
^DIC(9.4,177,22,3,"PAH",71,1,106,0)="    and Removals on the reports."
^DIC(9.4,177,22,3,"PAH",71,1,107,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,108,0)="14. BCMA Medication Log report changed the heading from ""Inj Site"" to "
^DIC(9.4,177,22,3,"PAH",71,1,109,0)="    ""Body Site"".  The  Medication detail body text will display the proper"
^DIC(9.4,177,22,3,"PAH",71,1,110,0)="    label of ""Inj Site:"" or ""Derm Site:"" just prior to the name of the"
^DIC(9.4,177,22,3,"PAH",71,1,111,0)="    Body site for that medication."
^DIC(9.4,177,22,3,"PAH",71,1,112,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,113,0)="15. BCMA Medication History Heading line changed from ""Injection Site"" to"
^DIC(9.4,177,22,3,"PAH",71,1,114,0)="    ""Body Site""."
^DIC(9.4,177,22,3,"PAH",71,1,115,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,116,0)="16. A body site diagram will be added to the BCMA Parameter GUI client "
^DIC(9.4,177,22,3,"PAH",71,1,117,0)="    application for the purpose of showing a dot on the body diagram that"
^DIC(9.4,177,22,3,"PAH",71,1,118,0)="    is associated with the Text representation of that site location on"
^DIC(9.4,177,22,3,"PAH",71,1,119,0)="    the body."
^DIC(9.4,177,22,3,"PAH",71,1,120,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,121,0)="17. The BCMA Parameter GUI client application has access to a new kernel "
^DIC(9.4,177,22,3,"PAH",71,1,122,0)="    parameter titled in GUI application as ""Dermal Site History Max"
^DIC(9.4,177,22,3,"PAH",71,1,123,0)="    Days:"".  This allows the BCMA coordinator the ability to control how"
^DIC(9.4,177,22,3,"PAH",71,1,124,0)="    many days of prior dermal body site location history will appear, when"
^DIC(9.4,177,22,3,"PAH",71,1,125,0)="    a clinician is giving a new dermal medication that is prompting for a"
^DIC(9.4,177,22,3,"PAH",71,1,126,0)="    body site location."
^DIC(9.4,177,22,3,"PAH",71,1,127,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,128,0)="18. The Orders for MRRs With Removal Properties [PSS MRR ORDERS DIAGNOSTIC"
^DIC(9.4,177,22,3,"PAH",71,1,129,0)="    RPT] option found on the Pharmacy Data Management [PSS MGR] menu, "
^DIC(9.4,177,22,3,"PAH",71,1,130,0)="    will also be placed on the Bar Code Medication Administration Manager"
^DIC(9.4,177,22,3,"PAH",71,1,131,0)="    [PSB MGR] menu."
^DIC(9.4,177,22,3,"PAH",71,1,132,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,133,0)=" "
^DIC(9.4,177,22,3,"PAH",71,1,134,0)="*NOTE* Non-standard schedules such as DAY@HHMM, HHMM, or other Odd "
^DIC(9.4,177,22,3,"PAH",71,1,135,0)="       schedules, are not capable of calculating removal times due to a"
^DIC(9.4,177,22,3,"PAH",71,1,136,0)="       lack of a Frequency.  Regardless of the Prompt for Removal in BCMA"
^DIC(9.4,177,22,3,"PAH",71,1,137,0)="       code value they will not prompt for removal in BCMA and should be"
^DIC(9.4,177,22,3,"PAH",71,1,138,0)="       avoided."
^DIC(9.4,177,22,3,"PAH",72,0)="87^3161220.144513^54"
^DIC(9.4,177,22,3,"PAH",72,1,0)="^^42^42^3161220"
^DIC(9.4,177,22,3,"PAH",72,1,1,0)="******************************* ATTENTION ********************************"
^DIC(9.4,177,22,3,"PAH",72,1,2,0)="  "
^DIC(9.4,177,22,3,"PAH",72,1,3,0)="CASDDPE VA Inpatient Medication Administration - Transdermal enhancement"
^DIC(9.4,177,22,3,"PAH",72,1,4,0)="includes 5 patches which must be installed in the following order:"
^DIC(9.4,177,22,3,"PAH",72,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,6,0)="1.      PSS*1*191"
^DIC(9.4,177,22,3,"PAH",72,1,7,0)="2.      PSJ*5*315"
^DIC(9.4,177,22,3,"PAH",72,1,8,0)="3.      PSB*3*83"
^DIC(9.4,177,22,3,"PAH",72,1,9,0)="4.      OR*3*417"
^DIC(9.4,177,22,3,"PAH",72,1,10,0)="5.      PSB*3*87"
^DIC(9.4,177,22,3,"PAH",72,1,11,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,12,0)="ATTENTION: This enhancement also includes a new Graphical User Interface"
^DIC(9.4,177,22,3,"PAH",72,1,13,0)="(GUI) executable, BCMA GUI PSB3_P083.EXE. Installation of this GUI is"
^DIC(9.4,177,22,3,"PAH",72,1,14,0)="required immediately after the KIDS install for the Patch to function."
^DIC(9.4,177,22,3,"PAH",72,1,15,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,16,0)="For retrieval and installation instructions, please see the Client "
^DIC(9.4,177,22,3,"PAH",72,1,17,0)="Installation Instructions section."
^DIC(9.4,177,22,3,"PAH",72,1,18,0)="**************************************************************************"
^DIC(9.4,177,22,3,"PAH",72,1,19,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,20,0)="PSB*3*87 will enhance the BAR CODE MEDICATION ADMINISTRATION (BCMA) Backup"
^DIC(9.4,177,22,3,"PAH",72,1,21,0)="System (BCBU) to support Medications Requiring Removal (MRR). The Backup"
^DIC(9.4,177,22,3,"PAH",72,1,22,0)="System will be able to store the Removal times and duration of"
^DIC(9.4,177,22,3,"PAH",72,1,23,0)="administration associated with each medication order."
^DIC(9.4,177,22,3,"PAH",72,1,24,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,25,0)="This patch will add two new fields to the ORDER NUMBER (#53.702) "
^DIC(9.4,177,22,3,"PAH",72,1,26,0)="sub-file  under the BCMA BACKUP DATA (#53.7) file.  The two new fields "
^DIC(9.4,177,22,3,"PAH",72,1,27,0)="are the REMOVE TIMING (#7.4) field and DURATION OF ADMINISTRATION (#7.5) "
^DIC(9.4,177,22,3,"PAH",72,1,28,0)="field. These fields implement changes that will support enhancements to "
^DIC(9.4,177,22,3,"PAH",72,1,29,0)="Medical Administration Record(s) MAR reports in the BCBU application."
^DIC(9.4,177,22,3,"PAH",72,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,31,0)="The MAR reports will print each Scheduled Removal times for MRR "
^DIC(9.4,177,22,3,"PAH",72,1,32,0)="medications in the Grid in the same manner as Admin times.  The Remove"
^DIC(9.4,177,22,3,"PAH",72,1,33,0)="times will appear below the current scheduled Administration time in the"
^DIC(9.4,177,22,3,"PAH",72,1,34,0)="Grid and will be separated by the Label ""Remove"" in the times column.  "
^DIC(9.4,177,22,3,"PAH",72,1,35,0)="Asterisks will print in the body of the Grid in each Removal action box"
^DIC(9.4,177,22,3,"PAH",72,1,36,0)="for removal times that are not valid per the Date in that column heading."
^DIC(9.4,177,22,3,"PAH",72,1,37,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,38,0)="The MAR reports will also no longer display the Order number of the"
^DIC(9.4,177,22,3,"PAH",72,1,39,0)="medications being administered."
^DIC(9.4,177,22,3,"PAH",72,1,40,0)=" "
^DIC(9.4,177,22,3,"PAH",72,1,41,0)="Please refer to the BCMA Backup System (BCBU) Installation Guide for "
^DIC(9.4,177,22,3,"PAH",72,1,42,0)="PSB*3*87 for installation details."
^DIC(9.4,177,22,3,"PAH",73,0)="88 SEQ #77^3170106.120442^54"
^DIC(9.4,177,22,3,"PAH",73,1,0)="^^16^16^3170106"
^DIC(9.4,177,22,3,"PAH",73,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,177,22,3,"PAH",73,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",73,1,3,0)="1. The Bar code Medication Administration (BCMA) Due List Report does not"
^DIC(9.4,177,22,3,"PAH",73,1,4,0)="   display Intravenous Piggy Back (IVPB) orders  with an Inpatient "
^DIC(9.4,177,22,3,"PAH",73,1,5,0)="   Pharmacy Status of ""On Call""."
^DIC(9.4,177,22,3,"PAH",73,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",73,1,7,0)="2. The Missed Medication Report shows missed administrations prior to an "
^DIC(9.4,177,22,3,"PAH",73,1,8,0)="   edit when an order's Administration time are edited."
^DIC(9.4,177,22,3,"PAH",73,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",73,1,10,0)="3. The BCMA Drug IEN Synonym Check [PSB DRUG IEN CHECK] option needs to"
^DIC(9.4,177,22,3,"PAH",73,1,11,0)="   be added to the Medication Administration Menu Pharmacy [PSB PHARMACY]"
^DIC(9.4,177,22,3,"PAH",73,1,12,0)="   menu."
^DIC(9.4,177,22,3,"PAH",73,1,13,0)=" "
^DIC(9.4,177,22,3,"PAH",73,1,14,0)="4. The IV Bag Detail on the IV tab does not display for a patient when "
^DIC(9.4,177,22,3,"PAH",73,1,15,0)="   opening the patient's Virtual Due List (VDL) after having another "
^DIC(9.4,177,22,3,"PAH",73,1,16,0)="   patient's VDL open."
^DIC(9.4,177,22,3,"PAH",74,0)="95^3170123.14263^54"
^DIC(9.4,177,22,3,"PAH",74,1,0)="^^2^2^3170123"
^DIC(9.4,177,22,3,"PAH",74,1,1,0)="Fix for eHMP defect 4250.  Places SEQUENCE values on ITEMs in the "
^DIC(9.4,177,22,3,"PAH",74,1,2,0)="PROTOCOL file (#101)."
^DIC(9.4,177,22,3,"PAH",75,0)="97 SEQ #79^3170224.165648^54"
^DIC(9.4,177,22,3,"PAH",75,1,0)="^^11^11^3170224"
^DIC(9.4,177,22,3,"PAH",75,1,1,0)="Patch PSB*3*97 will change the version number of the Bar Code "
^DIC(9.4,177,22,3,"PAH",75,1,2,0)="Medication Administration (BCMA) client application to version 97"
^DIC(9.4,177,22,3,"PAH",75,1,3,0)="from version 83 to correct an issue discovered immediately after release"
^DIC(9.4,177,22,3,"PAH",75,1,4,0)="of version 83.  "
^DIC(9.4,177,22,3,"PAH",75,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",75,1,6,0)="A hard error can occur in the BCMA client application with a new button"
^DIC(9.4,177,22,3,"PAH",75,1,7,0)="provided that displays a Body Site Image for selecting body location of"
^DIC(9.4,177,22,3,"PAH",75,1,8,0)="transdermal type medications."
^DIC(9.4,177,22,3,"PAH",75,1,9,0)=" "
^DIC(9.4,177,22,3,"PAH",75,1,10,0)="Some reports that print Legends had some issues where the user name and"
^DIC(9.4,177,22,3,"PAH",75,1,11,0)="initials were inaccurate for transdermal type medications."
^DIC(9.4,177,22,3,"PAH",76,0)="92 SEQ #80^3170601.180842^54"
^DIC(9.4,177,22,3,"PAH",76,1,0)="^^16^16^3170601"
^DIC(9.4,177,22,3,"PAH",76,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,177,22,3,"PAH",76,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",76,1,3,0)="1. The Bar Code Medication Administration (BCMA) Order Mode indicator"
^DIC(9.4,177,22,3,"PAH",76,1,4,0)="   light is not displaying when the only active orders have a pharmacy"
^DIC(9.4,177,22,3,"PAH",76,1,5,0)="   status of renewed, on call, or provider hold."
^DIC(9.4,177,22,3,"PAH",76,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",76,1,7,0)="2. The BCMA Active Order Indicator light is not displaying for the Unit "
^DIC(9.4,177,22,3,"PAH",76,1,8,0)="   Dose tab when the only active orders have a Pharmacy Status of Renewed"
^DIC(9.4,177,22,3,"PAH",76,1,9,0)="   or Provider Hold."
^DIC(9.4,177,22,3,"PAH",76,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",76,1,11,0)="3. Medications cannot be administered in BCMA after Nurse's initials "
^DIC(9.4,177,22,3,"PAH",76,1,12,0)="   deleted."
^DIC(9.4,177,22,3,"PAH",76,1,13,0)=" "
^DIC(9.4,177,22,3,"PAH",76,1,14,0)="4. Medications Orders requiring removal with a schedule type of ""One-Time"""
^DIC(9.4,177,22,3,"PAH",76,1,15,0)="   and Frequency greater than zero do not display the correct removal"
^DIC(9.4,177,22,3,"PAH",76,1,16,0)="   time in the ""Next Dose Action"" field on the BCMA VDL."
^DIC(9.4,177,22,3,"PAH",77,0)="98 SEQ #81^3170726.132701^54"
^DIC(9.4,177,22,3,"PAH",77,1,0)="^^15^15^3170726"
^DIC(9.4,177,22,3,"PAH",77,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,177,22,3,"PAH",77,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",77,1,3,0)="1. The Bar Code Medication Administration (BCMA) IVP/IVPB tab continues"
^DIC(9.4,177,22,3,"PAH",77,1,4,0)="   to display orders with a Schedule Type of On Call after the order is "
^DIC(9.4,177,22,3,"PAH",77,1,5,0)="   administered."
^DIC(9.4,177,22,3,"PAH",77,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",77,1,7,0)="2. The BCMA Display Order report displays both BCMA EXPIRED and BCMA"
^DIC(9.4,177,22,3,"PAH",77,1,8,0)="   EXPIRE DENIED in the data field of the Pharmacy Activity section when a"
^DIC(9.4,177,22,3,"PAH",77,1,9,0)="   one time dose medication is administered."
^DIC(9.4,177,22,3,"PAH",77,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",77,1,11,0)="3. The BCMA Display Order report displays dates in the data field in "
^DIC(9.4,177,22,3,"PAH",77,1,12,0)="   internal Fileman format."
^DIC(9.4,177,22,3,"PAH",77,1,13,0)=" "
^DIC(9.4,177,22,3,"PAH",77,1,14,0)="4. An Undefined error occurs when the Medication Therapy report is run "
^DIC(9.4,177,22,3,"PAH",77,1,15,0)="   with no schedule types selected."
^DIC(9.4,177,22,3,"PAH",78,0)="99 SEQ #82^3171005.135922^54"
^DIC(9.4,177,22,3,"PAH",78,1,0)="^^177^177^3171005"
^DIC(9.4,177,22,3,"PAH",78,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,177,22,3,"PAH",78,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,3,0)="1. The Bar Code Medication Administration (BCMA) GUI does not store the"
^DIC(9.4,177,22,3,"PAH",78,1,4,0)="   initials of the 2nd user who witnesses a high risk/high alert "
^DIC(9.4,177,22,3,"PAH",78,1,5,0)="continuous"
^DIC(9.4,177,22,3,"PAH",78,1,6,0)="   intravenous (IV) order which has been marked stopped and then marked"
^DIC(9.4,177,22,3,"PAH",78,1,7,0)="   infusing again."
^DIC(9.4,177,22,3,"PAH",78,1,8,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,9,0)="2. If an IV order is marked as a missing dose, then as held or refused, "
^DIC(9.4,177,22,3,"PAH",78,1,10,0)="then"
^DIC(9.4,177,22,3,"PAH",78,1,11,0)="   infusing, the medication log shows each ingredient of the infusing IV "
^DIC(9.4,177,22,3,"PAH",78,1,12,0)="Order"
^DIC(9.4,177,22,3,"PAH",78,1,13,0)="   to have units of zero."
^DIC(9.4,177,22,3,"PAH",78,1,14,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,15,0)="3. When a multiple dose medication has been edited prior to "
^DIC(9.4,177,22,3,"PAH",78,1,16,0)="administration,"
^DIC(9.4,177,22,3,"PAH",78,1,17,0)="   it will display on the Missed Meds report after administration."
^DIC(9.4,177,22,3,"PAH",78,1,18,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,19,0)="4. A PRN medication requiring a PRN Effectiveness does not display in the"
^DIC(9.4,177,22,3,"PAH",78,1,20,0)="   BCMA Clinical Reminders section if the patient is discharged and "
^DIC(9.4,177,22,3,"PAH",78,1,21,0)="   re-admitted."
^DIC(9.4,177,22,3,"PAH",78,1,22,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,23,0)="5. The unsupported Documenting Backlog PRNs [PSB PRN DOCUMENTING] option"
^DIC(9.4,177,22,3,"PAH",78,1,24,0)="   needs to be marked out of order, and removed from the Bar Code "
^DIC(9.4,177,22,3,"PAH",78,1,25,0)="Medication"
^DIC(9.4,177,22,3,"PAH",78,1,26,0)="   Administration Manager [PSB MGR] menu option."
^DIC(9.4,177,22,3,"PAH",78,1,27,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,28,0)="6. An error occurs when a site new to BCMA attempts to create their first "
^DIC(9.4,177,22,3,"PAH",78,1,29,0)="   order."
^DIC(9.4,177,22,3,"PAH",78,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,31,0)="7. The patient lookup window sometimes lists the wrong patient when users"
^DIC(9.4,177,22,3,"PAH",78,1,32,0)="   are doing a search by the ward name and the first part of the ward name"
^DIC(9.4,177,22,3,"PAH",78,1,33,0)="   matches with a valid date."
^DIC(9.4,177,22,3,"PAH",78,1,34,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,35,0)="ASSOCIATED NSR(S):"
^DIC(9.4,177,22,3,"PAH",78,1,36,0)="=================="
^DIC(9.4,177,22,3,"PAH",78,1,37,0)="N/A"
^DIC(9.4,177,22,3,"PAH",78,1,38,0)="  "
^DIC(9.4,177,22,3,"PAH",78,1,39,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,40,0)="ASSOCIATED CA TICKET(S):"
^DIC(9.4,177,22,3,"PAH",78,1,41,0)="============================"
^DIC(9.4,177,22,3,"PAH",78,1,42,0)="1. I9892136FY16 - 2nd Witness Initials not stored"
^DIC(9.4,177,22,3,"PAH",78,1,43,0)="2. I9842129FY16 - TPN shows 0 units for each ingredient - Med Log"
^DIC(9.4,177,22,3,"PAH",78,1,44,0)="3. I9892810FY16 - False missed med when Inpatient Pharmacy edits"
^DIC(9.4,177,22,3,"PAH",78,1,45,0)="                                 dispense drug"
^DIC(9.4,177,22,3,"PAH",78,1,46,0)="4. R12817870FY17 - PRN requiring effective is not showing on BCMA"
^DIC(9.4,177,22,3,"PAH",78,1,47,0)="                                     Clinical Reminders"
^DIC(9.4,177,22,3,"PAH",78,1,48,0)="5. I10114492FY16 - Mark Documenting Backlog PRNs option OOO"
^DIC(9.4,177,22,3,"PAH",78,1,49,0)="6. I6216135FY16 - <UNDEFINED>RESETADM+7^PSBUTL error in BCMA"
^DIC(9.4,177,22,3,"PAH",78,1,50,0)="7. I10181534FY16 - Extra Data populated when pulling by Ward"
^DIC(9.4,177,22,3,"PAH",78,1,51,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,52,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,53,0)="PARTICIPATING TEST SITES:"
^DIC(9.4,177,22,3,"PAH",78,1,54,0)="========================="
^DIC(9.4,177,22,3,"PAH",78,1,55,0)="TBD"
^DIC(9.4,177,22,3,"PAH",78,1,56,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,57,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,58,0)="CA OVERVIEW:"
^DIC(9.4,177,22,3,"PAH",78,1,59,0)="================"
^DIC(9.4,177,22,3,"PAH",78,1,60,0)="1. I9892136FY16   - 2nd Witness Initials not stored"
^DIC(9.4,177,22,3,"PAH",78,1,61,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,62,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,63,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,64,0)="   The second witness' information is not stored in the ADMIN WITNESSED BY"
^DIC(9.4,177,22,3,"PAH",78,1,65,0)="   (#.29) field of the BCMA MEDICATION LOG (#53.79) file when an IV bag"
^DIC(9.4,177,22,3,"PAH",78,1,66,0)="   with a high risk/high alert medication is marked stopped and then"
^DIC(9.4,177,22,3,"PAH",78,1,67,0)="   infusing again."
^DIC(9.4,177,22,3,"PAH",78,1,68,0)="   "
^DIC(9.4,177,22,3,"PAH",78,1,69,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,70,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,71,0)="   Routine PSBML2 was modified to remove the first witness' information"
^DIC(9.4,177,22,3,"PAH",78,1,72,0)="   and store the second's information in the ADMIN WITNESSED BY (#.29) "
^DIC(9.4,177,22,3,"PAH",78,1,73,0)="   field. The first user's information will be preserved in the AUDIT LOG"
^DIC(9.4,177,22,3,"PAH",78,1,74,0)="   sub-file (#53.799)."
^DIC(9.4,177,22,3,"PAH",78,1,75,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,76,0)="2. I9842129FY16  - TPN shows 0 units for each ingredient - Med Log"
^DIC(9.4,177,22,3,"PAH",78,1,77,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,78,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,79,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,80,0)="   When a missing dose is requested for an IV order, then as held or "
^DIC(9.4,177,22,3,"PAH",78,1,81,0)="refused,"
^DIC(9.4,177,22,3,"PAH",78,1,82,0)="   and then infusing, the Medication History report shows each ingredient "
^DIC(9.4,177,22,3,"PAH",78,1,83,0)="of "
^DIC(9.4,177,22,3,"PAH",78,1,84,0)="   the infusing IV Order to display units of zero. "
^DIC(9.4,177,22,3,"PAH",78,1,85,0)="   "
^DIC(9.4,177,22,3,"PAH",78,1,86,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,87,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,88,0)="   Routine PSBML2 was modified to store the correct units for each IV bag"
^DIC(9.4,177,22,3,"PAH",78,1,89,0)="   ingredient in the UNIT OF ADMINISTRATION (#.04) field of both the "
^DIC(9.4,177,22,3,"PAH",78,1,90,0)="   ADDITIVES (#53.796) and SOLUTIONS (#53.797) sub-files."
^DIC(9.4,177,22,3,"PAH",78,1,91,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,92,0)="3. I9892810FY16 - False missed med when Inpatient Pharmacy edits"
^DIC(9.4,177,22,3,"PAH",78,1,93,0)="                                 dispense drug"
^DIC(9.4,177,22,3,"PAH",78,1,94,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,95,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,96,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,97,0)="   A multiple dose medication will incorrectly display on the BCMA Missed"
^DIC(9.4,177,22,3,"PAH",78,1,98,0)="   Medications report when the dosage form of the order was edited after"
^DIC(9.4,177,22,3,"PAH",78,1,99,0)="   a missing dose request is made on the order."
^DIC(9.4,177,22,3,"PAH",78,1,100,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,101,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,102,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,103,0)="   Routine PSBML2 was modified to store the correct medication dosages"
^DIC(9.4,177,22,3,"PAH",78,1,104,0)="   in the DISPENSE DRUG (#53.795) sub-file when the edited order is"
^DIC(9.4,177,22,3,"PAH",78,1,105,0)="   administered. "
^DIC(9.4,177,22,3,"PAH",78,1,106,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,107,0)="4. R12817870FY17 - PRN requiring effective is not showing on BCMA Clinical"
^DIC(9.4,177,22,3,"PAH",78,1,108,0)="                   Reminders"
^DIC(9.4,177,22,3,"PAH",78,1,109,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,110,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,111,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,112,0)="   A PRN medication requiring a PRN Effectiveness does not display on the"
^DIC(9.4,177,22,3,"PAH",78,1,113,0)="   BCMA Clinical Reminders if the patient is discharged and re-admitted."
^DIC(9.4,177,22,3,"PAH",78,1,114,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,115,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,116,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,117,0)="   Routine PSBPRN was modified to display the order under the BCMA "
^DIC(9.4,177,22,3,"PAH",78,1,118,0)="Clinical "
^DIC(9.4,177,22,3,"PAH",78,1,119,0)="   Reminders when the patient is discharged and re-admitted, as long as "
^DIC(9.4,177,22,3,"PAH",78,1,120,0)="the"
^DIC(9.4,177,22,3,"PAH",78,1,121,0)="   order falls within the PRN Documentation parameter."
^DIC(9.4,177,22,3,"PAH",78,1,122,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,123,0)="5. I10114492FY16 - Mark Documenting Backlog PRNs option OOO"
^DIC(9.4,177,22,3,"PAH",78,1,124,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,125,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,126,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,127,0)="   The unsupported Documenting Backlog PRNs [PSB PRN DOCUMENTING] option"
^DIC(9.4,177,22,3,"PAH",78,1,128,0)="   needs to be marked out of order and removed from the Bar Code "
^DIC(9.4,177,22,3,"PAH",78,1,129,0)="Medication"
^DIC(9.4,177,22,3,"PAH",78,1,130,0)="   Administration Manager [PSB MGR] menu option. This option runs a "
^DIC(9.4,177,22,3,"PAH",78,1,131,0)="version"
^DIC(9.4,177,22,3,"PAH",78,1,132,0)="   2 routine in BCMA (currently on version 3), and should not be active"
^DIC(9.4,177,22,3,"PAH",78,1,133,0)="   on a nationally released menu option."
^DIC(9.4,177,22,3,"PAH",78,1,134,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,135,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,136,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,137,0)="   Post Install routine PSB399P will mark the Documenting Backlog PRNs"
^DIC(9.4,177,22,3,"PAH",78,1,138,0)="   option [PSB PRN DOCUMENTING] ""out of order"" and remove the option"
^DIC(9.4,177,22,3,"PAH",78,1,139,0)="   from the Bar Code Medication Administration Manager [PSB MGR] menu."
^DIC(9.4,177,22,3,"PAH",78,1,140,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,141,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,142,0)="6. I6216135FY16 - <UNDEFINED>RESETADM+7^PSBUTL error in BCMA"
^DIC(9.4,177,22,3,"PAH",78,1,143,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,144,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,145,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,146,0)="   An error occurs the first time an order is administered in BCMA."
^DIC(9.4,177,22,3,"PAH",78,1,147,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,148,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,149,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,150,0)="   Routine PSBUTL was modified to properly record the first BCMA "
^DIC(9.4,177,22,3,"PAH",78,1,151,0)="   medication administration."
^DIC(9.4,177,22,3,"PAH",78,1,152,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,153,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,154,0)="7. I10181534FY16 - Extra Data populated when pulling by Ward"
^DIC(9.4,177,22,3,"PAH",78,1,155,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,156,0)="   Problem:"
^DIC(9.4,177,22,3,"PAH",78,1,157,0)="   --------"
^DIC(9.4,177,22,3,"PAH",78,1,158,0)="   A BCMA user was attempting to pull data by ward. When data populated"
^DIC(9.4,177,22,3,"PAH",78,1,159,0)="   it listed patients that are not associated with the ward selected."
^DIC(9.4,177,22,3,"PAH",78,1,160,0)=" "
^DIC(9.4,177,22,3,"PAH",78,1,161,0)="   The problem happened because the ward searched had a name that the "
^DIC(9.4,177,22,3,"PAH",78,1,162,0)="first"
^DIC(9.4,177,22,3,"PAH",78,1,163,0)="   characters were similar to a date (e.g., 8-8, 10-11, etc.). The "
^DIC(9.4,177,22,3,"PAH",78,1,164,0)="routine  "
^DIC(9.4,177,22,3,"PAH",78,1,165,0)="   PSBMLLKU (line tag PTLKUP) used to perform a Fileman lookup using all"
^DIC(9.4,177,22,3,"PAH",78,1,166,0)="   cross-references in the PATIENT file (#2). This lookup approach "
^DIC(9.4,177,22,3,"PAH",78,1,167,0)="   sometimes produced wrong entries because it would match with a date "
^DIC(9.4,177,22,3,"PAH",78,1,168,0)="from"
^DIC(9.4,177,22,3,"PAH",78,1,169,0)="   the ""E"" x-ref (CV DATED EDITED) because for example ""8-8"" would trigger"
^DIC(9.4,177,22,3,"PAH",78,1,170,0)="   a match a 08/08/17 (current year) causing such patients to be included"
^DIC(9.4,177,22,3,"PAH",78,1,171,0)="   in the lookup result."
^DIC(9.4,177,22,3,"PAH",78,1,172,0)="  "
^DIC(9.4,177,22,3,"PAH",78,1,173,0)="   Resolution:"
^DIC(9.4,177,22,3,"PAH",78,1,174,0)="   -----------"
^DIC(9.4,177,22,3,"PAH",78,1,175,0)="   The code at the PTLKUP^PSBMLLKU was modified to only include the cross-"
^DIC(9.4,177,22,3,"PAH",78,1,176,0)="   references that are relevant to the patient lookup popup window (last "
^DIC(9.4,177,22,3,"PAH",78,1,177,0)="   name, first name, SSN, ward, room and bed)."
^DIC(9.4,177,22,3,"PAH",79,0)="102^3180131.16315^54"
^DIC(9.4,177,22,3,"PAH",79,1,0)="^^87^87^3180131"
^DIC(9.4,177,22,3,"PAH",79,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,177,22,3,"PAH",79,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,3,0)="1. I9592038FY16 - Frequently, BCMA users are not able to access the BCBU"
^DIC(9.4,177,22,3,"PAH",79,1,4,0)="                  database"
^DIC(9.4,177,22,3,"PAH",79,1,5,0)="2. I8652828FY16 - Getting ALERT BCBU Contingency Error 46364090 / Missing HLL"
^DIC(9.4,177,22,3,"PAH",79,1,6,0)="                  Links Array Med-Log"
^DIC(9.4,177,22,3,"PAH",79,1,7,0)="3. I6161931FY16 - Received the error $ZE= <UNDEFINED>ZPD+5^IVMPREC8 *HLFS"
^DIC(9.4,177,22,3,"PAH",79,1,8,0)="   I16851052FY18 - Undefined: GENACK+10^RGADTP *HL(""MID"") "
^DIC(9.4,177,22,3,"PAH",79,1,9,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,10,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,11,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",79,1,12,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",79,1,13,0)="1. I9592038FY16 - Frequently, BCMA users are not able to access the BCBU"
^DIC(9.4,177,22,3,"PAH",79,1,14,0)="                  database"
^DIC(9.4,177,22,3,"PAH",79,1,15,0)="   "
^DIC(9.4,177,22,3,"PAH",79,1,16,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",79,1,17,0)="--------"
^DIC(9.4,177,22,3,"PAH",79,1,18,0)="Frequently, BCMA users are not able to access the BCBU database. This result"
^DIC(9.4,177,22,3,"PAH",79,1,19,0)="in local IT support spending time to resolve what should be a minor issue."
^DIC(9.4,177,22,3,"PAH",79,1,20,0)="However, the fix is not always simple or straight forward. Typically, the"
^DIC(9.4,177,22,3,"PAH",79,1,21,0)="problem is that the user has had a Verify Code change since they last"
^DIC(9.4,177,22,3,"PAH",79,1,22,0)="accessed a contingency. Normally, doing a User Initialization does not"
^DIC(9.4,177,22,3,"PAH",79,1,23,0)="resolve the issue and IT support has to either replace the database or"
^DIC(9.4,177,22,3,"PAH",79,1,24,0)="manually give the user a new Verify code on the contingency computer."
^DIC(9.4,177,22,3,"PAH",79,1,25,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,26,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",79,1,27,0)="-----------"
^DIC(9.4,177,22,3,"PAH",79,1,28,0)="Modified the routines ALPBGEN, ALPBGEN1 and ALPBGEN2 to remove some"
^DIC(9.4,177,22,3,"PAH",79,1,29,0)="unnecessary restrictions for sending a user update over to the BCBU"
^DIC(9.4,177,22,3,"PAH",79,1,30,0)="workstation. For example, if a user was terminated in the main VistA System"
^DIC(9.4,177,22,3,"PAH",79,1,31,0)="it would not be sent to the BCBU workstation. This caused terminated users"
^DIC(9.4,177,22,3,"PAH",79,1,32,0)="in the main VistA System to remain active in the BCBU workstation."
^DIC(9.4,177,22,3,"PAH",79,1,33,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,34,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,35,0)="2. I8652828FY16 - Getting ALERT BCBU Contingency Error 46364090 / Missing HLL"
^DIC(9.4,177,22,3,"PAH",79,1,36,0)="                  Links Array Med-Log"
^DIC(9.4,177,22,3,"PAH",79,1,37,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,38,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",79,1,39,0)="--------"
^DIC(9.4,177,22,3,"PAH",79,1,40,0)="In a multi-divisional BCBU configuration all Divisions are required to have"
^DIC(9.4,177,22,3,"PAH",79,1,41,0)="an HL7 Logical Link associated. When a division is missing the association an"
^DIC(9.4,177,22,3,"PAH",79,1,42,0)="alert is generated for every transaction that is supposed to go to the BCBU"
^DIC(9.4,177,22,3,"PAH",79,1,43,0)="workstation for that division. The problem is that the Alert does not identify"
^DIC(9.4,177,22,3,"PAH",79,1,44,0)="which division is missing the Logical Link, which makes it hard for the users"
^DIC(9.4,177,22,3,"PAH",79,1,45,0)="to identify the source of the problem and resolve it. Furthermore, the fact "
^DIC(9.4,177,22,3,"PAH",79,1,46,0)="that the Alert does not identify which patient was being processed when the "
^DIC(9.4,177,22,3,"PAH",79,1,47,0)="issue happened makes it hard to troubleshoot and fix the problem as well."
^DIC(9.4,177,22,3,"PAH",79,1,48,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,49,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",79,1,50,0)="-----------"
^DIC(9.4,177,22,3,"PAH",79,1,51,0)="Modified the routine ALPBCBU to include the site number and the patient DFN"
^DIC(9.4,177,22,3,"PAH",79,1,52,0)="number in the Alert subject. This way users will know exactly which division"
^DIC(9.4,177,22,3,"PAH",79,1,53,0)="and the patient that was being processed when a BCBU Alert is generated due to"
^DIC(9.4,177,22,3,"PAH",79,1,54,0)="an error. "
^DIC(9.4,177,22,3,"PAH",79,1,55,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,56,0)="Here is how the Alert text will be modified:"
^DIC(9.4,177,22,3,"PAH",79,1,57,0)="  "
^DIC(9.4,177,22,3,"PAH",79,1,58,0)=" Before: BCBU Contingency Error"
^DIC(9.4,177,22,3,"PAH",79,1,59,0)="         Missing HLL Links Array Med-Log"
^DIC(9.4,177,22,3,"PAH",79,1,60,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,61,0)=" After:  BCBU Contingency Error / Site: 442 / DFN: 1930382"
^DIC(9.4,177,22,3,"PAH",79,1,62,0)="         Missing HLL Links Array Med-Log"
^DIC(9.4,177,22,3,"PAH",79,1,63,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,64,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,65,0)="3. I6161931FY16 - Received the error $ZE= <UNDEFINED>ZPD+5^IVMPREC8 *HLFS"
^DIC(9.4,177,22,3,"PAH",79,1,66,0)="   I16851052FY18 - Undefined: GENACK+10^RGADTP *HL(""MID"") "
^DIC(9.4,177,22,3,"PAH",79,1,67,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,68,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",79,1,69,0)="-------- "
^DIC(9.4,177,22,3,"PAH",79,1,70,0)="When an HL7 message is received from an Income Verification Match (IVM) Center"
^DIC(9.4,177,22,3,"PAH",79,1,71,0)="containing demographics data for a patient that includes a date of death the"
^DIC(9.4,177,22,3,"PAH",79,1,72,0)="BCBU application is automatically invoked if such patient has active inpatient"
^DIC(9.4,177,22,3,"PAH",79,1,73,0)="orders. Many other subscribing applications are automatically invoked by the "
^DIC(9.4,177,22,3,"PAH",79,1,74,0)="same process and they all share the same local variables from the invoking"
^DIC(9.4,177,22,3,"PAH",79,1,75,0)="process. The routine ALPBINP was incorrectly killing HL7 local variables such"
^DIC(9.4,177,22,3,"PAH",79,1,76,0)="as HL, HLA, HLCS, HLCTR and HLFS, which were being used by other applications"
^DIC(9.4,177,22,3,"PAH",79,1,77,0)="and in these two specific incidents reported caused the Income Verification"
^DIC(9.4,177,22,3,"PAH",79,1,78,0)="Match (IVM) and Registration applications to error out."
^DIC(9.4,177,22,3,"PAH",79,1,79,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,80,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",79,1,81,0)="-----------"
^DIC(9.4,177,22,3,"PAH",79,1,82,0)="Modified the routine ALPBCBU to NEW the variables HL, HLA, HLECH and HLQ and"
^DIC(9.4,177,22,3,"PAH",79,1,83,0)="also modified the routine ALPBINP to no longer kill the HL7 variables HLCS, "
^DIC(9.4,177,22,3,"PAH",79,1,84,0)="HLCTR and HLFS."
^DIC(9.4,177,22,3,"PAH",79,1,85,0)=" "
^DIC(9.4,177,22,3,"PAH",79,1,86,0)="NOTE: This fix could not be tested in a development or an SQA environments"
^DIC(9.4,177,22,3,"PAH",79,1,87,0)="      because it requires an incoming HL7 message from an external entity."
^DIC(9.4,177,22,3,"PAH",80,0)="104 SEQ #84^3180301.153131^54"
^DIC(9.4,177,22,3,"PAH",80,1,0)="^^25^25^3180301"
^DIC(9.4,177,22,3,"PAH",80,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",80,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",80,1,3,0)="1. R16686630FY17 - Ward 9C keeps getting this error (Timeout) intermittently"
^DIC(9.4,177,22,3,"PAH",80,1,4,0)="                   when trying to run the Missed Medications Report  "
^DIC(9.4,177,22,3,"PAH",80,1,5,0)="  "
^DIC(9.4,177,22,3,"PAH",80,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",80,1,7,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",80,1,8,0)="1. R16686630FY17 - Ward 9C keeps getting this error (Timeout) intermittently"
^DIC(9.4,177,22,3,"PAH",80,1,9,0)="                   when trying to run the Missed Medications Report  "
^DIC(9.4,177,22,3,"PAH",80,1,10,0)="   "
^DIC(9.4,177,22,3,"PAH",80,1,11,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",80,1,12,0)="--------"
^DIC(9.4,177,22,3,"PAH",80,1,13,0)="Milwaukee VAMC reported getting a RPC Broker Timeout error when running the"
^DIC(9.4,177,22,3,"PAH",80,1,14,0)="BCMA Missed Medications Report for one specific ward (9C). The reason they"
^DIC(9.4,177,22,3,"PAH",80,1,15,0)="were getting this error is because Ward 9C has quite a few long term care"
^DIC(9.4,177,22,3,"PAH",80,1,16,0)="patients and the report retrieves information for every single order with"
^DIC(9.4,177,22,3,"PAH",80,1,17,0)="medication that requires removal (e.g., patches) for all patients in that"
^DIC(9.4,177,22,3,"PAH",80,1,18,0)="ward before deciding whether the order should be in the report or not."
^DIC(9.4,177,22,3,"PAH",80,1,19,0)="   "
^DIC(9.4,177,22,3,"PAH",80,1,20,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",80,1,21,0)="-----------"
^DIC(9.4,177,22,3,"PAH",80,1,22,0)="Modified the routine PBUTL at the REMOVES line tag and moved the screening"
^DIC(9.4,177,22,3,"PAH",80,1,23,0)="filters up before the call to D PSJ1^PSBVT. This change will have no impact"
^DIC(9.4,177,22,3,"PAH",80,1,24,0)="whatsoever on the output of the report and it will considerably decrease the"
^DIC(9.4,177,22,3,"PAH",80,1,25,0)="amount of time it takes to run it."
^DIC(9.4,177,22,3,"PAH",81,0)="105^3180601.1534^54"
^DIC(9.4,177,22,3,"PAH",81,1,0)="^^26^26^3180601"
^DIC(9.4,177,22,3,"PAH",81,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,177,22,3,"PAH",81,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",81,1,3,0)="1. R18279880FY18 - BCBU not consistently updating Clinic Orders"
^DIC(9.4,177,22,3,"PAH",81,1,4,0)="   "
^DIC(9.4,177,22,3,"PAH",81,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",81,1,6,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",81,1,7,0)="1. R18279880FY18 - Frequently, BCMA users are not able to access the BCBU"
^DIC(9.4,177,22,3,"PAH",81,1,8,0)="                  database"
^DIC(9.4,177,22,3,"PAH",81,1,9,0)="   "
^DIC(9.4,177,22,3,"PAH",81,1,10,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",81,1,11,0)="--------"
^DIC(9.4,177,22,3,"PAH",81,1,12,0)="It was reported that almost all of the BCBU Contingency Error Alerts that"
^DIC(9.4,177,22,3,"PAH",81,1,13,0)="Divisional sites receive continually are for patients who are not admitted"
^DIC(9.4,177,22,3,"PAH",81,1,14,0)="or are deceased. Furthermore, testing of BCBU data for Clinic Orders reveals"
^DIC(9.4,177,22,3,"PAH",81,1,15,0)="that the patient records for clinics using BCMA are rarely complete causing"
^DIC(9.4,177,22,3,"PAH",81,1,16,0)="the menu options in BCBU to be placed OUT of ORDER to prevent medication"
^DIC(9.4,177,22,3,"PAH",81,1,17,0)="errors during contingency operations."
^DIC(9.4,177,22,3,"PAH",81,1,18,0)="  "
^DIC(9.4,177,22,3,"PAH",81,1,19,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",81,1,20,0)="-----------"
^DIC(9.4,177,22,3,"PAH",81,1,21,0)="It was identified that updates for BCMA Medication Logs for patients that are"
^DIC(9.4,177,22,3,"PAH",81,1,22,0)="no longer inpatient fail to identify the correct division for which the HL7 "
^DIC(9.4,177,22,3,"PAH",81,1,23,0)="message should be sent to. A fix was made to retrieve the correct Division"
^DIC(9.4,177,22,3,"PAH",81,1,24,0)="using the Institution in the Medication Log if the patient is no longer"
^DIC(9.4,177,22,3,"PAH",81,1,25,0)="inpatient. In addition, the BCBU Contingeny Error Alerts will no longer be"
^DIC(9.4,177,22,3,"PAH",81,1,26,0)="generated for patients that are deceased."
^DIC(9.4,177,22,3,"PAH",82,0)="107 SEQ #86^3180601.1624^54"
^DIC(9.4,177,22,3,"PAH",82,1,0)="^^28^28^3180601"
^DIC(9.4,177,22,3,"PAH",82,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",82,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",82,1,3,0)="R19023599FY18 - PSB GUI Context consuming a lot of CPU on Bay Pines VistA"
^DIC(9.4,177,22,3,"PAH",82,1,4,0)="                Front ends"
^DIC(9.4,177,22,3,"PAH",82,1,5,0)="   "
^DIC(9.4,177,22,3,"PAH",82,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",82,1,7,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",82,1,8,0)="R19023599FY18 - PSB GUI Context consuming a lot of CPU on Bay Pines VistA"
^DIC(9.4,177,22,3,"PAH",82,1,9,0)="                Front ends"
^DIC(9.4,177,22,3,"PAH",82,1,10,0)="   "
^DIC(9.4,177,22,3,"PAH",82,1,11,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",82,1,12,0)="--------"
^DIC(9.4,177,22,3,"PAH",82,1,13,0)="An issue was discovered when loading the BCMA coversheet and the patient"
^DIC(9.4,177,22,3,"PAH",82,1,14,0)="has an order with an administration schedule that does not have a whole"
^DIC(9.4,177,22,3,"PAH",82,1,15,0)="number of hour(s) frequency between administrations (e.g., 7 TIMEs A DAY,"
^DIC(9.4,177,22,3,"PAH",82,1,16,0)="ONCE EVERY 3.5 HOURS, etc.). The reason is because the program that"
^DIC(9.4,177,22,3,"PAH",82,1,17,0)="calculates the next dose's administration date/time assumed the frequency to"
^DIC(9.4,177,22,3,"PAH",82,1,18,0)="be a whole number of hours like 4 or 6 and not 3.1466 or 3.5. Since the"
^DIC(9.4,177,22,3,"PAH",82,1,19,0)="program could not come up with a valid date/time it went into an infinite"
^DIC(9.4,177,22,3,"PAH",82,1,20,0)="loop which would freeze the BCMA application when the users tried to view the"
^DIC(9.4,177,22,3,"PAH",82,1,21,0)="patient's coversheet."
^DIC(9.4,177,22,3,"PAH",82,1,22,0)="    "
^DIC(9.4,177,22,3,"PAH",82,1,23,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",82,1,24,0)="-----------"
^DIC(9.4,177,22,3,"PAH",82,1,25,0)="The routine PSBCSUTX was modified at line tag NEXTADM+24 to take into account"
^DIC(9.4,177,22,3,"PAH",82,1,26,0)="that the frequency of a schedule does not necessarily produces a whole number"
^DIC(9.4,177,22,3,"PAH",82,1,27,0)="of hours and it will calculate the next administration date/time for such"
^DIC(9.4,177,22,3,"PAH",82,1,28,0)="frequencies."
^DIC(9.4,177,22,3,"PAH",83,0)="100 SEQ #87^3180706.144442^54"
^DIC(9.4,177,22,3,"PAH",83,1,0)="^^3^3^3180706"
^DIC(9.4,177,22,3,"PAH",83,1,1,0)="This patch provides multi-division sites the ability to run the report "
^DIC(9.4,177,22,3,"PAH",83,1,2,0)="'Missing Dose Followup' by division. Single division sites are not "
^DIC(9.4,177,22,3,"PAH",83,1,3,0)="affected by the changes in this patch."
^DIC(9.4,177,22,3,"PAH",84,0)="109 SEQ #88^3180906.154925^54"
^DIC(9.4,177,22,3,"PAH",84,1,0)="^^21^21^3180906"
^DIC(9.4,177,22,3,"PAH",84,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",84,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",84,1,3,0)="INC0328665 - Issue with BCMA Missed Medications Report"
^DIC(9.4,177,22,3,"PAH",84,1,4,0)="   "
^DIC(9.4,177,22,3,"PAH",84,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",84,1,6,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",84,1,7,0)="INC0328665 - Issue with BCMA Missed Medications Report"
^DIC(9.4,177,22,3,"PAH",84,1,8,0)="      "
^DIC(9.4,177,22,3,"PAH",84,1,9,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",84,1,10,0)="--------"
^DIC(9.4,177,22,3,"PAH",84,1,11,0)="An issue was discovered with the Barcode Medication Administration (BCMA) "
^DIC(9.4,177,22,3,"PAH",84,1,12,0)="Missed Medications Report for 'odd' (non-standard) schedule orders, e.g."
^DIC(9.4,177,22,3,"PAH",84,1,13,0)="Q18H - ONCE EVERY 18 HOURS. When the report is run for a date range that"
^DIC(9.4,177,22,3,"PAH",84,1,14,0)="starts prior to the start date/time of such orders in some cases it will"
^DIC(9.4,177,22,3,"PAH",84,1,15,0)="mistakenly include these orders in the report even if the order does not"
^DIC(9.4,177,22,3,"PAH",84,1,16,0)="have any missing dose for the date range selected for the report."
^DIC(9.4,177,22,3,"PAH",84,1,17,0)="    "
^DIC(9.4,177,22,3,"PAH",84,1,18,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",84,1,19,0)="-----------"
^DIC(9.4,177,22,3,"PAH",84,1,20,0)="The routine PSBOMM was modified at line tag EN1+49 to prevent it from"
^DIC(9.4,177,22,3,"PAH",84,1,21,0)="calculating a dose date/time that is prior to the order start date/time."
^DIC(9.4,177,22,3,"PAH",85,0)="110^3181004.144649^54"
^DIC(9.4,177,22,3,"PAH",85,1,0)="^^39^39^3181004"
^DIC(9.4,177,22,3,"PAH",85,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",85,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",85,1,3,0)="INC0962039 - WNY - Vista Not Updating BCBU orders when patients are"
^DIC(9.4,177,22,3,"PAH",85,1,4,0)="             discharged/deceased"
^DIC(9.4,177,22,3,"PAH",85,1,5,0)="INC1002829 - BCBU patient census not updating"
^DIC(9.4,177,22,3,"PAH",85,1,6,0)="(Duplicate)"
^DIC(9.4,177,22,3,"PAH",85,1,7,0)="    "
^DIC(9.4,177,22,3,"PAH",85,1,8,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",85,1,9,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",85,1,10,0)="INC0962039 - WNY - Vista Not Updating BCBU orders when patients are"
^DIC(9.4,177,22,3,"PAH",85,1,11,0)="             discharged/deceased"
^DIC(9.4,177,22,3,"PAH",85,1,12,0)="INC1002829 - BCBU patient census not updating"
^DIC(9.4,177,22,3,"PAH",85,1,13,0)="(Duplicate)"
^DIC(9.4,177,22,3,"PAH",85,1,14,0)="       "
^DIC(9.4,177,22,3,"PAH",85,1,15,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",85,1,16,0)="--------"
^DIC(9.4,177,22,3,"PAH",85,1,17,0)="An issue was discovered with the Barcode Medication Administration (BCMA) "
^DIC(9.4,177,22,3,"PAH",85,1,18,0)="Backup System (BCBU) after the installation of patch PSB*3*105. After the"
^DIC(9.4,177,22,3,"PAH",85,1,19,0)="patient is discharged or a date of death is entered for him/her the patient"
^DIC(9.4,177,22,3,"PAH",85,1,20,0)="data is not being properly removed from the BCBU workstation. In the case of"
^DIC(9.4,177,22,3,"PAH",85,1,21,0)="discharged patient that are later admitted or have a clinic appointment their"
^DIC(9.4,177,22,3,"PAH",85,1,22,0)="orders from their previous admission are still visible on the BCBU"
^DIC(9.4,177,22,3,"PAH",85,1,23,0)="workstation and are listed on the patient's Medication Administration Reports"
^DIC(9.4,177,22,3,"PAH",85,1,24,0)="(MAR)."
^DIC(9.4,177,22,3,"PAH",85,1,25,0)="     "
^DIC(9.4,177,22,3,"PAH",85,1,26,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",85,1,27,0)="-----------"
^DIC(9.4,177,22,3,"PAH",85,1,28,0)="Removed the filter introduced by PSB*3*110 to prevent alerts from being"
^DIC(9.4,177,22,3,"PAH",85,1,29,0)="generated for patient movements if the patient is no longer inpatient. The"
^DIC(9.4,177,22,3,"PAH",85,1,30,0)="reason is because such filter prevented patient discharge events, which are"
^DIC(9.4,177,22,3,"PAH",85,1,31,0)="handled as patient movements, from removing he patient's data from the "
^DIC(9.4,177,22,3,"PAH",85,1,32,0)="BCBU workstation. The filter was re-introduced at the Alert generation point"
^DIC(9.4,177,22,3,"PAH",85,1,33,0)="and exclude patient discharge movements."
^DIC(9.4,177,22,3,"PAH",85,1,34,0)=" "
^DIC(9.4,177,22,3,"PAH",85,1,35,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",85,1,36,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",85,1,37,0)="Changed the routine ALPBCBU to remove the filter from the PMOV line tag and"
^DIC(9.4,177,22,3,"PAH",85,1,38,0)="placed a check in the ERRLOG line tag to prevent Alerts for patient movement"
^DIC(9.4,177,22,3,"PAH",85,1,39,0)="events after the patient had already been discharged. "
^DIC(9.4,177,22,3,"PAH",86,0)="111 SEQ #90^3181102.151502^54"
^DIC(9.4,177,22,3,"PAH",86,1,0)="^^9^9^3181102"
^DIC(9.4,177,22,3,"PAH",86,1,1,0)="Patch PSB*3.0*111 corrects one issue in the report 'Missing Dose "
^DIC(9.4,177,22,3,"PAH",86,1,2,0)="Followup'. The issue reported by a single site at a multidivisional "
^DIC(9.4,177,22,3,"PAH",86,1,3,0)="setting is that after one record is selected for completion and is saved,"
^DIC(9.4,177,22,3,"PAH",86,1,4,0)="it is not dropping off the list of available records. The expected"
^DIC(9.4,177,22,3,"PAH",86,1,5,0)="bahavior is that after one record in the report is completed and saved, it"
^DIC(9.4,177,22,3,"PAH",86,1,6,0)="should no be part of the list."
^DIC(9.4,177,22,3,"PAH",86,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",86,1,8,0)="Reference: INC1537335 - GLA - PBS*3*100 Patch Missing Dose Followup list "
^DIC(9.4,177,22,3,"PAH",86,1,9,0)="is not updating after resolving the missing dose."
^DIC(9.4,177,22,3,"PAH",87,0)="112 SEQ #91^3181204.155126^54"
^DIC(9.4,177,22,3,"PAH",87,1,0)="^^53^53^3181204"
^DIC(9.4,177,22,3,"PAH",87,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",87,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",87,1,3,0)="INC1697793 - BCMA med log and medication administration history reports"
^DIC(9.4,177,22,3,"PAH",87,1,4,0)="             display"
^DIC(9.4,177,22,3,"PAH",87,1,5,0)="     "
^DIC(9.4,177,22,3,"PAH",87,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",87,1,7,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",87,1,8,0)="INC1697793 - BCMA med log and medIcation administration history reports"
^DIC(9.4,177,22,3,"PAH",87,1,9,0)="             display"
^DIC(9.4,177,22,3,"PAH",87,1,10,0)="         "
^DIC(9.4,177,22,3,"PAH",87,1,11,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",87,1,12,0)="--------"
^DIC(9.4,177,22,3,"PAH",87,1,13,0)="Bath VA Medical Center reported a problem with the BCMA Medication Admin"
^DIC(9.4,177,22,3,"PAH",87,1,14,0)="History report for patch medication orders. For certain situations the report"
^DIC(9.4,177,22,3,"PAH",87,1,15,0)="omits a patch given action if the same patch removal date falls outside the"
^DIC(9.4,177,22,3,"PAH",87,1,16,0)="date range selected to run the report. In the report example below run "
^DIC(9.4,177,22,3,"PAH",87,1,17,0)="on 08/30/2018, for the date range 08/27/18 thru 08/29/2018 the 'G0800' under"
^DIC(9.4,177,22,3,"PAH",87,1,18,0)="the 08/29/2018 column would not be displayed because the patch applied on"
^DIC(9.4,177,22,3,"PAH",87,1,19,0)="08/29/2018 was already removed on 08/30/2018 and 08/30/2018 was not included"
^DIC(9.4,177,22,3,"PAH",87,1,20,0)="in the report date range."
^DIC(9.4,177,22,3,"PAH",87,1,21,0)=" "
^DIC(9.4,177,22,3,"PAH",87,1,22,0)="============================================================================="
^DIC(9.4,177,22,3,"PAH",87,1,23,0)="Location                      |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,24,0)="Start Date          Stop Date | Admin |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,25,0)="and Time            and Time  | Times | 08/27/2018 | 08/28/2018 | 08/29/2018|"
^DIC(9.4,177,22,3,"PAH",87,1,26,0)="-----------------------------------------------------------------------------"
^DIC(9.4,177,22,3,"PAH",87,1,27,0)="INPATIENT                     |       |            |            |           |     "
^DIC(9.4,177,22,3,"PAH",87,1,28,0)="08/25/2018          09/14/2018| 0800  | RM0755     | RM0755     | RM0755    |"
^DIC(9.4,177,22,3,"PAH",87,1,29,0)="@07:00              @08:00    |       | G0800      | G0800      | G0800 <-- | "
^DIC(9.4,177,22,3,"PAH",87,1,30,0)="                              |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,31,0)="FENTANYL TRANSDERMAL PATCH    |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,32,0)="   FENTANYL TRANSDERMAL       |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,33,0)="  50MCG/HR PATCH Give: ONE    |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,34,0)="(50MCG/HR) PATCH TOP MISC Q24H|       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,35,0)="                              |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,36,0)="     Removal Times: 0800      |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,37,0)=" RPH:   RN:                   |       |            |            |           |"
^DIC(9.4,177,22,3,"PAH",87,1,38,0)=" Special Instructions:"
^DIC(9.4,177,22,3,"PAH",87,1,39,0)=" TESTING BCMA PATCH ISSUE"
^DIC(9.4,177,22,3,"PAH",87,1,40,0)="-----------------------------------------------------------------------------"
^DIC(9.4,177,22,3,"PAH",87,1,41,0)=" "
^DIC(9.4,177,22,3,"PAH",87,1,42,0)="        "
^DIC(9.4,177,22,3,"PAH",87,1,43,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",87,1,44,0)="-----------"
^DIC(9.4,177,22,3,"PAH",87,1,45,0)="Modified the VistA code responsible for generating the report content to check"
^DIC(9.4,177,22,3,"PAH",87,1,46,0)="the 'Given' Date/Time when the 'Removal' Date/Time falls outside the date"
^DIC(9.4,177,22,3,"PAH",87,1,47,0)="range selected for the report. If the 'Given' Date/Time is within the date"
^DIC(9.4,177,22,3,"PAH",87,1,48,0)="range selected then the entry will be included in the report."
^DIC(9.4,177,22,3,"PAH",87,1,49,0)="  "
^DIC(9.4,177,22,3,"PAH",87,1,50,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",87,1,51,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",87,1,52,0)="Changed the routine PSBOMH1 at EN+5 and EN+9 to check for the 'Given' date"
^DIC(9.4,177,22,3,"PAH",87,1,53,0)="when the 'Removal' date falls outside the date range selected for the report."
^DIC(9.4,177,22,3,"PAH",88,0)="96 SEQ #92^3190103.162253^54"
^DIC(9.4,177,22,3,"PAH",88,1,0)="^^9^9^3190103"
^DIC(9.4,177,22,3,"PAH",88,1,1,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,177,22,3,"PAH",88,1,2,0)="(2FA) compliant the BCMA Graphical User Interface (GUI) requires an "
^DIC(9.4,177,22,3,"PAH",88,1,3,0)="upgrade to Delphi version XE8 in order to implement the new Remote "
^DIC(9.4,177,22,3,"PAH",88,1,4,0)="Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,177,22,3,"PAH",88,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",88,1,6,0)="This patch also updates the Med Order Button to utilize the same version "
^DIC(9.4,177,22,3,"PAH",88,1,7,0)="of the Dynamically Linked Library (DLL) as the Computerized Patient "
^DIC(9.4,177,22,3,"PAH",88,1,8,0)="Record System (CPRS).  The version number is controlled by the PSB MOB "
^DIC(9.4,177,22,3,"PAH",88,1,9,0)="DLL REQUIRED VERSION parameter."
^DIC(9.4,177,22,3,"PAH",89,0)="103 SEQ #93^3190201.152145^54"
^DIC(9.4,177,22,3,"PAH",89,1,0)="^^6^6^3190201"
^DIC(9.4,177,22,3,"PAH",89,1,1,0)="This patch addresses the request from NSR #20170515 - Adds Respiratory "
^DIC(9.4,177,22,3,"PAH",89,1,2,0)="Therapy Report."
^DIC(9.4,177,22,3,"PAH",89,1,3,0)="After this patch is installed, Respiratory Therapists will have access to "
^DIC(9.4,177,22,3,"PAH",89,1,4,0)="the new option Report for Respiratory Therapy Medications [PSB "
^DIC(9.4,177,22,3,"PAH",89,1,5,0)="RPT RESP THERAPY MEDS]    VistA to produce a report of patients on"
^DIC(9.4,177,22,3,"PAH",89,1,6,0)="Respiratory Therapy medications."
^DIC(9.4,177,22,3,"PAH",90,0)="115^3190402.161123^54"
^DIC(9.4,177,22,3,"PAH",90,1,0)="^^34^34^3190402"
^DIC(9.4,177,22,3,"PAH",90,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",90,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",90,1,3,0)="INC2794138 - When BCBU init is ran and only one HL7 link is entered it still"
^DIC(9.4,177,22,3,"PAH",90,1,4,0)="             updates numerous links"
^DIC(9.4,177,22,3,"PAH",90,1,5,0)=" "
^DIC(9.4,177,22,3,"PAH",90,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",90,1,7,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",90,1,8,0)="INC2794138 - When BCBU init is ran and only one HL7 link is entered it still"
^DIC(9.4,177,22,3,"PAH",90,1,9,0)="             updates numerous links"
^DIC(9.4,177,22,3,"PAH",90,1,10,0)="          "
^DIC(9.4,177,22,3,"PAH",90,1,11,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",90,1,12,0)="--------"
^DIC(9.4,177,22,3,"PAH",90,1,13,0)="Captain James A. Lovell Federal Health Care Center reported a problem with"
^DIC(9.4,177,22,3,"PAH",90,1,14,0)="the BCBU Initialize options below:"
^DIC(9.4,177,22,3,"PAH",90,1,15,0)=" "
^DIC(9.4,177,22,3,"PAH",90,1,16,0)="    Default Workstation Initialize [PSB BCBU INIT WRKSTN DFT]"
^DIC(9.4,177,22,3,"PAH",90,1,17,0)="    Divisional Workstation Initialize [PSB BCBU INIT WRKSTN DIV]"
^DIC(9.4,177,22,3,"PAH",90,1,18,0)=" "
^DIC(9.4,177,22,3,"PAH",90,1,19,0)="Whenever these options were executed and one or more Workstation Link were"
^DIC(9.4,177,22,3,"PAH",90,1,20,0)="selected for the initialization the option still generated and sent HL7"
^DIC(9.4,177,22,3,"PAH",90,1,21,0)="message updates to all other existing BCBU Workstation Links."
^DIC(9.4,177,22,3,"PAH",90,1,22,0)=" "
^DIC(9.4,177,22,3,"PAH",90,1,23,0)="Solution:"
^DIC(9.4,177,22,3,"PAH",90,1,24,0)="--------"
^DIC(9.4,177,22,3,"PAH",90,1,25,0)="The two Workstation Initialize options above were modified to screen out any"
^DIC(9.4,177,22,3,"PAH",90,1,26,0)="Workstation Link not selected from the HL7 update if the user selects one or"
^DIC(9.4,177,22,3,"PAH",90,1,27,0)="more specific Workstation Link(s) to update when executing these options. In"
^DIC(9.4,177,22,3,"PAH",90,1,28,0)="other words, only the selected Workstation Link(s) will be initialized."
^DIC(9.4,177,22,3,"PAH",90,1,29,0)="  "
^DIC(9.4,177,22,3,"PAH",90,1,30,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",90,1,31,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",90,1,32,0)="The routines ALPBIN, ALPBIND and ALPBINP were modified to keep track and "
^DIC(9.4,177,22,3,"PAH",90,1,33,0)="screen out Workstation Link(s) not selected for the HL7 initialization"
^DIC(9.4,177,22,3,"PAH",90,1,34,0)="update."
^DIC(9.4,177,22,3,"PAH",91,0)="114 SEQ #96^3190501.164415^54"
^DIC(9.4,177,22,3,"PAH",91,1,0)="^^34^34^3190501"
^DIC(9.4,177,22,3,"PAH",91,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",91,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",91,1,3,0)="INC2383720 - Error at REMOVES+23^PSBULTL unable to run report in BCMA"
^DIC(9.4,177,22,3,"PAH",91,1,4,0)="     "
^DIC(9.4,177,22,3,"PAH",91,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",91,1,6,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",91,1,7,0)="INC2383720 - Error at REMOVES+23^PSBULTL unable to run report in BCMA"
^DIC(9.4,177,22,3,"PAH",91,1,8,0)="         "
^DIC(9.4,177,22,3,"PAH",91,1,9,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",91,1,10,0)="--------"
^DIC(9.4,177,22,3,"PAH",91,1,11,0)="James A. Haley VA Medical Center reported a problem with the BCMA Missed "
^DIC(9.4,177,22,3,"PAH",91,1,12,0)="Medication Report. They were getting an error whenever they tried to run it "
^DIC(9.4,177,22,3,"PAH",91,1,13,0)="for a patient that had a PATCH medication order and the dispense drug had"
^DIC(9.4,177,22,3,"PAH",91,1,14,0)="been edited using the BCMA GUI. An additional side effect was the fact that"
^DIC(9.4,177,22,3,"PAH",91,1,15,0)="the order no longer showed on the patient's VDL."
^DIC(9.4,177,22,3,"PAH",91,1,16,0)="  "
^DIC(9.4,177,22,3,"PAH",91,1,17,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",91,1,18,0)="-----------"
^DIC(9.4,177,22,3,"PAH",91,1,19,0)="The error happened because the Transdermal Project patch PSB*3*83 assumed the"
^DIC(9.4,177,22,3,"PAH",91,1,20,0)="IEN for the DISPENSE DRUG sub-file (#53.796) in the BCMA MEDICATION LOG file"
^DIC(9.4,177,22,3,"PAH",91,1,21,0)="(#53.79) would always be 1 (one) for a PATCH medication order. Such"
^DIC(9.4,177,22,3,"PAH",91,1,22,0)="assumption turned out to be incorrect because when the user edits the"
^DIC(9.4,177,22,3,"PAH",91,1,23,0)="dispense drug for an order in BCMA the IEN 1 gets deleted and IEN 2 gets"
^DIC(9.4,177,22,3,"PAH",91,1,24,0)="created. If a second edit is performed IEN 2 is then deleted and IEN 3 gets"
^DIC(9.4,177,22,3,"PAH",91,1,25,0)="created and so forth. That's the reason the order would not show up on the "
^DIC(9.4,177,22,3,"PAH",91,1,26,0)="BCMA Patient's VDL and also caused the Missed Medication Report to error out."
^DIC(9.4,177,22,3,"PAH",91,1,27,0)="  "
^DIC(9.4,177,22,3,"PAH",91,1,28,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",91,1,29,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",91,1,30,0)="Changed the following routines: PSBMLEN, PSBMLEN1, PSBO1, PSBUTL, PSBVDLPA,"
^DIC(9.4,177,22,3,"PAH",91,1,31,0)="PSBVDLRM and PSBVDLVL to retrieve the first dispense drug in the DISPENSE"
^DIC(9.4,177,22,3,"PAH",91,1,32,0)="DRUG sub-file (#53.795) instead of assuming the IEN 1 to contain the order"
^DIC(9.4,177,22,3,"PAH",91,1,33,0)="dispense drug. For PATCH medication orders there should only be one dispense"
^DIC(9.4,177,22,3,"PAH",91,1,34,0)="drug."
^DIC(9.4,177,22,3,"PAH",92,0)="118 SEQ #97^3190604.18092^54"
^DIC(9.4,177,22,3,"PAH",92,1,0)="^^1^1^3190604"
^DIC(9.4,177,22,3,"PAH",92,1,1,0)="BCMA WINDOWS 10 AND DELPHI 10 UPDATE."
^DIC(9.4,177,22,3,"PAH",93,0)="116 SEQ #98^3190627.120407^65"
^DIC(9.4,177,22,3,"PAH",93,1,0)="^^42^42^3190627"
^DIC(9.4,177,22,3,"PAH",93,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",93,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",93,1,3,0)="INC3683945 - AEU can't look at med admin history (BCMA) due to an error after"
^DIC(9.4,177,22,3,"PAH",93,1,4,0)="             inputting a date range"
^DIC(9.4,177,22,3,"PAH",93,1,5,0)="INC3570947 - CPRS error caused by patch PSB*3*112, installed at our site on"
^DIC(9.4,177,22,3,"PAH",93,1,6,0)="(Duplicate)  12/11/2018"
^DIC(9.4,177,22,3,"PAH",93,1,7,0)="INC3507924 - In CPRS trying to run the Med Admin History report for 11-29"
^DIC(9.4,177,22,3,"PAH",93,1,8,0)="(Duplicate)  through 12-5 get the attached error message <UNDEFINED>EN+112^"
^DIC(9.4,177,22,3,"PAH",93,1,9,0)="             PSBOMH1 *PSBAR(64988)"
^DIC(9.4,177,22,3,"PAH",93,1,10,0)="INC4109840 - CPRS shuts down repeatedly when trying to access BCMA "
^DIC(9.4,177,22,3,"PAH",93,1,11,0)="(Duplicate)  medication history record in CPRS reports tab"
^DIC(9.4,177,22,3,"PAH",93,1,12,0)="      "
^DIC(9.4,177,22,3,"PAH",93,1,13,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",93,1,14,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",93,1,15,0)="INC3683945 - AEU can't look at med admin history (BCMA) due to an error after"
^DIC(9.4,177,22,3,"PAH",93,1,16,0)="             inputting a date range"
^DIC(9.4,177,22,3,"PAH",93,1,17,0)="INC3570947 - CPRS error caused by patch PSB*3*112, installed at our site on"
^DIC(9.4,177,22,3,"PAH",93,1,18,0)="(Duplicate)  12/11/2018"
^DIC(9.4,177,22,3,"PAH",93,1,19,0)="INC3507924 - In CPRS trying to run the Med Admin History report for 11-29"
^DIC(9.4,177,22,3,"PAH",93,1,20,0)="(Duplicate)  through 12-5 get the attached error message <UNDEFINED>EN+112^"
^DIC(9.4,177,22,3,"PAH",93,1,21,0)="             PSBOMH1 *PSBAR(64988)"
^DIC(9.4,177,22,3,"PAH",93,1,22,0)="INC4109840 - CPRS shuts down repeatedly when trying to access BCMA "
^DIC(9.4,177,22,3,"PAH",93,1,23,0)="(Duplicate)  medication history record in CPRS reports tab"
^DIC(9.4,177,22,3,"PAH",93,1,24,0)="               "
^DIC(9.4,177,22,3,"PAH",93,1,25,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",93,1,26,0)="--------"
^DIC(9.4,177,22,3,"PAH",93,1,27,0)="After the release of PSB*3*112 a new issue was introduced that caused the "
^DIC(9.4,177,22,3,"PAH",93,1,28,0)="BCMA Medication Admin History Report to cause an <UNDEFINED> error and exit"
^DIC(9.4,177,22,3,"PAH",93,1,29,0)="the BCMA GUI application. The problem is specific to a patient with a PATCH"
^DIC(9.4,177,22,3,"PAH",93,1,30,0)="Medication with a ONE TIME schedule (ex: Start Date of D and End Date of D+1)"
^DIC(9.4,177,22,3,"PAH",93,1,31,0)="and after the PATCH is given on day D and marked removed on day D+1, when the"
^DIC(9.4,177,22,3,"PAH",93,1,32,0)="user ran the report for the date Range D thru D the error happens."
^DIC(9.4,177,22,3,"PAH",93,1,33,0)=" "
^DIC(9.4,177,22,3,"PAH",93,1,34,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",93,1,35,0)="-----------"
^DIC(9.4,177,22,3,"PAH",93,1,36,0)="This patch prevents the error from happening when the BCMA Medication Admin"
^DIC(9.4,177,22,3,"PAH",93,1,37,0)="History Report is run following the instructions above."
^DIC(9.4,177,22,3,"PAH",93,1,38,0)="   "
^DIC(9.4,177,22,3,"PAH",93,1,39,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",93,1,40,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",93,1,41,0)="Changed the routines PSBOMH and PSBOMH1 to prevent the PSBAR array from "
^DIC(9.4,177,22,3,"PAH",93,1,42,0)="crashing when the subscript is undefined."
^DIC(9.4,177,22,3,"PAH",94,0)="113^3190722.171057^65"
^DIC(9.4,177,22,3,"PAH",94,1,0)="^^2^2^3190722"
^DIC(9.4,177,22,3,"PAH",94,1,1,0)="PSB*3.0*113 - Please refer to the patch description in Forum for "
^DIC(9.4,177,22,3,"PAH",94,1,2,0)="installation instructions."
^DIC(9.4,177,22,3,"PAH",95,0)="121 SEQ #100^3191206.15511^65"
^DIC(9.4,177,22,3,"PAH",95,1,0)="^^1^1^3191206"
^DIC(9.4,177,22,3,"PAH",95,1,1,0)="INC6279084 - Rx ONE TIME PRN orders not revert to active when undo on BCMA"
^DIC(9.4,177,22,3,"PAH",96,0)="101 SEQ #101^3191211.133803^65"
^DIC(9.4,177,22,3,"PAH",97,0)="122^3191219.144601^65"
^DIC(9.4,177,22,3,"PAH",97,1,0)="^^41^41^3191219"
^DIC(9.4,177,22,3,"PAH",97,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,177,22,3,"PAH",97,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",97,1,3,0)="INC3062938 - BCBU/VISTA"
^DIC(9.4,177,22,3,"PAH",97,1,4,0)="    "
^DIC(9.4,177,22,3,"PAH",97,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",97,1,6,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",97,1,7,0)="INC3062938 - BCBU/VISTA"
^DIC(9.4,177,22,3,"PAH",97,1,8,0)="        "
^DIC(9.4,177,22,3,"PAH",97,1,9,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",97,1,10,0)="--------"
^DIC(9.4,177,22,3,"PAH",97,1,11,0)="The South Texas Veterans Health Care Medical Center reported two problems"
^DIC(9.4,177,22,3,"PAH",97,1,12,0)="with the the Initialize a Backup Workstation with BCMA Users [PSB BCBU USER"
^DIC(9.4,177,22,3,"PAH",97,1,13,0)="INIT] option:"
^DIC(9.4,177,22,3,"PAH",97,1,14,0)="  1) Users were not able to access the BCBU workstations with their ACCESS/"
^DIC(9.4,177,22,3,"PAH",97,1,15,0)="     VERIFY codes after the option above was run. Thei ACCESS/VERIFY codes"
^DIC(9.4,177,22,3,"PAH",97,1,16,0)="     should match what they use in the main VistA account. Usually, a re-run"
^DIC(9.4,177,22,3,"PAH",97,1,17,0)="     of the option resolves the problem, which is not ideal."
^DIC(9.4,177,22,3,"PAH",97,1,18,0)="  2) If there are two users with similar names (e.g., 'NURSE,USER' and "
^DIC(9.4,177,22,3,"PAH",97,1,19,0)="     'NURSE,USER A' existed, the user with the shorter name would not be able"
^DIC(9.4,177,22,3,"PAH",97,1,20,0)="     to access the BCBU workstation, even after the second initialization."
^DIC(9.4,177,22,3,"PAH",97,1,21,0)="     "
^DIC(9.4,177,22,3,"PAH",97,1,22,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",97,1,23,0)="-----------"
^DIC(9.4,177,22,3,"PAH",97,1,24,0)="1) The setting of cross-references for the newly created users at the"
^DIC(9.4,177,22,3,"PAH",97,1,25,0)="   initialized BCBU workstation was being executed before their ACCESS/"
^DIC(9.4,177,22,3,"PAH",97,1,26,0)="   VERIFY codes were saved. To resolve the problem the cross-references"
^DIC(9.4,177,22,3,"PAH",97,1,27,0)="   setting was moved to run after the ACCESS/VERIFY codes are saved and it"
^DIC(9.4,177,22,3,"PAH",97,1,28,0)="   will address this problem."
^DIC(9.4,177,22,3,"PAH",97,1,29,0)="2) The problem happened because the user lookup for 'NURSE,USER' would"
^DIC(9.4,177,22,3,"PAH",97,1,30,0)="   find more than one match, 'NURSE,USER' and 'NURSE,USER A' which would"
^DIC(9.4,177,22,3,"PAH",97,1,31,0)="   prevent it from being updated. To resolve this problem the lookup call"
^DIC(9.4,177,22,3,"PAH",97,1,32,0)="   to find the user record was changed to perform and EXACT match for the"
^DIC(9.4,177,22,3,"PAH",97,1,33,0)="   user name. This way a lookup for 'NURSE,USER' will not find 'NURSE,USER "
^DIC(9.4,177,22,3,"PAH",97,1,34,0)="   A' as a possible match."
^DIC(9.4,177,22,3,"PAH",97,1,35,0)=" "
^DIC(9.4,177,22,3,"PAH",97,1,36,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",97,1,37,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",97,1,38,0)="1) Moved the call to IX1^DIK from line FILE+19 to FILE+23 in the ALPBGEN1"
^DIC(9.4,177,22,3,"PAH",97,1,39,0)="   routine, which is past the setting of the ACCESS/VERIFY codes."
^DIC(9.4,177,22,3,"PAH",97,1,40,0)="2) Changed the DIC(0)=""LM"" to DIC(0)=""LMX"" at line FILE+9 in the ALPBGEN1"
^DIC(9.4,177,22,3,"PAH",97,1,41,0)="   routine, which will force an exact match of the user name."
^DIC(9.4,177,22,3,"PAH",98,0)="120 SEQ #103^3200324.170217^70"
^DIC(9.4,177,22,3,"PAH",98,1,0)="^^43^43^3200324"
^DIC(9.4,177,22,3,"PAH",98,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,177,22,3,"PAH",98,1,2,0)="  "
^DIC(9.4,177,22,3,"PAH",98,1,3,0)="1. INC5649941 - Medication Patches with a continuous schedule (daily) "
^DIC(9.4,177,22,3,"PAH",98,1,4,0)="                do not show as administered when viewing the medication"
^DIC(9.4,177,22,3,"PAH",98,1,5,0)="                administration history report in CPRS with a date"
^DIC(9.4,177,22,3,"PAH",98,1,6,0)=" "
^DIC(9.4,177,22,3,"PAH",98,1,7,0)=" "
^DIC(9.4,177,22,3,"PAH",98,1,8,0)="New Service Requests (NSRs):"
^DIC(9.4,177,22,3,"PAH",98,1,9,0)="----------------------------  "
^DIC(9.4,177,22,3,"PAH",98,1,10,0)="N/A"
^DIC(9.4,177,22,3,"PAH",98,1,11,0)=" "
^DIC(9.4,177,22,3,"PAH",98,1,12,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,177,22,3,"PAH",98,1,13,0)="-----------------------------"
^DIC(9.4,177,22,3,"PAH",98,1,14,0)="N/A"
^DIC(9.4,177,22,3,"PAH",98,1,15,0)=" "
^DIC(9.4,177,22,3,"PAH",98,1,16,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",98,1,17,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",98,1,18,0)="1. INC5649941 - Medication Patches with a continuous schedule (daily) "
^DIC(9.4,177,22,3,"PAH",98,1,19,0)="                do not show as administered when viewing the medication"
^DIC(9.4,177,22,3,"PAH",98,1,20,0)="                administration history report in CPRS with a date "
^DIC(9.4,177,22,3,"PAH",98,1,21,0)="        "
^DIC(9.4,177,22,3,"PAH",98,1,22,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",98,1,23,0)="-------"
^DIC(9.4,177,22,3,"PAH",98,1,24,0)="The Canandaigua VA Medical Center reported that the Medication "
^DIC(9.4,177,22,3,"PAH",98,1,25,0)="Administration History (MAH) Report does not display all the"
^DIC(9.4,177,22,3,"PAH",98,1,26,0)="administration activity (given/removed) of continuous patch medication"
^DIC(9.4,177,22,3,"PAH",98,1,27,0)="orders depending on the date range selected for the report. When the date"
^DIC(9.4,177,22,3,"PAH",98,1,28,0)="range selected for the MAH report exceeds 7 days and there is a Given"
^DIC(9.4,177,22,3,"PAH",98,1,29,0)="activity for a patch medication on the last day of the first week, the"
^DIC(9.4,177,22,3,"PAH",98,1,30,0)="report will not display it if the patch was already Removed at the time"
^DIC(9.4,177,22,3,"PAH",98,1,31,0)="the report was ran."
^DIC(9.4,177,22,3,"PAH",98,1,32,0)="  "
^DIC(9.4,177,22,3,"PAH",98,1,33,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",98,1,34,0)="----------"
^DIC(9.4,177,22,3,"PAH",98,1,35,0)="This patch will correct the code to include the Given activity for a "
^DIC(9.4,177,22,3,"PAH",98,1,36,0)="patch on the last day of the first week in the report."
^DIC(9.4,177,22,3,"PAH",98,1,37,0)="     "
^DIC(9.4,177,22,3,"PAH",98,1,38,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",98,1,39,0)="--------------------"
^DIC(9.4,177,22,3,"PAH",98,1,40,0)="The code at the EN+62 on the PSBOMH1 routine was not taking into account"
^DIC(9.4,177,22,3,"PAH",98,1,41,0)="that the Given date for the order being processed could fall on the week"
^DIC(9.4,177,22,3,"PAH",98,1,42,0)="before the week of the Removal in the report. The code was changed to"
^DIC(9.4,177,22,3,"PAH",98,1,43,0)="include the Given activity in the correct week of the report."
^DIC(9.4,177,22,3,"PAH",99,0)="125^3200624.142005^65"
^DIC(9.4,177,22,3,"PAH",99,1,0)="^^57^57^3200624"
^DIC(9.4,177,22,3,"PAH",99,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,177,22,3,"PAH",99,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,3,0)="1) INC8817299 - BCBU MAR Shows Expired Meds as Requiring Administration"
^DIC(9.4,177,22,3,"PAH",99,1,4,0)="2) INC9226190 - BCMA Contingency program requires verify code be changed"
^DIC(9.4,177,22,3,"PAH",99,1,5,0)="                each time you log into the program"
^DIC(9.4,177,22,3,"PAH",99,1,6,0)="   INC9209704(d) - Modify MIW BCMA BU devices to prevent users from needing"
^DIC(9.4,177,22,3,"PAH",99,1,7,0)="                   to create a secondary Verify Code"
^DIC(9.4,177,22,3,"PAH",99,1,8,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,9,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",99,1,10,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",99,1,11,0)="1) INC8817299 -BCBU MAR Shows Expired Meds as Requiring Administration"
^DIC(9.4,177,22,3,"PAH",99,1,12,0)="          "
^DIC(9.4,177,22,3,"PAH",99,1,13,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",99,1,14,0)="--------"
^DIC(9.4,177,22,3,"PAH",99,1,15,0)="BCBU MAR reports were showing medications on the grid as needing"
^DIC(9.4,177,22,3,"PAH",99,1,16,0)="administration on their Stop date/time, when the time value ends in a zero,"
^DIC(9.4,177,22,3,"PAH",99,1,17,0)="e.g. 0900 & 0930.  "
^DIC(9.4,177,22,3,"PAH",99,1,18,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,19,0)="Solution:"
^DIC(9.4,177,22,3,"PAH",99,1,20,0)="--------"
^DIC(9.4,177,22,3,"PAH",99,1,21,0)="Correct BCBU routine ALPBFRM1 to put asterisks in that time cell on the MAR"
^DIC(9.4,177,22,3,"PAH",99,1,22,0)="Grid."
^DIC(9.4,177,22,3,"PAH",99,1,23,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,24,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",99,1,25,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",99,1,26,0)="In routine ALPBFRM1, ""+"" the variable, when it is created after it"
^DIC(9.4,177,22,3,"PAH",99,1,27,0)="concatenates the time to the end of the date.  This will trim off "
^DIC(9.4,177,22,3,"PAH",99,1,28,0)="insignificant trailing zeros, prior to later compare operations checking if"
^DIC(9.4,177,22,3,"PAH",99,1,29,0)="the grid cell date.time is = to the stop date.time of this order."
^DIC(9.4,177,22,3,"PAH",99,1,30,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,31,0)="2) INC9226190 - BCMA Contingency program requires verify code be changed"
^DIC(9.4,177,22,3,"PAH",99,1,32,0)="                each time you log into the program"
^DIC(9.4,177,22,3,"PAH",99,1,33,0)="      "
^DIC(9.4,177,22,3,"PAH",99,1,34,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",99,1,35,0)="--------"
^DIC(9.4,177,22,3,"PAH",99,1,36,0)="VA Western New York Healthcare System at Buffalo reported that after patch"
^DIC(9.4,177,22,3,"PAH",99,1,37,0)="PSB*3*122 was installed the Initialize a Backup Workstation with BCMA Users "
^DIC(9.4,177,22,3,"PAH",99,1,38,0)="[PSB BCBU USER INIT] option which is used to send BCMA users over from VistA"
^DIC(9.4,177,22,3,"PAH",99,1,39,0)="to the BCBU workstation was forcing the users to change their VERIFY CODE at"
^DIC(9.4,177,22,3,"PAH",99,1,40,0)="the BCBU workstations when they tried to logon. It was confirmed that the"
^DIC(9.4,177,22,3,"PAH",99,1,41,0)="issue was introduced by PSB*3*122. In order to fix the problem that required"
^DIC(9.4,177,22,3,"PAH",99,1,42,0)="the option above to be run twice in order for the new users ACCESS/VERIFY "
^DIC(9.4,177,22,3,"PAH",99,1,43,0)="CODEs to work the re-indexing of the new records on the NEW PERSON file (#200) "
^DIC(9.4,177,22,3,"PAH",99,1,44,0)="was moved past the ""hard setting"" of ACCESS/VERIFY CODEs, which resolved the"
^DIC(9.4,177,22,3,"PAH",99,1,45,0)="original but the re-indexing also treats the ACCESS CODE as new and therefore"
^DIC(9.4,177,22,3,"PAH",99,1,46,0)="forces a new VERIFY CODE to be entered by the user at the BCBU workstation."
^DIC(9.4,177,22,3,"PAH",99,1,47,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,48,0)="Solution:"
^DIC(9.4,177,22,3,"PAH",99,1,49,0)="--------"
^DIC(9.4,177,22,3,"PAH",99,1,50,0)="Kept the ""hard setting"" of the ACCESS CODE prior to re-indexing the new record"
^DIC(9.4,177,22,3,"PAH",99,1,51,0)="in the NEW PERSON file (#200) but moved the ""hard setting"" of the VERIFY CODE"
^DIC(9.4,177,22,3,"PAH",99,1,52,0)="information after the re-indexing which addresses the issue."
^DIC(9.4,177,22,3,"PAH",99,1,53,0)=" "
^DIC(9.4,177,22,3,"PAH",99,1,54,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",99,1,55,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",99,1,56,0)="Moved the call ""D IX1^DIK"" up to FILE+20, before setting the VERIFY CODE "
^DIC(9.4,177,22,3,"PAH",99,1,57,0)="information."
^DIC(9.4,177,22,3,"PAH",100,0)="124 SEQ #105^3200727.104925^65"
^DIC(9.4,177,22,3,"PAH",100,1,0)="^^2^2^3200727"
^DIC(9.4,177,22,3,"PAH",100,1,1,0)="INC8883572 - PRN orders during undo-given in BCMA sending invalid Mailman "
^DIC(9.4,177,22,3,"PAH",100,1,2,0)="messages."
^DIC(9.4,177,22,3,"PAH",101,0)="127^3201208.0909^17"
^DIC(9.4,177,22,3,"PAH",101,1,0)="^^33^33^3201208"
^DIC(9.4,177,22,3,"PAH",101,1,1,0)="This patch, in conjunction with PSJ*5*406, will resolve the following issue:"
^DIC(9.4,177,22,3,"PAH",101,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",101,1,3,0)="1) INC11397447 - BCMA Backup workstation patient print out and order display"
^DIC(9.4,177,22,3,"PAH",101,1,4,0)="                 removal times for INHALATION Medications"
^DIC(9.4,177,22,3,"PAH",101,1,5,0)="  "
^DIC(9.4,177,22,3,"PAH",101,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",101,1,7,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",101,1,8,0)="1) INC11397447 - BCMA Backup workstation patient print out and order display"
^DIC(9.4,177,22,3,"PAH",101,1,9,0)="                 removal times for INHALATION Medications"
^DIC(9.4,177,22,3,"PAH",101,1,10,0)="           "
^DIC(9.4,177,22,3,"PAH",101,1,11,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",101,1,12,0)="--------"
^DIC(9.4,177,22,3,"PAH",101,1,13,0)="The VA North Texas Health Care System reported that when displaying and"
^DIC(9.4,177,22,3,"PAH",101,1,14,0)="printing patient order the print out includes removal times for medications"
^DIC(9.4,177,22,3,"PAH",101,1,15,0)="that does not require removal. The source of the problem was identified in"
^DIC(9.4,177,22,3,"PAH",101,1,16,0)="the schedule used for these orders. If it contains the ampersand character"
^DIC(9.4,177,22,3,"PAH",101,1,17,0)="(&), e.g. AC&HS, it shifts fields within the HL7 message communicated between"
^DIC(9.4,177,22,3,"PAH",101,1,18,0)="the main VistA system and the BCBU workstation, which causes it to populate"
^DIC(9.4,177,22,3,"PAH",101,1,19,0)="the REMOVE TIMING field (#7.4) within the ORDER NUMBER sub-file (#53.701) in"
^DIC(9.4,177,22,3,"PAH",101,1,20,0)="the BCMA BACKUP DATA file (#53.7)."
^DIC(9.4,177,22,3,"PAH",101,1,21,0)="  "
^DIC(9.4,177,22,3,"PAH",101,1,22,0)="Solution:"
^DIC(9.4,177,22,3,"PAH",101,1,23,0)="--------"
^DIC(9.4,177,22,3,"PAH",101,1,24,0)="Changed the routine PSJHL3 via the PSJ*5*406 patch to escape the schedule "
^DIC(9.4,177,22,3,"PAH",101,1,25,0)="field value before including it in the HL7 message bound to the BCBU "
^DIC(9.4,177,22,3,"PAH",101,1,26,0)="workstation and changed the processing of the incoming message to un-scape "
^DIC(9.4,177,22,3,"PAH",101,1,27,0)="schedule field value before parsing when at the BCBU workstation. "
^DIC(9.4,177,22,3,"PAH",101,1,28,0)=" "
^DIC(9.4,177,22,3,"PAH",101,1,29,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",101,1,30,0)="---------------------"
^DIC(9.4,177,22,3,"PAH",101,1,31,0)="This patch changes the routine ALPBHL1U  at line tag RXE+29 to un-escape the"
^DIC(9.4,177,22,3,"PAH",101,1,32,0)="schedule field value before parsing when processing the incoming HL7 message"
^DIC(9.4,177,22,3,"PAH",101,1,33,0)="at the BCBU workstation. "
^DIC(9.4,177,22,3,"PAH",102,0)="130b^3210429"
^DIC(9.4,177,22,3,"PAH",102,1,0)="^^5^5^3210429"
^DIC(9.4,177,22,3,"PAH",102,1,1,0)="Backup of PSB*3.0*130 on Apr 29, 2021"
^DIC(9.4,177,22,3,"PAH",102,1,2,0)=" "
^DIC(9.4,177,22,3,"PAH",102,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,177,22,3,"PAH",102,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,177,22,3,"PAH",102,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,177,22,3,"PAH",103,0)="130 SEQ #107^3210429.142339^17"
^DIC(9.4,177,22,3,"PAH",103,1,0)="^^41^41^3210429"
^DIC(9.4,177,22,3,"PAH",103,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,177,22,3,"PAH",103,1,2,0)="  "
^DIC(9.4,177,22,3,"PAH",103,1,3,0)="1) INC14580997 - BCMA Missing Dose Routing BUG"
^DIC(9.4,177,22,3,"PAH",103,1,4,0)="   HITPS-7596"
^DIC(9.4,177,22,3,"PAH",103,1,5,0)="   "
^DIC(9.4,177,22,3,"PAH",103,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,177,22,3,"PAH",103,1,7,0)="--------------------------------------------"
^DIC(9.4,177,22,3,"PAH",103,1,8,0)="1) INC14580997 - BCMA Missing Dose Routing BUG"
^DIC(9.4,177,22,3,"PAH",103,1,9,0)="   HITPS-7596"
^DIC(9.4,177,22,3,"PAH",103,1,10,0)=" "
^DIC(9.4,177,22,3,"PAH",103,1,11,0)="Problem: "
^DIC(9.4,177,22,3,"PAH",103,1,12,0)="-------"
^DIC(9.4,177,22,3,"PAH",103,1,13,0)="The Audie L. Murphy Memorial Veterans' Hospital reported that when they"
^DIC(9.4,177,22,3,"PAH",103,1,14,0)="submitted a missing dose for an inpatient order with 3 or more dispense drugs"
^DIC(9.4,177,22,3,"PAH",103,1,15,0)="associated with it and later scanned the medication received BCMA Med Logs only"
^DIC(9.4,177,22,3,"PAH",103,1,16,0)="had a record of the first and last dispense drug associated with the order."
^DIC(9.4,177,22,3,"PAH",103,1,17,0)="Some orders require a combination of dispense drugs to achieve the exact dose"
^DIC(9.4,177,22,3,"PAH",103,1,18,0)="ordered. For example: an order of 75MG for Prednisone would require a"
^DIC(9.4,177,22,3,"PAH",103,1,19,0)="combination of 3 20MG tablets, plus 1 10MG table plus 1 5MG tablet. Upon"
^DIC(9.4,177,22,3,"PAH",103,1,20,0)="research it was determined that this issue was introduced by patch PSB*3*99,"
^DIC(9.4,177,22,3,"PAH",103,1,21,0)="issue #3 (I9892810FY16). In addressing that issue the patch accidentally"
^DIC(9.4,177,22,3,"PAH",103,1,22,0)="introduced the issue reported above. This issue is also being considered a"
^DIC(9.4,177,22,3,"PAH",103,1,23,0)="Patient Safety Issue (PSI) and the number assigned by the Patient Safety team"
^DIC(9.4,177,22,3,"PAH",103,1,24,0)="is HITPS-7596."
^DIC(9.4,177,22,3,"PAH",103,1,25,0)="      "
^DIC(9.4,177,22,3,"PAH",103,1,26,0)="Resolution:"
^DIC(9.4,177,22,3,"PAH",103,1,27,0)="----------"
^DIC(9.4,177,22,3,"PAH",103,1,28,0)="The software was modified to prevent the deletion of some of the dispense"
^DIC(9.4,177,22,3,"PAH",103,1,29,0)="drugs in the BCMA Medication Log when 3 or more dispense drugs are marked"
^DIC(9.4,177,22,3,"PAH",103,1,30,0)="missing doses on an order and later are scanned. "
^DIC(9.4,177,22,3,"PAH",103,1,31,0)=" "
^DIC(9.4,177,22,3,"PAH",103,1,32,0)="Technical Resolution:"
^DIC(9.4,177,22,3,"PAH",103,1,33,0)="--------------------"
^DIC(9.4,177,22,3,"PAH",103,1,34,0)="Modified the line UPDATED+97 on the routine PSBML2 to not mark a dispense drug"
^DIC(9.4,177,22,3,"PAH",103,1,35,0)="to be deleted from the BCMA Medication Log if it was previously populated with"
^DIC(9.4,177,22,3,"PAH",103,1,36,0)="an valid dispense drug in the order."
^DIC(9.4,177,22,3,"PAH",103,1,37,0)=" "
^DIC(9.4,177,22,3,"PAH",103,1,38,0)="    "
^DIC(9.4,177,22,3,"PAH",103,1,39,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,177,22,3,"PAH",103,1,40,0)="-----------------------------"
^DIC(9.4,177,22,3,"PAH",103,1,41,0)="HITPS-7596"
