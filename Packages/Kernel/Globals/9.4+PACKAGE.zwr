^DIC(9.4,73,4,3,222)="y^y^^n^^^n^^n"
^DIC(9.4,73,4,5,0)=537015
^DIC(9.4,73,4,5,222)="y^y^^n^^^y^m^n"
^DIC(9.4,73,4,"B",537000,1)=""
^DIC(9.4,73,4,"B",537010,3)=""
^DIC(9.4,73,4,"B",537015,5)=""
^DIC(9.4,73,4,"B",537025,2)=""
^DIC(9.4,73,5)="WestChicago/SFIRMFO"
^DIC(9.4,73,7)="^^I"
^DIC(9.4,73,11)="537000^537025"
^DIC(9.4,73,22,0)="^9.49I^9^1"
^DIC(9.4,73,22,9,0)="5.1^3051119^2960716"
^DIC(9.4,73,22,9,"PAH",0)="^9.4901^23^23"
^DIC(9.4,73,22,9,"PAH",1,0)="5^2970312^1"
^DIC(9.4,73,22,9,"PAH",1,1,0)="^^142^142^2970312"
^DIC(9.4,73,22,9,"PAH",1,1,1,0)=" 4 routines have been modified in this patch:"
^DIC(9.4,73,22,9,"PAH",1,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,3,0)="    1. AFJXPNHX Multiple sites have reported problems in routine AFJXPNHX"
^DIC(9.4,73,22,9,"PAH",1,1,4,0)="       at QNEW+2. It appears that multiple jobs, not necessarily the NHE"
^DIC(9.4,73,22,9,"PAH",1,1,5,0)="       purge, are running at the same time. These routines are"
^DIC(9.4,73,22,9,"PAH",1,1,6,0)="       manipulating and deleting messages in the mailboxes and mail"
^DIC(9.4,73,22,9,"PAH",1,1,7,0)="       global.  This patch is generated to remove the effects of the"
^DIC(9.4,73,22,9,"PAH",1,1,8,0)="       unwanted job interference.  "
^DIC(9.4,73,22,9,"PAH",1,1,9,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,10,0)="    2. AFJXWCP8 The routine AFJXWCP8 was found to contain references to"
^DIC(9.4,73,22,9,"PAH",1,1,11,0)="       file 6 and to file 16. The pointers are now properly referenced to"
^DIC(9.4,73,22,9,"PAH",1,1,12,0)="       file 200.  "
^DIC(9.4,73,22,9,"PAH",1,1,13,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,14,0)="    3. AFJXADHD It was reported that the security alert bulletin on"
^DIC(9.4,73,22,9,"PAH",1,1,15,0)="       sensitive data access occasionally was not generated. A secondary"
^DIC(9.4,73,22,9,"PAH",1,1,16,0)="       access path was discovered through routine AFJXADHD. AFJXADHD is"
^DIC(9.4,73,22,9,"PAH",1,1,17,0)="       now modified to handle the generation of bulletins the same as in"
^DIC(9.4,73,22,9,"PAH",1,1,18,0)="       routine AFJXALRT (which was previously modified to handle this"
^DIC(9.4,73,22,9,"PAH",1,1,19,0)="       problem)."
^DIC(9.4,73,22,9,"PAH",1,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,21,0)="    4. AFJXWCPM A site has reported a problem with BOLD being undefined at"
^DIC(9.4,73,22,9,"PAH",1,1,22,0)="       line OPTION in routine AFJXWCPM. This results from IOST(0) either"
^DIC(9.4,73,22,9,"PAH",1,1,23,0)="       being undefined or more probably set to null. Examination shows"
^DIC(9.4,73,22,9,"PAH",1,1,24,0)="       that in such cases BOLD and BOLF are equally apt to cause problems."
^DIC(9.4,73,22,9,"PAH",1,1,25,0)="       The modification made to clear this problem is to hard set BOLD AND"
^DIC(9.4,73,22,9,"PAH",1,1,26,0)="       BOLF to null before IOST(0) is checked and BOLD and BOLF are"
^DIC(9.4,73,22,9,"PAH",1,1,27,0)="       updated.  "
^DIC(9.4,73,22,9,"PAH",1,1,28,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,29,0)=" NOIS HISTORY: "
^DIC(9.4,73,22,9,"PAH",1,1,30,0)=" ============="
^DIC(9.4,73,22,9,"PAH",1,1,31,0)="    The AFJXPNHX problem (undefined in the nightly purge) was reported in"
^DIC(9.4,73,22,9,"PAH",1,1,32,0)="    NOIS ATG-0996-31958, BUT-0896-22000, and FHM-0896-51544."
^DIC(9.4,73,22,9,"PAH",1,1,33,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,34,0)="    There has been an access to restricted data problem uncovered in"
^DIC(9.4,73,22,9,"PAH",1,1,35,0)="    routine AFJXADHD (NOIS SBY-1296-30637)."
^DIC(9.4,73,22,9,"PAH",1,1,36,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,37,0)="    A site has reported a problem with BOLD being undefined at line OPTION"
^DIC(9.4,73,22,9,"PAH",1,1,38,0)="    in routine AFJXWCPM (NOIS DAY-0197-40124). This results from IOST(0)"
^DIC(9.4,73,22,9,"PAH",1,1,39,0)="    either being undefined or more probably set to null."
^DIC(9.4,73,22,9,"PAH",1,1,40,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,41,0)=" PATCH HISTORY: "
^DIC(9.4,73,22,9,"PAH",1,1,42,0)=" =============="
^DIC(9.4,73,22,9,"PAH",1,1,43,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,44,0)="    This patch clears the undefined in the nightly purge problems by"
^DIC(9.4,73,22,9,"PAH",1,1,45,0)="    presetting variables used in setting up VA FileMan multiple nodes to"
^DIC(9.4,73,22,9,"PAH",1,1,46,0)="    null. An environmental routine was added to ensure a proper"
^DIC(9.4,73,22,9,"PAH",1,1,47,0)="    sequencing.  "
^DIC(9.4,73,22,9,"PAH",1,1,48,0)="  "
^DIC(9.4,73,22,9,"PAH",1,1,49,0)="    The AFJXPNHX changes in this patch were originally issued as"
^DIC(9.4,73,22,9,"PAH",1,1,50,0)="    AFJX*5.1*4 which was made entered in error due to an error in"
^DIC(9.4,73,22,9,"PAH",1,1,51,0)="    selection of routines contained (NOIS LEA-1196-41840).  This has been"
^DIC(9.4,73,22,9,"PAH",1,1,52,0)="    updated correctly in AFJX*5.1*5."
^DIC(9.4,73,22,9,"PAH",1,1,53,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,54,0)="    In the previous AFJX patches the Patch to Package file link was not"
^DIC(9.4,73,22,9,"PAH",1,1,55,0)="    included. As a reult, the package patch history is incomplete. The"
^DIC(9.4,73,22,9,"PAH",1,1,56,0)="    sites are requested to manually update the patch history in the"
^DIC(9.4,73,22,9,"PAH",1,1,57,0)="    Package File to indicate that patches 1 through 3 for AFJX are entered"
^DIC(9.4,73,22,9,"PAH",1,1,58,0)="    into the production routines. Patch 4 was declared to have been"
^DIC(9.4,73,22,9,"PAH",1,1,59,0)="    entered in error, hence need not be entered."
^DIC(9.4,73,22,9,"PAH",1,1,60,0)="                                                          "
^DIC(9.4,73,22,9,"PAH",1,1,61,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,62,0)="  Routine Summary: "
^DIC(9.4,73,22,9,"PAH",1,1,63,0)="  ================"
^DIC(9.4,73,22,9,"PAH",1,1,64,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,65,0)="    The following is a list of the routines included in this patch. The"
^DIC(9.4,73,22,9,"PAH",1,1,66,0)="    second line value of each of these routines will look like: "
^DIC(9.4,73,22,9,"PAH",1,1,67,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,68,0)="       <tab>;;5.1;Network Health Exchange;**[patch list]**;date "
^DIC(9.4,73,22,9,"PAH",1,1,69,0)="                           *                                *"
^DIC(9.4,73,22,9,"PAH",1,1,70,0)="    Routine Name     Before Patch     After Patch       Patch List "
^DIC(9.4,73,22,9,"PAH",1,1,71,0)="    ============     ============     ===========       =========="
^DIC(9.4,73,22,9,"PAH",1,1,72,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,73,0)="    AFJXPNHX        3809052          3887585            1,5 "
^DIC(9.4,73,22,9,"PAH",1,1,74,0)="    AFJXWCP8        6965692          6959884            5 "
^DIC(9.4,73,22,9,"PAH",1,1,75,0)="    AFJXADHD       15132754         15482706            5 "
^DIC(9.4,73,22,9,"PAH",1,1,76,0)="    AFJXWCPM        7335889          7680509            5 "
^DIC(9.4,73,22,9,"PAH",1,1,77,0)="    AFJXEN4           N/A            8495220            5 "
^DIC(9.4,73,22,9,"PAH",1,1,78,0)="  "
^DIC(9.4,73,22,9,"PAH",1,1,79,0)="  * From CHECK^XTSUMBLD "
^DIC(9.4,73,22,9,"PAH",1,1,80,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,81,0)="  Environmental Check Routine "
^DIC(9.4,73,22,9,"PAH",1,1,82,0)="  ==========================="
^DIC(9.4,73,22,9,"PAH",1,1,83,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,84,0)="    The environmental check routine is AFJXEN4 which checks the version "
^DIC(9.4,73,22,9,"PAH",1,1,85,0)="    and patch levels of the NHE package installed. Routine AFJXEN4 may be "
^DIC(9.4,73,22,9,"PAH",1,1,86,0)="    removed by the station upon successful installation of this patch.  "
^DIC(9.4,73,22,9,"PAH",1,1,87,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,88,0)="  Installation Instructions: "
^DIC(9.4,73,22,9,"PAH",1,1,89,0)="  =========================="
^DIC(9.4,73,22,9,"PAH",1,1,90,0)="    WHEN?: Anytime. This patch is so brief (only four routines and an "
^DIC(9.4,73,22,9,"PAH",1,1,91,0)="    environmental check routine) that it should not be queued.  "
^DIC(9.4,73,22,9,"PAH",1,1,92,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,93,0)="    HOW LONG?:  Installation will take less than 2 minutes.  "
^DIC(9.4,73,22,9,"PAH",1,1,94,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,95,0)="    1. Use the INSTALL/CHECK MESSAGE option on the PackMan and respond "
^DIC(9.4,73,22,9,"PAH",1,1,96,0)="       YES at the prompt 'Want to Continue with load?  YES// <return>.  "
^DIC(9.4,73,22,9,"PAH",1,1,97,0)="                                                       ==="
^DIC(9.4,73,22,9,"PAH",1,1,98,0)="    2. Review your Mapped Routine set. If any of the routines listed in "
^DIC(9.4,73,22,9,"PAH",1,1,99,0)="       the ROUTINE SUMMARY section are mapped on your system, they should "
^DIC(9.4,73,22,9,"PAH",1,1,100,0)="       be removed from the Mapped set at this time.  "
^DIC(9.4,73,22,9,"PAH",1,1,101,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,102,0)="    3. From the Kernel Installation and Distribution System Menu, select "
^DIC(9.4,73,22,9,"PAH",1,1,103,0)="       the Installation menu.  "
^DIC(9.4,73,22,9,"PAH",1,1,104,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,105,0)="    4. From the Installation menu, you may elect to use the following "
^DIC(9.4,73,22,9,"PAH",1,1,106,0)="       options (when prompted for the install name, enter AFJX*5.1*5): "
^DIC(9.4,73,22,9,"PAH",1,1,107,0)="                                                          =========="
^DIC(9.4,73,22,9,"PAH",1,1,108,0)="       a. Backup a Transport Global - this option will create a backup "
^DIC(9.4,73,22,9,"PAH",1,1,109,0)="          message of any routines exported with the patch. It will NOT "
^DIC(9.4,73,22,9,"PAH",1,1,110,0)="          backup any other changes such as DDs or templates.  "
^DIC(9.4,73,22,9,"PAH",1,1,111,0)="       b. Compare Transport Global to the Current System - this option "
^DIC(9.4,73,22,9,"PAH",1,1,112,0)="          will allow you to view all changes that will be made when the "
^DIC(9.4,73,22,9,"PAH",1,1,113,0)="          patch is installed. It compares all components of the patch "
^DIC(9.4,73,22,9,"PAH",1,1,114,0)="          (routines, DDs, templates, etc.).  "
^DIC(9.4,73,22,9,"PAH",1,1,115,0)="       c. Verify checksums in the Transport Global - this option will "
^DIC(9.4,73,22,9,"PAH",1,1,116,0)="          allow you to ensure the integrity of the routines that are in "
^DIC(9.4,73,22,9,"PAH",1,1,117,0)="          the Transport Global.  "
^DIC(9.4,73,22,9,"PAH",1,1,118,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,119,0)="    5. Use the Install Package(s) options and select the package:"
^DIC(9.4,73,22,9,"PAH",1,1,120,0)="          AFJX*5.1*5."
^DIC(9.4,73,22,9,"PAH",1,1,121,0)="          =========="
^DIC(9.4,73,22,9,"PAH",1,1,122,0)="  "
^DIC(9.4,73,22,9,"PAH",1,1,123,0)="    6. When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,73,22,9,"PAH",1,1,124,0)="       Protocols? Yes// <return>, respond YES. When prompted to select the"
^DIC(9.4,73,22,9,"PAH",1,1,125,0)="                                          ==="
^DIC(9.4,73,22,9,"PAH",1,1,126,0)="       option(s) you would like to place out of order, enter the"
^DIC(9.4,73,22,9,"PAH",1,1,127,0)="       following: "
^DIC(9.4,73,22,9,"PAH",1,1,128,0)="   "
^DIC(9.4,73,22,9,"PAH",1,1,129,0)="          AFJXNHEX REQUEST "
^DIC(9.4,73,22,9,"PAH",1,1,130,0)="          ================"
^DIC(9.4,73,22,9,"PAH",1,1,131,0)="          AFJX PURGE NIGHTLY "
^DIC(9.4,73,22,9,"PAH",1,1,132,0)="          =================="
^DIC(9.4,73,22,9,"PAH",1,1,133,0)="  "
^DIC(9.4,73,22,9,"PAH",1,1,134,0)="    7. MSM sites:  Please ensure you answer YES when asked if you want "
^DIC(9.4,73,22,9,"PAH",1,1,135,0)="       to move the routines to other systems and indicate the appropriate"
^DIC(9.4,73,22,9,"PAH",1,1,136,0)="       CPUs. Alternatively, you can wait until the installation is"
^DIC(9.4,73,22,9,"PAH",1,1,137,0)="       complete and move the routines listed in the Routine Summary"
^DIC(9.4,73,22,9,"PAH",1,1,138,0)="       Section to all systems.  "
^DIC(9.4,73,22,9,"PAH",1,1,139,0)=" "
^DIC(9.4,73,22,9,"PAH",1,1,140,0)="    8. If the routines were unmapped as part of step 2, they should be"
^DIC(9.4,73,22,9,"PAH",1,1,141,0)="       returned to the Mapped set once the installation has run to"
^DIC(9.4,73,22,9,"PAH",1,1,142,0)="       completion. "
^DIC(9.4,73,22,9,"PAH",2,0)="6^2970501^1"
^DIC(9.4,73,22,9,"PAH",2,1,0)="^^189^189^2970501"
^DIC(9.4,73,22,9,"PAH",2,1,1,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,2,0)="Prerequisites: "
^DIC(9.4,73,22,9,"PAH",2,1,3,0)="============== "
^DIC(9.4,73,22,9,"PAH",2,1,4,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,5,0)="    Install patch AFJX*5.1*1 prior to the installation of this patch.  "
^DIC(9.4,73,22,9,"PAH",2,1,6,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,7,0)="Descriptive Text:"
^DIC(9.4,73,22,9,"PAH",2,1,8,0)="================="
^DIC(9.4,73,22,9,"PAH",2,1,9,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,10,0)="    7 routines (AFJXADHD, AFJXALRT, AFJXPNHX, AFJXWCL1, AFJXWCP8, "
^DIC(9.4,73,22,9,"PAH",2,1,11,0)="    AFJXWCPM, and AFJXWPR2) are modified in this patch.  "
^DIC(9.4,73,22,9,"PAH",2,1,12,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,13,0)="NOIS: "
^DIC(9.4,73,22,9,"PAH",2,1,14,0)="===="
^DIC(9.4,73,22,9,"PAH",2,1,15,0)=" NOIS:  REN-0297-60708, BAN-0297-11202, and ATG-0297-31510"
^DIC(9.4,73,22,9,"PAH",2,1,16,0)=" AFJXWCLI - DK RES errors reported in the above NOISs are repaired"
^DIC(9.4,73,22,9,"PAH",2,1,17,0)="          by this patch's changes in routine AFJXWCLI."
^DIC(9.4,73,22,9,"PAH",2,1,18,0)="          Multiple sites reported unexplained DK RES and similar errors "
^DIC(9.4,73,22,9,"PAH",2,1,19,0)="          with NHE over the last year. The problem was located in "
^DIC(9.4,73,22,9,"PAH",2,1,20,0)="          routine AFJXWCL1, where, in module INTRP, the variable "
^DIC(9.4,73,22,9,"PAH",2,1,21,0)="          GMJ was used as a variable in a FOR loop. First the module "
^DIC(9.4,73,22,9,"PAH",2,1,22,0)="          RDNODE was called, then module WRTGRM was called, "
^DIC(9.4,73,22,9,"PAH",2,1,23,0)="          which hard SET the variable GMJ to ""GRAM"" without any "
^DIC(9.4,73,22,9,"PAH",2,1,24,0)="          scoping of the variable. If there were any nodes that collated"
^DIC(9.4,73,22,9,"PAH",2,1,25,0)="          after ""GRAM,"" an endless loop resulted. In this loop the "
^DIC(9.4,73,22,9,"PAH",2,1,26,0)="          global ^TMP(""AFHS"",$J,CT,0) was set with CT incremented"
^DIC(9.4,73,22,9,"PAH",2,1,27,0)="          each time.  "
^DIC(9.4,73,22,9,"PAH",2,1,28,0)="          The routine was modified to change the program flow so that "
^DIC(9.4,73,22,9,"PAH",2,1,29,0)="          the original sequencing of data was maintained, but the"
^DIC(9.4,73,22,9,"PAH",2,1,30,0)="          offending hard SET of the variable GMJ was avoided."
^DIC(9.4,73,22,9,"PAH",2,1,31,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,32,0)=" NOIS:  ATG-0996-31958, BUT-0896-22000, FHM-0896-51544, and LEA-1196-41840"
^DIC(9.4,73,22,9,"PAH",2,1,33,0)=" AFJXPNHX - Multiple sites have reported problems in routine AFJXPNHX at"
^DIC(9.4,73,22,9,"PAH",2,1,34,0)="            QNEW+2. It appears that multiple jobs, not necessarily the"
^DIC(9.4,73,22,9,"PAH",2,1,35,0)="            NHE purge, are running at the same time. These routines are"
^DIC(9.4,73,22,9,"PAH",2,1,36,0)="            manipulating and deleting messages in the mailboxes and mail "
^DIC(9.4,73,22,9,"PAH",2,1,37,0)="            global.  This patch is generated to remove the effects of the"
^DIC(9.4,73,22,9,"PAH",2,1,38,0)="            unwanted job interference.  (The changes in AFJXPNHX were"
^DIC(9.4,73,22,9,"PAH",2,1,39,0)="            originally issued in AFJX*5.1*4 which was marked 'Entered in"
^DIC(9.4,73,22,9,"PAH",2,1,40,0)="            Error' due to an error in selection of routines contained.)"
^DIC(9.4,73,22,9,"PAH",2,1,41,0)="  "
^DIC(9.4,73,22,9,"PAH",2,1,42,0)=" AFJXWCP8 - The routine AFJXWCP8 was found to contain references to file"
^DIC(9.4,73,22,9,"PAH",2,1,43,0)="            6 and to file 16. The pointers are now properly referenced to"
^DIC(9.4,73,22,9,"PAH",2,1,44,0)="            file 200.  "
^DIC(9.4,73,22,9,"PAH",2,1,45,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,46,0)=" NOIS:  SBY-1296-30637"
^DIC(9.4,73,22,9,"PAH",2,1,47,0)=" AFJXADHD - It was reported that the security alert bulletin on sensitive"
^DIC(9.4,73,22,9,"PAH",2,1,48,0)="            data access occasionally was not generated. A secondary"
^DIC(9.4,73,22,9,"PAH",2,1,49,0)="            access path was discovered through routine AFJXADHD. AFJXADHD"
^DIC(9.4,73,22,9,"PAH",2,1,50,0)="            is now modified to handle the generation of bulletins the"
^DIC(9.4,73,22,9,"PAH",2,1,51,0)="            same as in routine AFJXALRT (which was previously modified to"
^DIC(9.4,73,22,9,"PAH",2,1,52,0)="            handle this problem)."
^DIC(9.4,73,22,9,"PAH",2,1,53,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,54,0)=" NOIS:  DAY-0297-40622"
^DIC(9.4,73,22,9,"PAH",2,1,55,0)=" AFJXADHD and AFJXALRT - Dayton reported that a spurious global node "
^DIC(9.4,73,22,9,"PAH",2,1,56,0)="            ^AFJ(537000,-1,0) was being set when a FILE^DICN failed and "
^DIC(9.4,73,22,9,"PAH",2,1,57,0)="            S DA=+Y returned a -1. Then S ^AFJ(537000,DA,1) was performed."
^DIC(9.4,73,22,9,"PAH",2,1,58,0)="            A condition was added in routines AFJXADHD and AFJXALRT to"
^DIC(9.4,73,22,9,"PAH",2,1,59,0)="            that SET to make it S:DA>0 and thus corrected the problem.  "
^DIC(9.4,73,22,9,"PAH",2,1,60,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,61,0)=" NOIS:  DAY-0197-40124"
^DIC(9.4,73,22,9,"PAH",2,1,62,0)=" AFJXWCPM - A site has reported a problem with BOLD being undefined at"
^DIC(9.4,73,22,9,"PAH",2,1,63,0)="            line OPTION in routine AFJXWCPM. This results from IOST(0)"
^DIC(9.4,73,22,9,"PAH",2,1,64,0)="            either being undefined or set to null."
^DIC(9.4,73,22,9,"PAH",2,1,65,0)="            Examination shows that in such cases BOLD and BOLF are"
^DIC(9.4,73,22,9,"PAH",2,1,66,0)="            equally apt to cause problems. The modification made to clear"
^DIC(9.4,73,22,9,"PAH",2,1,67,0)="            this problem is to hard SET BOLD and BOLF to null before"
^DIC(9.4,73,22,9,"PAH",2,1,68,0)="            IOST(0) is checked and BOLD and BOLF are updated."
^DIC(9.4,73,22,9,"PAH",2,1,69,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,70,0)=" NOIS:  HOU-0197-72340"
^DIC(9.4,73,22,9,"PAH",2,1,71,0)=" AFJXWPR2 - Houston reported that there was a syntax error in "
^DIC(9.4,73,22,9,"PAH",2,1,72,0)="            routine AFJXWPR2 that caused problems with SOAP entries. This"
^DIC(9.4,73,22,9,"PAH",2,1,73,0)="            is corrected."
^DIC(9.4,73,22,9,"PAH",2,1,74,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,75,0)=" PATCH HISTORY: "
^DIC(9.4,73,22,9,"PAH",2,1,76,0)=" =============="
^DIC(9.4,73,22,9,"PAH",2,1,77,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,78,0)="    The AFJXPNHX changes in this patch were originally issued as "
^DIC(9.4,73,22,9,"PAH",2,1,79,0)="    AFJX*5.1*5 which was declared to have been 'Entered in Error' due"
^DIC(9.4,73,22,9,"PAH",2,1,80,0)="    to an error in selection of routines contained (NOIS CIN-0397-40969)."
^DIC(9.4,73,22,9,"PAH",2,1,81,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,82,0)="    This has been updated correctly in AFJX*5.1*6.  "
^DIC(9.4,73,22,9,"PAH",2,1,83,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,84,0)="    In the previous AFJX patches, the Patch to Package file link was not "
^DIC(9.4,73,22,9,"PAH",2,1,85,0)="    included. As a result, the package patch history is incomplete. The "
^DIC(9.4,73,22,9,"PAH",2,1,86,0)="    sites are requested to manually update the patch history in the "
^DIC(9.4,73,22,9,"PAH",2,1,87,0)="    Package File to indicate that patches 1 through 3 for AFJX are entered"
^DIC(9.4,73,22,9,"PAH",2,1,88,0)="    into the production routines. Patches 4 and 5 were declared to have "
^DIC(9.4,73,22,9,"PAH",2,1,89,0)="    been 'Entered in Error,' hence need not be entered.  (This patch will"
^DIC(9.4,73,22,9,"PAH",2,1,90,0)="    update the package patch history for AFJX*5.1*6 only.)"
^DIC(9.4,73,22,9,"PAH",2,1,91,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,92,0)="Test Sites: "
^DIC(9.4,73,22,9,"PAH",2,1,93,0)="==========="
^DIC(9.4,73,22,9,"PAH",2,1,94,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,95,0)="    Bath, Reno, Houston, Dayton "
^DIC(9.4,73,22,9,"PAH",2,1,96,0)="                                                          "
^DIC(9.4,73,22,9,"PAH",2,1,97,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,98,0)="Routine Summary: "
^DIC(9.4,73,22,9,"PAH",2,1,99,0)="================"
^DIC(9.4,73,22,9,"PAH",2,1,100,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,101,0)="    The following is a list of the routines included in this patch. The "
^DIC(9.4,73,22,9,"PAH",2,1,102,0)="    second line value of each of these routines will look like: "
^DIC(9.4,73,22,9,"PAH",2,1,103,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,104,0)="       <tab>;;5.1;Network Health Exchange;**[patch list]**;date "
^DIC(9.4,73,22,9,"PAH",2,1,105,0)="                                 *                                *"
^DIC(9.4,73,22,9,"PAH",2,1,106,0)="    Routine Name     Before Patch     After Patch       Patch List "
^DIC(9.4,73,22,9,"PAH",2,1,107,0)="    ============     ============     ===========       =========="
^DIC(9.4,73,22,9,"PAH",2,1,108,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,109,0)="    AFJXADHD          15132754         15812358            6 "
^DIC(9.4,73,22,9,"PAH",2,1,110,0)="    AFJXALRT          16599231         16928883            6 "
^DIC(9.4,73,22,9,"PAH",2,1,111,0)="    AFJXPNHX           3809052          3887585            1,6 "
^DIC(9.4,73,22,9,"PAH",2,1,112,0)="    AFJXWCL1          10604702         10819424            6"
^DIC(9.4,73,22,9,"PAH",2,1,113,0)="    AFJXWCP8           6965692          6959884            6 "
^DIC(9.4,73,22,9,"PAH",2,1,114,0)="    AFJXWCPM           7335889          7563694            6 "
^DIC(9.4,73,22,9,"PAH",2,1,115,0)="    AFJXWPR2           6734179          6949871            6 "
^DIC(9.4,73,22,9,"PAH",2,1,116,0)="    AFJXEN6            N/A              8495682            6 "
^DIC(9.4,73,22,9,"PAH",2,1,117,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,118,0)="  * From CHECK^XTSUMBLD "
^DIC(9.4,73,22,9,"PAH",2,1,119,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,120,0)="     To test if the transport has been corrupted, you can use the "
^DIC(9.4,73,22,9,"PAH",2,1,121,0)="     ""Verify Package Integrity"" option.  This option is under Utilities "
^DIC(9.4,73,22,9,"PAH",2,1,122,0)="     under the KIDS menu.  It will compare the checksums in the build "
^DIC(9.4,73,22,9,"PAH",2,1,123,0)="     with the current checksums and list any that differ. "
^DIC(9.4,73,22,9,"PAH",2,1,124,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,125,0)="  Environmental Check Routine "
^DIC(9.4,73,22,9,"PAH",2,1,126,0)="  ==========================="
^DIC(9.4,73,22,9,"PAH",2,1,127,0)="   "
^DIC(9.4,73,22,9,"PAH",2,1,128,0)="    The environmental check routine is AFJXEN6 which checks the version "
^DIC(9.4,73,22,9,"PAH",2,1,129,0)="    and patch levels of the NHE package installed. Routine AFJXEN6 may be "
^DIC(9.4,73,22,9,"PAH",2,1,130,0)="    removed by the station upon successful installation of this patch.  "
^DIC(9.4,73,22,9,"PAH",2,1,131,0)="   "
^DIC(9.4,73,22,9,"PAH",2,1,132,0)="Installation Instructions: "
^DIC(9.4,73,22,9,"PAH",2,1,133,0)="=========================="
^DIC(9.4,73,22,9,"PAH",2,1,134,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,135,0)="    WHEN? Anytime. This patch is so brief (only seven routines) that it "
^DIC(9.4,73,22,9,"PAH",2,1,136,0)="    should not be queued.  "
^DIC(9.4,73,22,9,"PAH",2,1,137,0)="   "
^DIC(9.4,73,22,9,"PAH",2,1,138,0)="    HOW LONG?  Installation will take less than 2 minutes.  "
^DIC(9.4,73,22,9,"PAH",2,1,139,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,140,0)="       Use the INSTALL/CHECK MESSAGE option on the PackMan and respond "
^DIC(9.4,73,22,9,"PAH",2,1,141,0)="       YES at the prompt 'Want to Continue with load?  YES// <return>.  "
^DIC(9.4,73,22,9,"PAH",2,1,142,0)="                                                       ==="
^DIC(9.4,73,22,9,"PAH",2,1,143,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,144,0)="    1. Users are allowed to be on the system during the installation.  "
^DIC(9.4,73,22,9,"PAH",2,1,145,0)="    2. It is not necessary to place TaskMan in a WAIT/STOP state.  "
^DIC(9.4,73,22,9,"PAH",2,1,146,0)="    3. When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,73,22,9,"PAH",2,1,147,0)="       and Protocols? Yes// <return>, respond YES or <return>. When"
^DIC(9.4,73,22,9,"PAH",2,1,148,0)="                                              ==="
^DIC(9.4,73,22,9,"PAH",2,1,149,0)="       prompted to select the option(s) you would like to place out of"
^DIC(9.4,73,22,9,"PAH",2,1,150,0)="       order, enter the following:"
^DIC(9.4,73,22,9,"PAH",2,1,151,0)="   "
^DIC(9.4,73,22,9,"PAH",2,1,152,0)="          AFJXNHEX REQUEST "
^DIC(9.4,73,22,9,"PAH",2,1,153,0)="          ================"
^DIC(9.4,73,22,9,"PAH",2,1,154,0)="          AFJX PURGE NIGHTLY "
^DIC(9.4,73,22,9,"PAH",2,1,155,0)="          =================="
^DIC(9.4,73,22,9,"PAH",2,1,156,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,157,0)="    4. Review your Mapped Routine set. If any of the routines listed in "
^DIC(9.4,73,22,9,"PAH",2,1,158,0)="       the ROUTINE SUMMARY section are mapped on your system, they "
^DIC(9.4,73,22,9,"PAH",2,1,159,0)="       should be unmapped at this time.     "
^DIC(9.4,73,22,9,"PAH",2,1,160,0)="    5. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This "
^DIC(9.4,73,22,9,"PAH",2,1,161,0)="       option will load the KIDS package onto your system.  "
^DIC(9.4,73,22,9,"PAH",2,1,162,0)="    6. The patch has now been loaded into a Transport global on your "
^DIC(9.4,73,22,9,"PAH",2,1,163,0)="       system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,73,22,9,"PAH",2,1,164,0)="    7. From the Kernel Installation and Distribution System Menu, select "
^DIC(9.4,73,22,9,"PAH",2,1,165,0)="       the Installation menu. On the KIDS Installation menu, you may elect"
^DIC(9.4,73,22,9,"PAH",2,1,166,0)="       to use the following options: "
^DIC(9.4,73,22,9,"PAH",2,1,167,0)="       a. Verify checksums in the Transport Global - this option will "
^DIC(9.4,73,22,9,"PAH",2,1,168,0)="          allow you to ensure the integrity of the routines that are in "
^DIC(9.4,73,22,9,"PAH",2,1,169,0)="          the Transport Global.  "
^DIC(9.4,73,22,9,"PAH",2,1,170,0)="       b. Compare Transport Global to the Current System - this option "
^DIC(9.4,73,22,9,"PAH",2,1,171,0)="          will allow you to view all changes that will be made when the "
^DIC(9.4,73,22,9,"PAH",2,1,172,0)="          patch is installed. It compares all components of the patch "
^DIC(9.4,73,22,9,"PAH",2,1,173,0)="          (routines, DDs, templates, etc.).  "
^DIC(9.4,73,22,9,"PAH",2,1,174,0)="       c. Back up a Transport Global - this option will create a backup "
^DIC(9.4,73,22,9,"PAH",2,1,175,0)="          message of any routines exported with the patch. It will NOT "
^DIC(9.4,73,22,9,"PAH",2,1,176,0)="          back up any other changes such as DDs or templates.  "
^DIC(9.4,73,22,9,"PAH",2,1,177,0)="          Use the Install Package(s) options and select the package: "
^DIC(9.4,73,22,9,"PAH",2,1,178,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,179,0)="          AFJX*5.1*6.  "
^DIC(9.4,73,22,9,"PAH",2,1,180,0)="          =========="
^DIC(9.4,73,22,9,"PAH",2,1,181,0)=" "
^DIC(9.4,73,22,9,"PAH",2,1,182,0)="    8. MSM sites:  Please ensure you answer YES when asked if you want "
^DIC(9.4,73,22,9,"PAH",2,1,183,0)="       to move the routines to other systems and indicate the appropriate "
^DIC(9.4,73,22,9,"PAH",2,1,184,0)="       CPUs. Alternatively, you can wait until the installation is "
^DIC(9.4,73,22,9,"PAH",2,1,185,0)="       complete and move the routines listed in the Routine Summary "
^DIC(9.4,73,22,9,"PAH",2,1,186,0)="       Section to all systems.  "
^DIC(9.4,73,22,9,"PAH",2,1,187,0)="    9. If the routines were unmapped as part of step 4, they should be "
^DIC(9.4,73,22,9,"PAH",2,1,188,0)="       returned to the mapped set once the installation has run to "
^DIC(9.4,73,22,9,"PAH",2,1,189,0)="       completion. "
^DIC(9.4,73,22,9,"PAH",3,0)="7^2971007^1"
^DIC(9.4,73,22,9,"PAH",3,1,0)="^^138^138^2971007"
^DIC(9.4,73,22,9,"PAH",3,1,1,0)="Subject: Missing and undefined data"
^DIC(9.4,73,22,9,"PAH",3,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,3,0)="Category: "
^DIC(9.4,73,22,9,"PAH",3,1,4,0)="  - Routine"
^DIC(9.4,73,22,9,"PAH",3,1,5,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,6,0)="Description: "
^DIC(9.4,73,22,9,"PAH",3,1,7,0)="============"
^DIC(9.4,73,22,9,"PAH",3,1,8,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,9,0)="     2 routines (AFJXPNHI, AFJXWCPL) are modified in this patch."
^DIC(9.4,73,22,9,"PAH",3,1,10,0)="   "
^DIC(9.4,73,22,9,"PAH",3,1,11,0)="   "
^DIC(9.4,73,22,9,"PAH",3,1,12,0)="Prerequisites:"
^DIC(9.4,73,22,9,"PAH",3,1,13,0)="=============="
^DIC(9.4,73,22,9,"PAH",3,1,14,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,15,0)="      Install patch AFJX*5.1*6 prior to the installation of this patch."
^DIC(9.4,73,22,9,"PAH",3,1,16,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,17,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,18,0)="NOIS:"
^DIC(9.4,73,22,9,"PAH",3,1,19,0)="===="
^DIC(9.4,73,22,9,"PAH",3,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,21,0)="NOIS:  MIW-0397-31028"
^DIC(9.4,73,22,9,"PAH",3,1,22,0)="AFJXWCPL - An uncoordinated addition of a new cross-reference in Lab"
^DIC(9.4,73,22,9,"PAH",3,1,23,0)="Package resulted in an undefined at NXTST+2^AFJXWCPL. The code at"
^DIC(9.4,73,22,9,"PAH",3,1,24,0)="CHSET+7 was modified to exclude the handling of the new"
^DIC(9.4,73,22,9,"PAH",3,1,25,0)="cross-reference."
^DIC(9.4,73,22,9,"PAH",3,1,26,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,27,0)="NOIS:  CLL-0397-42751"
^DIC(9.4,73,22,9,"PAH",3,1,28,0)="AFJXPNHI - The variable I was reported to be undefined at"
^DIC(9.4,73,22,9,"PAH",3,1,29,0)="PART2^AFJXPNHI. This variable was used as a dummy index for a For"
^DIC(9.4,73,22,9,"PAH",3,1,30,0)="Loop and was not used elsewhere. The For Loop was changed to an"
^DIC(9.4,73,22,9,"PAH",3,1,31,0)="argumentless one."
^DIC(9.4,73,22,9,"PAH",3,1,32,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,33,0)="NOIS:  DAN-0497-41347"
^DIC(9.4,73,22,9,"PAH",3,1,34,0)="AFJXPNHI - The site was reporting that NHE reports were not being"
^DIC(9.4,73,22,9,"PAH",3,1,35,0)="found by the alerts mechanism. Investigation found two problems."
^DIC(9.4,73,22,9,"PAH",3,1,36,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,37,0)="The first was that the parsing mechanism that parsed the titles in"
^DIC(9.4,73,22,9,"PAH",3,1,38,0)="the Alerts Message was using spaces in locating data. Since the"
^DIC(9.4,73,22,9,"PAH",3,1,39,0)="spaces were used the data after the patient name was mis-parsed if"
^DIC(9.4,73,22,9,"PAH",3,1,40,0)="there was a third item present in the name (such as Jr/Sr. a number,"
^DIC(9.4,73,22,9,"PAH",3,1,41,0)="etc). The code in AFJXPNHI was modified to use other characteristics"
^DIC(9.4,73,22,9,"PAH",3,1,42,0)="to allow a proper parsing."
^DIC(9.4,73,22,9,"PAH",3,1,43,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,44,0)="The second is that if the patients name is spelled differently at"
^DIC(9.4,73,22,9,"PAH",3,1,45,0)="the server and client the Alerts will not display the messages since"
^DIC(9.4,73,22,9,"PAH",3,1,46,0)="a built in check (the two names are the same) fails. Since this is a"
^DIC(9.4,73,22,9,"PAH",3,1,47,0)="design feature a decision or how to handle this is still open"
^DIC(9.4,73,22,9,"PAH",3,1,48,0)="(Follow the completed reports model where this is available, or"
^DIC(9.4,73,22,9,"PAH",3,1,49,0)="extend the security to the complete report)."
^DIC(9.4,73,22,9,"PAH",3,1,50,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,51,0)="Test Sites:"
^DIC(9.4,73,22,9,"PAH",3,1,52,0)="==========="
^DIC(9.4,73,22,9,"PAH",3,1,53,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,54,0)="    Milwaukee, Chillicothe, Danville"
^DIC(9.4,73,22,9,"PAH",3,1,55,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,56,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,57,0)="Routine Summary:"
^DIC(9.4,73,22,9,"PAH",3,1,58,0)="================"
^DIC(9.4,73,22,9,"PAH",3,1,59,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,60,0)="    The following is a list of the routines included in this patch."
^DIC(9.4,73,22,9,"PAH",3,1,61,0)="    The second line value of each of these routines will look like:"
^DIC(9.4,73,22,9,"PAH",3,1,62,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,63,0)="    <tab>;;5.1;Network Health Exchange;**[patch list]**;date"
^DIC(9.4,73,22,9,"PAH",3,1,64,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,65,0)="    Routine Name     Before Patch     After Patch       Patch List"
^DIC(9.4,73,22,9,"PAH",3,1,66,0)="    ============     ============     ===========       =========="
^DIC(9.4,73,22,9,"PAH",3,1,67,0)="    AFJXEN7               N/A            6822968            7"
^DIC(9.4,73,22,9,"PAH",3,1,68,0)="    AFJXPNHI            6813365          7299167            2,7"
^DIC(9.4,73,22,9,"PAH",3,1,69,0)="    AFJXWCPL            7386440          7733101            7"
^DIC(9.4,73,22,9,"PAH",3,1,70,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,71,0)="    * From CHECK^XTSUMBLD"
^DIC(9.4,73,22,9,"PAH",3,1,72,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,73,0)="    To test if the transport has been corrupted, you can use the"
^DIC(9.4,73,22,9,"PAH",3,1,74,0)="    ""Verify Package Integrity"" option.  This option is under"
^DIC(9.4,73,22,9,"PAH",3,1,75,0)="    Utilities under the KIDS menu.  It will compare the checksums in"
^DIC(9.4,73,22,9,"PAH",3,1,76,0)="    the build with the current checksums and list any that differ."
^DIC(9.4,73,22,9,"PAH",3,1,77,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,78,0)="Environment Check Routine:"
^DIC(9.4,73,22,9,"PAH",3,1,79,0)="========================="
^DIC(9.4,73,22,9,"PAH",3,1,80,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,81,0)="    The routine AFJXEN7 checks to see if NHE version 5.1 with patch"
^DIC(9.4,73,22,9,"PAH",3,1,82,0)="    6 is installed before installation proceeds. On failure, a"
^DIC(9.4,73,22,9,"PAH",3,1,83,0)="    message is sent to the user detailing the problems encountered."
^DIC(9.4,73,22,9,"PAH",3,1,84,0)="    The routine AFJXEN7 may be removed upon successful patch 7"
^DIC(9.4,73,22,9,"PAH",3,1,85,0)="    installation."
^DIC(9.4,73,22,9,"PAH",3,1,86,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,87,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,88,0)="Installation Instructions:"
^DIC(9.4,73,22,9,"PAH",3,1,89,0)="=========================="
^DIC(9.4,73,22,9,"PAH",3,1,90,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,91,0)="    WHEN? Anytime. This patch is so brief (only two routines) that it"
^DIC(9.4,73,22,9,"PAH",3,1,92,0)="    should not be queued."
^DIC(9.4,73,22,9,"PAH",3,1,93,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,94,0)="    HOW LONG?  Installation will take less than 2 minutes."
^DIC(9.4,73,22,9,"PAH",3,1,95,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,96,0)="       Use the INSTALL/CHECK MESSAGE option on the PackMan and respond"
^DIC(9.4,73,22,9,"PAH",3,1,97,0)="       YES at the prompt 'Want to Continue with load?  YES// <return>."
^DIC(9.4,73,22,9,"PAH",3,1,98,0)="                                                       ==="
^DIC(9.4,73,22,9,"PAH",3,1,99,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,100,0)="    1. Users are allowed to be on the system during the installation."
^DIC(9.4,73,22,9,"PAH",3,1,101,0)="    2. It is not necessary to place TaskMan in a WAIT/STOP state."
^DIC(9.4,73,22,9,"PAH",3,1,102,0)="    3. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,73,22,9,"PAH",3,1,103,0)="       and Protocols? Yes// <return>, respond YES. When prompted"
^DIC(9.4,73,22,9,"PAH",3,1,104,0)="                                              ==="
^DIC(9.4,73,22,9,"PAH",3,1,105,0)="       to select the option(s) you would like to place out of order,"
^DIC(9.4,73,22,9,"PAH",3,1,106,0)="       enter the following:"
^DIC(9.4,73,22,9,"PAH",3,1,107,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,108,0)="          AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",3,1,109,0)="          ================"
^DIC(9.4,73,22,9,"PAH",3,1,110,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,111,0)="    4. Review your Mapped Routine set. If any of the routines listed in"
^DIC(9.4,73,22,9,"PAH",3,1,112,0)="       the ROUTINE SUMMARY section are mapped on your system, they"
^DIC(9.4,73,22,9,"PAH",3,1,113,0)="       should be unmapped at this time."
^DIC(9.4,73,22,9,"PAH",3,1,114,0)="    5. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,73,22,9,"PAH",3,1,115,0)="       option will load the KIDS package onto your system."
^DIC(9.4,73,22,9,"PAH",3,1,116,0)="    6. The patch has now been loaded into a Transport global on your"
^DIC(9.4,73,22,9,"PAH",3,1,117,0)="       system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,73,22,9,"PAH",3,1,118,0)="    7. From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,73,22,9,"PAH",3,1,119,0)="       the Installation menu. On the KIDS Installation menu, you may"
^DIC(9.4,73,22,9,"PAH",3,1,120,0)="       elect to use the following options:"
^DIC(9.4,73,22,9,"PAH",3,1,121,0)="       a. Verify checksums in the Transport Global - this option will"
^DIC(9.4,73,22,9,"PAH",3,1,122,0)="          allow you to ensure the integrity of the routines that are in"
^DIC(9.4,73,22,9,"PAH",3,1,123,0)="          the Transport Global."
^DIC(9.4,73,22,9,"PAH",3,1,124,0)="       b. Compare Transport Global to the Current System - this option"
^DIC(9.4,73,22,9,"PAH",3,1,125,0)="          will allow you to view all changes that will be made when the"
^DIC(9.4,73,22,9,"PAH",3,1,126,0)="          patch is installed. It compares all components of the patch"
^DIC(9.4,73,22,9,"PAH",3,1,127,0)="          (routines, DDs, templates, etc.)."
^DIC(9.4,73,22,9,"PAH",3,1,128,0)="       c. Backup a Transport Global - this option will create a backup"
^DIC(9.4,73,22,9,"PAH",3,1,129,0)="          message of any routines exported with the patch. It will NOT"
^DIC(9.4,73,22,9,"PAH",3,1,130,0)="          backup any other changes such as DDs or templates."
^DIC(9.4,73,22,9,"PAH",3,1,131,0)="          Use the Install Package(s) options and select the package:"
^DIC(9.4,73,22,9,"PAH",3,1,132,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,133,0)="          AFJX*5.1*7."
^DIC(9.4,73,22,9,"PAH",3,1,134,0)="          =========="
^DIC(9.4,73,22,9,"PAH",3,1,135,0)=" "
^DIC(9.4,73,22,9,"PAH",3,1,136,0)="    8. If the routines were unmapped as part of step 4, they should be"
^DIC(9.4,73,22,9,"PAH",3,1,137,0)="       returned to the mapped set once the installation has run to"
^DIC(9.4,73,22,9,"PAH",3,1,138,0)="       completion."
^DIC(9.4,73,22,9,"PAH",4,0)="8 SEQ #9^2980725^1"
^DIC(9.4,73,22,9,"PAH",4,1,0)="^^111^111^2980725"
^DIC(9.4,73,22,9,"PAH",4,1,1,0)=" Subject:"
^DIC(9.4,73,22,9,"PAH",4,1,2,0)="   Resolving truncation of data"
^DIC(9.4,73,22,9,"PAH",4,1,3,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,4,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,5,0)=" Category:"
^DIC(9.4,73,22,9,"PAH",4,1,6,0)="  - Routine"
^DIC(9.4,73,22,9,"PAH",4,1,7,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,8,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,9,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",4,1,10,0)=" ============"
^DIC(9.4,73,22,9,"PAH",4,1,11,0)="     Results of a lab test performed at the site are obtained via"
^DIC(9.4,73,22,9,"PAH",4,1,12,0)="  Network Health Exchange.  NHE has been providing only 4 digits"
^DIC(9.4,73,22,9,"PAH",4,1,13,0)="  instead of 6 digits or more.  This patch will rectify this"
^DIC(9.4,73,22,9,"PAH",4,1,14,0)="  truncation of data."
^DIC(9.4,73,22,9,"PAH",4,1,15,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,16,0)="     Facilities should undertake a review of whether clinicians"
^DIC(9.4,73,22,9,"PAH",4,1,17,0)="  have looked up viral load results using NHE, and whether"
^DIC(9.4,73,22,9,"PAH",4,1,18,0)="  clinical judgments have been based on these values rather than"
^DIC(9.4,73,22,9,"PAH",4,1,19,0)="  looking up the results in VistA directly.  If this has happened"
^DIC(9.4,73,22,9,"PAH",4,1,20,0)="  then it must be determined whether a patient's treatment"
^DIC(9.4,73,22,9,"PAH",4,1,21,0)="  protocol is accurate and that the laboratory values were not"
^DIC(9.4,73,22,9,"PAH",4,1,22,0)="  truncated resulting in inappropriate treatment.  Corrective"
^DIC(9.4,73,22,9,"PAH",4,1,23,0)="  actions should be taken immediately."
^DIC(9.4,73,22,9,"PAH",4,1,24,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,25,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,26,0)=" NOIS:  CIN-0698-41578"
^DIC(9.4,73,22,9,"PAH",4,1,27,0)="     Delay in the treatment of a patient being followed in"
^DIC(9.4,73,22,9,"PAH",4,1,28,0)="  the Extended Infectious Disease Clinic at a tertiary VISN"
^DIC(9.4,73,22,9,"PAH",4,1,29,0)="  facility.  Patient was prescribed a single antiretroviral"
^DIC(9.4,73,22,9,"PAH",4,1,30,0)="  medication based on a viral load value of 3,090 obtained"
^DIC(9.4,73,22,9,"PAH",4,1,31,0)="  through the Network Health Exchange (NHE).  Three"
^DIC(9.4,73,22,9,"PAH",4,1,32,0)="  antiretroviral agents should have been prescribed based on"
^DIC(9.4,73,22,9,"PAH",4,1,33,0)="  the actual value of 30,090. The NHE viral load value field"
^DIC(9.4,73,22,9,"PAH",4,1,34,0)="  only allowed for a 4 digit value to be transmitted, when in"
^DIC(9.4,73,22,9,"PAH",4,1,35,0)="  fact, the value is often 6 digits long or more."
^DIC(9.4,73,22,9,"PAH",4,1,36,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,37,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,38,0)="  Test Sites:"
^DIC(9.4,73,22,9,"PAH",4,1,39,0)="  ==========="
^DIC(9.4,73,22,9,"PAH",4,1,40,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,41,0)="      Dayton, Cincinnati, Columbus, Wilkesbarre, Birmingham, Dublin"
^DIC(9.4,73,22,9,"PAH",4,1,42,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,43,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,44,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,45,0)="  Routine Summary:"
^DIC(9.4,73,22,9,"PAH",4,1,46,0)="  ================"
^DIC(9.4,73,22,9,"PAH",4,1,47,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,48,0)="      The following is a list of the routines included in this patch. The"
^DIC(9.4,73,22,9,"PAH",4,1,49,0)="      second line value of each of these routines will look like:"
^DIC(9.4,73,22,9,"PAH",4,1,50,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,51,0)="      <tab>;;5.1;Network Health Exchange;**8**;Jan 23, 1996"
^DIC(9.4,73,22,9,"PAH",4,1,52,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,53,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,54,0)="      Routine Name     Before Patch     After Patch       Patch List"
^DIC(9.4,73,22,9,"PAH",4,1,55,0)="      ============     ============     ===========       =========="
^DIC(9.4,73,22,9,"PAH",4,1,56,0)="      AFJXCAH          5679268          5679688           8"
^DIC(9.4,73,22,9,"PAH",4,1,57,0)="      AFJXCAHS         6214244          6214664           8"
^DIC(9.4,73,22,9,"PAH",4,1,58,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,59,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,60,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,61,0)="      * From CHECK^XTSUMBLD"
^DIC(9.4,73,22,9,"PAH",4,1,62,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,63,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,64,0)="  Installation Instructions:"
^DIC(9.4,73,22,9,"PAH",4,1,65,0)="  =========================="
^DIC(9.4,73,22,9,"PAH",4,1,66,0)="   "
^DIC(9.4,73,22,9,"PAH",4,1,67,0)="   1. Users are allowed to be on the system during the installation; "
^DIC(9.4,73,22,9,"PAH",4,1,68,0)="      however, it is highly recommended to do the installation "
^DIC(9.4,73,22,9,"PAH",4,1,69,0)="      when a minimal number of users are on the system."
^DIC(9.4,73,22,9,"PAH",4,1,70,0)="   2. It is not necessary to place TaskMan in a WAIT/STOP state."
^DIC(9.4,73,22,9,"PAH",4,1,71,0)="   3. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,73,22,9,"PAH",4,1,72,0)="      and Protocols? Yes// <return>, respond YES. When prompted to select"
^DIC(9.4,73,22,9,"PAH",4,1,73,0)="                                             ==="
^DIC(9.4,73,22,9,"PAH",4,1,74,0)="      the option(s) you would like to place out of order, enter the"
^DIC(9.4,73,22,9,"PAH",4,1,75,0)="      following:"
^DIC(9.4,73,22,9,"PAH",4,1,76,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,77,0)="         AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",4,1,78,0)="         ================"
^DIC(9.4,73,22,9,"PAH",4,1,79,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,80,0)="   4. Review your Mapped Routine set. If any of the routines listed in"
^DIC(9.4,73,22,9,"PAH",4,1,81,0)="      the ROUTINE SUMMARY section are mapped on your system, they"
^DIC(9.4,73,22,9,"PAH",4,1,82,0)="      should be unmapped at this time."
^DIC(9.4,73,22,9,"PAH",4,1,83,0)="   5. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,73,22,9,"PAH",4,1,84,0)="      option will load the KIDS package onto your system."
^DIC(9.4,73,22,9,"PAH",4,1,85,0)="   6. The patch has now been loaded into a Transport global on your"
^DIC(9.4,73,22,9,"PAH",4,1,86,0)="      system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,73,22,9,"PAH",4,1,87,0)="   7. From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,73,22,9,"PAH",4,1,88,0)="      the Installation menu. On the KIDS Installation menu, you may elect"
^DIC(9.4,73,22,9,"PAH",4,1,89,0)="      to use the following options:"
^DIC(9.4,73,22,9,"PAH",4,1,90,0)="      a. Verify checksums in the Transport Global - this option will"
^DIC(9.4,73,22,9,"PAH",4,1,91,0)="         allow you to ensure the integrity of the routines that are in"
^DIC(9.4,73,22,9,"PAH",4,1,92,0)="         the Transport Global."
^DIC(9.4,73,22,9,"PAH",4,1,93,0)="      b. Print Transport Global and Compare Transport Global to the"
^DIC(9.4,73,22,9,"PAH",4,1,94,0)="         Current System - this option will allow you to view all"
^DIC(9.4,73,22,9,"PAH",4,1,95,0)="         changes that will be made when the patch is installed. It"
^DIC(9.4,73,22,9,"PAH",4,1,96,0)="         compares all components of the patch (routines, DDs,"
^DIC(9.4,73,22,9,"PAH",4,1,97,0)="         templates, etc.)."
^DIC(9.4,73,22,9,"PAH",4,1,98,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,99,0)="      c. Backup a Transport Global - this option will create a backup"
^DIC(9.4,73,22,9,"PAH",4,1,100,0)="         message of any routines exported with the patch. It will NOT"
^DIC(9.4,73,22,9,"PAH",4,1,101,0)="         backup any other changes such as DDs or templates."
^DIC(9.4,73,22,9,"PAH",4,1,102,0)="         Use the Install Package(s) options and select the package:"
^DIC(9.4,73,22,9,"PAH",4,1,103,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,104,0)="         AFJX*5.1*8."
^DIC(9.4,73,22,9,"PAH",4,1,105,0)="         =========="
^DIC(9.4,73,22,9,"PAH",4,1,106,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,107,0)="   8. If the routines were unmapped as part of step 4, the mapped set"
^DIC(9.4,73,22,9,"PAH",4,1,108,0)="      should be rebuilt once the installation has run to completion."
^DIC(9.4,73,22,9,"PAH",4,1,109,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,110,0)=" "
^DIC(9.4,73,22,9,"PAH",4,1,111,0)="                                                                   ."
^DIC(9.4,73,22,9,"PAH",5,0)="10^2980923^1"
^DIC(9.4,73,22,9,"PAH",5,1,0)="^^100^100^2980923"
^DIC(9.4,73,22,9,"PAH",5,1,1,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,2,0)=" Subject:"
^DIC(9.4,73,22,9,"PAH",5,1,3,0)="   Reformatting report to accomodate maximum of"
^DIC(9.4,73,22,9,"PAH",5,1,4,0)="   16 characters of Lab Results"
^DIC(9.4,73,22,9,"PAH",5,1,5,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,6,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,7,0)=" Category:"
^DIC(9.4,73,22,9,"PAH",5,1,8,0)="  - Routine"
^DIC(9.4,73,22,9,"PAH",5,1,9,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,10,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,11,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",5,1,12,0)=" ============"
^DIC(9.4,73,22,9,"PAH",5,1,13,0)="   This patch was created to reformat the Chem & Hematology"
^DIC(9.4,73,22,9,"PAH",5,1,14,0)=" section of the Network Health Exchange report (without"
^DIC(9.4,73,22,9,"PAH",5,1,15,0)=" exceeding more than 80 characters per line).  Previously,"
^DIC(9.4,73,22,9,"PAH",5,1,16,0)=" the lab results on the report would only display a maximum"
^DIC(9.4,73,22,9,"PAH",5,1,17,0)=" of seven characters. This code has been changed to"
^DIC(9.4,73,22,9,"PAH",5,1,18,0)=" display a maximum of 16 characters."
^DIC(9.4,73,22,9,"PAH",5,1,19,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,21,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,22,0)="  NOIS:  HAM-0798-21999"
^DIC(9.4,73,22,9,"PAH",5,1,23,0)="    Sites have requested that Network Health Exchange"
^DIC(9.4,73,22,9,"PAH",5,1,24,0)="  accomodate more than 7 characters on the lab"
^DIC(9.4,73,22,9,"PAH",5,1,25,0)="  results.  "
^DIC(9.4,73,22,9,"PAH",5,1,26,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,27,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,28,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,29,0)="  Test Sites:"
^DIC(9.4,73,22,9,"PAH",5,1,30,0)="  ==========="
^DIC(9.4,73,22,9,"PAH",5,1,31,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,32,0)="      Cincinnati, Columbus, Wilkes Barre, Dublin, Richmond"
^DIC(9.4,73,22,9,"PAH",5,1,33,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,34,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,35,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,36,0)="  Routine Summary:"
^DIC(9.4,73,22,9,"PAH",5,1,37,0)="  ================"
^DIC(9.4,73,22,9,"PAH",5,1,38,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,39,0)="      The following is a list of the routines included in this patch."
^DIC(9.4,73,22,9,"PAH",5,1,40,0)="      The second line value of each of these routines will look like:"
^DIC(9.4,73,22,9,"PAH",5,1,41,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,42,0)="      <tab>;;5.1;Network Health Exchange;**[patch list]**;Jan 23, 1996"
^DIC(9.4,73,22,9,"PAH",5,1,43,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,44,0)=" "
^DIC(9.4,73,22,9,"PAH",5,1,45,0)="      Routine Name     Before Patch     After Patch       Patch List"
^DIC(9.4,73,22,9,"PAH",5,1,46,0)="      ============     ============     ===========       =========="
^DIC(9.4,73,22,9,"PAH",5,1,47,0)="      AFJXCAH          5679688          5571442           8,10"
^DIC(9.4,73,22,9,"PAH",5,1,48,0)="      AFJXCAHB         2928193          2909852           10"
^DIC(9.4,73,22,9,"PAH",5,1,49,0)="      AFJXCAHS         6214664          6106418           8,10"
^DIC(9.4,73,22,9,"PAH",5,1,50,0)="      AFJXMABX         12595367         12990713          1,2,10"
^DIC(9.4,73,22,9,"PAH",5,1,51,0)=" "
