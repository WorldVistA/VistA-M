^DIC(9.4,149,22,15,"PAH",25,1,0)="^^5^5^3210422"
^DIC(9.4,149,22,15,"PAH",25,1,1,0)="Backup of ABSV*4.0*45 on Apr 22, 2021"
^DIC(9.4,149,22,15,"PAH",25,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",25,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,149,22,15,"PAH",25,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,149,22,15,"PAH",25,1,5,0)="Please verify with the Development Team that it is safe to install."
