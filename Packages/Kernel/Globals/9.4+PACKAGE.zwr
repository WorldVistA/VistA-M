^DIC(9.4,76,5)="ALBANY"
^DIC(9.4,76,11)="357^359.94"
^DIC(9.4,76,22,0)="^9.49I^2^2"
^DIC(9.4,76,22,1,0)="2.1^2960403^2960717"
^DIC(9.4,76,22,1,"PAH",0)="^9.4901^14^14"
^DIC(9.4,76,22,1,"PAH",1,0)="1 SEQ #1^2960822^1"
^DIC(9.4,76,22,1,"PAH",1,1,0)="^^11^11^2960822"
^DIC(9.4,76,22,1,"PAH",1,1,1,0)="This is patch IBD*2.1*1.  This patch corrects all known problems with"
^DIC(9.4,76,22,1,"PAH",1,1,2,0)="copying subcolumns and selections from both the conversion and editing"
^DIC(9.4,76,22,1,"PAH",1,1,3,0)="encounter forms."
^DIC(9.4,76,22,1,"PAH",1,1,4,0)=" "
^DIC(9.4,76,22,1,"PAH",1,1,5,0)="This patch includes 6 routines that clean up the variable DR that is"
^DIC(9.4,76,22,1,"PAH",1,1,6,0)="left lying around and causes unexpected prompts when editing."
^DIC(9.4,76,22,1,"PAH",1,1,7,0)=" "
^DIC(9.4,76,22,1,"PAH",1,1,8,0)="In routine ^IBDF1BA the global ^UTILITY is misspelled in the kill logic"
^DIC(9.4,76,22,1,"PAH",1,1,9,0)="leaving the global.  This occurs during printing of encounter forms and"
^DIC(9.4,76,22,1,"PAH",1,1,10,0)="may be causing problems for sites when printing large numbers of"
^DIC(9.4,76,22,1,"PAH",1,1,11,0)="encounter forms."
^DIC(9.4,76,22,1,"PAH",2,0)="4 SEQ #3^2960822^1"
^DIC(9.4,76,22,1,"PAH",2,1,0)="^^1^1^2960822"
^DIC(9.4,76,22,1,"PAH",2,1,1,0)=" "
^DIC(9.4,76,22,1,"PAH",3,0)="2 SEQ #4^2960822^1"
^DIC(9.4,76,22,1,"PAH",3,1,0)="^^2^2^2960822"
^DIC(9.4,76,22,1,"PAH",3,1,1,0)="This is the AICS Data Entry System, patch IBD*2.1*2.  See Patch description"
^DIC(9.4,76,22,1,"PAH",3,1,2,0)="for details."
^DIC(9.4,76,22,1,"PAH",4,0)="6 SEQ #5^2960924^1"
^DIC(9.4,76,22,1,"PAH",4,1,0)="^^1^1^2960924"
^DIC(9.4,76,22,1,"PAH",4,1,1,0)="PATCH FOR 'UNKNOWN' DIVISION ON AICS v2.1 REPORTS"
^DIC(9.4,76,22,1,"PAH",5,0)="5 SEQ #6^2960925^1"
^DIC(9.4,76,22,1,"PAH",5,1,0)="^^1^1^2960925"
^DIC(9.4,76,22,1,"PAH",5,1,1,0)="FIX FOR PRINT QUEUES"
^DIC(9.4,76,22,1,"PAH",6,0)="7 SEQ #7^2961011^1"
^DIC(9.4,76,22,1,"PAH",6,1,0)="^^4^4^2961011"
^DIC(9.4,76,22,1,"PAH",6,1,1,0)="IBD*2.1*7 TEST v2"
^DIC(9.4,76,22,1,"PAH",6,1,2,0)=" "
^DIC(9.4,76,22,1,"PAH",6,1,3,0)="Partial DD Description field update and new Identifier for PAGE"
^DIC(9.4,76,22,1,"PAH",6,1,4,0)="INFORMATION multiple for Encounter Form file (357)."
^DIC(9.4,76,22,1,"PAH",7,0)="13 SEQ #8^2961101^1"
^DIC(9.4,76,22,1,"PAH",7,1,0)="^^1^1^2961101"
^DIC(9.4,76,22,1,"PAH",7,1,1,0)="PATCH IBD*2.1*13 v1  (routine IBDFDE6)"
^DIC(9.4,76,22,1,"PAH",8,0)="9 SEQ #9^2961123^1"
^DIC(9.4,76,22,1,"PAH",8,1,0)="^^14^14^2961123"
^DIC(9.4,76,22,1,"PAH",8,1,1,0)="TEST PATCH v1 IBD*2.1*9"
^DIC(9.4,76,22,1,"PAH",8,1,2,0)="======================="
^DIC(9.4,76,22,1,"PAH",8,1,3,0)=" "
^DIC(9.4,76,22,1,"PAH",8,1,4,0)=" "
^DIC(9.4,76,22,1,"PAH",8,1,5,0)="This patch is in response to NOIS SBY-1096-30662."
^DIC(9.4,76,22,1,"PAH",8,1,6,0)=" "
^DIC(9.4,76,22,1,"PAH",8,1,7,0)="This KIDS build contains routine IBDFDE5 which will run as a"
^DIC(9.4,76,22,1,"PAH",8,1,8,0)="post-install routine to update the Package Interface entry INPUT PROVIDER"
^DIC(9.4,76,22,1,"PAH",8,1,9,0)="(#61) MANUAL DATA ENTRY ROUTINE field (#18)."
^DIC(9.4,76,22,1,"PAH",8,1,10,0)=" "
^DIC(9.4,76,22,1,"PAH",8,1,11,0)="The current data in this field contains a Provider Screen on the"
^DIC(9.4,76,22,1,"PAH",8,1,12,0)="'AK.PROVIDER'. This patch modifies the screen to use API call"
^DIC(9.4,76,22,1,"PAH",8,1,13,0)="$$GET^XUA4A72(IEN) to check if the ^VA(200 entry has a PERSON CLASS"
^DIC(9.4,76,22,1,"PAH",8,1,14,0)="entered prior to adding the entry as a Provider."
^DIC(9.4,76,22,1,"PAH",9,0)="8 SEQ #11^2961224^1"
^DIC(9.4,76,22,1,"PAH",9,1,0)="^^5^5^2961224"
^DIC(9.4,76,22,1,"PAH",9,1,1,0)="IBD*2.1*8 TEST v2"
^DIC(9.4,76,22,1,"PAH",9,1,2,0)=" "
^DIC(9.4,76,22,1,"PAH",9,1,3,0)="ROUTINES: IBDF18E IBDFDE IBDFDE1 IBDFDE21 IBDFDE7 IBDFDE8 IBDFDE9"
^DIC(9.4,76,22,1,"PAH",9,1,4,0)=" "
^DIC(9.4,76,22,1,"PAH",9,1,5,0)="TEST SITES: IOWA-CITY, DES-MOINES, BLACK HILLS, SEPULVEDA"
^DIC(9.4,76,22,1,"PAH",10,0)="14 SEQ #12^2970204^1"
^DIC(9.4,76,22,1,"PAH",10,1,0)="^^2^2^2970204"
^DIC(9.4,76,22,1,"PAH",10,1,1,0)="Patch IBD*2.1*14 "
^DIC(9.4,76,22,1,"PAH",10,1,2,0)="This patch includes KIDS post-install routine IBDY214."
^DIC(9.4,76,22,1,"PAH",11,0)="16 SEQ #13^2970303^1"
^DIC(9.4,76,22,1,"PAH",11,1,0)="^^1^1^2970303"
^DIC(9.4,76,22,1,"PAH",11,1,1,0)="patch routine IBDFQB for AICS v2.1"
^DIC(9.4,76,22,1,"PAH",12,0)="17 SEQ #14^2970326^1"
^DIC(9.4,76,22,1,"PAH",12,1,0)="^^5^5^2970326"
^DIC(9.4,76,22,1,"PAH",12,1,1,0)="Modification to code that interfaces with PCE to accept expanded"
^DIC(9.4,76,22,1,"PAH",12,1,2,0)="return values."
^DIC(9.4,76,22,1,"PAH",12,1,3,0)=" "
^DIC(9.4,76,22,1,"PAH",12,1,4,0)="Fixes to MDE options for CPT code narrative and clinical lexicon"
^DIC(9.4,76,22,1,"PAH",12,1,5,0)="selection."
^DIC(9.4,76,22,1,"PAH",13,0)="18 SEQ #15^2970401^1"
^DIC(9.4,76,22,1,"PAH",13,1,0)="^^1^1^2970401"
^DIC(9.4,76,22,1,"PAH",13,1,1,0)="Emergency patch IBD*2.1*18"
^DIC(9.4,76,22,1,"PAH",14,0)="10 SEQ #16^2970408^1"
^DIC(9.4,76,22,1,"PAH",14,1,0)="^^2^2^2970408"
^DIC(9.4,76,22,1,"PAH",14,1,1,0)="fix for 1010T print from Registration, released in conjunction with"
^DIC(9.4,76,22,1,"PAH",14,1,2,0)="DG*5.3*108."
^DIC(9.4,76,22,1,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,76,22,1,"PAH","B","10 SEQ #16",14)=""
^DIC(9.4,76,22,1,"PAH","B","13 SEQ #8",7)=""
^DIC(9.4,76,22,1,"PAH","B","14 SEQ #12",10)=""
