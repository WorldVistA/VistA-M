^DIC(9.4,100,22,0)="^9.49I^15^1"
^DIC(9.4,100,22,15,0)="5.01^3051119^2960821"
^DIC(9.4,100,22,15,"PAH",0)="^9.4901^148^148"
^DIC(9.4,100,22,15,"PAH",1,0)="21 SEQ #20^2960903^1"
^DIC(9.4,100,22,15,"PAH",2,0)="22 SEQ #21^2961002^1"
^DIC(9.4,100,22,15,"PAH",3,0)="19 SEQ #22^2961108^1"
^DIC(9.4,100,22,15,"PAH",4,0)="23 SEQ #23^2961224^1"
^DIC(9.4,100,22,15,"PAH",5,0)="20 SEQ #24^2961227^1"
^DIC(9.4,100,22,15,"PAH",6,0)="25^2970122^1"
^DIC(9.4,100,22,15,"PAH",7,0)="24^2970414^1"
^DIC(9.4,100,22,15,"PAH",8,0)="26 SEQ #27^2970528^1"
^DIC(9.4,100,22,15,"PAH",8,1,0)="^^1^1^2970528"
^DIC(9.4,100,22,15,"PAH",8,1,1,0)="Mental Health Treatment Planner"
^DIC(9.4,100,22,15,"PAH",9,0)="30^2970922^1"
^DIC(9.4,100,22,15,"PAH",9,1,0)="^^1^1^2970922"
^DIC(9.4,100,22,15,"PAH",9,1,1,0)="This patch addresses issues with the Addiction Severity Index software."
^DIC(9.4,100,22,15,"PAH",10,0)="32 SEQ #29^2970922^1"
^DIC(9.4,100,22,15,"PAH",10,1,0)="^^1^1^2970922"
^DIC(9.4,100,22,15,"PAH",10,1,1,0)="This patch is being released to correct problems with YS*5.01*30."
^DIC(9.4,100,22,15,"PAH",11,0)="33 SEQ #30^2971127^1"
^DIC(9.4,100,22,15,"PAH",11,1,0)="^^4^4^2971127"
^DIC(9.4,100,22,15,"PAH",11,1,1,0)="This enhancement patch will introduce the Global Assessment of Functioning "
^DIC(9.4,100,22,15,"PAH",11,1,2,0)="(GAF) to the Mental Health software.  This patch introduces two alternate "
^DIC(9.4,100,22,15,"PAH",11,1,3,0)="ways of entering a GAF score (Axis 5) and two new reports.  The existing"
^DIC(9.4,100,22,15,"PAH",11,1,4,0)="Diagnostic software has been modified to now accept the GAF score from 100-1."
^DIC(9.4,100,22,15,"PAH",12,0)="29 SEQ #31^2971127^1"
^DIC(9.4,100,22,15,"PAH",12,1,0)="^^3^3^2971127"
^DIC(9.4,100,22,15,"PAH",12,1,1,0)="The Mental Health protocol YS PATIENT MOVEMENT, which is part of the DGPM "
^DIC(9.4,100,22,15,"PAH",12,1,2,0)="MOVEMENT EVENTS protocol, has been modified to run silent when invoked by "
^DIC(9.4,100,22,15,"PAH",12,1,3,0)="Order Entry/Results Reporting."
^DIC(9.4,100,22,15,"PAH",13,0)="37 SEQ #32^2980417^1"
^DIC(9.4,100,22,15,"PAH",13,1,0)="^^1^1^2980417"
^DIC(9.4,100,22,15,"PAH",13,1,1,0)="This patch has all changes for Mental Health V. 5.01 to be Year 2000 compliant."
^DIC(9.4,100,22,15,"PAH",14,0)="38 SEQ #33^2980725^1"
^DIC(9.4,100,22,15,"PAH",14,1,0)="^^7^7^2980725"
^DIC(9.4,100,22,15,"PAH",14,1,1,0)="This patch will introduce the following changes to the Addiction Survey Index"
^DIC(9.4,100,22,15,"PAH",14,1,2,0)="software.  Three new options have been included: ASI Case Finder [YSAS CASE "
^DIC(9.4,100,22,15,"PAH",14,1,3,0)="FINDER], ASI Followup Finder [YSAS FOLLOWUP FINDER] and Site Report by Date"
^DIC(9.4,100,22,15,"PAH",14,1,4,0)="[YSAS MANAGEMENT REPORT].  The ASI software will now produce a narrative report "
^DIC(9.4,100,22,15,"PAH",14,1,5,0)="for the followup ASI.  The addition of a signature block has been added to the"
^DIC(9.4,100,22,15,"PAH",14,1,6,0)="narrative reports.  Also included in this patch are numerous NOIS fixes.  See"
^DIC(9.4,100,22,15,"PAH",14,1,7,0)="patch description for a complete list."
^DIC(9.4,100,22,15,"PAH",15,0)="40 SEQ #34^2980923^1"
^DIC(9.4,100,22,15,"PAH",15,1,0)="^^2^2^2980923"
^DIC(9.4,100,22,15,"PAH",15,1,1,0)="See National Patch Module YS*5.01*40 for details of this patch."
^DIC(9.4,100,22,15,"PAH",15,1,2,0)=""
^DIC(9.4,100,22,15,"PAH",16,0)="41 SEQ #35^2980923^1"
^DIC(9.4,100,22,15,"PAH",16,1,0)="^^3^3^2980923"
^DIC(9.4,100,22,15,"PAH",16,1,1,0)="See National Patch Module YS*5.01*41 for details of this patch."
^DIC(9.4,100,22,15,"PAH",16,1,2,0)=""
^DIC(9.4,100,22,15,"PAH",16,1,3,0)=""
^DIC(9.4,100,22,15,"PAH",17,0)="44 SEQ #36^2980923^1"
^DIC(9.4,100,22,15,"PAH",17,1,0)="^^1^1^2980923"
^DIC(9.4,100,22,15,"PAH",17,1,1,0)="See National Patch Module patch YS*5.01*44 for details."
^DIC(9.4,100,22,15,"PAH",18,0)="45 SEQ #37^2981007^1"
^DIC(9.4,100,22,15,"PAH",18,1,0)="^^8^8^2981007"
^DIC(9.4,100,22,15,"PAH",18,1,1,0)="The new Case Finder routine ^YSASCF introduced by patch YS*5.01*38 obtains"
^DIC(9.4,100,22,15,"PAH",18,1,2,0)="OP diagnosis information from the Outpatient Diagnosis file (#409.43)."
^DIC(9.4,100,22,15,"PAH",18,1,3,0)="Scheduling patch SD*5.3*132, released shortly after the Mental Health patch,"
^DIC(9.4,100,22,15,"PAH",18,1,4,0)="begins storing this data in the V POV file (#9000010.07). Therefore, after"
^DIC(9.4,100,22,15,"PAH",18,1,5,0)="sites install SD*5.3*132, the case finder (^YSASCF) will no longer find"
^DIC(9.4,100,22,15,"PAH",18,1,6,0)="outpatients because file #409.43 is no longer being updated.  Routine"
^DIC(9.4,100,22,15,"PAH",18,1,7,0)="YSASCF as released with patch YS*5.01*38 will be modified in this patch to"
^DIC(9.4,100,22,15,"PAH",18,1,8,0)="pull the information from the new file."
^DIC(9.4,100,22,15,"PAH",19,0)="46 SEQ #38^2981016^1"
^DIC(9.4,100,22,15,"PAH",19,1,0)="^^32^32^2981016"
^DIC(9.4,100,22,15,"PAH",19,1,1,0)=" Some sites are getting errors while trying to install Mental Health patches"
^DIC(9.4,100,22,15,"PAH",19,1,2,0)=" when required mental health builds exist in the REQUIRED BUILDS field (#11) of"
^DIC(9.4,100,22,15,"PAH",19,1,3,0)=" the Kids BUILD file (#9.6).  The install will abort stating that a required"
^DIC(9.4,100,22,15,"PAH",19,1,4,0)=" patch is missing.  However, when the site checks on the missing patch, they"
^DIC(9.4,100,22,15,"PAH",19,1,5,0)=" discover that the patch IS installed.  This became evident when test sites"
^DIC(9.4,100,22,15,"PAH",19,1,6,0)=" were attempting to install YS*5.01*44 which required patch YS*5.01*38 to be"
^DIC(9.4,100,22,15,"PAH",19,1,7,0)=" installed.  The install would abort saying that patch 38 is not installed"
^DIC(9.4,100,22,15,"PAH",19,1,8,0)=" even though it was.  (This same error occurred when test sites were"
^DIC(9.4,100,22,15,"PAH",19,1,9,0)=" attempting to install YS*5.01*45.)"
^DIC(9.4,100,22,15,"PAH",19,1,10,0)=" "
^DIC(9.4,100,22,15,"PAH",19,1,11,0)=" This is caused by old entries in the PACKAGE (#9.4) file confusing the install."
^DIC(9.4,100,22,15,"PAH",19,1,12,0)=" During installation of a Mental Health patch, the install looks at the"
^DIC(9.4,100,22,15,"PAH",19,1,13,0)=" PREFIX field (#1) of the PACAKAGE file (#9.4).  If it contains ""YS"", it"
^DIC(9.4,100,22,15,"PAH",19,1,14,0)=" then refers to the history for that package to verify that the required"
^DIC(9.4,100,22,15,"PAH",19,1,15,0)=" patches have been installed.  Any entries that contain the ""YS"" prefix but"
^DIC(9.4,100,22,15,"PAH",19,1,16,0)=" do not contain ""Version 5.01 of Mental Health"" in the SHORT DESCRIPTION"
^DIC(9.4,100,22,15,"PAH",19,1,17,0)=" field (#2), cause the install to look at the wrong history.  The install"
^DIC(9.4,100,22,15,"PAH",19,1,18,0)=" aborts because it does not find the required patches."
^DIC(9.4,100,22,15,"PAH",19,1,19,0)=" "
^DIC(9.4,100,22,15,"PAH",19,1,20,0)=" This patch corrects the problem by executing routine YSPOS46 to ""clean up"""
^DIC(9.4,100,22,15,"PAH",19,1,21,0)=" the PACKAGE file.  This routine is included as a post installation routine"
^DIC(9.4,100,22,15,"PAH",19,1,22,0)=" for this patch.  During the installation, the user is asked if they would"
^DIC(9.4,100,22,15,"PAH",19,1,23,0)=" like to 'Delete old package file entries?'  If the user says 'Yes', all but"
^DIC(9.4,100,22,15,"PAH",19,1,24,0)=" the current version 5.01 Mental Health entry is deleted.  If the user"
^DIC(9.4,100,22,15,"PAH",19,1,25,0)=" answers 'No', the old ""YS"" prefix entries in the ""C"" cross reference of the"
^DIC(9.4,100,22,15,"PAH",19,1,26,0)=" PACKAGE file (^DIC(9.4,""C"",""YS"",0)) are renamed to YS1, YS2, YS3, etc.  Only"
^DIC(9.4,100,22,15,"PAH",19,1,27,0)=" the current version 5.01 entry is left unchanged."
^DIC(9.4,100,22,15,"PAH",19,1,28,0)=" "
^DIC(9.4,100,22,15,"PAH",19,1,29,0)=" PLEASE NOTE THAT NOTHING IS INSTALLED WITH THIS PATCH.  IT CONSISTS ONLY OF"
^DIC(9.4,100,22,15,"PAH",19,1,30,0)=" THE USER QUESTION DURING INSTALLATION AND EXECUTION OF POST INSTALLATION"
^DIC(9.4,100,22,15,"PAH",19,1,31,0)=" ROUTINE YSPOS46."
^DIC(9.4,100,22,15,"PAH",19,1,32,0)="  "
^DIC(9.4,100,22,15,"PAH",20,0)="42 SEQ #39^2981016^1"
^DIC(9.4,100,22,15,"PAH",20,1,0)="^^85^85^2981016"
^DIC(9.4,100,22,15,"PAH",20,1,1,0)=" VHA Directive, 97-059, dated November 25, 1997, ""Instituting Global"
^DIC(9.4,100,22,15,"PAH",20,1,2,0)=" Assessment of Function (GAF) Scores in Axis V Mental Health Patients"", has"
^DIC(9.4,100,22,15,"PAH",20,1,3,0)=" been released.  This directive provides guidelines for collection of GAF"
^DIC(9.4,100,22,15,"PAH",20,1,4,0)=" Scores for outpatients and inpatients.  Inpatient Axis V (GAF) scores have"
^DIC(9.4,100,22,15,"PAH",20,1,5,0)=" been collected for several years, but up to now there has been no provision"
^DIC(9.4,100,22,15,"PAH",20,1,6,0)=" for collection of GAF Scores for outpatients.  Storage will be in the VISTA"
^DIC(9.4,100,22,15,"PAH",20,1,7,0)=" Mental Health software package."
^DIC(9.4,100,22,15,"PAH",20,1,8,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,9,0)=" This patch contains two new API's that are used for the storage/retrieval"
^DIC(9.4,100,22,15,"PAH",20,1,10,0)=" of GAF score data in the DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8)."
^DIC(9.4,100,22,15,"PAH",20,1,11,0)=" The API's are described as follows:"
^DIC(9.4,100,22,15,"PAH",20,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,13,0)=" API entry point RET^YSGAF(YSX) retrieves GAF score information from the"
^DIC(9.4,100,22,15,"PAH",20,1,14,0)=" DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8).  It returns the latest GAF"
^DIC(9.4,100,22,15,"PAH",20,1,15,0)=" score and diagnosis date/time for the patient based on the internal entry"
^DIC(9.4,100,22,15,"PAH",20,1,16,0)=" number (variable YSX) passed into the API.  The score/date is returned in the"
^DIC(9.4,100,22,15,"PAH",20,1,17,0)=" form of a concatenated string.  If no GAF data is found, -1 is returned."
^DIC(9.4,100,22,15,"PAH",20,1,18,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,19,0)=" API entry point UPD^YSGAF(YSPN,YSGN,YSGD,YSGC,YSPT) is designed to store"
^DIC(9.4,100,22,15,"PAH",20,1,20,0)=" patient GAF score information in the DIAGNOSTIC RESULTS - MENTAL HEALTH"
^DIC(9.4,100,22,15,"PAH",20,1,21,0)=" file (#627.8).  The following information is passed into this call:"
^DIC(9.4,100,22,15,"PAH",20,1,22,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,23,0)="        YSPN    Patient name -  Pointer to the PATIENT file (#2)"
^DIC(9.4,100,22,15,"PAH",20,1,24,0)="        YSGN    GAF score (Axis 5)"
^DIC(9.4,100,22,15,"PAH",20,1,25,0)="        YSGD    Date/Time of diagnosis"
^DIC(9.4,100,22,15,"PAH",20,1,26,0)="        YSGC    Diagnosis by -  Pointer to the NEW PERSON file (#200)"
^DIC(9.4,100,22,15,"PAH",20,1,27,0)="        YSPT    Patient type -  'I'npatient or 'O'utpatient"
^DIC(9.4,100,22,15,"PAH",20,1,28,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,29,0)=" This API updates new field PATIENT TYPE (#66) in the DIAGNOSTIC RESULTS -"
^DIC(9.4,100,22,15,"PAH",20,1,30,0)=" MENTAL HEALTH file (#627.8) which was created to store the patient type of"
^DIC(9.4,100,22,15,"PAH",20,1,31,0)=" the GAF record.  It is a set of codes consisting of 'I' for inpatient and 'O'"
^DIC(9.4,100,22,15,"PAH",20,1,32,0)=" for outpatient."
^DIC(9.4,100,22,15,"PAH",20,1,33,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,34,0)=" This API routine call creates a new record with the above information in the"
^DIC(9.4,100,22,15,"PAH",20,1,35,0)=" DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8) in order to maintain a"
^DIC(9.4,100,22,15,"PAH",20,1,36,0)=" historical record of GAF scores for an individual patient."
^DIC(9.4,100,22,15,"PAH",20,1,37,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,38,0)="   Associated NOIS:   None"
^DIC(9.4,100,22,15,"PAH",20,1,39,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,40,0)="   Test Site(s):      Canandaigua, NY"
^DIC(9.4,100,22,15,"PAH",20,1,41,0)="                      Tuscaloosa, AL"
^DIC(9.4,100,22,15,"PAH",20,1,42,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,43,0)="   ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",20,1,44,0)="   ================"
^DIC(9.4,100,22,15,"PAH",20,1,45,0)="   The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",20,1,46,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,47,0)="   <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",20,1,48,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,49,0)="                               Checksum Values"
^DIC(9.4,100,22,15,"PAH",20,1,50,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,51,0)="   Routine Name       Before Patch        After Patch         Patch List"
^DIC(9.4,100,22,15,"PAH",20,1,52,0)="   ------------       ------------        -----------         ----------"
^DIC(9.4,100,22,15,"PAH",20,1,53,0)="   YS42ENV                     N/A            2916949         42"
^DIC(9.4,100,22,15,"PAH",20,1,54,0)="   YSGAF                  12321822           13001186         33,37,40,42"
^DIC(9.4,100,22,15,"PAH",20,1,55,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,56,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,57,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,58,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",20,1,59,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",20,1,60,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,61,0)="   1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",20,1,62,0)="      This option will load the KIDS package in this message onto your"
^DIC(9.4,100,22,15,"PAH",20,1,63,0)="      system."
^DIC(9.4,100,22,15,"PAH",20,1,64,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,65,0)="   2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",20,1,66,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,100,22,15,"PAH",20,1,67,0)="      On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,100,22,15,"PAH",20,1,68,0)="      following options:"
^DIC(9.4,100,22,15,"PAH",20,1,69,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,70,0)="                 Print Transport Global"
^DIC(9.4,100,22,15,"PAH",20,1,71,0)="                 Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",20,1,72,0)="                 Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",20,1,73,0)="                 Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",20,1,74,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,75,0)="   3. Users may remain on the system, but installation should be done at"
^DIC(9.4,100,22,15,"PAH",20,1,76,0)="      off peak hours."
^DIC(9.4,100,22,15,"PAH",20,1,77,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,78,0)="   4. Installation will take less than five minutes."
^DIC(9.4,100,22,15,"PAH",20,1,79,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,80,0)="   5. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",20,1,81,0)="      'Install Package(s)' Select the package 'YS*5.01*42' and proceed"
^DIC(9.4,100,22,15,"PAH",20,1,82,0)="      with install."
^DIC(9.4,100,22,15,"PAH",20,1,83,0)=" "
^DIC(9.4,100,22,15,"PAH",20,1,84,0)="   6. Delete routine YS42ENV."
^DIC(9.4,100,22,15,"PAH",20,1,85,0)=" "
^DIC(9.4,100,22,15,"PAH",21,0)="43 SEQ #40^2990119^1"
^DIC(9.4,100,22,15,"PAH",21,1,0)="^^236^236^2990119"
^DIC(9.4,100,22,15,"PAH",21,1,1,0)="VHA Directive, 97-059, dated November 25, 1997, ""Instituting Global "
^DIC(9.4,100,22,15,"PAH",21,1,2,0)="Assessment of Function (GAF) Scores in Axis V Mental Health Patients"", has "
^DIC(9.4,100,22,15,"PAH",21,1,3,0)="been released.  This directive provides guidelines for collection of GAF "
^DIC(9.4,100,22,15,"PAH",21,1,4,0)="Scores for outpatients and inpatients.  Inpatient Axis V (GAF) scores have "
^DIC(9.4,100,22,15,"PAH",21,1,5,0)="been collected for several years, but up to now there has been no provision "
^DIC(9.4,100,22,15,"PAH",21,1,6,0)="for collection of GAF Scores for outpatients.  Storage and collection of GAF"
^DIC(9.4,100,22,15,"PAH",21,1,7,0)="scores will be in the VISTA Mental Health software package file"
^DIC(9.4,100,22,15,"PAH",21,1,8,0)="DIAGNOSTIC RESULTS - MENTAL HEALTH (#627.8).  "
^DIC(9.4,100,22,15,"PAH",21,1,9,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,10,0)="The GAF initiative is using the VISTA HL7 software to transport the GAF "
^DIC(9.4,100,22,15,"PAH",21,1,11,0)="score data onto the Austin Automation Center (AAC) system.  An A08 HL7 "
^DIC(9.4,100,22,15,"PAH",21,1,12,0)="message will be used to transmit GAF Scores to the National Patient"
^DIC(9.4,100,22,15,"PAH",21,1,13,0)="Care Database (NPCD). This message contains the MSH, EVN, PID and OBX"
^DIC(9.4,100,22,15,"PAH",21,1,14,0)="segments."
^DIC(9.4,100,22,15,"PAH",21,1,15,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,16,0)="This patch will allow the sites to transmit GAF scores to the National "
^DIC(9.4,100,22,15,"PAH",21,1,17,0)="Patient Care Database (NPCD) at the AAC.  Sites will be able to transmit GAF"
^DIC(9.4,100,22,15,"PAH",21,1,18,0)="scores in a batch mode using the call point EN^YSGAFTR.  EN^YSGAFTR will"
^DIC(9.4,100,22,15,"PAH",21,1,19,0)="prompt the user for a date range, this date range will be the selection"
^DIC(9.4,100,22,15,"PAH",21,1,20,0)="criteria that is used when determining the GAF scores to be transmitted to "
^DIC(9.4,100,22,15,"PAH",21,1,21,0)="the NPCD at the AAC.  The batch processing will allow sites to initially "
^DIC(9.4,100,22,15,"PAH",21,1,22,0)="populate GAF Scores at the NPCD."
^DIC(9.4,100,22,15,"PAH",21,1,23,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,24,0)="After the running of the batch transmission of GAF scores, all GAF scores "
^DIC(9.4,100,22,15,"PAH",21,1,25,0)="entered will be dynamically sent to the NPCD at the AAC."
^DIC(9.4,100,22,15,"PAH",21,1,26,0)=""
^DIC(9.4,100,22,15,"PAH",21,1,27,0)="The new Q-NPT.DOMAIN.EXT domain, which receives the HL7 messages,"
^DIC(9.4,100,22,15,"PAH",21,1,28,0)="implementation instructions are released by MailMan XM*DBA*119 informational"
^DIC(9.4,100,22,15,"PAH",21,1,29,0)="patch. "
^DIC(9.4,100,22,15,"PAH",21,1,30,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,31,0)="The (G)lobal (A)ssessment of (F)unction Transmission patch components are:"
^DIC(9.4,100,22,15,"PAH",21,1,32,0)="        - 4 New routines, YS43POST, YSGAFHL7, YSGAFOBX, YSGAFTR"
^DIC(9.4,100,22,15,"PAH",21,1,33,0)="        - 2 Patched routines, YSDX3B, YSGAF"
^DIC(9.4,100,22,15,"PAH",21,1,34,0)="        - 2 New mail groups, YS GAF TO NPCD, YS GAF TRANSMISSION ACK"
^DIC(9.4,100,22,15,"PAH",21,1,35,0)="        - 2 New Protocols, YS GAF, YS GAF A08 CLIENT"
^DIC(9.4,100,22,15,"PAH",21,1,36,0)="        - 1 New HL7 Application Parameter, YS GAF"
^DIC(9.4,100,22,15,"PAH",21,1,37,0)="        - 1 New HL Lower Level Protocol Parameter, YS GAF SEND"
^DIC(9.4,100,22,15,"PAH",21,1,38,0)="        - 1 New HL Logical Link, YS GAF-SND"
^DIC(9.4,100,22,15,"PAH",21,1,39,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,40,0)="GAF Mail Groups"
^DIC(9.4,100,22,15,"PAH",21,1,41,0)="---------------"
^DIC(9.4,100,22,15,"PAH",21,1,42,0)="YS GAF TO NPCD: This mail group is used for transmission of HL7 messages "
^DIC(9.4,100,22,15,"PAH",21,1,43,0)="derived from the parameters defined in the DIAGNOSTIC RESULTS - MENTAL "
^DIC(9.4,100,22,15,"PAH",21,1,44,0)="HEALTH file (#627.8) to the AAC."
^DIC(9.4,100,22,15,"PAH",21,1,45,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,46,0)="YS GAF TRANSMISSION ACK: This mail group is used to receive Confirmation "
^DIC(9.4,100,22,15,"PAH",21,1,47,0)="and Processing Report Messages from Austin.  "
^DIC(9.4,100,22,15,"PAH",21,1,48,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,49,0)="Protocols"
^DIC(9.4,100,22,15,"PAH",21,1,50,0)="---------"
^DIC(9.4,100,22,15,"PAH",21,1,51,0)="YS GAF: This event driver protocol defines the associated parameters needed "
^DIC(9.4,100,22,15,"PAH",21,1,52,0)="to build the HL7 message used to send the GAF data to Austin."
^DIC(9.4,100,22,15,"PAH",21,1,53,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,54,0)="YS GAF A08 CLIENT: This subscriber protocol defines the parameter needed by "
^DIC(9.4,100,22,15,"PAH",21,1,55,0)="HL7 package to determine where to send the HL7 formatted message "
^DIC(9.4,100,22,15,"PAH",21,1,56,0)="containing the GAF information."
^DIC(9.4,100,22,15,"PAH",21,1,57,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,58,0)="Changes to routine YSGAF (YS*5.01*42)"
^DIC(9.4,100,22,15,"PAH",21,1,59,0)="-------------------------------------"
^DIC(9.4,100,22,15,"PAH",21,1,60,0)="The API RET^YSGAF was changed to use the DIAGNOSTIC RESULTS - MENTAL"
^DIC(9.4,100,22,15,"PAH",21,1,61,0)="HEALTH file (#627.8) ""C"" cross-reference to look up the latest patient GAF"
^DIC(9.4,100,22,15,"PAH",21,1,62,0)="score. This corrected performance issues that were reported after the"
^DIC(9.4,100,22,15,"PAH",21,1,63,0)="loading of SD*5.3*149 and YS*5.01*42."
^DIC(9.4,100,22,15,"PAH",21,1,64,0)="               (WPB-1298-31096 BAY-1298-30934 CHS-1298-40830 "
^DIC(9.4,100,22,15,"PAH",21,1,65,0)="                EKH-1298-40379 NTH-1198-72024)"
^DIC(9.4,100,22,15,"PAH",21,1,66,0)=""
^DIC(9.4,100,22,15,"PAH",21,1,67,0)="The API UPD^YSGAF was changed to kill all necessary variables set within the"
^DIC(9.4,100,22,15,"PAH",21,1,68,0)="API upon exiting. (BHH-1298-41082)"
^DIC(9.4,100,22,15,"PAH",21,1,69,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,70,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,71,0)="   Associated NOIS: WPB-1298-31096"
^DIC(9.4,100,22,15,"PAH",21,1,72,0)="                    BAY-1298-30934"
^DIC(9.4,100,22,15,"PAH",21,1,73,0)="                    CHS-1298-40830 "
^DIC(9.4,100,22,15,"PAH",21,1,74,0)="                    EKH-1298-40379 "
^DIC(9.4,100,22,15,"PAH",21,1,75,0)="                    NTH-1198-72024 "
^DIC(9.4,100,22,15,"PAH",21,1,76,0)="                    BHH-1298-41082"
^DIC(9.4,100,22,15,"PAH",21,1,77,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,78,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,79,0)="   Test Site(s):   Canandaigua, NY"
^DIC(9.4,100,22,15,"PAH",21,1,80,0)="                   Chicago HCS, IL"
^DIC(9.4,100,22,15,"PAH",21,1,81,0)="                   Dallas, TX"
^DIC(9.4,100,22,15,"PAH",21,1,82,0)="                   Miami, FL"
^DIC(9.4,100,22,15,"PAH",21,1,83,0)="                   Salt Lake City, UT"
^DIC(9.4,100,22,15,"PAH",21,1,84,0)="                   Tuscaloosa, AL"
^DIC(9.4,100,22,15,"PAH",21,1,85,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,86,0)=" "
