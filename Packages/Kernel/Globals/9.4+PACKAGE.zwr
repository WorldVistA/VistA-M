^DIC(9.4,49,22,10,"PAH",282,1,0)="^^1^1^3071212"
^DIC(9.4,49,22,10,"PAH",282,1,1,0)="Patch to enable the processing of new Emdeon reports."
^DIC(9.4,49,22,10,"PAH",283,0)="371 SEQ #351^3080203.214052^1"
