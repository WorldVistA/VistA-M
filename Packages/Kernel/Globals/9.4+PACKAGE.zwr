^DIC(9.4,11,22,5.03,"PAH",33,1,91,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",33,1,92,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",33,1,93,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",33,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",33,1,95,0)="                    Checksum       Checksum"
