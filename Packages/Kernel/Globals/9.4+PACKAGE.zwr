^DIC(9.4,100,0)="MENTAL HEALTH^YS^Version 5.01 of Mental Health"
^DIC(9.4,100,1,0)="^^6^6^2941104^^^^"
^DIC(9.4,100,1,1,0)="Mental Health belongs to the CORE+8 group of DHCP packages.  This package"
^DIC(9.4,100,1,2,0)="includes modules to assist Psychologists, Psychiatrists, Nurses, Social"
^DIC(9.4,100,1,3,0)="Workers, and other health-care professionals in the care of Mental"
^DIC(9.4,100,1,4,0)="Health patients.  Major clinical entities include various clinical"
^DIC(9.4,100,1,5,0)="modules and options, an inpatient module, a psychologic testing"
^DIC(9.4,100,1,6,0)="module, and various supervisory options."
