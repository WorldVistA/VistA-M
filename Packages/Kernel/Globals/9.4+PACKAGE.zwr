^DIC(9.4,48,22,5.28,"PAH",58,0)="112 SEQ #96^2970414^1"
^DIC(9.4,48,22,5.28,"PAH",58,1,0)="^^3^3^2970414"
^DIC(9.4,48,22,5.28,"PAH",58,1,1,0)="This patch corrects a problem in the creation/editing/printing of"
^DIC(9.4,48,22,5.28,"PAH",58,1,2,0)="encounter forms.  A PCMM API related to current practitioner was incorrect"
^DIC(9.4,48,22,5.28,"PAH",58,1,3,0)="and is patched here.  See NPM for complete description."
