^DIC(9.4,93,22,21,"PAH",37,0)="48 SEQ #44^3021025^1"
^DIC(9.4,93,22,21,"PAH",37,1,0)="^^1^1^3021025"
^DIC(9.4,93,22,21,"PAH",37,1,1,0)="See Patch Description DVBA*2.7*48"
^DIC(9.4,93,22,21,"PAH",38,0)="46 SEQ #45^3021116^1"
^DIC(9.4,93,22,21,"PAH",38,1,0)="^^8^8^3021116"
^DIC(9.4,93,22,21,"PAH",38,1,1,0)="This  patch updates the following AMIE worksheets:"
^DIC(9.4,93,22,21,"PAH",38,1,2,0)=""
^DIC(9.4,93,22,21,"PAH",38,1,3,0)="  - MENTAL DISORDER (except PTSD and Eating Disorders)"
^DIC(9.4,93,22,21,"PAH",38,1,4,0)="  - INITIAL EVALUATION FOR POST-TRAUMATIC STRESS DISORDER (PTSD)"
^DIC(9.4,93,22,21,"PAH",38,1,5,0)="  - EATING DISORDERS (Mental Disorders)"
^DIC(9.4,93,22,21,"PAH",38,1,6,0)="  - REVIEW EXAMINATION FOR POST-TRAUMATIC STRESS DISORDER (PTSD)"
^DIC(9.4,93,22,21,"PAH",38,1,7,0)="  - SPINE(CERVICAL, THORACIC, AND LUMBAR)"
^DIC(9.4,93,22,21,"PAH",38,1,8,0)=""
