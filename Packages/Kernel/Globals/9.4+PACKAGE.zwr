^DIC(9.4,3,22,21,"PAH",17,1,50,0)=" XPDET          4654700         15,39,41"
^DIC(9.4,3,22,21,"PAH",17,1,51,0)=" XPDI           15955866        10,21,39,41"
^DIC(9.4,3,22,21,"PAH",17,1,52,0)=" XPDIGP         6735250         41"
^DIC(9.4,3,22,21,"PAH",17,1,53,0)=" XPDIJ          10666490        2,21,28,41"
^DIC(9.4,3,22,21,"PAH",17,1,54,0)=" XPDIJ1         8772642         41"
^DIC(9.4,3,22,21,"PAH",17,1,55,0)=" XPDIL1         6509127         15,17,39,41"
^DIC(9.4,3,22,21,"PAH",17,1,56,0)=" XPDIP          9642216         15,21,28,30,41"
^DIC(9.4,3,22,21,"PAH",17,1,57,0)=" XPDIU          6010331         15,41"
