^DIC(9.4,100,22,15,"PAH",54,1,67,0)="   N/A"
^DIC(9.4,100,22,15,"PAH",54,1,68,0)=""
^DIC(9.4,100,22,15,"PAH",54,1,69,0)=""
^DIC(9.4,100,22,15,"PAH",54,1,70,0)="   The following software and documentation files are exported as part of   "
^DIC(9.4,100,22,15,"PAH",54,1,71,0)="   this patch:"
^DIC(9.4,100,22,15,"PAH",54,1,72,0)="  "
^DIC(9.4,100,22,15,"PAH",54,1,73,0)="    File Name                     Contents                  Retrieval Format"
^DIC(9.4,100,22,15,"PAH",54,1,74,0)="    ---------                     --------                  ----------------"
^DIC(9.4,100,22,15,"PAH",54,1,75,0)="    YS_MHA.exe                    Mental Health Assistant   Binary"
^DIC(9.4,100,22,15,"PAH",54,1,76,0)="                                  Executable GUI version 1.0.2.10"
^DIC(9.4,100,22,15,"PAH",54,1,77,0)="                                  client."
^DIC(9.4,100,22,15,"PAH",54,1,78,0)="    YS50184_Setup_123.EXE         Mental Health Assistant   BINARY"
^DIC(9.4,100,22,15,"PAH",54,1,79,0)="                                  This file is the complete install"
^DIC(9.4,100,22,15,"PAH",54,1,80,0)="                                  for the Mental Health Assistant"
^DIC(9.4,100,22,15,"PAH",54,1,81,0)="                                  GUI version 1.0.2.10 client."
^DIC(9.4,100,22,15,"PAH",54,1,82,0)=" "
^DIC(9.4,100,22,15,"PAH",54,1,83,0)="    - YS_MHA.exe       MHA Executable"
^DIC(9.4,100,22,15,"PAH",54,1,84,0)="    - YS_MHA_SD.exe    Secure Desktop Executable"
^DIC(9.4,100,22,15,"PAH",54,1,85,0)="    - YS_MHA_KH.DLL    Keyboard Hook DLL used by Secure Desktop"
^DIC(9.4,100,22,15,"PAH",54,1,86,0)="    - YS_MHA.Hlp       Online Help file"
^DIC(9.4,100,22,15,"PAH",54,1,87,0)="    - YS_MHA.GID       Online Help configuration file"
^DIC(9.4,100,22,15,"PAH",54,1,88,0)=" "
^DIC(9.4,100,22,15,"PAH",54,1,89,0)="   The software files are available on one of the following OI Field"
^DIC(9.4,100,22,15,"PAH",54,1,90,0)="   Offices' ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",54,1,91,0)=" "
^DIC(9.4,100,22,15,"PAH",54,1,92,0)="   All sites are encouraged to use their FTP capability to obtain these "
^DIC(9.4,100,22,15,"PAH",54,1,93,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",54,1,94,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",54,1,95,0)="   are located."
^DIC(9.4,100,22,15,"PAH",54,1,96,0)=""
^DIC(9.4,100,22,15,"PAH",54,1,97,0)=" "
