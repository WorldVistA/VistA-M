^DIC(9.4,59,22,5,"PAH",245,0)="254^3100922.112258^17"
^DIC(9.4,59,22,5,"PAH",245,1,0)="^^4^4^3100922"
^DIC(9.4,59,22,5,"PAH",245,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",245,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",245,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",245,1,4,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",246,0)="261 SEQ #246^3101006.12385^17"
^DIC(9.4,59,22,5,"PAH",246,1,0)="^^62^62^3101006"
^DIC(9.4,59,22,5,"PAH",246,1,1,0)="This patch is being released in preparation for the Supra-Therapeutic"
^DIC(9.4,59,22,5,"PAH",246,1,2,0)="Dosages project. It contains the following 3 new fields that are being"
^DIC(9.4,59,22,5,"PAH",246,1,3,0)="added to the VA PRODUCT file (#50.68):"
^DIC(9.4,59,22,5,"PAH",246,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,5,0)="1. CREATE DEFAULT POSSIBLE DOSAGE field (#40)"
^DIC(9.4,59,22,5,"PAH",246,1,6,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,7,0)="   Field Description:"
^DIC(9.4,59,22,5,"PAH",246,1,8,0)="   -----------------"
^DIC(9.4,59,22,5,"PAH",246,1,9,0)="   Indicate whether Possible Dosages should be auto-created based on"
^DIC(9.4,59,22,5,"PAH",246,1,10,0)="   Dosage Form/Dispense Unit (Default) or if you want to control the"
^DIC(9.4,59,22,5,"PAH",246,1,11,0)="   Possible Dosage auto-creation process for the Dispense Drugs"
^DIC(9.4,59,22,5,"PAH",246,1,12,0)="   matched/re-matched to this VA Product."
^DIC(9.4,59,22,5,"PAH",246,1,13,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,14,0)="   YES - Possible Dosages will be auto-created based upon Dosage"
^DIC(9.4,59,22,5,"PAH",246,1,15,0)="         Form/Dispense Unit combination (Default)."
^DIC(9.4,59,22,5,"PAH",246,1,16,0)="    NO - Possible Dosages will be auto-created according to the rule set"
^DIC(9.4,59,22,5,"PAH",246,1,17,0)="         by the POSSIBLE DOSAGES TO CREATE (#41) and PACKAGE (#42) fields."
^DIC(9.4,59,22,5,"PAH",246,1,18,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,19,0)="2. POSSIBLE DOSAGES TO CREATE field (#41)"
^DIC(9.4,59,22,5,"PAH",246,1,20,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,21,0)="   Field Description:"
^DIC(9.4,59,22,5,"PAH",246,1,22,0)="   -----------------"
^DIC(9.4,59,22,5,"PAH",246,1,23,0)="   Indicate which Possible Dosages or if no Possible Dosages should be"
^DIC(9.4,59,22,5,"PAH",246,1,24,0)="   auto-created for Dispense Drugs matched/re-matched to this VA Product."
^DIC(9.4,59,22,5,"PAH",246,1,25,0)="   This field is used only if the CREATE DEFAULT POSSIBLE DOSAGE field"
^DIC(9.4,59,22,5,"PAH",246,1,26,0)="   (#40) is set to 'NO'."
^DIC(9.4,59,22,5,"PAH",246,1,27,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,28,0)="       N - No Possible Dosages are auto-created for Dispense Drugs matched"
^DIC(9.4,59,22,5,"PAH",246,1,29,0)="           to this VA PRODUCT entry during the match/re-match process."
^DIC(9.4,59,22,5,"PAH",246,1,30,0)="       O - Only 1x Possible Dosage is auto-created for Dispense Drugs"
^DIC(9.4,59,22,5,"PAH",246,1,31,0)="           matched to this VA PRODUCT entry during the match/re-match"
^DIC(9.4,59,22,5,"PAH",246,1,32,0)="           process."
^DIC(9.4,59,22,5,"PAH",246,1,33,0)="       B - Both 1x and 2x Possible Dosages are auto-created for Dispense"
^DIC(9.4,59,22,5,"PAH",246,1,34,0)="           Drugs matched to this VA PRODUCT entry during the"
^DIC(9.4,59,22,5,"PAH",246,1,35,0)="           match/re-match process."
^DIC(9.4,59,22,5,"PAH",246,1,36,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,37,0)="3. PACKAGE (#42)"
^DIC(9.4,59,22,5,"PAH",246,1,38,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,39,0)="   Field Description:"
^DIC(9.4,59,22,5,"PAH",246,1,40,0)="   -----------------"
^DIC(9.4,59,22,5,"PAH",246,1,41,0)="   Indicate the Package(s) use for the Possible Dosage(s) auto-created."
^DIC(9.4,59,22,5,"PAH",246,1,42,0)="   This field is used only if the CREATE DEFAULT POSSIBLE DOSAGE field"
^DIC(9.4,59,22,5,"PAH",246,1,43,0)="   (#40) is set to 'NO' and the POSSIBLE DOSAGES TO CREATE field (#41) is"
^DIC(9.4,59,22,5,"PAH",246,1,44,0)="   either set to 'O' or 'B'."
^DIC(9.4,59,22,5,"PAH",246,1,45,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,46,0)="      I  - Possible Dosages auto-created for Dispense Drugs"
^DIC(9.4,59,22,5,"PAH",246,1,47,0)="           matched/re-matched to this VA PRODUCT entry will be available"
^DIC(9.4,59,22,5,"PAH",246,1,48,0)="           for the Inpatient application only."
^DIC(9.4,59,22,5,"PAH",246,1,49,0)="      O  - Possible Dosages auto-created for Dispense Drugs"
^DIC(9.4,59,22,5,"PAH",246,1,50,0)="           matched/re-matched to this VA PRODUCT entry will be available"
^DIC(9.4,59,22,5,"PAH",246,1,51,0)="           for the Outpatient application only."
^DIC(9.4,59,22,5,"PAH",246,1,52,0)="      IO - Possible Dosages auto-created for Dispense Drugs"
^DIC(9.4,59,22,5,"PAH",246,1,53,0)="           matched/re-matched to this VA PRODUCT entry will be available"
^DIC(9.4,59,22,5,"PAH",246,1,54,0)="           for both, Inpatient and Outpatient applications."
^DIC(9.4,59,22,5,"PAH",246,1,55,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,56,0)="In addition, a post-install routine will run to update the CREATE DEFAULT"
^DIC(9.4,59,22,5,"PAH",246,1,57,0)="POSSIBLE DOSAGE field (#40) for every entry in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",246,1,58,0)="(#50.68) with the default value of YES. The post-install routine will be"
^DIC(9.4,59,22,5,"PAH",246,1,59,0)="automatically deleted from the system upon completion of the installation."
^DIC(9.4,59,22,5,"PAH",246,1,60,0)=" "
^DIC(9.4,59,22,5,"PAH",246,1,61,0)="Updates to these new fields will happen automatically via the monthly"
^DIC(9.4,59,22,5,"PAH",246,1,62,0)="National Drug File (NDF) Data Update patches."
^DIC(9.4,59,22,5,"PAH",247,0)="255^3101014.173603^17"
^DIC(9.4,59,22,5,"PAH",247,1,0)="^^17^17^3101014"
