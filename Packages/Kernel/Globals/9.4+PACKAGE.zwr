^DIC(9.4,13,22,7,"PAH",25,1,214,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,215,0)="     To test if the transport has been corrupted, you can use the"
^DIC(9.4,13,22,7,"PAH",25,1,216,0)="     ""Verify Package Integrity"" option.  This option is under"
^DIC(9.4,13,22,7,"PAH",25,1,217,0)="     Utilities under the KIDS menu.  It will compare the checksums"
^DIC(9.4,13,22,7,"PAH",25,1,218,0)="     in the build with the current checksums and list any that"
^DIC(9.4,13,22,7,"PAH",25,1,219,0)="     differ."
^DIC(9.4,13,22,7,"PAH",25,1,220,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,221,0)="Installation Instructions:"
^DIC(9.4,13,22,7,"PAH",25,1,222,0)="=========================="
^DIC(9.4,13,22,7,"PAH",25,1,223,0)="NOTE any instructions that are different for DSM sites."
^DIC(9.4,13,22,7,"PAH",25,1,224,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,225,0)="     1.   Users ARE NOT allowed to be on the system during the"
^DIC(9.4,13,22,7,"PAH",25,1,226,0)="     installation."
^DIC(9.4,13,22,7,"PAH",25,1,227,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,228,0)="     2.   Place TaskMan in a WAIT state."
^DIC(9.4,13,22,7,"PAH",25,1,229,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,230,0)="     3.   DSM sites: Disable routine mapping (DIC1, DIR, DIR1, &"
^DIC(9.4,13,22,7,"PAH",25,1,231,0)="     DIR2 are usually mapped)."
^DIC(9.4,13,22,7,"PAH",25,1,232,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,233,0)="     4.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan"
^DIC(9.4,13,22,7,"PAH",25,1,234,0)="     menu. This option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",25,1,235,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,236,0)="     5.   The patch has now been loaded into a Transport global on"
^DIC(9.4,13,22,7,"PAH",25,1,237,0)="     your system. You now need to use KIDS to install the Transport"
^DIC(9.4,13,22,7,"PAH",25,1,238,0)="     global."
^DIC(9.4,13,22,7,"PAH",25,1,239,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,240,0)="     6.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",25,1,241,0)="     following options:"
^DIC(9.4,13,22,7,"PAH",25,1,242,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,243,0)="           Verify Checksums in Transport Global"
^DIC(9.4,13,22,7,"PAH",25,1,244,0)="           Print Transport Global"
^DIC(9.4,13,22,7,"PAH",25,1,245,0)="           Compare Transport Global to Current System"
^DIC(9.4,13,22,7,"PAH",25,1,246,0)="           Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",25,1,247,0)="           Install Package(s)"
^DIC(9.4,13,22,7,"PAH",25,1,248,0)="           INSTALL NAME: DI*21.0*41"
^DIC(9.4,13,22,7,"PAH",25,1,249,0)="                         =========="
^DIC(9.4,13,22,7,"PAH",25,1,250,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,251,0)="     7.   DSM sites: Rebuild your mapped routine set."
^DIC(9.4,13,22,7,"PAH",25,1,252,0)=" "
^DIC(9.4,13,22,7,"PAH",25,1,253,0)="     8.   Remove TaskMan from its WAIT state."
^DIC(9.4,13,22,7,"PAH",26,0)="34 SEQ #41^2980604^1"
^DIC(9.4,13,22,7,"PAH",26,1,0)="^^53^53^2980604"
^DIC(9.4,13,22,7,"PAH",26,1,1,0)="This patch contains routines and Remote Procedures to support the VA"
^DIC(9.4,13,22,7,"PAH",26,1,2,0)="FileMan Delphi Components (FMDC).  FMDC provides data controls and data"
^DIC(9.4,13,22,7,"PAH",26,1,3,0)="access components that make it easy to work with VA FileMan data in Delphi"
^DIC(9.4,13,22,7,"PAH",26,1,4,0)="applications."
^DIC(9.4,13,22,7,"PAH",26,1,5,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,6,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",26,1,7,0)="================"
^DIC(9.4,13,22,7,"PAH",26,1,8,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,9,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,7,"PAH",26,1,10,0)="these routines now look like:"
^DIC(9.4,13,22,7,"PAH",26,1,11,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,12,0)=" <tab>;;21.0;VA FileMan;**34**;Feb 28, 1998"
^DIC(9.4,13,22,7,"PAH",26,1,13,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,14,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",26,1,15,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,16,0)=" Routine Name  Before Patch  After Patch  Patch List "
^DIC(9.4,13,22,7,"PAH",26,1,17,0)=" ============  ============  ===========  =========="
^DIC(9.4,13,22,7,"PAH",26,1,18,0)=" DDR           n/a           7267978      34 "
^DIC(9.4,13,22,7,"PAH",26,1,19,0)=" DDR0          n/a           4956773      34 "
^DIC(9.4,13,22,7,"PAH",26,1,20,0)=" DDR1          n/a           1043214      34 "
^DIC(9.4,13,22,7,"PAH",26,1,21,0)=" DDR2          n/a           7680688      34 "
^DIC(9.4,13,22,7,"PAH",26,1,22,0)=" DDR3          n/a           3479219      34 "
^DIC(9.4,13,22,7,"PAH",26,1,23,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,24,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",26,1,25,0)="=========================="
^DIC(9.4,13,22,7,"PAH",26,1,26,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,27,0)="1.  DSM sites: There is no need to map these routines at this time.  "
^DIC(9.4,13,22,7,"PAH",26,1,28,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,29,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,13,22,7,"PAH",26,1,30,0)="option will load the KIDS packages onto your system."
^DIC(9.4,13,22,7,"PAH",26,1,31,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,32,0)="3.  The patch has now been loaded into a transport global on your system."
^DIC(9.4,13,22,7,"PAH",26,1,33,0)="You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,7,"PAH",26,1,34,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,35,0)="4.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,13,22,7,"PAH",26,1,36,0)="options: "
^DIC(9.4,13,22,7,"PAH",26,1,37,0)="       Print Transport Global "
^DIC(9.4,13,22,7,"PAH",26,1,38,0)="       Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",26,1,39,0)="       Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",26,1,40,0)="       Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",26,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,42,0)="5.  Users do not need to logoff.  They may remain on the system while"
^DIC(9.4,13,22,7,"PAH",26,1,43,0)="this patch is installed."
^DIC(9.4,13,22,7,"PAH",26,1,44,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,45,0)="6.  There is no need to place Taskman in a WAIT state."
^DIC(9.4,13,22,7,"PAH",26,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",26,1,47,0)="7.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,13,22,7,"PAH",26,1,48,0)="option: "
^DIC(9.4,13,22,7,"PAH",26,1,49,0)="       Install Package(s): "
^DIC(9.4,13,22,7,"PAH",26,1,50,0)="       INSTALL NAME:  DI*21.0*34 "
^DIC(9.4,13,22,7,"PAH",26,1,51,0)="                      =========="
^DIC(9.4,13,22,7,"PAH",26,1,52,0)="       Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,7,"PAH",26,1,53,0)="and Protocols?"
^DIC(9.4,13,22,7,"PAH",27,0)="47 SEQ #42^2980725^1"
^DIC(9.4,13,22,7,"PAH",27,1,0)="^^141^141^2980725"
^DIC(9.4,13,22,7,"PAH",27,1,1,0)="Description:"
^DIC(9.4,13,22,7,"PAH",27,1,2,0)="==========="
^DIC(9.4,13,22,7,"PAH",27,1,3,0)="This patch corrects some problems with record and file deletion."
^DIC(9.4,13,22,7,"PAH",27,1,4,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,5,0)="DIK,DIK1"
^DIC(9.4,13,22,7,"PAH",27,1,6,0)="--------"
^DIC(9.4,13,22,7,"PAH",27,1,7,0)="The patch to these two routines backs out a change made by Patch DI*21*42."
^DIC(9.4,13,22,7,"PAH",27,1,8,0)="Prior to patch 42, when a record is deleted with ^DIK, the kill logic on"
^DIC(9.4,13,22,7,"PAH",27,1,9,0)="the .01 field of the record fired last, after the kill logic on other"
^DIC(9.4,13,22,7,"PAH",27,1,10,0)="fields. Patch 42 changed it so that the kill logic on the .01 field fired"
^DIC(9.4,13,22,7,"PAH",27,1,11,0)="first."
^DIC(9.4,13,22,7,"PAH",27,1,12,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,13,0)="This caused a problem for IFCAP. Cross references on File #421 are defined"
^DIC(9.4,13,22,7,"PAH",27,1,14,0)="in such a way that when a record is deleted, if the kill logic for the .01"
^DIC(9.4,13,22,7,"PAH",27,1,15,0)="field is fired before the kill logic on other fields, an erroneous ""AL"""
^DIC(9.4,13,22,7,"PAH",27,1,16,0)="cross reference remains on the file. Erroneous ""AL"" cross references can"
^DIC(9.4,13,22,7,"PAH",27,1,17,0)="cause subsequent errors when attempts are made to release transactions."
^DIC(9.4,13,22,7,"PAH",27,1,18,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,19,0)="This patch restores the pre-Patch 42 behavior, so that the kill logic on"
^DIC(9.4,13,22,7,"PAH",27,1,20,0)="the .01 field fires last when a record is deleted."
^DIC(9.4,13,22,7,"PAH",27,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,22,0)="  NOIS: ALT-0698-21639"
^DIC(9.4,13,22,7,"PAH",27,1,23,0)="        SAM-0698-20488"
^DIC(9.4,13,22,7,"PAH",27,1,24,0)="        SAJ-0698-70174"
^DIC(9.4,13,22,7,"PAH",27,1,25,0)="        CIH-0598-41816"
^DIC(9.4,13,22,7,"PAH",27,1,26,0)="        NYN-0598-11513"
^DIC(9.4,13,22,7,"PAH",27,1,27,0)="        MEM-0598-71203"
^DIC(9.4,13,22,7,"PAH",27,1,28,0)="        LOU-0598-40986"
^DIC(9.4,13,22,7,"PAH",27,1,29,0)="        SAM-0498-22344"
^DIC(9.4,13,22,7,"PAH",27,1,30,0)="        EKH-0498-41197"
^DIC(9.4,13,22,7,"PAH",27,1,31,0)="        SBY-0498-31176"
^DIC(9.4,13,22,7,"PAH",27,1,32,0)="        MAC-0498-61095"
^DIC(9.4,13,22,7,"PAH",27,1,33,0)="        PRE-0498-61070"
^DIC(9.4,13,22,7,"PAH",27,1,34,0)="        SFC-0498-60956"
^DIC(9.4,13,22,7,"PAH",27,1,35,0)="        MEM-0498-70661"
^DIC(9.4,13,22,7,"PAH",27,1,36,0)="        ELP-0398-72724"
^DIC(9.4,13,22,7,"PAH",27,1,37,0)="        GAI-0398-32657"
^DIC(9.4,13,22,7,"PAH",27,1,38,0)="        LAK-0398-32457"
^DIC(9.4,13,22,7,"PAH",27,1,39,0)="        SFC-0398-62414"
^DIC(9.4,13,22,7,"PAH",27,1,40,0)="        NYN-0398-10170"
^DIC(9.4,13,22,7,"PAH",27,1,41,0)="        MWV-0298-21129"
^DIC(9.4,13,22,7,"PAH",27,1,42,0)="        BRX-0298-10388"
^DIC(9.4,13,22,7,"PAH",27,1,43,0)="        WAS-0198-22126"
^DIC(9.4,13,22,7,"PAH",27,1,44,0)="        BYN-0198-11150"
^DIC(9.4,13,22,7,"PAH",27,1,45,0)="        PUG-0198-51131"
^DIC(9.4,13,22,7,"PAH",27,1,46,0)="        MCM-0198-51046"
^DIC(9.4,13,22,7,"PAH",27,1,47,0)="        HAC-0198-51043"
^DIC(9.4,13,22,7,"PAH",27,1,48,0)="        SFC-0198-60783"
^DIC(9.4,13,22,7,"PAH",27,1,49,0)="        GAI-0198-30228"
^DIC(9.4,13,22,7,"PAH",27,1,50,0)="        CLA-0198-20132"
^DIC(9.4,13,22,7,"PAH",27,1,51,0)="        MIN-1297-41083"
^DIC(9.4,13,22,7,"PAH",27,1,52,0)="        HVH-0997-11397"
^DIC(9.4,13,22,7,"PAH",27,1,53,0)="        TUC-0997-61281"
^DIC(9.4,13,22,7,"PAH",27,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,55,0)="        "
^DIC(9.4,13,22,7,"PAH",27,1,56,0)="DIK,DIK1"
^DIC(9.4,13,22,7,"PAH",27,1,57,0)="--------"
^DIC(9.4,13,22,7,"PAH",27,1,58,0)="When many fields in a file are being audited, and ^DIK is used to delete"
^DIC(9.4,13,22,7,"PAH",27,1,59,0)="entries in file, or the entry points to ^DIK are used to reindex entries,"
^DIC(9.4,13,22,7,"PAH",27,1,60,0)="the DIAU array could get very large and cause an allocation error when the"
^DIC(9.4,13,22,7,"PAH",27,1,61,0)="local symbol table fills up."
^DIC(9.4,13,22,7,"PAH",27,1,62,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,63,0)="  NOIS: ISB-0397-32129"
^DIC(9.4,13,22,7,"PAH",27,1,64,0)="        TAM-0896-30558"
^DIC(9.4,13,22,7,"PAH",27,1,65,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,66,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,67,0)="DIU0"
^DIC(9.4,13,22,7,"PAH",27,1,68,0)="----"
^DIC(9.4,13,22,7,"PAH",27,1,69,0)="If EN^DIU2 is used to delete a file that has a global root of"
^DIC(9.4,13,22,7,"PAH",27,1,70,0)="^DIC(FileNumber), and the DIU input variable contains the global root"
^DIC(9.4,13,22,7,"PAH",27,1,71,0)="without a trailing comma (e.g., ""^DIC(81.2"" ), EN^DIU2 proceeded to delete"
^DIC(9.4,13,22,7,"PAH",27,1,72,0)="File #1. This patch makes EN^DIU2 check that the global root passed in DIU"
^DIC(9.4,13,22,7,"PAH",27,1,73,0)="ends in either a comma or a close parenthesis."
^DIC(9.4,13,22,7,"PAH",27,1,74,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,75,0)="  NOIS: ISA-0497-11765"
^DIC(9.4,13,22,7,"PAH",27,1,76,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,77,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,78,0)="Test Sites:"
^DIC(9.4,13,22,7,"PAH",27,1,79,0)="=========="
^DIC(9.4,13,22,7,"PAH",27,1,80,0)="  Salem, VA"
^DIC(9.4,13,22,7,"PAH",27,1,81,0)="  Central Iowa"
^DIC(9.4,13,22,7,"PAH",27,1,82,0)="  Memphis, TN"
^DIC(9.4,13,22,7,"PAH",27,1,83,0)="  Tuscaloosa, AL"
^DIC(9.4,13,22,7,"PAH",27,1,84,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,85,0)="          "
^DIC(9.4,13,22,7,"PAH",27,1,86,0)="Routine Summary:"
^DIC(9.4,13,22,7,"PAH",27,1,87,0)="==============="
^DIC(9.4,13,22,7,"PAH",27,1,88,0)="The following routines are included in this patch.  The second"
^DIC(9.4,13,22,7,"PAH",27,1,89,0)="line of each of these routines now looks like:"
^DIC(9.4,13,22,7,"PAH",27,1,90,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,91,0)="   <tab>;;21.0;VA FileMan;**patch list**;Dec 28, 1994"
^DIC(9.4,13,22,7,"PAH",27,1,92,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,93,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,94,0)="Checksums"
^DIC(9.4,13,22,7,"PAH",27,1,95,0)="========="
^DIC(9.4,13,22,7,"PAH",27,1,96,0)="Checksums obtained using CHECK^XTSUMBLD."
^DIC(9.4,13,22,7,"PAH",27,1,97,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,98,0)="   Rtn Nm   Chksum Before   Chksum After  Patch List"
^DIC(9.4,13,22,7,"PAH",27,1,99,0)="   ------   -------------   ------------  ----------"
^DIC(9.4,13,22,7,"PAH",27,1,100,0)="   DIK      7352303         7563710       42,47"
^DIC(9.4,13,22,7,"PAH",27,1,101,0)="   DIK1     5943602         6293657       42,47"
^DIC(9.4,13,22,7,"PAH",27,1,102,0)="   DIU0     6188632         6215777       47"
^DIC(9.4,13,22,7,"PAH",27,1,103,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,104,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,105,0)="Installation Instructions:"
^DIC(9.4,13,22,7,"PAH",27,1,106,0)="========================="
^DIC(9.4,13,22,7,"PAH",27,1,107,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,108,0)="   1.  Users ARE NOT allowed to be on the system during the installation."
^DIC(9.4,13,22,7,"PAH",27,1,109,0)="     "
^DIC(9.4,13,22,7,"PAH",27,1,110,0)="   2.  Place TaskMan in a WAIT state. "
^DIC(9.4,13,22,7,"PAH",27,1,111,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,112,0)="   3.  These routines are not usually mapped on systems that allow it, so"
^DIC(9.4,13,22,7,"PAH",27,1,113,0)="   you will probably not have to disable mapping. If any of the routines"
^DIC(9.4,13,22,7,"PAH",27,1,114,0)="   in this patch are mapped, disable mapping before proceeding. "
^DIC(9.4,13,22,7,"PAH",27,1,115,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,116,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,7,"PAH",27,1,117,0)="   option will load the KIDS (Kernel Installation and Distribution System)"
^DIC(9.4,13,22,7,"PAH",27,1,118,0)="   package onto your system."
^DIC(9.4,13,22,7,"PAH",27,1,119,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,120,0)="   5.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",27,1,121,0)="   system. On the KIDS menu, select the 'Installation' menu and use the"
^DIC(9.4,13,22,7,"PAH",27,1,122,0)="   following options: "
^DIC(9.4,13,22,7,"PAH",27,1,123,0)="    "
^DIC(9.4,13,22,7,"PAH",27,1,124,0)="       Verify Checksums in Transport Global"
^DIC(9.4,13,22,7,"PAH",27,1,125,0)="       Print Transport Global"
^DIC(9.4,13,22,7,"PAH",27,1,126,0)="       Compare Transport Global to Current System"
^DIC(9.4,13,22,7,"PAH",27,1,127,0)="       Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",27,1,128,0)="       Install Package(s) "
^DIC(9.4,13,22,7,"PAH",27,1,129,0)="                       "
^DIC(9.4,13,22,7,"PAH",27,1,130,0)="         INSTALL NAME: DI*21.0*47"
^DIC(9.4,13,22,7,"PAH",27,1,131,0)="                       =========="
^DIC(9.4,13,22,7,"PAH",27,1,132,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,133,0)="   6.  MSM-DOS Sites - Answer YES to the question 'Want to MOVE routines"
^DIC(9.4,13,22,7,"PAH",27,1,134,0)="   to other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,13,22,7,"PAH",27,1,135,0)="     "
^DIC(9.4,13,22,7,"PAH",27,1,136,0)="       AXP Sites - Answer NO to this question."
^DIC(9.4,13,22,7,"PAH",27,1,137,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,138,0)="   7.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,13,22,7,"PAH",27,1,139,0)="   should be rebuilt once the installation has run to completion."
^DIC(9.4,13,22,7,"PAH",27,1,140,0)=" "
^DIC(9.4,13,22,7,"PAH",27,1,141,0)="   8.  Remove TaskMan from a WAIT state. "
^DIC(9.4,13,22,7,"PAH",28,0)="46 SEQ #43^2980725^1"
^DIC(9.4,13,22,7,"PAH",28,1,0)="^^51^51^2980725"
^DIC(9.4,13,22,7,"PAH",28,1,1,0)=" "
^DIC(9.4,13,22,7,"PAH",28,1,2,0)="  The pre-install routine DIPRE moves the two Y2K functions NUMDATE4 and"
^DIC(9.4,13,22,7,"PAH",28,1,3,0)="  NUMYEAR4 into the protected FileMan numberspace of the FUNCTION file."
^DIC(9.4,13,22,7,"PAH",28,1,4,0)=" "
^DIC(9.4,13,22,7,"PAH",28,1,5,0)="  Routine Summary: "
^DIC(9.4,13,22,7,"PAH",28,1,6,0)="  ================"
^DIC(9.4,13,22,7,"PAH",28,1,7,0)="  The following routine is included in this patch. Its second line "
^DIC(9.4,13,22,7,"PAH",28,1,8,0)="  will look like: "
^DIC(9.4,13,22,7,"PAH",28,1,9,0)="     <tab>;;21.0;VA FileMan;**46**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",28,1,10,0)="     "
^DIC(9.4,13,22,7,"PAH",28,1,11,0)="  CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",28,1,12,0)="     "
^DIC(9.4,13,22,7,"PAH",28,1,13,0)="     Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",28,1,14,0)="     ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",28,1,15,0)="     DIPRE                            969775           46"
^DIC(9.4,13,22,7,"PAH",28,1,16,0)="   "
^DIC(9.4,13,22,7,"PAH",28,1,17,0)="  Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",28,1,18,0)="  =========================="
^DIC(9.4,13,22,7,"PAH",28,1,19,0)="     "
^DIC(9.4,13,22,7,"PAH",28,1,20,0)="  1.  Mapping need not be disabled, users need not log off, and TaskMan"
^DIC(9.4,13,22,7,"PAH",28,1,21,0)="  need not be in a WAIT state."
^DIC(9.4,13,22,7,"PAH",28,1,22,0)="    "
^DIC(9.4,13,22,7,"PAH",28,1,23,0)="  ---  Pre-Installation Steps  ---"
^DIC(9.4,13,22,7,"PAH",28,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",28,1,25,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,7,"PAH",28,1,26,0)="  option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,7,"PAH",28,1,27,0)="     "
^DIC(9.4,13,22,7,"PAH",28,1,28,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,13,22,7,"PAH",28,1,29,0)="  system. You now need to use KIDS to install the Transport global."
^DIC(9.4,13,22,7,"PAH",28,1,30,0)="    "
^DIC(9.4,13,22,7,"PAH",28,1,31,0)="  4.  On the KIDS menu, under the 'Installation' menu, optionally use the"
^DIC(9.4,13,22,7,"PAH",28,1,32,0)="  following options: Print Transport Global Compare Transport Global to"
^DIC(9.4,13,22,7,"PAH",28,1,33,0)="  Current System Verify Checksums in Transport Global Backup a Transport"
^DIC(9.4,13,22,7,"PAH",28,1,34,0)="  Global "
^DIC(9.4,13,22,7,"PAH",28,1,35,0)="    "
^DIC(9.4,13,22,7,"PAH",28,1,36,0)="   ---  Actual Installation  ---"
^DIC(9.4,13,22,7,"PAH",28,1,37,0)=" "
^DIC(9.4,13,22,7,"PAH",28,1,38,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,7,"PAH",28,1,39,0)="  option: "
^DIC(9.4,13,22,7,"PAH",28,1,40,0)="   "
^DIC(9.4,13,22,7,"PAH",28,1,41,0)="              Install Package(s): "
^DIC(9.4,13,22,7,"PAH",28,1,42,0)="              INSTALL NAME: DI*21.0*46 "
^DIC(9.4,13,22,7,"PAH",28,1,43,0)="                            =========="
^DIC(9.4,13,22,7,"PAH",28,1,44,0)="   "
^DIC(9.4,13,22,7,"PAH",28,1,45,0)="              Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",28,1,46,0)="  Options, and Protocols?' "
^DIC(9.4,13,22,7,"PAH",28,1,47,0)=" "
^DIC(9.4,13,22,7,"PAH",28,1,48,0)="              **Please Note: At the DEVICE prompt, this install may be"
^DIC(9.4,13,22,7,"PAH",28,1,49,0)="  Queued to a print device."
^DIC(9.4,13,22,7,"PAH",28,1,50,0)="   "
^DIC(9.4,13,22,7,"PAH",28,1,51,0)="  This completes the installation instructions."
^DIC(9.4,13,22,7,"PAH",29,0)="51 SEQ #44^2981007^1"
^DIC(9.4,13,22,7,"PAH",29,1,0)="^^71^71^2981007"
^DIC(9.4,13,22,7,"PAH",29,1,1,0)="Description:"
^DIC(9.4,13,22,7,"PAH",29,1,2,0)="============"
^DIC(9.4,13,22,7,"PAH",29,1,3,0)="If a programmer sets ^UTILITY($J,""W"") but there are no descendants, DIWW"
^DIC(9.4,13,22,7,"PAH",29,1,4,0)="would go into a self-contained loop. The FileMan Programmer Manual states"
^DIC(9.4,13,22,7,"PAH",29,1,5,0)="on page 138, when talking about DIWP, that the programmer should Kill"
^DIC(9.4,13,22,7,"PAH",29,1,6,0)="^UTILITY($J,""W"") prior to calling DIWP and DIWW. However, it was"
^DIC(9.4,13,22,7,"PAH",29,1,7,0)="recognized that the Kill may not always take place and, therefore, there"
^DIC(9.4,13,22,7,"PAH",29,1,8,0)="was a possibility of an internal loop.  A check is now made that if"
^DIC(9.4,13,22,7,"PAH",29,1,9,0)="^UTILITY($J,""W"") exists and there are no descendants, DIWW Quits."
^DIC(9.4,13,22,7,"PAH",29,1,10,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,11,0)="NOIS:"
^DIC(9.4,13,22,7,"PAH",29,1,12,0)="====="
^DIC(9.4,13,22,7,"PAH",29,1,13,0)="DAY-0697-42372"
^DIC(9.4,13,22,7,"PAH",29,1,14,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,15,0)="Thanks to Test Sites:"
^DIC(9.4,13,22,7,"PAH",29,1,16,0)="====================="
^DIC(9.4,13,22,7,"PAH",29,1,17,0)="Dayton, OH"
^DIC(9.4,13,22,7,"PAH",29,1,18,0)="Clarksburg, WV"
^DIC(9.4,13,22,7,"PAH",29,1,19,0)="Muskogee, OK"
^DIC(9.4,13,22,7,"PAH",29,1,20,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,21,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",29,1,22,0)="================"
^DIC(9.4,13,22,7,"PAH",29,1,23,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,24,0)="The following routine is included in this patch.  The second line of the"
^DIC(9.4,13,22,7,"PAH",29,1,25,0)="routine now look like:"
^DIC(9.4,13,22,7,"PAH",29,1,26,0)="  "
^DIC(9.4,13,22,7,"PAH",29,1,27,0)="  <tab>;;21.0;VA FileMan;**[patch list]**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",29,1,28,0)="  "
^DIC(9.4,13,22,7,"PAH",29,1,29,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",29,1,30,0)="  "
^DIC(9.4,13,22,7,"PAH",29,1,31,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",29,1,32,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",29,1,33,0)="  DIWW           5618941         5644162         15,51"
^DIC(9.4,13,22,7,"PAH",29,1,34,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,35,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",29,1,36,0)="=========================="
^DIC(9.4,13,22,7,"PAH",29,1,37,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,38,0)="        This patch may be installed anytime during non-peak activity and"
^DIC(9.4,13,22,7,"PAH",29,1,39,0)="may be Queued to install during non-peak hours. The installation time will"
^DIC(9.4,13,22,7,"PAH",29,1,40,0)="only take a couple of minutes."
^DIC(9.4,13,22,7,"PAH",29,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,42,0)="     1.  Routine mapping is NOT recommended for this routine. If you are"
^DIC(9.4,13,22,7,"PAH",29,1,43,0)="using routine mapping, ensure that this routine is NOT in your mapped"
^DIC(9.4,13,22,7,"PAH",29,1,44,0)="routine set before proceeding."
^DIC(9.4,13,22,7,"PAH",29,1,45,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,46,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,13,22,7,"PAH",29,1,47,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",29,1,48,0)="   "
^DIC(9.4,13,22,7,"PAH",29,1,49,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",29,1,50,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,7,"PAH",29,1,51,0)="  "
^DIC(9.4,13,22,7,"PAH",29,1,52,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",29,1,53,0)="following options:"
^DIC(9.4,13,22,7,"PAH",29,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,55,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",29,1,56,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",29,1,57,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",29,1,58,0)="            Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",29,1,59,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,60,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",29,1,61,0)="following option:"
^DIC(9.4,13,22,7,"PAH",29,1,62,0)=" "
^DIC(9.4,13,22,7,"PAH",29,1,63,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",29,1,64,0)="            Select INSTALL NAME: DI*21.0*51"
^DIC(9.4,13,22,7,"PAH",29,1,65,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",29,1,66,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",29,1,67,0)="Options, and Protocols?"
^DIC(9.4,13,22,7,"PAH",29,1,68,0)="  "
^DIC(9.4,13,22,7,"PAH",29,1,69,0)="     6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,13,22,7,"PAH",29,1,70,0)="other CPUs?'. Then enter the names of your other Compute and Print"
^DIC(9.4,13,22,7,"PAH",29,1,71,0)="server(s)."
^DIC(9.4,13,22,7,"PAH",30,0)="48 SEQ #45^2981016^1"
^DIC(9.4,13,22,7,"PAH",30,1,0)="^^78^78^2981016"
^DIC(9.4,13,22,7,"PAH",30,1,1,0)="When a user is using FileMan's Search option and uses a Condition of"
^DIC(9.4,13,22,7,"PAH",30,1,2,0)="MATCHES and enters an invalid 'M' pattern match the report will error out."
^DIC(9.4,13,22,7,"PAH",30,1,3,0)="For example:"
^DIC(9.4,13,22,7,"PAH",30,1,4,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,5,0)="  -A- SEARCH FOR MYFILE FIELD: NUMBER CODE"
^DIC(9.4,13,22,7,"PAH",30,1,6,0)="  -A- CONDITION: MATCHES"
^DIC(9.4,13,22,7,"PAH",30,1,7,0)="  -A- MATCHES: 300.4"
^DIC(9.4,13,22,7,"PAH",30,1,8,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,9,0)="With the result that invalide 'M' pattern matching code was generated,"
^DIC(9.4,13,22,7,"PAH",30,1,10,0)="causing a <syntax> error.  The invalid code looks like the following"
^DIC(9.4,13,22,7,"PAH",30,1,11,0)="example:"
^DIC(9.4,13,22,7,"PAH",30,1,12,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,13,0)="I $S($D(^DIZ(640999,D0,1)):$P(^(1),U,1),1:"""")?300.4"
^DIC(9.4,13,22,7,"PAH",30,1,14,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,15,0)="This patch prevents the user from entering an invalid pattern matching"
^DIC(9.4,13,22,7,"PAH",30,1,16,0)="code."
^DIC(9.4,13,22,7,"PAH",30,1,17,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,18,0)="Related NOIS: "
^DIC(9.4,13,22,7,"PAH",30,1,19,0)="============="
^DIC(9.4,13,22,7,"PAH",30,1,20,0)="CHY-0498-50998"
^DIC(9.4,13,22,7,"PAH",30,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,22,0)="Thanks to Test Sites: "
^DIC(9.4,13,22,7,"PAH",30,1,23,0)="====================="
