^DIC(9.4,4,22,1,"PAH",72,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",72,1,25,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",72,1,26,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",72,1,27,0)="minimum.  It requires MailMan patch XM*7.1*98."
^DIC(9.4,4,22,1,"PAH",72,1,28,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",72,1,29,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",72,1,30,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",72,1,31,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",72,1,32,0)="3.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",72,1,33,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",72,1,34,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",72,1,35,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",72,1,36,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",72,1,37,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",72,1,38,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",72,1,39,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",72,1,40,0)=" Select INSTALL NAME:    XM*7.1*103    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",72,1,41,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",72,1,42,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",72,1,43,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",72,1,44,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",72,1,45,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",72,1,46,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",72,1,47,0)=" Enter the Device you want to print the Install messages."
