^DIC(9.4,148,22,8,"PAH",3,1,97,0)="SPNLR            4151564         4199229         **3**                        "
^DIC(9.4,148,22,8,"PAH",3,1,98,0)="SPNLRE           3909143         4086084         **3**                        "
^DIC(9.4,148,22,8,"PAH",3,1,99,0)="SPNPSR06         1393910         1400648         **3**                        "
^DIC(9.4,148,22,8,"PAH",3,1,100,0)="SPNPRTMT         1693776         1722973         **3**                        "
^DIC(9.4,148,22,8,"PAH",3,1,101,0)="SPNPRTUP          605589         1237772         **3**                        "
