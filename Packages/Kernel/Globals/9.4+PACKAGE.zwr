^DIC(9.4,47,22,5.9,"PAH",320,0)="461 SEQ #399^3020724^1"
^DIC(9.4,47,22,5.9,"PAH",320,1,0)="^^1^1^3020724"
^DIC(9.4,47,22,5.9,"PAH",320,1,1,0)="See national patch module on forum for description."
^DIC(9.4,47,22,5.9,"PAH",321,0)="462 SEQ #400^3020724^1"
^DIC(9.4,47,22,5.9,"PAH",321,1,0)="^^3^3^3020724"
^DIC(9.4,47,22,5.9,"PAH",321,1,1,0)="This patch addresses a problem with a Patient NAME changed to a number when"
^DIC(9.4,47,22,5.9,"PAH",321,1,2,0)="a future MEANS TEST is executed and then LOAD PATIENT DATA is used."
^DIC(9.4,47,22,5.9,"PAH",321,1,3,0)=""
^DIC(9.4,47,22,5.9,"PAH",322,0)="413 SEQ #401^3020724^1"
^DIC(9.4,47,22,5.9,"PAH",322,1,0)="^^3^3^3020724"
^DIC(9.4,47,22,5.9,"PAH",322,1,1,0)="This patch addresses PTF closeout for census problem that contributes to"
^DIC(9.4,47,22,5.9,"PAH",322,1,2,0)="duplicate census records."
^DIC(9.4,47,22,5.9,"PAH",322,1,3,0)=""
^DIC(9.4,47,22,5.9,"PAH",323,0)="431 SEQ #402^3020724^1"
^DIC(9.4,47,22,5.9,"PAH",323,1,0)="^^1^1^3020724"
^DIC(9.4,47,22,5.9,"PAH",323,1,1,0)="KIDS Build for DG*5.3*431"
^DIC(9.4,47,22,5.9,"PAH",324,0)="408 SEQ #403^3020815^1"
^DIC(9.4,47,22,5.9,"PAH",324,1,0)="^^1^1^3020815"
^DIC(9.4,47,22,5.9,"PAH",324,1,1,0)="Send MPI seed data to the HEC."
^DIC(9.4,47,22,5.9,"PAH",325,0)="387 SEQ #404^3020906^1"
^DIC(9.4,47,22,5.9,"PAH",325,1,0)="^^2^2^3020906"
^DIC(9.4,47,22,5.9,"PAH",325,1,1,0)="See patch DG*5.3*387 in the National Patch Module for description of this"
^DIC(9.4,47,22,5.9,"PAH",325,1,2,0)="build."
^DIC(9.4,47,22,5.9,"PAH",326,0)="446 SEQ #405^3020906^1"
^DIC(9.4,47,22,5.9,"PAH",326,1,0)="^^4^4^3020906"
^DIC(9.4,47,22,5.9,"PAH",326,1,1,0)="This patch adds the HOSPICE Nursing Home Care as a new specialty to"
^DIC(9.4,47,22,5.9,"PAH",326,1,2,0)="the SPECIALTY (#42.4) file. An entry in the FACILITY TREATING SPECIALTY (#45.7)"
^DIC(9.4,47,22,5.9,"PAH",326,1,3,0)="is optional."
^DIC(9.4,47,22,5.9,"PAH",326,1,4,0)=""
^DIC(9.4,47,22,5.9,"PAH",327,0)="468 SEQ #406^3020906^1"
^DIC(9.4,47,22,5.9,"PAH",327,1,0)="^^4^4^3020906"
^DIC(9.4,47,22,5.9,"PAH",327,1,1,0)="This patch will address the problem when there are too many patient"
^DIC(9.4,47,22,5.9,"PAH",327,1,2,0)="movements on one admission and the 'string too long' error is created."
^DIC(9.4,47,22,5.9,"PAH",327,1,3,0)="A local array instead of a single variable will be used in DGUTL2 routine."
^DIC(9.4,47,22,5.9,"PAH",327,1,4,0)=""
^DIC(9.4,47,22,5.9,"PAH",328,0)="471 SEQ #407^3020927^1"
^DIC(9.4,47,22,5.9,"PAH",329,0)="469 SEQ #408^3020927^1"
^DIC(9.4,47,22,5.9,"PAH",329,1,0)="^^1^1^3020927"
^DIC(9.4,47,22,5.9,"PAH",329,1,1,0)="Stop redundant HL7 messaging."
^DIC(9.4,47,22,5.9,"PAH",330,0)="455 SEQ #409^3020927^1"
^DIC(9.4,47,22,5.9,"PAH",330,1,0)="^^3^3^3020927"
^DIC(9.4,47,22,5.9,"PAH",330,1,1,0)="This patch is being distributed to update the APSOD xref on the "
^DIC(9.4,47,22,5.9,"PAH",330,1,2,0)="Date of death field.  The kill logic is being updated to notify"
^DIC(9.4,47,22,5.9,"PAH",330,1,3,0)="outpatient pharmacy when a date of death is deleted."
^DIC(9.4,47,22,5.9,"PAH",331,0)="464 SEQ #410^3021008^1"
^DIC(9.4,47,22,5.9,"PAH",332,0)="428 SEQ #411^3021008^1"
^DIC(9.4,47,22,5.9,"PAH",332,1,0)="^^3^3^3021008"
^DIC(9.4,47,22,5.9,"PAH",332,1,1,0)="NEW MESSSAGE STRUCTURE - PHASE 1"
^DIC(9.4,47,22,5.9,"PAH",332,1,2,0)="Refer to patch DG*5.3*428 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",332,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",333,0)="389^3021025^1"
^DIC(9.4,47,22,5.9,"PAH",334,0)="470 SEQ #413^3021025^1"
^DIC(9.4,47,22,5.9,"PAH",335,0)="480 SEQ #414^3021025^1"
^DIC(9.4,47,22,5.9,"PAH",336,0)="467 SEQ #415^3021025^1"
^DIC(9.4,47,22,5.9,"PAH",337,0)="418 SEQ #416^3021108^1"
^DIC(9.4,47,22,5.9,"PAH",338,0)="482 SEQ #417^3021108^1"
^DIC(9.4,47,22,5.9,"PAH",339,0)="273 SEQ #418^3021116^1"
^DIC(9.4,47,22,5.9,"PAH",340,0)="472 SEQ #419^3021116^1"
^DIC(9.4,47,22,5.9,"PAH",340,1,0)="^^4^4^3021116"
^DIC(9.4,47,22,5.9,"PAH",340,1,1,0)="Within several HL7 messaging programs there is a call to invoke the "
^DIC(9.4,47,22,5.9,"PAH",340,1,2,0)="process to send an acknowledgment back to the HEC that is using the "
^DIC(9.4,47,22,5.9,"PAH",340,1,3,0)="wrong variable.  Also several programs do not clean up the temporary "
^DIC(9.4,47,22,5.9,"PAH",340,1,4,0)="global - ^TMP prior to and/or after creation of a query."
^DIC(9.4,47,22,5.9,"PAH",341,0)="475 SEQ #420^3021122^1"
^DIC(9.4,47,22,5.9,"PAH",342,0)="474 SEQ #421^3021209^1"
^DIC(9.4,47,22,5.9,"PAH",342,1,0)="^^3^3^3021209"
^DIC(9.4,47,22,5.9,"PAH",342,1,1,0)="NEW MESSAGE STRUCTURE - PHASE 2"
^DIC(9.4,47,22,5.9,"PAH",342,1,2,0)="Refer to patch DG*5.3*474 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",342,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",343,0)="473 SEQ #422^3021209^1"
^DIC(9.4,47,22,5.9,"PAH",344,0)="454^3021209^1"
^DIC(9.4,47,22,5.9,"PAH",345,0)="466^3021209^1"
^DIC(9.4,47,22,5.9,"PAH",345,1,0)="^^26^26^3021209"
^DIC(9.4,47,22,5.9,"PAH",345,1,1,0)="This patch addresses Geographic Means Test as a new Means Test Indicator"
^DIC(9.4,47,22,5.9,"PAH",345,1,2,0)="value used in PTF.  This new value will be added to the Means Test"
^DIC(9.4,47,22,5.9,"PAH",345,1,3,0)="Indicator (#10) field of the PTF (#45) file. The new value will be titled"
^DIC(9.4,47,22,5.9,"PAH",345,1,4,0)="GMT COPAY REQUIRED and have the code value of 'G'.  In addition, two means"
^DIC(9.4,47,22,5.9,"PAH",345,1,5,0)="test indicators will have their descriptions changed to reflect Enrollment"
^DIC(9.4,47,22,5.9,"PAH",345,1,6,0)="changes to CAT A and CAT C Copay status. The following Data Dictionary"
^DIC(9.4,47,22,5.9,"PAH",345,1,7,0)="changes will be made to the Means Test Indicator (#10) field of the PTF"
^DIC(9.4,47,22,5.9,"PAH",345,1,8,0)="(#45) file:"
^DIC(9.4,47,22,5.9,"PAH",345,1,9,0)=" "
^DIC(9.4,47,22,5.9,"PAH",345,1,10,0)="        Change: 'AN' WILL STAND FOR 'CAT A NSC'."
^DIC(9.4,47,22,5.9,"PAH",345,1,11,0)="            To: 'AN' WILL STAND FOR 'NSC MT COPAY EXEMPT'."
^DIC(9.4,47,22,5.9,"PAH",345,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",345,1,13,0)="        Change: 'C' WILL STAND FOR 'CAT C'."
^DIC(9.4,47,22,5.9,"PAH",345,1,14,0)="            To: 'C' WILL STAND FOR 'MT COPAY REQUIRED'."
^DIC(9.4,47,22,5.9,"PAH",345,1,15,0)=" "
^DIC(9.4,47,22,5.9,"PAH",345,1,16,0)="           Add: 'G' WILL STAND FOR 'GMT COPAY REQUIRED'."
^DIC(9.4,47,22,5.9,"PAH",345,1,17,0)=" "
^DIC(9.4,47,22,5.9,"PAH",345,1,18,0)="The algorithm logic in PTF for determining the means test indicator in "
^DIC(9.4,47,22,5.9,"PAH",345,1,19,0)="routines DGPTUTL and DGPTFVC1 have been modified to include patients with "
^DIC(9.4,47,22,5.9,"PAH",345,1,20,0)="GMT status.  A new API ($$PA^DGMTUTL) is used to determine whether a"
^DIC(9.4,47,22,5.9,"PAH",345,1,21,0)="status of 'pending adjudication' will be 'mt copay required' or 'gmt copay"
^DIC(9.4,47,22,5.9,"PAH",345,1,22,0)="required'."
^DIC(9.4,47,22,5.9,"PAH",345,1,23,0)=" "
^DIC(9.4,47,22,5.9,"PAH",345,1,24,0)="Austin edit checks have been modified in routine VAFHLZIR to include the"
^DIC(9.4,47,22,5.9,"PAH",345,1,25,0)="new value of 'G' when validating means test indicators for transmissions"
^DIC(9.4,47,22,5.9,"PAH",345,1,26,0)="to Austin."
^DIC(9.4,47,22,5.9,"PAH",346,0)="456^3021220^1"
^DIC(9.4,47,22,5.9,"PAH",347,0)="490 SEQ #426^3021220^1"
^DIC(9.4,47,22,5.9,"PAH",347,1,0)="^^1^1^3021220"
^DIC(9.4,47,22,5.9,"PAH",347,1,1,0)="GMT THRESHOLDS UNDEFINED"
^DIC(9.4,47,22,5.9,"PAH",348,0)="486 SEQ #427^3021220^1"
^DIC(9.4,47,22,5.9,"PAH",349,0)="415^3030109^1"
^DIC(9.4,47,22,5.9,"PAH",350,0)="481^3030204^1"
^DIC(9.4,47,22,5.9,"PAH",351,0)="493 SEQ #430^3030204^1"
^DIC(9.4,47,22,5.9,"PAH",352,0)="496 SEQ #431^3030301^1"
^DIC(9.4,47,22,5.9,"PAH",352,1,0)="^^2^2^3030301"
^DIC(9.4,47,22,5.9,"PAH",352,1,1,0)="Modify the ADDRESS CHANGE DT/TM (field #.118) of the Patient (#2) file"
^DIC(9.4,47,22,5.9,"PAH",352,1,2,0)="from a Time required field to a Time not required field."
^DIC(9.4,47,22,5.9,"PAH",353,0)="488 SEQ #432^3030301^1"
^DIC(9.4,47,22,5.9,"PAH",353,1,0)="^^3^3^3030301"
^DIC(9.4,47,22,5.9,"PAH",353,1,1,0)="CLEANUP RECORDS FROM THE 408.12, 408.21, & 408.22 FILES THAT WERE "
^DIC(9.4,47,22,5.9,"PAH",353,1,2,0)="PARTIALLY STUBBED IN BECAUSE OF AN HL7 VER. 1.6 PROBLEM.  "
^DIC(9.4,47,22,5.9,"PAH",353,1,3,0)="NOIS:NIN-0802-40682"
^DIC(9.4,47,22,5.9,"PAH",354,0)="491 SEQ #433^3030329^1"
^DIC(9.4,47,22,5.9,"PAH",354,1,0)="^^1^1^3030329"
^DIC(9.4,47,22,5.9,"PAH",354,1,1,0)="ENROLLMENT SUB-PRIORITIES"
^DIC(9.4,47,22,5.9,"PAH",355,0)="503 SEQ #434^3030329^1"
^DIC(9.4,47,22,5.9,"PAH",356,0)="494 SEQ #435^3030329^1"
^DIC(9.4,47,22,5.9,"PAH",356,1,0)="^^1^1^3030329"
^DIC(9.4,47,22,5.9,"PAH",356,1,1,0)="HL7 segment builder changes."
^DIC(9.4,47,22,5.9,"PAH",357,0)="489 SEQ #436^3030329^1"
^DIC(9.4,47,22,5.9,"PAH",357,1,0)="^^5^5^3030329"
^DIC(9.4,47,22,5.9,"PAH",357,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",357,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",357,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",357,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",357,1,5,0)="HIPAA CONFIDENTIAL ADDRESS."
^DIC(9.4,47,22,5.9,"PAH",358,0)="498 SEQ #437^3030403^1"
^DIC(9.4,47,22,5.9,"PAH",359,0)="500 SEQ #438^3030417^1"
^DIC(9.4,47,22,5.9,"PAH",360,0)="499 SEQ #439^3030417^1"
^DIC(9.4,47,22,5.9,"PAH",360,1,0)="^^1^1^3030417"
^DIC(9.4,47,22,5.9,"PAH",360,1,1,0)="Fix undefined error from DGBT BENE TRAVEL SCREEN (Claim Enter/Edit)."
^DIC(9.4,47,22,5.9,"PAH",361,0)="476 SEQ #440^3030417^1"
^DIC(9.4,47,22,5.9,"PAH",361,1,0)="^^14^14^3030417"
^DIC(9.4,47,22,5.9,"PAH",361,1,1,0)="Address's the following NOIS:"
^DIC(9.4,47,22,5.9,"PAH",361,1,2,0)="CLL-0802-41804"
^DIC(9.4,47,22,5.9,"PAH",361,1,3,0)="SLC-0502-52697"
^DIC(9.4,47,22,5.9,"PAH",361,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",361,1,5,0)="This patch fixes the manner in which the current means test is displayed "
^DIC(9.4,47,22,5.9,"PAH",361,1,6,0)="during a patient inquiry by calling the current means test API instead of "
^DIC(9.4,47,22,5.9,"PAH",361,1,7,0)="using the CURRENT MEANS TEST STATUS field from the PATIENT File (#2).  "
^DIC(9.4,47,22,5.9,"PAH",361,1,8,0)="This field is not always in-synch with the patient's current MT from the "
^DIC(9.4,47,22,5.9,"PAH",361,1,9,0)="ANNUAL MEANS TEST File (#408.31). All processing is done on the MT from"
^DIC(9.4,47,22,5.9,"PAH",361,1,10,0)="the ANNUAL MEANS TEST File (#408.31), but the MT from the PATIENT file is"
^DIC(9.4,47,22,5.9,"PAH",361,1,11,0)="displayed.  This patch fixes that inconsistency."
^DIC(9.4,47,22,5.9,"PAH",361,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",361,1,13,0)="This patch will also install a cross-check which will update the CURRENT "
^DIC(9.4,47,22,5.9,"PAH",361,1,14,0)="MEANS TEST STATUS field, if necessary, during patient lookups."
^DIC(9.4,47,22,5.9,"PAH",362,0)="509 SEQ #441^3030501^1"
^DIC(9.4,47,22,5.9,"PAH",363,0)="506^3030520^1"
^DIC(9.4,47,22,5.9,"PAH",364,0)="484 SEQ #443^3030520^1"
^DIC(9.4,47,22,5.9,"PAH",364,1,0)="^^36^36^3030520"
^DIC(9.4,47,22,5.9,"PAH",364,1,1,0)="This patch contains changes to various patient data HL7 segment "
^DIC(9.4,47,22,5.9,"PAH",364,1,2,0)="builders required in the Registration and PTF software for the collection "
^DIC(9.4,47,22,5.9,"PAH",364,1,3,0)="of Primary (admitting) provider.  These changes will be sent to the "
^DIC(9.4,47,22,5.9,"PAH",364,1,4,0)="Austin Automation Center for storage in the National Patient Care "
^DIC(9.4,47,22,5.9,"PAH",364,1,5,0)="Database."
^DIC(9.4,47,22,5.9,"PAH",364,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,8,0)="Changes to the  HL7 segment builders:"
^DIC(9.4,47,22,5.9,"PAH",364,1,9,0)="-------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",364,1,10,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,11,0)="HL7 routines are modified as follows:"
^DIC(9.4,47,22,5.9,"PAH",364,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,13,0)="VAFCA04 - ROL segment is added (inpatient only)."
^DIC(9.4,47,22,5.9,"PAH",364,1,14,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,15,0)="VAFCADT2 - ROL segment is added to transmissions: "
^DIC(9.4,47,22,5.9,"PAH",364,1,16,0)="        A01 - Admission         A11 - Cancel Admission"
^DIC(9.4,47,22,5.9,"PAH",364,1,17,0)="        A02 - Transfer          A12 - Cancel Transfer"
^DIC(9.4,47,22,5.9,"PAH",364,1,18,0)="        A03 - Discharge         A13 - Cancel Discharge"
^DIC(9.4,47,22,5.9,"PAH",364,1,19,0)="        A08 - Treating Specialty Update"
^DIC(9.4,47,22,5.9,"PAH",364,1,20,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,21,0)="VAFCMSG3 - ROL segment is added (inpatient only)."
^DIC(9.4,47,22,5.9,"PAH",364,1,22,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,23,0)="The ROL segment will be transmitted for the required attending physician "
^DIC(9.4,47,22,5.9,"PAH",364,1,24,0)="and may include the ROL segment for the primary (admitting) physician "
^DIC(9.4,47,22,5.9,"PAH",364,1,25,0)="(not required).  The transmission component in the ROL segment will send"
^DIC(9.4,47,22,5.9,"PAH",364,1,26,0)="the letter 'A' signifying Admitting provider and the letter 'T' signifying"
^DIC(9.4,47,22,5.9,"PAH",364,1,27,0)="the Attending provider."
^DIC(9.4,47,22,5.9,"PAH",364,1,28,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,29,0)="ADDITIONAL INFO ON POST-INIT ROUTINE DG53484P:"
^DIC(9.4,47,22,5.9,"PAH",364,1,30,0)="---------------------------------------------- "
^DIC(9.4,47,22,5.9,"PAH",364,1,31,0)="DG*5.3*484 distributes a post-init routine that changes the name of the"
^DIC(9.4,47,22,5.9,"PAH",364,1,32,0)="""NPTF"" application in the HL7 APPLICATION PARAMETER file (#771) to ""NPTF-"
^DIC(9.4,47,22,5.9,"PAH",364,1,33,0)="484"".  This change allows the proper collection of the ADT ROL segments "
^DIC(9.4,47,22,5.9,"PAH",364,1,34,0)="at the National Patient Care Database."
^DIC(9.4,47,22,5.9,"PAH",364,1,35,0)=" "
^DIC(9.4,47,22,5.9,"PAH",364,1,36,0)="Routine DG53484P can be deleted after successfully completing the patch."
^DIC(9.4,47,22,5.9,"PAH",365,0)="463 SEQ #444^3030520^1"
^DIC(9.4,47,22,5.9,"PAH",365,1,0)="^^1^1^3030520"
^DIC(9.4,47,22,5.9,"PAH",365,1,1,0)="FIX MT UPLOAD PROBLEM"
^DIC(9.4,47,22,5.9,"PAH",366,0)="244 SEQ #445^3030603^1"
^DIC(9.4,47,22,5.9,"PAH",366,1,0)="^^1^1^3030603"
^DIC(9.4,47,22,5.9,"PAH",366,1,1,0)="Patient name standardization patch. "
^DIC(9.4,47,22,5.9,"PAH",367,0)="513 SEQ #446^3030603^1"
^DIC(9.4,47,22,5.9,"PAH",367,1,0)="^^1^1^3030603"
^DIC(9.4,47,22,5.9,"PAH",367,1,1,0)="Fix Patient Look-Up Problem"
^DIC(9.4,47,22,5.9,"PAH",368,0)="512^3030603^1"
^DIC(9.4,47,22,5.9,"PAH",369,0)="516 SEQ #448^3030603^1"
^DIC(9.4,47,22,5.9,"PAH",369,1,0)="^^1^1^3030603"
^DIC(9.4,47,22,5.9,"PAH",369,1,1,0)="nois ISA-0403-11105"
^DIC(9.4,47,22,5.9,"PAH",370,0)="515 SEQ #449^3030628^1"
^DIC(9.4,47,22,5.9,"PAH",370,1,0)="^^21^21^3030628"
^DIC(9.4,47,22,5.9,"PAH",370,1,1,0)="Geographic Means Tests was introduced changing the naming conventions of"
^DIC(9.4,47,22,5.9,"PAH",370,1,2,0)="Category A and Category C Means Tests. This patch will update the Gains"
^DIC(9.4,47,22,5.9,"PAH",370,1,3,0)="and Losses (G&L) Sheet with modifications needed to conform to these"
^DIC(9.4,47,22,5.9,"PAH",370,1,4,0)="changes in the display of Means Test status."
^DIC(9.4,47,22,5.9,"PAH",370,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",370,1,6,0)="Changes will include the following:"
^DIC(9.4,47,22,5.9,"PAH",370,1,7,0)="-----------------------------------"
^DIC(9.4,47,22,5.9,"PAH",370,1,8,0)=" "
^DIC(9.4,47,22,5.9,"PAH",370,1,9,0)="1.  The legend diplayed when listing Means Test statuses for patients will"
^DIC(9.4,47,22,5.9,"PAH",370,1,10,0)="    replace Category 'A' Veteran with MT Copay Exempt; replace Category"
^DIC(9.4,47,22,5.9,"PAH",370,1,11,0)="    'C' Veteran with MT Copay Required; add GMT Copay Required."
^DIC(9.4,47,22,5.9,"PAH",370,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",370,1,13,0)="2.  Patients with a Pending Adjudication Means Test status will display"
^DIC(9.4,47,22,5.9,"PAH",370,1,14,0)="    whether the pending adjudication is for MT Copay Required or GMT Copay"
^DIC(9.4,47,22,5.9,"PAH",370,1,15,0)="    Required, with the latter determination being displayed."
^DIC(9.4,47,22,5.9,"PAH",370,1,16,0)=" "
^DIC(9.4,47,22,5.9,"PAH",370,1,17,0)="3.  Title of 'Means Test Indicator's' under the parameters display will be"
^DIC(9.4,47,22,5.9,"PAH",370,1,18,0)="    replaced with 'Means Test Copay Applicability'."
^DIC(9.4,47,22,5.9,"PAH",370,1,19,0)=" "
^DIC(9.4,47,22,5.9,"PAH",370,1,20,0)="4.  Title of 'Means Test Display' under the parameters will be replaced "
^DIC(9.4,47,22,5.9,"PAH",370,1,21,0)="    with 'Means Test Copay Applicability Display'."
^DIC(9.4,47,22,5.9,"PAH",371,0)="527 SEQ #450^3030628^1"
^DIC(9.4,47,22,5.9,"PAH",371,1,0)="^^1^1^3030628"
^DIC(9.4,47,22,5.9,"PAH",371,1,1,0)="HIPAA Confidential Address changes."
^DIC(9.4,47,22,5.9,"PAH",372,0)="497^3030628^1"
^DIC(9.4,47,22,5.9,"PAH",372,1,0)="^^1^1^3030628"
^DIC(9.4,47,22,5.9,"PAH",372,1,1,0)="GEOGRAPHIC MEANS TESTING - PHASE II"
^DIC(9.4,47,22,5.9,"PAH",373,0)="504 SEQ #452^3030628^1"
^DIC(9.4,47,22,5.9,"PAH",373,1,0)="^^1^1^3030628"
^DIC(9.4,47,22,5.9,"PAH",373,1,1,0)="MODIFY HOW PATIENT SENSITIVITY IS CHANGED"
^DIC(9.4,47,22,5.9,"PAH",374,0)="501 SEQ #453^3030715^1"
^DIC(9.4,47,22,5.9,"PAH",375,0)="505 SEQ #454^3030715^1"
^DIC(9.4,47,22,5.9,"PAH",375,1,0)="^^3^3^3030715"
^DIC(9.4,47,22,5.9,"PAH",375,1,1,0)="MPI CHANGES - ITERATION 1"
^DIC(9.4,47,22,5.9,"PAH",375,1,2,0)="Refer to patch DG*5.3*505 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",375,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",376,0)="526 SEQ #455^3030715^1"
^DIC(9.4,47,22,5.9,"PAH",376,1,0)="^^1^1^3030715"
^DIC(9.4,47,22,5.9,"PAH",376,1,1,0)="Emergency patch to facilitate the patient file conversion."
^DIC(9.4,47,22,5.9,"PAH",377,0)="495 SEQ #456^3030802^1"
^DIC(9.4,47,22,5.9,"PAH",377,1,0)="^^3^3^3030802"
^DIC(9.4,47,22,5.9,"PAH",377,1,1,0)="PATCH:    DG*5.3*495"
^DIC(9.4,47,22,5.9,"PAH",377,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",377,1,3,0)="SUBJECT:  FIX MT NO LONGER REQUIRED ISSUE"
^DIC(9.4,47,22,5.9,"PAH",378,0)="487 SEQ #457^3030802^1"
^DIC(9.4,47,22,5.9,"PAH",378,1,0)="^^1^1^3030802"
^DIC(9.4,47,22,5.9,"PAH",378,1,1,0)="See patch description for DG*5.3*487."
^DIC(9.4,47,22,5.9,"PAH",379,0)="519 SEQ #458^3030802^1"
^DIC(9.4,47,22,5.9,"PAH",380,0)="518^3030802^1"
^DIC(9.4,47,22,5.9,"PAH",380,1,0)="^^1^1^3030802"
^DIC(9.4,47,22,5.9,"PAH",380,1,1,0)="LTC Copayment Phase III"
^DIC(9.4,47,22,5.9,"PAH",381,0)="514 SEQ #460^3030802^1"
^DIC(9.4,47,22,5.9,"PAH",382,0)="507 SEQ #461^3030815^1"
^DIC(9.4,47,22,5.9,"PAH",382,1,0)="^^12^12^3030815"
^DIC(9.4,47,22,5.9,"PAH",382,1,1,0)="The 55 INCOME DATA MISSING inconsistency results if none of the income "
^DIC(9.4,47,22,5.9,"PAH",382,1,2,0)="questions on screen 9 of the Load/Edit Patient Data screen are answered "
^DIC(9.4,47,22,5.9,"PAH",382,1,3,0)="and the patient has not agreed to pay the deductible.  Sites are "
^DIC(9.4,47,22,5.9,"PAH",382,1,4,0)="indicating that they are getting the 55 INCOME DATA MISSING error for "
^DIC(9.4,47,22,5.9,"PAH",382,1,5,0)="veterans who do not require income information.  Unless they enter a ""0"" "
^DIC(9.4,47,22,5.9,"PAH",382,1,6,0)="into the income fields, they cannot clear the error.  By entering a ""0"" "
^DIC(9.4,47,22,5.9,"PAH",382,1,7,0)="in these cases, they feel the veteran's income data is misrepresentative "
^DIC(9.4,47,22,5.9,"PAH",382,1,8,0)="and that they should not have to enter a ""0"" to clear this error."
^DIC(9.4,47,22,5.9,"PAH",382,1,9,0)=" "
^DIC(9.4,47,22,5.9,"PAH",382,1,10,0)="This patch updates the business rules for the 55 INCOME DATA MISSING "
^DIC(9.4,47,22,5.9,"PAH",382,1,11,0)="error to bring the consistency checker in line with the checks being "
^DIC(9.4,47,22,5.9,"PAH",382,1,12,0)="performed by the means test requirements."
^DIC(9.4,47,22,5.9,"PAH",383,0)="547 SEQ #462^3030815^1"
^DIC(9.4,47,22,5.9,"PAH",383,1,0)="^^1^1^3030815"
^DIC(9.4,47,22,5.9,"PAH",383,1,1,0)="Killed DG20NAME after call to NCEDIT at linetag 101."
^DIC(9.4,47,22,5.9,"PAH",384,0)="477 SEQ #463^3030821^1"
^DIC(9.4,47,22,5.9,"PAH",384,1,0)="^^3^3^3030821"
^DIC(9.4,47,22,5.9,"PAH",384,1,1,0)="PATIENT DATA REVIEW FIXES & ENHANCEMENTS"
^DIC(9.4,47,22,5.9,"PAH",384,1,2,0)="Refer to patch DG*5.3*477 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",384,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",385,0)="535 SEQ #464^3030912^1"
^DIC(9.4,47,22,5.9,"PAH",386,0)="542 SEQ #465^3030912^1"
^DIC(9.4,47,22,5.9,"PAH",387,0)="483 SEQ #466^3030912^1"
^DIC(9.4,47,22,5.9,"PAH",387,1,0)="^^1^1^3030912"
^DIC(9.4,47,22,5.9,"PAH",387,1,1,0)="UR 72 HOUR BULLETIN"
^DIC(9.4,47,22,5.9,"PAH",388,0)="540 SEQ #467^3030912^1"
^DIC(9.4,47,22,5.9,"PAH",388,1,0)="^^1^1^3030912"
^DIC(9.4,47,22,5.9,"PAH",388,1,1,0)="FIX VISTA VIEW PAST MEANS TEST SCREEN 2-4"
^DIC(9.4,47,22,5.9,"PAH",389,0)="537 SEQ #468^3030912^1"
^DIC(9.4,47,22,5.9,"PAH",389,1,0)="^^15^15^3030912"
^DIC(9.4,47,22,5.9,"PAH",389,1,1,0)="The report included in this patch is the follow up to Patch DG*5.3*512,"
^DIC(9.4,47,22,5.9,"PAH",389,1,2,0)="which was a KIDS build released on May 29, 2003.  "
^DIC(9.4,47,22,5.9,"PAH",389,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",389,1,4,0)="Due to the changes brought in by patch DG*5.3*512, reports are needed to"
^DIC(9.4,47,22,5.9,"PAH",389,1,5,0)="identify patients who require a Means Test and who have had inpatient"
^DIC(9.4,47,22,5.9,"PAH",389,1,6,0)="episodes of care transmitted with a MT indicator of U.  A new report "
^DIC(9.4,47,22,5.9,"PAH",389,1,7,0)="option called PTF Records Transmitted with MT Indicator of U [DG PTF TRANS"
^DIC(9.4,47,22,5.9,"PAH",389,1,8,0)="MT EQUAL U RPT] will be added to the PTF Output Menu [DG PTF OUTPUT MENU]."
^DIC(9.4,47,22,5.9,"PAH",389,1,9,0)="This report conforms to requirements related to the VERA allocation"
^DIC(9.4,47,22,5.9,"PAH",389,1,10,0)="process, where at least one PTF record within the Fiscal Year must include"
^DIC(9.4,47,22,5.9,"PAH",389,1,11,0)="a valid Means Test status for the patient.  The patient will be included"
^DIC(9.4,47,22,5.9,"PAH",389,1,12,0)="on the report only if ALL the patient's PTF records within the date range"
^DIC(9.4,47,22,5.9,"PAH",389,1,13,0)="selected have a current MT Status Indicator of 'U'. This will focus the"
^DIC(9.4,47,22,5.9,"PAH",389,1,14,0)="list on patients who have no valid MT status in the National Patient Care"
^DIC(9.4,47,22,5.9,"PAH",389,1,15,0)="Database (NPCD) for the date range chosen."
