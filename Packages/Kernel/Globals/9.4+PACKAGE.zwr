^DIC(9.4,5,22,13,"PAH",47,1,2,0)="XT*7.3*66  Missing Patch number fix."
^DIC(9.4,5,22,13,"PAH",48,0)="67 SEQ #56^3030301^1"
^DIC(9.4,5,22,13,"PAH",48,1,0)="^^2^2^3030301"
^DIC(9.4,5,22,13,"PAH",48,1,1,0)="Please refer to the Description in FORUM Patch Module for details."
^DIC(9.4,5,22,13,"PAH",48,1,2,0)="Patch XT*7.3*67."
^DIC(9.4,5,22,13,"PAH",49,0)="72 SEQ #57^3030520^1"
^DIC(9.4,5,22,13,"PAH",49,1,0)="^^2^2^3030520"
^DIC(9.4,5,22,13,"PAH",49,1,1,0)="PATCH XT*7.3*72 Fix Parameter Option Without Column Headings."
^DIC(9.4,5,22,13,"PAH",49,1,2,0)="Please refer to the description in Forum Module for details."
^DIC(9.4,5,22,13,"PAH",50,0)="74 SEQ #58^3030520^1"
^DIC(9.4,5,22,13,"PAH",50,1,0)="^^59^59^3030520"
^DIC(9.4,5,22,13,"PAH",50,1,1,0)="XT*7.3*74"
^DIC(9.4,5,22,13,"PAH",50,1,2,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,3,0)="NOIS: PUG-0600-50377, PUG-0101-50486"
^DIC(9.4,5,22,13,"PAH",50,1,4,0)="Test Sites: Puget Sound"
^DIC(9.4,5,22,13,"PAH",50,1,5,0)="Blood Bank Team Clearance: 4/9/03"
^DIC(9.4,5,22,13,"PAH",50,1,6,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,7,0)="The help listing in Parameter Tools displays two columns of data, each the"
^DIC(9.4,5,22,13,"PAH",50,1,8,0)="same width.  The data being displayed, though, can vary in width require-"
^DIC(9.4,5,22,13,"PAH",50,1,9,0)="ments.  This patch will check the data it needs to display, and adjust the"
^DIC(9.4,5,22,13,"PAH",50,1,10,0)="column widths accordingly."
^DIC(9.4,5,22,13,"PAH",50,1,11,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,12,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,5,22,13,"PAH",50,1,13,0)="is at a minimum.  It requires Kernel Toolkit patch XT*7.3*52."
^DIC(9.4,5,22,13,"PAH",50,1,14,0)="============================================================================ "
^DIC(9.4,5,22,13,"PAH",50,1,15,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,16,0)="ROUTINES:"
^DIC(9.4,5,22,13,"PAH",50,1,17,0)="The second line of the routine now looks like:"
^DIC(9.4,5,22,13,"PAH",50,1,18,0)="       ;;7.3;TOOLKIT;**[patch list]**;Apr 25, 1995"
^DIC(9.4,5,22,13,"PAH",50,1,19,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,20,0)="              Before          After"
^DIC(9.4,5,22,13,"PAH",50,1,21,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,5,22,13,"PAH",50,1,22,0)="------------------------------------------------------------------"
^DIC(9.4,5,22,13,"PAH",50,1,23,0)="XPAREDT2       6094939         6370056        26,35,52,74"
^DIC(9.4,5,22,13,"PAH",50,1,24,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,5,22,13,"PAH",50,1,25,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,26,0)="This patch introduces no new routines."
^DIC(9.4,5,22,13,"PAH",50,1,27,0)="==========================================================================="
^DIC(9.4,5,22,13,"PAH",50,1,28,0)=" "
^DIC(9.4,5,22,13,"PAH",50,1,29,0)="INSTALLATION:"
^DIC(9.4,5,22,13,"PAH",50,1,30,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,5,22,13,"PAH",50,1,31,0)="is at a minimum.  It requires Kernel Toolkit patch XT*7.3*52."
^DIC(9.4,5,22,13,"PAH",50,1,32,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,5,22,13,"PAH",50,1,33,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,5,22,13,"PAH",50,1,34,0)="    affected routine(s).  "
^DIC(9.4,5,22,13,"PAH",50,1,35,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,5,22,13,"PAH",50,1,36,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,5,22,13,"PAH",50,1,37,0)="4.  Users may be on the system.  You do not need to stop TaskMan."
^DIC(9.4,5,22,13,"PAH",50,1,38,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,5,22,13,"PAH",50,1,39,0)="    Transport Global:"
^DIC(9.4,5,22,13,"PAH",50,1,40,0)="       Verify Checksums in Transport Global"
^DIC(9.4,5,22,13,"PAH",50,1,41,0)="       Print Transport Global"
^DIC(9.4,5,22,13,"PAH",50,1,42,0)="       Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",50,1,43,0)="       Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",50,1,44,0)="       Install Package(s)"
^DIC(9.4,5,22,13,"PAH",50,1,45,0)=" Select INSTALL NAME:    XT*7.3*74    Loaded from Distribution  <date/time>"
^DIC(9.4,5,22,13,"PAH",50,1,46,0)="                         =========="
^DIC(9.4,5,22,13,"PAH",50,1,47,0)=" Install Questions for XT*7.3*74"
^DIC(9.4,5,22,13,"PAH",50,1,48,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,49,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,5,22,13,"PAH",50,1,50,0)="                                                       =="
^DIC(9.4,5,22,13,"PAH",50,1,51,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,5,22,13,"PAH",50,1,52,0)="                                                                       =="
^DIC(9.4,5,22,13,"PAH",50,1,53,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,5,22,13,"PAH",50,1,54,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,5,22,13,"PAH",50,1,55,0)=" Enter a '^' to abort the install."
^DIC(9.4,5,22,13,"PAH",50,1,56,0)=""
^DIC(9.4,5,22,13,"PAH",50,1,57,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,5,22,13,"PAH",50,1,58,0)="                ------------------------------"
^DIC(9.4,5,22,13,"PAH",50,1,59,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
