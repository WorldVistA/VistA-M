^DIC(9.4,93,22,21,"PAH",155,1,1,0)="Please see FORUM for a complete patch description"
^DIC(9.4,93,22,21,"PAH",156,0)="194 SEQ #170^3160211.17145^54"
^DIC(9.4,93,22,21,"PAH",156,1,0)="^^4^4^3160211"
^DIC(9.4,93,22,21,"PAH",156,1,1,0)="This patch will remove PRIORITY OF EXAM (#9) from the CHECK C&P "
^DIC(9.4,93,22,21,"PAH",156,1,2,0)="FILE INTEGRITY [DVBA C CHECK 2507 INTEGRITY] validation logic and"
^DIC(9.4,93,22,21,"PAH",156,1,3,0)="filter inactive cancellation reasons while cancelling compensation"
^DIC(9.4,93,22,21,"PAH",156,1,4,0)="and pension requests/exams."
^DIC(9.4,93,22,21,"PAH",157,0)="196 SEQ #171^3160726.140601^54"
^DIC(9.4,93,22,21,"PAH",157,1,0)="^^4^4^3160726"
^DIC(9.4,93,22,21,"PAH",157,1,1,0)="This patch fixes an issue on the Vista side that leads to a <SUBSCRIPT>"
^DIC(9.4,93,22,21,"PAH",157,1,2,0)="error which results in a ""RPC DVBAB REPORTS could not be accessed!"""
^DIC(9.4,93,22,21,"PAH",157,1,3,0)="error in CAPRI when the ""Re-Print C&P Final Report(s)"" report is run"
^DIC(9.4,93,22,21,"PAH",157,1,4,0)="by date."
^DIC(9.4,93,22,21,"PAH",158,0)="200 SEQ #172^3170929.163903^54"
^DIC(9.4,93,22,21,"PAH",158,1,0)="^^4^4^3170929"
^DIC(9.4,93,22,21,"PAH",158,1,1,0)="This patch will update the display date for reports in CAPRI to"
^DIC(9.4,93,22,21,"PAH",158,1,2,0)="display the report date rather than the date the report was run."
^DIC(9.4,93,22,21,"PAH",158,1,3,0)="It also fixes several incorrect uses of the TEMP global and "
^DIC(9.4,93,22,21,"PAH",158,1,4,0)="fixes formatting issues with the 7131 Requests Report."
^DIC(9.4,93,22,21,"PAH",159,0)="205 SEQ #173^3180501.144632^54"
^DIC(9.4,93,22,21,"PAH",159,1,0)="^^2^2^3180501"
^DIC(9.4,93,22,21,"PAH",159,1,1,0)="With the replacement of Vista Web in CAPRI with Joint Legacy Viewer (JLV)"
^DIC(9.4,93,22,21,"PAH",159,1,2,0)="the new JLV URL's need to be updated and accessible in Vista."
^DIC(9.4,93,22,21,"PAH",160,0)="203 SEQ #174^3180907.131838^54"
^DIC(9.4,93,22,21,"PAH",160,1,0)="^^6^6^3180907"
^DIC(9.4,93,22,21,"PAH",160,1,1,0)=" This patch will address 2 issues:"
^DIC(9.4,93,22,21,"PAH",160,1,2,0)=" "
^DIC(9.4,93,22,21,"PAH",160,1,3,0)=" 1. Update routine DVBACRMS to allow printing of 21 day certificates to "
^DIC(9.4,93,22,21,"PAH",160,1,4,0)=" the CAPRI GUI."
^DIC(9.4,93,22,21,"PAH",160,1,5,0)="                                                  "
^DIC(9.4,93,22,21,"PAH",160,1,6,0)=" 2. Automate the release process of 21 day certificates."
^DIC(9.4,93,22,21,"PAH",161,0)="193 SEQ #175^3180925.154115^54"
^DIC(9.4,93,22,21,"PAH",161,1,0)="^^2^2^3180925"
^DIC(9.4,93,22,21,"PAH",161,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",161,1,2,0)="See FORUM patch DVBA*2.7*193 for a description of this patch."
^DIC(9.4,93,22,21,"PAH",162,0)="206 SEQ #176^3181102.155728^54"
^DIC(9.4,93,22,21,"PAH",162,1,0)="^^4^4^3181102"
^DIC(9.4,93,22,21,"PAH",162,1,1,0)=" This patch will address 1 issue:"
^DIC(9.4,93,22,21,"PAH",162,1,2,0)=" "
^DIC(9.4,93,22,21,"PAH",162,1,3,0)=" 1. This patch will update the AMIE EXAM (#396.6) file by changing"
^DIC(9.4,93,22,21,"PAH",162,1,4,0)="    10 exam names and inactivating 55 exams."
^DIC(9.4,93,22,21,"PAH",163,0)="207 SEQ #177^3181206.155454^54"
^DIC(9.4,93,22,21,"PAH",163,1,0)="^^3^3^3181206"
^DIC(9.4,93,22,21,"PAH",163,1,1,0)=" This patch will address 1 issue:"
^DIC(9.4,93,22,21,"PAH",163,1,2,0)=" "
^DIC(9.4,93,22,21,"PAH",163,1,3,0)=" 1. Change CAPRI to call new LCM (formerly called Virtual VA) URLs"
^DIC(9.4,93,22,21,"PAH",164,0)="210 SEQ #178^3190401.151109^54"
^DIC(9.4,93,22,21,"PAH",164,1,0)="^^4^4^3190401"
^DIC(9.4,93,22,21,"PAH",164,1,1,0)=" This patch will address 1 issue:"
^DIC(9.4,93,22,21,"PAH",164,1,2,0)=" "
^DIC(9.4,93,22,21,"PAH",164,1,3,0)=" 1. This patch will update the AMIE EXAM (#396.6) file by changing"
^DIC(9.4,93,22,21,"PAH",164,1,4,0)="    17 exam names and inactivating 1 exam."
^DIC(9.4,93,22,21,"PAH",165,0)="209 SEQ #179^3190501.155309^54"
^DIC(9.4,93,22,21,"PAH",165,1,0)="^^30^30^3190501"
^DIC(9.4,93,22,21,"PAH",165,1,1,0)="The Separation Health Assessment (SHA) is a comprehensive medical "
^DIC(9.4,93,22,21,"PAH",165,1,2,0)="examination conducted by either the Veterans Affairs (VA) or Department of"
^DIC(9.4,93,22,21,"PAH",165,1,3,0)="Defense (DoD) for Separating Service Members (SSMs) who file pre-discharge"
^DIC(9.4,93,22,21,"PAH",165,1,4,0)="claims under the Benefits Delivery at Discharge (BDD) Program.  The SHA is"
^DIC(9.4,93,22,21,"PAH",165,1,5,0)="used by both the Veterans Benefits Administration (VBA) and DoD to"
^DIC(9.4,93,22,21,"PAH",165,1,6,0)="evaluate a SSM's disability(ies) and determine benefits eligibility"
^DIC(9.4,93,22,21,"PAH",165,1,7,0)="according to a common standard. The VA and DoD need the ability"
^DIC(9.4,93,22,21,"PAH",165,1,8,0)="to share the SHA results as soon as it they become available (on or prior "
^DIC(9.4,93,22,21,"PAH",165,1,9,0)="to the Release from Active Duty [RAD] date). To avoid duplication of"
^DIC(9.4,93,22,21,"PAH",165,1,10,0)="health assessments between the two departments, VA assessments are used by"
^DIC(9.4,93,22,21,"PAH",165,1,11,0)="DoD."
^DIC(9.4,93,22,21,"PAH",165,1,12,0)=" "
^DIC(9.4,93,22,21,"PAH",165,1,13,0)=" "
^DIC(9.4,93,22,21,"PAH",165,1,14,0)="Patch DVBA*2.7*209 will also fix the following issues:"
^DIC(9.4,93,22,21,"PAH",165,1,15,0)="  "
^DIC(9.4,93,22,21,"PAH",165,1,16,0)="-2507 Request without Regional Office (RO) values"
^DIC(9.4,93,22,21,"PAH",165,1,17,0)="-Copy & Paste crash issues"
^DIC(9.4,93,22,21,"PAH",165,1,18,0)="-Inconsistent routing locations on 7131 requests"
^DIC(9.4,93,22,21,"PAH",165,1,19,0)="-7131 requests automatically closing in AMIE"
^DIC(9.4,93,22,21,"PAH",165,1,20,0)="-2507 Requests not closing out properly when an exam is cancelled"
^DIC(9.4,93,22,21,"PAH",165,1,21,0)="-""Validate Remote Connections"" validation issues"
^DIC(9.4,93,22,21,"PAH",165,1,22,0)="-Enterprise search issues with validating the ""Connect To"" site"
^DIC(9.4,93,22,21,"PAH",165,1,23,0)="-Enterprise search allowing search with all required data"
^DIC(9.4,93,22,21,"PAH",165,1,24,0)="-A delay between mouse cursor loading symbol changing back to pointer"
^DIC(9.4,93,22,21,"PAH",165,1,25,0)="-Capri Gui not recognizing version control"
^DIC(9.4,93,22,21,"PAH",165,1,26,0)="-GUI logger code default status change to improve performance"
^DIC(9.4,93,22,21,"PAH",165,1,27,0)="-C&P exams not transferring if patient is not registered at new receiving "
^DIC(9.4,93,22,21,"PAH",165,1,28,0)=" site"
^DIC(9.4,93,22,21,"PAH",165,1,29,0)="-DVBA C Check  2507 Integrity Report findings listing all exams"
^DIC(9.4,93,22,21,"PAH",165,1,30,0)="-New C&P Divisions being set to active automatically"
^DIC(9.4,93,22,21,"PAH",166,0)="208 SEQ #180^3190819.12071^65"
^DIC(9.4,93,22,21,"PAH",166,1,0)="^^275^275^3190819"
^DIC(9.4,93,22,21,"PAH",166,1,1,0)="This patch allows the DVBA C&P SCHD EVENT protocol to be bypassed when"
^DIC(9.4,93,22,21,"PAH",166,1,2,0)="the calling SDAM APPOINTMENT EVENTS protocol is invoked from within"
^DIC(9.4,93,22,21,"PAH",166,1,3,0)="VistA Scheduling GUI, as a GUI user would be unable to answer the user"
^DIC(9.4,93,22,21,"PAH",166,1,4,0)="input prompts for the DVBA protocol. (This patch does not require a GUI"
^DIC(9.4,93,22,21,"PAH",166,1,5,0)="update.)"
^DIC(9.4,93,22,21,"PAH",166,1,6,0)="  "
