^DIC(9.4,14,22,5.9,"PAH",107,1,653,0)="    LRUPAD1                7381083         3450917                      248"
^DIC(9.4,14,22,5.9,"PAH",107,1,654,0)="    LRUPAD2                8939713         5347530                   72,248"
^DIC(9.4,14,22,5.9,"PAH",107,1,655,0)="    LRUPS                  6061957         4571479                   72,248"
^DIC(9.4,14,22,5.9,"PAH",107,1,656,0)="    LRUPT                 10235244         9461906            1,153,201,248"
^DIC(9.4,14,22,5.9,"PAH",107,1,657,0)="    LRWOMEN                 944687          953781                  231,248"
^DIC(9.4,14,22,5.9,"PAH",107,1,658,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,659,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",107,1,660,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",107,1,661,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,662,0)="This patch can be installed with users on the system.  However, it is "
^DIC(9.4,14,22,5.9,"PAH",107,1,663,0)="recommended that installation occur when there is no Anatomic Pathology"
^DIC(9.4,14,22,5.9,"PAH",107,1,664,0)="activity or activity is at a minimum.  This will prevent 'Cannot return to "
^DIC(9.4,14,22,5.9,"PAH",107,1,665,0)="source routine' errors.  The Anatomic Pathology menu will be disabled "
^DIC(9.4,14,22,5.9,"PAH",107,1,666,0)="automatically by this patch and re-enable after installation."
^DIC(9.4,14,22,5.9,"PAH",107,1,667,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,668,0)="Install Time - approximately 1 minute"
^DIC(9.4,14,22,5.9,"PAH",107,1,669,0)="  "
^DIC(9.4,14,22,5.9,"PAH",107,1,670,0)="  1.  LOAD TRANSPORT GLOBAL"
^DIC(9.4,14,22,5.9,"PAH",107,1,671,0)="      ---------------------"
^DIC(9.4,14,22,5.9,"PAH",107,1,672,0)="      Choose the PackMan message containing this patch and invoke the"
^DIC(9.4,14,22,5.9,"PAH",107,1,673,0)="      INSTALL/CHECK MESSAGE PackMan option."
^DIC(9.4,14,22,5.9,"PAH",107,1,674,0)="  "
^DIC(9.4,14,22,5.9,"PAH",107,1,675,0)="  2.  DISABLE ROUTINE MAPPING   (DSM for Open VMS sites only)"
^DIC(9.4,14,22,5.9,"PAH",107,1,676,0)="      -----------------------"
^DIC(9.4,14,22,5.9,"PAH",107,1,677,0)="      Disable routine mapping on all systems for the routines listed"
^DIC(9.4,14,22,5.9,"PAH",107,1,678,0)="      in the Routine Summary above."
^DIC(9.4,14,22,5.9,"PAH",107,1,679,0)="      "
^DIC(9.4,14,22,5.9,"PAH",107,1,680,0)="      NOTE:  If the routines included in this patch are not currently"
^DIC(9.4,14,22,5.9,"PAH",107,1,681,0)="      in your mapped routine set, please skip this step."
^DIC(9.4,14,22,5.9,"PAH",107,1,682,0)="   "
^DIC(9.4,14,22,5.9,"PAH",107,1,683,0)="  3.  START KIDS"
^DIC(9.4,14,22,5.9,"PAH",107,1,684,0)="      ----------"
^DIC(9.4,14,22,5.9,"PAH",107,1,685,0)="      Start up the Kernel Installation and Distribution System Menu"
^DIC(9.4,14,22,5.9,"PAH",107,1,686,0)="      [XPD MAIN]:"
^DIC(9.4,14,22,5.9,"PAH",107,1,687,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,688,0)="           Edits and Distribution ..."
^DIC(9.4,14,22,5.9,"PAH",107,1,689,0)="           Utilities ..."
^DIC(9.4,14,22,5.9,"PAH",107,1,690,0)="           Installation ..."
^DIC(9.4,14,22,5.9,"PAH",107,1,691,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,692,0)="      Select Kernel Installation & Distribution System Option:  INStallation"
^DIC(9.4,14,22,5.9,"PAH",107,1,693,0)="                                                                ---"
^DIC(9.4,14,22,5.9,"PAH",107,1,694,0)="           Load a Distribution"
^DIC(9.4,14,22,5.9,"PAH",107,1,695,0)="           Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",107,1,696,0)="           Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",107,1,697,0)="           Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",107,1,698,0)="           Install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",107,1,699,0)="           Restart Install of Package(s)"
^DIC(9.4,14,22,5.9,"PAH",107,1,700,0)="           Unload a Distribution"
^DIC(9.4,14,22,5.9,"PAH",107,1,701,0)="           Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",107,1,702,0)="  "
^DIC(9.4,14,22,5.9,"PAH",107,1,703,0)="      Select Installation Option:"
^DIC(9.4,14,22,5.9,"PAH",107,1,704,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,705,0)="  4.  Select Installation Option"
^DIC(9.4,14,22,5.9,"PAH",107,1,706,0)="      --------------------------"
^DIC(9.4,14,22,5.9,"PAH",107,1,707,0)="      NOTE:  The following are OPTIONAL:"
^DIC(9.4,14,22,5.9,"PAH",107,1,708,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,709,0)="      a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,14,22,5.9,"PAH",107,1,710,0)="          message of any routines exported with this patch. It will"
^DIC(9.4,14,22,5.9,"PAH",107,1,711,0)="          not backup any other changes such as DD's or templates."
^DIC(9.4,14,22,5.9,"PAH",107,1,712,0)="      b.  Compare Transport Global to Current System - This option"
^DIC(9.4,14,22,5.9,"PAH",107,1,713,0)="          will allow you to view all changes that will be made when"
^DIC(9.4,14,22,5.9,"PAH",107,1,714,0)="          this patch is installed.  It compares all components of this"
^DIC(9.4,14,22,5.9,"PAH",107,1,715,0)="          patch (routines, DD's, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",107,1,716,0)="      c.  Verify Checksums in Transport Global - This option will"
^DIC(9.4,14,22,5.9,"PAH",107,1,717,0)="          allow you to ensure the integrity of the routines that are"
^DIC(9.4,14,22,5.9,"PAH",107,1,718,0)="          in the transport global."
^DIC(9.4,14,22,5.9,"PAH",107,1,719,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,720,0)="  5.  Select Installation Option: Install Package(s) "
^DIC(9.4,14,22,5.9,"PAH",107,1,721,0)="      ----------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",107,1,722,0)="      **This is the step to start the installation of this KIDS patch:"
^DIC(9.4,14,22,5.9,"PAH",107,1,723,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,724,0)="      a.  Choose the Install Package(s) option to start the patch"
^DIC(9.4,14,22,5.9,"PAH",107,1,725,0)="          install. When prompted for the INSTALL NAME, enter LR*5.2*248."
^DIC(9.4,14,22,5.9,"PAH",107,1,726,0)="      b.  There is no need to rebuild the menus."
^DIC(9.4,14,22,5.9,"PAH",107,1,727,0)="      c.  When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,14,22,5.9,"PAH",107,1,728,0)="          install? YES//' answer NO"
^DIC(9.4,14,22,5.9,"PAH",107,1,729,0)="      d.  Option Anatomic Pathology [LRAP] will be disabled by PRE^LR248"
^DIC(9.4,14,22,5.9,"PAH",107,1,730,0)="          before the install begins.  POST^LR248 will re-enable the option"
^DIC(9.4,14,22,5.9,"PAH",107,1,731,0)="          after installation is complete."
^DIC(9.4,14,22,5.9,"PAH",107,1,732,0)=" "
^DIC(9.4,14,22,5.9,"PAH",107,1,733,0)="  6.  REBUILD MAPPED ROUTINE(S)  (DSM for Open VMS sites only)"
^DIC(9.4,14,22,5.9,"PAH",107,1,734,0)="      -------------------------"
^DIC(9.4,14,22,5.9,"PAH",107,1,735,0)="      Optional - Include the routines distributed with this patch in"
^DIC(9.4,14,22,5.9,"PAH",107,1,736,0)="      the mapped routine set."
^DIC(9.4,14,22,5.9,"PAH",107,1,737,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,0)="258^3010227^1"
^DIC(9.4,14,22,5.9,"PAH",108,1,0)="^^344^344^3010227"
^DIC(9.4,14,22,5.9,"PAH",108,1,1,0)="VISTA BLOOD BANK SOFTWARE V5.2 DEVICE PRODUCT LABELING STATEMENT"
^DIC(9.4,14,22,5.9,"PAH",108,1,2,0)="============================="
^DIC(9.4,14,22,5.9,"PAH",108,1,3,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,4,0)=" June 10, 1999 "
^DIC(9.4,14,22,5.9,"PAH",108,1,5,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,6,0)="VISTA Laboratory Package patch LR*5.2*258 contains no changes to software"
^DIC(9.4,14,22,5.9,"PAH",108,1,7,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE.  "
^DIC(9.4,14,22,5.9,"PAH",108,1,8,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,9,0)="All changes have been reviewed by the VISTA Blood Bank Developer and found"
^DIC(9.4,14,22,5.9,"PAH",108,1,10,0)="to have no impact on the VISTA BLOOD BANK SOFTWARE control functions.  "
^DIC(9.4,14,22,5.9,"PAH",108,1,11,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,12,0)="RISK ANALYSIS: Changes made by patch LR*5.2*258 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",108,1,13,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",108,1,14,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,15,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*258 does not"
^DIC(9.4,14,22,5.9,"PAH",108,1,16,0)="alter or modify any software design safeguards or safety critical element"
^DIC(9.4,14,22,5.9,"PAH",108,1,17,0)="functions. "
^DIC(9.4,14,22,5.9,"PAH",108,1,18,0)="  "
^DIC(9.4,14,22,5.9,"PAH",108,1,19,0)="POTENTIAL IMPACT ON SITES: This patch contains no changes to files and"
^DIC(9.4,14,22,5.9,"PAH",108,1,20,0)="routines identified in Veterans Health Administration (VHA) Directive"
^DIC(9.4,14,22,5.9,"PAH",108,1,21,0)="99-053. The changes that are made have no effect to Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",108,1,22,0)="functionality or medical device control functions. There is no adverse"
^DIC(9.4,14,22,5.9,"PAH",108,1,23,0)="potential to sites."
^DIC(9.4,14,22,5.9,"PAH",108,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,25,0)="VALIDATION REQUIREMENTS BY OPTION: There are no required validations"
^DIC(9.4,14,22,5.9,"PAH",108,1,26,0)="scenarios to be completed by sites after installing this patch."
^DIC(9.4,14,22,5.9,"PAH",108,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,28,0)="Patch Description:"
^DIC(9.4,14,22,5.9,"PAH",108,1,29,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",108,1,30,0)="Pathology and Laboratory Medicine Service Central Office authorizes all"
^DIC(9.4,14,22,5.9,"PAH",108,1,31,0)="entries in the National Laboratory Test files. This patch adds or updates"
^DIC(9.4,14,22,5.9,"PAH",108,1,32,0)="National Laboratory Test (NLT) codes."
^DIC(9.4,14,22,5.9,"PAH",108,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,34,0)="This patch updates the WKLD CODE (#64) file with additional workload"
^DIC(9.4,14,22,5.9,"PAH",108,1,35,0)="codes. These workload codes are sometimes referred to as (NLT) codes. New"
^DIC(9.4,14,22,5.9,"PAH",108,1,36,0)="entries to the WKLD CODE files should never be added using FileMan Enter"
^DIC(9.4,14,22,5.9,"PAH",108,1,37,0)="Edit option. Use instead the option 'Add a new WKLD code to File' [LRCAP"
^DIC(9.4,14,22,5.9,"PAH",108,1,38,0)="CODE ADD]."
^DIC(9.4,14,22,5.9,"PAH",108,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,40,0)="The Laboratory Management Index Program (LMIP) workload collection"
^DIC(9.4,14,22,5.9,"PAH",108,1,41,0)="software will automatically make additions to the WKLD CODE as required."
^DIC(9.4,14,22,5.9,"PAH",108,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,43,0)="    DO NOT USE FileMan ENTER EDIT option TO MAKE ADDITIONS TO THE WKLD"
^DIC(9.4,14,22,5.9,"PAH",108,1,44,0)="CODE (#64) file."
^DIC(9.4,14,22,5.9,"PAH",108,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,46,0)="NOTE: The WKLD CODE (#64) file is not replaced. The file will be checked"
^DIC(9.4,14,22,5.9,"PAH",108,1,47,0)="for name spelling errors and entries changed if required. If names are"
^DIC(9.4,14,22,5.9,"PAH",108,1,48,0)="changed, they will be reported via mail message to the local mail group"
^DIC(9.4,14,22,5.9,"PAH",108,1,49,0)="LMI. In previous releases, some names were exported with trailing spaces."
^DIC(9.4,14,22,5.9,"PAH",108,1,50,0)="This will be corrected with this patch install."
^DIC(9.4,14,22,5.9,"PAH",108,1,51,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,52,0)="This patch will replace the LAB NLT/CPT CODES (#64.81) file during"
^DIC(9.4,14,22,5.9,"PAH",108,1,53,0)="installation:"
^DIC(9.4,14,22,5.9,"PAH",108,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,55,0)="This patch also updates the LAB DSS LAR EXTRACT (#64.036) file data"
^DIC(9.4,14,22,5.9,"PAH",108,1,56,0)="dictionary to include two new fields. SPECIMEN COLLECTION DATE (#10) and"
^DIC(9.4,14,22,5.9,"PAH",108,1,57,0)="SPECIMEN COLLECTION TIME (#11). The routine LRCAPDAR has been enhanced to"
^DIC(9.4,14,22,5.9,"PAH",108,1,58,0)="populate the new fields."
^DIC(9.4,14,22,5.9,"PAH",108,1,59,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,60,0)="NOTE: LAB DSS LAR EXTRACT file is used exclusively by the laboratory DSS"
^DIC(9.4,14,22,5.9,"PAH",108,1,61,0)="API for collecting clinical data. This file is not used or managed by the"
^DIC(9.4,14,22,5.9,"PAH",108,1,62,0)="Lab Service software."
^DIC(9.4,14,22,5.9,"PAH",108,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,64,0)="This patch includes a new (3rd) cross reference in the WKLD CODE (#64)"
^DIC(9.4,14,22,5.9,"PAH",108,1,65,0)="file on the CODE (#18) subfile, CODE (.01) field. The entire file is cross"
^DIC(9.4,14,22,5.9,"PAH",108,1,66,0)="referenced using the ""AB"" subscript."
^DIC(9.4,14,22,5.9,"PAH",108,1,67,0)=" Cross Reference description:"
^DIC(9.4,14,22,5.9,"PAH",108,1,68,0)=" ^LAM(""AB"",VARIABLE POINTER,IEN,MULTIPLE LOCATION NUMBER)="""""
^DIC(9.4,14,22,5.9,"PAH",108,1,69,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,70,0)="The WKLD SUFFIX CODES (#64.2) file contains a new field VENDOR (#19). This"
^DIC(9.4,14,22,5.9,"PAH",108,1,71,0)="field is used to describe the original manufacturer for this suffix."
^DIC(9.4,14,22,5.9,"PAH",108,1,72,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,73,0)="Update Logic:"
^DIC(9.4,14,22,5.9,"PAH",108,1,74,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,75,0)="The KIDS install populates National Laboratory Tests (NLT) with a"
^DIC(9.4,14,22,5.9,"PAH",108,1,76,0)="complete listing of new and previously released codes if they are missing."
^DIC(9.4,14,22,5.9,"PAH",108,1,77,0)="These files are:"
^DIC(9.4,14,22,5.9,"PAH",108,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,79,0)="    WKLD CODE (#64)"
^DIC(9.4,14,22,5.9,"PAH",108,1,80,0)="    WKLD SUFFIX CODES (#64.2)"
^DIC(9.4,14,22,5.9,"PAH",108,1,81,0)="    WKLD CODE LAB SECT (#64.21)"
^DIC(9.4,14,22,5.9,"PAH",108,1,82,0)="    WKLD ITEM FOR COUNT (#64.22)"
^DIC(9.4,14,22,5.9,"PAH",108,1,83,0)="    WKLD INSTRUMENT MANUFACTURER (#64.3)"
^DIC(9.4,14,22,5.9,"PAH",108,1,84,0)="    LAB NLT/CPT CODES (#64.81)  Only used during patch installation."
^DIC(9.4,14,22,5.9,"PAH",108,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,86,0)="NOTE: WKLD CODE (#64) file or any entries in the file are never deleted."
^DIC(9.4,14,22,5.9,"PAH",108,1,87,0)="Once an entry has been added to the WKLD CODE file, it remains for the"
^DIC(9.4,14,22,5.9,"PAH",108,1,88,0)="life of the file."
^DIC(9.4,14,22,5.9,"PAH",108,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,90,0)="The LAB NLT/CPT CODES (#64.81) file is populated with a complete list of"
^DIC(9.4,14,22,5.9,"PAH",108,1,91,0)="all released WKLD CODE procedures."
^DIC(9.4,14,22,5.9,"PAH",108,1,92,0)="   The post install routine reads entries from the LAB NLT/CPT CODES file."
^DIC(9.4,14,22,5.9,"PAH",108,1,93,0)="The install software first determines if the WKLD CODE number already"
^DIC(9.4,14,22,5.9,"PAH",108,1,94,0)="exist in WKLD CODE. If the WKLD CODE number exists, the spelling is"
^DIC(9.4,14,22,5.9,"PAH",108,1,95,0)="checked and changed if required."
^DIC(9.4,14,22,5.9,"PAH",108,1,96,0)="   If the WKLD CODE does not already exist, the new WKLD CODE is added to"
^DIC(9.4,14,22,5.9,"PAH",108,1,97,0)="the WKLD CODE file."
^DIC(9.4,14,22,5.9,"PAH",108,1,98,0)="   If a spelling change was required or a new WKLD CODE is added to the"
^DIC(9.4,14,22,5.9,"PAH",108,1,99,0)="WKLD CODE file, this information is included in a mail message sent to the"
^DIC(9.4,14,22,5.9,"PAH",108,1,100,0)="local 'LMI' mailman mail group."
^DIC(9.4,14,22,5.9,"PAH",108,1,101,0)="   If there were no install error during the update process and the update"
^DIC(9.4,14,22,5.9,"PAH",108,1,102,0)="was successful, all LAB NLT/CPT CODES file entries will be deleted and the"
^DIC(9.4,14,22,5.9,"PAH",108,1,103,0)="file will only contain one entry, NLT CODE 2000, after the install."
^DIC(9.4,14,22,5.9,"PAH",108,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,106,0)="NOTE: Additional workload codes added to the WKLD CODE file are populated"
^DIC(9.4,14,22,5.9,"PAH",108,1,107,0)="with CPT codes. Before the added codes are linked to LABORATORY TEST"
^DIC(9.4,14,22,5.9,"PAH",108,1,108,0)="procedures, the CPT coding should be reviewed to ensure it is appropriate"
^DIC(9.4,14,22,5.9,"PAH",108,1,109,0)="for the laboratory test it is being linked with."
^DIC(9.4,14,22,5.9,"PAH",108,1,110,0)="If the CPT code requires changing, use the 'Edit or Print WKLD CODES' [LR"
^DIC(9.4,14,22,5.9,"PAH",108,1,111,0)="WKLD CODE EDIT PRINT] option. Enter an INACTIVE DATE for the incorrect CPT"
^DIC(9.4,14,22,5.9,"PAH",108,1,112,0)="code. Then enter the correct CPT code and enter a RELEASE DATE of 'NOW'."
^DIC(9.4,14,22,5.9,"PAH",108,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",108,1,114,0)="Example:"
^DIC(9.4,14,22,5.9,"PAH",108,1,115,0)=" "
