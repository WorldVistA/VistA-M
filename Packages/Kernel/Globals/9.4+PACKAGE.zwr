^DIC(9.4,59,22,5,"PAH",221,1,0)="^^9^9^3100222"
^DIC(9.4,59,22,5,"PAH",221,1,1,0)="This patch will create the ""AC"" cross reference on the PARENT CLASS field "
^DIC(9.4,59,22,5,"PAH",221,1,2,0)="(#2) of the VA DRUG CLASS file (#50.605)."
^DIC(9.4,59,22,5,"PAH",221,1,3,0)=" "
^DIC(9.4,59,22,5,"PAH",221,1,4,0)="The new cross reference is utilized by the Patients on Specific Drug(s) "
^DIC(9.4,59,22,5,"PAH",221,1,5,0)="Multidivisional Enhancements patch PSJ*5*214, a Class III to Class I "
^DIC(9.4,59,22,5,"PAH",221,1,6,0)="conversion project."
^DIC(9.4,59,22,5,"PAH",221,1,7,0)=" "
^DIC(9.4,59,22,5,"PAH",221,1,8,0)="With the ""AC"" cross reference, a user can identify all child drug classes "
^DIC(9.4,59,22,5,"PAH",221,1,9,0)="that belong to a selected parent class."
