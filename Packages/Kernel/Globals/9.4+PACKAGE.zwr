^DIC(9.4,33,22,1.4,"PAH",35,1,199,0)=" HLCSDR           3936049         3904673       2,14,49,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,200,0)=" HLCSFMN0         5857525         5857070       15,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,201,0)=" HLCSFMN2         NEW             1942573       57"
