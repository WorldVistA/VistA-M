^DIC(9.4,4,22,1,"PAH",61,1,83,0)="This is what any site might see, regardless of patch XM*7.1*50:"
^DIC(9.4,4,22,1,"PAH",61,1,84,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,85,0)="Global ^XMB(3.9,""D"":"
^DIC(9.4,4,22,1,"PAH",61,1,86,0)="        XMB(3.9,""D"":          Everything that follows is bogus!"
