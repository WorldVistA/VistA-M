^DIC(9.4,4,22,1,"PAH",121,1,55,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",121,1,56,0)=" "
^DIC(9.4,4,22,1,"PAH",121,1,57,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",121,1,58,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",121,1,59,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",121,1,60,0)="XMTDF          4390490         5739561        50,127,142,150"
^DIC(9.4,4,22,1,"PAH",121,1,61,0)="XMTDL2         9530207        10072873        50,127,150"
^DIC(9.4,4,22,1,"PAH",121,1,62,0)="XMTDT          5589575         8285616        50,142,150"
^DIC(9.4,4,22,1,"PAH",121,1,63,0)="XMVVITA        7287397         7295482        50,101,110,140,150"
