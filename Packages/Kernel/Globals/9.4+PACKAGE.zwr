^DIC(9.4,48,22,5.28,"PAH",119,1,1,0)="This is the release of Scheduling patch SD*5.3*157.  The primary purpose"
^DIC(9.4,48,22,5.28,"PAH",119,1,2,0)="of this patch is to enable Multiple Position Reassignment functionality."
^DIC(9.4,48,22,5.28,"PAH",119,1,3,0)="Please refer to the patch description for further details and installation"
^DIC(9.4,48,22,5.28,"PAH",119,1,4,0)="instructions."
