^DIC(9.4,48,22,5.28,"PAH",579,1,285,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,286,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",579,1,287,0)="Updated the GUI to use SDEC GET PAT CONSUL RPC. "
^DIC(9.4,48,22,5.28,"PAH",579,1,288,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,289,0)="22) Jira #VSE-725 - Remove unnecessary RPC calls"
^DIC(9.4,48,22,5.28,"PAH",579,1,290,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,291,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",579,1,292,0)="There are 4 RPC calls made every time the context menu is opened in the "
^DIC(9.4,48,22,5.28,"PAH",579,1,293,0)="pending appointments list. Remove these calls, as they are unnecessary."
^DIC(9.4,48,22,5.28,"PAH",579,1,294,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,295,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",579,1,296,0)="Removed the 4 unnecessary RPC calls made when opening the context menu in "
^DIC(9.4,48,22,5.28,"PAH",579,1,297,0)="the pending appointments list."
^DIC(9.4,48,22,5.28,"PAH",579,1,298,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,299,0)="23) Jira #VSE-726 - Updates to GUI to support new SDEC ARGET RPC"
^DIC(9.4,48,22,5.28,"PAH",579,1,300,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,301,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",579,1,302,0)="Update GUI to use the new SDEC ARGET RPC that returns only needed data "
^DIC(9.4,48,22,5.28,"PAH",579,1,303,0)="for a specific appointment and incorporate into LSD service."
^DIC(9.4,48,22,5.28,"PAH",579,1,304,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,305,0)="Resolution: "
^DIC(9.4,48,22,5.28,"PAH",579,1,306,0)="The GUI was updated to include the new SDEC ARGET RPC."
^DIC(9.4,48,22,5.28,"PAH",579,1,307,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,308,0)="24) Jira #VSE-735 - Update GUI to use new SDEC GET PATIENT RECALL BY IEN "
^DIC(9.4,48,22,5.28,"PAH",579,1,309,0)="RPC"
^DIC(9.4,48,22,5.28,"PAH",579,1,310,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,311,0)="Problem:"
