^DIC(9.4,48,22,5.28,"PAH",588,1,35,0)="SDEC07 - VSE-1172 - updated to address Locking/Unlocking issue from"
^DIC(9.4,48,22,5.28,"PAH",588,1,36,0)="                    VSE-235"
^DIC(9.4,48,22,5.28,"PAH",588,1,37,0)="SDEC52CRMVJSON - VSE-1127 - Added logic to retrieve the RECALL REMINDER "
^DIC(9.4,48,22,5.28,"PAH",588,1,38,0)="                 data from the RECALL REMINDER REMOVED (#403.56) file."
^DIC(9.4,48,22,5.28,"PAH",588,1,39,0)="SDEC55A          VSE-1146"
^DIC(9.4,48,22,5.28,"PAH",588,1,40,0)="SDESAPPTUTIL     VSE-1146"
^DIC(9.4,48,22,5.28,"PAH",588,1,41,0)="SDESCHECKIN      VSE-985"
^DIC(9.4,48,22,5.28,"PAH",588,1,42,0)="SDEC50           VSE-985"
^DIC(9.4,48,22,5.28,"PAH",588,1,43,0)="SDEC08           VSE-1157"
^DIC(9.4,48,22,5.28,"PAH",588,1,44,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,45,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,46,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,47,0)="OPTIONS:"
^DIC(9.4,48,22,5.28,"PAH",588,1,48,0)="========"
^DIC(9.4,48,22,5.28,"PAH",588,1,49,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,50,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,51,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,52,0)="REMOTE PROCEDURES:"
^DIC(9.4,48,22,5.28,"PAH",588,1,53,0)="=================="
^DIC(9.4,48,22,5.28,"PAH",588,1,54,0)="  "
^DIC(9.4,48,22,5.28,"PAH",588,1,55,0)="SDEC GET RECALLRMV BY DFN JSON- VSE-1127 Retrieve RECALL REMINDER data "
^DIC(9.4,48,22,5.28,"PAH",588,1,56,0)="                          from RECALL REMINDER REMOVED (#403.56) file."
^DIC(9.4,48,22,5.28,"PAH",588,1,57,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,58,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,59,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,60,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,61,0)="JIRA tasks:"
^DIC(9.4,48,22,5.28,"PAH",588,1,62,0)="-----------"
^DIC(9.4,48,22,5.28,"PAH",588,1,63,0)="1) Jira #VSE-???(979)"
^DIC(9.4,48,22,5.28,"PAH",588,1,64,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,65,0)="Problem/Task:"
^DIC(9.4,48,22,5.28,"PAH",588,1,66,0)="  When doing a drag and drop with a recall appointment, the request is "
^DIC(9.4,48,22,5.28,"PAH",588,1,67,0)="  created on the RM Grid and not removed when the appointment is made.  "
^DIC(9.4,48,22,5.28,"PAH",588,1,68,0)="  "
^DIC(9.4,48,22,5.28,"PAH",588,1,69,0)="  This should be a behind the scene action...it shouldn't display on the "
^DIC(9.4,48,22,5.28,"PAH",588,1,70,0)="  RM Grid."
^DIC(9.4,48,22,5.28,"PAH",588,1,71,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,72,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,73,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,74,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,75,0)="2) Jira #VSE-985"
^DIC(9.4,48,22,5.28,"PAH",588,1,76,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,77,0)="Problem: Display a visual indicator for Pre-Checkin Step in VS GUI."
^DIC(9.4,48,22,5.28,"PAH",588,1,78,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,79,0)="Resolution: Update SDEC FAPPSGET RPC to include a new field that will "
^DIC(9.4,48,22,5.28,"PAH",588,1,80,0)="indicate if the patient has completed pre-checkin step for the "
^DIC(9.4,48,22,5.28,"PAH",588,1,81,0)="appointment."
^DIC(9.4,48,22,5.28,"PAH",588,1,82,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,83,0)="2) Jira #VSE-1037"
^DIC(9.4,48,22,5.28,"PAH",588,1,84,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,85,0)="Problem: The job SDRR CLEANUP needs to be disabled so that it cannot be "
^DIC(9.4,48,22,5.28,"PAH",588,1,86,0)="set up to run as a nightly job at sites. Follow the same pattern that "
^DIC(9.4,48,22,5.28,"PAH",588,1,87,0)="Brian Rene did for the EWL option."
^DIC(9.4,48,22,5.28,"PAH",588,1,88,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,89,0)="Resolution: Update OPTION SDRR CLEAN-UP to include OUT OF ORDER MESSAGE "
^DIC(9.4,48,22,5.28,"PAH",588,1,90,0)="so that it will not be available.  Also update routine SDRRCLR to QUIT "
^DIC(9.4,48,22,5.28,"PAH",588,1,91,0)="at the top of the routine so that it will not run. These updates "
^DIC(9.4,48,22,5.28,"PAH",588,1,92,0)="disable the menu option from being run manually or called from the "
^DIC(9.4,48,22,5.28,"PAH",588,1,93,0)="nightly Schedule/Unschedule Option under the TASKMAN MANAGEMENT option."
^DIC(9.4,48,22,5.28,"PAH",588,1,94,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,95,0)="3) Jira #VSE-1087"
^DIC(9.4,48,22,5.28,"PAH",588,1,96,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,97,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,98,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,99,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,100,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,101,0)="4) Jira #VSE-1094"
^DIC(9.4,48,22,5.28,"PAH",588,1,102,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,103,0)="Problem: When scheduling an future appointment using VistA for a clinic "
^DIC(9.4,48,22,5.28,"PAH",588,1,104,0)="that has a future re-activation date, the resource is not linked to the "
^DIC(9.4,48,22,5.28,"PAH",588,1,105,0)="appointment."
^DIC(9.4,48,22,5.28,"PAH",588,1,106,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,107,0)="Resolution: When adding the resource, do not check the inactivation "
^DIC(9.4,48,22,5.28,"PAH",588,1,108,0)="status."
^DIC(9.4,48,22,5.28,"PAH",588,1,109,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,110,0)="5) Jira #VSE-1127"
^DIC(9.4,48,22,5.28,"PAH",588,1,111,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,112,0)="Problem/Task:"
^DIC(9.4,48,22,5.28,"PAH",588,1,113,0)=" The RECALL REMINDER (#403.5) file data, may sometimes be unavailable "
^DIC(9.4,48,22,5.28,"PAH",588,1,114,0)=" because it was removed upon making an appointment."
^DIC(9.4,48,22,5.28,"PAH",588,1,115,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,116,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,117,0)=" Created an RPC (SDEC RECALLRMV BY DFN JSON) to retrieve the needed data "
^DIC(9.4,48,22,5.28,"PAH",588,1,118,0)=" from the RECALL RMINDER REMOVED (#403.56) file."
^DIC(9.4,48,22,5.28,"PAH",588,1,119,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,120,0)="6) Jira #VSE-1144"
^DIC(9.4,48,22,5.28,"PAH",588,1,121,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,122,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,123,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,124,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,125,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,126,0)="7) Jira #VSE-1146"
^DIC(9.4,48,22,5.28,"PAH",588,1,127,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,128,0)="Problem: Eligibility code is not returned when an appointment does not "
^DIC(9.4,48,22,5.28,"PAH",588,1,129,0)="have resource."
^DIC(9.4,48,22,5.28,"PAH",588,1,130,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,131,0)="Resolution: When no resource is found, get Hospital Location from the "
^DIC(9.4,48,22,5.28,"PAH",588,1,132,0)="Appointment sub file of the Patient file.  Use the Hospital Location to "
^DIC(9.4,48,22,5.28,"PAH",588,1,133,0)="get the Enrollment Code and Resource."
^DIC(9.4,48,22,5.28,"PAH",588,1,134,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,135,0)="8) Jira #VSE-1154"
^DIC(9.4,48,22,5.28,"PAH",588,1,136,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,137,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,138,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,139,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,140,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,141,0)="9) Jira #VSE-1155"
^DIC(9.4,48,22,5.28,"PAH",588,1,142,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,143,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,144,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,145,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,146,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,147,0)="10) Jira #VSE-1157"
^DIC(9.4,48,22,5.28,"PAH",588,1,148,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,149,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,150,0)="Ensure Contact Attempts for Recall Requests are included when converted "
^DIC(9.4,48,22,5.28,"PAH",588,1,151,0)="to APPT"
^DIC(9.4,48,22,5.28,"PAH",588,1,152,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,153,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,154,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,155,0)="Modified the Request Pointer in SDEC CONTACT (#409.86) file to reflect "
^DIC(9.4,48,22,5.28,"PAH",588,1,156,0)="the appropriate SDEC APPOINTMENT (#409.84) file entry."
^DIC(9.4,48,22,5.28,"PAH",588,1,157,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,158,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,159,0)="11) Jira #VSE-1171"
^DIC(9.4,48,22,5.28,"PAH",588,1,160,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,161,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,162,0)="Based on the Research performed in VSE-235 it was determine that a check "
^DIC(9.4,48,22,5.28,"PAH",588,1,163,0)="on the Appt Status needs to be added to the SDEC APPADD RPC to prevent it "
^DIC(9.4,48,22,5.28,"PAH",588,1,164,0)="from returning the original Appt for the Same Patient, Date and Clinic "
^DIC(9.4,48,22,5.28,"PAH",588,1,165,0)="when the original Appt has a status of Cancelled."
^DIC(9.4,48,22,5.28,"PAH",588,1,166,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,167,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,168,0)="Updated APPTGET^SDECUTL to include a status check for the following "
^DIC(9.4,48,22,5.28,"PAH",588,1,169,0)="statuses:"
^DIC(9.4,48,22,5.28,"PAH",588,1,170,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,171,0)="C:CANCELLED BY CLINIC"
^DIC(9.4,48,22,5.28,"PAH",588,1,172,0)="CA:CANCELLED BY CLINIC & AUTO RE-BOOK"
^DIC(9.4,48,22,5.28,"PAH",588,1,173,0)="N:NO-SHOW"
^DIC(9.4,48,22,5.28,"PAH",588,1,174,0)="NA:NO-SHOW & AUTO RE-BOOK"
^DIC(9.4,48,22,5.28,"PAH",588,1,175,0)="PC:CANCELLED BY PATIENT"
^DIC(9.4,48,22,5.28,"PAH",588,1,176,0)="PCA:CANCELLED BY PATIENT & AUTO-REBOOK"
^DIC(9.4,48,22,5.28,"PAH",588,1,177,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,178,0)="12) Jira #VSE-1172"
^DIC(9.4,48,22,5.28,"PAH",588,1,179,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,180,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,181,0)="There were 2 issues identified during the analysis on VSE-235:"
^DIC(9.4,48,22,5.28,"PAH",588,1,182,0)=" 1. Locking/Unlocking of ^SDEC(409.84 was using variable DFN instead of"
^DIC(9.4,48,22,5.28,"PAH",588,1,183,0)="    SDECAPPTID."
^DIC(9.4,48,22,5.28,"PAH",588,1,184,0)=" 2. A more efficient cross reference could be used for the "
^DIC(9.4,48,22,5.28,"PAH",588,1,185,0)="    APPTGET^SDECUTL subroutine."
^DIC(9.4,48,22,5.28,"PAH",588,1,186,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,187,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,188,0)=" 1. Routine SDEC07 was updated to use SDECAPPTID when locking or "
^DIC(9.4,48,22,5.28,"PAH",588,1,189,0)="    unlocking #409.84."
^DIC(9.4,48,22,5.28,"PAH",588,1,190,0)=" 2. Routine SDECUTL was updated to use the APTDT x-ref."
^DIC(9.4,48,22,5.28,"PAH",588,1,191,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,192,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,193,0)=") Jira #VSE-"
^DIC(9.4,48,22,5.28,"PAH",588,1,194,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,195,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,196,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,197,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,198,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,199,0)=") Jira #VSE-"
^DIC(9.4,48,22,5.28,"PAH",588,1,200,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,201,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,202,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,203,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,204,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,205,0)=") Jira #VSE-"
^DIC(9.4,48,22,5.28,"PAH",588,1,206,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,207,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,208,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,209,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,210,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,211,0)=") Jira #VSE-"
^DIC(9.4,48,22,5.28,"PAH",588,1,212,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,213,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,214,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,215,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",588,1,216,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,217,0)=") Jira #VSE-"
^DIC(9.4,48,22,5.28,"PAH",588,1,218,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,219,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",588,1,220,0)=" "
^DIC(9.4,48,22,5.28,"PAH",588,1,221,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",589,0)="792 SEQ #644^3210907.174918^17"
^DIC(9.4,48,22,5.28,"PAH",589,1,0)="^^70^70^3210907"
^DIC(9.4,48,22,5.28,"PAH",589,1,1,0)="VS GUI v. 1.7.10 Release"
^DIC(9.4,48,22,5.28,"PAH",589,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",589,1,3,0)="For tracking purposes, please add component(s) and note the associated"
^DIC(9.4,48,22,5.28,"PAH",589,1,4,0)="Jira task(s) out to the right on the same line."
^DIC(9.4,48,22,5.28,"PAH",589,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",589,1,6,0)="Sprint & Associated Tasks:"
^DIC(9.4,48,22,5.28,"PAH",589,1,7,0)="=========================="
^DIC(9.4,48,22,5.28,"PAH",589,1,8,0)="Sprint 16:"
^DIC(9.4,48,22,5.28,"PAH",589,1,9,0)="  VSE-1094 - VistA: Correct code to prevent appts with no resource"
^DIC(9.4,48,22,5.28,"PAH",589,1,10,0)="  VSE-1112 - VistA: Update so that appointment requests are only reopened"
^DIC(9.4,48,22,5.28,"PAH",589,1,11,0)="     for certain cancellation reasons"
^DIC(9.4,48,22,5.28,"PAH",589,1,12,0)="  VSE-1199 - .NET: Add Failure to Respond as disposition reason for SDEC "
^DIC(9.4,48,22,5.28,"PAH",589,1,13,0)="     requests"
^DIC(9.4,48,22,5.28,"PAH",589,1,14,0)="  VSE-1207 - .NET VS GUI: Display most recent checkin step status"
^DIC(9.4,48,22,5.28,"PAH",589,1,15,0)="  VSE-1211 - .NET: Update Code to Open APPT Request when PtCSch "
^DIC(9.4,48,22,5.28,"PAH",589,1,16,0)="     Appointment is No-Showed"
^DIC(9.4,48,22,5.28,"PAH",589,1,17,0)="  VSE-1214 - .NET: Update so that appt requests are only reopened for "
^DIC(9.4,48,22,5.28,"PAH",589,1,18,0)="     certain cancellation reasons"
^DIC(9.4,48,22,5.28,"PAH",589,1,19,0)="  VSE-1218 - VistA: Recall comments are not being carried over to APPT "
^DIC(9.4,48,22,5.28,"PAH",589,1,20,0)="     request created on cancellation"
^DIC(9.4,48,22,5.28,"PAH",589,1,21,0)="  VSE-1219 - VistA: Update Code to Open APPT Request when PtCSch "
^DIC(9.4,48,22,5.28,"PAH",589,1,22,0)="     Appointment is No-Showed"
^DIC(9.4,48,22,5.28,"PAH",589,1,23,0)="  VSE-1220 - VistA: Add Failure to Respond as disposition reason for SDEC "
^DIC(9.4,48,22,5.28,"PAH",589,1,24,0)="     requests"
^DIC(9.4,48,22,5.28,"PAH",589,1,25,0)="  VSE-???? - NEW RPD TO INDICATE IF INSURANCE VERIFICATION IS NEEDED"
