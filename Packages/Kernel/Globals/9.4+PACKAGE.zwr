^DIC(9.4,197,22,1,"PAH",16,0)="16^3110613.123828^17"
^DIC(9.4,197,22,1,"PAH",16,1,0)="^^74^74^3110613"
^DIC(9.4,197,22,1,"PAH",16,1,1,0)="MD*1.0*16 (Clinical Flowsheets Version 1.0)"
^DIC(9.4,197,22,1,"PAH",16,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,3,0)="The Clinical Flowsheets patch of the Clinical Procedures (CP) package"
^DIC(9.4,197,22,1,"PAH",16,1,4,0)="provides an electronic representation of the traditional paper flowsheet"
^DIC(9.4,197,22,1,"PAH",16,1,5,0)="maintained during each inpatient stay.  Vitals, Intake & Output (I&O), "
^DIC(9.4,197,22,1,"PAH",16,1,6,0)="Wound Documentation, etc., are examples of data types that can be "
^DIC(9.4,197,22,1,"PAH",16,1,7,0)="recorded via Clinical Flowsheets into the Veterans Health Information"
^DIC(9.4,197,22,1,"PAH",16,1,8,0)="System and Technology Architecture (VistA) system.  Clinical Flowsheets"
^DIC(9.4,197,22,1,"PAH",16,1,9,0)="provides a departure from its predecessor applications by storing "
^DIC(9.4,197,22,1,"PAH",16,1,10,0)="collected information as discrete data.  Some data elements, such as "
^DIC(9.4,197,22,1,"PAH",16,1,11,0)="vital signs, are available to the Vitals Package and Computerized Patient "
^DIC(9.4,197,22,1,"PAH",16,1,12,0)="Record System (CPRS).  Various reports built on the other data elements "
^DIC(9.4,197,22,1,"PAH",16,1,13,0)="are available for CPRS in the form of TIU Notes."
^DIC(9.4,197,22,1,"PAH",16,1,14,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,15,0)="There are two ways to enter data into Clinical Flowsheets: manually and"
^DIC(9.4,197,22,1,"PAH",16,1,16,0)="via Health Level 7 (HL7) messaging.  Any instrument or external system"
^DIC(9.4,197,22,1,"PAH",16,1,17,0)="capable of sending HL7 messages can be considered a source of data for"
^DIC(9.4,197,22,1,"PAH",16,1,18,0)="Clinical Flowsheets (provided that the HL7 messages conform to Clinical"
^DIC(9.4,197,22,1,"PAH",16,1,19,0)="Flowsheets requirements)."
^DIC(9.4,197,22,1,"PAH",16,1,20,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,21,0)="Clinical Flowsheets uses VistA Data Extraction Framework (VDEF) support,"
^DIC(9.4,197,22,1,"PAH",16,1,22,0)="HL7 messaging, and the CP Gateway service to notify the medical device of"
^DIC(9.4,197,22,1,"PAH",16,1,23,0)="the patient's admission, discharge, and transfer."
^DIC(9.4,197,22,1,"PAH",16,1,24,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,25,0)="The Clinical Flowsheets patch consists of these three (3) Graphical User"
^DIC(9.4,197,22,1,"PAH",16,1,26,0)="Interface (GUI) components and one (1) Kernel Installation & Distribution"
^DIC(9.4,197,22,1,"PAH",16,1,27,0)="System (KIDS) build:"
^DIC(9.4,197,22,1,"PAH",16,1,28,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,29,0)="   -  CP Console"
^DIC(9.4,197,22,1,"PAH",16,1,30,0)="   -  CP Flowsheets"
^DIC(9.4,197,22,1,"PAH",16,1,31,0)="   -  CP Gateway Service"
^DIC(9.4,197,22,1,"PAH",16,1,32,0)="   -  MD1_0P16.KID"
^DIC(9.4,197,22,1,"PAH",16,1,33,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,34,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,35,0)="++++++"
^DIC(9.4,197,22,1,"PAH",16,1,36,0)="NOTE:"
^DIC(9.4,197,22,1,"PAH",16,1,37,0)="    A.  IF THE SITE IS NOT CURRENTLY RUNNING CLINICAL PROCEDURES, ONLY"
^DIC(9.4,197,22,1,"PAH",16,1,38,0)="THE KIDS BUILD NEEDS TO BE INSTALLED.  ALL OTHER INSTALLATION"
^DIC(9.4,197,22,1,"PAH",16,1,39,0)="INSTRUCTIONS AND POST-INSTALLS CAN BE IGNORED."
^DIC(9.4,197,22,1,"PAH",16,1,40,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,41,0)="    B.  IF THE SITE IS RUNNING CLINICAL PROCEDURES AND DOES NOT PLAN ON"
^DIC(9.4,197,22,1,"PAH",16,1,42,0)="IMPLEMENTING CLINICAL FLOWSHEETS AT THIS TIME, ONLY THE KIDS AND CP"
^DIC(9.4,197,22,1,"PAH",16,1,43,0)="CONSOLE (REPLACEMENT FOR THE CURRENT CP MANAGER) NEED TO BE INSTALLED."
^DIC(9.4,197,22,1,"PAH",16,1,44,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,45,0)="    C.  IF THE SITE IS RUNNING CLINICAL PROCEDURES AND WISH TO BEGIN THE"
^DIC(9.4,197,22,1,"PAH",16,1,46,0)="IMPLEMENTATION OF CLINICAL FLOWSHEETS, THEN ALL 4 COMPONENTS NEED TO BE"
^DIC(9.4,197,22,1,"PAH",16,1,47,0)="INSTALLED: KIDS, CP CONSOLE, CP FLOWSHEETS AND THE NEW CP GATEWAY"
^DIC(9.4,197,22,1,"PAH",16,1,48,0)="SERVICE.-"
^DIC(9.4,197,22,1,"PAH",16,1,49,0)="++++++"
^DIC(9.4,197,22,1,"PAH",16,1,50,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,51,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,52,0)="FEATURES:"
^DIC(9.4,197,22,1,"PAH",16,1,53,0)="========="
^DIC(9.4,197,22,1,"PAH",16,1,54,0)="1.  FEATURE:  Provide GUI to view, enter and edit patient's data."
^DIC(9.4,197,22,1,"PAH",16,1,55,0)="Clinical Flowsheets provides a user-friendly, customizable, GUI with"
^DIC(9.4,197,22,1,"PAH",16,1,56,0)="""flow-sheets"" to view, manually edit, and manually enter patient ICU"
^DIC(9.4,197,22,1,"PAH",16,1,57,0)="Vitals and I&O information."
^DIC(9.4,197,22,1,"PAH",16,1,58,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,59,0)="2.  FEATURE:  Interface with Intensive Care Unit (ICU) devices."
^DIC(9.4,197,22,1,"PAH",16,1,60,0)="Clinical Flowsheets project and application will provide an interface for"
^DIC(9.4,197,22,1,"PAH",16,1,61,0)="the collection of patient data from ICU monitoring devices.  The"
^DIC(9.4,197,22,1,"PAH",16,1,62,0)="collected and verified data will be stored automatically in the"
^DIC(9.4,197,22,1,"PAH",16,1,63,0)="appropriate VistA database(s)."
^DIC(9.4,197,22,1,"PAH",16,1,64,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,65,0)="3.  FEATURE:  Introduces the Admission Discharge Transfer (ADT) system."
^DIC(9.4,197,22,1,"PAH",16,1,66,0)="With VDEF support, HL7 messaging, and the CP Gateway service, CP's ADT "
^DIC(9.4,197,22,1,"PAH",16,1,67,0)="sub-system will notify the ICU device of the patient admission, "
^DIC(9.4,197,22,1,"PAH",16,1,68,0)="discharge, "
^DIC(9.4,197,22,1,"PAH",16,1,69,0)="and transfer."
^DIC(9.4,197,22,1,"PAH",16,1,70,0)=" "
^DIC(9.4,197,22,1,"PAH",16,1,71,0)="4.  FEATURE:  Standardized Terminology Files."
^DIC(9.4,197,22,1,"PAH",16,1,72,0)="Clinical Flowsheets supports standardized terminology files with Vitals"
^DIC(9.4,197,22,1,"PAH",16,1,73,0)="Measurements, and I&O terms.  This standardized terminology file is also "
^DIC(9.4,197,22,1,"PAH",16,1,74,0)="a component of patch MD*1*16."
^DIC(9.4,197,22,1,"PAH",17,0)="12^3120214.114909^17"
^DIC(9.4,197,22,1,"PAH",17,1,0)="^^2^2^3120214"
^DIC(9.4,197,22,1,"PAH",17,1,1,0)=" "
^DIC(9.4,197,22,1,"PAH",17,1,2,0)="MD*1.0*12 - Clinical Flowsheets HL7 Redesign"
