^DIC(9.4,3,22,21,"PAH",48,1,38,0)="XPDTA1       4760350         4948004     **44,68**"
^DIC(9.4,3,22,21,"PAH",48,1,39,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",48,1,40,0)="                     **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",48,1,41,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",48,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",48,1,43,0)=" This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",48,1,44,0)=" should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",48,1,45,0)=" Since this patch is an update to KIDS, no other patches should be installed"
^DIC(9.4,3,22,21,"PAH",48,1,46,0)=" during the installation of this patch."
^DIC(9.4,3,22,21,"PAH",48,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",48,1,48,0)="    ****** This patch must be QUEUED during the install process ******"
^DIC(9.4,3,22,21,"PAH",48,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",48,1,50,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",48,1,51,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",48,1,52,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",48,1,53,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",48,1,54,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",48,1,55,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",48,1,56,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",48,1,57,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",48,1,58,0)="      global."
^DIC(9.4,3,22,21,"PAH",48,1,59,0)="  4.  Users can remain on the system. This patch can be queued and installed"
^DIC(9.4,3,22,21,"PAH",48,1,60,0)="      at any time.  TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",48,1,61,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",48,1,62,0)="      options:"
^DIC(9.4,3,22,21,"PAH",48,1,63,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",48,1,64,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",48,1,65,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",48,1,66,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",48,1,67,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",48,1,68,0)="              INSTALL NAME: XU*8.0*68"
^DIC(9.4,3,22,21,"PAH",48,1,69,0)="                            ========="
^DIC(9.4,3,22,21,"PAH",48,1,70,0)="  6.  At the device prompt, make sure you queue the install:"
^DIC(9.4,3,22,21,"PAH",48,1,71,0)="              DEVICE: HOME// QUEUE TO PRINT ON"
^DIC(9.4,3,22,21,"PAH",48,1,72,0)="                             ="
^DIC(9.4,3,22,21,"PAH",48,1,73,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",48,1,74,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",49,0)="73^2980211"
^DIC(9.4,3,22,21,"PAH",49,1,0)="^^79^79^2980408"
^DIC(9.4,3,22,21,"PAH",49,1,1,0)="*** This patch is a high priority because it is needed by the OpenM ***"
^DIC(9.4,3,22,21,"PAH",49,1,2,0)="*** sites to adjust to changes made by Intersystem in build 52e that***"
^DIC(9.4,3,22,21,"PAH",49,1,3,0)="*** is going out to the sites.                                      ***"
^DIC(9.4,3,22,21,"PAH",49,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",49,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",49,1,6,0)="ISL-0198-51102  XUSTERM  Didn't have code to call the extended-action option"
^DIC(9.4,3,22,21,"PAH",49,1,7,0)="                         in XUSTERM2."
^DIC(9.4,3,22,21,"PAH",49,1,8,0)="                         "
^DIC(9.4,3,22,21,"PAH",49,1,9,0)="                XQ33    Fix from IHS about deleting options."
^DIC(9.4,3,22,21,"PAH",49,1,10,0)="                   "
^DIC(9.4,3,22,21,"PAH",49,1,11,0)="                ZTER    Change to allow OpenM sites to use the new error"
^DIC(9.4,3,22,21,"PAH",49,1,12,0)="                        trapping.  The check was conditional because early"
^DIC(9.4,3,22,21,"PAH",49,1,13,0)="                        versions didn't support this.  Then OpenM started"
^DIC(9.4,3,22,21,"PAH",49,1,14,0)="                        changing its name with each version. Fixed to remove"
^DIC(9.4,3,22,21,"PAH",49,1,15,0)="                        version checking, assume all VA site running current"
^DIC(9.4,3,22,21,"PAH",49,1,16,0)="                        version that supports standard error trapping."
^DIC(9.4,3,22,21,"PAH",49,1,17,0)="                        "
^DIC(9.4,3,22,21,"PAH",49,1,18,0)="                        The options XUDEV RES-ONE and XUDEV RES-CLEAR didn't"
^DIC(9.4,3,22,21,"PAH",49,1,19,0)="                        get linked to the XUTIO menu in patch 49."
^DIC(9.4,3,22,21,"PAH",49,1,20,0)="                        Resending to link them up."
^DIC(9.4,3,22,21,"PAH",49,1,21,0)="                        "
^DIC(9.4,3,22,21,"PAH",49,1,22,0)="BIL-0298-30193          Alert tracking file 8992.1 was missing field .08"
^DIC(9.4,3,22,21,"PAH",49,1,23,0)="                        to control retention of alerts."
^DIC(9.4,3,22,21,"PAH",49,1,24,0)="                        "
^DIC(9.4,3,22,21,"PAH",49,1,25,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",49,1,26,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",49,1,27,0)="XQ33          8946889   9007179    **49,73**"
^DIC(9.4,3,22,21,"PAH",49,1,28,0)="XUSTERM                14376497    **36,73**"
^DIC(9.4,3,22,21,"PAH",49,1,29,0)="ZTER         18727059  19441177    **8,18,32,24,36,63,73**"
^DIC(9.4,3,22,21,"PAH",49,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",49,1,31,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",49,1,32,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",49,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",49,1,34,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",49,1,35,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",49,1,36,0)="      "
^DIC(9.4,3,22,21,"PAH",49,1,37,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",49,1,38,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",49,1,39,0)="      "
^DIC(9.4,3,22,21,"PAH",49,1,40,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",49,1,41,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",49,1,42,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",49,1,43,0)="      options:"
^DIC(9.4,3,22,21,"PAH",49,1,44,0)="      "
^DIC(9.4,3,22,21,"PAH",49,1,45,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",49,1,46,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",49,1,47,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",49,1,48,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",49,1,49,0)="         "
^DIC(9.4,3,22,21,"PAH",49,1,50,0)=" 4.   Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",49,1,51,0)="      non-peek time."
^DIC(9.4,3,22,21,"PAH",49,1,52,0)="      "
^DIC(9.4,3,22,21,"PAH",49,1,53,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",49,1,54,0)="      option:"
^DIC(9.4,3,22,21,"PAH",49,1,55,0)="         Install Package(s)  'XU*8.0*73'"
^DIC(9.4,3,22,21,"PAH",49,1,56,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",49,1,57,0)="         "
^DIC(9.4,3,22,21,"PAH",49,1,58,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",49,1,59,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",49,1,60,0)="      "
^DIC(9.4,3,22,21,"PAH",49,1,61,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",49,1,62,0)="      DSM/MSM sites - you need to move one routines from "
^DIC(9.4,3,22,21,"PAH",49,1,63,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",49,1,64,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",49,1,65,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",49,1,66,0)="      "
^DIC(9.4,3,22,21,"PAH",49,1,67,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",49,1,68,0)="       "
^DIC(9.4,3,22,21,"PAH",49,1,69,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",49,1,70,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",49,1,71,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",49,1,72,0)="      Patch number to load: 73"
^DIC(9.4,3,22,21,"PAH",49,1,73,0)="                            =="
^DIC(9.4,3,22,21,"PAH",49,1,74,0)="       "
^DIC(9.4,3,22,21,"PAH",49,1,75,0)="  9.  MSM sites move these routines to the MGR accounts on other CPU's."
^DIC(9.4,3,22,21,"PAH",49,1,76,0)="        "
^DIC(9.4,3,22,21,"PAH",49,1,77,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",49,1,78,0)=" "
^DIC(9.4,3,22,21,"PAH",49,1,79,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",50,0)="63^2970422"
^DIC(9.4,3,22,21,"PAH",50,1,0)="^^67^67^2980603"
^DIC(9.4,3,22,21,"PAH",50,1,1,0)="This patch was requested because of different errors that needed to be "
^DIC(9.4,3,22,21,"PAH",50,1,2,0)="screened at the OpenM site."
^DIC(9.4,3,22,21,"PAH",50,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",50,1,4,0)="This patch updates the error routines and Taskman to use a common place to"
^DIC(9.4,3,22,21,"PAH",50,1,5,0)="check to see if errors should NOT be recorded or should be screened from"
^DIC(9.4,3,22,21,"PAH",50,1,6,0)="the normal XTER listing.  The current ERROR MESSAGE file has been enhanced"
^DIC(9.4,3,22,21,"PAH",50,1,7,0)="to control this action.  The %ZTER routine checks the list and will not"
^DIC(9.4,3,22,21,"PAH",50,1,8,0)="record errors that are flagged not to record."
^DIC(9.4,3,22,21,"PAH",50,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",50,1,10,0)="Sites can add their own entries to the file.  There is a field to allow"
^DIC(9.4,3,22,21,"PAH",50,1,11,0)="the advanced strings that Taskman has been using.  Current entries in"
^DIC(9.4,3,22,21,"PAH",50,1,12,0)="Taskmans error screen file are moved to the new file as part of the"
^DIC(9.4,3,22,21,"PAH",50,1,13,0)="install."
^DIC(9.4,3,22,21,"PAH",50,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",50,1,15,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",50,1,16,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",50,1,17,0)="XTER         17066911  17970380    **63**"
^DIC(9.4,3,22,21,"PAH",50,1,18,0)="XTER1A       16667281  16315266    **63**"
^DIC(9.4,3,22,21,"PAH",50,1,19,0)="XUINPCH       2465171   3137390    **20,36,49,63**"
^DIC(9.4,3,22,21,"PAH",50,1,20,0)="XUTMKE1       5103401   3519416    **63**"
^DIC(9.4,3,22,21,"PAH",50,1,21,0)="XUTMKE2       9221275   2696336    **63**"
^DIC(9.4,3,22,21,"PAH",50,1,22,0)="ZTER         18727059  19357862    **8,18,32,24,36,34,63**"
^DIC(9.4,3,22,21,"PAH",50,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",50,1,24,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",50,1,25,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",50,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",50,1,27,0)="1.  There is no need for these routines to be mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",50,1,28,0)="mapping."
^DIC(9.4,3,22,21,"PAH",50,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",50,1,30,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",50,1,31,0)="option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",50,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",50,1,33,0)="3.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,3,22,21,"PAH",50,1,34,0)="You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",50,1,35,0)="On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",50,1,36,0)="options:"
^DIC(9.4,3,22,21,"PAH",50,1,37,0)="          Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",50,1,38,0)="          Print Transport Global"
^DIC(9.4,3,22,21,"PAH",50,1,39,0)="          Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",50,1,40,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",50,1,41,0)="  "
^DIC(9.4,3,22,21,"PAH",50,1,42,0)="4.  Users can remain on the system. This patch can be queued and"
^DIC(9.4,3,22,21,"PAH",50,1,43,0)="installed at any time.  "
^DIC(9.4,3,22,21,"PAH",50,1,44,0)=""
^DIC(9.4,3,22,21,"PAH",50,1,45,0)="5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",50,1,46,0)="option:"
^DIC(9.4,3,22,21,"PAH",50,1,47,0)="          Install Package(s)  'XU*8.0*63'"
^DIC(9.4,3,22,21,"PAH",50,1,48,0)="                               ========="
^DIC(9.4,3,22,21,"PAH",50,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",50,1,50,0)="6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to other"
^DIC(9.4,3,22,21,"PAH",50,1,51,0)="CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",50,1,52,0)="       "
^DIC(9.4,3,22,21,"PAH",50,1,53,0)="7.  After installing this patch, you need to move one routine from "
^DIC(9.4,3,22,21,"PAH",50,1,54,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",50,1,55,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",50,1,56,0)="    "
^DIC(9.4,3,22,21,"PAH",50,1,57,0)="      And in the manager account,"
^DIC(9.4,3,22,21,"PAH",50,1,58,0)="       "
^DIC(9.4,3,22,21,"PAH",50,1,59,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",50,1,60,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",50,1,61,0)="      Patch number to load: 63"
^DIC(9.4,3,22,21,"PAH",50,1,62,0)="                            =="
^DIC(9.4,3,22,21,"PAH",50,1,63,0)="      MSM Site - Move these MGR routines to your other CPU's."
^DIC(9.4,3,22,21,"PAH",50,1,64,0)="       "
^DIC(9.4,3,22,21,"PAH",50,1,65,0)=""
^DIC(9.4,3,22,21,"PAH",50,1,66,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",50,1,67,0)=""
^DIC(9.4,3,22,21,"PAH",51,0)="65^2970828"
^DIC(9.4,3,22,21,"PAH",51,1,0)="^^98^98^2980408"
^DIC(9.4,3,22,21,"PAH",51,1,1,0)="HUN-0396-21050  XQAL*   Fix several small problems that cause errors in "
^DIC(9.4,3,22,21,"PAH",51,1,2,0)="HUN-0996-21721          special cases. Changed to use TMP from XUTL."
^DIC(9.4,3,22,21,"PAH",51,1,3,0)="Forum 24021577          If the user has a mix of Info and action alerts,"
^DIC(9.4,3,22,21,"PAH",51,1,4,0)="                        during processing of alerts the display will "
^DIC(9.4,3,22,21,"PAH",51,1,5,0)="                        stop before doing an action that could cause"
^DIC(9.4,3,22,21,"PAH",51,1,6,0)="                        info to scroll off the top."
^DIC(9.4,3,22,21,"PAH",51,1,7,0)="                      "
^DIC(9.4,3,22,21,"PAH",51,1,8,0)="CIRN            ZISHMSM  Fix the way that %ZISH under MSM open's multiple"
^DIC(9.4,3,22,21,"PAH",51,1,9,0)="                         host files."
^DIC(9.4,3,22,21,"PAH",51,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,11,0)="TUA-0997-30470  ZISH*    Fix to use the DEFAULT DIRECTORY FOR HFS field"
^DIC(9.4,3,22,21,"PAH",51,1,12,0)="CHY-1097-52881           in file 8989.3 (KSP). Fix use of recordsize to"
^DIC(9.4,3,22,21,"PAH",51,1,13,0)="                         match CIRN."
^DIC(9.4,3,22,21,"PAH",51,1,14,0)="                         "
^DIC(9.4,3,22,21,"PAH",51,1,15,0)="LAK-0897-30499           DEVICE file $I field length increased to 40 char.          "
^DIC(9.4,3,22,21,"PAH",51,1,16,0)="                         "
^DIC(9.4,3,22,21,"PAH",51,1,17,0)="AXP TEAM        ZOSFVXD  Disable priority changing, This has caused performance"
^DIC(9.4,3,22,21,"PAH",51,1,18,0)="                ZOSVVXD  problems when lower priority jobs hold locks on"
^DIC(9.4,3,22,21,"PAH",51,1,19,0)="                         critical code sections."
^DIC(9.4,3,22,21,"PAH",51,1,20,0)="                         "
^DIC(9.4,3,22,21,"PAH",51,1,21,0)="CHY-0597-50132   XUS91   Made a fix to make the code more robust."
^DIC(9.4,3,22,21,"PAH",51,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,23,0)="                         Fix description for rescheduling frequency. "
^DIC(9.4,3,22,21,"PAH",51,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,25,0)="               XUWORKDY  Fix problem if HOLIDAY file is missing."
^DIC(9.4,3,22,21,"PAH",51,1,26,0)="  "
^DIC(9.4,3,22,21,"PAH",51,1,27,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",51,1,28,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",51,1,29,0)="XQALDEL      13827021  12561210    **6,24,65**"
^DIC(9.4,3,22,21,"PAH",51,1,30,0)="XQALDOIT     10428734   9852030    **1,6,65**"
^DIC(9.4,3,22,21,"PAH",51,1,31,0)="XQALERT       5798541   5307017    **1,65**"
^DIC(9.4,3,22,21,"PAH",51,1,32,0)="XQALERT1     19524336  18178207    **20,65**"
^DIC(9.4,3,22,21,"PAH",51,1,33,0)="XQALFWD      10036386  10058961    **6,65**"
^DIC(9.4,3,22,21,"PAH",51,1,34,0)="XQALSET      13085815  12680442    **1,6,65**"
^DIC(9.4,3,22,21,"PAH",51,1,35,0)="XUINPCH       3256791   3950316    **20,36,43,49,63,65**"
^DIC(9.4,3,22,21,"PAH",51,1,36,0)="XUPARAM                 1006391    **65**"
^DIC(9.4,3,22,21,"PAH",51,1,37,0)="XUS91                   8526517    **18,65**"
^DIC(9.4,3,22,21,"PAH",51,1,38,0)="XUTMG43                  921517    **18,65**"
^DIC(9.4,3,22,21,"PAH",51,1,39,0)="XUWORKDY      1331031   1179273    **65**"
^DIC(9.4,3,22,21,"PAH",51,1,40,0)="ZISHMSM       5354551   5685657    **24,36,49,65**"
^DIC(9.4,3,22,21,"PAH",51,1,41,0)="ZISHONT                 5001907    **34,65**"
^DIC(9.4,3,22,21,"PAH",51,1,42,0)="ZISHVXD                 6891389    **24,36,65**"
^DIC(9.4,3,22,21,"PAH",51,1,43,0)="ZOSFVXD       7401132   7407077    **65**"
^DIC(9.4,3,22,21,"PAH",51,1,44,0)="ZOSVVXD       7519714   7658715    **13,65**"
^DIC(9.4,3,22,21,"PAH",51,1,45,0)="ZTPTCH        4509174   4561379    **44,65**"
^DIC(9.4,3,22,21,"PAH",51,1,46,0)="                                              "
^DIC(9.4,3,22,21,"PAH",51,1,47,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",51,1,48,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",51,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,50,0)=" 1.  Some of these routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",51,1,51,0)="     so you will need to disable mapping for the effected routines. "
^DIC(9.4,3,22,21,"PAH",51,1,52,0)="     "
^DIC(9.4,3,22,21,"PAH",51,1,53,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",51,1,54,0)="     option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",51,1,55,0)="     "
^DIC(9.4,3,22,21,"PAH",51,1,56,0)=" 3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",51,1,57,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",51,1,58,0)="     "
^DIC(9.4,3,22,21,"PAH",51,1,59,0)=" 4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",51,1,60,0)="      user are on the system and the possibility of some CLOBER/EDITED"
^DIC(9.4,3,22,21,"PAH",51,1,61,0)="      errors is acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",51,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,63,0)="     "
^DIC(9.4,3,22,21,"PAH",51,1,64,0)=" 5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",51,1,65,0)="     options:"
^DIC(9.4,3,22,21,"PAH",51,1,66,0)="     "
^DIC(9.4,3,22,21,"PAH",51,1,67,0)="        Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",51,1,68,0)="        Print Transport Global"
^DIC(9.4,3,22,21,"PAH",51,1,69,0)="        Compare Transport Global to Current System      "
^DIC(9.4,3,22,21,"PAH",51,1,70,0)="        Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",51,1,71,0)="        Install Package(s)  'XU*8.0*65'"
^DIC(9.4,3,22,21,"PAH",51,1,72,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",51,1,73,0)="        "
^DIC(9.4,3,22,21,"PAH",51,1,74,0)=" 6.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",51,1,75,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",51,1,76,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",51,1,77,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",51,1,78,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,79,0)="      ZISHMSM"
^DIC(9.4,3,22,21,"PAH",51,1,80,0)="      ZISHONT"
^DIC(9.4,3,22,21,"PAH",51,1,81,0)="      ZISHVXD"
^DIC(9.4,3,22,21,"PAH",51,1,82,0)="      ZOSFVXD"
^DIC(9.4,3,22,21,"PAH",51,1,83,0)="      ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",51,1,84,0)="    "
^DIC(9.4,3,22,21,"PAH",51,1,85,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",51,1,86,0)="      "
^DIC(9.4,3,22,21,"PAH",51,1,87,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",51,1,88,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",51,1,89,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",51,1,90,0)="      Patch number to load: 65"
^DIC(9.4,3,22,21,"PAH",51,1,91,0)="                            =="
^DIC(9.4,3,22,21,"PAH",51,1,92,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,93,0)=" 7.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",51,1,94,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,95,0)=" 8.   Enable user's login."
^DIC(9.4,3,22,21,"PAH",51,1,96,0)=""
^DIC(9.4,3,22,21,"PAH",51,1,97,0)=" ========================================================================="
