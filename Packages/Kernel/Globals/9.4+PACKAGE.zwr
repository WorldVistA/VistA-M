^DIC(9.4,5,22,13,"PAH",28,0)="39 SEQ #36^3000816^1"
^DIC(9.4,5,22,13,"PAH",28,1,0)="^^76^76^3000816"
^DIC(9.4,5,22,13,"PAH",28,1,1,0)="This patch updates two Kernel tools to make use of the KIDS build file"
^DIC(9.4,5,22,13,"PAH",28,1,2,0)="and adds menu options for them to the KIDS Edit and Distribution menu."
^DIC(9.4,5,22,13,"PAH",28,1,3,0)="The two routines are XTRUTL and XTVNUM."
^DIC(9.4,5,22,13,"PAH",28,1,4,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,5,0)="XTVNUM will set the second line for each routine of a build. It loads the"
^DIC(9.4,5,22,13,"PAH",28,1,6,0)="Version number for packages or adds the patch number for patches."
^DIC(9.4,5,22,13,"PAH",28,1,7,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,8,0)="XTRUTL is used to provide the Routine Summary list that needs to be included"
^DIC(9.4,5,22,13,"PAH",28,1,9,0)="in patch descriptions.  It keeps the old checksum in the routine file in "
^DIC(9.4,5,22,13,"PAH",28,1,10,0)="field CHECKSUM VALUE. "
^DIC(9.4,5,22,13,"PAH",28,1,11,0)="XTRUTL also has other entry points:"
^DIC(9.4,5,22,13,"PAH",28,1,12,0)="  DO UPDATE^XTRUTL will update the checksum field for all the routines in a"
^DIC(9.4,5,22,13,"PAH",28,1,13,0)="  build. Used after a patch has been released to capture the current checksum"
^DIC(9.4,5,22,13,"PAH",28,1,14,0)="  values."
^DIC(9.4,5,22,13,"PAH",28,1,15,0)="  UD1^XTRUTL(routine) will update the checksum for just one routine."
^DIC(9.4,5,22,13,"PAH",28,1,16,0)="  SHOW^XTRUTL(routine) will show the saved checksum and the current checksum."
^DIC(9.4,5,22,13,"PAH",28,1,17,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,18,0)="                 "
^DIC(9.4,5,22,13,"PAH",28,1,19,0)="The patch also fixes an error that was reported in OR*3.0*10 PATCH TRACKER"
^DIC(9.4,5,22,13,"PAH",28,1,20,0)=" (#29934111) No quit value, at OUT+2^XPARDD. "
^DIC(9.4,5,22,13,"PAH",28,1,21,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,22,0)="The patch also addresses NOIS ISL-1199-51331  Add Device file as a Parameter"
^DIC(9.4,5,22,13,"PAH",28,1,23,0)=" entity. To do this the patch has the DD for file 8989.5 field .01."
^DIC(9.4,5,22,13,"PAH",28,1,24,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,25,0)="Routine Summary"
^DIC(9.4,5,22,13,"PAH",28,1,26,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,5,22,13,"PAH",28,1,27,0)="of these routines now looks like:"
^DIC(9.4,5,22,13,"PAH",28,1,28,0)=" ;;7.3;TOOLKIT;<patchlist>;Apr 25, 1995"
^DIC(9.4,5,22,13,"PAH",28,1,29,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,30,0)="                 Checksum"
^DIC(9.4,5,22,13,"PAH",28,1,31,0)="Routine         Old       New      2nd Line"
^DIC(9.4,5,22,13,"PAH",28,1,32,0)="XPARDD        7342389   7348385    **26,35,39**"
^DIC(9.4,5,22,13,"PAH",28,1,33,0)="XTRUTL        3298825   5471022    **20,39**"
^DIC(9.4,5,22,13,"PAH",28,1,34,0)="XTVNUM        9944358   9971672    **20,39**"
^DIC(9.4,5,22,13,"PAH",28,1,35,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,36,0)="List of preceding patches: 20, 35"
^DIC(9.4,5,22,13,"PAH",28,1,37,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,5,22,13,"PAH",28,1,38,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,39,0)="========================================================================= "
^DIC(9.4,5,22,13,"PAH",28,1,40,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",28,1,41,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,42,0)=">>>Users may remain on the system."
^DIC(9.4,5,22,13,"PAH",28,1,43,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,44,0)="  1.  DSM sites - Some of these routines may be mapped,"
^DIC(9.4,5,22,13,"PAH",28,1,45,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,5,22,13,"PAH",28,1,46,0)="     "
^DIC(9.4,5,22,13,"PAH",28,1,47,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",28,1,48,0)="      option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",28,1,49,0)="     "
^DIC(9.4,5,22,13,"PAH",28,1,50,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",28,1,51,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",28,1,52,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",28,1,53,0)="      options:"
^DIC(9.4,5,22,13,"PAH",28,1,54,0)="      "
^DIC(9.4,5,22,13,"PAH",28,1,55,0)="         Verify Checksums in Transport Global"
^DIC(9.4,5,22,13,"PAH",28,1,56,0)="         Print Transport Global"
^DIC(9.4,5,22,13,"PAH",28,1,57,0)="         Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",28,1,58,0)="         Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",28,1,59,0)="     "
^DIC(9.4,5,22,13,"PAH",28,1,60,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,5,22,13,"PAH",28,1,61,0)="      non-peakpeak time."
^DIC(9.4,5,22,13,"PAH",28,1,62,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,5,22,13,"PAH",28,1,63,0)=""
^DIC(9.4,5,22,13,"PAH",28,1,64,0)="     "
^DIC(9.4,5,22,13,"PAH",28,1,65,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",28,1,66,0)="      option:"
^DIC(9.4,5,22,13,"PAH",28,1,67,0)="        Install Package(s)  'XT*7.3*39'"
^DIC(9.4,5,22,13,"PAH",28,1,68,0)="                             ========="
^DIC(9.4,5,22,13,"PAH",28,1,69,0)="                             "
^DIC(9.4,5,22,13,"PAH",28,1,70,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,5,22,13,"PAH",28,1,71,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,5,22,13,"PAH",28,1,72,0)="                                                                        =="
^DIC(9.4,5,22,13,"PAH",28,1,73,0)="     "
