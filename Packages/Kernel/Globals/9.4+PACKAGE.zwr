^DIC(9.4,223,0)="VISTA INTEGRATION ADAPTER^VIAB^VIAB APP"
^DIC(9.4,223,20,0)="^9.402P^^"
^DIC(9.4,223,22,0)="^9.49I^1^1"
^DIC(9.4,223,22,1,0)="1.0"
^DIC(9.4,223,22,1,"PAH",0)="^9.4901^22^22"
^DIC(9.4,223,22,1,"PAH",1,0)="1^3140310^123456789093"
^DIC(9.4,223,22,1,"PAH",1,1,0)="^^26^26^3140310"
^DIC(9.4,223,22,1,"PAH",1,1,1,0)="The VistA Integration Adapter (VIA) team needs to create two new proxy"
^DIC(9.4,223,22,1,"PAH",1,1,2,0)="users in order to connect via VistALink and to allow Remote Procedure"
^DIC(9.4,223,22,1,"PAH",1,1,3,0)="Calls (RPC) to be invoked.  These users are VIABCONNECTORPROXY,VIAB"
^DIC(9.4,223,22,1,"PAH",1,1,4,0)="for the Connector Proxy and VIABAPPLICATIONPROXY,VIAB for the"
^DIC(9.4,223,22,1,"PAH",1,1,5,0)="Application Proxy.  In addition, a new menu option is created."
^DIC(9.4,223,22,1,"PAH",1,1,6,0)=" "
^DIC(9.4,223,22,1,"PAH",1,1,7,0)="In order to implement the changes required for this patch, a"
^DIC(9.4,223,22,1,"PAH",1,1,8,0)="combination of patch updates and post-installation steps are required."
^DIC(9.4,223,22,1,"PAH",1,1,9,0)="The new VIAB WEB SERVICES OPTION option is installed by the patch"
^DIC(9.4,223,22,1,"PAH",1,1,10,0)="and the new Application Proxy is implemented by the post-init routine"
^DIC(9.4,223,22,1,"PAH",1,1,11,0)="VIABRPC5.  After successful installation, the site will need to"
^DIC(9.4,223,22,1,"PAH",1,1,12,0)="manually create the Connector Proxy utilizing Foundations Manager"
^DIC(9.4,223,22,1,"PAH",1,1,13,0)="as detailed in the Post-Installation instructions."
^DIC(9.4,223,22,1,"PAH",1,1,14,0)=" "
^DIC(9.4,223,22,1,"PAH",1,1,15,0)=" "
^DIC(9.4,223,22,1,"PAH",1,1,16,0)=" "
^DIC(9.4,223,22,1,"PAH",1,1,17,0)="************************ Important Information ***********************"
^DIC(9.4,223,22,1,"PAH",1,1,18,0)="**                                                                  **"
^DIC(9.4,223,22,1,"PAH",1,1,19,0)="** Note: A VistaLink listener port needs to be open, available and  **"
^DIC(9.4,223,22,1,"PAH",1,1,20,0)="**       maintained by each production site.                        **"
^DIC(9.4,223,22,1,"PAH",1,1,21,0)="**                                                                  **"
^DIC(9.4,223,22,1,"PAH",1,1,22,0)="** Note: The host name/address and VistALink port must be correctly **"
^DIC(9.4,223,22,1,"PAH",1,1,23,0)="**       defined in the VistALink                                   **"
^DIC(9.4,223,22,1,"PAH",1,1,24,0)="**       gov.va.med.vistalink.connectorConfig.xml file              **"
^DIC(9.4,223,22,1,"PAH",1,1,25,0)="**                                                                  **"
^DIC(9.4,223,22,1,"PAH",1,1,26,0)="**********************************************************************"
^DIC(9.4,223,22,1,"PAH",2,0)="1 SEQ #1^3140702.124633^17"
^DIC(9.4,223,22,1,"PAH",2,1,0)="^^26^26^3140702"
^DIC(9.4,223,22,1,"PAH",2,1,1,0)="The VistA Integration Adapter (VIA) team needs to create two new proxy"
^DIC(9.4,223,22,1,"PAH",2,1,2,0)="users in order to connect via VistALink and to allow Remote Procedure"
^DIC(9.4,223,22,1,"PAH",2,1,3,0)="Calls (RPC) to be invoked.  These users are VIABCONNECTORPROXY,VIAB"
^DIC(9.4,223,22,1,"PAH",2,1,4,0)="for the Connector Proxy and VIABAPPLICATIONPROXY,VIAB for the"
^DIC(9.4,223,22,1,"PAH",2,1,5,0)="Application Proxy.  In addition, a new menu option is created."
^DIC(9.4,223,22,1,"PAH",2,1,6,0)=" "
^DIC(9.4,223,22,1,"PAH",2,1,7,0)="In order to implement the changes required for this patch, a"
^DIC(9.4,223,22,1,"PAH",2,1,8,0)="combination of patch updates and post-installation steps are required."
^DIC(9.4,223,22,1,"PAH",2,1,9,0)="The new VIAB WEB SERVICES OPTION option is installed by the patch"
^DIC(9.4,223,22,1,"PAH",2,1,10,0)="and the new Application Proxy is implemented by the post-init routine"
^DIC(9.4,223,22,1,"PAH",2,1,11,0)="VIABRPC5.  After successful installation, the site will need to"
^DIC(9.4,223,22,1,"PAH",2,1,12,0)="manually create the Connector Proxy utilizing Foundations Manager"
^DIC(9.4,223,22,1,"PAH",2,1,13,0)="as detailed in the Post-Installation instructions."
^DIC(9.4,223,22,1,"PAH",2,1,14,0)=" "
^DIC(9.4,223,22,1,"PAH",2,1,15,0)=" "
^DIC(9.4,223,22,1,"PAH",2,1,16,0)=" "
^DIC(9.4,223,22,1,"PAH",2,1,17,0)="************************ Important Information ***********************"
^DIC(9.4,223,22,1,"PAH",2,1,18,0)="**                                                                  **"
^DIC(9.4,223,22,1,"PAH",2,1,19,0)="** Note: A VistaLink listener port needs to be open, available and  **"
^DIC(9.4,223,22,1,"PAH",2,1,20,0)="**       maintained by each production site.                        **"
^DIC(9.4,223,22,1,"PAH",2,1,21,0)="**                                                                  **"
^DIC(9.4,223,22,1,"PAH",2,1,22,0)="** Note: The host name/address and VistALink port must be correctly **"
^DIC(9.4,223,22,1,"PAH",2,1,23,0)="**       defined in the VistALink                                   **"
^DIC(9.4,223,22,1,"PAH",2,1,24,0)="**       gov.va.med.vistalink.connectorConfig.xml file              **"
^DIC(9.4,223,22,1,"PAH",2,1,25,0)="**                                                                  **"
^DIC(9.4,223,22,1,"PAH",2,1,26,0)="**********************************************************************"
^DIC(9.4,223,22,1,"PAH",3,0)="3 SEQ #3^3141202.151628^17"
^DIC(9.4,223,22,1,"PAH",3,1,0)="^^4^4^3141202"
^DIC(9.4,223,22,1,"PAH",3,1,1,0)="The VistA integration Adaptor (VIA) project requires access to certain "
^DIC(9.4,223,22,1,"PAH",3,1,2,0)="Remote Procedure Calls (RPCs).  The purpose of this patch is to publish"
^DIC(9.4,223,22,1,"PAH",3,1,3,0)="those RPCs in the OPTION file (#19), RPC field (#320) which allows VIA"
^DIC(9.4,223,22,1,"PAH",3,1,4,0)="to access."
^DIC(9.4,223,22,1,"PAH",4,0)="5 SEQ #6^3160504.125427^54"
^DIC(9.4,223,22,1,"PAH",4,1,0)="^^2^2^3160504"
^DIC(9.4,223,22,1,"PAH",4,1,1,0)="Vista Integration Adapter enhancements updates for Increments 1 and 3. "
^DIC(9.4,223,22,1,"PAH",4,1,2,0)="Updated VIAB WEB SERVICES OPTION to include new RPC's. Added 3 new RPC's."
^DIC(9.4,223,22,1,"PAH",5,0)="7 SEQ #7^3160916.134253^54"
^DIC(9.4,223,22,1,"PAH",6,0)="8 SEQ #8^3170203.153351^54"
^DIC(9.4,223,22,1,"PAH",7,0)="10 SEQ #9^3170427.16362^54"
^DIC(9.4,223,22,1,"PAH",8,0)="9 SEQ #10^3170627.151846^54"
^DIC(9.4,223,22,1,"PAH",9,0)="11 SEQ #11^3180601.151825^54"
^DIC(9.4,223,22,1,"PAH",10,0)="12 SEQ #12^3180803.151446^54"
^DIC(9.4,223,22,1,"PAH",11,0)="13 SEQ #13^3181004.161505^54"
^DIC(9.4,223,22,1,"PAH",12,0)="14 SEQ #14^3190402.172335^54"
^DIC(9.4,223,22,1,"PAH",13,0)="15 SEQ #15^3190604.180803^54"
^DIC(9.4,223,22,1,"PAH",13,1,0)="^^14^14^3190604"
^DIC(9.4,223,22,1,"PAH",13,1,1,0)="VIAB*1.0*15"
^DIC(9.4,223,22,1,"PAH",13,1,2,0)=" "
^DIC(9.4,223,22,1,"PAH",13,1,3,0)="Changes include:"
^DIC(9.4,223,22,1,"PAH",13,1,4,0)=" "
^DIC(9.4,223,22,1,"PAH",13,1,5,0)="(1). Add a $GET to ORDACT2+4^VIABMS4"
^DIC(9.4,223,22,1,"PAH",13,1,6,0)="The remote procedure VIABMS contains a target LISTORDERACTIONS that "
^DIC(9.4,223,22,1,"PAH",13,1,7,0)="filters orders by ORDER ACTION. When checking the STATUS field which is "
^DIC(9.4,223,22,1,"PAH",13,1,8,0)="defined on the 3-node of the file, it does not include a $GET to protect "
^DIC(9.4,223,22,1,"PAH",13,1,9,0)="against the possibility that the node might not be present. This corrects "
^DIC(9.4,223,22,1,"PAH",13,1,10,0)="that omission."
^DIC(9.4,223,22,1,"PAH",13,1,11,0)=" "
^DIC(9.4,223,22,1,"PAH",13,1,12,0)="(2).  Moves LISTORDERS on the 'AF' cross reference"
^DIC(9.4,223,22,1,"PAH",13,1,13,0)=" "
^DIC(9.4,223,22,1,"PAH",13,1,14,0)="(3). Uses DATE/TIME ORDERED in LISTORDERS and LISTORDERACTIONS compare "
^DIC(9.4,223,22,1,"PAH",14,0)="19 SEQ #16^3200410.155815^70"
^DIC(9.4,223,22,1,"PAH",14,1,0)="^^2^2^3200410"
^DIC(9.4,223,22,1,"PAH",14,1,1,0)="This patch changes the GETACT tag in VIABMS to gather all dispositions "
^DIC(9.4,223,22,1,"PAH",14,1,2,0)="with the flag ""VA""."
^DIC(9.4,223,22,1,"PAH",15,0)="16 SEQ #17^3200515.094023^70"
^DIC(9.4,223,22,1,"PAH",16,0)="18 SEQ #18^3200515.094412^70"
^DIC(9.4,223,22,1,"PAH",16,1,0)="^^3^3^3200515"
^DIC(9.4,223,22,1,"PAH",16,1,1,0)="This patch adds the RPC SDEC APPSLOTS for odd clinic start times to "
^DIC(9.4,223,22,1,"PAH",16,1,2,0)="the VIAB WEB SERVICES option to register this RPC.  See ICR 7071 for "
^DIC(9.4,223,22,1,"PAH",16,1,3,0)="approval to call the RPC."
^DIC(9.4,223,22,1,"PAH",17,0)="20 SEQ #19^3200819.114039^65"
^DIC(9.4,223,22,1,"PAH",17,1,0)="^^7^7^3200819"
^DIC(9.4,223,22,1,"PAH",17,1,1,0)="This patch fixes the following COVID-19 VIA applications:"
^DIC(9.4,223,22,1,"PAH",17,1,2,0)="1. Bed Management Solutions (BMS).  [ListOrderActions] fix when Order "
^DIC(9.4,223,22,1,"PAH",17,1,3,0)="   Text field has '[' in its result."
^DIC(9.4,223,22,1,"PAH",17,1,4,0)="2. Adds a new RPC to the REMOTE PROCEDURE CALL file (#8994), VIAB GETDEM"
^DIC(9.4,223,22,1,"PAH",17,1,5,0)="   to return patient demographic data using the PIMS supported DEM^VADPT"
^DIC(9.4,223,22,1,"PAH",17,1,6,0)="   API call."
^DIC(9.4,223,22,1,"PAH",17,1,7,0)="3. Adds RPC VIAB GETDEM to VIA's VIAB WEB SERVICES OPTION option."
^DIC(9.4,223,22,1,"PAH",18,0)="22 SEQ #20^3201015.12344^17"
^DIC(9.4,223,22,1,"PAH",18,1,0)="^^2^2^3201015"
^DIC(9.4,223,22,1,"PAH",18,1,1,0)="ADD RPC VIAB PATCH, SO THAT VIAB WEB SERVICES CAN DETERMINE WHEN VISTA "
^DIC(9.4,223,22,1,"PAH",18,1,2,0)="PATCHES ARE PRESENT.  EX: OR*3.0*524"
^DIC(9.4,223,22,1,"PAH",19,0)="21b^3210512"
^DIC(9.4,223,22,1,"PAH",19,1,0)="^^5^5^3210512"
^DIC(9.4,223,22,1,"PAH",19,1,1,0)="Backup of VIAB*1.0*21 on May 12, 2021"
^DIC(9.4,223,22,1,"PAH",19,1,2,0)=" "
^DIC(9.4,223,22,1,"PAH",19,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,223,22,1,"PAH",19,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,223,22,1,"PAH",19,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,223,22,1,"PAH",20,0)="21 SEQ #21^3210512.151603^17"
^DIC(9.4,223,22,1,"PAH",20,1,0)="^^5^5^3210512"
^DIC(9.4,223,22,1,"PAH",20,1,1,0)="PCE changes brought on by PX*1.0*211 require changes for mobile "
^DIC(9.4,223,22,1,"PAH",20,1,2,0)="applications. This patch will change the return for saveNoteandEncounter "
^DIC(9.4,223,22,1,"PAH",20,1,3,0)="service of Vista Integration Adapter to provide better messaging for the"
^DIC(9.4,223,22,1,"PAH",20,1,4,0)="calling application. However, this patch is NOT dependent on PX*1.0*211. "
^DIC(9.4,223,22,1,"PAH",20,1,5,0)="The return array may contain some new values if PX*1.0*211 is present. "
^DIC(9.4,223,22,1,"PAH",21,0)="23 SEQ #22^3211217.113319^17"
^DIC(9.4,223,22,1,"PAH",22,0)="24 SEQ #23^3241203.170621^89"
^DIC(9.4,223,22,1,"PAH",22,1,0)="^^18^18^3241203"
^DIC(9.4,223,22,1,"PAH",22,1,1,0)="Description:"
^DIC(9.4,223,22,1,"PAH",22,1,2,0)="==========="
^DIC(9.4,223,22,1,"PAH",22,1,3,0)=" "
^DIC(9.4,223,22,1,"PAH",22,1,4,0)="This patch addresses the return text value from the Bed Management System"
^DIC(9.4,223,22,1,"PAH",22,1,5,0)="(BMS) LISTORDERACTIONS call when the result string exceeds a number of "
^DIC(9.4,223,22,1,"PAH",22,1,6,0)="characters."
^DIC(9.4,223,22,1,"PAH",22,1,7,0)=" "
^DIC(9.4,223,22,1,"PAH",22,1,8,0)="Problem: LISTORDERACTIONS uses the LIST^DIC call within its code.  If the"
^DIC(9.4,223,22,1,"PAH",22,1,9,0)="size of the Order's Order Text field is too wordy and exceeds a number of"
^DIC(9.4,223,22,1,"PAH",22,1,10,0)="characters, LIST^DIC returns an 'overflow' error ""The data requested for"
^DIC(9.4,223,22,1,"PAH",22,1,11,0)="the record is too long to pack together."" and the result doesn't pass over"
^DIC(9.4,223,22,1,"PAH",22,1,12,0)="to BMS."
^DIC(9.4,223,22,1,"PAH",22,1,13,0)=" "
^DIC(9.4,223,22,1,"PAH",22,1,14,0)="Resolution: In an effort to pass the result to BMS, the text will get "
^DIC(9.4,223,22,1,"PAH",22,1,15,0)="truncated after 3675 characters with the trailing tag:"
^DIC(9.4,223,22,1,"PAH",22,1,16,0)=" "
^DIC(9.4,223,22,1,"PAH",22,1,17,0)="""<*NOTE: order text reached max length, please check appropriate system "
^DIC(9.4,223,22,1,"PAH",22,1,18,0)="for full order text*>"""
^DIC(9.4,223,22,1,"PAH","B",1,1)=""
^DIC(9.4,223,22,1,"PAH","B","1 SEQ #1",2)=""
^DIC(9.4,223,22,1,"PAH","B","10 SEQ #9",7)=""
^DIC(9.4,223,22,1,"PAH","B","11 SEQ #11",9)=""
^DIC(9.4,223,22,1,"PAH","B","12 SEQ #12",10)=""
^DIC(9.4,223,22,1,"PAH","B","13 SEQ #13",11)=""
^DIC(9.4,223,22,1,"PAH","B","14 SEQ #14",12)=""
^DIC(9.4,223,22,1,"PAH","B","15 SEQ #15",13)=""
^DIC(9.4,223,22,1,"PAH","B","16 SEQ #17",15)=""
^DIC(9.4,223,22,1,"PAH","B","18 SEQ #18",16)=""
^DIC(9.4,223,22,1,"PAH","B","19 SEQ #16",14)=""
^DIC(9.4,223,22,1,"PAH","B","20 SEQ #19",17)=""
^DIC(9.4,223,22,1,"PAH","B","21 SEQ #21",20)=""
^DIC(9.4,223,22,1,"PAH","B","21b",19)=""
^DIC(9.4,223,22,1,"PAH","B","22 SEQ #20",18)=""
^DIC(9.4,223,22,1,"PAH","B","23 SEQ #22",21)=""
^DIC(9.4,223,22,1,"PAH","B","24 SEQ #23",22)=""
^DIC(9.4,223,22,1,"PAH","B","3 SEQ #3",3)=""
^DIC(9.4,223,22,1,"PAH","B","5 SEQ #6",4)=""
^DIC(9.4,223,22,1,"PAH","B","7 SEQ #7",5)=""
^DIC(9.4,223,22,1,"PAH","B","8 SEQ #8",6)=""
^DIC(9.4,223,22,1,"PAH","B","9 SEQ #10",8)=""
^DIC(9.4,223,22,"B","1.0",1)=""
^DIC(9.4,223,"VERSION")=1
