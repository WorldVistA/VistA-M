^DIC(9.4,13,22,8,"PAH",10,1,82,0)="          DSM for OpenVMS                 DSM for OpenVMS"
^DIC(9.4,13,22,8,"PAH",10,1,83,0)="          DTM-PC                          DTM-PC"
^DIC(9.4,13,22,8,"PAH",10,1,84,0)="          GT.M(VAX)                       GT.M(VAX)"
^DIC(9.4,13,22,8,"PAH",10,1,85,0)="          MSM                             MSM"
^DIC(9.4,13,22,8,"PAH",10,1,86,0)="          OTHER                           OTHER"
^DIC(9.4,13,22,8,"PAH",10,1,87,0)="          ------------------------------"
^DIC(9.4,13,22,8,"PAH",10,1,88,0)=" COUNT    6"
^DIC(9.4,13,22,8,"PAH",10,1,89,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,90,0)="    (NOIS: PHI-0694-20785, MEM-0997-70237)"
^DIC(9.4,13,22,8,"PAH",10,1,91,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,92,0)="NOISes "
^DIC(9.4,13,22,8,"PAH",10,1,93,0)="======"
