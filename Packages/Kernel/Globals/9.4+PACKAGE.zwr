^DIC(9.4,14,22,5.9,"PAH",233,1,194,0)="LR*5.2*302"
^DIC(9.4,14,22,5.9,"PAH",233,1,195,0)="LR*5.2*232"
^DIC(9.4,14,22,5.9,"PAH",233,1,196,0)="LR*5.2*280"
^DIC(9.4,14,22,5.9,"PAH",233,1,197,0)="XU*8.0*299"
^DIC(9.4,14,22,5.9,"PAH",233,1,198,0)="XT*7.3*93"
^DIC(9.4,14,22,5.9,"PAH",233,1,199,0)="HDI*1.0*1"
^DIC(9.4,14,22,5.9,"PAH",233,1,200,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,201,0)="Installation Instructions:  "
^DIC(9.4,14,22,5.9,"PAH",233,1,202,0)="========================= "
^DIC(9.4,14,22,5.9,"PAH",233,1,203,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,204,0)="The patch LR*5.2*334 KIDS build file named LR_52_334.KID is stored in the "
^DIC(9.4,14,22,5.9,"PAH",233,1,205,0)="ASCII format."
^DIC(9.4,14,22,5.9,"PAH",233,1,206,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,207,0)="LAB_52_p334_IMPG.doc; VistA National Laboratory Test (NLT)/Logical "
^DIC(9.4,14,22,5.9,"PAH",233,1,208,0)="Observation Identifier Naming Codes (LOINC) V2.14 Update Implementation "
^DIC(9.4,14,22,5.9,"PAH",233,1,209,0)="Guide Patch LR*5.2*334 Version 5.2 - stored in a BINARY format."
^DIC(9.4,14,22,5.9,"PAH",233,1,210,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,211,0)="LAB_52_p334_IMPG.pdf; VistA National Laboratory Test (NLT)/Logical "
^DIC(9.4,14,22,5.9,"PAH",233,1,212,0)="Observation Identifier Naming Codes (LOINC) V2.14 Update Implementation "
^DIC(9.4,14,22,5.9,"PAH",233,1,213,0)="Guide Patch LR*5.2*334 Version 5.2 - stored in a BINARY format."
^DIC(9.4,14,22,5.9,"PAH",233,1,214,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,215,0)="All files can be obtained from the following Office of Information "
^DIC(9.4,14,22,5.9,"PAH",233,1,216,0)="Field Offices (OIFOs) ANONYMOUS SOFTWARE directories. All sites are "
^DIC(9.4,14,22,5.9,"PAH",233,1,217,0)="encouraged to use the File Transfer Protocol (FTP) capability. Use the "
^DIC(9.4,14,22,5.9,"PAH",233,1,218,0)="FTP address ""download.vista.domain.ext"" (without the quotes) to connect  "
^DIC(9.4,14,22,5.9,"PAH",233,1,219,0)="to the first available FTP server were the files are located."
^DIC(9.4,14,22,5.9,"PAH",233,1,220,0)="OIFO         FTP Address                Directory"
^DIC(9.4,14,22,5.9,"PAH",233,1,221,0)="Albany       ftp.fo-albany.domain.ext   anonymous.software "
^DIC(9.4,14,22,5.9,"PAH",233,1,222,0)="Hines        ftp.fo-hines.domain.ext    anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",233,1,223,0)="Salt Lake    ftp.fo-slc.domain.ext      anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",233,1,224,0)="  "
^DIC(9.4,14,22,5.9,"PAH",233,1,225,0)="All users may remain on the system. Installation time is less than 30 "
^DIC(9.4,14,22,5.9,"PAH",233,1,226,0)="minutes."
^DIC(9.4,14,22,5.9,"PAH",233,1,227,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,228,0)="Note: The patch should be installed during off peak hours."
^DIC(9.4,14,22,5.9,"PAH",233,1,229,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,230,0)="No laboratory background jobs need to be stopped. No options need to be "
^DIC(9.4,14,22,5.9,"PAH",233,1,231,0)="placed out of service."
^DIC(9.4,14,22,5.9,"PAH",233,1,232,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,233,0)="LABORATORY USERS MUST NOT ACCESSION SPECIMENS OR ENTER/VERIFY RESULTS"
^DIC(9.4,14,22,5.9,"PAH",233,1,234,0)="DURING THE INSTALLATION because several reference files are being deleted "
^DIC(9.4,14,22,5.9,"PAH",233,1,235,0)="and replaced with this patch."
^DIC(9.4,14,22,5.9,"PAH",233,1,236,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,237,0)="============================                           "
^DIC(9.4,14,22,5.9,"PAH",233,1,238,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,239,0)="From the Kernel Installation & Distribution System (KIDS) menu "
^DIC(9.4,14,22,5.9,"PAH",233,1,240,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,241,0)="         1. Use the 'Load a Distribution' option to load the "
^DIC(9.4,14,22,5.9,"PAH",233,1,242,0)="            LR_52_334.KID file onto your system."
^DIC(9.4,14,22,5.9,"PAH",233,1,243,0)="         2. The patch has now been loaded into a Transport global"
^DIC(9.4,14,22,5.9,"PAH",233,1,244,0)="            on your system. You now need to use KIDS to install"
^DIC(9.4,14,22,5.9,"PAH",233,1,245,0)="            the Transport global."
^DIC(9.4,14,22,5.9,"PAH",233,1,246,0)="            On the KIDS menu, under the 'Installation' menu, use "
^DIC(9.4,14,22,5.9,"PAH",233,1,247,0)="            the following options:"
^DIC(9.4,14,22,5.9,"PAH",233,1,248,0)="                Print Transport Global "
^DIC(9.4,14,22,5.9,"PAH",233,1,249,0)="                Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",233,1,250,0)="                Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",233,1,251,0)="                Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",233,1,252,0)="         3. Users may remain on the system, but installation "
^DIC(9.4,14,22,5.9,"PAH",233,1,253,0)="            should be done at off peak hours."
^DIC(9.4,14,22,5.9,"PAH",233,1,254,0)="         4. Installation time is less than 30 minutes during off "
^DIC(9.4,14,22,5.9,"PAH",233,1,255,0)="            peak hours and less than 45 minutes during peak hours."
^DIC(9.4,14,22,5.9,"PAH",233,1,256,0)="         5. Installation of this patch requires no additional "
^DIC(9.4,14,22,5.9,"PAH",233,1,257,0)="            memory space."
^DIC(9.4,14,22,5.9,"PAH",233,1,258,0)="         6. From the 'Installation Menu' of the KIDS menu, run the "
^DIC(9.4,14,22,5.9,"PAH",233,1,259,0)="            option"
^DIC(9.4,14,22,5.9,"PAH",233,1,260,0)="            'Install Package(s)' Select the package 'LR*5.2*334' "
^DIC(9.4,14,22,5.9,"PAH",233,1,261,0)="            and proceed with the install."
^DIC(9.4,14,22,5.9,"PAH",233,1,262,0)="          7. Want KIDS to Rebuild Menu Trees Upon Completion of Install? "
^DIC(9.4,14,22,5.9,"PAH",233,1,263,0)="             YES// respond 'YES'"
^DIC(9.4,14,22,5.9,"PAH",233,1,264,0)=" "
