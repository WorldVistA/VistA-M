^DIC(9.4,4,22,1,"PAH",157,1,57,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",157,1,58,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",157,1,59,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",158,0)="188 SEQ #183^3010608^1"
^DIC(9.4,4,22,1,"PAH",158,1,0)="^^56^56^3010608"
^DIC(9.4,4,22,1,"PAH",158,1,1,0)="Patch XM*7.1*188"
^DIC(9.4,4,22,1,"PAH",158,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",158,1,3,0)="NOIS: WIC-0501-42618"
^DIC(9.4,4,22,1,"PAH",158,1,4,0)="Test Site:  Wichita, KS"
^DIC(9.4,4,22,1,"PAH",158,1,5,0)="MailMan makes a filtered broadcast message new, even though DELIVER NEW?"
^DIC(9.4,4,22,1,"PAH",158,1,6,0)="is set to NO in the filter.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",158,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",158,1,8,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",158,1,9,0)="is at a minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",158,1,10,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",158,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",158,1,12,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",158,1,13,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",158,1,14,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",158,1,15,0)=" "
^DIC(9.4,4,22,1,"PAH",158,1,16,0)="             Before       After"
^DIC(9.4,4,22,1,"PAH",158,1,17,0)="Name         Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",158,1,18,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",158,1,19,0)="XMXUTIL2      7762911      7760090     50,188"
^DIC(9.4,4,22,1,"PAH",158,1,20,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",158,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",158,1,22,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",158,1,23,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",158,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",158,1,25,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",158,1,26,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",158,1,27,0)="is at a minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",158,1,28,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",158,1,29,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",158,1,30,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",158,1,31,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",158,1,32,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",158,1,33,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",158,1,34,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",158,1,35,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",158,1,36,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",158,1,37,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",158,1,38,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",158,1,39,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",158,1,40,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",158,1,41,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",158,1,42,0)=" Select INSTALL NAME:    XM*7.1*188    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",158,1,43,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",158,1,44,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",158,1,45,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",158,1,46,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",158,1,47,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",158,1,48,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",158,1,49,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",158,1,50,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",158,1,51,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",158,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",158,1,53,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",158,1,54,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",158,1,55,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",158,1,56,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",159,0)="189 SEQ #184^3010625^1"
^DIC(9.4,4,22,1,"PAH",159,1,0)="^^60^60^3010625"
^DIC(9.4,4,22,1,"PAH",159,1,1,0)="Patch XM*7.1*189"
^DIC(9.4,4,22,1,"PAH",159,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",159,1,3,0)="NOIS: HUN-1100-22076, ALB-0301-52954, CTX-0401-70603"
^DIC(9.4,4,22,1,"PAH",159,1,4,0)="Test Site:  "
^DIC(9.4,4,22,1,"PAH",159,1,5,0)="Sometimes, when a user is editing a reply in one MailMan session, and then"
^DIC(9.4,4,22,1,"PAH",159,1,6,0)="starts a second MailMan session, the reply message stub is killed by the"
^DIC(9.4,4,22,1,"PAH",159,1,7,0)="second session.  When the user returns to the first session and sends the"
^DIC(9.4,4,22,1,"PAH",159,1,8,0)="reply, the reply appears to be from ""* No Name *"".  This patch detects when"
^DIC(9.4,4,22,1,"PAH",159,1,9,0)="the stub has been killed, and recreates it."
^DIC(9.4,4,22,1,"PAH",159,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",159,1,11,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",159,1,12,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",159,1,13,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",159,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",159,1,15,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",159,1,16,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",159,1,17,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",159,1,18,0)=" "
^DIC(9.4,4,22,1,"PAH",159,1,19,0)="             Before       After"
^DIC(9.4,4,22,1,"PAH",159,1,20,0)="Name         Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",159,1,21,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",159,1,22,0)="XMJMR        20504072     20744645     50,107,127,189"
^DIC(9.4,4,22,1,"PAH",159,1,23,0)="XMJMS         5873945      6300984     50,120,130,189"
^DIC(9.4,4,22,1,"PAH",159,1,24,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",159,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",159,1,26,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",159,1,27,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",159,1,28,0)=" "
^DIC(9.4,4,22,1,"PAH",159,1,29,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",159,1,30,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",159,1,31,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",159,1,32,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",159,1,33,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",159,1,34,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",159,1,35,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",159,1,36,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",159,1,37,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",159,1,38,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",159,1,39,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",159,1,40,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",159,1,41,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",159,1,42,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",159,1,43,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",159,1,44,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",159,1,45,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",159,1,46,0)=" Select INSTALL NAME:    XM*7.1*189    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",159,1,47,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",159,1,48,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",159,1,49,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",159,1,50,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",159,1,51,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",159,1,52,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",159,1,53,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",159,1,54,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",159,1,55,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",159,1,56,0)=""
^DIC(9.4,4,22,1,"PAH",159,1,57,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",159,1,58,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",159,1,59,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",159,1,60,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",160,0)="179 SEQ #185^3010710^1"
^DIC(9.4,4,22,1,"PAH",160,1,0)="^^186^186^3010710"
^DIC(9.4,4,22,1,"PAH",160,1,1,0)="Patch XM*7.1*179"
^DIC(9.4,4,22,1,"PAH",160,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,3,0)="E3R 15242"
^DIC(9.4,4,22,1,"PAH",160,1,4,0)="Test Sites:  Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",160,1,5,0)="Make tasked options XMCLEAN, XMAUTOPURGE, XMPURGE, and XMUT-CHKFIL honor"
^DIC(9.4,4,22,1,"PAH",160,1,6,0)="TaskMan stop requests."
^DIC(9.4,4,22,1,"PAH",160,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,8,0)="Improve the description for options XMCLEAN, XMAUTOPURGE, XMPURGE, XMSTAT,"
^DIC(9.4,4,22,1,"PAH",160,1,9,0)="and XMUT-CHKFIL.  Change option XMPURGE from an ""action"" type to a"
^DIC(9.4,4,22,1,"PAH",160,1,10,0)="""run routine"" type.  (Pre-init XMYPRE11 will help do this.)"
^DIC(9.4,4,22,1,"PAH",160,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,12,0)="Here, then, are the options:"
^DIC(9.4,4,22,1,"PAH",160,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,14,0)="NAME: XMCLEAN                           MENU TEXT: Clean out waste baskets"
^DIC(9.4,4,22,1,"PAH",160,1,15,0)="  TYPE: run routine                     CREATOR: POSTMASTER"
^DIC(9.4,4,22,1,"PAH",160,1,16,0)=" DESCRIPTION:   This option empties users' WASTE baskets, that is, it deletes"
^DIC(9.4,4,22,1,"PAH",160,1,17,0)=" all the messages in users' WASTE baskets in the MAILBOX file 3.7.  Messages in"
^DIC(9.4,4,22,1,"PAH",160,1,18,0)=" the MESSAGE file 3.9 are not affected.  "
^DIC(9.4,4,22,1,"PAH",160,1,19,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,20,0)=" It is recommended that this option be scheduled to run daily, right before"
^DIC(9.4,4,22,1,"PAH",160,1,21,0)=" option XMAUTOPURGE.  "
^DIC(9.4,4,22,1,"PAH",160,1,22,0)="  ROUTINE: CLEAN^XMA3                   SCHEDULING RECOMMENDED: YES"
^DIC(9.4,4,22,1,"PAH",160,1,23,0)="  UPPERCASE MENU TEXT: CLEAN OUT WASTE BASKETS"
^DIC(9.4,4,22,1,"PAH",160,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,26,0)="NAME: XMPURGE                           MENU TEXT: Purge Unreferenced Messages"
^DIC(9.4,4,22,1,"PAH",160,1,27,0)="  TYPE: run routine                     CREATOR: POSTMASTER"
^DIC(9.4,4,22,1,"PAH",160,1,28,0)=" DESCRIPTION:   This  option, if scheduled, does exactly what option"
^DIC(9.4,4,22,1,"PAH",160,1,29,0)=" XMAUTOPURGE does, and then stops.  "
^DIC(9.4,4,22,1,"PAH",160,1,30,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,31,0)=" This  option, if run interactively, does exactly what option XMAUTOPURGE does,"
^DIC(9.4,4,22,1,"PAH",160,1,32,0)=" and then it does exactly what option XMSTAT does, and then it stops.  "
^DIC(9.4,4,22,1,"PAH",160,1,33,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,34,0)=" You should NOT schedule this option.  "
^DIC(9.4,4,22,1,"PAH",160,1,35,0)="  ROUTINE: SCAN^XMA3"
^DIC(9.4,4,22,1,"PAH",160,1,36,0)="  UPPERCASE MENU TEXT: PURGE UNREFERENCED MESSAGES"
^DIC(9.4,4,22,1,"PAH",160,1,37,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,38,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,39,0)="NAME: XMAUTOPURGE"
^DIC(9.4,4,22,1,"PAH",160,1,40,0)="  MENU TEXT: Automatic Purge of MailMan Messages"
^DIC(9.4,4,22,1,"PAH",160,1,41,0)="  TYPE: run routine                     CREATOR: POSTMASTER"
^DIC(9.4,4,22,1,"PAH",160,1,42,0)=" DESCRIPTION:   This option automatically purges unreferenced MailMan messages,"
^DIC(9.4,4,22,1,"PAH",160,1,43,0)=" that is, it deletes from file 3.9, MESSAGE, any messages which are not in "
^DIC(9.4,4,22,1,"PAH",160,1,44,0)=" anyone's basket.  It is strongly recommended that this option be scheduled to"
^DIC(9.4,4,22,1,"PAH",160,1,45,0)=" run daily, right after option XMCLEAN.  "
^DIC(9.4,4,22,1,"PAH",160,1,46,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,47,0)=" The following messages are considered 'referenced', and will not be purged: "
^DIC(9.4,4,22,1,"PAH",160,1,48,0)="  - Messages in user baskets "
^DIC(9.4,4,22,1,"PAH",160,1,49,0)="  - Messages in transit (arriving or being sent) "
^DIC(9.4,4,22,1,"PAH",160,1,50,0)="  - Server messages "
^DIC(9.4,4,22,1,"PAH",160,1,51,0)="  - Messages being edited (including aborted edits) "
^DIC(9.4,4,22,1,"PAH",160,1,52,0)="  - Messages which have been latered "
^DIC(9.4,4,22,1,"PAH",160,1,53,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,54,0)=" Several fields in file 4.3, MAILMAN SITE PARAMETERS, influence the behavior of"
^DIC(9.4,4,22,1,"PAH",160,1,55,0)=" this option.  Here they are, but feel free to look at their Data Dictionary"
^DIC(9.4,4,22,1,"PAH",160,1,56,0)=" descriptions for more information on them: "
^DIC(9.4,4,22,1,"PAH",160,1,57,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,58,0)=" 4.301 - NO-PURGE DAYS BUFFER - MailMan does not purge any messages created or"
^DIC(9.4,4,22,1,"PAH",160,1,59,0)=" received in the last few days.  You choose how many days.  The default is 2.  "
^DIC(9.4,4,22,1,"PAH",160,1,60,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,61,0)=" 142   - NO-PURGE DAYS BUFFER (LOCAL) - MailMan does not purge local messages"
^DIC(9.4,4,22,1,"PAH",160,1,62,0)=" created in the last few days.  You choose how many days.  The default is 7.  "
^DIC(9.4,4,22,1,"PAH",160,1,63,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,64,0)=" 4.304 - WEEKDAY DAYS TO PURGE - On Saturdays, MailMan goes through the entire"
^DIC(9.4,4,22,1,"PAH",160,1,65,0)=" MESSAGE file looking for messages to purge.  On the other days of the week,"
^DIC(9.4,4,22,1,"PAH",160,1,66,0)=" however, MailMan has the option of only looking at messages created or"
^DIC(9.4,4,22,1,"PAH",160,1,67,0)=" received recently.  You choose how many days.  The default is to go through"
^DIC(9.4,4,22,1,"PAH",160,1,68,0)=" the entire MESSAGE file.  It is strongly recommended that you set this field"
^DIC(9.4,4,22,1,"PAH",160,1,69,0)=" to something reasonable, like 30 to 60 days.  (But only if you follow the"
^DIC(9.4,4,22,1,"PAH",160,1,70,0)=" recommendation to schedule this option to run daily.  Otherwise leave this"
^DIC(9.4,4,22,1,"PAH",160,1,71,0)=" field blank.) "
^DIC(9.4,4,22,1,"PAH",160,1,72,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,73,0)=" 4.303 - AUTOMATIC INTEGRITY CHECK - MailMan gives you the option of running"
^DIC(9.4,4,22,1,"PAH",160,1,74,0)=" the MAILBOX file portion of the integrity checker (option XMUT-CHKFIL) before"
^DIC(9.4,4,22,1,"PAH",160,1,75,0)=" it actually purges the unreferenced messages.  The M xref on file 3.7 is used"
^DIC(9.4,4,22,1,"PAH",160,1,76,0)=" to determine whether a message is referenced (in someone's basket) or not.  If"
^DIC(9.4,4,22,1,"PAH",160,1,77,0)=" the M xref is messed up, then the purge might delete messages it shouldn't, or"
^DIC(9.4,4,22,1,"PAH",160,1,78,0)=" leave message it should delete.  The integrity checker ensures that the M xref"
^DIC(9.4,4,22,1,"PAH",160,1,79,0)=" is correct.  You choose whether to run it or not.  The default is to run it. "
^DIC(9.4,4,22,1,"PAH",160,1,80,0)=" The recommendation is to run it.  However, if you find that it is simply"
^DIC(9.4,4,22,1,"PAH",160,1,81,0)=" taking too long, you may opt not to run it.  If you opt not to run it, then it"
^DIC(9.4,4,22,1,"PAH",160,1,82,0)=" is recommended that you schedule option XMUT-CHKFIL to run monthly, because"
^DIC(9.4,4,22,1,"PAH",160,1,83,0)=" globals can and do become corrupted.  "
^DIC(9.4,4,22,1,"PAH",160,1,84,0)="  INDEPENDENTLY INVOCABLE: NO"
^DIC(9.4,4,22,1,"PAH",160,1,85,0)="  ROUTINE: EN^XMA3                      TIMESTAMP: 55536,32239"
^DIC(9.4,4,22,1,"PAH",160,1,86,0)="  TIMESTAMP OF PRIMARY MENU: 54318,54986"
^DIC(9.4,4,22,1,"PAH",160,1,87,0)="  SCHEDULING RECOMMENDED: YES"
^DIC(9.4,4,22,1,"PAH",160,1,88,0)="  UPPERCASE MENU TEXT: AUTOMATIC PURGE OF MAILMAN MES"
^DIC(9.4,4,22,1,"PAH",160,1,89,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,90,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,91,0)="NAME: XMSTAT                            MENU TEXT: Message statistics"
^DIC(9.4,4,22,1,"PAH",160,1,92,0)="  TYPE: run routine                     CREATOR: POSTMASTER"
^DIC(9.4,4,22,1,"PAH",160,1,93,0)="  PACKAGE: MAILMAN"
^DIC(9.4,4,22,1,"PAH",160,1,94,0)=" DESCRIPTION:   This interactive option displays information about past purges"
^DIC(9.4,4,22,1,"PAH",160,1,95,0)=" and about current mailbox usage.  This option should not be scheduled.  "
^DIC(9.4,4,22,1,"PAH",160,1,96,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,97,0)=" First, it displays the types and results of the last 20 purges of the MESSAGE"
^DIC(9.4,4,22,1,"PAH",160,1,98,0)=" file 3.9.  It tells you whether the purge was an unreferenced message purge"
^DIC(9.4,4,22,1,"PAH",160,1,99,0)=" (option XMPURGE or XMAUTOPURGE), or a date purge (option XMPURGE-BY-DATE).  It"
^DIC(9.4,4,22,1,"PAH",160,1,100,0)=" tells you when it started and ended, how long it took, how many messages were"
^DIC(9.4,4,22,1,"PAH",160,1,101,0)=" purged, and how many were left.  "
^DIC(9.4,4,22,1,"PAH",160,1,102,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,103,0)=" Next, it displays information about each user in the MESSAGE file 3.7.  It"
^DIC(9.4,4,22,1,"PAH",160,1,104,0)=" tells you how many messages they have in their mailboxes, when they last"
^DIC(9.4,4,22,1,"PAH",160,1,105,0)=" logged on, and when they last used MailMan.  "
^DIC(9.4,4,22,1,"PAH",160,1,106,0)="  ROUTINE: STAT^XMA3                    UPPERCASE MENU TEXT: MESSAGE STATISTICS"
^DIC(9.4,4,22,1,"PAH",160,1,107,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,108,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,109,0)="NAME: XMUT-CHKFIL"
^DIC(9.4,4,22,1,"PAH",160,1,110,0)="  MENU TEXT: Check MailMan Files for Errors"
^DIC(9.4,4,22,1,"PAH",160,1,111,0)="  TYPE: run routine                     CREATOR: BEUSCHEL,GARY"
^DIC(9.4,4,22,1,"PAH",160,1,112,0)="  LOCK: XUPROG                          PACKAGE: MAILMAN"
^DIC(9.4,4,22,1,"PAH",160,1,113,0)=" DESCRIPTION:   This option checks for and corrects errors in the MAILBOX file"
^DIC(9.4,4,22,1,"PAH",160,1,114,0)=" 3.7 and the MESSAGE file 3.9.  It checks important fields and cross"
^DIC(9.4,4,22,1,"PAH",160,1,115,0)=" references.  "
^DIC(9.4,4,22,1,"PAH",160,1,116,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,117,0)=" It is recommended that this option be run monthly or every few months, or"
^DIC(9.4,4,22,1,"PAH",160,1,118,0)=" whenever there seems to be a database problem.  "
^DIC(9.4,4,22,1,"PAH",160,1,119,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,120,0)=" It produces a report of the errors detected, and what, if anything, it did to"
^DIC(9.4,4,22,1,"PAH",160,1,121,0)=" fix them.  If it didn't fix them, it tells you what you can do to fix them.  "
^DIC(9.4,4,22,1,"PAH",160,1,122,0)="  "
^DIC(9.4,4,22,1,"PAH",160,1,123,0)=" Although the system will not fail because of errors detected, your users may"
^DIC(9.4,4,22,1,"PAH",160,1,124,0)=" call you about the problems they experience.  This utility will allow you to"
^DIC(9.4,4,22,1,"PAH",160,1,125,0)=" detect them first and correct them before anyone knows.  "
^DIC(9.4,4,22,1,"PAH",160,1,126,0)="  ROUTINE: CHKFILES^XMUT4               SCHEDULING RECOMMENDED: YES"
^DIC(9.4,4,22,1,"PAH",160,1,127,0)="  UPPERCASE MENU TEXT: CHECK MAILMAN FILES FOR ERRORS"
^DIC(9.4,4,22,1,"PAH",160,1,128,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,129,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",160,1,130,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",160,1,131,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",160,1,132,0)=""
^DIC(9.4,4,22,1,"PAH",160,1,133,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",160,1,134,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",160,1,135,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",160,1,136,0)=" "
^DIC(9.4,4,22,1,"PAH",160,1,137,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",160,1,138,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",160,1,139,0)="------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",160,1,140,0)="XMA3          17147624        11956377        37,54,69,50,179"
^DIC(9.4,4,22,1,"PAH",160,1,141,0)="XMA30          7080895        10546676        37,50,179"
^DIC(9.4,4,22,1,"PAH",160,1,142,0)="XMUT4         13628025        13898092        50,74,108,179"
^DIC(9.4,4,22,1,"PAH",160,1,143,0)="XMUT41         5625084         6742163        108,179"
^DIC(9.4,4,22,1,"PAH",160,1,144,0)="XMUT4B        20142397            1683        50,108,179"
^DIC(9.4,4,22,1,"PAH",160,1,145,0)="XMUT4BA       16544870            2138        50,108,136,179"
^DIC(9.4,4,22,1,"PAH",160,1,146,0)="XMUT4C         7618380         8586474        10,22,50,108,136,177,179"
^DIC(9.4,4,22,1,"PAH",160,1,147,0)="XMYPRE11        687829          239841        163,179"
