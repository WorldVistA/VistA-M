^DIC(9.4,4,22,1,"PAH",113,0)="145 SEQ #138^3000824^1"
^DIC(9.4,4,22,1,"PAH",113,1,0)="^^63^63^3000824"
^DIC(9.4,4,22,1,"PAH",113,1,1,0)="Patch XM*7.1*145"
^DIC(9.4,4,22,1,"PAH",113,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",113,1,3,0)="NOIS: DUB-1299-32692"
^DIC(9.4,4,22,1,"PAH",113,1,4,0)="Test Sites:  Danville, IL; Dublin, GA"
^DIC(9.4,4,22,1,"PAH",113,1,5,0)="This patch prevents an abort which occurs when a user parks at the new"
^DIC(9.4,4,22,1,"PAH",113,1,6,0)="messages menu, starts up another session, reads all his new messages in"
^DIC(9.4,4,22,1,"PAH",113,1,7,0)="that other session, and then goes back to the original session and tries"
^DIC(9.4,4,22,1,"PAH",113,1,8,0)="to continue reading new messages."
^DIC(9.4,4,22,1,"PAH",113,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",113,1,10,0)="Also prevents the following error which may occur during logon and throw"
^DIC(9.4,4,22,1,"PAH",113,1,11,0)="the user off the system:"
^DIC(9.4,4,22,1,"PAH",113,1,12,0)="$ZERROR=NU+12^XMGAPI4:3, %DSM-E-UNDEF, undefined variable Y"
^DIC(9.4,4,22,1,"PAH",113,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",113,1,14,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",113,1,15,0)="is at a minimum.  It requires MailMan patch XM*7.1*140."
^DIC(9.4,4,22,1,"PAH",113,1,16,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",113,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",113,1,18,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",113,1,19,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",113,1,20,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",113,1,21,0)=" "
