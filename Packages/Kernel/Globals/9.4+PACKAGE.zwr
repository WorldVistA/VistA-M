^DIC(9.4,4,22,1,"PAH",123,1,53,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",123,1,54,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",123,1,55,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",123,1,56,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",124,0)="151 SEQ #149^3001106^1"
^DIC(9.4,4,22,1,"PAH",124,1,0)="^^75^75^3001106"
^DIC(9.4,4,22,1,"PAH",124,1,1,0)="Patch XM*7.1*151"
^DIC(9.4,4,22,1,"PAH",124,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,3,0)="NOIS: LOM-0800-63083"
^DIC(9.4,4,22,1,"PAH",124,1,4,0)="Test Site:  Loma Linda, CA"
^DIC(9.4,4,22,1,"PAH",124,1,5,0)="If two (or more) people are signed on as the same user (either normally"
^DIC(9.4,4,22,1,"PAH",124,1,6,0)="or as a surrogate) and they forward the same message at the same time,"
^DIC(9.4,4,22,1,"PAH",124,1,7,0)="it is possible that one forward clobbers the others, and the others won't"
^DIC(9.4,4,22,1,"PAH",124,1,8,0)="be delivered.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",124,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,10,0)="Also, this patch includes routine XMTDL2, to correct line 2 in patch"
^DIC(9.4,4,22,1,"PAH",124,1,11,0)="XM*7.1*150.  The code is unchanged."
^DIC(9.4,4,22,1,"PAH",124,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,13,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",124,1,14,0)="is at a minimum.  It requires MailMan patches XM*7.1*147 and XM*7.1*150."
^DIC(9.4,4,22,1,"PAH",124,1,15,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",124,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,17,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",124,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",124,1,19,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",124,1,20,0)=" "
^DIC(9.4,4,22,1,"PAH",124,1,21,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",124,1,22,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",124,1,23,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",124,1,24,0)="XMKP          16261814        16277893        50,89,119,147,151"
^DIC(9.4,4,22,1,"PAH",124,1,25,0)="XMTDL         18718545        18831179        50,97,142,151"
^DIC(9.4,4,22,1,"PAH",124,1,26,0)="XMTDL2        10072873        10072873        50,127,150,151"
^DIC(9.4,4,22,1,"PAH",124,1,27,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",124,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,29,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",124,1,30,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",124,1,31,0)=" "
^DIC(9.4,4,22,1,"PAH",124,1,32,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",124,1,33,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",124,1,34,0)="is at a minimum.  It requires MailMan patches XM*7.1*147 and XM*7.1*150."
^DIC(9.4,4,22,1,"PAH",124,1,35,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",124,1,36,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",124,1,37,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",124,1,38,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",124,1,39,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",124,1,40,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,1,"PAH",124,1,41,0)="    but you should stop the background filer."
^DIC(9.4,4,22,1,"PAH",124,1,42,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",124,1,43,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",124,1,44,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",124,1,45,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",124,1,46,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",124,1,47,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",124,1,48,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",124,1,49,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",124,1,50,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",124,1,51,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",124,1,52,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",124,1,53,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",124,1,54,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",124,1,55,0)=" Select INSTALL NAME:    XM*7.1*151     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",124,1,56,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",124,1,57,0)=" Install Questions for XM*7.1*151"
^DIC(9.4,4,22,1,"PAH",124,1,58,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,59,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",124,1,60,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",124,1,61,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",124,1,62,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",124,1,63,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",124,1,64,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",124,1,65,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",124,1,66,0)=""
^DIC(9.4,4,22,1,"PAH",124,1,67,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,1,"PAH",124,1,68,0)="                ------------------"
^DIC(9.4,4,22,1,"PAH",124,1,69,0)="6.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",124,1,70,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",124,1,71,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",124,1,72,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",124,1,73,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",124,1,74,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",124,1,75,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",125,0)="156 SEQ #150^3001106^1"
^DIC(9.4,4,22,1,"PAH",125,1,0)="^^57^57^3001106"
^DIC(9.4,4,22,1,"PAH",125,1,1,0)="Patch XM*7.1*156"
^DIC(9.4,4,22,1,"PAH",125,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",125,1,3,0)="NOIS: BAY-1000-32222"
^DIC(9.4,4,22,1,"PAH",125,1,4,0)="Test Sites:  BAY PINES, FL"
^DIC(9.4,4,22,1,"PAH",125,1,5,0)="If a user enters an incomplete date for a message vaporize date, assume"
^DIC(9.4,4,22,1,"PAH",125,1,6,0)="the future, not the past.  Also, if the user is entering a vaporize date"
^DIC(9.4,4,22,1,"PAH",125,1,7,0)="for a new message, the vaporize date be no earlier than tomorrow."
^DIC(9.4,4,22,1,"PAH",125,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",125,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",125,1,10,0)="is at a minimum.  It requires MailMan patch XM*7.1*131."
^DIC(9.4,4,22,1,"PAH",125,1,11,0)="============================================================================ "
