^DIC(9.4,93,22,21,"PAH",181,1,0)="^^2^2^3210420"
^DIC(9.4,93,22,21,"PAH",181,1,1,0)="This patch will update the SPECIAL CONSIDERATIONS (#396.25) file by "
^DIC(9.4,93,22,21,"PAH",181,1,2,0)="adding a new Special Consideration reason 'VICAP'."
^DIC(9.4,93,22,21,"PAH",182,0)="229b^3210518"
^DIC(9.4,93,22,21,"PAH",182,1,0)="^^5^5^3210518"
