^DIC(9.4,35,22,3,"PAH",360,1,87,0)="New Service Requests (NSRs)"
^DIC(9.4,35,22,3,"PAH",360,1,88,0)="----------------------------"
^DIC(9.4,35,22,3,"PAH",360,1,89,0)="NSR 20131108 REMOVE LISTMANAGER RESTRICTIONS ON MNEMONICS"
^DIC(9.4,35,22,3,"PAH",360,1,90,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,91,0)="Patient Safety Issues (PSIs)"
^DIC(9.4,35,22,3,"PAH",360,1,92,0)="-----------------------------"
^DIC(9.4,35,22,3,"PAH",360,1,93,0)="N/A"
^DIC(9.4,35,22,3,"PAH",360,1,94,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,95,0)="Remedy Ticket(s) & Overview"
^DIC(9.4,35,22,3,"PAH",360,1,96,0)="---------------------------"
^DIC(9.4,35,22,3,"PAH",360,1,97,0)="N/A"
^DIC(9.4,35,22,3,"PAH",360,1,98,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,99,0)="Problem:"
^DIC(9.4,35,22,3,"PAH",360,1,100,0)="--------"
^DIC(9.4,35,22,3,"PAH",360,1,101,0)="With the switch to using CPRS GUI Order Menus rather than ListManager "
^DIC(9.4,35,22,3,"PAH",360,1,102,0)="ordering menu options, there remains a limitation on the characters "
^DIC(9.4,35,22,3,"PAH",360,1,103,0)="allowed to build menu items.  Specifically, the equal sign (=), comma "
^DIC(9.4,35,22,3,"PAH",360,1,104,0)="(,), semi-colon (;), and hyphen (-) are restricted when they do not need "
^DIC(9.4,35,22,3,"PAH",360,1,105,0)="to be."
^DIC(9.4,35,22,3,"PAH",360,1,106,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,107,0)="Resolution:"
^DIC(9.4,35,22,3,"PAH",360,1,108,0)="-----------"
^DIC(9.4,35,22,3,"PAH",360,1,109,0)="Remove the restrictions on certain special characters by modifying the "
^DIC(9.4,35,22,3,"PAH",360,1,110,0)="CHKNAM tag inside the ORUTL routine in order to remove the restriction "
^DIC(9.4,35,22,3,"PAH",360,1,111,0)="for the characters stated above.  The up-arrow (^) still remains as a "
^DIC(9.4,35,22,3,"PAH",360,1,112,0)="restricted character because of M (MUMPS) restrictions."
^DIC(9.4,35,22,3,"PAH",360,1,113,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,114,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",360,1,115,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,116,0)="Hunter Holmes McGuire VA Medical Center (Richmond)"
^DIC(9.4,35,22,3,"PAH",360,1,117,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,118,0)="Orlando VA Medical Center"
^DIC(9.4,35,22,3,"PAH",360,1,119,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,120,0)="William S. Middleton Memorial Veterans Hospital (Madison)"
^DIC(9.4,35,22,3,"PAH",360,1,121,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,122,0)="VA Central Plains Health Care System (Omaha, Lincoln, Grand Island of NE, "
^DIC(9.4,35,22,3,"PAH",360,1,123,0)="Des Moines, Knoxville, Iowa City of IA)"
^DIC(9.4,35,22,3,"PAH",360,1,124,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,125,0)=" "
