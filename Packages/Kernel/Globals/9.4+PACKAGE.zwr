^DIC(9.4,4,22,1,"PAH",90,1,3,0)="NOIS: MAD-0100-42586"
^DIC(9.4,4,22,1,"PAH",90,1,4,0)="Test Site:  Madison, WI"
^DIC(9.4,4,22,1,"PAH",90,1,5,0)="Change the option XMMGR-TERMINATE-SUGGEST."
^DIC(9.4,4,22,1,"PAH",90,1,6,0)="Instead of reporting on users who have never logged on, only report on such"
^DIC(9.4,4,22,1,"PAH",90,1,7,0)="users if they were added before the IRM-supplied cutoff date. "
