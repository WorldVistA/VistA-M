^DIC(9.4,96,22,1.2,"PAH",36,1,41,0)=" PRIMARY FEE PROVIDER (.11)     DENTAL PATIENT (220)"
^DIC(9.4,96,22,1.2,"PAH",36,1,42,0)=" SECONDARY FEE PROVIDER (.12)   DENTAL PATIENT (220)"
^DIC(9.4,96,22,1.2,"PAH",36,1,43,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,44,0)=" Below is a list of the files related to this patch that will be needed "
