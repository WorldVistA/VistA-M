^DIC(9.4,141,22,2,"PAH",1,1,1,0)="Delete obsolete Incident Reporting files.  Files in 742 file number range"
^DIC(9.4,141,22,2,"PAH",1,1,2,0)="now being used."
^DIC(9.4,141,22,2,"PAH",2,0)="25^2980318^1"
^DIC(9.4,141,22,2,"PAH",3,0)="27 SEQ #26^2990803^1"
^DIC(9.4,141,22,2,"PAH",4,0)="26 SEQ #27^2991210^1"
^DIC(9.4,141,22,2,"PAH",5,0)="28 SEQ #28^3000204^1"
^DIC(9.4,141,22,2,"PAH",6,0)="29 SEQ #29^3001004^1"
^DIC(9.4,141,22,2,"PAH",7,0)="30 SEQ #30^3030924^1"
^DIC(9.4,141,22,2,"PAH",7,1,0)="^^1^1^3030924"
^DIC(9.4,141,22,2,"PAH",7,1,1,0)="PROBLEM ADDING SECOND PATIENT"
^DIC(9.4,141,22,2,"PAH",8,0)="31 SEQ #31^3031231^1"
^DIC(9.4,141,22,2,"PAH",8,1,0)="^^1^1^3031231"
^DIC(9.4,141,22,2,"PAH",8,1,1,0)="Incident reports not printing."
^DIC(9.4,141,22,2,"PAH",9,0)="32 SEQ #32^3070905.005803^1"
^DIC(9.4,141,22,2,"PAH",9,1,0)="^^1^1^3070905"
^DIC(9.4,141,22,2,"PAH",9,1,1,0)="Patient ID fix"
^DIC(9.4,141,22,2,"PAH",10,0)="33 SEQ #33^3130531.101846^17"
^DIC(9.4,141,22,2,"PAH",10,1,0)="^^11^11^3130531"
^DIC(9.4,141,22,2,"PAH",10,1,1,0)=" This patch addresses 2 issues:"
^DIC(9.4,141,22,2,"PAH",10,1,2,0)=" "
^DIC(9.4,141,22,2,"PAH",10,1,3,0)="1.  A subscript error appears when scheduled auto email options are "
^DIC(9.4,141,22,2,"PAH",10,1,4,0)="run and entries in the QA INCIDENT REPORT (#742.4) file with a LOCAL CASE "
^DIC(9.4,141,22,2,"PAH",10,1,5,0)="STATUS (#.09) of ""CLOSED"", ""DELETED, or ""QUICK"" have no value for the "
^DIC(9.4,141,22,2,"PAH",10,1,6,0)="INCIDENT (#.02). "
^DIC(9.4,141,22,2,"PAH",10,1,7,0)=" "
^DIC(9.4,141,22,2,"PAH",10,1,8,0)="2.  A subscript error occurs when accessing the 'Full Incident Edit' [QAN "
^DIC(9.4,141,22,2,"PAH",10,1,9,0)="INCIDENT FOLLOW-UP] option and then using a question mark '?' to view a "
^DIC(9.4,141,22,2,"PAH",10,1,10,0)="a list of existing open cases by 'Case Number', 'Date of Incident' or "
^DIC(9.4,141,22,2,"PAH",10,1,11,0)="'Patient'."
^DIC(9.4,141,22,2,"PAH",11,0)="34 SEQ #34^3181102.155215^54"
^DIC(9.4,141,22,2,"PAH",11,1,0)="^^2^2^3181102"
^DIC(9.4,141,22,2,"PAH",11,1,1,0)="This patch marks MENU options ""Disabled-USE Joint Patient Safety "
^DIC(9.4,141,22,2,"PAH",11,1,2,0)="Reporting-JPSR"" as requested by the VHANCPS JPSR TEAM."
^DIC(9.4,141,22,2,"PAH",12,0)="35 SEQ #35^3241219.135033^89"
^DIC(9.4,141,22,2,"PAH",12,1,0)="^^2^2^3241219"
^DIC(9.4,141,22,2,"PAH",12,1,1,0)="DECOMMISSION INCIDENT REPORTING PACKAGE - REMOVE ALL FILES, ROUTINES, "
^DIC(9.4,141,22,2,"PAH",12,1,2,0)="TEMPLATES, ETC"
