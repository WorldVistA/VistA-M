^DIC(9.4,4,22,1,"PAH",61,1,97,0)="The only routine in this patch is a pre-init, which will kill the known"
^DIC(9.4,4,22,1,"PAH",61,1,98,0)="bogus xrefs:"
^DIC(9.4,4,22,1,"PAH",61,1,99,0)="K ^DD(3.9,0,""IX"",""I"")"
^DIC(9.4,4,22,1,"PAH",61,1,100,0)="K ^XMB(3.9,""I"")"
^DIC(9.4,4,22,1,"PAH",61,1,101,0)="K ^XMB(3.9,""Rxxxxxx"")"
