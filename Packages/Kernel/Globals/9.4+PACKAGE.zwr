^DIC(9.4,9,22,3.3,"PAH",17,1,58,0)="Protocol FHWD5 Removed From ORZ ADD ORDERS WARD CLERK                      "
^DIC(9.4,9,22,3.3,"PAH",17,1,59,0)="Protocol FHWN1 Removed From ORZ ADD ORDERS WARD CLERK NHCU                "
^DIC(9.4,9,22,3.3,"PAH",17,1,60,0)="Protocol FHWN2 Removed From ORZ ADD ORDERS WARD CLERK NHCU                 "
