^DIC(9.4,175,22,2,"PAH",30,1,0)="^^1^1^3060711"
^DIC(9.4,175,22,2,"PAH",30,1,1,0)="VistARad Patch 18 software."
^DIC(9.4,175,22,2,"PAH",31,0)="61^3060712^1"
^DIC(9.4,175,22,2,"PAH",31,1,0)="^^16^16^3060712"
^DIC(9.4,175,22,2,"PAH",31,1,1,0)="Imaging v3.0 Patch 61. VistA Imaging Index Term Maintenance"
^DIC(9.4,175,22,2,"PAH",31,1,2,0)="This patch is to provide the utility that will automatically "
^DIC(9.4,175,22,2,"PAH",31,1,3,0)="update the Imaging Index Files at all sites by processing a VistA "
^DIC(9.4,175,22,2,"PAH",31,1,4,0)="menu option. The Option will install updates to the Index Files that have"
^DIC(9.4,175,22,2,"PAH",31,1,5,0)="been sent via a MailMan message.  All updates installed will have been"
^DIC(9.4,175,22,2,"PAH",31,1,6,0)="approved by the VistA Imaging Index Term Review Board."
^DIC(9.4,175,22,2,"PAH",31,1,7,0)=" "
