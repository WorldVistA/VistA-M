^DIC(9.4,4,22,2,"PAH",2,1,93,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",2,1,94,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",2,1,95,0)=" Select INSTALL NAME:    XM*8.0*3     Loaded from Distribution  <date/time>"
