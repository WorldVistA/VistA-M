^DIC(9.4,73,22,9,"PAH",11,1,10,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",11,1,11,0)=" ============"
^DIC(9.4,73,22,9,"PAH",11,1,12,0)="    NOIS COA-0899-20344, TOM-0400-41371"
^DIC(9.4,73,22,9,"PAH",11,1,13,0)="    This patch corrects mismatch display.  NHE menu Option"
^DIC(9.4,73,22,9,"PAH",11,1,14,0)="    #6 (print by type) is not displaying some of the"
^DIC(9.4,73,22,9,"PAH",11,1,15,0)="    components due to the mismatch between the header and"
^DIC(9.4,73,22,9,"PAH",11,1,16,0)="    the entries from file 537015. This patch modified some"
^DIC(9.4,73,22,9,"PAH",11,1,17,0)="    entries in File# 537015 to correct the problem."
^DIC(9.4,73,22,9,"PAH",11,1,18,0)=" "
^DIC(9.4,73,22,9,"PAH",11,1,19,0)=" "
^DIC(9.4,73,22,9,"PAH",11,1,20,0)=" "
