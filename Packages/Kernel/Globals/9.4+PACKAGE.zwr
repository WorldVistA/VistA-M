^DIC(9.4,4,22,1,"PAH",150,0)="180 SEQ #175^3010529^1"
^DIC(9.4,4,22,1,"PAH",150,1,0)="^^58^58^3010529"
^DIC(9.4,4,22,1,"PAH",150,1,1,0)="Patch XM*7.1*180"
^DIC(9.4,4,22,1,"PAH",150,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",150,1,3,0)="NOIS ANN-0401-41468"
^DIC(9.4,4,22,1,"PAH",150,1,4,0)="Test Site: ANN-ARBOR, MI"
^DIC(9.4,4,22,1,"PAH",150,1,5,0)="A bogus message number at the end of the MESSAGE file 3.9 prevents the"
^DIC(9.4,4,22,1,"PAH",150,1,6,0)="option XMMGR-PURGE-MESSAGE from functioning properly and letting a user"
^DIC(9.4,4,22,1,"PAH",150,1,7,0)="select a message to purge.  This patch checks for and kills such bogus"
^DIC(9.4,4,22,1,"PAH",150,1,8,0)="message numbers, so that the purge selection functions properly."
^DIC(9.4,4,22,1,"PAH",150,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",150,1,10,0)="NOTE: This patch may be installed at any time, even during hours of peak"
^DIC(9.4,4,22,1,"PAH",150,1,11,0)="usage.  It requires MailMan patch XM*7.1*125."
^DIC(9.4,4,22,1,"PAH",150,1,12,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",150,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",150,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",150,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",150,1,16,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",150,1,17,0)=" "
