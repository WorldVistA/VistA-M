^DIC(9.4,47,22,5.9,"PAH",592,1,0)="^^5^5^3071212"
^DIC(9.4,47,22,5.9,"PAH",592,1,1,0)="This patch corrects the following:"
^DIC(9.4,47,22,5.9,"PAH",592,1,2,0)="Problem deleting PTF record when procedure has been deleted."
^DIC(9.4,47,22,5.9,"PAH",592,1,3,0)="SCI output on Registration view to show full value"
