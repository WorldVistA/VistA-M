^DIC(9.4,100,22,15,"PAH",37,1,69,0)="YSDATA(5)=R3^"
^DIC(9.4,100,22,15,"PAH",37,1,70,0)="YSDATA(6)=S1^Total^12^"
^DIC(9.4,100,22,15,"PAH",37,1,71,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,72,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,73,0)="2.  OUTNOTE"
^DIC(9.4,100,22,15,"PAH",37,1,74,0)="        RPC: YTAPI OUTNOTE"
^DIC(9.4,100,22,15,"PAH",37,1,75,0)="        M:   OUTNOTE^YTAPI5"
^DIC(9.4,100,22,15,"PAH",37,1,76,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,77,0)="This API returns text to be entered in a progress note based on the outcome "
^DIC(9.4,100,22,15,"PAH",37,1,78,0)="of a test administration.  Input is the output of SCOREIT or PREVIEW API. "
^DIC(9.4,100,22,15,"PAH",37,1,79,0)="Output adds this text to the output YSDATA."
^DIC(9.4,100,22,15,"PAH",37,1,80,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,81,0)="Input:"
^DIC(9.4,100,22,15,"PAH",37,1,82,0)="------ "
^DIC(9.4,100,22,15,"PAH",37,1,83,0)="Array(2)= Patient Name^Test Code^Test Title^Internal Admin date^External "
^DIC(9.4,100,22,15,"PAH",37,1,84,0)="Admin Date ^Ordered by"
^DIC(9.4,100,22,15,"PAH",37,1,85,0)="Array(3)=R1^Responses 1-200 undelimited"
^DIC(9.4,100,22,15,"PAH",37,1,86,0)="Array(4)=R2^ Responses 201-400 undelimited (even if less than 200)"
^DIC(9.4,100,22,15,"PAH",37,1,87,0)="Array(5)=R3^ Responses 401-600 undelimited"
^DIC(9.4,100,22,15,"PAH",37,1,88,0)="Array(6)=S1^Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",37,1,89,0)="Array(7)=S2^ Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",37,1,90,0)="             ."
^DIC(9.4,100,22,15,"PAH",37,1,91,0)="             ."
^DIC(9.4,100,22,15,"PAH",37,1,92,0)="   And onward as needed"
^DIC(9.4,100,22,15,"PAH",37,1,93,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,94,0)="Output:"
^DIC(9.4,100,22,15,"PAH",37,1,95,0)="-------"
^DIC(9.4,100,22,15,"PAH",37,1,96,0)="Array(2)= Patient Name^Test Code^Test Title^Internal Admin date^External "
^DIC(9.4,100,22,15,"PAH",37,1,97,0)="Admin Date ^Ordered by"
^DIC(9.4,100,22,15,"PAH",37,1,98,0)="Array(3)=R1^Responses 1-200 undelimited"
^DIC(9.4,100,22,15,"PAH",37,1,99,0)="Array(4)=R2^ Responses 201-400 undelimited (even if less than 200)"
^DIC(9.4,100,22,15,"PAH",37,1,100,0)="Array(5)=R3^ Responses 401-600 undelimited"
^DIC(9.4,100,22,15,"PAH",37,1,101,0)="Array(6)=S1^Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",37,1,102,0)="Array(7)=S2^ Scale Name^Raw Score^Transformed Score"
^DIC(9.4,100,22,15,"PAH",37,1,103,0)="            ."
^DIC(9.4,100,22,15,"PAH",37,1,104,0)="            ."
^DIC(9.4,100,22,15,"PAH",37,1,105,0)="   And onward as needed"
^DIC(9.4,100,22,15,"PAH",37,1,106,0)="Array(""ON"")= output text"
^DIC(9.4,100,22,15,"PAH",37,1,107,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,108,0)="Example:"
^DIC(9.4,100,22,15,"PAH",37,1,109,0)="--------"
^DIC(9.4,100,22,15,"PAH",37,1,110,0)="Input"
^DIC(9.4,100,22,15,"PAH",37,1,111,0)="-----"
^DIC(9.4,100,22,15,"PAH",37,1,112,0)="YSDATA(1)=[DATA]"
^DIC(9.4,100,22,15,"PAH",37,1,113,0)="YSDATA(2)=CAPP,ANDY W^MMPI2^--- ZUNG ---^2940509^05/09/1994^CAULFIELD,MARY A"
^DIC(9.4,100,22,15,"PAH",37,1,114,0)="YSDATA(3)=""12121212121212121212"""
^DIC(9.4,100,22,15,"PAH",37,1,115,0)="YSDATA(4)=R2^"
^DIC(9.4,100,22,15,"PAH",37,1,116,0)="YSDATA(5)=R3^"
^DIC(9.4,100,22,15,"PAH",37,1,117,0)="YSDATA(6)=S1^Total^12^"
^DIC(9.4,100,22,15,"PAH",37,1,118,0)="YSDATA(""ON"")= A mood disorder screening test (ZUNG) was in the low range "
^DIC(9.4,100,22,15,"PAH",37,1,119,0)="(score = 12)."
^DIC(9.4,100,22,15,"PAH",37,1,120,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,121,0)="The text and decision criteria is stored in MH MULTIPLE SCORING file (#601.6)"
^DIC(9.4,100,22,15,"PAH",37,1,122,0)="field RESULTS (#6), sub-field RESULTS TEXT (#2)."
^DIC(9.4,100,22,15,"PAH",37,1,123,0)="Example of text to be stored:"
^DIC(9.4,100,22,15,"PAH",37,1,124,0)="Test Code Score  Text"
^DIC(9.4,100,22,15,"PAH",37,1,125,0)="--------- -----  -----"
^DIC(9.4,100,22,15,"PAH",37,1,126,0)="AUDIT     <8     An alcohol screening test (AUDIT) was negative"
^DIC(9.4,100,22,15,"PAH",37,1,127,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,128,0)="          >7     An alcohol screening test (AUDIT) was positive"
^DIC(9.4,100,22,15,"PAH",37,1,129,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,130,0)="AUDC      <4     An alcohol screening test (AUDIT-C) was negative"
^DIC(9.4,100,22,15,"PAH",37,1,131,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,132,0)="          >3     An alcohol screening test (AUDIT-C) was positive"
^DIC(9.4,100,22,15,"PAH",37,1,133,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,134,0)="BDI       <10    The Beck Depression Inventory suggests minimal mood disorder"
^DIC(9.4,100,22,15,"PAH",37,1,135,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,136,0)="        10-16    The Beck Depression Inventory suggests mild mood disorder"
^DIC(9.4,100,22,15,"PAH",37,1,137,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,138,0)="        17-29    The Beck Depression Inventory suggests moderate mood disorder"
^DIC(9.4,100,22,15,"PAH",37,1,139,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,140,0)="          >29    The Beck Depression Inventory suggests severe mood disorder"
^DIC(9.4,100,22,15,"PAH",37,1,141,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,142,0)="CAGE      <2     An alcohol screening test (CAGE) was negative "
^DIC(9.4,100,22,15,"PAH",37,1,143,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,144,0)="          >1     An alcohol screening test (CAGE) was positive"
^DIC(9.4,100,22,15,"PAH",37,1,145,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,146,0)="DOM80            A mood disorder screening test (DOM80) was negative."
^DIC(9.4,100,22,15,"PAH",37,1,147,0)="                 A mood disorder screening test (DOM80) was positive."
^DIC(9.4,100,22,15,"PAH",37,1,148,0)="                 1. The DOM80 does not have a cut-off score.  Rather, the"
^DIC(9.4,100,22,15,"PAH",37,1,149,0)="                    algorithm is:"
^DIC(9.4,100,22,15,"PAH",37,1,150,0)="                   a. If Q1 returned = Y, then the test is positive."
^DIC(9.4,100,22,15,"PAH",37,1,151,0)="                   b. If Q2 returned = Y and Q3 = Y and Q4 > 1, then the test"
^DIC(9.4,100,22,15,"PAH",37,1,152,0)="                      is positive."
^DIC(9.4,100,22,15,"PAH",37,1,153,0)="                   c. If neither a nor b (above) is true, then the test is"
^DIC(9.4,100,22,15,"PAH",37,1,154,0)="                      negative."
^DIC(9.4,100,22,15,"PAH",37,1,155,0)="DOMG      <4     A mood disorder screening test (DOMG) was negative"
^DIC(9.4,100,22,15,"PAH",37,1,156,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,157,0)="          >3     A mood disorder screening test (DOMG) was positive"
^DIC(9.4,100,22,15,"PAH",37,1,158,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,159,0)="MISS      <107   This patient endorsed a significant number of items"
^DIC(9.4,100,22,15,"PAH",37,1,160,0)="                 associated with PTSD (MISS score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,161,0)="          >106   This patient endorsed fewer items associated with PTSD"
^DIC(9.4,100,22,15,"PAH",37,1,162,0)="                 than is commonly found in Vietnam veterans diagnosed with"
^DIC(9.4,100,22,15,"PAH",37,1,163,0)="                 PTSD (MISS score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,164,0)="SMAST     >2     Positive  screen for alcoholism."
^DIC(9.4,100,22,15,"PAH",37,1,165,0)="  6 or 10 or 11  Previous treatment for alcoholism reported."
^DIC(9.4,100,22,15,"PAH",37,1,166,0)="          <3     Negative  screen for alcoholism."
^DIC(9.4,100,22,15,"PAH",37,1,167,0)="ZUNG      <33    A mood disorder screening test (ZUNG) was in the low range"
^DIC(9.4,100,22,15,"PAH",37,1,168,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,169,0)="         33-50   A mood disorder screening test (ZUNG) was in the medium range"
^DIC(9.4,100,22,15,"PAH",37,1,170,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,171,0)="          >50    A mood disorder screening test (ZUNG) was in the high range"
^DIC(9.4,100,22,15,"PAH",37,1,172,0)="                 (score =|SCORE|)."
^DIC(9.4,100,22,15,"PAH",37,1,173,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,174,0)="Additional Information"
^DIC(9.4,100,22,15,"PAH",37,1,175,0)="----------------------"
^DIC(9.4,100,22,15,"PAH",37,1,176,0)="1. The AIMS progress note should have each item and each item response "
^DIC(9.4,100,22,15,"PAH",37,1,177,0)="included in the progress note.  Below is an example progress note created"
^DIC(9.4,100,22,15,"PAH",37,1,178,0)="using an AIMS test from file MH INSTRUMENTS (#601).  Note that the items are"
^DIC(9.4,100,22,15,"PAH",37,1,179,0)="separated by headings that are not in the item text, and that the first "
^DIC(9.4,100,22,15,"PAH",37,1,180,0)="5 lines contain the total score and the number of items rated mild, moderate"
^DIC(9.4,100,22,15,"PAH",37,1,181,0)="and severe."
^DIC(9.4,100,22,15,"PAH",37,1,182,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,183,0)="Example of an AIMS note"
^DIC(9.4,100,22,15,"PAH",37,1,184,0)="-----------------------"
^DIC(9.4,100,22,15,"PAH",37,1,185,0)="The patient was evaluated for symptoms of tardive dyskinesia using the "
^DIC(9.4,100,22,15,"PAH",37,1,186,0)="AIMS."
^DIC(9.4,100,22,15,"PAH",37,1,187,0)="  Total score for items 1-7:               8"
^DIC(9.4,100,22,15,"PAH",37,1,188,0)="  Number of items 1-7 rated ""mild"":        1"
^DIC(9.4,100,22,15,"PAH",37,1,189,0)="  Number of items 1-7 rated ""moderate"":    1"
^DIC(9.4,100,22,15,"PAH",37,1,190,0)="  Number of items 1-7 rated ""severe"":      1"
^DIC(9.4,100,22,15,"PAH",37,1,191,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,192,0)="Facial and oral movements:"
^DIC(9.4,100,22,15,"PAH",37,1,193,0)="  Muscles of facial expression                   Minimal"
^DIC(9.4,100,22,15,"PAH",37,1,194,0)="  Lips and perioral area                         Minimal"
^DIC(9.4,100,22,15,"PAH",37,1,195,0)="  Jaw                                            None"
^DIC(9.4,100,22,15,"PAH",37,1,196,0)="  Tongue                                         Moderate"
^DIC(9.4,100,22,15,"PAH",37,1,197,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,198,0)="Extremity movements:"
^DIC(9.4,100,22,15,"PAH",37,1,199,0)="  Upper (arms, wrists, hands, fingers)           Mild"
^DIC(9.4,100,22,15,"PAH",37,1,200,0)="  Lower (legs, knees, ankles, toes)              None"
^DIC(9.4,100,22,15,"PAH",37,1,201,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,202,0)="Trunk movements:"
^DIC(9.4,100,22,15,"PAH",37,1,203,0)="  Neck, shoulders, hips                          Minimal"
^DIC(9.4,100,22,15,"PAH",37,1,204,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,205,0)="Global judgments:"
^DIC(9.4,100,22,15,"PAH",37,1,206,0)="  Severity of abnormal movements                 Mild"
^DIC(9.4,100,22,15,"PAH",37,1,207,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,208,0)=""
