^DIC(9.4,48,22,5.28,"PAH",674,1,38,0)="VSE-8197: BF - VistA: Modify SDES2 CANCEL APPOINTMENT to check for a lock "
^DIC(9.4,48,22,5.28,"PAH",674,1,39,0)="          in the order vs the lock on the patient"
^DIC(9.4,48,22,5.28,"PAH",674,1,40,0)="          VSE-8221: FF - VS GUI: Add ""Other"" to SNAP"
^DIC(9.4,48,22,5.28,"PAH",674,1,41,0)="VSE-8281: BF - VistA: Fix an issue where SDEC APPDEL is sometimes causing"
