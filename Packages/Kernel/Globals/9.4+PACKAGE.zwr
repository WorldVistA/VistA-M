^DIC(9.4,163,22,1,"PAH",219,1,1,0)="Fix the following defects"
^DIC(9.4,163,22,1,"PAH",219,1,2,0)="HD 169774  UPDATE OF 8925.1 ""ACL"" INDEX"
^DIC(9.4,163,22,1,"PAH",219,1,3,0)="HD 71187 UNDEFINED STATUS+9^TIUR"
