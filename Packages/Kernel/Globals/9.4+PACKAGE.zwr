^DIC(9.4,14,22,5.9,"PAH",127,1,72,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",127,1,73,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",127,1,74,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",127,1,75,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",127,1,76,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",127,1,77,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,78,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",127,1,79,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",127,1,80,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",127,1,81,0)="   LR300            N/A            4452251        **300** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",127,1,82,0)="   LRRP2            15278779       13459970       **106,121,221,283,300**"
^DIC(9.4,14,22,5.9,"PAH",127,1,83,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,84,0)=" List of preceding patches: 283"
^DIC(9.4,14,22,5.9,"PAH",127,1,85,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",127,1,86,0)="  "
^DIC(9.4,14,22,5.9,"PAH",127,1,87,0)="************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",127,1,88,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,90,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",127,1,91,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",127,1,92,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,93,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",127,1,94,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",127,1,95,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",127,1,96,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,98,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",127,1,99,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",127,1,100,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,101,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",127,1,102,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",127,1,103,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,105,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",127,1,106,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,107,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",127,1,108,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",127,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,110,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",127,1,111,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",127,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,113,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",127,1,114,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",127,1,115,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,116,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",127,1,117,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",127,1,118,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",127,1,119,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",127,1,120,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",127,1,121,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,122,0)="  6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",127,1,123,0)="      and select the package 'LR*5.2*300.  When prompted 'Want KIDS to"
^DIC(9.4,14,22,5.9,"PAH",127,1,124,0)="      INHIBIT LOGONs during the install? YES//', choose 'NO'.  When prompted"
^DIC(9.4,14,22,5.9,"PAH",127,1,125,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,14,22,5.9,"PAH",127,1,126,0)="      YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",127,1,127,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,128,0)="      Note: KIDS will disable the following options during patch"
^DIC(9.4,14,22,5.9,"PAH",127,1,129,0)="      installation:"
^DIC(9.4,14,22,5.9,"PAH",127,1,130,0)="        Interim report [LRRP2]"
^DIC(9.4,14,22,5.9,"PAH",127,1,131,0)="        Interim report by provider [LRRD]"
^DIC(9.4,14,22,5.9,"PAH",127,1,132,0)="        Interim report for chosen tests [LRRP3]"
^DIC(9.4,14,22,5.9,"PAH",127,1,133,0)="        Interim report for selected tests as ordered [LRRSP]"
^DIC(9.4,14,22,5.9,"PAH",127,1,134,0)="        Interim reports by location (manual queue) [LRRS]"
^DIC(9.4,14,22,5.9,"PAH",127,1,135,0)="        Interim reports for 1 location (manual queue) [LRRS BY LOC]"
^DIC(9.4,14,22,5.9,"PAH",127,1,136,0)="        Interim reports for 1 provider (manual queue) [LRRD BY MD]"
^DIC(9.4,14,22,5.9,"PAH",127,1,137,0)="        Reprint cumulative on a given patient [LRAC PT]"
^DIC(9.4,14,22,5.9,"PAH",127,1,138,0)="        Reprint a permanent page from cumulative [LRAC 1 PAGE]"
^DIC(9.4,14,22,5.9,"PAH",127,1,139,0)="        Manual queuing of cumulative [LRAC MANUAL]"
^DIC(9.4,14,22,5.9,"PAH",127,1,140,0)="        TASK THE CUMULATIVE TO RUN EACH NITE [LRTASK CUM]"
^DIC(9.4,14,22,5.9,"PAH",127,1,141,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,142,0)="  "
^DIC(9.4,14,22,5.9,"PAH",127,1,143,0)="  7. On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",127,1,144,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,145,0)="NOTE: Routine LR300 will be deleted after successful patch installation."
