^DIC(9.4,13,22,9,"PAH",11,1,4,0)="Subject:  BUG FIXES TO VA FILEMAN"
^DIC(9.4,13,22,9,"PAH",11,1,5,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,6,0)="Category:  ROUTINE"
^DIC(9.4,13,22,9,"PAH",11,1,7,0)="           DATA DICTIONARY"
^DIC(9.4,13,22,9,"PAH",11,1,8,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,9,0)="Description:"
^DIC(9.4,13,22,9,"PAH",11,1,10,0)="==========="
^DIC(9.4,13,22,9,"PAH",11,1,11,0)=" This patch corrects twelve issues with VA FileMan 22.2.  These issues where"
^DIC(9.4,13,22,9,"PAH",11,1,12,0)=" discovered at sites that have installed VA FileMan 22.2 and DI*22.2*10."
^DIC(9.4,13,22,9,"PAH",11,1,13,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,14,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,15,0)="Patch Components:"
^DIC(9.4,13,22,9,"PAH",11,1,16,0)="-----------------"
^DIC(9.4,13,22,9,"PAH",11,1,17,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,18,0)="File Name (#)                Field Name (#)      New/Modified/Deleted"
^DIC(9.4,13,22,9,"PAH",11,1,19,0)="-------------                --------------      -------------"
^DIC(9.4,13,22,9,"PAH",11,1,20,0)="AUDIT (#1.1)                 OLD VALUE (2)       Modified"
^DIC(9.4,13,22,9,"PAH",11,1,21,0)="                             NEW VALUE (3)"
^DIC(9.4,13,22,9,"PAH",11,1,22,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,23,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,24,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,25,0)="Blood Bank Clearance:"
^DIC(9.4,13,22,9,"PAH",11,1,26,0)="---------------------"
^DIC(9.4,13,22,9,"PAH",11,1,27,0)="2/5/2019"
^DIC(9.4,13,22,9,"PAH",11,1,28,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch DI*22.2*14 contains"
^DIC(9.4,13,22,9,"PAH",11,1,29,0)="changes to a package referenced in ProPath standard titled: BBM Team"
^DIC(9.4,13,22,9,"PAH",11,1,30,0)="Review of VistA Patches. This patch does not alter or modify any VistA"
^DIC(9.4,13,22,9,"PAH",11,1,31,0)="Blood Bank software design safeguards or safety critical elements"
^DIC(9.4,13,22,9,"PAH",11,1,32,0)="functions."
^DIC(9.4,13,22,9,"PAH",11,1,33,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,34,0)="RISK ANALYSIS: Changes made by patch DI*22.2*14 have no adverse effect on"
^DIC(9.4,13,22,9,"PAH",11,1,35,0)="Blood Bank software functionality, therefore RISK is none. "
^DIC(9.4,13,22,9,"PAH",11,1,36,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,37,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,38,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,13,22,9,"PAH",11,1,39,0)="--------------------------------------------"
^DIC(9.4,13,22,9,"PAH",11,1,40,0)="1.  Ticket:   I12133765FY17"
^DIC(9.4,13,22,9,"PAH",11,1,41,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,42,0)="  Sort templates don't show previous values when editing the template"
^DIC(9.4,13,22,9,"PAH",11,1,43,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,44,0)="  Change DIP1 to display previous value"
^DIC(9.4,13,22,9,"PAH",11,1,45,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,46,0)="2.  Ticket:   I10027710FY16"
^DIC(9.4,13,22,9,"PAH",11,1,47,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,48,0)="  Date utility, %DT, allows incorrect time.  Calling %DT with X=3160707.8"
^DIC(9.4,13,22,9,"PAH",11,1,49,0)="  should return Y=-1"
^DIC(9.4,13,22,9,"PAH",11,1,50,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,51,0)="  Change DIDT to return Y=-1 if X contains an incorrect time. Post install"
^DIC(9.4,13,22,9,"PAH",11,1,52,0)="  routine DI14POST will resave DIDT as %DT."
^DIC(9.4,13,22,9,"PAH",11,1,53,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,54,0)="3.  Ticket:   R13378947FY17"
^DIC(9.4,13,22,9,"PAH",11,1,55,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,56,0)="  Can't print OLD VALUE (#2) and NEW VALUE (#3) fields from AUDIT (#1.1) file"
^DIC(9.4,13,22,9,"PAH",11,1,57,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,58,0)="  Change the logic in the computed fields #2 and #3.  Replace If statement"
^DIC(9.4,13,22,9,"PAH",11,1,59,0)="  with $Select.  Also, change DINIT20, which sets the logic when FileMan"
^DIC(9.4,13,22,9,"PAH",11,1,60,0)="  is initialized."
^DIC(9.4,13,22,9,"PAH",11,1,61,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,62,0)="4.  Ticket:   INC3327007"
^DIC(9.4,13,22,9,"PAH",11,1,63,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,64,0)="  Add APPLICATION GROUP to Data Dictionary List File Attributes option"
^DIC(9.4,13,22,9,"PAH",11,1,65,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,66,0)="  Change DIDH1 to display APPLICATION GROUP"
^DIC(9.4,13,22,9,"PAH",11,1,67,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,68,0)="5.  Ticket:   INC1570061"
^DIC(9.4,13,22,9,"PAH",11,1,69,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,70,0)="  Maximum length of new style cross reference is too short"
^DIC(9.4,13,22,9,"PAH",11,1,71,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,72,0)="  Change MAXIMUM LENGTH (#6) field in INDEX (#.11) file from 240 to 999."
^DIC(9.4,13,22,9,"PAH",11,1,73,0)="  Add change to DI14POST and DINIT2A4"
^DIC(9.4,13,22,9,"PAH",11,1,74,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,75,0)="6.  Ticket:   INC1550303"
^DIC(9.4,13,22,9,"PAH",11,1,76,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,77,0)="  Undefined error when doing an Inquire to a file that has a computed field"
^DIC(9.4,13,22,9,"PAH",11,1,78,0)="  that calls EN^DIQ1"
^DIC(9.4,13,22,9,"PAH",11,1,79,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,80,0)="  Change DIQ1 to new the variables C and DI at tag EN"
^DIC(9.4,13,22,9,"PAH",11,1,81,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,82,0)="7.  Ticket:   I16938507FY18"
^DIC(9.4,13,22,9,"PAH",11,1,83,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,84,0)="  The variable DISYS is undefined when calling EN^DIEZ in background"
^DIC(9.4,13,22,9,"PAH",11,1,85,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,86,0)="  Move the call to DT^DICRW to earlier in the routine.  It sets DISYS."
^DIC(9.4,13,22,9,"PAH",11,1,87,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,88,0)="8.  Ticket:   I17087603FY18"
^DIC(9.4,13,22,9,"PAH",11,1,89,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,90,0)="  When a partial Data Dictionary containing a multiple is distributed using"
^DIC(9.4,13,22,9,"PAH",11,1,91,0)="  KIDS, the zero node of sub dictionary has the wrong first piece"
^DIC(9.4,13,22,9,"PAH",11,1,92,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,93,0)="  Change DIFROMS2; comment out line that was setting the sub dictionary zero"
^DIC(9.4,13,22,9,"PAH",11,1,94,0)="  node incorrectly to fix the bug.  Post Install EN^DI14POST will check and"
^DIC(9.4,13,22,9,"PAH",11,1,95,0)="  correct any corrupted sub dictionaries."
^DIC(9.4,13,22,9,"PAH",11,1,96,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,97,0)="9.  Ticket:   INC0105488"
^DIC(9.4,13,22,9,"PAH",11,1,98,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,99,0)="  Queries for data that utilizes a variable pointer field could be missing"
^DIC(9.4,13,22,9,"PAH",11,1,100,0)="  results"
^DIC(9.4,13,22,9,"PAH",11,1,101,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,102,0)="  Change to DICOMP0 to handle variable pointers correctly"
^DIC(9.4,13,22,9,"PAH",11,1,103,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,104,0)="10.  Ticket:   I16902120FY18"
^DIC(9.4,13,22,9,"PAH",11,1,105,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,106,0)="  If the variable %DT(0) is defined when an Input Transform is executed,"
^DIC(9.4,13,22,9,"PAH",11,1,107,0)="  it causes incorrect information"
^DIC(9.4,13,22,9,"PAH",11,1,108,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,109,0)="  Change DICN to new the variable before executing the Input Transform"
^DIC(9.4,13,22,9,"PAH",11,1,110,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,111,0)="11.  Ticket:   I17417683FY18, I10449501FY16"
^DIC(9.4,13,22,9,"PAH",11,1,112,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,113,0)="  Audit is not recording changes if it happens during a trigger to another"
^DIC(9.4,13,22,9,"PAH",11,1,114,0)="  file"
^DIC(9.4,13,22,9,"PAH",11,1,115,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,116,0)="  The problem is the DA variable is changed.  Change DICR to save the DA"
^DIC(9.4,13,22,9,"PAH",11,1,117,0)="  array and other variables before auditing and then restore the variables"
^DIC(9.4,13,22,9,"PAH",11,1,118,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,119,0)="12.  Ticket:   R15604177FY17"
^DIC(9.4,13,22,9,"PAH",11,1,120,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",11,1,121,0)="  If the records being transferred is in a file that contain a multiple field"
^DIC(9.4,13,22,9,"PAH",11,1,122,0)="  that uses DINUM in the Input Transform, then FileMan stacks the DA array,"
^DIC(9.4,13,22,9,"PAH",11,1,123,0)="  but never unstacks it when it tries to delete the record"
^DIC(9.4,13,22,9,"PAH",11,1,124,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",11,1,125,0)="  Change DIT0 to reset DA to the correct record before deleting"
^DIC(9.4,13,22,9,"PAH",11,1,126,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,127,0)="  "
^DIC(9.4,13,22,9,"PAH",11,1,128,0)="Test Sites:"
^DIC(9.4,13,22,9,"PAH",11,1,129,0)="-----------"
^DIC(9.4,13,22,9,"PAH",11,1,130,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,131,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,132,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,133,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,13,22,9,"PAH",11,1,134,0)="-------------------------------------------------- "
^DIC(9.4,13,22,9,"PAH",11,1,135,0)="Software is being released as a host file and documentation describing"
^DIC(9.4,13,22,9,"PAH",11,1,136,0)="the new functionality introduced by this patch is available."
^DIC(9.4,13,22,9,"PAH",11,1,137,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,138,0)="The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,13,22,9,"PAH",11,1,139,0)="This transmits the files from the first available server. Sites may "
^DIC(9.4,13,22,9,"PAH",11,1,140,0)="also elect to retrieve files directly from a specific server. "
^DIC(9.4,13,22,9,"PAH",11,1,141,0)="Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,13,22,9,"PAH",11,1,142,0)="Secure Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory "
^DIC(9.4,13,22,9,"PAH",11,1,143,0)="at the following OI Field Offices:"
^DIC(9.4,13,22,9,"PAH",11,1,144,0)="   "
^DIC(9.4,13,22,9,"PAH",11,1,145,0)="Hines:                  fo-hines.domain.ext    "
^DIC(9.4,13,22,9,"PAH",11,1,146,0)="Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,13,22,9,"PAH",11,1,147,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,148,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,149,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,13,22,9,"PAH",11,1,150,0)="at: http://www.domain.ext/vdl/ "
^DIC(9.4,13,22,9,"PAH",11,1,151,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,152,0)="Title                          File Name                 SFTP Mode"
^DIC(9.4,13,22,9,"PAH",11,1,153,0)="-----------------------------------------------------------------------"
^DIC(9.4,13,22,9,"PAH",11,1,154,0)="FileMan 22.2 Technical Manual  FM22_2TM.PDF              Binary"
^DIC(9.4,13,22,9,"PAH",11,1,155,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,156,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,157,0)="Patch Installation:"
^DIC(9.4,13,22,9,"PAH",11,1,158,0)="   "
^DIC(9.4,13,22,9,"PAH",11,1,159,0)="Pre-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",11,1,160,0)="------------------------------"
^DIC(9.4,13,22,9,"PAH",11,1,161,0)="This patch can be queued for installation.  TaskMan does not have to be"
^DIC(9.4,13,22,9,"PAH",11,1,162,0)="stopped, Health Level 7 (HL7) filers do not need to be stopped, and"
^DIC(9.4,13,22,9,"PAH",11,1,163,0)="users may be on the system.  The patch should be installed during"
^DIC(9.4,13,22,9,"PAH",11,1,164,0)="non-peak hours to minimize potential for disruption to users.  This"
^DIC(9.4,13,22,9,"PAH",11,1,165,0)="patch should take less than 1 minute to install."
^DIC(9.4,13,22,9,"PAH",11,1,166,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,167,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,168,0)="Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",11,1,169,0)="--------------------------"
^DIC(9.4,13,22,9,"PAH",11,1,170,0)="1. Choose the MailMan message containing this patch."
^DIC(9.4,13,22,9,"PAH",11,1,171,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,172,0)="2. Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,13,22,9,"PAH",11,1,173,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,174,0)="3. From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,13,22,9,"PAH",11,1,175,0)="   the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,13,22,9,"PAH",11,1,176,0)="   following options. When prompted for the INSTALL NAME enter"
^DIC(9.4,13,22,9,"PAH",11,1,177,0)="   DI*22.2*10."
^DIC(9.4,13,22,9,"PAH",11,1,178,0)=" a. Print Transport Global - This option lets you print the contents"
^DIC(9.4,13,22,9,"PAH",11,1,179,0)="    of a Transport Global that is currently loaded in the ^XTMP"
^DIC(9.4,13,22,9,"PAH",11,1,180,0)="    global."
^DIC(9.4,13,22,9,"PAH",11,1,181,0)=" b. Backup a Transport Global - This option will create a backup"
^DIC(9.4,13,22,9,"PAH",11,1,182,0)="    message of any routines exported with this patch. It will not"
^DIC(9.4,13,22,9,"PAH",11,1,183,0)="    backup any other changes such as functions."
^DIC(9.4,13,22,9,"PAH",11,1,184,0)=" c. Compare Transport Global to Current System - This option will"
^DIC(9.4,13,22,9,"PAH",11,1,185,0)="    allow you to view all changes that will be made when this patch"
^DIC(9.4,13,22,9,"PAH",11,1,186,0)="    is installed.  It compares all components of this patch"
^DIC(9.4,13,22,9,"PAH",11,1,187,0)="    (routines, DDs, templates, etc.)."
^DIC(9.4,13,22,9,"PAH",11,1,188,0)=" d. Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,13,22,9,"PAH",11,1,189,0)="    you to ensure the integrity of the routines that are in the"
^DIC(9.4,13,22,9,"PAH",11,1,190,0)="    transport global."
^DIC(9.4,13,22,9,"PAH",11,1,191,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,192,0)="4. From the Installation Menu, select the Install Package(s) option"
^DIC(9.4,13,22,9,"PAH",11,1,193,0)="   and when prompted for the INSTALL NAME, enter DI*22.2*14."
^DIC(9.4,13,22,9,"PAH",11,1,194,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,195,0)="5. If prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,13,22,9,"PAH",11,1,196,0)="   Install? NO//' respond NO."
^DIC(9.4,13,22,9,"PAH",11,1,197,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,198,0)="7. When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,13,22,9,"PAH",11,1,199,0)="   NO//"" respond NO."
^DIC(9.4,13,22,9,"PAH",11,1,200,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,201,0)="8. If prompted ""Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,13,22,9,"PAH",11,1,202,0)="   and Protocols? NO//"" respond NO. "
^DIC(9.4,13,22,9,"PAH",11,1,203,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,204,0)="9. If prompted ""Delay Install (Minutes):  (0 - 60): 0//"" respond 0."
^DIC(9.4,13,22,9,"PAH",11,1,205,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,206,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,207,0)="Post-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",11,1,208,0)="-------------------------------"
^DIC(9.4,13,22,9,"PAH",11,1,209,0)="You need to run EN^DI14POST to check for bad nodes on multiples.  This"
^DIC(9.4,13,22,9,"PAH",11,1,210,0)="is issue #8.  The routine will find all bad nodes and prompt you to fix"
^DIC(9.4,13,22,9,"PAH",11,1,211,0)="them.  The results will be kept in the ^XTMP(""DI14"") global for 30 days,"
^DIC(9.4,13,22,9,"PAH",11,1,212,0)="unless you run the report again, and can be reversed by using the "
^DIC(9.4,13,22,9,"PAH",11,1,213,0)="RESTORE^DI14POST call."
^DIC(9.4,13,22,9,"PAH",11,1,214,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,215,0)="  "
^DIC(9.4,13,22,9,"PAH",11,1,216,0)="Backout and Rollback Procedure:"
^DIC(9.4,13,22,9,"PAH",11,1,217,0)="-------------------------------"
^DIC(9.4,13,22,9,"PAH",11,1,218,0)="This patch consists of routines and a fix to the AUDIT file. During the VistA"
^DIC(9.4,13,22,9,"PAH",11,1,219,0)="Installation Procedure of the KIDS build, the installer should back up the"
^DIC(9.4,13,22,9,"PAH",11,1,220,0)="modified routines by the use of the 'Backup a Transport Global' action"
^DIC(9.4,13,22,9,"PAH",11,1,221,0)="(step 3b in the Installations Instructions below)."
^DIC(9.4,13,22,9,"PAH",11,1,222,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,223,0)="If rollback/backout is required, the installer can restore the routines"
^DIC(9.4,13,22,9,"PAH",11,1,224,0)="using the MailMan message that were saved prior to installing the"
^DIC(9.4,13,22,9,"PAH",11,1,225,0)="patch.  The changes to the two fields in the AUDIT file can remain."
^DIC(9.4,13,22,9,"PAH",11,1,226,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,227,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,228,0)="Routine Information:"
^DIC(9.4,13,22,9,"PAH",11,1,229,0)="===================="
^DIC(9.4,13,22,9,"PAH",11,1,230,0)="The second line of each of these routines now looks like:"
^DIC(9.4,13,22,9,"PAH",11,1,231,0)=" ;;22.2;VA FileMan;**[Patch List]**;Jan 05, 2016;Build 2"
^DIC(9.4,13,22,9,"PAH",11,1,232,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,233,0)="The checksums below are new checksums, and"
^DIC(9.4,13,22,9,"PAH",11,1,234,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,13,22,9,"PAH",11,1,235,0)=" "
^DIC(9.4,13,22,9,"PAH",11,1,236,0)="Routine Name: DI14POST"
^DIC(9.4,13,22,9,"PAH",11,1,237,0)="    Before:       n/a   After:  B9063359  **14**"
^DIC(9.4,13,22,9,"PAH",11,1,238,0)="Routine Name: DICN"
^DIC(9.4,13,22,9,"PAH",11,1,239,0)="    Before: B21480119   After: B21929121  **2,5,13,14**"
^DIC(9.4,13,22,9,"PAH",11,1,240,0)="Routine Name: DICOMP0"
^DIC(9.4,13,22,9,"PAH",11,1,241,0)="    Before: B23489999   After: B27698020  **2,14**"
^DIC(9.4,13,22,9,"PAH",11,1,242,0)="Routine Name: DICR"
^DIC(9.4,13,22,9,"PAH",11,1,243,0)="    Before: B25667667   After: B26163162  **14**"
^DIC(9.4,13,22,9,"PAH",11,1,244,0)="Routine Name: DIDH1"
^DIC(9.4,13,22,9,"PAH",11,1,245,0)="    Before: B22350242   After: B23605706  **14**"
^DIC(9.4,13,22,9,"PAH",11,1,246,0)="Routine Name: DIDT"
^DIC(9.4,13,22,9,"PAH",11,1,247,0)="    Before: B25746733   After: B26129943  **14**"
^DIC(9.4,13,22,9,"PAH",11,1,248,0)="Routine Name: DIEZ"
^DIC(9.4,13,22,9,"PAH",11,1,249,0)="    Before: B23918443   After: B24336790  **14**"
^DIC(9.4,13,22,9,"PAH",11,1,250,0)="Routine Name: DIFROMS2"
^DIC(9.4,13,22,9,"PAH",11,1,251,0)="    Before: B45453261   After: B51495195  **3,5,14**"
^DIC(9.4,13,22,9,"PAH",11,1,252,0)="Routine Name: DINIT20"
^DIC(9.4,13,22,9,"PAH",11,1,253,0)="    Before: B30255167   After: B30371045  **2,14**"
^DIC(9.4,13,22,9,"PAH",11,1,254,0)="Routine Name: DINIT2A4"
^DIC(9.4,13,22,9,"PAH",11,1,255,0)="    Before: B37901832   After: B37907044  **14**"
^DIC(9.4,13,22,9,"PAH",11,1,256,0)="Routine Name: DIP1"
^DIC(9.4,13,22,9,"PAH",11,1,257,0)="    Before: B36571552   After: B36617181  **14**"
