^DIC(9.4,4,22,1,"PAH",78,1,28,0)="XMXBSKT       12393935        13019759        50,106"
^DIC(9.4,4,22,1,"PAH",78,1,29,0)="XMXMSGS2       5670519         6491081        50,106"
^DIC(9.4,4,22,1,"PAH",78,1,30,0)="XMXSEND       10879355        11913872        50,106"
