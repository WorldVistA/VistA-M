^DIC(9.4,60,22,13,"PAH",250,1,175,0)="Group 4: RX's IN DELETED STATUS"
^DIC(9.4,60,22,13,"PAH",250,1,176,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",250,1,177,0)="12. No CPRS order# (update HDR)                                    2,275"
^DIC(9.4,60,22,13,"PAH",250,1,178,0)=" "
^DIC(9.4,60,22,13,"PAH",250,1,179,0)="13. TOTAL NUMBER OF PRESCRIPTIONS ANALYZED:                    6,653,607"
