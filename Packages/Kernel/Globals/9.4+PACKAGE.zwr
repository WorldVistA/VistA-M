^DIC(9.4,3,22,21,"PAH",171,1,70,0)="XUP           4867034   5102490    **208**"
^DIC(9.4,3,22,21,"PAH",171,1,71,0)="XUSERNEW      7347033   7464165    **16,49,134,208**"
^DIC(9.4,3,22,21,"PAH",171,1,72,0)="XUSRA         1579938   1722541    **70,115,208**"
^DIC(9.4,3,22,21,"PAH",171,1,73,0)="XUSTERM1     11515045  12346209    **102,180,208**"
^DIC(9.4,3,22,21,"PAH",171,1,74,0)=""
