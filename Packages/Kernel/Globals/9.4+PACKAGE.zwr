^DIC(9.4,4,22,1,"PAH",126,0)="154 SEQ #151^3001127^1"
^DIC(9.4,4,22,1,"PAH",126,1,0)="^^59^59^3001127"
^DIC(9.4,4,22,1,"PAH",126,1,1,0)="Patch XM*7.1*154"
^DIC(9.4,4,22,1,"PAH",126,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",126,1,3,0)="NOIS: HIN-0600-41009"
^DIC(9.4,4,22,1,"PAH",126,1,4,0)="Test Sites:  Hines, IL"
^DIC(9.4,4,22,1,"PAH",126,1,5,0)="If two users are signed on as the same user, and both are working on the"
^DIC(9.4,4,22,1,"PAH",126,1,6,0)="same message, and one user saves the message to another basket, an abort"
^DIC(9.4,4,22,1,"PAH",126,1,7,0)="occurs if the other user tries to save the message, too."
^DIC(9.4,4,22,1,"PAH",126,1,8,0)="This patch fixes that. "
^DIC(9.4,4,22,1,"PAH",126,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",126,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",126,1,11,0)="is at a minimum.  It requires MailMan patch XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",126,1,12,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",126,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",126,1,14,0)="ROUTINES:"
