^DIC(9.4,48,22,5.28,"PAH",196,1,1,0)="'SC Veterans Awaiting Appointments' option."
^DIC(9.4,48,22,5.28,"PAH",197,0)="269 SEQ #238^3021008^1"
^DIC(9.4,48,22,5.28,"PAH",197,1,0)="^^2^2^3021008"
^DIC(9.4,48,22,5.28,"PAH",197,1,1,0)="Enhancements and fix for the 'SC Veterans Awaiting Appointments' [SCRPW "
^DIC(9.4,48,22,5.28,"PAH",197,1,2,0)="SC VETS AWAITING APPTS] option."
^DIC(9.4,48,22,5.28,"PAH",198,0)="268 SEQ #239^3021008^1"
