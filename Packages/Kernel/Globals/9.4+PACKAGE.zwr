^DIC(9.4,11,22,5.03,"PAH",33,1,99,0)="   LA7LOG           9009311        8393092        **17,27,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,100,0)="   LA7PCFG          N/A            16069384       **67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,101,0)="   LA7POC           N/A            3454800        **67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,102,0)="   LA7UXQA          7260762        5623537        **27,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,103,0)="   LA7VHL           5811383        6113752        **27,46,62,64,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,104,0)="   LA7VIN           1398763        3056962        **46,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,105,0)="   LA7VIN1A         13987419       14019173       **64,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,106,0)="   LA7VIN4          12162627       12188308       **46,64,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,107,0)="   LA7VIN5A         8695039        9628469        **46,64,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,108,0)="   LAGEN            8715369        8613602        **1,17,22,27,47,46,64,67**"
^DIC(9.4,11,22,5.03,"PAH",33,1,109,0)=" "
