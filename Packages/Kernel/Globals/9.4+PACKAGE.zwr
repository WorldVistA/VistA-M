^DIC(9.4,121,22,0)="^9.49I^4^1"
^DIC(9.4,121,22,4,0)="2.5^3051119^2960823"
^DIC(9.4,121,22,4,"PAH",0)="^9.4901^13^13"
^DIC(9.4,121,22,4,"PAH",1,0)="4 SEQ #2^2961224^1"
^DIC(9.4,121,22,4,"PAH",1,1,0)="^^1^1^2961224"
^DIC(9.4,121,22,4,"PAH",1,1,1,0)="Patch to version 2.5 to fix program mistakenly deleted."
^DIC(9.4,121,22,4,"PAH",2,0)="2 SEQ #3^2980423^1"
^DIC(9.4,121,22,4,"PAH",2,1,0)="^^2^2^2980423"
^DIC(9.4,121,22,4,"PAH",2,1,1,0)="Patch to version 2.5 which allows for Primary Stations and Legacy Stations"
^DIC(9.4,121,22,4,"PAH",2,1,2,0)="on one system."
^DIC(9.4,121,22,4,"PAH",3,0)="3 SEQ #4^2980423^1"
^DIC(9.4,121,22,4,"PAH",3,1,0)="^^3^3^2980423"
^DIC(9.4,121,22,4,"PAH",3,1,1,0)="Patch to version 2.5 which allows for Primary Stations and Legacy Stations"
^DIC(9.4,121,22,4,"PAH",3,1,2,0)="on one system.  Will merge data from a Legacy Station into a Primary Station's"
^DIC(9.4,121,22,4,"PAH",3,1,3,0)="database."
^DIC(9.4,121,22,4,"PAH",4,0)="6 SEQ #5^2981016^1"
^DIC(9.4,121,22,4,"PAH",4,1,0)="^^2^2^2981016"
^DIC(9.4,121,22,4,"PAH",4,1,1,0)="This patch makes the VistA portion of the Library Package Year 2000"
^DIC(9.4,121,22,4,"PAH",4,1,2,0)="compliant."
^DIC(9.4,121,22,4,"PAH",5,0)="8 SEQ #6^3010710^1"
^DIC(9.4,121,22,4,"PAH",5,1,0)="^^6^6^3010710"
^DIC(9.4,121,22,4,"PAH",5,1,1,0)="Patch LBR*2.5*8 will replace the need for the VA Integration Team to "
^DIC(9.4,121,22,4,"PAH",5,1,2,0)="RE-install patch LBR*2.5*3 to integrate Library databases.  After "
^DIC(9.4,121,22,4,"PAH",5,1,3,0)="LBR*2.5*8 installation, Integration Team will be able to run the "
^DIC(9.4,121,22,4,"PAH",5,1,4,0)="installation from the new assigned menu options.  Patch 8 is for use at "
^DIC(9.4,121,22,4,"PAH",5,1,5,0)="multi-divisional sites.  For stations not integrating data, Patch 8 "
^DIC(9.4,121,22,4,"PAH",5,1,6,0)="installation should only take a short time. "
^DIC(9.4,121,22,4,"PAH",6,0)="9 SEQ #7^3030520^1"
^DIC(9.4,121,22,4,"PAH",6,1,0)="^^12^12^3030520"
^DIC(9.4,121,22,4,"PAH",6,1,1,0)="This patch provides Library with the interface capabilities to the Core"
^DIC(9.4,121,22,4,"PAH",6,1,2,0)="Financial Logististics System (CoreFLS).  coreFLS will replace the"
^DIC(9.4,121,22,4,"PAH",6,1,3,0)="Integrated Funds Distribution, Control Point Activity, and Procurement"
^DIC(9.4,121,22,4,"PAH",6,1,4,0)="(IFCAP) package."
^DIC(9.4,121,22,4,"PAH",6,1,5,0)=" "
^DIC(9.4,121,22,4,"PAH",6,1,6,0)="Vendor information for coreFLS will be remotely held on a national"
^DIC(9.4,121,22,4,"PAH",6,1,7,0)="database.  To aliviate traffic over a network system, a local vendor file,"
^DIC(9.4,121,22,4,"PAH",6,1,8,0)="LOCAL VENDOR (#392.31) will be accessed to retrieve frequently used"
^DIC(9.4,121,22,4,"PAH",6,1,9,0)="vendors."
^DIC(9.4,121,22,4,"PAH",6,1,10,0)=" "
^DIC(9.4,121,22,4,"PAH",6,1,11,0)="A new field is added to the Library Site Parameters that will be used to"
^DIC(9.4,121,22,4,"PAH",6,1,12,0)="activate the coreFLS interface:"
^DIC(9.4,121,22,4,"PAH",7,0)="10 SEQ #8^3031107^1"
^DIC(9.4,121,22,4,"PAH",7,1,0)="^^4^4^3031107"
^DIC(9.4,121,22,4,"PAH",7,1,1,0)="This patch addresses the prompts displayed in the 'Missing Issues List'"
^DIC(9.4,121,22,4,"PAH",7,1,2,0)="[LBRY MISSING ISSUE] report.  It also removes the option [LBRY ASSIGN"
^DIC(9.4,121,22,4,"PAH",7,1,3,0)="COPY] 'no descriptive title' from the 'Library Management' [LBRY MANAGER]"
^DIC(9.4,121,22,4,"PAH",7,1,4,0)="menu."
^DIC(9.4,121,22,4,"PAH",8,0)="5 SEQ #9^3040427^1"
^DIC(9.4,121,22,4,"PAH",8,1,0)="^^1^1^3040427"
^DIC(9.4,121,22,4,"PAH",8,1,1,0)="Receiving undefined error at option [LBRY PATRONS REPORTS]."
^DIC(9.4,121,22,4,"PAH",9,0)="11 SEQ #10^3040427^1"
^DIC(9.4,121,22,4,"PAH",9,1,0)="^^7^7^3040427"
^DIC(9.4,121,22,4,"PAH",9,1,1,0)="Library server messages are not being removed from postmaster (S.LBRYSRV) "
^DIC(9.4,121,22,4,"PAH",9,1,2,0)="mailbox."
^DIC(9.4,121,22,4,"PAH",9,1,3,0)=" "
^DIC(9.4,121,22,4,"PAH",9,1,4,0)="Input template LBRY BIBLIOGRAPHIC 2 ENTRY in LOCAL SERIALS (#680) file is "
^DIC(9.4,121,22,4,"PAH",9,1,5,0)="changed to allow skipping over MICROFILM COREFLS VENDOR, rather than "
^DIC(9.4,121,22,4,"PAH",9,1,6,0)="making it a required selection.  This template is executed during the "
^DIC(9.4,121,22,4,"PAH",9,1,7,0)="HOLDING SETUP if the site is running CoreFLS."
^DIC(9.4,121,22,4,"PAH",10,0)="12 SEQ #11^3041029^1"
^DIC(9.4,121,22,4,"PAH",10,1,0)="^^1^1^3041029"
^DIC(9.4,121,22,4,"PAH",10,1,1,0)="DISABLE COREFLS SOFTWARE"
^DIC(9.4,121,22,4,"PAH",11,0)="13 SEQ #12^3050204^1"
^DIC(9.4,121,22,4,"PAH",11,1,0)="^^1^1^3050204"
^DIC(9.4,121,22,4,"PAH",11,1,1,0)="Cannot print from LBRY SERIALS CHECK-IN"
^DIC(9.4,121,22,4,"PAH",12,0)="14 SEQ #13^3121213.11292^17"
^DIC(9.4,121,22,4,"PAH",12,1,0)="^^3^3^3121213"
^DIC(9.4,121,22,4,"PAH",12,1,1,0)="This patch will fix an undefined error created when subsequently "
^DIC(9.4,121,22,4,"PAH",12,1,2,0)="accessing certain reports from the 'Serials Titles Reports...' or the "
^DIC(9.4,121,22,4,"PAH",12,1,3,0)="'Other Serials Reports...' menu and then using a caret to exit."
^DIC(9.4,121,22,4,"PAH",13,0)="15 SEQ #14^3180403.174539^54"
^DIC(9.4,121,22,4,"PAH",13,1,0)="^^2^2^3180403"
^DIC(9.4,121,22,4,"PAH",13,1,1,0)="This patch will retire the Library package by removing all associated "
^DIC(9.4,121,22,4,"PAH",13,1,2,0)="components."
