^DIC(9.4,3,22,21,"PAH",112,1,118,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",112,1,119,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",112,1,120,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",112,1,121,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",112,1,122,0)="      Patch number to load: 127"
^DIC(9.4,3,22,21,"PAH",112,1,123,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",112,1,124,0)="       "
^DIC(9.4,3,22,21,"PAH",112,1,125,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",112,1,126,0)=" "
^DIC(9.4,3,22,21,"PAH",112,1,127,0)="      "
^DIC(9.4,3,22,21,"PAH",112,1,128,0)=" 11.  Restart TASKMAN with D RESTART^ZTMB.  DSM sites this may require"
^DIC(9.4,3,22,21,"PAH",112,1,129,0)="      a privileged user."
^DIC(9.4,3,22,21,"PAH",112,1,130,0)="      "
^DIC(9.4,3,22,21,"PAH",112,1,131,0)=" 12.  Add a MAIL GROUP to the bulletin ""XUTM PROBLEM DEVICE""."
^DIC(9.4,3,22,21,"PAH",112,1,132,0)="      Schedule the option ""XUTM QPROBLEM DEVICE"" once a day."
^DIC(9.4,3,22,21,"PAH",113,0)="133 SEQ #118^2991210^1"
^DIC(9.4,3,22,21,"PAH",113,1,0)="^^43^43^2991210"
^DIC(9.4,3,22,21,"PAH",113,1,1,0)="1.  CTX-1099-72732, DAN-1099-40868.  Waiver Exemption ID#: Y2KWE0019."
^DIC(9.4,3,22,21,"PAH",113,1,2,0)="    Renewed Alerts Not Reappearing.  When sites renew alerts they are"
^DIC(9.4,3,22,21,"PAH",113,1,3,0)="    disappearing.  The following Data Dictionary has been revised to"
^DIC(9.4,3,22,21,"PAH",113,1,4,0)="    correct this problem:"
^DIC(9.4,3,22,21,"PAH",113,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,6,0)="    1. ^DD(8992.1,.01"
^DIC(9.4,3,22,21,"PAH",113,1,7,0)="    2. ^DD(8992.1,.03 "
^DIC(9.4,3,22,21,"PAH",113,1,8,0)="    3. ^DD(8992.01,.02"
^DIC(9.4,3,22,21,"PAH",113,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,11,0)="Test Sites:"
^DIC(9.4,3,22,21,"PAH",113,1,12,0)="==========="
^DIC(9.4,3,22,21,"PAH",113,1,13,0)="Central Texas HCS- 674"
^DIC(9.4,3,22,21,"PAH",113,1,14,0)="Danville, IL - 550"
^DIC(9.4,3,22,21,"PAH",113,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,17,0)="Installation Instruction:"
^DIC(9.4,3,22,21,"PAH",113,1,18,0)="========================"
^DIC(9.4,3,22,21,"PAH",113,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,20,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",113,1,21,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",113,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,23,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",113,1,24,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",113,1,25,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",113,1,26,0)="      options:"
^DIC(9.4,3,22,21,"PAH",113,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,28,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",113,1,29,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",113,1,30,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",113,1,31,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",113,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,33,0)="  3.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",113,1,34,0)="      non-peakpeak time."
^DIC(9.4,3,22,21,"PAH",113,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,36,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",113,1,37,0)="      option:"
^DIC(9.4,3,22,21,"PAH",113,1,38,0)="        Install Package(s)  'XU*8.0*133'"
^DIC(9.4,3,22,21,"PAH",113,1,39,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",113,1,40,0)=" "
^DIC(9.4,3,22,21,"PAH",113,1,41,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",113,1,42,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",113,1,43,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",114,0)="131 SEQ #119^3000229^1"
^DIC(9.4,3,22,21,"PAH",114,1,0)="^^58^58^3000229"
^DIC(9.4,3,22,21,"PAH",114,1,1,0)=""
^DIC(9.4,3,22,21,"PAH",114,1,2,0)=" KIDS routines have been modified to support patch HL*1.6*57.  Patch 57"
^DIC(9.4,3,22,21,"PAH",114,1,3,0)=" added a new field multiple, 'SUBSCRIBER', to the Protocol file, #101. Also,"
^DIC(9.4,3,22,21,"PAH",114,1,4,0)=" the HL LOWER LEVEL PROTOCOL PARAMETER file, #869.2, was merged into the"
^DIC(9.4,3,22,21,"PAH",114,1,5,0)=" HL LOGICAL LINK file, #870."
^DIC(9.4,3,22,21,"PAH",114,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",114,1,7,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",114,1,8,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",114,1,9,0)="    Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",114,1,10,0)="    The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",114,1,11,0)="        ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",114,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,13,0)="             Before          After           Patch"
^DIC(9.4,3,22,21,"PAH",114,1,14,0)=" Routine     Checksum        Checksum        List"
^DIC(9.4,3,22,21,"PAH",114,1,15,0)=" ----------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",114,1,16,0)=" XPDE        15253053        15204188      **2,15,21,44,51,68,131**"
^DIC(9.4,3,22,21,"PAH",114,1,17,0)=" XPDIA       13691537        14296891      **10,15,21,28,44,58,68,131**"
^DIC(9.4,3,22,21,"PAH",114,1,18,0)=" XPDIA0       NEW             2357876      **131**"
^DIC(9.4,3,22,21,"PAH",114,1,19,0)=" XPDIA1       9001554        10621758      **2,44,51,58,68,85,131**"
^DIC(9.4,3,22,21,"PAH",114,1,20,0)=" XPDIA2       6372331         6756887      **68,131**"
^DIC(9.4,3,22,21,"PAH",114,1,21,0)=" XPDTA        7580607         8868649      **15,44,58,131**"
^DIC(9.4,3,22,21,"PAH",114,1,22,0)=" XPDTA1       5005398         4715012      **44,68,85,131**"
^DIC(9.4,3,22,21,"PAH",114,1,23,0)=" XPDTC       13724075        13813303      **10,15,21,39,41,44,58,83,92,95,"
^DIC(9.4,3,22,21,"PAH",114,1,24,0)="                                             100,108,124,131**"
^DIC(9.4,3,22,21,"PAH",114,1,25,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",114,1,26,0)="  This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",114,1,27,0)="  should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",114,1,28,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",114,1,29,0)=" INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",114,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,31,0)="   1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",114,1,32,0)="       so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",114,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,34,0)="   2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",114,1,35,0)="       option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",114,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,37,0)="   3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",114,1,38,0)="       system.  You now need to use KIDS to install the patch in the "
^DIC(9.4,3,22,21,"PAH",114,1,39,0)="       Transport global."
^DIC(9.4,3,22,21,"PAH",114,1,40,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,41,0)="   4.  Users can remain on the system. This patch can be queued and "
^DIC(9.4,3,22,21,"PAH",114,1,42,0)="       installed at any time.  TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",114,1,43,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,44,0)="   5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",114,1,45,0)="       options:"
^DIC(9.4,3,22,21,"PAH",114,1,46,0)="          2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",114,1,47,0)="          3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",114,1,48,0)="          4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",114,1,49,0)="          5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",114,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,51,0)="   6.  As with the installation of all Kernel patches, it is recommended"
^DIC(9.4,3,22,21,"PAH",114,1,52,0)="       that you return to programmers prompt and use D ^XPDKRN:"
^DIC(9.4,3,22,21,"PAH",114,1,53,0)="         Install Package(s)"
^DIC(9.4,3,22,21,"PAH",114,1,54,0)="          INSTALL NAME: XU*8.0*131"
^DIC(9.4,3,22,21,"PAH",114,1,55,0)="                        ========="
^DIC(9.4,3,22,21,"PAH",114,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",114,1,57,0)="   7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",114,1,58,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",115,0)="135 SEQ #120^3000229^1"
^DIC(9.4,3,22,21,"PAH",115,1,0)="^^130^130^3000229"
^DIC(9.4,3,22,21,"PAH",115,1,1,0)=""
^DIC(9.4,3,22,21,"PAH",115,1,2,0)="Y2K Waiver Request ID#:Y2KW0001   Y2K Waiver Status: Approved"
^DIC(9.4,3,22,21,"PAH",115,1,3,0)="this patch may be installed during the Y2K Moratorium, AFTER "
^DIC(9.4,3,22,21,"PAH",115,1,4,0)="1/15/2000.  "
^DIC(9.4,3,22,21,"PAH",115,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,6,0)="1.  E3R - 12385."
^DIC(9.4,3,22,21,"PAH",115,1,7,0)="    In support of MailMan patch XM*7.1*107, this patch adds a new whole"
^DIC(9.4,3,22,21,"PAH",115,1,8,0)="    file cross reference (""AH"", on the DIVISION field) to the NEW PERSON"
^DIC(9.4,3,22,21,"PAH",115,1,9,0)="    file, to enable limited broadcast messager by division."
^DIC(9.4,3,22,21,"PAH",115,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,11,0)="2.  Whenever a name is changed or added in the NEW PERSON file, it is"
^DIC(9.4,3,22,21,"PAH",115,1,12,0)="    necessary to transmit the new name to the Accu-Max system via HL7"
^DIC(9.4,3,22,21,"PAH",115,1,13,0)="    Messaging.  Routines will routinely check for the existence of"
^DIC(9.4,3,22,21,"PAH",115,1,14,0)="    ^DGRU(46.11,""AC"") node.  For those entries which exist, a Master"
^DIC(9.4,3,22,21,"PAH",115,1,15,0)="    File Update(""MFU"") HL7 Message will be created and sent to the"
^DIC(9.4,3,22,21,"PAH",115,1,16,0)="    Accu-Max system if they have a ""Physician"" class.  Several new"
^DIC(9.4,3,22,21,"PAH",115,1,17,0)="    cross-references are being added to the Name and Provider Class"
^DIC(9.4,3,22,21,"PAH",115,1,18,0)="    fields of file #200.  These new cross-references will trigger the"
^DIC(9.4,3,22,21,"PAH",115,1,19,0)="    data into the RAI/MDS Monitor file(#46.11)."
^DIC(9.4,3,22,21,"PAH",115,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,21,0)="3.  MON-0899-52735."
^DIC(9.4,3,22,21,"PAH",115,1,22,0)="    When using the Deactivate a User option [XUSERDEACT], a prompt"
^DIC(9.4,3,22,21,"PAH",115,1,23,0)="    will display to ""Delete All Mail Access:"".  When cursor is set"
^DIC(9.4,3,22,21,"PAH",115,1,24,0)="    to the field to respond the system shows that the user has 0"
^DIC(9.4,3,22,21,"PAH",115,1,25,0)="    messages in their mail box or group though their are messages."
^DIC(9.4,3,22,21,"PAH",115,1,26,0)="    Routine XUSTERM and XUSRB1 has been revised to correct this"
^DIC(9.4,3,22,21,"PAH",115,1,27,0)="    problem."
^DIC(9.4,3,22,21,"PAH",115,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,29,0)="4.  ISL-1199-51331."
^DIC(9.4,3,22,21,"PAH",115,1,30,0)="    To allow CPRS Notification users the ability to identify users"
^DIC(9.4,3,22,21,"PAH",115,1,31,0)="    and/or OE/RR teams, the DEVICE file #3.5, will be added to the"
^DIC(9.4,3,22,21,"PAH",115,1,32,0)="    PARAMETER ENTITY file #8989.518.  A new routine(^XUYDEV) has"
^DIC(9.4,3,22,21,"PAH",115,1,33,0)="    been created to allow entry of the DEVICE into file #8989.518."
^DIC(9.4,3,22,21,"PAH",115,1,34,0)="    When patch has completed loading, proceed with the following"
^DIC(9.4,3,22,21,"PAH",115,1,35,0)="    steps:"
^DIC(9.4,3,22,21,"PAH",115,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,37,0)="    1.  From Programmer Mode, execute the following routine:"
^DIC(9.4,3,22,21,"PAH",115,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,39,0)="        >D ^XUYDEV "
^DIC(9.4,3,22,21,"PAH",115,1,40,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,42,0)="    2.  Next the routine will display:"
^DIC(9.4,3,22,21,"PAH",115,1,43,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,44,0)="        The Following Data Has Been Added To File #8989.518"
^DIC(9.4,3,22,21,"PAH",115,1,45,0)="        ===================================================="
^DIC(9.4,3,22,21,"PAH",115,1,46,0)="        DEVICE"
^DIC(9.4,3,22,21,"PAH",115,1,47,0)="        DEV"
^DIC(9.4,3,22,21,"PAH",115,1,48,0)="        Device"
^DIC(9.4,3,22,21,"PAH",115,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,51,0)="        Press the return key to continue or '^' to exit:"
^DIC(9.4,3,22,21,"PAH",115,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,54,0)="Test Sites:"
^DIC(9.4,3,22,21,"PAH",115,1,55,0)="==========="
^DIC(9.4,3,22,21,"PAH",115,1,56,0)="Washington D.C. - 688"
^DIC(9.4,3,22,21,"PAH",115,1,57,0)="Bronx, NY       - 526"
^DIC(9.4,3,22,21,"PAH",115,1,58,0)="Madison, WI     - 607"
^DIC(9.4,3,22,21,"PAH",115,1,59,0)="Albany, NY      - 500"
^DIC(9.4,3,22,21,"PAH",115,1,60,0)="Biloxi, MS      - 520"
^DIC(9.4,3,22,21,"PAH",115,1,61,0)="Tampa, FL       - 673"
^DIC(9.4,3,22,21,"PAH",115,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,63,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",115,1,64,0)="================"
^DIC(9.4,3,22,21,"PAH",115,1,65,0)="The following routine(s) are included in this patch.  The second line of"
^DIC(9.4,3,22,21,"PAH",115,1,66,0)="each routine will look like:"
^DIC(9.4,3,22,21,"PAH",115,1,67,0)=" "
