^DIC(9.4,60,22,13,"PAH",602,1,861,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,862,0)="   The eRx Print action in the eRx Holding Queue was changed to include two"
^DIC(9.4,60,22,13,"PAH",602,1,863,0)="   new sections: Diagnosis and DUE information. These sections will only be"
^DIC(9.4,60,22,13,"PAH",602,1,864,0)="   included when the information exists in the eRx. They will look like the"
^DIC(9.4,60,22,13,"PAH",602,1,865,0)="   examples below:"
^DIC(9.4,60,22,13,"PAH",602,1,866,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,867,0)="   *************************DIAGNOSIS INFORMATION**************************"
^DIC(9.4,60,22,13,"PAH",602,1,868,0)="   Primary Dx:"
^DIC(9.4,60,22,13,"PAH",602,1,869,0)="   ICD-10 A01.01 TYPHOID MENINGITIS"
^DIC(9.4,60,22,13,"PAH",602,1,870,0)="   Typhoid meningitis_Test primary diagnosis"
^DIC(9.4,60,22,13,"PAH",602,1,871,0)="   ........................................................................"
^DIC(9.4,60,22,13,"PAH",602,1,872,0)="   Secondary Dx:"
^DIC(9.4,60,22,13,"PAH",602,1,873,0)="   ICD-10 E11.21 TYPE 2 DIABETES MELLITUS WITH DIABETIC NEPHROPATHY"
^DIC(9.4,60,22,13,"PAH",602,1,874,0)="   Test secondary Diagnosis"
^DIC(9.4,60,22,13,"PAH",602,1,875,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,876,0)="   *********************PRESCRIBER DRUG USE EVALUATION*********************"
^DIC(9.4,60,22,13,"PAH",602,1,877,0)="   Co-Agent: Nsaids (Non-Steroidal Anti-Inflammatory Drug)"
^DIC(9.4,60,22,13,"PAH",602,1,878,0)="   Reason: Drug-Allergy"
^DIC(9.4,60,22,13,"PAH",602,1,879,0)="   Result: Prescribed w/ acknowledgements"
^DIC(9.4,60,22,13,"PAH",602,1,880,0)="   Override: Previously Tolerated"
^DIC(9.4,60,22,13,"PAH",602,1,881,0)="   ************************************************************************"
^DIC(9.4,60,22,13,"PAH",602,1,882,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,883,0)="16. INC26069186 - eRx Prescription # wrong in file ###.## Order DEA Archive"
^DIC(9.4,60,22,13,"PAH",602,1,884,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,885,0)="   For eRx prescriptions, file #101.52 ORDER DEA ARCHIVE field #1 "
^DIC(9.4,60,22,13,"PAH",602,1,886,0)="   PRESCRIPTION NUMBER is storing the wrong value. The value stored is the "
^DIC(9.4,60,22,13,"PAH",602,1,887,0)="   IEN of the eRx's pending order from file 52.41 OUTPATIENT PENDING ORDER "
^DIC(9.4,60,22,13,"PAH",602,1,888,0)="   before it is finished. "
^DIC(9.4,60,22,13,"PAH",602,1,889,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,890,0)="   When viewed from a global listing, the node 0 piece 2 shows an IEN "
^DIC(9.4,60,22,13,"PAH",602,1,891,0)="   appended with an ""S"", which is how file 100 stores a PACKAGE REFERENCE to "
^DIC(9.4,60,22,13,"PAH",602,1,892,0)="   a PENDING OUTPATIENT ORDERS file #52.41."
^DIC(9.4,60,22,13,"PAH",602,1,893,0)="    "
^DIC(9.4,60,22,13,"PAH",602,1,894,0)="   This erroneous display occurs when completing the eRX order in Complete "
^DIC(9.4,60,22,13,"PAH",602,1,895,0)="   Orders from eRx [PSO ERX FINISH] and can be viewed both before and after "
^DIC(9.4,60,22,13,"PAH",602,1,896,0)="   finishing the prescription in Patient Prescription Processing [PSO LM "
^DIC(9.4,60,22,13,"PAH",602,1,897,0)="   BACKDOOR ORDERS]."
^DIC(9.4,60,22,13,"PAH",602,1,898,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,899,0)="   Resolution:"
^DIC(9.4,60,22,13,"PAH",602,1,900,0)="   -----------"
^DIC(9.4,60,22,13,"PAH",602,1,901,0)="   This will need to be addressed with changes to Pharmacy code as well as "
^DIC(9.4,60,22,13,"PAH",602,1,902,0)="   CPRS code.  This patch will address the pharmacy changes. This patch "
^DIC(9.4,60,22,13,"PAH",602,1,903,0)="   does not address the existing PENDING OUTPATIENT ORDERS file #52.41 that"
^DIC(9.4,60,22,13,"PAH",602,1,904,0)="   exist in ORDER DEA ARCHIVE INFO file #101.52, that will be addressed by"
^DIC(9.4,60,22,13,"PAH",602,1,905,0)="   a follow up patch from CPRS.  This patch corrects the field value going "
^DIC(9.4,60,22,13,"PAH",602,1,906,0)="   forward."
^DIC(9.4,60,22,13,"PAH",602,1,907,0)="   "
^DIC(9.4,60,22,13,"PAH",602,1,908,0)="   Routine PSOORFI1 is modified to allow array PSOCSP to be setup for eRX "
^DIC(9.4,60,22,13,"PAH",602,1,909,0)="   orders the same as they are for pending orders signed in CPRS.  This "
^DIC(9.4,60,22,13,"PAH",602,1,910,0)="   array is needed in the Patient Prescription Processing finishing process."
^DIC(9.4,60,22,13,"PAH",602,1,911,0)="    "
^DIC(9.4,60,22,13,"PAH",602,1,912,0)="   Routine PSON52 is modified to allow eRX orders that do not have a "
^DIC(9.4,60,22,13,"PAH",602,1,913,0)="   SIGNATURE STATUS field #117 set in PENDING OUTPATIENT ORDERS file "
^DIC(9.4,60,22,13,"PAH",602,1,914,0)="   #52.41.  This will allow the process to flow into code that allows the "
^DIC(9.4,60,22,13,"PAH",602,1,915,0)="   PRESCRIPTION file #52 IEN to be set into the PRESCRIPTION NUMBER field"
^DIC(9.4,60,22,13,"PAH",602,1,916,0)="   #1 of the ORDER DEA ARCHIVE INFO file #101.52"
^DIC(9.4,60,22,13,"PAH",602,1,917,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,918,0)="   Routine PSOERX1F is modified to delete the PRESCRIPTION NUMBER field #1"
^DIC(9.4,60,22,13,"PAH",602,1,919,0)="   of the ORDER DEA ARCHIVE INFO file #101.52 after processing returns from "
^DIC(9.4,60,22,13,"PAH",602,1,920,0)="   calling protocol PS EVSEND OR via routine EN^PSOHLSNC during PSO ERX "
^DIC(9.4,60,22,13,"PAH",602,1,921,0)="   FINISH processing.  This removes the #52.41 IEN and thus allows PSON52 to "
^DIC(9.4,60,22,13,"PAH",602,1,922,0)="   update it with the correct IEN to file #52.  This change will likely not "
^DIC(9.4,60,22,13,"PAH",602,1,923,0)="   be released but is necessary for testing this patch until the CPRS "
^DIC(9.4,60,22,13,"PAH",602,1,924,0)="   release is ready."
^DIC(9.4,60,22,13,"PAH",603,0)="762 SEQ #629^3240808.172643^89"
^DIC(9.4,60,22,13,"PAH",603,1,0)="^^13^13^3240808"
^DIC(9.4,60,22,13,"PAH",603,1,1,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",603,1,2,0)="--------"
^DIC(9.4,60,22,13,"PAH",603,1,3,0)="When running options Add New Providers [PSO PROVIDER], Edit Provider [PSO "
^DIC(9.4,60,22,13,"PAH",603,1,4,0)="PROVIDER EDIT], or View Provider [PSO PROVIDER INQUIRE], the heading for "
^DIC(9.4,60,22,13,"PAH",603,1,5,0)="the provider scrolls off the page when the provider has more than 2 DEA "
^DIC(9.4,60,22,13,"PAH",603,1,6,0)="numbers."
^DIC(9.4,60,22,13,"PAH",603,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",603,1,8,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",603,1,9,0)="-----------"
^DIC(9.4,60,22,13,"PAH",603,1,10,0)="Modify routine PSOPRVW and change the calculation used to determine if "
^DIC(9.4,60,22,13,"PAH",603,1,11,0)="printing has reached the bottom of the page. This will allow the "
^DIC(9.4,60,22,13,"PAH",603,1,12,0)="provider name to be displayed on each page of the output.  Data for 2 DEA "
^DIC(9.4,60,22,13,"PAH",603,1,13,0)="numbers will be displayed on each page."
^DIC(9.4,60,22,13,"PAH",604,0)="744 SEQ #630^3240903.10284^89"
^DIC(9.4,60,22,13,"PAH",604,1,0)="^^11^11^3240903"
^DIC(9.4,60,22,13,"PAH",604,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,60,22,13,"PAH",604,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",604,1,3,0)="Ticket INC28706897:"
^DIC(9.4,60,22,13,"PAH",604,1,4,0)="-------------------"
^DIC(9.4,60,22,13,"PAH",604,1,5,0)="Problem 1 - Missing Activity Log Header Node for old prescriptions."
^DIC(9.4,60,22,13,"PAH",604,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",604,1,7,0)="Problem 2 - ATP+4^PSO52API error occurring for MyHealtheVet queries for"
^DIC(9.4,60,22,13,"PAH",604,1,8,0)="prescriptions missing the Activity Log Header node."
^DIC(9.4,60,22,13,"PAH",604,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",604,1,10,0)="Problem 3 - Activity Log Header node not updated on a Dosage Edit in"
^DIC(9.4,60,22,13,"PAH",604,1,11,0)="Patient Prescription Processing [PSO LM BACKDOOR ORDERS]. "
^DIC(9.4,60,22,13,"PAH",605,0)="753 SEQ #631^3240903.103825^89"
^DIC(9.4,60,22,13,"PAH",605,1,0)="^^1^1^3240903"
^DIC(9.4,60,22,13,"PAH",605,1,1,0)="See FORUM patch description."
^DIC(9.4,60,22,13,"PAH",606,0)="732 SEQ #632^3241004.101815^89"
^DIC(9.4,60,22,13,"PAH",606,1,0)="^^1^1^3241004"
^DIC(9.4,60,22,13,"PAH",606,1,1,0)="See FORUM for patch description."
^DIC(9.4,60,22,13,"PAH",607,0)="747^3241017.104833^89"
^DIC(9.4,60,22,13,"PAH",608,0)="769 SEQ #633^3241017.105325^89"
^DIC(9.4,60,22,13,"PAH",608,1,0)="^^118^118^3241017"
^DIC(9.4,60,22,13,"PAH",608,1,1,0)="This patch is being released to address a few small eRx related issues"
^DIC(9.4,60,22,13,"PAH",608,1,2,0)="encountered after the patch PSO*7*746 was released:"
^DIC(9.4,60,22,13,"PAH",608,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,4,0)="1. Written Date with Time display issue"
^DIC(9.4,60,22,13,"PAH",608,1,5,0)="2. Changed ADDITIONAL NOTE TO PROVIDER prompt to SUGGESTED PROVIDER NOTE "
^DIC(9.4,60,22,13,"PAH",608,1,6,0)="   (FOR RESPONSE RX) + Default for eRx drug selection"
^DIC(9.4,60,22,13,"PAH",608,1,7,0)="3. View Suggestion(s) action fix"
^DIC(9.4,60,22,13,"PAH",608,1,8,0)="4. DUE (Drug Use Evaluation) Override Reason display issue"
^DIC(9.4,60,22,13,"PAH",608,1,9,0)="5. Print action fixes"
^DIC(9.4,60,22,13,"PAH",608,1,10,0)="6. NDC code included in the Requested Medication section of the eRx Rx Change"
^DIC(9.4,60,22,13,"PAH",608,1,11,0)="   Request"
^DIC(9.4,60,22,13,"PAH",608,1,12,0)="7. Complete Orders from eRx [PSO ERX FINISH] option removal"
^DIC(9.4,60,22,13,"PAH",608,1,13,0)="8. SIG over 512 characters cause a <SUBSRCIPT> error"
^DIC(9.4,60,22,13,"PAH",608,1,14,0)="    "
^DIC(9.4,60,22,13,"PAH",608,1,15,0)="1. Written Date with Time display issue"
^DIC(9.4,60,22,13,"PAH",608,1,16,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,17,0)="   Some prescribers send eRx's with a timestamp for the Written Date and "
^DIC(9.4,60,22,13,"PAH",608,1,18,0)="   this causes a display issue which overwrites the 'eRx Status' label as "
^DIC(9.4,60,22,13,"PAH",608,1,19,0)="   shown below:"
^DIC(9.4,60,22,13,"PAH",608,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,21,0)="   Single eRx View/Display       Aug 10, 2024@10:28:15        Page:  1 of  2"
^DIC(9.4,60,22,13,"PAH",608,1,22,0)="   eRx Patient: PATIENT,TEST                     eRx Reference #: 999999999"
^DIC(9.4,60,22,13,"PAH",608,1,23,0)="   eRx Msg Type: NEWRX                                     Written: 08/23/24"
^DIC(9.4,60,22,13,"PAH",608,1,24,0)="   @11:11:11s: W - WAIT"
^DIC(9.4,60,22,13,"PAH",608,1,25,0)="   ^^^^^^^^^"
^DIC(9.4,60,22,13,"PAH",608,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,27,0)="2. Changed ADDITIONAL NOTE TO PROVIDER prompt to SUGGESTED PROVIDER NOTE"
^DIC(9.4,60,22,13,"PAH",608,1,28,0)="   (FOR RESPONSE RX) + Default for eRx drug selection"
^DIC(9.4,60,22,13,"PAH",608,1,29,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,30,0)="   After verifying data from several Rx Responses from the prescriber it "
^DIC(9.4,60,22,13,"PAH",608,1,31,0)="   was determined that the prompt ADDITIONAL NOTE TO PROVIDER was wrongly"
^DIC(9.4,60,22,13,"PAH",608,1,32,0)="   worded. This field is not supposed to be used by Pharmacy to "
^DIC(9.4,60,22,13,"PAH",608,1,33,0)="   communicate with the prescriber, the correct use is for pharmacy to"
^DIC(9.4,60,22,13,"PAH",608,1,34,0)="   enter a suggested Provider Note content that the prescriber will then "
^DIC(9.4,60,22,13,"PAH",608,1,35,0)="   decide to keep, change or delete when adopting the requested medication."
^DIC(9.4,60,22,13,"PAH",608,1,36,0)="   Additionally, when the user is building the requested medication, if the"
^DIC(9.4,60,22,13,"PAH",608,1,37,0)="   user selects E (use eRx Drug) the Provider Notes content (if any) will"
^DIC(9.4,60,22,13,"PAH",608,1,38,0)="   be given as default for the Provider Notes in the medication requested,"
^DIC(9.4,60,22,13,"PAH",608,1,39,0)="   as shown below:"
^DIC(9.4,60,22,13,"PAH",608,1,40,0)="  "
^DIC(9.4,60,22,13,"PAH",608,1,41,0)="     SUGGESTED PROVIDER NOTE (FOR RESPONSE RX): Suggested Packaging: 2.0 "
^DIC(9.4,60,22,13,"PAH",608,1,42,0)="     Milliliters syringe.  Replace ??"
^DIC(9.4,60,22,13,"PAH",608,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,44,0)="      This is the suggested Provider Note that will be sent back with Rx "
^DIC(9.4,60,22,13,"PAH",608,1,45,0)="      Response if this drug option is selected by the outside Provider. It"
^DIC(9.4,60,22,13,"PAH",608,1,46,0)="      may be edited/removed by the Provider before sending the response"
^DIC(9.4,60,22,13,"PAH",608,1,47,0)="      back."
^DIC(9.4,60,22,13,"PAH",608,1,48,0)="  "
^DIC(9.4,60,22,13,"PAH",608,1,49,0)="3. View Suggestion(s) action fix"
^DIC(9.4,60,22,13,"PAH",608,1,50,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,51,0)="   Sometimes the VS (View Suggestion(s)) action does not show any suggestions"
^DIC(9.4,60,22,13,"PAH",608,1,52,0)="   and does not say 'No suggestions found' either. This is being fixed with"
^DIC(9.4,60,22,13,"PAH",608,1,53,0)="   this patch."
^DIC(9.4,60,22,13,"PAH",608,1,54,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,55,0)="4. DUE (Drug Use Evaluation) Override Reason display issue"
^DIC(9.4,60,22,13,"PAH",608,1,56,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,57,0)="   When the Override field from a DUE is longer than 28 characters it"
^DIC(9.4,60,22,13,"PAH",608,1,58,0)="   'spills' over into the next section (VistA), as shown below: "
^DIC(9.4,60,22,13,"PAH",608,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,60,0)="     Prescriber Drug Use Evaluation:        |________________________________"
^DIC(9.4,60,22,13,"PAH",608,1,61,0)="     Co-Agent:                              |3)Patient Instructions: "
^DIC(9.4,60,22,13,"PAH",608,1,62,0)="     Reason: Product Selection Opportunity  |                       "
^DIC(9.4,60,22,13,"PAH",608,1,63,0)="     Result:                                |                       "
^DIC(9.4,60,22,13,"PAH",608,1,64,0)="     Override: Substitute as necessary, ple |                       "
^DIC(9.4,60,22,13,"PAH",608,1,65,0)="                      ase provide documentat|on to                  "
^DIC(9.4,60,22,13,"PAH",608,1,66,0)="                       patient for assistanc|               "
^DIC(9.4,60,22,13,"PAH",608,1,67,0)="     "
^DIC(9.4,60,22,13,"PAH",608,1,68,0)="     After fix:"
^DIC(9.4,60,22,13,"PAH",608,1,69,0)="     --------- "
^DIC(9.4,60,22,13,"PAH",608,1,70,0)="     Prescriber Drug Use Evaluation:        |________________________________"
^DIC(9.4,60,22,13,"PAH",608,1,71,0)="     Co-Agent:                              |3)Patient Instructions: "
^DIC(9.4,60,22,13,"PAH",608,1,72,0)="     Reason: Product Selection Opportunity  |                       "
^DIC(9.4,60,22,13,"PAH",608,1,73,0)="     Result:                                |                       "
^DIC(9.4,60,22,13,"PAH",608,1,74,0)="     Override: Substitute as necessary, plea|                       "
^DIC(9.4,60,22,13,"PAH",608,1,75,0)="               se provide documentation to p|                  "
^DIC(9.4,60,22,13,"PAH",608,1,76,0)="               atient for assistance        |               "
^DIC(9.4,60,22,13,"PAH",608,1,77,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,78,0)="5. Print action fixes"
^DIC(9.4,60,22,13,"PAH",608,1,79,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,80,0)="   Two small changes were made to the Print action in the PATIENT INFORMATION"
^DIC(9.4,60,22,13,"PAH",608,1,81,0)="   section:"
^DIC(9.4,60,22,13,"PAH",608,1,82,0)="    - Fixed a misspelling of the label 'Nane:' to 'Name:'"
^DIC(9.4,60,22,13,"PAH",608,1,83,0)="    - Changed label 'Primary Telephone' to 'Primary Phone'"
^DIC(9.4,60,22,13,"PAH",608,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,85,0)="6. NDC code included in the Requested Medication section of the eRx Rx Change"
^DIC(9.4,60,22,13,"PAH",608,1,86,0)="   Request"
^DIC(9.4,60,22,13,"PAH",608,1,87,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,88,0)="   Sometimes when an RX Change Request is sent the outside prescriber "
^DIC(9.4,60,22,13,"PAH",608,1,89,0)="   software returns an error saying the drug suggested is not recognized."
^DIC(9.4,60,22,13,"PAH",608,1,90,0)="   This issue happens when the user selects a VistA drug for the Requested "
^DIC(9.4,60,22,13,"PAH",608,1,91,0)="   Medication and the VistA NDC for this drug is not recognized by the "
^DIC(9.4,60,22,13,"PAH",608,1,92,0)="   prescriber software. In order to facilitate the troubleshooting of such"
^DIC(9.4,60,22,13,"PAH",608,1,93,0)="   issue the NDC sent to the prescriber for the Requested Medication will "
^DIC(9.4,60,22,13,"PAH",608,1,94,0)="   now be displayed in the Requested Medication of the Rx Change Request"
^DIC(9.4,60,22,13,"PAH",608,1,95,0)="   section, as shown below:"
^DIC(9.4,60,22,13,"PAH",608,1,96,0)="   "
^DIC(9.4,60,22,13,"PAH",608,1,97,0)="    --------------------------MEDICATION REQUESTED 1-------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,98,0)="    Drug: NAPROXEN 250MG TAB                                                 "
^DIC(9.4,60,22,13,"PAH",608,1,99,0)="    Substitutions: YES                                    NDC: 77771-0434-05"
^DIC(9.4,60,22,13,"PAH",608,1,100,0)="    Note: Aware of Allergy. Patient Tolerates                        "
^DIC(9.4,60,22,13,"PAH",608,1,101,0)="    Qty: 30                Refills: 5           Days Supply: 180     "
^DIC(9.4,60,22,13,"PAH",608,1,102,0)="    Quantity Unit Of Measure: TABLET DOSING UNIT                "
^DIC(9.4,60,22,13,"PAH",608,1,103,0)="    Sig: TAKE 1 TAB PO DAILY                                    "
^DIC(9.4,60,22,13,"PAH",608,1,104,0)="    ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",608,1,106,0)="7. Complete Orders from eRx [PSO ERX FINISH] option removal"
^DIC(9.4,60,22,13,"PAH",608,1,107,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,108,0)="   The Complete Orders from eRx [PSO ERX FINISH] option was put Out-of-Order "
^DIC(9.4,60,22,13,"PAH",608,1,109,0)="   by the PSO*7*746 patch because its functionality has been fully replaced"
^DIC(9.4,60,22,13,"PAH",608,1,110,0)="   by the eRx Holding Queue Processing [PSO ERX QUEUE PROCESSING] option. "
^DIC(9.4,60,22,13,"PAH",608,1,111,0)="   This patch will now remove/delete this obsolete option from your menu."
^DIC(9.4,60,22,13,"PAH",608,1,112,0)="   "
^DIC(9.4,60,22,13,"PAH",608,1,113,0)="8. SIG over 512 characters cause a <SUBSRCIPT> error"
^DIC(9.4,60,22,13,"PAH",608,1,114,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",608,1,115,0)="   When the user tried to select the VistA drug to match the eRx drug and"
^DIC(9.4,60,22,13,"PAH",608,1,116,0)="   a VistA suggestion exists with a SIG that is longer than 512 characters"
^DIC(9.4,60,22,13,"PAH",608,1,117,0)="   they software throws a <SUBSCRIPT> error, which will be addressed by this"
^DIC(9.4,60,22,13,"PAH",608,1,118,0)="   patch."
^DIC(9.4,60,22,13,"PAH",609,0)="771 SEQ #635^3241030.123519^89"
^DIC(9.4,60,22,13,"PAH",609,1,0)="^^1^1^3241030"
^DIC(9.4,60,22,13,"PAH",609,1,1,0)="See FORUM for patch description details."
