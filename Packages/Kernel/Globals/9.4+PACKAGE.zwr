^DIC(9.4,14,22,5.9,"PAH",176,1,104,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",176,1,105,0)="PSI-05-068 "
^DIC(9.4,14,22,5.9,"PAH",176,1,106,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,108,0)="Test Sites"
^DIC(9.4,14,22,5.9,"PAH",176,1,109,0)="=========="
^DIC(9.4,14,22,5.9,"PAH",176,1,110,0)="DURHAM, NC -VAMC (Large site)"
^DIC(9.4,14,22,5.9,"PAH",176,1,111,0)="NORTHERN CALIFORNIA HCS (Large site) "
^DIC(9.4,14,22,5.9,"PAH",176,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,113,0)=" "
