^DIC(9.4,180,22,2,"PAH",48,0)="35^3170313.145326^54"
^DIC(9.4,180,22,2,"PAH",48,1,0)="^^2^2^3170313"
^DIC(9.4,180,22,2,"PAH",48,1,1,0)="National Clinical Reminders content updates: VA-LIFE-SUSTAINING TREATEMENT."
^DIC(9.4,180,22,2,"PAH",48,1,2,0)=""
^DIC(9.4,180,22,2,"PAH",49,0)="19^3170726.131953^54"
^DIC(9.4,180,22,2,"PAH",49,1,0)="^^2^2^3170726"
^DIC(9.4,180,22,2,"PAH",49,1,1,0)="Contains the Reminder Definitions, Dialogs, and associated components to "
^DIC(9.4,180,22,2,"PAH",49,1,2,0)="create the standardized national template set for Home Telehealth (HT)."
^DIC(9.4,180,22,2,"PAH",50,0)="47^3171227.135752^54"
^DIC(9.4,180,22,2,"PAH",50,1,0)="^^3^3^3171227"
^DIC(9.4,180,22,2,"PAH",50,1,1,0)="Clinical Reminders ICD-10 follow-up build."
^DIC(9.4,180,22,2,"PAH",50,1,2,0)=""
^DIC(9.4,180,22,2,"PAH",50,1,3,0)=""
^DIC(9.4,180,22,2,"PAH",51,0)="68 SEQ #52^3171227.162746^54"
^DIC(9.4,180,22,2,"PAH",51,1,0)="^^2^2^3171227"
^DIC(9.4,180,22,2,"PAH",51,1,1,0)="This patch will:"
^DIC(9.4,180,22,2,"PAH",51,1,2,0)=" - Inactivate MyHealtheVet (MHV) Reminders."
^DIC(9.4,180,22,2,"PAH",52,0)="72^3200420.124059^70"
^DIC(9.4,180,22,2,"PAH",53,0)="45^3200624.121443^65"
^DIC(9.4,180,22,2,"PAH",53,1,0)="^^8^8^3200624"
^DIC(9.4,180,22,2,"PAH",53,1,1,0)="This patch modifies the Clinical Reminders package to improve monitoring "
^DIC(9.4,180,22,2,"PAH",53,1,2,0)="of teratogens prescribed or administered to women of childbearing age.  "
^DIC(9.4,180,22,2,"PAH",53,1,3,0)="Specifically, the software now prompts providers to document a woman's "
^DIC(9.4,180,22,2,"PAH",53,1,4,0)="pregnancy and lacation status when appropriate using reminder dialogs."
^DIC(9.4,180,22,2,"PAH",53,1,5,0)=" "
^DIC(9.4,180,22,2,"PAH",53,1,6,0)="Please see the accompanying patch description for details and the "
^DIC(9.4,180,22,2,"PAH",53,1,7,0)="Computerized Patient Record System (CPRS) version 31 installation manual "
^DIC(9.4,180,22,2,"PAH",53,1,8,0)="for installation instructions."
^DIC(9.4,180,22,2,"PAH",54,0)="46^3200713.171131^65"
^DIC(9.4,180,22,2,"PAH",54,1,0)="^^2^2^3200713"
^DIC(9.4,180,22,2,"PAH",54,1,1,0)="Updates for COVID-19 status banner."
^DIC(9.4,180,22,2,"PAH",54,1,2,0)=""
^DIC(9.4,180,22,2,"PAH",55,0)="74 SEQ #56^3200819.113011^65"
^DIC(9.4,180,22,2,"PAH",56,0)="44^3210310.120602^17"
^DIC(9.4,180,22,2,"PAH",56,1,0)="^^2^2^3210310"
^DIC(9.4,180,22,2,"PAH",56,1,1,0)="Previous diagnosis API."
^DIC(9.4,180,22,2,"PAH",56,1,2,0)=""
^DIC(9.4,180,22,2,"PAH",57,0)="75b^3210429"
^DIC(9.4,180,22,2,"PAH",57,1,0)="^^5^5^3210429"
^DIC(9.4,180,22,2,"PAH",57,1,1,0)="Backup of PXRM*2.0*75 on Apr 29, 2021"
^DIC(9.4,180,22,2,"PAH",57,1,2,0)=" "
^DIC(9.4,180,22,2,"PAH",57,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,180,22,2,"PAH",57,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,180,22,2,"PAH",57,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,180,22,2,"PAH",58,0)="75 SEQ #58^3210429.142326^17"
^DIC(9.4,180,22,2,"PAH",58,1,0)="^^2^2^3210429"
^DIC(9.4,180,22,2,"PAH",58,1,1,0)="This patch address a problem with male radiology reports merging across a "
^DIC(9.4,180,22,2,"PAH",58,1,2,0)="patients."
^DIC(9.4,180,22,2,"PAH",59,0)="42^3210504.155729^17"
^DIC(9.4,180,22,2,"PAH",59,1,0)="^^13^13^3210504"
^DIC(9.4,180,22,2,"PAH",59,1,1,0)="This patch supports PCE standardization."
^DIC(9.4,180,22,2,"PAH",59,1,2,0)=""
^DIC(9.4,180,22,2,"PAH",59,1,3,0)="To take full advantage of the PCE standardization work, changes to VistA"
^DIC(9.4,180,22,2,"PAH",59,1,4,0)="applications that use PCE data are required. These applications include"
^DIC(9.4,180,22,2,"PAH",59,1,5,0)="Clinical Reminders, Health Summary, Problem List, and Order Entry/Results"
^DIC(9.4,180,22,2,"PAH",59,1,6,0)="Reporting. To make it easier for sites, the builds for PCE (PX*1.0*211),"
^DIC(9.4,180,22,2,"PAH",59,1,7,0)="Clinical Reminders (PXRM*2.0*42), Health Summary (GMTS*2.7*122), Problem List"
^DIC(9.4,180,22,2,"PAH",59,1,8,0)="(GMPL*2.0*53), and Order Entry/Results Reporting (OR*3.0*501) are being"
^DIC(9.4,180,22,2,"PAH",59,1,9,0)="distributed in a multi-package build named PCE STANDARDIZATION 1.0."
^DIC(9.4,180,22,2,"PAH",59,1,10,0)=" "
^DIC(9.4,180,22,2,"PAH",59,1,11,0)="For detailed information and installation instructions, please see the PCE"
^DIC(9.4,180,22,2,"PAH",59,1,12,0)="Standardization 1.0 Installation Guide."
^DIC(9.4,180,22,2,"PAH",59,1,13,0)=""
