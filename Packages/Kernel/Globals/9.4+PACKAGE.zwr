^DIC(9.4,59,22,5,"PAH",419,0)="406 SEQ #420^3150507.090406^17"
^DIC(9.4,59,22,5,"PAH",419,1,0)="^^5^5^3150507"
^DIC(9.4,59,22,5,"PAH",419,1,1,0)="Patch PSN*4.0*406 addresses the following issue:"
^DIC(9.4,59,22,5,"PAH",419,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",419,1,3,0)="1.      When entering allergies for patients the software allows for"
^DIC(9.4,59,22,5,"PAH",419,1,4,0)="assigning inactive Drug Ingredients from the Drug Ingredients file "
^DIC(9.4,59,22,5,"PAH",419,1,5,0)="(#50.416) as Causative Agents."
