^DIC(9.4,13,22,8,"PAH",10,1,103,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,104,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",10,1,105,0)="===================="
^DIC(9.4,13,22,8,"PAH",10,1,106,0)=" White River Junction, VT "
^DIC(9.4,13,22,8,"PAH",10,1,107,0)=" Hampton, VA "
^DIC(9.4,13,22,8,"PAH",10,1,108,0)=" "
^DIC(9.4,13,22,8,"PAH",10,1,109,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",10,1,110,0)="================"
^DIC(9.4,13,22,8,"PAH",10,1,111,0)=" The following routines are included in this patch.  The second line of "
^DIC(9.4,13,22,8,"PAH",10,1,112,0)="these routines now look like: "
^DIC(9.4,13,22,8,"PAH",10,1,113,0)="  "
^DIC(9.4,13,22,8,"PAH",10,1,114,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",10,1,115,0)="  "
^DIC(9.4,13,22,8,"PAH",10,1,116,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",10,1,117,0)="  "
