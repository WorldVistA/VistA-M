^DIC(9.4,59,22,5,"PAH",262,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",262,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",262,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",262,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",262,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",262,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",262,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",262,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",262,1,17,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",263,0)="275^3110321.143105^17"
^DIC(9.4,59,22,5,"PAH",263,1,0)="^^16^16^3110321"
^DIC(9.4,59,22,5,"PAH",263,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",263,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",263,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",263,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",263,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",263,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",263,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",263,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",263,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",263,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",263,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",263,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",263,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",263,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",263,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",263,1,16,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",264,0)="276^3110321.143138^17"
^DIC(9.4,59,22,5,"PAH",264,1,0)="^^4^4^3110321"
^DIC(9.4,59,22,5,"PAH",264,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",264,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",264,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",264,1,4,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",265,0)="277^3110411.113434^17"
^DIC(9.4,59,22,5,"PAH",265,1,0)="^^17^17^3110411"
^DIC(9.4,59,22,5,"PAH",265,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",265,1,2,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",265,1,3,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",265,1,4,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",265,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",265,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",265,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",265,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",265,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",265,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",265,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",265,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",265,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",265,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",265,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",265,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",265,1,17,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",266,0)="278^3110428.161003^17"
^DIC(9.4,59,22,5,"PAH",266,1,0)="^^16^16^3110428"
^DIC(9.4,59,22,5,"PAH",266,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",266,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",266,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",266,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",266,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",266,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",266,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",266,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",266,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",266,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",266,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",266,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",266,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",266,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",266,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",266,1,16,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",267,0)="279^3110428.161202^17"
^DIC(9.4,59,22,5,"PAH",267,1,0)="^^4^4^3110428"
^DIC(9.4,59,22,5,"PAH",267,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",267,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",267,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",267,1,4,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",268,0)="263 SEQ #268^3110428.161434^17"
^DIC(9.4,59,22,5,"PAH",268,1,0)="^^186^186^3110428"
^DIC(9.4,59,22,5,"PAH",268,1,1,0)="This patch contains software modifications to the National Drug File (NDF)"
^DIC(9.4,59,22,5,"PAH",268,1,2,0)="V. 4.0 application to support the FDA Medication Guides project. The "
^DIC(9.4,59,22,5,"PAH",268,1,3,0)="project objective is to allow pharmacy staff to retrieve the FDA Medication "
^DIC(9.4,59,22,5,"PAH",268,1,4,0)="Guide for prescription items that contain FDA approved information that"
^DIC(9.4,59,22,5,"PAH",268,1,5,0)="can help patients avoid adverse events. The FDA requires that Medication"
^DIC(9.4,59,22,5,"PAH",268,1,6,0)="Guides be included with certain prescribed drugs and biological products "
^DIC(9.4,59,22,5,"PAH",268,1,7,0)="when the Agency determines that: "
^DIC(9.4,59,22,5,"PAH",268,1,8,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,9,0)=" . Certain information is necessary to prevent serious adverse effects "
^DIC(9.4,59,22,5,"PAH",268,1,10,0)=" . Patient decision-making should be advised by information about a known"
^DIC(9.4,59,22,5,"PAH",268,1,11,0)="   serious side effect with a product, or "
^DIC(9.4,59,22,5,"PAH",268,1,12,0)=" . Patient adherence to directions for the use of a product is essential"
^DIC(9.4,59,22,5,"PAH",268,1,13,0)="   to its effectiveness. "
^DIC(9.4,59,22,5,"PAH",268,1,14,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,15,0)="The features in the FDA Medication Guides project are being delivered in"
^DIC(9.4,59,22,5,"PAH",268,1,16,0)="incremental releases. This patch is part of the Increment 2 release. The "
^DIC(9.4,59,22,5,"PAH",268,1,17,0)="features included in this release are:"
^DIC(9.4,59,22,5,"PAH",268,1,18,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,19,0)=" . Establishment of a Server Repository for FDA Medication Guides within "
^DIC(9.4,59,22,5,"PAH",268,1,20,0)="   the VA network."
^DIC(9.4,59,22,5,"PAH",268,1,21,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,22,0)=" . Updates to 900+ entries in the VA PRODUCT file (#50.68) to store the "
^DIC(9.4,59,22,5,"PAH",268,1,23,0)="   corresponding FDA Medication Guide document name will be provided via"
^DIC(9.4,59,22,5,"PAH",268,1,24,0)="   the NDF Monthly Data Update patches."
^DIC(9.4,59,22,5,"PAH",268,1,25,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,26,0)=" . Introduction of a PC based Java software component to enable the"
^DIC(9.4,59,22,5,"PAH",268,1,27,0)="   automatic retrieval of an FDA Medication Guide from within VistA. The"
^DIC(9.4,59,22,5,"PAH",268,1,28,0)="   software does not require any direct user interaction. It works as a "
^DIC(9.4,59,22,5,"PAH",268,1,29,0)="   bridge between VistA and the PC where it is installed. The software "
^DIC(9.4,59,22,5,"PAH",268,1,30,0)="   identifies a request from VistA for a specific FDA Medication Guide and"
^DIC(9.4,59,22,5,"PAH",268,1,31,0)="   automatically retrieves it from the Server Repository and displays to the"
^DIC(9.4,59,22,5,"PAH",268,1,32,0)="   user via the Internet Explorer browser. "
^DIC(9.4,59,22,5,"PAH",268,1,33,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,34,0)=" . Introduction of a new option called Display FDA Medication Guide [PSN MED"
^DIC(9.4,59,22,5,"PAH",268,1,35,0)="   GUIDE] to the National Drug File V. 4.0 application for retrieving and "
^DIC(9.4,59,22,5,"PAH",268,1,36,0)="   displaying the FDA Medication Guide for a specific VA Product."
^DIC(9.4,59,22,5,"PAH",268,1,37,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,38,0)=" . Introduction of new functionality to the Patient Prescription Processing"
^DIC(9.4,59,22,5,"PAH",268,1,39,0)="   [PSO LM BACKDOOR] option in the Outpatient Pharmacy V. 7.0 application"
^DIC(9.4,59,22,5,"PAH",268,1,40,0)="   for retrieving and displaying the FDA Medication Guide for a specific "
^DIC(9.4,59,22,5,"PAH",268,1,41,0)="   prescription."
^DIC(9.4,59,22,5,"PAH",268,1,42,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,43,0)="Below is a list of all the applications involved in this release along"
^DIC(9.4,59,22,5,"PAH",268,1,44,0)="with their patch number:"
^DIC(9.4,59,22,5,"PAH",268,1,45,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,46,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,59,22,5,"PAH",268,1,47,0)="   -----------------------------------------------------------------"
^DIC(9.4,59,22,5,"PAH",268,1,48,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*158"
^DIC(9.4,59,22,5,"PAH",268,1,49,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                      PSN*4*263"
^DIC(9.4,59,22,5,"PAH",268,1,50,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*343"
^DIC(9.4,59,22,5,"PAH",268,1,51,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,52,0)="The FDA Medication Guides project is expected to complete in three"
^DIC(9.4,59,22,5,"PAH",268,1,53,0)="increments. Among other features, the next Increment will automate the"
^DIC(9.4,59,22,5,"PAH",268,1,54,0)="printing of FDA Medication Guides for prescriptions dispensed by the VA"
^DIC(9.4,59,22,5,"PAH",268,1,55,0)="via Outpatient Pharmacy application when the prescription label is printed."
^DIC(9.4,59,22,5,"PAH",268,1,56,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,57,0)="The following modifications are included in this patch (PSN*4*263):"
^DIC(9.4,59,22,5,"PAH",268,1,58,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,59,0)="  A. FDA    Display FDA Medication Guide [PSN MED GUIDE] option"
^DIC(9.4,59,22,5,"PAH",268,1,60,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,61,0)="  Users will be able to retrieve an FDA Medication Guide for a specific VA"
^DIC(9.4,59,22,5,"PAH",268,1,62,0)="  Product by invoking this option. A Java software component running at the"
^DIC(9.4,59,22,5,"PAH",268,1,63,0)="  user's PC will then display the FDA Medication Guide Adobe Acrobat "
^DIC(9.4,59,22,5,"PAH",268,1,64,0)="  document (.pdf) by automatically opening it via the user's default web"
^DIC(9.4,59,22,5,"PAH",268,1,65,0)="  browser, which will allow the users to print it to any printer available"
^DIC(9.4,59,22,5,"PAH",268,1,66,0)="  to them, as seen below:"
^DIC(9.4,59,22,5,"PAH",268,1,67,0)="       "
^DIC(9.4,59,22,5,"PAH",268,1,68,0)="  Select VA PRODUCT NAME: LINDAINE"
^DIC(9.4,59,22,5,"PAH",268,1,69,0)="       1   LINDANE 1% CREAM,TOP  "
^DIC(9.4,59,22,5,"PAH",268,1,70,0)="       2   LINDANE 1% LIQUID,TOP  "
^DIC(9.4,59,22,5,"PAH",268,1,71,0)="       3   LINDANE 1% LOTION  "
^DIC(9.4,59,22,5,"PAH",268,1,72,0)="       4   LINDANE 1% SHAMPOO  "
^DIC(9.4,59,22,5,"PAH",268,1,73,0)="  CHOOSE 1-4: 3  LINDANE 1% LOTION  "
^DIC(9.4,59,22,5,"PAH",268,1,74,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,75,0)="  The following URL provides the link to the FDA Medication Guide associated"
^DIC(9.4,59,22,5,"PAH",268,1,76,0)="  with this medication. Thin Client users: copy/paste the URL below into a"
^DIC(9.4,59,22,5,"PAH",268,1,77,0)="  browser to access the FDA Medication Guide for this drug:"
^DIC(9.4,59,22,5,"PAH",268,1,78,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,79,0)="  vaww.national.cmop.domain.ext/FDAMedGuides/Lindane_(Generic)_(2008).pdf"
^DIC(9.4,59,22,5,"PAH",268,1,80,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,81,0)="    [FDA Medication Guide .pdf document opens on the web browser]"
^DIC(9.4,59,22,5,"PAH",268,1,82,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,83,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,84,0)="  If a user tries to use this option from a computer which does not have"
^DIC(9.4,59,22,5,"PAH",268,1,85,0)="  the required Java software component installed, the following message"
^DIC(9.4,59,22,5,"PAH",268,1,86,0)="  will display:"
^DIC(9.4,59,22,5,"PAH",268,1,87,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,88,0)="  Select VA PRODUCT NAME: LINDAINE"
^DIC(9.4,59,22,5,"PAH",268,1,89,0)="       1   LINDANE 1% CREAM,TOP  "
^DIC(9.4,59,22,5,"PAH",268,1,90,0)="       2   LINDANE 1% LIQUID,TOP  "
^DIC(9.4,59,22,5,"PAH",268,1,91,0)="       3   LINDANE 1% LOTION  "
^DIC(9.4,59,22,5,"PAH",268,1,92,0)="       4   LINDANE 1% SHAMPOO  "
^DIC(9.4,59,22,5,"PAH",268,1,93,0)="  CHOOSE 1-4: 3  LINDANE 1% LOTION  "
^DIC(9.4,59,22,5,"PAH",268,1,94,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,95,0)="  The following URL provides the link to the FDA Medication Guide associated"
^DIC(9.4,59,22,5,"PAH",268,1,96,0)="  with this medication. Thin Client users: copy/paste the URL below into a"
^DIC(9.4,59,22,5,"PAH",268,1,97,0)="  browser to access the FDA Medication Guide for this drug:"
^DIC(9.4,59,22,5,"PAH",268,1,98,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,99,0)="  vaww.national.cmop.domain.ext/FDAMedGuides/Lindane_(Generic)_(2008).pdf"
^DIC(9.4,59,22,5,"PAH",268,1,100,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,101,0)="  Please wait... "
^DIC(9.4,59,22,5,"PAH",268,1,102,0)="     "
^DIC(9.4,59,22,5,"PAH",268,1,103,0)="  The system is unable to display FDA Med Guide automatically."
^DIC(9.4,59,22,5,"PAH",268,1,104,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,105,0)="  The FDA Medication Guide will not automatically open on Thin Client and some"
^DIC(9.4,59,22,5,"PAH",268,1,106,0)="  types of encrypted sessions. If you do not believe this is the reason contact"
^DIC(9.4,59,22,5,"PAH",268,1,107,0)="  your local technical support for assistance."
^DIC(9.4,59,22,5,"PAH",268,1,108,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,109,0)="  You can copy/paste the link above into your browser's address bar to retrieve"
^DIC(9.4,59,22,5,"PAH",268,1,110,0)="  the FDA Medication Guide."
^DIC(9.4,59,22,5,"PAH",268,1,111,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,112,0)="  Enter RETURN to continue, '?' for HELP, or '^' to exit: ?"
^DIC(9.4,59,22,5,"PAH",268,1,113,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,114,0)="  When unable to get the FDA Medication Guide to display, review the following"
^DIC(9.4,59,22,5,"PAH",268,1,115,0)="  suggestion(s) for troubleshooting potential problems:"
^DIC(9.4,59,22,5,"PAH",268,1,116,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,117,0)="  1) The browser did not open automatically. This may be due to the following:"
^DIC(9.4,59,22,5,"PAH",268,1,118,0)="     - You might be connected to VistA via Thin Client or an encrypted session"
^DIC(9.4,59,22,5,"PAH",268,1,119,0)="       that prevents the FDA Med Guide from automatically displaying. Please"
^DIC(9.4,59,22,5,"PAH",268,1,120,0)="       copy and paste the URL link below into your browser's address bar to"
^DIC(9.4,59,22,5,"PAH",268,1,121,0)="       retrieve the FDA Medication Guide:"
^DIC(9.4,59,22,5,"PAH",268,1,122,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,123,0)="   vaww.national.cmop.domain.ext/FDAMedGuides/Lindane_Lotion_(Generic)_(2008).pdf"
^DIC(9.4,59,22,5,"PAH",268,1,124,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,125,0)="     - The computer might not have the required Java software component"
^DIC(9.4,59,22,5,"PAH",268,1,126,0)="       installed or the software might not be functioning properly. Please,"
^DIC(9.4,59,22,5,"PAH",268,1,127,0)="       contact technical support for assistance."
^DIC(9.4,59,22,5,"PAH",268,1,128,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,129,0)="  2) When doing a copy/paste of the link into the browser's address and an HTTP"
^DIC(9.4,59,22,5,"PAH",268,1,130,0)="     404 - File Not Found error is received. This may be due to the following:"
^DIC(9.4,59,22,5,"PAH",268,1,131,0)="     - A common issue exists when the link is displayed in two lines in the"
^DIC(9.4,59,22,5,"PAH",268,1,132,0)="       terminal screen. When you copy both lines at the same time and paste it"
^DIC(9.4,59,22,5,"PAH",268,1,133,0)="       into the browser's address, the second line is ignored by the browser"
^DIC(9.4,59,22,5,"PAH",268,1,134,0)="       resulting in a 'broken' link. To resolve this issue, copy and paste one"
^DIC(9.4,59,22,5,"PAH",268,1,135,0)="       line at a time from the terminal screen into the browser's address to"
^DIC(9.4,59,22,5,"PAH",268,1,136,0)="       make sure the complete link is used."
^DIC(9.4,59,22,5,"PAH",268,1,137,0)="     - The FDA Medication Guide Server may be down at the moment. Please, wait"
^DIC(9.4,59,22,5,"PAH",268,1,138,0)="       a few minutes and try again. If the problem persists, contact technical"
^DIC(9.4,59,22,5,"PAH",268,1,139,0)="       support for assistance."
^DIC(9.4,59,22,5,"PAH",268,1,140,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,141,0)="  3) The browser opened automatically, however you receive an HTTP 404 - File"
^DIC(9.4,59,22,5,"PAH",268,1,142,0)="     Not Found error. This may be due to the following:"
^DIC(9.4,59,22,5,"PAH",268,1,143,0)="     - The FDA Medication Guide Server may be down at the moment. Please, wait"
^DIC(9.4,59,22,5,"PAH",268,1,144,0)="       a few minutes and try again. If the problem persists, contact technical"
^DIC(9.4,59,22,5,"PAH",268,1,145,0)="       support for assistance."
^DIC(9.4,59,22,5,"PAH",268,1,146,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,147,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,148,0)="  If a user tries to use this option for a medication that does not have an FDA"
^DIC(9.4,59,22,5,"PAH",268,1,149,0)="  Medication Guide on file, the following message will display:"
^DIC(9.4,59,22,5,"PAH",268,1,150,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,151,0)="   Select VA PRODUCT NAME: ALLO"
^DIC(9.4,59,22,5,"PAH",268,1,152,0)="       1   ALLOPURINOL 100MG TAB  "
^DIC(9.4,59,22,5,"PAH",268,1,153,0)="       2   ALLOPURINOL 100MG TAB,UD  "
^DIC(9.4,59,22,5,"PAH",268,1,154,0)="       3   ALLOPURINOL 300MG TAB  "
^DIC(9.4,59,22,5,"PAH",268,1,155,0)="       4   ALLOPURINOL 300MG TAB,UD  "
^DIC(9.4,59,22,5,"PAH",268,1,156,0)="       5   ALLOPURINOL NA 500MG/VIL INJ  "
^DIC(9.4,59,22,5,"PAH",268,1,157,0)="   CHOOSE 1-5:  1 ALLOPURINOL 100MG TAB  "
^DIC(9.4,59,22,5,"PAH",268,1,158,0)="      "
^DIC(9.4,59,22,5,"PAH",268,1,159,0)="   There is no FDA Medication Guide associated with this medication."
^DIC(9.4,59,22,5,"PAH",268,1,160,0)="  "
^DIC(9.4,59,22,5,"PAH",268,1,161,0)="   Enter RETURN to continue, '?' for HELP, or '^' to exit: ?"
^DIC(9.4,59,22,5,"PAH",268,1,162,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,163,0)="   When unable to get the FDA Medication Guide to display, review the following"
^DIC(9.4,59,22,5,"PAH",268,1,164,0)="   suggestion(s) for troubleshooting potential problems:"
^DIC(9.4,59,22,5,"PAH",268,1,165,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,166,0)="   1) If no FDA Medication Guide exists for a product that you believe should"
^DIC(9.4,59,22,5,"PAH",268,1,167,0)="      have one, confirm that one is required by visiting the FDA website"
^DIC(9.4,59,22,5,"PAH",268,1,168,0)="      (www.fda.gov). If one is required, log a support ticket to request its"
^DIC(9.4,59,22,5,"PAH",268,1,169,0)="      addition. Please understand that there may be a delay between the time"
^DIC(9.4,59,22,5,"PAH",268,1,170,0)="      that a new Medication Guide is posted to the FDA website and when it is"
^DIC(9.4,59,22,5,"PAH",268,1,171,0)="      made available in VistA through a National Drug File data update patch."
^DIC(9.4,59,22,5,"PAH",268,1,172,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,173,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,174,0)="  Note: This option requires a Java software component to be installed on"
^DIC(9.4,59,22,5,"PAH",268,1,175,0)="  ----  the user's computer. This software will be released as part of this"
^DIC(9.4,59,22,5,"PAH",268,1,176,0)="        project. Please, refer to the project Release Notes and Installation"
^DIC(9.4,59,22,5,"PAH",268,1,177,0)="        Guide documentation for further information."
^DIC(9.4,59,22,5,"PAH",268,1,178,0)="   "
^DIC(9.4,59,22,5,"PAH",268,1,179,0)=" "
^DIC(9.4,59,22,5,"PAH",268,1,180,0)="  B. The length of the FDA MED GUIDE field (#100) in the VA PRODUCT file"
^DIC(9.4,59,22,5,"PAH",268,1,181,0)="     (#50.68) is being modified from 245 characters to 100 characters. The "
^DIC(9.4,59,22,5,"PAH",268,1,182,0)="     field will now be used to store only the PDF file name of the FDA  "
^DIC(9.4,59,22,5,"PAH",268,1,183,0)="     Medication Guide rather than the complete link, which also had the web"
^DIC(9.4,59,22,5,"PAH",268,1,184,0)="     server URL. The web server URL is now being stored on a new field called "
^DIC(9.4,59,22,5,"PAH",268,1,185,0)="     FDA MED GUIDE SERVER URL (#100) in the PHARMACY SYSTEM (#59.7) file,"
^DIC(9.4,59,22,5,"PAH",268,1,186,0)="     which is introduced by patch PSS*1*158."
^DIC(9.4,59,22,5,"PAH",269,0)="262 SEQ #269^3110428.161541^17"
^DIC(9.4,59,22,5,"PAH",269,1,0)="^^61^61^3110428"
^DIC(9.4,59,22,5,"PAH",269,1,1,0)="This patch addresses the New Service Request (NSR) #20070434 to prevent"
^DIC(9.4,59,22,5,"PAH",269,1,2,0)="the inadvertent creation of supra-therapeutic possible dosages for high"
^DIC(9.4,59,22,5,"PAH",269,1,3,0)="risk medications during dosage creation performed during the matching and"
^DIC(9.4,59,22,5,"PAH",269,1,4,0)="re-matching of dispense drugs to National Drug File (NDF) entries within"
^DIC(9.4,59,22,5,"PAH",269,1,5,0)="the Pharmacy Data Management (PDM) V. 1.0 application."
^DIC(9.4,59,22,5,"PAH",269,1,6,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,7,0)="Patch PSN*4*261 has been previously released in preparation for this"
^DIC(9.4,59,22,5,"PAH",269,1,8,0)="project. It added the following 3 new fields to the VA PRODUCT file"
^DIC(9.4,59,22,5,"PAH",269,1,9,0)="(#50.68):"
^DIC(9.4,59,22,5,"PAH",269,1,10,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,11,0)="       CREATE DEFAULT POSSIBLE DOSAGE (#40)"
^DIC(9.4,59,22,5,"PAH",269,1,12,0)="       POSSIBLE DOSAGES TO CREATE (#41)"
^DIC(9.4,59,22,5,"PAH",269,1,13,0)="       PACKAGE (#42)"
^DIC(9.4,59,22,5,"PAH",269,1,14,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,15,0)="Patch PSN*4*262 is being released in conjunction with PDM patch PSS*1*155,"
^DIC(9.4,59,22,5,"PAH",269,1,16,0)="which has the functionality in place to determine if possible dosages"
^DIC(9.4,59,22,5,"PAH",269,1,17,0)="should be auto-created or not during the match/re-match process."
^DIC(9.4,59,22,5,"PAH",269,1,18,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,19,0)="This patch contains changes to the Inquire to National Files [PSNACT]"
^DIC(9.4,59,22,5,"PAH",269,1,20,0)="and Inquire to VA Product Info For Local Drug [PSNLOOK] options to include"
^DIC(9.4,59,22,5,"PAH",269,1,21,0)="the display of the new fields. Below are some screen captures of how the"
^DIC(9.4,59,22,5,"PAH",269,1,22,0)="new fields will display to the screen for both options:"
^DIC(9.4,59,22,5,"PAH",269,1,23,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,24,0)="   Example #1:"
^DIC(9.4,59,22,5,"PAH",269,1,25,0)="         ..."
^DIC(9.4,59,22,5,"PAH",269,1,26,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,27,0)="         Override DF Exclude from Dosage Checks: No"
^DIC(9.4,59,22,5,"PAH",269,1,28,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,29,0)="         Auto-Create Default Possible Dosage? Yes"
^DIC(9.4,59,22,5,"PAH",269,1,30,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,31,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,32,0)="   Example #2:"
^DIC(9.4,59,22,5,"PAH",269,1,33,0)="         ..."
^DIC(9.4,59,22,5,"PAH",269,1,34,0)="         Auto-Create Default Possible Dosage? No"
^DIC(9.4,59,22,5,"PAH",269,1,35,0)="             Possible Dosages To Auto-Create: No Possible Dosages"
^DIC(9.4,59,22,5,"PAH",269,1,36,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,37,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,38,0)="   Example #3:"
^DIC(9.4,59,22,5,"PAH",269,1,39,0)="         ..."
^DIC(9.4,59,22,5,"PAH",269,1,40,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,41,0)="         Override DF Exclude from Dosage Checks: No"
^DIC(9.4,59,22,5,"PAH",269,1,42,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,43,0)="         Auto-Create Default Possible Dosage? No"
^DIC(9.4,59,22,5,"PAH",269,1,44,0)="             Possible Dosages To Auto-Create: 1x and 2x Possible Dosages"
^DIC(9.4,59,22,5,"PAH",269,1,45,0)="                                     Package: Inpatient"
^DIC(9.4,59,22,5,"PAH",269,1,46,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,47,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,48,0)="NOTE: For more information about the new fields, please refer to the patch"
^DIC(9.4,59,22,5,"PAH",269,1,49,0)="      PSN*4*261. For information on how the new fields affect"
^DIC(9.4,59,22,5,"PAH",269,1,50,0)="      auto-creation of possible dosages during match and re-match"
^DIC(9.4,59,22,5,"PAH",269,1,51,0)="      process, refer to patch PSS*1*155."
^DIC(9.4,59,22,5,"PAH",269,1,52,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,53,0)="Also, this patch adds the component $$POSDOS to the routine PSNAPIS,"
^DIC(9.4,59,22,5,"PAH",269,1,54,0)="supported by Integration Control Registration (ICR) #2153, to retrieve the"
^DIC(9.4,59,22,5,"PAH",269,1,55,0)="content of these 3 new fields."
^DIC(9.4,59,22,5,"PAH",269,1,56,0)=" "
^DIC(9.4,59,22,5,"PAH",269,1,57,0)="In addition, a post-install routine will run to update the CREATE DEFAULT"
^DIC(9.4,59,22,5,"PAH",269,1,58,0)="POSSIBLE DOSAGE field (#40) with the default value of ""YES"" for entries"
^DIC(9.4,59,22,5,"PAH",269,1,59,0)="added to the VA PRODUCT file (#50.68) after patch PSN*4*261 was installed."
^DIC(9.4,59,22,5,"PAH",269,1,60,0)="The post-install routine will be automatically deleted from the system"
^DIC(9.4,59,22,5,"PAH",269,1,61,0)="upon completion of the installation."
^DIC(9.4,59,22,5,"PAH",270,0)="280^3110509.125159^17"
^DIC(9.4,59,22,5,"PAH",270,1,0)="^^17^17^3110509"
^DIC(9.4,59,22,5,"PAH",270,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",270,1,2,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",270,1,3,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",270,1,4,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",270,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",270,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",270,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",270,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",270,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",270,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",270,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",270,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",270,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",270,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",270,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",270,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",270,1,17,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",271,0)="281^3110518.145818^17"
^DIC(9.4,59,22,5,"PAH",271,1,0)="^^16^16^3110518"
^DIC(9.4,59,22,5,"PAH",271,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",271,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",271,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",271,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",271,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",271,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",271,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",271,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",271,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",271,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",271,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",271,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",271,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",271,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",271,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",271,1,16,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",272,0)="282^3110518.14591^17"
^DIC(9.4,59,22,5,"PAH",272,1,0)="^^4^4^3110518"
^DIC(9.4,59,22,5,"PAH",272,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",272,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",272,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",272,1,4,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",273,0)="283^3110608.101709^17"
^DIC(9.4,59,22,5,"PAH",273,1,0)="^^17^17^3110608"
^DIC(9.4,59,22,5,"PAH",273,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",273,1,2,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",273,1,3,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",273,1,4,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",273,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",273,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",273,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",273,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",273,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",273,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",273,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",273,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",273,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",273,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",273,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",273,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",273,1,17,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",274,0)="284^3110620.174334^17"
^DIC(9.4,59,22,5,"PAH",274,1,0)="^^16^16^3110620"
^DIC(9.4,59,22,5,"PAH",274,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",274,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",274,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",274,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",274,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",274,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",274,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",274,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",274,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",274,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",274,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",274,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",274,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",274,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",274,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",274,1,16,0)="are no longer primary ingredients."
