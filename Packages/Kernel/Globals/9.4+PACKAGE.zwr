^DIC(9.4,60,22,13,"PAH",414,1,213,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,214,0)="Pre/Post Installation Overview:"
^DIC(9.4,60,22,13,"PAH",414,1,215,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,216,0)="N/A"
^DIC(9.4,60,22,13,"PAH",414,1,217,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,218,0)="Pre-Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",414,1,219,0)="------------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,220,0)="N/A"
^DIC(9.4,60,22,13,"PAH",414,1,221,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,222,0)="Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",414,1,223,0)="--------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,224,0)="This process will install new and updated routines and other"
^DIC(9.4,60,22,13,"PAH",414,1,225,0)="components listed above. There is a post-install routine that will add"
^DIC(9.4,60,22,13,"PAH",414,1,226,0)="entries to a number of files."
^DIC(9.4,60,22,13,"PAH",414,1,227,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,228,0)="The patch will be released in conjunction with Integrated Billing"
^DIC(9.4,60,22,13,"PAH",414,1,229,0)="patch, IB*4.5*568, and Accounts Receivable, PRCA*4.5*315."
^DIC(9.4,60,22,13,"PAH",414,1,230,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,231,0)="  ************************ NOTE ************************"
^DIC(9.4,60,22,13,"PAH",414,1,232,0)="  IF A USER IS ON THE SYSTEM AND USING THESE PROGRAMS"
^DIC(9.4,60,22,13,"PAH",414,1,233,0)="  AN EDITED ERROR WILL OCCUR."
^DIC(9.4,60,22,13,"PAH",414,1,234,0)="  The patch should be installed when NO Outpatient"
^DIC(9.4,60,22,13,"PAH",414,1,235,0)="  Pharmacy users are on the system."
^DIC(9.4,60,22,13,"PAH",414,1,236,0)="  ******************************************************"
^DIC(9.4,60,22,13,"PAH",414,1,237,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,238,0)=" Installation will take less than 1 minute."
^DIC(9.4,60,22,13,"PAH",414,1,239,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,240,0)=" Suggested time to install: non-peak requirement hours."
^DIC(9.4,60,22,13,"PAH",414,1,241,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,242,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,243,0)="  1. Obtain the host file IB_2_568_PRCA_PSO_BUNDLE.KIDS which contains"
^DIC(9.4,60,22,13,"PAH",414,1,244,0)="     the following patches:"
^DIC(9.4,60,22,13,"PAH",414,1,245,0)="         IB*4.5*568"
^DIC(9.4,60,22,13,"PAH",414,1,246,0)="         PRCA*4.5*315"
^DIC(9.4,60,22,13,"PAH",414,1,247,0)="         PSO*7.0*463"
^DIC(9.4,60,22,13,"PAH",414,1,248,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,249,0)="  2. Startup KIDS"
^DIC(9.4,60,22,13,"PAH",414,1,250,0)="     -------------     Start up the Kernel Installation and Distribution "
^DIC(9.4,60,22,13,"PAH",414,1,251,0)="System Menu option"
^DIC(9.4,60,22,13,"PAH",414,1,252,0)="     [XPD MAIN]:"
^DIC(9.4,60,22,13,"PAH",414,1,253,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,254,0)="         Edits and Distribution ..."
^DIC(9.4,60,22,13,"PAH",414,1,255,0)="         Utilities ..."
^DIC(9.4,60,22,13,"PAH",414,1,256,0)="         Installation ..."
^DIC(9.4,60,22,13,"PAH",414,1,257,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,258,0)="     Select Kernel Installation & Distribution System Option: "
^DIC(9.4,60,22,13,"PAH",414,1,259,0)="INStallation                                                              "
^DIC(9.4,60,22,13,"PAH",414,1,260,0)="---"
^DIC(9.4,60,22,13,"PAH",414,1,261,0)="         Load a Distribution"
^DIC(9.4,60,22,13,"PAH",414,1,262,0)="         Print Transport Global"
^DIC(9.4,60,22,13,"PAH",414,1,263,0)="         Compare Transport Global to Current System"
^DIC(9.4,60,22,13,"PAH",414,1,264,0)="         Verify Checksums in Transport Global"
^DIC(9.4,60,22,13,"PAH",414,1,265,0)="         Install Package(s)"
^DIC(9.4,60,22,13,"PAH",414,1,266,0)="         Restart Install of Package(s)"
^DIC(9.4,60,22,13,"PAH",414,1,267,0)="         Unload a Distribution"
^DIC(9.4,60,22,13,"PAH",414,1,268,0)="         Backup a Transport Global"
^DIC(9.4,60,22,13,"PAH",414,1,269,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,270,0)="     Select Installation Option: "
^DIC(9.4,60,22,13,"PAH",414,1,271,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,272,0)="  3. LOAD TRANSPORT GLOBAL FOR MULTI-BUILD IB_2_568_PRCA_PSO_BUNDLE.KID"
^DIC(9.4,60,22,13,"PAH",414,1,273,0)="     -------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,274,0)="     From the Installation menu, select the Load a Distribution option."
^DIC(9.4,60,22,13,"PAH",414,1,275,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,276,0)="     When prompted for ""Enter a Host File:"", enter the full directory path"
^DIC(9.4,60,22,13,"PAH",414,1,277,0)="     where you saved the host file IB_2_568_PRCA_PSO_BUNDLE.KID (e.g.,"
^DIC(9.4,60,22,13,"PAH",414,1,278,0)="     SYS$SYSDEVICE:[ANONYMOUS] IB_2_568_PRCA_PSO_BUNDLE.KID)."
^DIC(9.4,60,22,13,"PAH",414,1,279,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,280,0)="     When prompted for ""OK to continue with Load? NO//"", enter ""YES.""  "
^DIC(9.4,60,22,13,"PAH",414,1,281,0)="     The following will display:"
^DIC(9.4,60,22,13,"PAH",414,1,282,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,283,0)="     Loading Distribution..."
^DIC(9.4,60,22,13,"PAH",414,1,284,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,285,0)="         IB*2.0*568"
^DIC(9.4,60,22,13,"PAH",414,1,286,0)="         PRCA*4.5*315"
^DIC(9.4,60,22,13,"PAH",414,1,287,0)="         PSO*7.0*463"
^DIC(9.4,60,22,13,"PAH",414,1,288,0)="  "
^DIC(9.4,60,22,13,"PAH",414,1,289,0)="         Use INSTALL NAME: IB*2.0*568to install this"
^DIC(9.4,60,22,13,"PAH",414,1,290,0)="         IB_2_568_PRCA_PSO_BUNDLE.KID distribution. "
^DIC(9.4,60,22,13,"PAH",414,1,291,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,292,0)="  4. From this menu, you may select to use the following options"
^DIC(9.4,60,22,13,"PAH",414,1,293,0)="     (when prompted for INSTALL NAME, enter IB*2.0*568):"
^DIC(9.4,60,22,13,"PAH",414,1,294,0)="         a.  Verify Checksums in Transport Global - This option will"
^DIC(9.4,60,22,13,"PAH",414,1,295,0)="             allow you to ensure the integrity of the routines that"
^DIC(9.4,60,22,13,"PAH",414,1,296,0)="             are in the transport global."
^DIC(9.4,60,22,13,"PAH",414,1,297,0)="         b.  Print Transport Global - This option will allow you to"
^DIC(9.4,60,22,13,"PAH",414,1,298,0)="             view the components of the KIDS build."
^DIC(9.4,60,22,13,"PAH",414,1,299,0)="         c.  Compare Transport Global to Current System - This "
^DIC(9.4,60,22,13,"PAH",414,1,300,0)="option             will allow you to view all changes that will be made "
^DIC(9.4,60,22,13,"PAH",414,1,301,0)="when"
^DIC(9.4,60,22,13,"PAH",414,1,302,0)="             this patch is installed.  It compares all components of"
^DIC(9.4,60,22,13,"PAH",414,1,303,0)="             this patch (routines, DD's, templates, etc.)."
^DIC(9.4,60,22,13,"PAH",414,1,304,0)="         d.  Backup a Transport Global - This option will create a"
^DIC(9.4,60,22,13,"PAH",414,1,305,0)="             backup message of any routines exported with this patch."
^DIC(9.4,60,22,13,"PAH",414,1,306,0)="             It will not backup any other changes such as DD's or"
^DIC(9.4,60,22,13,"PAH",414,1,307,0)="             templates."
^DIC(9.4,60,22,13,"PAH",414,1,308,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,309,0)="  5. When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,60,22,13,"PAH",414,1,310,0)="     NO//"" respond NO."
^DIC(9.4,60,22,13,"PAH",414,1,311,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,312,0)="  6. When prompted ""Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,60,22,13,"PAH",414,1,313,0)="     and Protocols? NO//"" respond NO."
^DIC(9.4,60,22,13,"PAH",414,1,314,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,315,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,316,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,317,0)="Post-Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",414,1,318,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,319,0)="There are no special tasks to perform after this patch installation."
^DIC(9.4,60,22,13,"PAH",415,0)="518^3180706.154355^54"
^DIC(9.4,60,22,13,"PAH",416,0)="526 SEQ #433^3180803.151337^54"
^DIC(9.4,60,22,13,"PAH",416,1,0)="^^4^4^3180803"
^DIC(9.4,60,22,13,"PAH",416,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",416,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",416,1,3,0)="INC0105896 - <SYNTAX> error"
^DIC(9.4,60,22,13,"PAH",416,1,4,0)="INC0320678 - <UNDEFINED> Error"
^DIC(9.4,60,22,13,"PAH",417,0)="505 SEQ #434^3180904.153423^54"
^DIC(9.4,60,22,13,"PAH",417,1,0)="^^1^1^3180904"
^DIC(9.4,60,22,13,"PAH",417,1,1,0)="Medication Prescribing and Dispensing Updates."
^DIC(9.4,60,22,13,"PAH",418,0)="482^3180907.122414^54"
^DIC(9.4,60,22,13,"PAH",418,1,0)="^^1^1^3180907"
^DIC(9.4,60,22,13,"PAH",418,1,1,0)="MCCF EDI TAS EPHARMACY BUILDS 3 & 4"
^DIC(9.4,60,22,13,"PAH",419,0)="527 SEQ #436^3180907.122518^54"
^DIC(9.4,60,22,13,"PAH",420,0)="314^3180925.15393^54"
^DIC(9.4,60,22,13,"PAH",420,1,0)="^^56^56^3180925"
^DIC(9.4,60,22,13,"PAH",420,1,1,0)="*************"
^DIC(9.4,60,22,13,"PAH",420,1,2,0)="THIS ENTIRE PATCH DESCRIPTION NEEDS TO BE REVISED.  RMS 3-12-12"
^DIC(9.4,60,22,13,"PAH",420,1,3,0)="*************"
^DIC(9.4,60,22,13,"PAH",420,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,5,0)="This patch corrects issues that have been reported with Medication "
^DIC(9.4,60,22,13,"PAH",420,1,6,0)="Reconciliation Tool #1 (Medication Reconciliation Health Summary) and "
^DIC(9.4,60,22,13,"PAH",420,1,7,0)="Medication Reconciliation Tool #2 (Medication Worksheet)."
^DIC(9.4,60,22,13,"PAH",420,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,9,0)="Tool #1 - Medication Reconciliation"
^DIC(9.4,60,22,13,"PAH",420,1,10,0)="  At the bottom of the report there is a section that displays other "
^DIC(9.4,60,22,13,"PAH",420,1,11,0)="outpatient prescriptions dispensed in the previous year.  The combination "
^DIC(9.4,60,22,13,"PAH",420,1,12,0)="of long drug names and the status ""DISCONTINUED/EDIT"" would cause the "
^DIC(9.4,60,22,13,"PAH",420,1,13,0)="report to lose data at the right margin when printed.  This patch "
^DIC(9.4,60,22,13,"PAH",420,1,14,0)="reformats lines in the affected section to maintain spacing within the "
^DIC(9.4,60,22,13,"PAH",420,1,15,0)="printed margins."
^DIC(9.4,60,22,13,"PAH",420,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,17,0)="Tool #1 - Medication Reconciliation"
^DIC(9.4,60,22,13,"PAH",420,1,18,0)="  Inpatient orders that do not have additional order text (such as large "
^DIC(9.4,60,22,13,"PAH",420,1,19,0)="volume IVs) are inadvertently skipping the BCMA LAST ACTION line.  This "
^DIC(9.4,60,22,13,"PAH",420,1,20,0)="patch will include that line more consistently on all inpatient orders."
^DIC(9.4,60,22,13,"PAH",420,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,22,0)="Tool #1 - Medication Reconciliation"
^DIC(9.4,60,22,13,"PAH",420,1,23,0)="  The display of previously expired and discontinued orders at the bottom "
^DIC(9.4,60,22,13,"PAH",420,1,24,0)="of the report was selecting the LAST RELEASED DATE based on the "
^DIC(9.4,60,22,13,"PAH",420,1,25,0)="prescription that had the latest expiration date.  This patch corrects "
^DIC(9.4,60,22,13,"PAH",420,1,26,0)="that selection to display the proper release date that is most recent for "
^DIC(9.4,60,22,13,"PAH",420,1,27,0)="a given medication."
^DIC(9.4,60,22,13,"PAH",420,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,29,0)="Tool #1 - Medication Reconciliation"
^DIC(9.4,60,22,13,"PAH",420,1,30,0)="  The listing of medications entered as ""clinic medications"" through the "
^DIC(9.4,60,22,13,"PAH",420,1,31,0)="Inpatient Medications for Outpatient (IMO) process was incorrectly labeled"
^DIC(9.4,60,22,13,"PAH",420,1,32,0)="as an INP (Inpatient) Medication.  This patch will display that category "
^DIC(9.4,60,22,13,"PAH",420,1,33,0)="of medications as CLN, identified in the legend as Clinic Medications."
^DIC(9.4,60,22,13,"PAH",420,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,35,0)="Tool #1 - Medication Reconciliation and Tool #4 - Remote Active Medications"
^DIC(9.4,60,22,13,"PAH",420,1,36,0)="  The statuses of remote outpatient medications shown in the Medication "
^DIC(9.4,60,22,13,"PAH",420,1,37,0)="Reconciliation profile and the Remote Active Medications health summary "
^DIC(9.4,60,22,13,"PAH",420,1,38,0)="component will now include ""HOLD"" medications."
^DIC(9.4,60,22,13,"PAH",420,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,40,0)="Tool #2 - Medication Worksheet"
^DIC(9.4,60,22,13,"PAH",420,1,41,0)="  The hard-coded display of a the patient's last four digits of the SSN in"
^DIC(9.4,60,22,13,"PAH",420,1,42,0)="the body of the work sheet is removed. The release of health summary patch"
^DIC(9.4,60,22,13,"PAH",420,1,43,0)="GMTS*2.7*85 now permits the removal of the patient SSN from the health"
^DIC(9.4,60,22,13,"PAH",420,1,44,0)="summary overall header, but this change permits the worksheet to be"
^DIC(9.4,60,22,13,"PAH",420,1,45,0)="printed with no SSN references remaining."
^DIC(9.4,60,22,13,"PAH",420,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,47,0)="Tool #2 - Medication Worksheet"
^DIC(9.4,60,22,13,"PAH",420,1,48,0)="  The internal programming that selects the name of the pharmacy"
^DIC(9.4,60,22,13,"PAH",420,1,49,0)="division shown at the top of the worksheet and the pharmacy phone"
^DIC(9.4,60,22,13,"PAH",420,1,50,0)="number associated with it has been revised. The impact of this correction"
^DIC(9.4,60,22,13,"PAH",420,1,51,0)="will be seen mostly at legacy integrated systems."
^DIC(9.4,60,22,13,"PAH",420,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",420,1,53,0)="Also included in this patch is the removal of routine PSOQUAP.  This"
^DIC(9.4,60,22,13,"PAH",420,1,54,0)="routine was orphaned during the final testing of patch PSO*7*294.  Its"
^DIC(9.4,60,22,13,"PAH",420,1,55,0)="functionality is fully incorporated into routine PSOQUAP2 which is"
^DIC(9.4,60,22,13,"PAH",420,1,56,0)="referenced in the implementation guide."
^DIC(9.4,60,22,13,"PAH",421,0)="514 SEQ #438^3181004.16202^54"
^DIC(9.4,60,22,13,"PAH",421,1,0)="^^5^5^3181004"
^DIC(9.4,60,22,13,"PAH",421,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",421,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",421,1,3,0)="1. I9914421FY16 - all prescription information is not displayed on the"
^DIC(9.4,60,22,13,"PAH",421,1,4,0)="                  Pharmacy verification screen"
^DIC(9.4,60,22,13,"PAH",421,1,5,0)="2. R18151128FY18 - QTY Recalculation when Drug Changed"
^DIC(9.4,60,22,13,"PAH",422,0)="534 SEQ #439^3181004.172553^54"
^DIC(9.4,60,22,13,"PAH",422,1,0)="^^1^1^3181004"
^DIC(9.4,60,22,13,"PAH",422,1,1,0)="One VA Pharmacy, redirect HL7 link PSORRXSEND from EMI to VIERS."
^DIC(9.4,60,22,13,"PAH",423,0)="539 SEQ #440^3181102.145203^54"
^DIC(9.4,60,22,13,"PAH",423,1,0)="^^41^41^3181102"
^DIC(9.4,60,22,13,"PAH",423,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,60,22,13,"PAH",423,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",423,1,3,0)="INC1866048 - Suspense not printing, previously entered ticket INC1658361 which"
^DIC(9.4,60,22,13,"PAH",423,1,4,0)="             was closed without assistance"
^DIC(9.4,60,22,13,"PAH",423,1,5,0)="      "
^DIC(9.4,60,22,13,"PAH",423,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",423,1,7,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",423,1,8,0)="INC1866048 - Suspense not printing, previously entered ticket INC1658361 which"
^DIC(9.4,60,22,13,"PAH",423,1,9,0)="             was closed without assistance"
^DIC(9.4,60,22,13,"PAH",423,1,10,0)="INC0998874 - LON Cannot Print to suspense/ clear old records from RX suspense"
^DIC(9.4,60,22,13,"PAH",423,1,11,0)="(Duplicate)  file death causing suspense print to error out."
^DIC(9.4,60,22,13,"PAH",423,1,12,0)="INC0785349 - suspense function in Vista is not working "
^DIC(9.4,60,22,13,"PAH",423,1,13,0)="(Duplicate) "
^DIC(9.4,60,22,13,"PAH",423,1,14,0)="INC0411672 - PSO OPTION NOT WORKING"
^DIC(9.4,60,22,13,"PAH",423,1,15,0)="(Duplicate) "
^DIC(9.4,60,22,13,"PAH",423,1,16,0)="INC0301071 - TUA - prescriptions not printing"
^DIC(9.4,60,22,13,"PAH",423,1,17,0)="(Duplicate) "
^DIC(9.4,60,22,13,"PAH",423,1,18,0)="INC0190642 - CA SDM Ticket I18597371FY18 moved to SN. UNABLE TO RUN FULL LIST"
^DIC(9.4,60,22,13,"PAH",423,1,19,0)="(Duplicate)  SUSPENSE FUNCTION"
^DIC(9.4,60,22,13,"PAH",423,1,20,0)="        "
^DIC(9.4,60,22,13,"PAH",423,1,21,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",423,1,22,0)="--------"
^DIC(9.4,60,22,13,"PAH",423,1,23,0)="The Marion VA Medical Center reported getting an <UNDEFINED> error when trying"
^DIC(9.4,60,22,13,"PAH",423,1,24,0)="to print local labels in the RX SUSPENSE file (#52.5). Upon further analysis"
^DIC(9.4,60,22,13,"PAH",423,1,25,0)="it was determined that a bad ""AC"" cross-reference entry in the RX SUSPENSE"
^DIC(9.4,60,22,13,"PAH",423,1,26,0)="file (#52.5) is causing the problem. Although the cross-reference is set, the"
^DIC(9.4,60,22,13,"PAH",423,1,27,0)="record it is pointing to is no longer present on the file which consequently"
^DIC(9.4,60,22,13,"PAH",423,1,28,0)="causes the routine PSOSULBL to error out with an <UNDEFINED> error at BEG+6."
^DIC(9.4,60,22,13,"PAH",423,1,29,0)="        "
^DIC(9.4,60,22,13,"PAH",423,1,30,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",423,1,31,0)="-----------"
^DIC(9.4,60,22,13,"PAH",423,1,32,0)="The reason why the ""AC"" cross-reference entry was not deleted along with the"
^DIC(9.4,60,22,13,"PAH",423,1,33,0)="original record could not be identified. However, this patch modifies the"
^DIC(9.4,60,22,13,"PAH",423,1,34,0)="routine PSOSULBL to prevent the <UNDEFINED> error from happening when the"
^DIC(9.4,60,22,13,"PAH",423,1,35,0)="corrupted ""AC"" cross-reference is present. Furthermore, the PSOSULBL routine"
^DIC(9.4,60,22,13,"PAH",423,1,36,0)="was also modified to clean up the corrupt ""AC"" cross-reference."
^DIC(9.4,60,22,13,"PAH",423,1,37,0)="  "
^DIC(9.4,60,22,13,"PAH",423,1,38,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",423,1,39,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",423,1,40,0)="Changed the routine PSOSULBL at line tag BEG and TMP to prevent the"
^DIC(9.4,60,22,13,"PAH",423,1,41,0)="<UNDEFINED> error and to kill off the corrupt ""AC"" cross-reference entry."
^DIC(9.4,60,22,13,"PAH",424,0)="540 SEQ #441^3181102.145241^54"
^DIC(9.4,60,22,13,"PAH",424,1,0)="^^3^3^3181102"
^DIC(9.4,60,22,13,"PAH",424,1,1,0)="This patch will fix the following issue:"
^DIC(9.4,60,22,13,"PAH",424,1,2,0)="1.      Able to DC non-verified Rx order when another user is editing"
^DIC(9.4,60,22,13,"PAH",424,1,3,0)="it in CPRS"
^DIC(9.4,60,22,13,"PAH",425,0)="507 SEQ #442^3181102.153023^54"
^DIC(9.4,60,22,13,"PAH",425,1,0)="^^62^62^3181102"
^DIC(9.4,60,22,13,"PAH",425,1,1,0)="This patch has the following enhancements for Clinical Ancillary Services"
^DIC(9.4,60,22,13,"PAH",425,1,2,0)="(CAS) Enhancements (RXSU2)."
^DIC(9.4,60,22,13,"PAH",425,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,5,0)="1. Manage Lookup List Inactive Entries "
^DIC(9.4,60,22,13,"PAH",425,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,7,0)="   Modified Pharmacy Backdoor menu option Patient Prescription Processing "
^DIC(9.4,60,22,13,"PAH",425,1,8,0)="   [PSO LM BACKDOOR ORDERS]. Added the text ""** INACTIVE **"" to the end "
^DIC(9.4,60,22,13,"PAH",425,1,9,0)="   the display of the ADMINISTRATION SCHEDULE file (#51.1) entries during"
^DIC(9.4,60,22,13,"PAH",425,1,10,0)="   editing the Listman screen field ""3)  *Schedule:"".  Upon typing a ?"
^DIC(9.4,60,22,13,"PAH",425,1,11,0)="   at that prompt and selecting ""A"" for Administration Schedule File, the"
^DIC(9.4,60,22,13,"PAH",425,1,12,0)="   entries displayed will now include the Inactive text."
^DIC(9.4,60,22,13,"PAH",425,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,15,0)="2. Manage Hidden Icons (Actions)  Outpatient"
^DIC(9.4,60,22,13,"PAH",425,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,17,0)="   Two new hidden actions are provided for Outpatient Pharmacy's menu "
^DIC(9.4,60,22,13,"PAH",425,1,18,0)="   option Patient Prescription Processing [PSO LM BACKDOOR ORDERS]."
^DIC(9.4,60,22,13,"PAH",425,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,20,0)="   a. New hidden action ""DM"" for displaying dispense drug information "
^DIC(9.4,60,22,13,"PAH",425,1,21,0)="      during data entry.  This hidden action will display key information"
^DIC(9.4,60,22,13,"PAH",425,1,22,0)="      about the order to help aid in the verification process of an order"
^DIC(9.4,60,22,13,"PAH",425,1,23,0)="      and also allow user to Enter another drug if desired.  Key"
^DIC(9.4,60,22,13,"PAH",425,1,24,0)="      information includes:"
^DIC(9.4,60,22,13,"PAH",425,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,26,0)="      Example:"
^DIC(9.4,60,22,13,"PAH",425,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,28,0)="           DRUG NAME:  xxxxxxxxxxxxxxxxxxx   (IEN: 3)"
^DIC(9.4,60,22,13,"PAH",425,1,29,0)="             ORDERABLE ITEM TEXT:"
^DIC(9.4,60,22,13,"PAH",425,1,30,0)="              xxx xx xxxxx xxxxx xx xxxxx"
^DIC(9.4,60,22,13,"PAH",425,1,31,0)="              x xxxxxxxx xx xxxxxxxxxxxx"
^DIC(9.4,60,22,13,"PAH",425,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,33,0)="           MESSAGE:   xxxx xxx xx xxxxx x xxxxxxxx"
^DIC(9.4,60,22,13,"PAH",425,1,34,0)="           QTY DISP MESSAGE:   x xxxxxxxx xx xxxxxxxxx xxxx"
^DIC(9.4,60,22,13,"PAH",425,1,35,0)="  "
^DIC(9.4,60,22,13,"PAH",425,1,36,0)="           Return to continue or"
^DIC(9.4,60,22,13,"PAH",425,1,37,0)="           Select DRUG GENERIC NAME:"
^DIC(9.4,60,22,13,"PAH",425,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,39,0)="   b. New hidden action ""VP"" for displaying Provider information during "
^DIC(9.4,60,22,13,"PAH",425,1,40,0)="      data entry.  This hidden action will display key information about"
^DIC(9.4,60,22,13,"PAH",425,1,41,0)="      the PROVIDER to help aid in the verification process of an order and"
^DIC(9.4,60,22,13,"PAH",425,1,42,0)="      also allow user to enter another provider if desired.  Key "
^DIC(9.4,60,22,13,"PAH",425,1,43,0)="      information includes:"
^DIC(9.4,60,22,13,"PAH",425,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,45,0)="      Example:"
^DIC(9.4,60,22,13,"PAH",425,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,47,0)="           PROVIDER TITLE:     xxxxxxxx"
^DIC(9.4,60,22,13,"PAH",425,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,49,0)="           PROVIDER REMARKS:   xxx xxxxx xxxx"
^DIC(9.4,60,22,13,"PAH",425,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,51,0)="           PROVIDER SPECIALTY: xxxxxx"
^DIC(9.4,60,22,13,"PAH",425,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,53,0)="           Return to continue or"
^DIC(9.4,60,22,13,"PAH",425,1,54,0)="           Select NEW PERSON NAME: "
^DIC(9.4,60,22,13,"PAH",425,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,57,0)="3. Suppress Duplicate - Therapy Alerts"
^DIC(9.4,60,22,13,"PAH",425,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",425,1,59,0)="   Duplicate Therapy order check is suppressed in CPRS if the same"
^DIC(9.4,60,22,13,"PAH",425,1,60,0)="   provider is ordering the same drug within the last 25% of the"
^DIC(9.4,60,22,13,"PAH",425,1,61,0)="   medications' calculated days supply.  All 3 above criteria must be"
^DIC(9.4,60,22,13,"PAH",425,1,62,0)="   met for this order check to be suppressed."
^DIC(9.4,60,22,13,"PAH",426,0)="517 SEQ #443^3181206.160631^54"
^DIC(9.4,60,22,13,"PAH",426,1,0)="^^18^18^3181206"
^DIC(9.4,60,22,13,"PAH",426,1,1,0)="MPDU - MEDICATION PERMISSIONS/DISPENSING UPDATES - Build 3"
^DIC(9.4,60,22,13,"PAH",426,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",426,1,3,0)="This patch will address the following issues:"
^DIC(9.4,60,22,13,"PAH",426,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",426,1,5,0)="1.  The PHARMACY PATIENT file (#55) should have only one logical data "
^DIC(9.4,60,22,13,"PAH",426,1,6,0)="    piece corresponding to RX PATIENT STATUS on the ""PS"" node."
^DIC(9.4,60,22,13,"PAH",426,1,7,0)="2.  Display in the Patient's Medication Profile there is a leading zero "
^DIC(9.4,60,22,13,"PAH",426,1,8,0)="    in the quantity if it is a fractional quantity."
^DIC(9.4,60,22,13,"PAH",426,1,9,0)="3.  An intermittent issue was found that some Non-Controlled Substance "
^DIC(9.4,60,22,13,"PAH",426,1,10,0)="    order items are not able to be marked for titrate."
^DIC(9.4,60,22,13,"PAH",426,1,11,0)="4.  Outpatient Medication Controlled Substance order edit, unnecessary "
^DIC(9.4,60,22,13,"PAH",426,1,12,0)="    code removed."
^DIC(9.4,60,22,13,"PAH",426,1,13,0)="5.  Manilla Phillippines unique address is stopping controlled substance"
^DIC(9.4,60,22,13,"PAH",426,1,14,0)="    orders from finishing."
^DIC(9.4,60,22,13,"PAH",426,1,15,0)="6.  Undefined Error at ACP+21^PSOORNEW"
^DIC(9.4,60,22,13,"PAH",426,1,16,0)="7.  Patient address, risk of carryover information between patients in "
^DIC(9.4,60,22,13,"PAH",426,1,17,0)="    VAPA array."
^DIC(9.4,60,22,13,"PAH",426,1,18,0)="8.  Allow ""# of refills"" entry to be edited on Controlled Substance orders"
^DIC(9.4,60,22,13,"PAH",427,0)="508 SEQ #444^3181206.161201^54"
^DIC(9.4,60,22,13,"PAH",427,1,0)="^^1^1^3181206"
^DIC(9.4,60,22,13,"PAH",427,1,1,0)="Inbound eRx Version 3 updates."
^DIC(9.4,60,22,13,"PAH",428,0)="452^3181206.161704^54"
^DIC(9.4,60,22,13,"PAH",428,1,0)="^^8^8^3181206"
^DIC(9.4,60,22,13,"PAH",428,1,1,0)="Patch PSO*7*452 is part of a Multi Build with patch PSS*1.0*215."
^DIC(9.4,60,22,13,"PAH",428,1,2,0)="PSO*7.0*452 contains the routine changes."
^DIC(9.4,60,22,13,"PAH",428,1,3,0)="PSS*1.0*215 contains the DD changes."
^DIC(9.4,60,22,13,"PAH",428,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",428,1,5,0)="The NSRs involved in this build are:"
^DIC(9.4,60,22,13,"PAH",428,1,6,0)="NSR20150311 High Cost Rx Report;  NSR20151109 Pharmacy Print from Suspense"
^DIC(9.4,60,22,13,"PAH",428,1,7,0)="by Category; NSR20150512 Early Warning Advisory for Approaching the "
^DIC(9.4,60,22,13,"PAH",428,1,8,0)="end of Rx Number Ranges; and NSR20151001 Pharmacy Patient Demographics."
^DIC(9.4,60,22,13,"PAH",429,0)="525 SEQ #446^3181206.161959^54"
^DIC(9.4,60,22,13,"PAH",429,1,0)="^^62^62^3181206"
^DIC(9.4,60,22,13,"PAH",429,1,1,0)="As part of the Clinical Ancillary Services project (CAS) - Medication "
^DIC(9.4,60,22,13,"PAH",429,1,2,0)="Permission/Dispensing Updates (MPDU), the Outpatient package has been"
^DIC(9.4,60,22,13,"PAH",429,1,3,0)="modified to address the following:"
^DIC(9.4,60,22,13,"PAH",429,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,5,0)="1. Modify the List of Patients/Prescriptions for Recall Notice Report"
^DIC(9.4,60,22,13,"PAH",429,1,6,0)="2. Limit the Display of Medication Routes for Outpatient Order Dialogs"
^DIC(9.4,60,22,13,"PAH",429,1,7,0)="3. Check dosage form to determine appropriate default route"
^DIC(9.4,60,22,13,"PAH",429,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,9,0)="Item #1:"
^DIC(9.4,60,22,13,"PAH",429,1,10,0)="--------"
^DIC(9.4,60,22,13,"PAH",429,1,11,0)="As a pharmacist using the List of Patients/Prescriptions for Recall "
^DIC(9.4,60,22,13,"PAH",429,1,12,0)="Notice Report, I need the system to correctly identify the Lot # of each "
^DIC(9.4,60,22,13,"PAH",429,1,13,0)="individual prescription fill (original or refill and locally dispensed or "
^DIC(9.4,60,22,13,"PAH",429,1,14,0)="CMOP) so that all prescriptions fills with that Lot # are accurately "
^DIC(9.4,60,22,13,"PAH",429,1,15,0)="reported."
^DIC(9.4,60,22,13,"PAH",429,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,17,0)="1. I want the report to pull the Lot # that corresponds to the "
^DIC(9.4,60,22,13,"PAH",429,1,18,0)="   individual fill represented by a line of data (original or refill or "
^DIC(9.4,60,22,13,"PAH",429,1,19,0)="   partial)."
^DIC(9.4,60,22,13,"PAH",429,1,20,0)="2. I want the report to pull the Lot # that corresponds to the "
^DIC(9.4,60,22,13,"PAH",429,1,21,0)="   manner in which the prescription was dispensed (VAMC-local or CMOP"
^DIC(9.4,60,22,13,"PAH",429,1,22,0)="   fill)."
^DIC(9.4,60,22,13,"PAH",429,1,23,0)="3. I want the structure and header of the report to remain unchanged."
^DIC(9.4,60,22,13,"PAH",429,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,26,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",429,1,27,0)="-----------"
^DIC(9.4,60,22,13,"PAH",429,1,28,0)="Line tag LOT^PSORLST2 has been modified to also check the CMOP node "
^DIC(9.4,60,22,13,"PAH",429,1,29,0)="for a CMOP fill (original or refill) and include it in the report."
^DIC(9.4,60,22,13,"PAH",429,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,32,0)="Item #2:"
^DIC(9.4,60,22,13,"PAH",429,1,33,0)="--------"
^DIC(9.4,60,22,13,"PAH",429,1,34,0)="As a pharmacist entering an outpatient prescription through VistA, I want "
^DIC(9.4,60,22,13,"PAH",429,1,35,0)="only medication routes that are appropriate for use with the medication I "
^DIC(9.4,60,22,13,"PAH",429,1,36,0)="select displayed so that I am prevented from selecting the incorrect "
^DIC(9.4,60,22,13,"PAH",429,1,37,0)="route subsequently increasing patient safety."
^DIC(9.4,60,22,13,"PAH",429,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,39,0)="1. When entering an outpatient prescription into VistA, I only want "
^DIC(9.4,60,22,13,"PAH",429,1,40,0)="   medication routes associated with the medication dosage form for the "
^DIC(9.4,60,22,13,"PAH",429,1,41,0)="   medication selected displayed as available for selection. "
^DIC(9.4,60,22,13,"PAH",429,1,42,0)="2. If I enter a medication route that is not associated with the "
^DIC(9.4,60,22,13,"PAH",429,1,43,0)="   medication's dosage form, I want the route entered matched to the "
^DIC(9.4,60,22,13,"PAH",429,1,44,0)="   available routes as an exact full-text match."
^DIC(9.4,60,22,13,"PAH",429,1,45,0)="   a. If I enter a route that is only a partial match, I want the "
^DIC(9.4,60,22,13,"PAH",429,1,46,0)="      standard FileMan response of ""??"" to alert me that a match was not"
^DIC(9.4,60,22,13,"PAH",429,1,47,0)="      found."
^DIC(9.4,60,22,13,"PAH",429,1,48,0)="   b. If I enter a complete and exact-match route, I want that route "
^DIC(9.4,60,22,13,"PAH",429,1,49,0)="      selected for use with that medication order."
^DIC(9.4,60,22,13,"PAH",429,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",429,1,52,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",429,1,53,0)="-----------"
^DIC(9.4,60,22,13,"PAH",429,1,54,0)="Routines PSOORED5 and PSOBKDED were modified with the following:"
^DIC(9.4,60,22,13,"PAH",429,1,55,0)="1. If a default med route is not defined, ""PO"" will not be displayed; a"
^DIC(9.4,60,22,13,"PAH",429,1,56,0)="   null value will be displayed as default."
^DIC(9.4,60,22,13,"PAH",429,1,57,0)="2. Med routes that are exact matches or abbreviated matches will be "
^DIC(9.4,60,22,13,"PAH",429,1,58,0)="   allowed."
^DIC(9.4,60,22,13,"PAH",429,1,59,0)="3. A single ""?"" will show a short list of med routes that are defined"
^DIC(9.4,60,22,13,"PAH",429,1,60,0)="   under the orderable item."
^DIC(9.4,60,22,13,"PAH",429,1,61,0)="4. Partial matches will be allowed if found in the short list, but not"
^DIC(9.4,60,22,13,"PAH",429,1,62,0)="   otherwise."
^DIC(9.4,60,22,13,"PAH",430,0)="550 SEQ #447^3190131.164311^54"
^DIC(9.4,60,22,13,"PAH",430,1,0)="^^2^2^3190131"
^DIC(9.4,60,22,13,"PAH",430,1,1,0)="Restoration of changes introduced in patch PSO*7*504. The changes made to "
^DIC(9.4,60,22,13,"PAH",430,1,2,0)="PSORENW and PSORENW4 were inadvertently left out of patch PSO*7*508."
^DIC(9.4,60,22,13,"PAH",431,0)="512^3190201.1438^54"
^DIC(9.4,60,22,13,"PAH",431,1,0)="^^1^1^3190201"
^DIC(9.4,60,22,13,"PAH",431,1,1,0)="MCCF EDI TAS EPHARMACY BUILDS 5 & 6"
^DIC(9.4,60,22,13,"PAH",432,0)="547 SEQ #449^3190201.15222^54"
^DIC(9.4,60,22,13,"PAH",432,1,0)="^^65^65^3190201"
^DIC(9.4,60,22,13,"PAH",432,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,60,22,13,"PAH",432,1,2,0)="  "
^DIC(9.4,60,22,13,"PAH",432,1,3,0)="INC2842893 - Removed from CMOP Suspense, returned to OP Suspense - outpatient"
^DIC(9.4,60,22,13,"PAH",432,1,4,0)="             prescriptions not suspending to CMOP after PSO*7*482 SEQ #435"
^DIC(9.4,60,22,13,"PAH",432,1,5,0)="INC2882730 - Erroneous SC conditions are being displayed during pharmacy"
^DIC(9.4,60,22,13,"PAH",432,1,6,0)="             prescription processing"
^DIC(9.4,60,22,13,"PAH",432,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",432,1,8,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",432,1,9,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",432,1,10,0)="INC2842893 - Removed from CMOP Suspense, returned to OP Suspense - outpatient"
^DIC(9.4,60,22,13,"PAH",432,1,11,0)="             prescriptions not suspending to CMOP after PSO*7*482 SEQ #435"
^DIC(9.4,60,22,13,"PAH",432,1,12,0)="          "
^DIC(9.4,60,22,13,"PAH",432,1,13,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",432,1,14,0)="--------"
^DIC(9.4,60,22,13,"PAH",432,1,15,0)="Outpatient pharmacists at Louis Stokes Cleveland VA Medical Center reported a"
^DIC(9.4,60,22,13,"PAH",432,1,16,0)="glitch where a suspended Rx is edited and re-suspended appropriately but they"
^DIC(9.4,60,22,13,"PAH",432,1,17,0)="are not being sent to CMOP. This problem happens when a new CMOP prescription"
^DIC(9.4,60,22,13,"PAH",432,1,18,0)="is entered/finished and immediately after (without leaving the patient's"
^DIC(9.4,60,22,13,"PAH",432,1,19,0)="profile) the user requests a partial fill on the same prescription and"
^DIC(9.4,60,22,13,"PAH",432,1,20,0)="performs and edit on any field (e.g., QTY, FILL DATE, DAYS SUPPLY, etc.)."
^DIC(9.4,60,22,13,"PAH",432,1,21,0)="These steps wrongly caused the prescription to be removed from the CMOP"
^DIC(9.4,60,22,13,"PAH",432,1,22,0)="Suspense queue and placed on the Local Suspense queue."
^DIC(9.4,60,22,13,"PAH",432,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",432,1,24,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",432,1,25,0)="-----------"
^DIC(9.4,60,22,13,"PAH",432,1,26,0)="Outpatient Pharmacy will now check whether a partial was entered for a CMOP"
^DIC(9.4,60,22,13,"PAH",432,1,27,0)="suspended prescription and it will not move it from the CMOP Suspense queue"
^DIC(9.4,60,22,13,"PAH",432,1,28,0)="into the Local Suspense queue if that's the case."
^DIC(9.4,60,22,13,"PAH",432,1,29,0)="   "
^DIC(9.4,60,22,13,"PAH",432,1,30,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",432,1,31,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",432,1,32,0)="Changed the line UNSUS+1^PSOCMOPC to check whether a partial was placed by"
^DIC(9.4,60,22,13,"PAH",432,1,33,0)="checking the variable RXPR and PSOFROM and it will not move the CMOP"
^DIC(9.4,60,22,13,"PAH",432,1,34,0)="Suspended prescription into the Local Suspense queue."
^DIC(9.4,60,22,13,"PAH",432,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",432,1,36,0)="INC2882730 - Erroneous SC conditions are being displayed during pharmacy"
^DIC(9.4,60,22,13,"PAH",432,1,37,0)="             prescription processing"
^DIC(9.4,60,22,13,"PAH",432,1,38,0)="          "
^DIC(9.4,60,22,13,"PAH",432,1,39,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",432,1,40,0)="--------"
^DIC(9.4,60,22,13,"PAH",432,1,41,0)="Outpatient pharmacists at St. Cloud VA Health Care System reported a glitch"
^DIC(9.4,60,22,13,"PAH",432,1,42,0)="that started happening after patch PSO*7*514 was installed. They noticed that"
^DIC(9.4,60,22,13,"PAH",432,1,43,0)="numerous male patients were showing up in outpatient pharmacy prescription"
^DIC(9.4,60,22,13,"PAH",432,1,44,0)="processing as having SC conditions for ovarian disease or gynecological"
^DIC(9.4,60,22,13,"PAH",432,1,45,0)="issues. When checking back to the patient information screen in VISTA"
^DIC(9.4,60,22,13,"PAH",432,1,46,0)="pharmacy prescription processing or CPRS, the pharmacists discovered in many"
^DIC(9.4,60,22,13,"PAH",432,1,47,0)="cases the patient was only SC for tinnitus, yet a big list of other "
^DIC(9.4,60,22,13,"PAH",432,1,48,0)="disabilities were listed at the very end of pharmacy prescription processing"
^DIC(9.4,60,22,13,"PAH",432,1,49,0)="when it lists the patient's SC conditions, often with the gynecological "
^DIC(9.4,60,22,13,"PAH",432,1,50,0)="condition. After investigating the issue it was discovered PSO*7*514 changes"
^DIC(9.4,60,22,13,"PAH",432,1,51,0)="did not clear the list of disabilities from the previous patient worked on"
^DIC(9.4,60,22,13,"PAH",432,1,52,0)="by the user and carried them over to the subsequent patient worked on the"
^DIC(9.4,60,22,13,"PAH",432,1,53,0)="same session before exiting the Patient Prescription Processing [PSO LM "
^DIC(9.4,60,22,13,"PAH",432,1,54,0)="BACKDOOR ORDERS] option."
^DIC(9.4,60,22,13,"PAH",432,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",432,1,56,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",432,1,57,0)="-----------"
^DIC(9.4,60,22,13,"PAH",432,1,58,0)="The Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option was "
^DIC(9.4,60,22,13,"PAH",432,1,59,0)="changed to properly reset the list of disabilities every time the user "
^DIC(9.4,60,22,13,"PAH",432,1,60,0)="selects a new patient."
^DIC(9.4,60,22,13,"PAH",432,1,61,0)="    "
^DIC(9.4,60,22,13,"PAH",432,1,62,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",432,1,63,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",432,1,64,0)="Added the command K PSODISAR at CHKPAG+1^PSOMLLD2 in order to reset the"
^DIC(9.4,60,22,13,"PAH",432,1,65,0)="list of disabilities before retrieving it from the PATIENT file (#2)."
^DIC(9.4,60,22,13,"PAH",433,0)="537 SEQ #450^3190201.160046^54"
^DIC(9.4,60,22,13,"PAH",433,1,0)="^^4^4^3190201"
^DIC(9.4,60,22,13,"PAH",433,1,1,0)="When users are entering a new complex order using option PSO LM BACKDOOR "
^DIC(9.4,60,22,13,"PAH",433,1,2,0)="ORDERS and afterwards are editing the dosage fields and they jump out of"
^DIC(9.4,60,22,13,"PAH",433,1,3,0)="certain fields, the medication's SIG is truncated after the first THEN"
^DIC(9.4,60,22,13,"PAH",433,1,4,0)="conjunction of the medication profile."
^DIC(9.4,60,22,13,"PAH",434,0)="532 SEQ #451^3190301.14012^54"
^DIC(9.4,60,22,13,"PAH",434,1,0)="^^4^4^3190301"
^DIC(9.4,60,22,13,"PAH",434,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,60,22,13,"PAH",434,1,2,0)="1.  INC0698370 - OneVA Can't see patient's remote RX's"
^DIC(9.4,60,22,13,"PAH",434,1,3,0)="2.  INC0908814 - Last Fill Date shows incorrect MAIL/WINDOW value"
^DIC(9.4,60,22,13,"PAH",434,1,4,0)="3.  INC1033035 - Documentation changes needed"
^DIC(9.4,60,22,13,"PAH",435,0)="481 SEQ #452^3190301.15502^54"
^DIC(9.4,60,22,13,"PAH",435,1,0)="^^26^26^3190301"
^DIC(9.4,60,22,13,"PAH",435,1,1,0)="This patch will upload ""new"" providers for a site into the New Person "
^DIC(9.4,60,22,13,"PAH",435,1,2,0)="(#200) file.  A ""new"" provider is defined as a provider whose National "
^DIC(9.4,60,22,13,"PAH",435,1,3,0)="Provider Identifier (NPI) is not on file yet at a site."
^DIC(9.4,60,22,13,"PAH",435,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",435,1,5,0)="On August 7, 2014, the President signed into law PL 113-146, the Veterans "
^DIC(9.4,60,22,13,"PAH",435,1,6,0)="Access, Choice, and Accountability Act of 2014 (VACAA). The law offers an "
^DIC(9.4,60,22,13,"PAH",435,1,7,0)="additional authority for VHA to expand current capacity and ensure that "
^DIC(9.4,60,22,13,"PAH",435,1,8,0)="Veterans have timely access to high-quality care. "
^DIC(9.4,60,22,13,"PAH",435,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",435,1,10,0)="The law creates a new paradigm for providing health care, set forth in the"
^DIC(9.4,60,22,13,"PAH",435,1,11,0)="Veterans Choice program provisions within Title I Section 101 of VACAA. VA"
^DIC(9.4,60,22,13,"PAH",435,1,12,0)="is utilizing a Contractor to provide health care and third party"
^DIC(9.4,60,22,13,"PAH",435,1,13,0)="administrative (TPA) services set forth through VACAA Section 101. "
^DIC(9.4,60,22,13,"PAH",435,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",435,1,15,0)="As a result of this law, VA must upload a list of non-VA medical care"
^DIC(9.4,60,22,13,"PAH",435,1,16,0)="providers into the VistA system in order to maintain an accurate and"
^DIC(9.4,60,22,13,"PAH",435,1,17,0)="updated list of non-VA providers in the Choice program.  Refer to the"
^DIC(9.4,60,22,13,"PAH",435,1,18,0)="Non-VA Care Provider SharePoint site for further information:"
^DIC(9.4,60,22,13,"PAH",435,1,19,0)="https://vaww.dwh.cdw.portal.domain.ext/sites/Non-VA%20Care%20PC3%20and%20Choic"
^DIC(9.4,60,22,13,"PAH",435,1,20,0)="e/SitePages/Home.aspx."
^DIC(9.4,60,22,13,"PAH",435,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",435,1,22,0)="CA-SDM Ticket: I12935021FY17"
^DIC(9.4,60,22,13,"PAH",435,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",435,1,24,0)="NOTE: The providers loaded by this patch are not eligible to be selected "
^DIC(9.4,60,22,13,"PAH",435,1,25,0)="as ordering providers in CPRS. Use is restricted to the option ""PSO LM "
^DIC(9.4,60,22,13,"PAH",435,1,26,0)="BACKDOOR ORDERS"" (""Patient Prescription Processing"")."
^DIC(9.4,60,22,13,"PAH",436,0)="541 SEQ #454^3190402.172127^54"
^DIC(9.4,60,22,13,"PAH",436,1,0)="^^61^61^3190402"
^DIC(9.4,60,22,13,"PAH",436,1,1,0)="This patch will address the following two issues:"
^DIC(9.4,60,22,13,"PAH",436,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,3,0)="1. Incorrect drug on label for OneVA refill request"
^DIC(9.4,60,22,13,"PAH",436,1,4,0)="2. OneVA prescription error"
^DIC(9.4,60,22,13,"PAH",436,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,6,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,60,22,13,"PAH",436,1,7,0)="-----------------------------"
^DIC(9.4,60,22,13,"PAH",436,1,8,0)="HITPS-6386 - INC2091135"
^DIC(9.4,60,22,13,"PAH",436,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,10,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",436,1,11,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",436,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,13,0)="1. INC2091135 - Incorrect drug on label for OneVA refill request"
^DIC(9.4,60,22,13,"PAH",436,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,15,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",436,1,16,0)="--------"
^DIC(9.4,60,22,13,"PAH",436,1,17,0)="A pharmacist refilled a OneVA Rx and verified the correct local drug "
^DIC(9.4,60,22,13,"PAH",436,1,18,0)="matched to the remote site drug. "
^DIC(9.4,60,22,13,"PAH",436,1,19,0)="The labels printed with a different drug that was on the patient's "
^DIC(9.4,60,22,13,"PAH",436,1,20,0)="profile. This happened with 5 prescriptions. Some did print correct. "
^DIC(9.4,60,22,13,"PAH",436,1,21,0)="Partials were done and some came through in the same erroneous way."
^DIC(9.4,60,22,13,"PAH",436,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,23,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",436,1,24,0)="-----------"
^DIC(9.4,60,22,13,"PAH",436,1,25,0)="Resolve this with the following:"
^DIC(9.4,60,22,13,"PAH",436,1,26,0)="- A 3 second hang will be added prior to reading the HL7 response"
^DIC(9.4,60,22,13,"PAH",436,1,27,0)="with the label information from the Host site"
^DIC(9.4,60,22,13,"PAH",436,1,28,0)="- Once the HL7 message is read, the Rx number selected at the"
^DIC(9.4,60,22,13,"PAH",436,1,29,0)="Remote site will be compared to the Rx number returned in the HL7 label"
^DIC(9.4,60,22,13,"PAH",436,1,30,0)="message from the Host site and if this is a match, processing will"
^DIC(9.4,60,22,13,"PAH",436,1,31,0)="continue as normal"
^DIC(9.4,60,22,13,"PAH",436,1,32,0)="- If the two Rx's do not match, the message below will be displayed"
^DIC(9.4,60,22,13,"PAH",436,1,33,0)="and processing will cease "
^DIC(9.4,60,22,13,"PAH",436,1,34,0)="   'Label interrupted due to HL7 message corruption.'"
^DIC(9.4,60,22,13,"PAH",436,1,35,0)="   'Please request a Partial Fill in order to generate a reprint label.'"
^DIC(9.4,60,22,13,"PAH",436,1,36,0)="- In the background, invisible to the user, an error trap entry"
^DIC(9.4,60,22,13,"PAH",436,1,37,0)="will be made so more research can be done to find the root cause of this"
^DIC(9.4,60,22,13,"PAH",436,1,38,0)="happening.  The error in the error trap will show as 'MISMATCH RX'"
^DIC(9.4,60,22,13,"PAH",436,1,39,0)="Modify the following routines: PSORRX2, PSORWRAP "
^DIC(9.4,60,22,13,"PAH",436,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,41,0)="2. INC2394703 - OneVA prescription error"
^DIC(9.4,60,22,13,"PAH",436,1,42,0)="           "
^DIC(9.4,60,22,13,"PAH",436,1,43,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",436,1,44,0)="--------"
^DIC(9.4,60,22,13,"PAH",436,1,45,0)="The Saginaw VA Medical Center reported that a OneVA prescription fill"
^DIC(9.4,60,22,13,"PAH",436,1,46,0)="request appears to have prompted ScripTalk label to print at host site. The"
^DIC(9.4,60,22,13,"PAH",436,1,47,0)="Host site requeued Vista label and it appears prescription was filled twice."
^DIC(9.4,60,22,13,"PAH",436,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",436,1,49,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",436,1,50,0)="-----------"
^DIC(9.4,60,22,13,"PAH",436,1,51,0)="The OneVA Pharmacy functionality did not prevent a ScripTalk label from"
^DIC(9.4,60,22,13,"PAH",436,1,52,0)="printing at the host site when a refill/partial was requested by the patient"
^DIC(9.4,60,22,13,"PAH",436,1,53,0)="at a remote site. A fix is being introduced by this patch to prevent the"
^DIC(9.4,60,22,13,"PAH",436,1,54,0)="ScripTalk label from printing at the host site when a OneVA prescription"
^DIC(9.4,60,22,13,"PAH",436,1,55,0)="refill/partial is requested is filed."
^DIC(9.4,60,22,13,"PAH",436,1,56,0)="    "
^DIC(9.4,60,22,13,"PAH",436,1,57,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",436,1,58,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",436,1,59,0)="Changed the routine PSORWRAP to set the variable PSOONEVA before calling the"
^DIC(9.4,60,22,13,"PAH",436,1,60,0)="label printing routines (DQ^PSOLBL) and then changed the routine PSOTALK to"
^DIC(9.4,60,22,13,"PAH",436,1,61,0)="QUIT if the label being printed is a OneVA Pharmacy label at the remote site."
^DIC(9.4,60,22,13,"PAH",437,0)="555 SEQ #455^3190501.14571^54"
^DIC(9.4,60,22,13,"PAH",437,1,0)="^^4^4^3190501"
^DIC(9.4,60,22,13,"PAH",437,1,1,0)="This patch addresses one (1) VistA Outpatient Pharmacy issue:"
^DIC(9.4,60,22,13,"PAH",437,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",437,1,3,0)="The installment of patch PSO*7*537 introduced an error that occurs "
^DIC(9.4,60,22,13,"PAH",437,1,4,0)="after a user edits a dosage."
^DIC(9.4,60,22,13,"PAH",438,0)="538 SEQ #456^3190501.145755^54"
^DIC(9.4,60,22,13,"PAH",438,1,0)="^^1^1^3190501"
^DIC(9.4,60,22,13,"PAH",438,1,1,0)="CORRECT INAPPROPRIATE DATE ENTRY IN COPY FUNCTION"
^DIC(9.4,60,22,13,"PAH",439,0)="551 SEQ #457^3190604.175427^54"
^DIC(9.4,60,22,13,"PAH",439,1,0)="^^1^1^3190604"
^DIC(9.4,60,22,13,"PAH",439,1,1,0)="INBOUND ERX MAINTENANCE PATCH 1"
^DIC(9.4,60,22,13,"PAH",440,0)="556 SEQ #458^3190604.17593^54"
^DIC(9.4,60,22,13,"PAH",441,0)="543 SEQ #459^3190604.1803^54"
^DIC(9.4,60,22,13,"PAH",441,1,0)="^^2^2^3190604"
^DIC(9.4,60,22,13,"PAH",441,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,60,22,13,"PAH",441,1,2,0)="under PSO*7*543."
^DIC(9.4,60,22,13,"PAH",442,0)="548 SEQ #461^3190722.164013^65"
^DIC(9.4,60,22,13,"PAH",442,1,0)="^^4^4^3190722"
^DIC(9.4,60,22,13,"PAH",442,1,1,0)="When finishing a non-controlled drug order immediately after finishing a"
^DIC(9.4,60,22,13,"PAH",442,1,2,0)="renewal of a controlled drug, an incorrect expiration date occurs. The"
^DIC(9.4,60,22,13,"PAH",442,1,3,0)="non-controlled drugs are finished with the expiration date of the"
^DIC(9.4,60,22,13,"PAH",442,1,4,0)="controlled drug."
^DIC(9.4,60,22,13,"PAH",443,0)="558 SEQ #462^3190722.164644^65"
^DIC(9.4,60,22,13,"PAH",443,1,0)="^^3^3^3190722"
^DIC(9.4,60,22,13,"PAH",443,1,1,0)="This patch will fix an issue where NON-VA medications are being returned "
^DIC(9.4,60,22,13,"PAH",443,1,2,0)="in the VPR XML results when they are dated outside of the entered date "
^DIC(9.4,60,22,13,"PAH",443,1,3,0)="range for resulting."
^DIC(9.4,60,22,13,"PAH",444,0)="559 SEQ #464^3190722.171644^65"
^DIC(9.4,60,22,13,"PAH",444,1,0)="^^45^45^3190722"
^DIC(9.4,60,22,13,"PAH",444,1,1,0)="This patch will address the following two issues:"
^DIC(9.4,60,22,13,"PAH",444,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",444,1,3,0)="1. $ZE= <UNDEFINED>PROCESS+24^PSORWRAP *MW"
^DIC(9.4,60,22,13,"PAH",444,1,4,0)="   "
^DIC(9.4,60,22,13,"PAH",444,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",444,1,6,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",444,1,7,0)="1. INC5310207 - $ZE= <UNDEFINED>PROCESS+24^PSORWRAP *MW"
^DIC(9.4,60,22,13,"PAH",444,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",444,1,9,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",444,1,10,0)="--------"
^DIC(9.4,60,22,13,"PAH",444,1,11,0)="Ann Arbor VAMC reported about 5 or 6 entries in their error trap related to"
^DIC(9.4,60,22,13,"PAH",444,1,12,0)="OneVA Pharmacy functionality. After some research it was determined that the"
^DIC(9.4,60,22,13,"PAH",444,1,13,0)="error was happening because OneVA Pharmacy HL7 messages were being sent to"
^DIC(9.4,60,22,13,"PAH",444,1,14,0)="the Ann Arbor VAMC erroneously. The prescription number in the HL7 message"
^DIC(9.4,60,22,13,"PAH",444,1,15,0)="request did not exist in the Ann Arbor site as it was probably supposed to"
^DIC(9.4,60,22,13,"PAH",444,1,16,0)="be sent to a different site. That was what caused the hard error reported."
^DIC(9.4,60,22,13,"PAH",444,1,17,0)="At this point it is not clear why HL7 messages have been routed the wrong"
^DIC(9.4,60,22,13,"PAH",444,1,18,0)="site."
^DIC(9.4,60,22,13,"PAH",444,1,19,0)="  "
^DIC(9.4,60,22,13,"PAH",444,1,20,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",444,1,21,0)="-----------"
^DIC(9.4,60,22,13,"PAH",444,1,22,0)="The processing of incoming HL7 messages for OneVA Pharmacy fill requests"
^DIC(9.4,60,22,13,"PAH",444,1,23,0)="is being changed to check whether the prescription in the request actually"
^DIC(9.4,60,22,13,"PAH",444,1,24,0)="belongs to the site it arrived. If the prescription does not exist at the"
^DIC(9.4,60,22,13,"PAH",444,1,25,0)="site the message below will be displayed to the dispensing site user that"
^DIC(9.4,60,22,13,"PAH",444,1,26,0)="is requesting the OneVA fill:"
^DIC(9.4,60,22,13,"PAH",444,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",444,1,28,0)="  Processing refill request. Please be patient as it may take a moment"
^DIC(9.4,60,22,13,"PAH",444,1,29,0)="  for the host site to respond and generate your label data..."
^DIC(9.4,60,22,13,"PAH",444,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",444,1,31,0)="  Unable to complete transaction. "
^DIC(9.4,60,22,13,"PAH",444,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",444,1,33,0)="  The Rx #999999 does not belong to this facility (REMOTE SITE NAME). Please,"
^DIC(9.4,60,22,13,"PAH",444,1,34,0)="  try to place the fill request again. It may take up to 4 attempts to get a"
^DIC(9.4,60,22,13,"PAH",444,1,35,0)="  successful response. If the issue continues, please contact IT Support for"
^DIC(9.4,60,22,13,"PAH",444,1,36,0)="  assistance."
^DIC(9.4,60,22,13,"PAH",444,1,37,0)="  "
^DIC(9.4,60,22,13,"PAH",444,1,38,0)="  Press RETURN to continue: "
^DIC(9.4,60,22,13,"PAH",444,1,39,0)="     "
^DIC(9.4,60,22,13,"PAH",444,1,40,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",444,1,41,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",444,1,42,0)="Changed the routine PSORWRAP at REMOTE+21 to verify that the prescription "
^DIC(9.4,60,22,13,"PAH",444,1,43,0)="number in the incoming OneVA HL7 message actually belongs to the site"
^DIC(9.4,60,22,13,"PAH",444,1,44,0)="receiving the message. If it does not, stop processing and respond back to"
^DIC(9.4,60,22,13,"PAH",444,1,45,0)="the sending site with the message above. "
^DIC(9.4,60,22,13,"PAH",445,0)="528^3190801.084934^16"
^DIC(9.4,60,22,13,"PAH",446,0)="565 SEQ #466^3190815.161242^65"
^DIC(9.4,60,22,13,"PAH",446,1,0)="^^34^34^3190815"
^DIC(9.4,60,22,13,"PAH",446,1,1,0)="This patch will address the following two issues:"
^DIC(9.4,60,22,13,"PAH",446,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",446,1,3,0)="INC6047771    - ERX not including info after patch PSO*7*551"
^DIC(9.4,60,22,13,"PAH",446,1,4,0)="(d)INC6131517 - Recommendations for improvements to new eRx system"
^DIC(9.4,60,22,13,"PAH",446,1,5,0)="(d)INC6087293 - Inbound eRx prescriptions not showing quantity, days supply"
^DIC(9.4,60,22,13,"PAH",446,1,6,0)="                and refills under the"
^DIC(9.4,60,22,13,"PAH",446,1,7,0)="    "
^DIC(9.4,60,22,13,"PAH",446,1,8,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",446,1,9,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",446,1,10,0)="1. INC6047771    - ERX not including info after patch PSO*7*551"
^DIC(9.4,60,22,13,"PAH",446,1,11,0)="   (d)INC6131517 - Recommendations for improvements to new eRx system"
^DIC(9.4,60,22,13,"PAH",446,1,12,0)="   (d)INC6087293 - Inbound eRx prescriptions not showing quantity, days"
^DIC(9.4,60,22,13,"PAH",446,1,13,0)="                   supply and refills under the"
^DIC(9.4,60,22,13,"PAH",446,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",446,1,15,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",446,1,16,0)="--------"
^DIC(9.4,60,22,13,"PAH",446,1,17,0)="VA Sierra Nevada Health Care System reported that after the installation of "
^DIC(9.4,60,22,13,"PAH",446,1,18,0)="the patch PSO*7*551 they noticed that some fields related to the eRx "
^DIC(9.4,60,22,13,"PAH",446,1,19,0)="prescription (Qty, Days Supply and Refills) were no longer being displayed"
^DIC(9.4,60,22,13,"PAH",446,1,20,0)="when viewing the corresponding VistA Pending Order or Active Prescription. "
^DIC(9.4,60,22,13,"PAH",446,1,21,0)="It was confirmed that this issue was indeed caused by the patch PSO*7*551."
^DIC(9.4,60,22,13,"PAH",446,1,22,0)="   "
^DIC(9.4,60,22,13,"PAH",446,1,23,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",446,1,24,0)="-----------"
^DIC(9.4,60,22,13,"PAH",446,1,25,0)="This patch will restore the functionality accidently removed by the patch"
^DIC(9.4,60,22,13,"PAH",446,1,26,0)="PSO*7*551 by restoring the display of the fields Qty, Days Supply and "
^DIC(9.4,60,22,13,"PAH",446,1,27,0)="Refills from the original external prescription (eRx)."
^DIC(9.4,60,22,13,"PAH",446,1,28,0)="      "
^DIC(9.4,60,22,13,"PAH",446,1,29,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",446,1,30,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",446,1,31,0)="Changed the routine PSOERXU1 at line tag DERX1+95 to re-include the line "
^DIC(9.4,60,22,13,"PAH",446,1,32,0)="below that was removed by PSO*7*551:"
^DIC(9.4,60,22,13,"PAH",446,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",446,1,34,0)="   S IEN=IEN+1,@GL@(IEN,0)=LINETXT"
^DIC(9.4,60,22,13,"PAH",447,0)="567 SEQ #468^3190904.100625^65"
^DIC(9.4,60,22,13,"PAH",447,1,0)="^^2^2^3190904"
^DIC(9.4,60,22,13,"PAH",447,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,60,22,13,"PAH",447,1,2,0)="under PSO*7*567."
^DIC(9.4,60,22,13,"PAH",448,0)="564 SEQ #469^3190905.164606^65"
^DIC(9.4,60,22,13,"PAH",448,1,0)="^^2^2^3190905"
^DIC(9.4,60,22,13,"PAH",448,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,60,22,13,"PAH",448,1,2,0)="under PSO*7*564."
^DIC(9.4,60,22,13,"PAH",449,0)="457^3190930.103646^65"
^DIC(9.4,60,22,13,"PAH",449,1,0)="^^1^1^3190930"
^DIC(9.4,60,22,13,"PAH",449,1,1,0)="MENTAL HEALTH NCC PROJECT 5.01"
^DIC(9.4,60,22,13,"PAH",450,0)="569 SEQ #470^3191003.15493^65"
^DIC(9.4,60,22,13,"PAH",450,1,0)="^^2^2^3191003"
^DIC(9.4,60,22,13,"PAH",450,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,60,22,13,"PAH",450,1,2,0)="under PSO*7*569."
^DIC(9.4,60,22,13,"PAH",451,0)="568 SEQ #471^3191024.121127^65"
^DIC(9.4,60,22,13,"PAH",451,1,0)="^^3^3^3191024"
^DIC(9.4,60,22,13,"PAH",451,1,1,0)="When entering a duplicate prescription, if the original prescription was"
^DIC(9.4,60,22,13,"PAH",451,1,2,0)="sent to CMOP, rejected and filled locally, then the discontinue message"
^DIC(9.4,60,22,13,"PAH",451,1,3,0)="will report that the original prescription was not filled."
^DIC(9.4,60,22,13,"PAH",452,0)="557 SEQ #472^3191024.121303^65"
^DIC(9.4,60,22,13,"PAH",452,1,0)="^^4^4^3191024"
^DIC(9.4,60,22,13,"PAH",452,1,1,0)="When choosing a primary sort of PATIENT or ROUTE and secondary sort of "
^DIC(9.4,60,22,13,"PAH",452,1,2,0)="FLAGGED, the no orders are displayed. Also, when changing orderable item "
^DIC(9.4,60,22,13,"PAH",452,1,3,0)="on a prescription, if the units are omitted from the dose, the DISPENSE "
^DIC(9.4,60,22,13,"PAH",452,1,4,0)="UNITS PER DOSE field in computed incorrectly."
^DIC(9.4,60,22,13,"PAH",453,0)="573 SEQ #473^3191206.145403^65"
^DIC(9.4,60,22,13,"PAH",453,1,0)="^^1^1^3191206"
^DIC(9.4,60,22,13,"PAH",453,1,1,0)="DUPLICATE RX CREATED IN PSO LM BACKDOOR ORDERS"
^DIC(9.4,60,22,13,"PAH",454,0)="572 SEQ #474^3191206.155033^65"
^DIC(9.4,60,22,13,"PAH",454,1,0)="^^2^2^3191206"
^DIC(9.4,60,22,13,"PAH",454,1,1,0)="HPS patch to address overwritten error messages and deleted providers in"
^DIC(9.4,60,22,13,"PAH",454,1,2,0)="PSO LM BACKDOOR, and an index error in PSO COPAY RESET."
^DIC(9.4,60,22,13,"PAH",455,0)="582 SEQ #475^3191209.164056^65"
^DIC(9.4,60,22,13,"PAH",455,1,0)="^^56^56^3191209"
^DIC(9.4,60,22,13,"PAH",455,1,1,0)="This patch will address the following issue: "
^DIC(9.4,60,22,13,"PAH",455,1,2,0)="  "
^DIC(9.4,60,22,13,"PAH",455,1,3,0)="INC7463016 - Septra SS prescription - Inbound eRx (CORPUS CHRISTI) received"
^DIC(9.4,60,22,13,"PAH",455,1,4,0)="             an Rx and an error message was generated"
^DIC(9.4,60,22,13,"PAH",455,1,5,0)="(d)INC7463169 - Ammonium Lactate prescription - Inbound eRx (CORPUS CHRISTI)"
^DIC(9.4,60,22,13,"PAH",455,1,6,0)="                received an Rx and an error message was generated Detailed"
^DIC(9.4,60,22,13,"PAH",455,1,7,0)="                Description "
^DIC(9.4,60,22,13,"PAH",455,1,8,0)="(d)INC7216102 - Inbound eRx (CORPUS CHRISTI) received an Rx and an error"
^DIC(9.4,60,22,13,"PAH",455,1,9,0)="                message was generated"
^DIC(9.4,60,22,13,"PAH",455,1,10,0)="(d)INC7720939 - Inbound eRx 2 prescriptions with fatal errors"
^DIC(9.4,60,22,13,"PAH",455,1,11,0)="(d)INC7774257 - Inbound eRx - Fatal Errors"
^DIC(9.4,60,22,13,"PAH",455,1,12,0)="(d)INC7793995 - Inbound eRx fatal error on one prescription in Corpus Christi"
^DIC(9.4,60,22,13,"PAH",455,1,13,0)="                Outpatient Clinic Pharmacy"
^DIC(9.4,60,22,13,"PAH",455,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",455,1,15,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,60,22,13,"PAH",455,1,16,0)="-----------------------------"
^DIC(9.4,60,22,13,"PAH",455,1,17,0)="N/A"
^DIC(9.4,60,22,13,"PAH",455,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",455,1,19,0)="     "
^DIC(9.4,60,22,13,"PAH",455,1,20,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",455,1,21,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",455,1,22,0)="INC7463016 - Septra SS prescription - Inbound eRx (CORPUS CHRISTI) received"
^DIC(9.4,60,22,13,"PAH",455,1,23,0)="             an Rx and an error message was generated"
^DIC(9.4,60,22,13,"PAH",455,1,24,0)="(d)INC7463169 - Ammonium Lactate prescription - Inbound eRx (CORPUS CHRISTI)"
^DIC(9.4,60,22,13,"PAH",455,1,25,0)="                received an Rx and an error message was generated Detailed"
^DIC(9.4,60,22,13,"PAH",455,1,26,0)="                Description "
^DIC(9.4,60,22,13,"PAH",455,1,27,0)="(d)INC7216102 - Inbound eRx (CORPUS CHRISTI) received an Rx and an error"
^DIC(9.4,60,22,13,"PAH",455,1,28,0)="                message was generated"
^DIC(9.4,60,22,13,"PAH",455,1,29,0)="(d)INC7720939 - Inbound eRx 2 prescriptions with fatal errors"
^DIC(9.4,60,22,13,"PAH",455,1,30,0)="(d)INC7774257 - Inbound eRx - Fatal Errors"
^DIC(9.4,60,22,13,"PAH",455,1,31,0)="(d)INC7793995 - Inbound eRx fatal error on one prescription in Corpus Christi"
^DIC(9.4,60,22,13,"PAH",455,1,32,0)="                Outpatient Clinic Pharmacy"
^DIC(9.4,60,22,13,"PAH",455,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",455,1,34,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",455,1,35,0)="--------"
^DIC(9.4,60,22,13,"PAH",455,1,36,0)="Corpus Christi VA Specialty Outpatient Clinic reported a fatal error "
^DIC(9.4,60,22,13,"PAH",455,1,37,0)="(<SUBSCRIPT> error) when trying to validate the Drug/SIG for an eRx record"
^DIC(9.4,60,22,13,"PAH",455,1,38,0)="when using the Complete Orders from eRx [PSO ERX FINISH] option. The same"
^DIC(9.4,60,22,13,"PAH",455,1,39,0)="error was reported by McAllen Outpatient Clinic. The error happens due to a"
^DIC(9.4,60,22,13,"PAH",455,1,40,0)="missing ""B"" cross-reference entry in the PHARMACY PATIENT file (#55) for the"
^DIC(9.4,60,22,13,"PAH",455,1,41,0)="patient being processed. It is unknown the reason why the ""B"" cross-reference"
^DIC(9.4,60,22,13,"PAH",455,1,42,0)="entry is missing for certain patients."
^DIC(9.4,60,22,13,"PAH",455,1,43,0)="   "
^DIC(9.4,60,22,13,"PAH",455,1,44,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",455,1,45,0)="-----------"
^DIC(9.4,60,22,13,"PAH",455,1,46,0)="This patch will prevent the error from happening for patients that have the"
^DIC(9.4,60,22,13,"PAH",455,1,47,0)="""B"" cross-reference entry missing by ignoring it. The missing ""B"" cross-"
^DIC(9.4,60,22,13,"PAH",455,1,48,0)="reference entry will have no negative impact in the processing of eRx "
^DIC(9.4,60,22,13,"PAH",455,1,49,0)="prescriptions for such patient because its use in the code was unnecessary"
^DIC(9.4,60,22,13,"PAH",455,1,50,0)="for the option to work properly."
^DIC(9.4,60,22,13,"PAH",455,1,51,0)="       "
^DIC(9.4,60,22,13,"PAH",455,1,52,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",455,1,53,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",455,1,54,0)="Modified the line tag DU+1^PSOERXD1 to instead of using the ""B"" cross-"
^DIC(9.4,60,22,13,"PAH",455,1,55,0)="reference to retrieve the patient IEN (Internal Entry Number) and set the "
^DIC(9.4,60,22,13,"PAH",455,1,56,0)="PSODFN variable to set the variable PSODFN directly with the PATIEN content."
^DIC(9.4,60,22,13,"PAH",456,0)="531 SEQ #476^3191219.143943^65"
^DIC(9.4,60,22,13,"PAH",456,1,0)="^^4^4^3191219"
^DIC(9.4,60,22,13,"PAH",456,1,1,0)="This patch will fix the following issue:"
^DIC(9.4,60,22,13,"PAH",456,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",456,1,3,0)="The incorrect fill is marked as dispensed and released if two fills for"
^DIC(9.4,60,22,13,"PAH",456,1,4,0)="one prescription is sent to the dispensing machine."
^DIC(9.4,60,22,13,"PAH",457,0)="570 SEQ #477^3200220.141456^65"
^DIC(9.4,60,22,13,"PAH",457,1,0)="^^2^2^3200220"
^DIC(9.4,60,22,13,"PAH",457,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,60,22,13,"PAH",457,1,2,0)="under PSO*7*570."
^DIC(9.4,60,22,13,"PAH",458,0)="583 SEQ #478^3200228.130235^65"
^DIC(9.4,60,22,13,"PAH",458,1,0)="^^58^58^3200228"
^DIC(9.4,60,22,13,"PAH",458,1,1,0)="This patch will address the following issue: "
^DIC(9.4,60,22,13,"PAH",458,1,2,0)="  "
^DIC(9.4,60,22,13,"PAH",458,1,3,0)="INC6715041 - software problem -- instructions (#TABS PER DOSE) got altered on"
^DIC(9.4,60,22,13,"PAH",458,1,4,0)="             prescriptions with renewals. RX 4879200 -TO RX 487920A,B,C"
^DIC(9.4,60,22,13,"PAH",458,1,5,0)="  "
^DIC(9.4,60,22,13,"PAH",458,1,6,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,60,22,13,"PAH",458,1,7,0)="-----------------------------"
^DIC(9.4,60,22,13,"PAH",458,1,8,0)="HITPS-6775"
^DIC(9.4,60,22,13,"PAH",458,1,9,0)="      "
^DIC(9.4,60,22,13,"PAH",458,1,10,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",458,1,11,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",458,1,12,0)="INC6715041 - software problem - instructions (#TABS PER DOSE) got altered on"
^DIC(9.4,60,22,13,"PAH",458,1,13,0)="             prescriptions with renewals. RX 4879200 -TO RX 487920A,B,C"
^DIC(9.4,60,22,13,"PAH",458,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",458,1,15,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",458,1,16,0)="--------"
^DIC(9.4,60,22,13,"PAH",458,1,17,0)="The CPRS patch OR*3*440 was released Back in 2017 to address a problem with"
^DIC(9.4,60,22,13,"PAH",458,1,18,0)="the Ward Clerk Menu [OR MAIN MENU WARD CLERK] option that was causing some"
^DIC(9.4,60,22,13,"PAH",458,1,19,0)="Outpatient Pharmacy orders and prescriptions to have the wrong dispense units."
^DIC(9.4,60,22,13,"PAH",458,1,20,0)="Although the patch seems to have resolved the problem by preventing new orders"
^DIC(9.4,60,22,13,"PAH",458,1,21,0)="with this issue from being created it did not go far enough to prevent that"
^DIC(9.4,60,22,13,"PAH",458,1,22,0)="existing orders with the issue could be copied or renewed and pass the problem"
^DIC(9.4,60,22,13,"PAH",458,1,23,0)="forward the problem to newly created orders."
^DIC(9.4,60,22,13,"PAH",458,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",458,1,25,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",458,1,26,0)="-----------"
^DIC(9.4,60,22,13,"PAH",458,1,27,0)="The patch will generate a list (see example below) of potential outpatient"
^DIC(9.4,60,22,13,"PAH",458,1,28,0)="prescriptions and will send it via Mailman message to all users that hold the"
^DIC(9.4,60,22,13,"PAH",458,1,29,0)="PSNMGR security key. These entries on this list should be analyzed one by one"
^DIC(9.4,60,22,13,"PAH",458,1,30,0)="by the Pharmacy ADPAC and a determination should be made as to whether the"
^DIC(9.4,60,22,13,"PAH",458,1,31,0)="outpatient prescription dose and dispense units are correct for the dispense"
^DIC(9.4,60,22,13,"PAH",458,1,32,0)="drug or not. If it is determined that the prescription dose and dispense unit"
^DIC(9.4,60,22,13,"PAH",458,1,33,0)="are incorrect the Outpatient Pharmacy staff should discontinue the prescription"
^DIC(9.4,60,22,13,"PAH",458,1,34,0)="and re-renter it with the correct dosing and dispense unit information.   "
^DIC(9.4,60,22,13,"PAH",458,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",458,1,36,0)="List example:"
^DIC(9.4,60,22,13,"PAH",458,1,37,0)="---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",458,1,38,0)="PATIENT (L4SSN)"
^DIC(9.4,60,22,13,"PAH",458,1,39,0)="  RX #         DISPENSE DRUG                DOSE ORD.     UNITS    STRENGTH"
^DIC(9.4,60,22,13,"PAH",458,1,40,0)="---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",458,1,41,0)="Division: CHEYENNE VAM&ROC "
^DIC(9.4,60,22,13,"PAH",458,1,42,0)="PSOPATIENT,ONE (3202)"
^DIC(9.4,60,22,13,"PAH",458,1,43,0)="  2298748      ACETAMINOPHEN 325MG TAB         325          1         999"
^DIC(9.4,60,22,13,"PAH",458,1,44,0)="PSOPATIENT,THREE (7894)"
^DIC(9.4,60,22,13,"PAH",458,1,45,0)="  2298875      ACETAMINOPHEN 325MG TAB         325          1         999"
^DIC(9.4,60,22,13,"PAH",458,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",458,1,47,0)="Division: GREELEY CLINIC "
^DIC(9.4,60,22,13,"PAH",458,1,48,0)="PSOPATIENT,TWO (1234)"
^DIC(9.4,60,22,13,"PAH",458,1,49,0)="  2298877      ACETAMINOPHEN 325MG TAB         325          1         999"
^DIC(9.4,60,22,13,"PAH",458,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",458,1,51,0)="3 prescriptions found.       "
^DIC(9.4,60,22,13,"PAH",458,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",458,1,53,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",458,1,54,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",458,1,55,0)="Created post-install routine PSO583PI loop through the PRESCRIPTION file (#52)"
^DIC(9.4,60,22,13,"PAH",458,1,56,0)="and check the dose for current prescriptions and the dispense unit and"
^DIC(9.4,60,22,13,"PAH",458,1,57,0)="strength of the dispense drug. If a discrepancy is found a prescription is"
^DIC(9.4,60,22,13,"PAH",458,1,58,0)="included on the Mailman message sent to the PSSMGR security key holders."
^DIC(9.4,60,22,13,"PAH",459,0)="591 SEQ #480^3200311.112537^65"
^DIC(9.4,60,22,13,"PAH",459,1,0)="^^106^106^3200311"
^DIC(9.4,60,22,13,"PAH",459,1,1,0)="This patch will address the following eRx issues: "
^DIC(9.4,60,22,13,"PAH",459,1,2,0)="  "
^DIC(9.4,60,22,13,"PAH",459,1,3,0)="1. INC7957997 - Grammar error in eRx processing screen"
^DIC(9.4,60,22,13,"PAH",459,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,5,0)="2. INC6442610    - inbound eRx issue - order stuck in queue"
^DIC(9.4,60,22,13,"PAH",459,1,6,0)="   INC6659074(d) - Wrong erx status code generated in VistA inbound erx"
^DIC(9.4,60,22,13,"PAH",459,1,7,0)="                   software version 3.0"
^DIC(9.4,60,22,13,"PAH",459,1,8,0)="   INC6245922(d) - eRX issue with acknowledging messages in RRD status that"
^DIC(9.4,60,22,13,"PAH",459,1,9,0)="                   change to RRP status for 1 patient"
^DIC(9.4,60,22,13,"PAH",459,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,11,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,60,22,13,"PAH",459,1,12,0)="-----------------------------"
^DIC(9.4,60,22,13,"PAH",459,1,13,0)="N/A "
^DIC(9.4,60,22,13,"PAH",459,1,14,0)="     "
^DIC(9.4,60,22,13,"PAH",459,1,15,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",459,1,16,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",459,1,17,0)="1. INC7957997 - Grammar error in eRx processing screen"
^DIC(9.4,60,22,13,"PAH",459,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,19,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",459,1,20,0)="--------"
^DIC(9.4,60,22,13,"PAH",459,1,21,0)="Alaska VA Healthcare System reported a grammar issue while accepting an eRx"
^DIC(9.4,60,22,13,"PAH",459,1,22,0)="prescription into VistA via the Complete Orders from eRx [PSO ERX FINISH]"
^DIC(9.4,60,22,13,"PAH",459,1,23,0)="option. After validating a patient via this option the software checks whether"
^DIC(9.4,60,22,13,"PAH",459,1,24,0)="the same patient has other eRx prescriptions waiting to be validated and if"
^DIC(9.4,60,22,13,"PAH",459,1,25,0)="any additional are found it will issue the following message/prompt (example):"
^DIC(9.4,60,22,13,"PAH",459,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,27,0)="   This patient has other prescriptions for: Dec 04, 2019"
^DIC(9.4,60,22,13,"PAH",459,1,28,0)="   Patient: XXXXXX,XXXXXXX"
^DIC(9.4,60,22,13,"PAH",459,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,30,0)="       DRUG                      PROVIDER                      REC DATE"
^DIC(9.4,60,22,13,"PAH",459,1,31,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",459,1,32,0)="   1.) GABAPENTIN 300 MG ORAL CAPSUSMITH,KATELON               JAN 04, 2020"
^DIC(9.4,60,22,13,"PAH",459,1,33,0)="   2.) METOPROLOL SUCCINATE ER 100 SMITH,KATELON               JAN 04, 2020"
^DIC(9.4,60,22,13,"PAH",459,1,34,0)="   "
^DIC(9.4,60,22,13,"PAH",459,1,35,0)="   Would you like apply the above validation to these prescriptions?"
^DIC(9.4,60,22,13,"PAH",459,1,36,0)="   Enter Yes or No: N//"
^DIC(9.4,60,22,13,"PAH",459,1,37,0)="  "
^DIC(9.4,60,22,13,"PAH",459,1,38,0)="The issue is with ""...like apply..."" which should read ""...like to apply..."""
^DIC(9.4,60,22,13,"PAH",459,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,40,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",459,1,41,0)="-----------"
^DIC(9.4,60,22,13,"PAH",459,1,42,0)="Inserted ""to"" between ""like"" and ""apply""."
^DIC(9.4,60,22,13,"PAH",459,1,43,0)="       "
^DIC(9.4,60,22,13,"PAH",459,1,44,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",459,1,45,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",459,1,46,0)="Changed the routine PSOERX1B at line tag BPROC+41 to include ""to"" between"
^DIC(9.4,60,22,13,"PAH",459,1,47,0)="""like"" and ""apply""."
^DIC(9.4,60,22,13,"PAH",459,1,48,0)="   "
^DIC(9.4,60,22,13,"PAH",459,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,50,0)="2. INC6442610    - inbound eRx issue - order stuck in queue"
^DIC(9.4,60,22,13,"PAH",459,1,51,0)="   INC6659074(d) - Wrong erx status code generated in VistA inbound erx"
^DIC(9.4,60,22,13,"PAH",459,1,52,0)="                   software version 3.0"
^DIC(9.4,60,22,13,"PAH",459,1,53,0)="   INC6245922(d) - eRX issue with acknowledging messages in RRD status that"
^DIC(9.4,60,22,13,"PAH",459,1,54,0)="                   change to RRP status for 1 patient"
^DIC(9.4,60,22,13,"PAH",459,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,56,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",459,1,57,0)="--------"
^DIC(9.4,60,22,13,"PAH",459,1,58,0)="VA Puget Sound Health Care System reported that Refill Response eRx records"
^DIC(9.4,60,22,13,"PAH",459,1,59,0)="with a status of RRP (REFILL REQUEST PROCESSED) are accumulating on their eRx"
^DIC(9.4,60,22,13,"PAH",459,1,60,0)="Work Queue and the users do not have a mechanism to remove them. This problem"
^DIC(9.4,60,22,13,"PAH",459,1,61,0)="interferes with their work because these types of records fills up pages and"
^DIC(9.4,60,22,13,"PAH",459,1,62,0)="of their Work Queue and there is no further processing needed to be performed"
^DIC(9.4,60,22,13,"PAH",459,1,63,0)="on them. Upon extensive research it was determined that RXA (REFILL RESPONSE"
^DIC(9.4,60,22,13,"PAH",459,1,64,0)="ACKNOWLEDGED) Refill Request records were erroneously being updated to RRP"
^DIC(9.4,60,22,13,"PAH",459,1,65,0)="once a new prescription was accepted via eRx for the same medication that was"
^DIC(9.4,60,22,13,"PAH",459,1,66,0)="previously designed. To illustrate a little further the sequence of events"
^DIC(9.4,60,22,13,"PAH",459,1,67,0)="happened the following way:"
^DIC(9.4,60,22,13,"PAH",459,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,69,0)="  1) Patient had eRx 'A' that had already been previously filled and did not"
^DIC(9.4,60,22,13,"PAH",459,1,70,0)="     have any more refills left. "
^DIC(9.4,60,22,13,"PAH",459,1,71,0)="  2) The VA Pharmacist uses the RR (eRx Refill Request) through the Patient"
^DIC(9.4,60,22,13,"PAH",459,1,72,0)="     Prescription Processing [PSO LM BACKDOOR ORDERS] option and a message is"
^DIC(9.4,60,22,13,"PAH",459,1,73,0)="     sent out to the Dr's Office. "
^DIC(9.4,60,22,13,"PAH",459,1,74,0)="  3) The Dr's Office denies the Refill/Renewal by sending a new eRx record to"
^DIC(9.4,60,22,13,"PAH",459,1,75,0)="     VistA which create a Refill Request records with a status of RXD (REFILL"
^DIC(9.4,60,22,13,"PAH",459,1,76,0)="     RESPONSE DENIED/DNTF)."
^DIC(9.4,60,22,13,"PAH",459,1,77,0)="  4) The VA Pharmacist then acknowledges the RXD record through the Complete"
^DIC(9.4,60,22,13,"PAH",459,1,78,0)="     Orders from eRx [PSO ERX FINISH] option, which changes the status of the"
^DIC(9.4,60,22,13,"PAH",459,1,79,0)="     Refill Response from RXD to RXA successfully removing it from the eRx"
^DIC(9.4,60,22,13,"PAH",459,1,80,0)="     Work Queue."
^DIC(9.4,60,22,13,"PAH",459,1,81,0)="  5) Later, the Dr's Office sends to VistA a new prescription for the patient "
^DIC(9.4,60,22,13,"PAH",459,1,82,0)="     with the same medication"
^DIC(9.4,60,22,13,"PAH",459,1,83,0)="  6) The VA Pharmacist processes the new eRx prescription and Accepts it. "
^DIC(9.4,60,22,13,"PAH",459,1,84,0)="     This action creates the problem because it mistakenly changes the status"
^DIC(9.4,60,22,13,"PAH",459,1,85,0)="     of the previously updated Refill Response from RXA to RRP, bringing it"
^DIC(9.4,60,22,13,"PAH",459,1,86,0)="     back to the eRx Work Queue which does not offer any means for the users"
^DIC(9.4,60,22,13,"PAH",459,1,87,0)="     to remove such records from the Work Queue."
^DIC(9.4,60,22,13,"PAH",459,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",459,1,89,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",459,1,90,0)="-----------"
^DIC(9.4,60,22,13,"PAH",459,1,91,0)="This patch will stop the status update from RXA to RRP described in the step"
^DIC(9.4,60,22,13,"PAH",459,1,92,0)="#6 above. Furthermore, it will remove all RRP records from the eRx Work Queue."
^DIC(9.4,60,22,13,"PAH",459,1,93,0)="The RRP records will still be visible if users intentionally are looking for"
^DIC(9.4,60,22,13,"PAH",459,1,94,0)="them through the SR (Search Queue) action, which is how the Work Queue was"
^DIC(9.4,60,22,13,"PAH",459,1,95,0)="designed to work originally."
^DIC(9.4,60,22,13,"PAH",459,1,96,0)="      "
^DIC(9.4,60,22,13,"PAH",459,1,97,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",459,1,98,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",459,1,99,0)="1) Changed the routine PSOERX at line tag BLDITEM+22 to include ""RRP"" in the "
^DIC(9.4,60,22,13,"PAH",459,1,100,0)="   list of status screened out for ""Refill Response"" type records, which will"
^DIC(9.4,60,22,13,"PAH",459,1,101,0)="   drop the erroneously RRP records from the Work Queue as soon as the patch"
^DIC(9.4,60,22,13,"PAH",459,1,102,0)="   is installed."
^DIC(9.4,60,22,13,"PAH",459,1,103,0)="2) Changed the routine PSOERX1B at line tag ADD+64 and the routine at line tag"
^DIC(9.4,60,22,13,"PAH",459,1,104,0)="   AUTODC+38 to only update the record status to RRP if the record type is a"
^DIC(9.4,60,22,13,"PAH",459,1,105,0)="   ""Refill Request"". This will prevent ""Refill Response"" records from being "
^DIC(9.4,60,22,13,"PAH",459,1,106,0)="   wrongly updated to RRP."
^DIC(9.4,60,22,13,"PAH",460,0)="586 SEQ #481^3200311.112852^65"
^DIC(9.4,60,22,13,"PAH",460,1,0)="^^3^3^3200311"
^DIC(9.4,60,22,13,"PAH",460,1,1,0)="INC8357891 - Inbound eRX drug incorrectly filtered."
^DIC(9.4,60,22,13,"PAH",460,1,2,0)="The detailed description of this build can be found in the National Patch "
^DIC(9.4,60,22,13,"PAH",460,1,3,0)="Module under PSO*7*586."
^DIC(9.4,60,22,13,"PAH",461,0)="595 SEQ #482^3200324.165757^70"
^DIC(9.4,60,22,13,"PAH",461,1,0)="^^5^5^3200324"
^DIC(9.4,60,22,13,"PAH",461,1,1,0)="CPRS patch OR*3*397 allowed a user with ORSUPPLY key to release supply "
^DIC(9.4,60,22,13,"PAH",461,1,2,0)="item orders. In backdoor pharmacy, when finishing a pending renewal "
^DIC(9.4,60,22,13,"PAH",461,1,3,0)="supply item order that was released by ORSUPPLY/ORELSE key holders (not "
^DIC(9.4,60,22,13,"PAH",461,1,4,0)="authorized to write med orders), a hard error is generated. This issue is "
^DIC(9.4,60,22,13,"PAH",461,1,5,0)="addressed in this patch. Jazz #1203196"
^DIC(9.4,60,22,13,"PAH",462,0)="587 SEQ #484^3200325.103711^70"
^DIC(9.4,60,22,13,"PAH",462,1,0)="^^1^1^3200325"
^DIC(9.4,60,22,13,"PAH",462,1,1,0)="IDENTIFY USER EDITING NEW PROVIDER"
^DIC(9.4,60,22,13,"PAH",463,0)="593 SEQ #483^3200325.120002^70"
^DIC(9.4,60,22,13,"PAH",463,1,0)="^^2^2^3200325"
^DIC(9.4,60,22,13,"PAH",463,1,1,0)="INC9101449 - Errors encountered when running List of Override "
^DIC(9.4,60,22,13,"PAH",463,1,2,0)="Prescriptions Report"
^DIC(9.4,60,22,13,"PAH",464,0)="574^3200410.154118^70"
^DIC(9.4,60,22,13,"PAH",464,1,0)="^^361^361^3200410"
^DIC(9.4,60,22,13,"PAH",464,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,2,0)="The MENTAL HEALTH NCC WARRANTY RELEASE 5.01 multi-build is a warranty "
^DIC(9.4,60,22,13,"PAH",464,1,3,0)="release for the National Clozapine Registry (NCR) software. This release "
^DIC(9.4,60,22,13,"PAH",464,1,4,0)="will fix the defects and incidents reported by the sites to the "
^DIC(9.4,60,22,13,"PAH",464,1,5,0)="developers of the National Clozapine Coordination (NCC) Project. The "
^DIC(9.4,60,22,13,"PAH",464,1,6,0)="project is also referred to as the Clozapine Modernization (ClozMod) "
^DIC(9.4,60,22,13,"PAH",464,1,7,0)="Project."
^DIC(9.4,60,22,13,"PAH",464,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,9,0)="The NCR is maintained by the National Clozapine Coordinating Center "
^DIC(9.4,60,22,13,"PAH",464,1,10,0)="(NCCC).  The NCCC is responsible for VA's compliance with the clozapine "
^DIC(9.4,60,22,13,"PAH",464,1,11,0)="Risk Evaluation and Mitigation Strategy (REMS), which is mandated by the "
^DIC(9.4,60,22,13,"PAH",464,1,12,0)="Food and Drug Administration (FDA) for tracking clozapine patients. "
^DIC(9.4,60,22,13,"PAH",464,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,14,0)="The multi-build contains the Mental Health patch YS*5.01*154 and the "
^DIC(9.4,60,22,13,"PAH",464,1,15,0)="Outpatient Pharmacy patch PSO*7.0*574.  The list of defects and their "
^DIC(9.4,60,22,13,"PAH",464,1,16,0)="resolution is below."
^DIC(9.4,60,22,13,"PAH",464,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,18,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",464,1,19,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",464,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,21,0)="Patch PSO*7.0*574 contains the following fixes:"
^DIC(9.4,60,22,13,"PAH",464,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,23,0)="1.      Incorrect computation of drug costs"
^DIC(9.4,60,22,13,"PAH",464,1,24,0)=" Defect 1132310"
^DIC(9.4,60,22,13,"PAH",464,1,25,0)=" INC7277287 - East Bay Division - Martinez Outpatient Clinic"
^DIC(9.4,60,22,13,"PAH",464,1,26,0)=" INC7340377 - VA Connecticut Healthcare System West Haven Campus"
^DIC(9.4,60,22,13,"PAH",464,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,28,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,29,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,30,0)="Users would see incorrect values for the costs of prescriptions."
^DIC(9.4,60,22,13,"PAH",464,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,32,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,33,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,34,0)="The PSODRG routine has been updated to fix the problem with incorrect "
^DIC(9.4,60,22,13,"PAH",464,1,35,0)="computation for prescription costs."
^DIC(9.4,60,22,13,"PAH",464,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,37,0)="The PSODRG routine was incorrectly referencing this field for the drug "
^DIC(9.4,60,22,13,"PAH",464,1,38,0)="cost:"
^DIC(9.4,60,22,13,"PAH",464,1,39,0)="  50,15        DISPENSE UNITS PER ORDER UNIT 660;5 NUMBER"
^DIC(9.4,60,22,13,"PAH",464,1,40,0)="It has been changed to this field:"
^DIC(9.4,60,22,13,"PAH",464,1,41,0)="  50,16        PRICE PER DISPENSE UNIT 660;6 NUMBER"
^DIC(9.4,60,22,13,"PAH",464,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,43,0)="2. During backdoor pharmacy process of Outpatient 4 Day Override order, a "
^DIC(9.4,60,22,13,"PAH",464,1,44,0)="field called LIMITED DURATION appears."
^DIC(9.4,60,22,13,"PAH",464,1,45,0)="Defect 981761"
^DIC(9.4,60,22,13,"PAH",464,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,47,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,48,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,49,0)="When entering a clozapine prescription for an Outpatient 4 Day Override "
^DIC(9.4,60,22,13,"PAH",464,1,50,0)="order, a field called LIMITED DURATION is presented.  The IOC sites "
^DIC(9.4,60,22,13,"PAH",464,1,51,0)="stated that this may be misleading to the pharmacy staff and want it "
^DIC(9.4,60,22,13,"PAH",464,1,52,0)="removed."
^DIC(9.4,60,22,13,"PAH",464,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,54,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,55,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,56,0)="The logic in routine PSOORED5 was modified to remove the LIMITED DURATION "
^DIC(9.4,60,22,13,"PAH",464,1,57,0)="field for clozapine prescriptions.  Routine PSONEW1 was modified to "
^DIC(9.4,60,22,13,"PAH",464,1,58,0)="correct the sig for the clozapine prescription."
^DIC(9.4,60,22,13,"PAH",464,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,60,0)="3. Patients who are actively receiving clozapine (e.g. had a prescription "
^DIC(9.4,60,22,13,"PAH",464,1,61,0)="last month) are discontinued."
^DIC(9.4,60,22,13,"PAH",464,1,62,0)="Defect 1132329"
^DIC(9.4,60,22,13,"PAH",464,1,63,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,64,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,65,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,66,0)="The YSCL DAILY TRANSMISSION option checks for clozapine patients who "
^DIC(9.4,60,22,13,"PAH",464,1,67,0)="should be discontinued.  The code uses a Mail Group and an ^XTMP storage "
^DIC(9.4,60,22,13,"PAH",464,1,68,0)="location that are in the Pharmacy namespace."
^DIC(9.4,60,22,13,"PAH",464,1,69,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,70,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,71,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,72,0)="The PSO574P pre-init routine was created to ensure that the PSOCLOZ Mail "
^DIC(9.4,60,22,13,"PAH",464,1,73,0)="Group TYPE is set to ""PUBLIC"" and ALLOW SELF ENROLLMENT? is set to ""NO"".  "
^DIC(9.4,60,22,13,"PAH",464,1,74,0)="This will prevent any issues when email messages are sent to that Mail "
^DIC(9.4,60,22,13,"PAH",464,1,75,0)="Group."
^DIC(9.4,60,22,13,"PAH",464,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,77,0)="Note: There are routines in the YS*5.01*154 patch that also address this "
^DIC(9.4,60,22,13,"PAH",464,1,78,0)="defect."
^DIC(9.4,60,22,13,"PAH",464,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,80,0)="4. The Register Clozapine Patient option needs a restriction to only "
^DIC(9.4,60,22,13,"PAH",464,1,81,0)="allow registered patients."
^DIC(9.4,60,22,13,"PAH",464,1,82,0)=" Defect 1133724"
^DIC(9.4,60,22,13,"PAH",464,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,84,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,85,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,86,0)="The Register Clozapine Patient [PSOL REGISTER PATIENT] option needs a "
^DIC(9.4,60,22,13,"PAH",464,1,87,0)="restriction to only allow patients that have a CLOZAPINE REGISTRATION "
^DIC(9.4,60,22,13,"PAH",464,1,88,0)="NUMBER in the CLOZAPINE PATIENT LIST file (#603.01).  The option updates "
^DIC(9.4,60,22,13,"PAH",464,1,89,0)="fields in the PHARMACY PATIENT file (#55)."
^DIC(9.4,60,22,13,"PAH",464,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,91,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,92,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,93,0)="The PSOCLUTL routine was modified to only allow patients who have a "
^DIC(9.4,60,22,13,"PAH",464,1,94,0)="registration number to be updated in the PHARMACY PATIENT file (#55)."
^DIC(9.4,60,22,13,"PAH",464,1,95,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,96,0)="5. Temporary Clozapine Authorization Number not in correct format"
^DIC(9.4,60,22,13,"PAH",464,1,97,0)=" Defect 1132422"
^DIC(9.4,60,22,13,"PAH",464,1,98,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,99,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,100,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,101,0)="At least one site has reported temporary registration starting with the "
^DIC(9.4,60,22,13,"PAH",464,1,102,0)="letter ""R"" when they were expecting it to start with ""Z""."
^DIC(9.4,60,22,13,"PAH",464,1,103,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,104,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,105,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,106,0)="The PSO574P pre-init routine also updates the CLOZAPINE WEEKEND "
^DIC(9.4,60,22,13,"PAH",464,1,107,0)="REGISTRATION list that is stored in ^XTMP(""PSJ CLOZ"").  This will ensure "
^DIC(9.4,60,22,13,"PAH",464,1,108,0)="that any temporary registration numbers that were generated during IOC "
^DIC(9.4,60,22,13,"PAH",464,1,109,0)="tests and were not used will be recovered.  This issue was revealed in "
^DIC(9.4,60,22,13,"PAH",464,1,110,0)="the MailMan messages sent to the CLOZAPINE ROLL-UP Mail Group in Forum."
^DIC(9.4,60,22,13,"PAH",464,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,112,0)="6. Ensure ""Expires:"" Date is Correct"
^DIC(9.4,60,22,13,"PAH",464,1,113,0)="Defect 1132368"
^DIC(9.4,60,22,13,"PAH",464,1,114,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,115,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,116,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,117,0)="The CPRS team found a typo in routine PSODIR2.  The code had a comma "
^DIC(9.4,60,22,13,"PAH",464,1,118,0)="where it should have a less than sign.  Only clozapine prescriptions "
^DIC(9.4,60,22,13,"PAH",464,1,119,0)="would have been affected. This logic is used to create the value for the "
^DIC(9.4,60,22,13,"PAH",464,1,120,0)="""Expires:"" prompt in Patient Prescription Processing."
^DIC(9.4,60,22,13,"PAH",464,1,121,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,122,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,123,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,124,0)="Routine PSODIR2 was corrected."
^DIC(9.4,60,22,13,"PAH",464,1,125,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,126,0)="7. Dose default is missing for active or pending prescriptions."
^DIC(9.4,60,22,13,"PAH",464,1,127,0)="Defect 1106891"
^DIC(9.4,60,22,13,"PAH",464,1,128,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,129,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,130,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,131,0)="The default dose is missing when editing all prescriptions in Pharmacy "
^DIC(9.4,60,22,13,"PAH",464,1,132,0)="backdoor orders.  It should be there for non-clozapine prescriptions.  "
^DIC(9.4,60,22,13,"PAH",464,1,133,0)="The prior fix removed this for all prescriptions."
^DIC(9.4,60,22,13,"PAH",464,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,135,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,136,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,137,0)="The logic in routines PSOBKDED and PSONEW1 was modified to only remove "
^DIC(9.4,60,22,13,"PAH",464,1,138,0)="the default dose for Clozapine prescriptions."
^DIC(9.4,60,22,13,"PAH",464,1,139,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,140,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,141,0)="8. Remove the ""Quantity Being Changed"" message displaying during backdoor "
^DIC(9.4,60,22,13,"PAH",464,1,142,0)="pharmacy processing of a Clozapine Outpatient 4 Day Override Order."
^DIC(9.4,60,22,13,"PAH",464,1,143,0)="Defect 1155637"
^DIC(9.4,60,22,13,"PAH",464,1,144,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,145,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,146,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,147,0)="The ""Quantity Being Changed"" message was being displayed when a "
^DIC(9.4,60,22,13,"PAH",464,1,148,0)="pharmacist was editing a 4 day temporary override Clozapine "
^DIC(9.4,60,22,13,"PAH",464,1,149,0)="prescription.  Users at the IOC sites found this to be confusing wand "
^DIC(9.4,60,22,13,"PAH",464,1,150,0)="wanted it removed."
^DIC(9.4,60,22,13,"PAH",464,1,151,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,152,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,153,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,154,0)="The routine PSOSIG was modified to display this message ONLY for "
^DIC(9.4,60,22,13,"PAH",464,1,155,0)="non-clozapine prescriptions."
^DIC(9.4,60,22,13,"PAH",464,1,156,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,157,0)="9. CPRS Complex Order Default Dose Incorrect"
^DIC(9.4,60,22,13,"PAH",464,1,158,0)="Defect 1180952"
^DIC(9.4,60,22,13,"PAH",464,1,159,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,160,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,161,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,162,0)="Complex orders which have multiple dosages were not displaying the "
^DIC(9.4,60,22,13,"PAH",464,1,163,0)="correct defaults during dosage edit."
^DIC(9.4,60,22,13,"PAH",464,1,164,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,165,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,166,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,167,0)="Routine PSOBKDED was modified to add the default dose."
^DIC(9.4,60,22,13,"PAH",464,1,168,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,169,0)="10. Missing Unit Price of Drug"
^DIC(9.4,60,22,13,"PAH",464,1,170,0)="Defect 1181628"
^DIC(9.4,60,22,13,"PAH",464,1,171,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,172,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,173,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,174,0)="Prescriptions for certain medications were not storing the UNIT PRICE OF "
^DIC(9.4,60,22,13,"PAH",464,1,175,0)="DRUG field.  This occurred when the DRUG had a REORDER LEVEL field (#11) "
^DIC(9.4,60,22,13,"PAH",464,1,176,0)="value of zero or null."
^DIC(9.4,60,22,13,"PAH",464,1,177,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,178,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,179,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,180,0)="The branching logic in the SET^PSODRG subroutine was corrected."
^DIC(9.4,60,22,13,"PAH",464,1,181,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,182,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,183,0)="11. Temporary numbers generated off the date"
^DIC(9.4,60,22,13,"PAH",464,1,184,0)="Defect 1181858"
^DIC(9.4,60,22,13,"PAH",464,1,185,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,186,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,187,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,188,0)="The logic to generate a temporary clozapine registration number was not "
^DIC(9.4,60,22,13,"PAH",464,1,189,0)="always generating a sequential counter."
^DIC(9.4,60,22,13,"PAH",464,1,190,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,191,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,192,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,193,0)="The logic in FINDNEXT^PSOCLUTL was modified."
^DIC(9.4,60,22,13,"PAH",464,1,194,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,195,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,196,0)="12. ^XTMP(""PSJ CLOZ"",0) purge date"
^DIC(9.4,60,22,13,"PAH",464,1,197,0)="Defect 1181868"
^DIC(9.4,60,22,13,"PAH",464,1,198,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,199,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,200,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,201,0)="The purge date in the ^XTMP(""PSJ CLOZ"",0) global node was not always set "
^DIC(9.4,60,22,13,"PAH",464,1,202,0)="to the same number of days in the future. This is a matter of programming "
^DIC(9.4,60,22,13,"PAH",464,1,203,0)="style.  No error was generated; no functionality was affected.  The "
^DIC(9.4,60,22,13,"PAH",464,1,204,0)="development accepted this as a defect to end the discussion.  The change "
^DIC(9.4,60,22,13,"PAH",464,1,205,0)="cannot be seen by users and there is no way to test this."
^DIC(9.4,60,22,13,"PAH",464,1,206,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,207,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,208,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,209,0)="Routine PSOCLO1 was changed to call the line tag XTMPZRO^PSOCLOU."
^DIC(9.4,60,22,13,"PAH",464,1,210,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,211,0)="13. Expiration Date Calculated Incorrectly"
^DIC(9.4,60,22,13,"PAH",464,1,212,0)="Defect 1182728"
^DIC(9.4,60,22,13,"PAH",464,1,213,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,214,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,215,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,216,0)="When a Clozapine prescription was being edited the expiration date may "
^DIC(9.4,60,22,13,"PAH",464,1,217,0)="not have been computed correctly.  This was related to editing the "
^DIC(9.4,60,22,13,"PAH",464,1,218,0)="quantity and days supply values."
^DIC(9.4,60,22,13,"PAH",464,1,219,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,220,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,221,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,222,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,223,0)="Routines PSOCLO1, PSODIR1, and PSOORED6 were modified.  The logic to "
^DIC(9.4,60,22,13,"PAH",464,1,224,0)="compute the expiration was moved to the new subroutine EXPDT^PSOCLO1."
^DIC(9.4,60,22,13,"PAH",464,1,225,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,226,0)="14. Patient Lookup in Register Clozapine Patient [PSOL REGISTER PATIENT]"
^DIC(9.4,60,22,13,"PAH",464,1,227,0)="Defect 1210946"
^DIC(9.4,60,22,13,"PAH",464,1,228,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,229,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,230,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,231,0)="The Patient Lookup in the Register Clozapine Patient [PSOL REGISTER "
^DIC(9.4,60,22,13,"PAH",464,1,232,0)="PATIENT] option doesn't allow a user to enter the last initial and last 4 "
^DIC(9.4,60,22,13,"PAH",464,1,233,0)="digits of the patient's Social Security Number (SSN)."
^DIC(9.4,60,22,13,"PAH",464,1,234,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,235,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,236,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,237,0)="Routine PSOCLUTL was modified in the REG subroutine to add an ""M"" to the "
^DIC(9.4,60,22,13,"PAH",464,1,238,0)="DIC(0) value to allow a patient lookup on multiple cross-references."
^DIC(9.4,60,22,13,"PAH",464,1,239,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,240,0)="15. Error on Clozapine Inpatient Medication"
^DIC(9.4,60,22,13,"PAH",464,1,241,0)="Defect 1227862"
^DIC(9.4,60,22,13,"PAH",464,1,242,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,243,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",464,1,244,0)="--------"
^DIC(9.4,60,22,13,"PAH",464,1,245,0)="When a user enters the Inpatient Order Entry [PSJ OE] option for "
^DIC(9.4,60,22,13,"PAH",464,1,246,0)="Clozapine patients an <UNDEFINED> error occurs.  The PSODFN variable is "
^DIC(9.4,60,22,13,"PAH",464,1,247,0)="undefined,"
^DIC(9.4,60,22,13,"PAH",464,1,248,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,249,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",464,1,250,0)="-----------"
^DIC(9.4,60,22,13,"PAH",464,1,251,0)="Routine PSOCLO1 was modified to set PSODFN if it's undefined, based on "
^DIC(9.4,60,22,13,"PAH",464,1,252,0)="the value in DFN."
^DIC(9.4,60,22,13,"PAH",464,1,253,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,254,0)="   *   *   *   *   *   *"
^DIC(9.4,60,22,13,"PAH",464,1,255,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,256,0)="Test Sites:"
^DIC(9.4,60,22,13,"PAH",464,1,257,0)="----------"
^DIC(9.4,60,22,13,"PAH",464,1,258,0)=" - West Los Angeles VAMC (691)"
^DIC(9.4,60,22,13,"PAH",464,1,259,0)=" - N. Florida /S. Georgia VAMC (573)"
^DIC(9.4,60,22,13,"PAH",464,1,260,0)=" - VA Connecticut Healthcare System - West Haven Division (689)"
^DIC(9.4,60,22,13,"PAH",464,1,261,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,262,0)="There are no documentation updates associated with this patch."
^DIC(9.4,60,22,13,"PAH",464,1,263,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,264,0)="Patch Installation:"
^DIC(9.4,60,22,13,"PAH",464,1,265,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,266,0)="Pre/Post Installation Overview:"
^DIC(9.4,60,22,13,"PAH",464,1,267,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",464,1,268,0)="There are no tasks to be performed before the installation of this "
^DIC(9.4,60,22,13,"PAH",464,1,269,0)="multi-build.  Note that the routines should be backed up to a PackMan "
^DIC(9.4,60,22,13,"PAH",464,1,270,0)="message before installing the build."
^DIC(9.4,60,22,13,"PAH",464,1,271,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,272,0)="Pre-Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",464,1,273,0)="------------------------------"
^DIC(9.4,60,22,13,"PAH",464,1,274,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,60,22,13,"PAH",464,1,275,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,60,22,13,"PAH",464,1,276,0)="potential disruption to users.  This patch should take less than 5 minutes"
^DIC(9.4,60,22,13,"PAH",464,1,277,0)="to install.  It should not be installed when the YSCL DAILY TRANSMISION "
^DIC(9.4,60,22,13,"PAH",464,1,278,0)="option is running.  If unsure when that is check the OPTION SCHEDULING "
^DIC(9.4,60,22,13,"PAH",464,1,279,0)="file (#19.2) using FileMan:"
^DIC(9.4,60,22,13,"PAH",464,1,280,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,281,0)="Select VA FileMan Option: Inquire to File Entries"
^DIC(9.4,60,22,13,"PAH",464,1,282,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,283,0)="Output from what File: OPTION SCHEDULING//   (17 entries)"
^DIC(9.4,60,22,13,"PAH",464,1,284,0)="Select OPTION SCHEDULING NAME:  YSCL DAILY TRANSMISSION"
^DIC(9.4,60,22,13,"PAH",464,1,285,0)="Another one: "
^DIC(9.4,60,22,13,"PAH",464,1,286,0)="Standard Captioned Output? Yes//   (Yes)"
^DIC(9.4,60,22,13,"PAH",464,1,287,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,60,22,13,"PAH",464,1,288,0)="Computed  Fields"
^DIC(9.4,60,22,13,"PAH",464,1,289,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,290,0)="NAME: YSCL DAILY TRANSMISSION"
^DIC(9.4,60,22,13,"PAH",464,1,291,0)="  QUEUED TO RUN AT WHAT TIME: OCT 05, 2019@01:30"
^DIC(9.4,60,22,13,"PAH",464,1,292,0)="  RESCHEDULING FREQUENCY: 1D            TASK ID: 2577736"
^DIC(9.4,60,22,13,"PAH",464,1,293,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,294,0)="Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",464,1,295,0)="--------------------------"
^DIC(9.4,60,22,13,"PAH",464,1,296,0)="1. The KIDS multi-build can be found in the VistA software repository at "
^DIC(9.4,60,22,13,"PAH",464,1,297,0)="download.vista.domain.ext"
^DIC(9.4,60,22,13,"PAH",464,1,298,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,299,0)="    ANON$:[ANONYMOUS.ANONYMOUS]MH_NCC_WARRANTY_5_01_T06.KID"
^DIC(9.4,60,22,13,"PAH",464,1,300,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,301,0)="Place the KIDS multi-build file into a local directory and use the KIDS "
^DIC(9.4,60,22,13,"PAH",464,1,302,0)="option Load a Distribution option to load it into the transport global."
^DIC(9.4,60,22,13,"PAH",464,1,303,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,304,0)="2. Choose the INSTALL/CHECK MESSAGE PackMan option."
^DIC(9.4,60,22,13,"PAH",464,1,305,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,306,0)="3. From the Kernel Installation and Distribution System Menu, select the"
^DIC(9.4,60,22,13,"PAH",464,1,307,0)="Installation Menu.  From this menu, you may elect to use the following"
^DIC(9.4,60,22,13,"PAH",464,1,308,0)="options. When prompted for the INSTALL NAME enter:"
^DIC(9.4,60,22,13,"PAH",464,1,309,0)="   MENTAL HEALTH NCC WARRANTY RELEASE 5.01"
^DIC(9.4,60,22,13,"PAH",464,1,310,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,311,0)="a. Backup a Transport Global - This option will create a backup message"
^DIC(9.4,60,22,13,"PAH",464,1,312,0)="of any routines exported with this patch."
^DIC(9.4,60,22,13,"PAH",464,1,313,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,314,0)="b. Compare Transport Global to Current System - This option will (allow"
^DIC(9.4,60,22,13,"PAH",464,1,315,0)="you to view all changes that will be made when this patch is installed.  "
^DIC(9.4,60,22,13,"PAH",464,1,316,0)="It compares all components of this patch routines, DDs, templates, etc.)."
^DIC(9.4,60,22,13,"PAH",464,1,317,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,318,0)="c. Verify Checksums in Transport Global - This option will allow you to"
^DIC(9.4,60,22,13,"PAH",464,1,319,0)="ensure the integrity of the routines that are in the transport global."
^DIC(9.4,60,22,13,"PAH",464,1,320,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,321,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,60,22,13,"PAH",464,1,322,0)="choose the patch to install (MENTAL HEALTH NCC WARRANTY RELEASE 5.01)."
^DIC(9.4,60,22,13,"PAH",464,1,323,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,324,0)="5. Accept the default when prompted 'Want KIDS to Rebuild Menu Trees Upon "
^DIC(9.4,60,22,13,"PAH",464,1,325,0)="Completion of Install? NO//'"
^DIC(9.4,60,22,13,"PAH",464,1,326,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,327,0)="6. Accept the default when prompted 'Want KIDS to INHIBIT LOGONs during "
^DIC(9.4,60,22,13,"PAH",464,1,328,0)="the install? NO//'"
^DIC(9.4,60,22,13,"PAH",464,1,329,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,330,0)="7. Accept the default when prompted 'Want to DISABLE Scheduled Options, "
^DIC(9.4,60,22,13,"PAH",464,1,331,0)="Menu Options, and Protocols? NO//'"
^DIC(9.4,60,22,13,"PAH",464,1,332,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,333,0)="8. If prompted 'Delay Install (Minutes):  (0 - 60): 0// enter 0 (zero)."
^DIC(9.4,60,22,13,"PAH",464,1,334,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,335,0)="Backout /Rollback Strategy:"
^DIC(9.4,60,22,13,"PAH",464,1,336,0)="---------------------------"
^DIC(9.4,60,22,13,"PAH",464,1,337,0)="Backout will be done only with the concurrence and participation of"
^DIC(9.4,60,22,13,"PAH",464,1,338,0)="development team and appropriate VA site/region personnel. The decision to"
^DIC(9.4,60,22,13,"PAH",464,1,339,0)="backout the software will be a joint decision between development"
^DIC(9.4,60,22,13,"PAH",464,1,340,0)="team, VA site and regional personnel, and other appropriate VA "
^DIC(9.4,60,22,13,"PAH",464,1,341,0)="personnel.  Rollback applies to data only and is not applicable to this "
^DIC(9.4,60,22,13,"PAH",464,1,342,0)="multi-build."
^DIC(9.4,60,22,13,"PAH",464,1,343,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,344,0)="Prior to installing the KIDS multi-build, the site/region should have"
^DIC(9.4,60,22,13,"PAH",464,1,345,0)="saved a backup of the routines in a PackMan message using the Backup a"
^DIC(9.4,60,22,13,"PAH",464,1,346,0)="Transport Global [XPD BACKUP] menu option (this is done at time of"
^DIC(9.4,60,22,13,"PAH",464,1,347,0)="install). The message containing the backed-up routines can be loaded with"
^DIC(9.4,60,22,13,"PAH",464,1,348,0)="the ""Xtract PackMan"" function at the Message Action prompt. The PackMan"
^DIC(9.4,60,22,13,"PAH",464,1,349,0)="function ""INSTALL/CHECK MESSAGE"" is then used to install the backed up"
^DIC(9.4,60,22,13,"PAH",464,1,350,0)="routines onto the VistA System."
^DIC(9.4,60,22,13,"PAH",464,1,351,0)=" "
^DIC(9.4,60,22,13,"PAH",464,1,352,0)="Validation of Backout Procedure"
^DIC(9.4,60,22,13,"PAH",464,1,353,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",464,1,354,0)="The backout Procedure can be verified by printing the first 2 lines of"
^DIC(9.4,60,22,13,"PAH",464,1,355,0)="the PSO* and YS* Routines contained in the MENTAL HEALTH NCC WARRANTY "
^DIC(9.4,60,22,13,"PAH",464,1,356,0)="RELEASE 5.01 multi-build using the option First Line Routine Print [XU "
^DIC(9.4,60,22,13,"PAH",464,1,357,0)="FIRST LINE PRINT]. Once the old routines listed in the multi-build patch "
^DIC(9.4,60,22,13,"PAH",464,1,358,0)="have been restored, the first two lines of the Routines will no longer "
^DIC(9.4,60,22,13,"PAH",464,1,359,0)="contain the designation of patch 574 (for Outpatient Pharmacy PSO* "
^DIC(9.4,60,22,13,"PAH",464,1,360,0)="routines) and patch 154 (for Mental Health YS* routines) in the patch "
^DIC(9.4,60,22,13,"PAH",464,1,361,0)="list section on line 2 of the routines."
^DIC(9.4,60,22,13,"PAH",465,0)="544^3200410.160808^70"
^DIC(9.4,60,22,13,"PAH",465,1,0)="^^1^1^3200410"
^DIC(9.4,60,22,13,"PAH",465,1,1,0)="MCCF EDI TAS EPHARMACY BUILD 13"
^DIC(9.4,60,22,13,"PAH",466,0)="608 SEQ #489^3200514.164943^70"
^DIC(9.4,60,22,13,"PAH",466,1,0)="^^44^44^3200514"
^DIC(9.4,60,22,13,"PAH",466,1,1,0)="This patch changes the upper limit of the DAYS TO PULL FROM SUSPENSE Field"
^DIC(9.4,60,22,13,"PAH",466,1,2,0)="(#3) and the DAYS TO PULL SUSPENDED CS CMOP Field (#3.1) of the OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",466,1,3,0)="SITE File (#59) from 10 to 15 days."
^DIC(9.4,60,22,13,"PAH",466,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,5,0)="The DAYS TO PULL FROM SUSPENSE Field (#3) controls the bundling of all "
^DIC(9.4,60,22,13,"PAH",466,1,6,0)="prescriptions for local dispensing suspense batches and for non-controlled"
^DIC(9.4,60,22,13,"PAH",466,1,7,0)="substances for Consolidated Mail Outpatient Pharmacy (CMOP) transmissions."
^DIC(9.4,60,22,13,"PAH",466,1,8,0)="So, if a patient has at least one prescription that falls within the print"
^DIC(9.4,60,22,13,"PAH",466,1,9,0)="through date for the local batch or non-controlled substances CMOP"
^DIC(9.4,60,22,13,"PAH",466,1,10,0)="transmission, then the software will add the number of days from this"
^DIC(9.4,60,22,13,"PAH",466,1,11,0)="parameter to the print through date and process any other prescriptions it"
^DIC(9.4,60,22,13,"PAH",466,1,12,0)="finds in that extended print through date for that patient."
^DIC(9.4,60,22,13,"PAH",466,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,14,0)="The DAYS TO PULL SUSPENDED CS CMOP Field (#3.1) controls the bundling of "
^DIC(9.4,60,22,13,"PAH",466,1,15,0)="controlled substances for CMOP transmissions. So, if a patient has at"
^DIC(9.4,60,22,13,"PAH",466,1,16,0)="least one prescription that falls within the print through date for the"
^DIC(9.4,60,22,13,"PAH",466,1,17,0)="controlled substances CMOP transmission, then the software will add the"
^DIC(9.4,60,22,13,"PAH",466,1,18,0)="number of days from this parameter to the print through date and process"
^DIC(9.4,60,22,13,"PAH",466,1,19,0)="any other prescriptions it finds in that extended print through date for"
^DIC(9.4,60,22,13,"PAH",466,1,20,0)="that patient."
^DIC(9.4,60,22,13,"PAH",466,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,22,0)="The field name DAYS TO PULL SUSPENDED CS CMOP has been changed to DAYS TO "
^DIC(9.4,60,22,13,"PAH",466,1,23,0)="PULL SUSPENSE CMOP CS."
^DIC(9.4,60,22,13,"PAH",466,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,26,0)="****NOTE****"
^DIC(9.4,60,22,13,"PAH",466,1,27,0)="The change to the DAYS TO PULL FROM SUSPENSE Field (#3) and DAYS TO PULL "
^DIC(9.4,60,22,13,"PAH",466,1,28,0)="SUSPENSE CMOP CS Field (#3.1) of the OUTPATIENT SITE File (#3) may lead to"
^DIC(9.4,60,22,13,"PAH",466,1,29,0)="NCPDP Reject 79 Refill Too Soon (RTS) claims."
^DIC(9.4,60,22,13,"PAH",466,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,31,0)="If the claim submission returns a Refill Too Soon (79) reject, the label "
^DIC(9.4,60,22,13,"PAH",466,1,32,0)="is NOT printed for the prescription and it is moved to the Refill Too "
^DIC(9.4,60,22,13,"PAH",466,1,33,0)="Soon/DUR section of the patient Medication Profile screen until the user "
^DIC(9.4,60,22,13,"PAH",466,1,34,0)="resolves the reject. The prescription will also display on the Third-Party"
^DIC(9.4,60,22,13,"PAH",466,1,35,0)="Payer Reject Worklist. If the claim submission returns a Reject Resolution"
^DIC(9.4,60,22,13,"PAH",466,1,36,0)="Required reject, the label is NOT printed for the prescription and it is"
^DIC(9.4,60,22,13,"PAH",466,1,37,0)="moved to the Reject Resolution Required section of the Third-Party Payer"
^DIC(9.4,60,22,13,"PAH",466,1,38,0)="Reject - Worklist."
^DIC(9.4,60,22,13,"PAH",466,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",466,1,40,0)="Please search for additional guidance on the eRevenue Resources main "
^DIC(9.4,60,22,13,"PAH",466,1,41,0)="landing page for Refill Too Soon. Guidance documents for COVID-19 Refill "
^DIC(9.4,60,22,13,"PAH",466,1,42,0)="Too Soon Override. The landing page may be accessed at:  "
^DIC(9.4,60,22,13,"PAH",466,1,43,0)="https://vaww.vashare.domain.ext/sites/eRevenueResources/Pages/HomePage.asp"
^DIC(9.4,60,22,13,"PAH",466,1,44,0)="x"
^DIC(9.4,60,22,13,"PAH",467,0)="566 SEQ #490^3200601.162241^70"
^DIC(9.4,60,22,13,"PAH",467,1,0)="^^2^2^3200601"
^DIC(9.4,60,22,13,"PAH",467,1,1,0)="This patch adds data to output for some existing encapsualtion APIs, and "
^DIC(9.4,60,22,13,"PAH",467,1,2,0)="also creates a new API to return Non-VA Med information."
^DIC(9.4,60,22,13,"PAH",468,0)="477^3200624.121444^65"
^DIC(9.4,60,22,13,"PAH",468,1,0)="^^75^75^3200624"
^DIC(9.4,60,22,13,"PAH",468,1,1,0)="This patch is part of CPRS v31 updates. It includes changes to the Outpatient"
^DIC(9.4,60,22,13,"PAH",468,1,2,0)="Pharmacy application related to DAYS SUPPLY values over 90 days verification"
^DIC(9.4,60,22,13,"PAH",468,1,3,0)="when a specific dispense drug is not defined in the pending order from CPRS."
^DIC(9.4,60,22,13,"PAH",468,1,4,0)="This patch also contains a new function for CPRS to call before authorizing"
^DIC(9.4,60,22,13,"PAH",468,1,5,0)="the user to copy an Outpatient Pharmacy order."
^DIC(9.4,60,22,13,"PAH",468,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,7,0)="Below Are some details regarding the two changes in this patch:"
^DIC(9.4,60,22,13,"PAH",468,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,9,0)="1. Patient Prescription Processing [PSO LM BACKDOOR]"
^DIC(9.4,60,22,13,"PAH",468,1,10,0)="   Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",468,1,11,0)="   -------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",468,1,12,0)="   When trying to finish an order if the Outpatient Pharmacy user selects a"
^DIC(9.4,60,22,13,"PAH",468,1,13,0)="   dispense drug that has a maximum days supply limit lower than the value"
^DIC(9.4,60,22,13,"PAH",468,1,14,0)="   that was entered in the order by CPRS, the software will inform the user"
^DIC(9.4,60,22,13,"PAH",468,1,15,0)="   that the current value for DAYS SUPPLY is invalid and it will prompt the"
^DIC(9.4,60,22,13,"PAH",468,1,16,0)="   user to enter a new value within the maximum value allowed for the "
^DIC(9.4,60,22,13,"PAH",468,1,17,0)="   dispense drug chosen, as shown in the example below:"
^DIC(9.4,60,22,13,"PAH",468,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,19,0)="   Pending OP Orders (ROUTINE)  Jan 11, 2017@13:52:45        Page:   1 of 2 "
^DIC(9.4,60,22,13,"PAH",468,1,20,0)="   TEST,PATIENT                                                       <A> "
^DIC(9.4,60,22,13,"PAH",468,1,21,0)="     PID: 666-66-6666                              Ht(cm): _______ (______)"
^DIC(9.4,60,22,13,"PAH",468,1,22,0)="     DOB: DEC 02,1900 (116)                        Wt(kg): _______ (______)"
^DIC(9.4,60,22,13,"PAH",468,1,23,0)="   ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",468,1,24,0)="   *(1) Orderable Item: FUROSEMIDE TAB <DIN>                                  "
^DIC(9.4,60,22,13,"PAH",468,1,25,0)="    (2)           Drug: No Dispense Drug Selected                      "
^DIC(9.4,60,22,13,"PAH",468,1,26,0)="                  Verb: TAKE                                            "
^DIC(9.4,60,22,13,"PAH",468,1,27,0)="    (3)        *Dosage: 40MG                                          "
^DIC(9.4,60,22,13,"PAH",468,1,28,0)="                *Route: BY MOUTH                              "
^DIC(9.4,60,22,13,"PAH",468,1,29,0)="             *Schedule: DAILY                                       "
^DIC(9.4,60,22,13,"PAH",468,1,30,0)="    (4)   Pat Instruct:                                                "
^DIC(9.4,60,22,13,"PAH",468,1,31,0)="     Provider Comments:                                                   "
^DIC(9.4,60,22,13,"PAH",468,1,32,0)="          Instructions: TAKE 1 TABLET BY MOUTH DAILY           "
^DIC(9.4,60,22,13,"PAH",468,1,33,0)="    (5) Patient Status: NBC                                              "
^DIC(9.4,60,22,13,"PAH",468,1,34,0)="    (6)     Issue Date: JAN 5,2017        (7) Fill Date: JAN 11,2017        "
^DIC(9.4,60,22,13,"PAH",468,1,35,0)="    (8)    Days Supply: 180               (9)   QTY (  ): 180              "
^DIC(9.4,60,22,13,"PAH",468,1,36,0)="   ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",468,1,37,0)="   +         Enter ?? for more actions                              "
^DIC(9.4,60,22,13,"PAH",468,1,38,0)="   Select Item(s): Next Screen// FN    Finish  "
^DIC(9.4,60,22,13,"PAH",468,1,39,0)="   "
^DIC(9.4,60,22,13,"PAH",468,1,40,0)="   DRUG NAME REQUIRED"
^DIC(9.4,60,22,13,"PAH",468,1,41,0)="   "
^DIC(9.4,60,22,13,"PAH",468,1,42,0)="   Instructions: TAKE 1 TABLET BY MOUTH DAILY"
^DIC(9.4,60,22,13,"PAH",468,1,43,0)="    "
^DIC(9.4,60,22,13,"PAH",468,1,44,0)="   The following Drug(s) are available for selection:"
^DIC(9.4,60,22,13,"PAH",468,1,45,0)="   1. FUROSEMIDE 40MG TAB"
^DIC(9.4,60,22,13,"PAH",468,1,46,0)="   2. FUROSEMIDE 20 MG"
^DIC(9.4,60,22,13,"PAH",468,1,47,0)="   3. FUROSEMIDE 40MG 60'S"
^DIC(9.4,60,22,13,"PAH",468,1,48,0)="   4. FUROSEMIDE 20MG TABS "
^DIC(9.4,60,22,13,"PAH",468,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,50,0)="   Select Drug by number:  (1-4): 1"
^DIC(9.4,60,22,13,"PAH",468,1,51,0)="   "
^DIC(9.4,60,22,13,"PAH",468,1,52,0)="   Invalid DAYS SUPPLY value (180), resetting it to 90 (maximum allowed)."
^DIC(9.4,60,22,13,"PAH",468,1,53,0)="   "
^DIC(9.4,60,22,13,"PAH",468,1,54,0)="   DAYS SUPPLY:  (1-90): 90// "
^DIC(9.4,60,22,13,"PAH",468,1,55,0)="   "
^DIC(9.4,60,22,13,"PAH",468,1,56,0)="2. A new Outpatient Pharmacy API called $$ORCOPY^PSOORCPY was created for"
^DIC(9.4,60,22,13,"PAH",468,1,57,0)="   Computerized Patient Record System (CPRS) to call in order to verify"
^DIC(9.4,60,22,13,"PAH",468,1,58,0)="   whether an Outpatient Pharmacy order can be copied or not. It will check"
^DIC(9.4,60,22,13,"PAH",468,1,59,0)="   to verify the dispense drug is still active and still marked for the"
^DIC(9.4,60,22,13,"PAH",468,1,60,0)="   outpatient application. The new API returns the following "
^DIC(9.4,60,22,13,"PAH",468,1,61,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,62,0)="   ""-1^Not a Valid Outpatient Medication Order."" - The prescription record"
^DIC(9.4,60,22,13,"PAH",468,1,63,0)="    cannot be found.  "
^DIC(9.4,60,22,13,"PAH",468,1,64,0)="     "
^DIC(9.4,60,22,13,"PAH",468,1,65,0)="   ""0^<Reason>"" - O indicates the order cannot be copied and the <Reason> why"
^DIC(9.4,60,22,13,"PAH",468,1,66,0)="   it cannot be copied (e.g., ""0^This Drug has been Inactivated."") "
^DIC(9.4,60,22,13,"PAH",468,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,68,0)="   ""1"" - Order can be copied."
^DIC(9.4,60,22,13,"PAH",468,1,69,0)=" "
^DIC(9.4,60,22,13,"PAH",468,1,70,0)="3. A new VistA Integration Control Registration (ICR) #6719 was created to "
^DIC(9.4,60,22,13,"PAH",468,1,71,0)="   allow the Computerized Patient Record System V. 1.0 (CPRS) to call the new"
^DIC(9.4,60,22,13,"PAH",468,1,72,0)="   Outpatient Pharmacy API $$ORCOPY^PSOORCPY (see #2 above) in order to"
^DIC(9.4,60,22,13,"PAH",468,1,73,0)="   prevent the copy of Outpatient Pharmacy order in certain situations, such"
^DIC(9.4,60,22,13,"PAH",468,1,74,0)="   as dispense drug is inactive or the dispense drug is no longer marked for"
^DIC(9.4,60,22,13,"PAH",468,1,75,0)="   outpatient pharmacy use."
^DIC(9.4,60,22,13,"PAH",469,0)="546 SEQ #494^3200707.164331^65"
^DIC(9.4,60,22,13,"PAH",469,1,0)="^^4^4^3200707"
^DIC(9.4,60,22,13,"PAH",469,1,1,0)="This patch addresses one (1) issue:"
^DIC(9.4,60,22,13,"PAH",469,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",469,1,3,0)="Status mismatches might occur between the ORDERS (#100) file and the "
^DIC(9.4,60,22,13,"PAH",469,1,4,0)="associated medication file - PRESCRIPTION (#52) or PHARMACY PATIENT (#55)."
^DIC(9.4,60,22,13,"PAH",470,0)="584 SEQ #496^3200707.165024^65"
^DIC(9.4,60,22,13,"PAH",470,1,0)="^^3^3^3200707"
^DIC(9.4,60,22,13,"PAH",470,1,1,0)="INC7454020 - PRN schedules calculating erroneous default quantity"
^DIC(9.4,60,22,13,"PAH",470,1,2,0)="INC7698142 - Duplicate HL7 messages sent to OPAI device INC7444486 - Drug"
^DIC(9.4,60,22,13,"PAH",470,1,3,0)="Costs report is incorrect"
^DIC(9.4,60,22,13,"PAH",471,0)="596 SEQ #495^3200707.165254^65"
^DIC(9.4,60,22,13,"PAH",471,1,0)="^^1^1^3200707"
^DIC(9.4,60,22,13,"PAH",471,1,1,0)="Release of Controlled Substance (CS) after Return to Stock issue."
^DIC(9.4,60,22,13,"PAH",472,0)="603 SEQ #493^3200709.161353^65"
^DIC(9.4,60,22,13,"PAH",472,1,0)="^^58^58^3200709"
^DIC(9.4,60,22,13,"PAH",472,1,1,0)="This patch will address the following issue: "
^DIC(9.4,60,22,13,"PAH",472,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",472,1,3,0)="INC9398751    - Partialed RXs are not releasing automatically from VISTA"
^DIC(9.4,60,22,13,"PAH",472,1,4,0)="(d)INC9586108 - outpatient partial Rxs not releasing after PSO*7*531"
^DIC(9.4,60,22,13,"PAH",472,1,5,0)="(d)INC9663815 - VistA: Outpatient Pharmacy: Rx Won't Go to CMOP Because of"
^DIC(9.4,60,22,13,"PAH",472,1,6,0)="                Local Partial?"
^DIC(9.4,60,22,13,"PAH",472,1,7,0)="(d)INC9768476 - Issue with VistA option PSO LM BACKDOOR ORDERS - Refill is"
^DIC(9.4,60,22,13,"PAH",472,1,8,0)="                released instead of partial then Rx cannot be suspended to"
^DIC(9.4,60,22,13,"PAH",472,1,9,0)="                CMOP"
^DIC(9.4,60,22,13,"PAH",472,1,10,0)="(d)INC9792380 - Scriptpro not releasing partial filled rx since PSO*7*531"
^DIC(9.4,60,22,13,"PAH",472,1,11,0)="                INSTALL"
^DIC(9.4,60,22,13,"PAH",472,1,12,0)="(d)INC9744639 - kb0107373 - GLA PARTIALS NOT RELEASING/SCRIPTPRO"
^DIC(9.4,60,22,13,"PAH",472,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",472,1,14,0)="  "
^DIC(9.4,60,22,13,"PAH",472,1,15,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,60,22,13,"PAH",472,1,16,0)="-----------------------------"
^DIC(9.4,60,22,13,"PAH",472,1,17,0)="HITPS-6704 - INC9398751/INC9586108/INC9663815/INC9768476/INC9792380/INC9744639"
^DIC(9.4,60,22,13,"PAH",472,1,18,0)="  "
^DIC(9.4,60,22,13,"PAH",472,1,19,0)="     "
^DIC(9.4,60,22,13,"PAH",472,1,20,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",472,1,21,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",472,1,22,0)="1. INC9398751    - Partialed RXs are not releasing automatically from VISTA"
^DIC(9.4,60,22,13,"PAH",472,1,23,0)="   (d)INC9586108 - outpatient partial Rxs not releasing after PSO*7*531"
^DIC(9.4,60,22,13,"PAH",472,1,24,0)="   (d)INC9663815 - VistA: Outpatient Pharmacy: Rx Won't Go to CMOP Because of"
^DIC(9.4,60,22,13,"PAH",472,1,25,0)="                   Local Partial?"
^DIC(9.4,60,22,13,"PAH",472,1,26,0)="   (d)INC9768476 - Issue with VistA option PSO LM BACKDOOR ORDERS - Refill is"
^DIC(9.4,60,22,13,"PAH",472,1,27,0)="                   released instead of partial then Rx cannot be suspended to"
^DIC(9.4,60,22,13,"PAH",472,1,28,0)="                   CMOP"
^DIC(9.4,60,22,13,"PAH",472,1,29,0)="   (d)INC9792380 - Scriptpro not releasing partial filled rx since PSO*7*531"
^DIC(9.4,60,22,13,"PAH",472,1,30,0)="                   INSTALL"
^DIC(9.4,60,22,13,"PAH",472,1,31,0)="   (d)INC9744639 - kb0107373 - GLA PARTIALS NOT RELEASING/SCRIPTPRO"
^DIC(9.4,60,22,13,"PAH",472,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",472,1,33,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",472,1,34,0)="--------"
^DIC(9.4,60,22,13,"PAH",472,1,35,0)="VA New Jersey Health Care System reported that after the installation of the"
^DIC(9.4,60,22,13,"PAH",472,1,36,0)="patch PSO*7*531 partial fills are no longer being automatically released when"
^DIC(9.4,60,22,13,"PAH",472,1,37,0)="the dispense message is received from the OPAI (Outpatient Pharmacy Automated"
^DIC(9.4,60,22,13,"PAH",472,1,38,0)="Interface) dispensing machines. The issue happens because incoming messages"
^DIC(9.4,60,22,13,"PAH",472,1,39,0)="from OPAI don't identify whether a fill was a partial or a regular fill. It"
^DIC(9.4,60,22,13,"PAH",472,1,40,0)="was confirmed that this issue was indeed caused by the patch PSO*7*531.  "
^DIC(9.4,60,22,13,"PAH",472,1,41,0)="   "
^DIC(9.4,60,22,13,"PAH",472,1,42,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",472,1,43,0)="-----------"
^DIC(9.4,60,22,13,"PAH",472,1,44,0)="This patch changes the logic for matching incoming HL7 message from OPAI "
^DIC(9.4,60,22,13,"PAH",472,1,45,0)="dispensing machines by matching it with the outgoing HL7 message via the"
^DIC(9.4,60,22,13,"PAH",472,1,46,0)="MESSAGE SERVER ID field (#10) in the PHARMACY EXTERNAL INTERFACE file "
^DIC(9.4,60,22,13,"PAH",472,1,47,0)="(#52.51) first. This logic should always find a match, however if for some"
^DIC(9.4,60,22,13,"PAH",472,1,48,0)="reason the matching fails it will resort to matching the Rx# along with the"
^DIC(9.4,60,22,13,"PAH",472,1,49,0)="fill, which should work as well. "
^DIC(9.4,60,22,13,"PAH",472,1,50,0)="      "
^DIC(9.4,60,22,13,"PAH",472,1,51,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",472,1,52,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",472,1,53,0)="Changed the routine PSOHLDS at line tag FACK2 to re-write the logic for "
^DIC(9.4,60,22,13,"PAH",472,1,54,0)="matching an incoming HL7 OPAI message with a record in the PHARMACY EXTERNAL "
^DIC(9.4,60,22,13,"PAH",472,1,55,0)="INTERFACE file (#52.51). The old logic was improved and left in place in case"
^DIC(9.4,60,22,13,"PAH",472,1,56,0)="the new logic fails for any reason. The change will assure an accurate"
^DIC(9.4,60,22,13,"PAH",472,1,57,0)="matching of an incoming HL7 OPAI message to the corresponding record in the"
^DIC(9.4,60,22,13,"PAH",472,1,58,0)="PHARMACY EXTERNAL INTERFACE file (#52.51)."
^DIC(9.4,60,22,13,"PAH",473,0)="594 SEQ #497^3200713.172506^65"
^DIC(9.4,60,22,13,"PAH",473,1,0)="^^2^2^3200713"
^DIC(9.4,60,22,13,"PAH",473,1,1,0)="Using ONEVA remote data requires choosing local drug file entry to fill "
^DIC(9.4,60,22,13,"PAH",473,1,2,0)="prescriptions for traveling vets. Only part of drug name/dose is visible."
^DIC(9.4,60,22,13,"PAH",474,0)="592 SEQ #498^3200721.134848^65"
^DIC(9.4,60,22,13,"PAH",474,1,0)="^^1^1^3200721"
^DIC(9.4,60,22,13,"PAH",474,1,1,0)="Correct display defect in Reset Copay Status"
^DIC(9.4,60,22,13,"PAH",475,0)="597 SEQ #499^3200803.112359^65"
^DIC(9.4,60,22,13,"PAH",475,1,0)="^^43^43^3200803"
^DIC(9.4,60,22,13,"PAH",475,1,1,0)="This patch will address the following issue: "
^DIC(9.4,60,22,13,"PAH",475,1,2,0)="  "
^DIC(9.4,60,22,13,"PAH",475,1,3,0)="1. INC9129002 - At the final step when verifying a non-verified prescription,"
^DIC(9.4,60,22,13,"PAH",475,1,4,0)="                VistA displays the incorrect prescription number. "
^DIC(9.4,60,22,13,"PAH",475,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",475,1,6,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",475,1,7,0)="--------------------------------------------"
^DIC(9.4,60,22,13,"PAH",475,1,8,0)="1. INC9129002 - At the final step when verifying a non-verified prescription,"
^DIC(9.4,60,22,13,"PAH",475,1,9,0)="                VistA displays the incorrect prescription number. "
^DIC(9.4,60,22,13,"PAH",475,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",475,1,11,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",475,1,12,0)="--------"
^DIC(9.4,60,22,13,"PAH",475,1,13,0)="The Veterans Health Care System of the Ozarks reported that at the final step"
^DIC(9.4,60,22,13,"PAH",475,1,14,0)="when verifying a non-verified prescription through the Patient Prescription "
^DIC(9.4,60,22,13,"PAH",475,1,15,0)="Processing [PSO LM BACKDOOR ORDERS] option it displays the incorrect"
^DIC(9.4,60,22,13,"PAH",475,1,16,0)="prescription number, as shown below:"
^DIC(9.4,60,22,13,"PAH",475,1,17,0)="  ..."
^DIC(9.4,60,22,13,"PAH",475,1,18,0)="  Now Processing Enhanced Order Checks!  Please wait..."
^DIC(9.4,60,22,13,"PAH",475,1,19,0)="  "
^DIC(9.4,60,22,13,"PAH",475,1,20,0)="  Press return to continue: "
^DIC(9.4,60,22,13,"PAH",475,1,21,0)="  "
^DIC(9.4,60,22,13,"PAH",475,1,22,0)="  TEST,PATIENT                 ID#:999-99-9999      RX#: 9999999  <<<< Wrong #"
^DIC(9.4,60,22,13,"PAH",475,1,23,0)="  SIMVASTATIN  5MG TAB"
^DIC(9.4,60,22,13,"PAH",475,1,24,0)="   "
^DIC(9.4,60,22,13,"PAH",475,1,25,0)="  VERIFY FOR MFR,OUTPATFOUR? (Y/N/Delete/Quit): Y// "
^DIC(9.4,60,22,13,"PAH",475,1,26,0)="  ... "
^DIC(9.4,60,22,13,"PAH",475,1,27,0)="  "
^DIC(9.4,60,22,13,"PAH",475,1,28,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",475,1,29,0)="-----------"
^DIC(9.4,60,22,13,"PAH",475,1,30,0)="It was determined that if a pharmacist first tries to verify a prescription"
^DIC(9.4,60,22,13,"PAH",475,1,31,0)="entered by a pharmacy technician that had a significant order check and "
^DIC(9.4,60,22,13,"PAH",475,1,32,0)="instead of verifying the prescription s/he enters ""Q"" to quit and move on to"
^DIC(9.4,60,22,13,"PAH",475,1,33,0)="a different patient, when s/he tried to verify a prescription for the newly"
^DIC(9.4,60,22,13,"PAH",475,1,34,0)="selected patient the RX# field displayed the number of the prescription from"
^DIC(9.4,60,22,13,"PAH",475,1,35,0)="the previous patient, the one with the significant order check. The problem "
^DIC(9.4,60,22,13,"PAH",475,1,36,0)="was addressed by resetting the variable that held the Rx# information every"
^DIC(9.4,60,22,13,"PAH",475,1,37,0)="time the user selects to verify a prescription."
^DIC(9.4,60,22,13,"PAH",475,1,38,0)="  "
^DIC(9.4,60,22,13,"PAH",475,1,39,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",475,1,40,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",475,1,41,0)="The problem was happening because the variable INT was being used and it was"
^DIC(9.4,60,22,13,"PAH",475,1,42,0)="not properly NEWed or KILLed. So, the variable INT was added to the list of"
^DIC(9.4,60,22,13,"PAH",475,1,43,0)="variables being NEWed at the line tag OERR+1 in the PSOVER routine."
^DIC(9.4,60,22,13,"PAH",476,0)="598 SEQ #500^3200810.125452^65"
^DIC(9.4,60,22,13,"PAH",476,1,0)="^^8^8^3200810"
^DIC(9.4,60,22,13,"PAH",476,1,1,0)="This patch will resolve the following issue(s)"
^DIC(9.4,60,22,13,"PAH",476,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",476,1,3,0)="1) When entering outpatient prescriptions and attempt to edit the issue "
^DIC(9.4,60,22,13,"PAH",476,1,4,0)="date, the system will allow you to change the issue date to more than 6"
^DIC(9.4,60,22,13,"PAH",476,1,5,0)="months in the past."
^DIC(9.4,60,22,13,"PAH",476,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",476,1,7,0)="2) When inbound eRx prescriptions are processed duplicate entries in the "
^DIC(9.4,60,22,13,"PAH",476,1,8,0)="ERX EXTERNAL PERSON file [#52.48] can occur. "
^DIC(9.4,60,22,13,"PAH",477,0)="611 SEQ #501^3200810.125604^65"
^DIC(9.4,60,22,13,"PAH",477,1,0)="^^3^3^3200810"
^DIC(9.4,60,22,13,"PAH",477,1,1,0)="When a user changes the Days Supply for a Clozapine Rx the user is now "
^DIC(9.4,60,22,13,"PAH",477,1,2,0)="also prompted to select the appropriate Refills #. See the patch "
^DIC(9.4,60,22,13,"PAH",477,1,3,0)="desciption on FORUM for more details."
^DIC(9.4,60,22,13,"PAH",478,0)="607 SEQ #503^3200923.105949^65"
^DIC(9.4,60,22,13,"PAH",478,1,0)="^^5^5^3200923"
^DIC(9.4,60,22,13,"PAH",478,1,1,0)="When attempting to print a patient's outpatient medication profile from "
^DIC(9.4,60,22,13,"PAH",478,1,2,0)="VISTA, only one page prints (the page that includes only the patient "
^DIC(9.4,60,22,13,"PAH",478,1,3,0)="information). Subsequent pages do not print. Additionally, on the second "
^DIC(9.4,60,22,13,"PAH",478,1,4,0)="page of the Medication Profile [PSO P] report there is an additional Page "
^DIC(9.4,60,22,13,"PAH",478,1,5,0)="2 header printed in the middle of the page and not at a page break."
^DIC(9.4,60,22,13,"PAH",479,0)="602 SEQ #504^3200923.110018^65"
^DIC(9.4,60,22,13,"PAH",479,1,0)="^^196^196^3200923"
^DIC(9.4,60,22,13,"PAH",479,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,60,22,13,"PAH",479,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,3,0)="1. When the UNIT PRICE OF DRUG in the Drug file (#50) is set to a higher"
^DIC(9.4,60,22,13,"PAH",479,1,4,0)="value than 9999.00 then when a RX is entered the value is not filed into"
^DIC(9.4,60,22,13,"PAH",479,1,5,0)="the Prescription file and (if ECME is setup) the message 'Cannot find"
^DIC(9.4,60,22,13,"PAH",479,1,6,0)="price for Item' is also displayed during the RX entry process (Patient"
^DIC(9.4,60,22,13,"PAH",479,1,7,0)="Prescription Processing).   The Input Transform of the UNIT PRICE OF DRUG"
^DIC(9.4,60,22,13,"PAH",479,1,8,0)="field in file 52 prevents a value from being stored when it is greater"
^DIC(9.4,60,22,13,"PAH",479,1,9,0)="than 9999.0000"
^DIC(9.4,60,22,13,"PAH",479,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,11,0)="   "
^DIC(9.4,60,22,13,"PAH",479,1,12,0)="Files & Fields Associated:"
^DIC(9.4,60,22,13,"PAH",479,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,14,0)="File Name (Number)      Field Name (Number)          New/Modified/Deleted"
^DIC(9.4,60,22,13,"PAH",479,1,15,0)="------------------      --------------------------   --------------------"
^DIC(9.4,60,22,13,"PAH",479,1,16,0)="PRESCRIPTION (#52)      UNIT PRICE OF DRUG (#17)     Modified"
^DIC(9.4,60,22,13,"PAH",479,1,17,0)="               "
^DIC(9.4,60,22,13,"PAH",479,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,19,0)="Associated ticket(s):"
^DIC(9.4,60,22,13,"PAH",479,1,20,0)="====================="
^DIC(9.4,60,22,13,"PAH",479,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,22,0)="1. INC9558577 Sites' seeing Not ECME Billable: Cannot find price for Item"
^DIC(9.4,60,22,13,"PAH",479,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,25,0)="Associated NSR(s):"
^DIC(9.4,60,22,13,"PAH",479,1,26,0)="=================="
^DIC(9.4,60,22,13,"PAH",479,1,27,0)="N/A"
^DIC(9.4,60,22,13,"PAH",479,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,29,0)="Participating Test Sites:"
^DIC(9.4,60,22,13,"PAH",479,1,30,0)="========================="
^DIC(9.4,60,22,13,"PAH",479,1,31,0)="TBD"
^DIC(9.4,60,22,13,"PAH",479,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,34,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",479,1,35,0)="==========================================="
^DIC(9.4,60,22,13,"PAH",479,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,37,0)="1. INC9558577 Sites' seeing Not ECME Billable: Cannot find price for Item"
^DIC(9.4,60,22,13,"PAH",479,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,39,0)="   Problem:"
^DIC(9.4,60,22,13,"PAH",479,1,40,0)="   -------"
^DIC(9.4,60,22,13,"PAH",479,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,42,0)="   When the UNIT PRICE OF DRUG in the Drug file (#50) is set to a higher"
^DIC(9.4,60,22,13,"PAH",479,1,43,0)="   value than 9999.00 then when a RX is entered the value is not filed"
^DIC(9.4,60,22,13,"PAH",479,1,44,0)="   into the Prescription file and (if ECME is setup) the message 'Cannot"
^DIC(9.4,60,22,13,"PAH",479,1,45,0)="   find price for Item' is also displayed during the RX entry process"
^DIC(9.4,60,22,13,"PAH",479,1,46,0)="   (Patient Prescription Processing).   The Input Transform of the UNIT"
^DIC(9.4,60,22,13,"PAH",479,1,47,0)="   PRICE OF DRUG field in file 52 prevents a value from being stored when"
^DIC(9.4,60,22,13,"PAH",479,1,48,0)="   it is greater than 9999.0000.  During testing it was also found that "
^DIC(9.4,60,22,13,"PAH",479,1,49,0)="   the field CURRENT UNIT PRICE OF DRUG (#1.2) in the Refill sub record"
^DIC(9.4,60,22,13,"PAH",479,1,50,0)="   allowed the price of the drug to be filled with a value greater than"
^DIC(9.4,60,22,13,"PAH",479,1,51,0)="   the input transform was defined to allow."
^DIC(9.4,60,22,13,"PAH",479,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,54,0)="   Resolution:"
^DIC(9.4,60,22,13,"PAH",479,1,55,0)="   ----------"
^DIC(9.4,60,22,13,"PAH",479,1,56,0)="   The input Transform of the UNIT PRICE OF DRUG in the Prescription file"
^DIC(9.4,60,22,13,"PAH",479,1,57,0)="   (#52) is modified to allow a maximum value of 999999.0000.  This "
^DIC(9.4,60,22,13,"PAH",479,1,58,0)="   matches the maximum values in fields PRICE PER ORDER UNIT, PRICE PER"
^DIC(9.4,60,22,13,"PAH",479,1,59,0)="   DISPENSE UNIT, and PRICE PER DISPENSE UNIT in the Drug File (#50)"
^DIC(9.4,60,22,13,"PAH",479,1,60,0)="   The input Transform of the CURRENT UNIT PRICE OF DRUG (#1.2) in the "
^DIC(9.4,60,22,13,"PAH",479,1,61,0)="   Prescription file (#52) is also modified to allow a maximum value of "
^DIC(9.4,60,22,13,"PAH",479,1,62,0)="   999999.0000.  Routine PSOR52 is also modified to not stuff the price of"
^DIC(9.4,60,22,13,"PAH",479,1,63,0)="   the drug into the refill field which avoided the input transform"
^DIC(9.4,60,22,13,"PAH",479,1,64,0)="   specifications. "
^DIC(9.4,60,22,13,"PAH",479,1,65,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,66,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,68,0)="Test Sites:"
^DIC(9.4,60,22,13,"PAH",479,1,69,0)="=========="
^DIC(9.4,60,22,13,"PAH",479,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,72,0)="Data Dictionaries Before:"
^DIC(9.4,60,22,13,"PAH",479,1,73,0)="========================"
^DIC(9.4,60,22,13,"PAH",479,1,74,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,75,0)="52,17    UNIT PRICE OF DRUG     0;17 NUMBER (Required)"
^DIC(9.4,60,22,13,"PAH",479,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,77,0)="         INPUT TRANSFORM:  K:+X'=X!(X>9999)!(X<0)!(X?.E1"".""5N.N) X"
^DIC(9.4,60,22,13,"PAH",479,1,78,0)="         LAST EDITED:      FEB 27, 2020 "
^DIC(9.4,60,22,13,"PAH",479,1,79,0)="         HELP-PROMPT:      Type a Number between 0 and 9999, 4 Decimal "
^DIC(9.4,60,22,13,"PAH",479,1,80,0)="                           Digits "
^DIC(9.4,60,22,13,"PAH",479,1,81,0)="         DESCRIPTION:      Price per dispense unit.  "
^DIC(9.4,60,22,13,"PAH",479,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,83,0)="         TECHNICAL DESCR:  This is the price per dispense unit (per ML/MG"
^DIC(9.4,60,22,13,"PAH",479,1,84,0)="                           etc.) that is calculated when entering the"
^DIC(9.4,60,22,13,"PAH",479,1,85,0)="                           price per order unit, e.g. Price per order unit"
^DIC(9.4,60,22,13,"PAH",479,1,86,0)="                           (bottle) =$0.49, dispense unit is ML & the"
^DIC(9.4,60,22,13,"PAH",479,1,87,0)="                           bottle has 1000ML. Price per dispense unit ="
^DIC(9.4,60,22,13,"PAH",479,1,88,0)="                           $(0.49/1000) = $0.00049 = $0.0005 (rounded to"
^DIC(9.4,60,22,13,"PAH",479,1,89,0)="                           the 4th decimal).  "
^DIC(9.4,60,22,13,"PAH",479,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,92,0)="Data Dictionaries After:"
^DIC(9.4,60,22,13,"PAH",479,1,93,0)="======================="
^DIC(9.4,60,22,13,"PAH",479,1,94,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,95,0)="52,17    UNIT PRICE OF DRUG     0;17 NUMBER (Required)"
^DIC(9.4,60,22,13,"PAH",479,1,96,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,97,0)="         INPUT TRANSFORM:  K:+X'=X!(X>999999)!(X<0)!(X?.E1"".""5N.N) X"
^DIC(9.4,60,22,13,"PAH",479,1,98,0)="         LAST EDITED:      FEB 27, 2020 "
^DIC(9.4,60,22,13,"PAH",479,1,99,0)="         HELP-PROMPT:      Type a Number between 0 and 999999, 4 Decimal "
^DIC(9.4,60,22,13,"PAH",479,1,100,0)="                           Digits "
^DIC(9.4,60,22,13,"PAH",479,1,101,0)="         DESCRIPTION:      Price per dispense unit.  "
^DIC(9.4,60,22,13,"PAH",479,1,102,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,103,0)="         TECHNICAL DESCR:  This is the price per dispense unit (per ML/MG"
^DIC(9.4,60,22,13,"PAH",479,1,104,0)="                           etc.) that is calculated when entering the"
^DIC(9.4,60,22,13,"PAH",479,1,105,0)="                           price per order unit, e.g. Price per order unit"
^DIC(9.4,60,22,13,"PAH",479,1,106,0)="                           (bottle) =$0.49, dispense unit is ML & the"
^DIC(9.4,60,22,13,"PAH",479,1,107,0)="                           bottle has 1000ML. Price per dispense unit ="
^DIC(9.4,60,22,13,"PAH",479,1,108,0)="                           $(0.49/1000) = $0.00049 = $0.0005 (rounded to"
^DIC(9.4,60,22,13,"PAH",479,1,109,0)="                           the 4th decimal).  "
^DIC(9.4,60,22,13,"PAH",479,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,112,0)="Pre-Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",479,1,113,0)="============================="
^DIC(9.4,60,22,13,"PAH",479,1,114,0)="This patch may be loaded with users on the system. You may wish to "
^DIC(9.4,60,22,13,"PAH",479,1,115,0)="install it during non-peak hours. Installation will take less than 1 "
^DIC(9.4,60,22,13,"PAH",479,1,116,0)="minute. "
^DIC(9.4,60,22,13,"PAH",479,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,119,0)="Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",479,1,120,0)="========================="
^DIC(9.4,60,22,13,"PAH",479,1,121,0)="   1. Choose the PackMan message containing this patch."
^DIC(9.4,60,22,13,"PAH",479,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,123,0)="   2. Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu. This"
^DIC(9.4,60,22,13,"PAH",479,1,124,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,60,22,13,"PAH",479,1,125,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,126,0)="   3. On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,60,22,13,"PAH",479,1,127,0)="      select the 'Installation' menu."
^DIC(9.4,60,22,13,"PAH",479,1,128,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,129,0)="   4. From this menu, you may elect to use the following option. When "
^DIC(9.4,60,22,13,"PAH",479,1,130,0)="      prompted for the INSTALL NAME select the package 'PSO*7.0*602':"
^DIC(9.4,60,22,13,"PAH",479,1,131,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,132,0)="      a. Print Transport Global - This option will allow you to print "
^DIC(9.4,60,22,13,"PAH",479,1,133,0)="         only a summary of the patch, to print a summary of the patch and"
^DIC(9.4,60,22,13,"PAH",479,1,134,0)="         the routines in the transport global, or to print only the"
^DIC(9.4,60,22,13,"PAH",479,1,135,0)="         routines in the transport global."
^DIC(9.4,60,22,13,"PAH",479,1,136,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,137,0)="      b. Compare Transport Global to Current System - This option will "
^DIC(9.4,60,22,13,"PAH",479,1,138,0)="         allow you to view all changes that will be made when this patch"
^DIC(9.4,60,22,13,"PAH",479,1,139,0)="         is installed. It compares all components of this patch (routines,"
^DIC(9.4,60,22,13,"PAH",479,1,140,0)="         DDs, templates, etc.)."
^DIC(9.4,60,22,13,"PAH",479,1,141,0)="      "
^DIC(9.4,60,22,13,"PAH",479,1,142,0)="   5. From the Installation Menu, select Backup a Transport Global - This "
^DIC(9.4,60,22,13,"PAH",479,1,143,0)="      option will create a backup message of any routines exported with "
^DIC(9.4,60,22,13,"PAH",479,1,144,0)="      this patch. It will not backup any other changes such as DDs or"
^DIC(9.4,60,22,13,"PAH",479,1,145,0)="      templates."
^DIC(9.4,60,22,13,"PAH",479,1,146,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,147,0)="   6. Use the 'Install Package(s)' option under the 'Installation' menu "
^DIC(9.4,60,22,13,"PAH",479,1,148,0)="      and select the package 'PSO*7.0*602'."
^DIC(9.4,60,22,13,"PAH",479,1,149,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,150,0)="   7. When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,60,22,13,"PAH",479,1,151,0)="      NO//', choose 'NO'."
^DIC(9.4,60,22,13,"PAH",479,1,152,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,153,0)="   8. When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,60,22,13,"PAH",479,1,154,0)="      and Protocols? NO//', choose 'NO'."
^DIC(9.4,60,22,13,"PAH",479,1,155,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,156,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,157,0)="Installation Verification:"
^DIC(9.4,60,22,13,"PAH",479,1,158,0)="========================="
^DIC(9.4,60,22,13,"PAH",479,1,159,0)="Review the Data Dictionary changes listed above using VA FileMan. "
^DIC(9.4,60,22,13,"PAH",479,1,160,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,161,0)="Select OPTION: 8  DATA DICTIONARY UTILITIES"
^DIC(9.4,60,22,13,"PAH",479,1,162,0)="Select DATA DICTIONARY UTILITY OPTION: 1  LIST FILE ATTRIBUTES"
^DIC(9.4,60,22,13,"PAH",479,1,163,0)=" START WITH What File: PRESCRIPTION//     (1863777 entries)"
^DIC(9.4,60,22,13,"PAH",479,1,164,0)="      GO TO What File: PRESCRIPTION//     (1863777 entries)"
^DIC(9.4,60,22,13,"PAH",479,1,165,0)="      Select SUB-FILE: "
^DIC(9.4,60,22,13,"PAH",479,1,166,0)="Select LISTING FORMAT: STANDARD//   "
^DIC(9.4,60,22,13,"PAH",479,1,167,0)="Start with field: FIRST// 17  UNIT PRICE OF DRUG"
^DIC(9.4,60,22,13,"PAH",479,1,168,0)="Go to field: 17  UNIT PRICE OF DRUG"
^DIC(9.4,60,22,13,"PAH",479,1,169,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,170,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,171,0)="Back-out/Rollback Strategy:"
^DIC(9.4,60,22,13,"PAH",479,1,172,0)="=========================="
^DIC(9.4,60,22,13,"PAH",479,1,173,0)="In the event of a catastrophic failure, the Facility CIO may make the "
^DIC(9.4,60,22,13,"PAH",479,1,174,0)="decision to back-out the patch."
^DIC(9.4,60,22,13,"PAH",479,1,175,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,176,0)="The back-out plan is to edit the Data Dictionaries returning them to"
^DIC(9.4,60,22,13,"PAH",479,1,177,0)="original pre-install state."
^DIC(9.4,60,22,13,"PAH",479,1,178,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,179,0)="To verify the back-out completed successfully, ensure the INPUT "
^DIC(9.4,60,22,13,"PAH",479,1,180,0)="TRANSFORMS have been edited as follows."
^DIC(9.4,60,22,13,"PAH",479,1,181,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,182,0)="Using FileMan, go to UTILITY FUNCTIONS, INPUT TRANSFORM (SYNTAX)"
^DIC(9.4,60,22,13,"PAH",479,1,183,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,184,0)="Select OPTION: 6  UTILITY FUNCTIONS"
^DIC(9.4,60,22,13,"PAH",479,1,185,0)="Select UTILITY OPTION: 5  INPUT TRANSFORM (SYNTAX)"
^DIC(9.4,60,22,13,"PAH",479,1,186,0)=" "
^DIC(9.4,60,22,13,"PAH",479,1,187,0)="Modify what File: PRESCRIPTION//          (1863777 entries)"
^DIC(9.4,60,22,13,"PAH",479,1,188,0)="Select FIELD: 17  UNIT PRICE OF DRUG"
^DIC(9.4,60,22,13,"PAH",479,1,189,0)="UNIT PRICE OF DRUG INPUT TRANSFORM: "
^DIC(9.4,60,22,13,"PAH",479,1,190,0)="K:+X'=X!(X>999999)!(X<0)!(X?.E1"".""5N.N) X"
^DIC(9.4,60,22,13,"PAH",479,1,191,0)="  Replace 999999 With 9999  Replace "
^DIC(9.4,60,22,13,"PAH",479,1,192,0)="   K:+X'=X!(X>9999)!(X<0)!(X?.E1"".""5N.N) X"
^DIC(9.4,60,22,13,"PAH",479,1,193,0)="'HELP'-PROMPT: Type a Number between 0 and 999999, 4 Decimal Digits"
^DIC(9.4,60,22,13,"PAH",479,1,194,0)="           Replace 999999 With 9999  Replace "
^DIC(9.4,60,22,13,"PAH",479,1,195,0)="   Type a Number between 0 and 9999, 4 Decimal Digits"
^DIC(9.4,60,22,13,"PAH",479,1,196,0)="XECUTABLE 'HELP': "
^DIC(9.4,60,22,13,"PAH",480,0)="612^3200923.152517^65"
^DIC(9.4,60,22,13,"PAH",480,1,0)="^^476^476^3200923"
^DIC(9.4,60,22,13,"PAH",480,1,1,0)=" The Health Integration & Modernization (HI&M) CLOZAPINE NCCC OVRD "
^DIC(9.4,60,22,13,"PAH",480,1,2,0)=" COVID-19 multi-build is an emergency patch to the National Clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,3,0)=" Registry (NCR) software to correct defects to Clozapine National "
^DIC(9.4,60,22,13,"PAH",480,1,4,0)=" Clozapine Coordinating Center (NCCC) Override functionality."
^DIC(9.4,60,22,13,"PAH",480,1,5,0)="  "
^DIC(9.4,60,22,13,"PAH",480,1,6,0)=" The NCR is maintained by the NCCC. The NCCC is responsible for VA's "
^DIC(9.4,60,22,13,"PAH",480,1,7,0)=" compliance with the clozapine Risk Evaluation and Mitigation Strategy "
^DIC(9.4,60,22,13,"PAH",480,1,8,0)=" (REMS), which is mandated by the Food and Drug Administration (FDA) for "
^DIC(9.4,60,22,13,"PAH",480,1,9,0)=" tracking clozapine patients."
^DIC(9.4,60,22,13,"PAH",480,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,11,0)=" The multi-build contains the Mental Health patch YS*5.01*166 and the "
^DIC(9.4,60,22,13,"PAH",480,1,12,0)=" Outpatient Pharmacy patch PSO*7.0*612.  The list of defects and their "
^DIC(9.4,60,22,13,"PAH",480,1,13,0)=" resolution is below."
^DIC(9.4,60,22,13,"PAH",480,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,15,0)=" This patch is also being released with informational patch PSJ*5*403 that"
^DIC(9.4,60,22,13,"PAH",480,1,16,0)=" documents changes to Inpatient Medications' processing of clozapine"
^DIC(9.4,60,22,13,"PAH",480,1,17,0)=" overrides that are a result of the defect fixes in PSO*7.0*612 and"
^DIC(9.4,60,22,13,"PAH",480,1,18,0)=" YS*5.01*166. "
^DIC(9.4,60,22,13,"PAH",480,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,20,0)=" Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",480,1,21,0)=" --------------------------------------------"
^DIC(9.4,60,22,13,"PAH",480,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,23,0)=" Patch PSO*7.0*612 contains the following changes: "
^DIC(9.4,60,22,13,"PAH",480,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,25,0)=" 1. Requirement 1 Enhancement - Automate the Pharmacy Registration of NCCC"
^DIC(9.4,60,22,13,"PAH",480,1,26,0)=" Clozapine Authorizations."
^DIC(9.4,60,22,13,"PAH",480,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,28,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",480,1,29,0)=" --------"
^DIC(9.4,60,22,13,"PAH",480,1,30,0)=" Currently, national clozapine authorization numbers are sent by the "
^DIC(9.4,60,22,13,"PAH",480,1,31,0)=" National Clozapine Coordinating Center (NCCC) and filed into the "
^DIC(9.4,60,22,13,"PAH",480,1,32,0)=" CLOZAPINE PATIENT LIST file (#603.01). Later, a pharmacy user must"
^DIC(9.4,60,22,13,"PAH",480,1,33,0)=" manually execute Vista option Register Clozapine Patient [PSOL REGISTER"
^DIC(9.4,60,22,13,"PAH",480,1,34,0)=" PATIENT] (for new patients), or Edit Data for a Patient in the Clozapine"
^DIC(9.4,60,22,13,"PAH",480,1,35,0)=" Program PSOL [EDIT] (for previously registered patients). "
^DIC(9.4,60,22,13,"PAH",480,1,36,0)="  "
^DIC(9.4,60,22,13,"PAH",480,1,37,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,38,0)=" ---------- "
^DIC(9.4,60,22,13,"PAH",480,1,39,0)=" Automate the clozapine registration process by automatically updating the"
^DIC(9.4,60,22,13,"PAH",480,1,40,0)=" patient's clozapine registration number and status when a new National "
^DIC(9.4,60,22,13,"PAH",480,1,41,0)=" Clozapine number is received from the NCCC."
^DIC(9.4,60,22,13,"PAH",480,1,42,0)="  "
^DIC(9.4,60,22,13,"PAH",480,1,43,0)=" Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,44,0)=" ---------------------"
^DIC(9.4,60,22,13,"PAH",480,1,45,0)=" New Pharmacy API PSOCLADD has been created that accepts Patient DFN and "
^DIC(9.4,60,22,13,"PAH",480,1,46,0)=" NCCC Clozapine Authorization number as input and files the number into "
^DIC(9.4,60,22,13,"PAH",480,1,47,0)=" the CLOZAPINE REGISTRATION NUMBER field (#53) in the PHARAMCY PATIENT "
^DIC(9.4,60,22,13,"PAH",480,1,48,0)=" file (#55), and updates the CLOZAPINE STATUS field (#54) to 'A' for "
^DIC(9.4,60,22,13,"PAH",480,1,49,0)=" Active. This API is executed when a new clozapine authorization is filed "
^DIC(9.4,60,22,13,"PAH",480,1,50,0)=" into the CLOZAPINE PATIENT LIST (#603.01) file via a mumps action cross "
^DIC(9.4,60,22,13,"PAH",480,1,51,0)=" reference."
^DIC(9.4,60,22,13,"PAH",480,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,54,0)=" 2. Requirement 1 Defect 1 - Incorrect Messages Displayed in Clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,55,0)=" Vista Options"
^DIC(9.4,60,22,13,"PAH",480,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,57,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",480,1,58,0)=" --------"
^DIC(9.4,60,22,13,"PAH",480,1,59,0)=" When more than one clozapine authorization number exists for a patient,"
^DIC(9.4,60,22,13,"PAH",480,1,60,0)=" the ""Register Clozapine Patient"" option currently displays the incorrect"
^DIC(9.4,60,22,13,"PAH",480,1,61,0)=" message, ""Patient,Name has not been authorized for Clozapine by the NCCC"
^DIC(9.4,60,22,13,"PAH",480,1,62,0)=" (National Clozapine Coordinating Center). This option is only available"
^DIC(9.4,60,22,13,"PAH",480,1,63,0)=" for known NCCC-registered patients."" when more than one entry in file"
^DIC(9.4,60,22,13,"PAH",480,1,64,0)=" 603.01 for the patient. This message displays regardless of patient's"
^DIC(9.4,60,22,13,"PAH",480,1,65,0)=" Clozapine Status in file 55. "
^DIC(9.4,60,22,13,"PAH",480,1,66,0)="     "
^DIC(9.4,60,22,13,"PAH",480,1,67,0)=" When more than one clozapine authorization number exists for a patient,"
^DIC(9.4,60,22,13,"PAH",480,1,68,0)=" the ""Edit Data for a Patient in the Clozapine Program"" option currently"
^DIC(9.4,60,22,13,"PAH",480,1,69,0)=" displays the incorrect message, ""Patient,Name has not been authorized for"
^DIC(9.4,60,22,13,"PAH",480,1,70,0)=" Clozapine by the NCCC in Dallas. Contact the NCCC in Dallas for"
^DIC(9.4,60,22,13,"PAH",480,1,71,0)=" authorization."" The patient cannot be selected."
^DIC(9.4,60,22,13,"PAH",480,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,73,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,74,0)=" -----------   "
^DIC(9.4,60,22,13,"PAH",480,1,75,0)=" The code associated with the 'Register a Clozapine Patient' option and"
^DIC(9.4,60,22,13,"PAH",480,1,76,0)=" the ""Edit Data for a Patient in the Clozapine Program"" shall be modified"
^DIC(9.4,60,22,13,"PAH",480,1,77,0)=" to display correct information about the patient's Clozapine registration"
^DIC(9.4,60,22,13,"PAH",480,1,78,0)=" status regardless of the number of clozapine numbers on file for the"
^DIC(9.4,60,22,13,"PAH",480,1,79,0)=" patient."
^DIC(9.4,60,22,13,"PAH",480,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,81,0)=" The ""Register Clozapine Patient"" option shall display ""Patient,Name is"
^DIC(9.4,60,22,13,"PAH",480,1,82,0)=" already registered with number CL99999. Use the edit option to change"
^DIC(9.4,60,22,13,"PAH",480,1,83,0)=" registration data, or contact your supervisor"" when more than one entry "
^DIC(9.4,60,22,13,"PAH",480,1,84,0)=" in file 603.01 for the patient. No other change in functionality to this "
^DIC(9.4,60,22,13,"PAH",480,1,85,0)=" option."
^DIC(9.4,60,22,13,"PAH",480,1,86,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,87,0)=" The ""Edit Data for a Patient in the Clozapine Program"" option shall "
^DIC(9.4,60,22,13,"PAH",480,1,88,0)=" not display the incorrect message ""Patient,Name has not been authorized "
^DIC(9.4,60,22,13,"PAH",480,1,89,0)=" for Clozapine by the NCCC in Dallas. Contact the NCCC in Dallas for "
^DIC(9.4,60,22,13,"PAH",480,1,90,0)=" authorization"". The option will allow the selection of a patient with "
^DIC(9.4,60,22,13,"PAH",480,1,91,0)=" more than one entry in file 603.01. No other change in functionality to "
^DIC(9.4,60,22,13,"PAH",480,1,92,0)=" this option."
^DIC(9.4,60,22,13,"PAH",480,1,93,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,94,0)=" Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,95,0)=" ---------------------"
^DIC(9.4,60,22,13,"PAH",480,1,96,0)=" Correct routine PSOCLUTL's lookups by patient into the CLOZAPINE PATIENT"
^DIC(9.4,60,22,13,"PAH",480,1,97,0)=" LIST file (#603.01) from $$FIND1^DIC, which fails when there is more than"
^DIC(9.4,60,22,13,"PAH",480,1,98,0)=" one clozapine authorization number on file for a patient, to D FIND^DIC,"
^DIC(9.4,60,22,13,"PAH",480,1,99,0)=" which finds all clozapine authorization numbers. The defective lookup is"
^DIC(9.4,60,22,13,"PAH",480,1,100,0)=" used as an initial test to allow the patient to be selected for"
^DIC(9.4,60,22,13,"PAH",480,1,101,0)=" registration; existing code will still prevent the patient from being "
^DIC(9.4,60,22,13,"PAH",480,1,102,0)=" selected due to previous registration, but the correct message will now "
^DIC(9.4,60,22,13,"PAH",480,1,103,0)=" display regarding the patient's registration status."
^DIC(9.4,60,22,13,"PAH",480,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,106,0)=" 3. Requirement 2 Defect 1 - Patient with Temp Registration and an NCCC "
^DIC(9.4,60,22,13,"PAH",480,1,107,0)=" Authorization and NCCC Override Date, but day supply limited to 4."
^DIC(9.4,60,22,13,"PAH",480,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,109,0)=" INC9951972: COVID-19 VistA PSO defect - Clozapine National Override "
^DIC(9.4,60,22,13,"PAH",480,1,110,0)=" patient's prescription limited to 4 days."
^DIC(9.4,60,22,13,"PAH",480,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,112,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",480,1,113,0)=" --------"
^DIC(9.4,60,22,13,"PAH",480,1,114,0)=" A Patient initially receives a 4-day emergency authorization, and later"
^DIC(9.4,60,22,13,"PAH",480,1,115,0)=" an NCCC Authorization and an NCCC Override Date. While the NCCC Override"
^DIC(9.4,60,22,13,"PAH",480,1,116,0)=" Date is still active, the Day Supply (for Outpatient Pharmacy) or Order"
^DIC(9.4,60,22,13,"PAH",480,1,117,0)=" Duration (for Inpatient Medications) continues to be limited to 4 days."
^DIC(9.4,60,22,13,"PAH",480,1,118,0)=" Inpatient Medications Order Duration is defined as the number of days"
^DIC(9.4,60,22,13,"PAH",480,1,119,0)=" between the order's Start Date/Time and Stop Date/Time."
^DIC(9.4,60,22,13,"PAH",480,1,120,0)="    "
^DIC(9.4,60,22,13,"PAH",480,1,121,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,122,0)=" -----------"
^DIC(9.4,60,22,13,"PAH",480,1,123,0)=" If a NCCC Authorized National Override Date is in effect following an"
^DIC(9.4,60,22,13,"PAH",480,1,124,0)=" initial local override, the system shall process an active clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,125,0)=" patient's clozapine prescription under national override processes "
^DIC(9.4,60,22,13,"PAH",480,1,126,0)=" allowing the patient to be provided with the approved quantity associated"
^DIC(9.4,60,22,13,"PAH",480,1,127,0)=" with their individual dispensing frequency from the DISPENSE FREQUENCY "
^DIC(9.4,60,22,13,"PAH",480,1,128,0)=" field (#2) in the CLOZAPINE PATIENT LIST file (#603.01). The approved "
^DIC(9.4,60,22,13,"PAH",480,1,129,0)=" quantity is determined by the order's Days Supply for Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",480,1,130,0)=" orders, and the Order Duration (days between Start Date/Time and Stop "
^DIC(9.4,60,22,13,"PAH",480,1,131,0)=" Date/Time) for Inpatient Medications orders."
^DIC(9.4,60,22,13,"PAH",480,1,132,0)="  "
^DIC(9.4,60,22,13,"PAH",480,1,133,0)=" Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,134,0)=" ---------------------"
^DIC(9.4,60,22,13,"PAH",480,1,135,0)="  A change was made in several routines to look in the PHARMACY PATIENT "
^DIC(9.4,60,22,13,"PAH",480,1,136,0)=" file (#55) for the patient's active clozapine authorization number before"
^DIC(9.4,60,22,13,"PAH",480,1,137,0)=" searching for the value in the patient's DISPENSE FREQUENCY field (#3) of"
^DIC(9.4,60,22,13,"PAH",480,1,138,0)=" the CLOZAPINE PATIENT LIST file (#603.01). This enables the clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,139,0)=" processing logic to any temporary initial local authorization on file "
^DIC(9.4,60,22,13,"PAH",480,1,140,0)=" that have been replaced by a permanent NCCC authorization numbers."
^DIC(9.4,60,22,13,"PAH",480,1,141,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,142,0)=" - To address backdoor entry of outpatient orders, routine DAYSEN^PSODIR1"
^DIC(9.4,60,22,13,"PAH",480,1,143,0)=" was changed to find the patient's registered clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,144,0)=" authorization number."
^DIC(9.4,60,22,13,"PAH",480,1,145,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,146,0)=" - To address backdoor entry of inpatient orders, routine ^PSOCLO1 "
^DIC(9.4,60,22,13,"PAH",480,1,147,0)=" was changed to find the patient's registered clozapine authorization "
^DIC(9.4,60,22,13,"PAH",480,1,148,0)=" number."
^DIC(9.4,60,22,13,"PAH",480,1,149,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,150,0)=" - To properly calculate days supply during the finishing of pending "
^DIC(9.4,60,22,13,"PAH",480,1,151,0)=" orders, routine CLOZ^PSOORFI2 was changed to find the patient's "
^DIC(9.4,60,22,13,"PAH",480,1,152,0)=" registered clozapine authorization number."
^DIC(9.4,60,22,13,"PAH",480,1,153,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,154,0)=" - To properly calculate days supply during the back door editing of "
^DIC(9.4,60,22,13,"PAH",480,1,155,0)=" active orders, routine ACT^PSOORNE2 was changed to find the patient's "
^DIC(9.4,60,22,13,"PAH",480,1,156,0)=" registered clozapine authorization number."
^DIC(9.4,60,22,13,"PAH",480,1,157,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,158,0)=" - To properly calculate default Days Supply in CPRS, change "
^DIC(9.4,60,22,13,"PAH",480,1,159,0)=" DSUP^PSOSIGDS was changed to find the patient's registered clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,160,0)=" authorization number. This changed routine is used by the ORWDPS1"
^DIC(9.4,60,22,13,"PAH",480,1,161,0)=" DFLTSPLY Remote Procedure Call (RPC) to calculate default Days Supply."
^DIC(9.4,60,22,13,"PAH",480,1,162,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,163,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,164,0)=" 4. Requirement 2 Defect 2 - Patient with NCCC Authorization receives a "
^DIC(9.4,60,22,13,"PAH",480,1,165,0)=" Special  Condition Fill, and later an NCCC Authorization and Override "
^DIC(9.4,60,22,13,"PAH",480,1,166,0)=" Date, but day supply limited to 4."
^DIC(9.4,60,22,13,"PAH",480,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,168,0)=" INC9951972: COVID-19 VistA PSO defect - Clozapine National Override "
^DIC(9.4,60,22,13,"PAH",480,1,169,0)=" patient's prescription limited to 4 days "
^DIC(9.4,60,22,13,"PAH",480,1,170,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,171,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",480,1,172,0)=" --------"
^DIC(9.4,60,22,13,"PAH",480,1,173,0)=" A patient with an initial NCCC Authorization receives a Special Condition"
^DIC(9.4,60,22,13,"PAH",480,1,174,0)=" override, followed by an NCCC override, is limited to a Day Supply"
^DIC(9.4,60,22,13,"PAH",480,1,175,0)=" (Outpatient Pharmacy orders) or an Order Duration (Inpatient Medications"
^DIC(9.4,60,22,13,"PAH",480,1,176,0)=" orders) limited to 4 for clozapine orders. The NCCC national clozapine"
^DIC(9.4,60,22,13,"PAH",480,1,177,0)=" override and the patient's regular clozapine dispense frequency are"
^DIC(9.4,60,22,13,"PAH",480,1,178,0)=" ignored."
^DIC(9.4,60,22,13,"PAH",480,1,179,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,180,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,181,0)=" -----------"
^DIC(9.4,60,22,13,"PAH",480,1,182,0)=" A patient with an initial NCCC clozapine authorization receiving a"
^DIC(9.4,60,22,13,"PAH",480,1,183,0)=" Special Condition override, followed by an NCCC override, shall be "
^DIC(9.4,60,22,13,"PAH",480,1,184,0)=" processed under national override rules allowing the patient to be "
^DIC(9.4,60,22,13,"PAH",480,1,185,0)=" provided with the approved quantity associated with their individual "
^DIC(9.4,60,22,13,"PAH",480,1,186,0)=" dispensing frequency from the DISPENSE FREQUENCY field (#2) in the "
^DIC(9.4,60,22,13,"PAH",480,1,187,0)=" CLOZAPINE PATIENT LIST file (#603.01). The approved quantity is reflected"
^DIC(9.4,60,22,13,"PAH",480,1,188,0)=" in the order's Days Supply for Outpatient Pharmacy orders, and the Order "
^DIC(9.4,60,22,13,"PAH",480,1,189,0)=" Duration (days between Start Date/Time and Stop Date/Time) for Inpatient "
^DIC(9.4,60,22,13,"PAH",480,1,190,0)=" Medications orders."
^DIC(9.4,60,22,13,"PAH",480,1,191,0)="  "
^DIC(9.4,60,22,13,"PAH",480,1,192,0)=" Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,193,0)=" ---------------------"
^DIC(9.4,60,22,13,"PAH",480,1,194,0)=" To address backdoor entry of outpatient orders, routine DAYSEN^PSODIR1"
^DIC(9.4,60,22,13,"PAH",480,1,195,0)=" was changed to find the patient's registered clozapine authorization"
^DIC(9.4,60,22,13,"PAH",480,1,196,0)=" number."
^DIC(9.4,60,22,13,"PAH",480,1,197,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,198,0)=" To address backdoor entry of inpatient orders, routine ^PSOCLO1 was"
^DIC(9.4,60,22,13,"PAH",480,1,199,0)=" changed to find the patient's registered clozapine authorization "
^DIC(9.4,60,22,13,"PAH",480,1,200,0)=" number."
^DIC(9.4,60,22,13,"PAH",480,1,201,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,202,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,203,0)=" 5. Requirement 2 Defect 3 - Local Special Condition Override followed"
^DIC(9.4,60,22,13,"PAH",480,1,204,0)=" by valid lab results limits orders to 4-day supply."
^DIC(9.4,60,22,13,"PAH",480,1,205,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,206,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",480,1,207,0)=" --------"
^DIC(9.4,60,22,13,"PAH",480,1,208,0)=" When a patient with an active NCCC clozapine registration and no "
^DIC(9.4,60,22,13,"PAH",480,1,209,0)=" current clozapine lab results receives a Local Special Condition "
^DIC(9.4,60,22,13,"PAH",480,1,210,0)=" override, followed by the entry of valid clozapine lab results, "
^DIC(9.4,60,22,13,"PAH",480,1,211,0)=" subsequent pharmacy orders continue to be limited to a 4-day supply."
^DIC(9.4,60,22,13,"PAH",480,1,212,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,213,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,214,0)=" -----------"
^DIC(9.4,60,22,13,"PAH",480,1,215,0)=" When a patient with an active NCCC clozapine registration and no "
^DIC(9.4,60,22,13,"PAH",480,1,216,0)=" current clozapine lab results receives a Local Special Condition "
^DIC(9.4,60,22,13,"PAH",480,1,217,0)=" override, followed by the entry of valid clozapine lab results, "
^DIC(9.4,60,22,13,"PAH",480,1,218,0)=" the Local Special Condition override is no longer in effect and should"
^DIC(9.4,60,22,13,"PAH",480,1,219,0)=" be ignored for new orders. New pharmacy orders should be processed "
^DIC(9.4,60,22,13,"PAH",480,1,220,0)=" using the days supply associated with their individual dispense"
^DIC(9.4,60,22,13,"PAH",480,1,221,0)=" frequency. The patient's dispense frequency is reflected in the order's "
^DIC(9.4,60,22,13,"PAH",480,1,222,0)=" Days Supply for Outpatient Pharmacy orders, and the Order Duration "
^DIC(9.4,60,22,13,"PAH",480,1,223,0)=" (days between Start Date/Time and Stop Date/Time) for Inpatient "
^DIC(9.4,60,22,13,"PAH",480,1,224,0)=" Medications orders."
^DIC(9.4,60,22,13,"PAH",480,1,225,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,226,0)=" Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,227,0)=" ---------------------"
^DIC(9.4,60,22,13,"PAH",480,1,228,0)=" Routine ^PSOCLO1 was modified to KILL the ^XTMP globals associated"
^DIC(9.4,60,22,13,"PAH",480,1,229,0)=" with the patient's local override when an active  NCCC clozapine "
^DIC(9.4,60,22,13,"PAH",480,1,230,0)=" registration and valid clozapine lab results exist. This prevents the "
^DIC(9.4,60,22,13,"PAH",480,1,231,0)=" obsolete Local Special Condition override from interfering with the "
^DIC(9.4,60,22,13,"PAH",480,1,232,0)=" patient's regular clozapine dispense frequency."
^DIC(9.4,60,22,13,"PAH",480,1,233,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,234,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,235,0)=" 6. Requirement 2 Defect 4 - Emergency Temp Override followed by new"
^DIC(9.4,60,22,13,"PAH",480,1,236,0)=" NCCC authorization limits orders to 4-day supply."
^DIC(9.4,60,22,13,"PAH",480,1,237,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,238,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",480,1,239,0)=" --------"
^DIC(9.4,60,22,13,"PAH",480,1,240,0)=" When a patient with a discontinued clozapine registration and current"
^DIC(9.4,60,22,13,"PAH",480,1,241,0)=" valid lab results receives a Local Emergency Temp Override, followed"
^DIC(9.4,60,22,13,"PAH",480,1,242,0)=" by a new NCCC clozapine authorization number and registration, "
^DIC(9.4,60,22,13,"PAH",480,1,243,0)=" subsequent pharmacy orders continue to be limited to a 4-day supply."
^DIC(9.4,60,22,13,"PAH",480,1,244,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,245,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,246,0)=" -----------"
^DIC(9.4,60,22,13,"PAH",480,1,247,0)=" When a patient with a discontinued clozapine registration and current"
^DIC(9.4,60,22,13,"PAH",480,1,248,0)=" valid lab results receives a Local Emergency Temp Override, followed"
^DIC(9.4,60,22,13,"PAH",480,1,249,0)=" by a new NCCC clozapine authorization number and registration, the Local"
^DIC(9.4,60,22,13,"PAH",480,1,250,0)=" Emergency Temp override is no longer in effect and should"
^DIC(9.4,60,22,13,"PAH",480,1,251,0)=" be ignored for new orders. New pharmacy orders should be processed "
^DIC(9.4,60,22,13,"PAH",480,1,252,0)=" using the days supply associated with the patient's dispense frequency."
^DIC(9.4,60,22,13,"PAH",480,1,253,0)=" The patient's dispense frequency is reflected in the order's Days "
^DIC(9.4,60,22,13,"PAH",480,1,254,0)=" Supply for Outpatient Pharmacy orders, and the Order Duration (days "
^DIC(9.4,60,22,13,"PAH",480,1,255,0)=" between Start Date/Time and Stop Date/Time) for Inpatient Medications "
^DIC(9.4,60,22,13,"PAH",480,1,256,0)=" orders."
^DIC(9.4,60,22,13,"PAH",480,1,257,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,258,0)=" Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",480,1,259,0)=" ---------------------"
^DIC(9.4,60,22,13,"PAH",480,1,260,0)=" Modify routines PSOCLUTL and PSOCLADD to KILL the ^XTMP globals"
^DIC(9.4,60,22,13,"PAH",480,1,261,0)=" associated with the patient's local override at the time an NCCC"
^DIC(9.4,60,22,13,"PAH",480,1,262,0)=" clozapine authorization number is registered to the patient. This"
^DIC(9.4,60,22,13,"PAH",480,1,263,0)=" prevents an obsolete local override from interfering with order entry"
^DIC(9.4,60,22,13,"PAH",480,1,264,0)=" routines' calculation of the days supply based on the patient's regular "
^DIC(9.4,60,22,13,"PAH",480,1,265,0)=" clozapine dispense frequency."
^DIC(9.4,60,22,13,"PAH",480,1,266,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,267,0)=" "
