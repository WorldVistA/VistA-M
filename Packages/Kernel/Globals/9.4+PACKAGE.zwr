^DIC(9.4,96,22,1.2,"PAH",28,1,87,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,88,0)="   If the site manually changed other ICD-9's that are now inactive,"
^DIC(9.4,96,22,1.2,"PAH",28,1,89,0)="   the patch will replace them as follows:"
^DIC(9.4,96,22,1.2,"PAH",28,1,90,0)="   "
^DIC(9.4,96,22,1.2,"PAH",28,1,91,0)="     478.1 with 478.19"
^DIC(9.4,96,22,1.2,"PAH",28,1,92,0)="     521.8 with 521.81"
^DIC(9.4,96,22,1.2,"PAH",28,1,93,0)="     523.0 with 523.00"
^DIC(9.4,96,22,1.2,"PAH",28,1,94,0)="     523.1 with 523.10"
^DIC(9.4,96,22,1.2,"PAH",28,1,95,0)="     523.3 with 523.30"
^DIC(9.4,96,22,1.2,"PAH",28,1,96,0)="     523.4 with 523.40"
^DIC(9.4,96,22,1.2,"PAH",28,1,97,0)="   "
^DIC(9.4,96,22,1.2,"PAH",28,1,98,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,99,0)=" SYSTEM ACCESS DURING INSTALLATION"
^DIC(9.4,96,22,1.2,"PAH",28,1,100,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",28,1,101,0)=" Installation of this patch does not require users to be off of the "
^DIC(9.4,96,22,1.2,"PAH",28,1,102,0)=" system.  However, all Dental users should not use the DRM GUI option "
^DIC(9.4,96,22,1.2,"PAH",28,1,103,0)=" while the patch is being installed.  All Dental users MUST close any "
^DIC(9.4,96,22,1.2,"PAH",28,1,104,0)=" open DRM GUI application prior to the patch being installed.  Once the "
^DIC(9.4,96,22,1.2,"PAH",28,1,105,0)=" patch has completed the users can use the DRM application."
^DIC(9.4,96,22,1.2,"PAH",28,1,106,0)="  "
^DIC(9.4,96,22,1.2,"PAH",28,1,107,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,108,0)=" POST-INSTALLATION PROCESS"
^DIC(9.4,96,22,1.2,"PAH",28,1,109,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",28,1,110,0)=" The post-install routine will remove inactivated ICD-9's and add new"
^DIC(9.4,96,22,1.2,"PAH",28,1,111,0)=" ICD-9 codes to the DENTAL CPT CODE MAPPING (#228) table.  If the site "
^DIC(9.4,96,22,1.2,"PAH",28,1,112,0)=" manually changed other ICD-9's that are now inactive and the patch made"
^DIC(9.4,96,22,1.2,"PAH",28,1,113,0)=" changes to those codes, then a mailman message will be sent to the users"
^DIC(9.4,96,22,1.2,"PAH",28,1,114,0)=" in the DENTV ADA CODE MAPPING mail group to verify those changes.   "
^DIC(9.4,96,22,1.2,"PAH",28,1,115,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,116,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,117,0)=" REQUIRED BUILDS:  LEX*2.0*45"
^DIC(9.4,96,22,1.2,"PAH",28,1,118,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,119,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,120,0)=" TEST SITES                                ALPHA/BETA"
^DIC(9.4,96,22,1.2,"PAH",28,1,121,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",28,1,122,0)=" Bay Pines                                 ALPHA"
^DIC(9.4,96,22,1.2,"PAH",28,1,123,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,124,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,125,0)=" ROUTINE SUMMARY"
^DIC(9.4,96,22,1.2,"PAH",28,1,126,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",28,1,127,0)=" Second line of routines will look like:"
^DIC(9.4,96,22,1.2,"PAH",28,1,128,0)=" ;;1.2;DENTAL;<patch list>;AUG 10, 2001"
^DIC(9.4,96,22,1.2,"PAH",28,1,129,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,130,0)="   Routine   Before Patch  After Patch  Patch List"
^DIC(9.4,96,22,1.2,"PAH",28,1,131,0)="   --------  ------------  -----------  ------------------------"
^DIC(9.4,96,22,1.2,"PAH",28,1,132,0)="   DENTV049      n/a         30259209    49"
^DIC(9.4,96,22,1.2,"PAH",28,1,133,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,134,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,135,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",28,1,136,0)=" INSTALLATION INSTRUCTIONS FOR DENT*1.2*49"
^DIC(9.4,96,22,1.2,"PAH",28,1,137,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",28,1,138,0)=" This patch can be installed while users are on the system."
^DIC(9.4,96,22,1.2,"PAH",28,1,139,0)=" The installation time should take less than 5 minutes."
^DIC(9.4,96,22,1.2,"PAH",28,1,140,0)="   "
^DIC(9.4,96,22,1.2,"PAH",28,1,141,0)=" 1. Load the KIDS Distribution from the Packman Message using the "
^DIC(9.4,96,22,1.2,"PAH",28,1,142,0)="    Packman function ""Install/Check Message.""  (Note: test sites will"
^DIC(9.4,96,22,1.2,"PAH",28,1,143,0)="    receive the kids build in a .zip file with the patch description.)"
^DIC(9.4,96,22,1.2,"PAH",28,1,144,0)="    "
^DIC(9.4,96,22,1.2,"PAH",28,1,145,0)=" 2. Use the Install Package(s) option and select package DENT*1.2*49"
^DIC(9.4,96,22,1.2,"PAH",28,1,146,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,147,0)=" 3. For the install prompts, enter either Yes or No depending upon the"
^DIC(9.4,96,22,1.2,"PAH",28,1,148,0)="    normal practice at your facility.  "
^DIC(9.4,96,22,1.2,"PAH",28,1,149,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,150,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,96,22,1.2,"PAH",28,1,151,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,96,22,1.2,"PAH",28,1,152,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,153,0)=" ========================================================================"
^DIC(9.4,96,22,1.2,"PAH",28,1,154,0)="                        POST-INSTALLATION PROCESS"
^DIC(9.4,96,22,1.2,"PAH",28,1,155,0)=" ========================================================================"
^DIC(9.4,96,22,1.2,"PAH",28,1,156,0)=" Forward any Mailman messages generated during the post-installation."
^DIC(9.4,96,22,1.2,"PAH",28,1,157,0)=" The post-install *may* generate a Mailman message if changes were made"
^DIC(9.4,96,22,1.2,"PAH",28,1,158,0)=" to the ADA Master table that were not part of the Dental Coding "
^DIC(9.4,96,22,1.2,"PAH",28,1,159,0)=" Group's recommended changes.  These would include removing inactive"
^DIC(9.4,96,22,1.2,"PAH",28,1,160,0)=" ICD-9 codes that were added by the site and not known to the group."
^DIC(9.4,96,22,1.2,"PAH",28,1,161,0)=" The Mailman message will be sent to the user loading the patch and "
^DIC(9.4,96,22,1.2,"PAH",28,1,162,0)=" must be forwarded to a Dental Administrator for evaluation."
^DIC(9.4,96,22,1.2,"PAH",29,0)="51 SEQ #48^3070108.160416^1"
^DIC(9.4,96,22,1.2,"PAH",29,1,0)="^^55^55^3070108"
^DIC(9.4,96,22,1.2,"PAH",29,1,1,0)=" General Information"
^DIC(9.4,96,22,1.2,"PAH",29,1,2,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",29,1,3,0)=" The purpose of this patch is to resend dental HL7 transactions for"
^DIC(9.4,96,22,1.2,"PAH",29,1,4,0)=" encounter and fee basis that were dropped by the VIE.  This data is"
^DIC(9.4,96,22,1.2,"PAH",29,1,5,0)=" required for national reporting of dental workload."
^DIC(9.4,96,22,1.2,"PAH",29,1,6,0)="   "
^DIC(9.4,96,22,1.2,"PAH",29,1,7,0)=" The patch installation process should take be less than 1 minute."
^DIC(9.4,96,22,1.2,"PAH",29,1,8,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,9,0)="  "
^DIC(9.4,96,22,1.2,"PAH",29,1,10,0)=" SYSTEM ACCESS DURING INSTALLATION"
^DIC(9.4,96,22,1.2,"PAH",29,1,11,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",29,1,12,0)=" Installation of this patch does not require users to be off of the "
^DIC(9.4,96,22,1.2,"PAH",29,1,13,0)=" system.  "
^DIC(9.4,96,22,1.2,"PAH",29,1,14,0)="  "
^DIC(9.4,96,22,1.2,"PAH",29,1,15,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,16,0)=" POST-INSTALLATION PROCESS"
^DIC(9.4,96,22,1.2,"PAH",29,1,17,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",29,1,18,0)=" The post installation will queue a job to reset affected transactions"
^DIC(9.4,96,22,1.2,"PAH",29,1,19,0)=" back to a 'pending' HL7 transmission status.  These transactions are in"
^DIC(9.4,96,22,1.2,"PAH",29,1,20,0)=" file 228.2 for encounter and file 228.5 for fee."
^DIC(9.4,96,22,1.2,"PAH",29,1,21,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,22,0)=" REQUIRED BUILDS:  none"
^DIC(9.4,96,22,1.2,"PAH",29,1,23,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,24,0)=" TEST SITES                                ALPHA/BETA"
^DIC(9.4,96,22,1.2,"PAH",29,1,25,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",29,1,26,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,27,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,28,0)=" "
^DIC(9.4,96,22,1.2,"PAH",29,1,29,0)=" ROUTINE SUMMARY"
^DIC(9.4,96,22,1.2,"PAH",29,1,30,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",29,1,31,0)=" Second line of routines will look like:"
^DIC(9.4,96,22,1.2,"PAH",29,1,32,0)=" ;;1.2;DENTAL;<patch list>;AUG 10, 2001"
^DIC(9.4,96,22,1.2,"PAH",29,1,33,0)=" "
