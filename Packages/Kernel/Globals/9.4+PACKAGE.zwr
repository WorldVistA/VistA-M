^DIC(9.4,11,22,5.03,"PAH",36,1,725,0)="               Feb 04, 2005@10:21:55"
^DIC(9.4,11,22,5.03,"PAH",36,1,726,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,727,0)=" Install Message sent #xxxx"
^DIC(9.4,11,22,5.03,"PAH",37,0)="74^3120924.154623^17"
^DIC(9.4,11,22,5.03,"PAH",37,1,0)="^^1^1^3120924"
^DIC(9.4,11,22,5.03,"PAH",37,1,1,0)="Refer to National Patch Module."
^DIC(9.4,11,22,5.03,"PAH",38,0)="80^3130930.101808^17"
^DIC(9.4,11,22,5.03,"PAH",39,0)="81 SEQ #60^3140109.155512^17"
^DIC(9.4,11,22,5.03,"PAH",39,1,0)="^^2^2^3140109"
^DIC(9.4,11,22,5.03,"PAH",39,1,1,0)="1. Erroneous nodes created in File 68 for MICRO with VITEK result "
^DIC(9.4,11,22,5.03,"PAH",39,1,2,0)="   interface."
^DIC(9.4,11,22,5.03,"PAH",40,0)="83 SEQ #61^3140618.123323^17"
^DIC(9.4,11,22,5.03,"PAH",40,1,0)="^^7^7^3140618"
^DIC(9.4,11,22,5.03,"PAH",40,1,1,0)="1) TICKET 965986 LRMIEDZ Subscript Error"
^DIC(9.4,11,22,5.03,"PAH",40,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",40,1,3,0)="The patch modifies code in VITEK LITERAL routine LAMIVTL4 that uses "
^DIC(9.4,11,22,5.03,"PAH",40,1,4,0)="improper subscripting in a $O to set a variable.  As a consequence, the "
^DIC(9.4,11,22,5.03,"PAH",40,1,5,0)="variable is set to null.  This null value later causes a Subscript Errror "
^DIC(9.4,11,22,5.03,"PAH",40,1,6,0)="when LAMIVTL4 calls UNDO^LRMIEDZ and an attempt is made to access the "
^DIC(9.4,11,22,5.03,"PAH",40,1,7,0)="ACCESSION FILE (#68) using it."
^DIC(9.4,11,22,5.03,"PAH",41,0)="84 SEQ #62^3150331.141439^17"
^DIC(9.4,11,22,5.03,"PAH",41,1,0)="^^3^3^3150331"
^DIC(9.4,11,22,5.03,"PAH",41,1,1,0)="The patch modifies code in two (2) routines to correct HL7 escape "
^DIC(9.4,11,22,5.03,"PAH",41,1,2,0)="characters in OBX result segments and properly handle pipe ""|"" characters "
^DIC(9.4,11,22,5.03,"PAH",41,1,3,0)="in remarks from lab instruments. "
^DIC(9.4,11,22,5.03,"PAH",42,0)="85 SEQ #63^3150610.121429^17"
^DIC(9.4,11,22,5.03,"PAH",42,1,0)="^^149^149^3150610"
^DIC(9.4,11,22,5.03,"PAH",42,1,1,0)="This patch addresses three (3) issues of Laboratory Electronic Data "
^DIC(9.4,11,22,5.03,"PAH",42,1,2,0)="Interchange (LEDI) HL7 interfaces:"
^DIC(9.4,11,22,5.03,"PAH",42,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,4,0)="1.  An application error occurs when processing results if a Systematized"
^DIC(9.4,11,22,5.03,"PAH",42,1,5,0)="    Nomenclature of Medicine (SNOMED) code is not defined on the"
^DIC(9.4,11,22,5.03,"PAH",42,1,6,0)="    collecting site for the specimen."
^DIC(9.4,11,22,5.03,"PAH",42,1,7,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,8,0)="2.  Override SNOMED codes are not referenced when processing incoming "
^DIC(9.4,11,22,5.03,"PAH",42,1,9,0)="    orders."
^DIC(9.4,11,22,5.03,"PAH",42,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,11,0)="3.  Override SNOMED codes are not sent with results."
^DIC(9.4,11,22,5.03,"PAH",42,1,12,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,13,0)="Associated NSR(s):"
^DIC(9.4,11,22,5.03,"PAH",42,1,14,0)="=================="
^DIC(9.4,11,22,5.03,"PAH",42,1,15,0)="N/A"
^DIC(9.4,11,22,5.03,"PAH",42,1,16,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,17,0)="Associated Remedy ticket(s):"
^DIC(9.4,11,22,5.03,"PAH",42,1,18,0)="=========================="
^DIC(9.4,11,22,5.03,"PAH",42,1,19,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,20,0)="1. INC000000900556 - Result transaction SNOMED code application errors"
^DIC(9.4,11,22,5.03,"PAH",42,1,21,0)="2. INC000000917708 - Override SNOMED code issue on incoming orders"
^DIC(9.4,11,22,5.03,"PAH",42,1,22,0)="3. INC000001080712 - Override SNOMED code issue on outgoing results"
^DIC(9.4,11,22,5.03,"PAH",42,1,23,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,24,0)="Blood Bank Review:"
^DIC(9.4,11,22,5.03,"PAH",42,1,25,0)="=================="
^DIC(9.4,11,22,5.03,"PAH",42,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,27,0)="Participating Test Sites:"
^DIC(9.4,11,22,5.03,"PAH",42,1,28,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",42,1,29,0)="TBD"
^DIC(9.4,11,22,5.03,"PAH",42,1,30,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,32,0)="Remedy Overview:"
^DIC(9.4,11,22,5.03,"PAH",42,1,33,0)="================"
^DIC(9.4,11,22,5.03,"PAH",42,1,34,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,35,0)="1. INC000000900556 - Result transaction SNOMED code application errors"
^DIC(9.4,11,22,5.03,"PAH",42,1,36,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,37,0)="Problem:"
^DIC(9.4,11,22,5.03,"PAH",42,1,38,0)="--------"
^DIC(9.4,11,22,5.03,"PAH",42,1,39,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,40,0)="An application error is generated by a collecting site during processing "
^DIC(9.4,11,22,5.03,"PAH",42,1,41,0)="of incoming result transactions if the collecting site does not have a "
^DIC(9.4,11,22,5.03,"PAH",42,1,42,0)="SNOMED code on file for the topography and the host site sends a SNOMED "
^DIC(9.4,11,22,5.03,"PAH",42,1,43,0)="code.  Because of the application error, the HL7 table 0070 is not being"
^DIC(9.4,11,22,5.03,"PAH",42,1,44,0)="checked to determine if the topography sent by the host site is valid."
^DIC(9.4,11,22,5.03,"PAH",42,1,45,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,46,0)="Resolution:"
^DIC(9.4,11,22,5.03,"PAH",42,1,47,0)="-----------"
^DIC(9.4,11,22,5.03,"PAH",42,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,49,0)="Routine LA7VIN4 is modified to not generate an application error if the "
^DIC(9.4,11,22,5.03,"PAH",42,1,50,0)="collecting site has no SNOMED code on file but the host site is sending "
^DIC(9.4,11,22,5.03,"PAH",42,1,51,0)="one.  Specimen validation then proceeds to the HL70070 table."
^DIC(9.4,11,22,5.03,"PAH",42,1,52,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,53,0)="Routine: LA7VIN4"
^DIC(9.4,11,22,5.03,"PAH",42,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,55,0)="2. INC000000917708 - Override SNOMED code issue on incoming orders"
^DIC(9.4,11,22,5.03,"PAH",42,1,56,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,57,0)="Problem:"
^DIC(9.4,11,22,5.03,"PAH",42,1,58,0)="--------"
^DIC(9.4,11,22,5.03,"PAH",42,1,59,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,60,0)="A collecting site may be a non-VA facility which does not have the same "
^DIC(9.4,11,22,5.03,"PAH",42,1,61,0)="SNOMED codes on file as a VA facility.  This presents a problem when a "
^DIC(9.4,11,22,5.03,"PAH",42,1,62,0)="VA facility (the host site) receives orders from the non-VA facility (the "
^DIC(9.4,11,22,5.03,"PAH",42,1,63,0)="collecting site).  An application error is generated at the host site "
^DIC(9.4,11,22,5.03,"PAH",42,1,64,0)="because of the discrepancy."
^DIC(9.4,11,22,5.03,"PAH",42,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,66,0)="LEDI software had developed an option (LA7S MAP NON-VA SNOMED CODES) to "
^DIC(9.4,11,22,5.03,"PAH",42,1,67,0)="allow for this situation.  The intent was that a specimen type / "
^DIC(9.4,11,22,5.03,"PAH",42,1,68,0)="collection sample could have an ""override"" SNOMED code defined on the "
^DIC(9.4,11,22,5.03,"PAH",42,1,69,0)="host site system. "
^DIC(9.4,11,22,5.03,"PAH",42,1,70,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,71,0)="However, the code on the host site which deformats the HL7 order "
^DIC(9.4,11,22,5.03,"PAH",42,1,72,0)="transactions does not reference the file set by the option LA7S MAP "
^DIC(9.4,11,22,5.03,"PAH",42,1,73,0)="NON-VA SNOMED CODES.  Therefore, an application error is generated that "
^DIC(9.4,11,22,5.03,"PAH",42,1,74,0)="the order cannot be filed due to the SNOMED code discrepancy."
^DIC(9.4,11,22,5.03,"PAH",42,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,76,0)="Resolution:"
^DIC(9.4,11,22,5.03,"PAH",42,1,77,0)="-----------"
^DIC(9.4,11,22,5.03,"PAH",42,1,78,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,79,0)="Routine LA7SMU2 is modified to check the LA7S MAP NON-VA SNOMED CODES "
^DIC(9.4,11,22,5.03,"PAH",42,1,80,0)="configuration on the host site for override SNOMED codes when processing"
^DIC(9.4,11,22,5.03,"PAH",42,1,81,0)="orders from a collecting site."
^DIC(9.4,11,22,5.03,"PAH",42,1,82,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,83,0)="Routine: LA7SMU2"
^DIC(9.4,11,22,5.03,"PAH",42,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,85,0)="3. INC000001080712 - Override SNOMED code issue on outgoing results"
^DIC(9.4,11,22,5.03,"PAH",42,1,86,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,87,0)="Problem:"
^DIC(9.4,11,22,5.03,"PAH",42,1,88,0)="--------"
^DIC(9.4,11,22,5.03,"PAH",42,1,89,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,90,0)="LEDI code was corrected under ticket INC000000917708 so that the host"
^DIC(9.4,11,22,5.03,"PAH",42,1,91,0)="facility will reference override SNOMED code and file the order."
^DIC(9.4,11,22,5.03,"PAH",42,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,93,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,94,0)="However, when the order is resulted, an application error will occur on "
^DIC(9.4,11,22,5.03,"PAH",42,1,95,0)="the collecting site because the host is not sending back the collecting "
^DIC(9.4,11,22,5.03,"PAH",42,1,96,0)="site's override SNOMED code."
^DIC(9.4,11,22,5.03,"PAH",42,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,98,0)="Resolution:"
^DIC(9.4,11,22,5.03,"PAH",42,1,99,0)="----------- "
^DIC(9.4,11,22,5.03,"PAH",42,1,100,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,101,0)="Routine LA7VOBRB is modified to send back the collecting site's override "
^DIC(9.4,11,22,5.03,"PAH",42,1,102,0)="SNOMED code in the result transaction."
^DIC(9.4,11,22,5.03,"PAH",42,1,103,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,104,0)="Routine: LA7VOBRB"
^DIC(9.4,11,22,5.03,"PAH",42,1,105,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,106,0)="Components:"
^DIC(9.4,11,22,5.03,"PAH",42,1,107,0)="==========="
^DIC(9.4,11,22,5.03,"PAH",42,1,108,0)="N/A"
^DIC(9.4,11,22,5.03,"PAH",42,1,109,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,110,0)="   ==================== Installation Instructions ===================="
^DIC(9.4,11,22,5.03,"PAH",42,1,111,0)="  This patch may be loaded with users on the system.  You may wish to "
^DIC(9.4,11,22,5.03,"PAH",42,1,112,0)="  install it during non-peak hours. Installation will take less than 1 "
^DIC(9.4,11,22,5.03,"PAH",42,1,113,0)="  minute. "
^DIC(9.4,11,22,5.03,"PAH",42,1,114,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,115,0)="  NOTE: Kernel patches must be current on the target system to avoid "
^DIC(9.4,11,22,5.03,"PAH",42,1,116,0)="        problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",42,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,118,0)="   1. Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu. This"
^DIC(9.4,11,22,5.03,"PAH",42,1,119,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",42,1,120,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,121,0)="   2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",42,1,122,0)="      system. You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",42,1,123,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,124,0)="   3. On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",42,1,125,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",42,1,126,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,127,0)="   4. Use the 'Verify Checksum in Transport Global' option and verify"
^DIC(9.4,11,22,5.03,"PAH",42,1,128,0)="      that all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",42,1,129,0)="    "
^DIC(9.4,11,22,5.03,"PAH",42,1,130,0)="   5. On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",42,1,131,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",42,1,132,0)="              Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",42,1,133,0)="              Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",42,1,134,0)="              Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",42,1,135,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,136,0)="      If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,11,22,5.03,"PAH",42,1,137,0)="      patch prior to installation, you should use the 'Backup a Transport"
^DIC(9.4,11,22,5.03,"PAH",42,1,138,0)="      Global' option at this time. You may also compare the routines in"
^DIC(9.4,11,22,5.03,"PAH",42,1,139,0)="      your production account to the routines in the patch by using the"
^DIC(9.4,11,22,5.03,"PAH",42,1,140,0)="      'Compare a Transport Global to Current System' option."
^DIC(9.4,11,22,5.03,"PAH",42,1,141,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,142,0)="   6. Use the 'Install Package(s)' option under the 'Installation' menu "
^DIC(9.4,11,22,5.03,"PAH",42,1,143,0)="      and select the package 'LA*5.2*85."
^DIC(9.4,11,22,5.03,"PAH",42,1,144,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,145,0)="      If prompted 'Want KIDS to INHIBIT LOGONs during the install? NO//, "
^DIC(9.4,11,22,5.03,"PAH",42,1,146,0)="      choose 'NO'. "
^DIC(9.4,11,22,5.03,"PAH",42,1,147,0)=" "
^DIC(9.4,11,22,5.03,"PAH",42,1,148,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,11,22,5.03,"PAH",42,1,149,0)="      Protocols? NO//', choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",43,0)="86 SEQ #64^3150616.122155^17"
^DIC(9.4,11,22,5.03,"PAH",43,1,0)="^^10^10^3150616"
^DIC(9.4,11,22,5.03,"PAH",43,1,1,0)=" "
^DIC(9.4,11,22,5.03,"PAH",43,1,2,0)="This patch addresses two (2) Laboratory Electronic Data Interchange (LEDI)"
^DIC(9.4,11,22,5.03,"PAH",43,1,3,0)="issues:"
^DIC(9.4,11,22,5.03,"PAH",43,1,4,0)=" "
^DIC(9.4,11,22,5.03,"PAH",43,1,5,0)="1. A test already built to a shipping manifest can be built to another"
^DIC(9.4,11,22,5.03,"PAH",43,1,6,0)="   shipping manifest for a different date.  A test should be built to"
^DIC(9.4,11,22,5.03,"PAH",43,1,7,0)="   only one shipping manifest."
^DIC(9.4,11,22,5.03,"PAH",43,1,8,0)=" "
^DIC(9.4,11,22,5.03,"PAH",43,1,9,0)="2. A null subscript software error may occur which is caused by several"
^DIC(9.4,11,22,5.03,"PAH",43,1,10,0)="   interface situations which occur simultaneously."
^DIC(9.4,11,22,5.03,"PAH",44,0)="91 SEQ #65^3160616.161357^54"
^DIC(9.4,11,22,5.03,"PAH",45,0)="88^3160803.141816^54"
^DIC(9.4,11,22,5.03,"PAH",45,1,0)="^^209^209^3160803"
^DIC(9.4,11,22,5.03,"PAH",45,1,1,0)="Associated Patches:  (v)LA*5.2*80 <<= must be installed BEFORE `LA*5.2*88'"
^DIC(9.4,11,22,5.03,"PAH",45,1,2,0)="                     (v)LA*5.2*84 <<= must be installed BEFORE `LA*5.2*88'"
^DIC(9.4,11,22,5.03,"PAH",45,1,3,0)="                     (v)LA*5.2*85 <<= must be installed BEFORE `LA*5.2*88'"
^DIC(9.4,11,22,5.03,"PAH",45,1,4,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,5,0)="Subject:  AUTOVERIFICATION"
^DIC(9.4,11,22,5.03,"PAH",45,1,6,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,7,0)="Category:  ROUTINE"
^DIC(9.4,11,22,5.03,"PAH",45,1,8,0)="           ENHANCEMENT"
^DIC(9.4,11,22,5.03,"PAH",45,1,9,0)="           DATA DICTIONARY"
^DIC(9.4,11,22,5.03,"PAH",45,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,11,0)="Description:"
^DIC(9.4,11,22,5.03,"PAH",45,1,12,0)="==========="
^DIC(9.4,11,22,5.03,"PAH",45,1,13,0)="The build for this patch is distributed as part of a multi-package build "
^DIC(9.4,11,22,5.03,"PAH",45,1,14,0)="that contains LR*5.2*458 and LA*5.2*88.  This contains functionality to "
^DIC(9.4,11,22,5.03,"PAH",45,1,15,0)="enable Auto Verification and Auto Release of lab normal lab results and "
^DIC(9.4,11,22,5.03,"PAH",45,1,16,0)="was initially developed at the Kansas City VAMC.  This new process "
^DIC(9.4,11,22,5.03,"PAH",45,1,17,0)="involves automatic review and release of test results based on a "
^DIC(9.4,11,22,5.03,"PAH",45,1,18,0)="lab-established set of boundaries, also referred as rules, rule sets, and "
^DIC(9.4,11,22,5.03,"PAH",45,1,19,0)="algorithms.  Lab results that are in a ""normal"" range, as pre-determined "
^DIC(9.4,11,22,5.03,"PAH",45,1,20,0)="by the laboratory, will transmit directly from the middleware to VistA "
^DIC(9.4,11,22,5.03,"PAH",45,1,21,0)="lab files and on to Computerized Patient Record System (CPRS) without the "
^DIC(9.4,11,22,5.03,"PAH",45,1,22,0)="intermediate step of requiring a lab technologist to manually review and "
^DIC(9.4,11,22,5.03,"PAH",45,1,23,0)="sign off on these normal lab results.  This process will eliminate the "
^DIC(9.4,11,22,5.03,"PAH",45,1,24,0)="need for a qualified technologist to manually approve all ""normal"" "
^DIC(9.4,11,22,5.03,"PAH",45,1,25,0)="results before those results are filed in VistA Lab files and available "
^DIC(9.4,11,22,5.03,"PAH",45,1,26,0)="for clinicians to view in CPRS. "
^DIC(9.4,11,22,5.03,"PAH",45,1,27,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,28,0)="Each VAMC site will determine which instruments will use this "
^DIC(9.4,11,22,5.03,"PAH",45,1,29,0)="functionality as it can set up on an instrument by instrument basis.  "
^DIC(9.4,11,22,5.03,"PAH",45,1,30,0)="Essentially VistA Lab instruments are set up as either being available "
^DIC(9.4,11,22,5.03,"PAH",45,1,31,0)="for auto verification or not available for auto verification.  If an "
^DIC(9.4,11,22,5.03,"PAH",45,1,32,0)="instrument is set up for auto verification, then a lab result passing the "
^DIC(9.4,11,22,5.03,"PAH",45,1,33,0)="rule set will be filed by the middleware in VistA lab files and available "
^DIC(9.4,11,22,5.03,"PAH",45,1,34,0)="in CPRS and a lab result that cannot pass the rule set will be held in "
^DIC(9.4,11,22,5.03,"PAH",45,1,35,0)="the middleware system for review by a lab technologist. "
^DIC(9.4,11,22,5.03,"PAH",45,1,36,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,37,0)="In support of this auto verification and auto release functionality, this "
^DIC(9.4,11,22,5.03,"PAH",45,1,38,0)="patch will add two new application proxy users.  LRLAB AUTO RELEASE is "
^DIC(9.4,11,22,5.03,"PAH",45,1,39,0)="used to indicate that the results in VistA Lab were released by an "
^DIC(9.4,11,22,5.03,"PAH",45,1,40,0)="automated Lab process without human interventions.  LRLAB, AUTO VERIFY is "
^DIC(9.4,11,22,5.03,"PAH",45,1,41,0)="used to indicate that the results were ""approved"" by an automated process "
^DIC(9.4,11,22,5.03,"PAH",45,1,42,0)="using a rules based system."
^DIC(9.4,11,22,5.03,"PAH",45,1,43,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,44,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,45,0)="Patch Components"
^DIC(9.4,11,22,5.03,"PAH",45,1,46,0)="================"
^DIC(9.4,11,22,5.03,"PAH",45,1,47,0)=" "
