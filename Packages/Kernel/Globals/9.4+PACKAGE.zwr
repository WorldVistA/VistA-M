^DIC(9.4,153,0)="NATIONAL LABORATORY TEST^NLT^National Laboratory Test file of terms."
^DIC(9.4,153,1,0)="^^5^5^2950908^^"
^DIC(9.4,153,1,1,0)=" This package is used to update NLT files consisting of nationally"
^DIC(9.4,153,1,2,0)="standardized terms and procedure names. Any new procedure of term"
^DIC(9.4,153,1,3,0)="created by the site must use terms already defined by the NLT package."
^DIC(9.4,153,1,4,0)=" Responsibility of the contents of these files has been granted to"
^DIC(9.4,153,1,5,0)="Pathology & Laboratory Medicine Service."
^DIC(9.4,153,4,0)="^9.44PA^5^5"
