^DIC(9.4,59,22,5,"PAH",543,1,77,0)="-----------------------"
^DIC(9.4,59,22,5,"PAH",543,1,78,0)="New Service Requests (NSRs):"
^DIC(9.4,59,22,5,"PAH",543,1,79,0)="N/A"
^DIC(9.4,59,22,5,"PAH",543,1,80,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,81,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,59,22,5,"PAH",543,1,82,0)="-----------------------------"
^DIC(9.4,59,22,5,"PAH",543,1,83,0)="N/A"
^DIC(9.4,59,22,5,"PAH",543,1,84,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,85,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,86,0)="Problem:"
^DIC(9.4,59,22,5,"PAH",543,1,87,0)="--------"
^DIC(9.4,59,22,5,"PAH",543,1,88,0)="With the implementation of Red Hat Enterprise Linux (RHEL 8) stronger "
^DIC(9.4,59,22,5,"PAH",543,1,89,0)="encryption key ECDSA is now available and supported. PPS-N "
^DIC(9.4,59,22,5,"PAH",543,1,90,0)="application at this time is using RSA type SSH key for connecting to the "
^DIC(9.4,59,22,5,"PAH",543,1,91,0)="PPS-N server to receive the dat file that is used for updating Nation "
^DIC(9.4,59,22,5,"PAH",543,1,92,0)="Drug files."
^DIC(9.4,59,22,5,"PAH",543,1,93,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,94,0)="New keys added:"
^DIC(9.4,59,22,5,"PAH",543,1,95,0)="Elliptic Curve Digital Signature Algorithm (ECDSA)"
^DIC(9.4,59,22,5,"PAH",543,1,96,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,97,0)="ECDSA keys can created for encryption length of 256, 384 or 521 bits."
^DIC(9.4,59,22,5,"PAH",543,1,98,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,99,0)="Necessary changes are required to allow creation of ECDSA key "
^DIC(9.4,59,22,5,"PAH",543,1,100,0)="for the PPS-N application. Support for RSA keys are anticipated to be "
^DIC(9.4,59,22,5,"PAH",543,1,101,0)="deprecated in the future, so to maintain Vista's security posture and "
^DIC(9.4,59,22,5,"PAH",543,1,102,0)="ensure continuous operation of required Vista processes, software "
^DIC(9.4,59,22,5,"PAH",543,1,103,0)="utilizing SSH PKI user keys must be updated to support the stronger ECDSA "
^DIC(9.4,59,22,5,"PAH",543,1,104,0)="encryption key. "
^DIC(9.4,59,22,5,"PAH",543,1,105,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,106,0)="The modification should allow the creation of any ECDSA keys to be forward"
^DIC(9.4,59,22,5,"PAH",543,1,107,0)="compatible when Red Hat Enterprise Linux (RHEL 8) is implemented."
^DIC(9.4,59,22,5,"PAH",543,1,108,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,109,0)="Resolution:"
^DIC(9.4,59,22,5,"PAH",543,1,110,0)="-----------"
^DIC(9.4,59,22,5,"PAH",543,1,111,0)="File PPS-N UPDATE CONTROL (#57.23) field SFTP SSH KEY ENCRYPTION (#41) is "
^DIC(9.4,59,22,5,"PAH",543,1,112,0)="modified to add code ECDSA (Elliptic Curve Digital Signature Algorithm)."
^DIC(9.4,59,22,5,"PAH",543,1,113,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,114,0)="Modify PSNOSKEY to allow the ECDSA key to be created, viewed, "
^DIC(9.4,59,22,5,"PAH",543,1,115,0)="deleted, and update the help text."
^DIC(9.4,59,22,5,"PAH",543,1,116,0)=" "
^DIC(9.4,59,22,5,"PAH",543,1,117,0)="Routine PSNPARM is modified to use new field ECDSA (#11) in the "
^DIC(9.4,59,22,5,"PAH",543,1,118,0)="PPS-N UPDATE CONTROL FILE (#57.23) in option PPS-N Site Parameters "
^DIC(9.4,59,22,5,"PAH",543,1,119,0)="(Enter/Edit) to set if ECDSA keys are allowed to be created."
^DIC(9.4,59,22,5,"PAH",544,0)="576 SEQ #558^3250903.083501^90"
^DIC(9.4,59,22,5,"PAH",544,1,0)="^^7^7^3250903"
^DIC(9.4,59,22,5,"PAH",544,1,1,0)="This patch, along with other patches, adds Pharmacogenomic (PGx) order"
^DIC(9.4,59,22,5,"PAH",544,1,2,0)="checking to medication orders entered through Inpatient Medications,"
^DIC(9.4,59,22,5,"PAH",544,1,3,0)="Outpatient Pharmacy and Computerized Patient Record System (CPRS). A "
^DIC(9.4,59,22,5,"PAH",544,1,4,0)="patient's genomic test results will be retrieved from the Health Data"
^DIC(9.4,59,22,5,"PAH",544,1,5,0)="Repository (HDR), and along with the prospective drug(s) of a medication"
^DIC(9.4,59,22,5,"PAH",544,1,6,0)="order is sent to the vendor to retrieve interactions between the patient's"
^DIC(9.4,59,22,5,"PAH",544,1,7,0)="genes and the prospective drug(s)."
^DIC(9.4,59,22,5,"PAH",545,0)="578 SEQ #560^3260508.085455^90"
^DIC(9.4,59,22,5,"PAH",545,1,0)="^^2^2^3260508"
^DIC(9.4,59,22,5,"PAH",545,1,1,0)="Please review FORUM's Patch Module description and installation "
^DIC(9.4,59,22,5,"PAH",545,1,2,0)="instructions before installing this patch."
