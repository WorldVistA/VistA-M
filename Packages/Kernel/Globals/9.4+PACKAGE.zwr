^DIC(9.4,3,22,21,"PAH",86,1,33,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",86,1,34,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",86,1,35,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",86,1,36,0)="     "
^DIC(9.4,3,22,21,"PAH",86,1,37,0)="  4.  Inhibit users from login into the system. (Anybody using an option"
^DIC(9.4,3,22,21,"PAH",86,1,38,0)="      will get a CLOBER error when they return to the menus.)"
^DIC(9.4,3,22,21,"PAH",86,1,39,0)=""
^DIC(9.4,3,22,21,"PAH",86,1,40,0)="     "
^DIC(9.4,3,22,21,"PAH",86,1,41,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",86,1,42,0)="      option:"
^DIC(9.4,3,22,21,"PAH",86,1,43,0)="        Install Package(s)  'XU*8.0*103'"
^DIC(9.4,3,22,21,"PAH",86,1,44,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",86,1,45,0)="                             "
^DIC(9.4,3,22,21,"PAH",86,1,46,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",86,1,47,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",86,1,48,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",86,1,49,0)="     "
^DIC(9.4,3,22,21,"PAH",86,1,50,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",86,1,51,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",86,1,52,0)=""
^DIC(9.4,3,22,21,"PAH",87,0)="91 SEQ #92^2981229^1"
^DIC(9.4,3,22,21,"PAH",87,1,0)="^^73^73^2981229"
^DIC(9.4,3,22,21,"PAH",87,1,1,0)="ASH-1098-30259            The Option REMOVE A TYPE OF ERROR pointed to"
^DIC(9.4,3,22,21,"PAH",87,1,2,0)="BRX-0898-11548            the wrong routine.  Corrected."
^DIC(9.4,3,22,21,"PAH",87,1,3,0)="MAC-0698-62282"
^DIC(9.4,3,22,21,"PAH",87,1,4,0)="            "
^DIC(9.4,3,22,21,"PAH",87,1,5,0)="PUG-0498-52588  XQALFWD   The input to the Comment field didn't follow"
^DIC(9.4,3,22,21,"PAH",87,1,6,0)="                          VA guidelines and allow ? or ?? for help.  Fixed. "
^DIC(9.4,3,22,21,"PAH",87,1,7,0)="                          "
^DIC(9.4,3,22,21,"PAH",87,1,8,0)="BIL-0797-30082  XQALFWD   The code at MAIL1 wouldn't allow forwarding"
^DIC(9.4,3,22,21,"PAH",87,1,9,0)="                          of alert to a mail message."
^DIC(9.4,3,22,21,"PAH",87,1,10,0)="                          "
^DIC(9.4,3,22,21,"PAH",87,1,11,0)="E3R 11300       XUWORKDY  The E3R included the code for 2 new entry points"
^DIC(9.4,3,22,21,"PAH",87,1,12,0)="                          in XUWORKDY."
^DIC(9.4,3,22,21,"PAH",87,1,13,0)="                          "
^DIC(9.4,3,22,21,"PAH",87,1,14,0)="                          $$WORKDAY^XUWORKDY(date) returns 1 if the day is a"
^DIC(9.4,3,22,21,"PAH",87,1,15,0)="                          workday (Mon-Fri and not a Holiday) else 0,"
^DIC(9.4,3,22,21,"PAH",87,1,16,0)="                          "
^DIC(9.4,3,22,21,"PAH",87,1,17,0)="                          $$WORKPLUS(date,offset) given a date and a offset"
^DIC(9.4,3,22,21,"PAH",87,1,18,0)="                          in days +/-, returns the date that will give"
^DIC(9.4,3,22,21,"PAH",87,1,19,0)="                          that number of workdays."
^DIC(9.4,3,22,21,"PAH",87,1,20,0)="                        "
^DIC(9.4,3,22,21,"PAH",87,1,21,0)="ANN-0798-40365            The screen on file 3.5 is not compatible with FM"
^DIC(9.4,3,22,21,"PAH",87,1,22,0)="                          relational jumps to file 3.2 during prints."
^DIC(9.4,3,22,21,"PAH",87,1,23,0)="                          Changed to work in this environment."
^DIC(9.4,3,22,21,"PAH",87,1,24,0)="                          "
^DIC(9.4,3,22,21,"PAH",87,1,25,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",87,1,26,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",87,1,27,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",87,1,28,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",87,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",87,1,30,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",87,1,31,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",87,1,32,0)="XQALFWD      10058961  10528433    **6,65,91**"
^DIC(9.4,3,22,21,"PAH",87,1,33,0)="XUINPCH       5067911   5067911    **20,36,49,63,65,69,96,91**"
^DIC(9.4,3,22,21,"PAH",87,1,34,0)="XUWORKDY       908391   1501394    **65,71,77,91**"
^DIC(9.4,3,22,21,"PAH",87,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",87,1,36,0)="List of preceding patches: 6, 20, 36, 49, 63, 65, 69, 71, 77, 96"
^DIC(9.4,3,22,21,"PAH",87,1,37,0)="Sites should use CHECK^XTSUMBLD to verify checksums"
^DIC(9.4,3,22,21,"PAH",87,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",87,1,39,0)="============================================================================"
^DIC(9.4,3,22,21,"PAH",87,1,40,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",87,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",87,1,42,0)="  1.  DSM sites - One of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",87,1,43,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",87,1,44,0)="     "
^DIC(9.4,3,22,21,"PAH",87,1,45,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",87,1,46,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",87,1,47,0)="     "
^DIC(9.4,3,22,21,"PAH",87,1,48,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",87,1,49,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",87,1,50,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",87,1,51,0)="      options:"
^DIC(9.4,3,22,21,"PAH",87,1,52,0)="      "
^DIC(9.4,3,22,21,"PAH",87,1,53,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",87,1,54,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",87,1,55,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",87,1,56,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",87,1,57,0)="     "
^DIC(9.4,3,22,21,"PAH",87,1,58,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",87,1,59,0)="      users are on the system and the possibility of some CLOBER errors are"
^DIC(9.4,3,22,21,"PAH",87,1,60,0)="      acceptable in the XQALFWD routine, then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",87,1,61,0)="     "
^DIC(9.4,3,22,21,"PAH",87,1,62,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",87,1,63,0)="      option:"
^DIC(9.4,3,22,21,"PAH",87,1,64,0)="        Install Package(s)  'XU*8.0*91'"
^DIC(9.4,3,22,21,"PAH",87,1,65,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",87,1,66,0)="                             "
^DIC(9.4,3,22,21,"PAH",87,1,67,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",87,1,68,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",87,1,69,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",87,1,70,0)="     "
^DIC(9.4,3,22,21,"PAH",87,1,71,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",87,1,72,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",87,1,73,0)=""
^DIC(9.4,3,22,21,"PAH",88,0)="101 SEQ #93^2981229^1"
^DIC(9.4,3,22,21,"PAH",89,0)="104 SEQ #94^2981229^1"
^DIC(9.4,3,22,21,"PAH",89,1,0)="^^115^115^2981229"
^DIC(9.4,3,22,21,"PAH",89,1,1,0)="**Note that the KERNEL 8.0 install had a separate file for the MGR routines"
^DIC(9.4,3,22,21,"PAH",89,1,2,0)="**and then cleaned up un-needed routines, because of this you may not"
^DIC(9.4,3,22,21,"PAH",89,1,3,0)="**have copies of routine not needed by your system"
^DIC(9.4,3,22,21,"PAH",89,1,4,0)="                "
^DIC(9.4,3,22,21,"PAH",89,1,5,0)="BRX-0898-12101  ZIS2    If a device had the Out Of Service field set, the"
^DIC(9.4,3,22,21,"PAH",89,1,6,0)="                        user was asked if this was OK.  The outcome was that"
^DIC(9.4,3,22,21,"PAH",89,1,7,0)="                        the user could queue to a device that was OOS."
^DIC(9.4,3,22,21,"PAH",89,1,8,0)="                        This change will make OOS devices unavailable."
^DIC(9.4,3,22,21,"PAH",89,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,10,0)="HOU-1198-72017  ZIS2    If a device had the QUEUEING field set to NOT"
^DIC(9.4,3,22,21,"PAH",89,1,11,0)="                ZIS1    ALLOWED and queuing was selected, the device"
^DIC(9.4,3,22,21,"PAH",89,1,12,0)="                        would be selected with just the IO(""Q"") flag"
^DIC(9.4,3,22,21,"PAH",89,1,13,0)="                        cleared.  This patch will cause the user to be"
^DIC(9.4,3,22,21,"PAH",89,1,14,0)="                        reasked the device question."
^DIC(9.4,3,22,21,"PAH",89,1,15,0)="                                             "
^DIC(9.4,3,22,21,"PAH",89,1,16,0)="WNY-0398-11876  ZISFVXD The %ZISF routine wasn't making consistent use"
^DIC(9.4,3,22,21,"PAH",89,1,17,0)="SAM-1098-22294  ZISFMSM of the HFS default directory."
^DIC(9.4,3,22,21,"PAH",89,1,18,0)="LEB-1198-20188          See F# 26562896"
^DIC(9.4,3,22,21,"PAH",89,1,19,0)="                        "
^DIC(9.4,3,22,21,"PAH",89,1,20,0)="CPRS            ZISHMSM The call to OPEN^%ZISH wasn't setting the IO"
^DIC(9.4,3,22,21,"PAH",89,1,21,0)="                ZISHONT subtype variables to appropriate values.  "
^DIC(9.4,3,22,21,"PAH",89,1,22,0)="                ZISHVXD Now they will default to P-OTHER 132 by 60."
^DIC(9.4,3,22,21,"PAH",89,1,23,0)="                "
^DIC(9.4,3,22,21,"PAH",89,1,24,0)="                ZOSFONT Avanti team, Do not allow HIGH priority on Cache."
^DIC(9.4,3,22,21,"PAH",89,1,25,0)="                "
^DIC(9.4,3,22,21,"PAH",89,1,26,0)="HL7 team        ZTMS1   When running dual taskman on DSM systems, if a "
^DIC(9.4,3,22,21,"PAH",89,1,27,0)="                        task requests to run on the other node from the"
^DIC(9.4,3,22,21,"PAH",89,1,28,0)="                        one that picks it up, then the task is placed"
^DIC(9.4,3,22,21,"PAH",89,1,29,0)="                        in the ""C"" list and is lost. This is fixed"
^DIC(9.4,3,22,21,"PAH",89,1,30,0)="                        by having the sub-manager look in the ""C"" list"
^DIC(9.4,3,22,21,"PAH",89,1,31,0)="                        as part of its checking for work to do."
^DIC(9.4,3,22,21,"PAH",89,1,32,0)="                        "
^DIC(9.4,3,22,21,"PAH",89,1,33,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",89,1,34,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",89,1,35,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",89,1,36,0)=" ;;8.0;KERNEL;<patchlist>;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",89,1,37,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,38,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",89,1,39,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",89,1,40,0)="ZIS1         10963783  10911260    **18,49,69,104**"
^DIC(9.4,3,22,21,"PAH",89,1,41,0)="ZIS2         10569129  10396923    **69,104**"
^DIC(9.4,3,22,21,"PAH",89,1,42,0)="ZIS3          5727193   6138459    **18,36,69,104**"
^DIC(9.4,3,22,21,"PAH",89,1,43,0)="ZISFMSM       4473223   4796822    **104**"
^DIC(9.4,3,22,21,"PAH",89,1,44,0)="ZISFVXD       5940026   6059078    **104**"
^DIC(9.4,3,22,21,"PAH",89,1,45,0)="ZISHMSM       5978186   6060577    **24,36,49,65,84,104**"
^DIC(9.4,3,22,21,"PAH",89,1,46,0)="ZISHONT       5018937   5114296    **34,65,84,104**"
^DIC(9.4,3,22,21,"PAH",89,1,47,0)="ZISHVXD       7237979   7315736    **24,36,65,84,104**"
^DIC(9.4,3,22,21,"PAH",89,1,48,0)="ZOSFONT       6905729   6981333    **34,104**"
^DIC(9.4,3,22,21,"PAH",89,1,49,0)="ZTMS1         6234917   6242844    **36,49,104**"
^DIC(9.4,3,22,21,"PAH",89,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,51,0)="List of preceding patches: 18, 24, 34, 36, 49, 65, 69, 84"
^DIC(9.4,3,22,21,"PAH",89,1,52,0)="Sites should use CHECK^XTSUMBLD to verify checksums"
^DIC(9.4,3,22,21,"PAH",89,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,54,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",89,1,55,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",89,1,56,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,57,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",89,1,58,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",89,1,59,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,60,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",89,1,61,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",89,1,62,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,63,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",89,1,64,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",89,1,65,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",89,1,66,0)="      options:"
^DIC(9.4,3,22,21,"PAH",89,1,67,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,68,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",89,1,69,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",89,1,70,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",89,1,71,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",89,1,72,0)="         "
^DIC(9.4,3,22,21,"PAH",89,1,73,0)=" 4.   Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",89,1,74,0)="      users are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",89,1,75,0)="      acceptable, then users can stay on the system.) The risk is users or"
^DIC(9.4,3,22,21,"PAH",89,1,76,0)="      tasks that are in the Device Handler at install time.  "
^DIC(9.4,3,22,21,"PAH",89,1,77,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",89,1,78,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,79,0)="  5.  D ^XPDKRN"
^DIC(9.4,3,22,21,"PAH",89,1,80,0)="         Install Package(s)  'XU*8.0*104'"
^DIC(9.4,3,22,21,"PAH",89,1,81,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",89,1,82,0)="                              "
^DIC(9.4,3,22,21,"PAH",89,1,83,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",89,1,84,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",89,1,85,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",89,1,86,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,87,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",89,1,88,0)="      OpenM Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",89,1,89,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",89,1,90,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",89,1,91,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,92,0)="      ZIS1"
^DIC(9.4,3,22,21,"PAH",89,1,93,0)="      ZIS2"
^DIC(9.4,3,22,21,"PAH",89,1,94,0)="      ZIS3"
^DIC(9.4,3,22,21,"PAH",89,1,95,0)="      ZISFMSM"
^DIC(9.4,3,22,21,"PAH",89,1,96,0)="      ZISFVXD"
^DIC(9.4,3,22,21,"PAH",89,1,97,0)="      ZISHMSM"
^DIC(9.4,3,22,21,"PAH",89,1,98,0)="      ZISHONT"
^DIC(9.4,3,22,21,"PAH",89,1,99,0)="      ZISHVXD"
^DIC(9.4,3,22,21,"PAH",89,1,100,0)="      ZOSFONT"
^DIC(9.4,3,22,21,"PAH",89,1,101,0)="      ZTMS1"
^DIC(9.4,3,22,21,"PAH",89,1,102,0)="      "
^DIC(9.4,3,22,21,"PAH",89,1,103,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",89,1,104,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",89,1,105,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",89,1,106,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",89,1,107,0)="      Patch number to load: 104"
^DIC(9.4,3,22,21,"PAH",89,1,108,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",89,1,109,0)="       "
^DIC(9.4,3,22,21,"PAH",89,1,110,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",89,1,111,0)=" 11.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",89,1,112,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",89,1,113,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,114,0)=""
^DIC(9.4,3,22,21,"PAH",89,1,115,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",90,0)="109 SEQ #95^2981229^1"
^DIC(9.4,3,22,21,"PAH",90,1,0)="^^65^65^2981229"
^DIC(9.4,3,22,21,"PAH",90,1,1,0)="HIN-1298-40427  XUSRB    A convoluted link with patch XU*8*69 is causing"
^DIC(9.4,3,22,21,"PAH",90,1,2,0)="                         problems in CPRS at DSM sites.  The error is"
^DIC(9.4,3,22,21,"PAH",90,1,3,0)="                         %DSM-E-DEVNOTOPN at QUIT^%ZIS6 with IO(0) null."
^DIC(9.4,3,22,21,"PAH",90,1,4,0)="                         This only happens at DSM sites that do not have"
^DIC(9.4,3,22,21,"PAH",90,1,5,0)="                         auto sign-on disabled.  The code that calls the"
^DIC(9.4,3,22,21,"PAH",90,1,6,0)="                         client agent mades a call to HOME^%ZIS and TCP"
^DIC(9.4,3,22,21,"PAH",90,1,7,0)="                         connection don't work as a home device.  The fix "
^DIC(9.4,3,22,21,"PAH",90,1,8,0)="                         is to have the XUSRB save the NULL device as the "
^DIC(9.4,3,22,21,"PAH",90,1,9,0)="                         HOME device before the call to Client agent."
^DIC(9.4,3,22,21,"PAH",90,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,11,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",90,1,12,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",90,1,13,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",90,1,14,0)=" ;;8.0;KERNEL;<patchlist>;Jul 05, 1995"
^DIC(9.4,3,22,21,"PAH",90,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,16,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",90,1,17,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",90,1,18,0)="XUSRB         5576613   5738122    **11,16,28,32,59,70,82,109**"
^DIC(9.4,3,22,21,"PAH",90,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,20,0)="List of preceding patches: 11, 16, 28, 32, 59, 70, 82"
^DIC(9.4,3,22,21,"PAH",90,1,21,0)="Sites should use CHECK^XTSUMBLD to verify checksums"
^DIC(9.4,3,22,21,"PAH",90,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,23,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",90,1,24,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",90,1,25,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,27,0)="  1.  DSM sites - This routines is usually mapped,"
^DIC(9.4,3,22,21,"PAH",90,1,28,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",90,1,29,0)="     "
^DIC(9.4,3,22,21,"PAH",90,1,30,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",90,1,31,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",90,1,32,0)="     "
^DIC(9.4,3,22,21,"PAH",90,1,33,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",90,1,34,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",90,1,35,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",90,1,36,0)="      options:"
^DIC(9.4,3,22,21,"PAH",90,1,37,0)="      "
^DIC(9.4,3,22,21,"PAH",90,1,38,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",90,1,39,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",90,1,40,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",90,1,41,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",90,1,42,0)="     "
^DIC(9.4,3,22,21,"PAH",90,1,43,0)="  4.  Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",90,1,44,0)="      Stop the Broker server(s)."
^DIC(9.4,3,22,21,"PAH",90,1,45,0)="        ""DO STOP^XWBTCP(<socket>)"" on each node that has Broker running."
^DIC(9.4,3,22,21,"PAH",90,1,46,0)="      (If you install when few users are on the system and the possibility "
^DIC(9.4,3,22,21,"PAH",90,1,47,0)="      of some CLOBER/NOSOURCE errors is acceptable, Leave the Broker "
^DIC(9.4,3,22,21,"PAH",90,1,48,0)="      running and queue the install for after hours.)"
^DIC(9.4,3,22,21,"PAH",90,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,50,0)="     "
^DIC(9.4,3,22,21,"PAH",90,1,51,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",90,1,52,0)="      option:"
^DIC(9.4,3,22,21,"PAH",90,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",90,1,54,0)="        Install Package(s)  'XU*8.0*109'"
^DIC(9.4,3,22,21,"PAH",90,1,55,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",90,1,56,0)="                             "
^DIC(9.4,3,22,21,"PAH",90,1,57,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",90,1,58,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",90,1,59,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",90,1,60,0)="     "
^DIC(9.4,3,22,21,"PAH",90,1,61,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",90,1,62,0)="      If the Broker was stopped, Remember to restart it."
^DIC(9.4,3,22,21,"PAH",90,1,63,0)="      ""DO STRT^XWBTCP(<socket>)"" on each Broker node."
^DIC(9.4,3,22,21,"PAH",90,1,64,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",90,1,65,0)=""
^DIC(9.4,3,22,21,"PAH",91,0)="107 SEQ #96^2990210^1"
^DIC(9.4,3,22,21,"PAH",91,1,0)="^^87^87^2990210"
^DIC(9.4,3,22,21,"PAH",91,1,1,0)="This patch contains KERNEL updates for the RUM package. "
^DIC(9.4,3,22,21,"PAH",91,1,2,0)="Changes to %ZOSVKR"
^DIC(9.4,3,22,21,"PAH",91,1,3,0)="  1. New label 'RU(KMPROPT,KMPRTYP,KMPRSTAT)' is introduced.  All calls to "
^DIC(9.4,3,22,21,"PAH",91,1,4,0)="     %ZOSVKR will now go through this label."
^DIC(9.4,3,22,21,"PAH",91,1,5,0)="  2. %ZOSVKR now collects data on a daily basis only (previous versions "
^DIC(9.4,3,22,21,"PAH",91,1,6,0)="     collected data hourly)."
^DIC(9.4,3,22,21,"PAH",91,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",91,1,8,0)="Changes to LOGRSRC^%ZOSV"
^DIC(9.4,3,22,21,"PAH",91,1,9,0)="       1. Adds 2 new parameters: TYPE and STATUS."
^DIC(9.4,3,22,21,"PAH",91,1,10,0)="       2. Now checks to see if RUM is turned on before continuing."
^DIC(9.4,3,22,21,"PAH",91,1,11,0)="       3. Calls %ZOSVKR through new label RU()."
^DIC(9.4,3,22,21,"PAH",91,1,12,0)="       "
^DIC(9.4,3,22,21,"PAH",91,1,13,0)="ZOSVONT  A change to allow opening TCP/IP devices from %ZIS."
^DIC(9.4,3,22,21,"PAH",91,1,14,0)="         DEVOK will not try and open CHANNEL type devices."
^DIC(9.4,3,22,21,"PAH",91,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",91,1,16,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",91,1,17,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",91,1,18,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",91,1,19,0)=" ;;8.0;KERNEL;<patchlist>;Jul 21, 1998"
^DIC(9.4,3,22,21,"PAH",91,1,20,0)=""
^DIC(9.4,3,22,21,"PAH",91,1,21,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",91,1,22,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",91,1,23,0)="ZOSVKRM        186974    217494    **90,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,24,0)="ZOSVKRO        186974    217494    **90,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,25,0)="ZOSVKRV       5026320   5456477    **90,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,26,0)="ZOSVMSM      11538678  10431698    **13,25,49,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,27,0)="ZOSVONT       5179039   5510564    **34,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,28,0)="ZOSVVXD       7782508   6011813    **13,65,71,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,29,0)="ZUMSM         2252648   3349196    **13,42,49,94,107**"
^DIC(9.4,3,22,21,"PAH",91,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",91,1,31,0)="List of preceding patches: 13, 25, 34, 42, 49, 65, 71, 90, 94"
^DIC(9.4,3,22,21,"PAH",91,1,32,0)="Sites should use CHECK^XTSUMBLD to verify checksums"
^DIC(9.4,3,22,21,"PAH",91,1,33,0)=""
^DIC(9.4,3,22,21,"PAH",91,1,34,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",91,1,35,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",91,1,36,0)=""
^DIC(9.4,3,22,21,"PAH",91,1,37,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",91,1,38,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",91,1,39,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,40,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",91,1,41,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",91,1,42,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,43,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",91,1,44,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",91,1,45,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",91,1,46,0)="      options:"
^DIC(9.4,3,22,21,"PAH",91,1,47,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,48,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",91,1,49,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",91,1,50,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",91,1,51,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",91,1,52,0)="         "
^DIC(9.4,3,22,21,"PAH",91,1,53,0)=" 4.  Users can remain on the system. This patch can be loaded at any"
^DIC(9.4,3,22,21,"PAH",91,1,54,0)="     non-peak time."
^DIC(9.4,3,22,21,"PAH",91,1,55,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,56,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",91,1,57,0)="      option:"
^DIC(9.4,3,22,21,"PAH",91,1,58,0)="         Install Package(s)  'XU*8.0*107'"
^DIC(9.4,3,22,21,"PAH",91,1,59,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",91,1,60,0)="                              "
^DIC(9.4,3,22,21,"PAH",91,1,61,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",91,1,62,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",91,1,63,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",91,1,64,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,65,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",91,1,66,0)="      OpenM Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",91,1,67,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",91,1,68,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",91,1,69,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,70,0)="      ZOSVKRM"
^DIC(9.4,3,22,21,"PAH",91,1,71,0)="      ZOSVKRO"
^DIC(9.4,3,22,21,"PAH",91,1,72,0)="      ZOSVKRV"
^DIC(9.4,3,22,21,"PAH",91,1,73,0)="      ZOSVMSM"
^DIC(9.4,3,22,21,"PAH",91,1,74,0)="      ZOSVONT"
^DIC(9.4,3,22,21,"PAH",91,1,75,0)="      ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",91,1,76,0)="      "
^DIC(9.4,3,22,21,"PAH",91,1,77,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",91,1,78,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",91,1,79,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",91,1,80,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",91,1,81,0)="      Patch number to load: 107"
^DIC(9.4,3,22,21,"PAH",91,1,82,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",91,1,83,0)="       "
^DIC(9.4,3,22,21,"PAH",91,1,84,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",91,1,85,0)="      ***MSM Sites ""ZL ZUMSM ZS ZU"" **"
^DIC(9.4,3,22,21,"PAH",91,1,86,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",91,1,87,0)=""
^DIC(9.4,3,22,21,"PAH",92,0)="113 SEQ #97^2990210^1"
^DIC(9.4,3,22,21,"PAH",93,0)="111 SEQ #98^2990303^1"
^DIC(9.4,3,22,21,"PAH",93,1,0)="^^84^84^2990303"
^DIC(9.4,3,22,21,"PAH",93,1,1,0)="NOIS              RTN   Description"
^DIC(9.4,3,22,21,"PAH",93,1,2,0)="LIT-1298-71717   XUS1   The code that logs users into the sign-on log"
^DIC(9.4,3,22,21,"PAH",93,1,3,0)="                        is very old and if the current date/time was in"
^DIC(9.4,3,22,21,"PAH",93,1,4,0)="                        use, it would add 1 second to the time.  With the"
^DIC(9.4,3,22,21,"PAH",93,1,5,0)="                        large number of users and tasks that are logged"
^DIC(9.4,3,22,21,"PAH",93,1,6,0)="                        these days it often would increment past 60 seconds"
^DIC(9.4,3,22,21,"PAH",93,1,7,0)="                        and sometimes past 60 minutes.  The fix was to "
^DIC(9.4,3,22,21,"PAH",93,1,8,0)="                        increment by 100th of a second."
^DIC(9.4,3,22,21,"PAH",93,1,9,0)="                        "
^DIC(9.4,3,22,21,"PAH",93,1,10,0)="DAY-1098-42371 XUTMOPT  ""One time queueing"" would allow queueing to devices"
^DIC(9.4,3,22,21,"PAH",93,1,11,0)="                        that cannot be queued to.  Checks were added to "
^DIC(9.4,3,22,21,"PAH",93,1,12,0)="                        prevent this."
^DIC(9.4,3,22,21,"PAH",93,1,13,0)="                        "
^DIC(9.4,3,22,21,"PAH",93,1,14,0)="BOS-0199-10157 XQALFWD  When forwarding an alert, and no comment was entered"
^DIC(9.4,3,22,21,"PAH",93,1,15,0)="                        the alert was not forwarded and the user did not "
^DIC(9.4,3,22,21,"PAH",93,1,16,0)="                        know the alert wasn't sent."
^DIC(9.4,3,22,21,"PAH",93,1,17,0)="                        "
^DIC(9.4,3,22,21,"PAH",93,1,18,0)="IND-1298-71717 XPARDD   When making a call to EN^XPAR and the data is "
^DIC(9.4,3,22,21,"PAH",93,1,19,0)="                        as a set of codes, sometimes it would talk.  This"
^DIC(9.4,3,22,21,"PAH",93,1,20,0)="                        unwanted behavior has been fixed. "
^DIC(9.4,3,22,21,"PAH",93,1,21,0)="                        "
^DIC(9.4,3,22,21,"PAH",93,1,22,0)="                XUSTAT  We found that XUSTAT had a reference to file 3."
^DIC(9.4,3,22,21,"PAH",93,1,23,0)="                        This has been changed to file 200."
^DIC(9.4,3,22,21,"PAH",93,1,24,0)="                        "
^DIC(9.4,3,22,21,"PAH",93,1,25,0)="MIN-0199-40756          The Institution file still has some subfiles "
^DIC(9.4,3,22,21,"PAH",93,1,26,0)="                        49.01 and 49.02 that still point to file 3.  "
^DIC(9.4,3,22,21,"PAH",93,1,27,0)="                        These had been marked for deletion and now are "
^DIC(9.4,3,22,21,"PAH",93,1,28,0)="                        deleted."
^DIC(9.4,3,22,21,"PAH",93,1,29,0)="                        "
^DIC(9.4,3,22,21,"PAH",93,1,30,0)="ALX-0199-71347          An error was occurring when a new entry was added"
^DIC(9.4,3,22,21,"PAH",93,1,31,0)="                        to the Institution file because of the AD x-ref."
^DIC(9.4,3,22,21,"PAH",93,1,32,0)="                        The fix was to new the variable DS in the x-ref"
^DIC(9.4,3,22,21,"PAH",93,1,33,0)="                        code."
^DIC(9.4,3,22,21,"PAH",93,1,34,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",93,1,35,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",93,1,36,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",93,1,37,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",93,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",93,1,39,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",93,1,40,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",93,1,41,0)="XQALFWD      10528433  10594990    **6,65,91,111**"
^DIC(9.4,3,22,21,"PAH",93,1,42,0)="XUINPCH       5067911   5263885    **20,36,49,63,65,69,96,91,111**"
^DIC(9.4,3,22,21,"PAH",93,1,43,0)="XUS1         10420726  10153593    **9,59,111**"
^DIC(9.4,3,22,21,"PAH",93,1,44,0)="XUSTAT       12766906  12791683    **111**"
^DIC(9.4,3,22,21,"PAH",93,1,45,0)="XUTMOPT       3629975   3867301    **2,111**"
^DIC(9.4,3,22,21,"PAH",93,1,46,0)=""
^DIC(9.4,3,22,21,"PAH",93,1,47,0)="List of preceding patches: 2, 6, 9, 20, 36, 49, 59, 63, 65, 69, 91, 96"
^DIC(9.4,3,22,21,"PAH",93,1,48,0)="Sites should use CHECK^XTSUMBLD to verify checksums"
^DIC(9.4,3,22,21,"PAH",93,1,49,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",93,1,50,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",93,1,51,0)=""
^DIC(9.4,3,22,21,"PAH",93,1,52,0)="  1.  DSM sites - Some of these routines maybe mapped,"
^DIC(9.4,3,22,21,"PAH",93,1,53,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",93,1,54,0)="     "
^DIC(9.4,3,22,21,"PAH",93,1,55,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",93,1,56,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",93,1,57,0)="     "
^DIC(9.4,3,22,21,"PAH",93,1,58,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",93,1,59,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",93,1,60,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",93,1,61,0)="      options:"
^DIC(9.4,3,22,21,"PAH",93,1,62,0)="      "
^DIC(9.4,3,22,21,"PAH",93,1,63,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",93,1,64,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",93,1,65,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",93,1,66,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",93,1,67,0)="     "
^DIC(9.4,3,22,21,"PAH",93,1,68,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",93,1,69,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",93,1,70,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",93,1,71,0)=""
^DIC(9.4,3,22,21,"PAH",93,1,72,0)=""
^DIC(9.4,3,22,21,"PAH",93,1,73,0)="     "
^DIC(9.4,3,22,21,"PAH",93,1,74,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",93,1,75,0)="      option:"
^DIC(9.4,3,22,21,"PAH",93,1,76,0)="        Install Package(s)  'XU*8.0*111'"
^DIC(9.4,3,22,21,"PAH",93,1,77,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",93,1,78,0)="                             "
^DIC(9.4,3,22,21,"PAH",93,1,79,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",93,1,80,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",93,1,81,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",93,1,82,0)="     "
^DIC(9.4,3,22,21,"PAH",93,1,83,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",93,1,84,0)=""
^DIC(9.4,3,22,21,"PAH",94,0)="100 SEQ #99^2990303^1"
^DIC(9.4,3,22,21,"PAH",95,0)="110 SEQ #100^2990303^1"
^DIC(9.4,3,22,21,"PAH",95,1,0)="^^1^1^2990303"
^DIC(9.4,3,22,21,"PAH",95,1,1,0)="See Patch Module for details."
^DIC(9.4,3,22,21,"PAH",96,0)="116 SEQ #101^2990303^1"
^DIC(9.4,3,22,21,"PAH",96,1,0)="^^1^1^2990303"
^DIC(9.4,3,22,21,"PAH",96,1,1,0)="   See Patch Module for details."
^DIC(9.4,3,22,21,"PAH",97,0)="112 SEQ #102^2990417^1"
^DIC(9.4,3,22,21,"PAH",97,1,0)="^^120^120^2990417"
^DIC(9.4,3,22,21,"PAH",97,1,1,0)="FOIA           XVIRPOST  This routine for setting up a DHCP system from"
^DIC(9.4,3,22,21,"PAH",97,1,2,0)="                         scratch still referenced files 3, 16. Fixed."
^DIC(9.4,3,22,21,"PAH",97,1,3,0)="                         Requested by the DBA."
^DIC(9.4,3,22,21,"PAH",97,1,4,0)="                         "
^DIC(9.4,3,22,21,"PAH",97,1,5,0)="               XUAF4     Fixed in the $$LKUP API."
^DIC(9.4,3,22,21,"PAH",97,1,6,0)="                          "
^DIC(9.4,3,22,21,"PAH",97,1,7,0)="LAS-0399-60359 XUTMOPT   In fixing the problem in NOIS DAY-1098-42371 I"
^DIC(9.4,3,22,21,"PAH",97,1,8,0)="                         broke ""One time queueing"" if a device wasn't needed."
^DIC(9.4,3,22,21,"PAH",97,1,9,0)="                         Now works correctly in both cases."
^DIC(9.4,3,22,21,"PAH",97,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,12,0)="   FORUM       XTER1A    Addressed a conflict with XM*7.1*50 and sending"
^DIC(9.4,3,22,21,"PAH",97,1,13,0)="                         error report as mail message."
^DIC(9.4,3,22,21,"PAH",97,1,14,0)="                         "
^DIC(9.4,3,22,21,"PAH",97,1,15,0)="               XLFSTR    New function call added  $$TRIM^XLFSTR(x[,""[L][R]""])."
^DIC(9.4,3,22,21,"PAH",97,1,16,0)="                         This call will trim spaces from the left, right"
^DIC(9.4,3,22,21,"PAH",97,1,17,0)="                         or both of a input string."
^DIC(9.4,3,22,21,"PAH",97,1,18,0)="                         "
^DIC(9.4,3,22,21,"PAH",97,1,19,0)="MWV-1298-22309 ZTLOAD1   It was possible for a task that was being requeued"
^DIC(9.4,3,22,21,"PAH",97,1,20,0)="MIW-0898-40133           to end up with a invalid device because of how"
^DIC(9.4,3,22,21,"PAH",97,1,21,0)="                         %ZTLOAD was building the entry in the task global."
^DIC(9.4,3,22,21,"PAH",97,1,22,0)="                         "
^DIC(9.4,3,22,21,"PAH",97,1,23,0)="   WebTop      ZIS       Code to allow special applications to establish a"
^DIC(9.4,3,22,21,"PAH",97,1,24,0)="   Broker      ZIS1      home device from the background. [F#28972403]"
^DIC(9.4,3,22,21,"PAH",97,1,25,0)="   "
^DIC(9.4,3,22,21,"PAH",97,1,26,0)="    Cache      ZTER      Added code to save a special Cache variable."
^DIC(9.4,3,22,21,"PAH",97,1,27,0)="               ZTER1     Simplify some code in UNWIND."
^DIC(9.4,3,22,21,"PAH",97,1,28,0)="                 "
^DIC(9.4,3,22,21,"PAH",97,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,30,0)="   FORUM       ZIS2      Taskman was getting a subscript error because of"
^DIC(9.4,3,22,21,"PAH",97,1,31,0)="                         a job tasked to a slave device. Fix was to check"
^DIC(9.4,3,22,21,"PAH",97,1,32,0)="                         if IO="""" and set POP it true."
^DIC(9.4,3,22,21,"PAH",97,1,33,0)="                 "
^DIC(9.4,3,22,21,"PAH",97,1,34,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,35,0)="                         Request from DBA to add E-MAIL ADDRESS field to"
^DIC(9.4,3,22,21,"PAH",97,1,36,0)="                         NEW PERSON file.  Field .151 node .15"
^DIC(9.4,3,22,21,"PAH",97,1,37,0)="                         To be used by IFCAP."
^DIC(9.4,3,22,21,"PAH",97,1,38,0)="                         "
^DIC(9.4,3,22,21,"PAH",97,1,39,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",97,1,40,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",97,1,41,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",97,1,42,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",97,1,43,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,44,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",97,1,45,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",97,1,46,0)="XLFSTR        1841692   2042372    **112**"
^DIC(9.4,3,22,21,"PAH",97,1,47,0)="XTER1A       16315266  13449705    **63,112**"
^DIC(9.4,3,22,21,"PAH",97,1,48,0)="XUAF4         1190987   1458355    **43,112**"
^DIC(9.4,3,22,21,"PAH",97,1,49,0)="XUTMOPT       3867301   3807330    **2,111,112**"
^DIC(9.4,3,22,21,"PAH",97,1,50,0)="XVIRPOST      4773190   3825342    **112**"
^DIC(9.4,3,22,21,"PAH",97,1,51,0)="ZIS           9534282   9454725    **18,23,69,112**"
^DIC(9.4,3,22,21,"PAH",97,1,52,0)="ZIS1         10963783  10540675    **18,49,69,104,112**"
^DIC(9.4,3,22,21,"PAH",97,1,53,0)="ZIS2         10569129  10140057    **69,104,112**"
^DIC(9.4,3,22,21,"PAH",97,1,54,0)="ZTER         19873831  18976906    **8,18,32,24,36,63,73,79,86,112**"
^DIC(9.4,3,22,21,"PAH",97,1,55,0)="ZTER1         5603505   4369079    **18,24,36,49,112**"
^DIC(9.4,3,22,21,"PAH",97,1,56,0)="ZTLOAD1       6320450   6628172    **112**"
^DIC(9.4,3,22,21,"PAH",97,1,57,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,58,0)="List of preceding patches: 2, 8, 18, 23, 24, 32, 36, 43, 49, 63, 69, 73"
^DIC(9.4,3,22,21,"PAH",97,1,59,0)="79, 86, 104, 111"
^DIC(9.4,3,22,21,"PAH",97,1,60,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",97,1,61,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,62,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",97,1,63,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",97,1,64,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,65,0)=">>>Do not allow users to log in to the system during installation."
^DIC(9.4,3,22,21,"PAH",97,1,66,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,67,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",97,1,68,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",97,1,69,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,70,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",97,1,71,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",97,1,72,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,73,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",97,1,74,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",97,1,75,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",97,1,76,0)="      options:"
^DIC(9.4,3,22,21,"PAH",97,1,77,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,78,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",97,1,79,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",97,1,80,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",97,1,81,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",97,1,82,0)="         "
^DIC(9.4,3,22,21,"PAH",97,1,83,0)=" 4.   Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",97,1,84,0)="      users are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",97,1,85,0)="      acceptable, then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",97,1,86,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,87,0)="  5.  "
^DIC(9.4,3,22,21,"PAH",97,1,88,0)="      Use ""D ^XPDKRN"" then"
^DIC(9.4,3,22,21,"PAH",97,1,89,0)="         Install Package(s)  'XU*8.0*112'"
^DIC(9.4,3,22,21,"PAH",97,1,90,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",97,1,91,0)="                              "
^DIC(9.4,3,22,21,"PAH",97,1,92,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",97,1,93,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",97,1,94,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",97,1,95,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,96,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",97,1,97,0)="      OpenM Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",97,1,98,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",97,1,99,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",97,1,100,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,101,0)="      ZIS"
^DIC(9.4,3,22,21,"PAH",97,1,102,0)="      ZIS1"
^DIC(9.4,3,22,21,"PAH",97,1,103,0)="      ZIS2"
^DIC(9.4,3,22,21,"PAH",97,1,104,0)="      ZTLOAD1"
^DIC(9.4,3,22,21,"PAH",97,1,105,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",97,1,106,0)="      ZTER1"
^DIC(9.4,3,22,21,"PAH",97,1,107,0)="      "
^DIC(9.4,3,22,21,"PAH",97,1,108,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",97,1,109,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",97,1,110,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",97,1,111,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",97,1,112,0)="      Patch number to load: 112"
^DIC(9.4,3,22,21,"PAH",97,1,113,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",97,1,114,0)="       "
^DIC(9.4,3,22,21,"PAH",97,1,115,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",97,1,116,0)=" 11.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",97,1,117,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,118,0)=""
^DIC(9.4,3,22,21,"PAH",97,1,119,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",97,1,120,0)=""
^DIC(9.4,3,22,21,"PAH",98,0)="98 SEQ #103^2990419^1"
^DIC(9.4,3,22,21,"PAH",98,1,0)="^^48^48^2990419"
^DIC(9.4,3,22,21,"PAH",98,1,1,0)="This patch is to re-namespace the routines called from within the protocol"
^DIC(9.4,3,22,21,"PAH",98,1,2,0)="file from OR* routine to XQOR* routines.   It turns out that only 2"
^DIC(9.4,3,22,21,"PAH",98,1,3,0)="routines and the compiled cross-references needed to be changed."
^DIC(9.4,3,22,21,"PAH",98,1,4,0)="The 2 routine are ORDD101 to XQORD101 and ORDD1 to XQORDD1 and the X-ref"
^DIC(9.4,3,22,21,"PAH",98,1,5,0)="from ORD1 to XQORC."
^DIC(9.4,3,22,21,"PAH",98,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",98,1,7,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",98,1,8,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",98,1,9,0)="XQORD101                7689712    **98**"
^DIC(9.4,3,22,21,"PAH",98,1,10,0)="XQORDD1                 6335340    **98**"
^DIC(9.4,3,22,21,"PAH",98,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",98,1,12,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",98,1,13,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",98,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",98,1,15,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",98,1,16,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",98,1,17,0)="     "
^DIC(9.4,3,22,21,"PAH",98,1,18,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",98,1,19,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",98,1,20,0)="     "
^DIC(9.4,3,22,21,"PAH",98,1,21,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",98,1,22,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",98,1,23,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",98,1,24,0)="      options:"
^DIC(9.4,3,22,21,"PAH",98,1,25,0)="      "
^DIC(9.4,3,22,21,"PAH",98,1,26,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",98,1,27,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",98,1,28,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",98,1,29,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",98,1,30,0)="     "
^DIC(9.4,3,22,21,"PAH",98,1,31,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",98,1,32,0)="      users are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",98,1,33,0)="      acceptable, then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",98,1,34,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",98,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",98,1,36,0)="     "
^DIC(9.4,3,22,21,"PAH",98,1,37,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",98,1,38,0)="      option:"
^DIC(9.4,3,22,21,"PAH",98,1,39,0)="        Install Package(s)  'XU*8.0*98'"
^DIC(9.4,3,22,21,"PAH",98,1,40,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",98,1,41,0)="                             "
^DIC(9.4,3,22,21,"PAH",98,1,42,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",98,1,43,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",98,1,44,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",98,1,45,0)="     "
^DIC(9.4,3,22,21,"PAH",98,1,46,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",98,1,47,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",98,1,48,0)=""
^DIC(9.4,3,22,21,"PAH",99,0)="121 SEQ #104^2990602^1"
^DIC(9.4,3,22,21,"PAH",99,1,0)="^^66^66^2990602"
^DIC(9.4,3,22,21,"PAH",99,1,1,0)="This patch is being released by Capacity Management (CM) in anticipation"
^DIC(9.4,3,22,21,"PAH",99,1,2,0)="of a future patch for the Statistical Analysis of Global Growth (SAGG)"
^DIC(9.4,3,22,21,"PAH",99,1,3,0)="Version 1.8 software package.  A future SAGG patch will enable the"
^DIC(9.4,3,22,21,"PAH",99,1,4,0)="collection of disk capacity information from the sites."
^DIC(9.4,3,22,21,"PAH",99,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",99,1,6,0)="This patch distrbution will be adding a new %ZOSVK* routine to the"
^DIC(9.4,3,22,21,"PAH",99,1,7,0)="system-specific manager routine set.  The accompanying installation"
^DIC(9.4,3,22,21,"PAH",99,1,8,0)="instructions will guide you in adding these routines to your system."
^DIC(9.4,3,22,21,"PAH",99,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",99,1,10,0)="This distribution also contains the ZTMGRSET routine which will save the"
^DIC(9.4,3,22,21,"PAH",99,1,11,0)="new routine under the correct name."
^DIC(9.4,3,22,21,"PAH",99,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",99,1,13,0)=" "
^DIC(9.4,3,22,21,"PAH",99,1,14,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",99,1,15,0)="============"
^DIC(9.4,3,22,21,"PAH",99,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",99,1,17,0)="  1.   DSM sites - Some of these routines are usually mapped, so you will"
^DIC(9.4,3,22,21,"PAH",99,1,18,0)="       need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",99,1,19,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,20,0)="  2.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,3,22,21,"PAH",99,1,21,0)="       option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",99,1,22,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,23,0)="  3.   The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",99,1,24,0)="       system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",99,1,25,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",99,1,26,0)="       options:"
^DIC(9.4,3,22,21,"PAH",99,1,27,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,28,0)="          Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",99,1,29,0)="          Print Transport Global"
^DIC(9.4,3,22,21,"PAH",99,1,30,0)="          Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",99,1,31,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",99,1,32,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,33,0)="   4.  Inhibit users from login into the system.  (If you install when few"
^DIC(9.4,3,22,21,"PAH",99,1,34,0)="       users are on the system and the possibility of some CLOBER errors"
^DIC(9.4,3,22,21,"PAH",99,1,35,0)="       is accecptable, then users can stay on the system.)  "
^DIC(9.4,3,22,21,"PAH",99,1,36,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,37,0)="   5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",99,1,38,0)="       option:"
^DIC(9.4,3,22,21,"PAH",99,1,39,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,40,0)="          Install Package(s)   'XU*8.0*121'"
^DIC(9.4,3,22,21,"PAH",99,1,41,0)="                                =========="
^DIC(9.4,3,22,21,"PAH",99,1,42,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,43,0)="       No options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",99,1,44,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,45,0)="          Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,3,22,21,"PAH",99,1,46,0)="          and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",99,1,47,0)="                         =="
^DIC(9.4,3,22,21,"PAH",99,1,48,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,49,0)="   6.  OpenM sites - you do not need to move any routines, skip this step."
^DIC(9.4,3,22,21,"PAH",99,1,50,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,51,0)="       DSM and MSM sites - you need to move several routines from your"
^DIC(9.4,3,22,21,"PAH",99,1,52,0)="       production account to each manager account."
^DIC(9.4,3,22,21,"PAH",99,1,53,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,54,0)="          ZOSVKSD"
^DIC(9.4,3,22,21,"PAH",99,1,55,0)="          ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",99,1,56,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,57,0)="   7.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",99,1,58,0)="       All sites:"
^DIC(9.4,3,22,21,"PAH",99,1,59,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,60,0)="          DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",99,1,61,0)="          Select the System"
^DIC(9.4,3,22,21,"PAH",99,1,62,0)="          Patch number to load: 121"
^DIC(9.4,3,22,21,"PAH",99,1,63,0)="                                ==="
^DIC(9.4,3,22,21,"PAH",99,1,64,0)="   8.  DSM sites - after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",99,1,65,0)="       "
^DIC(9.4,3,22,21,"PAH",99,1,66,0)="   9.  Enable user logins."
^DIC(9.4,3,22,21,"PAH",100,0)="117 SEQ #105^2990622^1"
^DIC(9.4,3,22,21,"PAH",100,1,0)="^^83^83^2990622"
^DIC(9.4,3,22,21,"PAH",100,1,1,0)="This patch adds two new fields and removes several fields marked for"
^DIC(9.4,3,22,21,"PAH",100,1,2,0)="removal."
^DIC(9.4,3,22,21,"PAH",100,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,4,0)="NEW FIELDS"
^DIC(9.4,3,22,21,"PAH",100,1,5,0)="This Patch adds a new field with data to the PACKAGE file: ADDITIONAL"
^DIC(9.4,3,22,21,"PAH",100,1,6,0)="PREFIXS. This was requested by the DBA so that packages could check patches"
^DIC(9.4,3,22,21,"PAH",100,1,7,0)="in KIDS when the patch was in alternate prefix namespace. "
^DIC(9.4,3,22,21,"PAH",100,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",100,1,9,0)="This patch adds a new field: MAIL GROUP, that KIDS will use with patch"
^DIC(9.4,3,22,21,"PAH",100,1,10,0)="XU*8*108 to send a local install message.  "
^DIC(9.4,3,22,21,"PAH",100,1,11,0)=">>You may want to add local MAIL GROUPS that should be notified when a "
^DIC(9.4,3,22,21,"PAH",100,1,12,0)="  package is installed.<<"
^DIC(9.4,3,22,21,"PAH",100,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,14,0)="FIELD REMOVAL  the following fields are removed."
^DIC(9.4,3,22,21,"PAH",100,1,15,0)="4     *ROUTINE"
^DIC(9.4,3,22,21,"PAH",100,1,16,0)="5     *GLOBAL"
^DIC(9.4,3,22,21,"PAH",100,1,17,0)="11.1  *MAINTENANCE ISC"
^DIC(9.4,3,22,21,"PAH",100,1,18,0)="11.4  *VERIFICATION"
^DIC(9.4,3,22,21,"PAH",100,1,19,0)="11.5  *ALPHA"
^DIC(9.4,3,22,21,"PAH",100,1,20,0)="11.6  *BETA"
^DIC(9.4,3,22,21,"PAH",100,1,21,0)="11.7  *DELTA"
^DIC(9.4,3,22,21,"PAH",100,1,22,0)="12    *PRIMARY HELP FRAME"
^DIC(9.4,3,22,21,"PAH",100,1,23,0)="200.1 *USER TERMINATE TAG"
^DIC(9.4,3,22,21,"PAH",100,1,24,0)="200.2 *USER TERMINATE ROUTINE"
^DIC(9.4,3,22,21,"PAH",100,1,25,0)="1920  *STATUS"
^DIC(9.4,3,22,21,"PAH",100,1,26,0)="1933  *KEY VARIABLE"
^DIC(9.4,3,22,21,"PAH",100,1,27,0)="And in the VERSION multipule"
^DIC(9.4,3,22,21,"PAH",100,1,28,0)="51   *RELEASE NOTE"
^DIC(9.4,3,22,21,"PAH",100,1,29,0)="61   *INSTALLATION NOTES"
^DIC(9.4,3,22,21,"PAH",100,1,30,0)="62   *SYSTEM REQUIREMENTS"
^DIC(9.4,3,22,21,"PAH",100,1,31,0)="63   *PROGRAMMER NOTES"
^DIC(9.4,3,22,21,"PAH",100,1,32,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,33,0)="The following fields marked with a * have been left at this time."
^DIC(9.4,3,22,21,"PAH",100,1,34,0)="   9.5             *MENU  (multiple)"
^DIC(9.4,3,22,21,"PAH",100,1,35,0)="   10.6            *LOWEST FILE NUMBER"
^DIC(9.4,3,22,21,"PAH",100,1,36,0)="   11              *HIGHEST FILE NUMBER"
^DIC(9.4,3,22,21,"PAH",100,1,37,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,39,0)="Several fields used by DIFROM and marked for removal have had the * removed "
^DIC(9.4,3,22,21,"PAH",100,1,40,0)="from the name."
^DIC(9.4,3,22,21,"PAH",100,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,42,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",100,1,43,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",100,1,44,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",100,1,45,0)=" ;;8.0;KERNEL;<patchlist>;Apr 10, 1999"
^DIC(9.4,3,22,21,"PAH",100,1,46,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,47,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",100,1,48,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",100,1,49,0)="XUPCH117                6388451    **117**"
^DIC(9.4,3,22,21,"PAH",100,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,51,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",100,1,52,0)="                    "
^DIC(9.4,3,22,21,"PAH",100,1,53,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",100,1,54,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",100,1,55,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,56,0)="  1.  Install is file data only. "
^DIC(9.4,3,22,21,"PAH",100,1,57,0)="     "
^DIC(9.4,3,22,21,"PAH",100,1,58,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",100,1,59,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",100,1,60,0)="     "
^DIC(9.4,3,22,21,"PAH",100,1,61,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",100,1,62,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",100,1,63,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",100,1,64,0)="      options:"
^DIC(9.4,3,22,21,"PAH",100,1,65,0)="      "
^DIC(9.4,3,22,21,"PAH",100,1,66,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",100,1,67,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",100,1,68,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",100,1,69,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",100,1,70,0)="     "
^DIC(9.4,3,22,21,"PAH",100,1,71,0)="  4.  Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",100,1,72,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",100,1,73,0)="     "
^DIC(9.4,3,22,21,"PAH",100,1,74,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",100,1,75,0)="      option:"
^DIC(9.4,3,22,21,"PAH",100,1,76,0)="        Install Package(s)  'XU*8.0*117'"
^DIC(9.4,3,22,21,"PAH",100,1,77,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",100,1,78,0)="                                                          "
^DIC(9.4,3,22,21,"PAH",100,1,79,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",100,1,80,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",100,1,81,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",100,1,82,0)=""
^DIC(9.4,3,22,21,"PAH",100,1,83,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",101,0)="114 SEQ #106^2990626^1"
^DIC(9.4,3,22,21,"PAH",101,1,0)="^^247^247^2990626"
^DIC(9.4,3,22,21,"PAH",101,1,1,0)="This patch fixes several problems associated with alerts and provides"
^DIC(9.4,3,22,21,"PAH",101,1,2,0)="numerous requested enhancements."
^DIC(9.4,3,22,21,"PAH",101,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,4,0)="NOIS"
^DIC(9.4,3,22,21,"PAH",101,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,6,0)="HUN-0997-20420   MAC-1198-60864"
^DIC(9.4,3,22,21,"PAH",101,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,8,0)="The ability to forward an alert has been limited to the point of"
^DIC(9.4,3,22,21,"PAH",101,1,9,0)="selection and prior to processing an alert.  A number of users have"
^DIC(9.4,3,22,21,"PAH",101,1,10,0)="requested the ability to view and/or process an alert and then be able to"
^DIC(9.4,3,22,21,"PAH",101,1,11,0)="forward (as reflected in the above NOIS entries) or set the alert as new"
^DIC(9.4,3,22,21,"PAH",101,1,12,0)="again for subsequent processing. The current patch adds the ability to"
^DIC(9.4,3,22,21,"PAH",101,1,13,0)="forward or re-new the alert at the point where previously the user was"
^DIC(9.4,3,22,21,"PAH",101,1,14,0)="asked about continuing alert processing."
^DIC(9.4,3,22,21,"PAH",101,1,15,0)="Routines affected:   XQALERT1, XQALFWD"
^DIC(9.4,3,22,21,"PAH",101,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,18,0)="WBP-0198-22413"
^DIC(9.4,3,22,21,"PAH",101,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,20,0)="While CPRS has supported a capability to send alerts directly to a"
^DIC(9.4,3,22,21,"PAH",101,1,21,0)="designated surrogate, this has left other packages without such an"
^DIC(9.4,3,22,21,"PAH",101,1,22,0)="ability.  This NOIS and CPRS developers have requested a more generic"
^DIC(9.4,3,22,21,"PAH",101,1,23,0)="surrogate capability supported directly by the alerts within Kernel.  The"
^DIC(9.4,3,22,21,"PAH",101,1,24,0)="current patch adds the ability for an individual using a new 'S' option"
^DIC(9.4,3,22,21,"PAH",101,1,25,0)="within the alerts to designate and/or remove a surrogate for their"
^DIC(9.4,3,22,21,"PAH",101,1,26,0)="alerts.  The user may, if desired, specify a start date/time and/or an"
^DIC(9.4,3,22,21,"PAH",101,1,27,0)="end date/time for the surrogate to be effective.  If an end date/time is"
^DIC(9.4,3,22,21,"PAH",101,1,28,0)="specified, the surrogate will be removed automatically effective with the"
^DIC(9.4,3,22,21,"PAH",101,1,29,0)="first alert sent to the user after the end date/time has passed.  If a"
^DIC(9.4,3,22,21,"PAH",101,1,30,0)="start date/time is not specified, the surrogate becomes active"
^DIC(9.4,3,22,21,"PAH",101,1,31,0)="immediately.  If an end date/time is not specified, the surrogate is"
^DIC(9.4,3,22,21,"PAH",101,1,32,0)="active until the user removes the surrogate.  A message is sent to the"
^DIC(9.4,3,22,21,"PAH",101,1,33,0)="surrogate to indicate that he has been designated as a surrogate, and a"
^DIC(9.4,3,22,21,"PAH",101,1,34,0)="message is sent when the surrogate is removed.  If the user has no alerts"
^DIC(9.4,3,22,21,"PAH",101,1,35,0)="and selects the alert option, he will be asked if he wants to add or"
^DIC(9.4,3,22,21,"PAH",101,1,36,0)="remove a surrogate.  A new option (XQALERT SURROGATE SET/REMOVE) is also"
^DIC(9.4,3,22,21,"PAH",101,1,37,0)="provided which may be used by IRM or ADPAC staff to add or remove a"
^DIC(9.4,3,22,21,"PAH",101,1,38,0)="surrogate for a selected user.  This option has been added to the Alert"
^DIC(9.4,3,22,21,"PAH",101,1,39,0)="Manager option."
^DIC(9.4,3,22,21,"PAH",101,1,40,0)="Routines affected: XQALERT1, XQALSET, XQALSURO (a new routine)"
^DIC(9.4,3,22,21,"PAH",101,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,43,0)="ISL-0299-50356"
^DIC(9.4,3,22,21,"PAH",101,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,45,0)="A problem was identified such that if an alert was deleted for a given"
^DIC(9.4,3,22,21,"PAH",101,1,46,0)="user, and then the same alert was specified to be deleted for the same"
^DIC(9.4,3,22,21,"PAH",101,1,47,0)="user, it resulted in the alert being deleted for the next user with a"
^DIC(9.4,3,22,21,"PAH",101,1,48,0)="higher internal entry number and the alert was still active.  This patch"
^DIC(9.4,3,22,21,"PAH",101,1,49,0)="corrects this problem."
^DIC(9.4,3,22,21,"PAH",101,1,50,0)="Routines affected: XQALDEL"
^DIC(9.4,3,22,21,"PAH",101,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,53,0)="Functionality requested by CPRS developers"
^DIC(9.4,3,22,21,"PAH",101,1,54,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,55,0)="The ability for a user to delete specific alerts without viewing and/or"
^DIC(9.4,3,22,21,"PAH",101,1,56,0)="processing them has been requested many times.  In this patch, this"
^DIC(9.4,3,22,21,"PAH",101,1,57,0)="functionality is included by providing the new 'D' option within the"
^DIC(9.4,3,22,21,"PAH",101,1,58,0)="alerts. This option provides the ability to delete ""information only"""
^DIC(9.4,3,22,21,"PAH",101,1,59,0)="alerts. Alerts which require processing can not currently be deleted.  In"
^DIC(9.4,3,22,21,"PAH",101,1,60,0)="the future, however, if alerts requiring processing are created with the"
^DIC(9.4,3,22,21,"PAH",101,1,61,0)="new variable XQACNDEL set to 1 they too would be able to be deleted"
^DIC(9.4,3,22,21,"PAH",101,1,62,0)="(i.e., the developer of the code which creates the alert can specify if"
^DIC(9.4,3,22,21,"PAH",101,1,63,0)="it must be processed or can be deleted). Any alerts which were selected"
^DIC(9.4,3,22,21,"PAH",101,1,64,0)="for deletion, but could not be deleted will be noted for the user.  The"
^DIC(9.4,3,22,21,"PAH",101,1,65,0)="ability for the user to delete alerts other than information only will"
^DIC(9.4,3,22,21,"PAH",101,1,66,0)="require that the developers within a package decide that specific alerts,"
^DIC(9.4,3,22,21,"PAH",101,1,67,0)="which would normally invoke processing via an option or routine, may be"
^DIC(9.4,3,22,21,"PAH",101,1,68,0)="deleted specifically by the user without processing. They would then set"
^DIC(9.4,3,22,21,"PAH",101,1,69,0)="the variable XQACNDEL to a value of 1 (one) prior to calling SET^XQALERT"
^DIC(9.4,3,22,21,"PAH",101,1,70,0)="to set up the alert.  Deletion of an alert by the user (or by IRM or"
^DIC(9.4,3,22,21,"PAH",101,1,71,0)="ADPAC staff using the existing option) is noted within the ALERT TRACKING"
^DIC(9.4,3,22,21,"PAH",101,1,72,0)="file as deletion by a user (with the user ID) without processing of the"
^DIC(9.4,3,22,21,"PAH",101,1,73,0)="alert."
^DIC(9.4,3,22,21,"PAH",101,1,74,0)="Routines affected: XQALERT1, XQALDEL"
^DIC(9.4,3,22,21,"PAH",101,1,75,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,76,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,77,0)="There have been several requests for the display of pending alerts to"
^DIC(9.4,3,22,21,"PAH",101,1,78,0)="return to the current screen after an alert has been processed.  This"
^DIC(9.4,3,22,21,"PAH",101,1,79,0)="capability is included within the current patch."
^DIC(9.4,3,22,21,"PAH",101,1,80,0)="Routines affected: XQALERT1"
^DIC(9.4,3,22,21,"PAH",101,1,81,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,82,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,83,0)="The following entry points are added within this patch and are entered as"
^DIC(9.4,3,22,21,"PAH",101,1,84,0)="supported references."
^DIC(9.4,3,22,21,"PAH",101,1,85,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,86,0)="AHISTORY^XQALBUTL(XQAID,ROOT) - Provides information from the ALERT"
^DIC(9.4,3,22,21,"PAH",101,1,87,0)="TRACKING file for the alert indicated by the alert ID (XQAID).  The"
^DIC(9.4,3,22,21,"PAH",101,1,88,0)="information is returned descendent from the closed root specified by ROOT"
^DIC(9.4,3,22,21,"PAH",101,1,89,0)="in the form that it is present in the ALERT TRACKING file."
^DIC(9.4,3,22,21,"PAH",101,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,91,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,92,0)="$$PENDING^XQALBUTL(XQAUSER,XQAID) - Returns 1 (one) if the alert"
^DIC(9.4,3,22,21,"PAH",101,1,93,0)="indicated by the alert ID (XQAID) is currently pending for the user with"
^DIC(9.4,3,22,21,"PAH",101,1,94,0)="internal entry number specified by XQAUSER.  Otherwise a value of 0"
^DIC(9.4,3,22,21,"PAH",101,1,95,0)="(zero) is returned."
^DIC(9.4,3,22,21,"PAH",101,1,96,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,97,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,98,0)="$$PKGPEND(XQAUSER,XQAPKG) - Returns 1 if the user indicated by XQAUSER"
^DIC(9.4,3,22,21,"PAH",101,1,99,0)="has any pending alerts with the first ';'-piece of XQAID equal to the"
^DIC(9.4,3,22,21,"PAH",101,1,100,0)="package identifier indicated by XQAPKG."
^DIC(9.4,3,22,21,"PAH",101,1,101,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,102,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,103,0)="SETSURO^XQALSURO(XQAUSER,XQALSURO,XQALSTRT,XQALEND) - Establishes for the"
^DIC(9.4,3,22,21,"PAH",101,1,104,0)="user with internal entry number XQAUSER a surrogate with the internal"
^DIC(9.4,3,22,21,"PAH",101,1,105,0)="entry number XQALSURO.  XQALSTRT is an optional start date/time in"
^DIC(9.4,3,22,21,"PAH",101,1,106,0)="internal VA Filemanager format, and XQALEND is an optional end date/time"
^DIC(9.4,3,22,21,"PAH",101,1,107,0)="in internal VA Filemanager format."
^DIC(9.4,3,22,21,"PAH",101,1,108,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,110,0)="REMVSURO^XQALSURO(XQAUSER) - Removes the current surrogate (if any) for"
^DIC(9.4,3,22,21,"PAH",101,1,111,0)="the user with the internal entry number XQAUSER."
^DIC(9.4,3,22,21,"PAH",101,1,112,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,113,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,114,0)="$$CURRSURO^XQALSURO(XQAUSER) - For the user with internal entry number"
^DIC(9.4,3,22,21,"PAH",101,1,115,0)="XQAUSER returns the internal entry number of the current surrogate or -1"
^DIC(9.4,3,22,21,"PAH",101,1,116,0)="if there is no surrogate specified."
^DIC(9.4,3,22,21,"PAH",101,1,117,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,118,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,119,0)="ALERTDAT^XQALBUTL(XQAID,ROOT) - Returns information from ALERT TRACKING"
^DIC(9.4,3,22,21,"PAH",101,1,120,0)="file for alert with XQAID.  The data is returned descendent from the"
^DIC(9.4,3,22,21,"PAH",101,1,121,0)="closed root passed in ROOT.  If ROOT is not specified, the data is"
^DIC(9.4,3,22,21,"PAH",101,1,122,0)="returned in the array XQALERTD.  The array is subscripted by the field"
^DIC(9.4,3,22,21,"PAH",101,1,123,0)="number, the value is returned as the internal value (including NULL"
^DIC(9.4,3,22,21,"PAH",101,1,124,0)="values) and, if the internal and external values differ, followed by the"
^DIC(9.4,3,22,21,"PAH",101,1,125,0)="external value separated by '^'.  If the field names are desired, they"
^DIC(9.4,3,22,21,"PAH",101,1,126,0)="are also included as a second subscript to the array (with a null value)."
^DIC(9.4,3,22,21,"PAH",101,1,127,0)="If the alert is not present, the array root is returned with a NULL"
^DIC(9.4,3,22,21,"PAH",101,1,128,0)="value."
^DIC(9.4,3,22,21,"PAH",101,1,129,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,130,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,131,0)="USERLIST^XQALBUTL(XQAID,ROOT) - Returns recipients of alert with ID of"
^DIC(9.4,3,22,21,"PAH",101,1,132,0)="XQAID from ALERT TRACKING file in an array descendent from the closed"
^DIC(9.4,3,22,21,"PAH",101,1,133,0)="array specified in ROOT.  If ROOT is not specified, then the data is"
^DIC(9.4,3,22,21,"PAH",101,1,134,0)="returned in XQALUSRS.  The data is returned subscripted by an integer,"
^DIC(9.4,3,22,21,"PAH",101,1,135,0)="and the value contains the internal entry number for the user in File 200"
^DIC(9.4,3,22,21,"PAH",101,1,136,0)="and the external value for the user's name (the .01 field in file 200)"
^DIC(9.4,3,22,21,"PAH",101,1,137,0)="separated by '^'.  If the specified alert is not present, the array root"
^DIC(9.4,3,22,21,"PAH",101,1,138,0)="is returned with a NULL value."
^DIC(9.4,3,22,21,"PAH",101,1,139,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,140,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,141,0)="USERDATA^XQALBUTL(XQAID,XQAUSER,ROOT) - returns information from the"
^DIC(9.4,3,22,21,"PAH",101,1,142,0)="ALERT TRACKING file related to the alert with an ID of XQAID for the user"
^DIC(9.4,3,22,21,"PAH",101,1,143,0)="specified by the internal entry number in XQAUSER.  The data is returned"
^DIC(9.4,3,22,21,"PAH",101,1,144,0)="descendent from the closed root passed in ROOT.  If ROOT is not"
^DIC(9.4,3,22,21,"PAH",101,1,145,0)="specified, the data is returned in the array XQALUSER.  The array is"
^DIC(9.4,3,22,21,"PAH",101,1,146,0)="subscripted by the field number, the value is returned as the internal"
^DIC(9.4,3,22,21,"PAH",101,1,147,0)="value (including NULL values) and, if the internal and external values"
^DIC(9.4,3,22,21,"PAH",101,1,148,0)="differ, followed by the external value separated by '^'.  If the field"
^DIC(9.4,3,22,21,"PAH",101,1,149,0)="names are desired they are also included as a second subscript to the"
^DIC(9.4,3,22,21,"PAH",101,1,150,0)="array (with a NULL value). If the alert is not present, the array root"
^DIC(9.4,3,22,21,"PAH",101,1,151,0)="is returned with a NULL value."
^DIC(9.4,3,22,21,"PAH",101,1,152,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,153,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,154,0)="Changes to Data Dictionaries:"
^DIC(9.4,3,22,21,"PAH",101,1,155,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,156,0)="ALERT File (8992)"
^DIC(9.4,3,22,21,"PAH",101,1,157,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,158,0)="Added field .02 (SURROGATE FOR ALERTS) Added field .03 (SURROGATE START"
^DIC(9.4,3,22,21,"PAH",101,1,159,0)="DATE/TIME) Added field .04 (SURROGATE END DATE/TIME)"
^DIC(9.4,3,22,21,"PAH",101,1,160,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,161,0)="ALERT DATE/TIME subfile (8992.01)"
^DIC(9.4,3,22,21,"PAH",101,1,162,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,163,0)="Added field .1 (CAN DELETE WITHOUT PROCESSING)"
^DIC(9.4,3,22,21,"PAH",101,1,164,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,165,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,166,0)="ALERT TRACKING file (8992.1)"
^DIC(9.4,3,22,21,"PAH",101,1,167,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,168,0)="RECIPIENT subfile (8992.11)"
^DIC(9.4,3,22,21,"PAH",101,1,169,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,170,0)="Added field .09 (DELETED BY USER)"
^DIC(9.4,3,22,21,"PAH",101,1,171,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,172,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,173,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,174,0)="Changes to Options:"
^DIC(9.4,3,22,21,"PAH",101,1,175,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,176,0)="Added 'XQALERT SURROGATE SET/REMOVE' as a new option. Added 'XQALERT"
^DIC(9.4,3,22,21,"PAH",101,1,177,0)="SURROGATE SET/REMOVE' as an item under the 'XQALERT MGR' option."
^DIC(9.4,3,22,21,"PAH",101,1,178,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,179,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,180,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",101,1,181,0)="================"
^DIC(9.4,3,22,21,"PAH",101,1,182,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,183,0)="The following routines are included in this patch.  The second"
^DIC(9.4,3,22,21,"PAH",101,1,184,0)="line of each of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",101,1,185,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,186,0)="<tab>;;8.0;KERNEL;[Patch List];Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",101,1,187,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,188,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,189,0)="Checksums:"
^DIC(9.4,3,22,21,"PAH",101,1,190,0)="=========="
^DIC(9.4,3,22,21,"PAH",101,1,191,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,192,0)="Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",101,1,193,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,194,0)="Rtn Nm      Chksum Before     Chksum After       Patch List"
^DIC(9.4,3,22,21,"PAH",101,1,195,0)="------      -------------     ------------       ----------"
^DIC(9.4,3,22,21,"PAH",101,1,196,0)="XQALBUTL          2035856          4732286       **114**"
^DIC(9.4,3,22,21,"PAH",101,1,197,0)="XQALDEL          12561210         14175555       **6,24,65,114**"
^DIC(9.4,3,22,21,"PAH",101,1,198,0)="XQALDOIT          9852030         10091815       **1,6,65,114**"
^DIC(9.4,3,22,21,"PAH",101,1,199,0)="XQALERT1         18178207         31077482       **20,65,114**"
^DIC(9.4,3,22,21,"PAH",101,1,200,0)="XQALFWD          10594990         10666938       **6,65,91,111,114**"
^DIC(9.4,3,22,21,"PAH",101,1,201,0)="XQALSET          12975662         14779633       **6,65,75,114**"
^DIC(9.4,3,22,21,"PAH",101,1,202,0)="XQALSURO              New          5607165       **114**"
^DIC(9.4,3,22,21,"PAH",101,1,203,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,204,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,205,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",101,1,206,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,207,0)="1.  DSM sites - Some of these routines may be mapped,"
^DIC(9.4,3,22,21,"PAH",101,1,208,0)="so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",101,1,209,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,210,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",101,1,211,0)="option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",101,1,212,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,213,0)="3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",101,1,214,0)="system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",101,1,215,0)="On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",101,1,216,0)="options:"
^DIC(9.4,3,22,21,"PAH",101,1,217,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,218,0)="Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",101,1,219,0)="Print Transport Global"
^DIC(9.4,3,22,21,"PAH",101,1,220,0)="Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",101,1,221,0)="Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",101,1,222,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,223,0)="4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",101,1,224,0)="non-peak time."
^DIC(9.4,3,22,21,"PAH",101,1,225,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,226,0)="This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",101,1,227,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,228,0)="5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",101,1,229,0)="option:"
^DIC(9.4,3,22,21,"PAH",101,1,230,0)="Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",101,1,231,0)="======="
^DIC(9.4,3,22,21,"PAH",101,1,232,0)="Install Package(s)"
^DIC(9.4,3,22,21,"PAH",101,1,233,0)="Select INSTALL NAME: XU*8.0*114"
^DIC(9.4,3,22,21,"PAH",101,1,234,0)="=========="
^DIC(9.4,3,22,21,"PAH",101,1,235,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,236,0)="No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",101,1,237,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",101,1,238,0)="=="
^DIC(9.4,3,22,21,"PAH",101,1,239,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,240,0)="6.  MSM-DOS Sites - Answer YES to the question 'Want to MOVE"
^DIC(9.4,3,22,21,"PAH",101,1,241,0)="routines to other CPUs?'. Enter the names of your Compute and"
^DIC(9.4,3,22,21,"PAH",101,1,242,0)="Print server(s)."
^DIC(9.4,3,22,21,"PAH",101,1,243,0)="AXP Sites - Answer NO to this question."
^DIC(9.4,3,22,21,"PAH",101,1,244,0)=" "
^DIC(9.4,3,22,21,"PAH",101,1,245,0)="7.  If the routines were unmapped as part of step 1, they should be"
^DIC(9.4,3,22,21,"PAH",101,1,246,0)="returned to the Mapped set once the installation has run to"
^DIC(9.4,3,22,21,"PAH",101,1,247,0)="completion."
^DIC(9.4,3,22,21,"PAH",102,0)="37 SEQ #107^2990626^1"
^DIC(9.4,3,22,21,"PAH",102,1,0)="^^52^52^2990626"
^DIC(9.4,3,22,21,"PAH",102,1,1,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,2,0)="     This patch fixes a couple of problems with menu templates: 1. The"
^DIC(9.4,3,22,21,"PAH",102,1,3,0)="selection of a numbered choice outside of the range of the actual list"
^DIC(9.4,3,22,21,"PAH",102,1,4,0)="could cause an <UNDEF> (DAY-0497-42420 and BYN-0297-10733); 2. Failure to"
^DIC(9.4,3,22,21,"PAH",102,1,5,0)="reenter the primary tree when backing up from a secondary tree"
^DIC(9.4,3,22,21,"PAH",102,1,6,0)="(DAY-1295-41818); and, the inability to skip an option in a template by"
^DIC(9.4,3,22,21,"PAH",102,1,7,0)="hitting a RETURN (FNC-1297-30868); and 3.Prevents the selection of a"
^DIC(9.4,3,22,21,"PAH",102,1,8,0)="broker-type option when creating a menu template."
^DIC(9.4,3,22,21,"PAH",102,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,10,0)="     **PLEASE NOTE**  THE SOFTWARE NOW DISPLAYS THE TEXT OF EACH OPTION IT"
^DIC(9.4,3,22,21,"PAH",102,1,11,0)="PROCESSES AS IT DOES SO.  YOUR USERS WILL, THEREFORE, NOTICE A CHANGE IN"
^DIC(9.4,3,22,21,"PAH",102,1,12,0)="BEHAVIOR AS MENU TEMPLATES RUN."
^DIC(9.4,3,22,21,"PAH",102,1,13,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,15,0)="     This patch contains 4 routines and 1 help frame."
^DIC(9.4,3,22,21,"PAH",102,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,17,0)="     Checksums were calculated by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",102,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,19,0)="Routine  Before       After           Patch List"
^DIC(9.4,3,22,21,"PAH",102,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,21,0)="XQT      14403654     14503760        **20,47,46,37**"
^DIC(9.4,3,22,21,"PAH",102,1,22,0)="XQT1     10829937     10816354        **59,37**"
^DIC(9.4,3,22,21,"PAH",102,1,23,0)="XQT2     12277933     14513265        **37**"
^DIC(9.4,3,22,21,"PAH",102,1,24,0)="XQT3     12864808     13422394        **46,37**"
^DIC(9.4,3,22,21,"PAH",102,1,25,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,28,0)="============================================================"
^DIC(9.4,3,22,21,"PAH",102,1,29,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",102,1,30,0)="  "
^DIC(9.4,3,22,21,"PAH",102,1,31,0)="1.  Users are allowed on the system, and this patch may be queued."
^DIC(9.4,3,22,21,"PAH",102,1,32,0)="    A ""clobber"" error may result if users are in these routines."
^DIC(9.4,3,22,21,"PAH",102,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,34,0)="2.  These routines is not usually mapped, so you shouldn't have to"
^DIC(9.4,3,22,21,"PAH",102,1,35,0)="    disable mapping."
^DIC(9.4,3,22,21,"PAH",102,1,36,0)="  "
^DIC(9.4,3,22,21,"PAH",102,1,37,0)="3.  Use the ""Install/Check Message"" option on the PackMan menu to "
^DIC(9.4,3,22,21,"PAH",102,1,38,0)="    load the package."
^DIC(9.4,3,22,21,"PAH",102,1,39,0)="  "
^DIC(9.4,3,22,21,"PAH",102,1,40,0)="4.  On the KIDS menu use the following options:"
^DIC(9.4,3,22,21,"PAH",102,1,41,0)="  "
^DIC(9.4,3,22,21,"PAH",102,1,42,0)="     Veryify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",102,1,43,0)="     Print Transport Global (Optional)"
^DIC(9.4,3,22,21,"PAH",102,1,44,0)="     Compare Trasport Global to Current System"
^DIC(9.4,3,22,21,"PAH",102,1,45,0)="     Backup transport Globa"
^DIC(9.4,3,22,21,"PAH",102,1,46,0)="     Install XU*8.0*37"
^DIC(9.4,3,22,21,"PAH",102,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",102,1,48,0)="  "
^DIC(9.4,3,22,21,"PAH",102,1,49,0)="5.  MSM sites answer 'YES' to the question: ""Want to MOVE routines "
^DIC(9.4,3,22,21,"PAH",102,1,50,0)="    to other CPUs?""   AXP sites answer 'NO'."
^DIC(9.4,3,22,21,"PAH",102,1,51,0)="  "
^DIC(9.4,3,22,21,"PAH",102,1,52,0)="6.  Rebuild mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",103,0)="108 SEQ #108^2990719^1"
^DIC(9.4,3,22,21,"PAH",103,1,0)="^^90^90^2990719"
^DIC(9.4,3,22,21,"PAH",103,1,1,0)="This patch fixes one NOIS, one E3R, and several requested fixes for CPRS."
^DIC(9.4,3,22,21,"PAH",103,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",103,1,3,0)="ISL-0299-51863         Increase the size of the ""load file"" string."
^DIC(9.4,3,22,21,"PAH",103,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",103,1,5,0)="E3R # 12059            Send Mail Message to local group."
^DIC(9.4,3,22,21,"PAH",103,1,6,0)="                       The mail group is defined in the Package file and is"
^DIC(9.4,3,22,21,"PAH",103,1,7,0)="                       new with patch XU*8*117."
^DIC(9.4,3,22,21,"PAH",103,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",103,1,9,0)="CPRS                 - Allow utilities to work on all components included"
^DIC(9.4,3,22,21,"PAH",103,1,10,0)="                       in a master build."
^DIC(9.4,3,22,21,"PAH",103,1,11,0)="                     - Allow run routines for master builds.                "
^DIC(9.4,3,22,21,"PAH",103,1,12,0)="                     - Allow install to ""inhibit login"" for the install"
^DIC(9.4,3,22,21,"PAH",103,1,13,0)="                       duration."
^DIC(9.4,3,22,21,"PAH",103,1,14,0)="                     - Fix an erroneous message when exporting data without "
^DIC(9.4,3,22,21,"PAH",103,1,15,0)="                       the DD."
^DIC(9.4,3,22,21,"PAH",103,1,16,0)="                     - Delete one-time run routines after install."
^DIC(9.4,3,22,21,"PAH",103,1,17,0)="                       Development sites can override this by setting"
^DIC(9.4,3,22,21,"PAH",103,1,18,0)="                       the KERNEL PARAMETERS file with ""XPD NO_EPP_DELETE"""
^DIC(9.4,3,22,21,"PAH",103,1,19,0)="                       with a value of 1."
^DIC(9.4,3,22,21,"PAH",103,1,20,0)="                     - Update the ""Date Distributed"" field in the build"
^DIC(9.4,3,22,21,"PAH",103,1,21,0)="                       and transport to the install and include in tracking"
^DIC(9.4,3,22,21,"PAH",103,1,22,0)="                       message.  This will help track test versions installed."
^DIC(9.4,3,22,21,"PAH",103,1,23,0)="                       "
^DIC(9.4,3,22,21,"PAH",103,1,24,0)=" "
^DIC(9.4,3,22,21,"PAH",103,1,25,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",103,1,26,0)="The following routines are included in this patch.  The second line of each"
