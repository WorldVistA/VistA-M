^DIC(9.4,197,22,1,"PAH",32,1,1,0)="CLINICAL PROCEDURES TERMINOLOGY FILE UPDATES"
^DIC(9.4,197,22,1,"PAH",33,0)="49 SEQ #34^3170530.160647^54"
^DIC(9.4,197,22,1,"PAH",33,1,0)="^^4^4^3170530"
^DIC(9.4,197,22,1,"PAH",33,1,1,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,197,22,1,"PAH",33,1,2,0)="(2FA) compliant the Clinical Procedures (CP User) Graphical"
^DIC(9.4,197,22,1,"PAH",33,1,3,0)="User Interface (GUI) requires an upgrade to Delphi version XE8 in order to"
^DIC(9.4,197,22,1,"PAH",33,1,4,0)="implement the new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,197,22,1,"PAH",34,0)="50 SEQ #35^3170530.160716^54"
^DIC(9.4,197,22,1,"PAH",34,1,0)="^^4^4^3170530"
^DIC(9.4,197,22,1,"PAH",34,1,1,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,197,22,1,"PAH",34,1,2,0)="(2FA) compliant the Clinical Procedures (CP Hemodialysis) Graphical"
^DIC(9.4,197,22,1,"PAH",34,1,3,0)="User Interface (GUI) requires an upgrade to Delphi version XE8 in order to"
^DIC(9.4,197,22,1,"PAH",34,1,4,0)="implement the new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,197,22,1,"PAH",35,0)="51 SEQ #36^3170530.160737^54"
^DIC(9.4,197,22,1,"PAH",35,1,0)="^^6^6^3170530"
^DIC(9.4,197,22,1,"PAH",35,1,1,0)="This patch addresses one Clinical Procedures issue:"
^DIC(9.4,197,22,1,"PAH",35,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",35,1,3,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,197,22,1,"PAH",35,1,4,0)="(2FA) compliant the Clinical Procedures (CP Flowsheet) Graphical"
^DIC(9.4,197,22,1,"PAH",35,1,5,0)="User Interface (GUI) requires an upgrade to Delphi version XE8 in order to"
^DIC(9.4,197,22,1,"PAH",35,1,6,0)="implement the new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,197,22,1,"PAH",36,0)="52 SEQ #37^3170530.160757^54"
^DIC(9.4,197,22,1,"PAH",36,1,0)="^^6^6^3170530"
^DIC(9.4,197,22,1,"PAH",36,1,1,0)="This patch addresses one Clinical Procedures issue:"
^DIC(9.4,197,22,1,"PAH",36,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",36,1,3,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,197,22,1,"PAH",36,1,4,0)="(2FA) compliant the Clinical Procedures (CP Console) Graphical"
^DIC(9.4,197,22,1,"PAH",36,1,5,0)="User Interface (GUI) requires an upgrade to Delphi version XE8 in order to"
^DIC(9.4,197,22,1,"PAH",36,1,6,0)="implement the new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,197,22,1,"PAH",37,0)="47 SEQ #38^3170627.153415^54"
^DIC(9.4,197,22,1,"PAH",37,1,0)="^^1^1^3170627"
^DIC(9.4,197,22,1,"PAH",37,1,1,0)="MODIFICATIONS TO UTILIZE IMMUN FILE GROUP DATA"
^DIC(9.4,197,22,1,"PAH",38,0)="53 SEQ #39^3170803.132552^54"
^DIC(9.4,197,22,1,"PAH",38,1,0)="^^2^2^3170803"
^DIC(9.4,197,22,1,"PAH",38,1,1,0)=" "
^DIC(9.4,197,22,1,"PAH",38,1,2,0)="CP TERMINOLOGY CORRECTIONS FOR PATCH MD*1*39"
^DIC(9.4,197,22,1,"PAH",39,0)="56 SEQ #40^3180302.152813^54"
^DIC(9.4,197,22,1,"PAH",39,1,0)="^^9^9^3180302"
^DIC(9.4,197,22,1,"PAH",39,1,1,0)="This patch fixes a defect in CP Hemodialysis. "
^DIC(9.4,197,22,1,"PAH",39,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",39,1,3,0)="1. I15834349FY17 - LOM - Function missing in HEMODIALYSIS"
^DIC(9.4,197,22,1,"PAH",39,1,4,0)="In CP Hemodialysis, the patient selection grid lost the "
^DIC(9.4,197,22,1,"PAH",39,1,5,0)="ability to sort the included information after the"
^DIC(9.4,197,22,1,"PAH",39,1,6,0)="previous patch. "
^DIC(9.4,197,22,1,"PAH",39,1,7,0)=" "
^DIC(9.4,197,22,1,"PAH",39,1,8,0)="NOTE: Patch MD*1*56 includes a new GUI executable for CP   "
^DIC(9.4,197,22,1,"PAH",39,1,9,0)="Hemodialysis ."
^DIC(9.4,197,22,1,"PAH",40,0)="48 SEQ #41^3180403.15514^54"
^DIC(9.4,197,22,1,"PAH",40,1,0)="^^1^1^3180403"
^DIC(9.4,197,22,1,"PAH",40,1,1,0)="CP FLOWSHEET TERMINOLOGY ADD/MODIFY TERMS"
^DIC(9.4,197,22,1,"PAH",41,0)="58 SEQ #42^3180403.173458^54"
^DIC(9.4,197,22,1,"PAH",42,0)="61 SEQ #43^3180706.152243^54"
^DIC(9.4,197,22,1,"PAH",43,0)="59 SEQ #44^3180907.12091^54"
^DIC(9.4,197,22,1,"PAH",43,1,0)="^^1^1^3180907"
^DIC(9.4,197,22,1,"PAH",43,1,1,0)="CLINICAL PROCEDURES FLOWSHEET TERMINOLOGY UPDATES"
^DIC(9.4,197,22,1,"PAH",44,0)="43 SEQ #45^3181203.181315^54"
^DIC(9.4,197,22,1,"PAH",44,1,0)="^^4^4^3181203"
^DIC(9.4,197,22,1,"PAH",44,1,1,0)="The purpose of this patch is to provide a software bug fix for Clinical "
^DIC(9.4,197,22,1,"PAH",44,1,2,0)="Procedures functionality.  This patch addresses the following issues:"
^DIC(9.4,197,22,1,"PAH",44,1,3,0)=" "
^DIC(9.4,197,22,1,"PAH",44,1,4,0)="-Duplicate reports with the same time stamp"
^DIC(9.4,197,22,1,"PAH",45,0)="54 SEQ #46^3181204.154316^54"
^DIC(9.4,197,22,1,"PAH",45,1,0)="^^12^12^3181204"
^DIC(9.4,197,22,1,"PAH",45,1,1,0)="This patch addresses four (4) issues:"
^DIC(9.4,197,22,1,"PAH",45,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",45,1,3,0)="1.  A cancelation message is not being sent to the instrument "
^DIC(9.4,197,22,1,"PAH",45,1,4,0)="    when an order is canceled or discontinued through CPRS."
^DIC(9.4,197,22,1,"PAH",45,1,5,0)=" "
^DIC(9.4,197,22,1,"PAH",45,1,6,0)="2.  TIU Note Title of Procedures edited in CP Console (GUI) are being"
^DIC(9.4,197,22,1,"PAH",45,1,7,0)="    lost."
^DIC(9.4,197,22,1,"PAH",45,1,8,0)=" "
^DIC(9.4,197,22,1,"PAH",45,1,9,0)="3.  Attempting to import in CP Console (GUI) results in an error. "
^DIC(9.4,197,22,1,"PAH",45,1,10,0)=" "
^DIC(9.4,197,22,1,"PAH",45,1,11,0)="4.  A follow up CP order placed the same day as a scheduled CP order"
^DIC(9.4,197,22,1,"PAH",45,1,12,0)="    will check in with out it being scheduled."
^DIC(9.4,197,22,1,"PAH",46,0)="60 SEQ #47^3190103.165432^54"
^DIC(9.4,197,22,1,"PAH",46,1,0)="^^15^15^3190103"
^DIC(9.4,197,22,1,"PAH",46,1,1,0)="Clinical Procedures and DICOM Consult Request Tracking."
^DIC(9.4,197,22,1,"PAH",46,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",46,1,3,0)="This patch and MAG*3.0*208 work together to greatly imnprove "
^DIC(9.4,197,22,1,"PAH",46,1,4,0)="interoperability between Clinical Procedures and Vist Imaging"
^DIC(9.4,197,22,1,"PAH",46,1,5,0)="CPRS Consult Request Tracking DICOM."
^DIC(9.4,197,22,1,"PAH",46,1,6,0)=" "
^DIC(9.4,197,22,1,"PAH",46,1,7,0)="The CP studies have the same Instrument Order Number as the"
^DIC(9.4,197,22,1,"PAH",46,1,8,0)="regular consult and procedure Accession Number (sss-GMR-nnnnnnnn)."
^DIC(9.4,197,22,1,"PAH",46,1,9,0)=" "
^DIC(9.4,197,22,1,"PAH",46,1,10,0)="This allows DICOM objects created during a CP examination to be sent"
^DIC(9.4,197,22,1,"PAH",46,1,11,0)="to VistA Imaging and be processed automatically.  It also allows them"
^DIC(9.4,197,22,1,"PAH",46,1,12,0)="to be used with all of the other DICOM services, like query/retrieve"
^DIC(9.4,197,22,1,"PAH",46,1,13,0)="and export."
^DIC(9.4,197,22,1,"PAH",46,1,14,0)=" "
^DIC(9.4,197,22,1,"PAH",46,1,15,0)="Reports in DICOM Encapsulated PDF are highly recommended."
^DIC(9.4,197,22,1,"PAH",47,0)="65 SEQ #48^3190103.17301^54"
^DIC(9.4,197,22,1,"PAH",47,1,0)="^^5^5^3190103"
^DIC(9.4,197,22,1,"PAH",47,1,1,0)="High Volume Procedure Setup modifications to allow setting of the "
^DIC(9.4,197,22,1,"PAH",47,1,2,0)="associated note title's two technical fields - COMMIT ACTION and "
^DIC(9.4,197,22,1,"PAH",47,1,3,0)="POST-SIGNATURE CODE."
^DIC(9.4,197,22,1,"PAH",47,1,4,0)=" "
^DIC(9.4,197,22,1,"PAH",47,1,5,0)="Consult / Procedure to Clinical Procedure conversion utilities."
^DIC(9.4,197,22,1,"PAH",48,0)="64 SEQ #49^3190301.140623^54"
^DIC(9.4,197,22,1,"PAH",48,1,0)="^^1^1^3190301"
^DIC(9.4,197,22,1,"PAH",48,1,1,0)="CP CONSOLE NETWORK HELP FILE"
^DIC(9.4,197,22,1,"PAH",49,0)="66 SEQ #50^3190402.14212^54"
^DIC(9.4,197,22,1,"PAH",50,0)="62 SEQ #51^3190501.160138^54"
^DIC(9.4,197,22,1,"PAH",50,1,0)="^^1^1^3190501"
^DIC(9.4,197,22,1,"PAH",50,1,1,0)="CP USER UPDATE FOR WINDOWS 10, NEW DELPHI AND NETWORK HELP FILE."
^DIC(9.4,197,22,1,"PAH",51,0)="63 SEQ #52^3190501.164617^54"
^DIC(9.4,197,22,1,"PAH",51,1,0)="^^1^1^3190501"
^DIC(9.4,197,22,1,"PAH",51,1,1,0)="CP FLOWSHEETS WINDOWS 10 HELP FILE"
^DIC(9.4,197,22,1,"PAH",52,0)="69 SEQ #53^3190708.165157^65"
^DIC(9.4,197,22,1,"PAH",52,1,0)="^^3^3^3190708"
^DIC(9.4,197,22,1,"PAH",52,1,1,0)="This patch will address the issues in the following tickets:"
^DIC(9.4,197,22,1,"PAH",52,1,2,0)="INC3431411, INC3430523, INC3525351, INC3559705"
^DIC(9.4,197,22,1,"PAH",52,1,3,0)="Hemodialysis CPs are failing to auto check-in after the first day."
^DIC(9.4,197,22,1,"PAH",53,0)="67^3190722.171056^65"
^DIC(9.4,197,22,1,"PAH",53,1,0)="^^2^2^3190722"
^DIC(9.4,197,22,1,"PAH",53,1,1,0)="MD*1.0*67 - Please refer to the patch description in Forum for "
^DIC(9.4,197,22,1,"PAH",53,1,2,0)="installation instructions."
^DIC(9.4,197,22,1,"PAH",54,0)="68 SEQ #55^3190812.15135^65"
^DIC(9.4,197,22,1,"PAH",54,1,0)="^^1^1^3190812"
^DIC(9.4,197,22,1,"PAH",54,1,1,0)="CP FLOWSHEETS TERMINOLOGY UPDATES"
^DIC(9.4,197,22,1,"PAH",55,0)="70 SEQ #56^3190827.085133^65"
^DIC(9.4,197,22,1,"PAH",55,1,0)="^^8^8^3190827"
^DIC(9.4,197,22,1,"PAH",55,1,1,0)="MD*1*70 - CP HEMO DEFAULT DATE 12-30-1899"
^DIC(9.4,197,22,1,"PAH",55,1,2,0)="This patch will resolve the following issue in the Clinical Procedures"
^DIC(9.4,197,22,1,"PAH",55,1,3,0)="package:"
^DIC(9.4,197,22,1,"PAH",55,1,4,0)=" "
^DIC(9.4,197,22,1,"PAH",55,1,5,0)="The default value for Diagnosis date and Initial Therapy date is set to "
^DIC(9.4,197,22,1,"PAH",55,1,6,0)="the arbitrarily value of 12-30-1899. Initial analysis showed that the "
^DIC(9.4,197,22,1,"PAH",55,1,7,0)="code was looking for that specific date to replace it with a null entry, "
^DIC(9.4,197,22,1,"PAH",55,1,8,0)="but this code was being bypassed incorrectly"
^DIC(9.4,197,22,1,"PAH",56,0)="73 SEQ #57^3191113.14253^65"
^DIC(9.4,197,22,1,"PAH",56,1,0)="^^1^1^3191113"
^DIC(9.4,197,22,1,"PAH",56,1,1,0)="ELIMINATE ALERTS FOR RETRACTED NOTES AND MODS TO HIGH VOLUME SETUP"
^DIC(9.4,197,22,1,"PAH",57,0)="71 SEQ #58^3200115.121943^65"
^DIC(9.4,197,22,1,"PAH",58,0)="75 SEQ #59^3200115.122153^65"
^DIC(9.4,197,22,1,"PAH",58,1,0)="^^10^10^3200115"
^DIC(9.4,197,22,1,"PAH",58,1,1,0)="MD*1.0*75 - CP HEMODIALISIS DEFAULT DATE 12-30-1899 IN TIU DOCUMENTS"
^DIC(9.4,197,22,1,"PAH",58,1,2,0)="This patch will resolve the following issue in the Clinical Procedures"
^DIC(9.4,197,22,1,"PAH",58,1,3,0)="package:"
^DIC(9.4,197,22,1,"PAH",58,1,4,0)="On the current Treatment Status Report Screen Diagnosis Date and Initial "
^DIC(9.4,197,22,1,"PAH",58,1,5,0)="Therapy Date is blank it looks like the TIU Document Details section is "
^DIC(9.4,197,22,1,"PAH",58,1,6,0)="still populated with 12/30/1899."
^DIC(9.4,197,22,1,"PAH",58,1,7,0)="CODE MODIFIED TO: CP APP-HEMODIALYSIS select Patient and view Submit tab"
^DIC(9.4,197,22,1,"PAH",58,1,8,0)="screen that shows in Document Details section that Diagnosis Date and"
^DIC(9.4,197,22,1,"PAH",58,1,9,0)="Initial Therapy Date "
^DIC(9.4,197,22,1,"PAH",58,1,10,0)="as <blank>"
^DIC(9.4,197,22,1,"PAH",59,0)="76 SEQ #60^3200623.181533^65"
^DIC(9.4,197,22,1,"PAH",59,1,0)="^^6^6^3200623"
^DIC(9.4,197,22,1,"PAH",59,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,197,22,1,"PAH",59,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",59,1,3,0)="INC7452263 - In the CP Console, where the views for the CP flowsheets "
^DIC(9.4,197,22,1,"PAH",59,1,4,0)="are built if you save and move to another patient too quickly. This new"
^DIC(9.4,197,22,1,"PAH",59,1,5,0)="patient will receive the previous patients record temporarily confusing "
^DIC(9.4,197,22,1,"PAH",59,1,6,0)="the user."
^DIC(9.4,197,22,1,"PAH",60,0)="72 SEQ #61^3200624.152514^65"
^DIC(9.4,197,22,1,"PAH",60,1,0)="^^1^1^3200624"
^DIC(9.4,197,22,1,"PAH",60,1,1,0)="CLINICAL PROCEDURES FLOWSHEET TERMINOLOGY UPDATE"
^DIC(9.4,197,22,1,"PAH",61,0)="78 SEQ #62^3200923.160923^65"
^DIC(9.4,197,22,1,"PAH",61,1,0)="^^1^1^3200923"
^DIC(9.4,197,22,1,"PAH",61,1,1,0)="AUTO CHECK-IN ISSUES WITH MUSE PROCEDURES"
^DIC(9.4,197,22,1,"PAH",62,0)="80 SEQ #64^3220111.165725^17"
^DIC(9.4,197,22,1,"PAH",62,1,0)="^^5^5^3220111"
^DIC(9.4,197,22,1,"PAH",62,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,197,22,1,"PAH",62,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",62,1,3,0)="Encounters for procedures that are read and completed in the MUSE system "
^DIC(9.4,197,22,1,"PAH",62,1,4,0)="are not crossing over correctly which causes the encounters to remain"
^DIC(9.4,197,22,1,"PAH",62,1,5,0)="open."
^DIC(9.4,197,22,1,"PAH",63,0)="82 SEQ #65^3230523.105812^89"
^DIC(9.4,197,22,1,"PAH",64,0)="84 SEQ #66^3231122.115015^89"
^DIC(9.4,197,22,1,"PAH",65,0)="83 SEQ #67^3231215.145028^89"
^DIC(9.4,197,22,1,"PAH",66,0)="86 SEQ #68^3240417.114838^89"
^DIC(9.4,197,22,1,"PAH",66,1,0)="^^1^1^3240417"
^DIC(9.4,197,22,1,"PAH",66,1,1,0)="CP CONSOLE NETWORK HELP FILE"
^DIC(9.4,197,22,1,"PAH",67,0)="85 SEQ #69^3240702.11394^89"
^DIC(9.4,197,22,1,"PAH",68,0)="87 SEQ #70^3240726.104109^89"
^DIC(9.4,197,22,1,"PAH",69,0)="89 SEQ #71^3240903.103112^89"
^DIC(9.4,197,22,1,"PAH",69,1,0)="^^3^3^3240903"
^DIC(9.4,197,22,1,"PAH",69,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,197,22,1,"PAH",69,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",69,1,3,0)="INC31290396 - Consult to Procedures Conversion Utility Issue"
^DIC(9.4,197,22,1,"PAH",70,0)="88 SEQ #72^3250110.122819^89"
^DIC(9.4,197,22,1,"PAH",70,1,0)="^^2^2^3250110"
