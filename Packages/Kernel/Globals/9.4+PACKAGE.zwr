^DIC(9.4,4,22,1,"PAH",73,0)="101 SEQ #98^2991104^1"
^DIC(9.4,4,22,1,"PAH",73,1,0)="^^73^73^2991104"
^DIC(9.4,4,22,1,"PAH",73,1,1,0)="Patch XM*7.1*101"
^DIC(9.4,4,22,1,"PAH",73,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,3,0)="NOIS:  AMA-1099-70251"
^DIC(9.4,4,22,1,"PAH",73,1,4,0)="Test Site:  Amarillo, TX"
^DIC(9.4,4,22,1,"PAH",73,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,6,0)="Allow users to have a server option (S.xxx) as a forwarding address."
^DIC(9.4,4,22,1,"PAH",73,1,7,0)="(Users may have remote addresses, as well as local devices and servers"
^DIC(9.4,4,22,1,"PAH",73,1,8,0)="as forwarding addresses.)"
^DIC(9.4,4,22,1,"PAH",73,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,10,0)="Allow forwarding of messages from remote postmasters if the forwarding"
^DIC(9.4,4,22,1,"PAH",73,1,11,0)="address is local.  (To avoid looping error messages, messages from remote"
^DIC(9.4,4,22,1,"PAH",73,1,12,0)="postmasters are not forwarded to remote addresses.)"
^DIC(9.4,4,22,1,"PAH",73,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,14,0)="FYI:"
^DIC(9.4,4,22,1,"PAH",73,1,15,0)="If a fictitious user is a member of a mail group, and the sole purpose of"
^DIC(9.4,4,22,1,"PAH",73,1,16,0)="that fictitious user is to have a forwarding address of a device,"
^DIC(9.4,4,22,1,"PAH",73,1,17,0)="the preferred method is to put the device directly in the mail group (in"
^DIC(9.4,4,22,1,"PAH",73,1,18,0)="the remote member multiple) and get rid of the fictitious user."
^DIC(9.4,4,22,1,"PAH",73,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,20,0)="NOIS:  DAY-1099-41161"
^DIC(9.4,4,22,1,"PAH",73,1,21,0)="Test Site:  Dayton, OH"
^DIC(9.4,4,22,1,"PAH",73,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,23,0)="When minusing a user during message addressing, MailMan should limit the"
^DIC(9.4,4,22,1,"PAH",73,1,24,0)="choices to the current addressees, as it did before patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",73,1,25,0)="This patch restores that functionality."
^DIC(9.4,4,22,1,"PAH",73,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,27,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",73,1,28,0)="minimum.  It requires MailMan patch XM*7.1*96."
^DIC(9.4,4,22,1,"PAH",73,1,29,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",73,1,30,0)=""
^DIC(9.4,4,22,1,"PAH",73,1,31,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",73,1,32,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",73,1,33,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",73,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",73,1,35,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",73,1,36,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",73,1,37,0)="--------------------------------------------------------------"
