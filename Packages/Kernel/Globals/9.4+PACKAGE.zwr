^DIC(9.4,33,22,1.4,"PAH",27,1,46,0)="  5.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",28,0)="44 SEQ #41^2990602^1"
^DIC(9.4,33,22,1.4,"PAH",28,1,0)="^^50^50^2990602"
^DIC(9.4,33,22,1.4,"PAH",28,1,1,0)="This patch solves the following problem:"
^DIC(9.4,33,22,1.4,"PAH",28,1,2,0)="  To prevent an ""undefined variable HLDP"" error for the X3.28 lower level"
^DIC(9.4,33,22,1.4,"PAH",28,1,3,0)="  protocol. This error occurs when starting the LLP, it fails to establish"
^DIC(9.4,33,22,1.4,"PAH",28,1,4,0)="  a connection and autostart is enabled."
^DIC(9.4,33,22,1.4,"PAH",28,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,6,0)=" Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",28,1,7,0)=" ================"
^DIC(9.4,33,22,1.4,"PAH",28,1,8,0)=" The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",28,1,9,0)=" second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",28,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,11,0)="      <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",28,1,12,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,14,0)=" Checksums:"
^DIC(9.4,33,22,1.4,"PAH",28,1,15,0)=" =========="
^DIC(9.4,33,22,1.4,"PAH",28,1,16,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,17,0)="     Routine Name     Checksum Before     Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",28,1,18,0)="     ------------     ---------------     --------------      ------------"
^DIC(9.4,33,22,1.4,"PAH",28,1,19,0)="       HLCSDL             4175013            4198429             2,44"
^DIC(9.4,33,22,1.4,"PAH",28,1,20,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,21,0)="     From CHECK^XTSUMBLD "
^DIC(9.4,33,22,1.4,"PAH",28,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,23,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,24,0)=" Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",28,1,25,0)=" =========================="
^DIC(9.4,33,22,1.4,"PAH",28,1,26,0)="   1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",28,1,27,0)="   2.  Use the HL7 ""Stop LLP"" to stop the LLPs, which are executed in"
^DIC(9.4,33,22,1.4,"PAH",28,1,28,0)="       X3.28 protocol."
^DIC(9.4,33,22,1.4,"PAH",28,1,29,0)="   3.  DSM SITES: Review your mapped set.  If any of the routines listed"
^DIC(9.4,33,22,1.4,"PAH",28,1,30,0)="       in the Routine Summary section are mapped, they should be removed"
^DIC(9.4,33,22,1.4,"PAH",28,1,31,0)="       from the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",28,1,32,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",28,1,33,0)="       option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",28,1,34,0)="   5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",28,1,35,0)="       system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",28,1,36,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",28,1,37,0)="       options:"
^DIC(9.4,33,22,1.4,"PAH",28,1,38,0)=" "
^DIC(9.4,33,22,1.4,"PAH",28,1,39,0)="          Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",28,1,40,0)="          Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",28,1,41,0)="          Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",28,1,42,0)="          Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",28,1,43,0)="          Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",28,1,44,0)="          INSTALL NAME: HL*1.6*44"
^DIC(9.4,33,22,1.4,"PAH",28,1,45,0)="                        ========="
^DIC(9.4,33,22,1.4,"PAH",28,1,46,0)="          Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",28,1,47,0)="          and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",28,1,48,0)="   6.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",28,1,49,0)="   7.  Restart the LLPs by using the HL7 ""Start LLP"" option, which have"
^DIC(9.4,33,22,1.4,"PAH",28,1,50,0)="       been stopped in step #2."
^DIC(9.4,33,22,1.4,"PAH",29,0)="55 SEQ #42^2990719^1"
^DIC(9.4,33,22,1.4,"PAH",29,1,0)="^^53^53^2990719"
^DIC(9.4,33,22,1.4,"PAH",29,1,1,0)="This patch corrects the problem identified in NOIS IVM-0499-31407,"
^DIC(9.4,33,22,1.4,"PAH",29,1,2,0)="message IDs no longer created for version 1.5 messages."
^DIC(9.4,33,22,1.4,"PAH",29,1,3,0)=""
^DIC(9.4,33,22,1.4,"PAH",29,1,4,0)=""
^DIC(9.4,33,22,1.4,"PAH",29,1,5,0)="Routine Modifications:"
^DIC(9.4,33,22,1.4,"PAH",29,1,6,0)="======================"
^DIC(9.4,33,22,1.4,"PAH",29,1,7,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,33,22,1.4,"PAH",29,1,8,0)="these routines now look like:"
^DIC(9.4,33,22,1.4,"PAH",29,1,9,0)="  "
^DIC(9.4,33,22,1.4,"PAH",29,1,10,0)=" ;;1.6;HEALTH LEVEL SEVEN;<patchlist>;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",29,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,12,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,33,22,1.4,"PAH",29,1,13,0)="   "
^DIC(9.4,33,22,1.4,"PAH",29,1,14,0)=" Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,33,22,1.4,"PAH",29,1,15,0)=" ============   ============    ===========     =========="
^DIC(9.4,33,22,1.4,"PAH",29,1,16,0)=" HLTF             7284127        7261750        1,19,43,55"
^DIC(9.4,33,22,1.4,"PAH",29,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,18,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,19,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",29,1,20,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",29,1,21,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",29,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,23,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",29,1,24,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",29,1,25,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",29,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,27,0)="  3.  Shutdown all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",29,1,28,0)="      'Shut Down All Logical Links', 'Stop all incoming filers', and 'Stop"
^DIC(9.4,33,22,1.4,"PAH",29,1,29,0)="      all outgoing filers' options."
^DIC(9.4,33,22,1.4,"PAH",29,1,30,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,31,0)="  4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",29,1,32,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",29,1,33,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,34,0)="  5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",29,1,35,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",29,1,36,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",29,1,37,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",29,1,38,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,39,0)="         2 Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",29,1,40,0)="         3 Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",29,1,41,0)="         4 Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",29,1,42,0)="         5 Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",29,1,43,0)="         6 Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",29,1,44,0)="             INSTALL NAME: HL*1.6*55"
^DIC(9.4,33,22,1.4,"PAH",29,1,45,0)="                           ========="
^DIC(9.4,33,22,1.4,"PAH",29,1,46,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",29,1,47,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",29,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,49,0)="  6.  Startup all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",29,1,50,0)="      'Restart All Links and Filers' option."
^DIC(9.4,33,22,1.4,"PAH",29,1,51,0)=" "
^DIC(9.4,33,22,1.4,"PAH",29,1,52,0)="  7.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",29,1,53,0)=""
^DIC(9.4,33,22,1.4,"PAH",30,0)="50 SEQ #43^2990719^1"
^DIC(9.4,33,22,1.4,"PAH",30,1,0)="^^102^102^2990719"
^DIC(9.4,33,22,1.4,"PAH",30,1,1,0)="Description:"
^DIC(9.4,33,22,1.4,"PAH",30,1,2,0)="============"
^DIC(9.4,33,22,1.4,"PAH",30,1,3,0)="This patch requires running the purge message option and shutting down"
^DIC(9.4,33,22,1.4,"PAH",30,1,4,0)="all links and filers before installing the patch."
^DIC(9.4,33,22,1.4,"PAH",30,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,6,0)="This patch provides both additional functionality and NOIS fixes."
^DIC(9.4,33,22,1.4,"PAH",30,1,7,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,8,0)="First, it provides fixes for the following NOISes:  BAC-0599-40603 and "
^DIC(9.4,33,22,1.4,"PAH",30,1,9,0)="IND-0599-40402. One NOIS reported, in some cases, a failure to display "
^DIC(9.4,33,22,1.4,"PAH",30,1,10,0)="the message text after selecting an individual record from the list. "
^DIC(9.4,33,22,1.4,"PAH",30,1,11,0)="The other NOIS reported the routine HLCSRPT errorred out with an "
^DIC(9.4,33,22,1.4,"PAH",30,1,12,0)="undefined variable message in some circumstances. "
^DIC(9.4,33,22,1.4,"PAH",30,1,13,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,14,0)="Second, additional functionality is provided as follows:"
^DIC(9.4,33,22,1.4,"PAH",30,1,15,0)="Refined message searchs. The messages search is now expanded to allow"
^DIC(9.4,33,22,1.4,"PAH",30,1,16,0)="the user to select a message search based any combination (or all) of"
^DIC(9.4,33,22,1.4,"PAH",30,1,17,0)="the search fields. They include status code, message type, event type"
^DIC(9.4,33,22,1.4,"PAH",30,1,18,0)="and logical link. The default entry for each field is ""ALL"". As before,"
^DIC(9.4,33,22,1.4,"PAH",30,1,19,0)="all message searching will be limited to a user entered start date/time."
^DIC(9.4,33,22,1.4,"PAH",30,1,20,0)="The single criteria message searching is replaced with this enhanced "
^DIC(9.4,33,22,1.4,"PAH",30,1,21,0)="searching capability. "
^DIC(9.4,33,22,1.4,"PAH",30,1,22,0)="Pending messages. The option for pending messages has not changed."
^DIC(9.4,33,22,1.4,"PAH",30,1,23,0)="Error listing. An option providing for the display of messages that"
^DIC(9.4,33,22,1.4,"PAH",30,1,24,0)="are in an error status is added. The default is all errorred messages,"
^DIC(9.4,33,22,1.4,"PAH",30,1,25,0)="but the user may select a specific error code."
^DIC(9.4,33,22,1.4,"PAH",30,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,27,0)="This patch also contains the DD for file 773, Message Administration"
^DIC(9.4,33,22,1.4,"PAH",30,1,28,0)="File. It adds a new cross-reference, ""AG"", which pertains to the"
^DIC(9.4,33,22,1.4,"PAH",30,1,29,0)="Status field. A Post-Install routine is run to set the cross-reference."
^DIC(9.4,33,22,1.4,"PAH",30,1,30,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,31,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",30,1,32,0)="================"
^DIC(9.4,33,22,1.4,"PAH",30,1,33,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,33,22,1.4,"PAH",30,1,34,0)="each"
^DIC(9.4,33,22,1.4,"PAH",30,1,35,0)="of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",30,1,36,0)=" ;;1.6;HEALTH LEVEL SEVEN;<patchlist>;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",30,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,38,0)="                 Checksum"
^DIC(9.4,33,22,1.4,"PAH",30,1,39,0)="Routine           Old       New        2nd Line"
^DIC(9.4,33,22,1.4,"PAH",30,1,40,0)="HLCSRPT         14324083  10630512     **19,50**"
^DIC(9.4,33,22,1.4,"PAH",30,1,41,0)="HLCSRPT1         9680356  13849369     **19,50**"
^DIC(9.4,33,22,1.4,"PAH",30,1,42,0)="HLCSRPT2          NEW     18087507     **50**"
^DIC(9.4,33,22,1.4,"PAH",30,1,43,0)="HLCSRPT3          NEW     10792707     **50**"
^DIC(9.4,33,22,1.4,"PAH",30,1,44,0)="HLP50PST          NEW        36805     **50**"
^DIC(9.4,33,22,1.4,"PAH",30,1,45,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,46,0)="List of preceding patches: 19"
^DIC(9.4,33,22,1.4,"PAH",30,1,47,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,33,22,1.4,"PAH",30,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,49,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",30,1,50,0)="==========================    "
^DIC(9.4,33,22,1.4,"PAH",30,1,51,0)="  1.  Use the option 'Purge Message Text File Entries' option to remove"
^DIC(9.4,33,22,1.4,"PAH",30,1,52,0)="      old messages."
^DIC(9.4,33,22,1.4,"PAH",30,1,53,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,54,0)="  2.  Make sure all messages have been transmitted.  Run the option"
^DIC(9.4,33,22,1.4,"PAH",30,1,55,0)="'Systems"
^DIC(9.4,33,22,1.4,"PAH",30,1,56,0)="      Link Monitor', under the 'Communications Server' menu, and make sure"
^DIC(9.4,33,22,1.4,"PAH",30,1,57,0)="      'messages to send' is equal to 'messages sent' for all Logical"
^DIC(9.4,33,22,1.4,"PAH",30,1,58,0)="Links."
^DIC(9.4,33,22,1.4,"PAH",30,1,59,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,60,0)="  3.  Shutdown all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",30,1,61,0)="      'Shut Down All Logical Links', 'Stop all incoming filers', and 'Stop"
^DIC(9.4,33,22,1.4,"PAH",30,1,62,0)="      all outgoing filers' options."
^DIC(9.4,33,22,1.4,"PAH",30,1,63,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,64,0)="  4.  User are allowed on the system during installation.  Do NOT inhibit"
^DIC(9.4,33,22,1.4,"PAH",30,1,65,0)="logins"
^DIC(9.4,33,22,1.4,"PAH",30,1,66,0)="      and do NOT place Taskman in a wait state."
^DIC(9.4,33,22,1.4,"PAH",30,1,67,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,68,0)="  5.  Some of these routines are new.  Currently we do not recommend that"
^DIC(9.4,33,22,1.4,"PAH",30,1,69,0)="you"
^DIC(9.4,33,22,1.4,"PAH",30,1,70,0)="      add these routines to your map set."
^DIC(9.4,33,22,1.4,"PAH",30,1,71,0)="  "
^DIC(9.4,33,22,1.4,"PAH",30,1,72,0)="  6.  Use the INSTALL/CHECK MESSAGE option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",30,1,73,0)="      option loads the KIDS package into a Transport global onto your"
^DIC(9.4,33,22,1.4,"PAH",30,1,74,0)="      system."
^DIC(9.4,33,22,1.4,"PAH",30,1,75,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,76,0)="  7.  You now need to use KIDS to install the Transport global. From"
^DIC(9.4,33,22,1.4,"PAH",30,1,77,0)="programmer"
^DIC(9.4,33,22,1.4,"PAH",30,1,78,0)="      prompt Do ^XPDKRN."
^DIC(9.4,33,22,1.4,"PAH",30,1,79,0)="  "
^DIC(9.4,33,22,1.4,"PAH",30,1,80,0)="  8.  On the KIDS menu, under the Installation menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",30,1,81,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",30,1,82,0)="  "
^DIC(9.4,33,22,1.4,"PAH",30,1,83,0)="         2 Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",30,1,84,0)="         3 Print Transport Global"
^DIC(9.4,33,22,1.4,"PAH",30,1,85,0)="         4 Compare Transport Global to Current System"
^DIC(9.4,33,22,1.4,"PAH",30,1,86,0)="         5 Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",30,1,87,0)="         6 Install Package(s)"
^DIC(9.4,33,22,1.4,"PAH",30,1,88,0)="             INSTALL NAME: HL*1.6*50"
^DIC(9.4,33,22,1.4,"PAH",30,1,89,0)="                           ========="
^DIC(9.4,33,22,1.4,"PAH",30,1,90,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,91,0)="  9.  Startup all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",30,1,92,0)="      'Restart All Links and Filers' option."
^DIC(9.4,33,22,1.4,"PAH",30,1,93,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,94,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,95,0)="=========================================================================="
^DIC(9.4,33,22,1.4,"PAH",30,1,96,0)="===  "
^DIC(9.4,33,22,1.4,"PAH",30,1,97,0)="Data Dictionary Modifications:"
^DIC(9.4,33,22,1.4,"PAH",30,1,98,0)="============================== "
^DIC(9.4,33,22,1.4,"PAH",30,1,99,0)=" "
^DIC(9.4,33,22,1.4,"PAH",30,1,100,0)=" 773  HL7 MESSAGE ADMINISTRATION"
^DIC(9.4,33,22,1.4,"PAH",30,1,101,0)="        The STATUS field, #20, has been changed to add the ""AG"""
^DIC(9.4,33,22,1.4,"PAH",30,1,102,0)="cross-reference."
^DIC(9.4,33,22,1.4,"PAH",31,0)="47 SEQ #44^2990719^1"
^DIC(9.4,33,22,1.4,"PAH",31,1,0)="^^126^126^2990719"
^DIC(9.4,33,22,1.4,"PAH",31,1,1,0)="This patch has made changes for the following:"
^DIC(9.4,33,22,1.4,"PAH",31,1,2,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,3,0)=" 1. Adds three new fields in HL COMMUNICATION SERVER PARAMETERS file"
^DIC(9.4,33,22,1.4,"PAH",31,1,4,0)="    (#869.3): "
^DIC(9.4,33,22,1.4,"PAH",31,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,6,0)="    - Field #869.3,41 PURGE COMPLETED MESSAGES:  The number of days"
^DIC(9.4,33,22,1.4,"PAH",31,1,7,0)="      ""Successfully Completed"" messages are retained before they are"
^DIC(9.4,33,22,1.4,"PAH",31,1,8,0)="      purged.  If no value is entered, the default is 7 days.  Used as the"
^DIC(9.4,33,22,1.4,"PAH",31,1,9,0)="      actual value when the ""Purge Messages"" option is scheduled through"
^DIC(9.4,33,22,1.4,"PAH",31,1,10,0)="      TaskMan, and as the default when run interactively."
^DIC(9.4,33,22,1.4,"PAH",31,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,12,0)="    - Field #869.3,42   PURGE AWAITING ACK MESSAGES:  The number of days"
^DIC(9.4,33,22,1.4,"PAH",31,1,13,0)="      ""Awaiting Application Acknowledgement"" messages are retained before"
^DIC(9.4,33,22,1.4,"PAH",31,1,14,0)="      they are purged.  If no value is entered, the default is 30 days."
^DIC(9.4,33,22,1.4,"PAH",31,1,15,0)="      Used as the actual value when the ""Purge Messages"" option is"
^DIC(9.4,33,22,1.4,"PAH",31,1,16,0)="      scheduled through TaskMan, and as the default when run"
^DIC(9.4,33,22,1.4,"PAH",31,1,17,0)="      interactively."
^DIC(9.4,33,22,1.4,"PAH",31,1,18,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,19,0)="    - Field #869.3,43  PURGE ALL MESSAGES:  The number of days that any"
^DIC(9.4,33,22,1.4,"PAH",31,1,20,0)="      status message are retained before they are purged(except for ERROR"
^DIC(9.4,33,22,1.4,"PAH",31,1,21,0)="      status messages).  If no value is entered, the default is 90 days."
^DIC(9.4,33,22,1.4,"PAH",31,1,22,0)="      Used as the actual value when the ""Purge Messages"" option is"
^DIC(9.4,33,22,1.4,"PAH",31,1,23,0)="      scheduled through TaskMan, and as the default when run"
^DIC(9.4,33,22,1.4,"PAH",31,1,24,0)="      interactively."
^DIC(9.4,33,22,1.4,"PAH",31,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,26,0)="    Please find the following HL7 options to enter or change data for"
^DIC(9.4,33,22,1.4,"PAH",31,1,27,0)="    fields described above:"
^DIC(9.4,33,22,1.4,"PAH",31,1,28,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,29,0)="      step 1. HL MAIN MENU"
^DIC(9.4,33,22,1.4,"PAH",31,1,30,0)="      step 2. Communications Server ..."
^DIC(9.4,33,22,1.4,"PAH",31,1,31,0)="      step 3. Edit Communication Server parameters"
^DIC(9.4,33,22,1.4,"PAH",31,1,32,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,33,0)="      And then you will enter the FileMan ScreenMan form as follows:"
^DIC(9.4,33,22,1.4,"PAH",31,1,34,0)="    "
^DIC(9.4,33,22,1.4,"PAH",31,1,35,0)="     --------------------------------------------------------------------"
^DIC(9.4,33,22,1.4,"PAH",31,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,37,0)="                              Edit HL7 Site Parameters"
^DIC(9.4,33,22,1.4,"PAH",31,1,38,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,39,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,40,0)="                           Current Domain: NXT.KERNEL.ISC-SF.DOMAIN.EXT      "
^DIC(9.4,33,22,1.4,"PAH",31,1,41,0)="                      Current Institution: ISC SAN FRANCISCO             "
^DIC(9.4,33,22,1.4,"PAH",31,1,42,0)="     Is this a Production or Test Account? test      "
^DIC(9.4,33,22,1.4,"PAH",31,1,43,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,44,0)="        Default Number of Incoming Filers: 1 "
^DIC(9.4,33,22,1.4,"PAH",31,1,45,0)="        Default Number of Outgoing Filers: 1 "
^DIC(9.4,33,22,1.4,"PAH",31,1,46,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,47,0)="                    Mail Group for Alerts: HL7                           "
^DIC(9.4,33,22,1.4,"PAH",31,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,49,0)="          Days to Keep Completed Messages: 7  "
^DIC(9.4,33,22,1.4,"PAH",31,1,50,0)="       Days to Keep Awaiting ACK Messages: 30 "
^DIC(9.4,33,22,1.4,"PAH",31,1,51,0)="         Days Before Purging All Messages: 90 "
^DIC(9.4,33,22,1.4,"PAH",31,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,53,0)="      ________________________________________________________________"
^DIC(9.4,33,22,1.4,"PAH",31,1,54,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,55,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,56,0)="      COMMAND:                                    Press <PF1>H for help"
^DIC(9.4,33,22,1.4,"PAH",31,1,57,0)="      Insert"
^DIC(9.4,33,22,1.4,"PAH",31,1,58,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,59,0)="      -----------------------------------------------------------------"
^DIC(9.4,33,22,1.4,"PAH",31,1,60,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,61,0)="    The old method which was used to change the data for the above three"
^DIC(9.4,33,22,1.4,"PAH",31,1,62,0)="    fields, by entering numbers in the TASK PARAMETERS field of the OPTION"
^DIC(9.4,33,22,1.4,"PAH",31,1,63,0)="    SCHEDULING FILE, will be replaced by this new method as described"
^DIC(9.4,33,22,1.4,"PAH",31,1,64,0)="    above, when the ""Purge Message Text File Entries [HL PURGE"
^DIC(9.4,33,22,1.4,"PAH",31,1,65,0)="    TRANSMISSIONS]"" OPTION is scheduled to TaskMan."
^DIC(9.4,33,22,1.4,"PAH",31,1,66,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,67,0)=" 2. Brings in updated data for files: HL7 MESSAGE STATUS and HL7 ERROR"
^DIC(9.4,33,22,1.4,"PAH",31,1,68,0)="    MESSAGE, these two files can only be used by HL7 routines."
^DIC(9.4,33,22,1.4,"PAH",31,1,69,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,70,0)=" 3. Solves problems for NOIS ISF-0499-63255: Entries existed in file #773"
^DIC(9.4,33,22,1.4,"PAH",31,1,71,0)="    with broken pointers to file #772."
^DIC(9.4,33,22,1.4,"PAH",31,1,72,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,73,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",31,1,74,0)="================"
^DIC(9.4,33,22,1.4,"PAH",31,1,75,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",31,1,76,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",31,1,77,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,78,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",31,1,79,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,80,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,81,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",31,1,82,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",31,1,83,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,84,0)="  Routine Name    Checksum Before    Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",31,1,85,0)="  ------------    ---------------    --------------     -----------------"
^DIC(9.4,33,22,1.4,"PAH",31,1,86,0)="    HL47PRE            new               613093                 47"
^DIC(9.4,33,22,1.4,"PAH",31,1,87,0)="    HLUOPT1          11568432          13112533          10,13,21,36,19,47"
^DIC(9.4,33,22,1.4,"PAH",31,1,88,0)="    HLTP01            5246181           5245980             2,25,34,47"
^DIC(9.4,33,22,1.4,"PAH",31,1,89,0)="    HLTP1             4286152           4286011               34,47"
^DIC(9.4,33,22,1.4,"PAH",31,1,90,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,91,0)="    From CHECK^XTSUMBLD "
^DIC(9.4,33,22,1.4,"PAH",31,1,92,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,93,0)="                                              "
^DIC(9.4,33,22,1.4,"PAH",31,1,94,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",31,1,95,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",31,1,96,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",31,1,97,0)="  2.  Check and make sure that the 'HL PURGE TRANSMISSIONS' option is not"
^DIC(9.4,33,22,1.4,"PAH",31,1,98,0)="      scheduled during the time of installation."
^DIC(9.4,33,22,1.4,"PAH",31,1,99,0)="  3.  Stop all the Logical links, incoming and outgoing filers."
^DIC(9.4,33,22,1.4,"PAH",31,1,100,0)="  4.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",31,1,101,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",31,1,102,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",31,1,103,0)="  5.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",31,1,104,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",31,1,105,0)="  6.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",31,1,106,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",31,1,107,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",31,1,108,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",31,1,109,0)=" "
^DIC(9.4,33,22,1.4,"PAH",31,1,110,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",31,1,111,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",31,1,112,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",31,1,113,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",31,1,114,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",31,1,115,0)="         INSTALL NAME: HL*1.6*47"
^DIC(9.4,33,22,1.4,"PAH",31,1,116,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",31,1,117,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",31,1,118,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",31,1,119,0)="  7.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",31,1,120,0)="  8.  Restart all the Logical links, incoming and outgoing filers, which"
^DIC(9.4,33,22,1.4,"PAH",31,1,121,0)="      have been stopped in step #3."
^DIC(9.4,33,22,1.4,"PAH",31,1,122,0)="  9.  Re-schedule 'HL PURGE TRANSMISSIONS' option if this option was"
^DIC(9.4,33,22,1.4,"PAH",31,1,123,0)="      scheduled and has been stopped in step #2."
^DIC(9.4,33,22,1.4,"PAH",31,1,124,0)=" 10.  Use the ""Edit Communication Server parameters"" option to enter"
^DIC(9.4,33,22,1.4,"PAH",31,1,125,0)="      and/or change the data described in DESCRIPTION section for fields-"
^DIC(9.4,33,22,1.4,"PAH",31,1,126,0)="      (#869.3,41), (#869.3,42), and (#869.3,43)."
^DIC(9.4,33,22,1.4,"PAH",32,0)="49 SEQ #45^2991003^1"
^DIC(9.4,33,22,1.4,"PAH",32,1,0)="^^296^296^2991003"
^DIC(9.4,33,22,1.4,"PAH",32,1,1,0)="Description: "
^DIC(9.4,33,22,1.4,"PAH",32,1,2,0)="============"
^DIC(9.4,33,22,1.4,"PAH",32,1,3,0)=" This patch addresses the issue of reducing the number of required logical"
^DIC(9.4,33,22,1.4,"PAH",32,1,4,0)=" links running as active concurrent processes.  Before this patch,"
^DIC(9.4,33,22,1.4,"PAH",32,1,5,0)=" all possible HL7 TCP/IP Client Logical Links would have to be defined"
^DIC(9.4,33,22,1.4,"PAH",32,1,6,0)=" and started as LLPs.  These LLPs would run and remain as active processes"
^DIC(9.4,33,22,1.4,"PAH",32,1,7,0)=" on the system regardless of the frequency to deliver HL7 messages."
^DIC(9.4,33,22,1.4,"PAH",32,1,8,0)=" This was true with both persistent and non-persistent client"
^DIC(9.4,33,22,1.4,"PAH",32,1,9,0)=" connection-type LLPs."
^DIC(9.4,33,22,1.4,"PAH",32,1,10,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,11,0)=" After this patch is installed, non-persistent client LLPs"
^DIC(9.4,33,22,1.4,"PAH",32,1,12,0)=" will still have to be started as they were before this patch."
^DIC(9.4,33,22,1.4,"PAH",32,1,13,0)=" To start an LLP, use the 'Start LLP' option."
^DIC(9.4,33,22,1.4,"PAH",32,1,14,0)=" To start an LLP automatically after a system reboot,"
^DIC(9.4,33,22,1.4,"PAH",32,1,15,0)=" either use the Interface Workbench to edit Logical Links or use FileMan"
^DIC(9.4,33,22,1.4,"PAH",32,1,16,0)=" to edit the AUTOSTART field(#4.5) of the HL LOGICAL LINK file(#870)."
^DIC(9.4,33,22,1.4,"PAH",32,1,17,0)=" For each Logical Link that wish to start automatically after a re-boot"
^DIC(9.4,33,22,1.4,"PAH",32,1,18,0)=" of the system, you must edit the AUTOSTART field to have a value"
^DIC(9.4,33,22,1.4,"PAH",32,1,19,0)=" of ENABLED.  Do NOT simply enable the AUTOSTART field"
^DIC(9.4,33,22,1.4,"PAH",32,1,20,0)=" for all Logical Links. Only select those that you wish start"
^DIC(9.4,33,22,1.4,"PAH",32,1,21,0)=" that are both legitimate and appropriate for your site."
^DIC(9.4,33,22,1.4,"PAH",32,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,23,0)=" Note, although you may have started a non-persistent LLP,"
^DIC(9.4,33,22,1.4,"PAH",32,1,24,0)=" the system process representing this LLP does not actually start"
^DIC(9.4,33,22,1.4,"PAH",32,1,25,0)=" until messages are in the associated message queue.  Once a process"
^DIC(9.4,33,22,1.4,"PAH",32,1,26,0)=" is started, it will remain running on the system until the associated"
^DIC(9.4,33,22,1.4,"PAH",32,1,27,0)=" queue is emptied and the associated Retention time has expired."
^DIC(9.4,33,22,1.4,"PAH",32,1,28,0)=" The Retention time is the time in seconds in which the LLP process"
^DIC(9.4,33,22,1.4,"PAH",32,1,29,0)=" will wait while continually checking for messages in the associated"
^DIC(9.4,33,22,1.4,"PAH",32,1,30,0)=" message queue.  If messages are found in the queue before the retention"
^DIC(9.4,33,22,1.4,"PAH",32,1,31,0)=" time has expired, the LLP process will continue to de-queue messages"
^DIC(9.4,33,22,1.4,"PAH",32,1,32,0)=" as before.  Otherwise, the LLP process will actually return back"
^DIC(9.4,33,22,1.4,"PAH",32,1,33,0)=" to TaskMan's sub-manager and possibly terminate.  When this occurs,"
^DIC(9.4,33,22,1.4,"PAH",32,1,34,0)=" a status of INACTIVE is indicated on the STATE column"
^DIC(9.4,33,22,1.4,"PAH",32,1,35,0)=" of the system link monitor for this LLP.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,37,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,38,0)="This patch also addresses the following issues: "
^DIC(9.4,33,22,1.4,"PAH",32,1,39,0)="   "
^DIC(9.4,33,22,1.4,"PAH",32,1,40,0)="  1.  Fix allocation error in HLCSDR."
^DIC(9.4,33,22,1.4,"PAH",32,1,41,0)="      Related NOIS:        SFC-0599-60101"
^DIC(9.4,33,22,1.4,"PAH",32,1,42,0)="                           SBY-0199-30725"
^DIC(9.4,33,22,1.4,"PAH",32,1,43,0)="                           HIN-1298-40436"
^DIC(9.4,33,22,1.4,"PAH",32,1,44,0)="      Actual error:  $ZE= INT+22^%ET:1, %DSM-E-ALLOC, allocation failure"
^DIC(9.4,33,22,1.4,"PAH",32,1,45,0)="       Description:  This error was first seen after the introduction of"
^DIC(9.4,33,22,1.4,"PAH",32,1,46,0)="                     patch HL*1.6*14.  This patch 14, utilized error"
^DIC(9.4,33,22,1.4,"PAH",32,1,47,0)="                     trapping to trap disconnect errors so that processing"
^DIC(9.4,33,22,1.4,"PAH",32,1,48,0)="                     may continue once the errors have passed.  However,"
^DIC(9.4,33,22,1.4,"PAH",32,1,49,0)="                     if the associated port/device was bad/busy, the code"
^DIC(9.4,33,22,1.4,"PAH",32,1,50,0)="                     would continually loop to the code that sets the trap."
^DIC(9.4,33,22,1.4,"PAH",32,1,51,0)="                     As the stack continues to grow, an allocation error"
^DIC(9.4,33,22,1.4,"PAH",32,1,52,0)="                     would result in about 4 to 6+ hours after the logical"
^DIC(9.4,33,22,1.4,"PAH",32,1,53,0)="                     link was started or when the device became bad/busy."
^DIC(9.4,33,22,1.4,"PAH",32,1,54,0)="                     This allocation error was seen associated with"
^DIC(9.4,33,22,1.4,"PAH",32,1,55,0)="                     the applications using the serial HLLP protocol of"
^DIC(9.4,33,22,1.4,"PAH",32,1,56,0)="                     the HL7 v1.6 (HLCSDR* routines)."
^DIC(9.4,33,22,1.4,"PAH",32,1,57,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,58,0)="  2.  Fix allocation error in HLCSMON."
^DIC(9.4,33,22,1.4,"PAH",32,1,59,0)="      Description:  If a user enters '?' and <RET> repeatedly at the"
^DIC(9.4,33,22,1.4,"PAH",32,1,60,0)="                    command prompt of the Systems Link Monitor, an"
^DIC(9.4,33,22,1.4,"PAH",32,1,61,0)="                    allocation error will be encountered after 6+ attempts."
^DIC(9.4,33,22,1.4,"PAH",32,1,62,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,63,0)="  3.  Fix extraneous display of **STOP** on CACHE sites."
^DIC(9.4,33,22,1.4,"PAH",32,1,64,0)="      Related NOIS:        MAN-0799-11246"
^DIC(9.4,33,22,1.4,"PAH",32,1,65,0)="      Description:  When the Restart All Links and Filers option is run,"
^DIC(9.4,33,22,1.4,"PAH",32,1,66,0)="                    **STOP** is displayed after failing to connect to"
^DIC(9.4,33,22,1.4,"PAH",32,1,67,0)="                    a listener.  This is now corrected by this patch."
^DIC(9.4,33,22,1.4,"PAH",32,1,68,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,69,0)="Routine Modifications: "
^DIC(9.4,33,22,1.4,"PAH",32,1,70,0)="======================"
^DIC(9.4,33,22,1.4,"PAH",32,1,71,0)="The following routines are included in this patch.  The second line of these"
^DIC(9.4,33,22,1.4,"PAH",32,1,72,0)="routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",32,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,74,0)=" ;;1.6;HEALTH LEVEL SEVEN;<patchlist>;29-Jan-97 14:25"
^DIC(9.4,33,22,1.4,"PAH",32,1,75,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,76,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,33,22,1.4,"PAH",32,1,77,0)="   "
^DIC(9.4,33,22,1.4,"PAH",32,1,78,0)=" Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,33,22,1.4,"PAH",32,1,79,0)=" ============   ============    ===========     =========="
^DIC(9.4,33,22,1.4,"PAH",32,1,80,0)=" HLCS2           7195833         8763479        14,40,43,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,81,0)=" HLCSDL          4198429         4174780        2,44,49"
