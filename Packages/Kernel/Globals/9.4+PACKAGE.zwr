^DIC(9.4,11,22,5.03,"PAH",26,1,39,0)="   LA7DVM           6949969        7061863        **53,58,62**"
^DIC(9.4,11,22,5.03,"PAH",26,1,40,0)="   LA7VHL           4500486        4568355        **27,46,62**"
^DIC(9.4,11,22,5.03,"PAH",26,1,41,0)="   LA7VHLU          4469720        4487468        **46,62**"
^DIC(9.4,11,22,5.03,"PAH",26,1,42,0)="   "
^DIC(9.4,11,22,5.03,"PAH",26,1,43,0)=" List of preceding patches: 46, 58"
^DIC(9.4,11,22,5.03,"PAH",26,1,44,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,11,22,5.03,"PAH",26,1,45,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,46,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,47,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",26,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,49,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",26,1,50,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",26,1,51,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,52,0)="  The install time for this patch is less than 10 minute. This patch"
^DIC(9.4,11,22,5.03,"PAH",26,1,53,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",26,1,54,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",26,1,55,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,56,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,57,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,11,22,5.03,"PAH",26,1,58,0)="      problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",26,1,59,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,60,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",26,1,61,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",26,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,64,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",26,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,66,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",26,1,67,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",26,1,68,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,69,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",26,1,70,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",26,1,71,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,72,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",26,1,73,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",26,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,75,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",26,1,76,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",26,1,77,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",26,1,78,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",26,1,79,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",26,1,80,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,81,0)="  6.  Perform the following steps if applicable:"
^DIC(9.4,11,22,5.03,"PAH",26,1,82,0)="      All Lab LEDI (LA7V*) related HL v1.6 LLPs should be shutdown."
^DIC(9.4,11,22,5.03,"PAH",26,1,83,0)="      All CareVue related LLPs should be shutdown."
^DIC(9.4,11,22,5.03,"PAH",26,1,84,0)="      Use the HL menu option Start/Stop Links [HL START] to shutdown"
^DIC(9.4,11,22,5.03,"PAH",26,1,85,0)="      these LLPs if they are running."
^DIC(9.4,11,22,5.03,"PAH",26,1,86,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,88,0)="  7.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",26,1,89,0)="      and select the package 'LA*5.2*62'.  When prompted 'Want KIDS to"
^DIC(9.4,11,22,5.03,"PAH",26,1,90,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,11,22,5.03,"PAH",26,1,91,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,11,22,5.03,"PAH",26,1,92,0)="      YES//', choose 'YES'."
^DIC(9.4,11,22,5.03,"PAH",26,1,93,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,94,0)="      All LA7V* and LA7D* protocols should be placed out of service during"
^DIC(9.4,11,22,5.03,"PAH",26,1,95,0)="      the install. This can be accomplished by answering the KIDS install"
^DIC(9.4,11,22,5.03,"PAH",26,1,96,0)="      questions:"
^DIC(9.4,11,22,5.03,"PAH",26,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,98,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,11,22,5.03,"PAH",26,1,99,0)="        YES//', choose 'YES'."
^DIC(9.4,11,22,5.03,"PAH",26,1,100,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,101,0)="        Enter options you wish to mark as 'Out Of Order': <RET>"
^DIC(9.4,11,22,5.03,"PAH",26,1,102,0)="        Enter protocols you wish to mark as 'Out Of Order': LA7V*"
^DIC(9.4,11,22,5.03,"PAH",26,1,103,0)="        Enter protocols you wish to mark as 'Out Of Order': LA7D*"
^DIC(9.4,11,22,5.03,"PAH",26,1,104,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,105,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,106,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,107,0)="  8. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",26,1,108,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,109,0)=" Note: Routine LA62 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",26,1,110,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,111,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,112,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,11,22,5.03,"PAH",26,1,113,0)="==============================="
^DIC(9.4,11,22,5.03,"PAH",26,1,114,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,115,0)="1. Restart any LA7V* and CareVue HL v1.6 LLP's shutdown as part of the"
^DIC(9.4,11,22,5.03,"PAH",26,1,116,0)="patch installation process. Use the Start LLP [HL START] option to"
^DIC(9.4,11,22,5.03,"PAH",26,1,117,0)="restart LA7V* and CareVue HL v1.6 LLP's."
^DIC(9.4,11,22,5.03,"PAH",26,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,119,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,120,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",26,1,121,0)="Installation example:"
^DIC(9.4,11,22,5.03,"PAH",26,1,122,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,123,0)=" Select Installation Option:  Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",26,1,124,0)=" Select INSTALL NAME:  LA*5.2*62  Loaded from Distribution 6/10/02@16:05:04"
^DIC(9.4,11,22,5.03,"PAH",26,1,125,0)="     => LA*5.2*62"
^DIC(9.4,11,22,5.03,"PAH",26,1,126,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,127,0)="This Distribution was loaded on Jun 10, 2002@16:05:04 with header of"
