^DIC(9.4,4,22,1,"PAH",149,1,49,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",149,1,50,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",149,1,51,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",149,1,52,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",149,1,53,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",149,1,54,0)=" Enter a '^' to abort the install."
