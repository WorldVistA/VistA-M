^DIC(9.4,4,22,1,"PAH",70,0)="95 SEQ #95^2991019^1"
^DIC(9.4,4,22,1,"PAH",70,1,0)="^^55^55^2991019"
^DIC(9.4,4,22,1,"PAH",70,1,1,0)="Patch XM*7.1*95"
^DIC(9.4,4,22,1,"PAH",70,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",70,1,3,0)="NOIS:  WAS-0999-21379"
^DIC(9.4,4,22,1,"PAH",70,1,4,0)="Test Sites:  Washington,D.C.; Fargo,ND"
^DIC(9.4,4,22,1,"PAH",70,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",70,1,6,0)="MailMan patch XM*7.1*50 removed the ability to forward messages in the"
^DIC(9.4,4,22,1,"PAH",70,1,7,0)="Postmaster's transmit queue baskets.  This patch restores that ability."
^DIC(9.4,4,22,1,"PAH",70,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",70,1,9,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",70,1,10,0)="minimum.  It requires MailMan patch XM*7.1*89."
^DIC(9.4,4,22,1,"PAH",70,1,11,0)="============================================================================ "
