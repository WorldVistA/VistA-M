^DIC(9.4,77,22,17,"PAH",221,0)="227 SEQ #222^3120228.102914^17"
^DIC(9.4,77,22,17,"PAH",221,1,0)="^^8^8^3120228"
^DIC(9.4,77,22,17,"PAH",221,1,1,0)="This patch addresses the following 3 issues:"
^DIC(9.4,77,22,17,"PAH",221,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",221,1,3,0)="1. When entering a new UNIT DOSE order in VistA, using <space bar> <enter>"
^DIC(9.4,77,22,17,"PAH",221,1,4,0)="   at the SCHEDULE prompt causes an error."
^DIC(9.4,77,22,17,"PAH",221,1,5,0)=" "
^DIC(9.4,77,22,17,"PAH",221,1,6,0)="2. Undefined error when editing IV Quick Code schedule"
^DIC(9.4,77,22,17,"PAH",221,1,7,0)=" "
^DIC(9.4,77,22,17,"PAH",221,1,8,0)="3. Incorrect DIN drug information for Unit Dose orders"
^DIC(9.4,77,22,17,"PAH",222,0)="270 SEQ #223^3120405.1148^17"
^DIC(9.4,77,22,17,"PAH",222,1,0)="^^5^5^3120405"
^DIC(9.4,77,22,17,"PAH",222,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",222,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",222,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",222,1,4,0)="-Prevent IV orders with bottle from being finished as Piggyback"
^DIC(9.4,77,22,17,"PAH",222,1,5,0)="-Undefined error with invalid drug class"
^DIC(9.4,77,22,17,"PAH",223,0)="264 SEQ #224^3120405.114812^17"
^DIC(9.4,77,22,17,"PAH",223,1,0)="^^5^5^3120405"
^DIC(9.4,77,22,17,"PAH",223,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",223,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",223,1,3,0)="                                "
^DIC(9.4,77,22,17,"PAH",223,1,4,0)="-Units per Dose calculated incorrectly"
^DIC(9.4,77,22,17,"PAH",223,1,5,0)="-Erroneous warnings about overlapping complex schedules"
^DIC(9.4,77,22,17,"PAH",224,0)="247 SEQ #225^3120418.115033^17"
^DIC(9.4,77,22,17,"PAH",224,1,0)="^^5^5^3120418"
^DIC(9.4,77,22,17,"PAH",224,1,1,0)="This patch will make the following corrections to the Inpatient "
^DIC(9.4,77,22,17,"PAH",224,1,2,0)="Medications package:"
^DIC(9.4,77,22,17,"PAH",224,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",224,1,4,0)="- Do not allow user to delete Dispense Drug of active order"
^DIC(9.4,77,22,17,"PAH",224,1,5,0)="- Undefined Error when discontinuing a copied IV order"
^DIC(9.4,77,22,17,"PAH",225,0)="273 SEQ #226^3120423.142753^17"
^DIC(9.4,77,22,17,"PAH",225,1,0)="^^6^6^3120423"
^DIC(9.4,77,22,17,"PAH",225,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",225,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",225,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",225,1,4,0)="-Additive does not print on chemotherapy label"
^DIC(9.4,77,22,17,"PAH",225,1,5,0)="-Patient deceased message not displaying properly"
^DIC(9.4,77,22,17,"PAH",225,1,6,0)="-UNDEFINED error when nurse verifies order"
^DIC(9.4,77,22,17,"PAH",226,0)="271 SEQ #227^3120423.164759^17"
^DIC(9.4,77,22,17,"PAH",226,1,0)="^^6^6^3120423"
^DIC(9.4,77,22,17,"PAH",226,1,1,0)="This patch will correct the following issue:"
^DIC(9.4,77,22,17,"PAH",226,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",226,1,3,0)="   When using the Order Entry (IV) [PSJI ORDER] menu option. A "
^DIC(9.4,77,22,17,"PAH",226,1,4,0)="   variable containing schedule frequency was being left behind. "
^DIC(9.4,77,22,17,"PAH",226,1,5,0)="   Causing order to be created with a frequency that would not "
^DIC(9.4,77,22,17,"PAH",226,1,6,0)="   match the schedule."
^DIC(9.4,77,22,17,"PAH",227,0)="244 SEQ #228^3120430.11412^17"
^DIC(9.4,77,22,17,"PAH",227,1,0)="^^8^8^3120430"
^DIC(9.4,77,22,17,"PAH",227,1,1,0)="The purpose of this patch is to provide software bug fixes for Inpatient "
^DIC(9.4,77,22,17,"PAH",227,1,2,0)="Medications to correct several errors and to provide a method to clean "
^DIC(9.4,77,22,17,"PAH",227,1,3,0)="up discontinued non-verified orders in cross-references in order to "
^DIC(9.4,77,22,17,"PAH",227,1,4,0)="increase system speed.  This patch corrects the following issues:"
^DIC(9.4,77,22,17,"PAH",227,1,5,0)=" "
^DIC(9.4,77,22,17,"PAH",227,1,6,0)="-Slow response when searching for orders"
^DIC(9.4,77,22,17,"PAH",227,1,7,0)="-Incorrect error message displaying"
^DIC(9.4,77,22,17,"PAH",227,1,8,0)="-Undefined Error when verifying orders"
^DIC(9.4,77,22,17,"PAH",228,0)="265 SEQ #229^3120829.103417^17"
^DIC(9.4,77,22,17,"PAH",228,1,0)="^^8^8^3120829"
^DIC(9.4,77,22,17,"PAH",228,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",228,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",228,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",228,1,4,0)="-Pending Clinic orders not accessible in Non-Verified/Pending Orders"
^DIC(9.4,77,22,17,"PAH",228,1,5,0)=" Report"
^DIC(9.4,77,22,17,"PAH",228,1,6,0)="-Non-Verified Clinic orders not accessible in Non-Verified/Pending Orders"
^DIC(9.4,77,22,17,"PAH",228,1,7,0)=" Report"
^DIC(9.4,77,22,17,"PAH",228,1,8,0)="-Loop when editing Stop Date "
^DIC(9.4,77,22,17,"PAH",229,0)="246 SEQ #230^3120829.104938^17"
^DIC(9.4,77,22,17,"PAH",229,1,0)="^^2^2^3120829"
^DIC(9.4,77,22,17,"PAH",229,1,1,0)="This patch will resolve the issue were the user is getting an UNDEFINED "
^DIC(9.4,77,22,17,"PAH",229,1,2,0)="error when coping an existing inpatient medication order."
^DIC(9.4,77,22,17,"PAH",230,0)="277 SEQ #231^3120829.121933^17"
^DIC(9.4,77,22,17,"PAH",230,1,0)="^^3^3^3120829"
^DIC(9.4,77,22,17,"PAH",230,1,1,0)=" This patch will correct an issue in which the Expected First Dose line "
^DIC(9.4,77,22,17,"PAH",230,1,2,0)=" in CPRS, as well as the REQUESTED START DATE line in inpatient order "
^DIC(9.4,77,22,17,"PAH",230,1,3,0)=" entry were not displaying the correct date."
^DIC(9.4,77,22,17,"PAH",231,0)="267 SEQ #232^3120912.162611^17"
^DIC(9.4,77,22,17,"PAH",231,1,0)="^^378^378^3120912"
^DIC(9.4,77,22,17,"PAH",231,1,1,0)="******************************* WARNING **********************************"
^DIC(9.4,77,22,17,"PAH",231,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,3,0)="If your facility has the Pyxis/Omnicell/McKesson interface from ILC this"
^DIC(9.4,77,22,17,"PAH",231,1,4,0)="patch will overwrite any local modifications in routines PSJOEA2, PSGOEE, "
^DIC(9.4,77,22,17,"PAH",231,1,5,0)="PSGOETO, and PSGOEV. This could affect certain orders being sent across"
^DIC(9.4,77,22,17,"PAH",231,1,6,0)="this interface. The modifications will have to be reintroduced following"
^DIC(9.4,77,22,17,"PAH",231,1,7,0)="installation of this patch."
^DIC(9.4,77,22,17,"PAH",231,1,8,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,9,0)="**************************************************************************"
^DIC(9.4,77,22,17,"PAH",231,1,10,0)="******************************* ATTENTION ********************************"
^DIC(9.4,77,22,17,"PAH",231,1,11,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,12,0)="                          PSB*3*68 and PSS*1*171"
^DIC(9.4,77,22,17,"PAH",231,1,13,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,14,0)="This patch (PSJ*5*267) should be installed before PSS*1*171 in order to"
^DIC(9.4,77,22,17,"PAH",231,1,15,0)="activate the NO ALLERGY ASSESSMENT enhancement. The NO ALLERGY ASSESSMENT"
^DIC(9.4,77,22,17,"PAH",231,1,16,0)="enhancement will not be fully activated until patch PSS*1*171 and "
^DIC(9.4,77,22,17,"PAH",231,1,17,0)="PSJ*5*267 are both installed."
^DIC(9.4,77,22,17,"PAH",231,1,18,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,19,0)="This patch (PSJ*5*267) should be installed with PSB*3*68 in order to"
^DIC(9.4,77,22,17,"PAH",231,1,20,0)="activate the UNLIMITED SI/OPI enhancement in BCMA. This patch (PSJ*5*267)"
^DIC(9.4,77,22,17,"PAH",231,1,21,0)="is required by PSB*3*68 and must be installed after PSB*3*68."
^DIC(9.4,77,22,17,"PAH",231,1,22,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,23,0)="************************************************************************* "
^DIC(9.4,77,22,17,"PAH",231,1,24,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,25,0)="Enhancements"
^DIC(9.4,77,22,17,"PAH",231,1,26,0)="====================="
^DIC(9.4,77,22,17,"PAH",231,1,27,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,28,0)="1. Special Instructions/Other Print Info"
^DIC(9.4,77,22,17,"PAH",231,1,29,0)=" ________________________________________"
^DIC(9.4,77,22,17,"PAH",231,1,30,0)=" With this enhancement, Special Instructions and Other Print Info have"
^DIC(9.4,77,22,17,"PAH",231,1,31,0)=" been modified to support an unlimited amount of text. The existing"
^DIC(9.4,77,22,17,"PAH",231,1,32,0)=" functionality that copies the provider comments from the Computerized"
^DIC(9.4,77,22,17,"PAH",231,1,33,0)=" Patient Record System (CPRS) to be copied into each field has been"
^DIC(9.4,77,22,17,"PAH",231,1,34,0)="<=======T=======T=======T=======T=======T=======T=======T=======T=======T>"
^DIC(9.4,77,22,17,"PAH",231,1,35,0)="======"
