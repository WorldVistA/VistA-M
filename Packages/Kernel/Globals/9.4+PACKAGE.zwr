^DIC(9.4,4,22,1,"PAH",102,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",102,1,3,0)="NOIS: ISW-0600-22431"
^DIC(9.4,4,22,1,"PAH",102,1,4,0)="Test Site:  OIFO Washington"
^DIC(9.4,4,22,1,"PAH",102,1,5,0)="If you try to print the last response of a message, the whole message is"
^DIC(9.4,4,22,1,"PAH",102,1,6,0)="printed by mistake.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",102,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",102,1,8,0)="NOTE: This patch should be installed during off hours, when user activity"
