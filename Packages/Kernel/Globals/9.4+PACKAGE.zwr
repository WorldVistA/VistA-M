^DIC(9.4,186,22,2,1,0)="^9.54^3^3^3060427^"
^DIC(9.4,186,22,2,1,1,0)="Clinical Case Registries (CCR) V1.5 package. "
^DIC(9.4,186,22,2,1,2,0)="This build can be used both for updating the CCR V1.0"
^DIC(9.4,186,22,2,1,3,0)="and for a ""virgin"" installation of the package."
^DIC(9.4,186,22,2,"PAH",0)="^9.4901^42^42"
^DIC(9.4,186,22,2,"PAH",1,0)="1 SEQ #1^3070904.22043^1"
