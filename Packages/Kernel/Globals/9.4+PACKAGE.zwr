^DIC(9.4,163,22,1,"PAH",223,1,0)="^^2^2^3090422"
^DIC(9.4,163,22,1,"PAH",223,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",223,1,2,0)="under TIU*1*242."
^DIC(9.4,163,22,1,"PAH",224,0)="227 SEQ #228^3090422.122122^17"
^DIC(9.4,163,22,1,"PAH",224,1,0)="^^1^1^3090422"
^DIC(9.4,163,22,1,"PAH",224,1,1,0)="This patch will correct addendum, alert, and signature issues."
^DIC(9.4,163,22,1,"PAH",225,0)="233 SEQ #229^3090423.114621^17"
^DIC(9.4,163,22,1,"PAH",225,1,0)="^^6^6^3090423"
^DIC(9.4,163,22,1,"PAH",225,1,1,0)="This patch includes fixes for the following Remedy tickets:"
^DIC(9.4,163,22,1,"PAH",225,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",225,1,3,0)=" HD69299 - ID SIGNER/CO-SIGNER"
^DIC(9.4,163,22,1,"PAH",225,1,4,0)=" HD99628 - Spacebar option not working after patch TIU*1*173 "
^DIC(9.4,163,22,1,"PAH",225,1,5,0)=" HD69093 - Can not print warning for addendum"
^DIC(9.4,163,22,1,"PAH",225,1,6,0)=" HD94265 - Can not delete duplicate UNDICTATED Opertion Report"
^DIC(9.4,163,22,1,"PAH",226,0)="246^3090423.122357^17"
^DIC(9.4,163,22,1,"PAH",226,1,0)="^^2^2^3090423"
^DIC(9.4,163,22,1,"PAH",226,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",226,1,2,0)="under TIU*1*246."
^DIC(9.4,163,22,1,"PAH",227,0)="237 SEQ #231^3091109.112438^17"
^DIC(9.4,163,22,1,"PAH",227,1,0)="^^6^6^3091109"
^DIC(9.4,163,22,1,"PAH",227,1,1,0)="PSI-07-154"
^DIC(9.4,163,22,1,"PAH",227,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",227,1,3,0)="Problem with TIU C&P upload. The upload requires the IEN of file 396.4 as "
^DIC(9.4,163,22,1,"PAH",227,1,4,0)="the reference number.  If there is an error on the upload processing the "
^DIC(9.4,163,22,1,"PAH",227,1,5,0)="error alert can post the exam results to the wrong veteran.  The upload "
^DIC(9.4,163,22,1,"PAH",227,1,6,0)="can also post to closed exam requests."
^DIC(9.4,163,22,1,"PAH",228,0)="249^3091118.095639^17"
^DIC(9.4,163,22,1,"PAH",228,1,0)="^^3^3^3091118"
^DIC(9.4,163,22,1,"PAH",228,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",228,1,2,0)="under TIU*1*249."
^DIC(9.4,163,22,1,"PAH",228,1,3,0)=""
^DIC(9.4,163,22,1,"PAH",229,0)="232 SEQ #233^3100224.153913^17"
^DIC(9.4,163,22,1,"PAH",229,1,0)="^^22^22^3100224"
^DIC(9.4,163,22,1,"PAH",229,1,1,0)="Fix the following defects."
^DIC(9.4,163,22,1,"PAH",229,1,2,0)="HD69695 When using copy to create a new document, the print name from the "
^DIC(9.4,163,22,1,"PAH",229,1,3,0)="original document is the print name for the newly created document."
^DIC(9.4,163,22,1,"PAH",229,1,4,0)="HD70760 In CPRS do not allow edit, delete, addendum of Nurse "
^DIC(9.4,163,22,1,"PAH",229,1,5,0)="Intraoperative Report and Anesthesia Report.  "
^DIC(9.4,163,22,1,"PAH",229,1,6,0)=" Also, prohibit Amend, or Verify/Unverify -> Edit functions"
^DIC(9.4,163,22,1,"PAH",229,1,7,0)=" for the Nurse Intraoperative Report and  Anesthesia Report"
^DIC(9.4,163,22,1,"PAH",229,1,8,0)=" in the options listed below:"
^DIC(9.4,163,22,1,"PAH",229,1,9,0)=" "
^DIC(9.4,163,22,1,"PAH",229,1,10,0)="    TIU BROWSE DOCUMENT MGR       Individual Patient Document"
^DIC(9.4,163,22,1,"PAH",229,1,11,0)="    TIU BROWSE DOCUMENT MRT       Individual Patient Document"
^DIC(9.4,163,22,1,"PAH",229,1,12,0)="    TIU MAIN MENU MGR       Text Integration Utilities (MIS Manager)"
^DIC(9.4,163,22,1,"PAH",229,1,13,0)="    TIU MAIN MENU MRT       Text Integration Utilities (MRT)"
^DIC(9.4,163,22,1,"PAH",229,1,14,0)="    TIU REVIEW SCREEN MIS MANAGER       Multiple Patient Documents"
^DIC(9.4,163,22,1,"PAH",229,1,15,0)="    TIU REVIEW SCREEN MRT       Multiple Patient Documents"
^DIC(9.4,163,22,1,"PAH",229,1,16,0)="    TIU SEARCH LIST MGR       Search for Selected Documents"
^DIC(9.4,163,22,1,"PAH",229,1,17,0)="    TIU SEARCH LIST MRT       Search for Selected Documents"
^DIC(9.4,163,22,1,"PAH",229,1,18,0)=" "
^DIC(9.4,163,22,1,"PAH",229,1,19,0)=" "
^DIC(9.4,163,22,1,"PAH",229,1,20,0)=" "
^DIC(9.4,163,22,1,"PAH",229,1,21,0)="HD166528 Update message displayed when trying to delete an "
^DIC(9.4,163,22,1,"PAH",229,1,22,0)="Interdisciplinary Parent note that has kids."
^DIC(9.4,163,22,1,"PAH",230,0)="244 SEQ #234^3100603.104251^17"
^DIC(9.4,163,22,1,"PAH",230,1,0)="^^2^2^3100603"
^DIC(9.4,163,22,1,"PAH",230,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,163,22,1,"PAH",230,1,2,0)="under TIU*1*244."
^DIC(9.4,163,22,1,"PAH",231,0)="250 SEQ #235^3100816.120732^17"
^DIC(9.4,163,22,1,"PAH",231,1,0)="^^2^2^3100816"
^DIC(9.4,163,22,1,"PAH",231,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",231,1,2,0)="under TIU*1*250."
^DIC(9.4,163,22,1,"PAH",232,0)="257^3110124.125822^17"
^DIC(9.4,163,22,1,"PAH",232,1,0)="^^2^2^3110124"
^DIC(9.4,163,22,1,"PAH",232,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,163,22,1,"PAH",232,1,2,0)="under TIU*1*257."
^DIC(9.4,163,22,1,"PAH",233,0)="241 SEQ #237^3110526.111754^17"
^DIC(9.4,163,22,1,"PAH",233,1,0)="^^5^5^3110526"
^DIC(9.4,163,22,1,"PAH",233,1,1,0)="HD229090 Additional signer does not appear on documents that are "
^DIC(9.4,163,22,1,"PAH",233,1,2,0)="administratively closed"
^DIC(9.4,163,22,1,"PAH",233,1,3,0)="HD247418 Incorrect ??doc for START OF ADD SGNR ALERT PERIOD.  Also update "
^DIC(9.4,163,22,1,"PAH",233,1,4,0)="technical manual"
^DIC(9.4,163,22,1,"PAH",233,1,5,0)="HD70039 No entry in TIU Technical Manual for TIU Nightly Task"
^DIC(9.4,163,22,1,"PAH",234,0)="248 SEQ #238^3110531.143838^17"
^DIC(9.4,163,22,1,"PAH",234,1,0)="^^5^5^3110531"
^DIC(9.4,163,22,1,"PAH",234,1,1,0)="This patch related to Remedy 277123 and PSPO 1093.  The TIU option TIU "
^DIC(9.4,163,22,1,"PAH",234,1,2,0)="MISSING TEXT CLEANUP retracts documents and therefore should be "
^DIC(9.4,163,22,1,"PAH",234,1,3,0)="restricted to users who hold security key TIU MISSING TEXT CLEAN."
^DIC(9.4,163,22,1,"PAH",234,1,4,0)="Security key TIU MISSING TEXT CLEAN should only be assigned to someone"
^DIC(9.4,163,22,1,"PAH",234,1,5,0)="that holds Chief,MIS or Chief, HIM class in USR."
^DIC(9.4,163,22,1,"PAH",235,0)="239 SEQ #239^3110620.174056^17"
^DIC(9.4,163,22,1,"PAH",235,1,0)="^^7^7^3110620"
^DIC(9.4,163,22,1,"PAH",235,1,1,0)="This patch adresses the following Remedy tickets:"
^DIC(9.4,163,22,1,"PAH",235,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",235,1,3,0)=" HD168903 - TIU documents/consults"
^DIC(9.4,163,22,1,"PAH",235,1,4,0)=" duplicate(s): HD211236,202522,193385"
^DIC(9.4,163,22,1,"PAH",235,1,5,0)=" HD311014 - One Progress Note on two consults"
^DIC(9.4,163,22,1,"PAH",235,1,6,0)=" HD152076 - User Class expires"
^DIC(9.4,163,22,1,"PAH",235,1,7,0)=" HD131840 - Addtl Signer - User Class Requiring Cosignature (error box)"
^DIC(9.4,163,22,1,"PAH",236,0)="255 SEQ #241^3111128.152933^17"
^DIC(9.4,163,22,1,"PAH",236,1,0)="^^5^5^3111128"
^DIC(9.4,163,22,1,"PAH",236,1,1,0)=" This patch will correct the following issue:"
^DIC(9.4,163,22,1,"PAH",236,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",236,1,3,0)=" An Identified Signer disappears from a note after re-identifying"
^DIC(9.4,163,22,1,"PAH",236,1,4,0)=" the signer (using the Identify Additional Signature command) and "
^DIC(9.4,163,22,1,"PAH",236,1,5,0)=" then clicking on either the ""Remove"" or ""Remove All"" button. "
^DIC(9.4,163,22,1,"PAH",237,0)="260^3120323.125239^17"
^DIC(9.4,163,22,1,"PAH",238,0)="261^3120323.125855^17"
^DIC(9.4,163,22,1,"PAH",238,1,0)="^^2^2^3120323"
^DIC(9.4,163,22,1,"PAH",238,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,163,22,1,"PAH",238,1,2,0)="under patch TIU*1*261."
^DIC(9.4,163,22,1,"PAH",239,0)="252 SEQ #244^3120829.115914^17"
^DIC(9.4,163,22,1,"PAH",239,1,0)="^^1^1^3120829"
^DIC(9.4,163,22,1,"PAH",239,1,1,0)="See TIU*1*252 in the National Patch Module."
^DIC(9.4,163,22,1,"PAH",240,0)="259 SEQ #245^3120907.151541^17"
^DIC(9.4,163,22,1,"PAH",240,1,0)="^^7^7^3120907"
^DIC(9.4,163,22,1,"PAH",240,1,1,0)="This build for TIU*1*259 addresses 2 issues."
^DIC(9.4,163,22,1,"PAH",240,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",240,1,3,0)="First, it adds the date of the document to alerts for OVERDUE signatures."
^DIC(9.4,163,22,1,"PAH",240,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",240,1,5,0)="Second, it changes TIU VISTA MRT Option Unsigned/Uncosigned Report [TIU "
^DIC(9.4,163,22,1,"PAH",240,1,6,0)="UNSIGNED/UNCOSIGNED REPORT] so that documents requiring a cosignature are"
^DIC(9.4,163,22,1,"PAH",240,1,7,0)="sorted under the service of the Expected Cosigner rather than the author."
^DIC(9.4,163,22,1,"PAH",241,0)="264 SEQ #246^3130122.171234^17"
^DIC(9.4,163,22,1,"PAH",241,1,0)="^^30^30^3130122"
^DIC(9.4,163,22,1,"PAH",241,1,1,0)=" This patch will correct the following issues:"
^DIC(9.4,163,22,1,"PAH",241,1,2,0)=" If a user enters a note in Mobile Electronic Documentation, and does not "
^DIC(9.4,163,22,1,"PAH",241,1,3,0)=" select a different note before exiting, in some cases the newly entered "
^DIC(9.4,163,22,1,"PAH",241,1,4,0)=" note would be lost."
^DIC(9.4,163,22,1,"PAH",241,1,5,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,6,0)=" The parameter TIU MED HSTYPE was set to accept a free text value that "
^DIC(9.4,163,22,1,"PAH",241,1,7,0)=" should contain a pointer to the Health Summary type to be used with MED. "
^DIC(9.4,163,22,1,"PAH",241,1,8,0)=" This was a problem, because a user had to know the Internal entry "
^DIC(9.4,163,22,1,"PAH",241,1,9,0)=" number of the health summary in order to update the parameter."
^DIC(9.4,163,22,1,"PAH",241,1,10,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,11,0)=" When certain Patient Data Objects are imported from MED notes, internal "
^DIC(9.4,163,22,1,"PAH",241,1,12,0)=" data was incorrectly getting added to the note. "
^DIC(9.4,163,22,1,"PAH",241,1,13,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,14,0)=" Mobile Electronic Documentation was calculating when to suggest "
^DIC(9.4,163,22,1,"PAH",241,1,15,0)=" database compaction incorrectly. Also, when database compaction was "
^DIC(9.4,163,22,1,"PAH",241,1,16,0)=" suggested, and the users clicked Yes in order to compact the database, "
^DIC(9.4,163,22,1,"PAH",241,1,17,0)=" MED would get stuck in an infinite loop and hang."
^DIC(9.4,163,22,1,"PAH",241,1,18,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,19,0)=" The Action menu, in MED is displaying on all tabs, even though it is "
^DIC(9.4,163,22,1,"PAH",241,1,20,0)=" only related to the Notes tab. This can cause confusion if there is a "
^DIC(9.4,163,22,1,"PAH",241,1,21,0)=" note selected on the notes tab and the user is on a different tab."
^DIC(9.4,163,22,1,"PAH",241,1,22,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,23,0)=" When using a dialog template in MED, parent choices are grayed out. "
^DIC(9.4,163,22,1,"PAH",241,1,24,0)=" When the same choices are not grayed out if viewed in CPRS."
^DIC(9.4,163,22,1,"PAH",241,1,25,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,26,0)=" Med Install guide references the wrong Key."
^DIC(9.4,163,22,1,"PAH",241,1,27,0)=" "
^DIC(9.4,163,22,1,"PAH",241,1,28,0)=" If a user attempted to retrieve two patients with the same names they"
^DIC(9.4,163,22,1,"PAH",241,1,29,0)=" would import correctly, but only one would be selectable in the patient"
^DIC(9.4,163,22,1,"PAH",241,1,30,0)=" selection dialog."
^DIC(9.4,163,22,1,"PAH",242,0)="269 SEQ #247^3130131.113307^17"
^DIC(9.4,163,22,1,"PAH",242,1,0)="^^1^1^3130131"
^DIC(9.4,163,22,1,"PAH",242,1,1,0)="This patch will address an undefined error - <UNDEFINED>PRNTSCRN+5^TIURA2"
^DIC(9.4,163,22,1,"PAH",243,0)="265^3130516.125603^17"
^DIC(9.4,163,22,1,"PAH",243,1,0)="^^2^2^3130516"
^DIC(9.4,163,22,1,"PAH",243,1,1,0)="The description of this build can be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",243,1,2,0)="under patch TIU*1*265."
^DIC(9.4,163,22,1,"PAH",244,0)="267 SEQ #249^3130516.174412^17"
^DIC(9.4,163,22,1,"PAH",244,1,0)="^^2^2^3130516"
^DIC(9.4,163,22,1,"PAH",244,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,163,22,1,"PAH",244,1,2,0)="under TIU*1*267."
^DIC(9.4,163,22,1,"PAH",245,0)="274 SEQ #250^3130624.113634^17"
^DIC(9.4,163,22,1,"PAH",245,1,0)="^^1^1^3130624"
^DIC(9.4,163,22,1,"PAH",245,1,1,0)="Prevent notes without text from being signed"
^DIC(9.4,163,22,1,"PAH",246,0)="275^3130829.111129^17"
^DIC(9.4,163,22,1,"PAH",246,1,0)="^^1^1^3130829"
^DIC(9.4,163,22,1,"PAH",246,1,1,0)="See patch description on FORUM for patch TIU*1.0*275."
^DIC(9.4,163,22,1,"PAH",247,0)="256 SEQ #252^3130904.165141^17"
^DIC(9.4,163,22,1,"PAH",247,1,0)="^^15^15^3130904"
^DIC(9.4,163,22,1,"PAH",247,1,1,0)="When a Nurse Intraoperative Report (NIR) or Anesthesia report is entered "
^DIC(9.4,163,22,1,"PAH",247,1,2,0)="and signed in the Surgery package, a note is created in Text Integration "
^DIC(9.4,163,22,1,"PAH",247,1,3,0)="Utility (TIU).  The note is created in file TIU DOCUMENT (8925).  If the "
^DIC(9.4,163,22,1,"PAH",247,1,4,0)="note is entered and signed mistakenly in the Surgery Package there is no"
^DIC(9.4,163,22,1,"PAH",247,1,5,0)="way to delete the note in either Surgery or TIU."
^DIC(9.4,163,22,1,"PAH",247,1,6,0)=" "
^DIC(9.4,163,22,1,"PAH",247,1,7,0)="This patch will allow Privacy Act Officers or MIS/HIM Chiefs to"
^DIC(9.4,163,22,1,"PAH",247,1,8,0)="delete/retract Nurse Intraoperative reports (NIR) or Anesthesia "
^DIC(9.4,163,22,1,"PAH",247,1,9,0)="reports (AR) from CPRS GUI - Surgery tab or in VistA through the "
^DIC(9.4,163,22,1,"PAH",247,1,10,0)="following options:"
^DIC(9.4,163,22,1,"PAH",247,1,11,0)=" "
^DIC(9.4,163,22,1,"PAH",247,1,12,0)="TIU BROWSE DOCUMENT MGR"
^DIC(9.4,163,22,1,"PAH",247,1,13,0)="TIU BROWSE DOCUMENT MRT"
^DIC(9.4,163,22,1,"PAH",247,1,14,0)="TIU SEARCH LIST MGR"
^DIC(9.4,163,22,1,"PAH",247,1,15,0)="TIU REVIEW SCREEN MIS MANAGER"
^DIC(9.4,163,22,1,"PAH",248,0)="276 SEQ #253^3130909.145526^17"
^DIC(9.4,163,22,1,"PAH",248,1,0)="^^5^5^3130909"
^DIC(9.4,163,22,1,"PAH",248,1,1,0)="This patch will resolve the following issues in the Text Integration"
^DIC(9.4,163,22,1,"PAH",248,1,2,0)="Utilities package:"
^DIC(9.4,163,22,1,"PAH",248,1,3,0)=" "
^DIC(9.4,163,22,1,"PAH",248,1,4,0)="-Inability to search for Expected Cosigner"
^DIC(9.4,163,22,1,"PAH",248,1,5,0)="-Error loading boilerplate text with attached template"
^DIC(9.4,163,22,1,"PAH",249,0)="272 SEQ #254^3130930.10185^17"
^DIC(9.4,163,22,1,"PAH",249,1,0)="^^4^4^3130930"
^DIC(9.4,163,22,1,"PAH",249,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,163,22,1,"PAH",249,1,2,0)="1) Completed documents are showing on TIU report of ""All My "
^DIC(9.4,163,22,1,"PAH",249,1,3,0)="Unsigned"" documents."
^DIC(9.4,163,22,1,"PAH",249,1,4,0)="2) GETFLD+2^TIUSRVF subscript errors"
^DIC(9.4,163,22,1,"PAH",250,0)="271 SEQ #255^3140106.16273^17"
^DIC(9.4,163,22,1,"PAH",250,1,0)="^^7^7^3140106"
^DIC(9.4,163,22,1,"PAH",250,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,163,22,1,"PAH",250,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",250,1,3,0)=" Users unable to find any results when searching for addenda using the "
^DIC(9.4,163,22,1,"PAH",250,1,4,0)=" Text Integration Utilities (MRT) [TIU MAIN MENU MRT] option"
^DIC(9.4,163,22,1,"PAH",250,1,5,0)=" "
^DIC(9.4,163,22,1,"PAH",250,1,6,0)=" String dates are being stored in the REFERENCE DATE field (#1301) of "
^DIC(9.4,163,22,1,"PAH",250,1,7,0)=" the TIU DOCUMENT file (#8925)."
^DIC(9.4,163,22,1,"PAH",251,0)="279^3140115.164356^17"
^DIC(9.4,163,22,1,"PAH",252,0)="278 SEQ #257^3140530.145223^17"
^DIC(9.4,163,22,1,"PAH",252,1,0)="^^5^5^3140530"
^DIC(9.4,163,22,1,"PAH",252,1,1,0)="This patch will resolve the following issues in the Text Integration"
^DIC(9.4,163,22,1,"PAH",252,1,2,0)="Utilities package:"
^DIC(9.4,163,22,1,"PAH",252,1,3,0)=" "
^DIC(9.4,163,22,1,"PAH",252,1,4,0)="-Redundant progress notes title display"
^DIC(9.4,163,22,1,"PAH",252,1,5,0)="-Spelling error in TIU Template field"
^DIC(9.4,163,22,1,"PAH",253,0)="283 SEQ #258^3140807.100737^17"
^DIC(9.4,163,22,1,"PAH",253,1,0)="^^1^1^3140807"
^DIC(9.4,163,22,1,"PAH",253,1,1,0)="TIU changes for the VIA project. See patch description for details."
^DIC(9.4,163,22,1,"PAH",254,0)="282 SEQ #259^3140807.100813^17"
^DIC(9.4,163,22,1,"PAH",254,1,0)="^^5^5^3140807"
^DIC(9.4,163,22,1,"PAH",254,1,1,0)="This patch will resolve the following issues in the Text Integration"
^DIC(9.4,163,22,1,"PAH",254,1,2,0)="Utility package:"
^DIC(9.4,163,22,1,"PAH",254,1,3,0)=" "
^DIC(9.4,163,22,1,"PAH",254,1,4,0)="-Cannot search for documents with multiple keywords"
^DIC(9.4,163,22,1,"PAH",254,1,5,0)="-Error saving TIU Document Parameter name"
^DIC(9.4,163,22,1,"PAH",255,0)="263^3140902.125255^17"
^DIC(9.4,163,22,1,"PAH",255,1,0)="^^2^2^3140902"
^DIC(9.4,163,22,1,"PAH",255,1,1,0)="The description of this build can be found under patch TIU*1*263 in the "
^DIC(9.4,163,22,1,"PAH",255,1,2,0)="National Patch Module."
^DIC(9.4,163,22,1,"PAH",256,0)="285 SEQ #261^3150203.101148^17"
^DIC(9.4,163,22,1,"PAH",256,1,0)="^^8^8^3150203"
^DIC(9.4,163,22,1,"PAH",256,1,1,0)="TIU FIX REPORT INDEX"
^DIC(9.4,163,22,1,"PAH",256,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",256,1,3,0)="This patch will resolve a problem with the TIU REVIEW MRT ADD SGNR "
^DIC(9.4,163,22,1,"PAH",256,1,4,0)="report.  The report was not displaying all documents with "
^DIC(9.4,163,22,1,"PAH",256,1,5,0)="unsigned additional signatures.  The underlying issue was found to be a "
^DIC(9.4,163,22,1,"PAH",256,1,6,0)="problem with the AC index in file 8925.7 (TIU MULTIPLE SIGNATURE).  This "
^DIC(9.4,163,22,1,"PAH",256,1,7,0)="patch corrects the report by fixing the deficiency with the AC index "
^DIC(9.4,163,22,1,"PAH",256,1,8,0)="logic.  The post install routine rebuilds the AC index."
^DIC(9.4,163,22,1,"PAH",257,0)="277 SEQ #262^3150421.123749^17"
^DIC(9.4,163,22,1,"PAH",257,1,0)="^^79^79^3150421"
^DIC(9.4,163,22,1,"PAH",257,1,1,0)="This patch will resolve the following issues in the Text Integration"
^DIC(9.4,163,22,1,"PAH",257,1,2,0)="Utilities package:"
^DIC(9.4,163,22,1,"PAH",257,1,3,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,4,0)="Allow the TIU DOCUMENT fields Author/Dictator and Attending Physician "
^DIC(9.4,163,22,1,"PAH",257,1,5,0)="(fields 1202 & "
^DIC(9.4,163,22,1,"PAH",257,1,6,0)="1209) to be populated into addendums to OPERATION REPORT documents."
^DIC(9.4,163,22,1,"PAH",257,1,7,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,8,0)="ASSOCIATED REMEDY TICKETS:"
^DIC(9.4,163,22,1,"PAH",257,1,9,0)="========================="
^DIC(9.4,163,22,1,"PAH",257,1,10,0)="        1. INC000000454162 - Uploaded documents create addendum without "
^DIC(9.4,163,22,1,"PAH",257,1,11,0)="an author"
^DIC(9.4,163,22,1,"PAH",257,1,12,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,13,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,14,0)="REMEDY TICKET OVERVIEW:"
^DIC(9.4,163,22,1,"PAH",257,1,15,0)="======================"
^DIC(9.4,163,22,1,"PAH",257,1,16,0)="1. INC000000454162"
^DIC(9.4,163,22,1,"PAH",257,1,17,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,18,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,19,0)="  Problem:"
^DIC(9.4,163,22,1,"PAH",257,1,20,0)="  -------"
^DIC(9.4,163,22,1,"PAH",257,1,21,0)="  If the system doesn't find a match for the patient and surgery case a "
^DIC(9.4,163,22,1,"PAH",257,1,22,0)="filing error is generated and you are able to "
^DIC(9.4,163,22,1,"PAH",257,1,23,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,24,0)="edit the document which will then populate the attending & dictated by "
^DIC(9.4,163,22,1,"PAH",257,1,25,0)="fields. If the document is uploaded and filed "
^DIC(9.4,163,22,1,"PAH",257,1,26,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,27,0)="successfully the attending and dictated by fields are blank.   "
^DIC(9.4,163,22,1,"PAH",257,1,28,0)="TIU*1.0*173 prevented these fields from being populated "
^DIC(9.4,163,22,1,"PAH",257,1,29,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,30,0)="during the upload process, which is correct, but didn't allow these "
^DIC(9.4,163,22,1,"PAH",257,1,31,0)="fields need to be populated when an addendum is created."
^DIC(9.4,163,22,1,"PAH",257,1,32,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,33,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,34,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,35,0)="  Resolution:"
^DIC(9.4,163,22,1,"PAH",257,1,36,0)="  ----------"
^DIC(9.4,163,22,1,"PAH",257,1,37,0)="  Check if the uploaded OPERATIVE REPORT is an addendum to an existing "
^DIC(9.4,163,22,1,"PAH",257,1,38,0)="document, allow the Dictator/Author and Attending fields to be populated."
^DIC(9.4,163,22,1,"PAH",257,1,39,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,40,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,41,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,42,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,43,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,44,0)="       ================INSTALLATION INSTRUCTIONS ================="
^DIC(9.4,163,22,1,"PAH",257,1,45,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,46,0)="It is not necessary to disable any options. It is recommended to install "
^DIC(9.4,163,22,1,"PAH",257,1,47,0)="this patch when users are off the system.  It should take less than 2"
^DIC(9.4,163,22,1,"PAH",257,1,48,0)="minutes to install this patch."
^DIC(9.4,163,22,1,"PAH",257,1,49,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,50,0)="   1. Choose the PackMan message containing this patch and invoke the"
^DIC(9.4,163,22,1,"PAH",257,1,51,0)="      INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,163,22,1,"PAH",257,1,52,0)="  "
^DIC(9.4,163,22,1,"PAH",257,1,53,0)="   2. From the Kernel Installation & Distribution System menu, select "
^DIC(9.4,163,22,1,"PAH",257,1,54,0)="      the Installation menu.  "
^DIC(9.4,163,22,1,"PAH",257,1,55,0)="  "
^DIC(9.4,163,22,1,"PAH",257,1,56,0)="   3. From this menu, you may select to use the following options: "
^DIC(9.4,163,22,1,"PAH",257,1,57,0)="      (when prompted for INSTALL NAME, enter TIU*1.0*277)"
^DIC(9.4,163,22,1,"PAH",257,1,58,0)="  "
^DIC(9.4,163,22,1,"PAH",257,1,59,0)="        a.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,163,22,1,"PAH",257,1,60,0)="            you to ensure the integrity of the routines that are in the"
^DIC(9.4,163,22,1,"PAH",257,1,61,0)="            transport global."
^DIC(9.4,163,22,1,"PAH",257,1,62,0)="        b.  Print Transport Global - This option will allow you to view"
^DIC(9.4,163,22,1,"PAH",257,1,63,0)="            the components of the KIDS build."
^DIC(9.4,163,22,1,"PAH",257,1,64,0)="        c.  Compare Transport Global to Current System - This option will"
^DIC(9.4,163,22,1,"PAH",257,1,65,0)="            allow you to view all changes that will be made when this "
^DIC(9.4,163,22,1,"PAH",257,1,66,0)="            patch is installed.  It compares all components of this patch"
^DIC(9.4,163,22,1,"PAH",257,1,67,0)="            (routines, DD's, templates, etc.)."
^DIC(9.4,163,22,1,"PAH",257,1,68,0)="        d.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,163,22,1,"PAH",257,1,69,0)="            message of any routines exported with this patch. It will not"
^DIC(9.4,163,22,1,"PAH",257,1,70,0)="            backup any other changes such as DD's or templates."
^DIC(9.4,163,22,1,"PAH",257,1,71,0)="  "
^DIC(9.4,163,22,1,"PAH",257,1,72,0)="   4. Use the Install Package(s) option and select the package "
^DIC(9.4,163,22,1,"PAH",257,1,73,0)="      TIU*1.0*277."
^DIC(9.4,163,22,1,"PAH",257,1,74,0)=" "
^DIC(9.4,163,22,1,"PAH",257,1,75,0)="   5. When Prompted ""Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,163,22,1,"PAH",257,1,76,0)="      NO//"" respond NO.  "
^DIC(9.4,163,22,1,"PAH",257,1,77,0)="  "
^DIC(9.4,163,22,1,"PAH",257,1,78,0)="   6. When Prompted ""Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,163,22,1,"PAH",257,1,79,0)="      Protocols? NO//"" respond NO."
^DIC(9.4,163,22,1,"PAH",258,0)="295 SEQ #263^3151027.133829^17"
^DIC(9.4,163,22,1,"PAH",258,1,0)="^^6^6^3151027"
^DIC(9.4,163,22,1,"PAH",258,1,1,0)="This patch will resolve the following issues in the Text Integration"
^DIC(9.4,163,22,1,"PAH",258,1,2,0)="Utilities package:"
^DIC(9.4,163,22,1,"PAH",258,1,3,0)=" "
^DIC(9.4,163,22,1,"PAH",258,1,4,0)="1) The reasignment of TIU documents can be required to be accomplished "
^DIC(9.4,163,22,1,"PAH",258,1,5,0)="twice before the reassign is successfull."
^DIC(9.4,163,22,1,"PAH",258,1,6,0)="2) Error occurs in TIUSRVR1 when TIUDA is passed in null"
^DIC(9.4,163,22,1,"PAH",259,0)="268^3160310.154321^54"
^DIC(9.4,163,22,1,"PAH",259,1,0)="^^2^2^3160310"
^DIC(9.4,163,22,1,"PAH",259,1,1,0)="This patch corrects an issue with the honoring of the ALLOW"
^DIC(9.4,163,22,1,"PAH",259,1,2,0)="CHART PRINT OUTSIDE MAS parameter."
^DIC(9.4,163,22,1,"PAH",260,0)="296 SEQ #265^3160405.114512^54"
^DIC(9.4,163,22,1,"PAH",260,1,0)="^^39^39^3160405"
^DIC(9.4,163,22,1,"PAH",260,1,1,0)="The TIU*1.0*296 patch entails modifying the Computerized Patient Record"
^DIC(9.4,163,22,1,"PAH",260,1,2,0)="System (CPRS) Consult/Request Tracking package to send a Text Integration"
^DIC(9.4,163,22,1,"PAH",260,1,3,0)="Utilities (TIU) alert to the appropriate service provider immediately"
^DIC(9.4,163,22,1,"PAH",260,1,4,0)="after a non-clinical staff member screens a patient and signs the"
^DIC(9.4,163,22,1,"PAH",260,1,5,0)="associated CPRS note"
^DIC(9.4,163,22,1,"PAH",260,1,6,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,7,0)="This functionality is needed so that after non-clinical staff members have"
^DIC(9.4,163,22,1,"PAH",260,1,8,0)="screened patients for potential risks (weight loss or gain, homelessness,"
^DIC(9.4,163,22,1,"PAH",260,1,9,0)="substance abuse, etc.), the service provider will be alerted prior to the"
^DIC(9.4,163,22,1,"PAH",260,1,10,0)="note being co-signed by the licensed clinician responsible for reviewing"
^DIC(9.4,163,22,1,"PAH",260,1,11,0)="and approving the note. "
^DIC(9.4,163,22,1,"PAH",260,1,12,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,13,0)="Prior to this modification, no TIU alerts were sent to the service "
^DIC(9.4,163,22,1,"PAH",260,1,14,0)="providers. This resulted in missed opportunities to provide needed "
^DIC(9.4,163,22,1,"PAH",260,1,15,0)="services for patients while the patients are on site, and forced staff to "
^DIC(9.4,163,22,1,"PAH",260,1,16,0)="take time to contact patients and reschedule needed services"
^DIC(9.4,163,22,1,"PAH",260,1,17,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,18,0)="This patch utilizes one new file (TIU TEXT EVENTS (#8925.71)) used to"
^DIC(9.4,163,22,1,"PAH",260,1,19,0)="define the words or phrase that will be searched for in a TIU document "
^DIC(9.4,163,22,1,"PAH",260,1,20,0)="(progress note, consult, etc.). If the words or phrase are found in the "
^DIC(9.4,163,22,1,"PAH",260,1,21,0)="TIU document, then an alert is sent to the individual or team specified in"
^DIC(9.4,163,22,1,"PAH",260,1,22,0)="the TIU TEXT EVENTS file. "
^DIC(9.4,163,22,1,"PAH",260,1,23,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,24,0)="One new menu option-Text Event Edit [TIU TEXT EVENT EDIT]-will be added "
^DIC(9.4,163,22,1,"PAH",260,1,25,0)="to the TIU Maintenance Menu [TIU IRM MAINTENANCE MENU]. This option is "
^DIC(9.4,163,22,1,"PAH",260,1,26,0)="used only to set up a text event in the TIU TEXT EVENTS file."
^DIC(9.4,163,22,1,"PAH",260,1,27,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,28,0)="***IMPORTANT***: Any TIU document that is to be used for these alerts MUST"
^DIC(9.4,163,22,1,"PAH",260,1,29,0)="have the MUMPS code 'D TASK^TIUTIUS(DA)' entered in the POST-SIGNATURE"
^DIC(9.4,163,22,1,"PAH",260,1,30,0)="CODE (#4.9) field in the TIU DOCUMENT DEFINITION (#8925.1) file."
^DIC(9.4,163,22,1,"PAH",260,1,31,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,32,0)="This patch will work in both CPRS GUI and the VistA system."
^DIC(9.4,163,22,1,"PAH",260,1,33,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,34,0)="The NSR for this intake addresses the following requirements:"
^DIC(9.4,163,22,1,"PAH",260,1,35,0)=" "
^DIC(9.4,163,22,1,"PAH",260,1,36,0)="    VHBAO: NEED2949: Provide the ability for users to send TIU text alerts"
^DIC(9.4,163,22,1,"PAH",260,1,37,0)="                     created by non-clinical staff in CPRS to service"
^DIC(9.4,163,22,1,"PAH",260,1,38,0)="                     providers before being co-signed by a licensed"
^DIC(9.4,163,22,1,"PAH",260,1,39,0)="                     clinician."
^DIC(9.4,163,22,1,"PAH",261,0)="106^3160407.160229^54"
^DIC(9.4,163,22,1,"PAH",261,1,0)="^^1^1^3160407"
^DIC(9.4,163,22,1,"PAH",261,1,1,0)="Support for VPR"
^DIC(9.4,163,22,1,"PAH",262,0)="298^3160407.160229^54"
^DIC(9.4,163,22,1,"PAH",263,0)="286 SEQ #268^3160418.151538^54"
^DIC(9.4,163,22,1,"PAH",263,1,0)="^^7^7^3160418"
^DIC(9.4,163,22,1,"PAH",263,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,163,22,1,"PAH",263,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",263,1,3,0)="  1) AUTHORIZATION/SUBSCRIPTION UTILITY (ASU) CLINICAL COORDINATOR MANUAL"
^DIC(9.4,163,22,1,"PAH",263,1,4,0)="     documentation changes"
^DIC(9.4,163,22,1,"PAH",263,1,5,0)="  2) Date range search options in TIU will reset the date range"
^DIC(9.4,163,22,1,"PAH",263,1,6,0)="  3) Incorrect Philippines address format"
^DIC(9.4,163,22,1,"PAH",263,1,7,0)="  4) Routine TIUSRVR2 does not contain 211 on the 2nd line"
^DIC(9.4,163,22,1,"PAH",264,0)="291 SEQ #269^3160421.113711^54"
^DIC(9.4,163,22,1,"PAH",264,1,0)="^^1^1^3160421"
^DIC(9.4,163,22,1,"PAH",264,1,1,0)="This patch implements the CWAD AUTO-DEMOTION functionality."
^DIC(9.4,163,22,1,"PAH",265,0)="300 SEQ #270^3160504.125355^54"
^DIC(9.4,163,22,1,"PAH",266,0)="304 SEQ #271^3160819.161956^54"
^DIC(9.4,163,22,1,"PAH",266,1,0)="^^1^1^3160819"
^DIC(9.4,163,22,1,"PAH",266,1,1,0)="Correct cause of error <UNDEFINED> PRINT+23^GMRCTIUP"
^DIC(9.4,163,22,1,"PAH",267,0)="306 SEQ #272^3160916.134221^54"
^DIC(9.4,163,22,1,"PAH",267,1,0)="^^1^1^3160916"
^DIC(9.4,163,22,1,"PAH",267,1,1,0)="TIU RPC updates for VIAB*1*7."
^DIC(9.4,163,22,1,"PAH",268,0)="288 SEQ #273^3160923.155534^54"
^DIC(9.4,163,22,1,"PAH",268,1,0)="^^4^4^3160923"
^DIC(9.4,163,22,1,"PAH",268,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,163,22,1,"PAH",268,1,2,0)="1) Document parameters cannot be deleted."
^DIC(9.4,163,22,1,"PAH",268,1,3,0)="2) Multiple TIU DOCUMENT PARAMETER records can be created"
^DIC(9.4,163,22,1,"PAH",268,1,4,0)="3) TIU report display more documents types than requested"
^DIC(9.4,163,22,1,"PAH",269,0)="309 SEQ #275^3170504.172753^54"
^DIC(9.4,163,22,1,"PAH",269,1,0)="^^1^1^3170504"
^DIC(9.4,163,22,1,"PAH",269,1,1,0)="See National Patch Module for details."
^DIC(9.4,163,22,1,"PAH",270,0)="311 SEQ #276^3170627.151755^54"
^DIC(9.4,163,22,1,"PAH",270,1,0)="^^4^4^3170627"
^DIC(9.4,163,22,1,"PAH",270,1,1,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,163,22,1,"PAH",270,1,2,0)="(2FA) compliant, the Mobile Electronic Documentation (MED) Graphical User "
^DIC(9.4,163,22,1,"PAH",270,1,3,0)="Interface (GUI) requires an upgrade to Delphi version XE8 in order to"
^DIC(9.4,163,22,1,"PAH",270,1,4,0)="implement the, new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,163,22,1,"PAH",271,0)="258^3170726.13111^54"
^DIC(9.4,163,22,1,"PAH",271,1,0)="^^2^2^3170726"
^DIC(9.4,163,22,1,"PAH",271,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",271,1,2,0)="under TIU*1*258."
^DIC(9.4,163,22,1,"PAH",272,0)="297 SEQ #278^3170726.162208^54"
^DIC(9.4,163,22,1,"PAH",273,0)="301 SEQ #279^3171005.122233^54"
^DIC(9.4,163,22,1,"PAH",273,1,0)="^^146^146^3171005"
^DIC(9.4,163,22,1,"PAH",273,1,1,0)="This patch will address a problem with consult notes being assigned"
^DIC(9.4,163,22,1,"PAH",273,1,2,0)="to an incorrect patient's chart as a result of post install instructions"
^DIC(9.4,163,22,1,"PAH",273,1,3,0)="for patch TIU*1.0*131 not being completed."
^DIC(9.4,163,22,1,"PAH",273,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,5,0)="Associated CA SDM ticket(s):"
^DIC(9.4,163,22,1,"PAH",273,1,6,0)="============================"
^DIC(9.4,163,22,1,"PAH",273,1,7,0)="I10273633FY16"
^DIC(9.4,163,22,1,"PAH",273,1,8,0)=" INC000001014575(d)"
^DIC(9.4,163,22,1,"PAH",273,1,9,0)=" PSPO #2595"
^DIC(9.4,163,22,1,"PAH",273,1,10,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,11,0)="Associated NSR(s):"
^DIC(9.4,163,22,1,"PAH",273,1,12,0)="=================="
^DIC(9.4,163,22,1,"PAH",273,1,13,0)="N/A"
^DIC(9.4,163,22,1,"PAH",273,1,14,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,15,0)="Test Sites:"
^DIC(9.4,163,22,1,"PAH",273,1,16,0)="==========="
^DIC(9.4,163,22,1,"PAH",273,1,17,0)="TBD"
^DIC(9.4,163,22,1,"PAH",273,1,18,0)="   "
^DIC(9.4,163,22,1,"PAH",273,1,19,0)="SDM Ticket Overview:"
^DIC(9.4,163,22,1,"PAH",273,1,20,0)="===================="
^DIC(9.4,163,22,1,"PAH",273,1,21,0)="I10273633FY16 - Exact same note appearing on two different charts."
^DIC(9.4,163,22,1,"PAH",273,1,22,0)="  "
^DIC(9.4,163,22,1,"PAH",273,1,23,0)="Problem: "
^DIC(9.4,163,22,1,"PAH",273,1,24,0)="========"
^DIC(9.4,163,22,1,"PAH",273,1,25,0)="The same consult note is documented in the correct patient chart as well"
^DIC(9.4,163,22,1,"PAH",273,1,26,0)="as an incorrect patient chart, due to an incorrect consult number and an"
^DIC(9.4,163,22,1,"PAH",273,1,27,0)="incorrect parameter value used when uploading the note through TIU.  It"
^DIC(9.4,163,22,1,"PAH",273,1,28,0)="was determined that this is a result of post install instructions for"
^DIC(9.4,163,22,1,"PAH",273,1,29,0)="patch TIU*1.0*131 not being followed leaving the TIU DOCUMENT "
^DIC(9.4,163,22,1,"PAH",273,1,30,0)="DEFINITIONS Progress Notes and Consults records with incorrect values in"
^DIC(9.4,163,22,1,"PAH",273,1,31,0)="field 4.8 (UPLOAD FILING ERROR CODE).  The upload would not be filed and"
^DIC(9.4,163,22,1,"PAH",273,1,32,0)="generate an error instead had the post install instructions for patch"
^DIC(9.4,163,22,1,"PAH",273,1,33,0)="TIU*1.0*131 been completed."
^DIC(9.4,163,22,1,"PAH",273,1,34,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,35,0)="Resolution:"
^DIC(9.4,163,22,1,"PAH",273,1,36,0)="==========="
^DIC(9.4,163,22,1,"PAH",273,1,37,0)="This patch will run a post install routine.  The post install routine"
^DIC(9.4,163,22,1,"PAH",273,1,38,0)="will review the PROGRESS NOTES class and CONSULTS document class (or"
^DIC(9.4,163,22,1,"PAH",273,1,39,0)="CONSULTS class) and all entries within them in the TIU Document "
^DIC(9.4,163,22,1,"PAH",273,1,40,0)="Definitions file (8925.1). "
^DIC(9.4,163,22,1,"PAH",273,1,41,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,42,0)="The details of the install routine are as follows:"
^DIC(9.4,163,22,1,"PAH",273,1,43,0)=" - If the current value of the UPLOAD FILING ERROR CODE (field 4.8) for"
^DIC(9.4,163,22,1,"PAH",273,1,44,0)="   PROGRESS NOTES (and all document definitions under it) equals the"
^DIC(9.4,163,22,1,"PAH",273,1,45,0)="   pre-patch TIU*1.0*131 value of ""D GETPN^TIUCHLP"" it will be changed to "
^DIC(9.4,163,22,1,"PAH",273,1,46,0)="   ""D PNFIX^TIUPNFIX"" (if the record is not locked)."
^DIC(9.4,163,22,1,"PAH",273,1,47,0)=" - If the current value of the UPLOAD FILING ERROR CODE (field 4.8) "
^DIC(9.4,163,22,1,"PAH",273,1,48,0)="   for CONSULTS (and all document definitions under it) equals the"
^DIC(9.4,163,22,1,"PAH",273,1,49,0)="   pre-patch TIU*1.0*131 value of ""D GETPN^TIUCHLP"" it will be changed to"
^DIC(9.4,163,22,1,"PAH",273,1,50,0)="   ""D CNFIX^TIUCNFIX"" (if the record is not locked)."
^DIC(9.4,163,22,1,"PAH",273,1,51,0)=" - If a record has the pre-patch TIU*1.0*131 value and cannot be updated "
^DIC(9.4,163,22,1,"PAH",273,1,52,0)="   due to being locked it will need to be manually corrected."
^DIC(9.4,163,22,1,"PAH",273,1,53,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,54,0)="The below example information will be included in the mail message"
^DIC(9.4,163,22,1,"PAH",273,1,55,0)="to any user defined as a member of VistA mail groups"
^DIC(9.4,163,22,1,"PAH",273,1,56,0)="'PATIENT SAFETY NOTIFICATIONS' and 'TIU CACS' as well as to the user"
^DIC(9.4,163,22,1,"PAH",273,1,57,0)="running the installation:"
^DIC(9.4,163,22,1,"PAH",273,1,58,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,59,0)="  Subj: PATCH TIU*1.0*301 "
^DIC(9.4,163,22,1,"PAH",273,1,60,0)="  From: PATCH TIU*1.0*301  In 'IN' basket.   Page 1  "
^DIC(9.4,163,22,1,"PAH",273,1,61,0)="--------------------------------------------------------------------------"
^DIC(9.4,163,22,1,"PAH",273,1,62,0)="  This patch reviews field 4.8 (UPLOAD FILING ERROR CODE) in the TIU "
^DIC(9.4,163,22,1,"PAH",273,1,63,0)="  DOCUMENT DEFINITIONS file for document classes and titles belonging to"
^DIC(9.4,163,22,1,"PAH",273,1,64,0)="  CONSULTS and PROGRESS NOTES and are addressed as follows: "
^DIC(9.4,163,22,1,"PAH",273,1,65,0)="    1.  CONSULTS with the pre-patch TIU*1.0*131 value of 'D GETPN^TIUCHLP'"
^DIC(9.4,163,22,1,"PAH",273,1,66,0)="        are changed to 'D CNFIX^TIUCNFIX'"
^DIC(9.4,163,22,1,"PAH",273,1,67,0)="    2.  PROGRESS NOTES with the pre-patch TIU*1.0*131 value of "
^DIC(9.4,163,22,1,"PAH",273,1,68,0)="        'D GETPN^TIUCHLP' are changed to 'D PNFIX^TIUPNFIX'.  "
^DIC(9.4,163,22,1,"PAH",273,1,69,0)="    3.  Any CONSULTS or PROGRESS NOTES with field 4.8 without a value are"
^DIC(9.4,163,22,1,"PAH",273,1,70,0)="        not changed."
^DIC(9.4,163,22,1,"PAH",273,1,71,0)="    4.  Any CONSULTS or PROGRESS NOTES with the pre-patch TIU*1.0*131 "
^DIC(9.4,163,22,1,"PAH",273,1,72,0)="        value of 'D GETPN^TIUCHLP' that are locked during the install"
^DIC(9.4,163,22,1,"PAH",273,1,73,0)="        NEED TO BE MANUALLY UPDATED using option TIU UPLOAD PARAMETER "
^DIC(9.4,163,22,1,"PAH",273,1,74,0)="        EDIT."
^DIC(9.4,163,22,1,"PAH",273,1,75,0)="    5.  Any document definitions with a value other than 'D GETPN^TIUCHLP'"
^DIC(9.4,163,22,1,"PAH",273,1,76,0)="        are not updated."
^DIC(9.4,163,22,1,"PAH",273,1,77,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,78,0)="  **IMPORTANT NOTE**  The 'Enhanced Mismatched Consults List' [TIU144"
^DIC(9.4,163,22,1,"PAH",273,1,79,0)="  ENHANCED MISMATCH LIST] should be run regularly. Please take a moment "
^DIC(9.4,163,22,1,"PAH",273,1,80,0)="  now to run it and create a reminder in your calendar to run it again"
^DIC(9.4,163,22,1,"PAH",273,1,81,0)="  every 6 months.  If there are any mismatches, submit a help desk"
^DIC(9.4,163,22,1,"PAH",273,1,82,0)="  ticket for assistance resolving them."
^DIC(9.4,163,22,1,"PAH",273,1,83,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,84,0)="   PATCH TIU*1.0*301 INSTALL"
^DIC(9.4,163,22,1,"PAH",273,1,85,0)="      UPLOAD FILING ERROR CODE (Field 4.8) Review:"
^DIC(9.4,163,22,1,"PAH",273,1,86,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,87,0)="      IEN  Document Name (Type)"
^DIC(9.4,163,22,1,"PAH",273,1,88,0)="           Result"
^DIC(9.4,163,22,1,"PAH",273,1,89,0)="   --------------------------------------------"
^DIC(9.4,163,22,1,"PAH",273,1,90,0)="   CONSULTS:"
^DIC(9.4,163,22,1,"PAH",273,1,91,0)="      767  CONSULTS (DOCUMENT CLASS)"
^DIC(9.4,163,22,1,"PAH",273,1,92,0)="           D GETPN^TIUCHLP changed to D CNFIX^TIUCNFIX"
^DIC(9.4,163,22,1,"PAH",273,1,93,0)="      788  OPTOMETRY EYE CONSULT REPORT (TITLE)"
^DIC(9.4,163,22,1,"PAH",273,1,94,0)="           D GETPN^TIUCHLP changed to D CNFIX^TIUCNFIX"
^DIC(9.4,163,22,1,"PAH",273,1,95,0)="     1800  OPHTHALMOLOGY EYE CONSULT REPORT - PRALL (TITLE)"
^DIC(9.4,163,22,1,"PAH",273,1,96,0)="           The record is currently locked."
^DIC(9.4,163,22,1,"PAH",273,1,97,0)="           Needs to be manually updated to D CNFIX^TIUCNFIX"
^DIC(9.4,163,22,1,"PAH",273,1,98,0)="   PROGRESS NOTES:"
^DIC(9.4,163,22,1,"PAH",273,1,99,0)="        3  PROGRESS NOTES (CLASS)"
^DIC(9.4,163,22,1,"PAH",273,1,100,0)="           D GETPN^TIUCHLP changed to D PNFIX^TIUPNFIX"
^DIC(9.4,163,22,1,"PAH",273,1,101,0)="     1331  C&P MEDICAL (TITLE)"
^DIC(9.4,163,22,1,"PAH",273,1,102,0)="           No change.  Value is already D PNFIX^TIUPNFIX"
^DIC(9.4,163,22,1,"PAH",273,1,103,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,104,0)="   "
^DIC(9.4,163,22,1,"PAH",273,1,105,0)="     ================INSTALLATION INSTRUCTIONS ================="
^DIC(9.4,163,22,1,"PAH",273,1,106,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,107,0)="It is not necessary to disable any options.  Users should not edit TIU "
^DIC(9.4,163,22,1,"PAH",273,1,108,0)="document definitions during the install. It should take less than "
^DIC(9.4,163,22,1,"PAH",273,1,109,0)="2 minutes to install this patch."
^DIC(9.4,163,22,1,"PAH",273,1,110,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,111,0)="   1. Ensure there are appropriate active user entries as members of both "
^DIC(9.4,163,22,1,"PAH",273,1,112,0)="      VistA mail groups 'PATIENT SAFETY NOTIFICATIONS' and 'TIU CACS'."
^DIC(9.4,163,22,1,"PAH",273,1,113,0)="      This can be accomplished using option 'Mail Group Edit' on the"
^DIC(9.4,163,22,1,"PAH",273,1,114,0)="      Group/Distribution Management menu."
^DIC(9.4,163,22,1,"PAH",273,1,115,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,116,0)="   2. Choose the PackMan message containing this patch and invoke the"
^DIC(9.4,163,22,1,"PAH",273,1,117,0)="      INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,163,22,1,"PAH",273,1,118,0)="  "
^DIC(9.4,163,22,1,"PAH",273,1,119,0)="   3. From the Kernel Installation & Distribution System menu, select "
^DIC(9.4,163,22,1,"PAH",273,1,120,0)="      the Installation menu.  "
^DIC(9.4,163,22,1,"PAH",273,1,121,0)="  "
^DIC(9.4,163,22,1,"PAH",273,1,122,0)="   4. From this menu, you may select to use the following options: "
^DIC(9.4,163,22,1,"PAH",273,1,123,0)="      (when prompted for INSTALL NAME, enter TIU*1.0*301)"
^DIC(9.4,163,22,1,"PAH",273,1,124,0)="  "
^DIC(9.4,163,22,1,"PAH",273,1,125,0)="        a.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,163,22,1,"PAH",273,1,126,0)="            you to ensure the integrity of the routines that are in the"
^DIC(9.4,163,22,1,"PAH",273,1,127,0)="            transport global."
^DIC(9.4,163,22,1,"PAH",273,1,128,0)="        b.  Print Transport Global - This option will allow you to view"
^DIC(9.4,163,22,1,"PAH",273,1,129,0)="            the components of the KIDS build."
^DIC(9.4,163,22,1,"PAH",273,1,130,0)="        c.  Compare Transport Global to Current System - This option will"
^DIC(9.4,163,22,1,"PAH",273,1,131,0)="            allow you to view all changes that will be made when this "
^DIC(9.4,163,22,1,"PAH",273,1,132,0)="            patch is installed.  It compares all components of this"
^DIC(9.4,163,22,1,"PAH",273,1,133,0)="            patch (routines, DD's, templates, etc.)."
^DIC(9.4,163,22,1,"PAH",273,1,134,0)="        d.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,163,22,1,"PAH",273,1,135,0)="            message of any routines exported with this patch. It will not"
^DIC(9.4,163,22,1,"PAH",273,1,136,0)="            backup any other changes such as DD's or templates."
^DIC(9.4,163,22,1,"PAH",273,1,137,0)="  "
^DIC(9.4,163,22,1,"PAH",273,1,138,0)="   5. Use the Install Package(s) option and select the package TIU*1.0*301"
^DIC(9.4,163,22,1,"PAH",273,1,139,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,140,0)="   6. When Prompted ""Rebuild Menu Tree Upon Completion: NO// respond NO."
^DIC(9.4,163,22,1,"PAH",273,1,141,0)=" "
^DIC(9.4,163,22,1,"PAH",273,1,142,0)="   7. When Prompted ""Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,163,22,1,"PAH",273,1,143,0)="      NO//"" respond NO.  "
^DIC(9.4,163,22,1,"PAH",273,1,144,0)="  "
^DIC(9.4,163,22,1,"PAH",273,1,145,0)="   8. When Prompted ""Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,163,22,1,"PAH",273,1,146,0)="      Protocols? NO//"" respond NO."
^DIC(9.4,163,22,1,"PAH",274,0)="312 SEQ #280^3171127.133727^54"
^DIC(9.4,163,22,1,"PAH",274,1,0)="^^2^2^3171127"
^DIC(9.4,163,22,1,"PAH",274,1,1,0)="This patch will address errors encountered during background HL7 "
^DIC(9.4,163,22,1,"PAH",274,1,2,0)="processing of incoming TIU Progress Notes (HL7 MDM messages)"
^DIC(9.4,163,22,1,"PAH",275,0)="314 SEQ #281^3171227.175941^54"
^DIC(9.4,163,22,1,"PAH",275,1,0)="^^1^1^3171227"
^DIC(9.4,163,22,1,"PAH",275,1,1,0)="edit destination encounter Reassigning a visit"
^DIC(9.4,163,22,1,"PAH",276,0)="299 SEQ #282^3180424.162512^54"
^DIC(9.4,163,22,1,"PAH",276,1,0)="^^1^1^3180424"
^DIC(9.4,163,22,1,"PAH",276,1,1,0)="TIU INDEX FIXES AND DOCUMENTATION CORRECTIONS"
^DIC(9.4,163,22,1,"PAH",277,0)="287 SEQ #283^3180601.162621^54"
^DIC(9.4,163,22,1,"PAH",277,1,0)="^^3^3^3180601"
^DIC(9.4,163,22,1,"PAH",277,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,163,22,1,"PAH",277,1,2,0)="1) Document definition title displaying incorrect mapped title "
^DIC(9.4,163,22,1,"PAH",277,1,3,0)="2) TIU object TIU TPBN ACT OUT MEDS not initializing data"
^DIC(9.4,163,22,1,"PAH",278,0)="315 SEQ #285^3180803.150937^54"
^DIC(9.4,163,22,1,"PAH",278,1,0)="^^9^9^3180803"
^DIC(9.4,163,22,1,"PAH",278,1,1,0)="During the testing of this patch it was noted that the MED "
^DIC(9.4,163,22,1,"PAH",278,1,2,0)="application violated a security policy by allowing the application to "
^DIC(9.4,163,22,1,"PAH",278,1,3,0)="write to the database that is stored in the program files folder. "
^DIC(9.4,163,22,1,"PAH",278,1,4,0)="This patch will correct this vulnerability by moving the database to "
^DIC(9.4,163,22,1,"PAH",278,1,5,0)="a natural location so the application can interact with it."
^DIC(9.4,163,22,1,"PAH",278,1,6,0)=" "
^DIC(9.4,163,22,1,"PAH",278,1,7,0)="This patch will resolve the following issue in the Mobile Electronic"
^DIC(9.4,163,22,1,"PAH",278,1,8,0)="Document application:"
^DIC(9.4,163,22,1,"PAH",278,1,9,0)="- No notes to import into CPRS via Med Import feature"
^DIC(9.4,163,22,1,"PAH",279,0)="305 SEQ #286^3190103.16554^54"
^DIC(9.4,163,22,1,"PAH",279,1,0)="^^15^15^3190103"
^DIC(9.4,163,22,1,"PAH",279,1,1,0)="This build addresses NSR20080310 and NSR20141017 respectively. It "
^DIC(9.4,163,22,1,"PAH",279,1,2,0)="consists of the following options:"
^DIC(9.4,163,22,1,"PAH",279,1,3,0)="Contingency Downtime Bookmark Progress Notes [TIU DOWNTIME BOOKMARK PN]"
^DIC(9.4,163,22,1,"PAH",279,1,4,0)="Create Post-Signature Alerts [TIUFPC CREATE POST-SIGNATURE]"
^DIC(9.4,163,22,1,"PAH",279,1,5,0)="When this patch is installed at the sites, it will check file #8925.1, "
^DIC(9.4,163,22,1,"PAH",279,1,6,0)="field #3 (Boilerplate Text), for any existing text and delete it to make "
^DIC(9.4,163,22,1,"PAH",279,1,7,0)="room for the new text exported with the patch. Sites will be able to see "
^DIC(9.4,163,22,1,"PAH",279,1,8,0)="the old text in the install file kept by KIDS after installation has been "
^DIC(9.4,163,22,1,"PAH",279,1,9,0)="completed. The pre-installation routine will check for the mapping of a "
^DIC(9.4,163,22,1,"PAH",279,1,10,0)="local title to the national title Computer Downtime. If no local title is "
^DIC(9.4,163,22,1,"PAH",279,1,11,0)="found, the installer of the patch will be alerted to complete the mapping "
^DIC(9.4,163,22,1,"PAH",279,1,12,0)="of one local title to Computer Downtime before attempting to reinstall "
^DIC(9.4,163,22,1,"PAH",279,1,13,0)="the patch. Whether or not the site has a local title mapped to the "
^DIC(9.4,163,22,1,"PAH",279,1,14,0)="national title Computer Downtime, the installation of the patch will"
^DIC(9.4,163,22,1,"PAH",279,1,15,0)="proceed to completion."
^DIC(9.4,163,22,1,"PAH",280,0)="323 SEQ #288^3190815.160444^65"
^DIC(9.4,163,22,1,"PAH",280,1,0)="^^43^43^3190815"
^DIC(9.4,163,22,1,"PAH",280,1,1,0)=" "
^DIC(9.4,163,22,1,"PAH",280,1,2,0)=" The Community Care Referrals and Authorizations (CCR&A) application is "
^DIC(9.4,163,22,1,"PAH",280,1,3,0)=" an enterprise-wide system used by Community Care (CC) staff to "
^DIC(9.4,163,22,1,"PAH",280,1,4,0)=" automatically generate referrals and authorizations for all Veterans "
^DIC(9.4,163,22,1,"PAH",280,1,5,0)=" receiving care in the community. Clinical and VA CC staff located at VA "
^DIC(9.4,163,22,1,"PAH",280,1,6,0)=" Medical Centers, Outpatient Clinics, Community Based Outpatient Clinics, "
^DIC(9.4,163,22,1,"PAH",280,1,7,0)=" and VISN offices use this application.  The CCR&A solution is an "
^DIC(9.4,163,22,1,"PAH",280,1,8,0)="integral "
^DIC(9.4,163,22,1,"PAH",280,1,9,0)=" component of the VA Community Care Information Technology "
^DIC(9.4,163,22,1,"PAH",280,1,10,0)=" (IT) architecture that allows Veterans to receive care from Community "
^DIC(9.4,163,22,1,"PAH",280,1,11,0)=" Providers. "
^DIC(9.4,163,22,1,"PAH",280,1,12,0)=" "
^DIC(9.4,163,22,1,"PAH",280,1,13,0)=" This patch builds upon the HL7 processes created in patches GMRC*3.0*99 "
^DIC(9.4,163,22,1,"PAH",280,1,14,0)="and"
^DIC(9.4,163,22,1,"PAH",280,1,15,0)=" GMRC*3.0*106. It sends from VistA to HSRM the CCRA progress notes filed "
^DIC(9.4,163,22,1,"PAH",280,1,16,0)="by "
^DIC(9.4,163,22,1,"PAH",280,1,17,0)=" a provider for a patient in CPRS."
^DIC(9.4,163,22,1,"PAH",280,1,18,0)=" This patch builds and sends a VistA Outbound MDM-T02 HL7 v.2.5.1 message "
^DIC(9.4,163,22,1,"PAH",280,1,19,0)="for any of "
^DIC(9.4,163,22,1,"PAH",280,1,20,0)=" the following CCRA Progress Note Titles that are used to file a "
^DIC(9.4,163,22,1,"PAH",280,1,21,0)="historical Progress Notes"
^DIC(9.4,163,22,1,"PAH",280,1,22,0)=" from CPRS:"
^DIC(9.4,163,22,1,"PAH",280,1,23,0)="      1   COMMUNITY CARE - PATIENT LETTER       TITLE  "
^DIC(9.4,163,22,1,"PAH",280,1,24,0)="      Std Title: NONVA PROGRESS NOTE"
^DIC(9.4,163,22,1,"PAH",280,1,25,0)="     2   COMMUNITY CARE- ADMINISTRATIVE REQUEST       TITLE  "
^DIC(9.4,163,22,1,"PAH",280,1,26,0)="      Std Title: ADMINISTRATIVE NOTE"
^DIC(9.4,163,22,1,"PAH",280,1,27,0)="     3   COMMUNITY CARE-COORDINATION NOTE       TITLE  "
^DIC(9.4,163,22,1,"PAH",280,1,28,0)="      Std Title: NONVA PROGRESS NOTE"
^DIC(9.4,163,22,1,"PAH",280,1,29,0)="     4   COMMUNITY CARE-HOSPITAL NOTIFICATION NOTE       TITLE  "
^DIC(9.4,163,22,1,"PAH",280,1,30,0)="      Std Title: PRIMARY CARE ADMINISTRATIVE NOTE"
^DIC(9.4,163,22,1,"PAH",280,1,31,0)=" "
^DIC(9.4,163,22,1,"PAH",280,1,32,0)=" The patch installs also the following HL7 1.6 components:"
^DIC(9.4,163,22,1,"PAH",280,1,33,0)="        - new HL logical link: TIUCCRA "
^DIC(9.4,163,22,1,"PAH",280,1,34,0)="        - new HL7 applications: TIU CCRA SEND and TIU HSRM RECEIVE"
^DIC(9.4,163,22,1,"PAH",280,1,35,0)="        - new HL7 Protocols:"
^DIC(9.4,163,22,1,"PAH",280,1,36,0)="                1   TIU CCRA-HSRM MDM-T02 CLIENT       TIU CCRA-HSRM "
^DIC(9.4,163,22,1,"PAH",280,1,37,0)="MDM-T02 CLIENT  "
^DIC(9.4,163,22,1,"PAH",280,1,38,0)="                2   TIU CCRA-HSRM MDM-T02 SERVER       TIU CCRA-HSRM "
^DIC(9.4,163,22,1,"PAH",280,1,39,0)="MDM-T02 SERVER  "
^DIC(9.4,163,22,1,"PAH",280,1,40,0)=" The message is triggered by the TIU Document Definition parameter:"
^DIC(9.4,163,22,1,"PAH",280,1,41,0)=" ""POST-SIGNATURE CODE:"". All CCRA Progress Note Titles that are required "
^DIC(9.4,163,22,1,"PAH",280,1,42,0)=" to trigger  the MDM-T02 to HSRM will have to have POST-SIGNATURE CODE: D "
^DIC(9.4,163,22,1,"PAH",280,1,43,0)="EN^TIUCCRHL()"
^DIC(9.4,163,22,1,"PAH",281,0)="326 SEQ #289^3190912.121453^65"
^DIC(9.4,163,22,1,"PAH",281,1,0)="^^7^7^3190912"
^DIC(9.4,163,22,1,"PAH",281,1,1,0)="During analysis of ticket INC5361702, an area of code associated to the "
^DIC(9.4,163,22,1,"PAH",281,1,2,0)="Alert Tracking module was discovered that needs remediation.  This patch "
^DIC(9.4,163,22,1,"PAH",281,1,3,0)="will correct this design to not completely rebuild the Alert Tracking "
^DIC(9.4,163,22,1,"PAH",281,1,4,0)="entry for each multiple Additional Signer that is added but rather make a "
^DIC(9.4,163,22,1,"PAH",281,1,5,0)="single call to the TIU alert routine for all additional signers that will "
^DIC(9.4,163,22,1,"PAH",281,1,6,0)="create only one new Alert Tracker record each time one or more additional "
^DIC(9.4,163,22,1,"PAH",281,1,7,0)="signers are added."
^DIC(9.4,163,22,1,"PAH",282,0)="324 SEQ #290^3191031.150026^65"
^DIC(9.4,163,22,1,"PAH",282,1,0)="^^1^1^3191031"
^DIC(9.4,163,22,1,"PAH",282,1,1,0)="TIU TEXT ALERT ISSUES"
^DIC(9.4,163,22,1,"PAH",283,0)="327 SEQ #291^3191113.142021^65"
^DIC(9.4,163,22,1,"PAH",283,1,0)="^^10^10^3191113"
^DIC(9.4,163,22,1,"PAH",283,1,1,0)=" "
^DIC(9.4,163,22,1,"PAH",283,1,2,0)="The Community Care Referrals and Authorizations (CCR&A) application is an"
^DIC(9.4,163,22,1,"PAH",283,1,3,0)="enterprise-wide system used by Community Care (CC) staff to"
^DIC(9.4,163,22,1,"PAH",283,1,4,0)="automatically generate referrals and authorizations for all Veterans"
^DIC(9.4,163,22,1,"PAH",283,1,5,0)="receiving care in the community. Clinical and VA CC staff located at VA "
^DIC(9.4,163,22,1,"PAH",283,1,6,0)="Medical Centers, Outpatient Clinics, Community Based Outpatient Clinics,"
^DIC(9.4,163,22,1,"PAH",283,1,7,0)="and VISN offices use this application.  The CCR&A solution is an integral"
^DIC(9.4,163,22,1,"PAH",283,1,8,0)="component of the VA Community Care Information Technology (IT)"
^DIC(9.4,163,22,1,"PAH",283,1,9,0)="architecture that allows Veterans to receive care from Community "
^DIC(9.4,163,22,1,"PAH",283,1,10,0)="Providers."
^DIC(9.4,163,22,1,"PAH",284,0)="329 SEQ #292^3200211.095222^65"
^DIC(9.4,163,22,1,"PAH",284,1,0)="^^10^10^3200211"
^DIC(9.4,163,22,1,"PAH",284,1,1,0)=" "
^DIC(9.4,163,22,1,"PAH",284,1,2,0)="The Community Care Referrals and Authorizations (CCR&A) application is an"
^DIC(9.4,163,22,1,"PAH",284,1,3,0)="enterprise-wide system used by Community Care (CC) staff to"
^DIC(9.4,163,22,1,"PAH",284,1,4,0)="automatically generate referrals and authorizations for all Veterans"
^DIC(9.4,163,22,1,"PAH",284,1,5,0)="receiving care in the community. Clinical and VA CC staff located at VA "
^DIC(9.4,163,22,1,"PAH",284,1,6,0)="Medical Centers, Outpatient Clinics, Community Based Outpatient Clinics,"
^DIC(9.4,163,22,1,"PAH",284,1,7,0)="and VISN offices use this application.  The CCR&A solution is an integral"
^DIC(9.4,163,22,1,"PAH",284,1,8,0)="component of the VA Community Care Information Technology (IT)"
^DIC(9.4,163,22,1,"PAH",284,1,9,0)="architecture that allows Veterans to receive care from Community "
^DIC(9.4,163,22,1,"PAH",284,1,10,0)="Providers."
^DIC(9.4,163,22,1,"PAH",285,0)="331 SEQ #293^3200601.163534^70"
^DIC(9.4,163,22,1,"PAH",285,1,0)="^^1^1^3200601"
^DIC(9.4,163,22,1,"PAH",285,1,1,0)="Please see the patch description for TIU*1.0*331 at DOMAIN.EXT."
^DIC(9.4,163,22,1,"PAH",286,0)="290^3200624.121356^65"
^DIC(9.4,163,22,1,"PAH",286,1,0)="^^14^14^3200624"
^DIC(9.4,163,22,1,"PAH",286,1,1,0)="Deploys a new document class and note titles for SMART notifications, "
^DIC(9.4,163,22,1,"PAH",286,1,2,0)="high risk medications status review, and a new note title ""Healthe"
^DIC(9.4,163,22,1,"PAH",286,1,3,0)="Living Assessment""."
^DIC(9.4,163,22,1,"PAH",286,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",286,1,5,0)="Adds a new informational prompt that may appear while taking an action on "
^DIC(9.4,163,22,1,"PAH",286,1,6,0)="a docment. The prompt displays a message from other software packages "
^DIC(9.4,163,22,1,"PAH",286,1,7,0)="that have a pointer to the document that the user is acting upon."
^DIC(9.4,163,22,1,"PAH",286,1,8,0)=" "
^DIC(9.4,163,22,1,"PAH",286,1,9,0)="This patch also provides copy/paste APIs and globals for CPRS v31.b"
^DIC(9.4,163,22,1,"PAH",286,1,10,0)="(OR*3.0*377)."
^DIC(9.4,163,22,1,"PAH",286,1,11,0)=" "
^DIC(9.4,163,22,1,"PAH",286,1,12,0)="Please see the accompanying patch description for details and the "
^DIC(9.4,163,22,1,"PAH",286,1,13,0)="Computerized Patient Record System (CPRS) version 31.b installation "
^DIC(9.4,163,22,1,"PAH",286,1,14,0)="manual for installation instructions."
^DIC(9.4,163,22,1,"PAH",287,0)="335^3200722.162953^65"
^DIC(9.4,163,22,1,"PAH",287,1,0)="^^1^1^3200722"
^DIC(9.4,163,22,1,"PAH",287,1,1,0)="Please see the patch description on FORUM."
^DIC(9.4,163,22,1,"PAH",288,0)="334 SEQ #296^3200923.103317^65"
^DIC(9.4,163,22,1,"PAH",288,1,0)="^^1^1^3200923"
^DIC(9.4,163,22,1,"PAH",288,1,1,0)="TIU BUSINESS RULES FOR USER ROLE SURROGATE DOES NOT WORK"
^DIC(9.4,163,22,1,"PAH",289,0)="333 SEQ #297^3201008.0859^17"
^DIC(9.4,163,22,1,"PAH",289,1,0)="^^1^1^3201008"
^DIC(9.4,163,22,1,"PAH",289,1,1,0)="Please see patch description in FORUM"
^DIC(9.4,163,22,1,"PAH",290,0)="328^3201112.175219^17"
^DIC(9.4,163,22,1,"PAH",290,1,0)="^^1^1^3201112"
^DIC(9.4,163,22,1,"PAH",290,1,1,0)="Please see the patch description for TIU*1.0*328 for more information."
^DIC(9.4,163,22,1,"PAH",291,0)="336 SEQ #299^3201123.100905^17"
^DIC(9.4,163,22,1,"PAH",291,1,0)="^^7^7^3201123"
^DIC(9.4,163,22,1,"PAH",291,1,1,0)="This patch corrects an issue related to the copy/paste functionality"
^DIC(9.4,163,22,1,"PAH",291,1,2,0)="released as part of CPRS 31B. The issue is due to selected login locations"
^DIC(9.4,163,22,1,"PAH",291,1,3,0)="containing non-numeric values. These values are not handled properly "
^DIC(9.4,163,22,1,"PAH",291,1,4,0)="resulting in pasted text not being saved or retrieved by the CPRS GUI."
^DIC(9.4,163,22,1,"PAH",291,1,5,0)="There is also a problem with site entered userclasses to view all"
^DIC(9.4,163,22,1,"PAH",291,1,6,0)="copy/paste actions from being returned and thus a user may be excluded"
^DIC(9.4,163,22,1,"PAH",291,1,7,0)="from viewing copy/paste data in the CPRS GUI as expected."
^DIC(9.4,163,22,1,"PAH",292,0)="340 SEQ #300^3210311.152243^17"
^DIC(9.4,163,22,1,"PAH",292,1,0)="^^52^52^3210311"
^DIC(9.4,163,22,1,"PAH",292,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,163,22,1,"PAH",292,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,3,0)="1. Error when deleting unsigned progress notes USING TIU SEARCH LIST MGR"
^DIC(9.4,163,22,1,"PAH",292,1,4,0)="   "
^DIC(9.4,163,22,1,"PAH",292,1,5,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,6,0)="Associated ticket(s):"
^DIC(9.4,163,22,1,"PAH",292,1,7,0)="====================="
^DIC(9.4,163,22,1,"PAH",292,1,8,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,9,0)="1. INC14028939, INC15046834 (duplicate) - Error when deleting unsigned "
^DIC(9.4,163,22,1,"PAH",292,1,10,0)="progress notes USING TIU SEARCH LIST MGR "
^DIC(9.4,163,22,1,"PAH",292,1,11,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,12,0)="Associated NSR(s):"
^DIC(9.4,163,22,1,"PAH",292,1,13,0)="=================="
^DIC(9.4,163,22,1,"PAH",292,1,14,0)="N/A"
^DIC(9.4,163,22,1,"PAH",292,1,15,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,16,0)="Participating Test Sites:"
^DIC(9.4,163,22,1,"PAH",292,1,17,0)="========================="
^DIC(9.4,163,22,1,"PAH",292,1,18,0)="TBD"
^DIC(9.4,163,22,1,"PAH",292,1,19,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,20,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,21,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,163,22,1,"PAH",292,1,22,0)="==========================================="
^DIC(9.4,163,22,1,"PAH",292,1,23,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,24,0)="1.      Error when deleting unsigned progress notes using TIU SEARCH LIST "
^DIC(9.4,163,22,1,"PAH",292,1,25,0)="MGR "
^DIC(9.4,163,22,1,"PAH",292,1,26,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,27,0)="   Problem:"
^DIC(9.4,163,22,1,"PAH",292,1,28,0)="   -------"
^DIC(9.4,163,22,1,"PAH",292,1,29,0)="   When using Vista option ""Search for Selected Documents"" [TIU SEARCH "
^DIC(9.4,163,22,1,"PAH",292,1,30,0)="LIST"
^DIC(9.4,163,22,1,"PAH",292,1,31,0)="   MGR] to deleted unsigned progress notes completely out of file 8925, a "
^DIC(9.4,163,22,1,"PAH",292,1,32,0)="   hard error is generated.  The Delete action must perform a complete "
^DIC(9.4,163,22,1,"PAH",292,1,33,0)="   deletion out of file 8925 (versus doing a retraction) in order for the"
^DIC(9.4,163,22,1,"PAH",292,1,34,0)="   problem to be reproduced.  This error happens whether deleting notes "
^DIC(9.4,163,22,1,"PAH",292,1,35,0)="   singly, or a range of notes."
^DIC(9.4,163,22,1,"PAH",292,1,36,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,37,0)="   Resolution:"
^DIC(9.4,163,22,1,"PAH",292,1,38,0)="   ----------"
^DIC(9.4,163,22,1,"PAH",292,1,39,0)="   Modify routine TIURB2 to call NOTIFY^TIUUTL before the TIU Note is "
^DIC(9.4,163,22,1,"PAH",292,1,40,0)="   deleted.  "
^DIC(9.4,163,22,1,"PAH",292,1,41,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,42,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,43,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,44,0)="Test Sites:"
^DIC(9.4,163,22,1,"PAH",292,1,45,0)="=========="
^DIC(9.4,163,22,1,"PAH",292,1,46,0)="TBD "
^DIC(9.4,163,22,1,"PAH",292,1,47,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,48,0)=" "
^DIC(9.4,163,22,1,"PAH",292,1,49,0)="Pre-Installation Instructions:"
^DIC(9.4,163,22,1,"PAH",292,1,50,0)="============================="
^DIC(9.4,163,22,1,"PAH",292,1,51,0)="This patch may be loaded with users on the system. You may wish to "
^DIC(9.4,163,22,1,"PAH",292,1,52,0)="install it during non-peak hours. Installation will take less than 1 "
^DIC(9.4,163,22,1,"PAH",293,0)="330b^3210427"
^DIC(9.4,163,22,1,"PAH",293,1,0)="^^5^5^3210427"
^DIC(9.4,163,22,1,"PAH",293,1,1,0)="Backup of TIU*1.0*330 on Apr 27, 2021"
^DIC(9.4,163,22,1,"PAH",293,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",293,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,163,22,1,"PAH",293,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,163,22,1,"PAH",293,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,163,22,1,"PAH",294,0)="330 SEQ #301^3210427.09083^17"
^DIC(9.4,163,22,1,"PAH",294,1,0)="^^1^1^3210427"
^DIC(9.4,163,22,1,"PAH",294,1,1,0)="Please see the patch description for TIU*1.0*330 for more information."
^DIC(9.4,163,22,1,"PAH",295,0)="337b^3210507"
^DIC(9.4,163,22,1,"PAH",295,1,0)="^^5^5^3210507"
^DIC(9.4,163,22,1,"PAH",295,1,1,0)="Backup of TIU*1.0*337 on May 07, 2021"
^DIC(9.4,163,22,1,"PAH",295,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",295,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,163,22,1,"PAH",295,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,163,22,1,"PAH",295,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,163,22,1,"PAH",296,0)="337 SEQ #302^3210507.1113^17"
^DIC(9.4,163,22,1,"PAH",296,1,0)="^^1^1^3210507"
^DIC(9.4,163,22,1,"PAH",296,1,1,0)="ADD NEW TIU CONSULT FROM HSRM TO VISTA."
^DIC(9.4,163,22,1,"PAH",297,0)="339^3210701.1128^17"
^DIC(9.4,163,22,1,"PAH",297,1,0)="^^12^12^3210701"
^DIC(9.4,163,22,1,"PAH",297,1,1,0)="The Computerized Patient Record System (CPRS) Graphical User Interface "
^DIC(9.4,163,22,1,"PAH",297,1,2,0)="(GUI) v32a is an enhancement release. This patch (TIU*1*339) is a part"
^DIC(9.4,163,22,1,"PAH",297,1,3,0)="of that enhancement release."
^DIC(9.4,163,22,1,"PAH",297,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",297,1,5,0)="Specifically, this patch introduces the support for:"
^DIC(9.4,163,22,1,"PAH",297,1,6,0)=" "
^DIC(9.4,163,22,1,"PAH",297,1,7,0)="  NSR 20070817: Progress Notes Display Misleading"
^DIC(9.4,163,22,1,"PAH",297,1,8,0)="  NSR 20100706: Identify Required Fields in TIU Note Templates and"
^DIC(9.4,163,22,1,"PAH",297,1,9,0)="                Notify of Missing Required Fields"
^DIC(9.4,163,22,1,"PAH",297,1,10,0)=" "
^DIC(9.4,163,22,1,"PAH",297,1,11,0)="For a complete listing of patches included in this release, please refer "
^DIC(9.4,163,22,1,"PAH",297,1,12,0)="to the CPRS GUI v32a Release Notes. "
^DIC(9.4,163,22,1,"PAH",298,0)="347 SEQ #304^3210924.132429^17"
^DIC(9.4,163,22,1,"PAH",298,1,0)="^^1^1^3210924"
^DIC(9.4,163,22,1,"PAH",298,1,1,0)="Please see the patch description for TIU*1.0*347 for more information."
^DIC(9.4,163,22,1,"PAH",299,0)="344 SEQ #305^3211102.170405^17"
^DIC(9.4,163,22,1,"PAH",299,1,0)="^^1^1^3211102"
^DIC(9.4,163,22,1,"PAH",299,1,1,0)="File a note addendum with the note from HSRM. "
^DIC(9.4,163,22,1,"PAH",300,0)="346 SEQ #306^3211104.093831^17"
^DIC(9.4,163,22,1,"PAH",300,1,0)="^^40^40^3211104"
^DIC(9.4,163,22,1,"PAH",300,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,163,22,1,"PAH",300,1,2,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,3,0)="1. TIU Text Alerts do not work if user requires a cosigner "
^DIC(9.4,163,22,1,"PAH",300,1,4,0)="   "
^DIC(9.4,163,22,1,"PAH",300,1,5,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,6,0)="Associated ticket(s):"
^DIC(9.4,163,22,1,"PAH",300,1,7,0)="====================="
^DIC(9.4,163,22,1,"PAH",300,1,8,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,9,0)="1. INC18300016 - TIU Text Alerts do not work if user requires a "
^DIC(9.4,163,22,1,"PAH",300,1,10,0)="                 cosigner"
^DIC(9.4,163,22,1,"PAH",300,1,11,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,12,0)="Associated NSR(s):"
^DIC(9.4,163,22,1,"PAH",300,1,13,0)="=================="
^DIC(9.4,163,22,1,"PAH",300,1,14,0)="N/A"
^DIC(9.4,163,22,1,"PAH",300,1,15,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,16,0)="Participating Test Sites:"
^DIC(9.4,163,22,1,"PAH",300,1,17,0)="========================="
^DIC(9.4,163,22,1,"PAH",300,1,18,0)="TBD"
^DIC(9.4,163,22,1,"PAH",300,1,19,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,20,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,21,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,163,22,1,"PAH",300,1,22,0)="==========================================="
^DIC(9.4,163,22,1,"PAH",300,1,23,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,24,0)="1. TIU Text Alerts do not work if user requires a cosigner"
^DIC(9.4,163,22,1,"PAH",300,1,25,0)=" "
^DIC(9.4,163,22,1,"PAH",300,1,26,0)="   Problem:"
^DIC(9.4,163,22,1,"PAH",300,1,27,0)="   -------"
^DIC(9.4,163,22,1,"PAH",300,1,28,0)="When a TIU Text Event Alert is set up, a CPRS alert is sent to a team "
^DIC(9.4,163,22,1,"PAH",300,1,29,0)="whenever a note is signed that contains specific text. Users notified the "
^DIC(9.4,163,22,1,"PAH",300,1,30,0)="CACs that this did not seem to be working for author's who require a "
^DIC(9.4,163,22,1,"PAH",300,1,31,0)="cosigner. It was tested and confirmed. When signing a note as an "
^DIC(9.4,163,22,1,"PAH",300,1,32,0)="independent author, the TIU Text Event Alert was sent as expected. When "
^DIC(9.4,163,22,1,"PAH",300,1,33,0)="the author required a cosigner, no alert(s) were sent when the author "
^DIC(9.4,163,22,1,"PAH",300,1,34,0)="signed, and no alert(s) were sent when the cosigner signed."
^DIC(9.4,163,22,1,"PAH",300,1,35,0)="   "
^DIC(9.4,163,22,1,"PAH",300,1,36,0)="   Resolution:"
^DIC(9.4,163,22,1,"PAH",300,1,37,0)="   ----------"
^DIC(9.4,163,22,1,"PAH",300,1,38,0)="Routine TIUTIUS is modified to remove a line of code that stopped "
^DIC(9.4,163,22,1,"PAH",300,1,39,0)="processing text alerts when the Note had been signed and cosigned and the "
^DIC(9.4,163,22,1,"PAH",300,1,40,0)="cosigner and signer were different users."
^DIC(9.4,163,22,1,"PAH",301,0)="338 SEQ #307^3211117.141931^17"
^DIC(9.4,163,22,1,"PAH",301,1,0)="^^3^3^3211117"
^DIC(9.4,163,22,1,"PAH",301,1,1,0)="This is a follow-up patch to TIU*1.0*290 to implement the redesigned "
^DIC(9.4,163,22,1,"PAH",301,1,2,0)="copy/paste tracking report. It also implements a solution to when the TIU "
^DIC(9.4,163,22,1,"PAH",301,1,3,0)="TEMPLATE (#8927) file allowing long lines of greater than 80 characters."
^DIC(9.4,163,22,1,"PAH",302,0)="341^3211207.151119^17"
^DIC(9.4,163,22,1,"PAH",302,1,0)="^^3^3^3211207"
^DIC(9.4,163,22,1,"PAH",302,1,1,0)="This patch addresses issues identified during the CPRS v31b deployment. "
^DIC(9.4,163,22,1,"PAH",302,1,2,0)="Refer to the patch description for a comlete list of issues that are "
^DIC(9.4,163,22,1,"PAH",302,1,3,0)="addressed."
