^DIC(9.4,3,22,21,"PAH",163,1,58,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",163,1,59,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",163,1,60,0)="     "
^DIC(9.4,3,22,21,"PAH",163,1,61,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
