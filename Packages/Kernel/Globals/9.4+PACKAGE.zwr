^DIC(9.4,48,22,5.28,"PAH",670,1,5,0)="================="
^DIC(9.4,48,22,5.28,"PAH",670,1,6,0)="VSE-7567: LB - VistA: Modify SDES GET APPTS and SDES2 GET APPTS RPCs"
^DIC(9.4,48,22,5.28,"PAH",670,1,7,0)="VSE-7706: TB - VistA: Create an SDES2 version of SDES GET CLINICS BY "
^DIC(9.4,48,22,5.28,"PAH",670,1,8,0)="               PROVIDER to add an input parameter flag for Inactive Clinic"
^DIC(9.4,48,22,5.28,"PAH",670,1,9,0)="VSE-7707: LB - VistA: Modify SDES2 GET RESOURCE GOUP to add an input"
^DIC(9.4,48,22,5.28,"PAH",670,1,10,0)="               parameter flag for inactive clinic"
^DIC(9.4,48,22,5.28,"PAH",670,1,11,0)="VSE-7763: AP - VistA: Modification to SDES2 CREATE APPOINTMENT to update "
^DIC(9.4,48,22,5.28,"PAH",670,1,12,0)="               MRTC PARENT logic."
^DIC(9.4,48,22,5.28,"PAH",670,1,13,0)=" "
^DIC(9.4,48,22,5.28,"PAH",670,1,14,0)="Jira Tickets 9.8:"
^DIC(9.4,48,22,5.28,"PAH",670,1,15,0)="================="
^DIC(9.4,48,22,5.28,"PAH",670,1,16,0)="VSE-7775: TB - Blocked slot reopened on remapping clinic availability."
^DIC(9.4,48,22,5.28,"PAH",670,1,17,0)="VSE-7807: BF - VistA: Create a new RPC to return open availability for a"
^DIC(9.4,48,22,5.28,"PAH",670,1,18,0)="               given service type"
^DIC(9.4,48,22,5.28,"PAH",670,1,19,0)="VSE-7856: JS - VistA: Discovery and Code if possible Modify SDES2 GET "
^DIC(9.4,48,22,5.28,"PAH",670,1,20,0)="               CANCELLED SLOTS RPC so that it also pass back the reason"
^DIC(9.4,48,22,5.28,"PAH",670,1,21,0)="               that a particular slot was cancelled in the first place"
^DIC(9.4,48,22,5.28,"PAH",670,1,22,0)="VSE-7866: AP - VistA: Modify SDES2SETCHECKOUT.INT so that the data we are "
^DIC(9.4,48,22,5.28,"PAH",670,1,23,0)="               trying to file will pass the input transform"
^DIC(9.4,48,22,5.28,"PAH",670,1,24,0)="VSE-7911: TB - VistA: Create an SDES2 version of SDES SEARCH RECALL "
^DIC(9.4,48,22,5.28,"PAH",670,1,25,0)="               PROVIDER's RPC and change the way search is done"
^DIC(9.4,48,22,5.28,"PAH",670,1,26,0)="VSE-7924: LB - VistA: Create a new SDES2 GET APPTS BY CLINIC LIST RPC so "
^DIC(9.4,48,22,5.28,"PAH",670,1,27,0)="               that it returns back the full ""Appointment"" object"
^DIC(9.4,48,22,5.28,"PAH",670,1,28,0)="VSE-7963: BF - VistA: Modify SDES GET CLINIC STOPCD to add 'Restriction "
^DIC(9.4,48,22,5.28,"PAH",670,1,29,0)="               Type'"
^DIC(9.4,48,22,5.28,"PAH",670,1,30,0)="VSE-8049: BB - VistA: Modify SDES2 CANCEL CLINIC AVAILBILITY validation"
^DIC(9.4,48,22,5.28,"PAH",670,1,31,0)="               to add an equal sign to logic so that it doesn't check the"
^DIC(9.4,48,22,5.28,"PAH",670,1,32,0)="               next time slot."
^DIC(9.4,48,22,5.28,"PAH",670,1,33,0)=" "
^DIC(9.4,48,22,5.28,"PAH",670,1,34,0)="Jira Tickets 10.0:"
^DIC(9.4,48,22,5.28,"PAH",670,1,35,0)="=================="
^DIC(9.4,48,22,5.28,"PAH",670,1,36,0)="VSE-7546: FF - VS GUI: Time zone dropdown not working when creating VVC "
^DIC(9.4,48,22,5.28,"PAH",670,1,37,0)="          appointments"
^DIC(9.4,48,22,5.28,"PAH",670,1,38,0)="VSE-7885: BB - VistA: The system is allowing two appointments that are "
^DIC(9.4,48,22,5.28,"PAH",670,1,39,0)="          converted to the same FileMan date.time to be entered in for a"
^DIC(9.4,48,22,5.28,"PAH",670,1,40,0)="          patient"
^DIC(9.4,48,22,5.28,"PAH",670,1,41,0)="VSE-7918: MB - VistA: Modify SDES2 GET PATIENT EP RPC to fix a typo "
^DIC(9.4,48,22,5.28,"PAH",670,1,42,0)="          ""uknown"""
^DIC(9.4,48,22,5.28,"PAH",670,1,43,0)="VSE-7944: JJ - VistA: Modify SDES2 GET PATIENT DEMOGRAPHICS to update the "
^DIC(9.4,48,22,5.28,"PAH",670,1,44,0)="          object when there is no race defined"
^DIC(9.4,48,22,5.28,"PAH",670,1,45,0)="VSE-7961: BF - VistA: A data clean up is needed to add the ""MES"" node to "
^DIC(9.4,48,22,5.28,"PAH",670,1,46,0)="          the clinic for time slots canceled via SDES/SDES2 code."
^DIC(9.4,48,22,5.28,"PAH",670,1,47,0)="VSE-7983: TB - VistA: Fix the logic to prevent <UNDEFINED> error in "
^DIC(9.4,48,22,5.28,"PAH",670,1,48,0)="          SDESCLNSETAVAIL"
^DIC(9.4,48,22,5.28,"PAH",670,1,49,0)="VSE-8061: BB - VistA: Correct logic in SDES2CANCELAPPT to correctly "
^DIC(9.4,48,22,5.28,"PAH",670,1,50,0)="          remove all encounters created for an appointment when"
^DIC(9.4,48,22,5.28,"PAH",670,1,51,0)="          appointment is being cancelled"
^DIC(9.4,48,22,5.28,"PAH",670,1,52,0)="VSE-8062: BF - VistA: Correct logic in SDES2 GET APPT REQ BY TYP VET to "
^DIC(9.4,48,22,5.28,"PAH",670,1,53,0)="          handle SDDUZ and pass it through to the GETREQUEST call"
^DIC(9.4,48,22,5.28,"PAH",670,1,54,0)=" "
