^DIC(9.4,160,22,4,"PAH",1,1,1,0)="This patch contains the changes necessary to support the following"
^DIC(9.4,160,22,4,"PAH",1,1,2,0)="items:"
^DIC(9.4,160,22,4,"PAH",1,1,3,0)=" "
^DIC(9.4,160,22,4,"PAH",1,1,4,0)="1.  Delete references to files 3, 6, and 16."
^DIC(9.4,160,22,4,"PAH",1,1,5,0)="2.  Recode electronic signatures per IG instructions."
^DIC(9.4,160,22,4,"PAH",1,1,6,0)="3.  Address IC concerns regarding suspense processing and restrictions."
^DIC(9.4,160,22,4,"PAH",1,1,7,0)="4.  Archive and purge"
^DIC(9.4,160,22,4,"PAH",1,1,8,0)="5.  Correct errors relating to FM 21."
^DIC(9.4,160,22,4,"PAH",2,0)="7^2980120^1"
^DIC(9.4,160,22,4,"PAH",2,1,0)="^^10^10^2980120"
^DIC(9.4,160,22,4,"PAH",2,1,1,0)=" "
^DIC(9.4,160,22,4,"PAH",2,1,2,0)="This patch contains the changes necessary to support the following"
^DIC(9.4,160,22,4,"PAH",2,1,3,0)="items:"
^DIC(9.4,160,22,4,"PAH",2,1,4,0)=" "
^DIC(9.4,160,22,4,"PAH",2,1,5,0)="1. Remove routines previously used for conversion from 3/6/16."
^DIC(9.4,160,22,4,"PAH",2,1,6,0)="2. Run a File 16 conversion of the Provider Authorizing Restriction field,"
^DIC(9.4,160,22,4,"PAH",2,1,7,0)="of file 470 which was inadvertantly missed in Patch PRPF*3.0*6."
^DIC(9.4,160,22,4,"PAH",2,1,8,0)="3. Modify the header used in the PRPF Archive tape."
^DIC(9.4,160,22,4,"PAH",2,1,9,0)="4. Corrects problems identified in NOIS - DAY-0697-40888, DAN-0697-42229"
^DIC(9.4,160,22,4,"PAH",2,1,10,0)="and BAN-0697-11023"
^DIC(9.4,160,22,4,"PAH",3,0)="8^2980616^1"
^DIC(9.4,160,22,4,"PAH",3,1,0)="^^8^8^2980616"
^DIC(9.4,160,22,4,"PAH",3,1,1,0)="This patch addresses two unrelated problems in the Patient Funds"
^DIC(9.4,160,22,4,"PAH",3,1,2,0)="package that resulted in the following NOIS:"
^DIC(9.4,160,22,4,"PAH",3,1,3,0)=" "
^DIC(9.4,160,22,4,"PAH",3,1,4,0)="   Overview of NOIS MESSAGES:"
^DIC(9.4,160,22,4,"PAH",3,1,5,0)="   -------------------------"
^DIC(9.4,160,22,4,"PAH",3,1,6,0)=" CLE-1097-42161 - re occasional display of info from Engineering (due to"
^DIC(9.4,160,22,4,"PAH",3,1,7,0)="non-initialization of print buffer)"
^DIC(9.4,160,22,4,"PAH",3,1,8,0)=" TOM-1297-41000 - re inclusion of inactive patients in some reports"
^DIC(9.4,160,22,4,"PAH",4,0)="9 SEQ #9^2990914^1"
^DIC(9.4,160,22,4,"PAH",4,1,0)="^^16^16^2990914"
^DIC(9.4,160,22,4,"PAH",4,1,1,0)="This patch prevents a possible future management error.  The default and"
^DIC(9.4,160,22,4,"PAH",4,1,2,0)="maximum date for archieving and purging was ""TODAY"" when logically one"
^DIC(9.4,160,22,4,"PAH",4,1,3,0)="should be purging or archieving ""recent"" data.  To prevent recurrance of"
^DIC(9.4,160,22,4,"PAH",4,1,4,0)="this, the maximum date for these two events has been changed to TODAY-400."
^DIC(9.4,160,22,4,"PAH",4,1,5,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,6,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,7,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,8,0)=" Overview of NOIS MESSAGES:"
^DIC(9.4,160,22,4,"PAH",4,1,9,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,10,0)=" -------------------------"
^DIC(9.4,160,22,4,"PAH",4,1,11,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,12,0)=" MAR-0798-20011   How to restore unintentionally deleted records."
^DIC(9.4,160,22,4,"PAH",4,1,13,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,14,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,15,0)=" "
^DIC(9.4,160,22,4,"PAH",4,1,16,0)=" There are no E3R messages associated with this patch."
^DIC(9.4,160,22,4,"PAH",5,0)="10 SEQ #10^3010326^1"
^DIC(9.4,160,22,4,"PAH",6,0)="11 SEQ #11^3011121^1"
^DIC(9.4,160,22,4,"PAH",6,1,0)="^^1^1^3011121"
^DIC(9.4,160,22,4,"PAH",6,1,1,0)="REMOVE OBSOLETE OPTIONS AND INVALID FORM ENTRY"
^DIC(9.4,160,22,4,"PAH",7,0)="12 SEQ #12^3020116^1"
^DIC(9.4,160,22,4,"PAH",7,1,0)="^^1^1^3020116"
^DIC(9.4,160,22,4,"PAH",7,1,1,0)="REMOVE OBSOLETE OPTIONS AND INVALID FORM ENTRY"
^DIC(9.4,160,22,4,"PAH",8,0)="13 SEQ #13^3020906^1"
^DIC(9.4,160,22,4,"PAH",8,1,0)="^^1^1^3020906"
^DIC(9.4,160,22,4,"PAH",8,1,1,0)="PERSONAL FUNDS MULTIDIV"
^DIC(9.4,160,22,4,"PAH",9,0)="14 SEQ #14^3020927^1"
^DIC(9.4,160,22,4,"PAH",9,1,0)="^^1^1^3020927"
^DIC(9.4,160,22,4,"PAH",9,1,1,0)="CORRECT BAL CHECK REPORT"
^DIC(9.4,160,22,4,"PAH",10,0)="15 SEQ #17^3060711^1"
^DIC(9.4,160,22,4,"PAH",10,1,0)="^^1^1^3060711"
^DIC(9.4,160,22,4,"PAH",10,1,1,0)="Patient Funds Diagnostic Patch"
^DIC(9.4,160,22,4,"PAH",11,0)="16 SEQ #19^3070904.221324^1"
^DIC(9.4,160,22,4,"PAH",11,1,0)="^^1^1^3070904"
^DIC(9.4,160,22,4,"PAH",11,1,1,0)="Patient Funds Migration Patch"
^DIC(9.4,160,22,4,"PAH",12,0)="17^3071209.125322^1"
^DIC(9.4,160,22,4,"PAH",12,1,0)="^^4^4^3071209"
^DIC(9.4,160,22,4,"PAH",12,1,1,0)="This patch is the 3rd and final patch in the 3 patch series used to "
^DIC(9.4,160,22,4,"PAH",12,1,2,0)="migrate a legacy Patient Funds package to the new VPFS Enterprise "
^DIC(9.4,160,22,4,"PAH",12,1,3,0)="application. Only use this patch if the migration process has been "
^DIC(9.4,160,22,4,"PAH",12,1,4,0)="successfully completed."
^DIC(9.4,160,22,4,"PAH",13,0)="18 SEQ #21^3080526.191131^1"
^DIC(9.4,160,22,4,"PAH",13,1,0)="^^3^3^3080526"
^DIC(9.4,160,22,4,"PAH",13,1,1,0)="This patch corrects the issue of the inability to add Guardian"
^DIC(9.4,160,22,4,"PAH",13,1,2,0)="information to new patients added since Veteran's Personal Finance "
^DIC(9.4,160,22,4,"PAH",13,1,3,0)="System (VPFS) was successfully installed."
