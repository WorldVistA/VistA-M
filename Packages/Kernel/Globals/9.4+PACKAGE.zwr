^DIC(9.4,85,22,1.5,"PAH",15,1,6,0)="This patch adds Yugoslavia service and Purple Heart information to the"
^DIC(9.4,85,22,1.5,"PAH",15,1,7,0)="PDX*MAS data which PDX extracts from the PATIENT file and displays on"
^DIC(9.4,85,22,1.5,"PAH",15,1,8,0)="screen 6."
^DIC(9.4,85,22,1.5,"PAH",15,1,9,0)=""
^DIC(9.4,85,22,1.5,"PAH",15,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",15,1,11,0)="is at a minimum.  It requires PDX patches VAQ*1.5*22 and *24.  KIDS will"
^DIC(9.4,85,22,1.5,"PAH",15,1,12,0)="not check for the existence of these patches, because they pre-date KIDS."
^DIC(9.4,85,22,1.5,"PAH",15,1,13,0)="The site is responsible for performing the check."
