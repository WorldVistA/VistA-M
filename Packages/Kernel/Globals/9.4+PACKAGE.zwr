^DIC(9.4,212,"VERSION")="2.0"
^DIC(9.4,213,0)="WEB SERVICES CLIENT^XOBW^Allows VistA applications access to remote web services"
^DIC(9.4,213,20,0)="^9.402P^^"
^DIC(9.4,213,22,0)="^9.49I^1^1"
^DIC(9.4,213,22,1,0)="1.0^3100913^3110303^17"
^DIC(9.4,213,22,1,1,0)="^^5^5^3110303"
^DIC(9.4,213,22,1,1,1,0)="This is the initial version of the HealtheVet Web Services Client (HWSC) "
^DIC(9.4,213,22,1,1,2,0)="application."
^DIC(9.4,213,22,1,1,3,0)=" "
^DIC(9.4,213,22,1,1,4,0)="The functionality contained in this application allows VistA applications"
^DIC(9.4,213,22,1,1,5,0)="to access remote web services."
^DIC(9.4,213,22,1,"PAH",0)="^9.4901^1^1"
^DIC(9.4,213,22,1,"PAH",1,0)="4 SEQ #4^3161212.121134^54"
^DIC(9.4,213,22,1,"PAH",1,1,0)="^^1^1^3161212"
^DIC(9.4,213,22,1,"PAH",1,1,1,0)="Patch XOBW*1*4. Please refer to NPM for more detail."
^DIC(9.4,213,22,1,"PAH","B","4 SEQ #4",1)=""
^DIC(9.4,213,22,"B","1.0",1)=""
^DIC(9.4,213,"VERSION")="1.0"
^DIC(9.4,214,0)="VIRTUAL PATIENT RECORD^VPR^Utilities to manage a virtual copy of the patient record"
^DIC(9.4,214,1,0)="^^3^3^3101130^"
^DIC(9.4,214,1,1,0)="This application contains utilities to build and manage a copy of the"
^DIC(9.4,214,1,2,0)="patient's record, including local and remote data.  The authoritative"
^DIC(9.4,214,1,3,0)="copy of the data will continue to be each local VistA service."
^DIC(9.4,214,5)="SLC-ISC"
^DIC(9.4,214,20,0)="^9.402P^^"
^DIC(9.4,214,22,0)="^9.49I^1^1"
^DIC(9.4,214,22,1,0)="1.0^3110804^3110829^17"
^DIC(9.4,214,22,1,1,0)="^^2^2^3110829"
^DIC(9.4,214,22,1,1,1,0)="The Virtual Patient Record (VPR) monitors a VistA system for new data"
^DIC(9.4,214,22,1,1,2,0)="and activity, and makes that data available to a subscribing client."
^DIC(9.4,214,22,1,"PAH",0)="^9.4901^37^37"
^DIC(9.4,214,22,1,"PAH",1,0)="1^3110721"
^DIC(9.4,214,22,1,"PAH",1,1,0)="^^2^2^3110721"
^DIC(9.4,214,22,1,"PAH",1,1,1,0)="The Virtual Patient Record (VPR) monitors a VistA system for new data"
^DIC(9.4,214,22,1,"PAH",1,1,2,0)="and activity, and makes that data available to a subscribing client."
^DIC(9.4,214,22,1,"PAH",2,0)="1 SEQ #1^3120829.122329^17"
^DIC(9.4,214,22,1,"PAH",2,1,0)="^^2^2^3120829"
^DIC(9.4,214,22,1,"PAH",2,1,1,0)="The Virtual Patient Record (VPR) provides a data extract RPC to return"
^DIC(9.4,214,22,1,"PAH",2,1,2,0)="data as requested from the local VistA system."
^DIC(9.4,214,22,1,"PAH",3,0)="2 SEQ #2^3131115.09055^17"
^DIC(9.4,214,22,1,"PAH",3,1,0)="^^2^2^3131115"
^DIC(9.4,214,22,1,"PAH",3,1,1,0)="The Virtual Patient Record (VPR) data extract RPC, which returns data"
^DIC(9.4,214,22,1,"PAH",3,1,2,0)="from the local VistA system, is updated in this patch."
^DIC(9.4,214,22,1,"PAH",4,0)="4 SEQ #3^3150219.092607^17"
^DIC(9.4,214,22,1,"PAH",4,1,0)="^^1^1^3150219"
^DIC(9.4,214,22,1,"PAH",4,1,1,0)="JLV and VLER support"
^DIC(9.4,214,22,1,"PAH",5,0)="5 SEQ #4^3150916.111626^17"
^DIC(9.4,214,22,1,"PAH",5,1,0)="^^59^59^3150916"
^DIC(9.4,214,22,1,"PAH",5,1,1,0)="This patch to the Virtual Patient Record (VPR) package updates the VPR GET "
^DIC(9.4,214,22,1,"PAH",5,1,2,0)="PATIENT DATA remote procedure call (RPC) that extracts patient health data "
^DIC(9.4,214,22,1,"PAH",5,1,3,0)="from a Veterans Health Information Systems and Technology Architecture "
^DIC(9.4,214,22,1,"PAH",5,1,4,0)="(VistA) database in Extensible Markup Language (XML) format, requested by "
^DIC(9.4,214,22,1,"PAH",5,1,5,0)="the Joint Legacy Viewer (JLV) and Virtual Lifetime Electronic Record (VLER) "
^DIC(9.4,214,22,1,"PAH",5,1,6,0)="projects. Data domains updated are:"
^DIC(9.4,214,22,1,"PAH",5,1,7,0)="  * Demographics"
^DIC(9.4,214,22,1,"PAH",5,1,8,0)="  * Functional Independence Measurements (new)"
^DIC(9.4,214,22,1,"PAH",5,1,9,0)="  * Immunizations"
^DIC(9.4,214,22,1,"PAH",5,1,10,0)="  * Orders"
^DIC(9.4,214,22,1,"PAH",5,1,11,0)="  * Problems"
^DIC(9.4,214,22,1,"PAH",5,1,12,0)="  * Wellness Reminders (new)"
^DIC(9.4,214,22,1,"PAH",5,1,13,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,14,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,15,0)="Documentation Retrieval"
^DIC(9.4,214,22,1,"PAH",5,1,16,0)="-----------------------"
^DIC(9.4,214,22,1,"PAH",5,1,17,0)="Documentation can be found on the VA Software Documentation Library:"
^DIC(9.4,214,22,1,"PAH",5,1,18,0)=" http://www4.domain.ext/vdl/"
^DIC(9.4,214,22,1,"PAH",5,1,19,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,20,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,21,0)="Patch Installation"
^DIC(9.4,214,22,1,"PAH",5,1,22,0)="------------------"
^DIC(9.4,214,22,1,"PAH",5,1,23,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,214,22,1,"PAH",5,1,24,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,214,22,1,"PAH",5,1,25,0)="potential disruption to users.  This patch should take less than 1 minute "
^DIC(9.4,214,22,1,"PAH",5,1,26,0)="to install."
^DIC(9.4,214,22,1,"PAH",5,1,27,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,28,0)="1.  Choose the PackMan message containing this patch."
^DIC(9.4,214,22,1,"PAH",5,1,29,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,30,0)="2.  Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,214,22,1,"PAH",5,1,31,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,32,0)="3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,214,22,1,"PAH",5,1,33,0)="    the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,214,22,1,"PAH",5,1,34,0)="    following options. When prompted for the INSTALL NAME, enter VPR*1.0*5."
^DIC(9.4,214,22,1,"PAH",5,1,35,0)="  "
^DIC(9.4,214,22,1,"PAH",5,1,36,0)="    a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,214,22,1,"PAH",5,1,37,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,214,22,1,"PAH",5,1,38,0)="        backup any other changes such as DD?s or templates."
^DIC(9.4,214,22,1,"PAH",5,1,39,0)="    b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,214,22,1,"PAH",5,1,40,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,214,22,1,"PAH",5,1,41,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,214,22,1,"PAH",5,1,42,0)="        (routines, DD?s, templates, etc.)."
^DIC(9.4,214,22,1,"PAH",5,1,43,0)="    c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,214,22,1,"PAH",5,1,44,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,214,22,1,"PAH",5,1,45,0)="        transport global."
^DIC(9.4,214,22,1,"PAH",5,1,46,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,47,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,214,22,1,"PAH",5,1,48,0)="    choose the patch to install."
^DIC(9.4,214,22,1,"PAH",5,1,49,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,50,0)="5.  When prompted ?Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,214,22,1,"PAH",5,1,51,0)="    Install? NO//? enter NO."
^DIC(9.4,214,22,1,"PAH",5,1,52,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,53,0)="6.  When prompted ?Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,214,22,1,"PAH",5,1,54,0)="    NO//? enter NO."
^DIC(9.4,214,22,1,"PAH",5,1,55,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,56,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,214,22,1,"PAH",5,1,57,0)="    and Protocols? NO//? enter NO."
^DIC(9.4,214,22,1,"PAH",5,1,58,0)=" "
^DIC(9.4,214,22,1,"PAH",5,1,59,0)="8.  If prompted ?Delay Install (Minutes):  (0 ? 60): 0// respond 0."
^DIC(9.4,214,22,1,"PAH",6,0)="6 SEQ #5^3171005.122441^54"
^DIC(9.4,214,22,1,"PAH",6,1,0)="^^3^3^3171005"
^DIC(9.4,214,22,1,"PAH",6,1,1,0)="This patch updates the VPR GET PATIENT DATA remote procedure call "
^DIC(9.4,214,22,1,"PAH",6,1,2,0)="(RPC).  It will now parse for the ASCII BELL character among other"
^DIC(9.4,214,22,1,"PAH",6,1,3,0)="invalid ASCII characters."
^DIC(9.4,214,22,1,"PAH",7,0)="7 SEQ #6^3180907.121618^54"
^DIC(9.4,214,22,1,"PAH",8,0)="9 SEQ #7^3180907.131208^54"
^DIC(9.4,214,22,1,"PAH",8,1,0)="^^2^2^3180907"
^DIC(9.4,214,22,1,"PAH",8,1,1,0)="This patch address one ticket: INC1583647. The problem is that the "
^DIC(9.4,214,22,1,"PAH",8,1,2,0)="Radiology Contrast Media allergy isn't showing up on the JLV display."
^DIC(9.4,214,22,1,"PAH",9,0)="11 SEQ #8^3181105.110041^54"
^DIC(9.4,214,22,1,"PAH",9,1,0)="^^1^1^3181105"
^DIC(9.4,214,22,1,"PAH",9,1,1,0)="Please see the National Patch Module entry for VPR*1*11 for details."
^DIC(9.4,214,22,1,"PAH",10,0)="12 SEQ #9^3190201.160323^54"
^DIC(9.4,214,22,1,"PAH",10,1,0)="^^10^10^3190201"
^DIC(9.4,214,22,1,"PAH",10,1,1,0)="This patch will resolve the following issues in the VPR package:"
^DIC(9.4,214,22,1,"PAH",10,1,2,0)=" "
^DIC(9.4,214,22,1,"PAH",10,1,3,0)="1. The XML return from the ""Allergy/Adverse Reaction Tracking"" type does "
^DIC(9.4,214,22,1,"PAH",10,1,4,0)="not include the ""entered"" date field if the allergy is ""No known allergy""."
^DIC(9.4,214,22,1,"PAH",10,1,5,0)=" "
^DIC(9.4,214,22,1,"PAH",10,1,6,0)="2. The routine VPRDGMRA has unnecessary code that is potentially "
^DIC(9.4,214,22,1,"PAH",10,1,7,0)="dangerous."
^DIC(9.4,214,22,1,"PAH",10,1,8,0)=" "
^DIC(9.4,214,22,1,"PAH",10,1,9,0)="3. The initial Fill date is missing from the VPR XML output for "
^DIC(9.4,214,22,1,"PAH",10,1,10,0)="Outpatient Medications"
^DIC(9.4,214,22,1,"PAH",11,0)="8^3190301.140539^54"
^DIC(9.4,214,22,1,"PAH",11,1,0)="^^42^42^3190301"
^DIC(9.4,214,22,1,"PAH",11,1,1,0)="This patch extends the Virtual Patient Record (VPR) application, to "
^DIC(9.4,214,22,1,"PAH",11,1,2,0)="provide a new method of retrieving patient health data from a Veterans"
^DIC(9.4,214,22,1,"PAH",11,1,3,0)="Health Information Systems (VistA) database."
^DIC(9.4,214,22,1,"PAH",11,1,4,0)=" "
^DIC(9.4,214,22,1,"PAH",11,1,5,0)="Patch DI*22.2*9 released a new VA FileManager utility that provides the "
^DIC(9.4,214,22,1,"PAH",11,1,6,0)="ability to map VistA files and fields to other data models, and extract "
^DIC(9.4,214,22,1,"PAH",11,1,7,0)="that data as XML or JSON objects. This VPR patch will populate the new "
^DIC(9.4,214,22,1,"PAH",11,1,8,0)="Entity file (#1.5) to map VistA data elements to InterSystems' Summary "
^DIC(9.4,214,22,1,"PAH",11,1,9,0)="Data Architecture (SDA) model, and use the new supported calls to "
^DIC(9.4,214,22,1,"PAH",11,1,10,0)="retrieve the requested data."
^DIC(9.4,214,22,1,"PAH",11,1,11,0)=" "
^DIC(9.4,214,22,1,"PAH",11,1,12,0)="This patch also installs a mechanism to monitor clinical data events in "
^DIC(9.4,214,22,1,"PAH",11,1,13,0)="VistA, to enable retrieval of updated information as a patient's data"
^DIC(9.4,214,22,1,"PAH",11,1,14,0)="changes. New Protocol file (#101) entries will be added, and linked to"
^DIC(9.4,214,22,1,"PAH",11,1,15,0)="appropriate clinical application events; the file and record numbers"
^DIC(9.4,214,22,1,"PAH",11,1,16,0)="modified will be collected in the new VPR Subscription file (#560) until"
^DIC(9.4,214,22,1,"PAH",11,1,17,0)="retrieved and updated."
^DIC(9.4,214,22,1,"PAH",11,1,18,0)="  "
^DIC(9.4,214,22,1,"PAH",11,1,19,0)="  "
^DIC(9.4,214,22,1,"PAH",11,1,20,0)="Patch Installation:"
^DIC(9.4,214,22,1,"PAH",11,1,21,0)="-------------------"
^DIC(9.4,214,22,1,"PAH",11,1,22,0)="Software is being released as a host file, DI_222_9_VPR_1_8.KID.  The host"
^DIC(9.4,214,22,1,"PAH",11,1,23,0)="file contains two patches; DI*22.2*9 and VPR*1*8. Refer to Patch "
^DIC(9.4,214,22,1,"PAH",11,1,24,0)="DI*22.2*9 for installation instructions."
^DIC(9.4,214,22,1,"PAH",11,1,25,0)=" "
^DIC(9.4,214,22,1,"PAH",11,1,26,0)="Patches DI*22.2*9 and VPR*1*8 are scheduled to be released nationally as a"
^DIC(9.4,214,22,1,"PAH",11,1,27,0)="bundle.  Installation of these patches into Production within the first 5"
^DIC(9.4,214,22,1,"PAH",11,1,28,0)="days from the National Release date is requested. The VA leadership has "
^DIC(9.4,214,22,1,"PAH",11,1,29,0)="asked for an expedited release to comply with the schedule for the high"
^DIC(9.4,214,22,1,"PAH",11,1,30,0)="profile Mission Act.  Certain functionality has to be loaded into"
^DIC(9.4,214,22,1,"PAH",11,1,31,0)="production in 130 VA Medical Centers within a short timeframe.  We"
^DIC(9.4,214,22,1,"PAH",11,1,32,0)="appreciate your cooperation."
^DIC(9.4,214,22,1,"PAH",11,1,33,0)="  "
^DIC(9.4,214,22,1,"PAH",11,1,34,0)="  "
^DIC(9.4,214,22,1,"PAH",11,1,35,0)="Backout Procedures:"
^DIC(9.4,214,22,1,"PAH",11,1,36,0)="-------------------"
^DIC(9.4,214,22,1,"PAH",11,1,37,0)="Back-out will be done only with the concurrence and participation of the "
^DIC(9.4,214,22,1,"PAH",11,1,38,0)="development team, health product support, and appropriate VA site/region "
^DIC(9.4,214,22,1,"PAH",11,1,39,0)="personnel. All components exported by the patch (excluding linked "
^DIC(9.4,214,22,1,"PAH",11,1,40,0)="Protocol menus) are new and could be removed from the system if needed."
^DIC(9.4,214,22,1,"PAH",11,1,41,0)="Please call the national help desk or enter a help desk ticket for"
^DIC(9.4,214,22,1,"PAH",11,1,42,0)="assistance."
^DIC(9.4,214,22,1,"PAH",12,0)="13 SEQ #11^3190401.170032^54"
^DIC(9.4,214,22,1,"PAH",12,1,0)="^^1^1^3190401"
^DIC(9.4,214,22,1,"PAH",12,1,1,0)="PARTIAL FILL ON SAME DAY DOES NOT DISPLAY"
^DIC(9.4,214,22,1,"PAH",13,0)="10 SEQ #12^3190501.155824^54"
^DIC(9.4,214,22,1,"PAH",14,0)="15 SEQ #13^3190604.180845^54"
^DIC(9.4,214,22,1,"PAH",15,0)="16 SEQ #14^3190815.16162^65"
^DIC(9.4,214,22,1,"PAH",16,0)="17 SEQ #15^3191113.141212^65"
^DIC(9.4,214,22,1,"PAH",17,0)="19 SEQ #16^3191219.140458^65"
^DIC(9.4,214,22,1,"PAH",18,0)="21 SEQ #17^3200115.122116^65"
^DIC(9.4,214,22,1,"PAH",19,0)="22 SEQ #18^3200115.122516^65"
^DIC(9.4,214,22,1,"PAH",19,1,0)="^^2^2^3200115"
^DIC(9.4,214,22,1,"PAH",19,1,1,0)="Emergency Patch to correct incident INC9096091 with undefined errors in"
^DIC(9.4,214,22,1,"PAH",19,1,2,0)="VPR PTF entity."
^DIC(9.4,214,22,1,"PAH",20,0)="24 SEQ #19^3200311.110747^65"
^DIC(9.4,214,22,1,"PAH",21,0)="18 SEQ #20^3200330.130631^70"
^DIC(9.4,214,22,1,"PAH",21,1,0)="^^6^6^3200330"
^DIC(9.4,214,22,1,"PAH",21,1,1,0)="This patch will resolve the following issues in the Virtual Patient "
^DIC(9.4,214,22,1,"PAH",21,1,2,0)="Record (VPR)"
^DIC(9.4,214,22,1,"PAH",21,1,3,0)="package:"
^DIC(9.4,214,22,1,"PAH",21,1,4,0)=" "
^DIC(9.4,214,22,1,"PAH",21,1,5,0)="1.      INC8143771 - Wrong medication displaying on Essential Med List "
^DIC(9.4,214,22,1,"PAH",21,1,6,0)="and JLV; OEL^PSOORRL API used incorrectly"
^DIC(9.4,214,22,1,"PAH",22,0)="23 SEQ #21^3200721.122605^65"
^DIC(9.4,214,22,1,"PAH",23,0)="20 SEQ #22^3200819.112622^65"
^DIC(9.4,214,22,1,"PAH",24,0)="26 SEQ #23^3201217.172105^17"
^DIC(9.4,214,22,1,"PAH",25,0)="14 SEQ #24^3210202.123106^17"
^DIC(9.4,214,22,1,"PAH",26,0)="25b^3210420"
^DIC(9.4,214,22,1,"PAH",26,1,0)="^^5^5^3210420"
^DIC(9.4,214,22,1,"PAH",26,1,1,0)="Backup of VPR*1.0*25 on Apr 20, 2021"
^DIC(9.4,214,22,1,"PAH",26,1,2,0)=" "
^DIC(9.4,214,22,1,"PAH",26,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,214,22,1,"PAH",26,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,214,22,1,"PAH",26,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,214,22,1,"PAH",27,0)="25 SEQ #25^3210420.150442^17"
^DIC(9.4,214,22,1,"PAH",28,0)="27 SEQ #26^3211021.151822^17"
^DIC(9.4,214,22,1,"PAH",29,0)="28 SEQ #27^3220303.150034^17"
^DIC(9.4,214,22,1,"PAH",30,0)="29 SEQ #28^3220809.153337^86"
^DIC(9.4,214,22,1,"PAH",31,0)="30 SEQ #29^3230323.120734^89"
^DIC(9.4,214,22,1,"PAH",32,0)="31 SEQ #30^3230706.155129^89"
^DIC(9.4,214,22,1,"PAH",33,0)="32 SEQ #31^3230901.141133^89"
^DIC(9.4,214,22,1,"PAH",34,0)="34 SEQ #32^3230919.11153^89"
^DIC(9.4,214,22,1,"PAH",35,0)="33 SEQ #33^3240116.181441^89"
^DIC(9.4,214,22,1,"PAH",36,0)="35 SEQ #34^3240910.173142^89"
^DIC(9.4,214,22,1,"PAH",37,0)="36 SEQ #35^3250529.074207^90"
^DIC(9.4,214,22,1,"PAH",37,1,0)="^^4^4^3250529"
^DIC(9.4,214,22,1,"PAH",37,1,1,0)="This patch adds the following:"
^DIC(9.4,214,22,1,"PAH",37,1,2,0)=" "
^DIC(9.4,214,22,1,"PAH",37,1,3,0)="Vitals routine VPRDGMV was inadvertently left out of patch VPR*1*33. "
^DIC(9.4,214,22,1,"PAH",37,1,4,0)="Re-added in this patch."
