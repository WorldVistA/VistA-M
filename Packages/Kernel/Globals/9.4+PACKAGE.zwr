^DIC(9.4,60,22,13,"PAH",625,1,361,0)="7. Option to Edit RxChangeRequest Reason Template Text"
^DIC(9.4,60,22,13,"PAH",625,1,362,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,363,0)="   In the eRx Patient Centric Queue screen, a new hidden action called 'CRT CR"
^DIC(9.4,60,22,13,"PAH",625,1,364,0)="   Default Text Edit' has been added to enable users who hold the PSDMGR "
^DIC(9.4,60,22,13,"PAH",625,1,365,0)="   security key to modify the default RxChangeRequest Reason template. Please,"
^DIC(9.4,60,22,13,"PAH",625,1,366,0)="   refer to the user documentation for more information about this new option."
