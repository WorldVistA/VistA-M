^DIC(9.4,155,22,"B","2.0",1)=""
^DIC(9.4,155,"DEV")=""
^DIC(9.4,155,"VERSION")="2.0"
^DIC(9.4,159,0)="SAGG PROJECT^KMPS^SAGG (Statistical Analysis of Global Growth) Project"
^DIC(9.4,159,1,0)="^^3^3^2960820^^^"
^DIC(9.4,159,1,1,0)="The SAGG (Statistical Analysis of Global Growth) Project will produce data"
^DIC(9.4,159,1,2,0)="enabling all VAMCs and IRMFOs to make various statistical analysis studies"
^DIC(9.4,159,1,3,0)="of global growth patterns within the DHCP environment."
^DIC(9.4,159,5)="ALBANY IRMFO"
^DIC(9.4,159,7)="^^I"
^DIC(9.4,159,11)="8970.1^8970.1"
^DIC(9.4,159,14,0)="^9.4014^1^1"
^DIC(9.4,159,14,1,0)="A1B5"
^DIC(9.4,159,14,"B","A1B5",1)=""
^DIC(9.4,159,20,0)="^9.402P^^"
^DIC(9.4,159,22,0)="^9.49I^3^3"
^DIC(9.4,159,22,1,0)="1.7^2960820^2970306^1"
^DIC(9.4,159,22,1,1,0)="^^3^3^2970306"
^DIC(9.4,159,22,1,1,1,0)="The SAGG (Statistical Analysis of Global Growth) Project will produce data"
^DIC(9.4,159,22,1,1,2,0)="enabling all VAMCs and IRMFOs to make various statistical analysis studies"
^DIC(9.4,159,22,1,1,3,0)="of global growth patterns within the DHCP environment."
^DIC(9.4,159,22,2,0)="1.8^3051119^2980831^1"
^DIC(9.4,159,22,2,1,0)="^^23^23^3051119"
^DIC(9.4,159,22,2,1,1,0)="This KIDS distribution contains Statistical Analysis of Global Growth"
^DIC(9.4,159,22,2,1,2,0)="(SAGG) version 1.8.  This version of SAGG can be installed over any"
^DIC(9.4,159,22,2,1,3,0)="previous versions of SAGG without any adverse problems."
^DIC(9.4,159,22,2,1,4,0)=" "
^DIC(9.4,159,22,2,1,5,0)="All DSM, MSM and OpenM-NT sites are instructed to install this"
^DIC(9.4,159,22,2,1,6,0)="distribution.  Sites which had a pre-release of SAGG v 1.8 should also"
^DIC(9.4,159,22,2,1,7,0)="install this distribution."
^DIC(9.4,159,22,2,1,8,0)=" "
^DIC(9.4,159,22,2,1,9,0)="This distribution is dependent on the previous installation of Kernel"
^DIC(9.4,159,22,2,1,10,0)="Patch XU*8.0*90.  If this distribution detects that the patch is not"
^DIC(9.4,159,22,2,1,11,0)="installed at your site, the installation process will stop.  If this"
^DIC(9.4,159,22,2,1,12,0)="occurs, you will need to obtain and install Kernel Patch XU*8.0*90 and"
^DIC(9.4,159,22,2,1,13,0)="then you may begin the installation of this product.  The SAGG Project "
^DIC(9.4,159,22,2,1,14,0)="v 1.8 package will utilize the %ZOSVKS-namespace routines that were"
^DIC(9.4,159,22,2,1,15,0)="installed with Kernel Patch XU*8.0*90."
^DIC(9.4,159,22,2,1,16,0)=" "
^DIC(9.4,159,22,2,1,17,0)="This distribution will move SAGG from the A1B5 namespace into the KMPS"
^DIC(9.4,159,22,2,1,18,0)="namespace.  The data within the old SAGG PROJECT file (#11120) will be"
^DIC(9.4,159,22,2,1,19,0)="moved into new SAGG PROJECT file (#8970.1).  The old file, routines,"
^DIC(9.4,159,22,2,1,20,0)="options and mail group will be deleted."
^DIC(9.4,159,22,2,1,21,0)=" "
^DIC(9.4,159,22,2,1,22,0)="The 'SAGG Project Manager' menu [KMPS SAGG MANAGER] will be added to the"
^DIC(9.4,159,22,2,1,23,0)="'Capacity Management' [XTCM MAIN] menu."
^DIC(9.4,159,22,2,"PAH",0)="^9.4901^3^3"
^DIC(9.4,159,22,2,"PAH",1,0)="1 SEQ #1^2990602^1"
^DIC(9.4,159,22,2,"PAH",1,1,0)="^^59^59^2990602"
^DIC(9.4,159,22,2,"PAH",1,1,1,0)="Associated patches: XU*8*121"
^DIC(9.4,159,22,2,"PAH",1,1,2,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,3,0)="Subject:  Collect Disk Capacity Information"
^DIC(9.4,159,22,2,"PAH",1,1,4,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,5,0)="Category:"
^DIC(9.4,159,22,2,"PAH",1,1,6,0)="  - Routine"
^DIC(9.4,159,22,2,"PAH",1,1,7,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,8,0)="Description:"
^DIC(9.4,159,22,2,"PAH",1,1,9,0)="============"
^DIC(9.4,159,22,2,"PAH",1,1,10,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,11,0)="This patch is being released by Capacity Management (CM) to allow"
^DIC(9.4,159,22,2,"PAH",1,1,12,0)="the Statistical Analysis of Global Growth (SAGG) Version 1.8 software"
^DIC(9.4,159,22,2,"PAH",1,1,13,0)="package to collect disk capacity information from the sites."
^DIC(9.4,159,22,2,"PAH",1,1,14,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,15,0)="All DSM, MSM and OpenM-NT sites are instructed to install this patch."
^DIC(9.4,159,22,2,"PAH",1,1,16,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,17,0)="This patch, in conjunction with Kernel patch XU*8*121, will support the"
^DIC(9.4,159,22,2,"PAH",1,1,18,0)="collection of disk capacity information from the following operating"
^DIC(9.4,159,22,2,"PAH",1,1,19,0)="system platforms: DSM and OpenM-NT."
^DIC(9.4,159,22,2,"PAH",1,1,20,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,21,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,22,0)="Installation:"
^DIC(9.4,159,22,2,"PAH",1,1,23,0)="============="
^DIC(9.4,159,22,2,"PAH",1,1,24,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,25,0)="Provided that the 'SAGG Master Background Task' [KMPS SAGG REPORT] is not"
^DIC(9.4,159,22,2,"PAH",1,1,26,0)="currently running, this installation can be performed at any time of the"
^DIC(9.4,159,22,2,"PAH",1,1,27,0)="day with minimal disruption to users.  Installation should not take longer"
^DIC(9.4,159,22,2,"PAH",1,1,28,0)="than 10-15 minutes."
^DIC(9.4,159,22,2,"PAH",1,1,29,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,30,0)="   1.  DSM and MSM sites - You will need to diable any routines within "
^DIC(9.4,159,22,2,"PAH",1,1,31,0)="       the KMPS* namespace."
^DIC(9.4,159,22,2,"PAH",1,1,32,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,33,0)="   2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,159,22,2,"PAH",1,1,34,0)="       option will load the KIDS package onto your system."
^DIC(9.4,159,22,2,"PAH",1,1,35,0)=" "
^DIC(9.4,159,22,2,"PAH",1,1,36,0)="   3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,159,22,2,"PAH",1,1,37,0)="       system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,159,22,2,"PAH",1,1,38,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,159,22,2,"PAH",1,1,39,0)="       options:"
^DIC(9.4,159,22,2,"PAH",1,1,40,0)="          "
^DIC(9.4,159,22,2,"PAH",1,1,41,0)="          Verify Checksums in Transport Global"
^DIC(9.4,159,22,2,"PAH",1,1,42,0)="          Print Transport Global"
^DIC(9.4,159,22,2,"PAH",1,1,43,0)="          Compare Transport Global to Current System"
^DIC(9.4,159,22,2,"PAH",1,1,44,0)="          Backup a Transport Global"
^DIC(9.4,159,22,2,"PAH",1,1,45,0)="                                   "
^DIC(9.4,159,22,2,"PAH",1,1,46,0)="   4.  As this install only affects the SAGG Master Background Task, you"
^DIC(9.4,159,22,2,"PAH",1,1,47,0)="       do not have to inhibit users from login into the system."
^DIC(9.4,159,22,2,"PAH",1,1,48,0)="       "
^DIC(9.4,159,22,2,"PAH",1,1,49,0)="   5.  On the KIDS menu, under the 'Installation' menu, use the 'Install"
^DIC(9.4,159,22,2,"PAH",1,1,50,0)="       Package(s)' option and select the package KMPS*1.8*1."
^DIC(9.4,159,22,2,"PAH",1,1,51,0)="                                                 =========="
^DIC(9.4,159,22,2,"PAH",1,1,52,0)="       "
^DIC(9.4,159,22,2,"PAH",1,1,53,0)="   6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,159,22,2,"PAH",1,1,54,0)="       Protocols? NO//', you can respond with NO."
^DIC(9.4,159,22,2,"PAH",1,1,55,0)="       "
^DIC(9.4,159,22,2,"PAH",1,1,56,0)="   7.  DSM and MSM sites - after the patch has installed, rebuild your map"
^DIC(9.4,159,22,2,"PAH",1,1,57,0)="       set if necessary."
^DIC(9.4,159,22,2,"PAH",1,1,58,0)="       "
^DIC(9.4,159,22,2,"PAH",1,1,59,0)="       The KMPS* namespaced routines are NOT recommended to be mapped.    "
^DIC(9.4,159,22,2,"PAH",2,0)="2^3020814^1"
^DIC(9.4,159,22,2,"PAH",2,1,0)="^^161^161^3020814"
^DIC(9.4,159,22,2,"PAH",2,1,1,0)="Description: "
^DIC(9.4,159,22,2,"PAH",2,1,2,0)="============"
^DIC(9.4,159,22,2,"PAH",2,1,3,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,4,0)="This patch is being released by Capacity Management (CM) to correct the"
^DIC(9.4,159,22,2,"PAH",2,1,5,0)="'Invalid reverse-path specification' transmission error within the"
^DIC(9.4,159,22,2,"PAH",2,1,6,0)="Statistical Analysis of Global Growth (SAGG) Version 1.8 software package."
^DIC(9.4,159,22,2,"PAH",2,1,7,0)="This patch release will also allow the collection routines to run on Cache"
^DIC(9.4,159,22,2,"PAH",2,1,8,0)="for OpenVMS platforms."
^DIC(9.4,159,22,2,"PAH",2,1,9,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,10,0)="All DSM, Cache for Windows NT and Cache for OpenVMS sites are instructed"
^DIC(9.4,159,22,2,"PAH",2,1,11,0)="to install this patch."
^DIC(9.4,159,22,2,"PAH",2,1,12,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,13,0)="The original 'Status of SAGG Collection Routines' [KMPS SAGG STATUS] "
^DIC(9.4,159,22,2,"PAH",2,1,14,0)="option has been renamed as the 'Check SAGG Environment' option.  In "
^DIC(9.4,159,22,2,"PAH",2,1,15,0)="addition to providing the previous information regarding the SAGG "
^DIC(9.4,159,22,2,"PAH",2,1,16,0)="collection routines, this option will now check the status of SAGG patch "
^DIC(9.4,159,22,2,"PAH",2,1,17,0)="installation at the site."
^DIC(9.4,159,22,2,"PAH",2,1,18,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,19,0)="The local mail message that is generated when the the SAGG background "
^DIC(9.4,159,22,2,"PAH",2,1,20,0)="routines complete their collection process has been enhanced to "
^DIC(9.4,159,22,2,"PAH",2,1,21,0)="accommodate the expanded volume set names found on the Cache for OpenVMS "
^DIC(9.4,159,22,2,"PAH",2,1,22,0)="and Cache for Windows NT platforms.  In addition, the local message will"
^DIC(9.4,159,22,2,"PAH",2,1,23,0)="recommend that the background job be run over the weekend hours if the job"
^DIC(9.4,159,22,2,"PAH",2,1,24,0)="is started during the weekday."
^DIC(9.4,159,22,2,"PAH",2,1,25,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,26,0)="The pre-install routine of this patch will move mail members from the"
^DIC(9.4,159,22,2,"PAH",2,1,27,0)="KMPS-SAGG mail group to the KMP-CAPMAN mail group.  The KMP-CAPMAN"
^DIC(9.4,159,22,2,"PAH",2,1,28,0)="mail-group was created with the release of the Resource Usage Monitor"
^DIC(9.4,159,22,2,"PAH",2,1,29,0)="(RUM) package.  All SAGG notification messages will start utilizing the"
^DIC(9.4,159,22,2,"PAH",2,1,30,0)="KMP-CAPMAN mail group.  Any mail groups within the MAIL GROUP file that"
^DIC(9.4,159,22,2,"PAH",2,1,31,0)="have KMPS-SAGG as a MEMBER GROUP will have the KMPS-SAGG entry removed."
^DIC(9.4,159,22,2,"PAH",2,1,32,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,33,0)="This patch will remove the KMPS-SAGG mail group from the MAIL GROUP file."
^DIC(9.4,159,22,2,"PAH",2,1,34,0)="The 'Edit KMPS-SAGG Mail Group' [KMPS SAGG MAIL] option will be deleted."
^DIC(9.4,159,22,2,"PAH",2,1,35,0)="Use the 'Capacity Management Mail Group Edit' [KMP MAIL GROUP EDIT] option"
^DIC(9.4,159,22,2,"PAH",2,1,36,0)="to change the the membership of the mail group that will receive package"
^DIC(9.4,159,22,2,"PAH",2,1,37,0)="notification messages."
^DIC(9.4,159,22,2,"PAH",2,1,38,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,39,0)="This patch will now allow SAGG to accept alphanumeric characters within "
^DIC(9.4,159,22,2,"PAH",2,1,40,0)="the site number.  This problem had effected the MPI facility located in"
^DIC(9.4,159,22,2,"PAH",2,1,41,0)="Austin."
^DIC(9.4,159,22,2,"PAH",2,1,42,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,43,0)="This patch will enable the collection of hardware information from sites"
^DIC(9.4,159,22,2,"PAH",2,1,44,0)="running DSM.  The hardware information will consist of the hardware name "
^DIC(9.4,159,22,2,"PAH",2,1,45,0)="(such as Compaq AlphaServer ES40) and the number of active cpu processors "
^DIC(9.4,159,22,2,"PAH",2,1,46,0)="installed within each node."
^DIC(9.4,159,22,2,"PAH",2,1,47,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,48,0)="SOFTWARE RETRIEVAL"
^DIC(9.4,159,22,2,"PAH",2,1,49,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,50,0)="The software patch is not being distributed through the National Patch "
^DIC(9.4,159,22,2,"PAH",2,1,51,0)="Module. The patch is being distributed as a host file."
^DIC(9.4,159,22,2,"PAH",2,1,52,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,53,0)="  Host file name: KMPS1_8_2.KID"
^DIC(9.4,159,22,2,"PAH",2,1,54,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,55,0)="This file contains patch KMPS*1.8*2"
^DIC(9.4,159,22,2,"PAH",2,1,56,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,57,0)="Sites may retrieve the patch directly using FTP from the "
^DIC(9.4,159,22,2,"PAH",2,1,58,0)="ANONYMOUS.SOFTWARE directory at the following OI Field Offices:"
^DIC(9.4,159,22,2,"PAH",2,1,59,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,60,0)="          Albany: ftp.fo-albany.domain.ext"
^DIC(9.4,159,22,2,"PAH",2,1,61,0)="           Hines: ftp.fo-hines.domain.ext"
^DIC(9.4,159,22,2,"PAH",2,1,62,0)="  Salt Lake City: ftp.fo-slc.domain.ext"
^DIC(9.4,159,22,2,"PAH",2,1,63,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,64,0)="The following file will be available:"
^DIC(9.4,159,22,2,"PAH",2,1,65,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,66,0)="  File Name            Description"
^DIC(9.4,159,22,2,"PAH",2,1,67,0)="  ---------            -----------"
^DIC(9.4,159,22,2,"PAH",2,1,68,0)="  KMPS1_8_2.KID        Host file containing KIDS software distribution"
^DIC(9.4,159,22,2,"PAH",2,1,69,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,70,0)="  * NOTE: Use ASCII mode when transferring the .KID file"
^DIC(9.4,159,22,2,"PAH",2,1,71,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,72,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,73,0)="                     Checksum"
^DIC(9.4,159,22,2,"PAH",2,1,74,0)="Routine           Old        New             2nd Line"
^DIC(9.4,159,22,2,"PAH",2,1,75,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,76,0)="KMPSENV           n/a        45940           **2**"
^DIC(9.4,159,22,2,"PAH",2,1,77,0)="KMPSGE        20004053     9750122           **1,2**"
^DIC(9.4,159,22,2,"PAH",2,1,78,0)="KMPSLK        14824425    10632243           **1,2**"
^DIC(9.4,159,22,2,"PAH",2,1,79,0)="KMPSPRE           n/a      6696549           **2**"
^DIC(9.4,159,22,2,"PAH",2,1,80,0)="KMPSPST           n/a      1162953           **2**"
^DIC(9.4,159,22,2,"PAH",2,1,81,0)="KMPSUTL       17505897    15926854           **1,2**"
^DIC(9.4,159,22,2,"PAH",2,1,82,0)="KMPSUTL1          n/a      4494004           **1,2**"
^DIC(9.4,159,22,2,"PAH",2,1,83,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,84,0)="NOTE:  KMPSENV is an environment check routine used during patch install."
^DIC(9.4,159,22,2,"PAH",2,1,85,0)="       KMPSPRE is a pre-install routine used during patch install."
^DIC(9.4,159,22,2,"PAH",2,1,86,0)="       KMPSPST is a post-install routine used during patch install."
^DIC(9.4,159,22,2,"PAH",2,1,87,0)="       KMPSUTL1 is a new routine."
^DIC(9.4,159,22,2,"PAH",2,1,88,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,89,0)="Checksums calculated by CHECK^XTSUMBLD"
^DIC(9.4,159,22,2,"PAH",2,1,90,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,91,0)="Test sites include Albany IOFO, Cincinnati, Cleveland, Connecticut HCS, "
^DIC(9.4,159,22,2,"PAH",2,1,92,0)="Fayettville AR, Forum, Maryland HCS, Tomah, Washington and White River."
^DIC(9.4,159,22,2,"PAH",2,1,93,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,94,0)="This patch addresses the following NOISes:"
^DIC(9.4,159,22,2,"PAH",2,1,95,0)="  WIC-0301-41553, TOM-1201-41071, WIM-0302-22413, HIN-0602-41061, "
^DIC(9.4,159,22,2,"PAH",2,1,96,0)="  FAV-0602-71295, CIN-0602-41640, SBY-0602-31773, MOU-0602-32292,"
^DIC(9.4,159,22,2,"PAH",2,1,97,0)="  TAM-0602-32529, NOL-0702-70404, LAS-0702-60685, WPB-0702-30974,"
^DIC(9.4,159,22,2,"PAH",2,1,98,0)="  SLC-0702-50997, LEB-0702-21442, CHS-0702-41454, SDC-0702-61500,"
^DIC(9.4,159,22,2,"PAH",2,1,99,0)="  CMM-0702-N1799, LAH-0702-61988, ATG-0702-32243, COA-0702-22639, and"
^DIC(9.4,159,22,2,"PAH",2,1,100,0)="  MON-0702-53239. "
^DIC(9.4,159,22,2,"PAH",2,1,101,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,102,0)="Installation Steps:"
^DIC(9.4,159,22,2,"PAH",2,1,103,0)="==================="
^DIC(9.4,159,22,2,"PAH",2,1,104,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,105,0)="Provided that the 'SAGG Master Background Task' [KMPS SAGG REPORT] is not "
^DIC(9.4,159,22,2,"PAH",2,1,106,0)="currently running, this installation can be performed at any time of the day"
^DIC(9.4,159,22,2,"PAH",2,1,107,0)="with minimal disruption to users.  Installation should not take longer than"
^DIC(9.4,159,22,2,"PAH",2,1,108,0)="10-15 minutes.  "
^DIC(9.4,159,22,2,"PAH",2,1,109,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,110,0)="   1.  Review the mail members of the KMPS-SAGG and KMP-CAPMAN mail groups"
^DIC(9.4,159,22,2,"PAH",2,1,111,0)="       with the FileMan Inquiry option. A pre-install routine will attempt"
^DIC(9.4,159,22,2,"PAH",2,1,112,0)="       to move mail members from the KMPS-SAGG mail group to the "
^DIC(9.4,159,22,2,"PAH",2,1,113,0)="       KMP-CAPMAN mail group."
^DIC(9.4,159,22,2,"PAH",2,1,114,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,115,0)="       Any mail members that are not automatically moved will need to be "
^DIC(9.4,159,22,2,"PAH",2,1,116,0)="       entered manually with FileMan into the KMP-CAPMAN mail group after"
^DIC(9.4,159,22,2,"PAH",2,1,117,0)="       completion of the patch installation process."
^DIC(9.4,159,22,2,"PAH",2,1,118,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,119,0)="       The patch will delete the KMPS-SAGG mail group during the patch "
^DIC(9.4,159,22,2,"PAH",2,1,120,0)="       installation process."
^DIC(9.4,159,22,2,"PAH",2,1,121,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,122,0)="   2.  DSM sites - You will need to disable any routines within the KMPS*"
^DIC(9.4,159,22,2,"PAH",2,1,123,0)="       namespace.  "
^DIC(9.4,159,22,2,"PAH",2,1,124,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,125,0)="   3.  Download the KIDS file KMPS1_8_2.KID from the ANONYMOUS.SOFTWARE"
^DIC(9.4,159,22,2,"PAH",2,1,126,0)="       directory of either Albany, Hines or the Salt Lake OIFO to the"
^DIC(9.4,159,22,2,"PAH",2,1,127,0)="       appropriate directory on your system."
^DIC(9.4,159,22,2,"PAH",2,1,128,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,129,0)="   4.  Use 'Load a Distribution' option on the KIDS 'Installation' menu,"
^DIC(9.4,159,22,2,"PAH",2,1,130,0)="       and enter: KMPS1_8_2.KID"
^DIC(9.4,159,22,2,"PAH",2,1,131,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,132,0)="       Provide the necessary directory path to the file if needed."
^DIC(9.4,159,22,2,"PAH",2,1,133,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,134,0)="   5.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,159,22,2,"PAH",2,1,135,0)="       system.  You now need to use KIDS to install the Transport global.  "
^DIC(9.4,159,22,2,"PAH",2,1,136,0)="       On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,159,22,2,"PAH",2,1,137,0)="       options: "
^DIC(9.4,159,22,2,"PAH",2,1,138,0)="          "
^DIC(9.4,159,22,2,"PAH",2,1,139,0)="          Verify Checksums in Transport Global "
^DIC(9.4,159,22,2,"PAH",2,1,140,0)="          Print Transport Global "
^DIC(9.4,159,22,2,"PAH",2,1,141,0)="          Compare Transport Global to Current System "
^DIC(9.4,159,22,2,"PAH",2,1,142,0)="          Backup a Transport Global "
^DIC(9.4,159,22,2,"PAH",2,1,143,0)="                                   "
^DIC(9.4,159,22,2,"PAH",2,1,144,0)="   6.  As this install only affects the SAGG Master Background Task, you "
^DIC(9.4,159,22,2,"PAH",2,1,145,0)="       do not have to inhibit users from login into the system.  "
^DIC(9.4,159,22,2,"PAH",2,1,146,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,147,0)="   7.  On the KIDS menu, under the 'Installation' menu, use the 'Install "
^DIC(9.4,159,22,2,"PAH",2,1,148,0)="       Package(s)' option and select the package KMPS*1.8*2.  "
^DIC(9.4,159,22,2,"PAH",2,1,149,0)="                                                 =========="
^DIC(9.4,159,22,2,"PAH",2,1,150,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,151,0)="   8.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,159,22,2,"PAH",2,1,152,0)="       Protocols? NO//', you can respond with NO.  "
^DIC(9.4,159,22,2,"PAH",2,1,153,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,154,0)="   9.  DSM sites - after the patch has installed, rebuild your map set if"
^DIC(9.4,159,22,2,"PAH",2,1,155,0)="       necessary.  "
^DIC(9.4,159,22,2,"PAH",2,1,156,0)="       "
^DIC(9.4,159,22,2,"PAH",2,1,157,0)="       The KMPS* namespaced routines are NOT recommended to be mapped.    "
^DIC(9.4,159,22,2,"PAH",2,1,158,0)=" "
^DIC(9.4,159,22,2,"PAH",2,1,159,0)="  10.  Review the contents of the KMP-CAPMAN mail group with the FileMan "
^DIC(9.4,159,22,2,"PAH",2,1,160,0)="       Inquiry option to ensure that the members of the KMPS-SAGG mail "
^DIC(9.4,159,22,2,"PAH",2,1,161,0)="       group have been properly copied."
^DIC(9.4,159,22,2,"PAH",3,0)="3^3041015^1"
^DIC(9.4,159,22,2,"PAH",3,1,0)="^^19^19^3041015"
^DIC(9.4,159,22,2,"PAH",3,1,1,0)="See patch KMPS*1.8*3 in the National Patch Module on FORUM for complete "
^DIC(9.4,159,22,2,"PAH",3,1,2,0)="information on this patch."
^DIC(9.4,159,22,2,"PAH",3,1,3,0)=" "
^DIC(9.4,159,22,2,"PAH",3,1,4,0)="This patch is being released by Capacity Planning (CP) to update the "
^DIC(9.4,159,22,2,"PAH",3,1,5,0)="'Check SAGG Environment' [KMPS SAGG STATUS] option after the installation"
^DIC(9.4,159,22,2,"PAH",3,1,6,0)="of Kernel patch XU*8*268."
^DIC(9.4,159,22,2,"PAH",3,1,7,0)=" "
^DIC(9.4,159,22,2,"PAH",3,1,8,0)="NOTE: Kernel patch XU*8*268 must be installed BEFORE installation of this"
^DIC(9.4,159,22,2,"PAH",3,1,9,0)="      patch."
^DIC(9.4,159,22,2,"PAH",3,1,10,0)=" "
^DIC(9.4,159,22,2,"PAH",3,1,11,0)="All DSM, Cache for Windows NT and Cache for OpenVMS sites are instructed "
^DIC(9.4,159,22,2,"PAH",3,1,12,0)="to install this patch after the installation of Kernel patch XU*8*268."
^DIC(9.4,159,22,2,"PAH",3,1,13,0)=" "
^DIC(9.4,159,22,2,"PAH",3,1,14,0)="This patch will allow the 'Check SAGG Environment' option to properly "
^DIC(9.4,159,22,2,"PAH",3,1,15,0)="display the current patches that are installed and required at the "
^DIC(9.4,159,22,2,"PAH",3,1,16,0)="site."
^DIC(9.4,159,22,2,"PAH",3,1,17,0)=" "
^DIC(9.4,159,22,2,"PAH",3,1,18,0)="This patch will also change the way SAGG obtains the M version for DSM "
^DIC(9.4,159,22,2,"PAH",3,1,19,0)="sites."
