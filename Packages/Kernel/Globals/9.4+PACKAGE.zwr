^DIC(9.4,47,22,5.9,"PAH",175,0)="247^3000525^1"
^DIC(9.4,47,22,5.9,"PAH",176,0)="246 SEQ #252^3000525^1"
^DIC(9.4,47,22,5.9,"PAH",176,1,0)="^^1^1^3000525"
^DIC(9.4,47,22,5.9,"PAH",176,1,1,0)="Patient Wristband and History Listing."
^DIC(9.4,47,22,5.9,"PAH",177,0)="288 SEQ #254^3000612^1"
^DIC(9.4,47,22,5.9,"PAH",177,1,0)="^^2^2^3000612"
^DIC(9.4,47,22,5.9,"PAH",177,1,1,0)="This patch updates the PTF Census Dates (#45.86) file with the dates for"
^DIC(9.4,47,22,5.9,"PAH",177,1,2,0)="the 3rd quarter PTF census."
^DIC(9.4,47,22,5.9,"PAH",178,0)="255 SEQ #255^3000626^1"
^DIC(9.4,47,22,5.9,"PAH",178,1,0)="^^3^3^3000626"
^DIC(9.4,47,22,5.9,"PAH",178,1,1,0)="VAFC EXCEPTION HANDLER OPTION"
^DIC(9.4,47,22,5.9,"PAH",178,1,2,0)="Refer to patch DG*5.3*255 in the FORUM Patch Module for a complete "
^DIC(9.4,47,22,5.9,"PAH",178,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",179,0)="291 SEQ #256^3000711^1"
^DIC(9.4,47,22,5.9,"PAH",179,1,0)="^^1^1^3000711"
^DIC(9.4,47,22,5.9,"PAH",179,1,1,0)="See National Patch Module (Patch DG*5.3*291) for details."
^DIC(9.4,47,22,5.9,"PAH",180,0)="236 SEQ #257^3000711^1"
^DIC(9.4,47,22,5.9,"PAH",180,1,0)="^^13^13^3000711"
^DIC(9.4,47,22,5.9,"PAH",180,1,1,0)="This patch installs the routine and Data Dictionary change required to"
^DIC(9.4,47,22,5.9,"PAH",180,1,2,0)="perform the Data Collection process which will be used to seed the"
^DIC(9.4,47,22,5.9,"PAH",180,1,3,0)="Commercial-Off-The-Shelf Resident Assessment Instrument / Minimum Data Set"
^DIC(9.4,47,22,5.9,"PAH",180,1,4,0)="Ver. 2.0 (RAI/MDS).  MDS Ver 2.0 is currently used in Medicare (Title 18)"
^DIC(9.4,47,22,5.9,"PAH",180,1,5,0)="skilled nursing facilities and Medicaid (Title 19) nursing facilities."
^DIC(9.4,47,22,5.9,"PAH",180,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",180,1,7,0)="In May 1995, the VHA's Long-term Care Policy Plan, Information Letter IL"
^DIC(9.4,47,22,5.9,"PAH",180,1,8,0)="10-95-024 was approved and charged the Office of Geriatrics and Extended"
^DIC(9.4,47,22,5.9,"PAH",180,1,9,0)="Care with national implementation and automation of the RAI/MDS.  Under"
^DIC(9.4,47,22,5.9,"PAH",180,1,10,0)="this instruction, a commercial product was selected to implement this"
^DIC(9.4,47,22,5.9,"PAH",180,1,11,0)="direction.  This patch installs the Data Collection functionality needed"
^DIC(9.4,47,22,5.9,"PAH",180,1,12,0)="by the COTS system for initial data seeding of the HL7 interface required"
^DIC(9.4,47,22,5.9,"PAH",180,1,13,0)="for this product."
^DIC(9.4,47,22,5.9,"PAH",181,0)="227 SEQ #258^3000711^1"
^DIC(9.4,47,22,5.9,"PAH",181,1,0)="^^9^9^3000711"
^DIC(9.4,47,22,5.9,"PAH",181,1,1,0)="This patch corrects the problem of not being able to enter a future date"
^DIC(9.4,47,22,5.9,"PAH",181,1,2,0)="on the last day of the month when running the ""List of Patients on ASIH"" "
^DIC(9.4,47,22,5.9,"PAH",181,1,3,0)="report.  The correction to this problem enables the user to enter any future"
^DIC(9.4,47,22,5.9,"PAH",181,1,4,0)="date.  In so doing, if a future date is entered the user is reminded that they"
^DIC(9.4,47,22,5.9,"PAH",181,1,5,0)="may want to queue this report so as to avoid printing a negative report."
^DIC(9.4,47,22,5.9,"PAH",181,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",181,1,7,0)="This problem was reported in NOIS # MIN-0199-42808."
^DIC(9.4,47,22,5.9,"PAH",181,1,8,0)=" "
^DIC(9.4,47,22,5.9,"PAH",181,1,9,0)="The routine DGOASIH was modified to correct this problem."
^DIC(9.4,47,22,5.9,"PAH",182,0)="234 SEQ #259^3000724^1"
^DIC(9.4,47,22,5.9,"PAH",182,1,0)="^^3^3^3000724"
^DIC(9.4,47,22,5.9,"PAH",182,1,1,0)="This patch addresses the Tricare/Champus issue, where closing PTF records"
^DIC(9.4,47,22,5.9,"PAH",182,1,2,0)="for patients with a single eligibility of ""Tricare/Champus"" paired with a"
^DIC(9.4,47,22,5.9,"PAH",182,1,3,0)="Period of Service of ""Champus"" causes the 114 error."
^DIC(9.4,47,22,5.9,"PAH",183,0)="258 SEQ #260^3000816^1"
^DIC(9.4,47,22,5.9,"PAH",183,1,0)="^^1^1^3000816"
^DIC(9.4,47,22,5.9,"PAH",183,1,1,0)="See National Patch Module for details."
^DIC(9.4,47,22,5.9,"PAH",184,0)="270 SEQ #261^3000816^1"
^DIC(9.4,47,22,5.9,"PAH",185,0)="190^3000824^1"
^DIC(9.4,47,22,5.9,"PAH",185,1,0)="^^12^12^3000824"
^DIC(9.4,47,22,5.9,"PAH",185,1,1,0)="This patch installs the routines and Data Dictionary changes required for"
^DIC(9.4,47,22,5.9,"PAH",185,1,2,0)="the VistA HL7 Interface to the Commercial-Off-The-Shelf Resident"
^DIC(9.4,47,22,5.9,"PAH",185,1,3,0)="Assessment Instrument / Minimum Data Set Ver. 2.0 (RAI/MDS).  MDS Ver 2.0"
^DIC(9.4,47,22,5.9,"PAH",185,1,4,0)="is currently used in Medicare (Title 18) skilled nursing facilities and"
^DIC(9.4,47,22,5.9,"PAH",185,1,5,0)="Medicaid (Title 19) nursing facilities."
^DIC(9.4,47,22,5.9,"PAH",185,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",185,1,7,0)="In May 1995, the VHA's Long-term Care Policy Plan, Information Letter IL"
^DIC(9.4,47,22,5.9,"PAH",185,1,8,0)="10-95-024 was approved and charged the Office of Geriatrics and Extended"
^DIC(9.4,47,22,5.9,"PAH",185,1,9,0)="Care with national implementation and automation of the RAI/MDS.  Under"
^DIC(9.4,47,22,5.9,"PAH",185,1,10,0)="this instruction, a commercial product was selected to implement this"
^DIC(9.4,47,22,5.9,"PAH",185,1,11,0)="direction.  This patch installs the VistA portion of the HL7 interface"
^DIC(9.4,47,22,5.9,"PAH",185,1,12,0)="required for this commercial product."
^DIC(9.4,47,22,5.9,"PAH",186,0)="292 SEQ #263^3000824^1"
^DIC(9.4,47,22,5.9,"PAH",186,1,0)="^^1^1^3000824"
^DIC(9.4,47,22,5.9,"PAH",186,1,1,0)="See National Patch Module (Patch DG*5.3*292) for details."
^DIC(9.4,47,22,5.9,"PAH",187,0)="278 SEQ #264^3000824^1"
^DIC(9.4,47,22,5.9,"PAH",187,1,0)="^^2^2^3000824"
^DIC(9.4,47,22,5.9,"PAH",187,1,1,0)="Delete patients from PATIENT/IHS FILE when patients are deleted from"
^DIC(9.4,47,22,5.9,"PAH",187,1,2,0)="PATIENT FILE."
^DIC(9.4,47,22,5.9,"PAH",188,0)="295 SEQ #265^3000824^1"
^DIC(9.4,47,22,5.9,"PAH",188,1,0)="^^3^3^3000824"
