^DIC(9.4,134,22,17,"PAH",20,1,163,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,164,0)="Routine list of preceding patches: 19"
^DIC(9.4,134,22,17,"PAH",21,0)="25 SEQ #23^3220110.145613^17"
^DIC(9.4,134,22,17,"PAH",21,1,0)="^^8^8^3220110"
^DIC(9.4,134,22,17,"PAH",21,1,1,0)="This patch will retire the Patient Representative (QAC) version 2.0 "
^DIC(9.4,134,22,17,"PAH",21,1,2,0)="package.  All national components associated with the Patient"
^DIC(9.4,134,22,17,"PAH",21,1,3,0)="Representative and Veterans Health Information Systems and Technology "
^DIC(9.4,134,22,17,"PAH",21,1,4,0)="Architecture (VistA) Patient Advocate Tracking System (PATS) packages"
^DIC(9.4,134,22,17,"PAH",21,1,5,0)="will be removed.  Every site may not have all the listed components."
^DIC(9.4,134,22,17,"PAH",21,1,6,0)=" "
^DIC(9.4,134,22,17,"PAH",21,1,7,0)="All scheduled Patient Representative options must be unscheduled before "
^DIC(9.4,134,22,17,"PAH",21,1,8,0)="installing this patch."
