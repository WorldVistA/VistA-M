^DIC(9.4,202,22,1,"PAH",2,1,107,0)="                Update DD: YES"
^DIC(9.4,202,22,1,"PAH",2,1,108,0)="       Send Security Code: YES"
^DIC(9.4,202,22,1,"PAH",2,1,109,0)="     Date Comes With File: YES"
