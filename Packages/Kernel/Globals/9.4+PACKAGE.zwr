^DIC(9.4,14,22,5.9,"PAH",98,1,833,0)="THERE ARE PROCEDURES IN PCE BUT NO RECORD IN SCHEDULING **"
^DIC(9.4,14,22,5.9,"PAH",98,1,834,0)=" "
