^DIC(9.4,85,22,1.5,"PAH",14,1,3,0)="NOIS TNV-0902-30675 (Remedy Ticket HD8627/CHG2933)"
^DIC(9.4,85,22,1.5,"PAH",14,1,4,0)="Test Sites: Tennessee Valley HCS"
^DIC(9.4,85,22,1.5,"PAH",14,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",14,1,6,0)="Duplicate transaction numbers in file VAQ - TRANSACTION (#394.61) continue"
^DIC(9.4,85,22,1.5,"PAH",14,1,7,0)="to be a problem.  The pre-init for this patch deletes the triggers on the"
^DIC(9.4,85,22,1.5,"PAH",14,1,8,0)="TRANSACTION NUMBER (#.01) field in file VAQ - TRANSACTION (#394.61) and"
^DIC(9.4,85,22,1.5,"PAH",14,1,9,0)="DATA (#.01) field in file VAQ - DATA (#394.62).  These triggers are"
^DIC(9.4,85,22,1.5,"PAH",14,1,10,0)="unnecessary and are probably the cause of the problems.  After the patch"
^DIC(9.4,85,22,1.5,"PAH",14,1,11,0)="is installed, duplicate transaction numbers should no longer be created."
^DIC(9.4,85,22,1.5,"PAH",14,1,12,0)="Feel free to delete the pre-init, ^VAQPRE39, after installation."
^DIC(9.4,85,22,1.5,"PAH",14,1,13,0)=""
^DIC(9.4,85,22,1.5,"PAH",14,1,14,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",14,1,15,0)="is at a minimum.  It has no patch prerequisite."
