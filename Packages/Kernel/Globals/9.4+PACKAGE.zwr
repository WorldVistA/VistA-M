^DIC(9.4,47,22,5.9,"PAH",862,0)="1084 SEQ #949^3230201.160618^89"
^DIC(9.4,47,22,5.9,"PAH",862,1,0)="^^8^8^3230201"
^DIC(9.4,47,22,5.9,"PAH",862,1,1,0)="Patch DG*5.3*1084 addresses 2 issues"
^DIC(9.4,47,22,5.9,"PAH",862,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",862,1,3,0)="1. A reported issue where the potential for a blank error to be posted in"
^DIC(9.4,47,22,5.9,"PAH",862,1,4,0)="the error trap exists."
^DIC(9.4,47,22,5.9,"PAH",862,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",862,1,6,0)="2. The removal of the Agent Orange Registration # from the DG LOAD PATIENT"
^DIC(9.4,47,22,5.9,"PAH",862,1,7,0)="DATA option screen 6 (MILITARY SERVICE DATA SCREEN) > Environmental"
^DIC(9.4,47,22,5.9,"PAH",862,1,8,0)="Factors screen, with the approval from the business owners."
