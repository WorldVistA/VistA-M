^DIC(9.4,111,22,1,"PAH",44,0)="50 SEQ #45^2980616^1"
^DIC(9.4,111,22,1,"PAH",44,1,0)="^^4^4^2980616"
^DIC(9.4,111,22,1,"PAH",44,1,1,0)="PCE patch 50, PX*1.0*50, clinical reminders. This patch allows information"
^DIC(9.4,111,22,1,"PAH",44,1,2,0)="about deceased patients to be displayed in the Clinical Maintenance and"
