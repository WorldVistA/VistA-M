^DIC(9.4,14,22,5.9,"PAH",129,1,61,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",129,1,62,0)="   LRCKF            11756610       4420888        **272,293**"
^DIC(9.4,14,22,5.9,"PAH",129,1,63,0)="   LRCKF60          36215686       11681052       **272,293**"
^DIC(9.4,14,22,5.9,"PAH",129,1,64,0)="   LRCKF62          5812635        1728069        **272,293**"
