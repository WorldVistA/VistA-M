^DIC(9.4,48,22,5.28,"PAH",583,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,48,22,5.28,"PAH",584,0)="775 SEQ #641^3210812.142514^17"
^DIC(9.4,48,22,5.28,"PAH",584,1,0)="^^7^7^3210812"
^DIC(9.4,48,22,5.28,"PAH",584,1,1,0)="Patch SD*5.3*775 corrects the following Issues:"
^DIC(9.4,48,22,5.28,"PAH",584,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",584,1,3,0)="1. A large number of Overbooks for a single slot will cause"
^DIC(9.4,48,22,5.28,"PAH",584,1,4,0)="   the clinic grid to not display in VistA."
^DIC(9.4,48,22,5.28,"PAH",584,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",584,1,6,0)="2. Variable Length Appointments are showing up incorrectly in "
^DIC(9.4,48,22,5.28,"PAH",584,1,7,0)="   the VistA Scheduling Graphical User Interface (GUI)."
^DIC(9.4,48,22,5.28,"PAH",585,0)="782b^3210813"
^DIC(9.4,48,22,5.28,"PAH",585,1,0)="^^5^5^3210813"
^DIC(9.4,48,22,5.28,"PAH",585,1,1,0)="Backup of SD*5.3*782 on Aug 13, 2021"
^DIC(9.4,48,22,5.28,"PAH",585,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",585,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,48,22,5.28,"PAH",585,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,48,22,5.28,"PAH",585,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,48,22,5.28,"PAH",586,0)="782 SEQ #642^3210813.09574^17"
^DIC(9.4,48,22,5.28,"PAH",586,1,0)="^^3^3^3210813"
^DIC(9.4,48,22,5.28,"PAH",586,1,1,0)="Scheduling patch SD*5.3*782 modifies the screen for the SDAM MENU"
^DIC(9.4,48,22,5.28,"PAH",586,1,2,0)="Protocol and corrects an error which occurs when an appointment is"
^DIC(9.4,48,22,5.28,"PAH",586,1,3,0)="canceled via Telehealth which creates an Incomplete Encounter Error."
^DIC(9.4,48,22,5.28,"PAH",587,0)="790b^3210816"
^DIC(9.4,48,22,5.28,"PAH",587,1,0)="^^5^5^3210816"
^DIC(9.4,48,22,5.28,"PAH",587,1,1,0)="Backup of SD*5.3*790 on Aug 16, 2021"
^DIC(9.4,48,22,5.28,"PAH",587,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",587,1,3,0)="Warning:  Installing this backup patch message will install older versions"
