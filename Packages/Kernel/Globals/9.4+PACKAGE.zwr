^DIC(9.4,60,22,13,"PAH",250,1,164,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",250,1,165,0)="6.  CPRS active (update CPRS/HDR)                                  5,400"
^DIC(9.4,60,22,13,"PAH",250,1,166,0)="7.  Exp>366 days,reset date,CPRS order# (update CPRS/HDR)              0"
^DIC(9.4,60,22,13,"PAH",250,1,167,0)="8.  Exp>366 days,reset date,no CPRS order# (update HDR)               18"
^DIC(9.4,60,22,13,"PAH",250,1,168,0)=" "
^DIC(9.4,60,22,13,"PAH",250,1,169,0)="Group 3: RX'S PAST EXPIRATION DATE BUT STILL ACTIVE"
