^DIC(9.4,207,22,2,"PAH",4,1,89,0)="Blood Bank Team Coordination:"
^DIC(9.4,207,22,2,"PAH",4,1,90,0)="-----------------------------"
^DIC(9.4,207,22,2,"PAH",4,1,91,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch VBEC*2*8 contains "
^DIC(9.4,207,22,2,"PAH",4,1,92,0)="changes to a package referenced in VHA OI SEPG SOP 192-023 Review of "
^DIC(9.4,207,22,2,"PAH",4,1,93,0)="VISTA Patches for Effects on VISTA Blood Bank Software. This patch does "
^DIC(9.4,207,22,2,"PAH",4,1,94,0)="not alter or modify any VistA Blood Bank software design safeguards or "
^DIC(9.4,207,22,2,"PAH",4,1,95,0)="safety critical elements functions."
^DIC(9.4,207,22,2,"PAH",4,1,96,0)=" "
^DIC(9.4,207,22,2,"PAH",4,1,97,0)="RISK ANALYSIS: Changes made by patch VBEC*2*8 have no effect on VistA "
^DIC(9.4,207,22,2,"PAH",4,1,98,0)="Blood Bank software functionality, therefore RISK is none."
^DIC(9.4,207,22,2,"PAH",4,1,99,0)=" "
^DIC(9.4,207,22,2,"PAH",4,1,100,0)="New Service Requests (NSRs):"
^DIC(9.4,207,22,2,"PAH",4,1,101,0)="----------------------------"
^DIC(9.4,207,22,2,"PAH",4,1,102,0)="20170604: CPRS Blood Bank Report "
^DIC(9.4,207,22,2,"PAH",4,1,103,0)=" "
^DIC(9.4,207,22,2,"PAH",4,1,104,0)="Work Items:"
^DIC(9.4,207,22,2,"PAH",4,1,105,0)="-----------"
^DIC(9.4,207,22,2,"PAH",4,1,106,0)="214353   CPRS CQ# 19382: Need to update the VAIS and DBIA 4623"
^DIC(9.4,207,22,2,"PAH",4,1,107,0)="434646   VistA - Fixing canned comments on tests sent to VistA"
^DIC(9.4,207,22,2,"PAH",4,1,108,0)="822792   NSR 20170604: CPRS Blood Bank Report"
^DIC(9.4,207,22,2,"PAH",4,1,109,0)="906324   Transmit the ABO/Rh of Transfused Units to CPRS for Display in"
^DIC(9.4,207,22,2,"PAH",4,1,110,0)="         the CPRS Blood Bank Report"
^DIC(9.4,207,22,2,"PAH",4,1,111,0)="939717   Update VBECS VistA MailMan server to report VBECS VistA version"
^DIC(9.4,207,22,2,"PAH",4,1,112,0)="         2 patches"
^DIC(9.4,207,22,2,"PAH",4,1,113,0)="970431   Replace Expiration Date with Issued Date/Time on the CPRS Blood"
^DIC(9.4,207,22,2,"PAH",4,1,114,0)="         Bank Report in the Available/Issued Units section"
^DIC(9.4,207,22,2,"PAH",4,1,115,0)="1093252  Remove reaction strengths for DAT tests from CPRS blood bank"
^DIC(9.4,207,22,2,"PAH",4,1,116,0)="         report."
^DIC(9.4,207,22,2,"PAH",4,1,117,0)="1186563  CPRS Blood Bank Report does not differentiate tests completed"
^DIC(9.4,207,22,2,"PAH",4,1,118,0)="         on the same date/time"
^DIC(9.4,207,22,2,"PAH",4,1,119,0)=" "
^DIC(9.4,207,22,2,"PAH",4,1,120,0)="1230175  Add reference range for ABS and DAT to CPRS Blood Bank Report"
^DIC(9.4,207,22,2,"PAH",4,1,121,0)="1247284  Cancelled orders remain in Component Requests section CRPS"
^DIC(9.4,207,22,2,"PAH",4,1,122,0)="         Blood Bank Report"
^DIC(9.4,207,22,2,"PAH",4,1,123,0)=" "
