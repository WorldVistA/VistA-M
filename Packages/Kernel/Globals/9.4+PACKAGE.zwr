^DIC(9.4,48,22,5.28,"PAH",596,1,55,0)="SDES CANCEL CLINIC AVAILABLITY: New RPC to Cancel Clinic Availbility "
^DIC(9.4,48,22,5.28,"PAH",596,1,56,0)="Options:"
^DIC(9.4,48,22,5.28,"PAH",596,1,57,0)="SDECRPC"
^DIC(9.4,48,22,5.28,"PAH",596,1,58,0)="SDESRPC"
^DIC(9.4,48,22,5.28,"PAH",597,0)="780 SEQ #653^3220103.124215^17"
^DIC(9.4,48,22,5.28,"PAH",597,1,0)="^^4^4^3220103"
^DIC(9.4,48,22,5.28,"PAH",597,1,1,0)="This patch will send non-clinic days, holidays and blocked clinic hours "
^DIC(9.4,48,22,5.28,"PAH",597,1,2,0)="to TMP via HL-7 messaging. It will send additional station information to "
^DIC(9.4,48,22,5.28,"PAH",597,1,3,0)="assist in locating the correct clinic for sending transactions. It moves "
^DIC(9.4,48,22,5.28,"PAH",597,1,4,0)="the SD TELE TOOLS menu from SDSUP to SDMGR. It adds security key SDTOOL."
^DIC(9.4,48,22,5.28,"PAH",598,0)="793 SEQ #654^3220103.124434^17"
^DIC(9.4,48,22,5.28,"PAH",598,1,0)="^^4^4^3220103"
^DIC(9.4,48,22,5.28,"PAH",598,1,1,0)="Patch SD*5.3*793 will inactivate all Veterans Choice Program (VCP) "
^DIC(9.4,48,22,5.28,"PAH",598,1,2,0)="and Veterans Choice List (VCL) clinics, and any corresponding"
^DIC(9.4,48,22,5.28,"PAH",598,1,3,0)="Wait List clinics. It will also disposition any VCL or VCP Wait"
^DIC(9.4,48,22,5.28,"PAH",598,1,4,0)="List entries."
^DIC(9.4,48,22,5.28,"PAH",599,0)="801 SEQ #655^3220103.124543^17"
^DIC(9.4,48,22,5.28,"PAH",599,1,0)="^^41^41^3220103"
