^DIC(9.4,53,22,20,"PAH",35,1,0)="^^1^1^2970922"
^DIC(9.4,53,22,20,"PAH",35,1,1,0)="This patch addresses several E3Rs."
^DIC(9.4,53,22,20,"PAH",36,0)="76 SEQ #66^2970922^1"
