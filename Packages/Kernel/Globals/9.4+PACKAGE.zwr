^DIC(9.4,49,22,10,"PAH",621,1,1,0)="This patch updates two options that allow for the releasing of copay "
^DIC(9.4,49,22,10,"PAH",621,1,2,0)="charges with a status of On Hold to include a check for duplicate copays."
^DIC(9.4,49,22,10,"PAH",621,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",621,1,4,0)="This same duplicate copay check has also been added to the nightly"
^DIC(9.4,49,22,10,"PAH",621,1,5,0)="background job to perform those same checks for charges that are being"
^DIC(9.4,49,22,10,"PAH",621,1,6,0)="released due to hitting the end of the 90-day window for On Hold charges."
^DIC(9.4,49,22,10,"PAH",622,0)="736 SEQ #685^3230228.130305^89"
^DIC(9.4,49,22,10,"PAH",623,0)="716 SEQ #686^3230228.130458^89"
