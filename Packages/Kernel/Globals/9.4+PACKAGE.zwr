^DIC(9.4,14,22,5.9,"PAH",125,1,347,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,348,0)="SBY-0301-31020"
^DIC(9.4,14,22,5.9,"PAH",125,1,349,0)="TOG-0101-12404"
^DIC(9.4,14,22,5.9,"PAH",125,1,350,0)="MOU-0101-30818"
^DIC(9.4,14,22,5.9,"PAH",125,1,351,0)="DAY-1197-40980"
^DIC(9.4,14,22,5.9,"PAH",125,1,352,0)="ASH-1100-30244"
^DIC(9.4,14,22,5.9,"PAH",125,1,353,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,354,0)="The Interim reports by location (manual queue) [LRRS] option does not       "
^DIC(9.4,14,22,5.9,"PAH",125,1,355,0)="operate properly when ""Selected Locations"" are selected.  No output is      "
^DIC(9.4,14,22,5.9,"PAH",125,1,356,0)="produced.  This problem is fixed."
^DIC(9.4,14,22,5.9,"PAH",125,1,357,0)=" "
