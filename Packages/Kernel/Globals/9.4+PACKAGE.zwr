^DIC(9.4,33,22,1.4,"PAH",24,1,27,0)="   "
^DIC(9.4,33,22,1.4,"PAH",24,1,28,0)=" Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,33,22,1.4,"PAH",24,1,29,0)=" ============   ============    ===========     =========="
^DIC(9.4,33,22,1.4,"PAH",24,1,30,0)=" HLCS            5666872         5781112        **2,9,14,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,31,0)=" HLCS1          10146376        10172566        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,32,0)=" HLCSHDR         6047496         5939243        **37,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,33,0)=" HLCSHDR1        NEW             6658466        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,34,0)=" HLCSIN          2120979         2517664        **2,30,14,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,35,0)=" HLCSLNCH        7065769        11290939        **6,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,36,0)=" HLCSRPT         NEW            14324083        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,37,0)=" HLCSRPT1        NEW             9680356        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,38,0)=" HLCSTCP         NEW             3731985        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,39,0)=" HLCSTCP1        NEW             4613833        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,40,0)=" HLCSTCP2        NEW             7316489        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,41,0)=" HLCSUTL         4322424         5134775        **2,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,42,0)=" HLDTIW2B        5008365         5012027        **14,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,43,0)=" HLDTIWP0        7906384         7922736        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,44,0)=" HLDTIWU3        2154979         2083370        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,45,0)=" HLMA            3791837         3745291        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,46,0)=" HLMA1           4194174         4230657        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,47,0)=" HLMA2           1082489         3410765        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,48,0)=" HLPAT19         NEW              845483        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,49,0)=" HLTF            7445472         7170159        **1,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,50,0)=" HLTF0           4765190         3173064        **12,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,51,0)=" HLTF1           9700889         9479987        **5,8,22,25,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,52,0)=" HLTP3           NEW            12380779        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,53,0)=" HLTP4           NEW             7754632        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,54,0)=" HLTPCK2         NEW             3804314        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,55,0)=" HLTPCK2A        NEW            11350701        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,56,0)=" HLUOPT1         9990663        11568432        **10,13,21,36,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,57,0)=" HLUTIL          4603738         1343106        **36,19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,58,0)=" HLUTIL2         3877956         5547421        **19**"
^DIC(9.4,33,22,1.4,"PAH",24,1,59,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,60,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,61,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,62,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",24,1,63,0)="==========================    "
^DIC(9.4,33,22,1.4,"PAH",24,1,64,0)="  1.  Use the option 'Purge Message Text File Entries' option to remove"
^DIC(9.4,33,22,1.4,"PAH",24,1,65,0)="      old messages. Suggested answers:"
^DIC(9.4,33,22,1.4,"PAH",24,1,66,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,67,0)="    Enter the cutoff date for all messages REGARDLESS OF STATUS:  T-90// T-28"
^DIC(9.4,33,22,1.4,"PAH",24,1,68,0)="    Enter last INCLUSIVE date for status SUCCESSFULLY TRANSMITTED:  T-7// T-2"
^DIC(9.4,33,22,1.4,"PAH",24,1,69,0)="    Purge entries with an ERROR STATUS?  NO// YES"
^DIC(9.4,33,22,1.4,"PAH",24,1,70,0)="    Cutoff date for AWAITING ACKNOWLEDGEMENT status:  T-30// T-7"
^DIC(9.4,33,22,1.4,"PAH",24,1,71,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,72,0)="  2.  Make sure all messages have been transmitted.  Run the option 'Systems"
^DIC(9.4,33,22,1.4,"PAH",24,1,73,0)="      Link Monitor', under the 'Communications Server' menu, and make sure"
^DIC(9.4,33,22,1.4,"PAH",24,1,74,0)="      'messages to send' is equal to 'messages sent' for all Logical Links."
^DIC(9.4,33,22,1.4,"PAH",24,1,75,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,76,0)="  3.  Shutdown all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",24,1,77,0)="      'Shut Down All Logical Links', 'Stop all incoming filers', and 'Stop"
^DIC(9.4,33,22,1.4,"PAH",24,1,78,0)="      all outgoing filers' options."
^DIC(9.4,33,22,1.4,"PAH",24,1,79,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,80,0)="  4.  User are NOT allowed on the system during installation.  Inhibit logins"
^DIC(9.4,33,22,1.4,"PAH",24,1,81,0)="      and place Taskman in a wait state, use the option 'Place Taskman in a"
^DIC(9.4,33,22,1.4,"PAH",24,1,82,0)="      WAIT State'.  Have the submanager shutdown after finishing their current"
^DIC(9.4,33,22,1.4,"PAH",24,1,83,0)="      task."
^DIC(9.4,33,22,1.4,"PAH",24,1,84,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,85,0)="  5.  Some of these routines are new.  Currently we do not recommend that you"
^DIC(9.4,33,22,1.4,"PAH",24,1,86,0)="      add these routines to your map set."
^DIC(9.4,33,22,1.4,"PAH",24,1,87,0)="  "
^DIC(9.4,33,22,1.4,"PAH",24,1,88,0)="  6.  Use the INSTALL/CHECK MESSAGE option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",24,1,89,0)="      option loads the KIDS package into a Transport global onto your"
^DIC(9.4,33,22,1.4,"PAH",24,1,90,0)="      system."
^DIC(9.4,33,22,1.4,"PAH",24,1,91,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,92,0)="  7.  You now need to use KIDS to install the Transport global. From programmer"
^DIC(9.4,33,22,1.4,"PAH",24,1,93,0)="      prompt Do ^XPDKRN."
^DIC(9.4,33,22,1.4,"PAH",24,1,94,0)="  "
^DIC(9.4,33,22,1.4,"PAH",24,1,95,0)="  8.  On the KIDS menu, under the Installation menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",24,1,96,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",24,1,97,0)="  "
^DIC(9.4,33,22,1.4,"PAH",24,1,98,0)="         2 Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",24,1,99,0)="         3 Print Transport Global"
^DIC(9.4,33,22,1.4,"PAH",24,1,100,0)="         4 Compare Transport Global to Current System"
^DIC(9.4,33,22,1.4,"PAH",24,1,101,0)="         5 Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",24,1,102,0)="         6 Install Package(s)"
^DIC(9.4,33,22,1.4,"PAH",24,1,103,0)="             INSTALL NAME: HL*1.6*19"
^DIC(9.4,33,22,1.4,"PAH",24,1,104,0)="                           ========="
^DIC(9.4,33,22,1.4,"PAH",24,1,105,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,106,0)="      The length of the install depends on the size of file 772.  The average"
^DIC(9.4,33,22,1.4,"PAH",24,1,107,0)="      install takes about 15 minutes for 40,000 entries in file 772. "
^DIC(9.4,33,22,1.4,"PAH",24,1,108,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,109,0)="  9.  Allow users back on the system and remove Taskman from wait state,"
^DIC(9.4,33,22,1.4,"PAH",24,1,110,0)="      use the option 'Remove Taskman from WAIT State'."
^DIC(9.4,33,22,1.4,"PAH",24,1,111,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,112,0)=" 10.  Use the 'Edit Communication Server parameters' option to add a Mail"
^DIC(9.4,33,22,1.4,"PAH",24,1,113,0)="      Group to the 'Mail Group for Alerts' field."
^DIC(9.4,33,22,1.4,"PAH",24,1,114,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,115,0)=" 11.  Startup all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",24,1,116,0)="      'Restart All Links and Filers' option."
^DIC(9.4,33,22,1.4,"PAH",24,1,117,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,118,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,119,0)="=============================================================================  "
^DIC(9.4,33,22,1.4,"PAH",24,1,120,0)="Data Dictionary Modifications:"
^DIC(9.4,33,22,1.4,"PAH",24,1,121,0)="============================== "
^DIC(9.4,33,22,1.4,"PAH",24,1,122,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,123,0)=" 869.1  HL LOWER LEVEL PROTOCOL TYPE"
^DIC(9.4,33,22,1.4,"PAH",24,1,124,0)="        No modifications were made to the data dictionary.  One record,"
^DIC(9.4,33,22,1.4,"PAH",24,1,125,0)="        TCP, has been added and will be merged into your current data."
^DIC(9.4,33,22,1.4,"PAH",24,1,126,0)=" "
^DIC(9.4,33,22,1.4,"PAH",24,1,127,0)=" 869.2  HL LOWER LEVEL PROTOCOL PARAMETER"
^DIC(9.4,33,22,1.4,"PAH",24,1,128,0)=" "
^DIC(9.4,33,22,1.4,"PAH",24,1,129,0)="        400.01    TCP/IP ADDRESS (F)  [400;1]"
^DIC(9.4,33,22,1.4,"PAH",24,1,130,0)="        400.02    TCP/IP PORT (NJ5,0)  [400;2]"
^DIC(9.4,33,22,1.4,"PAH",24,1,131,0)="        400.03    TCP/IP SERVICE TYPE (S)  [400;3]"
^DIC(9.4,33,22,1.4,"PAH",24,1,132,0)="        400.04    PERSISTENT (S)  [400;4]"
^DIC(9.4,33,22,1.4,"PAH",24,1,133,0)="        400.06    STARTUP NODE (P14.7)  [400;6]"
^DIC(9.4,33,22,1.4,"PAH",24,1,134,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,135,0)=" 771.6  HL7 MESSAGE STATUS"
^DIC(9.4,33,22,1.4,"PAH",24,1,136,0)="        No modifications were made to the data dictionary.  Several new"
^DIC(9.4,33,22,1.4,"PAH",24,1,137,0)="        statuses have been added and will overwrite your current data."
^DIC(9.4,33,22,1.4,"PAH",24,1,138,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,139,0)=" 771.7  HL7 ERROR MESSAGE"
^DIC(9.4,33,22,1.4,"PAH",24,1,140,0)="        No modifications were made to the data dictionary.  Several new"
^DIC(9.4,33,22,1.4,"PAH",24,1,141,0)="        errors messages have been added and will overwrite your current data."
^DIC(9.4,33,22,1.4,"PAH",24,1,142,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,143,0)=" 772  HL7 MESSAGE TEXT"
^DIC(9.4,33,22,1.4,"PAH",24,1,144,0)="        The .01 field, DATE/TIME ENTERED, has been changed from a pointer to"
^DIC(9.4,33,22,1.4,"PAH",24,1,145,0)="        a date/time field."
^DIC(9.4,33,22,1.4,"PAH",24,1,146,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,147,0)=" 773  HL7 MESSAGE ADMINISTRATION"
^DIC(9.4,33,22,1.4,"PAH",24,1,148,0)="        The .01 field, DATE/TIME ENTERED, has been changed from a date/time to"
^DIC(9.4,33,22,1.4,"PAH",24,1,149,0)="        a pointer to file 772.  Fields have been added to this file for bi-"
^DIC(9.4,33,22,1.4,"PAH",24,1,150,0)="        directional TCP messages."
^DIC(9.4,33,22,1.4,"PAH",24,1,151,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,152,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,153,0)="New Option"
^DIC(9.4,33,22,1.4,"PAH",24,1,154,0)="============================== "
^DIC(9.4,33,22,1.4,"PAH",24,1,155,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,156,0)="'View Transmission Log'     Option name: HL VIEW TRANSMISSION LOG"
^DIC(9.4,33,22,1.4,"PAH",24,1,157,0)="     This option is used to view the Transmission Log; i.e.,"
^DIC(9.4,33,22,1.4,"PAH",24,1,158,0)="     the Message Administration File entries.  It displays those"
^DIC(9.4,33,22,1.4,"PAH",24,1,159,0)="     messages that have been sent or are pending. Display of"
^DIC(9.4,33,22,1.4,"PAH",24,1,160,0)="     messages with HL7 errors or exceptions is not yet supported."
^DIC(9.4,33,22,1.4,"PAH",24,1,161,0)=""
^DIC(9.4,33,22,1.4,"PAH",24,1,162,0)="New Alert"
^DIC(9.4,33,22,1.4,"PAH",24,1,163,0)="=============================="
^DIC(9.4,33,22,1.4,"PAH",24,1,164,0)="If a message exceeds the 'RE-TRANSMISION ATTEMPTS' for a Logical Link, an"
^DIC(9.4,33,22,1.4,"PAH",24,1,165,0)="alert will be generated.  The alert will be sent to the Mail Group defined"
^DIC(9.4,33,22,1.4,"PAH",24,1,166,0)="in the HL COMMUNICATION SERVER PARAMETERS file, 869.3."
^DIC(9.4,33,22,1.4,"PAH",25,0)="43 SEQ #37^2990427^1"
^DIC(9.4,33,22,1.4,"PAH",25,1,0)="^^78^78^2990427"
^DIC(9.4,33,22,1.4,"PAH",25,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,33,22,1.4,"PAH",25,1,2,0)="   "
^DIC(9.4,33,22,1.4,"PAH",25,1,3,0)="1. Support is provided for connecting to the Master Patient Index (MPI)."
^DIC(9.4,33,22,1.4,"PAH",25,1,4,0)="2. FileMan auditing ordinarily depends on DUZ, but when VA FileMan records"
^DIC(9.4,33,22,1.4,"PAH",25,1,5,0)="   are updated by subscriber protocols, DUZ is undefined, disabling"
^DIC(9.4,33,22,1.4,"PAH",25,1,6,0)="   audting. Changes in this patch combined with changes that will be "
^DIC(9.4,33,22,1.4,"PAH",25,1,7,0)="   released VA FileMan V22.0 allow auditing based on subscriber protocol,"
^DIC(9.4,33,22,1.4,"PAH",25,1,8,0)="   rather than DUZ."
^DIC(9.4,33,22,1.4,"PAH",25,1,9,0)="3. Autostart of a Logical Link now uses the AUTOSTART NODE field in the"
^DIC(9.4,33,22,1.4,"PAH",25,1,10,0)="   HL LOWER LEVEL PROTOCOL PARAMETER file."
^DIC(9.4,33,22,1.4,"PAH",25,1,11,0)="4. The API GENERATE^HLMA would return the parameter HLRESLT, when passed"
^DIC(9.4,33,22,1.4,"PAH",25,1,12,0)="   by reference, equal to the message id.  But, multiple messages could"
^DIC(9.4,33,22,1.4,"PAH",25,1,13,0)="   have been generated.  This patch will now also return the array "
^DIC(9.4,33,22,1.4,"PAH",25,1,14,0)="   HLRESLT, where HLRESLT(1)=2nd message id."
^DIC(9.4,33,22,1.4,"PAH",25,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,16,0)="Routine Modifications:"
^DIC(9.4,33,22,1.4,"PAH",25,1,17,0)="======================"
^DIC(9.4,33,22,1.4,"PAH",25,1,18,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,33,22,1.4,"PAH",25,1,19,0)="these routines now look like:"
^DIC(9.4,33,22,1.4,"PAH",25,1,20,0)="  "
^DIC(9.4,33,22,1.4,"PAH",25,1,21,0)=" ;;1.6;HEALTH LEVEL SEVEN;<patchlist>;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",25,1,22,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,23,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,33,22,1.4,"PAH",25,1,24,0)="   "
^DIC(9.4,33,22,1.4,"PAH",25,1,25,0)=" Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,33,22,1.4,"PAH",25,1,26,0)=" ============   ============    ===========     =========="
^DIC(9.4,33,22,1.4,"PAH",25,1,27,0)=" HLCS            5781112         5743323        2,9,14,19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,28,0)=" HLCS2           4802116         7195833        14,40,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,29,0)=" HLCSAC          NEW             2497076        43"
^DIC(9.4,33,22,1.4,"PAH",25,1,30,0)=" HLCSAS          NEW             2943880        43"
^DIC(9.4,33,22,1.4,"PAH",25,1,31,0)=" HLCSAS1         NEW             1742491        43"
^DIC(9.4,33,22,1.4,"PAH",25,1,32,0)=" HLCSLNCH       11290939        11368535        6,19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,33,0)=" HLCSTCP         3731985         4005742        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,34,0)=" HLCSTCP1        4613833         4899040        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,35,0)=" HLCSTCP2        7316489         7436704        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,36,0)=" HLMA            3745291         5502295        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,37,0)=" HLMA1           4230657         3849338        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,38,0)=" HLMA2           3410765         7300625        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,39,0)=" HLTF            7170159         7284127        1,19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,40,0)=" HLTP            5532648         4283999        14,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,41,0)=" HLTP3          12380779        12440103        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,42,0)=" HLUTIL2         5547421         5380198        19,43"
^DIC(9.4,33,22,1.4,"PAH",25,1,43,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,44,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,45,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",25,1,46,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",25,1,47,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",25,1,48,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,49,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",25,1,50,0)="      the Routine Summary section are mapped, they should be removed from"
^DIC(9.4,33,22,1.4,"PAH",25,1,51,0)="      the mapped set at this time."
^DIC(9.4,33,22,1.4,"PAH",25,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,53,0)="  3.  Shutdown all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",25,1,54,0)="      'Shut Down All Logical Links', 'Stop all incoming filers', and 'Stop"
^DIC(9.4,33,22,1.4,"PAH",25,1,55,0)="      all outgoing filers' options."
^DIC(9.4,33,22,1.4,"PAH",25,1,56,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,57,0)="  4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",25,1,58,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",25,1,59,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,60,0)="  5.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",25,1,61,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",25,1,62,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",25,1,63,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",25,1,64,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,65,0)="         2 Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",25,1,66,0)="         3 Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",25,1,67,0)="         4 Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",25,1,68,0)="         5 Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",25,1,69,0)="         6 Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",25,1,70,0)="             INSTALL NAME: HL*1.6*43"
^DIC(9.4,33,22,1.4,"PAH",25,1,71,0)="                           ========="
^DIC(9.4,33,22,1.4,"PAH",25,1,72,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",25,1,73,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",25,1,74,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,75,0)="  6.  Startup all Logical Links and incoming and outgoing filers. Use the"
^DIC(9.4,33,22,1.4,"PAH",25,1,76,0)="      'Restart All Links and Filers' option."
^DIC(9.4,33,22,1.4,"PAH",25,1,77,0)=" "
^DIC(9.4,33,22,1.4,"PAH",25,1,78,0)="  7.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",26,0)="51 SEQ #39^2990510^1"
^DIC(9.4,33,22,1.4,"PAH",26,1,0)="^^75^75^2990510"
^DIC(9.4,33,22,1.4,"PAH",26,1,1,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,2,0)="The CIRN developers was the first to discover and report a problem with"
^DIC(9.4,33,22,1.4,"PAH",26,1,3,0)="the function $$FMNAME^HLFNC(X,HLECDE). Additional details of their"
^DIC(9.4,33,22,1.4,"PAH",26,1,4,0)="findings are recorded in NOIS: BAY-0499-31160."
^DIC(9.4,33,22,1.4,"PAH",26,1,5,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,6,0)=" If the variable X is used as the first parameter of this function"
^DIC(9.4,33,22,1.4,"PAH",26,1,7,0)=" and has a value of DOE~JOHN~""""~SR"
^DIC(9.4,33,22,1.4,"PAH",26,1,8,0)="  "
^DIC(9.4,33,22,1.4,"PAH",26,1,9,0)=" this function when invoked (e.g.:  S Y=$$FMNAME^HLFNC(X,""~"")         )"
^DIC(9.4,33,22,1.4,"PAH",26,1,10,0)=" would return the following value:  DOE,JOHNSR"
^DIC(9.4,33,22,1.4,"PAH",26,1,11,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,12,0)=" This occurred because this function specifically checked from the second"
^DIC(9.4,33,22,1.4,"PAH",26,1,13,0)=" component to the last whether the next component contained two"
^DIC(9.4,33,22,1.4,"PAH",26,1,14,0)=" double quotes (e.g.: """") or had no value.  When this condition was"
^DIC(9.4,33,22,1.4,"PAH",26,1,15,0)=" encountered, this function did not place a space between each"
^DIC(9.4,33,22,1.4,"PAH",26,1,16,0)=" component and the component immediately following starting from the"
^DIC(9.4,33,22,1.4,"PAH",26,1,17,0)=" second."
^DIC(9.4,33,22,1.4,"PAH",26,1,18,0)="  "
^DIC(9.4,33,22,1.4,"PAH",26,1,19,0)=" After this patch is installed, the return value will now be DOE,JOHN SR"
^DIC(9.4,33,22,1.4,"PAH",26,1,20,0)=" for the above example."
^DIC(9.4,33,22,1.4,"PAH",26,1,21,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,22,0)=" The following code may be used in programmer mode to test this function:"
^DIC(9.4,33,22,1.4,"PAH",26,1,23,0)=" NOTE:  The '>' character is the mumps programmer prompt."
^DIC(9.4,33,22,1.4,"PAH",26,1,24,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,25,0)=" >R X"
^DIC(9.4,33,22,1.4,"PAH",26,1,26,0)=" DOE~JOHN~""""~SR         <---Enter this data on the READ command."
^DIC(9.4,33,22,1.4,"PAH",26,1,27,0)=" >W $$FMNAME^HLFNC(X,""~"")"
^DIC(9.4,33,22,1.4,"PAH",26,1,28,0)=" DOE,JOHN SR            <---This should be the the result after this patch"
^DIC(9.4,33,22,1.4,"PAH",26,1,29,0)="                           is installed."
^DIC(9.4,33,22,1.4,"PAH",26,1,30,0)=" You may also try the following:"
^DIC(9.4,33,22,1.4,"PAH",26,1,31,0)=" >W $$FMNAME^HLFNC(""DOE~JOHN~~SR"",""~"")"
^DIC(9.4,33,22,1.4,"PAH",26,1,32,0)=" DOE,JOHN SR"
^DIC(9.4,33,22,1.4,"PAH",26,1,33,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,34,0)="Before this patch is installed, you should have installed patch HL*1.6*42."
^DIC(9.4,33,22,1.4,"PAH",26,1,35,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,36,0)="Routine Summary: "
^DIC(9.4,33,22,1.4,"PAH",26,1,37,0)="================"
^DIC(9.4,33,22,1.4,"PAH",26,1,38,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",26,1,39,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",26,1,40,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,41,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995 "
