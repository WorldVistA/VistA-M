^DIC(9.4,163,22,1,"PAH",195,1,0)="^^2^2^3060807"
^DIC(9.4,163,22,1,"PAH",195,1,1,0)="The description of this patch may be found in the national patch module "
^DIC(9.4,163,22,1,"PAH",195,1,2,0)="under patch TIU*1.0*218."
^DIC(9.4,163,22,1,"PAH",196,0)="204 SEQ #200^3060807^1"
^DIC(9.4,163,22,1,"PAH",196,1,0)="^^3^3^3060807"
^DIC(9.4,163,22,1,"PAH",196,1,1,0)="UNDEFINED ERROR IN TIUPUTS WHEN THERE IS NO DATE/TIME OUT OF OR.  TIU "
^DIC(9.4,163,22,1,"PAH",196,1,2,0)="VITALS OBJECTS (WEIGHT, HEIGHT AND TEMP) NOT WORKING PROPERLY WHEN "
^DIC(9.4,163,22,1,"PAH",196,1,3,0)="RESULTS ARE REFUSED, UNAVAILABLE OR PASS."
^DIC(9.4,163,22,1,"PAH",197,0)="208 SEQ #201^3060807^1"
^DIC(9.4,163,22,1,"PAH",197,1,0)="^^3^3^3060807"
^DIC(9.4,163,22,1,"PAH",197,1,1,0)="Fix display of a long Author's name in the TIU BROWSE menu options and "
^DIC(9.4,163,22,1,"PAH",197,1,2,0)="fix the duplicate display of notes in the TIU SEARCH BY PATIENT/TITLE "
^DIC(9.4,163,22,1,"PAH",197,1,3,0)="option."
