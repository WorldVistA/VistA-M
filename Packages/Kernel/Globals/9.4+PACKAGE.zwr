^DIC(9.4,14,22,5.9,"PAH",214,0)="398 SEQ #313^3091001.162016^17"
^DIC(9.4,14,22,5.9,"PAH",214,1,0)="^^3^3^3091001"
^DIC(9.4,14,22,5.9,"PAH",214,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",214,1,2,0)="This patch will modify routine LRPHLIST (collection label print)"
^DIC(9.4,14,22,5.9,"PAH",214,1,3,0)="to allow the print job to be queued to a printer through TASKMAN."
^DIC(9.4,14,22,5.9,"PAH",215,0)="395 SEQ #314^3091102.170846^17"
^DIC(9.4,14,22,5.9,"PAH",215,1,0)="^^8^8^3091102"
^DIC(9.4,14,22,5.9,"PAH",215,1,1,0)="This patch is a VM general purpose lab patch that addresses 3 issues."
^DIC(9.4,14,22,5.9,"PAH",215,1,2,0)="It corrects a problem with the inability to enter antibiotic "
^DIC(9.4,14,22,5.9,"PAH",215,1,3,0)="concentrations,"
^DIC(9.4,14,22,5.9,"PAH",215,1,4,0)="addresses a problem in file #64.1 (Workload Data) whereby incorrect data"
^DIC(9.4,14,22,5.9,"PAH",215,1,5,0)="gets stored in the file when the order date is different from the "
^DIC(9.4,14,22,5.9,"PAH",215,1,6,0)="collection"
^DIC(9.4,14,22,5.9,"PAH",215,1,7,0)="date, and also addresses a problem whereby the draw time designator of"
^DIC(9.4,14,22,5.9,"PAH",215,1,8,0)="RANDOM is not displayed on the patient report."
^DIC(9.4,14,22,5.9,"PAH",216,0)="397 SEQ #315^3100105.165924^17"
^DIC(9.4,14,22,5.9,"PAH",216,1,0)="^^9^9^3100105"
^DIC(9.4,14,22,5.9,"PAH",216,1,1,0)="This patch is a VM general purpose lab patch that addresses 3 issues."
^DIC(9.4,14,22,5.9,"PAH",216,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",216,1,3,0)="   1.  Turnaround time report for AP yields incorrect calculation of days"
^DIC(9.4,14,22,5.9,"PAH",216,1,4,0)="        sometimes when holiday occurs mid-week."
^DIC(9.4,14,22,5.9,"PAH",216,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",216,1,6,0)="   2.  Alerts are being sent for patients from REFERRAL file (#67)."
^DIC(9.4,14,22,5.9,"PAH",216,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",216,1,8,0)="   3.  Modifying released pathology reports leads to incorrectly"
^DIC(9.4,14,22,5.9,"PAH",216,1,9,0)="        stored data."
^DIC(9.4,14,22,5.9,"PAH",217,0)="396 SEQ #316^3100105.170012^17"
^DIC(9.4,14,22,5.9,"PAH",217,1,0)="^^8^8^3100105"
^DIC(9.4,14,22,5.9,"PAH",217,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",217,1,2,0)="This patch is a VM general purpose lab patch that addresses 3 issues."
^DIC(9.4,14,22,5.9,"PAH",217,1,3,0)="It corrects a problem with the inability to enter antibiotic "
^DIC(9.4,14,22,5.9,"PAH",217,1,4,0)="concentrations,"
^DIC(9.4,14,22,5.9,"PAH",217,1,5,0)="addresses a problem with the WorkLoad Report whereby data from yearly"
^DIC(9.4,14,22,5.9,"PAH",217,1,6,0)="accession areas is not picked up,  and modifies a comment that is"
^DIC(9.4,14,22,5.9,"PAH",217,1,7,0)="automatically generated when a test is cancelled after a result has been"
^DIC(9.4,14,22,5.9,"PAH",217,1,8,0)="entered."
^DIC(9.4,14,22,5.9,"PAH",218,0)="399 SEQ #317^3100708.114952^17"
^DIC(9.4,14,22,5.9,"PAH",218,1,0)="^^11^11^3100708"
^DIC(9.4,14,22,5.9,"PAH",218,1,1,0)="This patch is a VM general purpose lab patch that addresses 2 issues."
^DIC(9.4,14,22,5.9,"PAH",218,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",218,1,3,0)="   1.  The DSS Laboratory Extract gets a <SYNTAX> error when FileMan"
^DIC(9.4,14,22,5.9,"PAH",218,1,4,0)="       attempts to set an entry into the LAB DSS LAR EXTRACT FILE"
^DIC(9.4,14,22,5.9,"PAH",218,1,5,0)="       (# 64.036) when the entry has a text test result containing"
^DIC(9.4,14,22,5.9,"PAH",218,1,6,0)="       a semi-colon (;)."
^DIC(9.4,14,22,5.9,"PAH",218,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",218,1,8,0)="   2.  A <SUBSCRIPT> error occurs when a user enters an ""^"" at the"
^DIC(9.4,14,22,5.9,"PAH",218,1,9,0)="       RESULT NLT CODE prompt in option LR LOINC UNMAP/DELETE DEFAULT."
^DIC(9.4,14,22,5.9,"PAH",218,1,10,0)="       The error also occurs when there is no RESULT NLT CODE on file"
^DIC(9.4,14,22,5.9,"PAH",218,1,11,0)="       and the user <returns> through this prompt."
^DIC(9.4,14,22,5.9,"PAH",219,0)="402 SEQ #318^3101020.1232^17"
^DIC(9.4,14,22,5.9,"PAH",219,1,0)="^^8^8^3101020"
^DIC(9.4,14,22,5.9,"PAH",219,1,1,0)="This patch is a VM general purpose lab patch that addresses 2 issues."
^DIC(9.4,14,22,5.9,"PAH",219,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",219,1,3,0)="   1.  The option MODIFY AN EXISTING DATA NAME allows for the modification"
^DIC(9.4,14,22,5.9,"PAH",219,1,4,0)="       of the input parameters for data elements that are not DATA NAMEs,"
^DIC(9.4,14,22,5.9,"PAH",219,1,5,0)="       leading to, in some cases, a corrupted database."
^DIC(9.4,14,22,5.9,"PAH",219,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",219,1,7,0)="   2.  The option LRENTER (Enter/verify/modify data (manual)) sometimes"
^DIC(9.4,14,22,5.9,"PAH",219,1,8,0)="       prompts the user to select an accession area twice."
^DIC(9.4,14,22,5.9,"PAH",220,0)="403 SEQ #319^3101214.14263^17"
^DIC(9.4,14,22,5.9,"PAH",221,0)="401^3110309.151329^17"
^DIC(9.4,14,22,5.9,"PAH",221,1,0)="^^2^2^3110309"
^DIC(9.4,14,22,5.9,"PAH",221,1,1,0)="This patch contains changes to the VBECS Blood Bank package. Refer to the "
^DIC(9.4,14,22,5.9,"PAH",221,1,2,0)="patch listed in the Forum patch module for more details."
^DIC(9.4,14,22,5.9,"PAH",222,0)="407 SEQ #321^3110509.161849^17"
^DIC(9.4,14,22,5.9,"PAH",222,1,0)="^^11^11^3110509"
^DIC(9.4,14,22,5.9,"PAH",222,1,1,0)="This patch is a VM lab patch that addresses 2 LOINC mapping issues."
^DIC(9.4,14,22,5.9,"PAH",222,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",222,1,3,0)="   1.  When exiting the option ""Map Lab Tests to LOINC Codes"" after no"
^DIC(9.4,14,22,5.9,"PAH",222,1,4,0)="       matches are found related to an affirmative response to the"
^DIC(9.4,14,22,5.9,"PAH",222,1,5,0)="       prompt ""Do you want to see possible LOINC code matches?"", an"
^DIC(9.4,14,22,5.9,"PAH",222,1,6,0)="       <UNDEFINED> error results."
^DIC(9.4,14,22,5.9,"PAH",222,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",222,1,8,0)="   2.  The option to map a default LOINC code and the option to unmap a"
^DIC(9.4,14,22,5.9,"PAH",222,1,9,0)="       default LOINC code use the same routines.  Sometimes the code gets"
^DIC(9.4,14,22,5.9,"PAH",222,1,10,0)="       confused and prompts one to ""unmap"" when one is in the ""map"" "
^DIC(9.4,14,22,5.9,"PAH",222,1,11,0)="       option."
^DIC(9.4,14,22,5.9,"PAH",223,0)="406 SEQ #322^3110511.102436^17"
^DIC(9.4,14,22,5.9,"PAH",223,1,0)="^^6^6^3110511"
^DIC(9.4,14,22,5.9,"PAH",223,1,1,0)="This patch addresses Patient Safety Issue PSPO #1384 which involves"
^DIC(9.4,14,22,5.9,"PAH",223,1,2,0)="critical lab test result alerts.  When a lab test result is verified"
^DIC(9.4,14,22,5.9,"PAH",223,1,3,0)="and that result lies outside the normal boundaries defined for the"
^DIC(9.4,14,22,5.9,"PAH",223,1,4,0)="test, alerts are generated that are sent to the physicians who are"
^DIC(9.4,14,22,5.9,"PAH",223,1,5,0)="responsible for the patient's care.  In some cases these alerts are"
^DIC(9.4,14,22,5.9,"PAH",223,1,6,0)="not being generated."
^DIC(9.4,14,22,5.9,"PAH",224,0)="408 SEQ #323^3110718.145312^17"
^DIC(9.4,14,22,5.9,"PAH",225,0)="410 SEQ #324^3111027.104715^17"
^DIC(9.4,14,22,5.9,"PAH",225,1,0)="^^17^17^3111027"
^DIC(9.4,14,22,5.9,"PAH",225,1,1,0)="This patch is a VM lab patch that addresses a minor DD change, a change"
^DIC(9.4,14,22,5.9,"PAH",225,1,2,0)="to 2 menu options, and a modification to the DSS extract for LAB."
^DIC(9.4,14,22,5.9,"PAH",225,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",225,1,4,0)="   1.  The DELETE cross-reference code for field #10 (Cancelled By) of"
^DIC(9.4,14,22,5.9,"PAH",225,1,5,0)="       the TEST multiple of the SPECIMEN subfile (#69.03) of the LAB"
^DIC(9.4,14,22,5.9,"PAH",225,1,6,0)="       ORDERS file (#69) has faulty syntax which leads to a <SUBSCRIPT>"
^DIC(9.4,14,22,5.9,"PAH",225,1,7,0)="       error when a deletion of an entry in the CANCELLED BY field"
^DIC(9.4,14,22,5.9,"PAH",225,1,8,0)="       occurs."
^DIC(9.4,14,22,5.9,"PAH",225,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",225,1,10,0)="   2.  The option descriptions for option LR WKLD REQUEST and option LR"
^DIC(9.4,14,22,5.9,"PAH",225,1,11,0)="       WKLD SERVICE are reversed."
^DIC(9.4,14,22,5.9,"PAH",225,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",225,1,13,0)="   3.  During extraction of lab data for the Decision Support Software"
^DIC(9.4,14,22,5.9,"PAH",225,1,14,0)="       (DSS) it was discovered that some lab test names included a tilde"
^DIC(9.4,14,22,5.9,"PAH",225,1,15,0)="       character (~) or an exclamation point (!) which caused the record"
^DIC(9.4,14,22,5.9,"PAH",225,1,16,0)="       parser to incorrectly identify the end of the record and thus"
^DIC(9.4,14,22,5.9,"PAH",225,1,17,0)="       skip pertinent data."
^DIC(9.4,14,22,5.9,"PAH",226,0)="405 SEQ #325^3120109.115334^17"
^DIC(9.4,14,22,5.9,"PAH",226,1,0)="^^283^283^3120109"
^DIC(9.4,14,22,5.9,"PAH",226,1,1,0)="BLOOD BANK STATEMENT"
^DIC(9.4,14,22,5.9,"PAH",226,1,2,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",226,1,3,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*405 does not"
^DIC(9.4,14,22,5.9,"PAH",226,1,4,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,14,22,5.9,"PAH",226,1,5,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",226,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,7,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*405 does not"
^DIC(9.4,14,22,5.9,"PAH",226,1,8,0)="alter or modify any software design safeguards or safety critical"
^DIC(9.4,14,22,5.9,"PAH",226,1,9,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",226,1,10,0)="BLOOD BANK STATEMENT"
^DIC(9.4,14,22,5.9,"PAH",226,1,11,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",226,1,12,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*405 does not "
^DIC(9.4,14,22,5.9,"PAH",226,1,13,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",226,1,14,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",226,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,16,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*405 does not "
^DIC(9.4,14,22,5.9,"PAH",226,1,17,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",226,1,18,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",226,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,20,0)="RISK ANALYSIS: Changes made by patch LR*5.2*405 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",226,1,21,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",226,1,22,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,23,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",226,1,24,0)="made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",226,1,25,0)="installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",226,1,26,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,27,0)="Howdy Computerized Phlebotomy Login Process (Howdy) is an automated "
^DIC(9.4,14,22,5.9,"PAH",226,1,28,0)="laboratory check-in application used in Veterans Health Information "
^DIC(9.4,14,22,5.9,"PAH",226,1,29,0)="Systems and Technology Architecture (VistA) Laboratory system to "
^DIC(9.4,14,22,5.9,"PAH",226,1,30,0)="provide phlebotomy labs with the ability to:"
^DIC(9.4,14,22,5.9,"PAH",226,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,32,0)="1. Read the Veteran Information Card (VIC) and instruct the patient "
^DIC(9.4,14,22,5.9,"PAH",226,1,33,0)="   to wait until called to the phlebotomy area."
^DIC(9.4,14,22,5.9,"PAH",226,1,34,0)="2. Search the VistA database for any phlebotomy orders pending on"
^DIC(9.4,14,22,5.9,"PAH",226,1,35,0)="   the patient."
^DIC(9.4,14,22,5.9,"PAH",226,1,36,0)="3. Process lab orders and print specimen labels."
^DIC(9.4,14,22,5.9,"PAH",226,1,37,0)="4. Verify that the correct lab specimens are drawn from the correct "
^DIC(9.4,14,22,5.9,"PAH",226,1,38,0)="   patient."
^DIC(9.4,14,22,5.9,"PAH",226,1,39,0)="5. Calculate and provide timeliness reports for Phlebotomy Lab "
^DIC(9.4,14,22,5.9,"PAH",226,1,40,0)="   performance."
^DIC(9.4,14,22,5.9,"PAH",226,1,41,0)="6. Provide barcode technology for patient identification and "
^DIC(9.4,14,22,5.9,"PAH",226,1,42,0)="   positive specimen identification."
^DIC(9.4,14,22,5.9,"PAH",226,1,43,0)="7. Capture accurate collection and lab receipt times that allows the "
^DIC(9.4,14,22,5.9,"PAH",226,1,44,0)="   laboratory users to track outpatient lab samples from collection to "
^DIC(9.4,14,22,5.9,"PAH",226,1,45,0)="   verification."
^DIC(9.4,14,22,5.9,"PAH",226,1,46,0)="8. Assist in accomplishing the VA strategic plan, which specifies "
^DIC(9.4,14,22,5.9,"PAH",226,1,47,0)="   that 90% of laboratory specimens will be collected utilizing barcode "
^DIC(9.4,14,22,5.9,"PAH",226,1,48,0)="   technology."
^DIC(9.4,14,22,5.9,"PAH",226,1,49,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,50,0)="The Howdy bar code technology allows the lab personnel to use scanners to "
^DIC(9.4,14,22,5.9,"PAH",226,1,51,0)="verify a veteran's identity and to track drawn sample(s) until the "
^DIC(9.4,14,22,5.9,"PAH",226,1,52,0)="results are entered into the VistA Laboratory system."
^DIC(9.4,14,22,5.9,"PAH",226,1,53,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,54,0)="Howdy addresses privacy issues. The scanning of the VIC feature eliminates"
^DIC(9.4,14,22,5.9,"PAH",226,1,55,0)="a hand-written log book for sign in, where the patient's name and SSN can"
^DIC(9.4,14,22,5.9,"PAH",226,1,56,0)="be viewed."
^DIC(9.4,14,22,5.9,"PAH",226,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,58,0)="This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,14,22,5.9,"PAH",226,1,59,0)="==================================================="
^DIC(9.4,14,22,5.9,"PAH",226,1,60,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",226,1,61,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,62,0)="This patch addresses the following Electronic Error & Enhancement Report "
^DIC(9.4,14,22,5.9,"PAH",226,1,63,0)="(E3R):"
^DIC(9.4,14,22,5.9,"PAH",226,1,64,0)="========================================================================"
