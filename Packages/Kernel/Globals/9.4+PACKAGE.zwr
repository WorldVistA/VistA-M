^DIC(9.4,28,22,6,"PAH",1,1,87,0)="  Installation Instruction:"
^DIC(9.4,28,22,6,"PAH",1,1,88,0)="  ========================"
^DIC(9.4,28,22,6,"PAH",1,1,89,0)="  1.  This patch can be loaded with users on the system."
^DIC(9.4,28,22,6,"PAH",1,1,90,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,91,0)="  2.  When prompted ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,28,22,6,"PAH",1,1,92,0)="  Protocols? YES//"" respond NO."
^DIC(9.4,28,22,6,"PAH",1,1,93,0)="                            ==="
^DIC(9.4,28,22,6,"PAH",1,1,94,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,95,0)="  3.  Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,28,22,6,"PAH",1,1,96,0)="  will load the KIDS package into your system."
^DIC(9.4,28,22,6,"PAH",1,1,97,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,98,0)="  4.  The patch has now been loaded into a transport global and you will"
^DIC(9.4,28,22,6,"PAH",1,1,99,0)="  use KIDS to install the transport global.  On the KIDS menu, under the"
^DIC(9.4,28,22,6,"PAH",1,1,100,0)="  'Installation' menu, use the following options"
^DIC(9.4,28,22,6,"PAH",1,1,101,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,102,0)="        Load a Distribution"
^DIC(9.4,28,22,6,"PAH",1,1,103,0)="        Print Transport Global"
^DIC(9.4,28,22,6,"PAH",1,1,104,0)="        Compare Transpsort global to Current System"
^DIC(9.4,28,22,6,"PAH",1,1,105,0)="        Verify Checksums in Transport Global"
^DIC(9.4,28,22,6,"PAH",1,1,106,0)="        Install Package(s)"
^DIC(9.4,28,22,6,"PAH",1,1,107,0)=" "
^DIC(9.4,28,22,6,"PAH",1,1,108,0)="            INSTALL NAME:  GEC*2.0*17"
^DIC(9.4,28,22,6,"PAH",1,1,109,0)="                           =========="
^DIC(9.4,28,22,6,"PAH",1,1,110,0)="            (Optional) At the prompt: 'Want to DISABLE Scheduled"
^DIC(9.4,28,22,6,"PAH",1,1,111,0)="                                  Options and Menu Options?' enter NO."
^DIC(9.4,28,22,6,"PAH",1,1,112,0)="                                                                   =="
^DIC(9.4,28,22,6,"PAH",2,0)="20 SEQ #17^2990223^1"
^DIC(9.4,28,22,6,"PAH",2,1,0)="^^72^72^2990223"
^DIC(9.4,28,22,6,"PAH",2,1,1,0)="1. BOI-0199-52715."
^DIC(9.4,28,22,6,"PAH",2,1,2,0)="   When creating batches via Generic Code Sheet, batches are"
^DIC(9.4,28,22,6,"PAH",2,1,3,0)="   generated with a space:"
^DIC(9.4,28,22,6,"PAH",2,1,4,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,5,0)="   089 FEN.531.994.10.0119 99.FB9059.015MXXXXXX.$"
^DIC(9.4,28,22,6,"PAH",2,1,6,0)="                          ^"
^DIC(9.4,28,22,6,"PAH",2,1,7,0)="                          |"
^DIC(9.4,28,22,6,"PAH",2,1,8,0)="                          |____ Inappropriate space."
^DIC(9.4,28,22,6,"PAH",2,1,9,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,10,0)="   Routine GECSTRAN have been revised to correct this problem:"
^DIC(9.4,28,22,6,"PAH",2,1,11,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,12,0)="       FEN.662.994.10.012899.XXXXXX.$"
^DIC(9.4,28,22,6,"PAH",2,1,13,0)="                          ^"
^DIC(9.4,28,22,6,"PAH",2,1,14,0)="                          |"
^DIC(9.4,28,22,6,"PAH",2,1,15,0)="                          |____ Problem corrected no space."
^DIC(9.4,28,22,6,"PAH",2,1,16,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,17,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,18,0)="Test Sites:"
^DIC(9.4,28,22,6,"PAH",2,1,19,0)="=========="
^DIC(9.4,28,22,6,"PAH",2,1,20,0)="Boise, ID - 531"
^DIC(9.4,28,22,6,"PAH",2,1,21,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,22,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,23,0)="Routine Summary:"
^DIC(9.4,28,22,6,"PAH",2,1,24,0)="==============="
^DIC(9.4,28,22,6,"PAH",2,1,25,0)="The following routine(s) are included in this patch.  The second line of"
^DIC(9.4,28,22,6,"PAH",2,1,26,0)="each routine will look like:"
^DIC(9.4,28,22,6,"PAH",2,1,27,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,28,0)="            <tab>;;2.0;GCS;**[Patch List}**;Mar 14, 1995"
^DIC(9.4,28,22,6,"PAH",2,1,29,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,30,0)="Checksums:  CHECK^XTSUMBLD"
^DIC(9.4,28,22,6,"PAH",2,1,31,0)="========="
^DIC(9.4,28,22,6,"PAH",2,1,32,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,33,0)="Rtn Nm          Chksum Before          Chksum         Patch List"
^DIC(9.4,28,22,6,"PAH",2,1,34,0)="------------------------------------------------------------------"
^DIC(9.4,28,22,6,"PAH",2,1,35,0)="GECSTRAN               9702778         9698310         13,15,20"
^DIC(9.4,28,22,6,"PAH",2,1,36,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,37,0)="Installation Instruction:"
^DIC(9.4,28,22,6,"PAH",2,1,38,0)="========================"
^DIC(9.4,28,22,6,"PAH",2,1,39,0)="1. This patch can be loaded with users on the system."
^DIC(9.4,28,22,6,"PAH",2,1,40,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,41,0)="2. When prompted ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,28,22,6,"PAH",2,1,42,0)="Protocols?  YES//""  respond NO."
^DIC(9.4,28,22,6,"PAH",2,1,43,0)="                            =="
^DIC(9.4,28,22,6,"PAH",2,1,44,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,45,0)="3. Routine mapping is NOT recommended for these routines.  If you are"
^DIC(9.4,28,22,6,"PAH",2,1,46,0)="using routine mapping, review your mapped set and ensure that these"
^DIC(9.4,28,22,6,"PAH",2,1,47,0)="routines are NOT in your mapped routine before proceeding and rebuild"
^DIC(9.4,28,22,6,"PAH",2,1,48,0)="your map set afterward before reactivating TaskMan."
^DIC(9.4,28,22,6,"PAH",2,1,49,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,50,0)="4. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,28,22,6,"PAH",2,1,51,0)="will load the KIDS package into your system."
^DIC(9.4,28,22,6,"PAH",2,1,52,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,53,0)="5. The patch has now been loaded into a transport global and you will"
^DIC(9.4,28,22,6,"PAH",2,1,54,0)="use KIDS to install the transport global.  On the KIDS menu, under the"
^DIC(9.4,28,22,6,"PAH",2,1,55,0)="'Installation' menu, use the following options"
^DIC(9.4,28,22,6,"PAH",2,1,56,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,57,0)="2 Verify Checksums in Transport Global"
^DIC(9.4,28,22,6,"PAH",2,1,58,0)="3 Print Transport Global"
^DIC(9.4,28,22,6,"PAH",2,1,59,0)="4 Compare Transport Global to Current System"
^DIC(9.4,28,22,6,"PAH",2,1,60,0)="5 Backup a Transport Global"
^DIC(9.4,28,22,6,"PAH",2,1,61,0)="6 Install Package(s)"
^DIC(9.4,28,22,6,"PAH",2,1,62,0)="             INSTALL NAME:  GEC*2.0*20"
^DIC(9.4,28,22,6,"PAH",2,1,63,0)="                            =========="
^DIC(9.4,28,22,6,"PAH",2,1,64,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,65,0)="             (Optional) At the prompt: 'Want to DISABLE Scheduled"
^DIC(9.4,28,22,6,"PAH",2,1,66,0)="                             Options and Menu Options?' enter NO."
^DIC(9.4,28,22,6,"PAH",2,1,67,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,68,0)="6. MSM-DOS Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,28,22,6,"PAH",2,1,69,0)="other CPU's?'.  Enter the names of your Computer and Print server(s)."
^DIC(9.4,28,22,6,"PAH",2,1,70,0)=" "
^DIC(9.4,28,22,6,"PAH",2,1,71,0)="7. If routines were unmapped as part of step 2, they should be returned"
^DIC(9.4,28,22,6,"PAH",2,1,72,0)="to the mapped set once the installation has run to completion."
^DIC(9.4,28,22,6,"PAH",3,0)="19 SEQ #18^2991019^1"
^DIC(9.4,28,22,6,"PAH",3,1,0)="^^126^126^2991019"
^DIC(9.4,28,22,6,"PAH",3,1,1,0)="1. REN-0698-61170."
^DIC(9.4,28,22,6,"PAH",3,1,2,0)="   When using the 'Mark Batch for Retransmission' option,"
^DIC(9.4,28,22,6,"PAH",3,1,3,0)="   [GECS RETRANSMIT], only batches for the primary division"
^DIC(9.4,28,22,6,"PAH",3,1,4,0)="   are listed and selectable when trying to retrieve primary"
^DIC(9.4,28,22,6,"PAH",3,1,5,0)="   division with a suffix.  Routine GECSMUT2 has been revised."
^DIC(9.4,28,22,6,"PAH",3,1,6,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,7,0)="2. MOU-1095-31993, COA-1096-21575, CHY-1196-50499, DAN-1096-41015,"
^DIC(9.4,28,22,6,"PAH",3,1,8,0)="   HUN-1096-21584, LEA-1096-41007, MAR-1196-21134, SHR-1196-71105,"
^DIC(9.4,28,22,6,"PAH",3,1,9,0)="   SHR-1096-71255, WIM-0797-21425, LAK-1297-30984, PUG-0397-51302,"
^DIC(9.4,28,22,6,"PAH",3,1,10,0)="   WAS-0398-21559, PUG-0398-51984, BHH-0598-40274, NCH-0898-41263,"
^DIC(9.4,28,22,6,"PAH",3,1,11,0)="   GAI-0898-31096, BED-0297-11503."
^DIC(9.4,28,22,6,"PAH",3,1,12,0)="   Transactions created when prior year service orders are updated"
^DIC(9.4,28,22,6,"PAH",3,1,13,0)="   on IFCAP are being rejected by FMS.  Currently these transactions"
^DIC(9.4,28,22,6,"PAH",3,1,14,0)="   are sent in the SO (Service Order Document) format but FMS requires"
^DIC(9.4,28,22,6,"PAH",3,1,15,0)="   updates for accrued documents to be in the AR (Accrual Receiver"
^DIC(9.4,28,22,6,"PAH",3,1,16,0)="   Document) format.  Various routines have been revised to accept"
^DIC(9.4,28,22,6,"PAH",3,1,17,0)="   AR type transactions.  A new routine GECSAR has been created to"
^DIC(9.4,28,22,6,"PAH",3,1,18,0)="   add 'AR:FMS' entry into file #2101.2, the routine will prompt for"
^DIC(9.4,28,22,6,"PAH",3,1,19,0)="   the following entry:"
^DIC(9.4,28,22,6,"PAH",3,1,20,0)="   -----------------------------------------------------------------"
^DIC(9.4,28,22,6,"PAH",3,1,21,0)="   D ^GECSAR"
^DIC(9.4,28,22,6,"PAH",3,1,22,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,23,0)="   Step (1)"
^DIC(9.4,28,22,6,"PAH",3,1,24,0)="   ========"
^DIC(9.4,28,22,6,"PAH",3,1,25,0)="   Enter 'FINANCIAL MANAGEMENT' for Batch Type!"
^DIC(9.4,28,22,6,"PAH",3,1,26,0)="   BATCH TYPE: //   <-------  User Response"
^DIC(9.4,28,22,6,"PAH",3,1,27,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,28,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,29,0)="   Step (2)"
^DIC(9.4,28,22,6,"PAH",3,1,30,0)="   ========"
^DIC(9.4,28,22,6,"PAH",3,1,31,0)="   The following data has been added to file #2101.2"
^DIC(9.4,28,22,6,"PAH",3,1,32,0)="   AR:FMS"
^DIC(9.4,28,22,6,"PAH",3,1,33,0)="   FINANCIAL MANAGEMENT"
^DIC(9.4,28,22,6,"PAH",3,1,34,0)="   Y"
^DIC(9.4,28,22,6,"PAH",3,1,35,0)="   FMS ACCRUAL RECEIVER DOCUMENT"
^DIC(9.4,28,22,6,"PAH",3,1,36,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,37,0)="   Enter RETURN to continue or '^' to exit:"
^DIC(9.4,28,22,6,"PAH",3,1,38,0)="   "
^DIC(9.4,28,22,6,"PAH",3,1,39,0)="   <NOTE TO USER: When the above routine ^GECSAR has completed its update,"
^DIC(9.4,28,22,6,"PAH",3,1,40,0)="         please delete.> "
^DIC(9.4,28,22,6,"PAH",3,1,41,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,42,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,43,0)="   With the acceptance of AR type transactions, a new 'STATUS' to indicate"
^DIC(9.4,28,22,6,"PAH",3,1,44,0)="   'Final - No Further Activity Allowed' transaction was accepted by FMS"
^DIC(9.4,28,22,6,"PAH",3,1,45,0)="   and no edits, rebuild, or retransmission may occur for any SO/AR"
^DIC(9.4,28,22,6,"PAH",3,1,46,0)="   with a Status of 'F'.  This change has taken place in Data Dictionary"
^DIC(9.4,28,22,6,"PAH",3,1,47,0)="   file #2100.1 and field #3.  The set-of-codes for field #3 of file"
^DIC(9.4,28,22,6,"PAH",3,1,48,0)="   #2100.1 has been revised as follows:"
^DIC(9.4,28,22,6,"PAH",3,1,49,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,50,0)="   Q: queued for transmission"
^DIC(9.4,28,22,6,"PAH",3,1,51,0)="   M: marked for immediate transmission"
^DIC(9.4,28,22,6,"PAH",3,1,52,0)="   T: transmitted to Austin"
^DIC(9.4,28,22,6,"PAH",3,1,53,0)="   E: error in transmission"
^DIC(9.4,28,22,6,"PAH",3,1,54,0)="   A: accepted by FMS"
^DIC(9.4,28,22,6,"PAH",3,1,55,0)="   R: rejected by FMS"
^DIC(9.4,28,22,6,"PAH",3,1,56,0)="   F: final - no further activity allowed   <------  New Entry"
^DIC(9.4,28,22,6,"PAH",3,1,57,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,58,0)="   Data Dictionay      Name of File"
^DIC(9.4,28,22,6,"PAH",3,1,59,0)="   -------------------------------------------------"
^DIC(9.4,28,22,6,"PAH",3,1,60,0)="   ^GECS(2100.1,       GENERIC CODE SHEET STACK FILE "
^DIC(9.4,28,22,6,"PAH",3,1,61,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,62,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,63,0)=" "
^DIC(9.4,28,22,6,"PAH",3,1,64,0)=" "
