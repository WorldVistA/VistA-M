^DIC(9.4,59,22,5,"PAH",177,1,6,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",177,1,7,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",177,1,8,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",177,1,9,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",177,1,10,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",177,1,11,0)="   50.627        WARNING LABEL MAP     "
