^DIC(9.4,73,22,9,"PAH",22,1,6,0)="At some prompts, there are no time-outs.  At other prompts, time-outs may"
^DIC(9.4,73,22,9,"PAH",22,1,7,0)="result in infinite prompt loops.  This patch fixes that."
^DIC(9.4,73,22,9,"PAH",22,1,8,0)=""
^DIC(9.4,73,22,9,"PAH",22,1,9,0)="This patch also deletes obsolete routines:"
^DIC(9.4,73,22,9,"PAH",22,1,10,0)="AFJXADD1, AFJXPNHF, AFJXPNHI, AFJXREW, AFJXWCBP, AFJXWCPB, AFJXWCPD, AFJXWCPY"
^DIC(9.4,73,22,9,"PAH",22,1,11,0)=""
^DIC(9.4,73,22,9,"PAH",22,1,12,0)="This patch also changes the check for a printer from IOST[""C-"" to"
^DIC(9.4,73,22,9,"PAH",22,1,13,0)="$E(IOST,1,2)=""C-""."
^DIC(9.4,73,22,9,"PAH",22,1,14,0)=""
^DIC(9.4,73,22,9,"PAH",22,1,15,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",22,1,16,0)="is at a minimum.  It requires patch AFJX*5.1*33."
^DIC(9.4,73,22,9,"PAH",22,1,17,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",22,1,18,0)=" "
^DIC(9.4,73,22,9,"PAH",22,1,19,0)="ROUTINES:"
^DIC(9.4,73,22,9,"PAH",22,1,20,0)="The second line of the routine now looks like:"
^DIC(9.4,73,22,9,"PAH",22,1,21,0)="       ;;5.1;Network Health Exchange;**[patch list]**;Jan 23, 1996"
