^DIC(9.4,77,22,17,"PAH",245,1,102,0)="PSJ LM CLINIC ORDER "
^DIC(9.4,77,22,17,"PAH",245,1,103,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,104,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,105,0)="Additional Information:"
^DIC(9.4,77,22,17,"PAH",245,1,106,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,107,0)=" Patient Safety Issues (PSIs)"
^DIC(9.4,77,22,17,"PAH",245,1,108,0)=" -----------------------------"
^DIC(9.4,77,22,17,"PAH",245,1,109,0)="  2359 - Provider comments intended for a specific order are copied on"
^DIC(9.4,77,22,17,"PAH",245,1,110,0)="         another order upon renewal."
^DIC(9.4,77,22,17,"PAH",245,1,111,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,112,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,113,0)=" Remedy Ticket(s) & Overview"
^DIC(9.4,77,22,17,"PAH",245,1,114,0)=" ---------------------------"
^DIC(9.4,77,22,17,"PAH",245,1,115,0)="  HD 764596/781899 - Other Print Info display incorrectly."
^DIC(9.4,77,22,17,"PAH",245,1,116,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,117,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",245,1,118,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,119,0)="   When two or more Pending IV renews or Non-Verified edited IV orders"
^DIC(9.4,77,22,17,"PAH",245,1,120,0)="   containing Other Print Info are selected in Inpatient Order Entry using"
^DIC(9.4,77,22,17,"PAH",245,1,121,0)="   a dash, 1-3 to view orders 1, 2, and 3, the orders following the first"
^DIC(9.4,77,22,17,"PAH",245,1,122,0)="   order mistakenly display the first order's Other Print Info. "
^DIC(9.4,77,22,17,"PAH",245,1,123,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,124,0)="   Solution"
^DIC(9.4,77,22,17,"PAH",245,1,125,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,126,0)="   When selecting multiple Pending Renewed IV orders or multiple"
^DIC(9.4,77,22,17,"PAH",245,1,127,0)="   Non-Verified edited IV orders by using a dash in Inpatient Order Entry,"
^DIC(9.4,77,22,17,"PAH",245,1,128,0)="   initialize contents of Other Print Info between orders so the Other"
^DIC(9.4,77,22,17,"PAH",245,1,129,0)="   Print Info is displayed with the proper order."
^DIC(9.4,77,22,17,"PAH",245,1,130,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,131,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,132,0)="  HD 760186 - Other Print Info from IV Quick Code not used."
^DIC(9.4,77,22,17,"PAH",245,1,133,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,134,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",245,1,135,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,136,0)="   Other Print Info copied in from Provider Comments not being overwritten"
^DIC(9.4,77,22,17,"PAH",245,1,137,0)="   by Other Print info in a selected IV Quick Code."
^DIC(9.4,77,22,17,"PAH",245,1,138,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,139,0)="   Solution"
^DIC(9.4,77,22,17,"PAH",245,1,140,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,141,0)="   Restore previous functionality. When an order that can be finished as "
^DIC(9.4,77,22,17,"PAH",245,1,142,0)="   Unit Dose or IV is finished as an IV, and the user is prompted for  "
^DIC(9.4,77,22,17,"PAH",245,1,143,0)="   Additive, if the finishing pharmacist enters an IV Quick Code that "
^DIC(9.4,77,22,17,"PAH",245,1,144,0)="   contains Other Print Info text, that text should overwrite the contents"
^DIC(9.4,77,22,17,"PAH",245,1,145,0)="   of the order's Other Print Info."
^DIC(9.4,77,22,17,"PAH",245,1,146,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,147,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,148,0)="  HD 763244 - Undefined error in 7 Day Mar."
^DIC(9.4,77,22,17,"PAH",245,1,149,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,150,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",245,1,151,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,152,0)="   Undefined error occurs when printing a PRN IV order in the 7Day MAR"
^DIC(9.4,77,22,17,"PAH",245,1,153,0)="   [PSJU 7D MAR] option."
^DIC(9.4,77,22,17,"PAH",245,1,154,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,155,0)="   Solution"
^DIC(9.4,77,22,17,"PAH",245,1,156,0)="   ---------"
^DIC(9.4,77,22,17,"PAH",245,1,157,0)="   Prevent undefined error from occurring."
^DIC(9.4,77,22,17,"PAH",245,1,158,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,159,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,160,0)="  HD 756354 - Undefined error in CPRS IV label print."
^DIC(9.4,77,22,17,"PAH",245,1,161,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,162,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",245,1,163,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,164,0)="   Undefined error occurs when printing an IV Label from the Chart Copy"
^DIC(9.4,77,22,17,"PAH",245,1,165,0)="   dialog after signing an order in CPRS."
^DIC(9.4,77,22,17,"PAH",245,1,166,0)="          "
^DIC(9.4,77,22,17,"PAH",245,1,167,0)="   Solution: Prevent undefined error from occurring."
^DIC(9.4,77,22,17,"PAH",245,1,168,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,169,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,170,0)="  HD 763555 - Wrong intervention recommendation is filed."
^DIC(9.4,77,22,17,"PAH",245,1,171,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,172,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",245,1,173,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,174,0)="   NO ALLERGY ASSESSMENT type of intervention does not file correct"
^DIC(9.4,77,22,17,"PAH",245,1,175,0)="   recommendation when custom entries are present in the APSP INTERVENTION"
^DIC(9.4,77,22,17,"PAH",245,1,176,0)="   RECOMMENDATION (#9009032.5) file."
^DIC(9.4,77,22,17,"PAH",245,1,177,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,178,0)="   Solution"
^DIC(9.4,77,22,17,"PAH",245,1,179,0)="   ---------"
^DIC(9.4,77,22,17,"PAH",245,1,180,0)="   Enable the NO ALLERGY ASSESSMENT type of interventions to handle custom"
^DIC(9.4,77,22,17,"PAH",245,1,181,0)="   entries in the APSP INTERVENTION RECOMMENDATION (#9009032.5) file."
^DIC(9.4,77,22,17,"PAH",245,1,182,0)="          "
^DIC(9.4,77,22,17,"PAH",245,1,183,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,184,0)="  HD 770025 - Long Special Instructions not retained after CPRS Renew"
^DIC(9.4,77,22,17,"PAH",245,1,185,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,186,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",245,1,187,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,188,0)="   Long Special Instructions (greater than 180 characters) and Other Print"
^DIC(9.4,77,22,17,"PAH",245,1,189,0)="   Info (greater than 60 characters) are not carried over to the Pending "
^DIC(9.4,77,22,17,"PAH",245,1,190,0)="   renewal order after the order is renewed in CPRS."
^DIC(9.4,77,22,17,"PAH",245,1,191,0)="  "
^DIC(9.4,77,22,17,"PAH",245,1,192,0)="   Solution"
^DIC(9.4,77,22,17,"PAH",245,1,193,0)="   --------"
^DIC(9.4,77,22,17,"PAH",245,1,194,0)="   Retain long Special Instructions (greater than 180 characters) and"
^DIC(9.4,77,22,17,"PAH",245,1,195,0)="   Other Print Info (greater than 60 characters) in the Pending renewal"
^DIC(9.4,77,22,17,"PAH",245,1,196,0)="   order when the order is renewed from CPRS."
^DIC(9.4,77,22,17,"PAH",246,0)="295 SEQ #247^3130618.112959^17"
^DIC(9.4,77,22,17,"PAH",247,0)="286 SEQ #248^3130710.161543^17"
^DIC(9.4,77,22,17,"PAH",247,1,0)="^^6^6^3130710"
^DIC(9.4,77,22,17,"PAH",247,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",247,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",247,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",247,1,4,0)="-Order Check performed on incorrect drug"
^DIC(9.4,77,22,17,"PAH",247,1,5,0)="-Auto-discontinued Unit Dose orders in Inpatient Order Entry [PSJ OE] "
^DIC(9.4,77,22,17,"PAH",247,1,6,0)=" can be copied for outpatients."
^DIC(9.4,77,22,17,"PAH",248,0)="272 SEQ #249^3130731.120909^17"
^DIC(9.4,77,22,17,"PAH",248,1,0)="^^6^6^3130731"
^DIC(9.4,77,22,17,"PAH",248,1,1,0)="The purpose of this patch is to provide software bug fixes for Inpatient "
^DIC(9.4,77,22,17,"PAH",248,1,2,0)="Medications.  This patch corrects the following issues:"
^DIC(9.4,77,22,17,"PAH",248,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",248,1,4,0)="-Dose Limit problem for Day-of-the-Week schedules"
^DIC(9.4,77,22,17,"PAH",248,1,5,0)="-Undefined error in IV order entry"
^DIC(9.4,77,22,17,"PAH",248,1,6,0)="-Incorrect Dose Due time printing on IV label"
^DIC(9.4,77,22,17,"PAH",249,0)="292 SEQ #250^3130827.165943^17"
^DIC(9.4,77,22,17,"PAH",249,1,0)="^^81^81^3130827"
^DIC(9.4,77,22,17,"PAH",249,1,1,0)="Patch PSJ*5*275 introduced an issue with the Inpatient Profile that "
^DIC(9.4,77,22,17,"PAH",249,1,2,0)="caused very old, corrupted Unit Dose orders display on the Inpatient"
^DIC(9.4,77,22,17,"PAH",249,1,3,0)="Profile. This patch corrects the problem."
^DIC(9.4,77,22,17,"PAH",249,1,4,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,5,0)="Prior to PSJ*5*275, the Inpatient Profile attempted to display only Unit "
^DIC(9.4,77,22,17,"PAH",249,1,6,0)="Dose orders with a stop date later than the patient's last admission "
^DIC(9.4,77,22,17,"PAH",249,1,7,0)="date. Orders within this same period were checked for auto-expiration; if "
^DIC(9.4,77,22,17,"PAH",249,1,8,0)="the order's stop date was in the past, the status was changed to expired. "
^DIC(9.4,77,22,17,"PAH",249,1,9,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,10,0)="Orders with stop dates earlier than the last admission date were ignored "
^DIC(9.4,77,22,17,"PAH",249,1,11,0)="by the profile; their statuses were not updated, and they were not "
^DIC(9.4,77,22,17,"PAH",249,1,12,0)="displayed."
^DIC(9.4,77,22,17,"PAH",249,1,13,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,14,0)="Patch PSJ*5*275 attempted to make the inpatient profile consistent by"
^DIC(9.4,77,22,17,"PAH",249,1,15,0)="honoringing the HOURS OF RECENTLY DC/EXPIRED (#7) field in the INPATIENT"
^DIC(9.4,77,22,17,"PAH",249,1,16,0)="WARD PARAMETERS (#59.6) file so that no order would display if its stop"
^DIC(9.4,77,22,17,"PAH",249,1,17,0)="date was older than the value defined by this parameter. However, the "
^DIC(9.4,77,22,17,"PAH",249,1,18,0)="patch incorrectly retrieved the parameter's nominal 'hours' value "
^DIC(9.4,77,22,17,"PAH",249,1,19,0)="instead of its calculated 'date' value (derived by subtracting the hours "
^DIC(9.4,77,22,17,"PAH",249,1,20,0)="from the current date/time), so that regardless of the value of the"
^DIC(9.4,77,22,17,"PAH",249,1,21,0)="parameter, virtually no orders were ignored when displaying the profile."
^DIC(9.4,77,22,17,"PAH",249,1,22,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,23,0)="Finally, while patch PSJ*5*275 changed how far into the past the profile "
^DIC(9.4,77,22,17,"PAH",249,1,24,0)="began searching for orders' stop date, the process that auto-expired "
^DIC(9.4,77,22,17,"PAH",249,1,25,0)="orders from the inpatient profile did not change, allowing corrupted "
^DIC(9.4,77,22,17,"PAH",249,1,26,0)="orders with stop dates in the past, and statuses of active or renewed, "
^DIC(9.4,77,22,17,"PAH",249,1,27,0)="to display in the patient's Inpatient medication profile without "
^DIC(9.4,77,22,17,"PAH",249,1,28,0)="performing a corresponding auto-expire on these orders."
^DIC(9.4,77,22,17,"PAH",249,1,29,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,30,0)="This patch corrects the issue by changing how the inpatient profile "
^DIC(9.4,77,22,17,"PAH",249,1,31,0)="begins to look for orders with stop dates in the past to the calculated "
^DIC(9.4,77,22,17,"PAH",249,1,32,0)="value of the HOURS OF RECENTLY DC/EXPIRED (#7) field in the INPATIENT "
^DIC(9.4,77,22,17,"PAH",249,1,33,0)="WARD PARAMETERS (#59.6) file subtracted from the current date/time."
^DIC(9.4,77,22,17,"PAH",249,1,34,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,35,0)="For Example, given two active orders with stop dates in the past, and an"
^DIC(9.4,77,22,17,"PAH",249,1,36,0)="             admission date, and a HOURS RECENTLY DC/EXPIRED value, the "
^DIC(9.4,77,22,17,"PAH",249,1,37,0)="             following functionality would be observed prior to PSJ*5*275,"
^DIC(9.4,77,22,17,"PAH",249,1,38,0)="             with PSJ*5*275, and after PSJ*5*275:"
^DIC(9.4,77,22,17,"PAH",249,1,39,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,40,0)="           Current Date/Time : 06/06/2013@1300 "
^DIC(9.4,77,22,17,"PAH",249,1,41,0)="         Last Admission Date : 06/04/2013@1300"
^DIC(9.4,77,22,17,"PAH",249,1,42,0)="HOURS OF RECENTLY DC/EXPIRED : 120"
^DIC(9.4,77,22,17,"PAH",249,1,43,0)="                     Order 1 : Stop Date 01/01/2001@2400, Status=ACTIVE"
^DIC(9.4,77,22,17,"PAH",249,1,44,0)="                     Order 2 : Stop Date 06/03/2013@2400, Status=EXPIRED"
^DIC(9.4,77,22,17,"PAH",249,1,45,0)="                     Order 3 : Stop Date 06/05/2013@1200, Status=ACTIVE"
^DIC(9.4,77,22,17,"PAH",249,1,46,0)="           "
^DIC(9.4,77,22,17,"PAH",249,1,47,0)="                     "
^DIC(9.4,77,22,17,"PAH",249,1,48,0)="Prior to PSJ*5*275 :  (Order 1 is ignored and remains active)"
^DIC(9.4,77,22,17,"PAH",249,1,49,0)="                      (Order 2 is ignored and remains expired)"
^DIC(9.4,77,22,17,"PAH",249,1,50,0)="--------------------------------------------------------------------------"
^DIC(9.4,77,22,17,"PAH",249,1,51,0)="Inpatient Order Entry    Jun 06, 2013@13:00:00     Page:  1 of  1"
^DIC(9.4,77,22,17,"PAH",249,1,52,0)="- - - - - - - RECENTLY DISCONTINUED/EXPIRED (LAST 120 HOURS) - - - - - -"
^DIC(9.4,77,22,17,"PAH",249,1,53,0)="- "
^DIC(9.4,77,22,17,"PAH",249,1,54,0)="   1    Order 3                        C  06/04  06/05 E"
^DIC(9.4,77,22,17,"PAH",249,1,55,0)="          Give:  PO Q4H       "
^DIC(9.4,77,22,17,"PAH",249,1,56,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,57,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,58,0)="With PSJ*5*275  (Orders 1 and 2 are displayed and remain active)"
^DIC(9.4,77,22,17,"PAH",249,1,59,0)="--------------------------------------------------------------------------"
^DIC(9.4,77,22,17,"PAH",249,1,60,0)="Inpatient Order Entry    Jun 06, 2013@13:00:00     Page:  1 of  1"
^DIC(9.4,77,22,17,"PAH",249,1,61,0)="- - - - - - - - - - - - - - - A C T I V E - - - - - - - - - - - - - - - "
^DIC(9.4,77,22,17,"PAH",249,1,62,0)="   1    Order 1                        C  12/30  01/01 A"
^DIC(9.4,77,22,17,"PAH",249,1,63,0)="          Give: 10MG PO TID   "
^DIC(9.4,77,22,17,"PAH",249,1,64,0)="   2    Order 2                        C  06/02  06/03 A"
^DIC(9.4,77,22,17,"PAH",249,1,65,0)="          Give: 10MG PO TID "
^DIC(9.4,77,22,17,"PAH",249,1,66,0)=" - - - - - - - - - RECENTLY DISCONTINUED/EXPIRED (LAST 24 HOURS) - - - - "
^DIC(9.4,77,22,17,"PAH",249,1,67,0)="- - - - "
^DIC(9.4,77,22,17,"PAH",249,1,68,0)="   3    Order 3                        C  06/04  06/05 E"
^DIC(9.4,77,22,17,"PAH",249,1,69,0)="          Give:  PO Q4H      "
^DIC(9.4,77,22,17,"PAH",249,1,70,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,71,0)=" "
^DIC(9.4,77,22,17,"PAH",249,1,72,0)="                "
^DIC(9.4,77,22,17,"PAH",249,1,73,0)="With PSJ*5*292  (Order 1 is ignored and remains active)"
^DIC(9.4,77,22,17,"PAH",249,1,74,0)="                (Order 2 is displayed and remains expired)"
^DIC(9.4,77,22,17,"PAH",249,1,75,0)="-------------------------------------------------------------------"
^DIC(9.4,77,22,17,"PAH",249,1,76,0)="Inpatient Order Entry    Jun 06, 2013@13:00:00     Page:  1 of  1"
^DIC(9.4,77,22,17,"PAH",249,1,77,0)="- - - - - - RECENTLY DISCONTINUED/EXPIRED (LAST 24 HOURS) - - - - - - - -"
^DIC(9.4,77,22,17,"PAH",249,1,78,0)="   1    Order 2                        C  06/02  06/03 E"
^DIC(9.4,77,22,17,"PAH",249,1,79,0)="          Give: 10MG PO TID "
^DIC(9.4,77,22,17,"PAH",249,1,80,0)="   2    Order 3                        C  06/04  06/05 E"
^DIC(9.4,77,22,17,"PAH",249,1,81,0)="          Give:  PO Q4H      "
^DIC(9.4,77,22,17,"PAH",250,0)="301 SEQ #251^3131022.144437^17"
^DIC(9.4,77,22,17,"PAH",250,1,0)="^^11^11^3131022"
^DIC(9.4,77,22,17,"PAH",250,1,1,0)="This patch addresses an issue with the ACTION PROFILE #2 [PSJU AP-2] "
^DIC(9.4,77,22,17,"PAH",250,1,2,0)="report introduced by PSJ*5*275."
^DIC(9.4,77,22,17,"PAH",250,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",250,1,4,0)="The change to the ACTION PROFILE #2 [PSJU AP-2] report in patch PSJ*5*275 "
^DIC(9.4,77,22,17,"PAH",250,1,5,0)="caused the report to only print the first patient found, regardless of "
^DIC(9.4,77,22,17,"PAH",250,1,6,0)="how many patients should have printed, when the report was run by Ward or "
^DIC(9.4,77,22,17,"PAH",250,1,7,0)="Ward Group. "
^DIC(9.4,77,22,17,"PAH",250,1,8,0)=" "
^DIC(9.4,77,22,17,"PAH",250,1,9,0)="This patch corrects the report by ensuring all appropriate "
^DIC(9.4,77,22,17,"PAH",250,1,10,0)="patients and their orders print on the report when the report is run by "
^DIC(9.4,77,22,17,"PAH",250,1,11,0)="Ward or Ward Group."
^DIC(9.4,77,22,17,"PAH",251,0)="229 SEQ #252^3131203.152337^17"
^DIC(9.4,77,22,17,"PAH",251,1,0)="^^39^39^3131203"
^DIC(9.4,77,22,17,"PAH",251,1,1,0)=" Patch PSJ*5.0*229 will correct the following issues."
^DIC(9.4,77,22,17,"PAH",251,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",251,1,3,0)=" HD0000000339101 - PSPO# 00001478 - 1 IV order 3x/wk for 8 doses- when "
^DIC(9.4,77,22,17,"PAH",251,1,4,0)="                   stop time is entered as 8, the computer calculates "
^DIC(9.4,77,22,17,"PAH",251,1,5,0)="                   for 8 days not 8 doses"
^DIC(9.4,77,22,17,"PAH",251,1,6,0)=" Problem:"
^DIC(9.4,77,22,17,"PAH",251,1,7,0)=" --------"
^DIC(9.4,77,22,17,"PAH",251,1,8,0)=" Dose limit calculations are not correct when entered from the "
^DIC(9.4,77,22,17,"PAH",251,1,9,0)=" infusion dialog in CPRS. There is no logic to calculculate day of week "
^DIC(9.4,77,22,17,"PAH",251,1,10,0)=" schedules and schedules with a frequency greater than 1440 (dose to be "
^DIC(9.4,77,22,17,"PAH",251,1,11,0)=" given more than once a day) calculate based on days instead of doses."
^DIC(9.4,77,22,17,"PAH",251,1,12,0)=" "
^DIC(9.4,77,22,17,"PAH",251,1,13,0)=" HD0000000282450 - 4 stop date calculated incorrectly?"
^DIC(9.4,77,22,17,"PAH",251,1,14,0)=" Problem:"
^DIC(9.4,77,22,17,"PAH",251,1,15,0)=" --------"
^DIC(9.4,77,22,17,"PAH",251,1,16,0)=" When finishing a dose limit IV Piggyback order created in CPRS, the stop"
^DIC(9.4,77,22,17,"PAH",251,1,17,0)=" date would not adhere to the dose limit. If there was a stop time defined"
^DIC(9.4,77,22,17,"PAH",251,1,18,0)=" for a particular IV ROOM, the stop time would be tacked on, usually "
^DIC(9.4,77,22,17,"PAH",251,1,19,0)=" setting the stop date past the last dose of the order. If there was no"
^DIC(9.4,77,22,17,"PAH",251,1,20,0)=" stop time defined, the system would tack on .2359 to the stop date, which"
^DIC(9.4,77,22,17,"PAH",251,1,21,0)=" would also usually set the stop date past the dose limit. Both of these"
^DIC(9.4,77,22,17,"PAH",251,1,22,0)=" scenarios would cause additional doses to be given."
^DIC(9.4,77,22,17,"PAH",251,1,23,0)=" "
^DIC(9.4,77,22,17,"PAH",251,1,24,0)=" HD0000000347116 - 6 Edited infusion rate to remove 250 ml/hr@0 and "
^DIC(9.4,77,22,17,"PAH",251,1,25,0)="                   scheduled labels still not printing"
^DIC(9.4,77,22,17,"PAH",251,1,26,0)=" Problem:"
^DIC(9.4,77,22,17,"PAH",251,1,27,0)=" --------"
^DIC(9.4,77,22,17,"PAH",251,1,28,0)=" When editing an IV order from an infusion rate with the ATZERO flag set"
^DIC(9.4,77,22,17,"PAH",251,1,29,0)=" to an infusion rate without the ATZERO flag, the labels still don't "
^DIC(9.4,77,22,17,"PAH",251,1,30,0)=" print. The ATZERO flag is not being removed by an opposite edit."
^DIC(9.4,77,22,17,"PAH",251,1,31,0)=" "
^DIC(9.4,77,22,17,"PAH",251,1,32,0)=" HD0000000217087 - IV Time frames in question"
^DIC(9.4,77,22,17,"PAH",251,1,33,0)=" Problem:"
^DIC(9.4,77,22,17,"PAH",251,1,34,0)=" --------"
^DIC(9.4,77,22,17,"PAH",251,1,35,0)=" The duration on IV orders is not calculating correctly. A duration of 23"
^DIC(9.4,77,22,17,"PAH",251,1,36,0)=" hours stops the order after 23 hours, and a duration of 25 hours stops "
^DIC(9.4,77,22,17,"PAH",251,1,37,0)=" the order after 25 hours; however, a duration of 24 hours stops the "
^DIC(9.4,77,22,17,"PAH",251,1,38,0)=" order at t+1 day @ 23:59 (23:59 is set by the inpatient ward parameter as"
^DIC(9.4,77,22,17,"PAH",251,1,39,0)=" a default time)."
^DIC(9.4,77,22,17,"PAH",252,0)="289 SEQ #253^3131203.15235^17"
^DIC(9.4,77,22,17,"PAH",252,1,0)="^^45^45^3131203"
^DIC(9.4,77,22,17,"PAH",252,1,1,0)="This patch will address the Inpatient Medications portion of"
^DIC(9.4,77,22,17,"PAH",252,1,2,0)="the solution to Patient Safety Issue PSPO00001088 and New"
^DIC(9.4,77,22,17,"PAH",252,1,3,0)="Service Request (NSR) 20110308.  This patch must be installed"
^DIC(9.4,77,22,17,"PAH",252,1,4,0)="after patch PSS*1.0*174."
^DIC(9.4,77,22,17,"PAH",252,1,5,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,6,0)="Patch PSS*1.0*174 introduced a new field into the"
^DIC(9.4,77,22,17,"PAH",252,1,7,0)="IV ADDITIVES File (#52.6).  The new field, STRENGTH (#19)"
^DIC(9.4,77,22,17,"PAH",252,1,8,0)="represents the numeric value of one unit-of-use for the"
^DIC(9.4,77,22,17,"PAH",252,1,9,0)="medication."
^DIC(9.4,77,22,17,"PAH",252,1,10,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,11,0)="When viewing an order in Inpatient Medications, there is a"
^DIC(9.4,77,22,17,"PAH",252,1,12,0)="hidden action called ""DIN"", or ""Drug Restrictions/Guidelines""."
^DIC(9.4,77,22,17,"PAH",252,1,13,0)="With this patch, when DIN is called on an IV order, the"
^DIC(9.4,77,22,17,"PAH",252,1,14,0)="IV Additive strength will be displayed along with the Drug Unit."
^DIC(9.4,77,22,17,"PAH",252,1,15,0)="If the IV Additive Strength is not populated, the text ""N/A"""
^DIC(9.4,77,22,17,"PAH",252,1,16,0)="will appear instead."
^DIC(9.4,77,22,17,"PAH",252,1,17,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,18,0)="For example (STRENGTH populated):"
^DIC(9.4,77,22,17,"PAH",252,1,19,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,20,0)="Drug restriction/guideline info:"
^DIC(9.4,77,22,17,"PAH",252,1,21,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,22,0)="IV Additive: CEFAZOLIN   Additive Strength: 1 GM"
^DIC(9.4,77,22,17,"PAH",252,1,23,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,24,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,25,0)="   Orderable Item: CEFAZOLIN INJ"
^DIC(9.4,77,22,17,"PAH",252,1,26,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,27,0)="          No information available"
^DIC(9.4,77,22,17,"PAH",252,1,28,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,29,0)="   Dispense drug: CEFAZOLIN SOD 10GM M/D INJ"
^DIC(9.4,77,22,17,"PAH",252,1,30,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,31,0)="          No information available"
^DIC(9.4,77,22,17,"PAH",252,1,32,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,33,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,34,0)="For example (STRENGTH not populated):"
^DIC(9.4,77,22,17,"PAH",252,1,35,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,36,0)="IV Additive: CEFAZOLIN PREMIX   Additive Strength: N/A"
^DIC(9.4,77,22,17,"PAH",252,1,37,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,38,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,39,0)="   Orderable Item: CEFAZOLIN INJ"
^DIC(9.4,77,22,17,"PAH",252,1,40,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,41,0)="          No information available"
^DIC(9.4,77,22,17,"PAH",252,1,42,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,43,0)="   Dispense drug: CEFAZOLIN SOD 1GM INJ *N/F*"
^DIC(9.4,77,22,17,"PAH",252,1,44,0)=" "
^DIC(9.4,77,22,17,"PAH",252,1,45,0)="          No information available"
^DIC(9.4,77,22,17,"PAH",253,0)="279 SEQ #254^3131212.141205^17"
^DIC(9.4,77,22,17,"PAH",253,1,0)="^^11^11^3131212"
^DIC(9.4,77,22,17,"PAH",253,1,1,0)="IMR6 - CLINIC ORDER & DRUG HIGH RISK/ALERT"
^DIC(9.4,77,22,17,"PAH",253,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",253,1,3,0)="IV Bag Logic"
^DIC(9.4,77,22,17,"PAH",253,1,4,0)="------------"
^DIC(9.4,77,22,17,"PAH",253,1,5,0)="This patch modifies Inpatient Order Entry so that when Inpatient orders"
^DIC(9.4,77,22,17,"PAH",253,1,6,0)="are edited, BCMA IV parameters are now checked to determine if IV labels"
^DIC(9.4,77,22,17,"PAH",253,1,7,0)="were invalidated as a results of the edit. If labels were invalidated, the"
^DIC(9.4,77,22,17,"PAH",253,1,8,0)="clinician making the edit is informed and a list of the invalidated IV"
^DIC(9.4,77,22,17,"PAH",253,1,9,0)="labels are displayed. The clinician is given an opportunity to print "
^DIC(9.4,77,22,17,"PAH",253,1,10,0)="replacement labels, including when no new order is created as a result of "
^DIC(9.4,77,22,17,"PAH",253,1,11,0)="the edit."
^DIC(9.4,77,22,17,"PAH",254,0)="252^3140407.172333^17"
^DIC(9.4,77,22,17,"PAH",254,1,0)="^^19^19^3140407"
^DIC(9.4,77,22,17,"PAH",254,1,1,0)="This patch is part of a combined build that makes up the release of "
^DIC(9.4,77,22,17,"PAH",254,1,2,0)="MEDICATION ORDER CHECK HEALTHCARE APPLICATION (MOCHA) 2.0."
^DIC(9.4,77,22,17,"PAH",254,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",254,1,4,0)="MOCHA 2.0 encompasses Pharmacy Data Management (PDM) patch PSS*1*160"
^DIC(9.4,77,22,17,"PAH",254,1,5,0)="and a combined build for Outpatient Pharmacy patch PSO*7*372 and "
^DIC(9.4,77,22,17,"PAH",254,1,6,0)="Inpatient Medications patch PSJ*5*252."
^DIC(9.4,77,22,17,"PAH",254,1,7,0)=" "
^DIC(9.4,77,22,17,"PAH",254,1,8,0)="This patch group adds dosing checks that implements a new system that uses"
^DIC(9.4,77,22,17,"PAH",254,1,9,0)="data from First DataBank (FDB).  In this initial phase of dosing"
^DIC(9.4,77,22,17,"PAH",254,1,10,0)="functionality, the Single Dose information will be displayed to"
^DIC(9.4,77,22,17,"PAH",254,1,11,0)="the user.  The following scenarios describe the types of messaging added: "
^DIC(9.4,77,22,17,"PAH",254,1,12,0)=" "
^DIC(9.4,77,22,17,"PAH",254,1,13,0)="  1. If the dosage entered passes the dosing checks, no message will be"
^DIC(9.4,77,22,17,"PAH",254,1,14,0)="     displayed."
^DIC(9.4,77,22,17,"PAH",254,1,15,0)="  2. If the dosage entered is too high or too low, the Single Dose warning"
^DIC(9.4,77,22,17,"PAH",254,1,16,0)="     message will be displayed."
^DIC(9.4,77,22,17,"PAH",254,1,17,0)="  3. If the dose checks were not able to be performed, a generic message"
^DIC(9.4,77,22,17,"PAH",254,1,18,0)="     will be displayed notifying the user that a manual check needs to be"
^DIC(9.4,77,22,17,"PAH",254,1,19,0)="     completed to verify appropriate dosing."
^DIC(9.4,77,22,17,"PAH",255,0)="257^3140407.172403^17"
^DIC(9.4,77,22,17,"PAH",255,1,0)="^^2^2^3140407"
^DIC(9.4,77,22,17,"PAH",255,1,1,0)="This patch is the follow up build for MEDICATION ORDER CHECK HEALTHCARE"
^DIC(9.4,77,22,17,"PAH",255,1,2,0)="APPLICATION (MOCHA) 2.0."
^DIC(9.4,77,22,17,"PAH",256,0)="299^3140407.172441^17"
^DIC(9.4,77,22,17,"PAH",257,0)="199 SEQ #258^3140513.153857^17"
^DIC(9.4,77,22,17,"PAH",257,1,0)="^^9^9^3140513"
^DIC(9.4,77,22,17,"PAH",257,1,1,0)="This patch will resolve the following 2 issues in the Inpatient "
^DIC(9.4,77,22,17,"PAH",257,1,2,0)="Medications package:"
^DIC(9.4,77,22,17,"PAH",257,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",257,1,4,0)="1. On the Pharmacy Unusual Volume Report, when multiple labels are "
^DIC(9.4,77,22,17,"PAH",257,1,5,0)="   printed, cancelled, returned, or destroyed, the correct data is not"
^DIC(9.4,77,22,17,"PAH",257,1,6,0)="   sent or stored."
^DIC(9.4,77,22,17,"PAH",257,1,7,0)=" "
^DIC(9.4,77,22,17,"PAH",257,1,8,0)="2. When finishing two unit dose orders together, the frequency of the"
^DIC(9.4,77,22,17,"PAH",257,1,9,0)="   first order is copied to the second order's frequency."
^DIC(9.4,77,22,17,"PAH",258,0)="309 SEQ #259^3140826.152608^17"
^DIC(9.4,77,22,17,"PAH",258,1,0)="^^5^5^3140826"
^DIC(9.4,77,22,17,"PAH",258,1,1,0)="This patch will address the following 2 issues with the Inpatient"
^DIC(9.4,77,22,17,"PAH",258,1,2,0)="Medications package:"
^DIC(9.4,77,22,17,"PAH",258,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",258,1,4,0)="-Warning message displayed twice for order sets"
^DIC(9.4,77,22,17,"PAH",258,1,5,0)="-Change to medication order renewal error"
^DIC(9.4,77,22,17,"PAH",259,0)="308 SEQ #260^3140929.140638^17"
^DIC(9.4,77,22,17,"PAH",259,1,0)="^^10^10^3140929"
^DIC(9.4,77,22,17,"PAH",259,1,1,0)="This Patch Addresses 4 issues:"
^DIC(9.4,77,22,17,"PAH",259,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",259,1,3,0)="1. Orders on the Medication Administrative History (MAH) report are "
^DIC(9.4,77,22,17,"PAH",259,1,4,0)="missing or not showing in BCMA or CPRS. "
^DIC(9.4,77,22,17,"PAH",259,1,5,0)="2. An undefined error occurs when trying to access the ""Edit Med Log"" "
^DIC(9.4,77,22,17,"PAH",259,1,6,0)="option in BCMA."
^DIC(9.4,77,22,17,"PAH",259,1,7,0)="3. An undefined error occurs when trying to view the Medication Admin "
^DIC(9.4,77,22,17,"PAH",259,1,8,0)="History (MAH) in BCMA."
^DIC(9.4,77,22,17,"PAH",259,1,9,0)="4. An undefined error occurs when accessing a patient who has a PRN order "
^DIC(9.4,77,22,17,"PAH",259,1,10,0)="which is tied to a clinic without an appointment. "
^DIC(9.4,77,22,17,"PAH",260,0)="305 SEQ #261^3141021.114052^17"
^DIC(9.4,77,22,17,"PAH",260,1,0)="^^22^22^3141021"
^DIC(9.4,77,22,17,"PAH",260,1,1,0)="Patch PSJ*5*279 inadvertently introduced the following issues and this "
^DIC(9.4,77,22,17,"PAH",260,1,2,0)="patch, PSJ*5*305 will address these issues."
^DIC(9.4,77,22,17,"PAH",260,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",260,1,4,0)="1)  The ""Infusion Rate"" and ""Number of Labels per Day"" fields for the"
^DIC(9.4,77,22,17,"PAH",260,1,5,0)="    IV Type CHEMOTHERAPY; ADMIXTURE and CHEMOTHERAPY; SYRINGE (Continuous)"
^DIC(9.4,77,22,17,"PAH",260,1,6,0)="    are not allowing the use of the ""@"" functionality nor prompting the"
^DIC(9.4,77,22,17,"PAH",260,1,7,0)="    user for the ""Number of Labels per Day"". This patch fixes this "
^DIC(9.4,77,22,17,"PAH",260,1,8,0)="    problem."
^DIC(9.4,77,22,17,"PAH",260,1,9,0)=" "
^DIC(9.4,77,22,17,"PAH",260,1,10,0)="2)  The Infusion instruction names with defined expansions will duplicate"
^DIC(9.4,77,22,17,"PAH",260,1,11,0)="    the expansion if the name is the leading text in the expansion"
^DIC(9.4,77,22,17,"PAH",260,1,12,0)="    itself. For example, if the abbreviation or term is ""SEE"" and the"
^DIC(9.4,77,22,17,"PAH",260,1,13,0)="    expanded form is ""SEE PROVIDER COMMENTS"" it would erroneously expand"
^DIC(9.4,77,22,17,"PAH",260,1,14,0)="    to ""SEE PROVIDER COMMENTS PROVIDER COMMENTS"". The potential for harm"
^DIC(9.4,77,22,17,"PAH",260,1,15,0)="    exists if confusion results from the odd rate instructions on an"
^DIC(9.4,77,22,17,"PAH",260,1,16,0)="    order/label. This patch corrects this issue."
^DIC(9.4,77,22,17,"PAH",260,1,17,0)=" "
^DIC(9.4,77,22,17,"PAH",260,1,18,0)="3)  When the Infusion Rate field is populated with ""text@0"" (or defined"
^DIC(9.4,77,22,17,"PAH",260,1,19,0)="    label limit of 0), the software is defaulting to (P)RINT at the label"
^DIC(9.4,77,22,17,"PAH",260,1,20,0)="    print option. The software previously defaulted to (B)YPASS when the"
^DIC(9.4,77,22,17,"PAH",260,1,21,0)="    user entered ""@0"" (for zero (0) scheduled labels) in the Infusion Rate"
^DIC(9.4,77,22,17,"PAH",260,1,22,0)="    field. This patch fixes this problem."
^DIC(9.4,77,22,17,"PAH",261,0)="302 SEQ #262^3141023.110952^17"
^DIC(9.4,77,22,17,"PAH",261,1,0)="^^5^5^3141023"
^DIC(9.4,77,22,17,"PAH",261,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",261,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",261,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",261,1,4,0)="-IV orders can be placed for deceased patient"
^DIC(9.4,77,22,17,"PAH",261,1,5,0)="-Dose Limit problem for Day-of-the-Week schedules"
^DIC(9.4,77,22,17,"PAH",262,0)="311^3141031.15561^17"
^DIC(9.4,77,22,17,"PAH",263,0)="310 SEQ #264^3141208.165747^17"
^DIC(9.4,77,22,17,"PAH",263,1,0)="^^4^4^3141208"
^DIC(9.4,77,22,17,"PAH",263,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,77,22,17,"PAH",263,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",263,1,3,0)="1)      The Patient Information Screen for Inpatient Medications does not "
^DIC(9.4,77,22,17,"PAH",263,1,4,0)="display the CrCL and BSA when no orders are present."
^DIC(9.4,77,22,17,"PAH",264,0)="290 SEQ #265^3150209.124126^17"
^DIC(9.4,77,22,17,"PAH",264,1,0)="^^7^7^3150209"
^DIC(9.4,77,22,17,"PAH",264,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,77,22,17,"PAH",264,1,2,0)="  "
^DIC(9.4,77,22,17,"PAH",264,1,3,0)="'...Order deleted' was display in the ListMan order view for a "
^DIC(9.4,77,22,17,"PAH",264,1,4,0)="non-verified IV when entering a new order, but no order was or should be "
^DIC(9.4,77,22,17,"PAH",264,1,5,0)="deleted."
^DIC(9.4,77,22,17,"PAH",264,1,6,0)=" "
^DIC(9.4,77,22,17,"PAH",264,1,7,0)="Last Transferred field not updating when last movement is deleted."
^DIC(9.4,77,22,17,"PAH",265,0)="312 SEQ #266^3150209.153302^17"
^DIC(9.4,77,22,17,"PAH",265,1,0)="^^6^6^3150209"
^DIC(9.4,77,22,17,"PAH",265,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",265,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",265,1,3,0)="1)      Clinic orders, when finished with start date greater than 72 "
^DIC(9.4,77,22,17,"PAH",265,1,4,0)="hours in the past, disappear from the Inpatient Profile."
^DIC(9.4,77,22,17,"PAH",265,1,5,0)="2)      Active inpatient orders have been expired by the system at "
^DIC(9.4,77,22,17,"PAH",265,1,6,0)="midnight."
^DIC(9.4,77,22,17,"PAH",266,0)="304 SEQ #267^3150309.112358^17"
^DIC(9.4,77,22,17,"PAH",266,1,0)="^^7^7^3150309"
^DIC(9.4,77,22,17,"PAH",266,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",266,1,2,0)="1)      An UNDEFINED error when editing the Infusion Rate for a "
^DIC(9.4,77,22,17,"PAH",266,1,3,0)="           non-verified IV order."
^DIC(9.4,77,22,17,"PAH",266,1,4,0)="2)      Automated Tablet Counter (ATC) interface issue with Extra Units "
^DIC(9.4,77,22,17,"PAH",266,1,5,0)="           Dispensed option."
^DIC(9.4,77,22,17,"PAH",266,1,6,0)="3)      Pharmacists are getting locked out of the system."
^DIC(9.4,77,22,17,"PAH",266,1,7,0)="4)      Message display issues with Non-Verified/Pending order screen"
^DIC(9.4,77,22,17,"PAH",267,0)="259 SEQ #268^3150602.105434^17"
^DIC(9.4,77,22,17,"PAH",267,1,0)="^^5^5^3150602"
^DIC(9.4,77,22,17,"PAH",267,1,1,0)="1)  When placing an IV order, under some circumstances the "
^DIC(9.4,77,22,17,"PAH",267,1,2,0)="    ""Instructions"" field will show the wrong dosage for additive, "
^DIC(9.4,77,22,17,"PAH",267,1,3,0)="    even though the ""Additive"" field shows the correct dosage."
^DIC(9.4,77,22,17,"PAH",267,1,4,0)="2)  A Pharmacist non-verified order was verified in CPRS by a Nurse"
^DIC(9.4,77,22,17,"PAH",267,1,5,0)="    which caused the order to become active."
^DIC(9.4,77,22,17,"PAH",268,0)="255 SEQ #269^3150723.143838^17"
^DIC(9.4,77,22,17,"PAH",268,1,0)="^^11^11^3150723"
^DIC(9.4,77,22,17,"PAH",268,1,1,0)="This patch makes 3 corrections to the Inpatient Medications package:"
^DIC(9.4,77,22,17,"PAH",268,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",268,1,3,0)="1. In the CPRS Meds tab, the alphabetical sorting is not working "
^DIC(9.4,77,22,17,"PAH",268,1,4,0)="   correctly."
^DIC(9.4,77,22,17,"PAH",268,1,5,0)=" "
^DIC(9.4,77,22,17,"PAH",268,1,6,0)="2. After renewing and editing a complex order, the original order still"
^DIC(9.4,77,22,17,"PAH",268,1,7,0)="   shows as active."
^DIC(9.4,77,22,17,"PAH",268,1,8,0)=" "
^DIC(9.4,77,22,17,"PAH",268,1,9,0)="3. A complex order renewed in CPRS will record the provider as the "
^DIC(9.4,77,22,17,"PAH",268,1,10,0)="   provider who originally placed the order, rather than the provider "
^DIC(9.4,77,22,17,"PAH",268,1,11,0)="   who renewed it."
^DIC(9.4,77,22,17,"PAH",269,0)="194^3150916.142224^17"
^DIC(9.4,77,22,17,"PAH",269,1,0)="^^26^26^3150916"
^DIC(9.4,77,22,17,"PAH",269,1,1,0)="This patch is part of a multi-package build which will remove the number "
^DIC(9.4,77,22,17,"PAH",269,1,2,0)="of words restriction in a medication administration schedule when a "
^DIC(9.4,77,22,17,"PAH",269,1,3,0)="medication is ordered.  Currently, the Inpatient Pharmacy software "
^DIC(9.4,77,22,17,"PAH",269,1,4,0)="allows a maximum of three words when creating a schedule, and Inpatient"
^DIC(9.4,77,22,17,"PAH",269,1,5,0)="Order Entry is currently designed to accept a maximum of three words."
^DIC(9.4,77,22,17,"PAH",269,1,6,0)="This can prevent a medication from being ordered with the intended "
^DIC(9.4,77,22,17,"PAH",269,1,7,0)="schedule. If the administration schedule in the ADMINISTRATION SCHEDULE "
^DIC(9.4,77,22,17,"PAH",269,1,8,0)="file (#51.1) has a name such as EVERY OTHER DAY and the provider "
^DIC(9.4,77,22,17,"PAH",269,1,9,0)="subsequently checks the PRN box in CPRS, the schedule's full name now"
^DIC(9.4,77,22,17,"PAH",269,1,10,0)="becomes EVERY OTHER DAY PRN.  The Inpatient Order Entry option [PSJ OE]"
^DIC(9.4,77,22,17,"PAH",269,1,11,0)="will not allow this schedule to process because it now contains four"
^DIC(9.4,77,22,17,"PAH",269,1,12,0)="words.  The patch will remove the number of words restriction for the"
^DIC(9.4,77,22,17,"PAH",269,1,13,0)="schedule, but will keep the validation on the overall number of "
^DIC(9.4,77,22,17,"PAH",269,1,14,0)="characters allowed for a schedule by Inpatient Order Entry."
^DIC(9.4,77,22,17,"PAH",269,1,15,0)=" "
^DIC(9.4,77,22,17,"PAH",269,1,16,0)=" "
^DIC(9.4,77,22,17,"PAH",269,1,17,0)="The patch also includes a modification for an issue where an incorrect"
^DIC(9.4,77,22,17,"PAH",269,1,18,0)="test frequency can be calculated for a Laboratory order.  JCAHO added "
^DIC(9.4,77,22,17,"PAH",269,1,19,0)="QOD and QD administration schedule abbreviations to their "
^DIC(9.4,77,22,17,"PAH",269,1,20,0)="DO NOT USE list.  Alternate schedules were suggested to replace those"
^DIC(9.4,77,22,17,"PAH",269,1,21,0)="on the DO NOT USE list.  For example, EVERY OTHER DAY has replaced QOD.  "
^DIC(9.4,77,22,17,"PAH",269,1,22,0)="The software which interprets Lab order schedules is not calculating a "
^DIC(9.4,77,22,17,"PAH",269,1,23,0)="correct schedule when these new alternate schedules are used when "
^DIC(9.4,77,22,17,"PAH",269,1,24,0)="ordering a test.  As a result, sites have reported that some tests have "
^DIC(9.4,77,22,17,"PAH",269,1,25,0)="been ordered at a different frequency than intended by the provider."
^DIC(9.4,77,22,17,"PAH",269,1,26,0)="This has resulted in patients receiving more tests than actually needed. "
^DIC(9.4,77,22,17,"PAH",270,0)="316 SEQ #271^3150922.121005^17"
^DIC(9.4,77,22,17,"PAH",270,1,0)="^^8^8^3150922"
^DIC(9.4,77,22,17,"PAH",270,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",270,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",270,1,3,0)="1)      Activity Log not showing Dispense Drug changes"
^DIC(9.4,77,22,17,"PAH",270,1,4,0)="2)      Expired Unit Dose orders showing on patient profile as Active"
^DIC(9.4,77,22,17,"PAH",270,1,5,0)="3)      Parameters carrying over from IV to Unit Dose orders."
^DIC(9.4,77,22,17,"PAH",270,1,6,0)="4)      When verifying a Unit Dose order with a PRN schedule w/o a "
^DIC(9.4,77,22,17,"PAH",270,1,7,0)="        frequency, user is getting Pre-Exchange DOSES: OI// indicating it"
^DIC(9.4,77,22,17,"PAH",270,1,8,0)="        is invalid."
^DIC(9.4,77,22,17,"PAH",271,0)="217 SEQ #272^3151014.121434^17"
^DIC(9.4,77,22,17,"PAH",271,1,0)="^^10^10^3151014"
^DIC(9.4,77,22,17,"PAH",271,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,77,22,17,"PAH",271,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",271,1,3,0)=" 1. The check to determine whether a patient is on an active pick list is "
^DIC(9.4,77,22,17,"PAH",271,1,4,0)="   not taking into consideration the pick list being flagged to be filed"
^DIC(9.4,77,22,17,"PAH",271,1,5,0)="   away. This will incorrectly prevent a patient record merge from "
^DIC(9.4,77,22,17,"PAH",271,1,6,0)="   occurring."
^DIC(9.4,77,22,17,"PAH",271,1,7,0)=" "
^DIC(9.4,77,22,17,"PAH",271,1,8,0)="2. Various workflows in Inpatient Order Entry [PSJ OE] can result in an"
^DIC(9.4,77,22,17,"PAH",271,1,9,0)="   order having a Nature of Order of -1.  This corrupt data can cause an "
^DIC(9.4,77,22,17,"PAH",271,1,10,0)="   <UNDEFINED> error to occur."
^DIC(9.4,77,22,17,"PAH",272,0)="320 SEQ #273^3160120.12171^54"
^DIC(9.4,77,22,17,"PAH",272,1,0)="^^4^4^3160120"
^DIC(9.4,77,22,17,"PAH",272,1,1,0)="1)      Undefined error on reprint of IV Labels."
^DIC(9.4,77,22,17,"PAH",272,1,2,0)="2)      Remote allergy entries are not being displayed when there are no "
^DIC(9.4,77,22,17,"PAH",272,1,3,0)="        local allergies."
^DIC(9.4,77,22,17,"PAH",272,1,4,0)="3)      BCBU patient shows duplicate orders"
^DIC(9.4,77,22,17,"PAH",273,0)="307^3160310.154714^54"
^DIC(9.4,77,22,17,"PAH",273,1,0)="^^1^1^3160310"
^DIC(9.4,77,22,17,"PAH",273,1,1,0)="Inpatient Medications support for CPRS v30."
^DIC(9.4,77,22,17,"PAH",274,0)="318 SEQ #275^3160317.120852^54"
^DIC(9.4,77,22,17,"PAH",274,1,0)="^^7^7^3160317"
^DIC(9.4,77,22,17,"PAH",274,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",274,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",274,1,3,0)="1)  CPRS order Details not showing med history"
^DIC(9.4,77,22,17,"PAH",274,1,4,0)="2)  Order set displays wrong drug when you enter ""?"" at the Dispense Drug"
^DIC(9.4,77,22,17,"PAH",274,1,5,0)="    prompt"
^DIC(9.4,77,22,17,"PAH",274,1,6,0)="3)  Pending and Non-Verified orders not participating in Drug Interaction"
^DIC(9.4,77,22,17,"PAH",274,1,7,0)="    and Dup Therapy order checks."
^DIC(9.4,77,22,17,"PAH",275,0)="326 SEQ #276^3160523.130715^54"
^DIC(9.4,77,22,17,"PAH",275,1,0)="^^2^2^3160523"
^DIC(9.4,77,22,17,"PAH",275,1,1,0)="1)       UNDEFINED EN2+4^PSJIBAG - Invalidated Labels Report"
^DIC(9.4,77,22,17,"PAH",275,1,2,0)="2)       7 Day MAR not pulling all orders"
^DIC(9.4,77,22,17,"PAH",276,0)="281^3160526.154916^54"
^DIC(9.4,77,22,17,"PAH",277,0)="323 SEQ #278^3160706.155624^54"
^DIC(9.4,77,22,17,"PAH",277,1,0)="^^4^4^3160706"
^DIC(9.4,77,22,17,"PAH",277,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",277,1,2,0)="1)  Erroneous data on Patient on Specific Drug Report"
^DIC(9.4,77,22,17,"PAH",277,1,3,0)="2)  Ward Stock issue with Clinic Orders"
^DIC(9.4,77,22,17,"PAH",277,1,4,0)="3)  IV order of PRN is printing multiple labels"
^DIC(9.4,77,22,17,"PAH",278,0)="313 SEQ #279^3160713.125559^54"
^DIC(9.4,77,22,17,"PAH",278,1,0)="^^73^73^3160713"
^DIC(9.4,77,22,17,"PAH",278,1,1,0)="This patch is part of the Pharmacy Safety Updates project which was "
^DIC(9.4,77,22,17,"PAH",278,1,2,0)="established to address specific New Service Requests (NSRs) as well as a"
^DIC(9.4,77,22,17,"PAH",278,1,3,0)="Remedy Ticket and a Patient Safety Issue (PSI) related to the VistA Pharmacy"
^DIC(9.4,77,22,17,"PAH",278,1,4,0)="applications as approved by the Health Systems Enterprise Systems Manager"
^DIC(9.4,77,22,17,"PAH",278,1,5,0)="(ESM)."
^DIC(9.4,77,22,17,"PAH",278,1,6,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,7,0)="This project is comprised of patches from five different applications, as"
^DIC(9.4,77,22,17,"PAH",278,1,8,0)="shown below:"
^DIC(9.4,77,22,17,"PAH",278,1,9,0)="  "
^DIC(9.4,77,22,17,"PAH",278,1,10,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,77,22,17,"PAH",278,1,11,0)="   -----------------------------------------------------------------"
^DIC(9.4,77,22,17,"PAH",278,1,12,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*444"
^DIC(9.4,77,22,17,"PAH",278,1,13,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*545"
^DIC(9.4,77,22,17,"PAH",278,1,14,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*189"
^DIC(9.4,77,22,17,"PAH",278,1,15,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                      PSN*4*429"
^DIC(9.4,77,22,17,"PAH",278,1,16,0)="   INPATIENT MEDICATIONS (IM) V.5.0                     PSJ*5*313"
^DIC(9.4,77,22,17,"PAH",278,1,17,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,18,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,19,0)="The following New service Request (NSR) is being addressed by this patch:"
^DIC(9.4,77,22,17,"PAH",278,1,20,0)="  "
^DIC(9.4,77,22,17,"PAH",278,1,21,0)=" NSR 20110308 Addition of a STRENGTH Property to IV ADDITIVES and Premixed "
^DIC(9.4,77,22,17,"PAH",278,1,22,0)="              IV SOLUTIONS"
^DIC(9.4,77,22,17,"PAH",278,1,23,0)=" ----------------------------------------------------------------------------"
^DIC(9.4,77,22,17,"PAH",278,1,24,0)=" Although patches PSJ*5*289 and PSS*1*174 introduced quite a few enhancements"
^DIC(9.4,77,22,17,"PAH",278,1,25,0)=" to the IV Additives and IV Solutions ordering functionality they did not go"
^DIC(9.4,77,22,17,"PAH",278,1,26,0)=" far enough in addressing all the issues originally in the NSR. Patches "
^DIC(9.4,77,22,17,"PAH",278,1,27,0)=" PSJ*5*313 and PSS*1*189 will extend the display of the IV Additive strength"
^DIC(9.4,77,22,17,"PAH",278,1,28,0)=" to other parts of the Inpatient Medications and Pharmacy Data Management "
^DIC(9.4,77,22,17,"PAH",278,1,29,0)=" applications. In addition, it will also impose a new rule where an Orderable"
^DIC(9.4,77,22,17,"PAH",278,1,30,0)=" Item can only have one IV Solution for a specific volume when it is marked"
^DIC(9.4,77,22,17,"PAH",278,1,31,0)=" to be used in the CPRS IV Fluid Order Entry. "
^DIC(9.4,77,22,17,"PAH",278,1,32,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,33,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,34,0)="The following Inpatient Medications functionality was modified:"
^DIC(9.4,77,22,17,"PAH",278,1,35,0)="   "
^DIC(9.4,77,22,17,"PAH",278,1,36,0)="1. Inpatient Order Entry [PSJ OE] option"
^DIC(9.4,77,22,17,"PAH",278,1,37,0)="   This option was updated to display the IV Additive strength when more"
^DIC(9.4,77,22,17,"PAH",278,1,38,0)="   than one is available for the Orderable Item. There are two different"
^DIC(9.4,77,22,17,"PAH",278,1,39,0)="   points where the IV Additive strength is displayed when finishing an"
^DIC(9.4,77,22,17,"PAH",278,1,40,0)="   order:"
^DIC(9.4,77,22,17,"PAH",278,1,41,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,42,0)="   a) Finishing an Unit Dose order"
^DIC(9.4,77,22,17,"PAH",278,1,43,0)="   ..."
^DIC(9.4,77,22,17,"PAH",278,1,44,0)="   DC   Discontinue          FL   (Flag)"
^DIC(9.4,77,22,17,"PAH",278,1,45,0)="   ED   Edit                 FN   Finish"
^DIC(9.4,77,22,17,"PAH",278,1,46,0)="   Select Item(s): Next Screen// FN   Finish  "
^DIC(9.4,77,22,17,"PAH",278,1,47,0)="   IV TYPE: PIGGYBACK// "
^DIC(9.4,77,22,17,"PAH",278,1,48,0)="   Select ADDITIVE: "
^DIC(9.4,77,22,17,"PAH",278,1,49,0)="     1  PIPERACILLIN/TAZOBACTAM          Additive Strength: 3.375 GM"
^DIC(9.4,77,22,17,"PAH",278,1,50,0)="     2  PIPERACILLIN/TAZOBACTAM          Additive Strength: 2.25 GM"
^DIC(9.4,77,22,17,"PAH",278,1,51,0)="     3  PIPERACILLIN/TAZOBACTAM          Additive Strength: 4.5 GM"
^DIC(9.4,77,22,17,"PAH",278,1,52,0)="   Select (1 - 3): "
^DIC(9.4,77,22,17,"PAH",278,1,53,0)="   "
^DIC(9.4,77,22,17,"PAH",278,1,54,0)="  b) Finishing an IV order"
^DIC(9.4,77,22,17,"PAH",278,1,55,0)="  "
^DIC(9.4,77,22,17,"PAH",278,1,56,0)="   ...      "
^DIC(9.4,77,22,17,"PAH",278,1,57,0)="   DC   Discontinue          FL   (Flag)"
^DIC(9.4,77,22,17,"PAH",278,1,58,0)="   ED   Edit                 FN   Finish"
^DIC(9.4,77,22,17,"PAH",278,1,59,0)="   Select Item(s): Next Screen// FN   Finish  "
^DIC(9.4,77,22,17,"PAH",278,1,60,0)="   IV TYPE: PIGGYBACK// "
^DIC(9.4,77,22,17,"PAH",278,1,61,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,62,0)="   More than one dispense IV Additives are available for:"
^DIC(9.4,77,22,17,"PAH",278,1,63,0)="    Orderable Item: PIPERACILLIN/TAZOBACTAM INJ"
^DIC(9.4,77,22,17,"PAH",278,1,64,0)="      Ordered Dose: 5 GM"
^DIC(9.4,77,22,17,"PAH",278,1,65,0)="   "
^DIC(9.4,77,22,17,"PAH",278,1,66,0)="   Please, select the correct dispense IV Additive below for this order:"
^DIC(9.4,77,22,17,"PAH",278,1,67,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,68,0)="     1  PIPERACILLIN/TAZOBACTAM          Additive Strength: 3.375 GM"
^DIC(9.4,77,22,17,"PAH",278,1,69,0)="     2  PIPERACILLIN/TAZOBACTAM          Additive Strength: 2.25 GM"
^DIC(9.4,77,22,17,"PAH",278,1,70,0)="     3  PIPERACILLIN/TAZOBACTAM          Additive Strength: 4.5 GM"
^DIC(9.4,77,22,17,"PAH",278,1,71,0)=" "
^DIC(9.4,77,22,17,"PAH",278,1,72,0)="  Select (1 - 3): 3  PIPERACILLIN/TAZOBACTAM   Additive Strength: 4.5 GM"
^DIC(9.4,77,22,17,"PAH",278,1,73,0)="  ..."
^DIC(9.4,77,22,17,"PAH",279,0)="330 SEQ #280^3160819.1619^54"
^DIC(9.4,77,22,17,"PAH",279,1,0)="^^3^3^3160819"
^DIC(9.4,77,22,17,"PAH",279,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,77,22,17,"PAH",279,1,2,0)="1)     Admin time reverts back after finishing when copying a Unit Dose "
^DIC(9.4,77,22,17,"PAH",279,1,3,0)="       order"
^DIC(9.4,77,22,17,"PAH",280,0)="315 SEQ #281^3160902.135113^54"
^DIC(9.4,77,22,17,"PAH",280,1,0)="^^162^162^3160902"
^DIC(9.4,77,22,17,"PAH",280,1,1,0)="******************************* ATTENTION ********************************"
^DIC(9.4,77,22,17,"PAH",280,1,2,0)="  "
^DIC(9.4,77,22,17,"PAH",280,1,3,0)="Clinical Ancillary Services (CAS) Development-Delivery of Pharmacy "
^DIC(9.4,77,22,17,"PAH",280,1,4,0)="Enhancements (DDPE) VA Inpatient Medication Administration - Transdermal"
^DIC(9.4,77,22,17,"PAH",280,1,5,0)="enhancement includes 5 patches that must be installed in the following"
^DIC(9.4,77,22,17,"PAH",280,1,6,0)="order:"
^DIC(9.4,77,22,17,"PAH",280,1,7,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,8,0)="1.      PSS*1*191"
^DIC(9.4,77,22,17,"PAH",280,1,9,0)="2.      PSJ*5*315"
^DIC(9.4,77,22,17,"PAH",280,1,10,0)="3.      PSB*3*83"
^DIC(9.4,77,22,17,"PAH",280,1,11,0)="4.      PSB*3*87"
^DIC(9.4,77,22,17,"PAH",280,1,12,0)="5.      OR*3*417"
^DIC(9.4,77,22,17,"PAH",280,1,13,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,14,0)="ATTENTION: This enhancement also includes a new Graphical User Interface"
^DIC(9.4,77,22,17,"PAH",280,1,15,0)="(GUI) executable, BCMA GUI PSB3_P083.EXE. Installation of this GUI is"
^DIC(9.4,77,22,17,"PAH",280,1,16,0)="required immediately after the KIDS install for the Patch to function."
^DIC(9.4,77,22,17,"PAH",280,1,17,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,18,0)="For retrieval and installation instructions, please see the Client "
^DIC(9.4,77,22,17,"PAH",280,1,19,0)="Installation Instructions section."
^DIC(9.4,77,22,17,"PAH",280,1,20,0)="**************************************************************************"
^DIC(9.4,77,22,17,"PAH",280,1,21,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,22,0)="Patch PSJ*5.0*315 provides enhancements to the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",280,1,23,0)="application and to support enhancements for the Bar Code Medications "
^DIC(9.4,77,22,17,"PAH",280,1,24,0)="Administrations (BCMA) application for Transdermal Administrations. These "
^DIC(9.4,77,22,17,"PAH",280,1,25,0)="enhancements include:"
^DIC(9.4,77,22,17,"PAH",280,1,26,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,27,0)="     1. Currently Sites have to create fake removal orders to allow for "
^DIC(9.4,77,22,17,"PAH",280,1,28,0)="appropriate removal of medications in BCMA.  This patch will alleviate "
^DIC(9.4,77,22,17,"PAH",280,1,29,0)="that issue by prompting the user for DURATION OF ADMINISTRATION based on"
^DIC(9.4,77,22,17,"PAH",280,1,30,0)="the value stored in the PROMPT FOR REMOVAL IN BCMA field (#12) contained"
^DIC(9.4,77,22,17,"PAH",280,1,31,0)="in the ORDERABLE ITEM file (#50.7).  This field implements changes that"
^DIC(9.4,77,22,17,"PAH",280,1,32,0)="will support enhancements to the BCMA and Inpatient Medication"
^DIC(9.4,77,22,17,"PAH",280,1,33,0)="applications to display the removal times in Inpatient Medication orders"
^DIC(9.4,77,22,17,"PAH",280,1,34,0)="using rules determined by the value of this field. The PROMPT FOR REMOVAL"
^DIC(9.4,77,22,17,"PAH",280,1,35,0)="IN BCMA field (#12) can be set for Orderable Items that require removal to"
^DIC(9.4,77,22,17,"PAH",280,1,36,0)="the following values:"
^DIC(9.4,77,22,17,"PAH",280,1,37,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,38,0)="     NULL/0=No Removal Required "
^DIC(9.4,77,22,17,"PAH",280,1,39,0)="     1 = Removal at Next Administration "
^DIC(9.4,77,22,17,"PAH",280,1,40,0)="     2 = Removal Period Optional Prior to Next Administration  "
^DIC(9.4,77,22,17,"PAH",280,1,41,0)="     3 = Removal Period Required Prior to Next Administration"
^DIC(9.4,77,22,17,"PAH",280,1,42,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,43,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,44,0)="     2. Routines added for this patch will add the new DURATION OF "
^DIC(9.4,77,22,17,"PAH",280,1,45,0)="ADMINISTRATION prompt to the option Inpatient Order Entry [PSJ OE] then "
^DIC(9.4,77,22,17,"PAH",280,1,46,0)="calculate the appropriate removal times and display them for verification."
^DIC(9.4,77,22,17,"PAH",280,1,47,0)="The NON-VERIFIED ORDERS file (#53.1) and UNIT DOSE sub-file(#62) of the "
^DIC(9.4,77,22,17,"PAH",280,1,48,0)="PHARMACY PATIENT file (#55) will be updated to include new fields that "
^DIC(9.4,77,22,17,"PAH",280,1,49,0)="will control the removal process.  These two files will have these 4"
^DIC(9.4,77,22,17,"PAH",280,1,50,0)="fields added: DURATION OF ADMINISTRATION field (#137), REMOVE TIMES"
^DIC(9.4,77,22,17,"PAH",280,1,51,0)="field(#138), REMOVE PERIOD field(#139) and BCMA PROMPT FOR REMOVAL FLAG"
^DIC(9.4,77,22,17,"PAH",280,1,52,0)="field(#140).  A new field called PROMPT FOR REMOVAL IN BCMA field(#12)"
^DIC(9.4,77,22,17,"PAH",280,1,53,0)="created in the ORDERABLE ITEMS file (#50.7) by patch PSS*1.0*191 will be"
^DIC(9.4,77,22,17,"PAH",280,1,54,0)="used for information to be stored in the BCMA PROMPT FOR REMOVAL FLAG"
^DIC(9.4,77,22,17,"PAH",280,1,55,0)="field(#140) in the NON-VERIFIED ORDERS file(#53.1) and the UNIT DOSE"
^DIC(9.4,77,22,17,"PAH",280,1,56,0)="sub-file(#62) of the PHARMACY PATIENT file (#55)."
^DIC(9.4,77,22,17,"PAH",280,1,57,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,58,0)="     3. The Edit Clinic Med Orders Start Date/Time [PSJ ECO] option will "
^DIC(9.4,77,22,17,"PAH",280,1,59,0)="have changes to anticipate these new fields and request additional user "
^DIC(9.4,77,22,17,"PAH",280,1,60,0)="activity when the orders require specific information that can "
^DIC(9.4,77,22,17,"PAH",280,1,61,0)="only be entered via the Inpatient Order Entry [PSJ OE] option."
^DIC(9.4,77,22,17,"PAH",280,1,62,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,63,0)="     4. This patch contains a post-install routine PSJ5P315 that sends a "
^DIC(9.4,77,22,17,"PAH",280,1,64,0)="report listing all legacy orders for Medications that require removal.  "
^DIC(9.4,77,22,17,"PAH",280,1,65,0)="In order to prevent confusion by users of the BCMA GUI application these "
^DIC(9.4,77,22,17,"PAH",280,1,66,0)="orders will need to be discontinued and reordered to include the"
^DIC(9.4,77,22,17,"PAH",280,1,67,0)="removal information.  This same report can be recalled from the Pharmacy"
^DIC(9.4,77,22,17,"PAH",280,1,68,0)="Data Management [PSS MGR] menu using the Orders for MRRs With Removal"
^DIC(9.4,77,22,17,"PAH",280,1,69,0)="Properties [PSS MRR ORDERS DIAGNOSTIC RPT] option."
^DIC(9.4,77,22,17,"PAH",280,1,70,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,71,0)="     5. The Order View Hidden Actions Menu [PSJ LM ORDER VIEW HIDDEN"
^DIC(9.4,77,22,17,"PAH",280,1,72,0)="ACTIONS] protocol has been modified to include a hidden action for calling"
^DIC(9.4,77,22,17,"PAH",280,1,73,0)="the Administration History report. A new protocol, Admin History for OI"
^DIC(9.4,77,22,17,"PAH",280,1,74,0)="[PSJ LM ADM HIST], was added for the new hidden action.  This report "
^DIC(9.4,77,22,17,"PAH",280,1,75,0)="allows viewing of other orders for the Orderable Item listed in the Order"
^DIC(9.4,77,22,17,"PAH",280,1,76,0)="Detail for the selected Order. The menu item Other Pharmacy Options [PSJ"
^DIC(9.4,77,22,17,"PAH",280,1,77,0)="LM OTHER PHARMACY OPTIONS] has been shortened to read Other Pharm Options"
^DIC(9.4,77,22,17,"PAH",280,1,78,0)="in order to allow the columns to align correctly.  The AH menu option "
^DIC(9.4,77,22,17,"PAH",280,1,79,0)="will not be available during the period in which PSJ*5.0*315 is installed,"
^DIC(9.4,77,22,17,"PAH",280,1,80,0)="but PSB*3.0*83 is not.  If the user attempts to run this option during "
^DIC(9.4,77,22,17,"PAH",280,1,81,0)="this time they will get the following message: Report not available until"
^DIC(9.4,77,22,17,"PAH",280,1,82,0)="install of patch PSB*3.0*83."
^DIC(9.4,77,22,17,"PAH",280,1,83,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,84,0)="       This patch requires patch PSS*1.0*191."
^DIC(9.4,77,22,17,"PAH",280,1,85,0)="       "
^DIC(9.4,77,22,17,"PAH",280,1,86,0)="       The full functionality introduced in this patch will not be"
^DIC(9.4,77,22,17,"PAH",280,1,87,0)="       available until patches PSB*3.0*83 and possibly PSB*3.0*87 "
^DIC(9.4,77,22,17,"PAH",280,1,88,0)="       for Bar Code Back Up (BCBU) are installed."
^DIC(9.4,77,22,17,"PAH",280,1,89,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,90,0)="       Pre-existing orders will remain unaffected with installation."
^DIC(9.4,77,22,17,"PAH",280,1,91,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,92,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,93,0)="********** SPECIAL NOTE on Times Per Day (TPD) orders**********:"
^DIC(9.4,77,22,17,"PAH",280,1,94,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,95,0)="     To avoid confusion it is strongly recommended that  MRR medications"
^DIC(9.4,77,22,17,"PAH",280,1,96,0)="needing to use a TPD schedule with asynchronous administrations and"
^DIC(9.4,77,22,17,"PAH",280,1,97,0)="removals, be set to have the PROMPT FOR REMOVAL IN BCMA (#12) set to a"
^DIC(9.4,77,22,17,"PAH",280,1,98,0)="value of 3.  The Pharmacist will then always be prompted for the Duration"
^DIC(9.4,77,22,17,"PAH",280,1,99,0)="of Administration and a proper removal time can be entered in the"
^DIC(9.4,77,22,17,"PAH",280,1,100,0)="Inpatient Order Entry [PSJ OE] option. "
^DIC(9.4,77,22,17,"PAH",280,1,101,0)="     "
^DIC(9.4,77,22,17,"PAH",280,1,102,0)="     In order to maintain adequate flexibility for Times per Day (TPD)"
^DIC(9.4,77,22,17,"PAH",280,1,103,0)="     schedules such as BID, TID and QID for MRR medication orders; these "
^DIC(9.4,77,22,17,"PAH",280,1,104,0)="     schedules are not validated to the extent that other continuous"
^DIC(9.4,77,22,17,"PAH",280,1,105,0)="     schedule types are validated.  The intent was to allow a variety of"
^DIC(9.4,77,22,17,"PAH",280,1,106,0)="     administrations and removals that may be asynchronous in order to"
^DIC(9.4,77,22,17,"PAH",280,1,107,0)="     process correctly; for instance this will allow having two"
^DIC(9.4,77,22,17,"PAH",280,1,108,0)="     administrations 6 hours apart followed by a 12 hour medication-free"
^DIC(9.4,77,22,17,"PAH",280,1,109,0)="     period.  "
^DIC(9.4,77,22,17,"PAH",280,1,110,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,111,0)="        Normally the frequency used by the existing ADMINISTRATION "
^DIC(9.4,77,22,17,"PAH",280,1,112,0)="SCHEDULE file (#51.1) setup would expect a 12 hour frequency for "
^DIC(9.4,77,22,17,"PAH",280,1,113,0)="continuous schedule types ( 24 hours divided by 2 administrations equals"
^DIC(9.4,77,22,17,"PAH",280,1,114,0)="12 ) and this is what is standard practice."
^DIC(9.4,77,22,17,"PAH",280,1,115,0)="        "
^DIC(9.4,77,22,17,"PAH",280,1,116,0)="        Existing MRRs set to have the medication removed at the next "
^DIC(9.4,77,22,17,"PAH",280,1,117,0)="Duration of Administration would need to have a Duration of Administration"
^DIC(9.4,77,22,17,"PAH",280,1,118,0)="value entered for TPD schedules, otherwise the stored frequency in the"
^DIC(9.4,77,22,17,"PAH",280,1,119,0)="ADMINISTRATION SCHEDULE file (#51.1) would be used and this could result "
^DIC(9.4,77,22,17,"PAH",280,1,120,0)="in an incorrect removal period.  Therefore we recommend setting the MRR"
^DIC(9.4,77,22,17,"PAH",280,1,121,0)="value to a 3 (Duration of Administration Required). If the MRR is set to a"
^DIC(9.4,77,22,17,"PAH",280,1,122,0)="value of 1 in the PROMPT FOR REMOVAL IN BCMA field (#12), the Pharmacist"
^DIC(9.4,77,22,17,"PAH",280,1,123,0)="would not receive the verification screen that appears for  Duration of"
^DIC(9.4,77,22,17,"PAH",280,1,124,0)="Administration entries and may not be aware of this issue."
^DIC(9.4,77,22,17,"PAH",280,1,125,0)="        "
^DIC(9.4,77,22,17,"PAH",280,1,126,0)="The following is an example of using a type 1 Prompt for Removal in BCMA"
^DIC(9.4,77,22,17,"PAH",280,1,127,0)="for TPD's (Not recommended Condition):"
^DIC(9.4,77,22,17,"PAH",280,1,128,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,129,0)="     The MRR medication needs to be administered at 0900 and removed "
^DIC(9.4,77,22,17,"PAH",280,1,130,0)="at 1500, with a new administration added at 1500 then removed at 2100.  "
^DIC(9.4,77,22,17,"PAH",280,1,131,0)="       "
^DIC(9.4,77,22,17,"PAH",280,1,132,0)="     The BID  schedule is used with the PROMPT FOR REMOVAL IN BCMAPrompt "
^DIC(9.4,77,22,17,"PAH",280,1,133,0)="for Removal in BCMA "
^DIC(9.4,77,22,17,"PAH",280,1,134,0)="field (#12)  value set to a 1 and the Frequency for BID schedule set to "
^DIC(9.4,77,22,17,"PAH",280,1,135,0)="12 hours."
^DIC(9.4,77,22,17,"PAH",280,1,136,0)="     "
^DIC(9.4,77,22,17,"PAH",280,1,137,0)="     The Pharmacist would only see the administration times of 0900 "
^DIC(9.4,77,22,17,"PAH",280,1,138,0)="and 1500."
^DIC(9.4,77,22,17,"PAH",280,1,139,0)="       "
^DIC(9.4,77,22,17,"PAH",280,1,140,0)="     The system would then use the frequency stored in the "
^DIC(9.4,77,22,17,"PAH",280,1,141,0)="ADMINISTRATION SCHEDULE file (#51.1) Administration schedule file of 12 "
^DIC(9.4,77,22,17,"PAH",280,1,142,0)="hours, so that Removal Times on the"
^DIC(9.4,77,22,17,"PAH",280,1,143,0)="enhanced BCMA would then calculate as removal at 2100 and 0300, which "
^DIC(9.4,77,22,17,"PAH",280,1,144,0)="would be in conflict with the administration times."
^DIC(9.4,77,22,17,"PAH",280,1,145,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,146,0)="The following is an example of using a type 3 Prompt for Removal in BCMA"
^DIC(9.4,77,22,17,"PAH",280,1,147,0)="for TPD's (Recommended condition):"
^DIC(9.4,77,22,17,"PAH",280,1,148,0)=" "
^DIC(9.4,77,22,17,"PAH",280,1,149,0)="     The MRR medication needs to be administered at 0900 and removed "
^DIC(9.4,77,22,17,"PAH",280,1,150,0)="at 1500, with a new administration added at 1500 then removed at 2100.  "
^DIC(9.4,77,22,17,"PAH",280,1,151,0)="       "
^DIC(9.4,77,22,17,"PAH",280,1,152,0)="     The BID  schedule is used with the PROMPT FOR REMOVAL IN BCMA "
^DIC(9.4,77,22,17,"PAH",280,1,153,0)="field (#12)  value set to a 3.  In this case the Frequency is no longer "
^DIC(9.4,77,22,17,"PAH",280,1,154,0)="used. "
^DIC(9.4,77,22,17,"PAH",280,1,155,0)="       "
^DIC(9.4,77,22,17,"PAH",280,1,156,0)="     The Pharmacist would see the administration times of 0900 and "
^DIC(9.4,77,22,17,"PAH",280,1,157,0)="1500 and enter the appropriate Duration of Administration  which would be "
^DIC(9.4,77,22,17,"PAH",280,1,158,0)="6 hours."
^DIC(9.4,77,22,17,"PAH",280,1,159,0)="       "
^DIC(9.4,77,22,17,"PAH",280,1,160,0)="     The system would create a verification display showing "
^DIC(9.4,77,22,17,"PAH",280,1,161,0)="administration at 0900 followed by and Administration and Removal at 1500 "
^DIC(9.4,77,22,17,"PAH",280,1,162,0)="then a Removal at 2100 as ordered by the Physician."
^DIC(9.4,77,22,17,"PAH",281,0)="333 SEQ #282^3160923.152143^54"
^DIC(9.4,77,22,17,"PAH",281,1,0)="^^12^12^3160923"
^DIC(9.4,77,22,17,"PAH",281,1,1,0)=" This patch is part of the Pharmacy Safety Updates project and will "
^DIC(9.4,77,22,17,"PAH",281,1,2,0)=" address the Patient Safety Issue (PSI) #PSPO00003281. "
^DIC(9.4,77,22,17,"PAH",281,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",281,1,4,0)=" The issue is that an <UNDEFINED> error is occurring while finishing a "
^DIC(9.4,77,22,17,"PAH",281,1,5,0)=" pending order in the Inpatient Medications application causing a forced "
^DIC(9.4,77,22,17,"PAH",281,1,6,0)=" exit from the Inpatient Order Entry [PSJ OE] option when attempting to "
^DIC(9.4,77,22,17,"PAH",281,1,7,0)=" finish UNIT DOSE orders. The order being finished presents as an IV order"
^DIC(9.4,77,22,17,"PAH",281,1,8,0)=" and prompts the user to finish as either UD or IV. The user is choosing"
^DIC(9.4,77,22,17,"PAH",281,1,9,0)=" to finish as UD."
^DIC(9.4,77,22,17,"PAH",281,1,10,0)=" "
^DIC(9.4,77,22,17,"PAH",281,1,11,0)=" PSI PSPO00003281 is CA Service Desk Ticket I9935231FY16-IP MEDS HARD "
^DIC(9.4,77,22,17,"PAH",281,1,12,0)=" ERRORING IN FINISHING ORDERS."
^DIC(9.4,77,22,17,"PAH",282,0)="317 SEQ #283^3161006.130139^54"
^DIC(9.4,77,22,17,"PAH",282,1,0)="^^217^217^3161006"
^DIC(9.4,77,22,17,"PAH",282,1,1,0)="The Pharmacy Interface Automation Project (PIA) will provide a new"
^DIC(9.4,77,22,17,"PAH",282,1,2,0)="standard bi-directional Health Level Seven (HL7) to the Pharmacy"
^DIC(9.4,77,22,17,"PAH",282,1,3,0)="Automated Dispensing Equipment (PADE) server. The PADE will route the"
^DIC(9.4,77,22,17,"PAH",282,1,4,0)="message to a cabinet located at the point of care areas such as Inpatient"
^DIC(9.4,77,22,17,"PAH",282,1,5,0)="wards, Outpatient Clinics etc."
^DIC(9.4,77,22,17,"PAH",282,1,6,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,7,0)="The following two patches are provided for this project:"
^DIC(9.4,77,22,17,"PAH",282,1,8,0)="  PSJ*5*317 - Inpatient Medications V. 5.0."
^DIC(9.4,77,22,17,"PAH",282,1,9,0)="  PSS*1*193 - Pharmacy Data Management V. 1.0."
^DIC(9.4,77,22,17,"PAH",282,1,10,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,11,0)="Note: The patches should be installed in the order listed above as the "
^DIC(9.4,77,22,17,"PAH",282,1,12,0)="logical link, PSJ PADE used in the PSS patch is transported in the PSJ"
^DIC(9.4,77,22,17,"PAH",282,1,13,0)="patch."
^DIC(9.4,77,22,17,"PAH",282,1,14,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,15,0)="1.  The following new files were created:"
^DIC(9.4,77,22,17,"PAH",282,1,16,0)="    PADE SYSTEM SETUP file (#58.7)"
^DIC(9.4,77,22,17,"PAH",282,1,17,0)="    PADE SEND AREA file (#58.71)"
^DIC(9.4,77,22,17,"PAH",282,1,18,0)="    PADE OUTBOUND MESSAGES file (#58.72)"
^DIC(9.4,77,22,17,"PAH",282,1,19,0)="    PADE INVENTORY SYSTEM file (#58.601) "
^DIC(9.4,77,22,17,"PAH",282,1,20,0)="    PADE INBOUND TRANSACTIONS file (#58.6)"
^DIC(9.4,77,22,17,"PAH",282,1,21,0)="    PADE DISPENSING DEVICE file (#58.63)"
^DIC(9.4,77,22,17,"PAH",282,1,22,0)="    PADE USER file (#58.64)"
^DIC(9.4,77,22,17,"PAH",282,1,23,0)="    "
^DIC(9.4,77,22,17,"PAH",282,1,24,0)="2.  A new menu, PADE Main Menu [PSJ PADE MAIN MENU], with the following"
^DIC(9.4,77,22,17,"PAH",282,1,25,0)="    options was created:"
^DIC(9.4,77,22,17,"PAH",282,1,26,0)="    PADE Send Area Setup [PSJ PADE SEND AREA SETUP] option"
^DIC(9.4,77,22,17,"PAH",282,1,27,0)="    PADE System Setup [PSJ PADE SETUP] option"
^DIC(9.4,77,22,17,"PAH",282,1,28,0)="    PADE Send Surgery Cases [PSJ PADE SEND SURGERY CASES] option"
^DIC(9.4,77,22,17,"PAH",282,1,29,0)="    PADE Send Patient Orders [PSJ PADE SEND ORDERS] option"
^DIC(9.4,77,22,17,"PAH",282,1,30,0)="    PADE Inventory Setup [PSJ PADE INVENTORY MENU] option"
^DIC(9.4,77,22,17,"PAH",282,1,31,0)="       ...Inventory System Setup [PSJ PADE INVENTORY SYSTEM] option"
^DIC(9.4,77,22,17,"PAH",282,1,32,0)="       ...Dispensing Device Setup [PSJ PADE DEVICE SETUP] option"
^DIC(9.4,77,22,17,"PAH",282,1,33,0)="    PADE Reports [PSJ PADE REPORTS MENU] option"
^DIC(9.4,77,22,17,"PAH",282,1,34,0)="       ...PADE On-Hand Amounts [PSJ PADE INVENTORY REPORT] option"
^DIC(9.4,77,22,17,"PAH",282,1,35,0)="       ...PADE Transaction Report [PSJ PADE TRANSACTION REPORT] option"
^DIC(9.4,77,22,17,"PAH",282,1,36,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,37,0)="3.  A new security key, PSJ PADE MGR, was created to allow access to the "
^DIC(9.4,77,22,17,"PAH",282,1,38,0)="    above menus noted in item 2."
^DIC(9.4,77,22,17,"PAH",282,1,39,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,40,0)="4.  The option, PADE System Division Setup [PSJ PADE DIVISION SETUP],"
^DIC(9.4,77,22,17,"PAH",282,1,41,0)="    was exported as a separate option so that it can be given to an"
^DIC(9.4,77,22,17,"PAH",282,1,42,0)="    assigned user to set up a division under a PADE."
^DIC(9.4,77,22,17,"PAH",282,1,43,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,44,0)="5.  A new security key, PSJ PADE ADV, was created to allow access to the "
^DIC(9.4,77,22,17,"PAH",282,1,45,0)="    above option noted in item 4."
^DIC(9.4,77,22,17,"PAH",282,1,46,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,47,0)="6.  The option, PADE Surgery Task [PSJ PADE SURGERY TASK], was exported as"
^DIC(9.4,77,22,17,"PAH",282,1,48,0)="    a standalone option so that sites can schedule it as a recurring task."
^DIC(9.4,77,22,17,"PAH",282,1,49,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,50,0)="7.  The option, PADE Appointment Task [PSJ PADE APPOINTMENT TASK], was"
^DIC(9.4,77,22,17,"PAH",282,1,51,0)="    exported as a standalone option so that sites can schedule it as a"
^DIC(9.4,77,22,17,"PAH",282,1,52,0)="    recurring task."
^DIC(9.4,77,22,17,"PAH",282,1,53,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,54,0)="8.  Two HL7 application parameters, PSJ VISTA and PSJ PADE SERVER, were"
^DIC(9.4,77,22,17,"PAH",282,1,55,0)="    created for site specific information."
^DIC(9.4,77,22,17,"PAH",282,1,56,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,57,0)="9.  One Logical Link, PSJ PADE, was created to support the Outbound HL7"
^DIC(9.4,77,22,17,"PAH",282,1,58,0)="    messages."
^DIC(9.4,77,22,17,"PAH",282,1,59,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,60,0)="10. The following protocols were created to receive and send outbound"
^DIC(9.4,77,22,17,"PAH",282,1,61,0)="    Admission, Discharge and Transfer (ADT) events:"
^DIC(9.4,77,22,17,"PAH",282,1,62,0)="    PSJ ADT-A01 ROUTER"
^DIC(9.4,77,22,17,"PAH",282,1,63,0)="    PSJ ADT-A01 SERVER - Admission event"
^DIC(9.4,77,22,17,"PAH",282,1,64,0)="    PSJ ADT-A01 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,65,0)="    PSJ ADT-A02 SERVER - Transfer event"
^DIC(9.4,77,22,17,"PAH",282,1,66,0)="    PSJ ADT-A02 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,67,0)="    PSJ ADT-A03 SERVER - Discharge event "
^DIC(9.4,77,22,17,"PAH",282,1,68,0)="    PSJ ADT-A03 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,69,0)="    PSJ ADT-A08 SERVER - Demographic changes"
^DIC(9.4,77,22,17,"PAH",282,1,70,0)="    PSJ ADT-A08 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,71,0)="    PSJ ADT-A11 SERVER - Cancel Admission event"
^DIC(9.4,77,22,17,"PAH",282,1,72,0)="    PSJ ADT-A11 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,73,0)="    PSJ ADT-A12 SERVER - Cancel Transfer event"
^DIC(9.4,77,22,17,"PAH",282,1,74,0)="    PSJ ADT-A12 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,75,0)="    PSJ ADT-A13 SERVER - Cancel Discharge event"
^DIC(9.4,77,22,17,"PAH",282,1,76,0)="    PSJ ADT-A13 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,77,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,78,0)="    PSJ ADT-A01 ROUTER is setup as a subscribing protocol to VAFC ADT-A01 "
^DIC(9.4,77,22,17,"PAH",282,1,79,0)="    SERVER, VAFC ADT-A02 SERVER, VAFC ADT-A03 SERVER, VAFC ADT-A08 SERVER,"
^DIC(9.4,77,22,17,"PAH",282,1,80,0)="    VAFC ADT-A08-TSP SERVER (bed switch), VAFC ADT-A11 SERVER, VAFC"
^DIC(9.4,77,22,17,"PAH",282,1,81,0)="    ADT-A12 SERVER, VAFC ADT-A13 SERVER."
^DIC(9.4,77,22,17,"PAH",282,1,82,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,83,0)="    In the REGISTRATION V. 5.3 package, options like Admit a Patient [DG"
^DIC(9.4,77,22,17,"PAH",282,1,84,0)="    ADMIT PATIENT], Transfer a Patient [DG TRANSFER PATIENT], Discharge a"
^DIC(9.4,77,22,17,"PAH",282,1,85,0)="    Patient [DG DISCHARGE PATIENT], Switch Bed [DG BED SWITCH] etc., will"
^DIC(9.4,77,22,17,"PAH",282,1,86,0)="    trigger appropriate outbound HL7 messages."
^DIC(9.4,77,22,17,"PAH",282,1,87,0)="    The routine tied to protocol PSJ ADT-A01 ROUTER that subscribes to "
^DIC(9.4,77,22,17,"PAH",282,1,88,0)="    these events (VAFC ADT related protocol) will scan the HL7 message and"
^DIC(9.4,77,22,17,"PAH",282,1,89,0)="    will build a modified copy of the HL7  message including the Allergy"
^DIC(9.4,77,22,17,"PAH",282,1,90,0)="    (AL1) and the Observation/Result (OBX) segments. The generated HL7"
^DIC(9.4,77,22,17,"PAH",282,1,91,0)="    message will be sent to the respective PADE via the Vitria Interface"
^DIC(9.4,77,22,17,"PAH",282,1,92,0)="    Engine (VIE)."
^DIC(9.4,77,22,17,"PAH",282,1,93,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,94,0)="11. The following protocols were created to receive and send outbound"
^DIC(9.4,77,22,17,"PAH",282,1,95,0)="    Clinic check-ins and appointments."
^DIC(9.4,77,22,17,"PAH",282,1,96,0)="     PSJ SIU-SDAM ROUTER - subscribing protocol to VAFC ADT-A08-SDAM"
^DIC(9.4,77,22,17,"PAH",282,1,97,0)="     SERVER "
^DIC(9.4,77,22,17,"PAH",282,1,98,0)="     PSJ SIU-S12 SERVER - event driver for clinic check-in "
^DIC(9.4,77,22,17,"PAH",282,1,99,0)="     PSJ SIU-S12 CLIENT - subscriber "
^DIC(9.4,77,22,17,"PAH",282,1,100,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,101,0)="    During patient check-in in the Scheduling V. 5.3 package, the "
^DIC(9.4,77,22,17,"PAH",282,1,102,0)="    protocol, VAFC ADT-A08-SDAM SERVER builds a standard HL7 message."
^DIC(9.4,77,22,17,"PAH",282,1,103,0)="    The routine tied to protocol PSJ SIU-SDAM ROUTER that subscribes"
^DIC(9.4,77,22,17,"PAH",282,1,104,0)="    to the VAFC ADT-A08-SDAM SERVER, will scan the HL7 message and will"
^DIC(9.4,77,22,17,"PAH",282,1,105,0)="    build and modify a copy of the HL7 message including the Allergy (AL1)"
^DIC(9.4,77,22,17,"PAH",282,1,106,0)="    and the Observation/Result (OBX) segments. The generated HL7 message"
^DIC(9.4,77,22,17,"PAH",282,1,107,0)="    will be sent to the respective PADE via the Vitria Interface Engine"
^DIC(9.4,77,22,17,"PAH",282,1,108,0)="    (VIE)."
^DIC(9.4,77,22,17,"PAH",282,1,109,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,110,0)="12. The following protocols were created to send outbound order messages"
^DIC(9.4,77,22,17,"PAH",282,1,111,0)="    in the form of RDE-O11 HL7 messages to the appropriate PADE system."
^DIC(9.4,77,22,17,"PAH",282,1,112,0)="    PSJ RDEO11 SERVER"
^DIC(9.4,77,22,17,"PAH",282,1,113,0)="    PSJ RDEO11 CLIENT"
^DIC(9.4,77,22,17,"PAH",282,1,114,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,115,0)="    In Inpatient Medications, when orders are verified, edited, renewed, "
^DIC(9.4,77,22,17,"PAH",282,1,116,0)="    discontinued, reinstated, put on hold/removed from hold, and when "
^DIC(9.4,77,22,17,"PAH",282,1,117,0)="    orders are discontinued in Computerized Patient Record System (CPRS)"
^DIC(9.4,77,22,17,"PAH",282,1,118,0)="    V. 3.0, an outbound HL7 message will be sent to the respective PADE"
^DIC(9.4,77,22,17,"PAH",282,1,119,0)="    via the Vitria Interface Engine (VIE)."
^DIC(9.4,77,22,17,"PAH",282,1,120,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,121,0)="13. The following protocols were created to receive and process inbound "
^DIC(9.4,77,22,17,"PAH",282,1,122,0)="    PADE Activity (e.g., Dispense, Load, etc.) in the form of"
^DIC(9.4,77,22,17,"PAH",282,1,123,0)="    OMS-O05 HL7 messages:"
^DIC(9.4,77,22,17,"PAH",282,1,124,0)="    PSJ PADE OMS-O05 EVENT"
^DIC(9.4,77,22,17,"PAH",282,1,125,0)="    PSJ PADE OMS-O05 SUB"
^DIC(9.4,77,22,17,"PAH",282,1,126,0)="    PSJ PADE OMS-O05 EVENT 2.3"
^DIC(9.4,77,22,17,"PAH",282,1,127,0)="    PSJ PADE OMS-O05 SUB 2.3"
^DIC(9.4,77,22,17,"PAH",282,1,128,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,129,0)="    Backward compatible HL7 v2.3 protocols accept and parse current "
^DIC(9.4,77,22,17,"PAH",282,1,130,0)="    industry standard Pocket Maintenance (ZPM) segments to facilitate"
^DIC(9.4,77,22,17,"PAH",282,1,131,0)="    transition to the new PADE standard."
^DIC(9.4,77,22,17,"PAH",282,1,132,0)="  "
^DIC(9.4,77,22,17,"PAH",282,1,133,0)="    Inbound HL7 messages from the PADE vendor are validated and filed into"
^DIC(9.4,77,22,17,"PAH",282,1,134,0)="    the PADE INBOUND TRANSACTION file (#58.6), which triggers an "
^DIC(9.4,77,22,17,"PAH",282,1,135,0)="    automatic update of the inventory information in the PADE INVENTORY"
^DIC(9.4,77,22,17,"PAH",282,1,136,0)="    SYSTEM file (#58.601)."
^DIC(9.4,77,22,17,"PAH",282,1,137,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,138,0)=" 14. A new multiple, DWO MESSAGE ENTITY, has been added to the PADE"
^DIC(9.4,77,22,17,"PAH",282,1,139,0)="     INVENTORY SYSTEM file (#58.601) to contain mail groups that will"
^DIC(9.4,77,22,17,"PAH",282,1,140,0)="     receive Mailman messages when PADE drugs are Dispensed Without an"
^DIC(9.4,77,22,17,"PAH",282,1,141,0)="     Order (DWO). "
^DIC(9.4,77,22,17,"PAH",282,1,142,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,143,0)=" 15. A new multiple, CONFIG ERRORS MAIL GROUPS, has been added to the PADE"
^DIC(9.4,77,22,17,"PAH",282,1,144,0)="     INVENTORY SYSTEM file (#58.601) to receive error messages when "
^DIC(9.4,77,22,17,"PAH",282,1,145,0)="     configuration problems are encountered with Inbound PADE HL7"
^DIC(9.4,77,22,17,"PAH",282,1,146,0)="     messages."
^DIC(9.4,77,22,17,"PAH",282,1,147,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,148,0)=" 16. A new multiple, DATA ERRORS MAIL GROUPS, has been added to the PADE "
^DIC(9.4,77,22,17,"PAH",282,1,149,0)="     INVENTORY SYSTEM file (#58.601) to receive error messages when data "
^DIC(9.4,77,22,17,"PAH",282,1,150,0)="     validation problems are encountered with Inbound PADE HL7 messages."
^DIC(9.4,77,22,17,"PAH",282,1,151,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,152,0)=" 17. Inpatient Pharmacy Order Entry screens have been modified to "
^DIC(9.4,77,22,17,"PAH",282,1,153,0)="     display PADE inventory information, specifically:"
^DIC(9.4,77,22,17,"PAH",282,1,154,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,155,0)="     a. The Inpatient Pharmacy Order Entry order detail screens"
^DIC(9.4,77,22,17,"PAH",282,1,156,0)="        will contain a new ""PADE"" column when displaying Dispense Drugs,"
^DIC(9.4,77,22,17,"PAH",282,1,157,0)="        containing the PADE inventory availability for the displayed"
^DIC(9.4,77,22,17,"PAH",282,1,158,0)="        dispense drug. To make room for the PADE inventory information,"
^DIC(9.4,77,22,17,"PAH",282,1,159,0)="        the message field will continue displaying, but drug classes will"
^DIC(9.4,77,22,17,"PAH",282,1,160,0)="        no longer display as a FileMan identifier when a list of dispense"
^DIC(9.4,77,22,17,"PAH",282,1,161,0)="        drug choices are displayed."
^DIC(9.4,77,22,17,"PAH",282,1,162,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,163,0)="     b. The Inpatient Pharmacy Order Entry Patient Profile screen"
^DIC(9.4,77,22,17,"PAH",282,1,164,0)="        includes a flag, (PD), indicating whether or not the order"
^DIC(9.4,77,22,17,"PAH",282,1,165,0)="        contains a drug that is a PADE stock item. If a drug is both a"
^DIC(9.4,77,22,17,"PAH",282,1,166,0)="        PADE item and a Ward Stock item, the ward stock flag (WS) is"
^DIC(9.4,77,22,17,"PAH",282,1,167,0)="        combined with the PADE flag (WP)."
^DIC(9.4,77,22,17,"PAH",282,1,168,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,169,0)=" 18. A Kernel parameter, PSJ PADE OE BALANCES, has been created to allow"
^DIC(9.4,77,22,17,"PAH",282,1,170,0)="     each site to control whether or not PADE inventory information"
^DIC(9.4,77,22,17,"PAH",282,1,171,0)="     displays in the Inpatient Order Entry profile screens and drug"
^DIC(9.4,77,22,17,"PAH",282,1,172,0)="     lookups. A prompt to set the parameter has been added to the new PSJ"
^DIC(9.4,77,22,17,"PAH",282,1,173,0)="     PADE INVENTORY Input Template, accessible via the Inventory System"
^DIC(9.4,77,22,17,"PAH",282,1,174,0)="     Setup [PSJ PADE INVENTORY SYSTEM] option."
^DIC(9.4,77,22,17,"PAH",282,1,175,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,176,0)=" 19. The option, Pick List [PSJU PL], has been modified to include the "
^DIC(9.4,77,22,17,"PAH",282,1,177,0)="     drug Internal Entry Number (IEN) field after the drug name and to"
^DIC(9.4,77,22,17,"PAH",282,1,178,0)="     include the word ""PADE"" if the medication listed is a PADE stock"
^DIC(9.4,77,22,17,"PAH",282,1,179,0)="     item."
^DIC(9.4,77,22,17,"PAH",282,1,180,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,181,0)=" 20. A new Protocol, PSJ LM PADE ACTIVITY, has been added to the PSJ LM "
^DIC(9.4,77,22,17,"PAH",282,1,182,0)="     PROFILE HIDDEN ACTIONS Protocol to display a new hidden action (PD) "
^DIC(9.4,77,22,17,"PAH",282,1,183,0)="     in the Inpatient Pharmacy patient profile screen. The new PD hidden"
^DIC(9.4,77,22,17,"PAH",282,1,184,0)="     action displays all of the PADE transactions for the patient being"
^DIC(9.4,77,22,17,"PAH",282,1,185,0)="     displayed."
^DIC(9.4,77,22,17,"PAH",282,1,186,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,187,0)=" 21. The Pre-Exchange DOSES prompt that displays after verifying an "
^DIC(9.4,77,22,17,"PAH",282,1,188,0)="     Inpatient Unit Dose order has been modified to default the number of "
^DIC(9.4,77,22,17,"PAH",282,1,189,0)="     doses to zero when the drug may be dispensed from PADE, and a message"
^DIC(9.4,77,22,17,"PAH",282,1,190,0)="     is displayed explaining the drug is a PADE item."
^DIC(9.4,77,22,17,"PAH",282,1,191,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,192,0)=" 22. This patch also provides a log file, PADE OUTBOUND MESSAGES "
^DIC(9.4,77,22,17,"PAH",282,1,193,0)="     file (#58.72) of the outbound ADT, SIU and RDE HL7 messages to use "
^DIC(9.4,77,22,17,"PAH",282,1,194,0)="     with FileMan for trouble shooting purposes only."
^DIC(9.4,77,22,17,"PAH",282,1,195,0)="     Note: The nightly background job (PSGBRJ) has been modified to purge "
^DIC(9.4,77,22,17,"PAH",282,1,196,0)="     records older than 30 days."
^DIC(9.4,77,22,17,"PAH",282,1,197,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,198,0)="Note: This patch also exports a post-install routine PSJ317P that will "
^DIC(9.4,77,22,17,"PAH",282,1,199,0)="setup PSJ ADT-A01 ROUTER as a subscribing protocol to VAFC ADT-A01 "
^DIC(9.4,77,22,17,"PAH",282,1,200,0)="SERVER, VAFC ADT-A02 SERVER, VAFC ADT-A03 SERVER, VAFC ADT-A08 SERVER,"
^DIC(9.4,77,22,17,"PAH",282,1,201,0)="VAFC ADT-A08-TSP SERVER, VAFC ADT-A11 SERVER, VAFC ADT-A12 SERVER and VAFC"
^DIC(9.4,77,22,17,"PAH",282,1,202,0)="ADT-A13 SERVER protocols. It will also setup protocol PSJ SIU-SDAM ROUTER"
^DIC(9.4,77,22,17,"PAH",282,1,203,0)="as a subscribing protocol to VAFC ADT-A08-SDAM SERVER protocol. "
^DIC(9.4,77,22,17,"PAH",282,1,204,0)="The post-install also sets the following field to the PSJ PADE entry in "
^DIC(9.4,77,22,17,"PAH",282,1,205,0)="the HL LOGICAL LINK file (#870):"
^DIC(9.4,77,22,17,"PAH",282,1,206,0)="   a. AUTOSTART field (#4.5) is set to 1 (Enabled) so that the PSJ PADE "
^DIC(9.4,77,22,17,"PAH",282,1,207,0)="      logical link will be started automatically when Cache or TaskMan is "
^DIC(9.4,77,22,17,"PAH",282,1,208,0)="      restarted."
^DIC(9.4,77,22,17,"PAH",282,1,209,0)="   b. DO NOT PING field (#24) is set to 1 (Yes) due to the unique aspects"
^DIC(9.4,77,22,17,"PAH",282,1,210,0)="      of the PADE interface. If PSJ PADE is sent an HLO PING CLIENT "
^DIC(9.4,77,22,17,"PAH",282,1,211,0)="      message, an infinite loop will be created consisting of VIE sending"
^DIC(9.4,77,22,17,"PAH",282,1,212,0)="      VistA additional CR messages and VistA not responding. This "
^DIC(9.4,77,22,17,"PAH",282,1,213,0)="      situation requires manual intervention by a member of the VIE"
^DIC(9.4,77,22,17,"PAH",282,1,214,0)="      National Admins team and therefore needs to be avoided."
^DIC(9.4,77,22,17,"PAH",282,1,215,0)=" "
^DIC(9.4,77,22,17,"PAH",282,1,216,0)="This post-install routine will be deleted from your system upon completion"
^DIC(9.4,77,22,17,"PAH",282,1,217,0)="of the patch installation."
^DIC(9.4,77,22,17,"PAH",283,0)="334 SEQ #284^3161118.170115^54"
^DIC(9.4,77,22,17,"PAH",283,1,0)="^^17^17^3161118"
^DIC(9.4,77,22,17,"PAH",283,1,1,0)="Patch PSJ*5.0*334 will correct the exception handling for Duration of"
^DIC(9.4,77,22,17,"PAH",283,1,2,0)="Administration to enforce integer only values. Patch PSJ*5.0*315"
^DIC(9.4,77,22,17,"PAH",283,1,3,0)="introduced code into three routines that prompt for Duration of"
^DIC(9.4,77,22,17,"PAH",283,1,4,0)="Administration.  The code originally blocked the use of non-integer"
^DIC(9.4,77,22,17,"PAH",283,1,5,0)="entries, but other changes to code caused this to stop working, so that"
^DIC(9.4,77,22,17,"PAH",283,1,6,0)="Decimal values can be entered (such as 23.5).  This will not compute"
^DIC(9.4,77,22,17,"PAH",283,1,7,0)="correctly.  Patch PSJ*5.0*334 corrects this by making changes to allow the"
^DIC(9.4,77,22,17,"PAH",283,1,8,0)="code to enforce the integer only requirement."
^DIC(9.4,77,22,17,"PAH",283,1,9,0)=" "
^DIC(9.4,77,22,17,"PAH",283,1,10,0)="NOTE: This patch is a follow-up for patch PSJ*5.0*315 to fix the noted"
^DIC(9.4,77,22,17,"PAH",283,1,11,0)="issue.  However, there is an issue for BCMA which is part of this "
^DIC(9.4,77,22,17,"PAH",283,1,12,0)="enhancement that needs to be noted.  "
^DIC(9.4,77,22,17,"PAH",283,1,13,0)=" "
^DIC(9.4,77,22,17,"PAH",283,1,14,0)="Non-standard schedules such as DAY@HH:MM, HHMM, or other Odd "
^DIC(9.4,77,22,17,"PAH",283,1,15,0)="schedules, are not capable of calculating removal times due to a lack of"
^DIC(9.4,77,22,17,"PAH",283,1,16,0)="Frequency. Regardless of the Prompt for Removal in BCMA code value, they"
^DIC(9.4,77,22,17,"PAH",283,1,17,0)="will not prompt for removal in BCMA and should be avoided."
^DIC(9.4,77,22,17,"PAH",284,0)="328 SEQ #285^3161220.152727^54"
^DIC(9.4,77,22,17,"PAH",284,1,0)="^^4^4^3161220"
^DIC(9.4,77,22,17,"PAH",284,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",284,1,2,0)="1)      One time order appears as active after discharge"
^DIC(9.4,77,22,17,"PAH",284,1,3,0)="2)      Option PSJ EXP gets an error with clinic orders"
^DIC(9.4,77,22,17,"PAH",284,1,4,0)="3)      Mismatch Dosage Warning inconsistent"
^DIC(9.4,77,22,17,"PAH",285,0)="329 SEQ #286^3170106.125724^54"
^DIC(9.4,77,22,17,"PAH",285,1,0)="^^4^4^3170106"
^DIC(9.4,77,22,17,"PAH",285,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",285,1,2,0)="1)  Invalid IV type allowed"
^DIC(9.4,77,22,17,"PAH",285,1,3,0)="2)  Incorrect orderable item displayed after edit"
^DIC(9.4,77,22,17,"PAH",285,1,4,0)="3)  Vista mail shows ""D"" and should be ""DA"" for Auto Discontinue"
^DIC(9.4,77,22,17,"PAH",286,0)="337 SEQ #287^3170123.144626^54"
^DIC(9.4,77,22,17,"PAH",286,1,0)="^^55^55^3170123"
^DIC(9.4,77,22,17,"PAH",286,1,1,0)="Patch PSJ*5.0*337 will correct the following issues discovered with "
^DIC(9.4,77,22,17,"PAH",286,1,2,0)="Pharmacy Interface Automation (PIA) immediately after the release of patch"
^DIC(9.4,77,22,17,"PAH",286,1,3,0)="PSJ*5*317:"
^DIC(9.4,77,22,17,"PAH",286,1,4,0)=" "
^DIC(9.4,77,22,17,"PAH",286,1,5,0)=" 1) This patch addresses an issue with incorrect dosage for orders "
^DIC(9.4,77,22,17,"PAH",286,1,6,0)="    containing more than one dispense drug when one of the dispense drug"
^DIC(9.4,77,22,17,"PAH",286,1,7,0)="    has a concentration or percentage strength. The HL7 interface sends"
^DIC(9.4,77,22,17,"PAH",286,1,8,0)="    one RXC component segment for each dispense drug, and the dosage sent"
^DIC(9.4,77,22,17,"PAH",286,1,9,0)="    on drugs where the strength is a concentration or percentage was found"
^DIC(9.4,77,22,17,"PAH",286,1,10,0)="    to be incorrect. When the strength is a concentration or percentage"
^DIC(9.4,77,22,17,"PAH",286,1,11,0)="    the dosage may be calculated incorrectly; therefore the dosage for"
^DIC(9.4,77,22,17,"PAH",286,1,12,0)="    these components will not be sent in the HL7 interface. For this type"
^DIC(9.4,77,22,17,"PAH",286,1,13,0)="    of order, the nurse dispensing the medication from the cabinet must"
^DIC(9.4,77,22,17,"PAH",286,1,14,0)="    manually verify the dosage for each component."
^DIC(9.4,77,22,17,"PAH",286,1,15,0)=" "
^DIC(9.4,77,22,17,"PAH",286,1,16,0)=" 2) Absent Sick In Hospital (ASIH) transfers were not tested prior to "
^DIC(9.4,77,22,17,"PAH",286,1,17,0)="    the release of patch PSJ*5*317. After the patch was released, Long"
^DIC(9.4,77,22,17,"PAH",286,1,18,0)="    Beach reported that the ""To ASIH"" transfers are showing orders as"
^DIC(9.4,77,22,17,"PAH",286,1,19,0)="    active on the Omnicell server even though they are discontinued in"
^DIC(9.4,77,22,17,"PAH",286,1,20,0)="    VistA. Vendors like Omnicell use the admission pivot number as a"
^DIC(9.4,77,22,17,"PAH",286,1,21,0)="    unique identifier to track orders during their stay in the hospital."
^DIC(9.4,77,22,17,"PAH",286,1,22,0)="    The HL7 message that was generated to discontinue the order was found"
^DIC(9.4,77,22,17,"PAH",286,1,23,0)="    to have a null value or an incorrect pivot number. Hence, Omnicell was"
^DIC(9.4,77,22,17,"PAH",286,1,24,0)="    unable to flag the order as discontinued."
^DIC(9.4,77,22,17,"PAH",286,1,25,0)="    We also tested the ""From ASIH"" transfers, and we found similar issues."
^DIC(9.4,77,22,17,"PAH",286,1,26,0)="    This patch will send the correct pivot number in the HL7 message for"
^DIC(9.4,77,22,17,"PAH",286,1,27,0)="    both (To/From) ASIH transfers so that the vendors can flag the orders"
^DIC(9.4,77,22,17,"PAH",286,1,28,0)="    accordingly."
^DIC(9.4,77,22,17,"PAH",286,1,29,0)=" "
^DIC(9.4,77,22,17,"PAH",286,1,30,0)=" 3) This patch addresses an issue with information missing from the "
^DIC(9.4,77,22,17,"PAH",286,1,31,0)="    PADE OUTBOUND MESSAGES file (#58.72) when the site has multiple vendor"
^DIC(9.4,77,22,17,"PAH",286,1,32,0)="    setups. The first file entry has all the relevant HL7 data, but the "
^DIC(9.4,77,22,17,"PAH",286,1,33,0)="    subsequent file entries are missing Order Number, Order Action, "
^DIC(9.4,77,22,17,"PAH",286,1,34,0)="    appointment and Drug. With this patch, the subsequent file entries"
^DIC(9.4,77,22,17,"PAH",286,1,35,0)="    will have these missing data."
^DIC(9.4,77,22,17,"PAH",286,1,36,0)=" "
^DIC(9.4,77,22,17,"PAH",286,1,37,0)=" 4) This patch addresses an issue with Inpatient Order Entry that results"
^DIC(9.4,77,22,17,"PAH",286,1,38,0)="    in an undefined PSGORD variable error in routine ENDRG+17^PSGOEF1"
^DIC(9.4,77,22,17,"PAH",286,1,39,0)="    when a new (backdoor) order's orderable item is changed prior to"
^DIC(9.4,77,22,17,"PAH",286,1,40,0)="    accepting the order. After the New Order process is initiated in"
^DIC(9.4,77,22,17,"PAH",286,1,41,0)="    Inpatient Order Entry, and all of the order prompts are populated, the"
^DIC(9.4,77,22,17,"PAH",286,1,42,0)="    user is given the option edit the order details prior to accepting the"
^DIC(9.4,77,22,17,"PAH",286,1,43,0)="    order. If the user changes the new unaccepted order's Orderable Item"
^DIC(9.4,77,22,17,"PAH",286,1,44,0)="    to a PADE drug with more than one dispense drug associated with it,"
^DIC(9.4,77,22,17,"PAH",286,1,45,0)="    the following error occurs:"
^DIC(9.4,77,22,17,"PAH",286,1,46,0)="       <UNDEFINED>ENDRG+17^PSGOEF1 *PSGORD "
^DIC(9.4,77,22,17,"PAH",286,1,47,0)="    With this patch, the dispense drug lookup will execute successfully"
^DIC(9.4,77,22,17,"PAH",286,1,48,0)="    when no order number is defined in the PSGORD variable."
^DIC(9.4,77,22,17,"PAH",286,1,49,0)=" "
^DIC(9.4,77,22,17,"PAH",286,1,50,0)=" 5) This patch addresses an issue with the Inpatient Pick List that "
^DIC(9.4,77,22,17,"PAH",286,1,51,0)="    results in an undefined error when no unit dose order is found for the"
^DIC(9.4,77,22,17,"PAH",286,1,52,0)="    drug being processed, the following error occurs:"
^DIC(9.4,77,22,17,"PAH",286,1,53,0)="       <UNDEFINED>DRGSTOCK+10^PSJPADSI *PSJDFLOC "
^DIC(9.4,77,22,17,"PAH",286,1,54,0)="    With this patch, the PADE drug balance lookup will not cause an error"
^DIC(9.4,77,22,17,"PAH",286,1,55,0)="    when no order number is defined."
^DIC(9.4,77,22,17,"PAH",287,0)="331 SEQ #288^3170203.154824^54"
^DIC(9.4,77,22,17,"PAH",287,1,0)="^^6^6^3170203"
^DIC(9.4,77,22,17,"PAH",287,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,77,22,17,"PAH",287,1,2,0)="1) Label for Clinic infusion for Inpatient is printing the ward and "
^DIC(9.4,77,22,17,"PAH",287,1,3,0)="     not the clinic"
^DIC(9.4,77,22,17,"PAH",287,1,4,0)="2) Metric Conversion for Patients Weight consistency"
^DIC(9.4,77,22,17,"PAH",287,1,5,0)="3) Leading zero dropped between CPRS and VistA for IV solution"
^DIC(9.4,77,22,17,"PAH",287,1,6,0)="4) Appending to infusion rate incorrectly"
^DIC(9.4,77,22,17,"PAH",288,0)="325 SEQ #289^3170301.133254^54"
^DIC(9.4,77,22,17,"PAH",288,1,0)="^^181^181^3170301"
^DIC(9.4,77,22,17,"PAH",288,1,1,0)="The PSJ*5.0*325 patch - Display Recently Discontinued IV Orders "
^DIC(9.4,77,22,17,"PAH",288,1,2,0)="modification, will display discontinued IV orders from the Computerized "
^DIC(9.4,77,22,17,"PAH",288,1,3,0)="Patient Record System (CPRS) to a pharmacist when processing an e-signed "
^DIC(9.4,77,22,17,"PAH",288,1,4,0)="CPRS IV order using the VistA option ""Non-Verified/Pending Orders"" [PSJU "
^DIC(9.4,77,22,17,"PAH",288,1,5,0)="VBW]. The discontinued IV orders will display prior to taking action to "
^DIC(9.4,77,22,17,"PAH",288,1,6,0)="finish or edit the pending order. This will allow the pharmacist to pull "
^DIC(9.4,77,22,17,"PAH",288,1,7,0)="IVs that are discontinued and prevent them from being sent to the patient "
^DIC(9.4,77,22,17,"PAH",288,1,8,0)="ward and potentially be given in error. It also allows the pharmacist to "
^DIC(9.4,77,22,17,"PAH",288,1,9,0)="perform a drug-drug interaction check, since recently discontinued "
^DIC(9.4,77,22,17,"PAH",288,1,10,0)="medications can still cause a drug interaction. The pharmacist can delete "
^DIC(9.4,77,22,17,"PAH",288,1,11,0)="the discontinued IV orders from the patient's file when deemed "
^DIC(9.4,77,22,17,"PAH",288,1,12,0)="appropriate."
^DIC(9.4,77,22,17,"PAH",288,1,13,0)=" "
^DIC(9.4,77,22,17,"PAH",288,1,14,0)="Aside from helping to prevent medication errors, this modification also "
^DIC(9.4,77,22,17,"PAH",288,1,15,0)="allows labels to be pulled for IVs that are not yet prepared. This saves "
^DIC(9.4,77,22,17,"PAH",288,1,16,0)="resources; including the drug (especially helpful when drug shortages "
^DIC(9.4,77,22,17,"PAH",288,1,17,0)="occur), and time spent managing pharmacy orders. For IVs that are already "
^DIC(9.4,77,22,17,"PAH",288,1,18,0)="prepared, the modification allows reuse of the prepared bag on another "
^DIC(9.4,77,22,17,"PAH",288,1,19,0)="patient while it is still within the expiration date."
^DIC(9.4,77,22,17,"PAH",288,1,20,0)=" "
^DIC(9.4,77,22,17,"PAH",288,1,21,0)="The NSR for this intake addresses the following requirement:"
^DIC(9.4,77,22,17,"PAH",288,1,22,0)=" "
^DIC(9.4,77,22,17,"PAH",288,1,23,0)="        VHBAO: NEED 497817: View Discontinued Intravenous (IV) Orders:"
^DIC(9.4,77,22,17,"PAH",288,1,24,0)="                            As a pharmacist, I want to view recently"
^DIC(9.4,77,22,17,"PAH",288,1,25,0)="                            discontinued intravenous (IV) orders when I am"
^DIC(9.4,77,22,17,"PAH",288,1,26,0)="                            processing pending orders, so that I save time"
^DIC(9.4,77,22,17,"PAH",288,1,27,0)="                            and medication by not preparing an IV"
^DIC(9.4,77,22,17,"PAH",288,1,28,0)="                            unnecessarily; and can perform drug-drug cross"
^DIC(9.4,77,22,17,"PAH",288,1,29,0)="                            checks against discontinued medication."
^DIC(9.4,77,22,17,"PAH",288,1,30,0)=" "
