^DIC(9.4,4,22,1,"PAH",43,1,558,0)="             $$BSKTNAME  Basket name"
^DIC(9.4,4,22,1,"PAH",43,1,559,0)="             $$NAME      User's name"
^DIC(9.4,4,22,1,"PAH",43,1,560,0)="             $$NETNAME   User's network name"
^DIC(9.4,4,22,1,"PAH",43,1,561,0)="             $$NEWS      Info on new messages in user's mailbox"
