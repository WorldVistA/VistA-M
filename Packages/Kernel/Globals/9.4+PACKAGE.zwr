^DIC(9.4,4,22,1,"PAH",68,0)="98 SEQ #93^2991019^1"
^DIC(9.4,4,22,1,"PAH",68,1,0)="^^62^62^2991019"
^DIC(9.4,4,22,1,"PAH",68,1,1,0)="Patch XM*7.1*98"
^DIC(9.4,4,22,1,"PAH",68,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",68,1,3,0)="NOIS:  ISL-0999-52799"
^DIC(9.4,4,22,1,"PAH",68,1,4,0)="Test Site:  CIOFO-SALT LAKE CITY"
^DIC(9.4,4,22,1,"PAH",68,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",68,1,6,0)="Patch XM*7.1*50 introduced a bug into ENT2^XMD.  It started killing XMSUB."
^DIC(9.4,4,22,1,"PAH",68,1,7,0)="This patch puts a stop to that."
^DIC(9.4,4,22,1,"PAH",68,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",68,1,9,0)="NOIS:  IRO-0999-42186"
^DIC(9.4,4,22,1,"PAH",68,1,10,0)="Test Site:  Iron Mountain, MI"
^DIC(9.4,4,22,1,"PAH",68,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",68,1,12,0)="Patch XM*7.1*50 introduced a bug into WHO^XMA21.  When X is a group name,"
^DIC(9.4,4,22,1,"PAH",68,1,13,0)="XMY only contains the first member of the group.  This patch fixes that,"
^DIC(9.4,4,22,1,"PAH",68,1,14,0)="so that XMY contains all members of the group."
^DIC(9.4,4,22,1,"PAH",68,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",68,1,16,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",68,1,17,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",68,1,18,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",68,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",68,1,20,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",68,1,21,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",68,1,22,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
