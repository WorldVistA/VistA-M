^DIC(9.4,164,22,1,"PAH",133,0)="143 SEQ #134^3100623.164817^17"
^DIC(9.4,164,22,1,"PAH",133,1,0)="^^38^38^3100623"
^DIC(9.4,164,22,1,"PAH",133,1,1,0)="PSS*1.0*143 adds validation checks to the PSS SCHEDULE EDIT option"
^DIC(9.4,164,22,1,"PAH",133,1,2,0)="to prevent the Standard Administration Times and Ward Administration"
^DIC(9.4,164,22,1,"PAH",133,1,3,0)="times fields of a schedule from conflicting with the schedule's"
^DIC(9.4,164,22,1,"PAH",133,1,4,0)="frequency if the frequency is numeric and the schedule type is"
^DIC(9.4,164,22,1,"PAH",133,1,5,0)="Continuous."
^DIC(9.4,164,22,1,"PAH",133,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",133,1,7,0)="1.  Schedule Edit Validation One"
^DIC(9.4,164,22,1,"PAH",133,1,8,0)="The system shall validate for frequencies of 1 day (1440 minutes) or"
^DIC(9.4,164,22,1,"PAH",133,1,9,0)="less that the number of administration times equals 1440 divided by the"
^DIC(9.4,164,22,1,"PAH",133,1,10,0)="frequency."
^DIC(9.4,164,22,1,"PAH",133,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",133,1,12,0)="2.  Schedule Edit Validation Two"
^DIC(9.4,164,22,1,"PAH",133,1,13,0)="The system shall validate for frequencies greater than one day (1440"
^DIC(9.4,164,22,1,"PAH",133,1,14,0)="minutes), that only one administration time is permitted."
^DIC(9.4,164,22,1,"PAH",133,1,15,0)="The system shall present a warning message to the user if more than one"
^DIC(9.4,164,22,1,"PAH",133,1,16,0)="administration time is entered."
^DIC(9.4,164,22,1,"PAH",133,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",133,1,18,0)="3.  Schedule Edit Validation Three"
^DIC(9.4,164,22,1,"PAH",133,1,19,0)="In Ward Administration Times field in the PSS SCHEDULE EDIT option, for"
^DIC(9.4,164,22,1,"PAH",133,1,20,0)="a schedule that has a Schedule Type of Continuous, the system shall"
^DIC(9.4,164,22,1,"PAH",133,1,21,0)="prevent a user from entering administration times to Odd Schedules, a"
^DIC(9.4,164,22,1,"PAH",133,1,22,0)="schedule whose frequency is not evenly divisible by or into 1440"
^DIC(9.4,164,22,1,"PAH",133,1,23,0)="minutes (1 day)."
^DIC(9.4,164,22,1,"PAH",133,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",133,1,25,0)="4.  Schedule Edit Validation Four"
^DIC(9.4,164,22,1,"PAH",133,1,26,0)="Add validation to TYPE OF SCHEDULE field in PSS SCHEDULE EDIT to remove"
^DIC(9.4,164,22,1,"PAH",133,1,27,0)="frequency from the schedule file entry if the TYPE OF SCHEDULE is"
^DIC(9.4,164,22,1,"PAH",133,1,28,0)="changed from CONTINUOUS to ONE TIME, PRN, ON CALL, or DAY OF WEEK."
^DIC(9.4,164,22,1,"PAH",133,1,29,0)=" "
^DIC(9.4,164,22,1,"PAH",133,1,30,0)="5.  Schedule Edit Validation Five"
^DIC(9.4,164,22,1,"PAH",133,1,31,0)="In the PSS SCHEDULE EDIT option, the system shall prevent a user from"
^DIC(9.4,164,22,1,"PAH",133,1,32,0)="creating Day of Week (DOW) schedules that are not in the correct day of"
^DIC(9.4,164,22,1,"PAH",133,1,33,0)="week order.  The correct order is: SU-MO-TU-WE-TH-FR-SA."
^DIC(9.4,164,22,1,"PAH",133,1,34,0)=" "
^DIC(9.4,164,22,1,"PAH",133,1,35,0)="6.  Modify VistA Help Text"
^DIC(9.4,164,22,1,"PAH",133,1,36,0)="The Help Text in Standard Schedule Edit was modified to add additional"
^DIC(9.4,164,22,1,"PAH",133,1,37,0)="text so the user is able to see the added constraints when entering"
^DIC(9.4,164,22,1,"PAH",133,1,38,0)="Administration Times."
^DIC(9.4,164,22,1,"PAH",134,0)="144 SEQ #135^3110127.091135^17"
^DIC(9.4,164,22,1,"PAH",134,1,0)="^^25^25^3110127"
^DIC(9.4,164,22,1,"PAH",134,1,1,0)="This patch will correct the issues reported in:"
^DIC(9.4,164,22,1,"PAH",134,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",134,1,3,0)="1) HD0000000111095 - PSS WARNING BUILDER option fails to respond properly"
^DIC(9.4,164,22,1,"PAH",134,1,4,0)="   When using the VistA ""Warning Builder"" [PSS WARNING BUILDER] option"
^DIC(9.4,164,22,1,"PAH",134,1,5,0)="   and the user enters a ? or ?? for additional help information,"
^DIC(9.4,164,22,1,"PAH",134,1,6,0)="   the program returns very little help information."
^DIC(9.4,164,22,1,"PAH",134,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",134,1,8,0)="2) HD0000000133036 - Drug Synonym triggers are inconsistent"
^DIC(9.4,164,22,1,"PAH",134,1,9,0)="   Drug Synonym triggers are inconsistent with those on the drug level."
^DIC(9.4,164,22,1,"PAH",134,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",134,1,11,0)="3) HD0000000324175 - 6 Enter/Edit Dosages"
^DIC(9.4,164,22,1,"PAH",134,1,12,0)="   In the ""Enter/Edit Dosages"" option in Pharmacy Data Management, there"
^DIC(9.4,164,22,1,"PAH",134,1,13,0)="   is a problem with the BCMA UNITS PER DOSE prompt when editing a"
^DIC(9.4,164,22,1,"PAH",134,1,14,0)="   Possible Dosage. The BCMA UNITS PER DOSE prompt should only be given"
^DIC(9.4,164,22,1,"PAH",134,1,15,0)="   if the Possible Dosage Package field  is marked for Inpatient (""I""),"
^DIC(9.4,164,22,1,"PAH",134,1,16,0)="   and the Application Packages Use field for the drug contains a ""I"" or"
^DIC(9.4,164,22,1,"PAH",134,1,17,0)="   ""U"".  Currently the prompt appears twice if the Possible Dosage Package"
^DIC(9.4,164,22,1,"PAH",134,1,18,0)="   and Drug is marked for Inpatient, (and it should only appear once)."
^DIC(9.4,164,22,1,"PAH",134,1,19,0)="   When the drug is not marked Inpatient, The prompt appears only once"
^DIC(9.4,164,22,1,"PAH",134,1,20,0)="   when it should not appear at all."
^DIC(9.4,164,22,1,"PAH",134,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",134,1,22,0)="4) HD0000000157266 - Synonym DUOU field does not allow for input of "
^DIC(9.4,164,22,1,"PAH",134,1,23,0)="                     decimal"
^DIC(9.4,164,22,1,"PAH",134,1,24,0)="  The input template for DISPENSE UNITS PER ORDER UNIT (^DD(50,15)) "
^DIC(9.4,164,22,1,"PAH",134,1,25,0)="  allows for the input of decimal values (e.g. 2.5)."
^DIC(9.4,164,22,1,"PAH",135,0)="157 SEQ #136^3110210.144616^17"
^DIC(9.4,164,22,1,"PAH",135,1,0)="^^41^41^3110210"
^DIC(9.4,164,22,1,"PAH",135,1,1,0)="This patch corrects a defect introduced by patch PSS*1*143 in the"
^DIC(9.4,164,22,1,"PAH",135,1,2,0)="Standard Schedule Edit [PSS SCHEDULE EDIT] option."
^DIC(9.4,164,22,1,"PAH",135,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,5,0)="HD0000000419996 -  Admin times cannot be deleted from PRN schedules"
^DIC(9.4,164,22,1,"PAH",135,1,6,0)="via the Schedule Enter/Edit [PSS SCHEDULE EDIT] option."
^DIC(9.4,164,22,1,"PAH",135,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,8,0)="Remedy Overview"
^DIC(9.4,164,22,1,"PAH",135,1,9,0)="---------------"
^DIC(9.4,164,22,1,"PAH",135,1,10,0)="HD0000000419996"
^DIC(9.4,164,22,1,"PAH",135,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,12,0)="Problem:"
^DIC(9.4,164,22,1,"PAH",135,1,13,0)="---------"
^DIC(9.4,164,22,1,"PAH",135,1,14,0)="Patch PSS*1*143 changed the Standard Schedule Edit [PSS SCHEDULE EDIT]"
^DIC(9.4,164,22,1,"PAH",135,1,15,0)="option to prevent the prompt for Admin Time from displaying when the"
^DIC(9.4,164,22,1,"PAH",135,1,16,0)="schedule's Type is PRN, making it difficult to remove the admin times"
^DIC(9.4,164,22,1,"PAH",135,1,17,0)="from existing PRN schedules. When the schedule type of an existing"
^DIC(9.4,164,22,1,"PAH",135,1,18,0)="schedule is changed from Continuous to PRN, the admin times are removed,"
^DIC(9.4,164,22,1,"PAH",135,1,19,0)="however, when an existing schedule with a schedule type of PRN is edited,"
^DIC(9.4,164,22,1,"PAH",135,1,20,0)="the admin times are not removed."
^DIC(9.4,164,22,1,"PAH",135,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,22,0)="In addition, an inconsistency exists within the same option: at the"
^DIC(9.4,164,22,1,"PAH",135,1,23,0)="initial prompt for Schedule Type, entering or accepting a default of"
^DIC(9.4,164,22,1,"PAH",135,1,24,0)="""PRN"", has no affect on the value of admin times."
^DIC(9.4,164,22,1,"PAH",135,1,25,0)="However, after pressing Enter or Return to exit the Schedule Type"
^DIC(9.4,164,22,1,"PAH",135,1,26,0)="prompt, if an up-arrow, or caret ""^"", is used to return to the Schedule"
^DIC(9.4,164,22,1,"PAH",135,1,27,0)="Type field, then entering ""PRN"" or accepting the default of ""PRN"" the"
^DIC(9.4,164,22,1,"PAH",135,1,28,0)="second time the prompt is displayed does delete the admin times from the"
^DIC(9.4,164,22,1,"PAH",135,1,29,0)="schedule."
^DIC(9.4,164,22,1,"PAH",135,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,31,0)="Solution:"
^DIC(9.4,164,22,1,"PAH",135,1,32,0)="----------"
^DIC(9.4,164,22,1,"PAH",135,1,33,0)="Change the Standard Schedule Edit [PSS SCHEDULE EDIT] option to delete"
^DIC(9.4,164,22,1,"PAH",135,1,34,0)="admin times from the schedule anytime ""PRN"" is entered, or accepted as a"
^DIC(9.4,164,22,1,"PAH",135,1,35,0)="default, at the Schedule Type field. For existing PRN schedules, admin"
^DIC(9.4,164,22,1,"PAH",135,1,36,0)="times may be deleted by re-entering ""PRN"", or accepting the default value"
^DIC(9.4,164,22,1,"PAH",135,1,37,0)="""PRN"", at the prompt for Schedule Type."
^DIC(9.4,164,22,1,"PAH",135,1,38,0)=" "
^DIC(9.4,164,22,1,"PAH",135,1,39,0)="Change the same option to make the Schedule Type prompt to have the same"
^DIC(9.4,164,22,1,"PAH",135,1,40,0)="effect on the schedule's admin times for the initial and all subsequent"
^DIC(9.4,164,22,1,"PAH",135,1,41,0)="prompts."
^DIC(9.4,164,22,1,"PAH",136,0)="151^3110308.135103^17"
^DIC(9.4,164,22,1,"PAH",136,1,0)="^^29^29^3110308"
^DIC(9.4,164,22,1,"PAH",136,1,1,0)="This patch is part of a set of patches that make up Pharmacy"
^DIC(9.4,164,22,1,"PAH",136,1,2,0)="Re-engineering version 0.5. Version 0.5 will replace the current"
^DIC(9.4,164,22,1,"PAH",136,1,3,0)="medication order checking system with a new system that uses data from"
^DIC(9.4,164,22,1,"PAH",136,1,4,0)="First DataBank (FDB). In addition to replacing the current Drug"
^DIC(9.4,164,22,1,"PAH",136,1,5,0)="Interaction and Duplicate Class checks with the FDB equivalent of these"
^DIC(9.4,164,22,1,"PAH",136,1,6,0)="checks, Maximum Single Dose and Daily Dose Range Checks will now also"
^DIC(9.4,164,22,1,"PAH",136,1,7,0)="occur in Outpatient Pharmacy, Inpatient Medications, and Computerized"
^DIC(9.4,164,22,1,"PAH",136,1,8,0)="Patient Record System (CPRS)."
^DIC(9.4,164,22,1,"PAH",136,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,11,0)="This patch addresses the following New Service Request (NSR):"
^DIC(9.4,164,22,1,"PAH",136,1,12,0)="-------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",136,1,13,0)="There is no NSR associated with this patch. "
^DIC(9.4,164,22,1,"PAH",136,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,16,0)="This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",136,1,17,0)="----------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",136,1,18,0)="There are no Remedy tickets associated with this patch."
^DIC(9.4,164,22,1,"PAH",136,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,21,0)="Overview of Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",136,1,22,0)="-----------------------------"
^DIC(9.4,164,22,1,"PAH",136,1,23,0)="There are no Remedy tickets associated with this patch. "
^DIC(9.4,164,22,1,"PAH",136,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,26,0)="Components Exported With Patch: "
^DIC(9.4,164,22,1,"PAH",136,1,27,0)="-------------------------------"
^DIC(9.4,164,22,1,"PAH",136,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",136,1,29,0)="See the National Patch Module for specifics relating to this patch."
^DIC(9.4,164,22,1,"PAH",137,0)="142^3110308.135132^17"
^DIC(9.4,164,22,1,"PAH",137,1,0)="^^24^24^3110308"
^DIC(9.4,164,22,1,"PAH",137,1,1,0)=" "
^DIC(9.4,164,22,1,"PAH",137,1,2,0)="This enhancement is an interim resolution approved by the Inpatient"
^DIC(9.4,164,22,1,"PAH",137,1,3,0)="Medications Workgroup for Patient Safety Issue PSI 08-025, PSPO #852"
^DIC(9.4,164,22,1,"PAH",137,1,4,0)="as described in Remedy Ticket HD233682.  This patch will help resolve"
^DIC(9.4,164,22,1,"PAH",137,1,5,0)="incorrect medication routes being displayed for selection in the"
^DIC(9.4,164,22,1,"PAH",137,1,6,0)="Computerized Patient Record System (CPRS)."
^DIC(9.4,164,22,1,"PAH",137,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",137,1,8,0)="Problem:"
^DIC(9.4,164,22,1,"PAH",137,1,9,0)="--------"
^DIC(9.4,164,22,1,"PAH",137,1,10,0)="Currently, for IV orders, if there is more than one orderable item on the"
^DIC(9.4,164,22,1,"PAH",137,1,11,0)="order, no default medication route is being denoted as a default in the"
^DIC(9.4,164,22,1,"PAH",137,1,12,0)="CPRS selection list even if all the orderable items on the order share"
^DIC(9.4,164,22,1,"PAH",137,1,13,0)="the same default med route."
^DIC(9.4,164,22,1,"PAH",137,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",137,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",137,1,16,0)="Resolution:"
^DIC(9.4,164,22,1,"PAH",137,1,17,0)="-----------"
^DIC(9.4,164,22,1,"PAH",137,1,18,0)="This enhancement for IV orders will denote the default med route in the"
^DIC(9.4,164,22,1,"PAH",137,1,19,0)="selection list in CPRS if all of the orderable items on the order have"
^DIC(9.4,164,22,1,"PAH",137,1,20,0)="the same default med route defined.  If one or more orderable items on"
^DIC(9.4,164,22,1,"PAH",137,1,21,0)="the order have different default med routes, the current functionality"
^DIC(9.4,164,22,1,"PAH",137,1,22,0)="will be retained, and no med route in the selection list for CPRS will be"
^DIC(9.4,164,22,1,"PAH",137,1,23,0)="denoted as a default.  Routine PSSJORDF will be modified for this"
^DIC(9.4,164,22,1,"PAH",137,1,24,0)="enhancement."
^DIC(9.4,164,22,1,"PAH",138,0)="153 SEQ #139^3110331.165114^17"
^DIC(9.4,164,22,1,"PAH",138,1,0)="^^30^30^3110331"
^DIC(9.4,164,22,1,"PAH",138,1,1,0)="This patch is being released in preparation for the medication routes"
^DIC(9.4,164,22,1,"PAH",138,1,2,0)="enhancement patch PSS*1*159. This patch contains the following:"
^DIC(9.4,164,22,1,"PAH",138,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",138,1,4,0)=" - The MED ROUTE field (#.06) of the PHARMACY ORDERABLE ITEM file (#50.7)"
^DIC(9.4,164,22,1,"PAH",138,1,5,0)="   is renamed DEFAULT MED ROUTE."
^DIC(9.4,164,22,1,"PAH",138,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",138,1,7,0)=" - The POSSIBLE MED ROUTES multiple (#50.711) is added to the PHARMACY"
^DIC(9.4,164,22,1,"PAH",138,1,8,0)="   ORDERABLE ITEM file (#50.7). This multiple is pointing to the"
^DIC(9.4,164,22,1,"PAH",138,1,9,0)="   MEDICATION ROUTES file (#51.2)."
^DIC(9.4,164,22,1,"PAH",138,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",138,1,11,0)=" - The USE DOSAGE FORM MED ROUTE LIST field (#10) is added to the PHARMACY"
^DIC(9.4,164,22,1,"PAH",138,1,12,0)="   ORDERABLE ITEM file (#50.7) with YES/NO values."
^DIC(9.4,164,22,1,"PAH",138,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",138,1,14,0)="The above fields will be available when editing an existing or adding a "
^DIC(9.4,164,22,1,"PAH",138,1,15,0)="new orderable item using the following options:"
^DIC(9.4,164,22,1,"PAH",138,1,16,0)="  - Edit Orderable Items [PSS EDIT ORDERABLE ITEMS]"
^DIC(9.4,164,22,1,"PAH",138,1,17,0)="  - Drug Enter/Edit [PSS DRUG ENTER/EDIT"
^DIC(9.4,164,22,1,"PAH",138,1,18,0)="  - Dispense Drug/Orderable Item Maintenance [PSS MAINTAIN ORDERABLE"
^DIC(9.4,164,22,1,"PAH",138,1,19,0)="    ITEMS]"
^DIC(9.4,164,22,1,"PAH",138,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",138,1,21,0)="The Default Med Route For OI Report [PSS DEF MED ROUTE OI RPT] option"
^DIC(9.4,164,22,1,"PAH",138,1,22,0)="is modified to include printing of the POSSIBLE MED ROUTES multiple."
^DIC(9.4,164,22,1,"PAH",138,1,23,0)=" "
^DIC(9.4,164,22,1,"PAH",138,1,24,0)="In addition, a post install routine will run to update the USE DOSAGE"
^DIC(9.4,164,22,1,"PAH",138,1,25,0)="FORM MED ROUTE LIST field (#10) based on the value of the DEFAULT MED"
^DIC(9.4,164,22,1,"PAH",138,1,26,0)="ROUTE FOR CPRS field (#80.7) of the PHARMACY SYSTEM file (#59.7). The"
^DIC(9.4,164,22,1,"PAH",138,1,27,0)="USE DOSAGE FORM MED ROUTE LIST field (#10) will be exported with ""YES"""
^DIC(9.4,164,22,1,"PAH",138,1,28,0)="for sites that have the DEFAULT MED ROUTE FOR CPRS field (#80.7) set to"
^DIC(9.4,164,22,1,"PAH",138,1,29,0)="NO. Otherwise, the USE DOSAGE FORM MED ROUTE LIST field (#10) will be "
^DIC(9.4,164,22,1,"PAH",138,1,30,0)="set to NO."
^DIC(9.4,164,22,1,"PAH",139,0)="136^3110428.155928^17"
^DIC(9.4,164,22,1,"PAH",139,1,0)="^^3^3^3110428"
^DIC(9.4,164,22,1,"PAH",139,1,1,0)=" "
^DIC(9.4,164,22,1,"PAH",139,1,2,0)="This is the package that holds the routines responsible for the pharmacy "
^DIC(9.4,164,22,1,"PAH",139,1,3,0)="XML interface for drug order checks from First DataBank."
^DIC(9.4,164,22,1,"PAH",140,0)="117 SEQ #141^3110428.160556^17"
^DIC(9.4,164,22,1,"PAH",140,1,0)="^^60^60^3110428"
^DIC(9.4,164,22,1,"PAH",140,1,1,0)="This patch is part of a set of patches that make up Pharmacy"
^DIC(9.4,164,22,1,"PAH",140,1,2,0)="Re-engineering version 0.5. Version 0.5 will replace the current"
^DIC(9.4,164,22,1,"PAH",140,1,3,0)="medication order checking system with a new system that uses data from"
^DIC(9.4,164,22,1,"PAH",140,1,4,0)="First DataBank (FDB). In addition to replacing the current Drug"
^DIC(9.4,164,22,1,"PAH",140,1,5,0)="Interaction and Duplicate Class checks with the FDB equivalent of these"
^DIC(9.4,164,22,1,"PAH",140,1,6,0)="checks, Maximum Single Dose and Daily Dose Range Checks will now also"
^DIC(9.4,164,22,1,"PAH",140,1,7,0)="occur in Outpatient Pharmacy, Inpatient Medications, and Computerized"
^DIC(9.4,164,22,1,"PAH",140,1,8,0)="Patient Record System (CPRS)."
^DIC(9.4,164,22,1,"PAH",140,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,11,0)="This patch addresses the following New Service Request (NSR):"
^DIC(9.4,164,22,1,"PAH",140,1,12,0)="-------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",140,1,13,0)="There is no NSR associated with this patch. "
^DIC(9.4,164,22,1,"PAH",140,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,16,0)="This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",140,1,17,0)="----------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",140,1,18,0)="There are no Remedy tickets associated with this patch."
^DIC(9.4,164,22,1,"PAH",140,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,21,0)="Overview of Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",140,1,22,0)="-----------------------------"
^DIC(9.4,164,22,1,"PAH",140,1,23,0)="There are no Remedy tickets associated with this patch. "
^DIC(9.4,164,22,1,"PAH",140,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,26,0)="Components Exported With Patch: "
^DIC(9.4,164,22,1,"PAH",140,1,27,0)="-------------------------------"
^DIC(9.4,164,22,1,"PAH",140,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,29,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,30,0)="The following is a list of fields included in this patch:"
^DIC(9.4,164,22,1,"PAH",140,1,31,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,32,0)="Field Name                 (Number)     File Name             (Number)"
^DIC(9.4,164,22,1,"PAH",140,1,33,0)="-----------------------------------     ------------------------------"
^DIC(9.4,164,22,1,"PAH",140,1,34,0)="DISPLAY STATUS                  157     IV Subfile               55.01"
^DIC(9.4,164,22,1,"PAH",140,1,35,0)="                                        of PHARMACY PATIENT         55"
^DIC(9.4,164,22,1,"PAH",140,1,36,0)="DISPLAY STATUS                  136     UNIT DOSE Subfile        55.06"
^DIC(9.4,164,22,1,"PAH",140,1,37,0)="                                        of PHARMACY PATIENT         55"
^DIC(9.4,164,22,1,"PAH",140,1,38,0)="HOURS OF RECENTLY DC/EXPIRED   26.8     PHARMACY SYSTEM           59.7"
^DIC(9.4,164,22,1,"PAH",140,1,39,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,40,0)=" "
^DIC(9.4,164,22,1,"PAH",140,1,41,0)="The following is a list of options exported in this patch:"
^DIC(9.4,164,22,1,"PAH",140,1,42,0)=" "
