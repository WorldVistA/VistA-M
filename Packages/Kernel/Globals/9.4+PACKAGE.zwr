^DIC(9.4,4,22,1,"PAH",147,1,39,0)="XMXSEC     23410717   23318832   50,110,127,177"
^DIC(9.4,4,22,1,"PAH",147,1,40,0)="XMXSEND    11097083   10382185   50,106,107,116,168,177"
