^DIC(9.4,3,22,21,"PAH",164,0)="169 SEQ #171^3010802^1"
^DIC(9.4,3,22,21,"PAH",164,1,0)="^^86^86^3010802"
^DIC(9.4,3,22,21,"PAH",164,1,1,0)="ALX-0500-70393   XUTMRP, XUTMRP1"
^DIC(9.4,3,22,21,"PAH",164,1,2,0)="When the DEVICE name and $I were changed with tasks still queued to the"
^DIC(9.4,3,22,21,"PAH",164,1,3,0)="old DEVICE name, (XUTM REPNT) option could not find the old device name"
^DIC(9.4,3,22,21,"PAH",164,1,4,0)="and would cause an <UNDEFINED> error in XUTMRP1.  Now, even if the DEVICE"
^DIC(9.4,3,22,21,"PAH",164,1,5,0)="name was removed or changed, the option will still work"
^DIC(9.4,3,22,21,"PAH",164,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,7,0)="E3R 14749  "
^DIC(9.4,3,22,21,"PAH",164,1,8,0)="The ""Person Class"" and ""Has E-SIG"" and ""Write Med's"" were added to the print "
^DIC(9.4,3,22,21,"PAH",164,1,9,0)="template [XUSERINQ] for this option ""XUSERINQ"".  The KEYS HELD list was changed "
^DIC(9.4,3,22,21,"PAH",164,1,10,0)="to add more space and see that entries don't run off the side of the page. Added "
^DIC(9.4,3,22,21,"PAH",164,1,11,0)="some CPRS parameter info .Added a list of the Mailman info (Last use, mail "
^DIC(9.4,3,22,21,"PAH",164,1,12,0)="groups). Compiled print template XUCT01 will be rebuilt. The Person "
^DIC(9.4,3,22,21,"PAH",164,1,13,0)="Class was also added to routine XQUSR."
^DIC(9.4,3,22,21,"PAH",164,1,14,0)="Added a question to the Terminate User option to show the User Inquiry."
^DIC(9.4,3,22,21,"PAH",164,1,15,0)="(XUSTERM)"
^DIC(9.4,3,22,21,"PAH",164,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,17,0)="MON-0800-50494, DUB-0900-31169, CML-0500-40711  XUTMQ"
^DIC(9.4,3,22,21,"PAH",164,1,18,0)="The future task list was not showing up.  Corrected the global reference"
^DIC(9.4,3,22,21,"PAH",164,1,19,0)="that it was using."
^DIC(9.4,3,22,21,"PAH",164,1,20,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,21,0)="XUTMK"
^DIC(9.4,3,22,21,"PAH",164,1,22,0)="From a question from NVS, Fixed a problem that caused this routine not to "
^DIC(9.4,3,22,21,"PAH",164,1,23,0)="clean-up Taskman monitor data in the %ZTSCH global."
^DIC(9.4,3,22,21,"PAH",164,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,25,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,26,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",164,1,27,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",164,1,28,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",164,1,29,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",164,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,31,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",164,1,32,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",164,1,33,0)="XQUSR         5053391   4960998    **169**"
^DIC(9.4,3,22,21,"PAH",164,1,34,0)="XUSER1            n/a   1428663    **169**"
^DIC(9.4,3,22,21,"PAH",164,1,35,0)="XUSTERM      13933270  14433091    **36,73,135,148,169**"
^DIC(9.4,3,22,21,"PAH",164,1,36,0)="XUTMK         7364498   8630418    **49,67,118,169**"
^DIC(9.4,3,22,21,"PAH",164,1,37,0)="XUTMQ         8186969   8210432    **20,136,169**"
^DIC(9.4,3,22,21,"PAH",164,1,38,0)="XUTMRP       15577050  13191393    **2,20,86,120,169**"
^DIC(9.4,3,22,21,"PAH",164,1,39,0)="XUTMRP1       7184681   5994786    **2,86,120,169**"
^DIC(9.4,3,22,21,"PAH",164,1,40,0)="XUTMTP       10473436  10842367    **20,86,169**"
^DIC(9.4,3,22,21,"PAH",164,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,42,0)="List of preceding patches: 118, 120, 136, 148"
^DIC(9.4,3,22,21,"PAH",164,1,43,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",164,1,44,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,45,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",164,1,46,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",164,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,48,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",164,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,50,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",164,1,51,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",164,1,52,0)="     "
^DIC(9.4,3,22,21,"PAH",164,1,53,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",164,1,54,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",164,1,55,0)="     "
^DIC(9.4,3,22,21,"PAH",164,1,56,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",164,1,57,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",164,1,58,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",164,1,59,0)="      options:"
^DIC(9.4,3,22,21,"PAH",164,1,60,0)="      "
^DIC(9.4,3,22,21,"PAH",164,1,61,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",164,1,62,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",164,1,63,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",164,1,64,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",164,1,65,0)="     "
^DIC(9.4,3,22,21,"PAH",164,1,66,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",164,1,67,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",164,1,68,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",164,1,69,0)="      TASKMAN and Background tasks can remain running."
^DIC(9.4,3,22,21,"PAH",164,1,70,0)=""
^DIC(9.4,3,22,21,"PAH",164,1,71,0)="     "
^DIC(9.4,3,22,21,"PAH",164,1,72,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",164,1,73,0)="      option:"
^DIC(9.4,3,22,21,"PAH",164,1,74,0)="        Install Package(s)  'XU*8.0*169'"
^DIC(9.4,3,22,21,"PAH",164,1,75,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",164,1,76,0)="         "
^DIC(9.4,3,22,21,"PAH",164,1,77,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",164,1,78,0)="        "
^DIC(9.4,3,22,21,"PAH",164,1,79,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",164,1,80,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",164,1,81,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",164,1,82,0)="     "
^DIC(9.4,3,22,21,"PAH",164,1,83,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",164,1,84,0)="  "
^DIC(9.4,3,22,21,"PAH",164,1,85,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",164,1,86,0)=""
^DIC(9.4,3,22,21,"PAH",165,0)="192 SEQ #172^3010802^1"
^DIC(9.4,3,22,21,"PAH",165,1,0)="^^81^81^3010802"
^DIC(9.4,3,22,21,"PAH",165,1,1,0)="NOIS: ISB-0201-31135"
^DIC(9.4,3,22,21,"PAH",165,1,2,0)="In the code for REQ^%ZTLOAD the new schedule time is put in the wrong"
^DIC(9.4,3,22,21,"PAH",165,1,3,0)="piece of the TASK. The code which puts the time in the task record was"
^DIC(9.4,3,22,21,"PAH",165,1,4,0)="not found at REQ^%ZTLOAD. The code at REQ^%ZTLOAD transfers control to"
^DIC(9.4,3,22,21,"PAH",165,1,5,0)="%ZTLOAD3 which then contains the code being fixed. The 5th piece of"
^DIC(9.4,3,22,21,"PAH",165,1,6,0)="^%ZTSK(ztsk,0) was set when piece 6 should have been set.  "
^DIC(9.4,3,22,21,"PAH",165,1,7,0)="Also the original create $H is moved to a new field (#16) and the $H"
^DIC(9.4,3,22,21,"PAH",165,1,8,0)="at the time of requeueing is set into the 5th piece. "
^DIC(9.4,3,22,21,"PAH",165,1,9,0)="This patch fixes this problem."
^DIC(9.4,3,22,21,"PAH",165,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",165,1,11,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",165,1,12,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",165,1,13,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",165,1,14,0)=" ;;8.0;KERNEL;<patchlist>;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",165,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",165,1,16,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",165,1,17,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",165,1,18,0)="ZTLOAD3       4046069   4541001    **67,127,136,192**"
^DIC(9.4,3,22,21,"PAH",165,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",165,1,20,0)="List of preceding patches: 136"
^DIC(9.4,3,22,21,"PAH",165,1,21,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",165,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",165,1,23,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",165,1,24,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",165,1,25,0)=" "
^DIC(9.4,3,22,21,"PAH",165,1,26,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",165,1,27,0)=">>>TaskMan does not need to be stopped."
^DIC(9.4,3,22,21,"PAH",165,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",165,1,29,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",165,1,30,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",165,1,31,0)="     "
^DIC(9.4,3,22,21,"PAH",165,1,32,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",165,1,33,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",165,1,34,0)="     "
^DIC(9.4,3,22,21,"PAH",165,1,35,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",165,1,36,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",165,1,37,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",165,1,38,0)="      options:"
^DIC(9.4,3,22,21,"PAH",165,1,39,0)="      "
^DIC(9.4,3,22,21,"PAH",165,1,40,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",165,1,41,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",165,1,42,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",165,1,43,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",165,1,44,0)="     "
^DIC(9.4,3,22,21,"PAH",165,1,45,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",165,1,46,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",165,1,47,0)="      This patch cannot be queued."
^DIC(9.4,3,22,21,"PAH",165,1,48,0)="    **There is a slight chance that a job (User or TaskMan) could access"
^DIC(9.4,3,22,21,"PAH",165,1,49,0)="      this routine and get some CLOBER/NOSOURCE errors."
^DIC(9.4,3,22,21,"PAH",165,1,50,0)="      If this isn't acceptable then see that all jobs on the system are"
^DIC(9.4,3,22,21,"PAH",165,1,51,0)="      stopped before installing this patch."
^DIC(9.4,3,22,21,"PAH",165,1,52,0)="   "
^DIC(9.4,3,22,21,"PAH",165,1,53,0)="  5.  In Programmer mode:"
^DIC(9.4,3,22,21,"PAH",165,1,54,0)="      Use ""D ^XPDKRN"" then"
^DIC(9.4,3,22,21,"PAH",165,1,55,0)="         Install Package(s)  'XU*8.0*192'"
^DIC(9.4,3,22,21,"PAH",165,1,56,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",165,1,57,0)="                              "
^DIC(9.4,3,22,21,"PAH",165,1,58,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO "
^DIC(9.4,3,22,21,"PAH",165,1,59,0)="        "
^DIC(9.4,3,22,21,"PAH",165,1,60,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",165,1,61,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",165,1,62,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",165,1,63,0)="      "
^DIC(9.4,3,22,21,"PAH",165,1,64,0)="  6.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",165,1,65,0)="      Cache Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",165,1,66,0)="      DSM/MSM sites - you need to move the following routine from "
^DIC(9.4,3,22,21,"PAH",165,1,67,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",165,1,68,0)="      "
^DIC(9.4,3,22,21,"PAH",165,1,69,0)="      ZTLOAD3"
^DIC(9.4,3,22,21,"PAH",165,1,70,0)="      "
^DIC(9.4,3,22,21,"PAH",165,1,71,0)="  7.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",165,1,72,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",165,1,73,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",165,1,74,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",165,1,75,0)="      Patch number to load: 192"
^DIC(9.4,3,22,21,"PAH",165,1,76,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",165,1,77,0)="       "
^DIC(9.4,3,22,21,"PAH",165,1,78,0)=" 8.   DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",165,1,79,0)="  "
^DIC(9.4,3,22,21,"PAH",165,1,80,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",165,1,81,0)=""
^DIC(9.4,3,22,21,"PAH",166,0)="197 SEQ #173^3010802^1"
^DIC(9.4,3,22,21,"PAH",166,1,0)="^^77^77^3010802"
^DIC(9.4,3,22,21,"PAH",166,1,1,0)="This patch is being released by Capacity Management (CM) for installation"
^DIC(9.4,3,22,21,"PAH",166,1,2,0)="of modifications to the ^%ZOSVK* collection routines that are used by the"
^DIC(9.4,3,22,21,"PAH",166,1,3,0)="Statistical Analysis of Global Growth (SAGG) Version 1.8 software package."
^DIC(9.4,3,22,21,"PAH",166,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,5,0)="All DSM and OpenM-NT (Cache) sites are instructed to install this patch."
^DIC(9.4,3,22,21,"PAH",166,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,7,0)="This patch makes modifications to the ^%ZOSVK* collection routines that"
^DIC(9.4,3,22,21,"PAH",166,1,8,0)="are used by the SAGG software package."
^DIC(9.4,3,22,21,"PAH",166,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,10,0)="This patch removes the MSM versions of the collection routines (ZOSVKSME"
^DIC(9.4,3,22,21,"PAH",166,1,11,0)="and ZOSVKSMS) from the production environment."
^DIC(9.4,3,22,21,"PAH",166,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,13,0)="Provided that the 'SAGG Master Background Task' [KMPS SAGG REPORT] is not"
^DIC(9.4,3,22,21,"PAH",166,1,14,0)="currently running, this installation can be performed at any time of the"
^DIC(9.4,3,22,21,"PAH",166,1,15,0)="day with minimal disruption to users.  Installation should not take longer"
^DIC(9.4,3,22,21,"PAH",166,1,16,0)="than 10-15 minutes."
^DIC(9.4,3,22,21,"PAH",166,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,18,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",166,1,19,0)="============"
^DIC(9.4,3,22,21,"PAH",166,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,21,0)="  1.   You will need to disable any routines within the %ZOSVK* namespace."
^DIC(9.4,3,22,21,"PAH",166,1,22,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,23,0)="  2.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,3,22,21,"PAH",166,1,24,0)="       option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",166,1,25,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,26,0)="  3.   The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",166,1,27,0)="       system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",166,1,28,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",166,1,29,0)="       options:"
^DIC(9.4,3,22,21,"PAH",166,1,30,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,31,0)="          Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",166,1,32,0)="          Print Transport Global"
^DIC(9.4,3,22,21,"PAH",166,1,33,0)="          Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",166,1,34,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",166,1,35,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,36,0)="   4.  You do not need to inhibit users from login into the system."
^DIC(9.4,3,22,21,"PAH",166,1,37,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,38,0)="   5.  Ensure that the 'SAGG Master Background Task' [KMPS SAGG REPORT] is"
^DIC(9.4,3,22,21,"PAH",166,1,39,0)="       not currently running by using the 'Status of SAGG Collection"
^DIC(9.4,3,22,21,"PAH",166,1,40,0)="       Routines' [KMPS SAGG STATUS] option and verifying the following"
^DIC(9.4,3,22,21,"PAH",166,1,41,0)="       message is displayed:"
^DIC(9.4,3,22,21,"PAH",166,1,42,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,43,0)="       The temporary collection global (i.e., ^XTMP(""KMPS"")) has no data."
^DIC(9.4,3,22,21,"PAH",166,1,44,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,45,0)="   6.  On the KIDS menu, under the 'Installation' menu, use the 'Install"
^DIC(9.4,3,22,21,"PAH",166,1,46,0)="       Package(s)' option and select the package "
^DIC(9.4,3,22,21,"PAH",166,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,48,0)="          XU*8.0*197"
^DIC(9.4,3,22,21,"PAH",166,1,49,0)="          ==========         "
^DIC(9.4,3,22,21,"PAH",166,1,50,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,51,0)="   7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,3,22,21,"PAH",166,1,52,0)="       Protocols? NO//', you can respond with NO."
^DIC(9.4,3,22,21,"PAH",166,1,53,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,54,0)="   8.  OpenM-NT (Cache) sites - you do not need to move any routines, skip"
^DIC(9.4,3,22,21,"PAH",166,1,55,0)="       this step."
^DIC(9.4,3,22,21,"PAH",166,1,56,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,57,0)="       DSM sites - you need to move several routines from your production"
^DIC(9.4,3,22,21,"PAH",166,1,58,0)="       account to manager account.  "
^DIC(9.4,3,22,21,"PAH",166,1,59,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,60,0)="          ZOSVKSD"
^DIC(9.4,3,22,21,"PAH",166,1,61,0)="          ZOSVKSOE"
^DIC(9.4,3,22,21,"PAH",166,1,62,0)="          ZOSVKSOS"
^DIC(9.4,3,22,21,"PAH",166,1,63,0)="          ZOSVKSVE"
^DIC(9.4,3,22,21,"PAH",166,1,64,0)="          ZOSVKSVS"
^DIC(9.4,3,22,21,"PAH",166,1,65,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,66,0)="   9.  OpenM-NT (Cache) sites remain in VAH."
^DIC(9.4,3,22,21,"PAH",166,1,67,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,68,0)="       DSM sites remain in the manager account."
^DIC(9.4,3,22,21,"PAH",166,1,69,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,70,0)="       All sites:"
^DIC(9.4,3,22,21,"PAH",166,1,71,0)="       "
^DIC(9.4,3,22,21,"PAH",166,1,72,0)="          DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",166,1,73,0)="          Select the System"
^DIC(9.4,3,22,21,"PAH",166,1,74,0)="          Patch number to load: 197"
^DIC(9.4,3,22,21,"PAH",166,1,75,0)="                                ==="
^DIC(9.4,3,22,21,"PAH",166,1,76,0)=" "
^DIC(9.4,3,22,21,"PAH",166,1,77,0)="  10.  After patch has installed, rebuild your map set if necessary."
^DIC(9.4,3,22,21,"PAH",167,0)="201 SEQ #174^3010926^1"
^DIC(9.4,3,22,21,"PAH",167,1,0)="^^83^83^3010926"
^DIC(9.4,3,22,21,"PAH",167,1,1,0)="This patch creates two new components that add the following functionality to "
^DIC(9.4,3,22,21,"PAH",167,1,2,0)="KIDS:"
^DIC(9.4,3,22,21,"PAH",167,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,4,0)="  1. A KIDS Build component that allows users to export entries from the "
^DIC(9.4,3,22,21,"PAH",167,1,5,0)="     PARAMETER DEFINITION File (#8989.51)."
^DIC(9.4,3,22,21,"PAH",167,1,6,0)="       a. Export the Parameter Definition for each entry."
^DIC(9.4,3,22,21,"PAH",167,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,8,0)="       b. Export the entries in the PARAMETERS file (#8989.5) that pointed to "
^DIC(9.4,3,22,21,"PAH",167,1,9,0)="       the exported Parameter Definition (Step A) and had as the entity the "
^DIC(9.4,3,22,21,"PAH",167,1,10,0)="       package to which the KIDS build belongs. The package-level parameters "
^DIC(9.4,3,22,21,"PAH",167,1,11,0)="       contained in the PARAMETERS file (#8989.5) are used as default values in "
^DIC(9.4,3,22,21,"PAH",167,1,12,0)="       cases where the site hasn't set up or modified the parameter."
^DIC(9.4,3,22,21,"PAH",167,1,13,0)="  "
^DIC(9.4,3,22,21,"PAH",167,1,14,0)="       c. Export the entries in PARAMETER ENTITY (#8989.518) file."
^DIC(9.4,3,22,21,"PAH",167,1,15,0)="       "
^DIC(9.4,3,22,21,"PAH",167,1,16,0)="       d. Synchronize/resolve any issues with ""pointed to"" files and entries."
^DIC(9.4,3,22,21,"PAH",167,1,17,0)="       "
^DIC(9.4,3,22,21,"PAH",167,1,18,0)="       e. The incoming data replaces any data at the site."
^DIC(9.4,3,22,21,"PAH",167,1,19,0)="        "
^DIC(9.4,3,22,21,"PAH",167,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,21,0)="  2. A KIDS Build component that allows users to export entries from the "
^DIC(9.4,3,22,21,"PAH",167,1,22,0)="     PARAMETER TEMPLATE File (#8989.52)."
^DIC(9.4,3,22,21,"PAH",167,1,23,0)="       a. Export the Parameter Template for each entry."
^DIC(9.4,3,22,21,"PAH",167,1,24,0)="       "
^DIC(9.4,3,22,21,"PAH",167,1,25,0)="       b. Export each Parameter Definition (#8989.51) that is pointed to,"
^DIC(9.4,3,22,21,"PAH",167,1,26,0)="       without the PARAMETERS file (#8989.5) entry."
^DIC(9.4,3,22,21,"PAH",167,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,29,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",167,1,30,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",167,1,31,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",167,1,32,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",167,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,34,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",167,1,35,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",167,1,36,0)="XPDE         15289814  15641945    **2,15,21,44,51,68,131,182,201**"
^DIC(9.4,3,22,21,"PAH",167,1,37,0)="XPDIA3            n/a   3070143    **201**"
^DIC(9.4,3,22,21,"PAH",167,1,38,0)="XPDTA2            n/a   2361795    **201**"
^DIC(9.4,3,22,21,"PAH",167,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,40,0)="List of preceding patches: 182"
^DIC(9.4,3,22,21,"PAH",167,1,41,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",167,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,43,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",167,1,44,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",167,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,46,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",167,1,47,0)=">>>Taskman does not need to be stopped."
^DIC(9.4,3,22,21,"PAH",167,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",167,1,49,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",167,1,50,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",167,1,51,0)="     "
^DIC(9.4,3,22,21,"PAH",167,1,52,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",167,1,53,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",167,1,54,0)="     "
^DIC(9.4,3,22,21,"PAH",167,1,55,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",167,1,56,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",167,1,57,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",167,1,58,0)="      options:"
^DIC(9.4,3,22,21,"PAH",167,1,59,0)="      "
^DIC(9.4,3,22,21,"PAH",167,1,60,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",167,1,61,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",167,1,62,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",167,1,63,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",167,1,64,0)="     "
^DIC(9.4,3,22,21,"PAH",167,1,65,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",167,1,66,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",167,1,67,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",167,1,68,0)="      TASKMAN can remain running."
^DIC(9.4,3,22,21,"PAH",167,1,69,0)="     "
^DIC(9.4,3,22,21,"PAH",167,1,70,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",167,1,71,0)="      option:"
^DIC(9.4,3,22,21,"PAH",167,1,72,0)="        Install Package(s)  'XU*8.0*201'"
^DIC(9.4,3,22,21,"PAH",167,1,73,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",167,1,74,0)="         "
^DIC(9.4,3,22,21,"PAH",167,1,75,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",167,1,76,0)="        "
^DIC(9.4,3,22,21,"PAH",167,1,77,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",167,1,78,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",167,1,79,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",167,1,80,0)="     "
^DIC(9.4,3,22,21,"PAH",167,1,81,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",167,1,82,0)="  "
^DIC(9.4,3,22,21,"PAH",167,1,83,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",168,0)="213 SEQ #175^3011016^1"
^DIC(9.4,3,22,21,"PAH",168,1,0)="^^66^66^3011016"
^DIC(9.4,3,22,21,"PAH",168,1,1,0)="This patch adds some capabilities within the routine XUSRB related to"
^DIC(9.4,3,22,21,"PAH",168,1,2,0)="Enterprise Single Sign-on (ESSO).  "
^DIC(9.4,3,22,21,"PAH",168,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,4,0)="One change will enable the RPCBroker to determine proxy servers which "
^DIC(9.4,3,22,21,"PAH",168,1,5,0)="can be used for an ESSO sign-on.  "
^DIC(9.4,3,22,21,"PAH",168,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,7,0)="Another change is specific to the CAPRI program of VBA to permit an "
^DIC(9.4,3,22,21,"PAH",168,1,8,0)="ESSO-like sign-on using methods used in remote data views."
^DIC(9.4,3,22,21,"PAH",168,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,10,0)="The patch contains only a single routine."
^DIC(9.4,3,22,21,"PAH",168,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,12,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",168,1,13,0)="The following routines are included in this patch.  The second line of "
^DIC(9.4,3,22,21,"PAH",168,1,14,0)="each of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",168,1,15,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",168,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,17,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",168,1,18,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",168,1,19,0)="XUSRB         6227685   8143764    **11,16,28,32,59,70,82,109,115,165,150,180,213**"
^DIC(9.4,3,22,21,"PAH",168,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,21,0)="List of preceding patches: 36, 102, 149, 150, 180"
^DIC(9.4,3,22,21,"PAH",168,1,22,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",168,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,24,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,25,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",168,1,26,0)="Installation: "
^DIC(9.4,3,22,21,"PAH",168,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,28,0)=">>>Users may remain on the system.  "
^DIC(9.4,3,22,21,"PAH",168,1,29,0)=">>>Taskman does not need to be stopped.  "
^DIC(9.4,3,22,21,"PAH",168,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,31,0)="  1.  DSM sites - Some of the routine is usually mapped, "
^DIC(9.4,3,22,21,"PAH",168,1,32,0)="      so you will need to disable mapping for the routine. "
^DIC(9.4,3,22,21,"PAH",168,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,34,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",168,1,35,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",168,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,37,0)="  3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",168,1,38,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,3,22,21,"PAH",168,1,39,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,3,22,21,"PAH",168,1,40,0)="      options: "
^DIC(9.4,3,22,21,"PAH",168,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,42,0)="         Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",168,1,43,0)="         Print Transport Global "
^DIC(9.4,3,22,21,"PAH",168,1,44,0)="         Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",168,1,45,0)="         Backup a Transport Global "
^DIC(9.4,3,22,21,"PAH",168,1,46,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,47,0)="  4.  Users can remain on the system if installed at non-peak hours."
^DIC(9.4,3,22,21,"PAH",168,1,48,0)="      There is a small chance that a user could get a CLOBER error if they"
^DIC(9.4,3,22,21,"PAH",168,1,49,0)="      are signing on at the time the routines change.  "
^DIC(9.4,3,22,21,"PAH",168,1,50,0)="      This patch can be queued and installed at non-peak time.  "
^DIC(9.4,3,22,21,"PAH",168,1,51,0)="      TASKMAN can remain running.  "
^DIC(9.4,3,22,21,"PAH",168,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,53,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,3,22,21,"PAH",168,1,54,0)="      option: "
^DIC(9.4,3,22,21,"PAH",168,1,55,0)="        Install Package(s)  'XU*8.0*213' "
^DIC(9.4,3,22,21,"PAH",168,1,56,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",168,1,57,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,58,0)="      Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,3,22,21,"PAH",168,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,60,0)="      Want KIDS to INHIBIT LOGONs during the install? YES// NO "
^DIC(9.4,3,22,21,"PAH",168,1,61,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,62,0)="      No Options or Protocols need to be placed out-of-order.  "
^DIC(9.4,3,22,21,"PAH",168,1,63,0)="      Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO "
^DIC(9.4,3,22,21,"PAH",168,1,64,0)="                                                                      =="
^DIC(9.4,3,22,21,"PAH",168,1,65,0)=" "
^DIC(9.4,3,22,21,"PAH",168,1,66,0)="  6.  DSM Sites, after patch has installed, rebuild your map set.  "
^DIC(9.4,3,22,21,"PAH",169,0)="214 SEQ #176^3011121^1"
^DIC(9.4,3,22,21,"PAH",169,1,0)="^^2^2^3011121"
^DIC(9.4,3,22,21,"PAH",169,1,1,0)="See patch XU*8*214 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",169,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",170,0)="210 SEQ #177^3011121^1"
^DIC(9.4,3,22,21,"PAH",170,1,0)="^^85^85^3011121"
^DIC(9.4,3,22,21,"PAH",170,1,1,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,2,0)="Patch XU*8*210, R/S Change Division"
^DIC(9.4,3,22,21,"PAH",170,1,3,0)="==================================="
^DIC(9.4,3,22,21,"PAH",170,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,5,0)="Problem Statement"
^DIC(9.4,3,22,21,"PAH",170,1,6,0)="================="
^DIC(9.4,3,22,21,"PAH",170,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,8,0)="Patch XU*8*210 addresses the need for users at multi-divisional or consolidated sites to change the division they represent without having to sign out and then sign back onto the system. "
^DIC(9.4,3,22,21,"PAH",170,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,10,0)="Patch Solution"
^DIC(9.4,3,22,21,"PAH",170,1,11,0)="=============="
^DIC(9.4,3,22,21,"PAH",170,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,13,0)="This patch introduces a new Kernel option XUSER DIV CHG, menu text: Change my "
^DIC(9.4,3,22,21,"PAH",170,1,14,0)="Division. It has been added to the TBOX on the COMMON Menu."
^DIC(9.4,3,22,21,"PAH",170,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,16,0)="Here is the Option description:"
^DIC(9.4,3,22,21,"PAH",170,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,18,0)="  The Kernel option ""Change my Division"" allows you to change the"
^DIC(9.4,3,22,21,"PAH",170,1,19,0)="  division to which you are currently assigned. This option performs"
^DIC(9.4,3,22,21,"PAH",170,1,20,0)="  the same function as entering your current division at the signon"
^DIC(9.4,3,22,21,"PAH",170,1,21,0)="  prompt ""Select DIVISION: default division //""."
^DIC(9.4,3,22,21,"PAH",170,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",170,1,23,0)="  If you only have one division to select from, XUSER DIV CHG will show you "
^DIC(9.4,3,22,21,"PAH",170,1,24,0)="  your current division and indicate that you cannot change it."
^DIC(9.4,3,22,21,"PAH",170,1,25,0)="  "
^DIC(9.4,3,22,21,"PAH",170,1,26,0)="================"
^DIC(9.4,3,22,21,"PAH",170,1,27,0)="The following NOIS calls are also corrected:"
^DIC(9.4,3,22,21,"PAH",170,1,28,0)="HIN-0801-41754, FRE-0801-64066, BAC-0701-41456"
^DIC(9.4,3,22,21,"PAH",170,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",170,1,30,0)="The problem:"
^DIC(9.4,3,22,21,"PAH",170,1,31,0)="In the User Inquiry option, the CPRS Parameter Info is for the wrong"
^DIC(9.4,3,22,21,"PAH",170,1,32,0)="person.  It has been fixed to report for the correct person."
^DIC(9.4,3,22,21,"PAH",170,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",170,1,34,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",170,1,35,0)="The following routines are included in this patch.  The second line of each"
