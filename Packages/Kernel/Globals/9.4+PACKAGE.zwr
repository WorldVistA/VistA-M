^DIC(9.4,4,22,1,"PAH",100,1,40,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",100,1,41,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",100,1,42,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",100,1,43,0)=" Select INSTALL NAME:    XM*7.1*129    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",100,1,44,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",100,1,45,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",100,1,46,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",100,1,47,0)="                                                       =="
