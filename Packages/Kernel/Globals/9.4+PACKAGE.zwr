^DIC(9.4,96,5)="WASHINGTON"
^DIC(9.4,96,6,0)="^^11^11^2870330^^^^"
^DIC(9.4,96,6,1,0)="Version 1.14 of this package has been verified and distributed to the field."
^DIC(9.4,96,6,2,0)=" "
^DIC(9.4,96,6,3,0)="The next version (1.2) will provide an automated Dental treatment record"
^DIC(9.4,96,6,4,0)="and the capability to correct data previously sent to Austin that was"
^DIC(9.4,96,6,5,0)="found to be in error."
^DIC(9.4,96,6,6,0)=" "
^DIC(9.4,96,6,7,0)="The following version (2.0) will provide a new module to support local"
^DIC(9.4,96,6,8,0)="Dental Laboratories at the medical centers.  This module will support the"
^DIC(9.4,96,6,9,0)="Dental Laboratory in the same manner the original package supported the"
^DIC(9.4,96,6,10,0)="Dental Clinic.  It will track the workload in the laboratory and generate"
^DIC(9.4,96,6,11,0)="reports similar to the AMIS reports generated for the clinic."
^DIC(9.4,96,7)="^^I"
^DIC(9.4,96,9)="^"
