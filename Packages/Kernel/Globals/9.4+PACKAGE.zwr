^DIC(9.4,135,22,14,"PAH",19,1,2,0)="in this patch."
^DIC(9.4,135,22,14,"PAH",20,0)="27^3041228^1"
^DIC(9.4,135,22,14,"PAH",20,1,0)="^^1^1^3041228"
^DIC(9.4,135,22,14,"PAH",20,1,1,0)="See description in the Nationl Patch module."
^DIC(9.4,135,22,14,"PAH",21,0)="31 SEQ #28^3050611^1"
^DIC(9.4,135,22,14,"PAH",21,1,0)="^^7^7^3050611"
^DIC(9.4,135,22,14,"PAH",21,1,1,0)="This patch will correct the problem of invalid characters (~) appearing "
^DIC(9.4,135,22,14,"PAH",21,1,2,0)="in the DIAGNOSIS (pointer to the ICD DIAGNOSIS file #80) in the PROBLEM "
^DIC(9.4,135,22,14,"PAH",21,1,3,0)="FILE (9000011). This modification will also add a check for the ICD code "
^DIC(9.4,135,22,14,"PAH",21,1,4,0)="not being found. (-1 being returned instead of pointer from ICD #80 file "
^DIC(9.4,135,22,14,"PAH",21,1,5,0)="search)"
^DIC(9.4,135,22,14,"PAH",21,1,6,0)=" "
^DIC(9.4,135,22,14,"PAH",21,1,7,0)="It will also add audit trail processing for changes to Problem comments."
^DIC(9.4,135,22,14,"PAH",22,0)="33 SEQ #30^3060608^1"
^DIC(9.4,135,22,14,"PAH",22,1,0)="^^2^2^3060608"
^DIC(9.4,135,22,14,"PAH",22,1,1,0)="This Patch addresses where users are unable to modify the "
^DIC(9.4,135,22,14,"PAH",22,1,2,0)="current Problem Category Lists to make it assignable to users."
