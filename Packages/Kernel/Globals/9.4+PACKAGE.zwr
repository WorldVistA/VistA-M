^DIC(9.4,52,22,28,"PAH",99,1,0)="^^1^1^2990201"
^DIC(9.4,52,22,28,"PAH",99,1,1,0)="FIX PRINTING PROBLEMS"
^DIC(9.4,52,22,28,"PAH",100,0)="187 SEQ #166^2990210^1"
^DIC(9.4,52,22,28,"PAH",100,1,0)="^^1^1^2990210"
^DIC(9.4,52,22,28,"PAH",100,1,1,0)="Purchase Order Print/Display Fixes"
^DIC(9.4,52,22,28,"PAH",101,0)="194 SEQ #167^2990322^1"
^DIC(9.4,52,22,28,"PAH",102,0)="206 SEQ #168^2990329^1"
^DIC(9.4,52,22,28,"PAH",102,1,0)="^^3^3^2990329"
^DIC(9.4,52,22,28,"PAH",102,1,1,0)="Correct 3 fields in file 421 and file 410 that use ^DIC in their input"
^DIC(9.4,52,22,28,"PAH",102,1,2,0)="transform.  Made changes to find out if user selected something before"
^DIC(9.4,52,22,28,"PAH",102,1,3,0)="working with returned data (it might not be available)."
^DIC(9.4,52,22,28,"PAH",103,0)="202 SEQ #169^2990329^1"
^DIC(9.4,52,22,28,"PAH",103,1,0)="^^1^1^2990329"
^DIC(9.4,52,22,28,"PAH",103,1,1,0)="Correction for display of PC orders to be selected for reconciliation."
^DIC(9.4,52,22,28,"PAH",104,0)="99 SEQ #170^2990417^1"
^DIC(9.4,52,22,28,"PAH",105,0)="198 SEQ #171^2990417^1"
^DIC(9.4,52,22,28,"PAH",105,1,0)="^^1^1^2990417"
^DIC(9.4,52,22,28,"PAH",105,1,1,0)="1358 PRINT AND DAILY ACTIVITY ISSUES"
^DIC(9.4,52,22,28,"PAH",106,0)="185 SEQ #172^2990510^1"
^DIC(9.4,52,22,28,"PAH",106,1,0)="^^1^1^2990510"
^DIC(9.4,52,22,28,"PAH",106,1,1,0)="Certified Invoice payment fixes"
^DIC(9.4,52,22,28,"PAH",107,0)="205 SEQ #173^2990510^1"
^DIC(9.4,52,22,28,"PAH",107,1,0)="^^1^1^2990510"
^DIC(9.4,52,22,28,"PAH",107,1,1,0)="GIP PHYSICAL COUNT FORM"
^DIC(9.4,52,22,28,"PAH",108,0)="177 SEQ #174^2990510^1"
^DIC(9.4,52,22,28,"PAH",108,1,0)="^^1^1^2990510"
^DIC(9.4,52,22,28,"PAH",108,1,1,0)="This build contains all the modified components for this patch."
^DIC(9.4,52,22,28,"PAH",109,0)="173 SEQ #175^2990602^1"
^DIC(9.4,52,22,28,"PAH",109,1,0)="^^1^1^2990602"
^DIC(9.4,52,22,28,"PAH",109,1,1,0)="PURCHASE CARD DELINQUENT REPORTS"
^DIC(9.4,52,22,28,"PAH",110,0)="200 SEQ #176^2990602^1"
^DIC(9.4,52,22,28,"PAH",110,1,0)="^^1^1^2990602"
^DIC(9.4,52,22,28,"PAH",110,1,1,0)="PRINT/DISPLAY FIXES ON REQUISITIONS/PO'S"
^DIC(9.4,52,22,28,"PAH",111,0)="208 SEQ #177^2990602^1"
^DIC(9.4,52,22,28,"PAH",111,1,0)="^^2^2^2990602"
^DIC(9.4,52,22,28,"PAH",111,1,1,0)="This patch will prevent placing into file 442 '-2' as the 2237 internal"
^DIC(9.4,52,22,28,"PAH",111,1,2,0)="record number."
^DIC(9.4,52,22,28,"PAH",112,0)="193 SEQ #178^2990719^1"
^DIC(9.4,52,22,28,"PAH",113,0)="195 SEQ #179^2990719^1"
^DIC(9.4,52,22,28,"PAH",113,1,0)="^^1^1^2990719"
^DIC(9.4,52,22,28,"PAH",113,1,1,0)="GIP INVENTORY POINT FIXES"
^DIC(9.4,52,22,28,"PAH",114,0)="209 SEQ #180^2990719^1"
^DIC(9.4,52,22,28,"PAH",114,1,0)="^^1^1^2990719"
^DIC(9.4,52,22,28,"PAH",114,1,1,0)="Build for Disputed Purchase Card Orders."
^DIC(9.4,52,22,28,"PAH",115,0)="182 SEQ #181^2990719^1"
^DIC(9.4,52,22,28,"PAH",116,0)="204 SEQ #182^2990914^1"
^DIC(9.4,52,22,28,"PAH",116,1,0)="^^1^1^2990914"
^DIC(9.4,52,22,28,"PAH",116,1,1,0)="GIP Printing Ticket Fixes"
^DIC(9.4,52,22,28,"PAH",117,0)="216 SEQ #183^2990914^1"
^DIC(9.4,52,22,28,"PAH",118,0)="203 SEQ #184^2990914^1"
^DIC(9.4,52,22,28,"PAH",118,1,0)="^^11^11^2990914"
^DIC(9.4,52,22,28,"PAH",118,1,1,0)="As part of the VISN/Integration Enhancement initiative, this patch adds"
^DIC(9.4,52,22,28,"PAH",118,1,2,0)="fax numbers and e-mail addresses to IFCAP documents, due to their"
^DIC(9.4,52,22,28,"PAH",118,1,3,0)="increasing use in communications between Purchasing Agents and vendors."
^DIC(9.4,52,22,28,"PAH",118,1,4,0)="Specifically, this patch adds the Purchasing Agent's fax and the vendor's"
^DIC(9.4,52,22,28,"PAH",118,1,5,0)="fax to the Purchase Order (Form 2138) and Amendment Form (SF-30).  In"
^DIC(9.4,52,22,28,"PAH",118,1,6,0)="addition, it adds the Purchasing Agent's e-mail address to the Request for"
^DIC(9.4,52,22,28,"PAH",118,1,7,0)="Quotation (SF-18), Purchase Order (Form 2138), and Amendment Form (SF-30)."
^DIC(9.4,52,22,28,"PAH",118,1,8,0)="To support these enhancements, this patch adds the FAX NUMBER field"
^DIC(9.4,52,22,28,"PAH",118,1,9,0)="(#.136) and EMAIL ADDRESS field (#.151) of the NEW PERSON file (#200) to"
^DIC(9.4,52,22,28,"PAH",118,1,10,0)="the questions asked in option Add/Edit Supply Personnel [PRCH EMPLOYEE"
^DIC(9.4,52,22,28,"PAH",118,1,11,0)="EDIT]."
^DIC(9.4,52,22,28,"PAH",119,0)="212 SEQ #185^2990914^1"
^DIC(9.4,52,22,28,"PAH",119,1,0)="^^2^2^2990914"
^DIC(9.4,52,22,28,"PAH",119,1,1,0)="Build for correction of service name in purchase card options, and clean"
^DIC(9.4,52,22,28,"PAH",119,1,2,0)="up of the ""AB"" cross references in file #442."
^DIC(9.4,52,22,28,"PAH",120,0)="214 SEQ #186^2990914^1"
^DIC(9.4,52,22,28,"PAH",120,1,0)="^^5^5^2990914"
^DIC(9.4,52,22,28,"PAH",120,1,1,0)="This will add 2 fields to the edit of a 441 item, within the VENDOR"
^DIC(9.4,52,22,28,"PAH",120,1,2,0)="multiple."
^DIC(9.4,52,22,28,"PAH",120,1,3,0)=" "
^DIC(9.4,52,22,28,"PAH",120,1,4,0)="This will also allow the template to continue after entering 2237s into"
^DIC(9.4,52,22,28,"PAH",120,1,5,0)="the P.O. rather than going to the end."
^DIC(9.4,52,22,28,"PAH",121,0)="162 SEQ #187^2991003^1"
^DIC(9.4,52,22,28,"PAH",121,1,0)="^^1^1^2991003"
^DIC(9.4,52,22,28,"PAH",121,1,1,0)="HOME OXYGEN MODULE/IFCAP API"
^DIC(9.4,52,22,28,"PAH",122,0)="215 SEQ #189^2991019^1"
^DIC(9.4,52,22,28,"PAH",122,1,0)="^^2^2^2991019"
^DIC(9.4,52,22,28,"PAH",122,1,1,0)="This patch corrects an <ENDOFFILE> error that may occur during Carry"
^DIC(9.4,52,22,28,"PAH",122,1,2,0)="Forward processing."
^DIC(9.4,52,22,28,"PAH",123,0)="227 SEQ #190^2991104^1"
^DIC(9.4,52,22,28,"PAH",123,1,0)="^^1^1^2991104"
^DIC(9.4,52,22,28,"PAH",123,1,1,0)="This is a build for patch PRC*5*227"
^DIC(9.4,52,22,28,"PAH",124,0)="230 SEQ #191^2991104^1"
^DIC(9.4,52,22,28,"PAH",125,0)="231 SEQ #192^2991104^1"
^DIC(9.4,52,22,28,"PAH",126,0)="235 SEQ #193^2991123^1"
^DIC(9.4,52,22,28,"PAH",126,1,0)="^^1^1^2991123"
^DIC(9.4,52,22,28,"PAH",126,1,1,0)="Sub-Control Point Y2K Fix Allows ""00"" in Fiscal Year Field"
^DIC(9.4,52,22,28,"PAH",127,0)="191 SEQ #194^2991210^1"
^DIC(9.4,52,22,28,"PAH",127,1,0)="^^2^2^2991210"
^DIC(9.4,52,22,28,"PAH",127,1,1,0)="Update patch 150 changes to speed up response time, eliminate unnecessary"
^DIC(9.4,52,22,28,"PAH",127,1,2,0)="prompts and restore old functionality."
^DIC(9.4,52,22,28,"PAH",128,0)="236 SEQ #195^2991210^1"
^DIC(9.4,52,22,28,"PAH",128,1,0)="^^1^1^2991210"
^DIC(9.4,52,22,28,"PAH",128,1,1,0)="Examine integrity of file 442.3"
^DIC(9.4,52,22,28,"PAH",129,0)="232 SEQ #196^2991210^1"
^DIC(9.4,52,22,28,"PAH",130,0)="239 SEQ #197^3000103^1"
^DIC(9.4,52,22,28,"PAH",131,0)="233 SEQ #198^3000103^1"
^DIC(9.4,52,22,28,"PAH",131,1,0)="^^3^3^3000103"
^DIC(9.4,52,22,28,"PAH",131,1,1,0)="This patch resolves NOIS ISW-0999-20400 FMS EXCEPTION RPT NOT Y2K"
^DIC(9.4,52,22,28,"PAH",131,1,2,0)="and resolves NOIS ISW-1299-22783 TRANS DATE ON FMS TRANSACTION"
^DIC(9.4,52,22,28,"PAH",131,1,3,0)="NOTIFICATION NOT Y2K."
^DIC(9.4,52,22,28,"PAH",132,0)="199 SEQ #199^3000125^1"
^DIC(9.4,52,22,28,"PAH",132,1,0)="^^1^1^3000125"
^DIC(9.4,52,22,28,"PAH",132,1,1,0)="Second line formatting corrections and the deletion of PRCUCOM"
^DIC(9.4,52,22,28,"PAH",133,0)="219 SEQ #200^3000125^1"
^DIC(9.4,52,22,28,"PAH",133,1,0)="^^5^5^3000125"
^DIC(9.4,52,22,28,"PAH",133,1,1,0)="The logical limit to the partial numbering system is 974 partials.  Once"
^DIC(9.4,52,22,28,"PAH",133,1,2,0)="this limit is exceeded (i.e. partial 975 and beyond) the PV document that"
^DIC(9.4,52,22,28,"PAH",133,1,3,0)="is created during invoice payment processing is incorrect.  A duplication"
^DIC(9.4,52,22,28,"PAH",133,1,4,0)="of PV numbers results and can cause errors to occur.  Currently, there are"
^DIC(9.4,52,22,28,"PAH",133,1,5,0)="no checks to see if the partial number has reached or exceeded its limit."
^DIC(9.4,52,22,28,"PAH",134,0)="179 SEQ #201^3000125^1"
^DIC(9.4,52,22,28,"PAH",134,1,0)="^^6^6^3000125"
^DIC(9.4,52,22,28,"PAH",134,1,1,0)=" "
^DIC(9.4,52,22,28,"PAH",134,1,2,0)=" "
^DIC(9.4,52,22,28,"PAH",134,1,3,0)="1  Create AR transactions."
^DIC(9.4,52,22,28,"PAH",134,1,4,0)="2  Allow prior year SO transactions to be sent as AR, when desired."
^DIC(9.4,52,22,28,"PAH",134,1,5,0)="3  Prohibit the deletion of PO Date in file 442 when the original 1358 SO"
^DIC(9.4,52,22,28,"PAH",134,1,6,0)="is rebuilt."
^DIC(9.4,52,22,28,"PAH",135,0)="201 SEQ #202^3000204^1"
^DIC(9.4,52,22,28,"PAH",135,1,0)="^^1^1^3000204"
^DIC(9.4,52,22,28,"PAH",135,1,1,0)="Build for patch PRC*5*201."
^DIC(9.4,52,22,28,"PAH",136,0)="223 SEQ #203^3000229^1"
^DIC(9.4,52,22,28,"PAH",136,1,0)="^^1^1^3000229"
^DIC(9.4,52,22,28,"PAH",136,1,1,0)="Special remarks on PC orders"
^DIC(9.4,52,22,28,"PAH",137,0)="197 SEQ #204^3000313^1"
^DIC(9.4,52,22,28,"PAH",137,1,0)="^^7^7^3000313"
^DIC(9.4,52,22,28,"PAH",137,1,1,0)="o Allows multiple primary inventory points to share the same FCP."
^DIC(9.4,52,22,28,"PAH",137,1,2,0)="o Permits conversion of existing secondaries into primaries."
^DIC(9.4,52,22,28,"PAH",137,1,3,0)="o Users are now required to select Inventory Points manually in some"
^DIC(9.4,52,22,28,"PAH",137,1,4,0)="  cases. When there is only one possible choice, the system will select it"
^DIC(9.4,52,22,28,"PAH",137,1,5,0)="  automatically. In cases where the FCP is serving more than one Inventory"
^DIC(9.4,52,22,28,"PAH",137,1,6,0)="  Point, users will be prompted unless the system can determine the"
^DIC(9.4,52,22,28,"PAH",137,1,7,0)="  Inventory Point on the basis of context."
^DIC(9.4,52,22,28,"PAH",138,0)="240 SEQ #205^3000313^1"
^DIC(9.4,52,22,28,"PAH",138,1,0)="^^2^2^3000313"
^DIC(9.4,52,22,28,"PAH",138,1,1,0)="Build for the first patch of a series for correction of ^UTILITY use by"
^DIC(9.4,52,22,28,"PAH",138,1,2,0)="IFCAP."
^DIC(9.4,52,22,28,"PAH",139,0)="252 SEQ #206^3000405^1"
^DIC(9.4,52,22,28,"PAH",139,1,0)="^^1^1^3000405"
^DIC(9.4,52,22,28,"PAH",139,1,1,0)="Undef PRCSA2. From 1358 Print menu."
^DIC(9.4,52,22,28,"PAH",140,0)="250 SEQ #207^3000405^1"
^DIC(9.4,52,22,28,"PAH",140,1,0)="^^1^1^3000405"
^DIC(9.4,52,22,28,"PAH",140,1,1,0)="Audit Transaction List Y2K"
^DIC(9.4,52,22,28,"PAH",141,0)="234 SEQ #208^3000405^1"
^DIC(9.4,52,22,28,"PAH",141,1,0)="^^15^15^3000405"
^DIC(9.4,52,22,28,"PAH",141,1,1,0)="While using the Generate FMS Budget Documents option"
^DIC(9.4,52,22,28,"PAH",141,1,2,0)="[PRCB GENERATE CODE SHEETS], the user gets prompted"
^DIC(9.4,52,22,28,"PAH",141,1,3,0)="for an FMS Transaction Date. The default date consists"
^DIC(9.4,52,22,28,"PAH",141,1,4,0)="of the month and the year, but the user gets the message"
^DIC(9.4,52,22,28,"PAH",141,1,5,0)="""Enter precise date!""  This problem occurs with any"
^DIC(9.4,52,22,28,"PAH",141,1,6,0)="site that has FileMan 22.  "
^DIC(9.4,52,22,28,"PAH",141,1,7,0)=""
^DIC(9.4,52,22,28,"PAH",141,1,8,0)="The date utility routine PRC0B2 has been modified. It"
^DIC(9.4,52,22,28,"PAH",141,1,9,0)="sets the %DT variable to ""FMPT"".  These format parameters"
^DIC(9.4,52,22,28,"PAH",141,1,10,0)="are passed to the routine %DT.  The ""M"" parameter specifies"
^DIC(9.4,52,22,28,"PAH",141,1,11,0)="that only the month and year are allowed for input. Only"
^DIC(9.4,52,22,28,"PAH",141,1,12,0)="FileMan 22 uses this parameter. It was this version that"
^DIC(9.4,52,22,28,"PAH",141,1,13,0)="introduced this parameter. Other FileMan versions ignore"
^DIC(9.4,52,22,28,"PAH",141,1,14,0)="the ""M"" which is believed to be a typo in the date utility"
^DIC(9.4,52,22,28,"PAH",141,1,15,0)="routine PRC0B2."
^DIC(9.4,52,22,28,"PAH",142,0)="246 SEQ #209^3000405^1"
^DIC(9.4,52,22,28,"PAH",142,1,0)="^^2^2^3000405"
^DIC(9.4,52,22,28,"PAH",142,1,1,0)="Suppress the printing of an ""@"" on the Running Balance when a manual"
^DIC(9.4,52,22,28,"PAH",142,1,2,0)="adjustment has been entered against a Purchase Card Order."
^DIC(9.4,52,22,28,"PAH",143,0)="245 SEQ #210^3000405^1"
^DIC(9.4,52,22,28,"PAH",143,1,0)="^^1^1^3000405"
^DIC(9.4,52,22,28,"PAH",143,1,1,0)="Build for PRC*5*245, SAC UTILITY CORRECTIONS - ORDERS AND REQUISITIONS."
^DIC(9.4,52,22,28,"PAH",144,0)="192 SEQ #211^3000405^1"
^DIC(9.4,52,22,28,"PAH",144,1,0)="^^2^2^3000405"
^DIC(9.4,52,22,28,"PAH",144,1,1,0)="This will allow vendors to be found even if they were entered in mixed"
^DIC(9.4,52,22,28,"PAH",144,1,2,0)="case."
^DIC(9.4,52,22,28,"PAH",145,0)="218 SEQ #212^3000405^1"
^DIC(9.4,52,22,28,"PAH",145,1,0)="^^1^1^3000405"
^DIC(9.4,52,22,28,"PAH",145,1,1,0)="Build for Complete Order Received in Reconciliation."
^DIC(9.4,52,22,28,"PAH",146,0)="254 SEQ #213^3000417^1"
^DIC(9.4,52,22,28,"PAH",146,1,0)="^^2^2^3000417"
^DIC(9.4,52,22,28,"PAH",146,1,1,0)="This patch corrects a problem after PRC*5*197 with the Change Existing"
^DIC(9.4,52,22,28,"PAH",146,1,2,0)="Transaction Number option."
^DIC(9.4,52,22,28,"PAH",147,0)="247 SEQ #214^3000417^1"
^DIC(9.4,52,22,28,"PAH",147,1,0)="^^1^1^3000417"
^DIC(9.4,52,22,28,"PAH",147,1,1,0)="1358 BALANCE DISPLAY; ERROR DURING CREATE NEW BILL ACTIVITY"
^DIC(9.4,52,22,28,"PAH",148,0)="248 SEQ #215^3000501^1"
^DIC(9.4,52,22,28,"PAH",149,0)="242 SEQ #216^3000501^1"
^DIC(9.4,52,22,28,"PAH",149,1,0)="^^3^3^3000501"
^DIC(9.4,52,22,28,"PAH",149,1,1,0)=" "
^DIC(9.4,52,22,28,"PAH",149,1,2,0)="FIX SAC LOCK VIOLATIONS IN MULTIPLE TRANSACTIONS, SINGLE TRANSFER,"
^DIC(9.4,52,22,28,"PAH",149,1,3,0)="AND CARRY FORWARD OPTIONS"
^DIC(9.4,52,22,28,"PAH",150,0)="244 SEQ #217^3000501^1"
^DIC(9.4,52,22,28,"PAH",150,1,0)="^^1^1^3000501"
^DIC(9.4,52,22,28,"PAH",150,1,1,0)="Build for PRC*5*244, SAC UTILITY CORRECTIONS- AMENDMENTS."
^DIC(9.4,52,22,28,"PAH",151,0)="256 SEQ #218^3000502^1"
^DIC(9.4,52,22,28,"PAH",152,0)="257 SEQ #219^3000516^1"
^DIC(9.4,52,22,28,"PAH",152,1,0)="^^1^1^3000516"
^DIC(9.4,52,22,28,"PAH",152,1,1,0)="Build for ADMINISTRATIVE CERTIFICATIONS ON PURCHASE ORDERS."
^DIC(9.4,52,22,28,"PAH",153,0)="251 SEQ #221^3000525^1"
^DIC(9.4,52,22,28,"PAH",153,1,0)="^^1^1^3000525"
^DIC(9.4,52,22,28,"PAH",153,1,1,0)="Build for PRC*5*251, SAC LOCK CORRECTIONS - BUILD LISTS"
^DIC(9.4,52,22,28,"PAH",154,0)="249 SEQ #222^3000525^1"
^DIC(9.4,52,22,28,"PAH",154,1,0)="^^1^1^3000525"
^DIC(9.4,52,22,28,"PAH",154,1,1,0)="This patch corrects SAC locking violations."
^DIC(9.4,52,22,28,"PAH",155,0)="172 SEQ #223^3000525^1"
^DIC(9.4,52,22,28,"PAH",155,1,0)="^^1^1^3000525"
^DIC(9.4,52,22,28,"PAH",155,1,1,0)="Carry Forward 3rd-4th Qtr Running Balance - Canceled Obligations"
^DIC(9.4,52,22,28,"PAH",156,0)="221 SEQ #224^3000525^1"
^DIC(9.4,52,22,28,"PAH",156,1,0)="^^12^12^3000525"
^DIC(9.4,52,22,28,"PAH",156,1,1,0)="This patch address the following NOIS:"
^DIC(9.4,52,22,28,"PAH",156,1,2,0)=""
^DIC(9.4,52,22,28,"PAH",156,1,3,0)="1. PHI-1099-21187                                                                  "
^DIC(9.4,52,22,28,"PAH",156,1,4,0)="2. DAY-1099-42326"
^DIC(9.4,52,22,28,"PAH",156,1,5,0)=""
^DIC(9.4,52,22,28,"PAH",156,1,6,0)="While running the Electronic Receiving Batch Statistics"
^DIC(9.4,52,22,28,"PAH",156,1,7,0)="Report, a null subscript error occurs.  This is because"
^DIC(9.4,52,22,28,"PAH",156,1,8,0)="the ELEC RECEIVING REPORT BATCH file (442.9) has no data"
^DIC(9.4,52,22,28,"PAH",156,1,9,0)="in the Purchase Order Number field (#1)."
^DIC(9.4,52,22,28,"PAH",156,1,10,0)=""
^DIC(9.4,52,22,28,"PAH",156,1,11,0)="This patch also addresses a SAC LOCK violation in routine"
^DIC(9.4,52,22,28,"PAH",156,1,12,0)="PRCFARR."
^DIC(9.4,52,22,28,"PAH",157,0)="258 SEQ #225^3000612^1"
^DIC(9.4,52,22,28,"PAH",158,0)="253 SEQ #226^3000612^1"
^DIC(9.4,52,22,28,"PAH",158,1,0)="^^4^4^3000612"
^DIC(9.4,52,22,28,"PAH",158,1,1,0)="Added the ""**"" in line 2 for routine PRCHEI."
^DIC(9.4,52,22,28,"PAH",158,1,2,0)=" "
^DIC(9.4,52,22,28,"PAH",158,1,3,0)="Modified routine PRCHEC. This routine gets call from ""New Requisition"""
^DIC(9.4,52,22,28,"PAH",158,1,4,0)="Menu Option."
^DIC(9.4,52,22,28,"PAH",159,0)="237 SEQ #227^3000612^1"
^DIC(9.4,52,22,28,"PAH",159,1,0)="^^4^4^3000612"
^DIC(9.4,52,22,28,"PAH",159,1,1,0)="This patch cleans up documents in file 442 that are left over after an"
^DIC(9.4,52,22,28,"PAH",159,1,2,0)="Archive/Purge is run.  These documents include Accounts Receivable"
^DIC(9.4,52,22,28,"PAH",159,1,3,0)="documents and Purchase Orders without a P.O. Date.  Two routines and a"
^DIC(9.4,52,22,28,"PAH",159,1,4,0)="menu option are installed."
^DIC(9.4,52,22,28,"PAH",160,0)="175 SEQ #228^3000626^1"
^DIC(9.4,52,22,28,"PAH",160,1,0)="^^14^14^3000626"
^DIC(9.4,52,22,28,"PAH",160,1,1,0)="Update EDI/RFQ REPORTS option.  This update will allow a user to select"
^DIC(9.4,52,22,28,"PAH",160,1,2,0)="one sender (someone who entered a PHA, RFQ or TXT transaction into the"
^DIC(9.4,52,22,28,"PAH",160,1,3,0)="local IFCAP system) from among all the senders in file 443.75.  All"
^DIC(9.4,52,22,28,"PAH",160,1,4,0)="reports and the initial screen will display only those records entered by"
^DIC(9.4,52,22,28,"PAH",160,1,5,0)="the selected sender."
^DIC(9.4,52,22,28,"PAH",160,1,6,0)="   "
^DIC(9.4,52,22,28,"PAH",160,1,7,0)="If the user is a SUPPLY MANAGER then the user can view all senders at one"
^DIC(9.4,52,22,28,"PAH",160,1,8,0)="time.  All reports, as well as the initial screen(s), will display without"
^DIC(9.4,52,22,28,"PAH",160,1,9,0)="any sender sorting.  The SUPPLY MANAGER user can select one sender by"
^DIC(9.4,52,22,28,"PAH",160,1,10,0)="answering NO to the select all question."
^DIC(9.4,52,22,28,"PAH",160,1,11,0)=""
^DIC(9.4,52,22,28,"PAH",160,1,12,0)="During testing, one of the sites found an error that is not related to"
^DIC(9.4,52,22,28,"PAH",160,1,13,0)="this patch.  It is a separate issue.  This patch also resolves NOIS"
^DIC(9.4,52,22,28,"PAH",160,1,14,0)="DEN-0999-50592 (EDI/RFQ Reports Option Errors Out)."
^DIC(9.4,52,22,28,"PAH",161,0)="255 SEQ #220^3000710^1"
^DIC(9.4,52,22,28,"PAH",161,1,0)="^^1^1^3000710"
^DIC(9.4,52,22,28,"PAH",161,1,1,0)="First build for patch 255. Duplicate 2237 on File #410."
^DIC(9.4,52,22,28,"PAH",162,0)="238 SEQ #229^3000724^1"
^DIC(9.4,52,22,28,"PAH",162,1,0)="^^4^4^3000724"
^DIC(9.4,52,22,28,"PAH",162,1,1,0)="This patch cleans up documents in file 410 that are left over after an"
^DIC(9.4,52,22,28,"PAH",162,1,2,0)="Archive/Purge is run.  It purges, based on a date the user enters, items"
^DIC(9.4,52,22,28,"PAH",162,1,3,0)="in file 410 that have no established connection or relationship to an"
^DIC(9.4,52,22,28,"PAH",162,1,4,0)="entry in file 442.  Two routines and a menu option are installed."
^DIC(9.4,52,22,28,"PAH",163,0)="259 SEQ #230^3001004^1"
^DIC(9.4,52,22,28,"PAH",163,1,0)="^^2^2^3001004"
^DIC(9.4,52,22,28,"PAH",163,1,1,0)="Build for correction of the Delinquent Approvals Report, of the Purchase"
^DIC(9.4,52,22,28,"PAH",163,1,2,0)="Card module."
^DIC(9.4,52,22,28,"PAH",164,0)="260 SEQ #231^3001004^1"
^DIC(9.4,52,22,28,"PAH",164,1,0)="^^3^3^3001004"
^DIC(9.4,52,22,28,"PAH",164,1,1,0)="This patch corrects an <UNDEFINED> error that occurs when printing a"
^DIC(9.4,52,22,28,"PAH",164,1,2,0)="Purchase Order form and the Purchasing Agent/Contracting Officer on the PO"
^DIC(9.4,52,22,28,"PAH",164,1,3,0)="does not exist in the New Person file (#200)."
^DIC(9.4,52,22,28,"PAH","B",17,13)=""
^DIC(9.4,52,22,28,"PAH","B",42,5)=""
^DIC(9.4,52,22,28,"PAH","B",48,11)=""
