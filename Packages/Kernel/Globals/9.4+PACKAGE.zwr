^DIC(9.4,4,22,1,"PAH",114,1,49,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",114,1,50,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",114,1,51,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",114,1,52,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",114,1,53,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",114,1,54,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",114,1,55,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",114,1,56,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",114,1,57,0)=" Select INSTALL NAME:    XM*7.1*144    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",114,1,58,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",114,1,59,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",114,1,60,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",114,1,61,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",114,1,62,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",114,1,63,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",114,1,64,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",114,1,65,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",114,1,66,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",114,1,67,0)=""
^DIC(9.4,4,22,1,"PAH",114,1,68,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",114,1,69,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",114,1,70,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",114,1,71,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",115,0)="142 SEQ #140^3000905^1"
^DIC(9.4,4,22,1,"PAH",115,1,0)="^^105^105^3000905"
^DIC(9.4,4,22,1,"PAH",115,1,1,0)="Patch XM*7.1*142"
^DIC(9.4,4,22,1,"PAH",115,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,3,0)="Test Site:  Tampa, FL"
^DIC(9.4,4,22,1,"PAH",115,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,5,0)="NOIS: ISB-0700-32092, CMC-1299-30434, CMC-0200-31328, CMH-1199-N1398,"
^DIC(9.4,4,22,1,"PAH",115,1,6,0)="      CML-0700-41882, CMP-0700-61026, TAM-0300-33196"
^DIC(9.4,4,22,1,"PAH",115,1,7,0)="Improve remote transmit process by eliminating the phantom task number"
^DIC(9.4,4,22,1,"PAH",115,1,8,0)="field in piece 2 of the zero node for entries in file 4.2999."
^DIC(9.4,4,22,1,"PAH",115,1,9,0)="This field is not in the data dictionary, and yet was being used, and"
^DIC(9.4,4,22,1,"PAH",115,1,10,0)="duplicated field 25, TRANSMISSION TASK#.  All routines which reference"
^DIC(9.4,4,22,1,"PAH",115,1,11,0)="the phantom field now reference field 25.  The pre-init with this patch"
^DIC(9.4,4,22,1,"PAH",115,1,12,0)="will set the phantom field for entries in file 4.2999 to null."
^DIC(9.4,4,22,1,"PAH",115,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,14,0)="This patch also 'new's the variable ZTSYNC before creating the task to"
^DIC(9.4,4,22,1,"PAH",115,1,15,0)="transmit messages to a remote site.  (This will prevent ""bleeding"" of"
^DIC(9.4,4,22,1,"PAH",115,1,16,0)="SYNC FLAGs used by applications to ensure that tasks are run in sequence,"
^DIC(9.4,4,22,1,"PAH",115,1,17,0)="and then only if the preceding task completed successfully.)"
^DIC(9.4,4,22,1,"PAH",115,1,18,0)="Such SYNC FLAGs are not applicable to MailMan. "
^DIC(9.4,4,22,1,"PAH",115,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,20,0)="NOTE: This patch requires MailMan patch XM*7.1*97, XM*7.1*107,"
^DIC(9.4,4,22,1,"PAH",115,1,21,0)="and XM*7.1*127."
^DIC(9.4,4,22,1,"PAH",115,1,22,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",115,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,24,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",115,1,25,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",115,1,26,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",115,1,27,0)=" "
^DIC(9.4,4,22,1,"PAH",115,1,28,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",115,1,29,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",115,1,30,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",115,1,31,0)="XMB            4363515         3744054        3,7,24,26,27,50,142"
^DIC(9.4,4,22,1,"PAH",115,1,32,0)="XMBPOST        9626449         8035121        4,13,23,24,27,38,50,142"
^DIC(9.4,4,22,1,"PAH",115,1,33,0)="XMC2          12105966        11919093        13,23,27,50,142"
^DIC(9.4,4,22,1,"PAH",115,1,34,0)="XMKPL          2060011         2875442        50,142"
^DIC(9.4,4,22,1,"PAH",115,1,35,0)="XMKPLQ         9249196         5786623        50,142"
^DIC(9.4,4,22,1,"PAH",115,1,36,0)="XMKPO          2606344         3092912        50,142"
^DIC(9.4,4,22,1,"PAH",115,1,37,0)="XMS0           9308250         9155857        13,8,20,23,27,34,55,50,142"
^DIC(9.4,4,22,1,"PAH",115,1,38,0)="XMS5          13329767        13300220        13,8,23,27,55,58,50,142"
^DIC(9.4,4,22,1,"PAH",115,1,39,0)="XMS5B          4006973         4007283        13,23,142"
^DIC(9.4,4,22,1,"PAH",115,1,40,0)="XMTDF          4326406         4390490        50,127,142"
^DIC(9.4,4,22,1,"PAH",115,1,41,0)="XMTDL         18497319        18718545        50,97,142"
^DIC(9.4,4,22,1,"PAH",115,1,42,0)="XMTDL1         5049974         4584627        50,107,142"
^DIC(9.4,4,22,1,"PAH",115,1,43,0)="XMTDT          5385940         5589575        50,142"
^DIC(9.4,4,22,1,"PAH",115,1,44,0)="XMYPRE8        * NEW *          228290        142"
^DIC(9.4,4,22,1,"PAH",115,1,45,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,46,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",115,1,47,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,48,0)="This patch introduces the following new routines:"
^DIC(9.4,4,22,1,"PAH",115,1,49,0)="XMYPRE8  has no user callable entry points."
^DIC(9.4,4,22,1,"PAH",115,1,50,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",115,1,51,0)=" "
^DIC(9.4,4,22,1,"PAH",115,1,52,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",115,1,53,0)="NOTE: This patch requires MailMan patch XM*7.1*97, XM*7.1*107,"
^DIC(9.4,4,22,1,"PAH",115,1,54,0)="and XM*7.1*127."
^DIC(9.4,4,22,1,"PAH",115,1,55,0)="1.  Users should not be on the system during patch installation."
^DIC(9.4,4,22,1,"PAH",115,1,56,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",115,1,57,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",115,1,58,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",115,1,59,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",115,1,60,0)="4.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",115,1,61,0)="    option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",115,1,62,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",115,1,63,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",115,1,64,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",115,1,65,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",115,1,66,0)="5.  Stop TaskMan.  Shut down the listeners.  You may also wish to shut down"
^DIC(9.4,4,22,1,"PAH",115,1,67,0)="    HL7 filers/LLP's and other background tasks which may attempt to create"
^DIC(9.4,4,22,1,"PAH",115,1,68,0)="    new messages.  During the installation of this patch, we do not want any"
^DIC(9.4,4,22,1,"PAH",115,1,69,0)="    messages coming in or going out.  Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",115,1,70,0)="6.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",115,1,71,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",115,1,72,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",115,1,73,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",115,1,74,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",115,1,75,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",115,1,76,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",115,1,77,0)=" Select INSTALL NAME:    XM*7.1*142     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",115,1,78,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",115,1,79,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",115,1,80,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,4,22,1,"PAH",115,1,81,0)="                                                       ==="
^DIC(9.4,4,22,1,"PAH",115,1,82,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// YES"
^DIC(9.4,4,22,1,"PAH",115,1,83,0)="                                                                       ==="
^DIC(9.4,4,22,1,"PAH",115,1,84,0)=" Enter options you wish to mark as 'Out Of Order': XMUSER       MailMan Menu"
^DIC(9.4,4,22,1,"PAH",115,1,85,0)="                                                   ======"
^DIC(9.4,4,22,1,"PAH",115,1,86,0)=" Enter options you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",115,1,87,0)="                                                   =============="
^DIC(9.4,4,22,1,"PAH",115,1,88,0)=" Enter protocols you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",115,1,89,0)="                                                     =============="
^DIC(9.4,4,22,1,"PAH",115,1,90,0)=" Delay Install (Minutes):  (0-60): 0// <press return>"
^DIC(9.4,4,22,1,"PAH",115,1,91,0)="                                       =============="
^DIC(9.4,4,22,1,"PAH",115,1,92,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",115,1,93,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",115,1,94,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",115,1,95,0)=""
^DIC(9.4,4,22,1,"PAH",115,1,96,0)=" DEVICE: HOME// <Do not queue this.>"
^DIC(9.4,4,22,1,"PAH",115,1,97,0)="                --------------------"
^DIC(9.4,4,22,1,"PAH",115,1,98,0)="7.  Start TaskMan.  If you shut down HL7 filers/LLP's and other"
^DIC(9.4,4,22,1,"PAH",115,1,99,0)="    background tasks in step 4, be sure to restart them, too."
^DIC(9.4,4,22,1,"PAH",115,1,100,0)="8.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",115,1,101,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",115,1,102,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",115,1,103,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",115,1,104,0)="9.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",115,1,105,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",116,0)="147 SEQ #141^3001004^1"
^DIC(9.4,4,22,1,"PAH",116,1,0)="^^61^61^3001004"
^DIC(9.4,4,22,1,"PAH",116,1,1,0)="Patch XM*7.1*147"
^DIC(9.4,4,22,1,"PAH",116,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",116,1,3,0)="NOIS: MIW-0900-41651"
^DIC(9.4,4,22,1,"PAH",116,1,4,0)="Test Sites:  Milwaukee, WI"
^DIC(9.4,4,22,1,"PAH",116,1,5,0)="This patch corrects an error which may occur in the second and subsequent"
^DIC(9.4,4,22,1,"PAH",116,1,6,0)="usages of SENDMSG^XMXAPI if one of the recipients is the sender of the"
^DIC(9.4,4,22,1,"PAH",116,1,7,0)="message and the input variable XMINSTR is used, but not newed. "
^DIC(9.4,4,22,1,"PAH",116,1,8,0)="The first usage causes XMINSTR(""SELF BSKT"") to be set to null.  The second"
^DIC(9.4,4,22,1,"PAH",116,1,9,0)="and subsequent usages fail to send the message because XMINSTR(""SELF BSKT"")"
^DIC(9.4,4,22,1,"PAH",116,1,10,0)="may not be null as an input value.  The correction is that MailMan will no"
^DIC(9.4,4,22,1,"PAH",116,1,11,0)="longer set XMINSTR(""SELF BSKT"") to null."
^DIC(9.4,4,22,1,"PAH",116,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",116,1,13,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",116,1,14,0)="is at a minimum.  It requires MailMan patch XM*7.1*119."
^DIC(9.4,4,22,1,"PAH",116,1,15,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",116,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",116,1,17,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",116,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",116,1,19,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",116,1,20,0)=" "
^DIC(9.4,4,22,1,"PAH",116,1,21,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",116,1,22,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",116,1,23,0)="-----------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",116,1,24,0)="XMKP          16947852        16261814        50,89,119,147"
^DIC(9.4,4,22,1,"PAH",116,1,25,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",116,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",116,1,27,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",116,1,28,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",116,1,29,0)=" "
^DIC(9.4,4,22,1,"PAH",116,1,30,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",116,1,31,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",116,1,32,0)="is at a minimum.  It requires MailMan patch XM*7.1*119."
^DIC(9.4,4,22,1,"PAH",116,1,33,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",116,1,34,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",116,1,35,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",116,1,36,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",116,1,37,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",116,1,38,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",116,1,39,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",116,1,40,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",116,1,41,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",116,1,42,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",116,1,43,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",116,1,44,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",116,1,45,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",116,1,46,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",116,1,47,0)=" Select INSTALL NAME:    XM*7.1*147    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",116,1,48,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",116,1,49,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",116,1,50,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",116,1,51,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",116,1,52,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",116,1,53,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",116,1,54,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",116,1,55,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",116,1,56,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",116,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",116,1,58,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",116,1,59,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",116,1,60,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",116,1,61,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",117,0)="146 SEQ #142^3001004^1"
^DIC(9.4,4,22,1,"PAH",117,1,0)="^^189^189^3001004"
^DIC(9.4,4,22,1,"PAH",117,1,1,0)="Patch XM*7.1*146"
^DIC(9.4,4,22,1,"PAH",117,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,3,0)="E3R: 3764"
^DIC(9.4,4,22,1,"PAH",117,1,4,0)="Test Site: Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",117,1,5,0)="Let the user search the Message file for messages using the same criteria"
^DIC(9.4,4,22,1,"PAH",117,1,6,0)="available when searching one's mailbox.  The user would be limited to"
^DIC(9.4,4,22,1,"PAH",117,1,7,0)="messages sent to or sent by the user."
^DIC(9.4,4,22,1,"PAH",117,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,9,0)="NOIS: IOW-0500-42246"
^DIC(9.4,4,22,1,"PAH",117,1,10,0)="E3R: 8432"
^DIC(9.4,4,22,1,"PAH",117,1,11,0)="Test Site: White River Junction, VT"
^DIC(9.4,4,22,1,"PAH",117,1,12,0)="Let authorized users search the Message file for messages based on the same"
^DIC(9.4,4,22,1,"PAH",117,1,13,0)="search criteria one can use when one is searching for one's own messages."
^DIC(9.4,4,22,1,"PAH",117,1,14,0)="The user would be able to search every message."
^DIC(9.4,4,22,1,"PAH",117,1,15,0)="Among other uses would be the ability to follow up on EEO harassment cases"
^DIC(9.4,4,22,1,"PAH",117,1,16,0)="in which the offending user harassed via MailMan messages."
^DIC(9.4,4,22,1,"PAH",117,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,18,0)="This patch improves the message search capability."
^DIC(9.4,4,22,1,"PAH",117,1,19,0)="- The Postmaster is now able to search the remote transmit queues."
^DIC(9.4,4,22,1,"PAH",117,1,20,0)="- You are now able to search for messages that have a certain number of"
^DIC(9.4,4,22,1,"PAH",117,1,21,0)="lines of text or more."
^DIC(9.4,4,22,1,"PAH",117,1,22,0)="- You are now able to search the MESSAGE file using all the criteria"
^DIC(9.4,4,22,1,"PAH",117,1,23,0)="available when searching your own mailbox."
^DIC(9.4,4,22,1,"PAH",117,1,24,0)="- Help frames have been updated, and new help frames have been added to"
^DIC(9.4,4,22,1,"PAH",117,1,25,0)="reflect the changes."
^DIC(9.4,4,22,1,"PAH",117,1,26,0)="- The API LISTMSGS^XMXAPIB has been improved to incorporate the changes, too."
^DIC(9.4,4,22,1,"PAH",117,1,27,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,28,0)="The following entries have been added to their respective files:"
^DIC(9.4,4,22,1,"PAH",117,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,30,0)="OUTPUT FROM WHAT FILE: 19  OPTION"
^DIC(9.4,4,22,1,"PAH",117,1,31,0)="(This option has been added to the XMMGR 'Manage MailMan' menu.)"
^DIC(9.4,4,22,1,"PAH",117,1,32,0)="NAME: XM SUPER SEARCH                   MENU TEXT: Super Search Message File"
^DIC(9.4,4,22,1,"PAH",117,1,33,0)="  TYPE: run routine                     CREATOR: BEUSCHEL,GARY"
^DIC(9.4,4,22,1,"PAH",117,1,34,0)="  LOCK: XM SUPER SEARCH                 PACKAGE: MAILMAN"
^DIC(9.4,4,22,1,"PAH",117,1,35,0)=" DESCRIPTION:   This option lets the authorized user (anyone holding the XM"
^DIC(9.4,4,22,1,"PAH",117,1,36,0)=" SUPER SEARCH key) search the Message file for messages meeting any number of"
^DIC(9.4,4,22,1,"PAH",117,1,37,0)=" criteria, no matter who sent the messages."
^DIC(9.4,4,22,1,"PAH",117,1,38,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,39,0)=" This option should not be used lightly.  One example in which usage is"
^DIC(9.4,4,22,1,"PAH",117,1,40,0)=" justified would be the search for evidence in an EEO harassment case."
^DIC(9.4,4,22,1,"PAH",117,1,41,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,42,0)=" This option should be audited to track who uses it."
^DIC(9.4,4,22,1,"PAH",117,1,43,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,44,0)=" Every search will trigger the sending of the XM SUPER SEARCH bulletin to the"
^DIC(9.4,4,22,1,"PAH",117,1,45,0)=" XM SUPER SEARCH mail group.  The bulletin will record who (DUZ) conducted"
^DIC(9.4,4,22,1,"PAH",117,1,46,0)=" the  search and what criteria were used.  It will not record the results of"
^DIC(9.4,4,22,1,"PAH",117,1,47,0)=" the search."
^DIC(9.4,4,22,1,"PAH",117,1,48,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,49,0)=" The XM SUPER SEARCH mail group must have at least two active local users in"
^DIC(9.4,4,22,1,"PAH",117,1,50,0)=" it  who have logged on recently.  If it doesn't, the search will not be"
^DIC(9.4,4,22,1,"PAH",117,1,51,0)=" performed.  Members of this mail group should be anyone whose responsibility"
^DIC(9.4,4,22,1,"PAH",117,1,52,0)=" it is to ensure that security is maintained and privileges are not abused."
^DIC(9.4,4,22,1,"PAH",117,1,53,0)=" The mail group coordinator should be the site's Information Security Officer"
^DIC(9.4,4,22,1,"PAH",117,1,54,0)=" or another responsible individual."
^DIC(9.4,4,22,1,"PAH",117,1,55,0)="  ROUTINE: SUPER^XMJMF"
^DIC(9.4,4,22,1,"PAH",117,1,56,0)="  UPPERCASE MENU TEXT: SUPER SEARCH MESSAGE FILE"
^DIC(9.4,4,22,1,"PAH",117,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,58,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,59,0)="OUTPUT FROM WHAT FILE: SECURITY KEY"
^DIC(9.4,4,22,1,"PAH",117,1,60,0)="NAME: XM SUPER SEARCH                   DESCRIPTIVE NAME: Search all messages"
^DIC(9.4,4,22,1,"PAH",117,1,61,0)=" DESCRIPTION:   This key lets the user use the option XM SUPER SEARCH, which"
^DIC(9.4,4,22,1,"PAH",117,1,62,0)=" performs a search for messages in the MESSAGE file based on multiple"
^DIC(9.4,4,22,1,"PAH",117,1,63,0)=" criteria.  This key should be given, on a time-limited basis, to trusted"
^DIC(9.4,4,22,1,"PAH",117,1,64,0)=" individuals who have a valid need to research messages in the MESSAGE file."
^DIC(9.4,4,22,1,"PAH",117,1,65,0)=" For example, in sexual or other harassment cases, in which the harassment is"
^DIC(9.4,4,22,1,"PAH",117,1,66,0)=" in the form of MailMan messages."
^DIC(9.4,4,22,1,"PAH",117,1,67,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,68,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,69,0)="OUTPUT FROM WHAT FILE: 3.6  BULLETIN"
^DIC(9.4,4,22,1,"PAH",117,1,70,0)="NAME: XM SUPER SEARCH                   SUBJECT: Super Search Conducted"
^DIC(9.4,4,22,1,"PAH",117,1,71,0)="  RETENTION DAYS: 90"
^DIC(9.4,4,22,1,"PAH",117,1,72,0)=" MESSAGE:   |1| conducted a Super Search of the Message file.  The criteria"
^DIC(9.4,4,22,1,"PAH",117,1,73,0)=" used were:"
^DIC(9.4,4,22,1,"PAH",117,1,74,0)=" DESCRIPTION:   Every time a super search is conducted, this bulletin is sent"
^DIC(9.4,4,22,1,"PAH",117,1,75,0)=" to alert those responsible for ensuring that the capability is not misused."
^DIC(9.4,4,22,1,"PAH",117,1,76,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,77,0)=" A super search is a search of the entire Message file based on any number of"
^DIC(9.4,4,22,1,"PAH",117,1,78,0)=" criteria.  All messages are looked at, regardless of who sent them."
^DIC(9.4,4,22,1,"PAH",117,1,79,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,80,0)=" This bulletin reports who performed the search and what criteria were used."
^DIC(9.4,4,22,1,"PAH",117,1,81,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,82,0)=" This bulletin is sent to the mail group XM SUPER SEARCH.  The ISO should be"
^DIC(9.4,4,22,1,"PAH",117,1,83,0)=" a member of that group."
^DIC(9.4,4,22,1,"PAH",117,1,84,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,85,0)=" See the XM SUPER SEARCH option for more information."
^DIC(9.4,4,22,1,"PAH",117,1,86,0)="PARAMETER: 1"
^DIC(9.4,4,22,1,"PAH",117,1,87,0)=" DESCRIPTION:   The user who conducted the Super Search."
^DIC(9.4,4,22,1,"PAH",117,1,88,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,89,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,90,0)="OUTPUT FROM WHAT FILE: 3.8  MAIL GROUP"
^DIC(9.4,4,22,1,"PAH",117,1,91,0)="NAME: XM SUPER SEARCH                   TYPE: public"
^DIC(9.4,4,22,1,"PAH",117,1,92,0)="  ALLOW SELF ENROLLMENT?: NO"
^DIC(9.4,4,22,1,"PAH",117,1,93,0)=" DESCRIPTION:   This mail group is sent a bulletin whenever someone conducts"
^DIC(9.4,4,22,1,"PAH",117,1,94,0)=" a Super Search using the XM SUPER SEARCH option.  The bulletin tells who"
^DIC(9.4,4,22,1,"PAH",117,1,95,0)=" conducted the search and what search criteria were used."
^DIC(9.4,4,22,1,"PAH",117,1,96,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,97,0)=" Members of this mail group should be anyone who ought to be notified"
^DIC(9.4,4,22,1,"PAH",117,1,98,0)=" whenever a Super Search is conducted.  At an absolute minimum, the site ISO"
^DIC(9.4,4,22,1,"PAH",117,1,99,0)=" and alternate ISO(s) should be members.  There should be enough responsible"
^DIC(9.4,4,22,1,"PAH",117,1,100,0)=" members of the group so that a certain level of comfort is achieved that the"
^DIC(9.4,4,22,1,"PAH",117,1,101,0)=" Super Searches will only be conducted for just cause.  The more people there"
^DIC(9.4,4,22,1,"PAH",117,1,102,0)=" are, who are aware that a Super Search has been conducted, the less likely"
^DIC(9.4,4,22,1,"PAH",117,1,103,0)=" it is that the capability will be abused."
^DIC(9.4,4,22,1,"PAH",117,1,104,0)="  "
^DIC(9.4,4,22,1,"PAH",117,1,105,0)=" The site Information Security Officer should be the coordinator of this"
^DIC(9.4,4,22,1,"PAH",117,1,106,0)=" group."
^DIC(9.4,4,22,1,"PAH",117,1,107,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,108,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,109,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",117,1,110,0)="is at a minimum.  It requires MailMan patches XM*7.1*108, XM*7.1*109,"
^DIC(9.4,4,22,1,"PAH",117,1,111,0)="& XM*7.1*144."
^DIC(9.4,4,22,1,"PAH",117,1,112,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",117,1,113,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,114,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",117,1,115,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",117,1,116,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",117,1,117,0)=" "
^DIC(9.4,4,22,1,"PAH",117,1,118,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",117,1,119,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",117,1,120,0)="-----------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",117,1,121,0)="XMJDIR         5458230         6123825        50,110,140,144,146"
^DIC(9.4,4,22,1,"PAH",117,1,122,0)="XMJERR          375961          374282        50,144,146"
^DIC(9.4,4,22,1,"PAH",117,1,123,0)="XMJMF         18005162         3844343        50,146"
^DIC(9.4,4,22,1,"PAH",117,1,124,0)="XMJMF1         * NEW *        11694773        146"
^DIC(9.4,4,22,1,"PAH",117,1,125,0)="XMJMF2         * NEW *         6206910        146"
^DIC(9.4,4,22,1,"PAH",117,1,126,0)="XMJMFA         6784168         6729708        50,110,131,146"
^DIC(9.4,4,22,1,"PAH",117,1,127,0)="XMJMFB        15929930        16215095        50,110,131,146"
^DIC(9.4,4,22,1,"PAH",117,1,128,0)="XMJMFC         * NEW *        11137057        146"
^DIC(9.4,4,22,1,"PAH",117,1,129,0)="XMJMOI        18282681        18383177        50,87,89,110,127,131,143,146"
^DIC(9.4,4,22,1,"PAH",117,1,130,0)="XMXAPIG        1672216         1692175        109,146"
^DIC(9.4,4,22,1,"PAH",117,1,131,0)="XMXLIST       10491222         6225911        50,108,146"
^DIC(9.4,4,22,1,"PAH",117,1,132,0)="XMXLIST1      12617251        12801864        50,108,146"
^DIC(9.4,4,22,1,"PAH",117,1,133,0)="XMXLIST2       * NEW *         6802380        146"
^DIC(9.4,4,22,1,"PAH",117,1,134,0)="XMXPARMB       3879548         3923435        50,144,146"
^DIC(9.4,4,22,1,"PAH",117,1,135,0)="XMXSEC1       12312603        12986076        50,95,110,130,131,146"
^DIC(9.4,4,22,1,"PAH",117,1,136,0)="XMXSEC2       27323685        27320982        50,89,95,110"
^DIC(9.4,4,22,1,"PAH",117,1,137,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",117,1,138,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,139,0)="This patch introduces the following new routines.  They have no callable"
^DIC(9.4,4,22,1,"PAH",117,1,140,0)="entry points:"
^DIC(9.4,4,22,1,"PAH",117,1,141,0)="XMJMF1"
^DIC(9.4,4,22,1,"PAH",117,1,142,0)="XMJMF2"
^DIC(9.4,4,22,1,"PAH",117,1,143,0)="XMJMFC"
^DIC(9.4,4,22,1,"PAH",117,1,144,0)="XMXLIST2"
^DIC(9.4,4,22,1,"PAH",117,1,145,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,146,0)="This patch introduces the following new APIs:"
^DIC(9.4,4,22,1,"PAH",117,1,147,0)="$$SSPRIV^XMXSEC1 - Is the user allowed to Super Search?"
^DIC(9.4,4,22,1,"PAH",117,1,148,0)="$$ZSSPRIV^XMXSEC1 - Is the user allowed to Super Search?"
^DIC(9.4,4,22,1,"PAH",117,1,149,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",117,1,150,0)=" "
^DIC(9.4,4,22,1,"PAH",117,1,151,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",117,1,152,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",117,1,153,0)="is at a minimum.  It requires MailMan patches XM*7.1*108, XM*7.1*109,"
^DIC(9.4,4,22,1,"PAH",117,1,154,0)="& XM*7.1*144."
^DIC(9.4,4,22,1,"PAH",117,1,155,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",117,1,156,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",117,1,157,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",117,1,158,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",117,1,159,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",117,1,160,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",117,1,161,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",117,1,162,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",117,1,163,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",117,1,164,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",117,1,165,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",117,1,166,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",117,1,167,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",117,1,168,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",117,1,169,0)=" Select INSTALL NAME:    XM*7.1*146    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",117,1,170,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",117,1,171,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",117,1,172,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,173,0)=" Incoming Mail Groups:"
^DIC(9.4,4,22,1,"PAH",117,1,174,0)=" Enter the Coordinator for Mail Group 'XM SUPER SEARCH': <Your site's ISO>"
^DIC(9.4,4,22,1,"PAH",117,1,175,0)="                                                         ================="
^DIC(9.4,4,22,1,"PAH",117,1,176,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,4,22,1,"PAH",117,1,177,0)="                                                                   ==="
^DIC(9.4,4,22,1,"PAH",117,1,178,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",117,1,179,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",117,1,180,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",117,1,181,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",117,1,182,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",117,1,183,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",117,1,184,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",117,1,185,0)=""
^DIC(9.4,4,22,1,"PAH",117,1,186,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",117,1,187,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",117,1,188,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",117,1,189,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",118,0)="148 SEQ #143^3001012^1"
^DIC(9.4,4,22,1,"PAH",118,1,0)="^^85^85^3001012"
^DIC(9.4,4,22,1,"PAH",118,1,1,0)="Patch XM*7.1*148"
^DIC(9.4,4,22,1,"PAH",118,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,3,0)="NOIS: MON-0800-51277"
^DIC(9.4,4,22,1,"PAH",118,1,4,0)="Test Site: Montana HCS"
^DIC(9.4,4,22,1,"PAH",118,1,5,0)="When user backs up on a broadcast message with a response, default to 0,"
^DIC(9.4,4,22,1,"PAH",118,1,6,0)="instead of 1."
^DIC(9.4,4,22,1,"PAH",118,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,8,0)="This patch also:"
^DIC(9.4,4,22,1,"PAH",118,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,10,0)="1. Prevents the Postmaster from BRowsing messages in the transmit queues."
^DIC(9.4,4,22,1,"PAH",118,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,12,0)="2. Improves error tracking during message addressing:"
^DIC(9.4,4,22,1,"PAH",118,1,13,0)="- If you address a message to a mail group with no members, you will be"
^DIC(9.4,4,22,1,"PAH",118,1,14,0)="informed that the group has no members."
^DIC(9.4,4,22,1,"PAH",118,1,15,0)="- ^TMP(""XMERR"",$J) for message addressing API errors now contains:"
^DIC(9.4,4,22,1,"PAH",118,1,16,0)="^TMP(""XMERR"",$J,<error #>)=<dialog #>"
^DIC(9.4,4,22,1,"PAH",118,1,17,0)="^TMP(""XMERR"",$J,<error #>,""PARAM"",""ID"")=""XMTO"""
^DIC(9.4,4,22,1,"PAH",118,1,18,0)="^TMP(""XMERR"",$J,<error #>,""PARAM"",""VALUE"")=<recipient>"
^DIC(9.4,4,22,1,"PAH",118,1,19,0)="^TMP(""XMERR"",$J,<error #>,""TEXT"",<i>)=<line i of error message>"
^DIC(9.4,4,22,1,"PAH",118,1,20,0)="^TMP(""XMERR"",$J,""E"",<dialog #>,<error #>)="""""
^DIC(9.4,4,22,1,"PAH",118,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,22,0)="The pre-init with this patch deletes three DIALOG file entries which are"
^DIC(9.4,4,22,1,"PAH",118,1,23,0)="being replaced with new ones."
^DIC(9.4,4,22,1,"PAH",118,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,25,0)="NOTE: This patch requires MailMan patches XM*7.1*133, XM*7.1*134,"
^DIC(9.4,4,22,1,"PAH",118,1,26,0)="XM*7.1*138, XM*7.1*139, & XM*7.1*146."
^DIC(9.4,4,22,1,"PAH",118,1,27,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",118,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,29,0)="ROUTINES:"
