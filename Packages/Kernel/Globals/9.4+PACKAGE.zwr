^DIC(9.4,5,22,13,"PAH",7,1,61,0)="XTRUTL2                  361405    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,62,0)="XTSUMBLD     11338949  12015543    **11,20**"
^DIC(9.4,5,22,13,"PAH",7,1,63,0)="XTVNUM        7898211   9944358    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,64,0)="ZTP1         11606940   8017158    **20**"
