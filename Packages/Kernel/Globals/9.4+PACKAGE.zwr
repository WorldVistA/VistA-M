^DIC(9.4,3,22,21,"PAH",266,0)="334 SEQ #275^3031231^1"
^DIC(9.4,3,22,21,"PAH",266,1,0)="^^64^64^3031231"
^DIC(9.4,3,22,21,"PAH",266,1,1,0)="Patch XU*8.0*334"
^DIC(9.4,3,22,21,"PAH",266,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,3,0)="   This patch updates the HOLIDAY (# 40.5) file. A new holiday entry is "
^DIC(9.4,3,22,21,"PAH",266,1,4,0)="   added in the HOLIDAY (#40.5) file for the holiday on December 26, 2003."
^DIC(9.4,3,22,21,"PAH",266,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,6,0)="   New entry:"
^DIC(9.4,3,22,21,"PAH",266,1,7,0)="   ^HOLIDAY(3031226,0) = 3031226^December 26, 2003"
^DIC(9.4,3,22,21,"PAH",266,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,9,0)="   The ""B"" cross-reference of the new entry:"
^DIC(9.4,3,22,21,"PAH",266,1,10,0)="   ^HOLIDAY(""B"",3031226,3031226) ="
^DIC(9.4,3,22,21,"PAH",266,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,13,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",266,1,14,0)="================"
^DIC(9.4,3,22,21,"PAH",266,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,16,0)="The following routine is included in this patch. The second line of "
^DIC(9.4,3,22,21,"PAH",266,1,17,0)="the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",266,1,18,0)="<tab;;8.0;KERNEL;**[Patches List]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",266,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,20,0)="Checksums:"
^DIC(9.4,3,22,21,"PAH",266,1,21,0)="========="
^DIC(9.4,3,22,21,"PAH",266,1,22,0)="Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",266,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,24,0)="Routine    Chksum Before   Chksum After   Patch List"
^DIC(9.4,3,22,21,"PAH",266,1,25,0)="-----     -------------   ------------   ----------"
^DIC(9.4,3,22,21,"PAH",266,1,26,0)="XU8P334        NEW                         **334**"
^DIC(9.4,3,22,21,"PAH",266,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,28,0)="This routine is set to delete after the installation, so you may not"
^DIC(9.4,3,22,21,"PAH",266,1,29,0)="do the checksum for the routine. "
^DIC(9.4,3,22,21,"PAH",266,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,31,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",266,1,32,0)="============================="
^DIC(9.4,3,22,21,"PAH",266,1,33,0)="Blood Bank Clearance -"
^DIC(9.4,3,22,21,"PAH",266,1,34,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,35,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",266,1,36,0)="=========================="
^DIC(9.4,3,22,21,"PAH",266,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,38,0)="1. Users ARE allowed to be on the system during the installation. "
^DIC(9.4,3,22,21,"PAH",266,1,39,0)="   However, it is recommended that the patch be installed during"
^DIC(9.4,3,22,21,"PAH",266,1,40,0)="   non-peak time. It will take about five minutes to install the"
^DIC(9.4,3,22,21,"PAH",266,1,41,0)="   patch, but you may queue the installation if you wish."
^DIC(9.4,3,22,21,"PAH",266,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,43,0)="2. You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",266,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,45,0)="3. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This      "
^DIC(9.4,3,22,21,"PAH",266,1,46,0)="   option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",266,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,48,0)="4. The patch has now been loaded into a Transport global on your system. "
^DIC(9.4,3,22,21,"PAH",266,1,49,0)="   You now need to use KIDS to install the Transport global. On the KIDS"
^DIC(9.4,3,22,21,"PAH",266,1,50,0)="   menu, under the 'Installation' menu, use the following options:"
^DIC(9.4,3,22,21,"PAH",266,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,52,0)="                Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",266,1,53,0)="                Print Transport Global"
^DIC(9.4,3,22,21,"PAH",266,1,54,0)="                Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",266,1,55,0)="                Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",266,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",266,1,57,0)="   On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",266,1,58,0)="   option:"
^DIC(9.4,3,22,21,"PAH",266,1,59,0)="                Install Package(s)  "
^DIC(9.4,3,22,21,"PAH",266,1,60,0)="                Select INSTALL NAME:XU*8.0*334"
^DIC(9.4,3,22,21,"PAH",266,1,61,0)="                                    =========="
^DIC(9.4,3,22,21,"PAH",266,1,62,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",266,1,63,0)="                                                              =="
^DIC(9.4,3,22,21,"PAH",266,1,64,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
