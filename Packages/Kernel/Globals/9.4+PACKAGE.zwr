^DIC(9.4,4,22,1,"PAH",71,0)="99 SEQ #96^2991019^1"
^DIC(9.4,4,22,1,"PAH",71,1,0)="^^78^78^2991019"
^DIC(9.4,4,22,1,"PAH",71,1,1,0)="Patch XM*7.1*99"
^DIC(9.4,4,22,1,"PAH",71,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,3,0)="NOIS:  none"
^DIC(9.4,4,22,1,"PAH",71,1,4,0)="Test Site:  CIOFO-SAN FRANCISCO"
^DIC(9.4,4,22,1,"PAH",71,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,6,0)="The pre-init for MailMan patch XM*7.1*50 deleted unneeded fields from the"
^DIC(9.4,4,22,1,"PAH",71,1,7,0)="data dictionary and the globals."
^DIC(9.4,4,22,1,"PAH",71,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,9,0)="To decide whether it should run (and to prevent it from running twice),"
^DIC(9.4,4,22,1,"PAH",71,1,10,0)="it checked for the presence of a global node (^XMBPOST(""POST"")).  Any"
^DIC(9.4,4,22,1,"PAH",71,1,11,0)="account in which anyone had ever sent a response would have had this node."
^DIC(9.4,4,22,1,"PAH",71,1,12,0)="Some development accounts didn't have this node, so the pre-init did not"
^DIC(9.4,4,22,1,"PAH",71,1,13,0)="run."
^DIC(9.4,4,22,1,"PAH",71,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,15,0)="This patch checks for the presence of a different node to determine whether"
^DIC(9.4,4,22,1,"PAH",71,1,16,0)="the pre-init should run.  If it ran in patch XM*7.1*50, it won't run again,"
^DIC(9.4,4,22,1,"PAH",71,1,17,0)="but if it didn't run in patch XM*7.1*50, it will run."
^DIC(9.4,4,22,1,"PAH",71,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,19,0)="This patch also:"
^DIC(9.4,4,22,1,"PAH",71,1,20,0)="- resends the DDs for files 3.7, 3.9, 4.2999, and 4.3.  No changes are made"
^DIC(9.4,4,22,1,"PAH",71,1,21,0)="to the DDs.  We just want to ensure that sites have the full and correct DDs."
^DIC(9.4,4,22,1,"PAH",71,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,23,0)="- corrects an incorrect patch list in the second line of routine ^XMXREPLY."
^DIC(9.4,4,22,1,"PAH",71,1,24,0)="It changes 84 to 85.  (NOIS ISB-1099-30184: Patch XM*7.1*85 created an"
^DIC(9.4,4,22,1,"PAH",71,1,25,0)="incorrect patch list in routine ^XMXREPLY.)"
^DIC(9.4,4,22,1,"PAH",71,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,27,0)="- prevents an error message from being sent if a user up-arrows out of a"
^DIC(9.4,4,22,1,"PAH",71,1,28,0)="selection while addressing a group. "
^DIC(9.4,4,22,1,"PAH",71,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,30,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",71,1,31,0)="minimum.  It requires MailMan patch XM*7.1*85."
^DIC(9.4,4,22,1,"PAH",71,1,32,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",71,1,33,0)=""
^DIC(9.4,4,22,1,"PAH",71,1,34,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",71,1,35,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",71,1,36,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",71,1,37,0)=" "
^DIC(9.4,4,22,1,"PAH",71,1,38,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",71,1,39,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",71,1,40,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",71,1,41,0)="XMXADDRG       15430701       15444713        50,99"
^DIC(9.4,4,22,1,"PAH",71,1,42,0)="XMXREPLY        5097167        5097167        50,85,99"
^DIC(9.4,4,22,1,"PAH",71,1,43,0)="XMYPRE6        * new *        12721120        99"
^DIC(9.4,4,22,1,"PAH",71,1,44,0)="XMYPRE6A       * new *        15207878        99"
