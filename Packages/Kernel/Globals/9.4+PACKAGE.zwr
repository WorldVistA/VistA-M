^DIC(9.4,48,22,5.28,"PAH",209,1,0)="^^1^1^3030301"
^DIC(9.4,48,22,5.28,"PAH",209,1,1,0)="PCMM PATCH FOR SD*5.3*264"
^DIC(9.4,48,22,5.28,"PAH",210,0)="273 SEQ #252^3030301^1"
^DIC(9.4,48,22,5.28,"PAH",211,0)="280 SEQ #253^3030329^1"
^DIC(9.4,48,22,5.28,"PAH",212,0)="281 SEQ #254^3030403^1"
^DIC(9.4,48,22,5.28,"PAH",212,1,0)="^^4^4^3030403"
^DIC(9.4,48,22,5.28,"PAH",212,1,1,0)="When the option PRINT SCHEDULING LETTERS [SDPRLETTERS] is run, the "
^DIC(9.4,48,22,5.28,"PAH",212,1,2,0)="patient's confidential address will be printed if the patient has "
^DIC(9.4,48,22,5.28,"PAH",212,1,3,0)="requested that their Scheduling/Appointment correspondence be sent "
^DIC(9.4,48,22,5.28,"PAH",212,1,4,0)="to the confidential address."
