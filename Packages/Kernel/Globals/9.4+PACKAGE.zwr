^DIC(9.4,14,22,5.9,"PAH",209,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",209,1,110,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",209,1,111,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",209,1,112,0)="This patch is exported as part of VBECS_BUNDLE_1.KID.  Please refer to "
^DIC(9.4,14,22,5.9,"PAH",209,1,113,0)="VBEC*1*0 install instructions for installation sequence information. "
^DIC(9.4,14,22,5.9,"PAH",210,0)="309 SEQ #309^3090617.165042^17"
^DIC(9.4,14,22,5.9,"PAH",210,1,0)="^^344^344^3090617"
^DIC(9.4,14,22,5.9,"PAH",210,1,1,0)="BLOOD BANK"
^DIC(9.4,14,22,5.9,"PAH",210,1,2,0)="=========="
^DIC(9.4,14,22,5.9,"PAH",210,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,4,0)="VISTA Laboratory Package patch LR*5.2*309 contains changes to "
^DIC(9.4,14,22,5.9,"PAH",210,1,5,0)="software controlled by VHA DIRECTIVE 2004-058, titled VISTA "
^DIC(9.4,14,22,5.9,"PAH",210,1,6,0)="BLOOD BANK SOFTWARE. Changes include: "
^DIC(9.4,14,22,5.9,"PAH",210,1,7,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,8,0)=" File          Field               Action"
^DIC(9.4,14,22,5.9,"PAH",210,1,9,0)="   "
^DIC(9.4,14,22,5.9,"PAH",210,1,10,0)="63.09,20      DESCRIPTION         Delete"
^DIC(9.4,14,22,5.9,"PAH",210,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,12,0)="All of the above changes have been reviewed by the VISTA Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",210,1,13,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE"
^DIC(9.4,14,22,5.9,"PAH",210,1,14,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",210,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,16,0)="RISK ANALYSIS: Changes made by patch LR*5.2*309 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",210,1,17,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",210,1,18,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,19,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*309 does not"
^DIC(9.4,14,22,5.9,"PAH",210,1,20,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",210,1,21,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",210,1,22,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,23,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 0 routines"
^DIC(9.4,14,22,5.9,"PAH",210,1,24,0)="and 1 files identified in Veterans Health Administration (VHA) Directive"
^DIC(9.4,14,22,5.9,"PAH",210,1,25,0)="2004-058, group B listing. The changes have no effect on Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",210,1,26,0)="functionality or medical device control functions. There is no adverse"
^DIC(9.4,14,22,5.9,"PAH",210,1,27,0)="potential to sites."
^DIC(9.4,14,22,5.9,"PAH",210,1,28,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,29,0)="VALIDATION REQUIREMENTS BY OPTION: "
^DIC(9.4,14,22,5.9,"PAH",210,1,30,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,31,0)="There are no Validation requirements or options to be validated"
^DIC(9.4,14,22,5.9,"PAH",210,1,32,0)="in this patch."
^DIC(9.4,14,22,5.9,"PAH",210,1,33,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,34,0)="MINIMAL TEST CASE SCENARIOS BY OPTION, INCLUSIVE OF ALL CONTROL "
^DIC(9.4,14,22,5.9,"PAH",210,1,35,0)="FUNCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",210,1,36,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,37,0)="There are no Test Case Scenarios associated with this patch."
^DIC(9.4,14,22,5.9,"PAH",210,1,38,0)="   "
^DIC(9.4,14,22,5.9,"PAH",210,1,39,0)="DESCRIPTION: "
^DIC(9.4,14,22,5.9,"PAH",210,1,40,0)="============ "
^DIC(9.4,14,22,5.9,"PAH",210,1,41,0)="This patch removes one field, the DESCRIPTION field (#20), in the"
^DIC(9.4,14,22,5.9,"PAH",210,1,42,0)="LAB DATA file (#63) CYTOPATHOLOGY sub-file (#63.09), and a reference to"
^DIC(9.4,14,22,5.9,"PAH",210,1,43,0)="this field in routine ^LRAUAW."
^DIC(9.4,14,22,5.9,"PAH",210,1,44,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,45,0)="Although it is highly unlikely that data exists in the DESCRIPTION "
^DIC(9.4,14,22,5.9,"PAH",210,1,46,0)="field (#20), the patch also checks for data that may have been entered in"
^DIC(9.4,14,22,5.9,"PAH",210,1,47,0)="the field.  Any data that is found is moved to the ^XTMP(""LR309"")"
^DIC(9.4,14,22,5.9,"PAH",210,1,48,0)="global and stored for 180 days before it is purged. If data is found,"
^DIC(9.4,14,22,5.9,"PAH",210,1,49,0)="the installation routine also generates and sends a mail message to the"
^DIC(9.4,14,22,5.9,"PAH",210,1,50,0)="holders of security keys LRLIASON and LRAPSUPER to be used as a source"
^DIC(9.4,14,22,5.9,"PAH",210,1,51,0)="document to determine how the data should be handled if at all."
^DIC(9.4,14,22,5.9,"PAH",210,1,52,0)="The message contains the LR*5.2*309 Data Report which lists the data "
^DIC(9.4,14,22,5.9,"PAH",210,1,53,0)="found, the accession number, the patient's name, social security number"
^DIC(9.4,14,22,5.9,"PAH",210,1,54,0)="and gender."
^DIC(9.4,14,22,5.9,"PAH",210,1,55,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,56,0)="DATA DICTIONARY CHANGES: "
^DIC(9.4,14,22,5.9,"PAH",210,1,57,0)="======================== "
^DIC(9.4,14,22,5.9,"PAH",210,1,58,0)=" The following is a list of the Data Dictionary entry in LAB DATA file "
^DIC(9.4,14,22,5.9,"PAH",210,1,59,0)="(#63) that will be deleted by this patch:"
^DIC(9.4,14,22,5.9,"PAH",210,1,60,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,61,0)="63.09,20      DESCRIPTION            WP;0    WORD-PROCESSING #63.91"
^DIC(9.4,14,22,5.9,"PAH",210,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,63,0)="              DESCRIPTION:"
^DIC(9.4,14,22,5.9,"PAH",210,1,64,0)="                                Word processing field for description"
^DIC(9.4,14,22,5.9,"PAH",210,1,65,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,66,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,67,0)="MODIFICATION OF THE LRAUAW ROUTINE:"
^DIC(9.4,14,22,5.9,"PAH",210,1,68,0)="==================================="
^DIC(9.4,14,22,5.9,"PAH",210,1,69,0)="Patch LR*5.2*309 also makes changes to the LRAUAW routine to remove a"
^DIC(9.4,14,22,5.9,"PAH",210,1,70,0)="reference to the DESCRIPTION field (#20) of the CYTOPATHOLOGY sub-file"
^DIC(9.4,14,22,5.9,"PAH",210,1,71,0)="(#63.09) in the LAB DATA file (#63).  The change will be transparent to"
^DIC(9.4,14,22,5.9,"PAH",210,1,72,0)="the user."
^DIC(9.4,14,22,5.9,"PAH",210,1,73,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,74,0)="NEW SERVICE REQUEST (NSR): "
^DIC(9.4,14,22,5.9,"PAH",210,1,75,0)="========================== "
^DIC(9.4,14,22,5.9,"PAH",210,1,76,0)="N/A. "
^DIC(9.4,14,22,5.9,"PAH",210,1,77,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,78,0)="ASSOCIATED E3R: "
^DIC(9.4,14,22,5.9,"PAH",210,1,79,0)="=============== "
^DIC(9.4,14,22,5.9,"PAH",210,1,80,0)="N/A.                                                                     "
^DIC(9.4,14,22,5.9,"PAH",210,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,82,0)="ASSOCIATED NOIS: "
^DIC(9.4,14,22,5.9,"PAH",210,1,83,0)="================ "
^DIC(9.4,14,22,5.9,"PAH",210,1,84,0)="N/A. "
^DIC(9.4,14,22,5.9,"PAH",210,1,85,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,86,0)="ASSOCIATED REMEDY TICKETS: "
^DIC(9.4,14,22,5.9,"PAH",210,1,87,0)="========================== "
^DIC(9.4,14,22,5.9,"PAH",210,1,88,0)=" HD0000000093288 "
^DIC(9.4,14,22,5.9,"PAH",210,1,89,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,90,0)="TEST SITES: "
^DIC(9.4,14,22,5.9,"PAH",210,1,91,0)="=========== "
^DIC(9.4,14,22,5.9,"PAH",210,1,92,0)="   Altoona, PA - small"
^DIC(9.4,14,22,5.9,"PAH",210,1,93,0)="   Wilmington, DE - medium"
^DIC(9.4,14,22,5.9,"PAH",210,1,94,0)="   Biloxi, MS - large"
^DIC(9.4,14,22,5.9,"PAH",210,1,95,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,96,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,97,0)="SOFTWARE RETRIEVAL: "
^DIC(9.4,14,22,5.9,"PAH",210,1,98,0)="==================== "
^DIC(9.4,14,22,5.9,"PAH",210,1,99,0)=" This patch is distributed by KIDS as a Packman message. "
^DIC(9.4,14,22,5.9,"PAH",210,1,100,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,101,0)="INSTALLATION INSTRUCTIONS: "
^DIC(9.4,14,22,5.9,"PAH",210,1,102,0)="========================== "
^DIC(9.4,14,22,5.9,"PAH",210,1,103,0)="This patch can be installed with users on the system.  It is recommended "
^DIC(9.4,14,22,5.9,"PAH",210,1,104,0)="to disable the Anatomic Pathology [LRAP] option at the ""DISABLE Scheduled"
^DIC(9.4,14,22,5.9,"PAH",210,1,105,0)="Options, Menu Options, and Protocols?"" prompt."
^DIC(9.4,14,22,5.9,"PAH",210,1,106,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,107,0)="Install Time - less than 5 minutes. "
^DIC(9.4,14,22,5.9,"PAH",210,1,108,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,109,0)="1. Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu. This "
^DIC(9.4,14,22,5.9,"PAH",210,1,110,0)="   option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",210,1,111,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,112,0)="2. On the 'Kernel Installation & Distribution System' Menu (KIDS), select "
^DIC(9.4,14,22,5.9,"PAH",210,1,113,0)="   the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",210,1,114,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,115,0)="3. Use the 'Verify Checksum in Transport Global' option and verify that "
^DIC(9.4,14,22,5.9,"PAH",210,1,116,0)="   all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",210,1,117,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,118,0)="4. On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,14,22,5.9,"PAH",210,1,119,0)="   options: "
^DIC(9.4,14,22,5.9,"PAH",210,1,120,0)="        Print Transport Global "
^DIC(9.4,14,22,5.9,"PAH",210,1,121,0)="        Compare Transport Global to Current System "
^DIC(9.4,14,22,5.9,"PAH",210,1,122,0)="        Backup a Transport Global "
^DIC(9.4,14,22,5.9,"PAH",210,1,123,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,124,0)="5. Use the 'Install Package(s)' option under the 'Installation' menu and "
^DIC(9.4,14,22,5.9,"PAH",210,1,125,0)="   select the package 'LR*5.2*309'."
^DIC(9.4,14,22,5.9,"PAH",210,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,127,0)="6. When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES// "
^DIC(9.4,14,22,5.9,"PAH",210,1,128,0)="   choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",210,1,129,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,130,0)="7. When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,14,22,5.9,"PAH",210,1,131,0)="   Protocols? YES//', disable the Anatomic Pathology [LRAP] option. "
^DIC(9.4,14,22,5.9,"PAH",210,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,133,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,134,0)="  "
^DIC(9.4,14,22,5.9,"PAH",210,1,135,0)="INSTALLATION EXAMPLE: "
^DIC(9.4,14,22,5.9,"PAH",210,1,136,0)="===================== "
^DIC(9.4,14,22,5.9,"PAH",210,1,137,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,138,0)="Example #1 without data:"
^DIC(9.4,14,22,5.9,"PAH",210,1,139,0)="========================   "
^DIC(9.4,14,22,5.9,"PAH",210,1,140,0)="Select Installation Option: install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",210,1,141,0)="Select INSTALL NAME: LR*5.2*309       Loaded from Distribution  "
^DIC(9.4,14,22,5.9,"PAH",210,1,142,0)="8/5/08@14:25:46"
^DIC(9.4,14,22,5.9,"PAH",210,1,143,0)="     => LR*5.2*309"
^DIC(9.4,14,22,5.9,"PAH",210,1,144,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,145,0)="This Distribution was loaded on Aug 05, 2008@14:25:46 with header of "
^DIC(9.4,14,22,5.9,"PAH",210,1,146,0)="   LR*5.2*309"
^DIC(9.4,14,22,5.9,"PAH",210,1,147,0)="   It consisted of the following Install(s):"
^DIC(9.4,14,22,5.9,"PAH",210,1,148,0)="     LR*5.2*309"
^DIC(9.4,14,22,5.9,"PAH",210,1,149,0)="Checking Install for Package LR*5.2*309"
