^DIC(9.4,13,22,8,0)="22.0^2990330^3130912^17"
^DIC(9.4,13,22,8,1,0)="^^2^2^3051119"
^DIC(9.4,13,22,8,1,1,0)="This Build file entry contains the Options, Security Keys, and Remote"
^DIC(9.4,13,22,8,1,2,0)="Procedures used by VA FILEMAN."
^DIC(9.4,13,22,8,"PAH",0)="^9.4901^149^149"
^DIC(9.4,13,22,8,"PAH",1,0)="1^2990720^1"
^DIC(9.4,13,22,8,"PAH",1,1,0)="^^212^212^2990720"
^DIC(9.4,13,22,8,"PAH",1,1,1,0)="After V22 of VA FileMan was released to National VistA Support (NVS) for"
^DIC(9.4,13,22,8,"PAH",1,1,2,0)="field distribution several bugs were discovered at the test sites that"
^DIC(9.4,13,22,8,"PAH",1,1,3,0)="could affect various packages.  The following is list of the routine(s)"
^DIC(9.4,13,22,8,"PAH",1,1,4,0)="and the problem that was corrected: "
^DIC(9.4,13,22,8,"PAH",1,1,5,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,6,0)="Routine: DICATTD"
^DIC(9.4,13,22,8,"PAH",1,1,7,0)="Bug: When using the option Modify File Attributes AND used the"
^DIC(9.4,13,22,8,"PAH",1,1,8,0)="Screen-Mode version AND were adding a Free Text multiple, the 2nd piece of"
^DIC(9.4,13,22,8,"PAH",1,1,9,0)="the 0 node of the DD would be corrupted."
^DIC(9.4,13,22,8,"PAH",1,1,10,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,11,0)="Routine: DICOMPV "
^DIC(9.4,13,22,8,"PAH",1,1,12,0)="Bug: It was discovered that when using a Backward Extended Pointer and the"
^DIC(9.4,13,22,8,"PAH",1,1,13,0)="file that was being jumped to had a DINUMed .01 field back to the"
^DIC(9.4,13,22,8,"PAH",1,1,14,0)="originating file, a jump was not being allowed.  "
^DIC(9.4,13,22,8,"PAH",1,1,15,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,16,0)="Routine: DIC3"
^DIC(9.4,13,22,8,"PAH",1,1,17,0)="Bug: Input variable DIC(""S"") to the ^DIC routine altered local variable Y."
^DIC(9.4,13,22,8,"PAH",1,1,18,0)="FileMan was not protecting Y and expected it to contain the record number"
^DIC(9.4,13,22,8,"PAH",1,1,19,0)="just looked-up, so the wrong value was displayed for the .01 field when"
^DIC(9.4,13,22,8,"PAH",1,1,20,0)="entries were presented to the end-user."
^DIC(9.4,13,22,8,"PAH",1,1,21,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,22,0)="Routines: DIC1, DIC11"
^DIC(9.4,13,22,8,"PAH",1,1,23,0)="Bug: When the internal value of a date, pointer or variable pointer is"
^DIC(9.4,13,22,8,"PAH",1,1,24,0)="passed as a default lookup value in input variable DIC(""B"") to the ^DIC"
^DIC(9.4,13,22,8,"PAH",1,1,25,0)="routine, it should be displayed to the end-user in external format.  This"
^DIC(9.4,13,22,8,"PAH",1,1,26,0)="worked in V21 but didn't in V22."
^DIC(9.4,13,22,8,"PAH",1,1,27,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,28,0)="Routine: DIE"
^DIC(9.4,13,22,8,"PAH",1,1,29,0)="Bug: After a call to ^DIE with DR=""[template name]"", a ^TMP(""DIE"",number)"
^DIC(9.4,13,22,8,"PAH",1,1,30,0)="node was not being killed."
^DIC(9.4,13,22,8,"PAH",1,1,31,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,32,0)="Routine: DIEZ"
^DIC(9.4,13,22,8,"PAH",1,1,33,0)="Bug: An undefined X variable error could occur during a KIDS installation,"
^DIC(9.4,13,22,8,"PAH",1,1,34,0)="when KIDS called FileMan to uncompile an input template."
^DIC(9.4,13,22,8,"PAH",1,1,35,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,36,0)="Routines: DICA, DICA1"
^DIC(9.4,13,22,8,"PAH",1,1,37,0)="Bug: If an UPDATE^DIE call is made from within another UPDATE^DIE call"
^DIC(9.4,13,22,8,"PAH",1,1,38,0)="(for example, when the Updater executes a cross-reference that makes"
^DIC(9.4,13,22,8,"PAH",1,1,39,0)="another Updater call), the call could fail and Dialog file error messages"
^DIC(9.4,13,22,8,"PAH",1,1,40,0)="generated. Also the variable D was leaking out of UPDATE^DIE."
^DIC(9.4,13,22,8,"PAH",1,1,41,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,42,0)="Routine: DIEFW"
^DIC(9.4,13,22,8,"PAH",1,1,43,0)="Bug: An undefined DIEFLOCK could occur if the Filer was called with the"
^DIC(9.4,13,22,8,"PAH",1,1,44,0)="""K"" flag to do locking, and within that Filer call, a call was made to"
^DIC(9.4,13,22,8,"PAH",1,1,45,0)="WP^DIE (from within a cross-reference, for example) without the ""K"" flag."
^DIC(9.4,13,22,8,"PAH",1,1,46,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,47,0)="Routines: DIFROMSX, DIFROMXY"
^DIC(9.4,13,22,8,"PAH",1,1,48,0)="Change: Before, if a partial DD was sent with KIDS and the file had KEYs,"
^DIC(9.4,13,22,8,"PAH",1,1,49,0)="all of the field definitions for the KEY fields had to be sent.  We"
^DIC(9.4,13,22,8,"PAH",1,1,50,0)="decided that wasn't necessary, so after this patch, the field definition"
^DIC(9.4,13,22,8,"PAH",1,1,51,0)="for a key field must be sent only if the key is compound and other"
^DIC(9.4,13,22,8,"PAH",1,1,52,0)="field(s) in the key are being sent."
^DIC(9.4,13,22,8,"PAH",1,1,53,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,54,0)="Routines: DIK1, DIKZ1"
^DIC(9.4,13,22,8,"PAH",1,1,55,0)="Bug: The ^DIK entry points did not have time-outs on the Lock commands"
^DIC(9.4,13,22,8,"PAH",1,1,56,0)="they issued."
^DIC(9.4,13,22,8,"PAH",1,1,57,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,58,0)="Routine: DIR1"
^DIC(9.4,13,22,8,"PAH",1,1,59,0)="Bug: MAS patch DG*5.3*149 brought new code into routine DGREG.  The old"
^DIC(9.4,13,22,8,"PAH",1,1,60,0)="code directly executed the input transform from subfile 2.101, field .01"
^DIC(9.4,13,22,8,"PAH",1,1,61,0)="to check the validity of a value entered by the user (in X). The new code"
^DIC(9.4,13,22,8,"PAH",1,1,62,0)="instead calls CHK^DIE (which also executes the input transform) to check"
^DIC(9.4,13,22,8,"PAH",1,1,63,0)="the validity of the value. The input transform code for this field sets"
^DIC(9.4,13,22,8,"PAH",1,1,64,0)="the variable DINUM.  The MAS code at REG+2^DGREG then uses DINUM.  In"
^DIC(9.4,13,22,8,"PAH",1,1,65,0)="version 22, FileMan NEWs DINUM in the CHK^DIE call before executing the"
^DIC(9.4,13,22,8,"PAH",1,1,66,0)="input transform, because DINUM is not a documented output variable, and"
^DIC(9.4,13,22,8,"PAH",1,1,67,0)="because it is a dangerous variable to leave around.  MAS does not have"
^DIC(9.4,13,22,8,"PAH",1,1,68,0)="time to patch their code before the planned release of version 22, so"
^DIC(9.4,13,22,8,"PAH",1,1,69,0)="FileMan will temporarily 'leak' DINUM in order to avoid a hard error."
^DIC(9.4,13,22,8,"PAH",1,1,70,0)="After MAS patches their code, FileMan will issue another patch to restore"
^DIC(9.4,13,22,8,"PAH",1,1,71,0)="the NEW DINUM."
^DIC(9.4,13,22,8,"PAH",1,1,72,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,73,0)="Routines: DIE1, DIEF, DIKC"
^DIC(9.4,13,22,8,"PAH",1,1,74,0)="Bug: If there is an X1 array element corresponding to the .01 field in the"
^DIC(9.4,13,22,8,"PAH",1,1,75,0)="new-style Index logic or condition, make sure it is set to null if the"
^DIC(9.4,13,22,8,"PAH",1,1,76,0)="record is being added."
^DIC(9.4,13,22,8,"PAH",1,1,77,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,78,0)="Routines: DINIT2A1, DINIT2A2, DINIT2A3, DINIT2A4"
^DIC(9.4,13,22,8,"PAH",1,1,79,0)="Bug: These DINIT routines fix a typo on the description of the following"
^DIC(9.4,13,22,8,"PAH",1,1,80,0)="field in the Cross-Reference Values multiple of the Index file (#.11):"
^DIC(9.4,13,22,8,"PAH",1,1,81,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,82,0)="   11.1  Cross-Reference Values (Multiple-.114)"
^DIC(9.4,13,22,8,"PAH",1,1,83,0)="         4.5  Computed Code"
^DIC(9.4,13,22,8,"PAH",1,1,84,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,85,0)="         was: ""Answer with M code that set X..."""
^DIC(9.4,13,22,8,"PAH",1,1,86,0)="   should be: ""Answer with M code that sets X..."""
^DIC(9.4,13,22,8,"PAH",1,1,87,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,88,0)="The DINIT routines also add information about the X1 and X2 arrays to the"
^DIC(9.4,13,22,8,"PAH",1,1,89,0)="descriptions of the following fields in the Index file (#.11):"
^DIC(9.4,13,22,8,"PAH",1,1,90,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,91,0)="   1.1  Set Logic"
^DIC(9.4,13,22,8,"PAH",1,1,92,0)="   1.4  Set Condition Code"
^DIC(9.4,13,22,8,"PAH",1,1,93,0)="   2.1  Kill Logic"
^DIC(9.4,13,22,8,"PAH",1,1,94,0)="   2.4  Kill Condition Code"
^DIC(9.4,13,22,8,"PAH",1,1,95,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,96,0)=" For each of the above fields, the following paragraph was appended to the"
^DIC(9.4,13,22,8,"PAH",1,1,97,0)=" description:"
^DIC(9.4,13,22,8,"PAH",1,1,98,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,99,0)="   When fields that make up a cross-reference are edited and the kill and"
^DIC(9.4,13,22,8,"PAH",1,1,100,0)="   set logic are executed, the X1(order#) array contains the old field"
^DIC(9.4,13,22,8,"PAH",1,1,101,0)="   values, and the X2(order#) array contains the new field values. If a"
^DIC(9.4,13,22,8,"PAH",1,1,102,0)="   record is being added, and there is an X1(order#) array element that"
^DIC(9.4,13,22,8,"PAH",1,1,103,0)="   corresponds to the .01 field, it is set to null. When a record is"
^DIC(9.4,13,22,8,"PAH",1,1,104,0)="   deleted, all X2(order#) array elements are null."
^DIC(9.4,13,22,8,"PAH",1,1,105,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,106,0)="Since the KIDS build for this patch brings in these fields automatically,"
^DIC(9.4,13,22,8,"PAH",1,1,107,0)="there is no need to rerun DINIT after installing this patch."
^DIC(9.4,13,22,8,"PAH",1,1,108,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,109,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,110,0)="NOIS "
^DIC(9.4,13,22,8,"PAH",1,1,111,0)="===="
^DIC(9.4,13,22,8,"PAH",1,1,112,0)=" HAM-0499-21392"
^DIC(9.4,13,22,8,"PAH",1,1,113,0)=" PHO-1198-62053"
^DIC(9.4,13,22,8,"PAH",1,1,114,0)=" FNC-0599-30750"
^DIC(9.4,13,22,8,"PAH",1,1,115,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,116,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",1,1,117,0)="===================="
^DIC(9.4,13,22,8,"PAH",1,1,118,0)=" Hampton, VA"
^DIC(9.4,13,22,8,"PAH",1,1,119,0)=" White City, OR"
^DIC(9.4,13,22,8,"PAH",1,1,120,0)=" Fayetteville, NC"
^DIC(9.4,13,22,8,"PAH",1,1,121,0)=" White River Junction, VT"
^DIC(9.4,13,22,8,"PAH",1,1,122,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,123,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",1,1,124,0)="================"
^DIC(9.4,13,22,8,"PAH",1,1,125,0)=" The following routines are included in this patch.  The second line of "
^DIC(9.4,13,22,8,"PAH",1,1,126,0)="these routines now look like: "
^DIC(9.4,13,22,8,"PAH",1,1,127,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,128,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",1,1,129,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,130,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",1,1,131,0)="  "
^DIC(9.4,13,22,8,"PAH",1,1,132,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",1,1,133,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",1,1,134,0)="  DIC1           7920273         8396997         1"
^DIC(9.4,13,22,8,"PAH",1,1,135,0)="  DIC11          3133605         3318576         1"
^DIC(9.4,13,22,8,"PAH",1,1,136,0)="  DIC3           8044472         8138582         1"
^DIC(9.4,13,22,8,"PAH",1,1,137,0)="  DICA           8337676         8300985         1"
^DIC(9.4,13,22,8,"PAH",1,1,138,0)="  DICA1          7134262         7156598         1"
^DIC(9.4,13,22,8,"PAH",1,1,139,0)="  DICATTD        9780938         9786273         1"
^DIC(9.4,13,22,8,"PAH",1,1,140,0)="  DICOMPV        8888896         8426523         1"
^DIC(9.4,13,22,8,"PAH",1,1,141,0)="  DIE            10522278        10606815        1"
^DIC(9.4,13,22,8,"PAH",1,1,142,0)="  DIE1           10102666        10290843        1"
^DIC(9.4,13,22,8,"PAH",1,1,143,0)="  DIEF           11594187        11950704        1"
^DIC(9.4,13,22,8,"PAH",1,1,144,0)="  DIEFW          3026875         3026694         1"
^DIC(9.4,13,22,8,"PAH",1,1,145,0)="  DIEZ           9351704         9378294         1"
^DIC(9.4,13,22,8,"PAH",1,1,146,0)="  DIFROMSX       3683091         3497120         1"
^DIC(9.4,13,22,8,"PAH",1,1,147,0)="  DIFROMSY       3656754         3974102         1"
^DIC(9.4,13,22,8,"PAH",1,1,148,0)="  DIK1           6155873         6302851         1"
^DIC(9.4,13,22,8,"PAH",1,1,149,0)="  DIKC           11169535        11836728        1"
^DIC(9.4,13,22,8,"PAH",1,1,150,0)="  DIKZ1          9229373         9451304         1"
^DIC(9.4,13,22,8,"PAH",1,1,151,0)="  DINIT2A1       13956613        14321834        1"
^DIC(9.4,13,22,8,"PAH",1,1,152,0)="  DINIT2A2       12584241        14203695        1"
^DIC(9.4,13,22,8,"PAH",1,1,153,0)="  DINIT2A3       14285423        13176711        1"
^DIC(9.4,13,22,8,"PAH",1,1,154,0)="  DINIT2A4       2212843         9326344         1"
^DIC(9.4,13,22,8,"PAH",1,1,155,0)="  DIR1           11551993        11554966        1"
^DIC(9.4,13,22,8,"PAH",1,1,156,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,157,0)="    "
^DIC(9.4,13,22,8,"PAH",1,1,158,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",1,1,159,0)="=========================="
^DIC(9.4,13,22,8,"PAH",1,1,160,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to"
^DIC(9.4,13,22,8,"PAH",1,1,161,0)="be STOPPED.  Failure to do so may result in a 'source routine edited'"
^DIC(9.4,13,22,8,"PAH",1,1,162,0)="error, the edits will be lost and records may be left in an"
^DIC(9.4,13,22,8,"PAH",1,1,163,0)="inconsistent state.  "
^DIC(9.4,13,22,8,"PAH",1,1,164,0)="** "
^DIC(9.4,13,22,8,"PAH",1,1,165,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,166,0)="     1.  AXP sites: Review your mapped routine set.  If any of the "
^DIC(9.4,13,22,8,"PAH",1,1,167,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, they "
^DIC(9.4,13,22,8,"PAH",1,1,168,0)="should be removed from the mapped set at this time.  "
^DIC(9.4,13,22,8,"PAH",1,1,169,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,170,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  "
^DIC(9.4,13,22,8,"PAH",1,1,171,0)="This option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,8,"PAH",1,1,172,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,173,0)="The environment check routine DIENVWRN will run automatically.  Routine"
^DIC(9.4,13,22,8,"PAH",1,1,174,0)="DIENVWRN is sent in order to prevent the inadvertent queuing during the"
^DIC(9.4,13,22,8,"PAH",1,1,175,0)="installation of this patch.  "
^DIC(9.4,13,22,8,"PAH",1,1,176,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,177,0)="     3.  The patch has now been loaded into a transport global on your "
^DIC(9.4,13,22,8,"PAH",1,1,178,0)="system. You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,8,"PAH",1,1,179,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,180,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,8,"PAH",1,1,181,0)="following options: "
^DIC(9.4,13,22,8,"PAH",1,1,182,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",1,1,183,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",1,1,184,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",1,1,185,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",1,1,186,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,187,0)="     5.  Inhibit users' login into the system.  The consequence of "
^DIC(9.4,13,22,8,"PAH",1,1,188,0)="having users on the system while installing this patch are that users "
^DIC(9.4,13,22,8,"PAH",1,1,189,0)="editing records will get a 'source routine edited' error, the edits "
^DIC(9.4,13,22,8,"PAH",1,1,190,0)="will be lost and records may be left in an inconsistent state.  Note "
^DIC(9.4,13,22,8,"PAH",1,1,191,0)="that most of these routines are heavily used in DHCP applications.  "
^DIC(9.4,13,22,8,"PAH",1,1,192,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,193,0)="     6.  AXP Sites - Place TaskMan in a WAIT State.  "
^DIC(9.4,13,22,8,"PAH",1,1,194,0)="         OpenM/Cache Sites - STOP TaskMan.  "
^DIC(9.4,13,22,8,"PAH",1,1,195,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,196,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,8,"PAH",1,1,197,0)="following option: "
^DIC(9.4,13,22,8,"PAH",1,1,198,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",1,1,199,0)="            Select INSTALL NAME: DI*22.0*1 "
^DIC(9.4,13,22,8,"PAH",1,1,200,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",1,1,201,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,202,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,13,22,8,"PAH",1,1,203,0)="Options, and Protocols? "
^DIC(9.4,13,22,8,"PAH",1,1,204,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,205,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,206,0)="     8.  AXP Sites - After the patch has been installed, rebuild your "
^DIC(9.4,13,22,8,"PAH",1,1,207,0)="map set, if necessary. "
^DIC(9.4,13,22,8,"PAH",1,1,208,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,209,0)="     9.  AXP Sites - Remove TaskMan from WAIT State.  "
^DIC(9.4,13,22,8,"PAH",1,1,210,0)="         OpenM/Cache Sites - Restart TaskMan.  "
^DIC(9.4,13,22,8,"PAH",1,1,211,0)=" "
^DIC(9.4,13,22,8,"PAH",1,1,212,0)="    10.  Enable users' login."
^DIC(9.4,13,22,8,"PAH",2,0)="13 SEQ #2^2991002^1"
^DIC(9.4,13,22,8,"PAH",2,1,0)="^^89^89^2991002"
^DIC(9.4,13,22,8,"PAH",2,1,1,0)="Routine: DIC11"
^DIC(9.4,13,22,8,"PAH",2,1,2,0)="--------------"
^DIC(9.4,13,22,8,"PAH",2,1,3,0)="In version 21 of FileMan, if lookup value is accent grave followed by a"
^DIC(9.4,13,22,8,"PAH",2,1,4,0)="number, FileMan first looks on the current file for a matching IEN.  If"
^DIC(9.4,13,22,8,"PAH",2,1,5,0)="none is found, but we can add records to the file, and if the .01 field is"
^DIC(9.4,13,22,8,"PAH",2,1,6,0)="a pointer or variable pointer, FileMan looks on the pointed-to file for a"
^DIC(9.4,13,22,8,"PAH",2,1,7,0)="matching IEN. This did not work for variable pointers in version 22"
^DIC(9.4,13,22,8,"PAH",2,1,8,0)="because it was felt that the user had no control over which of the"
^DIC(9.4,13,22,8,"PAH",2,1,9,0)="pointed-to files might be used for the match.  However, on the NOIS, the"
^DIC(9.4,13,22,8,"PAH",2,1,10,0)="developers had used DIC(""V"") to limit the lookup to only one of the"
^DIC(9.4,13,22,8,"PAH",2,1,11,0)="pointed-to files.  This patch makes the lookup work on variable pointers"
^DIC(9.4,13,22,8,"PAH",2,1,12,0)="as well as pointers."
^DIC(9.4,13,22,8,"PAH",2,1,13,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,14,0)="NOIS "
^DIC(9.4,13,22,8,"PAH",2,1,15,0)="===="
^DIC(9.4,13,22,8,"PAH",2,1,16,0)=" BAY-0899-31670"
^DIC(9.4,13,22,8,"PAH",2,1,17,0)=" PAL-0899-62585"
^DIC(9.4,13,22,8,"PAH",2,1,18,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,19,0)="Thanks to Test Site"
^DIC(9.4,13,22,8,"PAH",2,1,20,0)="===================="
^DIC(9.4,13,22,8,"PAH",2,1,21,0)=" Bay Pines, FL"
^DIC(9.4,13,22,8,"PAH",2,1,22,0)=" Palo Alto HCS, CA"
^DIC(9.4,13,22,8,"PAH",2,1,23,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,24,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",2,1,25,0)="================"
^DIC(9.4,13,22,8,"PAH",2,1,26,0)=" The following routines are included in this patch.  The second line of these "
^DIC(9.4,13,22,8,"PAH",2,1,27,0)="routines now look like: "
^DIC(9.4,13,22,8,"PAH",2,1,28,0)="  "
^DIC(9.4,13,22,8,"PAH",2,1,29,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",2,1,30,0)="  "
^DIC(9.4,13,22,8,"PAH",2,1,31,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",2,1,32,0)="  "
^DIC(9.4,13,22,8,"PAH",2,1,33,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",2,1,34,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",2,1,35,0)="  DIC11          3318576         3304157         1,13"
^DIC(9.4,13,22,8,"PAH",2,1,36,0)="    "
^DIC(9.4,13,22,8,"PAH",2,1,37,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",2,1,38,0)="=========================="
^DIC(9.4,13,22,8,"PAH",2,1,39,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to be "
^DIC(9.4,13,22,8,"PAH",2,1,40,0)="STOPPED.  Failure to do so may result in a 'source routine edited' error, the "
^DIC(9.4,13,22,8,"PAH",2,1,41,0)="edits will be lost and records may be left in an inconsistent state.  "
^DIC(9.4,13,22,8,"PAH",2,1,42,0)="** "
^DIC(9.4,13,22,8,"PAH",2,1,43,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,44,0)="     1.  AXP sites: Review your mapped routine set.  If DIC11 is mapped on"
^DIC(9.4,13,22,8,"PAH",2,1,45,0)="your system, it should be removed from the mapped set at this time."
^DIC(9.4,13,22,8,"PAH",2,1,46,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,47,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This "
^DIC(9.4,13,22,8,"PAH",2,1,48,0)="option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,8,"PAH",2,1,49,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,50,0)="The environment check routine DIENVWRN will run automatically.  Routine "
^DIC(9.4,13,22,8,"PAH",2,1,51,0)="DIENVWRN is sent in order to prevent the inadvertent queuing during the "
^DIC(9.4,13,22,8,"PAH",2,1,52,0)="installation of this patch.  "
^DIC(9.4,13,22,8,"PAH",2,1,53,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,54,0)="     3.  The patch has now been loaded into a transport global on your system.  "
^DIC(9.4,13,22,8,"PAH",2,1,55,0)="You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,8,"PAH",2,1,56,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,57,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,13,22,8,"PAH",2,1,58,0)="options: "
^DIC(9.4,13,22,8,"PAH",2,1,59,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",2,1,60,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",2,1,61,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",2,1,62,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",2,1,63,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,64,0)="     5.  Inhibit users' login into the system.  The consequence of having"
^DIC(9.4,13,22,8,"PAH",2,1,65,0)="users on the system while installing this patch are that users editing"
^DIC(9.4,13,22,8,"PAH",2,1,66,0)="records will get a 'source routine edited' error, the edits will be lost"
^DIC(9.4,13,22,8,"PAH",2,1,67,0)="and records may be left in an inconsistent state.  Note that DIC11 is"
^DIC(9.4,13,22,8,"PAH",2,1,68,0)="heavily used in DHCP applications.  "
^DIC(9.4,13,22,8,"PAH",2,1,69,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,70,0)="     6.  AXP Sites - Place TaskMan in a WAIT State.  "
^DIC(9.4,13,22,8,"PAH",2,1,71,0)="         OpenM/Cache Sites - STOP TaskMan.  "
^DIC(9.4,13,22,8,"PAH",2,1,72,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,73,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,13,22,8,"PAH",2,1,74,0)="option: "
^DIC(9.4,13,22,8,"PAH",2,1,75,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",2,1,76,0)="            Select INSTALL NAME: DI*22.0*13"
^DIC(9.4,13,22,8,"PAH",2,1,77,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",2,1,78,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,79,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,13,22,8,"PAH",2,1,80,0)="and Protocols? "
^DIC(9.4,13,22,8,"PAH",2,1,81,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,82,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,83,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map set, "
^DIC(9.4,13,22,8,"PAH",2,1,84,0)="if necessary. "
^DIC(9.4,13,22,8,"PAH",2,1,85,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,86,0)="     9.  AXP Sites - Remove TaskMan from WAIT State.  "
^DIC(9.4,13,22,8,"PAH",2,1,87,0)="         OpenM/Cache Sites - Restart TaskMan.  "
^DIC(9.4,13,22,8,"PAH",2,1,88,0)=" "
^DIC(9.4,13,22,8,"PAH",2,1,89,0)="    10.  Enable users' login.  "
^DIC(9.4,13,22,8,"PAH",3,0)="12 SEQ #3^2991007^1"
^DIC(9.4,13,22,8,"PAH",3,1,0)="^^326^326^2991007"
^DIC(9.4,13,22,8,"PAH",3,1,1,0)="This patch introduces two new APIs in VA FileMan, DELIX^DDMOD and"
^DIC(9.4,13,22,8,"PAH",3,1,2,0)="DELIXN^DDMOD. DELIX^DDMOD can be used to delete a Traditional"
^DIC(9.4,13,22,8,"PAH",3,1,3,0)="Cross-Reference definition from the data dictionary. DELIXN^DDMOD can be"
^DIC(9.4,13,22,8,"PAH",3,1,4,0)="used to delete a New-Style Index definition from the Index file (#.11)."
^DIC(9.4,13,22,8,"PAH",3,1,5,0)="Optionally, depending on the type of cross-reference deleted, the APIs"
^DIC(9.4,13,22,8,"PAH",3,1,6,0)="will also delete the data in the index or execute the kill logic for all"
^DIC(9.4,13,22,8,"PAH",3,1,7,0)="entries in the file. Compiled input templates that contain the field on"
^DIC(9.4,13,22,8,"PAH",3,1,8,0)="which the cross-reference is defined are recompiled. If cross-references"
^DIC(9.4,13,22,8,"PAH",3,1,9,0)="on the file are compiled, they are also recompiled."
^DIC(9.4,13,22,8,"PAH",3,1,10,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,11,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,12,0)="Documentation:"
^DIC(9.4,13,22,8,"PAH",3,1,13,0)="============="
^DIC(9.4,13,22,8,"PAH",3,1,14,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,15,0)="  DELIX^DDMOD: Traditional Cross-Reference Deleter"
^DIC(9.4,13,22,8,"PAH",3,1,16,0)="  ================================================"
^DIC(9.4,13,22,8,"PAH",3,1,17,0)="  This procedure deletes a Traditional Cross-Reference definition from the"
^DIC(9.4,13,22,8,"PAH",3,1,18,0)="  data dictionary. Optionally, it deletes the data in the index or"
^DIC(9.4,13,22,8,"PAH",3,1,19,0)="  executes the kill logic for all entries in the file. Compiled input"
^DIC(9.4,13,22,8,"PAH",3,1,20,0)="  templates that contain the field on which the cross-reference is defined"
^DIC(9.4,13,22,8,"PAH",3,1,21,0)="  are recompiled. If cross-references on the file are compiled, they are"
^DIC(9.4,13,22,8,"PAH",3,1,22,0)="  recompiled."
^DIC(9.4,13,22,8,"PAH",3,1,23,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,24,0)="  Format"
^DIC(9.4,13,22,8,"PAH",3,1,25,0)="  ------"
^DIC(9.4,13,22,8,"PAH",3,1,26,0)="  DELIX^DDMOD(FILE,FIELD,CROSS_REF,FLAGS,OUTPUT_ROOT,MSG_ROOT)"
^DIC(9.4,13,22,8,"PAH",3,1,27,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,28,0)="  Input Parameters"
^DIC(9.4,13,22,8,"PAH",3,1,29,0)="  ----------------"
^DIC(9.4,13,22,8,"PAH",3,1,30,0)="  FILE          (Required) File or subfile number."
^DIC(9.4,13,22,8,"PAH",3,1,31,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,32,0)="  FIELD         (Required) Field number."
^DIC(9.4,13,22,8,"PAH",3,1,33,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,34,0)="  CROSS_REF     (Required) Cross-reference number. Traditional"
^DIC(9.4,13,22,8,"PAH",3,1,35,0)="                cross-references are defined in the data dictionary"
^DIC(9.4,13,22,8,"PAH",3,1,36,0)="                under ^DD(file#,field#,1,cross reference number)."
^DIC(9.4,13,22,8,"PAH",3,1,37,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,38,0)="  FLAGS         (Optional) Flags to control processing. The possible"
^DIC(9.4,13,22,8,"PAH",3,1,39,0)="                values are:"
^DIC(9.4,13,22,8,"PAH",3,1,40,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,41,0)="                  K     For Regular, KWIC, Mnemonic, and Soundex-type"
^DIC(9.4,13,22,8,"PAH",3,1,42,0)="                        cross-references, delete the data in the index."
^DIC(9.4,13,22,8,"PAH",3,1,43,0)="                        For MUMPS and Trigger-type cross-references,"
^DIC(9.4,13,22,8,"PAH",3,1,44,0)="                        execute the kill logic of the cross-reference for"
^DIC(9.4,13,22,8,"PAH",3,1,45,0)="                        all entries in the file. For Bulletin-type"
^DIC(9.4,13,22,8,"PAH",3,1,46,0)="                        cross-references, the ""K"" flag is ignored; the"
^DIC(9.4,13,22,8,"PAH",3,1,47,0)="                        kill logic for Bulletin-type cross-references is"
^DIC(9.4,13,22,8,"PAH",3,1,48,0)="                        never executed by this procedure."
^DIC(9.4,13,22,8,"PAH",3,1,49,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,50,0)="                  W     Write messages to the current device as the index"
^DIC(9.4,13,22,8,"PAH",3,1,51,0)="                        is deleted and cross-references and input"
^DIC(9.4,13,22,8,"PAH",3,1,52,0)="                        templates are recompiled."
^DIC(9.4,13,22,8,"PAH",3,1,53,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,54,0)="  OUTPUT_ROOT   (Optional) The name of the array that should receive"
^DIC(9.4,13,22,8,"PAH",3,1,55,0)="                information about input templates and cross-references"
^DIC(9.4,13,22,8,"PAH",3,1,56,0)="                that may have been recompiled and a flag to indicate that"
^DIC(9.4,13,22,8,"PAH",3,1,57,0)="                the deletion was audited in the DD Audit file (#.6). See"
^DIC(9.4,13,22,8,"PAH",3,1,58,0)="                Output below. This must be a closed root, either local or"
^DIC(9.4,13,22,8,"PAH",3,1,59,0)="                global."
^DIC(9.4,13,22,8,"PAH",3,1,60,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,61,0)="  MSG_ROOT      (Optional) The name of the array that should receive any"
^DIC(9.4,13,22,8,"PAH",3,1,62,0)="                error messages. This must be a closed root, either local"
^DIC(9.4,13,22,8,"PAH",3,1,63,0)="                or global. If not passed, errors are returned descendent"
^DIC(9.4,13,22,8,"PAH",3,1,64,0)="                from ^TMP(""DIERR"",$J)."
^DIC(9.4,13,22,8,"PAH",3,1,65,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,66,0)="  Output"
^DIC(9.4,13,22,8,"PAH",3,1,67,0)="  ------"
^DIC(9.4,13,22,8,"PAH",3,1,68,0)="  OUTPUT_ROOT   See OUTPUT_ROOT under Input Parameters."
^DIC(9.4,13,22,8,"PAH",3,1,69,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,70,0)="                If the field on which the deleted cross-reference was"
^DIC(9.4,13,22,8,"PAH",3,1,71,0)="                defined is used in any compiled input templates, those"
^DIC(9.4,13,22,8,"PAH",3,1,72,0)="                input templates are recompiled. Information about the"
^DIC(9.4,13,22,8,"PAH",3,1,73,0)="                recompiled input templates is stored descendant from"
^DIC(9.4,13,22,8,"PAH",3,1,74,0)="                OUTPUT_ROOT(""DIEZ""):"
^DIC(9.4,13,22,8,"PAH",3,1,75,0)="                  "
^DIC(9.4,13,22,8,"PAH",3,1,76,0)="                  OUTPUT_ROOT(""DIEZ"",input template #) = "
^DIC(9.4,13,22,8,"PAH",3,1,77,0)="                    input template name ^ file # ^ compiled routine name"
^DIC(9.4,13,22,8,"PAH",3,1,78,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,79,0)="                If cross-references for the file are compiled, they are"
^DIC(9.4,13,22,8,"PAH",3,1,80,0)="                recompiled, and the compiled routine name is stored in"
^DIC(9.4,13,22,8,"PAH",3,1,81,0)="                OUTPUT_ROOT(""DIKZ""):"
^DIC(9.4,13,22,8,"PAH",3,1,82,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,83,0)="                  OUTPUT_ROOT(""DIKZ"") = compiled routine name"
^DIC(9.4,13,22,8,"PAH",3,1,84,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,85,0)="                If the data dictionary for the file is audited, an entry"
^DIC(9.4,13,22,8,"PAH",3,1,86,0)="                is made in the DD Audit file (#.6) and"
^DIC(9.4,13,22,8,"PAH",3,1,87,0)="                OUTPUT_ROOT(""DDAUD"") is set to 1:"
^DIC(9.4,13,22,8,"PAH",3,1,88,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,89,0)="                  OUTPUT_ROOT(""DDAUD"") = 1"
^DIC(9.4,13,22,8,"PAH",3,1,90,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,91,0)="  Example"
^DIC(9.4,13,22,8,"PAH",3,1,92,0)="  -------"
^DIC(9.4,13,22,8,"PAH",3,1,93,0)="  1.  In this example, regular cross-reference #4 (the ""C"" index), defined"
^DIC(9.4,13,22,8,"PAH",3,1,94,0)="      on field #12 in file #16200, is deleted. The ""K"" flag indicates that"
^DIC(9.4,13,22,8,"PAH",3,1,95,0)="      the entire ^DIZ(16200,""C"") index is removed from the file."
^DIC(9.4,13,22,8,"PAH",3,1,96,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,97,0)="        >D DELIX^DDMOD(16200,12,4,""K"",""MYOUT"")"
^DIC(9.4,13,22,8,"PAH",3,1,98,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,99,0)="        >ZW MYOUT"
^DIC(9.4,13,22,8,"PAH",3,1,100,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,101,0)="        MYOUT(""DDAUD"")=1"
^DIC(9.4,13,22,8,"PAH",3,1,102,0)="        MYOUT(""DIEZ"",100)=ZZTEST EDIT^16200^ZZIT"
^DIC(9.4,13,22,8,"PAH",3,1,103,0)="        MYOUT(""DIKZ"")=ZZCR"
^DIC(9.4,13,22,8,"PAH",3,1,104,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,105,0)="      The MYOUT output array indicates that the deletion was recorded in"
^DIC(9.4,13,22,8,"PAH",3,1,106,0)="      the DD Audit file (#.6).  Field #12 is included in the compiled"
^DIC(9.4,13,22,8,"PAH",3,1,107,0)="      input template ZZTEST EDIT (#100), which is compiled into the ZZIT"
^DIC(9.4,13,22,8,"PAH",3,1,108,0)="      namespaced routines. Cross-references on file #16200 are compiled"
^DIC(9.4,13,22,8,"PAH",3,1,109,0)="      under the ZZCR namespace."
^DIC(9.4,13,22,8,"PAH",3,1,110,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,111,0)="  2.  In this example, the whole-file regular cross-reference #7 (the ""N"""
^DIC(9.4,13,22,8,"PAH",3,1,112,0)="      index), defined on field #15 within subfile #16200.075, is deleted."
^DIC(9.4,13,22,8,"PAH",3,1,113,0)="      The ""K"" flag indicates that the entire ^DIZ(16200,""N"") index should"
^DIC(9.4,13,22,8,"PAH",3,1,114,0)="      be removed, and the ""W"" flag indicates that messages should be"
^DIC(9.4,13,22,8,"PAH",3,1,115,0)="      printed to the current device."
^DIC(9.4,13,22,8,"PAH",3,1,116,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,117,0)="        >D DELIX(16200.075,15,7,""KW"")"
^DIC(9.4,13,22,8,"PAH",3,1,118,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,119,0)="        Removing index ..."
^DIC(9.4,13,22,8,"PAH",3,1,120,0)="        Deleting cross-reference definition ..."
^DIC(9.4,13,22,8,"PAH",3,1,121,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,122,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,123,0)="        Compiling ZZ TEST CR Input Template of File 16200..."
^DIC(9.4,13,22,8,"PAH",3,1,124,0)="        'ZZIT1' ROUTINE FILED.."
^DIC(9.4,13,22,8,"PAH",3,1,125,0)="        'ZZIT' ROUTINE FILED...."
^DIC(9.4,13,22,8,"PAH",3,1,126,0)="        'ZZIT2' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,127,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,128,0)="        Compiling Cross-Reference(s) 16200 of File 16200."
^DIC(9.4,13,22,8,"PAH",3,1,129,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,130,0)="        ...SORRY, HOLD ON..."
^DIC(9.4,13,22,8,"PAH",3,1,131,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,132,0)="        'ZZCR1' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,133,0)="        'ZZCR2' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,134,0)="        'ZZCR3' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,135,0)="        'ZZCR4' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,136,0)="        'ZZCR5' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,137,0)="        'ZZCR' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,138,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,139,0)="  Error Codes Returned"
^DIC(9.4,13,22,8,"PAH",3,1,140,0)="  --------------------"
^DIC(9.4,13,22,8,"PAH",3,1,141,0)="  202   The specified parameter is missing or invalid."
^DIC(9.4,13,22,8,"PAH",3,1,142,0)="  301   The passed flags are incorrect."
^DIC(9.4,13,22,8,"PAH",3,1,143,0)="  401   The file does not exist."
^DIC(9.4,13,22,8,"PAH",3,1,144,0)="  406   The file has no .01 definition."
^DIC(9.4,13,22,8,"PAH",3,1,145,0)="  407   A word-processing field is not a file."
^DIC(9.4,13,22,8,"PAH",3,1,146,0)="  501   The file does not contain the specified field."
^DIC(9.4,13,22,8,"PAH",3,1,147,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,148,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,149,0)="  DELIXN^DDMOD: New-Style Index Deleter"
^DIC(9.4,13,22,8,"PAH",3,1,150,0)="  ====================================="
^DIC(9.4,13,22,8,"PAH",3,1,151,0)="  This procedure deletes a New-Style Index definition from the Index file."
^DIC(9.4,13,22,8,"PAH",3,1,152,0)="  Optionally, it deletes the data in the index or executes the kill logic"
^DIC(9.4,13,22,8,"PAH",3,1,153,0)="  for all entries in the file. Compiled input templates that contain one"
^DIC(9.4,13,22,8,"PAH",3,1,154,0)="  or more of the fields defined in the index are recompiled. If"
^DIC(9.4,13,22,8,"PAH",3,1,155,0)="  cross-references on the file are compiled, they are recompiled."
^DIC(9.4,13,22,8,"PAH",3,1,156,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,157,0)="  Format"
^DIC(9.4,13,22,8,"PAH",3,1,158,0)="  ------"
^DIC(9.4,13,22,8,"PAH",3,1,159,0)="  DELIXN^DDMOD(FILE,INDEX,FLAGS,OUTPUT_ROOT,MSG_ROOT)"
^DIC(9.4,13,22,8,"PAH",3,1,160,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,161,0)="  Input Parameters"
^DIC(9.4,13,22,8,"PAH",3,1,162,0)="  ----------------"
^DIC(9.4,13,22,8,"PAH",3,1,163,0)="  FILE          (Required) File or subfile number. For whole-file indexes,"
^DIC(9.4,13,22,8,"PAH",3,1,164,0)="                this is the number of the file at the upper level where"
^DIC(9.4,13,22,8,"PAH",3,1,165,0)="                the data in the index resides."
^DIC(9.4,13,22,8,"PAH",3,1,166,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,167,0)="  INDEX         (Required) Index name."
^DIC(9.4,13,22,8,"PAH",3,1,168,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,169,0)="  FLAGS         (Optional)"
^DIC(9.4,13,22,8,"PAH",3,1,170,0)="                Flags to control processing. The possible values are:"
^DIC(9.4,13,22,8,"PAH",3,1,171,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,172,0)="                  K     For Regular indexes, delete the data in the index."
^DIC(9.4,13,22,8,"PAH",3,1,173,0)="                        For MUMPS indexes, execute the kill logic for all"
^DIC(9.4,13,22,8,"PAH",3,1,174,0)="                        entries in the file."
^DIC(9.4,13,22,8,"PAH",3,1,175,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,176,0)="                  W     Write messages to the current device as the index"
^DIC(9.4,13,22,8,"PAH",3,1,177,0)="                        is deleted and cross-references and input"
^DIC(9.4,13,22,8,"PAH",3,1,178,0)="                        templates are recompiled."
^DIC(9.4,13,22,8,"PAH",3,1,179,0)="                        "
^DIC(9.4,13,22,8,"PAH",3,1,180,0)="  OUTPUT_ROOT   (Optional) The name of the array that should receive"
^DIC(9.4,13,22,8,"PAH",3,1,181,0)="                information about input templates and cross-references"
^DIC(9.4,13,22,8,"PAH",3,1,182,0)="                that may have been recompiled. See Output below. This must"
^DIC(9.4,13,22,8,"PAH",3,1,183,0)="                be a closed root, either local or global."
^DIC(9.4,13,22,8,"PAH",3,1,184,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,185,0)="  MSG_ROOT      (Optional) The name of the array that should receive any"
^DIC(9.4,13,22,8,"PAH",3,1,186,0)="                error messages. This must be a closed root, either local"
^DIC(9.4,13,22,8,"PAH",3,1,187,0)="                or global. If not passed, errors are returned descendent"
^DIC(9.4,13,22,8,"PAH",3,1,188,0)="                from ^TMP(""DIERR"",$J)."
^DIC(9.4,13,22,8,"PAH",3,1,189,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,190,0)="  Output"
^DIC(9.4,13,22,8,"PAH",3,1,191,0)="  ------"
^DIC(9.4,13,22,8,"PAH",3,1,192,0)="  OUTPUT_ROOT   See OUTPUT_ROOT under Input Parameters. If a field used in"
^DIC(9.4,13,22,8,"PAH",3,1,193,0)="                the index is used in any compiled input templates, those"
^DIC(9.4,13,22,8,"PAH",3,1,194,0)="                input templates are recompiled. Information about the"
^DIC(9.4,13,22,8,"PAH",3,1,195,0)="                recompiled input templates is stored descendant from"
^DIC(9.4,13,22,8,"PAH",3,1,196,0)="                OUTPUT_ROOT(""DIEZ""):"
^DIC(9.4,13,22,8,"PAH",3,1,197,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,198,0)="                  OUTPUT_ROOT(""DIEZ"",input template #) ="
^DIC(9.4,13,22,8,"PAH",3,1,199,0)="                    input template name ^ file # ^ compiled routine name"
^DIC(9.4,13,22,8,"PAH",3,1,200,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,201,0)="                If cross-references for the file are compiled, they are"
^DIC(9.4,13,22,8,"PAH",3,1,202,0)="                recompiled, and the compiled routine name is stored in"
^DIC(9.4,13,22,8,"PAH",3,1,203,0)="                OUTPUT_ROOT(""DIKZ""):"
^DIC(9.4,13,22,8,"PAH",3,1,204,0)="                "
^DIC(9.4,13,22,8,"PAH",3,1,205,0)="                  OUTPUT_ROOT(""DIKZ"") = compiled routine name"
^DIC(9.4,13,22,8,"PAH",3,1,206,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,207,0)="  Example"
^DIC(9.4,13,22,8,"PAH",3,1,208,0)="  -------"
^DIC(9.4,13,22,8,"PAH",3,1,209,0)="  1.  In this example, the new-style ""G"" index defined on file #16200 is"
^DIC(9.4,13,22,8,"PAH",3,1,210,0)="      deleted. The ""K"" flag indicates that the entire ^DIZ(16200,""G"")"
^DIC(9.4,13,22,8,"PAH",3,1,211,0)="      index should be removed from the file."
^DIC(9.4,13,22,8,"PAH",3,1,212,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,213,0)="        >D DELIXN^DDMOD(16200,""G"",""K"",""MYOUT"")"
^DIC(9.4,13,22,8,"PAH",3,1,214,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,215,0)="        >ZW MYOUT"
^DIC(9.4,13,22,8,"PAH",3,1,216,0)="        MYOUT(""DIEZ"",94)=ZZ TEST^16200^ZZIT"
^DIC(9.4,13,22,8,"PAH",3,1,217,0)="        MYOUT(""DIEZ"",100)=ZZ TEST A^16200^ZZITA"
^DIC(9.4,13,22,8,"PAH",3,1,218,0)="        MYOUT(""DIKZ"")=ZZCR"
^DIC(9.4,13,22,8,"PAH",3,1,219,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,220,0)="      The MYOUT output array indicates that a field or fields defined in"
^DIC(9.4,13,22,8,"PAH",3,1,221,0)="      the deleted index are used in the compiled input templates ZZ TEST"
^DIC(9.4,13,22,8,"PAH",3,1,222,0)="      (#94) and ZZ TEST 2 (#100). Those two input templates were"
^DIC(9.4,13,22,8,"PAH",3,1,223,0)="      recompiled. Cross-references on file #16200 were also recompiled"
^DIC(9.4,13,22,8,"PAH",3,1,224,0)="      under the ZZCR namespace."
^DIC(9.4,13,22,8,"PAH",3,1,225,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,226,0)="  2.  In this example, the whole-file regular index (the ""J"" index) is"
^DIC(9.4,13,22,8,"PAH",3,1,227,0)="      deleted. The fields in the index come from fields in a multiple,"
^DIC(9.4,13,22,8,"PAH",3,1,228,0)="      subfile #16200.075, but the whole-file index resides at the"
^DIC(9.4,13,22,8,"PAH",3,1,229,0)="      top-level file #16200. The ""K"" flag indicates that the entire"
^DIC(9.4,13,22,8,"PAH",3,1,230,0)="      ^DIZ(16200,""J"") index should be removed, and the ""W"" flag indicates"
^DIC(9.4,13,22,8,"PAH",3,1,231,0)="      that messages should be printed to the current device."
^DIC(9.4,13,22,8,"PAH",3,1,232,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,233,0)="        >D DELIXN^DDMOD(16200,""J"",""KW"",""MYOUT"")"
^DIC(9.4,13,22,8,"PAH",3,1,234,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,235,0)="        Removing index ..."
^DIC(9.4,13,22,8,"PAH",3,1,236,0)="        Deleting index definition ..."
^DIC(9.4,13,22,8,"PAH",3,1,237,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,238,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,239,0)="        Compiling ZZ TEST Input Template of File 16200...."
^DIC(9.4,13,22,8,"PAH",3,1,240,0)="        'ZZIT' ROUTINE FILED...."
^DIC(9.4,13,22,8,"PAH",3,1,241,0)="        'ZZIT1' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,242,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,243,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,244,0)="        Compiling ZZ TEST A Input Template of File 16200...."
^DIC(9.4,13,22,8,"PAH",3,1,245,0)="        'ZZITA' ROUTINE FILED...."
^DIC(9.4,13,22,8,"PAH",3,1,246,0)="        'ZZITA' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,247,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,248,0)="        Compiling Cross-Reference(s) 16200 of File 16200."
^DIC(9.4,13,22,8,"PAH",3,1,249,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,250,0)="        ...SORRY, JUST A MOMENT PLEASE..."
^DIC(9.4,13,22,8,"PAH",3,1,251,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,252,0)="        'ZZCR1' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,253,0)="        'ZZCR2' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,254,0)="        'ZZCR3' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,255,0)="        'ZZCR4' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,256,0)="        'ZZCR5' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,257,0)="        'ZZCR6' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,258,0)="        'ZZCR7' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,259,0)="        'ZZCR8' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,260,0)="        'ZZCR9' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,261,0)="        'ZZCR10' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,262,0)="        'ZZCR' ROUTINE FILED."
^DIC(9.4,13,22,8,"PAH",3,1,263,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,264,0)="  Error Codes Returned"
^DIC(9.4,13,22,8,"PAH",3,1,265,0)="  --------------------"
^DIC(9.4,13,22,8,"PAH",3,1,266,0)="  202   The specified parameter is missing or invalid."
^DIC(9.4,13,22,8,"PAH",3,1,267,0)="  301   The passed flags are incorrect."
^DIC(9.4,13,22,8,"PAH",3,1,268,0)="  "
^DIC(9.4,13,22,8,"PAH",3,1,269,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,270,0)="NOISes"
^DIC(9.4,13,22,8,"PAH",3,1,271,0)="======"
