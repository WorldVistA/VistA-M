^DIC(9.4,44,22,3,"PAH",24,1,2,0)="build."
^DIC(9.4,44,22,3,"PAH",25,0)="27 SEQ #25^3020906^1"
^DIC(9.4,44,22,3,"PAH",25,1,0)="^^2^2^3020906"
^DIC(9.4,44,22,3,"PAH",25,1,1,0)="See the National Patch Module for full details of the changes and/or"
^DIC(9.4,44,22,3,"PAH",25,1,2,0)="enhancements included in this build. "
