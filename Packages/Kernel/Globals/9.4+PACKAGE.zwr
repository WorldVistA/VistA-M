^DIC(9.4,13,22,8,"PAH",3,1,279,0)="Routine Summary:"
^DIC(9.4,13,22,8,"PAH",3,1,280,0)="================"
^DIC(9.4,13,22,8,"PAH",3,1,281,0)="The following routines are included in this patch.  The second line"
^DIC(9.4,13,22,8,"PAH",3,1,282,0)="of these routines now looks like:"
^DIC(9.4,13,22,8,"PAH",3,1,283,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,284,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999"
^DIC(9.4,13,22,8,"PAH",3,1,285,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,286,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",3,1,287,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,288,0)="  Routine Name   Before Patch    After Patch     Patch List"
^DIC(9.4,13,22,8,"PAH",3,1,289,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",3,1,290,0)="     DDMOD           N/A            147228           12"
^DIC(9.4,13,22,8,"PAH",3,1,291,0)="     DIKCU1        3879444         3896028           12"
^DIC(9.4,13,22,8,"PAH",3,1,292,0)="     DIKD            N/A           3683869           12"
^DIC(9.4,13,22,8,"PAH",3,1,293,0)="     DIKD1           N/A           2907868           12"
^DIC(9.4,13,22,8,"PAH",3,1,294,0)="     DIKD2           N/A           2009556           12"
^DIC(9.4,13,22,8,"PAH",3,1,295,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,296,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",3,1,297,0)="=========================="
^DIC(9.4,13,22,8,"PAH",3,1,298,0)="This patch can be installed with VISTA users online.  However, it is"
^DIC(9.4,13,22,8,"PAH",3,1,299,0)="recommended that it be Queued for a time of generally least activity."
^DIC(9.4,13,22,8,"PAH",3,1,300,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,301,0)="     1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,8,"PAH",3,1,302,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,8,"PAH",3,1,303,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,304,0)="     2.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,8,"PAH",3,1,305,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",3,1,306,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,307,0)="     3.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",3,1,308,0)="following options:"
^DIC(9.4,13,22,8,"PAH",3,1,309,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,310,0)="            Print Transport Global"
^DIC(9.4,13,22,8,"PAH",3,1,311,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,8,"PAH",3,1,312,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,8,"PAH",3,1,313,0)="            Backup a Transport Global"
^DIC(9.4,13,22,8,"PAH",3,1,314,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,315,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",3,1,316,0)="following option:"
^DIC(9.4,13,22,8,"PAH",3,1,317,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,318,0)="            Select Installation Option: Install Package(s)"
^DIC(9.4,13,22,8,"PAH",3,1,319,0)="            Select INSTALL NAME: DI*22.0*12"
^DIC(9.4,13,22,8,"PAH",3,1,320,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",3,1,321,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,322,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,8,"PAH",3,1,323,0)="Options, and Protocols?"
^DIC(9.4,13,22,8,"PAH",3,1,324,0)=" "
^DIC(9.4,13,22,8,"PAH",3,1,325,0)="     5.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,8,"PAH",3,1,326,0)="set, if necessary."
^DIC(9.4,13,22,8,"PAH",4,0)="14 SEQ #4^2991007^1"
^DIC(9.4,13,22,8,"PAH",4,1,0)="^^147^147^2991007"
^DIC(9.4,13,22,8,"PAH",4,1,1,0)="This patch fixes some bugs, and contains an enhancement to address a Y2K"
^DIC(9.4,13,22,8,"PAH",4,1,2,0)="issue."
^DIC(9.4,13,22,8,"PAH",4,1,3,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,4,0)="Routine: DIDT (%DT), DIDTC (%DTC)"
^DIC(9.4,13,22,8,"PAH",4,1,5,0)="---------------------------------"
^DIC(9.4,13,22,8,"PAH",4,1,6,0)="Bug fixes:"
^DIC(9.4,13,22,8,"PAH",4,1,7,0)="---------"
^DIC(9.4,13,22,8,"PAH",4,1,8,0)="1. Input such as such as ""07/00"", ""JUL 00"", and ""00 JUL"", where the"
^DIC(9.4,13,22,8,"PAH",4,1,9,0)="two-digit year is ""00"", was rejected even if inexact dates are allowed."
^DIC(9.4,13,22,8,"PAH",4,1,10,0)="With this patch, if %%DT'[""X"" the above inputs are interpreted as July"
^DIC(9.4,13,22,8,"PAH",4,1,11,0)="2000."
^DIC(9.4,13,22,8,"PAH",4,1,12,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,13,0)="2. Input such as ""0700"", where the input is exactly 4 numerics with ""00"""
^DIC(9.4,13,22,8,"PAH",4,1,14,0)="as the last to digits, was interpreted as July of the current year (if the"
^DIC(9.4,13,22,8,"PAH",4,1,15,0)="""P"" and ""F"" flags weren't used). With this patch, if %DT'[""X"", ""0700"" is"
^DIC(9.4,13,22,8,"PAH",4,1,16,0)="interpreted as July 2000; if %DT[""X"", it is rejected."
^DIC(9.4,13,22,8,"PAH",4,1,17,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,18,0)="3. Input such as ""070"", where the input is exactly 3 numerics, and the"
^DIC(9.4,13,22,8,"PAH",4,1,19,0)="first two numbers are a valid month and the third number is a 0, was"
^DIC(9.4,13,22,8,"PAH",4,1,20,0)="interpreted as July of the current year (if the ""P"" and ""F"" flags weren't"
^DIC(9.4,13,22,8,"PAH",4,1,21,0)="used). With this patch, ""070"" is rejected."
^DIC(9.4,13,22,8,"PAH",4,1,22,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,23,0)="Enhancement:"
^DIC(9.4,13,22,8,"PAH",4,1,24,0)="-----------"
^DIC(9.4,13,22,8,"PAH",4,1,25,0)="Introduce a new ""M"" flag for %DT. This flag allows input such as ""0701"","
^DIC(9.4,13,22,8,"PAH",4,1,26,0)="""07/01"", ""JUL 01"", ""01 JUL"" to be interpreted as July 2001, instead of"
^DIC(9.4,13,22,8,"PAH",4,1,27,0)="July 1st."
^DIC(9.4,13,22,8,"PAH",4,1,28,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,29,0)="  M      Only Month and year input is allowed (example 1). If only a month"
^DIC(9.4,13,22,8,"PAH",4,1,30,0)="         and two digits are entered, interpret the two digits as a year"
^DIC(9.4,13,22,8,"PAH",4,1,31,0)="         instead of a day (example 2)."
^DIC(9.4,13,22,8,"PAH",4,1,32,0)="         "
^DIC(9.4,13,22,8,"PAH",4,1,33,0)="         If the M flag is used with the X flag, a month must be specified;"
^DIC(9.4,13,22,8,"PAH",4,1,34,0)="         otherwise, the input can be just a year (example 3)."
^DIC(9.4,13,22,8,"PAH",4,1,35,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,36,0)="  M Flag"
^DIC(9.4,13,22,8,"PAH",4,1,37,0)="  ================================================"
^DIC(9.4,13,22,8,"PAH",4,1,38,0)="                     Date            Date Returned"
^DIC(9.4,13,22,8,"PAH",4,1,39,0)="  Ex.   Input        Returned        Without M"
^DIC(9.4,13,22,8,"PAH",4,1,40,0)="  ------------------------------------------------"
^DIC(9.4,13,22,8,"PAH",4,1,41,0)="  1)    7-05-2005    --invalid--     July 5, 2005"
^DIC(9.4,13,22,8,"PAH",4,1,42,0)="  2)    7-05         July 2005       July 5, 2000*"
^DIC(9.4,13,22,8,"PAH",4,1,43,0)="  ================================================"
^DIC(9.4,13,22,8,"PAH",4,1,44,0)="  * Assumes the current year is 2000 and the P and F flags aren't used."
^DIC(9.4,13,22,8,"PAH",4,1,45,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,46,0)="  M Flag with X"
^DIC(9.4,13,22,8,"PAH",4,1,47,0)="  ================================================"
^DIC(9.4,13,22,8,"PAH",4,1,48,0)="                     Date Returned   Date Returned"
^DIC(9.4,13,22,8,"PAH",4,1,49,0)="  Ex.   Input        With X          Without X"
^DIC(9.4,13,22,8,"PAH",4,1,50,0)="  ------------------------------------------------"
^DIC(9.4,13,22,8,"PAH",4,1,51,0)="  3)    05 or 2005   --invalid--     2005"
^DIC(9.4,13,22,8,"PAH",4,1,52,0)="  ================================================"
^DIC(9.4,13,22,8,"PAH",4,1,53,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,54,0)="         "
^DIC(9.4,13,22,8,"PAH",4,1,55,0)="NOISs:"
^DIC(9.4,13,22,8,"PAH",4,1,56,0)="====="
^DIC(9.4,13,22,8,"PAH",4,1,57,0)="ISP-0899-N2311"
^DIC(9.4,13,22,8,"PAH",4,1,58,0)="ISP-0899-N2314"
^DIC(9.4,13,22,8,"PAH",4,1,59,0)="ISP-0899-N2322"
^DIC(9.4,13,22,8,"PAH",4,1,60,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,61,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,62,0)="Thanks to Test Sites:"
^DIC(9.4,13,22,8,"PAH",4,1,63,0)="===================="
^DIC(9.4,13,22,8,"PAH",4,1,64,0)="White City, OR"
^DIC(9.4,13,22,8,"PAH",4,1,65,0)="Bay Pines CIOFO"
^DIC(9.4,13,22,8,"PAH",4,1,66,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,67,0)="   "
^DIC(9.4,13,22,8,"PAH",4,1,68,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",4,1,69,0)="==============="
^DIC(9.4,13,22,8,"PAH",4,1,70,0)="The following routines are included in this patch.  The second line of "
^DIC(9.4,13,22,8,"PAH",4,1,71,0)="these routines now look like: "
^DIC(9.4,13,22,8,"PAH",4,1,72,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,73,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",4,1,74,0)="  "
^DIC(9.4,13,22,8,"PAH",4,1,75,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",4,1,76,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,77,0)="  Routine Name    Before Patch    After Patch    Patch List "
^DIC(9.4,13,22,8,"PAH",4,1,78,0)="  ============    ============    ===========    =========="
^DIC(9.4,13,22,8,"PAH",4,1,79,0)="  DIDT (%DT)        6481242         6856270          14"
^DIC(9.4,13,22,8,"PAH",4,1,80,0)="  DIDTC (%DTC)      7099203         7770956          14"
^DIC(9.4,13,22,8,"PAH",4,1,81,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,82,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,83,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",4,1,84,0)="=========================="
^DIC(9.4,13,22,8,"PAH",4,1,85,0)=" ***********************************************************************"
^DIC(9.4,13,22,8,"PAH",4,1,86,0)=" *  It is HIGHLY recommended that ALL Users and VISTA Background jobs  *"
^DIC(9.4,13,22,8,"PAH",4,1,87,0)=" *  be STOPPED. Failure to do so may result in a 'source routine       *"
^DIC(9.4,13,22,8,"PAH",4,1,88,0)=" *  edited' error. Edits will be lost and records may be left in an    *"
^DIC(9.4,13,22,8,"PAH",4,1,89,0)=" *  inconsistent state.                                                *"
^DIC(9.4,13,22,8,"PAH",4,1,90,0)=" ***********************************************************************"
^DIC(9.4,13,22,8,"PAH",4,1,91,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,92,0)="     1.  AXP sites: Review your mapped routine set. If any of the"
^DIC(9.4,13,22,8,"PAH",4,1,93,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, the should be"
^DIC(9.4,13,22,8,"PAH",4,1,94,0)="removed from the mapped set at this time."
^DIC(9.4,13,22,8,"PAH",4,1,95,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,96,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,8,"PAH",4,1,97,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,8,"PAH",4,1,98,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,99,0)="         The Environment Check Routine DIENVWRN will run automatically."
^DIC(9.4,13,22,8,"PAH",4,1,100,0)="Routine DIENVWRN is sent in order to prevent the inadvertent queuing"
^DIC(9.4,13,22,8,"PAH",4,1,101,0)="during the installation of this patch."
^DIC(9.4,13,22,8,"PAH",4,1,102,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,103,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,8,"PAH",4,1,104,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",4,1,105,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,106,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",4,1,107,0)="following options: "
^DIC(9.4,13,22,8,"PAH",4,1,108,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,109,0)="            Print Transport Global"
^DIC(9.4,13,22,8,"PAH",4,1,110,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,8,"PAH",4,1,111,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,8,"PAH",4,1,112,0)="            Backup a Transport Global"
^DIC(9.4,13,22,8,"PAH",4,1,113,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,114,0)="     5.  Inhibit users from login into the system.  %DT and %DTC are used"
^DIC(9.4,13,22,8,"PAH",4,1,115,0)="heavily in VISTA applications. The consequences of installing this patch"
^DIC(9.4,13,22,8,"PAH",4,1,116,0)="while users are on the system are that users may get a 'source routine"
^DIC(9.4,13,22,8,"PAH",4,1,117,0)="edited' error."
^DIC(9.4,13,22,8,"PAH",4,1,118,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,119,0)="     6.  AXP Sites - Place TaskMan in a WAIT State."
^DIC(9.4,13,22,8,"PAH",4,1,120,0)="         OpenM/Cache Sites - STOP TaskMan.   "
^DIC(9.4,13,22,8,"PAH",4,1,121,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,122,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,8,"PAH",4,1,123,0)="following option:"
^DIC(9.4,13,22,8,"PAH",4,1,124,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,125,0)="            Select Installation Option: Install Package(s)"
^DIC(9.4,13,22,8,"PAH",4,1,126,0)="            Select INSTALL NAME: DI*22.0*14"
^DIC(9.4,13,22,8,"PAH",4,1,127,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",4,1,128,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,129,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,8,"PAH",4,1,130,0)="Options, and Protocols? "
^DIC(9.4,13,22,8,"PAH",4,1,131,0)="        "
^DIC(9.4,13,22,8,"PAH",4,1,132,0)="     8.  After installing this patch, you need to move the routines DIDT"
^DIC(9.4,13,22,8,"PAH",4,1,133,0)="and DIDTC from your production account into your manager account. Then, in"
^DIC(9.4,13,22,8,"PAH",4,1,134,0)="the manager account, rename:"
^DIC(9.4,13,22,8,"PAH",4,1,135,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,136,0)="            DIDT to %DT "
^DIC(9.4,13,22,8,"PAH",4,1,137,0)="            DIDTC to %DTC "
^DIC(9.4,13,22,8,"PAH",4,1,138,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,139,0)="            Example: ZL DIDT ZS %DT "
^DIC(9.4,13,22,8,"PAH",4,1,140,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,141,0)="     9.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,8,"PAH",4,1,142,0)="set, if necessary."
^DIC(9.4,13,22,8,"PAH",4,1,143,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,144,0)="    10.  AXP Sites - Remove TaskMan from WAIT State."
^DIC(9.4,13,22,8,"PAH",4,1,145,0)="         OpenM/Cache Sites - Restart TaskMan."
^DIC(9.4,13,22,8,"PAH",4,1,146,0)=" "
^DIC(9.4,13,22,8,"PAH",4,1,147,0)="    11.  Enable users' login."
^DIC(9.4,13,22,8,"PAH",5,0)="7 SEQ #5^2991019^1"
^DIC(9.4,13,22,8,"PAH",5,1,0)="^^119^119^2991019"
^DIC(9.4,13,22,8,"PAH",5,1,1,0)="Routines: DID1, DID2"
^DIC(9.4,13,22,8,"PAH",5,1,2,0)="--------------------"
^DIC(9.4,13,22,8,"PAH",5,1,3,0)="Bug: When running the List File Attributes option on a file that has"
^DIC(9.4,13,22,8,"PAH",5,1,4,0)="extensive M code for Cross References, Input Transforms and the like, if"
^DIC(9.4,13,22,8,"PAH",5,1,5,0)="the Right Margin was small enough, it was possible to go into an endless"
^DIC(9.4,13,22,8,"PAH",5,1,6,0)="loop. This was noticed when trying to List File Attributes for file #63"
^DIC(9.4,13,22,8,"PAH",5,1,7,0)="and sending the output to the Browser with a right margin less than 132."
^DIC(9.4,13,22,8,"PAH",5,1,8,0)="The result was a ""disk full"" error."
^DIC(9.4,13,22,8,"PAH",5,1,9,0)="(NOIS: BRX-1295-10591)"
^DIC(9.4,13,22,8,"PAH",5,1,10,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,11,0)="Routine: DID1"
^DIC(9.4,13,22,8,"PAH",5,1,12,0)="-------------"
^DIC(9.4,13,22,8,"PAH",5,1,13,0)="Bug: In a Standard DD Listing, the Descriptions of cross-references"
^DIC(9.4,13,22,8,"PAH",5,1,14,0)="weren't formatted correctly within the margins of the report."
^DIC(9.4,13,22,8,"PAH",5,1,15,0)="(NOIS: ISW-1198-21324)"
^DIC(9.4,13,22,8,"PAH",5,1,16,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,17,0)="Routines: DIV, DIVR"
^DIC(9.4,13,22,8,"PAH",5,1,18,0)="-------------------"
^DIC(9.4,13,22,8,"PAH",5,1,19,0)="Bug: If the UTILITY FUNCTIONS/VERIFY FIELDS option is used, the generated"
^DIC(9.4,13,22,8,"PAH",5,1,20,0)="report could scroll off the screen. This patch makes the option prompt for"
^DIC(9.4,13,22,8,"PAH",5,1,21,0)="device, and if the report is printed to the screen, makes it issue the"
^DIC(9.4,13,22,8,"PAH",5,1,22,0)="""Enter RETURN to continue or '^' to exit:"" prompt at the end of each page."
^DIC(9.4,13,22,8,"PAH",5,1,23,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,24,0)="Routines: DIVR, DIVR1"
^DIC(9.4,13,22,8,"PAH",5,1,25,0)="---------------------"
^DIC(9.4,13,22,8,"PAH",5,1,26,0)="Bug: When the UTILITY FUNCTIONS/VERIFY FIELDS option is used, and if a"
^DIC(9.4,13,22,8,"PAH",5,1,27,0)="required or key field equals only one or more spaces, the message"
^DIC(9.4,13,22,8,"PAH",5,1,28,0)="""Missing"" would be printed. This patch changes the message to ""Equals only"
^DIC(9.4,13,22,8,"PAH",5,1,29,0)="1 or more spaces"" to more accurately reflect the reason an entry is"
^DIC(9.4,13,22,8,"PAH",5,1,30,0)="flagged as having a possible problem."
^DIC(9.4,13,22,8,"PAH",5,1,31,0)="(NOIS: ISL-0499-51116)"
^DIC(9.4,13,22,8,"PAH",5,1,32,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,33,0)="Routine: DICATT"
^DIC(9.4,13,22,8,"PAH",5,1,34,0)="---------------"
^DIC(9.4,13,22,8,"PAH",5,1,35,0)="Bug: The prompt after option 4, Modify File Attributes, had a typo:"
^DIC(9.4,13,22,8,"PAH",5,1,36,0)="the word ""USER"" should be ""USE"":"
^DIC(9.4,13,22,8,"PAH",5,1,37,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,38,0)="        DO YOU WANT TO USER THE SCREEN-MODE VERSION? Yes//"
^DIC(9.4,13,22,8,"PAH",5,1,39,0)="                       ===="
^DIC(9.4,13,22,8,"PAH",5,1,40,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,41,0)="Routines: DIPR7, DINIT11B"
^DIC(9.4,13,22,8,"PAH",5,1,42,0)="-------------------------"
^DIC(9.4,13,22,8,"PAH",5,1,43,0)="Bug: Change field 20 DEVELOPER in file 1 (FILE) so that LAYGO is not"
^DIC(9.4,13,22,8,"PAH",5,1,44,0)="allowed to file 200 (NEW PERSON file).  This should have never been"
^DIC(9.4,13,22,8,"PAH",5,1,45,0)="allowed and was an oversite.  DIPR7 is a pre-init routine that changes the"
^DIC(9.4,13,22,8,"PAH",5,1,46,0)="second piece of the field from 200P to 200P'.  DINIT11B is the routine"
^DIC(9.4,13,22,8,"PAH",5,1,47,0)="that is the part of the initialization of FileMan that brings in field 20."
^DIC(9.4,13,22,8,"PAH",5,1,48,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,49,0)=" **NOTE** You may safely delete routine DIPR7 after installing this patch."
^DIC(9.4,13,22,8,"PAH",5,1,50,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,51,0)="NOIS"
^DIC(9.4,13,22,8,"PAH",5,1,52,0)="===="
^DIC(9.4,13,22,8,"PAH",5,1,53,0)=" BRX-1295-10591"
^DIC(9.4,13,22,8,"PAH",5,1,54,0)=" ISL-0499-51116"
^DIC(9.4,13,22,8,"PAH",5,1,55,0)=" ISW-1198-21324"
^DIC(9.4,13,22,8,"PAH",5,1,56,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,57,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",5,1,58,0)="===================="
^DIC(9.4,13,22,8,"PAH",5,1,59,0)=" Bronx, NY"
^DIC(9.4,13,22,8,"PAH",5,1,60,0)=" White River Junction, VT"
^DIC(9.4,13,22,8,"PAH",5,1,61,0)=" Hampton, VA"
^DIC(9.4,13,22,8,"PAH",5,1,62,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,63,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",5,1,64,0)="================"
^DIC(9.4,13,22,8,"PAH",5,1,65,0)=" The following routines are included in this patch.  The second line of "
^DIC(9.4,13,22,8,"PAH",5,1,66,0)="these routines now look like: "
^DIC(9.4,13,22,8,"PAH",5,1,67,0)="  "
^DIC(9.4,13,22,8,"PAH",5,1,68,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999"
^DIC(9.4,13,22,8,"PAH",5,1,69,0)="  "
^DIC(9.4,13,22,8,"PAH",5,1,70,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",5,1,71,0)="  "
^DIC(9.4,13,22,8,"PAH",5,1,72,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",5,1,73,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",5,1,74,0)="      DICATT        8217226         7872715           7"
^DIC(9.4,13,22,8,"PAH",5,1,75,0)="      DID1         10810057        10875512           7"
^DIC(9.4,13,22,8,"PAH",5,1,76,0)="      DID2         10525120        10677478           7"
^DIC(9.4,13,22,8,"PAH",5,1,77,0)="      DINIT11B      3195420         3197349           7"
^DIC(9.4,13,22,8,"PAH",5,1,78,0)="      DIPR7          n/a              27289           7"
^DIC(9.4,13,22,8,"PAH",5,1,79,0)="      DIV           3841210         6086701           7"
^DIC(9.4,13,22,8,"PAH",5,1,80,0)="      DIVR          8571704        10083576           7"
^DIC(9.4,13,22,8,"PAH",5,1,81,0)="      DIVR1        10947202        10953209           7"
^DIC(9.4,13,22,8,"PAH",5,1,82,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,83,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",5,1,84,0)="=========================="
^DIC(9.4,13,22,8,"PAH",5,1,85,0)="This patch can be installed with VISTA users online.  However, it is"
^DIC(9.4,13,22,8,"PAH",5,1,86,0)="recommended that it be Queued for a time of generally least activity."
^DIC(9.4,13,22,8,"PAH",5,1,87,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,88,0)="     1.  AXP sites: Review your mapped routine set. If any of the"
^DIC(9.4,13,22,8,"PAH",5,1,89,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, the should be"
^DIC(9.4,13,22,8,"PAH",5,1,90,0)="removed from the mapped set at this time."
^DIC(9.4,13,22,8,"PAH",5,1,91,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,92,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,8,"PAH",5,1,93,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,8,"PAH",5,1,94,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,95,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,8,"PAH",5,1,96,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",5,1,97,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,98,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",5,1,99,0)="following options:"
^DIC(9.4,13,22,8,"PAH",5,1,100,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,101,0)="            Print Transport Global"
^DIC(9.4,13,22,8,"PAH",5,1,102,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,8,"PAH",5,1,103,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,8,"PAH",5,1,104,0)="            Backup a Transport Global"
^DIC(9.4,13,22,8,"PAH",5,1,105,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,106,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",5,1,107,0)="following option:"
^DIC(9.4,13,22,8,"PAH",5,1,108,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,109,0)="            Select Installation Option: Install Package(s)"
^DIC(9.4,13,22,8,"PAH",5,1,110,0)="            Select INSTALL NAME: DI*22.0*7"
^DIC(9.4,13,22,8,"PAH",5,1,111,0)="                                 ========="
^DIC(9.4,13,22,8,"PAH",5,1,112,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,113,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,8,"PAH",5,1,114,0)="Options, and Protocols?"
^DIC(9.4,13,22,8,"PAH",5,1,115,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,116,0)="     6.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,8,"PAH",5,1,117,0)="set, if necessary."
^DIC(9.4,13,22,8,"PAH",5,1,118,0)=" "
^DIC(9.4,13,22,8,"PAH",5,1,119,0)="     7.  You may optionally delete the pre-installation routine DIPR7."
^DIC(9.4,13,22,8,"PAH",6,0)="16 SEQ #6^2991019^1"
^DIC(9.4,13,22,8,"PAH",6,1,0)="^^104^104^2991019"
^DIC(9.4,13,22,8,"PAH",6,1,1,0)="This patch repairs allocation errors when doing a call to the FileMan"
^DIC(9.4,13,22,8,"PAH",6,1,2,0)="lookup routine ^DIC."
^DIC(9.4,13,22,8,"PAH",6,1,3,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,4,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,5,0)="Routine: DIC3"
^DIC(9.4,13,22,8,"PAH",6,1,6,0)="============="
^DIC(9.4,13,22,8,"PAH",6,1,7,0)="Repairs allocation error at C4+2^DICUIX2. This happened because one of the"
^DIC(9.4,13,22,8,"PAH",6,1,8,0)="Mailman files had some invalid nodes that looked like cross-references."
^DIC(9.4,13,22,8,"PAH",6,1,9,0)="Each node had a subscript that contained an ""R"" followed by a number. This"
^DIC(9.4,13,22,8,"PAH",6,1,10,0)="error would only happen on a real file if it had several thousand"
^DIC(9.4,13,22,8,"PAH",6,1,11,0)="individual cross-references (which would not be likely to happen). Nois:"
^DIC(9.4,13,22,8,"PAH",6,1,12,0)="KAN-0999-40493."
^DIC(9.4,13,22,8,"PAH",6,1,13,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,14,0)="Routines: DICM0,DICM3"
^DIC(9.4,13,22,8,"PAH",6,1,15,0)="====================="
^DIC(9.4,13,22,8,"PAH",6,1,16,0)="Repairs allocation error at S+14^DIC3. This would only happen when a"
^DIC(9.4,13,22,8,"PAH",6,1,17,0)="cross-reference was on a pointer or variable pointer field, there were"
^DIC(9.4,13,22,8,"PAH",6,1,18,0)="many (over 1000) entries that pointed to an entry whose .01 field matched"
^DIC(9.4,13,22,8,"PAH",6,1,19,0)="the value being looked-up, but a screen made it so that most of the"
^DIC(9.4,13,22,8,"PAH",6,1,20,0)="entries with the pointer were not selected. Noises: HIN-0999-42903,"
^DIC(9.4,13,22,8,"PAH",6,1,21,0)="ATG-0999-32715, SLC-0999-52640, DAY-0899-41847."
^DIC(9.4,13,22,8,"PAH",6,1,22,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,23,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,24,0)="NOIS "
^DIC(9.4,13,22,8,"PAH",6,1,25,0)="===="
^DIC(9.4,13,22,8,"PAH",6,1,26,0)=" ATG-0999-32715"
^DIC(9.4,13,22,8,"PAH",6,1,27,0)=" DAY-0899-41847"
^DIC(9.4,13,22,8,"PAH",6,1,28,0)=" HIN-0999-42903"
^DIC(9.4,13,22,8,"PAH",6,1,29,0)=" KAN-0999-40493"
^DIC(9.4,13,22,8,"PAH",6,1,30,0)=" SLC-0999-52640"
^DIC(9.4,13,22,8,"PAH",6,1,31,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,32,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",6,1,33,0)="===================="
^DIC(9.4,13,22,8,"PAH",6,1,34,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,35,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",6,1,36,0)="================"
^DIC(9.4,13,22,8,"PAH",6,1,37,0)=" The following routines are included in this patch.  The second line of these"
^DIC(9.4,13,22,8,"PAH",6,1,38,0)="routines now look like: "
^DIC(9.4,13,22,8,"PAH",6,1,39,0)="  "
^DIC(9.4,13,22,8,"PAH",6,1,40,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",6,1,41,0)="  "
^DIC(9.4,13,22,8,"PAH",6,1,42,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",6,1,43,0)="  "
^DIC(9.4,13,22,8,"PAH",6,1,44,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",6,1,45,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",6,1,46,0)="  DIC3           8138582         8139369         1,16"
^DIC(9.4,13,22,8,"PAH",6,1,47,0)="  DICM0          6941241         8997983         16"
^DIC(9.4,13,22,8,"PAH",6,1,48,0)="  DICM3          3812212         4576635         16"
^DIC(9.4,13,22,8,"PAH",6,1,49,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,50,0)="    "
^DIC(9.4,13,22,8,"PAH",6,1,51,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",6,1,52,0)="=========================="
^DIC(9.4,13,22,8,"PAH",6,1,53,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to be"
^DIC(9.4,13,22,8,"PAH",6,1,54,0)="STOPPED.  Failure to do so may result in a 'source routine edited' error, the"
^DIC(9.4,13,22,8,"PAH",6,1,55,0)="edits will be lost and records may be left in an inconsistent state.  "
^DIC(9.4,13,22,8,"PAH",6,1,56,0)="** "
^DIC(9.4,13,22,8,"PAH",6,1,57,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,58,0)="     1.  AXP sites: Review your mapped routine set.  If any of the routine(s)"
^DIC(9.4,13,22,8,"PAH",6,1,59,0)="listed in the ROUTINE SUMMARY section are mapped, they should be removed from"
^DIC(9.4,13,22,8,"PAH",6,1,60,0)="the mapped set at this time.  "
^DIC(9.4,13,22,8,"PAH",6,1,61,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,62,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,13,22,8,"PAH",6,1,63,0)="option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,8,"PAH",6,1,64,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,65,0)="The environment check routine DIENVWRN will run automatically.  Routine "
^DIC(9.4,13,22,8,"PAH",6,1,66,0)="DIENVWRN is sent in order to prevent the inadvertent queuing during the "
^DIC(9.4,13,22,8,"PAH",6,1,67,0)="installation of this patch.  "
^DIC(9.4,13,22,8,"PAH",6,1,68,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,69,0)="     3.  The patch has now been loaded into a transport global on your system."
^DIC(9.4,13,22,8,"PAH",6,1,70,0)="You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,8,"PAH",6,1,71,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,72,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,8,"PAH",6,1,73,0)="options: "
^DIC(9.4,13,22,8,"PAH",6,1,74,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",6,1,75,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",6,1,76,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",6,1,77,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",6,1,78,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,79,0)="     5.  Inhibit users' login into the system.  The consequence of having users"
^DIC(9.4,13,22,8,"PAH",6,1,80,0)="on the system while installing this patch are that users editing records will"
^DIC(9.4,13,22,8,"PAH",6,1,81,0)="get a 'source routine edited' error, the edits will be lost and records may be"
^DIC(9.4,13,22,8,"PAH",6,1,82,0)="left in an inconsistent state.  Note that most of these routines are heavily"
^DIC(9.4,13,22,8,"PAH",6,1,83,0)="used in DHCP applications.  "
^DIC(9.4,13,22,8,"PAH",6,1,84,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,85,0)="     6.  AXP Sites - Place TaskMan in a WAIT State.  "
^DIC(9.4,13,22,8,"PAH",6,1,86,0)="         OpenM/Cache Sites - STOP TaskMan.  "
^DIC(9.4,13,22,8,"PAH",6,1,87,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,88,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,8,"PAH",6,1,89,0)="option: "
^DIC(9.4,13,22,8,"PAH",6,1,90,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",6,1,91,0)="            Select INSTALL NAME: DI*22.0*16"
^DIC(9.4,13,22,8,"PAH",6,1,92,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",6,1,93,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,94,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,8,"PAH",6,1,95,0)="and Protocols? "
^DIC(9.4,13,22,8,"PAH",6,1,96,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,97,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,98,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map set,"
^DIC(9.4,13,22,8,"PAH",6,1,99,0)="if necessary. "
^DIC(9.4,13,22,8,"PAH",6,1,100,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,101,0)="     9.  AXP Sites - Remove TaskMan from WAIT State.  "
^DIC(9.4,13,22,8,"PAH",6,1,102,0)="         OpenM/Cache Sites - Restart TaskMan.  "
^DIC(9.4,13,22,8,"PAH",6,1,103,0)=" "
^DIC(9.4,13,22,8,"PAH",6,1,104,0)="    10.  Enable users' login.  "
^DIC(9.4,13,22,8,"PAH",7,0)="15 SEQ #7^2991019^1"
^DIC(9.4,13,22,8,"PAH",7,1,0)="^^83^83^2991019"
^DIC(9.4,13,22,8,"PAH",7,1,1,0)="Routine: DICF1 "
^DIC(9.4,13,22,8,"PAH",7,1,2,0)="--------------"
^DIC(9.4,13,22,8,"PAH",7,1,3,0)="A problem was reported when using $$FIND1^DIC and the first"
^DIC(9.4,13,22,8,"PAH",7,1,4,0)="position of the [.]VALUE was equal to a Comma, a Null Subscript error"
^DIC(9.4,13,22,8,"PAH",7,1,5,0)="would occurr at LOOP+3^DICFIX.  For example, VALUE="",DOE,JANE"""
^DIC(9.4,13,22,8,"PAH",7,1,6,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,7,0)="NOIS "
^DIC(9.4,13,22,8,"PAH",7,1,8,0)="===="
^DIC(9.4,13,22,8,"PAH",7,1,9,0)=" DAY-0999-41729"
^DIC(9.4,13,22,8,"PAH",7,1,10,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,11,0)="Thanks to Test Site "
^DIC(9.4,13,22,8,"PAH",7,1,12,0)="===================="
^DIC(9.4,13,22,8,"PAH",7,1,13,0)=" Dayton, OH"
^DIC(9.4,13,22,8,"PAH",7,1,14,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,15,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",7,1,16,0)="================"
^DIC(9.4,13,22,8,"PAH",7,1,17,0)=" The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,8,"PAH",7,1,18,0)="these routines now look like: "
^DIC(9.4,13,22,8,"PAH",7,1,19,0)="  "
^DIC(9.4,13,22,8,"PAH",7,1,20,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",7,1,21,0)="  "
^DIC(9.4,13,22,8,"PAH",7,1,22,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,8,"PAH",7,1,23,0)="  "
^DIC(9.4,13,22,8,"PAH",7,1,24,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,8,"PAH",7,1,25,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",7,1,26,0)="  DICF1          6446378         6462834         15 "
^DIC(9.4,13,22,8,"PAH",7,1,27,0)="    "
^DIC(9.4,13,22,8,"PAH",7,1,28,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",7,1,29,0)="=========================="
^DIC(9.4,13,22,8,"PAH",7,1,30,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to"
^DIC(9.4,13,22,8,"PAH",7,1,31,0)="be STOPPED.  Failure to do so may result in a 'source routine edited'"
^DIC(9.4,13,22,8,"PAH",7,1,32,0)="error, the edits will be lost and records may be left in an"
^DIC(9.4,13,22,8,"PAH",7,1,33,0)="inconsistent state.  "
^DIC(9.4,13,22,8,"PAH",7,1,34,0)="** "
^DIC(9.4,13,22,8,"PAH",7,1,35,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,36,0)="     1.  AXP sites: Review your mapped routine set.  If DICF1 is mapped"
^DIC(9.4,13,22,8,"PAH",7,1,37,0)="on your system, it should be removed from the mapped set at this time.  "
^DIC(9.4,13,22,8,"PAH",7,1,38,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,39,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,13,22,8,"PAH",7,1,40,0)="This option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,8,"PAH",7,1,41,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,42,0)="The environment check routine DIENVWRN will run automatically.  Routine "
^DIC(9.4,13,22,8,"PAH",7,1,43,0)="DIENVWRN is sent in order to prevent the inadvertent queuing during the "
^DIC(9.4,13,22,8,"PAH",7,1,44,0)="installation of this patch.  "
^DIC(9.4,13,22,8,"PAH",7,1,45,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,46,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,8,"PAH",7,1,47,0)="system.  You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,8,"PAH",7,1,48,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,49,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",7,1,50,0)="following options: "
^DIC(9.4,13,22,8,"PAH",7,1,51,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",7,1,52,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",7,1,53,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",7,1,54,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",7,1,55,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,56,0)="     5.  Inhibit users' login into the system.  The consequence of"
^DIC(9.4,13,22,8,"PAH",7,1,57,0)="having users on the system while installing this patch are that users"
^DIC(9.4,13,22,8,"PAH",7,1,58,0)="editing records will get a 'source routine edited' error, the edits"
^DIC(9.4,13,22,8,"PAH",7,1,59,0)="will be lost and records may be left in an inconsistent state.  Note"
^DIC(9.4,13,22,8,"PAH",7,1,60,0)="that DIC11 is heavily used in DHCP applications.  "
^DIC(9.4,13,22,8,"PAH",7,1,61,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,62,0)="     6.  AXP Sites - Place TaskMan in a WAIT State.  "
^DIC(9.4,13,22,8,"PAH",7,1,63,0)="         OpenM/Cache Sites - STOP TaskMan.  "
^DIC(9.4,13,22,8,"PAH",7,1,64,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,65,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",7,1,66,0)="following option: "
^DIC(9.4,13,22,8,"PAH",7,1,67,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",7,1,68,0)="            Select INSTALL NAME: DI*22.0*15 "
^DIC(9.4,13,22,8,"PAH",7,1,69,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",7,1,70,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,71,0)="            Answer 'YES' to 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,13,22,8,"PAH",7,1,72,0)="install?"
^DIC(9.4,13,22,8,"PAH",7,1,73,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,8,"PAH",7,1,74,0)="Options, and Protocols? "
^DIC(9.4,13,22,8,"PAH",7,1,75,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,76,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,77,0)="     8.  AXP Sites - After the patch has been installed, rebuild your"
^DIC(9.4,13,22,8,"PAH",7,1,78,0)="map set, if necessary. "
^DIC(9.4,13,22,8,"PAH",7,1,79,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,80,0)="     9.  AXP Sites - Remove TaskMan from WAIT State.  "
^DIC(9.4,13,22,8,"PAH",7,1,81,0)="         OpenM/Cache Sites - Restart TaskMan.  "
^DIC(9.4,13,22,8,"PAH",7,1,82,0)=" "
^DIC(9.4,13,22,8,"PAH",7,1,83,0)="    10.  Enable users' login.  "
^DIC(9.4,13,22,8,"PAH",8,0)="10 SEQ #8^2991104^1"
^DIC(9.4,13,22,8,"PAH",8,1,0)="^^110^110^2991104"
^DIC(9.4,13,22,8,"PAH",8,1,1,0)="Routine: ^DIK1"
^DIC(9.4,13,22,8,"PAH",8,1,2,0)="--------------"
^DIC(9.4,13,22,8,"PAH",8,1,3,0)="Bug: Suppose ^DIK is used to delete a record with an internal entry number"
^DIC(9.4,13,22,8,"PAH",8,1,4,0)="(ien) of X in a file, X equals what's in the 3rd piece of the header node"
^DIC(9.4,13,22,8,"PAH",8,1,5,0)="of the file, and there is no record in the file with an ien of X-1. If"
^DIC(9.4,13,22,8,"PAH",8,1,6,0)="either of the following is true:"
^DIC(9.4,13,22,8,"PAH",8,1,7,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,8,0)="  - X is the last ien used in the file, and the difference between X and"
^DIC(9.4,13,22,8,"PAH",8,1,9,0)="    the ien of the preceding record is large; or"
^DIC(9.4,13,22,8,"PAH",8,1,10,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,11,0)="  - the difference between X and the ien of the next record is large"
^DIC(9.4,13,22,8,"PAH",8,1,12,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,13,0)="^DIK could go into an extremely time-consuming loop as it attempts to find"
^DIC(9.4,13,22,8,"PAH",8,1,14,0)="the ien of the last (or next) record in the file."
^DIC(9.4,13,22,8,"PAH",8,1,15,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,16,0)="For example, file 16010 has the following header node and entries:"
^DIC(9.4,13,22,8,"PAH",8,1,17,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,18,0)="  ^DIZ(16010,0) = TEST^16010^xxx^3"
^DIC(9.4,13,22,8,"PAH",8,1,19,0)="                              ^------- 3rd piece of header node"
^DIC(9.4,13,22,8,"PAH",8,1,20,0)="  ^DIZ(16010,1,0) = FIRST"
^DIC(9.4,13,22,8,"PAH",8,1,21,0)="  ^DIZ(16010,10,0) = SECOND"
^DIC(9.4,13,22,8,"PAH",8,1,22,0)="  ^DIZ(16010,12345678901234,0) = THIRD"
^DIC(9.4,13,22,8,"PAH",8,1,23,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,24,0)="If you use ^DIK to delete entry #10 (and xxx = 10) or entry"
^DIC(9.4,13,22,8,"PAH",8,1,25,0)="#12345678901234 (and xxx = 12345678901234), ^DIK could go into a"
^DIC(9.4,13,22,8,"PAH",8,1,26,0)="time-consuming loop."
^DIC(9.4,13,22,8,"PAH",8,1,27,0)="(NOIS: IVM-1099-31783)"
^DIC(9.4,13,22,8,"PAH",8,1,28,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,29,0)="Y2K Waiver Exemption Number:"
^DIC(9.4,13,22,8,"PAH",8,1,30,0)="============================"
^DIC(9.4,13,22,8,"PAH",8,1,31,0)="Y2KWE0005"
^DIC(9.4,13,22,8,"PAH",8,1,32,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,33,0)="NOIS:"
^DIC(9.4,13,22,8,"PAH",8,1,34,0)="====="
^DIC(9.4,13,22,8,"PAH",8,1,35,0)="IVM-1099-31783"
^DIC(9.4,13,22,8,"PAH",8,1,36,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,37,0)="Thanks to Test Sites:"
^DIC(9.4,13,22,8,"PAH",8,1,38,0)="====================="
^DIC(9.4,13,22,8,"PAH",8,1,39,0)="HEC-ATLANTA"
^DIC(9.4,13,22,8,"PAH",8,1,40,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,41,0)="Routine Summary:"
^DIC(9.4,13,22,8,"PAH",8,1,42,0)="================"
^DIC(9.4,13,22,8,"PAH",8,1,43,0)="The following routine is included in this patch. The second line of the"
^DIC(9.4,13,22,8,"PAH",8,1,44,0)="routine now looks like:"
^DIC(9.4,13,22,8,"PAH",8,1,45,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,46,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999"
^DIC(9.4,13,22,8,"PAH",8,1,47,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,48,0)="CHECK^XTSUMBLD results:"
^DIC(9.4,13,22,8,"PAH",8,1,49,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,50,0)="  Routine Name   Before Patch    After Patch     Patch List"
^DIC(9.4,13,22,8,"PAH",8,1,51,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,8,"PAH",8,1,52,0)="      DIK1         6302851         6092464          1,10"
^DIC(9.4,13,22,8,"PAH",8,1,53,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,54,0)="Installation Instructions:"
^DIC(9.4,13,22,8,"PAH",8,1,55,0)="=========================="
^DIC(9.4,13,22,8,"PAH",8,1,56,0)=" *************************************************************************"
^DIC(9.4,13,22,8,"PAH",8,1,57,0)=" *  It is HIGHLY recommended that ALL Users and VISTA Background jobs    *"
^DIC(9.4,13,22,8,"PAH",8,1,58,0)=" *  to be STOPPED. Failure to do so may result in a 'source routine      *"
^DIC(9.4,13,22,8,"PAH",8,1,59,0)=" *  edited' error, the edits will be lost and records may be left in an  *"
^DIC(9.4,13,22,8,"PAH",8,1,60,0)=" *  inconsistent state.                                                  *"
^DIC(9.4,13,22,8,"PAH",8,1,61,0)=" *************************************************************************"
^DIC(9.4,13,22,8,"PAH",8,1,62,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,63,0)="     1.  AXP sites: Review your mapped routine set. If any of the"
^DIC(9.4,13,22,8,"PAH",8,1,64,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, the should be"
^DIC(9.4,13,22,8,"PAH",8,1,65,0)="removed from the mapped set at this time."
^DIC(9.4,13,22,8,"PAH",8,1,66,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,67,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,8,"PAH",8,1,68,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,8,"PAH",8,1,69,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,70,0)="         The environment check routine DIENVWRN will run automatically."
^DIC(9.4,13,22,8,"PAH",8,1,71,0)="Routine DIENVWRN is sent in order to prevent the inadvertent queuing"
^DIC(9.4,13,22,8,"PAH",8,1,72,0)="during the installation of this patch."
^DIC(9.4,13,22,8,"PAH",8,1,73,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,74,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,8,"PAH",8,1,75,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",8,1,76,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,77,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",8,1,78,0)="following options:"
^DIC(9.4,13,22,8,"PAH",8,1,79,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,80,0)="            Print Transport Global"
^DIC(9.4,13,22,8,"PAH",8,1,81,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,8,"PAH",8,1,82,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,8,"PAH",8,1,83,0)="            Backup a Transport Global"
^DIC(9.4,13,22,8,"PAH",8,1,84,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,85,0)="     5.  Inhibit users' login into the system. The consequence of having"
^DIC(9.4,13,22,8,"PAH",8,1,86,0)="users on the system while installing this patch are that users editing"
^DIC(9.4,13,22,8,"PAH",8,1,87,0)="records will get a 'source routine edited' error, the edits will be lost"
^DIC(9.4,13,22,8,"PAH",8,1,88,0)="and records may be left in an inconsistent state. Note that most of these"
^DIC(9.4,13,22,8,"PAH",8,1,89,0)="routines are heavily used in DHCP applications."
^DIC(9.4,13,22,8,"PAH",8,1,90,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,91,0)="     6.  AXP Sites - Place TaskMan in a WAIT State."
^DIC(9.4,13,22,8,"PAH",8,1,92,0)="         OpenM/Cache Sites - STOP TaskMan."
^DIC(9.4,13,22,8,"PAH",8,1,93,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,94,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",8,1,95,0)="following option:"
^DIC(9.4,13,22,8,"PAH",8,1,96,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,97,0)="            Select Installation Option: Install Package(s)"
^DIC(9.4,13,22,8,"PAH",8,1,98,0)="            Select INSTALL NAME: DI*22.0*10"
^DIC(9.4,13,22,8,"PAH",8,1,99,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",8,1,100,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,101,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,8,"PAH",8,1,102,0)="Options, and Protocols?"
^DIC(9.4,13,22,8,"PAH",8,1,103,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,104,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,8,"PAH",8,1,105,0)="set, if necessary."
^DIC(9.4,13,22,8,"PAH",8,1,106,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,107,0)="     9.  AXP Sites - Remove TaskMan from WAIT State."
^DIC(9.4,13,22,8,"PAH",8,1,108,0)="         OpenM/Cache Sites - Restart TaskMan."
^DIC(9.4,13,22,8,"PAH",8,1,109,0)=" "
^DIC(9.4,13,22,8,"PAH",8,1,110,0)="    10.  Enable users' login."
^DIC(9.4,13,22,8,"PAH",9,0)="4 SEQ #9^2991123^1"
^DIC(9.4,13,22,8,"PAH",9,1,0)="^^306^306^2991123"
^DIC(9.4,13,22,8,"PAH",9,1,1,0)="This patch fixed a few minor bugs and adds some enhancements to correct"
^DIC(9.4,13,22,8,"PAH",9,1,2,0)="deficiencies in the FileMan Lookup routines ^DIC*, Finder routines ^DICF*,"
^DIC(9.4,13,22,8,"PAH",9,1,3,0)="and Editing routines ^DIE*."
^DIC(9.4,13,22,8,"PAH",9,1,4,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,5,0)="***** Y2K Waiver Exemption ID#:  Y2KWE0015 *****"
^DIC(9.4,13,22,8,"PAH",9,1,6,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,7,0)="Routines: DIC,DIC1,DICM,DICM0,DICM3"
^DIC(9.4,13,22,8,"PAH",9,1,8,0)="-----------------------------------"
^DIC(9.4,13,22,8,"PAH",9,1,9,0)="""^^"" OUT.  Users will be allowed to enter a double up-arrow ^^ at a prompt"
^DIC(9.4,13,22,8,"PAH",9,1,10,0)="in the ^DIC lookup.  This will get them clear out of the lookup."
^DIC(9.4,13,22,8,"PAH",9,1,11,0)="Previously, users wre able to enter a single up-arrow ^ but this only took"
^DIC(9.4,13,22,8,"PAH",9,1,12,0)="them out of the search through the current index.  If there were many"
^DIC(9.4,13,22,8,"PAH",9,1,13,0)="indexes being searched, the search could continue for a long time with no"
^DIC(9.4,13,22,8,"PAH",9,1,14,0)="way to exit. NOIS: NTH-0399-71535."
^DIC(9.4,13,22,8,"PAH",9,1,15,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,16,0)="Routines: DDSU,DICQ,DICQ1,DICLIX"
^DIC(9.4,13,22,8,"PAH",9,1,17,0)="--------------------------------"
^DIC(9.4,13,22,8,"PAH",9,1,18,0)="Control number of entries displayed in ""?"" help.  Developers needed a way"
^DIC(9.4,13,22,8,"PAH",9,1,19,0)="to control question mark help in the ^DIC lookup so that the output didn't"
^DIC(9.4,13,22,8,"PAH",9,1,20,0)="scroll off the screen.  New input variable"
^DIC(9.4,13,22,8,"PAH",9,1,21,0)="DIC(""?N"",file#)=number_of_entries_to_display can be set to the number of"
^DIC(9.4,13,22,8,"PAH",9,1,22,0)="entries to be displayed at any one time in question mark help.  NOIS:"
^DIC(9.4,13,22,8,"PAH",9,1,23,0)="ISW-0199-21924."
^DIC(9.4,13,22,8,"PAH",9,1,24,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,25,0)="Routines: DIC4,DICF4,DICM0,DICM3,DICN,DICQ1,DIE,DIE1,DIE17,DIE3,DIED,DIEZ1"
^DIC(9.4,13,22,8,"PAH",9,1,26,0)="--------------------------------------------------------------------------"
^DIC(9.4,13,22,8,"PAH",9,1,27,0)="Control lookup to pointed-to files.  During lookups on files with"
^DIC(9.4,13,22,8,"PAH",9,1,28,0)="either indexed pointer or variable pointer fields, FileMan does a lookup"
^DIC(9.4,13,22,8,"PAH",9,1,29,0)="on the pointed-to file, lookup for a match to the lookup value entered by"
^DIC(9.4,13,22,8,"PAH",9,1,30,0)="the user. FileMan always looked on either the ""B"" index only on the"
^DIC(9.4,13,22,8,"PAH",9,1,31,0)="pointed-to file (if DIC(0) did not contain ""M""), or else on all lookup"
^DIC(9.4,13,22,8,"PAH",9,1,32,0)="indexes.  A new input array to the interactive lookup ^DIC or to the"
^DIC(9.4,13,22,8,"PAH",9,1,33,0)="silent data base server lookup routine FIND^DIC, allows the developer to"
^DIC(9.4,13,22,8,"PAH",9,1,34,0)="specify what indexes are to be used during lookup on a pointed-to file."
^DIC(9.4,13,22,8,"PAH",9,1,35,0)="The array for ^DIC looks like"
^DIC(9.4,13,22,8,"PAH",9,1,36,0)="  DIC(""PTRIX"",from_file#,pointer_field#,to_file#)=list_of_indexes."
^DIC(9.4,13,22,8,"PAH",9,1,37,0)="For the Finder, it looks like"
^DIC(9.4,13,22,8,"PAH",9,1,38,0)="  DINDEX((""PTRIX"",from_file#,pointer_field#,to_file#)=list_of_indexes"
^DIC(9.4,13,22,8,"PAH",9,1,39,0)="For ^DIE, it looks like:"
^DIC(9.4,13,22,8,"PAH",9,1,40,0)="  DIE(""PTRIX"",from_file#,pointer_field#,to_file#)=list_of_indexes"
^DIC(9.4,13,22,8,"PAH",9,1,41,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,42,0)="Routines: DIC,DIC0,DIC1,DIC2,DIC3,DIC5,DICFIX,DICM,DICM0,DICM3 "
^DIC(9.4,13,22,8,"PAH",9,1,43,0)="--------------------------------------------------------------"
^DIC(9.4,13,22,8,"PAH",9,1,44,0)="ConTinue looking through all indexes.  ^DIC lookup does an initial pass"
^DIC(9.4,13,22,8,"PAH",9,1,45,0)="through the list of indexes, looking for matches to the lookup value as it"
^DIC(9.4,13,22,8,"PAH",9,1,46,0)="was entered by the user.  If any are found, they are presented to the"
^DIC(9.4,13,22,8,"PAH",9,1,47,0)="user, and whether or not any are accepted, FileMan gets out.  Only if it"
^DIC(9.4,13,22,8,"PAH",9,1,48,0)="finds no matches, does it attempt transforms on the lookup, such as"
^DIC(9.4,13,22,8,"PAH",9,1,49,0)="converting pointers, variable pointers, sets or dates to their internal"
^DIC(9.4,13,22,8,"PAH",9,1,50,0)="format, or converting the lookup value to upper case.  This can cause the"
^DIC(9.4,13,22,8,"PAH",9,1,51,0)="lookup to miss some of the matching values.  A new flag ""T"" can be put"
^DIC(9.4,13,22,8,"PAH",9,1,52,0)="into DIC(0) that will cause FileMan to keep looking until it has either"
^DIC(9.4,13,22,8,"PAH",9,1,53,0)="tried everything, or until the user selects an entry.  In addition, the"
^DIC(9.4,13,22,8,"PAH",9,1,54,0)="transforms for pointers, variable pointers, dates or sets are done during"
^DIC(9.4,13,22,8,"PAH",9,1,55,0)="the first pass, so indexes are truly searched in the order requested by"
^DIC(9.4,13,22,8,"PAH",9,1,56,0)="the user.  NOIS: ATG-0397-30298, BRX-0197-11979, MAD-0394-40135."
^DIC(9.4,13,22,8,"PAH",9,1,57,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,58,0)="Routines: DICF2,DICF3,DICF4,DICF5 "
^DIC(9.4,13,22,8,"PAH",9,1,59,0)="---------------------------------"
^DIC(9.4,13,22,8,"PAH",9,1,60,0)="""O"" flag in Finder call.  It was discovered here that the ""O"" flag in the"
^DIC(9.4,13,22,8,"PAH",9,1,61,0)="finder didn't work the same in version 22 as it did in version 21.  With"
^DIC(9.4,13,22,8,"PAH",9,1,62,0)="this patch, the behavior is the same as version 21, in that an entire pass"
^DIC(9.4,13,22,8,"PAH",9,1,63,0)="through all indexes is made to find any exact matches, before doing a"
^DIC(9.4,13,22,8,"PAH",9,1,64,0)="second pass to find partial matches. NOIS: PAL-1099-60334, LAH-1099-60966"
^DIC(9.4,13,22,8,"PAH",9,1,65,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,66,0)="Routine: DICN1"
^DIC(9.4,13,22,8,"PAH",9,1,67,0)="-------------- "
^DIC(9.4,13,22,8,"PAH",9,1,68,0)="'Before' values in SET/KILL logic.  It was discovered here that when a new"
^DIC(9.4,13,22,8,"PAH",9,1,69,0)="entry was added using the classic interactive lookup ^DIC, the X1 and X2"
^DIC(9.4,13,22,8,"PAH",9,1,70,0)="array entries for the ""BEFORE"" values for use in the SET and KILL logic of"
^DIC(9.4,13,22,8,"PAH",9,1,71,0)="new style indexes were not always reliable.  This corrects that bug."
^DIC(9.4,13,22,8,"PAH",9,1,72,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,73,0)="Routine: DICM"
^DIC(9.4,13,22,8,"PAH",9,1,74,0)="-------------"
^DIC(9.4,13,22,8,"PAH",9,1,75,0)="'Missing Right Parenthesis' error in Print.  When doing a print, at the"
^DIC(9.4,13,22,8,"PAH",9,1,76,0)="PRINT FIELD prompt, if a field name greater than 30 characters long was"
^DIC(9.4,13,22,8,"PAH",9,1,77,0)="entered, along with a header qualifier in mixed case, a 'missing right"
^DIC(9.4,13,22,8,"PAH",9,1,78,0)="parenthesis' error occurred.  This error was actually happening during the"
^DIC(9.4,13,22,8,"PAH",9,1,79,0)="lookup for field name on the DD.  NOIS: BRX-0699-11412."
^DIC(9.4,13,22,8,"PAH",9,1,80,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,81,0)="Routine: DICM2"
^DIC(9.4,13,22,8,"PAH",9,1,82,0)="--------------"
^DIC(9.4,13,22,8,"PAH",9,1,83,0)="Variable pointer prefix in lower case.  When doing a lookup on an indexed"
^DIC(9.4,13,22,8,"PAH",9,1,84,0)="variable pointer field, if the user entered the prefix in lower case or"
^DIC(9.4,13,22,8,"PAH",9,1,85,0)="mixed case, but the prefix was in upper case on the file, the lookup"
^DIC(9.4,13,22,8,"PAH",9,1,86,0)="failed.  NOIS: ISL-0699-52609."
^DIC(9.4,13,22,8,"PAH",9,1,87,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,88,0)="Routine: DICUIX2"
^DIC(9.4,13,22,8,"PAH",9,1,89,0)="----------------"
^DIC(9.4,13,22,8,"PAH",9,1,90,0)="UNDEF error in lookup.  It was discovered here that an UNDEF error could"
^DIC(9.4,13,22,8,"PAH",9,1,91,0)="occur if the code used to build index information for the classic lookup"
^DIC(9.4,13,22,8,"PAH",9,1,92,0)="^DIC or the Finder FIND^DIC could not determine what field was indexed."
^DIC(9.4,13,22,8,"PAH",9,1,93,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,94,0)="Routines: DICQ, DICQ1, DICUIX1"
^DIC(9.4,13,22,8,"PAH",9,1,95,0)="------------------------------"
^DIC(9.4,13,22,8,"PAH",9,1,96,0)="Question mark help was very slow when a fairly large file pointed to a"
^DIC(9.4,13,22,8,"PAH",9,1,97,0)="very large file like the PATIENT file. We were building a temporary index."
^DIC(9.4,13,22,8,"PAH",9,1,98,0)="The algorithm that decides when to build an index was changed. Also, in"
^DIC(9.4,13,22,8,"PAH",9,1,99,0)="question mark help, we won't ever build a temporary index, but will"
^DIC(9.4,13,22,8,"PAH",9,1,100,0)="instead $O through the index on the pointer, so records will not be in"
^DIC(9.4,13,22,8,"PAH",9,1,101,0)="alphabetic sequence. This sequence was always used on pointers in V21."
^DIC(9.4,13,22,8,"PAH",9,1,102,0)="NOIS: MAC-0999-63042"
^DIC(9.4,13,22,8,"PAH",9,1,103,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,104,0)="Routine: DIC5"
^DIC(9.4,13,22,8,"PAH",9,1,105,0)="-------------"
^DIC(9.4,13,22,8,"PAH",9,1,106,0)="When a numeric lookup value is entered and indexed field is a pointer,"
^DIC(9.4,13,22,8,"PAH",9,1,107,0)="make lookup by IEN work the way it did in version 21.  NOIS:"
^DIC(9.4,13,22,8,"PAH",9,1,108,0)="FGH-1099-30988, PTH-1099-21795, BHH-1099-41454"
^DIC(9.4,13,22,8,"PAH",9,1,109,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,110,0)="Routine: DIC3"
^DIC(9.4,13,22,8,"PAH",9,1,111,0)="-------------"
^DIC(9.4,13,22,8,"PAH",9,1,112,0)="Lookups on the DRUG file by synonym were selecting the right drug, but"
^DIC(9.4,13,22,8,"PAH",9,1,113,0)="displaying the wrong .01 field value. This happened when DIC(0) contained"
^DIC(9.4,13,22,8,"PAH",9,1,114,0)="an ""O"", there was more than one exact match on the SYNONYM index to the"
^DIC(9.4,13,22,8,"PAH",9,1,115,0)="lookup value, but all but one match were screened out by a DIC(""S"")"
^DIC(9.4,13,22,8,"PAH",9,1,116,0)="screen.  NOIS: BHH-1099-40749, CAH-1099-31208, ISB-1099-33134,"
^DIC(9.4,13,22,8,"PAH",9,1,117,0)="IOW-1099-42292, POP-1099-42462, TUC-1099-61597"
^DIC(9.4,13,22,8,"PAH",9,1,118,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,119,0)="Routine: DIC"
^DIC(9.4,13,22,8,"PAH",9,1,120,0)="------------"
^DIC(9.4,13,22,8,"PAH",9,1,121,0)="DIC(""W"") was being set earlier in a call to ^DIC in Version 22 than it was"
^DIC(9.4,13,22,8,"PAH",9,1,122,0)="in Version 21.  This caused an UNDEF error to occur in some files with a"
^DIC(9.4,13,22,8,"PAH",9,1,123,0)="user-defined lookup. This change restores backwards compatibility in this"
^DIC(9.4,13,22,8,"PAH",9,1,124,0)="area to V21. NOIS: MUR-0999-31608"
^DIC(9.4,13,22,8,"PAH",9,1,125,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,126,0)="Routine: DICF4"
^DIC(9.4,13,22,8,"PAH",9,1,127,0)="--------------"
^DIC(9.4,13,22,8,"PAH",9,1,128,0)="When a call to FIND^DIC was made with the ""M"" flag, and an entry was found"
^DIC(9.4,13,22,8,"PAH",9,1,129,0)="on an index other than the first one in the list, an extra node was"
^DIC(9.4,13,22,8,"PAH",9,1,130,0)="returned containing the external index value, even if the FIELDS parameter"
^DIC(9.4,13,22,8,"PAH",9,1,131,0)="did not contain ""IXE"". This caused the Finder Delphi Component to display"
^DIC(9.4,13,22,8,"PAH",9,1,132,0)="the wrong values.  NOIS: BAY-1199-30365"
^DIC(9.4,13,22,8,"PAH",9,1,133,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,134,0)="Routine: DICA"
^DIC(9.4,13,22,8,"PAH",9,1,135,0)="-------------"
^DIC(9.4,13,22,8,"PAH",9,1,136,0)="If an UPDATE^DIE call is made and the FDA uses a LAYGO/Finding node to"
^DIC(9.4,13,22,8,"PAH",9,1,137,0)="lookup or add an entry at the top level of a file, and an Adding node is"
^DIC(9.4,13,22,8,"PAH",9,1,138,0)="used to add an entry into a multiple within that record, and the top level"
^DIC(9.4,13,22,8,"PAH",9,1,139,0)="record is added because it was not found, a null subscript error would"
^DIC(9.4,13,22,8,"PAH",9,1,140,0)="occur. For example, if the FDA is:"
^DIC(9.4,13,22,8,"PAH",9,1,141,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,142,0)="        FDA(1000,""?+1,"",.01)=""TEST ENTRY"""
^DIC(9.4,13,22,8,"PAH",9,1,143,0)="        FDA(1000.02,""+2,?+1,"",.01)=""TEST SUBENTRY"""
^DIC(9.4,13,22,8,"PAH",9,1,144,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,145,0)="and the Updater has to add TEST ENTRY to file #1000, a null subscript"
^DIC(9.4,13,22,8,"PAH",9,1,146,0)="error will occur."
^DIC(9.4,13,22,8,"PAH",9,1,147,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,148,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,149,0)="Routines: DIE1,DIE2"
^DIC(9.4,13,22,8,"PAH",9,1,150,0)="-------------------"
^DIC(9.4,13,22,8,"PAH",9,1,151,0)="If ^DIE was used to edit a subfile directly, and that subfile was at least"
^DIC(9.4,13,22,8,"PAH",9,1,152,0)="two levels down from the top, ^DIE was not updating the DA array correctly"
^DIC(9.4,13,22,8,"PAH",9,1,153,0)="when the user went down into and back out of multiples within that"
^DIC(9.4,13,22,8,"PAH",9,1,154,0)="subfile. NOIS: ISW-0599-20886"
^DIC(9.4,13,22,8,"PAH",9,1,155,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,156,0)="Routine: DIEQ"
^DIC(9.4,13,22,8,"PAH",9,1,157,0)="-------------"
^DIC(9.4,13,22,8,"PAH",9,1,158,0)="Set the DA array to the subfile level if the user enters ? or ?? at the"
^DIC(9.4,13,22,8,"PAH",9,1,159,0)="Select prompt of a multiple. This ensures that xecutable help, screens on"
^DIC(9.4,13,22,8,"PAH",9,1,160,0)="pointer or sets, and input transforms on the .01 field of the multiple can"
^DIC(9.4,13,22,8,"PAH",9,1,161,0)="rely on the DA array to be at the subfile level, whether ? or ?? is"
^DIC(9.4,13,22,8,"PAH",9,1,162,0)="entered at the Select prompt or at the .01 field of the multiple."
^DIC(9.4,13,22,8,"PAH",9,1,163,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,164,0)="NOIS "
^DIC(9.4,13,22,8,"PAH",9,1,165,0)="===="
^DIC(9.4,13,22,8,"PAH",9,1,166,0)=" ATG-0397-30298"
^DIC(9.4,13,22,8,"PAH",9,1,167,0)=" ATG-1199-31667"
^DIC(9.4,13,22,8,"PAH",9,1,168,0)=" BAY-1199-30365"
^DIC(9.4,13,22,8,"PAH",9,1,169,0)=" BHH-1099-40749"
^DIC(9.4,13,22,8,"PAH",9,1,170,0)=" BHH-1099-41454"
^DIC(9.4,13,22,8,"PAH",9,1,171,0)=" BRX-0197-11979"
^DIC(9.4,13,22,8,"PAH",9,1,172,0)=" BRX-0699-11412"
^DIC(9.4,13,22,8,"PAH",9,1,173,0)=" CAH-1099-31208"
^DIC(9.4,13,22,8,"PAH",9,1,174,0)=" CHA-1099-30189"
^DIC(9.4,13,22,8,"PAH",9,1,175,0)=" FGH-1099-30988"
^DIC(9.4,13,22,8,"PAH",9,1,176,0)=" IOW-1099-42292"
^DIC(9.4,13,22,8,"PAH",9,1,177,0)=" ISB-1099-33134"
^DIC(9.4,13,22,8,"PAH",9,1,178,0)=" ISL-0699-52609"
^DIC(9.4,13,22,8,"PAH",9,1,179,0)=" ISW-0199-21924"
^DIC(9.4,13,22,8,"PAH",9,1,180,0)=" ISW-0599-20886"
^DIC(9.4,13,22,8,"PAH",9,1,181,0)=" LAH-1099-60966"
^DIC(9.4,13,22,8,"PAH",9,1,182,0)=" MAC-0999-63042"
^DIC(9.4,13,22,8,"PAH",9,1,183,0)=" MAD-0394-40135"
^DIC(9.4,13,22,8,"PAH",9,1,184,0)=" MUR-0999-31608"
^DIC(9.4,13,22,8,"PAH",9,1,185,0)=" NHM-1199-10884"
^DIC(9.4,13,22,8,"PAH",9,1,186,0)=" NTH-0399-71535"
^DIC(9.4,13,22,8,"PAH",9,1,187,0)=" PAL-1099-60334"
^DIC(9.4,13,22,8,"PAH",9,1,188,0)=" POP-1099-42462"
^DIC(9.4,13,22,8,"PAH",9,1,189,0)=" POR-1199-51265"
^DIC(9.4,13,22,8,"PAH",9,1,190,0)=" PTH-1099-21795"
^DIC(9.4,13,22,8,"PAH",9,1,191,0)=" TUC-1099-61597"
^DIC(9.4,13,22,8,"PAH",9,1,192,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,193,0)="Thanks to Test Sites "
^DIC(9.4,13,22,8,"PAH",9,1,194,0)="===================="
^DIC(9.4,13,22,8,"PAH",9,1,195,0)="Fort-Meade"
^DIC(9.4,13,22,8,"PAH",9,1,196,0)="Washington"
^DIC(9.4,13,22,8,"PAH",9,1,197,0)="Portland"
^DIC(9.4,13,22,8,"PAH",9,1,198,0)="Poplar-Bluff"
^DIC(9.4,13,22,8,"PAH",9,1,199,0)="David Alexander - Birmingham CIOFO"
^DIC(9.4,13,22,8,"PAH",9,1,200,0)="Lucille Barrios - Washington ISC"
^DIC(9.4,13,22,8,"PAH",9,1,201,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,202,0)="Thanks to anyone I may have missed on this list. Your help in testing is"
^DIC(9.4,13,22,8,"PAH",9,1,203,0)="invaluable to us."
^DIC(9.4,13,22,8,"PAH",9,1,204,0)=" "
^DIC(9.4,13,22,8,"PAH",9,1,205,0)="Routine Summary: "
^DIC(9.4,13,22,8,"PAH",9,1,206,0)="================"
^DIC(9.4,13,22,8,"PAH",9,1,207,0)=" The following routines are included in this patch.  The second line of these"
^DIC(9.4,13,22,8,"PAH",9,1,208,0)="routines now look like: "
^DIC(9.4,13,22,8,"PAH",9,1,209,0)="  "
^DIC(9.4,13,22,8,"PAH",9,1,210,0)="  <tab>;;22.0;VA FileMan;**[patch list]**;Mar 30, 1999 "
^DIC(9.4,13,22,8,"PAH",9,1,211,0)="  "
^DIC(9.4,13,22,8,"PAH",9,1,212,0)="CHECK^XTSUMBLD results: "
