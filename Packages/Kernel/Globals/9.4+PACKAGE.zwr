^DIC(9.4,53,22,20,"PAH",1,1,0)="^^2^2^2960702"
^DIC(9.4,53,22,20,"PAH",1,1,1,0)="These are the routines for patch 41, which produces Bill and Transaction"
^DIC(9.4,53,22,20,"PAH",1,1,2,0)="reports for the IG office."
^DIC(9.4,53,22,20,"PAH",2,0)="44 SEQ #31^2960715^1"
