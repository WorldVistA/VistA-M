^DIC(9.4,3,22,21,"PAH",21,1,105,0)="============================================================================"
^DIC(9.4,3,22,21,"PAH",21,1,106,0)="DOCUMENTATION:"
^DIC(9.4,3,22,21,"PAH",21,1,107,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,108,0)=" OPTION:"
^DIC(9.4,3,22,21,"PAH",21,1,109,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,110,0)=" Systems Manager Menu ..."
^DIC(9.4,3,22,21,"PAH",21,1,111,0)="   Programmer Options ..."
^DIC(9.4,3,22,21,"PAH",21,1,112,0)="     Routine Tools ..."
^DIC(9.4,3,22,21,"PAH",21,1,113,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,114,0)="'Check Routines on Other CPUs'     Option name: XUPR RTN CHKSUM"
^DIC(9.4,3,22,21,"PAH",21,1,115,0)="   This option will compare the Checksum for routines in the Production"
^DIC(9.4,3,22,21,"PAH",21,1,116,0)="   account of one system to the checksums for the same routines on another"
^DIC(9.4,3,22,21,"PAH",21,1,117,0)="   system.  It is only for sites who have Compute and Print Servers with"
^DIC(9.4,3,22,21,"PAH",21,1,118,0)="   different routine directories."
^DIC(9.4,3,22,21,"PAH",21,1,119,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,120,0)="'Routines by Patch Number'     Option name: XUPR RTN PATCH"
^DIC(9.4,3,22,21,"PAH",21,1,121,0)="   This options will print routines associated with a patch.  You must"
^DIC(9.4,3,22,21,"PAH",21,1,122,0)="   enter a list of routines and then the output will be by patch numbers."
^DIC(9.4,3,22,21,"PAH",21,1,123,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,124,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,125,0)=" Systems Manager Menu ..."
^DIC(9.4,3,22,21,"PAH",21,1,126,0)="   Programmer Options ..."
^DIC(9.4,3,22,21,"PAH",21,1,127,0)="     Kernel Installation & Distribution System ..."
^DIC(9.4,3,22,21,"PAH",21,1,128,0)="       Utilities ..."
^DIC(9.4,3,22,21,"PAH",21,1,129,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,130,0)="'Display Patches for a Package'     Option name: XPD PRINT PACKAGE PATCHES"
^DIC(9.4,3,22,21,"PAH",21,1,131,0)="     This option will print all patches installed for a Package. It displays"
^DIC(9.4,3,22,21,"PAH",21,1,132,0)="     the Date Installed and who installed the patches. It optionally will"
^DIC(9.4,3,22,21,"PAH",21,1,133,0)="     print the description of the patch. All information comes from the"
^DIC(9.4,3,22,21,"PAH",21,1,134,0)="     Package file."
^DIC(9.4,3,22,21,"PAH",21,1,135,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,136,0)="'Rollup Patches into a Build'     Option name: XPD ROLLUP PATCHES"
^DIC(9.4,3,22,21,"PAH",21,1,137,0)="     This option will find all the patches for a Package and add their Build"
^DIC(9.4,3,22,21,"PAH",21,1,138,0)="     file definition to the Package Build file definition.  This will enable"
^DIC(9.4,3,22,21,"PAH",21,1,139,0)="     you to create a single Build file entry that contains the definition for"
^DIC(9.4,3,22,21,"PAH",21,1,140,0)="     a patched Package."
^DIC(9.4,3,22,21,"PAH",21,1,141,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,142,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,143,0)=" DATA DICTIONARY:  Partial DD"
^DIC(9.4,3,22,21,"PAH",21,1,144,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,145,0)="  File:  BUILD #9.6"
^DIC(9.4,3,22,21,"PAH",21,1,146,0)="   Field:  REQUIRED BUILD #11"
^DIC(9.4,3,22,21,"PAH",21,1,147,0)="    Subfield:"
^DIC(9.4,3,22,21,"PAH",21,1,148,0)="    .01    REQUIRED BUILD"
^DIC(9.4,3,22,21,"PAH",21,1,149,0)="             Enter a Build name, a patch or package, that is required to"
^DIC(9.4,3,22,21,"PAH",21,1,150,0)="             be installed before this Build is installed.  KIDS will check"
^DIC(9.4,3,22,21,"PAH",21,1,151,0)="             the Package file, Version multiple and Patch Application"
^DIC(9.4,3,22,21,"PAH",21,1,152,0)="             History multiple, to verify that the Required Build has been"
^DIC(9.4,3,22,21,"PAH",21,1,153,0)="             installed.  "
^DIC(9.4,3,22,21,"PAH",21,1,154,0)="    1      ACTION"
^DIC(9.4,3,22,21,"PAH",21,1,155,0)="             This is the action you want to happen when installing this"
^DIC(9.4,3,22,21,"PAH",21,1,156,0)="             Build and the Required Build has not been installed at the"
^DIC(9.4,3,22,21,"PAH",21,1,157,0)="             site.  "
^DIC(9.4,3,22,21,"PAH",21,1,158,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,159,0)="   Field:  MULTIPLE BUILD #10"
^DIC(9.4,3,22,21,"PAH",21,1,160,0)="    Subfield:"
^DIC(9.4,3,22,21,"PAH",21,1,161,0)="    .001   INSTALL ORDER"
^DIC(9.4,3,22,21,"PAH",21,1,162,0)="             This is the order in which this package will be installed."
^DIC(9.4,3,22,21,"PAH",21,1,163,0)="    .01    MULTIPLE BUILD"
^DIC(9.4,3,22,21,"PAH",21,1,164,0)="             Name of Build that will be part of this multi-package"
^DIC(9.4,3,22,21,"PAH",21,1,165,0)="             distribution or a patch that is part of this Build definition.  "
^DIC(9.4,3,22,21,"PAH",21,1,166,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,167,0)="  File:  INSTALL #9.7"
^DIC(9.4,3,22,21,"PAH",21,1,168,0)="   Field:  VOLUME SET #30"
^DIC(9.4,3,22,21,"PAH",21,1,169,0)="    Subfield:"
^DIC(9.4,3,22,21,"PAH",21,1,170,0)="    .01    VOLUME SET"
^DIC(9.4,3,22,21,"PAH",21,1,171,0)="             Enter the name of the VOLUME SET that you want updated when"
^DIC(9.4,3,22,21,"PAH",21,1,172,0)="             this package is installed. This field points to the VOLUME SET"
^DIC(9.4,3,22,21,"PAH",21,1,173,0)="             file, #14.5. A VOLUME SET must have the field SIGNON/PRODUCTION"
^DIC(9.4,3,22,21,"PAH",21,1,174,0)="             VOLUME SET, #9, set to YES."
^DIC(9.4,3,22,21,"PAH",21,1,175,0)=""
^DIC(9.4,3,22,21,"PAH",21,1,176,0)="  File:  VOLUME SET #14.5"
^DIC(9.4,3,22,21,"PAH",21,1,177,0)="   Field:  SIGNON/PRODUCTION VOLUME SET #9"
^DIC(9.4,3,22,21,"PAH",21,1,178,0)="             Enter Yes if this Volume Set has the following properties:"
^DIC(9.4,3,22,21,"PAH",21,1,179,0)="             1. Users can sign-on into the Kernel Menu system or the RPC"
^DIC(9.4,3,22,21,"PAH",21,1,180,0)="             Broker Server routine is running there."
^DIC(9.4,3,22,21,"PAH",21,1,181,0)="             2. Has a productions UCI which contains application routines."
^DIC(9.4,3,22,21,"PAH",21,1,182,0)="             3. The ^XTMP global is translated."
^DIC(9.4,3,22,21,"PAH",21,1,183,0)="             If you enter Yes the Kernel Installation and Distribution"
^DIC(9.4,3,22,21,"PAH",21,1,184,0)="             System will be able to move routines to this Volume Set.  The"
^DIC(9.4,3,22,21,"PAH",21,1,185,0)="             Kernel Menu system will be able to run the Menu Microsurgery"
^DIC(9.4,3,22,21,"PAH",21,1,186,0)="             and keep menus updated."
^DIC(9.4,3,22,21,"PAH",22,0)="14^2961112^1"
^DIC(9.4,3,22,21,"PAH",22,1,0)="^^72^72^2961112"
^DIC(9.4,3,22,21,"PAH",22,1,1,0)="E-Sig Improvements"
^DIC(9.4,3,22,21,"PAH",22,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",22,1,3,0)="New E-SIG functions so that other developers can follow the General"
^DIC(9.4,3,22,21,"PAH",22,1,4,0)="Counsels guidelines on E-SIG. This comes from a meeting at Birmingham on"
^DIC(9.4,3,22,21,"PAH",22,1,5,0)="9/18-20/95.  New routine XUSESIG1."
^DIC(9.4,3,22,21,"PAH",22,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",22,1,7,0)="Changes to the New Person file:"
^DIC(9.4,3,22,21,"PAH",22,1,8,0)=" Added a DEGREE field to hold MD, RN, LPN..."
^DIC(9.4,3,22,21,"PAH",22,1,9,0)=" Added a DATE E-SIG LAST CHANGED field.  The seeding of the this field"
^DIC(9.4,3,22,21,"PAH",22,1,10,0)=" will be done by taking the current date+random(60)+30 days to give a date"
^DIC(9.4,3,22,21,"PAH",22,1,11,0)=" when the user will need to select a new E-SIG code."
^DIC(9.4,3,22,21,"PAH",22,1,12,0)="The option XUSESIG BLOCK is included in this patch."
^DIC(9.4,3,22,21,"PAH",22,1,13,0)="  "
^DIC(9.4,3,22,21,"PAH",22,1,14,0)="KERNEL functions to help developers."
^DIC(9.4,3,22,21,"PAH",22,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",22,1,16,0)="$$CHKSUM^XUSESIG1($name_value,flag)"
^DIC(9.4,3,22,21,"PAH",22,1,17,0)="This would take a root ($name_value) and build a checksum for all data in the"
^DIC(9.4,3,22,21,"PAH",22,1,18,0)="root. (Not used now, flag would be used when there is more that one checksum"
^DIC(9.4,3,22,21,"PAH",22,1,19,0)="algorithm.)"
^DIC(9.4,3,22,21,"PAH",22,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",22,1,21,0)="$$ESBLOCK^XUSESIG1(ien)"
^DIC(9.4,3,22,21,"PAH",22,1,22,0)="This extrinsic function would return the set of fields from the new "
^DIC(9.4,3,22,21,"PAH",22,1,23,0)="person file that are need as part of the hash for a acceptable E-Sig. "
^DIC(9.4,3,22,21,"PAH",22,1,24,0)="If IEN is not passed in then DUZ is used."
^DIC(9.4,3,22,21,"PAH",22,1,25,0)="(E-Sig block, E-Sig title, Degree, Current Date/Time)"
^DIC(9.4,3,22,21,"PAH",22,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",22,1,27,0)="$$EN^XUSESIG1(checksum,esblock)"
^DIC(9.4,3,22,21,"PAH",22,1,28,0)="If the ESBLOCK is not passed then the function would get the ESBLOCK. In "
^DIC(9.4,3,22,21,"PAH",22,1,29,0)="either case this extrinsic function would encode the ESBLOCK using the "
^DIC(9.4,3,22,21,"PAH",22,1,30,0)="checksum as the KEY.  Return a encoded string.  "
^DIC(9.4,3,22,21,"PAH",22,1,31,0)=""
^DIC(9.4,3,22,21,"PAH",22,1,32,0)="$$CMP^XUSESIG1(checksum,$name_value)"
^DIC(9.4,3,22,21,"PAH",22,1,33,0)="The extrinsic function would compare the checksum passed in to the "
^DIC(9.4,3,22,21,"PAH",22,1,34,0)="calculated value from the $NAME_VALUE.  Return 1 for match, 0 for no "
^DIC(9.4,3,22,21,"PAH",22,1,35,0)="match."
^DIC(9.4,3,22,21,"PAH",22,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",22,1,37,0)="$$DE^XUSESIG1(checksum,encoded_string)"
^DIC(9.4,3,22,21,"PAH",22,1,38,0)="This extrinsic function would decode the string using the checksum as "
^DIC(9.4,3,22,21,"PAH",22,1,39,0)="the key.  Return a decoded string."
^DIC(9.4,3,22,21,"PAH",22,1,40,0)=" "
^DIC(9.4,3,22,21,"PAH",22,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",22,1,42,0)="Routine      ChkSum      2nd Line"
^DIC(9.4,3,22,21,"PAH",22,1,43,0)="XUSESIG      5865804   ;;8.0;KERNEL;**14**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",22,1,44,0)="XUSESIG1      864068   ;;8.0;KERNEL;**14**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",22,1,45,0)=""
^DIC(9.4,3,22,21,"PAH",22,1,46,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",22,1,47,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",22,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",22,1,49,0)="  1.  These routines may be mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",22,1,50,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",22,1,51,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",22,1,52,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",22,1,53,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",22,1,54,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",22,1,55,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",22,1,56,0)="      options:"
^DIC(9.4,3,22,21,"PAH",22,1,57,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",22,1,58,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",22,1,59,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",22,1,60,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",22,1,61,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",22,1,62,0)="      user are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",22,1,63,0)="      acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",22,1,64,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",22,1,65,0)="      options:"
^DIC(9.4,3,22,21,"PAH",22,1,66,0)="         Install Package(s)  'XU*8.0*14'"
^DIC(9.4,3,22,21,"PAH",22,1,67,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",22,1,68,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",22,1,69,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",22,1,70,0)=""
^DIC(9.4,3,22,21,"PAH",22,1,71,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",22,1,72,0)=""
^DIC(9.4,3,22,21,"PAH",23,0)="47^2961115^1"
^DIC(9.4,3,22,21,"PAH",23,1,0)="^^52^52^2961115"
^DIC(9.4,3,22,21,"PAH",23,1,1,0)="This patch contains 7 routines, 1 option, and 1 input template.  It"
^DIC(9.4,3,22,21,"PAH",23,1,2,0)="replaces XU*8*4 which has been canceled.  It fixes 3 problems in the Menu"
^DIC(9.4,3,22,21,"PAH",23,1,3,0)="System:"
^DIC(9.4,3,22,21,"PAH",23,1,4,0)="  "
^DIC(9.4,3,22,21,"PAH",23,1,5,0)="1.  Routines XQ72, XQ75, XQ83R, XQCHK, and XQT: If a parent option on the"
^DIC(9.4,3,22,21,"PAH",23,1,6,0)="top of a menu tree was placed out-of-order or locked a user might be able"
^DIC(9.4,3,22,21,"PAH",23,1,7,0)="to jump through it because of the way the compiled menus in ^XUTL were"
^DIC(9.4,3,22,21,"PAH",23,1,8,0)="being built.  [NOIS WBP-0895-22132]"
^DIC(9.4,3,22,21,"PAH",23,1,9,0)="  "
^DIC(9.4,3,22,21,"PAH",23,1,10,0)="2.  Routines XQSMD1 and XQOO: Confusion resulted when a user encountered"
^DIC(9.4,3,22,21,"PAH",23,1,11,0)="an option that contained a hyphen in the option name.  The software could"
^DIC(9.4,3,22,21,"PAH",23,1,12,0)="not easily distinguish between this type of option and two different"
^DIC(9.4,3,22,21,"PAH",23,1,13,0)="options presented with a hyphen between them as a range of options to"
^DIC(9.4,3,22,21,"PAH",23,1,14,0)="select.  The software now looks first to see if a single option meets the"
^DIC(9.4,3,22,21,"PAH",23,1,15,0)="selection criterion, and if so it ignores the possibility of a range of"
^DIC(9.4,3,22,21,"PAH",23,1,16,0)="options."
^DIC(9.4,3,22,21,"PAH",23,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",23,1,18,0)="3.  The option XUEDITOPT and the input template [XUEDITOPT]:  A piece of"
^DIC(9.4,3,22,21,"PAH",23,1,19,0)="code was added to the template in Kernel 8 to start micro surgery to"
^DIC(9.4,3,22,21,"PAH",23,1,20,0)="rebuild the compiled menus after an option was created or changed.  This"
^DIC(9.4,3,22,21,"PAH",23,1,21,0)="resulted in errors because the code called FileMan from within a template."
^DIC(9.4,3,22,21,"PAH",23,1,22,0)="The call was therefore moved to the Exit Action of the option to avoid"
^DIC(9.4,3,22,21,"PAH",23,1,23,0)="that conflict.  [NOIS ERI-1095-21763, FTM-1095-43520]"
^DIC(9.4,3,22,21,"PAH",23,1,24,0)=" "
^DIC(9.4,3,22,21,"PAH",23,1,25,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",23,1,26,0)="INSTALLATION: "
^DIC(9.4,3,22,21,"PAH",23,1,27,0)="  1.  Many of these routines may be mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",23,1,28,0)="      mapping, so you may need to disable mapping."
^DIC(9.4,3,22,21,"PAH",23,1,29,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",23,1,30,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",23,1,31,0)="  3.  Answer NO to the question: "
^DIC(9.4,3,22,21,"PAH",23,1,32,0)="      'Shall I preserve what is on disk in a separate back-up message ?' "
^DIC(9.4,3,22,21,"PAH",23,1,33,0)="  4.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",23,1,34,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,3,22,21,"PAH",23,1,35,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,3,22,21,"PAH",23,1,36,0)="      'Verify Checksum in Transport Global' and verify that all routines "
^DIC(9.4,3,22,21,"PAH",23,1,37,0)="      have the correct checksums.  "
^DIC(9.4,3,22,21,"PAH",23,1,38,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,3,22,21,"PAH",23,1,39,0)="      'Install Package(s)'. Select the package 'XU*8.0*29' and proceed "
^DIC(9.4,3,22,21,"PAH",23,1,40,0)="      with the install.  "
^DIC(9.4,3,22,21,"PAH",23,1,41,0)="  7.  Rebuild your mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",23,1,42,0)="========================================================================"
^DIC(9.4,3,22,21,"PAH",23,1,43,0)=" "
^DIC(9.4,3,22,21,"PAH",23,1,44,0)="ROUTINE                CHECKSUM                PATCHES IN 2ND LINE"
^DIC(9.4,3,22,21,"PAH",23,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",23,1,46,0)="XQ72                   10277570                **29**"
^DIC(9.4,3,22,21,"PAH",23,1,47,0)="XQ75                   14473337                **29**"
^DIC(9.4,3,22,21,"PAH",23,1,48,0)="XQ83R                  15234319                **29**"
^DIC(9.4,3,22,21,"PAH",23,1,49,0)="XQCHK                   7318302                **29**"
^DIC(9.4,3,22,21,"PAH",23,1,50,0)="XQOO                   20509324                **10,21,29**"
^DIC(9.4,3,22,21,"PAH",23,1,51,0)="XQSMD1                 14983624                **29**"
^DIC(9.4,3,22,21,"PAH",23,1,52,0)="XQT                    14370309                **20,29**"
^DIC(9.4,3,22,21,"PAH",24,0)="48^2961129^1"
^DIC(9.4,3,22,21,"PAH",25,0)="50 SEQ #38^2961224^1"
^DIC(9.4,3,22,21,"PAH",25,1,0)="^^28^28^2961224"
^DIC(9.4,3,22,21,"PAH",25,1,1,0)="     This patch contains a routine, and input template, and a change to"
^DIC(9.4,3,22,21,"PAH",25,1,2,0)="the data dictionary of the Option File [^DIC(19)].  It corrects 3 problems"
^DIC(9.4,3,22,21,"PAH",25,1,3,0)="with servers:"
^DIC(9.4,3,22,21,"PAH",25,1,4,0)="  "
^DIC(9.4,3,22,21,"PAH",25,1,5,0)="1.  [CML-0296-N1840 and LIT-0496-71332 ]  Server tasks were retained for"
^DIC(9.4,3,22,21,"PAH",25,1,6,0)="30 days in ^ZTSK, and several sites complained that this was too long and"
^DIC(9.4,3,22,21,"PAH",25,1,7,0)="therefore a waste of disk space.  The default task retention time was"
^DIC(9.4,3,22,21,"PAH",25,1,8,0)="lowered to 14 days, and a field was added to the Option File (ZTSK"
^DIC(9.4,3,22,21,"PAH",25,1,9,0)="RETENTION DAYS) to allow the site to set the retention time for each"
^DIC(9.4,3,22,21,"PAH",25,1,10,0)="server on the system from 1 to 365 days."
^DIC(9.4,3,22,21,"PAH",25,1,11,0)="   "
^DIC(9.4,3,22,21,"PAH",25,1,12,0)="2.  [MCM-1096-51188]  A site complained that the edit template XUEDITOPT"
^DIC(9.4,3,22,21,"PAH",25,1,13,0)="did not allow them to edit the field SERVER DEVICE when working with a"
^DIC(9.4,3,22,21,"PAH",25,1,14,0)="server-type option.  This was corrected when the new field was added to"
^DIC(9.4,3,22,21,"PAH",25,1,15,0)="the template."
^DIC(9.4,3,22,21,"PAH",25,1,16,0)="  "
^DIC(9.4,3,22,21,"PAH",25,1,17,0)="3.  [SLC-1096-50407]  Under certain circumstances, servers that were"
^DIC(9.4,3,22,21,"PAH",25,1,18,0)="designated as ""Run Immediately"" in the SERVER ACTION field were not"
^DIC(9.4,3,22,21,"PAH",25,1,19,0)="running at all but being queued because of a logic error.  This problem"
^DIC(9.4,3,22,21,"PAH",25,1,20,0)="was also noted by IHS."
^DIC(9.4,3,22,21,"PAH",25,1,21,0)="  "
^DIC(9.4,3,22,21,"PAH",25,1,22,0)="============================================================="
^DIC(9.4,3,22,21,"PAH",25,1,23,0)="  "
^DIC(9.4,3,22,21,"PAH",25,1,24,0)="               CHECKSUMS WITH PATCH LIST"
^DIC(9.4,3,22,21,"PAH",25,1,25,0)="  "
^DIC(9.4,3,22,21,"PAH",25,1,26,0)="Program                Before                    After"
^DIC(9.4,3,22,21,"PAH",25,1,27,0)="  "
^DIC(9.4,3,22,21,"PAH",25,1,28,0)=" XQSRV1                8538091                8877273  **50**"
^DIC(9.4,3,22,21,"PAH",26,0)="51 SEQ #40^2961224^1"
^DIC(9.4,3,22,21,"PAH",26,1,0)="^^60^60^2961224"
^DIC(9.4,3,22,21,"PAH",26,1,1,0)=" ** You need to install Kernel Patch XU*8*50 before installing this patch **"
^DIC(9.4,3,22,21,"PAH",26,1,2,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",26,1,3,0)=" -This patch now allows you to transport a Global Package correctly. This bug"
^DIC(9.4,3,22,21,"PAH",26,1,4,0)="  was introduced with patch 44."
^DIC(9.4,3,22,21,"PAH",26,1,5,0)=" -The input transform for the Name field in the Build file has been changed"
^DIC(9.4,3,22,21,"PAH",26,1,6,0)="  to allow sites to create local patches. It now allows 6 digit patch numbers"
^DIC(9.4,3,22,21,"PAH",26,1,7,0)="   i.e.  XU*8.0*662001"
^DIC(9.4,3,22,21,"PAH",26,1,8,0)=" -Kernel 8 patches will now contain the sequence number in the Patch"
^DIC(9.4,3,22,21,"PAH",26,1,9,0)="  Application History multiple of the Package file."
^DIC(9.4,3,22,21,"PAH",26,1,10,0)=" -HL LOGICAL LINK entries were not being cross-referenced."
^DIC(9.4,3,22,21,"PAH",26,1,11,0)=" -The post-install routine XQP50 will update the Patch Application History"
^DIC(9.4,3,22,21,"PAH",26,1,12,0)="  multiple with the information about patch 50. The DATE APPLIED and APPLIED"
^DIC(9.4,3,22,21,"PAH",26,1,13,0)="  BY fields will be the same as this patch. "
^DIC(9.4,3,22,21,"PAH",26,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",26,1,15,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",26,1,16,0)="                    **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",26,1,17,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",26,1,18,0)=""
^DIC(9.4,3,22,21,"PAH",26,1,19,0)=" This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",26,1,20,0)=" should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",26,1,21,0)=" Since this patch is an update to KIDS, no other patches should be installed"
^DIC(9.4,3,22,21,"PAH",26,1,22,0)=" during the installation of this patch."
^DIC(9.4,3,22,21,"PAH",26,1,23,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",26,1,24,0)="  "
^DIC(9.4,3,22,21,"PAH",26,1,25,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",26,1,26,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",26,1,27,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",26,1,28,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",26,1,29,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",26,1,30,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",26,1,31,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",26,1,32,0)="      global."
^DIC(9.4,3,22,21,"PAH",26,1,33,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",26,1,34,0)="      options:"
^DIC(9.4,3,22,21,"PAH",26,1,35,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",26,1,36,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",26,1,37,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",26,1,38,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",26,1,39,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",26,1,40,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",26,1,41,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",26,1,42,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",26,1,43,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",26,1,44,0)="  "
^DIC(9.4,3,22,21,"PAH",26,1,45,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",26,1,46,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",26,1,47,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",26,1,48,0)=""
^DIC(9.4,3,22,21,"PAH",26,1,49,0)="                Before          After "
^DIC(9.4,3,22,21,"PAH",26,1,50,0)=" Name           Checksum        Checksum       Patch List"
^DIC(9.4,3,22,21,"PAH",26,1,51,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",26,1,52,0)=" XPDE           15036235        15041471       2,15,21,44,51"
^DIC(9.4,3,22,21,"PAH",26,1,53,0)=" XPDET           5054183         5054366       15,39,41,44,51"
^DIC(9.4,3,22,21,"PAH",26,1,54,0)=" XPDIA1          7754922         7766653       2,44,51"
^DIC(9.4,3,22,21,"PAH",26,1,55,0)=" XPDIP           9737651         9751058       15,21,28,30,41,44,51"
^DIC(9.4,3,22,21,"PAH",26,1,56,0)=" XPDIU           7734016         7856776       15,41,44,51"
^DIC(9.4,3,22,21,"PAH",26,1,57,0)=" XPDT           19190604        19179554       2,10,28,41,44,51"
^DIC(9.4,3,22,21,"PAH",26,1,58,0)=" XQP50            NEW            4073107       51"
^DIC(9.4,3,22,21,"PAH",26,1,59,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",26,1,60,0)=""
^DIC(9.4,3,22,21,"PAH",27,0)="36 SEQ #41^2961224^1"
^DIC(9.4,3,22,21,"PAH",27,1,0)="^^165^165^2961224"
^DIC(9.4,3,22,21,"PAH",27,1,1,0)="MSG from Warren Wright about large numbers of DEVICE LOCK bulletins"
^DIC(9.4,3,22,21,"PAH",27,1,2,0)="sent when someone leans on keyboard."
^DIC(9.4,3,22,21,"PAH",27,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,4,0)="NOIS MCM-1195-51490 That the DEVICE LOCK bulletins aren't much help."
^DIC(9.4,3,22,21,"PAH",27,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,6,0)="NOIS CLE-1095-43605  The check if a user needed to be deactivated was"
^DIC(9.4,3,22,21,"PAH",27,1,7,0)="counting 'Keep at Terminate' keys even though they would never be removed. "
^DIC(9.4,3,22,21,"PAH",27,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,9,0)="NOIS MAC-0696-61616 WBP-1195-20971 CTX-0896-71639 "
^DIC(9.4,3,22,21,"PAH",27,1,10,0)="The check to close hung SPOOL documents had a incorrect test."
^DIC(9.4,3,22,21,"PAH",27,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,12,0)="NOIS SEP-0796-62056  The purge option was failing to get any site data"
^DIC(9.4,3,22,21,"PAH",27,1,13,0)="from the Kernel System Parameter file. It was looking at the wrong node."
^DIC(9.4,3,22,21,"PAH",27,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,15,0)="NOIS NOL-0796-70230  If the data in the spool file was longer that 255"
^DIC(9.4,3,22,21,"PAH",27,1,16,0)="characters, it would cause an error in %ZIS4 on DSM systems.  This has"
^DIC(9.4,3,22,21,"PAH",27,1,17,0)="been fixed but the report may not print the way it would have if sent"
^DIC(9.4,3,22,21,"PAH",27,1,18,0)="directly to the printer."
^DIC(9.4,3,22,21,"PAH",27,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,20,0)="NOIS WBP-0796-20862 When the number of spool documents is checked, only"
^DIC(9.4,3,22,21,"PAH",27,1,21,0)="those with data are counted. This is changed to count all spool documents "
^DIC(9.4,3,22,21,"PAH",27,1,22,0)="with or without data."
^DIC(9.4,3,22,21,"PAH",27,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,24,0)="E3R  --  Request for a way to have the current date as part of a auto "
^DIC(9.4,3,22,21,"PAH",27,1,25,0)="generated name (GENERATE SPL DOC NAME).  Now if the device name includes"
^DIC(9.4,3,22,21,"PAH",27,1,26,0)="""|DT|"" that string will be replaced with the current date."
^DIC(9.4,3,22,21,"PAH",27,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,28,0)="E3R 8844  To include Person class in the User Inquiry."
^DIC(9.4,3,22,21,"PAH",27,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,30,0)="NOIS IVM-1095-32452 Some times taskman doesn't release devices"
^DIC(9.4,3,22,21,"PAH",27,1,31,0)="when it should."
^DIC(9.4,3,22,21,"PAH",27,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,33,0)="NOIS NOL-0996-70063 At a dual TaskMan site Problem starting tasks on"
^DIC(9.4,3,22,21,"PAH",27,1,34,0)="the working node. The TaskMan part of this patch was developed to address"
^DIC(9.4,3,22,21,"PAH",27,1,35,0)="problems at dual TaskMan sites after the install of patch 24. It is"
^DIC(9.4,3,22,21,"PAH",27,1,36,0)="unclear exactly what the problem was, but with load balancing work would"
^DIC(9.4,3,22,21,"PAH",27,1,37,0)="back up.  There is a new algorithm to start new submanagers and when"
^DIC(9.4,3,22,21,"PAH",27,1,38,0)="submanagers should exit.  We try and keep the number of submanagers  at a"
^DIC(9.4,3,22,21,"PAH",27,1,39,0)="level equal to a: the number of devices in the IO list.  b: the MIN"
^DIC(9.4,3,22,21,"PAH",27,1,40,0)="SUBMANAGER CNT. All submanagers will remain if the JOB list has any tasks"
^DIC(9.4,3,22,21,"PAH",27,1,41,0)="in it."
^DIC(9.4,3,22,21,"PAH",27,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,43,0)="       -----   This patch adds two new fields to the TaskMan site"
^DIC(9.4,3,22,21,"PAH",27,1,44,0)="parameter file (14.7):  (1), MIN SUBMANAGER CNT, allows a site to set a"
^DIC(9.4,3,22,21,"PAH",27,1,45,0)="lower limit on the number of submanagers to keep around.  (2), TM MASTER,"
^DIC(9.4,3,22,21,"PAH",27,1,46,0)="is only used when a volume set is mounted on another but shares the"
^DIC(9.4,3,22,21,"PAH",27,1,47,0)="library account.  This is a pointer back to file 14.7 and would point to"
^DIC(9.4,3,22,21,"PAH",27,1,48,0)="the entry that is the control entry for TaskMan on that node."
^DIC(9.4,3,22,21,"PAH",27,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,50,0)="Local MSG #1082921 "
^DIC(9.4,3,22,21,"PAH",27,1,51,0)="       DIC error in Add a New User.  Problem in the page numbering of the"
^DIC(9.4,3,22,21,"PAH",27,1,52,0)="new FORM for Add a New User and SECONDARY MENUS.  Sending out all three"
^DIC(9.4,3,22,21,"PAH",27,1,53,0)="FORMs with unified page numbering."
^DIC(9.4,3,22,21,"PAH",27,1,54,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,56,0)="NOIS MAD-0895-40177 Some sites have some leftover nodes in the Institution "
^DIC(9.4,3,22,21,"PAH",27,1,57,0)="file."
^DIC(9.4,3,22,21,"PAH",27,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,59,0)="Collect more data in the standard error trap."
^DIC(9.4,3,22,21,"PAH",27,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,61,0)="In patch 24 $X was set to zero before doing the close execute code."
^DIC(9.4,3,22,21,"PAH",27,1,62,0)="This was changed to check if $X>0 and to set it to 1 so that code (like"
^DIC(9.4,3,22,21,"PAH",27,1,63,0)="P-MESSAGE) that test $X would still work. "
^DIC(9.4,3,22,21,"PAH",27,1,64,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,65,0)="If some package was installed after Kernel 8, the ""ID"" nodes on the"
^DIC(9.4,3,22,21,"PAH",27,1,66,0)="NEW PERSON file got changed back to an early version.  Nodes are reset."
^DIC(9.4,3,22,21,"PAH",27,1,67,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,68,0)="NOIS IND-0996-41382 Changes to FTG^%ZISH made in XU*8*24 didn't work for"
^DIC(9.4,3,22,21,"PAH",27,1,69,0)="input like S Y=$$FTG^%ZISH("""",""TEST.DAT"",$NA(OUT(0)),1) it did work"
^DIC(9.4,3,22,21,"PAH",27,1,70,0)="fine on S Y=$$FTG^%ZISH("""",""TEST.DAT"",$NA(^TMP(""XX"",$J,0)),3). Fixed."
^DIC(9.4,3,22,21,"PAH",27,1,71,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,72,0)="Various requests to bring back ZTMGRSET.  This new version will load all"
^DIC(9.4,3,22,21,"PAH",27,1,73,0)="all routines if called from the top, or only the routines with a given"
^DIC(9.4,3,22,21,"PAH",27,1,74,0)="patch number if called at RELOAD^ZTMGRSET."
^DIC(9.4,3,22,21,"PAH",27,1,75,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,76,0)="NOIS BRK-1096-12512, CHW-0996-42161 While testing changes to %ZTER for"
^DIC(9.4,3,22,21,"PAH",27,1,77,0)="use with the new error trap we got ECODE errors under some conditions."
^DIC(9.4,3,22,21,"PAH",27,1,78,0)="This has been fixed with a small change to %ZTER."
^DIC(9.4,3,22,21,"PAH",27,1,79,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,80,0)="Routine      CheckSum    2nd Line"
^DIC(9.4,3,22,21,"PAH",27,1,81,0)="XUINPCH       1467475    ;;8.0;;KERNEL;**20,36**;Feb. 9, 1996"
^DIC(9.4,3,22,21,"PAH",27,1,82,0)="XUSTERM      14380010    ;;8.0;KERNEL;**36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,83,0)="XUSTZ         3010944    ;;8.0;KERNEL;**36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,84,0)="XUTMUSE2     13026855    ;;8.0;KERNEL;**36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,85,0)="ZIS3          6450084    ;;8.0;KERNEL;**18,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,86,0)="ZIS4MSM       6649854    ;;8.0;KERNEL;**23,36**;JUL 03, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,87,0)="ZIS4VXD       8342152    ;;8.0;KERNEL;**23,36**;JUL 03, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,88,0)="ZISC          8463272    ;;8.0;KERNEL;**24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,89,0)="ZISHMSM       5354551    ;;8.0;KERNEL;**24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,90,0)="ZISHVXD       7245146    ;;8.0;KERNEL;**24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,91,0)="ZISPL1        8550686    ;;8.0;KERNEL;**23,36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,92,0)="ZISPL2        4088281    ;;8.0;KERNEL;**23,36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,93,0)="ZISTCP        1828160    ;;8.0;KERNEL;**36**;Jun 02, 1994"
^DIC(9.4,3,22,21,"PAH",27,1,94,0)="ZTER         18736553    ;;8.0;KERNEL;**8,18,32,24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,95,0)="ZTER1         5603505    ;;8.0;KERNEL;**18,24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,96,0)="ZTM           7805017    ;;8.0;KERNEL;**24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,97,0)="ZTM0          5563711    ;;8.0;KERNEL;**42,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,98,0)="ZTM5          3748675    ;;8.0;KERNEL;**24,36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,99,0)="ZTMGRSET     12724965    ;;8.0;KERNEL;**36**;Dec 30, 1993"
^DIC(9.4,3,22,21,"PAH",27,1,100,0)="ZTMON1        7519989    ;;8.0;KERNEL;**36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,101,0)="ZTMS          5200197    ;;8.0;KERNEL;**2,18,24,36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,102,0)="ZTMS1         6210144    ;;8.0;KERNEL;**36**;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,103,0)="ZTMS2         5283853    ;;8.0;KERNEL;**2,18,23,36**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,104,0)="ZTMS3         9454395    ;;8.0;KERNEL;**1,18,36**;Jul 03, 1995"
^DIC(9.4,3,22,21,"PAH",27,1,105,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",27,1,106,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",27,1,107,0)="  "
^DIC(9.4,3,22,21,"PAH",27,1,108,0)="1.  Some of these routines are usually mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",27,1,109,0)="mapping, so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",27,1,110,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,111,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",27,1,112,0)="option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",27,1,113,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,114,0)="3.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,3,22,21,"PAH",27,1,115,0)="You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",27,1,116,0)="On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",27,1,117,0)="options:"
^DIC(9.4,3,22,21,"PAH",27,1,118,0)="          Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",27,1,119,0)="          Print Transport Global"
^DIC(9.4,3,22,21,"PAH",27,1,120,0)="          Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",27,1,121,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",27,1,122,0)="  "
^DIC(9.4,3,22,21,"PAH",27,1,123,0)="4.  Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",27,1,124,0)="Also STOP TASKMAN. As long running jobs exit, they will get CLOBER errors."
^DIC(9.4,3,22,21,"PAH",27,1,125,0)="This isn't a problem because they have finished their work and TaskMan"
^DIC(9.4,3,22,21,"PAH",27,1,126,0)="will start new ones."
^DIC(9.4,3,22,21,"PAH",27,1,127,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,128,0)="   5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",27,1,129,0)="options:"
^DIC(9.4,3,22,21,"PAH",27,1,130,0)="          Install Package(s)  'XU*8.0*36'"
^DIC(9.4,3,22,21,"PAH",27,1,131,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,132,0)="6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to other"
^DIC(9.4,3,22,21,"PAH",27,1,133,0)="CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",27,1,134,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,135,0)="7.  After installing this patch, you need to move several routines from"
^DIC(9.4,3,22,21,"PAH",27,1,136,0)="your production account to the manager account:"
^DIC(9.4,3,22,21,"PAH",27,1,137,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,138,0)="       ZIS4MSM"
^DIC(9.4,3,22,21,"PAH",27,1,139,0)="       ZIS4VXD"
^DIC(9.4,3,22,21,"PAH",27,1,140,0)="       ZISC"
^DIC(9.4,3,22,21,"PAH",27,1,141,0)="       ZISHMSM"
^DIC(9.4,3,22,21,"PAH",27,1,142,0)="       ZISHVXD"
^DIC(9.4,3,22,21,"PAH",27,1,143,0)="       ZISTCP"
^DIC(9.4,3,22,21,"PAH",27,1,144,0)="       ZTER"
^DIC(9.4,3,22,21,"PAH",27,1,145,0)="       ZTER1"
^DIC(9.4,3,22,21,"PAH",27,1,146,0)="       ZTM"
^DIC(9.4,3,22,21,"PAH",27,1,147,0)="       ZTM0"
^DIC(9.4,3,22,21,"PAH",27,1,148,0)="       ZTM5"
^DIC(9.4,3,22,21,"PAH",27,1,149,0)="       ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",27,1,150,0)="       ZTMON1"
^DIC(9.4,3,22,21,"PAH",27,1,151,0)="       ZTMS"
^DIC(9.4,3,22,21,"PAH",27,1,152,0)="       ZTMS1"
^DIC(9.4,3,22,21,"PAH",27,1,153,0)="       ZTMS2"
^DIC(9.4,3,22,21,"PAH",27,1,154,0)="       ZTMS3"
^DIC(9.4,3,22,21,"PAH",27,1,155,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,156,0)="       and in the manager account, rename:"
^DIC(9.4,3,22,21,"PAH",27,1,157,0)="       "
^DIC(9.4,3,22,21,"PAH",27,1,158,0)="       DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",27,1,159,0)="       Select the System"
^DIC(9.4,3,22,21,"PAH",27,1,160,0)="       Patch number to load: 36"
^DIC(9.4,3,22,21,"PAH",27,1,161,0)="        "
^DIC(9.4,3,22,21,"PAH",27,1,162,0)="8.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",27,1,163,0)=" "
^DIC(9.4,3,22,21,"PAH",27,1,164,0)="9.  Start TaskMan, Restart Taskman on other nodes if you need to run more"
^DIC(9.4,3,22,21,"PAH",27,1,165,0)="than one TaskMan."
^DIC(9.4,3,22,21,"PAH",28,0)="56 SEQ #43^2970121^1"
^DIC(9.4,3,22,21,"PAH",28,1,0)="^^8^8^2970121"
^DIC(9.4,3,22,21,"PAH",28,1,1,0)="This patch adds changes and  enhancements to the Unwinder (XQOR*) in support "
^DIC(9.4,3,22,21,"PAH",28,1,2,0)="of the Text Integration Utilities (TIU) package.  These changes include:"
^DIC(9.4,3,22,21,"PAH",28,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",28,1,4,0)="  1)  the ability to programmatically change the menu passed to XQOR"
^DIC(9.4,3,22,21,"PAH",28,1,5,0)="  2)  some modifications to the response time monitoring calls"
^DIC(9.4,3,22,21,"PAH",28,1,6,0)="  3)  the suppression of linefeeds when XQORM is called non-interactively"
^DIC(9.4,3,22,21,"PAH",28,1,7,0)="  4)  the ability to map numeric input to a protocol that should be run"
^DIC(9.4,3,22,21,"PAH",28,1,8,0)="  5)  the storage of HL7 messages in ^TMP to free up partition space"
^DIC(9.4,3,22,21,"PAH",29,0)="55 SEQ #44^2970217^1"
^DIC(9.4,3,22,21,"PAH",29,1,0)="^^99^99^2970217"
^DIC(9.4,3,22,21,"PAH",29,1,1,0)="This is a reissue of Patch XU*8*14 without the code that requires the"
^DIC(9.4,3,22,21,"PAH",29,1,2,0)="users to change their E-SIG every 90 days.   You may install this patch"
^DIC(9.4,3,22,21,"PAH",29,1,3,0)="whether or not you previously installed XU*8*14.  (Sites who installed"
^DIC(9.4,3,22,21,"PAH",29,1,4,0)="XU*8*14 prior to it being marked 'Entered in Error' were advised that they"
^DIC(9.4,3,22,21,"PAH",29,1,5,0)="need not de-install the patch.)"
^DIC(9.4,3,22,21,"PAH",29,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,7,0)="The new E-SIG functions allow developers to follow the General Counsel's"
^DIC(9.4,3,22,21,"PAH",29,1,8,0)="guidelines on E-SIG.  The guidelines are the result of a meeting held in"
^DIC(9.4,3,22,21,"PAH",29,1,9,0)="Birmingham on 9/18-20/95.  A new routine, XUSESIG1, is included in this"
^DIC(9.4,3,22,21,"PAH",29,1,10,0)="patch."
^DIC(9.4,3,22,21,"PAH",29,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,12,0)="Changes to the New Person file:"
^DIC(9.4,3,22,21,"PAH",29,1,13,0)=" Added a DEGREE field to hold MD, RN, LPN..."
^DIC(9.4,3,22,21,"PAH",29,1,14,0)=" Added a DATE E-SIG LAST CHANGED field. This field is just for on-line "
^DIC(9.4,3,22,21,"PAH",29,1,15,0)=" documentation purposes.  Sites may use this field for local reporting "
^DIC(9.4,3,22,21,"PAH",29,1,16,0)=" and management, but the Kernel does NOT perform any action aside "
^DIC(9.4,3,22,21,"PAH",29,1,17,0)=" from updating the field when the E-sig is changed by the user."
^DIC(9.4,3,22,21,"PAH",29,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,19,0)="The option XUSESIG BLOCK is included in this patch."
^DIC(9.4,3,22,21,"PAH",29,1,20,0)="The forms XUEXISTING USER, XUREACT USER, and XUNEW USER are included in"
^DIC(9.4,3,22,21,"PAH",29,1,21,0)="the patch.  The new field DEGREE has been added to the Forms."
^DIC(9.4,3,22,21,"PAH",29,1,22,0)="  "
^DIC(9.4,3,22,21,"PAH",29,1,23,0)="KERNEL functions to help developers."
^DIC(9.4,3,22,21,"PAH",29,1,24,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,25,0)="$$CHKSUM^XUSESIG1($name_value,flag)"
^DIC(9.4,3,22,21,"PAH",29,1,26,0)="This EXTRINSIC FUNCTION will take a root ($name_value) and build a"
^DIC(9.4,3,22,21,"PAH",29,1,27,0)="checksum for all data in the root. (Not used now, flag would be used when"
^DIC(9.4,3,22,21,"PAH",29,1,28,0)="there is more than one checksum algorithm.) "
^DIC(9.4,3,22,21,"PAH",29,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,30,0)="$$ESBLOCK^XUSESIG1(ien)"
^DIC(9.4,3,22,21,"PAH",29,1,31,0)="This extrinsic function will return the set of fields from the new "
^DIC(9.4,3,22,21,"PAH",29,1,32,0)="person file that are needed as part of the hash for an acceptable E-Sig. "
^DIC(9.4,3,22,21,"PAH",29,1,33,0)="If IEN is not passed in, then DUZ is used."
^DIC(9.4,3,22,21,"PAH",29,1,34,0)="(E-Sig block, E-Sig title, Degree, Current Date/Time)"
^DIC(9.4,3,22,21,"PAH",29,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,36,0)="$$EN^XUSESIG1(checksum,esblock)"
^DIC(9.4,3,22,21,"PAH",29,1,37,0)="If the ESBLOCK is not passed then the function would get the ESBLOCK. In "
^DIC(9.4,3,22,21,"PAH",29,1,38,0)="either case this extrinsic function would encode the ESBLOCK using the "
^DIC(9.4,3,22,21,"PAH",29,1,39,0)="checksum as the KEY.  Returns an encoded string.  "
^DIC(9.4,3,22,21,"PAH",29,1,40,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,41,0)="$$CMP^XUSESIG1(checksum,$name_value)"
^DIC(9.4,3,22,21,"PAH",29,1,42,0)="This extrinsic function will compare the checksum passed in to the "
^DIC(9.4,3,22,21,"PAH",29,1,43,0)="calculated value from the $NAME_VALUE.  Return 1 for match, 0 for no "
^DIC(9.4,3,22,21,"PAH",29,1,44,0)="match."
^DIC(9.4,3,22,21,"PAH",29,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,46,0)="$$DE^XUSESIG1(checksum,encoded_string)"
^DIC(9.4,3,22,21,"PAH",29,1,47,0)="This extrinsic function would decode the string using the checksum as "
^DIC(9.4,3,22,21,"PAH",29,1,48,0)="the key.  Return a decoded string."
^DIC(9.4,3,22,21,"PAH",29,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,50,0)=" Routine Summary: "
^DIC(9.4,3,22,21,"PAH",29,1,51,0)=" ================"
^DIC(9.4,3,22,21,"PAH",29,1,52,0)="  "
^DIC(9.4,3,22,21,"PAH",29,1,53,0)=" The following routines are included in this patch.  The second line of"
^DIC(9.4,3,22,21,"PAH",29,1,54,0)=" these routines now look like:"
^DIC(9.4,3,22,21,"PAH",29,1,55,0)="   "
^DIC(9.4,3,22,21,"PAH",29,1,56,0)="      ;;8.0;KERNEL;**[patch list]**;Date"
^DIC(9.4,3,22,21,"PAH",29,1,57,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,59,0)=" CHECK^XTSUMBLD results: "
^DIC(9.4,3,22,21,"PAH",29,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,61,0)="  Routine Name   Before Patch 14   After Patch 14    After Patch  Patch "
^DIC(9.4,3,22,21,"PAH",29,1,62,0)="List"
^DIC(9.4,3,22,21,"PAH",29,1,63,0)="  ------------   ---------------   --------------    -----------  --------"
^DIC(9.4,3,22,21,"PAH",29,1,64,0)="  XUSESIG                5534368          5865804        6027869  **14,55**"
^DIC(9.4,3,22,21,"PAH",29,1,65,0)="  XUSESIG1                   N/A           864068         864068  **14,55**"
^DIC(9.4,3,22,21,"PAH",29,1,66,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,67,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",29,1,68,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",29,1,69,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,70,0)="1.  Some of these routines are usually mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",29,1,71,0)="mapping, so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",29,1,72,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,73,0)="2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",29,1,74,0)="option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",29,1,75,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,76,0)="3.  The patch has now been loaded into a Transport global on your system."
^DIC(9.4,3,22,21,"PAH",29,1,77,0)="You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",29,1,78,0)="On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",29,1,79,0)="options:"
^DIC(9.4,3,22,21,"PAH",29,1,80,0)="          Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",29,1,81,0)="          Print Transport Global"
^DIC(9.4,3,22,21,"PAH",29,1,82,0)="          Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",29,1,83,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",29,1,84,0)="  "
^DIC(9.4,3,22,21,"PAH",29,1,85,0)="4.  Users can remain on the system. This patch can be queued and"
^DIC(9.4,3,22,21,"PAH",29,1,86,0)="installed at any time.  "
^DIC(9.4,3,22,21,"PAH",29,1,87,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,88,0)="5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",29,1,89,0)="options:"
^DIC(9.4,3,22,21,"PAH",29,1,90,0)="          Install Package(s)  'XU*8.0*55'"
^DIC(9.4,3,22,21,"PAH",29,1,91,0)="                               ========="
^DIC(9.4,3,22,21,"PAH",29,1,92,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,93,0)="6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to other"
^DIC(9.4,3,22,21,"PAH",29,1,94,0)="CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",29,1,95,0)=" "
^DIC(9.4,3,22,21,"PAH",29,1,96,0)="7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",29,1,97,0)=""
^DIC(9.4,3,22,21,"PAH",29,1,98,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",29,1,99,0)=""
^DIC(9.4,3,22,21,"PAH",30,0)="57 SEQ #45^2970312^1"
^DIC(9.4,3,22,21,"PAH",30,1,0)="^^46^46^2970312"
^DIC(9.4,3,22,21,"PAH",30,1,1,0)="     This patch contains a single routine, ^XQOO3, that fixes a bug in the"
^DIC(9.4,3,22,21,"PAH",30,1,2,0)="option ""Protocols Marked Out Of Order in Protocol File."" In the event that"
^DIC(9.4,3,22,21,"PAH",30,1,3,0)="there was a single set of protocols marked as Out-Of-Order the software"
^DIC(9.4,3,22,21,"PAH",30,1,4,0)="would fail with an <UNDEF> error."
^DIC(9.4,3,22,21,"PAH",30,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",30,1,6,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",30,1,7,0)="                    **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",30,1,8,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",30,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",30,1,10,0)="     This patch can be installed with users on the system.  There are no"
^DIC(9.4,3,22,21,"PAH",30,1,11,0)="associated or required patches that need to be installed."
^DIC(9.4,3,22,21,"PAH",30,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",30,1,13,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",30,1,14,0)="  "
^DIC(9.4,3,22,21,"PAH",30,1,15,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",30,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",30,1,17,0)="  1.  This routine is not usually mapped on systems that allow mapping."
^DIC(9.4,3,22,21,"PAH",30,1,18,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",30,1,19,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",30,1,20,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",30,1,21,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",30,1,22,0)="      global."
^DIC(9.4,3,22,21,"PAH",30,1,23,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",30,1,24,0)="      options:"
^DIC(9.4,3,22,21,"PAH",30,1,25,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",30,1,26,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",30,1,27,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",30,1,28,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",30,1,29,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",30,1,30,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",30,1,31,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",30,1,32,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",30,1,33,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",30,1,34,0)="  "
^DIC(9.4,3,22,21,"PAH",30,1,35,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",30,1,36,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",30,1,37,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",30,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",30,1,39,0)="                Before          After "
^DIC(9.4,3,22,21,"PAH",30,1,40,0)=" Name           Checksum        Checksum       Patch List"
^DIC(9.4,3,22,21,"PAH",30,1,41,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",30,1,42,0)="XQOO3            8090117         8314463          57      **57**"
^DIC(9.4,3,22,21,"PAH",30,1,43,0)="  "
^DIC(9.4,3,22,21,"PAH",30,1,44,0)="All checksums were calculated using CHECK^XTSUMBLD."
^DIC(9.4,3,22,21,"PAH",30,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",30,1,46,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",31,0)="58 SEQ #46^2970408^1"
^DIC(9.4,3,22,21,"PAH",31,1,0)="^^154^154^2970408"
^DIC(9.4,3,22,21,"PAH",31,1,1,0)=" Prerequisites: none"
^DIC(9.4,3,22,21,"PAH",31,1,2,0)="=========================================================================== "
^DIC(9.4,3,22,21,"PAH",31,1,3,0)=" This patch contains the following features and corrections:"
^DIC(9.4,3,22,21,"PAH",31,1,4,0)=" -An undefined error when installing data and the user said 'NO' to install"
^DIC(9.4,3,22,21,"PAH",31,1,5,0)="  the Data Dictionary.  Since the Data Dictionary is not present, the user"
^DIC(9.4,3,22,21,"PAH",31,1,6,0)="  gets an error."
^DIC(9.4,3,22,21,"PAH",31,1,7,0)=" -Duplicate FileMan templates were not being installed, even if they were"
^DIC(9.4,3,22,21,"PAH",31,1,8,0)="  for two different files."
^DIC(9.4,3,22,21,"PAH",31,1,9,0)=" -The question, 'Want to RUN the Environment Check Routine', will only be"
^DIC(9.4,3,22,21,"PAH",31,1,10,0)="  asked if the Build has an Environment Check Routine."
^DIC(9.4,3,22,21,"PAH",31,1,11,0)=" -FAV-1096-72757  Restarting an Install ignores the variable XPDNOQUE, when"
^DIC(9.4,3,22,21,"PAH",31,1,12,0)="  the variable is set in an Environment Check Routine."
^DIC(9.4,3,22,21,"PAH",31,1,13,0)=" -The Option 'Compare Transport Global to Current System' will now let you"
^DIC(9.4,3,22,21,"PAH",31,1,14,0)="  compare just routines or just the 2nd line of routines."
^DIC(9.4,3,22,21,"PAH",31,1,15,0)=" -An Option or Protocol can now have an 'Action Type' of 'ATTACH TO MENU' or"
^DIC(9.4,3,22,21,"PAH",31,1,16,0)="  'DISABLE DURING INSTALL'."
^DIC(9.4,3,22,21,"PAH",31,1,17,0)=" -The user will now be prompted for the Mail Group Coordinator if an Install"
^DIC(9.4,3,22,21,"PAH",31,1,18,0)="  is sending Mail Group(s)."
^DIC(9.4,3,22,21,"PAH",31,1,19,0)=" -Developers can now send Options and Protocols with the OUT OF ORDER MESSAGE"
^DIC(9.4,3,22,21,"PAH",31,1,20,0)="  field already set. The Options and Protocols will remain out of order after"
^DIC(9.4,3,22,21,"PAH",31,1,21,0)="  the install has completed."
^DIC(9.4,3,22,21,"PAH",31,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,23,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",31,1,24,0)="                    **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",31,1,25,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",31,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,27,0)=" This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",31,1,28,0)=" should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",31,1,29,0)=" Since this patch is an update to KIDS, no other patches should be installed"
^DIC(9.4,3,22,21,"PAH",31,1,30,0)=" during the installation of this patch."
^DIC(9.4,3,22,21,"PAH",31,1,31,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",31,1,32,0)="  "
^DIC(9.4,3,22,21,"PAH",31,1,33,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",31,1,34,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",31,1,35,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",31,1,36,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",31,1,37,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",31,1,38,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",31,1,39,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",31,1,40,0)="      global."
^DIC(9.4,3,22,21,"PAH",31,1,41,0)="  4.  Users can remain on the system. This patch can be queued and installed"
^DIC(9.4,3,22,21,"PAH",31,1,42,0)="      at any time.  TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",31,1,43,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",31,1,44,0)="      options:"
^DIC(9.4,3,22,21,"PAH",31,1,45,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",31,1,46,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",31,1,47,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",31,1,48,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",31,1,49,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",31,1,50,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",31,1,51,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",31,1,52,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",31,1,53,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",31,1,54,0)="  "
^DIC(9.4,3,22,21,"PAH",31,1,55,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",31,1,56,0)="   Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",31,1,57,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",31,1,58,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",31,1,59,0)=""
