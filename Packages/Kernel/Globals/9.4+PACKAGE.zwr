^DIC(9.4,14,22,5.9,"PAH",10,1,103,0)="LR138P                  NA                2851115           138"
^DIC(9.4,14,22,5.9,"PAH",10,1,104,0)="LR138PO                 NA                4890675           138"
^DIC(9.4,14,22,5.9,"PAH",10,1,105,0)="LRCAPPH                 10492287          9623897   1,19,127,136,138"
^DIC(9.4,14,22,5.9,"PAH",10,1,106,0)="LRCAPPH1                3477475           7546206    127,136,138"
^DIC(9.4,14,22,5.9,"PAH",10,1,107,0)="LRCAPPH2                NA                6972273           138"
^DIC(9.4,14,22,5.9,"PAH",10,1,108,0)="LRWU                    11418768         10739890           42,138"
^DIC(9.4,14,22,5.9,"PAH",10,1,109,0)="========================================="
^DIC(9.4,14,22,5.9,"PAH",10,1,110,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",10,1,111,0)="NOTE: SD*5.3*63 patch MUST be installed before this patch WILL install"
^DIC(9.4,14,22,5.9,"PAH",10,1,112,0)="successfully."
^DIC(9.4,14,22,5.9,"PAH",10,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,114,0)="1. All users may remain on the system."
^DIC(9.4,14,22,5.9,"PAH",10,1,115,0)="2. No options need be placed out of order."
^DIC(9.4,14,22,5.9,"PAH",10,1,116,0)="3. Install patch during non-peak hours."
^DIC(9.4,14,22,5.9,"PAH",10,1,117,0)="4. Laboratory specimens should not be accessioned or verified during"
^DIC(9.4,14,22,5.9,"PAH",10,1,118,0)="   installation of the patch."
^DIC(9.4,14,22,5.9,"PAH",10,1,119,0)="5. The Auto-Instruments 'LAB' job does not have to be stopped."
^DIC(9.4,14,22,5.9,"PAH",10,1,120,0)="6. Installation time of this patch is less than ten minutes."
^DIC(9.4,14,22,5.9,"PAH",10,1,121,0)="7. Journaling requires no special attention."
^DIC(9.4,14,22,5.9,"PAH",10,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,123,0)="NOIS List"
^DIC(9.4,14,22,5.9,"PAH",10,1,124,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",10,1,125,0)="Refer to SD*5.3*63 patch"
^DIC(9.4,14,22,5.9,"PAH",10,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,127,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",10,1,128,0)="Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",10,1,129,0)="Developmental Test Site: Long Beach"
^DIC(9.4,14,22,5.9,"PAH",10,1,130,0)="Alpha Test Sites : Reno, Tucson and Oklahoma City"
^DIC(9.4,14,22,5.9,"PAH",10,1,131,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,132,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",10,1,133,0)="Technical Information:"
^DIC(9.4,14,22,5.9,"PAH",10,1,134,0)="Occasion of Service (OOS)"
^DIC(9.4,14,22,5.9,"PAH",10,1,135,0)="All valid LAB OOS LOCATIONS follow this format:"
^DIC(9.4,14,22,5.9,"PAH",10,1,136,0)="Each LAB OOS LOCATION begins with 'LAB DIV'."
^DIC(9.4,14,22,5.9,"PAH",10,1,137,0)="Followed by the STATION NUMBER. (Field #99 of the INSTITUTION (#4) file)"
^DIC(9.4,14,22,5.9,"PAH",10,1,138,0)="Followed by 'OOS ID'."
^DIC(9.4,14,22,5.9,"PAH",10,1,139,0)="Followed by the STOP CODE number."
^DIC(9.4,14,22,5.9,"PAH",10,1,140,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,141,0)="List of selectable OOS Stop Codes:"
^DIC(9.4,14,22,5.9,"PAH",10,1,142,0)="                PULMONARY FUNCTION                104"
^DIC(9.4,14,22,5.9,"PAH",10,1,143,0)="                X-RAY                             105"
^DIC(9.4,14,22,5.9,"PAH",10,1,144,0)="                EEG                               106"
^DIC(9.4,14,22,5.9,"PAH",10,1,145,0)="                EKG                               107"
^DIC(9.4,14,22,5.9,"PAH",10,1,146,0)="                LABORATORY                        108"
^DIC(9.4,14,22,5.9,"PAH",10,1,147,0)="                NUCLEAR MEDICINE                  109"
^DIC(9.4,14,22,5.9,"PAH",10,1,148,0)="                CARDIOVASCULAR NUCLEAR MED        110"
^DIC(9.4,14,22,5.9,"PAH",10,1,149,0)="                ONCOLOGICAL NUCLEAR MED           111"
^DIC(9.4,14,22,5.9,"PAH",10,1,150,0)="                INFECTIOUS DISEASE NUCLEAR MED    112"
^DIC(9.4,14,22,5.9,"PAH",10,1,151,0)="                RADIONUCLIDE TREATMENT            113"
^DIC(9.4,14,22,5.9,"PAH",10,1,152,0)="                SING PHOTON EMISS TOMOGRAPHY      114"
^DIC(9.4,14,22,5.9,"PAH",10,1,153,0)="                ULTRASOUND                        115"
^DIC(9.4,14,22,5.9,"PAH",10,1,154,0)="                HBHC - PHYSICIAN                  170"
^DIC(9.4,14,22,5.9,"PAH",10,1,155,0)="                CLINICAL PHARMACY                 160"
^DIC(9.4,14,22,5.9,"PAH",10,1,156,0)="                BEREAVEMENT COUNSELING            165"
^DIC(9.4,14,22,5.9,"PAH",10,1,157,0)="                VASCULAR LABORATORY               421"
^DIC(9.4,14,22,5.9,"PAH",10,1,158,0)="                EMPLOYEE HEALTH                   999"
^DIC(9.4,14,22,5.9,"PAH",10,1,159,0)="                EVOKED POTENTIAL                  126"
^DIC(9.4,14,22,5.9,"PAH",10,1,160,0)="                TOPOGRAPHICAL BRAIN MONITORING    127"
^DIC(9.4,14,22,5.9,"PAH",10,1,161,0)="                PROLONGED VIDEO-EEG MONITORING    128"
^DIC(9.4,14,22,5.9,"PAH",10,1,162,0)="                MAMMOGRAM                         703"
^DIC(9.4,14,22,5.9,"PAH",10,1,163,0)="                RADIONUCLIDE THERAPY              144"
^DIC(9.4,14,22,5.9,"PAH",10,1,164,0)="                PHARM/PHYSIO NMP STUDIES          145"
^DIC(9.4,14,22,5.9,"PAH",10,1,165,0)="                PET                               146"
^DIC(9.4,14,22,5.9,"PAH",10,1,166,0)="    "
^DIC(9.4,14,22,5.9,"PAH",10,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,168,0)="No LAB OOS LOCATIONS can have appointments."
^DIC(9.4,14,22,5.9,"PAH",10,1,169,0)="No patients can be scheduled to LAB OOS LOCATIONS."
^DIC(9.4,14,22,5.9,"PAH",10,1,170,0)="LAB OOS LOCATIONS can not be selected as the ordering locations."
^DIC(9.4,14,22,5.9,"PAH",10,1,171,0)="All locations are created by the Scheduling API."
^DIC(9.4,14,22,5.9,"PAH",10,1,172,0)="Name Length is less than 31 characters."
^DIC(9.4,14,22,5.9,"PAH",10,1,173,0)="LAB OOS LOCATION can not be deleted with FileMan."
^DIC(9.4,14,22,5.9,"PAH",10,1,174,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,175,0)="Example LAB OOS LOCATION name = LAB DIV 647 OOS ID 108"
^DIC(9.4,14,22,5.9,"PAH",10,1,176,0)="Where 647 = Poplar Bluff, MO"
^DIC(9.4,14,22,5.9,"PAH",10,1,177,0)="Where 108 = Laboratory Stop Code"
^DIC(9.4,14,22,5.9,"PAH",10,1,178,0)="==========================================="
^DIC(9.4,14,22,5.9,"PAH",10,1,179,0)="This patch contains two (2) new options which will be added to the LIM"
^DIC(9.4,14,22,5.9,"PAH",10,1,180,0)="workload menu [LR LIM/WKLD MENU]."
^DIC(9.4,14,22,5.9,"PAH",10,1,181,0)="1) Create Laboratory OOS Locations [LR WKLD LOCATION] provides a software"
^DIC(9.4,14,22,5.9,"PAH",10,1,182,0)="controlled creation of LAB OOS HOSPITAL LOCATIONS."
^DIC(9.4,14,22,5.9,"PAH",10,1,183,0)="2) Edit ACC Area OOS Location [LR WKLD ACC AREA LOCATION] allows the LIM"
^DIC(9.4,14,22,5.9,"PAH",10,1,184,0)="to modify individual accession areas LAB OOS LOCATIONS to adjust NPCDB"
^DIC(9.4,14,22,5.9,"PAH",10,1,185,0)="workload credit."
^DIC(9.4,14,22,5.9,"PAH",10,1,186,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,187,0)="============================="
^DIC(9.4,14,22,5.9,"PAH",10,1,188,0)="Fields included in LR*5.2*138"
^DIC(9.4,14,22,5.9,"PAH",10,1,189,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,190,0)="WKLD CODE (#64) File"
^DIC(9.4,14,22,5.9,"PAH",10,1,191,0)="   DSS Feeder Key (#14) field"
^DIC(9.4,14,22,5.9,"PAH",10,1,192,0)="ACCESSION (#68) File"
^DIC(9.4,14,22,5.9,"PAH",10,1,193,0)="   LAB OOS LOCATION (#.8) field"
^DIC(9.4,14,22,5.9,"PAH",10,1,194,0)="LAB ORDER ENTRY (#69) File"
^DIC(9.4,14,22,5.9,"PAH",10,1,195,0)="   TEST (#69.03) subfile"
^DIC(9.4,14,22,5.9,"PAH",10,1,196,0)="     PCE VISIT # (#12) field"
^DIC(9.4,14,22,5.9,"PAH",10,1,197,0)="LABORATORY SITE (#69.9) File"
^DIC(9.4,14,22,5.9,"PAH",10,1,198,0)="   DEFAULT LAB OOS LOCATION (#.8) field"
^DIC(9.4,14,22,5.9,"PAH",10,1,199,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,200,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,201,0)="Field Notes:"
^DIC(9.4,14,22,5.9,"PAH",10,1,202,0)="A new field DEFAULT LAB OOS LOCATION (#.8) has been added to the"
^DIC(9.4,14,22,5.9,"PAH",10,1,203,0)="LABORATORY SITE file (#69.9). It is used when ACCESSION AREAS does not"
^DIC(9.4,14,22,5.9,"PAH",10,1,204,0)="have a LAB OOS LOCATION defined."
^DIC(9.4,14,22,5.9,"PAH",10,1,205,0)="A new field LAB OOS LOCATION (#.8) has been added to the ACCESSION (#68)"
^DIC(9.4,14,22,5.9,"PAH",10,1,206,0)="file. This field is used to adjust NPCDB workload reporting."
^DIC(9.4,14,22,5.9,"PAH",10,1,207,0)="* An existing field is renamed, DSS Feeder Key (#14) in the WKLD CODE"
^DIC(9.4,14,22,5.9,"PAH",10,1,208,0)="(#64) file. This field was altered by an earlier patch."
^DIC(9.4,14,22,5.9,"PAH",10,1,209,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,210,0)="Routine Notes:"
^DIC(9.4,14,22,5.9,"PAH",10,1,211,0)="This patch contains three (3) modified routines LRCAPPH, LRCAPPH1, LRWU"
^DIC(9.4,14,22,5.9,"PAH",10,1,212,0)="and one (1) new routine LRCAPPH2. These routines control the reporting of"
^DIC(9.4,14,22,5.9,"PAH",10,1,213,0)="NPCDB workload data and the screening of hospital OOS locations."
^DIC(9.4,14,22,5.9,"PAH",10,1,214,0)="  There are several additional non laboratory routines that will control"
^DIC(9.4,14,22,5.9,"PAH",10,1,215,0)="the user's HOSPITAL LOCATION selections."
^DIC(9.4,14,22,5.9,"PAH",10,1,216,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,217,0)="=============================="
