^DIC(9.4,4,22,1,"PAH",131,1,21,0)="XMYPRE9        * NEW *           84031        164"
^DIC(9.4,4,22,1,"PAH",131,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
