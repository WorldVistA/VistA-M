^DIC(9.4,3,22,21,"PAH",486,0)="631 SEQ #511^3140902.125456^17"
^DIC(9.4,3,22,21,"PAH",486,1,0)="^^3^3^3140902"
^DIC(9.4,3,22,21,"PAH",486,1,1,0)=" "
^DIC(9.4,3,22,21,"PAH",486,1,2,0)="This patch fixes code in XQARPRT1 to point to the new Alert Critical Text"
^DIC(9.4,3,22,21,"PAH",486,1,3,0)="File 8992.3 to search for  critical text to flag an alert as critical."
^DIC(9.4,3,22,21,"PAH",487,0)="650 SEQ #513^3141104.10422^17"
^DIC(9.4,3,22,21,"PAH",487,1,0)="^^2^2^3141104"
^DIC(9.4,3,22,21,"PAH",487,1,1,0)="See patch XU*8*650 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",487,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",488,0)="625 SEQ #514^3141215.121631^17"
^DIC(9.4,3,22,21,"PAH",488,1,0)="^^2^2^3141215"
^DIC(9.4,3,22,21,"PAH",488,1,1,0)="See patch XU*8*625 in the National Patch Module for complete "
^DIC(9.4,3,22,21,"PAH",488,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",489,0)="638 SEQ #516^3150224.160707^17"
^DIC(9.4,3,22,21,"PAH",489,1,0)="^^19^19^3150224"
^DIC(9.4,3,22,21,"PAH",489,1,1,0)="This patch is one in a series of patches to support the VA's transition "
^DIC(9.4,3,22,21,"PAH",489,1,2,0)="from IPv4 to IPv6.  IPv6 is a protocol designed to handle the growth rate "
^DIC(9.4,3,22,21,"PAH",489,1,3,0)="of the Internet and to cope with the demanding requirements of services,"
^DIC(9.4,3,22,21,"PAH",489,1,4,0)="mobility, and end-to-end security.  A Federal Chief Information Office "
^DIC(9.4,3,22,21,"PAH",489,1,5,0)="(CIO) memo ""Transition to IPv6"" released in September of 2010 requires"
^DIC(9.4,3,22,21,"PAH",489,1,6,0)="agencies to continue their IPv6 transition efforts and has established"
^DIC(9.4,3,22,21,"PAH",489,1,7,0)="specific milestones associated with enabling an IPv6 operational"
^DIC(9.4,3,22,21,"PAH",489,1,8,0)="capability by the end of FY2014."
^DIC(9.4,3,22,21,"PAH",489,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",489,1,10,0)="This patch updates several places where IPv4 address formats were "
^DIC(9.4,3,22,21,"PAH",489,1,11,0)="hard-coded in routines, and have now been replaced with calls to "
^DIC(9.4,3,22,21,"PAH",489,1,12,0)="IPv4/IPv6 Application Programmer Interfaces (APIs) to support the VA's "
^DIC(9.4,3,22,21,"PAH",489,1,13,0)="transition to IPv6. Several changes have also been made in algorithms "
^DIC(9.4,3,22,21,"PAH",489,1,14,0)="that will improve the efficiency of IP address handling."
^DIC(9.4,3,22,21,"PAH",489,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",489,1,16,0)="No current functionality has been changed.  IPv6 functionality for future "
^DIC(9.4,3,22,21,"PAH",489,1,17,0)="support cannot be completely tested until additional changes are made in "
^DIC(9.4,3,22,21,"PAH",489,1,18,0)="VistA, and a test environment is established to replicate the planned VA "
^DIC(9.4,3,22,21,"PAH",489,1,19,0)="network architecture."
^DIC(9.4,3,22,21,"PAH",490,0)="654 SEQ #517^3150916.110927^17"
^DIC(9.4,3,22,21,"PAH",490,1,0)="^^2^2^3150916"
^DIC(9.4,3,22,21,"PAH",490,1,1,0)="Kernel patch XU*8*654. This patch supports MFS. Please refer to the"
^DIC(9.4,3,22,21,"PAH",490,1,2,0)="description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",491,0)="655 SEQ #518^3150916.142118^17"
^DIC(9.4,3,22,21,"PAH",491,1,0)="^^27^27^3150916"
^DIC(9.4,3,22,21,"PAH",491,1,1,0)="Please see description of patch on FORUM."
^DIC(9.4,3,22,21,"PAH",491,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,3,0)="This patch provides utilities to Identify and Authenticate VistA users"
^DIC(9.4,3,22,21,"PAH",491,1,4,0)="from sources external to VistA."
^DIC(9.4,3,22,21,"PAH",491,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,6,0)="Identity and Access Management (IAM)"
^DIC(9.4,3,22,21,"PAH",491,1,7,0)="- Provide a centralized authentication service for single sign-on to "
^DIC(9.4,3,22,21,"PAH",491,1,8,0)="  multiple VA applications, including VistA and applications that access "
^DIC(9.4,3,22,21,"PAH",491,1,9,0)="  VistA."
^DIC(9.4,3,22,21,"PAH",491,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,11,0)="VistA Service Assembler (VSA) "
^DIC(9.4,3,22,21,"PAH",491,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,13,0)="VistA Integration Adapter (VIA)"
^DIC(9.4,3,22,21,"PAH",491,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,15,0)="VistA Access Enhancements (VAE)"
^DIC(9.4,3,22,21,"PAH",491,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,17,0)="Electronic Health Management Platform (eHMP)"
^DIC(9.4,3,22,21,"PAH",491,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,19,0)="VistA.js/EWD.js"
^DIC(9.4,3,22,21,"PAH",491,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,21,0)="RPC Broker"
^DIC(9.4,3,22,21,"PAH",491,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",491,1,23,0)="Veterans Access, Choice, and Accountability Act of 2014 (VACAA)"
^DIC(9.4,3,22,21,"PAH",491,1,24,0)="- Public Law 9P. L.) 113-146, VACAA, which was enacted on August 7, 2014"
^DIC(9.4,3,22,21,"PAH",491,1,25,0)="  and amended through the Department of Veterans Affairs Expiring"
^DIC(9.4,3,22,21,"PAH",491,1,26,0)="  Authorities Act of 2014 (P.L. 113-175), improves the access of eligible"
^DIC(9.4,3,22,21,"PAH",491,1,27,0)="  Veterans to health care through non-VA entities and providers."
^DIC(9.4,3,22,21,"PAH",492,0)="642^3160310.15543^54"
^DIC(9.4,3,22,21,"PAH",492,1,0)="^^16^16^3160310"
^DIC(9.4,3,22,21,"PAH",492,1,1,0)="This patch is in support of the Drug Enforcement Agency (DEA) "
^DIC(9.4,3,22,21,"PAH",492,1,2,0)="e-Prescribing of Controlled Substances (CS) (ePCS) using Public Key "
^DIC(9.4,3,22,21,"PAH",492,1,3,0)="Infrastructure (PKI).  The following modifications to the VistA Kernel "
^DIC(9.4,3,22,21,"PAH",492,1,4,0)="have been made to meet current ePCS requirements."
^DIC(9.4,3,22,21,"PAH",492,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",492,1,6,0)="Routine ^XUSC1C was modified to prevent an infinite loop when a read "
^DIC(9.4,3,22,21,"PAH",492,1,7,0)="failed at the start of a ""conversation"". Routine ^XUSC1C was also modified"
^DIC(9.4,3,22,21,"PAH",492,1,8,0)="to replace hard-coded string comparison of IP addresses with supported"
^DIC(9.4,3,22,21,"PAH",492,1,9,0)="Kernel API calls (ICR 5844)."
^DIC(9.4,3,22,21,"PAH",492,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",492,1,11,0)="Application Programmer Interface (API) $$VDEA^XUSER was modified to "
^DIC(9.4,3,22,21,"PAH",492,1,12,0)="return those users with no valid DEA number (none on file, or expired "
^DIC(9.4,3,22,21,"PAH",492,1,13,0)="expiration date) and a valid VA number as valid DEA prescribers. The API "
^DIC(9.4,3,22,21,"PAH",492,1,14,0)="was also changed to highlight those users who are grandfathered, in case "
^DIC(9.4,3,22,21,"PAH",492,1,15,0)="grandfathering is no longer allowed at some point in the future."
^DIC(9.4,3,22,21,"PAH",492,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",493,0)="659 SEQ #522^3160815.124233^54"
^DIC(9.4,3,22,21,"PAH",493,1,0)="^^8^8^3160815"
^DIC(9.4,3,22,21,"PAH",493,1,1,0)="This patch provides enhancements needed to implement Single Sign-On "
^DIC(9.4,3,22,21,"PAH",493,1,2,0)="Internal (SSOi) for identification and authentication of users into VistA."
^DIC(9.4,3,22,21,"PAH",493,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",493,1,4,0)="The use of these utilities are expected to improve security and auditing"
^DIC(9.4,3,22,21,"PAH",493,1,5,0)="capabilities in accordance with VA Handbook 6500 Appendix F and revision 4"
^DIC(9.4,3,22,21,"PAH",493,1,6,0)="of NIST SP 800-53. As required by FIPS 199 and using guidance from NIST SP"
^DIC(9.4,3,22,21,"PAH",493,1,7,0)="800-60, the recommended security categorization for these applications is"
^DIC(9.4,3,22,21,"PAH",493,1,8,0)="HIGH."
^DIC(9.4,3,22,21,"PAH",494,0)="568^3160829.131103^54"
^DIC(9.4,3,22,21,"PAH",494,1,0)="^^1^1^3160829"
^DIC(9.4,3,22,21,"PAH",494,1,1,0)="Enable SAGG to run on Linux, VMS and Windows operating systems."
^DIC(9.4,3,22,21,"PAH",495,0)="674 SEQ #524^3161006.124502^54"
^DIC(9.4,3,22,21,"PAH",495,1,0)="^^8^8^3161006"
^DIC(9.4,3,22,21,"PAH",495,1,1,0)="This patch fixes a problem where Cache job numbers ($J) are reused during "
^DIC(9.4,3,22,21,"PAH",495,1,2,0)="periods of high-volume client-server connections (many connections within "
^DIC(9.4,3,22,21,"PAH",495,1,3,0)="a day). Data in the ^TMP(""XQCS"",$J) global is not deleted when a "
^DIC(9.4,3,22,21,"PAH",495,1,4,0)="connection is reset, and will persist into a new user session, often "
^DIC(9.4,3,22,21,"PAH",495,1,5,0)="causing RPC Broker connection errors."
^DIC(9.4,3,22,21,"PAH",495,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",495,1,7,0)="This patch kills the ^TMP(""XQCS"",$J) global for a new session when DUZ is "
^DIC(9.4,3,22,21,"PAH",495,1,8,0)="undefined or equal to zero."
^DIC(9.4,3,22,21,"PAH",496,0)="664 SEQ #525^3161028.151642^54"
^DIC(9.4,3,22,21,"PAH",496,1,0)="^^2^2^3161028"
^DIC(9.4,3,22,21,"PAH",496,1,1,0)="Kernel patch XU*8*664. This patch supports MFS. Please refer to the"
^DIC(9.4,3,22,21,"PAH",496,1,2,0)="description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",497,0)="665 SEQ #526^3170303.131641^54"
