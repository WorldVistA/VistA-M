^DIC(9.4,100,22,15,"PAH",39,1,82,0)="    *** PLEASE NOTE THAT ROUTINE YSGAFOBX BEFORE PATCH CHECKSUM ***"
^DIC(9.4,100,22,15,"PAH",39,1,83,0)="    *** IS DIFFERENT FROM THE AFTER PATCH CHECKSUM IN THE       ***"
