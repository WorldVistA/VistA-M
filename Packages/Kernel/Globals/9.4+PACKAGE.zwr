^DIC(9.4,4,22,1,"PAH",39,0)="68 SEQ #63^2990121^1"
^DIC(9.4,4,22,1,"PAH",39,1,0)="^^40^40^2990121"
^DIC(9.4,4,22,1,"PAH",39,1,1,0)="MailMan patch XM*7.1*68 fixes a bug as described in NOIS TAM-1098-30390."
^DIC(9.4,4,22,1,"PAH",39,1,2,0)="Test site is Tampa, FL."
^DIC(9.4,4,22,1,"PAH",39,1,3,0)=""
^DIC(9.4,4,22,1,"PAH",39,1,4,0)="If a remote address begins with ""F."", MailMan thinks the address is a fax."
^DIC(9.4,4,22,1,"PAH",39,1,5,0)="This patch ensures that MailMan does not confuse a fax address with a remote"
^DIC(9.4,4,22,1,"PAH",39,1,6,0)="address."
^DIC(9.4,4,22,1,"PAH",39,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",39,1,8,0)="Note: This patch should be installed after-hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",39,1,9,0)="minimum."
^DIC(9.4,4,22,1,"PAH",39,1,10,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",39,1,11,0)="  "
^DIC(9.4,4,22,1,"PAH",39,1,12,0)="ROUTINES:"
