^DIC(9.4,229,0)="MAILMAN DOMAIN UPDATES^XMDB^RESERVED FOR MAILMAN DOMAIN PATCHES"
^DIC(9.4,229,20,0)="^9.402P^^"
^DIC(9.4,229,22,0)="^9.49I^1^1"
^DIC(9.4,229,22,1,0)="1.0"
^DIC(9.4,229,22,1,"PAH",0)="^9.4901^4^4"
^DIC(9.4,229,22,1,"PAH",1,0)="0^3170403.135328^54"
^DIC(9.4,229,22,1,"PAH",1,1,0)="^^2^2^3170403"
^DIC(9.4,229,22,1,"PAH",1,1,1,0)="Six new national domain entries need to be added in the DOMAIN (#4.2) "
^DIC(9.4,229,22,1,"PAH",1,1,2,0)="file."
^DIC(9.4,229,22,1,"PAH",2,0)="2 SEQ #1^3200721.122018^65"
^DIC(9.4,229,22,1,"PAH",2,1,0)="^^6^6^3200721"
^DIC(9.4,229,22,1,"PAH",2,1,1,0)="This patch will fix a reported issue in FORUM where it is receiving "
^DIC(9.4,229,22,1,"PAH",2,1,2,0)="thousands of mail messages from every site. The issue is being caused by "
^DIC(9.4,229,22,1,"PAH",2,1,3,0)="the 'GOV' domain in file DOMAIN (#4.2) which has a field RELAY DOMAIN "
^DIC(9.4,229,22,1,"PAH",2,1,4,0)="(#2) in the DOMAIN (#4.2) file of 'DOMAIN.EXT', and the field SYNONYM "
^DIC(9.4,229,22,1,"PAH",2,1,5,0)="(#.01) in sub-file SYNONYM (#5) in file DOMAIN (#4.2) of the domain "
^DIC(9.4,229,22,1,"PAH",2,1,6,0)="'DOMAIN.EXT' when the field is 'GOV'."
^DIC(9.4,229,22,1,"PAH",3,0)="3 SEQ #2^3220413.163137^86"
^DIC(9.4,229,22,1,"PAH",3,1,0)="^^2^2^3220413"
^DIC(9.4,229,22,1,"PAH",3,1,1,0)="Two new national domain entries need to be added in the DOMAIN (#4.2) "
^DIC(9.4,229,22,1,"PAH",3,1,2,0)="file."
^DIC(9.4,229,22,1,"PAH",4,0)="4 SEQ #3^3260114.122007^90"
^DIC(9.4,229,22,1,"PAH",4,1,0)="^^1^1^3260114"
^DIC(9.4,229,22,1,"PAH",4,1,1,0)="Please refer to the National Patch Module for more information."
^DIC(9.4,229,22,1,"PAH","B",0,1)=""
