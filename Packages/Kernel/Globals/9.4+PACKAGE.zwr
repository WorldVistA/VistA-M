^DIC(9.4,199,22,1,"PAH",1,1,445,0)="BUILD COMPONENTS"
^DIC(9.4,199,22,1,"PAH",1,1,446,0)="================="
^DIC(9.4,199,22,1,"PAH",1,1,447,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,448,0)="ENVIRONMENT CHECK :  VDEFKIDS            DELETE ENV ROUTINE: No"
^DIC(9.4,199,22,1,"PAH",1,1,449,0)=" PRE-INIT ROUTINE :                      DELETE PRE-INIT ROUTINE: No"
^DIC(9.4,199,22,1,"PAH",1,1,450,0)=" POST-INIT ROUTINE : POSTIN^VDEFKIDS     DELETE POST-INIT ROUTINE: No"
^DIC(9.4,199,22,1,"PAH",1,1,451,0)=" PRE-TRANSPORT RTN : "
^DIC(9.4,199,22,1,"PAH",1,1,452,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,453,0)="ROUTINE:"
^DIC(9.4,199,22,1,"PAH",1,1,454,0)=" VDEFCONT                                SEND TO SITE"
^DIC(9.4,199,22,1,"PAH",1,1,455,0)=" VDEFMNU                                 SEND TO SITE"
^DIC(9.4,199,22,1,"PAH",1,1,456,0)=" VDEFMON                                 SEND TO SITE"
^DIC(9.4,199,22,1,"PAH",1,1,457,0)=" VDEFQM                                  SEND TO SITE"
^DIC(9.4,199,22,1,"PAH",1,1,458,0)=" VDEFREQ                                 SEND TO SITE"
^DIC(9.4,199,22,1,"PAH",1,1,459,0)=" VDEFUTIL                                SEND TO SITE"
^DIC(9.4,199,22,1,"PAH",1,1,460,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,461,0)="REQUIRED BUILDS:                         ACTION:"
^DIC(9.4,199,22,1,"PAH",1,1,462,0)=" VDEF 1.0                                Don't install, remove global"
^DIC(9.4,199,22,1,"PAH",1,1,463,0)=" XU*8.0*339                              Don't install, remove global"
^DIC(9.4,199,22,1,"PAH",1,1,464,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,465,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,466,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,467,0)="POST INSTALLATION CHECKS:"
^DIC(9.4,199,22,1,"PAH",1,1,468,0)="1) Verify that the three VDEF tasks shown in the example exist after"
^DIC(9.4,199,22,1,"PAH",1,1,469,0)="   the install is complete.  The EN^VDEFREQ and MONITOR^VDEFMON tasks"
^DIC(9.4,199,22,1,"PAH",1,1,470,0)="   should be active while the MONITOR^VDEFCONT task may be scheduled"
^DIC(9.4,199,22,1,"PAH",1,1,471,0)="   or active."
^DIC(9.4,199,22,1,"PAH",1,1,472,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,473,0)="   (example task list)"
^DIC(9.4,199,22,1,"PAH",1,1,474,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,475,0)="   Task list  Dec 22, 2005 11:26 am                             Page 1"
^DIC(9.4,199,22,1,"PAH",1,1,476,0)="----------------------------------------------------------------------"
^DIC(9.4,199,22,1,"PAH",1,1,477,0)="7399750: EN^VDEFREQ, VDEF Request Processor for MAINTENANCE.  No device."
^DIC(9.4,199,22,1,"PAH",1,1,478,0)="         DAYT12.  From Today at 11:26,  By you.  Started running Today"
^DIC(9.4,199,22,1,"PAH",1,1,479,0)="         at 11:26. Job #: 560347970 [21663B42]"
^DIC(9.4,199,22,1,"PAH",1,1,480,0)="----------------------------------------------------------------------"
^DIC(9.4,199,22,1,"PAH",1,1,481,0)="7399751: MONITOR^VDEFCONT, VDEF Checked Out Monitor.  No device. "
^DIC(9.4,199,22,1,"PAH",1,1,482,0)="         DAYT12,ROU. From Today at 11:26,  By you. Scheduled for Today"
^DIC(9.4,199,22,1,"PAH",1,1,483,0)="         at 11:27"
^DIC(9.4,199,22,1,"PAH",1,1,484,0)="----------------------------------------------------------------------"
^DIC(9.4,199,22,1,"PAH",1,1,485,0)="7399752: MONITOR^VDEFMON, VDEF Request Processor Monitor.  No device."
^DIC(9.4,199,22,1,"PAH",1,1,486,0)="         DAYT12,ROU.  From Today at 11:26,  By you."
^DIC(9.4,199,22,1,"PAH",1,1,487,0)="         Started running Today at 11:26.  Job #: 560552879 [21695BAF]"
^DIC(9.4,199,22,1,"PAH",1,1,488,0)="----------------------------------------------------------------------"
^DIC(9.4,199,22,1,"PAH",1,1,489,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,490,0)="2) Run the Status of VDEF components [VDEF Status] display and verify the"
^DIC(9.4,199,22,1,"PAH",1,1,491,0)="   following:"
^DIC(9.4,199,22,1,"PAH",1,1,492,0)="   - Requestor status is Activated"
^DIC(9.4,199,22,1,"PAH",1,1,493,0)="   - Request Processor Status is ""Running"""
^DIC(9.4,199,22,1,"PAH",1,1,494,0)="   - Task status is ""Active-Running"""
^DIC(9.4,199,22,1,"PAH",1,1,495,0)="   - the Current Task # matches the task # for the EN^VDEFREQ task."
^DIC(9.4,199,22,1,"PAH",1,1,496,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,497,0)=" (example of the Status of VDEF components [VDEF Status] display)"
^DIC(9.4,199,22,1,"PAH",1,1,498,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,499,0)="                      VDEF Status - Dec 22, 2005@11:50:14"
^DIC(9.4,199,22,1,"PAH",1,1,500,0)="Logical Link Status"
^DIC(9.4,199,22,1,"PAH",1,1,501,0)="  VDEFVIE1: stopped or caught up"
^DIC(9.4,199,22,1,"PAH",1,1,502,0)="  VDEFVIE2: stopped or caught up"
^DIC(9.4,199,22,1,"PAH",1,1,503,0)="  VDEFVIE3: stopped or caught up"
^DIC(9.4,199,22,1,"PAH",1,1,504,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,505,0)="Requestor Status"
^DIC(9.4,199,22,1,"PAH",1,1,506,0)="  MAINTENANCE: Activated        Dest.: VISTA HL7    Req. Queue: "
^DIC(9.4,199,22,1,"PAH",1,1,507,0)="MAINTENANCE"
^DIC(9.4,199,22,1,"PAH",1,1,508,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,509,0)="Request Processor Status"
^DIC(9.4,199,22,1,"PAH",1,1,510,0)="  MAINTENANCE: Running"
^DIC(9.4,199,22,1,"PAH",1,1,511,0)="  Current Task # [Proc]: 7410052 [21A53BA8]  Task status: Active-"
^DIC(9.4,199,22,1,"PAH",1,1,512,0)="  Running"
^DIC(9.4,199,22,1,"PAH",1,1,513,0)="  Requests waiting for purge: 0      Last request#: "
^DIC(9.4,199,22,1,"PAH",1,1,514,0)="  Checked Out(0)  Queued Up(0)  Errored Out(0)"
^DIC(9.4,199,22,1,"PAH",1,1,515,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,516,0)="IMPORTANT NOTES ON THE Status of VDEF components [VDEF Status] DISPLAY"
^DIC(9.4,199,22,1,"PAH",1,1,517,0)="=========================================="
^DIC(9.4,199,22,1,"PAH",1,1,518,0)="The ""Request Processor Status"" is simply the status flag of the process in"
^DIC(9.4,199,22,1,"PAH",1,1,519,0)="a VDEF global. It is possible to have the status ""Running"" even if the VMS"
^DIC(9.4,199,22,1,"PAH",1,1,520,0)="process of the task had died."
^DIC(9.4,199,22,1,"PAH",1,1,521,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,522,0)="IF THE REQUEST QUEUE PROCESSOR TASK (EN^VDEFREQ) IS RUNNING:"
^DIC(9.4,199,22,1,"PAH",1,1,523,0)="The Request Processor Status will show ""Running"" and the task status will "
^DIC(9.4,199,22,1,"PAH",1,1,524,0)="show ""Active-Running""."
^DIC(9.4,199,22,1,"PAH",1,1,525,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,526,0)="IF THE REQUEST QUEUE PROCESSOR TASK (EN^VDEFREQ) IS SUSPENDED BY SITE "
^DIC(9.4,199,22,1,"PAH",1,1,527,0)="USING the VDEF Configuration and Status Menu:"
^DIC(9.4,199,22,1,"PAH",1,1,528,0)="The Request Processor Status will show ""Suspended"" and the task status "
^DIC(9.4,199,22,1,"PAH",1,1,529,0)="will show ""Interrupted""."
^DIC(9.4,199,22,1,"PAH",1,1,530,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,531,0)="                      VDEF Status - Dec 22, 2005@11:50:14"
^DIC(9.4,199,22,1,"PAH",1,1,532,0)="Logical Link Status"
^DIC(9.4,199,22,1,"PAH",1,1,533,0)="  VDEFVIE1: stopped or caught up"
^DIC(9.4,199,22,1,"PAH",1,1,534,0)="  VDEFVIE2: stopped or caught up"
^DIC(9.4,199,22,1,"PAH",1,1,535,0)="  VDEFVIE3: stopped or caught up"
^DIC(9.4,199,22,1,"PAH",1,1,536,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,537,0)="Requestor Status"
^DIC(9.4,199,22,1,"PAH",1,1,538,0)="  MAINTENANCE: Activated      Dest.: VISTA HL7    Req. Queue: MAINTENANCE"
^DIC(9.4,199,22,1,"PAH",1,1,539,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,540,0)=" Request Processor Status"
^DIC(9.4,199,22,1,"PAH",1,1,541,0)="  MAINTENANCE: Suspended"
^DIC(9.4,199,22,1,"PAH",1,1,542,0)="  Current Task # [Proc]: 7410053 [0]  Task status: Interrupted"
^DIC(9.4,199,22,1,"PAH",1,1,543,0)="  Requests waiting for purge: 0      Last request#: "
^DIC(9.4,199,22,1,"PAH",1,1,544,0)="  Checked Out(0)  Queued Up(0)  Errored Out(0)"
^DIC(9.4,199,22,1,"PAH",1,1,545,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,546,0)="IMPORTANT:"
^DIC(9.4,199,22,1,"PAH",1,1,547,0)="IF THE REQUEST QUEUE PROCESSOR TASK (EN^VDEFREQ) IS RUNNING BUT THE VMS "
^DIC(9.4,199,22,1,"PAH",1,1,548,0)="PROCESS HAS STOPPED:"
^DIC(9.4,199,22,1,"PAH",1,1,549,0)="The Request Processor Status will STILL show ""Running"" and the task status"
^DIC(9.4,199,22,1,"PAH",1,1,550,0)="will STILL show ""Active-Running""."
^DIC(9.4,199,22,1,"PAH",1,1,551,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,552,0)="This is because of the way that an application communicates with TaskMan "
^DIC(9.4,199,22,1,"PAH",1,1,553,0)="to stop a task. It makes a request to TaskMan to stop the task and waits "
^DIC(9.4,199,22,1,"PAH",1,1,554,0)="for the status of the task to go to ""stop requested"". Then the application"
^DIC(9.4,199,22,1,"PAH",1,1,555,0)="quits back to TaskMan and only then does TaskMan update the task status to"
^DIC(9.4,199,22,1,"PAH",1,1,556,0)="stopped or interrupted.  If the VMS process for the EN^VDEFREQ task had"
^DIC(9.4,199,22,1,"PAH",1,1,557,0)="died, then the VDEFREQ program is not running and cannot quit back to"
^DIC(9.4,199,22,1,"PAH",1,1,558,0)="TaskMan.  This is why the TaskMan task status stays ""Active-Running""."
^DIC(9.4,199,22,1,"PAH",1,1,559,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,560,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,561,0)="HOW TO VERIFY THAT THIS PATCH TESTS SUCCESSFULLY"
^DIC(9.4,199,22,1,"PAH",1,1,562,0)="================================================"
^DIC(9.4,199,22,1,"PAH",1,1,563,0)="1) From the VDEF Configuration and Status Menu, suspend the MAINTENANCE"
^DIC(9.4,199,22,1,"PAH",1,1,564,0)="   request queue. You should get the two alerts shown below."
^DIC(9.4,199,22,1,"PAH",1,1,565,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,566,0)="   MM/DD/YY@HH:MM:SS VDEF REQUEST QUEUE PROCESSOR FOR MAINTENANCE HAS"
^DIC(9.4,199,22,1,"PAH",1,1,567,0)="   EXITED."
^DIC(9.4,199,22,1,"PAH",1,1,568,0)="   MM/DD/YY@HH:MM:SS VDEF QUEUE MAINTENANCE IS SUSPENDED. PLEASE START IT."
^DIC(9.4,199,22,1,"PAH",1,1,569,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,570,0)="   Note that you may have to wait up to ten minutes to get these"
^DIC(9.4,199,22,1,"PAH",1,1,571,0)="   alerts. This is the interval that the VDEF process monitor runs at."
^DIC(9.4,199,22,1,"PAH",1,1,572,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,573,0)="2) From the VDEF Configuration and Status Menu, restart the MAINTENANCE"
^DIC(9.4,199,22,1,"PAH",1,1,574,0)="   Request Queue by changing the status to Running."
^DIC(9.4,199,22,1,"PAH",1,1,575,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,576,0)="3) WITHOUT suspending the VDEF Request Queue 'MAINTENANCE', use the VDEF "
^DIC(9.4,199,22,1,"PAH",1,1,577,0)="   Status display to identify the VMS process ID for the Request Queue"
^DIC(9.4,199,22,1,"PAH",1,1,578,0)="   Task. Then use ^RESJOB to kill that job.  You should get the"
^DIC(9.4,199,22,1,"PAH",1,1,579,0)="   following alert:"
^DIC(9.4,199,22,1,"PAH",1,1,580,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,581,0)="   MM/DD/YY@HH:MM:SS VDEF QUEUE MAINTENANCE AUTO-RESTARTED. NO ACTION"
^DIC(9.4,199,22,1,"PAH",1,1,582,0)="   REQUIRED."
^DIC(9.4,199,22,1,"PAH",1,1,583,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,584,0)="   Note that you may have to wait up to ten minutes to get these"
^DIC(9.4,199,22,1,"PAH",1,1,585,0)="   alerts. This is the interval that the VDEF process monitor runs at."
^DIC(9.4,199,22,1,"PAH",1,1,586,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,587,0)="   If you kill the process while there is a VDEF Request in the"
^DIC(9.4,199,22,1,"PAH",1,1,588,0)="   Checked Out status, you may also get this alert:"
^DIC(9.4,199,22,1,"PAH",1,1,589,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,590,0)="   MM/DD/YY@HH:MM:SS RECORD nnn IN QUEUE MAINTENANCE HUNG IN Checked"
^DIC(9.4,199,22,1,"PAH",1,1,591,0)="   Out Status."
^DIC(9.4,199,22,1,"PAH",1,1,592,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,593,0)="   NOTE: Doing this will leave an orphaned TaskMan task for EN^VDEFREQ"
^DIC(9.4,199,22,1,"PAH",1,1,594,0)="   that you will have to clean and delete."
^DIC(9.4,199,22,1,"PAH",1,1,595,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,596,0)="4) If you do get a Checked Out request alert, use %G and look at the"
^DIC(9.4,199,22,1,"PAH",1,1,597,0)="   record. If it's a valid alert, the data in piece 2 of the zero node"
^DIC(9.4,199,22,1,"PAH",1,1,598,0)="   will be ""C""."
^DIC(9.4,199,22,1,"PAH",1,1,599,0)="      ^VDEFHL7(579.3,1,1,record ien,0) = IEN^STATUS^......"
^DIC(9.4,199,22,1,"PAH",1,1,600,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,601,0)="5) If you get any requests that get hung in the Checked Out or"
^DIC(9.4,199,22,1,"PAH",1,1,602,0)="   Errored Out Status, they will get requeued by the VDEF queue"
^DIC(9.4,199,22,1,"PAH",1,1,603,0)="   process monitor which runs every ten minutes.  If this monitor does"
^DIC(9.4,199,22,1,"PAH",1,1,604,0)="   requeue any requests, you will get one or both of these alerts:"
^DIC(9.4,199,22,1,"PAH",1,1,605,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,606,0)="   MM/DD/YY@HH:MM:SS VDEF HAS REQUEUED CHECKED OUT RECORDS. NO ACTION"
^DIC(9.4,199,22,1,"PAH",1,1,607,0)="   NEEDED."
^DIC(9.4,199,22,1,"PAH",1,1,608,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,609,0)="   MM/DD/YY@HH:MM:SS VDEF HAS REQUEUED ERRORED OUT RECORDS. NO ACTION"
^DIC(9.4,199,22,1,"PAH",1,1,610,0)="   NEEDED."
^DIC(9.4,199,22,1,"PAH",1,1,611,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,612,0)="   NOTE: Without direct, intentional intervention in the ^VDEFHL7"
^DIC(9.4,199,22,1,"PAH",1,1,613,0)="         queue by modifying a record, you will have to wait for a"
^DIC(9.4,199,22,1,"PAH",1,1,614,0)="         request to get checked out hung or errored out on it's own. If"
^DIC(9.4,199,22,1,"PAH",1,1,615,0)="         you don't want to wait, instructions on how to do that for the"
^DIC(9.4,199,22,1,"PAH",1,1,616,0)="         purposes of verifying the testing of this patch are available"
^DIC(9.4,199,22,1,"PAH",1,1,617,0)="         from the VDEF developer."
^DIC(9.4,199,22,1,"PAH",1,1,618,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,619,0)="6) VDEF alerts will no longer be sent to members of the HL7 mail group"
^DIC(9.4,199,22,1,"PAH",1,1,620,0)="   but will be sent to the members in the new VDEF NATIONAL ALERTS"
^DIC(9.4,199,22,1,"PAH",1,1,621,0)="   mail group."
^DIC(9.4,199,22,1,"PAH",1,1,622,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,623,0)="7) You have had the patch in place for 2 weeks and have seen no"
^DIC(9.4,199,22,1,"PAH",1,1,624,0)="   adverse affects and it has not affected the functionality of any"
^DIC(9.4,199,22,1,"PAH",1,1,625,0)="   other option(s)."
^DIC(9.4,199,22,1,"PAH",1,1,626,0)=" "
^DIC(9.4,199,22,1,"PAH",1,1,627,0)="8) You have communicated your test results to the SQA representative"
^DIC(9.4,199,22,1,"PAH",1,1,628,0)="   and given your approval for its release."
^DIC(9.4,199,22,1,"PAH",2,0)="10 SEQ #2^3120309.11004^17"
^DIC(9.4,199,22,1,"PAH",2,1,0)="^^2^2^3120309"
^DIC(9.4,199,22,1,"PAH",2,1,1,0)="Please see the National Patch Module on Forum for the patch description."
^DIC(9.4,199,22,1,"PAH",2,1,2,0)=""
^DIC(9.4,199,22,1,"PAH",3,0)="11 SEQ #3^3120829.104443^17"
^DIC(9.4,199,22,1,"PAH",3,1,0)="^^2^2^3120829"
^DIC(9.4,199,22,1,"PAH",3,1,1,0)="Please see the National Patch Module for the description."
^DIC(9.4,199,22,1,"PAH",3,1,2,0)=""
^DIC(9.4,199,22,1,"PAH",4,0)="12 SEQ #4^3150616.122149^17"
^DIC(9.4,199,22,1,"PAH",4,1,0)="^^4^4^3150616"
^DIC(9.4,199,22,1,"PAH",4,1,1,0)="This patch will fix the input transform utility that inadvertently"
^DIC(9.4,199,22,1,"PAH",4,1,2,0)="restricted the values to greater than 30 days and update the REQUEST"
^DIC(9.4,199,22,1,"PAH",4,1,3,0)="QUEUE WAKEUP PERIOD description to reflect how the field is"
^DIC(9.4,199,22,1,"PAH",4,1,4,0)="defined."
^DIC(9.4,199,22,1,"PAH",5,0)="14 SEQ #5^3170106.125539^54"
^DIC(9.4,199,22,1,"PAH",5,1,0)="^^6^6^3170106"
^DIC(9.4,199,22,1,"PAH",5,1,1,0)="This patch will fix the VDEF Request Processor so that when it"
^DIC(9.4,199,22,1,"PAH",5,1,2,0)="encounters a VDEF REQUEST QUEUE file (#579.3) record NAME "
^DIC(9.4,199,22,1,"PAH",5,1,3,0)="VALUE PAIRS MULTIPLE (#579.311) with an internal entry "
^DIC(9.4,199,22,1,"PAH",5,1,4,0)="number value other than a one (1) or two (2) it will continue"
^DIC(9.4,199,22,1,"PAH",5,1,5,0)="processing as long as the data associated with each respective"
^DIC(9.4,199,22,1,"PAH",5,1,6,0)="node is valid."
