^DIC(9.4,100,22,15,"PAH",48,1,136,0)="   SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",48,1,137,0)="   ==================="
^DIC(9.4,100,22,15,"PAH",48,1,138,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,139,0)="   The following software and documentation files are exported as part"
^DIC(9.4,100,22,15,"PAH",48,1,140,0)="   of this patch:"
^DIC(9.4,100,22,15,"PAH",48,1,141,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,142,0)="    File Name                     Contents             Retrieval Format"
^DIC(9.4,100,22,15,"PAH",48,1,143,0)="    ---------                     --------             ----------------"
^DIC(9.4,100,22,15,"PAH",48,1,144,0)="    YS_501_70.KID                 YS*5.01*70               ASCII"
^DIC(9.4,100,22,15,"PAH",48,1,145,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,146,0)="    YS_501_70.ZIP                 Mental Health Assistant  BINARY"
^DIC(9.4,100,22,15,"PAH",48,1,147,0)="                                  This file is the complete install"
^DIC(9.4,100,22,15,"PAH",48,1,148,0)="                                  for the Mental Health Assistant"
^DIC(9.4,100,22,15,"PAH",48,1,149,0)="                                  GUI version 1.0.2.10 client."
^DIC(9.4,100,22,15,"PAH",48,1,150,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,151,0)="    - YS_MHA.EXE                  MHA2 Executable"
^DIC(9.4,100,22,15,"PAH",48,1,152,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,153,0)="    YS50170_Setup_125.EXE         Mental Health Assistant  BINARY"
^DIC(9.4,100,22,15,"PAH",48,1,154,0)="                                  This file is the complete install"
^DIC(9.4,100,22,15,"PAH",48,1,155,0)="                                  for the Mental Health Assistant"
^DIC(9.4,100,22,15,"PAH",48,1,156,0)="                                  GUI version 1.0.2.10 client."
^DIC(9.4,100,22,15,"PAH",48,1,157,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,158,0)="    - YS_MHA.exe       MHA2 Executable"
^DIC(9.4,100,22,15,"PAH",48,1,159,0)="    - YS_MHA_SD.exe    Secure Desktop Executable"
^DIC(9.4,100,22,15,"PAH",48,1,160,0)="    - YS_MHA_KH.DLL    Keyboard Hook DLL used by Secure Desktop"
^DIC(9.4,100,22,15,"PAH",48,1,161,0)="    - YS_MHA.Hlp       Online Help file"
^DIC(9.4,100,22,15,"PAH",48,1,162,0)="    - YS_MHA.GID       Online Help configuration file"
^DIC(9.4,100,22,15,"PAH",48,1,163,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,164,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,165,0)="   The software files are available on the following OI Field Offices'"
^DIC(9.4,100,22,15,"PAH",48,1,166,0)="   ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",48,1,167,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,168,0)="   All sites are encouraged to use their FTP capability to obtain these"
^DIC(9.4,100,22,15,"PAH",48,1,169,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",48,1,170,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",48,1,171,0)="   are located."
^DIC(9.4,100,22,15,"PAH",48,1,172,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,173,0)="    OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,100,22,15,"PAH",48,1,174,0)="    ===============    ===========                ========="
^DIC(9.4,100,22,15,"PAH",48,1,175,0)="    ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",48,1,176,0)="    HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",48,1,177,0)="    SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",48,1,178,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,179,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,180,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",48,1,181,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",48,1,182,0)="   1. Use the 'LOAD A DISTRIBUTION' option on the Installation menu of the"
^DIC(9.4,100,22,15,"PAH",48,1,183,0)="      KIDS menu. The Host File name is YS_501_70.KID.  Answer YES to the"
^DIC(9.4,100,22,15,"PAH",48,1,184,0)="      question: ""Want to Continue with Load? YES//"""
^DIC(9.4,100,22,15,"PAH",48,1,185,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,186,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,187,0)="   2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",48,1,188,0)="      system. You now need to install the Transport global. "
^DIC(9.4,100,22,15,"PAH",48,1,189,0)="      On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,100,22,15,"PAH",48,1,190,0)="      following options:"
^DIC(9.4,100,22,15,"PAH",48,1,191,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,192,0)="         Print Transport Global"
^DIC(9.4,100,22,15,"PAH",48,1,193,0)="         Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",48,1,194,0)="         Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",48,1,195,0)="         Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",48,1,196,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,197,0)=""
^DIC(9.4,100,22,15,"PAH",48,1,198,0)="   3. Users may remain on the system, but installation should be done "
^DIC(9.4,100,22,15,"PAH",48,1,199,0)="      at off peak hours."
^DIC(9.4,100,22,15,"PAH",48,1,200,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,201,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,202,0)="   4. Installation will take less than five minutes. "
^DIC(9.4,100,22,15,"PAH",48,1,203,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,204,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,205,0)="   5. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",48,1,206,0)="      'Install Package(s)' Select the package 'YS*5.01*70'"
^DIC(9.4,100,22,15,"PAH",48,1,207,0)="      and proceed with install."
^DIC(9.4,100,22,15,"PAH",48,1,208,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,209,0)=" "
^DIC(9.4,100,22,15,"PAH",48,1,210,0)="   6. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",48,1,211,0)="      install//', respond NO."
^DIC(9.4,100,22,15,"PAH",48,1,212,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,100,22,15,"PAH",48,1,213,0)="      and Protocols? YES//', respond NO "
^DIC(9.4,100,22,15,"PAH",48,1,214,0)=""
^DIC(9.4,100,22,15,"PAH",48,1,215,0)="   7. Routines YSPRE70 and YSPOS70 are deleted after the installation has"
^DIC(9.4,100,22,15,"PAH",48,1,216,0)="      successfully completed."
^DIC(9.4,100,22,15,"PAH",49,0)="83 SEQ #68^3040330^1"
^DIC(9.4,100,22,15,"PAH",49,1,0)="^^1^1^3040330"
^DIC(9.4,100,22,15,"PAH",49,1,1,0)="This patch fixes problems with scoring of the MBMD instrument."
^DIC(9.4,100,22,15,"PAH",50,0)="81 SEQ #69^3040427^1"
^DIC(9.4,100,22,15,"PAH",50,1,0)="^^56^56^3040427"
^DIC(9.4,100,22,15,"PAH",50,1,1,0)="This patch contains routine YSGAFHL7 which has been modified to send the"
^DIC(9.4,100,22,15,"PAH",50,1,2,0)="new race and ethnicity data to the National Patient Care Database (NPCD) in"
^DIC(9.4,100,22,15,"PAH",50,1,3,0)="Austin, TX."
^DIC(9.4,100,22,15,"PAH",50,1,4,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,5,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,6,0)="  Associated E3R:  N/A"
^DIC(9.4,100,22,15,"PAH",50,1,7,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,8,0)="  Associated NOIS: N/A"
^DIC(9.4,100,22,15,"PAH",50,1,9,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,10,0)="  Test Site(s):    HEARTLAND-WEST HCS"
^DIC(9.4,100,22,15,"PAH",50,1,11,0)="                   Miami VAMC, FL"
^DIC(9.4,100,22,15,"PAH",50,1,12,0)="                   Minneapolis VAMC, MN"
^DIC(9.4,100,22,15,"PAH",50,1,13,0)="                   New York HCS, NY"
^DIC(9.4,100,22,15,"PAH",50,1,14,0)="    "
