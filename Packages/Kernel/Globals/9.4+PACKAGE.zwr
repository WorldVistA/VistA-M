^DIC(9.4,28,22,6,"PAH",1,1,52,0)="2200.43           Date of Visit             mmyyyy          mmyy"
^DIC(9.4,28,22,6,"PAH",1,1,53,0)="2200.5            Discharge Date            mmyyyy          mmyy"
^DIC(9.4,28,22,6,"PAH",1,1,54,0)="4267              Fiscal Yr                 yyyy            yy"
^DIC(9.4,28,22,6,"PAH",1,1,55,0)="4272              Contract Starting Date    mmyyyy          mmyy"
^DIC(9.4,28,22,6,"PAH",1,1,56,0)="4273              Contract Termin Date      mmyyyy          mmyy"
