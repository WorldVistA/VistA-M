^DIC(9.4,14,22,5.9,"PAH",146,1,89,0)="  Routine Summary:"
^DIC(9.4,14,22,5.9,"PAH",146,1,90,0)="  ==============="
^DIC(9.4,14,22,5.9,"PAH",146,1,91,0)="  The following is a list of the routines included in this patch. The "
^DIC(9.4,14,22,5.9,"PAH",146,1,92,0)="  second line of each routine looks like:"
