^DIC(9.4,4,22,1,"PAH",26,1,3,0)="NOIS:       WIM-0897-20733"
^DIC(9.4,4,22,1,"PAH",26,1,4,0)="Rtn:        ^XMYPOST2"
^DIC(9.4,4,22,1,"PAH",26,1,5,0)="Test Site:  Wilmington, DE"
^DIC(9.4,4,22,1,"PAH",26,1,6,0)="Upon use of the ""Christen a Domain"" option, warns user that the facility"
