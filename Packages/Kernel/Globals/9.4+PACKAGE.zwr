^DIC(9.4,47,22,5.9,"PAH",740,1,1,0)="Patch DG*5.3*942 (this patch) adds these two (2) new entries to the HL "
^DIC(9.4,47,22,5.9,"PAH",740,1,2,0)="LOGICAL LINK (#870) File: 200TA and 200TB.  This patch via "
^DIC(9.4,47,22,5.9,"PAH",740,1,3,0)="post-install routine DG53P942 modifies the DNS DOMAIN for facility"
^DIC(9.4,47,22,5.9,"PAH",740,1,4,0)="200T7. "
^DIC(9.4,47,22,5.9,"PAH",741,0)="949^3171228.170941^54"
^DIC(9.4,47,22,5.9,"PAH",741,1,0)="^^2^2^3171228"
