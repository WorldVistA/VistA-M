^DIC(9.4,3,22,21,"PAH",59,1,86,0)="XQUTL                      New               3002763  **46**"
^DIC(9.4,3,22,21,"PAH",60,0)="84 SEQ #66^2980604^1"
^DIC(9.4,3,22,21,"PAH",60,1,0)="^^67^67^2980604"
^DIC(9.4,3,22,21,"PAH",60,1,1,0)="ISB-0598-31461  ZISHVXD  The use of the ""default HFS directory"" was not"
^DIC(9.4,3,22,21,"PAH",60,1,2,0)="WRJ-0498-11566           implemented correctly by the list function. "
^DIC(9.4,3,22,21,"PAH",60,1,3,0)="IOW-0598-41669           This has been fix to work correctly. PWD will"
^DIC(9.4,3,22,21,"PAH",60,1,4,0)="BEC-0598-21309           show the Default if that is un use."
^DIC(9.4,3,22,21,"PAH",60,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",60,1,6,0)="SFC-0598-61569           Field 20 of file 8992.1 was misspelled as "
^DIC(9.4,3,22,21,"PAH",60,1,7,0)="                         RECEIPIENT."
^DIC(9.4,3,22,21,"PAH",60,1,8,0)="           "
^DIC(9.4,3,22,21,"PAH",60,1,9,0)="FORUM MSG        ZUVXD   Using ZSLOT users could get there process set"
^DIC(9.4,3,22,21,"PAH",60,1,10,0)="                         so that function keys would not work in screen"
^DIC(9.4,3,22,21,"PAH",60,1,11,0)="                         man or the Screen editor. This has been fixed"
^DIC(9.4,3,22,21,"PAH",60,1,12,0)="                         by turning off escape processing at the start"
^DIC(9.4,3,22,21,"PAH",60,1,13,0)="                         of ZU.          "
^DIC(9.4,3,22,21,"PAH",60,1,14,0)="           "
^DIC(9.4,3,22,21,"PAH",60,1,15,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",60,1,16,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",60,1,17,0)="ZISHMSM       5685657   5978186    **24,36,49,65,84**"
^DIC(9.4,3,22,21,"PAH",60,1,18,0)="ZISHONT       5001907   5018937    **34,65,84**"
^DIC(9.4,3,22,21,"PAH",60,1,19,0)="ZISHVXD       6891389   7237979    **24,36,65,84**"
^DIC(9.4,3,22,21,"PAH",60,1,20,0)="ZUVXD         4856063   4645869    **13,24,84**"
^DIC(9.4,3,22,21,"PAH",60,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",60,1,22,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",60,1,23,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",60,1,24,0)=" "
^DIC(9.4,3,22,21,"PAH",60,1,25,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",60,1,26,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",60,1,27,0)="      "
^DIC(9.4,3,22,21,"PAH",60,1,28,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",60,1,29,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",60,1,30,0)="      "
^DIC(9.4,3,22,21,"PAH",60,1,31,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",60,1,32,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",60,1,33,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",60,1,34,0)="      options:"
^DIC(9.4,3,22,21,"PAH",60,1,35,0)="      "
^DIC(9.4,3,22,21,"PAH",60,1,36,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",60,1,37,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",60,1,38,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",60,1,39,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",60,1,40,0)="         "
^DIC(9.4,3,22,21,"PAH",60,1,41,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",60,1,42,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",60,1,43,0)="     "
^DIC(9.4,3,22,21,"PAH",60,1,44,0)="  5.  Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",60,1,45,0)="         Install Package(s)  'XU*8.0*84'"
^DIC(9.4,3,22,21,"PAH",60,1,46,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",60,1,47,0)="               "
^DIC(9.4,3,22,21,"PAH",60,1,48,0)="  6.  DSM -- Rename ZUVXD: ZL ZUVXD ZS ZU"
^DIC(9.4,3,22,21,"PAH",60,1,49,0)="  "
^DIC(9.4,3,22,21,"PAH",60,1,50,0)="  7.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",60,1,51,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",60,1,52,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",60,1,53,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",60,1,54,0)="      ZISHVXD, ZISHONT, ZISHMSM"
^DIC(9.4,3,22,21,"PAH",60,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",60,1,56,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",60,1,57,0)="       "
^DIC(9.4,3,22,21,"PAH",60,1,58,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",60,1,59,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",60,1,60,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",60,1,61,0)="      Patch number to load: 84"
^DIC(9.4,3,22,21,"PAH",60,1,62,0)="                            =="
^DIC(9.4,3,22,21,"PAH",60,1,63,0)="       "
^DIC(9.4,3,22,21,"PAH",60,1,64,0)="  8.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",60,1,65,0)=" "
^DIC(9.4,3,22,21,"PAH",60,1,66,0)=" "
^DIC(9.4,3,22,21,"PAH",60,1,67,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",61,0)="74 SEQ #67^2980616^1"
^DIC(9.4,3,22,21,"PAH",61,1,0)="^^41^41^2980616"
^DIC(9.4,3,22,21,"PAH",61,1,1,0)="DAY-0198-40011          If, as described in the NOIS, a person changes class,"
^DIC(9.4,3,22,21,"PAH",61,1,2,0)="                        from 1 to 2 and then back to 1.   The package allows "
^DIC(9.4,3,22,21,"PAH",61,1,3,0)="                        the editing of the first entry, thus destroying the "
^DIC(9.4,3,22,21,"PAH",61,1,4,0)="                        history information.  Fixed with a change to the form."
^DIC(9.4,3,22,21,"PAH",61,1,5,0)="                        XU-PERSON CLASS and routine XUA4A72."
^DIC(9.4,3,22,21,"PAH",61,1,6,0)="                        "
^DIC(9.4,3,22,21,"PAH",61,1,7,0)="                  Checksum"
^DIC(9.4,3,22,21,"PAH",61,1,8,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",61,1,9,0)="XUA4A72       2742817   4441866    **27,49,74**"
^DIC(9.4,3,22,21,"PAH",61,1,10,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",61,1,11,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",61,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",61,1,13,0)="  1.  DSM sites - This routine may be mapped,"
^DIC(9.4,3,22,21,"PAH",61,1,14,0)="      so you will need to disable mapping for the effected routine. "
^DIC(9.4,3,22,21,"PAH",61,1,15,0)="     "
^DIC(9.4,3,22,21,"PAH",61,1,16,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",61,1,17,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",61,1,18,0)="     "
^DIC(9.4,3,22,21,"PAH",61,1,19,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",61,1,20,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",61,1,21,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",61,1,22,0)="      options:"
^DIC(9.4,3,22,21,"PAH",61,1,23,0)="      "
^DIC(9.4,3,22,21,"PAH",61,1,24,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",61,1,25,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",61,1,26,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",61,1,27,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",61,1,28,0)="     "
^DIC(9.4,3,22,21,"PAH",61,1,29,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",61,1,30,0)="      non-peek time."
^DIC(9.4,3,22,21,"PAH",61,1,31,0)="     "
^DIC(9.4,3,22,21,"PAH",61,1,32,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",61,1,33,0)="      option:"
^DIC(9.4,3,22,21,"PAH",61,1,34,0)="      Use ""D ^XPDKRN"" then"
^DIC(9.4,3,22,21,"PAH",61,1,35,0)="        Install Package(s)  'XU*8.0*74'"
^DIC(9.4,3,22,21,"PAH",61,1,36,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",61,1,37,0)="        "
^DIC(9.4,3,22,21,"PAH",61,1,38,0)="     "
^DIC(9.4,3,22,21,"PAH",61,1,39,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",61,1,40,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",61,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",62,0)="75 SEQ #68^2980616^1"
^DIC(9.4,3,22,21,"PAH",62,1,0)="^^52^52^2980616"
^DIC(9.4,3,22,21,"PAH",62,1,1,0)="DAY-1097-42595 XQALSET  During testing of TIU it was found that alerts"
^DIC(9.4,3,22,21,"PAH",62,1,2,0)="                        get sent to users that have been terminated. TIU"
^DIC(9.4,3,22,21,"PAH",62,1,3,0)="                        suggested that a change to ALERTS to not sent"
^DIC(9.4,3,22,21,"PAH",62,1,4,0)="                        alerts to user that can't sign-on."
^DIC(9.4,3,22,21,"PAH",62,1,5,0)="                        "
^DIC(9.4,3,22,21,"PAH",62,1,6,0)="               XUSER    As part of the change to XQALSET a API was created"
^DIC(9.4,3,22,21,"PAH",62,1,7,0)="                        ACTIVE^XUSER to check if the user can sign-on."
^DIC(9.4,3,22,21,"PAH",62,1,8,0)="                        It returns the following codes:"
^DIC(9.4,3,22,21,"PAH",62,1,9,0)="                        """"  No user record."
^DIC(9.4,3,22,21,"PAH",62,1,10,0)="                        0   User can't sign-on."
^DIC(9.4,3,22,21,"PAH",62,1,11,0)="                        0^DISUSER  User can't sign-on because of DISUSER flag."
^DIC(9.4,3,22,21,"PAH",62,1,12,0)="                        0^TERMINATED^2980310  User terminated on date."
^DIC(9.4,3,22,21,"PAH",62,1,13,0)="                        1^NEW  A new user, could sign-on."
^DIC(9.4,3,22,21,"PAH",62,1,14,0)="                        1^ACTIVE^2980310.09  A active user, last sign-on date."
^DIC(9.4,3,22,21,"PAH",62,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",62,1,16,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",62,1,17,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",62,1,18,0)="XQALSET      12680442  12975662    **1,6,65,75**"
^DIC(9.4,3,22,21,"PAH",62,1,19,0)="XUSER          699878   1279527    **75**"
^DIC(9.4,3,22,21,"PAH",62,1,20,0)="                        "
^DIC(9.4,3,22,21,"PAH",62,1,21,0)=" ========================================================================= "
^DIC(9.4,3,22,21,"PAH",62,1,22,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",62,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",62,1,24,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",62,1,25,0)="      so you will need to disable mapping for the effected routines. "
^DIC(9.4,3,22,21,"PAH",62,1,26,0)="     "
^DIC(9.4,3,22,21,"PAH",62,1,27,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",62,1,28,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",62,1,29,0)="     "
^DIC(9.4,3,22,21,"PAH",62,1,30,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",62,1,31,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",62,1,32,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",62,1,33,0)="      options:"
^DIC(9.4,3,22,21,"PAH",62,1,34,0)="      "
^DIC(9.4,3,22,21,"PAH",62,1,35,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",62,1,36,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",62,1,37,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",62,1,38,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",62,1,39,0)="     "
^DIC(9.4,3,22,21,"PAH",62,1,40,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",62,1,41,0)="      user are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",62,1,42,0)="      acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",62,1,43,0)="     "
^DIC(9.4,3,22,21,"PAH",62,1,44,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",62,1,45,0)="      option:"
^DIC(9.4,3,22,21,"PAH",62,1,46,0)="        Install Package(s)  'XU*8.0*75'"
^DIC(9.4,3,22,21,"PAH",62,1,47,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",62,1,48,0)="        "
^DIC(9.4,3,22,21,"PAH",62,1,49,0)="     "
^DIC(9.4,3,22,21,"PAH",62,1,50,0)="  6.  DSM Sites, after patch has installed, rebuild your map set and"
^DIC(9.4,3,22,21,"PAH",62,1,51,0)="      enable user logins."
^DIC(9.4,3,22,21,"PAH",62,1,52,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",63,0)="72 SEQ #69^2980625^1"
^DIC(9.4,3,22,21,"PAH",64,0)="80 SEQ #70^2980625^1"
^DIC(9.4,3,22,21,"PAH",64,1,0)="^^293^293^2980625"
^DIC(9.4,3,22,21,"PAH",64,1,1,0)="IMPORTANT!!!   IMPORTANT!!!    IMPORTANT!!!"
^DIC(9.4,3,22,21,"PAH",64,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,3,0)="DESCRIPTION"
^DIC(9.4,3,22,21,"PAH",64,1,4,0)="============"
^DIC(9.4,3,22,21,"PAH",64,1,5,0)="KIDS patch XU*8*68 fixed a bug when protocols were ""Deleted at Site"" resulting "
^DIC(9.4,3,22,21,"PAH",64,1,6,0)="in broken (dangling) pointers within the PROTOCOL file (#101).  Patch XU*8*80 "
^DIC(9.4,3,22,21,"PAH",64,1,7,0)="will give sites the ability to periodically search the PROTOCOL file for "
^DIC(9.4,3,22,21,"PAH",64,1,8,0)="broken pointers and execute a routine (ENASK^XQ3) to automatically remove "
^DIC(9.4,3,22,21,"PAH",64,1,9,0)="them.  However, patches that were installed prior to XU*8*68 that deleted "
^DIC(9.4,3,22,21,"PAH",64,1,10,0)="protocols will need to be MANUALLY checked to ensure that a newly-created "
^DIC(9.4,3,22,21,"PAH",64,1,11,0)="protocol did not take the place of the deleted, one covering up the broken "
^DIC(9.4,3,22,21,"PAH",64,1,12,0)="pointer."
^DIC(9.4,3,22,21,"PAH",64,1,13,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,14,0)="NOTE: It is important to note that the PROTOCOL file has the same structure as "
^DIC(9.4,3,22,21,"PAH",64,1,15,0)="the OPTION file (#19) whereas field #10, ITEM corresponds to field #10, MENU, "
^DIC(9.4,3,22,21,"PAH",64,1,16,0)="in the OPTION file.  Field #10, ITEM is a multiple and a pointer to the .01 "
^DIC(9.4,3,22,21,"PAH",64,1,17,0)="field of the parent file. "
^DIC(9.4,3,22,21,"PAH",64,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,20,0)="Three patches that deleted protocols have been identified.  The protocols "
^DIC(9.4,3,22,21,"PAH",64,1,21,0)="deleted in these patches may have resulted in broken pointers.  However, there "
^DIC(9.4,3,22,21,"PAH",64,1,22,0)="is a possibility that a newly created protocol could reuse same IEN as the "
^DIC(9.4,3,22,21,"PAH",64,1,23,0)="deleted one, and thus cover-up the broken pointer.   Sites will need to "
^DIC(9.4,3,22,21,"PAH",64,1,24,0)="manually ensure that a newly created protocol hasn't overwritten any of the "
^DIC(9.4,3,22,21,"PAH",64,1,25,0)="broken ones.  The three patches are identified below along with ITEM's (field "
^DIC(9.4,3,22,21,"PAH",64,1,26,0)="#10 multiple) that one can reasonably expect to find attached to the "
^DIC(9.4,3,22,21,"PAH",64,1,27,0)="protocols.  Figures 1-5 below the ITEM listings are simulations where two "
^DIC(9.4,3,22,21,"PAH",64,1,28,0)="broken pointers were created and one was covered up with a newly created "
^DIC(9.4,3,22,21,"PAH",64,1,29,0)="protocol.  The STEPs associated with the figures are the actions needed to "
^DIC(9.4,3,22,21,"PAH",64,1,30,0)="cleanup the PROTOCOL file."
^DIC(9.4,3,22,21,"PAH",64,1,31,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,33,0)="PATCH       DATE  PROTOCOL (deleted)            FOUND ON (file 101)            "
^DIC(9.4,3,22,21,"PAH",64,1,34,0)="======================================================================="
^DIC(9.4,3,22,21,"PAH",64,1,35,0)="PX*1.0*14    2/98  PXCE ADD/EDIT STOP CODE       PXCE ADD/EDIT MENU"
^DIC(9.4,3,22,21,"PAH",64,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,37,0)="DVBA*2.7*12  9/97  DVBA C SUPER QUIT            DVBA C VIEW EXAMS (MENU)"
^DIC(9.4,3,22,21,"PAH",64,1,38,0)="                   DVBA C VIEW EXAMS (MENU)      no parent known"
^DIC(9.4,3,22,21,"PAH",64,1,39,0)="                   DVBA C VIEW JUMP (ACTION)     DVBA C VIEW EXAMS (MENU)"
^DIC(9.4,3,22,21,"PAH",64,1,40,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,41,0)="DG*5.3*140   2/98  EDR BDC CAPTURE EVENTS        no parent known"
^DIC(9.4,3,22,21,"PAH",64,1,42,0)="                   VAFED EDR INPATIENT CAPTURE   DGPM MOVEMENT EVENTS"
^DIC(9.4,3,22,21,"PAH",64,1,43,0)="                   VAFED EDR OUTPATIENT CAPTURE  SDAM APPOINTMENT EVENTS"
^DIC(9.4,3,22,21,"PAH",64,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,46,0)="NOTE: The parent protocol  of the other two deleted AMIE protocols was also "
^DIC(9.4,3,22,21,"PAH",64,1,47,0)="deleted, DVBA C VIEW EXAMS (MENU).  There should have been no negative impact "
^DIC(9.4,3,22,21,"PAH",64,1,48,0)="from the AMIE patch.  The EDR BDC CAPTURE EVENTS protocol was also determined "
^DIC(9.4,3,22,21,"PAH",64,1,49,0)="not to be a child of any known protocols."
^DIC(9.4,3,22,21,"PAH",64,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,51,0)="The following depicts ITEMs that may reasonably be found on the protocols "
^DIC(9.4,3,22,21,"PAH",64,1,52,0)="identified above:"
^DIC(9.4,3,22,21,"PAH",64,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,54,0)="ITEMS:"
^DIC(9.4,3,22,21,"PAH",64,1,55,0)="  FOUND ON:"
^DIC(9.4,3,22,21,"PAH",64,1,56,0)="    PXCE ADD/EDIT MENU"
