^DIC(9.4,4,22,1,"PAH",118,1,50,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",118,1,51,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",118,1,52,0)=" "
^DIC(9.4,4,22,1,"PAH",118,1,53,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",118,1,54,0)="NOTE: This patch requires MailMan patches XM*7.1*133, XM*7.1*134,"
^DIC(9.4,4,22,1,"PAH",118,1,55,0)="XM*7.1*138, XM*7.1*139, & XM*7.1*146."
^DIC(9.4,4,22,1,"PAH",118,1,56,0)="1.  Users should not be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",118,1,57,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",118,1,58,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",118,1,59,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",118,1,60,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",118,1,61,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",118,1,62,0)="    Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",118,1,63,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",118,1,64,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",118,1,65,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",118,1,66,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",118,1,67,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",118,1,68,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",118,1,69,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",118,1,70,0)=" Select INSTALL NAME:    XM*7.1*148    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",118,1,71,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",118,1,72,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",118,1,73,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,4,22,1,"PAH",118,1,74,0)="                                                       ==="
^DIC(9.4,4,22,1,"PAH",118,1,75,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",118,1,76,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",118,1,77,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",118,1,78,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",118,1,79,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",118,1,80,0)=""
^DIC(9.4,4,22,1,"PAH",118,1,81,0)=" DEVICE: HOME// <It's up to you.  You may queue it, if you wish.>"
^DIC(9.4,4,22,1,"PAH",118,1,82,0)="                -------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",118,1,83,0)="6.  Let users back on the system."
^DIC(9.4,4,22,1,"PAH",118,1,84,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",118,1,85,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",119,0)="149 SEQ #144^3001027^1"
^DIC(9.4,4,22,1,"PAH",119,1,0)="^^62^62^3001027"
^DIC(9.4,4,22,1,"PAH",119,1,1,0)="Patch XM*7.1*149"
^DIC(9.4,4,22,1,"PAH",119,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",119,1,3,0)="NOIS: MAR-0500-22472"
^DIC(9.4,4,22,1,"PAH",119,1,4,0)="Test Sites:  Maryland HCS"
^DIC(9.4,4,22,1,"PAH",119,1,5,0)="If a user opens second session while editing a reply to a message, and"
^DIC(9.4,4,22,1,"PAH",119,1,6,0)="enters MailMan by typing ""D ^XM"" from the programmer prompt, it is possible"
^DIC(9.4,4,22,1,"PAH",119,1,7,0)="that the reply message stub will be killed.  When the user returns to the"
^DIC(9.4,4,22,1,"PAH",119,1,8,0)="first session, exits the editor, and transmits the reply, the zero node of"
^DIC(9.4,4,22,1,"PAH",119,1,9,0)="the reply is gone, (killed in the second session), and all that is left of"
^DIC(9.4,4,22,1,"PAH",119,1,10,0)="the reply is the text in the 2 node, saved by the editor.  The user would"
^DIC(9.4,4,22,1,"PAH",119,1,11,0)="immediately be told that a new response had arrived.  (It would be from"
^DIC(9.4,4,22,1,"PAH",119,1,12,0)="""* no name *"" if the user backed up to see it.)  This patch fixes that. "
^DIC(9.4,4,22,1,"PAH",119,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",119,1,14,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",119,1,15,0)="is at a minimum.  It requires MailMan patch XM*7.1*144.."
^DIC(9.4,4,22,1,"PAH",119,1,16,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",119,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",119,1,18,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",119,1,19,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",119,1,20,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
