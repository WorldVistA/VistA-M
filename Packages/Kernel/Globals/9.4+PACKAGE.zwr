^DIC(9.4,140,22,20,"PAH",8,1,50,0)="  The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",8,1,51,0)="  RMPR*3*3"
^DIC(9.4,140,22,20,"PAH",8,1,52,0)="  RMPR*3*12"
^DIC(9.4,140,22,20,"PAH",8,1,53,0)="  RMPR*3*15"
^DIC(9.4,140,22,20,"PAH",8,1,54,0)="  RMPR*3*16"
