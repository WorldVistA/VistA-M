^DIC(9.4,4,22,1,"PAH",43,1,570,0)="XMXUTIL1     $$CONVERT   Convert InterNet date/time to FileMan date/time"
^DIC(9.4,4,22,1,"PAH",43,1,571,0)="             $$CTRL      Strip control characters"
^DIC(9.4,4,22,1,"PAH",43,1,572,0)="             $$DECODEUP  ~U~ to ^"
^DIC(9.4,4,22,1,"PAH",43,1,573,0)="             $$ENCODEUP  ^ to ~U~"
^DIC(9.4,4,22,1,"PAH",43,1,574,0)="             $$GMTDIFF   +-HHMM difference from GMT"
