^DIC(9.4,11,22,5.03,"PAH",27,1,164,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,165,0)=" Install Message sent #XXXXX"
^DIC(9.4,11,22,5.03,"PAH",28,0)="63 SEQ #48^3021025^1"
^DIC(9.4,11,22,5.03,"PAH",28,1,0)="^^170^170^3021025"
^DIC(9.4,11,22,5.03,"PAH",28,1,1,0)="VISTA Laboratory Package patch LA*5.2*63 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",28,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",28,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,4,0)="Patch LA*5.2*63 corrects a defect in LOINC encoding of test results in"
^DIC(9.4,11,22,5.03,"PAH",28,1,5,0)="the OBX segment of a Lab HL7 Result (ORU) message. The segment building "
^DIC(9.4,11,22,5.03,"PAH",28,1,6,0)="routine LA7VOBX1 was failing to check and use a default LOINC code when"
^DIC(9.4,11,22,5.03,"PAH",28,1,7,0)="available if the test results have not been LOINC mapped. The software"
^DIC(9.4,11,22,5.03,"PAH",28,1,8,0)="will check and use the default LOINC code when results are not LOINC"
^DIC(9.4,11,22,5.03,"PAH",28,1,9,0)="mapped."
^DIC(9.4,11,22,5.03,"PAH",28,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,11,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,12,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",28,1,13,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",28,1,14,0)=" ISD-0602-71432"
^DIC(9.4,11,22,5.03,"PAH",28,1,15,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,16,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,17,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",28,1,18,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",28,1,19,0)=" Milwaukee VAMC"
^DIC(9.4,11,22,5.03,"PAH",28,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,21,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,22,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",28,1,23,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",28,1,24,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",28,1,25,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",28,1,26,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",28,1,27,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,28,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",28,1,29,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",28,1,30,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",28,1,31,0)="   LA63             N/A            4454878        **63** (Deleted by KIDS)"
^DIC(9.4,11,22,5.03,"PAH",28,1,32,0)="   LA7VOBX1         3981059        4057776        **46,61,63**"
^DIC(9.4,11,22,5.03,"PAH",28,1,33,0)="  "
^DIC(9.4,11,22,5.03,"PAH",28,1,34,0)=" List of preceding patches: 61"
^DIC(9.4,11,22,5.03,"PAH",28,1,35,0)=" Sites should use CHECK^XTSUMBLD to verify checksums. "
^DIC(9.4,11,22,5.03,"PAH",28,1,36,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,37,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,38,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",28,1,39,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,40,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",28,1,41,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",28,1,42,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,43,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,11,22,5.03,"PAH",28,1,44,0)="  can be installed when Laboratory users are on the system. Laboratory"
^DIC(9.4,11,22,5.03,"PAH",28,1,45,0)="  users should not use the lab verification options during patch"
^DIC(9.4,11,22,5.03,"PAH",28,1,46,0)="  installation. KIDS will disable the Laboratory test verification options."
^DIC(9.4,11,22,5.03,"PAH",28,1,47,0)="  Patch installation should not occur during execution of the Clinical"
^DIC(9.4,11,22,5.03,"PAH",28,1,48,0)="  Case Registries scheduled task option Registry Update & Data Extraction"
^DIC(9.4,11,22,5.03,"PAH",28,1,49,0)="  [ROR TASK]. Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",28,1,50,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,51,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,52,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,11,22,5.03,"PAH",28,1,53,0)="      problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",28,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,55,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",28,1,56,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",28,1,57,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,58,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,59,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",28,1,60,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,61,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",28,1,62,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",28,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,64,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",28,1,65,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",28,1,66,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,67,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",28,1,68,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",28,1,69,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,70,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",28,1,71,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",28,1,72,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",28,1,73,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",28,1,74,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",28,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,76,0)="  6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",28,1,77,0)="      and select the package 'LA*5.2*63'.  When prompted 'Want KIDS to"
^DIC(9.4,11,22,5.03,"PAH",28,1,78,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,11,22,5.03,"PAH",28,1,79,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,11,22,5.03,"PAH",28,1,80,0)="      YES//', choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",28,1,81,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,82,0)="      KIDS will disable the following options:"
^DIC(9.4,11,22,5.03,"PAH",28,1,83,0)="        Enter/verify data (auto instrument) [LRVR]"
^DIC(9.4,11,22,5.03,"PAH",28,1,84,0)="        Enter/verify data (Work list) [LRVRW]"
^DIC(9.4,11,22,5.03,"PAH",28,1,85,0)="        Enter/verify data (Load list) [LRVRW2]"
^DIC(9.4,11,22,5.03,"PAH",28,1,86,0)="        Enter/verify/modify data (manual) [LRENTER]"
^DIC(9.4,11,22,5.03,"PAH",28,1,87,0)="        Group verify (EA, EL, EW) [LRGV]"
^DIC(9.4,11,22,5.03,"PAH",28,1,88,0)="        Bypass normal data entry [LRFAST]"
^DIC(9.4,11,22,5.03,"PAH",28,1,89,0)="        Fast Bypass Data Entry/Verify [LRFASTS]"
^DIC(9.4,11,22,5.03,"PAH",28,1,90,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,91,0)="  7. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",28,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,93,0)=" Note: Routine LA63 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",28,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,95,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,96,0)=" "
^DIC(9.4,11,22,5.03,"PAH",28,1,97,0)="************************************************************************"
