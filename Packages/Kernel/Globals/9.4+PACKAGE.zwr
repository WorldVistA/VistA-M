^DIC(9.4,4,22,1,"PAH",144,1,114,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",144,1,115,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",144,1,116,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",144,1,117,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",144,1,118,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",144,1,119,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",144,1,120,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",144,1,121,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,122,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",144,1,123,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",144,1,124,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",144,1,125,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",145,0)="178 SEQ #170^3010423^1"
^DIC(9.4,4,22,1,"PAH",145,1,0)="^^57^57^3010423"
^DIC(9.4,4,22,1,"PAH",145,1,1,0)="Patch XM*7.1*178"
^DIC(9.4,4,22,1,"PAH",145,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",145,1,3,0)="NOIS: BRX-0301-12876"
^DIC(9.4,4,22,1,"PAH",145,1,4,0)="Test Site: Bronx"
^DIC(9.4,4,22,1,"PAH",145,1,5,0)="When using the API SENDBULL^XMXAPI, if you specify """" for XMBODY, it causes"
^DIC(9.4,4,22,1,"PAH",145,1,6,0)="an error.  It shouldn't.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",145,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",145,1,8,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",145,1,9,0)="minimum.  It requires MailMan patch XM*7.1*143."
^DIC(9.4,4,22,1,"PAH",145,1,10,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",145,1,11,0)=""
