^DIC(9.4,3,22,21,"PAH",239,1,1,0)="XU*8.0*296"
^DIC(9.4,3,22,21,"PAH",239,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,3,0)="NOIS: ISD-0500-72669"
^DIC(9.4,3,22,21,"PAH",239,1,4,0)="Test Sites: Dallas OIFO"
^DIC(9.4,3,22,21,"PAH",239,1,5,0)="Blood Bank Team Clearance: 4/9/03"
^DIC(9.4,3,22,21,"PAH",239,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,7,0)="The Kernel Part III post routine, XUINCON - BUILDS ACCESSIBLE FILE MULTIPLE,"
^DIC(9.4,3,22,21,"PAH",239,1,8,0)="sets the NEW PERSON (#200) file's ACCESSIBLE FILE (#200.032) sub-file's"
^DIC(9.4,3,22,21,"PAH",239,1,9,0)="WRITE ACCESS (#5) field to zero at D1+1^XUINCON.  The Set of Codes field"
^DIC(9.4,3,22,21,"PAH",239,1,10,0)="definition does not define 0 as an allowed value.  This causes ""0"" to"
^DIC(9.4,3,22,21,"PAH",239,1,11,0)="display during display functions instead of null or NO."
^DIC(9.4,3,22,21,"PAH",239,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,13,0)="To fix this, ""0"" (meaning NO) is being added to the set of codes for this"
^DIC(9.4,3,22,21,"PAH",239,1,14,0)="field and the others in this multiple."
^DIC(9.4,3,22,21,"PAH",239,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,16,0)="This patch contains no routines; only the DD changes."
^DIC(9.4,3,22,21,"PAH",239,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,18,0)="STANDARD DATA DICTIONARY #200.032 -- ACCESSIBLE FILE SUB-FILE"
^DIC(9.4,3,22,21,"PAH",239,1,19,0)="STORED IN ^VA(200,"
^DIC(9.4,3,22,21,"PAH",239,1,20,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,3,22,21,"PAH",239,1,21,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,3,22,21,"PAH",239,1,22,0)="----------------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",239,1,23,0)="200.032,1  DATA DICTIONARY ACCESS 0;2 SET"
^DIC(9.4,3,22,21,"PAH",239,1,24,0)="                             '1' FOR YES; "
^DIC(9.4,3,22,21,"PAH",239,1,25,0)="                             '0' FOR NO; "
^DIC(9.4,3,22,21,"PAH",239,1,26,0)="           LAST EDITED:      APR 08, 2003 "
^DIC(9.4,3,22,21,"PAH",239,1,27,0)="           DESCRIPTION:      This field is a flag that, when set to 1, gives"
^DIC(9.4,3,22,21,"PAH",239,1,28,0)="                             the user data dictionary access to the file (in"
^DIC(9.4,3,22,21,"PAH",239,1,29,0)="                             the .01 field) represented in this record.  "
^DIC(9.4,3,22,21,"PAH",239,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,31,0)="200.032,2  DELETE ACCESS          0;3 SET"
^DIC(9.4,3,22,21,"PAH",239,1,32,0)="                             '1' FOR YES; "
^DIC(9.4,3,22,21,"PAH",239,1,33,0)="                             '0' FOR NO; "
^DIC(9.4,3,22,21,"PAH",239,1,34,0)="           LAST EDITED:      APR 08, 2003 "
^DIC(9.4,3,22,21,"PAH",239,1,35,0)="           DESCRIPTION:      This field is a flag that, when set to 1, gives"
^DIC(9.4,3,22,21,"PAH",239,1,36,0)="                             the user delete access to the file (in the .01"
^DIC(9.4,3,22,21,"PAH",239,1,37,0)="                             field) represented in this record.  "
^DIC(9.4,3,22,21,"PAH",239,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,39,0)="200.032,3  LAYGO ACCESS           0;4 SET"
^DIC(9.4,3,22,21,"PAH",239,1,40,0)="                             '1' FOR YES; "
^DIC(9.4,3,22,21,"PAH",239,1,41,0)="                             '0' FOR NO; "
^DIC(9.4,3,22,21,"PAH",239,1,42,0)="           LAST EDITED:      APR 08, 2003 "
^DIC(9.4,3,22,21,"PAH",239,1,43,0)="           DESCRIPTION:      This field is a flag that, when set to 1, gives"
^DIC(9.4,3,22,21,"PAH",239,1,44,0)="                             the user LAYGO access to the file (in the .01"
^DIC(9.4,3,22,21,"PAH",239,1,45,0)="                             field) represented in this record.  "
^DIC(9.4,3,22,21,"PAH",239,1,46,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,47,0)="200.032,4  READ ACCESS            0;5 SET"
^DIC(9.4,3,22,21,"PAH",239,1,48,0)="                             '1' FOR YES; "
^DIC(9.4,3,22,21,"PAH",239,1,49,0)="                             '0' FOR NO; "
^DIC(9.4,3,22,21,"PAH",239,1,50,0)="           LAST EDITED:      APR 08, 2003 "
^DIC(9.4,3,22,21,"PAH",239,1,51,0)="           DESCRIPTION:      This field is a flag that, when set to 1, gives"
^DIC(9.4,3,22,21,"PAH",239,1,52,0)="                             the user read access to the file (in the .01"
^DIC(9.4,3,22,21,"PAH",239,1,53,0)="                             field) represented in this record.  "
^DIC(9.4,3,22,21,"PAH",239,1,54,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,55,0)="200.032,5  WRITE ACCESS           0;6 SET"
^DIC(9.4,3,22,21,"PAH",239,1,56,0)="                             '1' FOR YES; "
^DIC(9.4,3,22,21,"PAH",239,1,57,0)="                             '0' FOR NO; "
^DIC(9.4,3,22,21,"PAH",239,1,58,0)="           LAST EDITED:      APR 08, 2003 "
^DIC(9.4,3,22,21,"PAH",239,1,59,0)="           DESCRIPTION:      This field is a flag that, when set to 1, gives"
^DIC(9.4,3,22,21,"PAH",239,1,60,0)="                             the user write access to the file (in the .01"
^DIC(9.4,3,22,21,"PAH",239,1,61,0)="                             field) represented in this record.  "
^DIC(9.4,3,22,21,"PAH",239,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,63,0)="200.032,6  AUDIT ACCESS           0;7 SET"
^DIC(9.4,3,22,21,"PAH",239,1,64,0)="                             '1' FOR YES; "
^DIC(9.4,3,22,21,"PAH",239,1,65,0)="                             '0' FOR NO; "
^DIC(9.4,3,22,21,"PAH",239,1,66,0)="           LAST EDITED:      APR 08, 2003 "
^DIC(9.4,3,22,21,"PAH",239,1,67,0)="           DESCRIPTION:      This field is a flag that, when set to 1, gives"
^DIC(9.4,3,22,21,"PAH",239,1,68,0)="                             the user audit access to the file (in the .01"
^DIC(9.4,3,22,21,"PAH",239,1,69,0)="                             field) represented in this record.  "
^DIC(9.4,3,22,21,"PAH",239,1,70,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,71,0)="NOTE: This patch may be installed at any time.  Users may be on the system."
^DIC(9.4,3,22,21,"PAH",239,1,72,0)="It has no patch pre-requisites."
^DIC(9.4,3,22,21,"PAH",239,1,73,0)="============================================================================ "
^DIC(9.4,3,22,21,"PAH",239,1,74,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,75,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",239,1,76,0)="The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",239,1,77,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",239,1,78,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,79,0)="              Before          After"
^DIC(9.4,3,22,21,"PAH",239,1,80,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",239,1,81,0)="------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",239,1,82,0)="No routines are included in this patch."
^DIC(9.4,3,22,21,"PAH",239,1,83,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",239,1,84,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,85,0)="This patch introduces no new routines."
^DIC(9.4,3,22,21,"PAH",239,1,86,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",239,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",239,1,88,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",239,1,89,0)="NOTE: This patch may be installed at any time.  Users may be on the system."
^DIC(9.4,3,22,21,"PAH",239,1,90,0)="It has no patch pre-requisites."
^DIC(9.4,3,22,21,"PAH",239,1,91,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,3,22,21,"PAH",239,1,92,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,3,22,21,"PAH",239,1,93,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,3,22,21,"PAH",239,1,94,0)="3.  Users may be on the system.  You do not need to stop TaskMan."
^DIC(9.4,3,22,21,"PAH",239,1,95,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,3,22,21,"PAH",239,1,96,0)="    Transport Global:"
^DIC(9.4,3,22,21,"PAH",239,1,97,0)="       Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",239,1,98,0)="       Print Transport Global"
^DIC(9.4,3,22,21,"PAH",239,1,99,0)="       Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",239,1,100,0)="       Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",239,1,101,0)="       Install Package(s)"
^DIC(9.4,3,22,21,"PAH",239,1,102,0)=" Select INSTALL NAME:    XU*8.0*296    Loaded from Distribution  <date/time>"
^DIC(9.4,3,22,21,"PAH",239,1,103,0)="                         =========="
^DIC(9.4,3,22,21,"PAH",239,1,104,0)=" Install Questions for XU*8.0*296"
^DIC(9.4,3,22,21,"PAH",239,1,105,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,106,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",239,1,107,0)="                                                       =="
^DIC(9.4,3,22,21,"PAH",239,1,108,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",239,1,109,0)="                                                                       =="
^DIC(9.4,3,22,21,"PAH",239,1,110,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,3,22,21,"PAH",239,1,111,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,3,22,21,"PAH",239,1,112,0)=" Enter a '^' to abort the install."
^DIC(9.4,3,22,21,"PAH",239,1,113,0)=""
^DIC(9.4,3,22,21,"PAH",239,1,114,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,3,22,21,"PAH",239,1,115,0)="                ------------------------------"
^DIC(9.4,3,22,21,"PAH",240,0)="297 SEQ #248^3030603^1"
^DIC(9.4,3,22,21,"PAH",240,1,0)="^^95^95^3030603"
^DIC(9.4,3,22,21,"PAH",240,1,1,0)="XU*8.0*297"
^DIC(9.4,3,22,21,"PAH",240,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,3,0)="NOIS: PUG-0403-50483"
^DIC(9.4,3,22,21,"PAH",240,1,4,0)="Test Sites: Puget Sound HCS"
^DIC(9.4,3,22,21,"PAH",240,1,5,0)="Blood Bank Team Clearance: 4/11/03"
^DIC(9.4,3,22,21,"PAH",240,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,7,0)="This patch concerns the SPOOL DOCUMENT (#3.51) file."
^DIC(9.4,3,22,21,"PAH",240,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,9,0)="1. The length of the ""B"" xref on the NAME (#.01) field is increased from 30"
^DIC(9.4,3,22,21,"PAH",240,1,10,0)="to 63 characters so that more of the name appears when the user enters '?'"
^DIC(9.4,3,22,21,"PAH",240,1,11,0)="to get a list of spool documents when using option [XU-SPL-PRINT] Print A"
^DIC(9.4,3,22,21,"PAH",240,1,12,0)="Spool Document.  The post-init (POST^XU8P297) for this patch will kill"
^DIC(9.4,3,22,21,"PAH",240,1,13,0)="the existing ""B"" xref and reindex the NAME (#.01) field.  Here's the new DD"
^DIC(9.4,3,22,21,"PAH",240,1,14,0)="for that field.  Nothing's changed, except the size of the ""B"" xref."
^DIC(9.4,3,22,21,"PAH",240,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,16,0)="STANDARD DATA DICTIONARY #3.51 -- SPOOL DOCUMENT FILE"
^DIC(9.4,3,22,21,"PAH",240,1,17,0)="STORED IN ^XMB(3.51,"
^DIC(9.4,3,22,21,"PAH",240,1,18,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,3,22,21,"PAH",240,1,19,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,3,22,21,"PAH",240,1,20,0)="----------------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",240,1,21,0)="3.51,.01   NAME                   0;1 FREE TEXT (Required)"
^DIC(9.4,3,22,21,"PAH",240,1,22,0)="           INPUT TRANSFORM:  K:$L(X)>80!($L(X)<3)!'(X'?1P.E)!(X'?.ANP)!(X?1."
^DIC(9.4,3,22,21,"PAH",240,1,23,0)="                             2E1""-"".E) X"
^DIC(9.4,3,22,21,"PAH",240,1,24,0)="           LAST EDITED:      MAR 04, 1988 "
^DIC(9.4,3,22,21,"PAH",240,1,25,0)="           HELP-PROMPT:      Answer must be 3-80 characters in length, and "
^DIC(9.4,3,22,21,"PAH",240,1,26,0)="                             not look like a TERM. TYPE. "
^DIC(9.4,3,22,21,"PAH",240,1,27,0)="           DESCRIPTION:      This field holds the name of the spool"
^DIC(9.4,3,22,21,"PAH",240,1,28,0)="                             document.  To avoid device handler confusion,"
^DIC(9.4,3,22,21,"PAH",240,1,29,0)="                             the name of the spool document must not look"
^DIC(9.4,3,22,21,"PAH",240,1,30,0)="                             like the name of a terminal type, e.g. C-VT100,"
^DIC(9.4,3,22,21,"PAH",240,1,31,0)="                             since either name might be contained in a"
^DIC(9.4,3,22,21,"PAH",240,1,32,0)="                             response to the device prompt.  "
^DIC(9.4,3,22,21,"PAH",240,1,33,0)="           NOTES:            XXXX--CAN'T BE ALTERED EXCEPT BY PROGRAMMER"
^DIC(9.4,3,22,21,"PAH",240,1,34,0)="           CROSS-REFERENCE:  3.51^B "
^DIC(9.4,3,22,21,"PAH",240,1,35,0)="                             1)= S ^XMB(3.51,""B"",$E(X,1,63),DA)="""""
^DIC(9.4,3,22,21,"PAH",240,1,36,0)="                             2)= K ^XMB(3.51,""B"",$E(X,1,63),DA)"
^DIC(9.4,3,22,21,"PAH",240,1,37,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,38,0)="2. The print template [XU-ZISPL-USER] is altered so that the first 44 (up"
^DIC(9.4,3,22,21,"PAH",240,1,39,0)="from 20) characters of the spool document names are shown when using option"
^DIC(9.4,3,22,21,"PAH",240,1,40,0)="[XU-SPL-LIST] List Spool Documents.  During the install, you will see the"
^DIC(9.4,3,22,21,"PAH",240,1,41,0)="following message:"
^DIC(9.4,3,22,21,"PAH",240,1,42,0)=" The following Routines were created during this install:"
^DIC(9.4,3,22,21,"PAH",240,1,43,0)="     XUCT02"
^DIC(9.4,3,22,21,"PAH",240,1,44,0)="XUCT02 is the routine into which the print template is compiled."
^DIC(9.4,3,22,21,"PAH",240,1,45,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,46,0)="NOTE: This patch should be installed during off-hours, when a minimal number"
^DIC(9.4,3,22,21,"PAH",240,1,47,0)="of users are on the system.  It has no patch pre-requisites."
^DIC(9.4,3,22,21,"PAH",240,1,48,0)="============================================================================ "
^DIC(9.4,3,22,21,"PAH",240,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,50,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",240,1,51,0)="The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",240,1,52,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",240,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,54,0)="              Before          After"
^DIC(9.4,3,22,21,"PAH",240,1,55,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",240,1,56,0)="------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",240,1,57,0)="XU8P297        * new *           32940        297"
^DIC(9.4,3,22,21,"PAH",240,1,58,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",240,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,60,0)="This patch introduces routine ^XU8P297, which has no user entry points,"
^DIC(9.4,3,22,21,"PAH",240,1,61,0)="and will be deleted once it has run."
^DIC(9.4,3,22,21,"PAH",240,1,62,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",240,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",240,1,64,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",240,1,65,0)="NOTE: This patch should be installed during off-hours, when a minimal number"
^DIC(9.4,3,22,21,"PAH",240,1,66,0)="of users are on the system.  It has no patch pre-requisites."
^DIC(9.4,3,22,21,"PAH",240,1,67,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,3,22,21,"PAH",240,1,68,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,3,22,21,"PAH",240,1,69,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,3,22,21,"PAH",240,1,70,0)="3.  Users may be on the system.  You do not need to stop TaskMan."
^DIC(9.4,3,22,21,"PAH",240,1,71,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,3,22,21,"PAH",240,1,72,0)="    Transport Global:"
^DIC(9.4,3,22,21,"PAH",240,1,73,0)="       Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",240,1,74,0)="       Print Transport Global"
^DIC(9.4,3,22,21,"PAH",240,1,75,0)="       Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",240,1,76,0)="       Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",240,1,77,0)="       Install Package(s)"
^DIC(9.4,3,22,21,"PAH",240,1,78,0)=" Select INSTALL NAME:    XU*8.0*297    Loaded from Distribution  <date/time>"
^DIC(9.4,3,22,21,"PAH",240,1,79,0)="                         =========="
^DIC(9.4,3,22,21,"PAH",240,1,80,0)=" Install Questions for XU*8.0*297"
^DIC(9.4,3,22,21,"PAH",240,1,81,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,82,0)=" Incoming Files:"
^DIC(9.4,3,22,21,"PAH",240,1,83,0)="   3.51      SPOOL DOCUMENT  (Partial Definition)"
^DIC(9.4,3,22,21,"PAH",240,1,84,0)=" Note:  You already have the 'SPOOL DOCUMENT' File."
^DIC(9.4,3,22,21,"PAH",240,1,85,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,86,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",240,1,87,0)="                                                       =="
^DIC(9.4,3,22,21,"PAH",240,1,88,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",240,1,89,0)="                                                                       =="
^DIC(9.4,3,22,21,"PAH",240,1,90,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,3,22,21,"PAH",240,1,91,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,3,22,21,"PAH",240,1,92,0)=" Enter a '^' to abort the install."
^DIC(9.4,3,22,21,"PAH",240,1,93,0)=""
^DIC(9.4,3,22,21,"PAH",240,1,94,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,3,22,21,"PAH",240,1,95,0)="                ------------------------------"
^DIC(9.4,3,22,21,"PAH",241,0)="300 SEQ #249^3030603^1"
^DIC(9.4,3,22,21,"PAH",241,1,0)="^^120^120^3030603"
^DIC(9.4,3,22,21,"PAH",241,1,1,0)="XU*8.0*300"
^DIC(9.4,3,22,21,"PAH",241,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,3,0)="NOIS: NHM-0500-11955"
^DIC(9.4,3,22,21,"PAH",241,1,4,0)="Test Sites: Northampton, MA"
^DIC(9.4,3,22,21,"PAH",241,1,5,0)="Blood Bank Team Clearance: 5/1/2003"
^DIC(9.4,3,22,21,"PAH",241,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,7,0)="This patch concerns the PERSON CLASS (#200.05) subfile of the NEW PERSON"
^DIC(9.4,3,22,21,"PAH",241,1,8,0)="(#200) file."
^DIC(9.4,3,22,21,"PAH",241,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,10,0)="Sometimes, a user's PERSON CLASS history can look pretty confusing:"
^DIC(9.4,3,22,21,"PAH",241,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,12,0)="Person Class                        Effective        Expired"
^DIC(9.4,3,22,21,"PAH",241,1,13,0)=" Nursing Service                    OCT 1,1995       NOV 17,1998"
^DIC(9.4,3,22,21,"PAH",241,1,14,0)=" Nursing Service                    NOV 17,1998      APR 13,2000"
^DIC(9.4,3,22,21,"PAH",241,1,15,0)=" Nursing Service                    APR 13,2000      JUN 2,1998  <<problem"
^DIC(9.4,3,22,21,"PAH",241,1,16,0)=" Physician Assistants & Advanced Practice  JUN 2,1998  OCT 1,1995 <problem"
^DIC(9.4,3,22,21,"PAH",241,1,17,0)=" Physician Assistants & Advanced Practice  OCT 1,1995"
^DIC(9.4,3,22,21,"PAH",241,1,18,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,19,0)="1. The API $$GET^XUA4A72, given a person and a date, retrieves the active"
^DIC(9.4,3,22,21,"PAH",241,1,20,0)="class for that person on that date.  It can get confused when confronted"
^DIC(9.4,3,22,21,"PAH",241,1,21,0)="with problems such as those above, and return an error (no active class for"
^DIC(9.4,3,22,21,"PAH",241,1,22,0)="this person on this date) for 5/18/2000, for example.  This patch makes the"
^DIC(9.4,3,22,21,"PAH",241,1,23,0)="API a bit smarter.  It will return the last person class for 5/18/2000.  It"
^DIC(9.4,3,22,21,"PAH",241,1,24,0)="will return the same one (not the first one) for 11/1/1996."
^DIC(9.4,3,22,21,"PAH",241,1,25,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,26,0)="2. When a new PERSON CLASS record is added to the multiple, the expired date"
^DIC(9.4,3,22,21,"PAH",241,1,27,0)="of the previous one is set to the effective date of the new one.  If the"
^DIC(9.4,3,22,21,"PAH",241,1,28,0)="effective date of the new one is prior to the effective date of the previous"
^DIC(9.4,3,22,21,"PAH",241,1,29,0)="one, this results in records such as those marked ""problem"" above. To remedy"
^DIC(9.4,3,22,21,"PAH",241,1,30,0)="this, we add a simple check: If the Effective Date of the previous class is"
^DIC(9.4,3,22,21,"PAH",241,1,31,0)="greater than the Effective Date of the new class, then we set the Expired"
^DIC(9.4,3,22,21,"PAH",241,1,32,0)="Date of the previous class to be the same as its Effective Date."
^DIC(9.4,3,22,21,"PAH",241,1,33,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,34,0)="3. Patch XU*8*49 purportedly prevented you from adding a new PERSON CLASS"
^DIC(9.4,3,22,21,"PAH",241,1,35,0)="record with an effective date prior to the effective date of the previous"
^DIC(9.4,3,22,21,"PAH",241,1,36,0)="one.  It didn't work.  This patch does.  A new input transform on the"
^DIC(9.4,3,22,21,"PAH",241,1,37,0)="Effective Date (#2) field sees to it."
^DIC(9.4,3,22,21,"PAH",241,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,39,0)="STANDARD DATA DICTIONARY #200.05 -- PERSON CLASS SUB-FILE   "
^DIC(9.4,3,22,21,"PAH",241,1,40,0)="STORED IN ^VA(200,D0,""USC1"","
^DIC(9.4,3,22,21,"PAH",241,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,42,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,3,22,21,"PAH",241,1,43,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,3,22,21,"PAH",241,1,44,0)="----------------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",241,1,45,0)="200.05,2   Effective Date         0;2 DATE (Required)"
^DIC(9.4,3,22,21,"PAH",241,1,46,0)="           INPUT TRANSFORM:  N %DT,% S %DT=""EX"",%=$O(^VA(200,D0,""USC1"",DA),-"
^DIC(9.4,3,22,21,"PAH",241,1,47,0)="                             1) S:% %=$P($G(^(%,0)),U,2) S:% %DT(0)=% D ^%DT"
^DIC(9.4,3,22,21,"PAH",241,1,48,0)="                              S X=Y K:Y<1 X"
^DIC(9.4,3,22,21,"PAH",241,1,49,0)="           LAST EDITED:      APR 24, 2003"
^DIC(9.4,3,22,21,"PAH",241,1,50,0)="           HELP-PROMPT:      The date that this Person Class became"
^DIC(9.4,3,22,21,"PAH",241,1,51,0)="                             effective."
^DIC(9.4,3,22,21,"PAH",241,1,52,0)="           DESCRIPTION:      This field is trigger by adding a new person"
^DIC(9.4,3,22,21,"PAH",241,1,53,0)="                             class."
^DIC(9.4,3,22,21,"PAH",241,1,54,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,55,0)="           NOTES:            XXXX--CAN'T BE ALTERED EXCEPT BY PROGRAMMER"
^DIC(9.4,3,22,21,"PAH",241,1,56,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,57,0)="           CROSS-REFERENCE:  200.05^AD "
^DIC(9.4,3,22,21,"PAH",241,1,58,0)="                             1)= S ^VA(200,DA(1),""USC1"",""AD"",$E(X,1,30),DA)="""""
^DIC(9.4,3,22,21,"PAH",241,1,59,0)="                             2)= K ^VA(200,DA(1),""USC1"",""AD"",$E(X,1,30),DA)"
^DIC(9.4,3,22,21,"PAH",241,1,60,0)="                             3)= Don't Delete"
^DIC(9.4,3,22,21,"PAH",241,1,61,0)="                             This X-ref is by date and allows us to find the"
^DIC(9.4,3,22,21,"PAH",241,1,62,0)="                             most current entry in the file."
^DIC(9.4,3,22,21,"PAH",241,1,63,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,64,0)="           CROSS-REFERENCE:  200.05^AE^MUMPS"
^DIC(9.4,3,22,21,"PAH",241,1,65,0)="                             1)= D SET2^XUA4A72"
^DIC(9.4,3,22,21,"PAH",241,1,66,0)="                             2)= D KILL2^XUA4A72"
^DIC(9.4,3,22,21,"PAH",241,1,67,0)="                             3)= Special Trigger"
^DIC(9.4,3,22,21,"PAH",241,1,68,0)="                             This Special X-ref sets the Expiration date of"
^DIC(9.4,3,22,21,"PAH",241,1,69,0)="                             the previous person class entry to the current"
^DIC(9.4,3,22,21,"PAH",241,1,70,0)="                             record's Effective date."
^DIC(9.4,3,22,21,"PAH",241,1,71,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,72,0)="NOTE: This patch should be installed during off-hours, when a minimal number"
^DIC(9.4,3,22,21,"PAH",241,1,73,0)="of users are on the system.  It requires patch XU*8.0*222."
^DIC(9.4,3,22,21,"PAH",241,1,74,0)="============================================================================ "
^DIC(9.4,3,22,21,"PAH",241,1,75,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,76,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",241,1,77,0)="The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",241,1,78,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",241,1,79,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,80,0)="              Before          After"
^DIC(9.4,3,22,21,"PAH",241,1,81,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",241,1,82,0)="------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",241,1,83,0)="XUA4A72        4721844         4894947        27,49,74,132,222,300"
^DIC(9.4,3,22,21,"PAH",241,1,84,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",241,1,85,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,86,0)="This patch introduces no new routines."
^DIC(9.4,3,22,21,"PAH",241,1,87,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",241,1,88,0)=" "
^DIC(9.4,3,22,21,"PAH",241,1,89,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",241,1,90,0)="NOTE: This patch should be installed during off-hours, when a minimal number"
^DIC(9.4,3,22,21,"PAH",241,1,91,0)="of users are on the system.  It requires patch XU*8.0*222."
^DIC(9.4,3,22,21,"PAH",241,1,92,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,3,22,21,"PAH",241,1,93,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,3,22,21,"PAH",241,1,94,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,3,22,21,"PAH",241,1,95,0)="3.  Users may be on the system.  You do not need to stop TaskMan."
^DIC(9.4,3,22,21,"PAH",241,1,96,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,3,22,21,"PAH",241,1,97,0)="    Transport Global:"
^DIC(9.4,3,22,21,"PAH",241,1,98,0)="       Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",241,1,99,0)="       Print Transport Global"
^DIC(9.4,3,22,21,"PAH",241,1,100,0)="       Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",241,1,101,0)="       Backup a Transport Global"
