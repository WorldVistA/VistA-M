^DIC(9.4,4,22,1,"PAH",166,1,79,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",166,1,80,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",166,1,81,0)=" Select INSTALL NAME:    XM*7.1*194    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",166,1,82,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",166,1,83,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",166,1,84,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",166,1,85,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",166,1,86,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",166,1,87,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",166,1,88,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",166,1,89,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",166,1,90,0)=" Enter a '^' to abort the install."
