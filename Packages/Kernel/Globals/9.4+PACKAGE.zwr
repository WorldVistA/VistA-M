^DIC(9.4,4,22,2,"PAH",7,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",7,1,6,0)="The Transmission Queue History report produced by OPTION: Historical Queue"
^DIC(9.4,4,22,2,"PAH",7,1,7,0)="Data/Stats Report [XMQHIST] shows zero sent and received for every site."
^DIC(9.4,4,22,2,"PAH",7,1,8,0)="This patch fixes that."
^DIC(9.4,4,22,2,"PAH",7,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",7,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",7,1,11,0)="is at a minimum. It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",7,1,12,0)="be installed."
^DIC(9.4,4,22,2,"PAH",7,1,13,0)="============================================================================ "
