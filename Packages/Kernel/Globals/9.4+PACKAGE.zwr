^DIC(9.4,14,22,0)="^9.49I^5.9^1"
^DIC(9.4,14,22,5.9,0)="5.2^3051119^2960610"
^DIC(9.4,14,22,5.9,"PAH",0)="^9.4901^388^388"
^DIC(9.4,14,22,5.9,"PAH",1,0)="105 SEQ #78^2960611^1"
^DIC(9.4,14,22,5.9,"PAH",1,1,0)="^^2^2^2960611"
^DIC(9.4,14,22,5.9,"PAH",1,1,1,0)="This is patch LR*5.2*105 which will transport menus, data dictionary"
^DIC(9.4,14,22,5.9,"PAH",1,1,2,0)="changes, load modified routines and edit templates."
^DIC(9.4,14,22,5.9,"PAH",2,0)="100 SEQ #91^2960625^1"
^DIC(9.4,14,22,5.9,"PAH",2,1,0)="^^2^2^2960625"
^DIC(9.4,14,22,5.9,"PAH",2,1,1,0)="This is a patch to combine multiple alerts for Lab results.  It requires"
^DIC(9.4,14,22,5.9,"PAH",2,1,2,0)="the installation of patch OR*2.5*47."
^DIC(9.4,14,22,5.9,"PAH",3,0)="119 SEQ #94^2960715^1"
^DIC(9.4,14,22,5.9,"PAH",3,1,0)="^^58^58^2960715"
^DIC(9.4,14,22,5.9,"PAH",3,1,1,0)="Note: Patch LR*5.2*105 Must be installed BEFORE this patch is loaded."
^DIC(9.4,14,22,5.9,"PAH",3,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,3,0)="Patch Description:"
^DIC(9.4,14,22,5.9,"PAH",3,1,4,0)="Routine LRCAPV2 and LRCAPMA1 were exported in patch LR*5.2*105 with"
^DIC(9.4,14,22,5.9,"PAH",3,1,5,0)="incorrect second lines."
^DIC(9.4,14,22,5.9,"PAH",3,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,7,0)="Routines LRCAPAM3 and LRCAPAM4 corrects consolidated institutions Phase 3"
^DIC(9.4,14,22,5.9,"PAH",3,1,8,0)="and Phase 4 reports not recognizing site numbers which have alpha"
^DIC(9.4,14,22,5.9,"PAH",3,1,9,0)="characters as apart of the site number."
^DIC(9.4,14,22,5.9,"PAH",3,1,10,0)="NOIS # SEP-0496-60804"
^DIC(9.4,14,22,5.9,"PAH",3,1,11,0)="Reporting Site:        Sepulveda, Ca"
^DIC(9.4,14,22,5.9,"PAH",3,1,12,0)="Testing Site:  Sepulveda, Ca"
^DIC(9.4,14,22,5.9,"PAH",3,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,14,0)="LRCAPAM1 routine corrects BLOOD INVENTORY workload not being counted in"
^DIC(9.4,14,22,5.9,"PAH",3,1,15,0)="Non-Patient category for LMIP reports."
^DIC(9.4,14,22,5.9,"PAH",3,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,17,0)="LRCAPFDS routine corrects NULL SUBSCRIPT error occurs when the user"
^DIC(9.4,14,22,5.9,"PAH",3,1,18,0)="selects a WKLD CODE LAB SECTION that does not have any WKLD CODES"
^DIC(9.4,14,22,5.9,"PAH",3,1,19,0)="assigned."
^DIC(9.4,14,22,5.9,"PAH",3,1,20,0)="NOIS # DAY-0496-40011"
^DIC(9.4,14,22,5.9,"PAH",3,1,21,0)="Reporting Site:        Dayton, OH"
^DIC(9.4,14,22,5.9,"PAH",3,1,22,0)="Test Site(s)   Long Beach, CA"
^DIC(9.4,14,22,5.9,"PAH",3,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,24,0)="ROUTINE SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",3,1,25,0)="================="
^DIC(9.4,14,22,5.9,"PAH",3,1,26,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,27,0)=" Routine Name                  Before Patch    After Patch     Patch List"
^DIC(9.4,14,22,5.9,"PAH",3,1,28,0)="LRCAPAM1                       14052207        14337228       105,119"
^DIC(9.4,14,22,5.9,"PAH",3,1,29,0)="LRCAPAM3                       12790683        13513963        42,119"
^DIC(9.4,14,22,5.9,"PAH",3,1,30,0)="LRCAPAM4                       12581527        13198299        42,105,119"
^DIC(9.4,14,22,5.9,"PAH",3,1,31,0)="LRCAPFDS                        6562403         7918114        105,119"
^DIC(9.4,14,22,5.9,"PAH",3,1,32,0)="LRCAPMA1                        5952535         5952535        105,119"
^DIC(9.4,14,22,5.9,"PAH",3,1,33,0)="LRCAPV2                         8714919         8714919        105,119"
^DIC(9.4,14,22,5.9,"PAH",3,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,35,0)="Options Effected by Patch:"
^DIC(9.4,14,22,5.9,"PAH",3,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,37,0)="Edit or Print WKLD CODES [LR WKLD CODE EDIT PRINT]"
^DIC(9.4,14,22,5.9,"PAH",3,1,38,0)="PHASE 1: Move data from 64.1 to 67.9. [LR WKLD LMIP 1]"
^DIC(9.4,14,22,5.9,"PAH",3,1,39,0)="PHASE 3: Print of data to be sent to NDB. [LR WKLD LMIP 3]"
^DIC(9.4,14,22,5.9,"PAH",3,1,40,0)="PHASE 4: Create E-mail message for NDB. [LR WKLD LMIP 4]"
^DIC(9.4,14,22,5.9,"PAH",3,1,41,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,42,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",3,1,43,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",3,1,44,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,45,0)="Note: Patch LR*5.2*105 MUST be installed before this patch is installed."
^DIC(9.4,14,22,5.9,"PAH",3,1,46,0)="This patch also contains patches to patch LR*5.2*105."
^DIC(9.4,14,22,5.9,"PAH",3,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,48,0)="1. User may remain on the system."
^DIC(9.4,14,22,5.9,"PAH",3,1,49,0)="2. No options need be placed out of order."
^DIC(9.4,14,22,5.9,"PAH",3,1,50,0)="3. Install patch during non-peak hours."
^DIC(9.4,14,22,5.9,"PAH",3,1,51,0)="4. Laboratory specimens should not accessioned or verified during"
^DIC(9.4,14,22,5.9,"PAH",3,1,52,0)="   installation of the patch."
^DIC(9.4,14,22,5.9,"PAH",3,1,53,0)="5. Install this patch using Kernel Installation and Distribution System"
^DIC(9.4,14,22,5.9,"PAH",3,1,54,0)="   (KIDS)."
^DIC(9.4,14,22,5.9,"PAH",3,1,55,0)=" "
^DIC(9.4,14,22,5.9,"PAH",3,1,56,0)="NOIS List"
^DIC(9.4,14,22,5.9,"PAH",3,1,57,0)="NOIS # DAY-0496-40011"
^DIC(9.4,14,22,5.9,"PAH",3,1,58,0)="NOIS # SEP-0496-60804"
^DIC(9.4,14,22,5.9,"PAH",4,0)="125 SEQ #96^2960820^1"
^DIC(9.4,14,22,5.9,"PAH",4,1,0)="^^1^1^2960820"
^DIC(9.4,14,22,5.9,"PAH",4,1,1,0)="ARCHIVE NOT FINDING A PATIENT"
^DIC(9.4,14,22,5.9,"PAH",5,0)="127 SEQ #97^2960920^1"
^DIC(9.4,14,22,5.9,"PAH",5,1,0)="^^242^242^2960920"
^DIC(9.4,14,22,5.9,"PAH",5,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,2,0)="DESCRIPTION:"
^DIC(9.4,14,22,5.9,"PAH",5,1,3,0)="The primary purpose of this patch (LR*5.2*127) is to convert from"
^DIC(9.4,14,22,5.9,"PAH",5,1,4,0)="reporting Laboratory clinic stop codes, to reporting CPT codes for ordered"
^DIC(9.4,14,22,5.9,"PAH",5,1,5,0)="tests done on patients. The Laboratory Package will capture and send CPT"
^DIC(9.4,14,22,5.9,"PAH",5,1,6,0)="codes via PCE/API. There is an install deadline involved (10/1/96) in"
^DIC(9.4,14,22,5.9,"PAH",5,1,7,0)="order to support PCE functionality requirements."
^DIC(9.4,14,22,5.9,"PAH",5,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,9,0)="Creating links between file LABORATORY TEST (#60) and WKLD CODE (#64)"
^DIC(9.4,14,22,5.9,"PAH",5,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,11,0)="The National Laboratory File [LR7O 60-64] menu under the LIM workload menu"
^DIC(9.4,14,22,5.9,"PAH",5,1,12,0)="[LR LIM/WKLD] has options to link file Laboratory Test (#60) to WKLD CODE"
^DIC(9.4,14,22,5.9,"PAH",5,1,13,0)="(#64) file.  The options you will use are:"
^DIC(9.4,14,22,5.9,"PAH",5,1,14,0)="               Semi-automatic Linking of file 60 to 64 [LR7O 60-64 AUTO]"
^DIC(9.4,14,22,5.9,"PAH",5,1,15,0)="               Manual Linking of file 60 to 64 [LR7O 60-64 MANUAL] "
^DIC(9.4,14,22,5.9,"PAH",5,1,16,0)="  These options should be run in this order listed to reduce linking time."
^DIC(9.4,14,22,5.9,"PAH",5,1,17,0)="It may be beneficial to obtain a report of Laboratory Tests with Accession"
^DIC(9.4,14,22,5.9,"PAH",5,1,18,0)="and Verify WKLD CODES listed. Each of the above options has the capability"
^DIC(9.4,14,22,5.9,"PAH",5,1,19,0)="of producing this report."
^DIC(9.4,14,22,5.9,"PAH",5,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,21,0)="Coordinate the task of linking tests with the Laboratory LIM so it is"
^DIC(9.4,14,22,5.9,"PAH",5,1,22,0)="completed before the scheduled start of collection of CPT codes for"
^DIC(9.4,14,22,5.9,"PAH",5,1,23,0)="laboratory activity (October 1, 1996). Only those tests that can be"
^DIC(9.4,14,22,5.9,"PAH",5,1,24,0)="ordered by clinicians on patients need to be linked."
^DIC(9.4,14,22,5.9,"PAH",5,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,26,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,27,0)="This is the PCE/API patch which will be replacing the current method of"
^DIC(9.4,14,22,5.9,"PAH",5,1,28,0)="recording clinic stop codes with CPT codes. This patch creates several new"
^DIC(9.4,14,22,5.9,"PAH",5,1,29,0)="fields and one new file LAB NLT/CPT CODES (#64.81)."
^DIC(9.4,14,22,5.9,"PAH",5,1,30,0)="       1. A new field in LABORATORY TEST file(#60) named NATIONAL VA LAB"
^DIC(9.4,14,22,5.9,"PAH",5,1,31,0)="CODE (#64). This new field links orderable tests in file #60 with generic"
^DIC(9.4,14,22,5.9,"PAH",5,1,32,0)="WKLD CODES (a.k.a. NLT) (#64). Generic codes are those NLT codes ending in"
^DIC(9.4,14,22,5.9,"PAH",5,1,33,0)="four (4) zeros. Utilities (options) are provided for linking LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",5,1,34,0)="TEST (#60) file to WKLD CODE (#64) file. The new PCE/API uses this linkage"
^DIC(9.4,14,22,5.9,"PAH",5,1,35,0)="to determine what CPT codes should be passed to the PCE/API. Orderable"
^DIC(9.4,14,22,5.9,"PAH",5,1,36,0)="tests in LABORATORY TEST file should have a linkage to WKLD CODE."
^DIC(9.4,14,22,5.9,"PAH",5,1,37,0)="       2. Modified field PCE/VSIT ON (#615) in file LABORATORY SITE"
^DIC(9.4,14,22,5.9,"PAH",5,1,38,0)="(#69.9) will control which reporting method should used. Field"
^DIC(9.4,14,22,5.9,"PAH",5,1,39,0)="functionality change: The TRANSMIT CLINIC STOP CODES (#614) field in the"
^DIC(9.4,14,22,5.9,"PAH",5,1,40,0)="LABORATORY SITE (#69.9) file is no longer used to control reporting of"
^DIC(9.4,14,22,5.9,"PAH",5,1,41,0)="clinic stop codes. The PCE package has replaced the clinic stop codes with"
^DIC(9.4,14,22,5.9,"PAH",5,1,42,0)="CPT codes for each test collected. You should now use PCE/VSIT ON (#615)"
^DIC(9.4,14,22,5.9,"PAH",5,1,43,0)="in LABORATORY SITE (#69.9) file to control both clinic stop code and CPT"
^DIC(9.4,14,22,5.9,"PAH",5,1,44,0)="code transmission. Patch LR*5.2*127 automatically sets the PCE/VSIT ON"
^DIC(9.4,14,22,5.9,"PAH",5,1,45,0)="field to report both clinic stop and CPT codes. It is expected that"
^DIC(9.4,14,22,5.9,"PAH",5,1,46,0)="beginning with Oct. 1, 1996 VA DHCP will begin reporting workload using"
^DIC(9.4,14,22,5.9,"PAH",5,1,47,0)="CPT codes. Logic has been built into the software to determine when to"
^DIC(9.4,14,22,5.9,"PAH",5,1,48,0)="start reporting CPT codes to the PCE package. The TRANSMIT CLINIC STOP"
^DIC(9.4,14,22,5.9,"PAH",5,1,49,0)="CODES (#614) field will be retired in a future version."
^DIC(9.4,14,22,5.9,"PAH",5,1,50,0)="       3. A new field PCE COUNTED (#11) has been added to file LAB ORDER"
^DIC(9.4,14,22,5.9,"PAH",5,1,51,0)="ENTRY (#69). This field prevents an order from being counted more than"
^DIC(9.4,14,22,5.9,"PAH",5,1,52,0)="once."
^DIC(9.4,14,22,5.9,"PAH",5,1,53,0)="       4. The field CPT CODE (#18) has been modified in WKLD CODE"
^DIC(9.4,14,22,5.9,"PAH",5,1,54,0)="file(#64). This field's name has been changed to CODE and is a multiple."
^DIC(9.4,14,22,5.9,"PAH",5,1,55,0)="The CODE entries can be of different types. Each code has optional fields"
^DIC(9.4,14,22,5.9,"PAH",5,1,56,0)="of RELEASE DATE (#2) and INACTIVE DATE (#3). These fields can be used to"
^DIC(9.4,14,22,5.9,"PAH",5,1,57,0)="screen codes based on dates entered. There is another field REPLACEMENT"
^DIC(9.4,14,22,5.9,"PAH",5,1,58,0)="CODE (#4) which is used for local record keeping. The software logic does"
^DIC(9.4,14,22,5.9,"PAH",5,1,59,0)="not use the REPLACEMENT CODE field."
^DIC(9.4,14,22,5.9,"PAH",5,1,60,0)="       5. This patch also adds CPT codes to WKLD CODE FILE (#64) during"
^DIC(9.4,14,22,5.9,"PAH",5,1,61,0)="the post install phase."
^DIC(9.4,14,22,5.9,"PAH",5,1,62,0)="       6. Additional Fields have added to WKLD LOG FILE (#64.03). These"
^DIC(9.4,14,22,5.9,"PAH",5,1,63,0)="fields are not directly related to PCE/API. These fields are used to"
^DIC(9.4,14,22,5.9,"PAH",5,1,64,0)="support Laboratory Extract for DSS. Additional fields have been added to"
^DIC(9.4,14,22,5.9,"PAH",5,1,65,0)="WKLD LOG FILE (#64.03) to support laboratory extract of LMIP codes for"
^DIC(9.4,14,22,5.9,"PAH",5,1,66,0)="DSS. These files are not used by the Laboratory PCE/API. WKLD LOG FILE is"
^DIC(9.4,14,22,5.9,"PAH",5,1,67,0)="being upgraded to support DSS API and is used exclusively by DSS and there"
^DIC(9.4,14,22,5.9,"PAH",5,1,68,0)="is no direct user interaction. WKLD LOG FILE is a temporary storage file"
^DIC(9.4,14,22,5.9,"PAH",5,1,69,0)="for LMIP codes for DSS extracts. A new routine ,'LRCAPDSS' provides DSS"
^DIC(9.4,14,22,5.9,"PAH",5,1,70,0)="with a API to extract laboratory workload data in batch mode. If the site"
^DIC(9.4,14,22,5.9,"PAH",5,1,71,0)="is currently using WKLD LOG FILE for local purposes, this practice should"
^DIC(9.4,14,22,5.9,"PAH",5,1,72,0)="be terminated. WKLD LOG FILE IS USED EXCLUSIVELY TO SUPPORT DSS DATA"
^DIC(9.4,14,22,5.9,"PAH",5,1,73,0)="EXTRACTION."
^DIC(9.4,14,22,5.9,"PAH",5,1,74,0)="       7. This patch also contains a new file LAB NLT/CPT CODES (#64.81)."
^DIC(9.4,14,22,5.9,"PAH",5,1,75,0)="This file is only used to transport data to upgrade existing WKLD CODES"
^DIC(9.4,14,22,5.9,"PAH",5,1,76,0)="(NLT) test codes already released to the field. This file is used by the"
^DIC(9.4,14,22,5.9,"PAH",5,1,77,0)="Post Install routine to add CPT codes to WKLD CODE (#64) file. Entries are"
^DIC(9.4,14,22,5.9,"PAH",5,1,78,0)="automatically purged from 64.81 file if the linking process was"
^DIC(9.4,14,22,5.9,"PAH",5,1,79,0)="successful. If there is an error during the linking process, a message is"
^DIC(9.4,14,22,5.9,"PAH",5,1,80,0)="stored in #64.81 and the entry is not purge. A FileMan print of #64.81"
^DIC(9.4,14,22,5.9,"PAH",5,1,81,0)="file will display those codes which were not linked. If there are no"
^DIC(9.4,14,22,5.9,"PAH",5,1,82,0)="errors, file #64.81 will be empty after the post install routine runs to"
^DIC(9.4,14,22,5.9,"PAH",5,1,83,0)="completion."
^DIC(9.4,14,22,5.9,"PAH",5,1,84,0)="      Any new WKLD CODES released will already have assigned CPT Procedure"
^DIC(9.4,14,22,5.9,"PAH",5,1,85,0)="and are distributed via national releases of NLT package. CPT coding of"
^DIC(9.4,14,22,5.9,"PAH",5,1,86,0)="WKLD CODES is done by Health Administration Head Quarters and should not"
^DIC(9.4,14,22,5.9,"PAH",5,1,87,0)="be changed locally."
^DIC(9.4,14,22,5.9,"PAH",5,1,88,0)="      8 Option Edit or Print WKLD CODES [LR WKLD CODE EDIT PRINT] has been"
^DIC(9.4,14,22,5.9,"PAH",5,1,89,0)="enhanced to allow printing of WKLD CODES which have CPT code linkages."
^DIC(9.4,14,22,5.9,"PAH",5,1,90,0)="Modifications to routine LRCAPFDS provided this new functionality."
^DIC(9.4,14,22,5.9,"PAH",5,1,91,0)="     9. Routine LRCAPV1A has been modified to allow the user to enter a"
^DIC(9.4,14,22,5.9,"PAH",5,1,92,0)="synonym for newly created WKLD CODES using the option; 'Add a new WKLD"
^DIC(9.4,14,22,5.9,"PAH",5,1,93,0)="code to file [LRCAP CODE ADD]."
^DIC(9.4,14,22,5.9,"PAH",5,1,94,0)="     10. This patch contains a new routine LRCAPPH1 and the modified"
^DIC(9.4,14,22,5.9,"PAH",5,1,95,0)="routine LRCAPPH. These routines gather the needed data and creates the"
^DIC(9.4,14,22,5.9,"PAH",5,1,96,0)="PCE/API CPT linkage. 'LRCAPPH' has been change to look at the modified"
^DIC(9.4,14,22,5.9,"PAH",5,1,97,0)="field PCE/VSIT ON (#615) in file LABORATORY SITE file (#69.9) to determine"
^DIC(9.4,14,22,5.9,"PAH",5,1,98,0)="which reporting method should used. The user can inactivate reporting,"
^DIC(9.4,14,22,5.9,"PAH",5,1,99,0)="report only CPT codes or report both CPT and Clinic Stop Codes. There is"
^DIC(9.4,14,22,5.9,"PAH",5,1,100,0)="additional logic which determines if the PCE package is active. If the PCE"
^DIC(9.4,14,22,5.9,"PAH",5,1,101,0)="package is not active, no CPT codes will be passed regardless of the entry"
^DIC(9.4,14,22,5.9,"PAH",5,1,102,0)="in the PCE/VSIT ON field."
^DIC(9.4,14,22,5.9,"PAH",5,1,103,0)="      11.This patch provides utilities for linking ORDERABLE tests in"
^DIC(9.4,14,22,5.9,"PAH",5,1,104,0)="LABORATORY TEST (#60) file to WKLD CODE (#64) file. This linkage differs"
^DIC(9.4,14,22,5.9,"PAH",5,1,105,0)="from LMIP file setup. CPT Procedure coding is a rather non specific"
^DIC(9.4,14,22,5.9,"PAH",5,1,106,0)="identification of ORDERED tests. CPT codes identifies procedures ordered"
^DIC(9.4,14,22,5.9,"PAH",5,1,107,0)="by the provider. LMIP coding identifies procedures and method of analysis"
^DIC(9.4,14,22,5.9,"PAH",5,1,108,0)="used to collect management data. These coding system are used for two"
^DIC(9.4,14,22,5.9,"PAH",5,1,109,0)="different purposes and should not be confused."
^DIC(9.4,14,22,5.9,"PAH",5,1,110,0)="There are two routines which provide this functionality, LR7OU4 and"
^DIC(9.4,14,22,5.9,"PAH",5,1,111,0)="LR7OU5."
^DIC(9.4,14,22,5.9,"PAH",5,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,114,0)="Example of the Semi-automated option: "
^DIC(9.4,14,22,5.9,"PAH",5,1,115,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,116,0)="Select OPTION NAME:    LRMENU        Laboratory DHCP Menu"
^DIC(9.4,14,22,5.9,"PAH",5,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,118,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,119,0)="Select Laboratory DHCP Menu Option:  Supervisor menu"
^DIC(9.4,14,22,5.9,"PAH",5,1,120,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,121,0)="Select Supervisor menu Option:  Lab liaison menu"
^DIC(9.4,14,22,5.9,"PAH",5,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,123,0)="Select Lab liaison menu Option:  National Laboratory File"
^DIC(9.4,14,22,5.9,"PAH",5,1,124,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,125,0)="Select National Laboratory File Option: ?"
^DIC(9.4,14,22,5.9,"PAH",5,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,127,0)="   1      Semi-automatic Linking of file 60 to 64"
^DIC(9.4,14,22,5.9,"PAH",5,1,128,0)="   2      Manual Linking of file 60 to 64"
^DIC(9.4,14,22,5.9,"PAH",5,1,129,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,130,0)="Enter ?? for more options, ??? for brief descriptions, ?OPTION for help"
^DIC(9.4,14,22,5.9,"PAH",5,1,131,0)="text."
^DIC(9.4,14,22,5.9,"PAH",5,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,133,0)="Select National Laboratory File Option: 1  Semi-automatic Linking of file"
^DIC(9.4,14,22,5.9,"PAH",5,1,134,0)="60 to 64"
^DIC(9.4,14,22,5.9,"PAH",5,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,136,0)=" This option will look for potential matches between file 64 (NLT) and"
^DIC(9.4,14,22,5.9,"PAH",5,1,137,0)="file 60. "
^DIC(9.4,14,22,5.9,"PAH",5,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,139,0)="   You will be allowed to create a permanent link between matching entries"
^DIC(9.4,14,22,5.9,"PAH",5,1,140,0)="in these files. Tests with the type of NEITHER will be omitted during link"
^DIC(9.4,14,22,5.9,"PAH",5,1,141,0)="phase. "
^DIC(9.4,14,22,5.9,"PAH",5,1,142,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,143,0)="               ONLY GENERIC NLT CODES CAN BE LINKED TO LAB TEST"
^DIC(9.4,14,22,5.9,"PAH",5,1,144,0)="     "
^DIC(9.4,14,22,5.9,"PAH",5,1,145,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,146,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,147,0)="      Those LAB TEST already linked to the NLT file will also be omitted."
^DIC(9.4,14,22,5.9,"PAH",5,1,148,0)="     "
^DIC(9.4,14,22,5.9,"PAH",5,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,150,0)="Ready to proceed? YES"
^DIC(9.4,14,22,5.9,"PAH",5,1,151,0)="Would you like a list of WKLD CODES from LABORATORY TEST file? No// "
^DIC(9.4,14,22,5.9,"PAH",5,1,152,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,153,0)="     Do you want to automatically link entries when there is an exact"
^DIC(9.4,14,22,5.9,"PAH",5,1,154,0)="match     "
^DIC(9.4,14,22,5.9,"PAH",5,1,155,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,156,0)="                           on the NAME in both files"
^DIC(9.4,14,22,5.9,"PAH",5,1,157,0)="     "
^DIC(9.4,14,22,5.9,"PAH",5,1,158,0)="? No// Y"
^DIC(9.4,14,22,5.9,"PAH",5,1,159,0)="  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",5,1,160,0)=" "
^DIC(9.4,14,22,5.9,"PAH",5,1,161,0)="    Did not find a exact name match for Lab Test 1,25-DIHYDROXYVIT D3"
^DIC(9.4,14,22,5.9,"PAH",5,1,162,0)=" Want to use a Verify WKLD code instead?"
^DIC(9.4,14,22,5.9,"PAH",5,1,163,0)=" "
