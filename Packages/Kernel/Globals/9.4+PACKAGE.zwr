^DIC(9.4,4,22,1,"PAH",121,1,66,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",121,1,67,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",121,1,68,0)=" "
^DIC(9.4,4,22,1,"PAH",121,1,69,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",121,1,70,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",121,1,71,0)="is at a minimum.  It requires MailMan patches XM*7.1*140 and XM*7.1*142."
^DIC(9.4,4,22,1,"PAH",121,1,72,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",121,1,73,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",121,1,74,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",121,1,75,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",121,1,76,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",121,1,77,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,1,"PAH",121,1,78,0)="    but you should stop the background filer."
^DIC(9.4,4,22,1,"PAH",121,1,79,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",121,1,80,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",121,1,81,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",121,1,82,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",121,1,83,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",121,1,84,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",121,1,85,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",121,1,86,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",121,1,87,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",121,1,88,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",121,1,89,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",121,1,90,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",121,1,91,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",121,1,92,0)=" Select INSTALL NAME:    XM*7.1*150     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",121,1,93,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",121,1,94,0)=" Install Questions for XM*7.1*150"
^DIC(9.4,4,22,1,"PAH",121,1,95,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,96,0)=" Incoming Files:"
^DIC(9.4,4,22,1,"PAH",121,1,97,0)="   3.7       MAILBOX  (Partial Definition)"
^DIC(9.4,4,22,1,"PAH",121,1,98,0)=" Note:  You already have the 'MAILBOX' File."
^DIC(9.4,4,22,1,"PAH",121,1,99,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,100,0)="   3.9       MESSAGE  (Partial Definition)"
^DIC(9.4,4,22,1,"PAH",121,1,101,0)=" Note:  You already have the 'MESSAGE' File."
^DIC(9.4,4,22,1,"PAH",121,1,102,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,103,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",121,1,104,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",121,1,105,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",121,1,106,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",121,1,107,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",121,1,108,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",121,1,109,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",121,1,110,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,111,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,1,"PAH",121,1,112,0)="                ------------------"
^DIC(9.4,4,22,1,"PAH",121,1,113,0)="6.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",121,1,114,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",121,1,115,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",121,1,116,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",121,1,117,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",121,1,118,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
