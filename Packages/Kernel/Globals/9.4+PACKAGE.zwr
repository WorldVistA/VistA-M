^DIC(9.4,43,22,1,"PAH",7,1,54,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,43,22,1,"PAH",7,1,55,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,43,22,1,"PAH",7,1,56,0)=" Enter a '^' to abort the install."
^DIC(9.4,43,22,1,"PAH",7,1,57,0)=""
^DIC(9.4,43,22,1,"PAH",7,1,58,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,43,22,1,"PAH",7,1,59,0)="                ------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",7,1,60,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,43,22,1,"PAH",7,1,61,0)="==========================================================================="
