^DIC(9.4,181,22,1,"PAH",5,0)="5 SEQ #4^3011210^1"
^DIC(9.4,181,22,1,"PAH",6,0)="4 SEQ #5^3011210^1"
^DIC(9.4,181,22,1,"PAH",7,0)="8 SEQ #6^3020207^1"
^DIC(9.4,181,22,1,"PAH",8,0)="9 SEQ #7^3020408^1"
