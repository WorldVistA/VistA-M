^DIC(9.4,48,22,5.28,"PAH",712,1,26,0)="VSE-10472: TB - Remove the Initial of the Patient's Last Name and Last 4"
^DIC(9.4,48,22,5.28,"PAH",712,1,27,0)="                Numbers of their SSN from Scheduling Letters."
^DIC(9.4,48,22,5.28,"PAH",712,1,28,0)="VSE-10543: JJ - Modify the validation within create clinic availability "
^DIC(9.4,48,22,5.28,"PAH",712,1,29,0)="                to allow for a slot to be 0 if the stop code is 130"
^DIC(9.4,48,22,5.28,"PAH",712,1,30,0)="                EMERGENCY DEPT."
^DIC(9.4,48,22,5.28,"PAH",712,1,31,0)="VSE-10892: TW - VistA: Update SDEC logic that deals with creating a new"
^DIC(9.4,48,22,5.28,"PAH",712,1,32,0)="                contact attempt to use the SDES2 logic."
^DIC(9.4,48,22,5.28,"PAH",712,1,33,0)="VSE-10930: GW - VistA: Modify SDES2 CANCEL CLINIC AVAIL to strip out any"
^DIC(9.4,48,22,5.28,"PAH",712,1,34,0)="                control character if it is sent in as an input parameter"
^DIC(9.4,48,22,5.28,"PAH",712,1,35,0)="VSE-11000: MD - Update SDES2 CANCEL CLINIC AVAIL description."
^DIC(9.4,48,22,5.28,"PAH",712,1,36,0)="VSE-11002: HC - VistA: Modify SDES2 GET APPT RPCs to include the NonCount"
^DIC(9.4,48,22,5.28,"PAH",712,1,37,0)="                value in the clinic object."
^DIC(9.4,48,22,5.28,"PAH",712,1,38,0)="VSE-11058: BB - VistA: Modify SDES2 GET APPT REQ RPCs to get the MRTC "
^DIC(9.4,48,22,5.28,"PAH",712,1,39,0)="                PatientIndicatedDate from the child request, not the"
^DIC(9.4,48,22,5.28,"PAH",712,1,40,0)="                parents list."
^DIC(9.4,48,22,5.28,"PAH",712,1,41,0)=" "
