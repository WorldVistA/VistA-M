^DIC(9.4,14,22,5.9,"PAH",278,1,134,0)="New Service Requests (NSRs):"
^DIC(9.4,14,22,5.9,"PAH",278,1,135,0)="--------------------------------------------   "
^DIC(9.4,14,22,5.9,"PAH",278,1,136,0)="#20140511 "
^DIC(9.4,14,22,5.9,"PAH",278,1,137,0)="The Anatomic Pathology (AP) laboratory service needs a mechanism for "
^DIC(9.4,14,22,5.9,"PAH",278,1,138,0)="clinicians to provide required patient-specific, procedure-specific, and "
^DIC(9.4,14,22,5.9,"PAH",278,1,139,0)="specimen-specific information to facilitate specimen processing by "
^DIC(9.4,14,22,5.9,"PAH",278,1,140,0)="pathologists. This mechanism must be in place for use by the specimen "
^DIC(9.4,14,22,5.9,"PAH",278,1,141,0)="labeling application in order to generate a primary specimen label that "
^DIC(9.4,14,22,5.9,"PAH",278,1,142,0)="positively identifies the specimen and accurately associates it with the "
^DIC(9.4,14,22,5.9,"PAH",278,1,143,0)="patient."
^DIC(9.4,14,22,5.9,"PAH",278,1,144,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,145,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,14,22,5.9,"PAH",278,1,146,0)="---------------------------------------"
