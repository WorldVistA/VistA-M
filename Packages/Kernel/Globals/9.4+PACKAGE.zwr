^DIC(9.4,151,22,1,"PAH",136,1,1,0)="See Patch Description."
^DIC(9.4,151,22,1,"PAH",137,0)="155^3210920.131335^17"
^DIC(9.4,151,22,1,"PAH",137,1,0)="^^9^9^3210920"
^DIC(9.4,151,22,1,"PAH",137,1,1,0)="This patch, EC*2.0*155, inactivates any DSS Units in the DSS UNIT "
^DIC(9.4,151,22,1,"PAH",137,1,2,0)="(#724) file with the SEND TO PCE (#13) field set to 'Send No Records'  "
^DIC(9.4,151,22,1,"PAH",137,1,3,0)="and have an inactive/invalid Stop Code."
^DIC(9.4,151,22,1,"PAH",137,1,4,0)=" "
^DIC(9.4,151,22,1,"PAH",137,1,5,0)="This patch is being released along with patch SD*5.3*787, that provides"
^DIC(9.4,151,22,1,"PAH",137,1,6,0)="provides Fiscal Year 2022 updates to the CLINIC STOP (#40.7) file. When"
^DIC(9.4,151,22,1,"PAH",137,1,7,0)="inactivating stop codes in CLINIC STOP (#40.7) file, the DSS UNIT (#724) "
^DIC(9.4,151,22,1,"PAH",137,1,8,0)="file also needs to be updated. Both patches will be bundled together"
^DIC(9.4,151,22,1,"PAH",137,1,9,0)="with the Scheduling patch being the primary."
^DIC(9.4,151,22,1,"PAH",138,0)="154 SEQ #148^3210929.145014^17"
^DIC(9.4,151,22,1,"PAH",138,1,0)="^^2^2^3210929"
^DIC(9.4,151,22,1,"PAH",138,1,1,0)="This patch updates twenty one (21) procedure codes to reflect Fiscal Year "
^DIC(9.4,151,22,1,"PAH",138,1,2,0)="2022 changes, effective October 1, 2021. "
^DIC(9.4,151,22,1,"PAH",139,0)="156 SEQ #149^3220613.152822^86"
^DIC(9.4,151,22,1,"PAH",140,0)="158 SEQ #150^3220919.16265^90"
^DIC(9.4,151,22,1,"PAH",141,0)="157 SEQ #151^3220927.153055^90"
^DIC(9.4,151,22,1,"PAH",141,1,0)="^^3^3^3220927"
^DIC(9.4,151,22,1,"PAH",141,1,1,0)="This patch updates twenty-two (22) procedure codes in the EC NATIONAL "
^DIC(9.4,151,22,1,"PAH",141,1,2,0)="PROCEDURE FILE (#725) to reflect Fiscal Year 2023 changes, effective"
^DIC(9.4,151,22,1,"PAH",141,1,3,0)="October 1, 2022. "
^DIC(9.4,151,22,1,"PAH",142,0)="160 SEQ #152^3221110.091607^89"
^DIC(9.4,151,22,1,"PAH",142,1,0)="^^7^7^3221110"
^DIC(9.4,151,22,1,"PAH",142,1,1,0)="The patch addresses two (2) issues: "
^DIC(9.4,151,22,1,"PAH",142,1,2,0)=" "
^DIC(9.4,151,22,1,"PAH",142,1,3,0)="1.  This patch corrects the Name for 2 EC National Numbers that were "
^DIC(9.4,151,22,1,"PAH",142,1,4,0)="updated  by EC*2.0*157."
^DIC(9.4,151,22,1,"PAH",142,1,5,0)=" "
^DIC(9.4,151,22,1,"PAH",142,1,6,0)="2.  It changes 2 CPT codes for 2 EC National Numbers that were "
^DIC(9.4,151,22,1,"PAH",142,1,7,0)="unavailable for the 2023 EC National Procedure file (#725) update."
^DIC(9.4,151,22,1,"PAH",143,0)="161 SEQ #153^3230201.160236^89"
^DIC(9.4,151,22,1,"PAH",143,1,0)="^^1^1^3230201"
^DIC(9.4,151,22,1,"PAH",143,1,1,0)="See patch description."
^DIC(9.4,151,22,1,"PAH",144,0)="159 SEQ #154^3230627.141324^89"
^DIC(9.4,151,22,1,"PAH",144,1,0)="^^1^1^3230627"
^DIC(9.4,151,22,1,"PAH",144,1,1,0)="Event Capture FY23 Sustainment."
^DIC(9.4,151,22,1,"PAH",145,0)="162 SEQ #155^3231003.102313^89"
^DIC(9.4,151,22,1,"PAH",145,1,0)="^^2^2^3231003"
^DIC(9.4,151,22,1,"PAH",145,1,1,0)="This patch updates eleven (11) procedure codes to reflect Fiscal Year "
^DIC(9.4,151,22,1,"PAH",145,1,2,0)="2024 changes, effective October 1, 2023."
^DIC(9.4,151,22,1,"PAH",146,0)="163 SEQ #156^3231003.102739^89"
^DIC(9.4,151,22,1,"PAH",146,1,0)="^^9^9^3231003"
^DIC(9.4,151,22,1,"PAH",146,1,1,0)="Patch EC*2.0*163 inactivates any DSS UNIT (#724) file record with the SEND"
^DIC(9.4,151,22,1,"PAH",146,1,2,0)="TO PCE (#13) field set to 'Send No Records' and have an inactive/invalid"
^DIC(9.4,151,22,1,"PAH",146,1,3,0)="Stop Code."
^DIC(9.4,151,22,1,"PAH",146,1,4,0)=" "
^DIC(9.4,151,22,1,"PAH",146,1,5,0)="This patch is being released along with patch SD*5.3*856, that provides"
^DIC(9.4,151,22,1,"PAH",146,1,6,0)="Fiscal Year 2024 updates to the CLINIC STOP (#40.7) file. When"
^DIC(9.4,151,22,1,"PAH",146,1,7,0)="inactivating stop codes in CLINIC STOP (#40.7) file, the DSS UNIT (#724) "
^DIC(9.4,151,22,1,"PAH",146,1,8,0)="file also needs to be updated. Patch SD*5.3*856 will need to be installed"
^DIC(9.4,151,22,1,"PAH",146,1,9,0)="prior to patch EC*2.0*163."
^DIC(9.4,151,22,1,"PAH",147,0)="164 SEQ #157^3231016.14292^89"
^DIC(9.4,151,22,1,"PAH",147,1,0)="^^1^1^3231016"
