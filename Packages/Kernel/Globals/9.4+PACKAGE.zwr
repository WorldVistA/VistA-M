^DIC(9.4,47,22,5.9,"PAH",565,0)="733 SEQ #652^3070627.213758^1"
^DIC(9.4,47,22,5.9,"PAH",565,1,0)="^^1^1^3070627"
^DIC(9.4,47,22,5.9,"PAH",565,1,1,0)="TRIGGER FOR 1010EZ COMBAT AFTER 11/11/98"
