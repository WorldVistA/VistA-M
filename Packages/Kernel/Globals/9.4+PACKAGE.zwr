^DIC(9.4,49,22,10,"PAH",341,1,1,0)="Update Stop Codes to reflect Fiscal Year 2010 Supplemental changes as "
^DIC(9.4,49,22,10,"PAH",341,1,2,0)="well as Fiscal Year 2011 Midyear changes."
^DIC(9.4,49,22,10,"PAH",342,0)="445 SEQ #411^3110228.102146^17"
^DIC(9.4,49,22,10,"PAH",342,1,0)="^^1^1^3110228"
^DIC(9.4,49,22,10,"PAH",342,1,1,0)="Reasonable Charges v3.7"
^DIC(9.4,49,22,10,"PAH",343,0)="404 SEQ #412^3110308.134814^17"
^DIC(9.4,49,22,10,"PAH",343,1,0)="^^4^4^3110308"
^DIC(9.4,49,22,10,"PAH",343,1,1,0)="This patch will a include change to routine IBBFAPI (Insurance API "
^DIC(9.4,49,22,10,"PAH",343,1,2,0)="$$INSUR^IBBAPI) and IBBDOC to add two new additional fields from "
^DIC(9.4,49,22,10,"PAH",343,1,3,0)="Insurance Company file (#36). These fields are the STREET ADDRESS [LINE "
^DIC(9.4,49,22,10,"PAH",343,1,4,0)="2] and STREET ADDRESS [LINE 3]."
^DIC(9.4,49,22,10,"PAH",344,0)="443 SEQ #413^3110317.100811^17"
^DIC(9.4,49,22,10,"PAH",344,1,0)="^^2^2^3110317"
^DIC(9.4,49,22,10,"PAH",344,1,1,0)="This patch contains updates to the MCCR Utility (#399.1) file, the Revenue"
^DIC(9.4,49,22,10,"PAH",344,1,2,0)="Code (#399.2) file and the Place of Service (#353.1) file."
^DIC(9.4,49,22,10,"PAH",345,0)="450 SEQ #414^3110330.111502^17"
^DIC(9.4,49,22,10,"PAH",345,1,0)="^^2^2^3110330"
^DIC(9.4,49,22,10,"PAH",345,1,1,0)="This patch modifies DSS Stop Codes contained in the Integrated Billing "
^DIC(9.4,49,22,10,"PAH",345,1,2,0)="Clinic Stop Code Billable Type file <#352.5>."
^DIC(9.4,49,22,10,"PAH",346,0)="433 SEQ #415^3110526.111706^17"
^DIC(9.4,49,22,10,"PAH",346,1,0)="^^1^1^3110526"
^DIC(9.4,49,22,10,"PAH",346,1,1,0)="E-billing Iteration 4, Enhancement 6:  Preserve Claim Number"
^DIC(9.4,49,22,10,"PAH",347,0)="453 SEQ #416^3110810.14375^17"
^DIC(9.4,49,22,10,"PAH",347,1,0)="^^1^1^3110810"
^DIC(9.4,49,22,10,"PAH",347,1,1,0)="FY 2012 DSS STOP CODE UPDATES"
^DIC(9.4,49,22,10,"PAH",348,0)="438 SEQ #417^3110826.093628^17"
^DIC(9.4,49,22,10,"PAH",349,0)="431^3110901.101423^17"
^DIC(9.4,49,22,10,"PAH",349,1,0)="^^1^1^3110901"
^DIC(9.4,49,22,10,"PAH",349,1,1,0)="FMS 5010 CHANGES"
^DIC(9.4,49,22,10,"PAH",350,0)="449^3110919.111546^17"
^DIC(9.4,49,22,10,"PAH",350,1,0)="^^1^1^3110919"
^DIC(9.4,49,22,10,"PAH",350,1,1,0)="CD PATIENT COPAY EXEMPTION"
^DIC(9.4,49,22,10,"PAH",351,0)="432 SEQ #421^3111026.113303^17"
^DIC(9.4,49,22,10,"PAH",352,0)="418 SEQ #422^3111102.120153^17"
^DIC(9.4,49,22,10,"PAH",352,1,0)="^^2^2^3111102"
^DIC(9.4,49,22,10,"PAH",352,1,1,0)="This patch will install the Tortiously Liable, Cost-Based and Interagency"
^DIC(9.4,49,22,10,"PAH",352,1,2,0)="rates into the Charge Master, with an effective date of 07/11/2011."
^DIC(9.4,49,22,10,"PAH",353,0)="435^3111102.120245^17"
^DIC(9.4,49,22,10,"PAH",353,1,0)="^^1^1^3111102"
^DIC(9.4,49,22,10,"PAH",353,1,1,0)="ePharmacy Phase 5 - NCPDP D.0"
^DIC(9.4,49,22,10,"PAH",354,0)="460 SEQ #424^3111129.163046^17"
^DIC(9.4,49,22,10,"PAH",354,1,0)="^^3^3^3111129"
^DIC(9.4,49,22,10,"PAH",354,1,1,0)="This patch is about the administrative charge update based on a new"
^DIC(9.4,49,22,10,"PAH",354,1,2,0)="dispensing fee $12.39 for third party pharmacy prescription claims with"
^DIC(9.4,49,22,10,"PAH",354,1,3,0)="an effective date of January 1st, 2012."
^DIC(9.4,49,22,10,"PAH",355,0)="462 SEQ #425^3111214.134331^17"
^DIC(9.4,49,22,10,"PAH",355,1,0)="^^1^1^3111214"
^DIC(9.4,49,22,10,"PAH",355,1,1,0)="Reasonable Charges v3.8"
^DIC(9.4,49,22,10,"PAH",356,0)="465^3111215.125541^17"
^DIC(9.4,49,22,10,"PAH",357,0)="467 SEQ #427^3120111.135958^17"
^DIC(9.4,49,22,10,"PAH",358,0)="455 SEQ #428^3120112.140555^17"
^DIC(9.4,49,22,10,"PAH",358,1,0)="^^6^6^3120112"
^DIC(9.4,49,22,10,"PAH",358,1,1,0)="This patch contains two issues. The first issue is about the unit price"
^DIC(9.4,49,22,10,"PAH",358,1,2,0)="of the drug cost with zero resulting in an error message of 'Not ECME"
^DIC(9.4,49,22,10,"PAH",358,1,3,0)="Billable: Cannot find price for Item'. This error message prevents"
^DIC(9.4,49,22,10,"PAH",358,1,4,0)="IB from generating third party bills for outpatient prescriptions. The"
^DIC(9.4,49,22,10,"PAH",358,1,5,0)="second issue concerns payment amounts on e-Pharmacy claims which are more"
^DIC(9.4,49,22,10,"PAH",358,1,6,0)="than the billed amounts."
^DIC(9.4,49,22,10,"PAH",359,0)="451 SEQ #429^3120112.140603^17"
^DIC(9.4,49,22,10,"PAH",359,1,0)="^^2^2^3120112"
^DIC(9.4,49,22,10,"PAH",359,1,1,0)="This patch addresses system enhancements to the Integrated Billing "
^DIC(9.4,49,22,10,"PAH",359,1,2,0)="software as requested by the VA's Chief Business Office (CBO)."
^DIC(9.4,49,22,10,"PAH",360,0)="466 SEQ #430^3120126.122727^17"
^DIC(9.4,49,22,10,"PAH",360,1,0)="^^1^1^3120126"
^DIC(9.4,49,22,10,"PAH",360,1,1,0)="FY2012 MIDYEAR DSS STOP CODE UPDATES"
^DIC(9.4,49,22,10,"PAH",361,0)="452^3120216.140025^17"
^DIC(9.4,49,22,10,"PAH",361,1,0)="^^1^1^3120216"
^DIC(9.4,49,22,10,"PAH",361,1,1,0)="ePharmacy Phase 6"
^DIC(9.4,49,22,10,"PAH",362,0)="447^3120221.144213^17"
^DIC(9.4,49,22,10,"PAH",362,1,0)="^^276^276^3120221"
^DIC(9.4,49,22,10,"PAH",362,1,1,0)="This Integrated Billing (IB) patch expands the HIPAA 5010 enhancements "
^DIC(9.4,49,22,10,"PAH",362,1,2,0)="introduced in patch IB*2.0*432."
^DIC(9.4,49,22,10,"PAH",362,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,4,0)="The intent of this patch is to:"
^DIC(9.4,49,22,10,"PAH",362,1,5,0)="     1. Add new fields to the Enter/Edit Billing Information option [IB"
^DIC(9.4,49,22,10,"PAH",362,1,6,0)="        EDIT BILLING INFO] to allow users to enter additional data"
^DIC(9.4,49,22,10,"PAH",362,1,7,0)="        elements to claims for health care services provided to patients."
^DIC(9.4,49,22,10,"PAH",362,1,8,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,9,0)="     2. Modify the logic which calculates what the monetary amounts that "
^DIC(9.4,49,22,10,"PAH",362,1,10,0)="        were bill to the secondary payers on the MRA Statistics Report"
^DIC(9.4,49,22,10,"PAH",362,1,11,0)="        option [IBCEM MRA STATISTICS REPORT]."
^DIC(9.4,49,22,10,"PAH",362,1,12,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,13,0)="     3. Modify the outbound 837 Heath Care Claims transmissions to "
^DIC(9.4,49,22,10,"PAH",362,1,14,0)="        incorporate the additional/modified data elements that may be"
^DIC(9.4,49,22,10,"PAH",362,1,15,0)="        added to a claim."
^DIC(9.4,49,22,10,"PAH",362,1,16,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,17,0)="     4. Modify the printing process for outpatient, UB04 claims to print "
^DIC(9.4,49,22,10,"PAH",362,1,18,0)="        the Priority (Type) of Admission."
^DIC(9.4,49,22,10,"PAH",362,1,19,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,20,0)="     5. Modify the printing process for UB04 and CMS-1500 claims to allow "
^DIC(9.4,49,22,10,"PAH",362,1,21,0)="        the printing of Revenue/Procedure codes with zero dollar amounts."
^DIC(9.4,49,22,10,"PAH",362,1,22,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,23,0)="     6. Modify The Insurance Company Enter/Edit option [IBCN INSURANCE CO "
^DIC(9.4,49,22,10,"PAH",362,1,24,0)="        EDIT] to allow users to assign additional MEDIGAP policies as Type"
^DIC(9.4,49,22,10,"PAH",362,1,25,0)="        of Plan for an Insurance Company."
^DIC(9.4,49,22,10,"PAH",362,1,26,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,27,0)="     7. Create a new option called the Non-MRA Productivity Report option "
^DIC(9.4,49,22,10,"PAH",362,1,28,0)="        [IBCEM NON-MRA REPORT]."
^DIC(9.4,49,22,10,"PAH",362,1,29,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,30,0)="     8. Modify the mnemonic for the Third Party Billing Menu [IB THIRD "
^DIC(9.4,49,22,10,"PAH",362,1,31,0)="        PARTY BILLING MENU]."
^DIC(9.4,49,22,10,"PAH",362,1,32,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,33,0)="     9. Modify the Insurance Payment Trend Report option [IB OUTPUT TREND "
^DIC(9.4,49,22,10,"PAH",362,1,34,0)="        REPORT] to display the Insurance Plan Group Number."
^DIC(9.4,49,22,10,"PAH",362,1,35,0)=" "
^DIC(9.4,49,22,10,"PAH",362,1,36,0)="     10. Modify the Correct a Rejected/Denied Bill option [IB CORRECT "
^DIC(9.4,49,22,10,"PAH",362,1,37,0)="         REJECTED/DENIED] to allow the correction of claims to"
^DIC(9.4,49,22,10,"PAH",362,1,38,0)="         non-accruing funds such as TRICARE claims."
^DIC(9.4,49,22,10,"PAH",362,1,39,0)=" "
