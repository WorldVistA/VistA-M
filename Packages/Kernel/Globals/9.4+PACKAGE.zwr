^DIC(9.4,114,22,30,"PAH",118,1,282,0)="           Unload a Distribution"
^DIC(9.4,114,22,30,"PAH",118,1,283,0)="           Backup a Transport Global"
^DIC(9.4,114,22,30,"PAH",118,1,284,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,285,0)="      Select Installation Option:"
^DIC(9.4,114,22,30,"PAH",118,1,286,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,287,0)="  3.  LOAD TRANSPORT GLOBAL FOR MULTI-BUILD"
^DIC(9.4,114,22,30,"PAH",118,1,288,0)="      -------------------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,289,0)="      From the Installation menu, select the Load a Distribution option."
^DIC(9.4,114,22,30,"PAH",118,1,290,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,291,0)="      When prompted for ""Enter a Host File:"" Enter the full directory path"
^DIC(9.4,114,22,30,"PAH",118,1,292,0)="      where you saved the host file NEWBORN_1_2_DG_FB_IB.KID"
^DIC(9.4,114,22,30,"PAH",118,1,293,0)="      (e.g., SYS$SYSDEVICE:[ANONYMOUS]NEWBORN_1_2_DG_FB_IB.KID)"
^DIC(9.4,114,22,30,"PAH",118,1,294,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,295,0)="  When prompted for ""OK to continue with Load? NO//"", Enter ""YES."""
^DIC(9.4,114,22,30,"PAH",118,1,296,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,297,0)="      The following will display:"
^DIC(9.4,114,22,30,"PAH",118,1,298,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,299,0)="        Loading Distribution..."
^DIC(9.4,114,22,30,"PAH",118,1,300,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,301,0)="     NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,114,22,30,"PAH",118,1,302,0)="     DG*5.3*867"
^DIC(9.4,114,22,30,"PAH",118,1,303,0)="     FB*3.5*146"
^DIC(9.4,114,22,30,"PAH",118,1,304,0)="     IB*2.0*499"
^DIC(9.4,114,22,30,"PAH",118,1,305,0)="     Use INSTALL NAME: NEWBORN DG FB IB BUNDLE 1.0 to install this"
^DIC(9.4,114,22,30,"PAH",118,1,306,0)=" distribution."
^DIC(9.4,114,22,30,"PAH",118,1,307,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,308,0)="  4.  RUN OPTIONAL INSTALLATION OPTIONS FOR MULTI-BUILD"
^DIC(9.4,114,22,30,"PAH",118,1,309,0)="      -------------------------------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,310,0)="      From the Installation menu, you may select to use the following options"
^DIC(9.4,114,22,30,"PAH",118,1,311,0)=" (when prompted for the INSTALL NAME, enter NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,114,22,30,"PAH",118,1,312,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,313,0)="      a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,114,22,30,"PAH",118,1,314,0)="          message of any routines exported with this patch. It will not"
^DIC(9.4,114,22,30,"PAH",118,1,315,0)="          backup any other changes such as data dictionaries or templates."
^DIC(9.4,114,22,30,"PAH",118,1,316,0)="      b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,114,22,30,"PAH",118,1,317,0)="          allow you to view all changes that will be made when this patch"
^DIC(9.4,114,22,30,"PAH",118,1,318,0)="          is installed.  It compares all components of this patch"
^DIC(9.4,114,22,30,"PAH",118,1,319,0)="          (routines, data dictionaries, templates, etc.)."
^DIC(9.4,114,22,30,"PAH",118,1,320,0)="      c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,114,22,30,"PAH",118,1,321,0)="          you to ensure the integrity of the routines that are in the"
^DIC(9.4,114,22,30,"PAH",118,1,322,0)="          transport global."
^DIC(9.4,114,22,30,"PAH",118,1,323,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,324,0)="  5.  INSTALL MULTI-BUILD"
^DIC(9.4,114,22,30,"PAH",118,1,325,0)="      -------------------"
^DIC(9.4,114,22,30,"PAH",118,1,326,0)="    This is the step to start the installation of this KIDS patch.  This will"
^DIC(9.4,114,22,30,"PAH",118,1,327,0)="    need to be run for the NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,114,22,30,"PAH",118,1,328,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,329,0)="     a.  Choose the Install Package(s) option to start the patch"
^DIC(9.4,114,22,30,"PAH",118,1,330,0)="          install."
^DIC(9.4,114,22,30,"PAH",118,1,331,0)="     b.  When prompted for the ""Select INSTALL NAME:"" enter"
^DIC(9.4,114,22,30,"PAH",118,1,332,0)="           NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,114,22,30,"PAH",118,1,333,0)="     c.  When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,114,22,30,"PAH",118,1,334,0)="          NO//"", answer NO"
^DIC(9.4,114,22,30,"PAH",118,1,335,0)="     d.  When prompted ""Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,114,22,30,"PAH",118,1,336,0)="          and Protocols? NO//"", answer NO"
^DIC(9.4,114,22,30,"PAH",118,1,337,0)="     e.  When prompted ""Device: HOME//"", enter HOME"
^DIC(9.4,114,22,30,"PAH",118,1,338,0)="          to display the Install message on the screen (or enter the device"
^DIC(9.4,114,22,30,"PAH",118,1,339,0)="          you want to print the Install message). You may queue the"
^DIC(9.4,114,22,30,"PAH",118,1,340,0)="          install if you wish."
^DIC(9.4,114,22,30,"PAH",118,1,341,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,342,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,343,0)=" Post-Installation Instructions"
^DIC(9.4,114,22,30,"PAH",118,1,344,0)=" ------------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,345,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,346,0)=" *** IMPORTANT NOTE ***"
^DIC(9.4,114,22,30,"PAH",118,1,347,0)=" Please note there are three post installation routines that may be deleted"
^DIC(9.4,114,22,30,"PAH",118,1,348,0)=" after successful installation of the NEWBORN DG FB IB BUNDLE 1.0. These are:"
^DIC(9.4,114,22,30,"PAH",118,1,349,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,350,0)=" DG867PO"
^DIC(9.4,114,22,30,"PAH",118,1,351,0)=" FB146PO"
^DIC(9.4,114,22,30,"PAH",118,1,352,0)=" IB499PO"
^DIC(9.4,114,22,30,"PAH",119,0)="148 SEQ #124^3140129.10231^17"
^DIC(9.4,114,22,30,"PAH",119,1,0)="^^4^4^3140129"
^DIC(9.4,114,22,30,"PAH",119,1,1,0)="This Patch Addresses 1 issue:"
^DIC(9.4,114,22,30,"PAH",119,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",119,1,3,0)="1. The error ""<UNDEFINED>ANC+8^FBPCR67"" occurs when running "
^DIC(9.4,114,22,30,"PAH",119,1,4,0)="   the Potential Cost Recovery Report [FB PRC]."
^DIC(9.4,114,22,30,"PAH",120,0)="127 SEQ #125^3140416.16363^17"
^DIC(9.4,114,22,30,"PAH",120,1,0)="^^5^5^3140416"
^DIC(9.4,114,22,30,"PAH",120,1,1,0)="This patch addresses the following:"
^DIC(9.4,114,22,30,"PAH",120,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",120,1,3,0)="- Blank MRAs are being transmitted to Central Fee"
^DIC(9.4,114,22,30,"PAH",120,1,4,0)="- The low batch warning message is being triggered too late."
^DIC(9.4,114,22,30,"PAH",120,1,5,0)="- The calculation for batches remaining is incorrect."
^DIC(9.4,114,22,30,"PAH",121,0)="143 SEQ #126^3140917.095329^17"
^DIC(9.4,114,22,30,"PAH",121,1,0)="^^9^9^3140917"
^DIC(9.4,114,22,30,"PAH",121,1,1,0)="This patch addresses the following:"
^DIC(9.4,114,22,30,"PAH",121,1,2,0)="- Modifies logic when applying the ""Mill-Bill"" claims 70% reduction when "
^DIC(9.4,114,22,30,"PAH",121,1,3,0)="  local fee schedule (75th percentile) rates are used."
^DIC(9.4,114,22,30,"PAH",121,1,4,0)="- Changes the fee program for ancillary payments entered using [FBCH"
^DIC(9.4,114,22,30,"PAH",121,1,5,0)="   MULTIPLE PAYMENTS] option from ""outpatient"" to ""civil hospital"""
^DIC(9.4,114,22,30,"PAH",121,1,6,0)="- Modifies the sort and print routines for Veteran Payment History report"
^DIC(9.4,114,22,30,"PAH",121,1,7,0)="   to display the '#' symbol for voided payments."
^DIC(9.4,114,22,30,"PAH",121,1,8,0)="- Modifies the Fee Basis payment system to allow users holding the   "
^DIC(9.4,114,22,30,"PAH",121,1,9,0)="   ""FBAASUPERVISOR"" key to exceed the amount of billed charges."
^DIC(9.4,114,22,30,"PAH",122,0)="139 SEQ #127^3141001.153502^17"
^DIC(9.4,114,22,30,"PAH",122,1,0)="^^24^24^3141001"
^DIC(9.4,114,22,30,"PAH",122,1,1,0)="Description:"
^DIC(9.4,114,22,30,"PAH",122,1,2,0)="==========="
^DIC(9.4,114,22,30,"PAH",122,1,3,0)=" "
^DIC(9.4,114,22,30,"PAH",122,1,4,0)="The International Classification of Diseases, Tenth Revision (ICD-10) "
^DIC(9.4,114,22,30,"PAH",122,1,5,0)="Class 1 Software Remediation project replaces the 30-year-old set of "
^DIC(9.4,114,22,30,"PAH",122,1,6,0)="diagnosis and procedure codes (ICD-9-CM) that medical personnel use. "
^DIC(9.4,114,22,30,"PAH",122,1,7,0)="Dates of service, or dates of discharge for inpatients, that occur on or "
^DIC(9.4,114,22,30,"PAH",122,1,8,0)="after the implementation date will use the ICD-10 code set. Clinical "
^DIC(9.4,114,22,30,"PAH",122,1,9,0)="Modification (ICD-10-CM) diagnosis codes increase from about 13,000 ICD-9 "
^DIC(9.4,114,22,30,"PAH",122,1,10,0)="codes to more than 68,000. Procedure Coding System (ICD-10-PCS) procedure "
^DIC(9.4,114,22,30,"PAH",122,1,11,0)="codes increase from about 3,800 ICD-9 codes to nearly 87,000. Both "
^DIC(9.4,114,22,30,"PAH",122,1,12,0)="systems also expand the number of characters allotted to seven "
^DIC(9.4,114,22,30,"PAH",122,1,13,0)="alpha-numeric characters. This value does not include the decimal point, "
^DIC(9.4,114,22,30,"PAH",122,1,14,0)="which follows the third character for the ICD-10-CM code set. There is no "
^DIC(9.4,114,22,30,"PAH",122,1,15,0)="decimal point in the ICD-10-PCS code set."
^DIC(9.4,114,22,30,"PAH",122,1,16,0)=" "
^DIC(9.4,114,22,30,"PAH",122,1,17,0)="These code sets have the potential to reveal more about quality of care, "
^DIC(9.4,114,22,30,"PAH",122,1,18,0)="so that data can be used in a more meaningful way to better understand "
^DIC(9.4,114,22,30,"PAH",122,1,19,0)="complications, better design clinically robust algorithms, and better "
^DIC(9.4,114,22,30,"PAH",122,1,20,0)="track the outcomes of care. ICD-10-CM also incorporates greater "
^DIC(9.4,114,22,30,"PAH",122,1,21,0)="specificity and clinical detail to provide information for clinical "
^DIC(9.4,114,22,30,"PAH",122,1,22,0)="decision making and outcomes research."
^DIC(9.4,114,22,30,"PAH",122,1,23,0)=" "
^DIC(9.4,114,22,30,"PAH",122,1,24,0)="This patch is to implement ICD-10 Remediation for Fee Basis."
^DIC(9.4,114,22,30,"PAH",123,0)="150^3141015.151952^17"
^DIC(9.4,114,22,30,"PAH",123,1,0)="^^3^3^3141015"
^DIC(9.4,114,22,30,"PAH",123,1,1,0)="This patch addresses the following:"
^DIC(9.4,114,22,30,"PAH",123,1,2,0)="- Updates the Resource Based Relative Value Scale (RBRVS) Fee Schedule "
^DIC(9.4,114,22,30,"PAH",123,1,3,0)="  with changes for Calendar Year (CY) 2014."
^DIC(9.4,114,22,30,"PAH",124,0)="151 SEQ #129^3141031.155701^17"
^DIC(9.4,114,22,30,"PAH",124,1,0)="^^5^5^3141031"
^DIC(9.4,114,22,30,"PAH",124,1,1,0)="This patch is the first of two patches that enhance the Fee Basis package"
^DIC(9.4,114,22,30,"PAH",124,1,2,0)="per the requirements of the VistA Fee Separation of Duties project.  This"
^DIC(9.4,114,22,30,"PAH",124,1,3,0)="patch makes the following changes to Fee Basis:"
^DIC(9.4,114,22,30,"PAH",124,1,4,0)=" o Retain historical data for unauthorized claims"
^DIC(9.4,114,22,30,"PAH",124,1,5,0)=" o Retain historical data for authorizations"
^DIC(9.4,114,22,30,"PAH",125,0)="123 SEQ #130^3150106.114449^17"
^DIC(9.4,114,22,30,"PAH",125,1,0)="^^1^1^3150106"
^DIC(9.4,114,22,30,"PAH",125,1,1,0)="VA/DoD VistA Fee-IPAC Interface Enhancement"
^DIC(9.4,114,22,30,"PAH",126,0)="157^3150225.142028^17"
^DIC(9.4,114,22,30,"PAH",126,1,0)="^^2^2^3150225"
^DIC(9.4,114,22,30,"PAH",126,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,114,22,30,"PAH",126,1,2,0)="included in this patch. "
^DIC(9.4,114,22,30,"PAH",127,0)="153 SEQ #132^3150617.152217^17"
^DIC(9.4,114,22,30,"PAH",127,1,0)="^^11^11^3150617"
^DIC(9.4,114,22,30,"PAH",127,1,1,0)="1. Patient MRA rejections from FMS"
^DIC(9.4,114,22,30,"PAH",127,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",127,1,3,0)="2. For option 'Enter Unauthorized Claim' the response to query Mill Bill"
^DIC(9.4,114,22,30,"PAH",127,1,4,0)="   Claim indicator is not always stored when 'NO'."
^DIC(9.4,114,22,30,"PAH",127,1,5,0)=" "
^DIC(9.4,114,22,30,"PAH",127,1,6,0)="3. Authorization that are entered for Contract Nursing Home obligations "
^DIC(9.4,114,22,30,"PAH",127,1,7,0)="   are hitting every station's obligations for integrated sites when"
^DIC(9.4,114,22,30,"PAH",127,1,8,0)="   posted."
^DIC(9.4,114,22,30,"PAH",127,1,9,0)=" "
^DIC(9.4,114,22,30,"PAH",127,1,10,0)="4. Patient MRA transmissions are not being sent due to deleted patient"
^DIC(9.4,114,22,30,"PAH",127,1,11,0)="   authorizations."
^DIC(9.4,114,22,30,"PAH",128,0)="155 SEQ #133^3150818.130244^17"
^DIC(9.4,114,22,30,"PAH",128,1,0)="^^4^4^3150818"
^DIC(9.4,114,22,30,"PAH",128,1,1,0)="This patch addresses the following:"
^DIC(9.4,114,22,30,"PAH",128,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",128,1,3,0)="- Adds four new Purpose of Visit (POV) codes to the FEE BASIS PURPOSE OF "
^DIC(9.4,114,22,30,"PAH",128,1,4,0)="  VISIT (#161.82) file."
^DIC(9.4,114,22,30,"PAH",129,0)="162 SEQ #134^3151014.121423^17"
^DIC(9.4,114,22,30,"PAH",129,1,0)="^^2^2^3151014"
^DIC(9.4,114,22,30,"PAH",129,1,1,0)="1. Error when queuing Post Commitments option for Contract Nursing"
^DIC(9.4,114,22,30,"PAH",129,1,2,0)="   Home (CNH) obligations. "
^DIC(9.4,114,22,30,"PAH",130,0)="161 SEQ #135^3151211.144246^17"
^DIC(9.4,114,22,30,"PAH",130,1,0)="^^2^2^3151211"
^DIC(9.4,114,22,30,"PAH",130,1,1,0)="Patient MRA delete from FEE BASIS PATIENT MRA file when linked patient "
^DIC(9.4,114,22,30,"PAH",130,1,2,0)="authorization is deleted."
^DIC(9.4,114,22,30,"PAH",131,0)="167 SEQ #136^3160105.134422^54"
^DIC(9.4,114,22,30,"PAH",131,1,0)="^^10^10^3160105"
^DIC(9.4,114,22,30,"PAH",131,1,1,0)="This patch addresses the following 2 issues:"
^DIC(9.4,114,22,30,"PAH",131,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",131,1,3,0)="1. The Enter Unauthorized Claim [FBUC ENTER] option is failing when "
^DIC(9.4,114,22,30,"PAH",131,1,4,0)="   attempting to store data in the ICD DIAGNOSIS (#.087) field in the"
^DIC(9.4,114,22,30,"PAH",131,1,5,0)="   AUTHORIZATION (#161.01) sub-file of the FEE BASIS PATIENT (#161) file."
^DIC(9.4,114,22,30,"PAH",131,1,6,0)=" "
^DIC(9.4,114,22,30,"PAH",131,1,7,0)="2. The Modify Unauthorized Claim [FBUC MODIFY UNAUTHORIZED CLAIM] option"
^DIC(9.4,114,22,30,"PAH",131,1,8,0)="   is failing when attempting to store data in the ICD DIAGNOSIS (#.087) "
^DIC(9.4,114,22,30,"PAH",131,1,9,0)="   field in the AUTHORIZATION (#161.01) sub-file of the FEE BASIS PATIENT"
^DIC(9.4,114,22,30,"PAH",131,1,10,0)="   (#161) file."
^DIC(9.4,114,22,30,"PAH",132,0)="159^3160204.124232^54"
^DIC(9.4,114,22,30,"PAH",132,1,0)="^^4^4^3160204"
^DIC(9.4,114,22,30,"PAH",132,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,114,22,30,"PAH",132,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",132,1,3,0)="1. Updates the Resource Based Relative Value Scale (RBRVS) Fee Schedule"
^DIC(9.4,114,22,30,"PAH",132,1,4,0)="   with changes for Calendar Year (CY) 2015."
^DIC(9.4,114,22,30,"PAH",133,0)="172 SEQ #138^3160517.12592^54"
^DIC(9.4,114,22,30,"PAH",133,1,0)="^^5^5^3160517"
^DIC(9.4,114,22,30,"PAH",133,1,1,0)="Patch FB*3.5*172 is a Fee Basis patch for the VistA Fee Separation of"
^DIC(9.4,114,22,30,"PAH",133,1,2,0)="Duties project."
^DIC(9.4,114,22,30,"PAH",133,1,3,0)=" "
^DIC(9.4,114,22,30,"PAH",133,1,4,0)="Patch FB*3.5*172 creates three new security keys which will be referenced"
^DIC(9.4,114,22,30,"PAH",133,1,5,0)="in software exported by subsequent patch FB*3.5*154."
^DIC(9.4,114,22,30,"PAH",134,0)="165 SEQ #139^3160517.125943^54"
^DIC(9.4,114,22,30,"PAH",134,1,0)="^^12^12^3160517"
^DIC(9.4,114,22,30,"PAH",134,1,1,0)="During installation of patch FB*3.5*165, the post-init routine performs "
^DIC(9.4,114,22,30,"PAH",134,1,2,0)="a one-time (Delete Reject Flag) task that deletes the inappropriate "
^DIC(9.4,114,22,30,"PAH",134,1,3,0)="reject flag from old payment line items which have payment confirmation "
^DIC(9.4,114,22,30,"PAH",134,1,4,0)="or payment cancellation data. Installation of patch FB*3.5*165 also "
^DIC(9.4,114,22,30,"PAH",134,1,5,0)="performs a one-time (Remove Payment from Batch) task that removes old "
^DIC(9.4,114,22,30,"PAH",134,1,6,0)="payments with payment confirmation/cancellation data from in-process "
^DIC(9.4,114,22,30,"PAH",134,1,7,0)="batches.  "
^DIC(9.4,114,22,30,"PAH",134,1,8,0)=" "
^DIC(9.4,114,22,30,"PAH",134,1,9,0)="The Print Rejected Payment Items report [FBAA REJECT PRINT] is enhanced "
^DIC(9.4,114,22,30,"PAH",134,1,10,0)="to exclude payments transmitted prior to a user-specified date. The"
^DIC(9.4,114,22,30,"PAH",134,1,11,0)="report line which prints the batch number, the voucher date and the"
^DIC(9.4,114,22,30,"PAH",134,1,12,0)="voucherer is also modified to accommodate a 7-digit batch number."
^DIC(9.4,114,22,30,"PAH",135,0)="166 SEQ #140^3160719.165404^54"
^DIC(9.4,114,22,30,"PAH",135,1,0)="^^14^14^3160719"
^DIC(9.4,114,22,30,"PAH",135,1,1,0)="This patch addresses the following 3 issues:"
^DIC(9.4,114,22,30,"PAH",135,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",135,1,3,0)="1. Items are missing from the Potential Cost Recovery (PCR) report when a"
^DIC(9.4,114,22,30,"PAH",135,1,4,0)="   patient has multiple authorizations on the same day."
^DIC(9.4,114,22,30,"PAH",135,1,5,0)=" "
^DIC(9.4,114,22,30,"PAH",135,1,6,0)="2. The direct global read of the SHORT NAME (#2) field in the CPT (#81)"
^DIC(9.4,114,22,30,"PAH",135,1,7,0)="   file must be updated to the current Application Programming "
^DIC(9.4,114,22,30,"PAH",135,1,8,0)="   Interface (API) for the short name to continue to display on the Fee"
^DIC(9.4,114,22,30,"PAH",135,1,9,0)="   Basis Patch 135 Unique Claim Identifier Display report after the "
^DIC(9.4,114,22,30,"PAH",135,1,10,0)="   release of IPCT*4.0*46."
^DIC(9.4,114,22,30,"PAH",135,1,11,0)=" "
^DIC(9.4,114,22,30,"PAH",135,1,12,0)="3. The ANESTHESIA MINUTES (#43) field in the FEE BASIS PAYMENT (#162) "
^DIC(9.4,114,22,30,"PAH",135,1,13,0)="   file needs to be expanded from 3 to 4 digits to properly process "
^DIC(9.4,114,22,30,"PAH",135,1,14,0)="   anesthesia for labor and delivery."
^DIC(9.4,114,22,30,"PAH",136,0)="170^3160923.154905^54"
^DIC(9.4,114,22,30,"PAH",136,1,0)="^^4^4^3160923"
^DIC(9.4,114,22,30,"PAH",136,1,1,0)="This patch addresses the following issue: "
^DIC(9.4,114,22,30,"PAH",136,1,2,0)="  "
^DIC(9.4,114,22,30,"PAH",136,1,3,0)=" 1. Updates the Resource Based Relative Value Scale (RBRVS) Fee Schedule "
^DIC(9.4,114,22,30,"PAH",136,1,4,0)="    with changes for Calendar Year (CY) 2016."
^DIC(9.4,114,22,30,"PAH",137,0)="154 SEQ #142^3161014.135322^54"
^DIC(9.4,114,22,30,"PAH",137,1,0)="^^14^14^3161014"
^DIC(9.4,114,22,30,"PAH",137,1,1,0)="This patch will enhance the Fee Basis package per the requirements of the"
^DIC(9.4,114,22,30,"PAH",137,1,2,0)="VistA Fee Separation of Duties project.  The patch will make the "
^DIC(9.4,114,22,30,"PAH",137,1,3,0)="following changes to Fee Basis:"
^DIC(9.4,114,22,30,"PAH",137,1,4,0)=" o Add new security keys."
^DIC(9.4,114,22,30,"PAH",137,1,5,0)=" o Revise locks on menu options to enhance separation of duty controls."
^DIC(9.4,114,22,30,"PAH",137,1,6,0)=" o Attach menu options to additional menus."
^DIC(9.4,114,22,30,"PAH",137,1,7,0)=" o Revise locks on functionality within menu options."
^DIC(9.4,114,22,30,"PAH",137,1,8,0)=" o Add the Security Key Report for Fee Basis"
^DIC(9.4,114,22,30,"PAH",137,1,9,0)=" o Prevent entry of payment or pricing if user entered the authorization."
^DIC(9.4,114,22,30,"PAH",137,1,10,0)=" o Add reports to display users that entered or edited authorizations."
^DIC(9.4,114,22,30,"PAH",137,1,11,0)=" o Correct an existing issue with the identification of the associated"
^DIC(9.4,114,22,30,"PAH",137,1,12,0)="   authorization for outpatient and ancillary payments."
^DIC(9.4,114,22,30,"PAH",137,1,13,0)=" o Prevent an undefined error when a prescription is deleted."
^DIC(9.4,114,22,30,"PAH",137,1,14,0)=" o Prevent an undefined error when rejected payments are re-initiated."
^DIC(9.4,114,22,30,"PAH",138,0)="128^3161028.150401^54"
^DIC(9.4,114,22,30,"PAH",138,1,0)="^^3^3^3161028"
^DIC(9.4,114,22,30,"PAH",138,1,1,0)="This patch updates the following:"
^DIC(9.4,114,22,30,"PAH",138,1,2,0)="- The REMITTANCE REMARK (#161.93) file."
^DIC(9.4,114,22,30,"PAH",138,1,3,0)="- The ADJUSTMENT REASON (#161.91) file."
^DIC(9.4,114,22,30,"PAH",139,0)="173 SEQ #144^3161220.153622^54"
^DIC(9.4,114,22,30,"PAH",139,1,0)="^^3^3^3161220"
^DIC(9.4,114,22,30,"PAH",139,1,1,0)="FEE BASIS ENHANCEMENT TO SUPPORT MASTER VETERAN INDEX DATE OF DEATH (DOD) "
^DIC(9.4,114,22,30,"PAH",139,1,2,0)="Refer to patch FB*3.5*173 in the FORUM Patch Module for a complete"
^DIC(9.4,114,22,30,"PAH",139,1,3,0)="description."
^DIC(9.4,114,22,30,"PAH",140,0)="163 SEQ #145^3170419.122056^54"
^DIC(9.4,114,22,30,"PAH",140,1,0)="^^56^56^3170419"
^DIC(9.4,114,22,30,"PAH",140,1,1,0)="This National Patch consists of FEE BASIS enhancements related to the "
^DIC(9.4,114,22,30,"PAH",140,1,2,0)="following NSRs:"
^DIC(9.4,114,22,30,"PAH",140,1,3,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,4,0)="NSR ##20110304 - Service Connected Decision"
^DIC(9.4,114,22,30,"PAH",140,1,5,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,6,0)="The Fee-Revenue Service Connected (SC) Condition Decision project will "
^DIC(9.4,114,22,30,"PAH",140,1,7,0)="enhance the interface between the Integrated Billing (IB) and Fee Basis"
^DIC(9.4,114,22,30,"PAH",140,1,8,0)="(FB) Veterans Health Information Systems and Technology Architecture "
^DIC(9.4,114,22,30,"PAH",140,1,9,0)="(VistA) applications by automating the transfer of data elements "
^DIC(9.4,114,22,30,"PAH",140,1,10,0)="received from Non-Department of Veterans Affairs (VA) providers which "
^DIC(9.4,114,22,30,"PAH",140,1,11,0)="are necessary for third party billing."
^DIC(9.4,114,22,30,"PAH",140,1,12,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,13,0)="The proposed enhancement seeks modifications the FB application's "
^DIC(9.4,114,22,30,"PAH",140,1,14,0)="Potential Cost Recovery Report (PCRR) to ensure that all Non-VA Care "
^DIC(9.4,114,22,30,"PAH",140,1,15,0)="billed line item charges are included, regardless of responses entered"
^DIC(9.4,114,22,30,"PAH",140,1,16,0)="in the FB software by Fee Clerks."" By removing the report filtering"
^DIC(9.4,114,22,30,"PAH",140,1,17,0)="that pertains to the SC Condition and Potential Cost Recovery data "
^DIC(9.4,114,22,30,"PAH",140,1,18,0)="values, line item charges previously excluded based on responses to "
^DIC(9.4,114,22,30,"PAH",140,1,19,0)="POTENTIAL COST RECOVERY and SC CONDITION prompts in FB all Non-VA "
^DIC(9.4,114,22,30,"PAH",140,1,20,0)="care billed line item charges will appear on the PCRR, enabling the "
^DIC(9.4,114,22,30,"PAH",140,1,21,0)="Revenue Staff to optimize cost recovery. "
^DIC(9.4,114,22,30,"PAH",140,1,22,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,23,0)="NSR #20081010 - Billing Precertification Enhancements"
^DIC(9.4,114,22,30,"PAH",140,1,24,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,25,0)="Typically, Department of Veterans Affairs (VA) facilities are able to "
^DIC(9.4,114,22,30,"PAH",140,1,26,0)="provide all of the necessary medical care and services required by its"
^DIC(9.4,114,22,30,"PAH",140,1,27,0)="patients. However, there are times when the Veteran is not able to "
^DIC(9.4,114,22,30,"PAH",140,1,28,0)="access VA health care facilities based on geographic constraints, due "
^DIC(9.4,114,22,30,"PAH",140,1,29,0)="to medical emergencies, or because it is economically advantageous to "
^DIC(9.4,114,22,30,"PAH",140,1,30,0)="provide treatment in the community. In these cases, the VA may "
^DIC(9.4,114,22,30,"PAH",140,1,31,0)="authorize medical care at private-sector facilities for those Veterans"
^DIC(9.4,114,22,30,"PAH",140,1,32,0)="who meet the eligibility requirements. This concept is referred to as"
^DIC(9.4,114,22,30,"PAH",140,1,33,0)="FEE BASIS (FB) (or Non-VA) care."
^DIC(9.4,114,22,30,"PAH",140,1,34,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,35,0)="Regardless of where the care is provided, precertification is often a "
^DIC(9.4,114,22,30,"PAH",140,1,36,0)="prerequisite for certain services before payment is issued by insurance"
^DIC(9.4,114,22,30,"PAH",140,1,37,0)="companies. Precertification is the process of obtaining approval from"
^DIC(9.4,114,22,30,"PAH",140,1,38,0)="the Veteran's private insurance health plan for routine hospital "
^DIC(9.4,114,22,30,"PAH",140,1,39,0)="inpatient admissions or outpatient visits prior to the delivery of "
^DIC(9.4,114,22,30,"PAH",140,1,40,0)="health care. Currently, Medical Care Collections Fund (MCCF) Staff is "
^DIC(9.4,114,22,30,"PAH",140,1,41,0)="not notified of scheduled VA-provided outpatient services requiring "
^DIC(9.4,114,22,30,"PAH",140,1,42,0)="precertification. Notification regarding authorized "
^DIC(9.4,114,22,30,"PAH",140,1,43,0)="nonservice-connected FB care is received after treatment has been "
^DIC(9.4,114,22,30,"PAH",140,1,44,0)="rendered. As a result, VA Medical Centers (VAMCs) often miss "
^DIC(9.4,114,22,30,"PAH",140,1,45,0)="opportunities to be reimbursed by insurance companies for care due to "
^DIC(9.4,114,22,30,"PAH",140,1,46,0)="the lack of obtaining timely precertification."
^DIC(9.4,114,22,30,"PAH",140,1,47,0)=" "
^DIC(9.4,114,22,30,"PAH",140,1,48,0)="The goal of this project is to assist the VAMCs in obtaining timely p"
^DIC(9.4,114,22,30,"PAH",140,1,49,0)="recertification from third party payers before care is rendered by "
^DIC(9.4,114,22,30,"PAH",140,1,50,0)="notifying the appropriate staff as soon as VA-provided outpatient "
^DIC(9.4,114,22,30,"PAH",140,1,51,0)="services requiring precertification are scheduled and authorizations "
^DIC(9.4,114,22,30,"PAH",140,1,52,0)="are created in the Veterans Health Information Systems and Technology "
^DIC(9.4,114,22,30,"PAH",140,1,53,0)="Architecture (VistA) Fee Package for inpatient or outpatient care. This"
^DIC(9.4,114,22,30,"PAH",140,1,54,0)="would also provide an opportunity for insurance identification/ "
^DIC(9.4,114,22,30,"PAH",140,1,55,0)="verification processes (either internally or externally/outsourced) to "
^DIC(9.4,114,22,30,"PAH",140,1,56,0)="be completed prior to treatment."
^DIC(9.4,114,22,30,"PAH",141,0)="177 SEQ #146^3170830.170902^54"
^DIC(9.4,114,22,30,"PAH",141,1,0)="^^2^2^3170830"
^DIC(9.4,114,22,30,"PAH",141,1,1,0)="This patch adds six new Purpose of Visit (POV) codes to the FEE BASIS"
^DIC(9.4,114,22,30,"PAH",141,1,2,0)="PURPOSE OF VISIT (#161.82) file."
^DIC(9.4,114,22,30,"PAH",142,0)="176^3170928.164406^54"
^DIC(9.4,114,22,30,"PAH",142,1,0)="^^4^4^3170928"
^DIC(9.4,114,22,30,"PAH",142,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,114,22,30,"PAH",142,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",142,1,3,0)="1. Updates the Resource Based Relative Value Scale (RBRVS) Fee Schedule"
^DIC(9.4,114,22,30,"PAH",142,1,4,0)="   with changes for Calendar Year (CY) 2017."
^DIC(9.4,114,22,30,"PAH",143,0)="174 SEQ #148^3170929.164204^54"
^DIC(9.4,114,22,30,"PAH",143,1,0)="^^6^6^3170929"
^DIC(9.4,114,22,30,"PAH",143,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,114,22,30,"PAH",143,1,2,0)=" "
^DIC(9.4,114,22,30,"PAH",143,1,3,0)="A syntax error occurs when using a custom menu option which contains "
^DIC(9.4,114,22,30,"PAH",143,1,4,0)="either the Re-open Unauthorized Claim [FBUC REOPEN] or the Modify "
^DIC(9.4,114,22,30,"PAH",143,1,5,0)="Unauthorized Claim [FBUC MODIFY UNAUTHORIZED CLAIM], and Fee Patient "
^DIC(9.4,114,22,30,"PAH",143,1,6,0)="Inquiry [FBAA PATIENT INQUIRY] options."
^DIC(9.4,114,22,30,"PAH",144,0)="158 SEQ #149^3180130.144859^54"
^DIC(9.4,114,22,30,"PAH",144,1,0)="^^1^1^3180130"
^DIC(9.4,114,22,30,"PAH",144,1,1,0)="HAC EDI Purchase Care ERA Inc. 2 Development"
^DIC(9.4,114,22,30,"PAH",145,0)="178 SEQ #150^3180302.143031^54"
^DIC(9.4,114,22,30,"PAH",145,1,0)="^^2^2^3180302"
^DIC(9.4,114,22,30,"PAH",145,1,1,0)="This patch updates the FEE BASIS CPT RVU (#162.97) file for codes"
^DIC(9.4,114,22,30,"PAH",145,1,2,0)="77065-77067."
^DIC(9.4,114,22,30,"PAH",146,0)="175 SEQ #151^3180424.161821^54"
^DIC(9.4,114,22,30,"PAH",146,1,0)="^^12^12^3180424"
^DIC(9.4,114,22,30,"PAH",146,1,1,0)="This effort is focused on providing Other Health Insurance (OHI) to users "
^DIC(9.4,114,22,30,"PAH",146,1,2,0)="of VistA Fee. This will be facilitated through a collaboration with DSS, "
^DIC(9.4,114,22,30,"PAH",146,1,3,0)="Inc. to transmit data from the central server located at the Health "
^DIC(9.4,114,22,30,"PAH",146,1,4,0)="Administration Center (HAC) through Fee Basis Claims System (FBCS) and "
^DIC(9.4,114,22,30,"PAH",146,1,5,0)="into the local facility VistA Fee."
^DIC(9.4,114,22,30,"PAH",146,1,6,0)=" "
^DIC(9.4,114,22,30,"PAH",146,1,7,0)="The new database fields introduced by the patch are going to be used by "
^DIC(9.4,114,22,30,"PAH",146,1,8,0)="FBCS application that will be modified by DSS. New FBCS functionality will"
^DIC(9.4,114,22,30,"PAH",146,1,9,0)="make OHI data available for VA users on its Graphical User Interface (GUI)"
^DIC(9.4,114,22,30,"PAH",146,1,10,0)="screens."
^DIC(9.4,114,22,30,"PAH",146,1,11,0)=" "
^DIC(9.4,114,22,30,"PAH",146,1,12,0)="This patch implements the MUMPS database portion of the project."
