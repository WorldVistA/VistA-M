^DIC(9.4,4,22,1,"PAH",121,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,19,0)="3.7159,.01   FORWARD TO             0;1 FREE TEXT (Multiply asked)"
^DIC(9.4,4,22,1,"PAH",121,1,20,0)="             INPUT TRANSFORM:D FWDTO^XMTDF(.X,$G(XMIA)) I $D(X) K:$L(X)>50!("
^DIC(9.4,4,22,1,"PAH",121,1,21,0)="                             $L(X)<1) X"
^DIC(9.4,4,22,1,"PAH",121,1,22,0)="             LAST EDITED:    OCT 17, 2000 "
^DIC(9.4,4,22,1,"PAH",121,1,23,0)="             HELP-PROMPT:    Answer must be 1-50 characters in length."
^DIC(9.4,4,22,1,"PAH",121,1,24,0)="             DESCRIPTION:    Enter the person, group, device, or server to"
^DIC(9.4,4,22,1,"PAH",121,1,25,0)="                             whom or to which the message is to be"
^DIC(9.4,4,22,1,"PAH",121,1,26,0)="                             forwarded.  The message will be forwarded under"
^DIC(9.4,4,22,1,"PAH",121,1,27,0)="                             the following conditions, and you will be"
^DIC(9.4,4,22,1,"PAH",121,1,28,0)="                             listed as the forwarder."
^DIC(9.4,4,22,1,"PAH",121,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,30,0)="                             This will only apply when:"
^DIC(9.4,4,22,1,"PAH",121,1,31,0)="                              - delivering a message to you for the first"
^DIC(9.4,4,22,1,"PAH",121,1,32,0)="                             time."
^DIC(9.4,4,22,1,"PAH",121,1,33,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,34,0)="                             This will not apply when:"
^DIC(9.4,4,22,1,"PAH",121,1,35,0)="                              - you sent the message."
^DIC(9.4,4,22,1,"PAH",121,1,36,0)="                              - the message is already in your mailbox."
^DIC(9.4,4,22,1,"PAH",121,1,37,0)="                              - delivering replies."
^DIC(9.4,4,22,1,"PAH",121,1,38,0)="                              - the message is closed, confidential, or"
^DIC(9.4,4,22,1,"PAH",121,1,39,0)="                             otherwise sensitive."
^DIC(9.4,4,22,1,"PAH",121,1,40,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,41,0)="             NOTES:          XXXX--CAN'T BE ALTERED EXCEPT BY PROGRAMMER"
^DIC(9.4,4,22,1,"PAH",121,1,42,0)="             CROSS-REFERENCE:3.7159^B"
^DIC(9.4,4,22,1,"PAH",121,1,43,0)="                             1)= S ^XMB(3.7,DA(2),15,DA(1),1,""B"",$E(X,1,30),"
^DIC(9.4,4,22,1,"PAH",121,1,44,0)="                             DA)="""""
^DIC(9.4,4,22,1,"PAH",121,1,45,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,46,0)="                             2)= K ^XMB(3.7,DA(2),15,DA(1),1,""B"",$E(X,1,30),"
^DIC(9.4,4,22,1,"PAH",121,1,47,0)="                             DA)"
^DIC(9.4,4,22,1,"PAH",121,1,48,0)=""
^DIC(9.4,4,22,1,"PAH",121,1,49,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",121,1,50,0)="is at a minimum.  It requires MailMan patches XM*7.1*140 and XM*7.1*142."
^DIC(9.4,4,22,1,"PAH",121,1,51,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",121,1,52,0)=""
