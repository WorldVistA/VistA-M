^DIC(9.4,3,22,21,"PAH",48,1,30,0)="XPDIA1       7937994         9226085     **2,44,51,58,68**"
^DIC(9.4,3,22,21,"PAH",48,1,31,0)="XPDIA2       3520152         6372331     **68**"
^DIC(9.4,3,22,21,"PAH",48,1,32,0)="XPDIJ       10173098        10435806     **2,21,28,41,44,68**"
^DIC(9.4,3,22,21,"PAH",48,1,33,0)="XPDIJ1       8772642         9316977     **41,68**"
^DIC(9.4,3,22,21,"PAH",48,1,34,0)="XPDIL       11156235        11193690     **15,44,58,68**"
^DIC(9.4,3,22,21,"PAH",48,1,35,0)="XPDIL1       8519937         9389594     **15,17,39,41,44,66,68**"
^DIC(9.4,3,22,21,"PAH",48,1,36,0)="XPDIPM       1817853         1853883     **21,28,68**"
