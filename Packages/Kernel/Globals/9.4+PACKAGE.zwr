^DIC(9.4,14,22,5.9,"PAH",180,0)="360 SEQ #278^3061122.222322^1"
^DIC(9.4,14,22,5.9,"PAH",180,1,0)="^^6^6^3061122"
^DIC(9.4,14,22,5.9,"PAH",180,1,1,0)="This patch addresses several issues with accessioning. This patch will"
^DIC(9.4,14,22,5.9,"PAH",180,1,2,0)="prevent the re-accessioning of accessioned and the accessioned part of "
^DIC(9.4,14,22,5.9,"PAH",180,1,3,0)="partly accessioned lab orders. It will not allow the input of order"
^DIC(9.4,14,22,5.9,"PAH",180,1,4,0)="numbers exceeding eight characters in length. It adds to chemistry and "
^DIC(9.4,14,22,5.9,"PAH",180,1,5,0)="microbiology accessioning (both standard and batch) a warning message the "
^DIC(9.4,14,22,5.9,"PAH",180,1,6,0)="patient the test is for has died and the patient's date of death."
^DIC(9.4,14,22,5.9,"PAH",181,0)="346 SEQ #279^3061122.231635^1"
^DIC(9.4,14,22,5.9,"PAH",181,1,0)="^^283^283^3061122"
^DIC(9.4,14,22,5.9,"PAH",181,1,1,0)=" Blood Bank Clearance"
^DIC(9.4,14,22,5.9,"PAH",181,1,2,0)=" ===================="
^DIC(9.4,14,22,5.9,"PAH",181,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,4,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*346 does not"
^DIC(9.4,14,22,5.9,"PAH",181,1,5,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,14,22,5.9,"PAH",181,1,6,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",181,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,8,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*346 does not"
^DIC(9.4,14,22,5.9,"PAH",181,1,9,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",181,1,10,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",181,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,12,0)="RISK ANALYSIS: Changes made by patch LR*5.2*346 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",181,1,13,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",181,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,15,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes"
^DIC(9.4,14,22,5.9,"PAH",181,1,16,0)="made, no specific validation requirements exist as a result of installation"
^DIC(9.4,14,22,5.9,"PAH",181,1,17,0)="of this patch."
^DIC(9.4,14,22,5.9,"PAH",181,1,18,0)="----------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",181,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,20,0)="As part of the VA/DoD Laboratory Data Sharing Interoperability (LDSI) Phase"
^DIC(9.4,14,22,5.9,"PAH",181,1,21,0)="2 project supporting the exchange of microbiology and anatomic pathology"
^DIC(9.4,14,22,5.9,"PAH",181,1,22,0)="laboratory test orders and results, enhancements have been made to the"
^DIC(9.4,14,22,5.9,"PAH",181,1,23,0)="Laboratory server LRLABSERVER to extract selected VistA Laboratory files"
^DIC(9.4,14,22,5.9,"PAH",181,1,24,0)="for SNOMED CT mapping."
^DIC(9.4,14,22,5.9,"PAH",181,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,26,0)="1. The following are new LRLABSERVER server reports made available with"
^DIC(9.4,14,22,5.9,"PAH",181,1,27,0)="this patch:"
^DIC(9.4,14,22,5.9,"PAH",181,1,28,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,29,0)="a. SNOMED"
^DIC(9.4,14,22,5.9,"PAH",181,1,30,0)="   Send a message to: S.LRLABSERVER@domain name"
^DIC(9.4,14,22,5.9,"PAH",181,1,31,0)="             Subject: SNOMED"
^DIC(9.4,14,22,5.9,"PAH",181,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,33,0)="   The body of the message will be ignored. The following files are"
^DIC(9.4,14,22,5.9,"PAH",181,1,34,0)="   scanned and data is extracted and extract data in a format for input"
^DIC(9.4,14,22,5.9,"PAH",181,1,35,0)="   into Standards and Terminology Service (STS) mapping SNOMED tool:"
^DIC(9.4,14,22,5.9,"PAH",181,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,37,0)="   File #    File Name"
^DIC(9.4,14,22,5.9,"PAH",181,1,38,0)="   ------    ---------"
^DIC(9.4,14,22,5.9,"PAH",181,1,39,0)="   61        TOPOGRAPHY FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,40,0)="   61.1      MORPHOLOGY FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,41,0)="   61.2      ETIOLOGY FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,42,0)="   61.3      FUNCTION FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,43,0)="   61.4      DISEASE FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,44,0)="   61.5      PROCEDURE FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,45,0)="   61.6      OCCUPATION FIELD"
^DIC(9.4,14,22,5.9,"PAH",181,1,46,0)="   62        COLLECTION SAMPLE"
^DIC(9.4,14,22,5.9,"PAH",181,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,48,0)="   Results are returned to the person"
^DIC(9.4,14,22,5.9,"PAH",181,1,49,0)="   sending the mail message request. The extracted data is returned as an"
^DIC(9.4,14,22,5.9,"PAH",181,1,50,0)="   attached file in a delimited format using the ""|"" character as"
^DIC(9.4,14,22,5.9,"PAH",181,1,51,0)="   the field delimiter."
^DIC(9.4,14,22,5.9,"PAH",181,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,53,0)="   Record legend for attached file:"
^DIC(9.4,14,22,5.9,"PAH",181,1,54,0)="    Station #-File #-IEN|Entry Name|SNOMED I|VUID|SNOMED CT|"
^DIC(9.4,14,22,5.9,"PAH",181,1,55,0)="    SNOMED CT TERM|Mapping Exception|Related Specimen|Related Specimen ID|"
^DIC(9.4,14,22,5.9,"PAH",181,1,56,0)="    Extract Ver|"
^DIC(9.4,14,22,5.9,"PAH",181,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,58,0)="    Note: the fields RELATED SPECIMEN & RELATED SPECIMEN ID in the"
^DIC(9.4,14,22,5.9,"PAH",181,1,59,0)="          record are only valued when the record relates to an entry"
^DIC(9.4,14,22,5.9,"PAH",181,1,60,0)="          in COLLECTION SAMPLE file (#62) and indicates the related"
^DIC(9.4,14,22,5.9,"PAH",181,1,61,0)="          specimen in TOPOGRAPHY FIELD file (#61)."
^DIC(9.4,14,22,5.9,"PAH",181,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,64,0)="b. NLT/CPT"
^DIC(9.4,14,22,5.9,"PAH",181,1,65,0)="   Send a message to: S.LRLABSERVER@domain name"
^DIC(9.4,14,22,5.9,"PAH",181,1,66,0)="             Subject: NLT/CPT"
^DIC(9.4,14,22,5.9,"PAH",181,1,67,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,68,0)="   The body of the message will be ignored. The database is scanned"
^DIC(9.4,14,22,5.9,"PAH",181,1,69,0)="   for mapped NLT, LOINC and CPT data. Results are returned to the person"
^DIC(9.4,14,22,5.9,"PAH",181,1,70,0)="   sending the mail message request. The extracted data is returned as an"
^DIC(9.4,14,22,5.9,"PAH",181,1,71,0)="   attached file in a delimited format using the ""|"" character as the field"
^DIC(9.4,14,22,5.9,"PAH",181,1,72,0)="   delimiter."
^DIC(9.4,14,22,5.9,"PAH",181,1,73,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,74,0)="   Record legend for attached file:"
^DIC(9.4,14,22,5.9,"PAH",181,1,75,0)="   Station #-NLT IEN-CPT IEN-Spec-Time Aspect|NLT Code|NLT Name|CPT Code|CPT"
^DIC(9.4,14,22,5.9,"PAH",181,1,76,0)="   Name|Specimen|Time Aspect|LOINC Code|LOINC Short Name|"
^DIC(9.4,14,22,5.9,"PAH",181,1,77,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,79,0)="2. The existing LRLABSERVER report RELMA has been modified to extract"
^DIC(9.4,14,22,5.9,"PAH",181,1,80,0)="additional information requested by VA Data Standardization service."
^DIC(9.4,14,22,5.9,"PAH",181,1,81,0)="   a. The extract will now include an extract version number. This patch"
^DIC(9.4,14,22,5.9,"PAH",181,1,82,0)="      will set the version number to 1.1."
^DIC(9.4,14,22,5.9,"PAH",181,1,83,0)="   b. Include site's Laboratory Test site notes."
^DIC(9.4,14,22,5.9,"PAH",181,1,84,0)="   c. Include laboratory test's synonyms"
^DIC(9.4,14,22,5.9,"PAH",181,1,85,0)="   d. Include laboratory test's type"
^DIC(9.4,14,22,5.9,"PAH",181,1,86,0)="   e. Include laboratory test's default LOINC code."
^DIC(9.4,14,22,5.9,"PAH",181,1,87,0)="   f. Include mappings to suffixed NLT codes when laboratory code is mapped"
^DIC(9.4,14,22,5.9,"PAH",181,1,88,0)="      to a generic NLT code and suffixed codes also exist."
^DIC(9.4,14,22,5.9,"PAH",181,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,90,0)="The modified record layout of the extract is:"
^DIC(9.4,14,22,5.9,"PAH",181,1,91,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,92,0)=" Legend:"
^DIC(9.4,14,22,5.9,"PAH",181,1,93,0)="|           1                   |    2    |  3 |     4     |  5  |   6"
^DIC(9.4,14,22,5.9,"PAH",181,1,94,0)="|Station #-60 ien-Spec ien-Index|Test Name|Spec|Time Aspect|Units|LOINC"
^DIC(9.4,14,22,5.9,"PAH",181,1,95,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,96,0)="|  7  |    8       |     9             |     10    |   11    |   12"
^DIC(9.4,14,22,5.9,"PAH",181,1,97,0)="|NLT #|Battery Code|Battery Description|Lab Section|Subscript|Comment"
^DIC(9.4,14,22,5.9,"PAH",181,1,98,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,99,0)="|    13   |    14       |     15       |      16       |       17"
^DIC(9.4,14,22,5.9,"PAH",181,1,100,0)="|Data Type|Reference low|Reference high|Therapeutic low|Therapeutic high"
^DIC(9.4,14,22,5.9,"PAH",181,1,101,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,102,0)="|     18    |    19      |       20    |    21   |      22     |  23     |"
^DIC(9.4,14,22,5.9,"PAH",181,1,103,0)="|Use Ref Lab|Site Comment|Test Synonyms|Test Type|Default LOINC|Extract Ver|"
^DIC(9.4,14,22,5.9,"PAH",181,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,106,0)="3. Due to migration within Veterans Health Administration from Microsoft"
^DIC(9.4,14,22,5.9,"PAH",181,1,107,0)="Exchange 2000 to Exchange 2003 the Microsoft Exchange system dropped support"
^DIC(9.4,14,22,5.9,"PAH",181,1,108,0)="for 4 character Unix file permission which are part of the header used to"
^DIC(9.4,14,22,5.9,"PAH",181,1,109,0)="uuencode the file attachment. The extract changes the uuencode file header"
^DIC(9.4,14,22,5.9,"PAH",181,1,110,0)="from ""begin 0664 ""_filename to ""begin 664 ""_filename to enable successful"
^DIC(9.4,14,22,5.9,"PAH",181,1,111,0)="processing of the uuencoded file by Exchange."
^DIC(9.4,14,22,5.9,"PAH",181,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,114,0)=" ASSOCIATED E3R"
^DIC(9.4,14,22,5.9,"PAH",181,1,115,0)=" --------------"
^DIC(9.4,14,22,5.9,"PAH",181,1,116,0)=" None"
^DIC(9.4,14,22,5.9,"PAH",181,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,118,0)=" ASSOCIATED REMEDY"
^DIC(9.4,14,22,5.9,"PAH",181,1,119,0)=" ---------------"
^DIC(9.4,14,22,5.9,"PAH",181,1,120,0)=" None"
^DIC(9.4,14,22,5.9,"PAH",181,1,121,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,123,0)=" TEST SITES"
^DIC(9.4,14,22,5.9,"PAH",181,1,124,0)=" ----------"
^DIC(9.4,14,22,5.9,"PAH",181,1,125,0)=" Biloxi VAMC"
^DIC(9.4,14,22,5.9,"PAH",181,1,126,0)=" Boston HCS VAMC"
^DIC(9.4,14,22,5.9,"PAH",181,1,127,0)=" El Paso VAMC"
^DIC(9.4,14,22,5.9,"PAH",181,1,128,0)=" Milwaukee VAMC"
^DIC(9.4,14,22,5.9,"PAH",181,1,129,0)=" San Antonio VAMC"
^DIC(9.4,14,22,5.9,"PAH",181,1,130,0)=" Upstate New York HCS"
^DIC(9.4,14,22,5.9,"PAH",181,1,131,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,133,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",181,1,134,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",181,1,135,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",181,1,136,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",181,1,137,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",181,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,139,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",181,1,140,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",181,1,141,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",181,1,142,0)="   LR346            N/A            4832883        **346** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",181,1,143,0)="   LRSRVR           5915085        5140630        **232,303,346**"
