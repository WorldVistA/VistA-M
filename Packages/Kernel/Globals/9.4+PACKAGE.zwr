^DIC(9.4,14,22,5.9,"PAH",283,1,134,0)="------------------------------------- "
^DIC(9.4,14,22,5.9,"PAH",283,1,135,0)="Software being released as a host file and/or documentation describing "
^DIC(9.4,14,22,5.9,"PAH",283,1,136,0)="the new functionality introduced by this patch are available."
^DIC(9.4,14,22,5.9,"PAH",283,1,137,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,138,0)="The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,14,22,5.9,"PAH",283,1,139,0)="This transmits the files from the first available server. Sites may "
^DIC(9.4,14,22,5.9,"PAH",283,1,140,0)="also elect to retrieve files directly from a specific server. "
^DIC(9.4,14,22,5.9,"PAH",283,1,141,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,142,0)="Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,14,22,5.9,"PAH",283,1,143,0)="Secure "
^DIC(9.4,14,22,5.9,"PAH",283,1,144,0)="File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory at "
^DIC(9.4,14,22,5.9,"PAH",283,1,145,0)="the following OI Field Offices:"
^DIC(9.4,14,22,5.9,"PAH",283,1,146,0)="   "
^DIC(9.4,14,22,5.9,"PAH",283,1,147,0)="Albany:                 fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",283,1,148,0)="Hines:                  fo-hines.domain.ext    "
^DIC(9.4,14,22,5.9,"PAH",283,1,149,0)="Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",283,1,150,0)="   "
^DIC(9.4,14,22,5.9,"PAH",283,1,151,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,14,22,5.9,"PAH",283,1,152,0)="at:"
^DIC(9.4,14,22,5.9,"PAH",283,1,153,0)="http://www4.domain.ext/vdl/"
^DIC(9.4,14,22,5.9,"PAH",283,1,154,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,155,0)="Title                         File Name                       FTP Mode"
^DIC(9.4,14,22,5.9,"PAH",283,1,156,0)="-----------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",283,1,157,0)="VistA laboratory Enhancements  AP_VIP_Deployment_Installation_  Binary"
^DIC(9.4,14,22,5.9,"PAH",283,1,158,0)="(VLE) Anatomic Pathlogy (AP)   Roll Back_Back-Out_Guide.DOC"
^DIC(9.4,14,22,5.9,"PAH",283,1,159,0)="Order Dialogs"
^DIC(9.4,14,22,5.9,"PAH",283,1,160,0)="VistA laboratory Enhancements  AP_VIP_Deployment_Installation_  Binary"
^DIC(9.4,14,22,5.9,"PAH",283,1,161,0)="(VLE) Anatomic Pathlogy (AP)   Roll Back_Back-Out_Guide.PDF"
^DIC(9.4,14,22,5.9,"PAH",283,1,162,0)="Order Dialogs"
^DIC(9.4,14,22,5.9,"PAH",283,1,163,0)="          "
^DIC(9.4,14,22,5.9,"PAH",283,1,164,0)="      "
^DIC(9.4,14,22,5.9,"PAH",283,1,165,0)="Patch Installation:"
^DIC(9.4,14,22,5.9,"PAH",283,1,166,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,168,0)="Pre/Post Installation Overview:"
^DIC(9.4,14,22,5.9,"PAH",283,1,169,0)="-------------------------------"
^DIC(9.4,14,22,5.9,"PAH",283,1,170,0)="This patch is a fix for an Autopsy error that is triggered when users "
^DIC(9.4,14,22,5.9,"PAH",283,1,171,0)="'Verify/Release Autopsy report in VistA. "
^DIC(9.4,14,22,5.9,"PAH",283,1,172,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,173,0)="Pre-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",283,1,174,0)="------------------------------"
^DIC(9.4,14,22,5.9,"PAH",283,1,175,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,14,22,5.9,"PAH",283,1,176,0)="strongly recommended that it be installed during non-peak hours when "
^DIC(9.4,14,22,5.9,"PAH",283,1,177,0)="LAB usage is at a minimum."
^DIC(9.4,14,22,5.9,"PAH",283,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,179,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,180,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",283,1,181,0)="--------------------------"
^DIC(9.4,14,22,5.9,"PAH",283,1,182,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,14,22,5.9,"PAH",283,1,183,0)=" recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,14,22,5.9,"PAH",283,1,184,0)=" potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,14,22,5.9,"PAH",283,1,185,0)=" minutes to install."
^DIC(9.4,14,22,5.9,"PAH",283,1,186,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,187,0)="This installation will install the components necessary to support the "
^DIC(9.4,14,22,5.9,"PAH",283,1,188,0)="CPRS AP Order Dialog functionality released with OR*3.0*405."
^DIC(9.4,14,22,5.9,"PAH",283,1,189,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,190,0)="1.  Choose the PackMan message containing this patch."
^DIC(9.4,14,22,5.9,"PAH",283,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,192,0)="2.  Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,14,22,5.9,"PAH",283,1,193,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,194,0)="3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,14,22,5.9,"PAH",283,1,195,0)="    the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,14,22,5.9,"PAH",283,1,196,0)="    following options. When prompted for the INSTALL NAME enter the patch "
^DIC(9.4,14,22,5.9,"PAH",283,1,197,0)="    LR*5.2*462:"
^DIC(9.4,14,22,5.9,"PAH",283,1,198,0)="    a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,14,22,5.9,"PAH",283,1,199,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,14,22,5.9,"PAH",283,1,200,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,14,22,5.9,"PAH",283,1,201,0)="   b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,14,22,5.9,"PAH",283,1,202,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,14,22,5.9,"PAH",283,1,203,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,14,22,5.9,"PAH",283,1,204,0)="        (routines, DDs, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",283,1,205,0)="    c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,14,22,5.9,"PAH",283,1,206,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,14,22,5.9,"PAH",283,1,207,0)="        transport global."
^DIC(9.4,14,22,5.9,"PAH",283,1,208,0)="     "
^DIC(9.4,14,22,5.9,"PAH",283,1,209,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,14,22,5.9,"PAH",283,1,210,0)="    choose the patch to install."
^DIC(9.4,14,22,5.9,"PAH",283,1,211,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,212,0)="5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",283,1,213,0)="    Install? NO//'     "
^DIC(9.4,14,22,5.9,"PAH",283,1,214,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",283,1,215,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,216,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,14,22,5.9,"PAH",283,1,217,0)="    NO//'"
^DIC(9.4,14,22,5.9,"PAH",283,1,218,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",283,1,219,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,220,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,14,22,5.9,"PAH",283,1,221,0)="    and Protocols? NO//' "
^DIC(9.4,14,22,5.9,"PAH",283,1,222,0)="    Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",283,1,223,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,224,0)="8.  If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,14,22,5.9,"PAH",283,1,225,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,226,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,227,0)="Post-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",283,1,228,0)="-------------------------------"
^DIC(9.4,14,22,5.9,"PAH",283,1,229,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",283,1,230,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,231,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,232,0)="Routine Information:"
^DIC(9.4,14,22,5.9,"PAH",283,1,233,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",283,1,234,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,235,0)="The second line of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",283,1,236,0)=";;5.2;LAB SERVICE;**[Patch List]**;Sep 27, 1994;Build 1"
^DIC(9.4,14,22,5.9,"PAH",283,1,237,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,238,0)="The checksums below are new checksums, and"
^DIC(9.4,14,22,5.9,"PAH",283,1,239,0)="can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,14,22,5.9,"PAH",283,1,240,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,241,0)="Routine Name: LR482"
^DIC(9.4,14,22,5.9,"PAH",283,1,242,0)="    Before:       n/a   After:  B4627709  **482**"
^DIC(9.4,14,22,5.9,"PAH",283,1,243,0)="Routine Name: LRAPRES1"
^DIC(9.4,14,22,5.9,"PAH",283,1,244,0)="    Before: B70400068   After: B71690317  **259,336,369,365,397,413,350,"
^DIC(9.4,14,22,5.9,"PAH",283,1,245,0)="                                           462,482**"
^DIC(9.4,14,22,5.9,"PAH",283,1,246,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,247,0)="Routine list of preceding patches: 462"
^DIC(9.4,14,22,5.9,"PAH",284,0)="470 SEQ #382^3170203.154725^54"
^DIC(9.4,14,22,5.9,"PAH",284,1,0)="^^14^14^3170203"
^DIC(9.4,14,22,5.9,"PAH",284,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",284,1,2,0)="package by the Vista Maintenance team that addresses"
^DIC(9.4,14,22,5.9,"PAH",284,1,3,0)="issues with some patients test results not getting transmitted"
^DIC(9.4,14,22,5.9,"PAH",284,1,4,0)="to the HDR (Health Data Repository) and with some lab orders"
^DIC(9.4,14,22,5.9,"PAH",284,1,5,0)="that have the wrong status in file #100 (ORDER)."
^DIC(9.4,14,22,5.9,"PAH",284,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",284,1,7,0)="ASSOCIATED REMEDY TICKET:"
^DIC(9.4,14,22,5.9,"PAH",284,1,8,0)="========================"
^DIC(9.4,14,22,5.9,"PAH",284,1,9,0)="1. INC000001243211  -  Failure of merged lab collect orders"
^DIC(9.4,14,22,5.9,"PAH",284,1,10,0)="                       to transmit to HDR"
^DIC(9.4,14,22,5.9,"PAH",284,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",284,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",284,1,13,0)="2. INC000000775621  -  Lab order merging leads to incorrect"
^DIC(9.4,14,22,5.9,"PAH",284,1,14,0)="                       status of file 100 orders"
^DIC(9.4,14,22,5.9,"PAH",285,0)="468 SEQ #383^3170313.143715^54"
^DIC(9.4,14,22,5.9,"PAH",285,1,0)="^^1^1^3170313"
^DIC(9.4,14,22,5.9,"PAH",285,1,1,0)="See National Patch Module for details."
^DIC(9.4,14,22,5.9,"PAH",286,0)="479 SEQ #385^3170328.154206^54"
^DIC(9.4,14,22,5.9,"PAH",286,1,0)="^^641^641^3170328"
^DIC(9.4,14,22,5.9,"PAH",286,1,1,0)=" This patch contains corrections that address issues related to the"
^DIC(9.4,14,22,5.9,"PAH",286,1,2,0)=" VistA Lab Enhancements (VLE) released patches LR*5.2*462 and LR*5.2*469."
^DIC(9.4,14,22,5.9,"PAH",286,1,3,0)=" The description of the issues can be reviewed in the Problem and"
^DIC(9.4,14,22,5.9,"PAH",286,1,4,0)=" Resolution sections of this patch description."
^DIC(9.4,14,22,5.9,"PAH",286,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,6,0)="Blood Bank Review:"
^DIC(9.4,14,22,5.9,"PAH",286,1,7,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",286,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,9,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*479 does not "
^DIC(9.4,14,22,5.9,"PAH",286,1,10,0)=" contain any changes to the VISTA BLOOD BANK Software as defined by "
^DIC(9.4,14,22,5.9,"PAH",286,1,11,0)=" ProPath standard titled: BBM Team Review of VistA Patches."
^DIC(9.4,14,22,5.9,"PAH",286,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,13,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*479 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",286,1,14,0)=" Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",286,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,16,0)=" VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",286,1,17,0)=" made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",286,1,18,0)=" installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",286,1,19,0)=" "
