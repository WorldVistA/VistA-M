^DIC(9.4,5,22,13,"PAH",9,1,198,0)="XDRPTDOB       N/A             1857839         23"
^DIC(9.4,5,22,13,"PAH",9,1,199,0)="XDRPTDOD       N/A             498220          23"
^DIC(9.4,5,22,13,"PAH",9,1,200,0)="XDRPTLSD       N/A             803980          23"
^DIC(9.4,5,22,13,"PAH",9,1,201,0)="XDRPTMMN       N/A             1478218         23"
^DIC(9.4,5,22,13,"PAH",9,1,202,0)="XDRPTN         N/A             6440837         23"
