^DIC(9.4,14,22,5.9,"PAH",140,1,217,0)="                                          UP    SEND  DATA                USER"
^DIC(9.4,14,22,5.9,"PAH",140,1,218,0)="                                          DATE  SEC.  COMES  SITE   RSLV  OVER"
^DIC(9.4,14,22,5.9,"PAH",140,1,219,0)=" FILE #      NAME                         DD    CODE  W/FILE DATA   PTS   RIDE"
^DIC(9.4,14,22,5.9,"PAH",140,1,220,0)=" -------------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",140,1,221,0)=" "
