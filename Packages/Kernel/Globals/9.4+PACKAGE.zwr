^DIC(9.4,5,22,0)="^9.49I^13^1"
^DIC(9.4,5,22,13,0)="7.3^3051119^2960604"
^DIC(9.4,5,22,13,1,0)="^^1^1^3051119"
^DIC(9.4,5,22,13,1,1,0)="from Platinum account.  includes patches"
^DIC(9.4,5,22,13,"PAH",0)="^9.4901^119^119"
^DIC(9.4,5,22,13,"PAH",1,0)="8 SEQ #3^2961017^1"
^DIC(9.4,5,22,13,"PAH",1,1,0)="^^8^8^2961017"
^DIC(9.4,5,22,13,"PAH",1,1,1,0)="This patch fixes problems that the 'Flow Chart from Entry Point' option"
^DIC(9.4,5,22,13,"PAH",1,1,2,0)="was having with parameter passing."
^DIC(9.4,5,22,13,"PAH",1,1,3,0)="This problem was reported in NOIS: ISB-0594-30120"
^DIC(9.4,5,22,13,"PAH",1,1,4,0)=" "
^DIC(9.4,5,22,13,"PAH",1,1,5,0)="routine         new checksum"
^DIC(9.4,5,22,13,"PAH",1,1,6,0)="XTFC1             14453171"
^DIC(9.4,5,22,13,"PAH",1,1,7,0)="XTFCE              5996229"
^DIC(9.4,5,22,13,"PAH",1,1,8,0)="XTFCE1             6490782"
^DIC(9.4,5,22,13,"PAH",2,0)="9 SEQ #4^2961017^1"
^DIC(9.4,5,22,13,"PAH",2,1,0)="^^5^5^2961017"
^DIC(9.4,5,22,13,"PAH",2,1,1,0)="Hans found that when doing a save or move in the ^%Z editor if the"
^DIC(9.4,5,22,13,"PAH",2,1,2,0)="ending point passed a second TAG then the save or move would never end."
^DIC(9.4,5,22,13,"PAH",2,1,3,0)=" "
^DIC(9.4,5,22,13,"PAH",2,1,4,0)="routine       new checksum"
^DIC(9.4,5,22,13,"PAH",2,1,5,0)="ZTEDIT2         12127551"
^DIC(9.4,5,22,13,"PAH",3,0)="14 SEQ #11^2961017^1"
^DIC(9.4,5,22,13,"PAH",3,1,0)="^^136^136^2961017"
^DIC(9.4,5,22,13,"PAH",3,1,1,0)="   ** Only MSM sites need to install this patch **"
^DIC(9.4,5,22,13,"PAH",3,1,2,0)="   There are no known NOIS's associated with this patch"
^DIC(9.4,5,22,13,"PAH",3,1,3,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,4,0)="   Enhancement #1 - As suggested both by the field and 486 Customer"
^DIC(9.4,5,22,13,"PAH",3,1,5,0)="Service Team, a ""Morning Report"" in the form of a mail message, will be"
^DIC(9.4,5,22,13,"PAH",3,1,6,0)="sent to the person(s) listed in the LOCAL CMP RECIPIENTS multiple of the"
^DIC(9.4,5,22,13,"PAH",3,1,7,0)="site parameter file #8987.1. The following is a sample report:"
^DIC(9.4,5,22,13,"PAH",3,1,8,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,9,0)="Subj: MPM Morning Report for 2/16/96  [#1508125] 17 Feb 96 02:13  23 Lines"
^DIC(9.4,5,22,13,"PAH",3,1,10,0)="From: MPM  in 'DAILY MPM' basket.   Page 1"
^DIC(9.4,5,22,13,"PAH",3,1,11,0)="--------------------------------------------------------------------------"
^DIC(9.4,5,22,13,"PAH",3,1,12,0)="========================================================================="
^DIC(9.4,5,22,13,"PAH",3,1,13,0)="CLARKSBURG, WV       MPM Summary for FEB 16, 1996 to FEB 16, 1996 (AM&PM)"
^DIC(9.4,5,22,13,"PAH",3,1,14,0)="========================================================================="
^DIC(9.4,5,22,13,"PAH",3,1,15,0)="  Node                540CSA 540CSB 540FSA 540FSB 540FSC 540PSA"
^DIC(9.4,5,22,13,"PAH",3,1,16,0)="  CPU Usage %            61     58      8      4     11     37"
^DIC(9.4,5,22,13,"PAH",3,1,17,0)="  Disk Usage %           30     26     47     28     50     14"
^DIC(9.4,5,22,13,"PAH",3,1,18,0)="  Response Time Sec    0.56   0.62"
^DIC(9.4,5,22,13,"PAH",3,1,19,0)="  RTs<2 Seconds %        96     96"
^DIC(9.4,5,22,13,"PAH",3,1,20,0)="  Responses/S           9.9   10.9"
^DIC(9.4,5,22,13,"PAH",3,1,21,0)="  Ave. # Jobs            51     51     10     10     10     26"
^DIC(9.4,5,22,13,"PAH",3,1,22,0)="  Term InChar/S          19     17                          24"
^DIC(9.4,5,22,13,"PAH",3,1,23,0)="  Term OutChar/S        971    894             0      0    457"
^DIC(9.4,5,22,13,"PAH",3,1,24,0)="  M Commands/S         5958   5917    341    206    982   4059"
^DIC(9.4,5,22,13,"PAH",3,1,25,0)="  Global Gets/S        1139   1116     41     23     35   1089"
^DIC(9.4,5,22,13,"PAH",3,1,26,0)="  Global S&Ks/S          58     55      9      9     39     46"
^DIC(9.4,5,22,13,"PAH",3,1,27,0)="  Disk Reads/S           50     45     21      9     11     19"
^DIC(9.4,5,22,13,"PAH",3,1,28,0)="  Disk Writes/S           5      4      2      2      8      6"
^DIC(9.4,5,22,13,"PAH",3,1,29,0)="  Read Cache %           93     93     92     93     96     96"
^DIC(9.4,5,22,13,"PAH",3,1,30,0)="  Write Cache %          86     86     51     67     67     81"
^DIC(9.4,5,22,13,"PAH",3,1,31,0)="  DDP Requests/S         18     17      4      3     14"
^DIC(9.4,5,22,13,"PAH",3,1,32,0)="  RVG Requests/S        545    568                         443"
^DIC(9.4,5,22,13,"PAH",3,1,33,0)="  RVG Cache %            93     94                          93"
^DIC(9.4,5,22,13,"PAH",3,1,34,0)="  RTH Sessions            2      2      2      2      2      2"
^DIC(9.4,5,22,13,"PAH",3,1,35,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,36,0)="   Routines affected - XUCSTME, XUCSRV"
^DIC(9.4,5,22,13,"PAH",3,1,37,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,38,0)="   Enhancement #2 - The routines that are used nationally to compile"
^DIC(9.4,5,22,13,"PAH",3,1,39,0)=" monthly comparisons can now be used locally.  One menu, with five"
^DIC(9.4,5,22,13,"PAH",3,1,40,0)=" options, and one option have been added to the CM REPORTS menu - they"
^DIC(9.4,5,22,13,"PAH",3,1,41,0)=" are:"
^DIC(9.4,5,22,13,"PAH",3,1,42,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,43,0)="     [XUCSX DAILY REPORT] (option)"
^DIC(9.4,5,22,13,"PAH",3,1,44,0)="     [XUCSX LOCAL XSITE REPORTS] (menu)"
^DIC(9.4,5,22,13,"PAH",3,1,45,0)="       [XUCSX LOCAL XSTE PREF] (option)"
^DIC(9.4,5,22,13,"PAH",3,1,46,0)="       [XUCSX LOCAL XSITE RT] (option)"
^DIC(9.4,5,22,13,"PAH",3,1,47,0)="       [XUCSX LOCAL XSITE SYSSTATS] (option)"
^DIC(9.4,5,22,13,"PAH",3,1,48,0)="       [XUCSXGR LOCAL XSITE GREF ALL] (option)"
^DIC(9.4,5,22,13,"PAH",3,1,49,0)="       [XUCSXGR LOCAL XSITE GREF VG] (option)"
^DIC(9.4,5,22,13,"PAH",3,1,50,0)="   New Routines - XUCSXCD, XUCSXDR, XUCSXGR, XUCSXRT, XUCSXST"
^DIC(9.4,5,22,13,"PAH",3,1,51,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,52,0)="   Enhancement #3 - A new field was added to the RAW STATISTICS multiple of"
^DIC(9.4,5,22,13,"PAH",3,1,53,0)=" file #8987.2.  This field is called RVG HITS and represents the number of"
^DIC(9.4,5,22,13,"PAH",3,1,54,0)=" RVG cache hits.  By using the following formula you can now calculate the"
^DIC(9.4,5,22,13,"PAH",3,1,55,0)=" RVG cache efficiency.  RVG HITS/TOTAL RVG REUESTS*100=%eff."
^DIC(9.4,5,22,13,"PAH",3,1,56,0)="  Routines affected - XUCS4E, XUCS4R, and XUCS4RB, XUCSTME"
^DIC(9.4,5,22,13,"PAH",3,1,57,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,58,0)="   Enhancement #4 - A new field was added to the GLOBAL REFERENCES multiple"
^DIC(9.4,5,22,13,"PAH",3,1,59,0)=" of file #8987.2.  This field is called GLOBAL LOCATION, and it contains"
^DIC(9.4,5,22,13,"PAH",3,1,60,0)=" the Volume Group where a particular global is located, i.e. FDA, CSA, etc."
^DIC(9.4,5,22,13,"PAH",3,1,61,0)="   Routine affected - XUCS2E"
^DIC(9.4,5,22,13,"PAH",3,1,62,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,63,0)="   Enhancement #5 - It is no longer necessary to schedule separately"
^DIC(9.4,5,22,13,"PAH",3,1,64,0)="the purge of file #8987.2.  The purge is now done during the up date of"
^DIC(9.4,5,22,13,"PAH",3,1,65,0)="file #8987.2.  The option [XUCSTASK PURGE CM DATA] should be"
^DIC(9.4,5,22,13,"PAH",3,1,66,0)="*Unscheduled*."
^DIC(9.4,5,22,13,"PAH",3,1,67,0)="  Routine affected - XUCSTME"
^DIC(9.4,5,22,13,"PAH",3,1,68,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,69,0)="   Enhancement #6 - The option XUCSTASK FILE UPDATE AUTO"
^DIC(9.4,5,22,13,"PAH",3,1,70,0)=" (routine: XUCSTME) will now do the following functions:"
^DIC(9.4,5,22,13,"PAH",3,1,71,0)=" 1.  Load the raw RTHIST data into file #8987.2"
^DIC(9.4,5,22,13,"PAH",3,1,72,0)=" 2.  Create the MPM Morning Report and mail it to the"
^DIC(9.4,5,22,13,"PAH",3,1,73,0)="     LOCAL CMP RECIPIENTS."
^DIC(9.4,5,22,13,"PAH",3,1,74,0)=" 3.  Create the server message and mail it to the National Data Base."
^DIC(9.4,5,22,13,"PAH",3,1,75,0)=" 4.  Purge old data from file #8987.2."
^DIC(9.4,5,22,13,"PAH",3,1,76,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,77,0)="   Unreported Bug Fix -  When asking for a date range for reports, the"
^DIC(9.4,5,22,13,"PAH",3,1,78,0)=" user would always be asked for volume sets.  A new variable can now be"
^DIC(9.4,5,22,13,"PAH",3,1,79,0)="passed to entry point A3^XUCSUTL3 called XUCSNOA2 -  when set"
^DIC(9.4,5,22,13,"PAH",3,1,80,0)="(i.e. $D(XUCSNOA2)>0) then the volume set questions will not be asked."
^DIC(9.4,5,22,13,"PAH",3,1,81,0)="Also, when getting the last date for data in file #8987.2, it was always"
^DIC(9.4,5,22,13,"PAH",3,1,82,0)="assumed to be T-1, this has been corrected to display the true last date"
^DIC(9.4,5,22,13,"PAH",3,1,83,0)="in file #8987.2."
^DIC(9.4,5,22,13,"PAH",3,1,84,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,85,0)="   Test Sites:"
^DIC(9.4,5,22,13,"PAH",3,1,86,0)="   ==========="
^DIC(9.4,5,22,13,"PAH",3,1,87,0)="   Erie, PA"
^DIC(9.4,5,22,13,"PAH",3,1,88,0)="   Muskogee, OK"
^DIC(9.4,5,22,13,"PAH",3,1,89,0)="   Beckley, WV"
^DIC(9.4,5,22,13,"PAH",3,1,90,0)="   White River Junction, VT"
^DIC(9.4,5,22,13,"PAH",3,1,91,0)="   Lincoln, NE"
^DIC(9.4,5,22,13,"PAH",3,1,92,0)="   White-City, OR"
^DIC(9.4,5,22,13,"PAH",3,1,93,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,94,0)="   ======================================================================"
^DIC(9.4,5,22,13,"PAH",3,1,95,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,96,0)="   INSTALLATION:"
^DIC(9.4,5,22,13,"PAH",3,1,97,0)=" **Installation Notes: This patch can be queued to run at anytime"
^DIC(9.4,5,22,13,"PAH",3,1,98,0)=" *except* when the option [XUCSTASK FILE UPDATE AUTO] 'Tasked CM File"
^DIC(9.4,5,22,13,"PAH",3,1,99,0)=" Update' is running.  Of course since some of the routines being changed"
^DIC(9.4,5,22,13,"PAH",3,1,100,0)=" deal with reports, <CLOBR> errors could be reported if someone is running"
^DIC(9.4,5,22,13,"PAH",3,1,101,0)=" a report."
^DIC(9.4,5,22,13,"PAH",3,1,102,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,103,0)="     1.  Use TaskMan's Schedule/Unschedule to *unschedule* the following"
^DIC(9.4,5,22,13,"PAH",3,1,104,0)="         option: [XUCSTASK PURGE CM DATA] 'Auto Purge of CM Data'.  See"
^DIC(9.4,5,22,13,"PAH",3,1,105,0)="         Enhancement #5 above."
^DIC(9.4,5,22,13,"PAH",3,1,106,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",3,1,107,0)="         option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",3,1,108,0)="     3.  Answer NO to the question:"
^DIC(9.4,5,22,13,"PAH",3,1,109,0)="         'Shall I preserve what is on disk in a separate back-up message ?'"
^DIC(9.4,5,22,13,"PAH",3,1,110,0)="     4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",3,1,111,0)="         system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",3,1,112,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the option"
^DIC(9.4,5,22,13,"PAH",3,1,113,0)="         'Verify Checksum in Transport Global' and verify that all routines"
^DIC(9.4,5,22,13,"PAH",3,1,114,0)="         have the correct checksums."
^DIC(9.4,5,22,13,"PAH",3,1,115,0)="     6.  On the KIDS menu, under the 'Installation' menu, use the option"
^DIC(9.4,5,22,13,"PAH",3,1,116,0)="         'Install Package(s)'. Select the package 'XT*7.3*14' and proceed"
^DIC(9.4,5,22,13,"PAH",3,1,117,0)="         with install."
^DIC(9.4,5,22,13,"PAH",3,1,118,0)="     7.  Move the routines to the other Compute/Print servers only."
^DIC(9.4,5,22,13,"PAH",3,1,119,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,120,0)="    ===================================================================="
^DIC(9.4,5,22,13,"PAH",3,1,121,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,122,0)="   ROUTINES:"
^DIC(9.4,5,22,13,"PAH",3,1,123,0)=" "
^DIC(9.4,5,22,13,"PAH",3,1,124,0)="    Name           Before          After           Patch List"
^DIC(9.4,5,22,13,"PAH",3,1,125,0)="    XUCS2E         5426963         5731962         14"
^DIC(9.4,5,22,13,"PAH",3,1,126,0)="    XUCS4E         1556880         1693814         14"
^DIC(9.4,5,22,13,"PAH",3,1,127,0)="    XUCS4R         11613596        12001291        6,14"
^DIC(9.4,5,22,13,"PAH",3,1,128,0)="    XUCS4RB        9713051         10100746        6,14"
^DIC(9.4,5,22,13,"PAH",3,1,129,0)="    XUCSRV         5969322         5755562         14"
^DIC(9.4,5,22,13,"PAH",3,1,130,0)="    XUCSTME        13223145        13388433        14"
^DIC(9.4,5,22,13,"PAH",3,1,131,0)="    XUCSUTL3       11346798        11524190        6,12,14"
^DIC(9.4,5,22,13,"PAH",3,1,132,0)="    XUCSXCD        *new*           6351363         14"
^DIC(9.4,5,22,13,"PAH",3,1,133,0)="    XUCSXDR        *new*           11901373        14"
^DIC(9.4,5,22,13,"PAH",3,1,134,0)="    XUCSXGR        *new*           7068507         14"
^DIC(9.4,5,22,13,"PAH",3,1,135,0)="    XUCSXRT        *new*           5016229         14"
^DIC(9.4,5,22,13,"PAH",3,1,136,0)="    XUCSXST        *new*           5797377         14"
^DIC(9.4,5,22,13,"PAH",4,0)="11 SEQ #12^2961017^1"
^DIC(9.4,5,22,13,"PAH",4,1,0)="^^49^49^2961017"
^DIC(9.4,5,22,13,"PAH",4,1,1,0)="FORUM # 18670217  This message asked for the return of the routine"
^DIC(9.4,5,22,13,"PAH",4,1,2,0)="checksum.  It turned out that this was a local mod, but one that was"
^DIC(9.4,5,22,13,"PAH",4,1,3,0)="usefull to all. This change has been incorporated in this patch to the"
^DIC(9.4,5,22,13,"PAH",4,1,4,0)="%ZTPP routine.  The checksum value was found to have a weakness in that it"
^DIC(9.4,5,22,13,"PAH",4,1,5,0)="wouldn't catch if the order of lines changed.  KIDS uses a new version"
^DIC(9.4,5,22,13,"PAH",4,1,6,0)="that will catch this kind of change. Because of this the patch will"
^DIC(9.4,5,22,13,"PAH",4,1,7,0)="calculate both the old and new checksum values and displays them in the"
^DIC(9.4,5,22,13,"PAH",4,1,8,0)="following way RSUM 7921662/11772536 so that both values are printed at the"
^DIC(9.4,5,22,13,"PAH",4,1,9,0)="top of the first page.  It is not a crytographic hash."
^DIC(9.4,5,22,13,"PAH",4,1,10,0)=" "
^DIC(9.4,5,22,13,"PAH",4,1,11,0)="The CS ALPHA team asked for a change to the XTLATSET routine to change the"
^DIC(9.4,5,22,13,"PAH",4,1,12,0)="setup of the LAT device from /noqueue to /queue."
^DIC(9.4,5,22,13,"PAH",4,1,13,0)=" "
^DIC(9.4,5,22,13,"PAH",4,1,14,0)="Under the new error trapping in DSM the VMS EDT editor call was getting"
^DIC(9.4,5,22,13,"PAH",4,1,15,0)="errors if the input file was null and there was no text added.  This"
^DIC(9.4,5,22,13,"PAH",4,1,16,0)="has been fixed in XTEDTVXD"
^DIC(9.4,5,22,13,"PAH",4,1,17,0)=" "
^DIC(9.4,5,22,13,"PAH",4,1,18,0)="routine         new checksum"
^DIC(9.4,5,22,13,"PAH",4,1,19,0)="XTEDTVXD         1531100"
^DIC(9.4,5,22,13,"PAH",4,1,20,0)="XTLATSET         6400569"
^DIC(9.4,5,22,13,"PAH",4,1,21,0)="XTSUMBLD        11338949"
^DIC(9.4,5,22,13,"PAH",4,1,22,0)="ZTPP             7877336"
^DIC(9.4,5,22,13,"PAH",4,1,23,0)=" "
^DIC(9.4,5,22,13,"PAH",4,1,24,0)=" "
^DIC(9.4,5,22,13,"PAH",4,1,25,0)="========================================================================= "
^DIC(9.4,5,22,13,"PAH",4,1,26,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",4,1,27,0)=" "
^DIC(9.4,5,22,13,"PAH",4,1,28,0)=" 1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,5,22,13,"PAH",4,1,29,0)="     so you will need to disable mapping for the effected routines."
^DIC(9.4,5,22,13,"PAH",4,1,30,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",4,1,31,0)="     option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",4,1,32,0)=" 3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",4,1,33,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",4,1,34,0)=" 4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",4,1,35,0)="     options:"
^DIC(9.4,5,22,13,"PAH",4,1,36,0)="        Print Transport Global"
^DIC(9.4,5,22,13,"PAH",4,1,37,0)="        Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",4,1,38,0)="        Verify Checksums in Transport Global"
^DIC(9.4,5,22,13,"PAH",4,1,39,0)="        Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",4,1,40,0)="        Install Package(s)"
^DIC(9.4,5,22,13,"PAH",4,1,41,0)=" 5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,5,22,13,"PAH",4,1,42,0)="     other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,5,22,13,"PAH",4,1,43,0)=" 6.  After installing this patch, you need to move the following"
^DIC(9.4,5,22,13,"PAH",4,1,44,0)="     routine from your productions account to the manager account:"
^DIC(9.4,5,22,13,"PAH",4,1,45,0)="     ZTPP and rename to %ZTPP"
^DIC(9.4,5,22,13,"PAH",4,1,46,0)="       Example: ZL ZTPP ZS %ZTPP"
^DIC(9.4,5,22,13,"PAH",4,1,47,0)=" 7.  On MSM move the routines to the other servers.  "
^DIC(9.4,5,22,13,"PAH",4,1,48,0)="     AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,5,22,13,"PAH",4,1,49,0)="========================================================================= "
^DIC(9.4,5,22,13,"PAH",5,0)="17 SEQ #13^2961018^1"
^DIC(9.4,5,22,13,"PAH",5,1,0)="^^59^59^2961018"
^DIC(9.4,5,22,13,"PAH",5,1,1,0)="This *KIDS* patch contains updates to the VAX/ALPHA PERFORMANCE MONITOR"
^DIC(9.4,5,22,13,"PAH",5,1,2,0)="(VPM)."
^DIC(9.4,5,22,13,"PAH",5,1,3,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,4,0)="Make sure you have installed the Kernel patch, XU*8.0*35 (containing"
^DIC(9.4,5,22,13,"PAH",5,1,5,0)="ZOSV2VXD)."
^DIC(9.4,5,22,13,"PAH",5,1,6,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,7,0)="1) It introduces a new algorithm permitting VPM to compute and store"
^DIC(9.4,5,22,13,"PAH",5,1,8,0)="system RESPONSE TIME. A response event is defined as the elapsed time"
^DIC(9.4,5,22,13,"PAH",5,1,9,0)="beginning at the moment a user presses the RETURN/ENTER key and ending at"
^DIC(9.4,5,22,13,"PAH",5,1,10,0)="the start of the next read. Response time is the average of the response"
^DIC(9.4,5,22,13,"PAH",5,1,11,0)="events for a given period of measurment. As with other VPM metrics,"
^DIC(9.4,5,22,13,"PAH",5,1,12,0)="response time raw data will be stored for each session and a daily average"
^DIC(9.4,5,22,13,"PAH",5,1,13,0)="for the workday will be computed and stored in file 8986.6, tolerance"
^DIC(9.4,5,22,13,"PAH",5,1,14,0)="limits will be computed, data will be included in the morning summary"
^DIC(9.4,5,22,13,"PAH",5,1,15,0)="report, and events outside of your expected range will be identified."
^DIC(9.4,5,22,13,"PAH",5,1,16,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,17,0)="       a. Bernstein Response Time Monitor options will be deleted."
^DIC(9.4,5,22,13,"PAH",5,1,18,0)="       b. The file CM BERNSTEIN DATA (8986.098) will be replaced with a"
^DIC(9.4,5,22,13,"PAH",5,1,19,0)="new file to support VPM response time data."
^DIC(9.4,5,22,13,"PAH",5,1,20,0)="       c. Two new metrics will be added to the CM METRICS FILE:"
^DIC(9.4,5,22,13,"PAH",5,1,21,0)="               RTM-VPM Response Time"
^DIC(9.4,5,22,13,"PAH",5,1,22,0)="               RSP-Response Events/second"
^DIC(9.4,5,22,13,"PAH",5,1,23,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,24,0)="2) This updates the VMS PERFORMANCE MONITOR to use Kernel 8's host file"
^DIC(9.4,5,22,13,"PAH",5,1,25,0)="managment utilities in ^%ZISH. "
^DIC(9.4,5,22,13,"PAH",5,1,26,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,27,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,28,0)="New Checksums:"
^DIC(9.4,5,22,13,"PAH",5,1,29,0)="XUCMNIT   value = 15387419"
^DIC(9.4,5,22,13,"PAH",5,1,30,0)="XUCMNIT2  value = 17426297"
^DIC(9.4,5,22,13,"PAH",5,1,31,0)="XUCMNIT4  value = 12158370"
^DIC(9.4,5,22,13,"PAH",5,1,32,0)="XUCMNT3A  value = 10755761"
^DIC(9.4,5,22,13,"PAH",5,1,33,0)="XUCMVPI   value = 6254847"
^DIC(9.4,5,22,13,"PAH",5,1,34,0)="XUCMVPM   value = 4073012"
^DIC(9.4,5,22,13,"PAH",5,1,35,0)="XUCMVPM1  value = 11910365 "
^DIC(9.4,5,22,13,"PAH",5,1,36,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,37,0)=" "
^DIC(9.4,5,22,13,"PAH",5,1,38,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",5,1,39,0)=" 1. These routines may be mapped on systems that allow mapping, "
^DIC(9.4,5,22,13,"PAH",5,1,40,0)="    so you will need to disable mapping for the effected routines.  "
^DIC(9.4,5,22,13,"PAH",5,1,41,0)=" 2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",5,1,42,0)="    option will load the KIDS package in this message onto your system."
^DIC(9.4,5,22,13,"PAH",5,1,43,0)=" 3. Answer NO to the question:"
^DIC(9.4,5,22,13,"PAH",5,1,44,0)="    'Shall I preserve what is on disk in a separate back-up message ?'"
^DIC(9.4,5,22,13,"PAH",5,1,45,0)=" 4. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,5,22,13,"PAH",5,1,46,0)="    'Verify Checksums in Transport Global' and verify that all routines"
^DIC(9.4,5,22,13,"PAH",5,1,47,0)="    have the correct checksum."
^DIC(9.4,5,22,13,"PAH",5,1,48,0)=" 5. This patch can be installed with users on the system."
^DIC(9.4,5,22,13,"PAH",5,1,49,0)=" 6. Disable VPM using the option, ENABLE/DISABLE VPM. In MGR, enter the"
^DIC(9.4,5,22,13,"PAH",5,1,50,0)="RTH Utilities (D ^RTH) and stop RTHIST if it is running. Repeat this on"
^DIC(9.4,5,22,13,"PAH",5,1,51,0)="all nodes."
^DIC(9.4,5,22,13,"PAH",5,1,52,0)=" 7. Use the KIDS menu to complete the installation."
^DIC(9.4,5,22,13,"PAH",5,1,53,0)=" 8. In the vms directory containing VPM files, delete files using the"
^DIC(9.4,5,22,13,"PAH",5,1,54,0)="command, ""DELETE XUCM*.COM.*"""
^DIC(9.4,5,22,13,"PAH",5,1,55,0)=" 9. Sign back in to DSM and run the option, SETUP PERFORMANCE MONITOR."
^DIC(9.4,5,22,13,"PAH",5,1,56,0)="This will create a new set of VMS MONITOR and RTHIST drivers."
^DIC(9.4,5,22,13,"PAH",5,1,57,0)="10. Re-enable VPM."
^DIC(9.4,5,22,13,"PAH",5,1,58,0)="11. Using Taskman's ONE TIME OPTION QUEUE, run the option, XUCM"
^DIC(9.4,5,22,13,"PAH",5,1,59,0)="TASK NIT. This will restart RTHIST data collections on all nodes."
^DIC(9.4,5,22,13,"PAH",6,0)="15 SEQ #14^2970121^1"
^DIC(9.4,5,22,13,"PAH",6,1,0)="^^71^71^2970121"
^DIC(9.4,5,22,13,"PAH",6,1,1,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,2,0)="     * Only MSM Sites need to install this Patch *"
^DIC(9.4,5,22,13,"PAH",6,1,3,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,4,0)="- NT/UNIX support"
^DIC(9.4,5,22,13,"PAH",6,1,5,0)=" NOIS# GRI-0396-40902"
^DIC(9.4,5,22,13,"PAH",6,1,6,0)="       BDC-1296-N1654"
^DIC(9.4,5,22,13,"PAH",6,1,7,0)="The problem was a <DIVER> error in routine XUCSCDE.  In investigating the"
^DIC(9.4,5,22,13,"PAH",6,1,8,0)="problem it was discovered that MSM's RTHIST does not sample the system"
^DIC(9.4,5,22,13,"PAH",6,1,9,0)="for CPU and DISK usage and number of jobs running at the sample time."
^DIC(9.4,5,22,13,"PAH",6,1,10,0)="MSM is aware of the problem (MSM call #30546) and there is no indication"
^DIC(9.4,5,22,13,"PAH",6,1,11,0)="as of yet when the problem will be fixed."
^DIC(9.4,5,22,13,"PAH",6,1,12,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,13,0)="- This patch also increases the maximum number of TOTAL MUMPS COMMANDS"
^DIC(9.4,5,22,13,"PAH",6,1,14,0)="that can be stored.  The current maximum value is 99999999, the new value"
^DIC(9.4,5,22,13,"PAH",6,1,15,0)="is 9999999999.  The problem was if a ""run away"" job was running during the"
^DIC(9.4,5,22,13,"PAH",6,1,16,0)="RTHIST run the TOTAL MUMPS COMMANDS would exceed the maximum value and all"
^DIC(9.4,5,22,13,"PAH",6,1,17,0)="of the RAW STATISTICS would fail to be filed."
^DIC(9.4,5,22,13,"PAH",6,1,18,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,19,0)="- This patch also replaces the OS checks in %ZOSV2 with standard Kernel"
^DIC(9.4,5,22,13,"PAH",6,1,20,0)="checks:"
^DIC(9.4,5,22,13,"PAH",6,1,21,0)="$$OSTYPE^%ZOSV"
^DIC(9.4,5,22,13,"PAH",6,1,22,0)="$$VERSION^%ZOSV"
^DIC(9.4,5,22,13,"PAH",6,1,23,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,24,0)="- Fixes problem in NOIS LAS-0796-60351"
^DIC(9.4,5,22,13,"PAH",6,1,25,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,26,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,27,0)="Thanks to the following Test Sites:"
^DIC(9.4,5,22,13,"PAH",6,1,28,0)="==================================="
^DIC(9.4,5,22,13,"PAH",6,1,29,0)="Muskogee, Ok"
^DIC(9.4,5,22,13,"PAH",6,1,30,0)="Grand Island, Ne"
^DIC(9.4,5,22,13,"PAH",6,1,31,0)="Las Vegas, Nv"
^DIC(9.4,5,22,13,"PAH",6,1,32,0)="Boston Developement Center"
^DIC(9.4,5,22,13,"PAH",6,1,33,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,34,0)="Routine List (CHECK^XTSUMBLD values):"
^DIC(9.4,5,22,13,"PAH",6,1,35,0)="====================================="
^DIC(9.4,5,22,13,"PAH",6,1,36,0)="Name                Before                After           Patch List"
^DIC(9.4,5,22,13,"PAH",6,1,37,0)="XUCS1E              5744464               5869170         15"
^DIC(9.4,5,22,13,"PAH",6,1,38,0)="XUCS2E              5731962               5888536         14,15"
^DIC(9.4,5,22,13,"PAH",6,1,39,0)="XUCS8E              2709944               2718707         15"
^DIC(9.4,5,22,13,"PAH",6,1,40,0)="XUCSCDE             3642152               4091741         15"
^DIC(9.4,5,22,13,"PAH",6,1,41,0)="XUCSCDG             6508203               6570082         6,13,15"
^DIC(9.4,5,22,13,"PAH",6,1,42,0)="XUCSPRG             4520058               4828057         15"
^DIC(9.4,5,22,13,"PAH",6,1,43,0)="XUCSTM              6488785               6674638         3,15"
^DIC(9.4,5,22,13,"PAH",6,1,44,0)="XUCSTME             13388433              13548298        14,15"
^DIC(9.4,5,22,13,"PAH",6,1,45,0)="XUCSUTL3            11524190              11581338        6,12,14,15"
^DIC(9.4,5,22,13,"PAH",6,1,46,0)=" "
^DIC(9.4,5,22,13,"PAH",6,1,47,0)="======================================================================"
^DIC(9.4,5,22,13,"PAH",6,1,48,0)="INSTALLATION NOTE:"
^DIC(9.4,5,22,13,"PAH",6,1,49,0)="**Installation Notes: This patch can be Queued to run at anytime"
^DIC(9.4,5,22,13,"PAH",6,1,50,0)="  *except* when options:"
^DIC(9.4,5,22,13,"PAH",6,1,51,0)="  [XUCSTASK AM RTHIST] 'AM MSM RTHIST Task Option'"
^DIC(9.4,5,22,13,"PAH",6,1,52,0)="  [XUCSTASK FILE UPDATE AUTO] 'Tasked CM File Update'"
^DIC(9.4,5,22,13,"PAH",6,1,53,0)="  [XUCSTASK PM RTHIST] 'PM MSM RTHIST Task Option'"
^DIC(9.4,5,22,13,"PAH",6,1,54,0)="  [XUCSTASK PURGE CM DATA] 'Auto Purge of CM Data'"
^DIC(9.4,5,22,13,"PAH",6,1,55,0)="  are scheduled to run or would be running."
^DIC(9.4,5,22,13,"PAH",6,1,56,0)="======================================================================="
^DIC(9.4,5,22,13,"PAH",6,1,57,0)="  INSTALLATION:"
^DIC(9.4,5,22,13,"PAH",6,1,58,0)="    1.  The installation of this patch takes less than 2 minutes."
^DIC(9.4,5,22,13,"PAH",6,1,59,0)="    2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",6,1,60,0)="        option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",6,1,61,0)="    3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",6,1,62,0)="        system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",6,1,63,0)="    4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",6,1,64,0)="        options:"
^DIC(9.4,5,22,13,"PAH",6,1,65,0)="           Print Transport Global"
^DIC(9.4,5,22,13,"PAH",6,1,66,0)="           Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",6,1,67,0)="           Verify Checksums in Transport Global"
^DIC(9.4,5,22,13,"PAH",6,1,68,0)="           Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",6,1,69,0)="           Install Package(s)"
^DIC(9.4,5,22,13,"PAH",6,1,70,0)="    5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,5,22,13,"PAH",6,1,71,0)="        other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,5,22,13,"PAH",7,0)="20 SEQ #15^2971016^1"
^DIC(9.4,5,22,13,"PAH",7,1,0)="^^103^103^2971016"
^DIC(9.4,5,22,13,"PAH",7,1,1,0)="This patch fixes most of the problems that have been raised with XINDEX."
^DIC(9.4,5,22,13,"PAH",7,1,2,0)="The use of root indirection still causes some problems:"
^DIC(9.4,5,22,13,"PAH",7,1,3,0)="(i.e. $O(@ABC(XYZ)@(123))"
^DIC(9.4,5,22,13,"PAH",7,1,4,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,5,0)="NOIS:"
^DIC(9.4,5,22,13,"PAH",7,1,6,0)="ISB-0494-30070 "
^DIC(9.4,5,22,13,"PAH",7,1,7,0)="BRX-1296-10244 "
^DIC(9.4,5,22,13,"PAH",7,1,8,0)="ISA-0497-11864  Fix entries in the ROUTINE file that have a blank type if"
^DIC(9.4,5,22,13,"PAH",7,1,9,0)="   XINDEX does a save into the ROUTINE file."
^DIC(9.4,5,22,13,"PAH",7,1,10,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,11,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,12,0)="FORUM messages:"
^DIC(9.4,5,22,13,"PAH",7,1,13,0)="%INDEX & Undetected Error  [#11969353]"
^DIC(9.4,5,22,13,"PAH",7,1,14,0)="XINDEX mistakes  [#17602138]"
^DIC(9.4,5,22,13,"PAH",7,1,15,0)="Undefined in XINDEX  [#19627074]"
^DIC(9.4,5,22,13,"PAH",7,1,16,0)="XINDEX and $TRANSLATE  [#19927226]"
^DIC(9.4,5,22,13,"PAH",7,1,17,0)="Just in case  [#20070553]"
^DIC(9.4,5,22,13,"PAH",7,1,18,0)="UNDEF IN XINDEX  [#20406560]"
^DIC(9.4,5,22,13,"PAH",7,1,19,0)="Fixed problem with not checking for partial file sends.  [#22935874]"
^DIC(9.4,5,22,13,"PAH",7,1,20,0)="Fixed problem with not checking call's to missing tags in "
^DIC(9.4,5,22,13,"PAH",7,1,21,0)="routines not XINDEXed. [#24687607]"
^DIC(9.4,5,22,13,"PAH",7,1,22,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,23,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,24,0)="XTSUMBLD: "
^DIC(9.4,5,22,13,"PAH",7,1,25,0)="Has been updated to include the PRE, POST, and ENV check routines"
^DIC(9.4,5,22,13,"PAH",7,1,26,0)="from a BUILD when using the CHECK entry point.  [NOIS ISB-0896-31782]"
^DIC(9.4,5,22,13,"PAH",7,1,27,0)="Fixed a bug if a BUILD didn't have a package file link.  "
^DIC(9.4,5,22,13,"PAH",7,1,28,0)="Fixed a bug if a routine in the BUILD doesn't exist in the UCI."
^DIC(9.4,5,22,13,"PAH",7,1,29,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,30,0)="XTVNUM:"
^DIC(9.4,5,22,13,"PAH",7,1,31,0)="Will see that each routine from a build has the patch number"
^DIC(9.4,5,22,13,"PAH",7,1,32,0)="on the second line."
^DIC(9.4,5,22,13,"PAH",7,1,33,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,34,0)="%ZTPP:"
^DIC(9.4,5,22,13,"PAH",7,1,35,0)="Fixes problems with not printing lines like"
^DIC(9.4,5,22,13,"PAH",7,1,36,0)="label<linestart><cr>.  [NOIS HOU-0297-71103]"
^DIC(9.4,5,22,13,"PAH",7,1,37,0)=" "
^DIC(9.4,5,22,13,"PAH",7,1,38,0)="BUILT^XTRUTL:"
^DIC(9.4,5,22,13,"PAH",7,1,39,0)="Takes the routines in a KIDS BUILD and generates the following "
^DIC(9.4,5,22,13,"PAH",7,1,40,0)="list."
^DIC(9.4,5,22,13,"PAH",7,1,41,0)=""
^DIC(9.4,5,22,13,"PAH",7,1,42,0)="                 Checksum"
^DIC(9.4,5,22,13,"PAH",7,1,43,0)="Routine         Old       New      2nd Line"
^DIC(9.4,5,22,13,"PAH",7,1,44,0)="XINDEX        7227772   8229005    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,45,0)="XINDX1        6096231   6091882    **20**"
