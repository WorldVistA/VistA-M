^DIC(9.4,33,22,1.4,"PAH",32,1,210,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,211,0)=" 870    HL LOGICAL LINK"
^DIC(9.4,33,22,1.4,"PAH",32,1,212,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,213,0)="        3         LLP ONLINE (S), [0;4]  (old)"
