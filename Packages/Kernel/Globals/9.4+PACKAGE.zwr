^DIC(9.4,96,22,1.2,"PAH",23,1,222,0)="   It consisted of the following Install(s):"
^DIC(9.4,96,22,1.2,"PAH",23,1,223,0)="    DENT*1.2*41"
^DIC(9.4,96,22,1.2,"PAH",23,1,224,0)=" Checking Install for Package DENT*1.2*41"
^DIC(9.4,96,22,1.2,"PAH",23,1,225,0)="  "
^DIC(9.4,96,22,1.2,"PAH",23,1,226,0)=" Install Questions for DENT*1.2*41"
