^DIC(9.4,11,22,5.03,"PAH",15,0)="50 SEQ #35^3000405^1"
^DIC(9.4,11,22,5.03,"PAH",15,1,0)="^^190^190^3000405"
^DIC(9.4,11,22,5.03,"PAH",15,1,1,0)="VISTA Laboratory Package patch LA*5.2*50 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",15,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",15,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,4,0)="  "
^DIC(9.4,11,22,5.03,"PAH",15,1,5,0)="DESCRIPTION"
^DIC(9.4,11,22,5.03,"PAH",15,1,6,0)="==========="
^DIC(9.4,11,22,5.03,"PAH",15,1,7,0)=""
^DIC(9.4,11,22,5.03,"PAH",15,1,8,0)="When the Lab LEDI software needs to build a HL7 message to return lab "
^DIC(9.4,11,22,5.03,"PAH",15,1,9,0)="test results (ORU) to the collecting facility, the message building could"
^DIC(9.4,11,22,5.03,"PAH",15,1,10,0)="fail at the host laboratory facility causing the collecting facility not"
^DIC(9.4,11,22,5.03,"PAH",15,1,11,0)="to receive a result message. This problem occurs when the host lab's entry"
^DIC(9.4,11,22,5.03,"PAH",15,1,12,0)="for the collecting facility in the INSTITUTION file (#4) has an internal"
^DIC(9.4,11,22,5.03,"PAH",15,1,13,0)="entry number which is different from the VA Station Number. The software"
^DIC(9.4,11,22,5.03,"PAH",15,1,14,0)="is assuming that the station number and the internal entry are the same."
^DIC(9.4,11,22,5.03,"PAH",15,1,15,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,16,0)="Routine LA7VMSG has been changed to retrieve the VA Station Number from"
^DIC(9.4,11,22,5.03,"PAH",15,1,17,0)="the INSTITUTION file for the collecting facility's entry when the station"
^DIC(9.4,11,22,5.03,"PAH",15,1,18,0)="number is used in building the result (ORU) message."
^DIC(9.4,11,22,5.03,"PAH",15,1,19,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,21,0)=""
^DIC(9.4,11,22,5.03,"PAH",15,1,22,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",15,1,23,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",15,1,24,0)=" WPB-1199-31232"
^DIC(9.4,11,22,5.03,"PAH",15,1,25,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,27,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",15,1,28,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",15,1,29,0)="  West Palm Beach VAMC"
^DIC(9.4,11,22,5.03,"PAH",15,1,30,0)="  Miami VAMC"
^DIC(9.4,11,22,5.03,"PAH",15,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,32,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,33,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",15,1,34,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",15,1,35,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,36,0)="  The following is a list of routines included in this patch."
^DIC(9.4,11,22,5.03,"PAH",15,1,37,0)="  The second line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",15,1,38,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,39,0)="  <tab>;;5.2;AUTOMATED LAB INSTRUMENTS;**[Patch List]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",15,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,41,0)="                    CHECK^XTSUMBLD results"
^DIC(9.4,11,22,5.03,"PAH",15,1,42,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,43,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",15,1,44,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",15,1,45,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",15,1,46,0)="   LA50             N/A            4543400        **50**"
^DIC(9.4,11,22,5.03,"PAH",15,1,47,0)="   LA7VMSG          22591788       22442510       **27,50**"
^DIC(9.4,11,22,5.03,"PAH",15,1,48,0)="    "
^DIC(9.4,11,22,5.03,"PAH",15,1,49,0)="  "
^DIC(9.4,11,22,5.03,"PAH",15,1,50,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",15,1,51,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,52,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",15,1,53,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",15,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,55,0)="  The install time for this patch is less than 5 minutes. This patch"
^DIC(9.4,11,22,5.03,"PAH",15,1,56,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",15,1,57,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",15,1,58,0)="  However the following conditions apply:"
^DIC(9.4,11,22,5.03,"PAH",15,1,59,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,60,0)="     - All Laboratory test verification should be suspended. The install"
^DIC(9.4,11,22,5.03,"PAH",15,1,61,0)="       will disable lab verifying options during installation."
^DIC(9.4,11,22,5.03,"PAH",15,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,64,0)="NOTE: Kernel, MailMan and HL7 patches must be current on the target system"
^DIC(9.4,11,22,5.03,"PAH",15,1,65,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",15,1,66,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,67,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",15,1,68,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",15,1,69,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,70,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,71,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",15,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,73,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",15,1,74,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",15,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,76,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",15,1,77,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",15,1,78,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,79,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",15,1,80,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",15,1,81,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,82,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",15,1,83,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",15,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,85,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",15,1,86,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",15,1,87,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",15,1,88,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",15,1,89,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",15,1,90,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,91,0)="      If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,11,22,5.03,"PAH",15,1,92,0)="      prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,11,22,5.03,"PAH",15,1,93,0)="      option at this time.  You may also compare the routines in your"
^DIC(9.4,11,22,5.03,"PAH",15,1,94,0)="      production account to the routines in the patch by using the 'Compare"
^DIC(9.4,11,22,5.03,"PAH",15,1,95,0)="      a Transport Global to Current System' option."
^DIC(9.4,11,22,5.03,"PAH",15,1,96,0)="    "
^DIC(9.4,11,22,5.03,"PAH",15,1,97,0)="  7.  The install will disable the following Lab verifying options during"
^DIC(9.4,11,22,5.03,"PAH",15,1,98,0)="      patch installation."
^DIC(9.4,11,22,5.03,"PAH",15,1,99,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,100,0)="      Enter/verify data (auto instrument) [LRVR]"
^DIC(9.4,11,22,5.03,"PAH",15,1,101,0)="      Enter/verify data (Work list) [LRVRW]"
^DIC(9.4,11,22,5.03,"PAH",15,1,102,0)="      Enter/verify data (Load list) [LRVRW2]"
^DIC(9.4,11,22,5.03,"PAH",15,1,103,0)="      Batch data entry (chem, hem, tox, etc.) [LRSTUF]"
^DIC(9.4,11,22,5.03,"PAH",15,1,104,0)="      Group verify (EA, EL, EW) [LRGV]"
^DIC(9.4,11,22,5.03,"PAH",15,1,105,0)="  "
^DIC(9.4,11,22,5.03,"PAH",15,1,106,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,107,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",15,1,108,0)="      and select the package 'LA*5.2*50'.  When prompted 'Want to"
^DIC(9.4,11,22,5.03,"PAH",15,1,109,0)="      DISABLE Scheduled Options, Menu Options, and Protocols? YES//',"
^DIC(9.4,11,22,5.03,"PAH",15,1,110,0)="      choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",15,1,111,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,112,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",15,1,113,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,114,0)=" 10. Routine LA50 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",15,1,115,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,116,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,117,0)="POST-INSTALLATION INSTRUCTIONS: NONE"
^DIC(9.4,11,22,5.03,"PAH",15,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,119,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,120,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,121,0)=" "
^DIC(9.4,11,22,5.03,"PAH",15,1,122,0)="************************************************************************"
