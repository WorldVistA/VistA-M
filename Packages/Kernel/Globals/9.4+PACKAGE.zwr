^DIC(9.4,4,22,1,"PAH",85,1,29,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",85,1,30,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",85,1,31,0)="minimum.  It requires MailMan patch XM*7.1*107."
^DIC(9.4,4,22,1,"PAH",85,1,32,0)="1.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",85,1,33,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",85,1,34,0)="2.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",85,1,35,0)="3.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",85,1,36,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",85,1,37,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",85,1,38,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",85,1,39,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",85,1,40,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",85,1,41,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",85,1,42,0)=" Select INSTALL NAME:    XM*7.1*116    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",85,1,43,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",85,1,44,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",85,1,45,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",85,1,46,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",85,1,47,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",85,1,48,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",85,1,49,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",85,1,50,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",85,1,51,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",85,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",85,1,53,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",85,1,54,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",85,1,55,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",86,0)="109 SEQ #111^3000313^1"
^DIC(9.4,4,22,1,"PAH",86,1,0)="^^61^61^3000313"
^DIC(9.4,4,22,1,"PAH",86,1,1,0)="Patch XM*7.1*109"
^DIC(9.4,4,22,1,"PAH",86,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,3,0)="This patch may be installed at any time,"
^DIC(9.4,4,22,1,"PAH",86,1,4,0)="EXCEPT from 2/28/2000 through 3/3/2000 (the Leapyear Lockdown Period). "
^DIC(9.4,4,22,1,"PAH",86,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,6,0)="E3R:  13290"
^DIC(9.4,4,22,1,"PAH",86,1,7,0)="Test Site:  Washington CIOFO@Hampton"
^DIC(9.4,4,22,1,"PAH",86,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,9,0)="Adds a new API, $$GOTLOCAL^XMXAPIG, which checks a mail group to see if it"
^DIC(9.4,4,22,1,"PAH",86,1,10,0)="has any active local members.  This new API is supported, as described in"
^DIC(9.4,4,22,1,"PAH",86,1,11,0)="DBIA 3006."
^DIC(9.4,4,22,1,"PAH",86,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,13,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",86,1,14,0)="It requires MailMan patch XM*7.1*107."
^DIC(9.4,4,22,1,"PAH",86,1,15,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",86,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,17,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",86,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",86,1,19,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",86,1,20,0)=" "
^DIC(9.4,4,22,1,"PAH",86,1,21,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",86,1,22,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",86,1,23,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",86,1,24,0)="XMXAPIG        * NEW *         1672216        109"
^DIC(9.4,4,22,1,"PAH",86,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,26,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",86,1,27,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,28,0)="This patch introduces the following new routine:"
^DIC(9.4,4,22,1,"PAH",86,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",86,1,30,0)="Routine      Callable at     Description"
^DIC(9.4,4,22,1,"PAH",86,1,31,0)="---------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",86,1,32,0)="XMXAPIG      $$GOTLOCAL      Does a mail group have any active local members?"
^DIC(9.4,4,22,1,"PAH",86,1,33,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",86,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",86,1,35,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",86,1,36,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",86,1,37,0)="It requires MailMan patch XM*7.1*107."
^DIC(9.4,4,22,1,"PAH",86,1,38,0)="1.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",86,1,39,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",86,1,40,0)="2.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",86,1,41,0)="3.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",86,1,42,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",86,1,43,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",86,1,44,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",86,1,45,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",86,1,46,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",86,1,47,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",86,1,48,0)=" Select INSTALL NAME:    XM*7.1*109    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",86,1,49,0)="                         =========="
