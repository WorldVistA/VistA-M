^DIC(9.4,73,22,9,"PAH",10,1,30,0)="         "
^DIC(9.4,73,22,9,"PAH",10,1,31,0)="   The following routines are included in this patch.  The"
^DIC(9.4,73,22,9,"PAH",10,1,32,0)="   second line of each of these routines now looks like:                  "
^DIC(9.4,73,22,9,"PAH",10,1,33,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,34,0)="   <tab>;;5.1;Network Health Exchange;**[patch list]**;Date"
