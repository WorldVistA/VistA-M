^DIC(9.4,152,22,1,"PAH",4,0)="9^2980417^1"
^DIC(9.4,152,22,1,"PAH",4,1,0)="^^1^1^2980417"
^DIC(9.4,152,22,1,"PAH",4,1,1,0)="Refer to the patch for the patch description."
^DIC(9.4,152,22,1,"PAH",5,0)="10^2980511^1"
^DIC(9.4,152,22,1,"PAH",5,1,0)="^^2^2^2980511"
^DIC(9.4,152,22,1,"PAH",5,1,1,0)="This is the beta version of patch 10 of the HBHC v1.0 software, with patches"
^DIC(9.4,152,22,1,"PAH",5,1,2,0)="1-9 installed. "
^DIC(9.4,152,22,1,"PAH",6,0)="12 SEQ #11^2980923^1"
^DIC(9.4,152,22,1,"PAH",6,1,0)="^^5^5^2980923"
^DIC(9.4,152,22,1,"PAH",6,1,1,0)="This patch will delete & re-create all FY98 visit information in HBHC VISIT"
^DIC(9.4,152,22,1,"PAH",6,1,2,0)="(632) file from Outpatient Encounter (409.68) data.  Corresponding old file"
^DIC(9.4,152,22,1,"PAH",6,1,3,0)="information is also cleaned up in files:  Transmit (634), Transmit History"
^DIC(9.4,152,22,1,"PAH",6,1,4,0)="(634.6), Admission Errors (634.1), Visit Errors (634.2), Discharge Errors"
^DIC(9.4,152,22,1,"PAH",6,1,5,0)="(634.3)."
^DIC(9.4,152,22,1,"PAH",7,0)="11 SEQ #12^2981007^1"
^DIC(9.4,152,22,1,"PAH",7,1,0)="^^1^1^2981007"
^DIC(9.4,152,22,1,"PAH",7,1,1,0)="Patch HBH*1.0*11"
^DIC(9.4,152,22,1,"PAH",8,0)="13 SEQ #13^2991003^1"
^DIC(9.4,152,22,1,"PAH",8,1,0)="^^1^1^2991003"
^DIC(9.4,152,22,1,"PAH",8,1,1,0)="This is the beta version of patch 13, vT1."
^DIC(9.4,152,22,1,"PAH",9,0)="15 SEQ #14^2991019^1"
^DIC(9.4,152,22,1,"PAH",9,1,0)="^^1^1^2991019"
^DIC(9.4,152,22,1,"PAH",9,1,1,0)="This is HBH*1.0*15"
^DIC(9.4,152,22,1,"PAH",10,0)="17 SEQ #15^2991123^1"
^DIC(9.4,152,22,1,"PAH",10,1,0)="^^1^1^2991123"
^DIC(9.4,152,22,1,"PAH",10,1,1,0)="This is HBH*1.0*17"
^DIC(9.4,152,22,1,"PAH",11,0)="16 SEQ #16^3000711^1"
^DIC(9.4,152,22,1,"PAH",11,1,0)="^^1^1^3000711"
^DIC(9.4,152,22,1,"PAH",11,1,1,0)="This is HBH*1.0*16"
^DIC(9.4,152,22,1,"PAH",12,0)="14 SEQ #17^3010405^1"
^DIC(9.4,152,22,1,"PAH",12,1,0)="^^1^1^3010405"
^DIC(9.4,152,22,1,"PAH",12,1,1,0)="This is HBH*1.0*14"
^DIC(9.4,152,22,1,"PAH",13,0)="19 SEQ #18^3030301^1"
^DIC(9.4,152,22,1,"PAH",13,1,0)="^^1^1^3030301"
^DIC(9.4,152,22,1,"PAH",13,1,1,0)="This is HBH*1.0*19, Race/Ethnicity Mods, & Routine 2nd Line Correction"
^DIC(9.4,152,22,1,"PAH",14,0)="21 SEQ #19^3050506^1"
^DIC(9.4,152,22,1,"PAH",14,1,0)="^^1^1^3050506"
^DIC(9.4,152,22,1,"PAH",14,1,1,0)="HBH*1.0*21, Patient Days of Care Report & Report Updates"
^DIC(9.4,152,22,1,"PAH",15,0)="22 SEQ #20^3070629.192133^1"
^DIC(9.4,152,22,1,"PAH",15,1,0)="^^1^1^3070629"
^DIC(9.4,152,22,1,"PAH",15,1,1,0)="HBH*1.0*22, Shorten SSN to Last Four on Reports "
^DIC(9.4,152,22,1,"PAH",16,0)="24 SEQ #21^3090928.152841^17"
^DIC(9.4,152,22,1,"PAH",16,1,0)="^^1^1^3090928"
^DIC(9.4,152,22,1,"PAH",16,1,1,0)="HBH*1.0*24, Medical Foster Home (MFH) Functionality "
^DIC(9.4,152,22,1,"PAH",17,0)="25 SEQ #23^3140902.125449^17"
^DIC(9.4,152,22,1,"PAH",17,1,0)="^^1^1^3140902"
^DIC(9.4,152,22,1,"PAH",17,1,1,0)="Build for ICD-10 Class 1 Remediation"
^DIC(9.4,152,22,1,"PAH",18,0)="27 SEQ #24^3150608.114431^17"
^DIC(9.4,152,22,1,"PAH",18,1,0)="^^6^6^3150608"
^DIC(9.4,152,22,1,"PAH",18,1,1,0)="This patch addresses one Home Based Primary Care (HBH) issue:"
^DIC(9.4,152,22,1,"PAH",18,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",18,1,3,0)="1. The BUILD/VERIFY TRANSMISSION FILE option currently lacks the "
^DIC(9.4,152,22,1,"PAH",18,1,4,0)="functionality to prevent test patient data from being built into the HBHC "
^DIC(9.4,152,22,1,"PAH",18,1,5,0)="TRANSMIT (#634) file for transmission to Austin. A request was made for "
^DIC(9.4,152,22,1,"PAH",18,1,6,0)="this functionality to be implemented. "
^DIC(9.4,152,22,1,"PAH",19,0)="28 SEQ #25^3150817.124024^17"
^DIC(9.4,152,22,1,"PAH",19,1,0)="^^1^1^3150817"
^DIC(9.4,152,22,1,"PAH",19,1,1,0)="Total Visits by Date Range Report [HBHCRP21] CPT Code Omission Update"
^DIC(9.4,152,22,1,"PAH",20,0)="29 SEQ #26^3160923.155202^54"
^DIC(9.4,152,22,1,"PAH",20,1,0)="^^5^5^3160923"
^DIC(9.4,152,22,1,"PAH",20,1,1,0)="A user has reported an undefined error in FileMan when editing the COUNTY "
^DIC(9.4,152,22,1,"PAH",20,1,2,0)="CODE (#25) field in the HBHC MEDICAL FOSTER HOME (#633.2) file. This "
^DIC(9.4,152,22,1,"PAH",20,1,3,0)="issue is caused by the code in the INPUT/OUTPUT TRANSFORM for this field. "
^DIC(9.4,152,22,1,"PAH",20,1,4,0)="Patch HBH*1.0*29 will update the Data Dictionary by removing the variable "
^DIC(9.4,152,22,1,"PAH",20,1,5,0)="D0 from all KILL commands preventing the error from occurring."
^DIC(9.4,152,22,1,"PAH",21,0)="30 SEQ #27^3171226.115338^54"
^DIC(9.4,152,22,1,"PAH",21,1,0)="^^4^4^3171226"
^DIC(9.4,152,22,1,"PAH",21,1,1,0)="Patch HBH*1*30 addresses the following issue:"
^DIC(9.4,152,22,1,"PAH",21,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",21,1,3,0)="1.      HBHC Medical Foster Home File (#633.2), Caregiver Date of Birth "
^DIC(9.4,152,22,1,"PAH",21,1,4,0)="Field (#26) is hard coded to only accept dates between 1/1/20-4/30/87. "
^DIC(9.4,152,22,1,"PAH",22,0)="33b^3210701"
^DIC(9.4,152,22,1,"PAH",22,1,0)="^^5^5^3210701"
^DIC(9.4,152,22,1,"PAH",22,1,1,0)="Backup of HBH*1.0*33 on Jul 01, 2021"
^DIC(9.4,152,22,1,"PAH",22,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",22,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,152,22,1,"PAH",22,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,152,22,1,"PAH",22,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,152,22,1,"PAH",23,0)="33 SEQ #28^3210701.113012^17"
^DIC(9.4,152,22,1,"PAH",23,1,0)="^^6^6^3210701"
^DIC(9.4,152,22,1,"PAH",23,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,152,22,1,"PAH",23,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",23,1,3,0)="1.  An error can occur when running the HBPC Medical Foster Home "
^DIC(9.4,152,22,1,"PAH",23,1,4,0)="    (MFH) Rate Paid Report in the Home Based Health Care application"
^DIC(9.4,152,22,1,"PAH",23,1,5,0)="    in VistA.  The report my error out when using the Active or All"
^DIC(9.4,152,22,1,"PAH",23,1,6,0)="    patient selections when listing Current or All rates paid."
^DIC(9.4,152,22,1,"PAH",24,0)="32b^3210809"
^DIC(9.4,152,22,1,"PAH",24,1,0)="^^5^5^3210809"
^DIC(9.4,152,22,1,"PAH",24,1,1,0)="Backup of HBH*1.0*32 on Aug 09, 2021"
^DIC(9.4,152,22,1,"PAH",24,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",24,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,152,22,1,"PAH",24,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,152,22,1,"PAH",24,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,152,22,1,"PAH",25,0)="32 SEQ #29^3210809.123915^17"
^DIC(9.4,152,22,1,"PAH",25,1,0)="^^11^11^3210809"
^DIC(9.4,152,22,1,"PAH",25,1,1,0)="This patch includes the following enhancements:"
^DIC(9.4,152,22,1,"PAH",25,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",25,1,3,0)="1. Modify the VistA-HBPC module to increase the number of providers that "
^DIC(9.4,152,22,1,"PAH",25,1,4,0)="   can be assigned a unique Provider Number."
^DIC(9.4,152,22,1,"PAH",25,1,5,0)=" "
^DIC(9.4,152,22,1,"PAH",25,1,6,0)="2. Modify the VistA-HBPC module to add the site number with suffix-level "
^DIC(9.4,152,22,1,"PAH",25,1,7,0)="   granularity to patient-level HBPC data for each patient admission to an"
^DIC(9.4,152,22,1,"PAH",25,1,8,0)="   HBPC Program."
^DIC(9.4,152,22,1,"PAH",25,1,9,0)=" "
^DIC(9.4,152,22,1,"PAH",25,1,10,0)="3. Various other minor changes to the HBHC logic. Refer to the full patch "
^DIC(9.4,152,22,1,"PAH",25,1,11,0)="   description in FORUM for more information."
^DIC(9.4,152,22,1,"PAH",26,0)="34 SEQ #30^3210929.144943^17"
^DIC(9.4,152,22,1,"PAH",26,1,0)="^^6^6^3210929"
^DIC(9.4,152,22,1,"PAH",26,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,152,22,1,"PAH",26,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",26,1,3,0)="The ""Expanded Program Census Report"" might generate an error when "
^DIC(9.4,152,22,1,"PAH",26,1,4,0)="encountering a patient with no visits for the specified date range. The "
^DIC(9.4,152,22,1,"PAH",26,1,5,0)="error is caused by variable HBHCSTOP not being initialized as a fail-safe "
^DIC(9.4,152,22,1,"PAH",26,1,6,0)="in case the patient's data does not meet certain criteria."
^DIC(9.4,152,22,1,"PAH",27,0)="35 SEQ #31^3250116.095833^89"
^DIC(9.4,152,22,1,"PAH",27,1,0)="^^6^6^3250116"
^DIC(9.4,152,22,1,"PAH",27,1,1,0)="This patch addresses one issue:"
^DIC(9.4,152,22,1,"PAH",27,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",27,1,3,0)="In certain instances, when creating a new HBHC admission with the VistA "
^DIC(9.4,152,22,1,"PAH",27,1,4,0)="option Evaluation/Admission Data Entry [HBHCADM], the default home state "
^DIC(9.4,152,22,1,"PAH",27,1,5,0)="that is displayed for the patient's STATE CODE is not the same as the "
^DIC(9.4,152,22,1,"PAH",27,1,6,0)="patient's home state."
^DIC(9.4,152,22,1,"PAH",28,0)="36 SEQ #32^3260114.130742^90"
^DIC(9.4,152,22,1,"PAH",28,1,0)="^^6^6^3260114"
^DIC(9.4,152,22,1,"PAH",28,1,1,0)="This patch addresses one issue:"
^DIC(9.4,152,22,1,"PAH",28,1,2,0)=" "
^DIC(9.4,152,22,1,"PAH",28,1,3,0)="It is possible to run options ""Build/Verify Transmission File"" [HBHCFILE] "
^DIC(9.4,152,22,1,"PAH",28,1,4,0)="and ""Transmit File to Austin"" [HBHCXMT] simultaneously.  When this "
^DIC(9.4,152,22,1,"PAH",28,1,5,0)="happens, the Build/Verify job can delete the HBHC TRANSMIT (#634) file "
^DIC(9.4,152,22,1,"PAH",28,1,6,0)="out from underneath the Transmit job and cause hard error DQ^HBHCXMT.   "
^DIC(9.4,152,22,1,"PAH","B",9,4)=""
