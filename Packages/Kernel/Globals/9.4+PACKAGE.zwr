^DIC(9.4,232,0)="JOINT LEGACY VIEWER^JLV^JOINT LEGACY VIEWER"
^DIC(9.4,232,7)="^^I"
^DIC(9.4,232,22,0)="^9.49I^4^4"
^DIC(9.4,232,22,1,0)=2.8
^DIC(9.4,232,22,1,"PAH",0)="^9.4901^3^3"
^DIC(9.4,232,22,1,"PAH",1,0)="3 SEQ #3^3200127.115222^65"
^DIC(9.4,232,22,1,"PAH",1,1,0)="^^2^2^3200127"
^DIC(9.4,232,22,1,"PAH",1,1,1,0)="JLV*2.8*3 - add RPCs to JLV Webservice. Please read the patch desciption "
^DIC(9.4,232,22,1,"PAH",1,1,2,0)="for more details."
^DIC(9.4,232,22,1,"PAH",2,0)="5 SEQ #5^3200410.155012^70"
^DIC(9.4,232,22,1,"PAH",2,1,0)="^^2^2^3200410"
^DIC(9.4,232,22,1,"PAH",2,1,1,0)="JLV*2.8*5 - added XUS SET VISITOR and ORWLR CUMULATIVE REPORT RPCs to JLV"
^DIC(9.4,232,22,1,"PAH",2,1,2,0)="Webservice. Please read the patch desciption for more details."
^DIC(9.4,232,22,1,"PAH",3,0)="6 SEQ #6^3200601.152937^70"
^DIC(9.4,232,22,1,"PAH",3,1,0)="^^2^2^3200601"
^DIC(9.4,232,22,1,"PAH",3,1,1,0)="This patch will add the new COVID-19 Identifier RPC ORWPT2 COVID to the"
^DIC(9.4,232,22,1,"PAH",3,1,2,0)="JLV WEB SERVICES menu option."
^DIC(9.4,232,22,1,"PAH","B","3 SEQ #3",1)=""
^DIC(9.4,232,22,1,"PAH","B","5 SEQ #5",2)=""
^DIC(9.4,232,22,1,"PAH","B","6 SEQ #6",3)=""
^DIC(9.4,232,22,2,0)="2.9^3200611^3200730^65"
^DIC(9.4,232,22,2,"PAH",0)="^9.4901^1^1"
^DIC(9.4,232,22,2,"PAH",1,0)="1 SEQ #1^3200730.152403^65"
^DIC(9.4,232,22,2,"PAH",1,1,0)="^^4^4^3200730"
^DIC(9.4,232,22,2,"PAH",1,1,1,0)="JLV*2.9*1 adds needed RPCs to the JLV WEB SERVICES option, and removes "
^DIC(9.4,232,22,2,"PAH",1,1,2,0)="multiple RPCs no longer needed.  In addition the CURRENT VERSION field of"
^DIC(9.4,232,22,2,"PAH",1,1,3,0)="the PACKAGE(#9.4) file will be updated to 2.9 for the JOINT LEGACY VIEWER"
^DIC(9.4,232,22,2,"PAH",1,1,4,0)="entry."
^DIC(9.4,232,22,2,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,232,22,3,0)="3^3220301^3220301^16"
^DIC(9.4,232,22,4,0)="3.0^3260401^3260508^90"
^DIC(9.4,232,22,4,"PAH",0)="^9.4901^1^1"
^DIC(9.4,232,22,4,"PAH",1,0)="59 SEQ #57^3260508.090824^90"
^DIC(9.4,232,22,4,"PAH",1,1,0)="^^1^1^3260508"
^DIC(9.4,232,22,4,"PAH",1,1,1,0)="Subject:  JLV SECURITY KEY TO RESTRICT COMMUNITY HEALTH SUMMARIES WIDGET"
