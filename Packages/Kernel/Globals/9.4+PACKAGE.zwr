^DIC(9.4,3,22,21,"PAH",171,0)="208 SEQ #178^3011121^1"
^DIC(9.4,3,22,21,"PAH",171,1,0)="^^116^116^3011121"
^DIC(9.4,3,22,21,"PAH",171,1,1,0)="Patch XU*8.0*208, Strong Verify clean-up"
^DIC(9.4,3,22,21,"PAH",171,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,3,0)="This Patch Addresses the Following NOIS Calls:"
^DIC(9.4,3,22,21,"PAH",171,1,4,0)="=============================================="
^DIC(9.4,3,22,21,"PAH",171,1,5,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,6,0)="1. DAY-0501-41059"
^DIC(9.4,3,22,21,"PAH",171,1,7,0)="2. FOR-0701-20582"
^DIC(9.4,3,22,21,"PAH",171,1,8,0)="3. CLE-0601-42777"
^DIC(9.4,3,22,21,"PAH",171,1,9,0)="4. MEM-0701-70137"
^DIC(9.4,3,22,21,"PAH",171,1,10,0)="5. MIN-0701-40152"
^DIC(9.4,3,22,21,"PAH",171,1,11,0)="6. DEN-0701-50838"
^DIC(9.4,3,22,21,"PAH",171,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,14,0)="Patch XU*8.0*208 is composed of the following two parts. Each part is described"
^DIC(9.4,3,22,21,"PAH",171,1,15,0)="in the form of a Problem Statement and Patch Solution as follows."
^DIC(9.4,3,22,21,"PAH",171,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,17,0)="NOTE: All fields added or modified by this patch (XU*8.0*208) and referenced in"
^DIC(9.4,3,22,21,"PAH",171,1,18,0)="this patch description reside in the NEW PERSON file (#200)."
^DIC(9.4,3,22,21,"PAH",171,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,20,0)="Part 1 - Problem Statement:"
^DIC(9.4,3,22,21,"PAH",171,1,21,0)="---------------------------"
^DIC(9.4,3,22,21,"PAH",171,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,23,0)="Patch XU*8*180 introduced a feature whereby the DISUSER flag (#7) was set for"
^DIC(9.4,3,22,21,"PAH",171,1,24,0)="any user that had not signed onto the system in the last 90 days.  This caused"
^DIC(9.4,3,22,21,"PAH",171,1,25,0)="the problem that if the DISUSER flag was cleared and the user did not sign onto"
^DIC(9.4,3,22,21,"PAH",171,1,26,0)="the system before the next scheduled time for the XUAUTODEACTIVATE option to"
^DIC(9.4,3,22,21,"PAH",171,1,27,0)="run, the DISUSER flag was being set again, causing extra work for IRM. The same"
^DIC(9.4,3,22,21,"PAH",171,1,28,0)="problem occurred when a user that was reactivated did not sign onto the system"
^DIC(9.4,3,22,21,"PAH",171,1,29,0)="before the XUAUTODEACTIVATE option ran."
^DIC(9.4,3,22,21,"PAH",171,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,31,0)="Part 1 - Patch Solution:"
^DIC(9.4,3,22,21,"PAH",171,1,32,0)="------------------------"
^DIC(9.4,3,22,21,"PAH",171,1,33,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,34,0)="To fix this problem, a new field ENTRY LAST EDIT DATE (#202.04) was added to"
^DIC(9.4,3,22,21,"PAH",171,1,35,0)="the NEW PERSON file (#200) to keep track of the date of some edits. The"
^DIC(9.4,3,22,21,"PAH",171,1,36,0)="following fields now trigger the current date to the ENTRY LAST EDIT DATE"
^DIC(9.4,3,22,21,"PAH",171,1,37,0)="field: DISUSER, ACCESS CODE (#2), and TERMINATION DATE (#9.2)."
^DIC(9.4,3,22,21,"PAH",171,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,39,0)="The conditions under which the DISUSER field is set have also been changed. If"
^DIC(9.4,3,22,21,"PAH",171,1,40,0)="any of the following conditions are true, we don't set the DISUSER flag:"
^DIC(9.4,3,22,21,"PAH",171,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,42,0)="        ;Last sign-on within 90 days"
^DIC(9.4,3,22,21,"PAH",171,1,43,0)="        ;User edited in last 30 days"
^DIC(9.4,3,22,21,"PAH",171,1,44,0)="        ;User set up in last 30 days"
^DIC(9.4,3,22,21,"PAH",171,1,45,0)="        ;Verify code changed in last 30 days"
^DIC(9.4,3,22,21,"PAH",171,1,46,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,47,0)="The TERMINATION DATE and DISUSER fields were moved to the first page of the"
^DIC(9.4,3,22,21,"PAH",171,1,48,0)="Edit an Existing User ScreenMan form to make them easier to see."
^DIC(9.4,3,22,21,"PAH",171,1,49,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,51,0)="Part 2 - Problem Statement:"
^DIC(9.4,3,22,21,"PAH",171,1,52,0)="---------------------------"
^DIC(9.4,3,22,21,"PAH",171,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,54,0)="A problem was identified in that not all sign-on code (i.e. XUP, WebMail, POP3"
^DIC(9.4,3,22,21,"PAH",171,1,55,0)="server) was setting the LAST SIGN-ON DATE field (#202)."
^DIC(9.4,3,22,21,"PAH",171,1,56,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,57,0)="Part 2 - Patch Solution:"
^DIC(9.4,3,22,21,"PAH",171,1,58,0)="------------------------"
^DIC(9.4,3,22,21,"PAH",171,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,60,0)="The known places where this was happening have been fixed. Specifically they"
^DIC(9.4,3,22,21,"PAH",171,1,61,0)="were: XUP and XUSRA that POP3.  WEBMAIL has been patched on FORUM."
^DIC(9.4,3,22,21,"PAH",171,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",171,1,63,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",171,1,64,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",171,1,65,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",171,1,66,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
