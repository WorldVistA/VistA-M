^DIC(9.4,3,22,21,"PAH",31,1,63,0)="XPDCOM       2299089         5277873        21,58"
^DIC(9.4,3,22,21,"PAH",31,1,64,0)="XPDET        5054366         5058369        15,39,41,44,51,58"
