^DIC(9.4,140,22,20,"PAH",74,1,0)="^^1^1^3050611"
^DIC(9.4,140,22,20,"PAH",74,1,1,0)="Please see FORUM for full patch description."
^DIC(9.4,140,22,20,"PAH",75,0)="105 SEQ #84^3050813^1"
^DIC(9.4,140,22,20,"PAH",75,1,0)="^^3^3^3050813"
^DIC(9.4,140,22,20,"PAH",75,1,1,0)="This patch will address two issues;"
^DIC(9.4,140,22,20,"PAH",75,1,2,0)="  1. Problem accessing the 2319 correspondence letter prompt."
^DIC(9.4,140,22,20,"PAH",75,1,3,0)="  2. The use of the % variable in 3 routines."
^DIC(9.4,140,22,20,"PAH",76,0)="111 SEQ #85^3050813^1"
^DIC(9.4,140,22,20,"PAH",76,1,0)="^^2^2^3050813"
^DIC(9.4,140,22,20,"PAH",76,1,1,0)="Fix to the Prosthetics Reconciliation process to compare the correct "
^DIC(9.4,140,22,20,"PAH",76,1,2,0)="dollar amounts so the program will not trigger an ammendment."
^DIC(9.4,140,22,20,"PAH",77,0)="112 SEQ #86^3050813^1"
^DIC(9.4,140,22,20,"PAH",77,1,0)="^^2^2^3050813"
^DIC(9.4,140,22,20,"PAH",77,1,1,0)="SYNTAX error during merge process due to Prosthetics package having null "
^DIC(9.4,140,22,20,"PAH",77,1,2,0)="routine node in Package File (9.4) due to incorrect KIDS build."
^DIC(9.4,140,22,20,"PAH",78,0)="78^3050905^1"
^DIC(9.4,140,22,20,"PAH",78,1,0)="^^1^1^3050905"
^DIC(9.4,140,22,20,"PAH",78,1,1,0)="PROSTHETICS CLINICAL INDICATOR DATA CAPTURE BUILD"
^DIC(9.4,140,22,20,"PAH",79,0)="90 SEQ #88^3050924^1"
^DIC(9.4,140,22,20,"PAH",80,0)="113 SEQ #89^3050924^1"
^DIC(9.4,140,22,20,"PAH",81,0)="114 SEQ #90^3050924^1"
^DIC(9.4,140,22,20,"PAH",81,1,0)="^^1^1^3050924"
^DIC(9.4,140,22,20,"PAH",81,1,1,0)="SUBSCRIPT ERROR/PCE ERROR MESSAGE"
^DIC(9.4,140,22,20,"PAH",82,0)="108 SEQ #91^3060213^1"
^DIC(9.4,140,22,20,"PAH",82,1,0)="^^4^4^3060213"
^DIC(9.4,140,22,20,"PAH",82,1,1,0)="This patch will address three issues:"
^DIC(9.4,140,22,20,"PAH",82,1,2,0)="  1. The hard coded Default Barcode Printer Name"
^DIC(9.4,140,22,20,"PAH",82,1,3,0)="  2. The P-ZEBRA printer subtype requirement"
^DIC(9.4,140,22,20,"PAH",82,1,4,0)="  3. Items still being added to a inactive location"
^DIC(9.4,140,22,20,"PAH",83,0)="116 SEQ #92^3060213^1"
^DIC(9.4,140,22,20,"PAH",84,0)="115 SEQ #93^3060504^1"
^DIC(9.4,140,22,20,"PAH",84,1,0)="^^4^4^3060504"
^DIC(9.4,140,22,20,"PAH",84,1,1,0)=" "
^DIC(9.4,140,22,20,"PAH",84,1,2,0)="1. RMPR Clerk Menu not prompting for site"
^DIC(9.4,140,22,20,"PAH",84,1,3,0)="2. Extra line feeds in Purchase Order ITEMS section after patch 90"
^DIC(9.4,140,22,20,"PAH",84,1,4,0)="3. Oxygen letters: site name wrapping into patient's address"
^DIC(9.4,140,22,20,"PAH",85,0)="127 SEQ #94^3060504^1"
^DIC(9.4,140,22,20,"PAH",85,1,0)="^^4^4^3060504"
^DIC(9.4,140,22,20,"PAH",85,1,1,0)="1. PIP roll-up does not match local Item Detail Report."
^DIC(9.4,140,22,20,"PAH",85,1,2,0)=" "
^DIC(9.4,140,22,20,"PAH",85,1,3,0)="2.  Fix the ien for station number starting point in PIP Extract "
^DIC(9.4,140,22,20,"PAH",85,1,4,0)="    collection to begin at station ien 1 instead of 2."
^DIC(9.4,140,22,20,"PAH",86,0)="117 SEQ #95^3060525^1"
^DIC(9.4,140,22,20,"PAH",86,1,0)="^^6^6^3060525"
^DIC(9.4,140,22,20,"PAH",86,1,1,0)="1.  Delete Field 19 (bogus entry) in File #660 which comflicts with"
^DIC(9.4,140,22,20,"PAH",86,1,2,0)="    field 4.1 of same file, both using node 0, piece 22."
^DIC(9.4,140,22,20,"PAH",86,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",86,1,4,0)="2.  Prevent dual entries in File #661.6 and #661.7 from having time "
^DIC(9.4,140,22,20,"PAH",86,1,5,0)="    stamp one second apart for ""return-in"" when piece 6 of Suspense"
^DIC(9.4,140,22,20,"PAH",86,1,6,0)="    file #661.63) is null."
^DIC(9.4,140,22,20,"PAH",87,0)="118 SEQ #96^3060525^1"
^DIC(9.4,140,22,20,"PAH",87,1,0)="^^9^9^3060525"
^DIC(9.4,140,22,20,"PAH",87,1,1,0)="1. When using the option 'RMPR WH DISPLAY' and the DELIVER TO field is "
^DIC(9.4,140,22,20,"PAH",87,1,2,0)="   'other' print ""Deliver To Attention"" on 2nd line."
^DIC(9.4,140,22,20,"PAH",87,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",87,1,4,0)="2. When using the option  RECONCILE/CLOSE OUT PURCHASE C  RMPR4 CLOSE "
^DIC(9.4,140,22,20,"PAH",87,1,5,0)="   OUT     [Reconcile/Close Out Purchase Card Transaction] Shipment Date "
^DIC(9.4,140,22,20,"PAH",87,1,6,0)="   will occur for date query for each item on the Purchase Card."
^DIC(9.4,140,22,20,"PAH",87,1,7,0)=" "
^DIC(9.4,140,22,20,"PAH",87,1,8,0)="3. Prosthetics location prompt is case sensitive when using option [UP  "
^DIC(9.4,140,22,20,"PAH",87,1,9,0)="   Reconcile Item Balance]."
^DIC(9.4,140,22,20,"PAH",88,0)="98 SEQ #97^3060608^1"
^DIC(9.4,140,22,20,"PAH",88,1,0)="^^1^1^3060608"
^DIC(9.4,140,22,20,"PAH",88,1,1,0)="Prosthetics PFSS"
^DIC(9.4,140,22,20,"PAH",89,0)="124 SEQ #98^3060711^1"
^DIC(9.4,140,22,20,"PAH",89,1,0)="^^2^2^3060711"
^DIC(9.4,140,22,20,"PAH",89,1,1,0)="PROSTHETICS GUI PURCHASING NOT ADHERING TO VISTA FM DATA DICTIONARY FIELD"
^DIC(9.4,140,22,20,"PAH",89,1,2,0)="LENGTHS FOR FILES #664/660."
^DIC(9.4,140,22,20,"PAH",90,0)="121 SEQ #99^3060711^1"
^DIC(9.4,140,22,20,"PAH",90,1,0)="^^3^3^3060711"
^DIC(9.4,140,22,20,"PAH",90,1,1,0)="1. Delete issue from stock error <SUBSCRIPT>DEL68^RMPRPCED"
^DIC(9.4,140,22,20,"PAH",90,1,2,0)=" "
^DIC(9.4,140,22,20,"PAH",90,1,3,0)="2. Problem with option, Edit/Delte Issue from Stock "
^DIC(9.4,140,22,20,"PAH",91,0)="120 SEQ #100^3060711^1"
^DIC(9.4,140,22,20,"PAH",91,1,0)="^^8^8^3060711"
^DIC(9.4,140,22,20,"PAH",91,1,1,0)="1. Up-arrow out of option [RMPR INQ SUSPENSE] and going to option [RMPR "
^DIC(9.4,140,22,20,"PAH",91,1,2,0)="   SUSP] will use the same patient from the initial inquiry, instead of"
^DIC(9.4,140,22,20,"PAH",91,1,3,0)="   prompting for new patient name."
^DIC(9.4,140,22,20,"PAH",91,1,4,0)=" "
^DIC(9.4,140,22,20,"PAH",91,1,5,0)="2. Consult cloning carries over inactive ICD9 diagnosis codes."
^DIC(9.4,140,22,20,"PAH",91,1,6,0)=" "
^DIC(9.4,140,22,20,"PAH",91,1,7,0)="3. Bad entries (null) in the VISIT File (9000010) when RMPR PCE "
^DIC(9.4,140,22,20,"PAH",91,1,8,0)="   BACKGROUND job running. "
^DIC(9.4,140,22,20,"PAH",92,0)="110 SEQ #101^3060807^1"
^DIC(9.4,140,22,20,"PAH",92,1,0)="^^4^4^3060807"
^DIC(9.4,140,22,20,"PAH",92,1,1,0)="1. Type of Transaction data missing in Extract."
^DIC(9.4,140,22,20,"PAH",92,1,2,0)=" "
^DIC(9.4,140,22,20,"PAH",92,1,3,0)="2. HOME/O2 Suspense Issue - PROSTHETICS PATIENT RECORDS NOT LINKED"
^DIC(9.4,140,22,20,"PAH",92,1,4,0)="    TO SUSPENSE."
^DIC(9.4,140,22,20,"PAH",93,0)="128 SEQ #102^3060923.020316^1"
^DIC(9.4,140,22,20,"PAH",93,1,0)="^^6^6^3060923"
^DIC(9.4,140,22,20,"PAH",93,1,1,0)="1. UNDEF ITM+9^RMPR29 - variable rmtype NULL"
^DIC(9.4,140,22,20,"PAH",93,1,2,0)=" "
^DIC(9.4,140,22,20,"PAH",93,1,3,0)="2. Institution IEN appears instead of station number on PSAS HCPCS HISTORY"
^DIC(9.4,140,22,20,"PAH",93,1,4,0)="   and Nightly PCE Background mail message"
^DIC(9.4,140,22,20,"PAH",93,1,5,0)=" "
^DIC(9.4,140,22,20,"PAH",93,1,6,0)="3. Inventory does not always update correctly with quantity issued "
^DIC(9.4,140,22,20,"PAH",94,0)="93 SEQ #103^3061122.231101^1"
^DIC(9.4,140,22,20,"PAH",95,0)="131 SEQ #104^3061122.234457^1"
^DIC(9.4,140,22,20,"PAH",95,1,0)="^^5^5^3061122"
^DIC(9.4,140,22,20,"PAH",95,1,1,0)="Prosthetics midnight processing of issues to PCE causing invalid data "
^DIC(9.4,140,22,20,"PAH",95,1,2,0)="structures in file #900010,VISIT "
^DIC(9.4,140,22,20,"PAH",95,1,3,0)=" a. Subscript error in Austin transmission <SUBSCRIPT>SITE+10^VASITE"
^DIC(9.4,140,22,20,"PAH",95,1,4,0)=" b. File entry points to another patient"
^DIC(9.4,140,22,20,"PAH",95,1,5,0)=" c. AMBCARE data into Austin"
^DIC(9.4,140,22,20,"PAH",96,0)="129 SEQ #105^3070627.212438^1"
^DIC(9.4,140,22,20,"PAH",96,1,0)="^^6^6^3070627"
^DIC(9.4,140,22,20,"PAH",96,1,1,0)="1. 2421 FORM filing DELIVER TO and DELIVER TO ATTENTION in files 660 and "
^DIC(9.4,140,22,20,"PAH",96,1,2,0)="   664 incorrectly."
^DIC(9.4,140,22,20,"PAH",96,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",96,1,4,0)="2. Full SSNs still visible in regular 2421"
^DIC(9.4,140,22,20,"PAH",96,1,5,0)=" "
^DIC(9.4,140,22,20,"PAH",96,1,6,0)="3. RMPRPFC missing tag 'EN' in XDRMERG0 process"
^DIC(9.4,140,22,20,"PAH",97,0)="126 SEQ #106^3070627.212916^1"
^DIC(9.4,140,22,20,"PAH",98,0)="119 SEQ #107^3070904.222931^1"
^DIC(9.4,140,22,20,"PAH",98,1,0)="^^1^1^3070904"
^DIC(9.4,140,22,20,"PAH",98,1,1,0)="Follow-up patch to GUI Purchasing to put the Vista Option out of order."
^DIC(9.4,140,22,20,"PAH",99,0)="132 SEQ #108^3070904.222952^1"
^DIC(9.4,140,22,20,"PAH",99,1,0)="^^6^6^3070904"
^DIC(9.4,140,22,20,"PAH",99,1,1,0)="1.  Issue with P.O. continuation page"
^DIC(9.4,140,22,20,"PAH",99,1,2,0)="2.  Prosthetics Inventory message for ROP levels ignores partially filled"
^DIC(9.4,140,22,20,"PAH",99,1,3,0)="    orders as outstanding."
