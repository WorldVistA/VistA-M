^DIC(9.4,85,22,1.5,"PAH",16,1,3,0)="DR variable leak."
^DIC(9.4,85,22,1.5,"PAH",17,0)="42 SEQ #39^3050204^1"
^DIC(9.4,85,22,1.5,"PAH",17,1,0)="^^64^64^3050204"
^DIC(9.4,85,22,1.5,"PAH",17,1,1,0)="Patch VAQ*1.5*42"
^DIC(9.4,85,22,1.5,"PAH",17,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",17,1,3,0)="NOIS: none"
^DIC(9.4,85,22,1.5,"PAH",17,1,4,0)="Test Sites: Oklahoma City, OK; Madison, WI; Milwaukee, WI; Tomah, WI;"
^DIC(9.4,85,22,1.5,"PAH",17,1,5,0)="            Montana HCS"
^DIC(9.4,85,22,1.5,"PAH",17,1,6,0)=""
^DIC(9.4,85,22,1.5,"PAH",17,1,7,0)="This patch alters PDX to use the new API from IB (Integrated Billing),"
^DIC(9.4,85,22,1.5,"PAH",17,1,8,0)="introduced in patch IB*2.0*256, to access billing (insurance) data."
^DIC(9.4,85,22,1.5,"PAH",17,1,9,0)=""
^DIC(9.4,85,22,1.5,"PAH",17,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",17,1,11,0)="is at a minimum.  It requires patch IB*2.0*267.  It also requires patch"
^DIC(9.4,85,22,1.5,"PAH",17,1,12,0)="VAQ*1.5*13.  (KIDS will not check for this patch because it predates KIDS."
^DIC(9.4,85,22,1.5,"PAH",17,1,13,0)="You must check manually.)"
^DIC(9.4,85,22,1.5,"PAH",17,1,14,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",17,1,15,0)=" "
^DIC(9.4,85,22,1.5,"PAH",17,1,16,0)="ROUTINES:"
^DIC(9.4,85,22,1.5,"PAH",17,1,17,0)="The second line of the routine now looks like:"
^DIC(9.4,85,22,1.5,"PAH",17,1,18,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",17,1,19,0)=" "
^DIC(9.4,85,22,1.5,"PAH",17,1,20,0)="             Before        After"
^DIC(9.4,85,22,1.5,"PAH",17,1,21,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,85,22,1.5,"PAH",17,1,22,0)="-----------------------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",17,1,23,0)="VAQDBIP7    3165540     11036802     13,42"
^DIC(9.4,85,22,1.5,"PAH",17,1,24,0)=""
^DIC(9.4,85,22,1.5,"PAH",17,1,25,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,85,22,1.5,"PAH",17,1,26,0)=""
^DIC(9.4,85,22,1.5,"PAH",17,1,27,0)="This patch introduces no new routines."
^DIC(9.4,85,22,1.5,"PAH",17,1,28,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",17,1,29,0)=" "
^DIC(9.4,85,22,1.5,"PAH",17,1,30,0)="INSTALLATION:"
^DIC(9.4,85,22,1.5,"PAH",17,1,31,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",17,1,32,0)="is at a minimum.  It requires patch IB*2.0*267.  It also requires patch"
^DIC(9.4,85,22,1.5,"PAH",17,1,33,0)="VAQ*1.5*13.  (KIDS will not check for this patch because it predates KIDS."
^DIC(9.4,85,22,1.5,"PAH",17,1,34,0)="You must check manually.)"
^DIC(9.4,85,22,1.5,"PAH",17,1,35,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,85,22,1.5,"PAH",17,1,36,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,85,22,1.5,"PAH",17,1,37,0)="    affected routine(s).  "
^DIC(9.4,85,22,1.5,"PAH",17,1,38,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,85,22,1.5,"PAH",17,1,39,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,85,22,1.5,"PAH",17,1,40,0)="4.  You do not need to stop TaskMan."
^DIC(9.4,85,22,1.5,"PAH",17,1,41,0)="    Users may be on the system."
^DIC(9.4,85,22,1.5,"PAH",17,1,42,0)="5.  On the KIDS:Installation menu, use the following options to install"
^DIC(9.4,85,22,1.5,"PAH",17,1,43,0)="    the Transport Global."
^DIC(9.4,85,22,1.5,"PAH",17,1,44,0)="       Verify Checksums in Transport Global"
^DIC(9.4,85,22,1.5,"PAH",17,1,45,0)="       Print Transport Global"
^DIC(9.4,85,22,1.5,"PAH",17,1,46,0)="       Compare Transport Global to Current System"
^DIC(9.4,85,22,1.5,"PAH",17,1,47,0)="       Backup a Transport Global"
^DIC(9.4,85,22,1.5,"PAH",17,1,48,0)="       Install Package(s)"
^DIC(9.4,85,22,1.5,"PAH",17,1,49,0)=" Select INSTALL NAME:   VAQ*1.5*42   Loaded from Distribution <date/time>"
^DIC(9.4,85,22,1.5,"PAH",17,1,50,0)="                        =========="
^DIC(9.4,85,22,1.5,"PAH",17,1,51,0)=" Install Questions:"
^DIC(9.4,85,22,1.5,"PAH",17,1,52,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,85,22,1.5,"PAH",17,1,53,0)="                                                       =="
^DIC(9.4,85,22,1.5,"PAH",17,1,54,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,85,22,1.5,"PAH",17,1,55,0)="                                                                       =="
^DIC(9.4,85,22,1.5,"PAH",17,1,56,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,85,22,1.5,"PAH",17,1,57,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,85,22,1.5,"PAH",17,1,58,0)=" Enter a '^' to abort the install."
^DIC(9.4,85,22,1.5,"PAH",17,1,59,0)=" "
^DIC(9.4,85,22,1.5,"PAH",17,1,60,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,85,22,1.5,"PAH",17,1,61,0)="                ------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",17,1,62,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if"
^DIC(9.4,85,22,1.5,"PAH",17,1,63,0)="    necessary."
^DIC(9.4,85,22,1.5,"PAH",17,1,64,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",18,0)="41 SEQ #40^3050625^1"
^DIC(9.4,85,22,1.5,"PAH",18,1,0)="^^2^2^3050625"
^DIC(9.4,85,22,1.5,"PAH",18,1,1,0)="Patch VAQ*1.5*41. Please refere to the Description in Forum Patch Module "
^DIC(9.4,85,22,1.5,"PAH",18,1,2,0)="for details."
^DIC(9.4,85,22,1.5,"PAH",19,0)="44 SEQ #41^3140108.15255^17"
^DIC(9.4,85,22,1.5,"PAH",19,1,0)="^^5^5^3140108"
^DIC(9.4,85,22,1.5,"PAH",19,1,1,0)="This patch addresses 2 issues with Patient Data Exchange (PDX):"
^DIC(9.4,85,22,1.5,"PAH",19,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",19,1,3,0)="1) Issues adding users to notify for PDX transactions  "
^DIC(9.4,85,22,1.5,"PAH",19,1,4,0)="2) <UNDEFINED> errors occurring due to invalid Health Summary"
^DIC(9.4,85,22,1.5,"PAH",19,1,5,0)="   Component entries."
^DIC(9.4,85,22,1.5,"PAH",20,0)="46^3231026.094606^89"
^DIC(9.4,85,22,1.5,"PAH",20,1,0)="^^2^2^3231026"
^DIC(9.4,85,22,1.5,"PAH",20,1,1,0)="Refer to the patch description for an explanation of the changes included "
^DIC(9.4,85,22,1.5,"PAH",20,1,2,0)="in this patch."
^DIC(9.4,85,22,1.5,"PAH","B",46,20)=""
