^DIC(9.4,60,22,13,"PAH",480,1,328,0)=" -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",480,1,329,0)=" Technical Manual/Security Guide       pso_7_p612_tm.docx"
^DIC(9.4,60,22,13,"PAH",480,1,330,0)=" - Outpatient Pharmacy V.7.0           pso_7_p612_tm.pdf"
^DIC(9.4,60,22,13,"PAH",480,1,331,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,332,0)=" User Manual - Manager - Outpatient    pso_7_man_um.docx"
^DIC(9.4,60,22,13,"PAH",480,1,333,0)=" Pharmacy V.7.0                        pso_7_man_um.pdf"
^DIC(9.4,60,22,13,"PAH",480,1,334,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,335,0)=" Deployment Installation Back-Out      pso_7_p612_ys_501_p166_dibr.docx"
^DIC(9.4,60,22,13,"PAH",480,1,336,0)=" and Rollback Guide - HI&M             pso_7_p612_ys_501_p166_dibr.pdf"
^DIC(9.4,60,22,13,"PAH",480,1,337,0)=" Clozapine Overrides "
^DIC(9.4,60,22,13,"PAH",480,1,338,0)=" "
