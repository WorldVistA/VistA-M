^DIC(9.4,60,22,13,"PAH",584,1,345,0)="  "
^DIC(9.4,60,22,13,"PAH",584,1,346,0)="10. New action View History Log (HL)"
^DIC(9.4,60,22,13,"PAH",584,1,347,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,348,0)="   This new action added eRx Holding Queue Display screen will allow the user"
^DIC(9.4,60,22,13,"PAH",584,1,349,0)="   to view a comprehensive history of the eRx as it moves through the OP"
^DIC(9.4,60,22,13,"PAH",584,1,350,0)="   application, including activities in Backdoor Pharmacy. Please, refer to"
^DIC(9.4,60,22,13,"PAH",584,1,351,0)="   the user documentation for more information about this new option."
^DIC(9.4,60,22,13,"PAH",584,1,352,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,353,0)="11. Batch Hold and Un-Hold Functionality"
^DIC(9.4,60,22,13,"PAH",584,1,354,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,355,0)="   The current Hold and Un-Hold actions were modified to perform the following "
^DIC(9.4,60,22,13,"PAH",584,1,356,0)="   additional function: every time a prescription is put on Hold or removed"
^DIC(9.4,60,22,13,"PAH",584,1,357,0)="   from Hold, the software will check other prescriptions exist for that"
^DIC(9.4,60,22,13,"PAH",584,1,358,0)="   patient that were sent by the same prescriber on the same day. If any is"
^DIC(9.4,60,22,13,"PAH",584,1,359,0)="   found, the software will ask the user if they want to Hold (or Un-Hold)"
^DIC(9.4,60,22,13,"PAH",584,1,360,0)="   those additional eRx records as well, as shown below:"
^DIC(9.4,60,22,13,"PAH",584,1,361,0)="    ..."
^DIC(9.4,60,22,13,"PAH",584,1,362,0)="    Select Action: Next Screen// H   Hold  "
^DIC(9.4,60,22,13,"PAH",584,1,363,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,364,0)="    Select HOLD reason code: HAL       NO ALLERGY ASSESSMENT"
^DIC(9.4,60,22,13,"PAH",584,1,365,0)="    Additional Comments (Optional): TESTING BATCH HOLD"
^DIC(9.4,60,22,13,"PAH",584,1,366,0)="    Updating...done."
^DIC(9.4,60,22,13,"PAH",584,1,367,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,368,0)="    The following prescriptions are from the same provider and received on the"
^DIC(9.4,60,22,13,"PAH",584,1,369,0)="    same day:"
^DIC(9.4,60,22,13,"PAH",584,1,370,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,371,0)="    PROVIDER: TEST,PROVIDER           eRx RECEIVED DATE: JAN 28, 2023@10:57:14"
^DIC(9.4,60,22,13,"PAH",584,1,372,0)="    ERX ID     DRUG NAME                      PROVIDER                  STATUS"
^DIC(9.4,60,22,13,"PAH",584,1,373,0)="    --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,374,0)="    123011     GABAPENTIN 300MG CAP           TEST,PROVIDER             N"
^DIC(9.4,60,22,13,"PAH",584,1,375,0)="    123012     CITALOPRAM HYDROBROMIDE 20MG T TEST,PROVIDER             N"
^DIC(9.4,60,22,13,"PAH",584,1,376,0)="    123013     IBUPROFEN 400MG TAB            TEST,PROVIDER             N"
^DIC(9.4,60,22,13,"PAH",584,1,377,0)="    123014     ACETAMINOPHEN 325MG TAB        TEST,PROVIDER             N"
^DIC(9.4,60,22,13,"PAH",584,1,378,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,379,0)="    Do you want to put them on HOLD-HAL? No// YES     Updating...done."
^DIC(9.4,60,22,13,"PAH",584,1,380,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,381,0)="12. New Allergy Functionality Enhancements"
^DIC(9.4,60,22,13,"PAH",584,1,382,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,383,0)="   Functionality related allergies is being improved through the following"
^DIC(9.4,60,22,13,"PAH",584,1,384,0)="   modifications:"
^DIC(9.4,60,22,13,"PAH",584,1,385,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,386,0)="   a) When matching or accepting validation of a VistA patient it will display"
^DIC(9.4,60,22,13,"PAH",584,1,387,0)="      in the warnings if the VistA patient selected has no Allergy Assessment:"
^DIC(9.4,60,22,13,"PAH",584,1,388,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,389,0)="      *******************************   WARNING(S)  *************************"
^DIC(9.4,60,22,13,"PAH",584,1,390,0)="      VistA Patient does not have an Allergy Assessment."
^DIC(9.4,60,22,13,"PAH",584,1,391,0)="      ***********************************************************************"
^DIC(9.4,60,22,13,"PAH",584,1,392,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,393,0)="      MbM sites only:"
^DIC(9.4,60,22,13,"PAH",584,1,394,0)="      -------------- "
^DIC(9.4,60,22,13,"PAH",584,1,395,0)="        i) User won't be able to accept validation of a VistA Patient that"
^DIC(9.4,60,22,13,"PAH",584,1,396,0)="           does not have an Allergy Assessment."
^DIC(9.4,60,22,13,"PAH",584,1,397,0)="       ii) All the actionable records for the same eRx patient will be"
^DIC(9.4,60,22,13,"PAH",584,1,398,0)="           automatically be put on Hold with the code HAL - NO ALLERGY"
^DIC(9.4,60,22,13,"PAH",584,1,399,0)="           ASSESSMENT, the user will be notified as shown below:"
^DIC(9.4,60,22,13,"PAH",584,1,400,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,401,0)="     The following eRx record(s) have been put on Hold (HAL) because the "
^DIC(9.4,60,22,13,"PAH",584,1,402,0)="     VistA Patient selected (OUTPATIENT,JLG ONE) does not have an Allergy"
^DIC(9.4,60,22,13,"PAH",584,1,403,0)="     Assessment:"
^DIC(9.4,60,22,13,"PAH",584,1,404,0)="     ERX ID     DRUG NAME                      PROVIDER            STATUS"
^DIC(9.4,60,22,13,"PAH",584,1,405,0)="     -----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,406,0)="     123010     CETIRIZINE HCL 10MG TAB        TEST,PROVIDER        HAL"
^DIC(9.4,60,22,13,"PAH",584,1,407,0)="     123011     GABAPENTIN 300MG CAP           TEST,PROVIDER        HAL"
^DIC(9.4,60,22,13,"PAH",584,1,408,0)="     123012     CITALOPRAM HYDROBROMIDE 20MG T TEST,PROVIDER        HAL"
^DIC(9.4,60,22,13,"PAH",584,1,409,0)="     123013     IBUPROFEN 400MG TAB            TEST,PROVIDER        HAL"
^DIC(9.4,60,22,13,"PAH",584,1,410,0)="     123014     ACETAMINOPHEN 325MG TAB        TEST,PROVIDER        HAL"
^DIC(9.4,60,22,13,"PAH",584,1,411,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,412,0)="     Type <Enter> to continue or '^' to exit: "
^DIC(9.4,60,22,13,"PAH",584,1,413,0)="  "
^DIC(9.4,60,22,13,"PAH",584,1,414,0)="   b) A new screen titled 'Patient Allergies' was created to show the eRx"
^DIC(9.4,60,22,13,"PAH",584,1,415,0)="      Patient allergies side-by-side with the VistA Patient allergies in"
^DIC(9.4,60,22,13,"PAH",584,1,416,0)="      detail. This new Screen can be invoked by using the PA (Patient"
^DIC(9.4,60,22,13,"PAH",584,1,417,0)="      Allergy) hidden action from the following screens:"
^DIC(9.4,60,22,13,"PAH",584,1,418,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,419,0)="         - eRx Holding Queue Display Screen (eRx Holding Queue)"
^DIC(9.4,60,22,13,"PAH",584,1,420,0)="         - Patient Validation Screen (eRx Holding Queue)"
^DIC(9.4,60,22,13,"PAH",584,1,421,0)="         - Drug Validation Screen (eRx Holding Queue)"
^DIC(9.4,60,22,13,"PAH",584,1,422,0)="         - Pending Order Orders Screen (Backdoor OP)"
^DIC(9.4,60,22,13,"PAH",584,1,423,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,424,0)="      This new screen contains an action called VPA (VistA Patient Allergies),"
^DIC(9.4,60,22,13,"PAH",584,1,425,0)="      which allows the user to update the VistA Patient Allegies without "
^DIC(9.4,60,22,13,"PAH",584,1,426,0)="      leaving the option. "
^DIC(9.4,60,22,13,"PAH",584,1,427,0)="      Note: In order to use the VPA action the VistA Patient has to have been"
^DIC(9.4,60,22,13,"PAH",584,1,428,0)="            previously matched."
^DIC(9.4,60,22,13,"PAH",584,1,429,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,430,0)="13.New Eligibility Functionality (MbM sites only)"
^DIC(9.4,60,22,13,"PAH",584,1,431,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,432,0)="   Functionality related ChampVA Rx Benefit Eligibility is being improved"
^DIC(9.4,60,22,13,"PAH",584,1,433,0)="   through the following modifications:"
^DIC(9.4,60,22,13,"PAH",584,1,434,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,435,0)="   a) ChampVA Rx Benefit eligibility information will be displayed in the new"
^DIC(9.4,60,22,13,"PAH",584,1,436,0)="      Patient Validation Screen in the Header section. It will have one of "
^DIC(9.4,60,22,13,"PAH",584,1,437,0)="      these 3 possible Values: ELIGIBLE, NOT ELIGIBLE or SB (Spine Bifida)."
^DIC(9.4,60,22,13,"PAH",584,1,438,0)="   b) When matching a VistA patient it will display in the warnings if the"
^DIC(9.4,60,22,13,"PAH",584,1,439,0)="      VistA patient selected is not eligible for ChampVA Rx Benefit (soft-"
^DIC(9.4,60,22,13,"PAH",584,1,440,0)="      stop):"
^DIC(9.4,60,22,13,"PAH",584,1,441,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,442,0)="      *******************************   WARNING(S)  *************************"
^DIC(9.4,60,22,13,"PAH",584,1,443,0)="      VistA Patient is not eligible for ChampVA Rx Benefit."
^DIC(9.4,60,22,13,"PAH",584,1,444,0)="      ***********************************************************************"
^DIC(9.4,60,22,13,"PAH",584,1,445,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,446,0)="   c) It will not allow accepting validation of a matched VistA patient that"
^DIC(9.4,60,22,13,"PAH",584,1,447,0)="      is not eligible for ChampVA Rx Benefit (hard-stop):"
^DIC(9.4,60,22,13,"PAH",584,1,448,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,449,0)="      *******************************INVALID PATIENT*************************"
^DIC(9.4,60,22,13,"PAH",584,1,450,0)="      VistA Patient is not eligible for ChampVA Rx Benefit."
^DIC(9.4,60,22,13,"PAH",584,1,451,0)="      ***********************************************************************"
^DIC(9.4,60,22,13,"PAH",584,1,452,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,453,0)="   d) When matching or accepting validation fo a VistA patient that is not"
^DIC(9.4,60,22,13,"PAH",584,1,454,0)="      eligible for ChampVA Rx Benefit all the actionable records for the same"
^DIC(9.4,60,22,13,"PAH",584,1,455,0)="      eRx patient will be automatically be put on Hold with the code HEL - "
^DIC(9.4,60,22,13,"PAH",584,1,456,0)="      ELIGIBILITY ISSUES, the user will be notified as shown below:"
^DIC(9.4,60,22,13,"PAH",584,1,457,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,458,0)="     The following eRx record(s) have been put on Hold (HEL) because the "
^DIC(9.4,60,22,13,"PAH",584,1,459,0)="     VistA Patient selected (OUTPATIENT,JLG ONE) is not Eligible for ChampVA"
^DIC(9.4,60,22,13,"PAH",584,1,460,0)="     Rx Benefit:"
^DIC(9.4,60,22,13,"PAH",584,1,461,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,462,0)="     ERX ID     DRUG NAME                      PROVIDER            STATUS"
^DIC(9.4,60,22,13,"PAH",584,1,463,0)="     -----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,464,0)="     123010     CETIRIZINE HCL 10MG TAB        TEST,PROVIDER        HEL"
^DIC(9.4,60,22,13,"PAH",584,1,465,0)="     123011     GABAPENTIN 300MG CAP           TEST,PROVIDER        HEL"
^DIC(9.4,60,22,13,"PAH",584,1,466,0)="     123012     CITALOPRAM HYDROBROMIDE 20MG T TEST,PROVIDER        HEL"
^DIC(9.4,60,22,13,"PAH",584,1,467,0)="     123013     IBUPROFEN 400MG TAB            TEST,PROVIDER        HEL"
^DIC(9.4,60,22,13,"PAH",584,1,468,0)="     123014     ACETAMINOPHEN 325MG TAB        TEST,PROVIDER        HEL"
^DIC(9.4,60,22,13,"PAH",584,1,469,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,470,0)="     Type <Enter> to continue or '^' to exit: "
^DIC(9.4,60,22,13,"PAH",584,1,471,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,472,0)="14.Duplicate VistA Patient Check (MbM sites only)"
^DIC(9.4,60,22,13,"PAH",584,1,473,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,474,0)="   A new check will be performed when the users selects a patient (Edit) or"
^DIC(9.4,60,22,13,"PAH",584,1,475,0)="   Accept Validation of a previously selected patient. The software will check"
^DIC(9.4,60,22,13,"PAH",584,1,476,0)="   whether potential duplicate VistA patients exist and if so it will warn the"
^DIC(9.4,60,22,13,"PAH",584,1,477,0)="   user about it, as seen below (Patient Validation Screen):"
^DIC(9.4,60,22,13,"PAH",584,1,478,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,479,0)="   Edit Patient (Soft Stop):"
^DIC(9.4,60,22,13,"PAH",584,1,480,0)="   ------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,481,0)="    ...  "
^DIC(9.4,60,22,13,"PAH",584,1,482,0)="    P   Print                 H   Hold                  UH  Un Hold"
^DIC(9.4,60,22,13,"PAH",584,1,483,0)="    E   Edit                  AV  Accept Validation     RJ  Reject"
^DIC(9.4,60,22,13,"PAH",584,1,484,0)="    Select Item(s): Edit// e   Edit  "
^DIC(9.4,60,22,13,"PAH",584,1,485,0)="    "
^DIC(9.4,60,22,13,"PAH",584,1,486,0)="    VISTA PATIENT: PHWWDY,QLYJH H"
^DIC(9.4,60,22,13,"PAH",584,1,487,0)="       1   PHWWDY,QLYJH H      01/31/1952  101021512  TOMBSTONE,ID"
^DIC(9.4,60,22,13,"PAH",584,1,488,0)="       2   PHWWDY,QLYJH H      09/30/1930  101097105  CASA GRANDA,FL"
^DIC(9.4,60,22,13,"PAH",584,1,489,0)="       3   PHWWDY,QLYJH H      05/04/1934  101068053  SHADY GROVE,DE"
^DIC(9.4,60,22,13,"PAH",584,1,490,0)="    CHOOSE 1-3: 1  PHWWDY,QLYJH H      01/31/1952  101021512  TOMBSTONE,ID"
^DIC(9.4,60,22,13,"PAH",584,1,491,0)="     Enrollment Priority:            Category: IN PROCESS    End Date: "
^DIC(9.4,60,22,13,"PAH",584,1,492,0)="     "
^DIC(9.4,60,22,13,"PAH",584,1,493,0)="    ******************************   WARNING(S)  *****************************"
^DIC(9.4,60,22,13,"PAH",584,1,494,0)="    The following VistA Patient(s) has been identified as potential "
^DIC(9.4,60,22,13,"PAH",584,1,495,0)="    duplicate(s):"
^DIC(9.4,60,22,13,"PAH",584,1,496,0)="     42211-PHWWDY,QLYJH H  09/30/1930  101097105  CASA GRANDA,FL"
^DIC(9.4,60,22,13,"PAH",584,1,497,0)="     42737-PHWWDY,QLYJH H  05/04/1934  101068053  SHADY GROVE,DE"
^DIC(9.4,60,22,13,"PAH",584,1,498,0)="    **************************************************************************"
^DIC(9.4,60,22,13,"PAH",584,1,499,0)="    eRx Patient                             VistA Patient"
^DIC(9.4,60,22,13,"PAH",584,1,500,0)="    ---------------------------------------+----------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,501,0)="    Name:MAT1,TEST8                        |Name:PHWWDY,QLYJH H"
^DIC(9.4,60,22,13,"PAH",584,1,502,0)="    DOB :DEC 18, 2014                      |DOB :JAN 31,1952"
^DIC(9.4,60,22,13,"PAH",584,1,503,0)="    Sex :MALE                              |Sex :MALE"
^DIC(9.4,60,22,13,"PAH",584,1,504,0)="    SSN :101127944                         |SSN :101-02-1512"
^DIC(9.4,60,22,13,"PAH",584,1,505,0)="    Phone #: 2251230718                    |Phone #: "
^DIC(9.4,60,22,13,"PAH",584,1,506,0)="    Address:                               |Address:"
^DIC(9.4,60,22,13,"PAH",584,1,507,0)="    123 FAKE STREET #101                   |3301 MC CONNELL DRIVE"
^DIC(9.4,60,22,13,"PAH",584,1,508,0)="    PLANO,TX  75025                        |TOMBSTONE,ID  12345  "
^DIC(9.4,60,22,13,"PAH",584,1,509,0)="    ---------------------------------------+----------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,510,0)="    Would you like to use this patient? NO// "
^DIC(9.4,60,22,13,"PAH",584,1,511,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,512,0)="      "
^DIC(9.4,60,22,13,"PAH",584,1,513,0)="    Accept Validation (Soft Stop):"
^DIC(9.4,60,22,13,"PAH",584,1,514,0)="    -----------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,515,0)="    ..."
^DIC(9.4,60,22,13,"PAH",584,1,516,0)="    Select Item(s): Next Screen// AV   Accept Validation  "
^DIC(9.4,60,22,13,"PAH",584,1,517,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,518,0)="    *******************************   WARNING(S)  ***************************"
^DIC(9.4,60,22,13,"PAH",584,1,519,0)="    The following VistA Patient(s) has been identified as potential"
^DIC(9.4,60,22,13,"PAH",584,1,520,0)="    duplicate(s):"
^DIC(9.4,60,22,13,"PAH",584,1,521,0)="      42211-PHWWDY,QLYJH H  09/30/1930  101097105  CASA GRANDA,FL"
^DIC(9.4,60,22,13,"PAH",584,1,522,0)="      42737-PHWWDY,QLYJH H  05/04/1934  101068053  SHADY GROVE,DE"
^DIC(9.4,60,22,13,"PAH",584,1,523,0)="    *************************************************************************"
^DIC(9.4,60,22,13,"PAH",584,1,524,0)="    Would you like to mark this patient as VALIDATED?"
^DIC(9.4,60,22,13,"PAH",584,1,525,0)="    Enter Yes or No: NO// "
^DIC(9.4,60,22,13,"PAH",584,1,526,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,527,0)="15.New option: eRx Holding Queue Processing [PSO ERX QUEUE PROCESSING] "
^DIC(9.4,60,22,13,"PAH",584,1,528,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,529,0)="   This new option was created to replace the option Complete Orders from eRx"
^DIC(9.4,60,22,13,"PAH",584,1,530,0)="   [PSO ERX FINISH]. The new option will have 100% of the functionality of the"
^DIC(9.4,60,22,13,"PAH",584,1,531,0)="   replaced option and some additional feature such as:"
^DIC(9.4,60,22,13,"PAH",584,1,532,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,533,0)="   a)Most of the prompts when entering the option have been converted into"
^DIC(9.4,60,22,13,"PAH",584,1,534,0)="     User Preferences changed after loading the list and can be saved by each"
^DIC(9.4,60,22,13,"PAH",584,1,535,0)="     user as their preferred View"
^DIC(9.4,60,22,13,"PAH",584,1,536,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,537,0)="   b)The header part of the option was modified to display information about"
^DIC(9.4,60,22,13,"PAH",584,1,538,0)="     the parameters used to compose the list, such as LOOK BACK DAYS, MAX."
^DIC(9.4,60,22,13,"PAH",584,1,539,0)="     QUEUE SIZE, ERX STATUS, etc."
^DIC(9.4,60,22,13,"PAH",584,1,540,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,541,0)="   c)The Grouping by CS (Controlled Substances) have a new format, which"
^DIC(9.4,60,22,13,"PAH",584,1,542,0)="     separates entries in the queue."
^DIC(9.4,60,22,13,"PAH",584,1,543,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,544,0)="   d)The user will be able to more easily switch views between the Patient"
^DIC(9.4,60,22,13,"PAH",584,1,545,0)="     Centric and the Rx Medication queues via the PC and RX actions."
^DIC(9.4,60,22,13,"PAH",584,1,546,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,547,0)="   e)Queue Search/Filter adds 3 new options in the Patient Centric View: RX#,"
^DIC(9.4,60,22,13,"PAH",584,1,548,0)="     VISTA PATIENT and MATCH STATUS."
^DIC(9.4,60,22,13,"PAH",584,1,549,0)="     In addition, the interface for performing searches was changed to display"
^DIC(9.4,60,22,13,"PAH",584,1,550,0)="     information about the selected filters, including in the header part of "
^DIC(9.4,60,22,13,"PAH",584,1,551,0)="     the list. The current filters can easily be reset via the RF (Remove"
^DIC(9.4,60,22,13,"PAH",584,1,552,0)="     Filters) action."
^DIC(9.4,60,22,13,"PAH",584,1,553,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,554,0)="   f)Queue Search/Filter adds 4 new options in the Medication View: RX#,"
^DIC(9.4,60,22,13,"PAH",584,1,555,0)="     VISTA PATIENT, VISTA PROVIDER and MATCH STATUS."
^DIC(9.4,60,22,13,"PAH",584,1,556,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,557,0)="   g)The MATCH STATUS filter was added to the Patient Centric and Medication"
^DIC(9.4,60,22,13,"PAH",584,1,558,0)="     View and it has 4 different choices shown below:"
^DIC(9.4,60,22,13,"PAH",584,1,559,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,560,0)="          1         PATIENT FAIL - PATIENT NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,561,0)="          2         PROVIDER FAIL - PROVIDER NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,562,0)="          3         DRUG FAIL - DRUG NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,563,0)="          4         BASIC - PATIENT, PROVIDER AND DRUG MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,564,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,565,0)="     1: Includes records where the patient has not been matched"
^DIC(9.4,60,22,13,"PAH",584,1,566,0)="     2: Includes records where the provider has not been matched yet, but the "
^DIC(9.4,60,22,13,"PAH",584,1,567,0)="        patient is matched"
^DIC(9.4,60,22,13,"PAH",584,1,568,0)="     3: Includes records where the drug has not been matched yet, but the"
^DIC(9.4,60,22,13,"PAH",584,1,569,0)="        patient and the provider are matched"
^DIC(9.4,60,22,13,"PAH",584,1,570,0)="     4: Includes records with the patient, provider and drug matched"
^DIC(9.4,60,22,13,"PAH",584,1,571,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,572,0)="     Note: For a VA Medical Center site the list of choice will display "
^DIC(9.4,60,22,13,"PAH",584,1,573,0)="           differently:"
^DIC(9.4,60,22,13,"PAH",584,1,574,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,575,0)="          1         PATIENT NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,576,0)="          2         PROVIDER NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,577,0)="          3         DRUG NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,578,0)="          4         PATIENT, PROVIDER AND DRUG MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,579,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,580,0)="   h)The header in the Patient Centric and Medication views will display"
^DIC(9.4,60,22,13,"PAH",584,1,581,0)="     information about the selected filters, as shown below: "
^DIC(9.4,60,22,13,"PAH",584,1,582,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,583,0)="     Rx Medication Queue       Jan 28, 2023@15:46:17           Page:  1 of  1 "
^DIC(9.4,60,22,13,"PAH",584,1,584,0)="     LOOK BACK DAYS: 200       CS/NON-CS: BOTH (II-V)    MAX. QUEUE SIZE: 999"
^DIC(9.4,60,22,13,"PAH",584,1,585,0)="     FILTERED BY: 01/08/23-01/18/23|PATIENT(TEST,PATIENT)"
^DIC(9.4,60,22,13,"PAH",584,1,586,0)="     _________________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,587,0)="     #   PATIENT              DOB      DRUG          PROVIDER    STA REC.DAT"
^DIC(9.4,60,22,13,"PAH",584,1,588,0)="     ..."
^DIC(9.4,60,22,13,"PAH",584,1,589,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,590,0)="     Note: The current filters can easily be reset via the RF (Remove Filters)"
^DIC(9.4,60,22,13,"PAH",584,1,591,0)="           action."
^DIC(9.4,60,22,13,"PAH",584,1,592,0)="  "
^DIC(9.4,60,22,13,"PAH",584,1,593,0)="   i)Queue Sorting was streamlined to allow the user to quickly sort the list"
^DIC(9.4,60,22,13,"PAH",584,1,594,0)="     through specific actions for each column and also allows for Descending"
^DIC(9.4,60,22,13,"PAH",584,1,595,0)="     Sorting (not available in the replaced option)."
^DIC(9.4,60,22,13,"PAH",584,1,596,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,597,0)="   j)The Change View (CV) action allows the user to reconfigure the way the"
^DIC(9.4,60,22,13,"PAH",584,1,598,0)="     list is displayed and allows them to save the configuration to be applied"
^DIC(9.4,60,22,13,"PAH",584,1,599,0)="     to que queue when they re-enter the option."
^DIC(9.4,60,22,13,"PAH",584,1,600,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,601,0)="   k)A new action called Refresh (REF) was added to allow the user to"
^DIC(9.4,60,22,13,"PAH",584,1,602,0)="     re-display the queue. This feature allows the user view the latest"
^DIC(9.4,60,22,13,"PAH",584,1,603,0)="     'locks' from other users that have been placed since the queue was last"
^DIC(9.4,60,22,13,"PAH",584,1,604,0)="     built."
^DIC(9.4,60,22,13,"PAH",584,1,605,0)="  "
^DIC(9.4,60,22,13,"PAH",584,1,606,0)="   l)A new action called Change Look Back Days (LBD) was created to quickly"
^DIC(9.4,60,22,13,"PAH",584,1,607,0)="     allow the user to change the number of days to look back for records."
^DIC(9.4,60,22,13,"PAH",584,1,608,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,609,0)="   m)A new action called Next Patient (NP) was created to assist users in"
^DIC(9.4,60,22,13,"PAH",584,1,610,0)="     selecting the next eRx Patient on the queue to be worked on without too"
^DIC(9.4,60,22,13,"PAH",584,1,611,0)="     many key strokes."
^DIC(9.4,60,22,13,"PAH",584,1,612,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,613,0)="   n)A new action called Show/Hide Details (DET) under the Single Patient "
^DIC(9.4,60,22,13,"PAH",584,1,614,0)="     list will show/hide additional information about each one of the"
^DIC(9.4,60,22,13,"PAH",584,1,615,0)="     eRx on the list. It will display Qty, # of Refills, Days Supply and the"
^DIC(9.4,60,22,13,"PAH",584,1,616,0)="     SIG (medication instructions)."
^DIC(9.4,60,22,13,"PAH",584,1,617,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,618,0)="   o)A new action called Include All Statuses (IAS) under the Single Patient "
^DIC(9.4,60,22,13,"PAH",584,1,619,0)="     list will show/hide non-actionable statuses like Processed (PR), "
^DIC(9.4,60,22,13,"PAH",584,1,620,0)="     Removed (RM), etc. Furthermore, a field on the header will indicate"
^DIC(9.4,60,22,13,"PAH",584,1,621,0)="     which statuses are being displayed: ALL or ACTIONABLE only."
^DIC(9.4,60,22,13,"PAH",584,1,622,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,623,0)="   p)A new option is being added to the initial selection before entering the"
^DIC(9.4,60,22,13,"PAH",584,1,624,0)="     The new option is called Workload Processing (WP) and it is designed for"
^DIC(9.4,60,22,13,"PAH",584,1,625,0)="     processing the current workload in a FIFO (First In First Out) method."
^DIC(9.4,60,22,13,"PAH",584,1,626,0)="     Instead of loading a list of patients (PC Centric Queue) or Prescriptions"
^DIC(9.4,60,22,13,"PAH",584,1,627,0)="     (Rx View), this option will automatically choose the patient with the"
^DIC(9.4,60,22,13,"PAH",584,1,628,0)="     oldest record to be worked on and will load it for the user to process"
^DIC(9.4,60,22,13,"PAH",584,1,629,0)="     their prescriptions. Once the user finishes processing the prescription"
^DIC(9.4,60,22,13,"PAH",584,1,630,0)="     for the first patient loaded they can choose the Next Patient (NP) action"
^DIC(9.4,60,22,13,"PAH",584,1,631,0)="     to move on to the next patient. This option will use the ERX DEFAULT"
^DIC(9.4,60,22,13,"PAH",584,1,632,0)="     LOOKBACK DAYS field (#10.2) in the OUTPATIENT SITE file (#59) to"
^DIC(9.4,60,22,13,"PAH",584,1,633,0)="     determine which one is the patient with the oldest record on file that"
^DIC(9.4,60,22,13,"PAH",584,1,634,0)="     needs to be worked on next. The record must be in one of these 3 "
^DIC(9.4,60,22,13,"PAH",584,1,635,0)="     statuses: New, In-Process or Wait."
^DIC(9.4,60,22,13,"PAH",584,1,636,0)="     Additionally, this option allows the user to work on patients with"
^DIC(9.4,60,22,13,"PAH",584,1,637,0)="     specific records that match the criteria below (see g bullet above for"
^DIC(9.4,60,22,13,"PAH",584,1,638,0)="     more information on each filter):"
^DIC(9.4,60,22,13,"PAH",584,1,639,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,640,0)="          1         PATIENT FAIL - PATIENT NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,641,0)="          2         PROVIDER FAIL - PROVIDER NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,642,0)="          3         DRUG FAIL - DRUG NOT MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,643,0)="          4         BASIC - PATIENT, PROVIDER AND DRUG MATCHED"
^DIC(9.4,60,22,13,"PAH",584,1,644,0)="          5         ALL (NO FILTERS) "
^DIC(9.4,60,22,13,"PAH",584,1,645,0)="   "
^DIC(9.4,60,22,13,"PAH",584,1,646,0)="   q)A new option was added to the Single Patient Queue: JB (Jump to"
^DIC(9.4,60,22,13,"PAH",584,1,647,0)="     Backdoor). Instead of jumping to the Complete Orders from OERR [PSO LMO"
^DIC(9.4,60,22,13,"PAH",584,1,648,0)="     FINISH] option it will jump to the Patient Prescription Processing [PSO"
^DIC(9.4,60,22,13,"PAH",584,1,649,0)="     LM BACKDOOR ORDERS option."
^DIC(9.4,60,22,13,"PAH",584,1,650,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,651,0)="   r)Within the Rx Medication Screen (or Rx List View Screen) the user will"
^DIC(9.4,60,22,13,"PAH",584,1,652,0)="     have the ability to easily filter the list by Message Type by selecting"
^DIC(9.4,60,22,13,"PAH",584,1,653,0)="     one of the following hidden actions."
^DIC(9.4,60,22,13,"PAH",584,1,654,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,655,0)="           NEW  New Rx's Only"
^DIC(9.4,60,22,13,"PAH",584,1,656,0)="           CR   Change Request Only           "
^DIC(9.4,60,22,13,"PAH",584,1,657,0)="           RXF  Rx Refill Only     "
^DIC(9.4,60,22,13,"PAH",584,1,658,0)="           IE   Inbound Errors Only "
^DIC(9.4,60,22,13,"PAH",584,1,659,0)="           OE   Outbound Errors Only"
^DIC(9.4,60,22,13,"PAH",584,1,660,0)="           CA   Cancel Rx's Only   "
^DIC(9.4,60,22,13,"PAH",584,1,661,0)="           CN   Cancel Response Only"
^DIC(9.4,60,22,13,"PAH",584,1,662,0)="           CX   Change Response Only"
^DIC(9.4,60,22,13,"PAH",584,1,663,0)="           RRQ  Renewal Request Only "
^DIC(9.4,60,22,13,"PAH",584,1,664,0)="           RRP  Renewal Response Only"
^DIC(9.4,60,22,13,"PAH",584,1,665,0)="           ALL  All Message Types"
^DIC(9.4,60,22,13,"PAH",584,1,666,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,667,0)="     Note: The same result can be accomplished via the SQ (Search Queue)"
^DIC(9.4,60,22,13,"PAH",584,1,668,0)="           action and selecting #7 and then the specific message type."
^DIC(9.4,60,22,13,"PAH",584,1,669,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,670,0)="   s)The NDC code will now be printed under the eRx Drug in the output print"
^DIC(9.4,60,22,13,"PAH",584,1,671,0)="     from the Print eRx action, as shown below:"
^DIC(9.4,60,22,13,"PAH",584,1,672,0)="         ..."
^DIC(9.4,60,22,13,"PAH",584,1,673,0)="         ***************PRESCRIPTION INFORMATION******************"
^DIC(9.4,60,22,13,"PAH",584,1,674,0)="         eRx Drug: MELOXICAM 15MG TAB "
^DIC(9.4,60,22,13,"PAH",584,1,675,0)="         NDC: 00378108901"
^DIC(9.4,60,22,13,"PAH",584,1,676,0)="         eRx Written Date: MAR 17, 2023      eRx Issue Date: "
^DIC(9.4,60,22,13,"PAH",584,1,677,0)="         ..."
^DIC(9.4,60,22,13,"PAH",584,1,678,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,679,0)="   t)The Remove eRx (RM) action will now work for eRx records that are "
^DIC(9.4,60,22,13,"PAH",584,1,680,0)="     currently on Hold. Before, the user had to Un-Hold the record before"
^DIC(9.4,60,22,13,"PAH",584,1,681,0)="     removing it."
^DIC(9.4,60,22,13,"PAH",584,1,682,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,683,0)="   u)The Jump to OP (JO) action only allowed the user to 'jump' to Backdoor"
^DIC(9.4,60,22,13,"PAH",584,1,684,0)="     Pharmacy option if the patient had pending orders to be finished. This"
^DIC(9.4,60,22,13,"PAH",584,1,685,0)="     restriction is being removed by this patch."
^DIC(9.4,60,22,13,"PAH",584,1,686,0)="      "
^DIC(9.4,60,22,13,"PAH",584,1,687,0)="16.INC25762338 - Broken eRx drug auto-match on RxRenewalResponses"
^DIC(9.4,60,22,13,"PAH",584,1,688,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,689,0)="   The ticket above will be addressed by this patch. This issue was caused by"
^DIC(9.4,60,22,13,"PAH",584,1,690,0)="   PSO*7*706 released on December 12th, 2022. This patch moved the"
^DIC(9.4,60,22,13,"PAH",584,1,691,0)="   auto-matching functionality of provider and drug from the Hub to VistA. "
^DIC(9.4,60,22,13,"PAH",584,1,692,0)="   However, the VistA did not implement drug auto-matching for "
^DIC(9.4,60,22,13,"PAH",584,1,693,0)="   RxRenewalResponse records forcing the users to match the VistA dispense"
^DIC(9.4,60,22,13,"PAH",584,1,694,0)="   drug manually. This patch will fix the issue by extending the VistA "
^DIC(9.4,60,22,13,"PAH",584,1,695,0)="   auto-matching functionality to RxRenewalResponse records as well."
^DIC(9.4,60,22,13,"PAH",584,1,696,0)="  "
^DIC(9.4,60,22,13,"PAH",584,1,697,0)="17.Routing field edit enabled for CS eRx orders"
^DIC(9.4,60,22,13,"PAH",584,1,698,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,699,0)="   Users will now be allowed to edit the Routing (Mail/Window) field for a CS"
^DIC(9.4,60,22,13,"PAH",584,1,700,0)="   eRx Pending order. Before, all field were un-editable in the OP Pending"
^DIC(9.4,60,22,13,"PAH",584,1,701,0)="   Order Queue because an audit is not captured. However, the Remarks field"
^DIC(9.4,60,22,13,"PAH",584,1,702,0)="   does not exist until created by the user in the OP Pending Order Queue."
^DIC(9.4,60,22,13,"PAH",584,1,703,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,704,0)="18.New Pending Order side-by-side interface for eRx orders"
^DIC(9.4,60,22,13,"PAH",584,1,705,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,706,0)="   Similar to the eRx Drug Validation screen shown above the view of a pending"
^DIC(9.4,60,22,13,"PAH",584,1,707,0)="   order that originated from an eRx will be displayed differently in the "
^DIC(9.4,60,22,13,"PAH",584,1,708,0)="   Patient Prescription Processing [PSO LM BACKDOOR ORDERS] and Complete"
^DIC(9.4,60,22,13,"PAH",584,1,709,0)="   Orders from OERR [PSO LMOE FINISH] options. When these option identify the"
^DIC(9.4,60,22,13,"PAH",584,1,710,0)="   pending order an eRx prescription it will automatically switch the display"
^DIC(9.4,60,22,13,"PAH",584,1,711,0)="   of the data to a side-by-side viewing where the left side shows the eRx "
^DIC(9.4,60,22,13,"PAH",584,1,712,0)="   prescription information (from the outside doctor) while the right-side"
^DIC(9.4,60,22,13,"PAH",584,1,713,0)="   shows the VistA corresponding information."
^DIC(9.4,60,22,13,"PAH",584,1,714,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,715,0)="   Besides displaying the information side-by-side, a few other features were"
^DIC(9.4,60,22,13,"PAH",584,1,716,0)="   introduced to make the screen more user friendly, such as:"
^DIC(9.4,60,22,13,"PAH",584,1,717,0)="     a) When there is a mismatch for field (e.g., Drug Name, Qty, etc.) the "
^DIC(9.4,60,22,13,"PAH",584,1,718,0)="        content of such field will display in reverse video for both fields,"
^DIC(9.4,60,22,13,"PAH",584,1,719,0)="        eRx and VistA."
^DIC(9.4,60,22,13,"PAH",584,1,720,0)="     b) The content will display in highlight in order to stand from the field"
^DIC(9.4,60,22,13,"PAH",584,1,721,0)="        label. "
^DIC(9.4,60,22,13,"PAH",584,1,722,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,723,0)="     Obs) These features depend on the terminal display settings being set"
^DIC(9.4,60,22,13,"PAH",584,1,724,0)="          differently for reverse video and highlighted font in order for it"
^DIC(9.4,60,22,13,"PAH",584,1,725,0)="          to work."
^DIC(9.4,60,22,13,"PAH",584,1,726,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,727,0)="   Below is an example of how the new screen will be displayed (without the"
^DIC(9.4,60,22,13,"PAH",584,1,728,0)="   reverse or highlighted video features) for a new eRx Pending Order:"
^DIC(9.4,60,22,13,"PAH",584,1,729,0)=" "
