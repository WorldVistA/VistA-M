^DIC(9.4,4,22,1,"PAH",143,0)="176 SEQ #168^3010412^1"
^DIC(9.4,4,22,1,"PAH",143,1,0)="^^87^87^3010412"
^DIC(9.4,4,22,1,"PAH",143,1,1,0)="Patch XM*7.1*176"
^DIC(9.4,4,22,1,"PAH",143,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,3,0)="Test Site:  FORUM"
^DIC(9.4,4,22,1,"PAH",143,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,5,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",143,1,6,0)="Improve MailMan's actions at the sending site during remote transmissions"
^DIC(9.4,4,22,1,"PAH",143,1,7,0)="if the receiving site notifies the sending site that a recipient isn't found."
^DIC(9.4,4,22,1,"PAH",143,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,9,0)="We had a problem at GATEWAY transmitting to GK.  GK didn't like a recipient,"
^DIC(9.4,4,22,1,"PAH",143,1,10,0)="so GATEWAY tried again in lower case, as it usually does.  GK then closed"
^DIC(9.4,4,22,1,"PAH",143,1,11,0)="the connection.  This left the offending message clogging the queue at"
^DIC(9.4,4,22,1,"PAH",143,1,12,0)="GATEWAY.  The fix is that if the receiving site is non-MailMan, and the"
^DIC(9.4,4,22,1,"PAH",143,1,13,0)="receiving site does not like the recipient, the sending site will not try"
^DIC(9.4,4,22,1,"PAH",143,1,14,0)="that recipient again."
^DIC(9.4,4,22,1,"PAH",143,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,16,0)="NOTE: This patch requires MailMan patch XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",143,1,17,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",143,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,19,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",143,1,20,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",143,1,21,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",143,1,22,0)=" "
^DIC(9.4,4,22,1,"PAH",143,1,23,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",143,1,24,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",143,1,25,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",143,1,26,0)="XMSM           7239792         7204635        4,6,13,20,50,176"
^DIC(9.4,4,22,1,"PAH",143,1,27,0)="XMSMAIL        4239659         4266359        59,50,107,176"
^DIC(9.4,4,22,1,"PAH",143,1,28,0)="XMXADDR3       7292198         7967909        107,139,148,176"
^DIC(9.4,4,22,1,"PAH",143,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,30,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",143,1,31,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,32,0)="This patch introduces no new routines"
^DIC(9.4,4,22,1,"PAH",143,1,33,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",143,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",143,1,35,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",143,1,36,0)="NOTE: This patch requires MailMan patch XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",143,1,37,0)="1.  Users should not be on the system during patch installation."
^DIC(9.4,4,22,1,"PAH",143,1,38,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",143,1,39,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",143,1,40,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",143,1,41,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",143,1,42,0)="4.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",143,1,43,0)="    option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",143,1,44,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",143,1,45,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",143,1,46,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",143,1,47,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",143,1,48,0)="5.  Stop TaskMan.  Shut down the listeners.  You may also wish to shut down"
^DIC(9.4,4,22,1,"PAH",143,1,49,0)="    HL7 filers/LLP's and other background tasks which may attempt to create"
^DIC(9.4,4,22,1,"PAH",143,1,50,0)="    new messages.  During the installation of this patch, we do not want any"
^DIC(9.4,4,22,1,"PAH",143,1,51,0)="    messages coming in or going out.  Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",143,1,52,0)="6.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",143,1,53,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",143,1,54,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",143,1,55,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",143,1,56,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",143,1,57,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",143,1,58,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",143,1,59,0)=" Select INSTALL NAME:    XM*7.1*176     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",143,1,60,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",143,1,61,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",143,1,62,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,4,22,1,"PAH",143,1,63,0)="                                                       ==="
^DIC(9.4,4,22,1,"PAH",143,1,64,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// YES"
^DIC(9.4,4,22,1,"PAH",143,1,65,0)="                                                                       ==="
^DIC(9.4,4,22,1,"PAH",143,1,66,0)=" Enter options you wish to mark as 'Out Of Order': XMUSER       MailMan Menu"
^DIC(9.4,4,22,1,"PAH",143,1,67,0)="                                                   ======"
^DIC(9.4,4,22,1,"PAH",143,1,68,0)=" Enter options you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",143,1,69,0)="                                                   =============="
^DIC(9.4,4,22,1,"PAH",143,1,70,0)=" Enter protocols you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",143,1,71,0)="                                                     =============="
^DIC(9.4,4,22,1,"PAH",143,1,72,0)=" Delay Install (Minutes):  (0-60): 0// <press return>"
^DIC(9.4,4,22,1,"PAH",143,1,73,0)="                                       =============="
^DIC(9.4,4,22,1,"PAH",143,1,74,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",143,1,75,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",143,1,76,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",143,1,77,0)=""
^DIC(9.4,4,22,1,"PAH",143,1,78,0)=" DEVICE: HOME// <Do not queue this.>"
^DIC(9.4,4,22,1,"PAH",143,1,79,0)="                --------------------"
^DIC(9.4,4,22,1,"PAH",143,1,80,0)="7.  Start TaskMan.  If you shut down HL7 filers/LLP's and other"
^DIC(9.4,4,22,1,"PAH",143,1,81,0)="    background tasks in step 5, be sure to restart them, too."
^DIC(9.4,4,22,1,"PAH",143,1,82,0)="8.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",143,1,83,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",143,1,84,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",143,1,85,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",143,1,86,0)="9.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",143,1,87,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",144,0)="163 SEQ #169^3010423^1"
^DIC(9.4,4,22,1,"PAH",144,1,0)="^^125^125^3010423"
^DIC(9.4,4,22,1,"PAH",144,1,1,0)="Patch XM*7.1*163"
^DIC(9.4,4,22,1,"PAH",144,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,3,0)="E3R 2658, 8649, 15053"
^DIC(9.4,4,22,1,"PAH",144,1,4,0)="Test Sites:  Puget Sound HCS, Charleston, SC"
^DIC(9.4,4,22,1,"PAH",144,1,5,0)="When users join a mail group, or when users are added to mail groups,"
^DIC(9.4,4,22,1,"PAH",144,1,6,0)="optionally Find and Forward past mail group messages to the users."
^DIC(9.4,4,22,1,"PAH",144,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,8,0)="The following options now include this capability:"
^DIC(9.4,4,22,1,"PAH",144,1,9,0)="XMEDITMG                       - Mail Group Edit"
^DIC(9.4,4,22,1,"PAH",144,1,10,0)="XMENROLL                       - Enroll in (or Disenroll from) a Mail Group"
^DIC(9.4,4,22,1,"PAH",144,1,11,0)="XMMGR-MAIL-GRP-COORDINATOR     - Mail Group Coordinator's Edit"
^DIC(9.4,4,22,1,"PAH",144,1,12,0)="XMMGR-MAIL-GRP-COORD-W/REMOTES - Mail Group Coordinator's Edit W/Remotes"
^DIC(9.4,4,22,1,"PAH",144,1,13,0)="XMEDITPERSGROUP                - Personal Mail Group Edit"
^DIC(9.4,4,22,1,"PAH",144,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,15,0)="The option XMEDITMG is being converted from an 'edit' type option to a 'run"
^DIC(9.4,4,22,1,"PAH",144,1,16,0)="routine' type option.  The pre-init, ^XMYPRE11, will delete the fields in the"
^DIC(9.4,4,22,1,"PAH",144,1,17,0)="option which are no longer applicable."
^DIC(9.4,4,22,1,"PAH",144,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,19,0)="The pre-init will also check entries in file 3.8, MAIL GROUP.  If the group is"
^DIC(9.4,4,22,1,"PAH",144,1,20,0)="public, any entry in the 'Restrictions' field (#10) will be deleted.  (This"
^DIC(9.4,4,22,1,"PAH",144,1,21,0)="field only applies to private groups.)  If the group is private, any entry in"
^DIC(9.4,4,22,1,"PAH",144,1,22,0)="the 'Allow self-enrollment?' (#7) field will be deleted.  This field only"
^DIC(9.4,4,22,1,"PAH",144,1,23,0)="applies to public groups. "
^DIC(9.4,4,22,1,"PAH",144,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,25,0)="If someone other than the organizer or coordinator adds users to a public"
^DIC(9.4,4,22,1,"PAH",144,1,26,0)="mail group which doesn't allow self-enrollment, or to a private mail group,"
^DIC(9.4,4,22,1,"PAH",144,1,27,0)="a new bulletin, XM GROUP EDIT NOTIFY, is sent to the organizer and"
^DIC(9.4,4,22,1,"PAH",144,1,28,0)="coordinator to let them know which users were added and who added them."
^DIC(9.4,4,22,1,"PAH",144,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,30,0)="A new security key, XM GROUP EDIT MASTER, is being created, which should be"
^DIC(9.4,4,22,1,"PAH",144,1,31,0)="assigned to any users, such as ADPACs, who need to be able to edit other"
^DIC(9.4,4,22,1,"PAH",144,1,32,0)="users' mail groups."
^DIC(9.4,4,22,1,"PAH",144,1,33,0)="NAME: XM GROUP EDIT MASTER"
^DIC(9.4,4,22,1,"PAH",144,1,34,0)="  DESCRIPTIVE NAME: Edit other users' mail groups"
^DIC(9.4,4,22,1,"PAH",144,1,35,0)=" DESCRIPTION:   People who need to be able to edit other users' mail groups"
^DIC(9.4,4,22,1,"PAH",144,1,36,0)=" and add new users to them should be assigned this key.  "
^DIC(9.4,4,22,1,"PAH",144,1,37,0)="  "
^DIC(9.4,4,22,1,"PAH",144,1,38,0)=" Holders of this key may edit any mail group, except personal mail groups. "
^DIC(9.4,4,22,1,"PAH",144,1,39,0)=" (Personal mail groups are those which only the organizer may edit or use.) "
^DIC(9.4,4,22,1,"PAH",144,1,40,0)="  "
^DIC(9.4,4,22,1,"PAH",144,1,41,0)=" The following users should NOT be given this key, because they already"
^DIC(9.4,4,22,1,"PAH",144,1,42,0)=" possess the privilege this key grants: "
^DIC(9.4,4,22,1,"PAH",144,1,43,0)="  - Holders of the XMMGR key.  "
^DIC(9.4,4,22,1,"PAH",144,1,44,0)="  - Clinical Application Coordinators, as identified in file 8930,"
^DIC(9.4,4,22,1,"PAH",144,1,45,0)=" USR Class, belonging to the TIU package.  "
^DIC(9.4,4,22,1,"PAH",144,1,46,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,47,0)="Applicable Help frames are updated."
^DIC(9.4,4,22,1,"PAH",144,1,48,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,49,0)="New APIs have been added.  See DBIA 3006."
^DIC(9.4,4,22,1,"PAH",144,1,50,0)="ADDMBRS^XMXAPIG  - Add members to mail groups.  Optionally forward past"
^DIC(9.4,4,22,1,"PAH",144,1,51,0)="                   mail group messages."
^DIC(9.4,4,22,1,"PAH",144,1,52,0)="JOIN^XMXAPIG     - Enable user to enroll in mail group.  Optionally forward"
^DIC(9.4,4,22,1,"PAH",144,1,53,0)="                   past mail group messages."
^DIC(9.4,4,22,1,"PAH",144,1,54,0)="DROP^XMXAPIG     - Enable user to drop from a mail group."
^DIC(9.4,4,22,1,"PAH",144,1,55,0)="$$MEMBER^XMXAPIG - Is user a member of a mail group?"
^DIC(9.4,4,22,1,"PAH",144,1,56,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,57,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",144,1,58,0)="is at a minimum.  It requires MailMan patches XM*7.1*141 & XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",144,1,59,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",144,1,60,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,61,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",144,1,62,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",144,1,63,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",144,1,64,0)=" "
^DIC(9.4,4,22,1,"PAH",144,1,65,0)="            Before        After"
^DIC(9.4,4,22,1,"PAH",144,1,66,0)="Name        Checksum      Checksum      Patch List"
^DIC(9.4,4,22,1,"PAH",144,1,67,0)="---------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",144,1,68,0)="XMVGROUP     7972968      12125651      50,104,107,131,141,163"
^DIC(9.4,4,22,1,"PAH",144,1,69,0)="XMVGRP       * NEW *      10944118      163"
^DIC(9.4,4,22,1,"PAH",144,1,70,0)="XMXADDR     15075462      15486856      50,96,101,104,107,131,148,163"
^DIC(9.4,4,22,1,"PAH",144,1,71,0)="XMXADDR1    12201693      12248366      50,78,83,96,104,107,127,138,148,163"
^DIC(9.4,4,22,1,"PAH",144,1,72,0)="XMXADDR4     7386662       7400001      107,148,163"
^DIC(9.4,4,22,1,"PAH",144,1,73,0)="XMXADDRG    14941972      15107024      50,99,107,139,148,163"
^DIC(9.4,4,22,1,"PAH",144,1,74,0)="XMXAPIG      1692175       4324918      109,146,163"
^DIC(9.4,4,22,1,"PAH",144,1,75,0)="XMXGRP       * NEW *       9502286      163"
^DIC(9.4,4,22,1,"PAH",144,1,76,0)="XMXGRP1      * NEW *      10875164      163"
^DIC(9.4,4,22,1,"PAH",144,1,77,0)="XMYPRE11     * NEW *        687829      163"
^DIC(9.4,4,22,1,"PAH",144,1,78,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",144,1,79,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,80,0)="This patch introduces the following new routines:"
^DIC(9.4,4,22,1,"PAH",144,1,81,0)="XMVGRP   - no user-callable entry points."
^DIC(9.4,4,22,1,"PAH",144,1,82,0)="XMXGRP   - no user-callable entry points."
^DIC(9.4,4,22,1,"PAH",144,1,83,0)="XMXGRP1  - no user-callable entry points."
^DIC(9.4,4,22,1,"PAH",144,1,84,0)="XMYPRE11 - no user-callable entry points."
^DIC(9.4,4,22,1,"PAH",144,1,85,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",144,1,86,0)=" "
^DIC(9.4,4,22,1,"PAH",144,1,87,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",144,1,88,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",144,1,89,0)="is at a minimum.  It requires MailMan patches XM*7.1*141 & XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",144,1,90,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",144,1,91,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",144,1,92,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",144,1,93,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",144,1,94,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",144,1,95,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",144,1,96,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",144,1,97,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",144,1,98,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",144,1,99,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",144,1,100,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",144,1,101,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",144,1,102,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",144,1,103,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",144,1,104,0)=" Select INSTALL NAME:    XM*7.1*163    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",144,1,105,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",144,1,106,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",144,1,107,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,108,0)="Incoming Files:"
^DIC(9.4,4,22,1,"PAH",144,1,109,0)="   3.8       MAIL GROUP  (Partial Definition)"
^DIC(9.4,4,22,1,"PAH",144,1,110,0)="Note:  You already have the 'MAIL GROUP' File."
^DIC(9.4,4,22,1,"PAH",144,1,111,0)=""
^DIC(9.4,4,22,1,"PAH",144,1,112,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
