^DIC(9.4,49,22,10,"PAH",339,0)="436 SEQ #408^3110127.091222^17"
^DIC(9.4,49,22,10,"PAH",339,1,0)="^^1^1^3110127"
^DIC(9.4,49,22,10,"PAH",339,1,1,0)="HIPAA 5010 effort: enhancements 7, 9, and 11"
^DIC(9.4,49,22,10,"PAH",340,0)="437 SEQ #409^3110222.131403^17"
^DIC(9.4,49,22,10,"PAH",340,1,0)="^^6^6^3110222"
