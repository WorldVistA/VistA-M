^DIC(9.4,188,0)="FUNCTIONAL INDEPENDENCE^RMIM^RMIM"
^DIC(9.4,188,20,0)="^9.402P^^"
^DIC(9.4,188,22,0)="^9.49I^1^1"
^DIC(9.4,188,22,1,0)="1.0^3051119^3030520^1"
^DIC(9.4,188,22,1,1,0)="^^5^5^3051119"
^DIC(9.4,188,22,1,1,1,0)="The Functional Independence Measurement (FIM) consists of a Delphi form"
^DIC(9.4,188,22,1,1,2,0)="and associated M routines that provides the ability to enter FIM data"
^DIC(9.4,188,22,1,1,3,0)="into the FSOD database and CPRS progress notes.  Data is stored in a"
^DIC(9.4,188,22,1,1,4,0)="local FileMan database for later transmission to the FSOD database in"
^DIC(9.4,188,22,1,1,5,0)="Austin."
^DIC(9.4,188,22,1,"PAH",0)="^9.4901^11^11"
^DIC(9.4,188,22,1,"PAH",1,0)="1^3021028^6663"
^DIC(9.4,188,22,1,"PAH",1,1,0)="^9.49011^5^5^3021209^"
^DIC(9.4,188,22,1,"PAH",1,1,1,0)="The Functional Independence Measurement (FIM) consists of a Delphi form "
^DIC(9.4,188,22,1,"PAH",1,1,2,0)="and associated M routines that provides the ability to enter FIM data "
^DIC(9.4,188,22,1,"PAH",1,1,3,0)="into the FSOD database and CPRS progress notes.  Data is stored in a "
^DIC(9.4,188,22,1,"PAH",1,1,4,0)="local FileMan database for later transmission to the FSOD database in "
^DIC(9.4,188,22,1,"PAH",1,1,5,0)="Austin."
^DIC(9.4,188,22,1,"PAH",2,0)="1 SEQ #1^3031023^1"
^DIC(9.4,188,22,1,"PAH",2,1,0)="^^1^1^3031023"
^DIC(9.4,188,22,1,"PAH",2,1,1,0)="New version option only"
^DIC(9.4,188,22,1,"PAH",3,0)="2 SEQ #2^3040302^1"
^DIC(9.4,188,22,1,"PAH",3,1,0)="^^1^1^3040302"
^DIC(9.4,188,22,1,"PAH",3,1,1,0)="New version to address issues found in patch 1 (RMIM*1.0*1)."
^DIC(9.4,188,22,1,"PAH",4,0)="3 SEQ #3^3040903^1"
^DIC(9.4,188,22,1,"PAH",4,1,0)="^^4^4^3040903"
^DIC(9.4,188,22,1,"PAH",4,1,1,0)="Fixes for first time users unable to access GUI, imprecise DOB error, "
^DIC(9.4,188,22,1,"PAH",4,1,2,0)="and file access issue with RMIM EDIT SITE PARAMETER option.  "
^DIC(9.4,188,22,1,"PAH",4,1,3,0)="Addition of'0-Unspecified' to Admission Class list and change from Rehab  "
^DIC(9.4,188,22,1,"PAH",4,1,4,0)="Bed Unit Admission Date/Discharge Date to Therapy Start Date/End Date."
^DIC(9.4,188,22,1,"PAH",5,0)="4 SEQ #4^3050426^1"
^DIC(9.4,188,22,1,"PAH",5,1,0)="^^1^1^3050426"
^DIC(9.4,188,22,1,"PAH",5,1,1,0)="USER NOT GETTING PROMPTED TO COMPLETE A CONSULT"
^DIC(9.4,188,22,1,"PAH",6,0)="5 SEQ #5^3080722.144048^1"
^DIC(9.4,188,22,1,"PAH",6,1,0)="^^1^1^3080722"
^DIC(9.4,188,22,1,"PAH",6,1,1,0)="New version to address issue found in patch 5 (RMIM*1.0*5)"
^DIC(9.4,188,22,1,"PAH",7,0)="7 SEQ #7^3150916.111604^17"
^DIC(9.4,188,22,1,"PAH",7,1,0)="^^2^2^3150916"
^DIC(9.4,188,22,1,"PAH",7,1,1,0)="This patch corrects problems with the cosigner not receiving notification "
^DIC(9.4,188,22,1,"PAH",7,1,2,0)="they need to cosign a report.  "
^DIC(9.4,188,22,1,"PAH",8,0)="8 SEQ #8^3170403.154859^54"
^DIC(9.4,188,22,1,"PAH",8,1,0)="^^6^6^3170403"
^DIC(9.4,188,22,1,"PAH",8,1,1,0)="This patch addresses one Functional Independence issue:"
^DIC(9.4,188,22,1,"PAH",8,1,2,0)=" "
^DIC(9.4,188,22,1,"PAH",8,1,3,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,188,22,1,"PAH",8,1,4,0)="(2FA) compliant the Functional Independence Measurement (FIM) Graphical"
^DIC(9.4,188,22,1,"PAH",8,1,5,0)="User Interface (GUI) requires an upgrade to Delphi version XE8 in order to"
^DIC(9.4,188,22,1,"PAH",8,1,6,0)="implement the new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,188,22,1,"PAH",9,0)="9 SEQ #9^3181102.155317^54"
^DIC(9.4,188,22,1,"PAH",9,1,0)="^^1^1^3181102"
^DIC(9.4,188,22,1,"PAH",9,1,1,0)="FIM WINDOWS 10 UPDATES"
^DIC(9.4,188,22,1,"PAH",10,0)="10 SEQ #10^3191113.145517^65"
^DIC(9.4,188,22,1,"PAH",10,1,0)="^^1^1^3191113"
^DIC(9.4,188,22,1,"PAH",10,1,1,0)="VISTA SECURITY REMEDIATION UPDATES FOR FOUR SLASHES"
^DIC(9.4,188,22,1,"PAH",11,0)="11 SEQ #11^3201103.140728^17"
^DIC(9.4,188,22,1,"PAH",11,1,0)="^^3^3^3201103"
^DIC(9.4,188,22,1,"PAH",11,1,1,0)="Functional Independence Measurement (FIM) Graphical User "
^DIC(9.4,188,22,1,"PAH",11,1,2,0)="Interface (GUI) update for VA Technical Reference Model "
^DIC(9.4,188,22,1,"PAH",11,1,3,0)="(TRM) compliance"
^DIC(9.4,188,22,1,"PAH","B",1,1)=""
