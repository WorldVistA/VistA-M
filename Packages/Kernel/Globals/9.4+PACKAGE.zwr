^DIC(9.4,48,22,5.28,"PAH",198,1,1,0)="See patch SD*5.3*268 in the NPM for complete information on this patch."
^DIC(9.4,48,22,5.28,"PAH",199,0)="271 SEQ #240^3021008^1"
^DIC(9.4,48,22,5.28,"PAH",199,1,0)="^^1^1^3021008"
^DIC(9.4,48,22,5.28,"PAH",199,1,1,0)="See patch SD*5.3*271 in the NPM for complete information on this patch."
^DIC(9.4,48,22,5.28,"PAH",200,0)="253 SEQ #241^3021008^1"
^DIC(9.4,48,22,5.28,"PAH",200,1,0)="^^11^11^3021008"
^DIC(9.4,48,22,5.28,"PAH",200,1,1,0)="This patch contains the first release of a series of APIs that will "
^DIC(9.4,48,22,5.28,"PAH",200,1,2,0)="be used to integrate M-based Class I, Class III and local applications"
^DIC(9.4,48,22,5.28,"PAH",200,1,3,0)="with the Government Off-the-Shelf (GOTS) Scheduling application being"
^DIC(9.4,48,22,5.28,"PAH",200,1,4,0)="developed by the Scheduling Replacement team."
^DIC(9.4,48,22,5.28,"PAH",200,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",200,1,6,0)="The APIs contained in this patch will replace other methods of"
^DIC(9.4,48,22,5.28,"PAH",200,1,7,0)="accessing the patient appointment information stored in the "
^DIC(9.4,48,22,5.28,"PAH",200,1,8,0)="Patient sub-file(#2.98) and the Hospital Location sub-file "
^DIC(9.4,48,22,5.28,"PAH",200,1,9,0)="(#44.001).  During implementation of the new GOTS Scheduler, this "
^DIC(9.4,48,22,5.28,"PAH",200,1,10,0)="appointment information will be moved to the GOTS database and "
^DIC(9.4,48,22,5.28,"PAH",200,1,11,0)="deleted from the Scheduling files."
^DIC(9.4,48,22,5.28,"PAH",201,0)="245^3021025^1"
^DIC(9.4,48,22,5.28,"PAH",202,0)="263^3021116^1"
^DIC(9.4,48,22,5.28,"PAH",202,1,0)="^^1^1^3021116"
^DIC(9.4,48,22,5.28,"PAH",202,1,1,0)="ELECTRONIC WAIT LIST VERSION 1.0"
^DIC(9.4,48,22,5.28,"PAH",203,0)="264 SEQ #244^3021116^1"
^DIC(9.4,48,22,5.28,"PAH",203,1,0)="^^2^2^3021116"
^DIC(9.4,48,22,5.28,"PAH",203,1,1,0)=" "
^DIC(9.4,48,22,5.28,"PAH",203,1,2,0)="^"
^DIC(9.4,48,22,5.28,"PAH",204,0)="258^3021209^1"
^DIC(9.4,48,22,5.28,"PAH",204,1,0)="^^50^50^3021209"
^DIC(9.4,48,22,5.28,"PAH",204,1,1,0)="This patch addresses Geographic Means Test as a new Means Test Indicator "
^DIC(9.4,48,22,5.28,"PAH",204,1,2,0)="under Ambulatory Care Reporting.  In addition, two reports under the "
^DIC(9.4,48,22,5.28,"PAH",204,1,3,0)="Ambulatory Care menu have been modified to address the new GMT indicator "
^DIC(9.4,48,22,5.28,"PAH",204,1,4,0)="and changes to descriptions of three other means test indicators."
^DIC(9.4,48,22,5.28,"PAH",204,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,6,0)="1.  The algorithm logic in Ambulatory Care for determining the means test "
^DIC(9.4,48,22,5.28,"PAH",204,1,7,0)="    indicator in $$MTI^SCDXUTL0 has been modified to include patients with"
^DIC(9.4,48,22,5.28,"PAH",204,1,8,0)="    GMT COPAY REQUIRED status.  A new API ($$PA^DGMTUTL) is used to"
^DIC(9.4,48,22,5.28,"PAH",204,1,9,0)="    determine whether a status of 'pending adjudication' will return 'mt"
^DIC(9.4,48,22,5.28,"PAH",204,1,10,0)="    copay required' or 'gmt copay required' for a means test indicator."
^DIC(9.4,48,22,5.28,"PAH",204,1,11,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,12,0)="2.  Ambulatory Care validity checks have been modified to include the new "
^DIC(9.4,48,22,5.28,"PAH",204,1,13,0)="    GMT means test indicator."
^DIC(9.4,48,22,5.28,"PAH",204,1,14,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,15,0)="3.  The Means Test/Eligibility/Enrollment Report [SCRPW MT/ELIG/ENROLLMENT"
^DIC(9.4,48,22,5.28,"PAH",204,1,16,0)="    RPT] has been modified to address the following:"
^DIC(9.4,48,22,5.28,"PAH",204,1,17,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,18,0)="        a. Include the new GMT COPAY REQUIRED means test indicator."
^DIC(9.4,48,22,5.28,"PAH",204,1,19,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,20,0)="        b. Change the description of three existing means test indicators "
^DIC(9.4,48,22,5.28,"PAH",204,1,21,0)="           to reflect Enrollment changes to means test statuses of CAT A "
^DIC(9.4,48,22,5.28,"PAH",204,1,22,0)="           and CAT C. The means test indicators will refect the following "
^DIC(9.4,48,22,5.28,"PAH",204,1,23,0)="           changes:"
^DIC(9.4,48,22,5.28,"PAH",204,1,24,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,25,0)="           Old Values               New Values"
^DIC(9.4,48,22,5.28,"PAH",204,1,26,0)="           --------------------     -----------------------"
^DIC(9.4,48,22,5.28,"PAH",204,1,27,0)="           AS   SC CATEGORY A       AS   SC MT COPAY EXEMPT"
^DIC(9.4,48,22,5.28,"PAH",204,1,28,0)="           AN   NSC CATEGORY A      AN   NSC MT COPAY EXEMPT"
^DIC(9.4,48,22,5.28,"PAH",204,1,29,0)="           C    CATEGORY C          C    MT COPAY REQUIRED"
^DIC(9.4,48,22,5.28,"PAH",204,1,30,0)="                                    G   GMT COPAY REQUIRED"
^DIC(9.4,48,22,5.28,"PAH",204,1,31,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,32,0)="        c. Change column descriptions in the report to reflect new "
^DIC(9.4,48,22,5.28,"PAH",204,1,33,0)="           changes."
^DIC(9.4,48,22,5.28,"PAH",204,1,34,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,35,0)="        d. Include a new Group 8 Enrollment Priority to reflect "
^DIC(9.4,48,22,5.28,"PAH",204,1,36,0)="           Enrollment's addition of a new enrollment priority."
^DIC(9.4,48,22,5.28,"PAH",204,1,37,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,38,0)="4.  The Means Test Visits & Uniques (OP3, OP4, OP5) report [SCRPW DVM "
^DIC(9.4,48,22,5.28,"PAH",204,1,39,0)="    MEANS TEST SUMMARY] has been modified to address Enrollment changes."
^DIC(9.4,48,22,5.28,"PAH",204,1,40,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,41,0)="        a. Include the new GMT COPAY REQUIRED means test indicator."
^DIC(9.4,48,22,5.28,"PAH",204,1,42,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,43,0)="        b. Column headings have been changed to the following:"
^DIC(9.4,48,22,5.28,"PAH",204,1,44,0)=" "
^DIC(9.4,48,22,5.28,"PAH",204,1,45,0)="           Old Description                    New Description"
^DIC(9.4,48,22,5.28,"PAH",204,1,46,0)="           --------------------------------   ----------------------"
^DIC(9.4,48,22,5.28,"PAH",204,1,47,0)="           CATEGORY A SERVICE CONNECTED       SC - MT COPAY EXEMPT"
^DIC(9.4,48,22,5.28,"PAH",204,1,48,0)="           CATEGORY A NON-SERVICE CONNECTED   NSC - MT COPAY EXEMPT"
^DIC(9.4,48,22,5.28,"PAH",204,1,49,0)="           CATEGORY C                         MT COPAY REQUIRED"
^DIC(9.4,48,22,5.28,"PAH",204,1,50,0)="                                              GMT COPAY REQUIRED"
^DIC(9.4,48,22,5.28,"PAH",205,0)="270 SEQ #246^3021209^1"
^DIC(9.4,48,22,5.28,"PAH",205,1,0)="^^1^1^3021209"
^DIC(9.4,48,22,5.28,"PAH",205,1,1,0)="Patch to transmit data to AAC."
^DIC(9.4,48,22,5.28,"PAH",206,0)="254^3030109^1"
^DIC(9.4,48,22,5.28,"PAH",207,0)="275 SEQ #249^3030123^1"
^DIC(9.4,48,22,5.28,"PAH",207,1,0)="^^11^11^3030123"
^DIC(9.4,48,22,5.28,"PAH",207,1,1,0)="This patch contains the first release of a series of APIs that will "
^DIC(9.4,48,22,5.28,"PAH",207,1,2,0)="be used to integrate M-based Class I, Class III and local applications"
^DIC(9.4,48,22,5.28,"PAH",207,1,3,0)="with the Government Off-the-Shelf (GOTS) Scheduling application being"
^DIC(9.4,48,22,5.28,"PAH",207,1,4,0)="developed by the Scheduling Replacement team."
^DIC(9.4,48,22,5.28,"PAH",207,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",207,1,6,0)="The APIs contained in this patch will replace other methods of"
^DIC(9.4,48,22,5.28,"PAH",207,1,7,0)="accessing the patient appointment information stored in the "
^DIC(9.4,48,22,5.28,"PAH",207,1,8,0)="Patient sub-file(#2.98) and the Hospital Location sub-file "
^DIC(9.4,48,22,5.28,"PAH",207,1,9,0)="(#44.001,#44.003).  During implementation of the new GOTS Scheduler, this "
