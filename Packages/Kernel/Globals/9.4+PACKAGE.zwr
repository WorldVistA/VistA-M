^DIC(9.4,175,22,2,"PAH",97,1,0)="^^13^13^3141212"
^DIC(9.4,175,22,2,"PAH",97,1,1,0)="VistA Imaging V3.0 Patch 149 - Print Issues"
^DIC(9.4,175,22,2,"PAH",97,1,2,0)=" "
^DIC(9.4,175,22,2,"PAH",97,1,3,0)="This Patch includes a new Clinical Display Client"
^DIC(9.4,175,22,2,"PAH",97,1,4,0)="Changes in the Clinical Display client will address the"
^DIC(9.4,175,22,2,"PAH",97,1,5,0)="issues of 'fuzzy' or 'granular' printed images."
^DIC(9.4,175,22,2,"PAH",97,1,6,0)="Routines in Patch 149:"
^DIC(9.4,175,22,2,"PAH",97,1,7,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",97,1,8,0)="Select BUILD NAME:    MAG*3.0*149     IMAGING"
^DIC(9.4,175,22,2,"PAH",97,1,9,0)="MAGGTU4D  value = 5109435"
^DIC(9.4,175,22,2,"PAH",97,1,10,0)="MAGIP149  value = 4215025"
^DIC(9.4,175,22,2,"PAH",97,1,11,0)="done"
^DIC(9.4,175,22,2,"PAH",97,1,12,0)="Please note that routine MAGIP149 is deleted after the KIDS Build is"
^DIC(9.4,175,22,2,"PAH",97,1,13,0)="installed."
^DIC(9.4,175,22,2,"PAH",98,0)="145^3141212.105319^17"
^DIC(9.4,175,22,2,"PAH",99,0)="155^3141216.133435^17"
^DIC(9.4,175,22,2,"PAH",99,1,0)="^^15^15^3141216"
^DIC(9.4,175,22,2,"PAH",99,1,1,0)="VistA Imaging V3.0 Patch 155 MAG INDEX TERMS UPDATE"
^DIC(9.4,175,22,2,"PAH",99,1,2,0)=" "
^DIC(9.4,175,22,2,"PAH",99,1,3,0)="This Patch includes 2 new index terms"
^DIC(9.4,175,22,2,"PAH",99,1,4,0)="New Procedure/Event:  CT Angiography"
^DIC(9.4,175,22,2,"PAH",99,1,5,0)="         Abbreviation:  CTA"
^DIC(9.4,175,22,2,"PAH",99,1,6,0)="         Specialty: Radiology"
^DIC(9.4,175,22,2,"PAH",99,1,7,0)=" "
^DIC(9.4,175,22,2,"PAH",99,1,8,0)="Existing Procedure/Event: Acupuncture"
^DIC(9.4,175,22,2,"PAH",99,1,9,0)="add to Specialty:  Chiropratic"
^DIC(9.4,175,22,2,"PAH",99,1,10,0)=" "
^DIC(9.4,175,22,2,"PAH",99,1,11,0)="Existing Procedure/Event: IV"
^DIC(9.4,175,22,2,"PAH",99,1,12,0)="add to Specialty: Radiology"
^DIC(9.4,175,22,2,"PAH",99,1,13,0)=" "
^DIC(9.4,175,22,2,"PAH",99,1,14,0)="New Specialty: Sleep Medicine"
^DIC(9.4,175,22,2,"PAH",99,1,15,0)="Associate with existing Procedure/Events: Visit and Sleep Study"
^DIC(9.4,175,22,2,"PAH",100,0)="142^3150331.142034^17"
^DIC(9.4,175,22,2,"PAH",100,1,0)="^^10^10^3150331"
^DIC(9.4,175,22,2,"PAH",100,1,1,0)="Version 3.0 Patch 142 - Site IEN / Station Number Issue/"
^DIC(9.4,175,22,2,"PAH",100,1,2,0)=" "
^DIC(9.4,175,22,2,"PAH",100,1,3,0)=" "
^DIC(9.4,175,22,2,"PAH",100,1,4,0)="Routines:"
^DIC(9.4,175,22,2,"PAH",100,1,5,0)="MAGDPRCA    new value = 98101426"
