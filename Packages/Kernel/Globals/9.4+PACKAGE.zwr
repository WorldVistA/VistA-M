^DIC(9.4,5,22,13,"PAH",36,0)="19 SEQ #44^3011016^1"
^DIC(9.4,5,22,13,"PAH",36,1,0)="^^90^90^3011016"
^DIC(9.4,5,22,13,"PAH",36,1,1,0)="Description:"
^DIC(9.4,5,22,13,"PAH",36,1,2,0)="==========="
^DIC(9.4,5,22,13,"PAH",36,1,3,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,4,0)="This patch will correct problems reported with the Response Time (RT)"
^DIC(9.4,5,22,13,"PAH",36,1,5,0)="options of the Kernel Toolkit. This patch includes all options and"
^DIC(9.4,5,22,13,"PAH",36,1,6,0)="routines (excluding routine XURTL4) for the RT options. In addition, an"
^DIC(9.4,5,22,13,"PAH",36,1,7,0)="updated data dictionary with no data for the RT RAWDATA (#3.094) file has"
^DIC(9.4,5,22,13,"PAH",36,1,8,0)="been included."
^DIC(9.4,5,22,13,"PAH",36,1,9,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,10,0)="NOTE:  The Response Time (RT) options are NOT part of the Resource Usage"
^DIC(9.4,5,22,13,"PAH",36,1,11,0)="       Monitor (RUM) package.  The Response Time (RT) options do NOT"
^DIC(9.4,5,22,13,"PAH",36,1,12,0)="       interface with the monitoring for the RUM package.  Use the RUM"
^DIC(9.4,5,22,13,"PAH",36,1,13,0)="       Manager Menu [KMPR RUM MANAGER MENU] to manage the RUM package."
^DIC(9.4,5,22,13,"PAH",36,1,14,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,15,0)="      "
^DIC(9.4,5,22,13,"PAH",36,1,16,0)="Routine Summary:"
^DIC(9.4,5,22,13,"PAH",36,1,17,0)="==============="
^DIC(9.4,5,22,13,"PAH",36,1,18,0)="      "
^DIC(9.4,5,22,13,"PAH",36,1,19,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,5,22,13,"PAH",36,1,20,0)="each of these routines now looks like:"
^DIC(9.4,5,22,13,"PAH",36,1,21,0)=" "
^DIC(9.4,5,22,13,"PAH",36,1,22,0)=" ;;7.3;TOOLKIT;<patchlist>;September 6, 2001"
