^DIC(9.4,93,22,21,"PAH",85,1,0)="^^9^9^3060525"
^DIC(9.4,93,22,21,"PAH",85,1,1,0)="This patch corrects two issues:"
^DIC(9.4,93,22,21,"PAH",85,1,2,0)=" "
^DIC(9.4,93,22,21,"PAH",85,1,3,0)="      1. The CAPRI GUI version of the ""BATCH 2507 REPRINT"" will produce a"
^DIC(9.4,93,22,21,"PAH",85,1,4,0)="         ""No data found for requested report criteria."" message, while the"
^DIC(9.4,93,22,21,"PAH",85,1,5,0)="         AMIE version produces the correct results."
^DIC(9.4,93,22,21,"PAH",85,1,6,0)=" "
^DIC(9.4,93,22,21,"PAH",85,1,7,0)="      2. The CAPRI GUI version of the ""Discharge Report"" will produce a"
^DIC(9.4,93,22,21,"PAH",85,1,8,0)="         ""No data found for requested report criteria."" message, while the"
^DIC(9.4,93,22,21,"PAH",85,1,9,0)="         AMIE version produces the correct results."
