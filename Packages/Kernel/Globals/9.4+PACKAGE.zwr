^DIC(9.4,14,22,5.9,"PAH",207,1,307,0)="Option Name                    Option Text"
^DIC(9.4,14,22,5.9,"PAH",207,1,308,0)="===========                    ==========="
^DIC(9.4,14,22,5.9,"PAH",207,1,309,0)="VBEC ANTIBODY/ANTIGEN UTIL.    Utilities that manipulate Antibody/Antigen "
^DIC(9.4,14,22,5.9,"PAH",207,1,310,0)="data"
^DIC(9.4,14,22,5.9,"PAH",207,1,311,0)="VBEC BB COMPONENTS DISABLE     Disable VistA Blood Bank components"
^DIC(9.4,14,22,5.9,"PAH",207,1,312,0)="VBEC BB COMPONENTS ENABLE      Enable VistA Blood Bank components"
^DIC(9.4,14,22,5.9,"PAH",207,1,313,0)="VBEC CONVERSION UTILITIES      Utilities used for the data conversion"
^DIC(9.4,14,22,5.9,"PAH",207,1,314,0)="VBEC DATA CONV. TO HOST FILES  Convert VistA Blood Bank data to host files"
^DIC(9.4,14,22,5.9,"PAH",207,1,315,0)="VBEC DATA CONVERSION STATS     Display data conversion statistics"
^DIC(9.4,14,22,5.9,"PAH",207,1,316,0)="VBEC DATA VALIDATION           Run Legacy VistA Blood Bank Data Validation"
^DIC(9.4,14,22,5.9,"PAH",207,1,317,0)="VBEC DELETE ANTIBODY/ANTIGEN   Delete Antibody/Antigen temporary matching "
^DIC(9.4,14,22,5.9,"PAH",207,1,318,0)="files "
^DIC(9.4,14,22,5.9,"PAH",207,1,319,0)="VBEC DELETE CONV. STATS        Delete data conversion and anomaly check "
^DIC(9.4,14,22,5.9,"PAH",207,1,320,0)="histories"
^DIC(9.4,14,22,5.9,"PAH",207,1,321,0)="VBEC DELETE EXTRACTED DATA     Delete all Blood Bank Data in Temporary "
^DIC(9.4,14,22,5.9,"PAH",207,1,322,0)="Globals"
^DIC(9.4,14,22,5.9,"PAH",207,1,323,0)="VBEC DELETE SYSTEM LEVEL FILES Delete Blood Bank Data in System Level "
^DIC(9.4,14,22,5.9,"PAH",207,1,324,0)="Files"
^DIC(9.4,14,22,5.9,"PAH",207,1,325,0)="VBEC DELETE TRANS. REACTION    Delete Transfusion Reaction temporary "
^DIC(9.4,14,22,5.9,"PAH",207,1,326,0)="match files"
^DIC(9.4,14,22,5.9,"PAH",207,1,327,0)="VBEC INVALID DATA REPORT       Invalid Blood Bank Data Report"
^DIC(9.4,14,22,5.9,"PAH",207,1,328,0)="VBEC MAIN MENU                 VBECS Data Matching/Conversion Menu"
^DIC(9.4,14,22,5.9,"PAH",207,1,329,0)="VBEC MATCH ANTIBODY/ANTIGEN    Match VistA antibody/antigen data"
^DIC(9.4,14,22,5.9,"PAH",207,1,330,0)="VBEC MATCH TRANSFUS REACTION   Match VistA transfusion reaction data"
^DIC(9.4,14,22,5.9,"PAH",207,1,331,0)="VBEC POST-CONVERSION UTILITIES Utilities used after the data conversion "
