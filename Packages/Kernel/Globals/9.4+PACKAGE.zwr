^DIC(9.4,100,22,15,"PAH",58,1,367,0)="List of preceding patches: 31, 37, 62, 66"
^DIC(9.4,100,22,15,"PAH",58,1,368,0)="Sites should use CHECK1^XTSUMBLD to verify checksums."
^DIC(9.4,100,22,15,"PAH",58,1,369,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,370,0)="   SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",58,1,371,0)="   ==================="
^DIC(9.4,100,22,15,"PAH",58,1,372,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,373,0)="   The following software and documentation files are exported as part"
^DIC(9.4,100,22,15,"PAH",58,1,374,0)="   of this patch:"
^DIC(9.4,100,22,15,"PAH",58,1,375,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,376,0)="    File Name                     Contents             Retrieval Format"
^DIC(9.4,100,22,15,"PAH",58,1,377,0)="    ---------                     --------             ----------------"
^DIC(9.4,100,22,15,"PAH",58,1,378,0)="    YS_501_85.KID                 MHA Server Components         ASCII"
^DIC(9.4,100,22,15,"PAH",58,1,379,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,380,0)="    YS50185_SETUP_1_0_3_1.exe     Mental Health Assistant       BINARY"
^DIC(9.4,100,22,15,"PAH",58,1,381,0)="                                  This file is the complete "
^DIC(9.4,100,22,15,"PAH",58,1,382,0)="                                  install for the Mental Health"
^DIC(9.4,100,22,15,"PAH",58,1,383,0)="                                  Assistant GUI Version 1.0.3.1, client."
^DIC(9.4,100,22,15,"PAH",58,1,384,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,385,0)="    - YS_MHA.exe                  MHA 3 Executable"
^DIC(9.4,100,22,15,"PAH",58,1,386,0)="    - YS_MHA_SD_INSTALLGINA.exe   Activate Secure Desktop Executable"
^DIC(9.4,100,22,15,"PAH",58,1,387,0)="      -  dwlGina2.dll             DLL used by Secure Desktop"
^DIC(9.4,100,22,15,"PAH",58,1,388,0)="    - YS_MHA_SD_UNINSTALLGINA.exe Deactivate Secure Desktop Executable"
^DIC(9.4,100,22,15,"PAH",58,1,389,0)="    - YS_MHA_VASD.exe             Secure Desktop's main executable"
^DIC(9.4,100,22,15,"PAH",58,1,390,0)="    - YS_MHA.HLP                  Online help file for the ASI"
^DIC(9.4,100,22,15,"PAH",58,1,391,0)="    - ANSWER file folder          Offline records that have not been uploaded"
^DIC(9.4,100,22,15,"PAH",58,1,392,0)="    - INSTRUMENT file folder      MH Instruments for Offline administration"
^DIC(9.4,100,22,15,"PAH",58,1,393,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,394,0)="    YS50185_MHA 3_IG.PDF          YS_MHA 3 Installation Guide  BINARY"
^DIC(9.4,100,22,15,"PAH",58,1,395,0)="    YS50185_MHA 3_IG.DOC          YS_MHA 3 Installation Guide  BINARY"
^DIC(9.4,100,22,15,"PAH",58,1,396,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,397,0)="    YS50185_MHA 3_UM.PDF          YS_MHA 3 User Manual         BINARY"
^DIC(9.4,100,22,15,"PAH",58,1,398,0)="    YS50185_MHA 3_UM.DOC          YS_MHA 3 User Manual         BINARY"
^DIC(9.4,100,22,15,"PAH",58,1,399,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,400,0)="   The software files are available on the following OI Field Offices'"
^DIC(9.4,100,22,15,"PAH",58,1,401,0)="   ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",58,1,402,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,403,0)="   All sites are encouraged to use their FTP capability to obtain these"
^DIC(9.4,100,22,15,"PAH",58,1,404,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",58,1,405,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",58,1,406,0)="   are located."
^DIC(9.4,100,22,15,"PAH",58,1,407,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,408,0)="    OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,100,22,15,"PAH",58,1,409,0)="    ===============    ===========                ========="
^DIC(9.4,100,22,15,"PAH",58,1,410,0)="    ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",58,1,411,0)="    HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",58,1,412,0)="    SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",58,1,413,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,414,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,415,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",58,1,416,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",58,1,417,0)="   1. Use the 'LOAD A DISTRIBUTION' option on the PackMan menu. The"
^DIC(9.4,100,22,15,"PAH",58,1,418,0)="      Host File name is YS_501_85.KID.  Answer YES to the question:"
^DIC(9.4,100,22,15,"PAH",58,1,419,0)="      ""Want to Continue with Load? YES//"""
^DIC(9.4,100,22,15,"PAH",58,1,420,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,421,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,422,0)="   2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",58,1,423,0)="      system. You now need to install the Transport global. "
^DIC(9.4,100,22,15,"PAH",58,1,424,0)="      On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,100,22,15,"PAH",58,1,425,0)="      following options:"
^DIC(9.4,100,22,15,"PAH",58,1,426,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,427,0)="         Print Transport Global"
^DIC(9.4,100,22,15,"PAH",58,1,428,0)="         Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",58,1,429,0)="         Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",58,1,430,0)="         Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",58,1,431,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,432,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,433,0)="   3. Users may remain on the system, but installation should be done "
^DIC(9.4,100,22,15,"PAH",58,1,434,0)="      at off peak hours.  During testing, it was noted that if a user had "
^DIC(9.4,100,22,15,"PAH",58,1,435,0)="      a reminder dialog open when the install took place, the reminder"
^DIC(9.4,100,22,15,"PAH",58,1,436,0)="      dialog would not load and work properly until CPRS was rebooted."
^DIC(9.4,100,22,15,"PAH",58,1,437,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,438,0)="   4. Installation will take less than five minutes. "
^DIC(9.4,100,22,15,"PAH",58,1,439,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,440,0)="   5. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",58,1,441,0)="      'Install Package(s)' Select the package 'YS*5.01*85'"
^DIC(9.4,100,22,15,"PAH",58,1,442,0)="      and proceed with install."
^DIC(9.4,100,22,15,"PAH",58,1,443,0)="  "
^DIC(9.4,100,22,15,"PAH",58,1,444,0)="   6. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",58,1,445,0)="      install//', respond NO."
^DIC(9.4,100,22,15,"PAH",58,1,446,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,100,22,15,"PAH",58,1,447,0)="      and Protocols? YES//', respond NO"
^DIC(9.4,100,22,15,"PAH",58,1,448,0)="  "
^DIC(9.4,100,22,15,"PAH",58,1,449,0)="   7. Place the MENTAL HEALTH ASSISTANT VERSION 3 USER MANUAL in a"
^DIC(9.4,100,22,15,"PAH",58,1,450,0)="      location that can be accessed by MHA users."
^DIC(9.4,100,22,15,"PAH",58,1,451,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,452,0)="   8. Please refer to the POST INSTALLATION INSTRUCTIONS section of the "
^DIC(9.4,100,22,15,"PAH",58,1,453,0)="      MENTAL HEALTH ASSISTANT VERSION 3 INSTALLATION GUIDE to install"
^DIC(9.4,100,22,15,"PAH",58,1,454,0)="      the MHA software."
^DIC(9.4,100,22,15,"PAH",58,1,455,0)="   9. The Secure Desktop feature in the MHA software is a security "
^DIC(9.4,100,22,15,"PAH",58,1,456,0)="      feature that locks down computers when patients are completing "
^DIC(9.4,100,22,15,"PAH",58,1,457,0)="      assessments directly in MHA.  Because it locks down all other "
^DIC(9.4,100,22,15,"PAH",58,1,458,0)="      applications on the computer when activated, it must be loaded"
^DIC(9.4,100,22,15,"PAH",58,1,459,0)="      directly on the PC where it will be used.  It should only be loaded"
^DIC(9.4,100,22,15,"PAH",58,1,460,0)="      on machines that will be used for patient administered"
^DIC(9.4,100,22,15,"PAH",58,1,461,0)="      assessments.  It should not be pushed out to all machines on the"
^DIC(9.4,100,22,15,"PAH",58,1,462,0)="      network.  More detailed information is found in the MHA VERSION 3"
^DIC(9.4,100,22,15,"PAH",58,1,463,0)="      INSTALLATION GUIDE."
^DIC(9.4,100,22,15,"PAH",58,1,464,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,465,0)="   10. Place the option YS BROKER1 [YS BROKER1] on the Mental Health "
^DIC(9.4,100,22,15,"PAH",58,1,466,0)="      users secondary menu."
^DIC(9.4,100,22,15,"PAH",58,1,467,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,468,0)="   11. Enter appropriate members into the Mail Group YS MHA-MHNDB to"
^DIC(9.4,100,22,15,"PAH",58,1,469,0)="      the system, but installation should be done at off peak hours."
^DIC(9.4,100,22,15,"PAH",58,1,470,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,471,0)="   12. Place the MHA application on the CPRS Tools menu."
^DIC(9.4,100,22,15,"PAH",58,1,472,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,473,0)="   13. Create progress note title of ""Mental Health Diagnostic Study "
^DIC(9.4,100,22,15,"PAH",58,1,474,0)="       Note"" in the progress note hierarchy.  This is needed for MHA to "
^DIC(9.4,100,22,15,"PAH",58,1,475,0)="       automatically pass a note to CPRS from instrument administrations "
^DIC(9.4,100,22,15,"PAH",58,1,476,0)="       completed within MHA."
^DIC(9.4,100,22,15,"PAH",58,1,477,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,478,0)="   14. A new entry is created in File 771, the HL7 Application Parameter"
^DIC(9.4,100,22,15,"PAH",58,1,479,0)="       File: YS MHA.  It is exported as Inactive and should be set to"
^DIC(9.4,100,22,15,"PAH",58,1,480,0)="       Active after install."
^DIC(9.4,100,22,15,"PAH",58,1,481,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,482,0)="   15. A new entry is also created in File 870, the HL Logical Link file."
^DIC(9.4,100,22,15,"PAH",58,1,483,0)="       This entry is YS MHAT. The logical link named YS MHAT is used by"
^DIC(9.4,100,22,15,"PAH",58,1,484,0)="       the HL7 package to send VistA ADT HL7 messages containing patient"
^DIC(9.4,100,22,15,"PAH",58,1,485,0)="       demographics, patient administration and patient answers."
^DIC(9.4,100,22,15,"PAH",58,1,486,0)="       secondary menu.                 "
^DIC(9.4,100,22,15,"PAH",59,0)="93 SEQ #78^3080526.190452^1"
^DIC(9.4,100,22,15,"PAH",59,1,0)="^^4^4^3080526"
^DIC(9.4,100,22,15,"PAH",59,1,1,0)="This patch is intended to stop HL7 message generation.  With the release "
^DIC(9.4,100,22,15,"PAH",59,1,2,0)="of YS*5.01*85, HL7 errors are occurring because it was the intent of the "
^DIC(9.4,100,22,15,"PAH",59,1,3,0)="development team to release that patch with messaging turned off.  "
^DIC(9.4,100,22,15,"PAH",59,1,4,0)="Unfortunately, this was not the case."
^DIC(9.4,100,22,15,"PAH",60,0)="92 SEQ #79^3090420.155154^1"
^DIC(9.4,100,22,15,"PAH",60,1,0)="^^82^82^3090420"
^DIC(9.4,100,22,15,"PAH",60,1,1,0)="A problem was found with one of the Clozapine API's during the testing of "
^DIC(9.4,100,22,15,"PAH",60,1,2,0)="Computerized Patient Record System (CPRS V27) patch OR*3*243.  The"
^DIC(9.4,100,22,15,"PAH",60,1,3,0)="routines in this patch have been modified to correctly handle the"
^DIC(9.4,100,22,15,"PAH",60,1,4,0)="situation."
^DIC(9.4,100,22,15,"PAH",60,1,5,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,6,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,7,0)="ASSOCIATED REMEDY TICKET:"
^DIC(9.4,100,22,15,"PAH",60,1,8,0)="========================="
^DIC(9.4,100,22,15,"PAH",60,1,9,0)="HD195784 - Clozapine--Incorrect Value for OC calculation for ANC from"
^DIC(9.4,100,22,15,"PAH",60,1,10,0)="           % Neutrophil"
^DIC(9.4,100,22,15,"PAH",60,1,11,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,13,0)="ASSOCIATED TEST SITES:"
^DIC(9.4,100,22,15,"PAH",60,1,14,0)="======================"
^DIC(9.4,100,22,15,"PAH",60,1,15,0)="Alexandria, VA"
^DIC(9.4,100,22,15,"PAH",60,1,16,0)="Charleston, WV"
^DIC(9.4,100,22,15,"PAH",60,1,17,0)="Cleveland, OH"
^DIC(9.4,100,22,15,"PAH",60,1,18,0)="Hudson Valley HCS"
^DIC(9.4,100,22,15,"PAH",60,1,19,0)="Loma Linda, CA"
^DIC(9.4,100,22,15,"PAH",60,1,20,0)="Palo Alto HCS"
^DIC(9.4,100,22,15,"PAH",60,1,21,0)="Philadelphia, PA"
^DIC(9.4,100,22,15,"PAH",60,1,22,0)="San Diego, CA"
^DIC(9.4,100,22,15,"PAH",60,1,23,0)="Puget Sound HCS"
^DIC(9.4,100,22,15,"PAH",60,1,24,0)="Tampa, FL"
^DIC(9.4,100,22,15,"PAH",60,1,25,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,26,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,27,0)="REMEDY TICKET OVERIVEW:"
^DIC(9.4,100,22,15,"PAH",60,1,28,0)="======================="
^DIC(9.4,100,22,15,"PAH",60,1,29,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,30,0)="  Problem:"
^DIC(9.4,100,22,15,"PAH",60,1,31,0)="  --------"
^DIC(9.4,100,22,15,"PAH",60,1,32,0)="  A problem was found with one of the Clozapine API's during the testing "
^DIC(9.4,100,22,15,"PAH",60,1,33,0)="  of Computerized Patient Record System (CPRS V27) patch OR*3*243."
^DIC(9.4,100,22,15,"PAH",60,1,34,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,35,0)="  Solution:"
^DIC(9.4,100,22,15,"PAH",60,1,36,0)="  --------- "
^DIC(9.4,100,22,15,"PAH",60,1,37,0)="  Modified routines to correctly handle the situation."
^DIC(9.4,100,22,15,"PAH",60,1,38,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,39,0)="  Routines:"
^DIC(9.4,100,22,15,"PAH",60,1,40,0)="  ---------"
^DIC(9.4,100,22,15,"PAH",60,1,41,0)="  YSCLSERV, YSCLSRV2,YSCLSRV3, YSCLTST2, YSCLTST4 (new)"
^DIC(9.4,100,22,15,"PAH",60,1,42,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,43,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,44,0)="INSTALLATION INSTRUCTIONS:"
^DIC(9.4,100,22,15,"PAH",60,1,45,0)="=========================="
^DIC(9.4,100,22,15,"PAH",60,1,46,0)="The install time for this patch is less than 2 minutes. This patch can be"
^DIC(9.4,100,22,15,"PAH",60,1,47,0)="installed with users on the system.  Installation may be done at any time"
^DIC(9.4,100,22,15,"PAH",60,1,48,0)="except during the time scheduled for the Clozapine roll-up."
^DIC(9.4,100,22,15,"PAH",60,1,49,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,50,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,51,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,100,22,15,"PAH",60,1,52,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,100,22,15,"PAH",60,1,53,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,54,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",60,1,55,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,100,22,15,"PAH",60,1,56,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,57,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,100,22,15,"PAH",60,1,58,0)="      select the 'Installation' menu."
^DIC(9.4,100,22,15,"PAH",60,1,59,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,60,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,100,22,15,"PAH",60,1,61,0)="      all routines have the correct checksums."
^DIC(9.4,100,22,15,"PAH",60,1,62,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,63,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,100,22,15,"PAH",60,1,64,0)="      options:"
^DIC(9.4,100,22,15,"PAH",60,1,65,0)="        Print Transport Global"
^DIC(9.4,100,22,15,"PAH",60,1,66,0)="        Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",60,1,67,0)="        Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",60,1,68,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,69,0)="      If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,100,22,15,"PAH",60,1,70,0)="      patch prior to installation, you should use the 'Backup a Transport"
^DIC(9.4,100,22,15,"PAH",60,1,71,0)="      Global' option at this time.  You may also compare the routines in"
^DIC(9.4,100,22,15,"PAH",60,1,72,0)="      your production account to the routines in the patch by using the"
^DIC(9.4,100,22,15,"PAH",60,1,73,0)="      'Compare a Transport Global to Current System' option."
^DIC(9.4,100,22,15,"PAH",60,1,74,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,75,0)="  6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,100,22,15,"PAH",60,1,76,0)="      and select the package 'YS*5.01*92'."
^DIC(9.4,100,22,15,"PAH",60,1,77,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,78,0)="      If prompted 'Want KIDS to INHIBIT LOGONs during the install? NO//,"
^DIC(9.4,100,22,15,"PAH",60,1,79,0)="      choose 'NO'."
^DIC(9.4,100,22,15,"PAH",60,1,80,0)=" "
^DIC(9.4,100,22,15,"PAH",60,1,81,0)="      If prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,100,22,15,"PAH",60,1,82,0)="      Protocols? NO//', choose 'NO'."
^DIC(9.4,100,22,15,"PAH",61,0)="102 SEQ #80^3090630.112016^17"
^DIC(9.4,100,22,15,"PAH",61,1,0)="^^4^4^3090630"
^DIC(9.4,100,22,15,"PAH",61,1,1,0)=" When multiple instruments are administered for the same encounter through"
^DIC(9.4,100,22,15,"PAH",61,1,2,0)=" CPRS GUI Clinical Reminders, only the results of the last instrument "
^DIC(9.4,100,22,15,"PAH",61,1,3,0)=" display in the Mental Health Assistant 3 GUI.  This patch will correct "
^DIC(9.4,100,22,15,"PAH",61,1,4,0)=" this defect."
^DIC(9.4,100,22,15,"PAH",62,0)="100 SEQ #81^3090723.151208^17"
^DIC(9.4,100,22,15,"PAH",62,1,0)="^^6^6^3090723"
^DIC(9.4,100,22,15,"PAH",62,1,1,0)="This patch removes some cross-references to field .53 (Progress"
^DIC(9.4,100,22,15,"PAH",62,1,2,0)="Note Pointer) of file # 604 (Addiction Severity Index) that remained"
^DIC(9.4,100,22,15,"PAH",62,1,3,0)="after the elimination of field .53 due to file restructuring.  A post-init"
^DIC(9.4,100,22,15,"PAH",62,1,4,0)="routine (YS501P99) is used to remove these cross-references. This patch"
^DIC(9.4,100,22,15,"PAH",62,1,5,0)="also replaces the term MHA3 in some prompts with the phrase "
^DIC(9.4,100,22,15,"PAH",62,1,6,0)="""MH administration/test""."
^DIC(9.4,100,22,15,"PAH",63,0)="98^3090828.101511^17"
^DIC(9.4,100,22,15,"PAH",63,1,0)="^^132^132^3090828"
^DIC(9.4,100,22,15,"PAH",63,1,1,0)="This patch corrects a defect in the Mental Health Assistant, Dynamic-Link"
^DIC(9.4,100,22,15,"PAH",63,1,2,0)="Library, (MHA DLL). The MHA DLL is called from Computerized Patient Records"
^DIC(9.4,100,22,15,"PAH",63,1,3,0)="System (CPRS) version 27N when a Clinical Reminder note is filled in by the"
^DIC(9.4,100,22,15,"PAH",63,1,4,0)="user."
^DIC(9.4,100,22,15,"PAH",63,1,5,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,6,0)="The essential problem concerned the use a temporary file on the user's hard"
^DIC(9.4,100,22,15,"PAH",63,1,7,0)="drive to store user's responses before saving to Veterans Health Information"
^DIC(9.4,100,22,15,"PAH",63,1,8,0)="Systems and Technology Architecture (VistA). This patch provides the means"
^DIC(9.4,100,22,15,"PAH",63,1,9,0)="for that temporary information to be stored in VistA instead. The user is"
^DIC(9.4,100,22,15,"PAH",63,1,10,0)="not aware of this new storage arrangement while using CPRS and the MHA DLL."
^DIC(9.4,100,22,15,"PAH",63,1,11,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,12,0)="There are no changes to existing files and no changes from the user's "
^DIC(9.4,100,22,15,"PAH",63,1,13,0)="perspective."
^DIC(9.4,100,22,15,"PAH",63,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,15,0)="This patch contains three new Remote Procedure Calls (RPCs):"
^DIC(9.4,100,22,15,"PAH",63,1,16,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,17,0)="   1) YTQ GET SCRATCH: Returns data from the scratch file for the MHA DLL."
^DIC(9.4,100,22,15,"PAH",63,1,18,0)="      Input: DFN, test CODE and GIU HANDLE."
^DIC(9.4,100,22,15,"PAH",63,1,19,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,20,0)="   2) YTQ KILL SCRATCH: Delete entries from the scratch file when a clinical"
^DIC(9.4,100,22,15,"PAH",63,1,21,0)="      reminder is saved. Input: DFN, test CODE and GIU HANDLE."
^DIC(9.4,100,22,15,"PAH",63,1,22,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,23,0)="   3) YTQ SET SCRATCH: API is designed to set data to a scratch file for the"
^DIC(9.4,100,22,15,"PAH",63,1,24,0)="      MHA DLL. Input: DFN, test CODE and GIU HANDLE."
^DIC(9.4,100,22,15,"PAH",63,1,25,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,26,0)="This patch introduces a new file called, MH CR SCRATCH FILE (#601.94). This"
^DIC(9.4,100,22,15,"PAH",63,1,27,0)="file is used as temporary storage space for the interface between the MHA "
^DIC(9.4,100,22,15,"PAH",63,1,28,0)="DLL and Clinical Reminders."
^DIC(9.4,100,22,15,"PAH",63,1,29,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,30,0)="A new routine, YTQPXRM8, is also included."
^DIC(9.4,100,22,15,"PAH",63,1,31,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,32,0)="Associated Remedy Tickets:"
^DIC(9.4,100,22,15,"PAH",63,1,33,0)="============================="
^DIC(9.4,100,22,15,"PAH",63,1,34,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,35,0)="HD0000000233026, HD0000000240965, HD0000000232542, HD0000000247135,"
^DIC(9.4,100,22,15,"PAH",63,1,36,0)="HD0000000240965, HD0000000232427, and HD0000000233367."
^DIC(9.4,100,22,15,"PAH",63,1,37,0)="Clinical reminders: Completed mental health instruments are incorrectly"
^DIC(9.4,100,22,15,"PAH",63,1,38,0)="identified as having missing answers."
^DIC(9.4,100,22,15,"PAH",63,1,39,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,40,0)="Associated E3R:"
^DIC(9.4,100,22,15,"PAH",63,1,41,0)="==============="
^DIC(9.4,100,22,15,"PAH",63,1,42,0)="N/A"
^DIC(9.4,100,22,15,"PAH",63,1,43,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,44,0)="Test Site List:"
^DIC(9.4,100,22,15,"PAH",63,1,45,0)="==============="
^DIC(9.4,100,22,15,"PAH",63,1,46,0)="Loma Linda, CA - Large"
^DIC(9.4,100,22,15,"PAH",63,1,47,0)="Palo Alto, CA - Integrated, Large"
^DIC(9.4,100,22,15,"PAH",63,1,48,0)="Philadelphia, PA - Large"
^DIC(9.4,100,22,15,"PAH",63,1,49,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,50,0)="This is a sub set of sites used by CPRS GUI v27.n (OR*3*296) and were"
^DIC(9.4,100,22,15,"PAH",63,1,51,0)="determined by that team. (The CPRS test sites do not include any medium or"
^DIC(9.4,100,22,15,"PAH",63,1,52,0)="small sites.)"
^DIC(9.4,100,22,15,"PAH",63,1,53,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,54,0)="Routine Summary:"
^DIC(9.4,100,22,15,"PAH",63,1,55,0)="================"
^DIC(9.4,100,22,15,"PAH",63,1,56,0)="Checksums shown are NEW Checksums"
^DIC(9.4,100,22,15,"PAH",63,1,57,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,58,0)="The following routine is included in this patch.  The second line "
^DIC(9.4,100,22,15,"PAH",63,1,59,0)="of this routine now looks like:"
^DIC(9.4,100,22,15,"PAH",63,1,60,0)=" ;;5.01;MENTAL HEALTH;**[Patch List]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",63,1,61,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,62,0)="                 Checksums"
^DIC(9.4,100,22,15,"PAH",63,1,63,0)="Routine         Old         New        Patch List"
^DIC(9.4,100,22,15,"PAH",63,1,64,0)="YTQPXRM8        n/a      15837966    **98**"
^DIC(9.4,100,22,15,"PAH",63,1,65,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,66,0)="Sites should use CHECK1^XTSUMBLD to verify checksums. "
^DIC(9.4,100,22,15,"PAH",63,1,67,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,68,0)="SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",63,1,69,0)="==================="
^DIC(9.4,100,22,15,"PAH",63,1,70,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,71,0)="The following software and documentation files are exported as "
^DIC(9.4,100,22,15,"PAH",63,1,72,0)="part of this patch:"
^DIC(9.4,100,22,15,"PAH",63,1,73,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,74,0)="File Name            Contents                            Retrieval Format"
^DIC(9.4,100,22,15,"PAH",63,1,75,0)="---------            --------                            ----------------"
^DIC(9.4,100,22,15,"PAH",63,1,76,0)="YS_501_98.KID        MHA Clinical Reminders APIs         ASCII"
^DIC(9.4,100,22,15,"PAH",63,1,77,0)="YS_501_98_SETUP.EXE  Installs DLL                        Binary"
^DIC(9.4,100,22,15,"PAH",63,1,78,0)="YS_MHA_A.dll         DLL support for Clinical Reminders  Binary"
^DIC(9.4,100,22,15,"PAH",63,1,79,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,80,0)="The software files are available on the following OI Field Offices'"
^DIC(9.4,100,22,15,"PAH",63,1,81,0)="ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",63,1,82,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,83,0)="All sites are encouraged to use their FTP capability to obtain these"
^DIC(9.4,100,22,15,"PAH",63,1,84,0)="files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",63,1,85,0)="quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",63,1,86,0)="are located."
^DIC(9.4,100,22,15,"PAH",63,1,87,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,88,0)="    OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,100,22,15,"PAH",63,1,89,0)="    ===============    ===========                ========="
^DIC(9.4,100,22,15,"PAH",63,1,90,0)="    ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",63,1,91,0)="    HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",63,1,92,0)="    SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",63,1,93,0)=" "
^DIC(9.4,100,22,15,"PAH",63,1,94,0)="Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",63,1,95,0)="=========================="
^DIC(9.4,100,22,15,"PAH",63,1,96,0)="1. Use the 'LOAD A DISTRIBUTION' option on the PackMan menu. The"
^DIC(9.4,100,22,15,"PAH",63,1,97,0)="   Host File name is YS_501_98.KID.  Answer YES to the question:"
^DIC(9.4,100,22,15,"PAH",63,1,98,0)="   ""Want to Continue with Load? YES//"""
^DIC(9.4,100,22,15,"PAH",63,1,99,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,100,0)="2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",63,1,101,0)="   system. You now need to install the Transport global."
^DIC(9.4,100,22,15,"PAH",63,1,102,0)="   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,100,22,15,"PAH",63,1,103,0)="   following options:"
^DIC(9.4,100,22,15,"PAH",63,1,104,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,105,0)="    Print Transport Global"
^DIC(9.4,100,22,15,"PAH",63,1,106,0)="    Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",63,1,107,0)="    Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",63,1,108,0)="    Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",63,1,109,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,110,0)="3. Users may remain on the system, but installation should be done"
^DIC(9.4,100,22,15,"PAH",63,1,111,0)="   at off peak hours."
^DIC(9.4,100,22,15,"PAH",63,1,112,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,113,0)="4. Installation will take less than five minutes."
^DIC(9.4,100,22,15,"PAH",63,1,114,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,115,0)="5. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",63,1,116,0)="   'Install Package(s)' Select the package 'YS*5.01*98'"
^DIC(9.4,100,22,15,"PAH",63,1,117,0)="   and proceed with install."
^DIC(9.4,100,22,15,"PAH",63,1,118,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,119,0)="6. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",63,1,120,0)="   install//', respond NO."
^DIC(9.4,100,22,15,"PAH",63,1,121,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,122,0)="7. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,100,22,15,"PAH",63,1,123,0)="   and Protocols? YES//', respond NO"
^DIC(9.4,100,22,15,"PAH",63,1,124,0)="  "
^DIC(9.4,100,22,15,"PAH",63,1,125,0)="8. Download YS_501_98_Setup.exe in binary mode and run the YS_501_98_Setup."
^DIC(9.4,100,22,15,"PAH",63,1,126,0)="   exe file to install Clinical Reminders MHA DLL. Please install the DLL"
^DIC(9.4,100,22,15,"PAH",63,1,127,0)="   in the default folders. The install program requires two dialogs of the"
^DIC(9.4,100,22,15,"PAH",63,1,128,0)="   user (to start and to signify finished). To avoid the user/install"
^DIC(9.4,100,22,15,"PAH",63,1,129,0)="   interaction, the file YS_MHA_A.dll can be copied directly to the"
^DIC(9.4,100,22,15,"PAH",63,1,130,0)="   C:\Programs Files\Vista\Common Files directory. This may be the more"
^DIC(9.4,100,22,15,"PAH",63,1,131,0)="   desirable way to push the dll to many workstations."
^DIC(9.4,100,22,15,"PAH",63,1,132,0)="  "
^DIC(9.4,100,22,15,"PAH",64,0)="97^3100708.160933^17"
^DIC(9.4,100,22,15,"PAH",64,1,0)="^^2^2^3100708"
^DIC(9.4,100,22,15,"PAH",64,1,1,0)="Please refer to YS*5.01*97 in the National Patch Module for a description "
^DIC(9.4,100,22,15,"PAH",64,1,2,0)="of this patch."
^DIC(9.4,100,22,15,"PAH",65,0)="96^3110311.101021^17"
^DIC(9.4,100,22,15,"PAH",65,1,0)="^^2^2^3110311"
^DIC(9.4,100,22,15,"PAH",65,1,1,0)="Please refer to YS*5.01*96 in the National Patch Module for a description "
^DIC(9.4,100,22,15,"PAH",65,1,2,0)="of this patch."
^DIC(9.4,100,22,15,"PAH",66,0)="103^3120419.102205^17"
^DIC(9.4,100,22,15,"PAH",66,1,0)="^^2^2^3120419"
^DIC(9.4,100,22,15,"PAH",66,1,1,0)="Please refer to YS*5.01*103 in the National Patch Module for a description"
^DIC(9.4,100,22,15,"PAH",66,1,2,0)="of this patch."
^DIC(9.4,100,22,15,"PAH",67,0)="106 SEQ #87^3120829.111307^17"
^DIC(9.4,100,22,15,"PAH",67,1,0)="^^2^2^3120829"
^DIC(9.4,100,22,15,"PAH",67,1,1,0)="Please refer to YS*5.01*106 in the National Patch Module for a description"
^DIC(9.4,100,22,15,"PAH",67,1,2,0)="of this patch."
^DIC(9.4,100,22,15,"PAH",68,0)="60^3121015.152053^17"
^DIC(9.4,100,22,15,"PAH",68,1,0)="^^8^8^3121015"
^DIC(9.4,100,22,15,"PAH",68,1,1,0)="Patch YS*5.01*60 addresses the retirement of Mental Health Options, Files,"
^DIC(9.4,100,22,15,"PAH",68,1,2,0)="Data Dictionaries, patient data associated with these files, and"
^DIC(9.4,100,22,15,"PAH",68,1,3,0)="associated templates determined by the Mental Health Strategic Healthcare"
^DIC(9.4,100,22,15,"PAH",68,1,4,0)="Group to be obsolete and are no longer supported by Health Systems Design"
^DIC(9.4,100,22,15,"PAH",68,1,5,0)="and Development.  All the software, files, options, and templates were"
^DIC(9.4,100,22,15,"PAH",68,1,6,0)="designated as obsolete in 2004 or earlier."
^DIC(9.4,100,22,15,"PAH",68,1,7,0)=" "
^DIC(9.4,100,22,15,"PAH",68,1,8,0)="A complete description of this patch can be found on Forum."
^DIC(9.4,100,22,15,"PAH",69,0)="105^3131003.152516^17"
^DIC(9.4,100,22,15,"PAH",69,1,0)="^^2^2^3131003"
^DIC(9.4,100,22,15,"PAH",69,1,1,0)="Please refer to YS*5.01*105 in the National Patch Module for a description"
^DIC(9.4,100,22,15,"PAH",69,1,2,0)="of this patch."
^DIC(9.4,100,22,15,"PAH",70,0)="107 SEQ #92^3140902.125355^17"
^DIC(9.4,100,22,15,"PAH",71,0)="113 SEQ #94^3150527.155439^17"
^DIC(9.4,100,22,15,"PAH",71,1,0)="^^3^3^3150527"
^DIC(9.4,100,22,15,"PAH",71,1,1,0)="This patch will address the following issues:"
^DIC(9.4,100,22,15,"PAH",71,1,2,0)="1. Two of the Barthel Index MH SCORING KEYS have incorrect score values."
^DIC(9.4,100,22,15,"PAH",71,1,3,0)="2. Scoring issues with AAQ-2"
^DIC(9.4,100,22,15,"PAH",72,0)="116^3160310.155209^54"
^DIC(9.4,100,22,15,"PAH",73,0)="119^3161028.150447^54"
^DIC(9.4,100,22,15,"PAH",73,1,0)="^^155^155^3161028"
^DIC(9.4,100,22,15,"PAH",73,1,1,0)="This patch will modify some of the prompts in the PCL-5 instrument to be "
^DIC(9.4,100,22,15,"PAH",73,1,2,0)="consistent with the current wording of PCL-5.  The PCL-5 instrument will "
^DIC(9.4,100,22,15,"PAH",73,1,3,0)="be activated so that it is available for selection in the Mental Health "
^DIC(9.4,100,22,15,"PAH",73,1,4,0)="Assistant (MHA).  Also, possible scoring errors for the following "
^DIC(9.4,100,22,15,"PAH",73,1,5,0)="instruments have been corrected:  MMCI3, MMPI-2-RF, MOCA, MOCA Alt 1, and "
^DIC(9.4,100,22,15,"PAH",73,1,6,0)="MOCA Alt 2.  NEOPI is inactivated."
^DIC(9.4,100,22,15,"PAH",73,1,7,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,8,0)="Additionally, the patch provides an interim solution for the problem "
^DIC(9.4,100,22,15,"PAH",73,1,9,0)="where instruments with complex scoring algorithms display inaccurate "
^DIC(9.4,100,22,15,"PAH",73,1,10,0)="scores in Clinical Reminders and Health Summary.  A filter is added that "
^DIC(9.4,100,22,15,"PAH",73,1,11,0)="will prevent selection of these instruments in Clinical Reminders and "
^DIC(9.4,100,22,15,"PAH",73,1,12,0)="Health Summary until a VistA based scoring algorithm can be deployed."
^DIC(9.4,100,22,15,"PAH",73,1,13,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,15,0)="Patch Components:"
^DIC(9.4,100,22,15,"PAH",73,1,16,0)="-----------------"
^DIC(9.4,100,22,15,"PAH",73,1,17,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,18,0)="Files & Fields Associated:"
^DIC(9.4,100,22,15,"PAH",73,1,19,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,20,0)="File Name (Number)              Field Name (Number)       New/Mod/Del"
^DIC(9.4,100,22,15,"PAH",73,1,21,0)="------------------              -------------------       ---"
^DIC(9.4,100,22,15,"PAH",73,1,22,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,23,0)="MH TESTS AND SURVEYS (#601.71)  TAG FOR SCORING (#91)     NEW"
^DIC(9.4,100,22,15,"PAH",73,1,24,0)="MH TESTS AND SURVEYS (#601.71)  ROUTINE FOR SCORING (#92) NEW"
^DIC(9.4,100,22,15,"PAH",73,1,25,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,26,0)="Forms Associated:          N/A"
^DIC(9.4,100,22,15,"PAH",73,1,27,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,28,0)="Mail Groups Associated:    N/A"
