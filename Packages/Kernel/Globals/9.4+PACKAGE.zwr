^DIC(9.4,49,22,10,"PAH",35,1,1,0)="DIAGNOSTIC MEASURES PHASE I/INTAKE REPORTS"
^DIC(9.4,49,22,10,"PAH",36,0)="108 SEQ #96^2981229^1"
^DIC(9.4,49,22,10,"PAH",36,1,0)="^^1^1^2981229"
^DIC(9.4,49,22,10,"PAH",36,1,1,0)="Veterans w/Insurance and Opt. Visits option fix for <SUBSCRIPT> error."
^DIC(9.4,49,22,10,"PAH",37,0)="107 SEQ #97^2990119^1"
^DIC(9.4,49,22,10,"PAH",37,1,0)="^^2^2^2990119"
^DIC(9.4,49,22,10,"PAH",37,1,1,0)="Corrects <UNDEFINED>ALL+24^IBCNS1 error, also changes help text for REFILL"
^DIC(9.4,49,22,10,"PAH",37,1,2,0)="DATE (.1) field of file (356)."
^DIC(9.4,49,22,10,"PAH",38,0)="116 SEQ #98^2990316^1"
^DIC(9.4,49,22,10,"PAH",38,1,0)="^^9^9^2990316"
^DIC(9.4,49,22,10,"PAH",38,1,1,0)="This is the KIDS build for Integrated Billing patch IB*2*116.  The"
^DIC(9.4,49,22,10,"PAH",38,1,2,0)="purpose of this patch is to develop a list of all third party"
^DIC(9.4,49,22,10,"PAH",38,1,3,0)="insurance carriers based on claims that were developed from"
^DIC(9.4,49,22,10,"PAH",38,1,4,0)="10/1/97 through 12/31/98 (the last five fiscal quarters).  This"
^DIC(9.4,49,22,10,"PAH",38,1,5,0)="list will be compiled to develop a national list of third party"
^DIC(9.4,49,22,10,"PAH",38,1,6,0)="payers which is required for the National EDI initiative."
^DIC(9.4,49,22,10,"PAH",38,1,7,0)=" "
^DIC(9.4,49,22,10,"PAH",38,1,8,0)="Please see the National Patch Module description for this patch for"
^DIC(9.4,49,22,10,"PAH",38,1,9,0)="more detailed information."
^DIC(9.4,49,22,10,"PAH",39,0)="95 SEQ #99^2990322^1"
^DIC(9.4,49,22,10,"PAH",39,1,0)="^^3^3^2990322"
^DIC(9.4,49,22,10,"PAH",39,1,1,0)="This patch addresses several problems identified within the On Hold"
^DIC(9.4,49,22,10,"PAH",39,1,2,0)="functionality contained in Integrated Billing v2.0.  These problems were"
^DIC(9.4,49,22,10,"PAH",39,1,3,0)="reported using the Nois system. "
^DIC(9.4,49,22,10,"PAH",40,0)="113 SEQ #100^2990510^1"
^DIC(9.4,49,22,10,"PAH",40,1,0)="^^2^2^2990510"
^DIC(9.4,49,22,10,"PAH",40,1,1,0)="This build is to be installed in conjunction with PRCA*4.5*136 to set the"
^DIC(9.4,49,22,10,"PAH",40,1,2,0)="REVENUE SOURCE CODE correctly for TRICARE bills."
^DIC(9.4,49,22,10,"PAH",41,0)="109 SEQ #101^2990602^1"
^DIC(9.4,49,22,10,"PAH",41,1,0)="^^1^1^2990602"
^DIC(9.4,49,22,10,"PAH",41,1,1,0)="This is the KIDS distribution for patch IB*2*109, Expanded Type of Bill."
^DIC(9.4,49,22,10,"PAH",42,0)="100 SEQ #102^2990622^1"
^DIC(9.4,49,22,10,"PAH",42,1,0)="^^1^1^2990622"
^DIC(9.4,49,22,10,"PAH",42,1,1,0)="DIAGNOSTIC MEASURES PHASE II ROUTINES/FILES"
^DIC(9.4,49,22,10,"PAH",43,0)="117 SEQ #103^2990622^1"
^DIC(9.4,49,22,10,"PAH",43,1,0)="^^14^14^2990622"
^DIC(9.4,49,22,10,"PAH",43,1,1,0)=" "
^DIC(9.4,49,22,10,"PAH",43,1,2,0)="HCFA 1500 and UB-92 bills for Sharing agreement patients when printed "
^DIC(9.4,49,22,10,"PAH",43,1,3,0)="have and extra dash in the zip code."
^DIC(9.4,49,22,10,"PAH",43,1,4,0)=" "
^DIC(9.4,49,22,10,"PAH",43,1,5,0)="Fields in the following files have also been edited to strip out "
^DIC(9.4,49,22,10,"PAH",43,1,6,0)="the dash in the zip codes if present."
^DIC(9.4,49,22,10,"PAH",43,1,7,0)=" "
^DIC(9.4,49,22,10,"PAH",43,1,8,0)="     file: 399 BILLING/CLAIMS    field: 109 MAILING ADDRESS ZIP CODE"
^DIC(9.4,49,22,10,"PAH",43,1,9,0)=" "
^DIC(9.4,49,22,10,"PAH",43,1,10,0)="     file: 364.5 IB DATA ELEMENT  entries: N-MAILING ADDRESS FULL"
^DIC(9.4,49,22,10,"PAH",43,1,11,0)="                               N-CURR INS. CO FULL ADDRESS"
^DIC(9.4,49,22,10,"PAH",43,1,12,0)=" "
^DIC(9.4,49,22,10,"PAH",43,1,13,0)="Also this patch fixes and undefined error found in $ZE=CANCH+6^IBECEAU4:1."
^DIC(9.4,49,22,10,"PAH",43,1,14,0)=" "
^DIC(9.4,49,22,10,"PAH",44,0)="101 SEQ #104^2990719^1"
^DIC(9.4,49,22,10,"PAH",44,1,0)="^^23^23^2990719"
^DIC(9.4,49,22,10,"PAH",44,1,1,0)="This patch corrects the following problem:"
^DIC(9.4,49,22,10,"PAH",44,1,2,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,3,0)="         NOIS: DUB-0698-32098 / DUB-0698-31443"
^DIC(9.4,49,22,10,"PAH",44,1,4,0)="       OPTION: Return Medication to Stock [PSO RETURNED STOCK]"
^DIC(9.4,49,22,10,"PAH",44,1,5,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,6,0)=" Prior to installation of IB*2*70, when a Rx was returned to stock a"
^DIC(9.4,49,22,10,"PAH",44,1,7,0)=" bulletin was generated stating charges were removed. The problem is"
^DIC(9.4,49,22,10,"PAH",44,1,8,0)=" charges are not removed.   The bills are not showing because they are"
^DIC(9.4,49,22,10,"PAH",44,1,9,0)=" still on hold if the patient has insurance with Rx coverage."
^DIC(9.4,49,22,10,"PAH",44,1,10,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,11,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,12,0)=" The Pharmacy user gets the following error:"
^DIC(9.4,49,22,10,"PAH",44,1,13,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,14,0)=" The bill number in the parent IB ACTION entry is missing."
^DIC(9.4,49,22,10,"PAH",44,1,15,0)=" Error in processing...No action taken."
^DIC(9.4,49,22,10,"PAH",44,1,16,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,17,0)=" The coding changes in routines IBARX and IBARX1 has resolved the"
^DIC(9.4,49,22,10,"PAH",44,1,18,0)=" problem. When the user returns the medication to stock, and the copay"
^DIC(9.4,49,22,10,"PAH",44,1,19,0)=" charge status is ""HOLD"", the charge will be cancelled."
^DIC(9.4,49,22,10,"PAH",44,1,20,0)="  "
^DIC(9.4,49,22,10,"PAH",44,1,21,0)="                            ** Special Note **"
^DIC(9.4,49,22,10,"PAH",44,1,22,0)="               The option that is affected belongs to Pharmacy."
^DIC(9.4,49,22,10,"PAH",44,1,23,0)="               The changed routines belong to Integrated Billing."
^DIC(9.4,49,22,10,"PAH",45,0)="106^2990914^1"
^DIC(9.4,49,22,10,"PAH",45,1,0)="^^1^1^2990914"
^DIC(9.4,49,22,10,"PAH",45,1,1,0)="Integrated Billing, Reasonable Charges."
^DIC(9.4,49,22,10,"PAH",46,0)="119 SEQ #107^2991003^1"
^DIC(9.4,49,22,10,"PAH",46,1,0)="^^1^1^2991003"
^DIC(9.4,49,22,10,"PAH",46,1,1,0)="Update Revenue Codes."
^DIC(9.4,49,22,10,"PAH",47,0)="87 SEQ #108^2991104^1"
^DIC(9.4,49,22,10,"PAH",47,1,0)="^^1^1^2991104"
^DIC(9.4,49,22,10,"PAH",47,1,1,0)="Minor IB DD updates."
^DIC(9.4,49,22,10,"PAH",48,0)="120 SEQ #109^2991123^1"
^DIC(9.4,49,22,10,"PAH",48,1,0)="^^1^1^2991123"
^DIC(9.4,49,22,10,"PAH",48,1,1,0)="Veterans w/Insurance reports and Claims Tracking."
^DIC(9.4,49,22,10,"PAH",49,0)="122 SEQ #110^2991123^1"
^DIC(9.4,49,22,10,"PAH",49,1,0)="^^1^1^2991123"
^DIC(9.4,49,22,10,"PAH",49,1,1,0)="Update three Y2K issues."
^DIC(9.4,49,22,10,"PAH",50,0)="112 SEQ #111^2991123^1"
^DIC(9.4,49,22,10,"PAH",50,1,0)="^^8^8^2991123"
^DIC(9.4,49,22,10,"PAH",50,1,1,0)="This patch changes the co-pay exemption message for patients"
^DIC(9.4,49,22,10,"PAH",50,1,2,0)="who decline to give means test info, who are Cat C from"
^DIC(9.4,49,22,10,"PAH",50,1,3,0)="""There is insufficient income data on file for the prior year"""
^DIC(9.4,49,22,10,"PAH",50,1,4,0)="to ""Patients income is greater than Copay Income Threshold"""
^DIC(9.4,49,22,10,"PAH",50,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",50,1,6,0)="This also changes the automatic co-pay exemption for patients"
^DIC(9.4,49,22,10,"PAH",50,1,7,0)="going from Cat C to Cat A,  claiming a hardship."
^DIC(9.4,49,22,10,"PAH",50,1,8,0)=" "
^DIC(9.4,49,22,10,"PAH",51,0)="89 SEQ #112^2991210^1"
^DIC(9.4,49,22,10,"PAH",51,1,0)="^^26^26^2991210"
^DIC(9.4,49,22,10,"PAH",51,1,1,0)="This is the KIDS build for Integrated Billing patch IB*2*89.  This"
^DIC(9.4,49,22,10,"PAH",51,1,2,0)="patch resolves three nois calls:"
^DIC(9.4,49,22,10,"PAH",51,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",51,1,4,0)="LOM-0997-62248"
^DIC(9.4,49,22,10,"PAH",51,1,5,0)="The 'IB - CHAMPUS Primary Billing Task' is queued off as a result of the"
^DIC(9.4,49,22,10,"PAH",51,1,6,0)="'Start the Champus Rx Billing Engine' [IB CHAMP ENGINE START] option.  One"
^DIC(9.4,49,22,10,"PAH",51,1,7,0)="of its tasks is to process all prescriptions queued for billing.  An"
^DIC(9.4,49,22,10,"PAH",51,1,8,0)="interface exists between IB and the Pharmacy package, to return necessary"
^DIC(9.4,49,22,10,"PAH",51,1,9,0)="information about the prescription.  If the Pharmacy interface fails to"
^DIC(9.4,49,22,10,"PAH",51,1,10,0)="return the external value of the prescription number, an undefined error"
^DIC(9.4,49,22,10,"PAH",51,1,11,0)="will occur when attempting to write that number to the error handler."
^DIC(9.4,49,22,10,"PAH",51,1,12,0)="This patch will resolve the undefined error by checking for the existence"
^DIC(9.4,49,22,10,"PAH",51,1,13,0)="of the prescription number prior to writing it to the error handler.  If the"
^DIC(9.4,49,22,10,"PAH",51,1,14,0)="number does not exist, it will be output as 'unknown'."
^DIC(9.4,49,22,10,"PAH",51,1,15,0)=" "
^DIC(9.4,49,22,10,"PAH",51,1,16,0)="REN-0299-61013"
^DIC(9.4,49,22,10,"PAH",51,1,17,0)="Cache systems do not interpret ascii character 13 as a carriage return,"
^DIC(9.4,49,22,10,"PAH",51,1,18,0)="and thus READ statements are not terminated as expected.  A change was"
^DIC(9.4,49,22,10,"PAH",51,1,19,0)="made to interpret the values of the variables 'read' by the system to"
^DIC(9.4,49,22,10,"PAH",51,1,20,0)="determine if the READ statement was terminated as expected."
^DIC(9.4,49,22,10,"PAH",51,1,21,0)=" "
^DIC(9.4,49,22,10,"PAH",51,1,22,0)="REN-0799-61875"
^DIC(9.4,49,22,10,"PAH",51,1,23,0)="The Tricare fiscal intermediary is not accepting electronic transactions"
^DIC(9.4,49,22,10,"PAH",51,1,24,0)="with prescription numbers that contain a trailing alpha character.  A"
^DIC(9.4,49,22,10,"PAH",51,1,25,0)="change was made to strip trailing alpha characters from the"
^DIC(9.4,49,22,10,"PAH",51,1,26,0)="prescription number."
^DIC(9.4,49,22,10,"PAH",52,0)="118 SEQ #113^2991210^1"
^DIC(9.4,49,22,10,"PAH",52,1,0)="^^1^1^2991210"
^DIC(9.4,49,22,10,"PAH",52,1,1,0)="DIAGNOSTIC MEASURES-PHASE III"
^DIC(9.4,49,22,10,"PAH",53,0)="121 SEQ #114^2991210^1"
^DIC(9.4,49,22,10,"PAH",53,1,0)="^^1^1^2991210"
^DIC(9.4,49,22,10,"PAH",53,1,1,0)="NOIS Resolution and Minor Updates"
^DIC(9.4,49,22,10,"PAH",54,0)="129 SEQ #116^3000229^1"
^DIC(9.4,49,22,10,"PAH",54,1,0)="^^2^2^3000229"
^DIC(9.4,49,22,10,"PAH",54,1,1,0)="This patch contains a routine to update the parameter ""NUMBER OF"
^DIC(9.4,49,22,10,"PAH",54,1,2,0)="DAYS PATIENT CHARGES HELD"" from 90 to 150 in file (350.9)."
^DIC(9.4,49,22,10,"PAH",55,0)="128 SEQ #117^3000313^1"
^DIC(9.4,49,22,10,"PAH",55,1,0)="^^1^1^3000313"
^DIC(9.4,49,22,10,"PAH",55,1,1,0)="FIXES TO DIAGNOSTIC MEASURES REPORTS"
^DIC(9.4,49,22,10,"PAH",56,0)="103 SEQ #118^3000405^1"
^DIC(9.4,49,22,10,"PAH",56,1,0)="^^1^1^3000405"
^DIC(9.4,49,22,10,"PAH",56,1,1,0)="Medicare Insurance Intake"
^DIC(9.4,49,22,10,"PAH",57,0)="125 SEQ #119^3000405^1"
^DIC(9.4,49,22,10,"PAH",57,1,0)="^^1^1^3000405"
^DIC(9.4,49,22,10,"PAH",57,1,1,0)="CPT MODIFIERS Initiative:  Update transfer of CPT Modifiers to/from PCE."
^DIC(9.4,49,22,10,"PAH",58,0)="124 SEQ #120^3000405^1"
^DIC(9.4,49,22,10,"PAH",58,1,0)="^^5^5^3000405"
^DIC(9.4,49,22,10,"PAH",58,1,1,0)="IB*2.0*124:  Miscellaneous updates and NOIS resolution"
^DIC(9.4,49,22,10,"PAH",58,1,2,0)="  "
^DIC(9.4,49,22,10,"PAH",58,1,3,0)="Updates to Output Formater:   Pre-init:  364.6 - 618,763,764"
^DIC(9.4,49,22,10,"PAH",58,1,4,0)="                               Install:  364.7 - 496,641,642,789"
^DIC(9.4,49,22,10,"PAH",58,1,5,0)="                                         364.5 - 114,116,117,118,119,155"
^DIC(9.4,49,22,10,"PAH",59,0)="74 SEQ #121^3000612^1"
^DIC(9.4,49,22,10,"PAH",59,1,0)="^^8^8^3000612"
^DIC(9.4,49,22,10,"PAH",59,1,1,0)="The purpose of this patch is to update and file the new fiscal year "
^DIC(9.4,49,22,10,"PAH",59,1,2,0)="threshold rates for the Maximum Annual Rate of Pension which"
^DIC(9.4,49,22,10,"PAH",59,1,3,0)="is required for use in the Integrated Billing software application."
^DIC(9.4,49,22,10,"PAH",59,1,4,0)="In addition, a new TYPE (.02) of  ""Basic Pension"" has been added"
^DIC(9.4,49,22,10,"PAH",59,1,5,0)="to the BILLING THRESHOLDS file (354.3) to lessen the confusion"
^DIC(9.4,49,22,10,"PAH",59,1,6,0)="when entering the default basic threshold rates.  Minor software changes"
^DIC(9.4,49,22,10,"PAH",59,1,7,0)="have also been made to accommodate this new field type.  "
^DIC(9.4,49,22,10,"PAH",59,1,8,0)=" "
^DIC(9.4,49,22,10,"PAH",60,0)="134 SEQ #122^3000626^1"
^DIC(9.4,49,22,10,"PAH",60,1,0)="^^1^1^3000626"
^DIC(9.4,49,22,10,"PAH",60,1,1,0)="Update Provider Discount groups and add 2 Revenue Codes."
^DIC(9.4,49,22,10,"PAH",61,0)="126 SEQ #123^3000711^1"
^DIC(9.4,49,22,10,"PAH",61,1,0)="^^1^1^3000711"
^DIC(9.4,49,22,10,"PAH",61,1,1,0)="RAI/MDS Support:  add cross references to fields so they may be monitored."
^DIC(9.4,49,22,10,"PAH",62,0)="133 SEQ #124^3000816^1"
^DIC(9.4,49,22,10,"PAH",62,1,0)="^^1^1^3000816"
^DIC(9.4,49,22,10,"PAH",62,1,1,0)="Minor updates and NOIS resolution."
^DIC(9.4,49,22,10,"PAH",63,0)="115 SEQ #125^3000824^1"
^DIC(9.4,49,22,10,"PAH",63,1,0)="^^1^1^3000824"
^DIC(9.4,49,22,10,"PAH",63,1,1,0)="Transfer Pricing"
^DIC(9.4,49,22,10,"PAH",64,0)="131 SEQ #126^3000905^1"
^DIC(9.4,49,22,10,"PAH",64,1,0)="^^1^1^3000905"
^DIC(9.4,49,22,10,"PAH",64,1,1,0)="CPT 2000 Replacement Charges for RC v1."
^DIC(9.4,49,22,10,"PAH",65,0)="132 SEQ #128^3001027^1"
^DIC(9.4,49,22,10,"PAH",65,1,0)="^^7^7^3001027"
^DIC(9.4,49,22,10,"PAH",65,1,1,0)="Patient Billing Enhancements:"
^DIC(9.4,49,22,10,"PAH",65,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",65,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",65,1,4,0)=" This is the Patient Billing Enhancement KID's Distribution for Patch"
^DIC(9.4,49,22,10,"PAH",65,1,5,0)="IB*2.0*132. For specific information relating to the installation of this"
^DIC(9.4,49,22,10,"PAH",65,1,6,0)="KID's distribution please see the National Patch Module section Patch"
^DIC(9.4,49,22,10,"PAH",65,1,7,0)="Description subsection Installation Instructions."
