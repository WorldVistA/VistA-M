^DIC(9.4,59,22,5,"PAH",301,0)="297 SEQ #301^3120222.120601^17"
^DIC(9.4,59,22,5,"PAH",301,1,0)="^^41^41^3120222"
^DIC(9.4,59,22,5,"PAH",301,1,1,0)="VistA Patch PSN*4*304 released November 10, 2011 created a new VA drug "
^DIC(9.4,59,22,5,"PAH",301,1,2,0)="class ""AM400 QUINOLONES"".  The quinolone antibiotics were previously "
^DIC(9.4,59,22,5,"PAH",301,1,3,0)="located under VA drug class ""AM900 ANTI-INFECTIVES,OTHER"".  Existing"
^DIC(9.4,59,22,5,"PAH",301,1,4,0)="patient allergies in the PATIENT ALLERGIES file (#120.8) to antibiotics "
^DIC(9.4,59,22,5,"PAH",301,1,5,0)="in the quinolone class were not automatically updated to the new VA drug"
^DIC(9.4,59,22,5,"PAH",301,1,6,0)="classification with the release of PSN*4*304. Consequently the entry of"
^DIC(9.4,59,22,5,"PAH",301,1,7,0)="a new order for an antibiotic in the Quinolone VA drug class will not"
^DIC(9.4,59,22,5,"PAH",301,1,8,0)="trigger a drug allergy alert."
^DIC(9.4,59,22,5,"PAH",301,1,9,0)="  "
^DIC(9.4,59,22,5,"PAH",301,1,10,0)="A facility reported that the drug-allergy order check in VistA/CPRS did"
^DIC(9.4,59,22,5,"PAH",301,1,11,0)="not trigger appropriately when a patient was ordered a fluroquinolone type"
^DIC(9.4,59,22,5,"PAH",301,1,12,0)="antibiotic that the patient had a known allergy to.  The drug allergy was"
^DIC(9.4,59,22,5,"PAH",301,1,13,0)="properly documented in the VistA Adverse Reaction Tracking (ART) System. "
^DIC(9.4,59,22,5,"PAH",301,1,14,0)=" "
^DIC(9.4,59,22,5,"PAH",301,1,15,0)="This patch contains a post-install routine that will loop through all the"
^DIC(9.4,59,22,5,"PAH",301,1,16,0)="patient allergies entries for quinolones and will correctly update such "
^DIC(9.4,59,22,5,"PAH",301,1,17,0)="entries with the new class ""AM400 QUINOLONES"", which should trigger the"
^DIC(9.4,59,22,5,"PAH",301,1,18,0)="drug-allergy order check when the patient is ordered a medication under"
^DIC(9.4,59,22,5,"PAH",301,1,19,0)="this drug class. Once completed, the post-install routine will generate"
^DIC(9.4,59,22,5,"PAH",301,1,20,0)="and send the Mailman message below to the person who installed the patch,"
^DIC(9.4,59,22,5,"PAH",301,1,21,0)="to the mail group 'NDF DATA' and to all the 'PSNMGR' security key holders."
^DIC(9.4,59,22,5,"PAH",301,1,22,0)=" "
^DIC(9.4,59,22,5,"PAH",301,1,23,0)="    Subj: Post-install results from patch PSN*4*297  [#110557] 02/02/12"
^DIC(9.4,59,22,5,"PAH",301,1,24,0)="    From: NDF MANAGER  In 'IN' basket.   Page 1"
^DIC(9.4,59,22,5,"PAH",301,1,25,0)="    ---------------------------------------------------------------------"
^DIC(9.4,59,22,5,"PAH",301,1,26,0)="    Number of Patient Allergy entries by class:"
^DIC(9.4,59,22,5,"PAH",301,1,27,0)="  "
^DIC(9.4,59,22,5,"PAH",301,1,28,0)="    Before update:"
^DIC(9.4,59,22,5,"PAH",301,1,29,0)="    AM900 - ANTI-INFECTIVES,OTHER: 1601"
^DIC(9.4,59,22,5,"PAH",301,1,30,0)="    AM400 - QUINOLONES           : 11"
^DIC(9.4,59,22,5,"PAH",301,1,31,0)=" "
^DIC(9.4,59,22,5,"PAH",301,1,32,0)="    After update:"
^DIC(9.4,59,22,5,"PAH",301,1,33,0)="    AM900 - ANTI-INFECTIVES,OTHER: 919"
^DIC(9.4,59,22,5,"PAH",301,1,34,0)="    AM400 - QUINOLONES           : 693"
^DIC(9.4,59,22,5,"PAH",301,1,35,0)=" "
^DIC(9.4,59,22,5,"PAH",301,1,36,0)="    Enter message action (in IN basket): Ignore//"
^DIC(9.4,59,22,5,"PAH",301,1,37,0)=" "
^DIC(9.4,59,22,5,"PAH",301,1,38,0)="The results above will vary from site to site. Some sites might even have"
^DIC(9.4,59,22,5,"PAH",301,1,39,0)="the exact same number 'Before' and 'After' the update, which means the"
^DIC(9.4,59,22,5,"PAH",301,1,40,0)="site had not been affected by the problem in PSN*4*304 when it was "
^DIC(9.4,59,22,5,"PAH",301,1,41,0)="installed."
^DIC(9.4,59,22,5,"PAH",302,0)="315^3120312.120215^17"
^DIC(9.4,59,22,5,"PAH",302,1,0)="^^17^17^3120312"
^DIC(9.4,59,22,5,"PAH",302,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",302,1,2,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",302,1,3,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",302,1,4,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",302,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",302,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",302,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",302,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",302,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",302,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",302,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",302,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",302,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",302,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",302,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",302,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",302,1,17,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",303,0)="316^3120329.183341^17"
^DIC(9.4,59,22,5,"PAH",303,1,0)="^^16^16^3120329"
^DIC(9.4,59,22,5,"PAH",303,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",303,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",303,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",303,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",303,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",303,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",303,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",303,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",303,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",303,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",303,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",303,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",303,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",303,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",303,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",303,1,16,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",304,0)="317^3120329.183442^17"
^DIC(9.4,59,22,5,"PAH",304,1,0)="^^4^4^3120329"
^DIC(9.4,59,22,5,"PAH",304,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",304,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",304,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",304,1,4,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",305,0)="264 SEQ #305^3120329.183545^17"
^DIC(9.4,59,22,5,"PAH",305,1,0)="^^18^18^3120329"
^DIC(9.4,59,22,5,"PAH",305,1,1,0)="This patch performs the following data dictionary update in the VA "
^DIC(9.4,59,22,5,"PAH",305,1,2,0)="PRODUCT file (#50.68). The HELP-PROMPT and TECHNICAL DESCR for the FDA MED"
^DIC(9.4,59,22,5,"PAH",305,1,3,0)="GUIDE field (#100) is being modified as show below:"
^DIC(9.4,59,22,5,"PAH",305,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",305,1,5,0)="   Current: "
^DIC(9.4,59,22,5,"PAH",305,1,6,0)="    "
^DIC(9.4,59,22,5,"PAH",305,1,7,0)="   HELP PROMPT    : Answer must be 1-100 characters in length"
^DIC(9.4,59,22,5,"PAH",305,1,8,0)="   TECHNICAL DESCR: This field is used for storing the FDA Medication"
^DIC(9.4,59,22,5,"PAH",305,1,9,0)="                    Guide file name associated "
^DIC(9.4,59,22,5,"PAH",305,1,10,0)=" "
^DIC(9.4,59,22,5,"PAH",305,1,11,0)="   Requested changes:"
^DIC(9.4,59,22,5,"PAH",305,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",305,1,13,0)="   HELP-PROMPT    : Answer must be 1-100 characters in length."
^DIC(9.4,59,22,5,"PAH",305,1,14,0)="   TECHNICAL DESCR: This field is used for storing the FDA Medication"
^DIC(9.4,59,22,5,"PAH",305,1,15,0)="                    Guide filename associated with this VA Product. The "
^DIC(9.4,59,22,5,"PAH",305,1,16,0)="                    file is physically stored in the repository indicated"
^DIC(9.4,59,22,5,"PAH",305,1,17,0)="                    in the FDA MED GUIDE SERVER URL field (#100) in the"
^DIC(9.4,59,22,5,"PAH",305,1,18,0)="                    PHARMACY SYSTEM file (#59.7). "
^DIC(9.4,59,22,5,"PAH",306,0)="318^3120410.151452^17"
