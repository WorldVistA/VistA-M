^DIC(9.4,146,0)="OCCURRENCE SCREEN^QAO^OCCURRENCE SCREENING VERSION 3.0"
^DIC(9.4,146,1,0)="^^5^5^2930831^"
^DIC(9.4,146,1,1,0)="The package addresses the Occurrence Screen circular by automating the"
^DIC(9.4,146,1,2,0)="collection of selected occurrence screens.  The remaining screens that"
^DIC(9.4,146,1,3,0)="are not auto enrolled may be entered manually.  Provision has been made"
^DIC(9.4,146,1,4,0)="for identifying practitioner, system, and equipment related problems"
^DIC(9.4,146,1,5,0)="with patient risk events."
^DIC(9.4,146,4,0)="^9.44PA^17^14"
