^DIC(9.4,185,5)="ALBANY ISC"
^DIC(9.4,185,20,0)="^9.402P^^"
^DIC(9.4,185,22,0)="^9.49I^1^1"
^DIC(9.4,185,22,1,0)="1.0^3051119^3020506^1"
^DIC(9.4,185,22,1,1,0)="^^2^2^3051119"
^DIC(9.4,185,22,1,1,1,0)="Breakout of Incomplete Records Tracking (DGJ 1.0) package from the"
^DIC(9.4,185,22,1,1,2,0)="Registration namespace (DG)."
^DIC(9.4,185,22,1,"PAH",0)="^9.4901^3^3"
^DIC(9.4,185,22,1,"PAH",1,0)="1 SEQ #1^3030520^1"
^DIC(9.4,185,22,1,"PAH",1,1,0)="^^34^34^3030520"
^DIC(9.4,185,22,1,"PAH",1,1,1,0)="This patch provides Incomplete Records Tracking with the interface"
^DIC(9.4,185,22,1,"PAH",1,1,2,0)="capabilities to the Core Financial Logistics System (CoreFLS).  CoreFLS"
^DIC(9.4,185,22,1,"PAH",1,1,3,0)="will replace the Integrated Funds Distribution, Control Point Activity,"
^DIC(9.4,185,22,1,"PAH",1,1,4,0)="and Procurement (IFCAP) package."
^DIC(9.4,185,22,1,"PAH",1,1,5,0)=" "
^DIC(9.4,185,22,1,"PAH",1,1,6,0)="Vendor information for CoreFLS will be held nationally on a remote"
^DIC(9.4,185,22,1,"PAH",1,1,7,0)="database.  To alleviate traffic over your network, a local vendor file,"
^DIC(9.4,185,22,1,"PAH",1,1,8,0)="LOCAL VENDOR (#392.31) has been placed on your local system to be used to"
^DIC(9.4,185,22,1,"PAH",1,1,9,0)="store and access your frequently use vendors."
^DIC(9.4,185,22,1,"PAH",1,1,10,0)=" "
^DIC(9.4,185,22,1,"PAH",1,1,11,0)="A new menu is added to your Incomplete Records Tracking Menu.  This menu"
^DIC(9.4,185,22,1,"PAH",1,1,12,0)="called, Add a local vendor (COREFLS), will allow users holding the DGJ"
^DIC(9.4,185,22,1,"PAH",1,1,13,0)="LOCAL VENDOR key the ability to add CoreFLS vendors to the LOCAL VENDOR"
^DIC(9.4,185,22,1,"PAH",1,1,14,0)="file (#392.31). This menu will verify the existence of the CoreFLS "
^DIC(9.4,185,22,1,"PAH",1,1,15,0)="package before allowing the user to proceed with the CoreFLS vendor query."
^DIC(9.4,185,22,1,"PAH",1,1,16,0)=" "
^DIC(9.4,185,22,1,"PAH",1,1,17,0)="A Variable Pointer is added to the TRANSCRIBED BY field (#10.04) allowing "
^DIC(9.4,185,22,1,"PAH",1,1,18,0)="a user to choose a CoreFLS vendor from the LOCAL VENDOR fie (#392.31).  "
^DIC(9.4,185,22,1,"PAH",1,1,19,0)="Users will not be allowed to add vendors (LAYGO) at this field into the "
^DIC(9.4,185,22,1,"PAH",1,1,20,0)="LOCAL VENDOR file, similar to accessing a vendor from the VENDOR file"
^DIC(9.4,185,22,1,"PAH",1,1,21,0)="(#440).  Users can only add CoreFLS vendors through the above mentioned"
^DIC(9.4,185,22,1,"PAH",1,1,22,0)="'Add a local vendor (COREFLS)' holding the DGJ LOCAL VENDOR key."
^DIC(9.4,185,22,1,"PAH",1,1,23,0)=" "
^DIC(9.4,185,22,1,"PAH",1,1,24,0)="Options effected."
^DIC(9.4,185,22,1,"PAH",1,1,25,0)="-----------------"
