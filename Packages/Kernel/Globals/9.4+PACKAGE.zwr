^DIC(9.4,4,22,1,"PAH",128,1,43,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",128,1,44,0)=" Select INSTALL NAME:    XM*7.1*160    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",128,1,45,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",128,1,46,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",128,1,47,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",128,1,48,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",128,1,49,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",128,1,50,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",128,1,51,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",128,1,52,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",128,1,53,0)=" Enter a '^' to abort the install."
