^DIC(9.4,93,22,21,"PAH",0)="^9.4901^203^203"
^DIC(9.4,93,22,21,"PAH",1,0)="6 SEQ #4^2960819^1"
^DIC(9.4,93,22,21,"PAH",1,1,0)="^^2^2^2960819"
^DIC(9.4,93,22,21,"PAH",1,1,1,0)="See National Patch Module entry for patch DVBA*2.7*6 for details on the"
^DIC(9.4,93,22,21,"PAH",1,1,2,0)="changes included in this patch."
^DIC(9.4,93,22,21,"PAH",2,0)="4 SEQ #5^2960819^1"
^DIC(9.4,93,22,21,"PAH",2,1,0)="^^1^1^2960819"
^DIC(9.4,93,22,21,"PAH",2,1,1,0)="Contains changes as described in the National Patch Module for DVB*2.7*4."
^DIC(9.4,93,22,21,"PAH",3,0)="5 SEQ #7^2960819^1"
^DIC(9.4,93,22,21,"PAH",3,1,0)="^^3^3^2960819"
^DIC(9.4,93,22,21,"PAH",3,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",3,1,2,0)=" See National Patch Module Entry DVBA*2.7*5 on Forum for details of this"
^DIC(9.4,93,22,21,"PAH",3,1,3,0)="patch."
^DIC(9.4,93,22,21,"PAH",4,0)="8 SEQ #8^2960819^1"
^DIC(9.4,93,22,21,"PAH",4,1,0)="^^2^2^2960819"
^DIC(9.4,93,22,21,"PAH",4,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",4,1,2,0)=" See patch description in the Patch Module for patch DVBA*2.7*8"
^DIC(9.4,93,22,21,"PAH",5,0)="9 SEQ #9^2960819^1"
^DIC(9.4,93,22,21,"PAH",5,1,0)="^^2^2^2960819"
^DIC(9.4,93,22,21,"PAH",5,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",5,1,2,0)="See the patch description on DVBA*2.7*9 of the patch module for details."
^DIC(9.4,93,22,21,"PAH",6,0)="10 SEQ #10^2960819^1"
^DIC(9.4,93,22,21,"PAH",6,1,0)="^^3^3^2960819"
^DIC(9.4,93,22,21,"PAH",6,1,1,0)="This patch addresses a problem with updating a cancelled request when the"
^DIC(9.4,93,22,21,"PAH",6,1,2,0)="exams are cancelled at another facility.  See the National Patch Module"
^DIC(9.4,93,22,21,"PAH",6,1,3,0)="for a more detailed description of the changes included with this patch."
^DIC(9.4,93,22,21,"PAH",7,0)="11 SEQ #11^2960819^1"
^DIC(9.4,93,22,21,"PAH",7,1,0)="^^1^1^2960819"
^DIC(9.4,93,22,21,"PAH",7,1,1,0)="See National Patch Module for a complete description of this patch."
^DIC(9.4,93,22,21,"PAH",8,0)="12 SEQ #12^2970922^1"
^DIC(9.4,93,22,21,"PAH",8,1,0)="^9.49011^1^1^2970922"
^DIC(9.4,93,22,21,"PAH",8,1,1,0)="This is a patch to the AMIE Worksheet functionality.  See patch description."
^DIC(9.4,93,22,21,"PAH",9,0)="13 SEQ #13^2971105^1"
^DIC(9.4,93,22,21,"PAH",9,1,0)="^9.49011^1^1^2971105"
^DIC(9.4,93,22,21,"PAH",9,1,1,0)="See patch module description on FORUM."
^DIC(9.4,93,22,21,"PAH",10,0)="15 SEQ #14^2980318^.05"
^DIC(9.4,93,22,21,"PAH",11,0)="14 SEQ #15^2980318^1"
^DIC(9.4,93,22,21,"PAH",11,1,0)="^^1^1^2980318"
^DIC(9.4,93,22,21,"PAH",11,1,1,0)="ACRP Database conversion software changes patch."
^DIC(9.4,93,22,21,"PAH",12,0)="16 SEQ #16^2980330^1"
^DIC(9.4,93,22,21,"PAH",12,1,0)="^9.49011^2^2^2980330"
^DIC(9.4,93,22,21,"PAH",12,1,1,0)="DVBA*2.7*16"
^DIC(9.4,93,22,21,"PAH",12,1,2,0)="Update to File #396.6 and worksheets."
^DIC(9.4,93,22,21,"PAH",13,0)="17 SEQ #17^2980403^1"
^DIC(9.4,93,22,21,"PAH",13,1,0)="^9.49011^1^1^2980403"
^DIC(9.4,93,22,21,"PAH",13,1,1,0)=" See the patch description for DVBA*2.7*17 in the Patch Module on Forum."
^DIC(9.4,93,22,21,"PAH",14,0)="19 SEQ #18^2980604^1"
^DIC(9.4,93,22,21,"PAH",14,1,0)="^^1^1^2980604"
^DIC(9.4,93,22,21,"PAH",14,1,1,0)="DVBA*2.7*19"
^DIC(9.4,93,22,21,"PAH",15,0)="20 SEQ #19^2980616^1"
^DIC(9.4,93,22,21,"PAH",15,1,0)="^^1^1^2980616"
^DIC(9.4,93,22,21,"PAH",15,1,1,0)="DVBA*2.7*20"
^DIC(9.4,93,22,21,"PAH",16,0)="22 SEQ #20^2980725^1"
^DIC(9.4,93,22,21,"PAH",16,1,0)="^^1^1^2980725"
^DIC(9.4,93,22,21,"PAH",16,1,1,0)="Maintain integrity of file #396.4."
^DIC(9.4,93,22,21,"PAH",17,0)="18 SEQ #21^2980808^1"
^DIC(9.4,93,22,21,"PAH",17,1,0)="^^1^1^2980808"
^DIC(9.4,93,22,21,"PAH",17,1,1,0)="DVBA*2.7*18"
^DIC(9.4,93,22,21,"PAH",18,0)="23 SEQ #22^2990105^1"
^DIC(9.4,93,22,21,"PAH",18,1,0)="^^2^2^2990105"
^DIC(9.4,93,22,21,"PAH",18,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,93,22,21,"PAH",18,1,2,0)="of patch DVBA*2.7*23 in the National Patch Module."
^DIC(9.4,93,22,21,"PAH",19,0)="26 SEQ #23^2990427^1"
^DIC(9.4,93,22,21,"PAH",19,1,0)="^^6^6^2990427"
^DIC(9.4,93,22,21,"PAH",19,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",19,1,2,0)="Update of AMIE worsheets per VHA request.  The following are updated:"
^DIC(9.4,93,22,21,"PAH",19,1,3,0)="     LIVER, GALL BLADDER AND PANCREAS"
^DIC(9.4,93,22,21,"PAH",19,1,4,0)="     GENERAL MEDICAL EXAMINATION"
^DIC(9.4,93,22,21,"PAH",19,1,5,0)="     AUDIO"
^DIC(9.4,93,22,21,"PAH",19,1,6,0)="     EAR DISEASE"
^DIC(9.4,93,22,21,"PAH",20,0)="28 SEQ #24^2991003^1"
^DIC(9.4,93,22,21,"PAH",20,1,0)="^^2^2^2991003"
^DIC(9.4,93,22,21,"PAH",20,1,1,0)="This patch corrects an undefined IO error, which happens when IO is not"
^DIC(9.4,93,22,21,"PAH",20,1,2,0)="defined in the environment."
^DIC(9.4,93,22,21,"PAH",21,0)="25 SEQ #25^2991003^1"
^DIC(9.4,93,22,21,"PAH",21,1,0)="^^1^1^2991003"
^DIC(9.4,93,22,21,"PAH",21,1,1,0)="Correct undefined error for variable ""DA"""
^DIC(9.4,93,22,21,"PAH",22,0)="24 SEQ #26^3000204^1"
^DIC(9.4,93,22,21,"PAH",22,1,0)="^^5^5^3000204"
^DIC(9.4,93,22,21,"PAH",22,1,1,0)="This patch eliminates the undefined error caused if no node 2 exists"
^DIC(9.4,93,22,21,"PAH",22,1,2,0)="for a selected FORM 7131 file (#396) entry."
^DIC(9.4,93,22,21,"PAH",22,1,3,0)=" "
^DIC(9.4,93,22,21,"PAH",22,1,4,0)="The changes included in this patch are described in the description"
^DIC(9.4,93,22,21,"PAH",22,1,5,0)="of patch DVBA*2.7*24 in the National Patch Module."
^DIC(9.4,93,22,21,"PAH",23,0)="27 SEQ #27^3000405^1"
^DIC(9.4,93,22,21,"PAH",23,1,0)="^^2^2^3000405"
^DIC(9.4,93,22,21,"PAH",23,1,1,0)="This patch makes it possible to queue Insufficient Exam Report to a"
^DIC(9.4,93,22,21,"PAH",23,1,2,0)="printer."
^DIC(9.4,93,22,21,"PAH",24,0)="30 SEQ #28^3000417^1"
^DIC(9.4,93,22,21,"PAH",24,1,0)="^^3^3^3000417"
^DIC(9.4,93,22,21,"PAH",24,1,1,0)="This patch makes it possible to print blank C&P worksheets in AMIE II. The"
^DIC(9.4,93,22,21,"PAH",24,1,2,0)="menu option is added under the Medical Administration C&P Menu for MAS"
^DIC(9.4,93,22,21,"PAH",24,1,3,0)="users."
^DIC(9.4,93,22,21,"PAH",25,0)="29 SEQ #29^3000626^1"
^DIC(9.4,93,22,21,"PAH",25,1,0)="^^1^1^3000626"
^DIC(9.4,93,22,21,"PAH",25,1,1,0)="User-friendly word processing of the General Remarks of new C&P reports."
^DIC(9.4,93,22,21,"PAH",26,0)="31 SEQ #30^3000816^1"
^DIC(9.4,93,22,21,"PAH",26,1,0)="^^2^2^3000816"
^DIC(9.4,93,22,21,"PAH",26,1,1,0)="When users print C&P exam result, sign ""<"" as well as its following exam "
^DIC(9.4,93,22,21,"PAH",26,1,2,0)="information will not be printed. The patch corrects the problem."
^DIC(9.4,93,22,21,"PAH",27,0)="32 SEQ #32^3000824^1"
^DIC(9.4,93,22,21,"PAH",27,1,0)="^^2^2^3000824"
^DIC(9.4,93,22,21,"PAH",27,1,1,0)="Address various problems related to claim folder location, division, and"
^DIC(9.4,93,22,21,"PAH",27,1,2,0)="station number being null."
^DIC(9.4,93,22,21,"PAH",28,0)="34 SEQ #34^3010529^1"
^DIC(9.4,93,22,21,"PAH",28,1,0)="^^3^3^3010529"
^DIC(9.4,93,22,21,"PAH",28,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",28,1,2,0)="The patch updates five AMIE worksheets and creates a new one in the"
^DIC(9.4,93,22,21,"PAH",28,1,3,0)="Vista Automated Information Excahange (AMIE) EXAM file (396.6)."
^DIC(9.4,93,22,21,"PAH",29,0)="35 SEQ #35^3010710^1"
^DIC(9.4,93,22,21,"PAH",29,1,0)="^^2^2^3010710"
^DIC(9.4,93,22,21,"PAH",29,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,93,22,21,"PAH",29,1,2,0)="section of patch DVBA*2.7*35 in the National Patch Module"
^DIC(9.4,93,22,21,"PAH",30,0)="36 SEQ #36^3010906^1"
^DIC(9.4,93,22,21,"PAH",30,1,0)="^^3^3^3010906"
^DIC(9.4,93,22,21,"PAH",30,1,1,0)="This patch updates one AMIE worksheet: LIVER, GALL BLADDER, AND PANCREAS in"
^DIC(9.4,93,22,21,"PAH",30,1,2,0)="the Vista Automated Information Exchange (AMIE) EXAM file (396.6)."
^DIC(9.4,93,22,21,"PAH",30,1,3,0)=""
^DIC(9.4,93,22,21,"PAH",31,0)="37 SEQ #37^3011106^1"
^DIC(9.4,93,22,21,"PAH",32,0)="39 SEQ #38^3011210^1"
^DIC(9.4,93,22,21,"PAH",32,1,0)="^^3^3^3011210"
^DIC(9.4,93,22,21,"PAH",32,1,1,0)="This patch corrects 0305 reporting program: DVBCWLQ where a header was "
^DIC(9.4,93,22,21,"PAH",32,1,2,0)="assigned incorrectly when more exams were printed."
^DIC(9.4,93,22,21,"PAH",32,1,3,0)=""
^DIC(9.4,93,22,21,"PAH",33,0)="40 SEQ #39^3011210^1"
^DIC(9.4,93,22,21,"PAH",34,0)="41 SEQ #41^3020226^1"
^DIC(9.4,93,22,21,"PAH",34,1,0)="^^179^179^3020226"
^DIC(9.4,93,22,21,"PAH",34,1,1,0)="DVBA*2.7*41 consists of a KID install for VHA, a new GUI client for VBA"
^DIC(9.4,93,22,21,"PAH",34,1,2,0)="and a new ESSO (single sign-on) client for BVA, VHA MPI-Data Quality Team"
^DIC(9.4,93,22,21,"PAH",34,1,3,0)="and VBA's Tiger Team.  The ESSO client will not be available via FTP and "
^DIC(9.4,93,22,21,"PAH",34,1,4,0)="will be distributed directly to the teams that need it.  The non-ESSO "
^DIC(9.4,93,22,21,"PAH",34,1,5,0)="version of CAPRI will be able to be downloaded off of OI Field Office FTP "
^DIC(9.4,93,22,21,"PAH",34,1,6,0)="sites.  Information is available at the end of this message with the "
^DIC(9.4,93,22,21,"PAH",34,1,7,0)="instructions."
^DIC(9.4,93,22,21,"PAH",34,1,8,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,9,0)="Previous versions of CAPRI will continue to function after this patch is "
^DIC(9.4,93,22,21,"PAH",34,1,10,0)="installed.  After it has been confirmed that all sites have loaded this "
^DIC(9.4,93,22,21,"PAH",34,1,11,0)="patch and the new GUI has been deployed, a subsequent patch will be "
^DIC(9.4,93,22,21,"PAH",34,1,12,0)="released that will de-activate previous CAPRI versions."
^DIC(9.4,93,22,21,"PAH",34,1,13,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,14,0)="Changes to this version of CAPRI are primarily in the Delphi/GUI code.  "
^DIC(9.4,93,22,21,"PAH",34,1,15,0)="However, a new KID was created to add additional existing "
^DIC(9.4,93,22,21,"PAH",34,1,16,0)="broker calls to the option DVBA CAPRI GUI on the server side."
^DIC(9.4,93,22,21,"PAH",34,1,17,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,18,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,19,0)="PRE-INIT ROUTINE"
^DIC(9.4,93,22,21,"PAH",34,1,20,0)="----------------"
^DIC(9.4,93,22,21,"PAH",34,1,21,0)="An entry for BVA/VBA Support office will automatically be added to files "
^DIC(9.4,93,22,21,"PAH",34,1,22,0)="INSTITUTION (#4) and FACILITY TYPE (#4.1)."
^DIC(9.4,93,22,21,"PAH",34,1,23,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,24,0)="POST-INSTALL ROUTINE"
^DIC(9.4,93,22,21,"PAH",34,1,25,0)="____________________"
^DIC(9.4,93,22,21,"PAH",34,1,26,0)="The remote user BVADevelopmentMERequests@mail.domain.ext will been added to "
^DIC(9.4,93,22,21,"PAH",34,1,27,0)="the following mailgroups:"
^DIC(9.4,93,22,21,"PAH",34,1,28,0)="1. DVBA C 2507 CANCELLATION"
^DIC(9.4,93,22,21,"PAH",34,1,29,0)="2. DVBA C 2507 EXAM REOPEN"
^DIC(9.4,93,22,21,"PAH",34,1,30,0)="3. DVBA C 2507 EXAM READY"
^DIC(9.4,93,22,21,"PAH",34,1,31,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,32,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,33,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,34,0)="CHANGES TO DVBA_2_7_41.EXE"
^DIC(9.4,93,22,21,"PAH",34,1,35,0)="--------------------------"
^DIC(9.4,93,22,21,"PAH",34,1,36,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,37,0)="1.  Ability to pick an exam type by body system when adding new exam "
^DIC(9.4,93,22,21,"PAH",34,1,38,0)="request."
^DIC(9.4,93,22,21,"PAH",34,1,39,0)="2.  Ability to pick an exam type by body system when editing or adding to "
^DIC(9.4,93,22,21,"PAH",34,1,40,0)="an existing exam request."
^DIC(9.4,93,22,21,"PAH",34,1,41,0)="3.  Re-designed custom report builder as a floating tool.  Documents can "
^DIC(9.4,93,22,21,"PAH",34,1,42,0)="be added/deleted or resequenced in any order."
^DIC(9.4,93,22,21,"PAH",34,1,43,0)="4.  Ability to search by date, # documents, or all documents.  Date range "
^DIC(9.4,93,22,21,"PAH",34,1,44,0)="applies to notes, discharge summaries, consults."
^DIC(9.4,93,22,21,"PAH",34,1,45,0)="5.  CAPRI cooperates better with Windows and releases processor ticks so "
^DIC(9.4,93,22,21,"PAH",34,1,46,0)="that it won't report as ""not responding"" in Task Manager when building a "
^DIC(9.4,93,22,21,"PAH",34,1,47,0)="big report."
^DIC(9.4,93,22,21,"PAH",34,1,48,0)="6.  Animations display at login and while downloading information from "
^DIC(9.4,93,22,21,"PAH",34,1,49,0)="VistA in a fashion reminiscent of Internet Explorer..  Status messages at "
^DIC(9.4,93,22,21,"PAH",34,1,50,0)="the bottom explain the actions taking place or display errors to assist "
^DIC(9.4,93,22,21,"PAH",34,1,51,0)="with troubleshooting."
^DIC(9.4,93,22,21,"PAH",34,1,52,0)="7.  Ability to do a search for a division for all of the notes displayed "
^DIC(9.4,93,22,21,"PAH",34,1,53,0)="on the screen.  Division was also added to the header of progress notes "
^DIC(9.4,93,22,21,"PAH",34,1,54,0)="when they are displayed."
^DIC(9.4,93,22,21,"PAH",34,1,55,0)="8. Remote Data Views has been added to Health Summary tab."
^DIC(9.4,93,22,21,"PAH",34,1,56,0)="9.  Integration control number has been added to patient selector to help "
^DIC(9.4,93,22,21,"PAH",34,1,57,0)="troubleshoot and validate identity of patients across sites."
^DIC(9.4,93,22,21,"PAH",34,1,58,0)="10.  A label was added to clinical document tab to indicate how many"
^DIC(9.4,93,22,21,"PAH",34,1,59,0)="document headers/titles are returned in the search list."
^DIC(9.4,93,22,21,"PAH",34,1,60,0)="11.  Application events are intercepted to prevent a mouse click or "
^DIC(9.4,93,22,21,"PAH",34,1,61,0)="keyboard press during a broker call.  This prevents an error when "
^DIC(9.4,93,22,21,"PAH",34,1,62,0)="multiple broker calls try to run at the same time."
^DIC(9.4,93,22,21,"PAH",34,1,63,0)="12.  The ESSO site list is maintained on the VistA home site instead of"
^DIC(9.4,93,22,21,"PAH",34,1,64,0)="the local system registry for better security and easier maintenance as"
^DIC(9.4,93,22,21,"PAH",34,1,65,0)="site information changes.  Shortcuts to CAPRI-ESSO on the desktop will"
^DIC(9.4,93,22,21,"PAH",34,1,66,0)="need to be modified to support this change.  Instead of using "
^DIC(9.4,93,22,21,"PAH",34,1,67,0)="""hs=homeserver hp=homeport,"" ""h=homeserver p=homeport"" should be used."
^DIC(9.4,93,22,21,"PAH",34,1,68,0)="13.  Users with a Restricted Patient List on the VistA server can only "
^DIC(9.4,93,22,21,"PAH",34,1,69,0)="pick or add patients on their list.  This was in the previous version of "
^DIC(9.4,93,22,21,"PAH",34,1,70,0)="CAPRI but was not yet activated."
^DIC(9.4,93,22,21,"PAH",34,1,71,0)="14.  When selecting a health summary, the memobox would previously jump "
^DIC(9.4,93,22,21,"PAH",34,1,72,0)="to the bottom requiring the user to scroll up to start at the beginning.  "
^DIC(9.4,93,22,21,"PAH",34,1,73,0)="It now does this automatically."
^DIC(9.4,93,22,21,"PAH",34,1,74,0)="15.  Intermittent error (""cannot modify field"") when adding new patient "
^DIC(9.4,93,22,21,"PAH",34,1,75,0)="has been fixed."
^DIC(9.4,93,22,21,"PAH",34,1,76,0)="16.  The executable was re-named to DVBA_2_7_41.EXE and "
^DIC(9.4,93,22,21,"PAH",34,1,77,0)="DVBA_2_7_41-ESSO.EXE."
^DIC(9.4,93,22,21,"PAH",34,1,78,0)="17.  At close, sliders for the clinical documents tab, health summary "
^DIC(9.4,93,22,21,"PAH",34,1,79,0)="tab, and reports tab are stored in the capri.cfg file so that they will "
^DIC(9.4,93,22,21,"PAH",34,1,80,0)="be in the same location the next time the application is loaded."
^DIC(9.4,93,22,21,"PAH",34,1,81,0)="18.  Limiting by date range functionality for meds and vitals is present "
^DIC(9.4,93,22,21,"PAH",34,1,82,0)="in the option list but will display a ""not in this version"" message.  "
^DIC(9.4,93,22,21,"PAH",34,1,83,0)="This function will be activated in the next release of CAPRI. "
^DIC(9.4,93,22,21,"PAH",34,1,84,0)="19.  Internal version # was updated.  To make CAPRI less annoying to users"
^DIC(9.4,93,22,21,"PAH",34,1,85,0)="while sites are upgrading, the informational message that appears when a"
^DIC(9.4,93,22,21,"PAH",34,1,86,0)="site has not yet loaded the KID was removed.  CAPRI will error during some"
^DIC(9.4,93,22,21,"PAH",34,1,87,0)="non-critical activities if the site hasn't loaded the DVBA*2.7*41 KID,"
^DIC(9.4,93,22,21,"PAH",34,1,88,0)="such as trying to run a remote data view health summary. "
^DIC(9.4,93,22,21,"PAH",34,1,89,0)="20.  A utility was placed on the HELP menu to scan all of the user's"
^DIC(9.4,93,22,21,"PAH",34,1,90,0)="authorized sites and determine if the Broker connection is good or bad.  "
^DIC(9.4,93,22,21,"PAH",34,1,91,0)="Only users with the Filemanager @ sign have access to the option.  It is"
^DIC(9.4,93,22,21,"PAH",34,1,92,0)="disabled for everyone else. "
^DIC(9.4,93,22,21,"PAH",34,1,93,0)="21.  If a user's institution cannot be found in the remote site's"
^DIC(9.4,93,22,21,"PAH",34,1,94,0)="institution file, the warning message will no longer display but they can"
^DIC(9.4,93,22,21,"PAH",34,1,95,0)="manually enter a site location.  If the match is made, it is automatically"
^DIC(9.4,93,22,21,"PAH",34,1,96,0)="entered and the user prevented from changing the field. "
^DIC(9.4,93,22,21,"PAH",34,1,97,0)="22.  A modification was made to the timer controlling demographic info"
^DIC(9.4,93,22,21,"PAH",34,1,98,0)="lookup of patients on the restricted site list.  Previously, the list"
^DIC(9.4,93,22,21,"PAH",34,1,99,0)="would scroll slowly because the pt. demographic lookup broker calls were"
^DIC(9.4,93,22,21,"PAH",34,1,100,0)="happening instantaneously.  There is now a delay and the list scrolls"
^DIC(9.4,93,22,21,"PAH",34,1,101,0)="smoothly with the lookup only happening when the user pauses. "
^DIC(9.4,93,22,21,"PAH",34,1,102,0)="23.  An audit file has been created on the home server to record every"
^DIC(9.4,93,22,21,"PAH",34,1,103,0)="patient a user accesses, which site the user is on, the date/time, and"
^DIC(9.4,93,22,21,"PAH",34,1,104,0)="whether the patient is flagged sensitive.  The audit is active only in "
^DIC(9.4,93,22,21,"PAH",34,1,105,0)="the ESSO version."
^DIC(9.4,93,22,21,"PAH",34,1,106,0)="24. An animation of a spinning disc was placed on the reports tab so that"
^DIC(9.4,93,22,21,"PAH",34,1,107,0)="there is a visual cue the application is still working while a big report"
^DIC(9.4,93,22,21,"PAH",34,1,108,0)="is being generated."
^DIC(9.4,93,22,21,"PAH",34,1,109,0)="25.  There is a dropdown on the health summary tab so the user can "
^DIC(9.4,93,22,21,"PAH",34,1,110,0)="quickly jump to the various parts of the returned summary."
^DIC(9.4,93,22,21,"PAH",34,1,111,0)="26.  If the user kicks off a remote data view query, multiple tabs will "
^DIC(9.4,93,22,21,"PAH",34,1,112,0)="appear on the health summary tab for each site queried."
^DIC(9.4,93,22,21,"PAH",34,1,113,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,114,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,115,0)="DOWNLOAD INSTRUCTIONS"
^DIC(9.4,93,22,21,"PAH",34,1,116,0)="--------------------- "
^DIC(9.4,93,22,21,"PAH",34,1,117,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,118,0)="A new version of the CAPRI GUI/CLIENT software has been made available to"
^DIC(9.4,93,22,21,"PAH",34,1,119,0)="local VHA IRM field sites via FTP.  As of February 2002, the CAPRI GUI "
^DIC(9.4,93,22,21,"PAH",34,1,120,0)="will be available on the OI Field Office ANONYMOUS.SOFTWARE directories as"
^DIC(9.4,93,22,21,"PAH",34,1,121,0)="filename DVBA_2_7_41.EXE, which refers to patch DVBA*2.7*41. Software may"
^DIC(9.4,93,22,21,"PAH",34,1,122,0)="be retrieved using FTP from the appropriate OI Field Office"
^DIC(9.4,93,22,21,"PAH",34,1,123,0)="ANONYMOUS.SOFTWARE directories."
^DIC(9.4,93,22,21,"PAH",34,1,124,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,125,0)="                    Albany             152.127.1.5"
^DIC(9.4,93,22,21,"PAH",34,1,126,0)="                    Hines              127.0.0.11"
^DIC(9.4,93,22,21,"PAH",34,1,127,0)="                    Salt Lake City     152.131.2.1"
^DIC(9.4,93,22,21,"PAH",34,1,128,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,129,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,130,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,131,0)="FILE NAME                  FORMAT         DESCRIPTION"
^DIC(9.4,93,22,21,"PAH",34,1,132,0)="-------------------        ------         -----------"
^DIC(9.4,93,22,21,"PAH",34,1,133,0)="DVBA_2_7_41.EXE            BINARY         CAPRI GUI"
^DIC(9.4,93,22,21,"PAH",34,1,134,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,135,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,136,0)="Installation Process:"
^DIC(9.4,93,22,21,"PAH",34,1,137,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,138,0)="The CAPRI GUI requires that the RPC Broker V1.1 be installed on any PC on"
^DIC(9.4,93,22,21,"PAH",34,1,139,0)="which the GUI will be executed.  If a PC can already connect successfully "
^DIC(9.4,93,22,21,"PAH",34,1,140,0)="via CPRS, BCMA, or PCMM, then the RPC Broker has already been installed."
^DIC(9.4,93,22,21,"PAH",34,1,141,0)="If you need to install the RPC Broker, please refer to the RPC Broker"
^DIC(9.4,93,22,21,"PAH",34,1,142,0)="website (http://vista.domain.ext/broker/download.html) for configuration"
^DIC(9.4,93,22,21,"PAH",34,1,143,0)="information and to download the installation file if you do not already"
^DIC(9.4,93,22,21,"PAH",34,1,144,0)="have it.  "
^DIC(9.4,93,22,21,"PAH",34,1,145,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,146,0)="There are two ways to install CAPRI:"
^DIC(9.4,93,22,21,"PAH",34,1,147,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,148,0)="A.  If you have configured the PC via the serverlist.exe application that"
^DIC(9.4,93,22,21,"PAH",34,1,149,0)="comes with the RPC Broker installation file, the CAPRI GUI can be copied"
^DIC(9.4,93,22,21,"PAH",34,1,150,0)="directly to your Windows desktop.  If you need more information on"
^DIC(9.4,93,22,21,"PAH",34,1,151,0)="serverlist.exe, please refer to the RPC Broker user manual."
^DIC(9.4,93,22,21,"PAH",34,1,152,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,153,0)="B.  If you have only loaded the RPC Broker on the PC but not configured it"
^DIC(9.4,93,22,21,"PAH",34,1,154,0)="using server list, CAPRI will default to BROKERSERVER, port 9200 when"
^DIC(9.4,93,22,21,"PAH",34,1,155,0)="executing the application.  If you wish to default to a different server "
^DIC(9.4,93,22,21,"PAH",34,1,156,0)="and port, use the following instructions:"
^DIC(9.4,93,22,21,"PAH",34,1,157,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,158,0)="1.  Copy CAPRI to a folder on the PC, preferably c:\program files\vista."
^DIC(9.4,93,22,21,"PAH",34,1,159,0)="2.  Create a shortcut on the desktop to CAPRI by right clicking on a blank"
^DIC(9.4,93,22,21,"PAH",34,1,160,0)="region of the desktop and selecting NEW | SHORTCUT.|"
^DIC(9.4,93,22,21,"PAH",34,1,161,0)="      a. When asked for location type the location in which CAPRI GUI has"
^DIC(9.4,93,22,21,"PAH",34,1,162,0)="         been placed on the hard drive along with your local server and"
^DIC(9.4,93,22,21,"PAH",34,1,163,0)="         port information as parameters:"
^DIC(9.4,93,22,21,"PAH",34,1,164,0)="         ""C:\Program"
^DIC(9.4,93,22,21,"PAH",34,1,165,0)="Files\VISTA\dvba_2_7_35_38B.exe""s=vista.yoursitename.domain.ext p=9200  "
^DIC(9.4,93,22,21,"PAH",34,1,166,0)="           (The quotes must be included.)"
^DIC(9.4,93,22,21,"PAH",34,1,167,0)="      b.  Press NEXT."
^DIC(9.4,93,22,21,"PAH",34,1,168,0)="      c.  When asked for name, type:  CAPRI GUI"
^DIC(9.4,93,22,21,"PAH",34,1,169,0)="      d.  Press FINISH."
^DIC(9.4,93,22,21,"PAH",34,1,170,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,171,0)="After creating the icon on the PC:"
^DIC(9.4,93,22,21,"PAH",34,1,172,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,173,0)="Assign  DVBA CAPRI GUI as a secondary option for the user who will be using"
^DIC(9.4,93,22,21,"PAH",34,1,174,0)="the CAPRI GUI client.   This will provide access to the GUI context option"
^DIC(9.4,93,22,21,"PAH",34,1,175,0)="and allow CAPRI to start-up successfully when the user logs-in from the"
^DIC(9.4,93,22,21,"PAH",34,1,176,0)="desktop icon."
^DIC(9.4,93,22,21,"PAH",34,1,177,0)=" "
^DIC(9.4,93,22,21,"PAH",34,1,178,0)="This process is similar to the installation instructions for all other RPC"
^DIC(9.4,93,22,21,"PAH",34,1,179,0)="Broker-enabled applications, such as CPRS, BCMA, and PCMM."
^DIC(9.4,93,22,21,"PAH",35,0)="43 SEQ #42^3020516^1"
^DIC(9.4,93,22,21,"PAH",35,1,0)="^^1^1^3020516"
^DIC(9.4,93,22,21,"PAH",35,1,1,0)="This patch updates three AMIE worksheets."
