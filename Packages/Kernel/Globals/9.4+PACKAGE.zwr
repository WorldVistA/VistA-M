^DIC(9.4,3,0)="KERNEL^XU^SIGN-ON, SECURITY, MENU DRIVER, DEVICES, TASKMAN^"
^DIC(9.4,3,1,0)="^^1^1^2950703^^^^"
^DIC(9.4,3,1,1,0)="This is the basic package containing the KERNEL."
^DIC(9.4,3,5)="SAN FRANCISCO"
^DIC(9.4,3,7)="^^I"
^DIC(9.4,3,11)="^"
^DIC(9.4,3,14,0)="^9.4014^9^9"
