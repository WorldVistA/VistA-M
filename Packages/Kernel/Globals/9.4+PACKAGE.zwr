^DIC(9.4,3,22,21,"PAH",241,1,107,0)=" Incoming Files:"
^DIC(9.4,3,22,21,"PAH",241,1,108,0)="   200      NEW PERSON  (Partial Definition)"
^DIC(9.4,3,22,21,"PAH",241,1,109,0)=" Note:  You already have the 'NEW PERSON' File."
^DIC(9.4,3,22,21,"PAH",241,1,110,0)=""
^DIC(9.4,3,22,21,"PAH",241,1,111,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",241,1,112,0)="                                                       =="
^DIC(9.4,3,22,21,"PAH",241,1,113,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",241,1,114,0)="                                                                       =="
^DIC(9.4,3,22,21,"PAH",241,1,115,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,3,22,21,"PAH",241,1,116,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,3,22,21,"PAH",241,1,117,0)=" Enter a '^' to abort the install."
