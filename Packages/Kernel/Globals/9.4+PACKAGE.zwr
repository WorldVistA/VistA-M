^DIC(9.4,175,22,2,"PAH",134,0)="196^3180403.173751^54"
^DIC(9.4,175,22,2,"PAH",134,1,0)="^^24^24^3180403"
^DIC(9.4,175,22,2,"PAH",134,1,1,0)="VistA Imaging Patch 196 - BackGround Processor (BP)"
^DIC(9.4,175,22,2,"PAH",134,1,2,0)="The development environment used to build this version "
^DIC(9.4,175,22,2,"PAH",134,1,3,0)="of the Background Processor was updated to Delphi XE8"
^DIC(9.4,175,22,2,"PAH",134,1,4,0)="Change to Patch Installation:"
^DIC(9.4,175,22,2,"PAH",134,1,5,0)="With the installation of this Patch 196,  previous versions"
^DIC(9.4,175,22,2,"PAH",134,1,6,0)="of the BP Client GUI will be able to logon to VistA."
^DIC(9.4,175,22,2,"PAH",134,1,7,0)="Fixes : "
^DIC(9.4,175,22,2,"PAH",134,1,8,0)="EVAL Queue count is fixed."
^DIC(9.4,175,22,2,"PAH",134,1,9,0)="The BP has a forced delay between processing Queues.  That delay"
^DIC(9.4,175,22,2,"PAH",134,1,10,0)="has been changed to be selectable."
^DIC(9.4,175,22,2,"PAH",134,1,11,0)="This will enable the BP to process more Queues per minute."
^DIC(9.4,175,22,2,"PAH",134,1,12,0)="GUI enhancements for Resizing of Columns, and positioning"
^DIC(9.4,175,22,2,"PAH",134,1,13,0)="of buttons, and edit boxes on various forms to be visable"
^DIC(9.4,175,22,2,"PAH",134,1,14,0)="at all times."
^DIC(9.4,175,22,2,"PAH",134,1,15,0)="Network Location properties has been fixed.  "
^DIC(9.4,175,22,2,"PAH",134,1,16,0)="Network Locations of type URL can now be edited in the "
^DIC(9.4,175,22,2,"PAH",134,1,17,0)="BP GUI."
^DIC(9.4,175,22,2,"PAH",134,1,18,0)="  "
^DIC(9.4,175,22,2,"PAH",134,1,19,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",134,1,20,0)="Select BUILD NAME: MAG*3.0*196       IMAGING"
^DIC(9.4,175,22,2,"PAH",134,1,21,0)="MAGBRTE4  value = 76402670"
^DIC(9.4,175,22,2,"PAH",134,1,22,0)="MAGIP196  value = 4237416"
^DIC(9.4,175,22,2,"PAH",134,1,23,0)="MAGQBUT4  value = 97374409"
^DIC(9.4,175,22,2,"PAH",134,1,24,0)="done."
