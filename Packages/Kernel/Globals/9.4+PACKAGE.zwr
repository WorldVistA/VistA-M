^DIC(9.4,73,22,9,"PAH",20,1,46,0)="    affected routine(s).  "
^DIC(9.4,73,22,9,"PAH",20,1,47,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,73,22,9,"PAH",20,1,48,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,73,22,9,"PAH",20,1,49,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,73,22,9,"PAH",20,1,50,0)="    Users may be on the system."
^DIC(9.4,73,22,9,"PAH",20,1,51,0)="5.  On the KIDS:Installation menu, use the following options to install"
