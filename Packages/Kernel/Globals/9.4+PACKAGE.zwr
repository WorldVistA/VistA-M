^DIC(9.4,4,22,1,"PAH",52,0)="75 SEQ #76^2990914^1"
^DIC(9.4,4,22,1,"PAH",52,1,0)="^^58^58^2990914"
^DIC(9.4,4,22,1,"PAH",52,1,1,0)="Patch XM*7.1*75"
^DIC(9.4,4,22,1,"PAH",52,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",52,1,3,0)="Test Site:  Montana HCS"
^DIC(9.4,4,22,1,"PAH",52,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",52,1,5,0)="When you read a message at your terminal, every time the screen fills up,"
^DIC(9.4,4,22,1,"PAH",52,1,6,0)="MailMan pauses the display until you press return to continue.  "
^DIC(9.4,4,22,1,"PAH",52,1,7,0)="When you print a message or messages to a terminal, MailMan's behavior does"
^DIC(9.4,4,22,1,"PAH",52,1,8,0)="not make much sense."
^DIC(9.4,4,22,1,"PAH",52,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",52,1,10,0)="This patch establishes what happens when you print to the terminal. "
^DIC(9.4,4,22,1,"PAH",52,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",52,1,12,0)=" A. If you print a message from the ""Message Action: Ignore//"" prompt,"
^DIC(9.4,4,22,1,"PAH",52,1,13,0)="    MailMan will not pause at all."
^DIC(9.4,4,22,1,"PAH",52,1,14,0)=" B. If you print a message or messages from the Classic-mode message list,"
^DIC(9.4,4,22,1,"PAH",52,1,15,0)="    MailMan will not pause at all."
^DIC(9.4,4,22,1,"PAH",52,1,16,0)=" C. If you print a message(s) from the Detailed-mode or Summary-mode,"
^DIC(9.4,4,22,1,"PAH",52,1,17,0)="    Mailman will pause just before giving the message list again."
^DIC(9.4,4,22,1,"PAH",52,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",52,1,19,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",52,1,20,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",52,1,21,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",52,1,22,0)=""
