^DIC(9.4,207,22,1,1,284,0)="Configuration Guide.pdf"
^DIC(9.4,207,22,1,1,285,0)="VBECS Implementation Process.xls"
^DIC(9.4,207,22,1,1,286,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 Installation "
^DIC(9.4,207,22,1,1,287,0)="Guide.doc"
^DIC(9.4,207,22,1,1,288,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 Installation "
^DIC(9.4,207,22,1,1,289,0)="Guide.pdf"
^DIC(9.4,207,22,1,1,290,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 Technical "
^DIC(9.4,207,22,1,1,291,0)="Manual-Security Guide.doc"
^DIC(9.4,207,22,1,1,292,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 Technical "
^DIC(9.4,207,22,1,1,293,0)="Manual-Security Guide.pdf"
^DIC(9.4,207,22,1,1,294,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 User Guide.doc"
^DIC(9.4,207,22,1,1,295,0)="VistA Blood Establishment Computer Software (VBECS) 1.4.0.0 User Guide.pdf"
^DIC(9.4,207,22,1,1,296,0)="Known Defects and Anomalies.doc"
^DIC(9.4,207,22,1,1,297,0)="Known Defects and Anomalies.pdf"
^DIC(9.4,207,22,1,1,298,0)=" "
^DIC(9.4,207,22,1,1,299,0)="INSTALLATION INSTRUCTIONS:"
^DIC(9.4,207,22,1,1,300,0)="=========================="
^DIC(9.4,207,22,1,1,301,0)=" "
^DIC(9.4,207,22,1,1,302,0)=" Pre-Installation Items:"
^DIC(9.4,207,22,1,1,303,0)=" ======================="
^DIC(9.4,207,22,1,1,304,0)=" "
^DIC(9.4,207,22,1,1,305,0)="  Environment Check:"
^DIC(9.4,207,22,1,1,306,0)="  ------------------"
^DIC(9.4,207,22,1,1,307,0)="Programmer access is required to install this patch. Prior to "
^DIC(9.4,207,22,1,1,308,0)="installation, the installer must ensure the DUZ(0) node of the DUZ array "
^DIC(9.4,207,22,1,1,309,0)="is set to the ""@"" symbol."
^DIC(9.4,207,22,1,1,310,0)=" "
^DIC(9.4,207,22,1,1,311,0)="  Users on the System:"
^DIC(9.4,207,22,1,1,312,0)="  --------------------"
^DIC(9.4,207,22,1,1,313,0)="   This patch may be installed with users on the system."
^DIC(9.4,207,22,1,1,314,0)=" "
^DIC(9.4,207,22,1,1,315,0)="  Software Installation Time:"
^DIC(9.4,207,22,1,1,316,0)="  ---------------------------"
^DIC(9.4,207,22,1,1,317,0)="   The estimated installation time for this patch is less than "
^DIC(9.4,207,22,1,1,318,0)="   5 minutes during non-peak hours."
^DIC(9.4,207,22,1,1,319,0)=" "
^DIC(9.4,207,22,1,1,320,0)="  Queuing:"
^DIC(9.4,207,22,1,1,321,0)="  ---------"
^DIC(9.4,207,22,1,1,322,0)="   Note: Patch installation requires responses from the installer and"
^DIC(9.4,207,22,1,1,323,0)="   must not be queued."
^DIC(9.4,207,22,1,1,324,0)=" "
^DIC(9.4,207,22,1,1,325,0)="  Pre-requisites:"
^DIC(9.4,207,22,1,1,326,0)="  ---------------"
^DIC(9.4,207,22,1,1,327,0)="   Patch installer must enter the collection sample types for new Lab"
^DIC(9.4,207,22,1,1,328,0)="   tests created during installation. Obtain sample types from the"
^DIC(9.4,207,22,1,1,329,0)="   Laboratory Information Manager"
^DIC(9.4,207,22,1,1,330,0)=" "
^DIC(9.4,207,22,1,1,331,0)="  Namespace:"
^DIC(9.4,207,22,1,1,332,0)="  ----------"
^DIC(9.4,207,22,1,1,333,0)="   The namespace for the VBECS Application Interfacing Support package is:"
^DIC(9.4,207,22,1,1,334,0)="    Name: VBECS - Prefix: VBEC"
^DIC(9.4,207,22,1,1,335,0)=" "
^DIC(9.4,207,22,1,1,336,0)="  Required Patches:"
^DIC(9.4,207,22,1,1,337,0)="  -----------------"
^DIC(9.4,207,22,1,1,338,0)="   Application                          Patch/Build"
^DIC(9.4,207,22,1,1,339,0)="   -----------------------------        -----------"
^DIC(9.4,207,22,1,1,340,0)="   Laboratory Services                  LR*5.2*187"
^DIC(9.4,207,22,1,1,341,0)="                                        LR*5.2*288"
^DIC(9.4,207,22,1,1,342,0)="                                        LR*5.2*294"
^DIC(9.4,207,22,1,1,343,0)="   Toolkit                              XT*7.3*58"
^DIC(9.4,207,22,1,1,344,0)=" "
^DIC(9.4,207,22,1,1,345,0)="  New File and Global Information:"
^DIC(9.4,207,22,1,1,346,0)="  --------------------------------"
^DIC(9.4,207,22,1,1,347,0)="   There is one new global, ^VBEC.  The ^VBEC global contains the"
^DIC(9.4,207,22,1,1,348,0)="   following new file."
^DIC(9.4,207,22,1,1,349,0)="                                                        Journaling"
^DIC(9.4,207,22,1,1,350,0)="   File #   File Name                   Global Root     Recommended"
^DIC(9.4,207,22,1,1,351,0)="   ------   ------------------------    ------------    -----------"
^DIC(9.4,207,22,1,1,352,0)="   6002.01  VBECS WORKLOAD CAPTURE      ^VBEC(6002.01,  YES"
^DIC(9.4,207,22,1,1,353,0)=" "
^DIC(9.4,207,22,1,1,354,0)="  VBECS Configuration Checklists:"
^DIC(9.4,207,22,1,1,355,0)="  -------------------------------"
^DIC(9.4,207,22,1,1,356,0)="   a. Complete Appendix D: Configuration Checklist of the VistA Blood"
^DIC(9.4,207,22,1,1,357,0)="      Establishment Computer Software (VBECS) Installation Guide."
^DIC(9.4,207,22,1,1,358,0)="   b. Complete Appendix B: Configuration Worksheet of the VBECS "
^DIC(9.4,207,22,1,1,359,0)="      Application Interfacing Support Software Installation and User"
^DIC(9.4,207,22,1,1,360,0)="      Configuration Guide."
^DIC(9.4,207,22,1,1,361,0)=" "
^DIC(9.4,207,22,1,1,362,0)="  Installation Steps:"
^DIC(9.4,207,22,1,1,363,0)="  ==================="
^DIC(9.4,207,22,1,1,364,0)=" "
^DIC(9.4,207,22,1,1,365,0)="The installation of VBECS and its related patches are being handled as a "
^DIC(9.4,207,22,1,1,366,0)="controlled release. The implementation manager will contact you with the "
^DIC(9.4,207,22,1,1,367,0)="location of the KIDS Host Files prior to your scheduled installation "
^DIC(9.4,207,22,1,1,368,0)="date. The documentation files will be available for download in advance "
^DIC(9.4,207,22,1,1,369,0)="of installation through the anonymous download site."
^DIC(9.4,207,22,1,1,370,0)=" "
^DIC(9.4,207,22,1,1,371,0)="   1. Use the 'LOAD A DISTRIBUTION' option (#1) on the 'KIDS INSTALLATION'"
^DIC(9.4,207,22,1,1,372,0)="      menu, and enter: VBECS_BUNDLE_1.KID "
^DIC(9.4,207,22,1,1,373,0)=" "
^DIC(9.4,207,22,1,1,374,0)="   2. From the 'Kernel Installation & Distribution System' menu, select"
^DIC(9.4,207,22,1,1,375,0)="      the Installation menu."
^DIC(9.4,207,22,1,1,376,0)=" "
^DIC(9.4,207,22,1,1,377,0)="   3. From this menu, you may now elect to use the following options (when"
^DIC(9.4,207,22,1,1,378,0)="      prompted for INSTALL NAME, enter  VBECS BUNDLE 1.0)"
^DIC(9.4,207,22,1,1,379,0)=" "
^DIC(9.4,207,22,1,1,380,0)="      a. Backup a Transport Global - This option will create a backup"
^DIC(9.4,207,22,1,1,381,0)="         message of any routines exported with the patch.  It will NOT"
^DIC(9.4,207,22,1,1,382,0)="         backup any changes such as DDs or templates."
^DIC(9.4,207,22,1,1,383,0)=" "
^DIC(9.4,207,22,1,1,384,0)="      b. Compare Transport Global to Current System - This option will"
^DIC(9.4,207,22,1,1,385,0)="         allow you to view all changes that will be made when the patch"
^DIC(9.4,207,22,1,1,386,0)="         is installed.  It compares all components of the patch"
^DIC(9.4,207,22,1,1,387,0)="         (routines, DDs, templates, etc.)."
^DIC(9.4,207,22,1,1,388,0)=" "
^DIC(9.4,207,22,1,1,389,0)="      c. Verify Checksums in Transport Global - This option will allow you"
^DIC(9.4,207,22,1,1,390,0)="         to ensure the integrity of the routines that are in the"
^DIC(9.4,207,22,1,1,391,0)="         transport global."
^DIC(9.4,207,22,1,1,392,0)=" "
^DIC(9.4,207,22,1,1,393,0)="      d. Print Transport Global - this option will allow you to view the"
^DIC(9.4,207,22,1,1,394,0)="         components of the KIDS build."
^DIC(9.4,207,22,1,1,395,0)=" "
^DIC(9.4,207,22,1,1,396,0)="   4. Use the Install Package(s) option and select package"
^DIC(9.4,207,22,1,1,397,0)="      VBECS_BUNDLE_1.KID.  This will automatically install VBEC*1*0"
^DIC(9.4,207,22,1,1,398,0)="      and LR*5.2*325"
^DIC(9.4,207,22,1,1,399,0)=" "
^DIC(9.4,207,22,1,1,400,0)="   5. When prompted ""Enter the Coordinator for Mail Group 'VBECS INTERFACE"
^DIC(9.4,207,22,1,1,401,0)="      ADMIN':"", please enter the name of the individual that will be"
^DIC(9.4,207,22,1,1,402,0)="      responsible for maintaining the new mail group. This mail group"
^DIC(9.4,207,22,1,1,403,0)="      receives notifications when an HL7 transmission, or a query through"
^DIC(9.4,207,22,1,1,404,0)="      the VBECS VistALink client, to the Blood Bank medical device has"
^DIC(9.4,207,22,1,1,405,0)="      failed. The users added to this group would be Lab/Blood Bank"
^DIC(9.4,207,22,1,1,406,0)="      supervisors and/or IRM staff responsible for managing the VBECS"
^DIC(9.4,207,22,1,1,407,0)="      package and interfaces."
^DIC(9.4,207,22,1,1,408,0)=" "
^DIC(9.4,207,22,1,1,409,0)="   6. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,207,22,1,1,410,0)="      Install? NO//', respond Yes."
^DIC(9.4,207,22,1,1,411,0)=" "
^DIC(9.4,207,22,1,1,412,0)="   7. When prompted 'VBECS Server IP Address:', enter the Cluster"
^DIC(9.4,207,22,1,1,413,0)="      IP address from Appendix B: Configuration Worksheet, Hardware"
^DIC(9.4,207,22,1,1,414,0)="      Information, row 1."
^DIC(9.4,207,22,1,1,415,0)=" "
^DIC(9.4,207,22,1,1,416,0)="   8. When prompted 'VBECS VistALink Listener Service Port Number:',"
^DIC(9.4,207,22,1,1,417,0)="      enter the VistALink Listener Service port number from"
^DIC(9.4,207,22,1,1,418,0)="      Appendix B: Configuration Worksheet, Hardware Information, row 2"
^DIC(9.4,207,22,1,1,419,0)="      for installing in the TEST account, row 3 for installing in the"
^DIC(9.4,207,22,1,1,420,0)="      PRODUCTION account."
^DIC(9.4,207,22,1,1,421,0)=" "
^DIC(9.4,207,22,1,1,422,0)="   9. When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,207,22,1,1,423,0)="      No//', it is recommended you answer NO."
^DIC(9.4,207,22,1,1,424,0)=" "
^DIC(9.4,207,22,1,1,425,0)="   8. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,207,22,1,1,426,0)="      and Protocols? No//', respond NO"
^DIC(9.4,207,22,1,1,427,0)=" "
^DIC(9.4,207,22,1,1,428,0)="  11. When prompted by ""Select COLLECTION SAMPLE for Lab Test"
^DIC(9.4,207,22,1,1,429,0)="      ABO/RH - LAB:,"" select the collection sample appropriate for the"
^DIC(9.4,207,22,1,1,430,0)="      ABO/Rh test."
^DIC(9.4,207,22,1,1,431,0)=" "
^DIC(9.4,207,22,1,1,432,0)="  12. When prompted by ""Select COLLECTION SAMPLE for Lab Test ANTIBODY"
^DIC(9.4,207,22,1,1,433,0)="      SCREEN - LAB:,"" select the collection sample appropriate for the"
^DIC(9.4,207,22,1,1,434,0)="      Antibody Screen test."
^DIC(9.4,207,22,1,1,435,0)=" "
^DIC(9.4,207,22,1,1,436,0)="  13. When prompted by ""Select COLLECTION SAMPLE for Lab Test DIRECT"
^DIC(9.4,207,22,1,1,437,0)="      ANTIGLOBULIN TEST - LAB:,"" select the collection sample appropriate"
^DIC(9.4,207,22,1,1,438,0)="      for the Direct Antiglobulin Test test."
^DIC(9.4,207,22,1,1,439,0)=" "
^DIC(9.4,207,22,1,1,440,0)="  14. When prompted by ""Select COLLECTION SAMPLE for Lab Test TRANSFUSION"
^DIC(9.4,207,22,1,1,441,0)="      REACTION WORKUP - LAB:,"" select the collection sample appropriate"
^DIC(9.4,207,22,1,1,442,0)="      for the Transfusion Reaction Workup test."
^DIC(9.4,207,22,1,1,443,0)=" "
^DIC(9.4,207,22,1,1,444,0)="  15. When prompted by ""Select COLLECTION SAMPLE for Lab Test "
^DIC(9.4,207,22,1,1,445,0)="      TYPE & SCREEN - LAB:,"" select the collection sample appropriate for"
^DIC(9.4,207,22,1,1,446,0)="      the Type & Screen test."
^DIC(9.4,207,22,1,1,447,0)=" "
^DIC(9.4,207,22,1,1,448,0)="  16. The POST Installation routine VBECPOST will be deleted from"
^DIC(9.4,207,22,1,1,449,0)="      your system automatically after successful installation."
^DIC(9.4,207,22,1,"PAH",0)="^9.4901^7^7"
^DIC(9.4,207,22,1,"PAH",1,0)="1^3090609.153533^17"
^DIC(9.4,207,22,1,"PAH",1,1,0)="^^158^158^3090609"
^DIC(9.4,207,22,1,"PAH",1,1,1,0)="This patch is being released in support of the VBECS (VistA Blood "
^DIC(9.4,207,22,1,"PAH",1,1,2,0)="Establishment Computer System) Blood Bank Package.  The routines, "
^DIC(9.4,207,22,1,"PAH",1,1,3,0)="protocols, remote procedures, and options in this patch are used by the "
^DIC(9.4,207,22,1,"PAH",1,1,4,0)="DSS (Decision Support System) and CPRS (Computerized Patient Record "
^DIC(9.4,207,22,1,"PAH",1,1,5,0)="System).  There is no direct user interaction with the contents of this "
^DIC(9.4,207,22,1,"PAH",1,1,6,0)="patch."
^DIC(9.4,207,22,1,"PAH",1,1,7,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,8,0)="Routines: VBECDSS"
^DIC(9.4,207,22,1,"PAH",1,1,9,0)="========  VBECHLOR"
^DIC(9.4,207,22,1,"PAH",1,1,10,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,11,0)="Options:  VBECS VISTALINK CONTEXT"
^DIC(9.4,207,22,1,"PAH",1,1,12,0)="========"
^DIC(9.4,207,22,1,"PAH",1,1,13,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,14,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,15,0)="Protocols: VBEC OMG CLIENT"
^DIC(9.4,207,22,1,"PAH",1,1,16,0)="========== "
^DIC(9.4,207,22,1,"PAH",1,1,17,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,18,0)="Remote Procedures: VBEC DSS EXTRACT"
^DIC(9.4,207,22,1,"PAH",1,1,19,0)="=================="
^DIC(9.4,207,22,1,"PAH",1,1,20,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,21,0)=" "
^DIC(9.4,207,22,1,"PAH",1,1,22,0)="Files: VBECS DSS EXTRACT  (# 6002.03)"
^DIC(9.4,207,22,1,"PAH",1,1,23,0)="======"
^DIC(9.4,207,22,1,"PAH",1,1,24,0)=" "
