^DIC(9.4,111,22,1,"PAH",32,0)="38 SEQ #33^2971118^1"
^DIC(9.4,111,22,1,"PAH",32,1,0)="^^1^1^2971118"
^DIC(9.4,111,22,1,"PAH",32,1,1,0)="PCE patch 38 clinical reminders, flag historical encounters."
^DIC(9.4,111,22,1,"PAH",33,0)="40 SEQ #34^2971127^1"
^DIC(9.4,111,22,1,"PAH",33,1,0)="^^3^3^2971127"
^DIC(9.4,111,22,1,"PAH",33,1,1,0)="PCE patch 40, PX*1.0*40, clinical reminders. This patch changes the"
^DIC(9.4,111,22,1,"PAH",33,1,2,0)="behavior of the INACTIVE FLAG so it inactivates the reminder. See the"
^DIC(9.4,111,22,1,"PAH",33,1,3,0)="National Patch Module for a complete description."
^DIC(9.4,111,22,1,"PAH",34,0)="41^2980129^1"
^DIC(9.4,111,22,1,"PAH",34,1,0)="^^3^3^2980129"
^DIC(9.4,111,22,1,"PAH",34,1,1,0)="This build contains a change to two routines.  It will cause the"
^DIC(9.4,111,22,1,"PAH",34,1,2,0)="execution of a Scheduling entry point to run the workload validator.  The"
^DIC(9.4,111,22,1,"PAH",34,1,3,0)="patch is being distributed as part of Scheduling patch SD*5.3*66."
^DIC(9.4,111,22,1,"PAH",35,0)="42 SEQ #36^2980220^1"
^DIC(9.4,111,22,1,"PAH",35,1,0)="^^3^3^2980220"
^DIC(9.4,111,22,1,"PAH",35,1,1,0)="PCE patch 42, PX*1.0*42, clinical reminders. This patch adds a new"
^DIC(9.4,111,22,1,"PAH",35,1,2,0)="Health Summary component PCE CLINICAL REMINDERS SUMMARY, CRS. See the"
^DIC(9.4,111,22,1,"PAH",35,1,3,0)="National Patch Module for a full description."
^DIC(9.4,111,22,1,"PAH",36,0)="44 SEQ #37^2980220^1"
^DIC(9.4,111,22,1,"PAH",36,1,0)="^^2^2^2980220"
^DIC(9.4,111,22,1,"PAH",36,1,1,0)="PCE patch 44, PX*1.0*44, clinical reminders. This patch prevents"
^DIC(9.4,111,22,1,"PAH",36,1,2,0)="""ReMoved"" problems being used by a clinical reminder."
^DIC(9.4,111,22,1,"PAH",37,0)="39^2980227^1"
^DIC(9.4,111,22,1,"PAH",37,1,0)="^^8^8^2980227"
^DIC(9.4,111,22,1,"PAH",37,1,1,0)="This build contains the PCE APIs required by the ACRP Interface Toolkit"
^DIC(9.4,111,22,1,"PAH",37,1,2,0)="(Build SD*5.3*131)."
^DIC(9.4,111,22,1,"PAH",37,1,3,0)=""
^DIC(9.4,111,22,1,"PAH",37,1,4,0)="This build provides ACRP access to procedure, diagnosis and provider"
^DIC(9.4,111,22,1,"PAH",37,1,5,0)="information for an outpatient encounter."
^DIC(9.4,111,22,1,"PAH",37,1,6,0)=""
^DIC(9.4,111,22,1,"PAH",37,1,7,0)="Refer to National Patch Module for more details on patch SD*5.3*131."
^DIC(9.4,111,22,1,"PAH",37,1,8,0)=""
