^DIC(9.4,3,22,21,"PAH",575,0)="769 SEQ #607^3220505.121848^86"
^DIC(9.4,3,22,21,"PAH",575,1,0)="^^29^29^3220505"
^DIC(9.4,3,22,21,"PAH",575,1,1,0)="KERNEL PATCH XU*8*769 -  UPDATE [XUMF FORUM] HL LOGICAL LINK"
^DIC(9.4,3,22,21,"PAH",575,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",575,1,3,0)="This patch updates the DNS DOMAIN field for the [XUMF FORUM] HL"
^DIC(9.4,3,22,21,"PAH",575,1,4,0)=" LOGICAL LINK to be ""HL7.DOMAIN.EXT""."
^DIC(9.4,3,22,21,"PAH",575,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",575,1,6,0)=" FileMan Inquire looks like:"
^DIC(9.4,3,22,21,"PAH",575,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",575,1,8,0)="  Output from what File: OPTION// 870  HL LOGICAL LINK  (165 entries)"
^DIC(9.4,3,22,21,"PAH",575,1,9,0)="  Select HL LOGICAL LINK NODE:    XUMF FORUM"
^DIC(9.4,3,22,21,"PAH",575,1,10,0)="  Another one: "
^DIC(9.4,3,22,21,"PAH",575,1,11,0)="  Standard Captioned Output? Yes// n  (No)"
^DIC(9.4,3,22,21,"PAH",575,1,12,0)="  First Print FIELD: DNS DOMAIN  "
^DIC(9.4,3,22,21,"PAH",575,1,13,0)="  Then Print FIELD: TCP/IP ADDRESS  "
^DIC(9.4,3,22,21,"PAH",575,1,14,0)="  Then Print FIELD: "
^DIC(9.4,3,22,21,"PAH",575,1,15,0)="  Heading (S/C): HL LOGICAL LINK List  Replace "
^DIC(9.4,3,22,21,"PAH",575,1,16,0)="  DEVICE:   TELNET PORT    Right Margin: 80// "
^DIC(9.4,3,22,21,"PAH",575,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",575,1,18,0)="  HL LOGICAL LINK List                            MAR 03, 2022@05:19"
^DIC(9.4,3,22,21,"PAH",575,1,19,0)="  DNS DOMAIN"
^DIC(9.4,3,22,21,"PAH",575,1,20,0)="  TCP/IP ADDRESS"
^DIC(9.4,3,22,21,"PAH",575,1,21,0)="  ------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",575,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",575,1,23,0)="  HL7.DOMAIN.EXT"
^DIC(9.4,3,22,21,"PAH",575,1,24,0)="  127.0.0.14"
^DIC(9.4,3,22,21,"PAH",575,1,25,0)=" "
^DIC(9.4,3,22,21,"PAH",575,1,26,0)=" This patch, at the end of the installation process, also queries the "
^DIC(9.4,3,22,21,"PAH",575,1,27,0)=" Institution Master File (IMF) to get the gold file of istitutions from"
^DIC(9.4,3,22,21,"PAH",575,1,28,0)=" the Forum account, and automatically updates the local INSTITUTION (#4)"
^DIC(9.4,3,22,21,"PAH",575,1,29,0)=" file."
