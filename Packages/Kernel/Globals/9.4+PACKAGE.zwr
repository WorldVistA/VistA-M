^DIC(9.4,85,22,1.5,"PAH",9,1,24,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",9,1,25,0)=" "
