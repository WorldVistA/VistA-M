^DIC(9.4,14,22,5.9,"PAH",157,0)="336 SEQ #255^3050924^1"
^DIC(9.4,14,22,5.9,"PAH",157,1,0)="^^2^2^3050924"
^DIC(9.4,14,22,5.9,"PAH",157,1,1,0)="This patch will up date the LR reference to Person Class codes to conform "
^DIC(9.4,14,22,5.9,"PAH",157,1,2,0)="with the new codes released in XU*8*377."
^DIC(9.4,14,22,5.9,"PAH",158,0)="340 SEQ #256^3050924^1"
^DIC(9.4,14,22,5.9,"PAH",158,1,0)="^^6^6^3050924"
^DIC(9.4,14,22,5.9,"PAH",158,1,1,0)="This patch updates the retrieval of Lab Results to only return verified "
^DIC(9.4,14,22,5.9,"PAH",158,1,2,0)="Results when called on by CPRS via the Orders tap. "
^DIC(9.4,14,22,5.9,"PAH",158,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",158,1,4,0)="This patch removes unused Blood Bank functionality from the routine LR7OR1"
^DIC(9.4,14,22,5.9,"PAH",158,1,5,0)="in support of the VBECS (Vista Blood Establishment Computer Software) "
^DIC(9.4,14,22,5.9,"PAH",158,1,6,0)="Blood Bank Modernization Project."
^DIC(9.4,14,22,5.9,"PAH",159,0)="322 SEQ #257^3051020^1"
^DIC(9.4,14,22,5.9,"PAH",159,1,0)="^^5^5^3051020"
^DIC(9.4,14,22,5.9,"PAH",159,1,1,0)="The three problems addressed in this patch were originally described in"
^DIC(9.4,14,22,5.9,"PAH",159,1,2,0)="the following NOIS calls:"
^DIC(9.4,14,22,5.9,"PAH",159,1,3,0)="DAY-0204-42022 - EN+13~LRUPS undefined variable"
^DIC(9.4,14,22,5.9,"PAH",159,1,4,0)="BHS-0804-11324 - <UNDEFINED>B+2^LRAUDA ERROR"
^DIC(9.4,14,22,5.9,"PAH",159,1,5,0)="LON-0904-61172 - MAJOR SECTION REPORT, BOTH SCROLLING AND PRINTING"
^DIC(9.4,14,22,5.9,"PAH",160,0)="324 SEQ #258^3051020^1"
^DIC(9.4,14,22,5.9,"PAH",160,1,0)="^^1^1^3051020"
^DIC(9.4,14,22,5.9,"PAH",160,1,1,0)="STOP SNOMED CODING OLD AP REPORTS FROM SENDING ALERTS"
^DIC(9.4,14,22,5.9,"PAH",161,0)="339 SEQ #259^3051020^1"
^DIC(9.4,14,22,5.9,"PAH",161,1,0)="^^2^2^3051020"
^DIC(9.4,14,22,5.9,"PAH",161,1,1,0)="THIS IS A PATCH TO A PATCH (324) IT CORRECTS AN UNDEFINDED ERROR. THE "
^DIC(9.4,14,22,5.9,"PAH",161,1,2,0)="PREVIOUS PATCHES ARE NOT REQUIRED SINCE THEY CAUSED ERRORS."
^DIC(9.4,14,22,5.9,"PAH",162,0)="341 SEQ #260^3051020^1"
^DIC(9.4,14,22,5.9,"PAH",162,1,0)="^^2^2^3051020"
^DIC(9.4,14,22,5.9,"PAH",162,1,1,0)="This patch updates routine LRUMD to only include patients in the "
^DIC(9.4,14,22,5.9,"PAH",162,1,2,0)="requested sorting group when printing the data by test list."
^DIC(9.4,14,22,5.9,"PAH",163,0)="347 SEQ #261^3051202^1"
^DIC(9.4,14,22,5.9,"PAH",163,1,0)="^^2^2^3051202"
^DIC(9.4,14,22,5.9,"PAH",163,1,1,0)="This patch corrects a problem with Batch Data Entry where"
^DIC(9.4,14,22,5.9,"PAH",163,1,2,0)="executable code in a delta check is not executed."
^DIC(9.4,14,22,5.9,"PAH",164,0)="348 SEQ #262^3051202^1"
^DIC(9.4,14,22,5.9,"PAH",164,1,0)="^^3^3^3051202"
^DIC(9.4,14,22,5.9,"PAH",164,1,1,0)="THIS CORRECTS A CODE ERROR IN 340, THE STATEMENT WAS IF 'X WHICH ONLY "
^DIC(9.4,14,22,5.9,"PAH",164,1,2,0)="WORKS WHEN X IS NUMERIC. IN THIS CASE IT WAS  ALPHA NUMERIC. THE "
^DIC(9.4,14,22,5.9,"PAH",164,1,3,0)="STATEMENT WAS CHANGED TO IF X="""". X IS EXAMPLE VARIABLE."
^DIC(9.4,14,22,5.9,"PAH",165,0)="344 SEQ #263^3051221^1"
^DIC(9.4,14,22,5.9,"PAH",165,1,0)="^^6^6^3051221"
^DIC(9.4,14,22,5.9,"PAH",165,1,1,0)="This patch corrects problems with the way reference ranges are"
^DIC(9.4,14,22,5.9,"PAH",165,1,2,0)="displayed in search options and in CPRS and also fixes a bug "
^DIC(9.4,14,22,5.9,"PAH",165,1,3,0)="which generates a SYNTAX error in option LRSORA (Search for HI/Lo"
^DIC(9.4,14,22,5.9,"PAH",165,1,4,0)="Values). The patch also fixes a problem with the Microbiology"
^DIC(9.4,14,22,5.9,"PAH",165,1,5,0)="Trend Report where no data is printed when specific locations are"
^DIC(9.4,14,22,5.9,"PAH",165,1,6,0)="selected."
^DIC(9.4,14,22,5.9,"PAH",166,0)="351 SEQ #264^3060410^1"
^DIC(9.4,14,22,5.9,"PAH",166,1,0)="^^3^3^3060410"
^DIC(9.4,14,22,5.9,"PAH",166,1,1,0)="This patch corrects 3 reporting problems:  one with the Critical"
^DIC(9.4,14,22,5.9,"PAH",166,1,2,0)="Value Report, one with Workload Code List Report, and one with"
^DIC(9.4,14,22,5.9,"PAH",166,1,3,0)="the Print List of Non-Draw Orders."
^DIC(9.4,14,22,5.9,"PAH",167,0)="338 SEQ #265^3060410^1"
^DIC(9.4,14,22,5.9,"PAH",167,1,0)="^^2^2^3060410"
^DIC(9.4,14,22,5.9,"PAH",167,1,1,0)="This patch corrects report print problems with Reprint a WARD"
^DIC(9.4,14,22,5.9,"PAH",167,1,2,0)="Collect Order and with Sum of Accessions by Date - AP"
^DIC(9.4,14,22,5.9,"PAH",168,0)="353 SEQ #266^3060410^1"
