^DIC(9.4,84,22,9,0)="3.0^3051119^2971105^1"
^DIC(9.4,84,22,9,1,0)="^^1^1^3051119"
^DIC(9.4,84,22,9,1,1,0)="Drug Accountability/Inventory Interface V. 3.0"
^DIC(9.4,84,22,9,"PAH",0)="^9.4901^62^62"
^DIC(9.4,84,22,9,"PAH",1,0)="6 SEQ #1^2980330^1"
^DIC(9.4,84,22,9,"PAH",1,1,0)="^^21^21^2980330"
^DIC(9.4,84,22,9,"PAH",1,1,1,0)=" The following changes were made to address Y2K compliance issues."
^DIC(9.4,84,22,9,"PAH",1,1,2,0)="  "
^DIC(9.4,84,22,9,"PAH",1,1,3,0)=" Routine   : PSUDP"
^DIC(9.4,84,22,9,"PAH",1,1,4,0)=" Line Tag  : PICKLST+10"
^DIC(9.4,84,22,9,"PAH",1,1,5,0)=" Exception : Setting the node in global ^XTMP(""PSAPV"",0) to DT+1 would not"
^DIC(9.4,84,22,9,"PAH",1,1,6,0)="             be appropriate for dates such as FEB 28th."
^DIC(9.4,84,22,9,"PAH",1,1,7,0)=" Resolution: Changed to a ""C^%DTC"" call which uses FileManager to calculate"
^DIC(9.4,84,22,9,"PAH",1,1,8,0)="             the correct date."
^DIC(9.4,84,22,9,"PAH",1,1,9,0)="  "
^DIC(9.4,84,22,9,"PAH",1,1,10,0)=" Line Tag  : PROCESS+11"
^DIC(9.4,84,22,9,"PAH",1,1,11,0)=" Exception : Flagged to be changed "
^DIC(9.4,84,22,9,"PAH",1,1,12,0)="             $E(PSADT-100-(+$E(PSADT,4,5)=1*8800),1,5)*100"
^DIC(9.4,84,22,9,"PAH",1,1,13,0)=" Resolution: No change necessary, the code is calculating the previous"
^DIC(9.4,84,22,9,"PAH",1,1,14,0)="             month, and all Y@K checks appear to function correctly."
^DIC(9.4,84,22,9,"PAH",1,1,15,0)=" "
^DIC(9.4,84,22,9,"PAH",1,1,16,0)=" Routine   : PSAUP1"
^DIC(9.4,84,22,9,"PAH",1,1,17,0)=" Line Tag  : XTMP+21"
^DIC(9.4,84,22,9,"PAH",1,1,18,0)=" Exception : Use of checking to see if number is >90 does not comply with"
^DIC(9.4,84,22,9,"PAH",1,1,19,0)="             a 70-30 split."
^DIC(9.4,84,22,9,"PAH",1,1,20,0)=" Resolution: Changed to check for date within the recommended 70-30 split."
^DIC(9.4,84,22,9,"PAH",1,1,21,0)=" "
^DIC(9.4,84,22,9,"PAH",2,0)="1 SEQ #2^2980831^1"
^DIC(9.4,84,22,9,"PAH",2,1,0)="^^2^2^2980831"
^DIC(9.4,84,22,9,"PAH",2,1,1,0)=" If an items quantity is adjusted to zero, the system would pick up the"
^DIC(9.4,84,22,9,"PAH",2,1,2,0)=" invoiced quantity instead."
^DIC(9.4,84,22,9,"PAH",3,0)="8 SEQ #3^2980923^1"
^DIC(9.4,84,22,9,"PAH",3,1,0)="^^1^1^2980923"
^DIC(9.4,84,22,9,"PAH",3,1,1,0)="Compliance with MailMan patch XM*7.1*50 and NDF patch PSN*3.18*5"
^DIC(9.4,84,22,9,"PAH",4,0)="11 SEQ #4^2981026^1"
^DIC(9.4,84,22,9,"PAH",4,1,0)="^^1^1^2981026"
^DIC(9.4,84,22,9,"PAH",4,1,1,0)="A variable was mistakenly left out in the programming of patch PSA*3*8."
^DIC(9.4,84,22,9,"PAH",5,0)="3^2990119^1"
^DIC(9.4,84,22,9,"PAH",5,1,0)="^^1^1^2990119"
^DIC(9.4,84,22,9,"PAH",5,1,1,0)="This patch is a combination of patches 3,4,5,7,8,9,10,11,12,13."
^DIC(9.4,84,22,9,"PAH",6,0)="9 SEQ #6^2990119^1"
^DIC(9.4,84,22,9,"PAH",6,1,0)="^^3^3^2990119"
^DIC(9.4,84,22,9,"PAH",6,1,1,0)="This patch creates the PHARMACY PRIME VENDOR mail group. The Prime Vendor"
^DIC(9.4,84,22,9,"PAH",6,1,2,0)="Line Item Report will be sent to this mail group from the Austin"
^DIC(9.4,84,22,9,"PAH",6,1,3,0)="Automation Center twice per week."
^DIC(9.4,84,22,9,"PAH",7,0)="10 SEQ #8^2990223^1"
^DIC(9.4,84,22,9,"PAH",7,1,0)="^^6^6^2990223"
^DIC(9.4,84,22,9,"PAH",7,1,1,0)="When the Receiving Directly into Drug Accountability [PSA RECEIVING]"
^DIC(9.4,84,22,9,"PAH",7,1,2,0)="option is used, the following error occurs:"
^DIC(9.4,84,22,9,"PAH",7,1,3,0)="$ZE= HEADER+3^PSAREPV:3, %DSM-E-UNDEF, undefined variable PSA(2)"
^DIC(9.4,84,22,9,"PAH",7,1,4,0)=" "
^DIC(9.4,84,22,9,"PAH",7,1,5,0)="Also, the problem of not being able to enter decimal digits for the"
^DIC(9.4,84,22,9,"PAH",7,1,6,0)="dispense units per order unit has been corrected."
^DIC(9.4,84,22,9,"PAH",8,0)="12 SEQ #9^2990603^1"
^DIC(9.4,84,22,9,"PAH",8,1,0)="^^85^85^2990603"
^DIC(9.4,84,22,9,"PAH",8,1,1,0)=" 1). When an adjustment is made to the balance of a drug in a pharmacy"
^DIC(9.4,84,22,9,"PAH",8,1,2,0)=" location or invoice, the adjustment activity is recorded, but the"
^DIC(9.4,84,22,9,"PAH",8,1,3,0)=" stored data is not updated. Some Drug Accountability programs make"
^DIC(9.4,84,22,9,"PAH",8,1,4,0)=" the adjustments internally before printing out the drug balances,"
^DIC(9.4,84,22,9,"PAH",8,1,5,0)=" while other programs do not make these necessary calculations. Other"
^DIC(9.4,84,22,9,"PAH",8,1,6,0)=" VISTA packages extract data from the Drug Accountability files on"
^DIC(9.4,84,22,9,"PAH",8,1,7,0)=" a regular basis, by not setting up the programs internally to make the"
^DIC(9.4,84,22,9,"PAH",8,1,8,0)=" calculations for the adjustments, the data they are obtaining is"
^DIC(9.4,84,22,9,"PAH",8,1,9,0)=" incorrect."
^DIC(9.4,84,22,9,"PAH",8,1,10,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,11,0)=" 2). There is a problem with invoices being marked as processed when "
^DIC(9.4,84,22,9,"PAH",8,1,12,0)=" in fact they should not have been marked as such because there are"
^DIC(9.4,84,22,9,"PAH",8,1,13,0)=" data elements missing."
^DIC(9.4,84,22,9,"PAH",8,1,14,0)=" Solution: When the individual line items are being processed the system"
^DIC(9.4,84,22,9,"PAH",8,1,15,0)="           checks the order unit. For a line item to successfully process"
^DIC(9.4,84,22,9,"PAH",8,1,16,0)="           as having an order unit, it must match one of the following 3"
^DIC(9.4,84,22,9,"PAH",8,1,17,0)="           conditions:"
^DIC(9.4,84,22,9,"PAH",8,1,18,0)="            a). The order unit is defined in the initial uploaded item"
^DIC(9.4,84,22,9,"PAH",8,1,19,0)="            b). An adjusted order unit has been entered"
^DIC(9.4,84,22,9,"PAH",8,1,20,0)="            c). The order unit is defined in the synonym multiple in"
^DIC(9.4,84,22,9,"PAH",8,1,21,0)="                the drug file."
^DIC(9.4,84,22,9,"PAH",8,1,22,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,23,0)=" 3). After installing patch #3, if an invoice is being processed that is"
^DIC(9.4,84,22,9,"PAH",8,1,24,0)=" already on file for the same order number, a string too long error"
^DIC(9.4,84,22,9,"PAH",8,1,25,0)=" occurs at INVOICE+17 of routine PSAPROC7. "
^DIC(9.4,84,22,9,"PAH",8,1,26,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,27,0)=" 4). Invoices are passing through the processing and verification portions "
^DIC(9.4,84,22,9,"PAH",8,1,28,0)=" of Drug Accountability with no problem, however, when the system does"
^DIC(9.4,84,22,9,"PAH",8,1,29,0)=" the checking of the data for updating price and drug information, these"
^DIC(9.4,84,22,9,"PAH",8,1,30,0)=" problems are found, and nothing is updated."
^DIC(9.4,84,22,9,"PAH",8,1,31,0)=" Solution: This is in part because of problem #2 above, the order unit."
^DIC(9.4,84,22,9,"PAH",8,1,32,0)="           When the line item's data is being placed into the DRUG "
^DIC(9.4,84,22,9,"PAH",8,1,33,0)="           ACCOUNTABILITY ORDER file (#58.811), the system assigns the"
^DIC(9.4,84,22,9,"PAH",8,1,34,0)="           order unit to be either the value initially entered on the "
^DIC(9.4,84,22,9,"PAH",8,1,35,0)="           invoice, or the value in the synonym multiple, otherwise zero."
^DIC(9.4,84,22,9,"PAH",8,1,36,0)="           No mention of the adjusted order unit. The order of assignment"
^DIC(9.4,84,22,9,"PAH",8,1,37,0)="           should be, synonym multiple, adjusted, then initial upload."
^DIC(9.4,84,22,9,"PAH",8,1,38,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,39,0)=" 5). Several facilities do not have their pharmacy locations defined"
^DIC(9.4,84,22,9,"PAH",8,1,40,0)=" properly in the DRUG ACCOUNTABILITY STATS file (#58.8), which results in"
^DIC(9.4,84,22,9,"PAH",8,1,41,0)=" errors. Usually the error is an undefined variable PSACOMB."
^DIC(9.4,84,22,9,"PAH",8,1,42,0)=" (fixed in routine PSAUTL1)"
^DIC(9.4,84,22,9,"PAH",8,1,43,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,44,0)=" 6). Uploading of incomplete invoiced data is corrected."
^DIC(9.4,84,22,9,"PAH",8,1,45,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,46,0)=" 7). The dispense unit per order unit is no longer asked for on supply"
^DIC(9.4,84,22,9,"PAH",8,1,47,0)=" items."
^DIC(9.4,84,22,9,"PAH",8,1,48,0)=" (PSAVER2 - If the user identifies the drug as supply, then they should "
^DIC(9.4,84,22,9,"PAH",8,1,49,0)=" not be prompted for DUOU. Added a Line of code to check for PSASUPP."
^DIC(9.4,84,22,9,"PAH",8,1,50,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,51,0)=" 8). When the PSA IV ALL LOCATIONS is executed each evening as a background"
^DIC(9.4,84,22,9,"PAH",8,1,52,0)=" job, part of the OP dispensing functionality is to check each ward that"
^DIC(9.4,84,22,9,"PAH",8,1,53,0)=" is associated with the pharmacy location in the DRUG ACCOUNTABILITY STATS"
^DIC(9.4,84,22,9,"PAH",8,1,54,0)=" file (#58.8). Currently the program will discontinue processing if the ward"
^DIC(9.4,84,22,9,"PAH",8,1,55,0)=" doesn't match the pharmacy location, BUT it also quits if the ward"
^DIC(9.4,84,22,9,"PAH",8,1,56,0)=" does match the location. Therefore no OP dispensing data is recorded."
^DIC(9.4,84,22,9,"PAH",8,1,57,0)=" (fixed in routine PSAPSI3)"
^DIC(9.4,84,22,9,"PAH",8,1,58,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,59,0)=" 9). Balances on Controlled Substances are not updated when the orders"
^DIC(9.4,84,22,9,"PAH",8,1,60,0)=" are verified."
^DIC(9.4,84,22,9,"PAH",8,1,61,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,62,0)=" 10). When an invoice is being processed/edited, the order unit field will"
^DIC(9.4,84,22,9,"PAH",8,1,63,0)=" display the order unit associated with the line item based on adjustment,"
^DIC(9.4,84,22,9,"PAH",8,1,64,0)=" invoice's order unit or the order unit in the synonym of the drug file."
^DIC(9.4,84,22,9,"PAH",8,1,65,0)=" When this field is to be edited, the only choices displayed are the "
^DIC(9.4,84,22,9,"PAH",8,1,66,0)=" original invoiced order unit or the drug file entry. If an adjustment"
^DIC(9.4,84,22,9,"PAH",8,1,67,0)=" had been made, the program ignored it. NOIS (HUN-1197-20485)"
^DIC(9.4,84,22,9,"PAH",8,1,68,0)=" (Fixed 13 Jan 99 in routine PSAPROC3)."
^DIC(9.4,84,22,9,"PAH",8,1,69,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,70,0)=" 11). When patch PSA*3*3 was sent out, the second line syntax for the"
^DIC(9.4,84,22,9,"PAH",8,1,71,0)=" routines PSAUDP & PSAUP1 which were released in patch PSA*3*6, was"
^DIC(9.4,84,22,9,"PAH",8,1,72,0)=" erased. These two routines are added to this patch with updated second"
^DIC(9.4,84,22,9,"PAH",8,1,73,0)=" line syntax."
^DIC(9.4,84,22,9,"PAH",8,1,74,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,75,0)=" 12). During the set up of a pharmacy location there was a problem with "
^DIC(9.4,84,22,9,"PAH",8,1,76,0)=" the call to obtain the outpatient pharmacy location. If there was more"
^DIC(9.4,84,22,9,"PAH",8,1,77,0)=" than one location that was spelled similarly the program would take the"
^DIC(9.4,84,22,9,"PAH",8,1,78,0)=" first one as default."
^DIC(9.4,84,22,9,"PAH",8,1,79,0)=" "
^DIC(9.4,84,22,9,"PAH",8,1,80,0)=" 13). When the user is processing invoices, they can actually enter a"
^DIC(9.4,84,22,9,"PAH",8,1,81,0)=" <RETURN> at the select pharmacy location or select master vault prompt."
^DIC(9.4,84,22,9,"PAH",8,1,82,0)=" the system will continue to process normally, but an error will occur"
^DIC(9.4,84,22,9,"PAH",8,1,83,0)=" in SITES+1^PSAUTL1. This value must be entered for proper processing."
^DIC(9.4,84,22,9,"PAH",8,1,84,0)=" The user must now up-arrow out of the selection."
^DIC(9.4,84,22,9,"PAH",8,1,85,0)=" "
^DIC(9.4,84,22,9,"PAH",9,0)="7 SEQ #10^2990622^1"
^DIC(9.4,84,22,9,"PAH",9,1,0)="^^4^4^2990622"
^DIC(9.4,84,22,9,"PAH",9,1,1,0)="When an invoice is selected to be printed, and the invoice is still in"
^DIC(9.4,84,22,9,"PAH",9,1,2,0)="the temporary global used to hold data prior to processing/verification,"
^DIC(9.4,84,22,9,"PAH",9,1,3,0)="the last invoice in the file will be printed, instead of the selected"
^DIC(9.4,84,22,9,"PAH",9,1,4,0)="invoice."
^DIC(9.4,84,22,9,"PAH",10,0)="14 SEQ #11^2990914^1"
^DIC(9.4,84,22,9,"PAH",10,1,0)="^^3^3^2990914"
^DIC(9.4,84,22,9,"PAH",10,1,1,0)="When the Inpatient dispensing data is gathered, the program checked only"
^DIC(9.4,84,22,9,"PAH",10,1,2,0)="one entry for each ward to find a match for a pharmacy location. A loop"
^DIC(9.4,84,22,9,"PAH",10,1,3,0)="has been installed to check for the proper pharmacy location."
^DIC(9.4,84,22,9,"PAH",11,0)="16 SEQ #12^2991210^1"
^DIC(9.4,84,22,9,"PAH",11,1,0)="^^3^3^2991210"
^DIC(9.4,84,22,9,"PAH",11,1,1,0)=" When the Outstanding Credits [PSA OUTSTANDING CREDITS] option is"
^DIC(9.4,84,22,9,"PAH",11,1,2,0)=" executed, and undefined error occurs in routine PSACREDO at line PRINT+17."
^DIC(9.4,84,22,9,"PAH",11,1,3,0)=" The error occurs when all items on a invoice are adjusted to zero."
^DIC(9.4,84,22,9,"PAH",12,0)="17 SEQ #13^2991210^1"
^DIC(9.4,84,22,9,"PAH",12,1,0)="^^5^5^2991210"
^DIC(9.4,84,22,9,"PAH",12,1,1,0)="When the vendor sends the synonym node entry for the invoice's entry in the"
^DIC(9.4,84,22,9,"PAH",12,1,2,0)="DRUG file (#50). A variable was used in the assumption that the vendor"
^DIC(9.4,84,22,9,"PAH",12,1,3,0)="was supplying the facility with the correct information."
^DIC(9.4,84,22,9,"PAH",12,1,4,0)="An error occurs when the program tries to find the matching information"
^DIC(9.4,84,22,9,"PAH",12,1,5,0)="on nodes that do not exist."
^DIC(9.4,84,22,9,"PAH",13,0)="18 SEQ #14^2991210^1"
^DIC(9.4,84,22,9,"PAH",13,1,0)="^^2^2^2991210"
^DIC(9.4,84,22,9,"PAH",13,1,1,0)=" When trying to match items to the National Drug file, the software was"
^DIC(9.4,84,22,9,"PAH",13,1,2,0)=" using old NDF globals. "
^DIC(9.4,84,22,9,"PAH",14,0)="20 SEQ #15^2991210^1"
^DIC(9.4,84,22,9,"PAH",14,1,0)="^^3^3^2991210"
^DIC(9.4,84,22,9,"PAH",14,1,1,0)=" When the user tries to print a report of invoices that were uploaded, "
^DIC(9.4,84,22,9,"PAH",14,1,2,0)=" an undefined error could occur at HAVDEDRG+1 of the PSAUP4 routine if"
^DIC(9.4,84,22,9,"PAH",14,1,3,0)=" the 2 node was missing from the DRUG file (#50)."
^DIC(9.4,84,22,9,"PAH",15,0)="19 SEQ #16^2991210^1"
^DIC(9.4,84,22,9,"PAH",15,1,0)="^^6^6^2991210"
^DIC(9.4,84,22,9,"PAH",15,1,1,0)="  When an invoice is uploaded, the program checks for the UPC and NDC. If"
^DIC(9.4,84,22,9,"PAH",15,1,2,0)=" these fields are not populated, the program exits. A check for the VSN"
^DIC(9.4,84,22,9,"PAH",15,1,3,0)=" was added to enable the program to continue."
^DIC(9.4,84,22,9,"PAH",15,1,4,0)=" "
^DIC(9.4,84,22,9,"PAH",15,1,5,0)="  This will also cause problems in the verify portion. A check has been"
^DIC(9.4,84,22,9,"PAH",15,1,6,0)=" added to one of the verification routines."
^DIC(9.4,84,22,9,"PAH",16,0)="23 SEQ #17^3000125^1"
^DIC(9.4,84,22,9,"PAH",16,1,0)="^^3^3^3000125"
^DIC(9.4,84,22,9,"PAH",16,1,1,0)=" This build contains the correct version of routine PSATI which was"
^DIC(9.4,84,22,9,"PAH",16,1,2,0)=" released in patch PSA*3*18. That patch had test version number five as"
^DIC(9.4,84,22,9,"PAH",16,1,3,0)=" the final version. "
^DIC(9.4,84,22,9,"PAH",17,0)="15 SEQ #18^3000612^1"
^DIC(9.4,84,22,9,"PAH",17,1,0)="^^4^4^3000612"
^DIC(9.4,84,22,9,"PAH",17,1,1,0)="The set-up for device selection will not allow 80 column reports to be"
^DIC(9.4,84,22,9,"PAH",17,1,2,0)="sent to the screen. This causes massive amounts of wasted paper"
^DIC(9.4,84,22,9,"PAH",17,1,3,0)="to obtain information that should be readily available to the user."
^DIC(9.4,84,22,9,"PAH",17,1,4,0)="This patch will allow 80 column reports to be sent to the screen."
^DIC(9.4,84,22,9,"PAH",18,0)="24 SEQ #19^3000824^1"
^DIC(9.4,84,22,9,"PAH",18,1,0)="^^4^4^3000824"
^DIC(9.4,84,22,9,"PAH",18,1,1,0)=" When invoices are added during processing, the DIC call used should be"
^DIC(9.4,84,22,9,"PAH",18,1,2,0)=" a FILE^DICN. Plus the lookup variable is set to look for an exact match."
^DIC(9.4,84,22,9,"PAH",18,1,3,0)=" Order numbers such as ""(B)123244556"" cannot be added to the DRUG "
^DIC(9.4,84,22,9,"PAH",18,1,4,0)=" ACCOUNTABILITY ORDER file (#58.811). This patch corrects the call."
^DIC(9.4,84,22,9,"PAH",19,0)="27 SEQ #20^3000905^1"
^DIC(9.4,84,22,9,"PAH",19,1,0)="^^7^7^3000905"
^DIC(9.4,84,22,9,"PAH",19,1,1,0)="When invoices are added during processing, the DIC call used should be "
^DIC(9.4,84,22,9,"PAH",19,1,2,0)="a FILE^DICN. Plus the lookup variable is set to look for an exact match.  "
^DIC(9.4,84,22,9,"PAH",19,1,3,0)="Order numbers such as ""(B)123244556"" cannot be added to the DRUG "
^DIC(9.4,84,22,9,"PAH",19,1,4,0)="ACCOUNTABILITY ORDER file (#58.811). This patch corrects the call.  "
^DIC(9.4,84,22,9,"PAH",19,1,5,0)=" "
^DIC(9.4,84,22,9,"PAH",19,1,6,0)="The solution to this, as stated in the first line, is to change the DIC"
^DIC(9.4,84,22,9,"PAH",19,1,7,0)="call to a FILE^DICN call.  "
^DIC(9.4,84,22,9,"PAH",20,0)="25 SEQ #21^3010430^1"
^DIC(9.4,84,22,9,"PAH",20,1,0)="^^8^8^3010430"
^DIC(9.4,84,22,9,"PAH",20,1,1,0)=" There is a problem with the routine that is called when a picklist"
^DIC(9.4,84,22,9,"PAH",20,1,2,0)=" is filed away in Unit Dose. The routine improperly processed the incoming"
^DIC(9.4,84,22,9,"PAH",20,1,3,0)=" data. The processing method created incomplete data records of drug"
^DIC(9.4,84,22,9,"PAH",20,1,4,0)=" transactions."
^DIC(9.4,84,22,9,"PAH",20,1,5,0)=" "
^DIC(9.4,84,22,9,"PAH",20,1,6,0)=" To correct this, the program does not rely on a temporary global being"
^DIC(9.4,84,22,9,"PAH",20,1,7,0)=" created. The data is extracted directly from the UNIT DOSE PICK LIST "
^DIC(9.4,84,22,9,"PAH",20,1,8,0)=" STATS (#57.6) file."
^DIC(9.4,84,22,9,"PAH",21,0)="29 SEQ #22^3011106^1"
^DIC(9.4,84,22,9,"PAH",21,1,0)="^^37^37^3011106"
^DIC(9.4,84,22,9,"PAH",21,1,1,0)="1. This patch modifies the Input Transform of the following fields to"
^DIC(9.4,84,22,9,"PAH",21,1,2,0)="   allow three decimal digits:"
^DIC(9.4,84,22,9,"PAH",21,1,3,0)=" "
^DIC(9.4,84,22,9,"PAH",21,1,4,0)=" - STOCK LEVEL field (#2), BALANCE field (#3), REORDER LEVEL field (#4),"
^DIC(9.4,84,22,9,"PAH",21,1,5,0)="   QUANTITY TO REORDER field (#5) and MAXIMUM QUANTITY PER ORDER field"
^DIC(9.4,84,22,9,"PAH",21,1,6,0)="   (#8.5) in the DRUG sub-file (#58.8001) in the DRUG ACCOUNTABILITY"
^DIC(9.4,84,22,9,"PAH",21,1,7,0)="   STATS file(#58.8)."
^DIC(9.4,84,22,9,"PAH",21,1,8,0)=" "
^DIC(9.4,84,22,9,"PAH",21,1,9,0)=" - QUANTITY ORDERED field (#5), QUANTITY DISPENSED field (#19), QUANTITY"
^DIC(9.4,84,22,9,"PAH",21,1,10,0)="   RECEIVED field (#20) and BALANCE field (#22) in the ORDERS sub-file"
^DIC(9.4,84,22,9,"PAH",21,1,11,0)="   (#58.800118) of the DRUG sub-file (#58.8001) in the DRUG"
^DIC(9.4,84,22,9,"PAH",21,1,12,0)="   ACCOUNTABILITY STATS file(#58.8)."
^DIC(9.4,84,22,9,"PAH",21,1,13,0)=" "
^DIC(9.4,84,22,9,"PAH",21,1,14,0)=" - MONTHLY ACTIVITY field (#.01), BEGINNING BALANCE field (#1), ENDING"
^DIC(9.4,84,22,9,"PAH",21,1,15,0)="   BALANCE field (#3), TOTAL RECEIVED field (#5), TOTAL ADJUSTED field"
^DIC(9.4,84,22,9,"PAH",21,1,16,0)="   (#7), TOTAL DISPENSED field (#9), TOTAL RETURN TO STOCK field (#11)"
^DIC(9.4,84,22,9,"PAH",21,1,17,0)="   and TOTAL TURN IN FOR DESTRUCTION field (#12) in the MONTHLY"
^DIC(9.4,84,22,9,"PAH",21,1,18,0)="   ACTIVITY sub-file (#58.801) of the DRUG sub-file (#58.8001) in the"
^DIC(9.4,84,22,9,"PAH",21,1,19,0)="   DRUG ACCOUNTABILITY STATS file (#58.8)."
^DIC(9.4,84,22,9,"PAH",21,1,20,0)=" "
^DIC(9.4,84,22,9,"PAH",21,1,21,0)=" - This patch updates the data dictionary of the QUANTITY field (#5),"
^DIC(9.4,84,22,9,"PAH",21,1,22,0)="   BALANCE FORWARD field (#9), QUANTITY RECEIVED field (#27), QUANTITY RET"
^DIC(9.4,84,22,9,"PAH",21,1,23,0)="   TO STOCK field (#35), QUANTITY TURN IN FOR DESTROY field (#38), BALANCE"
^DIC(9.4,84,22,9,"PAH",21,1,24,0)="   FWD RET/STK field (#41), NEW QUANTITY field (#50), ADJUSTED BY QUANTITY"
^DIC(9.4,84,22,9,"PAH",21,1,25,0)="   field (#51), BAL FWD EDIT VERIFIED ORDER field (#54), ADJUSTMENT"
^DIC(9.4,84,22,9,"PAH",21,1,26,0)="   QUANTITY field (#57), BAL FWD CANCEL VERIFIED ORD field (#59),"
^DIC(9.4,84,22,9,"PAH",21,1,27,0)="   QUANTITY TRANSFERRED field (#70), ORIGINAL COUNT field (#75), WASTED"
^DIC(9.4,84,22,9,"PAH",21,1,28,0)="   QUANTITY field (#76), LIQUID AMOUNT field (#77) and CORRECT COUNT field"
^DIC(9.4,84,22,9,"PAH",21,1,29,0)="   (#79) in the DRUG ACCOUNTABILITY TRANSACTION file (#58.81)."
^DIC(9.4,84,22,9,"PAH",21,1,30,0)=" "
^DIC(9.4,84,22,9,"PAH",21,1,31,0)="2. This patch modifies the data dictionary of the BALANCE FORWARD field"
^DIC(9.4,84,22,9,"PAH",21,1,32,0)="   (#9) in the DRUG ACCOUNTABILITY TRANSACTION file (#58.81), to prevent"
^DIC(9.4,84,22,9,"PAH",21,1,33,0)="   editing through VA FileMan options."
^DIC(9.4,84,22,9,"PAH",21,1,34,0)=" "
^DIC(9.4,84,22,9,"PAH",21,1,35,0)="3. This patch modifies the data dictionary of the the TRANSACTION NUMBER"
^DIC(9.4,84,22,9,"PAH",21,1,36,0)="   field (#.01) in the DRUG ACCOUNTABILITY TRANSACTION file (#58.81), to"
^DIC(9.4,84,22,9,"PAH",21,1,37,0)="   disallow deletion though VA FileMan options."
^DIC(9.4,84,22,9,"PAH",22,0)="21 SEQ #23^3020315^1"
^DIC(9.4,84,22,9,"PAH",22,1,0)="^^82^82^3020315"
^DIC(9.4,84,22,9,"PAH",22,1,1,0)=" 1. This patch modifies the method used to update a drug's NDC and other"
^DIC(9.4,84,22,9,"PAH",22,1,2,0)=" pricing information."
^DIC(9.4,84,22,9,"PAH",22,1,3,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,4,0)=" The revised method of updating the NDC and price information is as"
^DIC(9.4,84,22,9,"PAH",22,1,5,0)=" follows:"
^DIC(9.4,84,22,9,"PAH",22,1,6,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,7,0)=" If the NDC on an invoiced item does not match the NDC field (#31) in"
^DIC(9.4,84,22,9,"PAH",22,1,8,0)=" the DRUG file (#50), then the NDC entry in the DRUG file (#50) will be "
^DIC(9.4,84,22,9,"PAH",22,1,9,0)=" changed to the invoiced NDC."
^DIC(9.4,84,22,9,"PAH",22,1,10,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,11,0)=" If the invoiced item's Order Unit and Dispense Units per Order Unit match"
^DIC(9.4,84,22,9,"PAH",22,1,12,0)=" the same fields in the DRUG file, but the price of the dispense unit has"
^DIC(9.4,84,22,9,"PAH",22,1,13,0)=" changed then the following process occurs:"
^DIC(9.4,84,22,9,"PAH",22,1,14,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,15,0)="  a. The new price per dispense unit is compared with the PRICE PER"
^DIC(9.4,84,22,9,"PAH",22,1,16,0)="     DISPENSE UNIT field (#16) in the DRUG file (#50), to see if it is"
^DIC(9.4,84,22,9,"PAH",22,1,17,0)="     within 5%. If it is not within the 5% difference, the PRICE PER"
^DIC(9.4,84,22,9,"PAH",22,1,18,0)="     DISPENSE UNIT field (#16) in DRUG file (#50) is set to the invoiced "
^DIC(9.4,84,22,9,"PAH",22,1,19,0)="     price per dispense unit, and the PRICE PER ORDER UNIT field (#13)"
^DIC(9.4,84,22,9,"PAH",22,1,20,0)="     in the DRUG file (#50) is set to the invoiced price per order unit."
^DIC(9.4,84,22,9,"PAH",22,1,21,0)=" "
^DIC(9.4,84,22,9,"PAH",22,1,22,0)="  b. A MailMan message is sent to members of a new mail group called:"
^DIC(9.4,84,22,9,"PAH",22,1,23,0)="     'PSA NDC UPDATES' to inform them of the price change. The subject of"
^DIC(9.4,84,22,9,"PAH",22,1,24,0)="     this message is: ""DRUG file Price/NDC Update""."
^DIC(9.4,84,22,9,"PAH",22,1,25,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,26,0)="  c. Because of the problems with price calculations in the past, a post"
^DIC(9.4,84,22,9,"PAH",22,1,27,0)="     patch install routine has been added to correct current incorrect"
^DIC(9.4,84,22,9,"PAH",22,1,28,0)="     prices."
^DIC(9.4,84,22,9,"PAH",22,1,29,0)=" "
^DIC(9.4,84,22,9,"PAH",22,1,30,0)=" 2. When processing invoices, the system checks for the pharmacy locations"
^DIC(9.4,84,22,9,"PAH",22,1,31,0)=" that will be used during processing. If no locations are found the "
^DIC(9.4,84,22,9,"PAH",22,1,32,0)=" program proceeds to exit the option. However, in the exit logic the"
^DIC(9.4,84,22,9,"PAH",22,1,33,0)=" system checks to see if the user has up arrowed or if something has"
^DIC(9.4,84,22,9,"PAH",22,1,34,0)=" failed. If the exit variable has not been set, the program continues on"
^DIC(9.4,84,22,9,"PAH",22,1,35,0)=" to automatically enter the invoice into VISTA."
^DIC(9.4,84,22,9,"PAH",22,1,36,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,37,0)=" 3. Another problem this created was when the user would proceed with manual"
^DIC(9.4,84,22,9,"PAH",22,1,38,0)=" processing of these invoices, the pharmacy location field would be empty."
^DIC(9.4,84,22,9,"PAH",22,1,39,0)=" This creates an undefined global node when the program tried to find the"
^DIC(9.4,84,22,9,"PAH",22,1,40,0)=" location name. If pharmacy locations are not set up, the exit variable"
^DIC(9.4,84,22,9,"PAH",22,1,41,0)=" is not set, therefore the invoices are processed."
^DIC(9.4,84,22,9,"PAH",22,1,42,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,43,0)=" 4. When the Connect Unlinked DRUG/ITEM MASTER file Entries [PSA UNLINKED "
^DIC(9.4,84,22,9,"PAH",22,1,44,0)="    LOOP] option is executed an undefined error occurs. The problem stems"
^DIC(9.4,84,22,9,"PAH",22,1,45,0)="    from the user not selecting a drug to link to. The solution to this"
^DIC(9.4,84,22,9,"PAH",22,1,46,0)="    problem is to change where the routine is called."
^DIC(9.4,84,22,9,"PAH",22,1,47,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,48,0)=" 5. When printing the Verification Error Report if the report is printed to"
^DIC(9.4,84,22,9,"PAH",22,1,49,0)="    the screen or a slave printer it's fine. If the report is queued to a"
^DIC(9.4,84,22,9,"PAH",22,1,50,0)="    printer, none of the data prints out."
^DIC(9.4,84,22,9,"PAH",22,1,51,0)="  "
^DIC(9.4,84,22,9,"PAH",22,1,52,0)=" The problem with this was that the variable saved for the print job was"
^DIC(9.4,84,22,9,"PAH",22,1,53,0)=" a simple variable, not a variable array as it should be."
^DIC(9.4,84,22,9,"PAH",22,1,54,0)=" "
^DIC(9.4,84,22,9,"PAH",22,1,55,0)=" 6. Due to site integration, invoices can sometimes be processed more"
^DIC(9.4,84,22,9,"PAH",22,1,56,0)=" than once. The invoice file is checked during uploading to see if the"
^DIC(9.4,84,22,9,"PAH",22,1,57,0)=" invoice currently exists, but the check is not performed when the user"
^DIC(9.4,84,22,9,"PAH",22,1,58,0)=" processes the information. The solution to this is a check being added"
^DIC(9.4,84,22,9,"PAH",22,1,59,0)=" that will compare the invoice's Order Number, Invoice Number and the"
^DIC(9.4,84,22,9,"PAH",22,1,60,0)=" line items against what is stored in VistA. If a close enough match is "
^DIC(9.4,84,22,9,"PAH",22,1,61,0)=" found, a comparison array of data will be displayed for the user. After"
^DIC(9.4,84,22,9,"PAH",22,1,62,0)=" displaying the data, the user has the option of eliminating the incoming"
^DIC(9.4,84,22,9,"PAH",22,1,63,0)=" invoice."
^DIC(9.4,84,22,9,"PAH",22,1,64,0)=" "
^DIC(9.4,84,22,9,"PAH",22,1,65,0)=" 7. The option Delete Un-processed Invoices [PSA DELETE INVOICES] has been"
^DIC(9.4,84,22,9,"PAH",22,1,66,0)=" created to delete invoices that are on file past a user specified date."
^DIC(9.4,84,22,9,"PAH",22,1,67,0)=" "
^DIC(9.4,84,22,9,"PAH",22,1,68,0)=" 8. When processing invoices, if an item has the same vendor stock number"
^DIC(9.4,84,22,9,"PAH",22,1,69,0)=" but different NDCs, a new synonym entry is created. When the item is"
^DIC(9.4,84,22,9,"PAH",22,1,70,0)=" being processed again, the system will display the same drug as two"
^DIC(9.4,84,22,9,"PAH",22,1,71,0)=" different choices. The problem is, that there is not enough detailed"
^DIC(9.4,84,22,9,"PAH",22,1,72,0)=" information provided for proper selection. The solution to this was to"
^DIC(9.4,84,22,9,"PAH",22,1,73,0)=" add the NDC to the display."
^DIC(9.4,84,22,9,"PAH",22,1,74,0)=" "
^DIC(9.4,84,22,9,"PAH",22,1,75,0)=" 9. When invoices are processed for multiple divisions, or by multiple"
^DIC(9.4,84,22,9,"PAH",22,1,76,0)=" personnel, all invoices show the same person as the processor. This"
^DIC(9.4,84,22,9,"PAH",22,1,77,0)=" was caused by the last function of processing. When the user finishes"
^DIC(9.4,84,22,9,"PAH",22,1,78,0)=" processing, the program would look at each invoice. If the invoice"
^DIC(9.4,84,22,9,"PAH",22,1,79,0)=" was marked as processed, the data would be moved into the proper files."
^DIC(9.4,84,22,9,"PAH",22,1,80,0)=" the program did not distinguish between users. The solution to this is"
^DIC(9.4,84,22,9,"PAH",22,1,81,0)=" to file the data immediately for each invoice as it is marked as"
^DIC(9.4,84,22,9,"PAH",22,1,82,0)=" processed."
^DIC(9.4,84,22,9,"PAH",23,0)="26 SEQ #24^3030715^1"
^DIC(9.4,84,22,9,"PAH",23,1,0)="^^7^7^3030715"
^DIC(9.4,84,22,9,"PAH",23,1,1,0)="This enhancement provides a DELPHI based redesign of the Upload Invoices "
^DIC(9.4,84,22,9,"PAH",23,1,2,0)="process currently in the Drug Accountability/Inventory Interface Version "
^DIC(9.4,84,22,9,"PAH",23,1,3,0)="3.0 software. This option is used to upload invoice data from the Prime "
^DIC(9.4,84,22,9,"PAH",23,1,4,0)="Vendor and update VISTA Drug Accountability files.  The redesigned "
^DIC(9.4,84,22,9,"PAH",23,1,5,0)="function, using DELPHI instead of ProComm script files will make "
^DIC(9.4,84,22,9,"PAH",23,1,6,0)="uploading invoices simpler and faster.  "
^DIC(9.4,84,22,9,"PAH",23,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",24,0)="31 SEQ #25^3031231^1"
^DIC(9.4,84,22,9,"PAH",24,1,0)="^^14^14^3031231"
^DIC(9.4,84,22,9,"PAH",24,1,1,0)=" 1. When sites do not process all uploaded invoices, problems arise when "
^DIC(9.4,84,22,9,"PAH",24,1,2,0)=" the next batch of invoices is uploaded. Drug Accountability attempts to "
^DIC(9.4,84,22,9,"PAH",24,1,3,0)=" match each item with items in the DRUG file (#50). The process will"
^DIC(9.4,84,22,9,"PAH",24,1,4,0)=" continue to add matching data to the item. If the invoices remain on the "
^DIC(9.4,84,22,9,"PAH",24,1,5,0)=" system long enough an error will occur."
^DIC(9.4,84,22,9,"PAH",24,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",24,1,7,0)=" The solution to this is to bypass the matching process on invoice data "
^DIC(9.4,84,22,9,"PAH",24,1,8,0)=" that has already been uploaded.  "
^DIC(9.4,84,22,9,"PAH",24,1,9,0)=" "
^DIC(9.4,84,22,9,"PAH",24,1,10,0)=" 2. Another problem this patch corrects is with the filing of monthly data"
^DIC(9.4,84,22,9,"PAH",24,1,11,0)=" on drug items. Monthly data was incorrectly stored for some items in "
^DIC(9.4,84,22,9,"PAH",24,1,12,0)=" the DRUG ACCOUNTABILITY STATS file (#58.8). This patch corrects already "
^DIC(9.4,84,22,9,"PAH",24,1,13,0)=" affected entries, and restricts the erroneous filing of incorrect data "
^DIC(9.4,84,22,9,"PAH",24,1,14,0)=" in the future."
^DIC(9.4,84,22,9,"PAH",25,0)="33 SEQ #26^3031231^1"
^DIC(9.4,84,22,9,"PAH",26,0)="36 SEQ #27^3040330^1"
^DIC(9.4,84,22,9,"PAH",26,1,0)="^^11^11^3040330"
^DIC(9.4,84,22,9,"PAH",26,1,1,0)="This patch will fix two undefined errors in menu option Edit Verified"
^DIC(9.4,84,22,9,"PAH",26,1,2,0)="Invoices."
^DIC(9.4,84,22,9,"PAH",26,1,3,0)="An undefined error occurs when editing a verified invoice if the user "
^DIC(9.4,84,22,9,"PAH",26,1,4,0)="changes the name of a drug and the order units are different.  This error"
^DIC(9.4,84,22,9,"PAH",26,1,5,0)="occurs when prompting for the Dispense Units per Order Unit."
^DIC(9.4,84,22,9,"PAH",26,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",26,1,7,0)="When the user edits a line item and changes the drug name, the invoiced"
^DIC(9.4,84,22,9,"PAH",26,1,8,0)="quantity is updated in the Drug File (#50); subtracted from the invoiced "
^DIC(9.4,84,22,9,"PAH",26,1,9,0)="item and added to the new item.  If the invoiced line item is not in the"
^DIC(9.4,84,22,9,"PAH",26,1,10,0)="Drug File (#50), an undefined error occurs when trying to subtract the"
^DIC(9.4,84,22,9,"PAH",26,1,11,0)="invoiced quantity."
^DIC(9.4,84,22,9,"PAH",27,0)="41 SEQ #28^3040802^1"
^DIC(9.4,84,22,9,"PAH",27,1,0)="^^3^3^3040802"
^DIC(9.4,84,22,9,"PAH",27,1,1,0)=" This enhancement contains the updated GUI based changes for the Upload"
^DIC(9.4,84,22,9,"PAH",27,1,2,0)=" Invoices process used by Drug Accountability V. 3.0 to process invoice"
^DIC(9.4,84,22,9,"PAH",27,1,3,0)=" data received from the new Prime Vendor, McKesson. "
^DIC(9.4,84,22,9,"PAH",28,0)="38 SEQ #29^3040802^1"
^DIC(9.4,84,22,9,"PAH",28,1,0)="^^2^2^3040802"
^DIC(9.4,84,22,9,"PAH",28,1,1,0)="This patch will modify the Report Potential NDC Matches option to use the "
^DIC(9.4,84,22,9,"PAH",28,1,2,0)="same criteria as the Controlled Connection by NDC Match."
^DIC(9.4,84,22,9,"PAH",29,0)="43 SEQ #30^3040802^1"
^DIC(9.4,84,22,9,"PAH",29,1,0)="^^4^4^3040802"
^DIC(9.4,84,22,9,"PAH",29,1,1,0)="This patch addresses the problem in Drug Accountability where the menu "
^DIC(9.4,84,22,9,"PAH",29,1,2,0)="""Setup/Edit a Pharmacy Location"" [PSA LOCATION EDIT] generates the "
^DIC(9.4,84,22,9,"PAH",29,1,3,0)="following error: $ZERROR=DAVEB+5^PSAENTO:3, %DSM-E-UNDEF, undefined  "
^DIC(9.4,84,22,9,"PAH",29,1,4,0)="variable Y(0,0)."
^DIC(9.4,84,22,9,"PAH",30,0)="39 SEQ #31^3040802^1"
^DIC(9.4,84,22,9,"PAH",30,1,0)="^^4^4^3040802"
^DIC(9.4,84,22,9,"PAH",30,1,1,0)="This patch will modify PSA PROCESS PRIME VENDOR DATA  Process Uploaded "
^DIC(9.4,84,22,9,"PAH",30,1,2,0)="Prime Vendor Invoice Data to always prompt the user when there is a change"
^DIC(9.4,84,22,9,"PAH",30,1,3,0)="in the Vendor Stock Number's NDC.  This is currently happening only if the"
^DIC(9.4,84,22,9,"PAH",30,1,4,0)="current NDC is numeric."
^DIC(9.4,84,22,9,"PAH",31,0)="34 SEQ #32^3040903^1"
^DIC(9.4,84,22,9,"PAH",31,1,0)="^^1^1^3040903"
^DIC(9.4,84,22,9,"PAH",31,1,1,0)="THIS PATCH CORRECTS AN UNDEFINED LOCATION ERROR."
^DIC(9.4,84,22,9,"PAH",32,0)="37 SEQ #33^3040924^1"
^DIC(9.4,84,22,9,"PAH",32,1,0)="^^14^14^3040924"
^DIC(9.4,84,22,9,"PAH",32,1,1,0)=" 1. When sites do not process all uploaded invoices, problems arise when "
^DIC(9.4,84,22,9,"PAH",32,1,2,0)=" the next batch of invoices is uploaded. Drug Accountability attempts to "
^DIC(9.4,84,22,9,"PAH",32,1,3,0)=" match each item with items in the DRUG file (#50). The process will"
^DIC(9.4,84,22,9,"PAH",32,1,4,0)=" continue to add matching data to the item. If the invoices remain on the "
^DIC(9.4,84,22,9,"PAH",32,1,5,0)=" system long enough an error will occur."
^DIC(9.4,84,22,9,"PAH",32,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",32,1,7,0)=" The solution to this is to bypass the matching process on invoice data "
^DIC(9.4,84,22,9,"PAH",32,1,8,0)=" that has already been uploaded.  "
^DIC(9.4,84,22,9,"PAH",32,1,9,0)=" "
^DIC(9.4,84,22,9,"PAH",32,1,10,0)=" 2. Another problem this patch corrects is with the filing of monthly data"
^DIC(9.4,84,22,9,"PAH",32,1,11,0)=" on drug items. Monthly data was incorrectly stored for some items in "
^DIC(9.4,84,22,9,"PAH",32,1,12,0)=" the DRUG ACCOUNTABILITY STATS file (#58.8). This patch corrects already "
^DIC(9.4,84,22,9,"PAH",32,1,13,0)=" affected entries, and restricts the erroneous filing of incorrect data "
^DIC(9.4,84,22,9,"PAH",32,1,14,0)=" in the future."
^DIC(9.4,84,22,9,"PAH",33,0)="48 SEQ #34^3041124^1"
^DIC(9.4,84,22,9,"PAH",33,1,0)="^^9^9^3041124"
^DIC(9.4,84,22,9,"PAH",33,1,1,0)="This patch addresses two problems:"
^DIC(9.4,84,22,9,"PAH",33,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",33,1,3,0)="1.      Uploading on invoices from the new prime vendor has lost the "
^DIC(9.4,84,22,9,"PAH",33,1,4,0)="capability to automatically match invoice items to the drug file entries "
^DIC(9.4,84,22,9,"PAH",33,1,5,0)="and manual editing is necessary on nearly every item on every invoice."
^DIC(9.4,84,22,9,"PAH",33,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",33,1,7,0)="2.      The wrong VSN is shown for the selected item to be edited when "
^DIC(9.4,84,22,9,"PAH",33,1,8,0)="editing verified invoices. The VSN displayed belongs to the last item "
^DIC(9.4,84,22,9,"PAH",33,1,9,0)="presented in the choices for selection display."
^DIC(9.4,84,22,9,"PAH",34,0)="40 SEQ #35^3041228^1"
^DIC(9.4,84,22,9,"PAH",34,1,0)="^^1^1^3041228"
^DIC(9.4,84,22,9,"PAH",34,1,1,0)="INCORRECT QUANTITY ADDED TO DRUG IN DRUG FILE"
^DIC(9.4,84,22,9,"PAH",35,0)="49 SEQ #36^3050401^1"
^DIC(9.4,84,22,9,"PAH",35,1,0)="^^4^4^3050401"
^DIC(9.4,84,22,9,"PAH",35,1,1,0)="This patch will correct a syntax error in routine PSAVERA2."
^DIC(9.4,84,22,9,"PAH",35,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",35,1,3,0)="Multiple options with erroneous outpatient division on "
^DIC(9.4,84,22,9,"PAH",35,1,4,0)="pharmacy locations."
^DIC(9.4,84,22,9,"PAH",36,0)="42 SEQ #37^3050813^1"
^DIC(9.4,84,22,9,"PAH",36,1,0)="^^18^18^3050813"
^DIC(9.4,84,22,9,"PAH",36,1,1,0)="This patch address the following problems:"
^DIC(9.4,84,22,9,"PAH",36,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",36,1,3,0)="1.      68526           Price updates into the Drug file #50 are failing "
^DIC(9.4,84,22,9,"PAH",36,1,4,0)="due to current logic that both order units and dispense units between the "
^DIC(9.4,84,22,9,"PAH",36,1,5,0)="matched drug and the invoice must be equal before updating. Also, the"
^DIC(9.4,84,22,9,"PAH",36,1,6,0)="reporting and/or representation of which drugs are about to have order"
^DIC(9.4,84,22,9,"PAH",36,1,7,0)="units, costs, dispense units, and/or NDCs is hard to read, not concise,"
^DIC(9.4,84,22,9,"PAH",36,1,8,0)="and unwanted changes are being overlooked."
^DIC(9.4,84,22,9,"PAH",36,1,9,0)=" "
^DIC(9.4,84,22,9,"PAH",36,1,10,0)="2.      85690   Drugs that are added to pharmacy locations are initially "
^DIC(9.4,84,22,9,"PAH",36,1,11,0)="setup with a minimum of information and need to be completed manually by "
^DIC(9.4,84,22,9,"PAH",36,1,12,0)="the pharmacy staff. A method of notification is needed to let the "
^DIC(9.4,84,22,9,"PAH",36,1,13,0)="pharmacy staff know which drugs are needing completion."
^DIC(9.4,84,22,9,"PAH",36,1,14,0)=" "
^DIC(9.4,84,22,9,"PAH",36,1,15,0)="3.      68611   Invoice items that have a zero quantity are updating "
^DIC(9.4,84,22,9,"PAH",36,1,16,0)="inventory costing for dispensing. This results in a miss-representation "
^DIC(9.4,84,22,9,"PAH",36,1,17,0)="of costs being presented for statistics and being billed to third party "
^DIC(9.4,84,22,9,"PAH",36,1,18,0)="insurances."
^DIC(9.4,84,22,9,"PAH",37,0)="53 SEQ #38^3051115^1"
^DIC(9.4,84,22,9,"PAH",37,1,0)="^^28^28^3051115"
^DIC(9.4,84,22,9,"PAH",37,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",37,1,2,0)="  "
^DIC(9.4,84,22,9,"PAH",37,1,3,0)="1.      68490   Editing Verified Invoices [PSA EDIT VERIFIED INVOICE]"
^DIC(9.4,84,22,9,"PAH",37,1,4,0)="Saying 'NO"" to processing the edit changes made for DISPENSE UNITS field "
^DIC(9.4,84,22,9,"PAH",37,1,5,0)="(#14.5) and/or DISPENSE UNITS PER ORDER UNIT field (#15) of the Drug file "
^DIC(9.4,84,22,9,"PAH",37,1,6,0)="(#50), does not restore those fields to their previous values."
^DIC(9.4,84,22,9,"PAH",37,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",37,1,8,0)="2.      68779   Editing Verified Invoices [PSA EDIT VERIFIED INVOICE]"
^DIC(9.4,84,22,9,"PAH",37,1,9,0)="A drug that is newly picked and added newly to a pharmacy location in the "
^DIC(9.4,84,22,9,"PAH",37,1,10,0)="DRUG ACCOUNTABILITY STATS file (#58.8) has several of it's indexes "
^DIC(9.4,84,22,9,"PAH",37,1,11,0)="scrambled and the users are not able to select the drug within that "
^DIC(9.4,84,22,9,"PAH",37,1,12,0)="pharmacy location for any further processing purposes. A post init "
^DIC(9.4,84,22,9,"PAH",37,1,13,0)="routine will scan and clean up bad indexes it finds."
^DIC(9.4,84,22,9,"PAH",37,1,14,0)=" "
^DIC(9.4,84,22,9,"PAH",37,1,15,0)="3.      100058 Drug Balances by Location [PSA DISPLAY LOCATION]"
^DIC(9.4,84,22,9,"PAH",37,1,16,0)="The report menu ""Drug Balances by Location"" show entries for inactive "
^DIC(9.4,84,22,9,"PAH",37,1,17,0)="drugs that have a zero quantity. Those items are now not to be shown."
^DIC(9.4,84,22,9,"PAH",37,1,18,0)=" "
^DIC(9.4,84,22,9,"PAH",37,1,19,0)="4.      108683 Verify Invoices [PSA VERIFY INVOICES]"
^DIC(9.4,84,22,9,"PAH",37,1,20,0)="Drugs that are new to a pharmacy location in the DRUG ACCOUNTABILITY "
^DIC(9.4,84,22,9,"PAH",37,1,21,0)="STATS file (#58.8) are needing more data entered to complete their being "
^DIC(9.4,84,22,9,"PAH",37,1,22,0)="setup for processing. Such items as current balance, stock level, and "
^DIC(9.4,84,22,9,"PAH",37,1,23,0)="reorder levels are needed. A separate, individual mail message is "
^DIC(9.4,84,22,9,"PAH",37,1,24,0)="currently sent regarding each drug that is newly added. The volume of "
^DIC(9.4,84,22,9,"PAH",37,1,25,0)="messages is overwhelming."
^DIC(9.4,84,22,9,"PAH",37,1,26,0)=" "
^DIC(9.4,84,22,9,"PAH",37,1,27,0)="A single consolidated mail message by invoice regarding drugs that are "
^DIC(9.4,84,22,9,"PAH",37,1,28,0)="newly added is needed to replace the individual mail messages."
^DIC(9.4,84,22,9,"PAH",38,0)="47 SEQ #39^3060308^1"
^DIC(9.4,84,22,9,"PAH",38,1,0)="^^9^9^3060308"
^DIC(9.4,84,22,9,"PAH",38,1,1,0)="HD68504 Invoices not being able to be up loaded. This patch corrects "
^DIC(9.4,84,22,9,"PAH",38,1,2,0)="problems with the algorithm used to convert invoice files received from "
^DIC(9.4,84,22,9,"PAH",38,1,3,0)="McKesson. The process incorrectly inserts zeros to the transaction set "
^DIC(9.4,84,22,9,"PAH",38,1,4,0)="control number, which caused the length of the number to exceed the "
^DIC(9.4,84,22,9,"PAH",38,1,5,0)="required specification length. An example of the error message is shown "
^DIC(9.4,84,22,9,"PAH",38,1,6,0)="below:"
^DIC(9.4,84,22,9,"PAH",38,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",38,1,8,0)="Control# 0000000000000000000000000033"
^DIC(9.4,84,22,9,"PAH",38,1,9,0)="The ST control# (piece 3) should be 4 to 9 characters in length."
^DIC(9.4,84,22,9,"PAH",39,0)="56 SEQ #40^3060526^1"
^DIC(9.4,84,22,9,"PAH",39,1,0)="^^51^51^3060526"
^DIC(9.4,84,22,9,"PAH",39,1,1,0)="This patch addresses the following problem:"
^DIC(9.4,84,22,9,"PAH",39,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,3,0)="1. HD68257: Drug SYNONYM field (#9) duplicates are being created in the "
^DIC(9.4,84,22,9,"PAH",39,1,4,0)="DRUG file (#50). The process of verifying an invoice that is adding a new "
^DIC(9.4,84,22,9,"PAH",39,1,5,0)="drug synonym to the DRUG file (#50) was found to be adding duplicates in "
^DIC(9.4,84,22,9,"PAH",39,1,6,0)="the same invoice and between invoices that were processed at the same "
^DIC(9.4,84,22,9,"PAH",39,1,7,0)="time. The verification process now insures duplicates are not being "
^DIC(9.4,84,22,9,"PAH",39,1,8,0)="created."
^DIC(9.4,84,22,9,"PAH",39,1,9,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,10,0)="2. HD128777: Pharmacy locations, in the DRUG ACCOUNTABILITY STATS file "
^DIC(9.4,84,22,9,"PAH",39,1,11,0)="#58.8, may have their associated entries in the drug file updated by zero "
^DIC(9.4,84,22,9,"PAH",39,1,12,0)="quantity invoice items if the location is not marked for tracking "
^DIC(9.4,84,22,9,"PAH",39,1,13,0)="inventory or re-order levels."
^DIC(9.4,84,22,9,"PAH",39,1,14,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,15,0)="NOTE: A post init will review the Drug file (#50) and remove all but the "
^DIC(9.4,84,22,9,"PAH",39,1,16,0)="first of identical synonym duplicates from under a drug. A ""PSA*3*56 "
^DIC(9.4,84,22,9,"PAH",39,1,17,0)="Delete Duplicate Drug Synonyms report"" mailman message will be sent to "
^DIC(9.4,84,22,9,"PAH",39,1,18,0)="the person who performs the installation identifying what drug-synonyms "
^DIC(9.4,84,22,9,"PAH",39,1,19,0)="had identical synonyms deleted. It will also indicate if there were none "
^DIC(9.4,84,22,9,"PAH",39,1,20,0)="found to be removed."
^DIC(9.4,84,22,9,"PAH",39,1,21,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,22,0)="EXAMPLE 1)      Duplicate synonyms found and were deleted."
^DIC(9.4,84,22,9,"PAH",39,1,23,0)="Subj: PSA*3*56 Delete Duplicate Drug Synonyms report  [#2019687] "
^DIC(9.4,84,22,9,"PAH",39,1,24,0)="03/17/06@17:11"
^DIC(9.4,84,22,9,"PAH",39,1,25,0)="11 lines"
^DIC(9.4,84,22,9,"PAH",39,1,26,0)="From: PSA*3*56 POST INIT  In 'IN' basket.   Page 1"
^DIC(9.4,84,22,9,"PAH",39,1,27,0)="--------------------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",39,1,28,0)="PSA*3*56 DELETE DUPLICATE SYNONYMS REPORT"
^DIC(9.4,84,22,9,"PAH",39,1,29,0)="The following Drug-Synonyms have had identical synonyms removed from the "
^DIC(9.4,84,22,9,"PAH",39,1,30,0)="drug."
^DIC(9.4,84,22,9,"PAH",39,1,31,0)="Drug Name                       DRG#,SYN#   NDC            VSN"
^DIC(9.4,84,22,9,"PAH",39,1,32,0)="ACETAMINOPHEN, CODEINE 60MG TAB 3994,7      00406-0484-10  2792513"
^DIC(9.4,84,22,9,"PAH",39,1,33,0)="OU: CS        PPOU: $9.60                   DUOU: 1000     PPDU: $.01"
^DIC(9.4,84,22,9,"PAH",39,1,34,0)="ACETAMINOPHEN, CODEINE 60MG TAB 3994,11     00406-0484-10  2792513"
^DIC(9.4,84,22,9,"PAH",39,1,35,0)="OU: BT        PPOU: $9.60                   DUOU: 1000     PPDU: $.01"
^DIC(9.4,84,22,9,"PAH",39,1,36,0)="ACETAMINOPHEN, CODEINE 60MG TAB 3998,7      00406-0484-10  2792513"
^DIC(9.4,84,22,9,"PAH",39,1,37,0)="OU: CS        PPOU: $9.60                   DUOU: 1000     PPDU: $.01"
^DIC(9.4,84,22,9,"PAH",39,1,38,0)="ACETAMINOPHEN, CODEINE 60MG TAB 3998,11     00406-0484-10  2792513"
^DIC(9.4,84,22,9,"PAH",39,1,39,0)="OU: BT        PPOU: $9.60                   DUOU: 1000     PPDU: $.01"
^DIC(9.4,84,22,9,"PAH",39,1,40,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,41,0)="EXAMPLE 2) No duplicate synonyms found and none were deleted."
^DIC(9.4,84,22,9,"PAH",39,1,42,0)="Subj: PSA*3*56 Delete Duplicate Drug Synonyms report  [#2019688] "
^DIC(9.4,84,22,9,"PAH",39,1,43,0)="03/17/06@17:15"
^DIC(9.4,84,22,9,"PAH",39,1,44,0)="3 lines"
^DIC(9.4,84,22,9,"PAH",39,1,45,0)="From: PSA*3*56 POST INIT  In 'IN' basket.   Page 1"
^DIC(9.4,84,22,9,"PAH",39,1,46,0)="--------------------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",39,1,47,0)="PSA*3*56 DELETE DUPLICATE SYNONYMS REPORT"
^DIC(9.4,84,22,9,"PAH",39,1,48,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,49,0)="There were no duplicate drug-synonyms found. No synonyms were removed."
^DIC(9.4,84,22,9,"PAH",39,1,50,0)=" "
^DIC(9.4,84,22,9,"PAH",39,1,51,0)="Enter message action (in IN basket): Ignore//"
^DIC(9.4,84,22,9,"PAH",40,0)="51 SEQ #41^3060711^1"
^DIC(9.4,84,22,9,"PAH",40,1,0)="^^5^5^3060711"
^DIC(9.4,84,22,9,"PAH",40,1,1,0)="This option gives the user the ability to select and store drugs that are"
^DIC(9.4,84,22,9,"PAH",40,1,2,0)="to be returned to the manufacturer."
^DIC(9.4,84,22,9,"PAH",40,1,3,0)=" "
^DIC(9.4,84,22,9,"PAH",40,1,4,0)="The OUTDATED MEDICATIONS option is located within the PHARMACY LOCATION"
^DIC(9.4,84,22,9,"PAH",40,1,5,0)="MAINTENANCE menu and locked with the PSAMGR key."
^DIC(9.4,84,22,9,"PAH",41,0)="50 SEQ #42^3060807^1"
^DIC(9.4,84,22,9,"PAH",41,1,0)="^^21^21^3060807"
^DIC(9.4,84,22,9,"PAH",41,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",41,1,2,0)="   "
^DIC(9.4,84,22,9,"PAH",41,1,3,0)="1. HD 68113 Invoice select prompt (1-0)"
^DIC(9.4,84,22,9,"PAH",41,1,4,0)="The software is not properly detecting when all invoices being worked "
^DIC(9.4,84,22,9,"PAH",41,1,5,0)="with have been processed. It is asking the user to make a selection when "
^DIC(9.4,84,22,9,"PAH",41,1,6,0)="there are no invoices left to select from. The software errors out with "
^DIC(9.4,84,22,9,"PAH",41,1,7,0)="an undefined if the user continues."
^DIC(9.4,84,22,9,"PAH",41,1,8,0)=" "
^DIC(9.4,84,22,9,"PAH",41,1,9,0)="2. HD 93607 A faulty message 'The invoice has not been placed in a "
^DIC(9.4,84,22,9,"PAH",41,1,10,0)="Processed status!' is presented."
^DIC(9.4,84,22,9,"PAH",41,1,11,0)="Processing invoices through a particular path and question sequence will "
^DIC(9.4,84,22,9,"PAH",41,1,12,0)="generate the above message which is wrong as the invoice has just "
^DIC(9.4,84,22,9,"PAH",41,1,13,0)="completed processing necessary to be able to proceed to the verification "
^DIC(9.4,84,22,9,"PAH",41,1,14,0)="stage."
^DIC(9.4,84,22,9,"PAH",41,1,15,0)=" "
^DIC(9.4,84,22,9,"PAH",41,1,16,0)="3. HD 91604 An undefined error occurs when the selection list of invoices "
^DIC(9.4,84,22,9,"PAH",41,1,17,0)="to send on to verification has a missed node in the display numbering "
^DIC(9.4,84,22,9,"PAH",41,1,18,0)="sequence of the invoices. The user is able to put in a range from the "
^DIC(9.4,84,22,9,"PAH",41,1,19,0)="beginning of the list to the last number in the list and the processing "
^DIC(9.4,84,22,9,"PAH",41,1,20,0)="tries to work on all numbers in between. It hits the number of the "
^DIC(9.4,84,22,9,"PAH",41,1,21,0)="missing node and it breaks."
^DIC(9.4,84,22,9,"PAH",42,0)="57 SEQ #43^3060807^1"
^DIC(9.4,84,22,9,"PAH",42,1,0)="^^2^2^3060807"
^DIC(9.4,84,22,9,"PAH",42,1,1,0)="This patch will correct the problem of the Post Verify e-mail"
^DIC(9.4,84,22,9,"PAH",42,1,2,0)="not sent when changes are made to the invoice."
^DIC(9.4,84,22,9,"PAH",43,0)="58 SEQ #44^3061122.225741^1"
^DIC(9.4,84,22,9,"PAH",43,1,0)="^^14^14^3061122"
^DIC(9.4,84,22,9,"PAH",43,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",43,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",43,1,3,0)="1. HD 67762 PSANDF 12 digit NDC"
^DIC(9.4,84,22,9,"PAH",43,1,4,0)="The emerging standard is becoming 11 digits for the National Drug Code "
^DIC(9.4,84,22,9,"PAH",43,1,5,0)="(NDC). The code had previously been set to create/require 12 digits by "
^DIC(9.4,84,22,9,"PAH",43,1,6,0)="adding leading zeros. It is now set to create/require 11 digit NDCs. "
^DIC(9.4,84,22,9,"PAH",43,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",43,1,8,0)="2. HD 68340 Forced selection of unique drug names."
^DIC(9.4,84,22,9,"PAH",43,1,9,0)="The software is completing the selection of a unique drug name without "
^DIC(9.4,84,22,9,"PAH",43,1,10,0)="giving the user the chance to verify the selection. The drug name is "
^DIC(9.4,84,22,9,"PAH",43,1,11,0)="unique and the few characters input by the user is enough to select the "
^DIC(9.4,84,22,9,"PAH",43,1,12,0)="drug. Once the drug is selected it is not easy to navigate the software "
^DIC(9.4,84,22,9,"PAH",43,1,13,0)="to a place where the drug can be reselected if the selection completed by "
^DIC(9.4,84,22,9,"PAH",43,1,14,0)="the software is not what the user wanted."
^DIC(9.4,84,22,9,"PAH",44,0)="54^3061122.230718^1"
^DIC(9.4,84,22,9,"PAH",44,1,0)="^^43^43^3061122"
^DIC(9.4,84,22,9,"PAH",44,1,1,0)="This patch is addressing the following problems:"
^DIC(9.4,84,22,9,"PAH",44,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,3,0)="1. HD 112456 Reinstate the display of vendor item Dispense Units per "
^DIC(9.4,84,22,9,"PAH",44,1,4,0)="Order Unit (DUOU) during processing. PSA*3*48 initiated a temporary plan "
^DIC(9.4,84,22,9,"PAH",44,1,5,0)="to aid sites in starting Drug Accountability by shipping in a side file "
^DIC(9.4,84,22,9,"PAH",44,1,6,0)="from the vendor and display DUOU for matching drugs when possible during "
^DIC(9.4,84,22,9,"PAH",44,1,7,0)="processing. It has been requested that the vendor drug description also "
^DIC(9.4,84,22,9,"PAH",44,1,8,0)="be included to aid in matching items to drugs."
^DIC(9.4,84,22,9,"PAH",44,1,9,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,10,0)="2. HD 118113. The sites have requested that the verification screens also "
^DIC(9.4,84,22,9,"PAH",44,1,11,0)="display the vendor DUOU and drug description."
^DIC(9.4,84,22,9,"PAH",44,1,12,0)="Both processing and verification screens will have the following "
^DIC(9.4,84,22,9,"PAH",44,1,13,0)="information line displayed. The information displayed depends on the "
^DIC(9.4,84,22,9,"PAH",44,1,14,0)="availability of vendor information uploaded."
^DIC(9.4,84,22,9,"PAH",44,1,15,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,16,0)="========================= "
^DIC(9.4,84,22,9,"PAH",44,1,17,0)="SAMPLE OF THE ADDED LINE: "
^DIC(9.4,84,22,9,"PAH",44,1,18,0)="========================= "
^DIC(9.4,84,22,9,"PAH",44,1,19,0)="There are two versions of the display line added."
^DIC(9.4,84,22,9,"PAH",44,1,20,0)="1)      The line if the drug information is available"
^DIC(9.4,84,22,9,"PAH",44,1,21,0)=" PV-Drug-Descrip:    ACETAM? TB #4    ROX RN4X25        PV-DUOU: 100"
^DIC(9.4,84,22,9,"PAH",44,1,22,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,23,0)="2)      The line if the drug information is not available."
^DIC(9.4,84,22,9,"PAH",44,1,24,0)="PV-Drug-Descrip:    Not available. Item is OTC or new after February 2006."
^DIC(9.4,84,22,9,"PAH",44,1,25,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,26,0)="==========================="
^DIC(9.4,84,22,9,"PAH",44,1,27,0)="SAMPLE of modified screen:"
^DIC(9.4,84,22,9,"PAH",44,1,28,0)="==========================="
^DIC(9.4,84,22,9,"PAH",44,1,29,0)="The same line of information is presented in both processing and "
^DIC(9.4,84,22,9,"PAH",44,1,30,0)="verifying screens."
^DIC(9.4,84,22,9,"PAH",44,1,31,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,32,0)="Order#: C563685000  Invoice#: 7246433050  Invoice Date: Sep 07, 2005"
^DIC(9.4,84,22,9,"PAH",44,1,33,0)="-----------------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",44,1,34,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,35,0)="1  ACETAMINOPHEN, CODEINE 60MG TAB (Controlled Substance)"
^DIC(9.4,84,22,9,"PAH",44,1,36,0)="Qty Invoiced: 10                      UPC: 300054802324"
^DIC(9.4,84,22,9,"PAH",44,1,37,0)="Order Unit  : TU                      NDC: 00054-8023-24"
^DIC(9.4,84,22,9,"PAH",44,1,38,0)="Unit Price  : $9.60                   VSN: 1334150"
^DIC(9.4,84,22,9,"PAH",44,1,39,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,40,0)="PV-Drug-Descrip:    ACETAM? TB #4    ROX RN4X25        PV-DUOU: 100"
^DIC(9.4,84,22,9,"PAH",44,1,41,0)=" "
^DIC(9.4,84,22,9,"PAH",44,1,42,0)="Dispense Units: TAB"
^DIC(9.4,84,22,9,"PAH",44,1,43,0)="Dispense Units Per Order Unit: 2000"
^DIC(9.4,84,22,9,"PAH",45,0)="61 SEQ #46^3070627.231257^1"
^DIC(9.4,84,22,9,"PAH",45,1,0)="^^36^36^3070627"
^DIC(9.4,84,22,9,"PAH",45,1,1,0)="Problem HD129689 - Undefined error while processing invoice"
^DIC(9.4,84,22,9,"PAH",45,1,2,0)="--------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",45,1,3,0)="During the processing of an invoice, it is possible to receive"
^DIC(9.4,84,22,9,"PAH",45,1,4,0)="The following message:"
^DIC(9.4,84,22,9,"PAH",45,1,5,0)="Undefined N1+3 DICNO Unable to Process Invoice"
^DIC(9.4,84,22,9,"PAH",45,1,6,0)="This error is caused by the system not properly cleaning up variables"
^DIC(9.4,84,22,9,"PAH",45,1,7,0)="used by the program DICN0."
^DIC(9.4,84,22,9,"PAH",45,1,8,0)=" "
^DIC(9.4,84,22,9,"PAH",45,1,9,0)="Resolution HD129689 - Undefined error while processing invoice"
^DIC(9.4,84,22,9,"PAH",45,1,10,0)="--------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",45,1,11,0)="The program PSAPROC7 will be modified to cleanup the variables prior"
^DIC(9.4,84,22,9,"PAH",45,1,12,0)="to the call to DICN0."
^DIC(9.4,84,22,9,"PAH",45,1,13,0)=" "
^DIC(9.4,84,22,9,"PAH",45,1,14,0)="Problem HD92886 - Leading zero's in supply item description "
^DIC(9.4,84,22,9,"PAH",45,1,15,0)="--------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",45,1,16,0)="If a line item on an invoice is edited to be a supply item and"
^DIC(9.4,84,22,9,"PAH",45,1,17,0)="the supply item description starts with a numeric (Example: 16"
^DIC(9.4,84,22,9,"PAH",45,1,18,0)="vial dram, or 10x10 sponge) the system interprets the leading"
^DIC(9.4,84,22,9,"PAH",45,1,19,0)="numeric's as an internal entry number to the Drug File.  This"
^DIC(9.4,84,22,9,"PAH",45,1,20,0)="will cause the software to erroneously select the wrong drug."
^DIC(9.4,84,22,9,"PAH",45,1,21,0)=" "
^DIC(9.4,84,22,9,"PAH",45,1,22,0)="Resolution HD92886 - Leading zero's in supply item description"
^DIC(9.4,84,22,9,"PAH",45,1,23,0)="--------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",45,1,24,0)="The code has been modified to ignore the fact that the supply"
^DIC(9.4,84,22,9,"PAH",45,1,25,0)="item description starts with a leading numeric."
^DIC(9.4,84,22,9,"PAH",45,1,26,0)=" "
^DIC(9.4,84,22,9,"PAH",45,1,27,0)="Problem HD68635 - Undefined error while editing invoices"
^DIC(9.4,84,22,9,"PAH",45,1,28,0)="--------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",45,1,29,0)="In rare cases, the UPC and/or the NDC code in an invoice has"
^DIC(9.4,84,22,9,"PAH",45,1,30,0)="no value.  If this is the case, the software will error out"
^DIC(9.4,84,22,9,"PAH",45,1,31,0)="with an undefined error while editing an invoice to be verified."
^DIC(9.4,84,22,9,"PAH",45,1,32,0)=" "
^DIC(9.4,84,22,9,"PAH",45,1,33,0)="Resolution HD68635 - Undefined error while editing invoices"
^DIC(9.4,84,22,9,"PAH",45,1,34,0)="--------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",45,1,35,0)="The code in question will be strengthened to not error out when"
^DIC(9.4,84,22,9,"PAH",45,1,36,0)="this scenario occurs."
^DIC(9.4,84,22,9,"PAH",46,0)="60 SEQ #47^3070904.224517^1"
^DIC(9.4,84,22,9,"PAH",46,1,0)="^^33^33^3070904"
^DIC(9.4,84,22,9,"PAH",46,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",46,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",46,1,3,0)="1.  67941  PSAPROC1   undefined in PSAPROC1"
^DIC(9.4,84,22,9,"PAH",46,1,4,0)="If a Controlled Substance (CS) drug has not been assigned to a master "
^DIC(9.4,84,22,9,"PAH",46,1,5,0)="vault, the  subsequent code path  is killing variables it will be needing "
^DIC(9.4,84,22,9,"PAH",46,1,6,0)="later when it returns from the call to perform vault selection."
^DIC(9.4,84,22,9,"PAH",46,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",46,1,8,0)="2.  68039  PSAPROC3   default date"
^DIC(9.4,84,22,9,"PAH",46,1,9,0)="The data element in invoices that represents the receive date, under "
^DIC(9.4,84,22,9,"PAH",46,1,10,0)="terms of the McKesson contract, is the date they deposit the invoice into "
^DIC(9.4,84,22,9,"PAH",46,1,11,0)="their output directories for sites to access. The default date in VistA "
^DIC(9.4,84,22,9,"PAH",46,1,12,0)="DA terms had been and is, the received at site date. Management has"
^DIC(9.4,84,22,9,"PAH",46,1,13,0)="determined it is best to require the users to manually enter the receive "
^DIC(9.4,84,22,9,"PAH",46,1,14,0)="date than to present a default date which is never correct and should not "
^DIC(9.4,84,22,9,"PAH",46,1,15,0)="be accepted."
^DIC(9.4,84,22,9,"PAH",46,1,16,0)=" "
^DIC(9.4,84,22,9,"PAH",46,1,17,0)="3.  68532  PSADRUGP   <UNDEFINED>DISP~PSADRUGP"
^DIC(9.4,84,22,9,"PAH",46,1,18,0)="The ""Enter/Edit a Drug"" [PSA PV DRUG ENTER/EDIT] errors when the drugs"
^DIC(9.4,84,22,9,"PAH",46,1,19,0)="inactivation date is less then the day of the data entry."
^DIC(9.4,84,22,9,"PAH",46,1,20,0)=" "
^DIC(9.4,84,22,9,"PAH",46,1,21,0)="4. 131384  PSAVER2   Error using Verify Invoice [PSA VERIFY INVOICES] "
^DIC(9.4,84,22,9,"PAH",46,1,22,0)="When verifying invoices, the application errors if the data in the"
^DIC(9.4,84,22,9,"PAH",46,1,23,0)="processed invoice contains a semicolon. "
^DIC(9.4,84,22,9,"PAH",46,1,24,0)=" "
^DIC(9.4,84,22,9,"PAH",46,1,25,0)="5. 134108  PSAVER, PSAVER1, PSAVER4      Invoice approved twice"
^DIC(9.4,84,22,9,"PAH",46,1,26,0)="During Invoice Verification, multiple users are aloud to select the same"
^DIC(9.4,84,22,9,"PAH",46,1,27,0)="invoice and verify it.  The quantities in the DRUG file (#50) are updated "
^DIC(9.4,84,22,9,"PAH",46,1,28,0)="each time the invoice is verified."
^DIC(9.4,84,22,9,"PAH",46,1,29,0)=" "
^DIC(9.4,84,22,9,"PAH",46,1,30,0)="6.   154985     PSAVER1    Invoice not verified, but message appears"
^DIC(9.4,84,22,9,"PAH",46,1,31,0)="Invoices are being marked as verified at the line item level when using "
^DIC(9.4,84,22,9,"PAH",46,1,32,0)="the Verify Invoices [PSA VERIFY INVOICES] option and selecting an"
^DIC(9.4,84,22,9,"PAH",46,1,33,0)="invoice from the <<< EDIT INVOICES TO BE VERIFIED SCREEN >>>"
^DIC(9.4,84,22,9,"PAH",47,0)="64 SEQ #48^3070905.011213^1"
^DIC(9.4,84,22,9,"PAH",47,1,0)="^^13^13^3070905"
^DIC(9.4,84,22,9,"PAH",47,1,1,0)="With the deployment of Cache version 5, it was discovered that the short"
^DIC(9.4,84,22,9,"PAH",47,1,2,0)="lock timeout values could generate a lock failure. Patch DI*22*147, which"
^DIC(9.4,84,22,9,"PAH",47,1,3,0)="has already been released, provided a solution to resolve this issue and"
^DIC(9.4,84,22,9,"PAH",47,1,4,0)="future lock issues."
^DIC(9.4,84,22,9,"PAH",47,1,5,0)=" "
^DIC(9.4,84,22,9,"PAH",47,1,6,0)="This patch instituted a new default lock timeout of three seconds based on"
^DIC(9.4,84,22,9,"PAH",47,1,7,0)="a global node setting of ^DD(""DILOCKTM"")=3."
^DIC(9.4,84,22,9,"PAH",47,1,8,0)=" "
^DIC(9.4,84,22,9,"PAH",47,1,9,0)="In order to avoid the lock issue in Drug Accountability, this patch"
^DIC(9.4,84,22,9,"PAH",47,1,10,0)="modifies all routines that currently use a lock timeout value of less than"
^DIC(9.4,84,22,9,"PAH",47,1,11,0)="3 seconds to check for the node ^DD(""DILOCKTM"") and to use the value"
^DIC(9.4,84,22,9,"PAH",47,1,12,0)="defined there, otherwise the lock timeout value is set to a default value"
^DIC(9.4,84,22,9,"PAH",47,1,13,0)="of 3 seconds."
^DIC(9.4,84,22,9,"PAH",48,0)="65 SEQ #49^3070905.013701^1"
^DIC(9.4,84,22,9,"PAH",48,1,0)="^^15^15^3070905"
^DIC(9.4,84,22,9,"PAH",48,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",48,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",48,1,3,0)="1.  186350   DA INVOICES UNKNOW STATUS"
^DIC(9.4,84,22,9,"PAH",48,1,4,0)=".There are two separate issues "
^DIC(9.4,84,22,9,"PAH",48,1,5,0)="  a. The invoice status remains LOCKED VERIFYING when there are errors"
^DIC(9.4,84,22,9,"PAH",48,1,6,0)="     in the invoice.  This LOCKED VERIFYING status does not allow any"
^DIC(9.4,84,22,9,"PAH",48,1,7,0)="     further action until the invoice status has been reset to PROCESSED"
^DIC(9.4,84,22,9,"PAH",48,1,8,0)="     or VERIFIED."
^DIC(9.4,84,22,9,"PAH",48,1,9,0)="  b. When an invoice is in a LOCKED VERIFYING status, the Print Orders"
^DIC(9.4,84,22,9,"PAH",48,1,10,0)="     report shows the status as UNKNOWN."
^DIC(9.4,84,22,9,"PAH",48,1,11,0)=" "
^DIC(9.4,84,22,9,"PAH",48,1,12,0)="2.  187185   Can only verify one invoice at a time after PSA*3*60"
^DIC(9.4,84,22,9,"PAH",48,1,13,0)=" When using the EDIT INVOICES TO BE VERIFIED SCREEN and the user selects"
^DIC(9.4,84,22,9,"PAH",48,1,14,0)=" multiple invoices to edit, the application quits after editing the first"
^DIC(9.4,84,22,9,"PAH",48,1,15,0)=" invoice."
^DIC(9.4,84,22,9,"PAH",49,0)="63 SEQ #50^3080526.151713^1"
^DIC(9.4,84,22,9,"PAH",49,1,0)="^^28^28^3080526"
^DIC(9.4,84,22,9,"PAH",49,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",49,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",49,1,3,0)="1.  68175  PSAENTO    Time Out Issue"
^DIC(9.4,84,22,9,"PAH",49,1,4,0)="User reported that the ""Set Up/Edit a Pharmacy Location"" [PSALOCATION "
^DIC(9.4,84,22,9,"PAH",49,1,5,0)="EDIT] option does not quit properly when the application times out at"
^DIC(9.4,84,22,9,"PAH",49,1,6,0)="the INPATIENT SITE NAME prompt."
^DIC(9.4,84,22,9,"PAH",49,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",49,1,8,0)="2.  98252  PSAVERA    Daily Activity Log does not record change on CS "
^DIC(9.4,84,22,9,"PAH",49,1,9,0)="invoice "
^DIC(9.4,84,22,9,"PAH",49,1,10,0)="When using the ""Edit Verified Invoices"" [PSA EDIT VERIFIED INVOICE] "
^DIC(9.4,84,22,9,"PAH",49,1,11,0)="option, the application does not remove the correct quantity which"
^DIC(9.4,84,22,9,"PAH",49,1,12,0)="results in inaccurate quantities being recorded. "
^DIC(9.4,84,22,9,"PAH",49,1,13,0)=" "
^DIC(9.4,84,22,9,"PAH",49,1,14,0)="3. 119930  PSAPROC4   Multiple NDC match selection needs DUOU displayed"
^DIC(9.4,84,22,9,"PAH",49,1,15,0)="When using the ""Process Uploaded Prime Vendor Invoice Data"" [PSA PROCESS "
^DIC(9.4,84,22,9,"PAH",49,1,16,0)="PRIME VENDOR DATA] option, the user is presented a list of drugs and "
^DIC(9.4,84,22,9,"PAH",49,1,17,0)="related information if there is multiple synonyms exist. Currently the "
^DIC(9.4,84,22,9,"PAH",49,1,18,0)="Dose Unit Order Unit (DUOU) is not displayed in that information.  The "
^DIC(9.4,84,22,9,"PAH",49,1,19,0)="lack of this informationcan result in the wrong drug being selected "
^DIC(9.4,84,22,9,"PAH",49,1,20,0)="during invoice processing."
^DIC(9.4,84,22,9,"PAH",49,1,21,0)=" "
^DIC(9.4,84,22,9,"PAH",49,1,22,0)="4. 191994  PSAVERA   Duplicate receipt issue"
^DIC(9.4,84,22,9,"PAH",49,1,23,0)="When using the Edit Verified Invoices [PSA EDIT VERIFIED INVOICE] option "
^DIC(9.4,84,22,9,"PAH",49,1,24,0)="to edit an invoice that has not been verified, the DRUG ACCOUNTABILITY"
^DIC(9.4,84,22,9,"PAH",49,1,25,0)="TRANSACTION file (#58.81) is updated.  Then when the user verifies the "
^DIC(9.4,84,22,9,"PAH",49,1,26,0)="invoice the DRUG ACCOUNTABILITY TRANSACTION file (#58.81) is updated "
^DIC(9.4,84,22,9,"PAH",49,1,27,0)="again causing duplicate transactions for the invoice item(s) that the "
^DIC(9.4,84,22,9,"PAH",49,1,28,0)="edit was done on."
^DIC(9.4,84,22,9,"PAH",50,0)="67 SEQ #51^3080526.161312^1"
^DIC(9.4,84,22,9,"PAH",50,1,0)="^^37^37^3080526"
^DIC(9.4,84,22,9,"PAH",50,1,1,0)="This patch modifies the screens within the processing and verification"
^DIC(9.4,84,22,9,"PAH",50,1,2,0)="processes within Drug Accountability. Additional drug information is"
^DIC(9.4,84,22,9,"PAH",50,1,3,0)="now being included in the invoice files received from the prime vendor."
^DIC(9.4,84,22,9,"PAH",50,1,4,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,5,0)="The additional fields are:"
^DIC(9.4,84,22,9,"PAH",50,1,6,0)=" Generic Description"
^DIC(9.4,84,22,9,"PAH",50,1,7,0)=" Item Description"
^DIC(9.4,84,22,9,"PAH",50,1,8,0)=" Prime Vendor Units (i.e. # bottles in sell unit)"
^DIC(9.4,84,22,9,"PAH",50,1,9,0)=" Inner Pack   (i.e. # pills in bottle)"
^DIC(9.4,84,22,9,"PAH",50,1,10,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,11,0)="Currently, the Item Description and the inner pack fields are stored in"
^DIC(9.4,84,22,9,"PAH",50,1,12,0)="a temporary global which was setup in patch PSA*3*54. This global is no"
^DIC(9.4,84,22,9,"PAH",50,1,13,0)="longer used. The addition of the four fields is intended to assist the"
^DIC(9.4,84,22,9,"PAH",50,1,14,0)="user with the matching of incoming invoice items to the Drug (#50) file."
^DIC(9.4,84,22,9,"PAH",50,1,15,0)="Below is an example of what the screens look like prior to installation"
^DIC(9.4,84,22,9,"PAH",50,1,16,0)="of this patch."
^DIC(9.4,84,22,9,"PAH",50,1,17,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,18,0)="                       <<< PROCESS LINE ITEM SCREEN >>>"
^DIC(9.4,84,22,9,"PAH",50,1,19,0)="Order#: 3TC01  Invoice#: 7289249573  Invoice Date: Oct 05, 2007"
^DIC(9.4,84,22,9,"PAH",50,1,20,0)="6  HYDROCORTISONE"
^DIC(9.4,84,22,9,"PAH",50,1,21,0)="Qty Invoiced: 1                       UPC: 30472034356"
^DIC(9.4,84,22,9,"PAH",50,1,22,0)="Order Unit  : EA                      NDC: 00472-0343-56"
^DIC(9.4,84,22,9,"PAH",50,1,23,0)="Unit Price  : $0.67                   VSN: 1279124"
^DIC(9.4,84,22,9,"PAH",50,1,24,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,25,0)="PV-Drug-Descrip: HYDROCORT AC CRM 1%  ALP 30GM@  PV-DUOU: 28.4"
^DIC(9.4,84,22,9,"PAH",50,1,26,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,27,0)="After patch installation:"
^DIC(9.4,84,22,9,"PAH",50,1,28,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,29,0)="                       <<< PROCESS LINE ITEM SCREEN >>>"
^DIC(9.4,84,22,9,"PAH",50,1,30,0)="Order#: 3TC01  Invoice#: 7289249573  Invoice Date: Oct 05, 2007"
^DIC(9.4,84,22,9,"PAH",50,1,31,0)="6  HYDROCORTISONE"
^DIC(9.4,84,22,9,"PAH",50,1,32,0)="Qty Invoiced: 1                       UPC: 30472034356"
^DIC(9.4,84,22,9,"PAH",50,1,33,0)="Order Unit  : EA                      NDC: 00472-0343-56"
^DIC(9.4,84,22,9,"PAH",50,1,34,0)="Unit Price  : $0.67                   VSN: 1279124"
^DIC(9.4,84,22,9,"PAH",50,1,35,0)=" "
^DIC(9.4,84,22,9,"PAH",50,1,36,0)="PV-Drug-Description  : HYDROCORT AC CRM 1%  ALP 30GM@  PV-DUOU : 28.4"
^DIC(9.4,84,22,9,"PAH",50,1,37,0)="PV-Drug-Generic Name : HYDROCORTISONE                  PV-Units: 1"
^DIC(9.4,84,22,9,"PAH",51,0)="66 SEQ #52^3080722.075114^1"
^DIC(9.4,84,22,9,"PAH",51,1,0)="^^8^8^3080722"
^DIC(9.4,84,22,9,"PAH",51,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",51,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",51,1,3,0)="1. 167457  Non CS drugs appear on narcotic dispensing/receiving report"
^DIC(9.4,84,22,9,"PAH",51,1,4,0)="The PSA IV ALL LOCATIONS [PSA IV ALL LOCATIONS] background job colliding"
^DIC(9.4,84,22,9,"PAH",51,1,5,0)="with CS dispensing."
^DIC(9.4,84,22,9,"PAH",51,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",51,1,7,0)="2. 205861  ^PSDRUG LOCKS"
^DIC(9.4,84,22,9,"PAH",51,1,8,0)="PSA Verify Invoice processing is not unlocking the drug when finished."
^DIC(9.4,84,22,9,"PAH",52,0)="68 SEQ #53^3090421.160227^17"
^DIC(9.4,84,22,9,"PAH",52,1,0)="^^26^26^3090421"
^DIC(9.4,84,22,9,"PAH",52,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",52,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",52,1,3,0)="1.  180658 - Outdated Medications Option Not Working"
^DIC(9.4,84,22,9,"PAH",52,1,4,0)="The Outdated Medication [PSA OUTDATED MEDICATIONS] option, which allows"
^DIC(9.4,84,22,9,"PAH",52,1,5,0)="for documentation of the return of non-controlled substances, used the CS"
^DIC(9.4,84,22,9,"PAH",52,1,6,0)="Destruction file (#58.86).  This file will not allow the user's name to be"
^DIC(9.4,84,22,9,"PAH",52,1,7,0)="recorded."
^DIC(9.4,84,22,9,"PAH",52,1,8,0)=" "
^DIC(9.4,84,22,9,"PAH",52,1,9,0)="2.  172859 - Outdated drug list for integrated sites"
^DIC(9.4,84,22,9,"PAH",52,1,10,0)="The drug accountability list does not differentiate between the "
^DIC(9.4,84,22,9,"PAH",52,1,11,0)="integrated sites."
^DIC(9.4,84,22,9,"PAH",52,1,12,0)=" "
^DIC(9.4,84,22,9,"PAH",52,1,13,0)="3. 184524 - NDC changed from numbers to letters"
^DIC(9.4,84,22,9,"PAH",52,1,14,0)="Drug accountability invoice processing is changing the NDC from numeric "
^DIC(9.4,84,22,9,"PAH",52,1,15,0)="to letters."
^DIC(9.4,84,22,9,"PAH",52,1,16,0)=" "
^DIC(9.4,84,22,9,"PAH",52,1,17,0)="4. 222558 - Supply item match to drug file"
^DIC(9.4,84,22,9,"PAH",52,1,18,0)="The PRE Verify and POST Verify Variance Reports inaccurately report"
^DIC(9.4,84,22,9,"PAH",52,1,19,0)="changes for supply items that have leading numerics."
^DIC(9.4,84,22,9,"PAH",52,1,20,0)=" "
^DIC(9.4,84,22,9,"PAH",52,1,21,0)="5. 229658 - Outdated Medications"
^DIC(9.4,84,22,9,"PAH",52,1,22,0)="The Outdated Medications [PSA OUTDATED MEDICATIONS] option does not "
^DIC(9.4,84,22,9,"PAH",52,1,23,0)="display"
^DIC(9.4,84,22,9,"PAH",52,1,24,0)="all possible matches for a drug if the DRUG file (#50) index ""C"" is a"
^DIC(9.4,84,22,9,"PAH",52,1,25,0)="match to the information entered at the ""Scan Drug barcode or enter a drug"
^DIC(9.4,84,22,9,"PAH",52,1,26,0)="name"" prompt."
^DIC(9.4,84,22,9,"PAH",53,0)="70 SEQ #54^3090423.135649^17"
^DIC(9.4,84,22,9,"PAH",53,1,0)="^^25^25^3090423"
^DIC(9.4,84,22,9,"PAH",53,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",53,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",53,1,3,0)="1.  HD257764 - UNDEF ERROR"
^DIC(9.4,84,22,9,"PAH",53,1,4,0)="When editing the ORDER UNIT for a Supply Item of a verified order, the"
^DIC(9.4,84,22,9,"PAH",53,1,5,0)="application errors with an undefined error."
^DIC(9.4,84,22,9,"PAH",53,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",53,1,7,0)="2.  HD255967 - UNDEF ERROR <UNDEFINED>EDIT1+36^PSAUTL1"
^DIC(9.4,84,22,9,"PAH",53,1,8,0)="During Order Processing if 2 users select same orders to process and 1"
^DIC(9.4,84,22,9,"PAH",53,1,9,0)="user is editing an order, the application will error."
^DIC(9.4,84,22,9,"PAH",53,1,10,0)=" "
^DIC(9.4,84,22,9,"PAH",53,1,11,0)="3. HD266899 - Error when running PSA IV ALL LOCATIONS"
^DIC(9.4,84,22,9,"PAH",53,1,12,0)="When running the ""Outdated Medications"" report and it quits unexpectedly,"
^DIC(9.4,84,22,9,"PAH",53,1,13,0)="the ^TMP(""PSA"",$J global is left behind causing the ""PSA IV ALL LOCATIONS"""
^DIC(9.4,84,22,9,"PAH",53,1,14,0)="option to error."
^DIC(9.4,84,22,9,"PAH",53,1,15,0)=" "
^DIC(9.4,84,22,9,"PAH",53,1,16,0)="4. HD265183 - Blank Order Unit on zero qty received causes supplies"
^DIC(9.4,84,22,9,"PAH",53,1,17,0)="              to appear on error report"
^DIC(9.4,84,22,9,"PAH",53,1,18,0)="When an invoice contains a blank Order Unit and a zero quantity, all "
^DIC(9.4,84,22,9,"PAH",53,1,19,0)="supply items that follow, are included in the error report."
^DIC(9.4,84,22,9,"PAH",53,1,20,0)=" "
^DIC(9.4,84,22,9,"PAH",53,1,21,0)="5. HD273421 - Cost Calculated Incorrectly on Outdated Meds"
^DIC(9.4,84,22,9,"PAH",53,1,22,0)="The cost on the Items To Be Returned report should be calculating based"
^DIC(9.4,84,22,9,"PAH",53,1,23,0)="on number of Dispense Units returned multiplied by Price Per Dispense"
^DIC(9.4,84,22,9,"PAH",53,1,24,0)="Unit from file 50. Instead, it is multiplying the number of containers"
^DIC(9.4,84,22,9,"PAH",53,1,25,0)="by the Price Per Dispense Unit:"
^DIC(9.4,84,22,9,"PAH",54,0)="69 SEQ #55^3090707.165429^17"
^DIC(9.4,84,22,9,"PAH",54,1,0)="^^56^56^3090707"
^DIC(9.4,84,22,9,"PAH",54,1,1,0)="The FY08 Q4 Enhancement Release includes the following enhancement in the"
^DIC(9.4,84,22,9,"PAH",54,1,2,0)="Drug Accountability V. 3.0 application."
^DIC(9.4,84,22,9,"PAH",54,1,3,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,4,0)="A new module is being added to the Drug Accountability application to "
^DIC(9.4,84,22,9,"PAH",54,1,5,0)="address one of the findings in the GAO Report GAO-04-755 dated July 2004"
^DIC(9.4,84,22,9,"PAH",54,1,6,0)="related to implementing a better control over Return Drug Credits. The new"
^DIC(9.4,84,22,9,"PAH",54,1,7,0)="module is called Return Drug Credit Menu and contains the following 4"
^DIC(9.4,84,22,9,"PAH",54,1,8,0)="options."
^DIC(9.4,84,22,9,"PAH",54,1,9,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,10,0)="    1      Batch Work List            [PSA RET DRG BATCH WORKLIST]"
^DIC(9.4,84,22,9,"PAH",54,1,11,0)="    2      Batch Complete List        [PSA RET DRG BAT COMPLETE LIST]"
^DIC(9.4,84,22,9,"PAH",54,1,12,0)="    3      View/Update Batch          [PSA RET DRG VIEW/UPDATE BATCH]"
^DIC(9.4,84,22,9,"PAH",54,1,13,0)="    4      Return Drug Credit Report  [PSA RET DRG REPORT]"
^DIC(9.4,84,22,9,"PAH",54,1,14,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,15,0)="The Batch Work List [PSA RET DRG BATCH WORKLIST] option will be used to"
^DIC(9.4,84,22,9,"PAH",54,1,16,0)="process open return batches, which are assigned a statuses of 'AWAITING"
^DIC(9.4,84,22,9,"PAH",54,1,17,0)="PICKUP' and 'PICKED UP'."
^DIC(9.4,84,22,9,"PAH",54,1,18,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,19,0)="The Batch Complete List [PSA RET DRG BAT COMPLETE LIST] option allows "
^DIC(9.4,84,22,9,"PAH",54,1,20,0)="users to access and update batches with any status."
^DIC(9.4,84,22,9,"PAH",54,1,21,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,22,0)="The View/Update Batch [PSA RET DRG VIEW/UPDATE BATCH] option is used for"
^DIC(9.4,84,22,9,"PAH",54,1,23,0)="single batch processing, independent of its status."
^DIC(9.4,84,22,9,"PAH",54,1,24,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,25,0)="The Return Drug Credit Report [PSA RET DRG REPORT] option provides"
^DIC(9.4,84,22,9,"PAH",54,1,26,0)="the users with summary and detailed reports of all return batches."
^DIC(9.4,84,22,9,"PAH",54,1,27,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,28,0)="Security Keys:"
^DIC(9.4,84,22,9,"PAH",54,1,29,0)="-------------"
^DIC(9.4,84,22,9,"PAH",54,1,30,0)="In order to have access to the new options, a user must have the PSORPH"
^DIC(9.4,84,22,9,"PAH",54,1,31,0)="or PSARET security key. The PSORPH key is an existing key in the"
^DIC(9.4,84,22,9,"PAH",54,1,32,0)="Outpatient Pharmacy V. 7.0 application. The PSARET is a new security key"
^DIC(9.4,84,22,9,"PAH",54,1,33,0)="in the Drug Accountability application, will be transported in this patch"
^DIC(9.4,84,22,9,"PAH",54,1,34,0)="and should be assigned to users who will be responsible for returning"
^DIC(9.4,84,22,9,"PAH",54,1,35,0)="drugs to the contractor."
^DIC(9.4,84,22,9,"PAH",54,1,36,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,37,0)="New Files:"
^DIC(9.4,84,22,9,"PAH",54,1,38,0)="---------"
^DIC(9.4,84,22,9,"PAH",54,1,39,0)="The following two new files are being added to the Drug Accountability"
^DIC(9.4,84,22,9,"PAH",54,1,40,0)="V. 3.0 application to support the functionality delivered by this patch."
^DIC(9.4,84,22,9,"PAH",54,1,41,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,42,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,43,0)="                                UP    SEND  DATA                USER"
^DIC(9.4,84,22,9,"PAH",54,1,44,0)="                                DATE  SEC.  COMES   SITE  RSLV  OVER"
^DIC(9.4,84,22,9,"PAH",54,1,45,0)="FILE #  FILE NAME               DD    CODE  W/FILE  DATA  PTRS  RIDE"
^DIC(9.4,84,22,9,"PAH",54,1,46,0)="--------------------------------------------------------------------"
^DIC(9.4,84,22,9,"PAH",54,1,47,0)="58.35   RETURN DRUG             YES   YES   NO"
^DIC(9.4,84,22,9,"PAH",54,1,48,0)="58.36   RETURN DRUG CONTRACTOR  YES   YES   NO"
^DIC(9.4,84,22,9,"PAH",54,1,49,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,50,0)=" "
^DIC(9.4,84,22,9,"PAH",54,1,51,0)="The RETURN DRUG file (#58.35) is used to store all the information"
^DIC(9.4,84,22,9,"PAH",54,1,52,0)="about drugs being returned to the manufacturer while the RETURN DRUG"
^DIC(9.4,84,22,9,"PAH",54,1,53,0)="CONTRACTOR file (#58.36) is used to store the list of contractors"
^DIC(9.4,84,22,9,"PAH",54,1,54,0)="that the VA Medical Center (VAMC) uses for returning drugs for credit."
^DIC(9.4,84,22,9,"PAH",54,1,55,0)="Most likely there will be only one contract active at a time for most,"
^DIC(9.4,84,22,9,"PAH",54,1,56,0)="if not all, VAMCs."
^DIC(9.4,84,22,9,"PAH",55,0)="72 SEQ #56^3100128.144803^17"
^DIC(9.4,84,22,9,"PAH",55,1,0)="^^12^12^3100128"
^DIC(9.4,84,22,9,"PAH",55,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",55,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",55,1,3,0)="1.  HD335328 - Routine patch list needs editing"
^DIC(9.4,84,22,9,"PAH",55,1,4,0)="  When PSA*3*69 was release there was five new routines introduced."
^DIC(9.4,84,22,9,"PAH",55,1,5,0)="  The format of the second line of five Routines sent out with patch"
^DIC(9.4,84,22,9,"PAH",55,1,6,0)="  PSA*3*69 need to be corrected. Instead of *69* they need to be *69*."
^DIC(9.4,84,22,9,"PAH",55,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",55,1,8,0)="2.  HD342000 - Dispensed units not automatically subtracting from"
^DIC(9.4,84,22,9,"PAH",55,1,9,0)="               inventory"
^DIC(9.4,84,22,9,"PAH",55,1,10,0)="  The Drug Accountability Transaction History report in not correctly"
^DIC(9.4,84,22,9,"PAH",55,1,11,0)="  calculating the drug balance for dispensed drugs.  Currently the report"
^DIC(9.4,84,22,9,"PAH",55,1,12,0)="  is adding the dispensed quantity instead of deducting it."
^DIC(9.4,84,22,9,"PAH",56,0)="71 SEQ #57^3110302.170849^17"
^DIC(9.4,84,22,9,"PAH",56,1,0)="^^23^23^3110302"
^DIC(9.4,84,22,9,"PAH",56,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",56,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",56,1,3,0)="1.  HD211457 - Locked Invoice"
^DIC(9.4,84,22,9,"PAH",56,1,4,0)=" Sites are reporting that the invoices are being left in a LOCK"
^DIC(9.4,84,22,9,"PAH",56,1,5,0)=" VERIFYING status."
^DIC(9.4,84,22,9,"PAH",56,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",56,1,7,0)="2.  HD285500 - Can't received drug (CS) into vault"
^DIC(9.4,84,22,9,"PAH",56,1,8,0)=" When a invoice was downloaded and processed by a tech, the quantity"
^DIC(9.4,84,22,9,"PAH",56,1,9,0)=" received was changed to 0 on one item because it was going to be"
^DIC(9.4,84,22,9,"PAH",56,1,10,0)=" sent back.  This was a mistake. It should be received in and then out."
^DIC(9.4,84,22,9,"PAH",56,1,11,0)=" Then the verifier did the verification and changed the qty received to"
^DIC(9.4,84,22,9,"PAH",56,1,12,0)=" reflect the original qty received - correcting the mistake."
^DIC(9.4,84,22,9,"PAH",56,1,13,0)=" After verifying the invoice, the user checked the Controlled Substance"
^DIC(9.4,84,22,9,"PAH",56,1,14,0)=" package and found the drug did not show as being received."
^DIC(9.4,84,22,9,"PAH",56,1,15,0)="  "
^DIC(9.4,84,22,9,"PAH",56,1,16,0)="3.  HD322644 - Run away PSA IV ALL LOCATIONS - All Location Dispense/Purge"
^DIC(9.4,84,22,9,"PAH",56,1,17,0)=" The PSA IV ALL LOCATIONS - All Location Dispense/Purge nightly job does"
^DIC(9.4,84,22,9,"PAH",56,1,18,0)=" not complete."
^DIC(9.4,84,22,9,"PAH",56,1,19,0)=" "
^DIC(9.4,84,22,9,"PAH",56,1,20,0)="4. HD279969 - verifying invoices with blank order unit no longer on"
^DIC(9.4,84,22,9,"PAH",56,1,21,0)="              discrepancy report"
^DIC(9.4,84,22,9,"PAH",56,1,22,0)=" When processing a invoice with a blank ORDER UNIT the system returns a"
^DIC(9.4,84,22,9,"PAH",56,1,23,0)=" zero and does not generate a discrepancy report."
^DIC(9.4,84,22,9,"PAH",57,0)="73 SEQ #58^3140731.10234^17"
^DIC(9.4,84,22,9,"PAH",57,1,0)="^^8^8^3140731"
^DIC(9.4,84,22,9,"PAH",57,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",57,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",57,1,3,0)="1.  SUBSCRIPT>LINE+45^PSAPROC7"
^DIC(9.4,84,22,9,"PAH",57,1,4,0)=" "
^DIC(9.4,84,22,9,"PAH",57,1,5,0)="2.  Only Outpatient Figures on Reports"
^DIC(9.4,84,22,9,"PAH",57,1,6,0)=" "
^DIC(9.4,84,22,9,"PAH",57,1,7,0)="3.  DRUG TRANsaction History does not cleanup variables if up caret at "
^DIC(9.4,84,22,9,"PAH",57,1,8,0)="    the device prompt."
^DIC(9.4,84,22,9,"PAH",58,0)="76 SEQ #59^3141031.155626^17"
^DIC(9.4,84,22,9,"PAH",58,1,0)="^^16^16^3141031"
^DIC(9.4,84,22,9,"PAH",58,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,84,22,9,"PAH",58,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",58,1,3,0)="1. INC000000443727 - Verify invoices and no action is taken"
^DIC(9.4,84,22,9,"PAH",58,1,4,0)="When a Controlled Substance follows a drug that has a quantity of 0,"
^DIC(9.4,84,22,9,"PAH",58,1,5,0)="the Invoice Verify routine does not create the Controlled Substance "
^DIC(9.4,84,22,9,"PAH",58,1,6,0)="transaction in the Drug Accountability Transaction file (#58.81)."
^DIC(9.4,84,22,9,"PAH",58,1,7,0)=" "
^DIC(9.4,84,22,9,"PAH",58,1,8,0)="2. INC000000212726 - Outpatient Dispensing (All Drugs) Option not working"
^DIC(9.4,84,22,9,"PAH",58,1,9,0)="When the Outpatient Dispensing (All Drugs) [PSA OP ALL DRUGS] option is"
^DIC(9.4,84,22,9,"PAH",58,1,10,0)="Run no updates are being made to the Drug Accountability Transaction file"
^DIC(9.4,84,22,9,"PAH",58,1,11,0)="(#58.81) or the Drug Accountability Stats file (#58.8)."
^DIC(9.4,84,22,9,"PAH",58,1,12,0)=" "
^DIC(9.4,84,22,9,"PAH",58,1,13,0)="3. INC000000842761 - Drug Accountability - Drug File Updates"
^DIC(9.4,84,22,9,"PAH",58,1,14,0)="When the invoiced Price Per Order Unit is .01 and Dispense Units Per"
^DIC(9.4,84,22,9,"PAH",58,1,15,0)="Order Unit is 100, the Price Per Dispense Unit is calculating it at 0"
^DIC(9.4,84,22,9,"PAH",58,1,16,0)="when it should be .0001 during invoice processing/verifying."
^DIC(9.4,84,22,9,"PAH",59,0)="78 SEQ #60^3180301.153303^54"
^DIC(9.4,84,22,9,"PAH",59,1,0)="^^31^31^3180301"
^DIC(9.4,84,22,9,"PAH",59,1,1,0)="This patch addresses one (1) issue:"
^DIC(9.4,84,22,9,"PAH",59,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",59,1,3,0)="1. McKesson invoice verified, but controlled substance balance did"
^DIC(9.4,84,22,9,"PAH",59,1,4,0)="   not update"
^DIC(9.4,84,22,9,"PAH",59,1,5,0)=" "
^DIC(9.4,84,22,9,"PAH",59,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,84,22,9,"PAH",59,1,7,0)="--------------------------------------------"
^DIC(9.4,84,22,9,"PAH",59,1,8,0)=" "
^DIC(9.4,84,22,9,"PAH",59,1,9,0)="1.  I5849148FY15"
^DIC(9.4,84,22,9,"PAH",59,1,10,0)=" "
^DIC(9.4,84,22,9,"PAH",59,1,11,0)="Problem:"
^DIC(9.4,84,22,9,"PAH",59,1,12,0)="--------"
^DIC(9.4,84,22,9,"PAH",59,1,13,0)="Verified Drug Accountability (McKesson) invoices will not be set "
^DIC(9.4,84,22,9,"PAH",59,1,14,0)="to a status of Complete if the user edits the invoice, verifies, "
^DIC(9.4,84,22,9,"PAH",59,1,15,0)="and closes (or is disconnected from) their Reflections session at  "
^DIC(9.4,84,22,9,"PAH",59,1,16,0)="the ""Type <Enter> to continue or '^' to exit:"" prompt.  This causes "
^DIC(9.4,84,22,9,"PAH",59,1,17,0)="an out-of-balance situation with regards to the controlled substance "
^DIC(9.4,84,22,9,"PAH",59,1,18,0)="vault."
^DIC(9.4,84,22,9,"PAH",59,1,19,0)=" "
^DIC(9.4,84,22,9,"PAH",59,1,20,0)="Resolution:"
^DIC(9.4,84,22,9,"PAH",59,1,21,0)="-----------"
^DIC(9.4,84,22,9,"PAH",59,1,22,0)="If a user edits an invoice prior to verifying, VistA routine ^PSAVER1 "
^DIC(9.4,84,22,9,"PAH",59,1,23,0)="sets the invoice status to VERIFIED and prompts for the user to "
^DIC(9.4,84,22,9,"PAH",59,1,24,0)="continue or exit, via subroutine END^PSAPROC. The prompt at that point"
^DIC(9.4,84,22,9,"PAH",59,1,25,0)="waits for a response.  If the user's Reflections session ends without "
^DIC(9.4,84,22,9,"PAH",59,1,26,0)="completing the final prompt, important processing is missed with "
^DIC(9.4,84,22,9,"PAH",59,1,27,0)="regards to setting up invoice data for the background job that changes "
^DIC(9.4,84,22,9,"PAH",59,1,28,0)="the status from VERIFIED to COMPLETE."
^DIC(9.4,84,22,9,"PAH",59,1,29,0)=" "
^DIC(9.4,84,22,9,"PAH",59,1,30,0)="To resolve this issue, the call to execute the prompt via END^PSAPROC "
^DIC(9.4,84,22,9,"PAH",59,1,31,0)="has been moved to a more appropriate spot in EXIT^PSAVER."
^DIC(9.4,84,22,9,"PAH",60,0)="80 SEQ #62^3181206.160707^54"
^DIC(9.4,84,22,9,"PAH",60,1,0)="^^29^29^3181206"
^DIC(9.4,84,22,9,"PAH",60,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,84,22,9,"PAH",60,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",60,1,3,0)="INC0933704 - Unable to  correct vault medication with negative balance which"
^DIC(9.4,84,22,9,"PAH",60,1,4,0)="             is also  inactive in the drug file"
^DIC(9.4,84,22,9,"PAH",60,1,5,0)="     "
^DIC(9.4,84,22,9,"PAH",60,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,84,22,9,"PAH",60,1,7,0)="--------------------------------------------"
^DIC(9.4,84,22,9,"PAH",60,1,8,0)="INC0933704 - Unable to  correct vault medication with negative balance which"
^DIC(9.4,84,22,9,"PAH",60,1,9,0)="             is also inactive in the drug file"
^DIC(9.4,84,22,9,"PAH",60,1,10,0)="        "
^DIC(9.4,84,22,9,"PAH",60,1,11,0)="Problem: "
^DIC(9.4,84,22,9,"PAH",60,1,12,0)="--------"
^DIC(9.4,84,22,9,"PAH",60,1,13,0)="VA Southern Nevada reported that they were unable to correct vault medication"
^DIC(9.4,84,22,9,"PAH",60,1,14,0)="with negative balance which is also inactive in the drug file. The negative"
^DIC(9.4,84,22,9,"PAH",60,1,15,0)="balance is actually caused by a problem in the Edit Verified Invoices [PSA"
^DIC(9.4,84,22,9,"PAH",60,1,16,0)="EDIT VERIFIED INVOICE] option which incorrectly records transactions when"
^DIC(9.4,84,22,9,"PAH",60,1,17,0)="an invoice is edited and a controlled substance drug is replaced with a"
^DIC(9.4,84,22,9,"PAH",60,1,18,0)="non-controlled substance drug and vice-versa."
^DIC(9.4,84,22,9,"PAH",60,1,19,0)="       "
^DIC(9.4,84,22,9,"PAH",60,1,20,0)="Resolution:"
^DIC(9.4,84,22,9,"PAH",60,1,21,0)="-----------"
^DIC(9.4,84,22,9,"PAH",60,1,22,0)="Modified the Edit Verified Invoices [PSA EDIT VERIFIED INVOICE] option to"
^DIC(9.4,84,22,9,"PAH",60,1,23,0)="correctly record inventory transactions accordingly whether the drug is"
^DIC(9.4,84,22,9,"PAH",60,1,24,0)="marked as controlled substance or not."
^DIC(9.4,84,22,9,"PAH",60,1,25,0)="  "
^DIC(9.4,84,22,9,"PAH",60,1,26,0)="Technical Resolution:"
^DIC(9.4,84,22,9,"PAH",60,1,27,0)="---------------------"
^DIC(9.4,84,22,9,"PAH",60,1,28,0)="Changed the routines PSAVERA and PSAVERA1 which are responsible for updating"
^DIC(9.4,84,22,9,"PAH",60,1,29,0)="the inventory transactions after a verified invoice is edited."
^DIC(9.4,84,22,9,"PAH",61,0)="82 SEQ #64^3220126.113604^17"
^DIC(9.4,84,22,9,"PAH",61,1,0)="^^5^5^3220126"
^DIC(9.4,84,22,9,"PAH",61,1,1,0)="An incident was reported that when a pharmacist changes the drug name for "
^DIC(9.4,84,22,9,"PAH",61,1,2,0)="a line item on an invoice using the option VERIFY INVOICES and then the "
^DIC(9.4,84,22,9,"PAH",61,1,3,0)="invoice is subsequently verified by a different pharmacist, the new change"
^DIC(9.4,84,22,9,"PAH",61,1,4,0)="is not saved properly in the invoice file. In turn, this causes some of"
^DIC(9.4,84,22,9,"PAH",61,1,5,0)="the various drug accountability reports to be inaccurate."
^DIC(9.4,84,22,9,"PAH",62,0)="81 SEQ #65^3231026.103331^89"
^DIC(9.4,84,22,9,"PAH",62,1,0)="^^9^9^3231026"
^DIC(9.4,84,22,9,"PAH",62,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,84,22,9,"PAH",62,1,2,0)=" "
^DIC(9.4,84,22,9,"PAH",62,1,3,0)="Several sites have reported that when editing a verified invoice by "
^DIC(9.4,84,22,9,"PAH",62,1,4,0)="changing a non-controlled substance drug to a controlled substance drug a "
^DIC(9.4,84,22,9,"PAH",62,1,5,0)="negative balance for the non-controlled drug is appearing on the "
^DIC(9.4,84,22,9,"PAH",62,1,6,0)="Controlled Substance Inventory Sheet. Another defect experienced with "
^DIC(9.4,84,22,9,"PAH",62,1,7,0)="this same type of edit is the inability to select the non-controlled "
^DIC(9.4,84,22,9,"PAH",62,1,8,0)="substance drug by name when trying to adjust the negative balance in the "
^DIC(9.4,84,22,9,"PAH",62,1,9,0)="controlled substance vault."
^DIC(9.4,84,22,9,"PAH","B",3,5)=""
