^DIC(9.4,14,22,5.9,"PAH",143,1,57,0)=" ==============="
^DIC(9.4,14,22,5.9,"PAH",143,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,59,0)="   The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",143,1,60,0)="   of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",143,1,61,0)="   <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",143,1,62,0)="  "
