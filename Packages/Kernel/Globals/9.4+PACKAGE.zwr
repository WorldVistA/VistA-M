^DIC(9.4,53,22,20,"PAH",260,1,248,0)="Patches for this installation are combined in host file "
^DIC(9.4,53,22,20,"PAH",260,1,249,0)="IB_2_568_PRCA_PSO_BUNDLE_T1.KID"
^DIC(9.4,53,22,20,"PAH",260,1,250,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,251,0)="Installation of this host file should be coordinated among the packages "
^DIC(9.4,53,22,20,"PAH",260,1,252,0)="affected since only one installation is necessary."
^DIC(9.4,53,22,20,"PAH",260,1,253,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,254,0)="The patches are:"
^DIC(9.4,53,22,20,"PAH",260,1,255,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,256,0)="     IB*2.0*568"
^DIC(9.4,53,22,20,"PAH",260,1,257,0)="     PRCA*4.5*315"
^DIC(9.4,53,22,20,"PAH",260,1,258,0)="     PSO*7.0*463"
^DIC(9.4,53,22,20,"PAH",260,1,259,0)="     "
^DIC(9.4,53,22,20,"PAH",260,1,260,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,261,0)="Sites may retrieve the KIDS build in one of the following ways:"
^DIC(9.4,53,22,20,"PAH",260,1,262,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,263,0)="(1) The preferred method is to FTP the files from "
^DIC(9.4,53,22,20,"PAH",260,1,264,0)="download.vista.domain.ext"
^DIC(9.4,53,22,20,"PAH",260,1,265,0)="which will transmit the files from the first available FTP server."
^DIC(9.4,53,22,20,"PAH",260,1,266,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,267,0)="(2) Sites may also elect to retrieve the patch directly from a specific"
^DIC(9.4,53,22,20,"PAH",260,1,268,0)="server as follows:"
^DIC(9.4,53,22,20,"PAH",260,1,269,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,270,0)="  OIFO               FTP ADDRESS                  DIRECTORY"
^DIC(9.4,53,22,20,"PAH",260,1,271,0)="  --------------     ------------------------     ------------------"
^DIC(9.4,53,22,20,"PAH",260,1,272,0)="  Albany             ftp.fo-albany.domain.ext     anonymous.software"
^DIC(9.4,53,22,20,"PAH",260,1,273,0)="  Hines              ftp.fo-hines.domain.ext      anonymous.software"
^DIC(9.4,53,22,20,"PAH",260,1,274,0)="  Salt Lake City     ftp.fo-slc.domain.ext        anonymous.software"
^DIC(9.4,53,22,20,"PAH",260,1,275,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,276,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,277,0)="Sites may retrieve documentation directly using Secure File Transfer "
^DIC(9.4,53,22,20,"PAH",260,1,278,0)="Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory at the following"
^DIC(9.4,53,22,20,"PAH",260,1,279,0)="OI Field Offices:"
^DIC(9.4,53,22,20,"PAH",260,1,280,0)=" "
