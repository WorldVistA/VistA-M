^DIC(9.4,111,"VERSION")="1.0"
^DIC(9.4,114,0)="FEE BASIS^FB^Used to pay private vendors"
^DIC(9.4,114,1,0)="^^9^9^2950117^^^^"
^DIC(9.4,114,1,1,0)="System used by Medical Administration service to process and pay "
^DIC(9.4,114,1,2,0)="invoices from private vendors for authorized procedures provided"
^DIC(9.4,114,1,3,0)="to veterans. Initial version will include the the processing of"
^DIC(9.4,114,1,4,0)="Hometown Pharmacy, Patient Travel, and Outpatient Medical claims."
^DIC(9.4,114,1,5,0)="Version 2 includes Contract Hospital and Community Nursing Home."
^DIC(9.4,114,1,6,0)="Unauthorized claims has been added in version 3.  Also in this"
^DIC(9.4,114,1,7,0)="version is an update to the vendor file for the conversion of"
^DIC(9.4,114,1,8,0)="CALM to FMS in Austin.  The Community Nursing Home has been"
^DIC(9.4,114,1,9,0)="modified to handle multiple rates."
^DIC(9.4,114,4,0)="^9.44PA^44^33"
