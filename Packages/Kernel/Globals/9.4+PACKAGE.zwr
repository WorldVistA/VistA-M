^DIC(9.4,3,22,21,"PAH",64,1,273,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,274,0)="Select OPTION: 5    INQUIRE TO FILE ENTRIES"
^DIC(9.4,3,22,21,"PAH",64,1,275,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,276,0)="OUTPUT FROM WHAT FILE: PROTOCOL// "
^DIC(9.4,3,22,21,"PAH",64,1,277,0)="Select PROTOCOL NAME:    ZZKYLE MENU 1          ItemText      "
^DIC(9.4,3,22,21,"PAH",64,1,278,0)="ANOTHER ONE: "
^DIC(9.4,3,22,21,"PAH",64,1,279,0)="STANDARD CAPTIONED OUTPUT? Yes//   (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,280,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,3,22,21,"PAH",64,1,281,0)="Computed Fields"
^DIC(9.4,3,22,21,"PAH",64,1,282,0)=""
^DIC(9.4,3,22,21,"PAH",64,1,283,0)="NAME: ZZKYLE MENU 1                     ITEM TEXT: ItemText"
^DIC(9.4,3,22,21,"PAH",64,1,284,0)="  TYPE: menu                            CREATOR: DIMICELI,RON"
^DIC(9.4,3,22,21,"PAH",64,1,285,0)="  PACKAGE: 283                          COLUMN WIDTH: 26"
^DIC(9.4,3,22,21,"PAH",64,1,286,0)="  MNEMONIC WIDTH: 4"
^DIC(9.4,3,22,21,"PAH",64,1,287,0)="ITEM: ZZKYLE ACTION 1                   MNEMONIC: ZZ    <== 1st Item"
^DIC(9.4,3,22,21,"PAH",64,1,288,0)="  SEQUENCE: 1"
^DIC(9.4,3,22,21,"PAH",64,1,289,0)="ITEM: ZZKYLE ACTION 4                                   <== 2nd Item (Was 4th)"
^DIC(9.4,3,22,21,"PAH",64,1,290,0)="  HEADER: D SHOW^VALM                   MENU PROMPT: Select ZZ Action:"
^DIC(9.4,3,22,21,"PAH",64,1,291,0)="  TIMESTAMP: 57455,50320"
^DIC(9.4,3,22,21,"PAH",64,1,292,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,293,0)=" "
^DIC(9.4,3,22,21,"PAH",65,0)="81 SEQ #71^2980712^1"
^DIC(9.4,3,22,21,"PAH",66,0)="43 SEQ #72^2980725^1"
^DIC(9.4,3,22,21,"PAH",66,1,0)="^^106^106^2980725"
^DIC(9.4,3,22,21,"PAH",66,1,1,0)="This patch is in support of CIRN.  It will add fields to the Institution"
^DIC(9.4,3,22,21,"PAH",66,1,2,0)="file, an entry to the Facility Type file, and add new Institution file"
^DIC(9.4,3,22,21,"PAH",66,1,3,0)="associations."
^DIC(9.4,3,22,21,"PAH",66,1,4,0)="**NOTE: It will add all 22 VISN's in the format 'VISN xx' and"
^DIC(9.4,3,22,21,"PAH",66,1,5,0)="build the associations for each station in that VISN."
^DIC(9.4,3,22,21,"PAH",66,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,7,0)="There is a new form OPTION; EVE:OPERATIONS:KERNEL:INSTITUTION to edit the"
^DIC(9.4,3,22,21,"PAH",66,1,8,0)="Institution file."
^DIC(9.4,3,22,21,"PAH",66,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,10,0)="Includes a routine with several APIs for the CIRN developers to use."
^DIC(9.4,3,22,21,"PAH",66,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,12,0)="Supported References"
^DIC(9.4,3,22,21,"PAH",66,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,14,0)="PARENT^XUAF4(array, station, association) - for a specified institution which "
^DIC(9.4,3,22,21,"PAH",66,1,15,0)="is the parent for this association type."
^DIC(9.4,3,22,21,"PAH",66,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,17,0)="INPUT Variables"
^DIC(9.4,3,22,21,"PAH",66,1,18,0)="Array - As input, it is the $NAME reference for the Array name you want "
^DIC(9.4,3,22,21,"PAH",66,1,19,0)="    results back in. (This needs to be in your namespace)"
^DIC(9.4,3,22,21,"PAH",66,1,20,0)="Station - The lookup value - either ien, station number, station name."
^DIC(9.4,3,22,21,"PAH",66,1,21,0)="   If IEN it will need to have the ` in front of it."
^DIC(9.4,3,22,21,"PAH",66,1,22,0)="Association - The type of assocation from the Institution Association Types "
^DIC(9.4,3,22,21,"PAH",66,1,23,0)="    file.  (in CIRN's case it is = VISN) "
^DIC(9.4,3,22,21,"PAH",66,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,25,0)="Output Variable - array(""p"",ien)=station name ^ station number"
^DIC(9.4,3,22,21,"PAH",66,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,27,0)="Note: We have a business rule that institution can only have one parent per"
^DIC(9.4,3,22,21,"PAH",66,1,28,0)="association."
^DIC(9.4,3,22,21,"PAH",66,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,30,0)="SIBLING^XUAF4(array, child ,association) - all sibling institutions of a"
^DIC(9.4,3,22,21,"PAH",66,1,31,0)=" given institution of a given association."
^DIC(9.4,3,22,21,"PAH",66,1,32,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,33,0)="INPUT Variables"
^DIC(9.4,3,22,21,"PAH",66,1,34,0)="Array - As input it is the $NAME reference for the Array name you want "
^DIC(9.4,3,22,21,"PAH",66,1,35,0)="    results back in. (This needs to be in your namespace)"
^DIC(9.4,3,22,21,"PAH",66,1,36,0)="Child - The lookup value - either ien, station number, station name. "
^DIC(9.4,3,22,21,"PAH",66,1,37,0)="    If IEN it will need to have the ` in front of it."
^DIC(9.4,3,22,21,"PAH",66,1,38,0)="Association - The type of assocation from the Institution Association Types "
^DIC(9.4,3,22,21,"PAH",66,1,39,0)="    file.  (in CIRN's case it is = VISN)"
^DIC(9.4,3,22,21,"PAH",66,1,40,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,41,0)="Output Variable - array(""p"",pien,""c"",cien)=station name ^ station number"
^DIC(9.4,3,22,21,"PAH",66,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,43,0)="Note: We have a business rule that institution can only have one parent per"
^DIC(9.4,3,22,21,"PAH",66,1,44,0)="association."
^DIC(9.4,3,22,21,"PAH",66,1,45,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,46,0)="CHILDREN^XUAF4(array, parent, association) - for a specified parent return a "
^DIC(9.4,3,22,21,"PAH",66,1,47,0)="   list of all child institutions for a given association."
^DIC(9.4,3,22,21,"PAH",66,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",66,1,49,0)="Input Variables "
^DIC(9.4,3,22,21,"PAH",66,1,50,0)="Array - As input it is the $NAME reference for the Array name you want"
^DIC(9.4,3,22,21,"PAH",66,1,51,0)="   results back in. (This needs to be in your namespace)"
^DIC(9.4,3,22,21,"PAH",66,1,52,0)="Parent - The lookup value either ien, station number, station name. "
^DIC(9.4,3,22,21,"PAH",66,1,53,0)="   If IEN it will need to have the ` in front of it."
^DIC(9.4,3,22,21,"PAH",66,1,54,0)="Association - The type of assocation from the Institution Association Types "
^DIC(9.4,3,22,21,"PAH",66,1,55,0)="   file.  (in CIRN's case it is = VISN)"
^DIC(9.4,3,22,21,"PAH",66,1,56,0)="    "
^DIC(9.4,3,22,21,"PAH",66,1,57,0)="Output Variable - array (""c"" , ien)=station name ^ station number"
^DIC(9.4,3,22,21,"PAH",66,1,58,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,59,0)="NNT^XUAF4(ien) - "
^DIC(9.4,3,22,21,"PAH",66,1,60,0)="   This will return the station name ^ station number ^ station type"
^DIC(9.4,3,22,21,"PAH",66,1,61,0)="   IEN - The pointer value into file 4."
^DIC(9.4,3,22,21,"PAH",66,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,63,0)="CIRN^XUAF4(inst [,value]) - This function returns the value of the CIRN "
^DIC(9.4,3,22,21,"PAH",66,1,64,0)="   enabled field from the institution file."
^DIC(9.4,3,22,21,"PAH",66,1,65,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,66,0)="inst - The pointer value (IEN) into file 4."
^DIC(9.4,3,22,21,"PAH",66,1,67,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,68,0)="value - (optional) Restricted to use by CIRN. This allows the setting of the"
^DIC(9.4,3,22,21,"PAH",66,1,69,0)="   field to a new value (Yes, No or @ to delete)"
^DIC(9.4,3,22,21,"PAH",66,1,70,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,71,0)="Output - ""Yes"", ""No"" or the empty string"
^DIC(9.4,3,22,21,"PAH",66,1,72,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,73,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",66,1,74,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",66,1,75,0)="XU8P43P                 1825656    **43**"
^DIC(9.4,3,22,21,"PAH",66,1,76,0)="XUAF4                   1190987    **43**"
^DIC(9.4,3,22,21,"PAH",66,1,77,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,78,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",66,1,79,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",66,1,80,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,81,0)="  1.  DSM sites - New routine."
^DIC(9.4,3,22,21,"PAH",66,1,82,0)="     "
^DIC(9.4,3,22,21,"PAH",66,1,83,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",66,1,84,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",66,1,85,0)="     "
^DIC(9.4,3,22,21,"PAH",66,1,86,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",66,1,87,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",66,1,88,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",66,1,89,0)="      options:"
^DIC(9.4,3,22,21,"PAH",66,1,90,0)="      "
^DIC(9.4,3,22,21,"PAH",66,1,91,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",66,1,92,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",66,1,93,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",66,1,94,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",66,1,95,0)="     "
^DIC(9.4,3,22,21,"PAH",66,1,96,0)=" 4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",66,1,97,0)="     non-peek time."
^DIC(9.4,3,22,21,"PAH",66,1,98,0)="     "
^DIC(9.4,3,22,21,"PAH",66,1,99,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",66,1,100,0)="      option:"
^DIC(9.4,3,22,21,"PAH",66,1,101,0)="        Install Package(s)  'XU*8.0*43'"
^DIC(9.4,3,22,21,"PAH",66,1,102,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",66,1,103,0)="        "
^DIC(9.4,3,22,21,"PAH",66,1,104,0)=""
^DIC(9.4,3,22,21,"PAH",66,1,105,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",66,1,106,0)=""
^DIC(9.4,3,22,21,"PAH",67,0)="90 SEQ #73^2980903^1"
^DIC(9.4,3,22,21,"PAH",67,1,0)="^^214^214^2980903"
^DIC(9.4,3,22,21,"PAH",67,1,1,0)="This patch is being released by Capacity Management (CM) in anticipation"
^DIC(9.4,3,22,21,"PAH",67,1,2,0)="of the national release of the Resource Usage Monitor (RUM) Version 1.0"
^DIC(9.4,3,22,21,"PAH",67,1,3,0)="and Statistical Analysis of Global Growth (SAGG) Version 1.8 software"
^DIC(9.4,3,22,21,"PAH",67,1,4,0)="packages."
^DIC(9.4,3,22,21,"PAH",67,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,6,0)="This patch will not affect the current versions of the RUM and SAGG"
^DIC(9.4,3,22,21,"PAH",67,1,7,0)="software that is running at the sites.  Therefore, all DSM, MSM and"
^DIC(9.4,3,22,21,"PAH",67,1,8,0)="OpenM-NT sites are instructed to install this patch.  Sites which had a"
^DIC(9.4,3,22,21,"PAH",67,1,9,0)="pre-release of SAGG v 1.8 should also install this patch."
^DIC(9.4,3,22,21,"PAH",67,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,11,0)="This patch in conjunction with the future release of SAGG v 1.8 will"
^DIC(9.4,3,22,21,"PAH",67,1,12,0)="support the collection of global growth data from the following operating"
^DIC(9.4,3,22,21,"PAH",67,1,13,0)="system platforms: DSM, MSM and OpenM-NT."
^DIC(9.4,3,22,21,"PAH",67,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,15,0)="This patch distribution will be adding new %ZOSV* routines to the system"
^DIC(9.4,3,22,21,"PAH",67,1,16,0)="specific manager routine set.  The accompanying installation instructions"
^DIC(9.4,3,22,21,"PAH",67,1,17,0)="will guide you in adding these routines to your system."
^DIC(9.4,3,22,21,"PAH",67,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,19,0)="This distribution also contains two routines within the new KMP*"
^DIC(9.4,3,22,21,"PAH",67,1,20,0)="namespace:"
^DIC(9.4,3,22,21,"PAH",67,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,22,0)="   KMPENV      An environment check routine which determines which system"
^DIC(9.4,3,22,21,"PAH",67,1,23,0)="               specific collection routines should be installed.  The"
^DIC(9.4,3,22,21,"PAH",67,1,24,0)="               system variable ^%ZOSF(""OS"") will be used to determine the"
^DIC(9.4,3,22,21,"PAH",67,1,25,0)="               type of sysem on which this distribution is running."
^DIC(9.4,3,22,21,"PAH",67,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,27,0)="   KMPLOAD     A loader routine that will be used to rename the ZOSVK*"
^DIC(9.4,3,22,21,"PAH",67,1,28,0)="               routines to %ZOSVK*."
^DIC(9.4,3,22,21,"PAH",67,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,30,0)="The KMP* namespace has been designated for the use of Capacity Management"
^DIC(9.4,3,22,21,"PAH",67,1,31,0)="routines.  Both of these routines are only necessary for the installation"
^DIC(9.4,3,22,21,"PAH",67,1,32,0)="of this distribution and can be deleted after successful completion of"
^DIC(9.4,3,22,21,"PAH",67,1,33,0)="this patch."
^DIC(9.4,3,22,21,"PAH",67,1,34,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,36,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",67,1,37,0)="============"
^DIC(9.4,3,22,21,"PAH",67,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,39,0)="The installation of this patch does not affect any options.  Therefore,"
^DIC(9.4,3,22,21,"PAH",67,1,40,0)="this installation can be performed at any time of the day with minimal"
^DIC(9.4,3,22,21,"PAH",67,1,41,0)="disruption to users.  Provided the information that is listed immediately"
^DIC(9.4,3,22,21,"PAH",67,1,42,0)="below does NOT apply to your site's configuration, installation should not"
^DIC(9.4,3,22,21,"PAH",67,1,43,0)="take longer than 10-15 minutes."
^DIC(9.4,3,22,21,"PAH",67,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,46,0)="NOTE:  If you are an 'OpenM-NT' site, review the 'NOTE' section in Step 7"
^DIC(9.4,3,22,21,"PAH",67,1,47,0)="       to determine if additional preparation work is necessary."
^DIC(9.4,3,22,21,"PAH",67,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,50,0)="  1.   You will not need to review your mapped routine sets."
^DIC(9.4,3,22,21,"PAH",67,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,53,0)="  2.   Load the patch distribution onto your system by following these"
^DIC(9.4,3,22,21,"PAH",67,1,54,0)="       instructions:"
^DIC(9.4,3,22,21,"PAH",67,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,56,0)="       Enter 'X' at the 'Select MESSAGE Action: IGNORE//' (or DELETE//)"
^DIC(9.4,3,22,21,"PAH",67,1,57,0)="       mail prompt and select the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,3,22,21,"PAH",67,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,60,0)="  3.   From the 'Kernel Installation & Distribution System' (KIDS) menu,"
^DIC(9.4,3,22,21,"PAH",67,1,61,0)="       select the 'Installation' menu."
^DIC(9.4,3,22,21,"PAH",67,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,64,0)="  4.   You may now elect to use the following options: "
^DIC(9.4,3,22,21,"PAH",67,1,65,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,66,0)="             When prompted for the INSTALL NAME, enter XU*8.0*90"
^DIC(9.4,3,22,21,"PAH",67,1,67,0)="                                                       ========="
^DIC(9.4,3,22,21,"PAH",67,1,68,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,69,0)="       a.    Backup a Transport Global - this option will create a backup"
^DIC(9.4,3,22,21,"PAH",67,1,70,0)="             message of any routines exported with this release.  It will"
^DIC(9.4,3,22,21,"PAH",67,1,71,0)="             NOT backup any other changes such as DDs or templates."
^DIC(9.4,3,22,21,"PAH",67,1,72,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,73,0)="       b.    Compare Transport Global to Current System - this option will"
^DIC(9.4,3,22,21,"PAH",67,1,74,0)="             allow you to view all changes that will be made when the"
^DIC(9.4,3,22,21,"PAH",67,1,75,0)="             release is installed.  It compares all components of the"
^DIC(9.4,3,22,21,"PAH",67,1,76,0)="             release (routines, DDs, templates, etc.)."
^DIC(9.4,3,22,21,"PAH",67,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,78,0)="       c.    Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,3,22,21,"PAH",67,1,79,0)="             you to ensure the integrity of the routines that are in the"
^DIC(9.4,3,22,21,"PAH",67,1,80,0)="             transport global."
^DIC(9.4,3,22,21,"PAH",67,1,81,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,82,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,83,0)="  5.   Use the 'Install Package(s)' option and select the package"
^DIC(9.4,3,22,21,"PAH",67,1,84,0)="       XU*8.0*90."
^DIC(9.4,3,22,21,"PAH",67,1,85,0)="       ========="
^DIC(9.4,3,22,21,"PAH",67,1,86,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,88,0)="  6.   When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,3,22,21,"PAH",67,1,89,0)="       Protocols? NO//', you can respond with NO."
^DIC(9.4,3,22,21,"PAH",67,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,91,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,92,0)="  7.   If you are either a 'DSM for OpenVMS' or 'MSM-DOS' site, after"
^DIC(9.4,3,22,21,"PAH",67,1,93,0)="       successful completion of the installation, move and restore the"
^DIC(9.4,3,22,21,"PAH",67,1,94,0)="       KMPLOAD and ZOSVK* routines to the MGR UCI(s) with the ^%RS and"
^DIC(9.4,3,22,21,"PAH",67,1,95,0)="       ^%RR system routines."
^DIC(9.4,3,22,21,"PAH",67,1,96,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,97,0)="       If you are a 'MSM-DOS' site, you must also move these routines to"
^DIC(9.4,3,22,21,"PAH",67,1,98,0)="       all MGR UCIs on every CPU, such as, compute, print, file and shadow"
^DIC(9.4,3,22,21,"PAH",67,1,99,0)="       servers.   "
^DIC(9.4,3,22,21,"PAH",67,1,100,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,101,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,102,0)="       NOTE:   If you are a 'OpenM-NT' site, you must verify that the"
^DIC(9.4,3,22,21,"PAH",67,1,103,0)="               routine mapping configuration on each of your NT system(s)"
^DIC(9.4,3,22,21,"PAH",67,1,104,0)="               contains %ZO* or, at least, %ZOSV*."
^DIC(9.4,3,22,21,"PAH",67,1,105,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,106,0)="               You MUST review the mapping configuration on ALL of your"
^DIC(9.4,3,22,21,"PAH",67,1,107,0)="               NT-VISTA Network configuration files (i.e., VANETA.DEF and"
^DIC(9.4,3,22,21,"PAH",67,1,108,0)="               VANETB.DEF)."
^DIC(9.4,3,22,21,"PAH",67,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,110,0)="               If needed, you will also need to modify ALL of your"
^DIC(9.4,3,22,21,"PAH",67,1,111,0)="               NT-VISTA Network configuration files (i.e., VANETA.DEF and"
^DIC(9.4,3,22,21,"PAH",67,1,112,0)="               VANETB.DEF)."
^DIC(9.4,3,22,21,"PAH",67,1,113,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,114,0)="               Use the following instructions to complete this task:"
^DIC(9.4,3,22,21,"PAH",67,1,115,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,116,0)="               On the 'Open M NextGen Thin Client' buttons, click on the"
^DIC(9.4,3,22,21,"PAH",67,1,117,0)="               'Configure Open M' (i.e., Wizard) button."
^DIC(9.4,3,22,21,"PAH",67,1,118,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,119,0)="               On the top menu line of the 'Open M Configurations' window:"
^DIC(9.4,3,22,21,"PAH",67,1,120,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,121,0)="                  Select File"
^DIC(9.4,3,22,21,"PAH",67,1,122,0)="                         -"
^DIC(9.4,3,22,21,"PAH",67,1,123,0)="                    Edit Network Configuration..."
^DIC(9.4,3,22,21,"PAH",67,1,124,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,125,0)="               On the top menu line of the 'Open M - Namespace/Network"
^DIC(9.4,3,22,21,"PAH",67,1,126,0)="               Configuration' window:"
^DIC(9.4,3,22,21,"PAH",67,1,127,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,128,0)="                  Select File"
^DIC(9.4,3,22,21,"PAH",67,1,129,0)="                         -"
^DIC(9.4,3,22,21,"PAH",67,1,130,0)="                    Open Configuration [Remote]..."
^DIC(9.4,3,22,21,"PAH",67,1,131,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,132,0)="               A 'Choose Connection' window opens:"
^DIC(9.4,3,22,21,"PAH",67,1,133,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,134,0)="                  Choose the appropriate 'Connection' to your NT system"
^DIC(9.4,3,22,21,"PAH",67,1,135,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,136,0)="                    Click the 'OK' button"
^DIC(9.4,3,22,21,"PAH",67,1,137,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,138,0)="               Select the correct system from the 'File Name' box"
^DIC(9.4,3,22,21,"PAH",67,1,139,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,140,0)="               *** You will need to review ALL of your ***"
^DIC(9.4,3,22,21,"PAH",67,1,141,0)="               ***         VISTA configurations        ***"
^DIC(9.4,3,22,21,"PAH",67,1,142,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,143,0)="                    Click the 'OK' button"
^DIC(9.4,3,22,21,"PAH",67,1,144,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,145,0)="               Click on the 'Routine Mapping' radial button  -> o"
^DIC(9.4,3,22,21,"PAH",67,1,146,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,147,0)="               Review the entries and ensure that the following is"
^DIC(9.4,3,22,21,"PAH",67,1,148,0)="               present:"
^DIC(9.4,3,22,21,"PAH",67,1,149,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,150,0)="                Routines       Type      Destination Location"
^DIC(9.4,3,22,21,"PAH",67,1,151,0)="                --------       ----      --------------------"
^DIC(9.4,3,22,21,"PAH",67,1,152,0)="                %ZO*           ALL       ROU"
^DIC(9.4,3,22,21,"PAH",67,1,153,0)="        (or, at least, %ZOSV*)"
^DIC(9.4,3,22,21,"PAH",67,1,154,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,155,0)="               If the above is present, continue to Step 8."
^DIC(9.4,3,22,21,"PAH",67,1,156,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,157,0)="               However, if the above is NOT present, click the 'Insert"
^DIC(9.4,3,22,21,"PAH",67,1,158,0)="               Mapping' button and add %ZO* to the routine mapping list."
^DIC(9.4,3,22,21,"PAH",67,1,159,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,160,0)="               Then, on the top menu line of the 'Open M Namespace/Network"
^DIC(9.4,3,22,21,"PAH",67,1,161,0)="               Configuration' window:"
^DIC(9.4,3,22,21,"PAH",67,1,162,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,163,0)="                  Select File"
^DIC(9.4,3,22,21,"PAH",67,1,164,0)="                         -"
^DIC(9.4,3,22,21,"PAH",67,1,165,0)="                    Save Configuration"
^DIC(9.4,3,22,21,"PAH",67,1,166,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,167,0)="               Restart OpenM after making this change on ALL VISTA"
^DIC(9.4,3,22,21,"PAH",67,1,168,0)="               configurations of the OpenM-NT cluster."
^DIC(9.4,3,22,21,"PAH",67,1,169,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,170,0)="               Review ALL of your NT-VISTA configurations and make the"
^DIC(9.4,3,22,21,"PAH",67,1,171,0)="               appropriate modifications, if necessary."
^DIC(9.4,3,22,21,"PAH",67,1,172,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,173,0)="               After restarting your OpenM systems, you will log into the"
^DIC(9.4,3,22,21,"PAH",67,1,174,0)="               VAH UCI to complete the next step."
^DIC(9.4,3,22,21,"PAH",67,1,175,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,176,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,177,0)="  8.   All sites must run the KMPLOAD routine in order to rename the"
^DIC(9.4,3,22,21,"PAH",67,1,178,0)="       system specific collection routines to the %ZOSVK-namespace."
^DIC(9.4,3,22,21,"PAH",67,1,179,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,180,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,181,0)="       NOTE:   If you are a 'DSM for OpenVMS' site, you must have"
^DIC(9.4,3,22,21,"PAH",67,1,182,0)="               performed Step 7 and be logged into the MCR UCI in order to"
^DIC(9.4,3,22,21,"PAH",67,1,183,0)="               complete this step as shown below."
^DIC(9.4,3,22,21,"PAH",67,1,184,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,185,0)="       NOTE:   If you are a 'MSM-DOS' site, you must have performed Step 7"
^DIC(9.4,3,22,21,"PAH",67,1,186,0)="               and be logged into the MGR UCI.  You must run this routine"
^DIC(9.4,3,22,21,"PAH",67,1,187,0)="               on all MGR UCIs on every CPU, such as, compute, print, file"
^DIC(9.4,3,22,21,"PAH",67,1,188,0)="               and shadow servers as shown below."
^DIC(9.4,3,22,21,"PAH",67,1,189,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,190,0)="       NOTE:   If you are an 'OpenM-NT' site, you must have verified the"
^DIC(9.4,3,22,21,"PAH",67,1,191,0)="               routine mapping for every node configuration as outlined in"
^DIC(9.4,3,22,21,"PAH",67,1,192,0)="               Step 7.  You must be logged into the VAH UCI in order to"
^DIC(9.4,3,22,21,"PAH",67,1,193,0)="               complete this step as shown below."
^DIC(9.4,3,22,21,"PAH",67,1,194,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,195,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,196,0)="       Now, once logged into the appropiate UCI as defined above for your"
^DIC(9.4,3,22,21,"PAH",67,1,197,0)="       site, run the KMPLOAD routine."
^DIC(9.4,3,22,21,"PAH",67,1,198,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,199,0)="       > D ^KMPLOAD"
^DIC(9.4,3,22,21,"PAH",67,1,200,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,201,0)="         Loading ZOSVKRx      Saved as %ZOSVKR"
^DIC(9.4,3,22,21,"PAH",67,1,202,0)="         Loading ZOSVKSxE     Saved as %ZOSVKSE"
^DIC(9.4,3,22,21,"PAH",67,1,203,0)="         Loading ZOSVKSxS     Saved as %ZOSVKSS"
^DIC(9.4,3,22,21,"PAH",67,1,204,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,205,0)="         Finished"
^DIC(9.4,3,22,21,"PAH",67,1,206,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,207,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,208,0)="       NOTE:  The above listing of routines is only shown as an example."
^DIC(9.4,3,22,21,"PAH",67,1,209,0)="              The listing that you will obtain will vary depending on your"
^DIC(9.4,3,22,21,"PAH",67,1,210,0)="              system configuration."
^DIC(9.4,3,22,21,"PAH",67,1,211,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,212,0)=" "
^DIC(9.4,3,22,21,"PAH",67,1,213,0)="  9.   The KMP* and %ZOSVK* namespaced routines are NOT recommended to"
^DIC(9.4,3,22,21,"PAH",67,1,214,0)="       be mapped."
^DIC(9.4,3,22,21,"PAH",68,0)="69 SEQ #74^2980831^1"
^DIC(9.4,3,22,21,"PAH",68,1,0)="^^163^163^2980831"
^DIC(9.4,3,22,21,"PAH",68,1,1,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,2,0)="***************************************************************************"
^DIC(9.4,3,22,21,"PAH",68,1,3,0)="Because the %ZIS global is a shared global between many accounts this patch"
^DIC(9.4,3,22,21,"PAH",68,1,4,0)="needs to be installed in each account that access to the %ZIS global at the"
^DIC(9.4,3,22,21,"PAH",68,1,5,0)="same time."
^DIC(9.4,3,22,21,"PAH",68,1,6,0)="***************************************************************************"
^DIC(9.4,3,22,21,"PAH",68,1,7,0)="Read below about changes in how the MARGIN and PAGE LENGTH fields in the"
^DIC(9.4,3,22,21,"PAH",68,1,8,0)="device file have changed."
^DIC(9.4,3,22,21,"PAH",68,1,9,0)="***************************************************************************"
^DIC(9.4,3,22,21,"PAH",68,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,11,0)="                ZISUTL   Errors at Lake City/ Gainsville (a CIRN site) when "
^DIC(9.4,3,22,21,"PAH",68,1,12,0)="                         using the Direct Connect and a printer had been "
^DIC(9.4,3,22,21,"PAH",68,1,13,0)="                         selected but not Opened and the XCSA routine made "
^DIC(9.4,3,22,21,"PAH",68,1,14,0)="                         use of the USE^%ZISUTL call to restore IO variables. "
^DIC(9.4,3,22,21,"PAH",68,1,15,0)="                         "
^DIC(9.4,3,22,21,"PAH",68,1,16,0)="TAM-0298-31594  ZISUTL   Error at Tampa when saved device in Direct Connect"
^DIC(9.4,3,22,21,"PAH",68,1,17,0)="                         had a IO="""". Fixed by not saving device."
^DIC(9.4,3,22,21,"PAH",68,1,18,0)="                         "
^DIC(9.4,3,22,21,"PAH",68,1,19,0)="MAN-0997-11116  ZIS4ONT  Missing lines in spooler output."
^DIC(9.4,3,22,21,"PAH",68,1,20,0)="STC-0997-40029"
^DIC(9.4,3,22,21,"PAH",68,1,21,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,22,0)="BRX-0496-11600  ZIS1     If a job is queued to a device name that isn't"
^DIC(9.4,3,22,21,"PAH",68,1,23,0)="                         defined you get a UNDEF error at SETVAR^%ZIS1."
^DIC(9.4,3,22,21,"PAH",68,1,24,0)="                         This has been fixed."
^DIC(9.4,3,22,21,"PAH",68,1,25,0)="                         "
^DIC(9.4,3,22,21,"PAH",68,1,26,0)="                ZISTCP   Trapping CLOSE errors without clearing $ECODE"
^DIC(9.4,3,22,21,"PAH",68,1,27,0)="                         caused problems."
^DIC(9.4,3,22,21,"PAH",68,1,28,0)="                         Move the OpenM server code to ZISTCPS so the"
^DIC(9.4,3,22,21,"PAH",68,1,29,0)="                         listen tag will work as a single thread server"
^DIC(9.4,3,22,21,"PAH",68,1,30,0)="                         under all OS's.  This causes a change to mail-"
^DIC(9.4,3,22,21,"PAH",68,1,31,0)="                         man routine XMRONT, part of patch XM*7.1*28."
^DIC(9.4,3,22,21,"PAH",68,1,32,0)="                         "
^DIC(9.4,3,22,21,"PAH",68,1,33,0)="AIM-1097-N1741  ZIS4*    When opening a slave device $X and $Y didn't"
^DIC(9.4,3,22,21,"PAH",68,1,34,0)="                ZIS3     get set to zero."
^DIC(9.4,3,22,21,"PAH",68,1,35,0)="                "
^DIC(9.4,3,22,21,"PAH",68,1,36,0)="E3R 10153       ZIS2     If a device has a Access Prohibited time the"
^DIC(9.4,3,22,21,"PAH",68,1,37,0)="                         range was not displayed."
^DIC(9.4,3,22,21,"PAH",68,1,38,0)="                "
^DIC(9.4,3,22,21,"PAH",68,1,39,0)="ISD-0197-71937  ZISS     Getting some Execute fields with a $P when"
^DIC(9.4,3,22,21,"PAH",68,1,40,0)="                ZISS1    the complete node is needed."
^DIC(9.4,3,22,21,"PAH",68,1,41,0)="                ZISS2"
^DIC(9.4,3,22,21,"PAH",68,1,42,0)="                ZISP"
^DIC(9.4,3,22,21,"PAH",68,1,43,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,44,0)="WPB-0897-31818  ZISPL    Under LIST spool document it would only show"
^DIC(9.4,3,22,21,"PAH",68,1,45,0)="                         the HOME device as having printed anything."
^DIC(9.4,3,22,21,"PAH",68,1,46,0)="                         This was because the File was updated before"
^DIC(9.4,3,22,21,"PAH",68,1,47,0)="                         the device was asked."
^DIC(9.4,3,22,21,"PAH",68,1,48,0)="BRK-1197-11008           The Spool data file wasn't getting cleaned up"
^DIC(9.4,3,22,21,"PAH",68,1,49,0)="                         when the Spooler purge routine ran."
^DIC(9.4,3,22,21,"PAH",68,1,50,0)="                         "
^DIC(9.4,3,22,21,"PAH",68,1,51,0)="CLA-0498-22781   ZIS6    Routine %ZIS6 was setting the wrong global for"
^DIC(9.4,3,22,21,"PAH",68,1,52,0)="                         the resource slot sub-file zero node. This has"
^DIC(9.4,3,22,21,"PAH",68,1,53,0)="                         been fixed, The post init will clean-up the"
^DIC(9.4,3,22,21,"PAH",68,1,54,0)="                         ^%ZIS(3.54,n,1,0) nodes.  The TRIGGER X-ref"
^DIC(9.4,3,22,21,"PAH",68,1,55,0)="                         on the $I field of the device file was forceing"
^DIC(9.4,3,22,21,"PAH",68,1,56,0)="                         new entries into the resource file.  This has"
^DIC(9.4,3,22,21,"PAH",68,1,57,0)="                         been fixed and the extra entries will be removed"
^DIC(9.4,3,22,21,"PAH",68,1,58,0)="                         in the post init."
^DIC(9.4,3,22,21,"PAH",68,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,60,0)="With this Kernel patch we have deleted fields *FORM FEED, *BACK SPACE from "
^DIC(9.4,3,22,21,"PAH",68,1,61,0)="the device file.  Removed the asterik from fields *MARGIN WIDTH, *PAGE LENGTH "
^DIC(9.4,3,22,21,"PAH",68,1,62,0)="in the device file while changing the way they work"
^DIC(9.4,3,22,21,"PAH",68,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",68,1,64,0)="First, the X-ref that stuffs these fields when the SUBTYPE field is edited"
^DIC(9.4,3,22,21,"PAH",68,1,65,0)="will be removed so that the MARGIN WIDTH and PAGE LENGTH fields can act as"
^DIC(9.4,3,22,21,"PAH",68,1,66,0)="overrides to the Terminal Type file fields."
^DIC(9.4,3,22,21,"PAH",68,1,67,0)=" "
^DIC(9.4,3,22,21,"PAH",68,1,68,0)="This way if the terminal type file is edited all devices that point to"
^DIC(9.4,3,22,21,"PAH",68,1,69,0)="this entry will get the new values right away, without having to re-index"
^DIC(9.4,3,22,21,"PAH",68,1,70,0)="the subtype field of the device file."
^DIC(9.4,3,22,21,"PAH",68,1,71,0)=" "
^DIC(9.4,3,22,21,"PAH",68,1,72,0)="If a particular device has the same characteristics as others of the same"
^DIC(9.4,3,22,21,"PAH",68,1,73,0)="type but has a different paper size, a new terminal type will not be"
^DIC(9.4,3,22,21,"PAH",68,1,74,0)="needed."
^DIC(9.4,3,22,21,"PAH",68,1,75,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,76,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",68,1,77,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",68,1,78,0)="XUDHRES        917964   1098608    **49,69**"
^DIC(9.4,3,22,21,"PAH",68,1,79,0)="XUINPCH       3950316   4506459    **20,36,49,63,65,69**"
^DIC(9.4,3,22,21,"PAH",68,1,80,0)="ZIS           9308978   9534282    **18,23,69**"
^DIC(9.4,3,22,21,"PAH",68,1,81,0)="ZIS1         10316454  10963783    **18,49,69**"
^DIC(9.4,3,22,21,"PAH",68,1,82,0)="ZIS2         10804239  10569129    **69**"
^DIC(9.4,3,22,21,"PAH",68,1,83,0)="ZIS3          6450084   5727193    **18,36,69**"
^DIC(9.4,3,22,21,"PAH",68,1,84,0)="ZIS4MSM       7202298   7301961    **23,36,49,59,69**"
^DIC(9.4,3,22,21,"PAH",68,1,85,0)="ZIS4ONT       8238234   7540912    **34,59,69**"
^DIC(9.4,3,22,21,"PAH",68,1,86,0)="ZIS4VXD       8151150   7956394    **23,36,49,59,69**"
^DIC(9.4,3,22,21,"PAH",68,1,87,0)="ZIS5          7634324   7647180    **18,24,69**"
^DIC(9.4,3,22,21,"PAH",68,1,88,0)="ZIS6          9917028   9295013    **24,49,69**"
^DIC(9.4,3,22,21,"PAH",68,1,89,0)="ZISC          7980129   8004258    **24,36,49,69**"
^DIC(9.4,3,22,21,"PAH",68,1,90,0)="ZISP          1595683   1756861    **69**"
^DIC(9.4,3,22,21,"PAH",68,1,91,0)="ZISPL        12813725  14330151    **23,69**"
^DIC(9.4,3,22,21,"PAH",68,1,92,0)="ZISPL1        8550686   8439616    **23,36,69**"
^DIC(9.4,3,22,21,"PAH",68,1,93,0)="ZISPL2        4088281   4750042    **23,36,69**"
^DIC(9.4,3,22,21,"PAH",68,1,94,0)="ZISS          8559518   8580158    **69**"
^DIC(9.4,3,22,21,"PAH",68,1,95,0)="ZISS1         7994076   7921540    **69**"
^DIC(9.4,3,22,21,"PAH",68,1,96,0)="ZISS2          845268    846028    **69**"
^DIC(9.4,3,22,21,"PAH",68,1,97,0)="ZISTCP        2660587   2862626    **36,34,59,69**"
^DIC(9.4,3,22,21,"PAH",68,1,98,0)="ZISUTL        2111550   2112295    **18,24,34,69**"
^DIC(9.4,3,22,21,"PAH",68,1,99,0)="ZTMGRSET     12724965  13594462    **34,36,69**"
^DIC(9.4,3,22,21,"PAH",68,1,100,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,101,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,102,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",68,1,103,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",68,1,104,0)=""
^DIC(9.4,3,22,21,"PAH",68,1,105,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",68,1,106,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",68,1,107,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,108,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",68,1,109,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",68,1,110,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,111,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",68,1,112,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",68,1,113,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",68,1,114,0)="      options:"
^DIC(9.4,3,22,21,"PAH",68,1,115,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,116,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",68,1,117,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",68,1,118,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",68,1,119,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",68,1,120,0)="         "
^DIC(9.4,3,22,21,"PAH",68,1,121,0)=" 4.   Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",68,1,122,0)="      user are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",68,1,123,0)="      acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",68,1,124,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",68,1,125,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,126,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",68,1,127,0)="      option:"
^DIC(9.4,3,22,21,"PAH",68,1,128,0)="         Install Package(s)  'XU*8.0*69'"
^DIC(9.4,3,22,21,"PAH",68,1,129,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",68,1,130,0)="         "
^DIC(9.4,3,22,21,"PAH",68,1,131,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",68,1,132,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",68,1,133,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,134,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",68,1,135,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",68,1,136,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",68,1,137,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",68,1,138,0)="      ZIS,ZIS1,ZIS2,ZIS3,ZIS5,ZIS6,ZISC"
^DIC(9.4,3,22,21,"PAH",68,1,139,0)="      ZIS4MSM,ZIS4VXD,ZIS4ONT"
^DIC(9.4,3,22,21,"PAH",68,1,140,0)="      ZISS,ZISS1,ZISS2,ZISP"
^DIC(9.4,3,22,21,"PAH",68,1,141,0)="      ZISUTL"
^DIC(9.4,3,22,21,"PAH",68,1,142,0)="      ZISTCP"
^DIC(9.4,3,22,21,"PAH",68,1,143,0)="      ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",68,1,144,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",68,1,145,0)="       "
^DIC(9.4,3,22,21,"PAH",68,1,146,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",68,1,147,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",68,1,148,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",68,1,149,0)="      Patch number to load: 69"
^DIC(9.4,3,22,21,"PAH",68,1,150,0)="                            =="
^DIC(9.4,3,22,21,"PAH",68,1,151,0)="       "
^DIC(9.4,3,22,21,"PAH",68,1,152,0)="  9.  MSM sites move these routines to the MGR accounts on other CPU's."
^DIC(9.4,3,22,21,"PAH",68,1,153,0)="  "
^DIC(9.4,3,22,21,"PAH",68,1,154,0)=" 10.  ALL sites move routine XUINPCH to all other accounts that share the"
^DIC(9.4,3,22,21,"PAH",68,1,155,0)="      %ZIS global and ""D POST69^XUINPCH"" to clean-up the DD for that account."
^DIC(9.4,3,22,21,"PAH",68,1,156,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,157,0)=" 11.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",68,1,158,0)=" "
^DIC(9.4,3,22,21,"PAH",68,1,159,0)=" 12.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",68,1,160,0)="      Remove Taskman from WAIT State."
^DIC(9.4,3,22,21,"PAH",68,1,161,0)="      "
^DIC(9.4,3,22,21,"PAH",68,1,162,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",68,1,163,0)=""
^DIC(9.4,3,22,21,"PAH",69,0)="88 SEQ #75^2980831^1"
^DIC(9.4,3,22,21,"PAH",70,0)="92 SEQ #76^2980831^1"
^DIC(9.4,3,22,21,"PAH",71,0)="87 SEQ #77^2980831^1"
^DIC(9.4,3,22,21,"PAH",71,1,0)="^^44^44^2980831"
^DIC(9.4,3,22,21,"PAH",71,1,1,0)="                          XU*8*87"
^DIC(9.4,3,22,21,"PAH",71,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",71,1,3,0)="     Patch XU*8*46 should be installed before this one."
^DIC(9.4,3,22,21,"PAH",71,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",71,1,5,0)="     This patch contains two new fields to the Option File"
^DIC(9.4,3,22,21,"PAH",71,1,6,0)="XQUIT MESSAGE and XQUIT EXECUTABLE that were inadvertently"
^DIC(9.4,3,22,21,"PAH",71,1,7,0)="left out of Patch XU*8*46.  The documentation for using"
^DIC(9.4,3,22,21,"PAH",71,1,8,0)="these fields is found in the option Kernel New Features."
^DIC(9.4,3,22,21,"PAH",71,1,9,0)="     This patch also contians a simgle routine that fixes"
^DIC(9.4,3,22,21,"PAH",71,1,10,0)="a bug that went out with that patch.  Dayton discovered"
^DIC(9.4,3,22,21,"PAH",71,1,11,0)="that XQUIT processing did not work with queued options."
^DIC(9.4,3,22,21,"PAH",71,1,12,0)="Frankly, it never occurred to me that XQUIT would be "
^DIC(9.4,3,22,21,"PAH",71,1,13,0)="used in that manner.  They were publishing a report that"
^DIC(9.4,3,22,21,"PAH",71,1,14,0)="they did not want on holidays, so they set the XQUIT "
^DIC(9.4,3,22,21,"PAH",71,1,15,0)="variable in the Entry Action if it was a holiday."
^DIC(9.4,3,22,21,"PAH",71,1,16,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,17,0)="     Checksums were obtained using CHECK^XTSUMBLD."
^DIC(9.4,3,22,21,"PAH",71,1,18,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,19,0)="Routine        Before           After            Patch List"
^DIC(9.4,3,22,21,"PAH",71,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",71,1,21,0)="XQUIT         6864597          6972284            **46,87**"
^DIC(9.4,3,22,21,"PAH",71,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",71,1,23,0)="============================================================"
^DIC(9.4,3,22,21,"PAH",71,1,24,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",71,1,25,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,26,0)="1.  Users are allowed on the system, and this patch may be queued."
^DIC(9.4,3,22,21,"PAH",71,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",71,1,28,0)="2.  This routine is not usually mapped, so you shouldn't have to"
^DIC(9.4,3,22,21,"PAH",71,1,29,0)="    disable mapping."
^DIC(9.4,3,22,21,"PAH",71,1,30,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,31,0)="3.  Use the ""Install/Check Message"" option on the PackMan menu to "
^DIC(9.4,3,22,21,"PAH",71,1,32,0)="    load the package."
^DIC(9.4,3,22,21,"PAH",71,1,33,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,34,0)="4.  On the KIDS menu use the following options:"
^DIC(9.4,3,22,21,"PAH",71,1,35,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,36,0)="     Veryify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",71,1,37,0)="     Print Transport Global (Optional)"
^DIC(9.4,3,22,21,"PAH",71,1,38,0)="     Compare Trasport Global to Current System"
^DIC(9.4,3,22,21,"PAH",71,1,39,0)="     Backup transport Global"
^DIC(9.4,3,22,21,"PAH",71,1,40,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,41,0)="5.  MSM sites answer 'YES' to the question: ""Want to MOVE routines "
^DIC(9.4,3,22,21,"PAH",71,1,42,0)="    to other CPUs?""   AXP sites answer 'NO'."
^DIC(9.4,3,22,21,"PAH",71,1,43,0)="  "
^DIC(9.4,3,22,21,"PAH",71,1,44,0)="6.  Rebuild mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",72,0)="79 SEQ #78^2980831^1"
^DIC(9.4,3,22,21,"PAH",72,1,0)="^^59^59^2980831"
^DIC(9.4,3,22,21,"PAH",72,1,1,0)="BRX-0498-11226,  SBY-0498-30822"
^DIC(9.4,3,22,21,"PAH",72,1,2,0)="When using the remove a error screen user will get an error."
^DIC(9.4,3,22,21,"PAH",72,1,3,0)="Added a FORM to do the editing of Error Screens."
^DIC(9.4,3,22,21,"PAH",72,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",72,1,5,0)="Comments about the counting of errors."
^DIC(9.4,3,22,21,"PAH",72,1,6,0)="SCREEN^%ZTER was changed to count errors of ""Don't Show"" as well as"
^DIC(9.4,3,22,21,"PAH",72,1,7,0)="the ""Don't Record""."
^DIC(9.4,3,22,21,"PAH",72,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",72,1,9,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",72,1,10,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",72,1,11,0)="XUTMKE1       3519416   2055344    **63,79**"
^DIC(9.4,3,22,21,"PAH",72,1,12,0)="XUTMKE2       2696336   4239503    **63,79**"
^DIC(9.4,3,22,21,"PAH",72,1,13,0)="ZTER         19441177  19821674    **8,18,32,24,36,63,73,79**"
^DIC(9.4,3,22,21,"PAH",72,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",72,1,15,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",72,1,16,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",72,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",72,1,18,0)="  1.  DSM sites - One of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",72,1,19,0)="      so you will need to disable mapping for the effected routine."
^DIC(9.4,3,22,21,"PAH",72,1,20,0)="      "
^DIC(9.4,3,22,21,"PAH",72,1,21,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",72,1,22,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",72,1,23,0)="      "
^DIC(9.4,3,22,21,"PAH",72,1,24,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",72,1,25,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",72,1,26,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",72,1,27,0)="      options:"
^DIC(9.4,3,22,21,"PAH",72,1,28,0)="      "
^DIC(9.4,3,22,21,"PAH",72,1,29,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",72,1,30,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",72,1,31,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",72,1,32,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",72,1,33,0)="         "
^DIC(9.4,3,22,21,"PAH",72,1,34,0)=" 4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",72,1,35,0)="     non-peak time."
^DIC(9.4,3,22,21,"PAH",72,1,36,0)="      "
^DIC(9.4,3,22,21,"PAH",72,1,37,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",72,1,38,0)="      option:"
^DIC(9.4,3,22,21,"PAH",72,1,39,0)="      Use ""D ^XPDKRN"" then"
^DIC(9.4,3,22,21,"PAH",72,1,40,0)="         Install Package(s)  'XU*8.0*79'"
^DIC(9.4,3,22,21,"PAH",72,1,41,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",72,1,42,0)="         "
^DIC(9.4,3,22,21,"PAH",72,1,43,0)="      "
^DIC(9.4,3,22,21,"PAH",72,1,44,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",72,1,45,0)="      DSM/MSM sites - you need to move one routines from "
^DIC(9.4,3,22,21,"PAH",72,1,46,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",72,1,47,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",72,1,48,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",72,1,49,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",72,1,50,0)="       "
^DIC(9.4,3,22,21,"PAH",72,1,51,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",72,1,52,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",72,1,53,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",72,1,54,0)="      Patch number to load: 79"
^DIC(9.4,3,22,21,"PAH",72,1,55,0)="                            =="
^DIC(9.4,3,22,21,"PAH",72,1,56,0)="       "
^DIC(9.4,3,22,21,"PAH",72,1,57,0)="  9.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",72,1,58,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",72,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",73,0)="90^2980903^1"
^DIC(9.4,3,22,21,"PAH",73,1,0)="^^214^214^2980903"
^DIC(9.4,3,22,21,"PAH",73,1,1,0)="This patch is being released by Capacity Management (CM) in anticipation"
^DIC(9.4,3,22,21,"PAH",73,1,2,0)="of the national release of the Resource Usage Monitor (RUM) Version 1.0"
^DIC(9.4,3,22,21,"PAH",73,1,3,0)="and Statistical Analysis of Global Growth (SAGG) Version 1.8 software"
^DIC(9.4,3,22,21,"PAH",73,1,4,0)="packages."
^DIC(9.4,3,22,21,"PAH",73,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,6,0)="This patch will not affect the current versions of the RUM and SAGG"
^DIC(9.4,3,22,21,"PAH",73,1,7,0)="software that is running at the sites.  Therefore, all DSM, MSM and"
^DIC(9.4,3,22,21,"PAH",73,1,8,0)="OpenM-NT sites are instructed to install this patch.  Sites which had a"
^DIC(9.4,3,22,21,"PAH",73,1,9,0)="pre-release of SAGG v 1.8 should also install this patch."
^DIC(9.4,3,22,21,"PAH",73,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,11,0)="This patch in conjunction with the future release of SAGG v 1.8 will"
^DIC(9.4,3,22,21,"PAH",73,1,12,0)="support the collection of global growth data from the following operating"
^DIC(9.4,3,22,21,"PAH",73,1,13,0)="system platforms: DSM, MSM and OpenM-NT."
^DIC(9.4,3,22,21,"PAH",73,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,15,0)="This patch distribution will be adding new %ZOSV* routines to the system"
^DIC(9.4,3,22,21,"PAH",73,1,16,0)="specific manager routine set.  The accompanying installation instructions"
^DIC(9.4,3,22,21,"PAH",73,1,17,0)="will guide you in adding these routines to your system."
^DIC(9.4,3,22,21,"PAH",73,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,19,0)="This distribution also contains two routines within the new KMP*"
^DIC(9.4,3,22,21,"PAH",73,1,20,0)="namespace:"
^DIC(9.4,3,22,21,"PAH",73,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,22,0)="   KMPENV      An environment check routine which determines which system"
^DIC(9.4,3,22,21,"PAH",73,1,23,0)="               specific collection routines should be installed.  The"
^DIC(9.4,3,22,21,"PAH",73,1,24,0)="               system variable ^%ZOSF(""OS"") will be used to determine the"
^DIC(9.4,3,22,21,"PAH",73,1,25,0)="               type of sysem on which this distribution is running."
^DIC(9.4,3,22,21,"PAH",73,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,27,0)="   KMPLOAD     A loader routine that will be used to rename the ZOSVK*"
^DIC(9.4,3,22,21,"PAH",73,1,28,0)="               routines to %ZOSVK*."
^DIC(9.4,3,22,21,"PAH",73,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,30,0)="The KMP* namespace has been designated for the use of Capacity Management"
^DIC(9.4,3,22,21,"PAH",73,1,31,0)="routines.  Both of these routines are only necessary for the installation"
^DIC(9.4,3,22,21,"PAH",73,1,32,0)="of this distribution and can be deleted after successful completion of"
^DIC(9.4,3,22,21,"PAH",73,1,33,0)="this patch."
^DIC(9.4,3,22,21,"PAH",73,1,34,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,36,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",73,1,37,0)="============"
^DIC(9.4,3,22,21,"PAH",73,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,39,0)="The installation of this patch does not affect any options.  Therefore,"
^DIC(9.4,3,22,21,"PAH",73,1,40,0)="this installation can be performed at any time of the day with minimal"
^DIC(9.4,3,22,21,"PAH",73,1,41,0)="disruption to users.  Provided the information that is listed immediately"
^DIC(9.4,3,22,21,"PAH",73,1,42,0)="below does NOT apply to your site's configuration, installation should not"
^DIC(9.4,3,22,21,"PAH",73,1,43,0)="take longer than 10-15 minutes."
^DIC(9.4,3,22,21,"PAH",73,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,46,0)="NOTE:  If you are an 'OpenM-NT' site, review the 'NOTE' section in Step 7"
^DIC(9.4,3,22,21,"PAH",73,1,47,0)="       to determine if additional preparation work is necessary."
^DIC(9.4,3,22,21,"PAH",73,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,50,0)="  1.   You will not need to review your mapped routine sets."
^DIC(9.4,3,22,21,"PAH",73,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,53,0)="  2.   Load the patch distribution onto your system by following these"
^DIC(9.4,3,22,21,"PAH",73,1,54,0)="       instructions:"
^DIC(9.4,3,22,21,"PAH",73,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,56,0)="       Enter 'X' at the 'Select MESSAGE Action: IGNORE//' (or DELETE//)"
^DIC(9.4,3,22,21,"PAH",73,1,57,0)="       mail prompt and select the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,3,22,21,"PAH",73,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,60,0)="  3.   From the 'Kernel Installation & Distribution System' (KIDS) menu,"
^DIC(9.4,3,22,21,"PAH",73,1,61,0)="       select the 'Installation' menu."
^DIC(9.4,3,22,21,"PAH",73,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,64,0)="  4.   You may now elect to use the following options: "
^DIC(9.4,3,22,21,"PAH",73,1,65,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,66,0)="             When prompted for the INSTALL NAME, enter XU*8.0*90"
^DIC(9.4,3,22,21,"PAH",73,1,67,0)="                                                       ========="
^DIC(9.4,3,22,21,"PAH",73,1,68,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,69,0)="       a.    Backup a Transport Global - this option will create a backup"
^DIC(9.4,3,22,21,"PAH",73,1,70,0)="             message of any routines exported with this release.  It will"
^DIC(9.4,3,22,21,"PAH",73,1,71,0)="             NOT backup any other changes such as DDs or templates."
^DIC(9.4,3,22,21,"PAH",73,1,72,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,73,0)="       b.    Compare Transport Global to Current System - this option will"
^DIC(9.4,3,22,21,"PAH",73,1,74,0)="             allow you to view all changes that will be made when the"
^DIC(9.4,3,22,21,"PAH",73,1,75,0)="             release is installed.  It compares all components of the"
^DIC(9.4,3,22,21,"PAH",73,1,76,0)="             release (routines, DDs, templates, etc.)."
^DIC(9.4,3,22,21,"PAH",73,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,78,0)="       c.    Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,3,22,21,"PAH",73,1,79,0)="             you to ensure the integrity of the routines that are in the"
^DIC(9.4,3,22,21,"PAH",73,1,80,0)="             transport global."
^DIC(9.4,3,22,21,"PAH",73,1,81,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,82,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,83,0)="  5.   Use the 'Install Package(s)' option and select the package"
^DIC(9.4,3,22,21,"PAH",73,1,84,0)="       XU*8.0*90."
^DIC(9.4,3,22,21,"PAH",73,1,85,0)="       ========="
^DIC(9.4,3,22,21,"PAH",73,1,86,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,88,0)="  6.   When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,3,22,21,"PAH",73,1,89,0)="       Protocols? NO//', you can respond with NO."
^DIC(9.4,3,22,21,"PAH",73,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,91,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,92,0)="  7.   If you are either a 'DSM for OpenVMS' or 'MSM-DOS' site, after"
^DIC(9.4,3,22,21,"PAH",73,1,93,0)="       successful completion of the installation, move and restore the"
^DIC(9.4,3,22,21,"PAH",73,1,94,0)="       KMPLOAD and ZOSVK* routines to the MGR UCI(s) with the ^%RS and"
^DIC(9.4,3,22,21,"PAH",73,1,95,0)="       ^%RR system routines."
^DIC(9.4,3,22,21,"PAH",73,1,96,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,97,0)="       If you are a 'MSM-DOS' site, you must also move these routines to"
^DIC(9.4,3,22,21,"PAH",73,1,98,0)="       all MGR UCIs on every CPU, such as, compute, print, file and shadow"
^DIC(9.4,3,22,21,"PAH",73,1,99,0)="       servers.   "
^DIC(9.4,3,22,21,"PAH",73,1,100,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,101,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,102,0)="       NOTE:   If you are a 'OpenM-NT' site, you must verify that the"
^DIC(9.4,3,22,21,"PAH",73,1,103,0)="               routine mapping configuration on each of your NT system(s)"
^DIC(9.4,3,22,21,"PAH",73,1,104,0)="               contains %ZO* or, at least, %ZOSV*."
^DIC(9.4,3,22,21,"PAH",73,1,105,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,106,0)="               You MUST review the mapping configuration on ALL of your"
^DIC(9.4,3,22,21,"PAH",73,1,107,0)="               NT-VISTA Network configuration files (i.e., VANETA.DEF and"
^DIC(9.4,3,22,21,"PAH",73,1,108,0)="               VANETB.DEF)."
^DIC(9.4,3,22,21,"PAH",73,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,110,0)="               If needed, you will also need to modify ALL of your"
^DIC(9.4,3,22,21,"PAH",73,1,111,0)="               NT-VISTA Network configuration files (i.e., VANETA.DEF and"
^DIC(9.4,3,22,21,"PAH",73,1,112,0)="               VANETB.DEF)."
^DIC(9.4,3,22,21,"PAH",73,1,113,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,114,0)="               Use the following instructions to complete this task:"
^DIC(9.4,3,22,21,"PAH",73,1,115,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,116,0)="               On the 'Open M NextGen Thin Client' buttons, click on the"
^DIC(9.4,3,22,21,"PAH",73,1,117,0)="               'Configure Open M' (i.e., Wizard) button."
^DIC(9.4,3,22,21,"PAH",73,1,118,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,119,0)="               On the top menu line of the 'Open M Configurations' window:"
^DIC(9.4,3,22,21,"PAH",73,1,120,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,121,0)="                  Select File"
^DIC(9.4,3,22,21,"PAH",73,1,122,0)="                         -"
^DIC(9.4,3,22,21,"PAH",73,1,123,0)="                    Edit Network Configuration..."
^DIC(9.4,3,22,21,"PAH",73,1,124,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,125,0)="               On the top menu line of the 'Open M - Namespace/Network"
^DIC(9.4,3,22,21,"PAH",73,1,126,0)="               Configuration' window:"
^DIC(9.4,3,22,21,"PAH",73,1,127,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,128,0)="                  Select File"
^DIC(9.4,3,22,21,"PAH",73,1,129,0)="                         -"
^DIC(9.4,3,22,21,"PAH",73,1,130,0)="                    Open Configuration [Remote]..."
^DIC(9.4,3,22,21,"PAH",73,1,131,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,132,0)="               A 'Choose Connection' window opens:"
^DIC(9.4,3,22,21,"PAH",73,1,133,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,134,0)="                  Choose the appropriate 'Connection' to your NT system"
^DIC(9.4,3,22,21,"PAH",73,1,135,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,136,0)="                    Click the 'OK' button"
^DIC(9.4,3,22,21,"PAH",73,1,137,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,138,0)="               Select the correct system from the 'File Name' box"
^DIC(9.4,3,22,21,"PAH",73,1,139,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,140,0)="               *** You will need to review ALL of your ***"
^DIC(9.4,3,22,21,"PAH",73,1,141,0)="               ***         VISTA configurations        ***"
^DIC(9.4,3,22,21,"PAH",73,1,142,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,143,0)="                    Click the 'OK' button"
^DIC(9.4,3,22,21,"PAH",73,1,144,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,145,0)="               Click on the 'Routine Mapping' radial button  -> o"
^DIC(9.4,3,22,21,"PAH",73,1,146,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,147,0)="               Review the entries and ensure that the following is"
^DIC(9.4,3,22,21,"PAH",73,1,148,0)="               present:"
^DIC(9.4,3,22,21,"PAH",73,1,149,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,150,0)="                Routines       Type      Destination Location"
^DIC(9.4,3,22,21,"PAH",73,1,151,0)="                --------       ----      --------------------"
^DIC(9.4,3,22,21,"PAH",73,1,152,0)="                %ZO*           ALL       ROU"
^DIC(9.4,3,22,21,"PAH",73,1,153,0)="        (or, at least, %ZOSV*)"
^DIC(9.4,3,22,21,"PAH",73,1,154,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,155,0)="               If the above is present, continue to Step 8."
^DIC(9.4,3,22,21,"PAH",73,1,156,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,157,0)="               However, if the above is NOT present, click the 'Insert"
^DIC(9.4,3,22,21,"PAH",73,1,158,0)="               Mapping' button and add %ZO* to the routine mapping list."
^DIC(9.4,3,22,21,"PAH",73,1,159,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,160,0)="               Then, on the top menu line of the 'Open M Namespace/Network"
^DIC(9.4,3,22,21,"PAH",73,1,161,0)="               Configuration' window:"
^DIC(9.4,3,22,21,"PAH",73,1,162,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,163,0)="                  Select File"
^DIC(9.4,3,22,21,"PAH",73,1,164,0)="                         -"
^DIC(9.4,3,22,21,"PAH",73,1,165,0)="                    Save Configuration"
^DIC(9.4,3,22,21,"PAH",73,1,166,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,167,0)="               Restart OpenM after making this change on ALL VISTA"
^DIC(9.4,3,22,21,"PAH",73,1,168,0)="               configurations of the OpenM-NT cluster."
^DIC(9.4,3,22,21,"PAH",73,1,169,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,170,0)="               Review ALL of your NT-VISTA configurations and make the"
^DIC(9.4,3,22,21,"PAH",73,1,171,0)="               appropriate modifications, if necessary."
^DIC(9.4,3,22,21,"PAH",73,1,172,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,173,0)="               After restarting your OpenM systems, you will log into the"
^DIC(9.4,3,22,21,"PAH",73,1,174,0)="               VAH UCI to complete the next step."
^DIC(9.4,3,22,21,"PAH",73,1,175,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,176,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,177,0)="  8.   All sites must run the KMPLOAD routine in order to rename the"
^DIC(9.4,3,22,21,"PAH",73,1,178,0)="       system specific collection routines to the %ZOSVK-namespace."
^DIC(9.4,3,22,21,"PAH",73,1,179,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,180,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,181,0)="       NOTE:   If you are a 'DSM for OpenVMS' site, you must have"
^DIC(9.4,3,22,21,"PAH",73,1,182,0)="               performed Step 7 and be logged into the MCR UCI in order to"
^DIC(9.4,3,22,21,"PAH",73,1,183,0)="               complete this step as shown below."
^DIC(9.4,3,22,21,"PAH",73,1,184,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,185,0)="       NOTE:   If you are a 'MSM-DOS' site, you must have performed Step 7"
^DIC(9.4,3,22,21,"PAH",73,1,186,0)="               and be logged into the MGR UCI.  You must run this routine"
^DIC(9.4,3,22,21,"PAH",73,1,187,0)="               on all MGR UCIs on every CPU, such as, compute, print, file"
^DIC(9.4,3,22,21,"PAH",73,1,188,0)="               and shadow servers as shown below."
^DIC(9.4,3,22,21,"PAH",73,1,189,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,190,0)="       NOTE:   If you are an 'OpenM-NT' site, you must have verified the"
^DIC(9.4,3,22,21,"PAH",73,1,191,0)="               routine mapping for every node configuration as outlined in"
^DIC(9.4,3,22,21,"PAH",73,1,192,0)="               Step 7.  You must be logged into the VAH UCI in order to"
^DIC(9.4,3,22,21,"PAH",73,1,193,0)="               complete this step as shown below."
^DIC(9.4,3,22,21,"PAH",73,1,194,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,195,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,196,0)="       Now, once logged into the appropiate UCI as defined above for your"
^DIC(9.4,3,22,21,"PAH",73,1,197,0)="       site, run the KMPLOAD routine."
^DIC(9.4,3,22,21,"PAH",73,1,198,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,199,0)="       > D ^KMPLOAD"
^DIC(9.4,3,22,21,"PAH",73,1,200,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,201,0)="         Loading ZOSVKRx      Saved as %ZOSVKR"
^DIC(9.4,3,22,21,"PAH",73,1,202,0)="         Loading ZOSVKSxE     Saved as %ZOSVKSE"
^DIC(9.4,3,22,21,"PAH",73,1,203,0)="         Loading ZOSVKSxS     Saved as %ZOSVKSS"
^DIC(9.4,3,22,21,"PAH",73,1,204,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,205,0)="         Finished"
^DIC(9.4,3,22,21,"PAH",73,1,206,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,207,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,208,0)="       NOTE:  The above listing of routines is only shown as an example."
^DIC(9.4,3,22,21,"PAH",73,1,209,0)="              The listing that you will obtain will vary depending on your"
^DIC(9.4,3,22,21,"PAH",73,1,210,0)="              system configuration."
^DIC(9.4,3,22,21,"PAH",73,1,211,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,212,0)=" "
^DIC(9.4,3,22,21,"PAH",73,1,213,0)="  9.   The KMP* and %ZOSVK* namespaced routines are NOT recommended to"
^DIC(9.4,3,22,21,"PAH",73,1,214,0)="       be mapped."
^DIC(9.4,3,22,21,"PAH",74,0)="34 SEQ #79^2980923^1"
^DIC(9.4,3,22,21,"PAH",74,1,0)="^^54^54^2980923"
^DIC(9.4,3,22,21,"PAH",74,1,1,0)="For ALPHA/NT OpenM/Cache sites, these routines were included in"
^DIC(9.4,3,22,21,"PAH",74,1,2,0)="the KRN_ONT_34.RTN file(s) that were used as part of the conversion"
^DIC(9.4,3,22,21,"PAH",74,1,3,0)="process to OpenM/Cache. This file went through several revisions "
^DIC(9.4,3,22,21,"PAH",74,1,4,0)="during the course of the project so depending on when a site"
^DIC(9.4,3,22,21,"PAH",74,1,5,0)="converted, the old checksums for these routines may vary from what"
^DIC(9.4,3,22,21,"PAH",74,1,6,0)="this patch indicates.  Avaliable Jobs and Act Jobs adjusted to work"
^DIC(9.4,3,22,21,"PAH",74,1,7,0)="with both OpenM (NextGen Build52e) and Cache."
^DIC(9.4,3,22,21,"PAH",74,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",74,1,9,0)="This patch is only needed by OpenM sites, Installing at other sites"
^DIC(9.4,3,22,21,"PAH",74,1,10,0)="will not cause any problems."
^DIC(9.4,3,22,21,"PAH",74,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",74,1,12,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",74,1,13,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",74,1,14,0)="XGKB          3707191   3850098    **34**"
^DIC(9.4,3,22,21,"PAH",74,1,15,0)="XUCIONT                 2479520    **34**"
^DIC(9.4,3,22,21,"PAH",74,1,16,0)="ZISFONT                 4576199    **34**"
^DIC(9.4,3,22,21,"PAH",74,1,17,0)="ZISHONT       5001907   5018937    **34,65,84**"
^DIC(9.4,3,22,21,"PAH",74,1,18,0)="ZOSFONT                 6905729    **34**"
^DIC(9.4,3,22,21,"PAH",74,1,19,0)="ZOSVONT                 5179039    **34**"
^DIC(9.4,3,22,21,"PAH",74,1,20,0)="ZTMGRSET     13364303  13594462    **34,36,69**"
^DIC(9.4,3,22,21,"PAH",74,1,21,0)="ZUONT         1897334   1794899    **34**"
^DIC(9.4,3,22,21,"PAH",74,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",74,1,23,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",74,1,24,0)=" Installation:"
^DIC(9.4,3,22,21,"PAH",74,1,25,0)="     "
^DIC(9.4,3,22,21,"PAH",74,1,26,0)=" 1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",74,1,27,0)="     option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",74,1,28,0)="     "
^DIC(9.4,3,22,21,"PAH",74,1,29,0)=" 2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",74,1,30,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",74,1,31,0)="     "
^DIC(9.4,3,22,21,"PAH",74,1,32,0)=" 3.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",74,1,33,0)="     non-peek time."
^DIC(9.4,3,22,21,"PAH",74,1,34,0)="     This patch can NOT be queued."
^DIC(9.4,3,22,21,"PAH",74,1,35,0)="   "
^DIC(9.4,3,22,21,"PAH",74,1,36,0)=" 4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",74,1,37,0)="     options:"
^DIC(9.4,3,22,21,"PAH",74,1,38,0)="     "
^DIC(9.4,3,22,21,"PAH",74,1,39,0)="        Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",74,1,40,0)="        Print Transport Global"
^DIC(9.4,3,22,21,"PAH",74,1,41,0)="        Compare Transport Global to Current System      "
^DIC(9.4,3,22,21,"PAH",74,1,42,0)="        Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",74,1,43,0)="        Install Package(s)  'XU*8.0*34'"
^DIC(9.4,3,22,21,"PAH",74,1,44,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",74,1,45,0)="                             "
^DIC(9.4,3,22,21,"PAH",74,1,46,0)=" 5.   *** OpenM sites ONLY ***  After installing this patch."
^DIC(9.4,3,22,21,"PAH",74,1,47,0)="      a. You need to rename ZUONT to ZU."
^DIC(9.4,3,22,21,"PAH",74,1,48,0)="      b. DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",74,1,49,0)="         Select the System"
^DIC(9.4,3,22,21,"PAH",74,1,50,0)="         Patch number to load: 34"
^DIC(9.4,3,22,21,"PAH",74,1,51,0)="                               =="
^DIC(9.4,3,22,21,"PAH",74,1,52,0)="    "
^DIC(9.4,3,22,21,"PAH",74,1,53,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",74,1,54,0)=""
^DIC(9.4,3,22,21,"PAH",75,0)="85 SEQ #80^2981007^1"
^DIC(9.4,3,22,21,"PAH",76,0)="95 SEQ #81^2981007^1"
^DIC(9.4,3,22,21,"PAH",77,0)="97 SEQ #82^2981007^1"
^DIC(9.4,3,22,21,"PAH",77,1,0)="^^50^50^2981007"
^DIC(9.4,3,22,21,"PAH",77,1,1,0)="DBIA     XUSER   New file 200 API for DSS."
^DIC(9.4,3,22,21,"PAH",77,1,2,0)="                 The call is S X=$$DIV4^XUSER(.ZZ[,duz])"
^DIC(9.4,3,22,21,"PAH",77,1,3,0)="                 Input: The first parameter is a local variable that"
^DIC(9.4,3,22,21,"PAH",77,1,4,0)="                 is passed by reference. "
^DIC(9.4,3,22,21,"PAH",77,1,5,0)="                  The second is optional a IEN to the New Person file."
^DIC(9.4,3,22,21,"PAH",77,1,6,0)="                 If not passed it defaults to the current DUZ."
^DIC(9.4,3,22,21,"PAH",77,1,7,0)="                 Outout: Returns a 1 if the user has a Division entry"
^DIC(9.4,3,22,21,"PAH",77,1,8,0)="                 in the New Person file, else returns 0."
^DIC(9.4,3,22,21,"PAH",77,1,9,0)="                 If it returns a 1 then the first parameter is an array"
^DIC(9.4,3,22,21,"PAH",77,1,10,0)="                 of IEN's for file 4 that have been assigned to the user."
^DIC(9.4,3,22,21,"PAH",77,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",77,1,12,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",77,1,13,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",77,1,14,0)="XUSER         1279527   1441396    **75,97**"
^DIC(9.4,3,22,21,"PAH",77,1,15,0)="                 "
^DIC(9.4,3,22,21,"PAH",77,1,16,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",77,1,17,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",77,1,18,0)=""
^DIC(9.4,3,22,21,"PAH",77,1,19,0)="  1.  DSM sites - This routine may be mapped, if so you will need"
^DIC(9.4,3,22,21,"PAH",77,1,20,0)="      to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",77,1,21,0)="     "
^DIC(9.4,3,22,21,"PAH",77,1,22,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",77,1,23,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",77,1,24,0)="     "
^DIC(9.4,3,22,21,"PAH",77,1,25,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",77,1,26,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",77,1,27,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",77,1,28,0)="      options:"
^DIC(9.4,3,22,21,"PAH",77,1,29,0)="      "
^DIC(9.4,3,22,21,"PAH",77,1,30,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",77,1,31,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",77,1,32,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",77,1,33,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",77,1,34,0)="     "
^DIC(9.4,3,22,21,"PAH",77,1,35,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",77,1,36,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",77,1,37,0)="     "
^DIC(9.4,3,22,21,"PAH",77,1,38,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",77,1,39,0)="      option:"
^DIC(9.4,3,22,21,"PAH",77,1,40,0)="      Use ""D ^XPDKRN"" then ***"
^DIC(9.4,3,22,21,"PAH",77,1,41,0)="        Install Package(s)  'XU*8.0*97'"
^DIC(9.4,3,22,21,"PAH",77,1,42,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",77,1,43,0)="                             "
^DIC(9.4,3,22,21,"PAH",77,1,44,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",77,1,45,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",77,1,46,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",77,1,47,0)="     "
^DIC(9.4,3,22,21,"PAH",77,1,48,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",77,1,49,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",77,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",78,0)="89 SEQ #83^2981016^1"
^DIC(9.4,3,22,21,"PAH",78,1,0)="^^40^40^2981016"
^DIC(9.4,3,22,21,"PAH",78,1,1,0)="     Patch XU*8*81 should be installed first."
^DIC(9.4,3,22,21,"PAH",78,1,2,0)="   "
^DIC(9.4,3,22,21,"PAH",78,1,3,0)="     This patch contains 1 routine that has been modified to correct"
^DIC(9.4,3,22,21,"PAH",78,1,4,0)="a problem encountered by the menu rebuild system.  Under certain"
^DIC(9.4,3,22,21,"PAH",78,1,5,0)="circumstances the Common Options in the menu XUCOMMAND were not being"
^DIC(9.4,3,22,21,"PAH",78,1,6,0)="time-stamped properly, causing this menu to be rebuilt frequently and"
^DIC(9.4,3,22,21,"PAH",78,1,7,0)="unnecessarily.  This could result in an <UNDEFINED> error while the menu "
^DIC(9.4,3,22,21,"PAH",78,1,8,0)="was being rebuilt."
^DIC(9.4,3,22,21,"PAH",78,1,9,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,10,0)="     Checksums were calculated by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",78,1,11,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,12,0)="     The first line of your routine should look like this:"
^DIC(9.4,3,22,21,"PAH",78,1,13,0)="              ;;8.0;KERNEL;**81,89**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",78,1,14,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,15,0)="Routine  Before       After           Patch List"
^DIC(9.4,3,22,21,"PAH",78,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",78,1,17,0)="XQ8     12888022     11887347          **81,89**"
^DIC(9.4,3,22,21,"PAH",78,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",78,1,19,0)="============================================================"
^DIC(9.4,3,22,21,"PAH",78,1,20,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",78,1,21,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,22,0)="1.  Users are allowed on the system, and this patch may be queued."
^DIC(9.4,3,22,21,"PAH",78,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",78,1,24,0)="2.  This routine is not usually mapped, so you shouldn't have to"
^DIC(9.4,3,22,21,"PAH",78,1,25,0)="    disable mapping."
^DIC(9.4,3,22,21,"PAH",78,1,26,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,27,0)="3.  Use the ""Install/Check Message"" option on the PackMan menu to "
^DIC(9.4,3,22,21,"PAH",78,1,28,0)="    load the package."
^DIC(9.4,3,22,21,"PAH",78,1,29,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,30,0)="4.  On the KIDS menu use the following options:"
^DIC(9.4,3,22,21,"PAH",78,1,31,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,32,0)="     Veryify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",78,1,33,0)="     Print Transport Global (Optional)"
^DIC(9.4,3,22,21,"PAH",78,1,34,0)="     Compare Trasport Global to Current System"
^DIC(9.4,3,22,21,"PAH",78,1,35,0)="     Backup transport Global"
^DIC(9.4,3,22,21,"PAH",78,1,36,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,37,0)="5.  MSM sites answer 'YES' to the question: ""Want to MOVE routines "
^DIC(9.4,3,22,21,"PAH",78,1,38,0)="    to other CPUs?""   AXP sites answer 'NO'."
^DIC(9.4,3,22,21,"PAH",78,1,39,0)="  "
^DIC(9.4,3,22,21,"PAH",78,1,40,0)="6.  Rebuild mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",79,0)="86 SEQ #84^2981016^1"
^DIC(9.4,3,22,21,"PAH",79,1,0)="^^85^85^2981016"
^DIC(9.4,3,22,21,"PAH",79,1,1,0)="WPB-0598-31519  XUTM*   When listing tasks, a 2 digit year was used in the"
^DIC(9.4,3,22,21,"PAH",79,1,2,0)="                        display.  There shouldn't be any confusion with"
^DIC(9.4,3,22,21,"PAH",79,1,3,0)="                        a task scheduled for 2000 being mistaken for 1900."
^DIC(9.4,3,22,21,"PAH",79,1,4,0)="                        This NOIS pointed out that 2097 could be mistaken"
^DIC(9.4,3,22,21,"PAH",79,1,5,0)="                        for 1997 and make user wonder why the task was so"
^DIC(9.4,3,22,21,"PAH",79,1,6,0)="                        late.  Reports now use 4 digit years."
^DIC(9.4,3,22,21,"PAH",79,1,7,0)="                        "
^DIC(9.4,3,22,21,"PAH",79,1,8,0)="BRX-0298-12277  XUTMRP  User would get an UNDEF if trying to re-point a"
^DIC(9.4,3,22,21,"PAH",79,1,9,0)="                        device that was OUT-OF-SERVICE. Fixed by not"
^DIC(9.4,3,22,21,"PAH",79,1,10,0)="                        checking the OOS field on the OLD device."
^DIC(9.4,3,22,21,"PAH",79,1,11,0)="                        Changed to allow longer $I's in OpenM."
^DIC(9.4,3,22,21,"PAH",79,1,12,0)="                        "
^DIC(9.4,3,22,21,"PAH",79,1,13,0)="TAM-1098-31054  XUTMRP1 Was failing to clear a Lock on each task repointed."
^DIC(9.4,3,22,21,"PAH",79,1,14,0)="                        "
^DIC(9.4,3,22,21,"PAH",79,1,15,0)="MON-0798-50789  XLFDT2  If a task had a requeue schedule of ""1M"", the"
^DIC(9.4,3,22,21,"PAH",79,1,16,0)="FAR-0798-40749          time for rescheduling would be lost."
^DIC(9.4,3,22,21,"PAH",79,1,17,0)="                        Fixed to correctly bring forward the schedule time."
^DIC(9.4,3,22,21,"PAH",79,1,18,0)="                        "
^DIC(9.4,3,22,21,"PAH",79,1,19,0)="BRK-0998-11910  ZTER    When checking for SCREENED errors, only the first"
^DIC(9.4,3,22,21,"PAH",79,1,20,0)="OKL-0998-71037  XUTMKE  string in the list was checked.  Taskman error"
^DIC(9.4,3,22,21,"PAH",79,1,21,0)="CIN-0998-42052          display updated to use the new screening list."
^DIC(9.4,3,22,21,"PAH",79,1,22,0)="                        "
^DIC(9.4,3,22,21,"PAH",79,1,23,0)="                        "
^DIC(9.4,3,22,21,"PAH",79,1,24,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",79,1,25,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",79,1,26,0)="XLFDT2        3530137   3530137    **71,86**"
^DIC(9.4,3,22,21,"PAH",79,1,27,0)="XUTMKE       11733011  11960485    **86**"
^DIC(9.4,3,22,21,"PAH",79,1,28,0)="XUTMRP       15458022  15705216    **2,20,86**"
^DIC(9.4,3,22,21,"PAH",79,1,29,0)="XUTMRP1       6998776   7012212    **2,86**"
^DIC(9.4,3,22,21,"PAH",79,1,30,0)="XUTMTP       10672535  10473436    **20,86**"
^DIC(9.4,3,22,21,"PAH",79,1,31,0)="XUTMTR1      13285469  12285561    **86**"
^DIC(9.4,3,22,21,"PAH",79,1,32,0)="XUTMTR2       9481244   8489866    **86**"
^DIC(9.4,3,22,21,"PAH",79,1,33,0)="XUTMUSE2     13026855  13051739    **36,86**"
^DIC(9.4,3,22,21,"PAH",79,1,34,0)="ZTER         19821674  19873831    **8,18,32,24,36,63,73,79,86**"
^DIC(9.4,3,22,21,"PAH",79,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",79,1,36,0)="List of preceding patches: 2, 8, 18, 20, 24, 32, 36, 63, 71, 73, 79"
^DIC(9.4,3,22,21,"PAH",79,1,37,0)="Checksum's calculated by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",79,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",79,1,39,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",79,1,40,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",79,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",79,1,42,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",79,1,43,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",79,1,44,0)="     "
^DIC(9.4,3,22,21,"PAH",79,1,45,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",79,1,46,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",79,1,47,0)="     "
^DIC(9.4,3,22,21,"PAH",79,1,48,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",79,1,49,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",79,1,50,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",79,1,51,0)="      options:"
^DIC(9.4,3,22,21,"PAH",79,1,52,0)="      "
^DIC(9.4,3,22,21,"PAH",79,1,53,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",79,1,54,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",79,1,55,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",79,1,56,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",79,1,57,0)="     "
^DIC(9.4,3,22,21,"PAH",79,1,58,0)="  4.  Users can remain on the system."
^DIC(9.4,3,22,21,"PAH",79,1,59,0)="     "
^DIC(9.4,3,22,21,"PAH",79,1,60,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",79,1,61,0)="      option:"
^DIC(9.4,3,22,21,"PAH",79,1,62,0)="        Install Package(s)  'XU*8.0*86'"
^DIC(9.4,3,22,21,"PAH",79,1,63,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",79,1,64,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",79,1,65,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",79,1,66,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",79,1,67,0)="        "
^DIC(9.4,3,22,21,"PAH",79,1,68,0)="  6.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",79,1,69,0)="       OpenM Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",79,1,70,0)="       DSM/MSM sites - you need to move one routine from "
^DIC(9.4,3,22,21,"PAH",79,1,71,0)="       your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",79,1,72,0)="      "
^DIC(9.4,3,22,21,"PAH",79,1,73,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",79,1,74,0)="      "
^DIC(9.4,3,22,21,"PAH",79,1,75,0)="  7.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",79,1,76,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",79,1,77,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",79,1,78,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",79,1,79,0)="      Patch number to load: 86"
^DIC(9.4,3,22,21,"PAH",79,1,80,0)="                            =="
^DIC(9.4,3,22,21,"PAH",79,1,81,0)="       "
^DIC(9.4,3,22,21,"PAH",79,1,82,0)="  8.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",79,1,83,0)=""
^DIC(9.4,3,22,21,"PAH",79,1,84,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",79,1,85,0)=""
^DIC(9.4,3,22,21,"PAH",80,0)="94 SEQ #85^2981026^1"
^DIC(9.4,3,22,21,"PAH",80,1,0)="^^121^121^2981026"
^DIC(9.4,3,22,21,"PAH",80,1,1,0)="This patch is in support of the new Capacity Management namespace KMPR."
^DIC(9.4,3,22,21,"PAH",80,1,2,0)="The Kernel routines will call ^%ZOSVKR through %ZOSV and the XQOR routines"
^DIC(9.4,3,22,21,"PAH",80,1,3,0)="will call %ZOSVKR directly."
^DIC(9.4,3,22,21,"PAH",80,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,5,0)="The %ZOSV routine has been modified to call the new %ZOSVKR routine."
^DIC(9.4,3,22,21,"PAH",80,1,6,0)="This should help protect folks outside of the VA who use VistA."
^DIC(9.4,3,22,21,"PAH",80,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",80,1,8,0)="The ZTMGRSET routine has been updated to save the new routine under the"
^DIC(9.4,3,22,21,"PAH",80,1,9,0)="correct name."
^DIC(9.4,3,22,21,"PAH",80,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,11,0)="The ZOSVKR* and ZOSVKS* are included unchanged at the request of the DBA."
^DIC(9.4,3,22,21,"PAH",80,1,12,0)="These routines were introduced with patch XU*8*90.  Patch XU*8*90"
^DIC(9.4,3,22,21,"PAH",80,1,13,0)="installed certain ZOSVKR* and ZOSVKS* routines based on your platform's"
^DIC(9.4,3,22,21,"PAH",80,1,14,0)="operating system.  Please do not be alarmed if you are notified prior to"
^DIC(9.4,3,22,21,"PAH",80,1,15,0)="installing patch XU*8*94 that certain ZOSVKR* and ZOSVKS* routine do not"
^DIC(9.4,3,22,21,"PAH",80,1,16,0)="exist in your account."
^DIC(9.4,3,22,21,"PAH",80,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,18,0)="MWV-0398-21933  ZTMS3  Add to the after task cleanup IO(""P""),IO(""DOC"")"
^DIC(9.4,3,22,21,"PAH",80,1,19,0)="                       so they can't upset re-queuing of following tasks."
^DIC(9.4,3,22,21,"PAH",80,1,20,0)=""
