^DIC(9.4,9,22,4,"PAH","B","41 SEQ #40",40)=""
^DIC(9.4,9,22,4,"PAH","B","42 SEQ #41",41)=""
^DIC(9.4,9,22,4,"PAH","B","43 SEQ #45",45)=""
^DIC(9.4,9,22,4,"PAH","B","44 SEQ #42",42)=""
^DIC(9.4,9,22,4,"PAH","B","45 SEQ #43",43)=""
^DIC(9.4,9,22,4,"PAH","B","46 SEQ #44",44)=""
^DIC(9.4,9,22,4,"PAH","B","48 SEQ #46",46)=""
^DIC(9.4,9,22,4,"PAH","B","49 SEQ #47",47)=""
^DIC(9.4,9,22,4,"PAH","B","5 SEQ #7  ;Created on Jan 11, ",7)=""
^DIC(9.4,9,22,4,"PAH","B","51 SEQ #48",48)=""
^DIC(9.4,9,22,4,"PAH","B","52 SEQ #49",49)=""
^DIC(9.4,9,22,4,"PAH","B","55 SEQ #50",50)=""
^DIC(9.4,9,22,4,"PAH","B","6 SEQ #4",4)=""
^DIC(9.4,9,22,4,"PAH","B","7 SEQ #5",5)=""
^DIC(9.4,9,22,4,"PAH","B","9 SEQ #11",11)=""
^DIC(9.4,9,22,"B",5.5,4)=""
^DIC(9.4,9,22,"B","5.0",3.3)=""
^DIC(9.4,9,"DEV")="BOB LUSHENE/HISC"
^DIC(9.4,9,"EX",0)="^9.432^1^1"
^DIC(9.4,9,"EX",1,0)="FHZ"
^DIC(9.4,9,"INIT")="FHIPST^2960605.131101"
^DIC(9.4,9,"PRE")="^"
^DIC(9.4,9,"VERSION")=5.5
^DIC(9.4,11,0)="AUTOMATED LAB INSTRUMENTS^LA^Lab Auto-Instrument Package"
^DIC(9.4,11,1,0)="^^17^17^2960715^^^^"
^DIC(9.4,11,1,1,0)="This a is list of routines and files needed for"
^DIC(9.4,11,1,2,0)="LAB auto instruments.  This release has routines for"
^DIC(9.4,11,1,3,0)="microbiology instruments along with attendant verify routines."
^DIC(9.4,11,1,4,0)="The release also carries with it routines for some instruments to be"
^DIC(9.4,11,1,5,0)="run in a bidirectional mode."
^DIC(9.4,11,1,6,0)=" "
^DIC(9.4,11,1,7,0)="In some cases we have added some routines which will run an instrument"
^DIC(9.4,11,1,8,0)="directly connected to the CPU instead of going through the LSI.  This"
^DIC(9.4,11,1,9,0)="has been done because of problems with timing, and/or problems"
^DIC(9.4,11,1,10,0)="with the method of data transmission protocols.  You can usually"
^DIC(9.4,11,1,11,0)="tell a direct connect instrument by the routine name being LAnnnnXX"
^DIC(9.4,11,1,12,0)="where the XX will need to be changed before running and the nnnn will"
^DIC(9.4,11,1,13,0)="identify the instrument."
^DIC(9.4,11,1,14,0)=" "
^DIC(9.4,11,1,15,0)="With this release there is also a new error trap for auto instruments."
^DIC(9.4,11,1,16,0)="This trap does not use the system error trap and therefore does not"
^DIC(9.4,11,1,17,0)="create any special system problems."
^DIC(9.4,11,4,0)="^9.44PA^1^1"
^DIC(9.4,11,4,1,0)=62.4
^DIC(9.4,11,4,1,222)="y^n^^n^^^n^^"
^DIC(9.4,11,4,"B",62.4,1)=""
^DIC(9.4,11,5)="DALLAS"
^DIC(9.4,11,7)="^^I"
^DIC(9.4,11,9)="^"
^DIC(9.4,11,11)="62.4^62.4"
^DIC(9.4,11,22,0)="^9.49I^5.04^1"
^DIC(9.4,11,22,5.03,0)="5.2^3051119^2960605"
^DIC(9.4,11,22,5.03,1,0)="^^5^5^2940623^"
^DIC(9.4,11,22,5.03,1,1,0)="  This version is co-released with LAB SERVICE V5.2. It contains patches"
^DIC(9.4,11,22,5.03,1,2,0)="upto and including #."
^DIC(9.4,11,22,5.03,1,3,0)="  AUTOMATED LAB INSTRUMENTS (LA) future releases maybe independent of the"
^DIC(9.4,11,22,5.03,1,4,0)="LABORATORY SERVICE package. However in this version all LAB  routines"
^DIC(9.4,11,22,5.03,1,5,0)="have the same version number (V5.2)."
^DIC(9.4,11,22,5.03,"I",0)="^^4^4^2940623^"
^DIC(9.4,11,22,5.03,"I",1,0)=" If you are installing the laboratory package for the first time, you"
^DIC(9.4,11,22,5.03,"I",2,0)="must install the LAINIT's before running the ^LRINITS or menus trees"
^DIC(9.4,11,22,5.03,"I",3,0)="will be incomplete."
^DIC(9.4,11,22,5.03,"I",4,0)=" No data is contained in the inits. Data is supplied in the first time global tape."
^DIC(9.4,11,22,5.03,"PAH",0)="^9.4901^55^55"
^DIC(9.4,11,22,5.03,"PAH",1,0)="22 SEQ #14^2960715^1"
^DIC(9.4,11,22,5.03,"PAH",1,1,0)="^^1^1^2960715"
^DIC(9.4,11,22,5.03,"PAH",1,1,1,0)=" Fixes null subscript errors in LAGEN after patch LA*5.2*17."
^DIC(9.4,11,22,5.03,"PAH",2,0)="25 SEQ #15^2961224^1"
^DIC(9.4,11,22,5.03,"PAH",3,0)="23 SEQ #19^2970528^1"
^DIC(9.4,11,22,5.03,"PAH",3,1,0)="^^302^302^2970528"
^DIC(9.4,11,22,5.03,"PAH",3,1,1,0)="Associated patches: (v)LA*5.2*17    <<= must be installed BEFORE `LA*5.2*23'"
^DIC(9.4,11,22,5.03,"PAH",3,1,2,0)="Associated patches: (v)LA*5.2*25    <<= must be installed BEFORE `LA*5.2*23'"
^DIC(9.4,11,22,5.03,"PAH",3,1,3,0)="  "
^DIC(9.4,11,22,5.03,"PAH",3,1,4,0)=""
^DIC(9.4,11,22,5.03,"PAH",3,1,5,0)="A: Patch Description Summary"
^DIC(9.4,11,22,5.03,"PAH",3,1,6,0)="----------------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,7,0)="This patch will address nine issues that have been reported on NOIS or"
^DIC(9.4,11,22,5.03,"PAH",3,1,8,0)="developer identified."
^DIC(9.4,11,22,5.03,"PAH",3,1,9,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,11,0)="B: Sources for Patch"
^DIC(9.4,11,22,5.03,"PAH",3,1,12,0)="--------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,13,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,14,0)="1. Summary of E3R"
^DIC(9.4,11,22,5.03,"PAH",3,1,15,0)="-----------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,16,0)="   None"
^DIC(9.4,11,22,5.03,"PAH",3,1,17,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,18,0)="2. Summary of NOIS"
^DIC(9.4,11,22,5.03,"PAH",3,1,19,0)="------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,21,0)="   BRK-0696-11519"
^DIC(9.4,11,22,5.03,"PAH",3,1,22,0)="   SDC-1296-60042"
^DIC(9.4,11,22,5.03,"PAH",3,1,23,0)="   LEB-1296-20455"
^DIC(9.4,11,22,5.03,"PAH",3,1,24,0)="   VDA-1296-N0470"
^DIC(9.4,11,22,5.03,"PAH",3,1,25,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,26,0)="C. Patch Description Detail"
^DIC(9.4,11,22,5.03,"PAH",3,1,27,0)="---------------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,28,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,29,0)="1. NOIS BRK-0696-11519"
^DIC(9.4,11,22,5.03,"PAH",3,1,30,0)="   -------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,31,0)="A. Problem: With consolidation of sites, laboratories are operating with"
^DIC(9.4,11,22,5.03,"PAH",3,1,32,0)="more than 99 accession areas. This has necessitated changes to the"
^DIC(9.4,11,22,5.03,"PAH",3,1,33,0)="construction of the UID, (See related patch LR*5.2*129)."
^DIC(9.4,11,22,5.03,"PAH",3,1,34,0)=""
^DIC(9.4,11,22,5.03,"PAH",3,1,35,0)="Previously this was a 10 character numeric string. To handle sites with"
^DIC(9.4,11,22,5.03,"PAH",3,1,36,0)="greater than 99 accession areas, the format has been changed to allow"
^DIC(9.4,11,22,5.03,"PAH",3,1,37,0)="alphanumeric when designating the accession area identifier. This patch"
^DIC(9.4,11,22,5.03,"PAH",3,1,38,0)="incorporates changes to the Lab UI to properly handle this new format."
^DIC(9.4,11,22,5.03,"PAH",3,1,39,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,40,0)="   1. Auto download process was performing a numeric check of UID which is no"
^DIC(9.4,11,22,5.03,"PAH",3,1,41,0)="      longer valid in routine LA7ADL."
^DIC(9.4,11,22,5.03,"PAH",3,1,42,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,43,0)="   2. Test result process was performing a numeric check of UID which is no"
^DIC(9.4,11,22,5.03,"PAH",3,1,44,0)="      longer valid in routine LA7UIIN1."
^DIC(9.4,11,22,5.03,"PAH",3,1,45,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,46,0)="   Resolution: Altered check of UID to accept alphanumeric characters."
^DIC(9.4,11,22,5.03,"PAH",3,1,47,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,49,0)="2. NOIS SDC-1296-60042"
^DIC(9.4,11,22,5.03,"PAH",3,1,50,0)="   NOIS LEB-1296-20455"
^DIC(9.4,11,22,5.03,"PAH",3,1,51,0)="   -------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,52,0)="A. Problem: When processing test result messages, if site set flag to only"
^DIC(9.4,11,22,5.03,"PAH",3,1,53,0)="process tests that were ordered, it was possible for a result to not be"
^DIC(9.4,11,22,5.03,"PAH",3,1,54,0)="processed when it was ordered. This would occur if variable LA7TREE was"
^DIC(9.4,11,22,5.03,"PAH",3,1,55,0)="defined and contained a value greater than 999."
^DIC(9.4,11,22,5.03,"PAH",3,1,56,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,57,0)="   Resolution: Kill variable LA7TREE in routine LA7UIIN2 before call to"
^DIC(9.4,11,22,5.03,"PAH",3,1,58,0)="routine UNWIND^LA7UTIL which determine if test results are for a test that"
^DIC(9.4,11,22,5.03,"PAH",3,1,59,0)="was ordered."
^DIC(9.4,11,22,5.03,"PAH",3,1,60,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,61,0)="  "
^DIC(9.4,11,22,5.03,"PAH",3,1,62,0)="3. NOIS VDA-1296-N0470"
^DIC(9.4,11,22,5.03,"PAH",3,1,63,0)="   -------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,64,0)="A. Problem: When processing incoming HL7 messages to the Lab UI, the"
^DIC(9.4,11,22,5.03,"PAH",3,1,65,0)="routine LA7UIIN1 was setting up the call to LAGEN to create an entry in the"
^DIC(9.4,11,22,5.03,"PAH",3,1,66,0)="LAH global using the default accession area defined in the auto instrument"
^DIC(9.4,11,22,5.03,"PAH",3,1,67,0)="file. With the introduction of the UID, the lab package is implementing the"
^DIC(9.4,11,22,5.03,"PAH",3,1,68,0)="ability to run multiple accession areas on one instrument. The call to"
^DIC(9.4,11,22,5.03,"PAH",3,1,69,0)="LAGEN should build the accession area from the UID if available and use the"
^DIC(9.4,11,22,5.03,"PAH",3,1,70,0)="default accession area only when an accession number is passed."
^DIC(9.4,11,22,5.03,"PAH",3,1,71,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,72,0)="   Resolution: Modified routine LA7UIIN1 to build the accession area from"
^DIC(9.4,11,22,5.03,"PAH",3,1,73,0)="the UID when available before making call to LAGEN to create entry in LAH"
^DIC(9.4,11,22,5.03,"PAH",3,1,74,0)="global."
^DIC(9.4,11,22,5.03,"PAH",3,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,76,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,77,0)="4. Developer Identified"
^DIC(9.4,11,22,5.03,"PAH",3,1,78,0)="   --------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,79,0)="A. Problem: Option LA7 PRINT LAB UI ERROR contained a misspelling in the"
^DIC(9.4,11,22,5.03,"PAH",3,1,80,0)="menu text."
^DIC(9.4,11,22,5.03,"PAH",3,1,81,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,82,0)="   Resolution: Menu text changed from ""Print Lab Universal Inteface Log"" to"
^DIC(9.4,11,22,5.03,"PAH",3,1,83,0)="""Print Lab Universal Interface Log""."
^DIC(9.4,11,22,5.03,"PAH",3,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,85,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,86,0)="B. Problem: Option LA7 MAIN MENU was released in patch LA*5.2*17 but not"
^DIC(9.4,11,22,5.03,"PAH",3,1,87,0)="attached to the normal Lab menu system."
^DIC(9.4,11,22,5.03,"PAH",3,1,88,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,89,0)="   Resolution: Option LA7 MAIN MENU is added to the option LA INTERFACE."
^DIC(9.4,11,22,5.03,"PAH",3,1,90,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,91,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,92,0)="C. Problem: When troubleshooting a problem with the Universal Interface,"
^DIC(9.4,11,22,5.03,"PAH",3,1,93,0)="there was no option to display a message."
^DIC(9.4,11,22,5.03,"PAH",3,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,95,0)="   Resolution: Option LA7 PRINT UI MESSAGE added to LA7 MAIN MENU option to"
^DIC(9.4,11,22,5.03,"PAH",3,1,96,0)="allow user to display/print Universal Interface messages from file #62.49,"
^DIC(9.4,11,22,5.03,"PAH",3,1,97,0)="LA7 MESSAGE QUEUE. User can select 1-20 messages. Messages can be selected by"
^DIC(9.4,11,22,5.03,"PAH",3,1,98,0)="using either the #.01 field - MESSAGE NUMBER or #5 field - INSTRUMENT NAME."
^DIC(9.4,11,22,5.03,"PAH",3,1,99,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,100,0)="The INSTRUMENT NAME field is constructed as follows:"
^DIC(9.4,11,22,5.03,"PAH",3,1,101,0)=" 1. Instrument name from the #.01 Name field of the Auto Instrument file #62.4"
^DIC(9.4,11,22,5.03,"PAH",3,1,102,0)=" 2. Message type - ""I"" for Incoming, ""O"" for Outgoing"
^DIC(9.4,11,22,5.03,"PAH",3,1,103,0)=" 3. Lab Unique Id or Accession number"
^DIC(9.4,11,22,5.03,"PAH",3,1,104,0)="    - Outgoing messages always use the UID when building this name."
^DIC(9.4,11,22,5.03,"PAH",3,1,105,0)="    - Incoming messages are based on what is found in the message."
^DIC(9.4,11,22,5.03,"PAH",3,1,106,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,107,0)=" Examples: CX7-I-2061020105"
^DIC(9.4,11,22,5.03,"PAH",3,1,108,0)="           H747-O-3163120010"
^DIC(9.4,11,22,5.03,"PAH",3,1,109,0)="           MLA-I-45"
^DIC(9.4,11,22,5.03,"PAH",3,1,110,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,111,0)=" Messages with no instrument name will use ""UNKNOWN""."
^DIC(9.4,11,22,5.03,"PAH",3,1,112,0)=" Messages with no/unknown UID/accession number will use 0 (zero)."
^DIC(9.4,11,22,5.03,"PAH",3,1,113,0)=" Example: UNKNOWN-I-0"
^DIC(9.4,11,22,5.03,"PAH",3,1,114,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,115,0)="Uses the Kernel Browser if displayed on a CRT that supports the Browser,"
^DIC(9.4,11,22,5.03,"PAH",3,1,116,0)="otherwise uses FileMan captioned display."
^DIC(9.4,11,22,5.03,"PAH",3,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,119,0)="D. Problem: No option to start/stop the automatic download feature of the"
^DIC(9.4,11,22,5.03,"PAH",3,1,120,0)="Universal Interface if a site is using this capability."
^DIC(9.4,11,22,5.03,"PAH",3,1,121,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,122,0)="   Resolution: Option LA7 ADL START/STOP added to LA7 MAIN MENU option."
^DIC(9.4,11,22,5.03,"PAH",3,1,123,0)="This option can be used by sites utilizing the automatic download feature"
^DIC(9.4,11,22,5.03,"PAH",3,1,124,0)="to start/restart/stop the automatic download process. When a site makes"
^DIC(9.4,11,22,5.03,"PAH",3,1,125,0)="changes to an auto instrument entry in the AUTO INSTRUMENT file (#62.4),"
^DIC(9.4,11,22,5.03,"PAH",3,1,126,0)="and the entry is used for automatic downloading, the automatic download"
^DIC(9.4,11,22,5.03,"PAH",3,1,127,0)="process needs to be restarted. If a site wishes to stop the automatic"
^DIC(9.4,11,22,5.03,"PAH",3,1,128,0)="download process then it can be shutdown using this option."
^DIC(9.4,11,22,5.03,"PAH",3,1,129,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,130,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,131,0)="E. Problem: No option to send/resend an existing accession when using the"
^DIC(9.4,11,22,5.03,"PAH",3,1,132,0)="automatic download feature of the Universal Interface."
^DIC(9.4,11,22,5.03,"PAH",3,1,133,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,134,0)="   Resolution: Option LA7 ADL SEND added to LA7 MAIN MENU option. This"
^DIC(9.4,11,22,5.03,"PAH",3,1,135,0)="option allows for the manual selection of accession(s) for downloading to"
^DIC(9.4,11,22,5.03,"PAH",3,1,136,0)="an instrument for those instruments utilizing automatic downloading. It"
^DIC(9.4,11,22,5.03,"PAH",3,1,137,0)="will place the selected accessions in the queue to be checked for"
^DIC(9.4,11,22,5.03,"PAH",3,1,138,0)="downloading to those instruments designated for automatic downloading."
^DIC(9.4,11,22,5.03,"PAH",3,1,139,0)="  "
^DIC(9.4,11,22,5.03,"PAH",3,1,140,0)="F. Problem: When processing an incoming result message that had a specimen"
^DIC(9.4,11,22,5.03,"PAH",3,1,141,0)="id that is an accession number, the accession date was being set to the"
^DIC(9.4,11,22,5.03,"PAH",3,1,142,0)="current date (DT). This caused results to be stored in LAH under the"
^DIC(9.4,11,22,5.03,"PAH",3,1,143,0)="wrong accession when the default accession area for the instrument was"
^DIC(9.4,11,22,5.03,"PAH",3,1,144,0)="non-daily, i.e. monthly, quarterly, yearly."
^DIC(9.4,11,22,5.03,"PAH",3,1,145,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,146,0)="   Resolution: Determine the current accession date when processing by"
^DIC(9.4,11,22,5.03,"PAH",3,1,147,0)="accession number based on the accession transform (field # .05 in"
^DIC(9.4,11,22,5.03,"PAH",3,1,148,0)="Accession file #68). Routine LA7UIIN1 modified."
^DIC(9.4,11,22,5.03,"PAH",3,1,149,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,150,0)="TEST SITES           OPERATING SYSTEM    UNIVERSAL INTERFACE PRODUCT"
^DIC(9.4,11,22,5.03,"PAH",3,1,151,0)="----------           ----------------    ---------------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,152,0)="Bath VAMC            MSM system          Dawning ResultNet"
^DIC(9.4,11,22,5.03,"PAH",3,1,153,0)="Central Texas HCS    DSM system          Data Innovations Instrument Manager"
^DIC(9.4,11,22,5.03,"PAH",3,1,154,0)="Lebanon VAMC         DSM system          Data Innovations Instrument Manager"
^DIC(9.4,11,22,5.03,"PAH",3,1,155,0)="Long Beach VAMC      DSM system          Dawning ResultNet"
^DIC(9.4,11,22,5.03,"PAH",3,1,156,0)="Milwaukee VAMC       DSM system          Data Innovations Instrument Manager"
^DIC(9.4,11,22,5.03,"PAH",3,1,157,0)="  "
^DIC(9.4,11,22,5.03,"PAH",3,1,158,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,159,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",3,1,160,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,161,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,162,0)=" The following is a list of routines included in this patch. The second"
^DIC(9.4,11,22,5.03,"PAH",3,1,163,0)=" line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",3,1,164,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,165,0)=" <tab>;;5.2;LAB MESSAGING;**[patch list]**;Feb 29, 1996"
^DIC(9.4,11,22,5.03,"PAH",3,1,166,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,167,0)="                  CHECK^XTSUMBLD results"
^DIC(9.4,11,22,5.03,"PAH",3,1,168,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,169,0)="   Routine Name   Before Patch   After Patch   Patch List"
^DIC(9.4,11,22,5.03,"PAH",3,1,170,0)="   ------------   ------------   -----------   ----------"
^DIC(9.4,11,22,5.03,"PAH",3,1,171,0)="   LA23           NA             3777015       23"
^DIC(9.4,11,22,5.03,"PAH",3,1,172,0)="   LA7ADL         9628408        10978189      17,25,23"
^DIC(9.4,11,22,5.03,"PAH",3,1,173,0)="   LA7ADL1        4708581        7046668       17,23"
^DIC(9.4,11,22,5.03,"PAH",3,1,174,0)="   LA7ADL2        NA             4107162       23"
^DIC(9.4,11,22,5.03,"PAH",3,1,175,0)="   LA7ADLS        NA             2840510       23"
^DIC(9.4,11,22,5.03,"PAH",3,1,176,0)="   LA7UIIN        3932211        5181875       17,23"
^DIC(9.4,11,22,5.03,"PAH",3,1,177,0)="   LA7UIIN1       5975112        7157740       17,23"
^DIC(9.4,11,22,5.03,"PAH",3,1,178,0)="   LA7UIIN2       9803192        9927050       17,23"
^DIC(9.4,11,22,5.03,"PAH",3,1,179,0)="   LA7UTILA       NA             11405877      23"
^DIC(9.4,11,22,5.03,"PAH",3,1,180,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,181,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,182,0)=" INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",3,1,183,0)=" -------------------------"
^DIC(9.4,11,22,5.03,"PAH",3,1,184,0)=" The install time for this patch is less than 5 minutes. This patch"
^DIC(9.4,11,22,5.03,"PAH",3,1,185,0)=" can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",3,1,186,0)=" However the following conditions apply:"
^DIC(9.4,11,22,5.03,"PAH",3,1,187,0)="  1. Accessioning should not be occurring,"
^DIC(9.4,11,22,5.03,"PAH",3,1,188,0)="  2. The HL7 background job (HLLP) for the Lab Universal Interface should"
^DIC(9.4,11,22,5.03,"PAH",3,1,189,0)="     be stopped."
^DIC(9.4,11,22,5.03,"PAH",3,1,190,0)="  3. The routine LA7UIIN to process incoming HL7 messages should not"
^DIC(9.4,11,22,5.03,"PAH",3,1,191,0)="     be running."
^DIC(9.4,11,22,5.03,"PAH",3,1,192,0)="  4. If using auto download, the routine LA7ADL should not be running."
^DIC(9.4,11,22,5.03,"PAH",3,1,193,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,194,0)=" NOTE: MailMan and Kernel patches must be current on the target system to"
^DIC(9.4,11,22,5.03,"PAH",3,1,195,0)="       avoid problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",3,1,196,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,197,0)=" 1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",3,1,198,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,199,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",3,1,200,0)="     option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",3,1,201,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,202,0)=" 3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",3,1,203,0)="     system.  You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",3,1,204,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,205,0)=" 4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",3,1,206,0)="     select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",3,1,207,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,208,0)=" 5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",3,1,209,0)="     all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",3,1,210,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,211,0)=" 6.  If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,11,22,5.03,"PAH",3,1,212,0)="     prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,11,22,5.03,"PAH",3,1,213,0)="     option at this time.  You may also compare the routine in your"
^DIC(9.4,11,22,5.03,"PAH",3,1,214,0)="     production account to the routine in the patch by using the 'Compare"
^DIC(9.4,11,22,5.03,"PAH",3,1,215,0)="     a Transport Global to Current System' option.  These options can"
^DIC(9.4,11,22,5.03,"PAH",3,1,216,0)="     both be found under the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",3,1,217,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,218,0)=" 7.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",3,1,219,0)="     and select the package 'LA*5.2*23'.  When prompted 'Want to"
^DIC(9.4,11,22,5.03,"PAH",3,1,220,0)="     DISABLE Scheduled Options, Menu Options, and Protocols? NO//',"
^DIC(9.4,11,22,5.03,"PAH",3,1,221,0)="     choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",3,1,222,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,223,0)=" 8.  MSM sites:  You should respond 'YES' to 'Want to MOVE routines to"
^DIC(9.4,11,22,5.03,"PAH",3,1,224,0)="     other CPUs?' and specify CPUs.  Alternatively, you may move the"
^DIC(9.4,11,22,5.03,"PAH",3,1,225,0)="     routines to your other systems after KIDS has finished the"
^DIC(9.4,11,22,5.03,"PAH",3,1,226,0)="     installation."
^DIC(9.4,11,22,5.03,"PAH",3,1,227,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,228,0)=" 9. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",3,1,229,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,230,0)=" 10. Restart the HL7 background job(s) for the Lab Universal Interface if"
^DIC(9.4,11,22,5.03,"PAH",3,1,231,0)="     previously stopped."
^DIC(9.4,11,22,5.03,"PAH",3,1,232,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,233,0)=" 11. Routine LA23 can be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",3,1,234,0)=" **************************************************************************** "
^DIC(9.4,11,22,5.03,"PAH",3,1,235,0)="Below is an example of the dialogue seen during the KIDS install:"
^DIC(9.4,11,22,5.03,"PAH",3,1,236,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,237,0)="  "
^DIC(9.4,11,22,5.03,"PAH",3,1,238,0)="Select Installation Option: INstall Package(s)"
^DIC(9.4,11,22,5.03,"PAH",3,1,239,0)="Select INSTALL NAME:    LA*5.2*23   Loaded from Distribution  12/13/96@15:50:40"
^DIC(9.4,11,22,5.03,"PAH",3,1,240,0)="     => LA*5.2*23 TEST V1"
^DIC(9.4,11,22,5.03,"PAH",3,1,241,0)=" "
