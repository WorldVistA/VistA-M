^DIC(9.4,175,22,2,"PAH",23,1,1,0)="Patch 48 is a maintanence patch for "
^DIC(9.4,175,22,2,"PAH",23,1,2,0)="Imaging Display, Imaging Capture, Annotation editor and BP."
^DIC(9.4,175,22,2,"PAH",23,1,3,0)="It deals with issues encountered in Alpha testing of Patch 8."
^DIC(9.4,175,22,2,"PAH",23,1,4,0)="  "
^DIC(9.4,175,22,2,"PAH",23,1,5,0)="This will check the routines from a BUILD file."
