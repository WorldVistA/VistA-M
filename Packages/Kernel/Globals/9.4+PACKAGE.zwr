^DIC(9.4,48,22,5.28,"PAH",615,1,1,0)="VSE-2435: BB VistA: Create wrapper RPC to cancel an appointment"
^DIC(9.4,48,22,5.28,"PAH",615,1,2,0)="VSE-2558: BF VistA: Create new RPC to retrieve all national flags and the "
^DIC(9.4,48,22,5.28,"PAH",615,1,3,0)="                    fugitive felon flag (SDES GET PATIENT FLAGS)"
^DIC(9.4,48,22,5.28,"PAH",615,1,4,0)="VSE-2868: MD VistA: Error with clinic not having the appointment length "
^DIC(9.4,48,22,5.28,"PAH",615,1,5,0)="                    field set"
^DIC(9.4,48,22,5.28,"PAH",615,1,6,0)="VSE-2876: MD VistA: ApptReq: add new ""station number"" parameter when "
^DIC(9.4,48,22,5.28,"PAH",615,1,7,0)="                    creating appointment requests"
^DIC(9.4,48,22,5.28,"PAH",615,1,8,0)="VSE-2884: MD VistA: ApptReq update SDES GET APPT REQ RPCs to return "
^DIC(9.4,48,22,5.28,"PAH",615,1,9,0)="                    ScheduledDateOfApptI in external format"
^DIC(9.4,48,22,5.28,"PAH",615,1,10,0)="VSE-2885: RM VistA: Modify SDES CREATE and EDIT APPT REQ RPC's to add a"
^DIC(9.4,48,22,5.28,"PAH",615,1,11,0)="                    new input parameter 'secondary stop code'. Create a"
^DIC(9.4,48,22,5.28,"PAH",615,1,12,0)="                    new field in File #409.85 that will capture the"
^DIC(9.4,48,22,5.28,"PAH",615,1,13,0)="                    secondary stop code."
^DIC(9.4,48,22,5.28,"PAH",615,1,14,0)="                    Update SDES GET APPT REQ RPC's to include the"
^DIC(9.4,48,22,5.28,"PAH",615,1,15,0)="                    secondary stop code into the JSON return array"
^DIC(9.4,48,22,5.28,"PAH",615,1,16,0)="VSE-2922: MD VistA: SDES DISPOSITION APPT REQ Default to current user DUZ "
^DIC(9.4,48,22,5.28,"PAH",615,1,17,0)="                    if one isn't provided"
^DIC(9.4,48,22,5.28,"PAH",615,1,18,0)="VSE-2924: MD VistA ApptReq Return request disposition reason"
^DIC(9.4,48,22,5.28,"PAH",615,1,19,0)="VSE-2956: BB VistA: Create patient date preference 1, date preference 2, "
^DIC(9.4,48,22,5.28,"PAH",615,1,20,0)="                    date preference 3 fields"
^DIC(9.4,48,22,5.28,"PAH",615,1,21,0)="VSE-2991: DS VistA: Update SDES GET USER PROFILE BY DUZ to return Station "
^DIC(9.4,48,22,5.28,"PAH",615,1,22,0)="                    number for divisions"
