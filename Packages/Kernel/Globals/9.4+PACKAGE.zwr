^DIC(9.4,3,22,21,"PAH",254,1,144,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,145,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",254,1,146,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,147,0)="     1.   Users ARE allowed to be on the system during the"
^DIC(9.4,3,22,21,"PAH",254,1,148,0)="     installation."
^DIC(9.4,3,22,21,"PAH",254,1,149,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,150,0)="     2.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,3,22,21,"PAH",254,1,151,0)="     This option will load the KIDS (Kernel Installation and Distribution"
^DIC(9.4,3,22,21,"PAH",254,1,152,0)="     System) package onto your system."
^DIC(9.4,3,22,21,"PAH",254,1,153,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,154,0)="     3.   You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",254,1,155,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,156,0)="     4.   The patch has now been loaded into a transport global on your"
^DIC(9.4,3,22,21,"PAH",254,1,157,0)="     system.  On the KIDS menu, select the 'Installation' menu and use"
^DIC(9.4,3,22,21,"PAH",254,1,158,0)="     the following options:"
^DIC(9.4,3,22,21,"PAH",254,1,159,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",254,1,160,0)="           Print Transport Global"
^DIC(9.4,3,22,21,"PAH",254,1,161,0)="           Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",254,1,162,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",254,1,163,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,164,0)="           Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",254,1,165,0)="           Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",254,1,166,0)="                               ======="
^DIC(9.4,3,22,21,"PAH",254,1,167,0)="            Install Package(s)"
^DIC(9.4,3,22,21,"PAH",254,1,168,0)="            Select INSTALL NAME: XU*8.0*316"
^DIC(9.4,3,22,21,"PAH",254,1,169,0)="                                 =========="
^DIC(9.4,3,22,21,"PAH",254,1,170,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,171,0)="        Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES//"
^DIC(9.4,3,22,21,"PAH",254,1,172,0)="        NO"
^DIC(9.4,3,22,21,"PAH",254,1,173,0)="        =="
^DIC(9.4,3,22,21,"PAH",254,1,174,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",254,1,175,0)="                                                              =="
^DIC(9.4,3,22,21,"PAH",254,1,176,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,3,22,21,"PAH",254,1,177,0)="        YES// NO"
^DIC(9.4,3,22,21,"PAH",254,1,178,0)="              =="
^DIC(9.4,3,22,21,"PAH",254,1,179,0)=" "
^DIC(9.4,3,22,21,"PAH",254,1,180,0)="     5.  AXP Sites - Answer 'NO' to the question 'Want to MOVE"
^DIC(9.4,3,22,21,"PAH",254,1,181,0)="     routines to other CPUs?'."
