^DIC(9.4,162,22,1,"PAH",17,1,0)="^^2^2^3010305"
^DIC(9.4,162,22,1,"PAH",17,1,1,0)="A description of this build can be found on the NATIONAL PATCH MODULE under "
^DIC(9.4,162,22,1,"PAH",17,1,2,0)="USR*1.0*18."
^DIC(9.4,162,22,1,"PAH",18,0)="15^3010430^1"
^DIC(9.4,162,22,1,"PAH",18,1,0)="^^2^2^3010430"
