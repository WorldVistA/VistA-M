^DIC(9.4,44,22,3,"PAH",2,0)="2^2990416^1"
^DIC(9.4,44,22,3,"PAH",2,1,0)="^^29^29^2990416"
^DIC(9.4,44,22,3,"PAH",2,1,1,0)="This patch fixes problems related to the Consult/Request"
^DIC(9.4,44,22,3,"PAH",2,1,2,0)="Tracking 3.0 installation."
^DIC(9.4,44,22,3,"PAH",2,1,3,0)="   1) It restores the protocol menu items for GMRC EVSEND OR and GMRC"
^DIC(9.4,44,22,3,"PAH",2,1,4,0)="ORDERABLE ITEM UPDATE.  The Consult/Request Tracking V3.0 was distributed"
^DIC(9.4,44,22,3,"PAH",2,1,5,0)="with ""SEND TO SITE"" which deletes OR and OCX namespaced protocol menu"
^DIC(9.4,44,22,3,"PAH",2,1,6,0)="items which must be in the menu items list in order for the CPRS and"
^DIC(9.4,44,22,3,"PAH",2,1,7,0)="Consults packages to communicate with each other."
^DIC(9.4,44,22,3,"PAH",2,1,8,0)=" "
^DIC(9.4,44,22,3,"PAH",2,1,9,0)="The following is what the menu items should be for the GMRC protocols"
^DIC(9.4,44,22,3,"PAH",2,1,10,0)="after this patch is installed:"
^DIC(9.4,44,22,3,"PAH",2,1,11,0)=" "
^DIC(9.4,44,22,3,"PAH",2,1,12,0)="NAME: GMRC EVSEND OR                    "
^DIC(9.4,44,22,3,"PAH",2,1,13,0)="  ITEM TEXT: Consults event sent to OE/RR"
^DIC(9.4,44,22,3,"PAH",2,1,14,0)="  TYPE: extended action             "
^DIC(9.4,44,22,3,"PAH",2,1,15,0)="  PACKAGE: CONSULT/REQUEST TRACKING"
^DIC(9.4,44,22,3,"PAH",2,1,16,0)="  -----Menu Items---------------------------------"
^DIC(9.4,44,22,3,"PAH",2,1,17,0)="  ITEM: OR RECEIVE                        SEQUENCE: 1"
^DIC(9.4,44,22,3,"PAH",2,1,18,0)="  ITEM: OCX ORDER CHECK HL7 RECIEVE       SEQUENCE: 2"
^DIC(9.4,44,22,3,"PAH",2,1,19,0)=" "
^DIC(9.4,44,22,3,"PAH",2,1,20,0)="NAME: GMRC ORDERABLE ITEM UPDATE"
^DIC(9.4,44,22,3,"PAH",2,1,21,0)="  ITEM TEXT: Update Consults orderable item"
^DIC(9.4,44,22,3,"PAH",2,1,22,0)="  TYPE: extended action                "
^DIC(9.4,44,22,3,"PAH",2,1,23,0)="  PACKAGE: CONSULT/REQUEST TRACKING"
^DIC(9.4,44,22,3,"PAH",2,1,24,0)="  -----Menu Items---------------------------------"
^DIC(9.4,44,22,3,"PAH",2,1,25,0)="  ITEM: OR ITEM RECEIVE                   SEQUENCE: 1"
^DIC(9.4,44,22,3,"PAH",2,1,26,0)=" "
^DIC(9.4,44,22,3,"PAH",2,1,27,0)="  2) This patch also corrects the package pointer in the Dialog File"
^DIC(9.4,44,22,3,"PAH",2,1,28,0)="(101.41) for 2 Dialog entries ""GMRCOR CONSULT"" and ""GMRCOR REQUEST"". This"
^DIC(9.4,44,22,3,"PAH",2,1,29,0)="done when the post-installation routine is run."
^DIC(9.4,44,22,3,"PAH",3,0)="6^2990416^1"
^DIC(9.4,44,22,3,"PAH",4,0)="4^2990719^1"
