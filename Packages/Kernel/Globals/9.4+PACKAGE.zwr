^DIC(9.4,4,22,1,"PAH",69,0)="100 SEQ #94^2991019^1"
^DIC(9.4,4,22,1,"PAH",69,1,0)="^^58^58^2991019"
^DIC(9.4,4,22,1,"PAH",69,1,1,0)="Patch XM*7.1*100"
^DIC(9.4,4,22,1,"PAH",69,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,3,0)="NOIS:  BAC-1099-40361"
^DIC(9.4,4,22,1,"PAH",69,1,4,0)="Test Site:  Battle Creek, MI"
^DIC(9.4,4,22,1,"PAH",69,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,6,0)="When acting as a surrogate, and printing new messages, a confidential"
^DIC(9.4,4,22,1,"PAH",69,1,7,0)="message sends MailMan into an endless loop.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",69,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,9,0)="When printing several messages at once, if one of them is scrambled,"
^DIC(9.4,4,22,1,"PAH",69,1,10,0)="MailMan aborts.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",69,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,12,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",69,1,13,0)="minimum.  It requires MailMan patch XM*7.1*75."
^DIC(9.4,4,22,1,"PAH",69,1,14,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",69,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,16,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",69,1,17,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",69,1,18,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",69,1,19,0)=" "
^DIC(9.4,4,22,1,"PAH",69,1,20,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",69,1,21,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",69,1,22,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",69,1,23,0)="XMJBN         10185228        10390839        50,100"
^DIC(9.4,4,22,1,"PAH",69,1,24,0)="XMJMP         16504280        16560016        50,75,100"
^DIC(9.4,4,22,1,"PAH",69,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,26,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",69,1,27,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",69,1,28,0)=" "
^DIC(9.4,4,22,1,"PAH",69,1,29,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",69,1,30,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",69,1,31,0)="minimum.  It requires MailMan patch XM*7.1*75."
^DIC(9.4,4,22,1,"PAH",69,1,32,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",69,1,33,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",69,1,34,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",69,1,35,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",69,1,36,0)="3.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",69,1,37,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",69,1,38,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",69,1,39,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",69,1,40,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",69,1,41,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",69,1,42,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",69,1,43,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",69,1,44,0)=" Select INSTALL NAME:    XM*7.1*100     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",69,1,45,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",69,1,46,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",69,1,47,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",69,1,48,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",69,1,49,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",69,1,50,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",69,1,51,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",69,1,52,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",69,1,53,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",69,1,54,0)=""
^DIC(9.4,4,22,1,"PAH",69,1,55,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",69,1,56,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",69,1,57,0)="5.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
