^DIC(9.4,49,22,10,"PAH",491,1,192,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,49,22,10,"PAH",491,1,193,0)="----------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",491,1,194,0)="Patches for this installation are combined in host file "
^DIC(9.4,49,22,10,"PAH",491,1,195,0)="IB_2_568_PRCA_PSO_BUNDLE_T1.KID"
^DIC(9.4,49,22,10,"PAH",491,1,196,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,197,0)="Installation of this host file should be coordinated among the packages "
^DIC(9.4,49,22,10,"PAH",491,1,198,0)="affected since only one installation is necessary."
^DIC(9.4,49,22,10,"PAH",491,1,199,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,200,0)="The patches are:"
^DIC(9.4,49,22,10,"PAH",491,1,201,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,202,0)="     IB*2.0*568"
^DIC(9.4,49,22,10,"PAH",491,1,203,0)="     PRCA*4.5*315"
^DIC(9.4,49,22,10,"PAH",491,1,204,0)="     PSO*7.0*463"
^DIC(9.4,49,22,10,"PAH",491,1,205,0)="     "
^DIC(9.4,49,22,10,"PAH",491,1,206,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,207,0)="Sites may retrieve the KIDS build in one of the following ways:"
^DIC(9.4,49,22,10,"PAH",491,1,208,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,209,0)="(1) The preferred method is to FTP the files from "
^DIC(9.4,49,22,10,"PAH",491,1,210,0)="download.vista.domain.ext which will transmit the files from the first "
^DIC(9.4,49,22,10,"PAH",491,1,211,0)="available FTP server."
^DIC(9.4,49,22,10,"PAH",491,1,212,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,213,0)="(2) Sites may also elect to retrieve the patch directly from a specific"
^DIC(9.4,49,22,10,"PAH",491,1,214,0)="server as follows:"
^DIC(9.4,49,22,10,"PAH",491,1,215,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,216,0)="  OIFO               FTP ADDRESS                  DIRECTORY"
^DIC(9.4,49,22,10,"PAH",491,1,217,0)="  --------------     ------------------------     ------------------"
^DIC(9.4,49,22,10,"PAH",491,1,218,0)="  Albany             ftp.fo-albany.domain.ext     anonymous.software"
^DIC(9.4,49,22,10,"PAH",491,1,219,0)="  Hines              ftp.fo-hines.domain.ext      anonymous.software"
^DIC(9.4,49,22,10,"PAH",491,1,220,0)="  Salt Lake City     ftp.fo-slc.domain.ext        anonymous.software"
^DIC(9.4,49,22,10,"PAH",491,1,221,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,222,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,223,0)="Sites may retrieve documentation directly using Secure File Transfer "
^DIC(9.4,49,22,10,"PAH",491,1,224,0)="Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory at the following"
^DIC(9.4,49,22,10,"PAH",491,1,225,0)="OI Field Offices:"
^DIC(9.4,49,22,10,"PAH",491,1,226,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,227,0)="Albany:          fo-albany.domain.ext"
^DIC(9.4,49,22,10,"PAH",491,1,228,0)="Hines:           fo-hines.domain.ext"
^DIC(9.4,49,22,10,"PAH",491,1,229,0)="Salt Lake City:  fo-slc.domain.ext"
^DIC(9.4,49,22,10,"PAH",491,1,230,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,231,0)="Documentation can also be found on the VA Software Documentation "
^DIC(9.4,49,22,10,"PAH",491,1,232,0)="Library at:"
^DIC(9.4,49,22,10,"PAH",491,1,233,0)="http://www4.domain.ext/vdl/"
^DIC(9.4,49,22,10,"PAH",491,1,234,0)=" "
