^DIC(9.4,81,22,2.3,"PAH",4,1,33,0)="  disruption to users.  It only affects users of the Automatic"
^DIC(9.4,81,22,2.3,"PAH",4,1,34,0)="  Replenishment/Ward Stock software.  "
^DIC(9.4,81,22,2.3,"PAH",4,1,35,0)="  Installation will take less than 1 minute.  "
^DIC(9.4,81,22,2.3,"PAH",4,1,36,0)="  1.  Use the INSTALL/CHECK MESSAGE option on the PackMan menu and "
^DIC(9.4,81,22,2.3,"PAH",4,1,37,0)="      answer YES to the prompt 'Want to Continue with Load? YES//'"
