^DIC(9.4,13,22,7,"PAH",31,1,128,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",31,1,129,0)="Options, and Protocols?"
^DIC(9.4,13,22,7,"PAH",31,1,130,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,131,0)="     6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,13,22,7,"PAH",31,1,132,0)="other CPUs?'.  Then enter the names of your other Compute and Print"
^DIC(9.4,13,22,7,"PAH",31,1,133,0)="server(s)."
^DIC(9.4,13,22,7,"PAH",31,1,134,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,135,0)="     7.  AXP Sites - After the patch has been installed, rebuild your map"
