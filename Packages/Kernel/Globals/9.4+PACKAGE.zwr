^DIC(9.4,4,22,1,"PAH",127,1,5,0)="The .01 field of file 3.73 contains a date input transform.  This patch"
^DIC(9.4,4,22,1,"PAH",127,1,6,0)="adds a K %DT(0) to the input transform to prevent leakage."
^DIC(9.4,4,22,1,"PAH",127,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,8,0)="STANDARD DATA DICTIONARY #3.73 -- MESSAGES TO BE NEW AT A LATER DATE FILE"
^DIC(9.4,4,22,1,"PAH",127,1,9,0)="STORED IN ^XMB(3.73,"
^DIC(9.4,4,22,1,"PAH",127,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,11,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",127,1,12,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",127,1,13,0)="----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",127,1,14,0)="3.73,.01   DATE MESSAGE WILL BE NEW 0;1 DATE (Required)"
^DIC(9.4,4,22,1,"PAH",127,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,16,0)="           Date Message Will Be New   "
^DIC(9.4,4,22,1,"PAH",127,1,17,0)="           INPUT TRANSFORM:  S %DT(0)=""NOW"",%DT=""ETF"" D ^%DT K %DT(0) S X=Y "
^DIC(9.4,4,22,1,"PAH",127,1,18,0)="                             K:Y<1 X"
^DIC(9.4,4,22,1,"PAH",127,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,20,0)="           LAST EDITED:      NOV 16, 2000 "
^DIC(9.4,4,22,1,"PAH",127,1,21,0)="           HELP-PROMPT:      Enter a date or date @ time on which you wish "
^DIC(9.4,4,22,1,"PAH",127,1,22,0)="                             this message to be new. "
^DIC(9.4,4,22,1,"PAH",127,1,23,0)="           DESCRIPTION:      This field should be in FileMan format.  The"
^DIC(9.4,4,22,1,"PAH",127,1,24,0)="                             file will be X-referenced by it and the"
^DIC(9.4,4,22,1,"PAH",127,1,25,0)="                             background filer will process it on that date.  "
^DIC(9.4,4,22,1,"PAH",127,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,27,0)="           NOTES:            XXXX--CAN'T BE ALTERED EXCEPT BY PROGRAMMER"
^DIC(9.4,4,22,1,"PAH",127,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,29,0)="           CROSS-REFERENCE:  ^^TRIGGER^3.73^1 "
^DIC(9.4,4,22,1,"PAH",127,1,30,0)="                             1)= X ^DD(3.73,.01,1,1,1.3) I X S X=DIV S Y(1)="
^DIC(9.4,4,22,1,"PAH",127,1,31,0)="                             $S($D(^XMB(3.73,D0,0)):^(0),1:"""") S X=$P(Y(1),U"
^DIC(9.4,4,22,1,"PAH",127,1,32,0)="                             ,2),X=X S DIU=X K Y S X=DIV S X=$S($D(XMDUZ):XM"
^DIC(9.4,4,22,1,"PAH",127,1,33,0)="                             DUZ,1:DUZ) X ^DD(3.73,.01,1,1,1.4)"
^DIC(9.4,4,22,1,"PAH",127,1,34,0)="                             1.3)= K DIV S DIV=X,D0=DA,DIV(0)=D0 S Y(0)=X S "
^DIC(9.4,4,22,1,"PAH",127,1,35,0)="                             Y(1)=$S($D(^XMB(3.73,D0,0)):^(0),1:"""") S X=$S('"
^DIC(9.4,4,22,1,"PAH",127,1,36,0)="                             $D(^VA(200,+$P(Y(1),U,2),0)):"""",1:$P(^(0),U,1))"
^DIC(9.4,4,22,1,"PAH",127,1,37,0)="                             ="""""
^DIC(9.4,4,22,1,"PAH",127,1,38,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,39,0)="                             1.4)= S DIH=$S($D(^XMB(3.73,DIV(0),0)):^(0),1:"""
^DIC(9.4,4,22,1,"PAH",127,1,40,0)="                             ""),DIV=X S $P(^(0),U,2)=DIV,DIH=3.73,DIG=1 D ^D"
^DIC(9.4,4,22,1,"PAH",127,1,41,0)="                             ICR:$O(^DD(DIH,DIG,1,0))>0"
^DIC(9.4,4,22,1,"PAH",127,1,42,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,43,0)="                             2)= Q"
^DIC(9.4,4,22,1,"PAH",127,1,44,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,45,0)="                             CREATE CONDITION)= USER="""""
^DIC(9.4,4,22,1,"PAH",127,1,46,0)="                             CREATE VALUE)= S X=$S($D(XMDUZ):XMDUZ,1:DUZ)"
^DIC(9.4,4,22,1,"PAH",127,1,47,0)="                             DELETE VALUE)= NO EFFECT"
^DIC(9.4,4,22,1,"PAH",127,1,48,0)="                             FIELD)= USER"
^DIC(9.4,4,22,1,"PAH",127,1,49,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,50,0)="           CROSS-REFERENCE:  3.73^AB1^MUMPS "
^DIC(9.4,4,22,1,"PAH",127,1,51,0)="                             1)= N XMDUZ,XMZ,XMREC S XMREC=$G(^XMB(3.73,DA,0"
^DIC(9.4,4,22,1,"PAH",127,1,52,0)="                             )),XMDUZ=$P(XMREC,U,2),XMZ=$P(XMREC,U,3) I XMZ]"
^DIC(9.4,4,22,1,"PAH",127,1,53,0)="                             """" S ^XMB(3.73,""AB"",X,XMDUZ,XMZ,DA)="""""
^DIC(9.4,4,22,1,"PAH",127,1,54,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,55,0)="                             2)= N XMDUZ,XMZ,XMREC S XMREC=$G(^XMB(3.73,DA,0"
^DIC(9.4,4,22,1,"PAH",127,1,56,0)="                             )),XMDUZ=$P(XMREC,U,2),XMZ=$P(XMREC,U,3) I XMZ]"
^DIC(9.4,4,22,1,"PAH",127,1,57,0)="                             """" K ^XMB(3.73,""AB"",X,XMDUZ,XMZ,DA)"
^DIC(9.4,4,22,1,"PAH",127,1,58,0)="                             This xref activates when a user changes the"
^DIC(9.4,4,22,1,"PAH",127,1,59,0)="                             date/time that a message is latered. "
^DIC(9.4,4,22,1,"PAH",127,1,60,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,61,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",127,1,62,0)="is at a minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",127,1,63,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",127,1,64,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,65,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",127,1,66,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",127,1,67,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",127,1,68,0)=" "
^DIC(9.4,4,22,1,"PAH",127,1,69,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",127,1,70,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",127,1,71,0)="-----------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",127,1,72,0)="No routines are included in this patch."
^DIC(9.4,4,22,1,"PAH",127,1,73,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",127,1,74,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,75,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",127,1,76,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",127,1,77,0)=" "
^DIC(9.4,4,22,1,"PAH",127,1,78,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",127,1,79,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",127,1,80,0)="is at a minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",127,1,81,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",127,1,82,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",127,1,83,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",127,1,84,0)="3.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",127,1,85,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",127,1,86,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",127,1,87,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",127,1,88,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",127,1,89,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",127,1,90,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",127,1,91,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",127,1,92,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",127,1,93,0)=" Select INSTALL NAME:    XM*7.1*157    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",127,1,94,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",127,1,95,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",127,1,96,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",127,1,97,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",127,1,98,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",127,1,99,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",127,1,100,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",127,1,101,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",127,1,102,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",127,1,103,0)=""
^DIC(9.4,4,22,1,"PAH",127,1,104,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",127,1,105,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",127,1,106,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",128,0)="160 SEQ #153^3001127^1"
^DIC(9.4,4,22,1,"PAH",128,1,0)="^^58^58^3001127"
^DIC(9.4,4,22,1,"PAH",128,1,1,0)="Patch XM*7.1*160"
^DIC(9.4,4,22,1,"PAH",128,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",128,1,3,0)="NOIS: PUG-1100-51632"
^DIC(9.4,4,22,1,"PAH",128,1,4,0)="Test Sites:  PUGET SOUND HCS"
^DIC(9.4,4,22,1,"PAH",128,1,5,0)="If a user has only confidential messages in her basket, and a surrogate"
^DIC(9.4,4,22,1,"PAH",128,1,6,0)="tries to read the messages in that basket using the Classic reader, the"
^DIC(9.4,4,22,1,"PAH",128,1,7,0)="surrogate is simply tossed out of the basket with no explanation."
^DIC(9.4,4,22,1,"PAH",128,1,8,0)="This patch will ensure that the surrogate is given an explanation."
^DIC(9.4,4,22,1,"PAH",128,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",128,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",128,1,11,0)="is at a minimum.  It requires MailMan patch XM*7.1*143."
^DIC(9.4,4,22,1,"PAH",128,1,12,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",128,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",128,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",128,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",128,1,16,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",128,1,17,0)=" "
^DIC(9.4,4,22,1,"PAH",128,1,18,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",128,1,19,0)="Name          Checksum        Checksum        Patch List"
