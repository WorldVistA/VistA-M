^DIC(9.4,13,22,8,"PAH",12,1,61,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,8,"PAH",12,1,62,0)=" "
^DIC(9.4,13,22,8,"PAH",12,1,63,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,8,"PAH",12,1,64,0)="following options: "
^DIC(9.4,13,22,8,"PAH",12,1,65,0)=" "
^DIC(9.4,13,22,8,"PAH",12,1,66,0)="            Print Transport Global"
^DIC(9.4,13,22,8,"PAH",12,1,67,0)="            Compare Transport Global to Current System"
^DIC(9.4,13,22,8,"PAH",12,1,68,0)="            Verify Checksums in Transport Global"
^DIC(9.4,13,22,8,"PAH",12,1,69,0)="            Backup a Transport Global"
^DIC(9.4,13,22,8,"PAH",12,1,70,0)=" "
^DIC(9.4,13,22,8,"PAH",12,1,71,0)="     5.  Inhibit users from login into the system.  DIED and is used"
^DIC(9.4,13,22,8,"PAH",12,1,72,0)="heavily in VISTA applications. A consequence of installing this patch"
