^DIC(9.4,120,22,12,"PAH",118,0)="121^3110308.134908^17"
^DIC(9.4,120,22,12,"PAH",119,0)="148 SEQ #124^3110715.120445^17"
^DIC(9.4,120,22,12,"PAH",119,1,0)="^^87^87^3110715"
^DIC(9.4,120,22,12,"PAH",119,1,1,0)="    <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,120,22,12,"PAH",119,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,3,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,4,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,5,0)="The documentation will be in the form of Adobe Acrobat files."
^DIC(9.4,120,22,12,"PAH",119,1,6,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,7,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,8,0)="Documentation can also be found on the System Design and Development Web"
^DIC(9.4,120,22,12,"PAH",119,1,9,0)="page at:  http://www.domain.ext/vdl/"
^DIC(9.4,120,22,12,"PAH",119,1,10,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,11,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,12,0)="Below is a list of the files related to this patch that will be needed"
^DIC(9.4,120,22,12,"PAH",119,1,13,0)="and available via the FTP sites listed above."
^DIC(9.4,120,22,12,"PAH",119,1,14,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,15,0)="File Description                        File Name                 FTP Mode"
^DIC(9.4,120,22,12,"PAH",119,1,16,0)="--------------------------------------------------------------------------"
^DIC(9.4,120,22,12,"PAH",119,1,17,0)="Revised IVM V2.0 User Manual            IVM_2_P148_UM.PDF         Binary"
^DIC(9.4,120,22,12,"PAH",119,1,18,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,19,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,20,0)="Associated Test Sites:"
^DIC(9.4,120,22,12,"PAH",119,1,21,0)="----------------------"
^DIC(9.4,120,22,12,"PAH",119,1,22,0)="Puget Sound Health Care Center"
^DIC(9.4,120,22,12,"PAH",119,1,23,0)="VA Heartland West"
^DIC(9.4,120,22,12,"PAH",119,1,24,0)="VA Maryland Health Care System"
^DIC(9.4,120,22,12,"PAH",119,1,25,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,26,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,27,0)="INSTALLATION INSTRUCTIONS:"
^DIC(9.4,120,22,12,"PAH",119,1,28,0)="=========================="
^DIC(9.4,120,22,12,"PAH",119,1,29,0)="This patch may be installed during normal working hours; however,"
^DIC(9.4,120,22,12,"PAH",119,1,30,0)="this patch should NOT be installed while the IVM BACKGROUND JOB [IVM"
^DIC(9.4,120,22,12,"PAH",119,1,31,0)="BACKGROUND JOB] is running. VISTA users will not be affected."
^DIC(9.4,120,22,12,"PAH",119,1,32,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,33,0)="Install Time - less than 5 minutes"
^DIC(9.4,120,22,12,"PAH",119,1,34,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,35,0)="1.  LOAD TRANSPORT GLOBAL"
^DIC(9.4,120,22,12,"PAH",119,1,36,0)="    ---------------------"
^DIC(9.4,120,22,12,"PAH",119,1,37,0)="    Choose the PackMan message containing this patch and invoke the"
^DIC(9.4,120,22,12,"PAH",119,1,38,0)="    INSTALL/CHECK MESSAGE PackMan option."
^DIC(9.4,120,22,12,"PAH",119,1,39,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,40,0)="2.  START UP KIDS"
^DIC(9.4,120,22,12,"PAH",119,1,41,0)="    -------------"
^DIC(9.4,120,22,12,"PAH",119,1,42,0)="    Start up the Kernel Installation and Distribution System Menu"
^DIC(9.4,120,22,12,"PAH",119,1,43,0)="    [XPD MAIN]:"
^DIC(9.4,120,22,12,"PAH",119,1,44,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,45,0)="         Edits and Distribution ..."
^DIC(9.4,120,22,12,"PAH",119,1,46,0)="         Utilities ..."
^DIC(9.4,120,22,12,"PAH",119,1,47,0)="         Installation ..."
^DIC(9.4,120,22,12,"PAH",119,1,48,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,49,0)="Select Kernel Installation & Distribution System Option: INStallation"
^DIC(9.4,120,22,12,"PAH",119,1,50,0)="                                                         ---"
^DIC(9.4,120,22,12,"PAH",119,1,51,0)="         Load a Distribution"
^DIC(9.4,120,22,12,"PAH",119,1,52,0)="         Print Transport Global"
^DIC(9.4,120,22,12,"PAH",119,1,53,0)="         Compare Transport Global to Current System"
^DIC(9.4,120,22,12,"PAH",119,1,54,0)="         Verify Checksums in Transport Global"
^DIC(9.4,120,22,12,"PAH",119,1,55,0)="         Install Package(s)"
^DIC(9.4,120,22,12,"PAH",119,1,56,0)="         Restart Install of Package(s)"
^DIC(9.4,120,22,12,"PAH",119,1,57,0)="         Unload a Distribution"
^DIC(9.4,120,22,12,"PAH",119,1,58,0)="         Backup a Transport Global"
^DIC(9.4,120,22,12,"PAH",119,1,59,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,60,0)="Select Installation Option:"
^DIC(9.4,120,22,12,"PAH",119,1,61,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,62,0)="3.  Select Installation Option:"
^DIC(9.4,120,22,12,"PAH",119,1,63,0)="    ---------------------------"
^DIC(9.4,120,22,12,"PAH",119,1,64,0)="    NOTE:  The following are OPTIONAL - (When prompted for the INSTALL"
^DIC(9.4,120,22,12,"PAH",119,1,65,0)="           NAME, enter IVM*2.0*148):"
^DIC(9.4,120,22,12,"PAH",119,1,66,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,67,0)="    a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,120,22,12,"PAH",119,1,68,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,120,22,12,"PAH",119,1,69,0)="        backup any other changes such as DD's or templates."
^DIC(9.4,120,22,12,"PAH",119,1,70,0)="    b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,120,22,12,"PAH",119,1,71,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,120,22,12,"PAH",119,1,72,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,120,22,12,"PAH",119,1,73,0)="        (routines, DD's, templates, etc.)."
^DIC(9.4,120,22,12,"PAH",119,1,74,0)="    c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,120,22,12,"PAH",119,1,75,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,120,22,12,"PAH",119,1,76,0)="        transport global."
^DIC(9.4,120,22,12,"PAH",119,1,77,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,78,0)="4.  Select Installation Option: Install Package(s)"
^DIC(9.4,120,22,12,"PAH",119,1,79,0)="                                ------------------"
^DIC(9.4,120,22,12,"PAH",119,1,80,0)="    **This is the step to start the installation of this KIDS patch:"
^DIC(9.4,120,22,12,"PAH",119,1,81,0)=" "
^DIC(9.4,120,22,12,"PAH",119,1,82,0)="    a.  Choose the Install Package(s) option to start the patch"
^DIC(9.4,120,22,12,"PAH",119,1,83,0)="        install.  When prompted for INSTALL NAME, enter IVM*2.0*148."
^DIC(9.4,120,22,12,"PAH",119,1,84,0)="    b.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,120,22,12,"PAH",119,1,85,0)="        YES//' answer NO"
^DIC(9.4,120,22,12,"PAH",119,1,86,0)="    c.  When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,120,22,12,"PAH",119,1,87,0)="        Options, and Protocols? NO//' answer NO"
^DIC(9.4,120,22,12,"PAH",120,0)="149^3110919.111546^17"
^DIC(9.4,120,22,12,"PAH",120,1,0)="^^2^2^3110919"
^DIC(9.4,120,22,12,"PAH",120,1,1,0)="This patch contains VistA changes to support technology and business"
^DIC(9.4,120,22,12,"PAH",120,1,2,0)="changes that are occurring with the implementation of Public Law 111-163."
^DIC(9.4,120,22,12,"PAH",121,0)="147^3110923.143553^17"
^DIC(9.4,120,22,12,"PAH",122,0)="151 SEQ #127^3111202.121705^17"
^DIC(9.4,120,22,12,"PAH",123,0)="141^3120329.183625^17"
^DIC(9.4,120,22,12,"PAH",123,1,0)="^^1^1^3120329"
^DIC(9.4,120,22,12,"PAH",123,1,1,0)="MILITARY SERVICE DATA SHARING (MSDS) PROJECT"
^DIC(9.4,120,22,12,"PAH",124,0)="150^3120829.114523^17"
^DIC(9.4,120,22,12,"PAH",125,0)="152^3121213.112908^17"
^DIC(9.4,120,22,12,"PAH",125,1,0)="^^1^1^3121213"
^DIC(9.4,120,22,12,"PAH",125,1,1,0)="Permanent Address Verification"
^DIC(9.4,120,22,12,"PAH",126,0)="154^3140324.154004^17"
^DIC(9.4,120,22,12,"PAH",126,1,0)="^^3^3^3140324"
^DIC(9.4,120,22,12,"PAH",126,1,1,0)="This patch contains VistA changes to support technology and"
^DIC(9.4,120,22,12,"PAH",126,1,2,0)="business changes that are occurring with the implementation of"
^DIC(9.4,120,22,12,"PAH",126,1,3,0)="Discontinue Annual Means Test Renewal."
^DIC(9.4,120,22,12,"PAH",127,0)="145 SEQ #132^3140624.111627^17"
^DIC(9.4,120,22,12,"PAH",127,1,0)="^^12^12^3140624"
^DIC(9.4,120,22,12,"PAH",127,1,1,0)="This patch corrects a problem where an ORU-Z05 message uploaded from ESR "
^DIC(9.4,120,22,12,"PAH",127,1,2,0)="to VistA is not processed in the IVM Demographic Upload screen because an"
^DIC(9.4,120,22,12,"PAH",127,1,3,0)="'Invalid Date of Death' error is generated.  This problem occurs when a "
^DIC(9.4,120,22,12,"PAH",127,1,4,0)="Date of Death message containing a time value, which is sent in the "
^DIC(9.4,120,22,12,"PAH",127,1,5,0)="ORU-Z05, is uploaded on the SAME DAY that the death occurred.  "
^DIC(9.4,120,22,12,"PAH",127,1,6,0)=" "
^DIC(9.4,120,22,12,"PAH",127,1,7,0)="This patch also removes an API call to a non-existent routine, DGPFSS2.  "
^DIC(9.4,120,22,12,"PAH",127,1,8,0)="This call was inserted for the PFSS Project, but the project was later "
^DIC(9.4,120,22,12,"PAH",127,1,9,0)="cancelled and the routine was removed after the cleanup of old routines "
^DIC(9.4,120,22,12,"PAH",127,1,10,0)="that were inadvertently left behind.  This will NOT cause problems in "
^DIC(9.4,120,22,12,"PAH",127,1,11,0)="production accounts, as there is a check in place to verify that the "
^DIC(9.4,120,22,12,"PAH",127,1,12,0)="account is not a test account."
^DIC(9.4,120,22,12,"PAH",128,0)="156^3140709.153311^17"
^DIC(9.4,120,22,12,"PAH",128,1,0)="^^7^7^3140709"
^DIC(9.4,120,22,12,"PAH",128,1,1,0)="This patch will make changes to the IVM routines that will check and verify"
^DIC(9.4,120,22,12,"PAH",128,1,2,0)="the HL7 is active before creating and transmitting the HL7 data.  Patch"
^DIC(9.4,120,22,12,"PAH",128,1,3,0)="EAS*1*96 will disable the HL7 protocols to prevent data from being sent to the"
^DIC(9.4,120,22,12,"PAH",128,1,4,0)="HEC system.  Prior to the installation of this patch, the IVM routines did"
^DIC(9.4,120,22,12,"PAH",128,1,5,0)="not check for the protocols to see if they are disabled.  Once this patch is"
^DIC(9.4,120,22,12,"PAH",128,1,6,0)="installed, the routines will make the check and stop the transmission of data"
^DIC(9.4,120,22,12,"PAH",128,1,7,0)="if the protocol is disabled."
^DIC(9.4,120,22,12,"PAH",129,0)="158^3150826.164625^17"
^DIC(9.4,120,22,12,"PAH",129,1,0)="^^15^15^3150826"
^DIC(9.4,120,22,12,"PAH",129,1,1,0)="This patch modifies the Income Verification Match v2.0 application as "
^DIC(9.4,120,22,12,"PAH",129,1,2,0)="described below:"
^DIC(9.4,120,22,12,"PAH",129,1,3,0)=" "
^DIC(9.4,120,22,12,"PAH",129,1,4,0)="1. If the VETERAN CATASTROPHICALLY DISABLED? (#.39) field of the "
^DIC(9.4,120,22,12,"PAH",129,1,5,0)="PATIENT (#2) file equals ""Y"" and no CD DESCRIPTORS are on file,  CD "
^DIC(9.4,120,22,12,"PAH",129,1,6,0)="STATUS DIAGNOSES, CD STATUS PROCEDURES and CD STATUS CONDITIONS will be "
^DIC(9.4,120,22,12,"PAH",129,1,7,0)="sent on the HL7 Z07 message."
^DIC(9.4,120,22,12,"PAH",129,1,8,0)=" "
^DIC(9.4,120,22,12,"PAH",129,1,9,0)="2. If the VETERAN CATASTROPHICALLY DISABLED? (#.39) field of the PATIENT "
^DIC(9.4,120,22,12,"PAH",129,1,10,0)="(#2) file equals ""Y"" and new CD STATUS DESCRIPTORS are on File, CD "
^DIC(9.4,120,22,12,"PAH",129,1,11,0)="DESCRIPTORS in lieu of CD STATUS DIAGNOSES, CD STATUS PROCEDURES and CD "
^DIC(9.4,120,22,12,"PAH",129,1,12,0)="STATUS CONDITIONS will be sent on the HL7 Z07 message."
^DIC(9.4,120,22,12,"PAH",129,1,13,0)=" "
^DIC(9.4,120,22,12,"PAH",129,1,14,0)="3. If the VETERAN CATASTROPHICALLY DISABLED? (#.39) field of the PATIENT "
^DIC(9.4,120,22,12,"PAH",129,1,15,0)="(#2) file equals ""N"", it will not send anything."
^DIC(9.4,120,22,12,"PAH",130,0)="159^3151102.135541^17"
^DIC(9.4,120,22,12,"PAH",130,1,0)="^^4^4^3151102"
^DIC(9.4,120,22,12,"PAH",130,1,1,0)="Patch IVM*2*159 addresses one issue:"
^DIC(9.4,120,22,12,"PAH",130,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",130,1,3,0)="       1.  MPI/IVM process is not dinuming patients ethnicities and "
^DIC(9.4,120,22,12,"PAH",130,1,4,0)="           mulitple races correctly."
^DIC(9.4,120,22,12,"PAH",131,0)="160^3160105.12114^54"
^DIC(9.4,120,22,12,"PAH",131,1,0)="^^17^17^3160105"
^DIC(9.4,120,22,12,"PAH",131,1,1,0)="  The Health Eligibility Center (HEC) requested modifications to the "
^DIC(9.4,120,22,12,"PAH",131,1,2,0)="  Enrollment System Redesign (ESR) and VistA Registration, Enrollment "
^DIC(9.4,120,22,12,"PAH",131,1,3,0)="  and Eligibility (Vista REE) software to support the requirements of   "
^DIC(9.4,120,22,12,"PAH",131,1,4,0)="  the Veterans Financial Assessment (VFA) projects."
^DIC(9.4,120,22,12,"PAH",131,1,5,0)=" "
^DIC(9.4,120,22,12,"PAH",131,1,6,0)="  This patch modifies the Enrollment Application System V2.0 application"
^DIC(9.4,120,22,12,"PAH",131,1,7,0)="  as described below:"
^DIC(9.4,120,22,12,"PAH",131,1,8,0)=" "
^DIC(9.4,120,22,12,"PAH",131,1,9,0)="   HL7 Changes"
^DIC(9.4,120,22,12,"PAH",131,1,10,0)="  ----------------------------------------------------------"
^DIC(9.4,120,22,12,"PAH",131,1,11,0)="  This patch supports HL7 enhancements that sends Contributed To "
^DIC(9.4,120,22,12,"PAH",131,1,12,0)="  Spouse and Contributed to Child Z10 ZIR-15 and stores them in the      "
^DIC(9.4,120,22,12,"PAH",131,1,13,0)="  database. Patch DG*5.3*890 will be released in conjunction with"
^DIC(9.4,120,22,12,"PAH",131,1,14,0)="  this EAS patch."
^DIC(9.4,120,22,12,"PAH",131,1,15,0)=" "
^DIC(9.4,120,22,12,"PAH",131,1,16,0)="  This patch also adds the Beneficiary Travel Financial Indicator (BTFI) "
^DIC(9.4,120,22,12,"PAH",131,1,17,0)="  to the Z07 ZMT-31 to send the BTFI back to the Enrollment System."
^DIC(9.4,120,22,12,"PAH",132,0)="161^3160418.153015^54"
^DIC(9.4,120,22,12,"PAH",132,1,0)="^^3^3^3160418"
^DIC(9.4,120,22,12,"PAH",132,1,1,0)="Related to DG*5.3*909"
^DIC(9.4,120,22,12,"PAH",132,1,2,0)="IVM*2.0*161 will update the Registration application to allow for the"
^DIC(9.4,120,22,12,"PAH",132,1,3,0)="entering and maintenance of the Camp Lejeune Eligibility related data."
^DIC(9.4,120,22,12,"PAH",133,0)="153^3161014.135219^54"
^DIC(9.4,120,22,12,"PAH",133,1,0)="^^19^19^3161014"
^DIC(9.4,120,22,12,"PAH",133,1,1,0)="Patch DG*5.3*797 added the new MILITARY SERVICE EPISODE sub-file #2.3216 "
^DIC(9.4,120,22,12,"PAH",133,1,2,0)="in the PATIENT (#2) file to store Military Service Episode (MSE) data."
^DIC(9.4,120,22,12,"PAH",133,1,3,0)="Changes in that patch included modifications to several consistency "
^DIC(9.4,120,22,12,"PAH",133,1,4,0)="checks that used MSE data.  The checks for data inconsistencies should "
^DIC(9.4,120,22,12,"PAH",133,1,5,0)="only be checking the MSEs in the new MILITARY SERVICE EPISODE sub-file "
^DIC(9.4,120,22,12,"PAH",133,1,6,0)="(#2.3216) in PATIENT (#2)file.  "
^DIC(9.4,120,22,12,"PAH",133,1,7,0)=" "
^DIC(9.4,120,22,12,"PAH",133,1,8,0)="However, during the check for inconsistencies that would prevent the "
^DIC(9.4,120,22,12,"PAH",133,1,9,0)="transmission of a Z07 HL7 message to the Health Eligibility Center (HEC), "
^DIC(9.4,120,22,12,"PAH",133,1,10,0)="the MSE data in the old location is being checked instead of the MSEs in "
^DIC(9.4,120,22,12,"PAH",133,1,11,0)="the new location.  This is causing invalid inconsistency errors to be "
^DIC(9.4,120,22,12,"PAH",133,1,12,0)="filed in the INCONSISTENT DATA file (#38.5), and preventing the "
^DIC(9.4,120,22,12,"PAH",133,1,13,0)="transmission of the Z07 messages for those patients. "
^DIC(9.4,120,22,12,"PAH",133,1,14,0)=" "
^DIC(9.4,120,22,12,"PAH",133,1,15,0)="The wrong MSE data is being checked for the following inconsistencies:"
^DIC(9.4,120,22,12,"PAH",133,1,16,0)=" "
^DIC(9.4,120,22,12,"PAH",133,1,17,0)="  83    MERCH SEA OR FILIPINO VET BOS REQUIRES SERVICE DATES DURING WWII"
^DIC(9.4,120,22,12,"PAH",133,1,18,0)="  85    VERIFIED FILIPINO VETERAN SHOULD HAVE A VETERAN STATUS OF 'YES'"
^DIC(9.4,120,22,12,"PAH",133,1,19,0)="  86    INELIGIBLE FILIPINO VETERAN SHOULD HAVE A VETERAN STATUS OF 'NO'"
^DIC(9.4,120,22,12,"PAH",134,0)="165 SEQ #139^3170928.165753^54"
^DIC(9.4,120,22,12,"PAH",134,1,0)="^^5^5^3170928"
^DIC(9.4,120,22,12,"PAH",134,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,120,22,12,"PAH",134,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",134,1,3,0)="1. The Z05 Enrollment/Eligibility upload transmission is incorrectly "
^DIC(9.4,120,22,12,"PAH",134,1,4,0)="   quitting if the Patient does not have an entry in the IVM PATIENT"
^DIC(9.4,120,22,12,"PAH",134,1,5,0)="   (#301.5) file."
^DIC(9.4,120,22,12,"PAH",135,0)="168 SEQ #140^3180130.142155^54"
^DIC(9.4,120,22,12,"PAH",135,1,0)="^^4^4^3180130"
^DIC(9.4,120,22,12,"PAH",135,1,1,0)="This patch will allow for processing of an imprecise retirement date being"
^DIC(9.4,120,22,12,"PAH",135,1,2,0)="passed back to the Enrollment System (ES) now that the ES is capable of"
^DIC(9.4,120,22,12,"PAH",135,1,3,0)="accepting this value. It will also improve formatting for the "
^DIC(9.4,120,22,12,"PAH",135,1,4,0)="patients cell phone and pager numbers stored when processing a Z05."
^DIC(9.4,120,22,12,"PAH",136,0)="167^3180228.164626^54"
^DIC(9.4,120,22,12,"PAH",136,1,0)="^^2^2^3180228"
^DIC(9.4,120,22,12,"PAH",136,1,1,0)="ENROLLMENT SYSTEM COMMUNITY CARE (ESCC) HOME PHONE AND FUTURE DISCHARGE "
^DIC(9.4,120,22,12,"PAH",136,1,2,0)="DATE UPDATES"
^DIC(9.4,120,22,12,"PAH",137,0)="171 SEQ #142^3180803.150528^54"
^DIC(9.4,120,22,12,"PAH",137,1,0)="^^2^2^3180803"
^DIC(9.4,120,22,12,"PAH",137,1,1,0)="Please see the IVM*2.0*171 patch description for detailed information"
^DIC(9.4,120,22,12,"PAH",137,1,2,0)="regarding this patch."
^DIC(9.4,120,22,12,"PAH",138,0)="164^3190103.170115^54"
^DIC(9.4,120,22,12,"PAH",138,1,0)="^^2^2^3190103"
^DIC(9.4,120,22,12,"PAH",138,1,1,0)="Please see the IVM*2.0*164 patch description for detailed information"
^DIC(9.4,120,22,12,"PAH",138,1,2,0)="regarding this patch.  "
^DIC(9.4,120,22,12,"PAH",139,0)="174^3190201.125643^54"
^DIC(9.4,120,22,12,"PAH",139,1,0)="^^1^1^3190201"
^DIC(9.4,120,22,12,"PAH",139,1,1,0)="Please refer to the Patch Description in FORUM for patch IVM*2.0*174"
^DIC(9.4,120,22,12,"PAH",140,0)="172 SEQ #146^3190201.16054^54"
^DIC(9.4,120,22,12,"PAH",140,1,0)="^^2^2^3190201"
^DIC(9.4,120,22,12,"PAH",140,1,1,0)="Please see the IVM*2.0*172 patch description for detailed information "
^DIC(9.4,120,22,12,"PAH",140,1,2,0)="regarding this patch."
^DIC(9.4,120,22,12,"PAH",141,0)="177 SEQ #147^3190301.153911^54"
^DIC(9.4,120,22,12,"PAH",141,1,0)="^^1^1^3190301"
^DIC(9.4,120,22,12,"PAH",141,1,1,0)="Please refer to the Patch Description in FORUM for patch IVM*2.0*177"
^DIC(9.4,120,22,12,"PAH",142,0)="182 SEQ #148^3190912.115534^65"
^DIC(9.4,120,22,12,"PAH",142,1,0)="^^5^5^3190912"
^DIC(9.4,120,22,12,"PAH",142,1,1,0)="The business owners have requested 'VET360' be added as a selection to "
^DIC(9.4,120,22,12,"PAH",142,1,2,0)="the ADDRESS CHANGE SOURCE (#3) Field in the IVM ADDRESS CHANGE LOG"
^DIC(9.4,120,22,12,"PAH",142,1,3,0)="(#301.7) File. This field should match the values available in ADDRESS"
^DIC(9.4,120,22,12,"PAH",142,1,4,0)="CHANGE SOURCE (#.119) Field in the PATIENT (#2) File. Otherwise there may"
^DIC(9.4,120,22,12,"PAH",142,1,5,0)="be issues utilizing FileMan utilities in the future."
^DIC(9.4,120,22,12,"PAH",143,0)="180^3190912.122259^65"
^DIC(9.4,120,22,12,"PAH",143,1,0)="^^2^2^3190912"
^DIC(9.4,120,22,12,"PAH",143,1,1,0)="Please see the IVM*2.0*180 patch description for detailed information "
^DIC(9.4,120,22,12,"PAH",143,1,2,0)="regarding this patch."
^DIC(9.4,120,22,12,"PAH",144,0)="179 SEQ #150^3191024.120845^65"
^DIC(9.4,120,22,12,"PAH",144,1,0)="^^7^7^3191024"
^DIC(9.4,120,22,12,"PAH",144,1,1,0)="Patch IVM*2.0*179 fixes an issue where the DHCP OUTPUT LOGIC (#20) field"
^DIC(9.4,120,22,12,"PAH",144,1,2,0)="of the IVM DEMOGRAPHIC UPLOAD FIELDS (#301.92) file does not show a string"
^DIC(9.4,120,22,12,"PAH",144,1,3,0)="for 3 entries (70-72),Temporary Address Zip, Temporary Address Country, "
^DIC(9.4,120,22,12,"PAH",144,1,4,0)="Temporary Address County and has an incorrect string for 2 entries"
^DIC(9.4,120,22,12,"PAH",144,1,5,0)="(73 & 74),Temporary Address Province and Temporary Address Postal Code."
^DIC(9.4,120,22,12,"PAH",144,1,6,0)="It also modifies the TRANSFORM DHCP DATA (.07) field to equal 1 for"
^DIC(9.4,120,22,12,"PAH",144,1,7,0)="records 71 and 72."
^DIC(9.4,120,22,12,"PAH",145,0)="183^3191206.155523^65"
^DIC(9.4,120,22,12,"PAH",145,1,0)="^^2^2^3191206"
^DIC(9.4,120,22,12,"PAH",145,1,1,0)="Please see the IVM*2.0*183 patch description for detailed information "
^DIC(9.4,120,22,12,"PAH",145,1,2,0)="regarding this patch."
^DIC(9.4,120,22,12,"PAH",146,0)="185 SEQ #151^3191206.160316^65"
^DIC(9.4,120,22,12,"PAH",146,1,0)="^^3^3^3191206"
^DIC(9.4,120,22,12,"PAH",146,1,1,0)="This patch will address a request to sync the SOURCE OF INCOME TEST"
^DIC(9.4,120,22,12,"PAH",146,1,2,0)="(#408.34) file with the Standard Data Service (SDS) database. Two new"
^DIC(9.4,120,22,12,"PAH",146,1,3,0)="entries will be added to the SOURCE OF INCOME TEST (#408.34) file."
^DIC(9.4,120,22,12,"PAH",147,0)="188^3200122.162128^65"
^DIC(9.4,120,22,12,"PAH",147,1,0)="^^2^2^3200122"
^DIC(9.4,120,22,12,"PAH",147,1,1,0)="Please see the IVM*2.0*188 patch description for detailed information"
^DIC(9.4,120,22,12,"PAH",147,1,2,0)="regarding this patch."
^DIC(9.4,120,22,12,"PAH",148,0)="184^3200220.141209^65"
^DIC(9.4,120,22,12,"PAH",148,1,0)="^^20^20^3200220"
^DIC(9.4,120,22,12,"PAH",148,1,1,0)="The patch is delivered in a bundle with DG*5.3*952 to support "
^DIC(9.4,120,22,12,"PAH",148,1,2,0)="implementation of EXPANDED MH CARE NON-VETERANS as a primary eligibility "
^DIC(9.4,120,22,12,"PAH",148,1,3,0)="code (and a Medical Administration Service (MAS) eligibility code) in "
^DIC(9.4,120,22,12,"PAH",148,1,4,0)="VistA Registration to identify and support Other Than Honorably (OTH) "
^DIC(9.4,120,22,12,"PAH",148,1,5,0)="discharged patients who need mental healthcare services, in order to help "
^DIC(9.4,120,22,12,"PAH",148,1,6,0)="reduce the number of Veteran suicides.  These patients are awaiting "
^DIC(9.4,120,22,12,"PAH",148,1,7,0)="adjudication and are entitled to receiving mental health treatment during "
^DIC(9.4,120,22,12,"PAH",148,1,8,0)="that timeframe from the VA either for 90-day episodes of care for service "
^DIC(9.4,120,22,12,"PAH",148,1,9,0)="related emergent mental health issues. "
^DIC(9.4,120,22,12,"PAH",148,1,10,0)=" "
^DIC(9.4,120,22,12,"PAH",148,1,11,0)="This patch also supports the new a sub-eligibility, which is implemented "
^DIC(9.4,120,22,12,"PAH",148,1,12,0)="by DG*5.3*952 as a new ""EXPANDED MH CARE TYPE"" field in VistA PATIENT "
^DIC(9.4,120,22,12,"PAH",148,1,13,0)="file (#2), for EMERGENT MH OTH type that supports providing mental health "
^DIC(9.4,120,22,12,"PAH",148,1,14,0)="care in one or more 90-day"
^DIC(9.4,120,22,12,"PAH",148,1,15,0)="periods (additional periods require authorization) for eligible patients."
^DIC(9.4,120,22,12,"PAH",148,1,16,0)=" "
^DIC(9.4,120,22,12,"PAH",148,1,17,0)="HL7 messaging has been updated in this patch to ensure VistA Registration "
^DIC(9.4,120,22,12,"PAH",148,1,18,0)="changes are communicated to the Enrollment System (ES). OTH patient data"
^DIC(9.4,120,22,12,"PAH",148,1,19,0)="will be shared with ES and if a patient record is updated in ES, it will "
^DIC(9.4,120,22,12,"PAH",148,1,20,0)="continue to be updated in VistA."
^DIC(9.4,120,22,12,"PAH",149,0)="190^3200515.093401^70"
^DIC(9.4,120,22,12,"PAH",149,1,0)="^^2^2^3200515"
^DIC(9.4,120,22,12,"PAH",149,1,1,0)="Please see the IVM*2*190 patch description for detailed information "
