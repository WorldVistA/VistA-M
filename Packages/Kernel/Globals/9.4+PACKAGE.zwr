^DIC(9.4,5,22,13,"PAH",100,0)="137 SEQ #110^3150128.103658^17"
^DIC(9.4,5,22,13,"PAH",100,1,0)="^^7^7^3150128"
^DIC(9.4,5,22,13,"PAH",100,1,1,0)="Patch XT*7.3*137 addresses 4 issues:"
^DIC(9.4,5,22,13,"PAH",100,1,2,0)=" "
^DIC(9.4,5,22,13,"PAH",100,1,3,0)="       1.  Fields failing validation and preventing patient merge"
^DIC(9.4,5,22,13,"PAH",100,1,4,0)="       2.  Patient file pointer, .01 DINUMed fields that are new style "
^DIC(9.4,5,22,13,"PAH",100,1,5,0)="           xrefs are not merging properly on patient merge"
^DIC(9.4,5,22,13,"PAH",100,1,6,0)="       3.  Aliases duplicated on patient merge"
^DIC(9.4,5,22,13,"PAH",100,1,7,0)="       4.  'Test patient Indicator' field being copied on patient merge"
^DIC(9.4,5,22,13,"PAH",101,0)="140^3190815.16234^65"
^DIC(9.4,5,22,13,"PAH",101,1,0)="^^199^199^3190815"
^DIC(9.4,5,22,13,"PAH",101,1,1,0)="Subject:  Update XINDEX to support SACWG changes"
^DIC(9.4,5,22,13,"PAH",101,1,2,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,3,0)="Category:  ROUTINE"
^DIC(9.4,5,22,13,"PAH",101,1,4,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,5,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,6,0)="Description:"
^DIC(9.4,5,22,13,"PAH",101,1,7,0)="============"
^DIC(9.4,5,22,13,"PAH",101,1,8,0)="This build deploys changes to XINDEX and the ZOSF routine via 2 patches"
^DIC(9.4,5,22,13,"PAH",101,1,9,0)="being released in HOST file TOOLKIT_XINDEX_73.KID"
^DIC(9.4,5,22,13,"PAH",101,1,10,0)="  1. Patch XT*7.3*140"
^DIC(9.4,5,22,13,"PAH",101,1,11,0)="    a) Contains 14 XINDEX routines"
^DIC(9.4,5,22,13,"PAH",101,1,12,0)="    b) Will update the XINDEX utility to support the new changes to the"
^DIC(9.4,5,22,13,"PAH",101,1,13,0)="        Standards and Conventions (SAC).  The following changes have been"
^DIC(9.4,5,22,13,"PAH",101,1,14,0)="        approved by SAC Committee:"
^DIC(9.4,5,22,13,"PAH",101,1,15,0)="           1) Routine name and labels can be 16 uppercase characters"
^DIC(9.4,5,22,13,"PAH",101,1,16,0)="           2) Local variable names can be 16 characters. "
^DIC(9.4,5,22,13,"PAH",101,1,17,0)="           3) Namespaced variables must be all uppercase."
^DIC(9.4,5,22,13,"PAH",101,1,18,0)="  2. Patch XU*8*661"
^DIC(9.4,5,22,13,"PAH",101,1,19,0)="    a) The ZOSFONT routine"
^DIC(9.4,5,22,13,"PAH",101,1,20,0)="    b) 14 fields from 8 files that references a routine or tag  "
^DIC(9.4,5,22,13,"PAH",101,1,21,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,22,0)="Patch Components"
^DIC(9.4,5,22,13,"PAH",101,1,23,0)="================"
^DIC(9.4,5,22,13,"PAH",101,1,24,0)=" none"
^DIC(9.4,5,22,13,"PAH",101,1,25,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,26,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,27,0)="Blood Bank Clearance"
^DIC(9.4,5,22,13,"PAH",101,1,28,0)="===================="
^DIC(9.4,5,22,13,"PAH",101,1,29,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch XT*7.3*140 contains"
^DIC(9.4,5,22,13,"PAH",101,1,30,0)="changes to a package referenced in ProPath standard titled: BBM Team"
^DIC(9.4,5,22,13,"PAH",101,1,31,0)="Review of VistA Patches. This patch does not alter or modify any VistA"
^DIC(9.4,5,22,13,"PAH",101,1,32,0)="Blood Bank software design safeguards or safety critical elements"
^DIC(9.4,5,22,13,"PAH",101,1,33,0)="functions."
^DIC(9.4,5,22,13,"PAH",101,1,34,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,35,0)="RISK ANALYSIS: Changes made by patch XT*7.3*140 have no effect on Blood"
^DIC(9.4,5,22,13,"PAH",101,1,36,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,5,22,13,"PAH",101,1,37,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,38,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,39,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,5,22,13,"PAH",101,1,40,0)="============================================ "
^DIC(9.4,5,22,13,"PAH",101,1,41,0)="Ticket: I9055002FY16 - XINDEX doesn't support SACC changes to routine"
^DIC(9.4,5,22,13,"PAH",101,1,42,0)="        names and tags"
^DIC(9.4,5,22,13,"PAH",101,1,43,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,44,0)="Problem:"
^DIC(9.4,5,22,13,"PAH",101,1,45,0)=" XINDEX utility needs to support routine name and labels to 16 characters"
^DIC(9.4,5,22,13,"PAH",101,1,46,0)=" and local variables names to 16 characters. Add support for all areas in"
^DIC(9.4,5,22,13,"PAH",101,1,47,0)=" VA FileMan that can contain M code."
^DIC(9.4,5,22,13,"PAH",101,1,48,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,49,0)="Resolution:"
^DIC(9.4,5,22,13,"PAH",101,1,50,0)=" Change the following routines to support 16 characters and other M code:"
^DIC(9.4,5,22,13,"PAH",101,1,51,0)=" XINDX1"
^DIC(9.4,5,22,13,"PAH",101,1,52,0)=" XINDX11"
^DIC(9.4,5,22,13,"PAH",101,1,53,0)=" XINDX12"
^DIC(9.4,5,22,13,"PAH",101,1,54,0)=" XINDX13"
^DIC(9.4,5,22,13,"PAH",101,1,55,0)=" XINDX2"
^DIC(9.4,5,22,13,"PAH",101,1,56,0)=" XINDX3"
^DIC(9.4,5,22,13,"PAH",101,1,57,0)=" XINDX5"
^DIC(9.4,5,22,13,"PAH",101,1,58,0)=" XINDX51"
^DIC(9.4,5,22,13,"PAH",101,1,59,0)=" XINDX52"
^DIC(9.4,5,22,13,"PAH",101,1,60,0)=" XINDX53"
^DIC(9.4,5,22,13,"PAH",101,1,61,0)=" XINDX6"
^DIC(9.4,5,22,13,"PAH",101,1,62,0)=" XINDX7"
^DIC(9.4,5,22,13,"PAH",101,1,63,0)=" XINDX8"
^DIC(9.4,5,22,13,"PAH",101,1,64,0)=" XINDX9 "
^DIC(9.4,5,22,13,"PAH",101,1,65,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,66,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,67,0)="Test Site:"
^DIC(9.4,5,22,13,"PAH",101,1,68,0)="=========="
^DIC(9.4,5,22,13,"PAH",101,1,69,0)="Fargo, ND"
^DIC(9.4,5,22,13,"PAH",101,1,70,0)="South Texas, TX"
^DIC(9.4,5,22,13,"PAH",101,1,71,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,72,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,73,0)="Software and Documentation Retrieve Instructions:"
^DIC(9.4,5,22,13,"PAH",101,1,74,0)="================================================="
^DIC(9.4,5,22,13,"PAH",101,1,75,0)="No changes have been made to Kernel documentation as a result of this"
^DIC(9.4,5,22,13,"PAH",101,1,76,0)="patch.  However, the most up-to-date VA Kernel documentation is"
^DIC(9.4,5,22,13,"PAH",101,1,77,0)="available on the VHA Software Documentation Library (VDL) at the"
^DIC(9.4,5,22,13,"PAH",101,1,78,0)="following:"
^DIC(9.4,5,22,13,"PAH",101,1,79,0)=" http://www.domain.ext/vdl/application.asp?appid=10"
^DIC(9.4,5,22,13,"PAH",101,1,80,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,81,0)="An updated copy of the SAC is available at:"
^DIC(9.4,5,22,13,"PAH",101,1,82,0)=" http://go.domain.ext/sacc"
^DIC(9.4,5,22,13,"PAH",101,1,83,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,84,0)="Download TOOLKIT_XINDEX_73.KID from the ftp site.  The preferred method is"
^DIC(9.4,5,22,13,"PAH",101,1,85,0)="to SFTP the file from sftp://download.vista.domain.ext/.  This transmits the"
^DIC(9.4,5,22,13,"PAH",101,1,86,0)="file from the first available SFTP server. Sites may also elect to retrieve"
^DIC(9.4,5,22,13,"PAH",101,1,87,0)="software directly from a specific server as follows:"
^DIC(9.4,5,22,13,"PAH",101,1,88,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,89,0)="Hines             sftp://ftp.fo-hines.domain.ext"
^DIC(9.4,5,22,13,"PAH",101,1,90,0)="Salt Lake City    sftp://ftp.fo-slc.domain.ext"
^DIC(9.4,5,22,13,"PAH",101,1,91,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,92,0)="The necessary file is TOOLKIT_XINDEX_73.KID, which is an ASCII file."
^DIC(9.4,5,22,13,"PAH",101,1,93,0)="Make a note of the directory name where the file was saved."
^DIC(9.4,5,22,13,"PAH",101,1,94,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,95,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,96,0)="Patch Installation:"
^DIC(9.4,5,22,13,"PAH",101,1,97,0)="==================="
^DIC(9.4,5,22,13,"PAH",101,1,98,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,99,0)="Pre-Installation Instructions:"
^DIC(9.4,5,22,13,"PAH",101,1,100,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,101,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,5,22,13,"PAH",101,1,102,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,5,22,13,"PAH",101,1,103,0)="potential disruption to users.  This patch should take less than 1 minutes"
^DIC(9.4,5,22,13,"PAH",101,1,104,0)="to install.  TaskMan doesn't need to be stopped or paused"
^DIC(9.4,5,22,13,"PAH",101,1,105,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,106,0)="Installation Instructions:"
^DIC(9.4,5,22,13,"PAH",101,1,107,0)="  "
^DIC(9.4,5,22,13,"PAH",101,1,108,0)=" 1. From the Kernel Installation and Distribution System (KIDS) menu select"
^DIC(9.4,5,22,13,"PAH",101,1,109,0)="    Installation Menu."
^DIC(9.4,5,22,13,"PAH",101,1,110,0)="   "
^DIC(9.4,5,22,13,"PAH",101,1,111,0)=" 2. Use the Load a Distribution option to load the TOOLKIT_XINDEX_73.KID file"
^DIC(9.4,5,22,13,"PAH",101,1,112,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,113,0)=" 3. You may select the following options:"
^DIC(9.4,5,22,13,"PAH",101,1,114,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,115,0)="    A. Select the Verify Checksums in Transport Global option to confirm "
^DIC(9.4,5,22,13,"PAH",101,1,116,0)="       the integrity of the routines that are in the transport global. When "
^DIC(9.4,5,22,13,"PAH",101,1,117,0)="       prompted for the INSTALL NAME enter XT*7.3*140"
^DIC(9.4,5,22,13,"PAH",101,1,118,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,119,0)="        NOTE: Using <spacebar><enter> will not bring up a Multi-Package build "
^DIC(9.4,5,22,13,"PAH",101,1,120,0)="              even if it was loaded immediately before this step. It will only "
^DIC(9.4,5,22,13,"PAH",101,1,121,0)="              bring up the last patch in the build."
^DIC(9.4,5,22,13,"PAH",101,1,122,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,123,0)="    B. Select the Backup a Transport Global option to create a backup message"
^DIC(9.4,5,22,13,"PAH",101,1,124,0)="       of any routines exported with this patch. It will not backup any other"
^DIC(9.4,5,22,13,"PAH",101,1,125,0)="       changes such as DDs or templates. "
^DIC(9.4,5,22,13,"PAH",101,1,126,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,127,0)="    C. You may also elect to use the following options: "
^DIC(9.4,5,22,13,"PAH",101,1,128,0)="         i.  Print Transport Global - This option will allow you to view"
^DIC(9.4,5,22,13,"PAH",101,1,129,0)="             the components of the KIDS build."
^DIC(9.4,5,22,13,"PAH",101,1,130,0)="         ii. Compare Transport Global to Current System - This option will"
^DIC(9.4,5,22,13,"PAH",101,1,131,0)="             allow you to view all changes that will be made when this patch"
^DIC(9.4,5,22,13,"PAH",101,1,132,0)="             is installed.  It compares all of the components of this patch,"
^DIC(9.4,5,22,13,"PAH",101,1,133,0)="             such as routines, DDs, templates, etc."
^DIC(9.4,5,22,13,"PAH",101,1,134,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,135,0)="    D. Select the Install Package(s) option and choose the patch to install. "
^DIC(9.4,5,22,13,"PAH",101,1,136,0)="   "
^DIC(9.4,5,22,13,"PAH",101,1,137,0)="          Select Installation Option: Install Package(s)"
^DIC(9.4,5,22,13,"PAH",101,1,138,0)="          Select INSTALL NAME: XT*7.3*140"
^DIC(9.4,5,22,13,"PAH",101,1,139,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,140,0)="     Want KIDS to INHIBIT LOGONs during the install? NO//"
^DIC(9.4,5,22,13,"PAH",101,1,141,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,142,0)="     Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO// "
^DIC(9.4,5,22,13,"PAH",101,1,143,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,144,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,145,0)=" Post-Installation Instructions:"
^DIC(9.4,5,22,13,"PAH",101,1,146,0)=" -------------------------------"
^DIC(9.4,5,22,13,"PAH",101,1,147,0)=" none"
^DIC(9.4,5,22,13,"PAH",101,1,148,0)="  "
^DIC(9.4,5,22,13,"PAH",101,1,149,0)="   "
^DIC(9.4,5,22,13,"PAH",101,1,150,0)=" Backout and Rollback Procedure:"
^DIC(9.4,5,22,13,"PAH",101,1,151,0)=" ------------------------------- "
^DIC(9.4,5,22,13,"PAH",101,1,152,0)=" If rollback/backout is required, the installer can restore the routines"
^DIC(9.4,5,22,13,"PAH",101,1,153,0)=" using the MailMan message that were saved prior to installing the"
^DIC(9.4,5,22,13,"PAH",101,1,154,0)=" patch.  The Data Dictionary changes are backwards compatible and can stay"
^DIC(9.4,5,22,13,"PAH",101,1,155,0)=" in production."
^DIC(9.4,5,22,13,"PAH",101,1,156,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,157,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,158,0)=" Routine Information:"
^DIC(9.4,5,22,13,"PAH",101,1,159,0)="===================="
^DIC(9.4,5,22,13,"PAH",101,1,160,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,161,0)="The second line of each of these routines now looks like:"
^DIC(9.4,5,22,13,"PAH",101,1,162,0)=" ;;7.3;TOOLKIT;**[Patch List]**;Apr 25, 1995;Build 38"
^DIC(9.4,5,22,13,"PAH",101,1,163,0)=" "
^DIC(9.4,5,22,13,"PAH",101,1,164,0)="The checksums below are new checksums, and"
^DIC(9.4,5,22,13,"PAH",101,1,165,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,5,22,13,"PAH",101,1,166,0)=" "
