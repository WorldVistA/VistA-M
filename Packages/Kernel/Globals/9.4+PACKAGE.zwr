^DIC(9.4,100,22,15,"PAH",139,1,1,0)="Update instrument PEBS-20."
^DIC(9.4,100,22,15,"PAH",139,1,2,0)="Update instrument MH REPORT for BRADEN SCALE."
^DIC(9.4,100,22,15,"PAH",139,1,3,0)="Update MINICOG scoring."
^DIC(9.4,100,22,15,"PAH",139,1,4,0)="Update BOMC scoring."
^DIC(9.4,100,22,15,"PAH",139,1,5,0)="Update MIDAS instrument to add Long COVID category."
^DIC(9.4,100,22,15,"PAH",139,1,6,0)="Update instrument Q-LES-Q-SF scoring routine to fix display."
^DIC(9.4,100,22,15,"PAH",139,1,7,0)="Add field 19, REVIEWED, to MH ADMINISTRATIONS."
^DIC(9.4,100,22,15,"PAH",139,1,8,0)="Add call to update instrument High Risk/Positive response in GET "
^DIC(9.4,100,22,15,"PAH",139,1,9,0)="assignment list."
^DIC(9.4,100,22,15,"PAH",139,1,10,0)="Add new instrument YMRS"
^DIC(9.4,100,22,15,"PAH",139,1,11,0)="Add new instruments MOCA_8.1, MOCA_8.2, MOCA_8.3, MOCA BLIND"
^DIC(9.4,100,22,15,"PAH",139,1,12,0)="Drop instruments CEMI, GPCOG, ISMI, COPD, STAI, STMS, ATQ, IJSS, BBHI-2, "
^DIC(9.4,100,22,15,"PAH",139,1,13,0)="MOCA, MOCA ALT 1, MOCA ALT 2, and CESD."
^DIC(9.4,100,22,15,"PAH",139,1,14,0)="Add unlocking to MH ADMINISTRATIONS file in YTQAPI1."
^DIC(9.4,100,22,15,"PAH",139,1,15,0)="Add new RPC for Reviewed Administration status. This will remain dormant "
^DIC(9.4,100,22,15,"PAH",139,1,16,0)="until patch YS*5.01*250 is released."
