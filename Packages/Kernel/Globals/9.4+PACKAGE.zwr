^DIC(9.4,175,22,2,"PAH",44,1,46,0)=" "
^DIC(9.4,175,22,2,"PAH",44,1,47,0)="TIU Enhancements patch."
^DIC(9.4,175,22,2,"PAH",44,1,48,0)="Adds functionality to Capture Application that will allow user to: "
^DIC(9.4,175,22,2,"PAH",44,1,49,0)="Create a New TIU Note"
^DIC(9.4,175,22,2,"PAH",44,1,50,0)="Create an Addendum to an existing signed TIU Note."
^DIC(9.4,175,22,2,"PAH",44,1,51,0)="Set the status of the new note/addendum to"
^DIC(9.4,175,22,2,"PAH",44,1,52,0)=" - unsigned"
^DIC(9.4,175,22,2,"PAH",44,1,53,0)=" - administrative closure"
^DIC(9.4,175,22,2,"PAH",44,1,54,0)=" - Signed."
^DIC(9.4,175,22,2,"PAH",44,1,55,0)="  "
^DIC(9.4,175,22,2,"PAH",44,1,56,0)="Displays the Note Title from the TIU Document file (8925) in the"
^DIC(9.4,175,22,2,"PAH",44,1,57,0)="  Image List Window of Imaging Display, this assures "
^DIC(9.4,175,22,2,"PAH",44,1,58,0)="display of the current Note title because Note Titles sometimes change."
^DIC(9.4,175,22,2,"PAH",44,1,59,0)="  "
^DIC(9.4,175,22,2,"PAH",44,1,60,0)="Imaging Display"
^DIC(9.4,175,22,2,"PAH",44,1,61,0)=" - Stops users that do not have an Imaging Display security from signing "
^DIC(9.4,175,22,2,"PAH",44,1,62,0)="on to Imaging Display. User needs either MAGDISP CLIN or"
^DIC(9.4,175,22,2,"PAH",44,1,63,0)="MAGDISP ADMIN or both."
^DIC(9.4,175,22,2,"PAH",44,1,64,0)="  "
^DIC(9.4,175,22,2,"PAH",44,1,65,0)="Imaging Capture"
^DIC(9.4,175,22,2,"PAH",44,1,66,0)="Automatically generates Index Values for new Images that do not have "
^DIC(9.4,175,22,2,"PAH",44,1,67,0)="index values as input data.  This happens when Applications using the "
^DIC(9.4,175,22,2,"PAH",44,1,68,0)="Import API or Imaging Capture Client versions prior to version 3.0.8"
^DIC(9.4,175,22,2,"PAH",44,1,69,0)="Index Term Fix:"
^DIC(9.4,175,22,2,"PAH",44,1,70,0)="Iterate through the entire Image Global and Fix the Index Terms if"
^DIC(9.4,175,22,2,"PAH",44,1,71,0)="Type Index is missing."
