^DIC(9.4,85,22,1.5,"PAH",3,1,1,0)="1. Y2K Waiver Exemption ID#:Y2KWE0034"
^DIC(9.4,85,22,1.5,"PAH",3,1,2,0)="   This patch may be installed at any time during the Y2K Moratorium"
^DIC(9.4,85,22,1.5,"PAH",3,1,3,0)="   (including the 12/15/99 thru 1/15/2000 Y2K lockdown)."
^DIC(9.4,85,22,1.5,"PAH",3,1,4,0)=" "
^DIC(9.4,85,22,1.5,"PAH",3,1,5,0)="   CLE-1199-42576,COS-1299-40012."
^DIC(9.4,85,22,1.5,"PAH",3,1,6,0)="   Several sites has indicated that PDX is unable to store data into"
