^DIC(9.4,4,22,1,"PAH",151,0)="182 SEQ #176^3010529^1"
^DIC(9.4,4,22,1,"PAH",151,1,0)="^^58^58^3010529"
^DIC(9.4,4,22,1,"PAH",151,1,1,0)="Patch XM*7.1*182"
^DIC(9.4,4,22,1,"PAH",151,1,2,0)=" "
^DIC(9.4,4,22,1,"PAH",151,1,3,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",151,1,4,0)="Test Site: GATEWAY.DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",151,1,5,0)="When sending a message to a remote site, and the remote site refuses to"
^DIC(9.4,4,22,1,"PAH",151,1,6,0)="accept a message from the particular sender, delete the message from the"
^DIC(9.4,4,22,1,"PAH",151,1,7,0)="queue, and notify the sender that the message was rejected."
^DIC(9.4,4,22,1,"PAH",151,1,8,0)=" "
^DIC(9.4,4,22,1,"PAH",151,1,9,0)="NOTE: This patch may be installed at any time, even during hours of peak"
^DIC(9.4,4,22,1,"PAH",151,1,10,0)="usage.  It requires MailMan patch XM*7.1*176."
^DIC(9.4,4,22,1,"PAH",151,1,11,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",151,1,12,0)=" "
