^DIC(9.4,48,22,5.28,"PAH",582,1,49,0)="JIRA tasks:"
^DIC(9.4,48,22,5.28,"PAH",582,1,50,0)="-----------"
^DIC(9.4,48,22,5.28,"PAH",582,1,51,0)="1) Jira #VSE-57: Changes made to User Preferences are not updating in "
^DIC(9.4,48,22,5.28,"PAH",582,1,52,0)="the RM Grid."
^DIC(9.4,48,22,5.28,"PAH",582,1,53,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,54,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,55,0)="Changes made to User Preferences are not updating in the RM Grid."
^DIC(9.4,48,22,5.28,"PAH",582,1,56,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,57,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,58,0)="The data in the RM Grid will match the User Preference setting. Changes "
^DIC(9.4,48,22,5.28,"PAH",582,1,59,0)="will be saved and updated in the User Preference menu. The Clear button "
^DIC(9.4,48,22,5.28,"PAH",582,1,60,0)="resets User Preferences and the RM Grid columns to the default sort order."
^DIC(9.4,48,22,5.28,"PAH",582,1,61,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,62,0)="2) Jira #VSE-775 Create Remote Procedure Call (RPC) SDES Get Appointment"
^DIC(9.4,48,22,5.28,"PAH",582,1,63,0)="List By Patient."
^DIC(9.4,48,22,5.28,"PAH",582,1,64,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,65,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,66,0)="Need to create a new SDES RPC to return an appointment list by patient and"
^DIC(9.4,48,22,5.28,"PAH",582,1,67,0)="start/end date."
^DIC(9.4,48,22,5.28,"PAH",582,1,68,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,69,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,70,0)="The new SDES APPT BY CLINIC JSON was created and will return it data in"
^DIC(9.4,48,22,5.28,"PAH",582,1,71,0)="JSON format. Returned data includes:"
^DIC(9.4,48,22,5.28,"PAH",582,1,72,0)="string ResourceName (Clinic name)"
^DIC(9.4,48,22,5.28,"PAH",582,1,73,0)="string Notes"
^DIC(9.4,48,22,5.28,"PAH",582,1,74,0)="string Duration"
^DIC(9.4,48,22,5.28,"PAH",582,1,75,0)="string StartTime (appointment date time)"
^DIC(9.4,48,22,5.28,"PAH",582,1,76,0)="string EndTime"
^DIC(9.4,48,22,5.28,"PAH",582,1,77,0)="string AppointmentID"
^DIC(9.4,48,22,5.28,"PAH",582,1,78,0)="string AppointmentTypeIEN"
^DIC(9.4,48,22,5.28,"PAH",582,1,79,0)="  bool IsOverbook"
^DIC(9.4,48,22,5.28,"PAH",582,1,80,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,81,0)="3) Jira #VSE-776 - Create RPC SDES Get Appointment List By Clinic."
^DIC(9.4,48,22,5.28,"PAH",582,1,82,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,83,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,84,0)="Need to create a new SDES RPC to return an appointment list by clinic and "
