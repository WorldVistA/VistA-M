^DIC(9.4,18,11)="6910^7336.9"
^DIC(9.4,18,22,0)="^9.49I^7^1"
^DIC(9.4,18,22,7,0)="7.0^3051119^2960611"
^DIC(9.4,18,22,7,1,0)="^9.54^3^3^3111220^^^^"
^DIC(9.4,18,22,7,1,1,0)="Restructuring of Work Order Module, conversion of LOCATIONS from"
^DIC(9.4,18,22,7,1,2,0)="free text into pointers, and electronic transmissions to Regional"
^DIC(9.4,18,22,7,1,3,0)="Construction offices."
^DIC(9.4,18,22,7,"PAH",0)="^9.4901^68^68"
^DIC(9.4,18,22,7,"PAH",1,0)="33^2960923^1"
^DIC(9.4,18,22,7,"PAH",1,1,0)="^^4^4^2960923"
^DIC(9.4,18,22,7,"PAH",1,1,1,0)="Patch EN*7*33 FIXED ASSETS CORRECTIONS"
^DIC(9.4,18,22,7,"PAH",1,1,2,0)="1. Update TOTAL ASSET VALUE in 6914 when FC DOCUMENT to 00 (FA) has zero"
^DIC(9.4,18,22,7,"PAH",1,1,3,0)="   value."
^DIC(9.4,18,22,7,"PAH",1,1,4,0)="2. Update FUND names list to match FMS table values."
^DIC(9.4,18,22,7,"PAH",2,0)="36^2961002^1"
^DIC(9.4,18,22,7,"PAH",2,1,0)="^^1^1^2961002"
^DIC(9.4,18,22,7,"PAH",2,1,1,0)="This patch adds Fund 4539 (Franchise Fund) to the NX FUND (#6914.6) file."
^DIC(9.4,18,22,7,"PAH",3,0)="32^2961015^1"
^DIC(9.4,18,22,7,"PAH",3,1,0)="^^1^1^2961015"
^DIC(9.4,18,22,7,"PAH",3,1,1,0)="JANUS 2020 BARCODE READER ENHANCEMENT"
^DIC(9.4,18,22,7,"PAH",4,0)="37^2961015^1"
^DIC(9.4,18,22,7,"PAH",4,1,0)="^^8^8^2961015"
^DIC(9.4,18,22,7,"PAH",4,1,1,0)="Correction to ENLIB3 so that EQUITY ACCOUNT will be inferred properly. A"
^DIC(9.4,18,22,7,"PAH",4,1,2,0)="patch for patch EN*7.0*33."
^DIC(9.4,18,22,7,"PAH",4,1,3,0)=" "
^DIC(9.4,18,22,7,"PAH",4,1,4,0)="Post-Installation routine corrects data in AEMS/MERS Equipment File"
^DIC(9.4,18,22,7,"PAH",4,1,5,0)="(#6914)."
^DIC(9.4,18,22,7,"PAH",4,1,6,0)=" "
^DIC(9.4,18,22,7,"PAH",4,1,7,0)="Code in routine ENLIB3 that infers AO when such is not available from"
^DIC(9.4,18,22,7,"PAH",4,1,8,0)="IFCAP is now deactivated at the request of FMS."
^DIC(9.4,18,22,7,"PAH",5,0)="38^2961210^1"
^DIC(9.4,18,22,7,"PAH",5,1,0)="^^4^4^2961210"
^DIC(9.4,18,22,7,"PAH",5,1,1,0)="This enhancement patch modifies the FD Document (for Turn-In) process to"
^DIC(9.4,18,22,7,"PAH",5,1,2,0)="save the original asset value and capture the fair market value. The new"
^DIC(9.4,18,22,7,"PAH",5,1,3,0)="Original Asset Value field is added to equipment screen 2. A post-init"
^DIC(9.4,18,22,7,"PAH",5,1,4,0)="populates the new Original Asset Value field for existing FD-T documents."
^DIC(9.4,18,22,7,"PAH",6,0)="41 SEQ #34^2970306^1"
^DIC(9.4,18,22,7,"PAH",6,1,0)="^^1^1^2970306"
^DIC(9.4,18,22,7,"PAH",6,1,1,0)="Manufacturer List File (#6912) with selected data (ien > 3000 and <50000)."
^DIC(9.4,18,22,7,"PAH",7,0)="35^2970501^1"
^DIC(9.4,18,22,7,"PAH",7,1,0)="^^20^20^2970501"
^DIC(9.4,18,22,7,"PAH",7,1,1,0)="Patch EN*7*35 contains Equipment Inventory module and Work Order module"
^DIC(9.4,18,22,7,"PAH",7,1,2,0)="enhancements that were originally developed for the next version of the"
^DIC(9.4,18,22,7,"PAH",7,1,3,0)="Engineering package."
^DIC(9.4,18,22,7,"PAH",7,1,4,0)=" "
^DIC(9.4,18,22,7,"PAH",7,1,5,0)=" o Purchase Order Group Equipment Edit"
^DIC(9.4,18,22,7,"PAH",7,1,6,0)=" o Condition Codes for Equipment"
^DIC(9.4,18,22,7,"PAH",7,1,7,0)=" o Equipment Flagging"
^DIC(9.4,18,22,7,"PAH",7,1,8,0)=" o Equipment Lockout/Tagout"
^DIC(9.4,18,22,7,"PAH",7,1,9,0)=" o Station Specific New Equipment Bulletins"
^DIC(9.4,18,22,7,"PAH",7,1,10,0)=" o Improve Inventory Exception List"
^DIC(9.4,18,22,7,"PAH",7,1,11,0)=" o Improve Equipment Category History"
^DIC(9.4,18,22,7,"PAH",7,1,12,0)=" o Work Order Selection by Equipment or Location"
^DIC(9.4,18,22,7,"PAH",7,1,13,0)=" o Multiple Work Order Entry"
^DIC(9.4,18,22,7,"PAH",7,1,14,0)=" o Notify Work Order Requester"
^DIC(9.4,18,22,7,"PAH",7,1,15,0)=" o Improve Capture of Preventive Maintenance Manhours"
^DIC(9.4,18,22,7,"PAH",7,1,16,0)=" o Remove limit on number of PM Work Orders"
^DIC(9.4,18,22,7,"PAH",7,1,17,0)=" o Incoming Inspection Work Order for New Equipment"
^DIC(9.4,18,22,7,"PAH",7,1,18,0)=" o Remove ZZ from Manufacturer List file"
^DIC(9.4,18,22,7,"PAH",7,1,19,0)=" o More flexibility in barcode label format"
^DIC(9.4,18,22,7,"PAH",7,1,20,0)=" o New Parent System/Component Hierarchy report"
^DIC(9.4,18,22,7,"PAH",8,0)="40 SEQ #36^2970625^1"
^DIC(9.4,18,22,7,"PAH",8,1,0)="^^9^9^2970625"
^DIC(9.4,18,22,7,"PAH",8,1,1,0)="This patch enhances and fixes the Engineering Archive module."
^DIC(9.4,18,22,7,"PAH",8,1,2,0)=" 1. Adds EQUIPMENT INV. (#6914) file archive capability."
^DIC(9.4,18,22,7,"PAH",8,1,3,0)=" 2. Save values of LOCATION, PARTS ORDERED ON ACC.#, VENDER SERVICE COST,"
^DIC(9.4,18,22,7,"PAH",8,1,4,0)="    and WORK ACTION fields during work order archives."
^DIC(9.4,18,22,7,"PAH",8,1,5,0)=" 3. Only ask archive device once during archive or recall session."
^DIC(9.4,18,22,7,"PAH",8,1,6,0)=" 4. Only use tape commands when device type is MAGTAPE."
^DIC(9.4,18,22,7,"PAH",8,1,7,0)=" 5. Delete the data dictionary when the archive global is deleted."
^DIC(9.4,18,22,7,"PAH",8,1,8,0)=" 6. Update the WO ARCHIVE data dictionary to match the WORK ORDER file."
^DIC(9.4,18,22,7,"PAH",8,1,9,0)=" 7. Adds Delete Equipment Record option."
^DIC(9.4,18,22,7,"PAH",9,0)="42 SEQ #37^2970708^1"
^DIC(9.4,18,22,7,"PAH",9,1,0)="^^24^24^2970708"
^DIC(9.4,18,22,7,"PAH",9,1,1,0)="o Allows posting of Preventive Maintenance Inspections (PMI) to Equipment"
^DIC(9.4,18,22,7,"PAH",9,1,2,0)="  Repair Histories in the absence of an ASSIGNED TECHNICIAN."
^DIC(9.4,18,22,7,"PAH",9,1,3,0)="o Corrects errors in PMI Worklist generation by LOCAL ID."
^DIC(9.4,18,22,7,"PAH",9,1,4,0)="o Allows free text locations in PM worklists."
^DIC(9.4,18,22,7,"PAH",9,1,5,0)="o Adds TRIGGER to Eng Building File (#6928.3). Entries to the Building NAME"
^DIC(9.4,18,22,7,"PAH",9,1,6,0)="  will automatically update the Building DIVISION."
^DIC(9.4,18,22,7,"PAH",9,1,7,0)="o Corrects an error in looking up equipment records by EQUIPMENT CATEGORY"
^DIC(9.4,18,22,7,"PAH",9,1,8,0)="  (EC.<value>)."
^DIC(9.4,18,22,7,"PAH",9,1,9,0)="o Restores 'Incomplete Work Order' menu options."
^DIC(9.4,18,22,7,"PAH",9,1,10,0)="o Allows '^' escape from parent system hierarchy report."
^DIC(9.4,18,22,7,"PAH",9,1,11,0)="o Allows slave printing of new and transferred work orders, even when"
^DIC(9.4,18,22,7,"PAH",9,1,12,0)="  AUTOPRINT WORK ORDER software option is set."
^DIC(9.4,18,22,7,"PAH",9,1,13,0)="o Includes four revised input templates:"
^DIC(9.4,18,22,7,"PAH",9,1,14,0)="       - ENEQPMP in File #6911"
^DIC(9.4,18,22,7,"PAH",9,1,15,0)="       - ENEQPMP in File #6914"
^DIC(9.4,18,22,7,"PAH",9,1,16,0)="       - ENWOEDIT in File #6920"
^DIC(9.4,18,22,7,"PAH",9,1,17,0)="       - ENWOWARDXFER in File #6920"
^DIC(9.4,18,22,7,"PAH",9,1,18,0)="o Allows printing of punctuation in bar coded location labels."
^DIC(9.4,18,22,7,"PAH",9,1,19,0)="o Resets local variable DIC for each look-up during 'Rapid Closeout of PM"
^DIC(9.4,18,22,7,"PAH",9,1,20,0)="  Worklist' option."
^DIC(9.4,18,22,7,"PAH",9,1,21,0)="o Ignores free text locations when displaying incomplete work orders for a"
^DIC(9.4,18,22,7,"PAH",9,1,22,0)="  range of locations."
^DIC(9.4,18,22,7,"PAH",9,1,23,0)="o Validates ""G"" cross-reference in File #6920 during work order display"
^DIC(9.4,18,22,7,"PAH",9,1,24,0)="  (routine ENWOD2)."
^DIC(9.4,18,22,7,"PAH",10,0)="39 SEQ #38^2970728^1"
^DIC(9.4,18,22,7,"PAH",10,1,0)="^^11^11^2970728"
^DIC(9.4,18,22,7,"PAH",10,1,1,0)="The patch contains FAP-Interface related enhancements such as"
^DIC(9.4,18,22,7,"PAH",10,1,2,0)=" o Adjustment Vouchers & Report"
^DIC(9.4,18,22,7,"PAH",10,1,3,0)=" o Summary of SGL Balances Report"
^DIC(9.4,18,22,7,"PAH",10,1,4,0)=" o Transaction Register Report"
^DIC(9.4,18,22,7,"PAH",10,1,5,0)=" o Voucher Summary Report modified"
^DIC(9.4,18,22,7,"PAH",10,1,6,0)=" o Document History Report modified"
^DIC(9.4,18,22,7,"PAH",10,1,7,0)=" o FAP Document changes (BBFY, validity checks, etc.)"
^DIC(9.4,18,22,7,"PAH",10,1,8,0)=" o Equipment SPEX field"
^DIC(9.4,18,22,7,"PAH",10,1,9,0)=" o Cost Center inferred from CMR (EIL)"
^DIC(9.4,18,22,7,"PAH",10,1,10,0)=" o CMR (EIL) Report modified"
^DIC(9.4,18,22,7,"PAH",10,1,11,0)=" o Nonexpendable Expensed Inventory Report modified"
^DIC(9.4,18,22,7,"PAH",11,0)="44 SEQ #39^2970808^1"
^DIC(9.4,18,22,7,"PAH",11,1,0)="^^1^1^2970808"
^DIC(9.4,18,22,7,"PAH",11,1,1,0)="Correct 'invalid' EIL cost centers that were introduced by patch EN*7*39."
^DIC(9.4,18,22,7,"PAH",12,0)="43 SEQ #40^2971118^1"
^DIC(9.4,18,22,7,"PAH",12,1,0)="^^7^7^2971118"
^DIC(9.4,18,22,7,"PAH",12,1,1,0)=" o Do not update equipment physical inventory dates on the basis of PM"
^DIC(9.4,18,22,7,"PAH",12,1,2,0)="   work orders that were closed out with a PM status of DEFERRED."
^DIC(9.4,18,22,7,"PAH",12,1,3,0)=" o Update work order status whenever a date complete is entered during the"
^DIC(9.4,18,22,7,"PAH",12,1,4,0)="   edit phase of a new work order entry option."
^DIC(9.4,18,22,7,"PAH",12,1,5,0)=" o Test for the existence of local variable ENX in line TOP15+7^ENWOD2"
^DIC(9.4,18,22,7,"PAH",12,1,6,0)="   before referencing it."
^DIC(9.4,18,22,7,"PAH",12,1,7,0)=" o Add a line feed to the positioning logic for work order bar code.  "
^DIC(9.4,18,22,7,"PAH",13,0)="46 SEQ #41^2971127^1"
^DIC(9.4,18,22,7,"PAH",13,1,0)="^^8^8^2971127"
^DIC(9.4,18,22,7,"PAH",13,1,1,0)=" 1. Updates NX FUND, NX SGL, and NX BOC files for Fiscal Year 1998."
^DIC(9.4,18,22,7,"PAH",13,1,2,0)=" 2. Renames Excess standard general ledger from 1561 to 1524."
^DIC(9.4,18,22,7,"PAH",13,1,3,0)=" 3. Modifies Adjustment Voucher reason codes appropriate for FB Document."
^DIC(9.4,18,22,7,"PAH",13,1,4,0)=" 4. Moves equipment from Funds 4138, 6019, or 5014A1 to Fund AMAF."
^DIC(9.4,18,22,7,"PAH",13,1,5,0)=" 5. Moves equipment from Fund 8129G to Fund 8129S."
^DIC(9.4,18,22,7,"PAH",13,1,6,0)=" 6. Moves Trust equipment from SGL 1754 to SGL 1750."
^DIC(9.4,18,22,7,"PAH",13,1,7,0)=" 7. Lists ADPE Trust equipment that should be manually moved from SGL 1750"
^DIC(9.4,18,22,7,"PAH",13,1,8,0)="    to SGL 1751."
^DIC(9.4,18,22,7,"PAH",14,0)="45 SEQ #42^2971204^1"
^DIC(9.4,18,22,7,"PAH",14,1,0)="^^14^14^2971204"
^DIC(9.4,18,22,7,"PAH",14,1,1,0)="o Correct possible <UNDEF> error at NEWNX+8^ENEQNX1 (queueing of NX"
^DIC(9.4,18,22,7,"PAH",14,1,2,0)="  inventory exception lists)"
^DIC(9.4,18,22,7,"PAH",14,1,3,0)="o Use Engineering Computer Port file for customizing bar coded equipment"
^DIC(9.4,18,22,7,"PAH",14,1,4,0)="  and location labels"
^DIC(9.4,18,22,7,"PAH",14,1,5,0)="o Improve the selection algorithm for inclusion of user-specified fields"
^DIC(9.4,18,22,7,"PAH",14,1,6,0)="  on bar coded equipment and location labels and use VA FileMan calls"
^DIC(9.4,18,22,7,"PAH",14,1,7,0)="  instead of global reads"
^DIC(9.4,18,22,7,"PAH",14,1,8,0)="o Correct possible <UNDEF> error at STMPLT+4^ENEQP (direct posting of"
^DIC(9.4,18,22,7,"PAH",14,1,9,0)="  equipment repair histories)"
^DIC(9.4,18,22,7,"PAH",14,1,10,0)="o Accomodate large numbers of equipment records during multiple"
^DIC(9.4,18,22,7,"PAH",14,1,11,0)="  equipment editing (Purchase Order Group Edit) by locking equipment"
^DIC(9.4,18,22,7,"PAH",14,1,12,0)="  records one at a time when the count exceeds 50"
^DIC(9.4,18,22,7,"PAH",14,1,13,0)="o Accomodate a new version of MedTester upload software released by"
^DIC(9.4,18,22,7,"PAH",14,1,14,0)="  DNI Nevada (the manufacturer)"
^DIC(9.4,18,22,7,"PAH",15,0)="28 SEQ #43^2971222^1"
^DIC(9.4,18,22,7,"PAH",15,1,0)="^^10^10^2971222"
^DIC(9.4,18,22,7,"PAH",15,1,1,0)="Patch EN*7*28 PROGRESS REPORT (10-0051) ENHANCEMENT"
^DIC(9.4,18,22,7,"PAH",15,1,2,0)=" 1. Progress Report support for Station Level Projects"
^DIC(9.4,18,22,7,"PAH",15,1,3,0)=" 2. Progress Report content modified"
^DIC(9.4,18,22,7,"PAH",15,1,4,0)=" 3. Progress Report format modified"
^DIC(9.4,18,22,7,"PAH",15,1,5,0)=" 4. Progress Report edit screens modified"
^DIC(9.4,18,22,7,"PAH",15,1,6,0)=" 5. Progress Report data validation added"
^DIC(9.4,18,22,7,"PAH",15,1,7,0)=" 6. Progress Report electronic transmission modified"
^DIC(9.4,18,22,7,"PAH",15,1,8,0)=" 7. Progress Report Actions Due Report added"
^DIC(9.4,18,22,7,"PAH",15,1,9,0)=" 8. 5-Yr Plan Project miscellaneous updates"
^DIC(9.4,18,22,7,"PAH",15,1,10,0)=" 9. Project Application miscellaneous updates"
^DIC(9.4,18,22,7,"PAH",16,0)="47 SEQ #44^2980129^1"
^DIC(9.4,18,22,7,"PAH",16,1,0)="^^22^22^2980129"
^DIC(9.4,18,22,7,"PAH",16,1,1,0)="o Allows entry of Capital Lease assets. These are items of nonexpendable"
^DIC(9.4,18,22,7,"PAH",16,1,2,0)="  equipment purchased with the Supply Fund and owned by the VA facility."
^DIC(9.4,18,22,7,"PAH",16,1,3,0)="  The facility then makes incremental lease payments to the Supply Fund"
^DIC(9.4,18,22,7,"PAH",16,1,4,0)="  until the Supply Fund has been reimbursed in accordance with policy in"
^DIC(9.4,18,22,7,"PAH",16,1,5,0)="  effect at the time the Capital Lease equipment was acquired. Facilities"
^DIC(9.4,18,22,7,"PAH",16,1,6,0)="  should begin to depreciate Capital Lease equipment as soon as it is"
^DIC(9.4,18,22,7,"PAH",16,1,7,0)="  acquired."
^DIC(9.4,18,22,7,"PAH",16,1,8,0)=" "
^DIC(9.4,18,22,7,"PAH",16,1,9,0)="o Removes a redundant call to VA FileMan in the printing code for work"
^DIC(9.4,18,22,7,"PAH",16,1,10,0)="  order comments (re: option ENDSY)."
^DIC(9.4,18,22,7,"PAH",16,1,11,0)=" "
^DIC(9.4,18,22,7,"PAH",16,1,12,0)="o Inserts a pattern test of user entered PM work orders before performing"
^DIC(9.4,18,22,7,"PAH",16,1,13,0)="  a concatenation (re: option ENPMR2)."
^DIC(9.4,18,22,7,"PAH",16,1,14,0)=" "
^DIC(9.4,18,22,7,"PAH",16,1,15,0)="o Prevents a <NULLSUBSCR> error when invalid ranges are entered during the"
^DIC(9.4,18,22,7,"PAH",16,1,16,0)="  assignment of electronic work orders."
^DIC(9.4,18,22,7,"PAH",16,1,17,0)=" "
^DIC(9.4,18,22,7,"PAH",16,1,18,0)="o Corrects inappropriate references to local variable %ZIS(0) and allows"
^DIC(9.4,18,22,7,"PAH",16,1,19,0)="  users to queue incoming inspection work orders on multiple equipment"
^DIC(9.4,18,22,7,"PAH",16,1,20,0)="  receipts more reliably. The user is asked for a queue date and time when"
^DIC(9.4,18,22,7,"PAH",16,1,21,0)="  the first equpment record is entered. All subsequent equipment records"
^DIC(9.4,18,22,7,"PAH",16,1,22,0)="  automatically use that same date and time."
^DIC(9.4,18,22,7,"PAH",17,0)="49 SEQ #45^2980220^1"
^DIC(9.4,18,22,7,"PAH",17,1,0)="^^5^5^2980220"
^DIC(9.4,18,22,7,"PAH",17,1,1,0)=" Project Tracking fixes:"
^DIC(9.4,18,22,7,"PAH",17,1,2,0)=" 1. Provide support for NCS GOE project reports within Station Level"
^DIC(9.4,18,22,7,"PAH",17,1,3,0)="    program validation."
^DIC(9.4,18,22,7,"PAH",17,1,4,0)=" 2. Fix applicable Milestones when Construction Method = Station Labor."
^DIC(9.4,18,22,7,"PAH",17,1,5,0)=" 3. Fix queuing of Actions Due report."
^DIC(9.4,18,22,7,"PAH",18,0)="50 SEQ #46^2980318^1"
^DIC(9.4,18,22,7,"PAH",18,1,0)="^^8^8^2980318"
^DIC(9.4,18,22,7,"PAH",18,1,1,0)="Update software to treat expensed ADPE, motor vehicles, and firearms in"
^DIC(9.4,18,22,7,"PAH",18,1,2,0)="the same manner as other expensed equipment based on the policy change"
^DIC(9.4,18,22,7,"PAH",18,1,3,0)="to VA Handbook 7127/1."
^DIC(9.4,18,22,7,"PAH",18,1,4,0)=" o CMR INVENTORY (EIL) REPORT modified"
^DIC(9.4,18,22,7,"PAH",18,1,5,0)=" o NONEXPENDABLE EXPENSED INVENTORY REPORT modified"
^DIC(9.4,18,22,7,"PAH",18,1,6,0)=" o INVENTORY EXCEPTION LISTING modified"
^DIC(9.4,18,22,7,"PAH",18,1,7,0)=" o ACCOUNTABLE NX FOR STATION REPORT modified"
^DIC(9.4,18,22,7,"PAH",18,1,8,0)=" o FIND & ASSEMBLE option modified for equipment archives."
^DIC(9.4,18,22,7,"PAH",19,0)="48 SEQ #47^2980330^1"
^DIC(9.4,18,22,7,"PAH",19,1,0)="^^1^1^2980330"
^DIC(9.4,18,22,7,"PAH",19,1,1,0)="Corrections for possible Y2K problems."
^DIC(9.4,18,22,7,"PAH",20,0)="52 SEQ #48^2980417^1"
^DIC(9.4,18,22,7,"PAH",20,1,0)="^^5^5^2980417"
^DIC(9.4,18,22,7,"PAH",20,1,1,0)="o Update JCAHO field (#27) in Equipment file (#6914) based on changes to"
^DIC(9.4,18,22,7,"PAH",20,1,2,0)="  corresponding field (#3) in Equipment Category file (#6911) when update"
^DIC(9.4,18,22,7,"PAH",20,1,3,0)="  is requested by user."
^DIC(9.4,18,22,7,"PAH",20,1,4,0)="o Print LAST SERVICED DATE on first equipment edit screen in proper Y2K"
^DIC(9.4,18,22,7,"PAH",20,1,5,0)="  format."
^DIC(9.4,18,22,7,"PAH",21,0)="53 SEQ #49^2980618^1"
^DIC(9.4,18,22,7,"PAH",21,1,0)="^^4^4^2980618"
^DIC(9.4,18,22,7,"PAH",21,1,1,0)="Fix problems with maintenance of incomplete work order (AINC) x-ref."
^DIC(9.4,18,22,7,"PAH",21,1,2,0)="1. Discontinue use of AINC x-ref to store assigned technician data."
^DIC(9.4,18,22,7,"PAH",21,1,3,0)="2. When user transfers a work order, require that new shop be different"
^DIC(9.4,18,22,7,"PAH",21,1,4,0)="   from current shop."
^DIC(9.4,18,22,7,"PAH",22,0)="51 SEQ #50^2980712^1"
^DIC(9.4,18,22,7,"PAH",22,1,0)="^^4^4^2980712"
^DIC(9.4,18,22,7,"PAH",22,1,1,0)="A module that works with the existing Equipment Management and Equipment"
^DIC(9.4,18,22,7,"PAH",22,1,2,0)="Repair modules. It serves as a tool for identifying specific pieces of"
^DIC(9.4,18,22,7,"PAH",22,1,3,0)="equipment that may be subject to YEAR 2000 problems. It also provides a"
^DIC(9.4,18,22,7,"PAH",22,1,4,0)="means of planning and tracking the necessary corrective action."
^DIC(9.4,18,22,7,"PAH",23,0)="56 SEQ #51^2980712^1"
^DIC(9.4,18,22,7,"PAH",23,1,0)="^^4^4^2980712"
^DIC(9.4,18,22,7,"PAH",23,1,1,0)="Patch for a patch. A data entry screen in EN*7*51 contains a reference to"
^DIC(9.4,18,22,7,"PAH",23,1,2,0)="a field that will be introduced with EN*7*55. This causes an <UNDEF> error"
^DIC(9.4,18,22,7,"PAH",23,1,3,0)="during equipment edit sessions. The sole purpose of this emergency patch"
^DIC(9.4,18,22,7,"PAH",23,1,4,0)="is to replace the defective edit screen."
^DIC(9.4,18,22,7,"PAH",24,0)="57 SEQ #52^2981007^1"
^DIC(9.4,18,22,7,"PAH",24,1,0)="^^2^2^2981007"
^DIC(9.4,18,22,7,"PAH",24,1,1,0)=" o Restructure the AMAF fund into six different funds (AMAFxx)."
^DIC(9.4,18,22,7,"PAH",24,1,2,0)=" o Add Administrative/Office code ""02"" for General Counsel."
^DIC(9.4,18,22,7,"PAH",25,0)="55 SEQ #53^2981016^1"
^DIC(9.4,18,22,7,"PAH",25,1,0)="^^2^2^2981016"
^DIC(9.4,18,22,7,"PAH",25,1,1,0)="o Add Utility System field to the Y2K Equipment Management Module."
^DIC(9.4,18,22,7,"PAH",25,1,2,0)="o Install national reporting capability for Y2K equipment management."
^DIC(9.4,18,22,7,"PAH",26,0)="58 SEQ #54^2981016^1"
^DIC(9.4,18,22,7,"PAH",26,1,0)="^^1^1^2981016"
^DIC(9.4,18,22,7,"PAH",26,1,1,0)="o Enables national roll-up of Y2K equipment data (correction to EN*7.0*55)."
^DIC(9.4,18,22,7,"PAH",27,0)="59 SEQ #55^2981229^1"
^DIC(9.4,18,22,7,"PAH",27,1,0)="^^15^15^2981229"
^DIC(9.4,18,22,7,"PAH",27,1,1,0)=" 1. Prevent changes or deletions of work order numbers via the Edit Work"
^DIC(9.4,18,22,7,"PAH",27,1,2,0)="    Order Data option. Introduce a new separate 'Delete Open Work Order'"
^DIC(9.4,18,22,7,"PAH",27,1,3,0)="    option locked by new security key ENWODEL for deletions."
^DIC(9.4,18,22,7,"PAH",27,1,4,0)=" 2. When a WORK ACTION is entered, prompt for another one."
^DIC(9.4,18,22,7,"PAH",27,1,5,0)=" 3. Re-calculate work order TOTAL HOURS and TOTAL LABOR COST when ASSIGNED"
^DIC(9.4,18,22,7,"PAH",27,1,6,0)="    TECH field is edited or deleted."
^DIC(9.4,18,22,7,"PAH",27,1,7,0)=" 4. Perform requested technician substitutions (if any) when Rapid"
^DIC(9.4,18,22,7,"PAH",27,1,8,0)="    Closeout of PM Work Orders option is queued."
^DIC(9.4,18,22,7,"PAH",27,1,9,0)=" 5. Modify Close Out Work Order option to update equipment file and use"
^DIC(9.4,18,22,7,"PAH",27,1,10,0)="    the PM input template when PM work orders closed via this option."
^DIC(9.4,18,22,7,"PAH",27,1,11,0)=" 6. Stop posting disapproved work orders to the equipment history."
^DIC(9.4,18,22,7,"PAH",27,1,12,0)=" 7. Accommodate local cross-references on equipment history multiple."
^DIC(9.4,18,22,7,"PAH",27,1,13,0)=" 8. Include count of equipment records with no FUNCTIONAL CLASSIFICATION "
^DIC(9.4,18,22,7,"PAH",27,1,14,0)="    and a Y2K CATEGORY of 'NOT APPLICABLE' in the electronic Y2K progress"
^DIC(9.4,18,22,7,"PAH",27,1,15,0)="    report sent to VACO."
^DIC(9.4,18,22,7,"PAH",28,0)="60 SEQ #56^2990417^1"
^DIC(9.4,18,22,7,"PAH",28,1,0)="^^13^13^2990417"
^DIC(9.4,18,22,7,"PAH",28,1,1,0)=" o Modify FA and FR Documents to include the entire CMR value instead of"
^DIC(9.4,18,22,7,"PAH",28,1,2,0)="   just the first two characters of the CMR value."
^DIC(9.4,18,22,7,"PAH",28,1,3,0)=" o Modify the Transaction Register and Document History reports to display"
^DIC(9.4,18,22,7,"PAH",28,1,4,0)="   the entire CMR value sent on FA and FR Documents."
^DIC(9.4,18,22,7,"PAH",28,1,5,0)=" o Modify the CMR File Enter/Edit option to generate FR Documents when a"
^DIC(9.4,18,22,7,"PAH",28,1,6,0)="   CMR name is changed instead of when the first two characters of the CMR"
^DIC(9.4,18,22,7,"PAH",28,1,7,0)="   name is changed."
^DIC(9.4,18,22,7,"PAH",28,1,8,0)=" o Prevent CMR entries from being deleted if equipment points to the CMR."
^DIC(9.4,18,22,7,"PAH",28,1,9,0)=" o Force correction of dangling CMR pointers in the equipment file."
^DIC(9.4,18,22,7,"PAH",28,1,10,0)=" o Transmit FR Documents for all existing equipment to populate CMR values"
^DIC(9.4,18,22,7,"PAH",28,1,11,0)="   in Fixed Assets."
^DIC(9.4,18,22,7,"PAH",28,1,12,0)=" o Fix CMR Inventory (EIL) report problem with local template and update"
^DIC(9.4,18,22,7,"PAH",28,1,13,0)="   references on signature page."
^DIC(9.4,18,22,7,"PAH",29,0)="54 SEQ #57^2990803^1"
^DIC(9.4,18,22,7,"PAH",29,1,0)="^^12^12^2990803"
^DIC(9.4,18,22,7,"PAH",29,1,1,0)="o Makes it possible for Open-M sites to connect MedTesters (electrical"
^DIC(9.4,18,22,7,"PAH",29,1,2,0)="  safety analyzers) and portable bar code readers to VistA terminals"
^DIC(9.4,18,22,7,"PAH",29,1,3,0)="  without using a special port definition."
^DIC(9.4,18,22,7,"PAH",29,1,4,0)="o Initializes variable ENFLG between MedTester records to correct a"
^DIC(9.4,18,22,7,"PAH",29,1,5,0)="  problem with the logic used to detect a test failure."
^DIC(9.4,18,22,7,"PAH",29,1,6,0)="o Updates the MedTester upload software so a test failure in the new"
^DIC(9.4,18,22,7,"PAH",29,1,7,0)="  defibrillator test will be detected in a similar manner to a failure"
^DIC(9.4,18,22,7,"PAH",29,1,8,0)="  during the electrical safety (EKG) test."
^DIC(9.4,18,22,7,"PAH",29,1,9,0)="o Updates the MedTester upload software so that a case where the same"
^DIC(9.4,18,22,7,"PAH",29,1,10,0)="  piece of equipment is found twice in the same MedTester upload is"
^DIC(9.4,18,22,7,"PAH",29,1,11,0)="  handled as gracefully as possible."
^DIC(9.4,18,22,7,"PAH",29,1,12,0)="o Prevents Y2K work orders from being used for correcting failed PMIs."
^DIC(9.4,18,22,7,"PAH",30,0)="61 SEQ #58^2990803^1"
^DIC(9.4,18,22,7,"PAH",30,1,0)="^^6^6^2990803"
^DIC(9.4,18,22,7,"PAH",30,1,1,0)="o Corrects routine ENY2K1 so that Equipment Replacement Schedule displays"
^DIC(9.4,18,22,7,"PAH",30,1,2,0)="  properly on the Cumulative Report."
^DIC(9.4,18,22,7,"PAH",30,1,3,0)="o Allows users to include equipment records that lack a MANUFACTURER"
^DIC(9.4,18,22,7,"PAH",30,1,4,0)="  and/or a MODEL on the Detailed Y2K Report."
^DIC(9.4,18,22,7,"PAH",30,1,5,0)="o Insures that all new Y2K work order numbers are checked against the"
^DIC(9.4,18,22,7,"PAH",30,1,6,0)="  ^ENG(6914,""AL"") x-ref to prevent duplication."
^DIC(9.4,18,22,7,"PAH",31,0)="64 SEQ #59^3000125^1"
^DIC(9.4,18,22,7,"PAH",31,1,0)="^^2^2^3000125"
^DIC(9.4,18,22,7,"PAH",31,1,1,0)="Fix Delete Old Incomplete PM Work Orders [ENDELPM] option so a valid"
^DIC(9.4,18,22,7,"PAH",31,1,2,0)="default date is calculated if option is run on February 29th."
^DIC(9.4,18,22,7,"PAH",32,0)="62 SEQ #60^3000125^1"
^DIC(9.4,18,22,7,"PAH",32,1,0)="^^12^12^3000125"
^DIC(9.4,18,22,7,"PAH",32,1,1,0)="Space/Facility module minor enhancements:"
^DIC(9.4,18,22,7,"PAH",32,1,2,0)=" o Remove ZZ prefix from local entries in ENG SPACE FUNCTION file."
^DIC(9.4,18,22,7,"PAH",32,1,3,0)=" o Allow decimal digit in CEILING HT field of ENG SPACE file."
^DIC(9.4,18,22,7,"PAH",32,1,4,0)=" o Use computed field for total quantity of key in EMPLOYEE(KEY) file."
^DIC(9.4,18,22,7,"PAH",32,1,5,0)=" o Increase length of KEY fields in LOCKS file."
^DIC(9.4,18,22,7,"PAH",32,1,6,0)=" o Display OTHER KEY field on Display/Edit Room Data option."
^DIC(9.4,18,22,7,"PAH",32,1,7,0)=" o Delete ISSUED TO multiple from LOCKS file."
^DIC(9.4,18,22,7,"PAH",32,1,8,0)=" o Replace WRITE with DDIOL in DD of EMPLOYEE field in EMPLOYEE(KEY) file."
^DIC(9.4,18,22,7,"PAH",32,1,9,0)=" o Prevent C0MMENTS field in the ENG SPACE file from scrolling other data"
^DIC(9.4,18,22,7,"PAH",32,1,10,0)="   off of a display screen."
^DIC(9.4,18,22,7,"PAH",32,1,11,0)=" o Prevent deletion of ENG SPACE file entries that are pointed to by"
^DIC(9.4,18,22,7,"PAH",32,1,12,0)="   either the EQUIPMENT file (#6914) or the WORK ORDER file (#6920)."
^DIC(9.4,18,22,7,"PAH",33,0)="63 SEQ #61^3000405^1"
^DIC(9.4,18,22,7,"PAH",33,1,0)="^^6^6^3000405"
^DIC(9.4,18,22,7,"PAH",33,1,1,0)="Increase Nonexpendable (NX) Equipment Capitalization Threshold"
^DIC(9.4,18,22,7,"PAH",33,1,2,0)=" o Enhance package to permit different thresholds for capitalization"
^DIC(9.4,18,22,7,"PAH",33,1,3,0)="   and accountability."
^DIC(9.4,18,22,7,"PAH",33,1,4,0)=" o Increase capitalization threshold from $5,000 to $25,000."
^DIC(9.4,18,22,7,"PAH",33,1,5,0)=" o Perform a one-time task to expense equipment that does not meet"
^DIC(9.4,18,22,7,"PAH",33,1,6,0)="   the new capitalization threshold."
^DIC(9.4,18,22,7,"PAH",34,0)="65 SEQ #62^3000816^1"
^DIC(9.4,18,22,7,"PAH",34,1,0)="^^8^8^3000816"
^DIC(9.4,18,22,7,"PAH",34,1,1,0)=" o Modify the work order screen display/edit so the edit session is ended"
^DIC(9.4,18,22,7,"PAH",34,1,2,0)="   when a date complete is entered. Post install updates existing"
^DIC(9.4,18,22,7,"PAH",34,1,3,0)="   equipment histories using work order data to correct inconsistencies"
^DIC(9.4,18,22,7,"PAH",34,1,4,0)="   that may have occurred prior to this patch."
^DIC(9.4,18,22,7,"PAH",34,1,5,0)=" "
^DIC(9.4,18,22,7,"PAH",34,1,6,0)=" o Modify code to strip the time from the date when posting data to"
^DIC(9.4,18,22,7,"PAH",34,1,7,0)="   equipment histories. Post install updates existing equipment histories"
^DIC(9.4,18,22,7,"PAH",34,1,8,0)="   that were posted with a time prior to this patch."
^DIC(9.4,18,22,7,"PAH",35,0)="66 SEQ #63^3010122^1"
^DIC(9.4,18,22,7,"PAH",35,1,0)="^^2^2^3010122"
^DIC(9.4,18,22,7,"PAH",35,1,1,0)="Use ""00"" as the beginning budget fiscal year (BBFY) on FAP documents for"
^DIC(9.4,18,22,7,"PAH",35,1,2,0)="the Franchise Fund (4539)."
^DIC(9.4,18,22,7,"PAH",36,0)="69 SEQ #64^3010228^1"
^DIC(9.4,18,22,7,"PAH",36,1,0)="^^3^3^3010228"
^DIC(9.4,18,22,7,"PAH",36,1,1,0)="o Fix Accountable NX for Station [ENFAR8] report."
^DIC(9.4,18,22,7,"PAH",36,1,2,0)="o Fix DJ screen handler to prevent undefined error when timeout occurs"
^DIC(9.4,18,22,7,"PAH",36,1,3,0)="  during a word processing field edit."
^DIC(9.4,18,22,7,"PAH",37,0)="67 SEQ #65^3010319^1"
^DIC(9.4,18,22,7,"PAH",37,1,0)="^^1^1^3010319"
^DIC(9.4,18,22,7,"PAH",37,1,1,0)="Minor fixes for MedTester uploads and PM work order close out."
^DIC(9.4,18,22,7,"PAH",38,0)="68 SEQ #66^3010430^1"
^DIC(9.4,18,22,7,"PAH",38,1,0)="^^3^3^3010430"
^DIC(9.4,18,22,7,"PAH",38,1,1,0)="This patch includes enhancements requested by the National Database"
^DIC(9.4,18,22,7,"PAH",38,1,2,0)="Integration Team (NDBI) to support future site integrations.  This patch"
^DIC(9.4,18,22,7,"PAH",38,1,3,0)="also improves month/year prompts for several options."
^DIC(9.4,18,22,7,"PAH",39,0)="70 SEQ #67^3020408^1"
^DIC(9.4,18,22,7,"PAH",39,1,0)="^^15^15^3020408"
^DIC(9.4,18,22,7,"PAH",39,1,1,0)="The following Engineering options are now obsolete:"
^DIC(9.4,18,22,7,"PAH",39,1,2,0)="  1. Transmit 5-Yr Plan Projects      [ENPLMFX]"
^DIC(9.4,18,22,7,"PAH",39,1,3,0)="  2. Transmit Project Applications    [ENPLMAX]"
^DIC(9.4,18,22,7,"PAH",39,1,4,0)="  3. Transmit Project Status Reports  [ENPLMRX]"
^DIC(9.4,18,22,7,"PAH",39,1,5,0)=""
^DIC(9.4,18,22,7,"PAH",39,1,6,0)=""
^DIC(9.4,18,22,7,"PAH",39,1,7,0)="The users will now get the following message:"
^DIC(9.4,18,22,7,"PAH",39,1,8,0)="----------------------------------------------"
^DIC(9.4,18,22,7,"PAH",39,1,9,0)=""
^DIC(9.4,18,22,7,"PAH",39,1,10,0)="This option is now Out of Order.  Construction project data is now "
^DIC(9.4,18,22,7,"PAH",39,1,11,0)="entered and reported in a web database at http://vaww.domain.ext/capassets."
^DIC(9.4,18,22,7,"PAH",39,1,12,0)=""
^DIC(9.4,18,22,7,"PAH",39,1,13,0)="Please, contact your Network Capital Assets Coordinator, or VSSC"
^DIC(9.4,18,22,7,"PAH",39,1,14,0)="representative for assistance."
^DIC(9.4,18,22,7,"PAH",39,1,15,0)=""
^DIC(9.4,18,22,7,"PAH",40,0)="71 SEQ #68^3020626^1"
^DIC(9.4,18,22,7,"PAH",40,1,0)="^^1^1^3020626"
^DIC(9.4,18,22,7,"PAH",40,1,1,0)="Increase Equipment Capitalization Threshold to $100,000.00"
^DIC(9.4,18,22,7,"PAH",41,0)="72 SEQ #69^3021025^1"
^DIC(9.4,18,22,7,"PAH",41,1,0)="^^2^2^3021025"
^DIC(9.4,18,22,7,"PAH",41,1,1,0)="Extract AEMS/MERS Work Orders for Asset Management to compare CoreFLS and"
^DIC(9.4,18,22,7,"PAH",41,1,2,0)="Engineering package."
^DIC(9.4,18,22,7,"PAH",42,0)="73 SEQ #70^3030520^1"
^DIC(9.4,18,22,7,"PAH",42,1,0)="^^5^5^3030520"
^DIC(9.4,18,22,7,"PAH",42,1,1,0)="The system language, in some cases, treats the ""E"" in a number string as "
^DIC(9.4,18,22,7,"PAH",42,1,2,0)="an exponential notation.  For instance, ""1E3"" would equate to ""1000"". "
^DIC(9.4,18,22,7,"PAH",42,1,3,0)="Due to this ""E"" exponential notation, like in the NOIS, the value of the "
^DIC(9.4,18,22,7,"PAH",42,1,4,0)="input Purchase Order number becomes too large for the system to handle "
^DIC(9.4,18,22,7,"PAH",42,1,5,0)="and the system issues the error ""illegal number""."
^DIC(9.4,18,22,7,"PAH",43,0)="80 SEQ #71^3030912^1"
^DIC(9.4,18,22,7,"PAH",43,1,0)="^^2^2^3030912"
^DIC(9.4,18,22,7,"PAH",43,1,1,0)="This patch addresses the problem where a network printer is"
^DIC(9.4,18,22,7,"PAH",43,1,2,0)="unable to be used as a companion printer."
^DIC(9.4,18,22,7,"PAH",44,0)="74 SEQ #72^3031002^1"
^DIC(9.4,18,22,7,"PAH",44,1,0)="^^3^3^3031002"
^DIC(9.4,18,22,7,"PAH",44,1,1,0)="This patch will install menu option 16 for CoreFLS Data Cleansing Reports.  It"
^DIC(9.4,18,22,7,"PAH",44,1,2,0)="will then install a sub-menu for 6911 reports.  Please see patch documentation "
^DIC(9.4,18,22,7,"PAH",44,1,3,0)="for description of data cleansing reports for 6911 file."
^DIC(9.4,18,22,7,"PAH",45,0)="75 SEQ #73^3031002^1"
^DIC(9.4,18,22,7,"PAH",45,1,0)="^^1^1^3031002"
^DIC(9.4,18,22,7,"PAH",45,1,1,0)="DATA CLEANSING REPORTS FOR 6914 FILE"
^DIC(9.4,18,22,7,"PAH",46,0)="76 SEQ #74^3031002^1"
^DIC(9.4,18,22,7,"PAH",46,1,0)="^^1^1^3031002"
^DIC(9.4,18,22,7,"PAH",46,1,1,0)="CoreFLS Data Cleansing Reports for the Work Order (#6920) file."
^DIC(9.4,18,22,7,"PAH",47,0)="77 SEQ #75^3031002^1"
^DIC(9.4,18,22,7,"PAH",47,1,0)="^^1^1^3031002"
^DIC(9.4,18,22,7,"PAH",47,1,1,0)="CoreFLS Data Quality Assurance - Engineering Space (#6928) Patch EN*7.0*77"
^DIC(9.4,18,22,7,"PAH",48,0)="78 SEQ #76^3031023^1"
^DIC(9.4,18,22,7,"PAH",48,1,0)="^^1^1^3031023"
^DIC(9.4,18,22,7,"PAH",48,1,1,0)="CoreFLS Data Cleansing Reports for BUILDING FILE (#6928.3)"
^DIC(9.4,18,22,7,"PAH",49,0)="81 SEQ #77^3031023^1"
^DIC(9.4,18,22,7,"PAH",49,1,0)="^^1^1^3031023"
^DIC(9.4,18,22,7,"PAH",49,1,1,0)="CoreFLS Data Cleansing Reports for AEMS/MERS file PM PROCEDURES (#6914.2)"
^DIC(9.4,18,22,7,"PAH",50,0)="79 SEQ #78^3031023^1"
^DIC(9.4,18,22,7,"PAH",50,1,0)="^^1^1^3031023"
^DIC(9.4,18,22,7,"PAH",50,1,1,0)="CoreFLS Data Cleansing Reports for Engineering Employee File (#6929)"
^DIC(9.4,18,22,7,"PAH",51,0)="83 SEQ #79^3041015^1"
^DIC(9.4,18,22,7,"PAH",51,1,0)="^^1^1^3041015"
^DIC(9.4,18,22,7,"PAH",51,1,1,0)="This patch will add the AMAFMF fund code to the NX FUND (#6914.6) file."
^DIC(9.4,18,22,7,"PAH",52,0)="84 SEQ #80^3050118^1"
^DIC(9.4,18,22,7,"PAH",52,1,0)="^^5^5^3050118"
^DIC(9.4,18,22,7,"PAH",52,1,1,0)="The operational test site using CoreFLS was reverted to its pre-CoreFLS "
^DIC(9.4,18,22,7,"PAH",52,1,2,0)="state and the CoreFLS project was suspended.  Consequently halting all "
^DIC(9.4,18,22,7,"PAH",52,1,3,0)="data cleansing efforts and requiring that components of the data "
^DIC(9.4,18,22,7,"PAH",52,1,4,0)="cleansing patches (EN*7.0*74, EN*7.0*75, EN*7.0*76, EN*7.0*77, EN*7.0*78, "
^DIC(9.4,18,22,7,"PAH",52,1,5,0)="EN*7.0*79, and EN*7.0*81) be removed at each site."
^DIC(9.4,18,22,7,"PAH",53,0)="85 SEQ #81^3060213^1"
^DIC(9.4,18,22,7,"PAH",53,1,0)="^^1^1^3060213"
^DIC(9.4,18,22,7,"PAH",53,1,1,0)="This patch contains a template to extract data from file 6914."
^DIC(9.4,18,22,7,"PAH",54,0)="86 SEQ #82^3060807^1"
^DIC(9.4,18,22,7,"PAH",54,1,0)="^^1^1^3060807"
^DIC(9.4,18,22,7,"PAH",54,1,1,0)="This patch adds fund code AMAFIT to the NX FUND (#6914.6) file."
^DIC(9.4,18,22,7,"PAH",55,0)="87 SEQ #83^3080526.191601^1"
^DIC(9.4,18,22,7,"PAH",55,1,0)="^^7^7^3080526"
^DIC(9.4,18,22,7,"PAH",55,1,1,0)="This patch contains the IT Equipment Tracking project enhancements."
^DIC(9.4,18,22,7,"PAH",55,1,2,0)="The Engineering (AEMS/MERS) package is modified to provide IT personnel a"
^DIC(9.4,18,22,7,"PAH",55,1,3,0)="new top level menu.  IT personnel will be able to edit selected data"
^DIC(9.4,18,22,7,"PAH",55,1,4,0)="fields of IT equipment in the non-expendable equipment inventory.  The"
^DIC(9.4,18,22,7,"PAH",55,1,5,0)="project will also add support for the individual assignment of"
^DIC(9.4,18,22,7,"PAH",55,1,6,0)="responsibility for IT assets.  Individuals can sign electronic hand"
^DIC(9.4,18,22,7,"PAH",55,1,7,0)="receipts to accept responsibility."
^DIC(9.4,18,22,7,"PAH",56,0)="89 SEQ #84^3090917.150313^17"
^DIC(9.4,18,22,7,"PAH",56,1,0)="^^8^8^3090917"
^DIC(9.4,18,22,7,"PAH",56,1,1,0)="There is a known bug with some of the outputs where assignments are listed"
^DIC(9.4,18,22,7,"PAH",56,1,2,0)="under a person that does not actually have that assignment. These outputs"
^DIC(9.4,18,22,7,"PAH",56,1,3,0)="are searching the assignments for a specific person or equipment item. The"
^DIC(9.4,18,22,7,"PAH",56,1,4,0)="problem is that the utility being used also includes assignments that"
^DIC(9.4,18,22,7,"PAH",56,1,5,0)="partially match the search criteria. For example, a search for active"
^DIC(9.4,18,22,7,"PAH",56,1,6,0)="assignments for a person with internal entry number 100 will also include"
^DIC(9.4,18,22,7,"PAH",56,1,7,0)="any active assignments for other persons whose internal entry number "
^DIC(9.4,18,22,7,"PAH",56,1,8,0)="starts with 100 such as 1001, 10025 etc."
^DIC(9.4,18,22,7,"PAH",57,0)="90 SEQ #85^3100520.140122^17"
^DIC(9.4,18,22,7,"PAH",57,1,0)="^^3^3^3100520"
^DIC(9.4,18,22,7,"PAH",57,1,1,0)="This patch addresses two issues about non-standard IO symbols for the"
^DIC(9.4,18,22,7,"PAH",57,1,2,0)="bar code printing in the Engineering application running under the Red"
^DIC(9.4,18,22,7,"PAH",57,1,3,0)="Hat Linux operating system."
^DIC(9.4,18,22,7,"PAH",58,0)="30 SEQ #27^2960325^21"
^DIC(9.4,18,22,7,"PAH",59,0)="91 SEQ #86^3130130.161248^17"
^DIC(9.4,18,22,7,"PAH",59,1,0)="^^8^8^3130130"
^DIC(9.4,18,22,7,"PAH",59,1,1,0)="This patch addresses 3 issues:"
^DIC(9.4,18,22,7,"PAH",59,1,2,0)="1. User is receiving an Undefined Error when entering a ""^"" and any "
^DIC(9.4,18,22,7,"PAH",59,1,3,0)="other character at an edit prompt followed by a ""^"" at the next edit"
^DIC(9.4,18,22,7,"PAH",59,1,4,0)="prompt when using ENGINEERING EMPLOYEE FILE option and KEY DISTRIBUTION BY"
^DIC(9.4,18,22,7,"PAH",59,1,5,0)="EMPLOYEE option."
^DIC(9.4,18,22,7,"PAH",59,1,6,0)="2. Text Change to Directive # printed on Hand Receipt."
^DIC(9.4,18,22,7,"PAH",59,1,7,0)="3. EQUIPMENT INVENTORY FILE (#6914) CMR field (#19) trigger is not "
^DIC(9.4,18,22,7,"PAH",59,1,8,0)="working properly."
^DIC(9.4,18,22,7,"PAH",60,0)="92 SEQ #88^3130807.090646^17"
^DIC(9.4,18,22,7,"PAH",60,1,0)="^^3^3^3130807"
^DIC(9.4,18,22,7,"PAH",60,1,1,0)="Patch EN*7.0*92 adds 1 new code to the NON-EXPENDABLE EQUIPMENT BUDGET "
^DIC(9.4,18,22,7,"PAH",60,1,2,0)="OBJECT CODES (NX BOC) (#6914.4) file and and re-names code 1524 to 1995 "
^DIC(9.4,18,22,7,"PAH",60,1,3,0)="in the NON-EXPENDABLE STANDARD GENERAL LEDGER (NX SGL)(#6914.3)."
^DIC(9.4,18,22,7,"PAH",61,0)="93 SEQ #89^3140701.14315^17"
^DIC(9.4,18,22,7,"PAH",61,1,0)="^^4^4^3140701"
^DIC(9.4,18,22,7,"PAH",61,1,1,0)="This patch addresses 1 issue:"
^DIC(9.4,18,22,7,"PAH",61,1,2,0)=" "
^DIC(9.4,18,22,7,"PAH",61,1,3,0)="User is receiving an Undefined Error when deleting an entry using "
^DIC(9.4,18,22,7,"PAH",61,1,4,0)="the Enter/Edit Room Planning Data [ENSP-PLAN1] Menu Option"
^DIC(9.4,18,22,7,"PAH",62,0)="96 SEQ #90^3150203.143108^17"
^DIC(9.4,18,22,7,"PAH",62,1,0)="^^12^12^3150203"
^DIC(9.4,18,22,7,"PAH",62,1,1,0)="This patch addresses three issues:"
^DIC(9.4,18,22,7,"PAH",62,1,2,0)=" "
^DIC(9.4,18,22,7,"PAH",62,1,3,0)="1. The first issue will add 1 new code and deactivate 3 old codes in the"
^DIC(9.4,18,22,7,"PAH",62,1,4,0)="   Non-Expendable Equipment Budget Object Codes (NX BOC) file (#6914.4)."
^DIC(9.4,18,22,7,"PAH",62,1,5,0)=" "
^DIC(9.4,18,22,7,"PAH",62,1,6,0)="2, The second issue involves a subscript error occurring at "
^DIC(9.4,18,22,7,"PAH",62,1,7,0)="   NEWLOC+1^ENEQNX1 when there is no nonexpendable inventory data uploaded"
^DIC(9.4,18,22,7,"PAH",62,1,8,0)="   from the portable bar code reader to the Barcode Program file (#446.4)."
^DIC(9.4,18,22,7,"PAH",62,1,9,0)=" "
^DIC(9.4,18,22,7,"PAH",62,1,10,0)="3. The third issue is about an error - <NOTOPEN>^PRT1^ENWOD in the "
^DIC(9.4,18,22,7,"PAH",62,1,11,0)="   Multiple Work Order Entry [ENWOMULTI] option when the device is forced"
^DIC(9.4,18,22,7,"PAH",62,1,12,0)="   queuing the job in a task."
^DIC(9.4,18,22,7,"PAH",63,0)="100 SEQ #91^3171201.124638^54"
^DIC(9.4,18,22,7,"PAH",63,1,0)="^^14^14^3171201"
^DIC(9.4,18,22,7,"PAH",63,1,1,0)="This build supports the interface between the Real Time Location System "
^DIC(9.4,18,22,7,"PAH",63,1,2,0)="(RTLS) at Intelligent Insites and VistA files #6914 and #6928 in "
^DIC(9.4,18,22,7,"PAH",63,1,3,0)="Engineering."
^DIC(9.4,18,22,7,"PAH",63,1,4,0)=" "
^DIC(9.4,18,22,7,"PAH",63,1,5,0)="After installation of this patch, field #.01 of file #6928 will have"
^DIC(9.4,18,22,7,"PAH",63,1,6,0)="one RTLS trigger to notify the RTLS database of the creation of a new"
^DIC(9.4,18,22,7,"PAH",63,1,7,0)="room. Also, this build places MUMPS cross references (behave like a"
^DIC(9.4,18,22,7,"PAH",63,1,8,0)="trigger) on multiple fields of file #6914, expands the description text"
^DIC(9.4,18,22,7,"PAH",63,1,9,0)="for fields #23 and #24, and adds a description to the cross reference 'AB'"
^DIC(9.4,18,22,7,"PAH",63,1,10,0)="on #.01 sub-field of the multiple field Responsible Shop. This build also"
^DIC(9.4,18,22,7,"PAH",63,1,11,0)="places the flag 'NOREINDEX' in all the fields with an RTLS trigger in"
^DIC(9.4,18,22,7,"PAH",63,1,12,0)="order to stop the flooding of the file #6930 in case one of those fields"
^DIC(9.4,18,22,7,"PAH",63,1,13,0)="is reindexed. See the Forum patch description for the list of fields"
^DIC(9.4,18,22,7,"PAH",63,1,14,0)="affected in files #6914 and #6928."
^DIC(9.4,18,22,7,"PAH",64,0)="101 SEQ #92^3180706.122133^54"
^DIC(9.4,18,22,7,"PAH",64,1,0)="^^5^5^3180706"
^DIC(9.4,18,22,7,"PAH",64,1,1,0)="The patch addresses 1 issue:"
^DIC(9.4,18,22,7,"PAH",64,1,2,0)=" "
^DIC(9.4,18,22,7,"PAH",64,1,3,0)="1.   Users are not able to set an Equipment Return Date greater than 90"
^DIC(9.4,18,22,7,"PAH",64,1,4,0)="     days in the future. Some equipment needs this date to be as far as"
^DIC(9.4,18,22,7,"PAH",64,1,5,0)="     365 days in the future."
^DIC(9.4,18,22,7,"PAH",65,0)="105 SEQ #93^3241030.123551^89"
^DIC(9.4,18,22,7,"PAH",65,1,0)="^^5^5^3241030"
^DIC(9.4,18,22,7,"PAH",65,1,1,0)="This patch addresses the following SNOW ticket:"
^DIC(9.4,18,22,7,"PAH",65,1,2,0)=" "
^DIC(9.4,18,22,7,"PAH",65,1,3,0)="INC29452812 - User needs to be able to import new records to the "
^DIC(9.4,18,22,7,"PAH",65,1,4,0)="              ENGINEERING INV. File (#6914) from a tab-delimited"
^DIC(9.4,18,22,7,"PAH",65,1,5,0)="              spreadsheet."
^DIC(9.4,18,22,7,"PAH",66,0)="106 SEQ #94^3241030.124931^89"
^DIC(9.4,18,22,7,"PAH",67,0)="108 SEQ #95^3250219.133021^89"
^DIC(9.4,18,22,7,"PAH",67,1,0)="^^1^1^3250219"
^DIC(9.4,18,22,7,"PAH",67,1,1,0)="NEW QUAD-ANNUAL & PENT-ANNUAL FREQUENCY NOT DISPLAYING"
^DIC(9.4,18,22,7,"PAH",68,0)="111 SEQ #97^3260210.115723^90"
^DIC(9.4,18,22,7,"PAH",68,1,0)="^^3^3^3260210"
^DIC(9.4,18,22,7,"PAH",68,1,1,0)="Patch EN*7.0*111 addresses an issue with that does not allow staff to "
