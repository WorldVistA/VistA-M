^DIC(9.4,100,22,15,"PAH",54,1,59,0)="   ROUTINE SUMMARY"
^DIC(9.4,100,22,15,"PAH",54,1,60,0)="   ==============="
^DIC(9.4,100,22,15,"PAH",54,1,61,0)="   The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",54,1,62,0)="   <tab>   ;;5.01;MENTAL HEALTH;**[Patch List]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",54,1,63,0)="  "
^DIC(9.4,100,22,15,"PAH",54,1,64,0)="                                 Checksum Values"
^DIC(9.4,100,22,15,"PAH",54,1,65,0)="   Routine Name   Before Patch    After Patch     Patch List"
