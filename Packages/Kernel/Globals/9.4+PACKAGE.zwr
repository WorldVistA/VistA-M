^DIC(9.4,124,22,12,"PAH",41,0)="47^3170123.14263^54"
^DIC(9.4,124,22,12,"PAH",42,0)="46 SEQ #44^3171227.163204^54"
^DIC(9.4,124,22,12,"PAH",42,1,0)="^^7^7^3171227"
^DIC(9.4,124,22,12,"PAH",42,1,1,0)="After the release of VistA patch MC*2.3*25, diffusion calculations were "
^DIC(9.4,124,22,12,"PAH",42,1,2,0)="no longer valid on the Pulmonary Function Test Report, giving an inflated "
^DIC(9.4,124,22,12,"PAH",42,1,3,0)="calculation of the % of predicted. OI&T developed code to fix this and "
^DIC(9.4,124,22,12,"PAH",42,1,4,0)="gave it to some sites. This code was supposed to be released in a patch "
^DIC(9.4,124,22,12,"PAH",42,1,5,0)="to correct the calculation, however the patch was not released since the "
^DIC(9.4,124,22,12,"PAH",42,1,6,0)="Medicine package was subsequently placed in Maintenance.  This is needed "
^DIC(9.4,124,22,12,"PAH",42,1,7,0)="for VistA Std."
