^DIC(9.4,13,22,7,"PAH",30,1,32,0)="  "
^DIC(9.4,13,22,7,"PAH",30,1,33,0)="  <tab>;;21.0;VA FileMan;**[patch list]**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",30,1,34,0)="  "
^DIC(9.4,13,22,7,"PAH",30,1,35,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",30,1,36,0)="  "
^DIC(9.4,13,22,7,"PAH",30,1,37,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",30,1,38,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",30,1,39,0)="  DIM2           4186487         4310650         28,48"
^DIC(9.4,13,22,7,"PAH",30,1,40,0)="  DIS            8071449         8038501         48"
^DIC(9.4,13,22,7,"PAH",30,1,41,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,42,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",30,1,43,0)="=========================="
^DIC(9.4,13,22,7,"PAH",30,1,44,0)="This patch can be installed with VISTA users online.  However, it is"
^DIC(9.4,13,22,7,"PAH",30,1,45,0)="recommended that it be Queued for a time of generally least activity."
^DIC(9.4,13,22,7,"PAH",30,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,47,0)="     1.  AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,13,22,7,"PAH",30,1,48,0)="routines listed in the ROUTINE SUMMARY section are mapped, they should be"
^DIC(9.4,13,22,7,"PAH",30,1,49,0)="removed from the mapped set at this time."
^DIC(9.4,13,22,7,"PAH",30,1,50,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,51,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,13,22,7,"PAH",30,1,52,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",30,1,53,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,54,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",30,1,55,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,7,"PAH",30,1,56,0)="  "
^DIC(9.4,13,22,7,"PAH",30,1,57,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",30,1,58,0)="following options:"
^DIC(9.4,13,22,7,"PAH",30,1,59,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",30,1,60,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",30,1,61,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",30,1,62,0)="            Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",30,1,63,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,64,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",30,1,65,0)="following option:"
^DIC(9.4,13,22,7,"PAH",30,1,66,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",30,1,67,0)="            Select INSTALL NAME: DI*21.0*48"
^DIC(9.4,13,22,7,"PAH",30,1,68,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",30,1,69,0)="  "
^DIC(9.4,13,22,7,"PAH",30,1,70,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",30,1,71,0)="Options, and Protocols?"
^DIC(9.4,13,22,7,"PAH",30,1,72,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,73,0)="     6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,13,22,7,"PAH",30,1,74,0)="other CPUs?'.  Then enter the names of your other Compute and Print"
^DIC(9.4,13,22,7,"PAH",30,1,75,0)="server(s)."
^DIC(9.4,13,22,7,"PAH",30,1,76,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,77,0)="     7.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,7,"PAH",30,1,78,0)="set, if necessary."
^DIC(9.4,13,22,7,"PAH",31,0)="53 SEQ #46^2981016^1"
^DIC(9.4,13,22,7,"PAH",31,1,0)="^^136^136^2981016"
^DIC(9.4,13,22,7,"PAH",31,1,1,0)="This patch fixes a bug and contains information and examples on how to"
^DIC(9.4,13,22,7,"PAH",31,1,2,0)="call an 'M' routine from a print template or the FLDS input variable to"
^DIC(9.4,13,22,7,"PAH",31,1,3,0)="EN1^DIP."
^DIC(9.4,13,22,7,"PAH",31,1,4,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,5,0)="Bug fixed:"
^DIC(9.4,13,22,7,"PAH",31,1,6,0)="---------"
^DIC(9.4,13,22,7,"PAH",31,1,7,0)="If the FLDS input variable to EN1^DIP contains a call to an 'M' routine,"
^DIC(9.4,13,22,7,"PAH",31,1,8,0)="the resulting report may differ depending on whether or not the user's"
^DIC(9.4,13,22,7,"PAH",31,1,9,0)="DUZ(0) contains an at-sign (@)."
^DIC(9.4,13,22,7,"PAH",31,1,10,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,11,0)="In the following example, a user whose DUZ(0)'[""@"" would see the SSN"
^DIC(9.4,13,22,7,"PAH",31,1,12,0)="printed twice, whereas the user whose DUZ(0)[""@"" would see the Patient's"
^DIC(9.4,13,22,7,"PAH",31,1,13,0)="SSN printed once."
^DIC(9.4,13,22,7,"PAH",31,1,14,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,15,0)="    S FLDS="".01;C1;L22;""""PATIENT"""",D SSN^MYPROG;C24;R4;""""SSN"""""""
^DIC(9.4,13,22,7,"PAH",31,1,16,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,17,0)="    Routine called:"
^DIC(9.4,13,22,7,"PAH",31,1,18,0)="      MYPROG   ;SFCIOFO/S0 TEST ROUTINE ; 21 Aug 98  2:06 PM"
^DIC(9.4,13,22,7,"PAH",31,1,19,0)="      SSN      ;"
^DIC(9.4,13,22,7,"PAH",31,1,20,0)="               K VA,VADM S DFN=D0 D ^VADPT"
^DIC(9.4,13,22,7,"PAH",31,1,21,0)="               S X=$P(VA(""PID""),""-"",3)"
^DIC(9.4,13,22,7,"PAH",31,1,22,0)="               W X"
^DIC(9.4,13,22,7,"PAH",31,1,23,0)="               Q"
^DIC(9.4,13,22,7,"PAH",31,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,25,0)="Information:"
^DIC(9.4,13,22,7,"PAH",31,1,26,0)="-----------"
^DIC(9.4,13,22,7,"PAH",31,1,27,0)="If you use the FLDS input variable to EN1^DIP or a print template to call"
^DIC(9.4,13,22,7,"PAH",31,1,28,0)="an 'M' routine to evaluate and print a value, you must WRITE the value you"
^DIC(9.4,13,22,7,"PAH",31,1,29,0)="want printed. Examples 1 and 2 below illustrate how this is done."
^DIC(9.4,13,22,7,"PAH",31,1,30,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,31,0)="Example #1: The routine is called from a Print Template"
^DIC(9.4,13,22,7,"PAH",31,1,32,0)="======================================================="
^DIC(9.4,13,22,7,"PAH",31,1,33,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,34,0)="Print Template:"
^DIC(9.4,13,22,7,"PAH",31,1,35,0)="NAME: ZZ640A                            DATE CREATED: AUG 13, 1998@10:21"
^DIC(9.4,13,22,7,"PAH",31,1,36,0)="  READ ACCESS: @                        FILE: MY PATIENT"
^DIC(9.4,13,22,7,"PAH",31,1,37,0)="  USER #: 133                           WRITE ACCESS: @"
^DIC(9.4,13,22,7,"PAH",31,1,38,0)="  DATE LAST USED: AUG 14, 1998"
^DIC(9.4,13,22,7,"PAH",31,1,39,0)="HEADER (c): MY PATIENT LIST"
^DIC(9.4,13,22,7,"PAH",31,1,40,0)="FIRST PRINT FIELD: NAME;C1;L22;""PATIENT""//"
^DIC(9.4,13,22,7,"PAH",31,1,41,0)="THEN PRINT FIELD: D SSN^MYPROG;X"
^DIC(9.4,13,22,7,"PAH",31,1,42,0)="THEN PRINT FIELD: W X;C24;R4;""SSN""//"
^DIC(9.4,13,22,7,"PAH",31,1,43,0)="COMPILED (c): NO"
^DIC(9.4,13,22,7,"PAH",31,1,44,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,45,0)="Routine Called:"
^DIC(9.4,13,22,7,"PAH",31,1,46,0)="MYPROG   ;SFCIOFO/S0 TEST ROUTINE ; 21 Aug 98  2:06 PM"
^DIC(9.4,13,22,7,"PAH",31,1,47,0)="SSN      ;"
^DIC(9.4,13,22,7,"PAH",31,1,48,0)="         K VA,VADM S DFN=D0 D ^VADPT"
^DIC(9.4,13,22,7,"PAH",31,1,49,0)="         S X=$P(VA(""PID""),""-"",3)"
^DIC(9.4,13,22,7,"PAH",31,1,50,0)="         Q"
^DIC(9.4,13,22,7,"PAH",31,1,51,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,52,0)="Example of Usage:"
^DIC(9.4,13,22,7,"PAH",31,1,53,0)="ZZ640A   ;SFCIOFO/S0 TEST FILEMAN PRINT ; 19 Aug 98  4:03 PM"
^DIC(9.4,13,22,7,"PAH",31,1,54,0)="         S DIC=""^DIZ(640001,"",BY="".01"",L=0,FR="""""
^DIC(9.4,13,22,7,"PAH",31,1,55,0)="         S FLDS=""[ZZ640A]"""
^DIC(9.4,13,22,7,"PAH",31,1,56,0)="         D EN1^DIP"
^DIC(9.4,13,22,7,"PAH",31,1,57,0)="         Q"
^DIC(9.4,13,22,7,"PAH",31,1,58,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,59,0)="Example #2: The routine is called from the FLDS input variable"
^DIC(9.4,13,22,7,"PAH",31,1,60,0)="=============================================================="
^DIC(9.4,13,22,7,"PAH",31,1,61,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,62,0)="Routine Called:"
^DIC(9.4,13,22,7,"PAH",31,1,63,0)="MYPROG   ;SFCIOFO/S0 TEST ROUTINE ; 21 Aug 98  2:06 PM"
^DIC(9.4,13,22,7,"PAH",31,1,64,0)="SSN      ;"
^DIC(9.4,13,22,7,"PAH",31,1,65,0)="         K VA,VADM S DFN=D0 D ^VADPT"
^DIC(9.4,13,22,7,"PAH",31,1,66,0)="         S X=$P(VA(""PID""),""-"",3)"
^DIC(9.4,13,22,7,"PAH",31,1,67,0)="         Q"
^DIC(9.4,13,22,7,"PAH",31,1,68,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,69,0)="Example of Usage:"
^DIC(9.4,13,22,7,"PAH",31,1,70,0)="ZZ640A   ;SFCIOFO/S0 TEST FILEMAN PRINT ; 19 Aug 98  4:03 PM"
^DIC(9.4,13,22,7,"PAH",31,1,71,0)="         S DIC=""^DIZ(640001,"",BY="".01"",L=0,FR="""""
^DIC(9.4,13,22,7,"PAH",31,1,72,0)="         S FLDS="".01;C1;L22;""""PATIENT"""",D SSN^MYPROG;X,W X;C24;""""SSN"""""""
^DIC(9.4,13,22,7,"PAH",31,1,73,0)="         D EN1^DIP"
^DIC(9.4,13,22,7,"PAH",31,1,74,0)="         Q"
^DIC(9.4,13,22,7,"PAH",31,1,75,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,76,0)="NOIS: "
^DIC(9.4,13,22,7,"PAH",31,1,77,0)="====="
^DIC(9.4,13,22,7,"PAH",31,1,78,0)="ISB-0898-30889"
^DIC(9.4,13,22,7,"PAH",31,1,79,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,80,0)="Thanks to Test Sites: "
^DIC(9.4,13,22,7,"PAH",31,1,81,0)="====================="
