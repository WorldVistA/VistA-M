^DIC(9.4,53,"DIE",30,0)="RCMS SITE DEPOSIT^342.1"
^DIC(9.4,53,"DIE",31,0)="RCFM CAF FILE ENTRIES^430"
^DIC(9.4,53,"DIE",32,0)="RCNR BAD DEBT EDIT^348.1"
^DIC(9.4,53,"DIPT",0)="^9.46^14^13"
^DIC(9.4,53,"DIPT",1,0)="RCAM COMMENT^341"
^DIC(9.4,53,"DIPT",2,0)="RCDP DEPOSIT LINE^344"
^DIC(9.4,53,"DIPT",3,0)="RCDP DEPOSIT LIST BRIEF^344.1"
^DIC(9.4,53,"DIPT",4,0)="RCDP DEPOSIT LIST EXPAND^344.1"
^DIC(9.4,53,"DIPT",5,0)="RCDP DEPOSIT PROFILE^344.1"
^DIC(9.4,53,"DIPT",6,0)="RCDP RECEIPT LIST HEADER^344"
^DIC(9.4,53,"DIPT",8,0)="RCY BATCH STATUS^344"
^DIC(9.4,53,"DIPT",9,0)="RCY RECEIPT^344"
^DIC(9.4,53,"DIPT",10,0)="RCY RECEIPT LIST^344"
^DIC(9.4,53,"DIPT",11,0)="RCDP 215 FORM^344.1"
^DIC(9.4,53,"DIPT",12,0)="RCDP DEPOSIT LINE 2^344"
^DIC(9.4,53,"DIPT",13,0)="RCDP RECEIPT LIST HEADER 2^344"
^DIC(9.4,53,"DIPT",14,0)="RCMS INT/ADM/PEN^342"
