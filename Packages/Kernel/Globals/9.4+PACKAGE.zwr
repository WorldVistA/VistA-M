^DIC(9.4,175,22,2,"PAH",25,1,7,0)="The following message is displayed to clients "
^DIC(9.4,175,22,2,"PAH",25,1,8,0)="!***************************************************************!"
^DIC(9.4,175,22,2,"PAH",25,1,9,0)="  "
^DIC(9.4,175,22,2,"PAH",25,1,10,0)="  PATIENT SAFETY NOTIFICATION"
^DIC(9.4,175,22,2,"PAH",25,1,11,0)=" "
^DIC(9.4,175,22,2,"PAH",25,1,12,0)="      Under certain circumstances, the EKG window will not"
^DIC(9.4,175,22,2,"PAH",25,1,13,0)="refresh properly when you select a new patient in CPRS; "
^DIC(9.4,175,22,2,"PAH",25,1,14,0)="instead of showing the new patient, the EKG window will"
^DIC(9.4,175,22,2,"PAH",25,1,15,0)="continue to show the previous patient. "
^DIC(9.4,175,22,2,"PAH",25,1,16,0)="  "
^DIC(9.4,175,22,2,"PAH",25,1,17,0)="To prevent this problem:"
^DIC(9.4,175,22,2,"PAH",25,1,18,0)="  "
^DIC(9.4,175,22,2,"PAH",25,1,19,0)="     Verify that the 'Show MUSE EKGs' option under"
^DIC(9.4,175,22,2,"PAH",25,1,20,0)="     Options > View Preferences is checked;"
^DIC(9.4,175,22,2,"PAH",25,1,21,0)="     OR"
^DIC(9.4,175,22,2,"PAH",25,1,22,0)="     Do not minimize the Imaging Display window while viewing EKGs."
^DIC(9.4,175,22,2,"PAH",25,1,23,0)="   "
^DIC(9.4,175,22,2,"PAH",25,1,24,0)="This problem will be corrected shortly by Imaging Patch 63."
^DIC(9.4,175,22,2,"PAH",25,1,25,0)="!***************************************************************!"
^DIC(9.4,175,22,2,"PAH",26,0)="31^3050817^1"
