^DIC(9.4,14,22,5.9,"PAH",128,0)="298 SEQ #226^3030204^1"
^DIC(9.4,14,22,5.9,"PAH",128,1,0)="^^87^87^3030204"
^DIC(9.4,14,22,5.9,"PAH",128,1,1,0)="This patch to the Laboratory package does not contain any changes to the "
^DIC(9.4,14,22,5.9,"PAH",128,1,2,0)="VISTA BLOOD BANK Software as defined by the VHA DIRECTIVE 99-053 titled "
^DIC(9.4,14,22,5.9,"PAH",128,1,3,0)="VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",128,1,4,0)=""
^DIC(9.4,14,22,5.9,"PAH",128,1,5,0)="This patch updates the Health Department Report to print the new Ethnicity "
^DIC(9.4,14,22,5.9,"PAH",128,1,6,0)="and Race field.  The routine LRMIHDR is modified to display or print the "
^DIC(9.4,14,22,5.9,"PAH",128,1,7,0)="new ethnicity and race fields with the release of the scheduling patch, "
^DIC(9.4,14,22,5.9,"PAH",128,1,8,0)="SD*5.3*254, and registration patch, DG*5.3*415"
^DIC(9.4,14,22,5.9,"PAH",128,1,9,0)=""
^DIC(9.4,14,22,5.9,"PAH",128,1,10,0)="Testing Sites:"
^DIC(9.4,14,22,5.9,"PAH",128,1,11,0)="=============="
^DIC(9.4,14,22,5.9,"PAH",128,1,12,0)=" Long Beach VAMC"
^DIC(9.4,14,22,5.9,"PAH",128,1,13,0)=""
^DIC(9.4,14,22,5.9,"PAH",128,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,15,0)=" ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",128,1,16,0)=" ==============="
^DIC(9.4,14,22,5.9,"PAH",128,1,17,0)=""
^DIC(9.4,14,22,5.9,"PAH",128,1,18,0)="   The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",128,1,19,0)="   of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",128,1,20,0)="   <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",128,1,21,0)="  "
^DIC(9.4,14,22,5.9,"PAH",128,1,22,0)="                     Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",128,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,25,0)="    Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",128,1,26,0)="    ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",128,1,27,0)="    LR298            N/A              2559378      298 (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",128,1,28,0)="    LRMIHDR          7468554         10376465      45,272,298"
^DIC(9.4,14,22,5.9,"PAH",128,1,29,0)=""
^DIC(9.4,14,22,5.9,"PAH",128,1,30,0)=" ASSOCIATED NOIS:"
^DIC(9.4,14,22,5.9,"PAH",128,1,31,0)=" ================"
^DIC(9.4,14,22,5.9,"PAH",128,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,33,0)=" NONE"
^DIC(9.4,14,22,5.9,"PAH",128,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,35,0)="**********************************************************************"
^DIC(9.4,14,22,5.9,"PAH",128,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,37,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",128,1,38,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",128,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,40,0)="  The install time for this patch is less than 2 minutes. This patch"
^DIC(9.4,14,22,5.9,"PAH",128,1,41,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",128,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,43,0)="NOTE: Kernel patches must be current on the target system"
^DIC(9.4,14,22,5.9,"PAH",128,1,44,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",128,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,46,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",128,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,48,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",128,1,49,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",128,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,51,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",128,1,52,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",128,1,53,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,54,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",128,1,55,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",128,1,56,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,57,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",128,1,58,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",128,1,59,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,60,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",128,1,61,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",128,1,62,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",128,1,63,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",128,1,64,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",128,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,66,0)="      If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,14,22,5.9,"PAH",128,1,67,0)="      patch prior to installation, you should use the 'Backup a Transport"
^DIC(9.4,14,22,5.9,"PAH",128,1,68,0)="      Global' option at this time.  You may also compare the routines in"
^DIC(9.4,14,22,5.9,"PAH",128,1,69,0)="      your production account to the routines in the patch by using the"
^DIC(9.4,14,22,5.9,"PAH",128,1,70,0)="      'Compare a Transport Global to Current System' option."
^DIC(9.4,14,22,5.9,"PAH",128,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,72,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,73,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",128,1,74,0)="      and select the package 'LR*5.2*298'."
^DIC(9.4,14,22,5.9,"PAH",128,1,75,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,76,0)="      If prompted ' Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",128,1,77,0)="      Install? YES//' choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",128,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,79,0)="      If prompted ' Want KIDS to INHIBIT LOGONs during the install? YES// '"
^DIC(9.4,14,22,5.9,"PAH",128,1,80,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",128,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,82,0)="      If prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",128,1,83,0)="      Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",128,1,84,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,85,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",128,1,86,0)=" "
^DIC(9.4,14,22,5.9,"PAH",128,1,87,0)=" 10. Routine LR298 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",129,0)="293 SEQ #227^3030329^1"
^DIC(9.4,14,22,5.9,"PAH",129,1,0)="^^116^116^3030329"
^DIC(9.4,14,22,5.9,"PAH",129,1,1,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*293 does not "
^DIC(9.4,14,22,5.9,"PAH",129,1,2,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",129,1,3,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",129,1,4,0)="  "
^DIC(9.4,14,22,5.9,"PAH",129,1,5,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*293 does not "
^DIC(9.4,14,22,5.9,"PAH",129,1,6,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",129,1,7,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",129,1,8,0)="  "
^DIC(9.4,14,22,5.9,"PAH",129,1,9,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*293 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",129,1,10,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",129,1,11,0)="  "
^DIC(9.4,14,22,5.9,"PAH",129,1,12,0)="  "
^DIC(9.4,14,22,5.9,"PAH",129,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",129,1,14,0)=" Some problems with the Check Files for Inconsistencies [LRCHKFILES] "
^DIC(9.4,14,22,5.9,"PAH",129,1,15,0)="option were reported after the release of patch LR*5.2*272.  This patch "
^DIC(9.4,14,22,5.9,"PAH",129,1,16,0)="LR*5.2*293 will return the routines associated with this option to their "
^DIC(9.4,14,22,5.9,"PAH",129,1,17,0)="original state with one exception.  The call to the Blood Bank Inventory "
^DIC(9.4,14,22,5.9,"PAH",129,1,18,0)="Integrity Report [LRCKF^LRBLJI] has been removed from routine LRCKF."
^DIC(9.4,14,22,5.9,"PAH",129,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",129,1,20,0)=" The call to the Blood bank inventory integrity report [LRBLII] option is "
^DIC(9.4,14,22,5.9,"PAH",129,1,21,0)="being removed from the Check Files for Inconsistencies [LRCHKFILES] "
^DIC(9.4,14,22,5.9,"PAH",129,1,22,0)="option.  This is being done to further encapsulate the existing VistA "
^DIC(9.4,14,22,5.9,"PAH",129,1,23,0)="Blood Bank system."
^DIC(9.4,14,22,5.9,"PAH",129,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",129,1,25,0)="NOTE: The Check Files for Inconsistencies [LRCHKFILES] option will no "
^DIC(9.4,14,22,5.9,"PAH",129,1,26,0)="longer run an integrity check on the Blood Bank files.  You must manually "
^DIC(9.4,14,22,5.9,"PAH",129,1,27,0)="run the Blood bank inventory integrity report [LRBLII] option once this "
^DIC(9.4,14,22,5.9,"PAH",129,1,28,0)="patch LR*5.2*293 has been installed."
^DIC(9.4,14,22,5.9,"PAH",129,1,29,0)=" "
^DIC(9.4,14,22,5.9,"PAH",129,1,30,0)=" Reference NOIS:   ASH-0802-32526"
