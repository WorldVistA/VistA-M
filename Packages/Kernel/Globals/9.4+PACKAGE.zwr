^DIC(9.4,3,22,21,"PAH",80,1,67,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",80,1,68,0)="         "
^DIC(9.4,3,22,21,"PAH",80,1,69,0)=" 4.   Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",80,1,70,0)="      users are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",80,1,71,0)="      acceptable, then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",80,1,72,0)="      Also place TASKMAN in a wait state, and stop submanagers."
^DIC(9.4,3,22,21,"PAH",80,1,73,0)="      "
^DIC(9.4,3,22,21,"PAH",80,1,74,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",80,1,75,0)="      option:"
^DIC(9.4,3,22,21,"PAH",80,1,76,0)="         Install Package(s)  'XU*8.0*94'"
^DIC(9.4,3,22,21,"PAH",80,1,77,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",80,1,78,0)="                              "
^DIC(9.4,3,22,21,"PAH",80,1,79,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",80,1,80,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",80,1,81,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",80,1,82,0)="      "
^DIC(9.4,3,22,21,"PAH",80,1,83,0)="  6.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",80,1,84,0)="      DSM sites rename ZUVXD to ZU."
^DIC(9.4,3,22,21,"PAH",80,1,85,0)="      OpenM sites rename ZUONT to ZU."
^DIC(9.4,3,22,21,"PAH",80,1,86,0)="      MSM sites rename ZUMSM to ZU."
^DIC(9.4,3,22,21,"PAH",80,1,87,0)="      "
^DIC(9.4,3,22,21,"PAH",80,1,88,0)="  7.  OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",80,1,89,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",80,1,90,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",80,1,91,0)="      "
^DIC(9.4,3,22,21,"PAH",80,1,92,0)="      ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",80,1,93,0)="      ZTMS"
^DIC(9.4,3,22,21,"PAH",80,1,94,0)="      ZTMS3"
^DIC(9.4,3,22,21,"PAH",80,1,95,0)="      ZOSVMSM"
^DIC(9.4,3,22,21,"PAH",80,1,96,0)="      ZOSVONT"
^DIC(9.4,3,22,21,"PAH",80,1,97,0)="      ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",80,1,98,0)="      ZOSVKRM"
^DIC(9.4,3,22,21,"PAH",80,1,99,0)="      ZOSVKRO"
^DIC(9.4,3,22,21,"PAH",80,1,100,0)="      ZOSVKRV"
^DIC(9.4,3,22,21,"PAH",80,1,101,0)="      ZOSVKSME"
^DIC(9.4,3,22,21,"PAH",80,1,102,0)="      ZOSVKSMS"
^DIC(9.4,3,22,21,"PAH",80,1,103,0)="      ZOSVKSOE"
^DIC(9.4,3,22,21,"PAH",80,1,104,0)="      ZOSVKSOS"
^DIC(9.4,3,22,21,"PAH",80,1,105,0)="      ZOSVKSVE"
^DIC(9.4,3,22,21,"PAH",80,1,106,0)="      ZOSVKSVS"
^DIC(9.4,3,22,21,"PAH",80,1,107,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,108,0)="  8.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",80,1,109,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",80,1,110,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",80,1,111,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",80,1,112,0)="      Patch number to load: 94"
^DIC(9.4,3,22,21,"PAH",80,1,113,0)="                            =="
^DIC(9.4,3,22,21,"PAH",80,1,114,0)="       "
^DIC(9.4,3,22,21,"PAH",80,1,115,0)="  9.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",80,1,116,0)=" 10.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",80,1,117,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",80,1,118,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,119,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,120,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",80,1,121,0)=""
^DIC(9.4,3,22,21,"PAH",81,0)="99 SEQ #86^2981104^1"
^DIC(9.4,3,22,21,"PAH",82,0)="82 SEQ #87^2981112^1"
^DIC(9.4,3,22,21,"PAH",82,1,0)="^^68^68^2981112"
^DIC(9.4,3,22,21,"PAH",82,1,1,0)="ISL-0598-50691   XUSRB  When a GUI-Broker process exited the M system"
^DIC(9.4,3,22,21,"PAH",82,1,2,0)="                        it failed to clean-up the temp globals"
^DIC(9.4,3,22,21,"PAH",82,1,3,0)="                        as roll and scroll M processes do."
^DIC(9.4,3,22,21,"PAH",82,1,4,0)="                        "
^DIC(9.4,3,22,21,"PAH",82,1,5,0)="                        It was discovered that not all local Broker "
^DIC(9.4,3,22,21,"PAH",82,1,6,0)="                        development was making the call to establish "
^DIC(9.4,3,22,21,"PAH",82,1,7,0)="                        an application context.  They were just adding"
^DIC(9.4,3,22,21,"PAH",82,1,8,0)="                        the local RPC to the SIGN-ON context.  This "
^DIC(9.4,3,22,21,"PAH",82,1,9,0)="                        loophole has been fixed by having sign-on remove"
^DIC(9.4,3,22,21,"PAH",82,1,10,0)="                        its context when completing the sign-on."
^DIC(9.4,3,22,21,"PAH",82,1,11,0)="                        "
^DIC(9.4,3,22,21,"PAH",82,1,12,0)="                 XQCS   These two routines improve the interface between "
^DIC(9.4,3,22,21,"PAH",82,1,13,0)="                 XQSET  the Remote Proceedure Call (RPC) Broker and the "
^DIC(9.4,3,22,21,"PAH",82,1,14,0)="                        traditional Menu System.  With this patch installed "
^DIC(9.4,3,22,21,"PAH",82,1,15,0)="                        sites will be able to mark Broker-type options "
^DIC(9.4,3,22,21,"PAH",82,1,16,0)="                        out-of-order, lock them with keys and reverse keys, "
^DIC(9.4,3,22,21,"PAH",82,1,17,0)="                        and restrict the days and times during which they "
^DIC(9.4,3,22,21,"PAH",82,1,18,0)="                        are allowed to run."
^DIC(9.4,3,22,21,"PAH",82,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",82,1,20,0)="                        "
^DIC(9.4,3,22,21,"PAH",82,1,21,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",82,1,22,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",82,1,23,0)="XQCS          9069982  12754137    **15,28,82**"
^DIC(9.4,3,22,21,"PAH",82,1,24,0)="XQSET        11570399  11252847    **28,82**"
^DIC(9.4,3,22,21,"PAH",82,1,25,0)="XUSRB         5125201   5576613    **11,16,28,32,59,70,82**"
^DIC(9.4,3,22,21,"PAH",82,1,26,0)="XUSRB1        9903269  10103967    **28,82**"
^DIC(9.4,3,22,21,"PAH",82,1,27,0)=""
^DIC(9.4,3,22,21,"PAH",82,1,28,0)="List of preceding patches: 11, 15, 16, 28, 32, 59, 70"
^DIC(9.4,3,22,21,"PAH",82,1,29,0)="Checksum's calculated by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",82,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",82,1,31,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",82,1,32,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",82,1,33,0)=""
^DIC(9.4,3,22,21,"PAH",82,1,34,0)="  1.  DSM sites - Some of these routines may be mapped,"
^DIC(9.4,3,22,21,"PAH",82,1,35,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",82,1,36,0)="     "
^DIC(9.4,3,22,21,"PAH",82,1,37,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",82,1,38,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",82,1,39,0)="     "
^DIC(9.4,3,22,21,"PAH",82,1,40,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",82,1,41,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",82,1,42,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",82,1,43,0)="      options:"
^DIC(9.4,3,22,21,"PAH",82,1,44,0)="      "
^DIC(9.4,3,22,21,"PAH",82,1,45,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",82,1,46,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",82,1,47,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",82,1,48,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",82,1,49,0)="     "
^DIC(9.4,3,22,21,"PAH",82,1,50,0)="  4.  Stop the Broker server. (If you install when few users are on the "
^DIC(9.4,3,22,21,"PAH",82,1,51,0)="      system and the possibility of some CLOBER errors is acceptable, "
^DIC(9.4,3,22,21,"PAH",82,1,52,0)="      then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",82,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",82,1,54,0)="     "
^DIC(9.4,3,22,21,"PAH",82,1,55,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",82,1,56,0)="      option:"
^DIC(9.4,3,22,21,"PAH",82,1,57,0)="        Install Package(s)  'XU*8.0*82'"
^DIC(9.4,3,22,21,"PAH",82,1,58,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",82,1,59,0)="                             "
^DIC(9.4,3,22,21,"PAH",82,1,60,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",82,1,61,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",82,1,62,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",82,1,63,0)="     "
^DIC(9.4,3,22,21,"PAH",82,1,64,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",82,1,65,0)="      Restart the Broker server."
^DIC(9.4,3,22,21,"PAH",82,1,66,0)=""
^DIC(9.4,3,22,21,"PAH",82,1,67,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",82,1,68,0)=""
^DIC(9.4,3,22,21,"PAH",83,0)="102 SEQ #88^2981125^1"
^DIC(9.4,3,22,21,"PAH",83,1,0)="^^1^1^2981125"
^DIC(9.4,3,22,21,"PAH",83,1,1,0)="     Please see the Patch Module on FORUM for a detailed description."
^DIC(9.4,3,22,21,"PAH",84,0)="105 SEQ #89^2981125^1"
^DIC(9.4,3,22,21,"PAH",84,1,0)="^^3^3^2981125"
^DIC(9.4,3,22,21,"PAH",84,1,1,0)="This patch is dsigned to allow a site to cleanup all dangling pointer"
^DIC(9.4,3,22,21,"PAH",84,1,2,0)="associated with their county codes in their Patient, person, Fee basis"
^DIC(9.4,3,22,21,"PAH",84,1,3,0)="Vendor and HBHC Patient files."
^DIC(9.4,3,22,21,"PAH",85,0)="96 SEQ #90^2981214^1"
^DIC(9.4,3,22,21,"PAH",85,1,0)="^^48^48^2981214"
^DIC(9.4,3,22,21,"PAH",85,1,1,0)="PCE              PCE has it's own Location file (#9999999.06) which"
^DIC(9.4,3,22,21,"PAH",85,1,2,0)="                 points to the institution file.  This file needs to"
^DIC(9.4,3,22,21,"PAH",85,1,3,0)="                 be updated whenever a entry is added to or deleted from "
^DIC(9.4,3,22,21,"PAH",85,1,4,0)="                 the institution file.  The PCE file will be updated "
^DIC(9.4,3,22,21,"PAH",85,1,5,0)="                 to include all current entries in file 4."
^DIC(9.4,3,22,21,"PAH",85,1,6,0)="                 See DBIA 1039"
^DIC(9.4,3,22,21,"PAH",85,1,7,0)="                 "
^DIC(9.4,3,22,21,"PAH",85,1,8,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",85,1,9,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",85,1,10,0)="XUINPCH       4506459   5067911    **20,36,49,63,65,69,96**"
^DIC(9.4,3,22,21,"PAH",85,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",85,1,12,0)="THIS ROUTINE ONLY CARRIES POST-INIT CODE"
^DIC(9.4,3,22,21,"PAH",85,1,13,0)="Checksum's calculated by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",85,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",85,1,15,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",85,1,16,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",85,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",85,1,18,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",85,1,19,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",85,1,20,0)="     "
^DIC(9.4,3,22,21,"PAH",85,1,21,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",85,1,22,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",85,1,23,0)="     "
^DIC(9.4,3,22,21,"PAH",85,1,24,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",85,1,25,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",85,1,26,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",85,1,27,0)="      options:"
^DIC(9.4,3,22,21,"PAH",85,1,28,0)="      "
^DIC(9.4,3,22,21,"PAH",85,1,29,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",85,1,30,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",85,1,31,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",85,1,32,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",85,1,33,0)="     "
^DIC(9.4,3,22,21,"PAH",85,1,34,0)="  4.  This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",85,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",85,1,36,0)="     "
^DIC(9.4,3,22,21,"PAH",85,1,37,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",85,1,38,0)="      option:"
^DIC(9.4,3,22,21,"PAH",85,1,39,0)=""
^DIC(9.4,3,22,21,"PAH",85,1,40,0)="        Install Package(s)  'XU*8.0*96'"
^DIC(9.4,3,22,21,"PAH",85,1,41,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",85,1,42,0)="                             "
^DIC(9.4,3,22,21,"PAH",85,1,43,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",85,1,44,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",85,1,45,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",85,1,46,0)="    "
^DIC(9.4,3,22,21,"PAH",85,1,47,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",85,1,48,0)=""
^DIC(9.4,3,22,21,"PAH",86,0)="103 SEQ #91^2981214^1"
^DIC(9.4,3,22,21,"PAH",86,1,0)="^^52^52^2981214"
^DIC(9.4,3,22,21,"PAH",86,1,1,0)="               XQ       The XQ routine in patch XU*8*94 did not have "
^DIC(9.4,3,22,21,"PAH",86,1,2,0)="                        the changes included. It was changed back to"
^DIC(9.4,3,22,21,"PAH",86,1,3,0)="                        its ""before"" state accidentally.  While this "
^DIC(9.4,3,22,21,"PAH",86,1,4,0)="                        did not cause any operational problems. "
^DIC(9.4,3,22,21,"PAH",86,1,5,0)="                        The changes still need to get out to the field."
^DIC(9.4,3,22,21,"PAH",86,1,6,0)="          "
^DIC(9.4,3,22,21,"PAH",86,1,7,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",86,1,8,0)="Second line"
^DIC(9.4,3,22,21,"PAH",86,1,9,0)=" ;;8.0;KERNEL;**9,46,94,103**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",86,1,10,0)=""
