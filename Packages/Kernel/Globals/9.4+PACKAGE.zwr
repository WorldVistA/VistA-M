^DIC(9.4,59,22,5,"PAH",288,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",288,1,16,0)="(#50.68) to the proper PMIs."
