^DIC(9.4,106,22,3,"PAH",29,1,2,0)="what this patch does."
^DIC(9.4,106,22,3,"PAH",30,0)="35 SEQ #35^3010625^1"
^DIC(9.4,106,22,3,"PAH",30,1,0)="^^2^2^3010625"
^DIC(9.4,106,22,3,"PAH",30,1,1,0)="Please see NUR*4.0*35 on the FORUM Patch Module for a description of this"
^DIC(9.4,106,22,3,"PAH",30,1,2,0)="patch."
^DIC(9.4,106,22,3,"PAH",31,0)="36 SEQ #36^3010802^1"
^DIC(9.4,106,22,3,"PAH",31,1,0)="^^2^2^3010802"
^DIC(9.4,106,22,3,"PAH",31,1,1,0)="Please see NUR*4.0*36 on the FORUM Patch Module for a description of this"
^DIC(9.4,106,22,3,"PAH",31,1,2,0)="patch."
^DIC(9.4,106,22,3,"PAH",32,0)="37^3021108^1"
^DIC(9.4,106,22,3,"PAH",32,1,0)="^^2^2^3021108"
^DIC(9.4,106,22,3,"PAH",32,1,1,0)="Please read the NUR*4*37 patch description on FORUM for an explanation of"
^DIC(9.4,106,22,3,"PAH",32,1,2,0)="what this patch does."
^DIC(9.4,106,22,3,"PAH",33,0)="38 SEQ #38^3030628^1"
^DIC(9.4,106,22,3,"PAH",33,1,0)="^^3^3^3030628"
^DIC(9.4,106,22,3,"PAH",33,1,1,0)="This is a maintenance patch that fixes known problems in the Nursing "
^DIC(9.4,106,22,3,"PAH",33,1,2,0)="package as identified by NOISes SAJ-0301-71155, HIN-0601-40523, "
^DIC(9.4,106,22,3,"PAH",33,1,3,0)="FGH-0402-32096, UNY-1202-11134 and ANN-0203-41275."
^DIC(9.4,106,22,3,"PAH",34,0)="39 SEQ #39^3030802^1"
^DIC(9.4,106,22,3,"PAH",34,1,0)="^^2^2^3030802"
^DIC(9.4,106,22,3,"PAH",34,1,1,0)="This patches modifies the Employee Activation/Separation "
^DIC(9.4,106,22,3,"PAH",34,1,2,0)="Report to show start/vacancy dates entered in the past."
^DIC(9.4,106,22,3,"PAH",35,0)="41 SEQ #40^3050813^1"
^DIC(9.4,106,22,3,"PAH",35,1,0)="^^2^2^3050813"
^DIC(9.4,106,22,3,"PAH",35,1,1,0)="Option NURAFL-SPO SERVICE POSITION FILE, EDIT will delete existing "
^DIC(9.4,106,22,3,"PAH",35,1,2,0)="entries that are missing data even if Exit is selected from the form."
^DIC(9.4,106,22,3,"PAH",36,0)="40^3070905.003605^1"
^DIC(9.4,106,22,3,"PAH",36,1,0)="^^2^2^3070905"
^DIC(9.4,106,22,3,"PAH",36,1,1,0)="Please read the NUR*4*40 patch description on FORUM for an explanation of"
^DIC(9.4,106,22,3,"PAH",36,1,2,0)="what this patch does."
^DIC(9.4,106,22,3,"PAH",37,0)="42 SEQ #42^3090422.161922^17"
^DIC(9.4,106,22,3,"PAH",37,1,0)="^^5^5^3090422"
^DIC(9.4,106,22,3,"PAH",37,1,1,0)="There is code in routine NURCES1 that does a Direct Global Read (via "
^DIC(9.4,106,22,3,"PAH",37,1,2,0)="IA1381). This code is not executed.  Since the Vitals package is going to "
^DIC(9.4,106,22,3,"PAH",37,1,3,0)="retire IA1381 the code will be removed.  The Nursing End of Shift which "
^DIC(9.4,106,22,3,"PAH",37,1,4,0)="is the option that executes NURCES1 is using the Vitals API (IA1446) to "
^DIC(9.4,106,22,3,"PAH",37,1,5,0)="get Vitals data."
^DIC(9.4,106,22,3,"PAH",38,0)="43 SEQ #43^3120410.151551^17"
^DIC(9.4,106,22,3,"PAH",38,1,0)="^^6^6^3120410"
^DIC(9.4,106,22,3,"PAH",38,1,1,0)="This patch supports patch PRS*4.0*126--PAID ENHANCEMENTS FOR VANOD.  This"
^DIC(9.4,106,22,3,"PAH",38,1,2,0)="patch--NUR*4.0*43--must be installed prior to patch PRS*4.0*126.  This "
^DIC(9.4,106,22,3,"PAH",38,1,3,0)="patch provides for the ability to enter and store additional information"
^DIC(9.4,106,22,3,"PAH",38,1,4,0)="for Nursing Locations that is required by the VANOD (Veterans Affairs"
^DIC(9.4,106,22,3,"PAH",38,1,5,0)="Nursing Outcomes Database) in accordance with Public Law 107-135 and the"
^DIC(9.4,106,22,3,"PAH",38,1,6,0)="OIG Recommendation 4a (annual reporting requirement)."
^DIC(9.4,106,22,3,"PAH",39,0)="44 SEQ #44^3170830.171859^54"
^DIC(9.4,106,22,3,"PAH",39,1,0)="^^1^1^3170830"
^DIC(9.4,106,22,3,"PAH",39,1,1,0)="Intake Product 8"
^DIC(9.4,106,22,3,"PAH",40,0)="46 SEQ #45^3180228.164952^54"
^DIC(9.4,106,22,3,"PAH",40,1,0)="^^17^17^3180228"
^DIC(9.4,106,22,3,"PAH",40,1,1,0)="The patch addresses two (2) issues:"
^DIC(9.4,106,22,3,"PAH",40,1,2,0)=" "
^DIC(9.4,106,22,3,"PAH",40,1,3,0)="1.   When using the Service Position File, Edit option [NURAFL-SPO]"
^DIC(9.4,106,22,3,"PAH",40,1,4,0)="     in the Administrative Site File Functions option [NURSFL-MENU];"
^DIC(9.4,106,22,3,"PAH",40,1,5,0)="     the prompt for the Service Position abbreviation requires an"
^DIC(9.4,106,22,3,"PAH",40,1,6,0)="     entry of 10 characters or less.  When a new abbreviation is"
^DIC(9.4,106,22,3,"PAH",40,1,7,0)="     correctly entered, the application adds it as a new NURS SERVICE"
^DIC(9.4,106,22,3,"PAH",40,1,8,0)="     POSITION.  After entering the abbreviation, the application pops"
^DIC(9.4,106,22,3,"PAH",40,1,9,0)="     a ScreenMan Form that allows the abbreviation to be re-entered."
^DIC(9.4,106,22,3,"PAH",40,1,10,0)="     If the abbreviation is re-entered with a value with a length"
^DIC(9.4,106,22,3,"PAH",40,1,11,0)="     greater than 10 characters, a program error occurs (UNDEFINED)"
^DIC(9.4,106,22,3,"PAH",40,1,12,0)="     and the typical user VistA session is terminated."
^DIC(9.4,106,22,3,"PAH",40,1,13,0)=" "
^DIC(9.4,106,22,3,"PAH",40,1,14,0)="2.   When a patient is admitted/transferred to a new ward and there"
^DIC(9.4,106,22,3,"PAH",40,1,15,0)="     is no corresponding entry in the NURS LOCATION file (#211.4),"
^DIC(9.4,106,22,3,"PAH",40,1,16,0)="     the user gets an erroneous message that Queueing is not allowed"
^DIC(9.4,106,22,3,"PAH",40,1,17,0)="     that is displayed after the ""Patient Transferred"" message."
^DIC(9.4,106,22,3,"PAH",41,0)="45 SEQ #46^3180601.150523^54"
^DIC(9.4,106,22,3,"PAH",41,1,0)="^^6^6^3180601"
^DIC(9.4,106,22,3,"PAH",41,1,1,0)="20170309        Enhancements to Nursing Patient Assignment Worksheet"
^DIC(9.4,106,22,3,"PAH",41,1,2,0)="                Only display last 4 of SSN"
^DIC(9.4,106,22,3,"PAH",41,1,3,0)="                Display diagnosis as ""ON FILE"""
^DIC(9.4,106,22,3,"PAH",41,1,4,0)=" "
^DIC(9.4,106,22,3,"PAH",41,1,5,0)="20170316        Enhancements to Nursing End of Shift Report"
^DIC(9.4,106,22,3,"PAH",41,1,6,0)="                Various enhances to EOS report"
^DIC(9.4,106,22,3,"PAH",42,0)="47 SEQ #47^3180906.155123^54"
^DIC(9.4,106,22,3,"PAH",42,1,0)="^^3^3^3180906"
^DIC(9.4,106,22,3,"PAH",42,1,1,0)="This patch addresses one issue:"
^DIC(9.4,106,22,3,"PAH",42,1,2,0)=" "
^DIC(9.4,106,22,3,"PAH",42,1,3,0)="1. VistA crashes when a ""?"" is entered at the Military Status query."
