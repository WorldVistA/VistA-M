^DIC(9.4,14,22,5.9,"PAH",132,1,94,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*294 does not "
^DIC(9.4,14,22,5.9,"PAH",132,1,95,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",132,1,96,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",132,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,98,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*294 does not "
^DIC(9.4,14,22,5.9,"PAH",132,1,99,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",132,1,100,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",132,1,101,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,102,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*294 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",132,1,103,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",132,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,105,0)=" DBIA: 3879-A"
^DIC(9.4,14,22,5.9,"PAH",132,1,106,0)="       3879-B"
^DIC(9.4,14,22,5.9,"PAH",132,1,107,0)="       3879-C 3181-A, 3181-D, and 3181-G"
^DIC(9.4,14,22,5.9,"PAH",132,1,108,0)="       3181-A"
^DIC(9.4,14,22,5.9,"PAH",132,1,109,0)="       3181-D"
^DIC(9.4,14,22,5.9,"PAH",132,1,110,0)="       3181-G"
