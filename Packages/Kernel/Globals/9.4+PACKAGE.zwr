^DIC(9.4,14,22,5.9,"PAH",278,1,756,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,757,0)="Parameter                       Instance   Value"
^DIC(9.4,14,22,5.9,"PAH",278,1,758,0)="-----------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,759,0)="PKG: ORDER ENTRY/RESULTS REPOR  10         M.A.S."
^DIC(9.4,14,22,5.9,"PAH",278,1,760,0)="PKG: ORDER ENTRY/RESULTS REPOR  20         ALLERGIES"
^DIC(9.4,14,22,5.9,"PAH",278,1,761,0)="PKG: ORDER ENTRY/RESULTS REPOR  30         VITALS/MEASUREMENTS"
^DIC(9.4,14,22,5.9,"PAH",278,1,762,0)="PKG: ORDER ENTRY/RESULTS REPOR  35         ACTIVITY"
^DIC(9.4,14,22,5.9,"PAH",278,1,763,0)="PKG: ORDER ENTRY/RESULTS REPOR  40         NURSING"
^DIC(9.4,14,22,5.9,"PAH",278,1,764,0)="PKG: ORDER ENTRY/RESULTS REPOR  50         DIETETICS"
^DIC(9.4,14,22,5.9,"PAH",278,1,765,0)="PKG: ORDER ENTRY/RESULTS REPOR  59         CLINIC INFUSIONS"
