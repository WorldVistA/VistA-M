^DIC(9.4,4,22,1,"PAH",64,0)="94 SEQ #89^2991003^1"
^DIC(9.4,4,22,1,"PAH",64,1,0)="^^57^57^2991003"
^DIC(9.4,4,22,1,"PAH",64,1,1,0)="Patch XM*7.1*94"
^DIC(9.4,4,22,1,"PAH",64,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",64,1,3,0)="NOIS:  none"
^DIC(9.4,4,22,1,"PAH",64,1,4,0)="Test Site:  GATEWAY.DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",64,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",64,1,6,0)="When receiving mail from another site, and the subject, from, and sender"
^DIC(9.4,4,22,1,"PAH",64,1,7,0)="lengths are large, the process can abort with ""string too long"" when"
^DIC(9.4,4,22,1,"PAH",64,1,8,0)="attempting to file these fields in the MESSAGE file.  This patch ensures"
^DIC(9.4,4,22,1,"PAH",64,1,9,0)="that this doesn't happen."
^DIC(9.4,4,22,1,"PAH",64,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",64,1,11,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",64,1,12,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",64,1,13,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",64,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",64,1,15,0)="ROUTINES:"
