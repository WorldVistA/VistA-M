^DIC(9.4,85,22,1.5,"PAH",10,0)="35 SEQ #32^3020116^1"
^DIC(9.4,85,22,1.5,"PAH",10,1,0)="^^64^64^3020116"
^DIC(9.4,85,22,1.5,"PAH",10,1,1,0)="Patch VAQ*1.5*35"
^DIC(9.4,85,22,1.5,"PAH",10,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",10,1,3,0)="NOIS FAV-1001-70165, MWV-1201-20937"
^DIC(9.4,85,22,1.5,"PAH",10,1,4,0)="Test Sites: Fayetteville, AR; Martinsburg, WV"
^DIC(9.4,85,22,1.5,"PAH",10,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",10,1,6,0)="This patch prevents the option VAQ PDX PROCESS EXTERNAL from displaying"
^DIC(9.4,85,22,1.5,"PAH",10,1,7,0)="to the user any external requests from closed sites.  Any such requests"
^DIC(9.4,85,22,1.5,"PAH",10,1,8,0)="will be marked for purge."
^DIC(9.4,85,22,1.5,"PAH",10,1,9,0)=""
^DIC(9.4,85,22,1.5,"PAH",10,1,10,0)="This patch also provides a double-check to ensure that no transactions"
^DIC(9.4,85,22,1.5,"PAH",10,1,11,0)="are sent to closed sites.  Any such requests will be marked for purge."
^DIC(9.4,85,22,1.5,"PAH",10,1,12,0)=""
^DIC(9.4,85,22,1.5,"PAH",10,1,13,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",10,1,14,0)="is at a minimum.  It requires patch VAQ*1.5*29."
^DIC(9.4,85,22,1.5,"PAH",10,1,15,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",10,1,16,0)=" "
^DIC(9.4,85,22,1.5,"PAH",10,1,17,0)="ROUTINES:"
^DIC(9.4,85,22,1.5,"PAH",10,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,85,22,1.5,"PAH",10,1,19,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",10,1,20,0)=" "
^DIC(9.4,85,22,1.5,"PAH",10,1,21,0)="             Before        After"
^DIC(9.4,85,22,1.5,"PAH",10,1,22,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,85,22,1.5,"PAH",10,1,23,0)="-----------------------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",10,1,24,0)="VAQADM50    4268774      5135296     5,35"
^DIC(9.4,85,22,1.5,"PAH",10,1,25,0)="VAQEXT01    5668219      6188779     14,35"
^DIC(9.4,85,22,1.5,"PAH",10,1,26,0)="VAQUTL97    1499668      1906264     2,9,29,35"
^DIC(9.4,85,22,1.5,"PAH",10,1,27,0)="* Checksums produced by CHECK^XTSUMBLD"
