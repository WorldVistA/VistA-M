^DIC(9.4,3,22,21,"PAH",160,1,41,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",160,1,42,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",160,1,43,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,44,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",160,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,46,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",160,1,47,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",160,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,49,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",160,1,50,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",160,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,52,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",160,1,53,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",160,1,54,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",160,1,55,0)="      options:"
^DIC(9.4,3,22,21,"PAH",160,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,57,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",160,1,58,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",160,1,59,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",160,1,60,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",160,1,61,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,62,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",160,1,63,0)="      non-peakpeak time."
^DIC(9.4,3,22,21,"PAH",160,1,64,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",160,1,65,0)="      With the Users on the system there is a small chance that a user"
^DIC(9.4,3,22,21,"PAH",160,1,66,0)="      would get a CLOBER/NOSOURCE error."
^DIC(9.4,3,22,21,"PAH",160,1,67,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,68,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,69,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",160,1,70,0)="      option:"
^DIC(9.4,3,22,21,"PAH",160,1,71,0)="        Install Package(s)  'XU*8.0*155'"
^DIC(9.4,3,22,21,"PAH",160,1,72,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",160,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,74,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",160,1,75,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",160,1,76,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",160,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,78,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",161,0)="126 SEQ #168"
^DIC(9.4,3,22,21,"PAH",161,1,0)="^^1^1^3010710^"
^DIC(9.4,3,22,21,"PAH",161,1,1,0)="Not actually applied."
^DIC(9.4,3,22,21,"PAH",162,0)="206 SEQ #169^3010710^1"
^DIC(9.4,3,22,21,"PAH",162,1,0)="^^1^1^3010710"
^DIC(9.4,3,22,21,"PAH",162,1,1,0)="See patch description."
^DIC(9.4,3,22,21,"PAH",163,0)="196 SEQ #170^3010802^1"
^DIC(9.4,3,22,21,"PAH",163,1,0)="^^64^64^3010802"
^DIC(9.4,3,22,21,"PAH",163,1,1,0)="NOIS CPH-0301-43012"
^DIC(9.4,3,22,21,"PAH",163,1,2,0)="     CPH-0301-43024"
^DIC(9.4,3,22,21,"PAH",163,1,3,0)="Site was getting a null subscript error when a site that did not have a"
^DIC(9.4,3,22,21,"PAH",163,1,4,0)="station number in the institution file (#4) made a RDV request to the site."
^DIC(9.4,3,22,21,"PAH",163,1,5,0)="This was fixed by checking for the station number when the request is made"
^DIC(9.4,3,22,21,"PAH",163,1,6,0)="to prevent sending a invalid request.  At the remote site a second set of"
^DIC(9.4,3,22,21,"PAH",163,1,7,0)="check are made to see that all the needed parameters are in place before"
^DIC(9.4,3,22,21,"PAH",163,1,8,0)="starting to log the visit."
^DIC(9.4,3,22,21,"PAH",163,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",163,1,10,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",163,1,11,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",163,1,12,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",163,1,13,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",163,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",163,1,15,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",163,1,16,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",163,1,17,0)="XUESSO1       4127624   4782174    **165,183,196**"
^DIC(9.4,3,22,21,"PAH",163,1,18,0)=""
^DIC(9.4,3,22,21,"PAH",163,1,19,0)="List of preceding patches: 183"
^DIC(9.4,3,22,21,"PAH",163,1,20,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",163,1,21,0)=""
^DIC(9.4,3,22,21,"PAH",163,1,22,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",163,1,23,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",163,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",163,1,25,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",163,1,26,0)=">>>Do not allow users to make RDV requests during the install."
^DIC(9.4,3,22,21,"PAH",163,1,27,0)=""
^DIC(9.4,3,22,21,"PAH",163,1,28,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",163,1,29,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",163,1,30,0)="     "
^DIC(9.4,3,22,21,"PAH",163,1,31,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",163,1,32,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",163,1,33,0)="     "
^DIC(9.4,3,22,21,"PAH",163,1,34,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",163,1,35,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",163,1,36,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",163,1,37,0)="      options:"
^DIC(9.4,3,22,21,"PAH",163,1,38,0)="      "
^DIC(9.4,3,22,21,"PAH",163,1,39,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",163,1,40,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",163,1,41,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",163,1,42,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",163,1,43,0)="     "
^DIC(9.4,3,22,21,"PAH",163,1,44,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",163,1,45,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",163,1,46,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",163,1,47,0)="      TASKMAN can remain running."
^DIC(9.4,3,22,21,"PAH",163,1,48,0)="      Do not allow users to make RDV requests during the install."
^DIC(9.4,3,22,21,"PAH",163,1,49,0)="     "
^DIC(9.4,3,22,21,"PAH",163,1,50,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",163,1,51,0)="      option:"
^DIC(9.4,3,22,21,"PAH",163,1,52,0)="        Install Package(s)  'XU*8.0*196'"
^DIC(9.4,3,22,21,"PAH",163,1,53,0)="                             =========="
