^DIC(9.4,3,22,21,"PAH",503,0)="657 SEQ #532^3171227.135224^54"
^DIC(9.4,3,22,21,"PAH",503,1,0)="^^47^47^3171227"
^DIC(9.4,3,22,21,"PAH",503,1,1,0)="Subject:  SECURE HASH LIBRARY FUNCTIONS"
^DIC(9.4,3,22,21,"PAH",503,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",503,1,3,0)="Category:  ROUTINE"
^DIC(9.4,3,22,21,"PAH",503,1,4,0)="           ENHANCEMENT"
^DIC(9.4,3,22,21,"PAH",503,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",503,1,6,0)="Description:"
^DIC(9.4,3,22,21,"PAH",503,1,7,0)="==========="
^DIC(9.4,3,22,21,"PAH",503,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",503,1,9,0)="Federal Information Processing Standards Publication 180-4 (FIPS PUB "
^DIC(9.4,3,22,21,"PAH",503,1,10,0)="180-4) specifies secure hash algorithms for computing a condensed "
^DIC(9.4,3,22,21,"PAH",503,1,11,0)="representation of electronic data (message). The hash algorithms "
^DIC(9.4,3,22,21,"PAH",503,1,12,0)="specified in this Standard are called secure because, for a given "
^DIC(9.4,3,22,21,"PAH",503,1,13,0)="algorithm, it is computationally infeasible 1) to find a message that "
^DIC(9.4,3,22,21,"PAH",503,1,14,0)="corresponds to a given message digest, or 2) to find two different "
^DIC(9.4,3,22,21,"PAH",503,1,15,0)="messages that produce the same message digest. Any change to a message "
^DIC(9.4,3,22,21,"PAH",503,1,16,0)="will, with a very high probability, result in a different message digest."
^DIC(9.4,3,22,21,"PAH",503,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",503,1,18,0)="SHA-256 algorithm taken from the NIST document:"
^DIC(9.4,3,22,21,"PAH",503,1,19,0)=" http://csrc.nist.gov/groups/STM/cavp/documents/shs/sha256-384-512.pdf"
^DIC(9.4,3,22,21,"PAH",503,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",503,1,21,0)="This routine provides new Kernel APIS for Secure Hash Algorithm (SHA-256) "
^DIC(9.4,3,22,21,"PAH",503,1,22,0)="hashing of input of various formats:"
^DIC(9.4,3,22,21,"PAH",503,1,23,0)="$$FILE^XLFSH256(FILENUM,IEN,FIELD)     - Return the SHA-256 hash for the "
^DIC(9.4,3,22,21,"PAH",503,1,24,0)="                                         specified file entry"
^DIC(9.4,3,22,21,"PAH",503,1,25,0)="$$HOSTFILE^XLFSH256(PATH,FILENAME)     - Return the SHA-256 hash for a "
^DIC(9.4,3,22,21,"PAH",503,1,26,0)="                                         host file"
^DIC(9.4,3,22,21,"PAH",503,1,27,0)="$$ROUTINE^XLFSH256(ROUTINE)            - Return the SHA-256 hash for a "
^DIC(9.4,3,22,21,"PAH",503,1,28,0)="                                         routine"
^DIC(9.4,3,22,21,"PAH",503,1,29,0)="$$SHA256^XLFSH256(MESSAGE)             - SHA-256 hash for a message that "
^DIC(9.4,3,22,21,"PAH",503,1,30,0)="can "
^DIC(9.4,3,22,21,"PAH",503,1,31,0)="                                         be passed as a single string"
^DIC(9.4,3,22,21,"PAH",503,1,32,0)="$$LSHA256^XLFSH256(MSUB,NBLOCKS)       - SHA-256 hash for a message too "
^DIC(9.4,3,22,21,"PAH",503,1,33,0)="long "
^DIC(9.4,3,22,21,"PAH",503,1,34,0)="                                         to be passed as a single string"
^DIC(9.4,3,22,21,"PAH",503,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",503,1,36,0)="In addition, this routine provides several new Math Library Functions "
^DIC(9.4,3,22,21,"PAH",503,1,37,0)="that were used to create the SHA-256 hash:"
^DIC(9.4,3,22,21,"PAH",503,1,38,0)="$$AND^XLFSH256(X,Y)                  - logical bitwise AND 32 bits"
^DIC(9.4,3,22,21,"PAH",503,1,39,0)="$$NOT^XLFSH256(X)                    - logical bitwise NOT 32 bits"
^DIC(9.4,3,22,21,"PAH",503,1,40,0)="$$XOR^XLFSH256(X,Y)                  - logical bitwise XOR 32 bits"
^DIC(9.4,3,22,21,"PAH",503,1,41,0)="$$N32H^XLFSH256(X)                   - Convert 32 bit decimal to "
^DIC(9.4,3,22,21,"PAH",503,1,42,0)="hexidecimal"
^DIC(9.4,3,22,21,"PAH",503,1,43,0)="$$RD4BYTES^XLFSH256(MESSAGE,OFFSET)  - Return the big-endian 32 bits "
^DIC(9.4,3,22,21,"PAH",503,1,44,0)="                                       value"
^DIC(9.4,3,22,21,"PAH",503,1,45,0)="$$N64BIG^XLFSH256(NUM)               - Return a 64-bit big-endian integer"
^DIC(9.4,3,22,21,"PAH",503,1,46,0)="$$RROTATE^XLFSH256(X,N)              - Right rotate 32 bits"
^DIC(9.4,3,22,21,"PAH",503,1,47,0)="$$RSHIFT^XLFSH256(X,N)               - Right shift 32 bits"
^DIC(9.4,3,22,21,"PAH",504,0)="677 SEQ #533^3180130.153621^54"
^DIC(9.4,3,22,21,"PAH",504,1,0)="^^2^2^3180130"
^DIC(9.4,3,22,21,"PAH",504,1,1,0)="Kernel patch XU*8*677. This patch supports MFS, the PERSON CLASS domain.  "
^DIC(9.4,3,22,21,"PAH",504,1,2,0)="Please refer to the description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",505,0)="671 SEQ #534^3180130.153759^54"
^DIC(9.4,3,22,21,"PAH",505,1,0)="^^1^1^3180130"
^DIC(9.4,3,22,21,"PAH",505,1,1,0)="Please see FORUM for full patch description and installation instructions."
^DIC(9.4,3,22,21,"PAH",506,0)="683 SEQ #535^3180130.153839^54"
^DIC(9.4,3,22,21,"PAH",506,1,0)="^^2^2^3180130"
^DIC(9.4,3,22,21,"PAH",506,1,1,0)="Kernel patch XU*8*683. This patch supports MFS."
^DIC(9.4,3,22,21,"PAH",506,1,2,0)="Please refer to the description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",507,0)="682 SEQ #536^3180228.171152^54"
^DIC(9.4,3,22,21,"PAH",507,1,0)="^^3^3^3180228"
^DIC(9.4,3,22,21,"PAH",507,1,1,0)="Kernel patch XU*8*682. This patch supports MFS, the Demographics files "
^DIC(9.4,3,22,21,"PAH",507,1,2,0)="(RACE, MARITAL STATUS, and RELIGION)."
^DIC(9.4,3,22,21,"PAH",507,1,3,0)="Please refer to the description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",508,0)="630 SEQ #537^3180403.154751^54"
^DIC(9.4,3,22,21,"PAH",508,1,0)="^^25^25^3180403"
^DIC(9.4,3,22,21,"PAH",508,1,1,0)="Joint Legacy Viewer (JLV) is a joint VA and DoD graphical web based "
^DIC(9.4,3,22,21,"PAH",508,1,2,0)="application that is used by both VA providers as well as DoD providers.  "
^DIC(9.4,3,22,21,"PAH",508,1,3,0)="The JLV web based application displays all clinical information on a"
^DIC(9.4,3,22,21,"PAH",508,1,4,0)="patient from VA and DoD sources."
^DIC(9.4,3,22,21,"PAH",508,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",508,1,6,0)="This patch provides a means for uniquely identifying non-VA users "
^DIC(9.4,3,22,21,"PAH",508,1,7,0)="accessing VistA through the JLV application using National Health "
^DIC(9.4,3,22,21,"PAH",508,1,8,0)="Information Network (NHIN) standards for user identification."
^DIC(9.4,3,22,21,"PAH",508,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",508,1,10,0)="This patch adds an entry in the REMOTE APPLICATION file (#8994.5) for the"
^DIC(9.4,3,22,21,"PAH",508,1,11,0)="JLV application. The entry in this file will allow the Kernel Broker code"
^DIC(9.4,3,22,21,"PAH",508,1,12,0)="in the host VistA system to Janus JLV authentication requests for remote"
^DIC(9.4,3,22,21,"PAH",508,1,13,0)="user access, and is done in accordance with instructions on the use of the"
^DIC(9.4,3,22,21,"PAH",508,1,14,0)="Broker Security Enhancement (BSE) as provided by the VistA Infrastructure"
^DIC(9.4,3,22,21,"PAH",508,1,15,0)="team and RPC Broker software documentation. The Kernel Sign-on Log will "
^DIC(9.4,3,22,21,"PAH",508,1,16,0)="show when the JLV application is used to access VistA."
^DIC(9.4,3,22,21,"PAH",508,1,17,0)="    "
^DIC(9.4,3,22,21,"PAH",508,1,18,0)="By using BSE, JLV can discontinue use of the MDWS style of authentication,"
^DIC(9.4,3,22,21,"PAH",508,1,19,0)="which has been deprecated and will be permanently disabled at a future"
^DIC(9.4,3,22,21,"PAH",508,1,20,0)="date. The file entry contains the name of the application, the application"
^DIC(9.4,3,22,21,"PAH",508,1,21,0)="code (hashed), context option, and method of visitor authentication."
^DIC(9.4,3,22,21,"PAH",508,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",508,1,23,0)="The menu option ""JLV GUI Menu Option"" [JLV WEB SERVICES] in the OPTION"
^DIC(9.4,3,22,21,"PAH",508,1,24,0)="file (#19) contains the Remote Procedure Calls (RPCs) for the JLV"
^DIC(9.4,3,22,21,"PAH",508,1,25,0)="application."
