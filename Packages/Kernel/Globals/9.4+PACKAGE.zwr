^DIC(9.4,85,22,1.5,"PAH",5,1,43,0)="       Backup a Transport Global"
^DIC(9.4,85,22,1.5,"PAH",5,1,44,0)="       Install Package(s)"
^DIC(9.4,85,22,1.5,"PAH",5,1,45,0)=" Select INSTALL NAME:   VAQ*1.5*32   Loaded from Distribution <date/time>"
