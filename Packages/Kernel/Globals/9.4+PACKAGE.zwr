^DIC(9.4,35,22,0)="^9.49I^3^2"
^DIC(9.4,35,22,2.43,0)="2.5^2921125^2960613"
^DIC(9.4,35,22,2.43,"PAH",0)="^9.4901^17^17"
^DIC(9.4,35,22,2.43,"PAH",1,0)="46 SEQ #43^2960625^1"
^DIC(9.4,35,22,2.43,"PAH",1,1,0)="^^20^20^2960625"
^DIC(9.4,35,22,2.43,"PAH",1,1,1,0)="This patch addresses many problems associated with Electronic Signature in"
^DIC(9.4,35,22,2.43,"PAH",1,1,2,0)="OE/RR 2.5.  A new field has been added to the Order Parameters file called"
^DIC(9.4,35,22,2.43,"PAH",1,1,3,0)="Electronic Record.  It can be set to 1 of 3 choices:"
^DIC(9.4,35,22,2.43,"PAH",1,1,4,0)="   0 for No"
^DIC(9.4,35,22,2.43,"PAH",1,1,5,0)="   1 for Yes"
^DIC(9.4,35,22,2.43,"PAH",1,1,6,0)="   2 for Yes (allow chart signature)"
^DIC(9.4,35,22,2.43,"PAH",1,1,7,0)=" "
^DIC(9.4,35,22,2.43,"PAH",1,1,8,0)="No entry or 0 will essentially keep the functionality for Electronic"
^DIC(9.4,35,22,2.43,"PAH",1,1,9,0)="Signature the same.  1 or Yes is for sites that want to have all orders"
^DIC(9.4,35,22,2.43,"PAH",1,1,10,0)="signed online and not allow for 'wet' signatures on the paper chart"
^DIC(9.4,35,22,2.43,"PAH",1,1,11,0)="(paperless).  2 or Yes (allow chart signature) is for sites that want all"
^DIC(9.4,35,22,2.43,"PAH",1,1,12,0)="orders signed online, but also allow for those cases where there might be"
^DIC(9.4,35,22,2.43,"PAH",1,1,13,0)="a manually signed order in the chart somewhere.  This last option is the"
^DIC(9.4,35,22,2.43,"PAH",1,1,14,0)="most likely scenerio for most hospitals at this point in time."
^DIC(9.4,35,22,2.43,"PAH",1,1,15,0)=" "
^DIC(9.4,35,22,2.43,"PAH",1,1,16,0)="The printing of new and unsigned orders has been modified.  Orders print"
^DIC(9.4,35,22,2.43,"PAH",1,1,17,0)="(chart copies, labels, service copies, requisitions) when they are"
^DIC(9.4,35,22,2.43,"PAH",1,1,18,0)="released.  Prior to this patch, they would print again when they were"
^DIC(9.4,35,22,2.43,"PAH",1,1,19,0)="signed.  This is no longer the case because of the confusion and potential"
^DIC(9.4,35,22,2.43,"PAH",1,1,20,0)="for error when duplicate orders are printed."
^DIC(9.4,35,22,2.43,"PAH",2,0)="48^2961129^1"
^DIC(9.4,35,22,2.43,"PAH",3,0)="50 SEQ #46^2970204^1"
^DIC(9.4,35,22,2.43,"PAH",4,0)="51 SEQ #47^2970303^1"
^DIC(9.4,35,22,2.43,"PAH",4,1,0)="^^16^16^2970303"
^DIC(9.4,35,22,2.43,"PAH",4,1,1,0)="An optional parameter is added to the formal list of the subroutine"
^DIC(9.4,35,22,2.43,"PAH",4,1,2,0)="PATIENT^ORU1, which will suppress the initial page feed issued by the"
^DIC(9.4,35,22,2.43,"PAH",4,1,3,0)="look-up, prior to presenting the list of patients from which the user may"
^DIC(9.4,35,22,2.43,"PAH",4,1,4,0)="select.  Because the parameter is optional, and must be set to 1 by the"
^DIC(9.4,35,22,2.43,"PAH",4,1,5,0)="calling application to affect the look-up, the change is backward"
^DIC(9.4,35,22,2.43,"PAH",4,1,6,0)="compatible, and without side-effects."
^DIC(9.4,35,22,2.43,"PAH",4,1,7,0)=" "
^DIC(9.4,35,22,2.43,"PAH",4,1,8,0)="Annotated example of use:"
^DIC(9.4,35,22,2.43,"PAH",4,1,9,0)=" "
^DIC(9.4,35,22,2.43,"PAH",4,1,10,0)="       D PATIENT^ORU1(.ORPAT,1) ; Will suppress initial page feed"
^DIC(9.4,35,22,2.43,"PAH",4,1,11,0)=" "
^DIC(9.4,35,22,2.43,"PAH",4,1,12,0)="whereas,"
^DIC(9.4,35,22,2.43,"PAH",4,1,13,0)=" "
^DIC(9.4,35,22,2.43,"PAH",4,1,14,0)="       D PATIENT^ORU1(.ORPAT) ; Will allow initial page feed/no side-"
^DIC(9.4,35,22,2.43,"PAH",4,1,15,0)="                              ; effect (this is how the subroutine was"
^DIC(9.4,35,22,2.43,"PAH",4,1,16,0)="                              ; uniformly called by v2.5"
^DIC(9.4,35,22,2.43,"PAH",5,0)="54 SEQ #48^2970819^1"
