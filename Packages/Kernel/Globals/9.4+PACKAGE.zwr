^DIC(9.4,13,22,8,"PAH",12,1,90,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,8,"PAH",12,1,91,0)="set, if necessary."
^DIC(9.4,13,22,8,"PAH",12,1,92,0)=" "
^DIC(9.4,13,22,8,"PAH",12,1,93,0)="     9.  AXP Sites - Remove TaskMan from WAIT State."
^DIC(9.4,13,22,8,"PAH",12,1,94,0)="         OpenM/Cache Sites - Restart TaskMan."
