^DIC(9.4,11,22,5.03,"PAH",3,1,301,0)="End of example install"
^DIC(9.4,11,22,5.03,"PAH",3,1,302,0)=" ****************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",4,0)="36 SEQ #24^2971016^1"
^DIC(9.4,11,22,5.03,"PAH",4,1,0)="^^1^1^2971016"
^DIC(9.4,11,22,5.03,"PAH",4,1,1,0)="Resolves zero isolate problem on Vitek Literal Interface."
^DIC(9.4,11,22,5.03,"PAH",5,0)="35 SEQ #25^2971021^1"
^DIC(9.4,11,22,5.03,"PAH",5,1,0)="^^4^4^2971021"
^DIC(9.4,11,22,5.03,"PAH",5,1,1,0)="The Vitek Literal Interface parser routine loops infinitely when"
^DIC(9.4,11,22,5.03,"PAH",5,1,2,0)="extra large data streams are encountered. The LAMIVTLP routine was modified "
^DIC(9.4,11,22,5.03,"PAH",5,1,3,0)="to fix this problem."
^DIC(9.4,11,22,5.03,"PAH",5,1,4,0)=" "
^DIC(9.4,11,22,5.03,"PAH",6,0)="37 SEQ #26^2971118^1"
^DIC(9.4,11,22,5.03,"PAH",6,1,0)="^^2^2^2971118"
^DIC(9.4,11,22,5.03,"PAH",6,1,1,0)="Eliminates the undefined from LAMIVTL0 when a deleted accession"
^DIC(9.4,11,22,5.03,"PAH",6,1,2,0)="number is sent across the Vitek Literal Interface. "
^DIC(9.4,11,22,5.03,"PAH",7,0)="40 SEQ #27^2980220^1"
^DIC(9.4,11,22,5.03,"PAH",7,1,0)="^^5^5^2980220"
^DIC(9.4,11,22,5.03,"PAH",7,1,1,0)=" The 63.3 and 63.31 nodes in the LAB DATA file (#63) are"
^DIC(9.4,11,22,5.03,"PAH",7,1,2,0)=" not incremented properly when multiple organisms are"
^DIC(9.4,11,22,5.03,"PAH",7,1,3,0)=" found using the Vitek Literal Interface. The routines LAMIVTL3"
^DIC(9.4,11,22,5.03,"PAH",7,1,4,0)=" and LAMIVTL4 have been edited to resolve the problem."
^DIC(9.4,11,22,5.03,"PAH",7,1,5,0)=""
^DIC(9.4,11,22,5.03,"PAH",8,0)="27^2980318^1"
^DIC(9.4,11,22,5.03,"PAH",8,1,0)="^^2^2^2980318"
^DIC(9.4,11,22,5.03,"PAH",8,1,1,0)="See LABORATORY ELECTRONIC DATA INTERCHANGE (LEDI) PATCH LA*5.2*27 and PATCH"
^DIC(9.4,11,22,5.03,"PAH",8,1,2,0)="LR*5.2*153 INSTALLATION GUIDE."
^DIC(9.4,11,22,5.03,"PAH",9,0)="42^2980417^1"
^DIC(9.4,11,22,5.03,"PAH",9,1,0)="^^301^301^2980417"
^DIC(9.4,11,22,5.03,"PAH",9,1,1,0)="            AUTOMATED LAB INSTRUMENTS (LA) Y2K PATCH"
^DIC(9.4,11,22,5.03,"PAH",9,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,4,0)=" Description:"
^DIC(9.4,11,22,5.03,"PAH",9,1,5,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,6,0)=" This is the Year 2000 (Y2K) compliance patch containing the changes"
^DIC(9.4,11,22,5.03,"PAH",9,1,7,0)=" necessary to accommodate the year 2000.  2 digit (YY) year dates are"
^DIC(9.4,11,22,5.03,"PAH",9,1,8,0)=" replaced with 4 digit (CCYY) century year dates in laboratory routines"
^DIC(9.4,11,22,5.03,"PAH",9,1,9,0)=" for patients' permanent clinical record. 2 digit year dates are replaced"
^DIC(9.4,11,22,5.03,"PAH",9,1,10,0)=" in other laboratory routines where space was available."
^DIC(9.4,11,22,5.03,"PAH",9,1,11,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,12,0)=" With the upcoming turn of the century (Y2K) the Office of the"
^DIC(9.4,11,22,5.03,"PAH",9,1,13,0)=" Chief Information Office Technical Services has issued a guidelines"
^DIC(9.4,11,22,5.03,"PAH",9,1,14,0)=" document for VISTA Software Y2K requirements.  This guideline lays out"
^DIC(9.4,11,22,5.03,"PAH",9,1,15,0)=" the core essentials to meet or exceed OMB, GAO and congressional"
^DIC(9.4,11,22,5.03,"PAH",9,1,16,0)=" requirements for Year 2000 requirements.  Laboratory software has been"
^DIC(9.4,11,22,5.03,"PAH",9,1,17,0)=" modified to meet or exceed these guidelines."
^DIC(9.4,11,22,5.03,"PAH",9,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,19,0)=" Reference NOIS:        None"
^DIC(9.4,11,22,5.03,"PAH",9,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,21,0)=" Reporting Site:        N/A"
^DIC(9.4,11,22,5.03,"PAH",9,1,22,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,23,0)=" Test Site(s)--Alpha Platform w/ DSM OS:  Brockton VAMC, Milwaukee VAMC"
^DIC(9.4,11,22,5.03,"PAH",9,1,24,0)="                                          North Chicago VAMC"
^DIC(9.4,11,22,5.03,"PAH",9,1,25,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,27,0)=" -----------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",9,1,28,0)=" Software Availability:"
^DIC(9.4,11,22,5.03,"PAH",9,1,29,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,30,0)=" This patch is available from one of the CIO Field Offices listed below."
^DIC(9.4,11,22,5.03,"PAH",9,1,31,0)=" All VAMC's are encouraged to use their FTP capability to obtain the"
^DIC(9.4,11,22,5.03,"PAH",9,1,32,0)=" software from the appropriate directory"
^DIC(9.4,11,22,5.03,"PAH",9,1,33,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,34,0)=" CIO Field Office           FTP Address             Directory"
^DIC(9.4,11,22,5.03,"PAH",9,1,35,0)=" ----------------          -------------        -----------------"
^DIC(9.4,11,22,5.03,"PAH",9,1,36,0)=" Hines                     152.129.1.110        anonymous.software"
^DIC(9.4,11,22,5.03,"PAH",9,1,37,0)=" Albany                    152.127.1.5          anonymous.software"
^DIC(9.4,11,22,5.03,"PAH",9,1,38,0)=" Salt Lake                 152.131.2.1          anonymous.software"
^DIC(9.4,11,22,5.03,"PAH",9,1,39,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,40,0)=" File Name: LAB_Y2K.KID"
^DIC(9.4,11,22,5.03,"PAH",9,1,41,0)=" Note: This patch is issued as part of a KIDS Distribution in which"
^DIC(9.4,11,22,5.03,"PAH",9,1,42,0)=" the Transport Globals contains three Laboratory patches.  The patches"
^DIC(9.4,11,22,5.03,"PAH",9,1,43,0)=" are LR*5.2*203, LR*5.2*201 and LA*5.2*42."
^DIC(9.4,11,22,5.03,"PAH",9,1,44,0)="  "
^DIC(9.4,11,22,5.03,"PAH",9,1,45,0)="  "
^DIC(9.4,11,22,5.03,"PAH",9,1,46,0)="----------------------------"
^DIC(9.4,11,22,5.03,"PAH",9,1,47,0)="Options affected by changes:"
^DIC(9.4,11,22,5.03,"PAH",9,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,49,0)="AP Microfiche Archive [LA AP FICHE]"
^DIC(9.4,11,22,5.03,"PAH",9,1,50,0)="Lab Error Trap Listing [LA ERR PRINT]"
^DIC(9.4,11,22,5.03,"PAH",9,1,51,0)="Vitek Load Worklist (Build) [LA MI VITEK L/W BUILD]"
^DIC(9.4,11,22,5.03,"PAH",9,1,52,0)="Verify Micro Auto Data [LA MI VERIFY AUTO]"
^DIC(9.4,11,22,5.03,"PAH",9,1,53,0)="VITEK LITERAL [LA VITEK LITERAL]"
^DIC(9.4,11,22,5.03,"PAH",9,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,55,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",9,1,56,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,57,0)="Routine changes:"
^DIC(9.4,11,22,5.03,"PAH",9,1,58,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,59,0)="Routine     Line Tag    Description of Change"
^DIC(9.4,11,22,5.03,"PAH",9,1,60,0)="-------     --------    ------------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",9,1,61,0)="LABALARM    LABALARM+2  Changed call to %DT with X=""NOW"" to Kernel"
^DIC(9.4,11,22,5.03,"PAH",9,1,62,0)="                        $$HTE^XLFDT to determine current system time."
^DIC(9.4,11,22,5.03,"PAH",9,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,64,0)="LADOWN1     TREE+4      Code was taking entire node of panel test multiple"
^DIC(9.4,11,22,5.03,"PAH",9,1,65,0)="                        in file LABORATORY TEST (#60) as pointer to entry"
^DIC(9.4,11,22,5.03,"PAH",9,1,66,0)="                        in file LABORATORY TEST (#60). Since other data is"
^DIC(9.4,11,22,5.03,"PAH",9,1,67,0)="                        stored on this node the pointer to file #60 was"
^DIC(9.4,11,22,5.03,"PAH",9,1,68,0)="                        incorrectly constructed. Code now ""+"" variable to"
^DIC(9.4,11,22,5.03,"PAH",9,1,69,0)="                        determine value of first piece."
^DIC(9.4,11,22,5.03,"PAH",9,1,70,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,71,0)="LABERR      EN1+1       Changed save error code to Kernel call $$EC^%ZOSV."
^DIC(9.4,11,22,5.03,"PAH",9,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,73,0)="LABERR      EN1+5       Set Kernel variable DT using approved call"
^DIC(9.4,11,22,5.03,"PAH",9,1,74,0)="                        $$DT^XLFDT, variable SY using call to $$NOW^XLFDT."
^DIC(9.4,11,22,5.03,"PAH",9,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,76,0)="LA7SMPXL    PD+1        Fixed printing incorrect collecting site on report."
^DIC(9.4,11,22,5.03,"PAH",9,1,77,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,78,0)="LA7SMPXL    SITE+1      Fixed printing incorrect collecting site on report."
^DIC(9.4,11,22,5.03,"PAH",9,1,79,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,80,0)="LASET       LA1+7       Changed call to %DT with X=""NOW"" to Kernel"
^DIC(9.4,11,22,5.03,"PAH",9,1,81,0)="                        $$HTE^XLFDT to determine current system time."
^DIC(9.4,11,22,5.03,"PAH",9,1,82,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,83,0)="LA7UTIL     CADT+0      Extrinsic function to calculate current accession"
^DIC(9.4,11,22,5.03,"PAH",9,1,84,0)="          - CADT+6      date based on accession area transform."
^DIC(9.4,11,22,5.03,"PAH",9,1,85,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,86,0)="LA7VORM     OBR+39      Corrected storing incorrect collecting site when"
^DIC(9.4,11,22,5.03,"PAH",9,1,87,0)="                        building file LAB PENDING ORDERS ENTRY (#69.6)."
^DIC(9.4,11,22,5.03,"PAH",9,1,88,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,89,0)="LAMIAUT0    ACCESS+2    Change default 2-digit year accession date to"
^DIC(9.4,11,22,5.03,"PAH",9,1,90,0)="          - ACCESS+6    current accession date based on accession area"
^DIC(9.4,11,22,5.03,"PAH",9,1,91,0)="                        transform. Call to $$CADT^LA7UTIL to determine"
^DIC(9.4,11,22,5.03,"PAH",9,1,92,0)="                        current accession date and call to $$FMTE^XLFDT"
^DIC(9.4,11,22,5.03,"PAH",9,1,93,0)="                        to display FileMan date in external format."
^DIC(9.4,11,22,5.03,"PAH",9,1,94,0)="                        Display accession date with 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,95,0)="                        Added ""P"" to %DT variable, assumes past dates."
^DIC(9.4,11,22,5.03,"PAH",9,1,96,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,97,0)="LAMIAUT0    DATE+4      Change default 2-digit year accession date to"
^DIC(9.4,11,22,5.03,"PAH",9,1,98,0)="          - DATE+7      current accession date based on accession area"
^DIC(9.4,11,22,5.03,"PAH",9,1,99,0)="                        transform. Call to $$CADT^LA7UTIL to determine"
^DIC(9.4,11,22,5.03,"PAH",9,1,100,0)="                        current accession date and call to $$FMTE^XLFDT"
^DIC(9.4,11,22,5.03,"PAH",9,1,101,0)="                        to display FileMan date in external format."
^DIC(9.4,11,22,5.03,"PAH",9,1,102,0)="                        Display accession date with 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,103,0)="                        Added ""P"" to %DT variable, assumes past dates."
^DIC(9.4,11,22,5.03,"PAH",9,1,104,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,105,0)="LAMIAUT7    CLEAR+7     Added ""P"" to %DT variable."
^DIC(9.4,11,22,5.03,"PAH",9,1,106,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,107,0)="LAMIVT5     LA3+2       Change 2-digit year default accession date to"
^DIC(9.4,11,22,5.03,"PAH",9,1,108,0)="                        current accession date based on accession area"
^DIC(9.4,11,22,5.03,"PAH",9,1,109,0)="                        transform. Display accession date with 4-digit"
^DIC(9.4,11,22,5.03,"PAH",9,1,110,0)="                        year."
^DIC(9.4,11,22,5.03,"PAH",9,1,111,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,112,0)="LAMIVT6     LA3+2       Change 2-digit year default accession date to"
^DIC(9.4,11,22,5.03,"PAH",9,1,113,0)="                        current accession date based on accession area"
^DIC(9.4,11,22,5.03,"PAH",9,1,114,0)="                        transform. Display accession date with 4-digit"
^DIC(9.4,11,22,5.03,"PAH",9,1,115,0)="                        year."
^DIC(9.4,11,22,5.03,"PAH",9,1,116,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,117,0)="LAMIVTL0    LRAD+1      Added ""P"" to %DT variable. "
^DIC(9.4,11,22,5.03,"PAH",9,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,119,0)="LAMIVTL0    LRAD+3      Call to $$CADT^LA7UTIL to determine current"
^DIC(9.4,11,22,5.03,"PAH",9,1,120,0)="                        accession date and call to $$FMTE^XLFDT to"
^DIC(9.4,11,22,5.03,"PAH",9,1,121,0)="                        display FileMan date in external format."
^DIC(9.4,11,22,5.03,"PAH",9,1,122,0)="                        Display accession date with 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,123,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,124,0)="LAMIVTKD    SAMPLE+10   Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,125,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,126,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,127,0)="LAMIVTKD    SAMPLE+12   Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,128,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,129,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,130,0)="LAMIVTKD    PNM+3       Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,131,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,132,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,133,0)="LAMIVTKD    PNM+6       Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,134,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,135,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,136,0)="LAMIVTLD    SAMPLE+37   Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,137,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,138,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,139,0)="LAMIVTLD    SAMPLE+41   Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,140,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,141,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,142,0)="LAMIVTLD    PNM+6       Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,143,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,144,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,145,0)="LAMIVTLD    PNM+16      Change building date with 2-digit year to call"
^DIC(9.4,11,22,5.03,"PAH",9,1,146,0)="                        to $$Y2K^LRX which returns 4-digit year."
^DIC(9.4,11,22,5.03,"PAH",9,1,147,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,148,0)="LAPFICH     EN+4        Added ""P"" to %DT variable."
^DIC(9.4,11,22,5.03,"PAH",9,1,149,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,150,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,151,0)="During initial evaluation of LA namespaced routines it was reported"
^DIC(9.4,11,22,5.03,"PAH",9,1,152,0)="that 20 routines would need renovation to be Y2K compliant. After"
^DIC(9.4,11,22,5.03,"PAH",9,1,153,0)="further evaluation, it was determined the only 11 LA namespaced"
^DIC(9.4,11,22,5.03,"PAH",9,1,154,0)="routines would need to be modified. The routines originally reported"
^DIC(9.4,11,22,5.03,"PAH",9,1,155,0)="but not modified are:"
^DIC(9.4,11,22,5.03,"PAH",9,1,156,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,157,0)="Routine     Line Tag    Non-Renovation Reason"
^DIC(9.4,11,22,5.03,"PAH",9,1,158,0)="-------     --------    ------------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",9,1,159,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,160,0)="LABCX4D     SAMPLE+10   Changing date format will violate vendor's"
^DIC(9.4,11,22,5.03,"PAH",9,1,161,0)="                        instrument interface specification."
^DIC(9.4,11,22,5.03,"PAH",9,1,162,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,163,0)="LAEKT4      LA2+2       Code is checking if test result is less than"
^DIC(9.4,11,22,5.03,"PAH",9,1,164,0)="                        999999. Not a Y2K date issue."
^DIC(9.4,11,22,5.03,"PAH",9,1,165,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,166,0)="LAGEN       CONTROL+2   Code is calculating inverse FileMan date from"
^DIC(9.4,11,22,5.03,"PAH",9,1,167,0)="                        specimen collection date/time in FileMan date"
^DIC(9.4,11,22,5.03,"PAH",9,1,168,0)="                        format."
^DIC(9.4,11,22,5.03,"PAH",9,1,169,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,170,0)="LAHTCCAD    SAMPLE+1    Changing date format will violate vendor's"
^DIC(9.4,11,22,5.03,"PAH",9,1,171,0)="                        instrument interface specification."
^DIC(9.4,11,22,5.03,"PAH",9,1,172,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,173,0)="LAKDIFF     WLN+1       Code is calculating inverse FileMan date from"
^DIC(9.4,11,22,5.03,"PAH",9,1,174,0)="                        specimen collection date/time in FileMan date"
^DIC(9.4,11,22,5.03,"PAH",9,1,175,0)="                        format."
^DIC(9.4,11,22,5.03,"PAH",9,1,176,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,177,0)="LAKDIFF3    LAKDIFF3+13 Code is calculating inverse FileMan date from"
^DIC(9.4,11,22,5.03,"PAH",9,1,178,0)="                        specimen collection date/time in FileMan date"
^DIC(9.4,11,22,5.03,"PAH",9,1,179,0)="                        format."
^DIC(9.4,11,22,5.03,"PAH",9,1,180,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,181,0)="LAKUR       WLN+1       Code is calculating inverse FileMan date from"
^DIC(9.4,11,22,5.03,"PAH",9,1,182,0)="                        specimen collection date/time in FileMan date"
^DIC(9.4,11,22,5.03,"PAH",9,1,183,0)="                        format."
^DIC(9.4,11,22,5.03,"PAH",9,1,184,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,185,0)="LAMIVTLG    CONTROL+2   Code is calculating inverse FileMan date from"
^DIC(9.4,11,22,5.03,"PAH",9,1,186,0)="                        specimen collection date/time in FileMan date"
^DIC(9.4,11,22,5.03,"PAH",9,1,187,0)="                        format."
^DIC(9.4,11,22,5.03,"PAH",9,1,188,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,189,0)="LAMSD       PT+9        Changing date format will violate vendor's"
^DIC(9.4,11,22,5.03,"PAH",9,1,190,0)="                        instrument interface specification."
^DIC(9.4,11,22,5.03,"PAH",9,1,191,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,192,0)="LAMSD       SPEC+4      Changing date format will violate vendor's"
^DIC(9.4,11,22,5.03,"PAH",9,1,193,0)="                        instrument interface specification."
^DIC(9.4,11,22,5.03,"PAH",9,1,194,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,195,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,196,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,197,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,198,0)="ROUTINE SUMMARY:"
^DIC(9.4,11,22,5.03,"PAH",9,1,199,0)="================="
^DIC(9.4,11,22,5.03,"PAH",9,1,200,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,201,0)="The second line of the routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",9,1,202,0)=" "
^DIC(9.4,11,22,5.03,"PAH",9,1,203,0)="   <tab>;;5.2;AUTOMATED LAB INSTRUMENTS;**[patch list]**; Sep 27, 1994"
