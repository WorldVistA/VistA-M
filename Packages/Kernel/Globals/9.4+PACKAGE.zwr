^DIC(9.4,11,22,5.03,"PAH",45,1,209,0)="Routine list of preceding patches: 80, 84, 85"
^DIC(9.4,11,22,5.03,"PAH",46,0)="94 SEQ #67^3170106.125503^54"
^DIC(9.4,11,22,5.03,"PAH",47,0)="90^3170123.141208^54"
^DIC(9.4,11,22,5.03,"PAH",47,1,0)="^^405^405^3170123"
^DIC(9.4,11,22,5.03,"PAH",47,1,1,0)="The build for this patch is distributed as part of a multi-package build "
^DIC(9.4,11,22,5.03,"PAH",47,1,2,0)="that contains LR*5.2*474 and LA*5.2*90 and contains functionality that "
^DIC(9.4,11,22,5.03,"PAH",47,1,3,0)="will allow Microbiology instrumentation to utilize the Lab Universal"
^DIC(9.4,11,22,5.03,"PAH",47,1,4,0)="Interface. "
^DIC(9.4,11,22,5.03,"PAH",47,1,5,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,6,0)="By utilizing the Universal interface and middleware sites will be able to "
^DIC(9.4,11,22,5.03,"PAH",47,1,7,0)="interface microbiology devices to a UI standard interface. New"
^DIC(9.4,11,22,5.03,"PAH",47,1,8,0)="functionality will be applied that will allow for a ""MI"" subscripted test"
^DIC(9.4,11,22,5.03,"PAH",47,1,9,0)="to be added to the Auto Instrument file. There will also be enhanced"
^DIC(9.4,11,22,5.03,"PAH",47,1,10,0)="result processing and verify/release functions (see LR*5.2*474 patch"
^DIC(9.4,11,22,5.03,"PAH",47,1,11,0)="descriptions for additional details)."
^DIC(9.4,11,22,5.03,"PAH",47,1,12,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,13,0)="This patch is distributed in support of the VistA Laboratory Enhancement"
^DIC(9.4,11,22,5.03,"PAH",47,1,14,0)="(VLE) Microbiology/Data Innovations interface utilizing the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",47,1,15,0)="Universal Interface."
^DIC(9.4,11,22,5.03,"PAH",47,1,16,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,17,0)="The patch contains a modification to the AUTO INSTRUMENT (#62.4) file "
^DIC(9.4,11,22,5.03,"PAH",47,1,18,0)="that will change the name of the ""CHEM TESTS"" (#30) field to ""LABORATORY"
^DIC(9.4,11,22,5.03,"PAH",47,1,19,0)="TESTS"" and modify the input screen to allow ""MI"" subscripted tests to be"
^DIC(9.4,11,22,5.03,"PAH",47,1,20,0)="added to an Auto Instrument entry. The trigger on the TEST (#.01) field"
^DIC(9.4,11,22,5.03,"PAH",47,1,21,0)="was also modified so that only tests with a value in the LOCATION (DATA"
^DIC(9.4,11,22,5.03,"PAH",47,1,22,0)="NAME) (#5) will set the ROUTINE STORAGE (#11) field."
^DIC(9.4,11,22,5.03,"PAH",47,1,23,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,24,0)="Additional Information:"
^DIC(9.4,11,22,5.03,"PAH",47,1,25,0)="-----------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,26,0)="This patch contains an enhancement to the antibiotic susceptibility "
^DIC(9.4,11,22,5.03,"PAH",47,1,27,0)="result processing to accommodate the need for laboratories to "
^DIC(9.4,11,22,5.03,"PAH",47,1,28,0)="report/document variations in susceptibility testing related to "
^DIC(9.4,11,22,5.03,"PAH",47,1,29,0)="differences between in vitro susceptibility testing and in vivo action. "
^DIC(9.4,11,22,5.03,"PAH",47,1,30,0)="An example is extended-spectrum_Beta-lactamases (ESBL)."
^DIC(9.4,11,22,5.03,"PAH",47,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,32,0)="Susceptibility results received as coded entries can be from the SNOMED "
^DIC(9.4,11,22,5.03,"PAH",47,1,33,0)="CT code system or a site-designated local code (L)."
^DIC(9.4,11,22,5.03,"PAH",47,1,34,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,35,0)="The interface supports the following SNOMED CT codes to report "
^DIC(9.4,11,22,5.03,"PAH",47,1,36,0)="susceptibility to antimicrobial agents."
^DIC(9.4,11,22,5.03,"PAH",47,1,37,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,38,0)="131196009    susceptible"
^DIC(9.4,11,22,5.03,"PAH",47,1,39,0)="260357007    moderately susceptible"
^DIC(9.4,11,22,5.03,"PAH",47,1,40,0)="264841006    intermediately susceptible"
^DIC(9.4,11,22,5.03,"PAH",47,1,41,0)="30714006     resistant"
^DIC(9.4,11,22,5.03,"PAH",47,1,42,0)="10828004     positive"
^DIC(9.4,11,22,5.03,"PAH",47,1,43,0)="260385009    negative"
^DIC(9.4,11,22,5.03,"PAH",47,1,44,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,45,0)="Local codes in the role of answers can be entered on an interface "
^DIC(9.4,11,22,5.03,"PAH",47,1,46,0)="specific basis using the option Add/Edit Local Identifier [LA7V 62.47 "
^DIC(9.4,11,22,5.03,"PAH",47,1,47,0)="LOCAL IDENTIFIER]"
^DIC(9.4,11,22,5.03,"PAH",47,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,49,0)="An example of reporting ESBL status is the following HL7 OBX segment "
^DIC(9.4,11,22,5.03,"PAH",47,1,50,0)="fragment."
^DIC(9.4,11,22,5.03,"PAH",47,1,51,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,52,0)="OBX|1|CWE|6984-9^ESBL:SUSC:PT:ISLT:ORDQN:AGAR "
^DIC(9.4,11,22,5.03,"PAH",47,1,53,0)="DIFFUSION^LN^^^^2.19^^ESBL||ESBL^ESBL^L^^^^20160721^^+|||+"
^DIC(9.4,11,22,5.03,"PAH",47,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,55,0)="Routines related to this enhancement are:"
^DIC(9.4,11,22,5.03,"PAH",47,1,56,0)="LA7VIN2A"
^DIC(9.4,11,22,5.03,"PAH",47,1,57,0)="LA7VIN7"
^DIC(9.4,11,22,5.03,"PAH",47,1,58,0)="LA7VIN7A"
^DIC(9.4,11,22,5.03,"PAH",47,1,59,0)="LA7VIN7B"
^DIC(9.4,11,22,5.03,"PAH",47,1,60,0)="LA7VHLU6"
^DIC(9.4,11,22,5.03,"PAH",47,1,61,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,62,0)="Blood Bank Review:"
^DIC(9.4,11,22,5.03,"PAH",47,1,63,0)="=================="
^DIC(9.4,11,22,5.03,"PAH",47,1,64,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*90 does not "
^DIC(9.4,11,22,5.03,"PAH",47,1,65,0)="contain any changes to the VISTA BLOOD BANK Software as defined by ProPath"
^DIC(9.4,11,22,5.03,"PAH",47,1,66,0)="standard titled: BBM Team Review of VistA Patches."
^DIC(9.4,11,22,5.03,"PAH",47,1,67,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,68,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*90 does not "
^DIC(9.4,11,22,5.03,"PAH",47,1,69,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,11,22,5.03,"PAH",47,1,70,0)="functions."
^DIC(9.4,11,22,5.03,"PAH",47,1,71,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,72,0)="RISK ANALYSIS: Changes made by patch LA*5.2*90 have no effect on Blood "
^DIC(9.4,11,22,5.03,"PAH",47,1,73,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",47,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,75,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,11,22,5.03,"PAH",47,1,76,0)="made, no specific validation requirements exist as a result of"
^DIC(9.4,11,22,5.03,"PAH",47,1,77,0)="installation of this patch."
^DIC(9.4,11,22,5.03,"PAH",47,1,78,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,79,0)=" "
