^DIC(9.4,151,22,1,"PAH",125,0)="144 SEQ #137^3181004.172401^54"
^DIC(9.4,151,22,1,"PAH",125,1,0)="^^3^3^3181004"
^DIC(9.4,151,22,1,"PAH",125,1,1,0)="    This patch will update the EC NATIONAL PROCEDURE (#725) file by "
^DIC(9.4,151,22,1,"PAH",125,1,2,0)="    adding 30 new procedures, inactivating 15 existing procedures,"
^DIC(9.4,151,22,1,"PAH",125,1,3,0)="    changing 16 CPT codes, and changing 16 procedure names in the file."
^DIC(9.4,151,22,1,"PAH",126,0)="146 SEQ #138^3190402.171739^54"
^DIC(9.4,151,22,1,"PAH",126,1,0)="^^1^1^3190402"
^DIC(9.4,151,22,1,"PAH",126,1,1,0)="Mid-FY19 UPDATE TO EC NATIONAL PROCEDURE (#725) FILE"
^DIC(9.4,151,22,1,"PAH",127,0)="145 SEQ #139^3190722.16455^65"
^DIC(9.4,151,22,1,"PAH",128,0)="147 SEQ #140^3190930.100925^65"
^DIC(9.4,151,22,1,"PAH",128,1,0)="^^4^4^3190930"
^DIC(9.4,151,22,1,"PAH",128,1,1,0)="This patch will update the EC NATIONAL PROCEDURE (#725) file by adding "
^DIC(9.4,151,22,1,"PAH",128,1,2,0)="eight (8) new procedures, inactivating eleven (11) existing procedures, "
^DIC(9.4,151,22,1,"PAH",128,1,3,0)="changing four (4) CPT codes, and changing six (6) procedure names in the "
^DIC(9.4,151,22,1,"PAH",128,1,4,0)="file."
^DIC(9.4,151,22,1,"PAH",129,0)="149 SEQ #141^3200330.125938^70"
^DIC(9.4,151,22,1,"PAH",129,1,0)="^^2^2^3200330"
^DIC(9.4,151,22,1,"PAH",129,1,1,0)="This patch updates thirty-five (35) procedure codes to reflect Fiscal Year"
^DIC(9.4,151,22,1,"PAH",129,1,2,0)="2020 Mid-Year changes, effective April 1, 2020."
^DIC(9.4,151,22,1,"PAH",130,0)="148 SEQ #142^3200707.165214^65"
^DIC(9.4,151,22,1,"PAH",131,0)="150 SEQ #143^3200831.094412^65"
^DIC(9.4,151,22,1,"PAH",131,1,0)="^^2^2^3200831"
^DIC(9.4,151,22,1,"PAH",131,1,1,0)="This patch updates two thousand three hundred ninety two (2,392) procedure"
^DIC(9.4,151,22,1,"PAH",131,1,2,0)="codes to reflect Fiscal Year 2021 changes, effective September 1, 2020."
^DIC(9.4,151,22,1,"PAH",132,0)="151^3200928.091229^17"
^DIC(9.4,151,22,1,"PAH",132,1,0)="^^9^9^3200928"
^DIC(9.4,151,22,1,"PAH",132,1,1,0)="This patch EC*2.0*151 inactivates any DSS Units in the DSS UNIT file"
^DIC(9.4,151,22,1,"PAH",132,1,2,0)="(#724) with the SEND TO PCE field (#13) set to 'Send No Records' and "
^DIC(9.4,151,22,1,"PAH",132,1,3,0)="have an inactive/invalid Stop Code."
^DIC(9.4,151,22,1,"PAH",132,1,4,0)=" "
^DIC(9.4,151,22,1,"PAH",132,1,5,0)="This patch is being released along with SD*5.3*752 that provides Fiscal "
^DIC(9.4,151,22,1,"PAH",132,1,6,0)="year 2021 updates to the CLINIC STOP (#40.7) file.  When inactivating "
^DIC(9.4,151,22,1,"PAH",132,1,7,0)="stop codes in CLINIC STOP (#40.7) file, the DSS UNITS (#724) file also"
^DIC(9.4,151,22,1,"PAH",132,1,8,0)="needs to be updated.  Both patches will be bundled together with the"
^DIC(9.4,151,22,1,"PAH",132,1,9,0)="Scheduling patch being the primary."
^DIC(9.4,151,22,1,"PAH",133,0)="153b^3210326"
^DIC(9.4,151,22,1,"PAH",133,1,0)="^^5^5^3210326"
^DIC(9.4,151,22,1,"PAH",133,1,1,0)="Backup of EC*2.0*153 on Mar 26, 2021"
^DIC(9.4,151,22,1,"PAH",133,1,2,0)=" "
^DIC(9.4,151,22,1,"PAH",133,1,3,0)="Warning:  Installing this backup patch message will install older versions"
