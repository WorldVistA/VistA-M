^DIC(9.4,4,22,1,"PAH",141,0)="168 SEQ #166^3010405^1"
^DIC(9.4,4,22,1,"PAH",141,1,0)="^^60^60^3010405"
^DIC(9.4,4,22,1,"PAH",141,1,1,0)="Patch XM*7.1*168"
^DIC(9.4,4,22,1,"PAH",141,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",141,1,3,0)="NOIS: PUG-0201-50586"
^DIC(9.4,4,22,1,"PAH",141,1,4,0)="Test Site:  Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",141,1,5,0)="HOME^%ZIS is improperly called in several places, which can result in"
^DIC(9.4,4,22,1,"PAH",141,1,6,0)="IO becoming null.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",141,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",141,1,8,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",141,1,9,0)="is at a minimum.  It requires MailMan patches XM*7.1*116, XM*7.1*149,"
^DIC(9.4,4,22,1,"PAH",141,1,10,0)="and XM*7.1*156."
^DIC(9.4,4,22,1,"PAH",141,1,11,0)="============================================================================ "
