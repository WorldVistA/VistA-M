^DIC(9.4,60,22,13,"PAH",414,1,170,0)="Hines:             fo-hines.domain.ext          anonymous.software      "
^DIC(9.4,60,22,13,"PAH",414,1,171,0)="Salt Lake City:    fo-slc.domain.ext            anonymous.software"
^DIC(9.4,60,22,13,"PAH",414,1,172,0)="  The host file is located in the anonymous.software directory."
