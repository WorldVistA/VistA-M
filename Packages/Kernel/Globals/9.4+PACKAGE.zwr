^DIC(9.4,207,22,1,1,96,0)="OPTION:"
^DIC(9.4,207,22,1,1,97,0)="======="
^DIC(9.4,207,22,1,1,98,0)=" VBECS VISTALINK CONTEXT - (B)roker type option used by VistALink to"
^DIC(9.4,207,22,1,1,99,0)=" authenticate users. All Blood Bank users must have this option"
^DIC(9.4,207,22,1,1,100,0)=" assigned as a Secondary Menu Option."
^DIC(9.4,207,22,1,1,101,0)=" "
^DIC(9.4,207,22,1,1,102,0)=" "
^DIC(9.4,207,22,1,1,103,0)="PROTOCOL:"
^DIC(9.4,207,22,1,1,104,0)="========="
^DIC(9.4,207,22,1,1,105,0)=" VBECS ADT-AO8 CLIENT - This protocol is used to deliver HL7 messages"
^DIC(9.4,207,22,1,1,106,0)=" from VistA to VBECS via the VBECSPTU logical link."
^DIC(9.4,207,22,1,1,107,0)=" "
^DIC(9.4,207,22,1,1,108,0)=" VBECS ADT-A08 ROUTER - This protocol is used to receive an HL7 message"
^DIC(9.4,207,22,1,1,109,0)=" from the VAFC ADT-A08 SERVER protocol and executes routing logic to"
^DIC(9.4,207,22,1,1,110,0)=" determine whether the message is to be forwarded to VBECS. VBECS"
^DIC(9.4,207,22,1,1,111,0)=" receives only messages that contain changes to various patient"
^DIC(9.4,207,22,1,1,112,0)=" demographic data."
^DIC(9.4,207,22,1,1,113,0)=" "
^DIC(9.4,207,22,1,1,114,0)=" VBECS ADT-AO8 SERVER - This event driver protocol is triggered by the"
^DIC(9.4,207,22,1,1,115,0)=" "
^DIC(9.4,207,22,1,1,116,0)=" VBECS ADT-A40 CLIENT - This protocol is used to deliver the HL7"
^DIC(9.4,207,22,1,1,117,0)=" message from VistA to VBECS via the VBECSPTM logical link."
^DIC(9.4,207,22,1,1,118,0)=" "
^DIC(9.4,207,22,1,1,119,0)=" VBECS ADT-A40 SERVER - This event driver protocol is triggered by the"
^DIC(9.4,207,22,1,1,120,0)=" "
^DIC(9.4,207,22,1,1,121,0)=" "
^DIC(9.4,207,22,1,1,122,0)=" VBECS OMG CLIENT - This is the subscriber protocol to the VBECS OMG"
^DIC(9.4,207,22,1,1,123,0)=" SERVER protocol that receives the HL7 message from VBECS providing"
^DIC(9.4,207,22,1,1,124,0)=" order updates to the original order message."
^DIC(9.4,207,22,1,1,125,0)=" "
^DIC(9.4,207,22,1,1,126,0)=" VBECS OMG SERVER - This protocol is triggered when an HL7 message from"
^DIC(9.4,207,22,1,1,127,0)=" VBECS is received by the HL7 package."
^DIC(9.4,207,22,1,1,128,0)=" "
^DIC(9.4,207,22,1,1,129,0)="HL7 APPLICATION PARAMETER:"
^DIC(9.4,207,22,1,1,130,0)="=========================="
^DIC(9.4,207,22,1,1,131,0)=" VBECS - This HL7 Application represents the VBECS side of the VBECS/CPRS "
^DIC(9.4,207,22,1,1,132,0)="interface."
^DIC(9.4,207,22,1,1,133,0)=" "
^DIC(9.4,207,22,1,1,134,0)=" VBECS ADT - This HL7 Application represents the receiving application"
^DIC(9.4,207,22,1,1,135,0)=" of the Patient Update and Patient Merge router protocols."
^DIC(9.4,207,22,1,1,136,0)=" "
^DIC(9.4,207,22,1,1,137,0)=" VBECS TRIGGER - This HL7 Application represents the VBECS side of the"
^DIC(9.4,207,22,1,1,138,0)=" Patient Update and Patient Merge interfaces."
^DIC(9.4,207,22,1,1,139,0)=" "
^DIC(9.4,207,22,1,1,140,0)="HL LOGICAL LINK:"
^DIC(9.4,207,22,1,1,141,0)="================"
^DIC(9.4,207,22,1,1,142,0)=" VBECS-OERR - Used to transmit HL7 messages from VBECS to CPRS."
^DIC(9.4,207,22,1,1,143,0)=" "
^DIC(9.4,207,22,1,1,144,0)=" VBECSPTM - Used to transmit HL7 messages from VistA to VBECS when a"
^DIC(9.4,207,22,1,1,145,0)=" patient merge event occurs."
^DIC(9.4,207,22,1,1,146,0)=" "
^DIC(9.4,207,22,1,1,147,0)=" VBECSPTU - Used to transmit HL7 messages from VistA to VBECS when a"
^DIC(9.4,207,22,1,1,148,0)=" patient update event occurs."
^DIC(9.4,207,22,1,1,149,0)=" "
^DIC(9.4,207,22,1,1,150,0)="PARAMETER DEFINITION:"
^DIC(9.4,207,22,1,1,151,0)="====================="
^DIC(9.4,207,22,1,1,152,0)=" VBECS VISTALINK - Parameter definition used to identify all VBECS "
^DIC(9.4,207,22,1,1,153,0)="Parameters."
^DIC(9.4,207,22,1,1,154,0)=" "
^DIC(9.4,207,22,1,1,155,0)="PARAMETERS:"
^DIC(9.4,207,22,1,1,156,0)="==========="
^DIC(9.4,207,22,1,1,157,0)=" LISTENER IP ADDRESS - Stores the value of the Blood Bank medical"
^DIC(9.4,207,22,1,1,158,0)=" device server where the VistALink listener is installed."
^DIC(9.4,207,22,1,1,159,0)=" "
^DIC(9.4,207,22,1,1,160,0)=" LISTENER PORT NUMBER - Stores the value of the port number where Blood"
^DIC(9.4,207,22,1,1,161,0)=" Bank medical device VistALink listener is listening."
^DIC(9.4,207,22,1,1,162,0)=" "
^DIC(9.4,207,22,1,1,163,0)=" These Parameters are used by M APIs to build the XML messages used by "
^DIC(9.4,207,22,1,1,164,0)="VistALink."
^DIC(9.4,207,22,1,1,165,0)=" VBECS Blood Products"
^DIC(9.4,207,22,1,1,166,0)=" VBECS DSS Extract"
^DIC(9.4,207,22,1,1,167,0)=" VBECS Order Entry"
^DIC(9.4,207,22,1,1,168,0)=" VBECS Patient ABID"
^DIC(9.4,207,22,1,1,169,0)=" VBECS Patient ABO_RH"
^DIC(9.4,207,22,1,1,170,0)=" VBECS Patient Available Units"
^DIC(9.4,207,22,1,1,171,0)=" VBECS Patient Report"
^DIC(9.4,207,22,1,1,172,0)=" VBECS Patient TRRX"
^DIC(9.4,207,22,1,1,173,0)=" VBECS Patient Transfusion History"
^DIC(9.4,207,22,1,1,174,0)=" VBECS Update Workload Event"
^DIC(9.4,207,22,1,1,175,0)=" VBECS Workload"
^DIC(9.4,207,22,1,1,176,0)=" "
