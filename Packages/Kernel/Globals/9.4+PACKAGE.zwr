^DIC(9.4,60,22,13,"PAH",238,0)="280 SEQ #244^3080526.150019^1"
^DIC(9.4,60,22,13,"PAH",238,1,0)="^^3^3^3080526"
^DIC(9.4,60,22,13,"PAH",238,1,1,0)="This patch corrects the following issues."
^DIC(9.4,60,22,13,"PAH",238,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",238,1,3,0)="HD204891 - trade name error (PSI-07-155)"
^DIC(9.4,60,22,13,"PAH",239,0)="274 SEQ #245^3080526.150734^1"
^DIC(9.4,60,22,13,"PAH",239,1,0)="^^7^7^3080526"
^DIC(9.4,60,22,13,"PAH",239,1,1,0)="This patch contains corrections for the following Issues"
^DIC(9.4,60,22,13,"PAH",239,1,2,0)="HD94995   -  I have recieved a complaint from the Pharmacy that the "
^DIC(9.4,60,22,13,"PAH",239,1,3,0)="             Pharmacist field in the prescription file is being filled in"
^DIC(9.4,60,22,13,"PAH",239,1,4,0)="             during the prescription entry process."
^DIC(9.4,60,22,13,"PAH",239,1,5,0)="HD176910  -  Outpatient Pharmacy Activity Log Problem"
^DIC(9.4,60,22,13,"PAH",239,1,6,0)="             HD161861."
^DIC(9.4,60,22,13,"PAH",239,1,7,0)="HD176910  -  Outpatient Pharmacy Activity Log Problem."
^DIC(9.4,60,22,13,"PAH",240,0)="269 SEQ #246^3080526.150808^1"
^DIC(9.4,60,22,13,"PAH",240,1,0)="^^3^3^3080526"
^DIC(9.4,60,22,13,"PAH",240,1,1,0)="Site reported that the incorrect Orderable Item was selected when the"
^DIC(9.4,60,22,13,"PAH",240,1,2,0)="entry was entered in ""lowercase"".  This caused the incorrect medication"
^DIC(9.4,60,22,13,"PAH",240,1,3,0)="to be given."
^DIC(9.4,60,22,13,"PAH",241,0)="206 SEQ #247^3080526.150906^1"
^DIC(9.4,60,22,13,"PAH",241,1,0)="^^8^8^3080526"
^DIC(9.4,60,22,13,"PAH",241,1,1,0)="PSO*7.0*206 "
^DIC(9.4,60,22,13,"PAH",241,1,2,0)="HD68224  - DEA Code handling changes."
^DIC(9.4,60,22,13,"PAH",241,1,3,0)="  HD68648- dup HD68224"
^DIC(9.4,60,22,13,"PAH",241,1,4,0)="  HD85385- dup HD68224"
^DIC(9.4,60,22,13,"PAH",241,1,5,0)="  HD179790- dup HD68224"
^DIC(9.4,60,22,13,"PAH",241,1,6,0)="HD186713 - Label shows Certified after mail status."
^DIC(9.4,60,22,13,"PAH",241,1,7,0)="HD156961 - Medication status of renewed for meds past stop date."
^DIC(9.4,60,22,13,"PAH",241,1,8,0)="HD161968 - Max refill issue for monthly clozapine patient"
^DIC(9.4,60,22,13,"PAH",242,0)="240 SEQ #248^3080526.153318^1"
^DIC(9.4,60,22,13,"PAH",242,1,0)="^^4^4^3080526"
^DIC(9.4,60,22,13,"PAH",242,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,60,22,13,"PAH",242,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",242,1,3,0)="HD206713  Activity Log issues"
^DIC(9.4,60,22,13,"PAH",242,1,4,0)="HD170652 - <UNDEFINED>PAT+1^PSOSD"
^DIC(9.4,60,22,13,"PAH",243,0)="292 SEQ #249^3080526.153436^1"
^DIC(9.4,60,22,13,"PAH",243,1,0)="^^26^26^3080526"
^DIC(9.4,60,22,13,"PAH",243,1,1,0)="PROBLEM:"
^DIC(9.4,60,22,13,"PAH",243,1,2,0)="--------"
^DIC(9.4,60,22,13,"PAH",243,1,3,0)="HD214867 - Renewed orders remaining active"
^DIC(9.4,60,22,13,"PAH",243,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",243,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",243,1,6,0)="PSI-06-177 - RENEWED ORDERS REMAINING ACTIVE"
^DIC(9.4,60,22,13,"PAH",243,1,7,0)="(Note: Other scenarios related to renewed orders are being corrected in"
^DIC(9.4,60,22,13,"PAH",243,1,8,0)="patch PSO*7*257)."
^DIC(9.4,60,22,13,"PAH",243,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",243,1,10,0)="1. If expiring or discontinuing a prescription that also has a pending"
^DIC(9.4,60,22,13,"PAH",243,1,11,0)="renewal, the ""renewed from"" CPRS order's status is changed to expired or"
^DIC(9.4,60,22,13,"PAH",243,1,12,0)="discontinued instead of staying as ""renewed""."
^DIC(9.4,60,22,13,"PAH",243,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",243,1,14,0)="2. If cancel a pending renewal for a previously expired (or "
^DIC(9.4,60,22,13,"PAH",243,1,15,0)="discontinued) prescription that had been renewed after expired, the "
^DIC(9.4,60,22,13,"PAH",243,1,16,0)="""renewed from"" CPRS order should go back to ""expired"" (or ""discontinued"")"
^DIC(9.4,60,22,13,"PAH",243,1,17,0)="instead of remaining as ""renewed""."
^DIC(9.4,60,22,13,"PAH",243,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",243,1,19,0)="RESOLUTION:"
^DIC(9.4,60,22,13,"PAH",243,1,20,0)="-----------"
^DIC(9.4,60,22,13,"PAH",243,1,21,0)="1. PSOHLSN1 - If  expiring or discontinuing a prescription that also has a"
^DIC(9.4,60,22,13,"PAH",243,1,22,0)="pending renewal, keep the ""renewed from"" CPRS order's status as ""renewed""."
^DIC(9.4,60,22,13,"PAH",243,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",243,1,24,0)="2. PSOHLSN: - If cancel a pending renewal for a previously expired (or "
^DIC(9.4,60,22,13,"PAH",243,1,25,0)="discontinued) prescription that had been renewed after expired (or "
^DIC(9.4,60,22,13,"PAH",243,1,26,0)="discontinued), set CPRS order's status back to expired (or discontinued)."
^DIC(9.4,60,22,13,"PAH",244,0)="275 SEQ #250^3080526.154011^1"
^DIC(9.4,60,22,13,"PAH",244,1,0)="^^6^6^3080526"
^DIC(9.4,60,22,13,"PAH",244,1,1,0)="Patch PSO*7.0*275 will correct the following issues"
^DIC(9.4,60,22,13,"PAH",244,1,2,0)="HD122245        Editing Provider Comments/patient instructions"
^DIC(9.4,60,22,13,"PAH",244,1,3,0)="        d-HD154492   Leading punctiation prevents editing Patient "
^DIC(9.4,60,22,13,"PAH",244,1,4,0)="                     Instructions"
^DIC(9.4,60,22,13,"PAH",244,1,5,0)="HD179234        Issue with selecting service related option."
^DIC(9.4,60,22,13,"PAH",244,1,6,0)="HD196315        Error - <UNDEFINED>SETNEW^PSOBINGO"
^DIC(9.4,60,22,13,"PAH",245,0)="302 SEQ #251^3080526.154959^1"
^DIC(9.4,60,22,13,"PAH",245,1,0)="^^1^1^3080526"
^DIC(9.4,60,22,13,"PAH",245,1,1,0)="Emergency patch to disable PSO SPEED RENEW PROTOCOL."
^DIC(9.4,60,22,13,"PAH",246,0)="257 SEQ #252^3080526.155323^1"
^DIC(9.4,60,22,13,"PAH",246,1,0)="^^109^109^3080526"
^DIC(9.4,60,22,13,"PAH",246,1,1,0)="This patch addresses PSI-06-177 - MED STATUS RENEWED PAST STOP DATE"
^DIC(9.4,60,22,13,"PAH",246,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,3,0)="This patch will modify the Manual Auto Expire Rxs [PSO MANUAL AUTO EXPIRE]"
^DIC(9.4,60,22,13,"PAH",246,1,4,0)="option and the Expire Prescriptions [PSO EXPIRE PRESCRIPTIONS] option to"
^DIC(9.4,60,22,13,"PAH",246,1,5,0)="check for more values of the STATUS field (#5) in the ORDER file (#100) in"
^DIC(9.4,60,22,13,"PAH",246,1,6,0)="the Computerized Patient Record System (CPRS) before deciding whether to "
^DIC(9.4,60,22,13,"PAH",246,1,7,0)="send the expire transaction. Before, the expire transaction was sent if "
^DIC(9.4,60,22,13,"PAH",246,1,8,0)="the STATUS field was ""ACTIVE"". This patch checks for the CPRS status not"
^DIC(9.4,60,22,13,"PAH",246,1,9,0)="being any of the following and if not, will send the expire transaction:"
^DIC(9.4,60,22,13,"PAH",246,1,10,0)="  DISCONTINUED"
^DIC(9.4,60,22,13,"PAH",246,1,11,0)="  CANCELLED"
^DIC(9.4,60,22,13,"PAH",246,1,12,0)="  DISCONTINUED/EDIT"
^DIC(9.4,60,22,13,"PAH",246,1,13,0)="  EXPIRED"
^DIC(9.4,60,22,13,"PAH",246,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,15,0)="This patch corrects an additional issue with mis-calculating the default "
^DIC(9.4,60,22,13,"PAH",246,1,16,0)="value for the start date prompt for the Manual Auto Expire Rxs [PSO MANUAL"
^DIC(9.4,60,22,13,"PAH",246,1,17,0)="AUTO EXPIRE] option. "
^DIC(9.4,60,22,13,"PAH",246,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,19,0)="This patch fixes an error received when running the Compile AMIS Data"
^DIC(9.4,60,22,13,"PAH",246,1,20,0)="(NIGHT JOB) [PSO AMIS COMPILE].  When the Expire Prescriptions [PSO EXPIRE"
^DIC(9.4,60,22,13,"PAH",246,1,21,0)="PRESCRIPTIONS] or Manual Auto Expire Rxs [PSO MANUAL AUTO EXPIRE] process"
^DIC(9.4,60,22,13,"PAH",246,1,22,0)="runs at the same time the CMOP transmission is running bad data can be"
^DIC(9.4,60,22,13,"PAH",246,1,23,0)="created.  The Expire Prescriptions and Manual Auto Expire Rxs processes"
^DIC(9.4,60,22,13,"PAH",246,1,24,0)="will delete the last refill data if the refill does not have a label"
^DIC(9.4,60,22,13,"PAH",246,1,25,0)="printed (CMOP fills do not have this) and does not have a Release"
^DIC(9.4,60,22,13,"PAH",246,1,26,0)="Date/Time which they do not if CMOP has not yet released the refill.  The"
^DIC(9.4,60,22,13,"PAH",246,1,27,0)="refill node is deleted and then when CMOP does release the refill it only"
^DIC(9.4,60,22,13,"PAH",246,1,28,0)="sets the Released Date/Time and Dispensed Date so this will be the only"
^DIC(9.4,60,22,13,"PAH",246,1,29,0)="data set for the refill which causes the error in the AMIS compile."
^DIC(9.4,60,22,13,"PAH",246,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,31,0)="=================="
^DIC(9.4,60,22,13,"PAH",246,1,32,0)="** IMPORTANT!! **:"
^DIC(9.4,60,22,13,"PAH",246,1,33,0)="================== "
^DIC(9.4,60,22,13,"PAH",246,1,34,0)="Please check that the nightly expire - PSO EXPIRE PRESCRIPTIONS job is"
^DIC(9.4,60,22,13,"PAH",246,1,35,0)="tasked to run on a 24 hour rescheduling frequency. This is very important,"
^DIC(9.4,60,22,13,"PAH",246,1,36,0)="as it relates to the HDR, because this job sets the status of a"
^DIC(9.4,60,22,13,"PAH",246,1,37,0)="prescription to Expired the day after the prescription expiration date,"
^DIC(9.4,60,22,13,"PAH",246,1,38,0)="and also updates CPRS and the HDR with this information. If this job is"
^DIC(9.4,60,22,13,"PAH",246,1,39,0)="not running, prescriptions could show as Active in the HDR, when the"
^DIC(9.4,60,22,13,"PAH",246,1,40,0)="expiration date is in the past."
^DIC(9.4,60,22,13,"PAH",246,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,42,0)="The job in TaskMan would look something like this:"
^DIC(9.4,60,22,13,"PAH",246,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,44,0)="2478948: PSO EXPIRE PRESCRIPTIONS - Expire Prescriptions.  No device."
^DIC(9.4,60,22,13,"PAH",246,1,45,0)="         CHYSQA,ROU.  From Today at 1:11,  By you.        Scheduled for "
^DIC(9.4,60,22,13,"PAH",246,1,46,0)="Today at 23:00"
^DIC(9.4,60,22,13,"PAH",246,1,47,0)="  "
^DIC(9.4,60,22,13,"PAH",246,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,50,0)="Please check to see if this job is tasked to run on a 24 hour "
^DIC(9.4,60,22,13,"PAH",246,1,51,0)="rescheduling frequency. To access the set-up of this job in Outpatient "
^DIC(9.4,60,22,13,"PAH",246,1,52,0)="Pharmacy, follow these steps:"
^DIC(9.4,60,22,13,"PAH",246,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,54,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,55,0)="Begin Capture **********"
^DIC(9.4,60,22,13,"PAH",246,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,58,0)="Select OPTION NAME: PSO MANAGER       Outpatient Pharmacy Manager"
^DIC(9.4,60,22,13,"PAH",246,1,59,0)="Outpatient Pharmacy software - Version 7.0"
^DIC(9.4,60,22,13,"PAH",246,1,60,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,61,0)="Division:    ALBANY  500 "
^DIC(9.4,60,22,13,"PAH",246,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,63,0)="          You are logged on under the ALBANY division."
^DIC(9.4,60,22,13,"PAH",246,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,65,0)="Select PROFILE PRINTER: HOME//   COMPUTER ROOM"
^DIC(9.4,60,22,13,"PAH",246,1,66,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,67,0)="Select LABEL PRINTER: HOME//   COMPUTER ROOM"
^DIC(9.4,60,22,13,"PAH",246,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,69,0)="OK to assume label alignment is correct? YES// "
^DIC(9.4,60,22,13,"PAH",246,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,71,0)="Bingo Board Display: OUTPATIENT//   "
^DIC(9.4,60,22,13,"PAH",246,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,74,0)="Select Outpatient Pharmacy Manager Option: MAintenance (Outpatient "
^DIC(9.4,60,22,13,"PAH",246,1,75,0)="Pharmacy)"
^DIC(9.4,60,22,13,"PAH",246,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,77,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,78,0)="Select Maintenance (Outpatient Pharmacy) Option: EXPire Prescriptions"
^DIC(9.4,60,22,13,"PAH",246,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,80,0)="NOTE:"
^DIC(9.4,60,22,13,"PAH",246,1,81,0)="(The only fields that need to be filled in are the  ""QUEUED TO RUN AT "
^DIC(9.4,60,22,13,"PAH",246,1,82,0)="WHAT TIME"" field to what time you want the job to run,  and the "
^DIC(9.4,60,22,13,"PAH",246,1,83,0)="""RESCHEDULING FREQUENCY"" field, which should be set to 24H.)"
^DIC(9.4,60,22,13,"PAH",246,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",246,1,85,0)="                          Edit Option Schedule"
^DIC(9.4,60,22,13,"PAH",246,1,86,0)="    Option Name: PSO EXPIRE PRESCRIPTIONS      "
^DIC(9.4,60,22,13,"PAH",246,1,87,0)="    Menu Text: Expire Prescriptions                      TASK ID: 74539  "
