^DIC(9.4,100,22,15,"PAH",45,1,100,0)="   SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",45,1,101,0)="   ==================="
^DIC(9.4,100,22,15,"PAH",45,1,102,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,103,0)="   The following software and documentation files are exported as part"
^DIC(9.4,100,22,15,"PAH",45,1,104,0)="   of this patch:"
^DIC(9.4,100,22,15,"PAH",45,1,105,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,106,0)="    File Name                     Contents             Retrieval Format"
^DIC(9.4,100,22,15,"PAH",45,1,107,0)="    ---------                     --------             ----------------"
^DIC(9.4,100,22,15,"PAH",45,1,108,0)="    YS_501_71.KID                 DG*5.3*447           ASCII"
^DIC(9.4,100,22,15,"PAH",45,1,109,0)="                                  SD*5.3*262"
^DIC(9.4,100,22,15,"PAH",45,1,110,0)="                                  XU*8*234"
^DIC(9.4,100,22,15,"PAH",45,1,111,0)="                                  YS*5.01*71"
^DIC(9.4,100,22,15,"PAH",45,1,112,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,113,0)="    Note: Please refer to the DG, SD, and XU informational patch"
^DIC(9.4,100,22,15,"PAH",45,1,114,0)="          descriptions for details on second line, checksums, and patch"
^DIC(9.4,100,22,15,"PAH",45,1,115,0)="          information."
^DIC(9.4,100,22,15,"PAH",45,1,116,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,117,0)="    YS50171_Setup_123.EXE         Mental Health Assistant  BINARY"
^DIC(9.4,100,22,15,"PAH",45,1,118,0)="                                  This file is the complete install"
^DIC(9.4,100,22,15,"PAH",45,1,119,0)="                                  for the Mental Health Assistant"
^DIC(9.4,100,22,15,"PAH",45,1,120,0)="                                  GUI client."
^DIC(9.4,100,22,15,"PAH",45,1,121,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,122,0)="    YS50171_MHA_IG.PDF      YS*5.01*71 MHA Installation Guide"
^DIC(9.4,100,22,15,"PAH",45,1,123,0)="    YS50171_MHA_IG.DOC      YS*5.01*71 MHA Installation Guide"
^DIC(9.4,100,22,15,"PAH",45,1,124,0)="    YS50171_MHA_UM.PDF      YS*5.01*71 MHA User Manual"
^DIC(9.4,100,22,15,"PAH",45,1,125,0)="    YS50171_MHA_UM.DOC      YS*5.01*71 MHA User Manual"
^DIC(9.4,100,22,15,"PAH",45,1,126,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,127,0)="   The software files are available on the following OI Field Offices'"
^DIC(9.4,100,22,15,"PAH",45,1,128,0)="   ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",45,1,129,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,130,0)="   All sites are encouraged to use their FTP capability to obtain these"
^DIC(9.4,100,22,15,"PAH",45,1,131,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",45,1,132,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",45,1,133,0)="   are located."
^DIC(9.4,100,22,15,"PAH",45,1,134,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,135,0)="    OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,100,22,15,"PAH",45,1,136,0)="    ===============    ===========                ========="
^DIC(9.4,100,22,15,"PAH",45,1,137,0)="    ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",45,1,138,0)="    HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",45,1,139,0)="    SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",45,1,140,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,141,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,142,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",45,1,143,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",45,1,144,0)="   1. Use the 'LOAD A DISTRIBUTION' option on the PackMan menu. The"
^DIC(9.4,100,22,15,"PAH",45,1,145,0)="      Host File name is YS_501_71.KID.  Answer YES to the question:"
^DIC(9.4,100,22,15,"PAH",45,1,146,0)="      ""Want to Continue with Load? YES//"""
^DIC(9.4,100,22,15,"PAH",45,1,147,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,148,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,149,0)="   2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",45,1,150,0)="      system. You now need to install the Transport global. "
^DIC(9.4,100,22,15,"PAH",45,1,151,0)="      On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,100,22,15,"PAH",45,1,152,0)="      following options:"
^DIC(9.4,100,22,15,"PAH",45,1,153,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,154,0)="         Print Transport Global"
^DIC(9.4,100,22,15,"PAH",45,1,155,0)="         Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",45,1,156,0)="         Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",45,1,157,0)="         Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",45,1,158,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,159,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,160,0)="   3. Users may remain on the system, but installation should be done "
^DIC(9.4,100,22,15,"PAH",45,1,161,0)="      at off peak hours."
^DIC(9.4,100,22,15,"PAH",45,1,162,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,163,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,164,0)="   4. Installation will take less than five minutes. "
^DIC(9.4,100,22,15,"PAH",45,1,165,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,166,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,167,0)="   5. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",45,1,168,0)="      'Install Package(s)' Select the package 'MHA GUI YS*5.01*71'"
^DIC(9.4,100,22,15,"PAH",45,1,169,0)="      and proceed with install."
^DIC(9.4,100,22,15,"PAH",45,1,170,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,171,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,172,0)="   6. If you do not intend to queue the installation to run after "
^DIC(9.4,100,22,15,"PAH",45,1,173,0)="      normal business hours, then answer ""NO"" to the following prompt:"
^DIC(9.4,100,22,15,"PAH",45,1,174,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,175,0)="  Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,100,22,15,"PAH",45,1,176,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,177,0)="      If you answer ""YES"", then the installation will require much more "
^DIC(9.4,100,22,15,"PAH",45,1,178,0)="      than 5 minutes to run due to the menu rebuild process."
^DIC(9.4,100,22,15,"PAH",45,1,179,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,180,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,181,0)="   7. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",45,1,182,0)="      install//', respond NO."
^DIC(9.4,100,22,15,"PAH",45,1,183,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,100,22,15,"PAH",45,1,184,0)="      and Protocols? YES//', respond NO."
^DIC(9.4,100,22,15,"PAH",45,1,185,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,186,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,187,0)="   8. Retrieve and execute the file YS50171_Setup_123.EXE"
^DIC(9.4,100,22,15,"PAH",45,1,188,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,189,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,190,0)="   9. Place the MENTAL HEALTH ASSISTANT USER MANUAL in a location that "
^DIC(9.4,100,22,15,"PAH",45,1,191,0)="      can be accessed by MHA users."
^DIC(9.4,100,22,15,"PAH",45,1,192,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,193,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,194,0)="  10. Please refer to the POST INSTALLATION INSTRUCTIONS section of the "
^DIC(9.4,100,22,15,"PAH",45,1,195,0)="      MENTAL HEALTH ASSISTANT INSTALLATION GUIDE to install the MHA "
^DIC(9.4,100,22,15,"PAH",45,1,196,0)="      software."
^DIC(9.4,100,22,15,"PAH",45,1,197,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,198,0)="  11. Place the option YS BROKER1 [YS BROKER1] on the Mental Health "
^DIC(9.4,100,22,15,"PAH",45,1,199,0)="      users secondary menu."
^DIC(9.4,100,22,15,"PAH",46,0)="74 SEQ #65^3030204^1"
^DIC(9.4,100,22,15,"PAH",46,1,0)="^^147^147^3030204"
^DIC(9.4,100,22,15,"PAH",46,1,1,0)=" The Clozapine reporting software will automatically discontinue a "
^DIC(9.4,100,22,15,"PAH",46,1,2,0)="patient if the patient's prescription is over 28 days old.  This prevents "
^DIC(9.4,100,22,15,"PAH",46,1,3,0)="a patient from being issued medication on an expired prescription.  The "
^DIC(9.4,100,22,15,"PAH",46,1,4,0)="Clozapine protocol requires a new prescription each time the medication "
^DIC(9.4,100,22,15,"PAH",46,1,5,0)="is dispensed.  Clozapine patients are being discontinued whose "
^DIC(9.4,100,22,15,"PAH",46,1,6,0)="prescriptions are current.  This happens when the roll-up occurs between "
^DIC(9.4,100,22,15,"PAH",46,1,7,0)="the time when the prescription is entered into the system and when it is "
^DIC(9.4,100,22,15,"PAH",46,1,8,0)="dispensed.  This patch will prevent the patient from being discontinued "
^DIC(9.4,100,22,15,"PAH",46,1,9,0)="until the prescription is 28 days past the fill date."
^DIC(9.4,100,22,15,"PAH",46,1,10,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,11,0)=" Clozapine data is transmitted to the field offices in Hines and Dallas.  "
^DIC(9.4,100,22,15,"PAH",46,1,12,0)="The domain names have been changed from ISC-DALLAS.DOMAIN.EXT and "
^DIC(9.4,100,22,15,"PAH",46,1,13,0)="ISC-CHICAGO.DOMAIN.EXT to FO-DALLAS.DOMAIN.EXT and FO-HINES.DOMAIN.EXT."
^DIC(9.4,100,22,15,"PAH",46,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,15,0)="THIS PATCH WILL REPORT THE NEW RACE AND ETHNICITY ENTRIES TO THE NATIONAL "
^DIC(9.4,100,22,15,"PAH",46,1,16,0)="CLOZAPINE DATABASE."
^DIC(9.4,100,22,15,"PAH",46,1,17,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,18,0)="INSTALLATION TIME FRAME : VA DIRECTIVE 2001-023 REQUIRES INSTALLATION OF "
^DIC(9.4,100,22,15,"PAH",46,1,19,0)="THIS PATCH WITHIN 30 DAYS FROM THE TIME OF INITIAL RELEASE."
^DIC(9.4,100,22,15,"PAH",46,1,20,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,21,0)=" Requesting Site: National Clozapine Coordinating Center"
^DIC(9.4,100,22,15,"PAH",46,1,22,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,23,0)="    Test Site(s): Coatesville"
^DIC(9.4,100,22,15,"PAH",46,1,24,0)="                  Boston"
^DIC(9.4,100,22,15,"PAH",46,1,25,0)="                  Madison"
^DIC(9.4,100,22,15,"PAH",46,1,26,0)="                  Portland"
^DIC(9.4,100,22,15,"PAH",46,1,27,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,28,0)="Reference NOIS:   COA-0901-21209     CLOZAPINE PATIENTS INACTIVATED"
^DIC(9.4,100,22,15,"PAH",46,1,29,0)="                       I've been informed by Pharmacy service that we"
^DIC(9.4,100,22,15,"PAH",46,1,30,0)="                       continue to have Clozapine patients being"
^DIC(9.4,100,22,15,"PAH",46,1,31,0)="                       automatically inactivated (details can be"
^DIC(9.4,100,22,15,"PAH",46,1,32,0)="                       provided). We have previously worked with"
^DIC(9.4,100,22,15,"PAH",46,1,33,0)="                       Stephanie Todd from Dallas on specific problems,"
^DIC(9.4,100,22,15,"PAH",46,1,34,0)="                       however, NOIS BAC-0701-40194 notes in response"
^DIC(9.4,100,22,15,"PAH",46,1,35,0)="                       #22 that a patch is forthcoming."
^DIC(9.4,100,22,15,"PAH",46,1,36,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,37,0)="                  BAC-0701-40194     Random inactivation of clozapine"
^DIC(9.4,100,22,15,"PAH",46,1,38,0)="                                     pts"
^DIC(9.4,100,22,15,"PAH",46,1,39,0)="                       Our pharmacy ADPAC has been reporting for awhile"
^DIC(9.4,100,22,15,"PAH",46,1,40,0)="                       about Clozapine patients being inactivated."
^DIC(9.4,100,22,15,"PAH",46,1,41,0)="                       I initially held off reporting this via NOIS"
^DIC(9.4,100,22,15,"PAH",46,1,42,0)="                       because I knew that PSO*7*56 was going to"
^DIC(9.4,100,22,15,"PAH",46,1,43,0)="                       address these problem previously reported by"
^DIC(9.4,100,22,15,"PAH",46,1,44,0)="                       other sites. We installed it in March, but it's"
^DIC(9.4,100,22,15,"PAH",46,1,45,0)="                       happened again randomly.  This time I had the"
^DIC(9.4,100,22,15,"PAH",46,1,46,0)="                       adpac report the patients name to me so that I"
^DIC(9.4,100,22,15,"PAH",46,1,47,0)="                       can begin to look at it."
^DIC(9.4,100,22,15,"PAH",46,1,48,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,49,0)="                  BHS-0302-12595     Cloz trans failed"
^DIC(9.4,100,22,15,"PAH",46,1,50,0)="                  MAD-0402-41028     Clozapine transmission failed"
^DIC(9.4,100,22,15,"PAH",46,1,51,0)="                       Both NOIS calls report an undefined error during"
^DIC(9.4,100,22,15,"PAH",46,1,52,0)="                       data transmission.  The reporting mechanism has"
^DIC(9.4,100,22,15,"PAH",46,1,53,0)="                       been modified to prevent this error."
^DIC(9.4,100,22,15,"PAH",46,1,54,0)="                  UNY-0402-11524     CLOZARIL PATIENTS STILL BEING"
^DIC(9.4,100,22,15,"PAH",46,1,55,0)="                                     INACTIVATED"
^DIC(9.4,100,22,15,"PAH",46,1,56,0)="                       I still have complaints of patients being"
^DIC(9.4,100,22,15,"PAH",46,1,57,0)="                       inactivated for some reason and the pharmacy"
^DIC(9.4,100,22,15,"PAH",46,1,58,0)="                       needs to activate each time before entering"
^DIC(9.4,100,22,15,"PAH",46,1,59,0)="                       clozaril scripts.  The local site has contacted"
^DIC(9.4,100,22,15,"PAH",46,1,60,0)="                       the NCCC and they just tell them to re-activate"
^DIC(9.4,100,22,15,"PAH",46,1,61,0)="                       and there is nothing wrong on their end."
^DIC(9.4,100,22,15,"PAH",46,1,62,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,63,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,64,0)="  ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",46,1,65,0)="  ================"
^DIC(9.4,100,22,15,"PAH",46,1,66,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,67,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,100,22,15,"PAH",46,1,68,0)="  of each of these routines now looks like:"
^DIC(9.4,100,22,15,"PAH",46,1,69,0)="  <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30,1994"
^DIC(9.4,100,22,15,"PAH",46,1,70,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,71,0)="                              Checksum Values"
^DIC(9.4,100,22,15,"PAH",46,1,72,0)=" "
^DIC(9.4,100,22,15,"PAH",46,1,73,0)="  Routine Name      Before Patch         After Patch     Patch List"
^DIC(9.4,100,22,15,"PAH",46,1,74,0)="  ------------      ------------         -----------     ----------"
^DIC(9.4,100,22,15,"PAH",46,1,75,0)=" "
