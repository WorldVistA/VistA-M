^DIC(9.4,230,22,1,"PAH",1,1,1,0)="Enterprise Terminology Services 1.0 - LOINC Database Definitions and "
^DIC(9.4,230,22,1,"PAH",1,1,2,0)="routines"
^DIC(9.4,230,22,1,"PAH",2,0)="1^3171005.230042^54"
