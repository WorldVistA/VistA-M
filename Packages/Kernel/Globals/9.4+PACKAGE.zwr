^DIC(9.4,175,22,2,"PAH",136,1,1,0)="MAG*3.0*188"
^DIC(9.4,175,22,2,"PAH",136,1,2,0)="This patch will resolve the following issues for Clinical Display:"
^DIC(9.4,175,22,2,"PAH",136,1,3,0)="The ability to Show or Hide the Grid on the EKG Display and "
^DIC(9.4,175,22,2,"PAH",136,1,4,0)="while printing."
^DIC(9.4,175,22,2,"PAH",136,1,5,0)="The ability to select multiple EKG's for display and printing."
^DIC(9.4,175,22,2,"PAH",136,1,6,0)="The ability for a site to change the Format ID that is used"
^DIC(9.4,175,22,2,"PAH",136,1,7,0)="to generate the EKG Image."
^DIC(9.4,175,22,2,"PAH",136,1,8,0)="CT scrolling issue in the Radiology Viewer."
^DIC(9.4,175,22,2,"PAH",136,1,9,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",136,1,10,0)="Select BUILD NAME:    MAG*3.0*188     IMAGING"
