^DIC(9.4,176,"VERSION")="1.0"
^DIC(9.4,177,0)="BAR CODE MED ADMIN^PSB^BAR CODE MEDICATION ADMINISTRATION"
^DIC(9.4,177,20,0)="^9.402P^^"
^DIC(9.4,177,22,0)="^9.49I^3^3"
^DIC(9.4,177,22,1,0)="1.0^2990806^2990914^1"
^DIC(9.4,177,22,1,1,0)="^^1^1^2990914"
^DIC(9.4,177,22,1,1,1,0)="BAR CODE MED ADMIN - VERSION 1.0"
^DIC(9.4,177,22,1,"PAH",0)="^9.4901^14^14"
^DIC(9.4,177,22,1,"PAH",1,0)="1 SEQ #1^2990914^1"
^DIC(9.4,177,22,1,"PAH",1,1,0)="^^7^7^2990914"
^DIC(9.4,177,22,1,"PAH",1,1,1,0)="This patch addresses the issue of one-time meds showing up on the Virtual"
^DIC(9.4,177,22,1,"PAH",1,1,2,0)="Due List from previous movements and even previous admission.  As released"
^DIC(9.4,177,22,1,"PAH",1,1,3,0)="the VDL will search back 30 days for one-time orders and display them on"
^DIC(9.4,177,22,1,"PAH",1,1,4,0)="the VDL if there is no associated administration in the BCMA medication"
^DIC(9.4,177,22,1,"PAH",1,1,5,0)="log.  With this patch the VDL will now only go back as far as the current"
^DIC(9.4,177,22,1,"PAH",1,1,6,0)="movement eliminating one-time orders from showing up from previous"
^DIC(9.4,177,22,1,"PAH",1,1,7,0)="movements and admissions."
^DIC(9.4,177,22,1,"PAH",2,0)="2 SEQ #2^2991210^1"
^DIC(9.4,177,22,1,"PAH",2,1,0)="^^31^31^2991210"
^DIC(9.4,177,22,1,"PAH",2,1,1,0)=" Y2K Waiver Request ID#:  Y2KW0001        Y2K Waiver Status: Approved"
^DIC(9.4,177,22,1,"PAH",2,1,2,0)="        This patch may be installed during the Y2K Moratorium, either"
^DIC(9.4,177,22,1,"PAH",2,1,3,0)="        BEFORE 12/15/99 or AFTER 1/15/2000."
^DIC(9.4,177,22,1,"PAH",2,1,4,0)="        This patch MAY NOT be installed between 12/15/1999 and 1/15/2000"
^DIC(9.4,177,22,1,"PAH",2,1,5,0)="        (the Y2K Lockdown Period)."
^DIC(9.4,177,22,1,"PAH",2,1,6,0)=" "
^DIC(9.4,177,22,1,"PAH",2,1,7,0)=" This patch contains 3 improvements."
^DIC(9.4,177,22,1,"PAH",2,1,8,0)=" "
^DIC(9.4,177,22,1,"PAH",2,1,9,0)=" 1. Sites that are scheduled to integrate with a primary site can begin"
^DIC(9.4,177,22,1,"PAH",2,1,10,0)=" printing the station number in front of the Internal Entry Number (IEN)"
^DIC(9.4,177,22,1,"PAH",2,1,11,0)=" on the ZEBRA barcode labels.  As released labels would print only the"
^DIC(9.4,177,22,1,"PAH",2,1,12,0)=" IEN as a barcode for the selected medication. After this patch labels"
^DIC(9.4,177,22,1,"PAH",2,1,13,0)=" will be formatted as SiteNumber-IEN if the parameter PSB DEFAULT BARCODE"
^DIC(9.4,177,22,1,"PAH",2,1,14,0)=" SITE is set to yes."
^DIC(9.4,177,22,1,"PAH",2,1,15,0)=" "
^DIC(9.4,177,22,1,"PAH",2,1,16,0)=" 2. Use a different server name for the monthly SAGG reporting. Sites will"
^DIC(9.4,177,22,1,"PAH",2,1,17,0)=" notice no change with the SAGG update."
^DIC(9.4,177,22,1,"PAH",2,1,18,0)=" "
^DIC(9.4,177,22,1,"PAH",2,1,19,0)="   Old Server: KMP1-BCMA-SERVER@ISC-ALBANY.DOMAIN.EXT"
^DIC(9.4,177,22,1,"PAH",2,1,20,0)="   New Server: KMP90-BCMA-SERVER@ISC-ALBANY.DOMAIN.EXT"
^DIC(9.4,177,22,1,"PAH",2,1,21,0)=" "
^DIC(9.4,177,22,1,"PAH",2,1,22,0)=" 3. Further enhancements were done so the One-Time medications do not "
^DIC(9.4,177,22,1,"PAH",2,1,23,0)=" appear on the Virtual Due List by discontinuing the order without having"
^DIC(9.4,177,22,1,"PAH",2,1,24,0)=" to mark the order as 'Do Not Give'."
^DIC(9.4,177,22,1,"PAH",2,1,25,0)=" "
^DIC(9.4,177,22,1,"PAH",2,1,26,0)=" *************************************************************************"
^DIC(9.4,177,22,1,"PAH",2,1,27,0)=" NOTICE: This patch is released prior to a Y2K Waiver and can only be"
^DIC(9.4,177,22,1,"PAH",2,1,28,0)=" installed in a TEST environment until a waiver is received.  Upon"
^DIC(9.4,177,22,1,"PAH",2,1,29,0)=" granting of the waiver a message will be sent to all sites informing them"
^DIC(9.4,177,22,1,"PAH",2,1,30,0)=" that this patch may be moved to live."
^DIC(9.4,177,22,1,"PAH",2,1,31,0)=" *************************************************************************"
^DIC(9.4,177,22,1,"PAH",3,0)="3 SEQ #3^3000229^1"
^DIC(9.4,177,22,1,"PAH",3,1,0)="^^42^42^3000229"
^DIC(9.4,177,22,1,"PAH",3,1,1,0)="Y2K Waiver Request ID#:  Y2KW0001        Y2K Waiver Status: Approved"
^DIC(9.4,177,22,1,"PAH",3,1,2,0)="        This patch may be installed during the Y2K Moratorium, either"
^DIC(9.4,177,22,1,"PAH",3,1,3,0)="        BEFORE 12/15/99 or AFTER 1/15/2000."
^DIC(9.4,177,22,1,"PAH",3,1,4,0)="Patch PSB*1.0*3 contains the following fixes:"
^DIC(9.4,177,22,1,"PAH",3,1,5,0)=" 1. Problem: Orphan jobs were left running due to a disconnect in"
^DIC(9.4,177,22,1,"PAH",3,1,6,0)="    communication between the server and client."
^DIC(9.4,177,22,1,"PAH",3,1,7,0)="    "
^DIC(9.4,177,22,1,"PAH",3,1,8,0)="    Corrective Action: Incorporate RPC Broker patch XWB*1.1*6 to allow"
^DIC(9.4,177,22,1,"PAH",3,1,9,0)="    orphan jobs to die."
^DIC(9.4,177,22,1,"PAH",3,1,10,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,11,0)=" 2. Problem: User input dates in VA Fileman format not accepted by BCMA."
^DIC(9.4,177,22,1,"PAH",3,1,12,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,13,0)="    Corrective Action: BCMA was modified to accept and store user inputted"
^DIC(9.4,177,22,1,"PAH",3,1,14,0)="    dates in a VA Fileman format."
^DIC(9.4,177,22,1,"PAH",3,1,15,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,16,0)=" 3. Problem: The administration times report on the GUI Virtual Due List"
^DIC(9.4,177,22,1,"PAH",3,1,17,0)="    will only display a 24 hour period, even if a time range is selected."
^DIC(9.4,177,22,1,"PAH",3,1,18,0)="  "
^DIC(9.4,177,22,1,"PAH",3,1,19,0)="    Corrective Action: The administration times report on the GUI Virtual"
^DIC(9.4,177,22,1,"PAH",3,1,20,0)="    Due List was made consistent to the administration times report on the"
^DIC(9.4,177,22,1,"PAH",3,1,21,0)="    CHUI by removing the administration time fields."
^DIC(9.4,177,22,1,"PAH",3,1,22,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,23,0)=" 4. If BCMA has been designated to be used for QA and testing purposes"
^DIC(9.4,177,22,1,"PAH",3,1,24,0)="    only, a notification will be displayed when starting BCMA."
^DIC(9.4,177,22,1,"PAH",3,1,25,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,26,0)=" 5. Problem: If the Client/Server clock variance was greater than the"
^DIC(9.4,177,22,1,"PAH",3,1,27,0)="    acceptable limit defined in the PSB Parameters, the Virtual Due List"
^DIC(9.4,177,22,1,"PAH",3,1,28,0)="    would display the PC time."
^DIC(9.4,177,22,1,"PAH",3,1,29,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,30,0)="    Corrective Action: Server/Client clock variance corrected to display"
^DIC(9.4,177,22,1,"PAH",3,1,31,0)="    server time."
^DIC(9.4,177,22,1,"PAH",3,1,32,0)=" "
^DIC(9.4,177,22,1,"PAH",3,1,33,0)=" 6. Required functionality added: Means Test Check Alert."
^DIC(9.4,177,22,1,"PAH",3,1,34,0)="   "
^DIC(9.4,177,22,1,"PAH",3,1,35,0)=" 7. Mandatory Security Check - The Director, Health Information Management "
^DIC(9.4,177,22,1,"PAH",3,1,36,0)="Headquarters, and VA General Counsel have requested modifications to patient"
^DIC(9.4,177,22,1,"PAH",3,1,37,0)="look-up functionality in VistA.  This request results from a grievance filed by"
^DIC(9.4,177,22,1,"PAH",3,1,38,0)="employees that cites non-compliance with the Employee Privacy Act System of"
^DIC(9.4,177,22,1,"PAH",3,1,39,0)="Records.  The citation states that employee Social Security Number(SSN) and"
^DIC(9.4,177,22,1,"PAH",3,1,40,0)="Date of Birth (DOB) data is presented without soliciting the information from"
^DIC(9.4,177,22,1,"PAH",3,1,41,0)="the system and without notification to appropriate site personnel that this"
^DIC(9.4,177,22,1,"PAH",3,1,42,0)="information has been accessed."
^DIC(9.4,177,22,1,"PAH",4,0)="4 SEQ #4^3000417^1"
^DIC(9.4,177,22,1,"PAH",4,1,0)="^^120^120^3000417"
^DIC(9.4,177,22,1,"PAH",4,1,1,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,2,0)="Patch PSB*1.0*4 contains the following fixes:"
^DIC(9.4,177,22,1,"PAH",4,1,3,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,4,0)="1. Problem: An undefined error was generated when running the Medication"
^DIC(9.4,177,22,1,"PAH",4,1,5,0)="   Administration History (MAH) report."
^DIC(9.4,177,22,1,"PAH",4,1,6,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,7,0)="   Corrective Action: The BCMA Software was corrected to not pass an"
^DIC(9.4,177,22,1,"PAH",4,1,8,0)="   undefined variable, thus not generate an error."
^DIC(9.4,177,22,1,"PAH",4,1,9,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,10,0)="2. Problem: The Missed Medications [PSBO MM] option does not print"
^DIC(9.4,177,22,1,"PAH",4,1,11,0)="   one-time orders."
^DIC(9.4,177,22,1,"PAH",4,1,12,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,13,0)="   Corrective Action: The Missed Medications [PSBO MM] option will"
^DIC(9.4,177,22,1,"PAH",4,1,14,0)="   now print missed one-time orders on the report."
^DIC(9.4,177,22,1,"PAH",4,1,15,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,16,0)="3. Problem: The stop date on the Due List is not recognized when a date is"
^DIC(9.4,177,22,1,"PAH",4,1,17,0)="   entered."
^DIC(9.4,177,22,1,"PAH",4,1,18,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,19,0)="   Corrective Action: The Stop Date prompt has been removed from the Due"
^DIC(9.4,177,22,1,"PAH",4,1,20,0)="   List."
^DIC(9.4,177,22,1,"PAH",4,1,21,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,22,0)="4. Problem: BCMA did not accept a dosage which contained decimals"
^DIC(9.4,177,22,1,"PAH",4,1,23,0)="   (i.e.,0.01)"
^DIC(9.4,177,22,1,"PAH",4,1,24,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,25,0)="   Corrective Action: BCMA has been corrected to accept a dosage which"
^DIC(9.4,177,22,1,"PAH",4,1,26,0)="   contains a decimal."
^DIC(9.4,177,22,1,"PAH",4,1,27,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,28,0)="5. Problem: Medications marked as ""Do not give"" and ""Discontinued"" are"
^DIC(9.4,177,22,1,"PAH",4,1,29,0)="   printing on the Due List."
^DIC(9.4,177,22,1,"PAH",4,1,30,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,31,0)="   Corrective Action: Medications marked as ""Do not give"" and"
^DIC(9.4,177,22,1,"PAH",4,1,32,0)="   ""Discontinued"" will no longer print on the Due List."
^DIC(9.4,177,22,1,"PAH",4,1,33,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,34,0)="6. Problem: When on-call's are chosen to print on  the Due List the"
^DIC(9.4,177,22,1,"PAH",4,1,35,0)="   report would print one-times. When one-times are chosen"
^DIC(9.4,177,22,1,"PAH",4,1,36,0)="   the report would print on-call's."
^DIC(9.4,177,22,1,"PAH",4,1,37,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,38,0)="   Corrective Action: The Due List will now properly print one-times"
^DIC(9.4,177,22,1,"PAH",4,1,39,0)="   and on-call's."
^DIC(9.4,177,22,1,"PAH",4,1,40,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,41,0)="7. Problem: The user is unable to document the administration of a"
^DIC(9.4,177,22,1,"PAH",4,1,42,0)="   one-time order through the Manual Medication Entry"
^DIC(9.4,177,22,1,"PAH",4,1,43,0)="   [PSB MED LOG ENTRY] option."
^DIC(9.4,177,22,1,"PAH",4,1,44,0)="   The  message ""Error: OKAY to give"" 'press return to  continue or"
^DIC(9.4,177,22,1,"PAH",4,1,45,0)="   ^ to exit', would display. No further action can be taken"
^DIC(9.4,177,22,1,"PAH",4,1,46,0)="   at this point."
^DIC(9.4,177,22,1,"PAH",4,1,47,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,48,0)="   Corrective Action: One-time orders can now be properly documented"
^DIC(9.4,177,22,1,"PAH",4,1,49,0)="   through the Manual Medication Entry [PSB MED LOG ENTRY] option."
^DIC(9.4,177,22,1,"PAH",4,1,50,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,51,0)="8. Problem: Within the Edit Divisional Parameters [PSB PARAMETERS] option,"
^DIC(9.4,177,22,1,"PAH",4,1,52,0)="   ""Allowed Mins Before Sched Admin"" would allow the administration of a"
^DIC(9.4,177,22,1,"PAH",4,1,53,0)="   medication to be administered based on the minutes prior to an"
^DIC(9.4,177,22,1,"PAH",4,1,54,0)="   ""Administration Time."""
^DIC(9.4,177,22,1,"PAH",4,1,55,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,56,0)="   Corrective Action: The functionality of the question has been changed"
^DIC(9.4,177,22,1,"PAH",4,1,57,0)="   to allow the administration of a medication based on the number"
^DIC(9.4,177,22,1,"PAH",4,1,58,0)="   of minutes prior to the ""active time"" of an order."
^DIC(9.4,177,22,1,"PAH",4,1,59,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,60,0)="9. Problem: Within the Edit Log Medication [PSB MED LOG EDIT] option ,"
^DIC(9.4,177,22,1,"PAH",4,1,61,0)="   a nurse was unable to edit his or her own administration record if"
^DIC(9.4,177,22,1,"PAH",4,1,62,0)="   another nurse made an entry to that medication."
^DIC(9.4,177,22,1,"PAH",4,1,63,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,64,0)="   Corrective Action: The Edit Log Medication [PSB MED LOG EDIT] option"
^DIC(9.4,177,22,1,"PAH",4,1,65,0)="   has been modified to allow a nurse to edit his or her own"
^DIC(9.4,177,22,1,"PAH",4,1,66,0)="   administration entries."
^DIC(9.4,177,22,1,"PAH",4,1,67,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,68,0)="10. Problem: Within the Edit Divisional Parameters [PSB PARAMETERS] option"
^DIC(9.4,177,22,1,"PAH",4,1,69,0)="    the user was not able to determine which division they had signed on"
^DIC(9.4,177,22,1,"PAH",4,1,70,0)="    too."
^DIC(9.4,177,22,1,"PAH",4,1,71,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,72,0)="    Corrective Action: The Edit Divisional Parameters [PSB PARAMETERS]"
^DIC(9.4,177,22,1,"PAH",4,1,73,0)="    option will now see the following message displayed: ""You are"
^DIC(9.4,177,22,1,"PAH",4,1,74,0)="    currently logged onto Division: XXX"", with XXX being the division"
^DIC(9.4,177,22,1,"PAH",4,1,75,0)="    you are logged onto."
^DIC(9.4,177,22,1,"PAH",4,1,76,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,77,0)="11. Problem: On the GUI Virtual Due List (VDL) when the nurse administers"
^DIC(9.4,177,22,1,"PAH",4,1,78,0)="    a PRN medication, the previous four PRN administrations are displayed"
^DIC(9.4,177,22,1,"PAH",4,1,79,0)="    with the  message ""Okay to administer - Brief Administration History"""
^DIC(9.4,177,22,1,"PAH",4,1,80,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,81,0)="    Corrective Action: The display message has been changed to now read"
^DIC(9.4,177,22,1,"PAH",4,1,82,0)="    ""Brief Administration History""."
^DIC(9.4,177,22,1,"PAH",4,1,83,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,84,0)="12. Problem: On-call and PRNs medications would display on the GUI VDL"
^DIC(9.4,177,22,1,"PAH",4,1,85,0)="    even if they were not active."
^DIC(9.4,177,22,1,"PAH",4,1,86,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,87,0)="    Corrective Action: The GUI VDL will not display an on-call or PRN"
^DIC(9.4,177,22,1,"PAH",4,1,88,0)="    order until it has become active."
^DIC(9.4,177,22,1,"PAH",4,1,89,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,90,0)="13. Problem: Within the Label Print [PSBO BL] and Drug File Inquiry"
^DIC(9.4,177,22,1,"PAH",4,1,91,0)="    [PSB DRUG INQUIRY] options, the Drug selection would allow the display"
^DIC(9.4,177,22,1,"PAH",4,1,92,0)="    and selection of inactive drugs and those marked for other packages."
^DIC(9.4,177,22,1,"PAH",4,1,93,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,94,0)="    Corrective Action: The Drug Selection prompt will only display"
^DIC(9.4,177,22,1,"PAH",4,1,95,0)="    active rugs and those marked for packages ""I"" and ""U""."
^DIC(9.4,177,22,1,"PAH",4,1,96,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,97,0)="14. Problem: When attempting to run the Medication Administration Log"
^DIC(9.4,177,22,1,"PAH",4,1,98,0)="    [PSBO ML] option, an error is generated due to incomplete data."
^DIC(9.4,177,22,1,"PAH",4,1,99,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,100,0)="    Corrective Action: The software has been corrected to not generate an"
^DIC(9.4,177,22,1,"PAH",4,1,101,0)="    error."
^DIC(9.4,177,22,1,"PAH",4,1,102,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,103,0)="15. Problem: When running the MAH report, the initials of the nurse who"
^DIC(9.4,177,22,1,"PAH",4,1,104,0)="    administered a PRN, on-call and one-time do not print on the report."
^DIC(9.4,177,22,1,"PAH",4,1,105,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,106,0)="    Corrective Action: The MAH report has been corrected to properly print"
^DIC(9.4,177,22,1,"PAH",4,1,107,0)="    the initials of the nurse who administered an PRN, on-call, and"
^DIC(9.4,177,22,1,"PAH",4,1,108,0)="    one-time."
^DIC(9.4,177,22,1,"PAH",4,1,109,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,110,0)="16. Problem: When running the MAH report, one-time orders outside the date"
^DIC(9.4,177,22,1,"PAH",4,1,111,0)="    range are being printed."
^DIC(9.4,177,22,1,"PAH",4,1,112,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,113,0)="    Corrective Action: One-time orders will display within selected date"
^DIC(9.4,177,22,1,"PAH",4,1,114,0)="    range on the MAH report."
^DIC(9.4,177,22,1,"PAH",4,1,115,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,116,0)="17. Problem: If no action was taken on a one-time order, they would stay"
^DIC(9.4,177,22,1,"PAH",4,1,117,0)="    on the VDL for 30 days."
^DIC(9.4,177,22,1,"PAH",4,1,118,0)=" "
^DIC(9.4,177,22,1,"PAH",4,1,119,0)="    Corrective Action: One-time orders with no action will now drop off"
^DIC(9.4,177,22,1,"PAH",4,1,120,0)="    the  VDL after 12 hours."
^DIC(9.4,177,22,1,"PAH",5,0)="5 SEQ #5^3000612^1"
^DIC(9.4,177,22,1,"PAH",5,1,0)="^^254^254^3000612"
^DIC(9.4,177,22,1,"PAH",5,1,1,0)="1.  Problem: Sites using the Robot Rx are having difficulty with "
^DIC(9.4,177,22,1,"PAH",5,1,2,0)="    Bar Code Medication Administration (BCMA) reading the barcode."
^DIC(9.4,177,22,1,"PAH",5,1,3,0)="    *If your site is not using the Robot Rx system, "
^DIC(9.4,177,22,1,"PAH",5,1,4,0)="    please skip section 1."
^DIC(9.4,177,22,1,"PAH",5,1,5,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,6,0)="    Corrective Action: The BCMA software has been modified to recognize "
^DIC(9.4,177,22,1,"PAH",5,1,7,0)="    the Robot Rx barcode format. In order for BCMA to function with "
^DIC(9.4,177,22,1,"PAH",5,1,8,0)="    Robot Rx, please follow the directions in the order listed below."
^DIC(9.4,177,22,1,"PAH",5,1,9,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,10,0)="    1.1 The DRUG file #50 cannot contain a synonym that is 16 or 18 "
^DIC(9.4,177,22,1,"PAH",5,1,11,0)="        digits in length and begins with a ""3"". If matches to this "
^DIC(9.4,177,22,1,"PAH",5,1,12,0)="        pattern exist, they must be changed to a different format. "
^DIC(9.4,177,22,1,"PAH",5,1,13,0)="        Once these are changed, new synonyms matching this format "
^DIC(9.4,177,22,1,"PAH",5,1,14,0)="        cannot be entered while using Robot Rx. To search for "
^DIC(9.4,177,22,1,"PAH",5,1,15,0)="        possible matches in the DRUG file #50, please follow"
^DIC(9.4,177,22,1,"PAH",5,1,16,0)="        these steps."
^DIC(9.4,177,22,1,"PAH",5,1,17,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,18,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,19,0)="        a) Access VA FileMan"
^DIC(9.4,177,22,1,"PAH",5,1,20,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,21,0)="        b) Select OPTION: 3  SEARCH FILE ENTRIES and enter in the"
^DIC(9.4,177,22,1,"PAH",5,1,22,0)="                          ="
^DIC(9.4,177,22,1,"PAH",5,1,23,0)="           information as it appears below."
^DIC(9.4,177,22,1,"PAH",5,1,24,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,25,0)="           OUTPUT FROM WHAT FILE: DRUG//"
^DIC(9.4,177,22,1,"PAH",5,1,26,0)="                                  ===="
^DIC(9.4,177,22,1,"PAH",5,1,27,0)="           -A- SEARCH FOR DRUG FIELD: 9  SYNONYM   (multiple)"
^DIC(9.4,177,22,1,"PAH",5,1,28,0)="                                      ="
^DIC(9.4,177,22,1,"PAH",5,1,29,0)="           -A- SEARCH FOR DRUG SYNONYM SUB-FIELD: .01  SYNONYM"
^DIC(9.4,177,22,1,"PAH",5,1,30,0)="                                                  ==="
^DIC(9.4,177,22,1,"PAH",5,1,31,0)="           -A- CONDITION: 3  MATCHES"
^DIC(9.4,177,22,1,"PAH",5,1,32,0)="                          ="
^DIC(9.4,177,22,1,"PAH",5,1,33,0)="           -A- MATCHES: 1""3""15E"
^DIC(9.4,177,22,1,"PAH",5,1,34,0)="                        ======="
^DIC(9.4,177,22,1,"PAH",5,1,35,0)="           -B- SEARCH FOR DRUG SYNONYM SUB-FIELD: .01  SYNONYM"
^DIC(9.4,177,22,1,"PAH",5,1,36,0)="                                                  ==="
^DIC(9.4,177,22,1,"PAH",5,1,37,0)="           -B- CONDITION: 3  MATCHES"
^DIC(9.4,177,22,1,"PAH",5,1,38,0)="                          ="
^DIC(9.4,177,22,1,"PAH",5,1,39,0)="           -B- MATCHES: 1""3""17E"
^DIC(9.4,177,22,1,"PAH",5,1,40,0)="                        ======="
^DIC(9.4,177,22,1,"PAH",5,1,41,0)="           -C- SEARCH FOR DRUG SYNONYM SUB-FIELD:<RET>"
^DIC(9.4,177,22,1,"PAH",5,1,42,0)="           -C- SEARCH FOR DRUG FIELD:<RET>"
^DIC(9.4,177,22,1,"PAH",5,1,43,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,44,0)="           IF: A    DRUG SYNONYM MATCHES 1""3""15E"
^DIC(9.4,177,22,1,"PAH",5,1,45,0)="               ="
^DIC(9.4,177,22,1,"PAH",5,1,46,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,47,0)="           DO YOU WANT THIS SEARCH SPECIFICATION TO BE CONSIDERED "
^DIC(9.4,177,22,1,"PAH",5,1,48,0)="           TRUE FOR CONDITION"
^DIC(9.4,177,22,1,"PAH",5,1,49,0)="           -A-"
^DIC(9.4,177,22,1,"PAH",5,1,50,0)="           1) WHEN AT LEAST ONE OF THE 'SYNONYM' MULTIPLES SATISFIES IT"
^DIC(9.4,177,22,1,"PAH",5,1,51,0)="           2) WHEN ALL OF THE 'SYNONYM' MULTIPLES SATISFY IT"
^DIC(9.4,177,22,1,"PAH",5,1,52,0)="           CHOOSE 1-2: 1// 1"
^DIC(9.4,177,22,1,"PAH",5,1,53,0)="                           ="
^DIC(9.4,177,22,1,"PAH",5,1,54,0)="           OR: B     Or DRUG SYNONYM MATCHES 1""3""17E"
^DIC(9.4,177,22,1,"PAH",5,1,55,0)="               ="
^DIC(9.4,177,22,1,"PAH",5,1,56,0)="           DO YOU WANT THIS SEARCH SPECIFICATION TO BE CONSIDERED "
^DIC(9.4,177,22,1,"PAH",5,1,57,0)="           TRUE FOR CONDITION"
^DIC(9.4,177,22,1,"PAH",5,1,58,0)="           -B-"
^DIC(9.4,177,22,1,"PAH",5,1,59,0)="           1) WHEN AT LEAST ONE OF THE 'SYNONYM' MULTIPLES SATISFIES IT"
^DIC(9.4,177,22,1,"PAH",5,1,60,0)="           2) WHEN ALL OF THE 'SYNONYM' MULTIPLES SATISFY IT"
^DIC(9.4,177,22,1,"PAH",5,1,61,0)="           CHOOSE 1-2: 1// 1"
^DIC(9.4,177,22,1,"PAH",5,1,62,0)="                           ="
^DIC(9.4,177,22,1,"PAH",5,1,63,0)="           OR:"
^DIC(9.4,177,22,1,"PAH",5,1,64,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,65,0)="           STORE RESULTS OF SEARCH IN TEMPLATE:"
^DIC(9.4,177,22,1,"PAH",5,1,66,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,67,0)="           SORT BY: GENERIC NAME// <RET>"
^DIC(9.4,177,22,1,"PAH",5,1,68,0)="           START WITH GENERIC NAME: FIRST//<RET>"
^DIC(9.4,177,22,1,"PAH",5,1,69,0)="           FIRST PRINT FIELD: .01  GENERIC NAME"
^DIC(9.4,177,22,1,"PAH",5,1,70,0)="                              ==="
^DIC(9.4,177,22,1,"PAH",5,1,71,0)="           THEN PRINT FIELD: SYNONYM    (multiple)"
^DIC(9.4,177,22,1,"PAH",5,1,72,0)="                             ======="
^DIC(9.4,177,22,1,"PAH",5,1,73,0)="           THEN PRINT SYNONYM SUB-FIELD: .01  SYNONYM"
^DIC(9.4,177,22,1,"PAH",5,1,74,0)="                                         ==="
^DIC(9.4,177,22,1,"PAH",5,1,75,0)="           THEN PRINT SYNONYM SUB-FIELD: <RET>"
^DIC(9.4,177,22,1,"PAH",5,1,76,0)="           THEN PRINT FIELD: <RET>"
^DIC(9.4,177,22,1,"PAH",5,1,77,0)="Heading (S/C): DRUG SEARCH//<RET>"
^DIC(9.4,177,22,1,"PAH",5,1,78,0)="DEVICE: 0;80;999  ***"
^DIC(9.4,177,22,1,"PAH",5,1,79,0)="DRUG SEARCH                                    MAR 13,2000  09:57    PAGE"
^DIC(9.4,177,22,1,"PAH",5,1,80,0)=1
^DIC(9.4,177,22,1,"PAH",5,1,81,0)="GENERIC NAME                    SYNONYM"
^DIC(9.4,177,22,1,"PAH",5,1,82,0)="--------------------------------------------------------------------------"
^DIC(9.4,177,22,1,"PAH",5,1,83,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,84,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,85,0)="ACETAMINOPHEN 325MG TAB         APAP"
^DIC(9.4,177,22,1,"PAH",5,1,86,0)="                                TYLENOL"
^DIC(9.4,177,22,1,"PAH",5,1,87,0)="                                ACET325"
^DIC(9.4,177,22,1,"PAH",5,1,88,0)="                                000677000100"
^DIC(9.4,177,22,1,"PAH",5,1,89,0)="                                051111048893"
^DIC(9.4,177,22,1,"PAH",5,1,90,0)="                                305111104882120100"
^DIC(9.4,177,22,1,"PAH",5,1,91,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,92,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,93,0)="                               1 MATCH FOUND."
^DIC(9.4,177,22,1,"PAH",5,1,94,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,95,0)="       1.2 A new prompt ""Using Robot Rx"" has been added to"
^DIC(9.4,177,22,1,"PAH",5,1,96,0)="       Edit Divisional Parameters [PSB PARAMETERS]option."
^DIC(9.4,177,22,1,"PAH",5,1,97,0)="       The user should answer Yes to thE question when they"
^DIC(9.4,177,22,1,"PAH",5,1,98,0)="       are now ready to use Robot Rx."
^DIC(9.4,177,22,1,"PAH",5,1,99,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,100,0)="2.  Problem: Sites which are attempting to integrate are concerned that"
^DIC(9.4,177,22,1,"PAH",5,1,101,0)="    the current prompt ""Include Site Number"" within Edit Divisional "
^DIC(9.4,177,22,1,"PAH",5,1,102,0)="    Parameters[PSB PARAMETERS] option may have duplicates numbers at "
^DIC(9.4,177,22,1,"PAH",5,1,103,0)="    other sites."
^DIC(9.4,177,22,1,"PAH",5,1,104,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,105,0)="    Corrective Action: The prompt ""Include Site Number"" has been changed"
^DIC(9.4,177,22,1,"PAH",5,1,106,0)="    to ""Default Barcode Prefix"". This will allow each site to enter in"
^DIC(9.4,177,22,1,"PAH",5,1,107,0)="    a one to five alphanumeric prefix instead of just the site's prefix."
^DIC(9.4,177,22,1,"PAH",5,1,108,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,109,0)="3.  Problem: The GUI Virtual Due List (VDL) does not wrap the ""Dosage"","
^DIC(9.4,177,22,1,"PAH",5,1,110,0)="    cutting off the dosage display."
^DIC(9.4,177,22,1,"PAH",5,1,111,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,112,0)="    Corrective Action. The GUI Virtual Due List has been corrected to"
^DIC(9.4,177,22,1,"PAH",5,1,113,0)="    properly wrap the ""Dosage""."
^DIC(9.4,177,22,1,"PAH",5,1,114,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,115,0)="4.  Problem: If a user defines a reason under Reasons a Med is"
^DIC(9.4,177,22,1,"PAH",5,1,116,0)="    given PRN, beginning with a numeric value, the GUI Virtual Due List"
^DIC(9.4,177,22,1,"PAH",5,1,117,0)="    would display the actual number of the reason, instead of the text."
^DIC(9.4,177,22,1,"PAH",5,1,118,0)="    Please see NOIS HAM-0100-22249 for an example."
^DIC(9.4,177,22,1,"PAH",5,1,119,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,120,0)="    Corrective Action: The GUI Virtual Due List has been corrected to"
^DIC(9.4,177,22,1,"PAH",5,1,121,0)="    properly display the PRN reason defined."
^DIC(9.4,177,22,1,"PAH",5,1,122,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,123,0)="5.  Problem: Non-verified medications are printing on the Missed"
^DIC(9.4,177,22,1,"PAH",5,1,124,0)="    Medications Report."
^DIC(9.4,177,22,1,"PAH",5,1,125,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,126,0)="    Corrective Action: The Missed Medications Report"
^DIC(9.4,177,22,1,"PAH",5,1,127,0)="    has been modified to exclude non-verified medications."
^DIC(9.4,177,22,1,"PAH",5,1,128,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,129,0)="6.  Problem: When administering an injectable drug from the VDL, you are"
^DIC(9.4,177,22,1,"PAH",5,1,130,0)="    first prompted with the ""Enter Quantity and Units"" screen."
^DIC(9.4,177,22,1,"PAH",5,1,131,0)="    Once this screen is completed, the ""Injection Site Needed"" screen"
^DIC(9.4,177,22,1,"PAH",5,1,132,0)="    appears. If you press cancel, the medication entry is logged as given"
^DIC(9.4,177,22,1,"PAH",5,1,133,0)="    and no injection site is filed with an entry."
^DIC(9.4,177,22,1,"PAH",5,1,134,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,135,0)="    Corrective Action: The VDL has been modified to make injectable site"
^DIC(9.4,177,22,1,"PAH",5,1,136,0)="    a required field."
^DIC(9.4,177,22,1,"PAH",5,1,137,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,138,0)="7.  Problem: An error ""Exception Elist error in module VCLX40.BPL AT"
^DIC(9.4,177,22,1,"PAH",5,1,139,0)="    0001A9FS"" is generated in GUI when the following scenario occurs."
^DIC(9.4,177,22,1,"PAH",5,1,140,0)="    The user scans a drug that comes in 5mg doses and patient needs"
^DIC(9.4,177,22,1,"PAH",5,1,141,0)="    10mg dose. The user scanned the medication once, then used the"
^DIC(9.4,177,22,1,"PAH",5,1,142,0)="    touch screen to make the second check mark on the second dose."
^DIC(9.4,177,22,1,"PAH",5,1,143,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,144,0)="    Corrective Action: The dosage screen has been modified to require the"
^DIC(9.4,177,22,1,"PAH",5,1,145,0)="    second dose to be scanned in, instead of manually marked."
^DIC(9.4,177,22,1,"PAH",5,1,146,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,147,0)="8.  Problem: Scan a PRN that requires an amount to be entered such as an"
^DIC(9.4,177,22,1,"PAH",5,1,148,0)="    injection or a cream. The ""Enter Quantity and Units"" window comes up"
^DIC(9.4,177,22,1,"PAH",5,1,149,0)="    and the user enters the amount and hits enter. Next the ""Medication"
^DIC(9.4,177,22,1,"PAH",5,1,150,0)="    Log"" screen is displayed and the user then realizes they incorrectly"
^DIC(9.4,177,22,1,"PAH",5,1,151,0)="    entered the amount, so the cancel button is pressed. The ""Medication"
^DIC(9.4,177,22,1,"PAH",5,1,152,0)="    Log"" screen is displayed and says ""Order Administration Cancelled"""
^DIC(9.4,177,22,1,"PAH",5,1,153,0)="    The user hits enter then scans the med again. The ""Enter Quantity"
^DIC(9.4,177,22,1,"PAH",5,1,154,0)="    and Units"" screen doesn't come up again, but skips straight to the"
^DIC(9.4,177,22,1,"PAH",5,1,155,0)="    ""Medication Log"" and keeps the quantity and units from the first scan."
^DIC(9.4,177,22,1,"PAH",5,1,156,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,157,0)="    Corrective Action: When cancel is chosen, BCMA will now properly"
^DIC(9.4,177,22,1,"PAH",5,1,158,0)="    cancel out."
^DIC(9.4,177,22,1,"PAH",5,1,159,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,160,0)="9.  Problem: There are inconsistencies when marking IV's"
^DIC(9.4,177,22,1,"PAH",5,1,161,0)="    as held or refused."
^DIC(9.4,177,22,1,"PAH",5,1,162,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,163,0)="    Corrective Action: IV's can be marked as started, held or"
^DIC(9.4,177,22,1,"PAH",5,1,164,0)="    refused."
^DIC(9.4,177,22,1,"PAH",5,1,165,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,166,0)="10. Problem: The Missing Dose Followup [PSB MISSING DOSE FOLLOWUP] option"
^DIC(9.4,177,22,1,"PAH",5,1,167,0)="    would not stop scrolling if more than 14 medications were present."
^DIC(9.4,177,22,1,"PAH",5,1,168,0)="    This did not give the user the ability to select the appropriate dose."
^DIC(9.4,177,22,1,"PAH",5,1,169,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,170,0)="    Corrective Action: The Missing Dose Followup [PSB MISSING DOSE"
^DIC(9.4,177,22,1,"PAH",5,1,171,0)="    FOLLOWUP] option will now properly scroll, allowing the user the"
^DIC(9.4,177,22,1,"PAH",5,1,172,0)="    ability to select a dose."
^DIC(9.4,177,22,1,"PAH",5,1,173,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,174,0)="11. Problem: Within the Drug File Inquiry [PSB DRUG INQUIRY]option,"
^DIC(9.4,177,22,1,"PAH",5,1,175,0)="    if an inquiry is done on a drug that has 50 or more characters"
^DIC(9.4,177,22,1,"PAH",5,1,176,0)="    in the MESSAGE: field, the screen locks and the process needs to"
^DIC(9.4,177,22,1,"PAH",5,1,177,0)="    be stopped."
^DIC(9.4,177,22,1,"PAH",5,1,178,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,179,0)="    Corrective Action: The Drug File Inquiry [PSB DRUG INQUIRY]option"
^DIC(9.4,177,22,1,"PAH",5,1,180,0)="    has been corrected to no longer lock up if text is greater than 50"
^DIC(9.4,177,22,1,"PAH",5,1,181,0)="    characters."
^DIC(9.4,177,22,1,"PAH",5,1,182,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,183,0)="12. Modification: Display the initials and name of the nurse on the"
^DIC(9.4,177,22,1,"PAH",5,1,184,0)="    Medication Administration History (MAH) [PSBO MH] option."
^DIC(9.4,177,22,1,"PAH",5,1,185,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,186,0)="13. Modification: The MAH now displays the status of ""HOLD""."
^DIC(9.4,177,22,1,"PAH",5,1,187,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,188,0)="14. Problem: The Missing Dose Request [PSB MISSING DOSE REQUEST], option"
^DIC(9.4,177,22,1,"PAH",5,1,189,0)="    would allow the user to select an inactive drug."
^DIC(9.4,177,22,1,"PAH",5,1,190,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,191,0)="    Corrective Action: The Missing Dose Request [PSB MISSING DOSE REQUEST]"
^DIC(9.4,177,22,1,"PAH",5,1,192,0)="    option has been modified to prevent the selection of inactive drugs."
^DIC(9.4,177,22,1,"PAH",5,1,193,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,194,0)="15. Problem: When the administration time and the stop time for a"
^DIC(9.4,177,22,1,"PAH",5,1,195,0)="    continuous order are the same, the system would calculate the"
^DIC(9.4,177,22,1,"PAH",5,1,196,0)="    last dose as a dose to be given. Please see example below, were the"
^DIC(9.4,177,22,1,"PAH",5,1,197,0)="    last dose of 1900 was calculated because the stop time was 1900."
^DIC(9.4,177,22,1,"PAH",5,1,198,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,199,0)="    (1)Orderable Item: MINERALS/MULTIVITAMINS TAB"
^DIC(9.4,177,22,1,"PAH",5,1,200,0)="         Instructions:"
^DIC(9.4,177,22,1,"PAH",5,1,201,0)="    (2)Dosage Ordered: 1 TAB                    (3)Start: 02/10/00  11:43"
^DIC(9.4,177,22,1,"PAH",5,1,202,0)="    (4)     Med Route: ORAL                     (5)Stop: 02/10/00  19:00"
^DIC(9.4,177,22,1,"PAH",5,1,203,0)="    (6) Schedule Type: CONTINUOUS               (7)  Self Med: NO"
^DIC(9.4,177,22,1,"PAH",5,1,204,0)="    (8)      Schedule: Q2H"
^DIC(9.4,177,22,1,"PAH",5,1,205,0)="    (9)   Admin Times: 01-03-05-07-09-11-13-15-17-19-21-23"
^DIC(9.4,177,22,1,"PAH",5,1,206,0)="   (10)      Provider: BUNNY,BUGS"
^DIC(9.4,177,22,1,"PAH",5,1,207,0)="   (11) Special Instructions: FOR 3 DOSES"
^DIC(9.4,177,22,1,"PAH",5,1,208,0)="    This order will display 4 doses on the VDL."
^DIC(9.4,177,22,1,"PAH",5,1,209,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,210,0)="    Corrective Action: BCMA has been corrected to calculate the"
^DIC(9.4,177,22,1,"PAH",5,1,211,0)="    appropriate doses when the stop time and administration"
^DIC(9.4,177,22,1,"PAH",5,1,212,0)="    time are the same."
^DIC(9.4,177,22,1,"PAH",5,1,213,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,214,0)="16. Problem: The scanner ready status was inconsistent."
^DIC(9.4,177,22,1,"PAH",5,1,215,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,216,0)="    Corrective Action: The scanner status is in a ready status during"
^DIC(9.4,177,22,1,"PAH",5,1,217,0)="    most functions in BCMA."
^DIC(9.4,177,22,1,"PAH",5,1,218,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,219,0)="17. Problem: The ""Allowed Mins to Enter PRN Effect"" prompt within the Edit"
^DIC(9.4,177,22,1,"PAH",5,1,220,0)="    Divisional Parameters [PSB PARAMETERS] option was being stored"
^DIC(9.4,177,22,1,"PAH",5,1,221,0)="    incorrectly."
^DIC(9.4,177,22,1,"PAH",5,1,222,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,223,0)="    Corrective Action: The ""Allowed Mins to Enter PRN Effect"" prompt is"
^DIC(9.4,177,22,1,"PAH",5,1,224,0)="    now being stored correctly."
^DIC(9.4,177,22,1,"PAH",5,1,225,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,226,0)="18. Problem: An error occurred when cancelling the GUI BCMA log on."
^DIC(9.4,177,22,1,"PAH",5,1,227,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,228,0)="    Corrective Action: The error has been corrected."
^DIC(9.4,177,22,1,"PAH",5,1,229,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,230,0)="19. Modification: The full version number for BCMA GUI is now located in"
^DIC(9.4,177,22,1,"PAH",5,1,231,0)="    the About BCMA."
^DIC(9.4,177,22,1,"PAH",5,1,232,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,233,0)="20. Problem: If a medication has a med route of intradermal, the injection"
^DIC(9.4,177,22,1,"PAH",5,1,234,0)="    site box will not appear on the VDL during administration."
^DIC(9.4,177,22,1,"PAH",5,1,235,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,236,0)="    Corrective Action: The injection site box will now appear on the VDL"
^DIC(9.4,177,22,1,"PAH",5,1,237,0)="    when intradermal is the med route for a medication."
^DIC(9.4,177,22,1,"PAH",5,1,238,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,239,0)="21. Problem: The following scenario would not generate the message ** NO"
^DIC(9.4,177,22,1,"PAH",5,1,240,0)="    SPECIFIED MEDICATIONS TO PRINT **"" on the Due List. If a user"
^DIC(9.4,177,22,1,"PAH",5,1,241,0)="    choose to print the Due List for a specified schedule and there are no"
^DIC(9.4,177,22,1,"PAH",5,1,242,0)="    medications for that particular schedule, but other medications exist"
^DIC(9.4,177,22,1,"PAH",5,1,243,0)="    for other schedule types."
^DIC(9.4,177,22,1,"PAH",5,1,244,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,245,0)="    Corrective Action: The report was corrected to properly display"
^DIC(9.4,177,22,1,"PAH",5,1,246,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,247,0)="    the message ** NO SPECIFIED MEDICATIONS TO PRINT **"" when there"
^DIC(9.4,177,22,1,"PAH",5,1,248,0)="    are no medications to print for the specified schedule type."
^DIC(9.4,177,22,1,"PAH",5,1,249,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,250,0)="22. Problem: Users are unable to identify old one-time orders on"
^DIC(9.4,177,22,1,"PAH",5,1,251,0)="    Missed Medications [PSBO MM] option."
^DIC(9.4,177,22,1,"PAH",5,1,252,0)=" "
^DIC(9.4,177,22,1,"PAH",5,1,253,0)="    Corrective Action: The start date/date for a one-time order has been"
^DIC(9.4,177,22,1,"PAH",5,1,254,0)="    added to the Missed Medication Report."
^DIC(9.4,177,22,1,"PAH",6,0)="6 SEQ #6^3000612^1"
^DIC(9.4,177,22,1,"PAH",6,1,0)="^^21^21^3000612"
^DIC(9.4,177,22,1,"PAH",6,1,1,0)="Patch 6 contains the following modifications:"
^DIC(9.4,177,22,1,"PAH",6,1,2,0)=" "
^DIC(9.4,177,22,1,"PAH",6,1,3,0)="1.  Problem: The verifying nurse initials are not displayed on the Virtual"
^DIC(9.4,177,22,1,"PAH",6,1,4,0)="    Due List (VDL)."
^DIC(9.4,177,22,1,"PAH",6,1,5,0)=" "
^DIC(9.4,177,22,1,"PAH",6,1,6,0)="    Corrective Action: The VDL has been modified to display the verifying"
^DIC(9.4,177,22,1,"PAH",6,1,7,0)="    nurse initials."
^DIC(9.4,177,22,1,"PAH",6,1,8,0)=" "
^DIC(9.4,177,22,1,"PAH",6,1,9,0)="2.  Problem: The ""reason needed"" field on the missing dose screen on the  "
^DIC(9.4,177,22,1,"PAH",6,1,10,0)="    GUI would allow freetext."
^DIC(9.4,177,22,1,"PAH",6,1,11,0)=" "
^DIC(9.4,177,22,1,"PAH",6,1,12,0)="    Corrective Action: The ""reason needed"" field will not accept freetext."
^DIC(9.4,177,22,1,"PAH",6,1,13,0)=" "
^DIC(9.4,177,22,1,"PAH",6,1,14,0)="3.  Problem: The ""Last Given"" column is updated each time an action"
^DIC(9.4,177,22,1,"PAH",6,1,15,0)="    occurs, including refused and held. This can be confusing to the"
^DIC(9.4,177,22,1,"PAH",6,1,16,0)="    user since a medication marked as held will also show a date and "
^DIC(9.4,177,22,1,"PAH",6,1,17,0)="    time in the last given column."
^DIC(9.4,177,22,1,"PAH",6,1,18,0)=" "
^DIC(9.4,177,22,1,"PAH",6,1,19,0)="    Corrective Action: The ""Last Given"" column will be changed to ""Last"
^DIC(9.4,177,22,1,"PAH",6,1,20,0)="    Action"". The last status will also be displayed in the column next to"
^DIC(9.4,177,22,1,"PAH",6,1,21,0)="    the date and time."
^DIC(9.4,177,22,1,"PAH",7,0)="8 SEQ #7^3001106^1"
^DIC(9.4,177,22,1,"PAH",7,1,0)="^^39^39^3001106"
^DIC(9.4,177,22,1,"PAH",7,1,1,0)="1. Installing Bar Code Medication Administration (BCMA) on a network"
^DIC(9.4,177,22,1,"PAH",7,1,2,0)="   drive."
^DIC(9.4,177,22,1,"PAH",7,1,3,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,4,0)="   A. To install BCMA on a network drive, install BCMA on the file server"
^DIC(9.4,177,22,1,"PAH",7,1,5,0)="      that will perform the file sharing. BCMA is typically installed into"
^DIC(9.4,177,22,1,"PAH",7,1,6,0)="      c:\program files\vista\bcma."
^DIC(9.4,177,22,1,"PAH",7,1,7,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,8,0)="   B. Perform a file search on the file server to locate the file"
^DIC(9.4,177,22,1,"PAH",7,1,9,0)="      roboex32.dll. Copy this file to the file server's BCMA directory."
^DIC(9.4,177,22,1,"PAH",7,1,10,0)="      The file roboex32.dll is typically installed into the"
^DIC(9.4,177,22,1,"PAH",7,1,11,0)="      c:\windows\system directory or (for Windows NT machines)"
^DIC(9.4,177,22,1,"PAH",7,1,12,0)="      the c:\winnt\system32 directory."
^DIC(9.4,177,22,1,"PAH",7,1,13,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,14,0)="   C. Share the BCMA directory on the file server.  Optionally, the"
^DIC(9.4,177,22,1,"PAH",7,1,15,0)="      directory can be set to READ ONLY via the shared directory"
^DIC(9.4,177,22,1,"PAH",7,1,16,0)="      properties. In a Windows NT environment, NTFS file"
^DIC(9.4,177,22,1,"PAH",7,1,17,0)="      security can be set to further secure this directory."
^DIC(9.4,177,22,1,"PAH",7,1,18,0)="      Additionally, a login script file can be created that will"
^DIC(9.4,177,22,1,"PAH",7,1,19,0)="      automatically map the network drive each time a"
^DIC(9.4,177,22,1,"PAH",7,1,20,0)="      user logs in. This helps in the event that a user accidentally"
^DIC(9.4,177,22,1,"PAH",7,1,21,0)="      disconnects from the network drive."
^DIC(9.4,177,22,1,"PAH",7,1,22,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,23,0)="2. Pointing the client PC/laptop to the file server."
^DIC(9.4,177,22,1,"PAH",7,1,24,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,25,0)="   A. Map each laptop or client PC to the network drive mentioned in the"
^DIC(9.4,177,22,1,"PAH",7,1,26,0)="      previous step."
^DIC(9.4,177,22,1,"PAH",7,1,27,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,28,0)="   B. Create an icon that points to the file bcma.exe (on the network"
^DIC(9.4,177,22,1,"PAH",7,1,29,0)="      drive). Via the icon's properties, set up the necessary command"
^DIC(9.4,177,22,1,"PAH",7,1,30,0)="      line parameters to connect to your VistA system."
^DIC(9.4,177,22,1,"PAH",7,1,31,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,32,0)="Using this method, no BCMA files are required on the local client's PC."
^DIC(9.4,177,22,1,"PAH",7,1,33,0)="When it is time to install the next BCMA GUI patch, have all users log out"
^DIC(9.4,177,22,1,"PAH",7,1,34,0)="of BCMA, install the patch on the file server that is sharing the files"
^DIC(9.4,177,22,1,"PAH",7,1,35,0)="and the upgrade will be complete."
^DIC(9.4,177,22,1,"PAH",7,1,36,0)=" "
^DIC(9.4,177,22,1,"PAH",7,1,37,0)="The above installation instructions will only work with patch PSB*1*3 or"
^DIC(9.4,177,22,1,"PAH",7,1,38,0)="later.  Previous patches require additional files to be moved to the"
^DIC(9.4,177,22,1,"PAH",7,1,39,0)="shared BCMA directory."
^DIC(9.4,177,22,1,"PAH",8,0)="7 SEQ #8^3001106^1"
^DIC(9.4,177,22,1,"PAH",8,1,0)="^^256^256^3001106"
^DIC(9.4,177,22,1,"PAH",8,1,1,0)="Patch PSB*1*7 contains the following:"
^DIC(9.4,177,22,1,"PAH",8,1,2,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,3,0)="1.  Problem: An undefined variable PSBSTRT error is generated"
^DIC(9.4,177,22,1,"PAH",8,1,4,0)="    within the PRN Effectiveness List [PSBO PE] option when"
^DIC(9.4,177,22,1,"PAH",8,1,5,0)="    the user chooses a hospital location instead of a nursing"
^DIC(9.4,177,22,1,"PAH",8,1,6,0)="    location at the ""Ward Location:"" prompt."
^DIC(9.4,177,22,1,"PAH",8,1,7,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,8,0)="    Corrective Action: The PRN Effectiveness List [PSBO PE] option"
^DIC(9.4,177,22,1,"PAH",8,1,9,0)="    has been corrected to not error if a hospital location is chosen."
^DIC(9.4,177,22,1,"PAH",8,1,10,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,11,0)="2.  Problem: A user is unable to distinguish identical one-time"
^DIC(9.4,177,22,1,"PAH",8,1,12,0)="    orders on the Virtual Due List (VDL), when multiple identical"
^DIC(9.4,177,22,1,"PAH",8,1,13,0)="    one-time orders exist."
^DIC(9.4,177,22,1,"PAH",8,1,14,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,15,0)="    Corrective Action: The pop up box, Multiple Orders for Scanned Drugs,"
^DIC(9.4,177,22,1,"PAH",8,1,16,0)="    will now display the Type, Active Medication, Special Instructions,"
^DIC(9.4,177,22,1,"PAH",8,1,17,0)="    Dosage, Schedule, Route, Admin Time, Last Action, and Start"
^DIC(9.4,177,22,1,"PAH",8,1,18,0)="    date/time for each order. To select the correct order for"
^DIC(9.4,177,22,1,"PAH",8,1,19,0)="    administration, highlight the order and then click the OK button."
^DIC(9.4,177,22,1,"PAH",8,1,20,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,21,0)="3.  Problem: Users were unable to print reports to a slave device within"
^DIC(9.4,177,22,1,"PAH",8,1,22,0)="    all Bar Code Medication Administration (BCMA) CHUI options."
^DIC(9.4,177,22,1,"PAH",8,1,23,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,24,0)="    Corrective Action: BCMA CHUI has been modified to allow the printing"
^DIC(9.4,177,22,1,"PAH",8,1,25,0)="    of reports to a slave printer."
^DIC(9.4,177,22,1,"PAH",8,1,26,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,27,0)="4.  Problem: When entering an order through the Inpatient Order"
^DIC(9.4,177,22,1,"PAH",8,1,28,0)="    Entry [PSJ OE] option, for a drug that has a units per dose"
^DIC(9.4,177,22,1,"PAH",8,1,29,0)="    of 1, it is not necessary to manually enter a 1 in the"
^DIC(9.4,177,22,1,"PAH",8,1,30,0)="    ""UNITS PER DOSE:"" prompt. If the user chooses to bypass the"
^DIC(9.4,177,22,1,"PAH",8,1,31,0)="    ""UNITS PER DOSE:"" prompt field entry, the system will default"
^DIC(9.4,177,22,1,"PAH",8,1,32,0)="    to a 1. When the user elects to view the order detail on the"
^DIC(9.4,177,22,1,"PAH",8,1,33,0)="    VDL by double clicking on the order, the"" Units"" prompt"
^DIC(9.4,177,22,1,"PAH",8,1,34,0)="    is left blank."
^DIC(9.4,177,22,1,"PAH",8,1,35,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,36,0)="    Corrective Action: The VDL has been corrected to properly display"
^DIC(9.4,177,22,1,"PAH",8,1,37,0)="    a 1 in the UNITS PER DOSE field (#.02), when a user views the"
^DIC(9.4,177,22,1,"PAH",8,1,38,0)="    detail order information."
^DIC(9.4,177,22,1,"PAH",8,1,39,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,40,0)="5.  Problem:  The wording for the prompts listed below within menu"
^DIC(9.4,177,22,1,"PAH",8,1,41,0)="    Edit Divisional Parameters [PSB PARAMETERS] option were incorrect."
^DIC(9.4,177,22,1,"PAH",8,1,42,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,43,0)="    Corrective Action: The following prompts have been changed in"
^DIC(9.4,177,22,1,"PAH",8,1,44,0)="    the PARAMETER DEFINITION file (#8989.51) in the DISPLAY TEXT"
^DIC(9.4,177,22,1,"PAH",8,1,45,0)="    field (#.02)."
^DIC(9.4,177,22,1,"PAH",8,1,46,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,47,0)="    From:                            To:"
^DIC(9.4,177,22,1,"PAH",8,1,48,0)="    Include Blank Addendums at end   Default prompt for INCL BLANKS <Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,49,0)="    Include Continuous Meds          Default prompt for INCL CONT <Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,50,0)="    Include IV Med Orders            Default prompt for INCL IV MEDS <Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,51,0)="    Include On Call Meds             Default prompt for INCL ON-CALL <Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,52,0)="    Include One-Time Meds            Default prompt for INCL ONE-TIME<Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,53,0)="    Include PRN Meds                 Default prompt for INCL PRN <Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,54,0)="    Include Unit Dose Med Orders      Default prompt for INCL UD MEDS<Y/N>"
^DIC(9.4,177,22,1,"PAH",8,1,55,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,56,0)="6.  Problem: Medication orders that have an ODD Schedule do not"
^DIC(9.4,177,22,1,"PAH",8,1,57,0)="    display on the VDL. An ODD Schedule is a schedule that is not"
^DIC(9.4,177,22,1,"PAH",8,1,58,0)="    evenly divisible by 24 hours (Q18H or Q7H)."
^DIC(9.4,177,22,1,"PAH",8,1,59,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,60,0)="    Corrective Action: BCMA has been modified to accept and display ODD"
^DIC(9.4,177,22,1,"PAH",8,1,61,0)="    Schedule types on the VDL."
^DIC(9.4,177,22,1,"PAH",8,1,62,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,63,0)="    If your site plans on using ODD Schedules, please read the"
^DIC(9.4,177,22,1,"PAH",8,1,64,0)="    following NOTES."
^DIC(9.4,177,22,1,"PAH",8,1,65,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,66,0)="    ***NOTE*** When ordering medications with an ODD Schedule,"
^DIC(9.4,177,22,1,"PAH",8,1,67,0)="    DO NOT enter a time into the ""ADMIN TIMES:"" prompt when placing an"
^DIC(9.4,177,22,1,"PAH",8,1,68,0)="    order within the Inpatient Order Entry [PSJ OE] option."
^DIC(9.4,177,22,1,"PAH",8,1,69,0)="    BCMA will automatically calculate the administration time to the"
^DIC(9.4,177,22,1,"PAH",8,1,70,0)="    minute, based on the start date/time of the order. If you want the"
^DIC(9.4,177,22,1,"PAH",8,1,71,0)="    administration time to display to the nearest hour, edit the"
^DIC(9.4,177,22,1,"PAH",8,1,72,0)="    ""START DATE/TIME:"" prompt field to be on the hour."
^DIC(9.4,177,22,1,"PAH",8,1,73,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,74,0)="    For example if the start time is at 0837 for a Q5H, the"
^DIC(9.4,177,22,1,"PAH",8,1,75,0)="    administration times will be at 0837, and at 1337. To display the"
^DIC(9.4,177,22,1,"PAH",8,1,76,0)="    order on the VDL on the hour, edit the start time to be at 0800."
^DIC(9.4,177,22,1,"PAH",8,1,77,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,78,0)="    ***NOTE*** If a time is entered at the ""ADMIN TIMES:"" prompt when"
^DIC(9.4,177,22,1,"PAH",8,1,79,0)="    placing an order for an ODD Schedule, that administration time is"
^DIC(9.4,177,22,1,"PAH",8,1,80,0)="    when the medication will be displayed on the VDL everyday."
^DIC(9.4,177,22,1,"PAH",8,1,81,0)="    For example, if an order is placed with a schedule"
^DIC(9.4,177,22,1,"PAH",8,1,82,0)="    of Q5H with an administration time of at 0900. The order will appear"
^DIC(9.4,177,22,1,"PAH",8,1,83,0)="    on the VDL at 0900 everyday. Do not enter administration times"
^DIC(9.4,177,22,1,"PAH",8,1,84,0)="    if you want ODD Schedules to function properly."
^DIC(9.4,177,22,1,"PAH",8,1,85,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,86,0)="    ***NOTE*** ODD Schedules are NOT to be entered in the ADMINISTRATION"
^DIC(9.4,177,22,1,"PAH",8,1,87,0)="    SCHEDULE file (#51.1)"
^DIC(9.4,177,22,1,"PAH",8,1,88,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,89,0)="7.  Problem: No data is being displayed under the columns U/Ord and U/Gvn,"
^DIC(9.4,177,22,1,"PAH",8,1,90,0)="    within the medication log report when an IV is ordered."
^DIC(9.4,177,22,1,"PAH",8,1,91,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,92,0)="    Corrective Action: The medication log report has been modified to"
^DIC(9.4,177,22,1,"PAH",8,1,93,0)="    display ""N/A"" in the two columns for IV orders."
^DIC(9.4,177,22,1,"PAH",8,1,94,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,95,0)="8.  Problem: The Medication Administration History (MAH) report"
^DIC(9.4,177,22,1,"PAH",8,1,96,0)="    does not display the nurse's initials when a one-time is marked"
^DIC(9.4,177,22,1,"PAH",8,1,97,0)="    as refused."
^DIC(9.4,177,22,1,"PAH",8,1,98,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,99,0)="    Corrective Action: The MAH report has been modified to"
^DIC(9.4,177,22,1,"PAH",8,1,100,0)="    display the nurse's initials when a one-time has been marked"
^DIC(9.4,177,22,1,"PAH",8,1,101,0)="    as refused."
^DIC(9.4,177,22,1,"PAH",8,1,102,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,103,0)="9.  Problem: Within the Due List [PSBO DL] option, the ""On Call:"""
^DIC(9.4,177,22,1,"PAH",8,1,104,0)="    prompt will not save the users settings upon exit."
^DIC(9.4,177,22,1,"PAH",8,1,105,0)="    The field defaults to ""No"" after the user has exited the option."
^DIC(9.4,177,22,1,"PAH",8,1,106,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,107,0)="    Corrective Action: The ""On Call:"" prompt has been modified"
^DIC(9.4,177,22,1,"PAH",8,1,108,0)="    to save the users settings upon exiting the option."
^DIC(9.4,177,22,1,"PAH",8,1,109,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,110,0)="10. Problem: If a medication order has 2 or more units per dose, BCMA will"
^DIC(9.4,177,22,1,"PAH",8,1,111,0)="    display the Multiple Doses to Scan screen to allow the user"
^DIC(9.4,177,22,1,"PAH",8,1,112,0)="    to scan the second, third, etc doses. If a nurse enters an Internal"
^DIC(9.4,177,22,1,"PAH",8,1,113,0)="    Entry Number (IEN) for the second dose and did not press ENTER,"
^DIC(9.4,177,22,1,"PAH",8,1,114,0)="    but immediately pressed DONE, the IEN entered would not be marked as  "
^DIC(9.4,177,22,1,"PAH",8,1,115,0)="    Given."
^DIC(9.4,177,22,1,"PAH",8,1,116,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,117,0)="    Corrective Action: Validation is now performed on any text entered"
^DIC(9.4,177,22,1,"PAH",8,1,118,0)="    in the ""Scan Medication Bar Code"" prompt, regardless if the user"
^DIC(9.4,177,22,1,"PAH",8,1,119,0)="    pressed ENTER or not."
^DIC(9.4,177,22,1,"PAH",8,1,120,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,121,0)="11. Problem: If a user double clicks on an IV order on the VDL, the"
^DIC(9.4,177,22,1,"PAH",8,1,122,0)="    ""Dosage Ordered:"" prompt would display data."
^DIC(9.4,177,22,1,"PAH",8,1,123,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,124,0)="    Corrective Action: The ""Dosage Ordered:"" prompt has been"
^DIC(9.4,177,22,1,"PAH",8,1,125,0)="    corrected to not display any data on the VDL if an IV is order."
^DIC(9.4,177,22,1,"PAH",8,1,126,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,127,0)="12. Problem: If a patient has an IEN of ""1"" from"
^DIC(9.4,177,22,1,"PAH",8,1,128,0)="    the PATIENT file (#2) the VDL would generate the error"
^DIC(9.4,177,22,1,"PAH",8,1,129,0)="    ""RPC ERROR GETORDERLIST"" and not display any orders."
^DIC(9.4,177,22,1,"PAH",8,1,130,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,131,0)="    Corrective Action: The VDL has been corrected to not error"
^DIC(9.4,177,22,1,"PAH",8,1,132,0)="    with a patient who has an IEN of ""1""."
^DIC(9.4,177,22,1,"PAH",8,1,133,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,134,0)="13. Problem: If a medication is marked as held or refused through the"
^DIC(9.4,177,22,1,"PAH",8,1,135,0)="    Manual Medication Entry [PSB MED LOG NEW ENTRY] option, the"
^DIC(9.4,177,22,1,"PAH",8,1,136,0)="    MAH report displays the entered date/time, not the"
^DIC(9.4,177,22,1,"PAH",8,1,137,0)="    administered date/time."
^DIC(9.4,177,22,1,"PAH",8,1,138,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,139,0)="    Corrective Action: The MAH has been corrected to display the"
^DIC(9.4,177,22,1,"PAH",8,1,140,0)="    administered date/time instead of the entered date/time."
^DIC(9.4,177,22,1,"PAH",8,1,141,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,142,0)="14. Problem: The Ward Administration Times [PSBO WA] option was"
^DIC(9.4,177,22,1,"PAH",8,1,143,0)="    printing medications for incorrect days. For example, if the"
^DIC(9.4,177,22,1,"PAH",8,1,144,0)="    medication had a schedule of MO-WE-FR and the report was"
^DIC(9.4,177,22,1,"PAH",8,1,145,0)="    printed on Tuesday, the medications for MO-WE-FR would print"
^DIC(9.4,177,22,1,"PAH",8,1,146,0)="    on the report."
^DIC(9.4,177,22,1,"PAH",8,1,147,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,148,0)="    Corrective Action: The Ward Administration Times [PSBO WA] option"
^DIC(9.4,177,22,1,"PAH",8,1,149,0)="    has been corrected to properly print the medications for the correct"
^DIC(9.4,177,22,1,"PAH",8,1,150,0)="    days."
^DIC(9.4,177,22,1,"PAH",8,1,151,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,152,0)="15. Problem: If BCMA is writing to the BCMA MEDICATION LOG file (#53.79)"
^DIC(9.4,177,22,1,"PAH",8,1,153,0)="    and an MAH is run a ""NULLSUBSCRIPT"" error is generated."
^DIC(9.4,177,22,1,"PAH",8,1,154,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,155,0)="    Corrective Action: The code has been corrected by using"
^DIC(9.4,177,22,1,"PAH",8,1,156,0)="    standard coding conventions."
^DIC(9.4,177,22,1,"PAH",8,1,157,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,158,0)="16. Modification: The ""Room/Bed:"" prompt has been added to the"
^DIC(9.4,177,22,1,"PAH",8,1,159,0)="    Missing Dose Request [PSB MISSING DOSE REQUEST] option."
^DIC(9.4,177,22,1,"PAH",8,1,160,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,161,0)="17. Modification: The ""MED ROUTE:"" prompt has been added to the"
^DIC(9.4,177,22,1,"PAH",8,1,162,0)="    Due List [PSBO DL] option."
^DIC(9.4,177,22,1,"PAH",8,1,163,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,164,0)="18. Modification: The ward location and room-bed have"
^DIC(9.4,177,22,1,"PAH",8,1,165,0)="    been added to the BCMA-Order Problem e-mail message."
^DIC(9.4,177,22,1,"PAH",8,1,166,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,167,0)="19. Modification: The Enter PRN Effectiveness [PSB MED LOG PRN EFFECT]"
^DIC(9.4,177,22,1,"PAH",8,1,168,0)="    option has been modified to display the ADMINISTRATION MEDICATION"
^DIC(9.4,177,22,1,"PAH",8,1,169,0)="    field (#.08) from the BCMA MEDICATION LOG file (#53.79)."
^DIC(9.4,177,22,1,"PAH",8,1,170,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,171,0)="20. Modification: BCMA GUI has been modified to allow column resizing."
^DIC(9.4,177,22,1,"PAH",8,1,172,0)="    Any changes to the column settings will be saved, allowing the user"
^DIC(9.4,177,22,1,"PAH",8,1,173,0)="    to re-enter the GUI to the saved settings. The original column"
^DIC(9.4,177,22,1,"PAH",8,1,174,0)="    settings can be reset through the Reset User Parameters"
^DIC(9.4,177,22,1,"PAH",8,1,175,0)="    [PSB USER PARAM RESET] option."
^DIC(9.4,177,22,1,"PAH",8,1,176,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,177,0)="21. Modification: The Patient Medication Log in GUI has been modified to"
^DIC(9.4,177,22,1,"PAH",8,1,178,0)="    display the INCLUDE COMMENTS field (#.28) and the INCLUDE AUDITS"
^DIC(9.4,177,22,1,"PAH",8,1,179,0)="    field (#.29). All comments and audits are now viewable through the"
^DIC(9.4,177,22,1,"PAH",8,1,180,0)="    GUI."
^DIC(9.4,177,22,1,"PAH",8,1,181,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,182,0)="22. Modification: The Missed Medications [PSBO MM] option and the Ward"
^DIC(9.4,177,22,1,"PAH",8,1,183,0)="    Administration Times [PSBO WA] option have been modified to"
^DIC(9.4,177,22,1,"PAH",8,1,184,0)="    not display self-medications."
^DIC(9.4,177,22,1,"PAH",8,1,185,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,186,0)="23. Modification: The Medication Administration Log [PSBO ML] option"
^DIC(9.4,177,22,1,"PAH",8,1,187,0)="    has been modified to display the START DATE/TIME field (#10)."
^DIC(9.4,177,22,1,"PAH",8,1,188,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,189,0)="24. Modification: The ORDER NUMBER field (#.01) has been added to the"
^DIC(9.4,177,22,1,"PAH",8,1,190,0)="    Missed Medications [PSBO MM] option."
^DIC(9.4,177,22,1,"PAH",8,1,191,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,192,0)="25. Modification: The Missed Medications [PSBO MM] option will only"
^DIC(9.4,177,22,1,"PAH",8,1,193,0)="    print one-time medications within the last movement date."
^DIC(9.4,177,22,1,"PAH",8,1,194,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,195,0)="26. Modification: The BCMA GUI screen can now be maximized to fit the"
^DIC(9.4,177,22,1,"PAH",8,1,196,0)="    entire screen."
^DIC(9.4,177,22,1,"PAH",8,1,197,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,198,0)="27. Modification: The Manual Medication Entry [PSB MED LOG NEW ENTRY]"
^DIC(9.4,177,22,1,"PAH",8,1,199,0)="    option has been modified to display the history of the last four"
^DIC(9.4,177,22,1,"PAH",8,1,200,0)="    administrations for a PRN order."
^DIC(9.4,177,22,1,"PAH",8,1,201,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,202,0)="28. Modification: The patient record locking functionality has been"
^DIC(9.4,177,22,1,"PAH",8,1,203,0)="    removed, allowing multiple sessions of BCMA to be opened for one"
^DIC(9.4,177,22,1,"PAH",8,1,204,0)="    patient."
^DIC(9.4,177,22,1,"PAH",8,1,205,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,206,0)="29. Modification: New key functions."
^DIC(9.4,177,22,1,"PAH",8,1,207,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,208,0)="                  Shift-Tab - Takes focus off the Scan Medication Bar Code"
^DIC(9.4,177,22,1,"PAH",8,1,209,0)="                  to the VDL, allowing the user to scroll up and down the"
^DIC(9.4,177,22,1,"PAH",8,1,210,0)="                  VDL orders. Press the Enter key to display a highlighted"
^DIC(9.4,177,22,1,"PAH",8,1,211,0)="                  order."
^DIC(9.4,177,22,1,"PAH",8,1,212,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,213,0)="                  Right Click - on a selected order and select Display"
^DIC(9.4,177,22,1,"PAH",8,1,214,0)="                  Order to view detailed order information."
^DIC(9.4,177,22,1,"PAH",8,1,215,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,216,0)="                  ALT-D,O - Displays detailed order information."
^DIC(9.4,177,22,1,"PAH",8,1,217,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,218,0)="                  Select Due List [PSBO DL] option, then select"
^DIC(9.4,177,22,1,"PAH",8,1,219,0)="                  Display Order - To view detailed order information."
^DIC(9.4,177,22,1,"PAH",8,1,220,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,221,0)="                  F4 - To view detailed order information."
^DIC(9.4,177,22,1,"PAH",8,1,222,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,223,0)="                  F5 - Refresh the VDL."
^DIC(9.4,177,22,1,"PAH",8,1,224,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,225,0)="                  CTRL,O - To open a new patient."
^DIC(9.4,177,22,1,"PAH",8,1,226,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,227,0)="30. Modification: The GUI VDL has been modified to shut down when"
^DIC(9.4,177,22,1,"PAH",8,1,228,0)="    a ""PSB GETORDERLIST"" error is encountered. When such an error is"
^DIC(9.4,177,22,1,"PAH",8,1,229,0)="    encountered the VDL would display ""No Active Orders"". This information"
^DIC(9.4,177,22,1,"PAH",8,1,230,0)="    is a result of the broker returning no information. This modification"
^DIC(9.4,177,22,1,"PAH",8,1,231,0)="    prevents the user from viewing a VDL with false information when"
^DIC(9.4,177,22,1,"PAH",8,1,232,0)="    such an error is generated."
^DIC(9.4,177,22,1,"PAH",8,1,233,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,234,0)="31. Modification: The GUI Broker has a timeout value called"
^DIC(9.4,177,22,1,"PAH",8,1,235,0)="    RPCTimeLimit as defined in the quoted text below:"
^DIC(9.4,177,22,1,"PAH",8,1,236,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,237,0)="    Description"
^DIC(9.4,177,22,1,"PAH",8,1,238,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,239,0)="    This property is a public integer property that is available at"
^DIC(9.4,177,22,1,"PAH",8,1,240,0)="    run-time only. It specifies the length of time a client will"
^DIC(9.4,177,22,1,"PAH",8,1,241,0)="    wait for a response from an RPC. The default and minimum value of"
^DIC(9.4,177,22,1,"PAH",8,1,242,0)="    this property is 30 seconds."
^DIC(9.4,177,22,1,"PAH",8,1,243,0)="    If an RPC is expected to take more than 30 seconds to complete,"
^DIC(9.4,177,22,1,"PAH",8,1,244,0)="    adjust the RPCTimeLimit property accordingly. However, it is not"
^DIC(9.4,177,22,1,"PAH",8,1,245,0)="    advisable to have a RPCTimeLimit that is too long. Otherwise,"
^DIC(9.4,177,22,1,"PAH",8,1,246,0)="    the client-end of the application will appear to ""hang"", if the"
^DIC(9.4,177,22,1,"PAH",8,1,247,0)="    server doesn't respond in a timely fashion."
^DIC(9.4,177,22,1,"PAH",8,1,248,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,249,0)="    The BCMA default has been changed from 30 seconds to 60 seconds."
^DIC(9.4,177,22,1,"PAH",8,1,250,0)="    This can be changed with the new command line parameter of 'T' for"
^DIC(9.4,177,22,1,"PAH",8,1,251,0)="    timeout."
^DIC(9.4,177,22,1,"PAH",8,1,252,0)="    Your command line might look as follows:"
^DIC(9.4,177,22,1,"PAH",8,1,253,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,254,0)="    ""D:\Program Files\vista\Bcma\BCMA.exe"" S=BGHAM P=9307 T=30"
^DIC(9.4,177,22,1,"PAH",8,1,255,0)=" "
^DIC(9.4,177,22,1,"PAH",8,1,256,0)="    Any value below 30 seconds will be disregarded."
^DIC(9.4,177,22,1,"PAH",9,0)="11 SEQ #9^3010202^1"
^DIC(9.4,177,22,1,"PAH",9,1,0)="^^32^32^3010202"
^DIC(9.4,177,22,1,"PAH",9,1,1,0)="Patch PSB*1*11 contains the following:"
^DIC(9.4,177,22,1,"PAH",9,1,2,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,3,0)="1.  Problem: When attempting to chart a medication the user receives the"
^DIC(9.4,177,22,1,"PAH",9,1,4,0)="    following error."
^DIC(9.4,177,22,1,"PAH",9,1,5,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,6,0)="    310: The IENS> +10+1 conflicts with FDA."
^DIC(9.4,177,22,1,"PAH",9,1,7,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,8,0)="    Corrective Action: The error was resolved by performing a NEW command"
^DIC(9.4,177,22,1,"PAH",9,1,9,0)="    on the variable PSBFDA."
^DIC(9.4,177,22,1,"PAH",9,1,10,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,11,0)="2.  Modification: This patch includes a new API between Inpatient"
^DIC(9.4,177,22,1,"PAH",9,1,12,0)="    Medications and Bar Code Medication Administration"
^DIC(9.4,177,22,1,"PAH",9,1,13,0)="    (BCMA) (Integration Agreement #3174)."
^DIC(9.4,177,22,1,"PAH",9,1,14,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,15,0)="    The entry point EN^PSBIPM is provided by the Bar Code Medication"
^DIC(9.4,177,22,1,"PAH",9,1,16,0)="    Administration (BCMA) package to provide information to Inpatient"
^DIC(9.4,177,22,1,"PAH",9,1,17,0)="    Medications to be used in determining the start date for a renewed"
^DIC(9.4,177,22,1,"PAH",9,1,18,0)="    order."
^DIC(9.4,177,22,1,"PAH",9,1,19,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,20,0)="    The new API will:"
^DIC(9.4,177,22,1,"PAH",9,1,21,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,22,0)="    a. Pass the ORDER ADMINISTRATION TIME field (#.13) of the BCMA"
^DIC(9.4,177,22,1,"PAH",9,1,23,0)="    MEDICATION LOG file (#53.79)."
^DIC(9.4,177,22,1,"PAH",9,1,24,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,25,0)="    b. Pass the ADMINISTRATION DATE/TIME field (#.06) of the BCMA"
^DIC(9.4,177,22,1,"PAH",9,1,26,0)="    MEDICATION LOG file (#53.79)."
^DIC(9.4,177,22,1,"PAH",9,1,27,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,28,0)="    c. Pass the ADMINISTRATION STATUS field (#.09) of the BCMA"
^DIC(9.4,177,22,1,"PAH",9,1,29,0)="    MEDICATION LOG file (#53.79)."
^DIC(9.4,177,22,1,"PAH",9,1,30,0)=" "
^DIC(9.4,177,22,1,"PAH",9,1,31,0)="3.  The PSBPOST post installation routine re-indexes the BCMA MEDICATION"
^DIC(9.4,177,22,1,"PAH",9,1,32,0)="    LOG file (#53.79). The new subscript added is ""AORDX""."
^DIC(9.4,177,22,1,"PAH",10,0)="9 SEQ #10^3010326^1"
^DIC(9.4,177,22,1,"PAH",10,1,0)="^^133^133^3010326"
^DIC(9.4,177,22,1,"PAH",10,1,1,0)="Patch PSB*1*9 contains the following:"
^DIC(9.4,177,22,1,"PAH",10,1,2,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,3,0)="1.  Problem: The Virtual Due List (VDL) will only display the first"
^DIC(9.4,177,22,1,"PAH",10,1,4,0)="    additive and solution for an Intravenous (IV) order."
^DIC(9.4,177,22,1,"PAH",10,1,5,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,6,0)="    Corrective Action: The VDL will now display all additives, strengths,"
^DIC(9.4,177,22,1,"PAH",10,1,7,0)="    solutions, and volumes for each IV order."
^DIC(9.4,177,22,1,"PAH",10,1,8,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,9,0)="2.  Problem: The Room-Bed displaying on the Ward Administration Times"
^DIC(9.4,177,22,1,"PAH",10,1,10,0)="    [PSBO WA] option is a combination of data that consists"
^DIC(9.4,177,22,1,"PAH",10,1,11,0)="    of the ward location and the Room-Bed. When this combination of"
^DIC(9.4,177,22,1,"PAH",10,1,12,0)="    data exceeds 32 characters it causes the report to print skewed."
^DIC(9.4,177,22,1,"PAH",10,1,13,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,14,0)="    Corrective Action: The ward location and Room-Bed will now print"
^DIC(9.4,177,22,1,"PAH",10,1,15,0)="    on separate lines."
^DIC(9.4,177,22,1,"PAH",10,1,16,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,17,0)="3.  Problem: The ""Missing Dose Printer"" prompt did not display on the GUI"
^DIC(9.4,177,22,1,"PAH",10,1,18,0)="    BCMA Site Parameters."
^DIC(9.4,177,22,1,"PAH",10,1,19,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,20,0)="    Corrective Action: The GUI BCMA Site Parameters has been"
^DIC(9.4,177,22,1,"PAH",10,1,21,0)="    corrected to display the ""Missing Dose Request Printer"" prompt."
^DIC(9.4,177,22,1,"PAH",10,1,22,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,23,0)="4.  Problem: When BCMA generates an error message to pharmacy because it"
^DIC(9.4,177,22,1,"PAH",10,1,24,0)="    cannot determine the schedule. It displays the orderable item number"
^DIC(9.4,177,22,1,"PAH",10,1,25,0)="    instead of the name. Below is an example."
^DIC(9.4,177,22,1,"PAH",10,1,26,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,27,0)="    Order Number....: 570U"
^DIC(9.4,177,22,1,"PAH",10,1,28,0)="    Orderable Item..: 1695  <====="
^DIC(9.4,177,22,1,"PAH",10,1,29,0)="    Patient.........: XXXXXX,SAMUEL  (000 00 0000)"
^DIC(9.4,177,22,1,"PAH",10,1,30,0)="    Reason..........: Unable to determine schedule 2X/WEEK"
^DIC(9.4,177,22,1,"PAH",10,1,31,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,32,0)="    Corrective Action: The error message has been corrected to display"
^DIC(9.4,177,22,1,"PAH",10,1,33,0)="    the orderable item name instead of the number."
^DIC(9.4,177,22,1,"PAH",10,1,34,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,35,0)="    Order Number....: 570U"
^DIC(9.4,177,22,1,"PAH",10,1,36,0)="    Orderable Item..: DIGOXIN TAB  <======"
^DIC(9.4,177,22,1,"PAH",10,1,37,0)="    Patient.........: XXXXXX,SAMUEL  (000 00 0000)"
^DIC(9.4,177,22,1,"PAH",10,1,38,0)="    Reason..........: Unable to determine schedule 2X/WEEK"
^DIC(9.4,177,22,1,"PAH",10,1,39,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,40,0)="5.  Problem: The following occurs when trying to print a Due List"
^DIC(9.4,177,22,1,"PAH",10,1,41,0)="    from the Due List [PSBO DL] option with a patient who has"
^DIC(9.4,177,22,1,"PAH",10,1,42,0)="    the same last name and last four digits of the SSN as another patient."
^DIC(9.4,177,22,1,"PAH",10,1,43,0)="    When the last initial and last four digits of the SSN are entered"
^DIC(9.4,177,22,1,"PAH",10,1,44,0)="    it displays two choices."
^DIC(9.4,177,22,1,"PAH",10,1,45,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,46,0)="    1  M6383  MOUSE,MICKEY       11-13-48    XXXXX6383"
^DIC(9.4,177,22,1,"PAH",10,1,47,0)="    2  M6383  MOUSE,MINNIE         4-3-36    XXXXX6383"
^DIC(9.4,177,22,1,"PAH",10,1,48,0)="    CHOOSE 1-2: 1"
^DIC(9.4,177,22,1,"PAH",10,1,49,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,50,0)="    The following question is then asked:"
^DIC(9.4,177,22,1,"PAH",10,1,51,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,52,0)="    There is more than one patient whose last name is 'MOUSE' and"
^DIC(9.4,177,22,1,"PAH",10,1,53,0)="    whose social security number ends with '6383'."
^DIC(9.4,177,22,1,"PAH",10,1,54,0)="    Are you sure you wish to continue (Y/N)? Y"
^DIC(9.4,177,22,1,"PAH",10,1,55,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,56,0)="    When this question is answered, the Due List screen shifts down"
^DIC(9.4,177,22,1,"PAH",10,1,57,0)="    one line, skewing the screen."
^DIC(9.4,177,22,1,"PAH",10,1,58,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,59,0)="    Corrective Action: The Due List [PSBO DL] option screen has"
^DIC(9.4,177,22,1,"PAH",10,1,60,0)="    been corrected to not skew when there is a multiple patient match."
^DIC(9.4,177,22,1,"PAH",10,1,61,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,62,0)="6.  Problem: The user receives the following error message when"
^DIC(9.4,177,22,1,"PAH",10,1,63,0)="    attempting to start a PRN Piggyback. ""Error(s) Filing Transaction"
^DIC(9.4,177,22,1,"PAH",10,1,64,0)="    MEDPASS. Business Logic Error: PRN Medications MUST Have a PRN"
^DIC(9.4,177,22,1,"PAH",10,1,65,0)="    Reason"". The user is then unable to mark it as started."
^DIC(9.4,177,22,1,"PAH",10,1,66,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,67,0)="    Corrective Action: The GUI VDL has been corrected to allow"
^DIC(9.4,177,22,1,"PAH",10,1,68,0)="    a user to mark a PRN Piggyback as started."
^DIC(9.4,177,22,1,"PAH",10,1,69,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,70,0)="7.  Problem: User receives an undefined error when using the Missing Dose"
^DIC(9.4,177,22,1,"PAH",10,1,71,0)="    [PSBO MD] option."
^DIC(9.4,177,22,1,"PAH",10,1,72,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,73,0)="    Corrective Action: The error was resolved by performing a KILL on the"
^DIC(9.4,177,22,1,"PAH",10,1,74,0)="    D0 variable."
^DIC(9.4,177,22,1,"PAH",10,1,75,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,76,0)="8.  Problem: An IV order with a status of on call will not"
^DIC(9.4,177,22,1,"PAH",10,1,77,0)="    display on the VDL."
^DIC(9.4,177,22,1,"PAH",10,1,78,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,79,0)="    Corrective Action: The VDL has been corrected to display IV's with"
^DIC(9.4,177,22,1,"PAH",10,1,80,0)="    a status of on call."
^DIC(9.4,177,22,1,"PAH",10,1,81,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,82,0)="9.  Problem: When scanning a drug with more than 6 units per dose, only 6"
^DIC(9.4,177,22,1,"PAH",10,1,83,0)="    units display in the ""MULTIPLE DOSES TO SCAN"" GUI window."
^DIC(9.4,177,22,1,"PAH",10,1,84,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,85,0)="    Corrective Action: The ""MULTIPLE DOSES TO SCAN"" window has been"
^DIC(9.4,177,22,1,"PAH",10,1,86,0)="    corrected to show and scan more than 6 units of a medication."
^DIC(9.4,177,22,1,"PAH",10,1,87,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,88,0)="10. Problem: When a user leaves the ""Print to DEVICE:"" prompt blank"
^DIC(9.4,177,22,1,"PAH",10,1,89,0)="    within the Due List [PSBO DL] option the user receives a ""NULL"
^DIC(9.4,177,22,1,"PAH",10,1,90,0)="    SUBSCRIPT""  error."
^DIC(9.4,177,22,1,"PAH",10,1,91,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,92,0)="    Corrective Action: The ""Print to DEVICE:"" prompt has been changed"
^DIC(9.4,177,22,1,"PAH",10,1,93,0)="    to be a required prompt."
^DIC(9.4,177,22,1,"PAH",10,1,94,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,95,0)="11. Problem: When a user deletes the date and time from an order already"
^DIC(9.4,177,22,1,"PAH",10,1,96,0)="    given within the Edit Medication Log [PSB MED LOG EDIT] option, the"
^DIC(9.4,177,22,1,"PAH",10,1,97,0)="    medication still appears as given on the Medication Administration"
^DIC(9.4,177,22,1,"PAH",10,1,98,0)="    History report (MAH)."
^DIC(9.4,177,22,1,"PAH",10,1,99,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,100,0)="    Corrective Action: The user is now able to mark a medication as"
^DIC(9.4,177,22,1,"PAH",10,1,101,0)="    NOT GIVEN at the ""Admin Status:"" prompt in the Edit Medication"
^DIC(9.4,177,22,1,"PAH",10,1,102,0)="    Log [PSB MED LOG EDIT] option and it appears correctly on the MAH."
^DIC(9.4,177,22,1,"PAH",10,1,103,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,104,0)="12. Problem: Large volume IV's do not print on the Due List [PSBO DL]"
^DIC(9.4,177,22,1,"PAH",10,1,105,0)="    option."
^DIC(9.4,177,22,1,"PAH",10,1,106,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,107,0)="    Corrective Action: The Due List [PSBO DL] option has been corrected"
^DIC(9.4,177,22,1,"PAH",10,1,108,0)="    to display large volume IV's."
^DIC(9.4,177,22,1,"PAH",10,1,109,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,110,0)="13. Modification: Added the COMMENT field (#.3) from the BCMA MEDICATION"
^DIC(9.4,177,22,1,"PAH",10,1,111,0)="    LOG file (#53.79) to the Medication Variance Log [PSBO MV] option."
^DIC(9.4,177,22,1,"PAH",10,1,112,0)="    E3R - 13732 and 14810"
^DIC(9.4,177,22,1,"PAH",10,1,113,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,114,0)="14. Modification: The message text the VDL displays when a patient has no"
^DIC(9.4,177,22,1,"PAH",10,1,115,0)="    orders have been modified. When there are no orders in VISTA for a"
^DIC(9.4,177,22,1,"PAH",10,1,116,0)="    selected patient the message, ""No Active Orders at this Time"" will be"
^DIC(9.4,177,22,1,"PAH",10,1,117,0)="    displayed. If there are orders in VISTA, but they do not fall within"
^DIC(9.4,177,22,1,"PAH",10,1,118,0)="    the start and stop times selected on the VDL the message,"
^DIC(9.4,177,22,1,"PAH",10,1,119,0)="    ""No Meds to be Administered for the Time Period Selected!"" will be"
^DIC(9.4,177,22,1,"PAH",10,1,120,0)="    displayed. If no schedule types are selected on the VDL the message,"
^DIC(9.4,177,22,1,"PAH",10,1,121,0)="    ""No Schedule Type(s) Selected!"" will be displayed."
^DIC(9.4,177,22,1,"PAH",10,1,122,0)="    E3R - 14680"
^DIC(9.4,177,22,1,"PAH",10,1,123,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,124,0)="15. Modification: The process of Auto-update has been added to the BCMA"
^DIC(9.4,177,22,1,"PAH",10,1,125,0)="    functionality. Auto update is the process of automatically copying"
^DIC(9.4,177,22,1,"PAH",10,1,126,0)="    updated BCMA files from a server network drive to a client."
^DIC(9.4,177,22,1,"PAH",10,1,127,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,128,0)="    The prompts ""The UNC of the Auto-update Server"" and ""Autoupdate"
^DIC(9.4,177,22,1,"PAH",10,1,129,0)="    Notification Mail Group"" have been added to Edit Divisional Parameters"
^DIC(9.4,177,22,1,"PAH",10,1,130,0)="    [PSB PARAMETERS] option."
^DIC(9.4,177,22,1,"PAH",10,1,131,0)=" "
^DIC(9.4,177,22,1,"PAH",10,1,132,0)="    Please read the ReadMe.txt file found in your BCMA directory for a"
^DIC(9.4,177,22,1,"PAH",10,1,133,0)="    full description on the GUI update functionality."
^DIC(9.4,177,22,1,"PAH",11,0)="10 SEQ #11^3010815^1"
^DIC(9.4,177,22,1,"PAH",11,1,0)="^^203^203^3010815"
^DIC(9.4,177,22,1,"PAH",11,1,1,0)="Patch PSB*1*10 contains the following:"
^DIC(9.4,177,22,1,"PAH",11,1,2,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,3,0)="1.  Problem: Orders with a day of the week schedule are generating"
^DIC(9.4,177,22,1,"PAH",11,1,4,0)="    false error messages to the due list error notification mail"
^DIC(9.4,177,22,1,"PAH",11,1,5,0)="    group. This occurs when the Virtual Due List (VDL) is opened"
^DIC(9.4,177,22,1,"PAH",11,1,6,0)="    on a day the order is not scheduled to be administered."
^DIC(9.4,177,22,1,"PAH",11,1,7,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,8,0)="    For example, an order with a schedule of MO-WE-FR"
^DIC(9.4,177,22,1,"PAH",11,1,9,0)="    will generate an error message to the mail group if the"
^DIC(9.4,177,22,1,"PAH",11,1,10,0)="    VDL is opened on Tuesday."
^DIC(9.4,177,22,1,"PAH",11,1,11,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,12,0)="    Corrective Action: BCMA has been modified to no longer"
^DIC(9.4,177,22,1,"PAH",11,1,13,0)="    generate an error messages to the due list error notification"
^DIC(9.4,177,22,1,"PAH",11,1,14,0)="    mail group when the VDL is opened on a non scheduled"
^DIC(9.4,177,22,1,"PAH",11,1,15,0)="    administration day."
^DIC(9.4,177,22,1,"PAH",11,1,16,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,17,0)="2.  Problem: The patient's weight displayed in the patient"
^DIC(9.4,177,22,1,"PAH",11,1,18,0)="    demographic box on the GUI VDL was incorrect."
^DIC(9.4,177,22,1,"PAH",11,1,19,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,20,0)="    Corrective Action: The calculation for the patient's weight has"
^DIC(9.4,177,22,1,"PAH",11,1,21,0)="    been modified."
^DIC(9.4,177,22,1,"PAH",11,1,22,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,23,0)="3.  Problem: If a drug contains a future inactive date, the Label"
^DIC(9.4,177,22,1,"PAH",11,1,24,0)="    Print [PSBO DL] option will not print the drug."
^DIC(9.4,177,22,1,"PAH",11,1,25,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,26,0)="    Corrective Action: The Label Print [PSBO DL] option has been modified"
^DIC(9.4,177,22,1,"PAH",11,1,27,0)="    to adhere to the future inactive date and print according to the date"
^DIC(9.4,177,22,1,"PAH",11,1,28,0)="    entered."
^DIC(9.4,177,22,1,"PAH",11,1,29,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,30,0)="4.  Problem: When a medication has been given and then the dispense"
^DIC(9.4,177,22,1,"PAH",11,1,31,0)="    drug has been changed on the order, the VDL will display the"
^DIC(9.4,177,22,1,"PAH",11,1,32,0)="    new dispense drug on the already given medication."
^DIC(9.4,177,22,1,"PAH",11,1,33,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,34,0)="    Corrective Action: The VDL has been modified to properly display"
^DIC(9.4,177,22,1,"PAH",11,1,35,0)="    any changes in dispense drugs on an order."
^DIC(9.4,177,22,1,"PAH",11,1,36,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,37,0)="5.  Problem: User received an undefined error when altering a medication"
^DIC(9.4,177,22,1,"PAH",11,1,38,0)="    status in Edit Medication Log [PSB MED LOG EDIT] option."
^DIC(9.4,177,22,1,"PAH",11,1,39,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,40,0)="    Corrective Action: The Edit Medication Log [PSB MED LOG EDIT] option"
^DIC(9.4,177,22,1,"PAH",11,1,41,0)="    has been modified to not generate an undefined error, by using"
^DIC(9.4,177,22,1,"PAH",11,1,42,0)="    standard coding logic."
^DIC(9.4,177,22,1,"PAH",11,1,43,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,44,0)="6.  Problem: The Medication Administration History (MAH) [PSBO MH] option"
^DIC(9.4,177,22,1,"PAH",11,1,45,0)="    generates a null subscript error when the nurse or pharmacist initials"
^DIC(9.4,177,22,1,"PAH",11,1,46,0)="    are not present."
^DIC(9.4,177,22,1,"PAH",11,1,47,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,48,0)="    Corrective Action: The MAH [PSBO MH] option has been modified to not"
^DIC(9.4,177,22,1,"PAH",11,1,49,0)="    generate an error when the nurse or pharmacist initials are not"
^DIC(9.4,177,22,1,"PAH",11,1,50,0)="    entered. The report will print without the initials."
^DIC(9.4,177,22,1,"PAH",11,1,51,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,52,0)="7.  Problem: Orders which contain an odd schedule were not printing on the"
^DIC(9.4,177,22,1,"PAH",11,1,53,0)="    Missed Medications [PSBO MM], Ward Administration Times [PSBO WA]"
^DIC(9.4,177,22,1,"PAH",11,1,54,0)="    and the Ward Administration Times [PSBO WA] reports."
^DIC(9.4,177,22,1,"PAH",11,1,55,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,56,0)="    Corrective Action: The reports have been modified to print"
^DIC(9.4,177,22,1,"PAH",11,1,57,0)="    odd schedule orders."
^DIC(9.4,177,22,1,"PAH",11,1,58,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,59,0)="8.  Problem: The Last Action column on the Virtual Due List is not"
^DIC(9.4,177,22,1,"PAH",11,1,60,0)="    displaying the four digit year."
^DIC(9.4,177,22,1,"PAH",11,1,61,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,62,0)="    Corrective Action: The Virtual Due List has been modified to display"
^DIC(9.4,177,22,1,"PAH",11,1,63,0)="    the full four digit year."
^DIC(9.4,177,22,1,"PAH",11,1,64,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,65,0)="9.  Problem:  In reference to the Medication Variance Log [PSBO VR]"
^DIC(9.4,177,22,1,"PAH",11,1,66,0)="    option, a site noticed that this report indicates only the patient"
^DIC(9.4,177,22,1,"PAH",11,1,67,0)="    current ward location when the report is generated.  Although the"
^DIC(9.4,177,22,1,"PAH",11,1,68,0)="    patient may have received several administrations of medications on"
^DIC(9.4,177,22,1,"PAH",11,1,69,0)="    different wards, the report does not denote the patient specific"
^DIC(9.4,177,22,1,"PAH",11,1,70,0)="    location when the medication was administrated.  The lack of this"
^DIC(9.4,177,22,1,"PAH",11,1,71,0)="    information made it difficult for providers to track down the"
^DIC(9.4,177,22,1,"PAH",11,1,72,0)="    locations that had irregularities in the administration of medications"
^DIC(9.4,177,22,1,"PAH",11,1,73,0)="    to the patients."
^DIC(9.4,177,22,1,"PAH",11,1,74,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,75,0)="    Corrective Action:  Modifications were made to the Medication Variance"
^DIC(9.4,177,22,1,"PAH",11,1,76,0)="    Log [PSBO VR] option to allow the report to display the patient"
^DIC(9.4,177,22,1,"PAH",11,1,77,0)="    location associated with each event date/time the medication was"
^DIC(9.4,177,22,1,"PAH",11,1,78,0)="    administrated to the patient."
^DIC(9.4,177,22,1,"PAH",11,1,79,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,80,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,81,0)="10. Problem: Intravenous (IV) orders with a schedule of one-time"
^DIC(9.4,177,22,1,"PAH",11,1,82,0)="    generate a ""Data Validation Error: 701: The value '.143022'"
^DIC(9.4,177,22,1,"PAH",11,1,83,0)="    for field ORDER ADMINISTRATION TIME in file BCMA MEDICATION LOG"
^DIC(9.4,177,22,1,"PAH",11,1,84,0)="    is not valid"" error when trying to mark them as started."
^DIC(9.4,177,22,1,"PAH",11,1,85,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,86,0)="    Corrective Action: BCMA has been modified to allow one-time"
^DIC(9.4,177,22,1,"PAH",11,1,87,0)="    IV orders to be marked as started without generating an error."
^DIC(9.4,177,22,1,"PAH",11,1,88,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,89,0)="11. Problem: The VDL is displaying an incorrect message when a medication"
^DIC(9.4,177,22,1,"PAH",11,1,90,0)="    is marked as held. For example, when a medication is marked as held"
^DIC(9.4,177,22,1,"PAH",11,1,91,0)="    and the user tries to mark the next medication as given, the message"
^DIC(9.4,177,22,1,"PAH",11,1,92,0)="    ""*** NOTICE, Aspirin was given 2 minutes ago"" is being displayed."
^DIC(9.4,177,22,1,"PAH",11,1,93,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,94,0)="    Corrective Action: The message has been updated to properly"
^DIC(9.4,177,22,1,"PAH",11,1,95,0)="    reflect the change in status. The new message displayed in the"
^DIC(9.4,177,22,1,"PAH",11,1,96,0)="    above example is;"
^DIC(9.4,177,22,1,"PAH",11,1,97,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,98,0)="    ""*** NOTICE, Aspirin was HELD 2 minutes ago"""
^DIC(9.4,177,22,1,"PAH",11,1,99,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,100,0)="12. Problem: An undefined variable error is generated in the"
^DIC(9.4,177,22,1,"PAH",11,1,101,0)="    Missing Dose Report [PSBO MD] option when searching for"
^DIC(9.4,177,22,1,"PAH",11,1,102,0)="    an MAS ward."
^DIC(9.4,177,22,1,"PAH",11,1,103,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,104,0)="    Corrective Action: The code has been modified to properly"
^DIC(9.4,177,22,1,"PAH",11,1,105,0)="    loop through the MAS ward locations and not generate an"
^DIC(9.4,177,22,1,"PAH",11,1,106,0)="    error."
^DIC(9.4,177,22,1,"PAH",11,1,107,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,108,0)="13. Problem: If a patient has an 2 orders with the same orderable"
^DIC(9.4,177,22,1,"PAH",11,1,109,0)="    item and 2 different dispense drugs, the Ward Administration"
^DIC(9.4,177,22,1,"PAH",11,1,110,0)="    Times [PSBO WA] option will only print the first order on"
^DIC(9.4,177,22,1,"PAH",11,1,111,0)="    the report."
^DIC(9.4,177,22,1,"PAH",11,1,112,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,113,0)="    Corrective Action: The Ward Administration Times [PSBO WA]"
^DIC(9.4,177,22,1,"PAH",11,1,114,0)="    option has been corrected to display both orders."
^DIC(9.4,177,22,1,"PAH",11,1,115,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,116,0)="14. Problem: If the administration time and the Virtual Due List"
^DIC(9.4,177,22,1,"PAH",11,1,117,0)="    Parameters Start Time: are equal to 2400, the dose would"
^DIC(9.4,177,22,1,"PAH",11,1,118,0)="    not display on the VDL."
^DIC(9.4,177,22,1,"PAH",11,1,119,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,120,0)="    Corrective Action: The VDL has been modified to properly display"
^DIC(9.4,177,22,1,"PAH",11,1,121,0)="    the 2400 medication."
^DIC(9.4,177,22,1,"PAH",11,1,122,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,123,0)="15. Problem: An odd schedule order will only print the first two digits"
^DIC(9.4,177,22,1,"PAH",11,1,124,0)="    of the administration time on the Due List [PSBO DL] option."
^DIC(9.4,177,22,1,"PAH",11,1,125,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,126,0)="    Corrective Action: Odd schedule administration times will now print"
^DIC(9.4,177,22,1,"PAH",11,1,127,0)="    military time on the Due List [PSBO DL] option."
^DIC(9.4,177,22,1,"PAH",11,1,128,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,129,0)="16. Problem: If an odd schedule order calculates an administration"
^DIC(9.4,177,22,1,"PAH",11,1,130,0)="    time to be 2400. The GUI VDL will display ""3030@3010"" in the"
^DIC(9.4,177,22,1,"PAH",11,1,131,0)="    ""Admin Time"" column."
^DIC(9.4,177,22,1,"PAH",11,1,132,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,133,0)="    Corrective Action: The calculated admin time for midnight dose"
^DIC(9.4,177,22,1,"PAH",11,1,134,0)="    will now properly display 2400 in the ""Admin Time"" column."
^DIC(9.4,177,22,1,"PAH",11,1,135,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,136,0)="17. Problem: If an order contained an odd schedule greater than"
^DIC(9.4,177,22,1,"PAH",11,1,137,0)="    24 hours, the subsequent doses would not display on the VDL."
^DIC(9.4,177,22,1,"PAH",11,1,138,0)="    For example, if an order has a schedule of Q36H only the first"
^DIC(9.4,177,22,1,"PAH",11,1,139,0)="    dose would display on the VDL."
^DIC(9.4,177,22,1,"PAH",11,1,140,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,141,0)="    Corrective Action: BCMA has been modified to properly calculate"
^DIC(9.4,177,22,1,"PAH",11,1,142,0)="    the subsequent doses for an odd schedule greater than 24 hours."
^DIC(9.4,177,22,1,"PAH",11,1,143,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,144,0)="18. Modification: The Label Print [PSBO BL] option has been"
^DIC(9.4,177,22,1,"PAH",11,1,145,0)="    modified to validate the drug requested for printing and the"
^DIC(9.4,177,22,1,"PAH",11,1,146,0)="    patient's current orders. If a drug is selected to print"
^DIC(9.4,177,22,1,"PAH",11,1,147,0)="    that the patient does not have a current order on. The"
^DIC(9.4,177,22,1,"PAH",11,1,148,0)="    following message will display"
^DIC(9.4,177,22,1,"PAH",11,1,149,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,150,0)="    ""Patient not currently on medication: XYZ Med (Qty: 1)"""
^DIC(9.4,177,22,1,"PAH",11,1,151,0)="    Do you want to continue?"
^DIC(9.4,177,22,1,"PAH",11,1,152,0)="    E3R Number: 13809"
^DIC(9.4,177,22,1,"PAH",11,1,153,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,154,0)="19. Modification: When the user performs a right-click on the VDL,"
^DIC(9.4,177,22,1,"PAH",11,1,155,0)="    the Start IV status on the VDL has been modified to Start."
^DIC(9.4,177,22,1,"PAH",11,1,156,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,157,0)="20. Modification: The GUI BCMA Site Parameters has been updated to include"
^DIC(9.4,177,22,1,"PAH",11,1,158,0)="    the following; Default Bar Code Format, Default Bar Code"
^DIC(9.4,177,22,1,"PAH",11,1,159,0)="    Prefix, Using Robot Rx, Allow Multiple Administration for On-Call,"
^DIC(9.4,177,22,1,"PAH",11,1,160,0)="    UNC of the Auto Update Server, Auto Update Notification,"
^DIC(9.4,177,22,1,"PAH",11,1,161,0)="    Default Prompt for INCL TRANSFERS, One Time Parameter."
^DIC(9.4,177,22,1,"PAH",11,1,162,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,163,0)="    The Edit Divisional Parameters [PSB PARAMETERS] option will no"
^DIC(9.4,177,22,1,"PAH",11,1,164,0)="    longer be updated or maintained. All future enhancements and"
^DIC(9.4,177,22,1,"PAH",11,1,165,0)="    modifications will be made on the GUI BCMA Site Parameters."
^DIC(9.4,177,22,1,"PAH",11,1,166,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,167,0)="21. Modification: The Missing Dose Request [PSB MISSING DOSE REQUEST]"
^DIC(9.4,177,22,1,"PAH",11,1,168,0)="    option was modified to prompt the user for the dosage schedule."
^DIC(9.4,177,22,1,"PAH",11,1,169,0)="    In the BCMA MISSING DOSE REQUEST file (#53.68), the SCHEDULE field"
^DIC(9.4,177,22,1,"PAH",11,1,170,0)="    (#.19) has been added as a required field to store the schedule"
^DIC(9.4,177,22,1,"PAH",11,1,171,0)="    information."
^DIC(9.4,177,22,1,"PAH",11,1,172,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,173,0)="22. Modification: The Missing Dose Report [PSBO MD] option was"
^DIC(9.4,177,22,1,"PAH",11,1,174,0)="    modified to display the dosage schedule."
^DIC(9.4,177,22,1,"PAH",11,1,175,0)="    E3R Number: 13030"
^DIC(9.4,177,22,1,"PAH",11,1,176,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,177,0)="23. Modification: The Missing Dose Request [PSB MISSING DOSE REQUEST]"
^DIC(9.4,177,22,1,"PAH",11,1,178,0)="    option was modified to display the patient's social security number"
^DIC(9.4,177,22,1,"PAH",11,1,179,0)="    (last four digits), ward location, and room/bed information in the"
^DIC(9.4,177,22,1,"PAH",11,1,180,0)="    e-mail message sent to the missing dose notification mail group."
^DIC(9.4,177,22,1,"PAH",11,1,181,0)="    E3R Number: 12780"
^DIC(9.4,177,22,1,"PAH",11,1,182,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,183,0)="24. Modification: Modified the right click 'Display Order'"
^DIC(9.4,177,22,1,"PAH",11,1,184,0)="    accelerator key to 'O' to match accelerator key on menu option."
^DIC(9.4,177,22,1,"PAH",11,1,185,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,186,0)="    Modified the right click 'Drug IEN Code' accelerator"
^DIC(9.4,177,22,1,"PAH",11,1,187,0)="    key to 'D' to match accelerator key on menu option."
^DIC(9.4,177,22,1,"PAH",11,1,188,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,189,0)="    Accelerator keys enable the user to access a menu command"
^DIC(9.4,177,22,1,"PAH",11,1,190,0)="    from the keyboard by pressing Alt+ the appropriate letter."
^DIC(9.4,177,22,1,"PAH",11,1,191,0)="    E3R Number: 15291"
^DIC(9.4,177,22,1,"PAH",11,1,192,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,193,0)="25. Modification:  The (MAH) [PSBO MH] option has been modified"
^DIC(9.4,177,22,1,"PAH",11,1,194,0)="    to display an asterisk with the initial if a student"
^DIC(9.4,177,22,1,"PAH",11,1,195,0)="    administered a medication.  In the legend section on the MAH"
^DIC(9.4,177,22,1,"PAH",11,1,196,0)="    report, this asterisk will correspond to the student and the"
^DIC(9.4,177,22,1,"PAH",11,1,197,0)="    instructors initials, names, and date/time the medication"
^DIC(9.4,177,22,1,"PAH",11,1,198,0)="    was given."
^DIC(9.4,177,22,1,"PAH",11,1,199,0)="    E3R Number: 14609"
^DIC(9.4,177,22,1,"PAH",11,1,200,0)=" "
^DIC(9.4,177,22,1,"PAH",11,1,201,0)="26. Modification: The (MAH) [PSBO MH] option has been modified"
^DIC(9.4,177,22,1,"PAH",11,1,202,0)="    to print an ""***"" in the date column when an order is discontinued."
^DIC(9.4,177,22,1,"PAH",11,1,203,0)="    E3R Number: 13413/13852"
^DIC(9.4,177,22,1,"PAH",12,0)="15 SEQ #12^3010926^1"
^DIC(9.4,177,22,1,"PAH",12,1,0)="^^48^48^3010926"
^DIC(9.4,177,22,1,"PAH",12,1,1,0)="A problem was found in PSB*1*10 with how the Bar Code Medication"
^DIC(9.4,177,22,1,"PAH",12,1,2,0)="Administration (BCMA) Virtual Due List (VDL) processes orders with"
^DIC(9.4,177,22,1,"PAH",12,1,3,0)="certain schedules. Below are the listed problems found with PSB*1*10."
^DIC(9.4,177,22,1,"PAH",12,1,4,0)="Please note: PSB*1*10 should not be removed. PSB*1*15 has been developed"
^DIC(9.4,177,22,1,"PAH",12,1,5,0)="to address these problems."
^DIC(9.4,177,22,1,"PAH",12,1,6,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,7,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,8,0)="1. Problem: The Missing Dose Report [PSBO MD] option is generating an"
^DIC(9.4,177,22,1,"PAH",12,1,9,0)="   illegal number error when a user tries to run the report. This was due"
^DIC(9.4,177,22,1,"PAH",12,1,10,0)="   to the BCMA MISSING DOSE REQUEST file (#53.68) storing the external"
^DIC(9.4,177,22,1,"PAH",12,1,11,0)="   room-bed value."
^DIC(9.4,177,22,1,"PAH",12,1,12,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,13,0)="   Corrective Action: The Missing Dose Report [PSBO MD] option was"
^DIC(9.4,177,22,1,"PAH",12,1,14,0)="   corrected by properly storing the internal room-bed value in"
^DIC(9.4,177,22,1,"PAH",12,1,15,0)="   the BCMA MISSING DOSE REQUEST file (#53.68)."
^DIC(9.4,177,22,1,"PAH",12,1,16,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,17,0)="2. Problem: Orders that contain administration times (0900-1500) as"
^DIC(9.4,177,22,1,"PAH",12,1,18,0)="   a schedule do not display on the VDL. When a"
^DIC(9.4,177,22,1,"PAH",12,1,19,0)="   user tries to access the BCMA VDL, a MailMan message will be sent"
^DIC(9.4,177,22,1,"PAH",12,1,20,0)="   to the Due List Error Notification Mail Group for the pharmacist"
^DIC(9.4,177,22,1,"PAH",12,1,21,0)="   to correct the order. The message that is generated is stated below:"
^DIC(9.4,177,22,1,"PAH",12,1,22,0)="   ""No Admin time required for non-standard schedules."""
^DIC(9.4,177,22,1,"PAH",12,1,23,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,24,0)="   Corrective Action: The VDL has been corrected to properly display"
^DIC(9.4,177,22,1,"PAH",12,1,25,0)="   orders that contain an administration time (0900-1500) as a schedule."
^DIC(9.4,177,22,1,"PAH",12,1,26,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,27,0)="3. Problem: When printing the Missed Medications [PSBO MM] option report"
^DIC(9.4,177,22,1,"PAH",12,1,28,0)="   by ward, there would be no truncation between data. This resulted in"
^DIC(9.4,177,22,1,"PAH",12,1,29,0)="   data overlapping, making the report unreadable."
^DIC(9.4,177,22,1,"PAH",12,1,30,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,31,0)="   Corrective Action: To display all the data in a readable format, the"
^DIC(9.4,177,22,1,"PAH",12,1,32,0)="   Missed Medications [PSBO MM] option report has been modified by"
^DIC(9.4,177,22,1,"PAH",12,1,33,0)="   removing the ward location as a column. The ward location still"
^DIC(9.4,177,22,1,"PAH",12,1,34,0)="   displays as a header."
^DIC(9.4,177,22,1,"PAH",12,1,35,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,36,0)="4. Problem: Orders that contain a standard day of the week schedule"
^DIC(9.4,177,22,1,"PAH",12,1,37,0)="   (i.e. MO-TU@0900) that are in the ADMINISTRATION SCHEDULE file (#51.1)"
^DIC(9.4,177,22,1,"PAH",12,1,38,0)="   do not display properly on the VDL."
^DIC(9.4,177,22,1,"PAH",12,1,39,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,40,0)="   Corrective Action: The VDL has been corrected to properly display"
^DIC(9.4,177,22,1,"PAH",12,1,41,0)="   standard day of the week schedules."
^DIC(9.4,177,22,1,"PAH",12,1,42,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,43,0)="5. Problem: IV Piggyback orders that contain a standard schedule (Q8H)"
^DIC(9.4,177,22,1,"PAH",12,1,44,0)="   with no frequency defined in the ADMINISTRATION SCHEDULE file #(51.1)"
^DIC(9.4,177,22,1,"PAH",12,1,45,0)="   do not display on the VDL."
^DIC(9.4,177,22,1,"PAH",12,1,46,0)=" "
^DIC(9.4,177,22,1,"PAH",12,1,47,0)="   Corrective Action: The VDL has been corrected to properly display these"
^DIC(9.4,177,22,1,"PAH",12,1,48,0)="   these types of orders."
^DIC(9.4,177,22,1,"PAH",13,0)="13^3011231^1"
^DIC(9.4,177,22,1,"PAH",13,1,0)="^^30^30^3011231"
^DIC(9.4,177,22,1,"PAH",13,1,1,0)="1. A site reported a problem where a one-time order could not be"
^DIC(9.4,177,22,1,"PAH",13,1,2,0)=" discontinued by the provider because it was expired due to the start and"
^DIC(9.4,177,22,1,"PAH",13,1,3,0)=" stop date being the same. However, the medication still displayed in Bar"
^DIC(9.4,177,22,1,"PAH",13,1,4,0)=" Code Medication Administration (BCMA) V. 1.0 because of the 12-hour rule "
^DIC(9.4,177,22,1,"PAH",13,1,5,0)=" for displaying one-time orders on the Virtual Due List.  This patch"
^DIC(9.4,177,22,1,"PAH",13,1,6,0)=" corrects this problem by changing the way the one-time orders is"
^DIC(9.4,177,22,1,"PAH",13,1,7,0)=" calculated. There will be a ward parameter, system parameter and the"
^DIC(9.4,177,22,1,"PAH",13,1,8,0)=" standard calculation.  The hierarchy will be to check the one-time ward"
^DIC(9.4,177,22,1,"PAH",13,1,9,0)=" parameter first, if not defined, check the system parameter.  If the"
^DIC(9.4,177,22,1,"PAH",13,1,10,0)=" system parameter is not defined, the system will use the continuous order"
^DIC(9.4,177,22,1,"PAH",13,1,11,0)=" parameters to determine the stop date, rather than the start and stop "
^DIC(9.4,177,22,1,"PAH",13,1,12,0)=" date being equal.  Then, when BCMA marks the medication as 'Given',"
^DIC(9.4,177,22,1,"PAH",13,1,13,0)=" Inpatient Medications will expire the order. NOIS# BUT-0501-20609."
^DIC(9.4,177,22,1,"PAH",13,1,14,0)=" "
^DIC(9.4,177,22,1,"PAH",13,1,15,0)="2. Manual Medication Entry [PSB MED LOG NEW ENTRY] option was generating a"
^DIC(9.4,177,22,1,"PAH",13,1,16,0)=" false Due List Error Notification message when accessed."
^DIC(9.4,177,22,1,"PAH",13,1,17,0)=" "
^DIC(9.4,177,22,1,"PAH",13,1,18,0)=" BCMA V. 1.0 has been corrected to no longer generate an e-mail message."
^DIC(9.4,177,22,1,"PAH",13,1,19,0)=" NOIS# NOP-0801-11096"
^DIC(9.4,177,22,1,"PAH",13,1,20,0)="       CTX-0801-72721"
^DIC(9.4,177,22,1,"PAH",13,1,21,0)=" "
^DIC(9.4,177,22,1,"PAH",13,1,22,0)=" This project consists of a master build containing three patches that "
^DIC(9.4,177,22,1,"PAH",13,1,23,0)=" work together to accomplish these goals listed in order of install."
^DIC(9.4,177,22,1,"PAH",13,1,24,0)=" Installation of this master build should be coordinated among the three"
^DIC(9.4,177,22,1,"PAH",13,1,25,0)=" packages affected since only one installation is necessary. The patches,"
^DIC(9.4,177,22,1,"PAH",13,1,26,0)=" in order of install, are:"
^DIC(9.4,177,22,1,"PAH",13,1,27,0)=" "
^DIC(9.4,177,22,1,"PAH",13,1,28,0)="       PSS*1*44  PHARMACY DATA MANAGEMENT V. 1.0"
^DIC(9.4,177,22,1,"PAH",13,1,29,0)="       PSJ*5*63  INPATIENT MEDICATIONS V. 5.0"
^DIC(9.4,177,22,1,"PAH",13,1,30,0)="       PSB*1*13  BAR CODE MEDICATION ADMINISTRATION V. 1.0"
^DIC(9.4,177,22,1,"PAH",14,0)="14 SEQ #14^3020204^1"
^DIC(9.4,177,22,1,"PAH",14,1,0)="^^54^54^3020204"
^DIC(9.4,177,22,1,"PAH",14,1,1,0)="Patch PSB*1*14 contains the following:"
^DIC(9.4,177,22,1,"PAH",14,1,2,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,3,0)="1.  Problem: The Enter PRN Effectiveness [PSB MED LOG PRN EFFECT] option"
^DIC(9.4,177,22,1,"PAH",14,1,4,0)="    did not properly refresh after entering an effectiveness past the"
^DIC(9.4,177,22,1,"PAH",14,1,5,0)="    allowed time."
^DIC(9.4,177,22,1,"PAH",14,1,6,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,7,0)="    Corrective Action: The refresh command was added to the menu option"
^DIC(9.4,177,22,1,"PAH",14,1,8,0)="    to properly display the screen."
^DIC(9.4,177,22,1,"PAH",14,1,9,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,10,0)="2.  Problem: In reference to the Missing Dose Request Report [PSB MISSING"
^DIC(9.4,177,22,1,"PAH",14,1,11,0)="    DOSE REQUEST] option, the dosage schedule was added to the report"
^DIC(9.4,177,22,1,"PAH",14,1,12,0)="    in PSB*1*10; however, each medication order was counted or"
^DIC(9.4,177,22,1,"PAH",14,1,13,0)="    displayed individually.  The sites would like the report to"
^DIC(9.4,177,22,1,"PAH",14,1,14,0)="    display a sum of identical medication orders."
^DIC(9.4,177,22,1,"PAH",14,1,15,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,16,0)="    Corrective Action: Modifications were made to display the sum of"
^DIC(9.4,177,22,1,"PAH",14,1,17,0)="    medication orders that was identical and had an identical dosage"
^DIC(9.4,177,22,1,"PAH",14,1,18,0)="    schedule."
^DIC(9.4,177,22,1,"PAH",14,1,19,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,20,0)="3.  Problem:  When a user selects to sort or print The Medication Variance"
^DIC(9.4,177,22,1,"PAH",14,1,21,0)="    Log [PSBO MV] option by ward, the report displays the variance"
^DIC(9.4,177,22,1,"PAH",14,1,22,0)="    information for all Wards.  The site would like the report to"
^DIC(9.4,177,22,1,"PAH",14,1,23,0)="    display only the variance information related to the Ward selected"
^DIC(9.4,177,22,1,"PAH",14,1,24,0)="    via ScreenMan."
^DIC(9.4,177,22,1,"PAH",14,1,25,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,26,0)="    Corrective Action:  Modifications were made to the option to display"
^DIC(9.4,177,22,1,"PAH",14,1,27,0)="    only the variance information related to the selected Ward."
^DIC(9.4,177,22,1,"PAH",14,1,28,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,29,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,30,0)="4.  Problem:  If the user enters in an old date (i.e. 1/21/1931), when"
^DIC(9.4,177,22,1,"PAH",14,1,31,0)="    running the Due List [PSBO DL] option, Bar Code Medication"
^DIC(9.4,177,22,1,"PAH",14,1,32,0)="    Administration (BCMA) generates an undefined variable error."
^DIC(9.4,177,22,1,"PAH",14,1,33,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,34,0)="    Corrective Action: The Due List [PSBO DL] option does not generate"
^DIC(9.4,177,22,1,"PAH",14,1,35,0)="    an error when an old date is entered."
^DIC(9.4,177,22,1,"PAH",14,1,36,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,37,0)="5.  Problem:  If an order was placed with a schedule of Q3MONTHS, it would"
^DIC(9.4,177,22,1,"PAH",14,1,38,0)="    display on the  Virtual Due List (VDL) everyday."
^DIC(9.4,177,22,1,"PAH",14,1,39,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,40,0)="    Corrective Action: The VDL was corrected to display an order with"
^DIC(9.4,177,22,1,"PAH",14,1,41,0)="    a schedule of Q3MONTHS, once every 3 months."
^DIC(9.4,177,22,1,"PAH",14,1,42,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,43,0)="6.  Problem:  The word missing is misspelled in the report header of the"
^DIC(9.4,177,22,1,"PAH",14,1,44,0)="    Missing Dose Followup [PSB MISSING DOSE FOLLOWUP] option. The header"
^DIC(9.4,177,22,1,"PAH",14,1,45,0)="    displays ""Currently Unresolved Mising Dose Requests"""
^DIC(9.4,177,22,1,"PAH",14,1,46,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,47,0)="    Corrective Action: The misspelled word has been corrected."
^DIC(9.4,177,22,1,"PAH",14,1,48,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,49,0)="7.  Problem:  The Missed Medications [PSBO MM] option report does not"
^DIC(9.4,177,22,1,"PAH",14,1,50,0)="    display the first dose for an odd schedule."
^DIC(9.4,177,22,1,"PAH",14,1,51,0)=" "
^DIC(9.4,177,22,1,"PAH",14,1,52,0)="    Corrective Action: The Missed Medications [PSBO MM] option report"
^DIC(9.4,177,22,1,"PAH",14,1,53,0)="    has been modified to properly display the first dose for an odd"
^DIC(9.4,177,22,1,"PAH",14,1,54,0)="    schedule."
^DIC(9.4,177,22,1,"PAH","B",13,13)=""
^DIC(9.4,177,22,1,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,177,22,1,"PAH","B","10 SEQ #11",11)=""
^DIC(9.4,177,22,1,"PAH","B","11 SEQ #9",9)=""
^DIC(9.4,177,22,1,"PAH","B","14 SEQ #14",14)=""
^DIC(9.4,177,22,1,"PAH","B","15 SEQ #12",12)=""
^DIC(9.4,177,22,1,"PAH","B","2 SEQ #2",2)=""
^DIC(9.4,177,22,1,"PAH","B","3 SEQ #3",3)=""
^DIC(9.4,177,22,1,"PAH","B","4 SEQ #4",4)=""
^DIC(9.4,177,22,1,"PAH","B","5 SEQ #5",5)=""
^DIC(9.4,177,22,1,"PAH","B","6 SEQ #6",6)=""
^DIC(9.4,177,22,1,"PAH","B","7 SEQ #8",8)=""
^DIC(9.4,177,22,1,"PAH","B","8 SEQ #7",7)=""
^DIC(9.4,177,22,1,"PAH","B","9 SEQ #10",10)=""
^DIC(9.4,177,22,2,0)="2.0^3051119^3020528^1"
^DIC(9.4,177,22,2,1,0)="^^1^1^3051119"
^DIC(9.4,177,22,2,1,1,0)="BAR CODE MED ADMIN - VERSION 2.0"
^DIC(9.4,177,22,2,"PAH",0)="^9.4901^33^33"
^DIC(9.4,177,22,2,"PAH",1,0)="1 SEQ #2^3020906^1"
^DIC(9.4,177,22,2,"PAH",1,1,0)="^^77^77^3020906"
^DIC(9.4,177,22,2,"PAH",1,1,1,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,2,0)="1.  Problem: If a medication is marked from given to not given to"
^DIC(9.4,177,22,2,"PAH",1,1,3,0)="    given, the Medication Administration History (MAH) [PSBO MH] option"
^DIC(9.4,177,22,2,"PAH",1,1,4,0)="    would display these actions as three separate administration actions"
^DIC(9.4,177,22,2,"PAH",1,1,5,0)="    of given, not given and given."
^DIC(9.4,177,22,2,"PAH",1,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,7,0)="    Corrective Action: The MAH will now properly display these three"
^DIC(9.4,177,22,2,"PAH",1,1,8,0)="    actions as one correct action."
^DIC(9.4,177,22,2,"PAH",1,1,9,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,10,0)="2.  Problem: Version 2.0 beta test sites experienced errors in"
^DIC(9.4,177,22,2,"PAH",1,1,11,0)="    routines PSBMD and PSBVDLU1."
^DIC(9.4,177,22,2,"PAH",1,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,13,0)="    Corrective Action: The errors experienced in those routines have"
^DIC(9.4,177,22,2,"PAH",1,1,14,0)="    been corrected."
^DIC(9.4,177,22,2,"PAH",1,1,15,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,16,0)="3.  Problem: With the installation of BCMA version 2.0, routine PSBIPM was"
^DIC(9.4,177,22,2,"PAH",1,1,17,0)="    renamed to PSBAPIM."
^DIC(9.4,177,22,2,"PAH",1,1,18,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,19,0)="    Corrective Action: PSBIPM is no longer being used in version 2 and "
^DIC(9.4,177,22,2,"PAH",1,1,20,0)="    will be removed with this patch."
^DIC(9.4,177,22,2,"PAH",1,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,22,0)="4.  Problem: With the installation of BCMA version 2.0, the Edit "
^DIC(9.4,177,22,2,"PAH",1,1,23,0)="    Divisional Parameters [PSB PARAMETERS] option is no longer functional."
^DIC(9.4,177,22,2,"PAH",1,1,24,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,25,0)="    Corrective Action: The Edit Divisional Parameters [PSB PARAMETERS]"
^DIC(9.4,177,22,2,"PAH",1,1,26,0)="    option will be removed with this patch. Any access to site parameters"
^DIC(9.4,177,22,2,"PAH",1,1,27,0)="    needs to be made through the GUI BCMA Site Parameters application."
^DIC(9.4,177,22,2,"PAH",1,1,28,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,29,0)="5.  Problem: The Missed Medications [PSBO MM] option was generating"
^DIC(9.4,177,22,2,"PAH",1,1,30,0)="    the Due List Error Notification message, ""No admin time required for a"
^DIC(9.4,177,22,2,"PAH",1,1,31,0)="    Non-Standard schedule,"" on expired orders."
^DIC(9.4,177,22,2,"PAH",1,1,32,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,33,0)="    Corrective Action: The Missed Medications [PSBO MM] option will no"
^DIC(9.4,177,22,2,"PAH",1,1,34,0)="    longer generate the message ""No admin time required for a Non-Standard"
^DIC(9.4,177,22,2,"PAH",1,1,35,0)="    schedule"" on expired orders."
^DIC(9.4,177,22,2,"PAH",1,1,36,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,37,0)="6.  Problem: When an order has a schedule in the day of week format, and"
^DIC(9.4,177,22,2,"PAH",1,1,38,0)="    had a frequency associated with it, the order was not displaying on "
^DIC(9.4,177,22,2,"PAH",1,1,39,0)="    the Virtual Due List (VDL) on the days scheduled."
^DIC(9.4,177,22,2,"PAH",1,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,41,0)="    Corrective Action: An order with a schedule in the day of week format"
^DIC(9.4,177,22,2,"PAH",1,1,42,0)="    and a frequency associated with it, will display correctly on the"
^DIC(9.4,177,22,2,"PAH",1,1,43,0)="    VDL on the days scheduled."
^DIC(9.4,177,22,2,"PAH",1,1,44,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,45,0)="7.  Problem: The ""Order Num"" column was printing next to the ""Medication"""
^DIC(9.4,177,22,2,"PAH",1,1,46,0)="    column on the Missed Medications [PSBO MM] option. This caused some"
^DIC(9.4,177,22,2,"PAH",1,1,47,0)="    confusion with the order number being interpreted as a dosage for"
^DIC(9.4,177,22,2,"PAH",1,1,48,0)="    some medications."
^DIC(9.4,177,22,2,"PAH",1,1,49,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,50,0)="    Corrective Action:  The ""Order Num"" column was moved to be the"
^DIC(9.4,177,22,2,"PAH",1,1,51,0)="    first column on the Missed Medications [PSBO MM] option."
^DIC(9.4,177,22,2,"PAH",1,1,52,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,53,0)="8.  Problem: The Edit Medication Log [PSB MED LOG EDIT] option allowed"
^DIC(9.4,177,22,2,"PAH",1,1,54,0)="    a medication patch to be marked not given from removed."
^DIC(9.4,177,22,2,"PAH",1,1,55,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,56,0)="    Corrective Action: The Edit Medication Log [PSB MED LOG EDIT] option"
^DIC(9.4,177,22,2,"PAH",1,1,57,0)="    has been modified to not allow a patch to be marked as not given"
^DIC(9.4,177,22,2,"PAH",1,1,58,0)="    from removed."
^DIC(9.4,177,22,2,"PAH",1,1,59,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,60,0)="9.  Problem: One-time orders with a future start date/time would print"
^DIC(9.4,177,22,2,"PAH",1,1,61,0)="    on the Missed Medications [PSBO MM] option."
^DIC(9.4,177,22,2,"PAH",1,1,62,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,63,0)="    Corrective Action: The Missed Medications [PSBO MM] option has been"
^DIC(9.4,177,22,2,"PAH",1,1,64,0)="    corrected to only print one-time order when the order start date/time"
^DIC(9.4,177,22,2,"PAH",1,1,65,0)="    is within the report start and stop date/time."
^DIC(9.4,177,22,2,"PAH",1,1,66,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,67,0)="10. Problem: IV orders with a future start date and time would display"
^DIC(9.4,177,22,2,"PAH",1,1,68,0)="    on the IV tab of the VDL before due."
^DIC(9.4,177,22,2,"PAH",1,1,69,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,70,0)="    Corrective Action: The IV tab of the VDL has been modified to not"
^DIC(9.4,177,22,2,"PAH",1,1,71,0)="    display IV order until the order start date and time has been reached."
^DIC(9.4,177,22,2,"PAH",1,1,72,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,73,0)="11. Problem: The GUI generated an error when attempting to display"
^DIC(9.4,177,22,2,"PAH",1,1,74,0)="    unit dose orders on the VDL."
^DIC(9.4,177,22,2,"PAH",1,1,75,0)=" "
^DIC(9.4,177,22,2,"PAH",1,1,76,0)="    Corrective Action: The VDL has been modified to properly display"
^DIC(9.4,177,22,2,"PAH",1,1,77,0)="    unit dose orders on the VDL."
^DIC(9.4,177,22,2,"PAH",2,0)="5 SEQ #3^3020906^1"
^DIC(9.4,177,22,2,"PAH",2,1,0)="^^19^19^3020906"
^DIC(9.4,177,22,2,"PAH",2,1,1,0)="1. Problem: The ""BCMA ORDER LAST ACTION:"", which is displayed in order "
^DIC(9.4,177,22,2,"PAH",2,1,2,0)="   view screen under Inpatient Medications V 5.0., was displaying the "
^DIC(9.4,177,22,2,"PAH",2,1,3,0)="   last action by orderable item instead of the order number."
^DIC(9.4,177,22,2,"PAH",2,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",2,1,5,0)="   Corrective Action: The ""BCMA ORDER LAST ACTION:"" has been corrected to"
^DIC(9.4,177,22,2,"PAH",2,1,6,0)="   display the last action by order number."
^DIC(9.4,177,22,2,"PAH",2,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",2,1,8,0)="2. Problem: BCMA was generating the message below when a nurse"
^DIC(9.4,177,22,2,"PAH",2,1,9,0)="   tried to administer a medication that had a fractional dose ordered of"
^DIC(9.4,177,22,2,"PAH",2,1,10,0)="   more then two digits. Please see example below."
^DIC(9.4,177,22,2,"PAH",2,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",2,1,12,0)="   The value 0.125 for field DOSES GIVEN in dispense drug subfield in file"
^DIC(9.4,177,22,2,"PAH",2,1,13,0)="   BCMA MEDICATION LOG IS NOT VALID"
^DIC(9.4,177,22,2,"PAH",2,1,14,0)=" "
^DIC(9.4,177,22,2,"PAH",2,1,15,0)="   The value 0.125 for field DOSES ORDERED in dispense drug subfield in "
^DIC(9.4,177,22,2,"PAH",2,1,16,0)="   file BCMA MEDICATION LOG IS NOT VALID"
^DIC(9.4,177,22,2,"PAH",2,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",2,1,18,0)="   Corrective Action: BCMA has been modified to accept up to four"
^DIC(9.4,177,22,2,"PAH",2,1,19,0)="   fractional digits for doses ordered and doses given."
^DIC(9.4,177,22,2,"PAH",3,0)="2 SEQ #4^3020927^1"
^DIC(9.4,177,22,2,"PAH",3,1,0)="^^20^20^3020927"
^DIC(9.4,177,22,2,"PAH",3,1,1,0)="1. Problem: The Bar Code Medication Administration (BCMA) Order Manager"
^DIC(9.4,177,22,2,"PAH",3,1,2,0)="   dialogue box from the CPRS Med Order button displays the"
^DIC(9.4,177,22,2,"PAH",3,1,3,0)="   ""Invalid Medication Lookup, DO NOT GIVE!!"""
^DIC(9.4,177,22,2,"PAH",3,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",3,1,5,0)="   Corrective Action: The BCMA Order Manager dialogue box has been"
^DIC(9.4,177,22,2,"PAH",3,1,6,0)="   corrected to perform a lookup on the drug synonym number."
^DIC(9.4,177,22,2,"PAH",3,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",3,1,8,0)="2. Problem: The user will receive the ""Invalid Medication Lookup,"
^DIC(9.4,177,22,2,"PAH",3,1,9,0)="   DO NOT GIVE!!"" error message box when scanning an IV bag to create"
^DIC(9.4,177,22,2,"PAH",3,1,10,0)="   a ward stock entry on GUI BCMA."
^DIC(9.4,177,22,2,"PAH",3,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",3,1,12,0)="   Corrective Action: GUI BCMA has been modified to regconize the synonym"
^DIC(9.4,177,22,2,"PAH",3,1,13,0)="   number of an IV medication."
^DIC(9.4,177,22,2,"PAH",3,1,14,0)=" "
^DIC(9.4,177,22,2,"PAH",3,1,15,0)="3. Problem: When using the CPRS Med Order button, the orderable item "
^DIC(9.4,177,22,2,"PAH",3,1,16,0)="   lookup was using a direct global read."
^DIC(9.4,177,22,2,"PAH",3,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",3,1,18,0)="   Correction: The orderable item lookup has been modified to call a "
^DIC(9.4,177,22,2,"PAH",3,1,19,0)="   Computerized Patient Record System (CPRS) Application Program Interface"
^DIC(9.4,177,22,2,"PAH",3,1,20,0)="   (API) instead of using a direct global read."
^DIC(9.4,177,22,2,"PAH",4,0)="4 SEQ #1^3021008^1"
^DIC(9.4,177,22,2,"PAH",4,1,0)="^^14^14^3021008"
^DIC(9.4,177,22,2,"PAH",4,1,1,0)="1. Problem: When a user attempts to log on to the GUI BCMA, they receive "
^DIC(9.4,177,22,2,"PAH",4,1,2,0)="   the following messages:"
^DIC(9.4,177,22,2,"PAH",4,1,3,0)=" "
^DIC(9.4,177,22,2,"PAH",4,1,4,0)="   RPC BOWDPS5 GETUDID in Option PSB GUI CONTEXT - USER **NOT  FOUND**"
^DIC(9.4,177,22,2,"PAH",4,1,5,0)="   RPC BOWDPS5 GETIVID in Option PSB GUI CONTEXT - USER **NOT  FOUND**"
^DIC(9.4,177,22,2,"PAH",4,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",4,1,7,0)="   Corrective Action: The RPC's ORBCMA5 GETUDID and ORBCMA5 GETIVID were"
^DIC(9.4,177,22,2,"PAH",4,1,8,0)="   added to BCMA Client Context [PSB GUI CONTEXT - USER] option."
^DIC(9.4,177,22,2,"PAH",4,1,9,0)=" "
^DIC(9.4,177,22,2,"PAH",4,1,10,0)="2. Problem: Sites are unable to access the GUI, due to the VISTA side"
^DIC(9.4,177,22,2,"PAH",4,1,11,0)="   needing the most current version of BCMA."
^DIC(9.4,177,22,2,"PAH",4,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",4,1,13,0)="   Corrective Action: The code which checks the version number has been"
^DIC(9.4,177,22,2,"PAH",4,1,14,0)="   corrected to properly return the correct version."
^DIC(9.4,177,22,2,"PAH",5,0)="3 SEQ #5^3021008^1"
^DIC(9.4,177,22,2,"PAH",5,1,0)="^^55^55^3021008"
^DIC(9.4,177,22,2,"PAH",5,1,1,0)="1. Problem: When a medication was given and then not given the Gui did "
^DIC(9.4,177,22,2,"PAH",5,1,2,0)="   not validate."
^DIC(9.4,177,22,2,"PAH",5,1,3,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,4,0)="   Corrective Action:The GUI will validate when a user marks a med from "
^DIC(9.4,177,22,2,"PAH",5,1,5,0)="   Given to Not Given that the user either has the ""PSB MANAGER"" key or "
^DIC(9.4,177,22,2,"PAH",5,1,6,0)="   that the user id matches the user id that made the entry in the med "
^DIC(9.4,177,22,2,"PAH",5,1,7,0)="   log."
^DIC(9.4,177,22,2,"PAH",5,1,8,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,9,0)="2. Problem:  An error would occur if the user did not have write access "
^DIC(9.4,177,22,2,"PAH",5,1,10,0)="   to the log file, which caused BCMA to shut down."
^DIC(9.4,177,22,2,"PAH",5,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,12,0)="   Corrective Action: Additional error trapping was added to report the "
^DIC(9.4,177,22,2,"PAH",5,1,13,0)="   error to the user without shutting down."
^DIC(9.4,177,22,2,"PAH",5,1,14,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,15,0)="3. Problem: When attempting to mark multiple patches as removed, the user"
^DIC(9.4,177,22,2,"PAH",5,1,16,0)="   receives the following error message:"
^DIC(9.4,177,22,2,"PAH",5,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,18,0)="   ""Error(s) Filing Transaction MEDPASS"""
^DIC(9.4,177,22,2,"PAH",5,1,19,0)="   Business Logic Error:  PRN Medications MUST Have a PRN Reason"
^DIC(9.4,177,22,2,"PAH",5,1,20,0)="   Business Logic Error:  PRN Orders cannot be marked NOT Given"
^DIC(9.4,177,22,2,"PAH",5,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,22,0)="   Corrective Action: BCMA GUI has been modified to not allow the"
^DIC(9.4,177,22,2,"PAH",5,1,23,0)="   multiple marking of patches as removed."
^DIC(9.4,177,22,2,"PAH",5,1,24,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,25,0)="4. Problem: User was receiving an undefined variable error in routine "
^DIC(9.4,177,22,2,"PAH",5,1,26,0)="   PSBVDLU1 when attempting to log on to the BCMA GUI application."
^DIC(9.4,177,22,2,"PAH",5,1,27,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,28,0)="   Corrective Action: The code was modified to not error when logging on"
^DIC(9.4,177,22,2,"PAH",5,1,29,0)="   to the GUI application."
^DIC(9.4,177,22,2,"PAH",5,1,30,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,31,0)="5. Problem: When using the CPRS Med Order button, the IV Fluid Order"
^DIC(9.4,177,22,2,"PAH",5,1,32,0)="   screen is not displaying the same volume as the BCMA Order Manager"
^DIC(9.4,177,22,2,"PAH",5,1,33,0)="   screen."
^DIC(9.4,177,22,2,"PAH",5,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,35,0)="   Corrective Action: The IV Fluid Order screen is now displaying the"
^DIC(9.4,177,22,2,"PAH",5,1,36,0)="   same volume as the BCMA Order Manager screen."
^DIC(9.4,177,22,2,"PAH",5,1,37,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,38,0)="6. Problem: The user would recieve an error when trying to launch"
^DIC(9.4,177,22,2,"PAH",5,1,39,0)="   multiple copies of the BCMA GUI."
^DIC(9.4,177,22,2,"PAH",5,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,41,0)="   Corrective Action: The GUI has been corrected to display the"
^DIC(9.4,177,22,2,"PAH",5,1,42,0)="   Open Error message, ""There is already one copy of Bar Code"
^DIC(9.4,177,22,2,"PAH",5,1,43,0)="   Medication Administration running on this machine!"""
^DIC(9.4,177,22,2,"PAH",5,1,44,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,45,0)="7. Problem: When launching the BCMA Site Parameters application, the focus"
^DIC(9.4,177,22,2,"PAH",5,1,46,0)="   was not on the electronic signature box."
^DIC(9.4,177,22,2,"PAH",5,1,47,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,48,0)="   Corrective Action: The BCMA Site Parameters application has been"
^DIC(9.4,177,22,2,"PAH",5,1,49,0)="   modified to place focus on the electronic signature box."
^DIC(9.4,177,22,2,"PAH",5,1,50,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,51,0)="8. Problem: One-time orders were printing on the Due List [PSBO DL]"
^DIC(9.4,177,22,2,"PAH",5,1,52,0)="   option after the stop date of the order."
^DIC(9.4,177,22,2,"PAH",5,1,53,0)=" "
^DIC(9.4,177,22,2,"PAH",5,1,54,0)="   Corrective Action: The printed Due List [PSBO DL] option was modified"
^DIC(9.4,177,22,2,"PAH",5,1,55,0)="   to not print one-time orders past the stop date of the order."
^DIC(9.4,177,22,2,"PAH",6,0)="9 SEQ #6^3021025^1"
^DIC(9.4,177,22,2,"PAH",6,1,0)="^^7^7^3021025"
^DIC(9.4,177,22,2,"PAH",6,1,1,0)="1. Problem: Patient's who did not have a PRN medication administered were"
^DIC(9.4,177,22,2,"PAH",6,1,2,0)="   incorrectly displaying on the PRN Effectiveness List [PSBO PE] option."
^DIC(9.4,177,22,2,"PAH",6,1,3,0)=" "
^DIC(9.4,177,22,2,"PAH",6,1,4,0)="   Corrective Action: There is a post install routine, which runs to clean"
^DIC(9.4,177,22,2,"PAH",6,1,5,0)="   up erroneous file entries that were causing the patient's to display"
^DIC(9.4,177,22,2,"PAH",6,1,6,0)="   on the PRN Effectiveness List [PSBO PE] option. The routine has also"
^DIC(9.4,177,22,2,"PAH",6,1,7,0)="   been corrected to not create the erroneous file entries."
^DIC(9.4,177,22,2,"PAH",7,0)="11 SEQ #7^3021116^1"
^DIC(9.4,177,22,2,"PAH",7,1,0)="^^31^31^3021116"
^DIC(9.4,177,22,2,"PAH",7,1,1,0)="1.  Problem: An allocation error was being generated when starting the Bar"
^DIC(9.4,177,22,2,"PAH",7,1,2,0)="    Code Medication Administration (BCMA) GUI application. The error"
^DIC(9.4,177,22,2,"PAH",7,1,3,0)="    was a result of a large number of printers in the DEVICE file (#3.5)."
^DIC(9.4,177,22,2,"PAH",7,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,5,0)="    Corrective Action: The software has been modified to allow for a large"
^DIC(9.4,177,22,2,"PAH",7,1,6,0)="    number of entries in the DEVICE file (#3.5)."
^DIC(9.4,177,22,2,"PAH",7,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,8,0)="2.  Problem: Users could not print from the GUI application when selecting"
^DIC(9.4,177,22,2,"PAH",7,1,9,0)="    a mnemonic name from the DEVICE file (#3.5)"
^DIC(9.4,177,22,2,"PAH",7,1,10,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,11,0)="    Corrective Action: The GUI has been corrected to allow printing when"
^DIC(9.4,177,22,2,"PAH",7,1,12,0)="    selecting a mnemonic."
^DIC(9.4,177,22,2,"PAH",7,1,13,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,14,0)="3.  Problem: The data entered in the Enter Quantity and Units dialogue box"
^DIC(9.4,177,22,2,"PAH",7,1,15,0)="    from the IVP/PB tab was not being stored in the medication log."
^DIC(9.4,177,22,2,"PAH",7,1,16,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,17,0)="    Corrective Action: The data is now being properly stored in the"
^DIC(9.4,177,22,2,"PAH",7,1,18,0)="    medicatin log."
^DIC(9.4,177,22,2,"PAH",7,1,19,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,20,0)="4.  Problem: The Not Given action was not available on the Virtual Due "
^DIC(9.4,177,22,2,"PAH",7,1,21,0)="    List (VDL) unless the user performed a refresh."
^DIC(9.4,177,22,2,"PAH",7,1,22,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,23,0)="    Corrective Action: The Not Given action is now available with out"
^DIC(9.4,177,22,2,"PAH",7,1,24,0)="    the user having to perform a refresh on the VDL."
^DIC(9.4,177,22,2,"PAH",7,1,25,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,26,0)="5.  Problem: The Multiple Doses to Scan dialogue box does not display to"
^DIC(9.4,177,22,2,"PAH",7,1,27,0)="    the user when a multiple unit per dose order is administered from the"
^DIC(9.4,177,22,2,"PAH",7,1,28,0)="    GUI IVP/IVPB Virtual Due List (VDL) tab."
^DIC(9.4,177,22,2,"PAH",7,1,29,0)=" "
^DIC(9.4,177,22,2,"PAH",7,1,30,0)="    Corrective Action: The GUI IVP/IVPB VDL tab has been corrected to"
^DIC(9.4,177,22,2,"PAH",7,1,31,0)="    properly display when a unit dose order has multiple units per dose."
^DIC(9.4,177,22,2,"PAH",8,0)="13 SEQ #8^3021209^1"
^DIC(9.4,177,22,2,"PAH",8,1,0)="^^8^8^3021209"
^DIC(9.4,177,22,2,"PAH",8,1,1,0)="1.  Problem: If a gap of time exists between the original continuous IV"
^DIC(9.4,177,22,2,"PAH",8,1,2,0)="    order stop date/time and the renewed order start date/time, "
^DIC(9.4,177,22,2,"PAH",8,1,3,0)="    the Bar Code Medication Administration (BCMA) Virtual Due List (VDL) "
^DIC(9.4,177,22,2,"PAH",8,1,4,0)="    IV tab would not display the original order until the expected stop "
^DIC(9.4,177,22,2,"PAH",8,1,5,0)="    date and time."
^DIC(9.4,177,22,2,"PAH",8,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",8,1,7,0)="    Correction: The BCMA VDL IV tab will now display the original order "
^DIC(9.4,177,22,2,"PAH",8,1,8,0)="    until the stop date/time of the order is reached."
^DIC(9.4,177,22,2,"PAH",9,0)="10 SEQ #9^3021220^1"
^DIC(9.4,177,22,2,"PAH",9,1,0)="^^57^57^3021220"
^DIC(9.4,177,22,2,"PAH",9,1,1,0)=" Patch Description:"
^DIC(9.4,177,22,2,"PAH",9,1,2,0)=" ================= "
^DIC(9.4,177,22,2,"PAH",9,1,3,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,4,0)=" Problem: In reference to the BCMA Print Label [PSBO BL] option, a problem"
^DIC(9.4,177,22,2,"PAH",9,1,5,0)=" was discovered in the drug validation process used to compare the "
^DIC(9.4,177,22,2,"PAH",9,1,6,0)=" selected drug with medication orders listed for the patient. The drug "
^DIC(9.4,177,22,2,"PAH",9,1,7,0)=" validate process was performed only if the system device was set to "
^DIC(9.4,177,22,2,"PAH",9,1,8,0)=" BROWSER or the user device."
^DIC(9.4,177,22,2,"PAH",9,1,9,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,10,0)=" Corrective Action: The BCMA Print Label [PSBO BL] option was modified to "
^DIC(9.4,177,22,2,"PAH",9,1,11,0)=" perform the drug validate process before the device selection process.  "
^DIC(9.4,177,22,2,"PAH",9,1,12,0)=" Therefore, the drug validation process will be performed if the system "
^DIC(9.4,177,22,2,"PAH",9,1,13,0)=" device was set to BROWSER or queued to a device."
^DIC(9.4,177,22,2,"PAH",9,1,14,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,15,0)=" Problem: In reference to the BCMA Print Label [PSBO BL] option, a problem"
^DIC(9.4,177,22,2,"PAH",9,1,16,0)=" was discovered in the coding logic that created an entry in the BCMA "
^DIC(9.4,177,22,2,"PAH",9,1,17,0)=" Report Request file (#53.69).  If the user canceled the label print "
^DIC(9.4,177,22,2,"PAH",9,1,18,0)=" process as a result of a mismatch between the selected drug and patient, "
^DIC(9.4,177,22,2,"PAH",9,1,19,0)=" an impartial or bogus entry would remain in the BCMA Report Request file "
^DIC(9.4,177,22,2,"PAH",9,1,20,0)=" (#53.69) occupying vital system resources. "
^DIC(9.4,177,22,2,"PAH",9,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,22,0)=" Corrective Action: The BCMA Print Label [PSBO BL] option was modified by "
^DIC(9.4,177,22,2,"PAH",9,1,23,0)=" inserting the necessary coding logic to delete the impartial or bogus "
^DIC(9.4,177,22,2,"PAH",9,1,24,0)=" entry in the BCMA Report Request file (#53.69) when the print label "
^DIC(9.4,177,22,2,"PAH",9,1,25,0)=" procedure is cancelled as a result of a mismatch between the selected "
^DIC(9.4,177,22,2,"PAH",9,1,26,0)=" drug and patient."
^DIC(9.4,177,22,2,"PAH",9,1,27,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,28,0)=" Problem: In reference to the BCMA Print Label [PSBO BL] option, a problem"
^DIC(9.4,177,22,2,"PAH",9,1,29,0)=" was discovered in the ScreenMan data input functions.  If the selected "
^DIC(9.4,177,22,2,"PAH",9,1,30,0)=" patient requires a Means Test, the option will abruptly display a message"
^DIC(9.4,177,22,2,"PAH",9,1,31,0)=" to the user indicating ""*** Patient Requires a Means Test ***"" and the "
^DIC(9.4,177,22,2,"PAH",9,1,32,0)=" ScreenMan data input process was rearranged out of order."
^DIC(9.4,177,22,2,"PAH",9,1,33,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,34,0)=" Corrective Action: The BCMA Print Label [PSBO BL] option was modified by "
^DIC(9.4,177,22,2,"PAH",9,1,35,0)=" inserting the necessary coding logic to refresh the ScreenMan data input "
^DIC(9.4,177,22,2,"PAH",9,1,36,0)=" screen when the Means Test notification message rearranged the data input"
^DIC(9.4,177,22,2,"PAH",9,1,37,0)=" process.  By refreshing the screen, the data input flow will return to "
^DIC(9.4,177,22,2,"PAH",9,1,38,0)=" the next data input field."
^DIC(9.4,177,22,2,"PAH",9,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,40,0)=" Problem: In reference to the BCMA Print Label [PSBO BL] option, a problem"
^DIC(9.4,177,22,2,"PAH",9,1,41,0)=" was discovered in the coding logic used to set a variable that contained "
^DIC(9.4,177,22,2,"PAH",9,1,42,0)=" the internal entry number of the selected drug.  This problem was not "
^DIC(9.4,177,22,2,"PAH",9,1,43,0)=" discovered in the initial release of BCMA V 2.0."
^DIC(9.4,177,22,2,"PAH",9,1,44,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,45,0)=" Corrective Action:  The BCMA Print Label [PSBO BL] option was modified by"
^DIC(9.4,177,22,2,"PAH",9,1,46,0)=" inserting the correct coding logic to extract and store the selected drug"
^DIC(9.4,177,22,2,"PAH",9,1,47,0)=" internal entry number in the proper variable."
^DIC(9.4,177,22,2,"PAH",9,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,49,0)=" Problem: In reference to the BCMA Print Label [PSBO BL] option, a problem"
^DIC(9.4,177,22,2,"PAH",9,1,50,0)=" was discovered in the drug validation process used to check the patient "
^DIC(9.4,177,22,2,"PAH",9,1,51,0)=" medication orders. The option only validated medication orders that were "
^DIC(9.4,177,22,2,"PAH",9,1,52,0)=" classified a Unit Dose and it did not validate medication orders that "
^DIC(9.4,177,22,2,"PAH",9,1,53,0)=" were classified as IV orders containing IV Additives and IV Solutions."
^DIC(9.4,177,22,2,"PAH",9,1,54,0)=" "
^DIC(9.4,177,22,2,"PAH",9,1,55,0)=" Corrective Action:  The BCMA Print Label [PSBO BL] option was modified "
^DIC(9.4,177,22,2,"PAH",9,1,56,0)=" by inserting the proper coding logic to validate IV orders that contained"
^DIC(9.4,177,22,2,"PAH",9,1,57,0)=" IV Additives and IV Solutions."
^DIC(9.4,177,22,2,"PAH",10,0)="18 SEQ #10^3030329^1"
^DIC(9.4,177,22,2,"PAH",10,1,0)="^^21^21^3030329"
^DIC(9.4,177,22,2,"PAH",10,1,1,0)="Install this patch before installing Patch PSB*2*6. It will perform the"
^DIC(9.4,177,22,2,"PAH",10,1,2,0)="same medication order validation as Patch PSB*2*6, and allows Pharmacists"
^DIC(9.4,177,22,2,"PAH",10,1,3,0)="an opportunity to review ""problem"" medication orders before your site"
^DIC(9.4,177,22,2,"PAH",10,1,4,0)="installs PSB*2*6. Ensure that PSB*2*6 is installed immediately following"
^DIC(9.4,177,22,2,"PAH",10,1,5,0)="the correction of any problem medication orders. Failure to do so may"
^DIC(9.4,177,22,2,"PAH",10,1,6,0)="result in medication orders not displaying on the Virtual Due List (VDL)."
^DIC(9.4,177,22,2,"PAH",10,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",10,1,8,0)="The person installing this patch will receive two separate MailMan"
^DIC(9.4,177,22,2,"PAH",10,1,9,0)="messages with the following subjects:"
^DIC(9.4,177,22,2,"PAH",10,1,10,0)=" "
^DIC(9.4,177,22,2,"PAH",10,1,11,0)="BCMA Order Problem Notification Started on JAN 7,2003@08:24:18."
^DIC(9.4,177,22,2,"PAH",10,1,12,0)="This will let the user know the date and time the process started."
^DIC(9.4,177,22,2,"PAH",10,1,13,0)=" "
^DIC(9.4,177,22,2,"PAH",10,1,14,0)="BCMA Order Problem Notification Finished on JAN 7,2003@08:30:47."
^DIC(9.4,177,22,2,"PAH",10,1,15,0)="This will let the user know the date and time the process finished."
^DIC(9.4,177,22,2,"PAH",10,1,16,0)=" "
^DIC(9.4,177,22,2,"PAH",10,1,17,0)="The person installing this patch will also receive a MailMan message"
^DIC(9.4,177,22,2,"PAH",10,1,18,0)="with the subject: BCMA Pre patch 6 - Order Problem Notification. This will"
^DIC(9.4,177,22,2,"PAH",10,1,19,0)="let the user know that PSB*2*6 will have a problem displaying an order,"
^DIC(9.4,177,22,2,"PAH",10,1,20,0)="which is identified in the message text. A separate MailMan message"
^DIC(9.4,177,22,2,"PAH",10,1,21,0)="will be generated for each Order Problem."
^DIC(9.4,177,22,2,"PAH",11,0)="6 SEQ #11^3030329^1"
^DIC(9.4,177,22,2,"PAH",11,1,0)="^^171^171^3030329"
^DIC(9.4,177,22,2,"PAH",11,1,1,0)="***NOTE*** Do NOT install this patch until you receive the message"
^DIC(9.4,177,22,2,"PAH",11,1,2,0)="""BCMA AADT X-REF CHECK COMPLETED"" from the installation of PSB*2.0*9 and"
^DIC(9.4,177,22,2,"PAH",11,1,3,0)="the message ""BCMA Order Problem Notification Finished"" from the "
^DIC(9.4,177,22,2,"PAH",11,1,4,0)="installation of PSB*2.0*18. Installing this patch before receiving these "
^DIC(9.4,177,22,2,"PAH",11,1,5,0)="messages may cause the Bar Code Medication Administration (BCMA) program "
^DIC(9.4,177,22,2,"PAH",11,1,6,0)="to error."
^DIC(9.4,177,22,2,"PAH",11,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,8,0)="This patch contains changes to how BCMA V. 2.0 processes schedule"
^DIC(9.4,177,22,2,"PAH",11,1,9,0)="information from Inpatient Medications V. 5.0, and how it determines "
^DIC(9.4,177,22,2,"PAH",11,1,10,0)="when to display a Continuous medication order on "
^DIC(9.4,177,22,2,"PAH",11,1,11,0)="the Virtual Due List (VDL)."
^DIC(9.4,177,22,2,"PAH",11,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,13,0)="At the end of this installation a post install routine will clean up the "
^DIC(9.4,177,22,2,"PAH",11,1,14,0)="BCMA Medication Log APATCH INDEX. The person installing the patch will be "
^DIC(9.4,177,22,2,"PAH",11,1,15,0)="notified the routine has completed successfully via a MailMan email with "
^DIC(9.4,177,22,2,"PAH",11,1,16,0)="the subject line ""BCMA APATCH INDEX CLEAN HAS COMPLETED""."
^DIC(9.4,177,22,2,"PAH",11,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,18,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,19,0)="1.  Problem: The Medication Administration History [PSBO MH] option "
^DIC(9.4,177,22,2,"PAH",11,1,20,0)="    displays medication orders beyond the requested report dates."
^DIC(9.4,177,22,2,"PAH",11,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,22,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",11,1,23,0)="    option now displays medication orders within the requested report "
^DIC(9.4,177,22,2,"PAH",11,1,24,0)="    dates."
^DIC(9.4,177,22,2,"PAH",11,1,25,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,26,0)="2.  Problem: When a patient is discharged and reinstated, the MAH "
^DIC(9.4,177,22,2,"PAH",11,1,27,0)="    displays ""***"" in the date column."
^DIC(9.4,177,22,2,"PAH",11,1,28,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,29,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",11,1,30,0)="    option has been modified to not display ""***"" in the Date"
^DIC(9.4,177,22,2,"PAH",11,1,31,0)="    column for medication orders that have been discontinued and"
^DIC(9.4,177,22,2,"PAH",11,1,32,0)="    then reinstated.   "
^DIC(9.4,177,22,2,"PAH",11,1,33,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,34,0)="3.  Problem: PRN last actions listed as ""Not Given"" display on the"
^DIC(9.4,177,22,2,"PAH",11,1,35,0)="    Medication Log Information dialog box."
^DIC(9.4,177,22,2,"PAH",11,1,36,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,37,0)="    Corrective Action: The last four actions of a PRN medication order"
^DIC(9.4,177,22,2,"PAH",11,1,38,0)="    will not display an action of ""Not Given"", in the Medication Log"
^DIC(9.4,177,22,2,"PAH",11,1,39,0)="    Information dialog box."
^DIC(9.4,177,22,2,"PAH",11,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,41,0)="4.  Problem: A medication order for a Patch displayed multiple "
^DIC(9.4,177,22,2,"PAH",11,1,42,0)="    times on the VDL, if it was marked as ""Given"", then ""Not Given"""
^DIC(9.4,177,22,2,"PAH",11,1,43,0)="    and then ""Given"" again."
^DIC(9.4,177,22,2,"PAH",11,1,44,0)="    "
^DIC(9.4,177,22,2,"PAH",11,1,45,0)="    Corrective Action: A medication order for a Patch will display "
^DIC(9.4,177,22,2,"PAH",11,1,46,0)="    appropriately, regardless of how many times an action has been "
^DIC(9.4,177,22,2,"PAH",11,1,47,0)="    applied to the associated patch order."
^DIC(9.4,177,22,2,"PAH",11,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,49,0)="5.  Problem: After a patient receives a patch for the second time "
^DIC(9.4,177,22,2,"PAH",11,1,50,0)="    the ""Last Action"" column on the VDL displays the incorrect date and "
^DIC(9.4,177,22,2,"PAH",11,1,51,0)="    time."
^DIC(9.4,177,22,2,"PAH",11,1,52,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,53,0)="    Corrective Action: The ""Last Action"" column will now display the "
^DIC(9.4,177,22,2,"PAH",11,1,54,0)="    correct date and time for patches. "
^DIC(9.4,177,22,2,"PAH",11,1,55,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,56,0)="6.  Problem: When an active IV order that has an infusing bag is edited"
^DIC(9.4,177,22,2,"PAH",11,1,57,0)="    through Computerized Patient Record System (CPRS), via the ""CHANGE"""
^DIC(9.4,177,22,2,"PAH",11,1,58,0)="    action, the ""old"" order disappears from the BCMA VDL IV tab.  "
^DIC(9.4,177,22,2,"PAH",11,1,59,0)="    This prevents clinicians from knowing the status of the old order."
^DIC(9.4,177,22,2,"PAH",11,1,60,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,61,0)="    Corrective Action: Continue to display the status of an edited IV "
^DIC(9.4,177,22,2,"PAH",11,1,62,0)="    order on the BCMA VDL IV tab. "
^DIC(9.4,177,22,2,"PAH",11,1,63,0)="       "
^DIC(9.4,177,22,2,"PAH",11,1,64,0)="7.  Problem: The Missed Medications [PSBO MM] option generates"
^DIC(9.4,177,22,2,"PAH",11,1,65,0)="    a ""String too long"" error message for medication orders that contain"
^DIC(9.4,177,22,2,"PAH",11,1,66,0)="    a schedule in a minute's format (i.e., Q2')."
^DIC(9.4,177,22,2,"PAH",11,1,67,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,68,0)="    Corrective Action: The Missed Medications [PSBO MM] option now "
^DIC(9.4,177,22,2,"PAH",11,1,69,0)="    displays medication orders that contain a schedule using a minute's "
^DIC(9.4,177,22,2,"PAH",11,1,70,0)="    format. "
^DIC(9.4,177,22,2,"PAH",11,1,71,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,72,0)="8.  Problem: The Medication Administration History [PSBO MH] option "
^DIC(9.4,177,22,2,"PAH",11,1,73,0)="    generates a ""String too long"" error message for medication orders "
^DIC(9.4,177,22,2,"PAH",11,1,74,0)="    that contains a schedule in a minute's format (i.e., Q2')."
^DIC(9.4,177,22,2,"PAH",11,1,75,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,76,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",11,1,77,0)="    option now displays medication orders that contain a schedule using a "
^DIC(9.4,177,22,2,"PAH",11,1,78,0)="    minute's format. However, schedules with a frequency of less than 45 "
^DIC(9.4,177,22,2,"PAH",11,1,79,0)="    minutes will display the message ""Due Every # Minutes"", where # is the"
^DIC(9.4,177,22,2,"PAH",11,1,80,0)="    frequency."
^DIC(9.4,177,22,2,"PAH",11,1,81,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,82,0)="9.  Problem: Ward Administration Times [PSBO WA] option generates"
^DIC(9.4,177,22,2,"PAH",11,1,83,0)="    a ""String too long"" error message for medication orders that contain"
^DIC(9.4,177,22,2,"PAH",11,1,84,0)="    a schedule in a minute's format (i.e., Q2')."
^DIC(9.4,177,22,2,"PAH",11,1,85,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,86,0)="    Corrective Action: The Ward Administration Times [PSBO WA] option "
^DIC(9.4,177,22,2,"PAH",11,1,87,0)="    now displays medication orders that contain a schedule using a "
^DIC(9.4,177,22,2,"PAH",11,1,88,0)="    minute's format. However, schedules with a frequency of less than 30 "
^DIC(9.4,177,22,2,"PAH",11,1,89,0)="    minutes will display the message ""Due Every # Minutes"", where # is "
^DIC(9.4,177,22,2,"PAH",11,1,90,0)="    the frequency."
^DIC(9.4,177,22,2,"PAH",11,1,91,0)="    "
^DIC(9.4,177,22,2,"PAH",11,1,92,0)="10. Problem: Medication orders that include a Day of the Week schedule "
^DIC(9.4,177,22,2,"PAH",11,1,93,0)="    generate a false Due List Notification Error on a day not due."
^DIC(9.4,177,22,2,"PAH",11,1,94,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,95,0)="    Corrective Action: Medication orders that include a Day of the Week "
^DIC(9.4,177,22,2,"PAH",11,1,96,0)="    schedule will no longer generate a false Due List Notification Error."
^DIC(9.4,177,22,2,"PAH",11,1,97,0)="  "
^DIC(9.4,177,22,2,"PAH",11,1,98,0)="11. Problem: If a medication order with the dosage form of ""PATCH"" is "
^DIC(9.4,177,22,2,"PAH",11,1,99,0)="    administered by a nurse using the Manual Medication Entry [PSB MED "
^DIC(9.4,177,22,2,"PAH",11,1,100,0)="    LOG NEW ENTRY] option, the medication will not display on the VDL for "
^DIC(9.4,177,22,2,"PAH",11,1,101,0)="    the nurse to mark it as ""Removed."""
^DIC(9.4,177,22,2,"PAH",11,1,102,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,103,0)="    Corrective Action: Medication orders with a dosage form of ""PATCH"""
^DIC(9.4,177,22,2,"PAH",11,1,104,0)="    given by a nurse using the Manual Medication Entry [PSB MED LOG NEW"
^DIC(9.4,177,22,2,"PAH",11,1,105,0)="    ENTRY] option will now display on the VDL for the nurse"
^DIC(9.4,177,22,2,"PAH",11,1,106,0)="    to mark them as ""Removed."" "
^DIC(9.4,177,22,2,"PAH",11,1,107,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,108,0)="12. Problem: The Admin Time column on the IVP/IVPB tab of the VDL is "
^DIC(9.4,177,22,2,"PAH",11,1,109,0)="    displaying administration times of ""0000"" for odd schedule orders."
^DIC(9.4,177,22,2,"PAH",11,1,110,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,111,0)="    Corrective Action: The Admin Time column on the IVP/IVPB tab of"
^DIC(9.4,177,22,2,"PAH",11,1,112,0)="    VDL will now display the correct time for an odd schedule order. "
^DIC(9.4,177,22,2,"PAH",11,1,113,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,114,0)="13. Problem: The data entered in the ""Enter Quantity and Units"" dialogue "
^DIC(9.4,177,22,2,"PAH",11,1,115,0)="    box from the IVP/PB tab was not being stored in the medication log."
^DIC(9.4,177,22,2,"PAH",11,1,116,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,117,0)="    Corrective Action: The data is now being properly stored in the"
^DIC(9.4,177,22,2,"PAH",11,1,118,0)="    medication log."
^DIC(9.4,177,22,2,"PAH",11,1,119,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,120,0)="14. Problem: If a medication order is marked as ""Not Given"", the user is "
^DIC(9.4,177,22,2,"PAH",11,1,121,0)="    unable to update the medication using the Manual Medication Entry "
^DIC(9.4,177,22,2,"PAH",11,1,122,0)="    [PSB MED LOG NEW ENTRY] option."
^DIC(9.4,177,22,2,"PAH",11,1,123,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,124,0)="    Corrective Action: The user will now be able to update medication"
^DIC(9.4,177,22,2,"PAH",11,1,125,0)="    orders that have been marked as ""Not Given"" using the Manual "
^DIC(9.4,177,22,2,"PAH",11,1,126,0)="    Medication Entry [PSB MED LOG NEW ENTRY] option. "
^DIC(9.4,177,22,2,"PAH",11,1,127,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,128,0)="15. Problem: If a PRN medication order with the dosage form of ""PATCH"" "
^DIC(9.4,177,22,2,"PAH",11,1,129,0)="    was marked as ""Given"", it would duplicate on the VDL. The user was "
^DIC(9.4,177,22,2,"PAH",11,1,130,0)="    unable to mark the medication as ""Removed."""
^DIC(9.4,177,22,2,"PAH",11,1,131,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,132,0)="    Corrective Action: PRN medication orders with the dosage form of"
^DIC(9.4,177,22,2,"PAH",11,1,133,0)="    ""PATCH"" will follow the ""PATCH"" business rule."
^DIC(9.4,177,22,2,"PAH",11,1,134,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,135,0)="16. Problem: The Ward Administration Times report displays IV orders with "
^DIC(9.4,177,22,2,"PAH",11,1,136,0)="    admin times based on the frequency calculated by IPM. The display of "
^DIC(9.4,177,22,2,"PAH",11,1,137,0)="    large volume IV's on this report is confusing to the user."
^DIC(9.4,177,22,2,"PAH",11,1,138,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,139,0)="    Corrective Action: IV's with a IV type of Admixture, Hyperal, Syringe "
^DIC(9.4,177,22,2,"PAH",11,1,140,0)="    Not Intermittent, Chemotherapy (Admixture), Chemotherapy (Syringe "
^DIC(9.4,177,22,2,"PAH",11,1,141,0)="    Non-Intermittent) will not be displayed on this report."
^DIC(9.4,177,22,2,"PAH",11,1,142,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,143,0)="17. Problem: A Schedule Type of ""R"" displays in the ""Type"" column on the "
^DIC(9.4,177,22,2,"PAH",11,1,144,0)="    VDL for medication orders that have a dosage form of ""PATCH"" and "
^DIC(9.4,177,22,2,"PAH",11,1,145,0)="    a previous Schedule Type of Fill on Request. "
^DIC(9.4,177,22,2,"PAH",11,1,146,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,147,0)="    Corrective Action:  The correct Schedule Type will display in the "
^DIC(9.4,177,22,2,"PAH",11,1,148,0)="    ""Type"" column on the VDL."
^DIC(9.4,177,22,2,"PAH",11,1,149,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,150,0)="18. Problem:  A condition exists that causes a medication order to have"
^DIC(9.4,177,22,2,"PAH",11,1,151,0)="    the same previous and following order number. Because of this "
^DIC(9.4,177,22,2,"PAH",11,1,152,0)="    scenario, the BCMA application is put into an infinite loop or may "
^DIC(9.4,177,22,2,"PAH",11,1,153,0)="    cause an error when the VDL is opened."
^DIC(9.4,177,22,2,"PAH",11,1,154,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,155,0)="    Corrective Action:  In support of several NOIS tickets regarding this "
^DIC(9.4,177,22,2,"PAH",11,1,156,0)="    issue, BCMA has implemented a temporary fix that now allows a "
^DIC(9.4,177,22,2,"PAH",11,1,157,0)="    medication order with the same previous and following order number to "
^DIC(9.4,177,22,2,"PAH",11,1,158,0)="    display on the VDL. This is not a comprehensive fix, but will allow "
^DIC(9.4,177,22,2,"PAH",11,1,159,0)="    BCMA to function properly while Inpatient Meds researches the problem."
^DIC(9.4,177,22,2,"PAH",11,1,160,0)="    "
^DIC(9.4,177,22,2,"PAH",11,1,161,0)="19. Problem:  A one-time medication order marked as ""Missing,"" "
^DIC(9.4,177,22,2,"PAH",11,1,162,0)="    would not display on the Missed Medications [PSBO MM] option."
^DIC(9.4,177,22,2,"PAH",11,1,163,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,164,0)="    Corrective Action:  A one-time medication order marked as ""Missing,"""
^DIC(9.4,177,22,2,"PAH",11,1,165,0)="    will now display on the Missed Medications [PSBO MM] option.  "
^DIC(9.4,177,22,2,"PAH",11,1,166,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,167,0)="20. Problem: Day of the Week schedules that include the ""@"" sign followed "
^DIC(9.4,177,22,2,"PAH",11,1,168,0)="    by a valid time do not display on the Virtual Due List."
^DIC(9.4,177,22,2,"PAH",11,1,169,0)=" "
^DIC(9.4,177,22,2,"PAH",11,1,170,0)="    Corrective Action: Day of the Week schedules in this format now"
^DIC(9.4,177,22,2,"PAH",11,1,171,0)="    display correctly on the Virtual Due List. "
^DIC(9.4,177,22,2,"PAH",12,0)="15 SEQ #12^3030329^1"
^DIC(9.4,177,22,2,"PAH",12,1,0)="^^12^12^3030329"
^DIC(9.4,177,22,2,"PAH",12,1,1,0)="1.  Problem:  The Medication Administration History [PSBO MH] option and "
^DIC(9.4,177,22,2,"PAH",12,1,2,0)="    Manual Medication Entry [PSB MED LOG NEW ENTRY] option are generating "
^DIC(9.4,177,22,2,"PAH",12,1,3,0)="    an undefined error, because of a missing orderable item name on a "
^DIC(9.4,177,22,2,"PAH",12,1,4,0)="    medication order."
^DIC(9.4,177,22,2,"PAH",12,1,5,0)=" "
^DIC(9.4,177,22,2,"PAH",12,1,6,0)="    Corrective Action: The undefined error has been corrected. "
^DIC(9.4,177,22,2,"PAH",12,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",12,1,8,0)="2.  Problem:  Users are receiving an undefined variable error in routine "
^DIC(9.4,177,22,2,"PAH",12,1,9,0)="    PSBVDLU1 when accessing the patient's medication orders on the VDL."
^DIC(9.4,177,22,2,"PAH",12,1,10,0)=" "
^DIC(9.4,177,22,2,"PAH",12,1,11,0)="    Corrective Action:  The code has been modified to properly display "
^DIC(9.4,177,22,2,"PAH",12,1,12,0)="    the patient's medication orders when accessing the VDL."
^DIC(9.4,177,22,2,"PAH",13,0)="8 SEQ #13^3030329^1"
^DIC(9.4,177,22,2,"PAH",13,1,0)="^^175^175^3030329"
^DIC(9.4,177,22,2,"PAH",13,1,1,0)="    *** ATTENTION: This patch includes a new GUI."
^DIC(9.4,177,22,2,"PAH",13,1,2,0)="        Installation of this GUI is required in order to see the full"
^DIC(9.4,177,22,2,"PAH",13,1,3,0)="        functionality of this patch. ***"
^DIC(9.4,177,22,2,"PAH",13,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,5,0)="For retrieval and installation instructions, please see the Client"
^DIC(9.4,177,22,2,"PAH",13,1,6,0)="Installation Instructions section."
^DIC(9.4,177,22,2,"PAH",13,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,8,0)="1.  Problem:  Any order displayed as Provider Hold on the GUI Virtual"
^DIC(9.4,177,22,2,"PAH",13,1,9,0)="    Due List (VDL) is also marked as ""Refused"" when multiple medication"
^DIC(9.4,177,22,2,"PAH",13,1,10,0)="    orders are marked as ""Refused."""
^DIC(9.4,177,22,2,"PAH",13,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,12,0)="    Corrective Action:  The GUI VDL will not apply the status of ""Refused"""
^DIC(9.4,177,22,2,"PAH",13,1,13,0)="    to medication orders placed on Provider Hold when marking multiple"
^DIC(9.4,177,22,2,"PAH",13,1,14,0)="    medication orders."
^DIC(9.4,177,22,2,"PAH",13,1,15,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,16,0)="2.  Problem:  Comments entered when a ward stock IV bag is completed"
^DIC(9.4,177,22,2,"PAH",13,1,17,0)="    and another ward stock IV bag begins infusing, are carried from one IV"
^DIC(9.4,177,22,2,"PAH",13,1,18,0)="    bag to another."
^DIC(9.4,177,22,2,"PAH",13,1,19,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,20,0)="    Corrective Action:  Comments entered for an IV bag will not carry over"
^DIC(9.4,177,22,2,"PAH",13,1,21,0)="    to the next IV bag."
^DIC(9.4,177,22,2,"PAH",13,1,22,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,23,0)="3.  Problem:  The error message ""Missing Data"" sporadically displays on"
^DIC(9.4,177,22,2,"PAH",13,1,24,0)="    the VDL when a user tries to administer a medication via the ""CPRS Med"
^DIC(9.4,177,22,2,"PAH",13,1,25,0)="    Order"" button."
^DIC(9.4,177,22,2,"PAH",13,1,26,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,27,0)="    Corrective Action:  The ""Missing Data"" message has been corrected."
^DIC(9.4,177,22,2,"PAH",13,1,28,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,29,0)="4.  Problem:  The error message, ""'.' Not a valid integer"" sporadically"
^DIC(9.4,177,22,2,"PAH",13,1,30,0)="    displays when a user accesses a patient record on the VDL."
^DIC(9.4,177,22,2,"PAH",13,1,31,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,32,0)="    Corrective Action:  The VDL has been corrected to not generate the"
^DIC(9.4,177,22,2,"PAH",13,1,33,0)="    error message."
^DIC(9.4,177,22,2,"PAH",13,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,35,0)="5.  Problem:  Any report printed from the GUI VDL, displays inactive"
^DIC(9.4,177,22,2,"PAH",13,1,36,0)="    wards in the ""Ward"" field under the ""Print by"" section."
^DIC(9.4,177,22,2,"PAH",13,1,37,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,38,0)="    Correction Action:  Inactive wards will no longer be available for"
^DIC(9.4,177,22,2,"PAH",13,1,39,0)="    selection on reports printed from the GUI VDL."
^DIC(9.4,177,22,2,"PAH",13,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,41,0)="6.  Problem:  A medication order with the dosage form of ""PATCH"" marked"
^DIC(9.4,177,22,2,"PAH",13,1,42,0)="    as ""Given"" using the Manual Medication Entry [PSB MED LOG NEW ENTRY]"
^DIC(9.4,177,22,2,"PAH",13,1,43,0)="    option, does not display on the VDL as ""Given."""
^DIC(9.4,177,22,2,"PAH",13,1,44,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,45,0)="    Corrective Action:  Medication orders with a dosage form of ""PATCH"""
^DIC(9.4,177,22,2,"PAH",13,1,46,0)="    marked as ""Given"" using the Manual Medication Entry [PSB MED LOG NEW "
^DIC(9.4,177,22,2,"PAH",13,1,47,0)="    ENTRY] option, will display on the VDL as ""Given."
^DIC(9.4,177,22,2,"PAH",13,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,49,0)="7.  Problem:  The ""Provider:"" field on the ""Order Manager"" dialog"
^DIC(9.4,177,22,2,"PAH",13,1,50,0)="    screen does not display all valid Providers when performing a partial"
^DIC(9.4,177,22,2,"PAH",13,1,51,0)="    lookup. This was a result of BCMA not validating the inactive date"
^DIC(9.4,177,22,2,"PAH",13,1,52,0)="    correctly."
^DIC(9.4,177,22,2,"PAH",13,1,53,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,54,0)="    Corrective Action:  The code has been modified to perform the "
^DIC(9.4,177,22,2,"PAH",13,1,55,0)="    validation on the inactive date. The correct Providers will display"
^DIC(9.4,177,22,2,"PAH",13,1,56,0)="    for selection under the ""Provider:"" field on the ""Order Manager"""
^DIC(9.4,177,22,2,"PAH",13,1,57,0)="    dialog screen."
^DIC(9.4,177,22,2,"PAH",13,1,58,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,59,0)="8.  Problem:  Drugs with a future inactive date were not available for"
^DIC(9.4,177,22,2,"PAH",13,1,60,0)="    printing on labels using the Label Print [PSBO BL] option."
^DIC(9.4,177,22,2,"PAH",13,1,61,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,62,0)="    Corrective Action:  Drugs with future inactive dates are now available"
^DIC(9.4,177,22,2,"PAH",13,1,63,0)="    for printing on labels."
^DIC(9.4,177,22,2,"PAH",13,1,64,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,65,0)="9.  Problem:  BCMA does not perform a version check between the GUI"
^DIC(9.4,177,22,2,"PAH",13,1,66,0)="    application and CHUI application side."
^DIC(9.4,177,22,2,"PAH",13,1,67,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,68,0)="    Corrective Action:  BCMA will validate the version of the GUI "
^DIC(9.4,177,22,2,"PAH",13,1,69,0)="    application  running on the GUI against the CHUI application."
^DIC(9.4,177,22,2,"PAH",13,1,70,0)="    The client version must match the patch number on the VistA server,"
^DIC(9.4,177,22,2,"PAH",13,1,71,0)="    and if compatible, the previous GUI version will be allowed to run. "
^DIC(9.4,177,22,2,"PAH",13,1,72,0)="    GUI version will be allowed to run.  No prior version will be allowed "
^DIC(9.4,177,22,2,"PAH",13,1,73,0)="    to run on the client."
^DIC(9.4,177,22,2,"PAH",13,1,74,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,75,0)="10. Problem:  The current ""Typical"" installation process for the BCMA"
^DIC(9.4,177,22,2,"PAH",13,1,76,0)="    GUI application installs both the BCMA client and the BCMA Site "
^DIC(9.4,177,22,2,"PAH",13,1,77,0)="    Parameter application. This is not appropriate for an installation"
^DIC(9.4,177,22,2,"PAH",13,1,78,0)="    a ward P.C. "
^DIC(9.4,177,22,2,"PAH",13,1,79,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,80,0)="    Corrective Action:  The ""Typical"" installation process has been "
^DIC(9.4,177,22,2,"PAH",13,1,81,0)="    modified  to only install the BCMA client."
^DIC(9.4,177,22,2,"PAH",13,1,82,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,83,0)="11. Problem:  The action of marking multiple medications, as ""Held"" or"
^DIC(9.4,177,22,2,"PAH",13,1,84,0)="    ""Refused"" does not always apply to every medication on the VDL. For"
^DIC(9.4,177,22,2,"PAH",13,1,85,0)="    example, if a medication is already marked as ""Given"", the action of "
^DIC(9.4,177,22,2,"PAH",13,1,86,0)="    ""Held"" or ""Refused"" will not apply to that medication order."
^DIC(9.4,177,22,2,"PAH",13,1,87,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,88,0)="    Corrective Action:  If multiple medications are highlighted on the "
^DIC(9.4,177,22,2,"PAH",13,1,89,0)="    VDL, and the action of ""Held"" or ""Refused"" does not apply to"
^DIC(9.4,177,22,2,"PAH",13,1,90,0)="    a highlighted order, an Informational dialog box will display with"
^DIC(9.4,177,22,2,"PAH",13,1,91,0)="    the message, ""Held or Refused will NOT be applied to the following"
^DIC(9.4,177,22,2,"PAH",13,1,92,0)="    order(s):"" with a list of orders."
^DIC(9.4,177,22,2,"PAH",13,1,93,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,94,0)="12. Problem:  The message ""ERROR: MISSING DATA - ALL FIELDS ARE"
^DIC(9.4,177,22,2,"PAH",13,1,95,0)="    REQUIRED,"" Missing Field: NEEDED BY DATE/TIME,"" displays when a user"
^DIC(9.4,177,22,2,"PAH",13,1,96,0)="    selects the Missing Dose Followup [PSB MISSING DOSE FOLLOWUP] option, "
^DIC(9.4,177,22,2,"PAH",13,1,97,0)="    to complete and save a request."
^DIC(9.4,177,22,2,"PAH",13,1,98,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,99,0)="    Corrective Action:  The Date@Time Needed field on the ""Missing Dose"
^DIC(9.4,177,22,2,"PAH",13,1,100,0)="    Request"" dialog box is now a required field."
^DIC(9.4,177,22,2,"PAH",13,1,101,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,102,0)="13. Problem:  The Right-Click feature used to access the ""Take Action"
^DIC(9.4,177,22,2,"PAH",13,1,103,0)="    on WS"" command was not available for a ward stock IV bag marked as"
^DIC(9.4,177,22,2,"PAH",13,1,104,0)="    ""Held"" on the VDL."
^DIC(9.4,177,22,2,"PAH",13,1,105,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,106,0)="    Corrective Action:  The Right-Click feature used to access the ""Take"
^DIC(9.4,177,22,2,"PAH",13,1,107,0)="    Action on WS"" command is now available for a ward stock IV bag marked "
^DIC(9.4,177,22,2,"PAH",13,1,108,0)="    as ""Held"" on the VDL."
^DIC(9.4,177,22,2,"PAH",13,1,109,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,110,0)="14. Problem:  When users sign on to the BCMA GUI application, and are"
^DIC(9.4,177,22,2,"PAH",13,1,111,0)="    prompted to scan the patient's wristband, a lower portion of the "
^DIC(9.4,177,22,2,"PAH",13,1,112,0)="    screen display is grayed out."
^DIC(9.4,177,22,2,"PAH",13,1,113,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,114,0)="    Corrective Action:  The GUI screen display has been corrected."
^DIC(9.4,177,22,2,"PAH",13,1,115,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,116,0)="15. Problem:  Reports would not print from the GUI application when"
^DIC(9.4,177,22,2,"PAH",13,1,117,0)="    print devices had the same name."
^DIC(9.4,177,22,2,"PAH",13,1,118,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,119,0)="    Corrective Action:  The GUI printing function has been modified to "
^DIC(9.4,177,22,2,"PAH",13,1,120,0)="    print reports to devices that have the same name."
^DIC(9.4,177,22,2,"PAH",13,1,121,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,122,0)="16. Problem:  A medication order with a schedule of ""AC&HS,"" displays"
^DIC(9.4,177,22,2,"PAH",13,1,123,0)="    on the BCMA VDL with a schedule of ""ACHS."""
^DIC(9.4,177,22,2,"PAH",13,1,124,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,125,0)="    Corrective Action:  The GUI has been modified to properly display the"
^DIC(9.4,177,22,2,"PAH",13,1,126,0)="    schedule."
^DIC(9.4,177,22,2,"PAH",13,1,127,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,128,0)="17. Problem:  The shortcut keys of ""ALT+A"" used to display ""Allergies"""
^DIC(9.4,177,22,2,"PAH",13,1,129,0)="    would go to the ""Start Time:"" field of the ""Virtual Due List "
^DIC(9.4,177,22,2,"PAH",13,1,130,0)="    Parameters:"" section of the VDL."
^DIC(9.4,177,22,2,"PAH",13,1,131,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,132,0)="    Corrective Action:  The shortcut key for ""Allergies"" has been changed"
^DIC(9.4,177,22,2,"PAH",13,1,133,0)="    to ALT-G."
^DIC(9.4,177,22,2,"PAH",13,1,134,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,135,0)="18. Problem:  If a medication order is created or edited using the"
^DIC(9.4,177,22,2,"PAH",13,1,136,0)="    Manual Medication Entry [PSB MED LOG NEW ENTRY] option or the Edit"
^DIC(9.4,177,22,2,"PAH",13,1,137,0)="    Medication Log [PSB MED LOG EDIT] option, the last action would "
^DIC(9.4,177,22,2,"PAH",13,1,138,0)="    display incorrectly on the ""Last Action"" column of the VDL by"
^DIC(9.4,177,22,2,"PAH",13,1,139,0)="    dropping off any trailing zero of the time from the date/time format."
^DIC(9.4,177,22,2,"PAH",13,1,140,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,141,0)="    Corrective Action:  The last action for a medication order will now"
^DIC(9.4,177,22,2,"PAH",13,1,142,0)="    display correctly under the ""Last Action"" column on the VDL."
^DIC(9.4,177,22,2,"PAH",13,1,143,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,144,0)="19. Problem:  Users who mark a PRN medication order, with the dosage"
^DIC(9.4,177,22,2,"PAH",13,1,145,0)="    form of ""PATCH"" as ""Given,"" cannot document a PRN effectiveness using"
^DIC(9.4,177,22,2,"PAH",13,1,146,0)="    the Enter PRN Effectiveness [PSB MED LOG PRN EFFECT] option."
^DIC(9.4,177,22,2,"PAH",13,1,147,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,148,0)="    Corrective Action:  Users can now document a PRN effectiveness for a"
^DIC(9.4,177,22,2,"PAH",13,1,149,0)="    ""Given"" PRN medication order with a dosage form of ""PATCH."""
^DIC(9.4,177,22,2,"PAH",13,1,150,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,151,0)="20. Problem:  Under the IV Medication Tab, if a medication order gets"
^DIC(9.4,177,22,2,"PAH",13,1,152,0)="    discontinued when a ward stock IV bag has a status of ""Stopped,"" no "
^DIC(9.4,177,22,2,"PAH",13,1,153,0)="    data would display under the ""IV Bag Chronology."""
^DIC(9.4,177,22,2,"PAH",13,1,154,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,155,0)="    Corrective Action:  Data will correctly display under the ""IV Bag"
^DIC(9.4,177,22,2,"PAH",13,1,156,0)="    Chronology"" display area when an IV order becomes discontinued and a "
^DIC(9.4,177,22,2,"PAH",13,1,157,0)="    ward stock IV bag has status of ""Stopped"" status."
^DIC(9.4,177,22,2,"PAH",13,1,158,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,159,0)="21. Problem:  The Special Instructions pop-up box does not function on"
^DIC(9.4,177,22,2,"PAH",13,1,160,0)="    the IV Medication Tab when the Pharmacist enters an exclamation (""!"") "
^DIC(9.4,177,22,2,"PAH",13,1,161,0)="    to copy and flag the Provider comments for display in a BCMA"
^DIC(9.4,177,22,2,"PAH",13,1,162,0)="    message dialogue box."
^DIC(9.4,177,22,2,"PAH",13,1,163,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,164,0)="    Corrective Action:  The Special Instructions pop-up box will now "
^DIC(9.4,177,22,2,"PAH",13,1,165,0)="    display on the IV Medication Tab when a Pharmacist finishes"
^DIC(9.4,177,22,2,"PAH",13,1,166,0)="    an IV order and uses the ""!"" key to copy and flag the Provider "
^DIC(9.4,177,22,2,"PAH",13,1,167,0)="    comments for display on the BCMA VDL."
^DIC(9.4,177,22,2,"PAH",13,1,168,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,169,0)="22. Problem:  The ""ALLERGIES:"" bar on the VDL displays ""No allergies on"
^DIC(9.4,177,22,2,"PAH",13,1,170,0)="    file"" when no assessment was completed."
^DIC(9.4,177,22,2,"PAH",13,1,171,0)=" "
^DIC(9.4,177,22,2,"PAH",13,1,172,0)="    Corrective Action:  The ""ALLERGIES:"" bar will now display  ""No Allergy"
^DIC(9.4,177,22,2,"PAH",13,1,173,0)="    Assessment"" if there are no allergies assessed and ""No Known "
^DIC(9.4,177,22,2,"PAH",13,1,174,0)="Allergies"""
^DIC(9.4,177,22,2,"PAH",13,1,175,0)="    if there is an allergy assessed, but no allergies."
^DIC(9.4,177,22,2,"PAH",14,0)="20 SEQ #14^3030417^1"
^DIC(9.4,177,22,2,"PAH",14,1,0)="^^22^22^3030417"
^DIC(9.4,177,22,2,"PAH",14,1,1,0)="1. BCMA will display a Notification Popup box, once per patient session, "
^DIC(9.4,177,22,2,"PAH",14,1,2,0)="for the Unit Dose and IVP/IVPB Medication Tabs. The Popup box displays if"
^DIC(9.4,177,22,2,"PAH",14,1,3,0)="a patient has had a recent movement, and at least one of the last actions"
^DIC(9.4,177,22,2,"PAH",14,1,4,0)="occurred within the specified timeframe defined in the ""Patient Transfer "
^DIC(9.4,177,22,2,"PAH",14,1,5,0)="Notification Timeframe:"" field on the Parameters tab of the BCMA Site"
^DIC(9.4,177,22,2,"PAH",14,1,6,0)="Parameters application. The Popup box will display the patient movement"
^DIC(9.4,177,22,2,"PAH",14,1,7,0)="type and transaction type within brackets, and the Virtual Due List (VDL)"
^DIC(9.4,177,22,2,"PAH",14,1,8,0)="will display the transaction type in the ""Last Action"" column for a "
^DIC(9.4,177,22,2,"PAH",14,1,9,0)="medication displayed on the VDL."
^DIC(9.4,177,22,2,"PAH",14,1,10,0)=" "
^DIC(9.4,177,22,2,"PAH",14,1,11,0)="2. BCMA will now document fractional dose medication orders, which occur "
^DIC(9.4,177,22,2,"PAH",14,1,12,0)="when a medication order contains a units per dose that is not a whole"
^DIC(9.4,177,22,2,"PAH",14,1,13,0)="number. When a user administers a fractional dose medication using BCMA, "
^DIC(9.4,177,22,2,"PAH",14,1,14,0)="a Multiple or a Fractional Dose dialog box will display for documenting"
^DIC(9.4,177,22,2,"PAH",14,1,15,0)="the actual amount and user comments."
^DIC(9.4,177,22,2,"PAH",14,1,16,0)=" "
^DIC(9.4,177,22,2,"PAH",14,1,17,0)="3. Three fields have been removed from the Parameters tab of the BCMA Site"
^DIC(9.4,177,22,2,"PAH",14,1,18,0)="Parameters application since the functionality no longer exists. They"
^DIC(9.4,177,22,2,"PAH",14,1,19,0)="include the ""General System Error:"" field, the ""Auto Update Notification:"""
^DIC(9.4,177,22,2,"PAH",14,1,20,0)="field in the Mail Groups section of the Parameters tab and"
^DIC(9.4,177,22,2,"PAH",14,1,21,0)="the ""UNC of the Auto Update Server:"" field in the Misc. Options section of"
^DIC(9.4,177,22,2,"PAH",14,1,22,0)="the Parameters tab."
^DIC(9.4,177,22,2,"PAH",15,0)="7 SEQ #15^3030520^1"
^DIC(9.4,177,22,2,"PAH",15,1,0)="^^45^45^3030520"
^DIC(9.4,177,22,2,"PAH",15,1,1,0)=" Problem: In reference to the Medication Variance Log [PSBO MV] option, a "
^DIC(9.4,177,22,2,"PAH",15,1,2,0)=" functional discrepancy was discovered in the coding logic used to "
^DIC(9.4,177,22,2,"PAH",15,1,3,0)=" extract previous variance information stored in the BCMA VARIANCE LOG"
^DIC(9.4,177,22,2,"PAH",15,1,4,0)=" file (#53.78).  The report will only show variance information related "
^DIC(9.4,177,22,2,"PAH",15,1,5,0)=" to patients currently assigned to the selected ward."
^DIC(9.4,177,22,2,"PAH",15,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,7,0)=" Resolution: Modifications were made to rebuild the data structure used "
^DIC(9.4,177,22,2,"PAH",15,1,8,0)=" to sort, store, and display the variance information related to all"
^DIC(9.4,177,22,2,"PAH",15,1,9,0)=" patients associated with the selected ward stored in the BCMA VARIANCE"
^DIC(9.4,177,22,2,"PAH",15,1,10,0)=" LOG file (#53.78)."
^DIC(9.4,177,22,2,"PAH",15,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,12,0)=" Problem: In reference to the Medication Variance Log [PSBO MV] option, "
^DIC(9.4,177,22,2,"PAH",15,1,13,0)=" several sites are experiencing problems with displaying variance "
^DIC(9.4,177,22,2,"PAH",15,1,14,0)=" information as a result of incompatible ward names stored in the "
^DIC(9.4,177,22,2,"PAH",15,1,15,0)=" BCMA MEDICATION VARIANCE LOG file (#53.78).  If the user selects a ward "
^DIC(9.4,177,22,2,"PAH",15,1,16,0)=" name from the WARD LOCATION file (#42) that does not match the ward name "
^DIC(9.4,177,22,2,"PAH",15,1,17,0)=" store in the BCMA MEDICATION VARIANCE LOG file (#53.78), the variance "
^DIC(9.4,177,22,2,"PAH",15,1,18,0)=" log information will not display on the report."
^DIC(9.4,177,22,2,"PAH",15,1,19,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,20,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,21,0)=" Corrective Action:  The Ward Name Conversion Process [PSB WARD CONV] "
^DIC(9.4,177,22,2,"PAH",15,1,22,0)=" option was add to the Bar Code Medication Administration Manager "
^DIC(9.4,177,22,2,"PAH",15,1,23,0)=" [PSB MGR] option to allow each site an opportunity to make the "
^DIC(9.4,177,22,2,"PAH",15,1,24,0)=" appropriate corrections to incompatible ward, room and bed names stored "
^DIC(9.4,177,22,2,"PAH",15,1,25,0)=" in their local BCMA MEDICATION VARIANCE LOG file (#53.78).  The "
^DIC(9.4,177,22,2,"PAH",15,1,26,0)=" following functions are incorporated in the Ward Name Conversion Process"
^DIC(9.4,177,22,2,"PAH",15,1,27,0)=" [PSB WARD CONV] option:"
^DIC(9.4,177,22,2,"PAH",15,1,28,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,29,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,30,0)=" o  Allow the user to select a specified date range to control the amount "
^DIC(9.4,177,22,2,"PAH",15,1,31,0)=" time needed to complete the process and the amount data that will be "
^DIC(9.4,177,22,2,"PAH",15,1,32,0)=" changed.  "
^DIC(9.4,177,22,2,"PAH",15,1,33,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,34,0)=" o  Automatically, convert Ward Name to Ward IEN if the Ward Name in BCMA "
^DIC(9.4,177,22,2,"PAH",15,1,35,0)=" MEDICATION VARIANCE LOG file (#53.78) is identical to the Ward Name in "
^DIC(9.4,177,22,2,"PAH",15,1,36,0)=" the WARD LOCATION file (#42).  "
^DIC(9.4,177,22,2,"PAH",15,1,37,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,38,0)=" o  Display a list of un-identifiable ward names to the user.  "
^DIC(9.4,177,22,2,"PAH",15,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,40,0)=" o  Allow the user to change the un-identifiable ward name to a ward name "
^DIC(9.4,177,22,2,"PAH",15,1,41,0)=" stored in the NURS LOCATION file (#211.4) and select the appropriate "
^DIC(9.4,177,22,2,"PAH",15,1,42,0)=" room and bed location."
^DIC(9.4,177,22,2,"PAH",15,1,43,0)=" "
^DIC(9.4,177,22,2,"PAH",15,1,44,0)=" o  Send an e-mail message to the user when the Ward Name Conversion "
^DIC(9.4,177,22,2,"PAH",15,1,45,0)=" Process is completed. "
^DIC(9.4,177,22,2,"PAH",16,0)="12 SEQ #16^3030520^1"
^DIC(9.4,177,22,2,"PAH",16,1,0)="^^77^77^3030520"
^DIC(9.4,177,22,2,"PAH",16,1,1,0)="NOTE: Patch PSB*2*12 makes changes to the ward-specific IV Parameters "
^DIC(9.4,177,22,2,"PAH",16,1,2,0)="functionality included in the GUI BCMA Site Parameters application. "
^DIC(9.4,177,22,2,"PAH",16,1,3,0)="Please be sure to read the Problem and Corrective Action statements below "
^DIC(9.4,177,22,2,"PAH",16,1,4,0)="and coordinate the installation of this patch appropriately before "
^DIC(9.4,177,22,2,"PAH",16,1,5,0)="installing it. (See suggestion at bottom of Corrective Action please.)"
^DIC(9.4,177,22,2,"PAH",16,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,7,0)="1.   Problem: The GUI BCMA Site Parameters application, IV Parameters "
^DIC(9.4,177,22,2,"PAH",16,1,8,0)="settings for specific wards did function as required.  The IV Parameter "
^DIC(9.4,177,22,2,"PAH",16,1,9,0)="settings for the ""ALL"" ward always affected the display of a patient's IV "
^DIC(9.4,177,22,2,"PAH",16,1,10,0)="bags on the Virtual Due List (VDL), regardless of the settings for the "
^DIC(9.4,177,22,2,"PAH",16,1,11,0)="patient's respective ward. "
^DIC(9.4,177,22,2,"PAH",16,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,13,0)="Corrective Action: The IV Parameters settings for the ""ALL"" ward affect "
^DIC(9.4,177,22,2,"PAH",16,1,14,0)="the display of a patient's IV bags VDL only when the settings are not "
^DIC(9.4,177,22,2,"PAH",16,1,15,0)="defined for the patient's respective ward. Please be aware that after you "
^DIC(9.4,177,22,2,"PAH",16,1,16,0)="install this patch, all ward-specific IV Parameters defined for wards "
^DIC(9.4,177,22,2,"PAH",16,1,17,0)="other than ""ALL"" will work immediately. These parameters control when an "
^DIC(9.4,177,22,2,"PAH",16,1,18,0)="IV bag is valid, and when BCMA warns a user   the status of an IV order "
^DIC(9.4,177,22,2,"PAH",16,1,19,0)="has changed.   If your site has defined ward-specific IV Parameters, "
^DIC(9.4,177,22,2,"PAH",16,1,20,0)="please review them BEFORE installing this patch, and notify the "
^DIC(9.4,177,22,2,"PAH",16,1,21,0)="appropriate personnel to ensure that problems are not experienced once "
^DIC(9.4,177,22,2,"PAH",16,1,22,0)="installed."
^DIC(9.4,177,22,2,"PAH",16,1,23,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,24,0)="2.   Problem: The PSB DEFAULT BARCODE PREFIX Site Parameter was set to "
^DIC(9.4,177,22,2,"PAH",16,1,25,0)="accept 1 to 5 characters so the user had to specify a prefix in the GUI "
^DIC(9.4,177,22,2,"PAH",16,1,26,0)="Bar Code Medication Administration (BCMA) Site Parameters application. If "
^DIC(9.4,177,22,2,"PAH",16,1,27,0)="none was specified, the barcode number was not recognized when the user "
^DIC(9.4,177,22,2,"PAH",16,1,28,0)="scanned a patient's medication for administration."
^DIC(9.4,177,22,2,"PAH",16,1,29,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,30,0)="     Corrective Action: The PSB DEFAULT BARCODE PREFIX Site Parameter has "
^DIC(9.4,177,22,2,"PAH",16,1,31,0)="been set to accept 0 to 5 characters, so the user does not need to "
^DIC(9.4,177,22,2,"PAH",16,1,32,0)="specify a prefix in the GUI BCMA Site Parameters application. When a "
^DIC(9.4,177,22,2,"PAH",16,1,33,0)="barcode is printed, no prefix is added to the barcode so the label scans "
^DIC(9.4,177,22,2,"PAH",16,1,34,0)="successfully during medication administration."
^DIC(9.4,177,22,2,"PAH",16,1,35,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,36,0)="3.   Problem: Changes made to the IV Parameters when using the GUI BCMA "
^DIC(9.4,177,22,2,"PAH",16,1,37,0)="Site Parameters application were not always being saved for the selected "
^DIC(9.4,177,22,2,"PAH",16,1,38,0)="division."
^DIC(9.4,177,22,2,"PAH",16,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,40,0)="     Corrective Action: Changes made to the IV Parameters when using the "
^DIC(9.4,177,22,2,"PAH",16,1,41,0)="GUI BCMA Site Parameters application are now being saved for the selected "
^DIC(9.4,177,22,2,"PAH",16,1,42,0)="division."
^DIC(9.4,177,22,2,"PAH",16,1,43,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,44,0)="4.   Problem: When the unit of administration is a patch and that patch "
^DIC(9.4,177,22,2,"PAH",16,1,45,0)="has a ""Given"" status, the BCMA Virtual Due List (VDL) displayed the last "
^DIC(9.4,177,22,2,"PAH",16,1,46,0)="action date/time of the order in the ""Last Action"" column.  The VDL did "
^DIC(9.4,177,22,2,"PAH",16,1,47,0)="not display the last action date/time of the orderable item."
^DIC(9.4,177,22,2,"PAH",16,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,49,0)="     Corrective Action: When the unit of administration is a patch and "
^DIC(9.4,177,22,2,"PAH",16,1,50,0)="the patch has a ""Given"" status, the BCMA VDL displays in the ""Last "
^DIC(9.4,177,22,2,"PAH",16,1,51,0)="Action"" column the last action date/time of the orderable item."
^DIC(9.4,177,22,2,"PAH",16,1,52,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,53,0)=" 5.  Problem: Text in the ""U/Gvn"" column of the BCMA Medication Log "
^DIC(9.4,177,22,2,"PAH",16,1,54,0)="Report did not provide word wrapping. This became apparent after "
^DIC(9.4,177,22,2,"PAH",16,1,55,0)="free-text 'quantity and units' data was entered during the administration "
^DIC(9.4,177,22,2,"PAH",16,1,56,0)="of a medication dose."
^DIC(9.4,177,22,2,"PAH",16,1,57,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,58,0)="     Corrective Action: After entering free-text 'quantity and units' "
^DIC(9.4,177,22,2,"PAH",16,1,59,0)="data during the administration of a medication dose, information in the "
^DIC(9.4,177,22,2,"PAH",16,1,60,0)="""U/Gvn"" column of the BCMA Medication Log Report will appropriately word "
^DIC(9.4,177,22,2,"PAH",16,1,61,0)="wrap."
^DIC(9.4,177,22,2,"PAH",16,1,62,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,63,0)="6.   Problem: The following is an example of an error that occurred when "
^DIC(9.4,177,22,2,"PAH",16,1,64,0)="a user attempted to administer a unit dose medication with an ""IV Push"" "
^DIC(9.4,177,22,2,"PAH",16,1,65,0)="med route:"
^DIC(9.4,177,22,2,"PAH",16,1,66,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,67,0)="    ""^Error(s) Filing Transaction MEDPASS"
^DIC(9.4,177,22,2,"PAH",16,1,68,0)="     Data Validation Error: 701: The value 'KCL 20MEQ/D5/NACL {2}' "
^DIC(9.4,177,22,2,"PAH",16,1,69,0)="     for field UNIT OF ADMINISTRATION in SOLUTIONS SUB-FIELD in file BCMA"
^DIC(9.4,177,22,2,"PAH",16,1,70,0)="     MEDICATION LOG is not valid."""
^DIC(9.4,177,22,2,"PAH",16,1,71,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,72,0)="The above error occurred under particular conditions associated with the "
^DIC(9.4,177,22,2,"PAH",16,1,73,0)="IV solution. "
^DIC(9.4,177,22,2,"PAH",16,1,74,0)=" "
^DIC(9.4,177,22,2,"PAH",16,1,75,0)="     Corrective Action: The user is able to administer unit dose "
^DIC(9.4,177,22,2,"PAH",16,1,76,0)="medications with an ""IV push"" medication route, regardless of the IV "
^DIC(9.4,177,22,2,"PAH",16,1,77,0)="solution."
^DIC(9.4,177,22,2,"PAH",17,0)="21 SEQ #17^3030603^1"
^DIC(9.4,177,22,2,"PAH",17,1,0)="^^16^16^3030603"
^DIC(9.4,177,22,2,"PAH",17,1,1,0)="1. Problem: The error message ""Error(s) Filing Transaction MEDPASS"" "
^DIC(9.4,177,22,2,"PAH",17,1,2,0)="   displays when the infusion rate for an IV Piggyback order includes more"
^DIC(9.4,177,22,2,"PAH",17,1,3,0)="   than 30 characters."
^DIC(9.4,177,22,2,"PAH",17,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",17,1,5,0)="   Correction: The INFUSION RATE field (#.35) of the BCMA MEDICATION LOG"
^DIC(9.4,177,22,2,"PAH",17,1,6,0)="   file (#53.79) was increased from 30 to 47 characters."
^DIC(9.4,177,22,2,"PAH",17,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",17,1,8,0)="2. Problem: The Missing Dose Request [PSB MISSING DOSE REQUEST] option"
^DIC(9.4,177,22,2,"PAH",17,1,9,0)="   is creating incomplete entries in the MISSING DOSE REQUEST"
^DIC(9.4,177,22,2,"PAH",17,1,10,0)="   file (#53.68), when the user enters a ""@"" in the ""Patient Name:"" "
^DIC(9.4,177,22,2,"PAH",17,1,11,0)="   prompt."
^DIC(9.4,177,22,2,"PAH",17,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",17,1,13,0)="   Correction: The Missing Dose Request [PSB MISSING DOSE REQUEST] option"
^DIC(9.4,177,22,2,"PAH",17,1,14,0)="   has been modified to not create an entry in the MISSING DOSE REQUEST"
^DIC(9.4,177,22,2,"PAH",17,1,15,0)="   file (#53.68) file, when a user enters a ""@"" in the ""Patient Name:"""
^DIC(9.4,177,22,2,"PAH",17,1,16,0)="   prompt."
^DIC(9.4,177,22,2,"PAH",18,0)="26 SEQ #18^3030628^1"
^DIC(9.4,177,22,2,"PAH",18,1,0)="^^23^23^3030628"
^DIC(9.4,177,22,2,"PAH",18,1,1,0)="Problem: If there is a continuous order, with an admin times, and "
^DIC(9.4,177,22,2,"PAH",18,1,2,0)="the frequency is null, the GUI Bar Code Medication Administration (BCMA)"
^DIC(9.4,177,22,2,"PAH",18,1,3,0)="does not display the order on the Virtual Due List (VDL) and a Due List "
^DIC(9.4,177,22,2,"PAH",18,1,4,0)="Error Notification message is not generated."
^DIC(9.4,177,22,2,"PAH",18,1,5,0)=" "
^DIC(9.4,177,22,2,"PAH",18,1,6,0)="Corrective Action: BCMA will generate a Due List Error Notification "
^DIC(9.4,177,22,2,"PAH",18,1,7,0)="message for those continuous orders that contain a standard schedule "
^DIC(9.4,177,22,2,"PAH",18,1,8,0)="with admin times and no frequency. This can also occur to non-standard "
^DIC(9.4,177,22,2,"PAH",18,1,9,0)="Schedules. Pharmacy should review the problem order and make necessary "
^DIC(9.4,177,22,2,"PAH",18,1,10,0)="corrections."
^DIC(9.4,177,22,2,"PAH",18,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",18,1,12,0)="If a DUE LIST ERROR message is encountered with a Reason of ""Invalid "
^DIC(9.4,177,22,2,"PAH",18,1,13,0)="frequency received from order"" please do the following."
^DIC(9.4,177,22,2,"PAH",18,1,14,0)=" "
^DIC(9.4,177,22,2,"PAH",18,1,15,0)="1. Determine if the schedule listed in the mail message is in FILE# 51.1 "
^DIC(9.4,177,22,2,"PAH",18,1,16,0)="   the ADMINISTRATION SCHEDULE FILE. "
^DIC(9.4,177,22,2,"PAH",18,1,17,0)="      a. If it is not, Log a NOIS."
^DIC(9.4,177,22,2,"PAH",18,1,18,0)="      b. If it is, determine if the TYPE OF SCHEDULE is CONTINUOUS."
^DIC(9.4,177,22,2,"PAH",18,1,19,0)="        i.  If it is not, log a NOIS."
^DIC(9.4,177,22,2,"PAH",18,1,20,0)="        ii. If it is, determine if the frequency is a valid number "
^DIC(9.4,177,22,2,"PAH",18,1,21,0)="            greater than zero."
^DIC(9.4,177,22,2,"PAH",18,1,22,0)="              1. If it is, log a NOIS."
^DIC(9.4,177,22,2,"PAH",18,1,23,0)="              2. If it is not, correct the frequency."
^DIC(9.4,177,22,2,"PAH",19,0)="28 SEQ #19^3030628^1"
^DIC(9.4,177,22,2,"PAH",19,1,0)="^^8^8^3030628"
^DIC(9.4,177,22,2,"PAH",19,1,1,0)="Problem: When a Day of the Week schedule is created with [PSS SCHEDULE "
^DIC(9.4,177,22,2,"PAH",19,1,2,0)="EDIT] option, the order is showing as due everyday on the Virtual Due"
^DIC(9.4,177,22,2,"PAH",19,1,3,0)="List. The Ward Administration Times [PSBO WA] option and the Medication"
^DIC(9.4,177,22,2,"PAH",19,1,4,0)="Due List [PSBO DL] option displays the same problem."
^DIC(9.4,177,22,2,"PAH",19,1,5,0)=" "
^DIC(9.4,177,22,2,"PAH",19,1,6,0)="Corrective Action: Day of the Week schedules displays correctly on the "
^DIC(9.4,177,22,2,"PAH",19,1,7,0)="Virtual Due List, Ward Administration Times [PSBO WA] option, and "
^DIC(9.4,177,22,2,"PAH",19,1,8,0)="Medication Due List [PSBO DL] option."
^DIC(9.4,177,22,2,"PAH",20,0)="19 SEQ #20^3030628^1"
^DIC(9.4,177,22,2,"PAH",20,1,0)="^^78^78^3030628"
^DIC(9.4,177,22,2,"PAH",20,1,1,0)="1.  Problem: The GUI Bar Code Medication Administration (BCMA) Site "
^DIC(9.4,177,22,2,"PAH",20,1,2,0)="    Parameters application does not perform a version check between the "
^DIC(9.4,177,22,2,"PAH",20,1,3,0)="    GUI application and the CHUI application."
^DIC(9.4,177,22,2,"PAH",20,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,5,0)="    Corrective Action: BCMA will validate the version of the GUI BCMA "
^DIC(9.4,177,22,2,"PAH",20,1,6,0)="    Site Parameters application running on the client against the CHUI"
^DIC(9.4,177,22,2,"PAH",20,1,7,0)="    application. The client version must match the patch number on the"
^DIC(9.4,177,22,2,"PAH",20,1,8,0)="    VistA server, and if compatible, the previous GUI version will be"
^DIC(9.4,177,22,2,"PAH",20,1,9,0)="    allowed to run. No prior version will be allowed to run on the client."
^DIC(9.4,177,22,2,"PAH",20,1,10,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,11,0)="2.  Problem: The Medication History Report, which is available by "
^DIC(9.4,177,22,2,"PAH",20,1,12,0)="    performing a right-click on an order from the BCMA Virtual Due List"
^DIC(9.4,177,22,2,"PAH",20,1,13,0)="    (VDL), displays incorrect data for an IV medication order. This occurs"
^DIC(9.4,177,22,2,"PAH",20,1,14,0)="    when an IV order contains more than one orderable item."
^DIC(9.4,177,22,2,"PAH",20,1,15,0)="  "
^DIC(9.4,177,22,2,"PAH",20,1,16,0)="    Corrective Action: The Medication History Report will now display the "
^DIC(9.4,177,22,2,"PAH",20,1,17,0)="    medication history for each orderable item contained in an IV  "
^DIC(9.4,177,22,2,"PAH",20,1,18,0)="    medication order."
^DIC(9.4,177,22,2,"PAH",20,1,19,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,20,0)="3.  Problem: A user can administer multiple patches for an On-Call "
^DIC(9.4,177,22,2,"PAH",20,1,21,0)="    medication order, with a dosage form of ""PATCH,"" without the previous"
^DIC(9.4,177,22,2,"PAH",20,1,22,0)="    patch being removed."
^DIC(9.4,177,22,2,"PAH",20,1,23,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,24,0)="    Corrective Action: For an On-Call medication order with a dosage form "
^DIC(9.4,177,22,2,"PAH",20,1,25,0)="    of ""PATCH,"" a user must first remove the previous patch administered"
^DIC(9.4,177,22,2,"PAH",20,1,26,0)="    before allowing any proceeding patches to be given."
^DIC(9.4,177,22,2,"PAH",20,1,27,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,28,0)="4.  Problem: The administration times for a medication order that uses a "
^DIC(9.4,177,22,2,"PAH",20,1,29,0)="    Day-of-the-Week schedule (i.e., MO-WE-FR@0900) do not print on the "
^DIC(9.4,177,22,2,"PAH",20,1,30,0)="    MAH."
^DIC(9.4,177,22,2,"PAH",20,1,31,0)="    "
^DIC(9.4,177,22,2,"PAH",20,1,32,0)="    Corrective Action: The MAH will now display the administration times "
^DIC(9.4,177,22,2,"PAH",20,1,33,0)="    for a medication order containing a Day-of-the-Week schedule."
^DIC(9.4,177,22,2,"PAH",20,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,35,0)="5.  Problem: The VDL generates displays an error if the user types  "
^DIC(9.4,177,22,2,"PAH",20,1,36,0)="    special characters (i.e., ""^"" or ""?"") when entering a comment for a"
^DIC(9.4,177,22,2,"PAH",20,1,37,0)="    medication order."
^DIC(9.4,177,22,2,"PAH",20,1,38,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,39,0)="    Corrective Action: Any special characters entered with comments    "
^DIC(9.4,177,22,2,"PAH",20,1,40,0)="    will be removed when BCMA files the comment."
^DIC(9.4,177,22,2,"PAH",20,1,41,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,42,0)="6.  Problem: The option ""Take Action on WS"" was removed in BCMA patch "
^DIC(9.4,177,22,2,"PAH",20,1,43,0)="    PSB*2*20. This option allowed the user to change the status of a ward"
^DIC(9.4,177,22,2,"PAH",20,1,44,0)="    stock IV bag."
^DIC(9.4,177,22,2,"PAH",20,1,45,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,46,0)="    Corrective Action: The option ""Take Action on WS"" has been added to  "
^DIC(9.4,177,22,2,"PAH",20,1,47,0)="    patch PSB*2*19."
^DIC(9.4,177,22,2,"PAH",20,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,49,0)="7.  Problem: The new Reduced Space Symbology (RSS) bar codes contain the "
^DIC(9.4,177,22,2,"PAH",20,1,50,0)="    National Drug Code (NDC) number in a new format called  ""Global Trade "
^DIC(9.4,177,22,2,"PAH",20,1,51,0)="    Item Number (GTIN)."" The GTIN has a 14-digit data structure, which is"
^DIC(9.4,177,22,2,"PAH",20,1,52,0)="    used within the EAN.UCC System for the unique identification of trade"
^DIC(9.4,177,22,2,"PAH",20,1,53,0)="    items worldwide."
^DIC(9.4,177,22,2,"PAH",20,1,54,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,55,0)="    Corrective Action: BCMA GUI will correctly read the GTIN and search   "
^DIC(9.4,177,22,2,"PAH",20,1,56,0)="    the SYNONYM field (#.01) of the DRUG file (#50) for a matching NDC"
^DIC(9.4,177,22,2,"PAH",20,1,57,0)="    number."
^DIC(9.4,177,22,2,"PAH",20,1,58,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,59,0)="8.  Problem: The BCMA GUI Due List Report allows the user to select a "
^DIC(9.4,177,22,2,"PAH",20,1,60,0)="    stop time that is prior to the start time."
^DIC(9.4,177,22,2,"PAH",20,1,61,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,62,0)="    Corrective Action: The BCMA GUI Due List will not allow the user to "
^DIC(9.4,177,22,2,"PAH",20,1,63,0)="    select a stop time that is prior to the start time:"
^DIC(9.4,177,22,2,"PAH",20,1,64,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,65,0)="9.  Problem: The MAH Report only displays the action of ""Removed"" for a "
^DIC(9.4,177,22,2,"PAH",20,1,66,0)="    PRN, On-Call, and One-Time medication order with a dosage form of"
^DIC(9.4,177,22,2,"PAH",20,1,67,0)="    ""PATCH."""
^DIC(9.4,177,22,2,"PAH",20,1,68,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,69,0)="    Corrective Action: The MAH Report will now display actions of "
^DIC(9.4,177,22,2,"PAH",20,1,70,0)="    ""Removed"" and ""Given.""  for PRN, On-Call, and One-Time medication"
^DIC(9.4,177,22,2,"PAH",20,1,71,0)="    orders with a dosage form of ""PATCH."""
^DIC(9.4,177,22,2,"PAH",20,1,72,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,73,0)="10. Problem: If an IV medication order has an infusing bag and becomes "
^DIC(9.4,177,22,2,"PAH",20,1,74,0)="    expired, the infusing bag  continues to display on the VDL, along with"
^DIC(9.4,177,22,2,"PAH",20,1,75,0)="    the other available bags."
^DIC(9.4,177,22,2,"PAH",20,1,76,0)=" "
^DIC(9.4,177,22,2,"PAH",20,1,77,0)="    Corrective Action: Available bags will not display when an IV     "
^DIC(9.4,177,22,2,"PAH",20,1,78,0)="    medication order becomes expired."
^DIC(9.4,177,22,2,"PAH",21,0)="24 SEQ #21^3030715^1"
^DIC(9.4,177,22,2,"PAH",21,1,0)="^^45^45^3030715"
^DIC(9.4,177,22,2,"PAH",21,1,1,0)="1. Bar Code Medication Administration (BCMA) will provide a visual"
^DIC(9.4,177,22,2,"PAH",21,1,2,0)="indicator on the Virtual Due List (VDL) to identify which schedule types"
^DIC(9.4,177,22,2,"PAH",21,1,3,0)="have active orders within the specified start and stop date/time for the"
^DIC(9.4,177,22,2,"PAH",21,1,4,0)="selected Medication Tab. A green ""alert light"" to the left of the"
^DIC(9.4,177,22,2,"PAH",21,1,5,0)="Schedule Type indicates that it has active orders for the specified"
^DIC(9.4,177,22,2,"PAH",21,1,6,0)="timeframe, and a gray ""alert light"" to the left of the Schedule Type"
^DIC(9.4,177,22,2,"PAH",21,1,7,0)="indicates that it has no active orders for the specified timeframe."
^DIC(9.4,177,22,2,"PAH",21,1,8,0)=" "
^DIC(9.4,177,22,2,"PAH",21,1,9,0)="2. PRN medications will display on the VDL if the PRN Schedule Types"
^DIC(9.4,177,22,2,"PAH",21,1,10,0)="check box is selected in the GUI BCMA Site Parameters application. All"
^DIC(9.4,177,22,2,"PAH",21,1,11,0)="other schedule types will remain selected on the VDL by default when the"
^DIC(9.4,177,22,2,"PAH",21,1,12,0)="user opens a patient's record."
^DIC(9.4,177,22,2,"PAH",21,1,13,0)=" "
^DIC(9.4,177,22,2,"PAH",21,1,14,0)="3. The VDL will display a BCMA Clinical Reminders marquee at the lower"
^DIC(9.4,177,22,2,"PAH",21,1,15,0)="right hand corner. The ""count"" is the number of PRN medications"
^DIC(9.4,177,22,2,"PAH",21,1,16,0)="without Effectiveness comments within the hours defined in the"
^DIC(9.4,177,22,2,"PAH",21,1,17,0)="""PRN Documentation"" field on the Parameters tab of the GUI BCMA Site"
^DIC(9.4,177,22,2,"PAH",21,1,18,0)="Parameters application or within the current admission whichever is "
^DIC(9.4,177,22,2,"PAH",21,1,19,0)="greater."
^DIC(9.4,177,22,2,"PAH",21,1,20,0)="A mouse-over list displays the last four undocumented PRN orders."
^DIC(9.4,177,22,2,"PAH",21,1,21,0)="When the user double clicks anywhere on the PRN Effectiveness row of"
^DIC(9.4,177,22,2,"PAH",21,1,22,0)="the BCMA Clinical Reminders marquee, the PRN Effectiveness Log dialog box"
^DIC(9.4,177,22,2,"PAH",21,1,23,0)="displays all PRN orders that need PRN Effectiveness and allowing"
^DIC(9.4,177,22,2,"PAH",21,1,24,0)="documentation of PRN Effectiveness comments for each order listed."
^DIC(9.4,177,22,2,"PAH",21,1,25,0)=" "
^DIC(9.4,177,22,2,"PAH",21,1,26,0)="The ""count"" will update/refresh when the user:"
^DIC(9.4,177,22,2,"PAH",21,1,27,0)="a) opens a patient file."
^DIC(9.4,177,22,2,"PAH",21,1,28,0)="b) administers a PRN medication order."
^DIC(9.4,177,22,2,"PAH",21,1,29,0)="c) completes the documentation of a PRN Effectiveness."
^DIC(9.4,177,22,2,"PAH",21,1,30,0)="d) refreshes the VDL."
^DIC(9.4,177,22,2,"PAH",21,1,31,0)=" "
^DIC(9.4,177,22,2,"PAH",21,1,32,0)="A Med History button has been added to display the Medication"
^DIC(9.4,177,22,2,"PAH",21,1,33,0)="Administration History for the order selected."
^DIC(9.4,177,22,2,"PAH",21,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",21,1,35,0)="4. When administering a PRN medication, the units given column"
^DIC(9.4,177,22,2,"PAH",21,1,36,0)="within the Last Four Actions table and a drop down box for the users to"
^DIC(9.4,177,22,2,"PAH",21,1,37,0)="select the PRN Reason have been added to the Medication Log dialog box."
^DIC(9.4,177,22,2,"PAH",21,1,38,0)="Units given will not display for orders with multiple dispensed drugs."
^DIC(9.4,177,22,2,"PAH",21,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",21,1,40,0)="5. An updated PRN Effectiveness Log dialog will ease the process of"
^DIC(9.4,177,22,2,"PAH",21,1,41,0)="PRN Effectiveness documentation. It displays a list of undocumented PRN"
^DIC(9.4,177,22,2,"PAH",21,1,42,0)="medications for a specific order, or across orders, including PRN "
^DIC(9.4,177,22,2,"PAH",21,1,43,0)="medications from previous or expired orders. The dialog box"
^DIC(9.4,177,22,2,"PAH",21,1,44,0)="includes a ""units given"" column, which will not display units for orders"
^DIC(9.4,177,22,2,"PAH",21,1,45,0)="with multiple dispensed drugs. The division column has been removed."
^DIC(9.4,177,22,2,"PAH",22,0)="32 SEQ #22^3030821^1"
^DIC(9.4,177,22,2,"PAH",22,1,0)="^^29^29^3030821"
^DIC(9.4,177,22,2,"PAH",22,1,1,0)="***NOTE*** This patch should be discussed at each Department of "
^DIC(9.4,177,22,2,"PAH",22,1,2,0)="Veterans Affairs Medical Centers (VAMC) before being invoked. "
^DIC(9.4,177,22,2,"PAH",22,1,3,0)=" "
^DIC(9.4,177,22,2,"PAH",22,1,4,0)="Problem: Sites are experiencing a large number of undocumented "
^DIC(9.4,177,22,2,"PAH",22,1,5,0)="Pro Re Nata (PRN) effectiveness in the counter displaying under the"
^DIC(9.4,177,22,2,"PAH",22,1,6,0)="""BCMA Clinical Reminders"" section of the GUI Bar Code Medication"
^DIC(9.4,177,22,2,"PAH",22,1,7,0)="Administration (BCMA) Virtual Due List (VDL). "
^DIC(9.4,177,22,2,"PAH",22,1,8,0)=" "
^DIC(9.4,177,22,2,"PAH",22,1,9,0)="Solution: The Bar Code Medication Administration Manager [PSB MGR] "
^DIC(9.4,177,22,2,"PAH",22,1,10,0)="menu contains the Documenting Backlog PRNs [PSB PRN DOCUMENTING] option "
^DIC(9.4,177,22,2,"PAH",22,1,11,0)="which will allow a user to run a report for a date range that will "
^DIC(9.4,177,22,2,"PAH",22,1,12,0)="search through the BCMA MEDICATION LOG file (#53.79) for all "
^DIC(9.4,177,22,2,"PAH",22,1,13,0)="undocumented PRNs. The Documenting Backlog PRNs [PSB PRN DOCUMENTING]"
^DIC(9.4,177,22,2,"PAH",22,1,14,0)="option will automatically enter in a comment of ""Administrative Closure"""
^DIC(9.4,177,22,2,"PAH",22,1,15,0)="for all undocumented PRNs identified by the report."
^DIC(9.4,177,22,2,"PAH",22,1,16,0)=" "
^DIC(9.4,177,22,2,"PAH",22,1,17,0)="In accordance with M1, Part 1, Chapter 5, these blank sections of the PRN "
^DIC(9.4,177,22,2,"PAH",22,1,18,0)="documentation will reflect the term ""Administrative Closure"" when the "
^DIC(9.4,177,22,2,"PAH",22,1,19,0)="software is used to close these blank portions related to the PRN "
^DIC(9.4,177,22,2,"PAH",22,1,20,0)="documentation. The sites medical record review committee should document "
^DIC(9.4,177,22,2,"PAH",22,1,21,0)="the decision to run the patch to administrative close the undocumented "
^DIC(9.4,177,22,2,"PAH",22,1,22,0)="PRN if the site chooses to use this option. In those cases where the sites"
^DIC(9.4,177,22,2,"PAH",22,1,23,0)="have reviewed the charts and find that the PRN documentation appears in"
^DIC(9.4,177,22,2,"PAH",22,1,24,0)="the patient record in other than the BCMA PRN field, the site should"
^DIC(9.4,177,22,2,"PAH",22,1,25,0)="individually enter ""documented in progress note."""
^DIC(9.4,177,22,2,"PAH",22,1,26,0)=" "
^DIC(9.4,177,22,2,"PAH",22,1,27,0)="The person installing the patch will receive a MailMan message when"
^DIC(9.4,177,22,2,"PAH",22,1,28,0)="the process has completed. The subject line will read, ""BCMA PRN"
^DIC(9.4,177,22,2,"PAH",22,1,29,0)="DOCUMENTATION Notification."""
^DIC(9.4,177,22,2,"PAH",23,0)="17 SEQ #23^3030912^1"
^DIC(9.4,177,22,2,"PAH",23,1,0)="^^13^13^3030912"
^DIC(9.4,177,22,2,"PAH",23,1,1,0)="The VistA Bar Code Medical Administration Backup System (Patch PSB*2*17)"
^DIC(9.4,177,22,2,"PAH",23,1,2,0)="software being released will provide a Class I solution to the BCMA "
^DIC(9.4,177,22,2,"PAH",23,1,3,0)="Contingency IRA #20020403.  This plan reflects the intent of VHA Directive"
^DIC(9.4,177,22,2,"PAH",23,1,4,0)="6210, The Automated Information Systems (AIS) Security, which states that "
^DIC(9.4,177,22,2,"PAH",23,1,5,0)="all facilities are responsible for the development, maintenance, and"
^DIC(9.4,177,22,2,"PAH",23,1,6,0)="annual testing of individual AIS contingency.  This software maintains a"
^DIC(9.4,177,22,2,"PAH",23,1,7,0)="current copy, on the designated workstation, of all the inpatient pharmacy"
^DIC(9.4,177,22,2,"PAH",23,1,8,0)="activities including the inpatient medical orders(Unit Dose and IV), "
^DIC(9.4,177,22,2,"PAH",23,1,9,0)="medication administration and patient allergies, that are included "
^DIC(9.4,177,22,2,"PAH",23,1,10,0)="on a Pharmacy Medical Administration Record (MAR) and Medical "
^DIC(9.4,177,22,2,"PAH",23,1,11,0)="Administration History (MAH). Workstation(s) are updated using the "
^DIC(9.4,177,22,2,"PAH",23,1,12,0)="VA Health Level (HL7) package and are available for use according to "
^DIC(9.4,177,22,2,"PAH",23,1,13,0)="local policies concerning VistA, BCMA or network outages."
^DIC(9.4,177,22,2,"PAH",24,0)="33 SEQ #24^3030924^1"
^DIC(9.4,177,22,2,"PAH",24,1,0)="^^17^17^3030924"
^DIC(9.4,177,22,2,"PAH",24,1,1,0)="Problem: NOIS SAJ-0803-71312"
^DIC(9.4,177,22,2,"PAH",24,1,2,0)="An IV Piggyback order with a Schedule Type of Continuous that has Admin "
^DIC(9.4,177,22,2,"PAH",24,1,3,0)="times, (i.e., Q12H with admin times of 0800-2000), and a frequency set to "
^DIC(9.4,177,22,2,"PAH",24,1,4,0)="null, does not display on the Bar Code Medication Administration (BCMA) "
^DIC(9.4,177,22,2,"PAH",24,1,5,0)="Graphical User Interface (GUI) Virtual Due List (VDL) IVP/IVPB Medication "
^DIC(9.4,177,22,2,"PAH",24,1,6,0)="Tab and the Due List [PSBODL] option. The VDL and the Due List [PSBODL] "
^DIC(9.4,177,22,2,"PAH",24,1,7,0)="option also do not generate a Due List Error Notification message."
^DIC(9.4,177,22,2,"PAH",24,1,8,0)=" "
^DIC(9.4,177,22,2,"PAH",24,1,9,0)="Corrective Action:"
^DIC(9.4,177,22,2,"PAH",24,1,10,0)="The BCMA Due List [PSBODL] option, and the VDL will generate a Due List "
^DIC(9.4,177,22,2,"PAH",24,1,11,0)="Error Notification message for IV Piggyback medication orders with a "
^DIC(9.4,177,22,2,"PAH",24,1,12,0)="Schedule Type of Continuous that have Admin times, and A frequency set to "
^DIC(9.4,177,22,2,"PAH",24,1,13,0)="null. The BCMA Due List [PSBODL] option, and the VDL will generate a Due "
^DIC(9.4,177,22,2,"PAH",24,1,14,0)="List Error Notification message for orders with Schedule Type of "
^DIC(9.4,177,22,2,"PAH",24,1,15,0)="Continuous that are Unit Dose and IV Piggyback orders that have schedules "
^DIC(9.4,177,22,2,"PAH",24,1,16,0)="names in the format of administration times but the Admin times do not "
^DIC(9.4,177,22,2,"PAH",24,1,17,0)="exist on the order (i.e., schedule = 1200-1600 admin times = NULL)."
^DIC(9.4,177,22,2,"PAH",25,0)="14 SEQ #25^3031023^1"
^DIC(9.4,177,22,2,"PAH",25,1,0)="^^83^83^3031023"
^DIC(9.4,177,22,2,"PAH",25,1,1,0)=" 1. Problem: NOIS ISB-1102-30304"
^DIC(9.4,177,22,2,"PAH",25,1,2,0)=" The Drug File Inquiry [PSB DRUG INQUIRY] option does not resemble or"
^DIC(9.4,177,22,2,"PAH",25,1,3,0)=" follow a similar drug selection process used in other provider system"
^DIC(9.4,177,22,2,"PAH",25,1,4,0)=" applications such as Inpatient Medication V 5.0 and Pharmacy Data"
^DIC(9.4,177,22,2,"PAH",25,1,5,0)=" Management V 1.0. A site is requesting modifications that will add"
^DIC(9.4,177,22,2,"PAH",25,1,6,0)=" consistency to the drug selection process. "
^DIC(9.4,177,22,2,"PAH",25,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,8,0)=" Corrective Action: The Drug File Inquiry [PSB DRUG INQUIRY] option has a "
^DIC(9.4,177,22,2,"PAH",25,1,9,0)=" revised continuous search index function that resembles the drug "
^DIC(9.4,177,22,2,"PAH",25,1,10,0)=" selection process used in other provider system applications such as "
^DIC(9.4,177,22,2,"PAH",25,1,11,0)=" Inpatient Medication V 5.0 and Pharmacy Data Management V 1.0."
^DIC(9.4,177,22,2,"PAH",25,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,13,0)=" 2. Problem: NOIS NCH-1102-40363"
^DIC(9.4,177,22,2,"PAH",25,1,14,0)=" The Medication Variance Log [PSBO MV] option will inappropriately display"
^DIC(9.4,177,22,2,"PAH",25,1,15,0)=" variance information related to medication orders with a status of"
^DIC(9.4,177,22,2,"PAH",25,1,16,0)=" ""REMOVED"" on the BCMA Variance Log Report."
^DIC(9.4,177,22,2,"PAH",25,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,18,0)=" Corrective Action: The Medication Variance Log [PSBO MV] option will not "
^DIC(9.4,177,22,2,"PAH",25,1,19,0)=" display variance information related to medication orders with a status "
^DIC(9.4,177,22,2,"PAH",25,1,20,0)=" of ""REMOVED"" on the BCMA Variance Log Report."
^DIC(9.4,177,22,2,"PAH",25,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,22,0)=" 3. Problem: NOIS MAD-0902-42331"
^DIC(9.4,177,22,2,"PAH",25,1,23,0)=" The Enter PRN Effectiveness [PSB MED LOG PRN EFFECT] option will"
^DIC(9.4,177,22,2,"PAH",25,1,24,0)=" improperly allow users an opportunity to enter a comment for PRN "
^DIC(9.4,177,22,2,"PAH",25,1,25,0)=" medication orders that do not have a status of ""GIVEN""."
^DIC(9.4,177,22,2,"PAH",25,1,26,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,27,0)=" Corrective Action: The Enter PRN Effectiveness [PSB MED LOG PRN EFFECT] "
^DIC(9.4,177,22,2,"PAH",25,1,28,0)=" option will only allow users an opportunity to enter a comment for PRN "
^DIC(9.4,177,22,2,"PAH",25,1,29,0)=" medication orders with a status of ""GIVEN""."
^DIC(9.4,177,22,2,"PAH",25,1,30,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,31,0)=" 4. Problem: NOIS CLL-0203-40445"
^DIC(9.4,177,22,2,"PAH",25,1,32,0)=" The Label Print [PSBO BL] option will not retrieve the correct drug name"
^DIC(9.4,177,22,2,"PAH",25,1,33,0)=" if the user enters the drug name as lower case letters."
^DIC(9.4,177,22,2,"PAH",25,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,35,0)=" Corrective Action: The Label Print [PSBO BL] option will retrieve the "
^DIC(9.4,177,22,2,"PAH",25,1,36,0)=" correct drug name if the user enters the drug name as lower case letters."
^DIC(9.4,177,22,2,"PAH",25,1,37,0)="  "
^DIC(9.4,177,22,2,"PAH",25,1,38,0)=" 5. Problem: NOIS ISB-1102-32339"
^DIC(9.4,177,22,2,"PAH",25,1,39,0)=" The Medication Variance Log [PSBO MV] option will only display variance"
^DIC(9.4,177,22,2,"PAH",25,1,40,0)=" information related to patients currently assigned to the selected ward"
^DIC(9.4,177,22,2,"PAH",25,1,41,0)=" on the BCMA Variance Log Report. The option will not display variances"
^DIC(9.4,177,22,2,"PAH",25,1,42,0)=" information associated with previous patients assigned to the selected"
^DIC(9.4,177,22,2,"PAH",25,1,43,0)=" wards."
^DIC(9.4,177,22,2,"PAH",25,1,44,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,45,0)=" Corrective Action: The Medication Variance Log [PSBO MV] option will "
^DIC(9.4,177,22,2,"PAH",25,1,46,0)=" rebuild the data structure used to sort, store, and display the variance "
^DIC(9.4,177,22,2,"PAH",25,1,47,0)=" information related to all patients assigned to the selected ward stored "
^DIC(9.4,177,22,2,"PAH",25,1,48,0)=" in the BCMA MEDICATION VARIANCE LOG file (#53.78)."
^DIC(9.4,177,22,2,"PAH",25,1,49,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,50,0)=" 6. Problem: NOIS MWV-0102-23190 "
^DIC(9.4,177,22,2,"PAH",25,1,51,0)=" The Medication Variance Log [PSBO MV] option will not display variance"
^DIC(9.4,177,22,2,"PAH",25,1,52,0)=" information on the BCMA Variance Log Report when the user selects to"
^DIC(9.4,177,22,2,"PAH",25,1,53,0)=" print the report by ward names.  Several sites are experiencing this"
^DIC(9.4,177,22,2,"PAH",25,1,54,0)=" problem as a result of incompatible ward names between the BCMA"
^DIC(9.4,177,22,2,"PAH",25,1,55,0)=" MEDICATION VARIANCE LOG file (#53.78) and the NURS LOCATION file"
^DIC(9.4,177,22,2,"PAH",25,1,56,0)=" (#211.4).  In addition, sites should populate their NURS LOCATION file "
^DIC(9.4,177,22,2,"PAH",25,1,57,0)=" (#211.4) with the proper ward name from the WARD LOCATION file (#42) to "
^DIC(9.4,177,22,2,"PAH",25,1,58,0)=" prevent this problem from reoccurring."
^DIC(9.4,177,22,2,"PAH",25,1,59,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,60,0)=" Corrective Action: The Medication Variance Log [PSBO MV] option will "
^DIC(9.4,177,22,2,"PAH",25,1,61,0)=" compare the ward's internal entry number (IEN) stored in the BCMA "
^DIC(9.4,177,22,2,"PAH",25,1,62,0)=" MEDICATION VARIANCE LOG file (#53.78) to the ward's IEN stored in the "
^DIC(9.4,177,22,2,"PAH",25,1,63,0)=" WARD LOCATION file (#42).  The BCMA application will store the ward's IEN"
^DIC(9.4,177,22,2,"PAH",25,1,64,0)=" for future variances.  Site must use the new Ward Name Conversion Process"
^DIC(9.4,177,22,2,"PAH",25,1,65,0)=" [PSB WARD CONVERSION] option under the Bar Code Medication Administration"
^DIC(9.4,177,22,2,"PAH",25,1,66,0)=" Manager [PSB MGR] option to convert the ward name associated with "
^DIC(9.4,177,22,2,"PAH",25,1,67,0)=" previous variance information stored in the BCMA MEDICATION VARIANCE LOG "
^DIC(9.4,177,22,2,"PAH",25,1,68,0)=" file (#53.78) in order to print a BCMA Variance Log Report based on "
^DIC(9.4,177,22,2,"PAH",25,1,69,0)=" previous variance information. "
^DIC(9.4,177,22,2,"PAH",25,1,70,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,71,0)=" The Ward Name Conversion Process [PSB WARD CONVERSION] option is "
^DIC(9.4,177,22,2,"PAH",25,1,72,0)=" temporary. However, in the future, Bar Code Medication Administration "
^DIC(9.4,177,22,2,"PAH",25,1,73,0)=" patch PSB*2*23 will remove the temporary Ward Name Conversion Process "
^DIC(9.4,177,22,2,"PAH",25,1,74,0)=" option from your system. The Ward Name Conversion Process option will "
^DIC(9.4,177,22,2,"PAH",25,1,75,0)=" perform the following functions: "
^DIC(9.4,177,22,2,"PAH",25,1,76,0)=" "
^DIC(9.4,177,22,2,"PAH",25,1,77,0)=" a. Allow users to select a specified date range, which will control the "
^DIC(9.4,177,22,2,"PAH",25,1,78,0)="    amount of data and time needed to complete the process."
^DIC(9.4,177,22,2,"PAH",25,1,79,0)=" b. Convert the ward's name to the ward's internal entry number (IEN) if "
^DIC(9.4,177,22,2,"PAH",25,1,80,0)="    the Ward Name in BCMA MEDICATION VARIANCE LOG file (#53.78) is"
^DIC(9.4,177,22,2,"PAH",25,1,81,0)="    identical to the Ward Name in the WARD LOCATION file (#42)."
^DIC(9.4,177,22,2,"PAH",25,1,82,0)=" c. Display a list of un-identifiable ward names and allows the user to "
^DIC(9.4,177,22,2,"PAH",25,1,83,0)="    make the appropriate corrections."
^DIC(9.4,177,22,2,"PAH",26,0)="25 SEQ #26^3031107^1"
^DIC(9.4,177,22,2,"PAH",26,1,0)="^^86^86^3031107"
^DIC(9.4,177,22,2,"PAH",26,1,1,0)="1.  Problem: NOIS AAA-0303-N1449"
^DIC(9.4,177,22,2,"PAH",26,1,2,0)="    The ""Last Action"" column on the Bar Code Medication Administration"
^DIC(9.4,177,22,2,"PAH",26,1,3,0)="    (BCMA) Virtual Due List (VDL) displays inaccurate information via a "
^DIC(9.4,177,22,2,"PAH",26,1,4,0)="    sequence of administrative actions upon two distinct orders having the"
^DIC(9.4,177,22,2,"PAH",26,1,5,0)="    same orderable item."
^DIC(9.4,177,22,2,"PAH",26,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,7,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,8,0)="    The ""Last Action"" column on the BCMA VDL will display appropriate and"
^DIC(9.4,177,22,2,"PAH",26,1,9,0)="    accurate status, date and time information per orderable item."
^DIC(9.4,177,22,2,"PAH",26,1,10,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,12,0)="2.  Problem: NOIS ISB-0503-30409"
^DIC(9.4,177,22,2,"PAH",26,1,13,0)="    After a medication patch order is ""Given,"" if that order expires or is"
^DIC(9.4,177,22,2,"PAH",26,1,14,0)="    discontinued, and the patient has no other active orders, the patch "
^DIC(9.4,177,22,2,"PAH",26,1,15,0)="    does not display on the VDL; the message ""No Active Orders"" displays "
^DIC(9.4,177,22,2,"PAH",26,1,16,0)="    instead."
^DIC(9.4,177,22,2,"PAH",26,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,18,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,19,0)="    If a patch is ""Given"" and not ""Removed,"" it should display on the VDL "
^DIC(9.4,177,22,2,"PAH",26,1,20,0)="    until it is marked as ""Removed."" A patch with the status of ""Given"" "
^DIC(9.4,177,22,2,"PAH",26,1,21,0)="    will display on the VDL until it is marked as ""Removed."""
^DIC(9.4,177,22,2,"PAH",26,1,22,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,23,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,24,0)="3.  Problem: NOIS ISB-0503-30409"
^DIC(9.4,177,22,2,"PAH",26,1,25,0)="    After a large volume IV order is ""Infusing,"" if that order expires or "
^DIC(9.4,177,22,2,"PAH",26,1,26,0)="    is discontinued and the patient has no other active orders, the "
^DIC(9.4,177,22,2,"PAH",26,1,27,0)="    infusing IV does not always display on the VDL; the message ""No "
^DIC(9.4,177,22,2,"PAH",26,1,28,0)="    Active Orders"" displays instead."
^DIC(9.4,177,22,2,"PAH",26,1,29,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,30,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,31,0)="    If an IV is ""Infusing"" and not ""Completed,"" it should display on the "
^DIC(9.4,177,22,2,"PAH",26,1,32,0)="    VDL up to 7 days after the order is expired/discontinued or until the "
^DIC(9.4,177,22,2,"PAH",26,1,33,0)="    order is marked as ""Completed.""  An IV that is ""Infusing"" will "
^DIC(9.4,177,22,2,"PAH",26,1,34,0)="    display on the VDL for 7 days after the order is expired/discontinued "
^DIC(9.4,177,22,2,"PAH",26,1,35,0)="    or until it is marked as ""Completed."""
^DIC(9.4,177,22,2,"PAH",26,1,36,0)="    "
^DIC(9.4,177,22,2,"PAH",26,1,37,0)="    "
^DIC(9.4,177,22,2,"PAH",26,1,38,0)="    "
^DIC(9.4,177,22,2,"PAH",26,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,41,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,42,0)="4.  Problem: NOIS HAM-0103-22522, HUN-0403-21086"
^DIC(9.4,177,22,2,"PAH",26,1,43,0)="    The Edit Medication Log [PSB MED LOG EDIT] option does not allow the "
^DIC(9.4,177,22,2,"PAH",26,1,44,0)="    user to change the status of a medication patch from ""Given"" to "
^DIC(9.4,177,22,2,"PAH",26,1,45,0)="    ""Removed.""  An attempt to change the status from ""Given"" to ""Removed"" "
^DIC(9.4,177,22,2,"PAH",26,1,46,0)="    using the Edit Medication Log [PSB MED LOG EDIT] option displays the "
^DIC(9.4,177,22,2,"PAH",26,1,47,0)="    message ""Allowed status codes are Given, Not Given, Held, and "
^DIC(9.4,177,22,2,"PAH",26,1,48,0)="    Refused,"" preventing the status change of the medication patch."
^DIC(9.4,177,22,2,"PAH",26,1,49,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,50,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,51,0)="    The Edit Medication Log [PSB MED LOG EDIT] option will allow the "
^DIC(9.4,177,22,2,"PAH",26,1,52,0)="    status of a ""Given"" medication patch to be changed to ""Removed."""
^DIC(9.4,177,22,2,"PAH",26,1,53,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,54,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,55,0)="5.  Problem: NOIS ISB-0703-30098"
^DIC(9.4,177,22,2,"PAH",26,1,56,0)="    The Manual Medication Entry [PSB MED LOG NEW ENTRY] allows the user to"
^DIC(9.4,177,22,2,"PAH",26,1,57,0)="    enter any administration status for any order type. For example, the "
^DIC(9.4,177,22,2,"PAH",26,1,58,0)="    user can create a new BCMA Medication Log entry for a medication "
^DIC(9.4,177,22,2,"PAH",26,1,59,0)="    patch order, with an administration status of ""Completed."" "
^DIC(9.4,177,22,2,"PAH",26,1,60,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,61,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,62,0)="    The Manual Medication Entry [PSB MED LOG NEW ENTRY] will only allow "
^DIC(9.4,177,22,2,"PAH",26,1,63,0)="    the user to enter ""Given,"" ""Held,"" or ""Refused"" for orders which are "
^DIC(9.4,177,22,2,"PAH",26,1,64,0)="    not IV  orders. A status for an IV order will not be allowed since IV "
^DIC(9.4,177,22,2,"PAH",26,1,65,0)="    medications cannot be entered via this menu option."
^DIC(9.4,177,22,2,"PAH",26,1,66,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,67,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,68,0)="6.  Problem: NOIS ISB-0703-30653"
^DIC(9.4,177,22,2,"PAH",26,1,69,0)="    The ""Schedule:"" prompt in the Manual Medication Entry [PSB MED LOG NEW"
^DIC(9.4,177,22,2,"PAH",26,1,70,0)="    ENTRY] option screen displays the schedule type instead of the "
^DIC(9.4,177,22,2,"PAH",26,1,71,0)="    schedule."
^DIC(9.4,177,22,2,"PAH",26,1,72,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,73,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,74,0)="    The ""Schedule:"" prompt in the Manual Medication Entry [PSB MED LOG NEW"
^DIC(9.4,177,22,2,"PAH",26,1,75,0)="    ENTRY] option screen will display the schedule."
^DIC(9.4,177,22,2,"PAH",26,1,76,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,77,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,78,0)="7.  Problem: NOIS CLL-0303-40554"
^DIC(9.4,177,22,2,"PAH",26,1,79,0)="    The Manual Medication Entry [PSB MED LOG NEW ENTRY] option allows the "
^DIC(9.4,177,22,2,"PAH",26,1,80,0)="    user to enter a future date and time for a medication administration, "
^DIC(9.4,177,22,2,"PAH",26,1,81,0)="    which sometimes causes inaccurate information on BCMA reports."
^DIC(9.4,177,22,2,"PAH",26,1,82,0)=" "
^DIC(9.4,177,22,2,"PAH",26,1,83,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",26,1,84,0)="    The Manual Medication Entry [PSB MED LOG NEW ENTRY] option will not "
^DIC(9.4,177,22,2,"PAH",26,1,85,0)="    allow the user to enter a future date and time for a medication "
^DIC(9.4,177,22,2,"PAH",26,1,86,0)="    administration."
^DIC(9.4,177,22,2,"PAH",27,0)="30 SEQ #27^3031121^1"
^DIC(9.4,177,22,2,"PAH",27,1,0)="^^137^137^3031121"
^DIC(9.4,177,22,2,"PAH",27,1,1,0)="*** ATTENTION: This patch includes a new Graphical User Interface (GUI) "
^DIC(9.4,177,22,2,"PAH",27,1,2,0)="executable file."
^DIC(9.4,177,22,2,"PAH",27,1,3,0)="       Installation of this GUI is NOT required immediately after the "
^DIC(9.4,177,22,2,"PAH",27,1,4,0)="KIDS install for the Patch to function. ***"
^DIC(9.4,177,22,2,"PAH",27,1,5,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,7,0)="For retrieval and installation instructions, please see the Client "
^DIC(9.4,177,22,2,"PAH",27,1,8,0)="Installation Instructions section."
^DIC(9.4,177,22,2,"PAH",27,1,9,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,10,0)="Patch PSB*2*30 presents some changes to the 'look and feel' of the Bar  "
^DIC(9.4,177,22,2,"PAH",27,1,11,0)="Code Medication Administration (BCMA) GUI. One change is the additive and "
^DIC(9.4,177,22,2,"PAH",27,1,12,0)="solution display automatically for an infusing bag in the IV chronology "
^DIC(9.4,177,22,2,"PAH",27,1,13,0)="section of the Virtual Due List (VDL).  Another change is during the "
^DIC(9.4,177,22,2,"PAH",27,1,14,0)="administration of a Pro Re Nata (PRN) the PRN reason may be selected by "
^DIC(9.4,177,22,2,"PAH",27,1,15,0)="typing the first letter of the PRN Reason.  BCMA will focus on the PRN "
^DIC(9.4,177,22,2,"PAH",27,1,16,0)="Reasons that start with the first letter typed in the PRN Reason "
^DIC(9.4,177,22,2,"PAH",27,1,17,0)="selection area."
^DIC(9.4,177,22,2,"PAH",27,1,18,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,19,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,20,0)="1.    Problem: NOIS CPH-0703-40060"
^DIC(9.4,177,22,2,"PAH",27,1,21,0)="When an IV medication order becomes expired while an IV bag is "
^DIC(9.4,177,22,2,"PAH",27,1,22,0)="""INFUSING"" or ""STOPPED,"" the un-administered bags of that order are still "
^DIC(9.4,177,22,2,"PAH",27,1,23,0)="""available"" for administration. "
^DIC(9.4,177,22,2,"PAH",27,1,24,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,25,0)="Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,26,0)="When an IV medication order expires, the un-administered IV bags will not "
^DIC(9.4,177,22,2,"PAH",27,1,27,0)="display on the BCMA VDL."
^DIC(9.4,177,22,2,"PAH",27,1,28,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,29,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,30,0)="2.    Problem: NOIS RIC-0703-20366"
^DIC(9.4,177,22,2,"PAH",27,1,31,0)="The ""Scanner Status:"" indicator on the BCMA VDL displays red when the "
^DIC(9.4,177,22,2,"PAH",27,1,32,0)="user switches from another application back to the BCMA GUI."
^DIC(9.4,177,22,2,"PAH",27,1,33,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,34,0)="Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,35,0)="The BCMA VDL Scanner Status indicator will display green when it is "
^DIC(9.4,177,22,2,"PAH",27,1,36,0)="possible to scan medication using BCMA. "
^DIC(9.4,177,22,2,"PAH",27,1,37,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,38,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,39,0)="3.    Problem: NOIS ISB-0303-31005"
^DIC(9.4,177,22,2,"PAH",27,1,40,0)="Multiple IV bags of an order may be ""INFUSING"" simultaneously.  BCMA does "
^DIC(9.4,177,22,2,"PAH",27,1,41,0)="not allow proper maintenance of any of these administered IV bags.  For "
^DIC(9.4,177,22,2,"PAH",27,1,42,0)="example the user cannot ""COMPLETE"" any of the ""INFUSING"" IV bags."
^DIC(9.4,177,22,2,"PAH",27,1,43,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,44,0)="Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,45,0)="BCMA will allow the maintenance of an order with multiple ""INFUSING"" IV "
^DIC(9.4,177,22,2,"PAH",27,1,46,0)="bags."
^DIC(9.4,177,22,2,"PAH",27,1,47,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,49,0)="4.    Problem: NOIS ISB-0703-31029"
^DIC(9.4,177,22,2,"PAH",27,1,50,0)="If the BCMA GUI user enters a space alone as documentation of PRN "
^DIC(9.4,177,22,2,"PAH",27,1,51,0)="Effectiveness, an ""information box"" displays because the space is "
^DIC(9.4,177,22,2,"PAH",27,1,52,0)="inappropriately treated as a special character.     "
^DIC(9.4,177,22,2,"PAH",27,1,53,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,54,0)="      Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,55,0)="When documenting PRN Effectiveness using the BCMA GUI via a lone space "
^DIC(9.4,177,22,2,"PAH",27,1,56,0)="character, the lone space will not be treated as a special character; "
^DIC(9.4,177,22,2,"PAH",27,1,57,0)="instead the user will be asked to re-enter the data."
^DIC(9.4,177,22,2,"PAH",27,1,58,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,59,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,60,0)="5.    Problem: NOIS ISB-0703-30373"
^DIC(9.4,177,22,2,"PAH",27,1,61,0)="The user must scroll the list of output devices to select the most "
^DIC(9.4,177,22,2,"PAH",27,1,62,0)="recently used print device."
^DIC(9.4,177,22,2,"PAH",27,1,63,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,64,0)="      Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,65,0)="The print device most recently selected by the user will display first in "
^DIC(9.4,177,22,2,"PAH",27,1,66,0)="the list of selectable print devices."
^DIC(9.4,177,22,2,"PAH",27,1,67,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,68,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,69,0)="6.    Problem: NOIS ISB-0703-30480"
^DIC(9.4,177,22,2,"PAH",27,1,70,0)="Using the BCMA Site Parameter GUI application, the user can seemingly "
^DIC(9.4,177,22,2,"PAH",27,1,71,0)="create an unlimited number of entries for a ""Default Answer List"" such as "
^DIC(9.4,177,22,2,"PAH",27,1,72,0)="the BCMA ""Injection Site"" list .  These entries should then be selectable "
^DIC(9.4,177,22,2,"PAH",27,1,73,0)="from the respective list box during certain medication administration "
^DIC(9.4,177,22,2,"PAH",27,1,74,0)="using the BCMA GUI.  Without notice to the user, BCMA limits the number "
^DIC(9.4,177,22,2,"PAH",27,1,75,0)="of entries/selections to 60."
^DIC(9.4,177,22,2,"PAH",27,1,76,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,77,0)="      Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,78,0)="Using the BCMA Site Parameter GUI application, the user will be able to "
^DIC(9.4,177,22,2,"PAH",27,1,79,0)="create up to 100 entries for a BCMA ""Default Answer List"" list box.  "
^DIC(9.4,177,22,2,"PAH",27,1,80,0)="Therefore it will be possible for the user to have up to 100 entries to "
^DIC(9.4,177,22,2,"PAH",27,1,81,0)="select from the respective BCMA GUI list box."
^DIC(9.4,177,22,2,"PAH",27,1,82,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,83,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,84,0)="7.    Problem: NOIS ISB-0703-30478"
^DIC(9.4,177,22,2,"PAH",27,1,85,0)="Using the BCMA Site Parameter GUI application the user can seemingly "
^DIC(9.4,177,22,2,"PAH",27,1,86,0)="create entries for a BCMA ""Default Answer List"" box, such as the BCMA "
^DIC(9.4,177,22,2,"PAH",27,1,87,0)="""Injection Site"" list, longer than 30 characters.  Without notice to the "
^DIC(9.4,177,22,2,"PAH",27,1,88,0)="user, BCMA limits the number of characters for a list entry to 30."
^DIC(9.4,177,22,2,"PAH",27,1,89,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,90,0)="      Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,91,0)="Using the BCMA Site Parameter GUI application the user will not be able "
^DIC(9.4,177,22,2,"PAH",27,1,92,0)="to create entries for a BCMA ""Default Answer List"" more than 30 "
^DIC(9.4,177,22,2,"PAH",27,1,93,0)="characters in length."
^DIC(9.4,177,22,2,"PAH",27,1,94,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,95,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,96,0)="8.    Problem: NOIS ISB-0703-30290"
^DIC(9.4,177,22,2,"PAH",27,1,97,0)="Using the BCMA GUI, the user cannot submit a Missing Dose Request for a "
^DIC(9.4,177,22,2,"PAH",27,1,98,0)="medication patch order when another patch from that order displays a "
^DIC(9.4,177,22,2,"PAH",27,1,99,0)="status of ""GIVEN"" on the VDL."
^DIC(9.4,177,22,2,"PAH",27,1,100,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,101,0)="      Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,102,0)="BCMA will allow the user to submit a Missing Dose Request for a "
^DIC(9.4,177,22,2,"PAH",27,1,103,0)="medication patch order when another patch from that order displays a "
^DIC(9.4,177,22,2,"PAH",27,1,104,0)="status of ""GIVEN"" on the VDL."
^DIC(9.4,177,22,2,"PAH",27,1,105,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,106,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,107,0)="9.      Problem: NOIS ISB-0703-31421"
^DIC(9.4,177,22,2,"PAH",27,1,108,0)="When the user submits a Missing Dose Request for a PRN medication and "
^DIC(9.4,177,22,2,"PAH",27,1,109,0)="immediately (without refreshing the BCMA VDL) marks that PRN as ""GIVEN,"" "
^DIC(9.4,177,22,2,"PAH",27,1,110,0)="BCMA files into the BCMA Medication Log a null value as the PRN Reason."
^DIC(9.4,177,22,2,"PAH",27,1,111,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,112,0)="      Corrective Action:"
^DIC(9.4,177,22,2,"PAH",27,1,113,0)="BCMA will file into the BCMA Medication Log the PRN Reason as selected by "
^DIC(9.4,177,22,2,"PAH",27,1,114,0)="the user for the respective PRN administration."
^DIC(9.4,177,22,2,"PAH",27,1,115,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,116,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,117,0)="10.   Problem: NOIS SDC-0803-60738"
^DIC(9.4,177,22,2,"PAH",27,1,118,0)="When a Global Trade Identification Number (GTIN) bar code was scanned, "
^DIC(9.4,177,22,2,"PAH",27,1,119,0)="BCMA would strip out the National Drug Code (NDC) number from the GTIN "
^DIC(9.4,177,22,2,"PAH",27,1,120,0)="and perform a search on it. This would result in BCMA not finding a match "
^DIC(9.4,177,22,2,"PAH",27,1,121,0)="and displaying the error message ""Invalid Medication Lookup. DO NOT "
^DIC(9.4,177,22,2,"PAH",27,1,122,0)="GIVE!!"""
^DIC(9.4,177,22,2,"PAH",27,1,123,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,124,0)="      Corrective Action: "
^DIC(9.4,177,22,2,"PAH",27,1,125,0)="The logic that performs the lookup has been modified to not strip out the "
^DIC(9.4,177,22,2,"PAH",27,1,126,0)="NDC number.       "
^DIC(9.4,177,22,2,"PAH",27,1,127,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,128,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,129,0)="11.   Enhancement: E3R#18328"
^DIC(9.4,177,22,2,"PAH",27,1,130,0)="BCMA GUI will allow a medication patch to be marked as ""HELD"" or "
^DIC(9.4,177,22,2,"PAH",27,1,131,0)="""REFUSED"" while another patch from the same order displays as ""GIVEN"" and "
^DIC(9.4,177,22,2,"PAH",27,1,132,0)="not marked ""REMOVED."""
^DIC(9.4,177,22,2,"PAH",27,1,133,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,134,0)=" "
^DIC(9.4,177,22,2,"PAH",27,1,135,0)="12.   Enhancement: E3R#13940"
^DIC(9.4,177,22,2,"PAH",27,1,136,0)="BCMA GUI will provide the user access to the BCMA Medication Variance Log"
^DIC(9.4,177,22,2,"PAH",27,1,137,0)="Report from the Reports menu of the VDL."
^DIC(9.4,177,22,2,"PAH",28,0)="31 SEQ #28^3031121^1"
^DIC(9.4,177,22,2,"PAH",28,1,0)="^^79^79^3031121"
^DIC(9.4,177,22,2,"PAH",28,1,1,0)="1. The user is allowed to view and print the Bar Code Medication "
^DIC(9.4,177,22,2,"PAH",28,1,2,0)="   Administration (BCMA) ward specific reports via the BCMA GUI (Graphical"
^DIC(9.4,177,22,2,"PAH",28,1,3,0)="   user interface) application without having to open a patient record."
^DIC(9.4,177,22,2,"PAH",28,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,5,0)="2. When administering a PRN medication or documenting a PRN "
^DIC(9.4,177,22,2,"PAH",28,1,6,0)="   Effectiveness, the Medication Log dialog box or the PRN Effectiveness "
^DIC(9.4,177,22,2,"PAH",28,1,7,0)="   Log respectively will display a vitals table with the vital signs: "
^DIC(9.4,177,22,2,"PAH",28,1,8,0)="   Temperature (Temp), Pulse, Respiration (Resp), Blood Pressure (BP) and "
^DIC(9.4,177,22,2,"PAH",28,1,9,0)="   Pain. Each of the vital signs will list up to 4 vital entries made "
^DIC(9.4,177,22,2,"PAH",28,1,10,0)="   within the last 7 days."
^DIC(9.4,177,22,2,"PAH",28,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,12,0)="3. When the user opens a patient record from the BCMA GUI application, the"
^DIC(9.4,177,22,2,"PAH",28,1,13,0)="   Vitals Cumulative Report can be accessed from the Reports menu."
^DIC(9.4,177,22,2,"PAH",28,1,14,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,15,0)="4. When enabled, BCMA will broadcast BCMA Medication Log data to "
^DIC(9.4,177,22,2,"PAH",28,1,16,0)="   applications that subscribe to BCMA Heath Level 7 (HL7) Messaging.  "
^DIC(9.4,177,22,2,"PAH",28,1,17,0)="   The events or transactions tht trigger the message broadcasts are"
^DIC(9.4,177,22,2,"PAH",28,1,18,0)="   MEDPASS, UPDATE, STATUS, ADD COMMENT, and PRN EFFECTIVENESS.  Upon the "
^DIC(9.4,177,22,2,"PAH",28,1,19,0)="   completion of each ""trigger event,"" BCMA will send HL7 version 2.4 "
^DIC(9.4,177,22,2,"PAH",28,1,20,0)="   compliant messages to COTS and other subscribing products or "
^DIC(9.4,177,22,2,"PAH",28,1,21,0)="   applications. The BCMA HL7 interface must be activated after "
^DIC(9.4,177,22,2,"PAH",28,1,22,0)="   installation for messaging to occur."
^DIC(9.4,177,22,2,"PAH",28,1,23,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,24,0)="5. When the user launches the BCMA GUI application, the message box"
^DIC(9.4,177,22,2,"PAH",28,1,25,0)="   displays information regarding BCMA 508 compliance. This information"
^DIC(9.4,177,22,2,"PAH",28,1,26,0)="   can also be found in the BCMA Help, About dialog box."
^DIC(9.4,177,22,2,"PAH",28,1,27,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,28,0)="6. When the user scans a currently infusing or stopped bag on the VDL IV"
^DIC(9.4,177,22,2,"PAH",28,1,29,0)="   tab and the associated order has had any changes made to it since the"
^DIC(9.4,177,22,2,"PAH",28,1,30,0)="   infusing or stopped bag's label was printed, the Scan IV box will "
^DIC(9.4,177,22,2,"PAH",28,1,31,0)="   display Order changes including bag status and changes made on the "
^DIC(9.4,177,22,2,"PAH",28,1,32,0)="   associated order."
^DIC(9.4,177,22,2,"PAH",28,1,33,0)="   "
^DIC(9.4,177,22,2,"PAH",28,1,34,0)="7. A new column ""Bag Information"" has been added to the VDL IV tab. This"
^DIC(9.4,177,22,2,"PAH",28,1,35,0)="   column contains the administration status, date and time of the "
^DIC(9.4,177,22,2,"PAH",28,1,36,0)="   currently infusing or stopped bag on its associated order and one of "
^DIC(9.4,177,22,2,"PAH",28,1,37,0)="   the following messages if the order has changed since the bag label "
^DIC(9.4,177,22,2,"PAH",28,1,38,0)="   was printed. ""INFUSING bag on changed order"" or""STOPPED bag on changed "
^DIC(9.4,177,22,2,"PAH",28,1,39,0)="   order"". This column is updated every time the patient record is opened "
^DIC(9.4,177,22,2,"PAH",28,1,40,0)="   or the VDL is refreshed."
^DIC(9.4,177,22,2,"PAH",28,1,41,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,42,0)="8. Problem: NOIS MIN-0703-42067"
^DIC(9.4,177,22,2,"PAH",28,1,43,0)="   The Bar Code Medication Administration (BCMA) Graphical User Interface"
^DIC(9.4,177,22,2,"PAH",28,1,44,0)="   (GUI) does not print the Medication History Report for large volume"
^DIC(9.4,177,22,2,"PAH",28,1,45,0)="   IV's under the GUI IV Medication Tab."
^DIC(9.4,177,22,2,"PAH",28,1,46,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,47,0)="   Corrective Action:"
^DIC(9.4,177,22,2,"PAH",28,1,48,0)="   The BCMA GUI Medication History Report for IV Medications will print"
^DIC(9.4,177,22,2,"PAH",28,1,49,0)="   for large volume IV's under the GUI IV Medication Tab."
^DIC(9.4,177,22,2,"PAH",28,1,50,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,51,0)="9. Problem: NOIS TAB-0903-40220"
^DIC(9.4,177,22,2,"PAH",28,1,52,0)="   When users take BCMA offline by unchecking the BCMA on-line check box"
^DIC(9.4,177,22,2,"PAH",28,1,53,0)="   on the GUI BCMA Site Parameters Facility Tab, the users are unable to"
^DIC(9.4,177,22,2,"PAH",28,1,54,0)="   sign in again to the BCMA Site Parameters application and get the"
^DIC(9.4,177,22,2,"PAH",28,1,55,0)="   following error: ""The BCMA Application is not active for this"
^DIC(9.4,177,22,2,"PAH",28,1,56,0)="   division"", followed by an application error."
^DIC(9.4,177,22,2,"PAH",28,1,57,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,58,0)="   Corrective Action: When users take BCMA offline by unchecking the"
^DIC(9.4,177,22,2,"PAH",28,1,59,0)="   BCMA on-line check box on the GUI BCMA Site Parameters Facility Tab,"
^DIC(9.4,177,22,2,"PAH",28,1,60,0)="   the users will be able to sign in again to the BCMA Site Parameters"
^DIC(9.4,177,22,2,"PAH",28,1,61,0)="   application without receiving the above errors."
^DIC(9.4,177,22,2,"PAH",28,1,62,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,63,0)="10. Problem: NOIS ISB-0703-30291"
^DIC(9.4,177,22,2,"PAH",28,1,64,0)="    When a user selects a report from the BCMA GUI Reports menu, the"
^DIC(9.4,177,22,2,"PAH",28,1,65,0)="    ""Print by"" area of the associated dialog box does not display all"
^DIC(9.4,177,22,2,"PAH",28,1,66,0)="    wards in the Ward list box."
^DIC(9.4,177,22,2,"PAH",28,1,67,0)="     "
^DIC(9.4,177,22,2,"PAH",28,1,68,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",28,1,69,0)="    The ""Print by"" area of the BCMA GUI report dialog boxes displays all "
^DIC(9.4,177,22,2,"PAH",28,1,70,0)="    wards in the Ward list box."
^DIC(9.4,177,22,2,"PAH",28,1,71,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,72,0)="11. Problem: NOIS MAD-0203-42078"
^DIC(9.4,177,22,2,"PAH",28,1,73,0)="    When the user attempts to enter an order via the Computerized Patient "
^DIC(9.4,177,22,2,"PAH",28,1,74,0)="    Record System (CPRS) Med Order Button, the order is being cancelled "
^DIC(9.4,177,22,2,"PAH",28,1,75,0)="    due to an error, ""missing data, unable to file"""
^DIC(9.4,177,22,2,"PAH",28,1,76,0)=" "
^DIC(9.4,177,22,2,"PAH",28,1,77,0)="   Corrective Action:"
^DIC(9.4,177,22,2,"PAH",28,1,78,0)="   The user will be able to successfully enter an order via CPRS Med "
^DIC(9.4,177,22,2,"PAH",28,1,79,0)="   Order Button without receiving the above error."
^DIC(9.4,177,22,2,"PAH",29,0)="22 SEQ #29^3031121^1"
^DIC(9.4,177,22,2,"PAH",29,1,0)="^^17^17^3031121"
^DIC(9.4,177,22,2,"PAH",29,1,1,0)="1. Problem: The Missed Medications [PSBO MM] option does not display a "
^DIC(9.4,177,22,2,"PAH",29,1,2,0)="   One-Time order for the new ward after a patient is transferred to"
^DIC(9.4,177,22,2,"PAH",29,1,3,0)="   another ward."
^DIC(9.4,177,22,2,"PAH",29,1,4,0)=" "
^DIC(9.4,177,22,2,"PAH",29,1,5,0)="   Corrective Action: The Missed Medications [PSBO MM] option displays a "
^DIC(9.4,177,22,2,"PAH",29,1,6,0)="   One-Time order after a patient is transferred to another ward."
^DIC(9.4,177,22,2,"PAH",29,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",29,1,8,0)="2. Problem: The Missed Medications [PSBO MM] option displays ""(Hold)"""
^DIC(9.4,177,22,2,"PAH",29,1,9,0)="   next to a medication when a Provider places it on Hold. When the "
^DIC(9.4,177,22,2,"PAH",29,1,10,0)="   Provider takes if Off Hold, no verbiage is displayed next to the "
^DIC(9.4,177,22,2,"PAH",29,1,11,0)="   medication."
^DIC(9.4,177,22,2,"PAH",29,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",29,1,13,0)="   Corrective Action: The Missed Medications [PSBO MM] option displays "
^DIC(9.4,177,22,2,"PAH",29,1,14,0)="   ""(On Hold)"" date and time below a medication when the Provider places"
^DIC(9.4,177,22,2,"PAH",29,1,15,0)="   it on Hold. When the Provider takes if off Hold, it displays the"
^DIC(9.4,177,22,2,"PAH",29,1,16,0)="   ""(On Hold)"" date and time as well as the ""(Off Hold)"": date and time"
^DIC(9.4,177,22,2,"PAH",29,1,17,0)="   below the medication."
^DIC(9.4,177,22,2,"PAH",30,0)="27 SEQ #30^3031231^1"
^DIC(9.4,177,22,2,"PAH",30,1,0)="^^86^86^3031231"
^DIC(9.4,177,22,2,"PAH",30,1,1,0)="1.  Problem: NOIS ISB-0503-30379"
^DIC(9.4,177,22,2,"PAH",30,1,2,0)="    The Medication Administration History [PSBO MH] option "
^DIC(9.4,177,22,2,"PAH",30,1,3,0)="    and the Medication Administration Log [PSBO ML] option displays"
^DIC(9.4,177,22,2,"PAH",30,1,4,0)="    the Pro Re Nata (PRN) Effectiveness reasons on one continuous "
^DIC(9.4,177,22,2,"PAH",30,1,5,0)="    sentence rather than wrapping the information to several lines for"
^DIC(9.4,177,22,2,"PAH",30,1,6,0)="    viewing."
^DIC(9.4,177,22,2,"PAH",30,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,8,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",30,1,9,0)="    option and the Medication Administration Log [PSBO ML] "
^DIC(9.4,177,22,2,"PAH",30,1,10,0)="    option display the PRN Effectiveness reasons using word wrap."
^DIC(9.4,177,22,2,"PAH",30,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,12,0)="2   Problem: NOIS ISB-0503-31838"
^DIC(9.4,177,22,2,"PAH",30,1,13,0)="    A medication order with a Day-of-the-Week schedule, will use"
^DIC(9.4,177,22,2,"PAH",30,1,14,0)="    the frequency from Inpatient Medication, and incorrectly display the  "
^DIC(9.4,177,22,2,"PAH",30,1,15,0)="    data on the Graphical User Interface (GUI) Bar Code Medication "
^DIC(9.4,177,22,2,"PAH",30,1,16,0)="    Administration (BCMA) Virtual Due List (VDL) as being due everyday."
^DIC(9.4,177,22,2,"PAH",30,1,17,0)="    "
^DIC(9.4,177,22,2,"PAH",30,1,18,0)="    Corrective Action: A medication order with a Day-of-the-Week "
^DIC(9.4,177,22,2,"PAH",30,1,19,0)="    schedule correctly displays on the GUI BCMA VDL on the day scheduled."
^DIC(9.4,177,22,2,"PAH",30,1,20,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,21,0)="3.  Problem: NOIS LIT-0303-72207 "
^DIC(9.4,177,22,2,"PAH",30,1,22,0)="    The Medication Administration History [PSBO MH] option will not "
^DIC(9.4,177,22,2,"PAH",30,1,23,0)="    display medication orders with an odd schedule, which include"
^DIC(9.4,177,22,2,"PAH",30,1,24,0)="    administration times."
^DIC(9.4,177,22,2,"PAH",30,1,25,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,26,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",30,1,27,0)="    option displays odd schedules with administration times, along with"
^DIC(9.4,177,22,2,"PAH",30,1,28,0)="    the following message, ""NOTE - ODD SCHEDULE NO LONGER ALLOWS "
^DIC(9.4,177,22,2,"PAH",30,1,29,0)="    ADMIN TIMES."" "
^DIC(9.4,177,22,2,"PAH",30,1,30,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,31,0)="4.  Problem: NOIS ISB-1102-30781 "
^DIC(9.4,177,22,2,"PAH",30,1,32,0)="    The Medication Administration History [PSBO MH] option and the "
^DIC(9.4,177,22,2,"PAH",30,1,33,0)="    Medication History Report are not accessible to the user when"
^DIC(9.4,177,22,2,"PAH",30,1,34,0)="    a medication is not due. "
^DIC(9.4,177,22,2,"PAH",30,1,35,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,36,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",30,1,37,0)="    Option and the Medication History report displays three asterisks "
^DIC(9.4,177,22,2,"PAH",30,1,38,0)="    (""***"") in the Date column when a medication is not due."
^DIC(9.4,177,22,2,"PAH",30,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,40,0)="5.  Problem: NOIS AMA-0403-70477 "
^DIC(9.4,177,22,2,"PAH",30,1,41,0)="    The Patient Due List Report and the Ward Administration Time Report "
^DIC(9.4,177,22,2,"PAH",30,1,42,0)="    will not display a ""due"" medication, on the correct day, for "
^DIC(9.4,177,22,2,"PAH",30,1,43,0)="    schedules with frequencies greater than 24 hours, (i.e.,Q36)."
^DIC(9.4,177,22,2,"PAH",30,1,44,0)="    "
^DIC(9.4,177,22,2,"PAH",30,1,45,0)="    Corrective Action: The Patient Due List Report and the Ward "
^DIC(9.4,177,22,2,"PAH",30,1,46,0)="    Administration Time Report display ""due"" medication, on the correct"
^DIC(9.4,177,22,2,"PAH",30,1,47,0)="    day, for schedules with a frequency greater then 24 hours."
^DIC(9.4,177,22,2,"PAH",30,1,48,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,49,0)="6.  Problem: NOIS MAD-0303-40194 "
^DIC(9.4,177,22,2,"PAH",30,1,50,0)="    The Medication Administration Log [PSBO ML] option, Medication Log "
^DIC(9.4,177,22,2,"PAH",30,1,51,0)="    Report displays the medication as ""GIVEN"" with the incorrect dosage "
^DIC(9.4,177,22,2,"PAH",30,1,52,0)="    value, after the medication status was marked as ""Not Given"" on the"
^DIC(9.4,177,22,2,"PAH",30,1,53,0)="    VDL."
^DIC(9.4,177,22,2,"PAH",30,1,54,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,55,0)="    Corrective Action: The Medication Administration Log [PSBO ML] option"
^DIC(9.4,177,22,2,"PAH",30,1,56,0)="    and the Medication Log Report display the medications administration  "
^DIC(9.4,177,22,2,"PAH",30,1,57,0)="    units of zero when the medication is set to ""NOT GIVEN"" on the VDL."
^DIC(9.4,177,22,2,"PAH",30,1,58,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,59,0)="7.  Problem: NOIS ISB-0703-30482 "
^DIC(9.4,177,22,2,"PAH",30,1,60,0)="    The Medication Administration History [PSBO MH] option,"
^DIC(9.4,177,22,2,"PAH",30,1,61,0)="    Medication History Report, will display the word ""HOLD"" in the Date "
^DIC(9.4,177,22,2,"PAH",30,1,62,0)="    column, for all days on the report, even after the medication is "
^DIC(9.4,177,22,2,"PAH",30,1,63,0)="    taken Off Hold."
^DIC(9.4,177,22,2,"PAH",30,1,64,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,65,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",30,1,66,0)="    option, Medication History Report, displays ""HOLD"" in the Date column "
^DIC(9.4,177,22,2,"PAH",30,1,67,0)="    on the days that the medication was placed On Hold, through the end "
^DIC(9.4,177,22,2,"PAH",30,1,68,0)="    date of the report. When the medication is taken Off Hold, the word "
^DIC(9.4,177,22,2,"PAH",30,1,69,0)="    ""HOLD"" Appears on the Report from the On Hold date to the Off Hold "
^DIC(9.4,177,22,2,"PAH",30,1,70,0)="    date."
^DIC(9.4,177,22,2,"PAH",30,1,71,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,72,0)="8.  Problem: NOIS ISB-0703-30482"
^DIC(9.4,177,22,2,"PAH",30,1,73,0)="    The Medication Administration History [PSBO MH] option incorrectly "
^DIC(9.4,177,22,2,"PAH",30,1,74,0)="    displays orders with a Schedule Type of Continuous, with a Schedule in"
^DIC(9.4,177,22,2,"PAH",30,1,75,0)="    the format of administration times (i.e. Schedule = 1200-1400) but"
^DIC(9.4,177,22,2,"PAH",30,1,76,0)="    where the Admin times have been deleted. Continuous schedules with"
^DIC(9.4,177,22,2,"PAH",30,1,77,0)="    valid admin times that are not Day-of-the-Week Schedules but have a"
^DIC(9.4,177,22,2,"PAH",30,1,78,0)="    NULL frequency are also incorrectly displayed."
^DIC(9.4,177,22,2,"PAH",30,1,79,0)=" "
^DIC(9.4,177,22,2,"PAH",30,1,80,0)="    Corrective Action: The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",30,1,81,0)="    option will not display orders that meet the above criteria."
^DIC(9.4,177,22,2,"PAH",30,1,82,0)="    "
^DIC(9.4,177,22,2,"PAH",30,1,83,0)="9.  Enhancement: E3R NO.15232"
^DIC(9.4,177,22,2,"PAH",30,1,84,0)="    The Medication Administration History [PSBO MH] "
^DIC(9.4,177,22,2,"PAH",30,1,85,0)="    option and the Medication History report displays the date as well "
^DIC(9.4,177,22,2,"PAH",30,1,86,0)="    as the time the order was started on the report."
^DIC(9.4,177,22,2,"PAH",31,0)="35 SEQ #31^3031231^1"
^DIC(9.4,177,22,2,"PAH",31,1,0)="^^76^76^3031231"
^DIC(9.4,177,22,2,"PAH",31,1,1,0)="*** DUE TO PURGED PENDING-ORDERS, BCMA MAY NOT BE ABLE TO TRACK AND "
^DIC(9.4,177,22,2,"PAH",31,1,2,0)="DISPLAY ORDER HISTORY AND ORDER CHANGES.  WITH INSTALLATION OF "
^DIC(9.4,177,22,2,"PAH",31,1,3,0)="PSB*2.0*35, BCMA ERRORS CAUSED BY PURGED PENDING-ORDERS ARE INTERCEPTED, "
^DIC(9.4,177,22,2,"PAH",31,1,4,0)="BUT WILL NOT ALLOW BCMA TO TRACK AND DISPLAY COMPLETE ORDER HISTORY AND "
^DIC(9.4,177,22,2,"PAH",31,1,5,0)="ORDER CHANGE DATA.  ***"
^DIC(9.4,177,22,2,"PAH",31,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,8,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,9,0)="1.  Problem NOIS HIN-0703-41481:"
^DIC(9.4,177,22,2,"PAH",31,1,10,0)="    Medications with a Schedule Type of Continuous and marked as ""Held"" may"
^DIC(9.4,177,22,2,"PAH",31,1,11,0)="    not display on the Due List [PSBO DL] option report."
^DIC(9.4,177,22,2,"PAH",31,1,12,0)="    This issue becomes very apparent when the Bar Code Medication "
^DIC(9.4,177,22,2,"PAH",31,1,13,0)="    Administration (BCMA) system is generating Internal Entry Numbers"
^DIC(9.4,177,22,2,"PAH",31,1,14,0)="    (IEN) for the BCMA Medication Log file (#53.79) which exceed the date "
^DIC(9.4,177,22,2,"PAH",31,1,15,0)="    numerically."
^DIC(9.4,177,22,2,"PAH",31,1,16,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,17,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",31,1,18,0)="    Medications with a Schedule Type of Continuous and marked as ""Held"""
^DIC(9.4,177,22,2,"PAH",31,1,19,0)="    will display on the Due List [PSBO DL] option report."
^DIC(9.4,177,22,2,"PAH",31,1,20,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,22,0)="2.  Problem: NOIS ISB-0703-30657"
^DIC(9.4,177,22,2,"PAH",31,1,23,0)="    When creating an administration for a Pro Re Nata (PRN) order in the "
^DIC(9.4,177,22,2,"PAH",31,1,24,0)="    Manual Medication Entry [PSB MED LOG NEW ENTRY] option, the ""Brief "
^DIC(9.4,177,22,2,"PAH",31,1,25,0)="    Administration History"" displays the status of ""Not Given"" as one of"
^DIC(9.4,177,22,2,"PAH",31,1,26,0)="    the last four actions."
^DIC(9.4,177,22,2,"PAH",31,1,27,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,28,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",31,1,29,0)="    When creating an administration for a PRN order in the Manual Medication "
^DIC(9.4,177,22,2,"PAH",31,1,30,0)="    Entry [PSB MED LOG NEW ENTRY] option, the ""Brief Administration "
^DIC(9.4,177,22,2,"PAH",31,1,31,0)="    History"" will not display the status of ""Not Given"" as one of the last "
^DIC(9.4,177,22,2,"PAH",31,1,32,0)="    four actions. "
^DIC(9.4,177,22,2,"PAH",31,1,33,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,35,0)="3.  Problem: NOIS WPB-0503-31999"
^DIC(9.4,177,22,2,"PAH",31,1,36,0)="    The latest printed label for an IV medication order may not display"
^DIC(9.4,177,22,2,"PAH",31,1,37,0)="    on the BCMA Virtual Due List (VDL) as an ""available bag"" when it "
^DIC(9.4,177,22,2,"PAH",31,1,38,0)="    should."
^DIC(9.4,177,22,2,"PAH",31,1,39,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,40,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",31,1,41,0)="    All printed labels that are valid and should be available for "
^DIC(9.4,177,22,2,"PAH",31,1,42,0)="    administration will appropriately display as ""available"" on the VDL."
^DIC(9.4,177,22,2,"PAH",31,1,43,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,44,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,45,0)="4.  Problem: NOIS NCH-1003-41434"
^DIC(9.4,177,22,2,"PAH",31,1,46,0)="    The BCMA Label Print [PSBO BL] option does not allow the use of a drugs"
^DIC(9.4,177,22,2,"PAH",31,1,47,0)="    internal entry number (IEN) alone to select a ""Drug Name"" for a "
^DIC(9.4,177,22,2,"PAH",31,1,48,0)="    printed label."
^DIC(9.4,177,22,2,"PAH",31,1,49,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,50,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",31,1,51,0)="    The BCMA Label Print [PSBO BL] option will select the appropriate "
^DIC(9.4,177,22,2,"PAH",31,1,52,0)="    drug when the user enters solely the drugs IEN to select a ""Drug "
^DIC(9.4,177,22,2,"PAH",31,1,53,0)="    Name"" for a printed label."
^DIC(9.4,177,22,2,"PAH",31,1,54,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,55,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,56,0)="5.  Problem: NOIS UNY-1003-10407"
^DIC(9.4,177,22,2,"PAH",31,1,57,0)="    Allergy data is being displayed in the report header ""Reactions:"""
^DIC(9.4,177,22,2,"PAH",31,1,58,0)="    field of reports printed via the VDL, such as the Medication Due "
^DIC(9.4,177,22,2,"PAH",31,1,59,0)="    List report."
^DIC(9.4,177,22,2,"PAH",31,1,60,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,61,0)="    Corrective Action:   "
^DIC(9.4,177,22,2,"PAH",31,1,62,0)="    Adverse Drug Reaction information will display in the report "
^DIC(9.4,177,22,2,"PAH",31,1,63,0)="    header, ""Reactions:"" field of reports printed via the VDL."
^DIC(9.4,177,22,2,"PAH",31,1,64,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,65,0)=" "
^DIC(9.4,177,22,2,"PAH",31,1,66,0)="6.  Problem: NOIS ALX-1103-70256"
^DIC(9.4,177,22,2,"PAH",31,1,67,0)="    An error occurs when the user attempts to access a "
^DIC(9.4,177,22,2,"PAH",31,1,68,0)="    patients VDL and that patient has an active medication order "
^DIC(9.4,177,22,2,"PAH",31,1,69,0)="    with an ACTION STATUS field (#.09) of the BCMA MEDICATION LOG "
^DIC(9.4,177,22,2,"PAH",31,1,70,0)="    file (#53.79) equal to null.  The error message encountered is "
^DIC(9.4,177,22,2,"PAH",31,1,71,0)="    ""$ZE=<SUBSCRIPT>EN+75^PSBVDLUD."""
^DIC(9.4,177,22,2,"PAH",31,1,72,0)="    "
^DIC(9.4,177,22,2,"PAH",31,1,73,0)="    Corrective Action:"
^DIC(9.4,177,22,2,"PAH",31,1,74,0)="    A patients VDL will display without error when that patient has "
^DIC(9.4,177,22,2,"PAH",31,1,75,0)="    an active medication order with an ACTION STATUS field (#.09) of the "
^DIC(9.4,177,22,2,"PAH",31,1,76,0)="    BCMA MEDICATION LOG file (#53.79) equal to null."
^DIC(9.4,177,22,2,"PAH",32,0)="23 SEQ #32^3031231^1"
^DIC(9.4,177,22,2,"PAH",32,1,0)="^^62^62^3031231"
^DIC(9.4,177,22,2,"PAH",32,1,1,0)="  ****NOTE**** Patch PSB*2*23 will remove the Ward Name Conversion "
^DIC(9.4,177,22,2,"PAH",32,1,2,0)="  Process [PSB WARD CONVERSION] option from your system. Please complete "
^DIC(9.4,177,22,2,"PAH",32,1,3,0)="  the ward name conversion process before installing patch PSB*2*23, "
^DIC(9.4,177,22,2,"PAH",32,1,4,0)="  using the Ward Name Conversion Process [PSB WARD CONVERSION] option in "
^DIC(9.4,177,22,2,"PAH",32,1,5,0)="  patch PSB*2*14. "
^DIC(9.4,177,22,2,"PAH",32,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,7,0)="  1.  Problem: NOIS ISB-0203-31993"
^DIC(9.4,177,22,2,"PAH",32,1,8,0)="  Pro Ra Nata (PRN)"
^DIC(9.4,177,22,2,"PAH",32,1,9,0)="  The PRN Effectiveness List [PSBO PE] option displays the date and"
^DIC(9.4,177,22,2,"PAH",32,1,10,0)="  time that a patch was ""Removed,"" instead of ""Given,"" under the ""Admin "
^DIC(9.4,177,22,2,"PAH",32,1,11,0)="  Time"" column."
^DIC(9.4,177,22,2,"PAH",32,1,12,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,13,0)="  Corrective Action: The PRN Effectiveness List [PSBO PE] option will "
^DIC(9.4,177,22,2,"PAH",32,1,14,0)="  display the date and time that a patch is ""Given"" under the ""Admin Time"""
^DIC(9.4,177,22,2,"PAH",32,1,15,0)="  column. "
^DIC(9.4,177,22,2,"PAH",32,1,16,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,17,0)="  2. Problem: NOIS ISB-0303-30557"
^DIC(9.4,177,22,2,"PAH",32,1,18,0)="  The PRN Effectiveness List [PSBO PE] option displays a PRN medication"
^DIC(9.4,177,22,2,"PAH",32,1,19,0)="  entry twice on the PRN Effectiveness List Report when the user enters a"
^DIC(9.4,177,22,2,"PAH",32,1,20,0)="  Missing Dose Request and administers the medication at a later time."
^DIC(9.4,177,22,2,"PAH",32,1,21,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,22,0)="  Corrective Action: The PRN Effectiveness List [PSBO PE] option will not "
^DIC(9.4,177,22,2,"PAH",32,1,23,0)="  display a PRN medication entry twice on the PRN Effectiveness List"
^DIC(9.4,177,22,2,"PAH",32,1,24,0)="  Report when the user enters a Missing Dose Request and administers the"
^DIC(9.4,177,22,2,"PAH",32,1,25,0)="  medication at a later time."
^DIC(9.4,177,22,2,"PAH",32,1,26,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,27,0)="  3. Problem: NOIS ISB-0903-31938 "
^DIC(9.4,177,22,2,"PAH",32,1,28,0)="  The Missing Dose Report [PSBO MD] option will display the header ""Dosage"
^DIC(9.4,177,22,2,"PAH",32,1,29,0)="  Schedule"" on the Bar Code Medication Administration (BCMA) Character"
^DIC(9.4,177,22,2,"PAH",32,1,30,0)="  User Interface (CHUI) Missing Dose Report.  This header is not"
^DIC(9.4,177,22,2,"PAH",32,1,31,0)="  consistent with the naming scheme that describes the medication order"
^DIC(9.4,177,22,2,"PAH",32,1,32,0)="  schedule information sent to the Pharmacy via the e-mail notification"
^DIC(9.4,177,22,2,"PAH",32,1,33,0)="  message."
^DIC(9.4,177,22,2,"PAH",32,1,34,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,35,0)="  Corrective Action: The Missing Dose Request [PSBO MD] option displays"
^DIC(9.4,177,22,2,"PAH",32,1,36,0)="  the header ""Schedule"" on the BCMA CHUI Missing Dose Report. This"
^DIC(9.4,177,22,2,"PAH",32,1,37,0)="  information coincides with the BCMA naming scheme that describes the"
^DIC(9.4,177,22,2,"PAH",32,1,38,0)="  medication order schedule information sent to the Pharmacy via the"
^DIC(9.4,177,22,2,"PAH",32,1,39,0)="  e-mail notification message."
^DIC(9.4,177,22,2,"PAH",32,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,41,0)="  4. Problem: NOIS ISB-0703-30029"
^DIC(9.4,177,22,2,"PAH",32,1,42,0)="  The Missing Dose Request [PSB MISSING DOSE REQUEST] option creates a"
^DIC(9.4,177,22,2,"PAH",32,1,43,0)="  variance entry in the BCMA MEDICATION VARIANCE LOG File (#53.78) when"
^DIC(9.4,177,22,2,"PAH",32,1,44,0)="  the user enters a Missing Dose Request outside the timeframe specified"
^DIC(9.4,177,22,2,"PAH",32,1,45,0)="  for the ""Allowable Time Limits"" parameter within the Parameters Tab of"
^DIC(9.4,177,22,2,"PAH",32,1,46,0)="  the GUI BCMA Site Parameters application."
^DIC(9.4,177,22,2,"PAH",32,1,47,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,48,0)="  Corrective Action: The Missing Dose Request [PSB MISSING DOSE REQUEST]"
^DIC(9.4,177,22,2,"PAH",32,1,49,0)="  option will not create a variance entry in the BCMA MEDICATION VARIANCE"
^DIC(9.4,177,22,2,"PAH",32,1,50,0)="  LOG File (#53.78) when the user enters a Missing Dose Request outside"
^DIC(9.4,177,22,2,"PAH",32,1,51,0)="  the timeframe specified for the ""Allowable Time Limits"" parameter within"
^DIC(9.4,177,22,2,"PAH",32,1,52,0)="  the Parameters Tab of the GUI BCMA Site Parameters application."
^DIC(9.4,177,22,2,"PAH",32,1,53,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,54,0)="  5. Enhancement: E3R #13009 "
^DIC(9.4,177,22,2,"PAH",32,1,55,0)="  The Missing Dose Request [PSB MISSING DOSE REQUEST] option will display "
^DIC(9.4,177,22,2,"PAH",32,1,56,0)="  the medication order schedule information in the e-mail notification "
^DIC(9.4,177,22,2,"PAH",32,1,57,0)="  message sent from BCMA to the Pharmacy for a Missing Dose Request.  "
^DIC(9.4,177,22,2,"PAH",32,1,58,0)=" "
^DIC(9.4,177,22,2,"PAH",32,1,59,0)="  6. Enhancement: E3R #17312 "
^DIC(9.4,177,22,2,"PAH",32,1,60,0)="  The Missing Dose Request [PSB MISSING DOSE REQUEST] option displays the "
^DIC(9.4,177,22,2,"PAH",32,1,61,0)="  medication order schedule information on the Missing Dose Report sent "
^DIC(9.4,177,22,2,"PAH",32,1,62,0)="  from BCMA to the Pharmacy-selected printing device."
^DIC(9.4,177,22,2,"PAH",33,0)="36 SEQ #33^3040131^1"
^DIC(9.4,177,22,2,"PAH",33,1,0)="^^57^57^3040131"
^DIC(9.4,177,22,2,"PAH",33,1,1,0)="*** ATTENTION: This patch includes a new Graphical User Interface (GUI)"
^DIC(9.4,177,22,2,"PAH",33,1,2,0)="    executable file. Installation of this new GUI is REQUIRED in order "
^DIC(9.4,177,22,2,"PAH",33,1,3,0)="    for the patch to function.  The new GUI MUST be installed IMMEDIATELY "
^DIC(9.4,177,22,2,"PAH",33,1,4,0)="    after the KIDS install in order for the software to function. ***"
^DIC(9.4,177,22,2,"PAH",33,1,5,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,6,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,7,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,8,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,9,0)="For retrieval and installation instructions, please see the Client"
^DIC(9.4,177,22,2,"PAH",33,1,10,0)="Installation Instructions section."
^DIC(9.4,177,22,2,"PAH",33,1,11,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,12,0)="1. When administering a Pro Re Nata (PRN) medication or documenting a PRN "
^DIC(9.4,177,22,2,"PAH",33,1,13,0)="   Effectiveness and the PRN Reason is one set via the Bar Code Medication"
^DIC(9.4,177,22,2,"PAH",33,1,14,0)="   Administration (BCMA) Site Parameters settings to initiate a pain score"
^DIC(9.4,177,22,2,"PAH",33,1,15,0)="   reading, BCMA will automatically initiate a pain score reading to be "
^DIC(9.4,177,22,2,"PAH",33,1,16,0)="   filed with other Vital Measurement information."
^DIC(9.4,177,22,2,"PAH",33,1,17,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,18,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,19,0)="2. Problem: NOIS DUB-0803-31307"
^DIC(9.4,177,22,2,"PAH",33,1,20,0)="   When all of a patient's active medication orders of an order type have no"
^DIC(9.4,177,22,2,"PAH",33,1,21,0)="   scheduled administrations within the date range of the BCMA Virtual Due"
^DIC(9.4,177,22,2,"PAH",33,1,22,0)="   List (VDL), the message ""No Active Orders at this Time"" displays.  "
^DIC(9.4,177,22,2,"PAH",33,1,23,0)="   This message is not accurate."
^DIC(9.4,177,22,2,"PAH",33,1,24,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,25,0)="   Corrective Action:"
^DIC(9.4,177,22,2,"PAH",33,1,26,0)="   When all a patient's active medication orders of an order type have no"
^DIC(9.4,177,22,2,"PAH",33,1,27,0)="   scheduled administrations within the date range of the BCMA Virtual Due"
^DIC(9.4,177,22,2,"PAH",33,1,28,0)="   List (VDL), the message ""No Administration(s) due at this time"" will"
^DIC(9.4,177,22,2,"PAH",33,1,29,0)="   display."
^DIC(9.4,177,22,2,"PAH",33,1,30,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,31,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,32,0)="3. Problem: NOIS NYH-0903-10598"
^DIC(9.4,177,22,2,"PAH",33,1,33,0)="   BCMA is not showing the correct number of PRN Reminders for patients. "
^DIC(9.4,177,22,2,"PAH",33,1,34,0)="   BCMA calculates the number of PRN Reminders based on the date/time of "
^DIC(9.4,177,22,2,"PAH",33,1,35,0)="   patient's transfer and not the date/time of the patient's admission."
^DIC(9.4,177,22,2,"PAH",33,1,36,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,37,0)="   Corrective Action:"
^DIC(9.4,177,22,2,"PAH",33,1,38,0)="   BCMA will identify and display PRN Reminders based on the date/time of "
^DIC(9.4,177,22,2,"PAH",33,1,39,0)="   the patient's admission."
^DIC(9.4,177,22,2,"PAH",33,1,40,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,41,0)="4. Problem: NOIS ISB-1103-31688"
^DIC(9.4,177,22,2,"PAH",33,1,42,0)="   The error ""$ZE= NTE+16^PSBSVHL7:1, %DSM-E-UNDEF, undefined variable "" "
^DIC(9.4,177,22,2,"PAH",33,1,43,0)="   may occur when comment internal entity numbers (IEN), of the BCMA Medication "
^DIC(9.4,177,22,2,"PAH",33,1,44,0)="   Log are not in sync with the BCMA Medication Log comment sub-file index.  BCM"
^DIC(9.4,177,22,2,"PAH",33,1,45,0)="   Health Level 7 (HL7) messaging may attempt to transmit a comment which"
^DIC(9.4,177,22,2,"PAH",33,1,46,0)="   does not exist, causing the error."
^DIC(9.4,177,22,2,"PAH",33,1,47,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,48,0)="   Corrective Action:"
^DIC(9.4,177,22,2,"PAH",33,1,49,0)="   BCMA HL7 messaging will transmit the appropriate comment independent "
^DIC(9.4,177,22,2,"PAH",33,1,50,0)="   of the BCMA Medication Log comment sub-file index."
^DIC(9.4,177,22,2,"PAH",33,1,51,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,52,0)="5. Problem: NOIS ISB-1103-31567 "
^DIC(9.4,177,22,2,"PAH",33,1,53,0)="   The BCMA Cumulative Vitals report does not display the vital changes if "
^DIC(9.4,177,22,2,"PAH",33,1,54,0)="   only one measurement was changed for the designated date range."
^DIC(9.4,177,22,2,"PAH",33,1,55,0)=" "
^DIC(9.4,177,22,2,"PAH",33,1,56,0)="   Corrective Action: The Cumulative Vitals report will show all changes "
^DIC(9.4,177,22,2,"PAH",33,1,57,0)="   that occur within the designated date range."
