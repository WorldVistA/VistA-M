^DIC(9.4,47,22,5.9,"PAH",564,1,0)="^^4^4^3070627"
^DIC(9.4,47,22,5.9,"PAH",564,1,1,0)="This patch corrects a system error when adding rated disabilities,"
^DIC(9.4,47,22,5.9,"PAH",564,1,2,0)="data exceptions in the MPI for the ""date last treated"", printing of "
^DIC(9.4,47,22,5.9,"PAH",564,1,3,0)="the full SSN on the G&L report, and not generating UR admission "
