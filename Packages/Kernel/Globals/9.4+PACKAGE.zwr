^DIC(9.4,48,22,5.28,"PAH",34,1,0)="^^3^3^2970122"
^DIC(9.4,48,22,5.28,"PAH",34,1,1,0)="Encounters need CPT codes and a Primary DX before being 'Checked Out'."
