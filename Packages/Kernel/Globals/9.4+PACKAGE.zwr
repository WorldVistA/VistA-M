^DIC(9.4,14,22,5.9,"PAH",182,1,209,0)=""
^DIC(9.4,14,22,5.9,"PAH",183,0)="337 SEQ #281^3070629.192327^1"
^DIC(9.4,14,22,5.9,"PAH",183,1,0)="^^3^3^3070629"
^DIC(9.4,14,22,5.9,"PAH",183,1,1,0)="This patch corrects 2 problems with ""DELETE TEST"" and a problem"
^DIC(9.4,14,22,5.9,"PAH",183,1,2,0)="with exiting the ""INTERIM REPORT"".  An issue is also addressed with"
^DIC(9.4,14,22,5.9,"PAH",183,1,3,0)="""ELECTRONIC CATALOG""."
^DIC(9.4,14,22,5.9,"PAH",184,0)="356 SEQ #282^3070904.223528^1"
^DIC(9.4,14,22,5.9,"PAH",184,1,0)="^^11^11^3070904"
^DIC(9.4,14,22,5.9,"PAH",184,1,1,0)="This patch will correct a problem with the display of Reference, Critical"
^DIC(9.4,14,22,5.9,"PAH",184,1,2,0)="& Therapeutic ranges in the Laboratory Test Description in the Lab Test "
^DIC(9.4,14,22,5.9,"PAH",184,1,3,0)="Information option of the Tools menu in CPRS GUI by routine LR7OR4. It "
^DIC(9.4,14,22,5.9,"PAH",184,1,4,0)="will correct a problem with the display of reference ranges with a "
^DIC(9.4,14,22,5.9,"PAH",184,1,5,0)="patient's laboratory test data in both CPRS GUI and the Laboratory "
^DIC(9.4,14,22,5.9,"PAH",184,1,6,0)="Package by routines LR7OGMC, LR7OGU, and LRRP1."
^DIC(9.4,14,22,5.9,"PAH",184,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",184,1,8,0)="In the SITE/SPECIMEN SUB-FILE (60.01) the description for fields REFERENCE"
^DIC(9.4,14,22,5.9,"PAH",184,1,9,0)=" LOW (60.01,1), REFERENCE HIGH (60.01,2), CRITICAL LOW (60.01,3), CRITICAL"
^DIC(9.4,14,22,5.9,"PAH",184,1,10,0)="HIGH (60.01), THERAPEUTIC LOW (60.01,9.2), and THERAPEUTIC HIGH (60.01, "
^DIC(9.4,14,22,5.9,"PAH",184,1,11,0)="9.3) has been changed."
^DIC(9.4,14,22,5.9,"PAH",185,0)="308 SEQ #283^3070904.234933^1"
^DIC(9.4,14,22,5.9,"PAH",185,1,0)="^^262^262^3070904"
^DIC(9.4,14,22,5.9,"PAH",185,1,1,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",185,1,2,0)="Patch Description"
^DIC(9.4,14,22,5.9,"PAH",185,1,3,0)="================= "
^DIC(9.4,14,22,5.9,"PAH",185,1,4,0)="Several updates and enhancements have been identified as requiring "
^DIC(9.4,14,22,5.9,"PAH",185,1,5,0)="immediate action after the installation of patch LR*5.2*274, AP CPT "
^DIC(9.4,14,22,5.9,"PAH",185,1,6,0)="Coding & NLT Code Update.  This patch LR*5.2*308 includes updates"
^DIC(9.4,14,22,5.9,"PAH",185,1,7,0)="that have been identified in the NOIS's listed below.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,8,0)="The following updates are included.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,10,0)="1.  Currently:  If a Current Procedural Terminolgy (CPT) code is not"
^DIC(9.4,14,22,5.9,"PAH",185,1,11,0)="found or is marked inactive in the CPT file (#81), a general message,"
^DIC(9.4,14,22,5.9,"PAH",185,1,12,0)="""Nothing Selected"" displays, or no message at all displays.  The CPT "
^DIC(9.4,14,22,5.9,"PAH",185,1,13,0)="code is not selected and passed to PATIENT CARE ENCOUNTER (PCE)."
^DIC(9.4,14,22,5.9,"PAH",185,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,15,0)="Update:  If one or more CPT's are not found in the CPT file (#81), "
^DIC(9.4,14,22,5.9,"PAH",185,1,16,0)="the following message displays and lists the CPT codes:"
^DIC(9.4,14,22,5.9,"PAH",185,1,17,0)="          ""The following CPT Code(s) are not selected:"
^DIC(9.4,14,22,5.9,"PAH",185,1,18,0)="            Not found in #81: #####,#####,""."
^DIC(9.4,14,22,5.9,"PAH",185,1,19,0)="For one or more CPTs that are marked inactive in the CPT "
^DIC(9.4,14,22,5.9,"PAH",185,1,20,0)="file (#81), the following message displays and lists the CPT codes:"
^DIC(9.4,14,22,5.9,"PAH",185,1,21,0)="          ""The following CPT Code(s) are not selected: "
^DIC(9.4,14,22,5.9,"PAH",185,1,22,0)="            CPT(s) inactive in #81: #####,#####""."
^DIC(9.4,14,22,5.9,"PAH",185,1,23,0)="All CPTs that are inactive or not found in file #81 will not be "
^DIC(9.4,14,22,5.9,"PAH",185,1,24,0)="passed to PCE."
^DIC(9.4,14,22,5.9,"PAH",185,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,26,0)="2.  Currently:  CPTs marked inactive in the WKLD CODE file (#64) "
^DIC(9.4,14,22,5.9,"PAH",185,1,27,0)="can be selected and are passed to PCE."
^DIC(9.4,14,22,5.9,"PAH",185,1,28,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,29,0)="Update:  If a selected CPT is marked inactive in file (#64), a "
^DIC(9.4,14,22,5.9,"PAH",185,1,30,0)="search is made for another active CPT linked to the same workload code.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,31,0)="If another active CPT is found, the active CPT replaces the inactive CPT"
^DIC(9.4,14,22,5.9,"PAH",185,1,32,0)="and is passed to PCE.  The following message will display if an active"
^DIC(9.4,14,22,5.9,"PAH",185,1,33,0)="replacement is found:"
^DIC(9.4,14,22,5.9,"PAH",185,1,34,0)="  ""The following CPT Code(s) are not selected: "
^DIC(9.4,14,22,5.9,"PAH",185,1,35,0)="    Inactive in #64\Active Replacement Found: ##### \ #####; ##### \"
^DIC(9.4,14,22,5.9,"PAH",185,1,36,0)="#####""."
^DIC(9.4,14,22,5.9,"PAH",185,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,38,0)="If no active replacement found, the selected CPT is not passed to "
^DIC(9.4,14,22,5.9,"PAH",185,1,39,0)="PCE and is displayed in the following message:"
^DIC(9.4,14,22,5.9,"PAH",185,1,40,0)="          ""The following CPT Code(s) are not selected: "
^DIC(9.4,14,22,5.9,"PAH",185,1,41,0)="            CPT(s) inactive in #64: #####,#####"".  "
^DIC(9.4,14,22,5.9,"PAH",185,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,43,0)="3.  Currently:  Inactive CPTs found in the WKLD CODE file (#64) "
^DIC(9.4,14,22,5.9,"PAH",185,1,44,0)="can be entered and passed to PCE for non-AP accessions.  When an inactive"
^DIC(9.4,14,22,5.9,"PAH",185,1,45,0)="CPT is selected and passed to PCE, the entire order is marked invalid for"
^DIC(9.4,14,22,5.9,"PAH",185,1,46,0)="workload and no workload is passed, and a mail message is generated at the"
^DIC(9.4,14,22,5.9,"PAH",185,1,47,0)="site which states ""No lab OOS location defined""."
^DIC(9.4,14,22,5.9,"PAH",185,1,48,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,49,0)="Update:  If a CPT is found inactive in file #64, a search will be "
^DIC(9.4,14,22,5.9,"PAH",185,1,50,0)="made for another active replacement CPT linked to the same workload code."
^DIC(9.4,14,22,5.9,"PAH",185,1,51,0)="If another active CPT is found, the active CPT replaces the inactive"
^DIC(9.4,14,22,5.9,"PAH",185,1,52,0)="CPT.  If no active replacement CPT is found, the original CPT is not"
^DIC(9.4,14,22,5.9,"PAH",185,1,53,0)="passed to PCE, and thus no misleading mail message is generated."
^DIC(9.4,14,22,5.9,"PAH",185,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,55,0)="4. Currently:  Any subsequent CPT codes entered on an accession "
^DIC(9.4,14,22,5.9,"PAH",185,1,56,0)="will replace or overlay the quantity previously passed to PCE."
^DIC(9.4,14,22,5.9,"PAH",185,1,57,0)="Example:  CPT 88302 with quantity of 2 entered on day 1; PCE shows"
^DIC(9.4,14,22,5.9,"PAH",185,1,58,0)="quantity of 2.  On day 2, CPT 88302 with quantity of 1 entered; PCE shows"
^DIC(9.4,14,22,5.9,"PAH",185,1,59,0)="updated quantity of 1.  It should show 3."
^DIC(9.4,14,22,5.9,"PAH",185,1,60,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,61,0)="Update:  All subsequent CPT code quantities entered for an "
^DIC(9.4,14,22,5.9,"PAH",185,1,62,0)="accession will be added to existing quantities stored in PCE."
^DIC(9.4,14,22,5.9,"PAH",185,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,64,0)="5. Currently:  If a selected CPT is not linked to a workload code "
^DIC(9.4,14,22,5.9,"PAH",185,1,65,0)="in the WKLD CODE file (#64), the CPT is passed to PCE, and the message"
^DIC(9.4,14,22,5.9,"PAH",185,1,66,0)="""Storing in LMIP"".  This message incorrectly identifies the CPT as "
^DIC(9.4,14,22,5.9,"PAH",185,1,67,0)="having been stored in the WKLD CODE file (#64)."
^DIC(9.4,14,22,5.9,"PAH",185,1,68,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,69,0)="Update:  Selected CPT codes that are not linked to a workload code "
^DIC(9.4,14,22,5.9,"PAH",185,1,70,0)="in the WKLD CODE file (#64) will not be passed to PCE, and the following"
^DIC(9.4,14,22,5.9,"PAH",185,1,71,0)="message will display:"
^DIC(9.4,14,22,5.9,"PAH",185,1,72,0)="          ""The following CPT Code(s) are not selected: "
^DIC(9.4,14,22,5.9,"PAH",185,1,73,0)="            Not linked to workload in #64: #####, #####""."
^DIC(9.4,14,22,5.9,"PAH",185,1,74,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,75,0)="6.  Currently:  If a selected CPT code is linked to multiple workload "
^DIC(9.4,14,22,5.9,"PAH",185,1,76,0)="codes, the workload code with the lowest IEN is selected.  This cannot be "
^DIC(9.4,14,22,5.9,"PAH",185,1,77,0)="changed; however, the problem has been reduced by increasing the number of "
^DIC(9.4,14,22,5.9,"PAH",185,1,78,0)="allowed ES Display Order numbers that can be assigned to a specific "
^DIC(9.4,14,22,5.9,"PAH",185,1,79,0)="CPT-workload code combination.  The limit has been increased from 100 to "
^DIC(9.4,14,22,5.9,"PAH",185,1,80,0)="1000.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,82,0)="7.  Currently:  When more than one accession is entered for a patient on "
^DIC(9.4,14,22,5.9,"PAH",185,1,83,0)="the same date, at the same location, and the specimen collection date/time "
^DIC(9.4,14,22,5.9,"PAH",185,1,84,0)="does not contain a unique time, then each accession for this patient will "
^DIC(9.4,14,22,5.9,"PAH",185,1,85,0)="have the same encounter/visit number assigned when CPT codes are entered "
^DIC(9.4,14,22,5.9,"PAH",185,1,86,0)="and passed to PCE.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,87,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,88,0)="Update:  Within Anatomic Pathology (AP) Login, the ""Date/time Specimen"
^DIC(9.4,14,22,5.9,"PAH",185,1,89,0)="taken:"" prompt default has been changed from TODAY (date only) to NOW"
^DIC(9.4,14,22,5.9,"PAH",185,1,90,0)="(date and time).  This helps decrease the chance of having the same"
^DIC(9.4,14,22,5.9,"PAH",185,1,91,0)="encounter number assigned to more than one accession entered on the same"
^DIC(9.4,14,22,5.9,"PAH",185,1,92,0)="patient on the same date, at the same location."
^DIC(9.4,14,22,5.9,"PAH",185,1,93,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,94,0)="8. A couple of minor cosmetic updates are included in this patch:"
^DIC(9.4,14,22,5.9,"PAH",185,1,95,0)="a.  The prompt ""Releasing Pathologist:"" has been changed to ""Provider:"" "
^DIC(9.4,14,22,5.9,"PAH",185,1,96,0)="since the name entered at this prompt must be an active provider.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,97,0)="b.  The pathologist or cytotechnologist name, if entered on the accession,"
^DIC(9.4,14,22,5.9,"PAH",185,1,98,0)="is included in the header information that displays at the time CPT coding "
^DIC(9.4,14,22,5.9,"PAH",185,1,99,0)="is entered."
^DIC(9.4,14,22,5.9,"PAH",185,1,100,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,101,0)="The updates described above are displayed in the following screen format.  "
^DIC(9.4,14,22,5.9,"PAH",185,1,102,0)="This screen format is used in the menu options listed below it:"
^DIC(9.4,14,22,5.9,"PAH",185,1,103,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,104,0)="Provider: PROVIDER, ONE//        PRO          PHYSICIAN"
^DIC(9.4,14,22,5.9,"PAH",185,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,106,0)="Select CPT codes:  88302"
^DIC(9.4,14,22,5.9,"PAH",185,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,108,0)="TEST, PATIENT1                        000-99-1234         DOB: Mar 05, 1955"
^DIC(9.4,14,22,5.9,"PAH",185,1,109,0)="     Collection Date: Jan 06, 2005@11:52"
^DIC(9.4,14,22,5.9,"PAH",185,1,110,0)="          Acc #: NSP 05 1                                   Loc: 5N"
^DIC(9.4,14,22,5.9,"PAH",185,1,111,0)="               Specimen: "
^DIC(9.4,14,22,5.9,"PAH",185,1,112,0)="     Tissue Specimens: "
^DIC(9.4,14,22,5.9,"PAH",185,1,113,0)="               TAIL"
^DIC(9.4,14,22,5.9,"PAH",185,1,114,0)="     Test(s);  SURGICAL PATH REPORTING/ SURGICAL PATHOLOGY LOG-IN/ "
^DIC(9.4,14,22,5.9,"PAH",185,1,115,0)="     Pathologist: PHYSICIAN, ONE"
^DIC(9.4,14,22,5.9,"PAH",185,1,116,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,117,0)="                               Selected CPT Codes                           "
^DIC(9.4,14,22,5.9,"PAH",185,1,118,0)="    "
^DIC(9.4,14,22,5.9,"PAH",185,1,119,0)="     (1)  88302 LEVEL II - SURGICAL PATHOLOGY, GROSS AND MICROSCOP"
^DIC(9.4,14,22,5.9,"PAH",185,1,120,0)="          Surgical Pathology Level II  {88518.0000}"
^DIC(9.4,14,22,5.9,"PAH",185,1,121,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,122,0)="Menu Options:"
^DIC(9.4,14,22,5.9,"PAH",185,1,123,0)="       Lab CPT Billing [LRCAPES]"
^DIC(9.4,14,22,5.9,"PAH",185,1,124,0)="       Verify/release reports, anat path [LRAPR], "
^DIC(9.4,14,22,5.9,"PAH",185,1,125,0)="               CPT Coding selection"
^DIC(9.4,14,22,5.9,"PAH",185,1,126,0)="       Provisional anatomic diagnoses [LRAPAUPAD]"
^DIC(9.4,14,22,5.9,"PAH",185,1,127,0)="       Autopsy protocol [LRAPAUDAP]"
^DIC(9.4,14,22,5.9,"PAH",185,1,128,0)="       Autopsy protocol & SNOMED coding [LRAPAUDAB]"
^DIC(9.4,14,22,5.9,"PAH",185,1,129,0)="       Autopsy protocol & ICD9CM coding [LRAPAUDAA]"
^DIC(9.4,14,22,5.9,"PAH",185,1,130,0)="       FS/Gross/Micro/Dx [LRAPDGM]"
^DIC(9.4,14,22,5.9,"PAH",185,1,131,0)="       FS/Gross/Micro/Dx/SNOMED Coding [LRAPDGS]"
^DIC(9.4,14,22,5.9,"PAH",185,1,132,0)="       FS/Gross/Micro/Dx/ICD9CM Coding [LRAPDGI]"
^DIC(9.4,14,22,5.9,"PAH",185,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,134,0)="9. A couple of general corrections are included in this patch.  For"
^DIC(9.4,14,22,5.9,"PAH",185,1,135,0)="certain $D statements which read, ""'$DATA()#2"", the modulo is incorrectly "
^DIC(9.4,14,22,5.9,"PAH",185,1,136,0)="applied to the result of the ""'$DATA()"".  Instead, the NOT operator ""'"" "
^DIC(9.4,14,22,5.9,"PAH",185,1,137,0)="should be applied to the evaluation of ""$DATA()#2"" to correctly read,"
^DIC(9.4,14,22,5.9,"PAH",185,1,138,0)="""'($DATA()#2)"".  The following statements have been corrected:"
^DIC(9.4,14,22,5.9,"PAH",185,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,140,0)="a. In SETWKL+13^LRCAPES1, Q:'$D(^LAM(LRP,0))#2, has been changed to"
^DIC(9.4,14,22,5.9,"PAH",185,1,141,0)="   Q:'($D(^LAM(LRP,0))#2)."
^DIC(9.4,14,22,5.9,"PAH",185,1,142,0)="b. In EN5+4^LRCAPPH1, Q:'$D(^LRO(69,LRCDT,1,LRSN,2,LRTST,0))#2, has been"
^DIC(9.4,14,22,5.9,"PAH",185,1,143,0)="   changed to Q:'($D(^LRO(69,LRCDT,1,LRSN,2,LRTST,0))#2)."
^DIC(9.4,14,22,5.9,"PAH",185,1,144,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,145,0)="Data Dictionary Changes"
^DIC(9.4,14,22,5.9,"PAH",185,1,146,0)="======================="
^DIC(9.4,14,22,5.9,"PAH",185,1,147,0)="VistA Laboratory AP CPT Code Corrections Patch LR*5.2*308 software release"
^DIC(9.4,14,22,5.9,"PAH",185,1,148,0)="contains the following data dictionary changes:"
^DIC(9.4,14,22,5.9,"PAH",185,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,150,0)="WKLD CODE file (#64)"
^DIC(9.4,14,22,5.9,"PAH",185,1,151,0)="------------------------"
^DIC(9.4,14,22,5.9,"PAH",185,1,152,0)="WKLD CODE file (#64), ES DISPLAY ORDER field (#26) has been modified "
^DIC(9.4,14,22,5.9,"PAH",185,1,153,0)="to increase the quantity allowed from 100 to 1000."
^DIC(9.4,14,22,5.9,"PAH",185,1,154,0)=" "
^DIC(9.4,14,22,5.9,"PAH",185,1,155,0)="======================"
