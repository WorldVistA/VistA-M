^DIC(9.4,226,0)="MOBILE SCHEDULING APPLICATIONS^MBAA^Mobile Application for Scheduling Calendar View"
^DIC(9.4,226,20,0)="^9.402P^^"
^DIC(9.4,226,22,0)="^9.49I^1^1"
^DIC(9.4,226,22,1,0)="1.0^3160601^3160601^520736418"
^DIC(9.4,226,22,1,"PAH",0)="^9.4901^7^7"
^DIC(9.4,226,22,1,"PAH",1,0)="1^3160825^520736418"
^DIC(9.4,226,22,1,"PAH",1,1,0)="^^1^1^3160825"
^DIC(9.4,226,22,1,"PAH",1,1,1,0)="Scheduling Calendar View initial build."
^DIC(9.4,226,22,1,"PAH",2,0)="1 SEQ #1^3161006.123642^54"
^DIC(9.4,226,22,1,"PAH",2,1,0)="^^1^1^3161006"
^DIC(9.4,226,22,1,"PAH",2,1,1,0)="Scheduling Calendar View initial build."
^DIC(9.4,226,22,1,"PAH",3,0)="4 SEQ #3^3170427.171853^54"
^DIC(9.4,226,22,1,"PAH",4,0)="5 SEQ #4^3180501.145218^54"
^DIC(9.4,226,22,1,"PAH",5,0)="7 SEQ #5^3190301.155404^54"
^DIC(9.4,226,22,1,"PAH",6,0)="11 SEQ #6^3220209.143241^17"
^DIC(9.4,226,22,1,"PAH",7,0)="12 SEQ #7^3220802.162109^86"
^DIC(9.4,226,22,1,"PAH",7,1,0)="^^10^10^3220802"
^DIC(9.4,226,22,1,"PAH",7,1,1,0)="VSE-3285 - VistA: Correct <COMMAND> error in MBAARPC2"
^DIC(9.4,226,22,1,"PAH",7,1,2,0)="Problem: "
^DIC(9.4,226,22,1,"PAH",7,1,3,0)="A <COMMAND> error is being encountered when the CPRS STATUS of "
^DIC(9.4,226,22,1,"PAH",7,1,4,0)="the appointment being cancelled is not equal to SCHEDULED.  The current "
^DIC(9.4,226,22,1,"PAH",7,1,5,0)="code quits without returning back a required value."
^DIC(9.4,226,22,1,"PAH",7,1,6,0)="Resolution: "
^DIC(9.4,226,22,1,"PAH",7,1,7,0)="Modified the code to return back 0 (variable RETURN) when returning "
^DIC(9.4,226,22,1,"PAH",7,1,8,0)="back.  This will prevent the <COMMAND> error."
^DIC(9.4,226,22,1,"PAH",7,1,9,0)=" "
^DIC(9.4,226,22,1,"PAH",7,1,10,0)="ROUTINE: MBAAAPI1"
^DIC(9.4,226,22,1,"PAH","B",1,1)=""
^DIC(9.4,226,22,1,"PAH","B","1 SEQ #1",2)=""
^DIC(9.4,226,22,1,"PAH","B","11 SEQ #6",6)=""
