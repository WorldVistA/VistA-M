^DIC(9.4,73,22,9,"PAH",15,1,72,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,73,0)="           Want KIDS to INHIBIT LOGONs during the install?  YES// NO"
^DIC(9.4,73,22,9,"PAH",15,1,74,0)="                                                                 ==== "
^DIC(9.4,73,22,9,"PAH",15,1,75,0)="           Want to DISABLE Scheduled Options,  Menu Options, and"
