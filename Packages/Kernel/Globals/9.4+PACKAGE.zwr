^DIC(9.4,42,"DIPT",6,0)="GMTS TYPE INQ FOOTER^142"
^DIC(9.4,42,"DIPT",7,0)="GMTS COMP DESC LIST^142.1"
^DIC(9.4,42,"DIPT",8,0)="GMTS COMP INQ^142.1"
^DIC(9.4,42,"DIPT",9,0)="GMTS COMP INQ HEADER^142.1"
^DIC(9.4,42,"INI")="GMTSPREI^2960613.134235"
