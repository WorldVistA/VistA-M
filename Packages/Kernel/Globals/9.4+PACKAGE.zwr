^DIC(9.4,14,22,5.9,"PAH",232,0)="412^3120924.152557^17"
^DIC(9.4,14,22,5.9,"PAH",232,1,0)="^^2^2^3120924"
^DIC(9.4,14,22,5.9,"PAH",232,1,1,0)="This patch is being released in conjunction with VBEC*1*27. Install patch "
^DIC(9.4,14,22,5.9,"PAH",232,1,2,0)="VBEC*1*27 to install the routines associated with this patch."
^DIC(9.4,14,22,5.9,"PAH",233,0)="334^3120924.154253^17"
^DIC(9.4,14,22,5.9,"PAH",233,1,0)="^^431^431^3120924"
^DIC(9.4,14,22,5.9,"PAH",233,1,1,0)="BLOOD BANK CLEARANCE"
^DIC(9.4,14,22,5.9,"PAH",233,1,2,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",233,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,4,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*334 does not "
^DIC(9.4,14,22,5.9,"PAH",233,1,5,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",233,1,6,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",233,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,8,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*334 does not "
^DIC(9.4,14,22,5.9,"PAH",233,1,9,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",233,1,10,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",233,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,12,0)="RISK ANALYSIS: Changes made by patch LR*5.2*334 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",233,1,13,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",233,1,14,0)="VALIDATION REQUIREMENT BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",233,1,15,0)="made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",233,1,16,0)="installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",233,1,17,0)="====================== "
^DIC(9.4,14,22,5.9,"PAH",233,1,18,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,19,0)="ENHANCEMENTS:"
^DIC(9.4,14,22,5.9,"PAH",233,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,21,0)="Map Lab Tests to LOINC Codes [LR LOINC MAP]"
^DIC(9.4,14,22,5.9,"PAH",233,1,22,0)="This option has been modified to permit the use of suffixed WKLD CODE "
^DIC(9.4,14,22,5.9,"PAH",233,1,23,0)="in the NATIONAL VA LAB CODE (#64) field, of the LABORATORY TEST (#60) "
^DIC(9.4,14,22,5.9,"PAH",233,1,24,0)="file. This modified option is located on the LOINC Main Menu [LRLOINC] "
^DIC(9.4,14,22,5.9,"PAH",233,1,25,0)="menu"
^DIC(9.4,14,22,5.9,"PAH",233,1,26,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,27,0)="Print LOINC Code Status [LR LOINC STATUS PRINT]"
^DIC(9.4,14,22,5.9,"PAH",233,1,28,0)="This patch will provide an option to list LOINC deprecated terms. The "
^DIC(9.4,14,22,5.9,"PAH",233,1,29,0)="option will also provide a list of currently mapped/linked laboratory "
^DIC(9.4,14,22,5.9,"PAH",233,1,30,0)="tests that are linked to LOINC deprecated terms. This new option is "
^DIC(9.4,14,22,5.9,"PAH",233,1,31,0)="located on the LOINC Mapping Utility Menu [LR LOINC UTILITY] menu. "
^DIC(9.4,14,22,5.9,"PAH",233,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,34,0)="This patch will support ""Veterans Health Administration Unique "
^DIC(9.4,14,22,5.9,"PAH",233,1,35,0)="Identifiers (VUID) standard. This patch will provide the necessary LAB "
^DIC(9.4,14,22,5.9,"PAH",233,1,36,0)="LOINC (#95.3) file data dictionary modifications in support of Data "
^DIC(9.4,14,22,5.9,"PAH",233,1,37,0)="Standardization (DS) and the maintenance of those standards by Enterprise "
^DIC(9.4,14,22,5.9,"PAH",233,1,38,0)="Reference Terminology (ERT)."
^DIC(9.4,14,22,5.9,"PAH",233,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,40,0)="LAB LOINC (#95.3) file protection has been significantly enhanced to "
^DIC(9.4,14,22,5.9,"PAH",233,1,41,0)="prevent field editing of the file. All fields will be populated by the DS "
^DIC(9.4,14,22,5.9,"PAH",233,1,42,0)="authority, there are no fields in this file that are site editable."
^DIC(9.4,14,22,5.9,"PAH",233,1,43,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,44,0)="LAB LOINC (#95.3) file contents will be updated to the Regenstrief issued "
^DIC(9.4,14,22,5.9,"PAH",233,1,45,0)="LOINC version 2.14."
^DIC(9.4,14,22,5.9,"PAH",233,1,46,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,47,0)="This patch will update the WKLD CODE (#64) file and several laboratory "
^DIC(9.4,14,22,5.9,"PAH",233,1,48,0)="standardized files associated with National Laboratory Test (NLT) package "
^DIC(9.4,14,22,5.9,"PAH",233,1,49,0)="and Logical Observation Identifier Naming Codes (LOINC) coding. (See list "
^DIC(9.4,14,22,5.9,"PAH",233,1,50,0)="below) "
^DIC(9.4,14,22,5.9,"PAH",233,1,51,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,52,0)="File #          File Name               Method"
^DIC(9.4,14,22,5.9,"PAH",233,1,53,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,54,0)="64.061  LAB ELECTRONIC CODES            Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,55,0)="64.062  LAB ELECTRONIC SUBTYPES         Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,56,0)="64.2    WKLD SUFFIX CODES               Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,57,0)="64.22   WKLD ITEM FOR COUNT             Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,58,0)="64.3    WKLD INSTRUMENT MANUFACTURER    Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,59,0)="64.81   LAB NLT/CPT CODES               Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,60,0)="95.3    LAB LOINC                       Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,61,0)="95.31   LAB LOINC COMPONENT             Replaced"
^DIC(9.4,14,22,5.9,"PAH",233,1,62,0)="64      WKLD CODE                       Updated"
^DIC(9.4,14,22,5.9,"PAH",233,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,64,0)="============================"
^DIC(9.4,14,22,5.9,"PAH",233,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,66,0)="LOINC Copyright acknowledgement:"
^DIC(9.4,14,22,5.9,"PAH",233,1,67,0)="LOINC was Copyrighted 1995, 1996, 1997, by Regenstrief Institute and the "
^DIC(9.4,14,22,5.9,"PAH",233,1,68,0)="Logical Observation Identifier Names and Codes (LOINC) Committee.  All "
^DIC(9.4,14,22,5.9,"PAH",233,1,69,0)="rights reserved. LOINC is a trademark of the Regenstrief Institute."
^DIC(9.4,14,22,5.9,"PAH",233,1,70,0)="Contact information:"
^DIC(9.4,14,22,5.9,"PAH",233,1,71,0)="LOINC"
^DIC(9.4,14,22,5.9,"PAH",233,1,72,0)="C/o Regenstrief Institute"
^DIC(9.4,14,22,5.9,"PAH",233,1,73,0)="1001 West 10th Street, RHC-5"
^DIC(9.4,14,22,5.9,"PAH",233,1,74,0)="Indianapolis, Indiana 46202 USA"
^DIC(9.4,14,22,5.9,"PAH",233,1,75,0)="========================"
^DIC(9.4,14,22,5.9,"PAH",233,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,77,0)="VistA Laboratory Package LAB LOINC (#95.3) file does not support all of "
^DIC(9.4,14,22,5.9,"PAH",233,1,78,0)="the fields contained in the LOINC database. Refer to the LOINC user's "
^DIC(9.4,14,22,5.9,"PAH",233,1,79,0)="manual for more field details. The following fields are imported and "
^DIC(9.4,14,22,5.9,"PAH",233,1,80,0)="supported within VistA. The field ""(#X)"" refers to the field in the LAB "
^DIC(9.4,14,22,5.9,"PAH",233,1,81,0)="LOINC (#95.3) file were the data is stored."
^DIC(9.4,14,22,5.9,"PAH",233,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,83,0)="#    Loinc Term         VistA name"
^DIC(9.4,14,22,5.9,"PAH",233,1,84,0)="1    LOINC_NUM          CODE field (#.01) + CHECK DIGIT field (#15)"
^DIC(9.4,14,22,5.9,"PAH",233,1,85,0)="2    COMPONENT          COMPONENT field (#1)+LAB LOINC COMPONENT file"
^DIC(9.4,14,22,5.9,"PAH",233,1,86,0)="                                (95.31)"
^DIC(9.4,14,22,5.9,"PAH",233,1,87,0)="3    PROPERTY           PROPERTY field (#2)"
^DIC(9.4,14,22,5.9,"PAH",233,1,88,0)="4    TIME_ASPCT         TIME ASPECT field (#3)"
^DIC(9.4,14,22,5.9,"PAH",233,1,89,0)="5    SYSTEM             SYSTEM field (#4)"
^DIC(9.4,14,22,5.9,"PAH",233,1,90,0)="6    SCALE_TYP          SCALE TYPE field (#5)"
^DIC(9.4,14,22,5.9,"PAH",233,1,91,0)="7    METHOD_TYP         METHOD TYPE field (#6)"
^DIC(9.4,14,22,5.9,"PAH",233,1,92,0)="9    CLASS              CLASSTYPE field (#41)"
^DIC(9.4,14,22,5.9,"PAH",233,1,93,0)="10   SOURCE             SOURCE field (#8)"
^DIC(9.4,14,22,5.9,"PAH",233,1,94,0)="14   DT_LAST_CH         DATE LAST CHANGED field (#22)"
^DIC(9.4,14,22,5.9,"PAH",233,1,95,0)="15   CHNG_REAS          CHANGE REASON field (#24)"
^DIC(9.4,14,22,5.9,"PAH",233,1,96,0)="16   CHNG_TYPE          CHANGE TYPE field (#23)"
^DIC(9.4,14,22,5.9,"PAH",233,1,97,0)="19   STATUS             STATUS field (#20)"
^DIC(9.4,14,22,5.9,"PAH",233,1,98,0)="20   MAP_TO             MAP TO field (#21)"
^DIC(9.4,14,22,5.9,"PAH",233,1,99,0)="23   VA_CD              VA CODE field (#34"
^DIC(9.4,14,22,5.9,"PAH",233,1,100,0)="59   SHORTNAME          SHORTNAME field (#81)"
^DIC(9.4,14,22,5.9,"PAH",233,1,101,0)="  "
^DIC(9.4,14,22,5.9,"PAH",233,1,102,0)="Those local terms not included in the installed files should be formally "
^DIC(9.4,14,22,5.9,"PAH",233,1,103,0)="requested by notifying the National Laboratory Test Coordinator using the "
^DIC(9.4,14,22,5.9,"PAH",233,1,104,0)="form provided on the VistA Laboratory Documentation Web Page. "
^DIC(9.4,14,22,5.9,"PAH",233,1,105,0)="http://vista.domain.ext/clinicalspecialties/lab/"
^DIC(9.4,14,22,5.9,"PAH",233,1,106,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,107,0)="Forward your completed request form to the Exchange distribution group:"
^DIC(9.4,14,22,5.9,"PAH",233,1,108,0)="VHAISD LAB NLT_LOINC"
^DIC(9.4,14,22,5.9,"PAH",233,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,110,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",233,1,111,0)="OPTIONS:"
^DIC(9.4,14,22,5.9,"PAH",233,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,113,0)="NEW OPTION:"
^DIC(9.4,14,22,5.9,"PAH",233,1,114,0)="Print LOINC Code Status [LR LOINC STATUS PRINT]"
^DIC(9.4,14,22,5.9,"PAH",233,1,115,0)="This patch will provide an option to list LOINC deprecated terms. The "
^DIC(9.4,14,22,5.9,"PAH",233,1,116,0)="option will also provide a list of currently mapped/linked laboratory "
^DIC(9.4,14,22,5.9,"PAH",233,1,117,0)="tests that are linked to LOINC deprecated terms. This new option is "
^DIC(9.4,14,22,5.9,"PAH",233,1,118,0)="located on the LOINC Mapping Utility Menu [LR LOINC UTILITY] menu. "
^DIC(9.4,14,22,5.9,"PAH",233,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,120,0)="MODIFIED OPTION:"
^DIC(9.4,14,22,5.9,"PAH",233,1,121,0)="Map Lab Tests to LOINC Codes [LR LOINC MAP]"
^DIC(9.4,14,22,5.9,"PAH",233,1,122,0)="This option has been modified to permit the use of suffixed WKLD CODE "
^DIC(9.4,14,22,5.9,"PAH",233,1,123,0)="in the NATIONAL VA LAB CODE (#64) field, of the LABORATORY TEST (#60) "
^DIC(9.4,14,22,5.9,"PAH",233,1,124,0)="file. This modified option is located on the LOINC Main Menu [LRLOINC] "
^DIC(9.4,14,22,5.9,"PAH",233,1,125,0)="menu."
^DIC(9.4,14,22,5.9,"PAH",233,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,127,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",233,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,129,0)="DATA DICTIONARY MODIFICATIONS:"
^DIC(9.4,14,22,5.9,"PAH",233,1,130,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,131,0)="The screen has been removed from ""NATIONAL VA LAB CODE"" (#64) field, of "
^DIC(9.4,14,22,5.9,"PAH",233,1,132,0)="the ""LABORATORY TEST"" (#60) file. This will permit the use of suffixed "
^DIC(9.4,14,22,5.9,"PAH",233,1,133,0)="WKLD CODE in the NATIONAL VA LAB CODE (#64) field, of the LABORATORY "
^DIC(9.4,14,22,5.9,"PAH",233,1,134,0)="TEST(#60) file."
^DIC(9.4,14,22,5.9,"PAH",233,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,136,0)="A cross-reference has been created on the ""STATUS"" (#20) field of the "
^DIC(9.4,14,22,5.9,"PAH",233,1,137,0)="""LAB LOINC"" (#95.3) file."
^DIC(9.4,14,22,5.9,"PAH",233,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,139,0)="The patch creates the following fields in the LAB LOINC (#95.3) file: "
^DIC(9.4,14,22,5.9,"PAH",233,1,140,0)="MASTER ENTRY FOR VUID field (#99.98), VUID field (#99.99), and EFFECTIVE "
^DIC(9.4,14,22,5.9,"PAH",233,1,141,0)="DATE/TIME field multiple (#99.991) with an Effective DATE/TIME field "
^DIC(9.4,14,22,5.9,"PAH",233,1,142,0)="(95.3099,.01) and STATUS field (95.3099,.02) which includes a date/time "
^DIC(9.4,14,22,5.9,"PAH",233,1,143,0)="stamp and a status of 'active' or 'inactive' in the files being "
^DIC(9.4,14,22,5.9,"PAH",233,1,144,0)="standardized."
^DIC(9.4,14,22,5.9,"PAH",233,1,145,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,146,0)="This patch also modifies data dictionaries to prevent future modification "
^DIC(9.4,14,22,5.9,"PAH",233,1,147,0)="to these files at a local site."
^DIC(9.4,14,22,5.9,"PAH",233,1,148,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,149,0)="Routine Summary:"
^DIC(9.4,14,22,5.9,"PAH",233,1,150,0)="================"
^DIC(9.4,14,22,5.9,"PAH",233,1,151,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,152,0)="The following is a list of the routine(s) included in this patch. The"
^DIC(9.4,14,22,5.9,"PAH",233,1,153,0)="  second line of each of these routine(s) will look like:"
^DIC(9.4,14,22,5.9,"PAH",233,1,154,0)="  "
^DIC(9.4,14,22,5.9,"PAH",233,1,155,0)="      <tab>;;5.2;LAB SERVICE;**[patch list]**;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",233,1,156,0)="  "
^DIC(9.4,14,22,5.9,"PAH",233,1,157,0)="                             CHECK^XTSUMBLD results"
^DIC(9.4,14,22,5.9,"PAH",233,1,158,0)=" "
