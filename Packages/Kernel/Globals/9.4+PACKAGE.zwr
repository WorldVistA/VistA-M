^DIC(9.4,81,22,2.3,"PAH",4,1,75,0)=" "
^DIC(9.4,81,22,2.3,"PAH",4,1,76,0)="Routine Name:  PSGWODRN"
^DIC(9.4,81,22,2.3,"PAH",4,1,77,0)="               PSGWOND"
^DIC(9.4,81,22,2.3,"PAH",5,0)="12^2970708^1"
^DIC(9.4,81,22,2.3,"PAH",5,1,0)="^^72^72^2970708"
^DIC(9.4,81,22,2.3,"PAH",5,1,1,0)="A problem has been reported when using the option Input AOU Inventory"
^DIC(9.4,81,22,2.3,"PAH",5,1,2,0)="[PSGW AOU INVENTORY INPUT].  The problem occurs when using the ^ jump"
^DIC(9.4,81,22,2.3,"PAH",5,1,3,0)="functionality at the 'ON-HAND //' prompt if the inventory sheet being"
^DIC(9.4,81,22,2.3,"PAH",5,1,4,0)="input contains more than one inventory TYPE. The site was unable to use"
^DIC(9.4,81,22,2.3,"PAH",5,1,5,0)="the ^ followed by the item name to jump to another item."
^DIC(9.4,81,22,2.3,"PAH",5,1,6,0)="(NOIS LON-0297-60876)"
^DIC(9.4,81,22,2.3,"PAH",5,1,7,0)=" "
^DIC(9.4,81,22,2.3,"PAH",5,1,8,0)="This patch will correct these problems.  "
^DIC(9.4,81,22,2.3,"PAH",5,1,9,0)=" "
^DIC(9.4,81,22,2.3,"PAH",5,1,10,0)="ROUTINE SUMMARY: "
^DIC(9.4,81,22,2.3,"PAH",5,1,11,0)="================"
