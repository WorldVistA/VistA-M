^DIC(9.4,14,22,5.9,"PAH",275,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",275,1,2,0)="package by the Vista Maintenance team that addresses"
^DIC(9.4,14,22,5.9,"PAH",275,1,3,0)="issues with an incomplete audit log-in and with batch result"
^DIC(9.4,14,22,5.9,"PAH",275,1,4,0)="entry of microbiology results:"
^DIC(9.4,14,22,5.9,"PAH",275,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",275,1,6,0)="1.      I8246369FY16 -  Incomplete audit log-in"
^DIC(9.4,14,22,5.9,"PAH",275,1,7,0)="2.      I6575449FY16 -  <UNDEFINED> error in micro results entry (batch) "
