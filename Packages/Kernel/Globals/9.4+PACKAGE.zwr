^DIC(9.4,93,22,21,"PAH",197,1,107,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,93,22,21,"PAH",197,1,108,0)="-----------------------------"
^DIC(9.4,93,22,21,"PAH",197,1,109,0)="N/A"
^DIC(9.4,93,22,21,"PAH",197,1,110,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,111,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,112,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,93,22,21,"PAH",197,1,113,0)="--------------------------------------------"
^DIC(9.4,93,22,21,"PAH",197,1,114,0)="1.)   INC23613395: CAPRI Report Builder fails on the Outpatient History "
^DIC(9.4,93,22,21,"PAH",197,1,115,0)="      All report in the Meds tab of the Clinical Documents  "
^DIC(9.4,93,22,21,"PAH",197,1,116,0)="      "
^DIC(9.4,93,22,21,"PAH",197,1,117,0)="      Problem: "
^DIC(9.4,93,22,21,"PAH",197,1,118,0)="      --------"
^DIC(9.4,93,22,21,"PAH",197,1,119,0)="      When using the CAPRI Report Builder function a"
^DIC(9.4,93,22,21,"PAH",197,1,120,0)="      <SUBSCRIPT>DRUG+8^DVBCREPT error is received if a Medication order"
^DIC(9.4,93,22,21,"PAH",197,1,121,0)="      is missing the Drug which is causing the Drug Class to error."
^DIC(9.4,93,22,21,"PAH",197,1,122,0)="  "
^DIC(9.4,93,22,21,"PAH",197,1,123,0)="  "
^DIC(9.4,93,22,21,"PAH",197,1,124,0)="      Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,125,0)="      -----------"
^DIC(9.4,93,22,21,"PAH",197,1,126,0)="      Code was added to resolve the missing data gracefully, the error "
^DIC(9.4,93,22,21,"PAH",197,1,127,0)="      will no longer occur but supply the verbiage ""VA DRUG CLASS NOT"
^DIC(9.4,93,22,21,"PAH",197,1,128,0)="      AVAILABLE""."
^DIC(9.4,93,22,21,"PAH",197,1,129,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,130,0)="   "
^DIC(9.4,93,22,21,"PAH",197,1,131,0)="2.)  INC18759211: CAPRI: can't get DBQs to sign when in draft/not ready "
^DIC(9.4,93,22,21,"PAH",197,1,132,0)="                  status"
^DIC(9.4,93,22,21,"PAH",197,1,133,0)="    "
^DIC(9.4,93,22,21,"PAH",197,1,134,0)="     Problem:"
^DIC(9.4,93,22,21,"PAH",197,1,135,0)="     --------"
^DIC(9.4,93,22,21,"PAH",197,1,136,0)="     Signing case off color changed to black which indicates it is "
^DIC(9.4,93,22,21,"PAH",197,1,137,0)="     completed but stays in Draft not ready, directly affecting patient"
^DIC(9.4,93,22,21,"PAH",197,1,138,0)="     care because holding up information transferring to the VBA which"
^DIC(9.4,93,22,21,"PAH",197,1,139,0)="     stops access from patient to have access to health care."
^DIC(9.4,93,22,21,"PAH",197,1,140,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,141,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,142,0)="     Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,143,0)="     ----------"
^DIC(9.4,93,22,21,"PAH",197,1,144,0)="     Code was added to verify if the document is a C&P exam and if not "
^DIC(9.4,93,22,21,"PAH",197,1,145,0)="     then it will set the status code to complete."
^DIC(9.4,93,22,21,"PAH",197,1,146,0)="    "
^DIC(9.4,93,22,21,"PAH",197,1,147,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,148,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,149,0)="3.)  INC20083692: Report Builder running slowly "
^DIC(9.4,93,22,21,"PAH",197,1,150,0)="     "
^DIC(9.4,93,22,21,"PAH",197,1,151,0)="     Problem:"
^DIC(9.4,93,22,21,"PAH",197,1,152,0)="     --------"
^DIC(9.4,93,22,21,"PAH",197,1,153,0)="     Users are creating reports with zero selections and encountering "
^DIC(9.4,93,22,21,"PAH",197,1,154,0)="     errors.  If the selection is blank it was creating "
^DIC(9.4,93,22,21,"PAH",197,1,155,0)="     a duplicate string of characters which was creating an error in the "
^DIC(9.4,93,22,21,"PAH",197,1,156,0)="     RPC call."
^DIC(9.4,93,22,21,"PAH",197,1,157,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,158,0)="     Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,159,0)="     ----------"
^DIC(9.4,93,22,21,"PAH",197,1,160,0)="     Added code to allow for zero selections and not create the duplicate "
^DIC(9.4,93,22,21,"PAH",197,1,161,0)="     string of characters."
^DIC(9.4,93,22,21,"PAH",197,1,162,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,163,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,164,0)="4.) INC21941384: Requesting office value on ""insufficient"" exam request "
^DIC(9.4,93,22,21,"PAH",197,1,165,0)="                 showing the wrong office "
^DIC(9.4,93,22,21,"PAH",197,1,166,0)="   "
^DIC(9.4,93,22,21,"PAH",197,1,167,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",197,1,168,0)="    ---------"
^DIC(9.4,93,22,21,"PAH",197,1,169,0)="    VBA end user should probably not be able to change the requesting "
^DIC(9.4,93,22,21,"PAH",197,1,170,0)="    office value after the request is submitted in CAPRI. "
^DIC(9.4,93,22,21,"PAH",197,1,171,0)="    The requesting office should be populated from the user's profile and "
^DIC(9.4,93,22,21,"PAH",197,1,172,0)="    shouldn't be manually changeable. "
^DIC(9.4,93,22,21,"PAH",197,1,173,0)="    However, the fact that the ""insufficient exam request"" is not "
^DIC(9.4,93,22,21,"PAH",197,1,174,0)="    grabbing the new user's office value but instead is grabbing "
^DIC(9.4,93,22,21,"PAH",197,1,175,0)="    the value of the original requester."
^DIC(9.4,93,22,21,"PAH",197,1,176,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,177,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,178,0)="   Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,179,0)="   ----------"
^DIC(9.4,93,22,21,"PAH",197,1,180,0)="   Disable update of regional office for new and insufficient exam "
^DIC(9.4,93,22,21,"PAH",197,1,181,0)="   request.  If regional office number field is enabled, ensure that the"
^DIC(9.4,93,22,21,"PAH",197,1,182,0)="   updated regional office number will be saved."
^DIC(9.4,93,22,21,"PAH",197,1,183,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,184,0)="5.) INC23025221: CAPRI Allows multiple DBQs with the same name to be "
^DIC(9.4,93,22,21,"PAH",197,1,185,0)="                 added to a worksheet in error "
^DIC(9.4,93,22,21,"PAH",197,1,186,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,187,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",197,1,188,0)="    -------"
^DIC(9.4,93,22,21,"PAH",197,1,189,0)="    User is not able to submit a C&P examination through CAPRI, it says "
^DIC(9.4,93,22,21,"PAH",197,1,190,0)="    that the derm template is outdated, when trying to add a new template"
^DIC(9.4,93,22,21,"PAH",197,1,191,0)="    for derm, the system will not allow that and the user is not able to"
^DIC(9.4,93,22,21,"PAH",197,1,192,0)="    sign it now to submit."
^DIC(9.4,93,22,21,"PAH",197,1,193,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,194,0)="    Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,195,0)="    ----------"
^DIC(9.4,93,22,21,"PAH",197,1,196,0)="    Code was added to prevent user from including duplicate named "
^DIC(9.4,93,22,21,"PAH",197,1,197,0)="    templates in worksheet."
^DIC(9.4,93,22,21,"PAH",197,1,198,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,199,0)="6.) INC21126820: Cannot use Adobe Acrobat Print to PDF from CAPRI"
^DIC(9.4,93,22,21,"PAH",197,1,200,0)="    INC21182944"
^DIC(9.4,93,22,21,"PAH",197,1,201,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,202,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",197,1,203,0)="    -------"
^DIC(9.4,93,22,21,"PAH",197,1,204,0)="    A compatibility issue has been identified with Compensation and "
^DIC(9.4,93,22,21,"PAH",197,1,205,0)="    Pension Record Interchange (CAPRI) and the "
^DIC(9.4,93,22,21,"PAH",197,1,206,0)="    Adobe print to portable document format (PDF) functionality for users "
^DIC(9.4,93,22,21,"PAH",197,1,207,0)="    with Adobe Acrobat DC version 21.011.20039 causing the Adobe Print to"
^DIC(9.4,93,22,21,"PAH",197,1,208,0)="    PDF functionality to fail."
^DIC(9.4,93,22,21,"PAH",197,1,209,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,210,0)="   Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,211,0)="   -----------"
^DIC(9.4,93,22,21,"PAH",197,1,212,0)="   The new version of Adobe Print to PDF requires a defined filename "
^DIC(9.4,93,22,21,"PAH",197,1,213,0)="   (Document Title) be sent to the print driver, which is a new"
^DIC(9.4,93,22,21,"PAH",197,1,214,0)="   requirement with this version of Adobe. This code change has been"
^DIC(9.4,93,22,21,"PAH",197,1,215,0)="   implemented."
^DIC(9.4,93,22,21,"PAH",197,1,216,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,217,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,218,0)="7.)  INC23999254: Patient Claim Number is missing error, unable to send  "
^DIC(9.4,93,22,21,"PAH",197,1,219,0)="                  clinical document to eFolder"
^DIC(9.4,93,22,21,"PAH",197,1,220,0)="    "
^DIC(9.4,93,22,21,"PAH",197,1,221,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",197,1,222,0)="    --------"
^DIC(9.4,93,22,21,"PAH",197,1,223,0)="    Clinical documents are not consistently able to be submitted to the "
^DIC(9.4,93,22,21,"PAH",197,1,224,0)="    eFolder if missing the Patient Claim Number."
^DIC(9.4,93,22,21,"PAH",197,1,225,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,226,0)="   Resolution:"
^DIC(9.4,93,22,21,"PAH",197,1,227,0)="   ----------"
^DIC(9.4,93,22,21,"PAH",197,1,228,0)="   Code was added to update patient information on Clinical documents to "
^DIC(9.4,93,22,21,"PAH",197,1,229,0)="   include an EDIPI number if no Patient Claim Number exists."
^DIC(9.4,93,22,21,"PAH",198,0)="248 SEQ #209^3230601.09291^89"
^DIC(9.4,93,22,21,"PAH",198,1,0)="^^7^7^3230601"
^DIC(9.4,93,22,21,"PAH",198,1,1,0)="Patch DVBA*2.7*248 is adding Status Field (.02) to the 2507 SPECIAL "
^DIC(9.4,93,22,21,"PAH",198,1,2,0)="CONSIDERATIONS FILE (#396.25).  This field will show an Active or "
^DIC(9.4,93,22,21,"PAH",198,1,3,0)="Inactive status to allow for display in the CAPRI GUI."
^DIC(9.4,93,22,21,"PAH",198,1,4,0)=" "
^DIC(9.4,93,22,21,"PAH",198,1,5,0)="This patch is also introducing additional remote procedure calls to allow "
^DIC(9.4,93,22,21,"PAH",198,1,6,0)="for the editing of the 2507 Special Consideration File entries and the "
^DIC(9.4,93,22,21,"PAH",198,1,7,0)="AMIE Worksheet Exam Names."
^DIC(9.4,93,22,21,"PAH",199,0)="250 SEQ #211^3231122.114955^89"
^DIC(9.4,93,22,21,"PAH",199,1,0)="^^26^26^3231122"
^DIC(9.4,93,22,21,"PAH",199,1,1,0)="Patch DVBA*2.7*250 will implement the following:"
^DIC(9.4,93,22,21,"PAH",199,1,2,0)="1. Enhancements to the CAPRI News Feed to call the SharePoint "
^DIC(9.4,93,22,21,"PAH",199,1,3,0)="   application and launch Pdf's with the CAPRI GUI, no longer launching an"
^DIC(9.4,93,22,21,"PAH",199,1,4,0)="   external browser."
^DIC(9.4,93,22,21,"PAH",199,1,5,0)="2. Enhance transmission error handling to save the encoded XML in a "
^DIC(9.4,93,22,21,"PAH",199,1,6,0)="   VistA file and allow users to resend, while maintaining a logged"
^DIC(9.4,93,22,21,"PAH",199,1,7,0)="   sender, response codes received and an attempted transmission count."
^DIC(9.4,93,22,21,"PAH",199,1,8,0)="   a. VistA CAPRI TEMPLATES FILE (#396.17) has been modified to store"
^DIC(9.4,93,22,21,"PAH",199,1,9,0)="      transmission metrics for transmission processes."
^DIC(9.4,93,22,21,"PAH",199,1,10,0)="3. Short term fix for a Kernel issue for users with duplicate VistA "
^DIC(9.4,93,22,21,"PAH",199,1,11,0)="   New Person accounts and missing social security numbers."
^DIC(9.4,93,22,21,"PAH",199,1,12,0)="4. Pseudo SSN was not working properly within the CAPRI GUI "
^DIC(9.4,93,22,21,"PAH",199,1,13,0)="   application, this internal issue was found and corrected."
^DIC(9.4,93,22,21,"PAH",199,1,14,0)=" "
^DIC(9.4,93,22,21,"PAH",199,1,15,0)=" "
^DIC(9.4,93,22,21,"PAH",199,1,16,0)="Patch DVBA*2.7*250 will also address the following bugs:"
^DIC(9.4,93,22,21,"PAH",199,1,17,0)="INC24303017: Edit Fields Not Announced by Screen Reader"
^DIC(9.4,93,22,21,"PAH",199,1,18,0)="INC23768900: CAPRI Application Error Resulting in Shut Down"
^DIC(9.4,93,22,21,"PAH",199,1,19,0)="INC25976939: CAPRI copy/paste and tab malfunction when entering a new "
^DIC(9.4,93,22,21,"PAH",199,1,20,0)="             patient"
^DIC(9.4,93,22,21,"PAH",199,1,21,0)="INC24797102: HRC - Eu is having issues with the CAPRI Fayetteville "
^DIC(9.4,93,22,21,"PAH",199,1,22,0)="             location whenever EU's want to place an order"
^DIC(9.4,93,22,21,"PAH",199,1,23,0)="INC21249123: CAPRI 2507 rerouted from Muskogee VAMC to Cheyenne VAMC was "
^DIC(9.4,93,22,21,"PAH",199,1,24,0)="             not delivered to Cheyenne VAMC"
^DIC(9.4,93,22,21,"PAH",199,1,25,0)="INC26557317: Connection to server for DVBAB REPORT 7131INQ could not be "
^DIC(9.4,93,22,21,"PAH",199,1,26,0)="             established"
^DIC(9.4,93,22,21,"PAH",200,0)="251 SEQ #212^3231122.115352^89"
^DIC(9.4,93,22,21,"PAH",200,1,0)="^^4^4^3231122"
^DIC(9.4,93,22,21,"PAH",200,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",200,1,2,0)="Patch DVBA*2.7*250 decommissioned the DVBA HRC MENU PHARMACY CC menu "
^DIC(9.4,93,22,21,"PAH",200,1,3,0)="option.  This option is being re-instated and the option will be available"
^DIC(9.4,93,22,21,"PAH",200,1,4,0)="to users."
^DIC(9.4,93,22,21,"PAH",201,0)="252 SEQ #213^3250116.095754^89"
^DIC(9.4,93,22,21,"PAH",201,1,0)="^^40^40^3250116"
^DIC(9.4,93,22,21,"PAH",201,1,1,0)="Patch DVBA*2.7*252 introduces the Progress Notes Constructin Set (PNCS) "
^DIC(9.4,93,22,21,"PAH",201,1,2,0)="replacement,Content Management Tool (CMT) system. This allows the Medical"
^DIC(9.4,93,22,21,"PAH",201,1,3,0)="Disability Examination Office (MDEO) to create/update DBQ forms as"
^DIC(9.4,93,22,21,"PAH",201,1,4,0)="needed.  With the introduction of CMT, Compensation and Pension"
^DIC(9.4,93,22,21,"PAH",201,1,5,0)="Record Interchange (CAPRI) will also allow users to create and edit "
^DIC(9.4,93,22,21,"PAH",201,1,6,0)="Disability Benefits Questionnaires (DBQ) in a Portable Document Format"
^DIC(9.4,93,22,21,"PAH",201,1,7,0)="(PDF)."
^DIC(9.4,93,22,21,"PAH",201,1,8,0)=" "
^DIC(9.4,93,22,21,"PAH",201,1,9,0)="Patch DVBA*2.7*252 will also be addressing 508 issues and the following:"
^DIC(9.4,93,22,21,"PAH",201,1,10,0)=" "
^DIC(9.4,93,22,21,"PAH",201,1,11,0)="INC27409886: Deleting an Open Template"
^DIC(9.4,93,22,21,"PAH",201,1,12,0)="INC23389024: Disabled users still able to connect to claims.domain.ext"
^DIC(9.4,93,22,21,"PAH",201,1,13,0)="INC30600763: Cannot access CAPRI Training Site"
^DIC(9.4,93,22,21,"PAH",201,1,14,0)="INC34120499: CAPRI default/timeout window is ""save and exit"" rather than "
^DIC(9.4,93,22,21,"PAH",201,1,15,0)="             ""keep working"" which causes issues"
^DIC(9.4,93,22,21,"PAH",201,1,16,0)="CAPRI 8151:  When the User Runs the Report Builder, Blank Drug Classes "
^DIC(9.4,93,22,21,"PAH",201,1,17,0)="             will be Populated with Incorrect Data"
^DIC(9.4,93,22,21,"PAH",201,1,18,0)="CAPRI-7883:  Resizing Voc-Rehab Medical Services Request Dialog"
^DIC(9.4,93,22,21,"PAH",201,1,19,0)="CAPRI-7884:  Resizing Address Verification"
^DIC(9.4,93,22,21,"PAH",201,1,20,0)="CAPRI-7879:  Exam Reference Error in VistA-When the requested exam is "
^DIC(9.4,93,22,21,"PAH",201,1,21,0)="             opened, the field labeled 'Exam Reference' is being filled"
^DIC(9.4,93,22,21,"PAH",201,1,22,0)="             with the record number instead of the actual exam reference"
^DIC(9.4,93,22,21,"PAH",201,1,23,0)="             number based in VistA"
^DIC(9.4,93,22,21,"PAH",201,1,24,0)="CAPRI-7867:  Report Builder-data from the Diet tab appears in another "
^DIC(9.4,93,22,21,"PAH",201,1,25,0)="             patients data "
^DIC(9.4,93,22,21,"PAH",201,1,26,0)="CAPRI-8244:  Deprecate the CAPRI Manifest Query Going to DAS to Support "
^DIC(9.4,93,22,21,"PAH",201,1,27,0)="             DAS Release"
^DIC(9.4,93,22,21,"PAH",201,1,28,0)="CAPRI-11150: Surgery Report error message encountered: DVBAB OPERATION "
^DIC(9.4,93,22,21,"PAH",201,1,29,0)="             REPORT could not be accessed!"
^DIC(9.4,93,22,21,"PAH",201,1,30,0)="CAPRI-10958: Empty window displaying on screen during CAPRI worksheet "
^DIC(9.4,93,22,21,"PAH",201,1,31,0)="             signing process"
^DIC(9.4,93,22,21,"PAH",201,1,32,0)="CAPRI-12105: Surgery Report Ok Button Active without Report Selected, Out "
^DIC(9.4,93,22,21,"PAH",201,1,33,0)="             of Bound error message received"
^DIC(9.4,93,22,21,"PAH",201,1,34,0)="CAPRI-10314: Capability to Sort and Filter the Edit Local Tab in DBQ Push "
^DIC(9.4,93,22,21,"PAH",201,1,35,0)="             Utility using an RPC"
^DIC(9.4,93,22,21,"PAH",201,1,36,0)="CAPRI-11496: EFolder Transmission message for for Remote Users"
^DIC(9.4,93,22,21,"PAH",201,1,37,0)="CAPRI-11586: Display Error Message for Users for Missing SecID in the NEW "
^DIC(9.4,93,22,21,"PAH",201,1,38,0)="             PERSON File"
^DIC(9.4,93,22,21,"PAH",201,1,39,0)="CAPRI-11938: SecID and SSN Validation based on VistA DVBA CAPRI SECURITY "
^DIC(9.4,93,22,21,"PAH",201,1,40,0)="             TOGGLE"
^DIC(9.4,93,22,21,"PAH",202,0)="254 SEQ #215^3250903.082412^90"
^DIC(9.4,93,22,21,"PAH",202,1,0)="^^12^12^3250903"
^DIC(9.4,93,22,21,"PAH",202,1,1,0)="Patch DVBA*2.7*254 is addressing issues found with the release of Patch "
^DIC(9.4,93,22,21,"PAH",202,1,2,0)="DVBA*2.7*252 which introduced the Progress Notes Construction Set (PNCS) "
^DIC(9.4,93,22,21,"PAH",202,1,3,0)="replacement: Content Management Tool (CMT) system."
^DIC(9.4,93,22,21,"PAH",202,1,4,0)=" "
^DIC(9.4,93,22,21,"PAH",202,1,5,0)="The SNOW tickets being addressed are:"
^DIC(9.4,93,22,21,"PAH",202,1,6,0)="INC37373850: User cannot input a DBQ; unable to open it once it has been"
^DIC(9.4,93,22,21,"PAH",202,1,7,0)="closed. 4 users having the same issue"
^DIC(9.4,93,22,21,"PAH",202,1,8,0)="INC37378273: wrong name in capri"
^DIC(9.4,93,22,21,"PAH",202,1,9,0)="INC37388259: CAPRI SIGNING CASES ERROR"
^DIC(9.4,93,22,21,"PAH",202,1,10,0)="INC37372871: CAPRI"
^DIC(9.4,93,22,21,"PAH",202,1,11,0)="INC37369129: R3 - (DET) New CAPRI Update"
^DIC(9.4,93,22,21,"PAH",202,1,12,0)="INC37431769: Route to CAPRI Tier 2"
^DIC(9.4,93,22,21,"PAH",203,0)="255 SEQ #216^3260210.132107^90"
^DIC(9.4,93,22,21,"PAH",203,1,0)="^^278^278^3260210"
^DIC(9.4,93,22,21,"PAH",203,1,1,0)="Patch DVBA*2.7*255 is introducing Batch Printing capabilities and "
^DIC(9.4,93,22,21,"PAH",203,1,2,0)="transitioning AMIE VistA Options and functions to the CAPRI GUI.  This "
^DIC(9.4,93,22,21,"PAH",203,1,3,0)="patch is also replacing the usage of Secure Blackbox within the CAPRI "
^DIC(9.4,93,22,21,"PAH",203,1,4,0)="codebase and updating that codebase to Delphi 12."
^DIC(9.4,93,22,21,"PAH",203,1,5,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,6,0)="In addition, the following items for support of Content Management Tool "
^DIC(9.4,93,22,21,"PAH",203,1,7,0)="(CMT) system functionality are being included:"
^DIC(9.4,93,22,21,"PAH",203,1,8,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,9,0)="1. Capability to support conditional logic for future CMT DBQ IEPD's"
^DIC(9.4,93,22,21,"PAH",203,1,10,0)="2. Autosave DBQ Data Entered into Free Text Field"
^DIC(9.4,93,22,21,"PAH",203,1,11,0)="3. Addition of Scroll Bar within DBQ PDF Text Field for Max View Limit"
^DIC(9.4,93,22,21,"PAH",203,1,12,0)="4. Updates for Conditional Logic for Autofill with Checkboxes"
^DIC(9.4,93,22,21,"PAH",203,1,13,0)="5. Set Target Field Text Edit Box to Read-Only for Copy Condition"
^DIC(9.4,93,22,21,"PAH",203,1,14,0)="6. Full Header IEPD Validation on DBQ Transmissions"
^DIC(9.4,93,22,21,"PAH",203,1,15,0)="7. ""Date of Examination"" field in a DBQ PDF no longer auto-populates with "
^DIC(9.4,93,22,21,"PAH",203,1,16,0)="   the current date when a DBQ is created"
^DIC(9.4,93,22,21,"PAH",203,1,17,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,18,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,19,0)="The following SNOW tickets are being addressed:"
^DIC(9.4,93,22,21,"PAH",203,1,20,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,21,0)="1. INC40155755: DBQs are showing as editable in VBMS eFolder"
^DIC(9.4,93,22,21,"PAH",203,1,22,0)="2. INC40032912, INC40054773, INC40070450, INC40076207, INC40293176: "
^DIC(9.4,93,22,21,"PAH",203,1,23,0)="   Partial EDIPI and/or single zero EDIPI value in DBQ XML Header causing"
^DIC(9.4,93,22,21,"PAH",203,1,24,0)="   DBQ transmission to fail reaching VBMS eFolder"
^DIC(9.4,93,22,21,"PAH",203,1,25,0)="3. INC40104480: Transmission List not Displaying during Failed "
^DIC(9.4,93,22,21,"PAH",203,1,26,0)="   Transmission"
^DIC(9.4,93,22,21,"PAH",203,1,27,0)="4. INC40220293: CAPRI Report-CNH Display Error"
^DIC(9.4,93,22,21,"PAH",203,1,28,0)="5. INC40098921, INC40246093, INC40205143: User unable to transmit DBQs, "
^DIC(9.4,93,22,21,"PAH",203,1,29,0)="   receives error ""RPC DVBA CAPRI SAVE EXAM PDF could not be accessed!"
^DIC(9.4,93,22,21,"PAH",203,1,30,0)="   Error encountered."""
^DIC(9.4,93,22,21,"PAH",203,1,31,0)="6. INC40205143: Cannot Submit DBQ"
^DIC(9.4,93,22,21,"PAH",203,1,32,0)="7. INC40433009: submitting a 7131 in East Orange Capri will not let me "
^DIC(9.4,93,22,21,"PAH",203,1,33,0)="   select routing location to submit"
^DIC(9.4,93,22,21,"PAH",203,1,34,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,35,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,36,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,37,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,38,0)="EHRM Impact Statement:"
^DIC(9.4,93,22,21,"PAH",203,1,39,0)="----------------------"
^DIC(9.4,93,22,21,"PAH",203,1,40,0)="This patch should have no EHRM impact, and can be installed at all sites, "
^DIC(9.4,93,22,21,"PAH",203,1,41,0)="including EHRM converted sites. "
^DIC(9.4,93,22,21,"PAH",203,1,42,0)=" "
