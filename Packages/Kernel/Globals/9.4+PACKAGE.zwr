^DIC(9.4,70,22,2,"PAH",25,1,97,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",25,1,98,0)="==============="
^DIC(9.4,70,22,2,"PAH",25,1,99,0)="The following routines are included in this patch.  The second"
^DIC(9.4,70,22,2,"PAH",25,1,100,0)="line of each of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",25,1,101,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,102,0)="     <tab>;;1.1;RPC BROKER;**[patch list]**; Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",25,1,103,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,104,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,105,0)="Remote Procedure Calls"
^DIC(9.4,70,22,2,"PAH",25,1,106,0)="======================"
^DIC(9.4,70,22,2,"PAH",25,1,107,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,108,0)="Two new RPCs will be exported with this package to be used as examples "
^DIC(9.4,70,22,2,"PAH",25,1,109,0)="for the purposes of testing the M-to-M Broker."
^DIC(9.4,70,22,2,"PAH",25,1,110,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,111,0)="  XWB M2M EXAMPLE LARRY "
^DIC(9.4,70,22,2,"PAH",25,1,112,0)="  XWB M2M EXAMPLE REF"
^DIC(9.4,70,22,2,"PAH",25,1,113,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,114,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,115,0)="Checksums"
^DIC(9.4,70,22,2,"PAH",25,1,116,0)="========="
^DIC(9.4,70,22,2,"PAH",25,1,117,0)="Sites should use CHECK^XTSUMBLD to verify checksums. "
^DIC(9.4,70,22,2,"PAH",25,1,118,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,119,0)="  Routine Name  Before Patch    After Patch     Patch List"
^DIC(9.4,70,22,2,"PAH",25,1,120,0)="  ============  ============    ===========     =========="
^DIC(9.4,70,22,2,"PAH",25,1,121,0)="  XWBM2MC       None            6758340         28"
^DIC(9.4,70,22,2,"PAH",25,1,122,0)="  XWBM2MS       None            160268          28"
^DIC(9.4,70,22,2,"PAH",25,1,123,0)="  XWBM2MT       None            7883957         28"
^DIC(9.4,70,22,2,"PAH",25,1,124,0)="  XWBRL         None            3848552         28"
^DIC(9.4,70,22,2,"PAH",25,1,125,0)="  XWBRM         None            3795059         28"
^DIC(9.4,70,22,2,"PAH",25,1,126,0)="  XWBRMX        None            3053319         28"
^DIC(9.4,70,22,2,"PAH",25,1,127,0)="  XWBRPC        None            10961081        28"
^DIC(9.4,70,22,2,"PAH",25,1,128,0)="  XWBRPCC       None            5907709         28"
^DIC(9.4,70,22,2,"PAH",25,1,129,0)="  XWBUTL        None            3238078         28"
^DIC(9.4,70,22,2,"PAH",25,1,130,0)="  XWBVL         None            1814637         28"
^DIC(9.4,70,22,2,"PAH",25,1,131,0)="  XWBVLC        None            1920009         28"
^DIC(9.4,70,22,2,"PAH",25,1,132,0)="  XWBVLL        None            3018372         28"
^DIC(9.4,70,22,2,"PAH",25,1,133,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,134,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,135,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,136,0)="Installation Instructions"
^DIC(9.4,70,22,2,"PAH",25,1,137,0)="========================="
^DIC(9.4,70,22,2,"PAH",25,1,138,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,139,0)=">>>Users may remain on the system."
^DIC(9.4,70,22,2,"PAH",25,1,140,0)=">>>TaskMan does *not* need to be stopped."
^DIC(9.4,70,22,2,"PAH",25,1,141,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,142,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,70,22,2,"PAH",25,1,143,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,70,22,2,"PAH",25,1,144,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,145,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",25,1,146,0)="      option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",25,1,147,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,148,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",25,1,149,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",25,1,150,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",25,1,151,0)="      options:"
^DIC(9.4,70,22,2,"PAH",25,1,152,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,153,0)="         Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",25,1,154,0)="         Print Transport Global"
^DIC(9.4,70,22,2,"PAH",25,1,155,0)="         Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",25,1,156,0)="         Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",25,1,157,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,158,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,70,22,2,"PAH",25,1,159,0)="      non-peak time."
^DIC(9.4,70,22,2,"PAH",25,1,160,0)="      This patch can be queued and installed at any time."
^DIC(9.4,70,22,2,"PAH",25,1,161,0)="      TaskMan can remain running."
^DIC(9.4,70,22,2,"PAH",25,1,162,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,163,0)="  5. On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",25,1,164,0)="      option:"
^DIC(9.4,70,22,2,"PAH",25,1,165,0)="        Install Package(s)  'XWB*1.1*28'"
^DIC(9.4,70,22,2,"PAH",25,1,166,0)="                             =========="
^DIC(9.4,70,22,2,"PAH",25,1,167,0)="  "
^DIC(9.4,70,22,2,"PAH",25,1,168,0)="      Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,70,22,2,"PAH",25,1,169,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,170,0)="      Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",25,1,171,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,172,0)="      Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",25,1,173,0)="                                                                                                    =="
^DIC(9.4,70,22,2,"PAH",25,1,174,0)=" "
^DIC(9.4,70,22,2,"PAH",25,1,175,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,70,22,2,"PAH",26,0)="32 SEQ #27^3030430^1"
^DIC(9.4,70,22,2,"PAH",26,1,0)="^^2^2^3030430"
^DIC(9.4,70,22,2,"PAH",26,1,1,0)="Please refer to the Description in the FORUM Patch Module for details."
^DIC(9.4,70,22,2,"PAH",26,1,2,0)="Patch XWB*1.1*32."
^DIC(9.4,70,22,2,"PAH",27,0)="41 SEQ #29^3040507^1"
^DIC(9.4,70,22,2,"PAH",27,1,0)="^^137^137^3040507"
^DIC(9.4,70,22,2,"PAH",27,1,1,0)="There are two fixes included in this patch:"
^DIC(9.4,70,22,2,"PAH",27,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,3,0)="1)  The server-side code of the M2M Broker was not using the error "
^DIC(9.4,70,22,2,"PAH",27,1,4,0)="trapping correctly.  The special variable $ETRAP is NEWed when it should "
^DIC(9.4,70,22,2,"PAH",27,1,5,0)="not be (in routine XWBVLL).  As a result the error logger can get into an"
^DIC(9.4,70,22,2,"PAH",27,1,6,0)="infinite loop.  The error is caused when the socket between the client and"
^DIC(9.4,70,22,2,"PAH",27,1,7,0)="the server gets ""broken"".  To resolve this issue $ETRAP is removed from "
^DIC(9.4,70,22,2,"PAH",27,1,8,0)="the list of NEWed variables in this instance."
^DIC(9.4,70,22,2,"PAH",27,1,9,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,10,0)="2) A new TCP/IP entry point to start the M2M listener on a Cache/VMS "
^DIC(9.4,70,22,2,"PAH",27,1,11,0)="system in now available.  The entry point is CACHEVMS^XWBVLL.  This entry "
^DIC(9.4,70,22,2,"PAH",27,1,12,0)="should replace the entry point ""UCX^XWBVLL"" in the VMS-command file "
^DIC(9.4,70,22,2,"PAH",27,1,13,0)="(refer to patch XWB*1.1*28 for more information on the VMS-command file "
^DIC(9.4,70,22,2,"PAH",27,1,14,0)="and TCP/IP service to support the M2M listener).  "
^DIC(9.4,70,22,2,"PAH",27,1,15,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,16,0)="For Cache/VMS sites:     "
^DIC(9.4,70,22,2,"PAH",27,1,17,0)="$ccontrol session ""<configname>"" ""-U"" ""<namespace>"" ""CACHEVMS^XWBVLL"""
^DIC(9.4,70,22,2,"PAH",27,1,18,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,19,0)="Notice above, that ""configname"" is the name of the configuration in the "
^DIC(9.4,70,22,2,"PAH",27,1,20,0)="Configuration manager that you start from the Cache cube.  It is "
^DIC(9.4,70,22,2,"PAH",27,1,21,0)="recommended to enclose configname with double quotes ("").  For example: "
^DIC(9.4,70,22,2,"PAH",27,1,22,0)="$ccontrol session ""ISFVA1"" ""-U"" ""VAH"" ""CACHEVMS^XWBVLL"""
^DIC(9.4,70,22,2,"PAH",27,1,23,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,24,0)="There are various ways to accomplish this for multiple nodes in a "
^DIC(9.4,70,22,2,"PAH",27,1,25,0)="cluster, depending on how your site is set up.  Here are two "
^DIC(9.4,70,22,2,"PAH",27,1,26,0)="possibilities:"
^DIC(9.4,70,22,2,"PAH",27,1,27,0)="a.  You can have different .com files for each node with each file "
^DIC(9.4,70,22,2,"PAH",27,1,28,0)="containing its specific configname."
^DIC(9.4,70,22,2,"PAH",27,1,29,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,30,0)="b.  Write some code so you can use the same .com file for all nodes.  For "
^DIC(9.4,70,22,2,"PAH",27,1,31,0)="example: "
^DIC(9.4,70,22,2,"PAH",27,1,32,0)="$ NODE=F$EDIT(F$GETSYI(""SCSNODE""),""COLLAPSE,TRIM"")"
^DIC(9.4,70,22,2,"PAH",27,1,33,0)="$ assign  'f$trnlnm(""SYS$NET"")' SYS$NET"
^DIC(9.4,70,22,2,"PAH",27,1,34,0)="$ ccontrol session ""''NODE'"" ""-U"" ""VAH"" ""CACHEVMS^XWBVLL"""
^DIC(9.4,70,22,2,"PAH",27,1,35,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,36,0)="Note:  The NODE is enclosed with a double quotes (""), two single quotes "
^DIC(9.4,70,22,2,"PAH",27,1,37,0)="(') then ending with one single quote (') and a double quote ("")."
^DIC(9.4,70,22,2,"PAH",27,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,39,0)="This is assuming that the namespace is standard in the production nodes.  "
^DIC(9.4,70,22,2,"PAH",27,1,40,0)="For test nodes that have a different namespace, it is recommended to use "
^DIC(9.4,70,22,2,"PAH",27,1,41,0)="it's own .com file.  "
^DIC(9.4,70,22,2,"PAH",27,1,42,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,43,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,44,0)="Patch Tracking #: #37876991"
^DIC(9.4,70,22,2,"PAH",27,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,46,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,47,0)="Documentation for M-to-M Broker update, Patch XWB*1.1*41, is provided in "
^DIC(9.4,70,22,2,"PAH",27,1,48,0)="this patch description. In addition to this, the complete documentation "
^DIC(9.4,70,22,2,"PAH",27,1,49,0)="supplement for the M-to-M Broker, Patch XWB*1.1*28, can be found in the "
^DIC(9.4,70,22,2,"PAH",27,1,50,0)="VistA Anonymous directories and on the VistA Documentation Library (VDL) "
^DIC(9.4,70,22,2,"PAH",27,1,51,0)="in the following two formats:"
^DIC(9.4,70,22,2,"PAH",27,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,53,0)="    XWB1_1P28SP.PDF                    XWB1_1P28SP.DOC"
^DIC(9.4,70,22,2,"PAH",27,1,54,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,55,0)="The preferred retrieval method to download the documentation for Patch "
^DIC(9.4,70,22,2,"PAH",27,1,56,0)="XWB*1.1*28 is to FTP from the ANONYMOUS.SOFTWARE directory at: "
^DIC(9.4,70,22,2,"PAH",27,1,57,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,58,0)="   DOWNLOAD.VISTA.DOMAIN.EXT."
^DIC(9.4,70,22,2,"PAH",27,1,59,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,60,0)="This transmits the file from the first available FTP server. Sites may "
^DIC(9.4,70,22,2,"PAH",27,1,61,0)="also elect to retrieve software directly from one of the following "
^DIC(9.4,70,22,2,"PAH",27,1,62,0)="servers."
^DIC(9.4,70,22,2,"PAH",27,1,63,0)="   "
^DIC(9.4,70,22,2,"PAH",27,1,64,0)="   OI Field Office         FTP Address                  Directory"
^DIC(9.4,70,22,2,"PAH",27,1,65,0)="   ------------------------------------------------------------------"
^DIC(9.4,70,22,2,"PAH",27,1,66,0)="   Albany             ftp.fo-albany.domain.ext     ANONYMOUS.SOFTWARE"
^DIC(9.4,70,22,2,"PAH",27,1,67,0)="   Hines              ftp.fo-hines.domain.ext      ANONYMOUS.SOFTWARE"
^DIC(9.4,70,22,2,"PAH",27,1,68,0)="   Salt Lake City     ftp.fo-slc.domain.ext        ANONYMOUS.SOFTWARE"
^DIC(9.4,70,22,2,"PAH",27,1,69,0)="   "
^DIC(9.4,70,22,2,"PAH",27,1,70,0)=" Note:  These files must be transferred in binary or IMAGE, not"
^DIC(9.4,70,22,2,"PAH",27,1,71,0)="        ASCII, mode.  The VistA Documentation Library (VDL) contains"
^DIC(9.4,70,22,2,"PAH",27,1,72,0)="        all end-user manuals."
^DIC(9.4,70,22,2,"PAH",27,1,73,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,74,0)="The Web address for the VistA Documentation Library (VDL), where you can "
^DIC(9.4,70,22,2,"PAH",27,1,75,0)="also obtain the documentation for M-to-M Broker, Patch XWB*1.1*28, is as "
^DIC(9.4,70,22,2,"PAH",27,1,76,0)="follows:"
^DIC(9.4,70,22,2,"PAH",27,1,77,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,78,0)="   http://www.domain.ext/vdl/Infrastructure.asp?appID=128"
^DIC(9.4,70,22,2,"PAH",27,1,79,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,80,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,81,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,83,0)="List of Test Sites"
^DIC(9.4,70,22,2,"PAH",27,1,84,0)="=================="
^DIC(9.4,70,22,2,"PAH",27,1,85,0)="VISTA Imaging System Team, Washington Office of Information Field Office "
^DIC(9.4,70,22,2,"PAH",27,1,86,0)="(OIFO)"
^DIC(9.4,70,22,2,"PAH",27,1,87,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,88,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",27,1,89,0)="The following routines are included in this patch.  The second line of "
^DIC(9.4,70,22,2,"PAH",27,1,90,0)="each of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",27,1,91,0)=" ;;1.1;RPC BROKER;**[Patch List]**;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",27,1,92,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,93,0)="Checksums:"
^DIC(9.4,70,22,2,"PAH",27,1,94,0)="Sites should use CHECK^XTSUMBLD to verify checksums"
^DIC(9.4,70,22,2,"PAH",27,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,96,0)="Routine Name    Before Patch    After Patch    Patch List"
^DIC(9.4,70,22,2,"PAH",27,1,97,0)="============    ============    ===========    =========="
^DIC(9.4,70,22,2,"PAH",27,1,98,0)="XWBVLL          3018372         3252550        28,41"
^DIC(9.4,70,22,2,"PAH",27,1,99,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,100,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,101,0)="Installation Instructions"
^DIC(9.4,70,22,2,"PAH",27,1,102,0)="========================="
^DIC(9.4,70,22,2,"PAH",27,1,103,0)=">>>Users may remain on the system."
^DIC(9.4,70,22,2,"PAH",27,1,104,0)=">>>TaskMan does *not* need to be stopped."
^DIC(9.4,70,22,2,"PAH",27,1,105,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,106,0)="   1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",27,1,107,0)="       option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",27,1,108,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,109,0)="   2.  DSM sites - These routines should not be in any mapping."
^DIC(9.4,70,22,2,"PAH",27,1,110,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,111,0)="   3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",27,1,112,0)="       system. Now you need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",27,1,113,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",27,1,114,0)="       options:"
^DIC(9.4,70,22,2,"PAH",27,1,115,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,116,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",27,1,117,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",27,1,118,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",27,1,119,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",27,1,120,0)="                 "
^DIC(9.4,70,22,2,"PAH",27,1,121,0)="   4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,70,22,2,"PAH",27,1,122,0)="       non-peak time."
^DIC(9.4,70,22,2,"PAH",27,1,123,0)="       TaskMan can remain running."
^DIC(9.4,70,22,2,"PAH",27,1,124,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,125,0)="   5.  Installation will take less than 2 minutes."
^DIC(9.4,70,22,2,"PAH",27,1,126,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",27,1,127,0)="       option:"
^DIC(9.4,70,22,2,"PAH",27,1,128,0)="        Install Package(s)  'XWB*1.1*41'"
^DIC(9.4,70,22,2,"PAH",27,1,129,0)="                             =========="
^DIC(9.4,70,22,2,"PAH",27,1,130,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,131,0)="       Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES//NO"
^DIC(9.4,70,22,2,"PAH",27,1,132,0)="       Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",27,1,133,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",27,1,134,0)=" "
^DIC(9.4,70,22,2,"PAH",27,1,135,0)="   6.  For Cache/VMS sites ONLY - Update the VMS-command file with this "
^DIC(9.4,70,22,2,"PAH",27,1,136,0)="       new entry for Cache/VMS.  The following should be all on one line:"
^DIC(9.4,70,22,2,"PAH",27,1,137,0)="       $ccontrol session <configname> ""-U"" ""<namespace>"" ""CACHEVMS^XWBVLL"""
^DIC(9.4,70,22,2,"PAH",28,0)="35 SEQ #30^3050204^1"
^DIC(9.4,70,22,2,"PAH",28,1,0)="^^2^2^3050204"
^DIC(9.4,70,22,2,"PAH",28,1,1,0)="Please refer to the Description in the FORUM Patch Module for details."
^DIC(9.4,70,22,2,"PAH",28,1,2,0)="Patch XWB*1.1*35."
^DIC(9.4,70,22,2,"PAH",29,0)="34 SEQ #33^3051115^1"
^DIC(9.4,70,22,2,"PAH",29,1,0)="^^2^2^3051115"
^DIC(9.4,70,22,2,"PAH",29,1,1,0)="Please refer to the Description in the FORUM Patch Module for details."
