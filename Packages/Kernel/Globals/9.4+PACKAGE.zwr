^DIC(9.4,4,22,1,"PAH",168,0)="197 SEQ #193^3011016^1"
^DIC(9.4,4,22,1,"PAH",168,1,0)="^^65^65^3011016"
^DIC(9.4,4,22,1,"PAH",168,1,1,0)="Patch XM*7.1*197"
^DIC(9.4,4,22,1,"PAH",168,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",168,1,3,0)="NOIS: ANN-0900-42146"
^DIC(9.4,4,22,1,"PAH",168,1,4,0)="Test Site: Ann Arbor, MI"
^DIC(9.4,4,22,1,"PAH",168,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",168,1,6,0)="If you ask MailMan to 'new' some of the messages you see while reading"
^DIC(9.4,4,22,1,"PAH",168,1,7,0)="new messages, but you are thrown off the system for some reason before"
^DIC(9.4,4,22,1,"PAH",168,1,8,0)="MailMan has a chance to 'new' them, those messages will not be newed."
^DIC(9.4,4,22,1,"PAH",168,1,9,0)="This patch ensures that they will be, the next time you log on."
^DIC(9.4,4,22,1,"PAH",168,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",168,1,11,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",168,1,12,0)="minimum.  It requires MailMan patches XM*7.1*145 & *186."
^DIC(9.4,4,22,1,"PAH",168,1,13,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",168,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",168,1,15,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",168,1,16,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",168,1,17,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",168,1,18,0)=" "
^DIC(9.4,4,22,1,"PAH",168,1,19,0)="           Before     After"
^DIC(9.4,4,22,1,"PAH",168,1,20,0)="Name       Checksum   Checksum   Patch List"
^DIC(9.4,4,22,1,"PAH",168,1,21,0)="-----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",168,1,22,0)="XMJBN      15087232   10845646   50,100,140,145,197"
^DIC(9.4,4,22,1,"PAH",168,1,23,0)="XMJBN1      * NEW *    4689617   197"
^DIC(9.4,4,22,1,"PAH",168,1,24,0)="XMJMOI     14395055   14514331   50,87,89,110,127,131,143,"
^DIC(9.4,4,22,1,"PAH",168,1,25,0)="                                 146,148,154,172,177,186,197"
^DIC(9.4,4,22,1,"PAH",168,1,26,0)="XMVVITAE   11186176   11306765   50,74,107,140,197"
^DIC(9.4,4,22,1,"PAH",168,1,27,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",168,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",168,1,29,0)="This patch introduces the following new routine:"
^DIC(9.4,4,22,1,"PAH",168,1,30,0)="XMJBN1 - contains no user-callable entry points"
^DIC(9.4,4,22,1,"PAH",168,1,31,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",168,1,32,0)=" "
^DIC(9.4,4,22,1,"PAH",168,1,33,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",168,1,34,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",168,1,35,0)="minimum.  It requires MailMan patches XM*7.1*145 & *186."
^DIC(9.4,4,22,1,"PAH",168,1,36,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",168,1,37,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",168,1,38,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",168,1,39,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",168,1,40,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",168,1,41,0)="4.  Users may be on the system.  You do not need to stop TaskMan or the"
^DIC(9.4,4,22,1,"PAH",168,1,42,0)="    background filer."
^DIC(9.4,4,22,1,"PAH",168,1,43,0)="5.  On the KIDS:Installation menu, use the following options to install the"
