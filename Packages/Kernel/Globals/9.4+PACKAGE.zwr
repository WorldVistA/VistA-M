^DIC(9.4,14,22,5.9,"PAH",278,1,620,0)="4.   Edit the ORDERABLE ITEM file (#101.43) and change the DISPLAY GROUP"
^DIC(9.4,14,22,5.9,"PAH",278,1,621,0)="     to ANATOMIC APTHOLOGY. This edit will remove the LAB entry from "
^DIC(9.4,14,22,5.9,"PAH",278,1,622,0)="the SET field."
^DIC(9.4,14,22,5.9,"PAH",278,1,623,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,624,0)="     Select OPTION: eNTER OR EDIT FILE ENTRIES  "
^DIC(9.4,14,22,5.9,"PAH",278,1,625,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,626,0)="     INPUT TO WHAT FILE: ORDERABLE ITEMS// "
^DIC(9.4,14,22,5.9,"PAH",278,1,627,0)="     EDIT WHICH FIELD: ALL// DISPLAY GROUP  "
^DIC(9.4,14,22,5.9,"PAH",278,1,628,0)="     THEN EDIT FIELD: "
^DIC(9.4,14,22,5.9,"PAH",278,1,629,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,630,0)="     Select ORDERABLE ITEMS NAME:    BONE MARROW"
^DIC(9.4,14,22,5.9,"PAH",278,1,631,0)="     DISPLAY GROUP: LABORATORY// ANATOMIC PATHOLOGY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,632,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,633,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,634,0)="     Select ORDERABLE ITEMS NAME: "
^DIC(9.4,14,22,5.9,"PAH",278,1,635,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,636,0)="     Review of Orderable Item:"
