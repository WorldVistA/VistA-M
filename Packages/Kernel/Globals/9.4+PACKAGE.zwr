^DIC(9.4,205,22,1,0)="1.0"
^DIC(9.4,205,22,1,"PAH",0)="^9.4901^3^3"
^DIC(9.4,205,22,1,"PAH",1,0)="15^3080909"
^DIC(9.4,205,22,1,"PAH",2,0)="15 SEQ #11^3090421.16351^17"
^DIC(9.4,205,22,1,"PAH",3,0)="22 SEQ #18^3110810.112041^17"
^DIC(9.4,205,22,1,"PAH",3,1,0)="^^7^7^3110810"
^DIC(9.4,205,22,1,"PAH",3,1,1,0)="This patch will add four new DNS domain entries to the REMOTE APPLICATION"
^DIC(9.4,205,22,1,"PAH",3,1,2,0)="file (#8994.5). The REMOTE APPLICATION file (#8994.5) was introduced as"
^DIC(9.4,205,22,1,"PAH",3,1,3,0)="part of the Broker Security Enhancement (BSE) to secure access via the"
^DIC(9.4,205,22,1,"PAH",3,1,4,0)="remote user or visitor approach by GUI applications.  The remote visitor"
^DIC(9.4,205,22,1,"PAH",3,1,5,0)="access permits applications where users need to access a large number of"
^DIC(9.4,205,22,1,"PAH",3,1,6,0)="sites, without requiring a separate access code and verify code at each"
^DIC(9.4,205,22,1,"PAH",3,1,7,0)="site."
