^DIC(9.4,100,22,15,"PAH",31,1,263,0)="YS(""ITEM"")=1"
^DIC(9.4,100,22,15,"PAH",31,1,264,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,265,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,266,0)="------"
