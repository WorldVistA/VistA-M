^DIC(9.4,60,22,13,"PAH",584,1,100,0)="5. VistA Provider Suggestion"
^DIC(9.4,60,22,13,"PAH",584,1,101,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,102,0)="   When matching eRx Provider to a corresponding VistA Provider before the "
^DIC(9.4,60,22,13,"PAH",584,1,103,0)="   user is prompted for the VistA entry it will first be presented with "
^DIC(9.4,60,22,13,"PAH",584,1,104,0)="   suggestion (if any) based on the following logic:"
^DIC(9.4,60,22,13,"PAH",584,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,106,0)="  - Once a VistA Provider is matched and later validated to an eRx Provider it"
^DIC(9.4,60,22,13,"PAH",584,1,107,0)="    is then ""remembered"""
^DIC(9.4,60,22,13,"PAH",584,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,109,0)="  - When a new eRx prescription is received for the same eRx Provider the"
^DIC(9.4,60,22,13,"PAH",584,1,110,0)="    ""remembered"" VistA Provider(s) are then presented as suggestions for the"
^DIC(9.4,60,22,13,"PAH",584,1,111,0)="    user to select, as shown below (Validate Patient Screen - Edit action):"
^DIC(9.4,60,22,13,"PAH",584,1,112,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,113,0)="    Select Item(s): Next Screen// E   Edit  "
^DIC(9.4,60,22,13,"PAH",584,1,114,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,115,0)="  - Below is an example for the Provider matching (Validate Provider Screen -"
^DIC(9.4,60,22,13,"PAH",584,1,116,0)="    Edit action):"
^DIC(9.4,60,22,13,"PAH",584,1,117,0)=" "
