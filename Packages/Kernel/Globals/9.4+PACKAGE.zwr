^DIC(9.4,93,22,21,"PAH",153,0)="189 SEQ #167^3150417.144119^17"
^DIC(9.4,93,22,21,"PAH",153,1,0)="^^3^3^3150417"
^DIC(9.4,93,22,21,"PAH",153,1,1,0)="Updates to the CAPRI file system to handle Exam Request Cancelations, "
^DIC(9.4,93,22,21,"PAH",153,1,2,0)="Claim Type, Special Considerations, Insufficient Reasons, Insufficient "
^DIC(9.4,93,22,21,"PAH",153,1,3,0)="Request Y/N, and Exam cancellation free text."
