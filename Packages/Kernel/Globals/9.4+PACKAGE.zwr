^DIC(9.4,212,22,2,"PAH","B","5 SEQ #2",2)=""
^DIC(9.4,212,22,2,"PAH","B","6 SEQ #3",3)=""
^DIC(9.4,212,22,2,"PAH","B","7 SEQ #6",6)=""
