^DIC(9.4,3,22,21,"PAH",515,0)="679 SEQ #545^3180907.121311^54"
^DIC(9.4,3,22,21,"PAH",516,0)="672 SEQ #546^3181101.170602^54"
^DIC(9.4,3,22,21,"PAH",516,1,0)="^^1^1^3181101"
^DIC(9.4,3,22,21,"PAH",516,1,1,0)="Please see the description on Forum"
^DIC(9.4,3,22,21,"PAH",517,0)="690 SEQ #547^3181101.170834^54"
^DIC(9.4,3,22,21,"PAH",517,1,0)="^^6^6^3181101"
^DIC(9.4,3,22,21,"PAH",517,1,1,0)="This patch adds ""ABNL IMA"" to the ALERT CRITICAL TEXT file (#8992.3) and"
^DIC(9.4,3,22,21,"PAH",517,1,2,0)="checks for ""NON"" (like ""NOT"") to screen Alerts with critical text that are"
