^DIC(9.4,60,22,13,"PAH",574,1,148,0)="Miami VAMC, FL"
^DIC(9.4,60,22,13,"PAH",574,1,149,0)="West Palm Beach VAMC, FL"
^DIC(9.4,60,22,13,"PAH",574,1,150,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,151,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,152,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,60,22,13,"PAH",574,1,153,0)="--------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",574,1,154,0)="The software for this patch is being released in a PackMan message."
^DIC(9.4,60,22,13,"PAH",574,1,155,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,156,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,157,0)="Documentation describing the new functionality is included in this "
^DIC(9.4,60,22,13,"PAH",574,1,158,0)="release. Documentation can be found on the VA Software Documentation "
^DIC(9.4,60,22,13,"PAH",574,1,159,0)="Library at: https://www.domain.ext/vdl/. Documentation can also be "
^DIC(9.4,60,22,13,"PAH",574,1,160,0)="obtained at https://download.vista.domain.ext/index.html/SOFTWARE. "
^DIC(9.4,60,22,13,"PAH",574,1,161,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,162,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,163,0)="Documentation Title                             File "
^DIC(9.4,60,22,13,"PAH",574,1,164,0)="Name                     "
^DIC(9.4,60,22,13,"PAH",574,1,165,0)="---------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",574,1,166,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,168,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,169,0)="Patch Installation:"
^DIC(9.4,60,22,13,"PAH",574,1,170,0)="-------------------"
^DIC(9.4,60,22,13,"PAH",574,1,171,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,172,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,173,0)="Pre/Post Installation Overview:"
^DIC(9.4,60,22,13,"PAH",574,1,174,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",574,1,175,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,176,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,177,0)="Pre-Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",574,1,178,0)="------------------------------"
^DIC(9.4,60,22,13,"PAH",574,1,179,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,60,22,13,"PAH",574,1,180,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,60,22,13,"PAH",574,1,181,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,60,22,13,"PAH",574,1,182,0)="minutes to install."
^DIC(9.4,60,22,13,"PAH",574,1,183,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,185,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,186,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,187,0)="Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",574,1,188,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,189,0)="1.  Choose the PackMan message containing this build. Then select "
^DIC(9.4,60,22,13,"PAH",574,1,190,0)="    the INSTALL/CHECK MESSAGE PackMan option to load the build."
^DIC(9.4,60,22,13,"PAH",574,1,191,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,192,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,193,0)="2.  From the Kernel Installation and Distribution System Menu, "
^DIC(9.4,60,22,13,"PAH",574,1,194,0)="    select the Installation Menu.  From this menu, "
^DIC(9.4,60,22,13,"PAH",574,1,195,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,196,0)="    A.  Select the Verify Checksums in Transport Global "
^DIC(9.4,60,22,13,"PAH",574,1,197,0)="        option to confirm the integrity of the routines that "
^DIC(9.4,60,22,13,"PAH",574,1,198,0)="        are in the transport global. When prompted for the "
^DIC(9.4,60,22,13,"PAH",574,1,199,0)="        INSTALL NAME enter the patch or build name. "
^DIC(9.4,60,22,13,"PAH",574,1,200,0)="        PSO*7.0*707"
^DIC(9.4,60,22,13,"PAH",574,1,201,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,202,0)="        NOTE: Using <spacebar><enter> will not bring up a "
^DIC(9.4,60,22,13,"PAH",574,1,203,0)="              Multi-Package build even if it was loaded "
^DIC(9.4,60,22,13,"PAH",574,1,204,0)="              immediately before this step. It will only "
^DIC(9.4,60,22,13,"PAH",574,1,205,0)="              bring up the last patch in the build."
^DIC(9.4,60,22,13,"PAH",574,1,206,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,207,0)="    B. Select the Backup a Transport Global option to create "
^DIC(9.4,60,22,13,"PAH",574,1,208,0)="       a backup message. You must use this option for each"
^DIC(9.4,60,22,13,"PAH",574,1,209,0)="       patch contained in the Host File.  For each patch you"
^DIC(9.4,60,22,13,"PAH",574,1,210,0)="       can specify what to backup; the entire Build or just"
^DIC(9.4,60,22,13,"PAH",574,1,211,0)="       Routines. The backup message can be used to restore"
^DIC(9.4,60,22,13,"PAH",574,1,212,0)="       just the routines or everything that will restore your "
^DIC(9.4,60,22,13,"PAH",574,1,213,0)="       system to pre-patch condition."
^DIC(9.4,60,22,13,"PAH",574,1,214,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,215,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,216,0)="    C. You may also elect to use the following options: "
^DIC(9.4,60,22,13,"PAH",574,1,217,0)="         i.  Print Transport Global - This option will allow "
^DIC(9.4,60,22,13,"PAH",574,1,218,0)="             you to view the components of the KIDS build."
^DIC(9.4,60,22,13,"PAH",574,1,219,0)="         ii. Compare Transport Global to Current System - This "
^DIC(9.4,60,22,13,"PAH",574,1,220,0)="             option will allow you to view all changes that will "
^DIC(9.4,60,22,13,"PAH",574,1,221,0)="             be made when this patch is installed.  It compares "
^DIC(9.4,60,22,13,"PAH",574,1,222,0)="             all of the components of this patch, such as "
^DIC(9.4,60,22,13,"PAH",574,1,223,0)="             routines, DDs, templates, etc."
^DIC(9.4,60,22,13,"PAH",574,1,224,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,225,0)="    D. Select the Install Package(s) option and choose the "
^DIC(9.4,60,22,13,"PAH",574,1,226,0)="       patch to install. "
^DIC(9.4,60,22,13,"PAH",574,1,227,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,228,0)="      i.   If prompted 'Want KIDS to Rebuild Menu Trees Upon "
^DIC(9.4,60,22,13,"PAH",574,1,229,0)="             Completion of Install? NO//', answer NO."
^DIC(9.4,60,22,13,"PAH",574,1,230,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,231,0)="      ii.  When prompted 'Want KIDS to INHIBIT LOGONs during the "
^DIC(9.4,60,22,13,"PAH",574,1,232,0)="           install? NO//', answer NO."
^DIC(9.4,60,22,13,"PAH",574,1,233,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,234,0)="      iii. When prompted 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,60,22,13,"PAH",574,1,235,0)="           Options, and Protocols? NO//', answer NO."
^DIC(9.4,60,22,13,"PAH",574,1,236,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,237,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,238,0)="Post-Installation Instructions:"
^DIC(9.4,60,22,13,"PAH",574,1,239,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",574,1,240,0)="NOTE:  The below instructions, for adding the PROXY USER, were included"
^DIC(9.4,60,22,13,"PAH",574,1,241,0)="in the previous PSO patch POS*7.0*642.  If the procedures to add the"
^DIC(9.4,60,22,13,"PAH",574,1,242,0)="PROXY user were completed after the installation of PSO*7.0*642,"
^DIC(9.4,60,22,13,"PAH",574,1,243,0)="you may skip these post-installation steps below."
^DIC(9.4,60,22,13,"PAH",574,1,244,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,245,0)="******************************* MANDATORY *******************************"
^DIC(9.4,60,22,13,"PAH",574,1,246,0)="The designated site representative must contact the deployment team"
^DIC(9.4,60,22,13,"PAH",574,1,247,0)="through the VHAEKH PSO-7-6-42 mail distribution list in Outlook to get the"
^DIC(9.4,60,22,13,"PAH",574,1,248,0)="access/verify code for the CONNECTOR PROXY for your site.  This will be"
^DIC(9.4,60,22,13,"PAH",574,1,249,0)="sent encrypted via Outlook."
^DIC(9.4,60,22,13,"PAH",574,1,250,0)="************************************************************************* "
^DIC(9.4,60,22,13,"PAH",574,1,251,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,252,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,253,0)="HOW TO SET UP CONNECTOR PROXY USER THROUGH FOUNDATIONS:"
^DIC(9.4,60,22,13,"PAH",574,1,254,0)="======================================================="
^DIC(9.4,60,22,13,"PAH",574,1,255,0)="Using Vista Option FOUNDATIONS MANAGEMENT [XOBU SITE SETUP MENU]:"
^DIC(9.4,60,22,13,"PAH",574,1,256,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,257,0)="                    <<<      VistALink Parameters     >>>"
^DIC(9.4,60,22,13,"PAH",574,1,258,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,259,0)="    VistALink Version: 1.6    Heartbeat Rate: 180    Latency Delta: 180"
^DIC(9.4,60,22,13,"PAH",574,1,260,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,261,0)="                    <<< VistALink Listener Status Log >>>"
^DIC(9.4,60,22,13,"PAH",574,1,262,0)="  ID  Box-Volume        Port   Status       Status Date/Time    "
^DIC(9.4,60,22,13,"PAH",574,1,263,0)="Configuration   "
^DIC(9.4,60,22,13,"PAH",574,1,264,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,265,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,266,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,267,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,268,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,269,0)=" Enter ?? for more actions"
^DIC(9.4,60,22,13,"PAH",574,1,270,0)="SP  Site Parameters                     SL  Start Listener"
^DIC(9.4,60,22,13,"PAH",574,1,271,0)="CFG Manage Configurations               STP Stop Listener"
^DIC(9.4,60,22,13,"PAH",574,1,272,0)="CP  Enter/Edit Connector Proxy User     SB  Start Box"
^DIC(9.4,60,22,13,"PAH",574,1,273,0)="RE  Refresh                             CU  Clean Up Log"
^DIC(9.4,60,22,13,"PAH",574,1,274,0)="CM  Connection Manager"
^DIC(9.4,60,22,13,"PAH",574,1,275,0)="Select Action:Quit// CP   Enter/Edit Connector Proxy User  "
^DIC(9.4,60,22,13,"PAH",574,1,276,0)="Enter NPF CONNECTOR PROXY name : PSO,CONNECTOR PROXY"
^DIC(9.4,60,22,13,"PAH",574,1,277,0)="  Are you adding PSO,CONNECTOR PROXY as a new NEW PERSON (the"
^DIC(9.4,60,22,13,"PAH",574,1,278,0)="198970TH)? No// Y (Yes)"
^DIC(9.4,60,22,13,"PAH",574,1,279,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,280,0)="Checking SOUNDEX for matches."
^DIC(9.4,60,22,13,"PAH",574,1,281,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,282,0)=". <different potential matches for each site>"
^DIC(9.4,60,22,13,"PAH",574,1,283,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,284,0)="Type <Enter> to continue or '^' to exit: "
^DIC(9.4,60,22,13,"PAH",574,1,285,0)="Do you still want to add this entry: NO//Y"
^DIC(9.4,60,22,13,"PAH",574,1,286,0)="Want to edit ACCESS CODE (Y/N): Y"
^DIC(9.4,60,22,13,"PAH",574,1,287,0)="Enter a new ACCESS CODE <Hidden>: ***********  <Use ACCESS CODE provided "
^DIC(9.4,60,22,13,"PAH",574,1,288,0)="to your site> "
^DIC(9.4,60,22,13,"PAH",574,1,289,0)="Please re-type the new code to show that I have it right: ***********"
^DIC(9.4,60,22,13,"PAH",574,1,290,0)="OK, Access code has been changed!"
^DIC(9.4,60,22,13,"PAH",574,1,291,0)="The VERIFY CODE has been deleted as a security measure."
^DIC(9.4,60,22,13,"PAH",574,1,292,0)="You will need to enter a new VERIFY code so the user can sign-on."
^DIC(9.4,60,22,13,"PAH",574,1,293,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,294,0)="Want to edit VERIFY CODE (Y/N): Y"
^DIC(9.4,60,22,13,"PAH",574,1,295,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,296,0)="Enter a new VERIFY CODE: ************  <Use VERIFY CODE provided to your "
^DIC(9.4,60,22,13,"PAH",574,1,297,0)="site>"
^DIC(9.4,60,22,13,"PAH",574,1,298,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,299,0)="Please re-type the new code to show that I have it right: ************"
^DIC(9.4,60,22,13,"PAH",574,1,300,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,301,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,302,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,303,0)="Back-Out/Roll Back Plan:"
^DIC(9.4,60,22,13,"PAH",574,1,304,0)="------------------------"
^DIC(9.4,60,22,13,"PAH",574,1,305,0)="Due to the complexity of this patch, it is not recommended for back-out,"
^DIC(9.4,60,22,13,"PAH",574,1,306,0)="and a restore from a backup of the Transport Global should not be"
^DIC(9.4,60,22,13,"PAH",574,1,307,0)="attempted. In the event that this patch needs to be backed out, the patch"
^DIC(9.4,60,22,13,"PAH",574,1,308,0)="installer should enter a ServiceNow Ticket. The development team will need"
^DIC(9.4,60,22,13,"PAH",574,1,309,0)="to issue a follow-up patch in order to comprehensively back-out this "
^DIC(9.4,60,22,13,"PAH",574,1,310,0)="patch."
^DIC(9.4,60,22,13,"PAH",574,1,311,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,312,0)="Routine Information:"
^DIC(9.4,60,22,13,"PAH",574,1,313,0)="===================="
^DIC(9.4,60,22,13,"PAH",574,1,314,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,315,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,316,0)="The second line of each of these routines now looks like:"
^DIC(9.4,60,22,13,"PAH",574,1,317,0)=" ;;7.0;OUTPATIENT PHARMACY;**[Patch List]**;DEC 1997;Build"
^DIC(9.4,60,22,13,"PAH",574,1,318,0)=" "
^DIC(9.4,60,22,13,"PAH",574,1,319,0)="The checksums below are new checksums, and"
^DIC(9.4,60,22,13,"PAH",574,1,320,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,60,22,13,"PAH",575,0)="724 SEQ #602^3230901.141647^89"
^DIC(9.4,60,22,13,"PAH",575,1,0)="^^49^49^3230901"
^DIC(9.4,60,22,13,"PAH",575,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,60,22,13,"PAH",575,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,3,0)="1) Zero Report email verbiage:"
^DIC(9.4,60,22,13,"PAH",575,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,5,0)="When the Scheduled SPMP Data Export [PSO SPMP SCHEDULED EXPORT] job fails"
^DIC(9.4,60,22,13,"PAH",575,1,6,0)="to transmit a Zero Report batch, two emails for the Zero Report"
^DIC(9.4,60,22,13,"PAH",575,1,7,0)="batch are generated with contradicting wording.  First sent is an email "
^DIC(9.4,60,22,13,"PAH",575,1,8,0)="saying the transmission failed; then a second email is sent saying that "
^DIC(9.4,60,22,13,"PAH",575,1,9,0)="the Zero Report was transmitted.  To reduce confusion at the sites, the "
^DIC(9.4,60,22,13,"PAH",575,1,10,0)="wording in the Zero Report should be corrected to not indicate the "
^DIC(9.4,60,22,13,"PAH",575,1,11,0)="transmission status, thereby avoiding contradicting with the preceding "
^DIC(9.4,60,22,13,"PAH",575,1,12,0)="""transmission failed"" email. "
^DIC(9.4,60,22,13,"PAH",575,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,14,0)="2) PSO*7*696 IOC follow-up issues:"
^DIC(9.4,60,22,13,"PAH",575,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,16,0)="Four issues were identified regarding the new SPMP State Parameter for "
^DIC(9.4,60,22,13,"PAH",575,1,17,0)="ZERO REPORT DEFAULT DIVISON during IOC for previous patch PSO*7*696."
^DIC(9.4,60,22,13,"PAH",575,1,18,0)="All of the items deal with the View/Edit SPMP State Parameters option"
^DIC(9.4,60,22,13,"PAH",575,1,19,0)="[PSO SPMP STATE PARAMETERS]."
^DIC(9.4,60,22,13,"PAH",575,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,21,0)="    1.  When the SEND EXPORT STATE PARAMETER=""2"" but the ZERO REPORT "
^DIC(9.4,60,22,13,"PAH",575,1,22,0)="    DEFAULT DIVISION State Parameter is not set, then no Zero Report "
^DIC(9.4,60,22,13,"PAH",575,1,23,0)="    is generated. However, currently the ZERO REPORT DEFAULT DIVISION is"
^DIC(9.4,60,22,13,"PAH",575,1,24,0)="    not a required field when using the View/Edit SPMP State Parameters"
^DIC(9.4,60,22,13,"PAH",575,1,25,0)="    option [PSO SPMP STATE PARAMETERS]. It should be made required "
^DIC(9.4,60,22,13,"PAH",575,1,26,0)="    within the View/Edit SPMP State Parameters option [PSO SPMP STATE"
^DIC(9.4,60,22,13,"PAH",575,1,27,0)="    PARAMETERS] for SEND=2 to ensure that Zero reports will be sent."
^DIC(9.4,60,22,13,"PAH",575,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,29,0)="    2.  The Help Text for the ZERO REPORT DEFAULT DIVISION State "
^DIC(9.4,60,22,13,"PAH",575,1,30,0)="    Parameter does not clearly indicate it is required when the "
^DIC(9.4,60,22,13,"PAH",575,1,31,0)="    SEND EXPORT STATE PARAMETER=""2"".  "
^DIC(9.4,60,22,13,"PAH",575,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,33,0)="    3.  When using the SEND EXPORT STATE PARAMETER, the State Parameter "
^DIC(9.4,60,22,13,"PAH",575,1,34,0)="    ZERO REPORT DEFAULT DIVISION shows ""//"" even when it's blank.  "
^DIC(9.4,60,22,13,"PAH",575,1,35,0)="    This is not normal behavior since empty fields should not have ""//""."
^DIC(9.4,60,22,13,"PAH",575,1,36,0)="    This is only cosmetic and does not affect functionality of the"
^DIC(9.4,60,22,13,"PAH",575,1,37,0)="    Zero Report, but it should be fixed."
^DIC(9.4,60,22,13,"PAH",575,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,39,0)="    4.  The Technical Description of the ZERO REPORT DEFAULT DIVISION "
^DIC(9.4,60,22,13,"PAH",575,1,40,0)="    State Parameter wording is a little confusing by saying it's used"
^DIC(9.4,60,22,13,"PAH",575,1,41,0)="    for ""MbM states that do not  dispense controlled substances""."
^DIC(9.4,60,22,13,"PAH",575,1,42,0)="    It should be clarified to say this is used when a state has"
^DIC(9.4,60,22,13,"PAH",575,1,43,0)="    State Parameter SEND  EXPORT STATE PARAMETER=2."
^DIC(9.4,60,22,13,"PAH",575,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",575,1,46,0)="Associated ticket(s):"
^DIC(9.4,60,22,13,"PAH",575,1,47,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",575,1,48,0)="INC26586596 - Zero Report verbiage"
^DIC(9.4,60,22,13,"PAH",575,1,49,0)="INC27015594 - PSO*7*696 IOC follow-up issues"
^DIC(9.4,60,22,13,"PAH",576,0)="728 SEQ #603^3230901.141707^89"
^DIC(9.4,60,22,13,"PAH",576,1,0)="^^23^23^3230901"
^DIC(9.4,60,22,13,"PAH",576,1,1,0)="When processing a OneVA fill (refill or partial), the user is prompted for"
^DIC(9.4,60,22,13,"PAH",576,1,2,0)="a label device. After device selection, the software will first send the"
^DIC(9.4,60,22,13,"PAH",576,1,3,0)="fill to the Outpatient Pharmacy Automated Interface (OPAI), if applicable,"
^DIC(9.4,60,22,13,"PAH",576,1,4,0)="then attempt to print a label. But if the user selected a device that is"
^DIC(9.4,60,22,13,"PAH",576,1,5,0)="not designated as a laser label device, an error occurs when the label "
^DIC(9.4,60,22,13,"PAH",576,1,6,0)="prints because only laser labels can print for a OneVA fill. And the user"
^DIC(9.4,60,22,13,"PAH",576,1,7,0)="will get a View Alert regarding this error. The resolution if a non"
^DIC(9.4,60,22,13,"PAH",576,1,8,0)="laser label device was selected is to not make the attempt to print the"
^DIC(9.4,60,22,13,"PAH",576,1,9,0)="label, so no error will be logged in the error trap and the user will not"
^DIC(9.4,60,22,13,"PAH",576,1,10,0)="get a View Alert. If a laser label device is selected at the label prompt,"
^DIC(9.4,60,22,13,"PAH",576,1,11,0)="the laser label will still print without issues."
^DIC(9.4,60,22,13,"PAH",576,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",576,1,13,0)="When sending a OneVA fill (refill or partial) to the OPAI, the routing"
^DIC(9.4,60,22,13,"PAH",576,1,14,0)="(WINDOW or MAIL) is based on previous routing information for the"
^DIC(9.4,60,22,13,"PAH",576,1,15,0)="prescription from the Host Site. This patch will now set the routing to"
^DIC(9.4,60,22,13,"PAH",576,1,16,0)="WINDOW for all OneVA fills."
^DIC(9.4,60,22,13,"PAH",576,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",576,1,18,0)="When a OneVA fill is processed and sent to the OPAI, filling information "
^DIC(9.4,60,22,13,"PAH",576,1,19,0)="is sent from the dispensing site back to host site in an HL7 message. The "
^DIC(9.4,60,22,13,"PAH",576,1,20,0)="problem is even if the message was successful, the VistA HL7 message will "
^DIC(9.4,60,22,13,"PAH",576,1,21,0)="display a Status of ""ERROR"", and an Err Type of ""Message was NAK'ed"". "
^DIC(9.4,60,22,13,"PAH",576,1,22,0)="This patch resolves the issue so these messages will now show as"
^DIC(9.4,60,22,13,"PAH",576,1,23,0)="successfully transmitted."
^DIC(9.4,60,22,13,"PAH",577,0)="725 SEQ #604^3230919.111655^89"
^DIC(9.4,60,22,13,"PAH",577,1,0)="^^30^30^3230919"
^DIC(9.4,60,22,13,"PAH",577,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,60,22,13,"PAH",577,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",577,1,3,0)="NEW RX IS ERRONEOUSLY GETTING SIG BUILT WITH VERB FROM LAST EDITED RX"
^DIC(9.4,60,22,13,"PAH",577,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",577,1,5,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",577,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",577,1,7,0)="1. INC27051655 - NEW RX IS ERRONEOUSLY GETTING SIG BUILT WITH VERB "
^DIC(9.4,60,22,13,"PAH",577,1,8,0)="                 FROM LAST EDITED RX"
^DIC(9.4,60,22,13,"PAH",577,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",577,1,10,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",577,1,11,0)="--------"
^DIC(9.4,60,22,13,"PAH",577,1,12,0)="When editing an active prescription which has INJECT as a verb, and "
^DIC(9.4,60,22,13,"PAH",577,1,13,0)="finishing that Rx appropriately, the pharmacist then moves to another "
^DIC(9.4,60,22,13,"PAH",577,1,14,0)="patient and enters a new Rx, and the verb moves inappropriately to that "
^DIC(9.4,60,22,13,"PAH",577,1,15,0)="new Rx. The problem is seen when the verb for each RX is different."
^DIC(9.4,60,22,13,"PAH",577,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",577,1,17,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",577,1,18,0)="-----------"
^DIC(9.4,60,22,13,"PAH",577,1,19,0)="The problem is caused by the variable VERB not getting deleted when "
^DIC(9.4,60,22,13,"PAH",577,1,20,0)="quitting from routine PSOORED3.  At MW+9^PSOORED3, the processing quits "
^DIC(9.4,60,22,13,"PAH",577,1,21,0)="out without killing any variables.  All other places that quit out of the "
^DIC(9.4,60,22,13,"PAH",577,1,22,0)="routine quit via EX or EX1 that kill variables before quitting out of the "
^DIC(9.4,60,22,13,"PAH",577,1,23,0)="routine. "
^DIC(9.4,60,22,13,"PAH",577,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",577,1,25,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",577,1,26,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",577,1,27,0)="MW+9^PSOORED3 is changed from"
^DIC(9.4,60,22,13,"PAH",577,1,28,0)="   K QTYHLD Q:$G(PSOVER)!($G(PSOREEDQ))"
^DIC(9.4,60,22,13,"PAH",577,1,29,0)="To"
^DIC(9.4,60,22,13,"PAH",577,1,30,0)="   K QTYHLD G:$G(PSOVER)!($G(PSOREEDQ)) EX1"
^DIC(9.4,60,22,13,"PAH",578,0)="735 SEQ #605^3230928.100653^89"
^DIC(9.4,60,22,13,"PAH",578,1,0)="^^1^1^3230928"
^DIC(9.4,60,22,13,"PAH",578,1,1,0)="See FORUM for patch description details."
^DIC(9.4,60,22,13,"PAH",579,0)="716b^3231016.125854^89"
^DIC(9.4,60,22,13,"PAH",579,1,0)="^^5^5^3231016"
^DIC(9.4,60,22,13,"PAH",579,1,1,0)="Backup of PSO*7.0*716 on Mar 23, 2023"
^DIC(9.4,60,22,13,"PAH",579,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",579,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,60,22,13,"PAH",579,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,60,22,13,"PAH",579,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,60,22,13,"PAH",580,0)="714 SEQ #607^3231016.143021^89"
^DIC(9.4,60,22,13,"PAH",580,1,0)="^^5^5^3231016"
^DIC(9.4,60,22,13,"PAH",580,1,1,0)="This patch resolves the following issue:"
^DIC(9.4,60,22,13,"PAH",580,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",580,1,3,0)="INC25021154 - If the PSO EPCS PSDRPH KEY option is assigned to a custom "
^DIC(9.4,60,22,13,"PAH",580,1,4,0)="menu, the user may see the ""Enter User Name:"" prompt again unexpectedly "
^DIC(9.4,60,22,13,"PAH",580,1,5,0)="upon exiting the option or entering a different one. "
^DIC(9.4,60,22,13,"PAH",581,0)="702^3231103.094946^89"
^DIC(9.4,60,22,13,"PAH",582,0)="712^3231122.115557^89"
^DIC(9.4,60,22,13,"PAH",582,1,0)="^^18^18^3231122"
^DIC(9.4,60,22,13,"PAH",582,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,60,22,13,"PAH",582,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",582,1,3,0)="With the introduction of PARK functionality (CPRS 32B release), and"
^DIC(9.4,60,22,13,"PAH",582,1,4,0)="once the Park functionality is enabled, the Health Summary Type of"
^DIC(9.4,60,22,13,"PAH",582,1,5,0)="Essential Med List for Review needs to be able to display ""Active/Parked"""
^DIC(9.4,60,22,13,"PAH",582,1,6,0)="as a status. The Application Program Interface (API), PSO52API, which"
^DIC(9.4,60,22,13,"PAH",582,1,7,0)="provides the prescription details for this report has been modified to"
^DIC(9.4,60,22,13,"PAH",582,1,8,0)="return a status of ACTIVE/PARKED if the calling package is HEALTH"
^DIC(9.4,60,22,13,"PAH",582,1,9,0)="SUMMARY (GMTS). Along with changes in patch GMTS*2.7*145, the Essential"
^DIC(9.4,60,22,13,"PAH",582,1,10,0)="Med List for Review will now be able to display ""Active/Parked"""
^DIC(9.4,60,22,13,"PAH",582,1,11,0)="when the prescription is in a Parked status."
^DIC(9.4,60,22,13,"PAH",582,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",582,1,13,0)="This patch also modifies the logic related to refilling a Parked"
^DIC(9.4,60,22,13,"PAH",582,1,14,0)="Prescription. If the original fill or the refill is not released, or "
^DIC(9.4,60,22,13,"PAH",582,1,15,0)="label not printed or not processed by CMOP then that fill will be "
^DIC(9.4,60,22,13,"PAH",582,1,16,0)="processed, and the prescription will be placed in suspended status. "
^DIC(9.4,60,22,13,"PAH",582,1,17,0)="Otherwise, the current logic in refilling the prescription will be "
^DIC(9.4,60,22,13,"PAH",582,1,18,0)="followed."
^DIC(9.4,60,22,13,"PAH",583,0)="731 SEQ #610^3231206.154115^89"
^DIC(9.4,60,22,13,"PAH",583,1,0)="^^1^1^3231206"
^DIC(9.4,60,22,13,"PAH",583,1,1,0)="See FORUM patch description."
^DIC(9.4,60,22,13,"PAH",584,0)="700 SEQ #611^3231215.132048^89"
^DIC(9.4,60,22,13,"PAH",584,1,0)="^^897^897^3231215"
^DIC(9.4,60,22,13,"PAH",584,1,1,0)="The Inbound Electronic Prescribing (eRx) enhancements delivered in this"
^DIC(9.4,60,22,13,"PAH",584,1,2,0)="patch include updates to the current eRx functionality to convert all"
^DIC(9.4,60,22,13,"PAH",584,1,3,0)="of the MbM Class 3 modifications into Class 1. Below is summary of the"
^DIC(9.4,60,22,13,"PAH",584,1,4,0)="change being delivered in this patch. For a more comprehensive description of"
^DIC(9.4,60,22,13,"PAH",584,1,5,0)="the changes please refer to the documents listed in the Documentation section"
^DIC(9.4,60,22,13,"PAH",584,1,6,0)="of this description."
^DIC(9.4,60,22,13,"PAH",584,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,8,0)="1. Lock Timeout Change (MbM ONLY)"
^DIC(9.4,60,22,13,"PAH",584,1,9,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,10,0)="   The LOCK timeout was intentionally changed to 0.01 seconds for MbM for the"
^DIC(9.4,60,22,13,"PAH",584,1,11,0)="   following options in order to assist MbM in the processing of high-volume"
^DIC(9.4,60,22,13,"PAH",584,1,12,0)="   incoming eRx's:"
^DIC(9.4,60,22,13,"PAH",584,1,13,0)="      "
^DIC(9.4,60,22,13,"PAH",584,1,14,0)="        Complete Orders from eRx [PSO ERX FINISH]"
^DIC(9.4,60,22,13,"PAH",584,1,15,0)="        eRx Holding Queue Processing [PSO ERX QUEUE PROCESSING]"
^DIC(9.4,60,22,13,"PAH",584,1,16,0)="        Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",584,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,18,0)="2. eRx Provider Auto-Validation (MbM ONLY)"
^DIC(9.4,60,22,13,"PAH",584,1,19,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,20,0)="   a) A new logic for auto-validating a VistA Providers for MbM sites is being"
^DIC(9.4,60,22,13,"PAH",584,1,21,0)="      added by this patch to assist MbM in the processing of high-volume"
^DIC(9.4,60,22,13,"PAH",584,1,22,0)="      incoming eRx's. In order to auto-validate a provider the following "
^DIC(9.4,60,22,13,"PAH",584,1,23,0)="      conditions must be fulfilled:"
^DIC(9.4,60,22,13,"PAH",584,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,25,0)="      - eRx Providers was auto-matched to a VistA Provider"
^DIC(9.4,60,22,13,"PAH",584,1,26,0)="      - eRx Provider last name matches VistA Provider last name"
^DIC(9.4,60,22,13,"PAH",584,1,27,0)="      - First letter of eRx Provider first name matches first letter of VistA"
^DIC(9.4,60,22,13,"PAH",584,1,28,0)="        Provider first name"
^DIC(9.4,60,22,13,"PAH",584,1,29,0)="      - Zip code for the eRx Provider matches the zip code for the VistA"
^DIC(9.4,60,22,13,"PAH",584,1,30,0)="        Provider"
^DIC(9.4,60,22,13,"PAH",584,1,31,0)="      - eRx is not electronically signed (CS eRx)"
^DIC(9.4,60,22,13,"PAH",584,1,32,0)="   "
^DIC(9.4,60,22,13,"PAH",584,1,33,0)="   b) The Audit Log will display ""AUTO-VALIDATED"" to indicate that a provider"
^DIC(9.4,60,22,13,"PAH",584,1,34,0)="      was auto-validated, as seen in the example below:"
^DIC(9.4,60,22,13,"PAH",584,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,36,0)="        New Value: PROVIDER,NAME(DEA#: AX1212543) - AUTO-VALIDATED"
^DIC(9.4,60,22,13,"PAH",584,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,38,0)="   c) The Single Patient list will identify such event (auto-validation) by"
^DIC(9.4,60,22,13,"PAH",584,1,39,0)="      by highlighting the letter ""V"" under the MATCHING/PR column."
^DIC(9.4,60,22,13,"PAH",584,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,41,0)="3. VistA Patient and VistA Provider Look-up (MbM ONLY)"
^DIC(9.4,60,22,13,"PAH",584,1,42,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,43,0)="   The VistA Patient and Provider lookup prompts have been modified to display"
^DIC(9.4,60,22,13,"PAH",584,1,44,0)="   different information for MbM sites only:"
^DIC(9.4,60,22,13,"PAH",584,1,45,0)="   - For the VistA Patient it displays:"
^DIC(9.4,60,22,13,"PAH",584,1,46,0)="       Name, DOB, SSN, City and State"
^DIC(9.4,60,22,13,"PAH",584,1,47,0)="       (e.g., AAQDY,BUDT LUSER 08/04/1954  101058613  PADDLETON,MD)"
^DIC(9.4,60,22,13,"PAH",584,1,48,0)="   - For the VistA Provider it displays:"
^DIC(9.4,60,22,13,"PAH",584,1,49,0)="       Name, City, State, DEA# and Exp. (if any)"
^DIC(9.4,60,22,13,"PAH",584,1,50,0)="      (e.g., AEXRFGRI,APSKACWHZ  TORRINGTON,WY DEA#: AA4729919 (Exp: 01/01/24)"
^DIC(9.4,60,22,13,"PAH",584,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,52,0)="4. VistA Patient Suggestion"
^DIC(9.4,60,22,13,"PAH",584,1,53,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,54,0)="   When matching eRx Patient to a corresponding VistA Patient before the user"
^DIC(9.4,60,22,13,"PAH",584,1,55,0)="   is prompted for the VistA entry it will first be presented with suggestion"
^DIC(9.4,60,22,13,"PAH",584,1,56,0)="   (if any) based on the following logic:"
^DIC(9.4,60,22,13,"PAH",584,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,58,0)="  - Once a VistA Patient is matched and later validated to an eRx Patient it"
^DIC(9.4,60,22,13,"PAH",584,1,59,0)="    is then ""remembered"""
^DIC(9.4,60,22,13,"PAH",584,1,60,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,61,0)="  - When a new eRx prescription is received for the same eRx Patient the"
^DIC(9.4,60,22,13,"PAH",584,1,62,0)="    ""remembered"" VistA Patient(s) are then presented as suggestions for the"
^DIC(9.4,60,22,13,"PAH",584,1,63,0)="    user to select, as shown below (Validate Patient Screen - Edit action):"
^DIC(9.4,60,22,13,"PAH",584,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,65,0)="    Select Item(s): Next Screen// E   Edit  "
^DIC(9.4,60,22,13,"PAH",584,1,66,0)="                                                     |Sugg. 1 of 1 - 08/08/23|"
^DIC(9.4,60,22,13,"PAH",584,1,67,0)="    ERX PATIENT                        VISTA PATIENT |From eRx#: 123123      |"
^DIC(9.4,60,22,13,"PAH",584,1,68,0)="    ___________________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,69,0)="    Name:OPEKXAQDY,XUISCSD            |Name:OPEKXAQDY,XUISCSD F"
^DIC(9.4,60,22,13,"PAH",584,1,70,0)="    DOB :DEC 18, 1970                 |DOB :DEC 18, 1970"
^DIC(9.4,60,22,13,"PAH",584,1,71,0)="    Sex :MALE                         |Sex :MALE"
^DIC(9.4,60,22,13,"PAH",584,1,72,0)="    SSN :101127944                    |SSN :101-13-4021"
^DIC(9.4,60,22,13,"PAH",584,1,73,0)="    Address:                          |Address:"
^DIC(9.4,60,22,13,"PAH",584,1,74,0)="     123 FAKE STREET #101             | 123 FLAKE ST SUITE 101"
^DIC(9.4,60,22,13,"PAH",584,1,75,0)="     PLANO,TX  75025                  | PLANO,TX 75025"
^DIC(9.4,60,22,13,"PAH",584,1,76,0)="    Primary Phone: 0236663417         |"
^DIC(9.4,60,22,13,"PAH",584,1,77,0)="    __________________________________|_______________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,78,0)="    ACTION on SUGGESTION: (A)CCEPT  (F)ORGET  (E)XIT: EXIT// "
^DIC(9.4,60,22,13,"PAH",584,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,80,0)="  - The left column has information about the eRx Patient while the right"
^DIC(9.4,60,22,13,"PAH",584,1,81,0)="    column has information about the VistA Patient. The 'Last Match' field"
^DIC(9.4,60,22,13,"PAH",584,1,82,0)="    indicates the last time the VistA Patient was matched to the eRx Patient"
^DIC(9.4,60,22,13,"PAH",584,1,83,0)="    and validated. When a corresponding field does not match it will display"
^DIC(9.4,60,22,13,"PAH",584,1,84,0)="    in reverse video."
^DIC(9.4,60,22,13,"PAH",584,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,86,0)="  - When presented with a suggestion the user is given 3 options: (A)ccept,"
^DIC(9.4,60,22,13,"PAH",584,1,87,0)="    (F)orget or (E)xit:"
^DIC(9.4,60,22,13,"PAH",584,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,89,0)="    ACCEPT - Accepts the suggested VistA Provider and matches it to the eRx"
