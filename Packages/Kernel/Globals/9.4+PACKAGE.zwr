^DIC(9.4,167,22,2,1,0)="^^1^1^3051119"
^DIC(9.4,167,22,2,1,1,0)="ASISTS - VERSION 2.0"
^DIC(9.4,167,22,2,"PAH",0)="^9.4901^26^26"
^DIC(9.4,167,22,2,"PAH",1,0)="1 SEQ #1^3030715^1"
^DIC(9.4,167,22,2,"PAH",1,1,0)="^^1^1^3030715"
^DIC(9.4,167,22,2,"PAH",1,1,1,0)="DOL TYPE, SOURCE AND CAUSE CODES UPDATES"
^DIC(9.4,167,22,2,"PAH",2,0)="2 SEQ #2^3031002^1"
^DIC(9.4,167,22,2,"PAH",2,1,0)="^^1^1^3031002"
^DIC(9.4,167,22,2,"PAH",2,1,1,0)="INSTITUTION FILE AND ACCUMAX CONTENTION FIXES"
^DIC(9.4,167,22,2,"PAH",3,0)="4 SEQ #4^3040702^1"
^DIC(9.4,167,22,2,"PAH",3,1,0)="^^1^1^3040702"
^DIC(9.4,167,22,2,"PAH",3,1,1,0)="ASISTS Enhancements and NOIS fixes"
^DIC(9.4,167,22,2,"PAH",4,0)="6 SEQ #5^3040903^1"
^DIC(9.4,167,22,2,"PAH",4,1,0)="^^1^1^3040903"
^DIC(9.4,167,22,2,"PAH",4,1,1,0)="Bug fix for the Log of Needlestick Incidents Option."
^DIC(9.4,167,22,2,"PAH",5,0)="8 SEQ #7^3041124^1"
^DIC(9.4,167,22,2,"PAH",5,1,0)="^^7^7^3041124"
^DIC(9.4,167,22,2,"PAH",5,1,1,0)="This build contains minor bug fixes and enhancements requested by the ASISTS"
^DIC(9.4,167,22,2,"PAH",5,1,2,0)="TAG.  These enhancements include the ability to select Stations from a 'short'"
^DIC(9.4,167,22,2,"PAH",5,1,3,0)="list, make it easier to select the Body Part Most Affected, enter a 2"
^DIC(9.4,167,22,2,"PAH",5,1,4,0)="character extension to the OWCP Chargeback code, modifications when a claim"
^DIC(9.4,167,22,2,"PAH",5,1,5,0)="is controverted, have the ability to enter and sign a Dual Benefits form, "
^DIC(9.4,167,22,2,"PAH",5,1,6,0)="enter and sign a CA-7 Request for compensation form, and run a new report "
^DIC(9.4,167,22,2,"PAH",5,1,7,0)="based on the response to the Filing Instructions field (File 2260, Field 174)."
^DIC(9.4,167,22,2,"PAH",6,0)="7 SEQ #9^3050311^1"
^DIC(9.4,167,22,2,"PAH",6,1,0)="^^3^3^3050311"
^DIC(9.4,167,22,2,"PAH",6,1,1,0)="This build contains enhancements requested by the ASISTS TAG to implement"
^DIC(9.4,167,22,2,"PAH",6,1,2,0)="the Occupational Safety and Health Administration (OSHA 300) Log and minor"
^DIC(9.4,167,22,2,"PAH",6,1,3,0)="bug fixes and NOIS."
^DIC(9.4,167,22,2,"PAH",7,0)="10 SEQ #10^3050401^1"
^DIC(9.4,167,22,2,"PAH",7,1,0)="^^1^1^3050401"
^DIC(9.4,167,22,2,"PAH",7,1,1,0)="Decommission designated ASISTS roll and scroll menu options."
^DIC(9.4,167,22,2,"PAH",8,0)="11^3050924^1"
^DIC(9.4,167,22,2,"PAH",8,1,0)="^^7^7^3050924"
^DIC(9.4,167,22,2,"PAH",8,1,1,0)="The purpose of this patch is to provide minor enhancements to the Occupational Safety and Health"
^DIC(9.4,167,22,2,"PAH",8,1,2,0)=" Administration (OSHA) 300 Log which was"
^DIC(9.4,167,22,2,"PAH",8,1,3,0)=" implemented in OOPS*2.0*7. This patch"
^DIC(9.4,167,22,2,"PAH",8,1,4,0)=" will also address other miscellaneous"
^DIC(9.4,167,22,2,"PAH",8,1,5,0)=" minor enhancements, reported and"
^DIC(9.4,167,22,2,"PAH",8,1,6,0)=" unreported bug fixes."
^DIC(9.4,167,22,2,"PAH",8,1,7,0)=""
^DIC(9.4,167,22,2,"PAH",9,0)="16 SEQ #14^3080722.073447^1"
^DIC(9.4,167,22,2,"PAH",9,1,0)="^^1^1^3080722"
^DIC(9.4,167,22,2,"PAH",9,1,1,0)="This patch provides an update to file 2263.6 ASISTS OWCP CHARGEBACK CODE."
^DIC(9.4,167,22,2,"PAH",10,0)="14 SEQ #15^3090421.140826^17"
^DIC(9.4,167,22,2,"PAH",10,1,0)="^^3^3^3090421"
^DIC(9.4,167,22,2,"PAH",10,1,1,0)=" "
^DIC(9.4,167,22,2,"PAH",10,1,2,0)="This patch will fix reporting errors with the OSHA 300 Log report"
^DIC(9.4,167,22,2,"PAH",10,1,3,0)="and the OSHA 300A Summary report."
^DIC(9.4,167,22,2,"PAH",11,0)="15 SEQ #16^3090421.161908^17"
^DIC(9.4,167,22,2,"PAH",11,1,0)="^^2^2^3090421"
^DIC(9.4,167,22,2,"PAH",11,1,1,0)="This patch contains new privacy act functionality identified by the"
^DIC(9.4,167,22,2,"PAH",11,1,2,0)="ASISTS customer, required modifications to the CA-7, and minor bug fixes."
^DIC(9.4,167,22,2,"PAH",12,0)="17 SEQ #17^3090422.162244^17"
^DIC(9.4,167,22,2,"PAH",12,1,0)="^^1^1^3090422"
^DIC(9.4,167,22,2,"PAH",12,1,1,0)="This patch provides a fix to transmission errors received from Austin. "
^DIC(9.4,167,22,2,"PAH",13,0)="18 SEQ #18^3090422.163832^17"
^DIC(9.4,167,22,2,"PAH",13,1,0)="^^6^6^3090422"
^DIC(9.4,167,22,2,"PAH",13,1,1,0)="This patch contains one modification to adhere to a business rule with"
^DIC(9.4,167,22,2,"PAH",13,1,2,0)="a package that is external to ASISTS that was not exposed until after "
^DIC(9.4,167,22,2,"PAH",13,1,3,0)="OOPS*2*15 was released.  ASISTS will now include individuals in the"
^DIC(9.4,167,22,2,"PAH",13,1,4,0)="lookup when a case is created if the termination date (NEW PERSON "
^DIC(9.4,167,22,2,"PAH",13,1,5,0)="File #200, TERMINATION DATE Field #9.2) is blank or contains a date "
^DIC(9.4,167,22,2,"PAH",13,1,6,0)="equal to the current or a future date."
^DIC(9.4,167,22,2,"PAH",14,0)="20 SEQ #19^3090909.122204^17"
^DIC(9.4,167,22,2,"PAH",14,1,0)="^^5^5^3090909"
^DIC(9.4,167,22,2,"PAH",14,1,1,0)="This patch contains a modification to address an issue with the OSHA"
^DIC(9.4,167,22,2,"PAH",14,1,2,0)="300 Log.    A field has been added to collect data that will"
^DIC(9.4,167,22,2,"PAH",14,1,3,0)="used to populate Column F in the OSHA 300 log.  This will enable"
^DIC(9.4,167,22,2,"PAH",14,1,4,0)="facilities to have complete control over information in that field"
^DIC(9.4,167,22,2,"PAH",14,1,5,0)="to eliminate OSHA citations."
^DIC(9.4,167,22,2,"PAH",15,0)="21 SEQ #20^3100914.11145^17"
^DIC(9.4,167,22,2,"PAH",15,1,0)="^^9^9^3100914"
^DIC(9.4,167,22,2,"PAH",15,1,1,0)="1)  E-Sig not on Printed Dual Benefits"
^DIC(9.4,167,22,2,"PAH",15,1,2,0)="2)  Report of incident is adding a year to the age.  DOB is correct"
^DIC(9.4,167,22,2,"PAH",15,1,3,0)="3)  Cannot select current SECONDARY SUPERVISOR.,"
^DIC(9.4,167,22,2,"PAH",15,1,4,0)="4)  Employee information disappears"
^DIC(9.4,167,22,2,"PAH",15,1,5,0)="5)  Fields populated that should not be populated."
^DIC(9.4,167,22,2,"PAH",15,1,6,0)="6)  NOI code Garbled when printing CA1"
^DIC(9.4,167,22,2,"PAH",15,1,7,0)="7)  Field exceeds max length error"
^DIC(9.4,167,22,2,"PAH",15,1,8,0)="8)  Time showing incorrectly on print of CA1 form"
^DIC(9.4,167,22,2,"PAH",15,1,9,0)="9)  Problem signing CA1 form for employee"
^DIC(9.4,167,22,2,"PAH",16,0)="22 SEQ #21^3111202.121649^17"
^DIC(9.4,167,22,2,"PAH",16,1,0)="^^3^3^3111202"
^DIC(9.4,167,22,2,"PAH",16,1,1,0)="This patch fixes the potential for an undefined error when an employee"
^DIC(9.4,167,22,2,"PAH",16,1,2,0)="does not have a hire date and updates the ASISTS OWCP CHARGEBACK CODES"
^DIC(9.4,167,22,2,"PAH",16,1,3,0)="file (#2263.6) with four new entries. "
^DIC(9.4,167,22,2,"PAH",17,0)="23 SEQ #22^3120323.125706^17"
^DIC(9.4,167,22,2,"PAH",17,1,0)="^^8^8^3120323"
^DIC(9.4,167,22,2,"PAH",17,1,1,0)="This patch fixes the following issues:"
^DIC(9.4,167,22,2,"PAH",17,1,2,0)=" "
^DIC(9.4,167,22,2,"PAH",17,1,3,0)="1)  Allow the OWCP CHARGEBACK SUFFIX field (#.8) field to"
^DIC(9.4,167,22,2,"PAH",17,1,4,0)="    except numeric values"
^DIC(9.4,167,22,2,"PAH",17,1,5,0)="2)  Issue's with classifying Incident outcome"
^DIC(9.4,167,22,2,"PAH",17,1,6,0)="3)  Death is not checked on OSHA300 Report"
^DIC(9.4,167,22,2,"PAH",17,1,7,0)="4)  Fix misleading description on the ""Reason for Controvert "
^DIC(9.4,167,22,2,"PAH",17,1,8,0)="    Report"" and the ""Reason for Dispute Report"""
^DIC(9.4,167,22,2,"PAH",18,0)="24 SEQ #23^3120829.113428^17"
^DIC(9.4,167,22,2,"PAH",18,1,0)="^^2^2^3120829"
^DIC(9.4,167,22,2,"PAH",18,1,1,0)="This patch addresses an issue where a user with a 4 digit DUZ cannot"
^DIC(9.4,167,22,2,"PAH",18,1,2,0)="Classify Incident Outcome."
^DIC(9.4,167,22,2,"PAH",19,0)="26 SEQ #24^3130624.113642^17"
^DIC(9.4,167,22,2,"PAH",19,1,0)="^^2^2^3130624"
^DIC(9.4,167,22,2,"PAH",19,1,1,0)="This patch updates the ASISTS OWCP CHARGEBACK CODES file (#2263.6) with"
^DIC(9.4,167,22,2,"PAH",19,1,2,0)="one new entry. "
^DIC(9.4,167,22,2,"PAH",20,0)="25 SEQ #26^3131002.111718^17"
^DIC(9.4,167,22,2,"PAH",20,1,0)="^^6^6^3131002"
^DIC(9.4,167,22,2,"PAH",20,1,1,0)="This patch addresses the following:"
^DIC(9.4,167,22,2,"PAH",20,1,2,0)=" "
^DIC(9.4,167,22,2,"PAH",20,1,3,0)="-Issues displaying Stations on the ""Edit Site Parameter"" form "
^DIC(9.4,167,22,2,"PAH",20,1,4,0)="-Incident Outcome display order problems"
^DIC(9.4,167,22,2,"PAH",20,1,5,0)="-OSHA 300 ""Away From Work"" and ""Job Transfer/Restriction"" calculation"
^DIC(9.4,167,22,2,"PAH",20,1,6,0)=" issues "
^DIC(9.4,167,22,2,"PAH",21,0)="28 SEQ #27^3160713.124306^54"
^DIC(9.4,167,22,2,"PAH",21,1,0)="^^5^5^3160713"
^DIC(9.4,167,22,2,"PAH",21,1,1,0)="This patch fixes the following issues:"
^DIC(9.4,167,22,2,"PAH",21,1,2,0)=" "
^DIC(9.4,167,22,2,"PAH",21,1,3,0)="1)  Total Days Issue"
^DIC(9.4,167,22,2,"PAH",21,1,4,0)="2)  Save Location of Injury detail edits"
^DIC(9.4,167,22,2,"PAH",21,1,5,0)="3)  Incident Report Location of Injury availability"
^DIC(9.4,167,22,2,"PAH",22,0)="29 SEQ #28^3170403.155438^54"
^DIC(9.4,167,22,2,"PAH",22,1,0)="^^4^4^3170403"
^DIC(9.4,167,22,2,"PAH",22,1,1,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,167,22,2,"PAH",22,1,2,0)="(2FA) compliant the ASISTS Graphical User Interface (GUI) requires an "
^DIC(9.4,167,22,2,"PAH",22,1,3,0)="upgrade to Delphi version XE8 in order to implement the new Remote "
^DIC(9.4,167,22,2,"PAH",22,1,4,0)="Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,167,22,2,"PAH",23,0)="30 SEQ #29^3171128.125539^54"
^DIC(9.4,167,22,2,"PAH",23,1,0)="^^3^3^3171128"
^DIC(9.4,167,22,2,"PAH",23,1,1,0)="This patch fixes issues when running the ""Display Incidence Rates "
^DIC(9.4,167,22,2,"PAH",23,1,2,0)="Worksheet"" option where the ""Start Year"" and ""End Year"" do not "
^DIC(9.4,167,22,2,"PAH",23,1,3,0)="allow selection of 2017 dates."
^DIC(9.4,167,22,2,"PAH",24,0)="31 SEQ #30^3180907.120629^54"
^DIC(9.4,167,22,2,"PAH",24,1,0)="^^6^6^3180907"
^DIC(9.4,167,22,2,"PAH",24,1,1,0)="When attempting to update OSHA 300 Summary Data in ASISTS adding new"
^DIC(9.4,167,22,2,"PAH",24,1,2,0)="entries is supposed to select the next month and year in sequence, "
^DIC(9.4,167,22,2,"PAH",24,1,3,0)="but depending on the year of the currently selected record, the"
^DIC(9.4,167,22,2,"PAH",24,1,4,0)="year can be set to a previous year. Also, ASISTS does not enforce"
^DIC(9.4,167,22,2,"PAH",24,1,5,0)="the date restrictions when editing of OSHA 300A Summary if the"
^DIC(9.4,167,22,2,"PAH",24,1,6,0)="current month is January or February."
^DIC(9.4,167,22,2,"PAH",25,0)="32 SEQ #31^3190201.122045^54"
^DIC(9.4,167,22,2,"PAH",25,1,0)="^^2^2^3190201"
^DIC(9.4,167,22,2,"PAH",25,1,1,0)="Menu's to be disabled that are no longer needed after the decommissioning"
^DIC(9.4,167,22,2,"PAH",25,1,2,0)="of ASISTS (Automated Safety Incident Surveillance and Tracking System)"
^DIC(9.4,167,22,2,"PAH",26,0)="33 SEQ #32^3220427.1324^86"
^DIC(9.4,167,22,2,"PAH",26,1,0)="^^2^2^3220427"
^DIC(9.4,167,22,2,"PAH",26,1,1,0)="Patch OOPS*2*33 addresses an issue where OOPS tasks are still "
^DIC(9.4,167,22,2,"PAH",26,1,2,0)="scheduled at certain sites"
^DIC(9.4,167,22,2,"PAH","B",11,8)=""
