^DIC(9.4,146,22,2.6,"PAH",0)="^9.4901^3^3"
^DIC(9.4,146,22,2.6,"PAH",1,0)="8 SEQ #7^3090618.154502^17"
^DIC(9.4,146,22,2.6,"PAH",1,1,0)="^^2^2^3090618"
^DIC(9.4,146,22,2.6,"PAH",1,1,1,0)="This patch corrects the gathering of data for the processing of the "
^DIC(9.4,146,22,2.6,"PAH",1,1,2,0)="OS-109 Death screen."
^DIC(9.4,146,22,2.6,"PAH",2,0)="9 SEQ #8^3150316.160905^17"
^DIC(9.4,146,22,2.6,"PAH",2,1,0)="^^8^8^3150316"
^DIC(9.4,146,22,2.6,"PAH",2,1,1,0)="Patch QAO*3*9 addresses 3 issues:"
^DIC(9.4,146,22,2.6,"PAH",2,1,2,0)="      "
^DIC(9.4,146,22,2.6,"PAH",2,1,3,0)="       1.  QAOS 107 screen requires VDL documentation change (MAJOR "
^DIC(9.4,146,22,2.6,"PAH",2,1,4,0)="           surgery)"
^DIC(9.4,146,22,2.6,"PAH",2,1,5,0)="       2.  QAOS 101.1 screen not reporting unscheduled 10 day re-"
^DIC(9.4,146,22,2.6,"PAH",2,1,6,0)="           admissions when scheduled admission occurs on same day"
^DIC(9.4,146,22,2.6,"PAH",2,1,7,0)="       3.  QAOS 109 screen reporting duplicate death entries, due to"
^DIC(9.4,146,22,2.6,"PAH",2,1,8,0)="           time of death change"
^DIC(9.4,146,22,2.6,"PAH",3,0)="10 SEQ #9^3160616.161443^54"
^DIC(9.4,146,22,2.6,"PAH",3,1,0)="^^2^2^3160616"
^DIC(9.4,146,22,2.6,"PAH",3,1,1,0)="Patch QAO*3.0*10 updates the Occurrence Screen 'Return to OR in same "
^DIC(9.4,146,22,2.6,"PAH",3,1,2,0)="admission' (Screen 107) to work with recent Surgery enhancements."
