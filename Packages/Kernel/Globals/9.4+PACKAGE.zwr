^DIC(9.4,133,15002)="^^A"
^DIC(9.4,133,"DEV")="CKA/DALISC"
^DIC(9.4,133,"EX",0)="^9.432^1^1"
^DIC(9.4,133,"EX",1,0)="ESPZ"
^DIC(9.4,133,"INI")="ESPRE^2960924.152433"
^DIC(9.4,133,"INIT")="ESPOST^2960924.152506"
^DIC(9.4,133,"VERSION")="1.0"
^DIC(9.4,134,0)="PATIENT REPRESENTATIVE^QAC^PATIENT REPRESENTATIVE PACKAGE"
^DIC(9.4,134,1,0)="^^2^2^2950213^^"
^DIC(9.4,134,1,1,0)="This package supports the work of the Patient Representative by"
^DIC(9.4,134,1,2,0)="collecting data on patient and non-patient contacts."
^DIC(9.4,134,4,0)="^9.44PA^4^4"
^DIC(9.4,134,4,1,0)=745.1
^DIC(9.4,134,4,1,222)="y^y^^n^^^n"
^DIC(9.4,134,4,2,0)=745.2
^DIC(9.4,134,4,2,222)="y^y^^n^^^y^o^n"
^DIC(9.4,134,4,3,0)=745.3
^DIC(9.4,134,4,3,222)="y^y^^n^^^y^o^n"
^DIC(9.4,134,4,4,0)=745.4
^DIC(9.4,134,4,4,222)="y^y^^n^^^n^^"
^DIC(9.4,134,4,"B",745.1,1)=""
^DIC(9.4,134,4,"B",745.2,2)=""
^DIC(9.4,134,4,"B",745.3,3)=""
^DIC(9.4,134,4,"B",745.4,4)=""
^DIC(9.4,134,5)="HISC"
^DIC(9.4,134,7)="^^I"
^DIC(9.4,134,11)="745^745.49"
^DIC(9.4,134,22,0)="^9.49I^17^1"
^DIC(9.4,134,22,17,0)="2.0^3051119^2960924"
^DIC(9.4,134,22,17,"PAH",0)="^9.4901^21^21"
^DIC(9.4,134,22,17,"PAH",1,0)="1^2960924^1"
^DIC(9.4,134,22,17,"PAH",1,1,0)="^^1^1^2960924"
^DIC(9.4,134,22,17,"PAH",1,1,1,0)="See Description in NPM."
^DIC(9.4,134,22,17,"PAH",2,0)="3 SEQ #2^2971006^1"
^DIC(9.4,134,22,17,"PAH",3,0)="5 SEQ #3^2980318^1"
^DIC(9.4,134,22,17,"PAH",4,0)="7 SEQ #4^2980831^1"
^DIC(9.4,134,22,17,"PAH",5,0)="6 SEQ #5^2980924^1"
^DIC(9.4,134,22,17,"PAH",6,0)="8 SEQ #6^2990119^1"
^DIC(9.4,134,22,17,"PAH",7,0)="10 SEQ #7^2990329^1"
^DIC(9.4,134,22,17,"PAH",8,0)="11 SEQ #8^2990602^1"
^DIC(9.4,134,22,17,"PAH",9,0)="9 SEQ #9^2990622^1"
^DIC(9.4,134,22,17,"PAH",10,0)="12 SEQ #10^2991003^1"
^DIC(9.4,134,22,17,"PAH",11,0)="4^3000516^1"
^DIC(9.4,134,22,17,"PAH",11,1,0)="^^2^2^3000516"
^DIC(9.4,134,22,17,"PAH",11,1,1,0)="This patch does a rollup of data from local sites into a mailmessage,"
^DIC(9.4,134,22,17,"PAH",11,1,2,0)="and sends it to the national database."
^DIC(9.4,134,22,17,"PAH",12,0)="14 SEQ #12^3001012^1"
^DIC(9.4,134,22,17,"PAH",13,0)="13 SEQ #13^3001106^1"
^DIC(9.4,134,22,17,"PAH",14,0)="15 SEQ #14^3010122^1"
^DIC(9.4,134,22,17,"PAH",14,1,0)="^^3^3^3010122"
^DIC(9.4,134,22,17,"PAH",14,1,1,0)="This patch creates an option that can be used to transmit data from"
^DIC(9.4,134,22,17,"PAH",14,1,2,0)="one month to the national database.  The name of the option is Manual"
^DIC(9.4,134,22,17,"PAH",14,1,3,0)="Rollup."
^DIC(9.4,134,22,17,"PAH",15,0)="16 SEQ #15^3010710^1"
^DIC(9.4,134,22,17,"PAH",16,0)="17 SEQ #16^3020626^1"
^DIC(9.4,134,22,17,"PAH",16,1,0)="^^47^47^3020626"
^DIC(9.4,134,22,17,"PAH",16,1,1,0)="This patch is an enhancement project that will make major changes to the "
^DIC(9.4,134,22,17,"PAH",16,1,2,0)="CONTACT ISSUE CODE file (#745.2).  Existing codes will be inactivated, "
^DIC(9.4,134,22,17,"PAH",16,1,3,0)="and new codes will be exported, resulting in a smaller list of active "
^DIC(9.4,134,22,17,"PAH",16,1,4,0)="codes.  Only these nationally exported codes will be in use."
^DIC(9.4,134,22,17,"PAH",16,1,5,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,6,0)="This patch will export seven new entires in the CUSTOME SERVICE STANDARD  "
^DIC(9.4,134,22,17,"PAH",16,1,7,0)="file (#745.6).  These codes will be added in order to bring the Customer "
^DIC(9.4,134,22,17,"PAH",16,1,8,0)="Service Standards field better match the Customer Satisfaction survey.  "
^DIC(9.4,134,22,17,"PAH",16,1,9,0)="These codes are not Customer Service Standards, but can be tracked in the "
^DIC(9.4,134,22,17,"PAH",16,1,10,0)="same way in existing reports.  Each has a suffix of Non-CSS to "
^DIC(9.4,134,22,17,"PAH",16,1,11,0)="distinguish it from the original ten Customer Service Standards.  The "
^DIC(9.4,134,22,17,"PAH",16,1,12,0)="Customer Service Standard field in the CONTACT ISSUE CODE file (#745.2) "
^DIC(9.4,134,22,17,"PAH",16,1,13,0)="has been populated and is being exported with the patch."
^DIC(9.4,134,22,17,"PAH",16,1,14,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,15,0)="This patch changes the input transform of the Division field (#37) of the "
^DIC(9.4,134,22,17,"PAH",16,1,16,0)="CONSUMER CONTACT file (#745.1).  Currently, only integrated sites "
^DIC(9.4,134,22,17,"PAH",16,1,17,0)="received a prompt for Division, and the choices were limited to those "
^DIC(9.4,134,22,17,"PAH",16,1,18,0)="Medical Centers making up the integrate group.  Now, all sites will get "
^DIC(9.4,134,22,17,"PAH",16,1,19,0)="the prompt and choices are amongst those MEDICAL CENTER DIVISION file "
^DIC(9.4,134,22,17,"PAH",16,1,20,0)="(#40.8) entries which point to the INSTITUTION file (#4).  The Division "
^DIC(9.4,134,22,17,"PAH",16,1,21,0)="field remains a pointer to the INSTITUTION file (#4)."
^DIC(9.4,134,22,17,"PAH",16,1,22,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,23,0)="A new field, Internal Appeal (#43) has been added to the CONSUMER CONTACT "
^DIC(9.4,134,22,17,"PAH",16,1,24,0)="file (#745.1).  This field will store whether or not a Report of Contact "
^DIC(9.4,134,22,17,"PAH",16,1,25,0)="will go through the Internal Appeal process.  The Ad Hoc Report has been "
^DIC(9.4,134,22,17,"PAH",16,1,26,0)="updated to include this new field.  Internal Appeal will take the place "
^DIC(9.4,134,22,17,"PAH",16,1,27,0)="of the Refer to SEAT field."
^DIC(9.4,134,22,17,"PAH",16,1,28,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,29,0)="The user will no longer be prompted for the Level of Satisfaction field "
^DIC(9.4,134,22,17,"PAH",16,1,30,0)="(#36 of the CONSUMER CONTACT file (#745.1))."
^DIC(9.4,134,22,17,"PAH",16,1,31,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,32,0)="The second problem was that the division field pointed to the INSTITUTION"
^DIC(9.4,134,22,17,"PAH",16,1,33,0)="file (#4) and only legacy sites were to be available as choices.  With"
^DIC(9.4,134,22,17,"PAH",16,1,34,0)="this patch any entry in the site's MEDICAL CENTER DIVISION file (#40.8)"
^DIC(9.4,134,22,17,"PAH",16,1,35,0)="that points to the INSTITUTION file will be available. Both integrated and"
^DIC(9.4,134,22,17,"PAH",16,1,36,0)="non-integrated sites will be able to enter the division. "
^DIC(9.4,134,22,17,"PAH",16,1,37,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,38,0)="This patch will also correct two problems with the Patient Representative"
^DIC(9.4,134,22,17,"PAH",16,1,39,0)="Roll-up.  "
^DIC(9.4,134,22,17,"PAH",16,1,40,0)=" "
^DIC(9.4,134,22,17,"PAH",16,1,41,0)="The first problem dealt with the fact that once a record was transmitted,"
^DIC(9.4,134,22,17,"PAH",16,1,42,0)="it would be evaluated for re-transmission only when it was closed.  Also,"
^DIC(9.4,134,22,17,"PAH",16,1,43,0)="the roll-up did not take into account the fact that records can be"
^DIC(9.4,134,22,17,"PAH",16,1,44,0)="re-opened and edited after closing.  Any record that was re-opened was not"
^DIC(9.4,134,22,17,"PAH",16,1,45,0)="being evaluated for re-transmission.  With this patch any record edited"
^DIC(9.4,134,22,17,"PAH",16,1,46,0)="will be evaluated for transmission regardless of whether or not it was"
^DIC(9.4,134,22,17,"PAH",16,1,47,0)="previously transmitted, independent of record status."
^DIC(9.4,134,22,17,"PAH",17,0)="18 SEQ #17^3020927^1"
^DIC(9.4,134,22,17,"PAH",17,1,0)="^^5^5^3020927"
^DIC(9.4,134,22,17,"PAH",17,1,1,0)="A problem was discovered with the Service/Discipline Issue Totals [QAC "
^DIC(9.4,134,22,17,"PAH",17,1,2,0)="SERV/DISC ISSUE TOT] report - it would not report results when just one "
^DIC(9.4,134,22,17,"PAH",17,1,3,0)="Division was selected.  The same code is used for the Discipline Issue "
^DIC(9.4,134,22,17,"PAH",17,1,4,0)="Totals [QAC DISC ISSUE TOT] report, and the fix made with this patch "
^DIC(9.4,134,22,17,"PAH",17,1,5,0)="addresses both reports."
^DIC(9.4,134,22,17,"PAH",18,0)="20 SEQ #18^3070627.23171^1"
^DIC(9.4,134,22,17,"PAH",18,1,0)="^^5^5^3070627"
^DIC(9.4,134,22,17,"PAH",18,1,1,0)="Sites are seeing Contact Numbers that do not follow the"
^DIC(9.4,134,22,17,"PAH",18,1,2,0)="proper format. The sites are not able to enter new contact"
^DIC(9.4,134,22,17,"PAH",18,1,3,0)="numbers because of the incorrect contact numbers."
^DIC(9.4,134,22,17,"PAH",18,1,4,0)="This patch will correct the bad contact numbers when the"
^DIC(9.4,134,22,17,"PAH",18,1,5,0)="post install routine is run."
^DIC(9.4,134,22,17,"PAH",19,0)="19 SEQ #19^3070905.001434^1"
^DIC(9.4,134,22,17,"PAH",19,1,0)="^^7^7^3070905"
^DIC(9.4,134,22,17,"PAH",19,1,1,0)="This patch contains the VistA objects to run PATS (Patient Advocate"
^DIC(9.4,134,22,17,"PAH",19,1,2,0)="Tracking System), the application that replaces the legacy Patient"
^DIC(9.4,134,22,17,"PAH",19,1,3,0)="Representative system."
^DIC(9.4,134,22,17,"PAH",19,1,4,0)=" "
^DIC(9.4,134,22,17,"PAH",19,1,5,0)="It includes both objects used to retrieve VistA data while the PATS"
^DIC(9.4,134,22,17,"PAH",19,1,6,0)="application is running, and objects used to migrate the legacy data from"
^DIC(9.4,134,22,17,"PAH",19,1,7,0)="the FileMan files to the new PATS Oracle tables on a central server."
^DIC(9.4,134,22,17,"PAH",20,0)="21 SEQ #20^3071212.223734^1"
^DIC(9.4,134,22,17,"PAH",20,1,0)="^^164^164^3071212"
^DIC(9.4,134,22,17,"PAH",20,1,1,0)="Associated patches: (v)QAC*2*19    <<= must be installed BEFORE "
^DIC(9.4,134,22,17,"PAH",20,1,2,0)="`QAC*2*21'"
^DIC(9.4,134,22,17,"PAH",20,1,3,0)="                    "
^DIC(9.4,134,22,17,"PAH",20,1,4,0)="Subject:  Employee Lookup Bugs in PATS"
^DIC(9.4,134,22,17,"PAH",20,1,5,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,6,0)="Category:  ROUTINE"
^DIC(9.4,134,22,17,"PAH",20,1,7,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,8,0)="Description:"
^DIC(9.4,134,22,17,"PAH",20,1,9,0)="==========="
^DIC(9.4,134,22,17,"PAH",20,1,10,0)="The Patient Advocate Tracking System (PATS) has two remote procedure calls"
^DIC(9.4,134,22,17,"PAH",20,1,11,0)="(RPC) that return data from the NEW PERSON file. The RPC names are QACV"
^DIC(9.4,134,22,17,"PAH",20,1,12,0)="KEY HOLDERS VLH and QACV PERSON LOOKUP VLH. Both RPCs execute the same"
^DIC(9.4,134,22,17,"PAH",20,1,13,0)="code in routine QACVEMPX. The RPCs return NAME, TITLE and MAIL CODE for"
^DIC(9.4,134,22,17,"PAH",20,1,14,0)="selected employees."
^DIC(9.4,134,22,17,"PAH",20,1,15,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,16,0)="Problem #1"
^DIC(9.4,134,22,17,"PAH",20,1,17,0)="----------"
^DIC(9.4,134,22,17,"PAH",20,1,18,0)="Currently, if the TITLE or MAIL CODE contain an ampersand character (&), "
^DIC(9.4,134,22,17,"PAH",20,1,19,0)="the PATS java code interprets this as a reserved xml character and fails."
^DIC(9.4,134,22,17,"PAH",20,1,20,0)="This is experienced in 4 places in PATS."
^DIC(9.4,134,22,17,"PAH",20,1,21,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,22,0)="1. Adding a New Report of Contact (ROC), Cover Sheet tab, the system"
^DIC(9.4,134,22,17,"PAH",20,1,23,0)="should display a drop-down list of Information Takers. Without the patch,"
^DIC(9.4,134,22,17,"PAH",20,1,24,0)="the drop-down list of Info Takers is not present."
^DIC(9.4,134,22,17,"PAH",20,1,25,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,26,0)="2. Edit a ROC, search by Information Taker option, should display a "
^DIC(9.4,134,22,17,"PAH",20,1,27,0)="drop-down list of Information Takers. Without the patch, the drop-down"
^DIC(9.4,134,22,17,"PAH",20,1,28,0)="list of Info Takers is not present."
^DIC(9.4,134,22,17,"PAH",20,1,29,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,30,0)="3. Edit a ROC, Resolution tab, adding a new Issue Code, when user tries to"
^DIC(9.4,134,22,17,"PAH",20,1,31,0)="look up an Employee Involved. Without the patch, the users receive the "
^DIC(9.4,134,22,17,"PAH",20,1,32,0)="error: ""A problem was encountered while attempting to communicate with "
^DIC(9.4,134,22,17,"PAH",20,1,33,0)="VistA. This problem appears to be related with VistALink. Try again. If"
^DIC(9.4,134,22,17,"PAH",20,1,34,0)="this problem persists contact the support desk for further assistance."""
^DIC(9.4,134,22,17,"PAH",20,1,35,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,36,0)="4. Edit a ROC, Notification tab, when user tries to look up an Employee "
^DIC(9.4,134,22,17,"PAH",20,1,37,0)="to send a notification. Without the patch, the users receive the "
^DIC(9.4,134,22,17,"PAH",20,1,38,0)="error: ""A problem was encountered while attempting to communicate with "
^DIC(9.4,134,22,17,"PAH",20,1,39,0)="VistA. This problem appears to be related with VistALink. Try again. If"
^DIC(9.4,134,22,17,"PAH",20,1,40,0)="this problem persists contact the support desk for further assistance."""
^DIC(9.4,134,22,17,"PAH",20,1,41,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,42,0)="The fix is to use the Kernel routine $$SYMENC^MXMLUTL in routine QACVEMPX"
^DIC(9.4,134,22,17,"PAH",20,1,43,0)="to replace reserved xml symbols in the TITLE and MAIL CODE output with"
^DIC(9.4,134,22,17,"PAH",20,1,44,0)="their coded values."
^DIC(9.4,134,22,17,"PAH",20,1,45,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,46,0)="Problem #2"
^DIC(9.4,134,22,17,"PAH",20,1,47,0)="----------"
^DIC(9.4,134,22,17,"PAH",20,1,48,0)="The NEW PERSON file may contain last names standardized under an old "
^DIC(9.4,134,22,17,"PAH",20,1,49,0)="format that removed all punctuation except for hyphens, and last names "
^DIC(9.4,134,22,17,"PAH",20,1,50,0)="standardized under a newer format that also leaves spaces and apostrophes "
^DIC(9.4,134,22,17,"PAH",20,1,51,0)="in the last name. Thus you may find names like O'BRIEN as well as OBRIEN."
^DIC(9.4,134,22,17,"PAH",20,1,52,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,53,0)="When a user enters O'Brien as a lookup value, PATS was only using the old "
^DIC(9.4,134,22,17,"PAH",20,1,54,0)="name standardization, so was only finding matches to the last name "
^DIC(9.4,134,22,17,"PAH",20,1,55,0)="OBRIEN, but was not finding O'BRIEN."
^DIC(9.4,134,22,17,"PAH",20,1,56,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,57,0)="This occurs in two different places in PATS."
^DIC(9.4,134,22,17,"PAH",20,1,58,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,59,0)="1. Edit a ROC, Resolution tab, adding a new Issue Code, when user tries to"
^DIC(9.4,134,22,17,"PAH",20,1,60,0)="look up an Employee Involved."
^DIC(9.4,134,22,17,"PAH",20,1,61,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,62,0)="2. Edit a ROC, Notification tab, when user tries to look up an Employee "
^DIC(9.4,134,22,17,"PAH",20,1,63,0)="to send a notification."
^DIC(9.4,134,22,17,"PAH",20,1,64,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,65,0)="After the patch is installed, if a user enters a last name containing"
^DIC(9.4,134,22,17,"PAH",20,1,66,0)="either an apostrophe or a space, PATS will look for matches to the name"
^DIC(9.4,134,22,17,"PAH",20,1,67,0)="both with and without the apostrophe or space. Thus, if a user enters"
^DIC(9.4,134,22,17,"PAH",20,1,68,0)="O'Brien, PATS will find names matching both O'BRIEN and OBRIEN, if there"
^DIC(9.4,134,22,17,"PAH",20,1,69,0)="are any."
^DIC(9.4,134,22,17,"PAH",20,1,70,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,71,0)="ASSOCIATED NOIS:"
^DIC(9.4,134,22,17,"PAH",20,1,72,0)=" ==============="
^DIC(9.4,134,22,17,"PAH",20,1,73,0)=" Remedy: HD0000000200638"
^DIC(9.4,134,22,17,"PAH",20,1,74,0)=" Remedy: HD0000000202881"
