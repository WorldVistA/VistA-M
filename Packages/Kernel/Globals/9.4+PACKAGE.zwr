^DIC(9.4,4,22,1,"PAH",32,1,7,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",32,1,8,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,9,0)=" All sites should load this patch regardless of their operating system."
^DIC(9.4,4,22,1,"PAH",32,1,10,0)=" This patch is primarily for support of MSM-NT version 4.3 and OpenM-NT"
^DIC(9.4,4,22,1,"PAH",32,1,11,0)=" NextGen 2.0."
^DIC(9.4,4,22,1,"PAH",32,1,12,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,13,0)=" This patch should be installed during off-peak hours when network mail"
^DIC(9.4,4,22,1,"PAH",32,1,14,0)=" activity is low. This patch can be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",32,1,15,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",32,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,17,0)="DEFINITIONS:"
^DIC(9.4,4,22,1,"PAH",32,1,18,0)="      AXP = Dec AXP system running DSM on VMS"
^DIC(9.4,4,22,1,"PAH",32,1,19,0)="      MSM = PC running MSM on DOS"
^DIC(9.4,4,22,1,"PAH",32,1,20,0)="      MSM-NT = PC running MSM on NT Version 4.3"
^DIC(9.4,4,22,1,"PAH",32,1,21,0)="      OpenM-NT = Dec ALPHA or PC running OpenM NextGen 2.0 or Cache on NT."
^DIC(9.4,4,22,1,"PAH",32,1,22,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,23,0)="INSTALL INSTRUCTIONS:"
^DIC(9.4,4,22,1,"PAH",32,1,24,0)="AXP:  Some of these routines might be mapped, so you will need to disable"
^DIC(9.4,4,22,1,"PAH",32,1,25,0)="      mapping for the affected routines."
^DIC(9.4,4,22,1,"PAH",32,1,26,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,27,0)="MSM-NT: Where TCP/IP Mail is running, kill the Mail listener. In the Manager"
^DIC(9.4,4,22,1,"PAH",32,1,28,0)="      account D ^KILLJOB and kill the job who's routine name is XMRINETD."
^DIC(9.4,4,22,1,"PAH",32,1,29,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,30,0)="OpenM-NT: Where TCP/IP Mail is running, kill the Mail listener.  In the"
^DIC(9.4,4,22,1,"PAH",32,1,31,0)="      Manager account D ^RESJOB and kill the job who's routine name is XMRONT"
^DIC(9.4,4,22,1,"PAH",32,1,32,0)="      or it may be %ZISTCP, in either case it will own device |TCP|25."
^DIC(9.4,4,22,1,"PAH",32,1,33,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,34,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",32,1,35,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,4,22,1,"PAH",32,1,36,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",32,1,37,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,4,22,1,"PAH",32,1,38,0)="      global."
^DIC(9.4,4,22,1,"PAH",32,1,39,0)="  3.  Users can remain on the system. This patch can be queued and installed"
^DIC(9.4,4,22,1,"PAH",32,1,40,0)="      at any time.  TaskMan can remain running."
^DIC(9.4,4,22,1,"PAH",32,1,41,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",32,1,42,0)="      options:"
^DIC(9.4,4,22,1,"PAH",32,1,43,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",32,1,44,0)="         3  Print Transport Global"
^DIC(9.4,4,22,1,"PAH",32,1,45,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",32,1,46,0)="         5  Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",32,1,47,0)="         6  Install Package(s)"
^DIC(9.4,4,22,1,"PAH",32,1,48,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,49,0)="MSM:  Answer YES to the question 'Want to MOVE routines to other CPUs?'."
^DIC(9.4,4,22,1,"PAH",32,1,50,0)="      Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",32,1,51,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,52,0)="AXP:  After patch has been installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",32,1,53,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,54,0)="      ***AXP and MSM sites are done with the installation.***"
^DIC(9.4,4,22,1,"PAH",32,1,55,0)="      ***The rest of the install is for OpenM-NT and MSM-NT.***"
^DIC(9.4,4,22,1,"PAH",32,1,56,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,57,0)="OpenM-NT: In the Production account job the Mail listener, J ^XMRONT."
^DIC(9.4,4,22,1,"PAH",32,1,58,0)="      Also, schedule the option XMRONT to start everytime the system is"
^DIC(9.4,4,22,1,"PAH",32,1,59,0)="      rebooted.  Do the following from the EVE menu:"
^DIC(9.4,4,22,1,"PAH",32,1,60,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,61,0)="      Select Systems Manager Menu Option: Taskman Management"
^DIC(9.4,4,22,1,"PAH",32,1,62,0)="                                          =================="
^DIC(9.4,4,22,1,"PAH",32,1,63,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,64,0)="      Select Taskman Management Option: Schedule/Unschedule Options"
^DIC(9.4,4,22,1,"PAH",32,1,65,0)="                                        ==========================="
^DIC(9.4,4,22,1,"PAH",32,1,66,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,67,0)="      Select OPTION to schedule or reschedule: XMRONT Start XMRONT TCP Listener"
^DIC(9.4,4,22,1,"PAH",32,1,68,0)="                                               ======"
^DIC(9.4,4,22,1,"PAH",32,1,69,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,70,0)="                          Edit Option Schedule"
^DIC(9.4,4,22,1,"PAH",32,1,71,0)="    Option Name: XMRONT                        "
^DIC(9.4,4,22,1,"PAH",32,1,72,0)="    Menu Text: Start XMRONT TCP Listener                 TASK ID:"
^DIC(9.4,4,22,1,"PAH",32,1,73,0)="  __________________________________________________________________________"
^DIC(9.4,4,22,1,"PAH",32,1,74,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,75,0)="   QUEUED TO RUN AT WHAT TIME: <return>"
^DIC(9.4,4,22,1,"PAH",32,1,76,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,77,0)=" DEVICE FOR QUEUED JOB OUTPUT: <return>                      "
^DIC(9.4,4,22,1,"PAH",32,1,78,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,79,0)=" Q UEUED TO RUN ON VOLUME SET: <return>  "
^DIC(9.4,4,22,1,"PAH",32,1,80,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,81,0)="       RESCHEDULING FREQUENCY: <return>                      "
^DIC(9.4,4,22,1,"PAH",32,1,82,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,83,0)="              TASK PARAMETERS: <return>                                        "
^DIC(9.4,4,22,1,"PAH",32,1,84,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,85,0)="             SPECIAL QUEUEING: STARTUP  "
^DIC(9.4,4,22,1,"PAH",32,1,86,0)="                               ======="
^DIC(9.4,4,22,1,"PAH",32,1,87,0)="_______________________________________________________________________________"
^DIC(9.4,4,22,1,"PAH",32,1,88,0)="This field is only for special jobs that need to start every time the"
^DIC(9.4,4,22,1,"PAH",32,1,89,0)="system is rebooted."
^DIC(9.4,4,22,1,"PAH",32,1,90,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,91,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,92,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,93,0)="MSM-NT: In your Manager account of your do the following:"
^DIC(9.4,4,22,1,"PAH",32,1,94,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,95,0)="      Do ^SYSGEN"
^DIC(9.4,4,22,1,"PAH",32,1,96,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,97,0)="      Select Option: 3 - Edit Configuration Parameters"
^DIC(9.4,4,22,1,"PAH",32,1,98,0)="       "
^DIC(9.4,4,22,1,"PAH",32,1,99,0)="      Select Configuration <ROU>:"
^DIC(9.4,4,22,1,"PAH",32,1,100,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,101,0)="      Select Option: 15 - Network Configuration"
^DIC(9.4,4,22,1,"PAH",32,1,102,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,103,0)="      Select Option: 12 - User-Defined Services"
^DIC(9.4,4,22,1,"PAH",32,1,104,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,105,0)=" Current User-Defined Services: "
^DIC(9.4,4,22,1,"PAH",32,1,106,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,107,0)=" Index  Name          Protocol  Port   Password  Psize  Start  UCI      Routine"
^DIC(9.4,4,22,1,"PAH",32,1,108,0)=" -----  ------------  --------  -----  --------  -----  -----  -------  -------"
^DIC(9.4,4,22,1,"PAH",32,1,109,0)="  1     MSMRVG        TCPIP     33086  MSMRVG                        BEG^WSAGENT"
^DIC(9.4,4,22,1,"PAH",32,1,110,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,111,0)=" Enter Service Index: 2"
^DIC(9.4,4,22,1,"PAH",32,1,112,0)=" Enter Service Name: MAIL"
^DIC(9.4,4,22,1,"PAH",32,1,113,0)=" Enter Routine Reference: SOC25^XMRMSM"
^DIC(9.4,4,22,1,"PAH",32,1,114,0)=" Select UCI: VAH,ROU"
^DIC(9.4,4,22,1,"PAH",32,1,115,0)=" Enter Partition Size <40>:"
^DIC(9.4,4,22,1,"PAH",32,1,116,0)=" Enter Password: "
^DIC(9.4,4,22,1,"PAH",32,1,117,0)=" Enter TCPIP Port Number: 25"
^DIC(9.4,4,22,1,"PAH",32,1,118,0)=" Autostart?: Y"
^DIC(9.4,4,22,1,"PAH",32,1,119,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,120,0)=" Now you must remove the old Automatic Partition Startup entry for the Mail"
^DIC(9.4,4,22,1,"PAH",32,1,121,0)=" listener,  who's Entry reference is ^XMRINETD. Reboot the MSM-NT box."
^DIC(9.4,4,22,1,"PAH",32,1,122,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,123,0)="===========================================================================  "
^DIC(9.4,4,22,1,"PAH",32,1,124,0)="  "
^DIC(9.4,4,22,1,"PAH",32,1,125,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",32,1,126,0)="   Checksums were calculated using CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",32,1,127,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",32,1,128,0)=""
^DIC(9.4,4,22,1,"PAH",32,1,129,0)="                 Checksum"
^DIC(9.4,4,22,1,"PAH",32,1,130,0)="Routine         Old       New      2nd Line"
^DIC(9.4,4,22,1,"PAH",32,1,131,0)="XMLTCP        2446407   2573202    **8,27,61**"
^DIC(9.4,4,22,1,"PAH",32,1,132,0)="XMRMSM         400263    326967    **61**"
^DIC(9.4,4,22,1,"PAH",32,1,133,0)="XMRONT           new     598867    **61**"
^DIC(9.4,4,22,1,"PAH",32,1,134,0)="XMRPCTS       4760679   4755631    **6,11,31,61**"
^DIC(9.4,4,22,1,"PAH",32,1,135,0)="XMRPCTSA      3483840   3490824    **6,31,61**"
^DIC(9.4,4,22,1,"PAH",32,1,136,0)=""
^DIC(9.4,4,22,1,"PAH",32,1,137,0)="Callable entry points in new routines"
^DIC(9.4,4,22,1,"PAH",32,1,138,0)="XMRONT   none"
^DIC(9.4,4,22,1,"PAH",32,1,139,0)=" "
^DIC(9.4,4,22,1,"PAH",32,1,140,0)="===========================================================================  "
^DIC(9.4,4,22,1,"PAH",32,1,141,0)="  "
^DIC(9.4,4,22,1,"PAH",32,1,142,0)=" OPTION:"
^DIC(9.4,4,22,1,"PAH",32,1,143,0)="NAME: XMRONT                            MENU TEXT: Start XMRONT TCP Listener"
^DIC(9.4,4,22,1,"PAH",32,1,144,0)=" This is the TCP/IP Listener for MailMan. This option should NOT"
^DIC(9.4,4,22,1,"PAH",32,1,145,0)=" be on any Menu and should NOT be run directly. It must be schedule to start "
^DIC(9.4,4,22,1,"PAH",32,1,146,0)=" every time the system is rebooted. You can schedule this option by using the"
^DIC(9.4,4,22,1,"PAH",32,1,147,0)=" 'Schedule/Unschedule Options' option under the 'Taskman Management' menu. You"
^DIC(9.4,4,22,1,"PAH",32,1,148,0)=" must specify the option XMRONT and then enter 'STARTUP' in the SPECIAL QUEUING"
^DIC(9.4,4,22,1,"PAH",32,1,149,0)=" field."
^DIC(9.4,4,22,1,"PAH",32,1,150,0)="  ROUTINE: XMRONT                       SCHEDULING RECOMMENDED: YES"
^DIC(9.4,4,22,1,"PAH",33,0)="62 SEQ #56^2980511^1"
^DIC(9.4,4,22,1,"PAH",33,1,0)="^^37^37^2980511"
^DIC(9.4,4,22,1,"PAH",33,1,1,0)="MailMan patch XM*7.1*59 addresses NOIS CMH-0398-N2220."
^DIC(9.4,4,22,1,"PAH",33,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",33,1,3,0)="Messages intended to be sent to or via a certain domain may unintentionally"
^DIC(9.4,4,22,1,"PAH",33,1,4,0)="be sent via another domain.  This patch fixes this problem."
^DIC(9.4,4,22,1,"PAH",33,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",33,1,6,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",33,1,7,0)="This patch should be installed after-hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",33,1,8,0)="minimum.  You should put the XMUSER option out of order. The filers should"
^DIC(9.4,4,22,1,"PAH",33,1,9,0)="be shut down."
^DIC(9.4,4,22,1,"PAH",33,1,10,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",33,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",33,1,12,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",33,1,13,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",33,1,14,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",33,1,15,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",33,1,16,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",33,1,17,0)="3.  On the KIDS:Installation menu, use the following options to install the "
^DIC(9.4,4,22,1,"PAH",33,1,18,0)="    Transport Global: "
^DIC(9.4,4,22,1,"PAH",33,1,19,0)="       Verify Checksums in Transport Global "
^DIC(9.4,4,22,1,"PAH",33,1,20,0)="       Print Transport Global "
^DIC(9.4,4,22,1,"PAH",33,1,21,0)="       Compare Transport Global to Current System "
^DIC(9.4,4,22,1,"PAH",33,1,22,0)="       Backup a Transport Global "
^DIC(9.4,4,22,1,"PAH",33,1,23,0)="       Install Package(s) "
^DIC(9.4,4,22,1,"PAH",33,1,24,0)="4.  DSM Sites: After patch has installed, rebuild your map set.  "
^DIC(9.4,4,22,1,"PAH",33,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",33,1,26,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",33,1,27,0)="  "
^DIC(9.4,4,22,1,"PAH",33,1,28,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",33,1,29,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",33,1,30,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",33,1,31,0)=" "
^DIC(9.4,4,22,1,"PAH",33,1,32,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",33,1,33,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",33,1,34,0)="-------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",33,1,35,0)="XMR0B          9580242         9564128        4,6,13,34,42,62"
^DIC(9.4,4,22,1,"PAH",33,1,36,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",33,1,37,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",34,0)="59 SEQ #58^2980527^1"
^DIC(9.4,4,22,1,"PAH",34,1,0)="^^57^57^2980527"
^DIC(9.4,4,22,1,"PAH",34,1,1,0)="MailMan patch XM*7.1*59 addresses problems caused during remote transmission"
^DIC(9.4,4,22,1,"PAH",34,1,2,0)="when a message's 'from' address contains illegal characters."
^DIC(9.4,4,22,1,"PAH",34,1,3,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,4,0)="This patch only addresses locally originating messages which are sent to"
^DIC(9.4,4,22,1,"PAH",34,1,5,0)="remote sites."
^DIC(9.4,4,22,1,"PAH",34,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,7,0)="As the message is being transmitted to the remote site, MailMan examines"
^DIC(9.4,4,22,1,"PAH",34,1,8,0)="the 'from' string."
^DIC(9.4,4,22,1,"PAH",34,1,9,0)="If the 'from' string is enclosed in ""<>"", the ""<>"" are stripped off."
^DIC(9.4,4,22,1,"PAH",34,1,10,0)="If the 'from' string contains illegal characters, the 'from' string will be"
^DIC(9.4,4,22,1,"PAH",34,1,11,0)="enclosed in quotes."
^DIC(9.4,4,22,1,"PAH",34,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,13,0)="The local site will not see the change in the 'from' string."
^DIC(9.4,4,22,1,"PAH",34,1,14,0)="The receiving site will see the change."
^DIC(9.4,4,22,1,"PAH",34,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,16,0)="For example:"
^DIC(9.4,4,22,1,"PAH",34,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,18,0)="'National Patch Module'     will become     '""National Patch Module""'"
^DIC(9.4,4,22,1,"PAH",34,1,19,0)="'<Patient Feedback Pkg>'    will become     '""Patient Feedback Pkg""'"
^DIC(9.4,4,22,1,"PAH",34,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,21,0)="Messages from users will continue to be treated as usual.  That is, if the"
^DIC(9.4,4,22,1,"PAH",34,1,22,0)="user's name contains ',' or ' ', all ', .' will become '._+'."
^DIC(9.4,4,22,1,"PAH",34,1,23,0)="If the user's name contains any other illegal characters, such as '()',"
^DIC(9.4,4,22,1,"PAH",34,1,24,0)="the entire user's name will be enclosed in quotes."
^DIC(9.4,4,22,1,"PAH",34,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,26,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",34,1,27,0)="This patch should be installed after-hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",34,1,28,0)="minimum.  You should put the XMUSER option out of order. The filers should"
^DIC(9.4,4,22,1,"PAH",34,1,29,0)="be shut down."
^DIC(9.4,4,22,1,"PAH",34,1,30,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",34,1,31,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,32,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",34,1,33,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",34,1,34,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",34,1,35,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",34,1,36,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",34,1,37,0)="3.  On the KIDS:Installation menu, use the following options to install the "
^DIC(9.4,4,22,1,"PAH",34,1,38,0)="    Transport Global: "
^DIC(9.4,4,22,1,"PAH",34,1,39,0)="       Verify Checksums in Transport Global "
^DIC(9.4,4,22,1,"PAH",34,1,40,0)="       Print Transport Global "
^DIC(9.4,4,22,1,"PAH",34,1,41,0)="       Compare Transport Global to Current System "
^DIC(9.4,4,22,1,"PAH",34,1,42,0)="       Backup a Transport Global "
^DIC(9.4,4,22,1,"PAH",34,1,43,0)="       Install Package(s) "
^DIC(9.4,4,22,1,"PAH",34,1,44,0)="4.  DSM Sites: After patch has installed, rebuild your map set.  "
^DIC(9.4,4,22,1,"PAH",34,1,45,0)=""
^DIC(9.4,4,22,1,"PAH",34,1,46,0)="============================================================================ "
