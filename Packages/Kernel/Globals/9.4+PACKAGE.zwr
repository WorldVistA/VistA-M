^DIC(9.4,73,0)="NETWORK HEALTH EXCHANGE^AFJX^Requests Total and Pharmacy Health Summary Data"
^DIC(9.4,73,1,0)="^^6^6^2960112^^^^"
^DIC(9.4,73,1,1,0)="The Network Health Exchange Software Package allows individual"
^DIC(9.4,73,1,2,0)="sites in a network area to request total and/or pharmacy"
^DIC(9.4,73,1,3,0)="health summarys (complete or last 12 months of data) via a"
^DIC(9.4,73,1,4,0)="server that will return the data from the facility, and set an"
^DIC(9.4,73,1,5,0)="alert that allows the user to print the information received"
^DIC(9.4,73,1,6,0)="from the sending site."
^DIC(9.4,73,4,0)="^9.44PA^5^4"
