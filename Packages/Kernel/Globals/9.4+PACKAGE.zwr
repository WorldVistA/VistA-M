^DIC(9.4,3,22,21,"PAH",52,1,0)="^^108^108^2980408"
^DIC(9.4,3,22,21,"PAH",52,1,1,0)="Prerequisites:"
^DIC(9.4,3,22,21,"PAH",52,1,2,0)="=========== "
^DIC(9.4,3,22,21,"PAH",52,1,3,0)="     The following patches must be installed before this patch: 44"
^DIC(9.4,3,22,21,"PAH",52,1,4,0)=" "
