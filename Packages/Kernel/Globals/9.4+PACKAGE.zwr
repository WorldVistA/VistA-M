^DIC(9.4,4,22,2,"PAH",19,1,4,0)="Test Site: Tampa, FL"
^DIC(9.4,4,22,2,"PAH",19,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",19,1,6,0)="Currently if you want to create a message and set a date for it to vaporize,"
^DIC(9.4,4,22,2,"PAH",19,1,7,0)="the earliest allowable vaporize date is the next day.  This patch changes"
^DIC(9.4,4,22,2,"PAH",19,1,8,0)="the earliest vaporize date to 60 minutes from now."
^DIC(9.4,4,22,2,"PAH",19,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",19,1,10,0)="NOTE: This patch should be installed during off hours, when user activity is"
^DIC(9.4,4,22,2,"PAH",19,1,11,0)="at a minimum.  It has no requirements, except that MailMan 8.0 be installed."
