^DIC(9.4,151,22,1,"PAH",111,1,3,0)=" 2. Remove Files (#720) and (#720.2) flagged for deletion in EC*2*5."
^DIC(9.4,151,22,1,"PAH",111,1,4,0)=" 3. An active DSS Unit with inactive Event Code Screens is presented as"
^DIC(9.4,151,22,1,"PAH",111,1,5,0)="    selectable in ECS GUI data entry."
