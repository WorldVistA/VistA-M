^DIC(9.4,4,22,1,"PAH",51,1,3,0)="NOIS: FGH-0899-30616"
^DIC(9.4,4,22,1,"PAH",51,1,4,0)="Test Site:  NORTH FLORIDA/SOUTH GEORGIA"
^DIC(9.4,4,22,1,"PAH",51,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",51,1,6,0)="During the AI xref purge, MailMan aborts if any AI xref is improperly"
^DIC(9.4,4,22,1,"PAH",51,1,7,0)="formed.  This patch changes the code to recognize and kill any improperly"
^DIC(9.4,4,22,1,"PAH",51,1,8,0)="formed AI xrefs."
^DIC(9.4,4,22,1,"PAH",51,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",51,1,10,0)="NOTE: This patch may be installed at any time.  It requires MailMan patch"
^DIC(9.4,4,22,1,"PAH",51,1,11,0)="XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",51,1,12,0)="============================================================================ "
