^DIC(9.4,154,0)="EQUIPMENT/TURN-IN REQUEST^PRCN^EQUIPMENT/TURN-IN REQUEST"
^DIC(9.4,154,1,0)="^^3^3^2960507^^^^"
^DIC(9.4,154,1,1,0)="This module allows for the request and approval of non-"
^DIC(9.4,154,1,2,0)="expendable equipment and for the turn-in on non-expendable"
^DIC(9.4,154,1,3,0)="equipment."
^DIC(9.4,154,20,0)="^9.402P^^"
^DIC(9.4,154,22,0)="^9.49I^1^1"
^DIC(9.4,154,22,1,0)="1.0^3051119^2961016^1"
^DIC(9.4,154,22,1,1,0)="^^1^1^3051119"
^DIC(9.4,154,22,1,1,1,0)="The Equipment/Turn-In Request module."
^DIC(9.4,154,22,1,"PAH",0)="^9.4901^15^15"
^DIC(9.4,154,22,1,"PAH",1,0)="1^2970122^1"
^DIC(9.4,154,22,1,"PAH",2,0)="2^2970312^1"
^DIC(9.4,154,22,1,"PAH",3,0)="3^2970528^1"
^DIC(9.4,154,22,1,"PAH",4,0)="6 SEQ #4^2990719^1"
^DIC(9.4,154,22,1,"PAH",4,1,0)="^^2^2^2990719"
^DIC(9.4,154,22,1,"PAH",4,1,1,0)="This patch will correct an undefined variable error that is produced when "
^DIC(9.4,154,22,1,"PAH",4,1,2,0)="making a call to Fileman v22."
^DIC(9.4,154,22,1,"PAH",5,0)="5 SEQ #5^3000626^1"
^DIC(9.4,154,22,1,"PAH",5,1,0)="^^26^26^3000626"
^DIC(9.4,154,22,1,"PAH",5,1,1,0)="This patch addresses undefined variable errors in the Equipment/Turn-In "
^DIC(9.4,154,22,1,"PAH",5,1,2,0)="Request package.  The following NOIS are addreessed by this patch."
^DIC(9.4,154,22,1,"PAH",5,1,3,0)=""
^DIC(9.4,154,22,1,"PAH",5,1,4,0)="1.             REN-0497-60517"
^DIC(9.4,154,22,1,"PAH",5,1,5,0)=""
^DIC(9.4,154,22,1,"PAH",5,1,6,0)="When a priority is placed on a new equipment request by a CMR Official and "
^DIC(9.4,154,22,1,"PAH",5,1,7,0)="the request is sent to PPM for review, during the review process PPM will "
^DIC(9.4,154,22,1,"PAH",5,1,8,0)="answer NO to the IS THIS NX EQUIPMENT prompt, they then enter a reason why "
^DIC(9.4,154,22,1,"PAH",5,1,9,0)="this is not NX equipment.  Immediately following this, an undefined error "
^DIC(9.4,154,22,1,"PAH",5,1,10,0)="occurs."
^DIC(9.4,154,22,1,"PAH",5,1,11,0)=""
^DIC(9.4,154,22,1,"PAH",5,1,12,0)="2.             NAS-0697-31502"
^DIC(9.4,154,22,1,"PAH",5,1,13,0)=""
^DIC(9.4,154,22,1,"PAH",5,1,14,0)="When a request for replacement equipment is edited and the quantity is "
^DIC(9.4,154,22,1,"PAH",5,1,15,0)="increased the user is asked to enter the replacement equipment for the line "
^DIC(9.4,154,22,1,"PAH",5,1,16,0)="item they choose, after the item is entered the program fails with an "
^DIC(9.4,154,22,1,"PAH",5,1,17,0)="undefined variable."
^DIC(9.4,154,22,1,"PAH",5,1,18,0)=""
^DIC(9.4,154,22,1,"PAH",5,1,19,0)="3.             MEM-0697-70758"
^DIC(9.4,154,22,1,"PAH",5,1,20,0)=""
^DIC(9.4,154,22,1,"PAH",5,1,21,0)="When a request is sent to Engineering and the request is updated to include "
^DIC(9.4,154,22,1,"PAH",5,1,22,0)="training, a vendor must be entered into the ENG. TRAINING VENDOR (#55) "
^DIC(9.4,154,22,1,"PAH",5,1,23,0)="field, when this is done the program attempts to find that vendor in the "
^DIC(9.4,154,22,1,"PAH",5,1,24,0)="VENDOR (#440) file and stuff the pointer into the ENG TRAIN VENDOR PTR "
^DIC(9.4,154,22,1,"PAH",5,1,25,0)="(#55.5) field.  The lookup was being done in the wrong file so an undefined "
^DIC(9.4,154,22,1,"PAH",5,1,26,0)="error would occur each time the lookup tried to reconcile the vendor."
^DIC(9.4,154,22,1,"PAH",6,0)="7 SEQ #6^3001004^1"
^DIC(9.4,154,22,1,"PAH",6,1,0)="^^12^12^3001004"
^DIC(9.4,154,22,1,"PAH",6,1,1,0)="This patch addresses a problem when printing the PRCN NX SERVICE REPORT.  "
^DIC(9.4,154,22,1,"PAH",6,1,2,0)="The following NOIS is addressed by this patch."
^DIC(9.4,154,22,1,"PAH",6,1,3,0)=" "
^DIC(9.4,154,22,1,"PAH",6,1,4,0)="1.             MIW-0497-42110"
^DIC(9.4,154,22,1,"PAH",6,1,5,0)=" "
^DIC(9.4,154,22,1,"PAH",6,1,6,0)="When printing the Service Priority Report [PRCN NX SERVICE REPORT] to a "
^DIC(9.4,154,22,1,"PAH",6,1,7,0)="printer, and the report is greater than one page in length, the report "
^DIC(9.4,154,22,1,"PAH",6,1,8,0)="stops at page one.  Printing the report to the screen functions properly."
^DIC(9.4,154,22,1,"PAH",6,1,9,0)=" "
^DIC(9.4,154,22,1,"PAH",6,1,10,0)="A problem was uncovered during testing of this patch that has been "
^DIC(9.4,154,22,1,"PAH",6,1,11,0)="addressed.  When asked to enter O for one service and a lowercase o was "
^DIC(9.4,154,22,1,"PAH",6,1,12,0)="entered it was ignored and all services printed."
^DIC(9.4,154,22,1,"PAH",7,0)="9 SEQ #8^3010625^1"
^DIC(9.4,154,22,1,"PAH",7,1,0)="^^1^1^3010625"
^DIC(9.4,154,22,1,"PAH",7,1,1,0)="Extract Equipment Turn-In user counts by role."
^DIC(9.4,154,22,1,"PAH",8,0)="10 SEQ #9^3020516^1"
^DIC(9.4,154,22,1,"PAH",8,1,0)="^^1^1^3020516"
^DIC(9.4,154,22,1,"PAH",8,1,1,0)="This patch will stop the undefined error occurring in routine PRCNPPM."
^DIC(9.4,154,22,1,"PAH",9,0)="11 SEQ #10^3030123^1"
^DIC(9.4,154,22,1,"PAH",9,1,0)="^^12^12^3030123"
^DIC(9.4,154,22,1,"PAH",9,1,1,0)="This patch addresses several issues. The first issue is the option"
^DIC(9.4,154,22,1,"PAH",9,1,2,0)="Create 2237 (PPM) [PRCN NX PPM 2237] is failing to set the transaction"
^DIC(9.4,154,22,1,"PAH",9,1,3,0)="number items when the 2237 is being created. The second issue is an"
^DIC(9.4,154,22,1,"PAH",9,1,4,0)="undefined error which occurs in routine PRCNREQE when running the"
^DIC(9.4,154,22,1,"PAH",9,1,5,0)="option Edit Equipment Requests (PPM) [PRCN NX PPM EDIT]. The third"
^DIC(9.4,154,22,1,"PAH",9,1,6,0)="issue is a null subscript error which logs at routine PRCNOTHR when a"
^DIC(9.4,154,22,1,"PAH",9,1,7,0)="user uses the option Review Equipment Requests (Concurring Official)"
^DIC(9.4,154,22,1,"PAH",9,1,8,0)="[PRCN NX CONCUR] to select an equipment request transaction which"
^DIC(9.4,154,22,1,"PAH",9,1,9,0)="is not set up for him to review. The last issue is an undefined error"
^DIC(9.4,154,22,1,"PAH",9,1,10,0)="at routine PRCNTIRQ when a user performs an up-arrow exit out of the list"
^DIC(9.4,154,22,1,"PAH",9,1,11,0)="of items in a request while using the option Edit Equipment Turn-In"
^DIC(9.4,154,22,1,"PAH",9,1,12,0)="Request [PRCN TURN EDIT]."
^DIC(9.4,154,22,1,"PAH",10,0)="12 SEQ #11^3030802^1"
^DIC(9.4,154,22,1,"PAH",10,1,0)="^^5^5^3030802"
^DIC(9.4,154,22,1,"PAH",10,1,1,0)="This patch addresses 3 issues. The first problem occurs when using the "
^DIC(9.4,154,22,1,"PAH",10,1,2,0)="option Enter New New Equipment Requests [PRCN NX NEW]. The second problem"
^DIC(9.4,154,22,1,"PAH",10,1,3,0)="is an undefined error that occurs when editing replacement information. "
^DIC(9.4,154,22,1,"PAH",10,1,4,0)="The third problem is an undefined error occurring when requests are "
^DIC(9.4,154,22,1,"PAH",10,1,5,0)="processed in the option Create 2237 (PPM) [PRCN NX PPM 2237]."
^DIC(9.4,154,22,1,"PAH",11,0)="13 SEQ #12^3031107^1"
^DIC(9.4,154,22,1,"PAH",11,1,0)="^^2^2^3031107"
^DIC(9.4,154,22,1,"PAH",11,1,1,0)="Users are unable to delete Replacement Items on the Turn-In Requests using"
^DIC(9.4,154,22,1,"PAH",11,1,2,0)="the EDIT EQUIPMENT TURN-IN REQUEST [PRCN TURN EDIT] Option."
^DIC(9.4,154,22,1,"PAH",12,0)="14 SEQ #13^3040427^1"
^DIC(9.4,154,22,1,"PAH",12,1,0)="^^3^3^3040427"
^DIC(9.4,154,22,1,"PAH",12,1,1,0)="This patch addresses one problem with a string too long error at"
^DIC(9.4,154,22,1,"PAH",12,1,2,0)="the routine line CMR+2^PRCNCMR:4 when the user was running the"
^DIC(9.4,154,22,1,"PAH",12,1,3,0)="Approve Equipment Turn-In Request (CMR) [PRCN TURN CMR APP] option."
^DIC(9.4,154,22,1,"PAH",13,0)="15 SEQ #14^3040507^1"
^DIC(9.4,154,22,1,"PAH",13,1,0)="^^1^1^3040507"
^DIC(9.4,154,22,1,"PAH",13,1,1,0)="There are several menu options that are not working as advertised."
^DIC(9.4,154,22,1,"PAH",14,0)="16 SEQ #15^3130522.091615^17"
^DIC(9.4,154,22,1,"PAH",14,1,0)="^^4^4^3130522"
^DIC(9.4,154,22,1,"PAH",14,1,1,0)="Patch PRCN*1.0*16 is a modification of input template [PRCNTIPED] to "
^DIC(9.4,154,22,1,"PAH",14,1,2,0)="allow for the deletion of all Replacement Items. The current template is"
^DIC(9.4,154,22,1,"PAH",14,1,3,0)="only allowing the deletion of the last item within the Edit Turn-in"
^DIC(9.4,154,22,1,"PAH",14,1,4,0)="Transaction (PPM) option."
^DIC(9.4,154,22,1,"PAH",15,0)="17 SEQ #16^3161014.135436^54"
^DIC(9.4,154,22,1,"PAH",15,1,0)="^^1^1^3161014"
^DIC(9.4,154,22,1,"PAH",15,1,1,0)="1. Equipment Request will not update to COMPLETE status"
^DIC(9.4,154,22,1,"PAH","B",1,1)=""
^DIC(9.4,154,22,1,"PAH","B",2,2)=""
^DIC(9.4,154,22,1,"PAH","B",3,3)=""
^DIC(9.4,154,22,1,"PAH","B","10 SEQ #9",8)=""
^DIC(9.4,154,22,1,"PAH","B","11 SEQ #10",9)=""
^DIC(9.4,154,22,1,"PAH","B","12 SEQ #11",10)=""
