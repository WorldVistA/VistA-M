^DIC(9.4,4,22,1,"PAH",83,1,11,0)="The background filer checker is improved.  It now lets you know which message"
^DIC(9.4,4,22,1,"PAH",83,1,12,0)="it is delivering.  Also, for new messages, it lets you know the last person"
^DIC(9.4,4,22,1,"PAH",83,1,13,0)="to whom it was delivered."
^DIC(9.4,4,22,1,"PAH",83,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",83,1,15,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",83,1,16,0)="It requires MailMan patch XM*7.1*92."
