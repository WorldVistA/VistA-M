^DIC(9.4,49,22,10,"PAH",460,1,98,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,99,0)="Defect Tracking System Ticket(s) & Overview"
^DIC(9.4,49,22,10,"PAH",460,1,100,0)="---------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,101,0)="NSD Ticket# I10841525FY16"
^DIC(9.4,49,22,10,"PAH",460,1,102,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,103,0)="Problem:"
^DIC(9.4,49,22,10,"PAH",460,1,104,0)="-------"
^DIC(9.4,49,22,10,"PAH",460,1,105,0)="When testing with FSC, customer reported that they are not able to enter a "
^DIC(9.4,49,22,10,"PAH",460,1,106,0)="professional alternate payer ID on Bill Screen 10 when the charge type is "
^DIC(9.4,49,22,10,"PAH",460,1,107,0)="institutional and the form type is a CMS-1500."
^DIC(9.4,49,22,10,"PAH",460,1,108,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,109,0)="Resolution:"
^DIC(9.4,49,22,10,"PAH",460,1,110,0)="----------"
^DIC(9.4,49,22,10,"PAH",460,1,111,0)="Modified screen 10 to be consistent with the screening logic on"
^DIC(9.4,49,22,10,"PAH",460,1,112,0)="fields #140, #142 & #144 in file #399.  Screen 10 will now use form-type "
^DIC(9.4,49,22,10,"PAH",460,1,113,0)="instead of charge type to determine alternate payer ID."
^DIC(9.4,49,22,10,"PAH",460,1,114,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,115,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,116,0)="Test Sites:"
^DIC(9.4,49,22,10,"PAH",460,1,117,0)="----------"
^DIC(9.4,49,22,10,"PAH",460,1,118,0)="Pittsburgh"
^DIC(9.4,49,22,10,"PAH",460,1,119,0)="South Texas"
^DIC(9.4,49,22,10,"PAH",460,1,120,0)="Northern Indiana"
^DIC(9.4,49,22,10,"PAH",460,1,121,0)="Illiana"
^DIC(9.4,49,22,10,"PAH",460,1,122,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,123,0)="Documentation Retrieval Instructions"
^DIC(9.4,49,22,10,"PAH",460,1,124,0)="------------------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,125,0)="The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,49,22,10,"PAH",460,1,126,0)="This transmits the files from the first available server. Sites may also "
^DIC(9.4,49,22,10,"PAH",460,1,127,0)="elect to retrieve files directly from a specific server."
^DIC(9.4,49,22,10,"PAH",460,1,128,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,129,0)="Sites may retrieve the documentation directly using Secure File Transfer"
^DIC(9.4,49,22,10,"PAH",460,1,130,0)="Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory at the following OI"
^DIC(9.4,49,22,10,"PAH",460,1,131,0)="Field Offices:"
^DIC(9.4,49,22,10,"PAH",460,1,132,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,133,0)="   Albany:                 fo-albany.domain.ext"
^DIC(9.4,49,22,10,"PAH",460,1,134,0)="   Hines:                  fo-hines.domain.ext    "
^DIC(9.4,49,22,10,"PAH",460,1,135,0)="   Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,49,22,10,"PAH",460,1,136,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,137,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,49,22,10,"PAH",460,1,138,0)="at: "
^DIC(9.4,49,22,10,"PAH",460,1,139,0)="http://www.domain.ext/vdl/"
^DIC(9.4,49,22,10,"PAH",460,1,140,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,141,0)="Title                                 File Name            Transfer Mode"
^DIC(9.4,49,22,10,"PAH",460,1,142,0)="--------------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,143,0)="Release Notes/Installation Guide      ib_2_0_p547_rn.pdf   Binary"
^DIC(9.4,49,22,10,"PAH",460,1,144,0)="EDI User Guide                        edi_user_guide.pdf   Binary"
^DIC(9.4,49,22,10,"PAH",460,1,145,0)="Integrated Billing (IB) V.2.0"
^DIC(9.4,49,22,10,"PAH",460,1,146,0)="Technical/Security Manual             ib_2_0_tm.pdf        Binary"
^DIC(9.4,49,22,10,"PAH",460,1,147,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,148,0)="Patch Installation:"
^DIC(9.4,49,22,10,"PAH",460,1,149,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,150,0)="Pre/Post Installation Overview"
^DIC(9.4,49,22,10,"PAH",460,1,151,0)="------------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,152,0)="N/A  "
^DIC(9.4,49,22,10,"PAH",460,1,153,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,154,0)="       "
^DIC(9.4,49,22,10,"PAH",460,1,155,0)="Pre-Installation Instructions"
^DIC(9.4,49,22,10,"PAH",460,1,156,0)="-----------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,157,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,49,22,10,"PAH",460,1,158,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,49,22,10,"PAH",460,1,159,0)="potential disruption to users entering and editing IB claims.  "
^DIC(9.4,49,22,10,"PAH",460,1,160,0)="This patch should take less than 5 minutes to install"
^DIC(9.4,49,22,10,"PAH",460,1,161,0)="       "
^DIC(9.4,49,22,10,"PAH",460,1,162,0)="No options need to be disabled."
^DIC(9.4,49,22,10,"PAH",460,1,163,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,164,0)="Installation Instructions"
^DIC(9.4,49,22,10,"PAH",460,1,165,0)="-------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,166,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,49,22,10,"PAH",460,1,167,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,49,22,10,"PAH",460,1,168,0)="potential disruption to users entering and editing IB claims.  This "
^DIC(9.4,49,22,10,"PAH",460,1,169,0)="patch should take less than 5 minutes to install."
^DIC(9.4,49,22,10,"PAH",460,1,170,0)="           "
^DIC(9.4,49,22,10,"PAH",460,1,171,0)="1.  Choose the PackMan message containing this patch."
^DIC(9.4,49,22,10,"PAH",460,1,172,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,173,0)="2.  Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,49,22,10,"PAH",460,1,174,0)="       "
^DIC(9.4,49,22,10,"PAH",460,1,175,0)="3.  From the Kernel Installation & Distribution System menu, select"
^DIC(9.4,49,22,10,"PAH",460,1,176,0)="    the Installation menu."
^DIC(9.4,49,22,10,"PAH",460,1,177,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,178,0)="    a.  Backup a Transport Global - this option will create a backup"
^DIC(9.4,49,22,10,"PAH",460,1,179,0)="        message of any routines exported with the patch. It will not"
^DIC(9.4,49,22,10,"PAH",460,1,180,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,49,22,10,"PAH",460,1,181,0)="    b.  Compare Transport Global to Current System - this option will"
^DIC(9.4,49,22,10,"PAH",460,1,182,0)="        allow you to view all changes that will be made when the patch "
^DIC(9.4,49,22,10,"PAH",460,1,183,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,49,22,10,"PAH",460,1,184,0)="        (routines, DDs, templates, etc.)."
^DIC(9.4,49,22,10,"PAH",460,1,185,0)="    c.  Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,49,22,10,"PAH",460,1,186,0)="        you to ensure the integrity of the routines that are in"
^DIC(9.4,49,22,10,"PAH",460,1,187,0)="        transport global."
^DIC(9.4,49,22,10,"PAH",460,1,188,0)="         "
^DIC(9.4,49,22,10,"PAH",460,1,189,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,49,22,10,"PAH",460,1,190,0)="    choose the patch to install. (ex. IB*2.0*574)"
^DIC(9.4,49,22,10,"PAH",460,1,191,0)="       "
^DIC(9.4,49,22,10,"PAH",460,1,192,0)="5.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,49,22,10,"PAH",460,1,193,0)="    NO//',  enter NO"
^DIC(9.4,49,22,10,"PAH",460,1,194,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,195,0)="6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,49,22,10,"PAH",460,1,196,0)="    Protocols? NO//,  respond NO"
^DIC(9.4,49,22,10,"PAH",460,1,197,0)="       "
^DIC(9.4,49,22,10,"PAH",460,1,198,0)="7.  When prompted ""DEVICE: HOME//"",  enter HOME"
^DIC(9.4,49,22,10,"PAH",460,1,199,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,200,0)="8.  If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,49,22,10,"PAH",460,1,201,0)="      "
^DIC(9.4,49,22,10,"PAH",460,1,202,0)="       "
^DIC(9.4,49,22,10,"PAH",460,1,203,0)="Post-Installation Instructions"
^DIC(9.4,49,22,10,"PAH",460,1,204,0)="------------------------------"
^DIC(9.4,49,22,10,"PAH",460,1,205,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,206,0)="There are no special post-installation instructions for this patch."
^DIC(9.4,49,22,10,"PAH",460,1,207,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,208,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,209,0)="Routine Information:"
^DIC(9.4,49,22,10,"PAH",460,1,210,0)="===================="
^DIC(9.4,49,22,10,"PAH",461,0)="579 SEQ #534^3161220.153559^54"
^DIC(9.4,49,22,10,"PAH",461,1,0)="^^8^8^3161220"
^DIC(9.4,49,22,10,"PAH",461,1,1,0)="This is a patch for build IB*2.0*549 containing two routines.  Routine "
^DIC(9.4,49,22,10,"PAH",461,1,2,0)="IBCNEUT7 is being modified in the DEATH2 subroutine to also set the "
^DIC(9.4,49,22,10,"PAH",461,1,3,0)="COVERED BY HEALTH INSURANCE field (file 2, field .3192) to 'N' when "
^DIC(9.4,49,22,10,"PAH",461,1,4,0)="terminating all active policies for a deceased patient.  It also contains "
^DIC(9.4,49,22,10,"PAH",461,1,5,0)="a post-installation routine which will change the COVERED BY HEALTH "
^DIC(9.4,49,22,10,"PAH",461,1,6,0)="INSURANCE field for all deceased patients who don't have active patient "
^DIC(9.4,49,22,10,"PAH",461,1,7,0)="policies and the current value of the COVERED BY HEALTH INSURANCE field "
^DIC(9.4,49,22,10,"PAH",461,1,8,0)="IS 'Y'."
^DIC(9.4,49,22,10,"PAH",462,0)="578 SEQ #535^3170123.13581^54"
^DIC(9.4,49,22,10,"PAH",462,1,0)="^^3^3^3170123"
^DIC(9.4,49,22,10,"PAH",462,1,1,0)="This patch will update the administrative charge based on different rate "
^DIC(9.4,49,22,10,"PAH",462,1,2,0)="tyes of new dispensing fees for third party pharmacy prescription claims"
^DIC(9.4,49,22,10,"PAH",462,1,3,0)="with an effective date of January 1st, 2017."
^DIC(9.4,49,22,10,"PAH",463,0)="583^3170123.145631^54"
^DIC(9.4,49,22,10,"PAH",463,1,0)="^^5^5^3170123"
^DIC(9.4,49,22,10,"PAH",463,1,1,0)="This patch, IB*2.0*583, is one of three VistA 2017 threshold patches. It "
^DIC(9.4,49,22,10,"PAH",463,1,2,0)="addresses the annual updates for the Pharmacy Copay Thresholds. Patch "
^DIC(9.4,49,22,10,"PAH",463,1,3,0)="DG*5.3*930 will update the thresholds for the Means Tests and the Maximum"
^DIC(9.4,49,22,10,"PAH",463,1,4,0)="Annual Pension Rate. Patch EAS*1.0*144 will address the annual updates for"
^DIC(9.4,49,22,10,"PAH",463,1,5,0)="the GMT Thresholds."
^DIC(9.4,49,22,10,"PAH",464,0)="584 SEQ #537^3170403.141806^54"
^DIC(9.4,49,22,10,"PAH",464,1,0)="^^1^1^3170403"
^DIC(9.4,49,22,10,"PAH",464,1,1,0)="Reasonable Charges v3.21"
^DIC(9.4,49,22,10,"PAH",465,0)="590 SEQ #538^3170403.154427^54"
^DIC(9.4,49,22,10,"PAH",466,0)="589 SEQ #539^3170403.154526^54"
^DIC(9.4,49,22,10,"PAH",466,1,0)="^^3^3^3170403"
^DIC(9.4,49,22,10,"PAH",466,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes in response to the"
^DIC(9.4,49,22,10,"PAH",466,1,2,0)="Comprehensive Addiction and Recovery Act (CARA) of 2016 and the "
^DIC(9.4,49,22,10,"PAH",466,1,3,0)="Veterans Affairs opioid safety initiative."
^DIC(9.4,49,22,10,"PAH",467,0)="586 SEQ #540^3170403.15541^54"
^DIC(9.4,49,22,10,"PAH",467,1,0)="^^2^2^3170403"
^DIC(9.4,49,22,10,"PAH",467,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes to reflect "
^DIC(9.4,49,22,10,"PAH",467,1,2,0)="Fiscal Mid-Year 2017 changes."
^DIC(9.4,49,22,10,"PAH",468,0)="554 SEQ #541^3170419.121358^54"
^DIC(9.4,49,22,10,"PAH",468,1,0)="^^15^15^3170419"
^DIC(9.4,49,22,10,"PAH",468,1,1,0)="The Chief Business Office (CBO) is requesting system enhancements to the"
^DIC(9.4,49,22,10,"PAH",468,1,2,0)="Veterans Health Information Systems and Technology Architecture (VistA)"
^DIC(9.4,49,22,10,"PAH",468,1,3,0)="Integrated Billing (IB), Accounts Receivable (AR), and Fee Basis software"
^DIC(9.4,49,22,10,"PAH",468,1,4,0)="modules that would allow segregating all billing and collection"
^DIC(9.4,49,22,10,"PAH",468,1,5,0)="activities for Non-Department of Veterans Affairs (VA), Care Third Party"
^DIC(9.4,49,22,10,"PAH",468,1,6,0)="Insurance carriers' reimbursement."
^DIC(9.4,49,22,10,"PAH",468,1,7,0)="Current Medical Care Collections Fund (MCCF) Third Party billing and"
^DIC(9.4,49,22,10,"PAH",468,1,8,0)="collections applications in the VistA information system do not segregate"
^DIC(9.4,49,22,10,"PAH",468,1,9,0)="the Non-VA care claims from those claims for service rendered at Veterans"
^DIC(9.4,49,22,10,"PAH",468,1,10,0)="Health Administration (VHA) healthcare facilities, which makes it"
^DIC(9.4,49,22,10,"PAH",468,1,11,0)="difficult to determine whether all monies due VA for Non-VA care services"
^DIC(9.4,49,22,10,"PAH",468,1,12,0)="are being billed and collected from Third Party insurance carriers, where"
^DIC(9.4,49,22,10,"PAH",468,1,13,0)="applicable.  The current process is a resource intensive, manual process"
^DIC(9.4,49,22,10,"PAH",468,1,14,0)="with no assurance that all applicable Non-VA charges have been billed and"
^DIC(9.4,49,22,10,"PAH",468,1,15,0)="collected."
^DIC(9.4,49,22,10,"PAH",469,0)="587 SEQ #542^3170629.160733^54"
^DIC(9.4,49,22,10,"PAH",469,1,0)="^^3^3^3170629"
^DIC(9.4,49,22,10,"PAH",469,1,1,0)="This patch involves updates to the MCCR UTILITY (#399.1) file, the REVENUE"
^DIC(9.4,49,22,10,"PAH",469,1,2,0)="CODE (#399.2) file, the PLACE OF SERVICE (#353.1) file and the CLAIMS"
^DIC(9.4,49,22,10,"PAH",469,1,3,0)="TRACKING NON-BILLABLE REASONS (#356.8) file for 2017."
^DIC(9.4,49,22,10,"PAH",470,0)="594 SEQ #543^3170706.13372^54"
^DIC(9.4,49,22,10,"PAH",470,1,0)="^^3^3^3170706"
^DIC(9.4,49,22,10,"PAH",470,1,1,0)="This patch will restore functionality to screen 10 of the Enter/Edit"
^DIC(9.4,49,22,10,"PAH",470,1,2,0)="Billing Information option that was accidently removed with the release"
^DIC(9.4,49,22,10,"PAH",470,1,3,0)="of IB*2.0*554."
^DIC(9.4,49,22,10,"PAH",471,0)="582 SEQ #544^3170706.133813^54"
^DIC(9.4,49,22,10,"PAH",472,0)="576 SEQ #545^3170726.162538^54"
^DIC(9.4,49,22,10,"PAH",472,1,0)="^^13^13^3170726"
^DIC(9.4,49,22,10,"PAH",472,1,1,0)="This patch will prevent the Onset of Current Illness date from defaulting "
^DIC(9.4,49,22,10,"PAH",472,1,2,0)="to the Date of Service.  If there is an Occ Code 10 (LMP) on the bill "
^DIC(9.4,49,22,10,"PAH",472,1,3,0)="then the Onset Date should default to the code 10 date.  iF there is an "
^DIC(9.4,49,22,10,"PAH",472,1,4,0)="Occ Code 11 (Onset of illness) on the bill then the Onset date defaults "
^DIC(9.4,49,22,10,"PAH",472,1,5,0)="to the code 11 date.  Code 11 takes priority over code 10, but since "
^DIC(9.4,49,22,10,"PAH",472,1,6,0)="these are not supposed to be on the same bill the following modified "
^DIC(9.4,49,22,10,"PAH",472,1,7,0)="error message will display: 'Occ. codes Onset of Illness (11) and LMP "
^DIC(9.4,49,22,10,"PAH",472,1,8,0)="(10) not allowed on same bill.'  This is the error message for IB Error "
^DIC(9.4,49,22,10,"PAH",472,1,9,0)="'IB099' which is being changed from 'Occ. codes for accident, LMP, "
^DIC(9.4,49,22,10,"PAH",472,1,10,0)="illness not allowed on same bill' to 'Occ. codes Onset of Illness (11) "
^DIC(9.4,49,22,10,"PAH",472,1,11,0)="and LMP (10) not allowed on same bill.'.  This dictionary entry will be "
^DIC(9.4,49,22,10,"PAH",472,1,12,0)="modified, if it exists, via the IBY576PO post-install routine and if the "
^DIC(9.4,49,22,10,"PAH",472,1,13,0)="entry does not exist IBY576PO will create it."
^DIC(9.4,49,22,10,"PAH",473,0)="599 SEQ #546^3170929.162806^54"
^DIC(9.4,49,22,10,"PAH",473,1,0)="^^2^2^3170929"
^DIC(9.4,49,22,10,"PAH",473,1,1,0)="Routine IB20P599 copied from IB20P586 for Stop Code Updates effective "
^DIC(9.4,49,22,10,"PAH",473,1,2,0)="10/1/2017."
^DIC(9.4,49,22,10,"PAH",474,0)="577 SEQ #547^3171102.134452^54"
^DIC(9.4,49,22,10,"PAH",475,0)="593 SEQ #548^3171128.125455^54"
^DIC(9.4,49,22,10,"PAH",476,0)="575 SEQ #549^3171227.162828^54"
^DIC(9.4,49,22,10,"PAH",476,1,0)="^^6^6^3171227"
^DIC(9.4,49,22,10,"PAH",476,1,1,0)="ECME won't submit a claim with a Service-Connected (SC) issue, even"
^DIC(9.4,49,22,10,"PAH",476,1,2,0)="after the user indicates that the issue has been resolved.  Same "
^DIC(9.4,49,22,10,"PAH",476,1,3,0)="issue is reset again and again, with RNB (Reason Not Billed) "
^DIC(9.4,49,22,10,"PAH",476,1,4,0)="message of ""Needs SC Determination"".  This occurs with any of the "
^DIC(9.4,49,22,10,"PAH",476,1,5,0)="possible SC conditions. This patch corrects this issue, and also "
^DIC(9.4,49,22,10,"PAH",476,1,6,0)="updates line 3 with the newer VA Directive reference."
^DIC(9.4,49,22,10,"PAH",477,0)="603 SEQ #550^3171228.120645^54"
^DIC(9.4,49,22,10,"PAH",477,1,0)="^^4^4^3171228"
^DIC(9.4,49,22,10,"PAH",477,1,1,0)="This patch contains one update:"
^DIC(9.4,49,22,10,"PAH",477,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",477,1,3,0)="* 68 Cost Based and Inter-Agency billing rates with an effective date of "
^DIC(9.4,49,22,10,"PAH",477,1,4,0)="  08/29/2017 in the CHARGE ITEM file (#363.2)."
^DIC(9.4,49,22,10,"PAH",478,0)="611^3171228.171639^54"
^DIC(9.4,49,22,10,"PAH",478,1,0)="^^5^5^3171228"
^DIC(9.4,49,22,10,"PAH",478,1,1,0)="Each year, the government sets new values for the Medicare deductible and"
^DIC(9.4,49,22,10,"PAH",478,1,2,0)="for the pension threshold rates. These values need to be updated in the"
^DIC(9.4,49,22,10,"PAH",478,1,3,0)="associated billing files for accurate and legal billing. The purpose of"
^DIC(9.4,49,22,10,"PAH",478,1,4,0)="this patch is to assist sites in the entry of the Basic Pension Threshold"
^DIC(9.4,49,22,10,"PAH",478,1,5,0)="rates and the Medicare Deductible value for Calendar Year 2018."
^DIC(9.4,49,22,10,"PAH",479,0)="600 SEQ #552^3180129.162243^54"
^DIC(9.4,49,22,10,"PAH",479,1,0)="^^1^1^3180129"
^DIC(9.4,49,22,10,"PAH",479,1,1,0)="Reasonable Charges v3.22"
^DIC(9.4,49,22,10,"PAH",480,0)="564 SEQ #553^3180129.165928^54"
^DIC(9.4,49,22,10,"PAH",480,1,0)="^^10^10^3180129"
^DIC(9.4,49,22,10,"PAH",480,1,1,0)="This patch addresses two issues."
^DIC(9.4,49,22,10,"PAH",480,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",480,1,3,0)="The first issue is about missing timeframe of bill data in the associated"
^DIC(9.4,49,22,10,"PAH",480,1,4,0)="display field when 'O NON-PAY/ZERO CLAIM' is selected in the Enter/Edit"
^DIC(9.4,49,22,10,"PAH",480,1,5,0)="Billing information [IB EDIT BILLING INFO] option."
^DIC(9.4,49,22,10,"PAH",480,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",480,1,7,0)="The second issue concerns the Technical Component (TC) modifier which"
^DIC(9.4,49,22,10,"PAH",480,1,8,0)="doesn't automatically populate to any procedure on an institutional bill"
^DIC(9.4,49,22,10,"PAH",480,1,9,0)="if the only professional charge on the procedure is 26 modified in the"
^DIC(9.4,49,22,10,"PAH",480,1,10,0)="Enter/Edit Billing information [IB EDIT BILLING INFO] option."
^DIC(9.4,49,22,10,"PAH",481,0)="610 SEQ #554^3180130.151054^54"
^DIC(9.4,49,22,10,"PAH",481,1,0)="^^15^15^3180130"
^DIC(9.4,49,22,10,"PAH",481,1,1,0)="This patch will update the administrative charge based on different rate "
^DIC(9.4,49,22,10,"PAH",481,1,2,0)="types with new dispensing fees for third party pharmacy prescription"
^DIC(9.4,49,22,10,"PAH",481,1,3,0)="claims with an effective date of January 1st, 2018."
^DIC(9.4,49,22,10,"PAH",481,1,4,0)="   "
^DIC(9.4,49,22,10,"PAH",481,1,5,0)="   Rate Type             Dispensing Fee"
^DIC(9.4,49,22,10,"PAH",481,1,6,0)="   -------------------   --------------"
^DIC(9.4,49,22,10,"PAH",481,1,7,0)="   HUMANITARIAN          16.64"
^DIC(9.4,49,22,10,"PAH",481,1,8,0)="   INELIGIBLE            16.64"
^DIC(9.4,49,22,10,"PAH",481,1,9,0)="   INTERAGENCY           16.64"
^DIC(9.4,49,22,10,"PAH",481,1,10,0)="   NO FAULT INS.         16.64"
^DIC(9.4,49,22,10,"PAH",481,1,11,0)="   REIMBURSABLE INS.     16.64"
^DIC(9.4,49,22,10,"PAH",481,1,12,0)="   TORT FEASOR           16.64"
^DIC(9.4,49,22,10,"PAH",481,1,13,0)="   WORKERS' COMP.        16.64"
^DIC(9.4,49,22,10,"PAH",481,1,14,0)="   TRICARE REIMB. INS.   13.91"
^DIC(9.4,49,22,10,"PAH",481,1,15,0)="   TRICARE               13.91"
^DIC(9.4,49,22,10,"PAH",482,0)="585 SEQ #555^3180130.153952^54"
^DIC(9.4,49,22,10,"PAH",482,1,0)="^^5^5^3180130"
^DIC(9.4,49,22,10,"PAH",482,1,1,0)="This patch implements Payers domain changes required by the"
^DIC(9.4,49,22,10,"PAH",482,1,2,0)="Collaborative Terminology Tooling & Data Management (CTT & DM) Native"
^DIC(9.4,49,22,10,"PAH",482,1,3,0)="Domain Standardization (NDS) project. "
^DIC(9.4,49,22,10,"PAH",482,1,4,0)=" "
^DIC(9.4,49,22,10,"PAH",482,1,5,0)="Please see FORUM for full patch description and installation instructions."
^DIC(9.4,49,22,10,"PAH",483,0)="597 SEQ #556^3180302.142933^54"
^DIC(9.4,49,22,10,"PAH",483,1,0)="^^11^11^3180302"
^DIC(9.4,49,22,10,"PAH",483,1,1,0)=" This patch addresses 3 issues:"
^DIC(9.4,49,22,10,"PAH",483,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",483,1,3,0)=" 1. Update the Integrated Billing option Correct Rejected/Denied Bill [IB"
^DIC(9.4,49,22,10,"PAH",483,1,4,0)="    CORRECT REJECTED/DENIED] to address a missing lock issue."
^DIC(9.4,49,22,10,"PAH",483,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",483,1,6,0)=" 2. Correct the summary totals of the THIRD PARTY FOLLOW-UP SUMMARY in the"
^DIC(9.4,49,22,10,"PAH",483,1,7,0)="    View/Print Extracted Reports [IBJD DM VIEW/PRINT EXTRACTS] option."
^DIC(9.4,49,22,10,"PAH",483,1,8,0)=" "
^DIC(9.4,49,22,10,"PAH",483,1,9,0)=" 3. The FINDLN+64 and FINDLN+118 undefined errors occur when the "
^DIC(9.4,49,22,10,"PAH",483,1,10,0)="    IBZDATA(1) variable is undefined which is supposed to hold formatting"
^DIC(9.4,49,22,10,"PAH",483,1,11,0)="    data for the bill line."
^DIC(9.4,49,22,10,"PAH",484,0)="604 SEQ #557^3180302.152536^54"
^DIC(9.4,49,22,10,"PAH",484,1,0)="^^27^27^3180302"
^DIC(9.4,49,22,10,"PAH",484,1,1,0)=" This patch will address 4 issues:"
^DIC(9.4,49,22,10,"PAH",484,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",484,1,3,0)=" 1. The medication profile screen should show "
^DIC(9.4,49,22,10,"PAH",484,1,4,0)="    the co-payment indicator for non-service connected patients."
^DIC(9.4,49,22,10,"PAH",484,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",484,1,6,0)=" 2. This patch adds a check for the FILL NUMBER (#.1) field in the"
^DIC(9.4,49,22,10,"PAH",484,1,7,0)="    IB BILL/CLAIMS PRESCRIPTION REFILL (#362.4) file when searching"
^DIC(9.4,49,22,10,"PAH",484,1,8,0)="    for third party bills with matching first party prescription "
^DIC(9.4,49,22,10,"PAH",484,1,9,0)="    copayments using the Claims Matching Report [RCDP CLAIMS MATCH] "
^DIC(9.4,49,22,10,"PAH",484,1,10,0)="    option. This ensures that an original prescription with a fill date "
^DIC(9.4,49,22,10,"PAH",484,1,11,0)="    that differs from the date the bill was created will be included in "
^DIC(9.4,49,22,10,"PAH",484,1,12,0)="    the report."
^DIC(9.4,49,22,10,"PAH",484,1,13,0)=" "
^DIC(9.4,49,22,10,"PAH",484,1,14,0)=" 3. This patch changes the process of searching for clerks when using the"
^DIC(9.4,49,22,10,"PAH",484,1,15,0)="    Workload Assignment Enter/Edit [IBJD FOLLOW-UP WORKLOAD] option so "
^DIC(9.4,49,22,10,"PAH",484,1,16,0)="    that new entries cannot be made to the NEW PERSON (#200) file. The "
^DIC(9.4,49,22,10,"PAH",484,1,17,0)="    option has been changed to search the NAME (#.01) field of the NEW "
^DIC(9.4,49,22,10,"PAH",484,1,18,0)="    PERSON (#200) file, instead of searching the IB DM WORKLOAD PARAMETERS"
^DIC(9.4,49,22,10,"PAH",484,1,19,0)="    (#351.73) file. The entry found in the NEW PERSON (#200) file is then "
^DIC(9.4,49,22,10,"PAH",484,1,20,0)="    used to search the IB DM WORKLOAD PARAMETERS (#351.73) file, and will"
^DIC(9.4,49,22,10,"PAH",484,1,21,0)="    allow a new entry to be made if a match is not found."
^DIC(9.4,49,22,10,"PAH",484,1,22,0)=" "
^DIC(9.4,49,22,10,"PAH",484,1,23,0)=" 4. For certain Clinical Procedure Terminology (CPT) codes we need "
^DIC(9.4,49,22,10,"PAH",484,1,24,0)="    to enter a procedure description- for CPT J1566 we do not have "
^DIC(9.4,49,22,10,"PAH",484,1,25,0)="    this option in V2. Other Vista sites allow you to enter the "
^DIC(9.4,49,22,10,"PAH",484,1,26,0)="    appropriate information. Can an update be done to V2 to have this"
^DIC(9.4,49,22,10,"PAH",484,1,27,0)="    option for this CPT code- it is causing claims to deny."
^DIC(9.4,49,22,10,"PAH",485,0)="615 SEQ #558^3180403.153033^54"
^DIC(9.4,49,22,10,"PAH",485,1,0)="^^2^2^3180403"
^DIC(9.4,49,22,10,"PAH",485,1,1,0)="Routine IB20P615 copied from IB20P599 for Stop Code Updates effective "
^DIC(9.4,49,22,10,"PAH",485,1,2,0)="04/1/2018."
^DIC(9.4,49,22,10,"PAH",486,0)="612 SEQ #559^3180403.17271^54"
^DIC(9.4,49,22,10,"PAH",486,1,0)="^^1^1^3180403"
^DIC(9.4,49,22,10,"PAH",486,1,1,0)="Reasonable Charges v3.23"
^DIC(9.4,49,22,10,"PAH",487,0)="601 SEQ #560^3180403.17354^54"
^DIC(9.4,49,22,10,"PAH",487,1,0)="^^1^1^3180403"
^DIC(9.4,49,22,10,"PAH",487,1,1,0)="IB*2.0*601 -- see patch description for implementation details. "
^DIC(9.4,49,22,10,"PAH",488,0)="598 SEQ #561^3180424.161653^54"
^DIC(9.4,49,22,10,"PAH",488,1,0)="^^12^12^3180424"
^DIC(9.4,49,22,10,"PAH",488,1,1,0)="This patch addresses three issues."
^DIC(9.4,49,22,10,"PAH",488,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",488,1,3,0)="The first issue is about the Clinical Information header overlapping the"
^DIC(9.4,49,22,10,"PAH",488,1,4,0)="the special conditions in the expanded claims tracking entry screen in the"
^DIC(9.4,49,22,10,"PAH",488,1,5,0)="the Claims Tracking Edit [IBT EDIT BI TRACKING ENTRY] option."
^DIC(9.4,49,22,10,"PAH",488,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",488,1,7,0)="The second issue is requested to add the bundled procedures 0295T, 0296T,"
^DIC(9.4,49,22,10,"PAH",488,1,8,0)="0297T and 0298T to the procedures split structure."
^DIC(9.4,49,22,10,"PAH",488,1,9,0)=" "
^DIC(9.4,49,22,10,"PAH",488,1,10,0)="The third issue as a post-init routine that will update the MCCR Utility "
^DIC(9.4,49,22,10,"PAH",488,1,11,0)="file (#399.1) and Specialty file (#42.4) to prevent unwanted Hospice and "
^DIC(9.4,49,22,10,"PAH",488,1,12,0)="First Party charges."
^DIC(9.4,49,22,10,"PAH",489,0)="613 SEQ #562^3180425.17262^54"
^DIC(9.4,49,22,10,"PAH",489,1,0)="^^7^7^3180425"
^DIC(9.4,49,22,10,"PAH",489,1,1,0)="This patch addresses two issues."
^DIC(9.4,49,22,10,"PAH",489,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",489,1,3,0)="- Fix an undefined error occurred at line MRA2+40^IBJTBA1 in the Third"
^DIC(9.4,49,22,10,"PAH",489,1,4,0)="Party Joint Inquiry [IBJ THIRD PARTY JOINT INQUIRY] option."
^DIC(9.4,49,22,10,"PAH",489,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",489,1,6,0)="- Update to Condition/Occurrence/Value codes of the MCCR UTILITY (#399.1)"
^DIC(9.4,49,22,10,"PAH",489,1,7,0)="file for 2018."
^DIC(9.4,49,22,10,"PAH",490,0)="620 SEQ #563^3180501.144921^54"
^DIC(9.4,49,22,10,"PAH",490,1,0)="^^1^1^3180501"
^DIC(9.4,49,22,10,"PAH",490,1,1,0)="The patch will re-instate the 2017 BILLING THRESHOLD (#354.3) values."
^DIC(9.4,49,22,10,"PAH",491,0)="568 SEQ #564^3180601.161913^54"
^DIC(9.4,49,22,10,"PAH",491,1,0)="^^313^313^3180601"
^DIC(9.4,49,22,10,"PAH",491,1,1,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,2,0)="IMPORTANT INSTALLATION NOTE:"
^DIC(9.4,49,22,10,"PAH",491,1,3,0)="----------------------------"
^DIC(9.4,49,22,10,"PAH",491,1,4,0)="This patch is part of a multi-package build. There are three patches "
^DIC(9.4,49,22,10,"PAH",491,1,5,0)="associated with the FY16 HAPE Revenue Enhancement project - "
^DIC(9.4,49,22,10,"PAH",491,1,6,0)="IB*2.0*568,PRCA*4.5*315 and PSO*7.0*463. All three patches are to be "
^DIC(9.4,49,22,10,"PAH",491,1,7,0)="installed together as a bundle, IB_2_568_PRCA_PSO_BUNDLE_T1.KID"
^DIC(9.4,49,22,10,"PAH",491,1,8,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,9,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,10,0)="Description"
^DIC(9.4,49,22,10,"PAH",491,1,11,0)="-----------"
^DIC(9.4,49,22,10,"PAH",491,1,12,0)="The Chief Business Office (CBO) is requesting system enhancements to"
^DIC(9.4,49,22,10,"PAH",491,1,13,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,49,22,10,"PAH",491,1,14,0)="(VistA) Integrated Billing (IB), Accounts Receivable (AR), and "
^DIC(9.4,49,22,10,"PAH",491,1,15,0)="Outpatient Pharmacy (PSO) software modules.  "
^DIC(9.4,49,22,10,"PAH",491,1,16,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,17,0)="The mission of the Department of Veterans Affairs (VA), Office of "
^DIC(9.4,49,22,10,"PAH",491,1,18,0)="Information & Technology (OI&T), is to provide benefits and services "
^DIC(9.4,49,22,10,"PAH",491,1,19,0)="to veterans of the United States Armed Forces. In meeting these "
^DIC(9.4,49,22,10,"PAH",491,1,20,0)="goals, OIT strives to provide high quality, effective, and efficient "
^DIC(9.4,49,22,10,"PAH",491,1,21,0)="Information Technology (IT) services to those responsible for "
^DIC(9.4,49,22,10,"PAH",491,1,22,0)="providing care to the veterans at the point-of-care, as well as "
^DIC(9.4,49,22,10,"PAH",491,1,23,0)="throughout all the points of the veterans' health care. The VA depends"
^DIC(9.4,49,22,10,"PAH",491,1,24,0)="on Information Management/Information Technology (IM/IT) systems to "
^DIC(9.4,49,22,10,"PAH",491,1,25,0)="meet mission goals."
^DIC(9.4,49,22,10,"PAH",491,1,26,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,27,0)="The overall FY16 HAPE Revenue Enhancement project has been further "
^DIC(9.4,49,22,10,"PAH",491,1,28,0)="divided into three sub-projects:"
^DIC(9.4,49,22,10,"PAH",491,1,29,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,30,0)="NSR #20150506"
^DIC(9.4,49,22,10,"PAH",491,1,31,0)="The Revenue Eligibility Enhancements Project effort for the Chief "
^DIC(9.4,49,22,10,"PAH",491,1,32,0)="Business Office (CBO), bundles several NSRs with similar business "
^DIC(9.4,49,22,10,"PAH",491,1,33,0)="needs into a single requirements document.  Successfully addressing "
^DIC(9.4,49,22,10,"PAH",491,1,34,0)="the requirements contained within this document will enable the "
^DIC(9.4,49,22,10,"PAH",491,1,35,0)="Department of Veterans Affairs (VA) to appropriately bill certain "
^DIC(9.4,49,22,10,"PAH",491,1,36,0)="subsets of billable events by correcting, automating, or enhancing "
^DIC(9.4,49,22,10,"PAH",491,1,37,0)="current Veterans Health Information Systems and Technology "
^DIC(9.4,49,22,10,"PAH",491,1,38,0)="Architecture (VistA) systems."
^DIC(9.4,49,22,10,"PAH",491,1,39,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,40,0)="NSR #20150507"
^DIC(9.4,49,22,10,"PAH",491,1,41,0)="The Revenue Operations Enhancements Project combines serveral NSRs, "
^DIC(9.4,49,22,10,"PAH",491,1,42,0)="as well. This effort enables the Department of Veterans Affairs (VA)"
^DIC(9.4,49,22,10,"PAH",491,1,43,0)="to improve revenue operation functionality related to repayment plans, "
^DIC(9.4,49,22,10,"PAH",491,1,44,0)="late charge capture, bill suspension reasons, the billing of "
^DIC(9.4,49,22,10,"PAH",491,1,45,0)="deactivated providers, and the display of appeal rights and "
^DIC(9.4,49,22,10,"PAH",491,1,46,0)="responsibilities on the Veterans Beneficiary travel Bill of Collections"
^DIC(9.4,49,22,10,"PAH",491,1,47,0)="form.  Implementation of the proposed enhancements will make a "
^DIC(9.4,49,22,10,"PAH",491,1,48,0)="significant positive impact on stakeholders and target users."
^DIC(9.4,49,22,10,"PAH",491,1,49,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,50,0)="NSR #20150505"
^DIC(9.4,49,22,10,"PAH",491,1,51,0)="The Revenue Reporting Enhancements Project will enable the VA to "
^DIC(9.4,49,22,10,"PAH",491,1,52,0)="improve tracking and reporting of revenue, and will support revenue "
^DIC(9.4,49,22,10,"PAH",491,1,53,0)="reporting business rules and guidelines."
^DIC(9.4,49,22,10,"PAH",491,1,54,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,55,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,56,0)="IB*2.0*568 patch enhancements, pertinent to the above NSRs, include:"
^DIC(9.4,49,22,10,"PAH",491,1,57,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,58,0)="1.) When generating the RNB (Reasons Not Billable) report, the "
^DIC(9.4,49,22,10,"PAH",491,1,59,0)="Integrated Billing system shall populate the charges for all types "
^DIC(9.4,49,22,10,"PAH",491,1,60,0)="of services provided. Charges will not be screened by any billable "
^DIC(9.4,49,22,10,"PAH",491,1,61,0)="criteria but willindicate the full amount as if the care was to be "
^DIC(9.4,49,22,10,"PAH",491,1,62,0)="billed."
^DIC(9.4,49,22,10,"PAH",491,1,63,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,64,0)="2.) The sub-option Claims Tracking Parameter Edit [IBT EDIT TRACKING "
^DIC(9.4,49,22,10,"PAH",491,1,65,0)="PARAMETERS], that currently has no key, will be locked with a new "
^DIC(9.4,49,22,10,"PAH",491,1,66,0)="Security Key called IB PARAMETER EDIT. "
^DIC(9.4,49,22,10,"PAH",491,1,67,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,68,0)="3.) The option MCCR Site Parameter Display/Edit [IBJ MCCR SITE "
^DIC(9.4,49,22,10,"PAH",491,1,69,0)="PARAMETERS], which is currently locked with the IB SUPERVISOR Security"
^DIC(9.4,49,22,10,"PAH",491,1,70,0)="Key, will be instead locked with the new key."
^DIC(9.4,49,22,10,"PAH",491,1,71,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,72,0)="4.) The Integrated Billing system shall create claims tracking entries"
^DIC(9.4,49,22,10,"PAH",491,1,73,0)="for previously unbilled Prosthetics/DME items when new billable "
^DIC(9.4,49,22,10,"PAH",491,1,74,0)="insurance is entered into the patient's insurance file.  "
^DIC(9.4,49,22,10,"PAH",491,1,75,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,76,0)="5.) A new coverage limitation field shall be created in the insurance "
^DIC(9.4,49,22,10,"PAH",491,1,77,0)="file for Prosthetics.  Like the other existing coverage limitation "
^DIC(9.4,49,22,10,"PAH",491,1,78,0)="fields in the insurance file (Inpatient, Outpatient, Pharmacy etc.), "
^DIC(9.4,49,22,10,"PAH",491,1,79,0)="this field will have the following options:"
^DIC(9.4,49,22,10,"PAH",491,1,80,0)="        0=NOT COVERED"
^DIC(9.4,49,22,10,"PAH",491,1,81,0)="        1=COVERED"
^DIC(9.4,49,22,10,"PAH",491,1,82,0)="        2=CONDITIONALCOVERAGE"
^DIC(9.4,49,22,10,"PAH",491,1,83,0)="Once selected, they will show in the patient insurance file as Yes, "
^DIC(9.4,49,22,10,"PAH",491,1,84,0)="No, or Conditional."
^DIC(9.4,49,22,10,"PAH",491,1,85,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,86,0)="6.) The system shall automatically assign an RNB [NO PROSTHETIC "
^DIC(9.4,49,22,10,"PAH",491,1,87,0)="COVERAGE (CV22)] for Prosthetics/DME items if the patient has no "
^DIC(9.4,49,22,10,"PAH",491,1,88,0)="coverage for Prosthetics in his/her insurance file."
^DIC(9.4,49,22,10,"PAH",491,1,89,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,90,0)="7.) The system shall have a new option to add Prosthetics items to "
^DIC(9.4,49,22,10,"PAH",491,1,91,0)="Manual and Nightly Claims Tracking. "
^DIC(9.4,49,22,10,"PAH",491,1,92,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,93,0)="8.) Users will be able to select Suspended Type from the menu to "
^DIC(9.4,49,22,10,"PAH",491,1,94,0)="display in the First Party Follow- Up [IBJD FOLLOW-UP FIRST PARTY] "
^DIC(9.4,49,22,10,"PAH",491,1,95,0)="report. "
^DIC(9.4,49,22,10,"PAH",491,1,96,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,97,0)="9.) First Party Follow- Up [IBJD FOLLOW-UP FIRST PARTY] report shall "
^DIC(9.4,49,22,10,"PAH",491,1,98,0)="be modified to incorporate reason for suspension."
^DIC(9.4,49,22,10,"PAH",491,1,99,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,100,0)="10.) A new warning message will print to the screen in the Enter/Edit "
^DIC(9.4,49,22,10,"PAH",491,1,101,0)="Billing Information option if an ATTENDING, REFERRING or RENDERING "
^DIC(9.4,49,22,10,"PAH",491,1,102,0)="Provider has a PERSON CLASS - NEW PERSON file (#200) - that was "
^DIC(9.4,49,22,10,"PAH",491,1,103,0)="expirated at the time of the Date of Service."
^DIC(9.4,49,22,10,"PAH",491,1,104,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,105,0)="11.) On the Third Party Joint Inquiry screen, one (1) character space "
^DIC(9.4,49,22,10,"PAH",491,1,106,0)="shall be added to the ""Type"" field so that it will accommodate five "
^DIC(9.4,49,22,10,"PAH",491,1,107,0)="characters (a one-character classification indicator, a forward slash "
^DIC(9.4,49,22,10,"PAH",491,1,108,0)="(/), a one-character component indicator, a forward slash (/), and a "
^DIC(9.4,49,22,10,"PAH",491,1,109,0)="one-character care type) (""X/X/X"").  If a bill contains prescriptions, "
^DIC(9.4,49,22,10,"PAH",491,1,110,0)="then an ""R"" shall be concatenated to the fifth character sub-type "
^DIC(9.4,49,22,10,"PAH",491,1,111,0)="position of the ""Type"" field. If a bill contains prosthetics, then a "
^DIC(9.4,49,22,10,"PAH",491,1,112,0)="""P"" shall be concatenated to fifth character sub-type position of the "
^DIC(9.4,49,22,10,"PAH",491,1,113,0)="""Type"" field.The ""Type"" field shall contain five (5) characters as "
^DIC(9.4,49,22,10,"PAH",491,1,114,0)="follows:"
^DIC(9.4,49,22,10,"PAH",491,1,115,0)="1. ""I"" for Inpatient or ""O"" for Outpatient,"
^DIC(9.4,49,22,10,"PAH",491,1,116,0)="2. ""/"" forward slash character"
^DIC(9.4,49,22,10,"PAH",491,1,117,0)="3. ""P"" for Professional or ""I"" for Institutional"
^DIC(9.4,49,22,10,"PAH",491,1,118,0)="4. ""/"" forward slash character"
^DIC(9.4,49,22,10,"PAH",491,1,119,0)="5. ""P"" for Prosthetics or ""R"" for Prescriptions"
^DIC(9.4,49,22,10,"PAH",491,1,120,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,121,0)="12.) Three new Third Party Insurance Rate Types shall be created in "
^DIC(9.4,49,22,10,"PAH",491,1,122,0)="the VistA IB Suite for the billers to choose from when billing for "
^DIC(9.4,49,22,10,"PAH",491,1,123,0)="encounters. They are as follows:"
^DIC(9.4,49,22,10,"PAH",491,1,124,0)="        HUMANITARIAN REIMB. INS. "
^DIC(9.4,49,22,10,"PAH",491,1,125,0)="        DENTAL REIMB. INS."
^DIC(9.4,49,22,10,"PAH",491,1,126,0)="        INELIGIBLE REIMB. INS."
^DIC(9.4,49,22,10,"PAH",491,1,127,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,128,0)="13.) Each of the new rate types above will have the 'Insurer' as the "
^DIC(9.4,49,22,10,"PAH",491,1,129,0)="responsible party."
^DIC(9.4,49,22,10,"PAH",491,1,130,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,131,0)="14.) Billers (revenue staff) should be able to identify any remaining "
^DIC(9.4,49,22,10,"PAH",491,1,132,0)="charges to the patient after the Third Party payments are received for "
^DIC(9.4,49,22,10,"PAH",491,1,133,0)="Emergency Humanitarian, Ineligible and Dental services so they can "
^DIC(9.4,49,22,10,"PAH",491,1,134,0)="accomplish balance billing. "
^DIC(9.4,49,22,10,"PAH",491,1,135,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,136,0)=" "
^DIC(9.4,49,22,10,"PAH",491,1,137,0)=" "
