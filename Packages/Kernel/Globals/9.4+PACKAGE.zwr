^DIC(9.4,13,22,8,"PAH",10,1,124,0)="  DIO0           9418636         9464280         2"
^DIC(9.4,13,22,8,"PAH",10,1,125,0)="  DIO1           6789778         6980951         2"
^DIC(9.4,13,22,8,"PAH",10,1,126,0)="  DIO3           4969134         4961669         2"
^DIC(9.4,13,22,8,"PAH",10,1,127,0)="  DIO4           6003254         5849805         2"
^DIC(9.4,13,22,8,"PAH",10,1,128,0)="  DIOS1          1190642         1071375         2"
^DIC(9.4,13,22,8,"PAH",10,1,129,0)="  DIP            12986358        13075099        2"
