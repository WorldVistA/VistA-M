^DIC(9.4,4,22,1,"PAH",38,1,0)="^^39^39^2980923"
^DIC(9.4,4,22,1,"PAH",38,1,1,0)="MailMan patch XM*7.1*65 addresses NOIS ISD-0898-71122."
^DIC(9.4,4,22,1,"PAH",38,1,2,0)="Test site is CIOFO-DALLAS."
^DIC(9.4,4,22,1,"PAH",38,1,3,0)=""
^DIC(9.4,4,22,1,"PAH",38,1,4,0)="Problem statement: When installing a packman global data with leading tildes,"
^DIC(9.4,4,22,1,"PAH",38,1,5,0)="a syntax error occurs.  This patch fixes this problem."
^DIC(9.4,4,22,1,"PAH",38,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",38,1,7,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",38,1,8,0)="This patch may be installed at any time.  However, this patch should NOT"
^DIC(9.4,4,22,1,"PAH",38,1,9,0)="be loaded at the same time as any other patches, because a clobber error"
^DIC(9.4,4,22,1,"PAH",38,1,10,0)="may occur."
^DIC(9.4,4,22,1,"PAH",38,1,11,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",38,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",38,1,13,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",38,1,14,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",38,1,15,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",38,1,16,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",38,1,17,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",38,1,18,0)="3.  On the KIDS:Installation menu, use the following options to install the "
^DIC(9.4,4,22,1,"PAH",38,1,19,0)="    Transport Global: "
