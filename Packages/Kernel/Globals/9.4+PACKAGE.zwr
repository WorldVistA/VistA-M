^DIC(9.4,14,22,5.9,"PAH",272,1,90,0)="Software and Documentation Retrieval Information"
^DIC(9.4,14,22,5.9,"PAH",272,1,91,0)=" =============================="
^DIC(9.4,14,22,5.9,"PAH",272,1,92,0)=" VistA Laboratory patch LR*5.2*458 software is distributed by Host File, "
^DIC(9.4,14,22,5.9,"PAH",272,1,93,0)="along with LA*5.2*88.  Software is available on the ANONYMOUS.SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",272,1,94,0)="directory at one of the following Office of Information (OI) Field "
^DIC(9.4,14,22,5.9,"PAH",272,1,95,0)="Offices.  The preferred method is to retrieve the file using Secure File"
^DIC(9.4,14,22,5.9,"PAH",272,1,96,0)="Transfer Protocol (SFTP) from: download.vista.domain.ext, which transmits"
^DIC(9.4,14,22,5.9,"PAH",272,1,97,0)="files from the first available FTP server. Sites may also select to retrieve"
^DIC(9.4,14,22,5.9,"PAH",272,1,98,0)="documentation directly from a specific server as follows: "
^DIC(9.4,14,22,5.9,"PAH",272,1,99,0)="        Albany                     ftp.fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",272,1,100,0)="        Hines                      ftp.fo-hines.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",272,1,101,0)="        Salt Lake City             ftp.fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",272,1,102,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,103,0)="File Name                   Contents               Retrieval Format"
^DIC(9.4,14,22,5.9,"PAH",272,1,104,0)="------------------          --------------------   ----------------"
^DIC(9.4,14,22,5.9,"PAH",272,1,105,0)="LAB_AUTORELEASE_1_0.KID     Host File containing       ASCII"
^DIC(9.4,14,22,5.9,"PAH",272,1,106,0)="                            KIDS software distribution"
^DIC(9.4,14,22,5.9,"PAH",272,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,108,0)="The VistA Documentation Library (VDL) web site will also contain "
^DIC(9.4,14,22,5.9,"PAH",272,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,110,0)="LR_52_458_LA_52_88 Release Notes                       Binary"
^DIC(9.4,14,22,5.9,"PAH",272,1,111,0)=" for LR*5.2*458 and LA*5.2*88"
^DIC(9.4,14,22,5.9,"PAH",272,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,113,0)="Lab AutoRelease 1.0 User Guide                         Binary"
^DIC(9.4,14,22,5.9,"PAH",272,1,114,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,115,0)="Lab AutoRelease 1.0 Technical Manual                   Binary"
^DIC(9.4,14,22,5.9,"PAH",272,1,116,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,117,0)="Lab UI HL V1.6 Upgrade Installation                    Binary"
^DIC(9.4,14,22,5.9,"PAH",272,1,118,0)=" and User Guide LA*5.2*66"
^DIC(9.4,14,22,5.9,"PAH",272,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,120,0)="Lab UI HL V1.6 Upgrade Interface                       Binary"
^DIC(9.4,14,22,5.9,"PAH",272,1,121,0)=" Specifications Document "
^DIC(9.4,14,22,5.9,"PAH",272,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,123,0)="This website is usually updated within 1-3 days of the patch release date."
^DIC(9.4,14,22,5.9,"PAH",272,1,124,0)="The VDL web address for Laboratory Universal Interface user documentation"
^DIC(9.4,14,22,5.9,"PAH",272,1,125,0)="is: http://www.domain.ext/vdl/application.asp?appid=120"
^DIC(9.4,14,22,5.9,"PAH",272,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,127,0)="Installation Instructions"
^DIC(9.4,14,22,5.9,"PAH",272,1,128,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",272,1,129,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,130,0)="This patch, LR*5.2*458, is part of a combined build for Autoverification "
^DIC(9.4,14,22,5.9,"PAH",272,1,131,0)="Enhancement patch.  This patch may be loaded with users on the system.  "
^DIC(9.4,14,22,5.9,"PAH",272,1,132,0)="You may want to install it during non-peak hours.  Installation will take "
^DIC(9.4,14,22,5.9,"PAH",272,1,133,0)="less than 10 minutes."
^DIC(9.4,14,22,5.9,"PAH",272,1,134,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,135,0)="Refer to the LR_52_458_LA_52_88 Release Notes referenced above for "
^DIC(9.4,14,22,5.9,"PAH",272,1,136,0)="complete instructions on install and post installation configuration."
^DIC(9.4,14,22,5.9,"PAH",272,1,137,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,138,0)="1.      DOWNLOAD HOST KIDS FILE"
^DIC(9.4,14,22,5.9,"PAH",272,1,139,0)="        ----------------------"
^DIC(9.4,14,22,5.9,"PAH",272,1,140,0)="        Download the KIDS file LAB_AUTORELEASE_1_0.KID from the "
^DIC(9.4,14,22,5.9,"PAH",272,1,141,0)="        ANONYMOUS.SOFTWARE directory of Albany, Hines, or the Salt Lake"
^DIC(9.4,14,22,5.9,"PAH",272,1,142,0)="        OIFO to the appropriate directory on your system."
^DIC(9.4,14,22,5.9,"PAH",272,1,143,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,144,0)="2.      LOAD DISTRIBUTION"
^DIC(9.4,14,22,5.9,"PAH",272,1,145,0)="        -----------------"
^DIC(9.4,14,22,5.9,"PAH",272,1,146,0)="        Use the 'LOAD A DISTRIBUTION' option on the KIDS"
^DIC(9.4,14,22,5.9,"PAH",272,1,147,0)="        INSTALLATION menu, and enter:  the directory onto which you"
^DIC(9.4,14,22,5.9,"PAH",272,1,148,0)="        have downloaded the host file, followed by"
^DIC(9.4,14,22,5.9,"PAH",272,1,149,0)="        LAB_AUTORELEASE_1_0.KID, the host file name. "
^DIC(9.4,14,22,5.9,"PAH",272,1,150,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,151,0)="3.      START UP KIDS"
^DIC(9.4,14,22,5.9,"PAH",272,1,152,0)="        -------------"
^DIC(9.4,14,22,5.9,"PAH",272,1,153,0)="        Start up the Kernel Installation and Distribution System Menu [XPD"
^DIC(9.4,14,22,5.9,"PAH",272,1,154,0)="        MAIN]:"
^DIC(9.4,14,22,5.9,"PAH",272,1,155,0)="        Edits and Distribution ..."
^DIC(9.4,14,22,5.9,"PAH",272,1,156,0)="        Utilities ..."
^DIC(9.4,14,22,5.9,"PAH",272,1,157,0)="        Installation ..."
^DIC(9.4,14,22,5.9,"PAH",272,1,158,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,159,0)="        Select Kernel Installation & Distribution System Option:"
^DIC(9.4,14,22,5.9,"PAH",272,1,160,0)="        INStallation"
^DIC(9.4,14,22,5.9,"PAH",272,1,161,0)="            ---"
^DIC(9.4,14,22,5.9,"PAH",272,1,162,0)="            Load a Distribution"
^DIC(9.4,14,22,5.9,"PAH",272,1,163,0)="            Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",272,1,164,0)="            Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",272,1,165,0)="            Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",272,1,166,0)="            Install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",272,1,167,0)="            Restart Install of Package(s)"
^DIC(9.4,14,22,5.9,"PAH",272,1,168,0)="            Unload a Distribution"
^DIC(9.4,14,22,5.9,"PAH",272,1,169,0)="            Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",272,1,170,0)="4.      Select Installation Option:"
^DIC(9.4,14,22,5.9,"PAH",272,1,171,0)="        --------------------------"
^DIC(9.4,14,22,5.9,"PAH",272,1,172,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,173,0)="   a.   Use the Load a Distribution and select Host File:"
^DIC(9.4,14,22,5.9,"PAH",272,1,174,0)="        LAB_AUTORELEASE_1_0.KID"
^DIC(9.4,14,22,5.9,"PAH",272,1,175,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,176,0)="        NOTE: The following are OPTIONAL - (When prompted for the INSTALL"
^DIC(9.4,14,22,5.9,"PAH",272,1,177,0)="        NAME, enter LA*5.2*88):"
^DIC(9.4,14,22,5.9,"PAH",272,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,179,0)="   b.   Backup a Transport Global - This option will create a backup "
^DIC(9.4,14,22,5.9,"PAH",272,1,180,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,14,22,5.9,"PAH",272,1,181,0)="        backup any other changes such as DD's or templates."
^DIC(9.4,14,22,5.9,"PAH",272,1,182,0)="   c.   Compare Transport Global to Current System - This option will "
^DIC(9.4,14,22,5.9,"PAH",272,1,183,0)="        allow you to view all changes that will be made when this patch is"
^DIC(9.4,14,22,5.9,"PAH",272,1,184,0)="        installed. It compares all components of this patch m (routines,"
^DIC(9.4,14,22,5.9,"PAH",272,1,185,0)="        DD's, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",272,1,186,0)="   d.   Verify Checksums in Transport Global - This option will allow you"
^DIC(9.4,14,22,5.9,"PAH",272,1,187,0)="        to ensure the integrity of the routines that are in the transport"
^DIC(9.4,14,22,5.9,"PAH",272,1,188,0)="        global."
^DIC(9.4,14,22,5.9,"PAH",272,1,189,0)="   e.   Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",272,1,190,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,191,0)="5.      Select Installation Option: Install Package(s) **This is the step "
^DIC(9.4,14,22,5.9,"PAH",272,1,192,0)="        to start the installation of this KIDS patch:"
^DIC(9.4,14,22,5.9,"PAH",272,1,193,0)="        --------------------------"
^DIC(9.4,14,22,5.9,"PAH",272,1,194,0)="        **This is the step to start the installation of this KIDS patch:"
^DIC(9.4,14,22,5.9,"PAH",272,1,195,0)="   a.    Choose the Install Package(s) option to start the patch install."
^DIC(9.4,14,22,5.9,"PAH",272,1,196,0)="   b.   When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,14,22,5.9,"PAH",272,1,197,0)="        YES//' answer NO"
^DIC(9.4,14,22,5.9,"PAH",272,1,198,0)="   c.   When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,14,22,5.9,"PAH",272,1,199,0)="        and Protocols? YES//' answer NO."
^DIC(9.4,14,22,5.9,"PAH",272,1,200,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,201,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,202,0)="Routine Information:"
^DIC(9.4,14,22,5.9,"PAH",272,1,203,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",272,1,204,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,205,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,206,0)="The second line of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",272,1,207,0)=";;5.2;AUTOMATED LAB INSTRUMENTS;**[Patch List]**;Sep 27, 1994;Build 10"
^DIC(9.4,14,22,5.9,"PAH",272,1,208,0)=" "
^DIC(9.4,14,22,5.9,"PAH",272,1,209,0)="The checksums below are new checksums, and can be checked with "
^DIC(9.4,14,22,5.9,"PAH",272,1,210,0)="CHECK1^XTSUMBLD."
^DIC(9.4,14,22,5.9,"PAH",272,1,211,0)=" "
