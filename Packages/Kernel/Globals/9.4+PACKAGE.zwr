^DIC(9.4,14,22,5.9,"PAH",182,1,65,0)=" ----------"
^DIC(9.4,14,22,5.9,"PAH",182,1,66,0)=" Durham VAMC "
^DIC(9.4,14,22,5.9,"PAH",182,1,67,0)=" Manchester VAMC"
^DIC(9.4,14,22,5.9,"PAH",182,1,68,0)=" Milwaukee VAMC"
^DIC(9.4,14,22,5.9,"PAH",182,1,69,0)=" North Chicago VAMC"
^DIC(9.4,14,22,5.9,"PAH",182,1,70,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,72,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",182,1,73,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",182,1,74,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",182,1,75,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",182,1,76,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",182,1,77,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,78,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",182,1,79,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",182,1,80,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",182,1,81,0)="   LR328            N/A            4831454        **328** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",182,1,82,0)="   LRFAST           19472230       19464995       **100,121,201,286,291,328**"
^DIC(9.4,14,22,5.9,"PAH",182,1,83,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,84,0)=" List of preceding patches: 291"
^DIC(9.4,14,22,5.9,"PAH",182,1,85,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",182,1,86,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,87,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,88,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",182,1,89,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",182,1,90,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",182,1,91,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",182,1,92,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",182,1,93,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,95,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",182,1,96,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",182,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,98,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",182,1,99,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",182,1,100,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,101,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,102,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",182,1,103,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,104,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",182,1,105,0)="        option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",182,1,106,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,107,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",182,1,108,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",182,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,110,0)="  4.  From this menu, you may then elect to use the following options"
^DIC(9.4,14,22,5.9,"PAH",182,1,111,0)="      (when prompted for the INSTALL NAME, enter LR*5.2*328):"
^DIC(9.4,14,22,5.9,"PAH",182,1,112,0)="        a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",182,1,113,0)="        b. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",182,1,114,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",182,1,115,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",182,1,116,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,117,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",182,1,118,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",182,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,120,0)="  5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",182,1,121,0)="      and select the package 'LR*5.2*328'.  When prompted 'Want KIDS to"
^DIC(9.4,14,22,5.9,"PAH",182,1,122,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,14,22,5.9,"PAH",182,1,123,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,14,22,5.9,"PAH",182,1,124,0)="      YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",182,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,126,0)="      During install KIDS will place the ""Accession order then immediately"
^DIC(9.4,14,22,5.9,"PAH",182,1,127,0)="      enter data option [LR ACC THEN DATA] out of order."
^DIC(9.4,14,22,5.9,"PAH",182,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,129,0)="  6.  On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",182,1,130,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,131,0)=" Note: Routine LR328 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",182,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,134,0)="INSTALLATION EXAMPLE"
^DIC(9.4,14,22,5.9,"PAH",182,1,135,0)="==================== "
