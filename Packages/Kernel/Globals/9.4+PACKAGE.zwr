^DIC(9.4,73,22,9,"PAH",12,1,12,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",12,1,13,0)=" ============"
^DIC(9.4,73,22,9,"PAH",12,1,14,0)="    NOIS STC-0600-40949, CMO-0600-40937, BEC-0600-20733"
^DIC(9.4,73,22,9,"PAH",12,1,15,0)="        Number of sites reported that their Network Health"
^DIC(9.4,73,22,9,"PAH",12,1,16,0)="    Exchange Nightly Purge option was not working.  Old records"
^DIC(9.4,73,22,9,"PAH",12,1,17,0)="    were accumulated and never gets purged.  Routine AFJXPNHX was"
^DIC(9.4,73,22,9,"PAH",12,1,18,0)="    modified to correct this problem."
^DIC(9.4,73,22,9,"PAH",12,1,19,0)=" "
^DIC(9.4,73,22,9,"PAH",12,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",12,1,21,0)=" "
