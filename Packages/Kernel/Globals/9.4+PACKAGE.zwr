^DIC(9.4,11,22,5.03,"PAH",18,1,151,0)=" "
^DIC(9.4,11,22,5.03,"PAH",18,1,152,0)="Select INSTALL NAME:    LA*5.2*56     Loaded from Distribution  4/10/00@14:57:02"
^DIC(9.4,11,22,5.03,"PAH",18,1,153,0)="     => LA*5.2*56"
