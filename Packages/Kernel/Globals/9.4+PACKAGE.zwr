^DIC(9.4,13,22,8,"PAH",21,1,0)="^^2^2^3000405"
^DIC(9.4,13,22,8,"PAH",21,1,1,0)="See patch DI*22*9 in the National Patch Module for complete information"
^DIC(9.4,13,22,8,"PAH",21,1,2,0)="on this patch."
