^DIC(9.4,85,22,1.5,"PAH",6,0)="31 SEQ #28^3011121^1"
^DIC(9.4,85,22,1.5,"PAH",6,1,0)="^^73^73^3011121"
^DIC(9.4,85,22,1.5,"PAH",6,1,1,0)="Patch VAQ*1.5*31"
^DIC(9.4,85,22,1.5,"PAH",6,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",6,1,3,0)="NOIS ISL-1198-52170"
^DIC(9.4,85,22,1.5,"PAH",6,1,4,0)="Test Site: Oklahoma City"
^DIC(9.4,85,22,1.5,"PAH",6,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",6,1,6,0)="This patch enables PDX to recognize and report on NKA (No Known Allergy)"
^DIC(9.4,85,22,1.5,"PAH",6,1,7,0)="when using the API EN1^GMRADPT, provided by the Adverse Reaction Tracking"
^DIC(9.4,85,22,1.5,"PAH",6,1,8,0)="package."
^DIC(9.4,85,22,1.5,"PAH",6,1,9,0)=""
^DIC(9.4,85,22,1.5,"PAH",6,1,10,0)="Adverse Reaction Tracking released a patch, GMRA*4*10, which changed the"
^DIC(9.4,85,22,1.5,"PAH",6,1,11,0)="data returned by EN1^GMRADPT if the patient has NKA."
^DIC(9.4,85,22,1.5,"PAH",6,1,12,0)=""
^DIC(9.4,85,22,1.5,"PAH",6,1,13,0)="Before the patch, the API returned:"
^DIC(9.4,85,22,1.5,"PAH",6,1,14,0)="GMRAL=0"
^DIC(9.4,85,22,1.5,"PAH",6,1,15,0)="GMRAL(<ptr to file 120.8>)=DFN_""^NKA^0^1"""
^DIC(9.4,85,22,1.5,"PAH",6,1,16,0)=""
^DIC(9.4,85,22,1.5,"PAH",6,1,17,0)="After the patch, the API returned:"
^DIC(9.4,85,22,1.5,"PAH",6,1,18,0)="GMRAL=0"
^DIC(9.4,85,22,1.5,"PAH",6,1,19,0)=""
^DIC(9.4,85,22,1.5,"PAH",6,1,20,0)="PDX used to grab ""NKA"" from the GMRAL array.  After GMRA*4*10, there was"
^DIC(9.4,85,22,1.5,"PAH",6,1,21,0)="nothing to grab.  This patch, VAQ*1.5*31, ensures that PDX recognizes that"
^DIC(9.4,85,22,1.5,"PAH",6,1,22,0)="GMRAL=0 means ""NKA""."
^DIC(9.4,85,22,1.5,"PAH",6,1,23,0)=" "
^DIC(9.4,85,22,1.5,"PAH",6,1,24,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",6,1,25,0)="is at a minimum.  It has no patch pre-requisite requirement."
^DIC(9.4,85,22,1.5,"PAH",6,1,26,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",6,1,27,0)=" "
^DIC(9.4,85,22,1.5,"PAH",6,1,28,0)="ROUTINES:"
