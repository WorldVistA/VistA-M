^DIC(9.4,11,22,5.03,"PAH",36,1,425,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,426,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",36,1,427,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",36,1,428,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,429,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,11,22,5.03,"PAH",36,1,430,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",36,1,431,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",36,1,432,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,433,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,434,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,11,22,5.03,"PAH",36,1,435,0)="      problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",36,1,436,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,437,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",36,1,438,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",36,1,439,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,440,0)=" 1.   LOAD TRANSPORT GLOBAL"
^DIC(9.4,11,22,5.03,"PAH",36,1,441,0)="      ---------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",36,1,442,0)="      Choose the PackMan message containing this patch and invoke the"
^DIC(9.4,11,22,5.03,"PAH",36,1,443,0)="      INSTALL/CHECK   MESSAGE PackMan option. "
^DIC(9.4,11,22,5.03,"PAH",36,1,444,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,445,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,446,0)=" 2.   START UP KIDS"
^DIC(9.4,11,22,5.03,"PAH",36,1,447,0)="      Start up the Kernel Installation and distribution System"
^DIC(9.4,11,22,5.03,"PAH",36,1,448,0)="      Menu [XPD MAIN]:"
^DIC(9.4,11,22,5.03,"PAH",36,1,449,0)="              Edits and Distribution ..."
^DIC(9.4,11,22,5.03,"PAH",36,1,450,0)="                           Utilities ..."
^DIC(9.4,11,22,5.03,"PAH",36,1,451,0)="                         Installation ..."
^DIC(9.4,11,22,5.03,"PAH",36,1,452,0)="      "
^DIC(9.4,11,22,5.03,"PAH",36,1,453,0)="     Select Kernel Installation & Distribution System Option: Installation"
^DIC(9.4,11,22,5.03,"PAH",36,1,454,0)="                                                              ----"
^DIC(9.4,11,22,5.03,"PAH",36,1,455,0)="                1      Load a Distribution"
^DIC(9.4,11,22,5.03,"PAH",36,1,456,0)="                2      Verify Checksums in Transport Global"
^DIC(9.4,11,22,5.03,"PAH",36,1,457,0)="                3      Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",36,1,458,0)="                4      Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",36,1,459,0)="                5      Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",36,1,460,0)="                6      Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",36,1,461,0)="                       Restart Install of Package(s)"
^DIC(9.4,11,22,5.03,"PAH",36,1,462,0)="                       Unload a Distribution"
^DIC(9.4,11,22,5.03,"PAH",36,1,463,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,464,0)="      Select Installation Option:"
^DIC(9.4,11,22,5.03,"PAH",36,1,465,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,466,0)=" 3.   Select Installation Option:"
^DIC(9.4,11,22,5.03,"PAH",36,1,467,0)="      -------------------------------"
^DIC(9.4,11,22,5.03,"PAH",36,1,468,0)="      NOTE:  The following are OPTIONAL - (When prompted for the"
^DIC(9.4,11,22,5.03,"PAH",36,1,469,0)="      INSTALL NAME, enter LA*5.2*68):"
^DIC(9.4,11,22,5.03,"PAH",36,1,470,0)="      a.  Backup a Transport Global - This option will create a"
^DIC(9.4,11,22,5.03,"PAH",36,1,471,0)="          backup message of any routines exported with this patch."
^DIC(9.4,11,22,5.03,"PAH",36,1,472,0)="          It will not backup any other changes such as DD's or templates."
^DIC(9.4,11,22,5.03,"PAH",36,1,473,0)="      b.  Compare Transport Global to Current System - This option"
^DIC(9.4,11,22,5.03,"PAH",36,1,474,0)="          will allow you to view all changes that will be made when this"
^DIC(9.4,11,22,5.03,"PAH",36,1,475,0)="          patch is installed. It compares all components of this patch"
^DIC(9.4,11,22,5.03,"PAH",36,1,476,0)="          (routines, DD's, templates, etc.)."
^DIC(9.4,11,22,5.03,"PAH",36,1,477,0)="      c.  Verify Checksums in Transport Global - This option will"
^DIC(9.4,11,22,5.03,"PAH",36,1,478,0)="          allow you to ensure the integrity of the routines that are in"
^DIC(9.4,11,22,5.03,"PAH",36,1,479,0)="          the transport global."
^DIC(9.4,11,22,5.03,"PAH",36,1,480,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,481,0)=" 4.   Select Installation Option:  Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",36,1,482,0)="                                   ------------------"
^DIC(9.4,11,22,5.03,"PAH",36,1,483,0)="      **This is the step to start the installation of this KIDS patch:"
^DIC(9.4,11,22,5.03,"PAH",36,1,484,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,485,0)="      a.  Choose the Install Package(s) option to start the patch install."
^DIC(9.4,11,22,5.03,"PAH",36,1,486,0)="          (When prompted for the INSTALL NAME, enter LA*5.2*68.)"
^DIC(9.4,11,22,5.03,"PAH",36,1,487,0)="      b.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,11,22,5.03,"PAH",36,1,488,0)="          NO//' answer NO (unless otherwise indicated)"
^DIC(9.4,11,22,5.03,"PAH",36,1,489,0)="      c.  When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,11,22,5.03,"PAH",36,1,490,0)="          and Protocols? NO//' answer NO (unless otherwise indicated)"
^DIC(9.4,11,22,5.03,"PAH",36,1,491,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,492,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,493,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,494,0)=" Note: Routine LA68 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",36,1,495,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,496,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,497,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,11,22,5.03,"PAH",36,1,498,0)="==============================="
^DIC(9.4,11,22,5.03,"PAH",36,1,499,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,500,0)="***************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",36,1,501,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,502,0)="After the installation of Patch LA*5.2*68, do not activate the LA7 LAB "
^DIC(9.4,11,22,5.03,"PAH",36,1,503,0)="RESULTS TO HDR (SUB) subscriber protocol until contacted by the HDR team"
^DIC(9.4,11,22,5.03,"PAH",36,1,504,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,505,0)="***************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",36,1,506,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,507,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,508,0)="NOTE: Use the following steps only when activating the transmission of"
^DIC(9.4,11,22,5.03,"PAH",36,1,509,0)="laboratory data to the VA HDR and/or interfacing to a Commercial Off the "
^DIC(9.4,11,22,5.03,"PAH",36,1,510,0)="Shelf System (COTS) or other VistA subscriber. No further action is"
^DIC(9.4,11,22,5.03,"PAH",36,1,511,0)="required, if there is no requirement to activate this interface."
^DIC(9.4,11,22,5.03,"PAH",36,1,512,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,513,0)=" To activate messaging to the VA HDR perform steps 1, 2, and 3."
^DIC(9.4,11,22,5.03,"PAH",36,1,514,0)=" To activate messaging to COTS and other VistA subscribers"
^DIC(9.4,11,22,5.03,"PAH",36,1,515,0)="    perform steps 1 and 4."
^DIC(9.4,11,22,5.03,"PAH",36,1,516,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,517,0)="1. To utilize the building and transmission of HL7 Lab ORU result messages."
^DIC(9.4,11,22,5.03,"PAH",36,1,518,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,519,0)="   Enable the configuration 'LA7HDR' in LA7 MESSAGE PARAMETER file"
^DIC(9.4,11,22,5.03,"PAH",36,1,520,0)="   (#62.48). This is accomplished by setting the field STATUS (#2) to"
^DIC(9.4,11,22,5.03,"PAH",36,1,521,0)="   'ACTIVE' using VA File Manager. Setting this field to 'INACTIVE' will"
^DIC(9.4,11,22,5.03,"PAH",36,1,522,0)="   turn off generation of this Lab HL7 message."
^DIC(9.4,11,22,5.03,"PAH",36,1,523,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,524,0)="   Select VA FileMan Option:  Enter or Edit File Entries"
^DIC(9.4,11,22,5.03,"PAH",36,1,525,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,526,0)="   INPUT TO WHAT FILE: LA7 MESSAGE PARAMETER// 62.48  LA7 MESSAGE PARAMETER"
^DIC(9.4,11,22,5.03,"PAH",36,1,527,0)="    EDIT WHICH FIELD: ALL// STATUS"
^DIC(9.4,11,22,5.03,"PAH",36,1,528,0)="    THEN EDIT FIELD:"
^DIC(9.4,11,22,5.03,"PAH",36,1,529,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,530,0)="   Select LA7 MESSAGE PARAMETER CONFIGURATION: LA7HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,531,0)="   STATUS: INACTIVE// ACTIVE  ACTIVE"
^DIC(9.4,11,22,5.03,"PAH",36,1,532,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,533,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,534,0)="2. Activation of transmission to HDR requires coordination with your"
^DIC(9.4,11,22,5.03,"PAH",36,1,535,0)="   assigned HDR Implementation Manager (IM). Sites should not activate the"
^DIC(9.4,11,22,5.03,"PAH",36,1,536,0)="   LA7 LAB RESULTS TO HDR (SUB) subscriber until notified by the HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,537,0)="   team. The coordination of extractions of existing laboratory data will"
^DIC(9.4,11,22,5.03,"PAH",36,1,538,0)="   be started at the same time the configuration of the LA7 LAB RESULTS TO"
^DIC(9.4,11,22,5.03,"PAH",36,1,539,0)="   HDR (SUB) subscriber to ensure that there is an overlap of laboratory"
^DIC(9.4,11,22,5.03,"PAH",36,1,540,0)="   results. This overlap is done to ensure all laboratory results are in"
^DIC(9.4,11,22,5.03,"PAH",36,1,541,0)="   the HDR."
^DIC(9.4,11,22,5.03,"PAH",36,1,542,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,543,0)=" a. Set up VDEFVIE4 link for Laboratory data transmission"
^DIC(9.4,11,22,5.03,"PAH",36,1,544,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,545,0)="     Use the HL7 Main Menu, Filers option to look at the setup for "
^DIC(9.4,11,22,5.03,"PAH",36,1,546,0)="     VDEFVIE3. "
^DIC(9.4,11,22,5.03,"PAH",36,1,547,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,548,0)="     Copy down the IP and port number used for VDEFVIE3."
^DIC(9.4,11,22,5.03,"PAH",36,1,549,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,550,0)="     Use the HL7 Main Menu, Filers option to edit VDEFVIE4.  "
^DIC(9.4,11,22,5.03,"PAH",36,1,551,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,552,0)="     Enable auto startup and add the same IP and port numbers used for"
^DIC(9.4,11,22,5.03,"PAH",36,1,553,0)="     VDEFVIE3."
^DIC(9.4,11,22,5.03,"PAH",36,1,554,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,555,0)="     Use the HL7 Main Menu, Start/Stop Links option to start the VDEFVIE4"
^DIC(9.4,11,22,5.03,"PAH",36,1,556,0)="     link."
^DIC(9.4,11,22,5.03,"PAH",36,1,557,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,558,0)="     Use the HL7 Main Menu, Site Parameters option to select VDEF view"
^DIC(9.4,11,22,5.03,"PAH",36,1,559,0)="     and add VDEFVIE4 to the view."
^DIC(9.4,11,22,5.03,"PAH",36,1,560,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,561,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,562,0)=" b. To activate the interface to the VA HDR use Protocol Edit option"
^DIC(9.4,11,22,5.03,"PAH",36,1,563,0)="   [HL EDIT INTERFACE] on the HL package Interface Developer Options"
^DIC(9.4,11,22,5.03,"PAH",36,1,564,0)="   [HL MENU INTERFACE TK] menu option and edit protocol LA7 LAB RESULTS"
^DIC(9.4,11,22,5.03,"PAH",36,1,565,0)="   TO HDR (SUB). Go to the second ScreenMan screen and edit the field"
^DIC(9.4,11,22,5.03,"PAH",36,1,566,0)="   ROUTING LOGIC and remove the leading "";"" character and enter the"
^DIC(9.4,11,22,5.03,"PAH",36,1,567,0)="   'save' command to save the changes to the protocol."
^DIC(9.4,11,22,5.03,"PAH",36,1,568,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,569,0)="                          HL7 SUBSCRIBER                       PAGE 2 OF 2"
^DIC(9.4,11,22,5.03,"PAH",36,1,570,0)="                         LA7 LAB RESULTS TO HDR (SUB)"
^DIC(9.4,11,22,5.03,"PAH",36,1,571,0)="---------------------------------------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",36,1,572,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,573,0)="      RECEIVING APPLICATION: LA7HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,574,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,575,0)="      RESPONSE MESSAGE TYPE: ACK                            EVENT TYPE: R01"
^DIC(9.4,11,22,5.03,"PAH",36,1,576,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,577,0)=" SENDING FACILITY REQUIRED?: YES          RECEIVING FACILITY REQUIRED?: YES"
^DIC(9.4,11,22,5.03,"PAH",36,1,578,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,579,0)="         SECURITY REQUIRED?:"
^DIC(9.4,11,22,5.03,"PAH",36,1,580,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,581,0)="               LOGICAL LINK: VDEFVIE4"
^DIC(9.4,11,22,5.03,"PAH",36,1,582,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,583,0)=" PROCESSING RTN:"
^DIC(9.4,11,22,5.03,"PAH",36,1,584,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,585,0)="  ROUTING LOGIC: ;D RTR^LA7HDR(""CH;"")  <-- remove leading "";"" character"
^DIC(9.4,11,22,5.03,"PAH",36,1,586,0)="____________________________________________________________________________"
^DIC(9.4,11,22,5.03,"PAH",36,1,587,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,588,0)="COMMAND:                                     Press <PF1>H for help    Insert"
^DIC(9.4,11,22,5.03,"PAH",36,1,589,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,590,0)="After the change the field should look like:"
^DIC(9.4,11,22,5.03,"PAH",36,1,591,0)="  ROUTING LOGIC: D RTR^LA7HDR(""CH;"")"
^DIC(9.4,11,22,5.03,"PAH",36,1,592,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,593,0)="3. To transmit Lab HL7 ORU result messages to another system, i.e."
^DIC(9.4,11,22,5.03,"PAH",36,1,594,0)="   Commercial Off the Shelf System (COTS)."
^DIC(9.4,11,22,5.03,"PAH",36,1,595,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,596,0)=" a. Create a HL7 subscriber protocol as documented in HL7 Site Manager &"
^DIC(9.4,11,22,5.03,"PAH",36,1,597,0)="    Developer Manual version 1.6*56"
^DIC(9.4,11,22,5.03,"PAH",36,1,598,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,599,0)=" b. Attach this protocol as a subscriber to HL7 event protocol LA7 LAB"
^DIC(9.4,11,22,5.03,"PAH",36,1,600,0)="    RESULTS AVAILABLE (EVN). Use Protocol Edit option [HL EDIT INTERFACE]"
^DIC(9.4,11,22,5.03,"PAH",36,1,601,0)="    on the HL package Interface Developer Options [HL MENU INTERFACE TK]"
^DIC(9.4,11,22,5.03,"PAH",36,1,602,0)="    menu option to add this subscriber."
^DIC(9.4,11,22,5.03,"PAH",36,1,603,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,604,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,605,0)="4. Controlling message generation and transmission."
^DIC(9.4,11,22,5.03,"PAH",36,1,606,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,607,0)="   Notify the HDR Project Office in the event that this interface is"
^DIC(9.4,11,22,5.03,"PAH",36,1,608,0)="   deactivated and the interface to the HDR was previously activated"
^DIC(9.4,11,22,5.03,"PAH",36,1,609,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,610,0)="   a. To turn off message building and transmission to ALL subscribers"
^DIC(9.4,11,22,5.03,"PAH",36,1,611,0)="      of event protocol LA7 LAB RESULTS AVAILABLE (EVN)."
^DIC(9.4,11,22,5.03,"PAH",36,1,612,0)="      Disable the configuration 'LA7HDR' in LA7 MESSAGE PARAMETER file"
^DIC(9.4,11,22,5.03,"PAH",36,1,613,0)="      (#62.48). This is accomplished by setting the field STATUS (#2) to"
^DIC(9.4,11,22,5.03,"PAH",36,1,614,0)="      'INACTIVE' using VA File Manager Enter or Edit File Entries [DIEDIT]."
^DIC(9.4,11,22,5.03,"PAH",36,1,615,0)="      Setting this field to 'INACTIVE' will turn off generation of this Lab"
^DIC(9.4,11,22,5.03,"PAH",36,1,616,0)="      HL7 message."
^DIC(9.4,11,22,5.03,"PAH",36,1,617,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,618,0)="   b. To turn off message transmission to a specific subscriber."
^DIC(9.4,11,22,5.03,"PAH",36,1,619,0)="      On the HL package, Interface Developer Options [HL MENU INTERFACE"
^DIC(9.4,11,22,5.03,"PAH",36,1,620,0)="      TK] menu option, use the Protocol Edit [HL EDIT INTERFACE] option to"
^DIC(9.4,11,22,5.03,"PAH",36,1,621,0)="      remove the related subscriber protocol from the event protocol LA7"
^DIC(9.4,11,22,5.03,"PAH",36,1,622,0)="      LAB RESULTS AVAILABLE (EVN)."
^DIC(9.4,11,22,5.03,"PAH",36,1,623,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,624,0)="      For the VA HDR, remove subscriber protocol LA7 LAB RESULTS TO HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,625,0)="      (SUB)."
^DIC(9.4,11,22,5.03,"PAH",36,1,626,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,627,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,628,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,629,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,630,0)="INSTALLATION EXAMPLE"
^DIC(9.4,11,22,5.03,"PAH",36,1,631,0)="===================="
^DIC(9.4,11,22,5.03,"PAH",36,1,632,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,633,0)="Select Installation Option: 6  Install Package(s) "
^DIC(9.4,11,22,5.03,"PAH",36,1,634,0)="Select INSTALL NAME: LA*5.2*68 Loaded from Distribution  2/4/05@10:21"
^DIC(9.4,11,22,5.03,"PAH",36,1,635,0)="     => LA*5.2*68"
^DIC(9.4,11,22,5.03,"PAH",36,1,636,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,637,0)="This Distribution was loaded on Feb 04, 2005@10:21 with header of"
