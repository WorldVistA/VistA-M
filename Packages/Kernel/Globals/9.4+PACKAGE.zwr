^DIC(9.4,72,7)="^^I"
^DIC(9.4,72,11)="190^195"
^DIC(9.4,72,22,0)="^9.49I^2^1"
^DIC(9.4,72,22,2,0)="2.0^3051119^2960715"
^DIC(9.4,72,22,2,"PAH",0)="^9.4901^20^20"
^DIC(9.4,72,22,2,"PAH",1,0)="26^2960716^1"
^DIC(9.4,72,22,2,"PAH",1,1,0)="^^1^1^2960716"
^DIC(9.4,72,22,2,"PAH",1,1,1,0)="See National Patch Module for details on changes included in this build."
^DIC(9.4,72,22,2,"PAH",2,0)="27^2960716^1"
^DIC(9.4,72,22,2,"PAH",2,1,0)="^^1^1^2960716"
^DIC(9.4,72,22,2,"PAH",2,1,1,0)="Resets IO to home device.  In response to NOIS SLC-0496-51149."
^DIC(9.4,72,22,2,"PAH",3,0)="29 SEQ #28^2971213^1"
^DIC(9.4,72,22,2,"PAH",4,0)="30 SEQ #29^2980227^1"
^DIC(9.4,72,22,2,"PAH",4,1,0)="^^2^2^2980227"
^DIC(9.4,72,22,2,"PAH",4,1,1,0)="Be sure patch RT*2*4 has been installed before installing this patch."
^DIC(9.4,72,22,2,"PAH",4,1,2,0)="See the National Patch Module for more details on this patch."
^DIC(9.4,72,22,2,"PAH",5,0)="32 SEQ #30^2980330^1"
^DIC(9.4,72,22,2,"PAH",5,1,0)="^^1^1^2980330"
^DIC(9.4,72,22,2,"PAH",5,1,1,0)=" See the patch description for RT*2*32 in the patch module."
^DIC(9.4,72,22,2,"PAH",6,0)="31 SEQ #31^3030329^1"
^DIC(9.4,72,22,2,"PAH",6,1,0)="^^2^2^3030329"
^DIC(9.4,72,22,2,"PAH",6,1,1,0)="This patch fixes problems related to trace movement history"
^DIC(9.4,72,22,2,"PAH",6,1,2,0)="and new volumes."
^DIC(9.4,72,22,2,"PAH",7,0)="34 SEQ #32^3030329^1"
^DIC(9.4,72,22,2,"PAH",7,1,0)="^^3^3^3030329"
^DIC(9.4,72,22,2,"PAH",7,1,1,0)="This build changes two routines to improve and correct the "
^DIC(9.4,72,22,2,"PAH",7,1,2,0)="'Generate Record Retirement Pull Lists' option.  "
^DIC(9.4,72,22,2,"PAH",7,1,3,0)="See patch description for more details. "
^DIC(9.4,72,22,2,"PAH",8,0)="33 SEQ #33^3030628^1"
^DIC(9.4,72,22,2,"PAH",8,1,0)="^^2^2^3030628"
^DIC(9.4,72,22,2,"PAH",8,1,1,0)="This build reintroduces the patient sensitivity/security check "
^DIC(9.4,72,22,2,"PAH",8,1,2,0)="and fixes other misc. problems."
^DIC(9.4,72,22,2,"PAH",9,0)="35 SEQ #34^3030628^1"
^DIC(9.4,72,22,2,"PAH",9,1,0)="^^1^1^3030628"
^DIC(9.4,72,22,2,"PAH",9,1,1,0)="Checks that device can be queued to and fixes other NOISes."
^DIC(9.4,72,22,2,"PAH",10,0)="36 SEQ #35^3031023^1"
^DIC(9.4,72,22,2,"PAH",10,1,0)="^^2^2^3031023"
^DIC(9.4,72,22,2,"PAH",10,1,1,0)="When printing the CONSOLIDATED HEALTH RECORD INQUIRY report, dates are "
^DIC(9.4,72,22,2,"PAH",10,1,2,0)="printed in internal format, but should be printed in external format."
^DIC(9.4,72,22,2,"PAH",11,0)="38 SEQ #36^3031231^1"
^DIC(9.4,72,22,2,"PAH",11,1,0)="^^2^2^3031231"
^DIC(9.4,72,22,2,"PAH",11,1,1,0)="This patch modifies the the if condition at WHOTO^RTTR1 from 'OR' to "
^DIC(9.4,72,22,2,"PAH",11,1,2,0)="'AND'."
^DIC(9.4,72,22,2,"PAH",12,0)="39 SEQ #37^3040131^1"
^DIC(9.4,72,22,2,"PAH",12,1,0)="^^6^6^3040131"
^DIC(9.4,72,22,2,"PAH",12,1,1,0)="To correct the scanning problem, routine RTDPA will be modified to look "
^DIC(9.4,72,22,2,"PAH",12,1,2,0)="for a match if the barcode scanned cannot be found.  The program will "
^DIC(9.4,72,22,2,"PAH",12,1,3,0)="display the possible match with general patient information and prompt "
^DIC(9.4,72,22,2,"PAH",12,1,4,0)="the user to confirm the match.  If the user accepts the match, the "
^DIC(9.4,72,22,2,"PAH",12,1,5,0)="program will store the barcode information scanned in field 300 OLD "
^DIC(9.4,72,22,2,"PAH",12,1,6,0)="BARCODE of RECORDS file (#190) to be referenced later."
^DIC(9.4,72,22,2,"PAH",13,0)="37 SEQ #38^3040330^1"
^DIC(9.4,72,22,2,"PAH",13,1,0)="^^4^4^3040330"
^DIC(9.4,72,22,2,"PAH",13,1,1,0)="This build modifies routines RTSYS and RTP3 to correct problems reported "
^DIC(9.4,72,22,2,"PAH",13,1,2,0)="in NOIS calls:"
^DIC(9.4,72,22,2,"PAH",13,1,3,0)="STC-0403-42187  Borrower Set Up Option"
^DIC(9.4,72,22,2,"PAH",13,1,4,0)="UNY-0303-11769  C&P Records are getting requested on a regular Pull List"
^DIC(9.4,72,22,2,"PAH",14,0)="40 SEQ #39^3040427^1"
^DIC(9.4,72,22,2,"PAH",14,1,0)="^^2^2^3040427"
^DIC(9.4,72,22,2,"PAH",14,1,1,0)=" "
^DIC(9.4,72,22,2,"PAH",14,1,2,0)="Record Tracking NOIS"
^DIC(9.4,72,22,2,"PAH",15,0)="41 SEQ #40^3041029^1"
^DIC(9.4,72,22,2,"PAH",15,1,0)="^^2^2^3041029"
^DIC(9.4,72,22,2,"PAH",15,1,1,0)=" "
^DIC(9.4,72,22,2,"PAH",15,1,2,0)="Record Tracking Clinic Request Initializer Mail Message Fix"
^DIC(9.4,72,22,2,"PAH",16,0)="43 SEQ #41^3050212^1"
^DIC(9.4,72,22,2,"PAH",16,1,0)="^^1^1^3050212"
^DIC(9.4,72,22,2,"PAH",16,1,1,0)="PROBLEMS CREATED BY RT*2.0*37"
^DIC(9.4,72,22,2,"PAH",17,0)="45 SEQ #42^3080203.223427^1"
^DIC(9.4,72,22,2,"PAH",17,1,0)="^^2^2^3080203"
^DIC(9.4,72,22,2,"PAH",17,1,1,0)="Delete Record Tracking menu option and correct an undefined error when "
^DIC(9.4,72,22,2,"PAH",17,1,2,0)="using the [RT SM-CLINIC REQUESTS] option."
^DIC(9.4,72,22,2,"PAH",18,0)="46 SEQ #43^3100324.091959^17"
^DIC(9.4,72,22,2,"PAH",18,1,0)="^^8^8^3100324"
^DIC(9.4,72,22,2,"PAH",18,1,1,0)=" This patch addresses an issue reported in the Record Tracking (RT)"
^DIC(9.4,72,22,2,"PAH",18,1,2,0)=" package.  This issue is that the software allows the user to enter"
^DIC(9.4,72,22,2,"PAH",18,1,3,0)=" the Record Tracking Total System Menu [RT OVERALL] menu option "
^DIC(9.4,72,22,2,"PAH",18,1,4,0)=" without setting the INSTITUTION parameters.  When users try to use "
^DIC(9.4,72,22,2,"PAH",18,1,5,0)=" the Charge Out Pull List Records [RT PULL-CHARGE-OUT] menu option "
^DIC(9.4,72,22,2,"PAH",18,1,6,0)=" they receive the following message: ""This function requires the "
^DIC(9.4,72,22,2,"PAH",18,1,7,0)=" user to be signed onto the system with INSTITUTION parameters defined."""
^DIC(9.4,72,22,2,"PAH",18,1,8,0)=" They are then bumped out and are returned to the original menu."
^DIC(9.4,72,22,2,"PAH",19,0)="47 SEQ #44^3180601.151923^54"
^DIC(9.4,72,22,2,"PAH",20,0)="49 SEQ #45^3240903.102818^89"
^DIC(9.4,72,22,2,"PAH",20,1,0)="^^2^2^3240903"
^DIC(9.4,72,22,2,"PAH",20,1,1,0)="The purpose of this patch is to edit TERM^RTSM7 and avoid a run-away "
^DIC(9.4,72,22,2,"PAH",20,1,2,0)="issue caused by occasional bad nodes in the New Person File VA(200"
