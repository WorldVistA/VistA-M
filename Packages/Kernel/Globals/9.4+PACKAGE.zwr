^DIC(9.4,14,22,5.9,"PAH",99,1,469,0)=""
^DIC(9.4,14,22,5.9,"PAH",99,1,470,0)="POST-INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",99,1,471,0)="------------------------------"
^DIC(9.4,14,22,5.9,"PAH",99,1,472,0)=""
^DIC(9.4,14,22,5.9,"PAH",99,1,473,0)="1. If the site is using either the Intermec or Zebra brand printers,"
^DIC(9.4,14,22,5.9,"PAH",99,1,474,0)="each printer used to print labels within the Laboratory package needs to be"
^DIC(9.4,14,22,5.9,"PAH",99,1,475,0)="defined within the Laboratory files. Use FileMan Enter/Edit option to"
^DIC(9.4,14,22,5.9,"PAH",99,1,476,0)="edit file LABORATORY SITE (#69.9). An example follows:"
^DIC(9.4,14,22,5.9,"PAH",99,1,477,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,478,0)="Select VA FileMan Option: 1  Enter or Edit File Entries"
^DIC(9.4,14,22,5.9,"PAH",99,1,479,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,480,0)="INPUT TO WHAT FILE: LABORATORY SITE//"
^DIC(9.4,14,22,5.9,"PAH",99,1,481,0)="EDIT WHICH FIELD: ALL// LABEL DEVICE    (multiple)"
^DIC(9.4,14,22,5.9,"PAH",99,1,482,0)="   EDIT WHICH LABEL DEVICE SUB-FIELD: ALL//"
^DIC(9.4,14,22,5.9,"PAH",99,1,483,0)="THEN EDIT FIELD:"
^DIC(9.4,14,22,5.9,"PAH",99,1,484,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,485,0)="Select LABORATORY SITE SITE NAME:    MILWAUKEE, WI 53295"
^DIC(9.4,14,22,5.9,"PAH",99,1,486,0)="Select LABEL DEVICE: IRM DEVELOP INTERMEC 4100//"
^DIC(9.4,14,22,5.9,"PAH",99,1,487,0)="  LABEL DEVICE: IRM DEVELOP INTERMEC 4100//"
^DIC(9.4,14,22,5.9,"PAH",99,1,488,0)="  PRINTER TYPE: INTERMEC 3000/4000 SERIES// ?"
^DIC(9.4,14,22,5.9,"PAH",99,1,489,0)="     Enter the type of label printer attached to this device."
^DIC(9.4,14,22,5.9,"PAH",99,1,490,0)="     Choose from:"
^DIC(9.4,14,22,5.9,"PAH",99,1,491,0)="       0        OTHER"
^DIC(9.4,14,22,5.9,"PAH",99,1,492,0)="       1        INTERMEC 3000/4000 SERIES"
^DIC(9.4,14,22,5.9,"PAH",99,1,493,0)="       2        ZEBRA ZPL II COMPATIBLE"
^DIC(9.4,14,22,5.9,"PAH",99,1,494,0)="  PRINTER TYPE: INTERMEC 3000/4000 SERIES//"
^DIC(9.4,14,22,5.9,"PAH",99,1,495,0)="  LABEL STOCK: 1X3// ?"
^DIC(9.4,14,22,5.9,"PAH",99,1,496,0)="     Select the type of label stock loaded in this device."
^DIC(9.4,14,22,5.9,"PAH",99,1,497,0)="     Choose from:"
^DIC(9.4,14,22,5.9,"PAH",99,1,498,0)="       0        OTHER"
^DIC(9.4,14,22,5.9,"PAH",99,1,499,0)="       1        1X3"
^DIC(9.4,14,22,5.9,"PAH",99,1,500,0)="       2        1X2"
^DIC(9.4,14,22,5.9,"PAH",99,1,501,0)="       3        2.5X4 10 PART"
^DIC(9.4,14,22,5.9,"PAH",99,1,502,0)="  LABEL STOCK: 1X3//"
^DIC(9.4,14,22,5.9,"PAH",99,1,503,0)="  ALTERNATE LABEL ENTRY:"
^DIC(9.4,14,22,5.9,"PAH",99,1,504,0)="  ALTERNATE LABEL ROUTINE:"
^DIC(9.4,14,22,5.9,"PAH",99,1,505,0)="  DEFAULT ACCESSION AREA: CHEMISTRY//"
^DIC(9.4,14,22,5.9,"PAH",99,1,506,0)="Select LABEL DEVICE:"
^DIC(9.4,14,22,5.9,"PAH",99,1,507,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,508,0)="2. If the site is using Intermec printers and 1x2 or 10 part label stock"
^DIC(9.4,14,22,5.9,"PAH",99,1,509,0)="   then the following formats need to be downloaded to each printer"
^DIC(9.4,14,22,5.9,"PAH",99,1,510,0)="   as appropriate:"
^DIC(9.4,14,22,5.9,"PAH",99,1,511,0)="         1x2 label - formats 3,4,5"
^DIC(9.4,14,22,5.9,"PAH",99,1,512,0)="     10 part label - formats 12,13"
^DIC(9.4,14,22,5.9,"PAH",99,1,513,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,514,0)="   Use option Lab Bar Code Label Formatter [LR BAR CF] to perform this"
^DIC(9.4,14,22,5.9,"PAH",99,1,515,0)="   function."
^DIC(9.4,14,22,5.9,"PAH",99,1,516,0)=" "
^DIC(9.4,14,22,5.9,"PAH",99,1,517,0)="3. If the site will be using Zebra brand printers then review manufacturer's"
^DIC(9.4,14,22,5.9,"PAH",99,1,518,0)="   user guide for installation, setup and calibration instructions."
^DIC(9.4,14,22,5.9,"PAH",99,1,519,0)="   Adjustments to some printer parameters can be performed via"
^DIC(9.4,14,22,5.9,"PAH",99,1,520,0)="   Lab Zebra Label Utility [LR BAR ZEBRA UTILITY] option. Review the"
^DIC(9.4,14,22,5.9,"PAH",99,1,521,0)="   option description for further information relating to the capabilities"
^DIC(9.4,14,22,5.9,"PAH",99,1,522,0)="   provided by this option."
^DIC(9.4,14,22,5.9,"PAH",100,0)="260^3000905^1"
^DIC(9.4,14,22,5.9,"PAH",100,1,0)="^^232^232^3000905"
^DIC(9.4,14,22,5.9,"PAH",100,1,1,0)="This patch adds two new segments to the HL7 transmissions generated by"
^DIC(9.4,14,22,5.9,"PAH",100,1,2,0)=" the Emerging Pathogens Initiative (EPI) software, clears fifteen "
^DIC(9.4,14,22,5.9,"PAH",100,1,3,0)=" NOIS calls, and eliminates the National Center for Health Promotion"
^DIC(9.4,14,22,5.9,"PAH",100,1,4,0)=" (NCH) data transmissions."
^DIC(9.4,14,22,5.9,"PAH",100,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,6,0)=" The new segments are:"
^DIC(9.4,14,22,5.9,"PAH",100,1,7,0)=" ABBREVIATED NAME: ZXE       FULL NAME: Pharmacy Prescription Order"
^DIC(9.4,14,22,5.9,"PAH",100,1,8,0)="                   This segment will report Pharmacy data consisting of"
^DIC(9.4,14,22,5.9,"PAH",100,1,9,0)="                   the Drug Name, NDC, and Days Supply."
^DIC(9.4,14,22,5.9,"PAH",100,1,10,0)=" ABBREVIATED NAME: DSP       FULL NAME: Display Data"
^DIC(9.4,14,22,5.9,"PAH",100,1,11,0)="                   This segment will report Clinical Reminders Hepatitis"
^DIC(9.4,14,22,5.9,"PAH",100,1,12,0)="                   C Risk Assessment Data."
^DIC(9.4,14,22,5.9,"PAH",100,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,14,0)="This patch also includes the new LREPI REMINDER LINK file (#69.51)."
^DIC(9.4,14,22,5.9,"PAH",100,1,15,0)=" This file points to the REMINDER DEFINITION (#811.9) used by the "
^DIC(9.4,14,22,5.9,"PAH",100,1,16,0)=" Emerging Pathogens Initiative (EPI). Entries in the new LREPI REMINDER"
^DIC(9.4,14,22,5.9,"PAH",100,1,17,0)=" LINK file are used to determine which Clinical Reminders will be used to"
^DIC(9.4,14,22,5.9,"PAH",100,1,18,0)=" generate data for the Hepatitis C database."
^DIC(9.4,14,22,5.9,"PAH",100,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,20,0)=" The NOIS calls addressed are:"
^DIC(9.4,14,22,5.9,"PAH",100,1,21,0)="        1. ALX-0400-71108"
^DIC(9.4,14,22,5.9,"PAH",100,1,22,0)="           ALB-0100-52818"
^DIC(9.4,14,22,5.9,"PAH",100,1,23,0)="           BHH-0999-40058"
^DIC(9.4,14,22,5.9,"PAH",100,1,24,0)="           NCH-0599-42202"
^DIC(9.4,14,22,5.9,"PAH",100,1,25,0)="           WAS-0499-21751"
^DIC(9.4,14,22,5.9,"PAH",100,1,26,0)="           MRN-0299-40846"
^DIC(9.4,14,22,5.9,"PAH",100,1,27,0)="           CIN-0199-42742"
^DIC(9.4,14,22,5.9,"PAH",100,1,28,0)="           ALB-1198-50947"
^DIC(9.4,14,22,5.9,"PAH",100,1,29,0)="           BRK-1198-10546"
^DIC(9.4,14,22,5.9,"PAH",100,1,30,0)="           SUX-0599-40961"
^DIC(9.4,14,22,5.9,"PAH",100,1,31,0)="           PUG-0399-52619"
^DIC(9.4,14,22,5.9,"PAH",100,1,32,0)="           MEM-0199-72168"
^DIC(9.4,14,22,5.9,"PAH",100,1,33,0)="                  Several sites have reported receiving a "
^DIC(9.4,14,22,5.9,"PAH",100,1,34,0)="                  SEARCH+3^LREPI4 error during the nightly runs.  This"
^DIC(9.4,14,22,5.9,"PAH",100,1,35,0)="                  is due to an incomplete PTF record.  The software now"
^DIC(9.4,14,22,5.9,"PAH",100,1,36,0)="                  checks the validity of the reference before attempting"
^DIC(9.4,14,22,5.9,"PAH",100,1,37,0)="                  to access the record."
^DIC(9.4,14,22,5.9,"PAH",100,1,38,0)="        2. LAS-1199-61337"
^DIC(9.4,14,22,5.9,"PAH",100,1,39,0)="           WPB-1298-30488"
^DIC(9.4,14,22,5.9,"PAH",100,1,40,0)="                  These NOIS calls report an error in the way the site "
^DIC(9.4,14,22,5.9,"PAH",100,1,41,0)="                  number is obtained.  An older method of gathering the"
^DIC(9.4,14,22,5.9,"PAH",100,1,42,0)="                  site number was used.  This has been replaced with a"
^DIC(9.4,14,22,5.9,"PAH",100,1,43,0)="                  FileMan reference as allowed in DBIA #10090."
^DIC(9.4,14,22,5.9,"PAH",100,1,44,0)="        3. STC-1098-41570"
^DIC(9.4,14,22,5.9,"PAH",100,1,45,0)="                  The NCH transmissions will be eliminated with the"
^DIC(9.4,14,22,5.9,"PAH",100,1,46,0)="                  release of this patch."
^DIC(9.4,14,22,5.9,"PAH",100,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,48,0)="  Requesting Site: Washington, DC"
^DIC(9.4,14,22,5.9,"PAH",100,1,49,0)="                   Cincinnati, OH"
^DIC(9.4,14,22,5.9,"PAH",100,1,50,0)="  "
^DIC(9.4,14,22,5.9,"PAH",100,1,51,0)="     Test Site(s): Cincinnati, OH"
^DIC(9.4,14,22,5.9,"PAH",100,1,52,0)="                   West Palm Beach, FL"
^DIC(9.4,14,22,5.9,"PAH",100,1,53,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,54,0)="   Reference NOIS: ALX-0400-71108"
^DIC(9.4,14,22,5.9,"PAH",100,1,55,0)="                   ALB-0100-52818"
^DIC(9.4,14,22,5.9,"PAH",100,1,56,0)="                   BHH-0999-40058"
^DIC(9.4,14,22,5.9,"PAH",100,1,57,0)="                   NCH-0599-42202"
^DIC(9.4,14,22,5.9,"PAH",100,1,58,0)="                   WAS-0499-21751"
^DIC(9.4,14,22,5.9,"PAH",100,1,59,0)="                   MRN-0299-40846"
^DIC(9.4,14,22,5.9,"PAH",100,1,60,0)="                   CIN-0199-42742"
^DIC(9.4,14,22,5.9,"PAH",100,1,61,0)="                   ALB-1198-50947"
^DIC(9.4,14,22,5.9,"PAH",100,1,62,0)="                   BRK-1198-10546"
^DIC(9.4,14,22,5.9,"PAH",100,1,63,0)="                   SUX-0599-40961"
^DIC(9.4,14,22,5.9,"PAH",100,1,64,0)="                   PUG-0399-52619"
^DIC(9.4,14,22,5.9,"PAH",100,1,65,0)="                   MEM-0199-72168"
^DIC(9.4,14,22,5.9,"PAH",100,1,66,0)="                   LAS-1199-61337"
^DIC(9.4,14,22,5.9,"PAH",100,1,67,0)="                   WPB-1298-30488"
^DIC(9.4,14,22,5.9,"PAH",100,1,68,0)="                   STC-1098-41570"
^DIC(9.4,14,22,5.9,"PAH",100,1,69,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,70,0)="The daily National Center for Health Promotion (NCH) data transmissions"
^DIC(9.4,14,22,5.9,"PAH",100,1,71,0)=" are no longer necessary and the NCHP program office has requested that"
^DIC(9.4,14,22,5.9,"PAH",100,1,72,0)=" we terminate the transmissions.  This will be done during the post-init"
^DIC(9.4,14,22,5.9,"PAH",100,1,73,0)=" phase and does not require any user intervention."
^DIC(9.4,14,22,5.9,"PAH",100,1,74,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,75,0)=" This patch to the Laboratory package does not contain any changes to the"
^DIC(9.4,14,22,5.9,"PAH",100,1,76,0)=" VISTA BLOOD BANK Software as defined by VHA DIRECTIVE 99-053 titled VISTA"
^DIC(9.4,14,22,5.9,"PAH",100,1,77,0)=" BLOOD BANK SOFTWARE."
^DIC(9.4,14,22,5.9,"PAH",100,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,79,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,80,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",100,1,81,0)=" ==============="
^DIC(9.4,14,22,5.9,"PAH",100,1,82,0)=" The following is a list of routines included in this patch.  The second"
^DIC(9.4,14,22,5.9,"PAH",100,1,83,0)=" line of each routine now looks like:"
^DIC(9.4,14,22,5.9,"PAH",100,1,84,0)="  "
