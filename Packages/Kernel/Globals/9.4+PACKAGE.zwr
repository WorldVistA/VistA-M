^DIC(9.4,44,22,3,"PAH",10,1,1,0)="See National Patch Module for complete details of enhancements."
^DIC(9.4,44,22,3,"PAH",11,0)="9 SEQ #11^3000306^1"
^DIC(9.4,44,22,3,"PAH",11,1,0)="^^1^1^3000306"
^DIC(9.4,44,22,3,"PAH",11,1,1,0)="See national patch module for description of this patch."
^DIC(9.4,44,22,3,"PAH",12,0)="7 SEQ #12^3000516^1"
^DIC(9.4,44,22,3,"PAH",12,1,0)="^^11^11^3000516"
^DIC(9.4,44,22,3,"PAH",12,1,1,0)="Changes to the Completion Time Statistics and Service Consults By"
^DIC(9.4,44,22,3,"PAH",12,1,2,0)="Status (including Service Consults Pending Resolution) reports."
^DIC(9.4,44,22,3,"PAH",12,1,3,0)=""
^DIC(9.4,44,22,3,"PAH",12,1,4,0)="Do to a problem with KIDS and List Templates the template ""GMRC PENDING "
^DIC(9.4,44,22,3,"PAH",12,1,5,0)="CONSULTS"" would not work correctly.  There will be a Post Install routine "
^DIC(9.4,44,22,3,"PAH",12,1,6,0)="(GMRC7L) that will install the ""GMRC PENDING CONSULTS"" template."
^DIC(9.4,44,22,3,"PAH",12,1,7,0)=""
^DIC(9.4,44,22,3,"PAH",12,1,8,0)="KIDS will install the other List Template (GMRC REQUEST COMPLETE STAT)."
^DIC(9.4,44,22,3,"PAH",12,1,9,0)=" "
^DIC(9.4,44,22,3,"PAH",12,1,10,0)="A description of the this build can be found on the NATIONAL PATCH MODULE "
^DIC(9.4,44,22,3,"PAH",12,1,11,0)="UNDER GMRC*3.0*7."
