^DIC(9.4,14,22,5.9,"PAH",207,1,240,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,241,0)="RISK ANALYSIS: The changes made by patch LR*5.2*335 affect Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",207,1,242,0)="software functionality, however the RISK is considered to be low."
^DIC(9.4,14,22,5.9,"PAH",207,1,243,0)="  Inappropriate use of the ""Disable VistA Blood Bank components"""
^DIC(9.4,14,22,5.9,"PAH",207,1,244,0)="  [VBEC BB COMPONENTS DISABLE] option can disable the VistA 5.2"
^DIC(9.4,14,22,5.9,"PAH",207,1,245,0)="  Blood Bank system.  This risk is minimal since the ""Enable VistA"
^DIC(9.4,14,22,5.9,"PAH",207,1,246,0)="  Blood Bank components"" [VBEC BB COMPONENTS ENABLE] option can be"
^DIC(9.4,14,22,5.9,"PAH",207,1,247,0)="  used to restore full operations."
^DIC(9.4,14,22,5.9,"PAH",207,1,248,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,249,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*335 does not "
^DIC(9.4,14,22,5.9,"PAH",207,1,250,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",207,1,251,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",207,1,252,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,253,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 0 routines and "
^DIC(9.4,14,22,5.9,"PAH",207,1,254,0)="4 files identified in Veterans Health Administration (VHA) Directive "
^DIC(9.4,14,22,5.9,"PAH",207,1,255,0)="2004-058, group B listing. The changes have no effect on medical device "
^DIC(9.4,14,22,5.9,"PAH",207,1,256,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",207,1,257,0)="  This is the final step prior to the transfer of Blood Bank operations"
^DIC(9.4,14,22,5.9,"PAH",207,1,258,0)="  to the VBECS system. All future impact will be dealt with through VBECS"
^DIC(9.4,14,22,5.9,"PAH",207,1,259,0)="  development"
^DIC(9.4,14,22,5.9,"PAH",207,1,260,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,261,0)="VALIDATION REQUIREMENTS BY OPTION:"
^DIC(9.4,14,22,5.9,"PAH",207,1,262,0)="  No VistA Blood Bank 5.2 options are released with this patch."
^DIC(9.4,14,22,5.9,"PAH",207,1,263,0)="  However, the options listed above should be tested to ensure that"
^DIC(9.4,14,22,5.9,"PAH",207,1,264,0)="  they have been disabled after the completion of the data conversion."
^DIC(9.4,14,22,5.9,"PAH",207,1,265,0)="   "
^DIC(9.4,14,22,5.9,"PAH",207,1,266,0)=" "
