^DIC(9.4,47,22,5.9,"PAH",301,0)="259 SEQ #380^3020327^1"
^DIC(9.4,47,22,5.9,"PAH",301,1,0)="^^5^5^3020327"
^DIC(9.4,47,22,5.9,"PAH",301,1,1,0)="A new API named APLD^DGUTL2 has been created with this patch. The API"
^DIC(9.4,47,22,5.9,"PAH",301,1,2,0)="APLD^DGUTL2 will return the specific dates and total days for a patient's"
^DIC(9.4,47,22,5.9,"PAH",301,1,3,0)="PASS, LEAVE and ASIH for the billing period specified.  APLD^DGUTL2 will"
^DIC(9.4,47,22,5.9,"PAH",301,1,4,0)="generate a -1 extrinsically if the parameters passed into the API are"
^DIC(9.4,47,22,5.9,"PAH",301,1,5,0)="invalid."
