^DIC(9.4,4,22,2,"PAH",8,1,4,0)="Test Site: Togus, ME"
^DIC(9.4,4,22,2,"PAH",8,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",8,1,6,0)="When using the option ""Read/Manage Messages"" and selecting to print a"
^DIC(9.4,4,22,2,"PAH",8,1,7,0)="message from the displayed list, if an ^ is entered at the device prompt"
^DIC(9.4,4,22,2,"PAH",8,1,8,0)="to abort, MailMan will echo back 1 message printed. Nothing actually"
^DIC(9.4,4,22,2,"PAH",8,1,9,0)="prints.  This patch fixes that."
^DIC(9.4,4,22,2,"PAH",8,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",8,1,11,0)="NOTE: This patch should be installed during off hours, when user activity"
