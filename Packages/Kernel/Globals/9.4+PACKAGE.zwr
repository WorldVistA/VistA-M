^DIC(9.4,47,22,5.9,"PAH",232,0)="314^3010228^1"
^DIC(9.4,47,22,5.9,"PAH",233,0)="250 SEQ #310^3010305^1"
^DIC(9.4,47,22,5.9,"PAH",233,1,0)="^^1^1^3010305"
^DIC(9.4,47,22,5.9,"PAH",233,1,1,0)="This patch solves a patient information display break problem, and patient lock problem."
^DIC(9.4,47,22,5.9,"PAH",234,0)="338 SEQ #311^3010319^1"
^DIC(9.4,47,22,5.9,"PAH",235,0)="354 SEQ #312^3010319^1"
^DIC(9.4,47,22,5.9,"PAH",235,1,0)="^^5^5^3010319"
^DIC(9.4,47,22,5.9,"PAH",235,1,1,0)="This patch will install a new version of routine DGRUHL1.  The new version"
^DIC(9.4,47,22,5.9,"PAH",235,1,2,0)="will send the DGRU REJECT bulletin to the DGRU RAI NOTIFICATION mail group"
^DIC(9.4,47,22,5.9,"PAH",235,1,3,0)="when an HL7 message gets rejected by the Accu-Med System and will include"
^DIC(9.4,47,22,5.9,"PAH",235,1,4,0)="the patient name, SSN, HL7 event code, reject reason, parent message ID,"
^DIC(9.4,47,22,5.9,"PAH",235,1,5,0)="and the date/time of the parent message."
^DIC(9.4,47,22,5.9,"PAH",236,0)="365 SEQ #313^3010319^1"
^DIC(9.4,47,22,5.9,"PAH",237,0)="367 SEQ #314^3010326^1"
^DIC(9.4,47,22,5.9,"PAH",237,1,0)="^^1^1^3010326"
^DIC(9.4,47,22,5.9,"PAH",237,1,1,0)="Please see National Patch Module for description of this Patch."
^DIC(9.4,47,22,5.9,"PAH",238,0)="362 SEQ #315^3010327^1"
^DIC(9.4,47,22,5.9,"PAH",239,0)="333 SEQ #316^3010405^1"
^DIC(9.4,47,22,5.9,"PAH",239,1,0)="^^3^3^3010405"
^DIC(9.4,47,22,5.9,"PAH",239,1,1,0)="PATIENT DATA REVIEW ENHANCEMENTS"
^DIC(9.4,47,22,5.9,"PAH",239,1,2,0)="Refer to patch DG*5.3*333 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",239,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",240,0)="360 SEQ #317^3010405^1"
^DIC(9.4,47,22,5.9,"PAH",240,1,0)="^^1^1^3010405"
^DIC(9.4,47,22,5.9,"PAH",240,1,1,0)="See Description in National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",241,0)="279 SEQ #318^3010405^1"
^DIC(9.4,47,22,5.9,"PAH",241,1,0)="^^1^1^3010405"
^DIC(9.4,47,22,5.9,"PAH",241,1,1,0)="Fixing problems with Inpatient List."
^DIC(9.4,47,22,5.9,"PAH",242,0)="343^3010412^1"
^DIC(9.4,47,22,5.9,"PAH",243,0)="357 SEQ #320^3010423^1"
^DIC(9.4,47,22,5.9,"PAH",244,0)="371 SEQ #321^3010423^1"
^DIC(9.4,47,22,5.9,"PAH",245,0)="374 SEQ #322^3010430^1"
^DIC(9.4,47,22,5.9,"PAH",245,1,0)="^^1^1^3010430"
^DIC(9.4,47,22,5.9,"PAH",245,1,1,0)="See Description in National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",246,0)="372 SEQ #323^3010507^1"
^DIC(9.4,47,22,5.9,"PAH",246,1,0)="^^1^1^3010507"
^DIC(9.4,47,22,5.9,"PAH",246,1,1,0)="KIDS Build for DG*5.3*372"
^DIC(9.4,47,22,5.9,"PAH",247,0)="286 SEQ #324^3010507^1"
^DIC(9.4,47,22,5.9,"PAH",247,1,0)="^^8^8^3010507"
^DIC(9.4,47,22,5.9,"PAH",247,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",247,1,2,0)=" Patch DG*5.3*286 addresses the Patient Inquiry issue noted in NOIS"
^DIC(9.4,47,22,5.9,"PAH",247,1,3,0)=" TAM-0799-31096."
^DIC(9.4,47,22,5.9,"PAH",247,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",247,1,5,0)=" Scheduled Admit data was being lost at the $$OKLINE(17) page break.   The"
^DIC(9.4,47,22,5.9,"PAH",247,1,6,0)=" ""X"" variable, holding the Scheduled Admits data was being overwritten"
^DIC(9.4,47,22,5.9,"PAH",247,1,7,0)=" whenever at the ^DIR call used to create the page break.  The situation"
^DIC(9.4,47,22,5.9,"PAH",247,1,8,0)=" was corrected by ""newing"" the ""X"" variable at the OKLINE call."
^DIC(9.4,47,22,5.9,"PAH",248,0)="377 SEQ #325^3010515^1"
^DIC(9.4,47,22,5.9,"PAH",248,1,0)="^^19^19^3010515"
^DIC(9.4,47,22,5.9,"PAH",248,1,1,0)="This patch addresses the issue that is described in the following NOIS:"
^DIC(9.4,47,22,5.9,"PAH",248,1,2,0)="            SLC-0401-51241:    ERROR:  EDITPH1+7^DGRPLE:1"
^DIC(9.4,47,22,5.9,"PAH",248,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",248,1,4,0)="This error resulted from processing an ORU-Z11 transmission from the HEC."
^DIC(9.4,47,22,5.9,"PAH",248,1,5,0)="When the record fails to update, the error ""undefined variable"
^DIC(9.4,47,22,5.9,"PAH",248,1,6,0)="^DPT(DFN,.53)"" causes the ORU-Z11 transmission to stop, and the remaining"
^DIC(9.4,47,22,5.9,"PAH",248,1,7,0)="record in the batch are not processed."
^DIC(9.4,47,22,5.9,"PAH",248,1,8,0)=" "
^DIC(9.4,47,22,5.9,"PAH",248,1,9,0)="The FileMan DIE calls have been replaced with Database Server calls."
^DIC(9.4,47,22,5.9,"PAH",248,1,10,0)="Should either of the two Database Server calls fail, a message will be"
^DIC(9.4,47,22,5.9,"PAH",248,1,11,0)="sent to the VistA mail group ""DGEN ELIGIBILITY ALERT"" and the HEC mail"
^DIC(9.4,47,22,5.9,"PAH",248,1,12,0)="group ""ELIGIBILITY ALERT"".  This will allow the remaining records in the"
^DIC(9.4,47,22,5.9,"PAH",248,1,13,0)="batch to be processed."
^DIC(9.4,47,22,5.9,"PAH",248,1,14,0)=" "
^DIC(9.4,47,22,5.9,"PAH",248,1,15,0)="The following messages will be returned when the Purple heart information"
^DIC(9.4,47,22,5.9,"PAH",248,1,16,0)="did not file correctly:"
^DIC(9.4,47,22,5.9,"PAH",248,1,17,0)=" "
^DIC(9.4,47,22,5.9,"PAH",248,1,18,0)="        Unable to update Purple Heart Data"
^DIC(9.4,47,22,5.9,"PAH",248,1,19,0)="        Unable to update Purple Heart History"
^DIC(9.4,47,22,5.9,"PAH",249,0)="366 SEQ #326^3010515^1"
^DIC(9.4,47,22,5.9,"PAH",249,1,0)="^^1^1^3010515"
^DIC(9.4,47,22,5.9,"PAH",249,1,1,0)="Correcting the Medicaid number display in the Insurance data screen."
^DIC(9.4,47,22,5.9,"PAH",250,0)="344 SEQ #327^3010517^1"
^DIC(9.4,47,22,5.9,"PAH",250,1,0)="^^1^1^3010517"
^DIC(9.4,47,22,5.9,"PAH",250,1,1,0)="Please refer to Patch DG*5.3*344."
^DIC(9.4,47,22,5.9,"PAH",251,0)="376 SEQ #328^3010529^1"
^DIC(9.4,47,22,5.9,"PAH",251,1,0)="^^1^1^3010529"
^DIC(9.4,47,22,5.9,"PAH",251,1,1,0)="Please see the National Patch Module in Forum for description of this patch."
^DIC(9.4,47,22,5.9,"PAH",252,0)="268 SEQ #329^3010529^1"
^DIC(9.4,47,22,5.9,"PAH",252,1,0)="^^2^2^3010529"
^DIC(9.4,47,22,5.9,"PAH",252,1,1,0)="This will resolve issue with the ability of an active lodger to be"
^DIC(9.4,47,22,5.9,"PAH",252,1,2,0)="Dispositioned. "
^DIC(9.4,47,22,5.9,"PAH",253,0)="287 SEQ #330^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",253,1,0)="^^12^12^3010608"
^DIC(9.4,47,22,5.9,"PAH",253,1,1,0)="Description:"
^DIC(9.4,47,22,5.9,"PAH",253,1,2,0)="============"
^DIC(9.4,47,22,5.9,"PAH",253,1,3,0)="Patch DG 287 addresses NOIS WRJ-0100-12175 issue dealing with the Patient"
^DIC(9.4,47,22,5.9,"PAH",253,1,4,0)="Wristband Print.  It was found that for selected patients, specifically"
^DIC(9.4,47,22,5.9,"PAH",253,1,5,0)="TRICARE, the PID was not printing on the wrist band."
^DIC(9.4,47,22,5.9,"PAH",253,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",253,1,7,0)="It was found that due to file definition for some patients (ie. TRICARE),"
^DIC(9.4,47,22,5.9,"PAH",253,1,8,0)="the Primary Long ID was not set consistent with the other categories thus"
^DIC(9.4,47,22,5.9,"PAH",253,1,9,0)="creating a missing ID."
^DIC(9.4,47,22,5.9,"PAH",253,1,10,0)=" "
^DIC(9.4,47,22,5.9,"PAH",253,1,11,0)="Corrected by using formatted SS# whenever Primary Long ID missing.  If no"
^DIC(9.4,47,22,5.9,"PAH",253,1,12,0)="SS# found, ""No ID found"" notation will print."
^DIC(9.4,47,22,5.9,"PAH",254,0)="382 SEQ #331^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",255,0)="301 SEQ #332^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",256,0)="352 SEQ #333^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",256,1,0)="^^1^1^3010608"
^DIC(9.4,47,22,5.9,"PAH",256,1,1,0)="CORRECTION TO DGSEC ROUTINE FOR PATIENT LOOKUP"
^DIC(9.4,47,22,5.9,"PAH",257,0)="378 SEQ #334^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",257,1,0)="^^2^2^3010608"
^DIC(9.4,47,22,5.9,"PAH",257,1,1,0)="See patch DG*5.3*378 in the National Patch Module for description of this"
^DIC(9.4,47,22,5.9,"PAH",257,1,2,0)="build."
^DIC(9.4,47,22,5.9,"PAH",258,0)="361 SEQ #335^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",259,0)="384 SEQ #336^3010608^1"
^DIC(9.4,47,22,5.9,"PAH",259,1,0)="^^3^3^3010608"
^DIC(9.4,47,22,5.9,"PAH",259,1,1,0)="PATIENT DATA REVIEW - NAME COMPARISON"
^DIC(9.4,47,22,5.9,"PAH",259,1,2,0)="Refer to patch DG*5.3*384 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",259,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",260,0)="359 SEQ #337^3010802^1"
^DIC(9.4,47,22,5.9,"PAH",260,1,0)="^^18^18^3010802"
^DIC(9.4,47,22,5.9,"PAH",260,1,1,0)="This patch will install a new version of routine DGRUGDS.  The DGRUGDS"
^DIC(9.4,47,22,5.9,"PAH",260,1,2,0)="routine does the data seeding of patient data in the RAI/MDS"
^DIC(9.4,47,22,5.9,"PAH",260,1,3,0)="COTS system.  HL7 A01 Admit messages are created for patients"
^DIC(9.4,47,22,5.9,"PAH",260,1,4,0)="currently active in wards assigned to the selected division. "
^DIC(9.4,47,22,5.9,"PAH",260,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",260,1,6,0)="This version will also allow the user to select individual or multiple"
^DIC(9.4,47,22,5.9,"PAH",260,1,7,0)="patients currently active in RAI designated wards.  If the patient is"
^DIC(9.4,47,22,5.9,"PAH",260,1,8,0)="active in an RAI ward, an HL7 A01 Admit message will be created"
^DIC(9.4,47,22,5.9,"PAH",260,1,9,0)="and sent to the RAI/MDS COTS system.  If the selected patient is not in an"
^DIC(9.4,47,22,5.9,"PAH",260,1,10,0)="RAI ward, the user will be allowed to make another selection and no HL7"
^DIC(9.4,47,22,5.9,"PAH",260,1,11,0)="A01 Admit message will be transmitted for the non-RAI patient.  If the"
^DIC(9.4,47,22,5.9,"PAH",260,1,12,0)="selected patient was an RAI-ward patient but currently inactive (for"
^DIC(9.4,47,22,5.9,"PAH",260,1,13,0)="example, ASIH), no HL7 A01 Admit message will be created and the user may"
^DIC(9.4,47,22,5.9,"PAH",260,1,14,0)="select another patient if desired, or quit."
^DIC(9.4,47,22,5.9,"PAH",260,1,15,0)=" "
^DIC(9.4,47,22,5.9,"PAH",260,1,16,0)=" "
^DIC(9.4,47,22,5.9,"PAH",260,1,17,0)=" "
^DIC(9.4,47,22,5.9,"PAH",260,1,18,0)="."
^DIC(9.4,47,22,5.9,"PAH",261,0)="383 SEQ #338^3010802^1"
