^DIC(9.4,175,22,2,"PAH",109,1,1,0)="VistA Imaging V3.0 Patch 163 MAG INDEX TERMS UPDATE 2015"
^DIC(9.4,175,22,2,"PAH",109,1,2,0)=" "
^DIC(9.4,175,22,2,"PAH",109,1,3,0)=" "
^DIC(9.4,175,22,2,"PAH",109,1,4,0)="This Patch includes 4 new index terms:"
^DIC(9.4,175,22,2,"PAH",109,1,5,0)=" "
^DIC(9.4,175,22,2,"PAH",109,1,6,0)="New Specialty: Diagnostic/Interventional Radiology   Abbreviation: DIR"
^DIC(9.4,175,22,2,"PAH",109,1,7,0)="New Specialty: Radiation Oncology                    Abbreviation: RONC"
^DIC(9.4,175,22,2,"PAH",109,1,8,0)="New Origin:  URBAN  (active for IHS sites only)"
^DIC(9.4,175,22,2,"PAH",109,1,9,0)="New Specialty: Physical Therapy                      Abbreviation: PT  (IHS only)"
^DIC(9.4,175,22,2,"PAH",109,1,10,0)=" "
^DIC(9.4,175,22,2,"PAH",109,1,11,0)="Add the existing Specialty: Hematology Medical to the existing Procedure/Event: Blood Component Form"
