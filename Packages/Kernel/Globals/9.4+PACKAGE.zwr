^DIC(9.4,175,22,2,"PAH",124,1,0)="^^14^14^3170830"
^DIC(9.4,175,22,2,"PAH",124,1,1,0)="Release of Information(ROI) Print issues."
^DIC(9.4,175,22,2,"PAH",124,1,2,0)="   "
^DIC(9.4,175,22,2,"PAH",124,1,3,0)="The issue happens when a user is processing a Release of  "
^DIC(9.4,175,22,2,"PAH",124,1,4,0)="Information (ROI) Print job and the user switches patient's"
^DIC(9.4,175,22,2,"PAH",124,1,5,0)="in CPRS while the ROI Print job is running."
^DIC(9.4,175,22,2,"PAH",124,1,6,0)="    "
^DIC(9.4,175,22,2,"PAH",124,1,7,0)="This could potentially cause the Second Patient's images to be"
^DIC(9.4,175,22,2,"PAH",124,1,8,0)="included in the ROI Print job that is running for the First Patient."
^DIC(9.4,175,22,2,"PAH",124,1,9,0)="  "
^DIC(9.4,175,22,2,"PAH",124,1,10,0)="This will check the routines from a BUILD file."
