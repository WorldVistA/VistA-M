^DIC(9.4,4,22,1,"PAH",56,0)="87 SEQ #81^2990914^1"
^DIC(9.4,4,22,1,"PAH",56,1,0)="^^56^56^2990914"
^DIC(9.4,4,22,1,"PAH",56,1,1,0)="Patch XM*7.1*87"
^DIC(9.4,4,22,1,"PAH",56,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",56,1,3,0)="NOIS:  LAS-0999-60456"
^DIC(9.4,4,22,1,"PAH",56,1,4,0)="Test Site:  Las Vegas, NV"
^DIC(9.4,4,22,1,"PAH",56,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",56,1,6,0)="If, after reading a KIDS message, you WRITE a new message from the"
^DIC(9.4,4,22,1,"PAH",56,1,7,0)="Message action: IGNORE// prompt, MailMan thinks you're creating a PackMan"
^DIC(9.4,4,22,1,"PAH",56,1,8,0)="message.  This patch disabuses MailMan of that notion."
