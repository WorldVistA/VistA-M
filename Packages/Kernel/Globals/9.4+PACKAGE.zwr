^DIC(9.4,3,22,21,"PAH",145,0)="176 SEQ #152^3001127^1"
^DIC(9.4,3,22,21,"PAH",145,1,0)="^^182^182^3001127"
^DIC(9.4,3,22,21,"PAH",145,1,1,0)="NOIS"
^DIC(9.4,3,22,21,"PAH",145,1,2,0)="MIA-0700-30488"
^DIC(9.4,3,22,21,"PAH",145,1,3,0)="LEB-0800-20388"
^DIC(9.4,3,22,21,"PAH",145,1,4,0)="DAY-1000-40325"
^DIC(9.4,3,22,21,"PAH",145,1,5,0)="SBY-1000-30177"
^DIC(9.4,3,22,21,"PAH",145,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,7,0)="Patch XU*8*165 unintentionly send all fields in file 200 not just the"
^DIC(9.4,3,22,21,"PAH",145,1,8,0)="ones needed for the patch.  This patch fixes the problem caused in"
^DIC(9.4,3,22,21,"PAH",145,1,9,0)="the DEA# and VA# fields.  The main problem was a change made to the"
^DIC(9.4,3,22,21,"PAH",145,1,10,0)="cross-reference of each field.  The post-INIT will reindex the data"
^DIC(9.4,3,22,21,"PAH",145,1,11,0)="to setup the cross-reference.  Some experamental fields from the"
^DIC(9.4,3,22,21,"PAH",145,1,12,0)="development account were send and will be removed.  Routine XUINPCH3"
^DIC(9.4,3,22,21,"PAH",145,1,13,0)="is just the Post-INIT routine.  The discription was changed on other"
^DIC(9.4,3,22,21,"PAH",145,1,14,0)="fields."
^DIC(9.4,3,22,21,"PAH",145,1,15,0)="The fields being loaded:"
^DIC(9.4,3,22,21,"PAH",145,1,16,0)="53.1,53.2,53.3,53.4,53.6,53.7,53.8,54.1"
^DIC(9.4,3,22,21,"PAH",145,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,18,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,20,0)="NAME STANDARDIZATION: SPACES WITHIN SUFFIXES"
^DIC(9.4,3,22,21,"PAH",145,1,21,0)="NOIS"
^DIC(9.4,3,22,21,"PAH",145,1,22,0)="===="
^DIC(9.4,3,22,21,"PAH",145,1,23,0)="ANN-0800-42960"
^DIC(9.4,3,22,21,"PAH",145,1,24,0)="MAN-0800-12845"
^DIC(9.4,3,22,21,"PAH",145,1,25,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,26,0)="Background"
^DIC(9.4,3,22,21,"PAH",145,1,27,0)="=========="
^DIC(9.4,3,22,21,"PAH",145,1,28,0)="The Name Standardization Patch (Kernel Patch XU*8.0*134), which was"
^DIC(9.4,3,22,21,"PAH",145,1,29,0)="released on April 6, 2000, includes a data conversion run as part of the"
^DIC(9.4,3,22,21,"PAH",145,1,30,0)="Post-Installation of that patch. The data conversion converts all names"
^DIC(9.4,3,22,21,"PAH",145,1,31,0)="stored in the .01 field of the New Person file to standard form. It also"
^DIC(9.4,3,22,21,"PAH",145,1,32,0)="parses each name into its component parts (Given Name, Middle Name, Family"
^DIC(9.4,3,22,21,"PAH",145,1,33,0)="Name, and Suffix), and stores those component parts in the Name Components"
^DIC(9.4,3,22,21,"PAH",145,1,34,0)="file (#20) also released with the patch."
^DIC(9.4,3,22,21,"PAH",145,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,37,0)="Problem"
^DIC(9.4,3,22,21,"PAH",145,1,38,0)="======="
^DIC(9.4,3,22,21,"PAH",145,1,39,0)="The data conversion looks for specific suffixes at the end of the name,"
^DIC(9.4,3,22,21,"PAH",145,1,40,0)="such as MD, PHD, and DDS. However, it was not accounting for suffixes that"
^DIC(9.4,3,22,21,"PAH",145,1,41,0)="contain periods, such as M.D., Ph.D. and D.D.S. When the data conversion"
^DIC(9.4,3,22,21,"PAH",145,1,42,0)="finds a name with a suffix that contains periods the name could be"
^DIC(9.4,3,22,21,"PAH",145,1,43,0)="incorrectly parsed."
^DIC(9.4,3,22,21,"PAH",145,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,45,0)="For example, suppose the name as stored in the .01 field of the New Person"
^DIC(9.4,3,22,21,"PAH",145,1,46,0)="file before patch XU*8.0*134 was installed was:"
^DIC(9.4,3,22,21,"PAH",145,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,48,0)="            Original name: SMITH,JOHN M.D."
^DIC(9.4,3,22,21,"PAH",145,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,50,0)="The result after the data conversion would be:"
^DIC(9.4,3,22,21,"PAH",145,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,52,0)="    New standardized name: SMITH,JOHN M D"
^DIC(9.4,3,22,21,"PAH",145,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,54,0)="    Name components as stored in the Name Components file:"
^DIC(9.4,3,22,21,"PAH",145,1,55,0)="                    Given: JOHN M."
^DIC(9.4,3,22,21,"PAH",145,1,56,0)="                   Middle: D."
^DIC(9.4,3,22,21,"PAH",145,1,57,0)="                   Family: SMITH"
^DIC(9.4,3,22,21,"PAH",145,1,58,0)="                   Suffix:"
^DIC(9.4,3,22,21,"PAH",145,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,60,0)="Note that in the above, the suffix M.D. was not recognized as a suffix."
^DIC(9.4,3,22,21,"PAH",145,1,61,0)="'M' was considered part of the person's first (given) name, and 'D' was"
^DIC(9.4,3,22,21,"PAH",145,1,62,0)="considered the middle initial."
^DIC(9.4,3,22,21,"PAH",145,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,64,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,65,0)="Solution"
^DIC(9.4,3,22,21,"PAH",145,1,66,0)="========"
^DIC(9.4,3,22,21,"PAH",145,1,67,0)="In order to correct names that were parsed incorrectly by the data"
^DIC(9.4,3,22,21,"PAH",145,1,68,0)="conversion, routine XLFNP176 is included in this patch. The FIX^XLFNP176"
^DIC(9.4,3,22,21,"PAH",145,1,69,0)="entry point loops through the entries in the New Person file and looks for"
^DIC(9.4,3,22,21,"PAH",145,1,70,0)="names that may have been standardized and parsed incorrectly. It will then"
^DIC(9.4,3,22,21,"PAH",145,1,71,0)="optionally correct the name in the New Person file and the corresponding"
^DIC(9.4,3,22,21,"PAH",145,1,72,0)="name components in the Name Components file."
^DIC(9.4,3,22,21,"PAH",145,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,74,0)="NOTE: Sites should still install patch XU*8*134. The FIX^XLFNP176 entry"
^DIC(9.4,3,22,21,"PAH",145,1,75,0)="point is designed to run on systems on which the data conversion has"
^DIC(9.4,3,22,21,"PAH",145,1,76,0)="already been run."
^DIC(9.4,3,22,21,"PAH",145,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,78,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,79,0)="FIX^XLFNP176 Description"
^DIC(9.4,3,22,21,"PAH",145,1,80,0)="========================"
^DIC(9.4,3,22,21,"PAH",145,1,81,0)="This directly mode utility loops through all entries in the New Person"
^DIC(9.4,3,22,21,"PAH",145,1,82,0)="file (#200) and looks in the .01 field for names that end in any of the"
^DIC(9.4,3,22,21,"PAH",145,1,83,0)="following strings (without the single quotes (')):"
^DIC(9.4,3,22,21,"PAH",145,1,84,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,85,0)="  ' M D'"
^DIC(9.4,3,22,21,"PAH",145,1,86,0)="  ' D D S'"
^DIC(9.4,3,22,21,"PAH",145,1,87,0)="  ' PH D'"
^DIC(9.4,3,22,21,"PAH",145,1,88,0)="  ' R N'"
^DIC(9.4,3,22,21,"PAH",145,1,89,0)="  ' D P M'"
^DIC(9.4,3,22,21,"PAH",145,1,90,0)="  ' D O'"
^DIC(9.4,3,22,21,"PAH",145,1,91,0)="  ' P A'"
^DIC(9.4,3,22,21,"PAH",145,1,92,0)="  ' N P'"
^DIC(9.4,3,22,21,"PAH",145,1,93,0)="  ' C R N A'"
^DIC(9.4,3,22,21,"PAH",145,1,94,0)="  ' L P N'"
^DIC(9.4,3,22,21,"PAH",145,1,95,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,96,0)="If it finds any of the above strings at the end of the name, it assumes"
^DIC(9.4,3,22,21,"PAH",145,1,97,0)="that string is a suffix. It removes the spaces from the suffix and stores"
^DIC(9.4,3,22,21,"PAH",145,1,98,0)="the modified name in the .01 field of the New Person file. It also stores"
^DIC(9.4,3,22,21,"PAH",145,1,99,0)="the suffix (without embedded spaces) in the Suffix field (#5) of the"
^DIC(9.4,3,22,21,"PAH",145,1,100,0)="corresponding entry in the Name Components file."
^DIC(9.4,3,22,21,"PAH",145,1,101,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,102,0)="For example, if FIX^XLFNP176 finds a name in the .01 field of the New"
^DIC(9.4,3,22,21,"PAH",145,1,103,0)="Person file stored as:"
^DIC(9.4,3,22,21,"PAH",145,1,104,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,105,0)="        Name: SMITH,JOHN M D"
^DIC(9.4,3,22,21,"PAH",145,1,106,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,107,0)="it assumes M D is a suffix, and changes the name to SMITH,JOHN MD. It also"
^DIC(9.4,3,22,21,"PAH",145,1,108,0)="stores MD in the SUFFIX field (#5) in the Name Components file."
^DIC(9.4,3,22,21,"PAH",145,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,110,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,111,0)="How to use:"
^DIC(9.4,3,22,21,"PAH",145,1,112,0)="----------"
^DIC(9.4,3,22,21,"PAH",145,1,113,0)="FIX^XLFNP176 can be run with VISTA users online. However, it is"
^DIC(9.4,3,22,21,"PAH",145,1,114,0)="recommended that it be run during non-peak times."
^DIC(9.4,3,22,21,"PAH",145,1,115,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,116,0)="Run FIX^XLFNP176 from programmer mode:"
^DIC(9.4,3,22,21,"PAH",145,1,117,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,118,0)="        >D FIX^XLFNP176"
^DIC(9.4,3,22,21,"PAH",145,1,119,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,120,0)="The routine need only be run onced to fix the problem."
^DIC(9.4,3,22,21,"PAH",145,1,121,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,122,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,123,0)="Customizing the list of problem suffixes checked by FIX^XLFNP176"
^DIC(9.4,3,22,21,"PAH",145,1,124,0)="----------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",145,1,125,0)="If you wish to modify the list of problem suffixes checked by XLFNP176,"
^DIC(9.4,3,22,21,"PAH",145,1,126,0)="you can edit the text at line tag LINE^XLFNP176. Replace the list with an"
^DIC(9.4,3,22,21,"PAH",145,1,127,0)="up-arrow (^)-delimited list of suffixes that may occur at the end of the"
^DIC(9.4,3,22,21,"PAH",145,1,128,0)="Names stored in your New Person file."
^DIC(9.4,3,22,21,"PAH",145,1,129,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,130,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",145,1,131,0)="============================="
^DIC(9.4,3,22,21,"PAH",145,1,132,0)="Clearance - Nov. 2, 2000 "
^DIC(9.4,3,22,21,"PAH",145,1,133,0)=" "
^DIC(9.4,3,22,21,"PAH",145,1,134,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,135,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",145,1,136,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",145,1,137,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",145,1,138,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",145,1,139,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,140,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",145,1,141,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",145,1,142,0)="XLFNP176          n/a   9524118    **176**"
^DIC(9.4,3,22,21,"PAH",145,1,143,0)="XUINPCH3       555958   1351290    **115,176**"
^DIC(9.4,3,22,21,"PAH",145,1,144,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,145,0)="List of preceding patches: 115"
^DIC(9.4,3,22,21,"PAH",145,1,146,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",145,1,147,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,148,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",145,1,149,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",145,1,150,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,151,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",145,1,152,0)=">>>Taskman does not need to be stopped."
^DIC(9.4,3,22,21,"PAH",145,1,153,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,154,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,155,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",145,1,156,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",145,1,157,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,158,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",145,1,159,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",145,1,160,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",145,1,161,0)="      options:"
^DIC(9.4,3,22,21,"PAH",145,1,162,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,163,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",145,1,164,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",145,1,165,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",145,1,166,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",145,1,167,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,168,0)="  3.  Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",145,1,169,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",145,1,170,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,171,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",145,1,172,0)="      option:"
^DIC(9.4,3,22,21,"PAH",145,1,173,0)="        Install Package(s)  'XU*8.0*176'"
^DIC(9.4,3,22,21,"PAH",145,1,174,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",145,1,175,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,176,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO                "
^DIC(9.4,3,22,21,"PAH",145,1,177,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",145,1,178,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",145,1,179,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",145,1,180,0)=""
^DIC(9.4,3,22,21,"PAH",145,1,181,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",145,1,182,0)=""
^DIC(9.4,3,22,21,"PAH",146,0)="154 SEQ #153^3001127^1"
^DIC(9.4,3,22,21,"PAH",146,1,0)="^^114^114^3001127"
^DIC(9.4,3,22,21,"PAH",146,1,1,0)="1.  HOU-0198-70327."
^DIC(9.4,3,22,21,"PAH",146,1,2,0)="    This patch corrects the %DSM-E-NUMBER, illegal number error should"
^DIC(9.4,3,22,21,"PAH",146,1,3,0)="    an extraordinarily long be entered (usually caused by something or"
^DIC(9.4,3,22,21,"PAH",146,1,4,0)="    someone hand laying on the keyboard).  An example is display below:"
^DIC(9.4,3,22,21,"PAH",146,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,7,0)="          Core Applications ..."
^DIC(9.4,3,22,21,"PAH",146,1,8,0)="          Device Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,9,0)="   FM     VA FileMan ..."
^DIC(9.4,3,22,21,"PAH",146,1,10,0)="          Manage Mailman ..."
^DIC(9.4,3,22,21,"PAH",146,1,11,0)="          Menu Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,12,0)="          Programmer Options ..."
^DIC(9.4,3,22,21,"PAH",146,1,13,0)="          Operations Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,14,0)="          Spool Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,15,0)="          System Security ..."
^DIC(9.4,3,22,21,"PAH",146,1,16,0)="          Taskman Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,17,0)="          User Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,18,0)="          Application Utilities ..."
^DIC(9.4,3,22,21,"PAH",146,1,19,0)="          Capacity Management ..."
^DIC(9.4,3,22,21,"PAH",146,1,20,0)="          Captioned OP in a Template "
^DIC(9.4,3,22,21,"PAH",146,1,21,0)="          HL7 Main Menu ..."
^DIC(9.4,3,22,21,"PAH",146,1,22,0)="          Suggestion Box"
^DIC(9.4,3,22,21,"PAH",146,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,24,0)="Select Systems Manager Menu Option: M"
^DIC(9.4,3,22,21,"PAH",146,1,25,0)="    1    Manage Mailman                    "
^DIC(9.4,3,22,21,"PAH",146,1,26,0)="    2    Menu Management                   "
^DIC(9.4,3,22,21,"PAH",146,1,27,0)="CHOOSE 1-2:"
^DIC(9.4,3,22,21,"PAH",146,1,28,0)="111111111111111111111111111111111111111111111111111111111111111111"
^DIC(9.4,3,22,21,"PAH",146,1,29,0)="%DSM-E-NUMBER, illegal number"
^DIC(9.4,3,22,21,"PAH",146,1,30,0)="%DSM-I-ATLABEL, C+2^XQ71:4      R XQJ:DTIME S:'$T XQJ=U I XQJ?1N.N G"
^DIC(9.4,3,22,21,"PAH",146,1,31,0)="C:'$D(XQ(XQ"
^DIC(9.4,3,22,21,"PAH",146,1,32,0)="J-1#20+1)) W ""  "" S XQUR="""",XQY=+XQ(XQJ-1#20+1) I XQY>0 S"
^DIC(9.4,3,22,21,"PAH",146,1,33,0)="XQY0=$P(^XUTL(""XQO"",XQ"
^DIC(9.4,3,22,21,"PAH",146,1,34,0)="DIC,""^"",XQY),U,2,99),XQA=$P(XQ(XQJ-1#20+1),U,3) G W"
^DIC(9.4,3,22,21,"PAH",146,1,35,0)=">"
^DIC(9.4,3,22,21,"PAH",146,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,37,0)="**************** Corrected Below *******************************"
^DIC(9.4,3,22,21,"PAH",146,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,40,0)="Select Systems Manager Menu Option: M"
^DIC(9.4,3,22,21,"PAH",146,1,41,0)="    1    Manage Mailman                    "
^DIC(9.4,3,22,21,"PAH",146,1,42,0)="    2    Menu Management                   "
^DIC(9.4,3,22,21,"PAH",146,1,43,0)="CHOOSE 1-2:"
^DIC(9.4,3,22,21,"PAH",146,1,44,0)="1111111111111111111111111111111111111111111111111111111111111111"
^DIC(9.4,3,22,21,"PAH",146,1,45,0)="    "
^DIC(9.4,3,22,21,"PAH",146,1,46,0)="    1    Manage Mailman                    "
^DIC(9.4,3,22,21,"PAH",146,1,47,0)="    2    Menu Management                   "
^DIC(9.4,3,22,21,"PAH",146,1,48,0)="CHOOSE 1-2: "
^DIC(9.4,3,22,21,"PAH",146,1,49,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,51,0)="NOTE: Returns the User back to the Selection Prompt for the correct"
^DIC(9.4,3,22,21,"PAH",146,1,52,0)="      choice."
^DIC(9.4,3,22,21,"PAH",146,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,54,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,56,0)="Test Sites:"
^DIC(9.4,3,22,21,"PAH",146,1,57,0)="==========="
^DIC(9.4,3,22,21,"PAH",146,1,58,0)="Houston, TX  -  580"
^DIC(9.4,3,22,21,"PAH",146,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,61,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",146,1,62,0)="================"
^DIC(9.4,3,22,21,"PAH",146,1,63,0)="The following routine(s) are included in this patch.  The second line of"
^DIC(9.4,3,22,21,"PAH",146,1,64,0)="each routine will look like:"
^DIC(9.4,3,22,21,"PAH",146,1,65,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,66,0)="            <tab>;;8.0;KERNEL;**[Patch List]**;07/03/95"
^DIC(9.4,3,22,21,"PAH",146,1,67,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,68,0)="Checksums:   CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",146,1,69,0)="=========="
^DIC(9.4,3,22,21,"PAH",146,1,70,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,71,0)="Rtn Nm         Chksum Before     Chksum After            Patch List"
^DIC(9.4,3,22,21,"PAH",146,1,72,0)="===================================================================="
^DIC(9.4,3,22,21,"PAH",146,1,73,0)="XQ71                13242248          13403778               154"
^DIC(9.4,3,22,21,"PAH",146,1,74,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,75,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,76,0)="Installation Instruction:"
^DIC(9.4,3,22,21,"PAH",146,1,77,0)="========================"
^DIC(9.4,3,22,21,"PAH",146,1,78,0)="1. Users are allowed to be on the system during the Installation."
^DIC(9.4,3,22,21,"PAH",146,1,79,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,80,0)="2. Routine mapping is NOT recommended for these routines.  If you"
^DIC(9.4,3,22,21,"PAH",146,1,81,0)="are using routine mapping, review your mapped set and ensure that"
^DIC(9.4,3,22,21,"PAH",146,1,82,0)="these routines are NOT in your mapped routine set before proceeding"
^DIC(9.4,3,22,21,"PAH",146,1,83,0)="and rebuild your map set afterward before reactivating TaskMan."
^DIC(9.4,3,22,21,"PAH",146,1,84,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,85,0)="3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,3,22,21,"PAH",146,1,86,0)="loads the patch into a Transport Global onto your system."
^DIC(9.4,3,22,21,"PAH",146,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,88,0)="4. You Do Not need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",146,1,89,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,91,0)="5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,3,22,21,"PAH",146,1,92,0)="   following options to install the Transport Global:"
^DIC(9.4,3,22,21,"PAH",146,1,93,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,94,0)="  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",146,1,95,0)="  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",146,1,96,0)="  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",146,1,97,0)="  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",146,1,98,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,99,0)="  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",146,1,100,0)="             INSTALL NAME:  XU*8.0*154"
^DIC(9.4,3,22,21,"PAH",146,1,101,0)="                            =========="
^DIC(9.4,3,22,21,"PAH",146,1,102,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,103,0)="  Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",146,1,104,0)="                                                        =="
^DIC(9.4,3,22,21,"PAH",146,1,105,0)="  Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,3,22,21,"PAH",146,1,106,0)="  Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",146,1,107,0)="                   ==   "
^DIC(9.4,3,22,21,"PAH",146,1,108,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,109,0)="6. DSM/AXP Sites - Answer NO to the question ""Want to MOVE routines"
^DIC(9.4,3,22,21,"PAH",146,1,110,0)="   to other CPUs?"""
^DIC(9.4,3,22,21,"PAH",146,1,111,0)=" "
^DIC(9.4,3,22,21,"PAH",146,1,112,0)="7. DSM/AXP Sites: If the routines were unmapped per STEP #2, the"
^DIC(9.4,3,22,21,"PAH",146,1,113,0)="   mapped set should be rebuilt once the installation has run to"
^DIC(9.4,3,22,21,"PAH",146,1,114,0)="   completion."
^DIC(9.4,3,22,21,"PAH",147,0)="181 SEQ #154^3010103^1"
^DIC(9.4,3,22,21,"PAH",148,0)="182 SEQ #155^3010103^1"
^DIC(9.4,3,22,21,"PAH",149,0)="175 SEQ #156^3010103^1"
^DIC(9.4,3,22,21,"PAH",149,1,0)="^^98^98^3010103"
^DIC(9.4,3,22,21,"PAH",149,1,1,0)="BRX-0900-12121"
^DIC(9.4,3,22,21,"PAH",149,1,2,0)="With changes to the security checks that Mailman makes before allowing"
^DIC(9.4,3,22,21,"PAH",149,1,3,0)="a message to be sent, any tasks that Taskman start as part of the system"
^DIC(9.4,3,22,21,"PAH",149,1,4,0)="startup need to have the DUZ set to a valid user.  After talking with the"
^DIC(9.4,3,22,21,"PAH",149,1,5,0)="DBA it was decided to have Taskman use POSTMASTER as the user (DUZ=.5)."
^DIC(9.4,3,22,21,"PAH",149,1,6,0)="This change will only affect tasks started when Taskman first starts,"
^DIC(9.4,3,22,21,"PAH",149,1,7,0)="that have the special queueing field set to STARTUP or Startup Persistent."
^DIC(9.4,3,22,21,"PAH",149,1,8,0)="ZTM0 is the routine that has been changed for this patch."
^DIC(9.4,3,22,21,"PAH",149,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,10,0)="To support P-MESSAGE a change was made to ZTMS3 to move the clean-up"
^DIC(9.4,3,22,21,"PAH",149,1,11,0)="of temp globals to after the device has been closed."
^DIC(9.4,3,22,21,"PAH",149,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,13,0)="ATG-0700-31453"
^DIC(9.4,3,22,21,"PAH",149,1,14,0)="In working with NVS it has been found that at times the persistent"
^DIC(9.4,3,22,21,"PAH",149,1,15,0)="task restart code is too good and schedules many copies of the same task"
^DIC(9.4,3,22,21,"PAH",149,1,16,0)="before one starts and signals that it is running.  The other copies"
^DIC(9.4,3,22,21,"PAH",149,1,17,0)="get caught waiting for a lock on the global node ^%ZTSCH(""TASK"",<task>)."
^DIC(9.4,3,22,21,"PAH",149,1,18,0)="This has been fixed by using a timeout on earlier lock before the"
^DIC(9.4,3,22,21,"PAH",149,1,19,0)="task is setup.  This change was made in ZTMS2."
^DIC(9.4,3,22,21,"PAH",149,1,20,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,21,0)="XUTMOPT is included to provide an API for applications to check on"
^DIC(9.4,3,22,21,"PAH",149,1,22,0)="scheduled tasks."
^DIC(9.4,3,22,21,"PAH",149,1,23,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",149,1,24,0)="============================="
^DIC(9.4,3,22,21,"PAH",149,1,25,0)="Clearance - Nov. 2, 2000"
^DIC(9.4,3,22,21,"PAH",149,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,27,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",149,1,28,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",149,1,29,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",149,1,30,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",149,1,31,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,32,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",149,1,33,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",149,1,34,0)="XUTMOPT       4026913   4559820    **2,111,112,118,127,175**"
^DIC(9.4,3,22,21,"PAH",149,1,35,0)="ZTM0          6089712   5998062    **42,36,67,88,118,127,136,175**"
^DIC(9.4,3,22,21,"PAH",149,1,36,0)="ZTMS2         6724503   7001305    **2,18,23,36,67,118,127,163,167,175**"
^DIC(9.4,3,22,21,"PAH",149,1,37,0)="ZTMS3         9642200   9642200    **1,18,36,49,64,67,94,118,127,136,175**"
^DIC(9.4,3,22,21,"PAH",149,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,39,0)="List of preceding patches: 136, 167"
^DIC(9.4,3,22,21,"PAH",149,1,40,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",149,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,42,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",149,1,43,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",149,1,44,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,45,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",149,1,46,0)=">>>Taskman does need to be stopped."
^DIC(9.4,3,22,21,"PAH",149,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,48,0)="  1.  DSM sites - This routines maybe mapped,"
^DIC(9.4,3,22,21,"PAH",149,1,49,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",149,1,50,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,51,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",149,1,52,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",149,1,53,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,54,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",149,1,55,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",149,1,56,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",149,1,57,0)="      options:"
^DIC(9.4,3,22,21,"PAH",149,1,58,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,59,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",149,1,60,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",149,1,61,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",149,1,62,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",149,1,63,0)="         "
^DIC(9.4,3,22,21,"PAH",149,1,64,0)=" 4.  Users can remain on the system."
^DIC(9.4,3,22,21,"PAH",149,1,65,0)="     Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",149,1,66,0)="      Use option: Place Taskman in a WAIT State"
^DIC(9.4,3,22,21,"PAH",149,1,67,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,68,0)="  5.  In Programmer mode:"
^DIC(9.4,3,22,21,"PAH",149,1,69,0)="      Use ""D ^XPDKRN"" then"
^DIC(9.4,3,22,21,"PAH",149,1,70,0)="         Install Package(s)  'XU*8.0*175'"
^DIC(9.4,3,22,21,"PAH",149,1,71,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",149,1,72,0)="                              "
^DIC(9.4,3,22,21,"PAH",149,1,73,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",149,1,74,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",149,1,75,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",149,1,76,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,77,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",149,1,78,0)="      Cache Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",149,1,79,0)="      DSM/MSM sites - you need to one several routine from "
^DIC(9.4,3,22,21,"PAH",149,1,80,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",149,1,81,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,82,0)="ZTM0"
^DIC(9.4,3,22,21,"PAH",149,1,83,0)="ZTMS2"
^DIC(9.4,3,22,21,"PAH",149,1,84,0)="ZTMS3"
^DIC(9.4,3,22,21,"PAH",149,1,85,0)="      "
^DIC(9.4,3,22,21,"PAH",149,1,86,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",149,1,87,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",149,1,88,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",149,1,89,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",149,1,90,0)="      Patch number to load: 175"
^DIC(9.4,3,22,21,"PAH",149,1,91,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",149,1,92,0)="       "
^DIC(9.4,3,22,21,"PAH",149,1,93,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",149,1,94,0)=" "
^DIC(9.4,3,22,21,"PAH",149,1,95,0)=" 11.   Remove TASKMAN from the wait state. (DO RUN^ZTMKU)"
^DIC(9.4,3,22,21,"PAH",149,1,96,0)=""
^DIC(9.4,3,22,21,"PAH",149,1,97,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",149,1,98,0)=""
^DIC(9.4,3,22,21,"PAH",150,0)="148 SEQ #157^3010103^1"
^DIC(9.4,3,22,21,"PAH",151,0)="171 SEQ #158^3010103^1"
^DIC(9.4,3,22,21,"PAH",151,1,0)="^^60^60^3010103"
^DIC(9.4,3,22,21,"PAH",151,1,1,0)="This patch adds the DELSTAT API to the alert functionality to provide"
^DIC(9.4,3,22,21,"PAH",151,1,2,0)="information on whether an alert has been deleted for various users.  The"
^DIC(9.4,3,22,21,"PAH",151,1,3,0)="API was requested for CPRS functionality."
^DIC(9.4,3,22,21,"PAH",151,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",151,1,5,0)="DELSTAT - For the most recent alert with XQAIDVAL as the PackageID"
^DIC(9.4,3,22,21,"PAH",151,1,6,0)="passed in, on return array VALUES contains the DUZ for users in "
^DIC(9.4,3,22,21,"PAH",151,1,7,0)="VALUES along with an indicator of whether the alert has been "
^DIC(9.4,3,22,21,"PAH",151,1,8,0)="deleted or not, e.g., DUZ^0 if not deleted or DUZ^1 if deleted.  "
^DIC(9.4,3,22,21,"PAH",151,1,9,0)="Note that contents of VALUES will be killed prior to building the "
^DIC(9.4,3,22,21,"PAH",151,1,10,0)="list."
^DIC(9.4,3,22,21,"PAH",151,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",151,1,12,0)="Example:   D DELSTAT^XQALBUTL(""OR;14765;23"",.RESULTS)"
^DIC(9.4,3,22,21,"PAH",151,1,13,0)=" "
^DIC(9.4,3,22,21,"PAH",151,1,14,0)="Returned:   The value of RESULTS indicates the number of entries in"
^DIC(9.4,3,22,21,"PAH",151,1,15,0)="              the array.  The entries are then ordered in numerical "
^DIC(9.4,3,22,21,"PAH",151,1,16,0)="              order in the RESULTS array."
^DIC(9.4,3,22,21,"PAH",151,1,17,0)="                  RESULTS = 3"
^DIC(9.4,3,22,21,"PAH",151,1,18,0)="                  RESULTS(1) = ""146^0""   User 146 - not deleted"
^DIC(9.4,3,22,21,"PAH",151,1,19,0)="                  RESULTS(2) = ""297^1""   User 297 - deleted"
^DIC(9.4,3,22,21,"PAH",151,1,20,0)="                  RESULTS(3) = ""673^0""   User 673 - not deleted"
^DIC(9.4,3,22,21,"PAH",151,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",151,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",151,1,23,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",151,1,24,0)="================"
^DIC(9.4,3,22,21,"PAH",151,1,25,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,26,0)="       The following routines are included in the patch.  The second"
^DIC(9.4,3,22,21,"PAH",151,1,27,0)="line of each of these routines now look like this:"
^DIC(9.4,3,22,21,"PAH",151,1,28,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,29,0)="              ;;8.0;KERNEL;**[patch list]**; Jul 05, 1995"
^DIC(9.4,3,22,21,"PAH",151,1,30,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,31,0)="        Checksums were obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",151,1,32,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,33,0)="Routine           Before          After           Patch List"
^DIC(9.4,3,22,21,"PAH",151,1,34,0)="---------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",151,1,35,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,36,0)="XQALBUTL         4983080        8443097        **114,125,171**"
^DIC(9.4,3,22,21,"PAH",151,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",151,1,38,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,39,0)=" Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",151,1,40,0)=" =========================="
^DIC(9.4,3,22,21,"PAH",151,1,41,0)="  "
^DIC(9.4,3,22,21,"PAH",151,1,42,0)="    1.  These routines are not usually mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",151,1,43,0)="        mapping so you may not have to disable mapping."
^DIC(9.4,3,22,21,"PAH",151,1,44,0)="    2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",151,1,45,0)="        option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",151,1,46,0)="    3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",151,1,47,0)="        system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",151,1,48,0)="    4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",151,1,49,0)="        options: "
^DIC(9.4,3,22,21,"PAH",151,1,50,0)="           Print Transport Global "
^DIC(9.4,3,22,21,"PAH",151,1,51,0)="           Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",151,1,52,0)="           Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",151,1,53,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",151,1,54,0)="           Install Package XU*8.0*171"
^DIC(9.4,3,22,21,"PAH",151,1,55,0)="    5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to "
^DIC(9.4,3,22,21,"PAH",151,1,56,0)="        other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",151,1,57,0)="        AXP sites should answer ""no"" to this question."
^DIC(9.4,3,22,21,"PAH",151,1,58,0)="    6.  Rebuild your mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",151,1,59,0)="    7.  If users are allowed to remain on the system during installation"
^DIC(9.4,3,22,21,"PAH",151,1,60,0)="        errors may occur when the routines are loaded."
^DIC(9.4,3,22,21,"PAH",152,0)="177 SEQ #159^3010122^1"
^DIC(9.4,3,22,21,"PAH",152,1,0)="^^53^53^3010122"
^DIC(9.4,3,22,21,"PAH",152,1,1,0)="As a part of its security the RPC Broker requires that a Remote Procedure"
^DIC(9.4,3,22,21,"PAH",152,1,2,0)="Call (RPC) be included within a Broker (Client/Server) or Context option,"
^DIC(9.4,3,22,21,"PAH",152,1,3,0)="and that this option be included within the user's menu tree.  This has"
^DIC(9.4,3,22,21,"PAH",152,1,4,0)="resulted in some context options including hundreds of RPCs.  This patch"
^DIC(9.4,3,22,21,"PAH",152,1,5,0)="modifies XQCS to look also at the ITEMS subfile (which has been used for"
^DIC(9.4,3,22,21,"PAH",152,1,6,0)="menu items) within a context option, and if these point to other context"
^DIC(9.4,3,22,21,"PAH",152,1,7,0)="options, the RPCs included in that context will be included as a part of"
^DIC(9.4,3,22,21,"PAH",152,1,8,0)="the original context."
^DIC(9.4,3,22,21,"PAH",152,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",152,1,10,0)="In addition, this patch modifies the Screenman option for Editing Options"
^DIC(9.4,3,22,21,"PAH",152,1,11,0)="to add the ability to add context options within the ITEMS subfile."
^DIC(9.4,3,22,21,"PAH",152,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",152,1,13,0)="This modification was requested and tested by the developers working on a "
^DIC(9.4,3,22,21,"PAH",152,1,14,0)="Patient Lookup object and Smart Card applications."
^DIC(9.4,3,22,21,"PAH",152,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",152,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",152,1,17,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",152,1,18,0)="================"
^DIC(9.4,3,22,21,"PAH",152,1,19,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,20,0)="       The following routines are included in the patch.  The second"
^DIC(9.4,3,22,21,"PAH",152,1,21,0)="line of each of these routines now look like this:"
^DIC(9.4,3,22,21,"PAH",152,1,22,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,23,0)="              ;;8.0;KERNEL;**[patch list]**; Jul 05, 1995"
^DIC(9.4,3,22,21,"PAH",152,1,24,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,25,0)="        Checksums were obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",152,1,26,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,27,0)="Routine           Before          After           Patch List"
^DIC(9.4,3,22,21,"PAH",152,1,28,0)="---------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",152,1,29,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,30,0)=" XQCS           127133342        13170786     15,28,82,116,115,177"
^DIC(9.4,3,22,21,"PAH",152,1,31,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,32,0)=" Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",152,1,33,0)=" =========================="
^DIC(9.4,3,22,21,"PAH",152,1,34,0)="  "
^DIC(9.4,3,22,21,"PAH",152,1,35,0)="    1.  These routines are not usually mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",152,1,36,0)="        mapping so you may not have to disable mapping."
^DIC(9.4,3,22,21,"PAH",152,1,37,0)="    2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",152,1,38,0)="        option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",152,1,39,0)="    3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",152,1,40,0)="        system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",152,1,41,0)="    4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",152,1,42,0)="        options: "
^DIC(9.4,3,22,21,"PAH",152,1,43,0)="           Print Transport Global "
^DIC(9.4,3,22,21,"PAH",152,1,44,0)="           Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",152,1,45,0)="           Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",152,1,46,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",152,1,47,0)="           Install Package XU*8.0*177"
^DIC(9.4,3,22,21,"PAH",152,1,48,0)="    5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to "
^DIC(9.4,3,22,21,"PAH",152,1,49,0)="        other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",152,1,50,0)="        AXP sites should answer ""no"" to this question."
^DIC(9.4,3,22,21,"PAH",152,1,51,0)="    6.  Rebuild your mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",152,1,52,0)="    7.  If users are allowed to remain on the system during installation"
^DIC(9.4,3,22,21,"PAH",152,1,53,0)="        errors may occur when the routines are loaded."
^DIC(9.4,3,22,21,"PAH",153,0)="179 SEQ #160^3010122^1"
^DIC(9.4,3,22,21,"PAH",153,1,0)="^^71^71^3010122"
^DIC(9.4,3,22,21,"PAH",153,1,1,0)="IV&V testing, Inpatient Meds, Pharmacy"
^DIC(9.4,3,22,21,"PAH",153,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,3,0)="In testing a problem was found that HL7TFM will return trailing zeros when "
^DIC(9.4,3,22,21,"PAH",153,1,4,0)="converting a HL7 date like 200101091230 would return a value like 3010109.1230 "
^DIC(9.4,3,22,21,"PAH",153,1,5,0)="this causes a problem in sorting. There will be a follow-up patch to finish the "
^DIC(9.4,3,22,21,"PAH",153,1,6,0)="changes to address correct conversion of Midnight."
^DIC(9.4,3,22,21,"PAH",153,1,7,0)=""
