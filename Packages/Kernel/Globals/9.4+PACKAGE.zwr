^DIC(9.4,59,22,5,"PAH",397,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",397,1,2,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",397,1,3,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",397,1,4,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",397,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",397,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",397,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",397,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",397,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",397,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",397,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",397,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",397,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",397,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",397,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",397,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",397,1,17,0)="The source of the data for the PMIs is First Data Bank."
