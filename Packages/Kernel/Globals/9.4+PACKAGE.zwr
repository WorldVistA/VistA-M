^DIC(9.4,53,22,20,"PAH",6,0)="40 SEQ #35^2960822^1"
^DIC(9.4,53,22,20,"PAH",6,1,0)="^^1^1^2960822"
^DIC(9.4,53,22,20,"PAH",6,1,1,0)="Patch 40 routine modifications"
^DIC(9.4,53,22,20,"PAH",7,0)="50 SEQ #37^2960923^1"
