^DIC(9.4,4,22,1,"PAH",53,0)="81 SEQ #77^2990914^1"
^DIC(9.4,4,22,1,"PAH",53,1,0)="^^63^63^2990914"
^DIC(9.4,4,22,1,"PAH",53,1,1,0)="Patch XM*7.1*81"
^DIC(9.4,4,22,1,"PAH",53,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,3,0)="NOIS: ASH-0899-30768"
^DIC(9.4,4,22,1,"PAH",53,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,5,0)="As you know, IDCU is no longer with us."
^DIC(9.4,4,22,1,"PAH",53,1,6,0)="It is necessary to delete all IDCU scripts from the DOMAIN file."
^DIC(9.4,4,22,1,"PAH",53,1,7,0)="In examining the scripts, it appears that all IDCU scripts are"
^DIC(9.4,4,22,1,"PAH",53,1,8,0)="named SCRIPT.  Therefore, the pre-init in this patch is designed"
^DIC(9.4,4,22,1,"PAH",53,1,9,0)="to go through all the transmission scripts in the DOMAIN file"
^DIC(9.4,4,22,1,"PAH",53,1,10,0)="and delete all of the ones named SCRIPT."
^DIC(9.4,4,22,1,"PAH",53,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,12,0)="You may let MailMan delete the scripts, or you may do it yourself."
^DIC(9.4,4,22,1,"PAH",53,1,13,0)="You may wish to make a backup of the DOMAIN file before deleting"
^DIC(9.4,4,22,1,"PAH",53,1,14,0)="the scripts.  A pre-install question will ask you what you want to"
^DIC(9.4,4,22,1,"PAH",53,1,15,0)="do.  If you choose to let MailMan delete the scripts, the"
^DIC(9.4,4,22,1,"PAH",53,1,16,0)="pre-init will go ahead and delete them.  Otherwise, the pre-init"
^DIC(9.4,4,22,1,"PAH",53,1,17,0)="will not run, and you should go through the DOMAIN file yourself"
^DIC(9.4,4,22,1,"PAH",53,1,18,0)="and delete all IDCU scripts."
^DIC(9.4,4,22,1,"PAH",53,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,20,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",53,1,21,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",53,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,23,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",53,1,24,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",53,1,25,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",53,1,26,0)=" "
^DIC(9.4,4,22,1,"PAH",53,1,27,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",53,1,28,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",53,1,29,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",53,1,30,0)="XMYPRE4        * NEW *         2102170        81"
^DIC(9.4,4,22,1,"PAH",53,1,31,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,32,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",53,1,33,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",53,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",53,1,35,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",53,1,36,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",53,1,37,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",53,1,38,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",53,1,39,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",53,1,40,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",53,1,41,0)="3.  You do not need to stop TaskMan or the background filers."
^DIC(9.4,4,22,1,"PAH",53,1,42,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",53,1,43,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",53,1,44,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",53,1,45,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",53,1,46,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",53,1,47,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",53,1,48,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",53,1,49,0)=" Select INSTALL NAME:    XM*7.1*81     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",53,1,50,0)="                         ========="
^DIC(9.4,4,22,1,"PAH",53,1,51,0)=" Install Questions for XM*7.1*81"
^DIC(9.4,4,22,1,"PAH",53,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,53,0)=" Do you want me to delete all scripts named SCRIPT? YES// <it's up to you!>"
^DIC(9.4,4,22,1,"PAH",53,1,54,0)="Answer YES or NO here.  If you answer YES, the pre-init will run and will"
^DIC(9.4,4,22,1,"PAH",53,1,55,0)="delete all scripts named SCRIPT.  (It will also let you know if, after"
^DIC(9.4,4,22,1,"PAH",53,1,56,0)="deleting any scripts, a domain is left without any transmission scripts.)"
^DIC(9.4,4,22,1,"PAH",53,1,57,0)="If you answer NO, the pre-init will stop without doing anything, and you must"
^DIC(9.4,4,22,1,"PAH",53,1,58,0)="go through the DOMAIN file yourself and delete all IDCU scripts. "
^DIC(9.4,4,22,1,"PAH",53,1,59,0)=""
^DIC(9.4,4,22,1,"PAH",53,1,60,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",53,1,61,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",53,1,62,0)="5.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",53,1,63,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",54,0)="83 SEQ #78^2990914^1"
^DIC(9.4,4,22,1,"PAH",54,1,0)="^^48^48^2990914"
^DIC(9.4,4,22,1,"PAH",54,1,1,0)="Patch XM*7.1*83"
^DIC(9.4,4,22,1,"PAH",54,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",54,1,3,0)="NOIS: ISW-0899-22203"
^DIC(9.4,4,22,1,"PAH",54,1,4,0)="Test Site:  CIOFO-ALBANY & CIOFO-WASHINGTON"
^DIC(9.4,4,22,1,"PAH",54,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",54,1,6,0)="If you send a message to ""LASTNAME,FIRST@DOMAIN"", it gets there."
^DIC(9.4,4,22,1,"PAH",54,1,7,0)="If you send a message to ""LAS,FIRS@DOMAIN"", you get ""addressee not found""."
^DIC(9.4,4,22,1,"PAH",54,1,8,0)="An unintended consequence of patch XM*7.1*50 was that lookups using comma"
^DIC(9.4,4,22,1,"PAH",54,1,9,0)="piecing stopped working for message sent to remote sites."
^DIC(9.4,4,22,1,"PAH",54,1,10,0)="This patch restores such lookups."
^DIC(9.4,4,22,1,"PAH",54,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",54,1,12,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",54,1,13,0)="minimum.  It requires MailMan patch XM*7.1*78."
^DIC(9.4,4,22,1,"PAH",54,1,14,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",54,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",54,1,16,0)="ROUTINES:"
