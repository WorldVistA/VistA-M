^DIC(9.4,77,22,17,"PAH",231,1,194,0)="Subject:  IMR4 NO ALLERGY ASSESSMENT, UNLIMITED LENGTH SI/OPI"
^DIC(9.4,77,22,17,"PAH",231,1,195,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,196,0)="Category:  ROUTINE"
^DIC(9.4,77,22,17,"PAH",231,1,197,0)="           ENHANCEMENT"
^DIC(9.4,77,22,17,"PAH",231,1,198,0)="           OTHER"
^DIC(9.4,77,22,17,"PAH",231,1,199,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,200,0)="Description:"
^DIC(9.4,77,22,17,"PAH",231,1,201,0)="==========="
^DIC(9.4,77,22,17,"PAH",231,1,202,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,203,0)="******************************* WARNING **********************************"
^DIC(9.4,77,22,17,"PAH",231,1,204,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,205,0)="If your facility has the Pyxis/Omnicell/McKesson interface from ILC this"
^DIC(9.4,77,22,17,"PAH",231,1,206,0)="patch will overwrite any local modifications in routines PSJOEA2, PSGOEE, "
^DIC(9.4,77,22,17,"PAH",231,1,207,0)="PSGOETO, and PSGOEV. This could affect certain orders being sent across"
^DIC(9.4,77,22,17,"PAH",231,1,208,0)="this interface. The modifications will have to be reintroduced following"
^DIC(9.4,77,22,17,"PAH",231,1,209,0)="installation of this patch."
^DIC(9.4,77,22,17,"PAH",231,1,210,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,211,0)="**************************************************************************"
^DIC(9.4,77,22,17,"PAH",231,1,212,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,213,0)="Enhancements"
^DIC(9.4,77,22,17,"PAH",231,1,214,0)="====================="
^DIC(9.4,77,22,17,"PAH",231,1,215,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,216,0)="1. Special Instructions/Other Print Info"
^DIC(9.4,77,22,17,"PAH",231,1,217,0)=" ________________________________________"
^DIC(9.4,77,22,17,"PAH",231,1,218,0)=" With this enhancement, Special Instructions and Other Print Info have"
^DIC(9.4,77,22,17,"PAH",231,1,219,0)=" been modified to support an unlimited amount of text. The existing"
^DIC(9.4,77,22,17,"PAH",231,1,220,0)=" functionality that copies the provider comments from the Computerized"
^DIC(9.4,77,22,17,"PAH",231,1,221,0)=" Patient Record System (CPRS) to be copied into each field has been"
^DIC(9.4,77,22,17,"PAH",231,1,222,0)=" retained, and an additional action has been added to optionally open a"
^DIC(9.4,77,22,17,"PAH",231,1,223,0)=" word processing edit dialog after copying the provider comments into the"
^DIC(9.4,77,22,17,"PAH",231,1,224,0)=" appropriate field (Special Instructions for Unit Dose, Other Print Info "
^DIC(9.4,77,22,17,"PAH",231,1,225,0)=" for IV)."
^DIC(9.4,77,22,17,"PAH",231,1,226,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,227,0)=" Special Instructions and Other Print Info may also be entered"
^DIC(9.4,77,22,17,"PAH",231,1,228,0)=" and/or edited from within Inpatient Medications V. 5.0 order entry "
^DIC(9.4,77,22,17,"PAH",231,1,229,0)=" options."
^DIC(9.4,77,22,17,"PAH",231,1,230,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,231,0)=" Prior to this enhancement, Inpatient Medications maximum character"
^DIC(9.4,77,22,17,"PAH",231,1,232,0)=" length for Special Instructions was 180 characters and for Other Print"
^DIC(9.4,77,22,17,"PAH",231,1,233,0)=" Info the maximum length was 60 characters. This enhancement resolves"
^DIC(9.4,77,22,17,"PAH",231,1,234,0)=" Patient Safety Issues PSPO 42, 1466 / Remedy Ticket HD336419"
^DIC(9.4,77,22,17,"PAH",231,1,235,0)=" - Comment lengths between CPRS and Pharmacy."
^DIC(9.4,77,22,17,"PAH",231,1,236,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,237,0)="2. No Allergy Assessment"
^DIC(9.4,77,22,17,"PAH",231,1,238,0)=" ________________________ "
^DIC(9.4,77,22,17,"PAH",231,1,239,0)=" The No Allergy Assessment enhancement provides an interactive alert to"
^DIC(9.4,77,22,17,"PAH",231,1,240,0)=" the pharmacist in Inpatient Medications V. 5.0 when no allergy assessment"
^DIC(9.4,77,22,17,"PAH",231,1,241,0)=" is on file for the patient, and a method for the pharmacist to enter an"
^DIC(9.4,77,22,17,"PAH",231,1,242,0)=" allergy assessment after receiving the alert.  A pharmacy intervention "
^DIC(9.4,77,22,17,"PAH",231,1,243,0)=" is automatically created if the pharmacist chooses to not enter an"
^DIC(9.4,77,22,17,"PAH",231,1,244,0)=" assessment. "
^DIC(9.4,77,22,17,"PAH",231,1,245,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,246,0)=" The No Allergy Assessment functionality will be available at the "
^DIC(9.4,77,22,17,"PAH",231,1,247,0)=" following options:"
^DIC(9.4,77,22,17,"PAH",231,1,248,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,249,0)="   Inpatient Order Entry [PSJ OE]"
^DIC(9.4,77,22,17,"PAH",231,1,250,0)="   Non-Verified/Pending Orders [PSJU VBW]"
^DIC(9.4,77,22,17,"PAH",231,1,251,0)="   Order Entry [PSJU NE]"
^DIC(9.4,77,22,17,"PAH",231,1,252,0)="   Order Entry (IV) [PSJI ORDER]"
^DIC(9.4,77,22,17,"PAH",231,1,253,0)="   Profile (IV) [PSJI PROFILE]"
^DIC(9.4,77,22,17,"PAH",231,1,254,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,255,0)="When a patient with no allergy assessment is selected from one of the"
^DIC(9.4,77,22,17,"PAH",231,1,256,0)="affected options, the following message will be displayed to the"
^DIC(9.4,77,22,17,"PAH",231,1,257,0)="pharmacist: "
^DIC(9.4,77,22,17,"PAH",231,1,258,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,259,0)="""NO ALLERGY ASSESSMENT exists for this patient! Would you like to enter"
^DIC(9.4,77,22,17,"PAH",231,1,260,0)="one now?"" "
^DIC(9.4,77,22,17,"PAH",231,1,261,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,262,0)=" - If the pharmacist enters 'YES' at this prompt, they are prompted"
^DIC(9.4,77,22,17,"PAH",231,1,263,0)="   for allergy information. "
^DIC(9.4,77,22,17,"PAH",231,1,264,0)=" - If the pharmacist enters 'NO' at this prompt, a pharmacist intervention"
^DIC(9.4,77,22,17,"PAH",231,1,265,0)="   is created, with a type of 'NO ALLERGY ASSESSMENT'. The pharmacist is"
^DIC(9.4,77,22,17,"PAH",231,1,266,0)="   then prompted for Provider and Recommendation. A new Recommendation,"
^DIC(9.4,77,22,17,"PAH",231,1,267,0)="   'UNABLE TO ASSESS', has been created specifically  for this type of "
^DIC(9.4,77,22,17,"PAH",231,1,268,0)="   intervention."
^DIC(9.4,77,22,17,"PAH",231,1,269,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,270,0)=" This enhancement will address Patient Safety Issue PSPO 445."
^DIC(9.4,77,22,17,"PAH",231,1,271,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,272,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,273,0)="Defects Addressed"
^DIC(9.4,77,22,17,"PAH",231,1,274,0)="========================="
^DIC(9.4,77,22,17,"PAH",231,1,275,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,276,0)="1. HD 187184 - IV Med Stop Date"
^DIC(9.4,77,22,17,"PAH",231,1,277,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,278,0)="   Problem"
^DIC(9.4,77,22,17,"PAH",231,1,279,0)="   -------"
^DIC(9.4,77,22,17,"PAH",231,1,280,0)="   When an IV order is renewed the status automatically changes to"
^DIC(9.4,77,22,17,"PAH",231,1,281,0)="   expired, but the stop date does not change to the time the order"
^DIC(9.4,77,22,17,"PAH",231,1,282,0)="   actually stops."
^DIC(9.4,77,22,17,"PAH",231,1,283,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,284,0)="   Resolution"
^DIC(9.4,77,22,17,"PAH",231,1,285,0)="   ----------"
^DIC(9.4,77,22,17,"PAH",231,1,286,0)="   Routine PSJHL3 has been modified to correctly set the stop date of the"
^DIC(9.4,77,22,17,"PAH",231,1,287,0)="   order that has been renewed to the time of renewal. "
^DIC(9.4,77,22,17,"PAH",231,1,288,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,289,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,290,0)=" 2. HD 176676/PSPO 480 - Inpatient doesn't change order status to Expired."
^DIC(9.4,77,22,17,"PAH",231,1,291,0)="    "
^DIC(9.4,77,22,17,"PAH",231,1,292,0)="    Problem"
^DIC(9.4,77,22,17,"PAH",231,1,293,0)="    -------"
^DIC(9.4,77,22,17,"PAH",231,1,294,0)="    The Inpatient Medications V. 5.0 package does not change order status"
^DIC(9.4,77,22,17,"PAH",231,1,295,0)="    to Expired when sending orders to CPRS with Stop Date/Time in the "
^DIC(9.4,77,22,17,"PAH",231,1,296,0)="    past."
^DIC(9.4,77,22,17,"PAH",231,1,297,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,298,0)="    Solution:"
^DIC(9.4,77,22,17,"PAH",231,1,299,0)="    ---------"
^DIC(9.4,77,22,17,"PAH",231,1,300,0)="    Routine PSJHL3 has been modified to change the order status to "
^DIC(9.4,77,22,17,"PAH",231,1,301,0)="    Expired, if the order's Stop Date/Time is in the past, when sending "
^DIC(9.4,77,22,17,"PAH",231,1,302,0)="    orders to CPRS. "
^DIC(9.4,77,22,17,"PAH",231,1,303,0)="    **This is a partial solution addressing Inpatient Medications V.5.0"
^DIC(9.4,77,22,17,"PAH",231,1,304,0)="      functionality only. Patch OR*3*350 addresses CPRS GUI functionality."
^DIC(9.4,77,22,17,"PAH",231,1,305,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,306,0)=" 3. HD 377288 (original) - Default response should be ""No"""
^DIC(9.4,77,22,17,"PAH",231,1,307,0)="    "
^DIC(9.4,77,22,17,"PAH",231,1,308,0)="    Problem"
^DIC(9.4,77,22,17,"PAH",231,1,309,0)="    -------"
^DIC(9.4,77,22,17,"PAH",231,1,310,0)="    When an Inpatient Unit Dose order's Dosage Ordered field does not "
^DIC(9.4,77,22,17,"PAH",231,1,311,0)="    match the dosage indicated by the Dispense Drug and Units per "
^DIC(9.4,77,22,17,"PAH",231,1,312,0)="    Dose fields, the warning prompt ""Would you like to continue"
^DIC(9.4,77,22,17,"PAH",231,1,313,0)="    verifying the order?"" is displayed after accepting the order via the "
^DIC(9.4,77,22,17,"PAH",231,1,314,0)="    AC-Accept action. The prompt's default response is ""Yes"", even though "
^DIC(9.4,77,22,17,"PAH",231,1,315,0)="    the order is flawed."
^DIC(9.4,77,22,17,"PAH",231,1,316,0)="                         "
^DIC(9.4,77,22,17,"PAH",231,1,317,0)="    The Inpatient Medications Workgroup has requested "
^DIC(9.4,77,22,17,"PAH",231,1,318,0)="    this be changed to ""No""."
^DIC(9.4,77,22,17,"PAH",231,1,319,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,320,0)="    Solution"
^DIC(9.4,77,22,17,"PAH",231,1,321,0)="    -------- "
^DIC(9.4,77,22,17,"PAH",231,1,322,0)="    When an Inpatient Unit Dose order's Dosage Ordered fi eld does not "
^DIC(9.4,77,22,17,"PAH",231,1,323,0)="    match the dosage indicated by the Dispense Drug and Units per "
^DIC(9.4,77,22,17,"PAH",231,1,324,0)="    Dose fields, the default response for the prompt ""Would you like to"
^DIC(9.4,77,22,17,"PAH",231,1,325,0)="    continue verifying the order?"" will be changed to ""No"", as requested "
^DIC(9.4,77,22,17,"PAH",231,1,326,0)="    by the Inpatient Medications Workgroup."
^DIC(9.4,77,22,17,"PAH",231,1,327,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,328,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,329,0)=" 4. HD 273000 (original) - Field Validation Not Correct"
^DIC(9.4,77,22,17,"PAH",231,1,330,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,331,0)="    Problem"
^DIC(9.4,77,22,17,"PAH",231,1,332,0)="    -------"
^DIC(9.4,77,22,17,"PAH",231,1,333,0)="    When a second Dispense drug is added to a Unit Dose medication order,"
^DIC(9.4,77,22,17,"PAH",231,1,334,0)="    and no Dosage Ordered is selected, the following message display:"
^DIC(9.4,77,22,17,"PAH",231,1,335,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,336,0)="        THE FOLLOWING IS EITHER INVALID OR MISSING FROM THIS ORDER:"
^DIC(9.4,77,22,17,"PAH",231,1,337,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,338,0)="        THIS FIELD IS NECESSARY FOR VERIFICATION."
^DIC(9.4,77,22,17,"PAH",231,1,339,0)="        Enter RETURN to continue or '^' to exit: "
^DIC(9.4,77,22,17,"PAH",231,1,340,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,341,0)="    Note that there is no actual field name displayed as an invalid field."
^DIC(9.4,77,22,17,"PAH",231,1,342,0)="    This is incorrect. "
^DIC(9.4,77,22,17,"PAH",231,1,343,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,344,0)="    Solution"
^DIC(9.4,77,22,17,"PAH",231,1,345,0)="    --------"
^DIC(9.4,77,22,17,"PAH",231,1,346,0)="    In CHK^PSGOEV the variable CHK gets set to 8 and there is no handling"
^DIC(9.4,77,22,17,"PAH",231,1,347,0)="    for a value of 8. The message is correct when CHK is set to 7."
^DIC(9.4,77,22,17,"PAH",231,1,348,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,349,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,350,0)=" 5. HD 517634/PSPO 2137 - Provider Comments not displayed."
^DIC(9.4,77,22,17,"PAH",231,1,351,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,352,0)="    Problem"
^DIC(9.4,77,22,17,"PAH",231,1,353,0)="    -------"
^DIC(9.4,77,22,17,"PAH",231,1,354,0)="    Provider Comments for continuous IV orders are not displaying in CPRS"
^DIC(9.4,77,22,17,"PAH",231,1,355,0)="    after the order is verified in Inpatient Medications."
^DIC(9.4,77,22,17,"PAH",231,1,356,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,357,0)="    Resolution"
^DIC(9.4,77,22,17,"PAH",231,1,358,0)="    ----------"
^DIC(9.4,77,22,17,"PAH",231,1,359,0)="    When IV orders are verified in Inpatient Medications, if the order"
^DIC(9.4,77,22,17,"PAH",231,1,360,0)="    contains Provider Comments, include the Provider Comments in the"
^DIC(9.4,77,22,17,"PAH",231,1,361,0)="    update sent to CPRS in order to keep the order synchronized."
^DIC(9.4,77,22,17,"PAH",231,1,362,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,363,0)=" 6. HD 586428/PSPO 2137 - Provider Comments not displayed after Verify."
^DIC(9.4,77,22,17,"PAH",231,1,364,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,365,0)="    Problem"
^DIC(9.4,77,22,17,"PAH",231,1,366,0)="    -------"
^DIC(9.4,77,22,17,"PAH",231,1,367,0)="    When an IV order is created with Provider Comments, and then edited"
^DIC(9.4,77,22,17,"PAH",231,1,368,0)="    prior to verification so as to trigger the creation of a new order,"
^DIC(9.4,77,22,17,"PAH",231,1,369,0)="    Provider Comments do not carry over to the new order if auto-verify "
^DIC(9.4,77,22,17,"PAH",231,1,370,0)="    is not used. As a result, the verifying pharmacist may not see the"
^DIC(9.4,77,22,17,"PAH",231,1,371,0)="    original Provider Comments."
^DIC(9.4,77,22,17,"PAH",231,1,372,0)=" "
^DIC(9.4,77,22,17,"PAH",231,1,373,0)="    Solution"
^DIC(9.4,77,22,17,"PAH",231,1,374,0)="    --------"
^DIC(9.4,77,22,17,"PAH",231,1,375,0)="    Prior to the initial verification of an order, the original Provider "
^DIC(9.4,77,22,17,"PAH",231,1,376,0)="    Comments should carry over to new a order created due to edit, so that"
^DIC(9.4,77,22,17,"PAH",231,1,377,0)="    the pharmacist verifying the order has an opportunity to see the "
^DIC(9.4,77,22,17,"PAH",231,1,378,0)="    Provider Comments."
^DIC(9.4,77,22,17,"PAH",232,0)="274 SEQ #233^3120917.134804^17"
^DIC(9.4,77,22,17,"PAH",232,1,0)="^^4^4^3120917"
