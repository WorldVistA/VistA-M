^DIC(9.4,47,22,5.9,"PAH",150,0)="266 SEQ #228^2991210^1"
^DIC(9.4,47,22,5.9,"PAH",150,1,0)="^^1^1^2991210"
^DIC(9.4,47,22,5.9,"PAH",150,1,1,0)="This patch corrects Enrollment issues."
^DIC(9.4,47,22,5.9,"PAH",151,0)="260 SEQ #229^2991210^1"
^DIC(9.4,47,22,5.9,"PAH",151,1,0)="^^1^1^2991210"
^DIC(9.4,47,22,5.9,"PAH",151,1,1,0)="This patch distributes the Means Test thresholds for the year 2000."
^DIC(9.4,47,22,5.9,"PAH",152,0)="262 SEQ #230^2991210^1"
^DIC(9.4,47,22,5.9,"PAH",152,1,0)="^^2^2^2991210"
^DIC(9.4,47,22,5.9,"PAH",152,1,1,0)="This patch updates the PTF CENSUS DATE (#45.86) file for the 1st quarter"
^DIC(9.4,47,22,5.9,"PAH",152,1,2,0)="of FY 2000 census."
