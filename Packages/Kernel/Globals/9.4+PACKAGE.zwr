^DIC(9.4,48,22,5.28,"PAH",213,1,3,0)="Modified linetag ENROL to remove the statement- Q:X>366 """"."
^DIC(9.4,48,22,5.28,"PAH",213,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",213,1,5,0)="SCRPW43:"
