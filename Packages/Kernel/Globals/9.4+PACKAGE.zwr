^DIC(9.4,100,22,15,"PAH",21,1,88,0)="   ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",21,1,89,0)="   ================"
^DIC(9.4,100,22,15,"PAH",21,1,90,0)="    "
^DIC(9.4,100,22,15,"PAH",21,1,91,0)="   The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",21,1,92,0)="   "
^DIC(9.4,100,22,15,"PAH",21,1,93,0)="   <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",21,1,94,0)="    "
^DIC(9.4,100,22,15,"PAH",21,1,95,0)="                                   Checksum Values"
