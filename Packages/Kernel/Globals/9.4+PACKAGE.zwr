^DIC(9.4,14,22,5.9,"PAH",278,1,642,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,643,0)="5.  EDIT OF DISPLAY GROUPS FILE (#100.98):  Editing the DISPLAY "
^DIC(9.4,14,22,5.9,"PAH",278,1,644,0)="    GROUPS file (#100.98) will display the Anatomic Pathology orders under"
^DIC(9.4,14,22,5.9,"PAH",278,1,645,0)="    Anatomic Pathology Display Group instead of the Laboratory Display"
^DIC(9.4,14,22,5.9,"PAH",278,1,646,0)="    group within the CPRS Order tab. The following steps will need to be"
^DIC(9.4,14,22,5.9,"PAH",278,1,647,0)="    performed."
^DIC(9.4,14,22,5.9,"PAH",278,1,648,0)="    Coordinate these changes with your Clinical Coordinator."
^DIC(9.4,14,22,5.9,"PAH",278,1,649,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,650,0)="     a. Edit ANATOMIC PATHOLOGY display group and add SP, CY and EM "
^DIC(9.4,14,22,5.9,"PAH",278,1,651,0)="        display groups as Members."
^DIC(9.4,14,22,5.9,"PAH",278,1,652,0)="        INPUT TO WHAT FILE: DISPLAY GROUP// "
^DIC(9.4,14,22,5.9,"PAH",278,1,653,0)="        EDIT WHICH FIELD: ALL// "
^DIC(9.4,14,22,5.9,"PAH",278,1,654,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,655,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,656,0)="        Select DISPLAY GROUP NAME: anatOMIC PATHOLOGY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,657,0)="        NAME: ANATOMIC PATHOLOGY// "
^DIC(9.4,14,22,5.9,"PAH",278,1,658,0)="        Select MEMBER: SURGICAL PATHOLOGY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,659,0)="         Are you adding 'SURGICAL PATHOLOGY' as a new MEMBER (the 1ST for"
^DIC(9.4,14,22,5.9,"PAH",278,1,660,0)="         this DISPLAY GROUP)? No// Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,661,0)="           MEMBER SEQUENCE: 1// "
^DIC(9.4,14,22,5.9,"PAH",278,1,662,0)="        Select MEMBER: CYTOLOGY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,663,0)="         Are you adding 'CYTOLOGY' as a new MEMBER (the 2ND for this"
^DIC(9.4,14,22,5.9,"PAH",278,1,664,0)="         DISPLAY GROUP)? No // Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,665,0)="           MEMBER SEQUENCE: 2// "
^DIC(9.4,14,22,5.9,"PAH",278,1,666,0)="        Select MEMBER: ELECTRON MICROSCOPY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,667,0)="         Are you adding 'ELECTRON MICROSCOPY' as a new MEMBER (the 3RD for"
^DIC(9.4,14,22,5.9,"PAH",278,1,668,0)="         this DISPLAY GROUP)? No// Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,669,0)="           MEMBER SEQUENCE: 3// "
^DIC(9.4,14,22,5.9,"PAH",278,1,670,0)="        Select MEMBER: "
^DIC(9.4,14,22,5.9,"PAH",278,1,671,0)="        MIXED NAME: Anat. Path.// "
^DIC(9.4,14,22,5.9,"PAH",278,1,672,0)="        SHORT NAME: AP// "
^DIC(9.4,14,22,5.9,"PAH",278,1,673,0)="        DEFAULT DIALOG: [leave blank]"
^DIC(9.4,14,22,5.9,"PAH",278,1,674,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,675,0)="     b.Delete the AP display groups (SP,CYand EM) from the LABORATORY "
^DIC(9.4,14,22,5.9,"PAH",278,1,676,0)="        display group entry."
^DIC(9.4,14,22,5.9,"PAH",278,1,677,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,678,0)="        Select DISPLAY GROUP NAME: lab  LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",278,1,679,0)="        NAME: LABORATORY// "
^DIC(9.4,14,22,5.9,"PAH",278,1,680,0)="        Select MEMBER: CYTOLOGY// @"
^DIC(9.4,14,22,5.9,"PAH",278,1,681,0)="           SURE YOU WANT TO DELETE THE ENTIRE MEMBER? Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,682,0)="        Select MEMBER: AUTOPSY// SURGICAL PATHOLOGY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,683,0)="                 ...OK? Yes//   (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,684,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,685,0)="          MEMBER: SURGICAL PATHOLOGY// @"
^DIC(9.4,14,22,5.9,"PAH",278,1,686,0)="           SURE YOU WANT TO DELETE THE ENTIRE MEMBER? Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,687,0)="        Select MEMBER: ELECT  RON MICROSCOPY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,688,0)="         ...OK? Yes//   (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,689,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,690,0)="          MEMBER: ELECTRON MICROSCOPY// @"
^DIC(9.4,14,22,5.9,"PAH",278,1,691,0)="           SURE YOU WANT TO DELETE THE ENTIRE MEMBER? Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,692,0)="        Select MEMBER: ?"
^DIC(9.4,14,22,5.9,"PAH",278,1,693,0)="            Answer with MEMBER, or SEQUENCE"
^DIC(9.4,14,22,5.9,"PAH",278,1,694,0)="           Choose from:"
^DIC(9.4,14,22,5.9,"PAH",278,1,695,0)="           1            CHEMISTRY"
^DIC(9.4,14,22,5.9,"PAH",278,1,696,0)="           2            HEMATOLOGY"
^DIC(9.4,14,22,5.9,"PAH",278,1,697,0)="           3            MICROBIOLOGY"
^DIC(9.4,14,22,5.9,"PAH",278,1,698,0)="           4            BLOOD BANK"
^DIC(9.4,14,22,5.9,"PAH",278,1,699,0)="           5            ANATOMIC PATHOLOGY"
^DIC(9.4,14,22,5.9,"PAH",278,1,700,0)="           8            AUTOPSY"
^DIC(9.4,14,22,5.9,"PAH",278,1,701,0)="    "
^DIC(9.4,14,22,5.9,"PAH",278,1,702,0)="             You may enter a new MEMBER, if you wish"
^DIC(9.4,14,22,5.9,"PAH",278,1,703,0)="             Enter a display group.  A display group that is an ancestor"
^DIC(9.4,14,22,5.9,"PAH",278,1,704,0)="             may not also be a member."
^DIC(9.4,14,22,5.9,"PAH",278,1,705,0)="          Answer with DISPLAY GROUP NAME"
^DIC(9.4,14,22,5.9,"PAH",278,1,706,0)="          Do you want the entire 59-Entry DISPLAY GROUP List? "
^DIC(9.4,14,22,5.9,"PAH",278,1,707,0)="      "
^DIC(9.4,14,22,5.9,"PAH",278,1,708,0)="          You may enter a new DISPLAY GROUP, if you wish"
^DIC(9.4,14,22,5.9,"PAH",278,1,709,0)="          ANSWER MUST BE 3-30 CHARACTERS IN LENGTH"
^DIC(9.4,14,22,5.9,"PAH",278,1,710,0)="       Select MEMBER:"
^DIC(9.4,14,22,5.9,"PAH",278,1,711,0)="       MIXED NAME: Lab// "
^DIC(9.4,14,22,5.9,"PAH",278,1,712,0)="       SHORT NAME: LAB// "
^DIC(9.4,14,22,5.9,"PAH",278,1,713,0)="       DEFAULT DIALOG: LR OTHER LAB TESTS//"
^DIC(9.4,14,22,5.9,"PAH",278,1,714,0)="     "
^DIC(9.4,14,22,5.9,"PAH",278,1,715,0)="     c. Add ANATOMIC PATHOLOGY display group to the ALL SERVICES display"
^DIC(9.4,14,22,5.9,"PAH",278,1,716,0)="        group."
^DIC(9.4,14,22,5.9,"PAH",278,1,717,0)="        Select DISPLAY GROUP NAME: ALL SERVICES  "
^DIC(9.4,14,22,5.9,"PAH",278,1,718,0)="        NAME: ALL SERVICES// "
^DIC(9.4,14,22,5.9,"PAH",278,1,719,0)="        Select MEMBER: CLINIC SCHEDULING// ANATOMIC PATHOLOGY  "
^DIC(9.4,14,22,5.9,"PAH",278,1,720,0)="         Are you adding 'ANATOMIC PATHOLOGY' as a new MEMBER (the 21ST for"
^DIC(9.4,14,22,5.9,"PAH",278,1,721,0)="         this DISPLAY GROUP)? No// Y  (Yes)"
^DIC(9.4,14,22,5.9,"PAH",278,1,722,0)="            MEMBER SEQUENCE: 21//"
^DIC(9.4,14,22,5.9,"PAH",278,1,723,0)="         Select MEMBER: "
^DIC(9.4,14,22,5.9,"PAH",278,1,724,0)="         MIXED NAME: All// "
^DIC(9.4,14,22,5.9,"PAH",278,1,725,0)="         SHORT NAME: ALL// "
^DIC(9.4,14,22,5.9,"PAH",278,1,726,0)="         DEFAULT DIALOG:"
^DIC(9.4,14,22,5.9,"PAH",278,1,727,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,728,0)="6.   REVIEW ORWOR CATEGORY SEQUENCE PARAMETER:  Review the 'Anatomic "
^DIC(9.4,14,22,5.9,"PAH",278,1,729,0)="     Pathology' display group is set in ORWOR CATEGORY SEQUENCE parameter"
^DIC(9.4,14,22,5.9,"PAH",278,1,730,0)="     at the Package level as sequence number 74 which will enable the "
^DIC(9.4,14,22,5.9,"PAH",278,1,731,0)="     Anatomic Pathology order to sort ahead of other Laboratory orders on"
^DIC(9.4,14,22,5.9,"PAH",278,1,732,0)="     the CPRS Orders tab. If ANATOMIC PATHOLOGY is not present or not in "
^DIC(9.4,14,22,5.9,"PAH",278,1,733,0)="     sequence 74 have the IRM edit the package level."
^DIC(9.4,14,22,5.9,"PAH",278,1,734,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,735,0)="     Note: If this parameter contains values for the User or System levels"
^DIC(9.4,14,22,5.9,"PAH",278,1,736,0)="           edit these entries and add ANATOMIC PATHOLOGY as a sequence "
^DIC(9.4,14,22,5.9,"PAH",278,1,737,0)="           number just before the LABORATORY entry."
^DIC(9.4,14,22,5.9,"PAH",278,1,738,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,739,0)="Select OPTION NAME: XPAR MENU TOOLS       General Parameter Tools"
^DIC(9.4,14,22,5.9,"PAH",278,1,740,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,741,0)=" "
