^DIC(9.4,14,22,5.9,"PAH",152,1,288,0)="correct entry."
^DIC(9.4,14,22,5.9,"PAH",152,1,289,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,290,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",152,1,291,0)="VERIFY WHICH FIELD: SNOMED CODE  "
