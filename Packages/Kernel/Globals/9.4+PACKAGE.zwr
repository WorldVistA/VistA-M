^DIC(9.4,11,22,5.03,"PAH",20,1,138,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,139,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,140,0)="The documentation and distribution files for patches LA*5.2*58 and"
^DIC(9.4,11,22,5.03,"PAH",20,1,141,0)="LR*5.2*266 may be obtained using FTP from the appropriate National VistA"
^DIC(9.4,11,22,5.03,"PAH",20,1,142,0)="Support directory:"
^DIC(9.4,11,22,5.03,"PAH",20,1,143,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,144,0)="    OI FIELD OFFICE       FTP ADDRESS             DIRECTORY"
^DIC(9.4,11,22,5.03,"PAH",20,1,145,0)="    ===============       ===========             =========="
^DIC(9.4,11,22,5.03,"PAH",20,1,146,0)="     HINES               152.129.1.110      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,11,22,5.03,"PAH",20,1,147,0)="     SALT LAKE CITY      152.131.2.1        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,11,22,5.03,"PAH",20,1,148,0)="     ALBANY              152.127.1.5        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,11,22,5.03,"PAH",20,1,149,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,150,0)="File names are:"
^DIC(9.4,11,22,5.03,"PAH",20,1,151,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,152,0)=" ASCII FILE"
^DIC(9.4,11,22,5.03,"PAH",20,1,153,0)="  LA_52_P58.KID     -  KIDS distribution for LA*5.2*58 and LR*5.2*266"
^DIC(9.4,11,22,5.03,"PAH",20,1,154,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,155,0)=" BINARY FILE"
^DIC(9.4,11,22,5.03,"PAH",20,1,156,0)="  LA7DIG.PDF        -  CareVue Installation Guide"
^DIC(9.4,11,22,5.03,"PAH",20,1,157,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,158,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",20,1,159,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",20,1,160,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,161,0)="  NOTE: This KIDS install does not place any options out of service"
^DIC(9.4,11,22,5.03,"PAH",20,1,162,0)="        during the install and no user options are affected."
^DIC(9.4,11,22,5.03,"PAH",20,1,163,0)="        If KIDS prompts:"
^DIC(9.4,11,22,5.03,"PAH",20,1,164,0)="  "
^DIC(9.4,11,22,5.03,"PAH",20,1,165,0)="        ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,11,22,5.03,"PAH",20,1,166,0)="         Install? YES// NO"""
^DIC(9.4,11,22,5.03,"PAH",20,1,167,0)="        ""Want KIDS to INHIBIT LOGONs during the install? YES// NO"""
^DIC(9.4,11,22,5.03,"PAH",20,1,168,0)="        ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,11,22,5.03,"PAH",20,1,169,0)="        Protocols? YES// NO"""
^DIC(9.4,11,22,5.03,"PAH",20,1,170,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,171,0)="        The site should answer ""NO"" to all three questions."
^DIC(9.4,11,22,5.03,"PAH",20,1,172,0)="            Note: You may not receive all three prompts at your site.  "
^DIC(9.4,11,22,5.03,"PAH",20,1,173,0)="  "
^DIC(9.4,11,22,5.03,"PAH",20,1,174,0)="     1. Review your mapped set.  If any of the routines listed in"
^DIC(9.4,11,22,5.03,"PAH",20,1,175,0)="        patches LA*5.2*58 or LR*5.2*266 are mapped, they should be"
^DIC(9.4,11,22,5.03,"PAH",20,1,176,0)="        removed from the mapped set at this time."
^DIC(9.4,11,22,5.03,"PAH",20,1,177,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,178,0)="     2. From the Kernel Installation & Distribution System menu (XPD"
^DIC(9.4,11,22,5.03,"PAH",20,1,179,0)="        MAIN), select the Installation menu option, then the option,"
^DIC(9.4,11,22,5.03,"PAH",20,1,180,0)="        Load a Distribution. Enter your directory name and"
^DIC(9.4,11,22,5.03,"PAH",20,1,181,0)="        LA_52_P58.KID at the Host File prompt."
^DIC(9.4,11,22,5.03,"PAH",20,1,182,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,183,0)="     3. The patch has now been loaded into a Transport global on"
^DIC(9.4,11,22,5.03,"PAH",20,1,184,0)="        your system. You now need to use KIDS to install the "
^DIC(9.4,11,22,5.03,"PAH",20,1,185,0)="        Transport global."
^DIC(9.4,11,22,5.03,"PAH",20,1,186,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,187,0)="        On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,11,22,5.03,"PAH",20,1,188,0)="        following options:"
^DIC(9.4,11,22,5.03,"PAH",20,1,189,0)="           Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",20,1,190,0)="           Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",20,1,191,0)="           Verify Checksums in Transport Global"
^DIC(9.4,11,22,5.03,"PAH",20,1,192,0)="           Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",20,1,193,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,194,0)="     4. It is recommended that this release be installed during off"
^DIC(9.4,11,22,5.03,"PAH",20,1,195,0)="        peak hours.  To prevent a possible problem with the tasking"
^DIC(9.4,11,22,5.03,"PAH",20,1,196,0)="        of the next days laboratory orders, do not install this package"
^DIC(9.4,11,22,5.03,"PAH",20,1,197,0)="        at the same time as the following nightly tasked jobs:"
^DIC(9.4,11,22,5.03,"PAH",20,1,198,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,199,0)="              LRTASK ROLLOVER"
^DIC(9.4,11,22,5.03,"PAH",20,1,200,0)="              LRTASK NIGHTLY"
^DIC(9.4,11,22,5.03,"PAH",20,1,201,0)="              LRTASK CONJAM"
^DIC(9.4,11,22,5.03,"PAH",20,1,202,0)="              LRTASK CUM"
^DIC(9.4,11,22,5.03,"PAH",20,1,203,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,204,0)="     5. No options need to be placed out of service."
^DIC(9.4,11,22,5.03,"PAH",20,1,205,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,206,0)="     6. Installation time is less than 2 minutes during off peak "
^DIC(9.4,11,22,5.03,"PAH",20,1,207,0)="        hours and less than 5 minutes during peak hours"
^DIC(9.4,11,22,5.03,"PAH",20,1,208,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,209,0)="     7. From the 'Installation Menu' of the KIDS menu, run the "
^DIC(9.4,11,22,5.03,"PAH",20,1,210,0)="        option 'Install Package(s)' Select the package 'LA*5.2*58'"
^DIC(9.4,11,22,5.03,"PAH",20,1,211,0)="        and proceed with the install. When prompted 'Want to "
^DIC(9.4,11,22,5.03,"PAH",20,1,212,0)="        DISABLE Scheduled Options, Menu Options, and Protocols? "
^DIC(9.4,11,22,5.03,"PAH",20,1,213,0)="        YES//', choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",20,1,214,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,215,0)="     8. This patch updates the Processing RTN field (#771) and the"
^DIC(9.4,11,22,5.03,"PAH",20,1,216,0)="        Response Processing RTN field (#772) of the Protocol file"
^DIC(9.4,11,22,5.03,"PAH",20,1,217,0)="        (#101) for the LA7D CARELIFE RESULTS and LA7D CARELIFE SERVER"
^DIC(9.4,11,22,5.03,"PAH",20,1,218,0)="        entries. The letter ""Q"" will be entered by the post-init"
^DIC(9.4,11,22,5.03,"PAH",20,1,219,0)="        routine LR266 if no entry exists.  The LR266 routine will"
^DIC(9.4,11,22,5.03,"PAH",20,1,220,0)="        automatically be deleted after the patch is installed."
^DIC(9.4,11,22,5.03,"PAH",20,1,221,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,222,0)="     9. If any routines were unmapped as part of step 2, they "
^DIC(9.4,11,22,5.03,"PAH",20,1,223,0)="        should be returned to the mapped set once the installation "
^DIC(9.4,11,22,5.03,"PAH",20,1,224,0)="        has run to completion."
^DIC(9.4,11,22,5.03,"PAH",21,0)="57 SEQ #41^3010423^1"
^DIC(9.4,11,22,5.03,"PAH",21,1,0)="^^538^538^3010423"
^DIC(9.4,11,22,5.03,"PAH",21,1,1,0)="VISTA Laboratory Package patch LA*5.2*57 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",21,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",21,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,4,0)="This patch addresses fixes/enhancements to the Lab Universal Interface"
^DIC(9.4,11,22,5.03,"PAH",21,1,5,0)="Auto Download requested in several NOIS's and E3R's. It allows the auto"
^DIC(9.4,11,22,5.03,"PAH",21,1,6,0)="download to be configured to only transmit orders for collected specimens."
^DIC(9.4,11,22,5.03,"PAH",21,1,7,0)="It enhances the auto download to determine if a test order is transmitted"
^DIC(9.4,11,22,5.03,"PAH",21,1,8,0)="to an automated instrument based on the accession area, specimen type and"
^DIC(9.4,11,22,5.03,"PAH",21,1,9,0)="test urgency of each test on the accession."
^DIC(9.4,11,22,5.03,"PAH",21,1,10,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,11,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,12,0)="   *****************************************************************"
^DIC(9.4,11,22,5.03,"PAH",21,1,13,0)="   * PLEASE NOTE: To utilize the functionality added by this patch *"
^DIC(9.4,11,22,5.03,"PAH",21,1,14,0)="   * to control auto downloading of uncollected specimens install  *"
^DIC(9.4,11,22,5.03,"PAH",21,1,15,0)="   * patch LR*5.2*262 before implementing this functionality.      *"
^DIC(9.4,11,22,5.03,"PAH",21,1,16,0)="   *****************************************************************"
^DIC(9.4,11,22,5.03,"PAH",21,1,17,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,19,0)="1.  NOIS CHA-1199-31572 reported that when a site entered an invalid"
^DIC(9.4,11,22,5.03,"PAH",21,1,20,0)="    label^routine name in FILE BUILD ENTRY field (#93) and FILE BUILD"
^DIC(9.4,11,22,5.03,"PAH",21,1,21,0)="    ROUTINE field (#94) in the AUTO INSTRUMENT file (#62.4), the auto"
^DIC(9.4,11,22,5.03,"PAH",21,1,22,0)="    download process would error with the following message:"
^DIC(9.4,11,22,5.03,"PAH",21,1,23,0)="    $ZE= UID+28^LA7ADL:3, %DSM-E-PNAME, bad routine name"
^DIC(9.4,11,22,5.03,"PAH",21,1,24,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,25,0)="    The auto download process will check for valid routine and label"
^DIC(9.4,11,22,5.03,"PAH",21,1,26,0)="    entry points. If an invalid/missing routine/label is found then the"
^DIC(9.4,11,22,5.03,"PAH",21,1,27,0)="    auto download process will ignore that entry in file #62.4 and send"
^DIC(9.4,11,22,5.03,"PAH",21,1,28,0)="    an alert to the mail group LAB MESSAGING with one of the following"
^DIC(9.4,11,22,5.03,"PAH",21,1,29,0)="    messages:"
^DIC(9.4,11,22,5.03,"PAH",21,1,30,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,31,0)="    a. When no routine is entered in field #94."
^DIC(9.4,11,22,5.03,"PAH",21,1,32,0)="      ""No download routine (field #94) specified for AUTO INSTRUMENT: xxx"""
^DIC(9.4,11,22,5.03,"PAH",21,1,33,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,34,0)="    b. When the routine referenced in field #94 does not exist."
^DIC(9.4,11,22,5.03,"PAH",21,1,35,0)="       ""Invalid download routine (field #94) specified for AUTO"
^DIC(9.4,11,22,5.03,"PAH",21,1,36,0)="        INSTRUMENT: xxx"""
^DIC(9.4,11,22,5.03,"PAH",21,1,37,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,38,0)="    c. When the routine label referenced in field #93 does not exist."
^DIC(9.4,11,22,5.03,"PAH",21,1,39,0)="       ""Invalid download routine label (field #93) specified for AUTO"
^DIC(9.4,11,22,5.03,"PAH",21,1,40,0)="       in the AUTO INSTRUMENT file (#62.4) INSTRUMENT: xxx"""
^DIC(9.4,11,22,5.03,"PAH",21,1,41,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,42,0)="      where ""xxx"" is the value of the NAME field (#.01) in AUTO INSTRUMENT "
^DIC(9.4,11,22,5.03,"PAH",21,1,43,0)="      file (#62.4)."
^DIC(9.4,11,22,5.03,"PAH",21,1,44,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,45,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,46,0)="2.  NOIS CHA-1199-31572 reported an inaccurate comment in the routine"
^DIC(9.4,11,22,5.03,"PAH",21,1,47,0)="    LA7ADL. Comment ""File build (entry^routine) from fields #92 and #93 in"
^DIC(9.4,11,22,5.03,"PAH",21,1,48,0)="    file 62.4"". The reference to field numbers is incorrect.  Comment has"
^DIC(9.4,11,22,5.03,"PAH",21,1,49,0)="    been corrected to reflect fields #93 and #94."
^DIC(9.4,11,22,5.03,"PAH",21,1,50,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,51,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,52,0)="3.  NOIS IND-0200-41054 requested the ability to screen on an accession's"
^DIC(9.4,11,22,5.03,"PAH",21,1,53,0)="    specimen type to determine if an order should be downloaded to the"
^DIC(9.4,11,22,5.03,"PAH",21,1,54,0)="    instrument. In addition to screening by specimen type, tests can also"
^DIC(9.4,11,22,5.03,"PAH",21,1,55,0)="    be screened by accession area and urgency."
^DIC(9.4,11,22,5.03,"PAH",21,1,56,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,57,0)="    This patch adds three new fields to support this functionality."
^DIC(9.4,11,22,5.03,"PAH",21,1,58,0)="    The fields are:"
^DIC(9.4,11,22,5.03,"PAH",21,1,59,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,60,0)="    ACCESSION AREA (#7), SPECIMEN (#8) and URGENCY (#9) within CHEM TESTS"
^DIC(9.4,11,22,5.03,"PAH",21,1,61,0)="    multiple field (#30) of the AUTO INSTRUMENT file (#62.4)."
^DIC(9.4,11,22,5.03,"PAH",21,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,63,0)="    When these fields are valued for a test in the CHEM TESTS multiple,"
^DIC(9.4,11,22,5.03,"PAH",21,1,64,0)="    an order for the test on the accession will only be transmitted to"
^DIC(9.4,11,22,5.03,"PAH",21,1,65,0)="    the instrument if it matches this criteria. Any field that is blank"
^DIC(9.4,11,22,5.03,"PAH",21,1,66,0)="    (no value) will match on any value for the field."
^DIC(9.4,11,22,5.03,"PAH",21,1,67,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,68,0)="    If the same test requires different screening criteria, the test can"
^DIC(9.4,11,22,5.03,"PAH",21,1,69,0)="    be entered multiple times and configured appropriately."
^DIC(9.4,11,22,5.03,"PAH",21,1,70,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,71,0)="    Example:"
^DIC(9.4,11,22,5.03,"PAH",21,1,72,0)="    Accession CH 0510 20 has a specimen type = plasma with the following"
^DIC(9.4,11,22,5.03,"PAH",21,1,73,0)="    tests:  GLUCOSE  (routine)"
^DIC(9.4,11,22,5.03,"PAH",21,1,74,0)="            BUN      (routine)"
^DIC(9.4,11,22,5.03,"PAH",21,1,75,0)="            CALCIUM  (stat)"
^DIC(9.4,11,22,5.03,"PAH",21,1,76,0)="   "
^DIC(9.4,11,22,5.03,"PAH",21,1,77,0)="    AUTO INSTRUMENT file is configured with entries that have the following"
^DIC(9.4,11,22,5.03,"PAH",21,1,78,0)="    tests: "
^DIC(9.4,11,22,5.03,"PAH",21,1,79,0)="    Test       Accession Area    Specimen     Urgency"
^DIC(9.4,11,22,5.03,"PAH",21,1,80,0)="    ----       --------------    --------     -------"
^DIC(9.4,11,22,5.03,"PAH",21,1,81,0)="    GLUCOSE    CH                <blank>      routine"
^DIC(9.4,11,22,5.03,"PAH",21,1,82,0)="    BUN        CH                serum        <blank>"
^DIC(9.4,11,22,5.03,"PAH",21,1,83,0)="    CALCIUM    <blank>           <blank>      stat"
^DIC(9.4,11,22,5.03,"PAH",21,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,85,0)="    This would create an order for GLUCOSE since it matched on the"
^DIC(9.4,11,22,5.03,"PAH",21,1,86,0)="    accession area, urgency and any specimen."
^DIC(9.4,11,22,5.03,"PAH",21,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,88,0)="    The BUN would not be sent to this instrument because it did not match"
^DIC(9.4,11,22,5.03,"PAH",21,1,89,0)="    on the specimen type while matching on the accession area and any"
^DIC(9.4,11,22,5.03,"PAH",21,1,90,0)="    urgency."
^DIC(9.4,11,22,5.03,"PAH",21,1,91,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,92,0)="    The CALCIUM would be sent because it matched on the urgency and any"
^DIC(9.4,11,22,5.03,"PAH",21,1,93,0)="    accession area and specimen type."
^DIC(9.4,11,22,5.03,"PAH",21,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,95,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,96,0)="4.  E3R #13785 - LRPHMAN & LRPHEXCPT BOTH SENDING HL7 MESSAGE requested the"
^DIC(9.4,11,22,5.03,"PAH",21,1,97,0)="    ability for the auto download to ignore specimens that have not been"
^DIC(9.4,11,22,5.03,"PAH",21,1,98,0)="    collected. This patch adds functionality to have the auto download only"
^DIC(9.4,11,22,5.03,"PAH",21,1,99,0)="    download specimens that are marked as collected. The auto download"
^DIC(9.4,11,22,5.03,"PAH",21,1,100,0)="    process will use INCLUDE UNCOLLECTED ACCESSIONS (#.1) in the LOAD/WORK"
^DIC(9.4,11,22,5.03,"PAH",21,1,101,0)="    LIST file (#68.2) to determine if a specimen should be downloaded to"
^DIC(9.4,11,22,5.03,"PAH",21,1,102,0)="    an instrument. Each entry in the AUTO INSTRUMENT file has a related"
^DIC(9.4,11,22,5.03,"PAH",21,1,103,0)="    LOAD/WORK LIST entry. Setting the INCLUDE UNCOLLECTED ACCESSIONS field"
^DIC(9.4,11,22,5.03,"PAH",21,1,104,0)="    to NO or blank (no value) will prevent the specimen/test downloading to"
^DIC(9.4,11,22,5.03,"PAH",21,1,105,0)="    the instrument. If the field is set to YES then uncollected specimens"
^DIC(9.4,11,22,5.03,"PAH",21,1,106,0)="    will be downloaded to an instrument. An accession is considered as"
^DIC(9.4,11,22,5.03,"PAH",21,1,107,0)="    being ""collected"" when the LAB ARRIVAL TIME field (#12) within the"
^DIC(9.4,11,22,5.03,"PAH",21,1,108,0)="    ACCESSION NUMBER multiple field (#68.02) within the DATE multiple"
^DIC(9.4,11,22,5.03,"PAH",21,1,109,0)="    field (#68.01) of ACCESSION file (#68) has a date/time."
^DIC(9.4,11,22,5.03,"PAH",21,1,110,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,111,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,112,0)="5.  The patch introduces the ability to have a test generate more"
^DIC(9.4,11,22,5.03,"PAH",21,1,113,0)="    than one test order. If an ordered test actually requires two or more"
^DIC(9.4,11,22,5.03,"PAH",21,1,114,0)="    tests to be performed on an instrument, then enter the test multiple"
^DIC(9.4,11,22,5.03,"PAH",21,1,115,0)="    times and associate the appropriate UI TEST CODE with the test to be"
^DIC(9.4,11,22,5.03,"PAH",21,1,116,0)="    ordered. "
^DIC(9.4,11,22,5.03,"PAH",21,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,118,0)="    For result processing purposes the test may need to be entered"
^DIC(9.4,11,22,5.03,"PAH",21,1,119,0)="    separately if the result test is associated with a different file"
^DIC(9.4,11,22,5.03,"PAH",21,1,120,0)="    #60 test or uses a different result code (UI TEST CODE). If the"
^DIC(9.4,11,22,5.03,"PAH",21,1,121,0)="    ordered and result test are the same and use the same UI TEST CODE"
^DIC(9.4,11,22,5.03,"PAH",21,1,122,0)="    then the same entry can be used for both purposes."
^DIC(9.4,11,22,5.03,"PAH",21,1,123,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,124,0)="    An example would be an order for ionized and normalized calcium."
^DIC(9.4,11,22,5.03,"PAH",21,1,125,0)="    To perform this test on the instrument it may need to perform both"
^DIC(9.4,11,22,5.03,"PAH",21,1,126,0)="    a pH and ionized calcium. In the AUTO INSTRUMENT file the test"
^DIC(9.4,11,22,5.03,"PAH",21,1,127,0)="    ionized calcium would be entered twice for ordering purposes. The"
^DIC(9.4,11,22,5.03,"PAH",21,1,128,0)="    first entry would be associated with ordering the ionized calcium"
^DIC(9.4,11,22,5.03,"PAH",21,1,129,0)="    while the second entry could be used to order the pH. "
^DIC(9.4,11,22,5.03,"PAH",21,1,130,0)="    "
^DIC(9.4,11,22,5.03,"PAH",21,1,131,0)="    TEST: IONIZED CALCIUM"
^DIC(9.4,11,22,5.03,"PAH",21,1,132,0)="    UI TEST CODE: mCa++                   ROUTINE STORAGE: TV(695837,1)"
^DIC(9.4,11,22,5.03,"PAH",21,1,133,0)="    ACCEPT RESULTS FOR THIS TEST: YES     DOWNLOAD TO INSTRUMENT: YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,134,0)="    (Note - this entry is used both to order the test and process the"
^DIC(9.4,11,22,5.03,"PAH",21,1,135,0)="    results since it uses the same UI TEST CODE for both purposes.)"
^DIC(9.4,11,22,5.03,"PAH",21,1,136,0)="   "
^DIC(9.4,11,22,5.03,"PAH",21,1,137,0)="    TEST: IONIZED CALCIUM"
^DIC(9.4,11,22,5.03,"PAH",21,1,138,0)="    UI TEST CODE: mpH                     ROUTINE STORAGE:  TV(695837,1)"
^DIC(9.4,11,22,5.03,"PAH",21,1,139,0)="    ACCEPT RESULTS FOR THIS TEST: NO      DOWNLOAD TO INSTRUMENT: YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,140,0)="    (Note - this entry is only used to order the pH and is not used to"
^DIC(9.4,11,22,5.03,"PAH",21,1,141,0)="    accept results.)"
^DIC(9.4,11,22,5.03,"PAH",21,1,142,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,143,0)="    TEST: NORMALIZED CALCIUM"
^DIC(9.4,11,22,5.03,"PAH",21,1,144,0)="    UI TEST CODE: cCa++                   ROUTINE STORAGE: TV(695838,1)"
^DIC(9.4,11,22,5.03,"PAH",21,1,145,0)="    ACCEPT RESULTS FOR THIS TEST: YES     DOWNLOAD TO INSTRUMENT: NO"
^DIC(9.4,11,22,5.03,"PAH",21,1,146,0)="    (Note - this entry is not used for ordering purposes but instead is"
^DIC(9.4,11,22,5.03,"PAH",21,1,147,0)="    used to process the result from the instrument.)"
^DIC(9.4,11,22,5.03,"PAH",21,1,148,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,149,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,150,0)="    A second example would be bicarbonate. To perform this test on the"
^DIC(9.4,11,22,5.03,"PAH",21,1,151,0)="    instrument it may need to perform both a pH and pCO2. In the AUTO"
^DIC(9.4,11,22,5.03,"PAH",21,1,152,0)="    INSTRUMENT file the test HCO3 would be entered twice for ordering"
^DIC(9.4,11,22,5.03,"PAH",21,1,153,0)="    purposes. The first entry would be associated with ordering the"
^DIC(9.4,11,22,5.03,"PAH",21,1,154,0)="    pCO2 while the second entry could be used to order the pH. This"
^DIC(9.4,11,22,5.03,"PAH",21,1,155,0)="    same test would be added a third time. This entry handles the result"
^DIC(9.4,11,22,5.03,"PAH",21,1,156,0)="    being transmitted by the instrument which uses a different UI TEST"
^DIC(9.4,11,22,5.03,"PAH",21,1,157,0)="    CODE for result purposes."
^DIC(9.4,11,22,5.03,"PAH",21,1,158,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,159,0)="    TEST: HCO3"
^DIC(9.4,11,22,5.03,"PAH",21,1,160,0)="    UI TEST CODE: mPCO2                   ROUTINE STORAGE: TV(8,1)"
^DIC(9.4,11,22,5.03,"PAH",21,1,161,0)="    ACCEPT RESULTS FOR THIS TEST: NO      DOWNLOAD TO INSTRUMENT: YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,162,0)="    (Note - this entry is only used to order the pCO2 and is not used to"
^DIC(9.4,11,22,5.03,"PAH",21,1,163,0)="    accept results.)"
^DIC(9.4,11,22,5.03,"PAH",21,1,164,0)="   "
^DIC(9.4,11,22,5.03,"PAH",21,1,165,0)="    TEST: HCO3"
^DIC(9.4,11,22,5.03,"PAH",21,1,166,0)="    UI TEST CODE: mpH                     ROUTINE STORAGE: TV(8,1)"
^DIC(9.4,11,22,5.03,"PAH",21,1,167,0)="    ACCEPT RESULTS FOR THIS TEST: NO      DOWNLOAD TO INSTRUMENT: YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,168,0)="    (Note - this entry is only used to order the pH and is not used to"
^DIC(9.4,11,22,5.03,"PAH",21,1,169,0)="    accept results.)"
^DIC(9.4,11,22,5.03,"PAH",21,1,170,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,171,0)="    TEST: HCO3"
^DIC(9.4,11,22,5.03,"PAH",21,1,172,0)="    UI TEST CODE: cHCO3act                ROUTINE STORAGE: TV(8,1)"
^DIC(9.4,11,22,5.03,"PAH",21,1,173,0)="    ACCEPT RESULTS FOR THIS TEST: YES     DOWNLOAD TO INSTRUMENT: NO "
^DIC(9.4,11,22,5.03,"PAH",21,1,174,0)="    (Note - this entry is not used for ordering purposes but instead is"
^DIC(9.4,11,22,5.03,"PAH",21,1,175,0)="    used to process the result from the instrument.)"
^DIC(9.4,11,22,5.03,"PAH",21,1,176,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,177,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,178,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,179,0)="6.  NOIS IND-0699-40171 reported that an invalid HL7 time value was being"
^DIC(9.4,11,22,5.03,"PAH",21,1,180,0)="    downloaded to an instrument."
^DIC(9.4,11,22,5.03,"PAH",21,1,181,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,182,0)="    When building a HL7 message the software will now check time values."
^DIC(9.4,11,22,5.03,"PAH",21,1,183,0)="    If the time is found to not conform to HL7 specifications for a time"
^DIC(9.4,11,22,5.03,"PAH",21,1,184,0)="    value it will adjusted as follows:"
^DIC(9.4,11,22,5.03,"PAH",21,1,185,0)="    "
^DIC(9.4,11,22,5.03,"PAH",21,1,186,0)="    If hours are greater than 24, hours will be reported as 24 with no"
^DIC(9.4,11,22,5.03,"PAH",21,1,187,0)="    minutes/seconds."
^DIC(9.4,11,22,5.03,"PAH",21,1,188,0)="    If minutes are greater than 59, minutes will be reported as 59"
^DIC(9.4,11,22,5.03,"PAH",21,1,189,0)="    If seconds are greater than 59, seconds will be reported as 59"
^DIC(9.4,11,22,5.03,"PAH",21,1,190,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,191,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,192,0)="7.  NOIS WPB-0997-31750 reported an ""undefined variable X in routine DIM"""
^DIC(9.4,11,22,5.03,"PAH",21,1,193,0)="    when the input transform for PARAM 1 (#2) within CHEM TESTS multiple"
^DIC(9.4,11,22,5.03,"PAH",21,1,194,0)="    field (#30) of the AUTO INSTRUMENT file (#62.4) kills the variable X."
^DIC(9.4,11,22,5.03,"PAH",21,1,195,0)="    The input transform will call DIM only if X is defined."
^DIC(9.4,11,22,5.03,"PAH",21,1,196,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,197,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,198,0)="8.  This patch also corrects the following Vista Programming Standards"
^DIC(9.4,11,22,5.03,"PAH",21,1,199,0)="    and Conventions (SAC) violations that were observed during software"
^DIC(9.4,11,22,5.03,"PAH",21,1,200,0)="    review as part of patch development:"
^DIC(9.4,11,22,5.03,"PAH",21,1,201,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,202,0)="    a. Removed direct global read of global ^VA(200) which contains the"
^DIC(9.4,11,22,5.03,"PAH",21,1,203,0)="       NEW PERSON file.  Routines LA7ADL1 and LA7UID2 were retrieving"
^DIC(9.4,11,22,5.03,"PAH",21,1,204,0)="       user's name. Call changed to Kernel supported reference"
^DIC(9.4,11,22,5.03,"PAH",21,1,205,0)="       (DBIA # 10060) using FileMan DBS call $$GET1^DIQ."
^DIC(9.4,11,22,5.03,"PAH",21,1,206,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,207,0)="    b. Removed several naked indicator references in routine LADOWN that"
^DIC(9.4,11,22,5.03,"PAH",21,1,208,0)="       were not documented. Routine changed to use full global reference."
^DIC(9.4,11,22,5.03,"PAH",21,1,209,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,210,0)="    c. Changed FileMan security on several fields in AUTO INSTRUMENT file"
^DIC(9.4,11,22,5.03,"PAH",21,1,211,0)="       (#62.4) per SAC section 3.2.6. See section ""FILE SECURITY"" below for"
^DIC(9.4,11,22,5.03,"PAH",21,1,212,0)="       additional information."
^DIC(9.4,11,22,5.03,"PAH",21,1,213,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,214,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,215,0)="9.  Corrects an ""undefined variable ^(2)"" error in routine LADOWN that"
^DIC(9.4,11,22,5.03,"PAH",21,1,216,0)="    was detected by laboratory development during the software review for"
^DIC(9.4,11,22,5.03,"PAH",21,1,217,0)="    the patch. This error would occur if an attempt to download a load/work"
^DIC(9.4,11,22,5.03,"PAH",21,1,218,0)="    list was initiated which have no specimens on the list."
^DIC(9.4,11,22,5.03,"PAH",21,1,219,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,220,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,221,0)="10. Removed software checks that would only allow downloading of entries"
^DIC(9.4,11,22,5.03,"PAH",21,1,222,0)="    in file #62.4 when the internal entry number was less than 100."
^DIC(9.4,11,22,5.03,"PAH",21,1,223,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,224,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,225,0)="11. A misspelling of the DOWNLOAD PROTOCOL ROUTINE (#92) field in the"
^DIC(9.4,11,22,5.03,"PAH",21,1,226,0)="    AUTO INSTRUMENT file (#62.4) is corrected. The word PROTOCOL in the"
^DIC(9.4,11,22,5.03,"PAH",21,1,227,0)="    field name was misspelled."
^DIC(9.4,11,22,5.03,"PAH",21,1,228,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,229,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,230,0)="12. The Download a load list to an Instrument option [LA DOWN] sets up the"
^DIC(9.4,11,22,5.03,"PAH",21,1,231,0)="    ^LA global for downloading records to an instrument that are direct"
^DIC(9.4,11,22,5.03,"PAH",21,1,232,0)="    connects or interfaced via the Lab LSI. The Lab Universal Interface"
^DIC(9.4,11,22,5.03,"PAH",21,1,233,0)="    does not use the LA global for this purpose. This option will only"
^DIC(9.4,11,22,5.03,"PAH",21,1,234,0)="    setup the ^LA global when the MESSAGE CONFIGURATION field (#8) in AUTO"
^DIC(9.4,11,22,5.03,"PAH",21,1,235,0)="    INSTRUMENT file is empty, indicating that this entry is not using the"
^DIC(9.4,11,22,5.03,"PAH",21,1,236,0)="    Lab Universal Interface."
^DIC(9.4,11,22,5.03,"PAH",21,1,237,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,238,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,239,0)="13. During patch development it was found that processing of the HL7"
^DIC(9.4,11,22,5.03,"PAH",21,1,240,0)="    specimen source from sequence 15 of the OBR segment of a HL7 Result"
^DIC(9.4,11,22,5.03,"PAH",21,1,241,0)="    (ORU) message was checking the entire first component of this field."
^DIC(9.4,11,22,5.03,"PAH",21,1,242,0)="    This checking should occur using the first sub-component of the first"
^DIC(9.4,11,22,5.03,"PAH",21,1,243,0)="    component of sequence 15. Routine LA7UIIN1 has been changed to"
^DIC(9.4,11,22,5.03,"PAH",21,1,244,0)="    correctly check the specimen source."
^DIC(9.4,11,22,5.03,"PAH",21,1,245,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,246,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,247,0)="14. Functionality that was tested by the test sites:"
^DIC(9.4,11,22,5.03,"PAH",21,1,248,0)="                                                    "
^DIC(9.4,11,22,5.03,"PAH",21,1,249,0)="                                                     Site  "
^DIC(9.4,11,22,5.03,"PAH",21,1,250,0)="Function                      | ASH | BHS | CPL | IND | MIW | STX | TVH | UNY"
^DIC(9.4,11,22,5.03,"PAH",21,1,251,0)="-----------------------------------------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",21,1,252,0)="Used auto download?           | YES | YES | YES | YES | YES | YES | YES | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,253,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,254,0)="Used download via loadlist?   | YES |  NO | YES |  NO |  NO |  NO |  NO | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,255,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,256,0)="Tested screening capabilities | YES | YES | YES |  NO | YES | YES | YES | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,257,0)="based on accession area?"
^DIC(9.4,11,22,5.03,"PAH",21,1,258,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,259,0)="Tested screening capabilities | YES | YES |  NO | YES | YES |  NO |  NO | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,260,0)="based on specimen type?"
^DIC(9.4,11,22,5.03,"PAH",21,1,261,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,262,0)="Tested screening capabilities | YES |  NO |  NO |  NO |  NO |  NO |  NO | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,263,0)="based on urgency?"
^DIC(9.4,11,22,5.03,"PAH",21,1,264,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,265,0)="Used combination of the above | YES | YES |  NO |  NO |  NO |  NO |  NO | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,266,0)="test screening capabilities?"
^DIC(9.4,11,22,5.03,"PAH",21,1,267,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,268,0)="Screened on collection status | YES | YES | YES | YES | YES | YES |  NO | YES"
^DIC(9.4,11,22,5.03,"PAH",21,1,269,0)="based on the associated"
^DIC(9.4,11,22,5.03,"PAH",21,1,270,0)="loadlist setting?          "
^DIC(9.4,11,22,5.03,"PAH",21,1,271,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,272,0)="Used capability to generate   | YES |  NO |  NO |  NO | YES |  NO |  NO |  NO"
^DIC(9.4,11,22,5.03,"PAH",21,1,273,0)="additional tests in the order"
^DIC(9.4,11,22,5.03,"PAH",21,1,274,0)="message?"
^DIC(9.4,11,22,5.03,"PAH",21,1,275,0)=""
^DIC(9.4,11,22,5.03,"PAH",21,1,276,0)=" Legend:  ASH = Asheville VAMC"
^DIC(9.4,11,22,5.03,"PAH",21,1,277,0)="          BHS = Boston HCS"
^DIC(9.4,11,22,5.03,"PAH",21,1,278,0)="          CPL = Central Plains HCS"
^DIC(9.4,11,22,5.03,"PAH",21,1,279,0)="          IND = Indianapolis VAMC"
^DIC(9.4,11,22,5.03,"PAH",21,1,280,0)="          MIW = Milwaukee VAMC"
^DIC(9.4,11,22,5.03,"PAH",21,1,281,0)="          STX = South Texas HCS "
^DIC(9.4,11,22,5.03,"PAH",21,1,282,0)="          TVH = Tennessee Valley HCS"
^DIC(9.4,11,22,5.03,"PAH",21,1,283,0)="          UNY = Upstate New York HCS (VISN 2)"
^DIC(9.4,11,22,5.03,"PAH",21,1,284,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,285,0)="          YES = tested functionality"
^DIC(9.4,11,22,5.03,"PAH",21,1,286,0)="           NO = did not test functionality"
^DIC(9.4,11,22,5.03,"PAH",21,1,287,0)=" "
