^DIC(9.4,47,22,5.9,"PAH",414,1,5,0)="entered bill numbers."
^DIC(9.4,47,22,5.9,"PAH",414,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",414,1,7,0)="With this patch an Integration Agreement for the Accounts Receivable "
