^DIC(9.4,111,22,1,"PAH",135,1,3,0)=" "
^DIC(9.4,111,22,1,"PAH",135,1,4,0)=" "
^DIC(9.4,111,22,1,"PAH",135,1,5,0)="2.Screen editor for GOALS and STANDARDS not displaying properly during "
