^DIC(9.4,177,22,3,"PAH",16,1,113,0)="       <TAB>;;3.0;BAR CODE MED ADMIN;**[patch list]**;Mar 2004"
^DIC(9.4,177,22,3,"PAH",16,1,114,0)=" "
