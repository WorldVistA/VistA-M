^DIC(9.4,9,22,3.3,"PAH",17,1,102,0)="Protocol FHWD8 Removed                                                    "
^DIC(9.4,9,22,3.3,"PAH",17,1,103,0)="Protocol FHWD5 Removed                                                   "
^DIC(9.4,9,22,3.3,"PAH",17,1,104,0)="Protocol FHWD22-10 Removed                                              "
^DIC(9.4,9,22,3.3,"PAH",17,1,105,0)="...Done                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,106,0)=""
^DIC(9.4,9,22,3.3,"PAH",17,1,107,0)="ONLY protocol FHWMAS will not be removed since it is used to keep track of"
^DIC(9.4,9,22,3.3,"PAH",17,1,108,0)="patient movement.                                                         "
^DIC(9.4,9,22,3.3,"PAH",17,1,109,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",17,1,110,0)="FIELDS: COMMENT (#11) in multiple 115.02 DIET"
^DIC(9.4,9,22,3.3,"PAH",17,1,111,0)="        ORDER (#2) in multiple 115.06 ADDITIONAL ORDERS"
^DIC(9.4,9,22,3.3,"PAH",17,1,112,0)="        COMMENT (#4) in multiple 115.04 TUBEFEEDING"
^DIC(9.4,9,22,3.3,"PAH",17,1,113,0)="                                                                         "
^DIC(9.4,9,22,3.3,"PAH",17,1,114,0)="The fields listed above in the Dietetics Patient file (#115) have been"
^DIC(9.4,9,22,3.3,"PAH",17,1,115,0)="expanded to free text of 80 characters.                                     "
^DIC(9.4,9,22,3.3,"PAH",17,1,116,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",17,1,117,0)="After the installation of patch 6, the Dietetics program will NO LONGER"
^DIC(9.4,9,22,3.3,"PAH",17,1,118,0)="resume to a previous order after the expiration of a current order or "
^DIC(9.4,9,22,3.3,"PAH",17,1,119,0)="future order.  Instead, the program will create a new diet entry of the "
^DIC(9.4,9,22,3.3,"PAH",17,1,120,0)="order that needs to be reinstated.  When the diet expires, the               "
^DIC(9.4,9,22,3.3,"PAH",17,1,121,0)="new diet will kick in.  Nothing is changed when the patient is return from"
^DIC(9.4,9,22,3.3,"PAH",17,1,122,0)="PASS.  The patient will still reinstate to his previous order.                "
^DIC(9.4,9,22,3.3,"PAH",17,1,123,0)="                                                                          "
^DIC(9.4,9,22,3.3,"PAH",17,1,124,0)="TEST SITES                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,125,0)="==========                                                                "
^DIC(9.4,9,22,3.3,"PAH",17,1,126,0)="Tuscaloosa                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,127,0)="West Palm Beach                                                             "
^DIC(9.4,9,22,3.3,"PAH",17,1,128,0)="Puget Sound                                                                 "
^DIC(9.4,9,22,3.3,"PAH",17,1,129,0)="Washington D.C.                                                             "
^DIC(9.4,9,22,3.3,"PAH",17,1,130,0)="San Francisco                                                               "
^DIC(9.4,9,22,3.3,"PAH",17,1,131,0)="Huntington                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,132,0)="Central Texas                                                               "
