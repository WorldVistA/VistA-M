^DIC(9.4,14,22,5.9,"PAH",186,0)="362 SEQ #284^3070904.23581^1"
^DIC(9.4,14,22,5.9,"PAH",186,1,0)="^^1^1^3070904"
^DIC(9.4,14,22,5.9,"PAH",186,1,1,0)="This patch addresses a number of minor issues in the Lab Package."
^DIC(9.4,14,22,5.9,"PAH",187,0)="317 SEQ #285^3070905.00305^1"
^DIC(9.4,14,22,5.9,"PAH",187,1,0)="^^536^536^3070905"
^DIC(9.4,14,22,5.9,"PAH",187,1,1,0)="Description:"
^DIC(9.4,14,22,5.9,"PAH",187,1,2,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",187,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,4,0)="               ************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,5,0)="*************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,6,0)="SPECIAL NOTE:  "
^DIC(9.4,14,22,5.9,"PAH",187,1,7,0)="Installation of this patch MUST be coordinated with Laboratory personnel.  "
^DIC(9.4,14,22,5.9,"PAH",187,1,8,0)="The Pre-Installation instructions within the Installation Section below, "
^DIC(9.4,14,22,5.9,"PAH",187,1,9,0)="MUST be followed and completed before installation can begin."
^DIC(9.4,14,22,5.9,"PAH",187,1,10,0)="*************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,11,0)="               ************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,13,0)="BLOOD BANK CLEARANCE"
^DIC(9.4,14,22,5.9,"PAH",187,1,14,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",187,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,16,0)="VISTA Laboratory Package patch LR*5.2*317 contains changes to "
^DIC(9.4,14,22,5.9,"PAH",187,1,17,0)="software controlled by VHA DIRECTIVE 2004-053, titled VISTA BLOOD "
^DIC(9.4,14,22,5.9,"PAH",187,1,18,0)="BANK SOFTWARE. Changes include: "
^DIC(9.4,14,22,5.9,"PAH",187,1,19,0)="File     Sub-file     Field   Field Name                      Action"
^DIC(9.4,14,22,5.9,"PAH",187,1,20,0)="----     --------     -----   ----------                      ------"
^DIC(9.4,14,22,5.9,"PAH",187,1,21,0)="63       63.207       .03     RELEASE SUPP REPORT MODIFIED    New Field"
^DIC(9.4,14,22,5.9,"PAH",187,1,22,0)="63       63.324       .03     RELEASE SUPP REPORT MODIFIED    New Field"
^DIC(9.4,14,22,5.9,"PAH",187,1,23,0)="63       63.817       .03     RELEASE SUPP REPORT MODIFIED    New Field"
^DIC(9.4,14,22,5.9,"PAH",187,1,24,0)="63       63.907       .03     RELEASE SUPP REPORT MODIFIED    New Field"
^DIC(9.4,14,22,5.9,"PAH",187,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,26,0)="All of the above changes have been reviewed by the VISTA Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",187,1,27,0)="Developer and found to have no impact on the VISTA BLOOD BANK "
^DIC(9.4,14,22,5.9,"PAH",187,1,28,0)="SOFTWARE control functions."
^DIC(9.4,14,22,5.9,"PAH",187,1,29,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,30,0)="RISK ANALYSIS: Changes made by patch LR*5.2*317 have no effect on "
^DIC(9.4,14,22,5.9,"PAH",187,1,31,0)="Blood Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",187,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,33,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*317 does "
^DIC(9.4,14,22,5.9,"PAH",187,1,34,0)="not alter or modify any software design safeguards or safety "
^DIC(9.4,14,22,5.9,"PAH",187,1,35,0)="critical elements functions."
^DIC(9.4,14,22,5.9,"PAH",187,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,37,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 0 "
^DIC(9.4,14,22,5.9,"PAH",187,1,38,0)="routines and 1 file identified in Veterans Health Administration "
^DIC(9.4,14,22,5.9,"PAH",187,1,39,0)="(VHA) Directive 2004-053, group B listing. The changes have no "
^DIC(9.4,14,22,5.9,"PAH",187,1,40,0)="effect on Blood Bank functionality or medical device control "
^DIC(9.4,14,22,5.9,"PAH",187,1,41,0)="functions. There is no adverse potential to sites."
^DIC(9.4,14,22,5.9,"PAH",187,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,43,0)="VALIDATION REQUIREMENTS BY OPTION: "
^DIC(9.4,14,22,5.9,"PAH",187,1,44,0)="There are no validation requirements associated with this patch."
^DIC(9.4,14,22,5.9,"PAH",187,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,46,0)="MINIMAL TEST CASE SCENARIOS BY OPTION, INCLUSIVE OF ALL CONTROL FUNCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",187,1,47,0)="There are no test case scenarios associated with this patch."
^DIC(9.4,14,22,5.9,"PAH",187,1,48,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,49,0)="================="
^DIC(9.4,14,22,5.9,"PAH",187,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,51,0)="VistA Laboratory Anatomic Pathology (AP) Modifications/Enhancements patch "
^DIC(9.4,14,22,5.9,"PAH",187,1,52,0)="LR*5.2*317 addresses two patient safety issues (PSI) reported in PSI-04-025 "
^DIC(9.4,14,22,5.9,"PAH",187,1,53,0)="that arose from the release and implementation of the VistA Laboratory "
^DIC(9.4,14,22,5.9,"PAH",187,1,54,0)="Anatomic Pathology Electronic Signature Patch LR*5.2*259."
^DIC(9.4,14,22,5.9,"PAH",187,1,55,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,56,0)="The patient safety issues are described as follows:"
^DIC(9.4,14,22,5.9,"PAH",187,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,58,0)="1. Users that should not be allowed to modify an Anatomic Pathology SF515 or "
^DIC(9.4,14,22,5.9,"PAH",187,1,59,0)="Autopsy Protocol released report are given access to the Modify released report "
^DIC(9.4,14,22,5.9,"PAH",187,1,60,0)="[LRAPMRL] option in order to allow the user to add supplementary reports."
^DIC(9.4,14,22,5.9,"PAH",187,1,61,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,62,0)="2. The original Anatomic Pathology SF515 or Autopsy Protocol report is not "
^DIC(9.4,14,22,5.9,"PAH",187,1,63,0)="viewable in the Computer Patient Records System (CPRS) during the time a "
^DIC(9.4,14,22,5.9,"PAH",187,1,64,0)="supplementary report is underway. Personnel are unable to view the report "
^DIC(9.4,14,22,5.9,"PAH",187,1,65,0)="during this time."
^DIC(9.4,14,22,5.9,"PAH",187,1,66,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,67,0)="The VistA Laboratory Anatomic Pathology Electronic Signature Patch "
^DIC(9.4,14,22,5.9,"PAH",187,1,68,0)="LR*5.2*259 changed the location and the method by which supplementary "
^DIC(9.4,14,22,5.9,"PAH",187,1,69,0)="reports are added. The Modify released report [LRAPMRL] option is used to add "
^DIC(9.4,14,22,5.9,"PAH",187,1,70,0)="supplementary reports to the original report. Laboratory personnel allowed to "
^DIC(9.4,14,22,5.9,"PAH",187,1,71,0)="add supplementary reports to Anatomic Pathology released reports must have "
^DIC(9.4,14,22,5.9,"PAH",187,1,72,0)="access to the Modify released report [LRAPMRL] option. This access opened up "
^DIC(9.4,14,22,5.9,"PAH",187,1,73,0)="the potential for errors in which the report could be accidentally modified "
^DIC(9.4,14,22,5.9,"PAH",187,1,74,0)="when a supplementary report was added."
^DIC(9.4,14,22,5.9,"PAH",187,1,75,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,76,0)="Patch LR*5.2*317 resolves this problem by removing the supplementary report "
^DIC(9.4,14,22,5.9,"PAH",187,1,77,0)="addition functionality from the Modify released reports [LRAPMRL] option and "
^DIC(9.4,14,22,5.9,"PAH",187,1,78,0)="placing the functionality back to the Supplementary Report, Anat Path "
^DIC(9.4,14,22,5.9,"PAH",187,1,79,0)="[LRAPDSR] option for Cytology, Electron Microscopy, and Surgical Pathology "
^DIC(9.4,14,22,5.9,"PAH",187,1,80,0)="released reports and the Autopsy supplementary report [LRAPAUSR] option for "
^DIC(9.4,14,22,5.9,"PAH",187,1,81,0)="Autopsy released reports."
^DIC(9.4,14,22,5.9,"PAH",187,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,83,0)="Another concern had to do with the addition of a supplementary report to a "
^DIC(9.4,14,22,5.9,"PAH",187,1,84,0)="released Anatomic Pathology report, which unreleased the original report and "
^DIC(9.4,14,22,5.9,"PAH",187,1,85,0)="made it unavailable for viewing in Computerized Patient Record System (CPRS)."
^DIC(9.4,14,22,5.9,"PAH",187,1,86,0)="The time span in which the original report remained unavailable for viewing by "
^DIC(9.4,14,22,5.9,"PAH",187,1,87,0)="the Providers could be crucial. It was considered a major patient safety issue "
^DIC(9.4,14,22,5.9,"PAH",187,1,88,0)="if a doctor, who was with a patient, was not able to view the report at that "
^DIC(9.4,14,22,5.9,"PAH",187,1,89,0)="time."
^DIC(9.4,14,22,5.9,"PAH",187,1,90,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,91,0)="Patch LR*5.2*317 resolves this problem by leaving the original report in "
^DIC(9.4,14,22,5.9,"PAH",187,1,92,0)="released status during the time a supplementary report is being added. The "
^DIC(9.4,14,22,5.9,"PAH",187,1,93,0)="original report remains available for viewing in CPRS during this time."
^DIC(9.4,14,22,5.9,"PAH",187,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,95,0)="Enhancements to LAB DATA file (#63):"
^DIC(9.4,14,22,5.9,"PAH",187,1,96,0)="-------------"
^DIC(9.4,14,22,5.9,"PAH",187,1,97,0)="A new field, RELEASE SUPP REPORT MODIFIED (#.03), has been added to the "
^DIC(9.4,14,22,5.9,"PAH",187,1,98,0)="SUPPLEMENTARY REPORT SUB-FILE for the anatomic pathology sections "
^DIC(9.4,14,22,5.9,"PAH",187,1,99,0)="Cytopathology, Electron Microscopy, and Surgical Pathology; and to "
^DIC(9.4,14,22,5.9,"PAH",187,1,100,0)="the AUTOPSY SUPPLEMENTARY REPORT for Autopsy.  The field is a flag, when "
^DIC(9.4,14,22,5.9,"PAH",187,1,101,0)="set to '1', indicates a released supplementary report is being modified, "
^DIC(9.4,14,22,5.9,"PAH",187,1,102,0)="and has not yet been released."
^DIC(9.4,14,22,5.9,"PAH",187,1,103,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,104,0)="63.207,.03    RELEASE SUPP REPORT MODIFIED 0;3 SET"
^DIC(9.4,14,22,5.9,"PAH",187,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,106,0)="                                 '1' FOR YES; "
^DIC(9.4,14,22,5.9,"PAH",187,1,107,0)="                                 '0' FOR NO; "
^DIC(9.4,14,22,5.9,"PAH",187,1,108,0)="              LAST EDITED:      SEP 08, 2004 "
^DIC(9.4,14,22,5.9,"PAH",187,1,109,0)="              DESCRIPTION:      This flag will be set to '1' when a"
^DIC(9.4,14,22,5.9,"PAH",187,1,110,0)="                  released supplementary report is modified. It is"
^DIC(9.4,14,22,5.9,"PAH",187,1,111,0)="                  removed when the modified supplementary report is"
^DIC(9.4,14,22,5.9,"PAH",187,1,112,0)="                  released.  "
^DIC(9.4,14,22,5.9,"PAH",187,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,114,0)="63.817,.03    RELEASE SUPP REPORT MODIFIED 0;3 SET"
^DIC(9.4,14,22,5.9,"PAH",187,1,115,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,116,0)="                                 '1' FOR YES; "
^DIC(9.4,14,22,5.9,"PAH",187,1,117,0)="                                 '0' FOR NO; "
^DIC(9.4,14,22,5.9,"PAH",187,1,118,0)="               LAST EDITED:      SEP 08, 2004 "
^DIC(9.4,14,22,5.9,"PAH",187,1,119,0)="               DESCRIPTION:      This flag will be set to '1' when a "
^DIC(9.4,14,22,5.9,"PAH",187,1,120,0)="                released supplementary report is modified. It is "
^DIC(9.4,14,22,5.9,"PAH",187,1,121,0)="                removed when the modified supplementary report is"
^DIC(9.4,14,22,5.9,"PAH",187,1,122,0)="                released.  "
^DIC(9.4,14,22,5.9,"PAH",187,1,123,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,124,0)="63.907,.03    RELEASE SUPP REPORT MODIFIED 0;3 SET"
^DIC(9.4,14,22,5.9,"PAH",187,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,126,0)="                                 '1' FOR YES; "
^DIC(9.4,14,22,5.9,"PAH",187,1,127,0)="                                 '0' FOR NO; "
^DIC(9.4,14,22,5.9,"PAH",187,1,128,0)="               LAST EDITED:      SEP 08, 2004 "
^DIC(9.4,14,22,5.9,"PAH",187,1,129,0)="               DESCRIPTION:      This flag will be set to '1' when a "
^DIC(9.4,14,22,5.9,"PAH",187,1,130,0)="                 released supplementary report is modified.  It is"
^DIC(9.4,14,22,5.9,"PAH",187,1,131,0)="                 removed when the modified supplementary report is"
^DIC(9.4,14,22,5.9,"PAH",187,1,132,0)="                 released.  "
^DIC(9.4,14,22,5.9,"PAH",187,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,134,0)="63.324,.03    RELEASE SUPP REPORT MODIFIED 0;3 SET"
^DIC(9.4,14,22,5.9,"PAH",187,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,136,0)="                                 '1' FOR YES; "
^DIC(9.4,14,22,5.9,"PAH",187,1,137,0)="                                 '0' FOR NO; "
^DIC(9.4,14,22,5.9,"PAH",187,1,138,0)="               LAST EDITED:      SEP 08, 2004 "
^DIC(9.4,14,22,5.9,"PAH",187,1,139,0)="               DESCRIPTION:      This flag will be set to '1' when a "
^DIC(9.4,14,22,5.9,"PAH",187,1,140,0)="                released supplementary report is modified. It is        "
^DIC(9.4,14,22,5.9,"PAH",187,1,141,0)="                removed when the modified supplementary report is"
^DIC(9.4,14,22,5.9,"PAH",187,1,142,0)="                released. "
^DIC(9.4,14,22,5.9,"PAH",187,1,143,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,144,0)="Modifications:"
^DIC(9.4,14,22,5.9,"PAH",187,1,145,0)="--------------"
^DIC(9.4,14,22,5.9,"PAH",187,1,146,0)="The following options have been modified. Please refer to the User "
^DIC(9.4,14,22,5.9,"PAH",187,1,147,0)="Guide distributed with this patch for detailed information and examples."
^DIC(9.4,14,22,5.9,"PAH",187,1,148,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,149,0)="Supplementary Report, Anat Path [LRAPDSR] option"
^DIC(9.4,14,22,5.9,"PAH",187,1,150,0)="Supplementary report release, anat path [LRAPRS] option"
^DIC(9.4,14,22,5.9,"PAH",187,1,151,0)="Autopsy supplementary report [LRAPAUSR] option"
^DIC(9.4,14,22,5.9,"PAH",187,1,152,0)="Modify released pathology report [LRAPMRL] option "
^DIC(9.4,14,22,5.9,"PAH",187,1,153,0)="Print all reports on queue [LRAP PRINT ALL ON QUEUE] option"
^DIC(9.4,14,22,5.9,"PAH",187,1,154,0)="Print single report only [LRAP PRINT SINGLE] option"
^DIC(9.4,14,22,5.9,"PAH",187,1,155,0)="Print final path reports by accession # [LRAPFICH] option"
^DIC(9.4,14,22,5.9,"PAH",187,1,156,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,157,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,158,0)="This patch addresses the following E3R's:"
^DIC(9.4,14,22,5.9,"PAH",187,1,159,0)="========================================"
^DIC(9.4,14,22,5.9,"PAH",187,1,160,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",187,1,161,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,162,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,163,0)="This patch addresses the following NOIS / Remedy Ticket:"
^DIC(9.4,14,22,5.9,"PAH",187,1,164,0)="======================================================="
^DIC(9.4,14,22,5.9,"PAH",187,1,165,0)="BRX-0704-11083 / HD0000000070862"
