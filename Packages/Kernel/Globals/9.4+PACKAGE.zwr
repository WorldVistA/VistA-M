^DIC(9.4,3,22,21,"PAH",522,1,86,0)="Blood Bank Clearance"
^DIC(9.4,3,22,21,"PAH",522,1,87,0)="===================="
^DIC(9.4,3,22,21,"PAH",522,1,88,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch XU*8.0*661 contains"
^DIC(9.4,3,22,21,"PAH",522,1,89,0)="changes to a package referenced in ProPath standard titled: BBM Team Review"
^DIC(9.4,3,22,21,"PAH",522,1,90,0)="of VistA Patches. This patch does not alter or modify any VistA Blood Bank"
^DIC(9.4,3,22,21,"PAH",522,1,91,0)="software design safeguards or safety critical elements functions."
^DIC(9.4,3,22,21,"PAH",522,1,92,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,93,0)="RISK ANALYSIS: Changes made by patch XU*8.0*661 have no effect on Blood Bank"
^DIC(9.4,3,22,21,"PAH",522,1,94,0)="software functionality, therefore RISK is none."
^DIC(9.4,3,22,21,"PAH",522,1,95,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,96,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,97,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,3,22,21,"PAH",522,1,98,0)="============================================"
^DIC(9.4,3,22,21,"PAH",522,1,99,0)="Ticket: I9055002FY16 - XINDEX doesn't support SACC changes to routine"
^DIC(9.4,3,22,21,"PAH",522,1,100,0)="        names and tags"
^DIC(9.4,3,22,21,"PAH",522,1,101,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,102,0)="Problem:"
^DIC(9.4,3,22,21,"PAH",522,1,103,0)=" XINDEX utility needs to support routine name and labels to 16 characters"
^DIC(9.4,3,22,21,"PAH",522,1,104,0)=" and local variables names to 16 characters"
^DIC(9.4,3,22,21,"PAH",522,1,105,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,106,0)="Resolution:"
^DIC(9.4,3,22,21,"PAH",522,1,107,0)=" Change %ZOSF(""TEST"") to check for 16 characters instead of 8 in routine"
^DIC(9.4,3,22,21,"PAH",522,1,108,0)=" ZOSFONT"
^DIC(9.4,3,22,21,"PAH",522,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,110,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,111,0)="Test Sites: "
^DIC(9.4,3,22,21,"PAH",522,1,112,0)="==========="
^DIC(9.4,3,22,21,"PAH",522,1,113,0)="Fargo, ND"
^DIC(9.4,3,22,21,"PAH",522,1,114,0)="South Texas, TX"
^DIC(9.4,3,22,21,"PAH",522,1,115,0)=" "
