^DIC(9.4,101,22,6,"PAH",68,1,0)="^^1^1^3040131"
^DIC(9.4,101,22,6,"PAH",68,1,1,0)="See the patch description on FORUM for a complete description of this patch."
^DIC(9.4,101,22,6,"PAH",69,0)="92 SEQ #84^3040427^1"
^DIC(9.4,101,22,6,"PAH",69,1,0)="^^1^1^3040427"
^DIC(9.4,101,22,6,"PAH",69,1,1,0)="See the patch description on Forum for complete details on this patch."
^DIC(9.4,101,22,6,"PAH",70,0)="89 SEQ #85^3040507^1"
^DIC(9.4,101,22,6,"PAH",70,1,0)="^^1^1^3040507"
^DIC(9.4,101,22,6,"PAH",70,1,1,0)="See the patch description on Forum for complete details on this patch."
^DIC(9.4,101,22,6,"PAH",71,0)="94 SEQ #86^3040702^1"
^DIC(9.4,101,22,6,"PAH",71,1,0)="^^3^3^3040702"
^DIC(9.4,101,22,6,"PAH",71,1,1,0)="This patch will set the extra memorial day holiday for the passing of former"
^DIC(9.4,101,22,6,"PAH",71,1,2,0)="President Ronald Reagan.  See Forum for additional information."
