^DIC(9.4,170,20,"B",2,1)=""
^DIC(9.4,170,22,0)="^9.49I^2^2"
^DIC(9.4,170,22,1,0)="0.5^2980930^2981016^1"
^DIC(9.4,170,22,1,1,0)="^^4^4^2981016"
^DIC(9.4,170,22,1,1,1,0)="The Clinical Information Resource Network (CIRN) Pre-implementation"
^DIC(9.4,170,22,1,1,2,0)="software Version 0.5 software calculates the CIRN Master of Record (CMOR)"
^DIC(9.4,170,22,1,1,3,0)="scores and also provides utilities for the cleanup of potential problem"
^DIC(9.4,170,22,1,1,4,0)="SSNs and Eligibility Codes."
^DIC(9.4,170,22,1,"PAH",0)="^9.4901^3^3"
^DIC(9.4,170,22,1,"PAH",1,0)="1^2981119^1"
^DIC(9.4,170,22,1,"PAH",1,1,0)="^^14^14^2981119"
^DIC(9.4,170,22,1,"PAH",1,1,1,0)="This patch corrects the undefined errors in the Duplicate Record"
^DIC(9.4,170,22,1,"PAH",1,1,2,0)="Statistics [RGCIRN CMOR DUP STATS] and the null subscript error in the"
^DIC(9.4,170,22,1,"PAH",1,1,3,0)="Pseudo-SSN Report [RGPR PRE-IMP SSN REPORT] option. This patch also"
^DIC(9.4,170,22,1,"PAH",1,1,4,0)="incorporates changes to the Start/Restart CMOR Score Calculation [RGCIRN"
^DIC(9.4,170,22,1,"PAH",1,1,5,0)="CMOR START] and CMOR Score Calculation Status [RGCIRN CMOR STATUS] options"
^DIC(9.4,170,22,1,"PAH",1,1,6,0)="as well as changes to reduce the time of calculation.  The CMOR INIT"
^DIC(9.4,170,22,1,"PAH",1,1,7,0)="STATUS field (#24) in the CIRN SITE PARAMETER file (# 991.8) was also"
^DIC(9.4,170,22,1,"PAH",1,1,8,0)="updated to reflect the changes in the CMOR Score Calculation Status"
^DIC(9.4,170,22,1,"PAH",1,1,9,0)="[RGCIRN CMOR STATUS] option."
^DIC(9.4,170,22,1,"PAH",1,1,10,0)=" "
^DIC(9.4,170,22,1,"PAH",1,1,11,0)="Associated NOISs"
^DIC(9.4,170,22,1,"PAH",1,1,12,0)=" ================"
^DIC(9.4,170,22,1,"PAH",1,1,13,0)=" MAR-1098-21715"
^DIC(9.4,170,22,1,"PAH",1,1,14,0)=" BRX-1198-10261"
^DIC(9.4,170,22,1,"PAH",2,0)="2^2981214^1"
