^DIC(9.4,172,0)="RUN TIME LIBRARY^RGUT^RUN TIME LIBRARY"
^DIC(9.4,172,20,0)="^9.402P^^"
^DIC(9.4,172,22,0)="^9.49I^1^1"
^DIC(9.4,172,22,1,0)="2.1^3051119^2990603^1"
^DIC(9.4,172,22,1,1,0)="^^28^28^3051119"
^DIC(9.4,172,22,1,1,1,0)="The pre-init routine will change the name in the package file from"
^DIC(9.4,172,22,1,1,2,0)="CIRN RUN TIME LIBRARY to RUN TIME LIBRARY if it already exists in "
^DIC(9.4,172,22,1,1,3,0)="the file."
^DIC(9.4,172,22,1,1,4,0)=" "
^DIC(9.4,172,22,1,1,5,0)="This is the set of routines common to all modules occupying the RG namespace.  "
^DIC(9.4,172,22,1,1,6,0)="They perform generic functions.  "
^DIC(9.4,172,22,1,1,7,0)=" "
^DIC(9.4,172,22,1,1,8,0)="In this release of the runtime library, several routines have been "
^DIC(9.4,172,22,1,1,9,0)="renamed under the RGUT subnamespace.  The original routines are marked "
^DIC(9.4,172,22,1,1,10,0)="as obsolete and will be eliminated in a future release (no sooner "
^DIC(9.4,172,22,1,1,11,0)="than one year after the release date for this version).  The routines "
^DIC(9.4,172,22,1,1,12,0)="are:"
^DIC(9.4,172,22,1,1,13,0)=" "
^DIC(9.4,172,22,1,1,14,0)="RGCVTDT        Call $$^RGCVTDT replaced by $$ENTRY^RGUTDT; same arguments"
^DIC(9.4,172,22,1,1,15,0)="RGCVTUU        Replaced by RGUTUU; same entry points"
^DIC(9.4,172,22,1,1,16,0)="RGINIT*        Replaced by RGUTIN*"
^DIC(9.4,172,22,1,1,17,0)="RGMSCALR       Replaced by RGUTALR; same entry points"
^DIC(9.4,172,22,1,1,18,0)="RGMSCDAT       Replaced by RGUTDAT; same entry points"
^DIC(9.4,172,22,1,1,19,0)="RGMSCDIC       Call $$^RGMSCDIC replaced by ENTRY^RGUTDIC; same arguments"
^DIC(9.4,172,22,1,1,20,0)="RGMSCEDT       Replaced by RGUTEDT; same entry points"
^DIC(9.4,172,22,1,1,21,0)="RGMSCIMP       Replaced by RGUTIMP; same entry points"
^DIC(9.4,172,22,1,1,22,0)="RGMSCLK*       Replaced by RGUTLK*; same entry points"
^DIC(9.4,172,22,1,1,23,0)="RGMSCMTL       Replaced by RGUTMTL; same entry points"
^DIC(9.4,172,22,1,1,24,0)="RGMSCTSK       Replaced by RGUTTSK; same entry points"
^DIC(9.4,172,22,1,1,25,0)="RGMSCUSR       Replaced by RGUTUSR; same entry points"
^DIC(9.4,172,22,1,1,26,0)="RGXY           $$^RGXY replaced by $$XY^RGUT; same arguments"
^DIC(9.4,172,22,1,1,27,0)="RGZOSF*        Replaced by RGUTOS*; same entry points except for "
^DIC(9.4,172,22,1,1,28,0)="               elimination of math functions."
^DIC(9.4,172,22,"B",2.1,1)=""
^DIC(9.4,172,"VERSION")=2.1
^DIC(9.4,174,0)="FILEMAN DELPHI COMPONENTS^FMDC"
^DIC(9.4,174,22,0)="^9.49I^1^1"
^DIC(9.4,174,22,1,0)="1.0"
^DIC(9.4,174,22,1,"PAH",0)="^9.4901^2^2"
^DIC(9.4,174,22,1,"PAH",1,0)="1 SEQ #1^2990914^1"
^DIC(9.4,174,22,1,"PAH",1,1,0)="^^75^75^2990914"
^DIC(9.4,174,22,1,"PAH",1,1,1,0)="This patch provides updates for the FileMan Delphi Components (FMDC). FMDC"
^DIC(9.4,174,22,1,"PAH",1,1,2,0)="is used by developers to access VA FileMan data from client RPC"
^DIC(9.4,174,22,1,"PAH",1,1,3,0)="Broker-based applications."
^DIC(9.4,174,22,1,"PAH",1,1,4,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,5,0)="This patch provides the following enhancements and fixes:"
^DIC(9.4,174,22,1,"PAH",1,1,6,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,7,0)="- Delphi 4 support is now provided (in addition to Delphi 3)"
^DIC(9.4,174,22,1,"PAH",1,1,8,0)="- Source code is now provided for the FMDC components"
^DIC(9.4,174,22,1,"PAH",1,1,9,0)="- You can now derive custom components based on the FMDC components."
^DIC(9.4,174,22,1,"PAH",1,1,10,0)="  Changes include making most procedures and functions protected instead"
^DIC(9.4,174,22,1,"PAH",1,1,11,0)="  of private, and referring to components by type rather than name."
^DIC(9.4,174,22,1,"PAH",1,1,12,0)="- NOIS issue LOM-0799-60075 is corrected (server side error due to a"
^DIC(9.4,174,22,1,"PAH",1,1,13,0)="  string length problem)."
^DIC(9.4,174,22,1,"PAH",1,1,14,0)="- FMCheckBox components' display of retrieved null values as grayed-out"
^DIC(9.4,174,22,1,"PAH",1,1,15,0)="  checked values is corrected. It now displays them as unchecked. An"
^DIC(9.4,174,22,1,"PAH",1,1,16,0)="  invalid non-null text value will still appear as the grayed-out checked"
^DIC(9.4,174,22,1,"PAH",1,1,17,0)="  value."
^DIC(9.4,174,22,1,"PAH",1,1,18,0)="  "
^DIC(9.4,174,22,1,"PAH",1,1,19,0)="THIS SOFTWARE DISTRIBUTION INCLUDES THE SOURCE CODE FOR THE COMPONENTS."
^DIC(9.4,174,22,1,"PAH",1,1,20,0)="WHILE THE SOURCE CODE HAS BEEN PROVIDED, IT SHOULD NOT BE ALTERED"
^DIC(9.4,174,22,1,"PAH",1,1,21,0)="DIRECTLY.  IF AN ADDITIONAL FUNCTIONALITY IS NEEDED, DERIVE A COMPONENT"
^DIC(9.4,174,22,1,"PAH",1,1,22,0)="BASED ON AN EXISTING COMPONENT INSTEAD, TO PROVIDE THAT FUNCTIONALITY. IF"
^DIC(9.4,174,22,1,"PAH",1,1,23,0)="YOU THINK IT WOULD BE USEFUL TO A WIDE AUDIENCE, THEN SEND A SAMPLE TO"
^DIC(9.4,174,22,1,"PAH",1,1,24,0)="TSOPENVISTA@DOMAIN.EXT."
^DIC(9.4,174,22,1,"PAH",1,1,25,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,26,0)="While this patch provides only provides code changes for developer's"
^DIC(9.4,174,22,1,"PAH",1,1,27,0)="client workstations, a build also is included for the server side so that"
^DIC(9.4,174,22,1,"PAH",1,1,28,0)="the patch number will appear in the package file. This build should be"
^DIC(9.4,174,22,1,"PAH",1,1,29,0)="installed on the server simply to insure that the patch is noted as"
^DIC(9.4,174,22,1,"PAH",1,1,30,0)="installed."
^DIC(9.4,174,22,1,"PAH",1,1,31,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,32,0)="The software distribution includes:"
^DIC(9.4,174,22,1,"PAH",1,1,33,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,34,0)="FILE NAMES      DESCRIPTION                     Blocks          Bytes"
^DIC(9.4,174,22,1,"PAH",1,1,35,0)="FMDC1_0P1.EXE   FMDC Self-Installing Executable   1894         969709"
^DIC(9.4,174,22,1,"PAH",1,1,36,0)="FMDC1_0P1IG.PDF Installation Guide                 146          74560"
^DIC(9.4,174,22,1,"PAH",1,1,37,0)="FMDC1_0P1TM.PDF Technical Manual                    71          36305"
^DIC(9.4,174,22,1,"PAH",1,1,38,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,39,0)="Note:  Use Binary mode for .PDF, and .EXE files"
^DIC(9.4,174,22,1,"PAH",1,1,40,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,41,0)="Use FTP to retrieve the software from one of the following CIO Field"
^DIC(9.4,174,22,1,"PAH",1,1,42,0)="Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,174,22,1,"PAH",1,1,43,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,44,0)="       CIO FIELD OFFICE                FTP Address                "
^DIC(9.4,174,22,1,"PAH",1,1,45,0)="       Hines                           152.129.1.110   isc-chicago.domain.ext"
^DIC(9.4,174,22,1,"PAH",1,1,46,0)="       Albany                          152.127.1.5     isc-albany.domain.ext"
^DIC(9.4,174,22,1,"PAH",1,1,47,0)="       Salt Lake City                  152.131.2.1     isc-slc.domain.ext"
^DIC(9.4,174,22,1,"PAH",1,1,48,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,49,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,50,0)="INSTALLATION:"
^DIC(9.4,174,22,1,"PAH",1,1,51,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,52,0)="Server Side:"
^DIC(9.4,174,22,1,"PAH",1,1,53,0)="============"
^DIC(9.4,174,22,1,"PAH",1,1,54,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,55,0)="1. Installing this patch has no impact on users on the system. It can be"
^DIC(9.4,174,22,1,"PAH",1,1,56,0)="   installed at any time."
^DIC(9.4,174,22,1,"PAH",1,1,57,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,58,0)="2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. Use this"
^DIC(9.4,174,22,1,"PAH",1,1,59,0)="   option to load the FMDC KIDS (Kernel Installation and Distribution"
^DIC(9.4,174,22,1,"PAH",1,1,60,0)="   System) build for this patch into a transport global on your system."
^DIC(9.4,174,22,1,"PAH",1,1,61,0)="    "
^DIC(9.4,174,22,1,"PAH",1,1,62,0)="3. Once the FMDC KIDS build for this patch has been loaded into a"
^DIC(9.4,174,22,1,"PAH",1,1,63,0)="   transport global on your system, on the KIDS menu use the following"
^DIC(9.4,174,22,1,"PAH",1,1,64,0)="   option to install the patch:"
^DIC(9.4,174,22,1,"PAH",1,1,65,0)="           Install Package(s)   'FMDC*1.0*1'"
^DIC(9.4,174,22,1,"PAH",1,1,66,0)="                                 =========="
^DIC(9.4,174,22,1,"PAH",1,1,67,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,68,0)="Client Side (Developers only):"
^DIC(9.4,174,22,1,"PAH",1,1,69,0)="============================="
^DIC(9.4,174,22,1,"PAH",1,1,70,0)=" "
^DIC(9.4,174,22,1,"PAH",1,1,71,0)="The client side distribution should only be installed on workstations of"
^DIC(9.4,174,22,1,"PAH",1,1,72,0)="developer who wish to use FMDC. To install, please follow the installation"
^DIC(9.4,174,22,1,"PAH",1,1,73,0)="instructions in the most recent FileMan Delphi Components (FMDC)"
^DIC(9.4,174,22,1,"PAH",1,1,74,0)="Installation Guide (an updated Installation Guide is provided as part of"
^DIC(9.4,174,22,1,"PAH",1,1,75,0)="this patch)."
^DIC(9.4,174,22,1,"PAH",2,0)="2 SEQ #2^3000125^1"
^DIC(9.4,174,22,1,"PAH",2,1,0)="^^32^32^3000125"
^DIC(9.4,174,22,1,"PAH",2,1,1,0)="This patch provides a FMDC1_0RM.TXT (7,024 bytes) file for the FileMan"
^DIC(9.4,174,22,1,"PAH",2,1,2,0)="Delphi Components (FMDC). The readme file provides important information"
^DIC(9.4,174,22,1,"PAH",2,1,3,0)="on how to recompile FMDC whenever a new RPC Broker Development Kit (BDK)"
^DIC(9.4,174,22,1,"PAH",2,1,4,0)="is installed."
^DIC(9.4,174,22,1,"PAH",2,1,5,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,6,0)="Use FTP (ascii mode) to retrieve the file from one of the following"
^DIC(9.4,174,22,1,"PAH",2,1,7,0)="CIO Field Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,174,22,1,"PAH",2,1,8,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,9,0)="       CIO FIELD OFFICE                FTP Address                "
^DIC(9.4,174,22,1,"PAH",2,1,10,0)="       Hines                           152.129.1.110   isc-chicago.domain.ext"
^DIC(9.4,174,22,1,"PAH",2,1,11,0)="       Albany                          152.127.1.5     isc-albany.domain.ext"
^DIC(9.4,174,22,1,"PAH",2,1,12,0)="       Salt Lake City                  152.131.2.1     isc-slc.domain.ext"
^DIC(9.4,174,22,1,"PAH",2,1,13,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,14,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,15,0)="INSTALLATION:"
^DIC(9.4,174,22,1,"PAH",2,1,16,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,17,0)="Server Side:"
^DIC(9.4,174,22,1,"PAH",2,1,18,0)="============"
^DIC(9.4,174,22,1,"PAH",2,1,19,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,20,0)="1. Installing this patch has no impact on users on the system. It can be"
^DIC(9.4,174,22,1,"PAH",2,1,21,0)="   installed at any time.  The packman simply updates the Version multiple"
^DIC(9.4,174,22,1,"PAH",2,1,22,0)="   in the Package file."
^DIC(9.4,174,22,1,"PAH",2,1,23,0)=" "
^DIC(9.4,174,22,1,"PAH",2,1,24,0)="2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. Use this"
^DIC(9.4,174,22,1,"PAH",2,1,25,0)="   option to load the FMDC KIDS (Kernel Installation and Distribution"
^DIC(9.4,174,22,1,"PAH",2,1,26,0)="   System) build for this patch into a transport global on your system."
^DIC(9.4,174,22,1,"PAH",2,1,27,0)="    "
^DIC(9.4,174,22,1,"PAH",2,1,28,0)="3. Once the FMDC KIDS build for this patch has been loaded into a"
^DIC(9.4,174,22,1,"PAH",2,1,29,0)="   transport global on your system, on the KIDS menu use the following"
^DIC(9.4,174,22,1,"PAH",2,1,30,0)="   option to install the patch:"
^DIC(9.4,174,22,1,"PAH",2,1,31,0)="           Install Package(s)   'FMDC*1.0*2'"
^DIC(9.4,174,22,1,"PAH",2,1,32,0)="                                 =========="
^DIC(9.4,174,22,1,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,174,22,1,"PAH","B","2 SEQ #2",2)=""
^DIC(9.4,174,22,"B","1.0",1)=""
^DIC(9.4,174,"VERSION")="1.0"
^DIC(9.4,175,0)="IMAGING^MAG"
^DIC(9.4,175,14,0)="^9.4014^1^1"
^DIC(9.4,175,14,1,0)="ZMAG"
^DIC(9.4,175,14,"B","ZMAG",1)=""
^DIC(9.4,175,22,0)="^9.49I^2^2"
^DIC(9.4,175,22,1,0)="2.5^3010629^3010716^1"
^DIC(9.4,175,22,1,1,0)="^^5^5^3010716"
^DIC(9.4,175,22,1,1,1,0)="VISTA Imaging V 2.5. This build includes all files required"
^DIC(9.4,175,22,1,1,2,0)="for a complete installation."
^DIC(9.4,175,22,1,1,3,0)=" "
^DIC(9.4,175,22,1,1,4,0)="Information on VistA Imaging is available on web page"
^DIC(9.4,175,22,1,1,5,0)="http://vawww.domain.ext/imaging/"
^DIC(9.4,175,22,1,"PAH",0)="^9.4901^5^5"
^DIC(9.4,175,22,1,"PAH",1,0)="1^3010815^1"
^DIC(9.4,175,22,1,"PAH",1,1,0)="^^36^36^3010815"
^DIC(9.4,175,22,1,"PAH",1,1,1,0)="VistA Imaging v 2.5 routines modified to correct bug fixes identified by"
^DIC(9.4,175,22,1,"PAH",1,1,2,0)="NOIS reports and during final release process.. "
^DIC(9.4,175,22,1,"PAH",1,1,3,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,4,0)="Routines:"
^DIC(9.4,175,22,1,"PAH",1,1,5,0)="MAGDLB1, MAGDLB9, MAGDLBSR, and MAGDRA1 are required to fix undef problems"
^DIC(9.4,175,22,1,"PAH",1,1,6,0)="after install Radiology patch 26. "
^DIC(9.4,175,22,1,"PAH",1,1,7,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,8,0)="Routines:"
^DIC(9.4,175,22,1,"PAH",1,1,9,0)="MAGQBUT and MAGUSIT - routines for synchronizing the namespace with"
^DIC(9.4,175,22,1,"PAH",1,1,10,0)="Imaging namespace database."
^DIC(9.4,175,22,1,"PAH",1,1,11,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,12,0)="Routines:"
^DIC(9.4,175,22,1,"PAH",1,1,13,0)="MAGQBPG2, MAGQBPRG, MAGQBUT1, MAGQBUT2"
^DIC(9.4,175,22,1,"PAH",1,1,14,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,15,0)="Data Dicitonary change to file 2006.1 on field #21, PURGE-RETEN DAYS PACS"
^DIC(9.4,175,22,1,"PAH",1,1,16,0)="BIG FILE - input transforms code changed and is required by the background"
^DIC(9.4,175,22,1,"PAH",1,1,17,0)="processor."
^DIC(9.4,175,22,1,"PAH",1,1,18,0)="Input transform was: "
^DIC(9.4,175,22,1,"PAH",1,1,19,0)="^DD(2006.1,21,0)=PURGE-RETEN DAYS PACS BIG"
^DIC(9.4,175,22,1,"PAH",1,1,20,0)="FILE^NJ5,0^^3;1^K:+X'=X!(X>99999)!(X<1)!(X?.E1"".""1N.N) X"
^DIC(9.4,175,22,1,"PAH",1,1,21,0)="Input transform is now:"
^DIC(9.4,175,22,1,"PAH",1,1,22,0)="^DD(2006.1,21,0)=PURGE-RETEN DAYS PACS BIG"
^DIC(9.4,175,22,1,"PAH",1,1,23,0)="FILE^NJ5,0^^3;1^K:+X'=X!(X>99999)!(X<0)!(X?.E1"".""1N.N) X"
^DIC(9.4,175,22,1,"PAH",1,1,24,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,25,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,26,0)=" "
^DIC(9.4,175,22,1,"PAH",1,1,27,0)="Routine check sum values:"
^DIC(9.4,175,22,1,"PAH",1,1,28,0)="MAGDLB1   value = 12440903"
^DIC(9.4,175,22,1,"PAH",1,1,29,0)="MAGDLB9   value = 4213608"
^DIC(9.4,175,22,1,"PAH",1,1,30,0)="MAGDLBSR  value = 5424331"
^DIC(9.4,175,22,1,"PAH",1,1,31,0)="MAGDRA1   value = 6988221"
^DIC(9.4,175,22,1,"PAH",1,1,32,0)="MAGQBPG2  value = 7018812"
