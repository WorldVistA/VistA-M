^DIC(9.4,48,22,5.28,"PAH",683,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",683,1,4,0)="VSE-8649: TB - VistA: Fix an issue so that GUI and ISS work the same with "
^DIC(9.4,48,22,5.28,"PAH",683,1,5,0)="          special needs and preferences"
^DIC(9.4,48,22,5.28,"PAH",683,1,6,0)="VSE-8650: FF - VS GUI: User facing change in VS GUI so that SNAP works "
^DIC(9.4,48,22,5.28,"PAH",683,1,7,0)="          the same with GUI and ISS"
^DIC(9.4,48,22,5.28,"PAH",683,1,8,0)="VSE-8672: BF - VistA: Modify SDES2 QUERY APPT REQ to increase the total "
^DIC(9.4,48,22,5.28,"PAH",683,1,9,0)="          number of records searched to 201"
^DIC(9.4,48,22,5.28,"PAH",683,1,10,0)="VSE-8674: JJ - VistA: Modify SDES2BLDAPPT44 to prevent ISS from failing "
^DIC(9.4,48,22,5.28,"PAH",683,1,11,0)="          when pulling up the patient appointments."
^DIC(9.4,48,22,5.28,"PAH",683,1,12,0)="VSE-8726: BB - Vista: SDES2 BLOCK AND MOVE erroneously returns back the "
^DIC(9.4,48,22,5.28,"PAH",683,1,13,0)="               error: ""Cannot block and move from slots that originated"
^DIC(9.4,48,22,5.28,"PAH",683,1,14,0)="               with more than 1 available appointment slot"""
^DIC(9.4,48,22,5.28,"PAH",683,1,15,0)="VSE-8732: LB -VistA: User information being sent in the SDCONTEXT array "
^DIC(9.4,48,22,5.28,"PAH",683,1,16,0)="          is finding issues with the ASECID cross reference "
^DIC(9.4,48,22,5.28,"PAH",683,1,17,0)=" "
^DIC(9.4,48,22,5.28,"PAH",683,1,18,0)=" "
