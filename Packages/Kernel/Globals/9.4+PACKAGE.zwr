^DIC(9.4,48,22,5.28,"PAH",316,1,1,0)="This patch correct multiple problems in the Scheduling 5.3 package. "
^DIC(9.4,48,22,5.28,"PAH",316,1,2,0)="First, the sensitive Patient warning was not being displayed in the "
^DIC(9.4,48,22,5.28,"PAH",316,1,3,0)="option, ""Expanded Display""."
^DIC(9.4,48,22,5.28,"PAH",316,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",316,1,5,0)="A form feed was removed in routine SDDPA to conform with VA "
^DIC(9.4,48,22,5.28,"PAH",316,1,6,0)="standards and reduce waste."
^DIC(9.4,48,22,5.28,"PAH",316,1,7,0)=" "
^DIC(9.4,48,22,5.28,"PAH",316,1,8,0)="Display the inactive clinics messages corrected."
