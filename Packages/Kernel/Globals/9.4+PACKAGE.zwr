^DIC(9.4,49,22,10,"PAH",578,1,1,0)="The INTEGRATED BILLING package needs to run the REGISTRATION report "
^DIC(9.4,49,22,10,"PAH",578,1,2,0)="implemented as MAIN^DGOTHFSM modified in the patch DG*5.3*1047 to display"
