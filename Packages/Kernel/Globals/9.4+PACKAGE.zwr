^DIC(9.4,14,22,5.9,"PAH",278,1,170,0)="Documentation Retrieval Instructions:"
^DIC(9.4,14,22,5.9,"PAH",278,1,171,0)="-------------------------------------------------- "
^DIC(9.4,14,22,5.9,"PAH",278,1,172,0)="Updated documentation describing the new functionality introduced by this "
^DIC(9.4,14,22,5.9,"PAH",278,1,173,0)="patch is available."
^DIC(9.4,14,22,5.9,"PAH",278,1,174,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,175,0)="The preferred method is to FTP the files from "
^DIC(9.4,14,22,5.9,"PAH",278,1,176,0)="ftp://download.vista.domain.ext/."
^DIC(9.4,14,22,5.9,"PAH",278,1,177,0)="This transmits the files from the first available FTP server. Sites may "
^DIC(9.4,14,22,5.9,"PAH",278,1,178,0)="also elect to retrieve software directly from a specific server as "
^DIC(9.4,14,22,5.9,"PAH",278,1,179,0)="follows:"
^DIC(9.4,14,22,5.9,"PAH",278,1,180,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,181,0)=" Albany         ftp.fo-albany.domain.ext  <ftp://ftp.fo-albany.domain.ext>"
^DIC(9.4,14,22,5.9,"PAH",278,1,182,0)=" Hines          ftp.fo-hines.domain.ext   <ftp://ftp.fo-hines.domain.ext>"
^DIC(9.4,14,22,5.9,"PAH",278,1,183,0)=" Salt Lake City ftp.fo-slc.domain.ext     <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,14,22,5.9,"PAH",278,1,184,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,185,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,14,22,5.9,"PAH",278,1,186,0)="at: http://www4.domain.ext/vdl/"
^DIC(9.4,14,22,5.9,"PAH",278,1,187,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,188,0)="Title                   File Name                         FTP Mode"
^DIC(9.4,14,22,5.9,"PAH",278,1,189,0)="--------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,190,0)="TBD"
^DIC(9.4,14,22,5.9,"PAH",278,1,191,0)="      "
^DIC(9.4,14,22,5.9,"PAH",278,1,192,0)="Patch Installation:"
^DIC(9.4,14,22,5.9,"PAH",278,1,193,0)="  "
^DIC(9.4,14,22,5.9,"PAH",278,1,194,0)="Pre/Post Installation Overview:"
^DIC(9.4,14,22,5.9,"PAH",278,1,195,0)="------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,196,0)="The environment check will ensure that the following ORDERABLE ITEMS and "
^DIC(9.4,14,22,5.9,"PAH",278,1,197,0)="TOPOGRAPHY entries are an exact name match before patch LR*5.2*469 will "
^DIC(9.4,14,22,5.9,"PAH",278,1,198,0)="be allowed to install. This matching is critical due to the dependency of"
^DIC(9.4,14,22,5.9,"PAH",278,1,199,0)="the configuration in LR AP DIALOG CONFIG file by ORDERABLE ITEM and "
^DIC(9.4,14,22,5.9,"PAH",278,1,200,0)="TOPOGRAPHY."
^DIC(9.4,14,22,5.9,"PAH",278,1,201,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,202,0)="Orderable Item search Criteria:"
^DIC(9.4,14,22,5.9,"PAH",278,1,203,0)="     First check is for an exact name match"
^DIC(9.4,14,22,5.9,"PAH",278,1,204,0)="          If multiples found the check will fail"
^DIC(9.4,14,22,5.9,"PAH",278,1,205,0)="          If one or more match the name but none have a display group of"
^DIC(9.4,14,22,5.9,"PAH",278,1,206,0)="            anatomic pathology the check will fail"
^DIC(9.4,14,22,5.9,"PAH",278,1,207,0)="          If there is one exact name match with a display group of "
^DIC(9.4,14,22,5.9,"PAH",278,1,208,0)="            Anatomic Pathology the check will be successful"
^DIC(9.4,14,22,5.9,"PAH",278,1,209,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,210,0)="Specimen search Criteria:"
^DIC(9.4,14,22,5.9,"PAH",278,1,211,0)="     First check to see if SCT code has been assigned to any specimen"
^DIC(9.4,14,22,5.9,"PAH",278,1,212,0)="          If no association is found the check will fail"
^DIC(9.4,14,22,5.9,"PAH",278,1,213,0)="     Find all specimen entries in the environment check that have an"
^DIC(9.4,14,22,5.9,"PAH",278,1,214,0)="       SCT code assigned"
^DIC(9.4,14,22,5.9,"PAH",278,1,215,0)="          Find all specimens with an exact name match"
^DIC(9.4,14,22,5.9,"PAH",278,1,216,0)="          If SCT code is found for only one specimen check is successful"
^DIC(9.4,14,22,5.9,"PAH",278,1,217,0)="          If an exact name matches the SCT code the check is successful"
^DIC(9.4,14,22,5.9,"PAH",278,1,218,0)="          If multiple specimen with matching SCT code and matching names"
^DIC(9.4,14,22,5.9,"PAH",278,1,219,0)="            the check will fail"
^DIC(9.4,14,22,5.9,"PAH",278,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,221,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,223,0)="ORDERABLE ITEMs checked:"
^DIC(9.4,14,22,5.9,"PAH",278,1,224,0)=" "
