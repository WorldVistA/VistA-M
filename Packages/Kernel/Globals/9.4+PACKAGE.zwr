^DIC(9.4,60,22,12,"PAH",3,1,0)="^^9^9^2970204"
^DIC(9.4,60,22,12,"PAH",3,1,1,0)="Miscellaneous patch."
^DIC(9.4,60,22,12,"PAH",3,1,2,0)="1) Allow users to reprint Rx's filled at CMOP facilities."
^DIC(9.4,60,22,12,"PAH",3,1,3,0)="2) Fix Refill Quantities in Drug Acct"
^DIC(9.4,60,22,12,"PAH",3,1,4,0)="3)This patch fixes a problem that could occur after processing Rx's in the"
^DIC(9.4,60,22,12,"PAH",3,1,5,0)="Process Drug/Drug Interactions option. If any Rx's are processed in this"
^DIC(9.4,60,22,12,"PAH",3,1,6,0)="option, and the user then goes directly to the New Prescription Entry"
^DIC(9.4,60,22,12,"PAH",3,1,7,0)="option and enters new Rx's, a duplicate label of the Rx processed in the"
^DIC(9.4,60,22,12,"PAH",3,1,8,0)="Process Drug/Drug Interactions option could possibly print. This patch"
^DIC(9.4,60,22,12,"PAH",3,1,9,0)="fixes the problem."
^DIC(9.4,60,22,12,"PAH",4,0)="158 SEQ #156^2970401^1"
^DIC(9.4,60,22,12,"PAH",4,1,0)="^^2^2^2970401"
^DIC(9.4,60,22,12,"PAH",4,1,1,0)="CMOP/OUTPATIENT PHARMACY enhancement patch to allow users to designate, at"
^DIC(9.4,60,22,12,"PAH",4,1,2,0)="the patient level, mailing criteria."
^DIC(9.4,60,22,12,"PAH",5,0)="159 SEQ #157^2970528^1"
^DIC(9.4,60,22,12,"PAH",5,1,0)="^^1^1^2970528"
^DIC(9.4,60,22,12,"PAH",5,1,1,0)="See the patch description PSO*6*159."
^DIC(9.4,60,22,12,"PAH",6,0)="160 SEQ #158^2970602^1"
^DIC(9.4,60,22,12,"PAH",6,1,0)="^^1^1^2970602"
^DIC(9.4,60,22,12,"PAH",6,1,1,0)="See the patch description PSO*6*160."
^DIC(9.4,60,22,12,"PAH",7,0)="152 SEQ #159^2970819^1"
^DIC(9.4,60,22,12,"PAH",7,1,0)="^^2^2^2970819"
^DIC(9.4,60,22,12,"PAH",7,1,1,0)=" "
^DIC(9.4,60,22,12,"PAH",7,1,2,0)="This is the CHAMPUS Billing patch for Outpatient Pharmacy (PSO*6*152)."
^DIC(9.4,60,22,12,"PAH",8,0)="161 SEQ #160^2971118^1"
^DIC(9.4,60,22,12,"PAH",8,1,0)="^^1^1^2971118"
^DIC(9.4,60,22,12,"PAH",8,1,1,0)="See the patch description PSO*6*161."
