^DIC(9.4,14,22,5.9,"PAH",156,1,53,0)=" Boston HCS (Integrated/Large site)"
^DIC(9.4,14,22,5.9,"PAH",156,1,54,0)=" Fayetteville AR, VAMC (Medium site)"
^DIC(9.4,14,22,5.9,"PAH",156,1,55,0)=" Milwaukee VAMC (Large site)"
^DIC(9.4,14,22,5.9,"PAH",156,1,56,0)=" New Orleans VAMC (Large siet)"
^DIC(9.4,14,22,5.9,"PAH",156,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,59,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",156,1,60,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",156,1,61,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",156,1,62,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",156,1,63,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",156,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,65,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",156,1,66,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",156,1,67,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",156,1,68,0)="   LR330            N/A            4831418        **330** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",156,1,69,0)="   LRVR4            9645653        9819762        **14,42,121,153,221,263,"
^DIC(9.4,14,22,5.9,"PAH",156,1,70,0)="                                                  279,283,287,286,330**"
^DIC(9.4,14,22,5.9,"PAH",156,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,72,0)=" List of preceding patches: 286"
^DIC(9.4,14,22,5.9,"PAH",156,1,73,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",156,1,74,0)="  "
^DIC(9.4,14,22,5.9,"PAH",156,1,75,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,76,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",156,1,77,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",156,1,78,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",156,1,79,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",156,1,80,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",156,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,83,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",156,1,84,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",156,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,86,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",156,1,87,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",156,1,88,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,90,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",156,1,91,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,92,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",156,1,93,0)="        option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",156,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,95,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",156,1,96,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",156,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,98,0)="  4.  From this menu, you may then elect to use the following options"
^DIC(9.4,14,22,5.9,"PAH",156,1,99,0)="      (when prompted for the INSTALL NAME, enter LR*5.2*330):"
^DIC(9.4,14,22,5.9,"PAH",156,1,100,0)="        a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",156,1,101,0)="        b. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",156,1,102,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",156,1,103,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",156,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,105,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",156,1,106,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",156,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,108,0)="  5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",156,1,109,0)="      and select the package 'LR*5.2*330'.  When prompted 'Want KIDS to"
^DIC(9.4,14,22,5.9,"PAH",156,1,110,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,14,22,5.9,"PAH",156,1,111,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,14,22,5.9,"PAH",156,1,112,0)="      YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",156,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,114,0)="     The install will automatically disable the following options:"
^DIC(9.4,14,22,5.9,"PAH",156,1,115,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,116,0)="       Accession order then immediately enter data [LR ACC THEN DATA]"
^DIC(9.4,14,22,5.9,"PAH",156,1,117,0)="       Batch data entry (chem, hem, tox, etc.) [LRSTUF]"
^DIC(9.4,14,22,5.9,"PAH",156,1,118,0)="       Bypass normal data entry [LRFAST]"
^DIC(9.4,14,22,5.9,"PAH",156,1,119,0)="       Enter/verify data (Load list) [LRVRW2]"
^DIC(9.4,14,22,5.9,"PAH",156,1,120,0)="       Enter/verify data (Work list) [LRVRW] "
^DIC(9.4,14,22,5.9,"PAH",156,1,121,0)="       Enter/verify data (auto instrument) [LRVR]"
^DIC(9.4,14,22,5.9,"PAH",156,1,122,0)="       Fast Bypass Data Entry/Verify [LRFASTS]"
^DIC(9.4,14,22,5.9,"PAH",156,1,123,0)="       Group verify (EA, EL, EW) [LRGV]"
^DIC(9.4,14,22,5.9,"PAH",156,1,124,0)="       Special test accessioning [LRNONCOM]"
^DIC(9.4,14,22,5.9,"PAH",156,1,125,0)="       Group data review (verified & EM) [LRGVP] "
^DIC(9.4,14,22,5.9,"PAH",156,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,127,0)="  6.  On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",156,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,129,0)=" Note: Routine LR330 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",156,1,130,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,131,0)=" "
