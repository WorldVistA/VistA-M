^DIC(9.4,14,22,5.9,"PAH",281,1,397,0)="Ask Performing Lab AP                             YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,398,0)="Ask Performing Lab Micro                          YES"
^DIC(9.4,14,22,5.9,"PAH",281,1,399,0)="Print SNOMED Code System                          SNOMED I"
^DIC(9.4,14,22,5.9,"PAH",281,1,400,0)="Document Surgery Package Case Info                NO"
^DIC(9.4,14,22,5.9,"PAH",281,1,401,0)="Chemistry GUI Report Right Margin                 "
^DIC(9.4,14,22,5.9,"PAH",281,1,402,0)="Microbiology GUI Report Right Margin              "
^DIC(9.4,14,22,5.9,"PAH",281,1,403,0)="AP GUI Report Right Margin                        "
^DIC(9.4,14,22,5.9,"PAH",281,1,404,0)="Method of Assigning AP Accession Number"
^DIC(9.4,14,22,5.9,"PAH",281,1,405,0)="Default Accessioning Specimen"
^DIC(9.4,14,22,5.9,"PAH",281,1,406,0)="Default Accessioning Collection Sample"
^DIC(9.4,14,22,5.9,"PAH",281,1,407,0)="Default Accessioning Lab Test"
^DIC(9.4,14,22,5.9,"PAH",281,1,408,0)="Exclude removed tests from building"
