^DIC(9.4,9,22,4,0)="5.5^3050202^3050311^1"
^DIC(9.4,9,22,4,1,0)="^9.54^1^1^3050311"
^DIC(9.4,9,22,4,1,1,0)="OUTPATIENT MEALS"
^DIC(9.4,9,22,4,"PAH",0)="^9.4901^50^50"
^DIC(9.4,9,22,4,"PAH",1,0)="1 SEQ #1^3050709^1"
^DIC(9.4,9,22,4,"PAH",2,0)="2 SEQ #2^3060308^1"
^DIC(9.4,9,22,4,"PAH",3,0)="3 SEQ #3^3060308^1"
^DIC(9.4,9,22,4,"PAH",3,1,0)="^^1^1^3060308"
^DIC(9.4,9,22,4,"PAH",3,1,1,0)="Changes to Meal Production report as part of the Advance Food Prep."
^DIC(9.4,9,22,4,"PAH",4,0)="6 SEQ #4^3060614^1"
^DIC(9.4,9,22,4,"PAH",5,0)="7 SEQ #5^3061123.003203^1"
^DIC(9.4,9,22,4,"PAH",6,0)="4 SEQ #6^3061227.144022^1"
^DIC(9.4,9,22,4,"PAH",6,1,0)="^^1^1^3061227"
^DIC(9.4,9,22,4,"PAH",6,1,1,0)="Tickler file modifications and Lab/Pharmacy APIs"
^DIC(9.4,9,22,4,"PAH",7,0)="5 SEQ #7  ;Created on Jan 11, 2007@07:46:57^3070905.0009^1"
^DIC(9.4,9,22,4,"PAH",7,1,0)="^^2^2^3070905"
^DIC(9.4,9,22,4,"PAH",7,1,1,0)="A patch for outpatient standing orders, supplemental feeding"
^DIC(9.4,9,22,4,"PAH",7,1,2,0)="and other fixes."
^DIC(9.4,9,22,4,"PAH",8,0)="11 SEQ #8^3070905.005856^1"
^DIC(9.4,9,22,4,"PAH",8,1,0)="^^1^1^3070905"
^DIC(9.4,9,22,4,"PAH",8,1,1,0)="BAGGED MEALS SETTING/VARIABLE CLEANUP"
^DIC(9.4,9,22,4,"PAH",9,0)="8^3071212.210904^1"
^DIC(9.4,9,22,4,"PAH",10,0)="10 SEQ #10^3080203.213458^1"
^DIC(9.4,9,22,4,"PAH",11,0)="9 SEQ #11^3080203.223819^1"
^DIC(9.4,9,22,4,"PAH",11,1,0)="^^25^25^3080203"
^DIC(9.4,9,22,4,"PAH",11,1,1,0)="Addresses issues with two reports and a bad cross index in the FOOD "
^DIC(9.4,9,22,4,"PAH",11,1,2,0)="NUTRIENTS file of the Nurtition and Food Service package"
^DIC(9.4,9,22,4,"PAH",11,1,3,0)=" "
^DIC(9.4,9,22,4,"PAH",11,1,4,0)="HD0000000152560 - CPRS Dietetics Profile does not jive"
^DIC(9.4,9,22,4,"PAH",11,1,5,0)="When a CPRS user has selected an outpatient and decideds to view the "
^DIC(9.4,9,22,4,"PAH",11,1,6,0)="patient's dietetics profile, the food preferences listed are incomplete. "
^DIC(9.4,9,22,4,"PAH",11,1,7,0)="Additional issue found during SQA. When a CPRS user selected several "
^DIC(9.4,9,22,4,"PAH",11,1,8,0)="outpatients during a ongoing session the food preferences listed contains "
^DIC(9.4,9,22,4,"PAH",11,1,9,0)="all the food preferences for all of the previously selected outpatient "
^DIC(9.4,9,22,4,"PAH",11,1,10,0)="and will display for the currently selected outpatient. This was an issue "
^DIC(9.4,9,22,4,"PAH",11,1,11,0)="hidden by the first problem of the incomplete display."
^DIC(9.4,9,22,4,"PAH",11,1,12,0)=" "
^DIC(9.4,9,22,4,"PAH",11,1,13,0)="HD0000000188896 - Error in FHASP1"
^DIC(9.4,9,22,4,"PAH",11,1,14,0)="It is possiable for a patient to have a food preference without a meal "
^DIC(9.4,9,22,4,"PAH",11,1,15,0)="associated with it. When the report option Print Nutrition Profile is run "
^DIC(9.4,9,22,4,"PAH",11,1,16,0)="for a patient with a food preference without an associated meal the "
^DIC(9.4,9,22,4,"PAH",11,1,17,0)="routine called by this option, FHASP1, will error out."
^DIC(9.4,9,22,4,"PAH",11,1,18,0)=" "
^DIC(9.4,9,22,4,"PAH",11,1,19,0)="HD0000000202836 - REPLETE WITH FIBER is INACTIVE"
^DIC(9.4,9,22,4,"PAH",11,1,20,0)="The cross reference for field # 99, INACTIVE?, in file # 112, FOOD "
^DIC(9.4,9,22,4,"PAH",11,1,21,0)="NUTRIENTS, is incorrect. It is intended to kill the node ^FHNU(DA,""I"") if "
^DIC(9.4,9,22,4,"PAH",11,1,22,0)="the user selectes N for no or deletes the stored value. It is written to "
^DIC(9.4,9,22,4,"PAH",11,1,23,0)="kill node ^FH(112,DA,""I""). This is a node that is never created. So "
^DIC(9.4,9,22,4,"PAH",11,1,24,0)="nothing is killed. Since node ^FHNU(DA,""I"") continues to exist the "
^DIC(9.4,9,22,4,"PAH",11,1,25,0)="record will remain flagged as inactive."
^DIC(9.4,9,22,4,"PAH",12,0)="12 SEQ #12^3080526.190517^1"
^DIC(9.4,9,22,4,"PAH",12,1,0)="^^1^1^3080526"
^DIC(9.4,9,22,4,"PAH",12,1,1,0)="FOOD PREF TO ALLERGY FLDS/REMOVE PRIOR CLINICIAN FLD"
^DIC(9.4,9,22,4,"PAH",13,0)="13 SEQ #13^3080526.192926^1"
^DIC(9.4,9,22,4,"PAH",13,1,0)="^^5^5^3080526"
^DIC(9.4,9,22,4,"PAH",13,1,1,0)="ADDRESSES ISSUES WITH TWO REPORTS AND ALLERGY MAPPING"
^DIC(9.4,9,22,4,"PAH",13,1,2,0)=" "
^DIC(9.4,9,22,4,"PAH",13,1,3,0)="HD0000000198141 - Supplemental Feeding Labels Ingred List"
^DIC(9.4,9,22,4,"PAH",13,1,4,0)="HD0000000229391 - FGH - MAPPING ALLERGIES"
^DIC(9.4,9,22,4,"PAH",13,1,5,0)="HD0000000231873 - User is prompted for a date entry that is being rejected"
^DIC(9.4,9,22,4,"PAH",14,0)="14 SEQ #14^3090420.160212^1"
^DIC(9.4,9,22,4,"PAH",14,1,0)="^^2^2^3090420"
^DIC(9.4,9,22,4,"PAH",14,1,1,0)="This build is to address issues realted to the release of FH*5.5*8. Fixes "
^DIC(9.4,9,22,4,"PAH",14,1,2,0)="to problems with the Nutritional Assessment and its interface wtih TIU."
^DIC(9.4,9,22,4,"PAH",15,0)="15 SEQ #15^3090421.162518^17"
^DIC(9.4,9,22,4,"PAH",16,0)="16 SEQ #16^3090422.151925^17"
^DIC(9.4,9,22,4,"PAH",16,1,0)="^^4^4^3090422"
^DIC(9.4,9,22,4,"PAH",16,1,1,0)="Routine FHDSSAPI is returning too many records. These excess records are "
^DIC(9.4,9,22,4,"PAH",16,1,2,0)="invalid and leading to poor and incorrect results by DSS processing. This "
^DIC(9.4,9,22,4,"PAH",16,1,3,0)="patch modifies routine FHDSSAPI to provide additional record filtering to "
^DIC(9.4,9,22,4,"PAH",16,1,4,0)="the extract."
^DIC(9.4,9,22,4,"PAH",17,0)="18^3090422.152306^17"
^DIC(9.4,9,22,4,"PAH",18,0)="17 SEQ #18^3090423.135056^17"
^DIC(9.4,9,22,4,"PAH",18,1,0)="^^21^21^3090423"
^DIC(9.4,9,22,4,"PAH",18,1,1,0)="General purpose NUTRITION AND FOOD SERVICE patch."
^DIC(9.4,9,22,4,"PAH",18,1,2,0)=" "
^DIC(9.4,9,22,4,"PAH",18,1,3,0)="This patch addresses the folowing issues:"
^DIC(9.4,9,22,4,"PAH",18,1,4,0)=" "
^DIC(9.4,9,22,4,"PAH",18,1,5,0)="The Diet Order List not printing a complete list of patients when "
^DIC(9.4,9,22,4,"PAH",18,1,6,0)="selected to print alphabeticly and in some rare cases by room number."
^DIC(9.4,9,22,4,"PAH",18,1,7,0)=" "
^DIC(9.4,9,22,4,"PAH",18,1,8,0)="The option Standing Order Inquiry option [FHSP4] wound encounter a "
^DIC(9.4,9,22,4,"PAH",18,1,9,0)="subscript error on some patients that force the user out of VistA."
^DIC(9.4,9,22,4,"PAH",18,1,10,0)=" "
^DIC(9.4,9,22,4,"PAH",18,1,11,0)="The statement in the Inpatient Nutritional Assessment of ""No laboratory "
^DIC(9.4,9,22,4,"PAH",18,1,12,0)="data available last XXX days"" was not being saved to TIU."
^DIC(9.4,9,22,4,"PAH",18,1,13,0)=" "
^DIC(9.4,9,22,4,"PAH",18,1,14,0)="The patient lookup for the Nutrition and Food Service package will first "
^DIC(9.4,9,22,4,"PAH",18,1,15,0)="attempt to find a match in the PATIENT file, # 200. If no match is found "
^DIC(9.4,9,22,4,"PAH",18,1,16,0)="or accepted by the user the lookup will attempt to find a match in the "
^DIC(9.4,9,22,4,"PAH",18,1,17,0)="NEW PERSON file, # 2. It does this without alerting the user it has "
^DIC(9.4,9,22,4,"PAH",18,1,18,0)="switch files during the look up."
^DIC(9.4,9,22,4,"PAH",18,1,19,0)=" "
^DIC(9.4,9,22,4,"PAH",18,1,20,0)="XINDEX found a SAC violation of a lock command without a timeout in "
^DIC(9.4,9,22,4,"PAH",18,1,21,0)="routine FHSPED."
^DIC(9.4,9,22,4,"PAH",19,0)="19 SEQ #19^3090630.111943^17"
^DIC(9.4,9,22,4,"PAH",19,1,0)="^^1^1^3090630"
^DIC(9.4,9,22,4,"PAH",19,1,1,0)="This addresses general issues with the Nutrition and Food Service package."
^DIC(9.4,9,22,4,"PAH",20,0)="22 SEQ #20^3100406.141725^17"
^DIC(9.4,9,22,4,"PAH",20,1,0)="^^1^1^3100406"
^DIC(9.4,9,22,4,"PAH",20,1,1,0)="FIXES A DIVIDE BY ZERO ERROR"
^DIC(9.4,9,22,4,"PAH",21,0)="23 SEQ #21^3100406.141731^17"
^DIC(9.4,9,22,4,"PAH",21,1,0)="^^1^1^3100406"
^DIC(9.4,9,22,4,"PAH",21,1,1,0)="UPDATE FOOD ALLERGIES IN ROUINTE FHSELA2"
^DIC(9.4,9,22,4,"PAH",22,0)="20 SEQ #22^3100826.124101^17"
^DIC(9.4,9,22,4,"PAH",22,1,0)="^^1^1^3100826"
^DIC(9.4,9,22,4,"PAH",22,1,1,0)="THE PATCH ADDRESSES ISSUE WITH THE TICKLER FILE ROUTINES."
^DIC(9.4,9,22,4,"PAH",23,0)="21 SEQ #23^3110127.09123^17"
^DIC(9.4,9,22,4,"PAH",23,1,0)="^^1^1^3110127"
^DIC(9.4,9,22,4,"PAH",23,1,1,0)="ADDRESSES GENERAL NUTRITION AND FOOD SERVICE ISSUES"
^DIC(9.4,9,22,4,"PAH",24,0)="25 SEQ #24^3110913.12431^17"
^DIC(9.4,9,22,4,"PAH",24,1,0)="^^5^5^3110913"
^DIC(9.4,9,22,4,"PAH",24,1,1,0)="Food items with miss-spelled allergies not mapping properly."
^DIC(9.4,9,22,4,"PAH",24,1,2,0)="Adding corrected allergy spellings to FHSELA2:"
^DIC(9.4,9,22,4,"PAH",24,1,3,0)="In FHSELA2                        In GMR ALLERGIES FILE"
^DIC(9.4,9,22,4,"PAH",24,1,4,0)="BARBEQUE SAUCE                    BARBECUE SAUCE"
^DIC(9.4,9,22,4,"PAH",24,1,5,0)="EGG, SUBSTITUTES                  EGG SUBSTITUTES"
^DIC(9.4,9,22,4,"PAH",25,0)="24 SEQ #25^3120111.140115^17"
^DIC(9.4,9,22,4,"PAH",25,1,0)="^^1^1^3120111"
^DIC(9.4,9,22,4,"PAH",25,1,1,0)="GENERAL BUG FIXES"
^DIC(9.4,9,22,4,"PAH",26,0)="27 SEQ #26^3120306.100153^17"
^DIC(9.4,9,22,4,"PAH",26,1,0)="^^16^16^3120306"
^DIC(9.4,9,22,4,"PAH",26,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,9,22,4,"PAH",26,1,2,0)="1. Nursing home patients with an ASIH episode, the tickler appears to "
^DIC(9.4,9,22,4,"PAH",26,1,3,0)="stop working for them."
^DIC(9.4,9,22,4,"PAH",26,1,4,0)=" "
^DIC(9.4,9,22,4,"PAH",26,1,5,0)="2. The List Inpats By Nutrition Status Level [FHASNR4] report option when "
^DIC(9.4,9,22,4,"PAH",26,1,6,0)="run and the sorting is done by CLINICIAN is using the old CLINICIAN field"
^DIC(9.4,9,22,4,"PAH",26,1,7,0)="(field #1) rather than the new CLINICIAN(S) field (field #112). This"
^DIC(9.4,9,22,4,"PAH",26,1,8,0)="causes the report to produce incorrect information."
^DIC(9.4,9,22,4,"PAH",26,1,9,0)=" "
^DIC(9.4,9,22,4,"PAH",26,1,10,0)="3. A nutrition location with the Send Alerts option enabled for the "
^DIC(9.4,9,22,4,"PAH",26,1,11,0)="monitors will use the routine FHWTRN to send alerts to the clinicians "
^DIC(9.4,9,22,4,"PAH",26,1,12,0)="when a patient has been tranfered from another nutrition location and "
^DIC(9.4,9,22,4,"PAH",26,1,13,0)="that patient has monitors filed. Routine FHWTRN was not updated with "
^DIC(9.4,9,22,4,"PAH",26,1,14,0)="patch FH*5.5*8 to properly use the multivalued CLINICIAN(S) field (# 112)."
^DIC(9.4,9,22,4,"PAH",26,1,15,0)="The results in alerts being send to the incorrect clinican and to the "
^DIC(9.4,9,22,4,"PAH",26,1,16,0)="correct clinican, but in the name of the incorrect clinican."
^DIC(9.4,9,22,4,"PAH",27,0)="26 SEQ #27^3120405.115032^17"
^DIC(9.4,9,22,4,"PAH",28,0)="31 SEQ #28^3121010.174808^17"
^DIC(9.4,9,22,4,"PAH",28,1,0)="^^1^1^3121010"
^DIC(9.4,9,22,4,"PAH",28,1,1,0)="Addressing issues from Patch FH*5.5*24"
^DIC(9.4,9,22,4,"PAH",29,0)="33 SEQ #29^3121114.171536^17"
^DIC(9.4,9,22,4,"PAH",29,1,0)="^^4^4^3121114"
^DIC(9.4,9,22,4,"PAH",29,1,1,0)="Transferring an inpatient to a nutrition location with more than one"
^DIC(9.4,9,22,4,"PAH",29,1,2,0)="clinician assigned to it will generate an undefined error when filing a"
^DIC(9.4,9,22,4,"PAH",29,1,3,0)="tickler for the second clinician assigned to that nutrition location. "
^DIC(9.4,9,22,4,"PAH",29,1,4,0)="This error will force the user out of VistA."
^DIC(9.4,9,22,4,"PAH",30,0)="28 SEQ #30^3121210.114033^17"
^DIC(9.4,9,22,4,"PAH",30,1,0)="^^2^2^3121210"
^DIC(9.4,9,22,4,"PAH",30,1,1,0)="Adding KIDNEY BEANS and OCTOPUS to ""Create/Map Food Preferences to "
^DIC(9.4,9,22,4,"PAH",30,1,2,0)="Allergies"" [FHSELA] option for mapping."
^DIC(9.4,9,22,4,"PAH",31,0)="32 SEQ #31^3130205.124104^17"
^DIC(9.4,9,22,4,"PAH",31,1,0)="^^4^4^3130205"
^DIC(9.4,9,22,4,"PAH",31,1,1,0)="This patch will address the following issues:"
^DIC(9.4,9,22,4,"PAH",31,1,2,0)="1. When printing the Patient Profile [FHORD9] for an inpatient the "
^DIC(9.4,9,22,4,"PAH",31,1,3,0)="patient's sex will not print or it will print what looks to be part of "
^DIC(9.4,9,22,4,"PAH",31,1,4,0)="the raw global data stored for the patient in the PATIENT file (#2)."
^DIC(9.4,9,22,4,"PAH",32,0)="29 SEQ #32^3130430.104104^17"
^DIC(9.4,9,22,4,"PAH",32,1,0)="^^4^4^3130430"
^DIC(9.4,9,22,4,"PAH",32,1,1,0)="Issues addresed:"
^DIC(9.4,9,22,4,"PAH",32,1,2,0)="1. UNDEFINED VARIABLE ERROR IN FHSELA1"
^DIC(9.4,9,22,4,"PAH",32,1,3,0)="2. FOOD PREFERENCES WITHOUT ASSOCIATED MEAL DO NOT DISPLAY IN PATIENT "
^DIC(9.4,9,22,4,"PAH",32,1,4,0)="PREFERENCES"
^DIC(9.4,9,22,4,"PAH",33,0)="34 SEQ #33^3130624.154427^17"
^DIC(9.4,9,22,4,"PAH",33,1,0)="^^1^1^3130624"
^DIC(9.4,9,22,4,"PAH",33,1,1,0)="THE FOOD ALLERGY INDICATOR OF *ALG IS NOT PRINTING IN THE LASER LABELS."
^DIC(9.4,9,22,4,"PAH",34,0)="35 SEQ #34^3130819.15015^17"
^DIC(9.4,9,22,4,"PAH",34,1,0)="^^1^1^3130819"
^DIC(9.4,9,22,4,"PAH",34,1,1,0)="NEED TO ADD SAGE TO ROUTINE FHSELA2"
^DIC(9.4,9,22,4,"PAH",35,0)="30 SEQ #35^3131203.152328^17"
^DIC(9.4,9,22,4,"PAH",35,1,0)="^^7^7^3131203"
^DIC(9.4,9,22,4,"PAH",35,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,9,22,4,"PAH",35,1,2,0)="1. When the user decides to sort the Nutrition Status Average Report by "
^DIC(9.4,9,22,4,"PAH",35,1,3,0)="the Clinician, the report is using the CLINICIAN (# 1) field rather than"
^DIC(9.4,9,22,4,"PAH",35,1,4,0)="the CLINICIAN(S) (# 112) of the NUTRITION LOCATION (# 119.6) file."
^DIC(9.4,9,22,4,"PAH",35,1,5,0)=" "
^DIC(9.4,9,22,4,"PAH",35,1,6,0)="2. Routine FHASN71 will be updated to include Integration Agreements in "
^DIC(9.4,9,22,4,"PAH",35,1,7,0)="its comments section."
^DIC(9.4,9,22,4,"PAH",36,0)="37 SEQ #36^3140221.101301^17"
^DIC(9.4,9,22,4,"PAH",36,1,0)="^^9^9^3140221"
^DIC(9.4,9,22,4,"PAH",36,1,1,0)="PSPO 1380 CHANGES NEEDED DUE TO NTRT"
^DIC(9.4,9,22,4,"PAH",36,1,2,0)=" "
^DIC(9.4,9,22,4,"PAH",36,1,3,0)="This patch addresses the following issue(s):"
^DIC(9.4,9,22,4,"PAH",36,1,4,0)=" "
^DIC(9.4,9,22,4,"PAH",36,1,5,0)="1. Recent NTRT pushes have added new food, food/drug allergies to the GMR"
^DIC(9.4,9,22,4,"PAH",36,1,6,0)="ALLERGIES file (#120.82). These new food allergies will not be presented"
^DIC(9.4,9,22,4,"PAH",36,1,7,0)="to the user in the N&FS menu option Create/Map Food Preference to"
^DIC(9.4,9,22,4,"PAH",36,1,8,0)="Allergies [FHSELA]. This is part of an ongoing Patient Safety issue PSPO "
^DIC(9.4,9,22,4,"PAH",36,1,9,0)="1380. This patch is an incremental fix for PSPO #1380."
^DIC(9.4,9,22,4,"PAH",37,0)="36 SEQ #37^3140324.15393^17"
^DIC(9.4,9,22,4,"PAH",37,1,0)="^^6^6^3140324"
^DIC(9.4,9,22,4,"PAH",37,1,1,0)="In the patient's list of food preferences for options Enter/Edit Patient "
^DIC(9.4,9,22,4,"PAH",37,1,2,0)="Preferences [FHSEL3] and Display Patient Preferences [FHSEL4] food "
^DIC(9.4,9,22,4,"PAH",37,1,3,0)="prefernces without an associated meal with no indicator they have this "
^DIC(9.4,9,22,4,"PAH",37,1,4,0)="problem. Sites are not able to determine easily which food preferences "
^DIC(9.4,9,22,4,"PAH",37,1,5,0)="did not have an associated meal in order to fix them in the Enter/Edit"
^DIC(9.4,9,22,4,"PAH",37,1,6,0)="Patient Preferences [FHSEL3]."
^DIC(9.4,9,22,4,"PAH",38,0)="39 SEQ #38^3150820.145604^17"
^DIC(9.4,9,22,4,"PAH",38,1,0)="^^11^11^3150820"
^DIC(9.4,9,22,4,"PAH",38,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,9,22,4,"PAH",38,1,2,0)="PSPO 1380 changes needed due to NTRT"
^DIC(9.4,9,22,4,"PAH",38,1,3,0)=" "
^DIC(9.4,9,22,4,"PAH",38,1,4,0)="1. A recent NTRT push have added a new food allergy to and updated two "
^DIC(9.4,9,22,4,"PAH",38,1,5,0)="existing food, food/drug allergies in the GMR ALLERGIES file (#120.82)."
^DIC(9.4,9,22,4,"PAH",38,1,6,0)="The new food allergy is PAWPAW. The updated food allergies are MULBERRY"
^DIC(9.4,9,22,4,"PAH",38,1,7,0)="and MOLASSESS. Review of the routine FHSELA2 found that none of"
^DIC(9.4,9,22,4,"PAH",38,1,8,0)="these allergies are in its code and will not be presented to the user"
^DIC(9.4,9,22,4,"PAH",38,1,9,0)="in the N&FS menu option Create/Map Food Preference to Allergies [FHSELA]."
^DIC(9.4,9,22,4,"PAH",38,1,10,0)="This is part of an ongoing Patient Safety issue PSPO 1380. This patch is"
^DIC(9.4,9,22,4,"PAH",38,1,11,0)="an incremental fix for PSPO #1380."
^DIC(9.4,9,22,4,"PAH",39,0)="40 SEQ #39^3160225.141648^54"
^DIC(9.4,9,22,4,"PAH",39,1,0)="^^4^4^3160225"
^DIC(9.4,9,22,4,"PAH",39,1,1,0)="1. Adding Food Allergy SORBITOL to routine FHSLEA2."
^DIC(9.4,9,22,4,"PAH",39,1,2,0)=" "
^DIC(9.4,9,22,4,"PAH",39,1,3,0)="2. Modifing allergy type food prefernce IODINE data line in routine "
^DIC(9.4,9,22,4,"PAH",39,1,4,0)="FHSELA2 to include GMR ALLERGY IODINE for mapping."
^DIC(9.4,9,22,4,"PAH",40,0)="41 SEQ #40^3160606.103741^17"
^DIC(9.4,9,22,4,"PAH",40,1,0)="^^7^7^3160606"
^DIC(9.4,9,22,4,"PAH",40,1,1,0)="This patch will address the following issues:"
^DIC(9.4,9,22,4,"PAH",40,1,2,0)="1. Adding Food/Food Drug allergies MALTITOL, MANNITOL, and XYLITOL to "
^DIC(9.4,9,22,4,"PAH",40,1,3,0)="FHSELA2."
^DIC(9.4,9,22,4,"PAH",40,1,4,0)="2. Incremental Locks missing timeouts in routines FHNO5, FHORD7, and "
^DIC(9.4,9,22,4,"PAH",40,1,5,0)="FHORD72."
^DIC(9.4,9,22,4,"PAH",40,1,6,0)=" "
^DIC(9.4,9,22,4,"PAH",40,1,7,0)="3. Adding Food/Food Drug allergy SASSAFRAS to FHSELA2."
^DIC(9.4,9,22,4,"PAH",41,0)="42 SEQ #41^3170123.142334^54"
^DIC(9.4,9,22,4,"PAH",41,1,0)="^^5^5^3170123"
^DIC(9.4,9,22,4,"PAH",41,1,1,0)="This patch will address the following issueS:"
^DIC(9.4,9,22,4,"PAH",41,1,2,0)="1. Adding Food, Drug/Food allergies BAY LEAVES, CARAWAY SEEDS, and"
^DIC(9.4,9,22,4,"PAH",41,1,3,0)="   FRUTOSE to FHSELA2."
^DIC(9.4,9,22,4,"PAH",41,1,4,0)="2. The Supplemental Feeding for a diet order was not being discontinued "
^DIC(9.4,9,22,4,"PAH",41,1,5,0)="   when a the diet order changed at a schuduled date/time."
^DIC(9.4,9,22,4,"PAH",42,0)="44 SEQ #42^3171227.133518^54"
^DIC(9.4,9,22,4,"PAH",42,1,0)="^^2^2^3171227"
^DIC(9.4,9,22,4,"PAH",42,1,1,0)="THIS PATCH WILL UPDATE FHSELA2 TO INCLUDE THE NEW FOOD ALLERGY OF BEAN "
^DIC(9.4,9,22,4,"PAH",42,1,2,0)="SPROUTS."
^DIC(9.4,9,22,4,"PAH",43,0)="45 SEQ #43^3180228.165103^54"
^DIC(9.4,9,22,4,"PAH",43,1,0)="^^2^2^3180228"
^DIC(9.4,9,22,4,"PAH",43,1,1,0)="This build will add ARROWROOT as a new item available for mapping in food "
^DIC(9.4,9,22,4,"PAH",43,1,2,0)="preferences."
^DIC(9.4,9,22,4,"PAH",44,0)="46 SEQ #44^3190103.161843^54"
^DIC(9.4,9,22,4,"PAH",44,1,0)="^^6^6^3190103"
^DIC(9.4,9,22,4,"PAH",44,1,1,0)="The New Term Rapid Turnaround (NTRT) Allergy team has recently added "
^DIC(9.4,9,22,4,"PAH",44,1,2,0)="DAIRY FOODS,FRESH FRUITS,FRUITS,MINT HERB,PEPPERMINT HERB,PEPPERMINT"
^DIC(9.4,9,22,4,"PAH",44,1,3,0)="OIL,RABBIT MEAT as a food allergy allergies to the GMR ALLERGIES file "
^DIC(9.4,9,22,4,"PAH",44,1,4,0)="(#120.82). This new food allergy must be added to the routine FHSELA2 "
^DIC(9.4,9,22,4,"PAH",44,1,5,0)="in order to be mapped as allergy type food preference dislikes in the "
^DIC(9.4,9,22,4,"PAH",44,1,6,0)="Dietetics package."
^DIC(9.4,9,22,4,"PAH",45,0)="43 SEQ #45^3190201.160628^54"
^DIC(9.4,9,22,4,"PAH",45,1,0)="^^1^1^3190201"
^DIC(9.4,9,22,4,"PAH",45,1,1,0)="DIETETICS"
^DIC(9.4,9,22,4,"PAH",46,0)="48 SEQ #46^3190501.150851^54"
^DIC(9.4,9,22,4,"PAH",46,1,0)="^^1^1^3190501"
^DIC(9.4,9,22,4,"PAH",46,1,1,0)="Adding new allergy type food dislike preferences to FHSELA2."
^DIC(9.4,9,22,4,"PAH",47,0)="49 SEQ #47^3190708.094228^65"
^DIC(9.4,9,22,4,"PAH",47,1,0)="^^4^4^3190708"
^DIC(9.4,9,22,4,"PAH",47,1,1,0)="This patch will address the issue of INC3751127:"
^DIC(9.4,9,22,4,"PAH",47,1,2,0)="The IA for Adverse Reaction API GMRADPT is missing from routine FHCLN. "
^DIC(9.4,9,22,4,"PAH",47,1,3,0)="Routine FHCLN is using an obsolete API call for Adverse Recation API"
^DIC(9.4,9,22,4,"PAH",47,1,4,0)="GMRADPT."
^DIC(9.4,9,22,4,"PAH",48,0)="51 SEQ #48^3190827.091734^65"
^DIC(9.4,9,22,4,"PAH",48,1,0)="^^2^2^3190827"
^DIC(9.4,9,22,4,"PAH",48,1,1,0)="This patch will address the addition of a new Drug/Food allergy by adding "
^DIC(9.4,9,22,4,"PAH",48,1,2,0)="CHRYSANTHEMUM to the mapping capability for food preference dislikes."
^DIC(9.4,9,22,4,"PAH",49,0)="52 SEQ #49^3191211.133855^65"
^DIC(9.4,9,22,4,"PAH",49,1,0)="^^7^7^3191211"
^DIC(9.4,9,22,4,"PAH",49,1,1,0)="This patch will address the following issues;"
^DIC(9.4,9,22,4,"PAH",49,1,2,0)="1. It will add RAW APPLES and RAW CHERRIES to the Create/Map Food"
^DIC(9.4,9,22,4,"PAH",49,1,3,0)="Prefernces to Allergies option."
^DIC(9.4,9,22,4,"PAH",49,1,4,0)=" "
^DIC(9.4,9,22,4,"PAH",49,1,5,0)="2. It will correct an <UNDEFINED> variable error in routine FHOMPG1 when "
^DIC(9.4,9,22,4,"PAH",49,1,6,0)="the user up arrows out of selecting either a Production Facility or "
^DIC(9.4,9,22,4,"PAH",49,1,7,0)="Communication Office."
^DIC(9.4,9,22,4,"PAH",50,0)="55 SEQ #50^3231016.142856^89"
^DIC(9.4,9,22,4,"PAH",50,1,0)="^^94^94^3231016"
^DIC(9.4,9,22,4,"PAH",50,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,9,22,4,"PAH",50,1,2,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,3,0)="ALERT FOR WRONG PATIENT DISPLAYS WHEN ACCESSING VIEW ALERTS "
^DIC(9.4,9,22,4,"PAH",50,1,4,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,5,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,6,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,7,0)="Associated ticket(s):"
^DIC(9.4,9,22,4,"PAH",50,1,8,0)="====================="
^DIC(9.4,9,22,4,"PAH",50,1,9,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,10,0)="1.      INC22357619- ALERT FOR WRONG PATIENT DISPLAYS WHEN ACCESSING VIEW "
^DIC(9.4,9,22,4,"PAH",50,1,11,0)="ALERTS"
^DIC(9.4,9,22,4,"PAH",50,1,12,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,13,0)="Associated NSR(s):"
^DIC(9.4,9,22,4,"PAH",50,1,14,0)="=================="
^DIC(9.4,9,22,4,"PAH",50,1,15,0)="N/A"
^DIC(9.4,9,22,4,"PAH",50,1,16,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,17,0)="Participating Test Sites:"
^DIC(9.4,9,22,4,"PAH",50,1,18,0)="========================="
^DIC(9.4,9,22,4,"PAH",50,1,19,0)="TBD"
^DIC(9.4,9,22,4,"PAH",50,1,20,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,21,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,22,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,9,22,4,"PAH",50,1,23,0)="==========================================="
^DIC(9.4,9,22,4,"PAH",50,1,24,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,25,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,26,0)="1. INC22357619 - ALERT FOR WRONG PATIENT DISPLAYS IN VIEW ALERTS"
^DIC(9.4,9,22,4,"PAH",50,1,27,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,28,0)="   Problem:"
^DIC(9.4,9,22,4,"PAH",50,1,29,0)="   -------"
^DIC(9.4,9,22,4,"PAH",50,1,30,0)="Alert for wrong patient displayed when accessing View Alerts and an alert "
^DIC(9.4,9,22,4,"PAH",50,1,31,0)="displayed for a different patient when using View Alert.  This issue was "
^DIC(9.4,9,22,4,"PAH",50,1,32,0)="reviewed by the Kernel team and their findings were that the application "
^DIC(9.4,9,22,4,"PAH",50,1,33,0)="is creating an incorrect Package identifier (four comma pieces instead of "
^DIC(9.4,9,22,4,"PAH",50,1,34,0)="three), so that when the application processes the alert, the patient id "
^DIC(9.4,9,22,4,"PAH",50,1,35,0)="or notification id are incorrectly referenced. This was found to be due "
^DIC(9.4,9,22,4,"PAH",50,1,36,0)="to the Package identifier being created using $H which itself contains a "
^DIC(9.4,9,22,4,"PAH",50,1,37,0)="comma."
^DIC(9.4,9,22,4,"PAH",50,1,38,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,39,0)="   Resolution:"
^DIC(9.4,9,22,4,"PAH",50,1,40,0)="   ----------"
^DIC(9.4,9,22,4,"PAH",50,1,41,0)="The use of $H to create the Package identifier does allow the creation of "
^DIC(9.4,9,22,4,"PAH",50,1,42,0)="a unique identifier but causes problems due to the extra comma.  This "
^DIC(9.4,9,22,4,"PAH",50,1,43,0)="patch will modify FH routines to modify the package id sent to kernel to "
^DIC(9.4,9,22,4,"PAH",50,1,44,0)="conform with kernel documentation.  Kernel 8.0 & Kernel Toolkit 7.3"
^DIC(9.4,9,22,4,"PAH",50,1,45,0)="Developer's Guide documents the package id as follows:"
^DIC(9.4,9,22,4,"PAH",50,1,46,0)="Paragraph 3.2.1 - The software application identifier for an alert is "
^DIC(9.4,9,22,4,"PAH",50,1,47,0)="defined as the original value of the XQAID input variable when the alert "
^DIC(9.4,9,22,4,"PAH",50,1,48,0)="is created via the SETUP^XQALERT: Send Alerts API. Typically, the "
^DIC(9.4,9,22,4,"PAH",50,1,49,0)="software application identifier should begin with the software "
^DIC(9.4,9,22,4,"PAH",50,1,50,0)="application namespace."
^DIC(9.4,9,22,4,"PAH",50,1,51,0)="Paragraph 3.3 - The Computerized Patient Record System (CPRS) software "
^DIC(9.4,9,22,4,"PAH",50,1,52,0)="uses a convention for the format of the software application identifier "
^DIC(9.4,9,22,4,"PAH",50,1,53,0)="consisting of three comma-delimited pieces:"
^DIC(9.4,9,22,4,"PAH",50,1,54,0)="namespace_"",""_dfn_"",""_notificationcode"
^DIC(9.4,9,22,4,"PAH",50,1,55,0)="Where:"
^DIC(9.4,9,22,4,"PAH",50,1,56,0)="   - namespace is the software application namespace."
^DIC(9.4,9,22,4,"PAH",50,1,57,0)="   - dfn is the internal entry number of the patient whom the alert "
^DIC(9.4,9,22,4,"PAH",50,1,58,0)="     concerns in the PATIENT (#2) file."
^DIC(9.4,9,22,4,"PAH",50,1,59,0)="   - notificationcode is a code maintained by the CPRS software "
^DIC(9.4,9,22,4,"PAH",50,1,60,0)="     describing the type of alert."
^DIC(9.4,9,22,4,"PAH",50,1,61,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,62,0)="Prior to this patch the XQAID variable passed to kernel was created as "
^DIC(9.4,9,22,4,"PAH",50,1,63,0)="""FH,""_$J_"",""_$H ($J is the vista job# for the task & $H is mumps "
^DIC(9.4,9,22,4,"PAH",50,1,64,0)="date/time)"
^DIC(9.4,9,22,4,"PAH",50,1,65,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,66,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,67,0)="   Technical Resolution:"
^DIC(9.4,9,22,4,"PAH",50,1,68,0)="   --------------------"
^DIC(9.4,9,22,4,"PAH",50,1,69,0)="The setting of XQAID in routines ALRT^FHCTF5, ALRT^FHASM2A, PHA^FHASM2A "
^DIC(9.4,9,22,4,"PAH",50,1,70,0)="and FIL^FHWTRN is changed to use the patient's DFN as the 2nd comma piece "
^DIC(9.4,9,22,4,"PAH",50,1,71,0)="and a number identifying the FH alert type in the 3rd piece."
^DIC(9.4,9,22,4,"PAH",50,1,72,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,73,0)="""FH,""_DFN_"",""_TYPE"
^DIC(9.4,9,22,4,"PAH",50,1,74,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,75,0)="The types are as follows"
^DIC(9.4,9,22,4,"PAH",50,1,76,0)="1 = Food/drug interaction alert"
^DIC(9.4,9,22,4,"PAH",50,1,77,0)="2 = Nutrition Patient assessment alert"
^DIC(9.4,9,22,4,"PAH",50,1,78,0)="3 = Monitor BMI alert"
^DIC(9.4,9,22,4,"PAH",50,1,79,0)="4 = Monitor Tubefeed alert"
^DIC(9.4,9,22,4,"PAH",50,1,80,0)="5 = Monitor Hyperals alert"
^DIC(9.4,9,22,4,"PAH",50,1,81,0)="6 = Monitor Albumin alert"
^DIC(9.4,9,22,4,"PAH",50,1,82,0)="7 = Monitor NPO+Clr alert"
^DIC(9.4,9,22,4,"PAH",50,1,83,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,84,0)="The TYPE is set into the variable FHCODE in routines FHWTRN & FHCTF5 for "
^DIC(9.4,9,22,4,"PAH",50,1,85,0)="each type of alert."
^DIC(9.4,9,22,4,"PAH",50,1,86,0)="During analysis it was also found that routines FHWTRN & FHCTF5 were "
^DIC(9.4,9,22,4,"PAH",50,1,87,0)="passing in FHCTF2 as the entry point for processing the alert but did not "
^DIC(9.4,9,22,4,"PAH",50,1,88,0)="include a routine name for processing, therefore the alert is deleted "
^DIC(9.4,9,22,4,"PAH",50,1,89,0)="which I believe is correct because these alerts I believe are meant to be "
^DIC(9.4,9,22,4,"PAH",50,1,90,0)="informational.  Setting an entry point should not have been done and both "
^DIC(9.4,9,22,4,"PAH",50,1,91,0)="entry point and routine should not be set. "
^DIC(9.4,9,22,4,"PAH",50,1,92,0)=" "
^DIC(9.4,9,22,4,"PAH",50,1,93,0)="This patch comments out the code S XQAOPT=""FHCTF2"" at FIL+11^FHWTRN and "
^DIC(9.4,9,22,4,"PAH",50,1,94,0)="ALRT+9^FHCTF5."
