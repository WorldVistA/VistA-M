^DIC(9.4,3,22,21,"PAH",517,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",517,1,5,0)="See the Patch Description for XU*8*690 in the Forum Patch Module for"
^DIC(9.4,3,22,21,"PAH",517,1,6,0)="complete details."
^DIC(9.4,3,22,21,"PAH",518,0)="705 SEQ #548^3190201.125219^54"
^DIC(9.4,3,22,21,"PAH",518,1,0)="^^3^3^3190201"
^DIC(9.4,3,22,21,"PAH",518,1,1,0)="KERNEL VISTA ENHANCEMENTS - MVI NEW PERSON STAT REPORT"
^DIC(9.4,3,22,21,"PAH",518,1,2,0)="Refer to patch XU*8.0*705 in the FORUM Patch Module for a complete"
^DIC(9.4,3,22,21,"PAH",518,1,3,0)="description."
^DIC(9.4,3,22,21,"PAH",519,0)="703 SEQ #549^3190301.155321^54"
^DIC(9.4,3,22,21,"PAH",519,1,0)="^^4^4^3190301"
^DIC(9.4,3,22,21,"PAH",519,1,1,0)="Patch XU*8.0*703 corrects issues found in patch XU*8.0*679 and "
^DIC(9.4,3,22,21,"PAH",519,1,2,0)="reported in tickets INC2380289 and INC2422028. The input transform for "
^DIC(9.4,3,22,21,"PAH",519,1,3,0)="the NEW PERSON file (#200) DEGREE field (10.6) and the NAME COMPONENT "
^DIC(9.4,3,22,21,"PAH",519,1,4,0)="file (#20) DEGREE field (6) were modified and routine XUSESIG3."
^DIC(9.4,3,22,21,"PAH",520,0)="693 SEQ #550^3190722.165628^65"
^DIC(9.4,3,22,21,"PAH",520,1,0)="^^3^3^3190722"
^DIC(9.4,3,22,21,"PAH",520,1,1,0)="Kernel patch XU*8*693.  "
^DIC(9.4,3,22,21,"PAH",520,1,2,0)="This patch edits Bulletins."
^DIC(9.4,3,22,21,"PAH",520,1,3,0)="Please refer to the description in Forum Patch Module for details."
^DIC(9.4,3,22,21,"PAH",521,0)="711 SEQ #551^3190723.110052^65"
^DIC(9.4,3,22,21,"PAH",521,1,0)="^^3^3^3190723"
^DIC(9.4,3,22,21,"PAH",521,1,1,0)="KERNEL VISTA ENHANCEMENTS - PPMS PIE SUPPORT"
^DIC(9.4,3,22,21,"PAH",521,1,2,0)="Refer to patch XU*8.0*711 in the FORUM Patch Module for a complete"
^DIC(9.4,3,22,21,"PAH",521,1,3,0)="description."
^DIC(9.4,3,22,21,"PAH",522,0)="661^3190815.16234^65"
^DIC(9.4,3,22,21,"PAH",522,1,0)="^^143^143^3190815"
^DIC(9.4,3,22,21,"PAH",522,1,1,0)="Subject:  Update %ZOSF to support SACWG changes"
^DIC(9.4,3,22,21,"PAH",522,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,3,0)="Category:  DATA DICTIONARY"
^DIC(9.4,3,22,21,"PAH",522,1,4,0)="           ROUTINE"
^DIC(9.4,3,22,21,"PAH",522,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,7,0)="Description:"
^DIC(9.4,3,22,21,"PAH",522,1,8,0)="==========="
^DIC(9.4,3,22,21,"PAH",522,1,9,0)="This patch supports the change of the SAC for longer Tags and Routine"
^DIC(9.4,3,22,21,"PAH",522,1,10,0)="names.  It increases the length from 8 to 16 characters.  "
^DIC(9.4,3,22,21,"PAH",522,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,12,0)="This patch also makes several changes to the ZOSFONT routine, but only"
^DIC(9.4,3,22,21,"PAH",522,1,13,0)="the ^%ZOSF(""TEST"") node will be set."
^DIC(9.4,3,22,21,"PAH",522,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,15,0)="The routine ZOSFONT has the following changes:"
^DIC(9.4,3,22,21,"PAH",522,1,16,0)="       1.      A new tag, NOASK, allows the setup of the %ZOSF global without"
^DIC(9.4,3,22,21,"PAH",522,1,17,0)="                 user interaction."
^DIC(9.4,3,22,21,"PAH",522,1,18,0)="       2.      A new tag, ONE(X) allows the setup of a single node in the"
^DIC(9.4,3,22,21,"PAH",522,1,19,0)="                %ZOSF global.  This allows this patch to update just"
^DIC(9.4,3,22,21,"PAH",522,1,20,0)="                %ZOSF(""TEST"")."
^DIC(9.4,3,22,21,"PAH",522,1,21,0)="       3.      There is now a short description for each %ZOSF node in the"
^DIC(9.4,3,22,21,"PAH",522,1,22,0)="                text."
^DIC(9.4,3,22,21,"PAH",522,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",522,1,24,0)="There are 2 changes to the ^%ZOSF global:"
^DIC(9.4,3,22,21,"PAH",522,1,25,0)="  1. The node ^%ZOSF(""TEST"") is changed, the checking of routine pattern has"
^DIC(9.4,3,22,21,"PAH",522,1,26,0)="    been removed.  It is changed from"
^DIC(9.4,3,22,21,"PAH",522,1,27,0)="     I X?1(1""""%"""",1A).7AN,$D(^$ROUTINE(X)) to"
^DIC(9.4,3,22,21,"PAH",522,1,28,0)="     I X]"""",$D(^$ROUTINE(X))."
^DIC(9.4,3,22,21,"PAH",522,1,29,0)="  2. The node ^%ZOSF(""GSEL;Select Globals"") is deleted.  This node"
^DIC(9.4,3,22,21,"PAH",522,1,30,0)="     was incorrectly defined in patch XU*8*365.  Patch 365 was"
^DIC(9.4,3,22,21,"PAH",522,1,31,0)="     suppose to set the ^%ZOSF(""GSEL"") global, but mistakenly set the wrong"
^DIC(9.4,3,22,21,"PAH",522,1,32,0)="     global node."
^DIC(9.4,3,22,21,"PAH",522,1,33,0)="                       "
^DIC(9.4,3,22,21,"PAH",522,1,34,0)="The post install routine XU8P661 cleans up the ^%ZOSF global."
^DIC(9.4,3,22,21,"PAH",522,1,35,0)="       1. The node ^%ZOSF(""GSEL;Select Globals"") is deleted"
^DIC(9.4,3,22,21,"PAH",522,1,36,0)="       2. Sets node ^%ZOSF(""TEST"")"
^DIC(9.4,3,22,21,"PAH",522,1,37,0)=" "
