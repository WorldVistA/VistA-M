^DIC(9.4,49,22,10,"PAH",670,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",670,1,7,0)=" "
^DIC(9.4,49,22,10,"PAH",670,1,8,0)="  "
^DIC(9.4,49,22,10,"PAH",670,1,9,0)="    Rate Type                 Dispensing Fee"
