^DIC(9.4,82,"VERSION")="2.0"
^DIC(9.4,83,0)="CONTROLLED SUBSTANCES^PSD^Controlled Substances Inventory and Tracking module."
^DIC(9.4,83,1,0)="^^3^3^2931018^^^^"
^DIC(9.4,83,1,1,0)="The Controlled Substances module provides functionality to monitor"
^DIC(9.4,83,1,2,0)="and track the receipt, inventory, and dispensing of all controlled"
^DIC(9.4,83,1,3,0)="substances."
^DIC(9.4,83,4,0)="^9.44PA^16^14"
