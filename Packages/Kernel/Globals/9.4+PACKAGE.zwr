^DIC(9.4,140,22,20,"PAH",8,1,59,0)="  Installation"
^DIC(9.4,140,22,20,"PAH",8,1,60,0)="  ========================"
^DIC(9.4,140,22,20,"PAH",8,1,61,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,62,0)="  1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,140,22,20,"PAH",8,1,63,0)=" option will load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",8,1,64,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,65,0)=" 2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,140,22,20,"PAH",8,1,66,0)="system.  You need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",8,1,67,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,68,0)="  3.  From the 'Installation' menu, use the checksums 'in the"
^DIC(9.4,140,22,20,"PAH",8,1,69,0)="  Transport Global' and verify that all routines have the correct checksum."
^DIC(9.4,140,22,20,"PAH",8,1,70,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,71,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,72,0)="  4. On the KIDS menu, under the 'Installation' menu, use the option"
^DIC(9.4,140,22,20,"PAH",8,1,73,0)="  'Install Package(s)'. Select the package 'RMPR*3.0*19' and proceed with"
^DIC(9.4,140,22,20,"PAH",8,1,74,0)="  installation."
^DIC(9.4,140,22,20,"PAH",8,1,75,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,76,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,77,0)="Routine Information:"
^DIC(9.4,140,22,20,"PAH",8,1,78,0)="===================="
^DIC(9.4,140,22,20,"PAH",8,1,79,0)=" RMPR4LI   value = 7635778"
^DIC(9.4,140,22,20,"PAH",8,1,80,0)=" RMPR4P21  value = 17560908"
^DIC(9.4,140,22,20,"PAH",8,1,81,0)=" RMPRED6   value = 24363847"
^DIC(9.4,140,22,20,"PAH",8,1,82,0)=" RMPRHIS   value = 8052646"
^DIC(9.4,140,22,20,"PAH",8,1,83,0)=" RMPRHISD  value = 7536482"
^DIC(9.4,140,22,20,"PAH",8,1,84,0)=" RMPRL9    value = 15221017"
^DIC(9.4,140,22,20,"PAH",8,1,85,0)=" RMPRLI    value = 6867549"
^DIC(9.4,140,22,20,"PAH",8,1,86,0)=" RMPRP21   value = 18656811"
^DIC(9.4,140,22,20,"PAH",8,1,87,0)=" RMPRSTK   value = 14899657"
^DIC(9.4,140,22,20,"PAH",9,0)="21^2961207^1"
^DIC(9.4,140,22,20,"PAH",9,1,0)="^^38^38^2961207"
^DIC(9.4,140,22,20,"PAH",9,1,1,0)="This is a fix for patch RMPR*3*19, and should only be loaded after patch "
^DIC(9.4,140,22,20,"PAH",9,1,2,0)="RMPR*3*19."
^DIC(9.4,140,22,20,"PAH",9,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,4,0)="This patch will remove the offending DIC(""W"") from routine RMPRSTK."
^DIC(9.4,140,22,20,"PAH",9,1,5,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,6,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,7,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,8,0)="Patch Dependencies"
^DIC(9.4,140,22,20,"PAH",9,1,9,0)="------------------"
^DIC(9.4,140,22,20,"PAH",9,1,10,0)="The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",9,1,11,0)="RMPR*3*19"
^DIC(9.4,140,22,20,"PAH",9,1,12,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,13,0)="Installation Overview"
^DIC(9.4,140,22,20,"PAH",9,1,14,0)=" ---------------------"
^DIC(9.4,140,22,20,"PAH",9,1,15,0)="No Prosthetics users should be on the system."
^DIC(9.4,140,22,20,"PAH",9,1,16,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,17,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",9,1,18,0)="------------"
^DIC(9.4,140,22,20,"PAH",9,1,19,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",9,1,20,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,21,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,22,0)="Installation"
^DIC(9.4,140,22,20,"PAH",9,1,23,0)="------------"
^DIC(9.4,140,22,20,"PAH",9,1,24,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,25,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option l"
^DIC(9.4,140,22,20,"PAH",9,1,26,0)="load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",9,1,27,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,28,0)="2. The patch has now been loaded into a Transport global on your system. You"
^DIC(9.4,140,22,20,"PAH",9,1,29,0)="now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",9,1,30,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,31,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums 'in the"
^DIC(9.4,140,22,20,"PAH",9,1,32,0)="Transport Global' and verify that all routines have the correct checksum."
^DIC(9.4,140,22,20,"PAH",9,1,33,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,34,0)="4. On the KIDS menu, under the 'Installation' menu, use the option 'Install"
^DIC(9.4,140,22,20,"PAH",9,1,35,0)="Package(s)'. Select the package 'RMPR*3.0*21' and proceed with installation."
^DIC(9.4,140,22,20,"PAH",9,1,36,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,37,0)=" "
^DIC(9.4,140,22,20,"PAH",9,1,38,0)="RMPRSTK   value = 14878864"
^DIC(9.4,140,22,20,"PAH",10,0)="20 SEQ #19^2970107^1"
^DIC(9.4,140,22,20,"PAH",10,1,0)="^^85^85^2970107"
^DIC(9.4,140,22,20,"PAH",10,1,1,0)="This patch contains NEW functionality to interface the Prosthetics "
^DIC(9.4,140,22,20,"PAH",10,1,2,0)="Purchase Card Module to IFCAP."
^DIC(9.4,140,22,20,"PAH",10,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,4,0)="This new functionality will eliminate the need for Prosthetic "
^DIC(9.4,140,22,20,"PAH",10,1,5,0)="Purchasing Agents to enter both Prosthetic and IFCAP purchase card "
^DIC(9.4,140,22,20,"PAH",10,1,6,0)="orders. After this patch is installed, users will remain in the "
^DIC(9.4,140,22,20,"PAH",10,1,7,0)="Prosthetic options to create and cancel orders without going into the "
^DIC(9.4,140,22,20,"PAH",10,1,8,0)="IFCAP purchase card order options. The Prosthetic Purchase Card "
^DIC(9.4,140,22,20,"PAH",10,1,9,0)="orders will be assigned purchase order numbers using the IFCAP common "
^DIC(9.4,140,22,20,"PAH",10,1,10,0)="number series.  Both Prosthetic and IFCAP purchase card orders will "
^DIC(9.4,140,22,20,"PAH",10,1,11,0)="have the same purchase order numbers."
^DIC(9.4,140,22,20,"PAH",10,1,12,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,13,0)="This patch is an enormous time saver for Prosthetic users, by "
^DIC(9.4,140,22,20,"PAH",10,1,14,0)="eliminating the need for duplication of order input into both IFCAP "
^DIC(9.4,140,22,20,"PAH",10,1,15,0)="and Prosthetics.  This patch provides the Interface between IFCAP and "
^DIC(9.4,140,22,20,"PAH",10,1,16,0)="Prosthetics. "
^DIC(9.4,140,22,20,"PAH",10,1,17,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,18,0)="This patch also addresses the problems from the following NOIS "
^DIC(9.4,140,22,20,"PAH",10,1,19,0)="reports:"
^DIC(9.4,140,22,20,"PAH",10,1,20,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,21,0)="     NOIS"
^DIC(9.4,140,22,20,"PAH",10,1,22,0)="---------------"
^DIC(9.4,140,22,20,"PAH",10,1,23,0)=" STX-0996-70100"
^DIC(9.4,140,22,20,"PAH",10,1,24,0)=" DAY-0896-41319"
^DIC(9.4,140,22,20,"PAH",10,1,25,0)=" DAY-0896-41131"
^DIC(9.4,140,22,20,"PAH",10,1,26,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,27,0)=" Mail Message:"
^DIC(9.4,140,22,20,"PAH",10,1,28,0)=" 22635364"
^DIC(9.4,140,22,20,"PAH",10,1,29,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,30,0)="Patch Dependencies"
^DIC(9.4,140,22,20,"PAH",10,1,31,0)="------------------"
^DIC(9.4,140,22,20,"PAH",10,1,32,0)="The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",10,1,33,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,34,0)="PRC*5*107"
