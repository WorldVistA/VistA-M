^DIC(9.4,47,22,5.9,"PAH",188,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",189,0)="316 SEQ #266^3000905^1"
^DIC(9.4,47,22,5.9,"PAH",189,1,0)="^^3^3^3000905"
^DIC(9.4,47,22,5.9,"PAH",189,1,1,0)="TREATING FACILITY LIST"
^DIC(9.4,47,22,5.9,"PAH",189,1,2,0)="Refer to patch DG*5.3*316 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",189,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",190,0)="296 SEQ #267^3000907^1"
^DIC(9.4,47,22,5.9,"PAH",191,0)="285 SEQ #268^3001004^1"
^DIC(9.4,47,22,5.9,"PAH",191,1,0)="^^1^1^3001004"
^DIC(9.4,47,22,5.9,"PAH",191,1,1,0)="Please see Natinal Patch Module for details."
^DIC(9.4,47,22,5.9,"PAH",192,0)="315 SEQ #269^3001004^1"
^DIC(9.4,47,22,5.9,"PAH",192,1,0)="^^2^2^3001004"
^DIC(9.4,47,22,5.9,"PAH",192,1,1,0)="This patch updates the PTF Census Dates (#45.86) file with the dates for "
^DIC(9.4,47,22,5.9,"PAH",192,1,2,0)="the 4rd quarter PTF census."
^DIC(9.4,47,22,5.9,"PAH",193,0)="307 SEQ #270^3001004^1"
^DIC(9.4,47,22,5.9,"PAH",193,1,0)="^^3^3^3001004"
^DIC(9.4,47,22,5.9,"PAH",193,1,1,0)="EXCEPTION MESSAGES / PATIENT DATA REVIEW"
^DIC(9.4,47,22,5.9,"PAH",193,1,2,0)="Refer to patch DG*5.3*307 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",193,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",194,0)="290 SEQ #271^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",194,1,0)="^^2^2^3001027"
^DIC(9.4,47,22,5.9,"PAH",194,1,1,0)="Please see DG*5.3*290 in the National Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",194,1,2,0)="description."
^DIC(9.4,47,22,5.9,"PAH",195,0)="289 SEQ #272^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",195,1,0)="^^3^3^3001027"
^DIC(9.4,47,22,5.9,"PAH",195,1,1,0)="This patch is a clean up to follow patch DG*5.3*267.  It will correct the "
^DIC(9.4,47,22,5.9,"PAH",195,1,2,0)="problems of where a previous income years test was made non primary after "
^DIC(9.4,47,22,5.9,"PAH",195,1,3,0)="a future test became active for the current income year."
^DIC(9.4,47,22,5.9,"PAH",196,0)="306 SEQ #273^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",197,0)="309 SEQ #274^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",197,1,0)="^^12^12^3001027"
^DIC(9.4,47,22,5.9,"PAH",197,1,1,0)="This API returns an array of data from the Patient Treatment"
^DIC(9.4,47,22,5.9,"PAH",197,1,2,0)="file (#45).  It can also be done as a Remote Procedure call"
^DIC(9.4,47,22,5.9,"PAH",197,1,3,0)="(in the Remote Procedure file #8994, see DG PATIENT TREATMENT DATA)."
^DIC(9.4,47,22,5.9,"PAH",197,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",197,1,5,0)="The call is to RPC^DGPTFAPI(RESULTS,PTFNUMBR) where RESULTS is the"
^DIC(9.4,47,22,5.9,"PAH",197,1,6,0)="array passed by reference, and PTFNUMBR is the IFN of the Patient"
^DIC(9.4,47,22,5.9,"PAH",197,1,7,0)="Treatment file.  Currently, the data returned is:"
^DIC(9.4,47,22,5.9,"PAH",197,1,8,0)="  RESULTS(0)=1 or -1 if an error occured"
^DIC(9.4,47,22,5.9,"PAH",197,1,9,0)="         (1)=type of disposition^place of disposition^1st ICD9 code"
^DIC(9.4,47,22,5.9,"PAH",197,1,10,0)="         (2)=2nd thru 10th ICD9 codes"
^DIC(9.4,47,22,5.9,"PAH",197,1,11,0)=" "
^DIC(9.4,47,22,5.9,"PAH",197,1,12,0)="Integration Agreements #3157(API) and #3164 (RPC) have been obtained."
^DIC(9.4,47,22,5.9,"PAH",198,0)="242 SEQ #275^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",198,1,0)="^^1^1^3001027"
^DIC(9.4,47,22,5.9,"PAH",198,1,1,0)="To address several miscellaneous Treating Specialty, IRT and VADPT NOISs."
^DIC(9.4,47,22,5.9,"PAH",199,0)="293 SEQ #276^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",199,1,0)="^^2^2^3001027"
^DIC(9.4,47,22,5.9,"PAH",199,1,1,0)="Extract patient address information from a list of social security"
^DIC(9.4,47,22,5.9,"PAH",199,1,2,0)="numbers."
^DIC(9.4,47,22,5.9,"PAH",200,0)="325 SEQ #277^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",200,1,0)="^^4^4^3001027"
^DIC(9.4,47,22,5.9,"PAH",200,1,1,0)="This patch is being distributed as part of the National implementation of"
^DIC(9.4,47,22,5.9,"PAH",200,1,2,0)="the 1010EZ web initiative.  This initiative allows a veteran to enter and"
^DIC(9.4,47,22,5.9,"PAH",200,1,3,0)="submit an enrollment application through an online 1010EZ form to their"
^DIC(9.4,47,22,5.9,"PAH",200,1,4,0)="preferred VAH medical facility.  "
^DIC(9.4,47,22,5.9,"PAH",201,0)="212 SEQ #278^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",201,1,0)="^^5^5^3001027"
^DIC(9.4,47,22,5.9,"PAH",201,1,1,0)="This patch provides an API to determine if a patient's treating specialty"
^DIC(9.4,47,22,5.9,"PAH",201,1,2,0)="for a specified movement or date/time is or was an observation specialty."
^DIC(9.4,47,22,5.9,"PAH",201,1,3,0)="Routine DGPMOBS provides three entry points:  MVT, PT and SPEC."
^DIC(9.4,47,22,5.9,"PAH",201,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",201,1,5,0)="Please see NPM patch description for complete documentation."
^DIC(9.4,47,22,5.9,"PAH",202,0)="305 SEQ #279^3001027^1"
^DIC(9.4,47,22,5.9,"PAH",202,1,0)="^^1^1^3001027"
^DIC(9.4,47,22,5.9,"PAH",202,1,1,0)="Please refer to patch number DG*5.3*305."
^DIC(9.4,47,22,5.9,"PAH",203,0)="310 SEQ #280^3001106^1"
^DIC(9.4,47,22,5.9,"PAH",203,1,0)="^^3^3^3001106"
^DIC(9.4,47,22,5.9,"PAH",203,1,1,0)="This patch is designed to correct the message that is received when the "
^DIC(9.4,47,22,5.9,"PAH",203,1,2,0)="facility received is not found during the processing of incoming HL7"
^DIC(9.4,47,22,5.9,"PAH",203,1,3,0)="messages."
^DIC(9.4,47,22,5.9,"PAH",204,0)="300 SEQ #281^3001106^1"
^DIC(9.4,47,22,5.9,"PAH",204,1,0)="^^1^1^3001106"
^DIC(9.4,47,22,5.9,"PAH",204,1,1,0)="Fix 1010F printing problems"
