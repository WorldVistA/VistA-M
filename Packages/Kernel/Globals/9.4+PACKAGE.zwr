^DIC(9.4,14,22,5.9,"PAH",116,1,81,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",116,1,82,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",116,1,83,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",116,1,84,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",116,1,85,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",116,1,86,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,87,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",116,1,88,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",116,1,89,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",116,1,90,0)="   LR280            N/A            4831435        280 (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",116,1,91,0)="   LR7OU641         12410597       12157260       153,201,278,280"
^DIC(9.4,14,22,5.9,"PAH",116,1,92,0)="   LRLNC0           14797379       15016901       215,232,278,280"
^DIC(9.4,14,22,5.9,"PAH",116,1,93,0)="   LRLNCC           2637694        2634007        232,280"
^DIC(9.4,14,22,5.9,"PAH",116,1,94,0)="   LRLNCMD          6826367        6815286        232,278,280"
^DIC(9.4,14,22,5.9,"PAH",116,1,95,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,96,0)=" List of preceding patches: 232,278"
^DIC(9.4,14,22,5.9,"PAH",116,1,97,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",116,1,98,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,99,0)="  "
^DIC(9.4,14,22,5.9,"PAH",116,1,100,0)="************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",116,1,101,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,102,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",116,1,103,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",116,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,105,0)="  The install time for this patch is less than 2 minutes. This patch"
^DIC(9.4,14,22,5.9,"PAH",116,1,106,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",116,1,107,0)="  Suggested time to install: Off peak hours."
^DIC(9.4,14,22,5.9,"PAH",116,1,108,0)="  The install will disable a Lab option as specified in #7 below."
^DIC(9.4,14,22,5.9,"PAH",116,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,110,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,111,0)="NOTE: Kernel patches must be current on the target system"
^DIC(9.4,14,22,5.9,"PAH",116,1,112,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",116,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,114,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",116,1,115,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",116,1,116,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,118,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",116,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,120,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",116,1,121,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",116,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,123,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",116,1,124,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",116,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,126,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",116,1,127,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",116,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,129,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",116,1,130,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",116,1,131,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,132,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",116,1,133,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",116,1,134,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",116,1,135,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",116,1,136,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",116,1,137,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,138,0)="      If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,14,22,5.9,"PAH",116,1,139,0)="      patch prior to installation, you should use the 'Backup a Transport"
^DIC(9.4,14,22,5.9,"PAH",116,1,140,0)="      Global' option at this time.  You may also compare the routines in"
^DIC(9.4,14,22,5.9,"PAH",116,1,141,0)="      your production account to the routines in the patch by using the"
^DIC(9.4,14,22,5.9,"PAH",116,1,142,0)="      'Compare a Transport Global to Current System' option."
^DIC(9.4,14,22,5.9,"PAH",116,1,143,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,144,0)="  7.  The install will disable the following Lab option during patch"
^DIC(9.4,14,22,5.9,"PAH",116,1,145,0)="      installation."
^DIC(9.4,14,22,5.9,"PAH",116,1,146,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,147,0)="         Link Result NLT Manual [LR7O MAN RESULT NLT]"
^DIC(9.4,14,22,5.9,"PAH",116,1,148,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,149,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",116,1,150,0)="      and select the package 'LR*5.2*280'."
^DIC(9.4,14,22,5.9,"PAH",116,1,151,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,152,0)="      When prompted ' Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",116,1,153,0)="      Install? YES//' choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",116,1,154,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,155,0)="      Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,14,22,5.9,"PAH",116,1,156,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,157,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",116,1,158,0)="      Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",116,1,159,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,160,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",116,1,161,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,162,0)=" 10. Routine LR280 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",116,1,163,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,164,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,165,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",116,1,166,0)="==============================="
^DIC(9.4,14,22,5.9,"PAH",116,1,167,0)="None"
^DIC(9.4,14,22,5.9,"PAH",116,1,168,0)=" "
^DIC(9.4,14,22,5.9,"PAH",116,1,169,0)=" "
