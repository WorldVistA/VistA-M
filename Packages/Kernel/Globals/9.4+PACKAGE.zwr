^DIC(9.4,35,22,3,"PAH",431,0)="533 SEQ #443^3200824.161108^65"
^DIC(9.4,35,22,3,"PAH",431,1,0)="^^1^1^3200824"
^DIC(9.4,35,22,3,"PAH",431,1,1,0)="Please see the NPM on FORUM for the description."
^DIC(9.4,35,22,3,"PAH",432,0)="521 SEQ #446^3200923.152821^65"
^DIC(9.4,35,22,3,"PAH",432,1,0)="^^1^1^3200923"
^DIC(9.4,35,22,3,"PAH",432,1,1,0)="ORDER DETAILS DISPLAYING INCORRECT DRUG"
^DIC(9.4,35,22,3,"PAH",433,0)="413^3200923.154341^65"
^DIC(9.4,35,22,3,"PAH",434,0)="530 SEQ #449^3200923.161907^65"
^DIC(9.4,35,22,3,"PAH",434,1,0)="^^5^5^3200923"
^DIC(9.4,35,22,3,"PAH",434,1,1,0)="In CPRS, in the Current Order view of the Orders tab a clinical medication"
^DIC(9.4,35,22,3,"PAH",434,1,2,0)="order that is placed using a quick order and is subsequently edited by"
^DIC(9.4,35,22,3,"PAH",434,1,3,0)="changing the drug name, is displayed with a status of dc/edit. This status"
^DIC(9.4,35,22,3,"PAH",434,1,4,0)="should not display as the Current Order view should only be displaying"
^DIC(9.4,35,22,3,"PAH",434,1,5,0)="order statuses of active or pending."
^DIC(9.4,35,22,3,"PAH",435,0)="527 SEQ #445^3200923.164041^65"
^DIC(9.4,35,22,3,"PAH",435,1,0)="^^132^132^3200923"
^DIC(9.4,35,22,3,"PAH",435,1,1,0)="This patch is being released in conjunction with VBEC 2.3.2 Rev F. "
^DIC(9.4,35,22,3,"PAH",435,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",435,1,3,0)="A full description of patch changes and implementation process are "
^DIC(9.4,35,22,3,"PAH",435,1,4,0)="included in the VBECS 2.3.2 Rev F Release Notes."
^DIC(9.4,35,22,3,"PAH",435,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",435,1,6,0)="The Test and Production accounts will be installed separately. There is "
^DIC(9.4,35,22,3,"PAH",435,1,7,0)="no downtime associated with this patch installation. Refer to the VBECS "
^DIC(9.4,35,22,3,"PAH",435,1,8,0)="2.3.2 Rev F Release Notes for further installation details."
^DIC(9.4,35,22,3,"PAH",435,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",435,1,10,0)="Items addressed in VBECS 2.3.2 Rev F are listed in the VistA Blood "
^DIC(9.4,35,22,3,"PAH",435,1,11,0)="Establishment Computer Software (VBECS) 2.3.2 Rev F Release Notes."
^DIC(9.4,35,22,3,"PAH",435,1,12,0)=" "
