^DIC(9.4,3,22,21,"PAH",586,0)="774 SEQ #618^3221214.134346^89"
^DIC(9.4,3,22,21,"PAH",586,1,0)="^^2^2^3221214"
^DIC(9.4,3,22,21,"PAH",586,1,1,0)="XU*8.0*774 - FIXES THE NPI REPORT. Please refer the patch description on"
^DIC(9.4,3,22,21,"PAH",586,1,2,0)="the National Patch Module (NPM) for more detail informtion."
^DIC(9.4,3,22,21,"PAH",587,0)="777 SEQ #620^3230228.124541^89"
^DIC(9.4,3,22,21,"PAH",587,1,0)="^^15^15^3230228"
^DIC(9.4,3,22,21,"PAH",587,1,1,0)="KERNEL patch XU*8*777 - FIX OPTION [XQAL USER ALERTS COUNT]"
^DIC(9.4,3,22,21,"PAH",587,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",587,1,3,0)="This patch fixes the ""Undefined SERVICE/SECTION Err"" in the option User "
^DIC(9.4,3,22,21,"PAH",587,1,4,0)="Alerts Count Report [XQAL USER ALERTS COUNT]."
^DIC(9.4,3,22,21,"PAH",587,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",587,1,6,0)=" This option is used to generate a report on users who have more than a"
^DIC(9.4,3,22,21,"PAH",587,1,7,0)="specified number of alerts in the ALERTS file (#8992).  The report covers"
^DIC(9.4,3,22,21,"PAH",587,1,8,0)="a specified range of dates, and can be sorted by user name, number of"
^DIC(9.4,3,22,21,"PAH",587,1,9,0)="alerts, or by service/section.  In addition, the report in each of these "
^DIC(9.4,3,22,21,"PAH",587,1,10,0)="formats may be generated by Divisions if desired.  "
^DIC(9.4,3,22,21,"PAH",587,1,11,0)="  "
^DIC(9.4,3,22,21,"PAH",587,1,12,0)=" For each user who has the specified number of alerts or more, the report "
^DIC(9.4,3,22,21,"PAH",587,1,13,0)="includes the user name, the section/service for the user, the number of "
^DIC(9.4,3,22,21,"PAH",587,1,14,0)="alerts in the ALERTS file, the last sign-on date, the number of Critical"
^DIC(9.4,3,22,21,"PAH",587,1,15,0)="alerts or Abnormal Imaging alerts, and the date of the oldest alert."
^DIC(9.4,3,22,21,"PAH",588,0)="778 SEQ #621^3230228.124636^89"
^DIC(9.4,3,22,21,"PAH",588,1,0)="^^1^1^3230228"
^DIC(9.4,3,22,21,"PAH",588,1,1,0)="Please see Patch Description on Forum"
