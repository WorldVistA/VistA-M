^DIC(9.4,60,22,13,"PAH",273,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,90,0)="712885         AMOXICILLIN TRIHYDRATE 250MG CAP   A    90  11/06/08   11/06/08"
^DIC(9.4,60,22,13,"PAH",273,1,91,0)="               SIG: TAKE ONE CAPSULE BY MOUTH THREE TIMES A DAY"
^DIC(9.4,60,22,13,"PAH",273,1,92,0)="               PROVIDER: PSOPROVIDER,ONE"
^DIC(9.4,60,22,13,"PAH",273,1,93,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,94,0)="712886         DILTIAZEM (INWOOD) 240MG CAP,SA    A    30  11/28/08   11/28/08"
^DIC(9.4,60,22,13,"PAH",273,1,95,0)="               SIG: TAKE ONE CAPSULE BY MOUTH EVERY DAY"
^DIC(9.4,60,22,13,"PAH",273,1,96,0)="               PROVIDER: PSOPROVIDER,ONE"
^DIC(9.4,60,22,13,"PAH",273,1,97,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,98,0)="712887         SIMVASTATIN 20MG TAB               A    15  12/09/08   12/09/08"
^DIC(9.4,60,22,13,"PAH",273,1,99,0)="               SIG: TAKE ONE-HALF TABLET BY MOUTH EVERY EVENING TESTING"
^DIC(9.4,60,22,13,"PAH",273,1,100,0)="                    FOR PATTESTING FOR PATIENT TESTING FOR PATTESTING"
^DIC(9.4,60,22,13,"PAH",273,1,101,0)="                    FOR PATIENTENT INTRUCT ION ON SIG1 TESTING FOR"
^DIC(9.4,60,22,13,"PAH",273,1,102,0)="                    PATIENT INTRUCTION ON SIG1 TESTING FOR PATIENT"
^DIC(9.4,60,22,13,"PAH",273,1,103,0)="                    REPLACE IENT WITH IENT TESTING FOR PATIENT"
^DIC(9.4,60,22,13,"PAH",273,1,104,0)="                    INTRUCTION ON SIG1 TESTING FOR PATI"
^DIC(9.4,60,22,13,"PAH",273,1,105,0)="               PROVIDER: PSOPROVIDER,ONE"
^DIC(9.4,60,22,13,"PAH",273,1,106,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,107,0)="5. In the Pull Early from Suspense [PSO PNDRX] and Print from Suspense"
^DIC(9.4,60,22,13,"PAH",273,1,108,0)="   File [PSO PNDLBL] options, if the patient has remote prescriptions, then"
^DIC(9.4,60,22,13,"PAH",273,1,109,0)="   the text ""THIS PATIENT HAS PRESCRIPTIONS AT OTHER FACILITIES"" will be"
^DIC(9.4,60,22,13,"PAH",273,1,110,0)="   displayed on the report as shown in the following example."
^DIC(9.4,60,22,13,"PAH",273,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,112,0)="                     PRESCRIPTION PROFILE AS OF 12/30/2008"
^DIC(9.4,60,22,13,"PAH",273,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,114,0)="                        NAME: PSOPATIENT,ONE"
^DIC(9.4,60,22,13,"PAH",273,1,115,0)="                        ID# : 000-00-0000"
^DIC(9.4,60,22,13,"PAH",273,1,116,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,117,0)="   THIS PATIENT HAS PRESCRIPTIONS AT OTHER FACILITIES"
^DIC(9.4,60,22,13,"PAH",273,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,119,0)="                        PHARMACIST: __________________  DATE: ________"
^DIC(9.4,60,22,13,"PAH",273,1,120,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,121,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,123,0)="6. Three new protocols were added: PSO RDI VISITS MENU, PSO RDI BOTH, and"
^DIC(9.4,60,22,13,"PAH",273,1,124,0)="   PSO RDI REMOTE."
^DIC(9.4,60,22,13,"PAH",273,1,125,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,126,0)="7. Two new list templates were added: PSO RDI VISITS and PSO RDI VISITS"
^DIC(9.4,60,22,13,"PAH",273,1,127,0)="   DETAIL."
^DIC(9.4,60,22,13,"PAH",273,1,128,0)=""
^DIC(9.4,60,22,13,"PAH",273,1,129,0)=""
^DIC(9.4,60,22,13,"PAH",273,1,130,0)=""
^DIC(9.4,60,22,13,"PAH",274,0)="322 SEQ #282^3090924.104837^17"
^DIC(9.4,60,22,13,"PAH",274,1,0)="^^3^3^3090924"
^DIC(9.4,60,22,13,"PAH",274,1,1,0)="1. Undefined error in routine PSOATRF."
^DIC(9.4,60,22,13,"PAH",274,1,2,0)="2. DUZ variable being reset."
^DIC(9.4,60,22,13,"PAH",274,1,3,0)="3. Replace direct call to data dictionary with Pharmacy API"
^DIC(9.4,60,22,13,"PAH",275,0)="326 SEQ #283^3091130.135947^17"
^DIC(9.4,60,22,13,"PAH",275,1,0)="^^45^45^3091130"
^DIC(9.4,60,22,13,"PAH",275,1,1,0)="The FY09 Q1 Enhancement Release is related to PSI-07-090 (PSPO #543) and"
^DIC(9.4,60,22,13,"PAH",275,1,2,0)="Remedy Ticket #189923. The Social Security Number (SSN) was removed from"
^DIC(9.4,60,22,13,"PAH",275,1,3,0)="the print out given to the patient from the following options."
^DIC(9.4,60,22,13,"PAH",275,1,4,0)="  Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE]"
^DIC(9.4,60,22,13,"PAH",275,1,5,0)="  Medication Profile [PSO P]"
^DIC(9.4,60,22,13,"PAH",275,1,6,0)="  Printing/Reprinting prescription labels using these options:"
^DIC(9.4,60,22,13,"PAH",275,1,7,0)="    Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",275,1,8,0)="     - ListMan hidden action (RP)  - Reprint (OP)"
^DIC(9.4,60,22,13,"PAH",275,1,9,0)="     - ListMan hidden action (OTH) - MI Print Medication Instructions"
^DIC(9.4,60,22,13,"PAH",275,1,10,0)="                                    (addressed in patch PSN*4*181)"
^DIC(9.4,60,22,13,"PAH",275,1,11,0)="    Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",275,1,12,0)="    Pull Early from Suspense [PSO PNDRX]"
^DIC(9.4,60,22,13,"PAH",275,1,13,0)="    Print from Suspense File [PSO PNDLBL]"
^DIC(9.4,60,22,13,"PAH",275,1,14,0)="     - 5 Standard Print from Suspense"
^DIC(9.4,60,22,13,"PAH",275,1,15,0)="    Reprint a non-voided Outpatient Rx Label [PSO SCRIPTALK REPRINT"
^DIC(9.4,60,22,13,"PAH",275,1,16,0)="                                              VISTA LB]    "
^DIC(9.4,60,22,13,"PAH",275,1,17,0)="    Queue ScripTalk Label by Barcode [PSO SCRIPTALK MANUAL INTERNAL]"
^DIC(9.4,60,22,13,"PAH",275,1,18,0)="    Queue ScripTalk Label by Rx# [PSO SCRIPTALK MANUAL EXTERNAL] "
^DIC(9.4,60,22,13,"PAH",275,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",275,1,20,0)="Additionally, the ability to lookup by prescription number or wand a"
^DIC(9.4,60,22,13,"PAH",275,1,21,0)="barcode with the prescription was added to the patient lookup prompt on"
^DIC(9.4,60,22,13,"PAH",275,1,22,0)="the following options."
^DIC(9.4,60,22,13,"PAH",275,1,23,0)="  Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",275,1,24,0)="  Medication Profile [PSO P]"
^DIC(9.4,60,22,13,"PAH",275,1,25,0)="  Rx (Prescriptions) [PSO RX]"
^DIC(9.4,60,22,13,"PAH",275,1,26,0)="  Update Patient Record [PSO PAT]"
^DIC(9.4,60,22,13,"PAH",275,1,27,0)="  Manual Print of Multi-Rx Forms [PSO LM MULTI-RX PRINT]"
^DIC(9.4,60,22,13,"PAH",275,1,28,0)="  ScripTalk Patient Enter/Edit [PSO SCRIPTALK PATIENT ENROLL]"
^DIC(9.4,60,22,13,"PAH",275,1,29,0)="  Patient Address Changes Report [PSO ADDRESS CHANGE REPORT]"
^DIC(9.4,60,22,13,"PAH",275,1,30,0)="  List Prescriptions Not Mailed [PSO BAI NOT MAILED]"
^DIC(9.4,60,22,13,"PAH",275,1,31,0)="  Non-VA Meds Usage Report [PSO NON-VA MEDS USAGE REPORT]"
^DIC(9.4,60,22,13,"PAH",275,1,32,0)="  Enter New Patient [PSO BINGO NEW PATIENT]"
^DIC(9.4,60,22,13,"PAH",275,1,33,0)="  Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE]"
^DIC(9.4,60,22,13,"PAH",275,1,34,0)="  Poly Pharmacy Report [PSOPOLY]."
^DIC(9.4,60,22,13,"PAH",275,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",275,1,36,0)="The help text for patient lookup was modified and will display the"
^DIC(9.4,60,22,13,"PAH",275,1,37,0)="following."
^DIC(9.4,60,22,13,"PAH",275,1,38,0)="  Enter the prescription number prefixed by a # (ex. #XXXXXXX) or"
^DIC(9.4,60,22,13,"PAH",275,1,39,0)="  Wand the barcode of the prescription. The format of the barcode is"
^DIC(9.4,60,22,13,"PAH",275,1,40,0)="  NNN-NNNNNNN where the first 3 digits are your station number."
^DIC(9.4,60,22,13,"PAH",275,1,41,0)="            - OR -"
^DIC(9.4,60,22,13,"PAH",275,1,42,0)="  Answer with PATIENT NAME, or SOCIAL SECURITY NUMBER, or last 4 digits"
^DIC(9.4,60,22,13,"PAH",275,1,43,0)="  of SOCIAL SECURITY NUMBER, or first initial of last name with last 4"
^DIC(9.4,60,22,13,"PAH",275,1,44,0)="  digits of SOCIAL SECURITY NUMBER"
^DIC(9.4,60,22,13,"PAH",275,1,45,0)="  Do you want the entire NNNNNNNN-Entry PATIENT List?"
^DIC(9.4,60,22,13,"PAH",276,0)="308 SEQ #284^3091203.09072^17"
^DIC(9.4,60,22,13,"PAH",276,1,0)="^^3^3^3091203"
^DIC(9.4,60,22,13,"PAH",276,1,1,0)="This patch will fix an error that is caused by a long provider comment "
^DIC(9.4,60,22,13,"PAH",276,1,2,0)="(more than 32 characters with no spaces) that is entered in CPRS and"
^DIC(9.4,60,22,13,"PAH",276,1,3,0)="copied when the pending order is processed in Outpatient Pharmacy."
^DIC(9.4,60,22,13,"PAH",277,0)="321 SEQ #285^3100121.171206^17"
^DIC(9.4,60,22,13,"PAH",277,1,0)="^^2^2^3100121"
^DIC(9.4,60,22,13,"PAH",277,1,1,0)="This patch will resolve the issue where another patient's "
^DIC(9.4,60,22,13,"PAH",277,1,2,0)="prescription is printing on the label log."
^DIC(9.4,60,22,13,"PAH",278,0)="327 SEQ #286^3100128.14481^17"
^DIC(9.4,60,22,13,"PAH",278,1,0)="^^1^1^3100128"
^DIC(9.4,60,22,13,"PAH",278,1,1,0)="CARRIAGE RETURNS IN HL7 MESSAGES SENT TO HDR"
^DIC(9.4,60,22,13,"PAH",279,0)="324 SEQ #288^3100217.104821^17"
^DIC(9.4,60,22,13,"PAH",279,1,0)="^^83^83^3100217"
^DIC(9.4,60,22,13,"PAH",279,1,1,0)="The FY09 Q3 Enhancement Release includes the following."
^DIC(9.4,60,22,13,"PAH",279,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,3,0)="1. PSI-07-134 (PSPO #771) - Remedy Ticket # HD200301/HD217962"
^DIC(9.4,60,22,13,"PAH",279,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,5,0)="In Outpatient Pharmacy during order entry when there is no allergy"
^DIC(9.4,60,22,13,"PAH",279,1,6,0)="assessment on file for a patient, the user will be given the ability to"
^DIC(9.4,60,22,13,"PAH",279,1,7,0)="duplicate the allergy intervention data filed for the last drug."
^DIC(9.4,60,22,13,"PAH",279,1,8,0)="In order to provide this functionality, during subsequent allergy"
^DIC(9.4,60,22,13,"PAH",279,1,9,0)="intervention, this patch will now prompt"
^DIC(9.4,60,22,13,"PAH",279,1,10,0)="""No Allergy Assessment - Do you want to duplicate Intervention? Yes//"""
^DIC(9.4,60,22,13,"PAH",279,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,12,0)="If the answer is ""No,"" then it will prompt for a new intervention."
^DIC(9.4,60,22,13,"PAH",279,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,14,0)="If the answer is ""Yes,"" then it will display the last intervention"
^DIC(9.4,60,22,13,"PAH",279,1,15,0)="entered. The following is an example."
^DIC(9.4,60,22,13,"PAH",279,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,17,0)="INTERVENTION DATE: DEC 11, 2008       PATIENT: PSOPAT,NAME"
^DIC(9.4,60,22,13,"PAH",279,1,18,0)="PROVIDER: PSOPROV, NAME               PHARMACIST: PSOPHARM, NAME"
^DIC(9.4,60,22,13,"PAH",279,1,19,0)="DRUG: ""current order drug name""       INSTITUTED BY: PHARMACY"
^DIC(9.4,60,22,13,"PAH",279,1,20,0)="INTERVENTION: ALLERGY                 RECOMMENDATION: OTHER"
^DIC(9.4,60,22,13,"PAH",279,1,21,0)="ORIGINATING PACKAGE: OUTPATIENT       DIVISION: OKLAHOMA CITY VAMC"
^DIC(9.4,60,22,13,"PAH",279,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,23,0)="Would you like to edit this Intervention? No//"
^DIC(9.4,60,22,13,"PAH",279,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,25,0)="If ""No,"" then the system accepts the intervention and continues."
^DIC(9.4,60,22,13,"PAH",279,1,26,0)="If ""Yes,"" then the system allows editing of the intervention."
^DIC(9.4,60,22,13,"PAH",279,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,29,0)="2. PSI-07-181 (PSPO# 865) - Remedy Ticket # HD208961"
^DIC(9.4,60,22,13,"PAH",279,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,31,0)="A prescription's strength was changed in Computerized Patient Record"
^DIC(9.4,60,22,13,"PAH",279,1,32,0)="System V. 1.0 (CPRS) creating a new Rx. The original Rx had been"
^DIC(9.4,60,22,13,"PAH",279,1,33,0)="transmitted to Consolidated Mail Outpatient Pharmacy (CMOP) on the"
^DIC(9.4,60,22,13,"PAH",279,1,34,0)="previous day. When finishing, the pharmacist missed the previous day's"
^DIC(9.4,60,22,13,"PAH",279,1,35,0)="transmission to CMOP of the original prescription. Both Rxs were mailed"
^DIC(9.4,60,22,13,"PAH",279,1,36,0)="to the patient in the same package from the CMOP."
^DIC(9.4,60,22,13,"PAH",279,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,38,0)="When a CMOP prescription with a status of Transmitted or Retransmitted is"
^DIC(9.4,60,22,13,"PAH",279,1,39,0)="discontinued by a background process to the Outpatient Pharmacy options,"
^DIC(9.4,60,22,13,"PAH",279,1,40,0)="e.g. CPRS or Registration V. 5.3 packages, then an email notifying that a"
^DIC(9.4,60,22,13,"PAH",279,1,41,0)="prescription was just discontinued for that Rx will be sent to the new PSX"
^DIC(9.4,60,22,13,"PAH",279,1,42,0)="EXTERNAL DISPENSE ALERTS mail group created by patch PSX*2*68 (see"
^DIC(9.4,60,22,13,"PAH",279,1,43,0)="PSX*2*68 patch description for details). If no recipients are defined in"
^DIC(9.4,60,22,13,"PAH",279,1,44,0)="the new mail group, then it will be sent to PSXCMOPMGR key holders. The"
^DIC(9.4,60,22,13,"PAH",279,1,45,0)="email alert will inform the group that the CMOP status for the Rx just"
^DIC(9.4,60,22,13,"PAH",279,1,46,0)="discontinued was either Transmitted or Retransmitted as seen in the"
^DIC(9.4,60,22,13,"PAH",279,1,47,0)="example below."
^DIC(9.4,60,22,13,"PAH",279,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,49,0)="  Subj: TROY - DC Alert on CMOP Rx 123456789 TRANSMITTED  [#90494]"
^DIC(9.4,60,22,13,"PAH",279,1,50,0)="  03/03/09@17:37 8 lines"
^DIC(9.4,60,22,13,"PAH",279,1,51,0)="  From: POSTMASTER  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",279,1,52,0)="  ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",279,1,53,0)="               Rx #: 123456789   Fill: 0"
^DIC(9.4,60,22,13,"PAH",279,1,54,0)="            Patient: OUTPATIENT,DCONE (6660)"
^DIC(9.4,60,22,13,"PAH",279,1,55,0)="               Drug: TAMOXIFEN CITRATE 10MG TABS"
^DIC(9.4,60,22,13,"PAH",279,1,56,0)="          Rx Status: DISCONTINUED BY PROVIDER"
^DIC(9.4,60,22,13,"PAH",279,1,57,0)="  Processing Status: TRANSMITTED to CMOP on 02/27/09"
^DIC(9.4,60,22,13,"PAH",279,1,58,0)="           Provider: OPPROVIDER, PROV"
^DIC(9.4,60,22,13,"PAH",279,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,60,0)="  ********    Please contact CMOP or take appropriate action    ********"
^DIC(9.4,60,22,13,"PAH",279,1,61,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,62,0)="  Enter message action (in IN basket): Ignore//"
^DIC(9.4,60,22,13,"PAH",279,1,63,0)="  ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",279,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,65,0)="When a CMOP prescription with a status of Transmitted or Retransmitted is"
^DIC(9.4,60,22,13,"PAH",279,1,66,0)="discontinued by a foreground Pharmacy process due to a duplicate drug"
^DIC(9.4,60,22,13,"PAH",279,1,67,0)="scenario that would trigger the duplicate to be discontinued, then the"
^DIC(9.4,60,22,13,"PAH",279,1,68,0)="Processing Status field of the duplicate drug message is highlighted to"
^DIC(9.4,60,22,13,"PAH",279,1,69,0)="alert the user. Below is an example."
^DIC(9.4,60,22,13,"PAH",279,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,71,0)="  ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",279,1,72,0)="  Duplicate Drug A AND Z OINTMENT in Prescription: 123456789"
^DIC(9.4,60,22,13,"PAH",279,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,74,0)="                    Status: Active                       Issued: 03/03/09"
^DIC(9.4,60,22,13,"PAH",279,1,75,0)="<<BOLD>> Processing Status: Transmitted to CMOP on 03/04/09 <<BOLD>>"
^DIC(9.4,60,22,13,"PAH",279,1,76,0)="                       SIG: APPLY 1 TUBE TO AFFECTED AREA TWICE A DAY"
^DIC(9.4,60,22,13,"PAH",279,1,77,0)="                       QTY: 1                         # of refills: 5"
^DIC(9.4,60,22,13,"PAH",279,1,78,0)="                  Provider: OPPROVIDER, PROV     Refills remaining: 5"
^DIC(9.4,60,22,13,"PAH",279,1,79,0)="                                                Last filled on: 03/04/09"
^DIC(9.4,60,22,13,"PAH",279,1,80,0)="                                                   Days Supply: 5"
^DIC(9.4,60,22,13,"PAH",279,1,81,0)="  ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",279,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",279,1,83,0)="Discontinue RX # 123456789?"
^DIC(9.4,60,22,13,"PAH",280,0)="337 SEQ #289^3100223.162506^17"
^DIC(9.4,60,22,13,"PAH",280,1,0)="^^3^3^3100223"
^DIC(9.4,60,22,13,"PAH",280,1,1,0)="In the Batch Barcode option a non-pharmacist can renew a prescription "
^DIC(9.4,60,22,13,"PAH",280,1,2,0)="without a pharmacist review.  "
^DIC(9.4,60,22,13,"PAH",280,1,3,0)="The Refill option works fine."
^DIC(9.4,60,22,13,"PAH",281,0)="335 SEQ #290^3100331.105641^17"
^DIC(9.4,60,22,13,"PAH",281,1,0)="^^1^1^3100331"
^DIC(9.4,60,22,13,"PAH",281,1,1,0)="PROBLEMS WITH PSO INTERNET REFILL REPORT"
^DIC(9.4,60,22,13,"PAH",282,0)="338 SEQ #291^3100405.143744^17"
^DIC(9.4,60,22,13,"PAH",282,1,0)="^^31^31^3100405"
^DIC(9.4,60,22,13,"PAH",282,1,1,0)="The FY10 Q1 Enhancement Release includes the following."
^DIC(9.4,60,22,13,"PAH",282,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",282,1,3,0)="1. PSPO #1167"
^DIC(9.4,60,22,13,"PAH",282,1,4,0)="   The following enhancements were made for the Flagged Pending Orders."
^DIC(9.4,60,22,13,"PAH",282,1,5,0)="   a. When using the Complete Orders from OERR [PSO LMOE FINISH] option,"
^DIC(9.4,60,22,13,"PAH",282,1,6,0)="      the message ""<There are ## flagged orders for INSTITUTION>"" is"
^DIC(9.4,60,22,13,"PAH",282,1,7,0)="      displayed in reverse video to alert the user that there are"
^DIC(9.4,60,22,13,"PAH",282,1,8,0)="      flagged pending orders."
^DIC(9.4,60,22,13,"PAH",282,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",282,1,10,0)="   b. At the prompt, ""Select By:  (PA/RT/PR/CL/FL/E): PATIENT//"", the help"
^DIC(9.4,60,22,13,"PAH",282,1,11,0)="      text ""FL FLAG"" was changed to ""FL FLAGGED""."
^DIC(9.4,60,22,13,"PAH",282,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",282,1,13,0)="2. PSPO #1101 - Remedy Ticket #275487"
^DIC(9.4,60,22,13,"PAH",282,1,14,0)="   The following enhancements were made to the prescription laser label."
^DIC(9.4,60,22,13,"PAH",282,1,15,0)="   a. The current title ""Additional Warning Labels"" that is printed at"
^DIC(9.4,60,22,13,"PAH",282,1,16,0)="      the top of the PMI section was renamed to ""Additional Warnings""."
^DIC(9.4,60,22,13,"PAH",282,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",282,1,18,0)="   b. If the warning label is lengthy, requiring more than the four"
^DIC(9.4,60,22,13,"PAH",282,1,19,0)="      provided lines, the label is truncated so the text ""... See printed"
^DIC(9.4,60,22,13,"PAH",282,1,20,0)="      Additional Warnings."" can be added to the end of the fourth line."
^DIC(9.4,60,22,13,"PAH",282,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",282,1,22,0)="   c. The truncated warning label and its code are printed in their"
^DIC(9.4,60,22,13,"PAH",282,1,23,0)="      entirety at the top of the PMI section under the ""Additional"
^DIC(9.4,60,22,13,"PAH",282,1,24,0)="      Warnings"" section."
^DIC(9.4,60,22,13,"PAH",282,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",282,1,26,0)="3. Remedy Ticket #345084"
^DIC(9.4,60,22,13,"PAH",282,1,27,0)="   The warning message ""<There are ## flagged orders for INSTITUTION>"" is not"
^DIC(9.4,60,22,13,"PAH",282,1,28,0)="   displayed when there is only one associated CPRS ordering institution"
^DIC(9.4,60,22,13,"PAH",282,1,29,0)="   with an outpatient site. Routine PSOORFI2 was corrected to fix this"
^DIC(9.4,60,22,13,"PAH",282,1,30,0)="   problem."
^DIC(9.4,60,22,13,"PAH",282,1,31,0)=""
^DIC(9.4,60,22,13,"PAH",283,0)="312 SEQ #292^3100505.095201^17"
^DIC(9.4,60,22,13,"PAH",283,1,0)="^^4^4^3100505"
^DIC(9.4,60,22,13,"PAH",283,1,1,0)="This patch will modify the dispensing machine releasing so "
^DIC(9.4,60,22,13,"PAH",283,1,2,0)="the Message Server ID field (#10) of the Pharmacy External "
^DIC(9.4,60,22,13,"PAH",283,1,3,0)="Interface file (#52.51) does not get overwritten for previous "
^DIC(9.4,60,22,13,"PAH",283,1,4,0)="fills with the latest Message Server Id."
^DIC(9.4,60,22,13,"PAH",284,0)="298 SEQ #293^3100518.152325^17"
^DIC(9.4,60,22,13,"PAH",284,1,0)="^^6^6^3100518"
^DIC(9.4,60,22,13,"PAH",284,1,1,0)="This patch will correct the following issues"
^DIC(9.4,60,22,13,"PAH",284,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",284,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",284,1,4,0)="HD0000000206768 - Activity Log - Sig Edits"
^DIC(9.4,60,22,13,"PAH",284,1,5,0)="HD0000000219618 - Rx Fill Date Missing"
^DIC(9.4,60,22,13,"PAH",284,1,6,0)="HD0000000303117 - 2 ""Sorry  bout that.  $ZERROR="" error message"
^DIC(9.4,60,22,13,"PAH",285,0)="345 SEQ #294^3100520.103013^17"
^DIC(9.4,60,22,13,"PAH",285,1,0)="^^5^5^3100520"
^DIC(9.4,60,22,13,"PAH",285,1,1,0)="This patch will resolve the issue where the pharmacist is kicked out of "
^DIC(9.4,60,22,13,"PAH",285,1,2,0)="the system after they flag pending orders from a list of orders.  Added "
^DIC(9.4,60,22,13,"PAH",285,1,3,0)="to this is a fix for the Ignored Rejects Report [PSO IGNORED REJECTS "
^DIC(9.4,60,22,13,"PAH",285,1,4,0)="REPORT], where an error occurs if only one patient is selected in the "
^DIC(9.4,60,22,13,"PAH",285,1,5,0)="sorting option."
^DIC(9.4,60,22,13,"PAH",286,0)="347 SEQ #295^3100526.100129^17"
^DIC(9.4,60,22,13,"PAH",286,1,0)="^^2^2^3100526"
^DIC(9.4,60,22,13,"PAH",286,1,1,0)="This patch will resolve the Patient Safety issue (PSPO-1424)"
^DIC(9.4,60,22,13,"PAH",286,1,2,0)="where CMOP prescriptions are not suspending."
^DIC(9.4,60,22,13,"PAH",287,0)="336 SEQ #296^3100526.112645^17"
^DIC(9.4,60,22,13,"PAH",287,1,0)="^^5^5^3100526"
^DIC(9.4,60,22,13,"PAH",287,1,1,0)="A duplicate NTE 8 was inadvertently created via patch  PSO*7.0*305 to add "
^DIC(9.4,60,22,13,"PAH",287,1,2,0)="the VA Notice of Privacy Practices."
^DIC(9.4,60,22,13,"PAH",287,1,3,0)="If the patient has other language preference then the Spanish patient "
^DIC(9.4,60,22,13,"PAH",287,1,4,0)="instructions are already being sent in the"
^DIC(9.4,60,22,13,"PAH",287,1,5,0)="NTE 8 segment."
^DIC(9.4,60,22,13,"PAH",288,0)="341 SEQ #297^3100602.105109^17"
^DIC(9.4,60,22,13,"PAH",288,1,0)="^^4^4^3100602"
^DIC(9.4,60,22,13,"PAH",288,1,1,0)="This patch resolves an UNDEFINED error in routine PSO52PAI.  "
^DIC(9.4,60,22,13,"PAH",288,1,2,0)="This error occurred while users were loading IB patch IB*2*400."
^DIC(9.4,60,22,13,"PAH",288,1,3,0)="The error resulted from processing invalid ePharmacy data in"
^DIC(9.4,60,22,13,"PAH",288,1,4,0)="the Pharmacy file (#52)."
^DIC(9.4,60,22,13,"PAH",289,0)="334 SEQ #298^3100615.101141^17"
^DIC(9.4,60,22,13,"PAH",289,1,0)="^^1^1^3100615"
^DIC(9.4,60,22,13,"PAH",289,1,1,0)="This patch will fix the issue where multiple labels are printed."
^DIC(9.4,60,22,13,"PAH",290,0)="344 SEQ #299^3100713.123758^17"
^DIC(9.4,60,22,13,"PAH",290,1,0)="^^27^27^3100713"
^DIC(9.4,60,22,13,"PAH",290,1,1,0)="The Clinical Reminders Order Check project will introduce the"
^DIC(9.4,60,22,13,"PAH",290,1,2,0)="functionality for a site to create order checks using Clinical Reminder"
^DIC(9.4,60,22,13,"PAH",290,1,3,0)="Terms and Definitions. Additional data elements to be used in conditional"
^DIC(9.4,60,22,13,"PAH",290,1,4,0)="evaluation of those terms/definitions can only be provided by changes to"
^DIC(9.4,60,22,13,"PAH",290,1,5,0)="the Outpatient Pharmacy Application Program Interface (API), PSOPXRM1."
^DIC(9.4,60,22,13,"PAH",290,1,6,0)="This patch will add the following data elements to the array returned"
^DIC(9.4,60,22,13,"PAH",290,1,7,0)="by the API."
^DIC(9.4,60,22,13,"PAH",290,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",290,1,9,0)="From the PRESCRIPTION file (#52):"
^DIC(9.4,60,22,13,"PAH",290,1,10,0)="  ARRAY(""ISSUE DATE"")=ISSUE DATE field (#1)"
^DIC(9.4,60,22,13,"PAH",290,1,11,0)="  ARRAY(""PROVIDER"")=PROVIDER field (#4) (internal and external format)"
^DIC(9.4,60,22,13,"PAH",290,1,12,0)="  ARRAY(""CLINIC"")=CLINIC field (#5) (internal and external format)"
^DIC(9.4,60,22,13,"PAH",290,1,13,0)="  ARRAY(""DISPENSE DRUG"")=DRUG field (#6) (internal and external format)"
^DIC(9.4,60,22,13,"PAH",290,1,14,0)="  ARRAY(""PHARMACIST"")=PHARMACIST field (#23) (added external format)"
^DIC(9.4,60,22,13,"PAH",290,1,15,0)="  ARRAY(""LAST DISPENSED DATE"")=LAST DISPENSED DATE field (#101)"
^DIC(9.4,60,22,13,"PAH",290,1,16,0)="  ARRAY(""QTY"")=QTY field (#7)"
^DIC(9.4,60,22,13,"PAH",290,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",290,1,18,0)="From the REFILL sub-file (#52.1):"
^DIC(9.4,60,22,13,"PAH",290,1,19,0)="  ARRAY(""PHARMACIST"")=PHARMACIST NAME field (#4) (added external format)"
^DIC(9.4,60,22,13,"PAH",290,1,20,0)="  ARRAY(""QTY"")=QTY field (#1)"
^DIC(9.4,60,22,13,"PAH",290,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",290,1,22,0)="From the PARTIAL DATE sub-file (#52.2):"
^DIC(9.4,60,22,13,"PAH",290,1,23,0)="  ARRAY(""PHARMACIST"")=PHARMACIST NAME field (#.05) (added external format)"
^DIC(9.4,60,22,13,"PAH",290,1,24,0)="  ARRAY(""QTY"")=QTY field (#.04)"
^DIC(9.4,60,22,13,"PAH",290,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",290,1,26,0)="From the DRUG file (#50):"
^DIC(9.4,60,22,13,"PAH",290,1,27,0)="  ARRAY(""DEA SPECIAL HDLG"")=DEA, SPECIAL HDLG field (#3)"
^DIC(9.4,60,22,13,"PAH",291,0)="348 SEQ #300^3100716.092413^17"
^DIC(9.4,60,22,13,"PAH",291,1,0)="^^200^200^3100716"
^DIC(9.4,60,22,13,"PAH",291,1,1,0)="The FY10 Q2 Enhancement Release includes the following two enhancements."
^DIC(9.4,60,22,13,"PAH",291,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,3,0)="1. Canned Report for Outpatient Prescription Activity (NSR #20081114)"
^DIC(9.4,60,22,13,"PAH",291,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,5,0)="A new option named Prescription List for Drug Warnings [PSO RX LIST]"
^DIC(9.4,60,22,13,"PAH",291,1,6,0)="provides a report capable of identifying all patients that have "
^DIC(9.4,60,22,13,"PAH",291,1,7,0)="been dispensed a particular medication(s). This report was developed by"
^DIC(9.4,60,22,13,"PAH",291,1,8,0)="converting Class III functionality to a standardized, nationally released"
^DIC(9.4,60,22,13,"PAH",291,1,9,0)="report."
^DIC(9.4,60,22,13,"PAH",291,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,11,0)="This new option has been placed under the Output Reports [PSO OUTPUTS]"
^DIC(9.4,60,22,13,"PAH",291,1,12,0)="menu and uses a sort template PSO DRUG WARNINGS."
^DIC(9.4,60,22,13,"PAH",291,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,15,0)="Example of Input Prompts:"
^DIC(9.4,60,22,13,"PAH",291,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,17,0)="        **  To avoid undesired wrapping of the output data,   **"
^DIC(9.4,60,22,13,"PAH",291,1,18,0)="        **  please enter '0;256;999' at the 'DEVICE:' prompt. **"
^DIC(9.4,60,22,13,"PAH",291,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,21,0)="EXCLUDE DECEASED PATIENTS (Y/N) Y// ES"
^DIC(9.4,60,22,13,"PAH",291,1,22,0)="START WITH DIVISION: FIRST//"
^DIC(9.4,60,22,13,"PAH",291,1,23,0)="    START WITH DRUG: FIRST//"
^DIC(9.4,60,22,13,"PAH",291,1,24,0)="      * Previous selection: FINISH DATE/TIME from Oct 25,2009 to Oct "
^DIC(9.4,60,22,13,"PAH",291,1,25,0)="      27,2009@24:00"
^DIC(9.4,60,22,13,"PAH",291,1,26,0)="      START WITH FINISH DATE/TIME: Oct 25,2009//   (OCT 25, 2009)"
^DIC(9.4,60,22,13,"PAH",291,1,27,0)="      GO TO FINISH DATE/TIME: Oct 27,2009//   (OCT 27, 2009)"
^DIC(9.4,60,22,13,"PAH",291,1,28,0)="DEVICE:   GENERIC INCOMING TELNET"
^DIC(9.4,60,22,13,"PAH",291,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,31,0)="     Before continuing, please set up your terminal to capture the"
^DIC(9.4,60,22,13,"PAH",291,1,32,0)="     detailed report data. On some terminals, this can be done by"
^DIC(9.4,60,22,13,"PAH",291,1,33,0)="     clicking on the 'Tools' menu above, then click on 'Capture"
^DIC(9.4,60,22,13,"PAH",291,1,34,0)="     Incoming Data' to save to Desktop. This report may take a"
^DIC(9.4,60,22,13,"PAH",291,1,35,0)="     while to run."
^DIC(9.4,60,22,13,"PAH",291,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,37,0)="Press Return to Continue:"
^DIC(9.4,60,22,13,"PAH",291,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,39,0)="The report output will be generated by print templates PSO DRUG WARNINGS"
^DIC(9.4,60,22,13,"PAH",291,1,40,0)="and PSO DRUG WARNINGS HEADER in a delimited output format suitable for"
^DIC(9.4,60,22,13,"PAH",291,1,41,0)="export to Microsoft (MS) Excel. The report will contain patient"
^DIC(9.4,60,22,13,"PAH",291,1,42,0)="demographic and prescription information."
^DIC(9.4,60,22,13,"PAH",291,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,44,0)="Output Example:"
^DIC(9.4,60,22,13,"PAH",291,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,46,0)="\\^PATIENT^SSN^ADDRESS 1^ADDRESS 2^ADDRESS 3^CITY^STATE^ZIP^PHONE "
^DIC(9.4,60,22,13,"PAH",291,1,47,0)="(HOME)^PHONE (WORK)^PHONE (CELL)^DECEASED?^RX #^DRUG^FINISH D/T^QTY PER "
^DIC(9.4,60,22,13,"PAH",291,1,48,0)="DAY^STATUS^REF REM^PRO VIDER^LAST DISPENSED DATE^RETURNED TO STOCK?"
^DIC(9.4,60,22,13,"PAH",291,1,49,0)="\\^OUTPATNM,BARRY^666000198^1 SPRING ST^BLDG 2^APT 3^SPRINGFIELD^MO^65801^"
^DIC(9.4,60,22,13,"PAH",291,1,50,0)="456-6789^^^^301129^DOXEPIN 25MG CAP^03/22/07^1^DISCONTINUED^10^PHARMA,"
^DIC(9.4,60,22,13,"PAH",291,1,51,0)="OUTPT^04/12/07^"
^DIC(9.4,60,22,13,"PAH",291,1,52,0)="\\^TESTPATNM,MICHELLE^666000770^MAIN ST^^^CLEARWATER^FLORIDA^33762^"
^DIC(9.4,60,22,13,"PAH",291,1,53,0)="444-5532^345-1234^^^800024A^DOXEPIN 25MG CAP^02/14/07^2^DISCONTINUED^5^"
^DIC(9.4,60,22,13,"PAH",291,1,54,0)="^PHARMA,INPT^02/18/07^"
^DIC(9.4,60,22,13,"PAH",291,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,57,0)="2. Reports to Identify Patients/Prescriptions for Recall Notices "
^DIC(9.4,60,22,13,"PAH",291,1,58,0)="(NSR #20081115)"
^DIC(9.4,60,22,13,"PAH",291,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,60,0)="A new option called List of Patients/Prescriptions for Recall Notice [PSO"
^DIC(9.4,60,22,13,"PAH",291,1,61,0)="RECALL LIST] has been provided to identify prescriptions containing"
^DIC(9.4,60,22,13,"PAH",291,1,62,0)="medications associated with specific recall criteria, such as lot numbers"
^DIC(9.4,60,22,13,"PAH",291,1,63,0)="and/or National Drug Code (NDC) numbers."
^DIC(9.4,60,22,13,"PAH",291,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,65,0)="This new option has been placed under the Output Reports [PSO OUTPUTS]"
^DIC(9.4,60,22,13,"PAH",291,1,66,0)="menu and prompts the user for the following criteria: "
^DIC(9.4,60,22,13,"PAH",291,1,67,0)="    Division  "
^DIC(9.4,60,22,13,"PAH",291,1,68,0)="    Prescription Release Date Range"
^DIC(9.4,60,22,13,"PAH",291,1,69,0)="    Medication Identifier "
^DIC(9.4,60,22,13,"PAH",291,1,70,0)="    Inclusion/Exclusion of Deceased Patients"
^DIC(9.4,60,22,13,"PAH",291,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,72,0)="One of the following four medication identifiers may be selected:"
^DIC(9.4,60,22,13,"PAH",291,1,73,0)="  1-NDC code"
^DIC(9.4,60,22,13,"PAH",291,1,74,0)="  2-Dispense Drug and Lot #"
^DIC(9.4,60,22,13,"PAH",291,1,75,0)="  3-Dispense Drug only"
^DIC(9.4,60,22,13,"PAH",291,1,76,0)="  4-VA Generic Name"
^DIC(9.4,60,22,13,"PAH",291,1,77,0)="  5-Orderable Item"
^DIC(9.4,60,22,13,"PAH",291,1,78,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,80,0)="Example of input prompts:"
^DIC(9.4,60,22,13,"PAH",291,1,81,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,82,0)="You may select a single or multiple Divisions,"
^DIC(9.4,60,22,13,"PAH",291,1,83,0)="or enter ^ALL to select all Divisions."
^DIC(9.4,60,22,13,"PAH",291,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,85,0)="Division: ^ALL"
^DIC(9.4,60,22,13,"PAH",291,1,86,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,87,0)="From Release Date: T-90//  (JAN 20, 2010)"
^DIC(9.4,60,22,13,"PAH",291,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,89,0)="To Release Date: T//  (APR 20, 2010)"
^DIC(9.4,60,22,13,"PAH",291,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,91,0)="     Select one of the following:"
^DIC(9.4,60,22,13,"PAH",291,1,92,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,93,0)="          1         NDC"
^DIC(9.4,60,22,13,"PAH",291,1,94,0)="          2         DISPENSE DRUG AND LOT NUMBER"
^DIC(9.4,60,22,13,"PAH",291,1,95,0)="          3         DISPENSE DRUG"
^DIC(9.4,60,22,13,"PAH",291,1,96,0)="          4         VA GENERIC NAME"
^DIC(9.4,60,22,13,"PAH",291,1,97,0)="          5         ORDERABLE ITEM"
^DIC(9.4,60,22,13,"PAH",291,1,98,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,99,0)="Select 1-5 : 4  VA GENERIC NAME"
^DIC(9.4,60,22,13,"PAH",291,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,101,0)="VA Generic Name: PREDNISONE  "
^DIC(9.4,60,22,13,"PAH",291,1,102,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,103,0)="  Dispense Drugs"
^DIC(9.4,60,22,13,"PAH",291,1,104,0)="  ---------------"
^DIC(9.4,60,22,13,"PAH",291,1,105,0)="   1 - PREDNISONE 1MG TAB"
^DIC(9.4,60,22,13,"PAH",291,1,106,0)="   2 - PREDNISONE 5MG TAB"
^DIC(9.4,60,22,13,"PAH",291,1,107,0)="   3 - PREDNISONE 20MG S.T."
^DIC(9.4,60,22,13,"PAH",291,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,109,0)="Enter a list or range of numbers (1-3): 1-3"
^DIC(9.4,60,22,13,"PAH",291,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,111,0)="VA Generic Name: "
^DIC(9.4,60,22,13,"PAH",291,1,112,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,113,0)="Exclude Deceased Patients? YES// NO"
^DIC(9.4,60,22,13,"PAH",291,1,114,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,116,0)="        **  To avoid undesired wrapping of the output data,    **"
^DIC(9.4,60,22,13,"PAH",291,1,117,0)="        **  please enter '0;256;999' at the 'DEVICE:' prompt.  **"
^DIC(9.4,60,22,13,"PAH",291,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,119,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,120,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,121,0)="DEVICE: HOME// ;0;256;999  GENERIC INCOMING TELNET"
^DIC(9.4,60,22,13,"PAH",291,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,123,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,124,0)="     Before continuing, please set up your terminal to capture the"
^DIC(9.4,60,22,13,"PAH",291,1,125,0)="     detailed report data. On some terminals, this can be done by"
^DIC(9.4,60,22,13,"PAH",291,1,126,0)="     clicking on the 'Tools' menu above, then click on 'Capture"
^DIC(9.4,60,22,13,"PAH",291,1,127,0)="     Incoming Data' to save to Desktop. This report may take a"
^DIC(9.4,60,22,13,"PAH",291,1,128,0)="     while to run."
^DIC(9.4,60,22,13,"PAH",291,1,129,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,130,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,131,0)="Press Return to Continue: "
^DIC(9.4,60,22,13,"PAH",291,1,132,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,133,0)="The output of this report is in a delimited output format suitable for "
^DIC(9.4,60,22,13,"PAH",291,1,134,0)="export to MS Excel and includes data from original prescription fills,"
^DIC(9.4,60,22,13,"PAH",291,1,135,0)="refills and partial fills. The report output is sorted primarily by"
^DIC(9.4,60,22,13,"PAH",291,1,136,0)="patient name and secondarily by prescription number."
^DIC(9.4,60,22,13,"PAH",291,1,137,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,138,0)="Each fill of the prescription is printed on a separate line. Each "
^DIC(9.4,60,22,13,"PAH",291,1,139,0)="prescription detail line starts with a double backslash followed by an"
^DIC(9.4,60,22,13,"PAH",291,1,140,0)="identifier to denote the type of fill (ORIGINAL, REFILL, PARTIAL). "
^DIC(9.4,60,22,13,"PAH",291,1,141,0)="Each line contains 38 fields separated by up-arrow (""^"") as described "
^DIC(9.4,60,22,13,"PAH",291,1,142,0)="below:"
^DIC(9.4,60,22,13,"PAH",291,1,143,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,144,0)="   1. FILL TYPE (e.g.,\\ORIGINAL\)    2. RX #"
^DIC(9.4,60,22,13,"PAH",291,1,145,0)="   3. DRUG NAME                       4. PATIENT NAME"
^DIC(9.4,60,22,13,"PAH",291,1,146,0)="   5. SSN                             6. ADDRESS 1"
^DIC(9.4,60,22,13,"PAH",291,1,147,0)="   7. ADDRESS 2                       8. ADDRESS 3"
^DIC(9.4,60,22,13,"PAH",291,1,148,0)="   9. CITY                           10. STATE"
^DIC(9.4,60,22,13,"PAH",291,1,149,0)="  11. ZIP                            12. PHONE (HOME)"
^DIC(9.4,60,22,13,"PAH",291,1,150,0)="  13. PHONE (WORK)                   14. PHONE (CELL)"
^DIC(9.4,60,22,13,"PAH",291,1,151,0)="  15. DECEASED?                      16. FILL #"
^DIC(9.4,60,22,13,"PAH",291,1,152,0)="  17. ISSUE DATE                     18. FILL DATE"
^DIC(9.4,60,22,13,"PAH",291,1,153,0)="  19. RELEASED DATE/TIME             20. EXPIRATION DATE"
^DIC(9.4,60,22,13,"PAH",291,1,154,0)="  21. LOT #                          22. NDC"
^DIC(9.4,60,22,13,"PAH",291,1,155,0)="  23. DIVISION                       24. PHARMACIST"
^DIC(9.4,60,22,13,"PAH",291,1,156,0)="  25. PROVIDER                       26. PATIENT STATUS"
^DIC(9.4,60,22,13,"PAH",291,1,157,0)="  27. QTY                            28. DAYS SUPPLY"
^DIC(9.4,60,22,13,"PAH",291,1,158,0)="  29. # OF REFILLS                   30. MAIL/WINDOW"
^DIC(9.4,60,22,13,"PAH",291,1,159,0)="  31. CMOP?                          32. PARTIAL REMARKS"
^DIC(9.4,60,22,13,"PAH",291,1,160,0)="  33. TRANSMISSION NUMBER            34. SEQUENCE #"
^DIC(9.4,60,22,13,"PAH",291,1,161,0)="  35. CMOP NDC                       36. DATE SHIPPED"
^DIC(9.4,60,22,13,"PAH",291,1,162,0)="  37. CARRIER                        38. PACKAGE ID"
^DIC(9.4,60,22,13,"PAH",291,1,163,0)="  "
^DIC(9.4,60,22,13,"PAH",291,1,164,0)="Example of Output:"
^DIC(9.4,60,22,13,"PAH",291,1,165,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,166,0)="\\FILL TYPE\^RX #^DRUG NAME^PATIENT NAME^SSN^ADDRESS 1^ADDRESS 2^"
^DIC(9.4,60,22,13,"PAH",291,1,167,0)="ADDRESS 3^CITY^STATE^ZIP^PHONE (HOME)^PHONE (WORK)^PHONE (CELL)^"
^DIC(9.4,60,22,13,"PAH",291,1,168,0)="DECEASED?^FILL #^ISSUE DATE^FILL DATE^RELEASED DATE/TIME^EXPIRATION"
^DIC(9.4,60,22,13,"PAH",291,1,169,0)="DATE^LOT #^NDC^DIVISION^PHARMACIST^PROVIDER^PATIENT STATUS^QTY^DAYS"
^DIC(9.4,60,22,13,"PAH",291,1,170,0)="SUPPLY^# OF REFILLS^MAIL/WINDOW^CMOP?^PARTIAL REMARKS^TRANSMISSION"
^DIC(9.4,60,22,13,"PAH",291,1,171,0)="NUMBER^SEQUENCE #^CMOP NDC^DATE SHIPPED^CARRIER^PACKAGE ID"
^DIC(9.4,60,22,13,"PAH",291,1,172,0)="\\ORIGINAL\^100002236A^AMPICILLIN 250MG^WHIPATNM,PATIENT^666-00-0248^"
^DIC(9.4,60,22,13,"PAH",291,1,173,0)="164 FRIENDSHIP DRIVE^^^TROY^NEW YORK^12180^271-1112^^^Y^0^8/22/03^"
^DIC(9.4,60,22,13,"PAH",291,1,174,0)="8/22/03^12/23/03 13:36:40^2/22/04^^839-5087-06^EXT (500)^RPH,NAME^"
^DIC(9.4,60,22,13,"PAH",291,1,175,0)="DOCTOR,NAME^SC LESS THAN 50%^1^30^5^MAIL^N^^^^^^^"
^DIC(9.4,60,22,13,"PAH",291,1,176,0)="\\REFILL\^100001423^IBUPROFEN 600MG^WILPATNM,TEST3^000-00-3333^HERE"
^DIC(9.4,60,22,13,"PAH",291,1,177,0)="^^^TROY^NEW YORK^10000^^^^N^1^4/1/96^2/5/97^2/5/97 14:40:41^4/2/97^"
^DIC(9.4,60,22,13,"PAH",291,1,178,0)="123123123^00615-2526-05^EXT (500)^TEST,PHARM F^TEST,PROVIDER L^"
^DIC(9.4,60,22,13,"PAH",291,1,179,0)="^SC LESS THAN 50%^90^30^5^MAIL^N^^^^^^^"
^DIC(9.4,60,22,13,"PAH",291,1,180,0)="\\PARTIAL\^100002236A^AMPICILLIN 250MG^TEST2,PATIENT^666-00-0248^"
^DIC(9.4,60,22,13,"PAH",291,1,181,0)="164 FRIENDSHIP DRIVE^^^TROY^NEW YORK^12180^271-1112^^^Y^1^8/22/03^"
^DIC(9.4,60,22,13,"PAH",291,1,182,0)="12/4/03^12/23/03 13:36:42^2/22/04^^00839-5087-06^TROY (514)^RPH,NAME^"
^DIC(9.4,60,22,13,"PAH",291,1,183,0)="DOCTOR,NAME^SC LESS THAN 50%^1^1^5^WINDOW^N^PARTIAL REMARKS TEST^^^^^^"
^DIC(9.4,60,22,13,"PAH",291,1,184,0)="  "
^DIC(9.4,60,22,13,"PAH",291,1,185,0)="MISCELLANEOUS FIX:"
^DIC(9.4,60,22,13,"PAH",291,1,186,0)="------------------"
^DIC(9.4,60,22,13,"PAH",291,1,187,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,188,0)="The recently released patch PSO*7*326 provided the enhanced functionality"
^DIC(9.4,60,22,13,"PAH",291,1,189,0)="to look up patient by prescription number in backdoor pharmacy. After"
^DIC(9.4,60,22,13,"PAH",291,1,190,0)="installing this patch, four sites reported that they were unable to"
^DIC(9.4,60,22,13,"PAH",291,1,191,0)="retrieve patient information by swiping the Veterans Identity Card (VIC),"
^DIC(9.4,60,22,13,"PAH",291,1,192,0)="which had not been a problem before patch 326 installation. "
^DIC(9.4,60,22,13,"PAH",291,1,193,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,194,0)="The output of this particular card reader is in the format:"
^DIC(9.4,60,22,13,"PAH",291,1,195,0)="""%99999999^XXXXXXXXXXXXXXXX^99999999^^^^N^9999999999?"""
^DIC(9.4,60,22,13,"PAH",291,1,196,0)=" "
^DIC(9.4,60,22,13,"PAH",291,1,197,0)="The code change that was made to retrieve patient by prescription number "
^DIC(9.4,60,22,13,"PAH",291,1,198,0)="in patch 326 was not allowing the use of up-arrow (""^"") characters as "
^DIC(9.4,60,22,13,"PAH",291,1,199,0)="part of the input data, hence the failure. This patch 348 addresses the "
^DIC(9.4,60,22,13,"PAH",291,1,200,0)="issue."
^DIC(9.4,60,22,13,"PAH",292,0)="276 SEQ #301^3100716.092421^17"
^DIC(9.4,60,22,13,"PAH",292,1,0)="^^6^6^3100716"
^DIC(9.4,60,22,13,"PAH",292,1,1,0)="1. When a non-suspended refill is deleted there is no entry added into the"
^DIC(9.4,60,22,13,"PAH",292,1,2,0)="   Activity Log to reflect this."
^DIC(9.4,60,22,13,"PAH",292,1,3,0)="2. ePharmacy Medication Profile (View Only) shows a prescription as copay"
^DIC(9.4,60,22,13,"PAH",292,1,4,0)="   even after the copay has been removed."
^DIC(9.4,60,22,13,"PAH",292,1,5,0)="3. Undefined error when printing Medication Instructions."
^DIC(9.4,60,22,13,"PAH",292,1,6,0)="4. UNDEFINED error at h+7^IBCSCU"
^DIC(9.4,60,22,13,"PAH",293,0)="340 SEQ #303^3100819.143812^17"
^DIC(9.4,60,22,13,"PAH",293,1,0)="^^4^4^3100819"
^DIC(9.4,60,22,13,"PAH",293,1,1,0)="This patch will correct the following issues."
^DIC(9.4,60,22,13,"PAH",293,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",293,1,3,0)="HD0000000344080   2 CMOP is getting wrong refill text (3 of 2) and the "
^DIC(9.4,60,22,13,"PAH",293,1,4,0)="                  refill # is a negative"
^DIC(9.4,60,22,13,"PAH",294,0)="290^3100915.092144^17"
^DIC(9.4,60,22,13,"PAH",294,1,0)="^^54^54^3100915"
^DIC(9.4,60,22,13,"PAH",294,1,1,0)="1. A modification was made to the Reject Information screen under the "
^DIC(9.4,60,22,13,"PAH",294,1,2,0)="Third Party Payer Rejects - Worklist [PSO REJECTS WORKLIST] option and the"
^DIC(9.4,60,22,13,"PAH",294,1,3,0)="Third Party Payer Rejects - View/Process [PSO REJECTS VIEW/PROCESS] option"
^DIC(9.4,60,22,13,"PAH",294,1,4,0)="to incorporate the Coordination of Benefits (COB) indicator to be "
^DIC(9.4,60,22,13,"PAH",294,1,5,0)="displayed in the insurance section. The indicator will be displayed as"
^DIC(9.4,60,22,13,"PAH",294,1,6,0)="""Coord. Of Benefits:"" followed by either PRIMARY, SECONDARY, or TERTIARY."
^DIC(9.4,60,22,13,"PAH",294,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,8,0)="Example:"
^DIC(9.4,60,22,13,"PAH",294,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,10,0)="   INSURANCE Information"
^DIC(9.4,60,22,13,"PAH",294,1,11,0)="   Insurance      : OPP INSURANCE            Coord. Of Benefits: PRIMARY"
^DIC(9.4,60,22,13,"PAH",294,1,12,0)="   Contact        :"
^DIC(9.4,60,22,13,"PAH",294,1,13,0)="   Group Name     : D-GROUP1"
^DIC(9.4,60,22,13,"PAH",294,1,14,0)="   Group Number   : D00001"
^DIC(9.4,60,22,13,"PAH",294,1,15,0)="   Cardholder ID  :"
^DIC(9.4,60,22,13,"PAH",294,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,17,0)="2. A COB field(#27) was added to the PRESCRIPTION file (#52),"
^DIC(9.4,60,22,13,"PAH",294,1,18,0)="REJECT INFO sub-file (#52.25) to store the COB for the Third Party "
^DIC(9.4,60,22,13,"PAH",294,1,19,0)="Insurance Rejects for the fill. The Set of Codes will be stored as ""1"" for"
^DIC(9.4,60,22,13,"PAH",294,1,20,0)="Primary, ""2"" for Secondary, and ""3"" for Tertiary. Tertiary billing will "
^DIC(9.4,60,22,13,"PAH",294,1,21,0)="not be implemented with this patch group, but is included for future use."
^DIC(9.4,60,22,13,"PAH",294,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,23,0)="DATA          NAME                  GLOBAL        DATA"
^DIC(9.4,60,22,13,"PAH",294,1,24,0)="ELEMENT       TITLE                 LOCATION      TYPE"
^DIC(9.4,60,22,13,"PAH",294,1,25,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",294,1,26,0)="52.25,27      COB                    2;7          SET"
^DIC(9.4,60,22,13,"PAH",294,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,28,0)="                                '1' FOR PRIMARY; "
^DIC(9.4,60,22,13,"PAH",294,1,29,0)="                                '2' FOR SECONDARY; "
^DIC(9.4,60,22,13,"PAH",294,1,30,0)="                                '3' FOR TERTIARY; "
^DIC(9.4,60,22,13,"PAH",294,1,31,0)="              LAST EDITED:      JAN 20, 2009 "
^DIC(9.4,60,22,13,"PAH",294,1,32,0)="              DESCRIPTION:      This field contains the Coordination of "
^DIC(9.4,60,22,13,"PAH",294,1,33,0)="                                Benefits indicator for the third party "
^DIC(9.4,60,22,13,"PAH",294,1,34,0)="                                insurance rejection for the fill. This "
^DIC(9.4,60,22,13,"PAH",294,1,35,0)="                                field can contain 1 for Primary, 2 for"
^DIC(9.4,60,22,13,"PAH",294,1,36,0)="                                Secondary, or 3 for Tertiary."
^DIC(9.4,60,22,13,"PAH",294,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,38,0)="3. A modification was made to the Patient Medication Profile screen "
^DIC(9.4,60,22,13,"PAH",294,1,39,0)="under the ePharmacy Medication Profile (View Only) [PSO PMP] option to"
^DIC(9.4,60,22,13,"PAH",294,1,40,0)="modify the ECME LOG section to change the ""Comments:"" preface from"
^DIC(9.4,60,22,13,"PAH",294,1,41,0)="""Submitted to ECME:"" to ""ECME:"" for non reversals. Second modification was"
^DIC(9.4,60,22,13,"PAH",294,1,42,0)="made to add the COB indicator with insurance provider to the suffix of the"
^DIC(9.4,60,22,13,"PAH",294,1,43,0)="""Comments:."" The COB indicator will be denoted with a lower case ""p"" for"
^DIC(9.4,60,22,13,"PAH",294,1,44,0)="Primary, ""s"" for Secondary and a ""t"" for Tertiary, which will be followed"
^DIC(9.4,60,22,13,"PAH",294,1,45,0)="by the name of the insurance provider in capital letters."
^DIC(9.4,60,22,13,"PAH",294,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,47,0)="Example: "
^DIC(9.4,60,22,13,"PAH",294,1,48,0)="   "
^DIC(9.4,60,22,13,"PAH",294,1,49,0)="   ECME Log:"
^DIC(9.4,60,22,13,"PAH",294,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",294,1,51,0)="   #   Date/Time           Rx Ref          Initiator Of Activity"
^DIC(9.4,60,22,13,"PAH",294,1,52,0)="=========================================================================="
^DIC(9.4,60,22,13,"PAH",294,1,53,0)="   1   1/28/09@11:37:56    ORIGINAL        OPUSER,ONE"
^DIC(9.4,60,22,13,"PAH",294,1,54,0)="   Comments:  ECME:WINDOW FILL(NDC:00046-1066-05)-E PAYABLE-pOPP INSURANCE"
^DIC(9.4,60,22,13,"PAH",295,0)="330 SEQ #305^3101207.170723^17"
^DIC(9.4,60,22,13,"PAH",295,1,0)="^^8^8^3101207"
^DIC(9.4,60,22,13,"PAH",295,1,1,0)=" 1. The Drug Transaction History [PSA DRUG DISPLAY] menu option is not   "
^DIC(9.4,60,22,13,"PAH",295,1,2,0)="    showing the outpatient prescriptions that are dispensed for all"
^DIC(9.4,60,22,13,"PAH",295,1,3,0)="    pharmacy locations when the prescription is dispensed through"
^DIC(9.4,60,22,13,"PAH",295,1,4,0)="    the Outpatient Pharmacy Automation Interface (OPAI)."
^DIC(9.4,60,22,13,"PAH",295,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",295,1,6,0)=" 2. The mailman message that gets generated when the release of a"
^DIC(9.4,60,22,13,"PAH",295,1,7,0)="    discontinued prescription is attempted does not make the distinction"
^DIC(9.4,60,22,13,"PAH",295,1,8,0)="    between a regular and a partial fill.                              "
^DIC(9.4,60,22,13,"PAH",296,0)="358^3101216.164231^17"
^DIC(9.4,60,22,13,"PAH",297,0)="331 SEQ #307^3110111.105754^17"
^DIC(9.4,60,22,13,"PAH",297,1,0)="^^10^10^3110111"
^DIC(9.4,60,22,13,"PAH",297,1,1,0)="This patch will resolve the 3 issues."
^DIC(9.4,60,22,13,"PAH",297,1,2,0)="1. If a prescription has only a date, no time, for Released Date.Timeme"
^DIC(9.4,60,22,13,"PAH",297,1,3,0)="it will not show up on the Hi Cost Report."
^DIC(9.4,60,22,13,"PAH",297,1,4,0)="2. When selecting the 'Sort by Drug (alphabetically), status active,"
^DIC(9.4,60,22,13,"PAH",297,1,5,0)="status recent expired' view on the Meds Tab, prescriptions that have"
^DIC(9.4,60,22,13,"PAH",297,1,6,0)="a status of Hold or Provider Hold are not displayed."
^DIC(9.4,60,22,13,"PAH",297,1,7,0)="3. Non-VA med orders, that have been Discontinued, are showing up in"
^DIC(9.4,60,22,13,"PAH",297,1,8,0)="the Meds tab in CPRS.  Active Non-VA meds, if they have a start date"
^DIC(9.4,60,22,13,"PAH",297,1,9,0)="older than the ORCH CONTEXT MEDS date are not displayed.  Active meds "
^DIC(9.4,60,22,13,"PAH",297,1,10,0)="should always display."
^DIC(9.4,60,22,13,"PAH",298,0)="352 SEQ #308^3110331.165132^17"
^DIC(9.4,60,22,13,"PAH",298,1,0)="^^3^3^3110331"
^DIC(9.4,60,22,13,"PAH",298,1,1,0)="This patch will resolve the issue where the Ignored Rejects Report [PSO "
^DIC(9.4,60,22,13,"PAH",298,1,2,0)="IGNORED REJECTS REPORT] abends when sorting on PATIENT and only one"
^DIC(9.4,60,22,13,"PAH",298,1,3,0)="patient is selected."
^DIC(9.4,60,22,13,"PAH",299,0)="366 SEQ #309^3110428.155618^17"
^DIC(9.4,60,22,13,"PAH",299,1,0)="^^2^2^3110428"
^DIC(9.4,60,22,13,"PAH",299,1,1,0)="A VAMC has requested both a date and time stamp for prescription activity"
^DIC(9.4,60,22,13,"PAH",299,1,2,0)="log entries displayed by FileMan."
^DIC(9.4,60,22,13,"PAH",300,0)="251^3110428.160659^17"
^DIC(9.4,60,22,13,"PAH",300,1,0)="^^33^33^3110428"
^DIC(9.4,60,22,13,"PAH",300,1,1,0)="This patch is part of a combined build, made up of the following three "
^DIC(9.4,60,22,13,"PAH",300,1,2,0)="patches:"
^DIC(9.4,60,22,13,"PAH",300,1,3,0)="       OR*3.0*272           (Computerized Patient Record System)"
^DIC(9.4,60,22,13,"PAH",300,1,4,0)="       PSJ*5.0*181           (Inpatient Medications)"
^DIC(9.4,60,22,13,"PAH",300,1,5,0)="       PSO*7.0*251          (Outpatient Pharmacy)"
^DIC(9.4,60,22,13,"PAH",300,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",300,1,7,0)="These patches will replace most of current VistA medication order "
^DIC(9.4,60,22,13,"PAH",300,1,8,0)="checking system with version 1.0 of the new Medication Order Check "
^DIC(9.4,60,22,13,"PAH",300,1,9,0)="Healthcare Application (MOCHA) system that uses the First DataBank (FDB) "
^DIC(9.4,60,22,13,"PAH",300,1,10,0)="Drug Information Framework (DIF) interfaces and database. The VistA Drug "
^DIC(9.4,60,22,13,"PAH",300,1,11,0)="Interaction module will be replaced by the FDB Drug-Drug Interaction "
^DIC(9.4,60,22,13,"PAH",300,1,12,0)="Module (DDIM). The VistA Duplicate Class module will be replaced by the "
^DIC(9.4,60,22,13,"PAH",300,1,13,0)="FDB Enhanced Therapeutic Classification (ETC) System."
^DIC(9.4,60,22,13,"PAH",300,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",300,1,15,0)="In addition, the following three order checks that use VistA data have"
^DIC(9.4,60,22,13,"PAH",300,1,16,0)="been added to Inpatient Medications and Outpatient Pharmacy. These checks"
^DIC(9.4,60,22,13,"PAH",300,1,17,0)="currently occur in Computerized Patient Record System (CPRS), but will be"
^DIC(9.4,60,22,13,"PAH",300,1,18,0)="new to Pharmacy with the installation of these patches:"
^DIC(9.4,60,22,13,"PAH",300,1,19,0)="     Aminoglycoside Ordered"
^DIC(9.4,60,22,13,"PAH",300,1,20,0)="     Dangerous Meds for Patients > 64"
^DIC(9.4,60,22,13,"PAH",300,1,21,0)="     Glucophage - Lab Results"
^DIC(9.4,60,22,13,"PAH",300,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",300,1,23,0)="A new Graphical User Interface (GUI) module is also being introduced "
^DIC(9.4,60,22,13,"PAH",300,1,24,0)="called Pharmacy Enterprise Customization System (PECS), to be used only "
^DIC(9.4,60,22,13,"PAH",300,1,25,0)="by members of Pharmacy Benefits Management (PBM). It will allow PBM to "
^DIC(9.4,60,22,13,"PAH",300,1,26,0)="customize the data provided by FDB for use in VistA."
^DIC(9.4,60,22,13,"PAH",300,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",300,1,28,0)="The following three patient safety issues have also been addressed in "
^DIC(9.4,60,22,13,"PAH",300,1,29,0)="these patches:"
^DIC(9.4,60,22,13,"PAH",300,1,30,0)="       Order Checks on PreMix IV Solutions (PSI-06-012)"
^DIC(9.4,60,22,13,"PAH",300,1,31,0)="       Order Check display sequence changes (PSI-07-080)"
^DIC(9.4,60,22,13,"PAH",300,1,32,0)="       Eliminating confusion in Inpatient Medications Order Check display "
^DIC(9.4,60,22,13,"PAH",300,1,33,0)="       and processing (PSI-07-080)"
^DIC(9.4,60,22,13,"PAH",301,0)="375 SEQ #311^3110428.160712^17"
^DIC(9.4,60,22,13,"PAH",301,1,0)="^^36^36^3110428"
^DIC(9.4,60,22,13,"PAH",301,1,1,0)="1. This patch corrects a problem when a tech/clerk reinstates a prescription"
^DIC(9.4,60,22,13,"PAH",301,1,2,0)="from previously being discontinued.  The problem occurs when the site"
^DIC(9.4,60,22,13,"PAH",301,1,3,0)="parameter VERIFICATION (FILE #59; Field #.12) is set to 'No' and a user"
^DIC(9.4,60,22,13,"PAH",301,1,4,0)="does not hold the PSORPH key and reinstates a prescription, the prescription"
^DIC(9.4,60,22,13,"PAH",301,1,5,0)="gets put into a 'NON-VERIFIED' status.  In this situation the prescription"
^DIC(9.4,60,22,13,"PAH",301,1,6,0)="should have a status of 'ACTIVE'."
^DIC(9.4,60,22,13,"PAH",301,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,8,0)="2. This patch corrects a problem when a tech/clerk enters a new duplicate"
^DIC(9.4,60,22,13,"PAH",301,1,9,0)="drug and the confirmation message that the duplicate drug order was"
^DIC(9.4,60,22,13,"PAH",301,1,10,0)="discontinued did not display when it should have displayed."
^DIC(9.4,60,22,13,"PAH",301,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,12,0)="3. This patch corrects a problem where the SIG for med orders did not"
^DIC(9.4,60,22,13,"PAH",301,1,13,0)="format and display correctly (ccr3803)."
^DIC(9.4,60,22,13,"PAH",301,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,15,0)="4. Corrects a problem when Ctopying an Rx and the duplicate therapy Rx list"
^DIC(9.4,60,22,13,"PAH",301,1,16,0)="selected for deletion does not re-displays the complete list of Rxs to be"
^DIC(9.4,60,22,13,"PAH",301,1,17,0)="deleted as a duplicate therapy."
^DIC(9.4,60,22,13,"PAH",301,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,19,0)="5. OP Intervention Hidden Action When viewing interventions via the View"
^DIC(9.4,60,22,13,"PAH",301,1,20,0)="Intervention prompt data does not display correctly. Data is displayed until"
^DIC(9.4,60,22,13,"PAH",301,1,21,0)="screen has filled and then overlaps on bottom few lines. The user cannot"
^DIC(9.4,60,22,13,"PAH",301,1,22,0)="view the intervention due to scrolling issue. "
^DIC(9.4,60,22,13,"PAH",301,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,24,0)="6. Corrected order check sequence. (ccr 3832). "
^DIC(9.4,60,22,13,"PAH",301,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,26,0)="7. IP REQ 3.8.10.28 Failing - no TD messages for OP TD Discontinued Meds"
^DIC(9.4,60,22,13,"PAH",301,1,27,0)="(ccr 3837)."
^DIC(9.4,60,22,13,"PAH",301,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,29,0)="8. Hard error during clerk reinstate of an rx with a duplicate drug non-va"
^DIC(9.4,60,22,13,"PAH",301,1,30,0)="med (ccr 3851)."
^DIC(9.4,60,22,13,"PAH",301,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,32,0)="9. IP Remote Rx display in Therapeutic Duplication warning does not match"
^DIC(9.4,60,22,13,"PAH",301,1,33,0)="the SRS and FR 3.8.10.16 (ccr 3853)."
^DIC(9.4,60,22,13,"PAH",301,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",301,1,35,0)="10. Hard error during clerk reinstate of an rx with a duplicate drug non-va"
^DIC(9.4,60,22,13,"PAH",301,1,36,0)="med (ccr 3551)."
^DIC(9.4,60,22,13,"PAH",302,0)="343 SEQ #312^3110428.161444^17"
^DIC(9.4,60,22,13,"PAH",302,1,0)="^^127^127^3110428"
^DIC(9.4,60,22,13,"PAH",302,1,1,0)="This patch contains software modifications to the Outpatient Pharmacy (OP)"
^DIC(9.4,60,22,13,"PAH",302,1,2,0)="V. 7.0 application to support the FDA Medication Guides project. The "
^DIC(9.4,60,22,13,"PAH",302,1,3,0)="project objective is to allow pharmacy staff to retrieve the FDA Medication "
^DIC(9.4,60,22,13,"PAH",302,1,4,0)="Guide for prescriptions that contain FDA approved information that can help"
^DIC(9.4,60,22,13,"PAH",302,1,5,0)="patients avoid serious adverse events. The FDA requires that Medication"
^DIC(9.4,60,22,13,"PAH",302,1,6,0)="Guides be included with certain prescribed drugs and biological products "
^DIC(9.4,60,22,13,"PAH",302,1,7,0)="when the Agency determines that: "
^DIC(9.4,60,22,13,"PAH",302,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,9,0)=" . Certain information is necessary to prevent serious adverse effects "
^DIC(9.4,60,22,13,"PAH",302,1,10,0)=" . Patient decision-making should be advised by information about a known"
^DIC(9.4,60,22,13,"PAH",302,1,11,0)="   serious side effect with a product, or "
^DIC(9.4,60,22,13,"PAH",302,1,12,0)=" . Patient adherence to directions for the use of a product is essential"
^DIC(9.4,60,22,13,"PAH",302,1,13,0)="   to its effectiveness. "
^DIC(9.4,60,22,13,"PAH",302,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,15,0)="The features in the FDA Medication Guides project are being delivered in"
^DIC(9.4,60,22,13,"PAH",302,1,16,0)="incremental releases. This patch is part of the Increment 2 release. The "
^DIC(9.4,60,22,13,"PAH",302,1,17,0)="features included in this release are:"
^DIC(9.4,60,22,13,"PAH",302,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,19,0)=" . Establishment of a Server Repository for FDA Medication Guides within "
^DIC(9.4,60,22,13,"PAH",302,1,20,0)="   the VA network."
^DIC(9.4,60,22,13,"PAH",302,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,22,0)=" . Updates to 900+ entries in the VA PRODUCT file (#50.68) to store the "
^DIC(9.4,60,22,13,"PAH",302,1,23,0)="   corresponding FDA Medication Guide document name will be provided via"
^DIC(9.4,60,22,13,"PAH",302,1,24,0)="   the NDF Monthly Data Update patches."
^DIC(9.4,60,22,13,"PAH",302,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,26,0)=" . Introduction of a PC based Java software component to enable the"
^DIC(9.4,60,22,13,"PAH",302,1,27,0)="   automatic retrieval of an FDA Medication Guide from within VistA. The"
^DIC(9.4,60,22,13,"PAH",302,1,28,0)="   software does not require any direct user interaction. It works as a "
^DIC(9.4,60,22,13,"PAH",302,1,29,0)="   bridge between VistA and the PC where it is installed. The software "
^DIC(9.4,60,22,13,"PAH",302,1,30,0)="   identifies a request from VistA for a specific FDA Medication Guide and"
^DIC(9.4,60,22,13,"PAH",302,1,31,0)="   automatically retrieves it from the Server Repository and displays to the"
^DIC(9.4,60,22,13,"PAH",302,1,32,0)="   user via the Internet Explorer browser. "
^DIC(9.4,60,22,13,"PAH",302,1,33,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,34,0)=" . Introduction of a new option called Display FDA Medication Guide [PSN MED"
^DIC(9.4,60,22,13,"PAH",302,1,35,0)="   GUIDE] to the National Drug File V. 4.0 application for retrieving and "
^DIC(9.4,60,22,13,"PAH",302,1,36,0)="   displaying the FDA Medication Guide for a specific VA Product."
^DIC(9.4,60,22,13,"PAH",302,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,38,0)=" . Introduction of new functionality to the Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",302,1,39,0)="   [PSO LM BACKDOOR] option in the Outpatient Pharmacy V. 7.0 application"
^DIC(9.4,60,22,13,"PAH",302,1,40,0)="   for retrieving and displaying the FDA Medication Guide for a specific "
^DIC(9.4,60,22,13,"PAH",302,1,41,0)="   prescription."
^DIC(9.4,60,22,13,"PAH",302,1,42,0)="   "
^DIC(9.4,60,22,13,"PAH",302,1,43,0)="Below is a list of all the applications involved in this release along"
^DIC(9.4,60,22,13,"PAH",302,1,44,0)="with their patch number:"
^DIC(9.4,60,22,13,"PAH",302,1,45,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,46,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,60,22,13,"PAH",302,1,47,0)="   -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",302,1,48,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*343"
^DIC(9.4,60,22,13,"PAH",302,1,49,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                      PSN*4*263"
^DIC(9.4,60,22,13,"PAH",302,1,50,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*158"
^DIC(9.4,60,22,13,"PAH",302,1,51,0)="   "
^DIC(9.4,60,22,13,"PAH",302,1,52,0)="The FDA Medication Guides project is expected to complete in three "
^DIC(9.4,60,22,13,"PAH",302,1,53,0)="increments. Among other features, the next Increment will automate the "
^DIC(9.4,60,22,13,"PAH",302,1,54,0)="printing of FDA Medication Guides for prescriptions dispensed by the VA"
^DIC(9.4,60,22,13,"PAH",302,1,55,0)="via Outpatient Pharmacy application when the prescription label is printed."
^DIC(9.4,60,22,13,"PAH",302,1,56,0)="   "
^DIC(9.4,60,22,13,"PAH",302,1,57,0)="The following modification is inclued in this patch (PSO*7*343):"
^DIC(9.4,60,22,13,"PAH",302,1,58,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,59,0)="Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option"
^DIC(9.4,60,22,13,"PAH",302,1,60,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,61,0)="  Pharmacists will be able to retrieve an FDA Medication Guide for a "
^DIC(9.4,60,22,13,"PAH",302,1,62,0)="  specific prescription by selecting the prescription and invoking the OTH"
^DIC(9.4,60,22,13,"PAH",302,1,63,0)="  (Other OP Actions) hidden action and choosing the new item MG Display FDA"
^DIC(9.4,60,22,13,"PAH",302,1,64,0)="  Medication Guide. A Java software component running at the user's PC will "
^DIC(9.4,60,22,13,"PAH",302,1,65,0)="  then display the FDA Medication Guide Adobe Acrobat document (.pdf) by "
^DIC(9.4,60,22,13,"PAH",302,1,66,0)="  automatically opening it via the user's default web browser, which will"
^DIC(9.4,60,22,13,"PAH",302,1,67,0)="  allow the users to print it to any printer available to them, as seen "
^DIC(9.4,60,22,13,"PAH",302,1,68,0)="  below:"
^DIC(9.4,60,22,13,"PAH",302,1,69,0)="       "
^DIC(9.4,60,22,13,"PAH",302,1,70,0)="                       --- Other OP Actions ---"
^DIC(9.4,60,22,13,"PAH",302,1,71,0)="      PN   Progress Note (OP)"
^DIC(9.4,60,22,13,"PAH",302,1,72,0)="      AP   Action Profile (OP)"
^DIC(9.4,60,22,13,"PAH",302,1,73,0)="      MI   Print Medication Instructions"
^DIC(9.4,60,22,13,"PAH",302,1,74,0)="      DO   Display Orders' Statuses"
^DIC(9.4,60,22,13,"PAH",302,1,75,0)="      MG   Display FDA Medication Guide"
^DIC(9.4,60,22,13,"PAH",302,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,77,0)="      Select Item(s): MG   Display FDA Medication Guide  "
^DIC(9.4,60,22,13,"PAH",302,1,78,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,79,0)="      The following URL provides the link to the FDA Medication Guide "
^DIC(9.4,60,22,13,"PAH",302,1,80,0)="      associated with this medication."
^DIC(9.4,60,22,13,"PAH",302,1,81,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,82,0)="      vaww.national.cmop.domain.ext/FDAMedGuides/Lindane_(Generic)_(2008).pdf"
^DIC(9.4,60,22,13,"PAH",302,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,84,0)="      Please wait... "
^DIC(9.4,60,22,13,"PAH",302,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,86,0)="        [FDA Medication Guide .pdf document opens on the web browser]"
^DIC(9.4,60,22,13,"PAH",302,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,88,0)="      Enter RETURN to continue, '?' for HELP, or '^' to exit:    "
^DIC(9.4,60,22,13,"PAH",302,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,90,0)=" If a user tries to use this option from a computer which does not have the "
^DIC(9.4,60,22,13,"PAH",302,1,91,0)=" required Java software component installed, the following message will "
^DIC(9.4,60,22,13,"PAH",302,1,92,0)=" display:"
^DIC(9.4,60,22,13,"PAH",302,1,93,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,94,0)="      Select Item(s): MG   Display FDA Medication Guide  "
^DIC(9.4,60,22,13,"PAH",302,1,95,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,96,0)="      The following URL provides the link to the FDA Medication Guide "
^DIC(9.4,60,22,13,"PAH",302,1,97,0)="      associated with this medication."
^DIC(9.4,60,22,13,"PAH",302,1,98,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,99,0)="      vaww.national.cmop.domain.ext/FDAMedGuides/Lindane_(Generic)_(2008).pdf"
^DIC(9.4,60,22,13,"PAH",302,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,101,0)="      Please wait... "
^DIC(9.4,60,22,13,"PAH",302,1,102,0)="    "
^DIC(9.4,60,22,13,"PAH",302,1,103,0)="      The system is unable to display FDA Med Guide automatically."
^DIC(9.4,60,22,13,"PAH",302,1,104,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,105,0)="      Please, contact your local technical support for assistance to"
^DIC(9.4,60,22,13,"PAH",302,1,106,0)="      resolve this problem. In the meantime, you can copy/paste the"
^DIC(9.4,60,22,13,"PAH",302,1,107,0)="      link above into your browser's address bar to retrieve the"
^DIC(9.4,60,22,13,"PAH",302,1,108,0)="      FDA Medication Guide."
^DIC(9.4,60,22,13,"PAH",302,1,109,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,110,0)="      Enter RETURN to continue, '?' for HELP, or '^' to exit:    "
^DIC(9.4,60,22,13,"PAH",302,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,112,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,113,0)="  If a user tries to use this option for a medication that does not have"
^DIC(9.4,60,22,13,"PAH",302,1,114,0)="  an FDA Medication Guide on file, the following message will display:"
^DIC(9.4,60,22,13,"PAH",302,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,116,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,117,0)="      Select Item(s): MG   Display FDA Medication Guide  "
^DIC(9.4,60,22,13,"PAH",302,1,118,0)="     "
^DIC(9.4,60,22,13,"PAH",302,1,119,0)="      There is no FDA Medication Guide associated with this medication."
^DIC(9.4,60,22,13,"PAH",302,1,120,0)=" "
^DIC(9.4,60,22,13,"PAH",302,1,121,0)="      Press RETURN to continue"
^DIC(9.4,60,22,13,"PAH",302,1,122,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,123,0)="  "
^DIC(9.4,60,22,13,"PAH",302,1,124,0)="  Note: This option requires a Java software component to be installed on"
^DIC(9.4,60,22,13,"PAH",302,1,125,0)="  ----  the user's computer. This software will be released as part of this"
^DIC(9.4,60,22,13,"PAH",302,1,126,0)="        project. Please, refer to the project Release Notes and Installation"
^DIC(9.4,60,22,13,"PAH",302,1,127,0)="        Guide documentation for further information."
^DIC(9.4,60,22,13,"PAH",303,0)="316 SEQ #313^3110428.161519^17"
^DIC(9.4,60,22,13,"PAH",303,1,0)="^^47^47^3110428"
^DIC(9.4,60,22,13,"PAH",303,1,1,0)="Patches PSO*7*316 and GMTS*2.7*92 correct issues reported with the "
^DIC(9.4,60,22,13,"PAH",303,1,2,0)="Tool #2: Medication Worksheet. The Health Summary patch GMTS*2.7*92"
^DIC(9.4,60,22,13,"PAH",303,1,3,0)="will require patch PSO*7*316 and will create a national entry in the"
^DIC(9.4,60,22,13,"PAH",303,1,4,0)="HEALTH SUMMARY COMPONENT file (#142.1) for Tool #2: Medication Worksheet."
^DIC(9.4,60,22,13,"PAH",303,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,6,0)="1. The existing Application Program Interface (API) #4827 did not"
^DIC(9.4,60,22,13,"PAH",303,1,7,0)="   return fields required by Tool #2: Medication Worksheet."
^DIC(9.4,60,22,13,"PAH",303,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,9,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",303,1,10,0)="--------"
^DIC(9.4,60,22,13,"PAH",303,1,11,0)="Routine PSS^PSO59 returns data about the demographics of outpatient "
^DIC(9.4,60,22,13,"PAH",303,1,12,0)="pharmacy divisions, such as site name and address.  The existing API did "
^DIC(9.4,60,22,13,"PAH",303,1,13,0)="not return the division's assigned area code and phone number, which are "
^DIC(9.4,60,22,13,"PAH",303,1,14,0)="present in the format of Tool #2: Medication Worksheet."
^DIC(9.4,60,22,13,"PAH",303,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,16,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",303,1,17,0)="-----------"
^DIC(9.4,60,22,13,"PAH",303,1,18,0)="This patch modifies routine PSO59 to return the AREA CODE field (#.03)"
^DIC(9.4,60,22,13,"PAH",303,1,19,0)="and PHONE NUMBER field (#.04) as part of the target array."
^DIC(9.4,60,22,13,"PAH",303,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,21,0)="2.  Routine PSOQUAP distributed with patch PSO*7*294 is not used."
^DIC(9.4,60,22,13,"PAH",303,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,23,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",303,1,24,0)="--------"
^DIC(9.4,60,22,13,"PAH",303,1,25,0)="During testing of patch PSO*7*294, changes were made that resulted in "
^DIC(9.4,60,22,13,"PAH",303,1,26,0)="routine PSOQUAP being no longer required.  The routine was left in the "
^DIC(9.4,60,22,13,"PAH",303,1,27,0)="patch at the time in order to reduce the remaining testing time required."
^DIC(9.4,60,22,13,"PAH",303,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,29,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",303,1,30,0)="-----------"
^DIC(9.4,60,22,13,"PAH",303,1,31,0)="This patch removes routine PSOQUAP.  There are no known programs that "
^DIC(9.4,60,22,13,"PAH",303,1,32,0)="call this routine."
^DIC(9.4,60,22,13,"PAH",303,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,34,0)="3.  PSO*7*294 was noncompliant with Programming Standards and "
^DIC(9.4,60,22,13,"PAH",303,1,35,0)="    Conventions (SAC) for VistA applications."
^DIC(9.4,60,22,13,"PAH",303,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,37,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",303,1,38,0)="--------"
^DIC(9.4,60,22,13,"PAH",303,1,39,0)="During the internal review of some of the routines distributed with "
^DIC(9.4,60,22,13,"PAH",303,1,40,0)="PSO*7*294 findings uncovered some SAC standard violations."
^DIC(9.4,60,22,13,"PAH",303,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",303,1,42,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",303,1,43,0)="-----------"
^DIC(9.4,60,22,13,"PAH",303,1,44,0)="Routines PSOQ0186 and PSOQMCAL are being replaced with GMTSPST2.  "
^DIC(9.4,60,22,13,"PAH",303,1,45,0)="Corresponding Health Summary patch GMTS*2.7*92 creates a national Health"
^DIC(9.4,60,22,13,"PAH",303,1,46,0)="Summary component for Tool #2: Medication Worksheet to utilize the"
^DIC(9.4,60,22,13,"PAH",303,1,47,0)="replacement routines."
^DIC(9.4,60,22,13,"PAH",304,0)="365 SEQ #314^3110518.145624^17"
^DIC(9.4,60,22,13,"PAH",304,1,0)="^^2^2^3110518"
^DIC(9.4,60,22,13,"PAH",304,1,1,0)="This patch will resolve the issue where the incorrect message is displayed"
^DIC(9.4,60,22,13,"PAH",304,1,2,0)="to the user.  This is PSPO1744."
^DIC(9.4,60,22,13,"PAH",305,0)="355 SEQ #315^3110519.124853^17"
^DIC(9.4,60,22,13,"PAH",305,1,0)="^^1^1^3110519"
^DIC(9.4,60,22,13,"PAH",305,1,1,0)="User receives an undefined error when accessing the Non VA Meds Report."
^DIC(9.4,60,22,13,"PAH",306,0)="387 SEQ #316^3110812.135941^17"
^DIC(9.4,60,22,13,"PAH",306,1,0)="^^37^37^3110812"
^DIC(9.4,60,22,13,"PAH",306,1,1,0)="This patch is a follow-up to MEDICATION ORDER CHECK HEALTHCARE "
^DIC(9.4,60,22,13,"PAH",306,1,2,0)="APPLICATION (MOCHA) 1.0 group of patches."
^DIC(9.4,60,22,13,"PAH",306,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,4,0)="1.  A correction was made to address an occurrence reported in a"
^DIC(9.4,60,22,13,"PAH",306,1,5,0)="test account where Order Checks did not occur and no message was"
^DIC(9.4,60,22,13,"PAH",306,1,6,0)="displayed to the user.  "
^DIC(9.4,60,22,13,"PAH",306,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,8,0)="After the message ""Now Processing Enhanced Order Checks!  Please wait..."""
^DIC(9.4,60,22,13,"PAH",306,1,9,0)="is displayed, the system calls a Pharmacy Data Management (PDM) "
^DIC(9.4,60,22,13,"PAH",306,1,10,0)="Application Program Interface (API) that retrieves order check"
^DIC(9.4,60,22,13,"PAH",306,1,11,0)="information.  This API returns a value of -1 for error of some type"
^DIC(9.4,60,22,13,"PAH",306,1,12,0)="occurred, 0 (zero) for order checks complete with no issues found, or 1"
^DIC(9.4,60,22,13,"PAH",306,1,13,0)="for interactions found.  Outpatient Pharmacy was not checking for -1.  "
^DIC(9.4,60,22,13,"PAH",306,1,14,0)="This patch adds the check for -1, and displays a message when -1 is"
^DIC(9.4,60,22,13,"PAH",306,1,15,0)="returned."
^DIC(9.4,60,22,13,"PAH",306,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,17,0)="2.  A misspelling of the word ""Interoperability"" was corrected in the "
^DIC(9.4,60,22,13,"PAH",306,1,18,0)="first line of routine PSOORRD2."
^DIC(9.4,60,22,13,"PAH",306,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,20,0)="3.  An undefined error was corrected.  Using the Rx Verification by Clerk "
^DIC(9.4,60,22,13,"PAH",306,1,21,0)="option, a subscript error occurs after an unsuccessful request to First "
^DIC(9.4,60,22,13,"PAH",306,1,22,0)="Data Bank (FDB) is recieved.  The variable DFN is undefined and the error"
^DIC(9.4,60,22,13,"PAH",306,1,23,0)="is displayed around the ""Verify for"" prompt.  The error can present itself"
^DIC(9.4,60,22,13,"PAH",306,1,24,0)="in the following ways:"
^DIC(9.4,60,22,13,"PAH",306,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,26,0)="    a. When a page feed occurs just prior to the ""Verify for"" prompt: "
^DIC(9.4,60,22,13,"PAH",306,1,27,0)="       <UNDEFINED> VERIFY+2^PSOVER1 *DFN. "
^DIC(9.4,60,22,13,"PAH",306,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,29,0)="    b. During the order check process just before the PDM API is called: "
^DIC(9.4,60,22,13,"PAH",306,1,30,0)="       <UNDEFINED> OBX+3^PSODDPRE ^TMP(547819387,""PSOPEPS"",""OUT"",0). "
^DIC(9.4,60,22,13,"PAH",306,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",306,1,32,0)="4. For a technician entered order, the message ""Remote data not available"
^DIC(9.4,60,22,13,"PAH",306,1,33,0)="- Only local order checks processed"" was rolling off the screen.  This "
^DIC(9.4,60,22,13,"PAH",306,1,34,0)="message is displayed in when remote data isn't available just before"
^DIC(9.4,60,22,13,"PAH",306,1,35,0)="therapeutic duplications during the prescription order process.  This has "
^DIC(9.4,60,22,13,"PAH",306,1,36,0)="been corrected by adding an ""Enter to continue"" prompt after the message "
^DIC(9.4,60,22,13,"PAH",306,1,37,0)="is displayed when the user is a technician."
^DIC(9.4,60,22,13,"PAH",307,0)="371 SEQ #317^3110822.112206^17"
^DIC(9.4,60,22,13,"PAH",307,1,0)="^^7^7^3110822"
^DIC(9.4,60,22,13,"PAH",307,1,1,0)="This patch will resolve two issues with the List of Patients/Prescriptions"
^DIC(9.4,60,22,13,"PAH",307,1,2,0)="for Recall Notices."
^DIC(9.4,60,22,13,"PAH",307,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",307,1,4,0)="1)  List of Patients/Prescriptions for Recall Notices is wrapping"
^DIC(9.4,60,22,13,"PAH",307,1,5,0)="    incorrectly."
^DIC(9.4,60,22,13,"PAH",307,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",307,1,7,0)="2)  PSO RECALL LIST Report needs End-of-Record Identifier."
^DIC(9.4,60,22,13,"PAH",308,0)="353 SEQ #318^3110822.112215^17"
^DIC(9.4,60,22,13,"PAH",308,1,0)="^^4^4^3110822"
^DIC(9.4,60,22,13,"PAH",308,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",308,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",308,1,3,0)="This patch will resolve the issue where the REFILL DATE shows a past date "
^DIC(9.4,60,22,13,"PAH",308,1,4,0)="when the Rx is taken off hold."
^DIC(9.4,60,22,13,"PAH",309,0)="382 SEQ #319^3110930.13203^17"
^DIC(9.4,60,22,13,"PAH",309,1,0)="^^19^19^3110930"
^DIC(9.4,60,22,13,"PAH",309,1,1,0)="This patch addresses a request made by the Health Resource Center (HRC) "
^DIC(9.4,60,22,13,"PAH",309,1,2,0)="to Outpatient Pharmacy V. 7.0 to provide a new standalone option similar"
^DIC(9.4,60,22,13,"PAH",309,1,3,0)="to that of ePharmacy Medication Profile (View Only) [PSO PMP] option for"
^DIC(9.4,60,22,13,"PAH",309,1,4,0)="the Compensation and Record Interchange (CAPRI) system. The Medication"
^DIC(9.4,60,22,13,"PAH",309,1,5,0)="Profile and Refill [PSO HRC PROFILE/REFILL] option will allow users both"
^DIC(9.4,60,22,13,"PAH",309,1,6,0)="to view a patient's medication profile and to refill prescriptions."
^DIC(9.4,60,22,13,"PAH",309,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",309,1,8,0)="The patch also corrects the following two issues found in ePharmacy "
^DIC(9.4,60,22,13,"PAH",309,1,9,0)="Medication Profile (View Only) [PSO PMP] option."
^DIC(9.4,60,22,13,"PAH",309,1,10,0)="1. The calculation of remaining refills on the medication profile screen. "
^DIC(9.4,60,22,13,"PAH",309,1,11,0)="   Routine PSOPMP1 was modified to fix the issue."
^DIC(9.4,60,22,13,"PAH",309,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",309,1,13,0)="2. When selecting multiple items to be displayed from the medication "
^DIC(9.4,60,22,13,"PAH",309,1,14,0)="   profile list, only the first selection is displayed. Routine PSOPMP0"
^DIC(9.4,60,22,13,"PAH",309,1,15,0)="   was modified so that all selected items are displayed."
^DIC(9.4,60,22,13,"PAH",309,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",309,1,17,0)="Integration Control Registration #4595 was modified to grant the CAPRI "
^DIC(9.4,60,22,13,"PAH",309,1,18,0)="package access to the Medication Profile and Refill [PSO HRC PROFILE/"
^DIC(9.4,60,22,13,"PAH",309,1,19,0)="REFILL] option."
^DIC(9.4,60,22,13,"PAH",310,0)="357 SEQ #320^3111019.103838^17"
^DIC(9.4,60,22,13,"PAH",310,1,0)="^^1^1^3111019"
^DIC(9.4,60,22,13,"PAH",310,1,1,0)="User received an error while completing an order enterd via CPRS"
^DIC(9.4,60,22,13,"PAH",311,0)="368 SEQ #321^3111026.164502^17"
^DIC(9.4,60,22,13,"PAH",311,1,0)="^^1^1^3111026"
^DIC(9.4,60,22,13,"PAH",311,1,1,0)="Pharmacy inventory not updated when medication is returned to stock."
^DIC(9.4,60,22,13,"PAH",312,0)="359^3111102.120244^17"
^DIC(9.4,60,22,13,"PAH",312,1,0)="^^1^1^3111102"
^DIC(9.4,60,22,13,"PAH",312,1,1,0)="ePharmacy Phase 5 - NCPDP D.0"
^DIC(9.4,60,22,13,"PAH",313,0)="350 SEQ #323^3111108.135843^17"
^DIC(9.4,60,22,13,"PAH",313,1,0)="^^4^4^3111108"
^DIC(9.4,60,22,13,"PAH",313,1,1,0)="When running menu option Signature Log Reprint [PSO SIGLOG REPRINT] or "
^DIC(9.4,60,22,13,"PAH",313,1,2,0)="the Speed option RS Reprint Sig Log no output is printed."
^DIC(9.4,60,22,13,"PAH",313,1,3,0)="It will also resolve an issue where a label that should print does not "
^DIC(9.4,60,22,13,"PAH",313,1,4,0)="and a label that should not be printed does."
^DIC(9.4,60,22,13,"PAH",314,0)="381 SEQ #324^3111115.173424^17"
^DIC(9.4,60,22,13,"PAH",314,1,0)="^^5^5^3111115"
^DIC(9.4,60,22,13,"PAH",314,1,1,0)="This patch will resolve the issue where Active Non-VA meds with a "
^DIC(9.4,60,22,13,"PAH",314,1,2,0)="Start Date do no display on the Meds Tab when no Stop Date is defined in"
^DIC(9.4,60,22,13,"PAH",314,1,3,0)="the ORCH CONTEXT MEDS parameter."
^DIC(9.4,60,22,13,"PAH",314,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",314,1,5,0)="parameter."
^DIC(9.4,60,22,13,"PAH",315,0)="373 SEQ #325^3111207.151913^17"
^DIC(9.4,60,22,13,"PAH",315,1,0)="^^2^2^3111207"
^DIC(9.4,60,22,13,"PAH",315,1,1,0)="This patch will resolve the issue where the incorrect Pharmacist is "
^DIC(9.4,60,22,13,"PAH",315,1,2,0)="appearing on prescription."
^DIC(9.4,60,22,13,"PAH",316,0)="384 SEQ #326^3120206.144851^17"
^DIC(9.4,60,22,13,"PAH",316,1,0)="^^3^3^3120206"
^DIC(9.4,60,22,13,"PAH",316,1,1,0)="This patch will resolve the issue where the ROUTE from the previous "
^DIC(9.4,60,22,13,"PAH",316,1,2,0)="prescription is displayed on the screen for the next prescription when "
^DIC(9.4,60,22,13,"PAH",316,1,3,0)="there is no ROUTE associated with it."
^DIC(9.4,60,22,13,"PAH",317,0)="379 SEQ #327^3120206.144858^17"
^DIC(9.4,60,22,13,"PAH",318,0)="385^3120216.140023^17"
^DIC(9.4,60,22,13,"PAH",318,1,0)="^^1^1^3120216"
^DIC(9.4,60,22,13,"PAH",318,1,1,0)="ePharmacy Phase 6"
^DIC(9.4,60,22,13,"PAH",319,0)="354 SEQ #329^3120307.105021^17"
^DIC(9.4,60,22,13,"PAH",319,1,0)="^^91^91^3120307"
^DIC(9.4,60,22,13,"PAH",319,1,1,0)="This patch is being released as part of Pharmacy Legacy Enhancements "
^DIC(9.4,60,22,13,"PAH",319,1,2,0)="Fiscal Year 2011 to address the Outpatient Pharmacy Automation Interface"
^DIC(9.4,60,22,13,"PAH",319,1,3,0)="(OPAI) Enhancements. The Pharmacy Data Management patch PSS*1*156 is also"
^DIC(9.4,60,22,13,"PAH",319,1,4,0)="being released as part of this enhancement."
^DIC(9.4,60,22,13,"PAH",319,1,5,0)="  "
^DIC(9.4,60,22,13,"PAH",319,1,6,0)="Veterans Affairs Medical Center (VAMC) facilities have moved to using "
^DIC(9.4,60,22,13,"PAH",319,1,7,0)="multiple vendors for automated medication dispensing systems to improve"
^DIC(9.4,60,22,13,"PAH",319,1,8,0)="the efficiency of outpatient pharmacy operations. The following"
^DIC(9.4,60,22,13,"PAH",319,1,9,0)="enhancements were made to the Outpatient Pharmacy software to allow any"
^DIC(9.4,60,22,13,"PAH",319,1,10,0)="one division to have more than one Automated Dispensing Device (ADD)"
^DIC(9.4,60,22,13,"PAH",319,1,11,0)="communicating with Veterans Health Information Systems and Technology"
^DIC(9.4,60,22,13,"PAH",319,1,12,0)="Architecture (VistA) through the OPAI."
^DIC(9.4,60,22,13,"PAH",319,1,13,0)="  "
^DIC(9.4,60,22,13,"PAH",319,1,14,0)="1.  A new file named PHARMACY AUTOMATED DISPENSING DEVICES file (#52.53)"
^DIC(9.4,60,22,13,"PAH",319,1,15,0)="    was created. Entries in this file are required only if the site wants "
^DIC(9.4,60,22,13,"PAH",319,1,16,0)="    to utilize the multiple dispensing functionality. The new file "
^DIC(9.4,60,22,13,"PAH",319,1,17,0)="    contains the following fields:"
^DIC(9.4,60,22,13,"PAH",319,1,18,0)="   "
^DIC(9.4,60,22,13,"PAH",319,1,19,0)="    NAME - A free-text field that is between 3-30 characters in length. "
^DIC(9.4,60,22,13,"PAH",319,1,20,0)="           It is the name given to the automated dispensing device."
^DIC(9.4,60,22,13,"PAH",319,1,21,0)="    DNS  - A free-text field that is between 1-50 characters in length. It"
^DIC(9.4,60,22,13,"PAH",319,1,22,0)="           stores the DNS name or IP address of the automated dispensing "
^DIC(9.4,60,22,13,"PAH",319,1,23,0)="           device."
^DIC(9.4,60,22,13,"PAH",319,1,24,0)="    PORT - This field is a numeric between 1 and 65535 with no decimal "
^DIC(9.4,60,22,13,"PAH",319,1,25,0)="           places. It stores the port associated with the automated"
^DIC(9.4,60,22,13,"PAH",319,1,26,0)="           dispensing device."
^DIC(9.4,60,22,13,"PAH",319,1,27,0)="    INACTIVE "
^DIC(9.4,60,22,13,"PAH",319,1,28,0)="    DATE - This is a date field, not required, but is used to inactivate "
^DIC(9.4,60,22,13,"PAH",319,1,29,0)="           the OPAI connection to an automated dispensing device."
^DIC(9.4,60,22,13,"PAH",319,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",319,1,31,0)="2.  A new menu option named Enter/Edit Automated Dispensing Devices [PSO "
^DIC(9.4,60,22,13,"PAH",319,1,32,0)="    AUTO DISPENSING DEVICE] was created to maintain the PHARMACY "
^DIC(9.4,60,22,13,"PAH",319,1,33,0)="    AUTOMATED DISPENSING DEVICES file (#52.53). The option is located"
^DIC(9.4,60,22,13,"PAH",319,1,34,0)="    under the Maintenance (Outpatient Pharmacy) [PSO MAINTENANCE] menu."
^DIC(9.4,60,22,13,"PAH",319,1,35,0)="    Only sites planning to use the multiple automated dispensing devices"
^DIC(9.4,60,22,13,"PAH",319,1,36,0)="    for an outpatient division should use this option."
^DIC(9.4,60,22,13,"PAH",319,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",319,1,38,0)="3.  A new sub-file (#59.20081) multiple named OPAI was added to the "
^DIC(9.4,60,22,13,"PAH",319,1,39,0)="    DISPENSING SYSTEM PRINTER sub-file (#59.02008) in the OUTPATIENT SITE "
^DIC(9.4,60,22,13,"PAH",319,1,40,0)="    file (#59). The sub-file contains the following new fields:"
^DIC(9.4,60,22,13,"PAH",319,1,41,0)="  "
^DIC(9.4,60,22,13,"PAH",319,1,42,0)="    DNS NAME      - This field is a pointer to the PHARMACY AUTOMATED "
^DIC(9.4,60,22,13,"PAH",319,1,43,0)="                    DISPENSING DEVICES file (#52.53)."
^DIC(9.4,60,22,13,"PAH",319,1,44,0)="    CATEGORY      - Categories provide the flexibility of routing RXs to"
^DIC(9.4,60,22,13,"PAH",319,1,45,0)="                    different ADDs. This field contains the following set"
^DIC(9.4,60,22,13,"PAH",319,1,46,0)="                    of codes:"
^DIC(9.4,60,22,13,"PAH",319,1,47,0)="                    MCS    MAIL - CS"
^DIC(9.4,60,22,13,"PAH",319,1,48,0)="                    MNCS   MAIL - NCS"
^DIC(9.4,60,22,13,"PAH",319,1,49,0)="                    MAIL   MAIL"
^DIC(9.4,60,22,13,"PAH",319,1,50,0)="                    WCS    WINDOW - CS"
^DIC(9.4,60,22,13,"PAH",319,1,51,0)="                    WNCS   WINDOW - NCS"
^DIC(9.4,60,22,13,"PAH",319,1,52,0)="                    WIND   WINDOW"
^DIC(9.4,60,22,13,"PAH",319,1,53,0)="                    CS     CONTROLLED SUBSTANCE"
^DIC(9.4,60,22,13,"PAH",319,1,54,0)="                    NCS    NONCONTROLLED SUBSTANCE"
^DIC(9.4,60,22,13,"PAH",319,1,55,0)="                    A      ANY"
^DIC(9.4,60,22,13,"PAH",319,1,56,0)="                    S      STORAGE"
^DIC(9.4,60,22,13,"PAH",319,1,57,0)="   "
^DIC(9.4,60,22,13,"PAH",319,1,58,0)="4.  The Site Parameter Enter/Edit [PSO SITE PARAMETERS] option was   "
^DIC(9.4,60,22,13,"PAH",319,1,59,0)="    modified for addition of the new fields in the OPAI multiple"
^DIC(9.4,60,22,13,"PAH",319,1,60,0)="    (#59.20081) in the OUTPATIENT SITE file (#59)."
^DIC(9.4,60,22,13,"PAH",319,1,61,0)="  "
^DIC(9.4,60,22,13,"PAH",319,1,62,0)="5.  During prescription processing, if the label printer selected has "
^DIC(9.4,60,22,13,"PAH",319,1,63,0)="    ADDs defined then Rx will be routed to the appropriate ADDs. A message"
^DIC(9.4,60,22,13,"PAH",319,1,64,0)="    will be displayed indicating the ADDs where the Rx will be routed."
^DIC(9.4,60,22,13,"PAH",319,1,65,0)="    Below is an example of the routing message."
^DIC(9.4,60,22,13,"PAH",319,1,66,0)=" "
^DIC(9.4,60,22,13,"PAH",319,1,67,0)="      PRESCRIPTIONS SENT TO:"
^DIC(9.4,60,22,13,"PAH",319,1,68,0)="        OPTIFILL1"
^DIC(9.4,60,22,13,"PAH",319,1,69,0)="          100002815      ACETAMINOPHEN 325MG C.T."
^DIC(9.4,60,22,13,"PAH",319,1,70,0)="          100002816      AMOXICILLIN 250MG CAP"
^DIC(9.4,60,22,13,"PAH",319,1,71,0)="          100002824      AMOXAPINE 50MG TAB"
^DIC(9.4,60,22,13,"PAH",319,1,72,0)="   "
^DIC(9.4,60,22,13,"PAH",319,1,73,0)="        SCRIPTPRO1"
^DIC(9.4,60,22,13,"PAH",319,1,74,0)="          100002844      CIMETIDINE 200MG TAB"
^DIC(9.4,60,22,13,"PAH",319,1,75,0)="   "
^DIC(9.4,60,22,13,"PAH",319,1,76,0)="6.  During testing a problem was discovered in the Print from Suspense"
^DIC(9.4,60,22,13,"PAH",319,1,77,0)="    File [PSO PNDLBL] and Reprint Batches from Suspense [PSO PNDRPT] "
^DIC(9.4,60,22,13,"PAH",319,1,78,0)="    options. The ZTIO variable, which stores the label printer, was being"
^DIC(9.4,60,22,13,"PAH",319,1,79,0)="    reset to null after processing each patient prescription. As a result "
^DIC(9.4,60,22,13,"PAH",319,1,80,0)="    a printer defined with multiple ADDs was not routing prescriptions "
^DIC(9.4,60,22,13,"PAH",319,1,81,0)="    properly. Routines PSOSULBL and PSOSUSRP were modified to address this"
^DIC(9.4,60,22,13,"PAH",319,1,82,0)="    problem."
^DIC(9.4,60,22,13,"PAH",319,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",319,1,84,0)="7.  A new Integration Control Registration (ICR) #5579 was created to "
^DIC(9.4,60,22,13,"PAH",319,1,85,0)="    grant the Pharmacy Data Management package read access to the PHARMACY"
^DIC(9.4,60,22,13,"PAH",319,1,86,0)="    AUTOMATED DISPENSING DEVICES file (#52.53)."
^DIC(9.4,60,22,13,"PAH",319,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",319,1,88,0)="8.  As per the User Group request, when a dispense complete message is "
^DIC(9.4,60,22,13,"PAH",319,1,89,0)="    received by VistA from the external dispensing interface and if the "
^DIC(9.4,60,22,13,"PAH",319,1,90,0)="    mail tracking information is included in the 13th piece of the RXD "
^DIC(9.4,60,22,13,"PAH",319,1,91,0)="    segment, then the activity log will be updated with this information."
^DIC(9.4,60,22,13,"PAH",320,0)="377 SEQ #330^3120319.110751^17"
^DIC(9.4,60,22,13,"PAH",320,1,0)="^^6^6^3120319"
^DIC(9.4,60,22,13,"PAH",320,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,60,22,13,"PAH",320,1,2,0)="1) The message 'There is no refill data to be edited' incorrectly"
^DIC(9.4,60,22,13,"PAH",320,1,3,0)="   displays when editing a prescription that does have refills"
^DIC(9.4,60,22,13,"PAH",320,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",320,1,5,0)="2) Due to a change in system printing a modification needs to be made to"
^DIC(9.4,60,22,13,"PAH",320,1,6,0)="   the device setup for the Daily Amis Report [PSO DAILY AMIS]."
^DIC(9.4,60,22,13,"PAH",321,0)="351 SEQ #331^3120329.183124^17"
^DIC(9.4,60,22,13,"PAH",321,1,0)="^^1^1^3120329"
^DIC(9.4,60,22,13,"PAH",321,1,1,0)="The RXD-3 segment for a ""partial"" in Outpatient Pharmacy has a date missing."
^DIC(9.4,60,22,13,"PAH",322,0)="367 SEQ #332^3120329.183553^17"
^DIC(9.4,60,22,13,"PAH",322,1,0)="^^196^196^3120329"
^DIC(9.4,60,22,13,"PAH",322,1,1,0)="his patch contains software modifications to the Outpatient Pharmacy (OP)"
^DIC(9.4,60,22,13,"PAH",322,1,2,0)="V. 7.0 application to support the Food and Drug Administration (FDA) "
^DIC(9.4,60,22,13,"PAH",322,1,3,0)="Medication Guides - Increment 3 project. The project objective is to allow"
^DIC(9.4,60,22,13,"PAH",322,1,4,0)="pharmacy staff to retrieve the FDA Medication Guide for prescription items"
^DIC(9.4,60,22,13,"PAH",322,1,5,0)="that contain FDA approved information that can help patients avoid adverse"
^DIC(9.4,60,22,13,"PAH",322,1,6,0)="events. The FDA requires that Medication Guides be included with certain"
^DIC(9.4,60,22,13,"PAH",322,1,7,0)="prescribed drugs and biological products when the Agency determines that:"
^DIC(9.4,60,22,13,"PAH",322,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,9,0)=" . Certain information is necessary to prevent serious adverse effects "
^DIC(9.4,60,22,13,"PAH",322,1,10,0)=" . Patient decision-making should be advised by information about a known"
^DIC(9.4,60,22,13,"PAH",322,1,11,0)="   serious side effect with a product, or "
^DIC(9.4,60,22,13,"PAH",322,1,12,0)=" . Patient adherence to directions for the use of a product is essential"
^DIC(9.4,60,22,13,"PAH",322,1,13,0)="   to its effectiveness. "
^DIC(9.4,60,22,13,"PAH",322,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,15,0)="The features in the FDA Medication Guides project are being delivered in"
^DIC(9.4,60,22,13,"PAH",322,1,16,0)="incremental releases. This patch is part of the Increment 3 release, which"
^DIC(9.4,60,22,13,"PAH",322,1,17,0)="is the last planned release. The features included in this release are:"
^DIC(9.4,60,22,13,"PAH",322,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,19,0)=" . Ability to create and maintain a list of FDA Medication Guide printers"
^DIC(9.4,60,22,13,"PAH",322,1,20,0)="   for a specific pharmacy division."
^DIC(9.4,60,22,13,"PAH",322,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,22,0)=" . Automatic printing of FDA Medication Guide along with prescription "
^DIC(9.4,60,22,13,"PAH",322,1,23,0)="   labels."
^DIC(9.4,60,22,13,"PAH",322,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,25,0)=" . Ability to reprint the FDA Medication Guide when reprinting a "
^DIC(9.4,60,22,13,"PAH",322,1,26,0)="   prescription label."
^DIC(9.4,60,22,13,"PAH",322,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,28,0)=" . Ability to change the FDA Medication Guide printer at any point of the"
^DIC(9.4,60,22,13,"PAH",322,1,29,0)="   dispensing process, similar to changing the label printer."
^DIC(9.4,60,22,13,"PAH",322,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,31,0)=" . Ability to reprint the FDA Medication Guide for any given prescription"
^DIC(9.4,60,22,13,"PAH",322,1,32,0)="   fill or the latest FDA Mediation Guide available for the medication on"
^DIC(9.4,60,22,13,"PAH",322,1,33,0)="   the prescription."
^DIC(9.4,60,22,13,"PAH",322,1,34,0)="  "
^DIC(9.4,60,22,13,"PAH",322,1,35,0)=" . Identification on the label document that an FDA Medication Guide was"
^DIC(9.4,60,22,13,"PAH",322,1,36,0)="   printed as well and needs to be collated to the documentation before"
^DIC(9.4,60,22,13,"PAH",322,1,37,0)="   being handed over to the patient."
^DIC(9.4,60,22,13,"PAH",322,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,39,0)=" . Changes to the prescription label activity logs showing which specific"
^DIC(9.4,60,22,13,"PAH",322,1,40,0)="   FDA Medication Guide document printed along with the label."
^DIC(9.4,60,22,13,"PAH",322,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,42,0)=" . Changes to the Consolidated Mail Outpatient Pharmacy (CMOP) Event log"
^DIC(9.4,60,22,13,"PAH",322,1,43,0)="   showing which specific FDA Medication Guide document was available "
^DIC(9.4,60,22,13,"PAH",322,1,44,0)="   for the medication when the prescription fill was transmitted to CMOP."
^DIC(9.4,60,22,13,"PAH",322,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,46,0)=" . Introduction of a PC based Java software component to enable the"
^DIC(9.4,60,22,13,"PAH",322,1,47,0)="   automatic printing of an FDA Medication Guide from within VistA. The"
^DIC(9.4,60,22,13,"PAH",322,1,48,0)="   software does not require any direct user interaction. The software "
^DIC(9.4,60,22,13,"PAH",322,1,49,0)="   identifies a request from VistA for a specific FDA Medication Guide"
^DIC(9.4,60,22,13,"PAH",322,1,50,0)="   and automatically sends it to the FDA Medication Guide printer"
^DIC(9.4,60,22,13,"PAH",322,1,51,0)="   selected by the user within VistA when dispensing the medication."
^DIC(9.4,60,22,13,"PAH",322,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,53,0)=" . Ability to update the Windows network printer name for a specific"
^DIC(9.4,60,22,13,"PAH",322,1,54,0)="   device through the Kernel application. Once the pharmacist selects a"
^DIC(9.4,60,22,13,"PAH",322,1,55,0)="   printer to print the FDA Medication Guide Vista will retrieve the "
^DIC(9.4,60,22,13,"PAH",322,1,56,0)="   Windows name for the printer and will pass it on to the Java"
^DIC(9.4,60,22,13,"PAH",322,1,57,0)="   application responsible for printing the document."
^DIC(9.4,60,22,13,"PAH",322,1,58,0)="    "
^DIC(9.4,60,22,13,"PAH",322,1,59,0)="Below is a list of all the applications involved in this release along"
^DIC(9.4,60,22,13,"PAH",322,1,60,0)="with their patch number:"
^DIC(9.4,60,22,13,"PAH",322,1,61,0)="  "
^DIC(9.4,60,22,13,"PAH",322,1,62,0)="   APPLICATION/VERSION                                    PATCH"
^DIC(9.4,60,22,13,"PAH",322,1,63,0)="   -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,64,0)="   CONSOLIDATED MAIL OUTPATIENT PHARMACY (CMOP) V. 2.0    PSX*2*70"
^DIC(9.4,60,22,13,"PAH",322,1,65,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                        PSN*4*264"
^DIC(9.4,60,22,13,"PAH",322,1,66,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                        PSO*7*367"
^DIC(9.4,60,22,13,"PAH",322,1,67,0)="   KERNEL V. 8.0                                          XU*8*566"
^DIC(9.4,60,22,13,"PAH",322,1,68,0)="   "
^DIC(9.4,60,22,13,"PAH",322,1,69,0)="The following modifications are included in this patch (PSO*7*367):"
^DIC(9.4,60,22,13,"PAH",322,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,71,0)="1. Site Parameter Enter/Edit [PSO SITE PARAMETERS] option"
^DIC(9.4,60,22,13,"PAH",322,1,72,0)="   ------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,73,0)="   Two new parameters are being introduced in this option: "
^DIC(9.4,60,22,13,"PAH",322,1,74,0)="   a) FDA MED GUIDE PRINT SERVER URL: this field is used to store the"
^DIC(9.4,60,22,13,"PAH",322,1,75,0)="      Uniform Resource Locator (URL) for the Print Server where the Java"
^DIC(9.4,60,22,13,"PAH",322,1,76,0)="      application responsible for automatically printing of the FDA"
^DIC(9.4,60,22,13,"PAH",322,1,77,0)="      Medication Guides for the division was installed "
^DIC(9.4,60,22,13,"PAH",322,1,78,0)="      (e.g.,'http://127.0.0.1/'). This field is required for the FDA"
^DIC(9.4,60,22,13,"PAH",322,1,79,0)="      Medication Guide functionality to work properly."
^DIC(9.4,60,22,13,"PAH",322,1,80,0)="   b) FDA MED GUIDE PRINTER: This is a multiple field used to store a"
^DIC(9.4,60,22,13,"PAH",322,1,81,0)="      list of printers used for printing FDA Medication Guide document "
^DIC(9.4,60,22,13,"PAH",322,1,82,0)="      for the division. There are two fields in the multiple: 1) FDA"
^DIC(9.4,60,22,13,"PAH",322,1,83,0)="      MED GUIDE PRINTER, which is a pointer to the DEVICE file (#3.5)."
^DIC(9.4,60,22,13,"PAH",322,1,84,0)="      Only devices with a content in the WINDOWS NETWORK PRINTER NAME"
^DIC(9.4,60,22,13,"PAH",322,1,85,0)="      field (#75) are selectable, and 2) DEFAULT PRINTER, which "
^DIC(9.4,60,22,13,"PAH",322,1,86,0)="      indicates whether the printer selected is to be used as the "
^DIC(9.4,60,22,13,"PAH",322,1,87,0)="      default printer for the division. Only one printer can be set as"
^DIC(9.4,60,22,13,"PAH",322,1,88,0)="      default printer for each division. This field is not required."
^DIC(9.4,60,22,13,"PAH",322,1,89,0)="      The printers in this multiple will be displayed for selection"
^DIC(9.4,60,22,13,"PAH",322,1,90,0)="      when the user logs into a division. If there is a printer set as"
^DIC(9.4,60,22,13,"PAH",322,1,91,0)="      the default printer, it will be set as the default printer."
^DIC(9.4,60,22,13,"PAH",322,1,92,0)="   "
^DIC(9.4,60,22,13,"PAH",322,1,93,0)="  "
^DIC(9.4,60,22,13,"PAH",322,1,94,0)="2. Outpatient Pharmacy Manager [PSO MANAGER] option"
^DIC(9.4,60,22,13,"PAH",322,1,95,0)="   ------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,96,0)="   When logging into a division, after selecting the Profile and Label"
^DIC(9.4,60,22,13,"PAH",322,1,97,0)="   printers, the user will be prompt to select an FDA Medication Guide"
^DIC(9.4,60,22,13,"PAH",322,1,98,0)="   printer for the current session. If the division selected has a list"
^DIC(9.4,60,22,13,"PAH",322,1,99,0)="   of FDA Medication Guide printers they will be displayed (see below),"
^DIC(9.4,60,22,13,"PAH",322,1,100,0)="   however the user will be able to select other printers as well. The"
^DIC(9.4,60,22,13,"PAH",322,1,101,0)="   HOME and NULL DEVICE are selectable at this point."
^DIC(9.4,60,22,13,"PAH",322,1,102,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,103,0)="   Select OPTION NAME: PSO MANAGER       Outpatient Pharmacy Manager"
^DIC(9.4,60,22,13,"PAH",322,1,104,0)="   Outpatient Pharmacy software - Version "
^DIC(9.4,60,22,13,"PAH",322,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,106,0)="   Division:    DIVISION 999 "
^DIC(9.4,60,22,13,"PAH",322,1,107,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,108,0)="          You are logged on under the DIVISION division."
^DIC(9.4,60,22,13,"PAH",322,1,109,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,110,0)="   Select PROFILE PRINTER: HOME//   GENERIC INCOMING TELNET"
^DIC(9.4,60,22,13,"PAH",322,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,112,0)="   Select LABEL PRINTER: HOME//   GENERIC INCOMING TELNET"
^DIC(9.4,60,22,13,"PAH",322,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,114,0)="   OK to assume label alignment is correct? YES// "
^DIC(9.4,60,22,13,"PAH",322,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,116,0)="   DIVISIONS's FDA Medication Guide Printer(s) on file:"
^DIC(9.4,60,22,13,"PAH",322,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,118,0)="     FDA MED GUIDE PRINTER (Default)"
^DIC(9.4,60,22,13,"PAH",322,1,119,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,120,0)="   Select FDA MED GUIDE PRINTER: FDA MED GUIDE PRINTER//"
^DIC(9.4,60,22,13,"PAH",322,1,121,0)="  "
^DIC(9.4,60,22,13,"PAH",322,1,122,0)="3. Complete Orders from [OERR PSO LMOE FINISH] option"
^DIC(9.4,60,22,13,"PAH",322,1,123,0)="   Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option"
^DIC(9.4,60,22,13,"PAH",322,1,124,0)="   ---------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,125,0)="   There are a few enhancements being added to the prescription processing"
^DIC(9.4,60,22,13,"PAH",322,1,126,0)="   options regarding the printing of FDA Medication Guides. Among them:"
^DIC(9.4,60,22,13,"PAH",322,1,127,0)="  "
^DIC(9.4,60,22,13,"PAH",322,1,128,0)="   a) The FDA Medication Guide document will print automatically for"
^DIC(9.4,60,22,13,"PAH",322,1,129,0)="      prescriptions, if there is one available."
^DIC(9.4,60,22,13,"PAH",322,1,130,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,131,0)="   b) Users will have the ability to change the FDA Medication Guide "
^DIC(9.4,60,22,13,"PAH",322,1,132,0)="      printer in the same way they change the label and profile printers"
^DIC(9.4,60,22,13,"PAH",322,1,133,0)="      today."
^DIC(9.4,60,22,13,"PAH",322,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,135,0)="   c) When queuing labels to print, if there is at least one prescription"
^DIC(9.4,60,22,13,"PAH",322,1,136,0)="      with an FDA Medication Guide associated, it will require a valid FDA"
^DIC(9.4,60,22,13,"PAH",322,1,137,0)="      Medication Guide printer to be entered. This is similar to requiring"
^DIC(9.4,60,22,13,"PAH",322,1,138,0)="      a valid printer for the label printer."
^DIC(9.4,60,22,13,"PAH",322,1,139,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,140,0)="   d) The actual label document will contain a note under the barcode,"
^DIC(9.4,60,22,13,"PAH",322,1,141,0)="      before the PMI document, that says ""Read FDA MED Guide"". Such note"
^DIC(9.4,60,22,13,"PAH",322,1,142,0)="      should indicate to the pharmacist that an FDA Medication Guide"
^DIC(9.4,60,22,13,"PAH",322,1,143,0)="      document has been printed for the prescription and should be handed"
^DIC(9.4,60,22,13,"PAH",322,1,144,0)="      to the patient."
^DIC(9.4,60,22,13,"PAH",322,1,145,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,146,0)="   e) The Label Log and CMOP Event Log will both list the FDA Medication"
^DIC(9.4,60,22,13,"PAH",322,1,147,0)="      Guide document name (.pdf) associated with each fill."
^DIC(9.4,60,22,13,"PAH",322,1,148,0)="   "
^DIC(9.4,60,22,13,"PAH",322,1,149,0)="   f) Users will have the ability to reprint the FDA Medication Guide for"
^DIC(9.4,60,22,13,"PAH",322,1,150,0)="      past prescription fills or the latest FDA Medication Guide available"
^DIC(9.4,60,22,13,"PAH",322,1,151,0)="      for the prescription via a new action RM - Reprint FDA Medication"
^DIC(9.4,60,22,13,"PAH",322,1,152,0)="      Guide under the OTH - Other OP Actions menu."
^DIC(9.4,60,22,13,"PAH",322,1,153,0)="       "
^DIC(9.4,60,22,13,"PAH",322,1,154,0)="4. Print from Suspense File [PSO PNDLBL] option"
^DIC(9.4,60,22,13,"PAH",322,1,155,0)="   --------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,156,0)="   In order to run this option users will be required to enter a valid FDA"
^DIC(9.4,60,22,13,"PAH",322,1,157,0)="   Medication Guide printer. All prescriptions that prints a label via"
^DIC(9.4,60,22,13,"PAH",322,1,158,0)="   this option and that have an FDA Medication Guide associated will have"
^DIC(9.4,60,22,13,"PAH",322,1,159,0)="   the documente printed as well in the designated printer."
^DIC(9.4,60,22,13,"PAH",322,1,160,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,161,0)="5. Pull Early from Suspense [PSO PNDRX] option"
^DIC(9.4,60,22,13,"PAH",322,1,162,0)="   -------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,163,0)="   If the prescription being pulled from suspense has an FDA Medication"
^DIC(9.4,60,22,13,"PAH",322,1,164,0)="   Guide associated the user will be required to enter a valid FDA"
^DIC(9.4,60,22,13,"PAH",322,1,165,0)="   Medication Guide printer to where the document will be printed for"
^DIC(9.4,60,22,13,"PAH",322,1,166,0)="   the prescription."
^DIC(9.4,60,22,13,"PAH",322,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,168,0)="6. Change Label Printer [PSO CHANGE PRINTER] option"
^DIC(9.4,60,22,13,"PAH",322,1,169,0)="   ------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,170,0)="   This option is used by users to change the profile and label printers"
^DIC(9.4,60,22,13,"PAH",322,1,171,0)="   after having logged on to a pharmacy division. It is being modified to"
^DIC(9.4,60,22,13,"PAH",322,1,172,0)="   allow users to change the FDA Medication Guide printer as well."
^DIC(9.4,60,22,13,"PAH",322,1,173,0)="   "
^DIC(9.4,60,22,13,"PAH",322,1,174,0)="7. Reprint an Outpatient Rx Label [PSO RXRPT] option"
^DIC(9.4,60,22,13,"PAH",322,1,175,0)="   -------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,176,0)="   If the prescription selected to reprinted the label has an FDA "
^DIC(9.4,60,22,13,"PAH",322,1,177,0)="   Medication Guide associated, this option will ask whether the user also"
^DIC(9.4,60,22,13,"PAH",322,1,178,0)="   wants to reprint the FDA Medication Guide. If they answer YES, a valid"
^DIC(9.4,60,22,13,"PAH",322,1,179,0)="   FDA Medication Guide printer will be required for the user to proceed"
^DIC(9.4,60,22,13,"PAH",322,1,180,0)="   with the reprinting of the label and FDA Medication Guide."
^DIC(9.4,60,22,13,"PAH",322,1,181,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,182,0)="8. Label/Profile Monitor Reprint [PSO B] option"
^DIC(9.4,60,22,13,"PAH",322,1,183,0)="   Reprint External Batches [PSO INTERFACE REPRINT] option"
^DIC(9.4,60,22,13,"PAH",322,1,184,0)="   Reprint Batches from Suspense [PSO PNDRPT] option"
^DIC(9.4,60,22,13,"PAH",322,1,185,0)="   -------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",322,1,186,0)="   These options are used for reprinting batches of labels that may have "
^DIC(9.4,60,22,13,"PAH",322,1,187,0)="   jammed on the printer. When reprinting labels via one of these options"
^DIC(9.4,60,22,13,"PAH",322,1,188,0)="   users will be prompted if they also want to reprint the FDA Medication"
^DIC(9.4,60,22,13,"PAH",322,1,189,0)="   Guide. If they answer YES, a valid FDA Medication Guide printer will be"
^DIC(9.4,60,22,13,"PAH",322,1,190,0)="   required for the user to proceed with the reprinting of the label and"
^DIC(9.4,60,22,13,"PAH",322,1,191,0)="   FDA Medication Guide, if one is available."
^DIC(9.4,60,22,13,"PAH",322,1,192,0)=" "
^DIC(9.4,60,22,13,"PAH",322,1,193,0)="9. The background process that calculates suspense days now rounds any"
^DIC(9.4,60,22,13,"PAH",322,1,194,0)="   partial day to the next full day. This modification was moved from "
^DIC(9.4,60,22,13,"PAH",322,1,195,0)="   patch PSO*7*385 into this patch due to routine overlap and to avoid"
^DIC(9.4,60,22,13,"PAH",322,1,196,0)="   patch dependency."
^DIC(9.4,60,22,13,"PAH",323,0)="360 SEQ #333^3120329.1837^17"
^DIC(9.4,60,22,13,"PAH",323,1,0)="^^2^2^3120329"
^DIC(9.4,60,22,13,"PAH",323,1,1,0)="This patch will fix an issue that was discovered in PSOSD1 "
^DIC(9.4,60,22,13,"PAH",323,1,2,0)="where the variable LINE is not being renewed."
^DIC(9.4,60,22,13,"PAH",324,0)="403 SEQ #334^3120418.115106^17"
^DIC(9.4,60,22,13,"PAH",324,1,0)="^^1^1^3120418"
^DIC(9.4,60,22,13,"PAH",324,1,1,0)="HIPAA 5010 MAINTENANCE"
^DIC(9.4,60,22,13,"PAH",325,0)="388 SEQ #335^3120829.103853^17"
^DIC(9.4,60,22,13,"PAH",325,1,0)="^^9^9^3120829"
^DIC(9.4,60,22,13,"PAH",325,1,1,0)="This patch resolves the following two issues:"
^DIC(9.4,60,22,13,"PAH",325,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",325,1,3,0)="1) Provide users a more accurate description as to as to why a refill is "
^DIC(9.4,60,22,13,"PAH",325,1,4,0)="not allowed."
^DIC(9.4,60,22,13,"PAH",325,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",325,1,6,0)="                                                                   "
^DIC(9.4,60,22,13,"PAH",325,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",325,1,8,0)="2) Correct a misspelling of the word ""prescription"" in a CPRS pop-up "
^DIC(9.4,60,22,13,"PAH",325,1,9,0)="box."
^DIC(9.4,60,22,13,"PAH",326,0)="332 SEQ #336^3120829.105947^17"
^DIC(9.4,60,22,13,"PAH",326,1,0)="^^8^8^3120829"
^DIC(9.4,60,22,13,"PAH",326,1,1,0)="When the Date of Death is deleted from a patient, a mailman message is "
^DIC(9.4,60,22,13,"PAH",326,1,2,0)="generated that contains the patient's full name and last four digits of "
^DIC(9.4,60,22,13,"PAH",326,1,3,0)="their Social Security Number in the subject line."
^DIC(9.4,60,22,13,"PAH",326,1,4,0)="Return to Stock for the original fill and partials do not trigger a VDEF"
^DIC(9.4,60,22,13,"PAH",326,1,5,0)="call to update the HDR."
^DIC(9.4,60,22,13,"PAH",326,1,6,0)="When a prescription is auto-DC'ed, if the pharmacist reinstates the "
^DIC(9.4,60,22,13,"PAH",326,1,7,0)="prescription, the Last Fill Date gets set to today's date rather than "
^DIC(9.4,60,22,13,"PAH",326,1,8,0)="reverting back to the actual Last Fill Date."
^DIC(9.4,60,22,13,"PAH",327,0)="398 SEQ #337^3120829.120152^17"
^DIC(9.4,60,22,13,"PAH",327,1,0)="^^4^4^3120829"
^DIC(9.4,60,22,13,"PAH",327,1,1,0)="This patch addresses the following two issues."
^DIC(9.4,60,22,13,"PAH",327,1,2,0)="1 - Presciptions re-instated in error."
^DIC(9.4,60,22,13,"PAH",327,1,3,0)="2 - The EXCLUSIONARY CHECKED BY field is not getting updated."
^DIC(9.4,60,22,13,"PAH",327,1,4,0)="3 - The PSO HI COST report is not exiting when the ""^"" is used."
^DIC(9.4,60,22,13,"PAH",328,0)="404 SEQ #338^3120829.123238^17"
^DIC(9.4,60,22,13,"PAH",328,1,0)="^^3^3^3120829"
^DIC(9.4,60,22,13,"PAH",328,1,1,0)="Need to replace the direct global read for the Major Diagnostic Category"
^DIC(9.4,60,22,13,"PAH",328,1,2,0)="of the ICD Diagnosis file (#80) with the API $$ICDDX^ICDCODE and the "
^DIC(9.4,60,22,13,"PAH",328,1,3,0)="Description of the ICD Diagnosis file (#80) with the API $$ICDD^ICDCODE."
^DIC(9.4,60,22,13,"PAH",329,0)="361 SEQ #339^3120829.125314^17"
^DIC(9.4,60,22,13,"PAH",329,1,0)="^^3^3^3120829"
^DIC(9.4,60,22,13,"PAH",329,1,1,0)="CMOP MESSAGE IN ACTIVITY LOG IS CUT-OFF."
^DIC(9.4,60,22,13,"PAH",329,1,2,0)="VIEW PRESCRIPTIONS MENU OPTION DOES NOT SHOW CONJUNCTION OF EXCEPT FOR "
^DIC(9.4,60,22,13,"PAH",329,1,3,0)="COMPLEX ORDERS."
^DIC(9.4,60,22,13,"PAH",330,0)="401 SEQ #340^3120830.162913^17"
^DIC(9.4,60,22,13,"PAH",330,1,0)="^^2^2^3120830"
^DIC(9.4,60,22,13,"PAH",330,1,1,0)="Error occurs when the Drug Class is not defined in the VA DRUG CLASS "
^DIC(9.4,60,22,13,"PAH",330,1,2,0)="file (#50.605)."
^DIC(9.4,60,22,13,"PAH",331,0)="396 SEQ #341^3120913.153527^17"
^DIC(9.4,60,22,13,"PAH",331,1,0)="^^8^8^3120913"
^DIC(9.4,60,22,13,"PAH",331,1,1,0)="This patch will resolve the following 3 tickets:"
^DIC(9.4,60,22,13,"PAH",331,1,2,0)="HD0000000498138 - Date of Death cancelled prescriptions reinstated does not"
^DIC(9.4,60,22,13,"PAH",331,1,3,0)="                  show correct Last Fill dates."
^DIC(9.4,60,22,13,"PAH",331,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",331,1,5,0)="HD0000000601013 - Print issues with TRICARE prescriptions"
^DIC(9.4,60,22,13,"PAH",331,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",331,1,7,0)="HD0000000586028 - Refills are clogging CPRS"
^DIC(9.4,60,22,13,"PAH",331,1,8,0)="                  (CPRS refills were not processing automatically)"
^DIC(9.4,60,22,13,"PAH",332,0)="386 SEQ #342^3120924.152617^17"
^DIC(9.4,60,22,13,"PAH",332,1,0)="^^139^139^3120924"
^DIC(9.4,60,22,13,"PAH",332,1,1,0)="The Pharmacy Legacy Enhancements (PLE) Increment 9 Release includes the "
^DIC(9.4,60,22,13,"PAH",332,1,2,0)="following modifications to the Outpatient Pharmacy V. 7.0 application:"
^DIC(9.4,60,22,13,"PAH",332,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,4,0)="1. Prescription HOLD/UNHOLD Functionality"
^DIC(9.4,60,22,13,"PAH",332,1,5,0)="   --------------------------------------"
^DIC(9.4,60,22,13,"PAH",332,1,6,0)="   a.  The HOLD REASON field (#99) of the PRESCRIPTION file (#52) has the"
^DIC(9.4,60,22,13,"PAH",332,1,7,0)="       following set of codes, which is presented to the PSORPH key holder"
^DIC(9.4,60,22,13,"PAH",332,1,8,0)="       during prescription 'HOLD' process:"
^DIC(9.4,60,22,13,"PAH",332,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,10,0)="       '1 INSUFFICIENT QTY IN STOCK'"
^DIC(9.4,60,22,13,"PAH",332,1,11,0)="       '2 DRUG-DRUG INTERACTION'"
^DIC(9.4,60,22,13,"PAH",332,1,12,0)="       '3 PATIENT REACTION'"
^DIC(9.4,60,22,13,"PAH",332,1,13,0)="       '4 PHYSICIAN TO BE CONTACTED'"
^DIC(9.4,60,22,13,"PAH",332,1,14,0)="       '5 ALLERGY REACTIONS'"
^DIC(9.4,60,22,13,"PAH",332,1,15,0)="       '6 DRUG REACTION'"
^DIC(9.4,60,22,13,"PAH",332,1,16,0)="       '7 BAD ADDRESS'"
^DIC(9.4,60,22,13,"PAH",332,1,17,0)="       '8 PER PATIENT REQUEST'"
^DIC(9.4,60,22,13,"PAH",332,1,18,0)="       '99 OTHER--SEE COMMENTS'"
^DIC(9.4,60,22,13,"PAH",332,1,19,0)="  "
^DIC(9.4,60,22,13,"PAH",332,1,20,0)="        As per the recommendation of the Pharmacy User Group the "
^DIC(9.4,60,22,13,"PAH",332,1,21,0)="        following changes were made to the set of codes:"
^DIC(9.4,60,22,13,"PAH",332,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,23,0)="        The following new codes were added:"
^DIC(9.4,60,22,13,"PAH",332,1,24,0)="        '9 CONSULT/PRIOR APPROVAL NEEDED'"
^DIC(9.4,60,22,13,"PAH",332,1,25,0)="        '98 OTHER/TECH (NON-CLINICAL)'"
^DIC(9.4,60,22,13,"PAH",332,1,26,0)="        "
^DIC(9.4,60,22,13,"PAH",332,1,27,0)="        The following code descriptions were modified:"
^DIC(9.4,60,22,13,"PAH",332,1,28,0)="        '4 PHYSICIAN TO BE CONTACTED' to '4 PROVIDER TO BE CONTACTED'"
^DIC(9.4,60,22,13,"PAH",332,1,29,0)="        '6 DRUG REACTION' to '6 ADVERSE DRUG REACTION'"
^DIC(9.4,60,22,13,"PAH",332,1,30,0)="        '99 OTHER--SEE COMMENTS' to 'OTHER/RPH (CLINICAL)'"
^DIC(9.4,60,22,13,"PAH",332,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,32,0)="        The following codes were removed as they were redundant and code"
^DIC(9.4,60,22,13,"PAH",332,1,33,0)="        '6 ADVERSE DRUG REACTION' to be used in its place:"
^DIC(9.4,60,22,13,"PAH",332,1,34,0)="        '3 PATIENT REACTION' "
^DIC(9.4,60,22,13,"PAH",332,1,35,0)="        '5 ALLERGY REACTIONS' "
^DIC(9.4,60,22,13,"PAH",332,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,37,0)="        Note:"
^DIC(9.4,60,22,13,"PAH",332,1,38,0)="        A post-install routine has been included in this patch that will"
^DIC(9.4,60,22,13,"PAH",332,1,39,0)="        convert the historical data of codes '3' and '5' to code '6'. "
^DIC(9.4,60,22,13,"PAH",332,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,41,0)="        On complete installation of this patch, the HOLD REASON field "
^DIC(9.4,60,22,13,"PAH",332,1,42,0)="        (#99) of the PRESCRIPTION file (#52) will have the following set"
^DIC(9.4,60,22,13,"PAH",332,1,43,0)="        of codes:"
^DIC(9.4,60,22,13,"PAH",332,1,44,0)="        '1 INSUFFICIENT QTY IN STOCK'"
^DIC(9.4,60,22,13,"PAH",332,1,45,0)="        '2 DRUG-DRUG INTERACTION'"
^DIC(9.4,60,22,13,"PAH",332,1,46,0)="        '4 PROVIDER TO BE CONTACTED'"
^DIC(9.4,60,22,13,"PAH",332,1,47,0)="        '6 ADVERSE DRUG REACTION'"
^DIC(9.4,60,22,13,"PAH",332,1,48,0)="        '7 BAD ADDRESS'"
^DIC(9.4,60,22,13,"PAH",332,1,49,0)="        '8 PER PATIENT REQUEST'"
^DIC(9.4,60,22,13,"PAH",332,1,50,0)="        '9 CONSULT/PRIOR APPROVAL NEEDED'"
^DIC(9.4,60,22,13,"PAH",332,1,51,0)="        '98 OTHER/TECH (NON-CLINICAL)'"
^DIC(9.4,60,22,13,"PAH",332,1,52,0)="        '99 OTHER/RPH (CLINICAL)'"
^DIC(9.4,60,22,13,"PAH",332,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,54,0)="   b. New Security Key PSO TECH ADV for pharmacy technicians"
^DIC(9.4,60,22,13,"PAH",332,1,55,0)="      A new security key called PSO TECH ADV has been created, which "
^DIC(9.4,60,22,13,"PAH",332,1,56,0)="      will allow a user to HOLD a prescription using one of the following"
^DIC(9.4,60,22,13,"PAH",332,1,57,0)="      HOLD reasons, which are a subset of the hold reasons that are"
^DIC(9.4,60,22,13,"PAH",332,1,58,0)="      available to the PSORPH key holders in item (a) above:"
^DIC(9.4,60,22,13,"PAH",332,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,60,0)="      '1 INSUFFICIENT QTY IN STOCK'"
^DIC(9.4,60,22,13,"PAH",332,1,61,0)="      '7 BAD ADDRESS'"
^DIC(9.4,60,22,13,"PAH",332,1,62,0)="      '8 PER PATIENT REQUEST'"
^DIC(9.4,60,22,13,"PAH",332,1,63,0)="      '98 OTHER/TECH (NON-CLINICAL)'"
^DIC(9.4,60,22,13,"PAH",332,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,65,0)="      The PSO TECH ADV key holders will be able to remove a prescription"
^DIC(9.4,60,22,13,"PAH",332,1,66,0)="      from HOLD only for the above hold reasons whether they were put "
^DIC(9.4,60,22,13,"PAH",332,1,67,0)="      on HOLD by the PSORPH key holder or by the PSO TECH ADV key holder."
^DIC(9.4,60,22,13,"PAH",332,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,69,0)="   c. UNHOLD Comments"
^DIC(9.4,60,22,13,"PAH",332,1,70,0)="      The UNHOLD action has been modified to display the original hold "
^DIC(9.4,60,22,13,"PAH",332,1,71,0)="      reason along with the hold comments (if any) as seen in the example"
^DIC(9.4,60,22,13,"PAH",332,1,72,0)="      below:"
^DIC(9.4,60,22,13,"PAH",332,1,73,0)="      "
^DIC(9.4,60,22,13,"PAH",332,1,74,0)="+---------------------------------------------------------------------+"
^DIC(9.4,60,22,13,"PAH",332,1,75,0)="| Select Action: Next Screen// UH   UH  UNHOLD                        |"
^DIC(9.4,60,22,13,"PAH",332,1,76,0)="| Nature of Order: WRITTEN//        W                                 |"
^DIC(9.4,60,22,13,"PAH",332,1,77,0)="|                                                                     |"
^DIC(9.4,60,22,13,"PAH",332,1,78,0)="| HOLD COMMENTS: HOLD COMMENTS ENTERED BY THE USER MANUALLY. (REASON: |"
^DIC(9.4,60,22,13,"PAH",332,1,79,0)="|                BAD ADDRESS) on MAY 10, 2012                         |"
^DIC(9.4,60,22,13,"PAH",332,1,80,0)="|                                                                     |"
^DIC(9.4,60,22,13,"PAH",332,1,81,0)="| UNHOLD COMMENTS:                                                    |"
^DIC(9.4,60,22,13,"PAH",332,1,82,0)="+---------------------------------------------------------------------+"
^DIC(9.4,60,22,13,"PAH",332,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,84,0)="   d. Rx Activity Log"
^DIC(9.4,60,22,13,"PAH",332,1,85,0)="      All activities related to HOLD/UNHOLD action on a prescription will"
^DIC(9.4,60,22,13,"PAH",332,1,86,0)="      be captured in the activity log as seen below:"
^DIC(9.4,60,22,13,"PAH",332,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,88,0)="     "
^DIC(9.4,60,22,13,"PAH",332,1,89,0)="+---------------------------------------------------------------------+"
^DIC(9.4,60,22,13,"PAH",332,1,90,0)="| Activity Log:                                                       |"
^DIC(9.4,60,22,13,"PAH",332,1,91,0)="| #   Date        Reason         Rx Ref         Initiator Of Activity |"
^DIC(9.4,60,22,13,"PAH",332,1,92,0)="| ...                                                                 |"
^DIC(9.4,60,22,13,"PAH",332,1,93,0)="| 8   05/10/12    HOLD           REFILL 1       USER,PHARMACY         |"
^DIC(9.4,60,22,13,"PAH",332,1,94,0)="| Comments: Rx placed on HOLD (Reason: BAD ADDRESS) and removed from  |"
^DIC(9.4,60,22,13,"PAH",332,1,95,0)="|           SUSPENSE - HOLD COMMENTS ENTERED BY THE USER MANUALLY.    |"
^DIC(9.4,60,22,13,"PAH",332,1,96,0)="| ...                                                                 |"
^DIC(9.4,60,22,13,"PAH",332,1,97,0)="| 9   05/10/12    UNHOLD         REFILL 1       USER,PHARMACY         |"
^DIC(9.4,60,22,13,"PAH",332,1,98,0)="| Comments: Rx Removed from HOLD - UNHOLD COMMENTS ENTERED BY THE USER|"
^DIC(9.4,60,22,13,"PAH",332,1,99,0)="|           WHEN REMOVING THE RX FROM HOLD.                           |"
^DIC(9.4,60,22,13,"PAH",332,1,100,0)="+---------------------------------------------------------------------+"
^DIC(9.4,60,22,13,"PAH",332,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,102,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,103,0)="2. Flagging/Unflagging of a pending renewal order"
^DIC(9.4,60,22,13,"PAH",332,1,104,0)="   ----------------------------------------------"
^DIC(9.4,60,22,13,"PAH",332,1,105,0)="   The flagging/unflagging functionality was limited to new pending orders"
^DIC(9.4,60,22,13,"PAH",332,1,106,0)="   only from Computerized Patient Record System (CPRS) V. 3.0. Changes"
^DIC(9.4,60,22,13,"PAH",332,1,107,0)="   were made to extend this functionality to pending renewal orders from"
^DIC(9.4,60,22,13,"PAH",332,1,108,0)="   CPRS as well."
^DIC(9.4,60,22,13,"PAH",332,1,109,0)="   Note: Flagging/Unflagging is a functionality for the pharmacist (PSORPH"
^DIC(9.4,60,22,13,"PAH",332,1,110,0)="         key holders) only."
^DIC(9.4,60,22,13,"PAH",332,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,112,0)="3. Non-holders of PSORPH key were able to unflag pending orders"
^DIC(9.4,60,22,13,"PAH",332,1,113,0)="   ------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",332,1,114,0)="   The action FL (Flag/Unflag) is blocked for users without the PSORPH"
^DIC(9.4,60,22,13,"PAH",332,1,115,0)="   key when finishing a new pending order. However, if the user selected "
^DIC(9.4,60,22,13,"PAH",332,1,116,0)="   FN (Finish) to finish a new flagged pending order the software was"
^DIC(9.4,60,22,13,"PAH",332,1,117,0)="   allowing the user to unflag the pending order. This has been changed"
^DIC(9.4,60,22,13,"PAH",332,1,118,0)="   to no longer allow non-holders of the PSORPH key to unflag pending "
^DIC(9.4,60,22,13,"PAH",332,1,119,0)="   orders."
^DIC(9.4,60,22,13,"PAH",332,1,120,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,121,0)="4. Non PSORPH key holder access to Edit/DC actions"
^DIC(9.4,60,22,13,"PAH",332,1,122,0)="   -----------------------------------------------"
^DIC(9.4,60,22,13,"PAH",332,1,123,0)="   When processing pending new/renewal orders from CPRS, a non PSORPH key"
^DIC(9.4,60,22,13,"PAH",332,1,124,0)="   holder could use the actions 'Edit' or 'Discontinue' on the order, "
^DIC(9.4,60,22,13,"PAH",332,1,125,0)="   which should not be allowed. This functionality has been disabled."
^DIC(9.4,60,22,13,"PAH",332,1,126,0)=" "
^DIC(9.4,60,22,13,"PAH",332,1,127,0)="5. COMMENT field (#.05) in the ACTIVITY LOG sub-file (#52.3) of the "
^DIC(9.4,60,22,13,"PAH",332,1,128,0)="   PRESCRIPTION file (#52)"
^DIC(9.4,60,22,13,"PAH",332,1,129,0)="   ----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",332,1,130,0)="   The length of this field has been increased from 75 to 100 characters"
^DIC(9.4,60,22,13,"PAH",332,1,131,0)="   long to accommodate HOLD and UNHOLD comments."
^DIC(9.4,60,22,13,"PAH",332,1,132,0)="  "
^DIC(9.4,60,22,13,"PAH",332,1,133,0)="6. PSO52API API (Application Programming Interface)"
^DIC(9.4,60,22,13,"PAH",332,1,134,0)="   ------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",332,1,135,0)="   This API was modified to check if the prescription's expiration date "
^DIC(9.4,60,22,13,"PAH",332,1,136,0)="   is in the past. If it is and the current prescription status is not"
^DIC(9.4,60,22,13,"PAH",332,1,137,0)="   DISCONTINUED, DELETED, or EXPIRED, the API will update the prescription"
^DIC(9.4,60,22,13,"PAH",332,1,138,0)="   status to EXPIRED. The API will also send updates to CPRS and Health"
^DIC(9.4,60,22,13,"PAH",332,1,139,0)="   Data Repository (HDR) of the status change."
^DIC(9.4,60,22,13,"PAH",333,0)="400 SEQ #343^3121024.100325^17"
^DIC(9.4,60,22,13,"PAH",333,1,0)="^^4^4^3121024"
^DIC(9.4,60,22,13,"PAH",333,1,1,0)="This patch resolves the following issue:"
^DIC(9.4,60,22,13,"PAH",333,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",333,1,3,0)="Users receive a message in error while entering the dosage in Patient"
^DIC(9.4,60,22,13,"PAH",333,1,4,0)="Prescription Processing."
^DIC(9.4,60,22,13,"PAH",334,0)="405 SEQ #344^3130131.150627^17"
^DIC(9.4,60,22,13,"PAH",334,1,0)="^^6^6^3130131"
^DIC(9.4,60,22,13,"PAH",334,1,1,0)="The same last 4 digits of the SSN prints for every patient with Non-VA "
^DIC(9.4,60,22,13,"PAH",334,1,2,0)="meds and no prescriptions when running the Poly Pharmacy Report for ALL "
^DIC(9.4,60,22,13,"PAH",334,1,3,0)="patients."
^DIC(9.4,60,22,13,"PAH",334,1,4,0)="An undefined error occurs when running the Poly Pharmacy Report for one "
^DIC(9.4,60,22,13,"PAH",334,1,5,0)="patient that has Non-VA Meds and no prescriptions."
^DIC(9.4,60,22,13,"PAH",334,1,6,0)="The display of the CMOP suspense date is truncated on a reinstate."
^DIC(9.4,60,22,13,"PAH",335,0)="390 SEQ #345^3130212.10384^17"
^DIC(9.4,60,22,13,"PAH",336,0)="417 SEQ #346^3130212.103846^17"
^DIC(9.4,60,22,13,"PAH",336,1,0)="^^11^11^3130212"
^DIC(9.4,60,22,13,"PAH",336,1,1,0)="This build is to be installed immediately after PSO*7.0*390 to"
^DIC(9.4,60,22,13,"PAH",336,1,2,0)="correct a potential undefined error when renewing prescriptions"
^DIC(9.4,60,22,13,"PAH",336,1,3,0)="without drug allergies.  CCR6153."
^DIC(9.4,60,22,13,"PAH",336,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",336,1,5,0)="2. Updated the second lines of the following routines: "
^DIC(9.4,60,22,13,"PAH",336,1,6,0)="  a. Added patch number 388 to 2nd line of PSORENW and fixed typo. "
^DIC(9.4,60,22,13,"PAH",336,1,7,0)="  b. Added patch number 387 to 2nd line PSORXI (no code changes needed).  "
^DIC(9.4,60,22,13,"PAH",336,1,8,0)="  (CCR6213).  "
^DIC(9.4,60,22,13,"PAH",336,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",336,1,10,0)="3. Corrected a potential SUBSCRIPT error reported by test site (Boston) "
^DIC(9.4,60,22,13,"PAH",336,1,11,0)=" (CCR6212).  "
^DIC(9.4,60,22,13,"PAH",337,0)="409 SEQ #347^3130227.173956^17"
^DIC(9.4,60,22,13,"PAH",337,1,0)="^^2^2^3130227"
^DIC(9.4,60,22,13,"PAH",337,1,1,0)="An incorrect message diplays in the message box while viewing a prescription"
^DIC(9.4,60,22,13,"PAH",337,1,2,0)="in the following option: PSO VIEW."
^DIC(9.4,60,22,13,"PAH",338,0)="364 SEQ #348^3130305.150855^17"
^DIC(9.4,60,22,13,"PAH",338,1,0)="^^3^3^3130305"
^DIC(9.4,60,22,13,"PAH",338,1,1,0)="This patch will resolve the issue where the LAST LOCAL NDC code is being "
^DIC(9.4,60,22,13,"PAH",338,1,2,0)="stored in the NDC BY OUTPATIENT SITE sub-file of the DRUG file for non"
^DIC(9.4,60,22,13,"PAH",338,1,3,0)="E-PAYABLE drugs."
^DIC(9.4,60,22,13,"PAH",339,0)="333 SEQ #349^3130319.112019^17"
^DIC(9.4,60,22,13,"PAH",339,1,0)="^^3^3^3130319"
^DIC(9.4,60,22,13,"PAH",339,1,1,0)="This patch contains a fix for the issues summarized below:"
^DIC(9.4,60,22,13,"PAH",339,1,2,0)=" 1. Undefined error during OPAI HL7 generation for Other Language Sig."
^DIC(9.4,60,22,13,"PAH",339,1,3,0)=" 2. Noun missing from sig on label when Print from Suspense"
^DIC(9.4,60,22,13,"PAH",340,0)="374 SEQ #350^3130326.110937^17"
^DIC(9.4,60,22,13,"PAH",340,1,0)="^^3^3^3130326"
^DIC(9.4,60,22,13,"PAH",340,1,1,0)="This patch deals the following issue:"
^DIC(9.4,60,22,13,"PAH",340,1,2,0)="CS vault updates more than once if the user fails to enter a"
^DIC(9.4,60,22,13,"PAH",340,1,3,0)="reason for removing the Rx copay"
^DIC(9.4,60,22,13,"PAH",341,0)="415 SEQ #351^3130416.102558^17"
^DIC(9.4,60,22,13,"PAH",341,1,0)="^^2^2^3130416"
^DIC(9.4,60,22,13,"PAH",341,1,1,0)="Users get an ""end of file"" error after running the TRICARE CHAMPVA"
^DIC(9.4,60,22,13,"PAH",341,1,2,0)=" Bypass/Override Report"
^DIC(9.4,60,22,13,"PAH",342,0)="410 SEQ #352^3130429.141535^17"
^DIC(9.4,60,22,13,"PAH",342,1,0)="^^4^4^3130429"
^DIC(9.4,60,22,13,"PAH",342,1,1,0)="When processing Pending Orders in Outpatient Pharmacy, the system hangs"
^DIC(9.4,60,22,13,"PAH",342,1,2,0)="if any word in the Provider Comments is longer than 60 characters and"
^DIC(9.4,60,22,13,"PAH",342,1,3,0)="has a special delimiter (;,=:) after character position 57. If this "
^DIC(9.4,60,22,13,"PAH",342,1,4,0)="process continues to run, a <FILEFULL> error will occur."
^DIC(9.4,60,22,13,"PAH",343,0)="413 SEQ #353^3130507.152909^17"
^DIC(9.4,60,22,13,"PAH",343,1,0)="^^5^5^3130507"
^DIC(9.4,60,22,13,"PAH",343,1,1,0)="The DISCONTINUE PRESCRIPTION(S) option aborts when a prescription is   "
^DIC(9.4,60,22,13,"PAH",343,1,2,0)="processed on a deceased patient."
^DIC(9.4,60,22,13,"PAH",343,1,3,0)="                                           "
^DIC(9.4,60,22,13,"PAH",343,1,4,0)="User is able to discontinue a prescription that has been ""marked for "
^DIC(9.4,60,22,13,"PAH",343,1,5,0)="deletion"".  This should not be allowed."
^DIC(9.4,60,22,13,"PAH",344,0)="378 SEQ #354^3130516.174425^17"
^DIC(9.4,60,22,13,"PAH",344,1,0)="^^3^3^3130516"
^DIC(9.4,60,22,13,"PAH",344,1,1,0)="This patch will resolve the issue when a user edits the first ROUTE of a "
^DIC(9.4,60,22,13,"PAH",344,1,2,0)="complex prescription from ORAL to SUBLINGUAL, prior to accepting, the "
^DIC(9.4,60,22,13,"PAH",344,1,3,0)="UNDER THE TOUGUE will echo to the second occurrence."
^DIC(9.4,60,22,13,"PAH",345,0)="391^3130614.090225^17"
^DIC(9.4,60,22,13,"PAH",345,1,0)="^^284^284^3130614"
^DIC(9.4,60,22,13,"PAH",345,1,1,0)="This patch is being released as part of the DEA e-Prescribing of"
^DIC(9.4,60,22,13,"PAH",345,1,2,0)="Controlled Substances (CS) project using Public Key Infrastructure (PKI)"
^DIC(9.4,60,22,13,"PAH",345,1,3,0)="to satisfy requirements requested by the Drug Enforcement Administration"
^DIC(9.4,60,22,13,"PAH",345,1,4,0)="(DEA)."
^DIC(9.4,60,22,13,"PAH",345,1,5,0)="The applications involved in this project along with their patch numbers "
^DIC(9.4,60,22,13,"PAH",345,1,6,0)="are listed below and the same order should be followed when installing "
^DIC(9.4,60,22,13,"PAH",345,1,7,0)="the patches."
^DIC(9.4,60,22,13,"PAH",345,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,9,0)="   APPLICATION                                            PATCH"
^DIC(9.4,60,22,13,"PAH",345,1,10,0)="   -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",345,1,11,0)="   KERNEL V. 8.0                                          XU*8*580"
^DIC(9.4,60,22,13,"PAH",345,1,12,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                  PSS*1*166"
^DIC(9.4,60,22,13,"PAH",345,1,13,0)="   COMPUTERIZED PATIENT RECORD SYSTEM (CPRS) V. 3.0       OR*3*306"
^DIC(9.4,60,22,13,"PAH",345,1,14,0)="   CONTROLLED SUBSTANCES (CS) V. 3.0                      PSD*3*73"
^DIC(9.4,60,22,13,"PAH",345,1,15,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                        PSO*7*391"
^DIC(9.4,60,22,13,"PAH",345,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,17,0)="Note:"
^DIC(9.4,60,22,13,"PAH",345,1,18,0)="1. A new security key named ""PSDRPH"", has been sent out in the Controlled"
^DIC(9.4,60,22,13,"PAH",345,1,19,0)="   Substances patch PSD*3*76, which is a required patch for this patch."
^DIC(9.4,60,22,13,"PAH",345,1,20,0)="   This key authorizes pharmacists to finish/verify a digitally signed"
^DIC(9.4,60,22,13,"PAH",345,1,21,0)="   Schedule II-V CS orders placed via CPRS and should be assigned to"
^DIC(9.4,60,22,13,"PAH",345,1,22,0)="   registered pharmacists working with Schedule II-V drugs."
^DIC(9.4,60,22,13,"PAH",345,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,24,0)="2. Patches PSO*7*391 and PSD*3*73 are being released in the Kernel "
^DIC(9.4,60,22,13,"PAH",345,1,25,0)="   Installation and Distribution System (KIDS) multi-build distribution"
^DIC(9.4,60,22,13,"PAH",345,1,26,0)="   CPRSV29_PSO_PSD. "
^DIC(9.4,60,22,13,"PAH",345,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,28,0)="The following modifications and enhancements are included in this patch "
^DIC(9.4,60,22,13,"PAH",345,1,29,0)="(PSO*7*391):"
^DIC(9.4,60,22,13,"PAH",345,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,31,0)="1. When processing a digitally signed pending order, the integrity of the "
^DIC(9.4,60,22,13,"PAH",345,1,32,0)="original order placed in CPRS is now being checked to ensure that the data"
^DIC(9.4,60,22,13,"PAH",345,1,33,0)="fields listed below are not altered from the time the order is signed in"
^DIC(9.4,60,22,13,"PAH",345,1,34,0)="CPRS and later selected for processing in backdoor pharmacy. This is done"
^DIC(9.4,60,22,13,"PAH",345,1,35,0)="by passing the data elements listed below to a Kernel Application"
^DIC(9.4,60,22,13,"PAH",345,1,36,0)="Programming Interface (API), Integration Control Registration (ICR) #3539,"
^DIC(9.4,60,22,13,"PAH",345,1,37,0)="along with the CPRS hash count, provided by ICR #5709. The Kernel API"
^DIC(9.4,60,22,13,"PAH",345,1,38,0)="compares these two hash values and returns an ""OK"" if the pending order is"
^DIC(9.4,60,22,13,"PAH",345,1,39,0)="unaltered or otherwise, returns a ""-1^error code^error message."""
^DIC(9.4,60,22,13,"PAH",345,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,41,0)="Example: ""-1^89802016^Mismatched digital signature hash values."""
^DIC(9.4,60,22,13,"PAH",345,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,43,0)="These are the fields used in the hash check:"
^DIC(9.4,60,22,13,"PAH",345,1,44,0)="        Date of Issuance"
^DIC(9.4,60,22,13,"PAH",345,1,45,0)="        Full Name and Address of the Patient"
^DIC(9.4,60,22,13,"PAH",345,1,46,0)="        Drug Name"
^DIC(9.4,60,22,13,"PAH",345,1,47,0)="        Quantity Prescribed  "
^DIC(9.4,60,22,13,"PAH",345,1,48,0)="        Directions for Use"
^DIC(9.4,60,22,13,"PAH",345,1,49,0)="        Prescriber Name   "
^DIC(9.4,60,22,13,"PAH",345,1,50,0)="        Prescriber Address (site address) "
^DIC(9.4,60,22,13,"PAH",345,1,51,0)="        Prescriber DEA / VA Registration Number"
^DIC(9.4,60,22,13,"PAH",345,1,52,0)="        Order Number (CPRS)"
^DIC(9.4,60,22,13,"PAH",345,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,54,0)="The Kernel API will also check for the validity of the DEA certificate. If"
^DIC(9.4,60,22,13,"PAH",345,1,55,0)="the certificate is revoked or expired then the API will return the"
^DIC(9.4,60,22,13,"PAH",345,1,56,0)="appropriate error code."
^DIC(9.4,60,22,13,"PAH",345,1,57,0)="If the error code is related to hash mismatch or the DEA certificate is"
^DIC(9.4,60,22,13,"PAH",345,1,58,0)="revoked then the following events will be triggered during pending order"
^DIC(9.4,60,22,13,"PAH",345,1,59,0)="processing:"
^DIC(9.4,60,22,13,"PAH",345,1,60,0)="  The order will be auto discontinued."
^DIC(9.4,60,22,13,"PAH",345,1,61,0)="  First line of the pending order screen will have the message ""Digital"
^DIC(9.4,60,22,13,"PAH",345,1,62,0)="  Signature Failed: Corrupted (Hash mismatch)"" or ""Certificate revoked"""
^DIC(9.4,60,22,13,"PAH",345,1,63,0)="  concatenated with ""Order Auto Discontinued"", and the message will be"
^DIC(9.4,60,22,13,"PAH",345,1,64,0)="  highlighted in reverse video."
^DIC(9.4,60,22,13,"PAH",345,1,65,0)="  The status bar of the screen will have the message ""Signature Failed: "
^DIC(9.4,60,22,13,"PAH",345,1,66,0)="  Corrupted (Hash mismatch)"" or Certificate revoked."""
^DIC(9.4,60,22,13,"PAH",345,1,67,0)="  A mail message will be generated to the holders of the PSDMGR key "
^DIC(9.4,60,22,13,"PAH",345,1,68,0)="  notifying that the order has been auto discontinued (similar to the "
^DIC(9.4,60,22,13,"PAH",345,1,69,0)="  example listed below)."
^DIC(9.4,60,22,13,"PAH",345,1,70,0)="  If the discontinuation is due to a hash mismatch as a result of altering"
^DIC(9.4,60,22,13,"PAH",345,1,71,0)="  one of the fields listed above then the mail message will show the"
^DIC(9.4,60,22,13,"PAH",345,1,72,0)="  altered fields with the discrepancies. Here is an example:"
^DIC(9.4,60,22,13,"PAH",345,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,74,0)="  Subj: DIGITALLY SIGNED NEW ORDER AUTO DISCONTINUED  [#196353] "
^DIC(9.4,60,22,13,"PAH",345,1,75,0)="        03/20/12@17:1024 lines"
^DIC(9.4,60,22,13,"PAH",345,1,76,0)="  From: POSTMASTER  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",345,1,77,0)="         "
^DIC(9.4,60,22,13,"PAH",345,1,78,0)="  -----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",345,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,80,0)="  Following order was auto discontinued when finishing a pending order   "
^DIC(9.4,60,22,13,"PAH",345,1,81,0)="  due to Corrupted (Hash mismatch) - 89802016"
^DIC(9.4,60,22,13,"PAH",345,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,83,0)="  Division      : GREELEY CLINIC"
^DIC(9.4,60,22,13,"PAH",345,1,84,0)="  CPRS Order #  : 5587651"
^DIC(9.4,60,22,13,"PAH",345,1,85,0)="  Issue Date    : MAR 7,2012"
^DIC(9.4,60,22,13,"PAH",345,1,86,0)="  Patient       : TEST,PATIENT (0908)"
^DIC(9.4,60,22,13,"PAH",345,1,87,0)="  Address       : P.O. BOX 31"
^DIC(9.4,60,22,13,"PAH",345,1,88,0)="                  LAPORTE, CA  95981"
^DIC(9.4,60,22,13,"PAH",345,1,89,0)="  Drug          : CODEINE SULFATE 60MG TAB"
^DIC(9.4,60,22,13,"PAH",345,1,90,0)="  Dosage Ordered: 120(MG)"
^DIC(9.4,60,22,13,"PAH",345,1,91,0)="  Dosage Form   : TABLETS"
^DIC(9.4,60,22,13,"PAH",345,1,92,0)="  Quantity      : 54"
^DIC(9.4,60,22,13,"PAH",345,1,93,0)="  Provider      : TEST,PROVIDER"
^DIC(9.4,60,22,13,"PAH",345,1,94,0)="  DEA#          : TA1234563"
^DIC(9.4,60,22,13,"PAH",345,1,95,0)="  Site Address  : 2360 E PERSHING BLVD"
^DIC(9.4,60,22,13,"PAH",345,1,96,0)="                  2360 East Pershing Boulevard"
^DIC(9.4,60,22,13,"PAH",345,1,97,0)="                  CHEYENNE"
^DIC(9.4,60,22,13,"PAH",345,1,98,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,99,0)="  Differences in CPRS and Pharmacy Pending File"
^DIC(9.4,60,22,13,"PAH",345,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,101,0)="  Data Name           CPRS File         Pharmacy Pending File"
^DIC(9.4,60,22,13,"PAH",345,1,102,0)="  ---------           ---------         ---------------------"
^DIC(9.4,60,22,13,"PAH",345,1,103,0)="  QTY PRESCRIBED      15                30"
^DIC(9.4,60,22,13,"PAH",345,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,105,0)="         "
^DIC(9.4,60,22,13,"PAH",345,1,106,0)="  If the error code is related to 'certificate expired', the pending "
^DIC(9.4,60,22,13,"PAH",345,1,107,0)="  order will be processed (will not be auto discontinued) and a "
^DIC(9.4,60,22,13,"PAH",345,1,108,0)="  notification will be sent to the provider with the message, ""DEA"
^DIC(9.4,60,22,13,"PAH",345,1,109,0)="  certificate expired. Renew your certificate."""
^DIC(9.4,60,22,13,"PAH",345,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,111,0)="2. When finishing a pending CS order, if the user does not hold the new "
^DIC(9.4,60,22,13,"PAH",345,1,112,0)="   PSDRPH security key, the order will be marked as 'Non-Verified'."
^DIC(9.4,60,22,13,"PAH",345,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,114,0)="3. To verify a 'Non-Verified' CS order, PSDRPH security key is now"
^DIC(9.4,60,22,13,"PAH",345,1,115,0)="   required."
^DIC(9.4,60,22,13,"PAH",345,1,116,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,117,0)="4. To discontinue a pending CS order, PSDRPH security key is now required."
^DIC(9.4,60,22,13,"PAH",345,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,119,0)="5. The pending order screen will now display the provider's DEA/VA #, the "
^DIC(9.4,60,22,13,"PAH",345,1,120,0)="   DETOX# (if available) and the site address."
^DIC(9.4,60,22,13,"PAH",345,1,121,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,122,0)="6. When finishing a new pending CS order, the orderable item, dosage, "
^DIC(9.4,60,22,13,"PAH",345,1,123,0)="   provider name, or the number of refills will not be allowed to be "
^DIC(9.4,60,22,13,"PAH",345,1,124,0)="   edited. Also, if the changes to the dispense drug would result in"
^DIC(9.4,60,22,13,"PAH",345,1,125,0)="   a new order being created, this will not be allowed for digitally "
^DIC(9.4,60,22,13,"PAH",345,1,126,0)="   signed orders. The user WILL be allowed to select other dispense drugs "
^DIC(9.4,60,22,13,"PAH",345,1,127,0)="   for the same Orderable Item as long as it does not change the "
^DIC(9.4,60,22,13,"PAH",345,1,128,0)="   prescribed dosage."
^DIC(9.4,60,22,13,"PAH",345,1,129,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,130,0)="7. When finishing a new pending CS order, the days supply or the quantity"
^DIC(9.4,60,22,13,"PAH",345,1,131,0)="   will not be allowed to increase, but can be decreased. If the days"
^DIC(9.4,60,22,13,"PAH",345,1,132,0)="   supply is decreased, the number of refills will also be adjusted "
^DIC(9.4,60,22,13,"PAH",345,1,133,0)="   accordingly depending on the drug setup (maximum refills, not "
^DIC(9.4,60,22,13,"PAH",345,1,134,0)="   refillable etc)."
^DIC(9.4,60,22,13,"PAH",345,1,135,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,136,0)="8. In patch PSO*7*99, a change was made for pending orders not to "
^DIC(9.4,60,22,13,"PAH",345,1,137,0)="   recalculate the quantity for CS drugs on selecting a different strength"
^DIC(9.4,60,22,13,"PAH",345,1,138,0)="   of the same drug and resulting in the same prescribed dosage. This"
^DIC(9.4,60,22,13,"PAH",345,1,139,0)="   change is removed in this patch."
^DIC(9.4,60,22,13,"PAH",345,1,140,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,141,0)="9. When finishing a pending CS order or verifying a CS order by the PSDRPH"
^DIC(9.4,60,22,13,"PAH",345,1,142,0)="   key holder, any edit to some of the key fields like dispense drug,"
^DIC(9.4,60,22,13,"PAH",345,1,143,0)="   dosage, dispense units, issue date, day's supply, quantity or number of"
^DIC(9.4,60,22,13,"PAH",345,1,144,0)="   refills, will now be captured and stored in the activity log."
^DIC(9.4,60,22,13,"PAH",345,1,145,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,146,0)="10. In the Complete Orders From OERR [PSO LMOE FINISH] option, a new sort "
^DIC(9.4,60,22,13,"PAH",345,1,147,0)="    selection, 'CS' is included to select digitally signed CS orders "
^DIC(9.4,60,22,13,"PAH",345,1,148,0)="    separately."
^DIC(9.4,60,22,13,"PAH",345,1,149,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,150,0)="11. A new field BACKDOOR SIGNATURE STATUS (#311) is being added to the "
^DIC(9.4,60,22,13,"PAH",345,1,151,0)="    PRESCRIPTION file (#52) and will be set to '1' to indicate that the CS"
^DIC(9.4,60,22,13,"PAH",345,1,152,0)="    order was entered via pharmacy backdoor and was not digitally signed."
^DIC(9.4,60,22,13,"PAH",345,1,153,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,154,0)="12. A new field, DIRECTIONS FOR USE (#120) is being added to the PENDING"
^DIC(9.4,60,22,13,"PAH",345,1,155,0)="    OUTPATIENT ORDERS file (#52.41) to store the raw HEALTH LEVEL SEVEN"
^DIC(9.4,60,22,13,"PAH",345,1,156,0)="    (HL7) dosage data as sent from CPRS. This will be used to validate the"
^DIC(9.4,60,22,13,"PAH",345,1,157,0)="    integrity (hash count) against the CPRS digitally signed orders."
^DIC(9.4,60,22,13,"PAH",345,1,158,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,159,0)="13. Currently, the pending order screen displays only the number of "
^DIC(9.4,60,22,13,"PAH",345,1,160,0)="    refills ordered by the provider. For digitally signed orders, this"
^DIC(9.4,60,22,13,"PAH",345,1,161,0)="    is modified to include the days supply and the quantity. Here is a"
^DIC(9.4,60,22,13,"PAH",345,1,162,0)="    screen capture:"
^DIC(9.4,60,22,13,"PAH",345,1,163,0)="    (6)    Issue Date: SEP 17,2012        (7) Fill Date: SEP 17,2012"
^DIC(9.4,60,22,13,"PAH",345,1,164,0)="    (8)    Days Supply: 45                (9)   QTY (  ): 45"
^DIC(9.4,60,22,13,"PAH",345,1,165,0)="   Provider ordered: days supply 45, quantity 45 & refills 1    "
^DIC(9.4,60,22,13,"PAH",345,1,166,0)="   (10)   # of Refills: 1                (11)  Routing: WINDOW"
^DIC(9.4,60,22,13,"PAH",345,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,168,0)="14. The protocols PSO LM ACCEPT and PSO LM RENEW MENU are being modified"
^DIC(9.4,60,22,13,"PAH",345,1,169,0)="    to add code to the SCREEN field (#24) and the HEADER field (#26) of"
^DIC(9.4,60,22,13,"PAH",345,1,170,0)="    the PROTOCOL file (#101) to ensure users are limited to ListMan"
^DIC(9.4,60,22,13,"PAH",345,1,171,0)="    actions based on their security key."
^DIC(9.4,60,22,13,"PAH",345,1,172,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,173,0)="15. As part of this project, Kernel patch XU*8*580 introduced the "
^DIC(9.4,60,22,13,"PAH",345,1,174,0)="    following new fields to the NEW PERSON file (#200). Apart from the "
^DIC(9.4,60,22,13,"PAH",345,1,175,0)="    DEA#/VA# requirement, DEA further classifies what CS schedule a"
^DIC(9.4,60,22,13,"PAH",345,1,176,0)="    provider is authorized to write. "
^DIC(9.4,60,22,13,"PAH",345,1,177,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,178,0)="    55.1      SCHEDULE II NARCOTIC (S), [PS3;1]"
^DIC(9.4,60,22,13,"PAH",345,1,179,0)="    55.2      SCHEDULE II NON-NARCOTIC (S), [PS3;2]"
^DIC(9.4,60,22,13,"PAH",345,1,180,0)="    55.3      SCHEDULE III NARCOTIC (S), [PS3;3]"
^DIC(9.4,60,22,13,"PAH",345,1,181,0)="    55.4      SCHEDULE III NON-NARCOTIC (S), [PS3;4]"
^DIC(9.4,60,22,13,"PAH",345,1,182,0)="    55.5      SCHEDULE IV (S), [PS3;5]"
^DIC(9.4,60,22,13,"PAH",345,1,183,0)="    55.6      SCHEDULE V (S), [PS3;6]"
^DIC(9.4,60,22,13,"PAH",345,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,185,0)="    If any one of the above fields are populated for a provider then when"
^DIC(9.4,60,22,13,"PAH",345,1,186,0)="    placing a new order in backdoor pharmacy, the software will now check"
^DIC(9.4,60,22,13,"PAH",345,1,187,0)="    for the drug schedule with the provider privileges. If the provider"
^DIC(9.4,60,22,13,"PAH",345,1,188,0)="    does not have the credentials to write such orders then the software"
^DIC(9.4,60,22,13,"PAH",345,1,189,0)="    will display a message (as shown below) and will not allow the "
^DIC(9.4,60,22,13,"PAH",345,1,190,0)="    selection that provider."
^DIC(9.4,60,22,13,"PAH",345,1,191,0)="    Example: When the provider does not have schedule 2 privileges, this"
^DIC(9.4,60,22,13,"PAH",345,1,192,0)="    message is displayed: "
^DIC(9.4,60,22,13,"PAH",345,1,193,0)="    ""Provider not authorized to write Federal Schedule 2 prescriptions."""
^DIC(9.4,60,22,13,"PAH",345,1,194,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,195,0)="16. When placing an order for a CS Detoxification drug, the software will "
^DIC(9.4,60,22,13,"PAH",345,1,196,0)="    now check for a valid Detoxification number for the provider. If the "
^DIC(9.4,60,22,13,"PAH",345,1,197,0)="    provider does not have a Detoxification number then the software will "
^DIC(9.4,60,22,13,"PAH",345,1,198,0)="    display a message ""Provider must have a DETOX# to order this drug."""
^DIC(9.4,60,22,13,"PAH",345,1,199,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,200,0)="17. The Released and Unreleased Prescription Report [PSO RELEASE REPORT] "
^DIC(9.4,60,22,13,"PAH",345,1,201,0)="    is being modified to include CS as a selection to the input. The drug"
^DIC(9.4,60,22,13,"PAH",345,1,202,0)="    name and CS schedule is being added to the output. Here are the"
^DIC(9.4,60,22,13,"PAH",345,1,203,0)="    changes:                         "
^DIC(9.4,60,22,13,"PAH",345,1,204,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,205,0)="You are currently logged in under the CHEYENNE VAM&ROC division."
^DIC(9.4,60,22,13,"PAH",345,1,206,0)="Do you want to select a different division? NO// "
^DIC(9.4,60,22,13,"PAH",345,1,207,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,208,0)="Do you want ONLY Unreleased Prescriptions? NO// "
^DIC(9.4,60,22,13,"PAH",345,1,209,0)="Include (C)S Rx only, (N)on CS Rx only, or (B)oth (C/N/B): B// Controlled "
^DIC(9.4,60,22,13,"PAH",345,1,210,0)="Substances Rxs Only"
^DIC(9.4,60,22,13,"PAH",345,1,211,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,212,0)="Select controlled substance schedules"
^DIC(9.4,60,22,13,"PAH",345,1,213,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,214,0)="     Select one of the following:"
^DIC(9.4,60,22,13,"PAH",345,1,215,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,216,0)="          1         SCHEDULES I - II"
^DIC(9.4,60,22,13,"PAH",345,1,217,0)="          2         SCHEDULES III - V"
^DIC(9.4,60,22,13,"PAH",345,1,218,0)="          3         SCHEDULES I - V"
^DIC(9.4,60,22,13,"PAH",345,1,219,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,220,0)="Select Schedule(s): 3// "
^DIC(9.4,60,22,13,"PAH",345,1,221,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,222,0)="The report currently shows the count of unreleased and copay"
^DIC(9.4,60,22,13,"PAH",345,1,223,0)="prescriptions, but not the count of released prescriptions. The report is"
^DIC(9.4,60,22,13,"PAH",345,1,224,0)="modified with this patch to include the count of released prescriptions."
^DIC(9.4,60,22,13,"PAH",345,1,225,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,226,0)="18. The following options are being modified to include the"
^DIC(9.4,60,22,13,"PAH",345,1,227,0)="    DETOX/MAINTENANCE ID NUMBER field (#53.11) and the DEA EXPIRATION DATE"
^DIC(9.4,60,22,13,"PAH",345,1,228,0)="    field (#747.44) of the NEW PERSON file (#200) as part of the screen. "
^DIC(9.4,60,22,13,"PAH",345,1,229,0)="    The DEA EXPIRATION DATE field will be prompted only if the PROVIDER"
^DIC(9.4,60,22,13,"PAH",345,1,230,0)="    TYPE field (#53.6) of the NEW PERSON file (#200) is marked as ""FEE "
^DIC(9.4,60,22,13,"PAH",345,1,231,0)="    BASIS""."
^DIC(9.4,60,22,13,"PAH",345,1,232,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,233,0)="    Add New Providers [PSO PROVIDER ADD]"
^DIC(9.4,60,22,13,"PAH",345,1,234,0)="    Edit Provider [PSO PROVIDER EDIT]"
^DIC(9.4,60,22,13,"PAH",345,1,235,0)="    View Provider [PSO PROVIDER INQUIRE]"
^DIC(9.4,60,22,13,"PAH",345,1,236,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,237,0)="19. Currently, the default days supply for all drugs is set from the DAYS "
^DIC(9.4,60,22,13,"PAH",345,1,238,0)="    SUPPLY field (#3) of the RX PATIENT STATUS file (#53) up to a maximum"
^DIC(9.4,60,22,13,"PAH",345,1,239,0)="    of 90. With this project, the default for CS schedule II-V drugs will"
^DIC(9.4,60,22,13,"PAH",345,1,240,0)="    be set to 30 or from the DAYS SUPPLY field (#3) of the RX PATIENT"
^DIC(9.4,60,22,13,"PAH",345,1,241,0)="    STATUS file (#53) if it is less than 30. Also, the Integration Control"
^DIC(9.4,60,22,13,"PAH",345,1,242,0)="    Registration #3278 that returns days supply (DSUP^PSOSIGDS) to CPRS is"
^DIC(9.4,60,22,13,"PAH",345,1,243,0)="    modified to return 30 or from the DAYS SUPPLY field (#3) of the RX"
^DIC(9.4,60,22,13,"PAH",345,1,244,0)="    PATIENT STATUS file (#53) if it is less than 30 for CS schedule II-V"
^DIC(9.4,60,22,13,"PAH",345,1,245,0)="    drugs."
^DIC(9.4,60,22,13,"PAH",345,1,246,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,247,0)="20. The pharmacy release slip portion of the Laser Label is being "
^DIC(9.4,60,22,13,"PAH",345,1,248,0)="    modified to include the text ""(DSIG)"" or ""(NOT DSIG)"" after the"
^DIC(9.4,60,22,13,"PAH",345,1,249,0)="    patient's name to indicate that the prescription is digitally signed"
^DIC(9.4,60,22,13,"PAH",345,1,250,0)="    or not digitally signed."
^DIC(9.4,60,22,13,"PAH",345,1,251,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,252,0)="21. This patch addresses the issue reported in REMEDY ticket #595795, to"
^DIC(9.4,60,22,13,"PAH",345,1,253,0)="    ensure that when editing an orderable item/dispensed drug, the "
^DIC(9.4,60,22,13,"PAH",345,1,254,0)="    instruction field is displayed only when editing the pending order "
^DIC(9.4,60,22,13,"PAH",345,1,255,0)="    and not when editing an active or non-verified order."
^DIC(9.4,60,22,13,"PAH",345,1,256,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,257,0)="22. The Expire Prescriptions [PSO EXPIRE PRESCRIPTIONS] option that "
^DIC(9.4,60,22,13,"PAH",345,1,258,0)="    currently runs as a nightly job is being modified to check for the"
^DIC(9.4,60,22,13,"PAH",345,1,259,0)="    Institutional DEA 'expiration date'. If the expiration date is within"
^DIC(9.4,60,22,13,"PAH",345,1,260,0)="    30 calendar days or past expiration then a mail message will be"
^DIC(9.4,60,22,13,"PAH",345,1,261,0)="    generated and sent to PSDMGR key holders. Here is an example when the"
^DIC(9.4,60,22,13,"PAH",345,1,262,0)="    expiration date is within 30 days:"
^DIC(9.4,60,22,13,"PAH",345,1,263,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,264,0)="Subj: 500:Institutional DEA Expiration Date is about to expire  [#140331]"
^DIC(9.4,60,22,13,"PAH",345,1,265,0)="03/20/12@11:57  3 lines"
^DIC(9.4,60,22,13,"PAH",345,1,266,0)="From: POSTMASTER  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",345,1,267,0)="-----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",345,1,268,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,269,0)="Please update Institutional DEA Certification Date. Will expire on "
^DIC(9.4,60,22,13,"PAH",345,1,270,0)="3/24/12."
^DIC(9.4,60,22,13,"PAH",345,1,271,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,272,0)="******************************"
^DIC(9.4,60,22,13,"PAH",345,1,273,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,274,0)="Here is an example when the DEA Expiration Date is past expiration date:"
^DIC(9.4,60,22,13,"PAH",345,1,275,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,276,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,277,0)="Subj: 500:Institutional DEA Expiration Date has expired  [#140333]"
^DIC(9.4,60,22,13,"PAH",345,1,278,0)="03/20/12@12:08  3 lines"
^DIC(9.4,60,22,13,"PAH",345,1,279,0)="From: POSTMASTER  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",345,1,280,0)="----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",345,1,281,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,282,0)="Please update Institutional DEA Certification Date. Expired on 2/19/12."
^DIC(9.4,60,22,13,"PAH",345,1,283,0)=" "
^DIC(9.4,60,22,13,"PAH",345,1,284,0)="**********************************"
^DIC(9.4,60,22,13,"PAH",346,0)="426^3130614.090425^17"
^DIC(9.4,60,22,13,"PAH",346,1,0)="^^10^10^3130614"
^DIC(9.4,60,22,13,"PAH",346,1,1,0)="This is a follow-up patch for PSO*7*391 that was part of Computerized "
^DIC(9.4,60,22,13,"PAH",346,1,2,0)="Patient Record System (CPRS) Graphic User Interface (GUI) v29. CPRS GUI "
^DIC(9.4,60,22,13,"PAH",346,1,3,0)="v29 will be a phased implementation and therefore, this patch, PSO*7*426,"
^DIC(9.4,60,22,13,"PAH",346,1,4,0)="should be installed after CPRS GUI v29 bundle is installed."
^DIC(9.4,60,22,13,"PAH",346,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",346,1,6,0)="Hines reported that when finishing a complex pending order if 'month' is"
^DIC(9.4,60,22,13,"PAH",346,1,7,0)="part of duration then the order is discontinued due to hash mismatch. This"
^DIC(9.4,60,22,13,"PAH",346,1,8,0)="is due to pharmacy storing 'month' as ""L"" and CPRS storing as ""M"". This"
^DIC(9.4,60,22,13,"PAH",346,1,9,0)="patch resolves this problem by tweaking the hash check code to represent"
^DIC(9.4,60,22,13,"PAH",346,1,10,0)="""L"" as ""M"" when ""L"" is found in the duration field."
^DIC(9.4,60,22,13,"PAH",347,0)="424 SEQ #357^3130618.113007^17"
^DIC(9.4,60,22,13,"PAH",347,1,0)="^^4^4^3130618"
^DIC(9.4,60,22,13,"PAH",347,1,1,0)="1. This build is to be installed immediately after PSO*7.0*390 to "
^DIC(9.4,60,22,13,"PAH",347,1,2,0)="   correct an issue where allergy labels are printing each time an allergy"
^DIC(9.4,60,22,13,"PAH",347,1,3,0)="   order check occurs.  The allergy label should only print when a user"
^DIC(9.4,60,22,13,"PAH",347,1,4,0)="   has not been assigned the PSORPH key. (CCR6452). "
^DIC(9.4,60,22,13,"PAH",348,0)="383 SEQ #358^3130710.161536^17"
^DIC(9.4,60,22,13,"PAH",348,1,0)="^^5^5^3130710"
^DIC(9.4,60,22,13,"PAH",348,1,1,0)="This patch will resolve the following issues: "
^DIC(9.4,60,22,13,"PAH",348,1,2,0)="1)  DUZ is printing on the label instead of co-signer."
^DIC(9.4,60,22,13,"PAH",348,1,3,0)="2)  To change the USPS forwarding terminology on labels in Vista."
^DIC(9.4,60,22,13,"PAH",348,1,4,0)="3)  Remove ""REGULAR MAIL"" from the shipping portion of laser labels in"
^DIC(9.4,60,22,13,"PAH",348,1,5,0)="    VistA."
^DIC(9.4,60,22,13,"PAH",349,0)="421^3140106.161656^17"
^DIC(9.4,60,22,13,"PAH",349,1,0)="^^1^1^3140106"
^DIC(9.4,60,22,13,"PAH",349,1,1,0)="EPHARMACY OPERATING RULES"
^DIC(9.4,60,22,13,"PAH",350,0)="429 SEQ #360^3140226.100832^17"
^DIC(9.4,60,22,13,"PAH",350,1,0)="^^2^2^3140226"
^DIC(9.4,60,22,13,"PAH",350,1,1,0)="The Causative Agent showing in the Allergy Order check in Outpatient"
^DIC(9.4,60,22,13,"PAH",350,1,2,0)="Pharmacy is not correct."
^DIC(9.4,60,22,13,"PAH",351,0)="434 SEQ #361^3140227.150424^17"
^DIC(9.4,60,22,13,"PAH",351,1,0)="^^3^3^3140227"
^DIC(9.4,60,22,13,"PAH",351,1,1,0)="VIC CARD ENHANCEMENT"
^DIC(9.4,60,22,13,"PAH",351,1,2,0)="Refer to patch PSO*7*434 in the FORUM Patch Module for a complete"
^DIC(9.4,60,22,13,"PAH",351,1,3,0)="description."
^DIC(9.4,60,22,13,"PAH",352,0)="372^3140407.172332^17"
^DIC(9.4,60,22,13,"PAH",352,1,0)="^^19^19^3140407"
^DIC(9.4,60,22,13,"PAH",352,1,1,0)="This patch is part of a combined build that makes up the release of "
^DIC(9.4,60,22,13,"PAH",352,1,2,0)="MEDICATION ORDER CHECK HEALTHCARE APPLICATION (MOCHA) 2.0."
^DIC(9.4,60,22,13,"PAH",352,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",352,1,4,0)="MOCHA 2.0 encompasses Pharmacy Data Management (PDM) patch PSS*1*160"
^DIC(9.4,60,22,13,"PAH",352,1,5,0)="and a combined build for Outpatient Pharmacy patch PSO*7*372 and "
^DIC(9.4,60,22,13,"PAH",352,1,6,0)="Inpatient Medications patch PSJ*5*252."
^DIC(9.4,60,22,13,"PAH",352,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",352,1,8,0)="This patch group adds dosing checks that implements a new system that uses"
^DIC(9.4,60,22,13,"PAH",352,1,9,0)="data from First DataBank (FDB).  In this initial phase of dosing"
^DIC(9.4,60,22,13,"PAH",352,1,10,0)="functionality, the Single Dose information will be displayed to"
^DIC(9.4,60,22,13,"PAH",352,1,11,0)="the user.  The following scenarios describe the types of messaging added: "
^DIC(9.4,60,22,13,"PAH",352,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",352,1,13,0)="  1. If the dosage entered passes the dosing checks, no message will be"
^DIC(9.4,60,22,13,"PAH",352,1,14,0)="     displayed."
^DIC(9.4,60,22,13,"PAH",352,1,15,0)="  2. If the dosage entered is too high or too low, the Single Dose warning"
^DIC(9.4,60,22,13,"PAH",352,1,16,0)="     message will be displayed."
^DIC(9.4,60,22,13,"PAH",352,1,17,0)="  3. If the dose checks were not able to be performed, a generic message"
^DIC(9.4,60,22,13,"PAH",352,1,18,0)="     will be displayed notifying the user that a manual check needs to be"
^DIC(9.4,60,22,13,"PAH",352,1,19,0)="     completed to verify appropriate dosing."
^DIC(9.4,60,22,13,"PAH",353,0)="416^3140407.172403^17"
^DIC(9.4,60,22,13,"PAH",354,0)="431^3140407.172441^17"
^DIC(9.4,60,22,13,"PAH",354,1,0)="^^22^22^3140407"
^DIC(9.4,60,22,13,"PAH",354,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",354,1,2,0)="This patch is a MOCHA 2.0 fast track release patch to correct an issue "
^DIC(9.4,60,22,13,"PAH",354,1,3,0)="found late in IOC testing process for MOCHA 2.0.  The following is the "
^DIC(9.4,60,22,13,"PAH",354,1,4,0)="needed modification:"
^DIC(9.4,60,22,13,"PAH",354,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",354,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",354,1,7,0)="1. For order level dosing order check messages that do not require the"
^DIC(9.4,60,22,13,"PAH",354,1,8,0)="pharmacist to enter a signature code on the order and where there are more"
^DIC(9.4,60,22,13,"PAH",354,1,9,0)="than three disabilities defined for the patient, the dose message in"
^DIC(9.4,60,22,13,"PAH",354,1,10,0)="Outpatient Pharmacy for a pending order scrolls off the screen.  Examples"
^DIC(9.4,60,22,13,"PAH",354,1,11,0)="of the message would be ""FDB dosing information is not available for this"
^DIC(9.4,60,22,13,"PAH",354,1,12,0)="drug"" or ""Drug not matched to NDF""."
^DIC(9.4,60,22,13,"PAH",354,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",354,1,14,0)="For Max Single Dose messages, the pharmacist is correctly required to sign"
^DIC(9.4,60,22,13,"PAH",354,1,15,0)="the order and enter an intervention.  Pharmacists do have the opportunity"
^DIC(9.4,60,22,13,"PAH",354,1,16,0)="to see the CPRS dosing message when the pending order is first opened in"
^DIC(9.4,60,22,13,"PAH",354,1,17,0)="Outpatient Pharmacy.  The CPRS message is the same message the scrolls off"
^DIC(9.4,60,22,13,"PAH",354,1,18,0)="the screen."
^DIC(9.4,60,22,13,"PAH",354,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",354,1,20,0)="To correct this, an ""Enter to continue"" will be displayed to keep the "
^DIC(9.4,60,22,13,"PAH",354,1,21,0)="dose message from scrolling off the screen when the number of "
^DIC(9.4,60,22,13,"PAH",354,1,22,0)="disabilities to be displayed exceeds the screen length."
^DIC(9.4,60,22,13,"PAH",355,0)="362 SEQ #365^3140424.103005^17"
^DIC(9.4,60,22,13,"PAH",355,1,0)="^^8^8^3140424"
^DIC(9.4,60,22,13,"PAH",355,1,1,0)="This patch resolves the following issues:"
^DIC(9.4,60,22,13,"PAH",355,1,2,0)="Prevent labels for patients whose mail is routed from being marked as a"
^DIC(9.4,60,22,13,"PAH",355,1,3,0)="foreign address."
^DIC(9.4,60,22,13,"PAH",355,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",355,1,5,0)="A patient's prescription is changing from Co-pay to No Co-pay when"
^DIC(9.4,60,22,13,"PAH",355,1,6,0)="it is released."
^DIC(9.4,60,22,13,"PAH",355,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",355,1,8,0)="The Sig does not match between the prescription and the order."
^DIC(9.4,60,22,13,"PAH",356,0)="318 SEQ #367^3140730.171053^17"
^DIC(9.4,60,22,13,"PAH",356,1,0)="^^9^9^3140730"
^DIC(9.4,60,22,13,"PAH",356,1,1,0)="This patch resolves the following 3 issues:"
^DIC(9.4,60,22,13,"PAH",356,1,2,0)="1. Detailed display in CPRS for an IV shows data from another"
^DIC(9.4,60,22,13,"PAH",356,1,3,0)="   prescription."
^DIC(9.4,60,22,13,"PAH",356,1,4,0)="                                                           "
^DIC(9.4,60,22,13,"PAH",356,1,5,0)="2. The algorithm used to determine the # of refills for a pending order"
^DIC(9.4,60,22,13,"PAH",356,1,6,0)="   does not take into account the ""Rx patient status""."
^DIC(9.4,60,22,13,"PAH",356,1,7,0)="   "
^DIC(9.4,60,22,13,"PAH",356,1,8,0)="                                                           "
^DIC(9.4,60,22,13,"PAH",356,1,9,0)="3. Label is incorrectly designated a REPRINT after printing from suspense."
^DIC(9.4,60,22,13,"PAH",357,0)="313 SEQ #368^3140902.12551^17"
^DIC(9.4,60,22,13,"PAH",357,1,0)="^^260^260^3140902"
^DIC(9.4,60,22,13,"PAH",357,1,1,0)="This patch PSO*7*313 includes the following enhancements:"
^DIC(9.4,60,22,13,"PAH",357,1,2,0)="  1. Complex Orders Duration Field "
^DIC(9.4,60,22,13,"PAH",357,1,3,0)="  2. Titration/Maintenance Rx "
^DIC(9.4,60,22,13,"PAH",357,1,4,0)="    "
^DIC(9.4,60,22,13,"PAH",357,1,5,0)="1. Complex Orders Duration Field "
^DIC(9.4,60,22,13,"PAH",357,1,6,0)="================================"
^DIC(9.4,60,22,13,"PAH",357,1,7,0)="This Enhancement is related to Patient Safety Issue PSI-07-167 and Remedy "
^DIC(9.4,60,22,13,"PAH",357,1,8,0)="Ticket # 203088. "
^DIC(9.4,60,22,13,"PAH",357,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,10,0)="The Outpatient Pharmacy application currently allows the entry of a "
^DIC(9.4,60,22,13,"PAH",357,1,11,0)="complex order, which contains a ""THEN"" conjunction. This type of order is"
^DIC(9.4,60,22,13,"PAH",357,1,12,0)="allowed to leave the Duration field preceding the ""THEN"" conjunction "
^DIC(9.4,60,22,13,"PAH",357,1,13,0)="as null. This null duration field is causing issues when the Outpatient"
^DIC(9.4,60,22,13,"PAH",357,1,14,0)="Pharmacy order was being transferred to an Inpatient Medication Order(s)."
^DIC(9.4,60,22,13,"PAH",357,1,15,0)="The default stop dates were for thirty (30) days for the two (2) new"
^DIC(9.4,60,22,13,"PAH",357,1,16,0)="inpatient orders created and the Start/Stop dates in the sequence were"
^DIC(9.4,60,22,13,"PAH",357,1,17,0)="incorrect. The pharmacist did not notice the incorrect dates and finished"
^DIC(9.4,60,22,13,"PAH",357,1,18,0)="off the orders. Upon transfer of a complex order from Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",357,1,19,0)="to Inpatient Medication order(s), the resulting order will start at the"
^DIC(9.4,60,22,13,"PAH",357,1,20,0)="first step rather than continue at the step the patient was at as an"
^DIC(9.4,60,22,13,"PAH",357,1,21,0)="Outpatient. It looks like a new complex order to the finishing pharmacist,"
^DIC(9.4,60,22,13,"PAH",357,1,22,0)="since the Start date is populated with the date of finishing so that the"
^DIC(9.4,60,22,13,"PAH",357,1,23,0)="patient would be started on the first step, which may not be correct."
^DIC(9.4,60,22,13,"PAH",357,1,24,0)="This would pertain to complex orders that taper or titrate doses up or"
^DIC(9.4,60,22,13,"PAH",357,1,25,0)="down and potentially impacts patients by receiving too much or too little"
^DIC(9.4,60,22,13,"PAH",357,1,26,0)="medication.  "
^DIC(9.4,60,22,13,"PAH",357,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,28,0)="The Outpatient Pharmacy is being modified to require the entry of a "
^DIC(9.4,60,22,13,"PAH",357,1,29,0)="duration for a dose preceding a THEN conjunction if the schedule for such"
^DIC(9.4,60,22,13,"PAH",357,1,30,0)="dose is not a ONE-TIME type schedule. If the dose preceding the THEN"
^DIC(9.4,60,22,13,"PAH",357,1,31,0)="conjunction is a ONE-TIME type schedule the software will continue to"
^DIC(9.4,60,22,13,"PAH",357,1,32,0)="allow the Duration field to be left blank (optional). The corresponding"
^DIC(9.4,60,22,13,"PAH",357,1,33,0)="change to CPRS will be done in a future CPRS patch."
^DIC(9.4,60,22,13,"PAH",357,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,35,0)="Example of an acceptable SIG ('NOW' is ONE-TIME type schedule): "
^DIC(9.4,60,22,13,"PAH",357,1,36,0)="--------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",357,1,37,0)="TAKE ONE TABLET BY MOUTH NOW THEN TAKE TWO TABLETS EVERY 8 HOURS "
^DIC(9.4,60,22,13,"PAH",357,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,39,0)="No longer acceptable SIG ('Q4H' is not ONE-TIME type schedule): "
^DIC(9.4,60,22,13,"PAH",357,1,40,0)="--------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",357,1,41,0)="TAKE ONE TABLET BY MOUTH EVERY 4 HOURS THEN TAKE TWO TABLETS EVERY 8 "
^DIC(9.4,60,22,13,"PAH",357,1,42,0)="HOURS "
^DIC(9.4,60,22,13,"PAH",357,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,44,0)="Note: The SIG above is not acceptable because it does not have a "
^DIC(9.4,60,22,13,"PAH",357,1,45,0)="      Duration for the first dose. In order to be acceptable the "
^DIC(9.4,60,22,13,"PAH",357,1,46,0)="      SIG above would have to have a duration like the one below: "
^DIC(9.4,60,22,13,"PAH",357,1,47,0)="       "
^DIC(9.4,60,22,13,"PAH",357,1,48,0)="      TAKE ONE TABLET BY MOUTH EVERY 4 HOURS FOR 3 DAYS THEN TAKE TWO "
^DIC(9.4,60,22,13,"PAH",357,1,49,0)="      TABLETS EVERY 8 HOURS "
^DIC(9.4,60,22,13,"PAH",357,1,50,0)="   "
^DIC(9.4,60,22,13,"PAH",357,1,51,0)="The Duration field is not required for the dose following the last ""THEN"""
^DIC(9.4,60,22,13,"PAH",357,1,52,0)="conjunction.  "
^DIC(9.4,60,22,13,"PAH",357,1,53,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,54,0)="Below is an example of a complex order being entered via Patient "
^DIC(9.4,60,22,13,"PAH",357,1,55,0)="Prescription"
^DIC(9.4,60,22,13,"PAH",357,1,56,0)="Processing [PSO LM BACKDOOR ORDERS] "
^DIC(9.4,60,22,13,"PAH",357,1,57,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,58,0)="    :       :"
^DIC(9.4,60,22,13,"PAH",357,1,59,0)="  VERB: APPLY "
^DIC(9.4,60,22,13,"PAH",357,1,60,0)="  ROUTE: PO// PO   ORAL "
^DIC(9.4,60,22,13,"PAH",357,1,61,0)="  Schedule: QD (EVERY DAY) "
^DIC(9.4,60,22,13,"PAH",357,1,62,0)="     "
^DIC(9.4,60,22,13,"PAH",357,1,63,0)="  LIMITED DURATION (IN DAYS, HOURS OR MINUTES): "
^DIC(9.4,60,22,13,"PAH",357,1,64,0)="  CONJUNCTION: THEN "
^DIC(9.4,60,22,13,"PAH",357,1,65,0)="   "
^DIC(9.4,60,22,13,"PAH",357,1,66,0)=" Duration field required for the dosage entered prior to this THEN "
^DIC(9.4,60,22,13,"PAH",357,1,67,0)=" conjunction. "
^DIC(9.4,60,22,13,"PAH",357,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,69,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,70,0)="  LIMITED DURATION (IN DAYS, HOURS OR MINUTES): "
^DIC(9.4,60,22,13,"PAH",357,1,71,0)="    :       :"
^DIC(9.4,60,22,13,"PAH",357,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,73,0)="2. Titration/Maintenance Rx "
^DIC(9.4,60,22,13,"PAH",357,1,74,0)="==========================="
^DIC(9.4,60,22,13,"PAH",357,1,75,0)="This Enhancement is related to PSI-06-176 and Remedy Ticket #168928.  "
^DIC(9.4,60,22,13,"PAH",357,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,77,0)="The Outpatient Pharmacy (OP) application was modified to accommodate "
^DIC(9.4,60,22,13,"PAH",357,1,78,0)="Titration/Maintenance prescription functionality. The existing software "
^DIC(9.4,60,22,13,"PAH",357,1,79,0)="presented patient safety risks when prescriptions dispensed with a "
^DIC(9.4,60,22,13,"PAH",357,1,80,0)="titrating dose followed by a maintenance dose were being copied, renewed"
^DIC(9.4,60,22,13,"PAH",357,1,81,0)="or refilled. The issue was that refills as well as the new prescriptions"
^DIC(9.4,60,22,13,"PAH",357,1,82,0)="(derived from copy, renewals or edits) automatically carried over the"
^DIC(9.4,60,22,13,"PAH",357,1,83,0)="initial titrating dose into the new fill/prescription, which was not"
^DIC(9.4,60,22,13,"PAH",357,1,84,0)="always the user's intention.  "
^DIC(9.4,60,22,13,"PAH",357,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,86,0)="The new functionality provides two steps for processing Titration/ "
^DIC(9.4,60,22,13,"PAH",357,1,87,0)="Maintenance prescriptions."
^DIC(9.4,60,22,13,"PAH",357,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,89,0)="a. First, the user will have the ability to mark prescriptions as "
^DIC(9.4,60,22,13,"PAH",357,1,90,0)="   'Titration to Maintenance' when finishing prescriptions from CPRS as "
^DIC(9.4,60,22,13,"PAH",357,1,91,0)="   well as via the Patient Prescription Processing [PSO LM BACKDOOR "
^DIC(9.4,60,22,13,"PAH",357,1,92,0)="   ORDERS] option by invoking the new hidden action 'TM' - Mark Rx "
^DIC(9.4,60,22,13,"PAH",357,1,93,0)="   as Titration. This action will result in preventing the following "
^DIC(9.4,60,22,13,"PAH",357,1,94,0)="   actions to be taken on the prescription: Refill, Renewal (including "
^DIC(9.4,60,22,13,"PAH",357,1,95,0)="   via CPRS), Copy and editing of any field that requires a new Rx to be "
^DIC(9.4,60,22,13,"PAH",357,1,96,0)="   created. This action will also set the new field TITRATION RX FLAG "
^DIC(9.4,60,22,13,"PAH",357,1,97,0)="   (#45.3) in the PRESCRIPTION File (#52) as well as the new field "
^DIC(9.4,60,22,13,"PAH",357,1,98,0)="   TITRATION DOSE RX (#45.1) in the PRESCRIPTION File (#52).  "
^DIC(9.4,60,22,13,"PAH",357,1,99,0)="   Prescriptions that are marked as Titration/Maintenance will "
^DIC(9.4,60,22,13,"PAH",357,1,100,0)="   have the letter 't' postfix to the RX # as seen below (entry #1): "
^DIC(9.4,60,22,13,"PAH",357,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,102,0)="           :                   :                            :"
^DIC(9.4,60,22,13,"PAH",357,1,103,0)="                                                   ISSUE  LAST REF DAY "
^DIC(9.4,60,22,13,"PAH",357,1,104,0)="   #  RX #       DRUG                       QTY ST  DATE  FILL REM SUP "
^DIC(9.4,60,22,13,"PAH",357,1,105,0)="  -------------------------------ACTIVE------------------------------- "
^DIC(9.4,60,22,13,"PAH",357,1,106,0)="   1 100005024t  AMOXAPINE 50MG TAB          30 S  09-26 09-26   2  30 "
^DIC(9.4,60,22,13,"PAH",357,1,107,0)="   2 100005022   AMOXICILLIN 250MG CAP       30 A  08-18 08-18  11  30 "
^DIC(9.4,60,22,13,"PAH",357,1,108,0)="   3 100005035   KALETRA                      3 A  09-29 09-29   0   3 "
^DIC(9.4,60,22,13,"PAH",357,1,109,0)="           :                   :                            :"
^DIC(9.4,60,22,13,"PAH",357,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,111,0)="   Note: A prescription can be unmarked as Titration/Maintenance by "
^DIC(9.4,60,22,13,"PAH",357,1,112,0)="         invoking the same TM action on an already marked prescription.  "
^DIC(9.4,60,22,13,"PAH",357,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,114,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,115,0)="b. A new hidden action is being introduced in the Patient Prescription "
^DIC(9.4,60,22,13,"PAH",357,1,116,0)="   Processing [LM BACKDOOR ORDERS] option called TR (Convert "
^DIC(9.4,60,22,13,"PAH",357,1,117,0)="   Titration Rx). This action will populate the new field MAINTENANCE "
^DIC(9.4,60,22,13,"PAH",357,1,118,0)="   DOSE RX (#45.2) in the PRESCRIPTION File (#52).  "
^DIC(9.4,60,22,13,"PAH",357,1,119,0)="   When a titration to maintenance prescription needs to be "
^DIC(9.4,60,22,13,"PAH",357,1,120,0)="   refilled so the patient can continue on the Maintenance Dose "
^DIC(9.4,60,22,13,"PAH",357,1,121,0)="   this option will allow the users to create a new prescription with "
^DIC(9.4,60,22,13,"PAH",357,1,122,0)="   the maintenance dose only. The process works similar to copying an "
^DIC(9.4,60,22,13,"PAH",357,1,123,0)="   existing prescription, however it can only be used on prescriptions "
^DIC(9.4,60,22,13,"PAH",357,1,124,0)="   with the following characteristics: "
^DIC(9.4,60,22,13,"PAH",357,1,125,0)="   "
^DIC(9.4,60,22,13,"PAH",357,1,126,0)="     - Rx is a complex order with a THEN conjunction"
^DIC(9.4,60,22,13,"PAH",357,1,127,0)="     - Rx was not digitally signed"
^DIC(9.4,60,22,13,"PAH",357,1,128,0)="     - Rx is released "
^DIC(9.4,60,22,13,"PAH",357,1,129,0)="     - Rx status is ACTIVE "
^DIC(9.4,60,22,13,"PAH",357,1,130,0)="     - Rx does not have refills previously ordered "
^DIC(9.4,60,22,13,"PAH",357,1,131,0)="     - Rx # Of Refills is greater than 0 (zero) "
^DIC(9.4,60,22,13,"PAH",357,1,132,0)="   "
^DIC(9.4,60,22,13,"PAH",357,1,133,0)="   Before the new Maintenance Rx can be accepted the Pharmacist is "
^DIC(9.4,60,22,13,"PAH",357,1,134,0)="   prompted to validate the QTY field for the new Rx, which may or may not"
^DIC(9.4,60,22,13,"PAH",357,1,135,0)="   be automatically re-calculated. Only the last dose from the original"
^DIC(9.4,60,22,13,"PAH",357,1,136,0)="   prescription is carried over to the new Maintenance Rx and the # of "
^DIC(9.4,60,22,13,"PAH",357,1,137,0)="   Refills field is decreased by 1 because the new Maintenance Rx counts "
^DIC(9.4,60,22,13,"PAH",357,1,138,0)="   as a fill. The Fill Date for the new Maintenance prescription is "
^DIC(9.4,60,22,13,"PAH",357,1,139,0)="   automatically set with the next possible fill date from the existing"
^DIC(9.4,60,22,13,"PAH",357,1,140,0)="   prescription, which can be changed by the pharmacist."
^DIC(9.4,60,22,13,"PAH",357,1,141,0)="   Once the pharmacist verifies the information for the Maintenance Rx is "
^DIC(9.4,60,22,13,"PAH",357,1,142,0)="   accurate they can accept the Maintenance Rx. This action will trigger "
^DIC(9.4,60,22,13,"PAH",357,1,143,0)="   a Duplicate Drug check against the original complex order, which must "
^DIC(9.4,60,22,13,"PAH",357,1,144,0)="   be discontinued before the new Maintenance Rx can be accepted. "
^DIC(9.4,60,22,13,"PAH",357,1,145,0)="   After the new Maintenance Rx is accepted it will have the new "
^DIC(9.4,60,22,13,"PAH",357,1,146,0)="   indicator 'm' on the right side of the Rx # in the patient's Medication"
^DIC(9.4,60,22,13,"PAH",357,1,147,0)="   Profile as seen below (entry #1):"
^DIC(9.4,60,22,13,"PAH",357,1,148,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,149,0)="           :                   :                            :"
^DIC(9.4,60,22,13,"PAH",357,1,150,0)="                                                   ISSUE  LAST REF DAY "
^DIC(9.4,60,22,13,"PAH",357,1,151,0)="   #  RX #       DRUG                       QTY ST  DATE  FILL REM SUP "
^DIC(9.4,60,22,13,"PAH",357,1,152,0)="  -------------------------------ACTIVE------------------------------- "
^DIC(9.4,60,22,13,"PAH",357,1,153,0)="   1 100005436m  AMOXAPINE 50MG TAB          30 S  09-26 09-26   1  30 "
^DIC(9.4,60,22,13,"PAH",357,1,154,0)="   2 100005022   AMOXICILLIN 250MG CAP       30 A  08-18 08-18  11  30 "
^DIC(9.4,60,22,13,"PAH",357,1,155,0)="   3 100005035   KALETRA                      3 A  09-29 09-29   0   3 "
^DIC(9.4,60,22,13,"PAH",357,1,156,0)="           :                   :                            :"
^DIC(9.4,60,22,13,"PAH",357,1,157,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,158,0)="c. The new Titration/Maintenance indicator (t/m) will be included in the "
^DIC(9.4,60,22,13,"PAH",357,1,159,0)="   following menu options where the prescription number is displayed: "
^DIC(9.4,60,22,13,"PAH",357,1,160,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,161,0)="   View Prescriptions                       [PSO VIEW] "
^DIC(9.4,60,22,13,"PAH",357,1,162,0)="   Patient Prescription Processing          [PSO LM BACKDOOR ORDERS]    "
^DIC(9.4,60,22,13,"PAH",357,1,163,0)="   Complete Orders from OERR                [PSO LMOE FINISH] "
^DIC(9.4,60,22,13,"PAH",357,1,164,0)="   ePharmacy Medication Profile (View Only) [PSO PMP] "
^DIC(9.4,60,22,13,"PAH",357,1,165,0)="   Medication Profile                       [PSO P] "
^DIC(9.4,60,22,13,"PAH",357,1,166,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,167,0)="d. External refill requests such as from AudioFax and Internet will not "
^DIC(9.4,60,22,13,"PAH",357,1,168,0)="   be processed for Titration/Maintenance marked prescriptions. "
^DIC(9.4,60,22,13,"PAH",357,1,169,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,170,0)="   Subj: ALBANY External Application Refills: Not processed List  "
^DIC(9.4,60,22,13,"PAH",357,1,171,0)="         [#101509] 01/28/09@13:52  11 lines"
^DIC(9.4,60,22,13,"PAH",357,1,172,0)="   From: POSTMASTER  In 'IN' basket.   Page 1 "
^DIC(9.4,60,22,13,"PAH",357,1,173,0)="   "
^DIC(9.4,60,22,13,"PAH",357,1,174,0)="-------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",357,1,175,0)="   Refills Not Processed Report for the ALBANY Division.  "
^DIC(9.4,60,22,13,"PAH",357,1,176,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,177,0)="   The following refill requests were not processed:  "
^DIC(9.4,60,22,13,"PAH",357,1,178,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,179,0)="   Patient: OPPATIENT,TWO (9999) "
^DIC(9.4,60,22,13,"PAH",357,1,180,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,181,0)="     Rx #: 100005122  (REF #1)  Qty: 55 "
^DIC(9.4,60,22,13,"PAH",357,1,182,0)="     Drug: ZINC SULFATE 66MG TAB "
^DIC(9.4,60,22,13,"PAH",357,1,183,0)="     Reason: 'Titration/Maintenance Rx' cannot be refilled.  "
^DIC(9.4,60,22,13,"PAH",357,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,185,0)="e. CPRS refill requests will not be automatically processed for"
^DIC(9.4,60,22,13,"PAH",357,1,186,0)="   Titration/Maintenance marked prescriptions. The refill request will"
^DIC(9.4,60,22,13,"PAH",357,1,187,0)="   remain in the patient's Medication Profile as PENDING and the mailman"
^DIC(9.4,60,22,13,"PAH",357,1,188,0)="   message above (item d) will also be sent to PSOAUTRF security key"
^DIC(9.4,60,22,13,"PAH",357,1,189,0)="   holders.  "
^DIC(9.4,60,22,13,"PAH",357,1,190,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,191,0)="f. The activity logs for both Titration and Maintenance Rx's will record "
^DIC(9.4,60,22,13,"PAH",357,1,192,0)="   the corresponding Titration and Maintenance Rx # if they exist as seen "
^DIC(9.4,60,22,13,"PAH",357,1,193,0)="   below: "
^DIC(9.4,60,22,13,"PAH",357,1,194,0)="  "
^DIC(9.4,60,22,13,"PAH",357,1,195,0)="Titration Rx: "
^DIC(9.4,60,22,13,"PAH",357,1,196,0)="------------"
^DIC(9.4,60,22,13,"PAH",357,1,197,0)="#   Date        Reason         Rx Ref         Initiator of Activity  "
^DIC(9.4,60,22,13,"PAH",357,1,198,0)="====================================================================== "
^DIC(9.4,60,22,13,"PAH",357,1,199,0)="1   09/29/08    EDIT           ORIGINAL       OPUSER,ONE Comments: "
^DIC(9.4,60,22,13,"PAH",357,1,200,0)="Maintenance"
^DIC(9.4,60,22,13,"PAH",357,1,201,0)="Dose Rx: 100005130 "
^DIC(9.4,60,22,13,"PAH",357,1,202,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,203,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,204,0)="Maintenance Rx: "
^DIC(9.4,60,22,13,"PAH",357,1,205,0)="--------------"
^DIC(9.4,60,22,13,"PAH",357,1,206,0)="#   Date        Reason         Rx Ref         Initiator of Activity  "
^DIC(9.4,60,22,13,"PAH",357,1,207,0)="====================================================================== "
^DIC(9.4,60,22,13,"PAH",357,1,208,0)="1   09/29/08    EDIT           ORIGINAL       OPUSER,TWO Comments: "
^DIC(9.4,60,22,13,"PAH",357,1,209,0)="Titration Dose Rx: 100005392"
^DIC(9.4,60,22,13,"PAH",357,1,210,0)="    "
^DIC(9.4,60,22,13,"PAH",357,1,211,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,212,0)="g. The VistA Integration Control Registration (ICR) #2398 provided to "
^DIC(9.4,60,22,13,"PAH",357,1,213,0)="   Computerized Patient Record System V. 1.0 (CPRS) was modified to "
^DIC(9.4,60,22,13,"PAH",357,1,214,0)="   prevent the renewal of a Titration dose order with the following "
^DIC(9.4,60,22,13,"PAH",357,1,215,0)="   message: "
^DIC(9.4,60,22,13,"PAH",357,1,216,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,217,0)="  ""Prescription was marked as Titration to Maintenance Dose  by Pharmacy "
^DIC(9.4,60,22,13,"PAH",357,1,218,0)="  and cannot be renewed. To repeat the titration, enter a new prescription"
^DIC(9.4,60,22,13,"PAH",357,1,219,0)="  or copy the prior titration order. To continue the maintenance dose, "
^DIC(9.4,60,22,13,"PAH",357,1,220,0)="  refill this prescription if refills are available or enter a new"
^DIC(9.4,60,22,13,"PAH",357,1,221,0)="  prescription for the maintenance dose."""
^DIC(9.4,60,22,13,"PAH",357,1,222,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,223,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,224,0)="h. When using the Barcode Batch Prescription Entry option "
^DIC(9.4,60,22,13,"PAH",357,1,225,0)="   [PSO BATCH BARCODE], if the prescription has been marked "
^DIC(9.4,60,22,13,"PAH",357,1,226,0)="   as a Titration/Maintenance Rx, and the user attempts to "
^DIC(9.4,60,22,13,"PAH",357,1,227,0)="   renew or refill the prescription, the following message "
^DIC(9.4,60,22,13,"PAH",357,1,228,0)="   will display: "
^DIC(9.4,60,22,13,"PAH",357,1,229,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,230,0)="   For a renewal: "
^DIC(9.4,60,22,13,"PAH",357,1,231,0)="   ""Rx# XXXXXX is marked as Titration Rx and cannot be renewed."" "
^DIC(9.4,60,22,13,"PAH",357,1,232,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,233,0)="   For a refill: "
^DIC(9.4,60,22,13,"PAH",357,1,234,0)="   ""Rx# XXXXXX is marked as Titration Rx and cannot be refilled."" "
^DIC(9.4,60,22,13,"PAH",357,1,235,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,236,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,237,0)="i. The PSO HIDDEN ACTIONS Protocol in the PROTOCOL File (#101) "
^DIC(9.4,60,22,13,"PAH",357,1,238,0)="   will be modified to include the two new Hidden Actions "
^DIC(9.4,60,22,13,"PAH",357,1,239,0)="   introduced by this enhancement.  PSO LM BACKDOOR MARK AS "
^DIC(9.4,60,22,13,"PAH",357,1,240,0)="   TITRATION and PSO LM BACKDOOR TITRATION RX REFILL are both "
^DIC(9.4,60,22,13,"PAH",357,1,241,0)="   new protocols added to the PROTOCOL File (#101). "
^DIC(9.4,60,22,13,"PAH",357,1,242,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,243,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,244,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,245,0)=" ******************************  IMPORTANT  ******************************"
^DIC(9.4,60,22,13,"PAH",357,1,246,0)=" The enhancements related to Titration/Maintenance dose Rx are made only "
^DIC(9.4,60,22,13,"PAH",357,1,247,0)=" for Outpatient Pharmacy package. The corresponding changes to CPRS "
^DIC(9.4,60,22,13,"PAH",357,1,248,0)=" package are not included at this time. Therefore, the CPRS Order Copy and"
^DIC(9.4,60,22,13,"PAH",357,1,249,0)=" Order Change functionalities will continue to function as is. "
^DIC(9.4,60,22,13,"PAH",357,1,250,0)=" Furthermore, there will be no indication of a Titration/Maintenance order"
^DIC(9.4,60,22,13,"PAH",357,1,251,0)=" in the CPRS application."
^DIC(9.4,60,22,13,"PAH",357,1,252,0)=" *************************************************************************"
^DIC(9.4,60,22,13,"PAH",357,1,253,0)=" "
^DIC(9.4,60,22,13,"PAH",357,1,254,0)="3. Remedy Ticket #1022059 "
^DIC(9.4,60,22,13,"PAH",357,1,255,0)="   This patch fixes an issue that could create duplicate prescriptions on "
^DIC(9.4,60,22,13,"PAH",357,1,256,0)="   a patient profile. When a complex order is copied and the duration "
^DIC(9.4,60,22,13,"PAH",357,1,257,0)="   field is edited, upon accepting the order, the message to discontinue"
^DIC(9.4,60,22,13,"PAH",357,1,258,0)="   the original order is not triggered. This causes duplicate "
^DIC(9.4,60,22,13,"PAH",357,1,259,0)="   prescriptions to appear on the patient profile. This patch corrects"
^DIC(9.4,60,22,13,"PAH",357,1,260,0)="   this problem by prompting the user to discontinue the original order."
^DIC(9.4,60,22,13,"PAH",358,0)="408 SEQ #369^3140902.125521^17"
^DIC(9.4,60,22,13,"PAH",358,1,0)="^^104^104^3140902"
^DIC(9.4,60,22,13,"PAH",358,1,1,0)="The Safety Updates for the Medication Prescription Management (SUMPM)"
^DIC(9.4,60,22,13,"PAH",358,1,2,0)="project adds a new module to the Outpatient Pharmacy V. 7.0 application,"
^DIC(9.4,60,22,13,"PAH",358,1,3,0)="which will be used for enabling the Veterans Health Administration (VHA)"
^DIC(9.4,60,22,13,"PAH",358,1,4,0)="pharmacies to comply with Mandatory Reporting to State Controlled"
^DIC(9.4,60,22,13,"PAH",358,1,5,0)="Substance Rx Databases required by Consolidated Appropriations Act, 2012,"
^DIC(9.4,60,22,13,"PAH",358,1,6,0)="PL 112-74. Also known as State Prescription Monitoring Program (SPMP), the"
^DIC(9.4,60,22,13,"PAH",358,1,7,0)="program is a state electronic database which collects designated data on"
^DIC(9.4,60,22,13,"PAH",358,1,8,0)="controlled substances dispensed. The states then distribute data from the"
^DIC(9.4,60,22,13,"PAH",358,1,9,0)="database to individuals who are authorized under state law to receive the"
^DIC(9.4,60,22,13,"PAH",358,1,10,0)="information for purposes of their profession. The information must be"
^DIC(9.4,60,22,13,"PAH",358,1,11,0)="reported using the American Society for Automation in Pharmacy (ASAP) data"
^DIC(9.4,60,22,13,"PAH",358,1,12,0)="format, which was developed by the Alliance of States with Prescription"
^DIC(9.4,60,22,13,"PAH",358,1,13,0)="Monitoring Programs and the National Association of State Controlled"
^DIC(9.4,60,22,13,"PAH",358,1,14,0)="Substances Authorities."
^DIC(9.4,60,22,13,"PAH",358,1,15,0)="  "
^DIC(9.4,60,22,13,"PAH",358,1,16,0)="The new menu called State Prescription Monitoring Program Menu [PSO SPMP"
^DIC(9.4,60,22,13,"PAH",358,1,17,0)="MENU] can be found under the Supervisor Functions [PSO SUPERVISOR]"
^DIC(9.4,60,22,13,"PAH",358,1,18,0)="menu option. The following options will be available under this new menu:"
^DIC(9.4,60,22,13,"PAH",358,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,20,0)="1. View/Edit SPMP State Parameters [PSO SPMP STATE PARAMETERS]  "
^DIC(9.4,60,22,13,"PAH",358,1,21,0)="   -----------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,22,0)="   This option is used for viewing or editing the SPMP parameters for a "
^DIC(9.4,60,22,13,"PAH",358,1,23,0)="   specific state. The following fields can be updated via this option:"
^DIC(9.4,60,22,13,"PAH",358,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,25,0)="      ASAP VERSION"
^DIC(9.4,60,22,13,"PAH",358,1,26,0)="      TRANSMIT RETURN TO STOCK*"
^DIC(9.4,60,22,13,"PAH",358,1,27,0)="      INCLUDE NON-VETERAN PATIENTS"
^DIC(9.4,60,22,13,"PAH",358,1,28,0)="      REPORTING FREQUENCY IN DAYS"
^DIC(9.4,60,22,13,"PAH",358,1,29,0)="      VMS LOCAL DIRECTORY"
^DIC(9.4,60,22,13,"PAH",358,1,30,0)="      UNIX/LINUX LOCAL DIRECTORY"
^DIC(9.4,60,22,13,"PAH",358,1,31,0)="      WINDOWS/NT LOCAL DIRECTORY"
^DIC(9.4,60,22,13,"PAH",358,1,32,0)="      FILE NAME PREFIX"
^DIC(9.4,60,22,13,"PAH",358,1,33,0)="      FILE EXTENSION"
^DIC(9.4,60,22,13,"PAH",358,1,34,0)="      STATE FTP SERVER IP ADDRESS"
^DIC(9.4,60,22,13,"PAH",358,1,35,0)="      STATE FTP SERVER USERNAME"
^DIC(9.4,60,22,13,"PAH",358,1,36,0)="      STATE FTP SERVER PORT #"
^DIC(9.4,60,22,13,"PAH",358,1,37,0)="      STATE FTP SERVER PASSWORD"
^DIC(9.4,60,22,13,"PAH",358,1,38,0)="      STATE FTP SERVER DIRECTORY"
^DIC(9.4,60,22,13,"PAH",358,1,39,0)="      SFTP TRANSMISSION MODE"
^DIC(9.4,60,22,13,"PAH",358,1,40,0)="      SFTP PRIVATE KEY TEXT**"
^DIC(9.4,60,22,13,"PAH",358,1,41,0)="      SFTP PUBLIC KEY TEXT**"
^DIC(9.4,60,22,13,"PAH",358,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,43,0)="   *  Visible only if ASAP VERSION is 1995"
^DIC(9.4,60,22,13,"PAH",358,1,44,0)="   ** Visible only if SFTP TRANSMISSION MODE is set to A - AUTOMATIC "
^DIC(9.4,60,22,13,"PAH",358,1,45,0)="  "
^DIC(9.4,60,22,13,"PAH",358,1,46,0)="2. View ASAP Definitions [PSO SPMP VIEW ASAP DEFINITIONS]"
^DIC(9.4,60,22,13,"PAH",358,1,47,0)="   ------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,48,0)="   This option allows the user to visualize the ASAP data format and the"
^DIC(9.4,60,22,13,"PAH",358,1,49,0)="   data elements reported to the states. It provides detailed information"
^DIC(9.4,60,22,13,"PAH",358,1,50,0)="   about each segment and field for the ASAP format versions 4.0, 4.1 and"
^DIC(9.4,60,22,13,"PAH",358,1,51,0)="   4.2."
^DIC(9.4,60,22,13,"PAH",358,1,52,0)="    "
^DIC(9.4,60,22,13,"PAH",358,1,53,0)="3. View/Export Single Prescription [PSO SPMP SINGLE RX VIEW/EXPORT]"
^DIC(9.4,60,22,13,"PAH",358,1,54,0)="   ----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,55,0)="   This option is used for visualizing a specific prescription and the"
^DIC(9.4,60,22,13,"PAH",358,1,56,0)="   data related to a specific fill that is transmitted to the state in the"
^DIC(9.4,60,22,13,"PAH",358,1,57,0)="   ASAP format."
^DIC(9.4,60,22,13,"PAH",358,1,58,0)="  "
^DIC(9.4,60,22,13,"PAH",358,1,59,0)="4. View Export Batch [PSO SPMP BATCH VIEW/EXPORT]"
^DIC(9.4,60,22,13,"PAH",358,1,60,0)="   ----------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,61,0)="   The information reported to the states are first compiled into a batch,"
^DIC(9.4,60,22,13,"PAH",358,1,62,0)="   which can be for a single prescription or a collection of prescriptions"
^DIC(9.4,60,22,13,"PAH",358,1,63,0)="   for a determined date range. This option allows the user to visualize "
^DIC(9.4,60,22,13,"PAH",358,1,64,0)="   information contained in one batch as well as the list of prescriptions"
^DIC(9.4,60,22,13,"PAH",358,1,65,0)="   in the batch. This option also allows the user to manually export the"
^DIC(9.4,60,22,13,"PAH",358,1,66,0)="   batch to the state."
^DIC(9.4,60,22,13,"PAH",358,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,68,0)="5. Export Batch Processing [PSO SPMP BATCH PROCESSING]"
^DIC(9.4,60,22,13,"PAH",358,1,69,0)="   ---------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,70,0)="   This option is used to monitor all the batches used to transmit data to"
^DIC(9.4,60,22,13,"PAH",358,1,71,0)="   the states. The user selects a date range and a list of batches is"
^DIC(9.4,60,22,13,"PAH",358,1,72,0)="   presented where the user can select to perform different actions on a"
^DIC(9.4,60,22,13,"PAH",358,1,73,0)="   specific batch."
^DIC(9.4,60,22,13,"PAH",358,1,74,0)="   "
^DIC(9.4,60,22,13,"PAH",358,1,75,0)="6. Scheduled Batch Export [PSO SPMP SCHEDULED EXPORT]"
^DIC(9.4,60,22,13,"PAH",358,1,76,0)="   --------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,77,0)="   This option is used for running the automatic transmission to the"
^DIC(9.4,60,22,13,"PAH",358,1,78,0)="   states and should not be executed by the end-user directly. It will be"
^DIC(9.4,60,22,13,"PAH",358,1,79,0)="   automatically scheduled to run nightly and it will decide when to"
^DIC(9.4,60,22,13,"PAH",358,1,80,0)="   transmit the data to the state based on the REPORTING FREQUENCY IN DAYS"
^DIC(9.4,60,22,13,"PAH",358,1,81,0)="   field (#3) of the SPMP STATE PARAMETERS file (#58.41) value for the"
^DIC(9.4,60,22,13,"PAH",358,1,82,0)="   state, which can be updated via the View/Edit SPMP State Parameters"
^DIC(9.4,60,22,13,"PAH",358,1,83,0)="   [PSO SPMP STATE PARAMETERS] option."
^DIC(9.4,60,22,13,"PAH",358,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,85,0)="7. Accounting Of Disclosures Report [PSO SPMP DISCLOSURE REPORT]"
^DIC(9.4,60,22,13,"PAH",358,1,86,0)="   -------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,87,0)="   This option is used for generating a list of prescriptions transmitted"
^DIC(9.4,60,22,13,"PAH",358,1,88,0)="   to states. This option allows for a date range selection as well as"
^DIC(9.4,60,22,13,"PAH",358,1,89,0)="   one, multiple or all states and one, multiple or all patients. The list"
^DIC(9.4,60,22,13,"PAH",358,1,90,0)="   is sorted by state and then by patient. "
^DIC(9.4,60,22,13,"PAH",358,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,92,0)="8. Unmark Rx Fill as Administered In Clinic [PSO SPMP UNMARK ADMIN CLINIC]"
^DIC(9.4,60,22,13,"PAH",358,1,93,0)="   -----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,94,0)="   This option is used to unmark prescriptions as 'Administered In"
^DIC(9.4,60,22,13,"PAH",358,1,95,0)="   Clinic'. Administered in clinic prescription fills are not transmitted"
^DIC(9.4,60,22,13,"PAH",358,1,96,0)="   to the states. This option enables the user to unmark fills that have"
^DIC(9.4,60,22,13,"PAH",358,1,97,0)="   been mistakenly marked as 'Administered In Clinic' and subsequently"
^DIC(9.4,60,22,13,"PAH",358,1,98,0)="   transmit them to the state."
^DIC(9.4,60,22,13,"PAH",358,1,99,0)=" "
^DIC(9.4,60,22,13,"PAH",358,1,100,0)="9. Queue Background Jobs [PSO AUTOQUEUE JOBS]"
^DIC(9.4,60,22,13,"PAH",358,1,101,0)="   ------------------------------------------"
^DIC(9.4,60,22,13,"PAH",358,1,102,0)="   The Scheduled Batch Export [PSO SPMP SCHEDUED EXPORT] option mentioned"
^DIC(9.4,60,22,13,"PAH",358,1,103,0)="   above will be added to the list of options that can be edited via this"
^DIC(9.4,60,22,13,"PAH",358,1,104,0)="   option."
^DIC(9.4,60,22,13,"PAH",359,0)="436^3141031.15561^17"
^DIC(9.4,60,22,13,"PAH",360,0)="437 SEQ #371^3141112.124456^17"
^DIC(9.4,60,22,13,"PAH",360,1,0)="^^18^18^3141112"
^DIC(9.4,60,22,13,"PAH",360,1,1,0)="This patch addresses the following:"
^DIC(9.4,60,22,13,"PAH",360,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",360,1,3,0)="1. New Jersey had an issue with the setup after the installation of"
^DIC(9.4,60,22,13,"PAH",360,1,4,0)="   patch PSO*7*408. When they tried to transmit Controlled Substances"
^DIC(9.4,60,22,13,"PAH",360,1,5,0)="   prescriptions to the State Prescription Monitoring Program (SPMP),"
^DIC(9.4,60,22,13,"PAH",360,1,6,0)="   there was an issue with the VMS local directory, ""USER$:[EXTRACT.SPMP]"""
^DIC(9.4,60,22,13,"PAH",360,1,7,0)="   conversion to the Unix/Linux format, ""/USER$/EXTRACT/SPMP"". This patch"
^DIC(9.4,60,22,13,"PAH",360,1,8,0)="   fixes this issue."
^DIC(9.4,60,22,13,"PAH",360,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",360,1,10,0)="2. Patch PSO*7*313, had this verbiage:"
^DIC(9.4,60,22,13,"PAH",360,1,11,0)="   ""The Outpatient Pharmacy is being modified to require the entry of a "
^DIC(9.4,60,22,13,"PAH",360,1,12,0)="   duration for a dose preceding a THEN conjunction if the schedule for"
^DIC(9.4,60,22,13,"PAH",360,1,13,0)="   such dose is not a ONE-TIME type schedule. If the dose preceding the"
^DIC(9.4,60,22,13,"PAH",360,1,14,0)="   THEN conjunction is a ONE-TIME type schedule the software will continue"
^DIC(9.4,60,22,13,"PAH",360,1,15,0)="   to allow the Duration field to be left blank (optional)""."
^DIC(9.4,60,22,13,"PAH",360,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",360,1,17,0)="   It was supposed to allow a ONE-TIME type schedule to proceed without"
^DIC(9.4,60,22,13,"PAH",360,1,18,0)="   the duration, but it did not. This patch corrects this issue."
^DIC(9.4,60,22,13,"PAH",361,0)="438 SEQ #373^3150320.111809^17"
^DIC(9.4,60,22,13,"PAH",361,1,0)="^^4^4^3150320"
^DIC(9.4,60,22,13,"PAH",361,1,1,0)="The new universal member ID# is not included in the description of"
^DIC(9.4,60,22,13,"PAH",361,1,2,0)="acceptable criteria to select a patient at the VistA Outpatient"
^DIC(9.4,60,22,13,"PAH",361,1,3,0)="selection prompt."
^DIC(9.4,60,22,13,"PAH",361,1,4,0)="Drug-Drug Interaction is not occurring with Non-VA Meds"
^DIC(9.4,60,22,13,"PAH",362,0)="282^3150916.142223^17"
^DIC(9.4,60,22,13,"PAH",363,0)="370^3151201.175123^54"
^DIC(9.4,60,22,13,"PAH",363,1,0)="^^9^9^3151201"
^DIC(9.4,60,22,13,"PAH",363,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",363,1,2,0)="A foreign address is triggered for the Philippines when printing"
^DIC(9.4,60,22,13,"PAH",363,1,3,0)="suspense labels with a Routing of Mail."
^DIC(9.4,60,22,13,"PAH",363,1,4,0)="The Help Prompt for the Label Date/Time in the Prescription file is "
^DIC(9.4,60,22,13,"PAH",363,1,5,0)="incorrect."
^DIC(9.4,60,22,13,"PAH",363,1,6,0)="When editing the Refill Date on a prescription, the internal Fileman"
^DIC(9.4,60,22,13,"PAH",363,1,7,0)="date is stored in the Activity Log entry."
^DIC(9.4,60,22,13,"PAH",363,1,8,0)="User without PSORPH key can put rx on hold using pharmacist reasons."
^DIC(9.4,60,22,13,"PAH",363,1,9,0)="The finishing pharmacist's name appears in the released pharmacist's entry"
^DIC(9.4,60,22,13,"PAH",364,0)="427^3160211.171638^54"
^DIC(9.4,60,22,13,"PAH",365,0)="443 SEQ #378^3160304.132435^54"
^DIC(9.4,60,22,13,"PAH",365,1,0)="^^1^1^3160304"
^DIC(9.4,60,22,13,"PAH",365,1,1,0)="A prescription that has been transmitted to the CMOP can be put on HOld."
^DIC(9.4,60,22,13,"PAH",366,0)="456 SEQ #379^3160310.170853^54"
^DIC(9.4,60,22,13,"PAH",367,0)="411^3160526.154917^54"
^DIC(9.4,60,22,13,"PAH",368,0)="444 SEQ #381^3160713.12572^54"
^DIC(9.4,60,22,13,"PAH",368,1,0)="^^141^141^3160713"
^DIC(9.4,60,22,13,"PAH",368,1,1,0)="This patch is part of the Pharmacy Safety Updates project which was "
^DIC(9.4,60,22,13,"PAH",368,1,2,0)="established to address specific New Service Requests (NSRs) as well as a"
^DIC(9.4,60,22,13,"PAH",368,1,3,0)="Remedy Ticket and a Patient Safety Issue (PSI) related to the VistA Pharmacy"
^DIC(9.4,60,22,13,"PAH",368,1,4,0)="applications as approved by the Health Systems Enterprise Systems Manager"
^DIC(9.4,60,22,13,"PAH",368,1,5,0)="(ESM)."
^DIC(9.4,60,22,13,"PAH",368,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,7,0)="This project is comprised of patches from five different applications, as"
^DIC(9.4,60,22,13,"PAH",368,1,8,0)="shown below:"
^DIC(9.4,60,22,13,"PAH",368,1,9,0)="  "
^DIC(9.4,60,22,13,"PAH",368,1,10,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,60,22,13,"PAH",368,1,11,0)="   -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",368,1,12,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*444"
^DIC(9.4,60,22,13,"PAH",368,1,13,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*545"
^DIC(9.4,60,22,13,"PAH",368,1,14,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*189"
^DIC(9.4,60,22,13,"PAH",368,1,15,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                      PSN*4*429"
^DIC(9.4,60,22,13,"PAH",368,1,16,0)="   INPATIENT MEDICATIONS (IM) V.5.0                     PSJ*5*313"
^DIC(9.4,60,22,13,"PAH",368,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,19,0)="The following New service Requests (NSRs), Remedy Ticket and Patient Safety"
^DIC(9.4,60,22,13,"PAH",368,1,20,0)="Issue (PSI) are being addressed by this patch:"
^DIC(9.4,60,22,13,"PAH",368,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,22,0)=" NSRs 20060601/20111206 Allow Dispensing of Greater Than 90 Day Supply"
^DIC(9.4,60,22,13,"PAH",368,1,23,0)=" ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",368,1,24,0)=" The Outpatient Pharmacy and supporting VistA applications are being modified"
^DIC(9.4,60,22,13,"PAH",368,1,25,0)=" to allow dispensing of more than 90 day supply fill for outpatient "
^DIC(9.4,60,22,13,"PAH",368,1,26,0)=" prescriptions. The new limit will be 365 days and will be set for each drug"
^DIC(9.4,60,22,13,"PAH",368,1,27,0)=" individually. See below for more information on specific menu "
^DIC(9.4,60,22,13,"PAH",368,1,28,0)=" options related to this enhancement.  "
^DIC(9.4,60,22,13,"PAH",368,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,30,0)=" PSI PSPO00002793 Patient Prescription Processing error, truncating the "
^DIC(9.4,60,22,13,"PAH",368,1,31,0)="                  second character of the Days Supply"
^DIC(9.4,60,22,13,"PAH",368,1,32,0)=" Remedy 387051 Patient Medication Profile Bad Address Indicator display"
^DIC(9.4,60,22,13,"PAH",368,1,33,0)=" ----------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",368,1,34,0)=" The Outpatient Pharmacy Medication Profile has a display problem for a"
^DIC(9.4,60,22,13,"PAH",368,1,35,0)=" prescription with the following characteristics: 2-letter status (e.g., DC), "
^DIC(9.4,60,22,13,"PAH",368,1,36,0)=" drug marked for Consolidated Mailout Outpatient Pharmacy (CMOP) and Bad"
^DIC(9.4,60,22,13,"PAH",368,1,37,0)=" Address Indicator. When a prescription with all three features is displayed"
^DIC(9.4,60,22,13,"PAH",368,1,38,0)=" the DAY SUP column value is being truncated as illustrated below where the"
^DIC(9.4,60,22,13,"PAH",368,1,39,0)=" Day Supply value is actually 90 and it displays as 9."
^DIC(9.4,60,22,13,"PAH",368,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,41,0)="                                                          ISSUE  LAST REF DAY"
^DIC(9.4,60,22,13,"PAH",368,1,42,0)=" #  RX #         DRUG                              QTY ST  DATE  FILL REM SUP"
^DIC(9.4,60,22,13,"PAH",368,1,43,0)=" --------------------------------DISCONTINUED--------------------------------"
^DIC(9.4,60,22,13,"PAH",368,1,44,0)=" 1 100005604$    TOBRAMYCIN 80MG/2ML INJ           100 DC>B01-21 01-21   0  9"
^DIC(9.4,60,22,13,"PAH",368,1,45,0)="  "
^DIC(9.4,60,22,13,"PAH",368,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,47,0)="This patch modifies the Outpatient Pharmacy application regarding the"
^DIC(9.4,60,22,13,"PAH",368,1,48,0)="enhancements and issues listed above:"
^DIC(9.4,60,22,13,"PAH",368,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,50,0)="1. Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option "
^DIC(9.4,60,22,13,"PAH",368,1,51,0)="   a) The backdoor pharmacy was modified to accept the new maximum value for"
^DIC(9.4,60,22,13,"PAH",368,1,52,0)="      the DAYS SUPPLY field based on the limit set by the MAXIMUM DAYS SUPPLY"
^DIC(9.4,60,22,13,"PAH",368,1,53,0)="      field (#66) in the DRUG file (#50) or the MAXIMUM DAYS SUPPLY field (#32)"
^DIC(9.4,60,22,13,"PAH",368,1,54,0)="      in the VA PRODUCT (#50.68) file. If alternate maximum values do not"
^DIC(9.4,60,22,13,"PAH",368,1,55,0)="      exist, the current limits will remain the same."
^DIC(9.4,60,22,13,"PAH",368,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,57,0)="      Note: The MAXIMUM DAYS SUPPLY field (#32) added to the VA PRODUCT file"
^DIC(9.4,60,22,13,"PAH",368,1,58,0)="            (#50.68) is being introduced by patch PSN*4*429, however it will"
^DIC(9.4,60,22,13,"PAH",368,1,59,0)="            not be populated initially by the Pharmacy Product System -"
^DIC(9.4,60,22,13,"PAH",368,1,60,0)="            National (PPS-N) as changes will be required to that application to"
^DIC(9.4,60,22,13,"PAH",368,1,61,0)="            edit and export this new field. "
^DIC(9.4,60,22,13,"PAH",368,1,62,0)="  "
^DIC(9.4,60,22,13,"PAH",368,1,63,0)="   b) The medication profile was modified to display the Bad Address Indicator"
^DIC(9.4,60,22,13,"PAH",368,1,64,0)="      in a different line in order to address the Remedy Ticket 387051 and "
^DIC(9.4,60,22,13,"PAH",368,1,65,0)="      Patient Safety Issue PSPO00002793 mentioned above. The indicator will be"
^DIC(9.4,60,22,13,"PAH",368,1,66,0)="      placed in the next line, as seen below."
^DIC(9.4,60,22,13,"PAH",368,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,68,0)="    ----------------------------------ACTIVE---------------------------------"
^DIC(9.4,60,22,13,"PAH",368,1,69,0)="    1 100005598   ALSEROXYLON 2MG TAB              400 A> 12-11 03-01   2  90"
^DIC(9.4,60,22,13,"PAH",368,1,70,0)="                                                      **Bad Address**   "
^DIC(9.4,60,22,13,"PAH",368,1,71,0)="    2 100005596   DESIPRAMINE 25MG TAB              90 DC 11-01 11-01  11  30"
^DIC(9.4,60,22,13,"PAH",368,1,72,0)="                                                      **Bad Address**   "
^DIC(9.4,60,22,13,"PAH",368,1,73,0)="    3 100005601A  NAPROXEN 250MG S.T.              170 HP>12-17 12-17   5  30"
^DIC(9.4,60,22,13,"PAH",368,1,74,0)="                                                      **Bad Address**   "
^DIC(9.4,60,22,13,"PAH",368,1,75,0)="    4 100005595   TIMOLOL 0.25% OPTH SOL 10ML       90 S> 11-01 11-21  10  30"
^DIC(9.4,60,22,13,"PAH",368,1,76,0)="  "
^DIC(9.4,60,22,13,"PAH",368,1,77,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,78,0)="  c) The calculation of the number of refills for a prescription was modified "
^DIC(9.4,60,22,13,"PAH",368,1,79,0)="     to take into account the new maximum value allowed for the DAYS SUPPLY"
^DIC(9.4,60,22,13,"PAH",368,1,80,0)="     field. The current calculation (up to 90 days supply) will remain the"
^DIC(9.4,60,22,13,"PAH",368,1,81,0)="     same and a new formula will be introduced to calculate the number of"
^DIC(9.4,60,22,13,"PAH",368,1,82,0)="     refills for days supply values of 91 up to 365. The table below shows"
^DIC(9.4,60,22,13,"PAH",368,1,83,0)="     the number of refills allowed based on the days supply value:"
^DIC(9.4,60,22,13,"PAH",368,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,85,0)="     ---------------------------------+------------------------------------"
^DIC(9.4,60,22,13,"PAH",368,1,86,0)="        NON-CONTROLLED SUBSTANCES     | CONTROLLED SUBSTANCES (NO CHANGE)"
^DIC(9.4,60,22,13,"PAH",368,1,87,0)="     ---------------+-----------------+------------------+-----------------"
^DIC(9.4,60,22,13,"PAH",368,1,88,0)="      DAYS SUPPLY   |   # OF REFILLS  |   DAYS SUPPLY    |   # OF REFILLS    "
^DIC(9.4,60,22,13,"PAH",368,1,89,0)="     ---------------+-----------------+------------------+-----------------"
^DIC(9.4,60,22,13,"PAH",368,1,90,0)="         1 - 59     |        11       |       1 - 59     |        5"
^DIC(9.4,60,22,13,"PAH",368,1,91,0)="        60 - 89     |         5       |      60 - 89     |        2"
^DIC(9.4,60,22,13,"PAH",368,1,92,0)="        90 - 91     |         3       |        90        |        1"
^DIC(9.4,60,22,13,"PAH",368,1,93,0)="        92 - 121    |         2       |                  |        "
^DIC(9.4,60,22,13,"PAH",368,1,94,0)="       122 - 182    |         1       |                  | "
^DIC(9.4,60,22,13,"PAH",368,1,95,0)="       183 - 365    |         0       |                  |"
^DIC(9.4,60,22,13,"PAH",368,1,96,0)="     ---------------+-----------------+------------------+----------------"
^DIC(9.4,60,22,13,"PAH",368,1,97,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,98,0)="2. Complete Orders From OERR [PSO LMOE FINISH] option"
^DIC(9.4,60,22,13,"PAH",368,1,99,0)="   This option was modified to accept the new maximum value for the DAYS"
^DIC(9.4,60,22,13,"PAH",368,1,100,0)="   SUPPLY field based on the limit set by the MAXIMUM DAYS SUPPLY field (#66)"
^DIC(9.4,60,22,13,"PAH",368,1,101,0)="   in the DRUG file (#50) or the MAXIMUM DAYS SUPPLY field (#32) in the VA"
^DIC(9.4,60,22,13,"PAH",368,1,102,0)="   PRODUCT (#50.68) file. If alternate maximum values exist, the current"
^DIC(9.4,60,22,13,"PAH",368,1,103,0)="   limits will remain the same."
^DIC(9.4,60,22,13,"PAH",368,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,105,0)="3. Edit Prescriptions [PSO RXEDIT] option"
^DIC(9.4,60,22,13,"PAH",368,1,106,0)="   This option was also modified to accept the new maximum value for the DAYS"
^DIC(9.4,60,22,13,"PAH",368,1,107,0)="   SUPPLY field based on the limit set by the MAXIMUM DAYS SUPPLY field (#66)"
^DIC(9.4,60,22,13,"PAH",368,1,108,0)="   in the DRUG file (#50) or the MAXIMUM DAYS SUPPLY field (#32) in the VA"
^DIC(9.4,60,22,13,"PAH",368,1,109,0)="   PRODUCT (#50.68) file. If alternate maximum values exist, the current "
^DIC(9.4,60,22,13,"PAH",368,1,110,0)="   limits will remain the same."
^DIC(9.4,60,22,13,"PAH",368,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,112,0)="4. Barcode Batch Prescription Entry [PSO BATCH BARCODE] option"
^DIC(9.4,60,22,13,"PAH",368,1,113,0)="   The renewal functionality within this option was also modified to accept"
^DIC(9.4,60,22,13,"PAH",368,1,114,0)="   the new maximum value for the DAYS SUPPLY field based on the limit set by"
^DIC(9.4,60,22,13,"PAH",368,1,115,0)="   the MAXIMUM DAYS SUPPLY field (#66) in the DRUG file (#50) or the MAXIMUM"
^DIC(9.4,60,22,13,"PAH",368,1,116,0)="   DAYS SUPPLY field (#32) in the VA PRODUCT (#50.68) file. If alternate"
^DIC(9.4,60,22,13,"PAH",368,1,117,0)="   maximum values exist, the current limits will remain the same."
^DIC(9.4,60,22,13,"PAH",368,1,118,0)="  "
^DIC(9.4,60,22,13,"PAH",368,1,119,0)="5. Prescription Management Data Compilation   "
^DIC(9.4,60,22,13,"PAH",368,1,120,0)="   The algorithm used to compile prescription management data was modified to"
^DIC(9.4,60,22,13,"PAH",368,1,121,0)="   account for prescriptions with greater than 90 days supply. The OVER 90"
^DIC(9.4,60,22,13,"PAH",368,1,122,0)="   DAYS (#8) field in the OUTPATIENT PHARMACY MANAGEMENT DATA file (#59.12), "
^DIC(9.4,60,22,13,"PAH",368,1,123,0)="   which is used as a counter for the number of prescription fills with DAYS"
^DIC(9.4,60,22,13,"PAH",368,1,124,0)="   SUPPLY value greater than 90, will now be populated."
^DIC(9.4,60,22,13,"PAH",368,1,125,0)="  "
^DIC(9.4,60,22,13,"PAH",368,1,126,0)="6. Count of Prescriptions [PSO MGMT REPORT RX COUNTS] option &"
^DIC(9.4,60,22,13,"PAH",368,1,127,0)="   Count of Prescriptions [PSO MGMT MONTHLY RX COUNTS] option"
^DIC(9.4,60,22,13,"PAH",368,1,128,0)="   These daily and monthly reports have been modified to include a new column"
^DIC(9.4,60,22,13,"PAH",368,1,129,0)="   called "">90 DAY"", as seen below. This column will display the total number"
^DIC(9.4,60,22,13,"PAH",368,1,130,0)="   of prescription fills with a DAYS SUPPLY value greater than 90, as shown"
^DIC(9.4,60,22,13,"PAH",368,1,131,0)="   below."
^DIC(9.4,60,22,13,"PAH",368,1,132,0)=" "
^DIC(9.4,60,22,13,"PAH",368,1,133,0)="          30      60      90     >90      EQ             TOT     TOT"
^DIC(9.4,60,22,13,"PAH",368,1,134,0)="         DAY     DAY     DAY     DAY     FLS    METH      RX   EQ FL"
^DIC(9.4,60,22,13,"PAH",368,1,135,0)="      ...===========================================================..."
^DIC(9.4,60,22,13,"PAH",368,1,136,0)="           1       3       0       1      11       0       5      11"
^DIC(9.4,60,22,13,"PAH",368,1,137,0)="           0       0       1       2      14       0       3      14"
^DIC(9.4,60,22,13,"PAH",368,1,138,0)="           0       0       0       0       0       0       0       0"
^DIC(9.4,60,22,13,"PAH",368,1,139,0)="           0       0       0       0       0       0       0       0"
^DIC(9.4,60,22,13,"PAH",368,1,140,0)="      ...=== ======= ======= ======= ======= ======= ======= =======..."
^DIC(9.4,60,22,13,"PAH",368,1,141,0)="           1       3       1       3      25       3       8      25"
^DIC(9.4,60,22,13,"PAH",369,0)="458 SEQ #382^3160713.142831^54"
^DIC(9.4,60,22,13,"PAH",369,1,0)="^^1^1^3160713"
^DIC(9.4,60,22,13,"PAH",369,1,1,0)="ME2 Follow Up build for known minor defects."
^DIC(9.4,60,22,13,"PAH",370,0)="450 SEQ #383^3160815.124046^54"
^DIC(9.4,60,22,13,"PAH",370,1,0)="^^12^12^3160815"
^DIC(9.4,60,22,13,"PAH",370,1,1,0)="This patch addresses 3 issues."
^DIC(9.4,60,22,13,"PAH",370,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",370,1,3,0)="        1) When adding a new order via PSO LM BACKDOOR, if a user edits"
^DIC(9.4,60,22,13,"PAH",370,1,4,0)="           the data for the new order and then enters ""^"" to exit editing,"
^DIC(9.4,60,22,13,"PAH",370,1,5,0)="           the system cancels the order"
^DIC(9.4,60,22,13,"PAH",370,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",370,1,7,0)="        2) In PSO PROVIDER EDIT, the user sometimes accesses fields which "
^DIC(9.4,60,22,13,"PAH",370,1,8,0)="           they should not be accessing.  Additionally, using UP-ARROW"
^DIC(9.4,60,22,13,"PAH",370,1,9,0)="           jump does not always work."
^DIC(9.4,60,22,13,"PAH",370,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",370,1,11,0)="        3) When editing a RX and allow to time out at Noun Prompt, nothing"
^DIC(9.4,60,22,13,"PAH",370,1,12,0)="           will be saved prior to the prompt."
^DIC(9.4,60,22,13,"PAH",371,0)="451 SEQ #384^3160815.124113^54"
^DIC(9.4,60,22,13,"PAH",371,1,0)="^^289^289^3160815"
^DIC(9.4,60,22,13,"PAH",371,1,1,0)="The State Prescription Monitoring Program (SPMP) Enhancement project was"
^DIC(9.4,60,22,13,"PAH",371,1,2,0)="established to further enhance the VistA SPMP functionality released by patch"
^DIC(9.4,60,22,13,"PAH",371,1,3,0)="PSO*7*408 back in September 2014. The SPMP VistA functionality is used to"
^DIC(9.4,60,22,13,"PAH",371,1,4,0)="identify prescriptions for controlled substance drugs, Schedule 2 through 5,"
^DIC(9.4,60,22,13,"PAH",371,1,5,0)="dispensed by the Veterans Health Administration (VHA) Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",371,1,6,0)="facilities and to create and transmit an export file containing this"
^DIC(9.4,60,22,13,"PAH",371,1,7,0)="information to the Prescription Drug Monitoring Program (PDMP) of each state"
^DIC(9.4,60,22,13,"PAH",371,1,8,0)="on a daily basis."
^DIC(9.4,60,22,13,"PAH",371,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,10,0)="After PSO*7*408 was released it was identified during the implementation"
^DIC(9.4,60,22,13,"PAH",371,1,11,0)="phase that some states PDMPs had unique requirements that could not be"
^DIC(9.4,60,22,13,"PAH",371,1,12,0)="fulfilled by the functionality released in PSO*7*408 which caused the SPMP"
^DIC(9.4,60,22,13,"PAH",371,1,13,0)="transmissions from sites in such states to be rejected. This patch"
^DIC(9.4,60,22,13,"PAH",371,1,14,0)="(PSO*7*451) will enhance the SPMP functionality to allow VHA to fulfill"
^DIC(9.4,60,22,13,"PAH",371,1,15,0)="specific state requirements and successfully transmit data to those states"
^DIC(9.4,60,22,13,"PAH",371,1,16,0)="PDMPs. This patch also enhances the security of Secure SHell (SSH) Keys "
^DIC(9.4,60,22,13,"PAH",371,1,17,0)="management by streamlining the SSH Key creating and restricting user access"
^DIC(9.4,60,22,13,"PAH",371,1,18,0)="to the Private SSH Key content. In addition, a few smaller miscellaneous"
^DIC(9.4,60,22,13,"PAH",371,1,19,0)="issues have also been addressed, which are described below."
^DIC(9.4,60,22,13,"PAH",371,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,21,0)="All the changes introduced by this patch were related to the options under"
^DIC(9.4,60,22,13,"PAH",371,1,22,0)="the State Prescription Monitoring Program (SPMP) Menu [PSO SPMP MENU] which"
^DIC(9.4,60,22,13,"PAH",371,1,23,0)="is located under the Supervisor Functions [PSO SUPERVISOR] menu option. "
^DIC(9.4,60,22,13,"PAH",371,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,25,0)="The following functionality enhancements will be delivered by this patch:"
^DIC(9.4,60,22,13,"PAH",371,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,27,0)="1. View/Edit ASAP Definitions [PSO SPMP ASAP DEFINITIONS] option"
^DIC(9.4,60,22,13,"PAH",371,1,28,0)="   -------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,29,0)="   Some extensive enhancements have been made to this option to allow full "
^DIC(9.4,60,22,13,"PAH",371,1,30,0)="   user customization of the American Society for Automation in Pharmacy"
^DIC(9.4,60,22,13,"PAH",371,1,31,0)="   (ASAP) data definition format (protocol) used to report outpatient"
^DIC(9.4,60,22,13,"PAH",371,1,32,0)="   controlled substance prescription data to the states."
^DIC(9.4,60,22,13,"PAH",371,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,34,0)="   a) The term '/Edit' has been added to the external name of this option"
^DIC(9.4,60,22,13,"PAH",371,1,35,0)="      and the term 'VIEW' was removed from the internal option name."
^DIC(9.4,60,22,13,"PAH",371,1,36,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,37,0)="   b) This option has been modified to include full customization capability "
^DIC(9.4,60,22,13,"PAH",371,1,38,0)="      for the ASAP definitions 3.0 and later versions, which will allow sites "
^DIC(9.4,60,22,13,"PAH",371,1,39,0)="      to fulfill states PDMPs' specific requirements. Moreover, sites will be"
^DIC(9.4,60,22,13,"PAH",371,1,40,0)="      able to create new ASAP versions by copying an existing one, which"
^DIC(9.4,60,22,13,"PAH",371,1,41,0)="      will hopefully allow them to continue transmissions well into the"
^DIC(9.4,60,22,13,"PAH",371,1,42,0)="      future as new ASAP versions are released and adopted by the states"
^DIC(9.4,60,22,13,"PAH",371,1,43,0)="      PDMPs."
^DIC(9.4,60,22,13,"PAH",371,1,44,0)="      "
^DIC(9.4,60,22,13,"PAH",371,1,45,0)="      Below is a list of actions that have been added to this option:"
^DIC(9.4,60,22,13,"PAH",371,1,46,0)="       "
^DIC(9.4,60,22,13,"PAH",371,1,47,0)="      CV  Copy ASAP Version  CE  Customize Element     ED  Edit Delimiters"
^DIC(9.4,60,22,13,"PAH",371,1,48,0)="      CS  Customize Segment  DC  Delete Customization  "
^DIC(9.4,60,22,13,"PAH",371,1,49,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,50,0)="      For more information on these new actions see the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",371,1,51,0)="      Manager's User Manual in the State Prescription Monitoring Program"
^DIC(9.4,60,22,13,"PAH",371,1,52,0)="      (SPMP) section."
^DIC(9.4,60,22,13,"PAH",371,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,54,0)="   c) Customized Data Elements and Segments will be identified by an '*' "
^DIC(9.4,60,22,13,"PAH",371,1,55,0)="      (asterisk) displayed to the right of the Data Element or Segment ID."
^DIC(9.4,60,22,13,"PAH",371,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,57,0)="2. View/Edit SPMP State Parameters [PSO SPMP STATE PARAMETERS] option"
^DIC(9.4,60,22,13,"PAH",371,1,58,0)="   ------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,59,0)="   A few modifications have been made to this option to support the new "
^DIC(9.4,60,22,13,"PAH",371,1,60,0)="   functionality released by this patch."
^DIC(9.4,60,22,13,"PAH",371,1,61,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,62,0)="   a) The parameter WINDOWS/NT LOCAL DIRECTORY was removed from this option"
^DIC(9.4,60,22,13,"PAH",371,1,63,0)="      because this module no longer supports this operating system  due to"
^DIC(9.4,60,22,13,"PAH",371,1,64,0)="      the increase in the complexity for handling SSH Keys and the fact that "
^DIC(9.4,60,22,13,"PAH",371,1,65,0)="      VHA does not use WINDOWS/NT operating system for VistA database at any"
^DIC(9.4,60,22,13,"PAH",371,1,66,0)="      of its sites."
^DIC(9.4,60,22,13,"PAH",371,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,68,0)="   b) The parameter REPORTING FREQUENCY IN DAYS was modified to allow a"
^DIC(9.4,60,22,13,"PAH",371,1,69,0)="      maximum value of 30 days. Before this field allowed a maximum value of"
^DIC(9.4,60,22,13,"PAH",371,1,70,0)="      99 days."
^DIC(9.4,60,22,13,"PAH",371,1,71,0)="        "
^DIC(9.4,60,22,13,"PAH",371,1,72,0)="   c) A new parameter called RENAME FILE AFTER UPLOAD was added right after"
^DIC(9.4,60,22,13,"PAH",371,1,73,0)="      the 'FILE EXTENSION' parameter. The current transmission creates and"
^DIC(9.4,60,22,13,"PAH",371,1,74,0)="      sends the data file with the "".UP"" file extension (for ""upload""); once"
^DIC(9.4,60,22,13,"PAH",371,1,75,0)="      the file is transmitted a command within sFTP (Secure File Transfer "
^DIC(9.4,60,22,13,"PAH",371,1,76,0)="      Protocol) is issued to rename the file to "".DAT"" (or "".TXT"") file"
^DIC(9.4,60,22,13,"PAH",371,1,77,0)="      extension. This new parameter will allow the site to control whether"
^DIC(9.4,60,22,13,"PAH",371,1,78,0)="      they want to keep the existing functionality by setting this parameter"
^DIC(9.4,60,22,13,"PAH",371,1,79,0)="      to 'YES' or if they would like to create and transmit the file without"
^DIC(9.4,60,22,13,"PAH",371,1,80,0)="      renaming it by setting this parameter to 'NO'. The parameter will be"
^DIC(9.4,60,22,13,"PAH",371,1,81,0)="      initially exported with a default value of 'YES', which is consistent"
^DIC(9.4,60,22,13,"PAH",371,1,82,0)="      with the existing released functionality."
^DIC(9.4,60,22,13,"PAH",371,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,84,0)="   d) The parameters STATE SFTP SERVER IP ADDRESS and STATE SFTP SERVER"
^DIC(9.4,60,22,13,"PAH",371,1,85,0)="      USERNAME had their maximum value lengths increased from 30 to 60 and"
^DIC(9.4,60,22,13,"PAH",371,1,86,0)="      50 characters respectively to accommodate longer PDMP's DNS (Domain"
^DIC(9.4,60,22,13,"PAH",371,1,87,0)="      Name System) names and the usernames they assign to VHA sites."
^DIC(9.4,60,22,13,"PAH",371,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,89,0)="   e) For security reasons the parameters SFTP PRIVATE KEY TEXT and SFTP"
^DIC(9.4,60,22,13,"PAH",371,1,90,0)="      PUBLIC KEY TEXT have been removed from this option as the SSH"
^DIC(9.4,60,22,13,"PAH",371,1,91,0)="      encryption keys content will be handled by a new option called Manage"
^DIC(9.4,60,22,13,"PAH",371,1,92,0)="      Secure SHell (SSH) Keys [PSO SPMP SSH KEY MANAGEMENT], which is"
^DIC(9.4,60,22,13,"PAH",371,1,93,0)="      described below."
^DIC(9.4,60,22,13,"PAH",371,1,94,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,95,0)="3. Manage Secure SHell (SSH) Keys [PSO SPMP SSH KEY MANAGEMENT] option "
^DIC(9.4,60,22,13,"PAH",371,1,96,0)="   -------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,97,0)="   This new option was created to automate the management of SSH encryption"
^DIC(9.4,60,22,13,"PAH",371,1,98,0)="   keys and to improve the security regarding their content. This new option"
^DIC(9.4,60,22,13,"PAH",371,1,99,0)="   will allow sites to view the public SSH key, create a new SSH key pair and"
^DIC(9.4,60,22,13,"PAH",371,1,100,0)="   also to delete an existing SSH key pair. In addition, this new option will"
^DIC(9.4,60,22,13,"PAH",371,1,101,0)="   provide an extensive help text on how the SSH keys are used in the "
^DIC(9.4,60,22,13,"PAH",371,1,102,0)="   transmission process, which is shown below:"
^DIC(9.4,60,22,13,"PAH",371,1,103,0)="   "
^DIC(9.4,60,22,13,"PAH",371,1,104,0)="     Select one of the following:"
^DIC(9.4,60,22,13,"PAH",371,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,106,0)="          V         View Public SSH Key"
^DIC(9.4,60,22,13,"PAH",371,1,107,0)="          N         Create New SSH Key Pair"
^DIC(9.4,60,22,13,"PAH",371,1,108,0)="          D         Delete SSH Key Pair"
^DIC(9.4,60,22,13,"PAH",371,1,109,0)="          H         Help with SSH Keys"
^DIC(9.4,60,22,13,"PAH",371,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,111,0)="     Action: V// H  Help with SSH Keys"
^DIC(9.4,60,22,13,"PAH",371,1,112,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,113,0)="   Secure SHell (SSH) Encryption Keys are used to automate the data "
^DIC(9.4,60,22,13,"PAH",371,1,114,0)="   transmission to the State Prescription Monitoring Programs (SPMPs). Follow"
^DIC(9.4,60,22,13,"PAH",371,1,115,0)="   the steps below to successfully setup SPMP transmissions from VistA to the"
^DIC(9.4,60,22,13,"PAH",371,1,116,0)="   state/vendor server:"
^DIC(9.4,60,22,13,"PAH",371,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,118,0)="   Step 1: Select the 'N' (Create New SSH Key Pair) Action and follow the"
^DIC(9.4,60,22,13,"PAH",371,1,119,0)="           prompts to create a new pair of SSH keys. If you already have an"
^DIC(9.4,60,22,13,"PAH",371,1,120,0)="           existing SSH Key Pair you can skip this step. You can check"
^DIC(9.4,60,22,13,"PAH",371,1,121,0)="           whether you already have an existing SSH Key Pair through the 'V'"
^DIC(9.4,60,22,13,"PAH",371,1,122,0)="           (View Public SSH Key) Action."
^DIC(9.4,60,22,13,"PAH",371,1,123,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,124,0)="        Encryption Type: DSA or RSA?"
^DIC(9.4,60,22,13,"PAH",371,1,125,0)="        ----------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,126,0)="        Digital Signature Algorithm (DSA) and Rivest, Shamir & Adleman (RSA)"
^DIC(9.4,60,22,13,"PAH",371,1,127,0)="        are two of the most common encryption algorithms used by the IT"
^DIC(9.4,60,22,13,"PAH",371,1,128,0)="        industry for securely sharing data. The majority of SPMP servers can"
^DIC(9.4,60,22,13,"PAH",371,1,129,0)="        handle either type; however there are vendors that accept only one"
^DIC(9.4,60,22,13,"PAH",371,1,130,0)="        specific type. You will need to contact the SPMP vendor support to"
^DIC(9.4,60,22,13,"PAH",371,1,131,0)="        determine which type to select."
^DIC(9.4,60,22,13,"PAH",371,1,132,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,133,0)="   Step 2: Share the Public SSH Key content with the state/vendor. In order"
^DIC(9.4,60,22,13,"PAH",371,1,134,0)="           to successfully establish SPMP transmissions the state/vendor will"
^DIC(9.4,60,22,13,"PAH",371,1,135,0)="           have to install/configure the new SSH Key created in step 1 for"
^DIC(9.4,60,22,13,"PAH",371,1,136,0)="           the user id they assigned to your site. Use the 'V' (View Public"
^DIC(9.4,60,22,13,"PAH",371,1,137,0)="           SSH Key) Action to retrieve the content of the Public SSH key. The"
^DIC(9.4,60,22,13,"PAH",371,1,138,0)="           Public SSH Key should not contain line-feed characters, therefore"
^DIC(9.4,60,22,13,"PAH",371,1,139,0)="           after you copy & paste it from the terminal emulator into an email"
^DIC(9.4,60,22,13,"PAH",371,1,140,0)="           or text editor make sure it contains only one line of text (no "
^DIC(9.4,60,22,13,"PAH",371,1,141,0)="           wrapping)."
^DIC(9.4,60,22,13,"PAH",371,1,142,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,143,0)="4. View/Export Single Prescription [PSO SPMP SINGLE RX VIEW/EXPORT] option"
^DIC(9.4,60,22,13,"PAH",371,1,144,0)="   -----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,145,0)="   This option was modified to highlight custom Data Elements and Segments"
^DIC(9.4,60,22,13,"PAH",371,1,146,0)="   by changing the font color as well as by adding an '*' (asterisk) to the"
^DIC(9.4,60,22,13,"PAH",371,1,147,0)="   right of the Data Element or Segment ID."
^DIC(9.4,60,22,13,"PAH",371,1,148,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,149,0)="5. View/Export Batch [PSO SPMP BATCH VIEW/EXPORT] and Export Batch Processing"
^DIC(9.4,60,22,13,"PAH",371,1,150,0)="   [PSO SPMP BATCH PROCESSING] options"
^DIC(9.4,60,22,13,"PAH",371,1,151,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,152,0)="   When exporting a batch through one of these two options the users will now"
^DIC(9.4,60,22,13,"PAH",371,1,153,0)="   have three different choices to execute the transmission: 'B' for "
^DIC(9.4,60,22,13,"PAH",371,1,154,0)="   Background (via TaskMan), which queues the transmission to be performed in"
^DIC(9.4,60,22,13,"PAH",371,1,155,0)="   the background through TaskMan; 'F' for Foreground, which executes the"
^DIC(9.4,60,22,13,"PAH",371,1,156,0)="   transmission in the foreground as it did before this patch and 'D' for"
^DIC(9.4,60,22,13,"PAH",371,1,157,0)="   Debug Mode (Foreground), which will execute the transmission in the"
^DIC(9.4,60,22,13,"PAH",371,1,158,0)="   foreground however it will display the sFTP debug steps, which can be very"
^DIC(9.4,60,22,13,"PAH",371,1,159,0)="   helpful for troubleshooting transmission problems. "
^DIC(9.4,60,22,13,"PAH",371,1,160,0)="   Before this patch the transmission was always executed in the foreground"
^DIC(9.4,60,22,13,"PAH",371,1,161,0)="   which made it difficult to troubleshoot issues with the transmissions, "
^DIC(9.4,60,22,13,"PAH",371,1,162,0)="   especially the scheduled transmissions, which are always executed in the"
^DIC(9.4,60,22,13,"PAH",371,1,163,0)="   background. Below is a screen capture of the prompt for choosing the"
^DIC(9.4,60,22,13,"PAH",371,1,164,0)="   transmission execution mode:"
^DIC(9.4,60,22,13,"PAH",371,1,165,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,166,0)="   Select Item(s): Quit// EXP   Export Batch  "
^DIC(9.4,60,22,13,"PAH",371,1,167,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,168,0)="   Indicate whether the transmission should be queued to run on the"
^DIC(9.4,60,22,13,"PAH",371,1,169,0)="   Background via TaskMan, on the Foreground (Terminal Screen) or in Debug"
^DIC(9.4,60,22,13,"PAH",371,1,170,0)="   Mode (Foreground)"
^DIC(9.4,60,22,13,"PAH",371,1,171,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,172,0)="      Select one of the following:"
^DIC(9.4,60,22,13,"PAH",371,1,173,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,174,0)="          B         Background"
^DIC(9.4,60,22,13,"PAH",371,1,175,0)="          F         Foreground"
^DIC(9.4,60,22,13,"PAH",371,1,176,0)="          D         Debug Mode (Foreground)"
^DIC(9.4,60,22,13,"PAH",371,1,177,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,178,0)="   Running Mode: F// "
^DIC(9.4,60,22,13,"PAH",371,1,179,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,180,0)="6. PSO SPMP NOTIFICATIONS Mail Group"
^DIC(9.4,60,22,13,"PAH",371,1,181,0)="   ---------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,182,0)="   The existing mail group PSO SPMP NOTIFICATIONS released by PSO*7*408 will"
^DIC(9.4,60,22,13,"PAH",371,1,183,0)="   be modified from type PRIVATE to PUBLIC."
^DIC(9.4,60,22,13,"PAH",371,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,185,0)="7. SPMP Transmission Failed MailMan Message"
^DIC(9.4,60,22,13,"PAH",371,1,186,0)="   ----------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,187,0)="   The Mailman message generated by the SPMP Scheduled Background Job as well"
^DIC(9.4,60,22,13,"PAH",371,1,188,0)="   as by the (B)ackground option mentioned above for exporting a batch to the"
^DIC(9.4,60,22,13,"PAH",371,1,189,0)="   state was modified to include Operating System sFTP Log Information, as in"
^DIC(9.4,60,22,13,"PAH",371,1,190,0)="   this example from an OpenVMS environment:"
^DIC(9.4,60,22,13,"PAH",371,1,191,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,192,0)="   Subj: NEW YORK Prescription Monitoring Program Transmission Failed [#99999]"
^DIC(9.4,60,22,13,"PAH",371,1,193,0)="   02/29/16@12:44  26 lines"
^DIC(9.4,60,22,13,"PAH",371,1,194,0)="   From: SPMP TRANSMISSION  In 'IN' basket.   Page 1"
^DIC(9.4,60,22,13,"PAH",371,1,195,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,196,0)="   There was a problem with the transmission of information about Controlled"
^DIC(9.4,60,22,13,"PAH",371,1,197,0)="   Substance prescriptions to the NEW YORK State Prescription Monitoring"
^DIC(9.4,60,22,13,"PAH",371,1,198,0)="   Program (SPMP)."
^DIC(9.4,60,22,13,"PAH",371,1,199,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,200,0)="   Batch #: 41"
^DIC(9.4,60,22,13,"PAH",371,1,201,0)="   Period : 02/29/16 thru 02/29/16"
^DIC(9.4,60,22,13,"PAH",371,1,202,0)="   Error  : Secure FTP Transmission failed."
^DIC(9.4,60,22,13,"PAH",371,1,203,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,204,0)="   Please, use the option Export Batch Processing [PSO SPMP BATCH PROCESSING]"
^DIC(9.4,60,22,13,"PAH",371,1,205,0)="   to manually transmit this batch to the state."
^DIC(9.4,60,22,13,"PAH",371,1,206,0)="   "
^DIC(9.4,60,22,13,"PAH",371,1,207,0)="   sFTP Log:"
^DIC(9.4,60,22,13,"PAH",371,1,208,0)="   ========"
^DIC(9.4,60,22,13,"PAH",371,1,209,0)="   $ SET VERIFY=(PROCEDURE,IMAGE)"
^DIC(9.4,60,22,13,"PAH",371,1,210,0)="   $ SET DEFAULT USER$:[SPMP]"
^DIC(9.4,60,22,13,"PAH",371,1,211,0)="   $ sftp -""D3"" -oIdentityFile=""/USER$/SPMP/VMSSSHID."" -""B"" SPMP_FTP_201606021"
^DIC(9.4,60,22,13,"PAH",371,1,212,0)="   6.INP -oUser=VATEST 54.175.203.159"
^DIC(9.4,60,22,13,"PAH",371,1,213,0)="   debug( 2-JUN-2016 17:37:28.02): Ssh2/SSH2.C:1896: CRTL version (SYS$SHARE:D"
^DIC(9.4,60,22,13,"PAH",371,1,214,0)="   SHR.EXE ident) is V8.3-01"
^DIC(9.4,60,22,13,"PAH",371,1,215,0)="   debug( 2-JUN-2016 17:37:28.04): SshAppCommon/SSHAPPCOMMON.C:313: Allocating"
^DIC(9.4,60,22,13,"PAH",371,1,216,0)="   bal SshRegex context."
^DIC(9.4,60,22,13,"PAH",371,1,217,0)="   debug( 2-JUN-2016 17:37:28.05): SshConfig/SSHCONFIG.C:3482: Metaconfig pars"
^DIC(9.4,60,22,13,"PAH",371,1,218,0)="   stopped at line 4."
^DIC(9.4,60,22,13,"PAH",371,1,219,0)="   debug( 2-JUN-2016 17:37:28.05): SshConfig/SSHCONFIG.C:890: Setting variable"
^DIC(9.4,60,22,13,"PAH",371,1,220,0)="   rboseMode' to 'FALSE'."
^DIC(9.4,60,22,13,"PAH",371,1,221,0)="   debug( 2-JUN-2016 17:37:28.06): SshConfig/SSHCONFIG.C:3390: Unable to open "
^DIC(9.4,60,22,13,"PAH",371,1,222,0)="   /ssh2_config"
^DIC(9.4,60,22,13,"PAH",371,1,223,0)="   debug( 2-JUN-2016 17:37:28.07): Connecting to 54.175.203.159, port 22... "
^DIC(9.4,60,22,13,"PAH",371,1,224,0)="    not used)"
^DIC(9.4,60,22,13,"PAH",371,1,225,0)="   debug( 2-JUN-2016 17:37:28.07): Ssh2/SSH2.C:2881: Entering event loop."
^DIC(9.4,60,22,13,"PAH",371,1,226,0)="   debug( 2-JUN-2016 17:37:28.12): Ssh2Client/SSHCLIENT.C:1655: Creating tra"
^DIC(9.4,60,22,13,"PAH",371,1,227,0)="    protocol"
^DIC(9.4,60,22,13,"PAH",371,1,228,0)="   debug( 2-JUN-2016 17:37:28.12): SshAuthMethodClient/SSHAUTHMETHODC.C:104:"
^DIC(9.4,60,22,13,"PAH",371,1,229,0)="   ""publickey"" to usable methods. "
^DIC(9.4,60,22,13,"PAH",371,1,230,0)="   %TCPIP-E-SSH_FC_ERR_DEST, destination is not directory or does not exist"
^DIC(9.4,60,22,13,"PAH",371,1,231,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,232,0)="   ..."
^DIC(9.4,60,22,13,"PAH",371,1,233,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,234,0)="   debug( 2-JUN-2016 17:37:35.66): Ssh2/SSH2.C:327: locally_generated = TRUE"
^DIC(9.4,60,22,13,"PAH",371,1,235,0)="   Disconnected; no more authentication methods available (No further authent"
^DIC(9.4,60,22,13,"PAH",371,1,236,0)="   on methods available.)."
^DIC(9.4,60,22,13,"PAH",371,1,237,0)="   debug( 2-JUN-2016 17:37:35.66): Ssh2Client/SSHCLIENT.C:1731: Destroying "
^DIC(9.4,60,22,13,"PAH",371,1,238,0)="   debug( 2-JUN-2016 17:37:35.66): SshConfig/SSHCONFIG.C:2888: Freeing pki. "
^DIC(9.4,60,22,13,"PAH",371,1,239,0)="   pki != NULL, user_pki = NULL)"
^DIC(9.4,60,22,13,"PAH",371,1,240,0)="   debug( 2-JUN-2016 17:37:35.66): SshConnection/SSHCONN.C:2636: Destroying"
^DIC(9.4,60,22,13,"PAH",371,1,241,0)="   debug( 2-JUN-2016 17:37:35.66): Ssh2Client/SSHCLIENT.C:1799: Destroying "
^DIC(9.4,60,22,13,"PAH",371,1,242,0)="   completed."
^DIC(9.4,60,22,13,"PAH",371,1,243,0)="   debug( 2-JUN-2016 17:37:35.66): SshAuthMethodClient/SSHAUTHMETHODC.C:109: "
^DIC(9.4,60,22,13,"PAH",371,1,244,0)="   oying authentication method array."
^DIC(9.4,60,22,13,"PAH",371,1,245,0)="   %TCPIP-F-SSH_FATAL, non-specific fatal error condition "
^DIC(9.4,60,22,13,"PAH",371,1,246,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,247,0)="8. PSO SPMP ADMIN Security Key"
^DIC(9.4,60,22,13,"PAH",371,1,248,0)="   ---------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,249,0)="   A new security key was created to restrict access to the following SPMP"
^DIC(9.4,60,22,13,"PAH",371,1,250,0)="   functionalities:"
^DIC(9.4,60,22,13,"PAH",371,1,251,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,252,0)="      - ASAP Definition Customization updates through the option View/Edit"
^DIC(9.4,60,22,13,"PAH",371,1,253,0)="        ASAP Definitions [PSO SPMP ASAP DEFINITIONS]. Visualization of the"
^DIC(9.4,60,22,13,"PAH",371,1,254,0)="        current ASAP Definition is not restricted."
^DIC(9.4,60,22,13,"PAH",371,1,255,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,256,0)="      - SPMP Parameters value updates through the option View/Edit SPMP State"
^DIC(9.4,60,22,13,"PAH",371,1,257,0)="        Parameters [PSO SPMP STATE PARAMETERS]. Visualization of the current"
^DIC(9.4,60,22,13,"PAH",371,1,258,0)="        SPMP parameters is not restricted."
^DIC(9.4,60,22,13,"PAH",371,1,259,0)="  "
^DIC(9.4,60,22,13,"PAH",371,1,260,0)="      - SSH Key generation or replacement through the option Manage Secure"
^DIC(9.4,60,22,13,"PAH",371,1,261,0)="        SHell (SSH) Keys [PSO SPMP SSH KEY MANAGEMENT]. Visualization of the"
^DIC(9.4,60,22,13,"PAH",371,1,262,0)="        current public key is not restricted."
^DIC(9.4,60,22,13,"PAH",371,1,263,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,264,0)="9. Misleading ""File Successfully Transmitted"" message for Linux OS"
^DIC(9.4,60,22,13,"PAH",371,1,265,0)="   ---------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,266,0)="   The previous algorithm used to identify whether the SPMP sFTP data"
^DIC(9.4,60,22,13,"PAH",371,1,267,0)="   transmission was successful was not 100% accurate for Linux Operating"
^DIC(9.4,60,22,13,"PAH",371,1,268,0)="   Systems. A new algorithm has been created and it should reflect the"
^DIC(9.4,60,22,13,"PAH",371,1,269,0)="   transmission status with much greater accuracy when transmitting data"
^DIC(9.4,60,22,13,"PAH",371,1,270,0)="   from a Linux based environment."
^DIC(9.4,60,22,13,"PAH",371,1,271,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,272,0)="10.SPMP Files Access Restrictions"
^DIC(9.4,60,22,13,"PAH",371,1,273,0)="   ------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,274,0)="   The FILE ACCESS setting for the SPMP files below will be opened up so"
^DIC(9.4,60,22,13,"PAH",371,1,275,0)="   users can use FileMan to view and search their content. The files were"
^DIC(9.4,60,22,13,"PAH",371,1,276,0)="   unintentionally released in PSO*7*408 as restricted."
^DIC(9.4,60,22,13,"PAH",371,1,277,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,278,0)="    - SPMP ASAP RECORD DEFINITION (#58.4)"
^DIC(9.4,60,22,13,"PAH",371,1,279,0)="    - SPMP EXPORT BATCH (#58.42)"
^DIC(9.4,60,22,13,"PAH",371,1,280,0)=" "
^DIC(9.4,60,22,13,"PAH",371,1,281,0)="11. Pharmacy DEA Number (ASAP Data Element PHA03)"
^DIC(9.4,60,22,13,"PAH",371,1,282,0)="    ---------------------------------------------"
^DIC(9.4,60,22,13,"PAH",371,1,283,0)="    The Pharmacy DEA# was previously retrieved from the INSTITUTION file"
^DIC(9.4,60,22,13,"PAH",371,1,284,0)="    (#4) through the RELATED INSTITUTION field (#100) in the OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",371,1,285,0)="    SITE file (#59). Now, the software will look for a DEA# for the"
^DIC(9.4,60,22,13,"PAH",371,1,286,0)="    institution in NPI INSTITUTION field (#101) in the OUTPATIENT SITE"
^DIC(9.4,60,22,13,"PAH",371,1,287,0)="    file (#59). If the DEA# for the NPI Institution is blank the software"
^DIC(9.4,60,22,13,"PAH",371,1,288,0)="    will retrieve the DEA# for the Related Institution, like it was doing"
^DIC(9.4,60,22,13,"PAH",371,1,289,0)="    before this patch."
^DIC(9.4,60,22,13,"PAH",372,0)="448^3160829.125625^54"
^DIC(9.4,60,22,13,"PAH",372,1,0)="^^1^1^3160829"
^DIC(9.4,60,22,13,"PAH",372,1,1,0)="MCCF ePharmacy Compliance Phase 3"
^DIC(9.4,60,22,13,"PAH",373,0)="469 SEQ #386^3160923.152219^54"
^DIC(9.4,60,22,13,"PAH",373,1,0)="^^13^13^3160923"
^DIC(9.4,60,22,13,"PAH",373,1,1,0)=" This patch is part of the Pharmacy Safety Updates project and will "
^DIC(9.4,60,22,13,"PAH",373,1,2,0)=" address Patient Safety Issue (PSI) #PSPO00003291 and CA Service "
^DIC(9.4,60,22,13,"PAH",373,1,3,0)=" Desk ticket I10102695FY16."
^DIC(9.4,60,22,13,"PAH",373,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",373,1,5,0)=" PSI PSPO00003291 is CA Service Desk Ticket I10020812FY16"
^DIC(9.4,60,22,13,"PAH",373,1,6,0)=" --------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",373,1,7,0)=" When processing outpatient medication orders, and no dispense drug "
^DIC(9.4,60,22,13,"PAH",373,1,8,0)=" is selected, the range values for the # of refills prompt is"
^DIC(9.4,60,22,13,"PAH",373,1,9,0)=" defaulting to zero."
^DIC(9.4,60,22,13,"PAH",373,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",373,1,11,0)=" CA Service Desk I10102695FY16"
^DIC(9.4,60,22,13,"PAH",373,1,12,0)=" -----------------------------"
^DIC(9.4,60,22,13,"PAH",373,1,13,0)=" Pharmacy Technician not able to edit # of refills data field."
^DIC(9.4,60,22,13,"PAH",374,0)="455 SEQ #387^3161028.15154^54"
^DIC(9.4,60,22,13,"PAH",374,1,0)="^^18^18^3161028"
^DIC(9.4,60,22,13,"PAH",374,1,1,0)="This patch addresses five issues:"
^DIC(9.4,60,22,13,"PAH",374,1,2,0)="         1. The calculation of the dosage of a prescription will not "
^DIC(9.4,60,22,13,"PAH",374,1,3,0)="populate when creating an order and entering the schedule in all lower "
^DIC(9.4,60,22,13,"PAH",374,1,4,0)="case. "
^DIC(9.4,60,22,13,"PAH",374,1,5,0)="        2. Schedules are not expanding to SPANISH. The labels aren't "
^DIC(9.4,60,22,13,"PAH",374,1,6,0)="printing in Spanish translated from English as necessary when creating a "
^DIC(9.4,60,22,13,"PAH",374,1,7,0)="prescription in outpatient pharmacy. "
^DIC(9.4,60,22,13,"PAH",374,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",374,1,9,0)="        3. In the Computerized Patient Record System (CPRS) Non-VA "
^DIC(9.4,60,22,13,"PAH",374,1,10,0)="medications that have a sig longer than 3 words will not display in the "
^DIC(9.4,60,22,13,"PAH",374,1,11,0)="meds tab."
^DIC(9.4,60,22,13,"PAH",374,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",374,1,13,0)="        4. If a Health Level 7 (HL7) delimiter character is inserted"
^DIC(9.4,60,22,13,"PAH",374,1,14,0)="into the comment field for Non-VA meds, the escape character is "
^DIC(9.4,60,22,13,"PAH",374,1,15,0)="incorrectly stored in the global."
^DIC(9.4,60,22,13,"PAH",374,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",374,1,17,0)="        5. Non-VA meds do not display on the Meds Tab in CPRS if the"
^DIC(9.4,60,22,13,"PAH",374,1,18,0)="Start Date is set to NOW when creating the Non-VA med."
^DIC(9.4,60,22,13,"PAH",375,0)="454 SEQ #388^3161201.155117^54"
^DIC(9.4,60,22,13,"PAH",375,1,0)="^^1^1^3161201"
^DIC(9.4,60,22,13,"PAH",375,1,1,0)="One VA Pharmacy remote prescription enhancements."
^DIC(9.4,60,22,13,"PAH",376,0)="460^3161220.152251^54"
^DIC(9.4,60,22,13,"PAH",376,1,0)="^^1^1^3161220"
^DIC(9.4,60,22,13,"PAH",376,1,1,0)="FIXED MEDICATION COPAYMENT TIER (FMCT)"
^DIC(9.4,60,22,13,"PAH",377,0)="475 SEQ #390^3170123.135016^54"
^DIC(9.4,60,22,13,"PAH",377,1,0)="^^3^3^3170123"
^DIC(9.4,60,22,13,"PAH",377,1,1,0)="This patch resolves a problem where a pharmacy user is not prompted for a "
^DIC(9.4,60,22,13,"PAH",377,1,2,0)="label device. This occurs when the host site does not generate label data "
^DIC(9.4,60,22,13,"PAH",377,1,3,0)="for a remote refill or partial fill request."
^DIC(9.4,60,22,13,"PAH",378,0)="476 SEQ #391^3170203.15275^54"
^DIC(9.4,60,22,13,"PAH",378,1,0)="^^1^1^3170203"
^DIC(9.4,60,22,13,"PAH",378,1,1,0)="FIXED MEDICATION COPAYMENT TIER (FMCT)"
^DIC(9.4,60,22,13,"PAH",379,0)="459 SEQ #392^3170224.170353^54"
^DIC(9.4,60,22,13,"PAH",379,1,0)="^^2^2^3170224"
^DIC(9.4,60,22,13,"PAH",379,1,1,0)="This patch will fix the issue where a suspended prescription"
^DIC(9.4,60,22,13,"PAH",379,1,2,0)="is being transmitted to CMOP too soon."
^DIC(9.4,60,22,13,"PAH",380,0)="480 SEQ #393^3170403.154609^54"
^DIC(9.4,60,22,13,"PAH",380,1,0)="^^8^8^3170403"
^DIC(9.4,60,22,13,"PAH",380,1,1,0)="There are multiple variables used for determining whether a patient will "
^DIC(9.4,60,22,13,"PAH",380,1,2,0)="be billed copay in Outpatient Pharmacy (i.e. Supply Item, Investigational "
^DIC(9.4,60,22,13,"PAH",380,1,3,0)="Drug, Nutritional Supplement, service connection, environment indicators, "
^DIC(9.4,60,22,13,"PAH",380,1,4,0)="IB billable flags, etc.).  They are used separately or in conjunction "
^DIC(9.4,60,22,13,"PAH",380,1,5,0)="with one another to determine if the prescription is billable.  For the "
^DIC(9.4,60,22,13,"PAH",380,1,6,0)="Domiciliary patients, IB has a specific check for Domiciliary and returns "
^DIC(9.4,60,22,13,"PAH",380,1,7,0)="the exempt status; however, OP did not have one of three flags defined "
^DIC(9.4,60,22,13,"PAH",380,1,8,0)="correctly to exempt prescriptions from copay."
^DIC(9.4,60,22,13,"PAH",381,0)="468 SEQ #394^3170403.155728^54"
^DIC(9.4,60,22,13,"PAH",381,1,0)="^^6^6^3170403"
^DIC(9.4,60,22,13,"PAH",381,1,1,0)=" The patch addresses (2) issues:"
^DIC(9.4,60,22,13,"PAH",381,1,2,0)=" 1. Duplicate orders are erroneously allowed and duplicate warning "
^DIC(9.4,60,22,13,"PAH",381,1,3,0)="    messages do not appear after patient status is updated from "
^DIC(9.4,60,22,13,"PAH",381,1,4,0)="    ""authorized absence"" to another status."
^DIC(9.4,60,22,13,"PAH",381,1,5,0)=" 2. Duplicate warning messages are absent when copying an order if the "
^DIC(9.4,60,22,13,"PAH",381,1,6,0)="    previous order attempt was terminated in the same session."
^DIC(9.4,60,22,13,"PAH",382,0)="465 SEQ #395^3170427.163127^54"
^DIC(9.4,60,22,13,"PAH",382,1,0)="^^5^5^3170427"
^DIC(9.4,60,22,13,"PAH",382,1,1,0)="This patch will fix the following issues:"
^DIC(9.4,60,22,13,"PAH",382,1,2,0)="1. The CMOP transmission stopped due to an Undefined"
^DIC(9.4,60,22,13,"PAH",382,1,3,0)="   error"
^DIC(9.4,60,22,13,"PAH",382,1,4,0)="2. Update the Technical Manual/Security Guide for"
^DIC(9.4,60,22,13,"PAH",382,1,5,0)="   the HL7 record sent to the dispensing machines"
^DIC(9.4,60,22,13,"PAH",383,0)="440 SEQ #396^3170427.175013^54"
^DIC(9.4,60,22,13,"PAH",383,1,0)="^^12^12^3170427"
^DIC(9.4,60,22,13,"PAH",383,1,1,0)="The patch addresses three (3) issues:"
^DIC(9.4,60,22,13,"PAH",383,1,2,0)="                      "
^DIC(9.4,60,22,13,"PAH",383,1,3,0)="1) INC000000954036 - SUSPEND HOLD ISSUE"
^DIC(9.4,60,22,13,"PAH",383,1,4,0)="        When a Rx on suspense goes on hold, it should be restored to the "
^DIC(9.4,60,22,13,"PAH",383,1,5,0)="        suspended status when unhold."
^DIC(9.4,60,22,13,"PAH",383,1,6,0)="2) INC000000736122 - RX renewal date"
^DIC(9.4,60,22,13,"PAH",383,1,7,0)="        Renewed script date becomes ""ISSUE"" date"
^DIC(9.4,60,22,13,"PAH",383,1,8,0)="3) INC000001180597 - Division Change with Transmission "
^DIC(9.4,60,22,13,"PAH",383,1,9,0)="        The option Unprinted/Non-Transmitted Rxs Re-Suspend, changes the "
^DIC(9.4,60,22,13,"PAH",383,1,10,0)="        division on the retransmission from the correct division to the "
^DIC(9.4,60,22,13,"PAH",383,1,11,0)="        division the user is signed on to at the time the option is run."
^DIC(9.4,60,22,13,"PAH",383,1,12,0)="        This really affects integrated sites."
^DIC(9.4,60,22,13,"PAH",384,0)="485 SEQ #399^3170601.174037^54"
^DIC(9.4,60,22,13,"PAH",384,1,0)="^^3^3^3170601"
^DIC(9.4,60,22,13,"PAH",384,1,1,0)="This is a follow-up patch for Fixed Medication Copayment Tier (FMCT) "
^DIC(9.4,60,22,13,"PAH",384,1,2,0)="patch PSO*7*460, where the mail message, ""PRESCRIPTION QUESTIONS REVIEW "
^DIC(9.4,60,22,13,"PAH",384,1,3,0)="NEEDED"" was not generating."
^DIC(9.4,60,22,13,"PAH",385,0)="479 SEQ #400^3170629.151905^54"
^DIC(9.4,60,22,13,"PAH",385,1,0)="^^2^2^3170629"
^DIC(9.4,60,22,13,"PAH",385,1,1,0)="This patch will fix the following issue:"
^DIC(9.4,60,22,13,"PAH",385,1,2,0)="User attempts to '^' at the Device prompts, the fill is still processed"
^DIC(9.4,60,22,13,"PAH",386,0)="484^3170629.161327^54"
^DIC(9.4,60,22,13,"PAH",386,1,0)="^^2^2^3170629"
^DIC(9.4,60,22,13,"PAH",386,1,1,0)="This patch will fix the following issue:"
^DIC(9.4,60,22,13,"PAH",386,1,2,0)="1. Drug Interaction Order Checks"
^DIC(9.4,60,22,13,"PAH",387,0)="486 SEQ #403^3170830.151226^54"
^DIC(9.4,60,22,13,"PAH",387,1,0)="^^133^133^3170830"
^DIC(9.4,60,22,13,"PAH",387,1,1,0)="The patch addresses two (3) issues:"
^DIC(9.4,60,22,13,"PAH",387,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,3,0)="1. R10380204FY16 - when entering a new Rx using the Patient Prescription "
^DIC(9.4,60,22,13,"PAH",387,1,4,0)="   Processing [PSO LM BACKDOOR ORDERS], and then editing the dosage and "
^DIC(9.4,60,22,13,"PAH",387,1,5,0)="   entering an up (^) character to exit, the Rx will be deleted as user"
^DIC(9.4,60,22,13,"PAH",387,1,6,0)="   accepts the Rx."
^DIC(9.4,60,22,13,"PAH",387,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,8,0)="2. R9361753FY16 - Using the Patient Prescription Processing [PSO LM BACKDOOR"
^DIC(9.4,60,22,13,"PAH",387,1,9,0)="   ORDERS] option, when users edit/modify the Issue Date or Fill Date of an"
^DIC(9.4,60,22,13,"PAH",387,1,10,0)="   Outpatient Rx, the Rx Expiration Date is reset to an incorrect date."
^DIC(9.4,60,22,13,"PAH",387,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,12,0)="3. R15046343FY17 - A drug with same tab strength did NOT discontinue after"
^DIC(9.4,60,22,13,"PAH",387,1,13,0)="   duplicate (new order) processing. This created a duplicate active order in"
^DIC(9.4,60,22,13,"PAH",387,1,14,0)="   the patient's profile."
^DIC(9.4,60,22,13,"PAH",387,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,16,0)="Associated NSR(s):"
^DIC(9.4,60,22,13,"PAH",387,1,17,0)="================="
^DIC(9.4,60,22,13,"PAH",387,1,18,0)="N/A"
^DIC(9.4,60,22,13,"PAH",387,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,20,0)="Associated CA SDM Ticket(s):"
^DIC(9.4,60,22,13,"PAH",387,1,21,0)="============================"
^DIC(9.4,60,22,13,"PAH",387,1,22,0)="1. R10380204FY16 - When entering a new outpatient Rx, the Rx is Deleted on"
^DIC(9.4,60,22,13,"PAH",387,1,23,0)="   editing the dosage and entering an up (^) character to exit."
^DIC(9.4,60,22,13,"PAH",387,1,24,0)="2. R9361753FY16 - When editing/modifying the Issue Date or Fill Date of an"
^DIC(9.4,60,22,13,"PAH",387,1,25,0)="   Outpatient Rx, the Rx expires on an incorrect date."
^DIC(9.4,60,22,13,"PAH",387,1,26,0)="3. R15046343FY17 - A drug with same tab strength did NOT discontinue after"
^DIC(9.4,60,22,13,"PAH",387,1,27,0)="   duplicate (new order) processing."
^DIC(9.4,60,22,13,"PAH",387,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,29,0)="Participating Test Sites:"
^DIC(9.4,60,22,13,"PAH",387,1,30,0)="========================"
^DIC(9.4,60,22,13,"PAH",387,1,31,0)="OKLAHOMA CITY"
^DIC(9.4,60,22,13,"PAH",387,1,32,0)="TAMPA BAY"
^DIC(9.4,60,22,13,"PAH",387,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,34,0)="Ticket Overview:"
^DIC(9.4,60,22,13,"PAH",387,1,35,0)="==============="
^DIC(9.4,60,22,13,"PAH",387,1,36,0)="1. R10380204FY16- When entering a new RX using LM BACKDOOR ORDERS, the RX"
^DIC(9.4,60,22,13,"PAH",387,1,37,0)="   is Deleted on editing the dosage and entering an up (^) character to "
^DIC(9.4,60,22,13,"PAH",387,1,38,0)="   exit. "
^DIC(9.4,60,22,13,"PAH",387,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,40,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",387,1,41,0)="--------"
^DIC(9.4,60,22,13,"PAH",387,1,42,0)="When user enters a new Outpatient prescription and answers ""NO"" to the prompt"
^DIC(9.4,60,22,13,"PAH",387,1,43,0)="""Is this correct? YES//"" and then user edits the dosage and enter an up (^)"
^DIC(9.4,60,22,13,"PAH",387,1,44,0)="character to exit the prompt ""Dosage:"" and accepts Rx then new Rx will be"
^DIC(9.4,60,22,13,"PAH",387,1,45,0)="deleted. "
^DIC(9.4,60,22,13,"PAH",387,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,47,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",387,1,48,0)="--------"
^DIC(9.4,60,22,13,"PAH",387,1,49,0)="Correct routine code ASK^PSOORED5 to call line tag EXE instead EX to escape "
^DIC(9.4,60,22,13,"PAH",387,1,50,0)="killing required data before saving."
^DIC(9.4,60,22,13,"PAH",387,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,52,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,53,0)="2. R9361753FY16 - Outpatient Rx expired on an incorrect date, when Issue Date"
^DIC(9.4,60,22,13,"PAH",387,1,54,0)="   or Fill Date is modified."
^DIC(9.4,60,22,13,"PAH",387,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,56,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",387,1,57,0)="--------"
^DIC(9.4,60,22,13,"PAH",387,1,58,0)="When editing/modifying the Issue Date or Fill Date of an Outpatient Rx using"
^DIC(9.4,60,22,13,"PAH",387,1,59,0)="the backdoor pharmacy, the Rx expiration date is reset to an incorrect Date."
^DIC(9.4,60,22,13,"PAH",387,1,60,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,61,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",387,1,62,0)="--------"
^DIC(9.4,60,22,13,"PAH",387,1,63,0)="Corrected A^PSOEXDT to set up expiration date for prescription without"
^DIC(9.4,60,22,13,"PAH",387,1,64,0)="refills not less than 30 days after issue date unless it is a Clozapine"
^DIC(9.4,60,22,13,"PAH",387,1,65,0)="prescription. In addition, if the newly calculated Rx Expiration Date is"
^DIC(9.4,60,22,13,"PAH",387,1,66,0)="earlier than the Rx Fill Date the Rx Expiration Date will be re-calculated"
^DIC(9.4,60,22,13,"PAH",387,1,67,0)="to be the Rx Fill Date plus the Days Supply value."
^DIC(9.4,60,22,13,"PAH",387,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,69,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,70,0)="3. R15046343FY17 - A drug with same tab strength did NOT discontinue after"
^DIC(9.4,60,22,13,"PAH",387,1,71,0)="   duplicate (new order) processing. This created a duplicate active order"
^DIC(9.4,60,22,13,"PAH",387,1,72,0)="   in patient's profile."
^DIC(9.4,60,22,13,"PAH",387,1,73,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,74,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",387,1,75,0)="--------"
^DIC(9.4,60,22,13,"PAH",387,1,76,0)="When using the options Patient Prescription Processing [PSO LM BACKDOOR"
^DIC(9.4,60,22,13,"PAH",387,1,77,0)="ORDERS] or Complete Orders from OERR [PSO LMOE FINISH] for finishing "
^DIC(9.4,60,22,13,"PAH",387,1,78,0)="pending orders there was a scenario where duplicate active orders could"
^DIC(9.4,60,22,13,"PAH",387,1,79,0)="remain on the patient profile as ACTIVE. The screen capture example below"
^DIC(9.4,60,22,13,"PAH",387,1,80,0)="shows the prompt ""Press return to continue:"" where if the user entered an"
^DIC(9.4,60,22,13,"PAH",387,1,81,0)="up (^) character at this prompt, the duplicate existing order would not be"
^DIC(9.4,60,22,13,"PAH",387,1,82,0)="DC'd."
^DIC(9.4,60,22,13,"PAH",387,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,84,0)="   ..."
^DIC(9.4,60,22,13,"PAH",387,1,85,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",387,1,86,0)="   Duplicate Drug in Local Rx:"
^DIC(9.4,60,22,13,"PAH",387,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,88,0)="                    Rx: 100001973"
^DIC(9.4,60,22,13,"PAH",387,1,89,0)="                  Drug: ACER BANDAGE"
^DIC(9.4,60,22,13,"PAH",387,1,90,0)="                   SIG: APPLY 1 BANDAGE OVER AFFECTED AREA THREE TIMES A DAY"
^DIC(9.4,60,22,13,"PAH",387,1,91,0)="                   QTY: 9                      Refills remaining: 1"
^DIC(9.4,60,22,13,"PAH",387,1,92,0)="              Provider: ROCHA,MARCELO                     Issued: 06/25/17"
^DIC(9.4,60,22,13,"PAH",387,1,93,0)="                Status: Active                       Last filled: 06/26/17"
^DIC(9.4,60,22,13,"PAH",387,1,94,0)="     Processing Status: Not released locally (Window)"
^DIC(9.4,60,22,13,"PAH",387,1,95,0)="                                                     Days Supply: 9"
^DIC(9.4,60,22,13,"PAH",387,1,96,0)="   --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",387,1,97,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,98,0)="   Discontinue RX # 100001973 STERI-STRIPS Y/N? YES  "
^DIC(9.4,60,22,13,"PAH",387,1,99,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,100,0)="   Rx #100001973 STERI-STRIPS^401962 will be discontinued after the"
^DIC(9.4,60,22,13,"PAH",387,1,101,0)="   acceptance of the new order.  "
^DIC(9.4,60,22,13,"PAH",387,1,102,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,103,0)="   Now doing allergy checks.  Please wait..."
^DIC(9.4,60,22,13,"PAH",387,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,105,0)="   Now processing Clinical Reminder Order Checks. Please wait ..."
^DIC(9.4,60,22,13,"PAH",387,1,106,0)="   Now Processing Enhanced Order Checks!  Please wait..."
^DIC(9.4,60,22,13,"PAH",387,1,107,0)="    "
^DIC(9.4,60,22,13,"PAH",387,1,108,0)="    "
^DIC(9.4,60,22,13,"PAH",387,1,109,0)="   Press return to continue: ^ <<< [This up (^) character causes the problem]    "
^DIC(9.4,60,22,13,"PAH",387,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,111,0)="   Rx # 100001977         06/26/17"
^DIC(9.4,60,22,13,"PAH",387,1,112,0)="   TESTATNM,CLETUS               #8"
^DIC(9.4,60,22,13,"PAH",387,1,113,0)="   APPLY 1 BANDAGE OVER AFFECTED AREA THREE TIMES A DAY"
^DIC(9.4,60,22,13,"PAH",387,1,114,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,115,0)="   ACER BANDAGE"
^DIC(9.4,60,22,13,"PAH",387,1,116,0)="   ROCHA,MARCELO            ROCHA,MARCELO"
^DIC(9.4,60,22,13,"PAH",387,1,117,0)="   # of Refills: 0"
^DIC(9.4,60,22,13,"PAH",387,1,118,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,119,0)="          SC Percent: 30%"
^DIC(9.4,60,22,13,"PAH",387,1,120,0)="        Disabilities: "
^DIC(9.4,60,22,13,"PAH",387,1,121,0)=" "
^DIC(9.4,60,22,13,"PAH",387,1,122,0)="   Was treatment for Service Connected condition? NO// "
^DIC(9.4,60,22,13,"PAH",387,1,123,0)="   "
^DIC(9.4,60,22,13,"PAH",387,1,124,0)="   Are you sure you want to Accept this Order? NO// YES"
^DIC(9.4,60,22,13,"PAH",387,1,125,0)="   ..."
^DIC(9.4,60,22,13,"PAH",387,1,126,0)="  "
^DIC(9.4,60,22,13,"PAH",387,1,127,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",387,1,128,0)="--------"
^DIC(9.4,60,22,13,"PAH",387,1,129,0)="Changed PSOORNEW routine to initialize the array variable PSORX(""DFLG"") "
^DIC(9.4,60,22,13,"PAH",387,1,130,0)="right before the call to file the new order and subsequent DC of the existing"
^DIC(9.4,60,22,13,"PAH",387,1,131,0)="duplicate order. This initialization will cause the code responsible for "
^DIC(9.4,60,22,13,"PAH",387,1,132,0)="discontinuing the existing order (DCORD^PSONEW2) to perform the DCing of the"
^DIC(9.4,60,22,13,"PAH",387,1,133,0)="existing order without skipping it, like it was doing before this fix."
^DIC(9.4,60,22,13,"PAH",388,0)="466 SEQ #404^3170830.17123^54"
^DIC(9.4,60,22,13,"PAH",388,1,0)="^^13^13^3170830"
^DIC(9.4,60,22,13,"PAH",388,1,1,0)="This patch will correct the following issues: "
^DIC(9.4,60,22,13,"PAH",388,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",388,1,3,0)="1) When invoking the CK action in the Outpatient Pharmacy Medication "
^DIC(9.4,60,22,13,"PAH",388,1,4,0)="   Profile screen, Non-VA and pending orders which do not contain dispense"
^DIC(9.4,60,22,13,"PAH",388,1,5,0)="   drugs do not receive allergy checks."
^DIC(9.4,60,22,13,"PAH",388,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",388,1,7,0)="2) When invoking the CK action in the Outpatient Pharmacy Medication "
^DIC(9.4,60,22,13,"PAH",388,1,8,0)="   Profile screen, the business rule for performing allergy checks on"
^DIC(9.4,60,22,13,"PAH",388,1,9,0)="   discontinued orders is not being followed."
^DIC(9.4,60,22,13,"PAH",388,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",388,1,11,0)="3) The option Print from Suspense File might erroneously skip printing"
^DIC(9.4,60,22,13,"PAH",388,1,12,0)="   some labels for orders which previously had labels printed but were put"
^DIC(9.4,60,22,13,"PAH",388,1,13,0)="   back on suspense and do need new labels."
^DIC(9.4,60,22,13,"PAH",389,0)="473 SEQ #405^3170928.171553^54"
^DIC(9.4,60,22,13,"PAH",389,1,0)="^^114^114^3170928"
^DIC(9.4,60,22,13,"PAH",389,1,1,0)="The patch addresses three (3) issues:"
^DIC(9.4,60,22,13,"PAH",389,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,3,0)=" Associated CA ticket(s):"
^DIC(9.4,60,22,13,"PAH",389,1,4,0)=" ========================"
^DIC(9.4,60,22,13,"PAH",389,1,5,0)=" 1. I8924763FY16 - Expiration date changed for prescription marked as a"
^DIC(9.4,60,22,13,"PAH",389,1,6,0)="                   titration script."
^DIC(9.4,60,22,13,"PAH",389,1,7,0)=" 2. I9667491FY16 - Renewing a script using PSO BATCH BARCODE causes crash"
^DIC(9.4,60,22,13,"PAH",389,1,8,0)="    "
^DIC(9.4,60,22,13,"PAH",389,1,9,0)=" 3. R8247671FY16 - VistA patch used at VHA station #663 that resolves the "
^DIC(9.4,60,22,13,"PAH",389,1,10,0)="                   Fill Date issue "
^DIC(9.4,60,22,13,"PAH",389,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,12,0)=" Associated PSPO(s):"
^DIC(9.4,60,22,13,"PAH",389,1,13,0)=" ==================="
^DIC(9.4,60,22,13,"PAH",389,1,14,0)=" N/A"
^DIC(9.4,60,22,13,"PAH",389,1,15,0)="    "
^DIC(9.4,60,22,13,"PAH",389,1,16,0)=" Associated NSR(s):"
^DIC(9.4,60,22,13,"PAH",389,1,17,0)=" ================="
^DIC(9.4,60,22,13,"PAH",389,1,18,0)=" N/A "
^DIC(9.4,60,22,13,"PAH",389,1,19,0)="  "
^DIC(9.4,60,22,13,"PAH",389,1,20,0)=" Participating Test Sites:"
^DIC(9.4,60,22,13,"PAH",389,1,21,0)=" ========================"
^DIC(9.4,60,22,13,"PAH",389,1,22,0)=" TBD"
^DIC(9.4,60,22,13,"PAH",389,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,24,0)=" Ticket Overview:"
^DIC(9.4,60,22,13,"PAH",389,1,25,0)=" ================"
^DIC(9.4,60,22,13,"PAH",389,1,26,0)=" 1. I8924763FY16 - When a Maintenance Rx was created as the result of"
^DIC(9.4,60,22,13,"PAH",389,1,27,0)="    converting a Titration marked Rx instead of retaining the Expiration Date"
^DIC(9.4,60,22,13,"PAH",389,1,28,0)="    from the Titration Rx it was wrongly being assigned a new Expiration"
^DIC(9.4,60,22,13,"PAH",389,1,29,0)="    Date."
^DIC(9.4,60,22,13,"PAH",389,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,31,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",389,1,32,0)=" ======="
^DIC(9.4,60,22,13,"PAH",389,1,33,0)=" When using the Patient Prescription Processing [PSO LM BACKDOOR] option"
^DIC(9.4,60,22,13,"PAH",389,1,34,0)=" and using the hidden action Convert Titration Rx (TR) to create a new"
^DIC(9.4,60,22,13,"PAH",389,1,35,0)=" Maintenance dose prescription from a Titration Rx the user noticed that the"
^DIC(9.4,60,22,13,"PAH",389,1,36,0)=" Expiration Date associated with the new Maintenance Rx was calculated 366"
^DIC(9.4,60,22,13,"PAH",389,1,37,0)=" days in the future instead of being assigned the exact same Expiration Data"
^DIC(9.4,60,22,13,"PAH",389,1,38,0)=" from the Titration Rx."
^DIC(9.4,60,22,13,"PAH",389,1,39,0)="  "
^DIC(9.4,60,22,13,"PAH",389,1,40,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",389,1,41,0)=" ========="
^DIC(9.4,60,22,13,"PAH",389,1,42,0)=" Changed the routine PSON52 responsible for creating the new Maintenance Rx"
^DIC(9.4,60,22,13,"PAH",389,1,43,0)=" to overwrite the calculated Expiration Date with the Expiration Date from"
^DIC(9.4,60,22,13,"PAH",389,1,44,0)=" the original Titration Rx."
^DIC(9.4,60,22,13,"PAH",389,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,46,0)=" ROUTINE:"
^DIC(9.4,60,22,13,"PAH",389,1,47,0)=" ======="
^DIC(9.4,60,22,13,"PAH",389,1,48,0)=" Added code at DT+1^PSON52 to set the array variable PSOX(""STOP DATE"") with "
^DIC(9.4,60,22,13,"PAH",389,1,49,0)=" the Titration Rx Expiration, if a Titration Rx To Maintenance Rx conversion"
^DIC(9.4,60,22,13,"PAH",389,1,50,0)=" is taking place."
^DIC(9.4,60,22,13,"PAH",389,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,53,0)=" 2. I9667491FY16 -The site would like to use the PSO BATCH BARCODE option to"
^DIC(9.4,60,22,13,"PAH",389,1,54,0)="    renew prescriptions. When this is attempted the renewal appears to"
^DIC(9.4,60,22,13,"PAH",389,1,55,0)="    succeed and there is a prompt to edit the renewal. If yes is selected the"
^DIC(9.4,60,22,13,"PAH",389,1,56,0)="    session will crash with an undefined variable (hard error)."
^DIC(9.4,60,22,13,"PAH",389,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,58,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",389,1,59,0)=" ======="
^DIC(9.4,60,22,13,"PAH",389,1,60,0)=" When using the Barcode Batch Prescription Entry [PSO BATCH BARCODE] option"
^DIC(9.4,60,22,13,"PAH",389,1,61,0)=" for renewals the users received a hard error and were logged out of the"
^DIC(9.4,60,22,13,"PAH",389,1,62,0)=" system when they answered YES to the ""Edit renewed Rx ?"" prompt (before"
^DIC(9.4,60,22,13,"PAH",389,1,63,0)=" accepting it)."
^DIC(9.4,60,22,13,"PAH",389,1,64,0)="  "
^DIC(9.4,60,22,13,"PAH",389,1,65,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",389,1,66,0)=" ========="
^DIC(9.4,60,22,13,"PAH",389,1,67,0)=" The root cause of this problem was due to the fact that the PSOACT variable"
^DIC(9.4,60,22,13,"PAH",389,1,68,0)=" that controls which action a specific user can perform on an order, based on"
^DIC(9.4,60,22,13,"PAH",389,1,69,0)=" the user security keys as well as whether the order was digitally signed or"
^DIC(9.4,60,22,13,"PAH",389,1,70,0)=" not. The routine PSOBBC was modified to initialize the PSOACT variable,"
^DIC(9.4,60,22,13,"PAH",389,1,71,0)=" which will prevent the hard error."
^DIC(9.4,60,22,13,"PAH",389,1,72,0)="  "
^DIC(9.4,60,22,13,"PAH",389,1,73,0)=" ROUTINE:"
^DIC(9.4,60,22,13,"PAH",389,1,74,0)=" ======="
^DIC(9.4,60,22,13,"PAH",389,1,75,0)=" Added code at NEW+9^PSOBBC to initialized the PSOACT variable according to "
^DIC(9.4,60,22,13,"PAH",389,1,76,0)=" the type of order, user's security keys and system parameters."
^DIC(9.4,60,22,13,"PAH",389,1,77,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,78,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,79,0)=" 3. We would like to request for assistance in the identification and "
^DIC(9.4,60,22,13,"PAH",389,1,80,0)="    deployment of the VistA patch used at VHA station #663 (Seattle"
^DIC(9.4,60,22,13,"PAH",389,1,81,0)="    division) that enables pharmacy staff resolves the Fill Date issue and"
^DIC(9.4,60,22,13,"PAH",389,1,82,0)="    generates the error message described below"
^DIC(9.4,60,22,13,"PAH",389,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,84,0)="    ""The earliest fill date allowed is determined by the Issue Date, the"
^DIC(9.4,60,22,13,"PAH",389,1,85,0)="    Fill Date cannot be before the Issue Date or past the Expiration"
^DIC(9.4,60,22,13,"PAH",389,1,86,0)="    Date. Both the month and day are required."""
^DIC(9.4,60,22,13,"PAH",389,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,88,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",389,1,89,0)=" ======="
^DIC(9.4,60,22,13,"PAH",389,1,90,0)=" When using the speed renewal hidden action in Patient Prescription "
^DIC(9.4,60,22,13,"PAH",389,1,91,0)=" Processing [PSO LM BACKDOOR] option, it was reported that when the # of "
^DIC(9.4,60,22,13,"PAH",389,1,92,0)=" refills is zero, there are times the expiration date is set to a date"
^DIC(9.4,60,22,13,"PAH",389,1,93,0)=" earlier than the filled date."
^DIC(9.4,60,22,13,"PAH",389,1,94,0)="  "
^DIC(9.4,60,22,13,"PAH",389,1,95,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",389,1,96,0)=" =========="
^DIC(9.4,60,22,13,"PAH",389,1,97,0)=" In a situation where the # of refill is zero, patient is not a clozapine "
^DIC(9.4,60,22,13,"PAH",389,1,98,0)=" patient and the expiration date is < fill date, added new logic to "
^DIC(9.4,60,22,13,"PAH",389,1,99,0)=" calculate the most appropriate expiration date."
^DIC(9.4,60,22,13,"PAH",389,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",389,1,102,0)=" ROUTINE:"
^DIC(9.4,60,22,13,"PAH",389,1,103,0)=" ======="
^DIC(9.4,60,22,13,"PAH",389,1,104,0)=" Added new code to DT+1^PSON52 to check if the patient is not a clozapine "
^DIC(9.4,60,22,13,"PAH",389,1,105,0)=" patient, # of Refills is zero and the Expiration Date is < Filled Date,"
^DIC(9.4,60,22,13,"PAH",389,1,106,0)=" then to set the expiration date."
^DIC(9.4,60,22,13,"PAH",389,1,107,0)=" The Expiration Date will normally be set to (Fill Date + Day Supply). "
^DIC(9.4,60,22,13,"PAH",389,1,108,0)=" However, it will be adjusted to comply with the following restrictions:"
^DIC(9.4,60,22,13,"PAH",389,1,109,0)="  - For controlled substances, the maximum Expiration Date allowable is "
^DIC(9.4,60,22,13,"PAH",389,1,110,0)="    (Issue Date + 184 days)"
^DIC(9.4,60,22,13,"PAH",389,1,111,0)="  - For non-controlled substances, the maximum Expiration Date allowable "
^DIC(9.4,60,22,13,"PAH",389,1,112,0)="    is (Issue Date + 366 days)"
^DIC(9.4,60,22,13,"PAH",389,1,113,0)="  - If the Expiration Date is less than the Fill Date, it will be set to "
^DIC(9.4,60,22,13,"PAH",389,1,114,0)="    the same as the Fill Date"
^DIC(9.4,60,22,13,"PAH",390,0)="488 SEQ #406^3171005.122359^54"
^DIC(9.4,60,22,13,"PAH",390,1,0)="^^3^3^3171005"
^DIC(9.4,60,22,13,"PAH",390,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",390,1,2,0)="1.    I9899883FY16  Drug Enter/edit option issue"
^DIC(9.4,60,22,13,"PAH",390,1,3,0)="2.    I6126024FY16  Patient name does not come up on the Bingo Board"
^DIC(9.4,60,22,13,"PAH",391,0)="422 SEQ #407^3171005.122901^54"
^DIC(9.4,60,22,13,"PAH",391,1,0)="^^8^8^3171005"
^DIC(9.4,60,22,13,"PAH",391,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,60,22,13,"PAH",391,1,2,0)="1.      If patient has Other Language Preference set to Yes and medication"
^DIC(9.4,60,22,13,"PAH",391,1,3,0)="instructions are entered into Other Patient Instructions, this"
^DIC(9.4,60,22,13,"PAH",391,1,4,0)="information will not print on the pharmacy fill part of the label."
^DIC(9.4,60,22,13,"PAH",391,1,5,0)="2.      Duplicate Prescriptions are active on a patients profile"
^DIC(9.4,60,22,13,"PAH",391,1,6,0)="3.      Pharmacy staff can process their own prescriptions"
^DIC(9.4,60,22,13,"PAH",391,1,7,0)="4.      When editing the Drug on a Prescription and answering NO to Edit "
^DIC(9.4,60,22,13,"PAH",391,1,8,0)="the SIG prompt, the Dosage is not updated to match the Drug and SIG."
^DIC(9.4,60,22,13,"PAH",392,0)="442 SEQ #408^3171102.144941^54"
^DIC(9.4,60,22,13,"PAH",392,1,0)="^^14^14^3171102"
^DIC(9.4,60,22,13,"PAH",392,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",392,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",392,1,3,0)="The patch addresses the following issues:"
^DIC(9.4,60,22,13,"PAH",392,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",392,1,5,0)="1.      Users report that when a Window Partial is filled, the Patient "
^DIC(9.4,60,22,13,"PAH",392,1,6,0)="Notification (Rx Ready) file entry (52.11) is showing the Fill Type as "
^DIC(9.4,60,22,13,"PAH",392,1,7,0)="full instead of partial."
^DIC(9.4,60,22,13,"PAH",392,1,8,0)="2.      The PSO RX Discontinue Prescription(s) reinstate process displays "
^DIC(9.4,60,22,13,"PAH",392,1,9,0)="a Therapeutic Duplication warning message then prompts to discontinue the "
^DIC(9.4,60,22,13,"PAH",392,1,10,0)="active  prescription containing the duplicate class drug but does not "
^DIC(9.4,60,22,13,"PAH",392,1,11,0)="discontinue the drug when ""Y"" is entered at the prompt."
^DIC(9.4,60,22,13,"PAH",392,1,12,0)="3.      The Outpatient Pharmacy ScripTalk label process is using %ZTIO "
^DIC(9.4,60,22,13,"PAH",392,1,13,0)="variable to write to the Prescription file's Device field. The ZTIO "
^DIC(9.4,60,22,13,"PAH",392,1,14,0)="variable is used to hold the Scrip Talk device not %ZTIO. "
^DIC(9.4,60,22,13,"PAH",393,0)="446 SEQ #409^3171127.122239^54"
^DIC(9.4,60,22,13,"PAH",393,1,0)="^^250^250^3171127"
^DIC(9.4,60,22,13,"PAH",393,1,1,0)="This patch will resolve the following issues.  "
^DIC(9.4,60,22,13,"PAH",393,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,3,0)="1. Messages from PSO EXTERNAL DISPENSE do not specify site location "
^DIC(9.4,60,22,13,"PAH",393,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,5,0)="2. Wrong authorization provider is listed on prescription in (PSPO "
^DIC(9.4,60,22,13,"PAH",393,1,6,0)="   #2696) CPRS and Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",393,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,8,0)="3. Remarks entered do not display when prescription is placed on Hold "
^DIC(9.4,60,22,13,"PAH",393,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,10,0)="4. When editing day supply for controlled orders calculating (PSPO "
^DIC(9.4,60,22,13,"PAH",393,1,11,0)="   #2580) supply incorrect."
^DIC(9.4,60,22,13,"PAH",393,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,13,0)="5. When editing the field QTY (#9) of a Pending Order the system will auto"
^DIC(9.4,60,22,13,"PAH",393,1,14,0)="   calculate if Schedule not marked PRN"
^DIC(9.4,60,22,13,"PAH",393,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,17,0)="Associated NSR(s): "
^DIC(9.4,60,22,13,"PAH",393,1,18,0)="=================="
^DIC(9.4,60,22,13,"PAH",393,1,19,0)="N/A "
^DIC(9.4,60,22,13,"PAH",393,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,21,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,60,22,13,"PAH",393,1,22,0)="============================="
^DIC(9.4,60,22,13,"PAH",393,1,23,0)="PSPO #2696 - When finishing pending orders from CPRS using the Complete "
^DIC(9.4,60,22,13,"PAH",393,1,24,0)="Orders from OERR[PSO LMOE FINISH] option, if the user selects not to "
^DIC(9.4,60,22,13,"PAH",393,1,25,0)="display the patient profile and start processing pending orders a problem "
^DIC(9.4,60,22,13,"PAH",393,1,26,0)="would occur for patients with orders issued by more than one single "
^DIC(9.4,60,22,13,"PAH",393,1,27,0)="provider."
^DIC(9.4,60,22,13,"PAH",393,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,29,0)="PSPO #2580 - For pending orders with a dispense drug where the quantity "
^DIC(9.4,60,22,13,"PAH",393,1,30,0)="can be automatically calculated based on the dosage and day's supply "
^DIC(9.4,60,22,13,"PAH",393,1,31,0)="there was a problem for certain situations where the automatic calculation"
^DIC(9.4,60,22,13,"PAH",393,1,32,0)="was not desirable."
^DIC(9.4,60,22,13,"PAH",393,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,34,0)="Test Sites: "
^DIC(9.4,60,22,13,"PAH",393,1,35,0)="==========="
^DIC(9.4,60,22,13,"PAH",393,1,36,0)="Orlando VAMC"
^DIC(9.4,60,22,13,"PAH",393,1,37,0)="Erie VAMC"
^DIC(9.4,60,22,13,"PAH",393,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,39,0)="Associated CA SDM Ticket(s):"
^DIC(9.4,60,22,13,"PAH",393,1,40,0)="============================"
^DIC(9.4,60,22,13,"PAH",393,1,41,0)="1.I9896500FY16 - Request for site ID in subject line/PSO EXTERNAL "
^DIC(9.4,60,22,13,"PAH",393,1,42,0)="                 DISPENSE Message"
^DIC(9.4,60,22,13,"PAH",393,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,44,0)="2.I9897580FY16 - Wrong authorization provider is listed on prescription "
^DIC(9.4,60,22,13,"PAH",393,1,45,0)="                 in CPRS and Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",393,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,47,0)="3.I9898461FY16 - Comment placed in ""REMARKS"" prompt is not visible if Rx "
^DIC(9.4,60,22,13,"PAH",393,1,48,0)="                 is on hold"
^DIC(9.4,60,22,13,"PAH",393,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,50,0)="4.I10167818FY16 - Editing day's supply incorrect"
^DIC(9.4,60,22,13,"PAH",393,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,52,0)="5 I14933412FY17 - When editing the QTY field (#9) of a Pending Order the "
^DIC(9.4,60,22,13,"PAH",393,1,53,0)="                  system will auto calculate if Schedule not marked PRN"
^DIC(9.4,60,22,13,"PAH",393,1,54,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,55,0)="Defect Tracking System Ticket(s) Overview:"
^DIC(9.4,60,22,13,"PAH",393,1,56,0)="=========================================="
^DIC(9.4,60,22,13,"PAH",393,1,57,0)="1. I9896500FY16 - Request for site ID in subject line/PSO EXTERNAL "
^DIC(9.4,60,22,13,"PAH",393,1,58,0)="                  DISPENSE Message"
^DIC(9.4,60,22,13,"PAH",393,1,59,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,60,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",393,1,61,0)="--------"
^DIC(9.4,60,22,13,"PAH",393,1,62,0)="When OPAI (Outpatient Pharmacy Automated Interface) tries to release a "
^DIC(9.4,60,22,13,"PAH",393,1,63,0)="prescription and it is unable to match the release information with a "
^DIC(9.4,60,22,13,"PAH",393,1,64,0)="prescription fill on file it will create a Mailman message alerting users"
^DIC(9.4,60,22,13,"PAH",393,1,65,0)="about the issue. The problem for integrated sites with multiple sites "
^DIC(9.4,60,22,13,"PAH",393,1,66,0)="using OPAI is that the Mailman message does not identify which site the"
^DIC(9.4,60,22,13,"PAH",393,1,67,0)="release information was for, prompting all the sites to lookup the Rx"
^DIC(9.4,60,22,13,"PAH",393,1,68,0)="record to find out whether it belongs to them or not."
^DIC(9.4,60,22,13,"PAH",393,1,69,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,70,0)="Current message subject: ""External Dispense - Rx Release Attempted"" "
^DIC(9.4,60,22,13,"PAH",393,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,72,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,73,0)="-----------"
^DIC(9.4,60,22,13,"PAH",393,1,74,0)="The Mailman message subject was modified to include the Site Number at the"
^DIC(9.4,60,22,13,"PAH",393,1,75,0)="beginning. This will be consistent with other mailman messages that "
^DIC(9.4,60,22,13,"PAH",393,1,76,0)="already identify the Rx site in the message subject."
^DIC(9.4,60,22,13,"PAH",393,1,77,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,78,0)="New message subject: ""500 External Dispense - Rx Release Attempted"" "
^DIC(9.4,60,22,13,"PAH",393,1,79,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,80,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,81,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",393,1,82,0)="Modify routine PSOHLDI1 at tag MAIL+13: add the following code: "
^DIC(9.4,60,22,13,"PAH",393,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,84,0)="S XMSUB=$S($G(PSOSITE):$$GET1^DIQ(59,PSOSITE,.06)_"" "",1:"""")_""External "
^DIC(9.4,60,22,13,"PAH",393,1,85,0)="Dispense - Rx Release Attempted"""
^DIC(9.4,60,22,13,"PAH",393,1,86,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,87,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,88,0)="2. I9897580FY16 - The Wrong authorization provider is listed on "
^DIC(9.4,60,22,13,"PAH",393,1,89,0)="                  prescription in CPRS and Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",393,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,91,0)="PSPO #2696"
^DIC(9.4,60,22,13,"PAH",393,1,92,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,93,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",393,1,94,0)="--------"
^DIC(9.4,60,22,13,"PAH",393,1,95,0)="When finishing pending orders from CPRS using the Complete Orders from "
^DIC(9.4,60,22,13,"PAH",393,1,96,0)="OERR [PSO LMOE FINISH] option, if the user selects not to display the"
^DIC(9.4,60,22,13,"PAH",393,1,97,0)="patient profile and start processing pending orders a problem would occur"
^DIC(9.4,60,22,13,"PAH",393,1,98,0)="for patients with orders issued by more than one single provider. If the"
^DIC(9.4,60,22,13,"PAH",393,1,99,0)="user selected the Provider field (#13) and merely confirmed it,"
^DIC(9.4,60,22,13,"PAH",393,1,100,0)="the prescriber would be carried over to the next pending orders for that"
^DIC(9.4,60,22,13,"PAH",393,1,101,0)="same patient."
^DIC(9.4,60,22,13,"PAH",393,1,102,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,103,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,104,0)="-----------"
^DIC(9.4,60,22,13,"PAH",393,1,105,0)="The array variable PSORX(""PROVIDER NAME"") that stores information about "
^DIC(9.4,60,22,13,"PAH",393,1,106,0)="the provider was not being properly initialized between the processing"
^DIC(9.4,60,22,13,"PAH",393,1,107,0)="each of the patient's pending orders. The code was modified to kill the"
^DIC(9.4,60,22,13,"PAH",393,1,108,0)="array variable PSORX before processing each of the patient's pending"
^DIC(9.4,60,22,13,"PAH",393,1,109,0)="order.  "
^DIC(9.4,60,22,13,"PAH",393,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,111,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,112,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",393,1,113,0)="Modified the routine PSOORFIN at tags SUCC+4 and PSOORFIN+19 to kill "
^DIC(9.4,60,22,13,"PAH",393,1,114,0)="array variable PSORX(""PROVIDER NAME"")"
^DIC(9.4,60,22,13,"PAH",393,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,116,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,117,0)="3. I9898461FY16 - Comment placed in ""REMARKS"" prompt is not visible if Rx "
^DIC(9.4,60,22,13,"PAH",393,1,118,0)="                  is on HOLD "
^DIC(9.4,60,22,13,"PAH",393,1,119,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,120,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",393,1,121,0)="--------"
^DIC(9.4,60,22,13,"PAH",393,1,122,0)="Comments entered into the REMARKS field (#15) were not being displayed"
^DIC(9.4,60,22,13,"PAH",393,1,123,0)="when a prescription was put on hold. Once the prescription was removed"
^DIC(9.4,60,22,13,"PAH",393,1,124,0)="from hold, the remarks would become visible again."
^DIC(9.4,60,22,13,"PAH",393,1,125,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,126,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,127,0)="-----------"
^DIC(9.4,60,22,13,"PAH",393,1,128,0)="Modified routine PSOORNE2 so the comments entered into the REMARKS field "
^DIC(9.4,60,22,13,"PAH",393,1,129,0)="(#15) display when the prescription is put on hold. "
^DIC(9.4,60,22,13,"PAH",393,1,130,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,131,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,132,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",393,1,133,0)="Modified the routine ACT+2^PSOORNE2 to set just $P(RX3,""^"") instead of "
^DIC(9.4,60,22,13,"PAH",393,1,134,0)="the entire RX3 variable, as shown below:"
^DIC(9.4,60,22,13,"PAH",393,1,135,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,136,0)="I 'RX3 S RX3=$P(RX2,""^"",2),$P(^PSRX(RXN,3),""^"")=$P(RX2,""^"",2) "
^DIC(9.4,60,22,13,"PAH",393,1,137,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,138,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,139,0)="4. I10167818FY16 - Editing day's supply incorrect"
^DIC(9.4,60,22,13,"PAH",393,1,140,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,141,0)="PSPO #2580 "
^DIC(9.4,60,22,13,"PAH",393,1,142,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,143,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",393,1,144,0)="--------"
^DIC(9.4,60,22,13,"PAH",393,1,145,0)="For pending orders with a dispense drug where the quantity can be"
^DIC(9.4,60,22,13,"PAH",393,1,146,0)="automatically calculated based on the dosage and days supply there was a"
^DIC(9.4,60,22,13,"PAH",393,1,147,0)="problem for certain situations where the automatic calculation was not"
^DIC(9.4,60,22,13,"PAH",393,1,148,0)="desirable. For example, the prescriber would order 10 tablets of a "
^DIC(9.4,60,22,13,"PAH",393,1,149,0)="controlled substance medication with a 30 days supply PRN (As Needed) to"
^DIC(9.4,60,22,13,"PAH",393,1,150,0)="be taken no more than twice a day. When the Outpatient Pharmacy user"
^DIC(9.4,60,22,13,"PAH",393,1,151,0)="edited the DAYS SUPPLY field (#8) for such order and changed it from 30 to"
^DIC(9.4,60,22,13,"PAH",393,1,152,0)="28, as an example, the software would automatically update the quantity"
^DIC(9.4,60,22,13,"PAH",393,1,153,0)="from 10 to 56, which is clearly inconsistent with the prescriber's initial"
^DIC(9.4,60,22,13,"PAH",393,1,154,0)="intention.  "
^DIC(9.4,60,22,13,"PAH",393,1,155,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,156,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,157,0)="-----------"
^DIC(9.4,60,22,13,"PAH",393,1,158,0)="A new logic has been introduced related to the editing the DAYS SUPPLY "
^DIC(9.4,60,22,13,"PAH",393,1,159,0)="field (#8) of a pending order:"
^DIC(9.4,60,22,13,"PAH",393,1,160,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,161,0)=" 1. For single dose order the software will not automatically recalculate "
^DIC(9.4,60,22,13,"PAH",393,1,162,0)="    the Quantity field if the current Quantity value on the order is not"
^DIC(9.4,60,22,13,"PAH",393,1,163,0)="    the result of a calculation based on the current Day Supply value"
^DIC(9.4,60,22,13,"PAH",393,1,164,0)="    (before the edit), which suggests the Quantity was previously manually"
^DIC(9.4,60,22,13,"PAH",393,1,165,0)="    entered (not calculated)."
^DIC(9.4,60,22,13,"PAH",393,1,166,0)=" 2. The software will not take into account whether the Schedule is marked"
^DIC(9.4,60,22,13,"PAH",393,1,167,0)="    PRN (As Needed) or not when deciding to automatically recalculate the"
^DIC(9.4,60,22,13,"PAH",393,1,168,0)="    QTY field (#9)."
^DIC(9.4,60,22,13,"PAH",393,1,169,0)=" 3. For a Controlled Substance pending order the system will not "
^DIC(9.4,60,22,13,"PAH",393,1,170,0)="    automatically recalculate the Quantity field (#9) if it will cause the"
^DIC(9.4,60,22,13,"PAH",393,1,171,0)="    current Quantity value to be increased."
^DIC(9.4,60,22,13,"PAH",393,1,172,0)=" 4. For a Complex Controlled Substance pending order the system will not "
^DIC(9.4,60,22,13,"PAH",393,1,173,0)="    automatically recalculate the Quantity field (#9)."
^DIC(9.4,60,22,13,"PAH",393,1,174,0)=" 5. For a pending order that qualify for a Quantity recalculation that did"
^DIC(9.4,60,22,13,"PAH",393,1,175,0)="    not happen because of one of the rules above (1, 3 and 4), the system"
^DIC(9.4,60,22,13,"PAH",393,1,176,0)="    will display the following message to the user editing the DAYS SUPPLY"
^DIC(9.4,60,22,13,"PAH",393,1,177,0)="    field (#8): "
^DIC(9.4,60,22,13,"PAH",393,1,178,0)="    "
^DIC(9.4,60,22,13,"PAH",393,1,179,0)="          The QTY (99) has not been changed.  "
^DIC(9.4,60,22,13,"PAH",393,1,180,0)="          Please, review and update it if necessary.  "
^DIC(9.4,60,22,13,"PAH",393,1,181,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,182,0)="Additionally, a modification was introduced to prevent any automatic"
^DIC(9.4,60,22,13,"PAH",393,1,183,0)="calculation/update of the QTY field (#9) for a new, pending or existing"
^DIC(9.4,60,22,13,"PAH",393,1,184,0)="order when the user selects to specifically edit the QTY field (#9)"
^DIC(9.4,60,22,13,"PAH",393,1,185,0)="itself."
^DIC(9.4,60,22,13,"PAH",393,1,186,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,187,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,188,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",393,1,189,0)="Modified routines PSODIR1, PSOSIG, PSOSIGCX and PSOSIGTX to implement the "
^DIC(9.4,60,22,13,"PAH",393,1,190,0)="new rules above."
^DIC(9.4,60,22,13,"PAH",393,1,191,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,192,0)="5. I14933412FY17 - When editing the QTY field (#9) of a Pending Order the "
^DIC(9.4,60,22,13,"PAH",393,1,193,0)="                   system will auto calculate if Schedule not marked PRN"
^DIC(9.4,60,22,13,"PAH",393,1,194,0)="   "
^DIC(9.4,60,22,13,"PAH",393,1,195,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",393,1,196,0)="--------"
^DIC(9.4,60,22,13,"PAH",393,1,197,0)="When using the options Patient Prescription Processing [PSO LM BACKDOOR"
^DIC(9.4,60,22,13,"PAH",393,1,198,0)="ORDERS] or Complete Orders from OERR [PSO LMOE FINISH] if the user tries "
^DIC(9.4,60,22,13,"PAH",393,1,199,0)="to edit the QTY field (#9) of the pending order and if the quantity can be"
^DIC(9.4,60,22,13,"PAH",393,1,200,0)="automatically calculated and the current value does not match the "
^DIC(9.4,60,22,13,"PAH",393,1,201,0)="calculated value the software will automatically replace the current value"
^DIC(9.4,60,22,13,"PAH",393,1,202,0)="with the calculated value before prompting the user for the QTY field (#9)"
^DIC(9.4,60,22,13,"PAH",393,1,203,0)="for the order."
^DIC(9.4,60,22,13,"PAH",393,1,204,0)=" "
^DIC(9.4,60,22,13,"PAH",393,1,205,0)="As seen on the example below:"
^DIC(9.4,60,22,13,"PAH",393,1,206,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,207,0)="    Pending OP Orders (ROUTINE)   Jun 06, 2017@15:13:57      Page: 2 of 3 "
^DIC(9.4,60,22,13,"PAH",393,1,208,0)="     TESPATNM,ROB                                          <A> "
^DIC(9.4,60,22,13,"PAH",393,1,209,0)="       PID: 666-00-0258                          Ht(cm): _______ (______) "
^DIC(9.4,60,22,13,"PAH",393,1,210,0)="       DOB: JUL 21,1963 (53)                     Wt(kg): _______ (______) "
^DIC(9.4,60,22,13,"PAH",393,1,211,0)="    +---------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",393,1,212,0)="       (4)   Pat Instruct:                                         "
^DIC(9.4,60,22,13,"PAH",393,1,213,0)="        Provider Comments:                                         "
^DIC(9.4,60,22,13,"PAH",393,1,214,0)="             Instructions: TAKE ONE TABLET PO QDAY                 "
^DIC(9.4,60,22,13,"PAH",393,1,215,0)="                      SIG: TAKE ONE TABLET BY BY MOUTH EVERY DAY  "
^DIC(9.4,60,22,13,"PAH",393,1,216,0)="       (5) Patient Status: SC                                   "
^DIC(9.4,60,22,13,"PAH",393,1,217,0)="       (6)     Issue Date: JUN 6,2017        (7) Fill Date: JUN 6,2017 "
^DIC(9.4,60,22,13,"PAH",393,1,218,0)="       (8)    Days Supply: 30                (9)   QTY (TAB): 10       "
^DIC(9.4,60,22,13,"PAH",393,1,219,0)="         Provider ordered: days supply 30, quantity 10 & refills 0   "
^DIC(9.4,60,22,13,"PAH",393,1,220,0)="      (10)   # of Refills: 0                (11)   Routing: MAIL     "
^DIC(9.4,60,22,13,"PAH",393,1,221,0)="      (12)         Clinic: NHCU                                      "
^DIC(9.4,60,22,13,"PAH",393,1,222,0)="      (13)       Provider: ROCHA,MARCELO                             "
^DIC(9.4,60,22,13,"PAH",393,1,223,0)="      (14)         Copies: 1                                         "
^DIC(9.4,60,22,13,"PAH",393,1,224,0)="      (15)        Remarks:                                           "
^DIC(9.4,60,22,13,"PAH",393,1,225,0)="         Entry By: ROCHA,MARCELO            Entry Date: 06/06/17 12:07:24 "
^DIC(9.4,60,22,13,"PAH",393,1,226,0)="    -------Digitally Signed Order---------------------------------------- "
^DIC(9.4,60,22,13,"PAH",393,1,227,0)="    BY  Bypass                DC  Discontinue           FL  Flag/Unflag "
^DIC(9.4,60,22,13,"PAH",393,1,228,0)="    ED  Edit                  FN  Finish "
^DIC(9.4,60,22,13,"PAH",393,1,229,0)="    Select Item(s): Quit// 9     "
^DIC(9.4,60,22,13,"PAH",393,1,230,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,231,0)="     Quantity has been changed from 10 to 30 "
^DIC(9.4,60,22,13,"PAH",393,1,232,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,233,0)="     Press Return to Continue: "
^DIC(9.4,60,22,13,"PAH",393,1,234,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,235,0)="     QTY ( TAB ) : 30// "
^DIC(9.4,60,22,13,"PAH",393,1,236,0)="  "
^DIC(9.4,60,22,13,"PAH",393,1,237,0)="Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,238,0)="-----------"
^DIC(9.4,60,22,13,"PAH",393,1,239,0)="A change was introduced to the code responsible for handling the editing "
^DIC(9.4,60,22,13,"PAH",393,1,240,0)="of the QTY field (#9) of a pending order to prevent any automatic"
^DIC(9.4,60,22,13,"PAH",393,1,241,0)="recalculation and update of the quantity value from happening before the"
^DIC(9.4,60,22,13,"PAH",393,1,242,0)="user is prompted for the QTY prompt. Also, when entering a new order the"
^DIC(9.4,60,22,13,"PAH",393,1,243,0)="software will not try to auto update the QTY value if a value already is"
^DIC(9.4,60,22,13,"PAH",393,1,244,0)="defined and the user is chooses to edit the QTY field (#9)."
^DIC(9.4,60,22,13,"PAH",393,1,245,0)="   "
^DIC(9.4,60,22,13,"PAH",393,1,246,0)="Technical Resolution: "
^DIC(9.4,60,22,13,"PAH",393,1,247,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",393,1,248,0)="Modified the routine PSODIR1 at the QTY line tag that handles the QTY "
^DIC(9.4,60,22,13,"PAH",393,1,249,0)="editing logic to not call QTY^PSOSIG (responsible for recalculating the"
^DIC(9.4,60,22,13,"PAH",393,1,250,0)="quantity) when a quantity already exists for the order."
^DIC(9.4,60,22,13,"PAH",394,0)="478^3171127.134855^54"
^DIC(9.4,60,22,13,"PAH",394,1,0)="^^1^1^3171127"
^DIC(9.4,60,22,13,"PAH",394,1,1,0)="MCCF EDI TAS EPHARMACY BUILD 2"
^DIC(9.4,60,22,13,"PAH",395,0)="495 SEQ #411^3171128.124717^54"
^DIC(9.4,60,22,13,"PAH",395,1,0)="^^86^86^3171128"
^DIC(9.4,60,22,13,"PAH",395,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",395,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,3,0)=" 1. I8213786FY16  - Using Option RESET COPAY STATUS/CANCEL displays "
^DIC(9.4,60,22,13,"PAH",395,1,4,0)="                    ALL copay exemption flags after edit."
^DIC(9.4,60,22,13,"PAH",395,1,5,0)=" 2. I15627556FY17 - HARD ERROR DURING VERIFYING A DIGITALLY SIGNED "
^DIC(9.4,60,22,13,"PAH",395,1,6,0)="                    PENDING ORDER "
^DIC(9.4,60,22,13,"PAH",395,1,7,0)=" 3. I11377620FY17 - Controlled substance prescription hash mismatch. "
^DIC(9.4,60,22,13,"PAH",395,1,8,0)=" 4. I9662455FY16 - Corrupted hash mismatch has a patient's last 4 "
^DIC(9.4,60,22,13,"PAH",395,1,9,0)="                   of SSN incorrect. "
^DIC(9.4,60,22,13,"PAH",395,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,11,0)=" Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",395,1,12,0)=" ==========================================="
^DIC(9.4,60,22,13,"PAH",395,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,14,0)=" 1. I8213786FY16 -  Using Option RESET COPAY STATUS/CANCEL displays"
^DIC(9.4,60,22,13,"PAH",395,1,15,0)="                    ALL copay exemption flags after edit."
^DIC(9.4,60,22,13,"PAH",395,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,17,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",395,1,18,0)=" ======="
^DIC(9.4,60,22,13,"PAH",395,1,19,0)=" While using option RESET COPAY STATUS/CANCEL to edit copay exemption"
^DIC(9.4,60,22,13,"PAH",395,1,20,0)=" flags, when a person is automatically Exempt from Copay (such as Service"
^DIC(9.4,60,22,13,"PAH",395,1,21,0)=" Connected 70%) the output displays ALL copay exemption flag end states "
^DIC(9.4,60,22,13,"PAH",395,1,22,0)=" rather than only those copay exemptions that have changed. "
^DIC(9.4,60,22,13,"PAH",395,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,24,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",395,1,25,0)=" =========="
^DIC(9.4,60,22,13,"PAH",395,1,26,0)=" The logic that determined whether the new exemption value was different"
^DIC(9.4,60,22,13,"PAH",395,1,27,0)=" from the old was based off a node in the prescription file that may not "
^DIC(9.4,60,22,13,"PAH",395,1,28,0)=" exist. The routine for this option now compares the user's response to"
^DIC(9.4,60,22,13,"PAH",395,1,29,0)=" the value stored in the prescription file to determine if the value has"
^DIC(9.4,60,22,13,"PAH",395,1,30,0)=" changed."
^DIC(9.4,60,22,13,"PAH",395,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,32,0)=" 2. I15627556FY17 - HARD ERROR DURING VERIFYING A DIGITALLY SIGNED "
^DIC(9.4,60,22,13,"PAH",395,1,33,0)="                    PENDING ORDER "
^DIC(9.4,60,22,13,"PAH",395,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,35,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",395,1,36,0)=" ======="
^DIC(9.4,60,22,13,"PAH",395,1,37,0)=" When processing a digitally signed pending order, if that order is "
^DIC(9.4,60,22,13,"PAH",395,1,38,0)=" auto discontinued due to an address mismatch, there is a possibility of"
^DIC(9.4,60,22,13,"PAH",395,1,39,0)=" getting a hard error while generating the auto discontinued mail message."
^DIC(9.4,60,22,13,"PAH",395,1,40,0)=" This can happen for a patient who has a non verified allergy and if the"
^DIC(9.4,60,22,13,"PAH",395,1,41,0)=" patient address was changed using the PU Patient Record Update ListMan"
^DIC(9.4,60,22,13,"PAH",395,1,42,0)=" action prior to processing the pending order."
^DIC(9.4,60,22,13,"PAH",395,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,44,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",395,1,45,0)=" =========="
^DIC(9.4,60,22,13,"PAH",395,1,46,0)=" When the PU Patient Record Update ListMan action is used, it kills the "
^DIC(9.4,60,22,13,"PAH",395,1,47,0)=" DFN variable. Modified routine PSOPKIV2 to reset variable DFN if found "
^DIC(9.4,60,22,13,"PAH",395,1,48,0)=" missing and to make a call to VADPT."
^DIC(9.4,60,22,13,"PAH",395,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,50,0)=" ROUTINE:"
^DIC(9.4,60,22,13,"PAH",395,1,51,0)=" ======="
^DIC(9.4,60,22,13,"PAH",395,1,52,0)=" At line tag ADCMAIL+1, added code,"
^DIC(9.4,60,22,13,"PAH",395,1,53,0)=" S:'$G(DFN) DFN=PSODFN D ^VADPT,ADD^VADPT"
^DIC(9.4,60,22,13,"PAH",395,1,54,0)=" At line tag PADAD+1, removed the call VADPT and ADD^VADPT as it's moved"
^DIC(9.4,60,22,13,"PAH",395,1,55,0)=" to ADCMAIL+1"
^DIC(9.4,60,22,13,"PAH",395,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,57,0)=" 3. I11377620FY17 - Controlled substance prescription hash mismatch."
^DIC(9.4,60,22,13,"PAH",395,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,59,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",395,1,60,0)=" ======="
^DIC(9.4,60,22,13,"PAH",395,1,61,0)=" Site reports that when a controlled substance prescription hash "
^DIC(9.4,60,22,13,"PAH",395,1,62,0)=" mismatch status the vista email that is generated has the incorrect "
^DIC(9.4,60,22,13,"PAH",395,1,63,0)=" last four the the ssn. "
^DIC(9.4,60,22,13,"PAH",395,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,65,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",395,1,66,0)=" =========="
^DIC(9.4,60,22,13,"PAH",395,1,67,0)=" When generating the auto discontinued mail message, variable VA(""BID"") "
^DIC(9.4,60,22,13,"PAH",395,1,68,0)=" that has the last 4 of the SSN is being used, which in this case happens "
^DIC(9.4,60,22,13,"PAH",395,1,69,0)=" to be from a previous patient.  "
^DIC(9.4,60,22,13,"PAH",395,1,70,0)=" Modified routine PSOPKIV2 to ensure that the variable VA(""BID"") is for "
^DIC(9.4,60,22,13,"PAH",395,1,71,0)=" that patient by making a call to VADPT."
^DIC(9.4,60,22,13,"PAH",395,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,73,0)=" 4. I9662455FY16 - Corrupted hash mismatch has a patient's last 4 "
^DIC(9.4,60,22,13,"PAH",395,1,74,0)="                   of SSN incorrect."
^DIC(9.4,60,22,13,"PAH",395,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,76,0)=" Problem:"
^DIC(9.4,60,22,13,"PAH",395,1,77,0)=" ======="
^DIC(9.4,60,22,13,"PAH",395,1,78,0)=" Site reports that a corrupted hash mismatch has a patient's last 4 "
^DIC(9.4,60,22,13,"PAH",395,1,79,0)=" of SSN incorrect."
^DIC(9.4,60,22,13,"PAH",395,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",395,1,81,0)=" Resolution:"
^DIC(9.4,60,22,13,"PAH",395,1,82,0)=" =========="
^DIC(9.4,60,22,13,"PAH",395,1,83,0)=" When generating the auto discontinued mail message, variable VA(""BID"") "
^DIC(9.4,60,22,13,"PAH",395,1,84,0)=" that has the last 4 of the SSN is being used, which in this case happens "
^DIC(9.4,60,22,13,"PAH",395,1,85,0)=" to be from a previous patient.  "
^DIC(9.4,60,22,13,"PAH",395,1,86,0)=" Modified routine PSOPKIV2 to ensure that the variable VA(""BID"") is for"
^DIC(9.4,60,22,13,"PAH",396,0)="490 SEQ #412^3171201.124516^54"
^DIC(9.4,60,22,13,"PAH",396,1,0)="^^2^2^3171201"
^DIC(9.4,60,22,13,"PAH",396,1,1,0)="This patch will fix the following issue."
^DIC(9.4,60,22,13,"PAH",396,1,2,0)="  I9914094FY16  OTH, PRO, OP screen flashes by within seconds"
^DIC(9.4,60,22,13,"PAH",397,0)="462 SEQ #413^3171227.144229^54"
^DIC(9.4,60,22,13,"PAH",397,1,0)="^^5^5^3171227"
^DIC(9.4,60,22,13,"PAH",397,1,1,0)="==========="
^DIC(9.4,60,22,13,"PAH",397,1,2,0)="The patch addresses (2) issues:"
^DIC(9.4,60,22,13,"PAH",397,1,3,0)="1. Other than CMOP prescription not printed when used manual mail-out CM"
^DIC(9.4,60,22,13,"PAH",397,1,4,0)="2. Controlled substance auto-discontinued when signed and released days "
^DIC(9.4,60,22,13,"PAH",397,1,5,0)="   are different."
^DIC(9.4,60,22,13,"PAH",398,0)="467 SEQ #414^3171227.162209^54"
^DIC(9.4,60,22,13,"PAH",398,1,0)="^^1^1^3171227"
^DIC(9.4,60,22,13,"PAH",398,1,1,0)="Inbound electronic prescribing enhancements."
^DIC(9.4,60,22,13,"PAH",399,0)="501 SEQ #415^3180103.133907^54"
^DIC(9.4,60,22,13,"PAH",399,1,0)="^^4^4^3180103"
^DIC(9.4,60,22,13,"PAH",399,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",399,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",399,1,3,0)=" 1. Speed refill message displays too quickly to be read. "
^DIC(9.4,60,22,13,"PAH",399,1,4,0)=" 2. Pharmacist Enter/Edit option display issue."
^DIC(9.4,60,22,13,"PAH",400,0)="498 SEQ #416^3180103.173037^54"
^DIC(9.4,60,22,13,"PAH",400,1,0)="^^3^3^3180103"
^DIC(9.4,60,22,13,"PAH",400,1,1,0)="This patch will fix the following issue."
^DIC(9.4,60,22,13,"PAH",400,1,2,0)="1.      I9914421FY16  all prescription information is not displayed"
^DIC(9.4,60,22,13,"PAH",400,1,3,0)="        on the Pharmacy verification screen"
^DIC(9.4,60,22,13,"PAH",401,0)="506 SEQ #417^3180130.144752^54"
^DIC(9.4,60,22,13,"PAH",401,1,0)="^^1^1^3180130"
^DIC(9.4,60,22,13,"PAH",401,1,1,0)="Emergency patch to resolve hard error during drug validation."
^DIC(9.4,60,22,13,"PAH",402,0)="497 SEQ #418^3180130.153458^54"
^DIC(9.4,60,22,13,"PAH",403,0)="499 SEQ #419^3180227.140651^54"
^DIC(9.4,60,22,13,"PAH",403,1,0)="^^8^8^3180227"
^DIC(9.4,60,22,13,"PAH",403,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",403,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",403,1,3,0)="1.      I12011023FY17 - One-VA partial functionality does not restrict"
^DIC(9.4,60,22,13,"PAH",403,1,4,0)="                        quantity"
^DIC(9.4,60,22,13,"PAH",403,1,5,0)="2.      I12010975FY17 - One-VA displaying inconsistent information"
^DIC(9.4,60,22,13,"PAH",403,1,6,0)="                        in VistA options"
^DIC(9.4,60,22,13,"PAH",403,1,7,0)="3.      I12150112FY17 - OneVA Pharmacy Selection of Drugs by the"
^DIC(9.4,60,22,13,"PAH",403,1,8,0)="                        Dispensing Site"
^DIC(9.4,60,22,13,"PAH",404,0)="509 SEQ #420^3180228.165158^54"
^DIC(9.4,60,22,13,"PAH",404,1,0)="^^6^6^3180228"
^DIC(9.4,60,22,13,"PAH",404,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",404,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",404,1,3,0)="1. I17894075FY18 - Pharmacist not showing up for renewal in "
^DIC(9.4,60,22,13,"PAH",404,1,4,0)="                   View Prescription; typo in HELP-PROMPT"
^DIC(9.4,60,22,13,"PAH",404,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",404,1,6,0)="2. I18165455FY18 - OneVA issue for Refill and Partial"
^DIC(9.4,60,22,13,"PAH",405,0)="496 SEQ #421^3180301.150936^54"
^DIC(9.4,60,22,13,"PAH",405,1,0)="^^116^116^3180301"
^DIC(9.4,60,22,13,"PAH",405,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",405,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,3,0)="1. It is possible to suspend a script past the expiration date."
^DIC(9.4,60,22,13,"PAH",405,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,5,0)="2. Vista transmits two instances of the same prescription to the external"
^DIC(9.4,60,22,13,"PAH",405,1,6,0)="   interface. "
^DIC(9.4,60,22,13,"PAH",405,1,7,0)="    "
^DIC(9.4,60,22,13,"PAH",405,1,8,0)="3.  Need assistance with SPMP Patient Address errors  "
^DIC(9.4,60,22,13,"PAH",405,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,11,0)="Associated NSR(s)"
^DIC(9.4,60,22,13,"PAH",405,1,12,0)="================="
^DIC(9.4,60,22,13,"PAH",405,1,13,0)=" N/A "
^DIC(9.4,60,22,13,"PAH",405,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,15,0)="Test Sites:"
^DIC(9.4,60,22,13,"PAH",405,1,16,0)="=========="
^DIC(9.4,60,22,13,"PAH",405,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,18,0)="Associated CA SDM Ticket(s):"
^DIC(9.4,60,22,13,"PAH",405,1,19,0)="============================"
^DIC(9.4,60,22,13,"PAH",405,1,20,0)="1. I10127879FY16 - It is possible to suspend a script past the expiration"
^DIC(9.4,60,22,13,"PAH",405,1,21,0)="                   date. "
^DIC(9.4,60,22,13,"PAH",405,1,22,0)="2. I16514233FY17 - Vista transmits two instances of the same prescription"
^DIC(9.4,60,22,13,"PAH",405,1,23,0)="                   to the external interface. "
^DIC(9.4,60,22,13,"PAH",405,1,24,0)="   R14795402FY17(d) - Vista is sending over prescription data twice for "
^DIC(9.4,60,22,13,"PAH",405,1,25,0)="                      SOME prescriptions, resulting in duplicates showing"
^DIC(9.4,60,22,13,"PAH",405,1,26,0)="                      up in ScriptPro"
^DIC(9.4,60,22,13,"PAH",405,1,27,0)="3. I11517650FY17 - Need assistance with SPMP Patient Address errors "
^DIC(9.4,60,22,13,"PAH",405,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,29,0)="  "
^DIC(9.4,60,22,13,"PAH",405,1,30,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",405,1,31,0)="============================================"
^DIC(9.4,60,22,13,"PAH",405,1,32,0)="1. I10127879FY16 - It is possible to suspend a script past the expiration"
^DIC(9.4,60,22,13,"PAH",405,1,33,0)="                   date.  "
^DIC(9.4,60,22,13,"PAH",405,1,34,0)="Problem:"
^DIC(9.4,60,22,13,"PAH",405,1,35,0)="--------"
^DIC(9.4,60,22,13,"PAH",405,1,36,0)="Currently in Outpatient Pharmacy the users are able to enter a REFILL DATE "
^DIC(9.4,60,22,13,"PAH",405,1,37,0)="that is past the Rx EXPIRATION DATE. The software should not allow a refill"
^DIC(9.4,60,22,13,"PAH",405,1,38,0)="date that is past the expiration date because it is an invalid date and the"
^DIC(9.4,60,22,13,"PAH",405,1,39,0)="prescription will be expired before it can be dispensed."
^DIC(9.4,60,22,13,"PAH",405,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,41,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",405,1,42,0)="-----------"
^DIC(9.4,60,22,13,"PAH",405,1,43,0)="The Data Dictionary for the PRESCRIPTION file (#52) was modified to include "
^DIC(9.4,60,22,13,"PAH",405,1,44,0)="restrictions on the following fields: FILL DATE (#22) and REFILL DATE (#.01)"
^DIC(9.4,60,22,13,"PAH",405,1,45,0)="in the REFILL sub-file (#52.1). The restrictions will require that the value"
^DIC(9.4,60,22,13,"PAH",405,1,46,0)="entered for either one of these two fields cannot be before the Rx ISSUE"
^DIC(9.4,60,22,13,"PAH",405,1,47,0)="DATE or after the Rx EXPIRATION DATE."
^DIC(9.4,60,22,13,"PAH",405,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,49,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",405,1,50,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",405,1,51,0)="Created new INPUT TRANSFORM code (FLDTINTR^PSOUTLA(Fill_Type)) and new "
^DIC(9.4,60,22,13,"PAH",405,1,52,0)="EXECUTABLE HELP code (FLDTHELP^PSOUTLA(Fill_Type)) and modified the fields"
^DIC(9.4,60,22,13,"PAH",405,1,53,0)="mentioned above to replace the current M code with calls to these two new"
^DIC(9.4,60,22,13,"PAH",405,1,54,0)="entry points in the PSOUTLA routine."
^DIC(9.4,60,22,13,"PAH",405,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,56,0)="Files & Fields Associated:"
^DIC(9.4,60,22,13,"PAH",405,1,57,0)="------------------------- "
^DIC(9.4,60,22,13,"PAH",405,1,58,0)="File Name (#)      Field Name (#)                         New/Modified/Deleted"
^DIC(9.4,60,22,13,"PAH",405,1,59,0)="-----------------  -------------------------------------- --------------------"
^DIC(9.4,60,22,13,"PAH",405,1,60,0)="PRESCRIPTION(#52)  FILL DATE (#22)                        Modified "
^DIC(9.4,60,22,13,"PAH",405,1,61,0)="                   REFILL (#52.1)"
^DIC(9.4,60,22,13,"PAH",405,1,62,0)="                   -REFILL DATE (#.01)                    Modified"
^DIC(9.4,60,22,13,"PAH",405,1,63,0)="  "
^DIC(9.4,60,22,13,"PAH",405,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,65,0)="2. I16514233FY17 - Vista transmits two instances of the same prescription"
^DIC(9.4,60,22,13,"PAH",405,1,66,0)="                   to the external interface. "
^DIC(9.4,60,22,13,"PAH",405,1,67,0)="   R14795402FY17(d) - Vista is sending over prescription data twice for SOME"
^DIC(9.4,60,22,13,"PAH",405,1,68,0)="                      prescriptions, resulting in duplicates showing up in"
^DIC(9.4,60,22,13,"PAH",405,1,69,0)="                      ScriptPro"
^DIC(9.4,60,22,13,"PAH",405,1,70,0)="  "
^DIC(9.4,60,22,13,"PAH",405,1,71,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",405,1,72,0)="--------"
^DIC(9.4,60,22,13,"PAH",405,1,73,0)="There is at least one scenario in Outpatient Pharmacy that will cause a "
^DIC(9.4,60,22,13,"PAH",405,1,74,0)="prescription fill to be sent twice to the external interface. This happens"
^DIC(9.4,60,22,13,"PAH",405,1,75,0)="because sometimes when the user pulls a CMOP prescription from suspense to "
^DIC(9.4,60,22,13,"PAH",405,1,76,0)="print locally it will be sent to the print queue twice and consequently it"
^DIC(9.4,60,22,13,"PAH",405,1,77,0)="was also being sent to the external interface twice."
^DIC(9.4,60,22,13,"PAH",405,1,78,0)="  "
^DIC(9.4,60,22,13,"PAH",405,1,79,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",405,1,80,0)="-----------"
^DIC(9.4,60,22,13,"PAH",405,1,81,0)="Added a check in the routine that handles the pull from suspense to prevent"
^DIC(9.4,60,22,13,"PAH",405,1,82,0)="it from adding a prescription to the print queue if the prescription is"
^DIC(9.4,60,22,13,"PAH",405,1,83,0)="already on the queue."
^DIC(9.4,60,22,13,"PAH",405,1,84,0)="  "
^DIC(9.4,60,22,13,"PAH",405,1,85,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",405,1,86,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",405,1,87,0)="Modified the routine PSOSUPOE to prevent it from setting the variable PPL"
^DIC(9.4,60,22,13,"PAH",405,1,88,0)="with the same prescription twice."
^DIC(9.4,60,22,13,"PAH",405,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,91,0)="3. I11517650FY17 - Need assistance with SPMP Patient Address errors    "
^DIC(9.4,60,22,13,"PAH",405,1,92,0)=" "
^DIC(9.4,60,22,13,"PAH",405,1,93,0)="Problem: "
^DIC(9.4,60,22,13,"PAH",405,1,94,0)="--------"
^DIC(9.4,60,22,13,"PAH",405,1,95,0)="The State Prescription Monitoring Program (SPMP) module did not retrieve the"
^DIC(9.4,60,22,13,"PAH",405,1,96,0)="correct State/Province (SPMP field PAT15 - State Address) and Postal Code "
^DIC(9.4,60,22,13,"PAH",405,1,97,0)="(SPMP field PAT16 - ZIP Code Address) for patients that have a foreign"
^DIC(9.4,60,22,13,"PAH",405,1,98,0)="address on file. The software was retrieving the US state and Zip Code "
^DIC(9.4,60,22,13,"PAH",405,1,99,0)="fields, which were both blank for such patients. In addition, the Federal"
^DIC(9.4,60,22,13,"PAH",405,1,100,0)="Information Processing Standard (FIPS) code for Canada is ""CA"", however the"
^DIC(9.4,60,22,13,"PAH",405,1,101,0)="SPMP standard requires ""CN"" for Canada. "
^DIC(9.4,60,22,13,"PAH",405,1,102,0)="  "
^DIC(9.4,60,22,13,"PAH",405,1,103,0)="Resolution:"
^DIC(9.4,60,22,13,"PAH",405,1,104,0)="-----------"
^DIC(9.4,60,22,13,"PAH",405,1,105,0)="Changed the retrieval of the patient's state and postal code fields to"
^DIC(9.4,60,22,13,"PAH",405,1,106,0)="first check for the country. For foreign countries (non-US) it will"
^DIC(9.4,60,22,13,"PAH",405,1,107,0)="retrieve the Province and Postal Codes values returned in the VAPA(23)"
^DIC(9.4,60,22,13,"PAH",405,1,108,0)="and VAPA(24) return array from the ADD^VADPT API. Also changed it to send"
^DIC(9.4,60,22,13,"PAH",405,1,109,0)="""CN"" for PAT22 (Country of Non-US Resident) for Canada."
^DIC(9.4,60,22,13,"PAH",405,1,110,0)="   "
^DIC(9.4,60,22,13,"PAH",405,1,111,0)="Technical Resolution:"
^DIC(9.4,60,22,13,"PAH",405,1,112,0)="---------------------"
^DIC(9.4,60,22,13,"PAH",405,1,113,0)="Modified the routines PSOASAP and PSOASAP0 to check whether the country is"
^DIC(9.4,60,22,13,"PAH",405,1,114,0)="non-US (foreign). If so, it will use the value in VAPA(24) and VAPA(23) for"
^DIC(9.4,60,22,13,"PAH",405,1,115,0)="the fields PAT15 and PAT16 respectively. Also, changed the line tag PAT22 "
^DIC(9.4,60,22,13,"PAH",405,1,116,0)="on the PSOASAP0 routine to return ""CN"" instead of ""CA"" for Canada."
^DIC(9.4,60,22,13,"PAH",406,0)="402^3180302.14082^54"
^DIC(9.4,60,22,13,"PAH",406,1,0)="^^1^1^3180302"
^DIC(9.4,60,22,13,"PAH",406,1,1,0)="Mocha 2.1, dosing only scope."
^DIC(9.4,60,22,13,"PAH",407,0)="500^3180302.141034^54"
^DIC(9.4,60,22,13,"PAH",407,1,0)="^^6^6^3180302"
^DIC(9.4,60,22,13,"PAH",407,1,1,0)="THIS IS A FOLLOW UP PATCH."
^DIC(9.4,60,22,13,"PAH",407,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",407,1,3,0)="This patch incorporates routine changes introduced into PSOORED5 in "
^DIC(9.4,60,22,13,"PAH",407,1,4,0)="PSO*7.0*486 and merges them with routine changes in PSO*7.0*402."
^DIC(9.4,60,22,13,"PAH",407,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",407,1,6,0)="Refer to the install guide for installation instructions."
^DIC(9.4,60,22,13,"PAH",408,0)="515 SEQ #424^3180302.152042^54"
^DIC(9.4,60,22,13,"PAH",408,1,0)="^^22^22^3180302"
^DIC(9.4,60,22,13,"PAH",408,1,1,0)="This patch will correct 2 hard errors that are present in PSO*7.0*500, "
^DIC(9.4,60,22,13,"PAH",408,1,2,0)="which is part of the MOCHA 2.1B COMBINED BUILD and is due for national "
^DIC(9.4,60,22,13,"PAH",408,1,3,0)="release."
^DIC(9.4,60,22,13,"PAH",408,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",408,1,5,0)="The following two errors have been addressed in this patch:"
^DIC(9.4,60,22,13,"PAH",408,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",408,1,7,0)="<UNDEFINED>SCH+3^PSOORED3 *SCHEX"
^DIC(9.4,60,22,13,"PAH",408,1,8,0)="<UNDEFINED>SCH+3^PSOORED4 *SCHEX"
^DIC(9.4,60,22,13,"PAH",408,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",408,1,10,0)="The functions where the errors occur are:"
^DIC(9.4,60,22,13,"PAH",408,1,11,0)="- Editing the Schedule while finishing a Pending order from CPRS"
^DIC(9.4,60,22,13,"PAH",408,1,12,0)="- Editing a Schedule of an existing prescription"
^DIC(9.4,60,22,13,"PAH",408,1,13,0)="- Editing a Schedule while Verifying a Non-verified Prescription using "
^DIC(9.4,60,22,13,"PAH",408,1,14,0)="  either the ListMan verification action or the  'Rx Verification by "
^DIC(9.4,60,22,13,"PAH",408,1,15,0)="  Clerk' option"
^DIC(9.4,60,22,13,"PAH",408,1,16,0)="- Editing a Schedule while using the 'Process Order Checks' option"
^DIC(9.4,60,22,13,"PAH",408,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",408,1,18,0)="This patch will also correct an issue presented with the release version "
^DIC(9.4,60,22,13,"PAH",408,1,19,0)="of PSO*7.0*500 where multiple word schedule expansions are not echoed to "
^DIC(9.4,60,22,13,"PAH",408,1,20,0)="the screen.  This defect does not affect the patient sig section were "
^DIC(9.4,60,22,13,"PAH",408,1,21,0)="multiple word schedules continue to be expanded appropriately, only the "
^DIC(9.4,60,22,13,"PAH",408,1,22,0)="immediate echo response functionality at the time of entry."
^DIC(9.4,60,22,13,"PAH",409,0)="504 SEQ #425^3180403.174003^54"
^DIC(9.4,60,22,13,"PAH",409,1,0)="^^10^10^3180403"
^DIC(9.4,60,22,13,"PAH",409,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,60,22,13,"PAH",409,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",409,1,3,0)="1. I15848129FY17 - Buprenorphine/naloxone prescription went through when"
^DIC(9.4,60,22,13,"PAH",409,1,4,0)="                   the DEA expiration date was in the past "
^DIC(9.4,60,22,13,"PAH",409,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",409,1,6,0)="2. R16854127FY18 - FILL DATE prompt range incorrect"
^DIC(9.4,60,22,13,"PAH",409,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",409,1,8,0)="3. I5855290FY15  - CK Hidden Option and Remote Order Checks"
^DIC(9.4,60,22,13,"PAH",409,1,9,0)="    "
^DIC(9.4,60,22,13,"PAH",409,1,10,0)="4. I17185111FY18 - Error when changing routing from Window to Mail"
^DIC(9.4,60,22,13,"PAH",410,0)="513^3180403.174342^54"
^DIC(9.4,60,22,13,"PAH",411,0)="502 SEQ #427^3180424.16161^54"
^DIC(9.4,60,22,13,"PAH",412,0)="519 SEQ #428^3180425.172934^54"
^DIC(9.4,60,22,13,"PAH",412,1,0)="^^4^4^3180425"
^DIC(9.4,60,22,13,"PAH",412,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,60,22,13,"PAH",412,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",412,1,3,0)="1. I18715588FY18 - Undefined error when ^ out of prompt"
^DIC(9.4,60,22,13,"PAH",412,1,4,0)="2. INC0023405 - Set prompt default to NO instead of YES"
^DIC(9.4,60,22,13,"PAH",413,0)="520 SEQ #430^3180501.144333^54"
^DIC(9.4,60,22,13,"PAH",414,0)="463 SEQ #431^3180601.161958^54"
^DIC(9.4,60,22,13,"PAH",414,1,0)="^^319^319^3180601"
^DIC(9.4,60,22,13,"PAH",414,1,1,0)="IMPORTANT INSTALLATION NOTE:"
^DIC(9.4,60,22,13,"PAH",414,1,2,0)="----------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,3,0)="This patch is part of a multi-package build. There are three patches"
^DIC(9.4,60,22,13,"PAH",414,1,4,0)="associated with the FY16 HAPE Revenue Enhancement project - IB*2.0*568,"
^DIC(9.4,60,22,13,"PAH",414,1,5,0)="PRCA*4.5*315 and PSO*7.0*463. All three patches are to be installed"
^DIC(9.4,60,22,13,"PAH",414,1,6,0)="together as a bundle, IB_2_568_PRCA_PSO_BUNDLE_T1.KID"
^DIC(9.4,60,22,13,"PAH",414,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,9,0)="Description"
^DIC(9.4,60,22,13,"PAH",414,1,10,0)="-----------"
^DIC(9.4,60,22,13,"PAH",414,1,11,0)="The Chief Business Office (CBO) is requesting system enhancements to"
^DIC(9.4,60,22,13,"PAH",414,1,12,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,60,22,13,"PAH",414,1,13,0)="(VistA) Integrated Billing (IB), Accounts Receivable (AR), and"
^DIC(9.4,60,22,13,"PAH",414,1,14,0)="Outpatient Pharmacy (PSO) software modules."
^DIC(9.4,60,22,13,"PAH",414,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,16,0)="The mission of the Department of Veterans Affairs (VA), Office of"
^DIC(9.4,60,22,13,"PAH",414,1,17,0)="Information & Technology (OI&T), is to provide benefits and services to"
^DIC(9.4,60,22,13,"PAH",414,1,18,0)="veterans of the United States Armed Forces. In meeting these goals,"
^DIC(9.4,60,22,13,"PAH",414,1,19,0)="OIT strives to provide high quality, effective, and efficient"
^DIC(9.4,60,22,13,"PAH",414,1,20,0)="Information Technology (IT) services to those responsible for providing"
^DIC(9.4,60,22,13,"PAH",414,1,21,0)="care to the veterans at the point-of-care, as well as throughout all"
^DIC(9.4,60,22,13,"PAH",414,1,22,0)="the points of the veterans' health care. The VA depends on "
^DIC(9.4,60,22,13,"PAH",414,1,23,0)="InformationManagement/Information Technology (IM/IT) systems to meet "
^DIC(9.4,60,22,13,"PAH",414,1,24,0)="mission"
^DIC(9.4,60,22,13,"PAH",414,1,25,0)="goals."
^DIC(9.4,60,22,13,"PAH",414,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,27,0)="The overall FY16 HAPE Revenue Enhancement project has been further"
^DIC(9.4,60,22,13,"PAH",414,1,28,0)="divided into three sub-projects:"
^DIC(9.4,60,22,13,"PAH",414,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,30,0)="NSR #20150506"
^DIC(9.4,60,22,13,"PAH",414,1,31,0)="The Revenue Eligibility Enhancements Project effort for the Chief"
^DIC(9.4,60,22,13,"PAH",414,1,32,0)="Business Office (CBO), bundles several NSRs with similar business"
^DIC(9.4,60,22,13,"PAH",414,1,33,0)="needs into a single requirements document.  Successfully addressing"
^DIC(9.4,60,22,13,"PAH",414,1,34,0)="the requirements contained within this document will enable the"
^DIC(9.4,60,22,13,"PAH",414,1,35,0)="Department of Veterans Affairs (VA) to appropriately bill certain"
^DIC(9.4,60,22,13,"PAH",414,1,36,0)="subsets of billable events by correcting, automating, or enhancing"
^DIC(9.4,60,22,13,"PAH",414,1,37,0)="current Veterans Health Information Systems and Technology"
^DIC(9.4,60,22,13,"PAH",414,1,38,0)="Architecture (VistA) systems."
^DIC(9.4,60,22,13,"PAH",414,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,40,0)="NSR #20150507"
^DIC(9.4,60,22,13,"PAH",414,1,41,0)="The Revenue Operations Enhancements Project combines several NSRs, as"
^DIC(9.4,60,22,13,"PAH",414,1,42,0)="well. This effort enables the Department of Veterans Affairs (VA) to"
^DIC(9.4,60,22,13,"PAH",414,1,43,0)="improve revenue operation functionality related to repayment plans,"
^DIC(9.4,60,22,13,"PAH",414,1,44,0)="late charge capture, bill suspension reasons, the billing of"
^DIC(9.4,60,22,13,"PAH",414,1,45,0)="deactivated providers, and the display of appeal rights and"
^DIC(9.4,60,22,13,"PAH",414,1,46,0)="responsibilities on the Veterans Beneficiary travel Bill of "
^DIC(9.4,60,22,13,"PAH",414,1,47,0)="Collectionsform.  Implementation of the proposed enhancements will make a"
^DIC(9.4,60,22,13,"PAH",414,1,48,0)="significant positive impact on stakeholders and target users."
^DIC(9.4,60,22,13,"PAH",414,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,50,0)="NSR #20150505"
^DIC(9.4,60,22,13,"PAH",414,1,51,0)="The Revenue Reporting Enhancements Project will enable the VA to"
^DIC(9.4,60,22,13,"PAH",414,1,52,0)="improve tracking and reporting of revenue, and will support "
^DIC(9.4,60,22,13,"PAH",414,1,53,0)="revenuereporting business rules and guidelines."
^DIC(9.4,60,22,13,"PAH",414,1,54,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,56,0)="PSO*7.0*463 patch enhancements, pertinent to the above NSRs, include:"
^DIC(9.4,60,22,13,"PAH",414,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,58,0)="1.) In the event of a Prescription Reset Status/Cancel Charges action,"
^DIC(9.4,60,22,13,"PAH",414,1,59,0)="all automatic prepayment generation shall be"
^DIC(9.4,60,22,13,"PAH",414,1,60,0)="eliminated."
^DIC(9.4,60,22,13,"PAH",414,1,61,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,62,0)="2.) All ""credit balances"" that are automatically generated in the event"
^DIC(9.4,60,22,13,"PAH",414,1,63,0)="of a Prescription Reset Status/Cancel Charges action exemption to stop."
^DIC(9.4,60,22,13,"PAH",414,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,65,0)="3.) A new on-demand List Manager report will be made available for"
^DIC(9.4,60,22,13,"PAH",414,1,66,0)="identification of Prescription resets."
^DIC(9.4,60,22,13,"PAH",414,1,67,0)=" 4.) The new on-demand report for processing Prescription Resets "
^DIC(9.4,60,22,13,"PAH",414,1,68,0)="willprovide an option to generate a Summary Report and/or Detailed Report."
^DIC(9.4,60,22,13,"PAH",414,1,69,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,72,0)="Associated Patches:"
^DIC(9.4,60,22,13,"PAH",414,1,73,0)="-------------------"
^DIC(9.4,60,22,13,"PAH",414,1,74,0)="IB*2.0*568"
^DIC(9.4,60,22,13,"PAH",414,1,75,0)="PRCA*4.5*315"
^DIC(9.4,60,22,13,"PAH",414,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,77,0)="Concurrent Development / Dependencies:"
^DIC(9.4,60,22,13,"PAH",414,1,78,0)="--------------------------------------"
^DIC(9.4,60,22,13,"PAH",414,1,79,0)="N/A"
^DIC(9.4,60,22,13,"PAH",414,1,80,0)=" "
