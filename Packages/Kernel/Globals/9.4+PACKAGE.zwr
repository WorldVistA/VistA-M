^DIC(9.4,14,22,5.9,"PAH",213,1,215,0)="Patch LR*5.2*315 User Guide files are exported in the following retrieval"
^DIC(9.4,14,22,5.9,"PAH",213,1,216,0)="formats:"
^DIC(9.4,14,22,5.9,"PAH",213,1,217,0)=" "
