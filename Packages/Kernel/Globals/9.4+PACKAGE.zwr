^DIC(9.4,14,22,5.9,"PAH",168,1,1,0)="Description:"
^DIC(9.4,14,22,5.9,"PAH",168,1,2,0)="============"
^DIC(9.4,14,22,5.9,"PAH",168,1,3,0)="This patch will add a new Kernel look-up screen to the Laboratory Site"
