^DIC(9.4,11,22,5.03,"PAH",47,1,235,0)="Software and Documentation Retrieval Information "
^DIC(9.4,11,22,5.03,"PAH",47,1,236,0)="================================================"
^DIC(9.4,11,22,5.03,"PAH",47,1,237,0)="VistA Laboratory patch LR*5.2*474 software is distributed by Host File,"
^DIC(9.4,11,22,5.03,"PAH",47,1,238,0)="along with LA*5.2*90.  Software is available on the SOFTWARE.DIR directory"
^DIC(9.4,11,22,5.03,"PAH",47,1,239,0)="at one of the following Office of Information (OI) Field Offices.  The"
^DIC(9.4,11,22,5.03,"PAH",47,1,240,0)="preferred method is to retrieve the file using Secure File Transfer"
^DIC(9.4,11,22,5.03,"PAH",47,1,241,0)="Protocol (SFTP) from download.vista.domain.ext, which transmits files from"
^DIC(9.4,11,22,5.03,"PAH",47,1,242,0)="the first available SFTP server."
^DIC(9.4,11,22,5.03,"PAH",47,1,243,0)="        Albany                     ftp.fo-albany.domain.ext "
^DIC(9.4,11,22,5.03,"PAH",47,1,244,0)="        Hines                      ftp.fo-hines.domain.ext "
^DIC(9.4,11,22,5.03,"PAH",47,1,245,0)="        Salt Lake City             ftp.fo-slc.domain.ext "
^DIC(9.4,11,22,5.03,"PAH",47,1,246,0)="                                   "
^DIC(9.4,11,22,5.03,"PAH",47,1,247,0)="File Name                   Contents               Retrieval Format "
^DIC(9.4,11,22,5.03,"PAH",47,1,248,0)="------------------          --------------------   ----------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,249,0)="LAB_MICRO_INTERFACE_        Host File containing   ASCII"
^DIC(9.4,11,22,5.03,"PAH",47,1,250,0)="RELEASE_1_0.KID             KIDS software distribution "
^DIC(9.4,11,22,5.03,"PAH",47,1,251,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,252,0)="LAB_MICRO_INTERFACE_RELEASE_1_0_DOCS.ZIP, which contains both .pdf and "
^DIC(9.4,11,22,5.03,"PAH",47,1,253,0)=".docx formatted files of the following documents. Retrieval format is "
^DIC(9.4,11,22,5.03,"PAH",47,1,254,0)="BINARY:"
^DIC(9.4,11,22,5.03,"PAH",47,1,255,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,256,0)="       VLE Micro_Lab_Micro_Interface_Release_1.0_Technical_Manual"
^DIC(9.4,11,22,5.03,"PAH",47,1,257,0)="       VLE Micro_Lab_Micro_Interface_Release_1.0_User_Guide"
^DIC(9.4,11,22,5.03,"PAH",47,1,258,0)="       VLE Micro_Deployment_Installation_Roll Back_Back Out_Guide"
^DIC(9.4,11,22,5.03,"PAH",47,1,259,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,260,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,261,0)="The VistA Documentation Library (VDL) web site will also contain the "
^DIC(9.4,11,22,5.03,"PAH",47,1,262,0)="above referenced documents. This website is usually updated within 1-3"
^DIC(9.4,11,22,5.03,"PAH",47,1,263,0)="days of the patch release date. The VDL web address for Laboratory"
^DIC(9.4,11,22,5.03,"PAH",47,1,264,0)="Universal Interface user documentation is:"
^DIC(9.4,11,22,5.03,"PAH",47,1,265,0)="http://www.domain.ext/vdl/application.asp?appid=120"
^DIC(9.4,11,22,5.03,"PAH",47,1,266,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,267,0)="Note: These previously released documents contain configuration and"
^DIC(9.4,11,22,5.03,"PAH",47,1,268,0)="mapping information that is useful to the implementation of the Universal"
^DIC(9.4,11,22,5.03,"PAH",47,1,269,0)="Interface for Microbiology tests."
^DIC(9.4,11,22,5.03,"PAH",47,1,270,0)="------------------------------------------------------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,271,0)="LEDI IV Installation Guide     LAB_LEDI_IV_IG.PDF            binary"
^DIC(9.4,11,22,5.03,"PAH",47,1,272,0)="LEDI IV User Manual            LAB_LEDI_IV_UM.PDF            binary"
^DIC(9.4,11,22,5.03,"PAH",47,1,273,0)="LEDI IV Update AP/MICRO        LEDI_IV__AP__MICRO_           binary"
^DIC(9.4,11,22,5.03,"PAH",47,1,274,0)="Configuration Guide            CONFIGURATION_GUIDE.PDF       binary"
^DIC(9.4,11,22,5.03,"PAH",47,1,275,0)="     "
^DIC(9.4,11,22,5.03,"PAH",47,1,276,0)="Patch Installation:"
^DIC(9.4,11,22,5.03,"PAH",47,1,277,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,278,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,279,0)="Pre/Post Installation Overview:"
^DIC(9.4,11,22,5.03,"PAH",47,1,280,0)="-------------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,281,0)="This patch install must be coordinated with the Laboratory ADPAC to "
^DIC(9.4,11,22,5.03,"PAH",47,1,282,0)="ensure that all Lab Interface related activities are halted."
^DIC(9.4,11,22,5.03,"PAH",47,1,283,0)=" His "
^DIC(9.4,11,22,5.03,"PAH",47,1,284,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,285,0)="Pre-Installation Instructions:  "
^DIC(9.4,11,22,5.03,"PAH",47,1,286,0)="------------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,287,0)="Ensure that all Lab Interface activity has been halted !!"
^DIC(9.4,11,22,5.03,"PAH",47,1,288,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,289,0)="This would include:"
^DIC(9.4,11,22,5.03,"PAH",47,1,290,0)="-Editing of an Auto Instrument file entry, "
^DIC(9.4,11,22,5.03,"PAH",47,1,291,0)="-Turn off the Auto Downloading process to prevent the building and "
^DIC(9.4,11,22,5.03,"PAH",47,1,292,0)="downloading of a Load/Worklist to the Instrument Manager."
^DIC(9.4,11,22,5.03,"PAH",47,1,293,0)="-Shut down all LA7UI logical links and any other HL7 process (HLZTCP or "
^DIC(9.4,11,22,5.03,"PAH",47,1,294,0)="HLLP processes) to prevent the processing of result messages from the IM."
^DIC(9.4,11,22,5.03,"PAH",47,1,295,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,296,0)="This patch may be installed with users on the system as long as the above "
^DIC(9.4,11,22,5.03,"PAH",47,1,297,0)="process controls have been followed."
^DIC(9.4,11,22,5.03,"PAH",47,1,298,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,299,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,300,0)="Installation Instructions:"
^DIC(9.4,11,22,5.03,"PAH",47,1,301,0)="--------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,302,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,11,22,5.03,"PAH",47,1,303,0)="recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,11,22,5.03,"PAH",47,1,304,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,11,22,5.03,"PAH",47,1,305,0)="minutes to install."
^DIC(9.4,11,22,5.03,"PAH",47,1,306,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,307,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,308,0)="This installation will modify the CHEM TESTS field (#30) in the AUTO "
^DIC(9.4,11,22,5.03,"PAH",47,1,309,0)="INSTRUMENT file (#62.4) by changing the following:"
^DIC(9.4,11,22,5.03,"PAH",47,1,310,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,311,0)="  The name of the field will be changed to LABORATORY TESTS"
^DIC(9.4,11,22,5.03,"PAH",47,1,312,0)="  The screen on the field will now allow ""MI"" subscripted tests"
^DIC(9.4,11,22,5.03,"PAH",47,1,313,0)="  The ROUTINE STORAGE (#11) value set by the trigger on the TESTS "
^DIC(9.4,11,22,5.03,"PAH",47,1,314,0)="  (#.01) field will not happen for ""MI"" subscripted tests"
^DIC(9.4,11,22,5.03,"PAH",47,1,315,0)="  The original ROUTINE STORAGE trigger code has been replace with a new "
^DIC(9.4,11,22,5.03,"PAH",47,1,316,0)="  style AD cross-reference."
^DIC(9.4,11,22,5.03,"PAH",47,1,317,0)="   "
^DIC(9.4,11,22,5.03,"PAH",47,1,318,0)="1.      DOWNLOAD HOST KIDS FILE "
^DIC(9.4,11,22,5.03,"PAH",47,1,319,0)="        ----------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,320,0)="        Download the KIDS file LAB_MICRO_INTERFACE_RELEASE_1_0.KID from "
^DIC(9.4,11,22,5.03,"PAH",47,1,321,0)="        the ANONYMOUS.SOFTWARE directory of Albany, Hines, or the Salt"
^DIC(9.4,11,22,5.03,"PAH",47,1,322,0)="        Lake OIFO to the appropriate directory on your system."
^DIC(9.4,11,22,5.03,"PAH",47,1,323,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,324,0)="2.      LOAD DISTRIBUTION "
^DIC(9.4,11,22,5.03,"PAH",47,1,325,0)="        -----------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,326,0)="        Use the 'LOAD A DISTRIBUTION' option on the KIDS "
^DIC(9.4,11,22,5.03,"PAH",47,1,327,0)="        INSTALLATION menu, and enter:  the directory onto which you "
^DIC(9.4,11,22,5.03,"PAH",47,1,328,0)="        have downloaded the host file, followed by "
^DIC(9.4,11,22,5.03,"PAH",47,1,329,0)="        LAB_MICRO_INTERFACE_RELEASE_1_0.KID, the host file name. "
^DIC(9.4,11,22,5.03,"PAH",47,1,330,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,331,0)="3.      START UP KIDS "
^DIC(9.4,11,22,5.03,"PAH",47,1,332,0)="        -------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,333,0)="        Start up the Kernel Installation and Distribution System Menu "
^DIC(9.4,11,22,5.03,"PAH",47,1,334,0)="        [XPD MAIN]:"
^DIC(9.4,11,22,5.03,"PAH",47,1,335,0)="        Edits and Distribution ...  "
^DIC(9.4,11,22,5.03,"PAH",47,1,336,0)="        Utilities ...  "
^DIC(9.4,11,22,5.03,"PAH",47,1,337,0)="        Installation ...  "
^DIC(9.4,11,22,5.03,"PAH",47,1,338,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,339,0)="        Select Kernel Installation & Distribution System Option: "
^DIC(9.4,11,22,5.03,"PAH",47,1,340,0)="        Installation "
^DIC(9.4,11,22,5.03,"PAH",47,1,341,0)="        -------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,342,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,343,0)="            Load a Distribution "
^DIC(9.4,11,22,5.03,"PAH",47,1,344,0)="            Print Transport Global "
^DIC(9.4,11,22,5.03,"PAH",47,1,345,0)="            Compare Transport Global to Current System "
^DIC(9.4,11,22,5.03,"PAH",47,1,346,0)="            Verify Checksums in Transport Global "
^DIC(9.4,11,22,5.03,"PAH",47,1,347,0)="            Install Package(s) "
^DIC(9.4,11,22,5.03,"PAH",47,1,348,0)="            Restart Install of Package(s) "
^DIC(9.4,11,22,5.03,"PAH",47,1,349,0)="            Unload a Distribution "
^DIC(9.4,11,22,5.03,"PAH",47,1,350,0)="            Backup a Transport Global "
^DIC(9.4,11,22,5.03,"PAH",47,1,351,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,352,0)="4.      Select Installation Option: "
^DIC(9.4,11,22,5.03,"PAH",47,1,353,0)="     ---------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,354,0)="   "
^DIC(9.4,11,22,5.03,"PAH",47,1,355,0)="   a.   Use the Load a Distribution and select Host File: "
^DIC(9.4,11,22,5.03,"PAH",47,1,356,0)="        LAB_MICRO_INTERFACE_RELEASE_1_0.KID"
^DIC(9.4,11,22,5.03,"PAH",47,1,357,0)="        b.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,11,22,5.03,"PAH",47,1,358,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,11,22,5.03,"PAH",47,1,359,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,11,22,5.03,"PAH",47,1,360,0)="        c.  Compare Transport Global to Current System - This option will"
^DIC(9.4,11,22,5.03,"PAH",47,1,361,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,11,22,5.03,"PAH",47,1,362,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,11,22,5.03,"PAH",47,1,363,0)="        (routines, DDs, templates, etc.)."
^DIC(9.4,11,22,5.03,"PAH",47,1,364,0)="        d.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,11,22,5.03,"PAH",47,1,365,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,11,22,5.03,"PAH",47,1,366,0)="        transport global."
^DIC(9.4,11,22,5.03,"PAH",47,1,367,0)="     "
^DIC(9.4,11,22,5.03,"PAH",47,1,368,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,369,0)="5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,11,22,5.03,"PAH",47,1,370,0)="    Install? NO//'     "
^DIC(9.4,11,22,5.03,"PAH",47,1,371,0)="    Respond: NO"
^DIC(9.4,11,22,5.03,"PAH",47,1,372,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,373,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,11,22,5.03,"PAH",47,1,374,0)="    NO//'"
^DIC(9.4,11,22,5.03,"PAH",47,1,375,0)="    Respond: NO"
^DIC(9.4,11,22,5.03,"PAH",47,1,376,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,377,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,11,22,5.03,"PAH",47,1,378,0)="    and Protocols? NO//' "
^DIC(9.4,11,22,5.03,"PAH",47,1,379,0)="    Respond: NO"
^DIC(9.4,11,22,5.03,"PAH",47,1,380,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,381,0)="8.  If prompted 'Delay Install (Minutes): (0 - 60): 0//' "
^DIC(9.4,11,22,5.03,"PAH",47,1,382,0)="    Respond: 0."
^DIC(9.4,11,22,5.03,"PAH",47,1,383,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,384,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,385,0)="Post-Installation Instructions:"
^DIC(9.4,11,22,5.03,"PAH",47,1,386,0)="-------------------------------"
^DIC(9.4,11,22,5.03,"PAH",47,1,387,0)="Below is an example of how an micro instrument might be defined in the "
^DIC(9.4,11,22,5.03,"PAH",47,1,388,0)="Auto Instrument file. Refer to the Install. We recommend that the Install "
^DIC(9.4,11,22,5.03,"PAH",47,1,389,0)="and User manuals be followed for more completely documented "
^DIC(9.4,11,22,5.03,"PAH",47,1,390,0)="instructions. "
^DIC(9.4,11,22,5.03,"PAH",47,1,391,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,392,0)="AUTO INSTRUMENT (#62.4:"
^DIC(9.4,11,22,5.03,"PAH",47,1,393,0)=" "
^DIC(9.4,11,22,5.03,"PAH",47,1,394,0)="NUMBER: 3                               NAME: BAC-TEC"
^DIC(9.4,11,22,5.03,"PAH",47,1,395,0)="  LOAD/WORK LIST: BAC-TEC"
^DIC(9.4,11,22,5.03,"PAH",47,1,396,0)="  ENTRY for LAGEN ROUTINE: Accession cross-reference"
^DIC(9.4,11,22,5.03,"PAH",47,1,397,0)="  CROSS LINKED BY: IDE                  MESSAGE CONFIGURATION: LA7UI2"
^DIC(9.4,11,22,5.03,"PAH",47,1,398,0)="  METHOD: BACTEC                        DEFAULT ACCESSION AREA: BLOOD "
^DIC(9.4,11,22,5.03,"PAH",47,1,399,0)="CULTURE"
^DIC(9.4,11,22,5.03,"PAH",47,1,400,0)="  OVERLAY DATA: YES                     STORE REMARKS: YES"
^DIC(9.4,11,22,5.03,"PAH",47,1,401,0)="NUMBER: 1                               TEST: BLOOD CULTURE"
^DIC(9.4,11,22,5.03,"PAH",47,1,402,0)="  UI TEST CODE: BLD CX                  ACCESSION AREA: MICROBIOLOGY"
^DIC(9.4,11,22,5.03,"PAH",47,1,403,0)="  FILE BUILD ENTRY: EN                  FILE BUILD ROUTINE: LA7UID"
^DIC(9.4,11,22,5.03,"PAH",47,1,404,0)="  AUTO DOWNLOAD: NO                     WKLD METHOD: BACT/ALERT"
^DIC(9.4,11,22,5.03,"PAH",47,1,405,0)="  WKLD CODE METHOD NAME: BACT/ALERT     WKLD CODE SUFFIX: .7086"
^DIC(9.4,11,22,5.03,"PAH",48,0)="92 SEQ #69^3170313.143741^54"
^DIC(9.4,11,22,5.03,"PAH",48,1,0)="^^1^1^3170313"
^DIC(9.4,11,22,5.03,"PAH",48,1,1,0)="See National Patch Module for details."
^DIC(9.4,11,22,5.03,"PAH",49,0)="96 SEQ #70^3180403.15295^54"
^DIC(9.4,11,22,5.03,"PAH",49,1,0)="^^11^11^3180403"
^DIC(9.4,11,22,5.03,"PAH",49,1,1,0)="This patch addresses one (1) Laboratory Electronic Data Interchange (LEDI)"
^DIC(9.4,11,22,5.03,"PAH",49,1,2,0)="issue:"
^DIC(9.4,11,22,5.03,"PAH",49,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",49,1,4,0)="Mycology organism comments are stored under the ""Bacteriology Report "
^DIC(9.4,11,22,5.03,"PAH",49,1,5,0)="Comment"" section of VistA Lab reports rather than with each Mycology "
^DIC(9.4,11,22,5.03,"PAH",49,1,6,0)="organism's section."
^DIC(9.4,11,22,5.03,"PAH",49,1,7,0)=" "
^DIC(9.4,11,22,5.03,"PAH",49,1,8,0)="Associated CA-SDM ticket:"
^DIC(9.4,11,22,5.03,"PAH",49,1,9,0)="=========================="
^DIC(9.4,11,22,5.03,"PAH",49,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",49,1,11,0)="I9858894FY16 : LEDI Mycology Organism Comment Issue"
^DIC(9.4,11,22,5.03,"PAH",50,0)="87 SEQ #72^3180706.132151^54"
^DIC(9.4,11,22,5.03,"PAH",50,1,0)="^^5^5^3180706"
^DIC(9.4,11,22,5.03,"PAH",50,1,1,0)="This patch is a VM patch that addresses 1 issue in the Lab package:"
^DIC(9.4,11,22,5.03,"PAH",50,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",50,1,3,0)="1.  Modify lab Automated Instrument routines to allow for the"
^DIC(9.4,11,22,5.03,"PAH",50,1,4,0)="    use of the VIC 4.0 card number as a patient identifier in the"
^DIC(9.4,11,22,5.03,"PAH",50,1,5,0)="    PID segment for POC (Point of Care) processing."
^DIC(9.4,11,22,5.03,"PAH",51,0)="99 SEQ #73^3200115.121845^65"
^DIC(9.4,11,22,5.03,"PAH",51,1,0)="^^5^5^3200115"
^DIC(9.4,11,22,5.03,"PAH",51,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,11,22,5.03,"PAH",51,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",51,1,3,0)="1.      When a result returns from a send-out laboratory containing "
^DIC(9.4,11,22,5.03,"PAH",51,1,4,0)="results with a reference range with a negative value, VistA Lab parses "
^DIC(9.4,11,22,5.03,"PAH",51,1,5,0)="the values erroneously and renders the range as a positive value."
^DIC(9.4,11,22,5.03,"PAH",52,0)="101 SEQ #74^3230523.105854^89"
^DIC(9.4,11,22,5.03,"PAH",52,1,0)="^^5^5^3230523"
^DIC(9.4,11,22,5.03,"PAH",52,1,1,0)="This patch addresses one issue:"
^DIC(9.4,11,22,5.03,"PAH",52,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",52,1,3,0)="The Incomplete Test Status Report (LWRKINC) sometimes does not display a "
^DIC(9.4,11,22,5.03,"PAH",52,1,4,0)="status of ""Results Available"" for Laboratory Electronic Data Interchange "
^DIC(9.4,11,22,5.03,"PAH",52,1,5,0)="(LEDI) tests when results are available for review from a host site."
^DIC(9.4,11,22,5.03,"PAH",53,0)="103 SEQ #75^3230803.091838^89"
^DIC(9.4,11,22,5.03,"PAH",53,1,0)="^^6^6^3230803"
^DIC(9.4,11,22,5.03,"PAH",53,1,1,0)="This patch addresses one issue:"
^DIC(9.4,11,22,5.03,"PAH",53,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",53,1,3,0)="The Incomplete Test Status Report (LRWRKINC) sometimes does not display a "
^DIC(9.4,11,22,5.03,"PAH",53,1,4,0)="status of ""Results Available"" for Laboratory Electronic Data Interchange "
^DIC(9.4,11,22,5.03,"PAH",53,1,5,0)="(LEDI) tests when results are available for review from a non-VistA host "
^DIC(9.4,11,22,5.03,"PAH",53,1,6,0)="site (such as Quest)."
^DIC(9.4,11,22,5.03,"PAH",54,0)="104 SEQ #76^3240506.115842^89"
^DIC(9.4,11,22,5.03,"PAH",54,1,0)="^^4^4^3240506"
^DIC(9.4,11,22,5.03,"PAH",54,1,1,0)="This patch along with LR*5.2*568 addresses one issue:"
^DIC(9.4,11,22,5.03,"PAH",54,1,2,0)=" "
^DIC(9.4,11,22,5.03,"PAH",54,1,3,0)="VistA Laboratory (POC) Point of Care interface logic might incorrectly "
^DIC(9.4,11,22,5.03,"PAH",54,1,4,0)="determine the reporting facility for POC results."
^DIC(9.4,11,22,5.03,"PAH",55,0)="105 SEQ #77^3250403.0837^90"
^DIC(9.4,11,22,5.03,"PAH",55,1,0)="^^4^4^3250403"
^DIC(9.4,11,22,5.03,"PAH",55,1,1,0)="Please review FORUM's Patch Module description and installation "
^DIC(9.4,11,22,5.03,"PAH",55,1,2,0)="instructions before installing this patch."
^DIC(9.4,11,22,5.03,"PAH",55,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",55,1,4,0)="Please note that LR*5.2*580 is a companion patch to this patch."
