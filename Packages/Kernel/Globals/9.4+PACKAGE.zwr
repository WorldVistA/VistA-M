^DIC(9.4,13,22,9,"PAH",10,1,225,0)="Backout and Rollback Procedure:"
^DIC(9.4,13,22,9,"PAH",10,1,226,0)="-------------------------------"
^DIC(9.4,13,22,9,"PAH",10,1,227,0)="During the VistA Installation Procedure of the KIDS build, the "
^DIC(9.4,13,22,9,"PAH",10,1,228,0)="installer should back up the modified routines by the use of the"
^DIC(9.4,13,22,9,"PAH",10,1,229,0)="'Backup a Transport Global' action (step 3a in the Installations "
^DIC(9.4,13,22,9,"PAH",10,1,230,0)="Instructions below)."
^DIC(9.4,13,22,9,"PAH",10,1,231,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,232,0)="If rollback/backout is required, the installer can use the MailMan"
^DIC(9.4,13,22,9,"PAH",10,1,233,0)="message to restore the routines to previous state. "
^DIC(9.4,13,22,9,"PAH",10,1,234,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,235,0)="To backout the ENTITY (#1.5) file and DDE EDIT ENTITY input template, use "
^DIC(9.4,13,22,9,"PAH",10,1,236,0)="the EN^DIU2 API. Caution should be taken when using this API. For more "
^DIC(9.4,13,22,9,"PAH",10,1,237,0)="information on usage of this API see FileMan 22.2 Developer Guide. The"
^DIC(9.4,13,22,9,"PAH",10,1,238,0)="following is an example execution to remove files and input template:"
^DIC(9.4,13,22,9,"PAH",10,1,239,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,240,0)="S DIU=1.5,DIU(0)=""DT"" D EN^DIU2"
^DIC(9.4,13,22,9,"PAH",10,1,241,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,242,0)="To rollback/backout DDE options exported with this patch, may be disabled"
^DIC(9.4,13,22,9,"PAH",10,1,243,0)="by using VA FileMan to assign an Out of Order message as follows:"
^DIC(9.4,13,22,9,"PAH",10,1,244,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,245,0)="VA FileMan 22.2"
^DIC(9.4,13,22,9,"PAH",10,1,246,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,247,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,248,0)="Select OPTION: 1  ENTER OR EDIT FILE ENTRIES"
