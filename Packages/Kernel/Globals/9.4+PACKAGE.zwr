^DIC(9.4,73,22,9,"PAH",18,1,1,0)="Patch AFJX*5.1*30"
^DIC(9.4,73,22,9,"PAH",18,1,2,0)=""
^DIC(9.4,73,22,9,"PAH",18,1,3,0)="This patch fixes some problems in patch AFJX*5.1*26."
^DIC(9.4,73,22,9,"PAH",18,1,4,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,5,0)="NOIS FTL-0701-51047"
^DIC(9.4,73,22,9,"PAH",18,1,6,0)="Test Site: Charleston, SC"
^DIC(9.4,73,22,9,"PAH",18,1,7,0)="The mail group AFJX PATID FILTER BLOCK should be PUBLIC.  The pre-init"
^DIC(9.4,73,22,9,"PAH",18,1,8,0)="in this patch checks for the existence of the mail group.  If it's not"
^DIC(9.4,73,22,9,"PAH",18,1,9,0)="there, it creates it.  If it is there, it makes sure it's defined"
^DIC(9.4,73,22,9,"PAH",18,1,10,0)="correctly.  The person who installs this patch is added as a member."
^DIC(9.4,73,22,9,"PAH",18,1,11,0)="You are free to change the ORGANIZER, COORDINATOR, and MEMBER fields"
^DIC(9.4,73,22,9,"PAH",18,1,12,0)="afterwards.  Here's the group:"
^DIC(9.4,73,22,9,"PAH",18,1,13,0)=""
^DIC(9.4,73,22,9,"PAH",18,1,14,0)="--------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",18,1,15,0)="NAME: AFJX PATID FILTER BLOCK           TYPE: public"
^DIC(9.4,73,22,9,"PAH",18,1,16,0)="  COORDINATOR: <someone>"
^DIC(9.4,73,22,9,"PAH",18,1,17,0)="MEMBER: <someone>"
^DIC(9.4,73,22,9,"PAH",18,1,18,0)="DESCRIPTION:   If the patient ID filter blocks an incoming data request"
^DIC(9.4,73,22,9,"PAH",18,1,19,0)="because it detected possible invalid health summary data, a warning is sent"
^DIC(9.4,73,22,9,"PAH",18,1,20,0)="to members of this group."
^DIC(9.4,73,22,9,"PAH",18,1,21,0)="  ORGANIZER: <someone>"
^DIC(9.4,73,22,9,"PAH",18,1,22,0)="--------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",18,1,23,0)=""
^DIC(9.4,73,22,9,"PAH",18,1,24,0)=""
^DIC(9.4,73,22,9,"PAH",18,1,25,0)="NOIS CHA-0701-30431, TOG-0701-10186"
^DIC(9.4,73,22,9,"PAH",18,1,26,0)="Test Site: Charleston, SC"
^DIC(9.4,73,22,9,"PAH",18,1,27,0)="The option AFJX PATID REPORT is included to correct any omissions."
^DIC(9.4,73,22,9,"PAH",18,1,28,0)="Here's the option:"
^DIC(9.4,73,22,9,"PAH",18,1,29,0)=""
^DIC(9.4,73,22,9,"PAH",18,1,30,0)="--------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",18,1,31,0)="NAME: AFJX PATID REPORT"
^DIC(9.4,73,22,9,"PAH",18,1,32,0)=" MENU TEXT: Network Health Exchange Check Messages"
^DIC(9.4,73,22,9,"PAH",18,1,33,0)=" TYPE: run routine                     CREATOR: <someone>"
^DIC(9.4,73,22,9,"PAH",18,1,34,0)=" PACKAGE: NETWORK HEALTH EXCHANGE"
^DIC(9.4,73,22,9,"PAH",18,1,35,0)="DESCRIPTION:   This option goes through all the messages in the Mailbox"
^DIC(9.4,73,22,9,"PAH",18,1,36,0)="belonging to NETWORK,HEALTH EXCHANGE, and checks to see if any contain ""bad"
^DIC(9.4,73,22,9,"PAH",18,1,37,0)="data"".  Among the things checked is patient age, in an attempt to ensure"
^DIC(9.4,73,22,9,"PAH",18,1,38,0)="that the message contains data from the correct requested patient."
^DIC(9.4,73,22,9,"PAH",18,1,39,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,40,0)="A report on the results is produced."
^DIC(9.4,73,22,9,"PAH",18,1,41,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,42,0)="Note that this option is only needed to check messages received at your site"
^DIC(9.4,73,22,9,"PAH",18,1,43,0)="before you installed patch AFJX*5.1*26.  Messages received afterwards are"
^DIC(9.4,73,22,9,"PAH",18,1,44,0)="checked as they are received."
^DIC(9.4,73,22,9,"PAH",18,1,45,0)=" ROUTINE: AFJXVER"
^DIC(9.4,73,22,9,"PAH",18,1,46,0)=" UPPERCASE MENU TEXT: NETWORK HEALTH EXCHANGE CHECK"
^DIC(9.4,73,22,9,"PAH",18,1,47,0)="--------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",18,1,48,0)=""
^DIC(9.4,73,22,9,"PAH",18,1,49,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",18,1,50,0)="is at a minimum.  It requires patch AFJX*5.1*26."
^DIC(9.4,73,22,9,"PAH",18,1,51,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",18,1,52,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,53,0)="ROUTINES:"
^DIC(9.4,73,22,9,"PAH",18,1,54,0)="The second line of the routine now looks like:"
^DIC(9.4,73,22,9,"PAH",18,1,55,0)="       ;;5.1;Network Health Exchange;**[patch list]**;Jan 23, 1996"
^DIC(9.4,73,22,9,"PAH",18,1,56,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,57,0)="             Before        After"
^DIC(9.4,73,22,9,"PAH",18,1,58,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,73,22,9,"PAH",18,1,59,0)="-----------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",18,1,60,0)="AFJXPRE     * NEW *      2315825     30"
^DIC(9.4,73,22,9,"PAH",18,1,61,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,73,22,9,"PAH",18,1,62,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,63,0)="This patch introduces the following new routine:"
^DIC(9.4,73,22,9,"PAH",18,1,64,0)="AFJXPRE - This pre-init has no user-callable entry points."
^DIC(9.4,73,22,9,"PAH",18,1,65,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",18,1,66,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,67,0)="INSTALLATION:"
^DIC(9.4,73,22,9,"PAH",18,1,68,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",18,1,69,0)="is at a minimum.  It requires patch AFJX*5.1*26."
^DIC(9.4,73,22,9,"PAH",18,1,70,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,73,22,9,"PAH",18,1,71,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,73,22,9,"PAH",18,1,72,0)="    affected routine(s).  "
^DIC(9.4,73,22,9,"PAH",18,1,73,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,73,22,9,"PAH",18,1,74,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,73,22,9,"PAH",18,1,75,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,73,22,9,"PAH",18,1,76,0)="    Users may be on the system."
^DIC(9.4,73,22,9,"PAH",18,1,77,0)="5.  On the KIDS:Installation menu, use the following options to install"
^DIC(9.4,73,22,9,"PAH",18,1,78,0)="    the Transport Global."
^DIC(9.4,73,22,9,"PAH",18,1,79,0)="       Verify Checksums in Transport Global"
^DIC(9.4,73,22,9,"PAH",18,1,80,0)="       Print Transport Global"
^DIC(9.4,73,22,9,"PAH",18,1,81,0)="       Compare Transport Global to Current System"
^DIC(9.4,73,22,9,"PAH",18,1,82,0)="       Backup a Transport Global"
^DIC(9.4,73,22,9,"PAH",18,1,83,0)="       Install Package(s)"
^DIC(9.4,73,22,9,"PAH",18,1,84,0)=" Select INSTALL NAME:   AFJX*5.1*30   Loaded from Distribution <date/time>"
^DIC(9.4,73,22,9,"PAH",18,1,85,0)="                        ==========="
^DIC(9.4,73,22,9,"PAH",18,1,86,0)=" Install Questions:"
^DIC(9.4,73,22,9,"PAH",18,1,87,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,73,22,9,"PAH",18,1,88,0)="                                                                   ==="
^DIC(9.4,73,22,9,"PAH",18,1,89,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,73,22,9,"PAH",18,1,90,0)="                                                       =="
^DIC(9.4,73,22,9,"PAH",18,1,91,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,73,22,9,"PAH",18,1,92,0)="                                                                       =="
^DIC(9.4,73,22,9,"PAH",18,1,93,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,73,22,9,"PAH",18,1,94,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,73,22,9,"PAH",18,1,95,0)=" Enter a '^' to abort the install."
^DIC(9.4,73,22,9,"PAH",18,1,96,0)=" "
^DIC(9.4,73,22,9,"PAH",18,1,97,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,73,22,9,"PAH",18,1,98,0)="                ------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",18,1,99,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if"
^DIC(9.4,73,22,9,"PAH",18,1,100,0)="    necessary."
^DIC(9.4,73,22,9,"PAH",18,1,101,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",19,0)="31 SEQ #26^3020116^1"
^DIC(9.4,73,22,9,"PAH",19,1,0)="^^158^158^3020116"
^DIC(9.4,73,22,9,"PAH",19,1,1,0)="Patch AFJX*5.1*31"
^DIC(9.4,73,22,9,"PAH",19,1,2,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,3,0)="NOIS TUC-1001-60741, TUC-1001-60737, HUN-0701-22217, DAY-0797-41839,"
^DIC(9.4,73,22,9,"PAH",19,1,4,0)="     HVH-1000-12729, HOU-0801-70115, COA-1201-22358, WPB-1201-31089"
^DIC(9.4,73,22,9,"PAH",19,1,5,0)="Test Site: Huntington, WV; Houston, TX"
^DIC(9.4,73,22,9,"PAH",19,1,6,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,7,0)="This patch does the following:"
^DIC(9.4,73,22,9,"PAH",19,1,8,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,9,0)="- Prevents NHE from accepting requests from or sending requests to closed"
^DIC(9.4,73,22,9,"PAH",19,1,10,0)="sites.  (See NOIS TUC-1001-60741, TUC-1001-60737, COA-1201-22358,"
^DIC(9.4,73,22,9,"PAH",19,1,11,0)="WPB-1201-31089, and HUN-0701-22217.)  Any closed sites in file 537025,"
^DIC(9.4,73,22,9,"PAH",19,1,12,0)="NHE AUTHORIZED SITES file, will be ignored, and will not be selectable"
^DIC(9.4,73,22,9,"PAH",19,1,13,0)="when requests are being created."
^DIC(9.4,73,22,9,"PAH",19,1,14,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,15,0)="- Solves the undefined BOLD variable problem by no longer ""bolding"" output"
^DIC(9.4,73,22,9,"PAH",19,1,16,0)="on the menu.  (See NOIS DAY-0797-41839.)"
^DIC(9.4,73,22,9,"PAH",19,1,17,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,18,0)="- Solves the problem which occurred when Hudson Valley HCS changed option"
^DIC(9.4,73,22,9,"PAH",19,1,19,0)="S.AFJXSERVER to use a resource device to limit it to running only one job"
^DIC(9.4,73,22,9,"PAH",19,1,20,0)="at a time.  (See NOIS HVH-1000-12729.)"
^DIC(9.4,73,22,9,"PAH",19,1,21,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,22,0)="Additionally,"
^DIC(9.4,73,22,9,"PAH",19,1,23,0)="- Routines are rewritten to incorporate good programming practices."
^DIC(9.4,73,22,9,"PAH",19,1,24,0)="- Routine AFJXVER is modified to check both the B and C xrefs in file 4.2,"
^DIC(9.4,73,22,9,"PAH",19,1,25,0)="instead of just the B xref, when looking up a domain name."
^DIC(9.4,73,22,9,"PAH",19,1,26,0)="- Routine AFJXPNHX is modified to use MailMan APIs to delete messages from"
^DIC(9.4,73,22,9,"PAH",19,1,27,0)="the NHE user's mailbox, instead of using direct global edits."
^DIC(9.4,73,22,9,"PAH",19,1,28,0)="- The Identifiers in file 537000 are changed to ""Write"" Identifiers.  The"
^DIC(9.4,73,22,9,"PAH",19,1,29,0)="Post-Init, ^AFJXPRE, will effect the change."
^DIC(9.4,73,22,9,"PAH",19,1,30,0)="- The DDs of fields in files 537000 and 537025, which are free-text domain"
^DIC(9.4,73,22,9,"PAH",19,1,31,0)="names, are changed to pointer-type fields, pointing to file 4.2.  The DD"
^DIC(9.4,73,22,9,"PAH",19,1,32,0)="of the field in file 537010 which points to file 537025 is changed to"
^DIC(9.4,73,22,9,"PAH",19,1,33,0)="point to file 4.2.  It is necessary to do this because domain names can,"
^DIC(9.4,73,22,9,"PAH",19,1,34,0)="and do, change. The Post-Init, ^AFJXPRE, will go through the records in"
^DIC(9.4,73,22,9,"PAH",19,1,35,0)="those files and change the data in the affected fields to pointers to file"
^DIC(9.4,73,22,9,"PAH",19,1,36,0)="4.2.  It will take approximately 1/2 hour for every 400,000 records in file"
^DIC(9.4,73,22,9,"PAH",19,1,37,0)="^AFJ(537010.  Here are the new definitions for the affected fields:"
^DIC(9.4,73,22,9,"PAH",19,1,38,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,39,0)="STANDARD DATA DICTIONARY #537000 -- VAMC NETWORK HEALTH EXCHANGE FILE"
^DIC(9.4,73,22,9,"PAH",19,1,40,0)="STORED IN ^AFJ(537000,                                  (VERSION 5.1)"
^DIC(9.4,73,22,9,"PAH",19,1,41,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,73,22,9,"PAH",19,1,42,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,73,22,9,"PAH",19,1,43,0)="---------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",19,1,44,0)="537000,8   REQUESTING PLACE       1;1 POINTER TO DOMAIN FILE (#4.2)"
^DIC(9.4,73,22,9,"PAH",19,1,45,0)="           LAST EDITED:      NOV 15, 2001"
^DIC(9.4,73,22,9,"PAH",19,1,46,0)="           HELP-PROMPT:      Enter the domain where the request originated."
^DIC(9.4,73,22,9,"PAH",19,1,47,0)="           DESCRIPTION:"
^DIC(9.4,73,22,9,"PAH",19,1,48,0)="                             FACILITY REQUESTING DATA"
^DIC(9.4,73,22,9,"PAH",19,1,49,0)="           CROSS-REFERENCE:  537000^C"
^DIC(9.4,73,22,9,"PAH",19,1,50,0)="                             1)= S ^AFJ(537000,""C"",$E(X,1,30),DA)="""""
^DIC(9.4,73,22,9,"PAH",19,1,51,0)="                             2)= K ^AFJ(537000,""C"",$E(X,1,30),DA)"
^DIC(9.4,73,22,9,"PAH",19,1,52,0)="                             REQUESTING PLACE FOR PATIENT DATA"
^DIC(9.4,73,22,9,"PAH",19,1,53,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,54,0)="STANDARD DATA DICTIONARY #537010 -- VAMC NETWORK PATIENT FILE"
^DIC(9.4,73,22,9,"PAH",19,1,55,0)="STORED IN ^AFJ(537010,                          (VERSION 5.1)"
^DIC(9.4,73,22,9,"PAH",19,1,56,0)="DATA         NAME                  GLOBAL        DATA"
^DIC(9.4,73,22,9,"PAH",19,1,57,0)="ELEMENT      TITLE                 LOCATION      TYPE"
^DIC(9.4,73,22,9,"PAH",19,1,58,0)="---------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",19,1,59,0)="537010,3      Records Available At   1;0 POINTER Multiple #537010.04"
^DIC(9.4,73,22,9,"PAH",19,1,60,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,61,0)="537010.04,.01   Records Available At   0;1 POINTER TO DOMAIN FILE (#4.2)"
^DIC(9.4,73,22,9,"PAH",19,1,62,0)="             LAST EDITED:      NOV 15, 2001"
^DIC(9.4,73,22,9,"PAH",19,1,63,0)="             HELP-PROMPT:      Enter a domain which has records on the"
^DIC(9.4,73,22,9,"PAH",19,1,64,0)="                               patient."
^DIC(9.4,73,22,9,"PAH",19,1,65,0)="             CROSS-REFERENCE:  537010.04^B"
^DIC(9.4,73,22,9,"PAH",19,1,66,0)="                             1)= S ^AFJ(537010,DA(1),1,""B"",$E(X,1,30),DA)="""""
^DIC(9.4,73,22,9,"PAH",19,1,67,0)="                             2)= K ^AFJ(537010,DA(1),1,""B"",$E(X,1,30),DA)"
^DIC(9.4,73,22,9,"PAH",19,1,68,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,69,0)="STANDARD DATA DICTIONARY #537025 -- VAMC NETWORK HEALTH AUTHORIZED SITES FILE   "
^DIC(9.4,73,22,9,"PAH",19,1,70,0)="STORED IN ^AFJ(537025,                                        (VERSION 5.1)"
^DIC(9.4,73,22,9,"PAH",19,1,71,0)="DATA        NAME              GLOBAL        DATA"
^DIC(9.4,73,22,9,"PAH",19,1,72,0)="ELEMENT     TITLE             LOCATION      TYPE"
^DIC(9.4,73,22,9,"PAH",19,1,73,0)="---------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",19,1,74,0)="537025,.01  NAME               0;1 POINTER TO DOMAIN FILE (#4.2)"
^DIC(9.4,73,22,9,"PAH",19,1,75,0)="                                (Required)"
^DIC(9.4,73,22,9,"PAH",19,1,76,0)="            INPUT TRANSFORM:  S DIC(""S"")=""I $P(^(0),U,2)'[""""C"""""" D ^DIC"
^DIC(9.4,73,22,9,"PAH",19,1,77,0)="                                 K DIC S DIC=DIE,X=+Y K:Y<0 X"
^DIC(9.4,73,22,9,"PAH",19,1,78,0)="            LAST EDITED:      NOV 15, 2001 "
^DIC(9.4,73,22,9,"PAH",19,1,79,0)="            HELP-PROMPT:      Enter the name of an authorized site. "
^DIC(9.4,73,22,9,"PAH",19,1,80,0)="            DESCRIPTION:      Enter the name of the sites that you will send"
^DIC(9.4,73,22,9,"PAH",19,1,81,0)="                              data requests to and receive data from. "
^DIC(9.4,73,22,9,"PAH",19,1,82,0)="                              (Include your own site).  "
^DIC(9.4,73,22,9,"PAH",19,1,83,0)="            SCREEN:           S DIC(""S"")=""I $P(^(0),U,2)'[""""C"""""""
^DIC(9.4,73,22,9,"PAH",19,1,84,0)="            EXPLANATION:      You may not select closed domains."
^DIC(9.4,73,22,9,"PAH",19,1,85,0)="            CROSS-REFERENCE:  537025^B "
^DIC(9.4,73,22,9,"PAH",19,1,86,0)="                              1)= S ^AFJ(537025,""B"",$E(X,1,30),DA)="""""
^DIC(9.4,73,22,9,"PAH",19,1,87,0)="                              2)= K ^AFJ(537025,""B"",$E(X,1,30),DA)"
^DIC(9.4,73,22,9,"PAH",19,1,88,0)=""
^DIC(9.4,73,22,9,"PAH",19,1,89,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",19,1,90,0)="is at a minimum.  It requires patch AFJX*5.1*29 and *30."
^DIC(9.4,73,22,9,"PAH",19,1,91,0)="The post-init for this patch will take approximately 1/2 hour for every"
^DIC(9.4,73,22,9,"PAH",19,1,92,0)="400,000 records in file ^AFJ(537010."
^DIC(9.4,73,22,9,"PAH",19,1,93,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",19,1,94,0)=" "
^DIC(9.4,73,22,9,"PAH",19,1,95,0)="ROUTINES:"
^DIC(9.4,73,22,9,"PAH",19,1,96,0)="The second line of the routine now looks like:"
^DIC(9.4,73,22,9,"PAH",19,1,97,0)="       ;;5.1;Network Health Exchange;**[patch list]**;Jan 23, 1996"
^DIC(9.4,73,22,9,"PAH",19,1,98,0)=" "
^DIC(9.4,73,22,9,"PAH",19,1,99,0)="             Before        After"
^DIC(9.4,73,22,9,"PAH",19,1,100,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,73,22,9,"PAH",19,1,101,0)="-----------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",19,1,102,0)="AFJXALRT   14041415     12200940     6,15,17,23,31"
^DIC(9.4,73,22,9,"PAH",19,1,103,0)="AFJXPATL    6030128       295973     31"
^DIC(9.4,73,22,9,"PAH",19,1,104,0)="AFJXPATS    3869099       299773     23,31"
