^DIC(9.4,3,22,21,"PAH",156,1,1,0)="LAS-1000-62717, BOI-1000-52970  XUS1A, XUESSO1 "
^DIC(9.4,3,22,21,"PAH",156,1,2,0)="During the early testing of RDV the DUZ value was hard set just before"
^DIC(9.4,3,22,21,"PAH",156,1,3,0)="the call to the RPC.  When the code was fixed to properly set DUZ the"
^DIC(9.4,3,22,21,"PAH",156,1,4,0)="old code didn't get removed.  This has been fixed."
^DIC(9.4,3,22,21,"PAH",156,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",156,1,6,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",156,1,7,0)="The following routines are included in this patch.  The second line of each"
