^DIC(9.4,13,22,7,"PAH",30,1,25,0)="Clarksburg, WV"
^DIC(9.4,13,22,7,"PAH",30,1,26,0)="Dayton, OH"
^DIC(9.4,13,22,7,"PAH",30,1,27,0)=" "
^DIC(9.4,13,22,7,"PAH",30,1,28,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",30,1,29,0)="================"
^DIC(9.4,13,22,7,"PAH",30,1,30,0)="The following routines are included in this patch.  The second line of"
