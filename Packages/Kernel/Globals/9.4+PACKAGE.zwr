^DIC(9.4,47,22,5.9,"PAH",147,0)="239^2991123^1"
^DIC(9.4,47,22,5.9,"PAH",147,1,0)="^^2^2^2991123"
^DIC(9.4,47,22,5.9,"PAH",147,1,1,0)="This build contains changes to a load/edit screen routine for PCMM patch "
