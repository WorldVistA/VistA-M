^DIC(9.4,104,22,7,"PAH",2,1,1,0)="This build contains a patch which corrects a bug reported in the NOIS"
^DIC(9.4,104,22,7,"PAH",2,1,2,0)="message MAD-0896-40098. Please see the GMRV*3*4 entry on the Patch"
