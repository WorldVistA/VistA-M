^DIC(9.4,48,22,5.28,"PAH",714,1,6,0)="VSE-10988 - TAW - VistA: Modify Daylight Savings time calculations to "
^DIC(9.4,48,22,5.28,"PAH",714,1,7,0)="            include time"
^DIC(9.4,48,22,5.28,"PAH",714,1,8,0)="VSE-11051 - TAW - VistA: Modify date/time logic to add validation that "
^DIC(9.4,48,22,5.28,"PAH",714,1,9,0)="            seconds and hours are not greater than 60"
^DIC(9.4,48,22,5.28,"PAH",714,1,10,0)="VSE-11052 - TAW - VistA: Modify SDES2UTIL Routine under the SENSITIVE tag "
^DIC(9.4,48,22,5.28,"PAH",714,1,11,0)="            to default SDDUZ to DUZ if no value is passed in"
^DIC(9.4,48,22,5.28,"PAH",714,1,12,0)="VSE-11321 - TAW - VistA: Modify SD RECEIVE OR Protocol to prevent it from "
^DIC(9.4,48,22,5.28,"PAH",714,1,13,0)="            popula ting the MRTC CALC PREF DATES"
