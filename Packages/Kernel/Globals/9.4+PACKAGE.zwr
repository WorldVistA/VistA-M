^DIC(9.4,48,22,5.28,"PAH",658,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",658,1,4,0)="VSE-6406: BB - Clinic Special Instructions are alphabetized, rather than "
^DIC(9.4,48,22,5.28,"PAH",658,1,5,0)="          being saved sequentially"
^DIC(9.4,48,22,5.28,"PAH",658,1,6,0)="VSE-6456: BB - VistA: Modify SDES BLOCK AND MOVE to send output as "
^DIC(9.4,48,22,5.28,"PAH",658,1,7,0)="          properly formatted JSON"
^DIC(9.4,48,22,5.28,"PAH",658,1,8,0)="VSE-6457: BB - VistA: Modify SDES SEARCH CLINIC ATTRIBUTES to have an "
^DIC(9.4,48,22,5.28,"PAH",658,1,9,0)="          optional input parameter"
^DIC(9.4,48,22,5.28,"PAH",658,1,10,0)="VSE-6470: TB - VistA: Rewrite SDES CREATE RECALL REQ 2 in the SDES2 "
^DIC(9.4,48,22,5.28,"PAH",658,1,11,0)="          namespace"
^DIC(9.4,48,22,5.28,"PAH",658,1,12,0)="VSE-6474: TB - VistA: Rewrite SDES EDIT RECALL REQ 2 in the SDES2 "
^DIC(9.4,48,22,5.28,"PAH",658,1,13,0)="          namespace"
^DIC(9.4,48,22,5.28,"PAH",658,1,14,0)="VSE-6475: AP - VistA: Rewrite SDES DISPOSITION APPT REQ in the SDES2 "
^DIC(9.4,48,22,5.28,"PAH",658,1,15,0)="          namespace"
^DIC(9.4,48,22,5.28,"PAH",658,1,16,0)="VSE-6479: BF - Vista: Rewrite SDES DISPOSITION RECALL REQ in the SDES"
^DIC(9.4,48,22,5.28,"PAH",658,1,17,0)="          namespace"
^DIC(9.4,48,22,5.28,"PAH",658,1,18,0)="VSE-6484: BB - SDES2 Priority 10: Rewrite SDES CREATE APPOINTMENTS in the"
^DIC(9.4,48,22,5.28,"PAH",658,1,19,0)="          SDES2 namespace"
^DIC(9.4,48,22,5.28,"PAH",658,1,20,0)="VSE-6485: TB - VistA: Rewrite SDES CHECKIN in the SDES2 namespace"
^DIC(9.4,48,22,5.28,"PAH",658,1,21,0)="VSE-6552: BB - VistA: Modify SDES READ CLINIC GROUP to return CLINIC IEN "
^DIC(9.4,48,22,5.28,"PAH",658,1,22,0)="          or PROVIDER IEN based on the RESOURCE TYPE"
^DIC(9.4,48,22,5.28,"PAH",658,1,23,0)="VSE-6589: BB - VistA: Create SDES2 RPC for Patient Information"
^DIC(9.4,48,22,5.28,"PAH",658,1,24,0)="VSE-6591: LB - VistA: Modify SDES CREATE WALKIN APPT to call new check in "
^DIC(9.4,48,22,5.28,"PAH",658,1,25,0)="          routine"
^DIC(9.4,48,22,5.28,"PAH",658,1,26,0)="VSE-6593: LB - VistA: New SDES2 RPC return back - has the given clinic "
^DIC(9.4,48,22,5.28,"PAH",658,1,27,0)="          ever had any availability defined?"
^DIC(9.4,48,22,5.28,"PAH",658,1,28,0)="VSE-6606: MD - VistA: Update SDES2 EDIT CLINIC to allow for the editing "
^DIC(9.4,48,22,5.28,"PAH",658,1,29,0)="          of the holiday field"
^DIC(9.4,48,22,5.28,"PAH",658,1,30,0)="VSE-6673: LB - VistA: Modify SDES2 GET LAST SELECTED PAT to use SDCONTEXT "
^DIC(9.4,48,22,5.28,"PAH",658,1,31,0)="          USER DUZ"
^DIC(9.4,48,22,5.28,"PAH",658,1,32,0)="VSE-6906: MD - VistA: Create a new SDES2 RPC to return all future canceled"
^DIC(9.4,48,22,5.28,"PAH",658,1,33,0)="          slots given a clinic ID."
^DIC(9.4,48,22,5.28,"PAH",658,1,34,0)="VSE-7001: BF - VistA: Update SDES2 EDIT CLINIC to allow removal of default"
^DIC(9.4,48,22,5.28,"PAH",658,1,35,0)="          designation from both provider and diagnosis."
^DIC(9.4,48,22,5.28,"PAH",658,1,36,0)="VSE-7021: VistA: Correct issue with neurology service not saving on "
^DIC(9.4,48,22,5.28,"PAH",658,1,37,0)="          creation or edit."
