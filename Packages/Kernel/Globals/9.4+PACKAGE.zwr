^DIC(9.4,60,22,13,"PAH",625,1,293,0)="   Copy PATIENT INSTRUCTIONS from Rx #3004815? YES// "
^DIC(9.4,60,22,13,"PAH",625,1,294,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,295,0)="   a)If YES is chosen by the user, all fields on the eRx Drug Validation screen"
^DIC(9.4,60,22,13,"PAH",625,1,296,0)="     will have its fields updated with any available data."
^DIC(9.4,60,22,13,"PAH",625,1,297,0)="     "
^DIC(9.4,60,22,13,"PAH",625,1,298,0)="   b)If NO is chosen by the user, all fields on the eRx Drug Validation screen"
^DIC(9.4,60,22,13,"PAH",625,1,299,0)="     will have its fields updated with any available data, with the exception"
^DIC(9.4,60,22,13,"PAH",625,1,300,0)="     of the Patient Instruction field. The user can manually edit the field as"
^DIC(9.4,60,22,13,"PAH",625,1,301,0)="     they currently do."
^DIC(9.4,60,22,13,"PAH",625,1,302,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,303,0)="   c)When the user inputs the up-caret symbol (^), no changes are made."
^DIC(9.4,60,22,13,"PAH",625,1,304,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,305,0)="6. RxChangeRequest 'Script Clarification' reason message templates"
