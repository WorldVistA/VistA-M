^DIC(9.4,42,22,7,"PAH",61,0)="63^3050311^1"
^DIC(9.4,42,22,7,"PAH",61,1,0)="^^1^1^3050311"
^DIC(9.4,42,22,7,"PAH",61,1,1,0)="See the National Patch module for information for this patch."
^DIC(9.4,42,22,7,"PAH",62,0)="72 SEQ #67^3050401^1"
^DIC(9.4,42,22,7,"PAH",62,1,0)="^^4^4^3050401"
^DIC(9.4,42,22,7,"PAH",62,1,1,0)="Routines which have been added/modified to update the Oncology Health "
^DIC(9.4,42,22,7,"PAH",62,1,2,0)="Summary, to reflect changes to the FORDS (Facility Oncology Registry Data "
^DIC(9.4,42,22,7,"PAH",62,1,3,0)="Standards) and addition of AJCC (American Joint Committee on Cancer) "
^DIC(9.4,42,22,7,"PAH",62,1,4,0)="Collaborative Staging."
^DIC(9.4,42,22,7,"PAH",63,0)="73 SEQ #68^3050813^1"
^DIC(9.4,42,22,7,"PAH",63,1,0)="^^2^2^3050813"
^DIC(9.4,42,22,7,"PAH",63,1,1,0)="Correct the Branch of Service line in the demographic Health Summary "
^DIC(9.4,42,22,7,"PAH",63,1,2,0)="display. The last 1- 4 characters are dropped."
^DIC(9.4,42,22,7,"PAH",64,0)="39 SEQ #69^3051020^1"
^DIC(9.4,42,22,7,"PAH",64,1,0)="^^5^5^3051020"
^DIC(9.4,42,22,7,"PAH",64,1,1,0)="Updates the subroutine, invoked by the DD screen for the SELECTION ITEM "
^DIC(9.4,42,22,7,"PAH",64,1,2,0)="sub-field of the HEALTH SUMMARY TYPE (#142) file, for use in the "
^DIC(9.4,42,22,7,"PAH",64,1,3,0)="Create/Modify Health Summary Type option, so that the screen's pattern "
^DIC(9.4,42,22,7,"PAH",64,1,4,0)="match will allow selection of entries which have SYNONYM (field #.09 in"
^DIC(9.4,42,22,7,"PAH",64,1,5,0)="the HEALTH FACTORS (#9999999.64) file) that is of the pattern GEC_n_XXXX."
^DIC(9.4,42,22,7,"PAH",65,0)="74 SEQ #70^3051202^1"
^DIC(9.4,42,22,7,"PAH",65,1,0)="^^3^3^3051202"
^DIC(9.4,42,22,7,"PAH",65,1,1,0)="Fixes algorithm used to process date field values for range of entries to "
^DIC(9.4,42,22,7,"PAH",65,1,2,0)="display in Health Summary component GLOBAL ASSESSMENT FUNCTIONING."
^DIC(9.4,42,22,7,"PAH",65,1,3,0)="Problem occurred only when user interaction was on the last day of month."
^DIC(9.4,42,22,7,"PAH",66,0)="79 SEQ #71^3060112^1"
^DIC(9.4,42,22,7,"PAH",66,1,0)="^^3^3^3060112"
^DIC(9.4,42,22,7,"PAH",66,1,1,0)=" "
^DIC(9.4,42,22,7,"PAH",66,1,2,0)="Health summary needs to use a new Lab API to collect the correct data for"
^DIC(9.4,42,22,7,"PAH",66,1,3,0)="test results from the Lab package."
^DIC(9.4,42,22,7,"PAH",67,0)="78 SEQ #72^3060504^1"
^DIC(9.4,42,22,7,"PAH",67,1,0)="^^3^3^3060504"
^DIC(9.4,42,22,7,"PAH",67,1,1,0)="This patch adds a new Vitals API call to several Vital Signs Health"
^DIC(9.4,42,22,7,"PAH",67,1,2,0)="Summary Components.  It also adds a new Outpatient Pharmacy API call to "
^DIC(9.4,42,22,7,"PAH",67,1,3,0)="an Outpatient Pharmacy Health Summary Component."
^DIC(9.4,42,22,7,"PAH",68,0)="76 SEQ #73^3060504^1"
^DIC(9.4,42,22,7,"PAH",68,1,0)="^^2^2^3060504"
^DIC(9.4,42,22,7,"PAH",68,1,1,0)="This patch addresses the issues of a non-numeric modifier not "
^DIC(9.4,42,22,7,"PAH",68,1,2,0)="displaying."
^DIC(9.4,42,22,7,"PAH",69,0)="75^3061122.224508^1"
^DIC(9.4,42,22,7,"PAH",69,1,0)="^^3^3^3061122"
^DIC(9.4,42,22,7,"PAH",69,1,1,0)="This patch in conjunction with patch PXRM*2*4 restores the display"
^DIC(9.4,42,22,7,"PAH",69,1,2,0)="of the Clinical Reminders disclaimer for the Clinical Reminders"
^DIC(9.4,42,22,7,"PAH",69,1,3,0)="Maintenace, Brief, and Due Health Summary components."
^DIC(9.4,42,22,7,"PAH",70,0)="81^3061211.162605^1"
^DIC(9.4,42,22,7,"PAH",70,1,0)="^^2^2^3061211"
^DIC(9.4,42,22,7,"PAH",70,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,42,22,7,"PAH",70,1,2,0)="under GMTS*2.7*81."
^DIC(9.4,42,22,7,"PAH",71,0)="70 SEQ #76^3061228.073336^1"
^DIC(9.4,42,22,7,"PAH",72,0)="83 SEQ #77^3071212.210943^1"
^DIC(9.4,42,22,7,"PAH",73,0)="87^3071212.221042^1"
^DIC(9.4,42,22,7,"PAH",73,1,0)="^^1^1^3071212"
^DIC(9.4,42,22,7,"PAH",73,1,1,0)="National Skin Risk Assessment HS Types and HS Objects"
^DIC(9.4,42,22,7,"PAH",74,0)="77^3080203.22232^1"
^DIC(9.4,42,22,7,"PAH",75,0)="85 SEQ #80^3080526.154234^1"
^DIC(9.4,42,22,7,"PAH",76,0)="80^3090421.154938^17"
^DIC(9.4,42,22,7,"PAH",77,0)="84 SEQ #82^3090421.155318^17"
^DIC(9.4,42,22,7,"PAH",77,1,0)="^^7^7^3090421"
^DIC(9.4,42,22,7,"PAH",77,1,1,0)="Health Summary and OE/RR Report display of Radiology's new 'Reason for "
^DIC(9.4,42,22,7,"PAH",77,1,2,0)="Study' field (field 1.1 in ^RAO(75.1)).  The ORDV03 routine and OE/RR "
^DIC(9.4,42,22,7,"PAH",77,1,3,0)="Reports file #101.24, associated with this patch, are included in "
^DIC(9.4,42,22,7,"PAH",77,1,4,0)="OR*3.0*243.  GMTS*2.7*84 is dependent upon OR*3.0*243, not visa versa."
^DIC(9.4,42,22,7,"PAH",77,1,5,0)=" "
^DIC(9.4,42,22,7,"PAH",77,1,6,0)="Refer to the National Patch Module for complete details of the "
^DIC(9.4,42,22,7,"PAH",77,1,7,0)="enhancements included in this patch."
^DIC(9.4,42,22,7,"PAH",78,0)="82 SEQ #83^3090421.162528^17"
^DIC(9.4,42,22,7,"PAH",78,1,0)="^^1^1^3090421"
^DIC(9.4,42,22,7,"PAH",78,1,1,0)="This patch will correct multiple problems in the Health Summary package."
^DIC(9.4,42,22,7,"PAH",79,0)="91 SEQ #84^3090630.111934^17"
^DIC(9.4,42,22,7,"PAH",79,1,0)="^^3^3^3090630"
^DIC(9.4,42,22,7,"PAH",79,1,1,0)="If a Mental Health instrument is administered multiple times for the same "
^DIC(9.4,42,22,7,"PAH",79,1,2,0)="visit through CPRS via Progress Notes and Clinical Reminders, all the "
^DIC(9.4,42,22,7,"PAH",79,1,3,0)="tests do not display in the MHAL and MHAS Health Summary components."
^DIC(9.4,42,22,7,"PAH",80,0)="89^3091118.095639^17"
^DIC(9.4,42,22,7,"PAH",81,0)="93 SEQ #86^3100325.161656^17"
^DIC(9.4,42,22,7,"PAH",82,0)="90^3110308.135721^17"
^DIC(9.4,42,22,7,"PAH",83,0)="92 SEQ #88^3110428.161601^17"
^DIC(9.4,42,22,7,"PAH",83,1,0)="^^78^78^3110428"
^DIC(9.4,42,22,7,"PAH",83,1,1,0)="Patches PSO*7*316 and GMTS*2.7*92 correct issues reported with the "
^DIC(9.4,42,22,7,"PAH",83,1,2,0)="Tool #2: Medication Worksheet. The Health Summary patch GMTS*2.7*92"
^DIC(9.4,42,22,7,"PAH",83,1,3,0)="will require patch PSO*7*316 and will create a national entry in the"
^DIC(9.4,42,22,7,"PAH",83,1,4,0)="HEALTH SUMMARY COMPONENT file (#142.1) for Tool #2: Medication Worksheet."
^DIC(9.4,42,22,7,"PAH",83,1,5,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,6,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,7,0)="1.  Current standards for patient privacy and confidentiality were not "
^DIC(9.4,42,22,7,"PAH",83,1,8,0)="being met within the report."
^DIC(9.4,42,22,7,"PAH",83,1,9,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,10,0)="Problem:"
^DIC(9.4,42,22,7,"PAH",83,1,11,0)="--------"
^DIC(9.4,42,22,7,"PAH",83,1,12,0)="The report was hard-coded to display a patient's last four digits of the "
^DIC(9.4,42,22,7,"PAH",83,1,13,0)="SSN in the body of the report."
^DIC(9.4,42,22,7,"PAH",83,1,14,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,15,0)="Resolution:"
^DIC(9.4,42,22,7,"PAH",83,1,16,0)="-----------"
^DIC(9.4,42,22,7,"PAH",83,1,17,0)="Removed the programming that displayed the last four digits of patient "
^DIC(9.4,42,22,7,"PAH",83,1,18,0)="SSN.  Additionally, the release of health summary patch GMTS*2.7*85 now"
^DIC(9.4,42,22,7,"PAH",83,1,19,0)="permits the removal of the patient SSN from the health summary overall"
^DIC(9.4,42,22,7,"PAH",83,1,20,0)="header.  The change in this patch now permits the worksheet to be"
^DIC(9.4,42,22,7,"PAH",83,1,21,0)="printed with no SSN references remaining."
^DIC(9.4,42,22,7,"PAH",83,1,22,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,23,0)="2.  Wrong pharmacy division name printing on the report header."
^DIC(9.4,42,22,7,"PAH",83,1,24,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,25,0)="Problem:"
^DIC(9.4,42,22,7,"PAH",83,1,26,0)="--------"
^DIC(9.4,42,22,7,"PAH",83,1,27,0)="At integrated sites, the name of the primary facility would print on the "
^DIC(9.4,42,22,7,"PAH",83,1,28,0)="report even when generated from the legacy facility."
^DIC(9.4,42,22,7,"PAH",83,1,29,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,30,0)="Resolution:"
^DIC(9.4,42,22,7,"PAH",83,1,31,0)="-----------"
^DIC(9.4,42,22,7,"PAH",83,1,32,0)="The internal programming that selects the name of the pharmacy"
^DIC(9.4,42,22,7,"PAH",83,1,33,0)="division shown at the top of the worksheet and the pharmacy phone"
^DIC(9.4,42,22,7,"PAH",83,1,34,0)="number associated with it has been revised. "
^DIC(9.4,42,22,7,"PAH",83,1,35,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,36,0)="3.  Medication Worksheet does not distinguish ACTIVE and HOLD status "
^DIC(9.4,42,22,7,"PAH",83,1,37,0)="prescriptions."
^DIC(9.4,42,22,7,"PAH",83,1,38,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,39,0)="Problem:"
^DIC(9.4,42,22,7,"PAH",83,1,40,0)="--------"
^DIC(9.4,42,22,7,"PAH",83,1,41,0)="In the initial release of Medication Reconciliation software with "
^DIC(9.4,42,22,7,"PAH",83,1,42,0)="PSO*7*294, one of the known issues was that a prescription with status of "
^DIC(9.4,42,22,7,"PAH",83,1,43,0)="HOLD was not clearly identified as such in the Medication Worksheet."
^DIC(9.4,42,22,7,"PAH",83,1,44,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,45,0)="Resolution:"
^DIC(9.4,42,22,7,"PAH",83,1,46,0)="-----------"
^DIC(9.4,42,22,7,"PAH",83,1,47,0)="A status indicator is added for prescriptions with status of HOLD, "
^DIC(9.4,42,22,7,"PAH",83,1,48,0)="similar to the existing indicator for PENDING prescriptions in that "
^DIC(9.4,42,22,7,"PAH",83,1,49,0)="report."
^DIC(9.4,42,22,7,"PAH",83,1,50,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,51,0)="4.  The initial release of Medication Reconciliation tools with patch "
^DIC(9.4,42,22,7,"PAH",83,1,52,0)="PSO*7*294 required manual creation of Health Summary components."
^DIC(9.4,42,22,7,"PAH",83,1,53,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,54,0)="Problem:"
^DIC(9.4,42,22,7,"PAH",83,1,55,0)="--------"
^DIC(9.4,42,22,7,"PAH",83,1,56,0)="There is no guarantee that all VA facilities set up the components "
^DIC(9.4,42,22,7,"PAH",83,1,57,0)="exactly as indicated in the Medication Reconciliation Implementation "
^DIC(9.4,42,22,7,"PAH",83,1,58,0)="Guide."
^DIC(9.4,42,22,7,"PAH",83,1,59,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,60,0)="Resolution:"
^DIC(9.4,42,22,7,"PAH",83,1,61,0)="-----------"
^DIC(9.4,42,22,7,"PAH",83,1,62,0)="This patch introduces the following file entries with nationally "
^DIC(9.4,42,22,7,"PAH",83,1,63,0)="standardized internal entry numbers (IENs)."
^DIC(9.4,42,22,7,"PAH",83,1,64,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,65,0)="        HEALTH SUMMARY COMPONENT file (#142.1)"
^DIC(9.4,42,22,7,"PAH",83,1,66,0)="        ======================================"
^DIC(9.4,42,22,7,"PAH",83,1,67,0)="        Entry #252 - Medication Worksheet (Tool #2)"
^DIC(9.4,42,22,7,"PAH",83,1,68,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,69,0)="        HEALTH SUMMARY TYPE file (#141)"
^DIC(9.4,42,22,7,"PAH",83,1,70,0)="        ==============================="
^DIC(9.4,42,22,7,"PAH",83,1,71,0)="        The above-listed Health Summary Component (IEN #252) will be added"
^DIC(9.4,42,22,7,"PAH",83,1,72,0)="        to the existing GMTS HS ADHOC OPTION Health Summary type"
^DIC(9.4,42,22,7,"PAH",83,1,73,0)=" "
^DIC(9.4,42,22,7,"PAH",83,1,74,0)="        VAQ - DATA SEGMENT file (#394.71)"
^DIC(9.4,42,22,7,"PAH",83,1,75,0)="        ================================="
^DIC(9.4,42,22,7,"PAH",83,1,76,0)="        This file contains an entry corresponding to the above-listed"
^DIC(9.4,42,22,7,"PAH",83,1,77,0)="        Health Summary Component (IEN #252) that will be listed as"
^DIC(9.4,42,22,7,"PAH",83,1,78,0)="        Medication Worksheet (tool #2). "
^DIC(9.4,42,22,7,"PAH",84,0)="95 SEQ #89^3110705.14374^17"
^DIC(9.4,42,22,7,"PAH",84,1,0)="^^10^10^3110705"
^DIC(9.4,42,22,7,"PAH",84,1,1,0)="Currently, the NAME field (.01) of the HEALTH SUMMARY OBJECTS file "
^DIC(9.4,42,22,7,"PAH",84,1,2,0)="(#142.5) had a 'B' cross-reference that only stored the first 30 "
^DIC(9.4,42,22,7,"PAH",84,1,3,0)="characters of the name. When attempting to install a TIU/HS Object in "
^DIC(9.4,42,22,7,"PAH",84,1,4,0)="Clinical Reminder Exchange, a FileMan error: ""The update failed, "
^DIC(9.4,42,22,7,"PAH",84,1,5,0)="UPDATE^DIE returned the following error message"" would occur when the "
^DIC(9.4,42,22,7,"PAH",84,1,6,0)="receiving site has multiple Health Summary Object entries that are not "
^DIC(9.4,42,22,7,"PAH",84,1,7,0)="unique until after the 30 character length."
^DIC(9.4,42,22,7,"PAH",84,1,8,0)=" "
^DIC(9.4,42,22,7,"PAH",84,1,9,0)="This patch corrects this problem by modifying the 'B' cross-reference to "
^DIC(9.4,42,22,7,"PAH",84,1,10,0)="store the full 60 characters."
^DIC(9.4,42,22,7,"PAH",85,0)="100 SEQ #90^3110818.104639^17"
^DIC(9.4,42,22,7,"PAH",85,1,0)="^^2^2^3110818"
^DIC(9.4,42,22,7,"PAH",85,1,1,0)="In the Medication Worksheet report in CPRS, the signature lines"
^DIC(9.4,42,22,7,"PAH",85,1,2,0)="of a prescription carry over to subsequent prescriptions"
^DIC(9.4,42,22,7,"PAH",86,0)="88 SEQ #91^3111102.120214^17"
^DIC(9.4,42,22,7,"PAH",86,1,0)="^^6^6^3111102"
^DIC(9.4,42,22,7,"PAH",86,1,1,0)="This patch will resolve the following Remedy tickets:"
^DIC(9.4,42,22,7,"PAH",86,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",86,1,3,0)="HD70142 - TIU-HS Object (SII) not pulling column headers"
^DIC(9.4,42,22,7,"PAH",86,1,4,0)="HD231399 - Health Summary changes to coincide with LR*5.2*356"
^DIC(9.4,42,22,7,"PAH",86,1,5,0)="HD230879 - Mental Health Components"
^DIC(9.4,42,22,7,"PAH",86,1,6,0)="HD336184 - MENU OPTION GMTS HS BY LOC wasting many sheets"
^DIC(9.4,42,22,7,"PAH",87,0)="99^3120323.125238^17"
^DIC(9.4,42,22,7,"PAH",88,0)="102^3121015.152102^17"
^DIC(9.4,42,22,7,"PAH",88,1,0)="^^5^5^3121015"
^DIC(9.4,42,22,7,"PAH",88,1,1,0)="The Mental Health Package is removing file #90 as part of a cleanup "
^DIC(9.4,42,22,7,"PAH",88,1,2,0)="project. This patch will permanently deactivate the MENTAL HEALTH "
^DIC(9.4,42,22,7,"PAH",88,1,3,0)="PHYSICAL EXAM health summary component, rebuild the Health Summary Ad Hoc "
^DIC(9.4,42,22,7,"PAH",88,1,4,0)="Report, and create a report of Health Summary Types and Objects that used "
^DIC(9.4,42,22,7,"PAH",88,1,5,0)="the MENTAL HEALTH PHYSICAL EXAM component."
^DIC(9.4,42,22,7,"PAH",89,0)="96 SEQ #94^3130213.120219^17"
^DIC(9.4,42,22,7,"PAH",89,1,0)="^^17^17^3130213"
^DIC(9.4,42,22,7,"PAH",89,1,1,0)="1. As a part of the Lab Re-engineering project, displays are being"
^DIC(9.4,42,22,7,"PAH",89,1,2,0)="modified to show the Cerner COTS (Commercial Off-The-Shelf) accession"
^DIC(9.4,42,22,7,"PAH",89,1,3,0)="number for those orders that are being performed on Cerner."
^DIC(9.4,42,22,7,"PAH",89,1,4,0)=" "
^DIC(9.4,42,22,7,"PAH",89,1,5,0)="One of these displays is controlled by the Health Summary v2.7 package. "
^DIC(9.4,42,22,7,"PAH",89,1,6,0)="The purpose of this patch is to modify the display on the Reports Tab - "
^DIC(9.4,42,22,7,"PAH",89,1,7,0)="Clinical Reports - Laboratory - Lab Orders to show the COTS accession "
^DIC(9.4,42,22,7,"PAH",89,1,8,0)="number if it is available."
^DIC(9.4,42,22,7,"PAH",89,1,9,0)=" "
^DIC(9.4,42,22,7,"PAH",89,1,10,0)="2. In some cases, the status of a test displays as 'COMPLETED' on the "
^DIC(9.4,42,22,7,"PAH",89,1,11,0)="Computerized Patient Record System (CPRS) Reports Tab and Lab Tab "
^DIC(9.4,42,22,7,"PAH",89,1,12,0)="displays, rather than the appropriate status of 'CANCELED'. This patch "
^DIC(9.4,42,22,7,"PAH",89,1,13,0)="corrects this problem."
^DIC(9.4,42,22,7,"PAH",89,1,14,0)=" "
^DIC(9.4,42,22,7,"PAH",89,1,15,0)="3. In support of New Service Request 20070438, a change is required in "
^DIC(9.4,42,22,7,"PAH",89,1,16,0)="the Health Summary package. This patch makes this change to the Lab "
^DIC(9.4,42,22,7,"PAH",89,1,17,0)="Display Status. The change will be dormant until CPRS v30 is installed."
^DIC(9.4,42,22,7,"PAH",90,0)="105 SEQ #95^3130408.100924^17"
^DIC(9.4,42,22,7,"PAH",90,1,0)="^^4^4^3130408"
^DIC(9.4,42,22,7,"PAH",90,1,1,0)="A subscript error occurs when editing an AD HOC report."
^DIC(9.4,42,22,7,"PAH",90,1,2,0)="The descriptions of two heath summary components contain spelling errors."
^DIC(9.4,42,22,7,"PAH",90,1,3,0)="CPRS is not displaying the correct name for nationally released health "
^DIC(9.4,42,22,7,"PAH",90,1,4,0)="summary reports"
^DIC(9.4,42,22,7,"PAH",91,0)="104^3130516.125604^17"
^DIC(9.4,42,22,7,"PAH",91,1,0)="^^3^3^3130516"
^DIC(9.4,42,22,7,"PAH",91,1,1,0)="High Risk MH Phase II"
^DIC(9.4,42,22,7,"PAH",91,1,2,0)="Updates the MH HIGH RISK PRF HX Health Summary Component to display Cat 1 "
^DIC(9.4,42,22,7,"PAH",91,1,3,0)="and 2 PRF for suicide risk.  Component description is also updated."
^DIC(9.4,42,22,7,"PAH",92,0)="106 SEQ #97^3130614.085858^17"
^DIC(9.4,42,22,7,"PAH",93,0)="86^3130614.090258^17"
^DIC(9.4,42,22,7,"PAH",93,1,0)="^^2^2^3130614"
^DIC(9.4,42,22,7,"PAH",93,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,42,22,7,"PAH",93,1,2,0)="under GMTS*2.7*86."
^DIC(9.4,42,22,7,"PAH",94,0)="103^3130829.111131^17"
^DIC(9.4,42,22,7,"PAH",94,1,0)="^^5^5^3130829"
^DIC(9.4,42,22,7,"PAH",94,1,1,0)="Distributes ONE new HEALTH SUMMARY COMPONENT and TWO new HEALTH SUMMARY "
^DIC(9.4,42,22,7,"PAH",94,1,2,0)="TYPEs, one of which will be a REMOTE type."
^DIC(9.4,42,22,7,"PAH",94,1,3,0)="Component: CAT 1 PRF STATUS (IEN=257)"
^DIC(9.4,42,22,7,"PAH",94,1,4,0)="    Types: VA-CAT 1 PRF STATUS"
^DIC(9.4,42,22,7,"PAH",94,1,5,0)="           REMOTE CAT 1 PRF STATUS (IEN=500021)"
^DIC(9.4,42,22,7,"PAH",95,0)="109 SEQ #100^3130930.101018^17"
^DIC(9.4,42,22,7,"PAH",96,0)="107 SEQ #101^3131209.142115^17"
^DIC(9.4,42,22,7,"PAH",97,0)="110 SEQ #102^3140805.094531^17"
^DIC(9.4,42,22,7,"PAH",98,0)="101^3140902.125241^17"
^DIC(9.4,42,22,7,"PAH",99,0)="111^3150916.111011^17"
^DIC(9.4,42,22,7,"PAH",99,1,0)="^^3^3^3150916"
^DIC(9.4,42,22,7,"PAH",99,1,1,0)="This build will remediate certain GMTS component routines to comply with "
^DIC(9.4,42,22,7,"PAH",99,1,2,0)="the expanded fields added for the ICD-10 PTF Project (DG*5.3*884).  See "
^DIC(9.4,42,22,7,"PAH",99,1,3,0)="NPM entry for details."
^DIC(9.4,42,22,7,"PAH",100,0)="112^3160310.170002^54"
^DIC(9.4,42,22,7,"PAH",101,0)="114 SEQ #106^3160310.171735^54"
^DIC(9.4,42,22,7,"PAH",102,0)="117^3160916.133833^54"
^DIC(9.4,42,22,7,"PAH",103,0)="116^3161028.150447^54"
^DIC(9.4,42,22,7,"PAH",103,1,0)="^^62^62^3161028"
^DIC(9.4,42,22,7,"PAH",103,1,1,0)="This patch is in support of the Mental Health PCL-5 instrument patch.  It "
^DIC(9.4,42,22,7,"PAH",103,1,2,0)="will modify the list of mental health instruments presented as selection "
^DIC(9.4,42,22,7,"PAH",103,1,3,0)="items in health summary when using the ad hoc health summary option in "
^DIC(9.4,42,22,7,"PAH",103,1,4,0)="CPRS.  The patch will prevent instruments that are inoperative or not "
^DIC(9.4,42,22,7,"PAH",103,1,5,0)="scored correctly from being selected."
^DIC(9.4,42,22,7,"PAH",103,1,6,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,7,0)="Please refer to the information contained in the Mental Health patch for "
^DIC(9.4,42,22,7,"PAH",103,1,8,0)="installation instructions."
^DIC(9.4,42,22,7,"PAH",103,1,9,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,10,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,11,0)="Patch Components:"
^DIC(9.4,42,22,7,"PAH",103,1,12,0)="-----------------"
^DIC(9.4,42,22,7,"PAH",103,1,13,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,14,0)="Files & Fields Associated:  N/A"
