^DIC(9.4,48,22,5.28,"PAH",608,1,4,0)="Added routines SDHL7APT & SDHL7APU for TMP-1449 PreProd reported null "
^DIC(9.4,48,22,5.28,"PAH",608,1,5,0)="subscript ien.  Also call ARSET^SDECAR2 instead of ARSET^SDHLAPT1 (which "
^DIC(9.4,48,22,5.28,"PAH",608,1,6,0)="was an old copy at one time ofr SDECAR2.  No one knows why the copy was "
^DIC(9.4,48,22,5.28,"PAH",608,1,7,0)="used since patch *714."
^DIC(9.4,48,22,5.28,"PAH",608,1,8,0)="subscript. Also use ARSET^SDECAR2 INSTFEAD OF AREST^SDHLAPT1, AN OLD COPY "
^DIC(9.4,48,22,5.28,"PAH",608,1,9,0)="OF SDECAR2 copy that"
^DIC(9.4,48,22,5.28,"PAH",608,1,10,0)="no one knows why it was used back in patch *714 and SDECAR2 has cahnged "
^DIC(9.4,48,22,5.28,"PAH",608,1,11,0)="since that time. TMP-1449 error reported by PrePod."
