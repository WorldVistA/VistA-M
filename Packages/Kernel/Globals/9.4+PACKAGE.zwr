^DIC(9.4,11,22,5.03,"PAH",36,0)="68 SEQ #56^3100716.092259^17"
^DIC(9.4,11,22,5.03,"PAH",36,1,0)="^^727^727^3100716"
^DIC(9.4,11,22,5.03,"PAH",36,1,1,0)="Blood Bank Clearance"
^DIC(9.4,11,22,5.03,"PAH",36,1,2,0)="===================="
^DIC(9.4,11,22,5.03,"PAH",36,1,3,0)="VISTA Laboratory Package patch LA*5.2*68 contains changes to software"
^DIC(9.4,11,22,5.03,"PAH",36,1,4,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",36,1,5,0)="Changes include: "
^DIC(9.4,11,22,5.03,"PAH",36,1,6,0)="    New style indexes have been created for the following sub-files"
^DIC(9.4,11,22,5.03,"PAH",36,1,7,0)="    of the LAB DATA file (#63):"
^DIC(9.4,11,22,5.03,"PAH",36,1,8,0)="        ELECTRON MICROSCOPY (#63.02)"
^DIC(9.4,11,22,5.03,"PAH",36,1,9,0)="        SURGICAL PATHOLOGY (#63.08)"
^DIC(9.4,11,22,5.03,"PAH",36,1,10,0)="        CYTOPATHOLOGY (#63.09)"
^DIC(9.4,11,22,5.03,"PAH",36,1,11,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,12,0)="All of the above changes have been reviewed by the VISTA Blood Bank"
^DIC(9.4,11,22,5.03,"PAH",36,1,13,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE"
^DIC(9.4,11,22,5.03,"PAH",36,1,14,0)="control functions."
^DIC(9.4,11,22,5.03,"PAH",36,1,15,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,16,0)="RISK ANALYSIS:   Changes made by patch LA*5.2*68 have no effect on Blood"
^DIC(9.4,11,22,5.03,"PAH",36,1,17,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",36,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,19,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS:  Patch LA*5.2*68 does not"
^DIC(9.4,11,22,5.03,"PAH",36,1,20,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,11,22,5.03,"PAH",36,1,21,0)="functions."
^DIC(9.4,11,22,5.03,"PAH",36,1,22,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,23,0)="POTENTIAL IMPACT ON SITES:  This patch contains changes to 0 routines and"
^DIC(9.4,11,22,5.03,"PAH",36,1,24,0)="1 file identified in Veterans Health Administration (VHA) Directive 99-053,"
^DIC(9.4,11,22,5.03,"PAH",36,1,25,0)="group B listing. The changes have no effect on Blood Bank functionality or"
^DIC(9.4,11,22,5.03,"PAH",36,1,26,0)="medical device control functions. There is no adverse potential to sites."
^DIC(9.4,11,22,5.03,"PAH",36,1,27,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,28,0)="========================================"
^DIC(9.4,11,22,5.03,"PAH",36,1,29,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,30,0)="This patch supports the VA Health Data Repository (HDR) effort,"
^DIC(9.4,11,22,5.03,"PAH",36,1,31,0)="allowing changes to LAB DATA file (#63) to be transmitted to the HDR "
^DIC(9.4,11,22,5.03,"PAH",36,1,32,0)="via a VistA Laboratory HL7 Result (ORU) message."
^DIC(9.4,11,22,5.03,"PAH",36,1,33,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,34,0)="Additionally, it provides the capability for the transmission of the HL7"
^DIC(9.4,11,22,5.03,"PAH",36,1,35,0)="ORU message containing patient laboratory results to subscribers of the HL7"
^DIC(9.4,11,22,5.03,"PAH",36,1,36,0)="event protocol LA7 LAB RESULTS AVAILABLE (EVN) as these results are made"
^DIC(9.4,11,22,5.03,"PAH",36,1,37,0)="available within the Laboratory package. The following subscripts are"
^DIC(9.4,11,22,5.03,"PAH",36,1,38,0)="supported by the event: ""CH"", ""MI"", ""SP"", ""CY"", ""EM"". See post-install"
^DIC(9.4,11,22,5.03,"PAH",36,1,39,0)="instructions for enabling this capability."
^DIC(9.4,11,22,5.03,"PAH",36,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,41,0)="  "
^DIC(9.4,11,22,5.03,"PAH",36,1,42,0)="****************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",36,1,43,0)="  "
^DIC(9.4,11,22,5.03,"PAH",36,1,44,0)="Patch LA*5.2*68 allows the HL7 ORU message containing patient laboratory "
^DIC(9.4,11,22,5.03,"PAH",36,1,45,0)="results to be transmitted to the subscriber, LA7 LAB RESULTS TO HDR "
^DIC(9.4,11,22,5.03,"PAH",36,1,46,0)="(SUB). This subscriber protocol is used to transmit laboratory results to "
^DIC(9.4,11,22,5.03,"PAH",36,1,47,0)="the VA HDR."
^DIC(9.4,11,22,5.03,"PAH",36,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,49,0)="The HDR Team will contact the Chief of IRM at each site to set up the "
^DIC(9.4,11,22,5.03,"PAH",36,1,50,0)="coordination of lab extraction (LA*5.2*68) and the activation of the "
^DIC(9.4,11,22,5.03,"PAH",36,1,51,0)="subscriber (HDR)."
^DIC(9.4,11,22,5.03,"PAH",36,1,52,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,53,0)="The coordination of extracting existing laboratory data (HDR historical) "
^DIC(9.4,11,22,5.03,"PAH",36,1,54,0)="and the configuration of the LA7 LAB RESULTS TO HDR (SUB) subscriber will "
^DIC(9.4,11,22,5.03,"PAH",36,1,55,0)="be started at the same time. This will ensure that there is an overlap of "
^DIC(9.4,11,22,5.03,"PAH",36,1,56,0)="laboratory results between the real time extraction of lab data and the "
^DIC(9.4,11,22,5.03,"PAH",36,1,57,0)="historical extraction of lab data."
^DIC(9.4,11,22,5.03,"PAH",36,1,58,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,59,0)="If a VA site activates the LA7 LAB RESULTS TO HDR (SUB) subscriber before "
^DIC(9.4,11,22,5.03,"PAH",36,1,60,0)="the historical extraction of existing laboratory data, the real time "
^DIC(9.4,11,22,5.03,"PAH",36,1,61,0)="extraction of lab data at the VA site may not be synchronized with the "
^DIC(9.4,11,22,5.03,"PAH",36,1,62,0)="HDR data."
^DIC(9.4,11,22,5.03,"PAH",36,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,64,0)="If you have questions regarding installation or implementation,"
^DIC(9.4,11,22,5.03,"PAH",36,1,65,0)="contact the HDR Project Office."
^DIC(9.4,11,22,5.03,"PAH",36,1,66,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,67,0)="Once the HDR Project Office confirms that installation and implementation "
^DIC(9.4,11,22,5.03,"PAH",36,1,68,0)="was accomplished successfully, you must log a Remedy ticket for any"
^DIC(9.4,11,22,5.03,"PAH",36,1,69,0)="subsequent problems encountered."
^DIC(9.4,11,22,5.03,"PAH",36,1,70,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,71,0)="*****************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",36,1,72,0)="  "
^DIC(9.4,11,22,5.03,"PAH",36,1,73,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,74,0)="1. The following protocols are added to the PROTOCOL file (#101)"
^DIC(9.4,11,22,5.03,"PAH",36,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,76,0)="NAME: LA7 LAB RESULTS ACTION"
^DIC(9.4,11,22,5.03,"PAH",36,1,77,0)="  ITEM TEXT: Lab process results for HL7 messaging"
^DIC(9.4,11,22,5.03,"PAH",36,1,78,0)="  TYPE: action                          "
^DIC(9.4,11,22,5.03,"PAH",36,1,79,0)="  PACKAGE: AUTOMATED LAB INSTRUMENTS"
^DIC(9.4,11,22,5.03,"PAH",36,1,80,0)=" DESCRIPTION:   Action protocol to setup sending lab results to HL7 message"
^DIC(9.4,11,22,5.03,"PAH",36,1,81,0)=" subscribers via protocol LA7 LAB RESULTS AVAILABLE (EVN) - Lab Results"
^DIC(9.4,11,22,5.03,"PAH",36,1,82,0)=" Available Event.  This protocol should be attached to protocol LAB RESULTS"
^DIC(9.4,11,22,5.03,"PAH",36,1,83,0)=" => EXTERNAL PACKAGE [LR7O ALL EVSEND RESULTS] which is an extended action"
^DIC(9.4,11,22,5.03,"PAH",36,1,84,0)=" protocol triggered by the lab result verification process."
^DIC(9.4,11,22,5.03,"PAH",36,1,85,0)="  ENTRY ACTION: D QUEUE^LA7HDR          TIMESTAMP: 59056,40855"
^DIC(9.4,11,22,5.03,"PAH",36,1,86,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,88,0)="NAME: LA7 LAB RESULTS AVAILABLE (EVN)  ITEM TEXT: Lab Results Available Event"
^DIC(9.4,11,22,5.03,"PAH",36,1,89,0)="  TYPE: event driver                   "
^DIC(9.4,11,22,5.03,"PAH",36,1,90,0)=" DESCRIPTION: A VistA Laboratory package HL7 ORU result message is created"
^DIC(9.4,11,22,5.03,"PAH",36,1,91,0)=" and sent by the HL package for transmission to any subscribers of event"
^DIC(9.4,11,22,5.03,"PAH",36,1,92,0)=" protocol LA7 LAB  RESULTS AVAILABLE (EVN)."
^DIC(9.4,11,22,5.03,"PAH",36,1,93,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,94,0)=" It provides the capability for the generation of a Laboratory HL7 ORU"
^DIC(9.4,11,22,5.03,"PAH",36,1,95,0)=" message containing patient laboratory results to subscribers of the HL7"
^DIC(9.4,11,22,5.03,"PAH",36,1,96,0)=" event protocol LA7 LAB RESULTS AVAILABLE (EVN) as these results are made"
^DIC(9.4,11,22,5.03,"PAH",36,1,97,0)=" available within the Laboratory package."
^DIC(9.4,11,22,5.03,"PAH",36,1,98,0)="  "
^DIC(9.4,11,22,5.03,"PAH",36,1,99,0)=" The following subscripts are supported by the event:"
^DIC(9.4,11,22,5.03,"PAH",36,1,100,0)="   ""CH"", ""MI"", ""SP"", ""CY"", ""EM""."
^DIC(9.4,11,22,5.03,"PAH",36,1,101,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,102,0)="  TIMESTAMP: 59725,36770                SENDING APPLICATION: LA7LAB"
^DIC(9.4,11,22,5.03,"PAH",36,1,103,0)="  TRANSACTION MESSAGE TYPE: ORU         EVENT TYPE: R01"
^DIC(9.4,11,22,5.03,"PAH",36,1,104,0)="  MESSAGE STRUCTURE: ORU_R01            ACCEPT ACK CODE: AL"
^DIC(9.4,11,22,5.03,"PAH",36,1,105,0)="  APPLICATION ACK TYPE: NE              VERSION ID: 2.4"
^DIC(9.4,11,22,5.03,"PAH",36,1,106,0)="  RESPONSE PROCESSING ROUTINE: D ACK^LA7VHL"
^DIC(9.4,11,22,5.03,"PAH",36,1,107,0)="SUBSCRIBERS: LA7 LAB RESULTS TO HDR (SUB)"
^DIC(9.4,11,22,5.03,"PAH",36,1,108,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,109,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,110,0)="NAME: LA7 LAB RESULTS TO HDR (SUB)      ITEM TEXT: Send Lab Results to HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,111,0)="  TYPE: subscriber                      "
^DIC(9.4,11,22,5.03,"PAH",36,1,112,0)=" DESCRIPTION:   This protocol should be attached to the HL7 event protocol"
^DIC(9.4,11,22,5.03,"PAH",36,1,113,0)=" LA7 LAB RESULTS AVAILABLE (EVN). See this protocol for further information."
^DIC(9.4,11,22,5.03,"PAH",36,1,114,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,115,0)=" This subscriber protocol is used by the Laboratory package to indicate to"
^DIC(9.4,11,22,5.03,"PAH",36,1,116,0)=" the HL package to send laboratory results to the VA Health Data Repository"
^DIC(9.4,11,22,5.03,"PAH",36,1,117,0)=" (HDR)."
^DIC(9.4,11,22,5.03,"PAH",36,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,119,0)=" It utilizes the ""Router"" Subscriber Protocol supported by the VistA HL"
^DIC(9.4,11,22,5.03,"PAH",36,1,120,0)=" package. The routing logic uses the value of the parameter passed into the"
^DIC(9.4,11,22,5.03,"PAH",36,1,121,0)=" router to determine which Laboratory package subscript should be sent to"
^DIC(9.4,11,22,5.03,"PAH",36,1,122,0)=" the HDR."
^DIC(9.4,11,22,5.03,"PAH",36,1,123,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,124,0)=" Examples:"
^DIC(9.4,11,22,5.03,"PAH",36,1,125,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,126,0)=" ROUTING LOGIC: D RTR^LA7HDR(""CH;"") will only send to HDR-IMS results"
^DIC(9.4,11,22,5.03,"PAH",36,1,127,0)=" associated with Laboratory ""CH"" subscript."
^DIC(9.4,11,22,5.03,"PAH",36,1,128,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,129,0)=" ROUTING LOGIC: D RTR^LA7HDR(""MI;"") will only send to HDR-IMS results"
^DIC(9.4,11,22,5.03,"PAH",36,1,130,0)=" associated with Laboratory ""MI"" subscript."
^DIC(9.4,11,22,5.03,"PAH",36,1,131,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,132,0)=" ROUTING LOGIC: D RTR^LA7HDR(""CH;MI;SP;"") will only send to HDR-IMS results"
^DIC(9.4,11,22,5.03,"PAH",36,1,133,0)=" associated with Laboratory ""CH"", ""MI"", and ""SP"" subscripts."
^DIC(9.4,11,22,5.03,"PAH",36,1,134,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,135,0)="  TIMESTAMP: 59056,40125                RECEIVING APPLICATION: LA7HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,136,0)="  EVENT TYPE: R01                       LOGICAL LINK: VDEFVIE4"
^DIC(9.4,11,22,5.03,"PAH",36,1,137,0)="  RESPONSE MESSAGE TYPE: ACK            SENDING FACILITY REQUIRED?: YES"
^DIC(9.4,11,22,5.03,"PAH",36,1,138,0)="  RECEIVING FACILITY REQUIRED?: YES     ROUTING LOGIC: D RTR^LA7HDR(""CH;"")"
^DIC(9.4,11,22,5.03,"PAH",36,1,139,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,140,0)=" NOTE: This subscriber protocol is distributed with the ROUTING LOGIC"
^DIC(9.4,11,22,5.03,"PAH",36,1,141,0)="       disabled. See post-installation instructions for guidance to"
^DIC(9.4,11,22,5.03,"PAH",36,1,142,0)="       enable the protocol."
^DIC(9.4,11,22,5.03,"PAH",36,1,143,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,144,0)="2. The following option is added to the OPTION file (#19)"
^DIC(9.4,11,22,5.03,"PAH",36,1,145,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,146,0)="NAME: LA7 HDR RECOVER    MENU TEXT: Recover/Transmit Lab HDR Result"
^DIC(9.4,11,22,5.03,"PAH",36,1,147,0)="Messages"
^DIC(9.4,11,22,5.03,"PAH",36,1,148,0)=" TYPE: run routine                                      "
^DIC(9.4,11,22,5.03,"PAH",36,1,149,0)=" PACKAGE: AUTOMATED LAB INSTRUMENTS"
^DIC(9.4,11,22,5.03,"PAH",36,1,150,0)=" DESCRIPTION:   Option to recover from failed Lab HDR ORU Result message "
^DIC(9.4,11,22,5.03,"PAH",36,1,151,0)="generation and/or transmission failure. This option allows the user to"
^DIC(9.4,11,22,5.03,"PAH",36,1,152,0)="select those VistA Laboratory accessions that need to be transmitted to"
^DIC(9.4,11,22,5.03,"PAH",36,1,153,0)="the VA HDR and other subscribers of the VistA Laboratory Result Available"
^DIC(9.4,11,22,5.03,"PAH",36,1,154,0)="HL7 message capability via the protocol Lab Results Available Event [LA7"
^DIC(9.4,11,22,5.03,"PAH",36,1,155,0)="LAB RESULTS AVAILABLE (EVN)]."
^DIC(9.4,11,22,5.03,"PAH",36,1,156,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,157,0)="If the original message generation/transmission failed due to system or "
^DIC(9.4,11,22,5.03,"PAH",36,1,158,0)="communication problems then using this option will allow the generation of"
^DIC(9.4,11,22,5.03,"PAH",36,1,159,0)="new HL7 messages with the results associated with the selected "
^DIC(9.4,11,22,5.03,"PAH",36,1,160,0)="accessions.  Accessions can be selected using the human-readable accession"
^DIC(9.4,11,22,5.03,"PAH",36,1,161,0)="designation (area abbreviation modified date accession number - ""CH 1225"
^DIC(9.4,11,22,5.03,"PAH",36,1,162,0)="100"") or the accession's associated 10 character unique identifier (UID)."
^DIC(9.4,11,22,5.03,"PAH",36,1,163,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,164,0)=" ROUTINE: RECOVER^LA7HDR "
^DIC(9.4,11,22,5.03,"PAH",36,1,165,0)=" UPPERCASE MENU TEXT: RECOVER/TRANSMIT LAB HDR RESUL"
^DIC(9.4,11,22,5.03,"PAH",36,1,166,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,167,0)="This option is assigned to the Lab liaison menu option [LRLIAISON] and"
^DIC(9.4,11,22,5.03,"PAH",36,1,168,0)="can be assigned to other uses as needed that support/monitor message "
^DIC(9.4,11,22,5.03,"PAH",36,1,169,0)="transmission to the VA HDR and other subscribers."
^DIC(9.4,11,22,5.03,"PAH",36,1,170,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,171,0)="3. The LA7HDR routine, if the configuration LA7HDR in LA7 MESSAGE"
^DIC(9.4,11,22,5.03,"PAH",36,1,172,0)="PARAMETER file (#62.48) has an active status, queues the record for"
^DIC(9.4,11,22,5.03,"PAH",36,1,173,0)="transmission to the HDR via a HL7 ORU result message which is transmitted"
^DIC(9.4,11,22,5.03,"PAH",36,1,174,0)="by the HL package to any subscribers of event protocol LA7 LAB RESULTS"
^DIC(9.4,11,22,5.03,"PAH",36,1,175,0)="AVAILABLE (EVN) in addition to the HDR subscriber LA7 LAB RESULTS TO HDR"
^DIC(9.4,11,22,5.03,"PAH",36,1,176,0)="(SUB)."
^DIC(9.4,11,22,5.03,"PAH",36,1,177,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,178,0)="   The LA7 LAB RESULTS TO HDR (SUB) subscriber protocol uses the logical"
^DIC(9.4,11,22,5.03,"PAH",36,1,179,0)="link VDEFVIE4. This is a router subscriber protocol which determines"
^DIC(9.4,11,22,5.03,"PAH",36,1,180,0)="which Lab HL7 messages are sent to the HDR. See protocol description"
^DIC(9.4,11,22,5.03,"PAH",36,1,181,0)="for further information."
^DIC(9.4,11,22,5.03,"PAH",36,1,182,0)="  "
^DIC(9.4,11,22,5.03,"PAH",36,1,183,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,184,0)="4. Anatomic Pathology is not ""CPRS-aware"" and is unable to notify CPRS of"
^DIC(9.4,11,22,5.03,"PAH",36,1,185,0)="release of anatomic pathology results. HDR will be notified of "
^DIC(9.4,11,22,5.03,"PAH",36,1,186,0)="availability of anatomic pathology results via three new-style"
^DIC(9.4,11,22,5.03,"PAH",36,1,187,0)="cross-references in LAB DATA file (#63). These indexes will also trigger"
^DIC(9.4,11,22,5.03,"PAH",36,1,188,0)="generation of the Lab HL7 ORU message if this capability has been enabled."
^DIC(9.4,11,22,5.03,"PAH",36,1,189,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,190,0)="   The three new cross-references are:"
^DIC(9.4,11,22,5.03,"PAH",36,1,191,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,192,0)="Subfile #63.02"
^DIC(9.4,11,22,5.03,"PAH",36,1,193,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,194,0)="  New-Style Indexes:"
^DIC(9.4,11,22,5.03,"PAH",36,1,195,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,196,0)="  AC (#98)    FIELD    MUMPS        ACTION"
^DIC(9.4,11,22,5.03,"PAH",36,1,197,0)="      Short Descr:  Notify HDR and others that this report is available."
^DIC(9.4,11,22,5.03,"PAH",36,1,198,0)="      Description:  This MUMPS cross-reference triggers the sending of this"
^DIC(9.4,11,22,5.03,"PAH",36,1,199,0)="                    report to the Health Data Repository (HDR) and other"
^DIC(9.4,11,22,5.03,"PAH",36,1,200,0)="                    subscribers when electron microscopy results are "
^DIC(9.4,11,22,5.03,"PAH",36,1,201,0)="                    released."
^DIC(9.4,11,22,5.03,"PAH",36,1,202,0)="        Set Logic:  D APQ^LA7HDR(DA(1),""EM"",DA)"
^DIC(9.4,11,22,5.03,"PAH",36,1,203,0)="       Kill Logic:  Q"
^DIC(9.4,11,22,5.03,"PAH",36,1,204,0)="             X(1):  REPORT RELEASE DATE (63.02,.11) (Subscr 1) (forwards)"
^DIC(9.4,11,22,5.03,"PAH",36,1,205,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,206,0)="Subfile #63.08"
^DIC(9.4,11,22,5.03,"PAH",36,1,207,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,208,0)="  New-Style Indexes:"
^DIC(9.4,11,22,5.03,"PAH",36,1,209,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,210,0)="  AD (#95)    FIELD    MUMPS        ACTION"
^DIC(9.4,11,22,5.03,"PAH",36,1,211,0)="      Short Descr:  Notify HDR and others that this report is available."
^DIC(9.4,11,22,5.03,"PAH",36,1,212,0)="      Description:  This MUMPS cross-reference triggers the sending of this"
^DIC(9.4,11,22,5.03,"PAH",36,1,213,0)="                    report to the Health Data Repository (HDR) and other"
^DIC(9.4,11,22,5.03,"PAH",36,1,214,0)="                    subscribers when surgical pathology results are "
^DIC(9.4,11,22,5.03,"PAH",36,1,215,0)="                    released."
^DIC(9.4,11,22,5.03,"PAH",36,1,216,0)="        Set Logic:  D APQ^LA7HDR(DA(1),""SP"",DA)"
^DIC(9.4,11,22,5.03,"PAH",36,1,217,0)="       Kill Logic:  Q"
^DIC(9.4,11,22,5.03,"PAH",36,1,218,0)="             X(1):  REPORT RELEASE DATE/TIME (63.08,.11) (Subscr 1)"
^DIC(9.4,11,22,5.03,"PAH",36,1,219,0)="                    (forwards)"
^DIC(9.4,11,22,5.03,"PAH",36,1,220,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,221,0)="Subfile #63.09"
^DIC(9.4,11,22,5.03,"PAH",36,1,222,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,223,0)="  New-Style Indexes:"
^DIC(9.4,11,22,5.03,"PAH",36,1,224,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,225,0)="  AD (#96)    FIELD    MUMPS        ACTION"
^DIC(9.4,11,22,5.03,"PAH",36,1,226,0)="      Short Descr:  Notify HDR and others that this report is available."
^DIC(9.4,11,22,5.03,"PAH",36,1,227,0)="      Description:  This MUMPS cross-reference triggers the sending of this"
^DIC(9.4,11,22,5.03,"PAH",36,1,228,0)="                    report to the Health Data Repository (HDR) and other"
^DIC(9.4,11,22,5.03,"PAH",36,1,229,0)="                    subscribers when cytology results are released."
^DIC(9.4,11,22,5.03,"PAH",36,1,230,0)="        Set Logic:  D APQ^LA7HDR(DA(1),""CY"",DA)"
^DIC(9.4,11,22,5.03,"PAH",36,1,231,0)="       Kill Logic:  Q"
^DIC(9.4,11,22,5.03,"PAH",36,1,232,0)="             X(1):  REPORT RELEASE DATE/TIME  (63.09,.11)  (Subscr 1)"
^DIC(9.4,11,22,5.03,"PAH",36,1,233,0)="                    (forwards) "
^DIC(9.4,11,22,5.03,"PAH",36,1,234,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,235,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,236,0)="5. Microbiology results. The current Laboratory package does not support"
^DIC(9.4,11,22,5.03,"PAH",36,1,237,0)="LOINC encoding of microbiology results. A default encoding is enabled"
^DIC(9.4,11,22,5.03,"PAH",36,1,238,0)="to LOINC encode standard microbiology tests and antibiotics."
^DIC(9.4,11,22,5.03,"PAH",36,1,239,0)="LOINC codes valid as of version 2.14."
^DIC(9.4,11,22,5.03,"PAH",36,1,240,0)="  "
^DIC(9.4,11,22,5.03,"PAH",36,1,241,0)="Default mapping of NLT/LOINC codes to standard fields within the "
^DIC(9.4,11,22,5.03,"PAH",36,1,242,0)="MICROBIOLOGY (#5) multiple of LAB DATA file (#63):"
