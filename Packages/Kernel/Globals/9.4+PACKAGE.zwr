^DIC(9.4,202,22,1,"PAH",2,1,117,0)="   RESPONSE PROTOCOL (#.02) File: MHV RESPONSE MAP (#2275.4)"
^DIC(9.4,202,22,1,"PAH",2,1,118,0)="   BUILDER ROUTINE (#.03)   File: MHV RESPONSE MAP (#2275.4)"
^DIC(9.4,202,22,1,"PAH",2,1,119,0)="   BOUNDARY SEGMENT (#.04)  File: MHV RESPONSE MAP (#2275.4)"
^DIC(9.4,202,22,1,"PAH",2,1,120,0)=" "
