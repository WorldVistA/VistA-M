^DIC(9.4,4,22,1,"PAH",27,1,26,0)="       Compare Transport Global to Current System "
^DIC(9.4,4,22,1,"PAH",27,1,27,0)="       Backup a Transport Global "
^DIC(9.4,4,22,1,"PAH",27,1,28,0)="       Install Package(s) "
