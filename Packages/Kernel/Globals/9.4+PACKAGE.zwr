^DIC(9.4,4,22,1,"PAH",67,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",67,1,6,0)="There's a strange problem with local mail delivery which sometimes occurs."
^DIC(9.4,4,22,1,"PAH",67,1,7,0)="It manifests itself in an undefined ^XMB(3.9,XMZ,3,0) in RDELIVER^XMTDL."
^DIC(9.4,4,22,1,"PAH",67,1,8,0)="This patch adds a variable which should aid in debugging."
^DIC(9.4,4,22,1,"PAH",67,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",67,1,10,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",67,1,11,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",67,1,12,0)="============================================================================ "
