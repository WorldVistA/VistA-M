^DIC(9.4,14,22,5.9,"PAH",278,1,319,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,320,0)="Pre-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",278,1,321,0)="-------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",278,1,322,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,14,22,5.9,"PAH",278,1,323,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,14,22,5.9,"PAH",278,1,324,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,14,22,5.9,"PAH",278,1,325,0)="minutes "
^DIC(9.4,14,22,5.9,"PAH",278,1,326,0)="to install"
^DIC(9.4,14,22,5.9,"PAH",278,1,327,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,328,0)="1.   The Laboratory ADPAC will need to create thirteen new lab tests to "
^DIC(9.4,14,22,5.9,"PAH",278,1,329,0)="      support the CPRS AP DIALOG functionality. These tests must be set up"
^DIC(9.4,14,22,5.9,"PAH",278,1,330,0)="     with a collection sample of AP SPECIMEN."
^DIC(9.4,14,22,5.9,"PAH",278,1,331,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,332,0)="     If the COLLECTION SAMPLE file does not have an AP SPECIMEN entry"
^DIC(9.4,14,22,5.9,"PAH",278,1,333,0)="    refer to Section 2.2 of the following document:"
^DIC(9.4,14,22,5.9,"PAH",278,1,334,0)="          LEDI IV Installation Guide (Lab_Ledi_IV_Install_Guide.pd)"
^DIC(9.4,14,22,5.9,"PAH",278,1,335,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,336,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,337,0)="2.   Add thirteen new tests to the LABORATORY TEST file. Below are"
^DIC(9.4,14,22,5.9,"PAH",278,1,338,0)="     examples of what the AP tests should look like in the LABORATORY TEST"
^DIC(9.4,14,22,5.9,"PAH",278,1,339,0)="     File (#60) once the entries have been created. "
^DIC(9.4,14,22,5.9,"PAH",278,1,340,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,341,0)="NOTE: Use the appropriate Institution(s) entries for your facility."
^DIC(9.4,14,22,5.9,"PAH",278,1,342,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,343,0)="WARNING: Make sure there are no other entries in the LABORATORY TEST file "
^DIC(9.4,14,22,5.9,"PAH",278,1,344,0)="that have the same name or synonym even though the subscript is"
^DIC(9.4,14,22,5.9,"PAH",278,1,345,0)="different. "
^DIC(9.4,14,22,5.9,"PAH",278,1,346,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,347,0)="For example:  If there is an existing Bone Marrow with Subscript of "
^DIC(9.4,14,22,5.9,"PAH",278,1,348,0)="'Cytology' then you may rename the test to 'Bone Marrow (Cytology)'."
^DIC(9.4,14,22,5.9,"PAH",278,1,349,0)="Also if there is a synonym of 'Bone Marrow' then you may rename it to"
^DIC(9.4,14,22,5.9,"PAH",278,1,350,0)="'Bone Marrow (CY)'."
^DIC(9.4,14,22,5.9,"PAH",278,1,351,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,352,0)="Set all tests up and TYPE NEITHER. When CPRS v32 is available you can "
^DIC(9.4,14,22,5.9,"PAH",278,1,353,0)="set the TYPE to BOTH."
^DIC(9.4,14,22,5.9,"PAH",278,1,354,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,355,0)="Workload code configuration should be done in compliance with your "
^DIC(9.4,14,22,5.9,"PAH",278,1,356,0)="current Laboratory practices."
^DIC(9.4,14,22,5.9,"PAH",278,1,357,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,358,0)="The PRINT NAME is not important and can be whatever you wish it to be."
^DIC(9.4,14,22,5.9,"PAH",278,1,359,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,360,0)="The ACCESSION AREA should be whatever is in use at your facility as long "
^DIC(9.4,14,22,5.9,"PAH",278,1,361,0)="as it is appropriate for the subscript of the test."
^DIC(9.4,14,22,5.9,"PAH",278,1,362,0)="LABORATORY TESTS (#60)"
^DIC(9.4,14,22,5.9,"PAH",278,1,363,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,364,0)="NAME: BONE MARROW                       TYPE: NEITHER"
^DIC(9.4,14,22,5.9,"PAH",278,1,365,0)="  SUBSCRIPT: SURGICAL PATHOLOGY         HIGHEST URGENCY ALLOWED: STAT"
^DIC(9.4,14,22,5.9,"PAH",278,1,366,0)="  REQUIRED COMMENT: ORDER COMMENT       COMBINE TEST DURING ORDER: NO"
^DIC(9.4,14,22,5.9,"PAH",278,1,367,0)="  PRINT NAME: BMARROW"
^DIC(9.4,14,22,5.9,"PAH",278,1,368,0)="COLLECTION SAMPLE: AP SPECIMEN"
^DIC(9.4,14,22,5.9,"PAH",278,1,369,0)="INSTITUTION: CAMP MASTER                ACCESSION AREA: SURGICAL PATHOLOGY"
^DIC(9.4,14,22,5.9,"PAH",278,1,370,0)="SITE NOTES DATE: MAY 03, 2016"
^DIC(9.4,14,22,5.9,"PAH",278,1,371,0)=" NOTE:   Test added in support of the VLE-AP order dialog enhancement "
^DIC(9.4,14,22,5.9,"PAH",278,1,372,0)="  NATIONAL VA LAB CODE: Surgical Pathology Tissue Exam"
^DIC(9.4,14,22,5.9,"PAH",278,1,373,0)="CPRS SCREEN: 118-BONE MARROW"
