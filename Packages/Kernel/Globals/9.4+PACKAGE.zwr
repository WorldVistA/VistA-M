^DIC(9.4,4,22,1,"PAH",110,1,32,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",110,1,33,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",110,1,34,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",110,1,35,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",110,1,36,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",110,1,37,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",110,1,38,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",110,1,39,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",110,1,40,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",110,1,41,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",110,1,42,0)=" Select INSTALL NAME:    XM*7.1*141    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",110,1,43,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",110,1,44,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",110,1,45,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",110,1,46,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",110,1,47,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",110,1,48,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",110,1,49,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",110,1,50,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",110,1,51,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",110,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",110,1,53,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",110,1,54,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",110,1,55,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",110,1,56,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",111,0)="140 SEQ #136^3000816^1"
^DIC(9.4,4,22,1,"PAH",111,1,0)="^^195^195^3000816"
^DIC(9.4,4,22,1,"PAH",111,1,1,0)="Patch XM*7.1*140"
^DIC(9.4,4,22,1,"PAH",111,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,3,0)="Test Sites:  Biloxi, MS; Houston, TX; San Francisco, CA"
^DIC(9.4,4,22,1,"PAH",111,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,5,0)="E3R 12694"
^DIC(9.4,4,22,1,"PAH",111,1,6,0)="Sites may choose where MailMan gets a user's title.  The following field"
^DIC(9.4,4,22,1,"PAH",111,1,7,0)="has been added to file 4.3, and option XMKSP has been updated to include it:"
^DIC(9.4,4,22,1,"PAH",111,1,8,0)="STANDARD DATA DICTIONARY #4.3 -- MAILMAN SITE PARAMETERS FILE"
^DIC(9.4,4,22,1,"PAH",111,1,9,0)="STORED IN ^XMB(1,  (1 ENTRY)"
^DIC(9.4,4,22,1,"PAH",111,1,10,0)="DATA       NAME                GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",111,1,11,0)="ELEMENT    TITLE               LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",111,1,12,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",111,1,13,0)="4.3,23     TITLE SOURCE        0;11 SET"
^DIC(9.4,4,22,1,"PAH",111,1,14,0)="                           'S' FOR SIGNATURE BLOCK TITLE; "
^DIC(9.4,4,22,1,"PAH",111,1,15,0)="                           'T' FOR TITLE; "
^DIC(9.4,4,22,1,"PAH",111,1,16,0)="           LAST EDITED:    JUL 18, 2000 "
^DIC(9.4,4,22,1,"PAH",111,1,17,0)="           HELP-PROMPT:    Where should the user's title come from? "
^DIC(9.4,4,22,1,"PAH",111,1,18,0)="           DESCRIPTION:    Where in the NEW PERSON file should the user's"
^DIC(9.4,4,22,1,"PAH",111,1,19,0)="                           title come from? "
^DIC(9.4,4,22,1,"PAH",111,1,20,0)="                            "
^DIC(9.4,4,22,1,"PAH",111,1,21,0)="                           Enter 'S' if the user's title should come from"
^DIC(9.4,4,22,1,"PAH",111,1,22,0)="                           field 20.3, SIGNATURE BLOCK TITLE.  If that"
^DIC(9.4,4,22,1,"PAH",111,1,23,0)="                           field is empty, then we'll try field 8, TITLE.  "
^DIC(9.4,4,22,1,"PAH",111,1,24,0)="                            "
^DIC(9.4,4,22,1,"PAH",111,1,25,0)="                           Enter 'T' if the user's title should come from"
^DIC(9.4,4,22,1,"PAH",111,1,26,0)="                           field 8, TITLE.  If that field is empty, we"
^DIC(9.4,4,22,1,"PAH",111,1,27,0)="                           won't show any title.  "
^DIC(9.4,4,22,1,"PAH",111,1,28,0)="                            "
^DIC(9.4,4,22,1,"PAH",111,1,29,0)="                           The default is 'T', if this field is not filled"
^DIC(9.4,4,22,1,"PAH",111,1,30,0)="                           in.  "
^DIC(9.4,4,22,1,"PAH",111,1,31,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,32,0)="E3R 13115"
^DIC(9.4,4,22,1,"PAH",111,1,33,0)="Users may choose in which order new messages should be read."
^DIC(9.4,4,22,1,"PAH",111,1,34,0)="New help frames (XM-U-P-OPTIONS-4, XM-U-P-NEW MESSAGES READ ORDER) have been"
^DIC(9.4,4,22,1,"PAH",111,1,35,0)="added, and related help frames updated.  The following field has been added"
^DIC(9.4,4,22,1,"PAH",111,1,36,0)="to file 3.7:"
^DIC(9.4,4,22,1,"PAH",111,1,37,0)="STANDARD DATA DICTIONARY #3.7 -- MAILBOX FILE"
^DIC(9.4,4,22,1,"PAH",111,1,38,0)="STORED IN ^XMB(3.7,"
^DIC(9.4,4,22,1,"PAH",111,1,39,0)="DATA       NAME                GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",111,1,40,0)="ELEMENT    TITLE               LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",111,1,41,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",111,1,42,0)="3.7,21     NEW MESSAGES READ ORDER 0;19 SET"
^DIC(9.4,4,22,1,"PAH",111,1,43,0)="                           'N' FOR Newest First; "
^DIC(9.4,4,22,1,"PAH",111,1,44,0)="                           'O' FOR Oldest First; "
^DIC(9.4,4,22,1,"PAH",111,1,45,0)="           LAST EDITED:    JUL 19, 2000 "
^DIC(9.4,4,22,1,"PAH",111,1,46,0)="           HELP-PROMPT:    In which order do you want to read your new "
^DIC(9.4,4,22,1,"PAH",111,1,47,0)="                           messages? "
^DIC(9.4,4,22,1,"PAH",111,1,48,0)="           DESCRIPTION:    'Newest First' means new messages are read in"
^DIC(9.4,4,22,1,"PAH",111,1,49,0)="                           reverse order.  'Oldest First' means new"
^DIC(9.4,4,22,1,"PAH",111,1,50,0)="                           messages are read in the order in which they"
^DIC(9.4,4,22,1,"PAH",111,1,51,0)="                           were sent.  "
^DIC(9.4,4,22,1,"PAH",111,1,52,0)="                           If you don't choose, your new messages will be"
^DIC(9.4,4,22,1,"PAH",111,1,53,0)="                           read 'Oldest First'.  "
^DIC(9.4,4,22,1,"PAH",111,1,54,0)="                           Note: When you display a list of new messages,"
^DIC(9.4,4,22,1,"PAH",111,1,55,0)="                           they will be displayed in the order you"
^DIC(9.4,4,22,1,"PAH",111,1,56,0)="                           selected in the field 'MESSAGE ORDER'. "
^DIC(9.4,4,22,1,"PAH",111,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,58,0)="E3R 14123"
^DIC(9.4,4,22,1,"PAH",111,1,59,0)="Users may choose the default selection to the prompt which appears with"
^DIC(9.4,4,22,1,"PAH",111,1,60,0)="the 'New Messages and Responses' option.  A new help frame (XM-U-P-NEW"
^DIC(9.4,4,22,1,"PAH",111,1,61,0)="MESSAGES OPTION) has been added, and related help frames updated.  The"
^DIC(9.4,4,22,1,"PAH",111,1,62,0)="following field has been added to file 3.7, and is available for editing"
^DIC(9.4,4,22,1,"PAH",111,1,63,0)="under 'Personal Preferences|"
^DIC(9.4,4,22,1,"PAH",111,1,64,0)="User Options Edit'."
^DIC(9.4,4,22,1,"PAH",111,1,65,0)="STANDARD DATA DICTIONARY #3.7 -- MAILBOX FILE"
^DIC(9.4,4,22,1,"PAH",111,1,66,0)="STORED IN ^XMB(3.7,"
^DIC(9.4,4,22,1,"PAH",111,1,67,0)="DATA       NAME                GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",111,1,68,0)="ELEMENT    TITLE               LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",111,1,69,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",111,1,70,0)="3.7,20     NEW MESSAGES DEFAULT OPTION 0;18 SET"
^DIC(9.4,4,22,1,"PAH",111,1,71,0)="                           'LB' FOR LIST BASKETS WITH NEW MAIL; "
^DIC(9.4,4,22,1,"PAH",111,1,72,0)="                           'LN' FOR LIST ALL NEW MESSAGES; "
^DIC(9.4,4,22,1,"PAH",111,1,73,0)="                           'P' FOR PRINT ALL NEW MESSAGES; "
^DIC(9.4,4,22,1,"PAH",111,1,74,0)="                           'R' FOR READ NEW MAIL BY BASKET; "
^DIC(9.4,4,22,1,"PAH",111,1,75,0)="           LAST EDITED:    JUL 17, 2000 "
^DIC(9.4,4,22,1,"PAH",111,1,76,0)="           HELP-PROMPT:    Select default new messages option "
^DIC(9.4,4,22,1,"PAH",111,1,77,0)="           DESCRIPTION:    This is the default choice which will appear"
^DIC(9.4,4,22,1,"PAH",111,1,78,0)="                           when you select the 'New Messages and"
^DIC(9.4,4,22,1,"PAH",111,1,79,0)="                           Responses' option.  "
^DIC(9.4,4,22,1,"PAH",111,1,80,0)="                           If you don't choose a default, the default will"
^DIC(9.4,4,22,1,"PAH",111,1,81,0)="                           be 'Read new mail by basket'.  "
^DIC(9.4,4,22,1,"PAH",111,1,82,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,83,0)="Also, when the user chooses to read new mail by basket, the user may have"
^DIC(9.4,4,22,1,"PAH",111,1,84,0)="basket(s) other than the IN basket presented as the default basket(s) from"
^DIC(9.4,4,22,1,"PAH",111,1,85,0)="which to read.  A new help frame (XM-U-P-READ NEW MSGS BSKT) has been added,"
^DIC(9.4,4,22,1,"PAH",111,1,86,0)="and related help frames updated.  The following field has been added to the"
^DIC(9.4,4,22,1,"PAH",111,1,87,0)="BASKET subfile of file 3.7, and is available for editing under"
^DIC(9.4,4,22,1,"PAH",111,1,88,0)="'Personal Preferences|User Options Edit'. "
^DIC(9.4,4,22,1,"PAH",111,1,89,0)="STANDARD DATA DICTIONARY #3.7 -- MAILBOX FILE"
^DIC(9.4,4,22,1,"PAH",111,1,90,0)="STANDARD DATA DICTIONARY #3.701 -- BASKET SUB-FILE"
^DIC(9.4,4,22,1,"PAH",111,1,91,0)="STORED IN ^XMB(3.7,"
^DIC(9.4,4,22,1,"PAH",111,1,92,0)="DATA       NAME                GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",111,1,93,0)="ELEMENT    TITLE               LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",111,1,94,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",111,1,95,0)="3.701,4    READ NEW MSGS BASKET PRIORITY 0;4 NUMBER"
^DIC(9.4,4,22,1,"PAH",111,1,96,0)="           Read new messages basket priority"
^DIC(9.4,4,22,1,"PAH",111,1,97,0)="           INPUT TRANSFORM:  K:+X'=X!(X>99)!(X<1)!(X?.E1"".""1N.N) X"
^DIC(9.4,4,22,1,"PAH",111,1,98,0)="           LAST EDITED:    JUL 19, 2000 "
^DIC(9.4,4,22,1,"PAH",111,1,99,0)="           HELP-PROMPT:    Type a Number between 1 and 99, 0 Decimal "
^DIC(9.4,4,22,1,"PAH",111,1,100,0)="                           Digits "
^DIC(9.4,4,22,1,"PAH",111,1,101,0)="           DESCRIPTION:    When you read new messages by basket, MailMan"
^DIC(9.4,4,22,1,"PAH",111,1,102,0)="                           suggests the IN basket to read first.  If you"
^DIC(9.4,4,22,1,"PAH",111,1,103,0)="                           want MailMan to suggest other basket(s) before "
^DIC(9.4,4,22,1,"PAH",111,1,104,0)="                           suggesting the IN basket, then fill in this"
^DIC(9.4,4,22,1,"PAH",111,1,105,0)="                           field with a priority order number.  MailMan"
^DIC(9.4,4,22,1,"PAH",111,1,106,0)="                           will suggest the basket(s) in the priority"
^DIC(9.4,4,22,1,"PAH",111,1,107,0)="                           order set by you.  The IN basket will be"
^DIC(9.4,4,22,1,"PAH",111,1,108,0)="                           suggested last.  (You will not be able to"
^DIC(9.4,4,22,1,"PAH",111,1,109,0)="                           choose the IN basket.)  Once all the priority"
^DIC(9.4,4,22,1,"PAH",111,1,110,0)="                           baskets have been read, MailMan will suggest"
^DIC(9.4,4,22,1,"PAH",111,1,111,0)="                           baskets in alphabetical order. "
^DIC(9.4,4,22,1,"PAH",111,1,112,0)="            CROSS-REFERENCE:  3.701^AP "
^DIC(9.4,4,22,1,"PAH",111,1,113,0)="                             1)= S ^XMB(3.7,DA(1),2,""AP"",$E(X,1,30),DA)="""""
^DIC(9.4,4,22,1,"PAH",111,1,114,0)="                             2)= K ^XMB(3.7,DA(1),2,""AP"",$E(X,1,30),DA)"
^DIC(9.4,4,22,1,"PAH",111,1,115,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,116,0)="Additionally:"
^DIC(9.4,4,22,1,"PAH",111,1,117,0)="-When sending or forwarding a message using one of the ^XMD APIs, and there"
^DIC(9.4,4,22,1,"PAH",111,1,118,0)="are no recipients, XMMG is set to ""Error = No recipients.""  Previously,"
^DIC(9.4,4,22,1,"PAH",111,1,119,0)="there was no error message."
^DIC(9.4,4,22,1,"PAH",111,1,120,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,121,0)="-MailMan's version of FileMan's ^DIR 'set of codes' reader has been improved."
^DIC(9.4,4,22,1,"PAH",111,1,122,0)="It now offers selection completion and understands either the code or the"
^DIC(9.4,4,22,1,"PAH",111,1,123,0)="text, and asks for clarification if the user enters something ambiguous."
^DIC(9.4,4,22,1,"PAH",111,1,124,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,125,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",111,1,126,0)="is at a minimum.  It requires MailMan patch XM*7.1*131."
^DIC(9.4,4,22,1,"PAH",111,1,127,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",111,1,128,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,129,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",111,1,130,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",111,1,131,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",111,1,132,0)=" "
^DIC(9.4,4,22,1,"PAH",111,1,133,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",111,1,134,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",111,1,135,0)="-----------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",111,1,136,0)="XM            11416143        10976819        17,35,50,140"
^DIC(9.4,4,22,1,"PAH",111,1,137,0)="XMD            7425316         7686115        33,50,98,103,107,140"
^DIC(9.4,4,22,1,"PAH",111,1,138,0)="XMGAPI4        4204061         5089993        50,140"
^DIC(9.4,4,22,1,"PAH",111,1,139,0)="XMJBM1         4157424         3151843        50,140"
^DIC(9.4,4,22,1,"PAH",111,1,140,0)="XMJBN         10390839        15626783        50,100,140"
^DIC(9.4,4,22,1,"PAH",111,1,141,0)="XMJBU          1507122         2739459        50,140"
^DIC(9.4,4,22,1,"PAH",111,1,142,0)="XMJDIR         5974273         6074159        50,110,140"
^DIC(9.4,4,22,1,"PAH",111,1,143,0)="XMVVITA        4785601         7287397        50,101,110,140"
^DIC(9.4,4,22,1,"PAH",111,1,144,0)="XMVVITAE      10408258        11186176        50,74,107,140"
^DIC(9.4,4,22,1,"PAH",111,1,145,0)="XMXUTIL       12222792        12959022        40,50,107,127,131,140"
^DIC(9.4,4,22,1,"PAH",111,1,146,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",111,1,147,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,148,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",111,1,149,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",111,1,150,0)=" "
^DIC(9.4,4,22,1,"PAH",111,1,151,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",111,1,152,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",111,1,153,0)="is at a minimum.  It requires MailMan patch XM*7.1*131."
^DIC(9.4,4,22,1,"PAH",111,1,154,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",111,1,155,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",111,1,156,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",111,1,157,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",111,1,158,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",111,1,159,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",111,1,160,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",111,1,161,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",111,1,162,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",111,1,163,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",111,1,164,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",111,1,165,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",111,1,166,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",111,1,167,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",111,1,168,0)=" Select INSTALL NAME:    XM*7.1*140    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",111,1,169,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",111,1,170,0)=" Checking Install for Package XM*7.1*140"
^DIC(9.4,4,22,1,"PAH",111,1,171,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,172,0)=" Install Questions for XM*7.1*140"
^DIC(9.4,4,22,1,"PAH",111,1,173,0)=""
^DIC(9.4,4,22,1,"PAH",111,1,174,0)=" Incoming Files:"
^DIC(9.4,4,22,1,"PAH",111,1,175,0)=""
