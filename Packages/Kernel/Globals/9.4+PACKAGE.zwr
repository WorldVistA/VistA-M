^DIC(9.4,175,22,2,"PAH",107,1,0)="^^17^17^3170207"
^DIC(9.4,175,22,2,"PAH",107,1,1,0)="VistA Imaging V3.0 Patch 161 - Patch 138 Follow Up"
^DIC(9.4,175,22,2,"PAH",107,1,2,0)="Patch 161 is the Patch 138 (MegaPatch) follow up."
^DIC(9.4,175,22,2,"PAH",107,1,3,0)="It includes : "
^DIC(9.4,175,22,2,"PAH",107,1,4,0)="   - Patch 130 Display Client (Harris patch)"
^DIC(9.4,175,22,2,"PAH",107,1,5,0)="   - Patch 149 Display Client (Mantech/7Delta patch)"
^DIC(9.4,175,22,2,"PAH",107,1,6,0)="   - Fix for Radiology Images that don't display in RadViewer."
^DIC(9.4,175,22,2,"PAH",107,1,7,0)="   - Fix to correctly upload SCU_LIST.DIC changes to VistA."
^DIC(9.4,175,22,2,"PAH",107,1,8,0)="   - - - - "
^DIC(9.4,175,22,2,"PAH",107,1,9,0)="This patch is to be installed After Patch 138."
^DIC(9.4,175,22,2,"PAH",107,1,10,0)="This patch is also to be installed After Patch 156."
^DIC(9.4,175,22,2,"PAH",107,1,11,0)="    "
^DIC(9.4,175,22,2,"PAH",107,1,12,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",107,1,13,0)="Select BUILD NAME:    MAG*3.0*161     IMAGING"
^DIC(9.4,175,22,2,"PAH",107,1,14,0)="MAGDRPC8  value = 64895858"
^DIC(9.4,175,22,2,"PAH",107,1,15,0)="MAGGTU4D  value = 5312177"
^DIC(9.4,175,22,2,"PAH",107,1,16,0)="MAGIP161  value = 4214969"
