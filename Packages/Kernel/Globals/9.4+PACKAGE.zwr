^DIC(9.4,44,22,3,"PAH",102,1,180,0)="Software being released as a Packman Message."
^DIC(9.4,44,22,3,"PAH",102,1,181,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,182,0)="There are no files or KIDs builds to acquire. "
^DIC(9.4,44,22,3,"PAH",102,1,183,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,184,0)="Documentation for the DST GUI can be found on the VA Software "
^DIC(9.4,44,22,3,"PAH",102,1,185,0)="Documentation Library at: http://www.domain.ext/vdl/"
^DIC(9.4,44,22,3,"PAH",102,1,186,0)=" "
