^DIC(9.4,60,22,13,"PAH",584,1,281,0)="  ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",584,1,282,0)="   The content of the Drug Validation screen was completely re-arranged to"
^DIC(9.4,60,22,13,"PAH",584,1,283,0)="   show the eRx Drug information and the VistA corresponding fields in a "
^DIC(9.4,60,22,13,"PAH",584,1,284,0)="   side-by-side arrangement. In addition, the eRx Patient allergy list "
^DIC(9.4,60,22,13,"PAH",584,1,285,0)="   (received from the outside prescriber) will be displayed as well as the"
^DIC(9.4,60,22,13,"PAH",584,1,286,0)="   list of allergies from the VistA patient."
^DIC(9.4,60,22,13,"PAH",584,1,287,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,288,0)="   Besides displaying the information side-by-side, a few other features were"
^DIC(9.4,60,22,13,"PAH",584,1,289,0)="   introduced to make the screen more user friendly, such as:"
^DIC(9.4,60,22,13,"PAH",584,1,290,0)="     a) When there is a mismatch for field (e.g., Drug Name, Qty, etc.) the "
^DIC(9.4,60,22,13,"PAH",584,1,291,0)="        content of such field will display in reverse video for both fields,"
^DIC(9.4,60,22,13,"PAH",584,1,292,0)="        eRx and VistA."
^DIC(9.4,60,22,13,"PAH",584,1,293,0)="     b) The content will display in highlight in order to stand from the field"
^DIC(9.4,60,22,13,"PAH",584,1,294,0)="        label. "
^DIC(9.4,60,22,13,"PAH",584,1,295,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,296,0)="     Obs) These features depend on the terminal display settings being set"
^DIC(9.4,60,22,13,"PAH",584,1,297,0)="          differently for reverse video and highlighted font in order for it"
^DIC(9.4,60,22,13,"PAH",584,1,298,0)="          to work."
^DIC(9.4,60,22,13,"PAH",584,1,299,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,300,0)="     Below is an example of how the new screen will be displayed (without the"
^DIC(9.4,60,22,13,"PAH",584,1,301,0)="     reverse or highlighted video features):"
^DIC(9.4,60,22,13,"PAH",584,1,302,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,303,0)="     Drug Validation      Aug 18, 2023@13:58:45          Page:    1 of    3 "
^DIC(9.4,60,22,13,"PAH",584,1,304,0)="     eRx Reference #: 123211        Date Written: 8/10/23    Effective Date: "
^DIC(9.4,60,22,13,"PAH",584,1,305,0)="     Status: MANUALLY-MATCHED                                                        "
^DIC(9.4,60,22,13,"PAH",584,1,306,0)="                     ERX MED         |               VISTA MED                "
^DIC(9.4,60,22,13,"PAH",584,1,307,0)="     Allergy:                        |Allergy:                                "
^DIC(9.4,60,22,13,"PAH",584,1,308,0)="      NO ALLERGY INFORMATION RECEIVED| NO KNOWN ALLERGIES                     "
^DIC(9.4,60,22,13,"PAH",584,1,309,0)="     ________________________________|_____________________________________"
^DIC(9.4,60,22,13,"PAH",584,1,310,0)="     Drug: BREZTRI AEROSPHERE 160 MCG|1)Drug: BREZTRI AEROSPHERE 160 MCG    "
