^DIC(9.4,4,22,1,"PAH",43,1,576,0)="             $$MAXBLANK  Reduce 3 or more consecutive blanks to 2"
^DIC(9.4,4,22,1,"PAH",43,1,577,0)="             $$MELD      Combine string and number"
^DIC(9.4,4,22,1,"PAH",43,1,578,0)="             $$MMDT      Convert FileMan date/time to MailMan date/time"
^DIC(9.4,4,22,1,"PAH",43,1,579,0)="             $$SCRUB     Strip control characters and leading/trailing blanks"
^DIC(9.4,4,22,1,"PAH",43,1,580,0)="             $$STRIP     Strip leading/trailing blanks"
^DIC(9.4,4,22,1,"PAH",43,1,581,0)="             $$TIMEDIFF  Decimal time difference to +-HHMM"
^DIC(9.4,4,22,1,"PAH",43,1,582,0)="             $$TSTAMP    Time stamp"
^DIC(9.4,4,22,1,"PAH",43,1,583,0)="             $$ZONEDIFF  +-HHMM from another time zone"
^DIC(9.4,4,22,1,"PAH",43,1,584,0)="XMXUTIL2     $$BSKT      Which basket is message in?"
^DIC(9.4,4,22,1,"PAH",43,1,585,0)="             $$DATE      Get message date."
^DIC(9.4,4,22,1,"PAH",43,1,586,0)="             $$FROM      Get message from."
^DIC(9.4,4,22,1,"PAH",43,1,587,0)="             $$KSEQN     Get message sequence number in user's basket."
^DIC(9.4,4,22,1,"PAH",43,1,588,0)="             $$LINE      How many lines are in the message?"
^DIC(9.4,4,22,1,"PAH",43,1,589,0)="             $$NEW       Is this message new for this user?"
^DIC(9.4,4,22,1,"PAH",43,1,590,0)="             $$PRI       Is this message priority?"
^DIC(9.4,4,22,1,"PAH",43,1,591,0)="             $$QRESP     Is this a response?"
