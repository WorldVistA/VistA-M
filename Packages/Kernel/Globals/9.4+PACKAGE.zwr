^DIC(9.4,73,22,9,"PAH",16,1,96,0)="   Installation Instructions:"
^DIC(9.4,73,22,9,"PAH",16,1,97,0)="   =========================="
^DIC(9.4,73,22,9,"PAH",16,1,98,0)="  "
^DIC(9.4,73,22,9,"PAH",16,1,99,0)="   1. Users ARE allowed to be on the system during the installation."
^DIC(9.4,73,22,9,"PAH",16,1,100,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,101,0)="   2. DSM/AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,73,22,9,"PAH",16,1,102,0)="      routines in the Routine Summary section are mapped, disable"
^DIC(9.4,73,22,9,"PAH",16,1,103,0)="      mapping for the affected routine."
^DIC(9.4,73,22,9,"PAH",16,1,104,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,105,0)="   3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu."
^DIC(9.4,73,22,9,"PAH",16,1,106,0)="      This loads the patch into a Transport Global onto your system."
^DIC(9.4,73,22,9,"PAH",16,1,107,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,108,0)="   4. You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,73,22,9,"PAH",16,1,109,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,110,0)="   5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,73,22,9,"PAH",16,1,111,0)="      following options to install the Transport Global:"
^DIC(9.4,73,22,9,"PAH",16,1,112,0)="         Verify Checksums in Transport Global"
^DIC(9.4,73,22,9,"PAH",16,1,113,0)="         Print Transport Global"
^DIC(9.4,73,22,9,"PAH",16,1,114,0)="         Compare Transport Global to Current System"
^DIC(9.4,73,22,9,"PAH",16,1,115,0)="         Backup a Transport Global"
^DIC(9.4,73,22,9,"PAH",16,1,116,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,117,0)="         Install Package(s)"
^DIC(9.4,73,22,9,"PAH",16,1,118,0)="             INSTALL NAME: AFJX*5.1*26"
^DIC(9.4,73,22,9,"PAH",16,1,119,0)="                           ==========="
^DIC(9.4,73,22,9,"PAH",16,1,120,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,121,0)="         Want KIDS to Rebuild Menu Tree Upon Completion of Install?? Yes//"
^DIC(9.4,73,22,9,"PAH",16,1,122,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,123,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,124,0)="         Want KIDS to INHIBIT LOGONs during the install?  YES// NO"
^DIC(9.4,73,22,9,"PAH",16,1,125,0)="                                                               ===="
^DIC(9.4,73,22,9,"PAH",16,1,126,0)="         Want to DISABLE Scheduled Options,  Menu Options, and"
^DIC(9.4,73,22,9,"PAH",16,1,127,0)="           Protocols?  YES//"
^DIC(9.4,73,22,9,"PAH",16,1,128,0)="                       ===="
^DIC(9.4,73,22,9,"PAH",16,1,129,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,130,0)="              Enter options you wish to mark as 'Out"
^DIC(9.4,73,22,9,"PAH",16,1,131,0)="                      Of Order':   AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",16,1,132,0)="                                   ================"
^DIC(9.4,73,22,9,"PAH",16,1,133,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,134,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,135,0)="   6.  DSM/AXP Sites - Answer NO to the question ""Want to MOVE"
^DIC(9.4,73,22,9,"PAH",16,1,136,0)="        routines to other CPUs?"""
^DIC(9.4,73,22,9,"PAH",16,1,137,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,138,0)="   7.  DSM/AXP sites:  If the routines were unmapped, the mapped"
^DIC(9.4,73,22,9,"PAH",16,1,139,0)="       set should be rebuilt once the installation has run"
^DIC(9.4,73,22,9,"PAH",16,1,140,0)="       to completion."
