^DIC(9.4,11,22,5.03,"PAH",22,1,47,0)=""
^DIC(9.4,11,22,5.03,"PAH",22,1,48,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",22,1,49,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",22,1,50,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",22,1,51,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",22,1,52,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",22,1,53,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,54,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",22,1,55,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",22,1,56,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",22,1,57,0)="   LA59             N/A            7061351        **59** (Deleted by KIDS)"
^DIC(9.4,11,22,5.03,"PAH",22,1,58,0)="   LA7UIIN1         5544723        5541384        **17,23,27,57,59**"
^DIC(9.4,11,22,5.03,"PAH",22,1,59,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,60,0)=" List of preceding patches: 57"
^DIC(9.4,11,22,5.03,"PAH",22,1,61,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,11,22,5.03,"PAH",22,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,63,0)="  "
^DIC(9.4,11,22,5.03,"PAH",22,1,64,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",22,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,66,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",22,1,67,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",22,1,68,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,69,0)="  The install time for this patch is less than 2 minutes. This patch"
^DIC(9.4,11,22,5.03,"PAH",22,1,70,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",22,1,71,0)="  Suggested time to install: non-peak hours."
^DIC(9.4,11,22,5.03,"PAH",22,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,73,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,74,0)="NOTE: Kernel, MailMan and HL7 patches must be current on the target system"
^DIC(9.4,11,22,5.03,"PAH",22,1,75,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",22,1,76,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,77,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",22,1,78,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",22,1,79,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,80,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,81,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",22,1,82,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,83,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",22,1,84,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",22,1,85,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,86,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",22,1,87,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",22,1,88,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,89,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",22,1,90,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",22,1,91,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,92,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",22,1,93,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",22,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,95,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",22,1,96,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",22,1,97,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",22,1,98,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",22,1,99,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",22,1,100,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,101,0)="      If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,11,22,5.03,"PAH",22,1,102,0)="      prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,11,22,5.03,"PAH",22,1,103,0)="      option at this time.  You may also compare the routines in your"
^DIC(9.4,11,22,5.03,"PAH",22,1,104,0)="      production account to the routines in the patch by using the 'Compare"
^DIC(9.4,11,22,5.03,"PAH",22,1,105,0)="      a Transport Global to Current System' option."
^DIC(9.4,11,22,5.03,"PAH",22,1,106,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,107,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,108,0)="  7.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",22,1,109,0)="      and select the package 'LA*5.2*59'.  When prompted 'Want KIDS to"
^DIC(9.4,11,22,5.03,"PAH",22,1,110,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,11,22,5.03,"PAH",22,1,111,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,11,22,5.03,"PAH",22,1,112,0)="      YES//', choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",22,1,113,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,114,0)="  8. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",22,1,115,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,116,0)="  9. Routine LA59 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",22,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,119,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,11,22,5.03,"PAH",22,1,120,0)="==============================="
^DIC(9.4,11,22,5.03,"PAH",22,1,121,0)=""
^DIC(9.4,11,22,5.03,"PAH",22,1,122,0)="None"
^DIC(9.4,11,22,5.03,"PAH",22,1,123,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,124,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,125,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",22,1,126,0)="Installation example:"
^DIC(9.4,11,22,5.03,"PAH",22,1,127,0)=""
^DIC(9.4,11,22,5.03,"PAH",22,1,128,0)="Select Installation Option: 6  Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",22,1,129,0)="Select INSTALL NAME:  LA*5.2*59  Loaded from Distribution 4/24/01@13:29:16"
