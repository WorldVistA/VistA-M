^DIC(9.4,111,22,1,"PAH",7,1,1,0)="Patch 2 for PCE Patient Care Encounter 1.0"
^DIC(9.4,111,22,1,"PAH",7,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",7,1,3,0)="Efficiency improvments in PCE's Clinical Reminders."
^DIC(9.4,111,22,1,"PAH",7,1,4,0)=" "
^DIC(9.4,111,22,1,"PAH",7,1,5,0)="Changes to the logic to allow taxonomy findings be used in the date due"
^DIC(9.4,111,22,1,"PAH",7,1,6,0)="calculation.  The logic for computed findings, health factors, and taxonomies"
^DIC(9.4,111,22,1,"PAH",7,1,7,0)="was changed so that a frequency must be specified in order to use anyone of"
^DIC(9.4,111,22,1,"PAH",7,1,8,0)="these findings to change minimum age and maximum age."
^DIC(9.4,111,22,1,"PAH",7,1,9,0)=""
^DIC(9.4,111,22,1,"PAH",7,1,10,0)="See National Patch Module for a description of the changes incorporated in"
