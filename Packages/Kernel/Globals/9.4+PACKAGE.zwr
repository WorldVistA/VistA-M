^DIC(9.4,100,22,15,"PAH",51,1,96,0)="   ROUTINE SUMMARY"
^DIC(9.4,100,22,15,"PAH",51,1,97,0)="   ==============="
^DIC(9.4,100,22,15,"PAH",51,1,98,0)="   The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",51,1,99,0)="   <tab>   ;;5.01;MENTAL HEALTH;**[Patch List]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",51,1,100,0)="  "
^DIC(9.4,100,22,15,"PAH",51,1,101,0)="                                 Checksum Values"
^DIC(9.4,100,22,15,"PAH",51,1,102,0)="   Routine Name   Before Patch    After Patch     Patch List"
^DIC(9.4,100,22,15,"PAH",51,1,103,0)="   ------------   ------------    -----------     ----------"
^DIC(9.4,100,22,15,"PAH",51,1,104,0)="   YSTUSE             N/A         1776923         87"
^DIC(9.4,100,22,15,"PAH",51,1,105,0)="   YTSTAT         5120372         N/A - Deleted during the install"
^DIC(9.4,100,22,15,"PAH",51,1,106,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,107,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,108,0)="    Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",51,1,109,0)="    =========================="
^DIC(9.4,100,22,15,"PAH",51,1,110,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,111,0)="    1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",51,1,112,0)="       This option will load the KIDS package in this message onto "
^DIC(9.4,100,22,15,"PAH",51,1,113,0)="       your system."
^DIC(9.4,100,22,15,"PAH",51,1,114,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,115,0)="    2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",51,1,116,0)="       system. You now need to use KIDS to install the Transport"
^DIC(9.4,100,22,15,"PAH",51,1,117,0)="       global. On the KIDS menu, under the 'Installation' menu, use"
^DIC(9.4,100,22,15,"PAH",51,1,118,0)="       the following options:"
^DIC(9.4,100,22,15,"PAH",51,1,119,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,120,0)="                  Print Transport Global"
^DIC(9.4,100,22,15,"PAH",51,1,121,0)="                  Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",51,1,122,0)="                  Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",51,1,123,0)="                  Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",51,1,124,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,125,0)="    3. Installation of this patch should be at off peak hours."
^DIC(9.4,100,22,15,"PAH",51,1,126,0)="  "
^DIC(9.4,100,22,15,"PAH",51,1,127,0)="    4. Users may remain on the system."
^DIC(9.4,100,22,15,"PAH",51,1,128,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,129,0)="    5. Installation will take less than five minutes. Installation"
^DIC(9.4,100,22,15,"PAH",51,1,130,0)="       of this patch requires no additional memory space."
^DIC(9.4,100,22,15,"PAH",51,1,131,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,132,0)="    6. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",51,1,133,0)="       'Install Package(s)' Select the package 'YS*5.01*87' and"
^DIC(9.4,100,22,15,"PAH",51,1,134,0)="       proceed with install."
^DIC(9.4,100,22,15,"PAH",51,1,135,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,136,0)="    7. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion"
^DIC(9.4,100,22,15,"PAH",51,1,137,0)="       of Install? YES//', respond YES.  Responding with a yes, will"
^DIC(9.4,100,22,15,"PAH",51,1,138,0)="       add considerable time to the installation."
^DIC(9.4,100,22,15,"PAH",51,1,139,0)="  "
^DIC(9.4,100,22,15,"PAH",51,1,140,0)="    8. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",51,1,141,0)="       install? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",51,1,142,0)="  "
^DIC(9.4,100,22,15,"PAH",51,1,143,0)="    9. When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,100,22,15,"PAH",51,1,144,0)="       Options, and Protocols? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",51,1,145,0)=" "
^DIC(9.4,100,22,15,"PAH",51,1,146,0)="    NOTE: Routine YTSTAT is deleted during the patch installation."
^DIC(9.4,100,22,15,"PAH",51,1,147,0)=""
^DIC(9.4,100,22,15,"PAH",52,0)="78 SEQ #71^3041111^1"
^DIC(9.4,100,22,15,"PAH",52,1,0)="^^141^141^3041111"
^DIC(9.4,100,22,15,"PAH",52,1,1,0)="****************************************************************************"
^DIC(9.4,100,22,15,"PAH",52,1,2,0)="*IMPORTANT NOTE TO IRM THIS PATCH MUST BE INSTALLED.  ALTHOUGH NO ROUTINES *"
^DIC(9.4,100,22,15,"PAH",52,1,3,0)="*ARE INCLUDED IN THIS PATCH KIDS DELETES THE OPTION YS BROKER [YS BROKER]  *"
^DIC(9.4,100,22,15,"PAH",52,1,4,0)="*WHEN THE PATCH IS INSTALLED.                                              *"
^DIC(9.4,100,22,15,"PAH",52,1,5,0)="****************************************************************************"
^DIC(9.4,100,22,15,"PAH",52,1,6,0)=""
^DIC(9.4,100,22,15,"PAH",52,1,7,0)="Patch YS*5.01*78 updates the file YS_ASIMV.EXE to be invoked from the "
^DIC(9.4,100,22,15,"PAH",52,1,8,0)="Computerized Patient Record System (CPRS) GUI Tool Bar.  YS_ASIMV.EXE now"
^DIC(9.4,100,22,15,"PAH",52,1,9,0)="supports Windows 2000 (W2K) operating system and Microsoft Windows XP "
^DIC(9.4,100,22,15,"PAH",52,1,10,0)="Professional Version 2002 Service Pack 1.  "
^DIC(9.4,100,22,15,"PAH",52,1,11,0)=""
^DIC(9.4,100,22,15,"PAH",52,1,12,0)="This patch also deletes option YS BROKER [YS BROKER] from the OPTION file"
^DIC(9.4,100,22,15,"PAH",52,1,13,0)="(#19)."
^DIC(9.4,100,22,15,"PAH",52,1,14,0)=""
