^DIC(9.4,48,22,5.28,"PAH",100,1,0)="^^1^1^2980923"
^DIC(9.4,48,22,5.28,"PAH",100,1,1,0)="ACRP Reports Menu (phase 2) options"
^DIC(9.4,48,22,5.28,"PAH",101,0)="156 SEQ #139^2981007^1"
^DIC(9.4,48,22,5.28,"PAH",101,1,0)="^^1^1^2981007"
^DIC(9.4,48,22,5.28,"PAH",101,1,1,0)="Update of workload closeout dates for FY1999."
^DIC(9.4,48,22,5.28,"PAH",102,0)="148^2981007^1"
^DIC(9.4,48,22,5.28,"PAH",102,1,0)="^^11^11^2981007"
^DIC(9.4,48,22,5.28,"PAH",102,1,1,0)="As a result of Practice Profiling the need to track Primary Care Provider"
^DIC(9.4,48,22,5.28,"PAH",102,1,2,0)="is now manditory.  PCMM has been chosen to collect and track this"
^DIC(9.4,48,22,5.28,"PAH",102,1,3,0)="information.  Patch SD*5.3*148 has been developed to help address some of"
^DIC(9.4,48,22,5.28,"PAH",102,1,4,0)="the current usability issues of PCMM. "
^DIC(9.4,48,22,5.28,"PAH",102,1,5,0)="                                             "
^DIC(9.4,48,22,5.28,"PAH",102,1,6,0)="This build will only hold the changes to the server/VISTA software."
^DIC(9.4,48,22,5.28,"PAH",102,1,7,0)="Additional changes are being made to the client side and are being"
^DIC(9.4,48,22,5.28,"PAH",102,1,8,0)="distributed in another mechanism."
^DIC(9.4,48,22,5.28,"PAH",102,1,9,0)=""
^DIC(9.4,48,22,5.28,"PAH",102,1,10,0)="Please refer to the patch description, release notes and user guide for a"
^DIC(9.4,48,22,5.28,"PAH",102,1,11,0)="detailed explination of the changes."
^DIC(9.4,48,22,5.28,"PAH",103,0)="151 SEQ #141^2981007^1"
