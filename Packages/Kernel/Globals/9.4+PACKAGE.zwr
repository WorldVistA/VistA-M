^DIC(9.4,4,22,1,"PAH",174,1,53,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",174,1,54,0)=" Select INSTALL NAME:    XM*7.1*203     Loaded from Distribution  <date/time>"
