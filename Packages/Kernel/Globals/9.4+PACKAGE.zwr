^DIC(9.4,18,0)="ENGINEERING^EN^AUTOMATED ENGINEERING MANAGEMENT SYSTEM"
^DIC(9.4,18,1,0)="^9.41A^5^5^3111220^^^^"
^DIC(9.4,18,1,1,0)="First proposed in the mid to late 1970's, MUMPS coding of this package"
^DIC(9.4,18,1,2,0)="began about 1980. National distribution of hardware and software took"
^DIC(9.4,18,1,3,0)="place in 1984."
^DIC(9.4,18,1,4,0)=" Principal modules include Work Control, Equipment Managment, and"
^DIC(9.4,18,1,5,0)="Construction Tracking."
^DIC(9.4,18,4,0)="^9.44PA^43^37"
