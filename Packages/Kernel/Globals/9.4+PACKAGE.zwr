^DIC(9.4,3,22,21,"PAH",241,1,103,0)=" Select INSTALL NAME:    XU*8.0*300    Loaded from Distribution  <date/time>"
^DIC(9.4,3,22,21,"PAH",241,1,104,0)="                         =========="
^DIC(9.4,3,22,21,"PAH",241,1,105,0)=" Install Questions for XU*8.0*300"
