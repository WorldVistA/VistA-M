^DIC(9.4,4,22,1,"PAH",45,1,5,0)="This patch adds a command to the full screen reader to refresh the display"
^DIC(9.4,4,22,1,"PAH",45,1,6,0)="of the current page of messages.  Enter ""="" to refresh the display."
^DIC(9.4,4,22,1,"PAH",45,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",45,1,8,0)="NOTE: This patch should be installed after hours, when user activity is at a"
