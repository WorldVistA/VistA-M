^DIC(9.4,100,22,15,"PAH",34,1,91,0)="     ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",34,1,92,0)="     ================"
^DIC(9.4,100,22,15,"PAH",34,1,93,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,94,0)="     The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",34,1,95,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,96,0)="     <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",34,1,97,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,98,0)="                                     Checksum Values"
^DIC(9.4,100,22,15,"PAH",34,1,99,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,100,0)="     Routine Name    Before Patch        After Patch     Patch List"
^DIC(9.4,100,22,15,"PAH",34,1,101,0)="     ------------    ------------        ----------- --------------------"
^DIC(9.4,100,22,15,"PAH",34,1,102,0)="     YSASCF            16798624           15199657     38,45,55"
^DIC(9.4,100,22,15,"PAH",34,1,103,0)="     YSASFM            4829194            4829236      24,30,32,37,38,55"
^DIC(9.4,100,22,15,"PAH",34,1,104,0)="     YSASFUR           14346228           14504166     38,55"
^DIC(9.4,100,22,15,"PAH",34,1,105,0)="     YSASNAR           11476987           11561066     24,30,37,38,44,55"
^DIC(9.4,100,22,15,"PAH",34,1,106,0)="     YSASRU            11199368           11203518     24,30,32,38,55"
^DIC(9.4,100,22,15,"PAH",34,1,107,0)="  "
^DIC(9.4,100,22,15,"PAH",34,1,108,0)="     Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",34,1,109,0)="     =========================="
^DIC(9.4,100,22,15,"PAH",34,1,110,0)="  "
^DIC(9.4,100,22,15,"PAH",34,1,111,0)="          1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",34,1,112,0)="             This option will load the KIDS package in this message onto "
^DIC(9.4,100,22,15,"PAH",34,1,113,0)="             your system."
^DIC(9.4,100,22,15,"PAH",34,1,114,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,115,0)="          2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",34,1,116,0)="             system. You now need to use KIDS to install the Transport"
^DIC(9.4,100,22,15,"PAH",34,1,117,0)="             global. On the KIDS menu, under the 'Installation' menu, use"
^DIC(9.4,100,22,15,"PAH",34,1,118,0)="             the following options:"
^DIC(9.4,100,22,15,"PAH",34,1,119,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,120,0)="                  Print Transport Global"
^DIC(9.4,100,22,15,"PAH",34,1,121,0)="                  Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",34,1,122,0)="                  Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",34,1,123,0)="                  Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",34,1,124,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,125,0)="          3. Installation of this patch should be at off peak hours."
^DIC(9.4,100,22,15,"PAH",34,1,126,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,127,0)="          4. Users may remain on the system."
^DIC(9.4,100,22,15,"PAH",34,1,128,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,129,0)="          5. Installation will take less than five minutes. Installation"
^DIC(9.4,100,22,15,"PAH",34,1,130,0)="             of this patch requires no additional memory space."
^DIC(9.4,100,22,15,"PAH",34,1,131,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,132,0)="          6. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",34,1,133,0)="             'Install Package(s)' Select the package 'YS*5.01*55' and"
^DIC(9.4,100,22,15,"PAH",34,1,134,0)="             proceed with install."
^DIC(9.4,100,22,15,"PAH",34,1,135,0)=" "
^DIC(9.4,100,22,15,"PAH",34,1,136,0)="          7. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",34,1,137,0)="             install? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",34,1,138,0)=""
^DIC(9.4,100,22,15,"PAH",34,1,139,0)="          8. When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,100,22,15,"PAH",34,1,140,0)="             Options, and Protocols? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",35,0)="63 SEQ #54^3000405^1"
^DIC(9.4,100,22,15,"PAH",35,1,0)="^^62^62^3000405"
^DIC(9.4,100,22,15,"PAH",35,1,1,0)="Patch YS*5.01*63 corrects the print problem in option ""Graph of Patients"
^DIC(9.4,100,22,15,"PAH",35,1,2,0)="Remaining"" [YSCENREM].  Date entry is limited to month and year and results"
^DIC(9.4,100,22,15,"PAH",35,1,3,0)="are graphed for each day in the month.  Each day of the month's data is"
^DIC(9.4,100,22,15,"PAH",35,1,4,0)="calculated from the CENSUS file (#41.9) for the specified ward. "
^DIC(9.4,100,22,15,"PAH",35,1,5,0)="This file contains the statistical data necessary for each ward"
^DIC(9.4,100,22,15,"PAH",35,1,6,0)="to create the daily G&L and bed status reports.  The report did not work,"
^DIC(9.4,100,22,15,"PAH",35,1,7,0)="when the month/year entered are greater than 12/99."
^DIC(9.4,100,22,15,"PAH",35,1,8,0)=""
^DIC(9.4,100,22,15,"PAH",35,1,9,0)=""
^DIC(9.4,100,22,15,"PAH",35,1,10,0)=""
^DIC(9.4,100,22,15,"PAH",35,1,11,0)="NOIS call(s): DAY-0300-40087"
^DIC(9.4,100,22,15,"PAH",35,1,12,0)=""
^DIC(9.4,100,22,15,"PAH",35,1,13,0)="Test Site(s): Dayton, OH"
^DIC(9.4,100,22,15,"PAH",35,1,14,0)=" "
