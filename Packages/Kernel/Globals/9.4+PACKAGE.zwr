^DIC(9.4,14,22,5.9,"PAH",280,1,1,0)="Upload new Etiology entries into file (61.2)"
^DIC(9.4,14,22,5.9,"PAH",281,0)="474^3170123.141209^54"
^DIC(9.4,14,22,5.9,"PAH",281,1,0)="^^499^499^3170123"
^DIC(9.4,14,22,5.9,"PAH",281,1,1,0)="Associated Patch: LA*5.2*90; which will be installed first as a part of"
^DIC(9.4,14,22,5.9,"PAH",281,1,2,0)="this combined build."
^DIC(9.4,14,22,5.9,"PAH",281,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,4,0)="The build for this patch is distributed as part of a multi-package build "
^DIC(9.4,14,22,5.9,"PAH",281,1,5,0)="that contains LA*5.2*90 and LR*5.2*474. The build contains functionality "
^DIC(9.4,14,22,5.9,"PAH",281,1,6,0)="that will allow Microbiology instrumentation to utilize the Lab Universal"
^DIC(9.4,14,22,5.9,"PAH",281,1,7,0)="Interface. "
^DIC(9.4,14,22,5.9,"PAH",281,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,9,0)="By utilizing the Universal Interface and Instrument Manager (IM) "
^DIC(9.4,14,22,5.9,"PAH",281,1,10,0)="middleware, sites will be able to switch from using class III interfaces"
^DIC(9.4,14,22,5.9,"PAH",281,1,11,0)="to a UI standard interface. New functionality will be applied that will"
^DIC(9.4,14,22,5.9,"PAH",281,1,12,0)="allow for an ""MI"" subscripted test to be added to the VistA Auto"
^DIC(9.4,14,22,5.9,"PAH",281,1,13,0)="Instrument file (#64.2). There will also be enhanced result processing and"
^DIC(9.4,14,22,5.9,"PAH",281,1,14,0)="verify/release functions (see LA*5.2*90 patch descriptions for additional"
^DIC(9.4,14,22,5.9,"PAH",281,1,15,0)="details)."
^DIC(9.4,14,22,5.9,"PAH",281,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,17,0)="The build for this patch is distributed in support of the VistA "
^DIC(9.4,14,22,5.9,"PAH",281,1,18,0)="Laboratory Enhancement (VLE) Microbiology/Data Innovations interface "
^DIC(9.4,14,22,5.9,"PAH",281,1,19,0)="utilizing the Laboratory Universal Interface."
^DIC(9.4,14,22,5.9,"PAH",281,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,21,0)="The patch provide new functionality provides for the Enter/Verify data "
^DIC(9.4,14,22,5.9,"PAH",281,1,22,0)="(Auto Instrument) option which will allow the technologist with the "
^DIC(9.4,14,22,5.9,"PAH",281,1,23,0)="authority to release three release actions."
^DIC(9.4,14,22,5.9,"PAH",281,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,26,0)="Blood Bank Review:"
^DIC(9.4,14,22,5.9,"PAH",281,1,27,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",281,1,28,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*474 does not "
^DIC(9.4,14,22,5.9,"PAH",281,1,29,0)="contain any changes to the VISTA BLOOD BANK Software as defined by ProPath"
^DIC(9.4,14,22,5.9,"PAH",281,1,30,0)="standard titled: BBM Team Review of VistA Patches."
^DIC(9.4,14,22,5.9,"PAH",281,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,32,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*474 does not "
^DIC(9.4,14,22,5.9,"PAH",281,1,33,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",281,1,34,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",281,1,35,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,36,0)="RISK ANALYSIS: Changes made by patch LR*5.2*474 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",281,1,37,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",281,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,39,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",281,1,40,0)="made, no specific validation requirements exist as a result of"
^DIC(9.4,14,22,5.9,"PAH",281,1,41,0)="installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",281,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",281,1,43,0)=" "
