^DIC(9.4,14,22,5.9,"PAH",172,1,1,0)="This patch corrects 2 seperate problems in 3 different Remedy tickets."
^DIC(9.4,14,22,5.9,"PAH",173,0)="342 SEQ #271^3060807^1"
^DIC(9.4,14,22,5.9,"PAH",173,1,0)="^^3^3^3060807"
^DIC(9.4,14,22,5.9,"PAH",173,1,1,0)="This patch corrects a data integrity problem caused by an input"
^DIC(9.4,14,22,5.9,"PAH",173,1,2,0)="transform setting data at the wrong global node and removes a"
^DIC(9.4,14,22,5.9,"PAH",173,1,3,0)="menu option that is obsolete."
^DIC(9.4,14,22,5.9,"PAH",174,0)="358 SEQ #272^3060807^1"
