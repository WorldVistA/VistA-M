^DIC(9.4,4,22,2,"PAH",20,0)="21 SEQ #20^3030924^1"
^DIC(9.4,4,22,2,"PAH",20,1,0)="^^59^59^3030924"
^DIC(9.4,4,22,2,"PAH",20,1,1,0)="Patch XM*8.0*21"
^DIC(9.4,4,22,2,"PAH",20,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,3,0)="NOIS: ZZZ-0703-N1995"
^DIC(9.4,4,22,2,"PAH",20,1,4,0)="Test Site: CoreFLS Dev"
^DIC(9.4,4,22,2,"PAH",20,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,6,0)="P-MESSAGE can abort if MailMan notices any errors in the user's setup."
^DIC(9.4,4,22,2,"PAH",20,1,7,0)="This patch fixes that."
^DIC(9.4,4,22,2,"PAH",20,1,8,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",20,1,10,0)="is at a minimum.  It requires MailMan patch XM*8.0*17."
^DIC(9.4,4,22,2,"PAH",20,1,11,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",20,1,12,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",20,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",20,1,15,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",20,1,16,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,17,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",20,1,18,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",20,1,19,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",20,1,20,0)="XMAPHOST       9096253         9963881        2,17,21"
^DIC(9.4,4,22,2,"PAH",20,1,21,0)="XMD            7748228         7841354        21"
^DIC(9.4,4,22,2,"PAH",20,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",20,1,23,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,24,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",20,1,25,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",20,1,26,0)=" "
^DIC(9.4,4,22,2,"PAH",20,1,27,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",20,1,28,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",20,1,29,0)="is at a minimum.  It requires MailMan patch XM*8.0*17."
^DIC(9.4,4,22,2,"PAH",20,1,30,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",20,1,31,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",20,1,32,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",20,1,33,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",20,1,34,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",20,1,35,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",20,1,36,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",20,1,37,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",20,1,38,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",20,1,39,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",20,1,40,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",20,1,41,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",20,1,42,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",20,1,43,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",20,1,44,0)=" Select INSTALL NAME:    XM*8.0*21     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",20,1,45,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",20,1,46,0)=" Install Questions for XM*8.0*21"
^DIC(9.4,4,22,2,"PAH",20,1,47,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,48,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",20,1,49,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",20,1,50,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",20,1,51,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",20,1,52,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",20,1,53,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",20,1,54,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",20,1,55,0)=""
^DIC(9.4,4,22,2,"PAH",20,1,56,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",20,1,57,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",20,1,58,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",20,1,59,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",21,0)="23 SEQ #21^3040302^1"
^DIC(9.4,4,22,2,"PAH",21,1,0)="^^58^58^3040302"
^DIC(9.4,4,22,2,"PAH",21,1,1,0)="Patch XM*8.0*23"
^DIC(9.4,4,22,2,"PAH",21,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,3,0)="NOIS: ISP-0903-N2480"
^DIC(9.4,4,22,2,"PAH",21,1,4,0)="Test Site: Bay Pines OIFO"
^DIC(9.4,4,22,2,"PAH",21,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,6,0)="The API, ENT^XMPG, does not check to ensure that the user who is using it"
^DIC(9.4,4,22,2,"PAH",21,1,7,0)="has an access code and a mailbox.  This patch fixes that."
^DIC(9.4,4,22,2,"PAH",21,1,8,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",21,1,10,0)="is at a minimum.  It has no patch pre-requisites."
^DIC(9.4,4,22,2,"PAH",21,1,11,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",21,1,12,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",21,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",21,1,15,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",21,1,16,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,17,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",21,1,18,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",21,1,19,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",21,1,20,0)="XMPG           4410165         4460555        23"
^DIC(9.4,4,22,2,"PAH",21,1,21,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",21,1,22,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,23,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",21,1,24,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",21,1,25,0)=" "
^DIC(9.4,4,22,2,"PAH",21,1,26,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",21,1,27,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",21,1,28,0)="is at a minimum.  It has no patch pre-requisites."
^DIC(9.4,4,22,2,"PAH",21,1,29,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",21,1,30,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",21,1,31,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",21,1,32,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",21,1,33,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",21,1,34,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",21,1,35,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",21,1,36,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",21,1,37,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",21,1,38,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",21,1,39,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",21,1,40,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",21,1,41,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",21,1,42,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",21,1,43,0)=" Select INSTALL NAME:    XM*8.0*23     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",21,1,44,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",21,1,45,0)=" Install Questions for XM*8.0*23"
^DIC(9.4,4,22,2,"PAH",21,1,46,0)=""
^DIC(9.4,4,22,2,"PAH",21,1,47,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",21,1,48,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",21,1,49,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",21,1,50,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",21,1,51,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",21,1,52,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",21,1,53,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",21,1,54,0)=""
