^DIC(9.4,120,0)="INCOME VERIFICATION MATCH^IVM^IVM Software for interface with the IVM Center"
^DIC(9.4,120,1,0)="^^14^14^2941021^^^^"
^DIC(9.4,120,1,1,0)=" "
^DIC(9.4,120,1,2,0)="The IVM package will transmit information to the IVM Center for patients"
^DIC(9.4,120,1,3,0)="whose means tests meet the following criteria:"
^DIC(9.4,120,1,4,0)=" "
^DIC(9.4,120,1,5,0)="       Means test is Category A, but neither hardship or adjudicated"
^DIC(9.4,120,1,6,0)="                                   OR"
^DIC(9.4,120,1,7,0)="       Means test is Category C, but patient has no active insurance"
^DIC(9.4,120,1,8,0)=" "
^DIC(9.4,120,1,9,0)="Information transmitted includes demographics, income and next-of-kin"
^DIC(9.4,120,1,10,0)="information as well as demographic and income data for the patient's"
^DIC(9.4,120,1,11,0)="spouse."
^DIC(9.4,120,1,12,0)=" "
^DIC(9.4,120,1,13,0)="Changes to the patient's name, SSN, DOB, sex, address, phone number, or"
^DIC(9.4,120,1,14,0)="means test are transmitted for patients being reviewed by the IVM Center."
^DIC(9.4,120,4,0)="^9.44PA^12^12"
