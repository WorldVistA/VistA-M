^DIC(9.4,48,22,5.28,"PAH",712,1,17,0)="VSE-10967: BB - Consecutive slots being returned are not being returned at"
^DIC(9.4,48,22,5.28,"PAH",712,1,18,0)="                a 5 week interval."
