^DIC(9.4,3,22,21,"PAH",502,0)="678 SEQ #531^3170726.130407^54"
^DIC(9.4,3,22,21,"PAH",502,1,0)="^^2^2^3170726"
^DIC(9.4,3,22,21,"PAH",502,1,1,0)="This package contains routines necessary to accommodate"
