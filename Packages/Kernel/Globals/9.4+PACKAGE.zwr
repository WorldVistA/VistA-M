^DIC(9.4,4,22,1,"PAH",166,1,93,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",166,1,94,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",166,1,95,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",167,0)="195 SEQ #192^3011016^1"
^DIC(9.4,4,22,1,"PAH",167,1,0)="^^66^66^3011016"
^DIC(9.4,4,22,1,"PAH",167,1,1,0)="Patch XM*7.1*195"
^DIC(9.4,4,22,1,"PAH",167,1,2,0)=" "
^DIC(9.4,4,22,1,"PAH",167,1,3,0)="NOIS BRX-0801-12006"
^DIC(9.4,4,22,1,"PAH",167,1,4,0)="Test Sites: Bronx VAMC"
^DIC(9.4,4,22,1,"PAH",167,1,5,0)=" "
^DIC(9.4,4,22,1,"PAH",167,1,6,0)="If you scramble a message with a string of 2's as the password, and send"
^DIC(9.4,4,22,1,"PAH",167,1,7,0)="the message to a remote site, the recipient will not be able to open it."
^DIC(9.4,4,22,1,"PAH",167,1,8,0)=" "
^DIC(9.4,4,22,1,"PAH",167,1,9,0)="If you scramble a message with a string of any other repeating character"
^DIC(9.4,4,22,1,"PAH",167,1,10,0)="as the password, the recipient (remote or not) will be able to open it"
^DIC(9.4,4,22,1,"PAH",167,1,11,0)="by entering any number of that character.  For example, if the password"
^DIC(9.4,4,22,1,"PAH",167,1,12,0)="is AAAAA, the recipient can open the message by entering AAA or AAAAAAA."
^DIC(9.4,4,22,1,"PAH",167,1,13,0)=" "
^DIC(9.4,4,22,1,"PAH",167,1,14,0)="For this reason, this patch will prohibit the use of repeating characters"
^DIC(9.4,4,22,1,"PAH",167,1,15,0)="as passwords for scrambled messages."
^DIC(9.4,4,22,1,"PAH",167,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",167,1,17,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",167,1,18,0)="is at a minimum.  It requires MailMan patch XM*7.1*153 & *163."
^DIC(9.4,4,22,1,"PAH",167,1,19,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",167,1,20,0)=" "
^DIC(9.4,4,22,1,"PAH",167,1,21,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",167,1,22,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",167,1,23,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",167,1,24,0)=" "
