^DIC(9.4,11,22,5.03,"PAH",11,1,104,0)="Select INSTALL NAME:    LA*5.2*45        Loaded from Distribution  10/16/98@13:0"
^DIC(9.4,11,22,5.03,"PAH",11,1,105,0)="0:43"
