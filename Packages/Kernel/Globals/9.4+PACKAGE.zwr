^DIC(9.4,175,22,2,"PAH",118,0)="181^3170629.16101^54"
^DIC(9.4,175,22,2,"PAH",118,1,0)="^^25^25^3170629"
^DIC(9.4,175,22,2,"PAH",118,1,1,0)="VistA Imaging Display with 2 factor authentication (2FA)"
^DIC(9.4,175,22,2,"PAH",118,1,2,0)="This patch has 3 changes."
^DIC(9.4,175,22,2,"PAH",118,1,3,0)="2 small changes when the application starts, and a change to the version "
^DIC(9.4,175,22,2,"PAH",118,1,4,0)="of Delphi used to build the application."
^DIC(9.4,175,22,2,"PAH",118,1,5,0)="  "
^DIC(9.4,175,22,2,"PAH",118,1,6,0)="This patch implements 2 Factor Authorization for the Login to VistA. "
^DIC(9.4,175,22,2,"PAH",118,1,7,0)="When logging into a VA Site, the user will be prompted for their"
^DIC(9.4,175,22,2,"PAH",118,1,8,0)="PIV PIN number and not their Access Verify codes."
^DIC(9.4,175,22,2,"PAH",118,1,9,0)="  "
^DIC(9.4,175,22,2,"PAH",118,1,10,0)="Also,  at start up a splash screen will be displayed.  The Splash screen"
^DIC(9.4,175,22,2,"PAH",118,1,11,0)="will remain visible while the application is being initialized and will "
^DIC(9.4,175,22,2,"PAH",118,1,12,0)="close when the application is ready for use."
^DIC(9.4,175,22,2,"PAH",118,1,13,0)="  "
^DIC(9.4,175,22,2,"PAH",118,1,14,0)="Delphi XE8 is the new developer environment used to build the application. "
^DIC(9.4,175,22,2,"PAH",118,1,15,0)="In XE8 the Character set has changed from 1 byte/character"
^DIC(9.4,175,22,2,"PAH",118,1,16,0)="to 2 byte/character.  The change in character set forced a change in"
^DIC(9.4,175,22,2,"PAH",118,1,17,0)="some of the functions that were used for manipulating character and "
^DIC(9.4,175,22,2,"PAH",118,1,18,0)="character strings.  But there will be no visible change to the GUI and"
^DIC(9.4,175,22,2,"PAH",118,1,19,0)="the user will not see any difference in functionality.  "
^DIC(9.4,175,22,2,"PAH",118,1,20,0)="  "
^DIC(9.4,175,22,2,"PAH",118,1,21,0)="Routines."
^DIC(9.4,175,22,2,"PAH",118,1,22,0)="Select BUILD NAME:    MAG*3.0*181     IMAGING"
^DIC(9.4,175,22,2,"PAH",118,1,23,0)="MAGGTU4D  value = 5320928"
^DIC(9.4,175,22,2,"PAH",118,1,24,0)="MAGIP181  value = 4214985"
^DIC(9.4,175,22,2,"PAH",118,1,25,0)="done"
