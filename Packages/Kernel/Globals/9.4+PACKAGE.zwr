^DIC(9.4,161,0)="CPT/HCPCS CODES^ICPT^ICPT/HCPCS CODES"
^DIC(9.4,161,14,0)="^9.4014^1^1"
^DIC(9.4,161,14,1,0)="DGYA"
^DIC(9.4,161,14,"B","DGYA",1)=""
^DIC(9.4,161,20,0)="^9.402P^^"
^DIC(9.4,161,22,0)="^9.49I^1^1"
^DIC(9.4,161,22,1,0)="6.0^3051119^2970528^1"
^DIC(9.4,161,22,1,1,0)="^^1^1^3051119"
^DIC(9.4,161,22,1,1,1,0)="See associated package documentation for description."
^DIC(9.4,161,22,1,"PAH",0)="^9.4901^93^93"
^DIC(9.4,161,22,1,"PAH",1,0)="1^2970708^1"
^DIC(9.4,161,22,1,"PAH",1,1,0)="^^5^5^2970708"
^DIC(9.4,161,22,1,"PAH",1,1,1,0)="This patch corrects the reference in routine ICPTAPIU"
^DIC(9.4,161,22,1,"PAH",1,1,2,0)="from ^TMP($J,""W"") to ^UTILITY($J,""W"").  This error resulted in the CPT"
^DIC(9.4,161,22,1,"PAH",1,1,3,0)="COPYRIGHT message hanging."
^DIC(9.4,161,22,1,"PAH",1,1,4,0)=" "
^DIC(9.4,161,22,1,"PAH",1,1,5,0)="This was reported in NOIS HAM-0697-20037."
^DIC(9.4,161,22,1,"PAH",2,0)="2^2980129^1"
^DIC(9.4,161,22,1,"PAH",2,1,0)="^^4^4^2980129"
^DIC(9.4,161,22,1,"PAH",2,1,1,0)="This patch adds HEALTH SUMMARY (GMTS) to the application group of"
^DIC(9.4,161,22,1,"PAH",2,1,2,0)="file 81 (CPT).  This allows selecting of CPT codes for components"
^DIC(9.4,161,22,1,"PAH",2,1,3,0)="who wish to search for CPT codes.  See the national patch module"
^DIC(9.4,161,22,1,"PAH",2,1,4,0)="for a complete description of ICPT*6*2."
^DIC(9.4,161,22,1,"PAH",3,0)="3^2980318^1"
^DIC(9.4,161,22,1,"PAH",3,1,0)="^^2^2^2980318"
^DIC(9.4,161,22,1,"PAH",3,1,1,0)="This patch contains the 1998 CPT Update.  Please refer to the patch"
^DIC(9.4,161,22,1,"PAH",3,1,2,0)="description in NPM for further information."
^DIC(9.4,161,22,1,"PAH",4,0)="4^2990223^1"
^DIC(9.4,161,22,1,"PAH",4,1,0)="^^2^2^2990223"
^DIC(9.4,161,22,1,"PAH",4,1,1,0)="This patch contains the 1999 CPT Update.  Please refer to the patch"
^DIC(9.4,161,22,1,"PAH",4,1,2,0)="description in NPM for further information."
^DIC(9.4,161,22,1,"PAH",5,0)="5 SEQ #5^2990427^1"
^DIC(9.4,161,22,1,"PAH",5,1,0)="^^1^1^2990427"
^DIC(9.4,161,22,1,"PAH",5,1,1,0)="Correct Short Names for codes 64623 and 82544, per NOIS RIC-0299-21517."
^DIC(9.4,161,22,1,"PAH",6,0)="6 SEQ #6^2991002^1"
^DIC(9.4,161,22,1,"PAH",6,1,0)="^^5^5^2991002"
^DIC(9.4,161,22,1,"PAH",6,1,1,0)="This patch adds two new parameters to the formal list of a number of the"
^DIC(9.4,161,22,1,"PAH",6,1,2,0)="APIs in the CPT/HPCPS code package. The patch also deletes the CPT"
^DIC(9.4,161,22,1,"PAH",6,1,3,0)="modifier file, ^DIC(81.3, as part of the installation. After the patch"
^DIC(9.4,161,22,1,"PAH",6,1,4,0)="installation, a global installation is needed to restore the CPT modifier"
^DIC(9.4,161,22,1,"PAH",6,1,5,0)="file."
^DIC(9.4,161,22,1,"PAH",7,0)="7 SEQ #7^3000229^1"
^DIC(9.4,161,22,1,"PAH",7,1,0)="^^2^2^3000229"
^DIC(9.4,161,22,1,"PAH",7,1,1,0)="This patch updates the CPT Modifier file (#81.3) with 1999 OWCP Medical"
^DIC(9.4,161,22,1,"PAH",7,1,2,0)="Fee Schedule CPT/Modifier pairs."
^DIC(9.4,161,22,1,"PAH",8,0)="8 SEQ #8^3000306^1"
^DIC(9.4,161,22,1,"PAH",8,1,0)="^^2^2^3000306"
^DIC(9.4,161,22,1,"PAH",8,1,1,0)="This patch contains the 2000 CPT Update.  See the patch description in the"
^DIC(9.4,161,22,1,"PAH",8,1,2,0)="National Patch Module for details."
^DIC(9.4,161,22,1,"PAH",9,0)="9 SEQ #9^3010326^1"
^DIC(9.4,161,22,1,"PAH",10,0)="11 SEQ #11^3010529^1"
^DIC(9.4,161,22,1,"PAH",11,0)="12 SEQ #12^3020226^1"
^DIC(9.4,161,22,1,"PAH",11,1,0)="^^59^59^3020226"
^DIC(9.4,161,22,1,"PAH",11,1,1,0)="This patch updates the CPT code files for 2002."
^DIC(9.4,161,22,1,"PAH",11,1,2,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,3,0)="(The balance of the description is for internal SD&D documentation only)"
^DIC(9.4,161,22,1,"PAH",11,1,4,0)="These INHOUSE routines were changed to make this year's CPT update."
^DIC(9.4,161,22,1,"PAH",11,1,5,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,6,0)="ICPTZ"
^DIC(9.4,161,22,1,"PAH",11,1,7,0)="rewrote RDDSK label so could use AMA files"
^DIC(9.4,161,22,1,"PAH",11,1,8,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,9,0)="ICPTZ1R"
^DIC(9.4,161,22,1,"PAH",11,1,10,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",11,1,11,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,12,0)="ICPTZ1"
^DIC(9.4,161,22,1,"PAH",11,1,13,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",11,1,14,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,15,0)="ICPTZ1RA"
^DIC(9.4,161,22,1,"PAH",11,1,16,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",11,1,17,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,18,0)="ICPTZ2"
^DIC(9.4,161,22,1,"PAH",11,1,19,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",11,1,20,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,21,0)="ICPTZUP"
^DIC(9.4,161,22,1,"PAH",11,1,22,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",11,1,23,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,24,0)="ICPTZSRT"
^DIC(9.4,161,22,1,"PAH",11,1,25,0)="include CPT code in the list for Austin"
^DIC(9.4,161,22,1,"PAH",11,1,26,0)="if only the short description is changed"
^DIC(9.4,161,22,1,"PAH",11,1,27,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,28,0)="ICPTZ3"
^DIC(9.4,161,22,1,"PAH",11,1,29,0)="added pattern check for 4N1A so AMA codes ending in ""T"" could be added"
^DIC(9.4,161,22,1,"PAH",11,1,30,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,31,0)="ICPTZM0"
^DIC(9.4,161,22,1,"PAH",11,1,32,0)="split into ICPTZM0 and ICPTZM01"
^DIC(9.4,161,22,1,"PAH",11,1,33,0)="various changes to update the Modifier file from Ingenix file"
^DIC(9.4,161,22,1,"PAH",11,1,34,0)="(see also ICPTZM09)"
^DIC(9.4,161,22,1,"PAH",11,1,35,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,36,0)="These routines are included in the build:"
^DIC(9.4,161,22,1,"PAH",11,1,37,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,38,0)="ICPT612R (preinit)"
^DIC(9.4,161,22,1,"PAH",11,1,39,0)="host file names changed"
^DIC(9.4,161,22,1,"PAH",11,1,40,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,41,0)="ICPT612E (environment check)"
^DIC(9.4,161,22,1,"PAH",11,1,42,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,43,0)="ICPTAPIU"
^DIC(9.4,161,22,1,"PAH",11,1,44,0)="changed $$NUM to convert codes ending in ""T"" or other letter to numeric "
^DIC(9.4,161,22,1,"PAH",11,1,45,0)="value for use in sort ranges like the ""M"" cross reference on the range"
^DIC(9.4,161,22,1,"PAH",11,1,46,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,47,0)="ICPTCOD"
^DIC(9.4,161,22,1,"PAH",11,1,48,0)="changed $$CPT, $$CPTD and $$CODM for same reason"
^DIC(9.4,161,22,1,"PAH",11,1,49,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,50,0)="ICPTMOD "
^DIC(9.4,161,22,1,"PAH",11,1,51,0)="changed $$MODP for same reason "
^DIC(9.4,161,22,1,"PAH",11,1,52,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,53,0)="ICPTPRN"
^DIC(9.4,161,22,1,"PAH",11,1,54,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",11,1,55,0)=" "
^DIC(9.4,161,22,1,"PAH",11,1,56,0)="ICPTSR1 thru ICPTSR24"
^DIC(9.4,161,22,1,"PAH",11,1,57,0)="routines that contain all revised CPT codes - all AMA codes included"
^DIC(9.4,161,22,1,"PAH",11,1,58,0)="again this year because we went back to using AMA file instead of"
^DIC(9.4,161,22,1,"PAH",11,1,59,0)="Ingenix file and short descriptions are different."
^DIC(9.4,161,22,1,"PAH",12,0)="13 SEQ #13^3030301^1"
^DIC(9.4,161,22,1,"PAH",12,1,0)="^^52^52^3030301"
^DIC(9.4,161,22,1,"PAH",12,1,1,0)="This patch updates the CPT code files for 2003 and updates an API."
^DIC(9.4,161,22,1,"PAH",12,1,2,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,3,0)="(The balance of the description is for internal SD&D documentation only)"
^DIC(9.4,161,22,1,"PAH",12,1,4,0)="These INHOUSE routines were changed to make this year's CPT update."
^DIC(9.4,161,22,1,"PAH",12,1,5,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,6,0)="Follow instructions found with 'CPT Update Process Guide for Software "
^DIC(9.4,161,22,1,"PAH",12,1,7,0)="Developers' in MS Word format."
