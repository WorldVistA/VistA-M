^DIC(9.4,4,22,1,"PAH",130,0)="162 SEQ #155^3010103^1"
^DIC(9.4,4,22,1,"PAH",130,1,0)="^^57^57^3010103"
^DIC(9.4,4,22,1,"PAH",130,1,1,0)="Patch XM*7.1*162"
^DIC(9.4,4,22,1,"PAH",130,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",130,1,3,0)="NOIS: ISW-1100-22093"
^DIC(9.4,4,22,1,"PAH",130,1,4,0)="Test Sites:  FORUM"
^DIC(9.4,4,22,1,"PAH",130,1,5,0)="If a message from a remote site has no remote message ID associated with it,"
^DIC(9.4,4,22,1,"PAH",130,1,6,0)="an abort occurs if a user attempts to reply remotely to it.  This patch"
^DIC(9.4,4,22,1,"PAH",130,1,7,0)="prevents the abort by sending the reply as an original message."
^DIC(9.4,4,22,1,"PAH",130,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",130,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",130,1,10,0)="is at a minimum.  It requires MailMan patch XM*7.1*132."
^DIC(9.4,4,22,1,"PAH",130,1,11,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",130,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",130,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",130,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",130,1,15,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",130,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",130,1,17,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",130,1,18,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",130,1,19,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",130,1,20,0)="XMXREPLY       5876870         5772421        50,85,99,107,132,162"
^DIC(9.4,4,22,1,"PAH",130,1,21,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",130,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",130,1,23,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",130,1,24,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",130,1,25,0)=" "
^DIC(9.4,4,22,1,"PAH",130,1,26,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",130,1,27,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",130,1,28,0)="is at a minimum.  It requires MailMan patch XM*7.1*132."
^DIC(9.4,4,22,1,"PAH",130,1,29,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",130,1,30,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",130,1,31,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",130,1,32,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",130,1,33,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",130,1,34,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",130,1,35,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",130,1,36,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",130,1,37,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",130,1,38,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",130,1,39,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",130,1,40,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",130,1,41,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",130,1,42,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",130,1,43,0)=" Select INSTALL NAME:    XM*7.1*162    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",130,1,44,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",130,1,45,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",130,1,46,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",130,1,47,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",130,1,48,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",130,1,49,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",130,1,50,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",130,1,51,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",130,1,52,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",130,1,53,0)=""
^DIC(9.4,4,22,1,"PAH",130,1,54,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",130,1,55,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",130,1,56,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
