^DIC(9.4,14,22,5.9,"PAH",213,1,319,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,14,22,5.9,"PAH",213,1,320,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,14,22,5.9,"PAH",213,1,321,0)=" Enter a '^' to abort the install."
