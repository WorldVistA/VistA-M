^DIC(9.4,73,22,9,"PAH",15,1,92,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,93,0)="."
^DIC(9.4,73,22,9,"PAH",16,0)="26 SEQ #23^3010710^1"
^DIC(9.4,73,22,9,"PAH",16,1,0)="^^200^200^3010710"
^DIC(9.4,73,22,9,"PAH",16,1,1,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,3,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,4,0)="Subject"
^DIC(9.4,73,22,9,"PAH",16,1,5,0)="-------"
^DIC(9.4,73,22,9,"PAH",16,1,6,0)="        Install a Patient Identification (PATID) filter that matches"
^DIC(9.4,73,22,9,"PAH",16,1,7,0)="      the patient on each Health Summary segment with the patient"
^DIC(9.4,73,22,9,"PAH",16,1,8,0)="      requested."
^DIC(9.4,73,22,9,"PAH",16,1,9,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,10,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,11,0)="Category"
^DIC(9.4,73,22,9,"PAH",16,1,12,0)="--------"
^DIC(9.4,73,22,9,"PAH",16,1,13,0)="      Routine"
^DIC(9.4,73,22,9,"PAH",16,1,14,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,15,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,16,0)="Description:"
^DIC(9.4,73,22,9,"PAH",16,1,17,0)="-----------"
^DIC(9.4,73,22,9,"PAH",16,1,18,0)="      NOIS FAR-1200-40490 "
^DIC(9.4,73,22,9,"PAH",16,1,19,0)="              Fargo VAMC reported that they have received data on"
^DIC(9.4,73,22,9,"PAH",16,1,20,0)="      the wrong patient when they received NHE requests from"
^DIC(9.4,73,22,9,"PAH",16,1,21,0)="      Minneapolis. This patch will install a patient"
^DIC(9.4,73,22,9,"PAH",16,1,22,0)="      identification filter (PATID) that will match the patient"
^DIC(9.4,73,22,9,"PAH",16,1,23,0)="      identity on each Health Summary segment with the patient"
^DIC(9.4,73,22,9,"PAH",16,1,24,0)="      identifier (Name, Date of birth, Social Security Number) of"
^DIC(9.4,73,22,9,"PAH",16,1,25,0)="      the patient requested. If any of the Health Summary"
^DIC(9.4,73,22,9,"PAH",16,1,26,0)="      segments do not return data for the patient requested, then"
^DIC(9.4,73,22,9,"PAH",16,1,27,0)="      none of the data will be returned to the requestor. A"
^DIC(9.4,73,22,9,"PAH",16,1,28,0)="      message that instructs the requestor to resend the request"
^DIC(9.4,73,22,9,"PAH",16,1,29,0)="      is sent instead."
^DIC(9.4,73,22,9,"PAH",16,1,30,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,31,0)="        This patch also includes an option for the receiving site"
^DIC(9.4,73,22,9,"PAH",16,1,32,0)="      that will report on the number of possible bad data"
^DIC(9.4,73,22,9,"PAH",16,1,33,0)="      messages that have been received by the site."
^DIC(9.4,73,22,9,"PAH",16,1,34,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,35,0)="        This option works by comparing the patient's age with the"
^DIC(9.4,73,22,9,"PAH",16,1,36,0)="      age calculated from the Date of Birth that was reported in"
^DIC(9.4,73,22,9,"PAH",16,1,37,0)="      the Demographics segment of the NHE request. Note that if"
^DIC(9.4,73,22,9,"PAH",16,1,38,0)="      the request is made within a few weeks of the patient's"
^DIC(9.4,73,22,9,"PAH",16,1,39,0)="      birthday, and the age calculated by the Date of Birth"
^DIC(9.4,73,22,9,"PAH",16,1,40,0)="      differs by one year from the patient's actual age, then"
^DIC(9.4,73,22,9,"PAH",16,1,41,0)="      this report option may falsly indicate that the record was"
^DIC(9.4,73,22,9,"PAH",16,1,42,0)="      invalid when in fact it was valid (data is for the correct"
^DIC(9.4,73,22,9,"PAH",16,1,43,0)="      patient)."
^DIC(9.4,73,22,9,"PAH",16,1,44,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,45,0)="        Since the server filter uses three data elements (Name,"
^DIC(9.4,73,22,9,"PAH",16,1,46,0)="      Social Security Number, and Date of birth), it is much more"
^DIC(9.4,73,22,9,"PAH",16,1,47,0)="      accurate than the report option at catching NHE data"
^DIC(9.4,73,22,9,"PAH",16,1,48,0)="      messages for the wrong patient. If the server site has"
^DIC(9.4,73,22,9,"PAH",16,1,49,0)="      loaded this patch then you can assume that the patient is"
^DIC(9.4,73,22,9,"PAH",16,1,50,0)="      correct regardless of what this report displays."
^DIC(9.4,73,22,9,"PAH",16,1,51,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,52,0)="        How to tell if the server site has loaded this patch:"
^DIC(9.4,73,22,9,"PAH",16,1,53,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,54,0)="        Messages will have a line inserted after the patient ID:"
^DIC(9.4,73,22,9,"PAH",16,1,55,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,56,0)="  Subj: Reply for <TOTAL> Patient,A  111111111  MADISON.DOMAIN.EXT  [#93164]"
^DIC(9.4,73,22,9,"PAH",16,1,57,0)="  1 Feb 2001 15:05:05 -0600 (CST)  1936 lines"
^DIC(9.4,73,22,9,"PAH",16,1,58,0)="  From: <POSTMASTER@MADISON.DOMAIN.EXT>  In 'IN' basket.   Page 1"
^DIC(9.4,73,22,9,"PAH",16,1,59,0)="  ------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",16,1,60,0)="  111111111^11744^SPIVEY,RICK^3010201.113723^SMA.ISC-ALBANY.DOMAIN.EXT^TOTAL"
^DIC(9.4,73,22,9,"PAH",16,1,61,0)="  *********CONFIDENTIAL Patient Data from MADISON.DOMAIN.EXT********* 02/01/01"
^DIC(9.4,73,22,9,"PAH",16,1,62,0)="  Patient,A  111-11-1111                DOB: SEP 3,1936"
^DIC(9.4,73,22,9,"PAH",16,1,63,0)="    "
^DIC(9.4,73,22,9,"PAH",16,1,64,0)="  -Patient ID verified on all data segments-  <- This line is added to"
^DIC(9.4,73,22,9,"PAH",16,1,65,0)="                                                 messages from server"
^DIC(9.4,73,22,9,"PAH",16,1,66,0)="                                                 sites that have loaded"
^DIC(9.4,73,22,9,"PAH",16,1,67,0)="                                                 the PATID filter patch. "
^DIC(9.4,73,22,9,"PAH",16,1,68,0)="  -------------------------- DEM - Demographics --------------------------"
^DIC(9.4,73,22,9,"PAH",16,1,69,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,70,0)=" "
^DIC(9.4,73,22,9,"PAH",16,1,71,0)="  "
^DIC(9.4,73,22,9,"PAH",16,1,72,0)="   List of Test Sites:"
^DIC(9.4,73,22,9,"PAH",16,1,73,0)="   =================="
^DIC(9.4,73,22,9,"PAH",16,1,74,0)="     Fargo, Madison, Minneapolis, Clarksburg"
^DIC(9.4,73,22,9,"PAH",16,1,75,0)="  "
^DIC(9.4,73,22,9,"PAH",16,1,76,0)="  "
^DIC(9.4,73,22,9,"PAH",16,1,77,0)="  "
^DIC(9.4,73,22,9,"PAH",16,1,78,0)="   ROUTINE SUMMARY                                                  "
^DIC(9.4,73,22,9,"PAH",16,1,79,0)="   ===============                                                  "
^DIC(9.4,73,22,9,"PAH",16,1,80,0)="          "
^DIC(9.4,73,22,9,"PAH",16,1,81,0)="    The following routines are included in this patch.  The"
^DIC(9.4,73,22,9,"PAH",16,1,82,0)="    second line of each of these routines now looks like:"
