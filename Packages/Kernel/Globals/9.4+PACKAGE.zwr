^DIC(9.4,96,22,"B",1.2,1.2)=""
^DIC(9.4,96,"DEV")="STEVE WAGNER"
^DIC(9.4,96,"VERSION")=1.2
^DIC(9.4,97,0)="PHARMACY BENEFITS MANAGEMENT^PSU^PHARMACY BENEFITS MANAGEMENT"
^DIC(9.4,97,1)="national product use on a monthly, quarterly, and annual intervals."
^DIC(9.4,97,1,0)="^^20^20^2980916^^^^"
^DIC(9.4,97,1,1,0)=" ;;Pharmacy Benefits Management (PBM) software extracts statistics from"
^DIC(9.4,97,1,2,0)=" ;;the following files on a monthly basis:"
^DIC(9.4,97,1,3,0)=" ;;"
^DIC(9.4,97,1,4,0)=" ;;File Name                                     File Number"
^DIC(9.4,97,1,5,0)=" ;;---------------------------------------------------------"
^DIC(9.4,97,1,6,0)=" ;;Pharmacy Patient IV Subfile......................55.01"
^DIC(9.4,97,1,7,0)=" ;;Pharmacy Patient UD Subfile......................55.06"
^DIC(9.4,97,1,8,0)=" ;;AR/WS STOCK Stats................................58.5"
^DIC(9.4,97,1,9,0)=" ;;Prescription.....................................52"
^DIC(9.4,97,1,10,0)=" ;;Procurement......................................442, 58.811, 58.81"
^DIC(9.4,97,1,11,0)=" ;;Controlled Substances............................58.81"
^DIC(9.4,97,1,12,0)=" ;;Laboratory.......................................60, 63"
^DIC(9.4,97,1,13,0)=" ;;"
^DIC(9.4,97,1,14,0)=" ;;This data is electronically exported via MailMan to the National"
^DIC(9.4,97,1,15,0)=" ;;PBM Section. These messages are then passed through a translation"
^DIC(9.4,97,1,16,0)=" ;;process to convert all local drug names to a common drug name and all"
^DIC(9.4,97,1,17,0)=" ;;local dispensing units to a common dispensing unit. After translation"
^DIC(9.4,97,1,18,0)=" ;;the information will be added to a national database. The PBM"
^DIC(9.4,97,1,19,0)=" ;;Section will be able to provide information on facility, regional, and"
^DIC(9.4,97,1,20,0)=" ;;national product use on a monthly, quarterly, and annual intervals."
^DIC(9.4,97,5)="BIRM"
^DIC(9.4,97,22,0)="^9.49I^18^3"
^DIC(9.4,97,22,2,0)="2.0^2950811^2960819"
^DIC(9.4,97,22,2,1,0)="^^12^12^2950811^^"
^DIC(9.4,97,22,2,1,1,0)="For the Outpatient & IV statistics, the number of Social Security numbers"
^DIC(9.4,97,22,2,1,2,0)="for each drug is extracted."
^DIC(9.4,97,22,2,1,3,0)=" "
^DIC(9.4,97,22,2,1,4,0)="Consolidated Mail Out Pharmacy (CMOP) data is extracted from Host CMOP"
^DIC(9.4,97,22,2,1,5,0)="facilities."
^DIC(9.4,97,22,2,1,6,0)=" "
^DIC(9.4,97,22,2,1,7,0)="Procurement and Controlled Substances data is now extracted."
^DIC(9.4,97,22,2,1,8,0)=" "
^DIC(9.4,97,22,2,1,9,0)="After the monthly D&PPM report is sent to the D&PPM Section, "
^DIC(9.4,97,22,2,1,10,0)="a confirmation MailMan message will be generated at the facility"
^DIC(9.4,97,22,2,1,11,0)="providing information about the number of drugs extracted for"
^DIC(9.4,97,22,2,1,12,0)="each package."
^DIC(9.4,97,22,2,"PAH",0)="^9.4901^2^2"
^DIC(9.4,97,22,2,"PAH",1,0)="3^2961018^1"
^DIC(9.4,97,22,2,"PAH",1,1,0)="^^3^3^2961018"
^DIC(9.4,97,22,2,"PAH",1,1,1,0)="   The National D&PPM Section has gotten their own domain name to reduce"
^DIC(9.4,97,22,2,"PAH",1,1,2,0)="the amount of traffic coming into the Hines VAMC. Therefore the address"
^DIC(9.4,97,22,2,"PAH",1,1,3,0)="name needs to be changed."
^DIC(9.4,97,22,2,"PAH",2,0)="2^2970217^1"
^DIC(9.4,97,22,2,"PAH",2,1,0)="^^5^5^2970217"
^DIC(9.4,97,22,2,"PAH",2,1,1,0)="This patch addresses NOISs CHA-0296-31865 and NYN-1295-11103. It was"
^DIC(9.4,97,22,2,"PAH",2,1,2,0)="reported that when the D&PPM software is collecting the Outpatient"
^DIC(9.4,97,22,2,"PAH",2,1,3,0)="Pharmacy data, an endless loop can occur when collecting data from"
^DIC(9.4,97,22,2,"PAH",2,1,4,0)="partials. The problem was an incorrect $Select statement which repeatedly"
^DIC(9.4,97,22,2,"PAH",2,1,5,0)="looped on the first node."
^DIC(9.4,97,22,2,"PAH","B",2,2)=""
^DIC(9.4,97,22,2,"PAH","B",3,1)=""
^DIC(9.4,97,22,17,0)="3.0^3051119^2981026^1"
^DIC(9.4,97,22,17,1,0)="^^1^1^3051119"
^DIC(9.4,97,22,17,1,1,0)="Pharmacy Benefits Managment Package"
^DIC(9.4,97,22,17,"PAH",0)="^9.4901^29^29"
^DIC(9.4,97,22,17,"PAH",1,0)="4 SEQ #1^2990602^1"
^DIC(9.4,97,22,17,"PAH",1,1,0)="^^26^26^2990602"
^DIC(9.4,97,22,17,"PAH",1,1,1,0)="The following changes were made to address Y2K compliance issues."
^DIC(9.4,97,22,17,"PAH",1,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",1,1,3,0)="Routine: PSUCP"
^DIC(9.4,97,22,17,"PAH",1,1,4,0)="Line Tag: AUTO+10"
^DIC(9.4,97,22,17,"PAH",1,1,5,0)="Exception: The calculations performed incorrectly when Y2K dates were provided."
^DIC(9.4,97,22,17,"PAH",1,1,6,0)="Resolution: Changed I...to"
^DIC(9.4,97,22,17,"PAH",1,1,7,0)="   I $E(PSUMON,4,5)=""00"" S PSUMON=($E(PSUMON,1,3)-1)_""12"" ; set to"
^DIC(9.4,97,22,17,"PAH",1,1,8,0)="...Dec. of previous year if this month is Jan."
^DIC(9.4,97,22,17,"PAH",1,1,9,0)="                 "
^DIC(9.4,97,22,17,"PAH",1,1,10,0)="Routine: PSUCP"
^DIC(9.4,97,22,17,"PAH",1,1,11,0)="Line Tag: AUTO+11"
^DIC(9.4,97,22,17,"PAH",1,1,12,0)="Exception: The calculations performed incorrectly when Y2K dates were provided."
^DIC(9.4,97,22,17,"PAH",1,1,13,0)="Resolution: Changed S...to"
^DIC(9.4,97,22,17,"PAH",1,1,14,0)="   S PSUSDT=PSUMON_""01"""
^DIC(9.4,97,22,17,"PAH",1,1,15,0)="   S PSULY=$$LEAPYR(PSUMON)"
^DIC(9.4,97,22,17,"PAH",1,1,16,0)="   S X=U_$E(PSUMON,4,5)_U"
^DIC(9.4,97,22,17,"PAH",1,1,17,0)=" "
^DIC(9.4,97,22,17,"PAH",1,1,18,0)="Routine: PSUCP"
^DIC(9.4,97,22,17,"PAH",1,1,19,0)="Line Tag: TIMINGQ+1"
^DIC(9.4,97,22,17,"PAH",1,1,20,0)="Exception: The calculations performed incorrectly when Y2K dates were provided."
^DIC(9.4,97,22,17,"PAH",1,1,21,0)="Resolution: Added..."
^DIC(9.4,97,22,17,"PAH",1,1,22,0)="   ;"
^DIC(9.4,97,22,17,"PAH",1,1,23,0)="LEAPYR(FMYR); Check to see if year is a leap year: 1=leap year, 0=not leap year"
^DIC(9.4,97,22,17,"PAH",1,1,24,0)="   N YYYY"
^DIC(9.4,97,22,17,"PAH",1,1,25,0)="   S YYYY=1700+$E(FMYR,1,3)"
^DIC(9.4,97,22,17,"PAH",1,1,26,0)="   Q (((YYYY#4=0)&(YYYY#100'=0))!((YYYY#100=0)&(YYYY#400=0)))"
^DIC(9.4,97,22,17,"PAH",2,0)="5 SEQ #2^2990719^1"
^DIC(9.4,97,22,17,"PAH",2,1,0)="^^14^14^2990719"
^DIC(9.4,97,22,17,"PAH",2,1,1,0)="Problems resolved with this patch:"
^DIC(9.4,97,22,17,"PAH",2,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,3,0)="1. The domain for the transmissions to Hines has changed."
^DIC(9.4,97,22,17,"PAH",2,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,5,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",2,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,7,0)="The domain has been changed to be CMOP-HINES.DOMAIN.EXT"
^DIC(9.4,97,22,17,"PAH",2,1,8,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,9,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,10,0)="2. ""Pharamacy"" is used and is misspelled in PSUCP."
^DIC(9.4,97,22,17,"PAH",2,1,11,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,12,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",2,1,13,0)=" "
^DIC(9.4,97,22,17,"PAH",2,1,14,0)="""Pharamacy"" has been changed to ""Pharmacy"""
^DIC(9.4,97,22,17,"PAH",3,0)="1 SEQ #3^2990719^1"
^DIC(9.4,97,22,17,"PAH",3,1,0)="^^180^180^2990719"
^DIC(9.4,97,22,17,"PAH",3,1,1,0)="Problems resolved with this patch:"
^DIC(9.4,97,22,17,"PAH",3,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,3,0)="1. The XM mailer hung in the background looking for user input. Modules"
^DIC(9.4,97,22,17,"PAH",3,1,4,0)="needing to send more than one detailed message to Hines for a division"
^DIC(9.4,97,22,17,"PAH",3,1,5,0)="were getting hung in the background. The XMY array needed to be recreated"
^DIC(9.4,97,22,17,"PAH",3,1,6,0)="for each subsequent message."
^DIC(9.4,97,22,17,"PAH",3,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,8,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,9,0)="RIC-1198-20912"
^DIC(9.4,97,22,17,"PAH",3,1,10,0)="HIN-1198-41911"
^DIC(9.4,97,22,17,"PAH",3,1,11,0)="NTH-0199-72479"
^DIC(9.4,97,22,17,"PAH",3,1,12,0)="TAM-0299-30835"
^DIC(9.4,97,22,17,"PAH",3,1,13,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,14,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,15,0)="The XMY array is now properly reset providing the address for the"
^DIC(9.4,97,22,17,"PAH",3,1,16,0)="subsequent messages."
^DIC(9.4,97,22,17,"PAH",3,1,17,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,18,0)="2. Unit Dose generates an allocation error. The PSUTA array used in the"
^DIC(9.4,97,22,17,"PAH",3,1,19,0)="unit dose extract grows too large for the local partition."
^DIC(9.4,97,22,17,"PAH",3,1,20,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,21,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,22,0)="ALX-1298-71646"
^DIC(9.4,97,22,17,"PAH",3,1,23,0)="DEN-0199-51099"
^DIC(9.4,97,22,17,"PAH",3,1,24,0)="BED-0299-11199"
^DIC(9.4,97,22,17,"PAH",3,1,25,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,26,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,27,0)="The PSUTA array has been moved to the ^TMP global."
^DIC(9.4,97,22,17,"PAH",3,1,28,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,29,0)="3. Procurement generates an allocation error. The PSUMIT array grows too"
^DIC(9.4,97,22,17,"PAH",3,1,30,0)="large for the local partition."
^DIC(9.4,97,22,17,"PAH",3,1,31,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,32,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,33,0)="IOW-1198-40646"
^DIC(9.4,97,22,17,"PAH",3,1,34,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,35,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,36,0)="The PSUMIT array has been moved to the ^TMP global."
^DIC(9.4,97,22,17,"PAH",3,1,37,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,38,0)="4. The procurement module has cost calculation and dividing by zero"
^DIC(9.4,97,22,17,"PAH",3,1,39,0)="errors."
^DIC(9.4,97,22,17,"PAH",3,1,40,0)="The procurement costing equation was wrong and there were cases when one"
^DIC(9.4,97,22,17,"PAH",3,1,41,0)="of the cost-per-unit factors used in the calculations were not available"
^DIC(9.4,97,22,17,"PAH",3,1,42,0)="and zero was being used for division."
^DIC(9.4,97,22,17,"PAH",3,1,43,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,44,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,45,0)="NYN-1298-10759"
^DIC(9.4,97,22,17,"PAH",3,1,46,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,47,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,48,0)="The formulas for costing factors have been amended. In cases"
^DIC(9.4,97,22,17,"PAH",3,1,49,0)="where the cost factors are not available the reports have been amended"
^DIC(9.4,97,22,17,"PAH",3,1,50,0)="to reflect null or NA in the reports."
^DIC(9.4,97,22,17,"PAH",3,1,51,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,52,0)="5. The outpatient extracts shows the wrong division in the message"
^DIC(9.4,97,22,17,"PAH",3,1,53,0)="headers. The software was pulling division names from File #40.8 instead"
^DIC(9.4,97,22,17,"PAH",3,1,54,0)="of File #59."
^DIC(9.4,97,22,17,"PAH",3,1,55,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,56,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,57,0)="IOW-0199-41095"
^DIC(9.4,97,22,17,"PAH",3,1,58,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,59,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,60,0)="Routines PSUOP4, PSUOP6 have been modified to pull division names from"
^DIC(9.4,97,22,17,"PAH",3,1,61,0)="File #59."
^DIC(9.4,97,22,17,"PAH",3,1,62,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,63,0)="6. Division names for AR/WS, Procurement, and CS in the headers are not"
^DIC(9.4,97,22,17,"PAH",3,1,64,0)="matching the facility numbers. The coded lookup from File #40.8 is pulling"
^DIC(9.4,97,22,17,"PAH",3,1,65,0)="up entries associated with IENs instead of facility numbers."
^DIC(9.4,97,22,17,"PAH",3,1,66,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,67,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,68,0)="CTX-1198-71660"
^DIC(9.4,97,22,17,"PAH",3,1,69,0)="MON-1298-52507"
^DIC(9.4,97,22,17,"PAH",3,1,70,0)="POR-0199-52307"
^DIC(9.4,97,22,17,"PAH",3,1,71,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,72,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,73,0)="The existence of a .001 field allows the pulling up of names by IEN"
^DIC(9.4,97,22,17,"PAH",3,1,74,0)="numbers. The lookups for names by facility number is now coded to limit"
^DIC(9.4,97,22,17,"PAH",3,1,75,0)="the search to the 'C' cross-reference only."
^DIC(9.4,97,22,17,"PAH",3,1,76,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,77,0)="7. The AR/WS extract is generating subscript errors at DIV+6^PSUAR1. There"
^DIC(9.4,97,22,17,"PAH",3,1,78,0)="are inpatient locations that may not be linked to the PHARMACY AOU STOCK"
^DIC(9.4,97,22,17,"PAH",3,1,79,0)="file (#58.1)."
^DIC(9.4,97,22,17,"PAH",3,1,80,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,81,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,82,0)="MON-1198-50086"
^DIC(9.4,97,22,17,"PAH",3,1,83,0)="CLA-1298-20491"
^DIC(9.4,97,22,17,"PAH",3,1,84,0)="CHA-0199-30249"
^DIC(9.4,97,22,17,"PAH",3,1,85,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,86,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,87,0)="The coding in PSUAR1 has been modified to accommodate cases where"
^DIC(9.4,97,22,17,"PAH",3,1,88,0)="inpatient locations are not linked within the PHARMACY AOU Stock File"
^DIC(9.4,97,22,17,"PAH",3,1,89,0)="(#58.1)."
^DIC(9.4,97,22,17,"PAH",3,1,90,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,91,0)="8. The PSUARNM array is growing too large for the local partition in the"
^DIC(9.4,97,22,17,"PAH",3,1,92,0)="AR/WS extract and generates allocation errors."
^DIC(9.4,97,22,17,"PAH",3,1,93,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,94,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,95,0)="OKL-1198-70175"
^DIC(9.4,97,22,17,"PAH",3,1,96,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,97,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,98,0)="The PSUARNM array has been moved to ^TMP for storage and processing in"
^DIC(9.4,97,22,17,"PAH",3,1,99,0)="routine PSUAR4."
^DIC(9.4,97,22,17,"PAH",3,1,100,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,101,0)="9. Some Mail message headers showing a 'null' user identity. The variable"
^DIC(9.4,97,22,17,"PAH",3,1,102,0)="XMDUZ was not being reset for subsequent messages."
^DIC(9.4,97,22,17,"PAH",3,1,103,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,104,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,105,0)="The variable XMDUZ is set for each message generated."
^DIC(9.4,97,22,17,"PAH",3,1,106,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,107,0)="10. IV statistics are wrong. A mix of calculation variables being used"
^DIC(9.4,97,22,17,"PAH",3,1,108,0)="were wrong."
^DIC(9.4,97,22,17,"PAH",3,1,109,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,110,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,111,0)="The proper variables were identified and calculations re-coded."
^DIC(9.4,97,22,17,"PAH",3,1,112,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,113,0)="11. The Controlled Substance Statistical Data report columns need to be"
^DIC(9.4,97,22,17,"PAH",3,1,114,0)="better aligned and the footnotes ""* Non-Formulary"" and ""# Not on National"
^DIC(9.4,97,22,17,"PAH",3,1,115,0)="Formulary"""" are missing."
^DIC(9.4,97,22,17,"PAH",3,1,116,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,117,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,118,0)="The Controlled Substance Statistical Data report has been modified."
^DIC(9.4,97,22,17,"PAH",3,1,119,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,120,0)="12. The Controlled Substance extract errors out when a type 2 transaction"
^DIC(9.4,97,22,17,"PAH",3,1,121,0)="has a quantity = 0."
^DIC(9.4,97,22,17,"PAH",3,1,122,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,123,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,124,0)="MUR-0199-31080"
^DIC(9.4,97,22,17,"PAH",3,1,125,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,126,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,127,0)="The logic has been modified to quit the transmission of a record when the"
^DIC(9.4,97,22,17,"PAH",3,1,128,0)="quantity = 0."
^DIC(9.4,97,22,17,"PAH",3,1,129,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,130,0)="13. The procurement extract was building lines in the MailMan messages"
^DIC(9.4,97,22,17,"PAH",3,1,131,0)="that were exceeding MailMan acceptable parameters."
^DIC(9.4,97,22,17,"PAH",3,1,132,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,133,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,134,0)="LON-1198-60747"
^DIC(9.4,97,22,17,"PAH",3,1,135,0)="LEB-0299-20160"
^DIC(9.4,97,22,17,"PAH",3,1,136,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,137,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,138,0)="The length of the description of items contained in the extract have been"
^DIC(9.4,97,22,17,"PAH",3,1,139,0)="limited to 50 characters."
^DIC(9.4,97,22,17,"PAH",3,1,140,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,141,0)="14. Undefined variable error in the procurement extract was generated due"
^DIC(9.4,97,22,17,"PAH",3,1,142,0)="to data arrays not being initialized properly."
^DIC(9.4,97,22,17,"PAH",3,1,143,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,144,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,145,0)="EKH-0199-42100"
^DIC(9.4,97,22,17,"PAH",3,1,146,0)="NAS-0299-30308"
^DIC(9.4,97,22,17,"PAH",3,1,147,0)="WPB-0299-31308"
^DIC(9.4,97,22,17,"PAH",3,1,148,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,149,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,150,0)="The data arrays are properly initialized."
^DIC(9.4,97,22,17,"PAH",3,1,151,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,152,0)="15. Controlled Substance reports are improperly flagging formulary drugs"
^DIC(9.4,97,22,17,"PAH",3,1,153,0)="as non-formulary."
^DIC(9.4,97,22,17,"PAH",3,1,154,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,155,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,156,0)="MAR-0299-21304"
^DIC(9.4,97,22,17,"PAH",3,1,157,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,158,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,159,0)="The logic for flagging the formulary status has been corrected."
^DIC(9.4,97,22,17,"PAH",3,1,160,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,161,0)="16. The AR extracts would send out multiple detailed messages whose"
^DIC(9.4,97,22,17,"PAH",3,1,162,0)="contents were duplicates. This was caused by the array holding the data"
^DIC(9.4,97,22,17,"PAH",3,1,163,0)="not being initialized properly."
^DIC(9.4,97,22,17,"PAH",3,1,164,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,165,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,166,0)="HIN-0199-41269"
^DIC(9.4,97,22,17,"PAH",3,1,167,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,168,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,169,0)="The code has been modified to properly initialize the data array."
^DIC(9.4,97,22,17,"PAH",3,1,170,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,171,0)="17. The costing formula in the procurement extract includes a $J function"
^DIC(9.4,97,22,17,"PAH",3,1,172,0)="which failed when the parameters of the formula were modified. The formula"
^DIC(9.4,97,22,17,"PAH",3,1,173,0)="was proper but the calculation was then too complex for the $J function."
^DIC(9.4,97,22,17,"PAH",3,1,174,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,175,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",3,1,176,0)="CAH-1298-30287"
^DIC(9.4,97,22,17,"PAH",3,1,177,0)=" "
^DIC(9.4,97,22,17,"PAH",3,1,178,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",3,1,179,0)="The code was changed to perform the calculation first outside of the $J"
^DIC(9.4,97,22,17,"PAH",3,1,180,0)="function and then hand the result to the $J function."
^DIC(9.4,97,22,17,"PAH",4,0)="3 SEQ #4^2991003^1"
^DIC(9.4,97,22,17,"PAH",4,1,0)="^^35^35^2991003"
^DIC(9.4,97,22,17,"PAH",4,1,1,0)="Problems resolved with this patch:"
^DIC(9.4,97,22,17,"PAH",4,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,3,0)="1. The local array PSUMIT needed to be moved to ^TMP."
^DIC(9.4,97,22,17,"PAH",4,1,4,0)="  "
^DIC(9.4,97,22,17,"PAH",4,1,5,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",4,1,6,0)="The array was moved into ^TMP( storage."
^DIC(9.4,97,22,17,"PAH",4,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,8,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",4,1,9,0)="LIT-0499-70942"
^DIC(9.4,97,22,17,"PAH",4,1,10,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,11,0)="2. The AR/WS extract was setting the division number to zero when it"
^DIC(9.4,97,22,17,"PAH",4,1,12,0)="didn't find data to transmit."
^DIC(9.4,97,22,17,"PAH",4,1,13,0)="   "
^DIC(9.4,97,22,17,"PAH",4,1,14,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",4,1,15,0)="The division indicator is set to the default facility ID when no data is"
^DIC(9.4,97,22,17,"PAH",4,1,16,0)="found for transmission."
^DIC(9.4,97,22,17,"PAH",4,1,17,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,18,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",4,1,19,0)="ISH-0399-40149"
^DIC(9.4,97,22,17,"PAH",4,1,20,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,21,0)="3. The IV extract was using a logic test incorrectly and the formulary"
^DIC(9.4,97,22,17,"PAH",4,1,22,0)="flag indicator was not being set properly for extraction."
^DIC(9.4,97,22,17,"PAH",4,1,23,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,24,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",4,1,25,0)="The logic statement being used has been corrected."
^DIC(9.4,97,22,17,"PAH",4,1,26,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,27,0)="NOIS:"
^DIC(9.4,97,22,17,"PAH",4,1,28,0)="MAR-0399-20146"
^DIC(9.4,97,22,17,"PAH",4,1,29,0)=" "
^DIC(9.4,97,22,17,"PAH",4,1,30,0)="4. Some quantity fields have alpha suffixes which needed to be removed"
^DIC(9.4,97,22,17,"PAH",4,1,31,0)="prior to being entered into the data export."
^DIC(9.4,97,22,17,"PAH",4,1,32,0)="  "
^DIC(9.4,97,22,17,"PAH",4,1,33,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",4,1,34,0)="The quantity fields now have all alpha suffixes removed prior to message"
^DIC(9.4,97,22,17,"PAH",4,1,35,0)="construction."
^DIC(9.4,97,22,17,"PAH",5,0)="7 SEQ #5^2991019^1"
^DIC(9.4,97,22,17,"PAH",5,1,0)="^^3^3^2991019"
^DIC(9.4,97,22,17,"PAH",5,1,1,0)="This patch contains DBIA notation additions to routines that were"
^DIC(9.4,97,22,17,"PAH",5,1,2,0)="released within PSU*3*1. No functional changes have been made to these"
^DIC(9.4,97,22,17,"PAH",5,1,3,0)="routines."
^DIC(9.4,97,22,17,"PAH",6,0)="6 SEQ #6^2991210^1"
^DIC(9.4,97,22,17,"PAH",6,1,0)="^^7^7^2991210"
^DIC(9.4,97,22,17,"PAH",6,1,1,0)="Problems resolved with this patch:"
^DIC(9.4,97,22,17,"PAH",6,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",6,1,3,0)="1. The CS reports were reporting statistics incorrectly."
^DIC(9.4,97,22,17,"PAH",6,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",6,1,5,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",6,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",6,1,7,0)="The code in the CS statistics has been corrected."
^DIC(9.4,97,22,17,"PAH",7,0)="8 SEQ #7^2991210^1"
^DIC(9.4,97,22,17,"PAH",7,1,0)="^^30^30^2991210"
^DIC(9.4,97,22,17,"PAH",7,1,1,0)="1. Problem: "
^DIC(9.4,97,22,17,"PAH",7,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,3,0)="The GETM^PSUTL API pulls all data fields within a specified multiple. This"
^DIC(9.4,97,22,17,"PAH",7,1,4,0)="may lead to generation of allocation errors and makes DBIA tracking"
^DIC(9.4,97,22,17,"PAH",7,1,5,0)="difficult."
^DIC(9.4,97,22,17,"PAH",7,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,7,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",7,1,8,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,9,0)="The GETM^PSUTL was modified to require the itemizing of fields to be"
^DIC(9.4,97,22,17,"PAH",7,1,10,0)="pulled and returns only the fields specified from the multiple identified."
^DIC(9.4,97,22,17,"PAH",7,1,11,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,12,0)="2. Problem:"
^DIC(9.4,97,22,17,"PAH",7,1,13,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,14,0)="The automatic completion checker is falsely reporting incomplete runs. It"
^DIC(9.4,97,22,17,"PAH",7,1,15,0)="is scheduled to run 24 hours after the extract has started. Large sites"
^DIC(9.4,97,22,17,"PAH",7,1,16,0)="are seeing extracts that are taking more than 24 hours. "
^DIC(9.4,97,22,17,"PAH",7,1,17,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,18,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",7,1,19,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,20,0)="The automatic completion checker is now scheduled to run 72 hours after"
^DIC(9.4,97,22,17,"PAH",7,1,21,0)="the start of the extract."
^DIC(9.4,97,22,17,"PAH",7,1,22,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,23,0)="3. Problem:"
^DIC(9.4,97,22,17,"PAH",7,1,24,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,25,0)="The procurement extract for File #58.8 DRUG ACCOUNTABILITY STATS is"
^DIC(9.4,97,22,17,"PAH",7,1,26,0)="looking for IV rooms in the wrong file."
^DIC(9.4,97,22,17,"PAH",7,1,27,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,28,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",7,1,29,0)=" "
^DIC(9.4,97,22,17,"PAH",7,1,30,0)="The code has been changed to look for IV rooms in the file # 58.8."
^DIC(9.4,97,22,17,"PAH",8,0)="9 SEQ #8^3000417^1"
^DIC(9.4,97,22,17,"PAH",8,1,0)="^^10^10^3000417"
^DIC(9.4,97,22,17,"PAH",8,1,1,0)="Problem: "
^DIC(9.4,97,22,17,"PAH",8,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",8,1,3,0)="The Controlled Substances extract is sending records that it should not."
^DIC(9.4,97,22,17,"PAH",8,1,4,0)="It has tested them and found them to fail the sending criteria. The"
^DIC(9.4,97,22,17,"PAH",8,1,5,0)="software still sends the record."
^DIC(9.4,97,22,17,"PAH",8,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",8,1,7,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",8,1,8,0)=" "
^DIC(9.4,97,22,17,"PAH",8,1,9,0)="Proper rejection flags were put in place between the testing and sending"
^DIC(9.4,97,22,17,"PAH",8,1,10,0)="portions of the program."
^DIC(9.4,97,22,17,"PAH",9,0)="10 SEQ #9^3000525^1"
^DIC(9.4,97,22,17,"PAH",9,1,0)="^^19^19^3000525"
^DIC(9.4,97,22,17,"PAH",9,1,1,0)="1. Problem: "
^DIC(9.4,97,22,17,"PAH",9,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,3,0)="The AR/WS Statistical Summary reports ""NO DATA"" when in fact data is"
^DIC(9.4,97,22,17,"PAH",9,1,4,0)="present in other reports and is being extracted and sent."
^DIC(9.4,97,22,17,"PAH",9,1,5,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,6,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",9,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,8,0)="Code has been corrected and the report reflects statistical data properly."
^DIC(9.4,97,22,17,"PAH",9,1,9,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,10,0)="2. Problem:"
^DIC(9.4,97,22,17,"PAH",9,1,11,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,12,0)="The auto error checker is sending a false error message even though the"
^DIC(9.4,97,22,17,"PAH",9,1,13,0)="extract ran to completion and reports were sent."
^DIC(9.4,97,22,17,"PAH",9,1,14,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,15,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",9,1,16,0)=" "
^DIC(9.4,97,22,17,"PAH",9,1,17,0)="The error checker tracking of the start time has been adjusted to reflect"
^DIC(9.4,97,22,17,"PAH",9,1,18,0)="the three day interval between starting the extract and the queuing of the"
^DIC(9.4,97,22,17,"PAH",9,1,19,0)="checker's task."
^DIC(9.4,97,22,17,"PAH",10,0)="11 SEQ #10^3000612^1"
^DIC(9.4,97,22,17,"PAH",10,1,0)="^^9^9^3000612"
^DIC(9.4,97,22,17,"PAH",10,1,1,0)="Problem: "
^DIC(9.4,97,22,17,"PAH",10,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",10,1,3,0)="The AR/WS data report is printing spurious items in the message when the"
^DIC(9.4,97,22,17,"PAH",10,1,4,0)="report is reporting ""No data to report"""
^DIC(9.4,97,22,17,"PAH",10,1,5,0)=" "
^DIC(9.4,97,22,17,"PAH",10,1,6,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",10,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",10,1,8,0)="The array being passed to Mailman had left over data in non-numbered nodes"
^DIC(9.4,97,22,17,"PAH",10,1,9,0)="from previous calculations. The array is now properly initialized."
^DIC(9.4,97,22,17,"PAH",11,0)="12 SEQ #11^3001027^1"
^DIC(9.4,97,22,17,"PAH",11,1,0)="^^8^8^3001027"
^DIC(9.4,97,22,17,"PAH",11,1,1,0)="1. Problem: The Pharmacy Benefits Controlled Substance extract is dropping"
^DIC(9.4,97,22,17,"PAH",11,1,2,0)="the breakdown unit and package size information from some of the category"
^DIC(9.4,97,22,17,"PAH",11,1,3,0)="2 drug prescriptions in the PBM CS Statistical Data report."
^DIC(9.4,97,22,17,"PAH",11,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",11,1,5,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",11,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",11,1,7,0)="The coding has been corrected and the appropriate breakdown unit and"
^DIC(9.4,97,22,17,"PAH",11,1,8,0)="package size information is being presented."
^DIC(9.4,97,22,17,"PAH",12,0)="14 SEQ #12^3010103^1"
^DIC(9.4,97,22,17,"PAH",12,1,0)="^^2^2^3010103"
^DIC(9.4,97,22,17,"PAH",12,1,1,0)="Pharmacy Benefits Management (PBM) has requested additional data elements"
^DIC(9.4,97,22,17,"PAH",12,1,2,0)="to be included in the pharmacy extracts.  This patch adds those additional elements."
^DIC(9.4,97,22,17,"PAH",13,0)="15 SEQ #13^3010202^1"
^DIC(9.4,97,22,17,"PAH",13,1,0)="^^7^7^3010202"
^DIC(9.4,97,22,17,"PAH",13,1,1,0)="The IV solution data record has an extra ^^^^ element and several NO DATA"
^DIC(9.4,97,22,17,"PAH",13,1,2,0)="entries that should not be there. "
^DIC(9.4,97,22,17,"PAH",13,1,3,0)=" "
^DIC(9.4,97,22,17,"PAH",13,1,4,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",13,1,5,0)=" "
^DIC(9.4,97,22,17,"PAH",13,1,6,0)="The code within the IV solution data record building has been modified so"
^DIC(9.4,97,22,17,"PAH",13,1,7,0)="that the data elements are proper."
^DIC(9.4,97,22,17,"PAH",14,0)="17 SEQ #14^3010507^1"
^DIC(9.4,97,22,17,"PAH",14,1,0)="^^9^9^3010507"
^DIC(9.4,97,22,17,"PAH",14,1,1,0)="1. Problem:"
^DIC(9.4,97,22,17,"PAH",14,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",14,1,3,0)="Some PBM reports do not process correctly  and other reports are"
^DIC(9.4,97,22,17,"PAH",14,1,4,0)="incorrect."
^DIC(9.4,97,22,17,"PAH",14,1,5,0)=" "
^DIC(9.4,97,22,17,"PAH",14,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",14,1,7,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",14,1,8,0)=" "
^DIC(9.4,97,22,17,"PAH",14,1,9,0)="Routine PSUPR2 modified to accommodate new location naming conventions."
^DIC(9.4,97,22,17,"PAH",15,0)="16 SEQ #15^3011106^1"
^DIC(9.4,97,22,17,"PAH",15,1,0)="^^23^23^3011106"
^DIC(9.4,97,22,17,"PAH",15,1,1,0)="1. The outpatient extracts utilize the fill date of prescriptions for"
^DIC(9.4,97,22,17,"PAH",15,1,2,0)="processing. It is desired to use the release date instead of the fill date"
^DIC(9.4,97,22,17,"PAH",15,1,3,0)="for processing."
^DIC(9.4,97,22,17,"PAH",15,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,5,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",15,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,7,0)="The outpatient extracts have been reprogrammed to process prescriptions by"
^DIC(9.4,97,22,17,"PAH",15,1,8,0)="their release date."
^DIC(9.4,97,22,17,"PAH",15,1,9,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,10,0)="2. The current extracts are shipping data for test patients which is"
^DIC(9.4,97,22,17,"PAH",15,1,11,0)="undesirable."
^DIC(9.4,97,22,17,"PAH",15,1,12,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,13,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",15,1,14,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,15,0)="The extracts have been coded to exclude test patients."
^DIC(9.4,97,22,17,"PAH",15,1,16,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,17,0)="3. The procurement extracts generates an error when an alpha-numeric prime"
^DIC(9.4,97,22,17,"PAH",15,1,18,0)="vendor number is encountered."
^DIC(9.4,97,22,17,"PAH",15,1,19,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,20,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",15,1,21,0)=" "
^DIC(9.4,97,22,17,"PAH",15,1,22,0)="The procurement extract has been corrected to allow alpha-numeric prime"
^DIC(9.4,97,22,17,"PAH",15,1,23,0)="vendor numbers."
^DIC(9.4,97,22,17,"PAH",16,0)="18 SEQ #16^3011121^1"
^DIC(9.4,97,22,17,"PAH",16,1,0)="^^17^17^3011121"
^DIC(9.4,97,22,17,"PAH",16,1,1,0)="Problem:"
^DIC(9.4,97,22,17,"PAH",16,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",16,1,3,0)="When the Automatic Pharmacy Statistics [PSU PBM AUTO] option extract is "
^DIC(9.4,97,22,17,"PAH",16,1,4,0)="run,"
^DIC(9.4,97,22,17,"PAH",16,1,5,0)="the following error is generated:"
^DIC(9.4,97,22,17,"PAH",16,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",16,1,7,0)="<UNDEFINED>COMVAR+2"
^DIC(9.4,97,22,17,"PAH",16,1,8,0)=" S PSUSIG=$P( ^TMP(""PSOR"",$J,PSURXIEN,""SIG"",1,0),U,1)"
^DIC(9.4,97,22,17,"PAH",16,1,9,0)=" "
^DIC(9.4,97,22,17,"PAH",16,1,10,0)="In some instances, the right node does not exist, causing the"
^DIC(9.4,97,22,17,"PAH",16,1,11,0)="error to be generated."
^DIC(9.4,97,22,17,"PAH",16,1,12,0)=" "
^DIC(9.4,97,22,17,"PAH",16,1,13,0)=" "
^DIC(9.4,97,22,17,"PAH",16,1,14,0)="Resolution:"
^DIC(9.4,97,22,17,"PAH",16,1,15,0)=" "
^DIC(9.4,97,22,17,"PAH",16,1,16,0)="The solution is to check for the existence of the right node.  If it does"
^DIC(9.4,97,22,17,"PAH",16,1,17,0)="not exist, the program bypasses the line of code without error."
^DIC(9.4,97,22,17,"PAH",17,0)="19 SEQ #17^3020626^1"
^DIC(9.4,97,22,17,"PAH",17,1,0)="^^15^15^3020626"
^DIC(9.4,97,22,17,"PAH",17,1,1,0)="This patch includes the creation of new Pharmacy Benefits Management"
^DIC(9.4,97,22,17,"PAH",17,1,2,0)="extracts and summary reports as well as modifications to existing "
^DIC(9.4,97,22,17,"PAH",17,1,3,0)="extracts."
^DIC(9.4,97,22,17,"PAH",17,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",17,1,5,0)="New extracts are (1) Patient Demographics, (2) Outpatient Visits, (3)"
^DIC(9.4,97,22,17,"PAH",17,1,6,0)="Inpatient PTF Records, (4) Provider data."
^DIC(9.4,97,22,17,"PAH",17,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",17,1,8,0)="New summary reports are (1) Patient Demographic summaries for the IV, "
^DIC(9.4,97,22,17,"PAH",17,1,9,0)="Unit Dose, and Prescription extracts, (2) Provider data summary."
^DIC(9.4,97,22,17,"PAH",17,1,10,0)=" "
^DIC(9.4,97,22,17,"PAH",17,1,11,0)="Modified extracts are (1) IV, (2) Unit Dose, (3) Prescription, (4) "
^DIC(9.4,97,22,17,"PAH",17,1,12,0)="Controlled Substance."
^DIC(9.4,97,22,17,"PAH",17,1,13,0)=" "
^DIC(9.4,97,22,17,"PAH",17,1,14,0)="Users are also provided with the ability to generate a detailed MailMan"
^DIC(9.4,97,22,17,"PAH",17,1,15,0)="message without having to transmit to the PBM database at Hines."
^DIC(9.4,97,22,17,"PAH",18,0)="21 SEQ #18^3030109^1"
^DIC(9.4,97,22,17,"PAH",18,1,0)="^^18^18^3030109"
^DIC(9.4,97,22,17,"PAH",18,1,1,0)="This patch contains modifications to the Pharmacy Benefits Management "
^DIC(9.4,97,22,17,"PAH",18,1,2,0)="package."
^DIC(9.4,97,22,17,"PAH",18,1,3,0)=" "
^DIC(9.4,97,22,17,"PAH",18,1,4,0)="1. The Patient Demographics extract will transmit new Ethnicity and "
^DIC(9.4,97,22,17,"PAH",18,1,5,0)="multiple Race fields.  The new fields comply with the new Race and "
^DIC(9.4,97,22,17,"PAH",18,1,6,0)="Ethnicity Standards as set forth by the Office of Management and Budget."
^DIC(9.4,97,22,17,"PAH",18,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",18,1,8,0)="Old race information will continue to be extracted when it is present.  "
^DIC(9.4,97,22,17,"PAH",18,1,9,0)="New ethnicity and race information will be extracted as it is available."
^DIC(9.4,97,22,17,"PAH",18,1,10,0)=" "
^DIC(9.4,97,22,17,"PAH",18,1,11,0)=" "
^DIC(9.4,97,22,17,"PAH",18,1,12,0)="2. This patch also corrects the following problem:  Sites that are not "
^DIC(9.4,97,22,17,"PAH",18,1,13,0)="using the Surgery package receive a ""missing routine"" error"
^DIC(9.4,97,22,17,"PAH",18,1,14,0)="because the PBM extract incorrectly makes a call to a supported Surgery "
^DIC(9.4,97,22,17,"PAH",18,1,15,0)="API."
^DIC(9.4,97,22,17,"PAH",18,1,16,0)=" "
^DIC(9.4,97,22,17,"PAH",18,1,17,0)="Solution:  The code is altered to omit reference to the Surgery API, and "
^DIC(9.4,97,22,17,"PAH",18,1,18,0)="replaces it with a call appropriate to PBM."
^DIC(9.4,97,22,17,"PAH",19,0)="20 SEQ #19^3030123^1"
^DIC(9.4,97,22,17,"PAH",19,1,0)="^^34^34^3030123"
^DIC(9.4,97,22,17,"PAH",19,1,1,0)="Problem 1:"
^DIC(9.4,97,22,17,"PAH",19,1,2,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,3,0)="For the Manual Pharmacy Statistics [PSU PBM MANUAL] option, the date range"
^DIC(9.4,97,22,17,"PAH",19,1,4,0)="for the February extract does not distinguish leap years from non-leap"
^DIC(9.4,97,22,17,"PAH",19,1,5,0)="years.  The end date for the February extract on all reports other than "
^DIC(9.4,97,22,17,"PAH",19,1,6,0)="the Timing and Confirmation messages is always recorded as February "
^DIC(9.4,97,22,17,"PAH",19,1,7,0)="29, regardless of whether it is a leap year or not."
^DIC(9.4,97,22,17,"PAH",19,1,8,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,9,0)="In addition, on the PBM Timing and Confirmation messages, February"
^DIC(9.4,97,22,17,"PAH",19,1,10,0)="29 is not recognized as a legitimate end date for the February extract in"
^DIC(9.4,97,22,17,"PAH",19,1,11,0)="non-leap years.  Therefore the end date defaults to the start date and the"
^DIC(9.4,97,22,17,"PAH",19,1,12,0)="date range displays as February 1 to February 1."
^DIC(9.4,97,22,17,"PAH",19,1,13,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,14,0)="Resolution 1:"
^DIC(9.4,97,22,17,"PAH",19,1,15,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,16,0)="The code for the Manual Pharmacy Statistics [PSU PBM MANUAL] "
^DIC(9.4,97,22,17,"PAH",19,1,17,0)="option is altered to take leap years into account so that the correct "
^DIC(9.4,97,22,17,"PAH",19,1,18,0)="February date range is displayed on all PBM messages."
^DIC(9.4,97,22,17,"PAH",19,1,19,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,20,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,21,0)="Problem 2:"
^DIC(9.4,97,22,17,"PAH",19,1,22,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,23,0)="At some facilities the Mailman message subject header on the PBM "
^DIC(9.4,97,22,17,"PAH",19,1,24,0)="Messages displays only the facility/division number, and does not "
^DIC(9.4,97,22,17,"PAH",19,1,25,0)="display the name of the facility/division."
^DIC(9.4,97,22,17,"PAH",19,1,26,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,27,0)="Resolution 2:"
^DIC(9.4,97,22,17,"PAH",19,1,28,0)=" "
^DIC(9.4,97,22,17,"PAH",19,1,29,0)="There are two possible solutions to this problem.  (1) Some sites have"
^DIC(9.4,97,22,17,"PAH",19,1,30,0)="assigned more than one division name to a division number in file "
^DIC(9.4,97,22,17,"PAH",19,1,31,0)="#40.8.  In these instances, a user at the site should correct the file"
^DIC(9.4,97,22,17,"PAH",19,1,32,0)="definitions so that only one division name is assigned to one division "
^DIC(9.4,97,22,17,"PAH",19,1,33,0)="number.  (2) The code is altered to correct missing division names on "
^DIC(9.4,97,22,17,"PAH",19,1,34,0)="the message headers when the problem is not user error."
^DIC(9.4,97,22,17,"PAH",20,0)="23 SEQ #20^3030329^1"
^DIC(9.4,97,22,17,"PAH",20,1,0)="^^10^10^3030329"
^DIC(9.4,97,22,17,"PAH",20,1,1,0)="This patch contains modifications to the Pharmacy Benefits Management "
^DIC(9.4,97,22,17,"PAH",20,1,2,0)="(PBM) package."
^DIC(9.4,97,22,17,"PAH",20,1,3,0)=" "
^DIC(9.4,97,22,17,"PAH",20,1,4,0)="Problem:  When the monthly Prescription extract runs, an error occurs in"
^DIC(9.4,97,22,17,"PAH",20,1,5,0)="the prescription patient demographics report if social security numbers "
^DIC(9.4,97,22,17,"PAH",20,1,6,0)="are missing on patients included in the extract."
^DIC(9.4,97,22,17,"PAH",20,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",20,1,8,0)="Solution:  Code has been altered to omit patients from the prescription "
^DIC(9.4,97,22,17,"PAH",20,1,9,0)="patient demographics report if social security numbers are missing.  This "
^DIC(9.4,97,22,17,"PAH",20,1,10,0)="prevents an error from occurring."
^DIC(9.4,97,22,17,"PAH",21,0)="22 SEQ #21^3030430^1"
^DIC(9.4,97,22,17,"PAH",21,1,0)="^^17^17^3030430"
^DIC(9.4,97,22,17,"PAH",21,1,1,0)="This patch makes a correction in the Pharmacy Benefits Management Provider"
^DIC(9.4,97,22,17,"PAH",21,1,2,0)="extract summary report.  It removes providers from the summary report who"
^DIC(9.4,97,22,17,"PAH",21,1,3,0)="have erroneous missing data."
^DIC(9.4,97,22,17,"PAH",21,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",21,1,5,0)="1.  Problem:  At teaching hospitals, interns and residents are reported as"
^DIC(9.4,97,22,17,"PAH",21,1,6,0)="having missing subspecialties on the Provider extract summary report.  "
^DIC(9.4,97,22,17,"PAH",21,1,7,0)="This"
^DIC(9.4,97,22,17,"PAH",21,1,8,0)="is incorrect, since by definition interns and residents never have"
^DIC(9.4,97,22,17,"PAH",21,1,9,0)="subspecialties.  Therefore these should be removed from the report."
^DIC(9.4,97,22,17,"PAH",21,1,10,0)=" "
^DIC(9.4,97,22,17,"PAH",21,1,11,0)="Solution:  If any of the following provider classifications are listed as"
^DIC(9.4,97,22,17,"PAH",21,1,12,0)="missing a subspecialty only, they are omitted from the Provider summary"
^DIC(9.4,97,22,17,"PAH",21,1,13,0)="report."
^DIC(9.4,97,22,17,"PAH",21,1,14,0)="        Resident - Allopathic"
^DIC(9.4,97,22,17,"PAH",21,1,15,0)="        Resident - Osteopathic"
^DIC(9.4,97,22,17,"PAH",21,1,16,0)="        Intern   - Allopathic"
^DIC(9.4,97,22,17,"PAH",21,1,17,0)="        Intern   - Osteopathic"
^DIC(9.4,97,22,17,"PAH",22,0)="28 SEQ #22^3030912^1"
^DIC(9.4,97,22,17,"PAH",22,1,0)="^^12^12^3030912"
^DIC(9.4,97,22,17,"PAH",22,1,1,0)="PHASE II of the TRANSITIONAL PHARMACY BENEFIT project requires a new "
^DIC(9.4,97,22,17,"PAH",22,1,2,0)="category to be added to each of the set of codes for the Prescription "
^DIC(9.4,97,22,17,"PAH",22,1,3,0)="Patient Status and the Provider Type elements of the outpatient "
^DIC(9.4,97,22,17,"PAH",22,1,4,0)="prescription transmission of the Pharmacy Benefits Management (PBM) "
^DIC(9.4,97,22,17,"PAH",22,1,5,0)="extracts."
^DIC(9.4,97,22,17,"PAH",22,1,6,0)=" "
^DIC(9.4,97,22,17,"PAH",22,1,7,0)="The new element added to each set of codes is ""NVA"", which stands for "
^DIC(9.4,97,22,17,"PAH",22,1,8,0)="NoN-VA."
^DIC(9.4,97,22,17,"PAH",22,1,9,0)=" "
^DIC(9.4,97,22,17,"PAH",22,1,10,0)="If a prescription in the PRESCRIPTION file #52 has a TPB RX status of "
^DIC(9.4,97,22,17,"PAH",22,1,11,0)="""YES"", both the Prescription Patient Status and the Provider Type "
^DIC(9.4,97,22,17,"PAH",22,1,12,0)="elements in the transmission will be set to ""NVA""."
^DIC(9.4,97,22,17,"PAH",23,0)="30 SEQ #23^3031023^1"
^DIC(9.4,97,22,17,"PAH",23,1,0)="^^6^6^3031023"
^DIC(9.4,97,22,17,"PAH",23,1,1,0)="Problem: The PBM extract element PATIENT STATUS would be set to 'NVA' if "
^DIC(9.4,97,22,17,"PAH",23,1,2,0)="the SC/A&A/OTHER/INPATIENT/NVA field (#6) were NULL in the RX PATIENT "
^DIC(9.4,97,22,17,"PAH",23,1,3,0)="STATUS file (#53)."
^DIC(9.4,97,22,17,"PAH",23,1,4,0)=" "
^DIC(9.4,97,22,17,"PAH",23,1,5,0)="Resolution: The code has been changed that for the above condition the "
^DIC(9.4,97,22,17,"PAH",23,1,6,0)="PBM PATIENT STATUS element will be set to """" (null)."
^DIC(9.4,97,22,17,"PAH",24,0)="26 SEQ #24^3031023^1"
^DIC(9.4,97,22,17,"PAH",24,1,0)="^^1^1^3031023"
^DIC(9.4,97,22,17,"PAH",24,1,1,0)="REMOVE FORM FEEDS"
^DIC(9.4,97,22,17,"PAH",25,0)="32 SEQ #25^3040131^1"
^DIC(9.4,97,22,17,"PAH",25,1,0)="^^3^3^3040131"
^DIC(9.4,97,22,17,"PAH",25,1,1,0)="Lab Data Summary. Send in email message but do not print hard copy as the "
^DIC(9.4,97,22,17,"PAH",25,1,2,0)="report is not in a usable format."
^DIC(9.4,97,22,17,"PAH",25,1,3,0)="Outpatient Statistics will be modified to print all divisions."
^DIC(9.4,97,22,17,"PAH",26,0)="24 SEQ #26^3040917^1"
^DIC(9.4,97,22,17,"PAH",26,1,0)="^^3^3^3040917"
^DIC(9.4,97,22,17,"PAH",26,1,1,0)=" "
^DIC(9.4,97,22,17,"PAH",26,1,2,0)="This patch decrease processing time, truncation of the ICN and prevents "
^DIC(9.4,97,22,17,"PAH",26,1,3,0)="duplicate jobs."
^DIC(9.4,97,22,17,"PAH",27,0)="34^3041015^1"
^DIC(9.4,97,22,17,"PAH",27,1,0)="^^65^65^3041015"
^DIC(9.4,97,22,17,"PAH",27,1,1,0)=" Phase I of the Inpatient Medications Requirements for the Special Focus"
^DIC(9.4,97,22,17,"PAH",27,1,2,0)=" Group IRA project consists of four patches. The patches are combined in"
^DIC(9.4,97,22,17,"PAH",27,1,3,0)=" host file PSJ_PSS_OR_PSU_110.KID in order to simplify installation at VHA"
^DIC(9.4,97,22,17,"PAH",27,1,4,0)=" facilities. Installation of this host file should be coordinated among"
^DIC(9.4,97,22,17,"PAH",27,1,5,0)=" the four packages affected since only one installation is necessary. The"
^DIC(9.4,97,22,17,"PAH",27,1,6,0)=" patches, in order of install, are:"
^DIC(9.4,97,22,17,"PAH",27,1,7,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,8,0)="      PSS*1*79   PHARMACY DATA MANAGEMENT V. 1.0"
^DIC(9.4,97,22,17,"PAH",27,1,9,0)="      PSJ*5*110  INPATIENT MEDICATIONS V. 5.0"
^DIC(9.4,97,22,17,"PAH",27,1,10,0)="      OR*3*213   ORDER ENTRY/RESULTS REPORTING V. 1.0"
^DIC(9.4,97,22,17,"PAH",27,1,11,0)="      PSU*3*34   PHARMACY BENEFITS MANAGEMENT V. 3.0"
^DIC(9.4,97,22,17,"PAH",27,1,12,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,13,0)=" Patches PSS*1*79, OR*3*213, and PSU*3*34 contain changes to support the"
^DIC(9.4,97,22,17,"PAH",27,1,14,0)=" following enhancements in PSJ*5*110:"
^DIC(9.4,97,22,17,"PAH",27,1,15,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,16,0)=" 1. The Extend Stop Date on Renewal enhancements will allow an order to be"
^DIC(9.4,97,22,17,"PAH",27,1,17,0)=" renewed without creating a new order. Editing of the start date will no"
^DIC(9.4,97,22,17,"PAH",27,1,18,0)=" longer be allowed during the renewal process. In addition, limits have"
^DIC(9.4,97,22,17,"PAH",27,1,19,0)=" been set on the length of time after an order expires that it may be"
^DIC(9.4,97,22,17,"PAH",27,1,20,0)=" renewed. This is outlined in the BCMA 2001 Special Focus Report,"
^DIC(9.4,97,22,17,"PAH",27,1,21,0)=" Requirement #11."
^DIC(9.4,97,22,17,"PAH",27,1,22,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,23,0)=" 2. The Complex Order enhancements will change the way complex orders are"
^DIC(9.4,97,22,17,"PAH",27,1,24,0)=" handled by linking complex components (child orders) together. If the"
^DIC(9.4,97,22,17,"PAH",27,1,25,0)=" actions Finish, Verify, Discontinue, or Renew are taken on one child"
^DIC(9.4,97,22,17,"PAH",27,1,26,0)=" order, the user will be alerted that the action must be taken on all of"
^DIC(9.4,97,22,17,"PAH",27,1,27,0)=" the complex component orders in the set. The user will then be prompted"
^DIC(9.4,97,22,17,"PAH",27,1,28,0)=" to take the appropriate action on each child order in the complex order"
^DIC(9.4,97,22,17,"PAH",27,1,29,0)=" set. This is outlined in BCMA 2001 Special Focus Report, Requirement #8."
^DIC(9.4,97,22,17,"PAH",27,1,30,0)="  "
^DIC(9.4,97,22,17,"PAH",27,1,31,0)=" 3. The STAT and NOW Order Notification enhancements will alert users"
^DIC(9.4,97,22,17,"PAH",27,1,32,0)=" subscribing to new mail group PSJ STAT NOW PENDING ORDER when a pending"
^DIC(9.4,97,22,17,"PAH",27,1,33,0)=" STAT or NOW order has been received from Computerized Patient Record"
^DIC(9.4,97,22,17,"PAH",27,1,34,0)=" System (CPRS) V. 1.0. Users subscribing to the new mail group PSJ STAT"
^DIC(9.4,97,22,17,"PAH",27,1,35,0)=" NOW ACTIVE ORDER will receive an alert when a STAT or NOW order is made"
^DIC(9.4,97,22,17,"PAH",27,1,36,0)=" active. This is outlined in BCMA 2001 Special Focus Report, Requirement"
^DIC(9.4,97,22,17,"PAH",27,1,37,0)=" #12."
^DIC(9.4,97,22,17,"PAH",27,1,38,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,39,0)=" Changes to PHARMACY BENEFITS MANAGEMENT (PBM) V. 3.0 have been included"
^DIC(9.4,97,22,17,"PAH",27,1,40,0)=" in this patch to address the following issues:"
^DIC(9.4,97,22,17,"PAH",27,1,41,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,42,0)=" 1. Problem:  The changes to renewed orders introduced by the Inpatient"
^DIC(9.4,97,22,17,"PAH",27,1,43,0)=" Medications Requirements for the Special Focus Group IRA, Phase I project"
^DIC(9.4,97,22,17,"PAH",27,1,44,0)=" will allow renewed orders to have an active status for periods of time"
^DIC(9.4,97,22,17,"PAH",27,1,45,0)=" that exceed the current PHARMACY BENEFITS MANAGEMENT (PBM) V. 3.0 time"
^DIC(9.4,97,22,17,"PAH",27,1,46,0)=" period parameters."
^DIC(9.4,97,22,17,"PAH",27,1,47,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,48,0)=" Solution:  The code searching for IV and Unit Dose activity within the"
^DIC(9.4,97,22,17,"PAH",27,1,49,0)=" transmitting period has been modified to accommodate the extended periods"
^DIC(9.4,97,22,17,"PAH",27,1,50,0)=" of time orders may contain an active status as a result of the changes"
^DIC(9.4,97,22,17,"PAH",27,1,51,0)=" introduced by the Inpatient Medications Requirements for the Special "
^DIC(9.4,97,22,17,"PAH",27,1,52,0)=" Focus Group IRA, Phase I project."
^DIC(9.4,97,22,17,"PAH",27,1,53,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,54,0)=" 2. Problem: In several extracts only the first portion of the patient"
^DIC(9.4,97,22,17,"PAH",27,1,55,0)=" Integration Control Number is being extracted. The entire Integration"
^DIC(9.4,97,22,17,"PAH",27,1,56,0)=" Control Number needs to be exported."
^DIC(9.4,97,22,17,"PAH",27,1,57,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,58,0)=" Solution: Patch PSU*3*34 will correct and extract the entire Integration"
^DIC(9.4,97,22,17,"PAH",27,1,59,0)=" Control Number in the IV multiple (#100) in the Pharmacy Patient file"
^DIC(9.4,97,22,17,"PAH",27,1,60,0)=" (#55) and the UNIT DOSE multiple (#62) in the Pharmacy Patient file"
^DIC(9.4,97,22,17,"PAH",27,1,61,0)=" (#55)."
^DIC(9.4,97,22,17,"PAH",27,1,62,0)=" "
^DIC(9.4,97,22,17,"PAH",27,1,63,0)=" Patch PSU*3*24 will correct the problem in all other applicable files."
^DIC(9.4,97,22,17,"PAH",27,1,64,0)=" This is being done so that patch 24 and 34 can move forward without"
^DIC(9.4,97,22,17,"PAH",27,1,65,0)=" conflict."
^DIC(9.4,97,22,17,"PAH",28,0)="31 SEQ #28^3041228^1"
^DIC(9.4,97,22,17,"PAH",28,1,0)="^^2^2^3041228"
^DIC(9.4,97,22,17,"PAH",28,1,1,0)="MISSING DIVISION NAMES ON OUTPATIENT DATA WHEN THERE ARE MULTIPLE ENTRIES "
^DIC(9.4,97,22,17,"PAH",28,1,2,0)="IN FILE 59 (OUTPATIENT SITE) WITH THE SAME SITE NUMBER."
^DIC(9.4,97,22,17,"PAH",29,0)="35 SEQ #29^3050118^1"
^DIC(9.4,97,22,17,"PAH",29,1,0)="^^1^1^3050118"
^DIC(9.4,97,22,17,"PAH",29,1,1,0)="UNDEFINED ERROR IN PSUIV1 WHEN CREATING MONTHLY EXTRACT."
^DIC(9.4,97,22,17,"PAH","B",34,27)=""
^DIC(9.4,97,22,17,"PAH","B","1 SEQ #3",3)=""
