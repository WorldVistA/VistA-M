^DIC(9.4,100,22,15,"PAH",105,1,1,0)="Backup of YS*5.01*171 on Apr 22, 2021"
^DIC(9.4,100,22,15,"PAH",105,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",105,1,3,0)="Warning:  Installing this backup patch message will install older versions"
