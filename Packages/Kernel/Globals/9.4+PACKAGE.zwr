^DIC(9.4,100,22,15,"PAH",39,1,61,0)="       ALBANY               152.127.1.5        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",39,1,62,0)="       HINES                152.129.1.110      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",39,1,63,0)="       SALT LAKE            152.131.2.1        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",39,1,64,0)="  "
^DIC(9.4,100,22,15,"PAH",39,1,65,0)="   The documentation can be found in a file named YS_501_59_EC.PDF. "
^DIC(9.4,100,22,15,"PAH",39,1,66,0)=""
