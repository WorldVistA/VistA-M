^DIC(9.4,47,22,5.9,"PAH",682,1,176,0)="Documentation Retrieval Instructions:"
^DIC(9.4,47,22,5.9,"PAH",682,1,177,0)="-------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,178,0)="Updated documentation describing the new functionality introduced by this"
^DIC(9.4,47,22,5.9,"PAH",682,1,179,0)="patch is available."
^DIC(9.4,47,22,5.9,"PAH",682,1,180,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,181,0)="The preferred method is to FTP the files from ftp://download.vista.domain.ext/"
^DIC(9.4,47,22,5.9,"PAH",682,1,182,0)="This transmits the files from the first available FTP server. Sites may also"
^DIC(9.4,47,22,5.9,"PAH",682,1,183,0)="elect to retrieve software directly from a specific server as follows:"
^DIC(9.4,47,22,5.9,"PAH",682,1,184,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,185,0)="  Albany         ftp.fo-albany.domain.ext  <ftp://ftp.fo-albany.domain.ext>"
^DIC(9.4,47,22,5.9,"PAH",682,1,186,0)="  Hines          ftp.fo-hines.domain.ext   <ftp://ftp.fo-hines.domain.ext>"
^DIC(9.4,47,22,5.9,"PAH",682,1,187,0)="  Salt Lake City ftp.fo-slc.domain.ext     <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,47,22,5.9,"PAH",682,1,188,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,189,0)=" The documentation will be in the form of Adobe Acrobat files."
^DIC(9.4,47,22,5.9,"PAH",682,1,190,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,191,0)=" Documentation can also be found on the VA Software Documentation Library"
^DIC(9.4,47,22,5.9,"PAH",682,1,192,0)=" at: http://www4.domain.ext/vdl/"
^DIC(9.4,47,22,5.9,"PAH",682,1,193,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,194,0)=" File Description                          File Name             FTP Mode"
^DIC(9.4,47,22,5.9,"PAH",682,1,195,0)=" --------------------------------------------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,196,0)=" Fee Basis User Manual                     fb3_5um.pdf           Binary"
^DIC(9.4,47,22,5.9,"PAH",682,1,197,0)=" PIMS v5.3 ADT User Manual Registration    dg_5_3_reg_um.pdf     Binary"
^DIC(9.4,47,22,5.9,"PAH",682,1,198,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,199,0)="The procedure guide, Care for Newborn of Women Veterans, located at"
^DIC(9.4,47,22,5.9,"PAH",682,1,200,0)="http://nonvacare.hac.domain.ext/policy-programs/procedure-guides.asp,"
^DIC(9.4,47,22,5.9,"PAH",682,1,201,0)="should be distributed to those personnel registering newborns and/or"
^DIC(9.4,47,22,5.9,"PAH",682,1,202,0)="processing newborn claims."
^DIC(9.4,47,22,5.9,"PAH",682,1,203,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,204,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,205,0)=" Patch Installation:"
^DIC(9.4,47,22,5.9,"PAH",682,1,206,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,207,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,208,0)="Pre/Post Installation Overview"
^DIC(9.4,47,22,5.9,"PAH",682,1,209,0)="------------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,210,0)="There are three post installation routines associated with this patch DG867PO,"
^DIC(9.4,47,22,5.9,"PAH",682,1,211,0)="FB146PO, and IB499PO. These routines primarily serve as filters for the data"
^DIC(9.4,47,22,5.9,"PAH",682,1,212,0)="transmitted to the appropriate files listed above, so that only the intended"
^DIC(9.4,47,22,5.9,"PAH",682,1,213,0)="data is delivered. The only exception is the IB499PO routine which"
^DIC(9.4,47,22,5.9,"PAH",682,1,214,0)="programmatically makes an addition to the help text of the FAMILY PREFIX field"
^DIC(9.4,47,22,5.9,"PAH",682,1,215,0)="(#.03) in the SPONSOR RELATIONSHIP file (#355.81). These post installation"
^DIC(9.4,47,22,5.9,"PAH",682,1,216,0)="routines may be deleted after successful installation of the NEWBORN DG FB IB"
^DIC(9.4,47,22,5.9,"PAH",682,1,217,0)="BUNDLE 1.0"
^DIC(9.4,47,22,5.9,"PAH",682,1,218,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,219,0)="Installation Instructions"
^DIC(9.4,47,22,5.9,"PAH",682,1,220,0)="-------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,221,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,47,22,5.9,"PAH",682,1,222,0)="recommended that it be installed during non-peak hours to minimize potential"
^DIC(9.4,47,22,5.9,"PAH",682,1,223,0)="disruption to users. This patch should take less than 5 minutes to install."
^DIC(9.4,47,22,5.9,"PAH",682,1,224,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,225,0)="FB*3.5*147 is a required patch and must be installed before DG*5.3*867."
^DIC(9.4,47,22,5.9,"PAH",682,1,226,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,227,0)="DG*5.3*867 is one of three patches for this release (including FB*3.5*146 and"
^DIC(9.4,47,22,5.9,"PAH",682,1,228,0)="IB*2.0*499). The patches will be installed as a bundle in the following order:"
^DIC(9.4,47,22,5.9,"PAH",682,1,229,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,230,0)="1) DG*5.3*867"
^DIC(9.4,47,22,5.9,"PAH",682,1,231,0)="2) FB*3.5*146"
^DIC(9.4,47,22,5.9,"PAH",682,1,232,0)="3) IB*2.0*499"
^DIC(9.4,47,22,5.9,"PAH",682,1,233,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,234,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,235,0)=" Pre-Installation Instructions"
^DIC(9.4,47,22,5.9,"PAH",682,1,236,0)=" -----------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,237,0)=" 1.  OBTAIN PATCHES"
^DIC(9.4,47,22,5.9,"PAH",682,1,238,0)="     --------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,239,0)="Obtain the host file NEWBORN_1_2_DG_FB_IB.KID which contains the following"
^DIC(9.4,47,22,5.9,"PAH",682,1,240,0)="patches:"
^DIC(9.4,47,22,5.9,"PAH",682,1,241,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,242,0)=" DG*5.3*867"
^DIC(9.4,47,22,5.9,"PAH",682,1,243,0)=" FB*3.5*146"
^DIC(9.4,47,22,5.9,"PAH",682,1,244,0)=" IB*2.0*499"
^DIC(9.4,47,22,5.9,"PAH",682,1,245,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,246,0)="Sites can retrieve VistA software from the following FTP addresses. The"
^DIC(9.4,47,22,5.9,"PAH",682,1,247,0)="preferred method is to FTP the files from:"
^DIC(9.4,47,22,5.9,"PAH",682,1,248,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,249,0)="                     download.vista.domain.ext"
^DIC(9.4,47,22,5.9,"PAH",682,1,250,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,251,0)="This will transmit the files from the first available FTP server. Sites may"
^DIC(9.4,47,22,5.9,"PAH",682,1,252,0)="also elect to retrieve software directly from a specific server as follows:"
^DIC(9.4,47,22,5.9,"PAH",682,1,253,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,254,0)="        Albany                  ftp.fo-albany.domain.ext"
^DIC(9.4,47,22,5.9,"PAH",682,1,255,0)="        Hines                   ftp.fo-hines.domain.ext"
^DIC(9.4,47,22,5.9,"PAH",682,1,256,0)="        Salt Lake City          ftp.fo-slc.domain.ext"
^DIC(9.4,47,22,5.9,"PAH",682,1,257,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,258,0)="The NEWBORN_1_2_DG_FB_IB.KID host file is located in the anonymous.software"
^DIC(9.4,47,22,5.9,"PAH",682,1,259,0)="directory. Use ASCII Mode when downloading the file."
^DIC(9.4,47,22,5.9,"PAH",682,1,260,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,261,0)=" 2.  START UP KIDS"
^DIC(9.4,47,22,5.9,"PAH",682,1,262,0)="     -------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,263,0)="     Start up the Kernel Installation and Distribution System Menu option"
^DIC(9.4,47,22,5.9,"PAH",682,1,264,0)="     [XPD MAIN]:"
^DIC(9.4,47,22,5.9,"PAH",682,1,265,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,266,0)="          Edits and Distribution ..."
^DIC(9.4,47,22,5.9,"PAH",682,1,267,0)="          Utilities ..."
^DIC(9.4,47,22,5.9,"PAH",682,1,268,0)="          Installation ..."
^DIC(9.4,47,22,5.9,"PAH",682,1,269,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,270,0)="     Select Kernel Installation & Distribution System Option: Installation"
^DIC(9.4,47,22,5.9,"PAH",682,1,271,0)="                                                              ---"
^DIC(9.4,47,22,5.9,"PAH",682,1,272,0)="          Load a Distribution"
^DIC(9.4,47,22,5.9,"PAH",682,1,273,0)="          Print Transport Global"
^DIC(9.4,47,22,5.9,"PAH",682,1,274,0)="          Compare Transport Global to Current System"
^DIC(9.4,47,22,5.9,"PAH",682,1,275,0)="          Verify Checksums in Transport Global"
^DIC(9.4,47,22,5.9,"PAH",682,1,276,0)="          Install Package(s)"
^DIC(9.4,47,22,5.9,"PAH",682,1,277,0)="          Restart Install of Package(s)"
^DIC(9.4,47,22,5.9,"PAH",682,1,278,0)="          Unload a Distribution"
^DIC(9.4,47,22,5.9,"PAH",682,1,279,0)="          Backup a Transport Global"
^DIC(9.4,47,22,5.9,"PAH",682,1,280,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,281,0)="     Select Installation Option:"
^DIC(9.4,47,22,5.9,"PAH",682,1,282,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,283,0)=" 3.  LOAD TRANSPORT GLOBAL FOR MULTI-BUILD"
^DIC(9.4,47,22,5.9,"PAH",682,1,284,0)="     -------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,285,0)="     From the Installation menu, select the Load a Distribution option."
^DIC(9.4,47,22,5.9,"PAH",682,1,286,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,287,0)="     When prompted for ""Enter a Host File:"" Enter the full directory path"
^DIC(9.4,47,22,5.9,"PAH",682,1,288,0)="     where you saved the host file NEWBORN_1_2_DG_FB_IB.KID"
^DIC(9.4,47,22,5.9,"PAH",682,1,289,0)="     (e.g., SYS$SYSDEVICE:[ANONYMOUS]NEWBORN_1_2_DG_FB_IB.KID)"
^DIC(9.4,47,22,5.9,"PAH",682,1,290,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,291,0)=" When prompted for ""OK to continue with Load? NO//"", Enter ""YES."""
^DIC(9.4,47,22,5.9,"PAH",682,1,292,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,293,0)="     The following will display:"
^DIC(9.4,47,22,5.9,"PAH",682,1,294,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,295,0)="       Loading Distribution..."
^DIC(9.4,47,22,5.9,"PAH",682,1,296,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,297,0)="    NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,47,22,5.9,"PAH",682,1,298,0)="    DG*5.3*867"
^DIC(9.4,47,22,5.9,"PAH",682,1,299,0)="    FB*3.5*146"
^DIC(9.4,47,22,5.9,"PAH",682,1,300,0)="    IB*2.0*499"
^DIC(9.4,47,22,5.9,"PAH",682,1,301,0)="    Use INSTALL NAME: NEWBORN DG FB IB BUNDLE 1.0 to install this"
^DIC(9.4,47,22,5.9,"PAH",682,1,302,0)="    distribution."
^DIC(9.4,47,22,5.9,"PAH",682,1,303,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,304,0)=" 4.  RUN OPTIONAL INSTALLATION OPTIONS FOR MULTI-BUILD"
^DIC(9.4,47,22,5.9,"PAH",682,1,305,0)="     -------------------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,306,0)="     From the Installation menu, you may select to use the following options"
^DIC(9.4,47,22,5.9,"PAH",682,1,307,0)="(when prompted for the INSTALL NAME, enter NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,47,22,5.9,"PAH",682,1,308,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,309,0)="     a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,47,22,5.9,"PAH",682,1,310,0)="         message of any routines exported with this patch. It will not"
^DIC(9.4,47,22,5.9,"PAH",682,1,311,0)="         backup any other changes such as data dictionaries or templates."
^DIC(9.4,47,22,5.9,"PAH",682,1,312,0)="     b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,47,22,5.9,"PAH",682,1,313,0)="         allow you to view all changes that will be made when this patch"
^DIC(9.4,47,22,5.9,"PAH",682,1,314,0)="         is installed.  It compares all components of this patch"
^DIC(9.4,47,22,5.9,"PAH",682,1,315,0)="         (routines, data dictionaries, templates, etc.)."
^DIC(9.4,47,22,5.9,"PAH",682,1,316,0)="     c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,47,22,5.9,"PAH",682,1,317,0)="         you to ensure the integrity of the routines that are in the"
^DIC(9.4,47,22,5.9,"PAH",682,1,318,0)="         transport global."
^DIC(9.4,47,22,5.9,"PAH",682,1,319,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,320,0)=" 5.  INSTALL MULTI-BUILD"
^DIC(9.4,47,22,5.9,"PAH",682,1,321,0)="     -------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,322,0)="   This is the step to start the installation of this KIDS patch.  This will"
^DIC(9.4,47,22,5.9,"PAH",682,1,323,0)="   need to be run for the NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,47,22,5.9,"PAH",682,1,324,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,325,0)="    a.  Choose the Install Package(s) option to start the patch"
^DIC(9.4,47,22,5.9,"PAH",682,1,326,0)="         install."
^DIC(9.4,47,22,5.9,"PAH",682,1,327,0)="    b.  When prompted for the ""Select INSTALL NAME:"" enter"
^DIC(9.4,47,22,5.9,"PAH",682,1,328,0)="          NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,47,22,5.9,"PAH",682,1,329,0)="    c.  When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,47,22,5.9,"PAH",682,1,330,0)="         NO//"", answer NO"
^DIC(9.4,47,22,5.9,"PAH",682,1,331,0)="    d.  When prompted ""Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,47,22,5.9,"PAH",682,1,332,0)="         and Protocols? NO//"", answer NO"
^DIC(9.4,47,22,5.9,"PAH",682,1,333,0)="    e.  When prompted ""Device: HOME//"", enter HOME"
^DIC(9.4,47,22,5.9,"PAH",682,1,334,0)="         to display the Install message on the screen (or enter the device"
^DIC(9.4,47,22,5.9,"PAH",682,1,335,0)="         you want to print the Install message). You may queue the"
^DIC(9.4,47,22,5.9,"PAH",682,1,336,0)="         install if you wish."
^DIC(9.4,47,22,5.9,"PAH",682,1,337,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,338,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,339,0)="Post-Installation Instructions"
^DIC(9.4,47,22,5.9,"PAH",682,1,340,0)="------------------------------"
^DIC(9.4,47,22,5.9,"PAH",682,1,341,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,342,0)="*** IMPORTANT NOTE ***"
^DIC(9.4,47,22,5.9,"PAH",682,1,343,0)="Please note there are three post installation routines that may be deleted"
^DIC(9.4,47,22,5.9,"PAH",682,1,344,0)="after successful installation of the NEWBORN DG FB IB BUNDLE 1.0. These are:"
^DIC(9.4,47,22,5.9,"PAH",682,1,345,0)=" "
^DIC(9.4,47,22,5.9,"PAH",682,1,346,0)="DG867PO"
^DIC(9.4,47,22,5.9,"PAH",682,1,347,0)="FB146PO"
^DIC(9.4,47,22,5.9,"PAH",682,1,348,0)="IB499PO"
^DIC(9.4,47,22,5.9,"PAH",683,0)="875^3140106.16181^17"
^DIC(9.4,47,22,5.9,"PAH",684,0)="853^3140106.162808^17"
^DIC(9.4,47,22,5.9,"PAH",684,1,0)="^^2^2^3140106"
^DIC(9.4,47,22,5.9,"PAH",684,1,1,0)="Please refer to the National Patch Module for the detail of this "
^DIC(9.4,47,22,5.9,"PAH",684,1,2,0)="patch build."
^DIC(9.4,47,22,5.9,"PAH",685,0)="869^3140115.164421^17"
^DIC(9.4,47,22,5.9,"PAH",685,1,0)="^^1^1^3140115"
^DIC(9.4,47,22,5.9,"PAH",685,1,1,0)="Patient Record Flag - Missing Patient (introduction)"
^DIC(9.4,47,22,5.9,"PAH",686,0)="874 SEQ #776^3140221.101206^17"
^DIC(9.4,47,22,5.9,"PAH",686,1,0)="^^3^3^3140221"
^DIC(9.4,47,22,5.9,"PAH",686,1,1,0)="VIC CARD ENHANCEMENT"
^DIC(9.4,47,22,5.9,"PAH",686,1,2,0)="Refer to patch DG*5.3*874 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",686,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",687,0)="858^3140324.154003^17"
^DIC(9.4,47,22,5.9,"PAH",687,1,0)="^^3^3^3140324"
^DIC(9.4,47,22,5.9,"PAH",687,1,1,0)="This patch contains VistA changes to support technology and business"
^DIC(9.4,47,22,5.9,"PAH",687,1,2,0)="changes that are occurring with the implementation of Discontinue"
^DIC(9.4,47,22,5.9,"PAH",687,1,3,0)="Annual Means Test Renewal."
^DIC(9.4,47,22,5.9,"PAH",688,0)="812^3140522.155457^17"
^DIC(9.4,47,22,5.9,"PAH",688,1,0)="^^7^7^3140522"
^DIC(9.4,47,22,5.9,"PAH",688,1,1,0)="This patch addresses the following:"
^DIC(9.4,47,22,5.9,"PAH",688,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",688,1,3,0)="- Resolves an <UNDEFINED> error that occurs when editing the PRIMARY "
^DIC(9.4,47,22,5.9,"PAH",688,1,4,0)="  PHYSICIAN (#.08) field in the PATIENT MOVEMENT (#405) file."
^DIC(9.4,47,22,5.9,"PAH",688,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",688,1,6,0)="- Updates the input transform and executable help text for the ALL OTHER "
^DIC(9.4,47,22,5.9,"PAH",688,1,7,0)="  INCOME (#.17) field in the INDIVIDUAL ANNUAL INCOME (#408.21) file."
^DIC(9.4,47,22,5.9,"PAH",689,0)="862^3140724.152712^17"
^DIC(9.4,47,22,5.9,"PAH",689,1,0)="^^3^3^3140724"
^DIC(9.4,47,22,5.9,"PAH",689,1,1,0)="This build makes the ICD-10 changes to PTF for the Clinical Reminders"
^DIC(9.4,47,22,5.9,"PAH",689,1,2,0)="Index."
^DIC(9.4,47,22,5.9,"PAH",689,1,3,0)=""
^DIC(9.4,47,22,5.9,"PAH",690,0)="850 SEQ #780^3140805.163544^17"
^DIC(9.4,47,22,5.9,"PAH",690,1,0)="^^1^1^3140805"
^DIC(9.4,47,22,5.9,"PAH",690,1,1,0)="This is the ADT ICD-10 Remediation patch."
^DIC(9.4,47,22,5.9,"PAH",691,0)="883 SEQ #781^3140807.100745^17"
^DIC(9.4,47,22,5.9,"PAH",691,1,0)="^^2^2^3140807"
^DIC(9.4,47,22,5.9,"PAH",691,1,1,0)="Registration changes for the VIA Project. See patch description for "
^DIC(9.4,47,22,5.9,"PAH",691,1,2,0)="details."
^DIC(9.4,47,22,5.9,"PAH",692,0)="898 SEQ #783^3141015.152015^17"
^DIC(9.4,47,22,5.9,"PAH",693,0)="876 SEQ #784^3141113.151158^17"
^DIC(9.4,47,22,5.9,"PAH",693,1,0)="^^3^3^3141113"
^DIC(9.4,47,22,5.9,"PAH",693,1,1,0)="MASTER VETERAN INDEX VISTA ISSUES - ITERATION 12"
^DIC(9.4,47,22,5.9,"PAH",693,1,2,0)="Refer to patch DG*5.3*876 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",693,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",694,0)="900 SEQ #785^3141202.15162^17"
^DIC(9.4,47,22,5.9,"PAH",694,1,0)="^^6^6^3141202"
^DIC(9.4,47,22,5.9,"PAH",694,1,1,0)="The VistA integration Adaptor (VIA) project requires access to certain "
^DIC(9.4,47,22,5.9,"PAH",694,1,2,0)="Remote Procedure Calls (RPCs) that are part of the REGISTRATION package. "
^DIC(9.4,47,22,5.9,"PAH",694,1,3,0)="The purpose of this patch is to publish one additional RPC allowing access"
^DIC(9.4,47,22,5.9,"PAH",694,1,4,0)="for use by VIA by setting the field APP PROXY ALLOWED field (#.11) of the "
^DIC(9.4,47,22,5.9,"PAH",694,1,5,0)="REMOTE PROCEDURE file (#8994) to YES. This patch deals specifically with"
^DIC(9.4,47,22,5.9,"PAH",694,1,6,0)="the VAFCTFU CONVERT ICN TO DFN RPC."
^DIC(9.4,47,22,5.9,"PAH",695,0)="893 SEQ #786^3141208.165738^17"
^DIC(9.4,47,22,5.9,"PAH",695,1,0)="^^15^15^3141208"
^DIC(9.4,47,22,5.9,"PAH",695,1,1,0)="Patch DG*5.3*893 addresses the following 3 issues:"
^DIC(9.4,47,22,5.9,"PAH",695,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",695,1,3,0)="- Patients whose first enrollment was before the install date of patch"
^DIC(9.4,47,22,5.9,"PAH",695,1,4,0)="  DG*5.3*779 do not have an AEAR index on the APPOINTMENT REQUEST ON "
^DIC(9.4,47,22,5.9,"PAH",695,1,5,0)="  1010EZ (#1010.159) field in the PATIENT (#2) file"
^DIC(9.4,47,22,5.9,"PAH",695,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",695,1,7,0)="- The Tracking Report [DGEN NEACL MGT RPT2] has a bug which causes the API"
^DIC(9.4,47,22,5.9,"PAH",695,1,8,0)="  that gathers appointments to only return one appointment. This can cause"
^DIC(9.4,47,22,5.9,"PAH",695,1,9,0)="  a blank appointment date to display if the first appointment is a "
^DIC(9.4,47,22,5.9,"PAH",695,1,10,0)="  non-count"
^DIC(9.4,47,22,5.9,"PAH",695,1,11,0)=" "
^DIC(9.4,47,22,5.9,"PAH",695,1,12,0)="- The Call List [DGEN NEACL MGT RPT1] has a bug when comparing the "
^DIC(9.4,47,22,5.9,"PAH",695,1,13,0)="  patient's preferred facility to the selected facility. "
^DIC(9.4,47,22,5.9,"PAH",695,1,14,0)="  It cause them not to match if the preferred facility code begins "
^DIC(9.4,47,22,5.9,"PAH",695,1,15,0)="  with 4 numerics instead of 3."
^DIC(9.4,47,22,5.9,"PAH",696,0)="910^3150106.115007^17"
^DIC(9.4,47,22,5.9,"PAH",696,1,0)="^^27^27^3150106"
^DIC(9.4,47,22,5.9,"PAH",696,1,1,0)="The Means Test thresholds for Calendar Year 2015 are distributed with this"
^DIC(9.4,47,22,5.9,"PAH",696,1,2,0)="patch. The post-installation routine, DG53910P, will create a new subentry"
^DIC(9.4,47,22,5.9,"PAH",696,1,3,0)="(or replace an existing one) for calendar year 2015 in the MEANS TEST DATA"
^DIC(9.4,47,22,5.9,"PAH",696,1,4,0)="(#250) multiple field of the MAS PARAMETERS (#43) file. Six subfields"
^DIC(9.4,47,22,5.9,"PAH",696,1,5,0)="within the multiple will be updated with the new Means Test threshold data"
^DIC(9.4,47,22,5.9,"PAH",696,1,6,0)="values as follows:"
^DIC(9.4,47,22,5.9,"PAH",696,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",696,1,8,0)="       MEANS TEST DATA (#.01) - 2015"
^DIC(9.4,47,22,5.9,"PAH",696,1,9,0)="       MT COPAY EXEMPT VET INCOME (#2) - $31,978"
^DIC(9.4,47,22,5.9,"PAH",696,1,10,0)="       MT COPAY EXEMPT 1ST DEP INCOME (#3) - $6,396"
^DIC(9.4,47,22,5.9,"PAH",696,1,11,0)="       MT COPAY EXEMPT INCOME PER DEP (#4) - $2,198"
^DIC(9.4,47,22,5.9,"PAH",696,1,12,0)="       THRESHOLD PROPERTY (#8) - $80,000"
^DIC(9.4,47,22,5.9,"PAH",696,1,13,0)="       CHILD INCOME EXCLUSION (#17) - $10,300"
^DIC(9.4,47,22,5.9,"PAH",696,1,14,0)=" "
^DIC(9.4,47,22,5.9,"PAH",696,1,15,0)="In addition, this patch will update the following fields in the "
^DIC(9.4,47,22,5.9,"PAH",696,1,16,0)="PARAMETERS file (#8989.5) for Income Year 2014 to:"
^DIC(9.4,47,22,5.9,"PAH",696,1,17,0)=" "
^DIC(9.4,47,22,5.9,"PAH",696,1,18,0)="       DGMT MAPR GLOBAL RATE         5         "
^DIC(9.4,47,22,5.9,"PAH",696,1,19,0)="       DGMT MAPR 0 DEPENDENTS        12868"
^DIC(9.4,47,22,5.9,"PAH",696,1,20,0)="       DGMT MAPR 1 DEPENDENTS        16851"
^DIC(9.4,47,22,5.9,"PAH",696,1,21,0)="       DGMT MAPR N DEPENDENTS        2198"
^DIC(9.4,47,22,5.9,"PAH",696,1,22,0)=" "
^DIC(9.4,47,22,5.9,"PAH",696,1,23,0)="This patch, DG*5.3*910 is one of three VistA 2015 threshold patches. It "
^DIC(9.4,47,22,5.9,"PAH",696,1,24,0)="updates the thresholds for the Means Tests and the Maximum Annual Pension "
^DIC(9.4,47,22,5.9,"PAH",696,1,25,0)="Rate. Patch EAS*1.0*125 will address the annual updates for the GMT "
^DIC(9.4,47,22,5.9,"PAH",696,1,26,0)="Thresholds and patch IB*2.0*540 will address the annual updates for the "
^DIC(9.4,47,22,5.9,"PAH",696,1,27,0)="Pharmacy Copay Thresholds."
^DIC(9.4,47,22,5.9,"PAH",697,0)="859 SEQ #788^3150107.113258^17"
^DIC(9.4,47,22,5.9,"PAH",697,1,0)="^^5^5^3150107"
^DIC(9.4,47,22,5.9,"PAH",697,1,1,0)="Patch DG*5.3*859 addresses an issue with the DG Home Telehealth mail "
^DIC(9.4,47,22,5.9,"PAH",697,1,2,0)="alerts that users receive when an HL7 message does not receive the"
^DIC(9.4,47,22,5.9,"PAH",697,1,3,0)="proper acknowledgement and an error alert is created.  Users are finding"
^DIC(9.4,47,22,5.9,"PAH",697,1,4,0)="it difficult to research the alert received without more information "
^DIC(9.4,47,22,5.9,"PAH",697,1,5,0)="included in the message."
^DIC(9.4,47,22,5.9,"PAH",698,0)="872 SEQ #789^3150107.162403^17"
^DIC(9.4,47,22,5.9,"PAH",698,1,0)="^^6^6^3150107"
^DIC(9.4,47,22,5.9,"PAH",698,1,1,0)="Patch DG*5.3*872 addresses 2 issues:"
^DIC(9.4,47,22,5.9,"PAH",698,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",698,1,3,0)="       1.  APPOINTMENT TYPE SUB-CATEGORY field (#24) of the APPOINTMENT "
^DIC(9.4,47,22,5.9,"PAH",698,1,4,0)="           sub-file (#2.98) of the PATIENT file (#2) is not assigned"
^DIC(9.4,47,22,5.9,"PAH",698,1,5,0)="           properly."
^DIC(9.4,47,22,5.9,"PAH",698,1,6,0)="       2.  Patient Address Update option is not displaying correctly."
^DIC(9.4,47,22,5.9,"PAH",699,0)="895 SEQ #790^3150126.121934^17"
^DIC(9.4,47,22,5.9,"PAH",699,1,0)="^^5^5^3150126"
^DIC(9.4,47,22,5.9,"PAH",699,1,1,0)="Patch DG*5.3*895 addresses 2 issues:"
^DIC(9.4,47,22,5.9,"PAH",699,1,2,0)="      "
^DIC(9.4,47,22,5.9,"PAH",699,1,3,0)=" 1.)  Deletion of admission can cause orphaned nodes"
^DIC(9.4,47,22,5.9,"PAH",699,1,4,0)=" 2.)  Inconsistency 55 issue with service connected veterans who agree to "
^DIC(9.4,47,22,5.9,"PAH",699,1,5,0)="      copay, but decline to provide income data"
^DIC(9.4,47,22,5.9,"PAH",700,0)="886 SEQ #792^3150409.160213^17"
^DIC(9.4,47,22,5.9,"PAH",700,1,0)="^^13^13^3150409"
^DIC(9.4,47,22,5.9,"PAH",700,1,1,0)="This patch addresses 4 issues:"
^DIC(9.4,47,22,5.9,"PAH",700,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",700,1,3,0)="1. Bad Address Indicator is not working as the Help prompt suggests.  "
^DIC(9.4,47,22,5.9,"PAH",700,1,4,0)="User needs to manually remove the indicator when entering changes. "
^DIC(9.4,47,22,5.9,"PAH",700,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",700,1,6,0)="2. SAC violation in Patch DG*5.3*864, a non-incremental lock was "
^DIC(9.4,47,22,5.9,"PAH",700,1,7,0)="introduced."
^DIC(9.4,47,22,5.9,"PAH",700,1,8,0)=" "
^DIC(9.4,47,22,5.9,"PAH",700,1,9,0)="3. User manual needs updated to reflect functionality changes from prior "
^DIC(9.4,47,22,5.9,"PAH",700,1,10,0)="patch, DG*5.3*93"
^DIC(9.4,47,22,5.9,"PAH",700,1,11,0)=" "
^DIC(9.4,47,22,5.9,"PAH",700,1,12,0)="4. DRG Frequency Report is not showing all patients in the Service "
^DIC(9.4,47,22,5.9,"PAH",700,1,13,0)="category."
^DIC(9.4,47,22,5.9,"PAH",701,0)="892 SEQ #793^3150504.130931^17"
^DIC(9.4,47,22,5.9,"PAH",701,1,0)="^^6^6^3150504"
^DIC(9.4,47,22,5.9,"PAH",701,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",701,1,2,0)="Patch DG*5.3*892 addresses 3 issues:"
^DIC(9.4,47,22,5.9,"PAH",701,1,3,0)="      "
^DIC(9.4,47,22,5.9,"PAH",701,1,4,0)=" 1.)  Undefined error when entering Confidential Address"
^DIC(9.4,47,22,5.9,"PAH",701,1,5,0)=" 2.)  PRF Assignment Action Not Linked Report issue"
^DIC(9.4,47,22,5.9,"PAH",701,1,6,0)=" 3.)  Documentation change needed for MISSING PATIENT PRF"
^DIC(9.4,47,22,5.9,"PAH",702,0)="905 SEQ #794^3150616.122223^17"
^DIC(9.4,47,22,5.9,"PAH",702,1,0)="^^10^10^3150616"
^DIC(9.4,47,22,5.9,"PAH",702,1,1,0)="After the installation of the DG*5.3*850 patch, sites reported these "
^DIC(9.4,47,22,5.9,"PAH",702,1,2,0)="three issues that are being fixed with this patch:"
^DIC(9.4,47,22,5.9,"PAH",702,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",702,1,4,0)="1) The Census Status Report [DGPT CENSUS STATUS REPORT] is reporting the"
^DIC(9.4,47,22,5.9,"PAH",702,1,5,0)="   admission ward instead of the last movement ward."
^DIC(9.4,47,22,5.9,"PAH",702,1,6,0)="2) When entering a movement for a Post-Vietnam P.O.S. and the SW Asia"
^DIC(9.4,47,22,5.9,"PAH",702,1,7,0)="   Service flag has been set, a prompt for establishing the SW Asia"
^DIC(9.4,47,22,5.9,"PAH",702,1,8,0)="   condition will cause a hard error when answered."
^DIC(9.4,47,22,5.9,"PAH",702,1,9,0)="3) When performing an inquiry in option MPCR INQUIRY [DGPT MPCR"
^DIC(9.4,47,22,5.9,"PAH",702,1,10,0)="   INQUIRY] a hard error occurs."
^DIC(9.4,47,22,5.9,"PAH",703,0)="894^3150826.164625^17"
^DIC(9.4,47,22,5.9,"PAH",703,1,0)="^^4^4^3150826"
^DIC(9.4,47,22,5.9,"PAH",703,1,1,0)="This patch replaces CD STATUS DIAGNOSES, CD STATUS PROCEDURES and CD "
^DIC(9.4,47,22,5.9,"PAH",703,1,2,0)="STATUS CONDITIONS with CD DESCRIPTORS, thus eliminating the use of ICD "
^DIC(9.4,47,22,5.9,"PAH",703,1,3,0)="and CPT codes for qualifying CD Reasons. Six new descriptors with a TYPE "
^DIC(9.4,47,22,5.9,"PAH",703,1,4,0)="of ""DE"" are added to the Catastrophic Disability REASONS file  #27.17."
^DIC(9.4,47,22,5.9,"PAH",704,0)="884^3150916.11101^17"
^DIC(9.4,47,22,5.9,"PAH",704,1,0)="^^2^2^3150916"
^DIC(9.4,47,22,5.9,"PAH",704,1,1,0)="Please refer to DG*5.3*884 in the National Patch Module for a description"
^DIC(9.4,47,22,5.9,"PAH",704,1,2,0)="of this patch."
^DIC(9.4,47,22,5.9,"PAH",705,0)="902 SEQ #797^3150916.142439^17"
^DIC(9.4,47,22,5.9,"PAH",705,1,0)="^^3^3^3150916"
^DIC(9.4,47,22,5.9,"PAH",705,1,1,0)="MASTER VETERAN INDEX VISTA ISSUES - ITERATION 13"
^DIC(9.4,47,22,5.9,"PAH",705,1,2,0)="Refer to patch DG*5.3*902 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",705,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",706,0)="897^3151102.13554^17"
^DIC(9.4,47,22,5.9,"PAH",706,1,0)="^^4^4^3151102"
^DIC(9.4,47,22,5.9,"PAH",706,1,1,0)="Patch DG*5.3*897 addresses one issue:"
^DIC(9.4,47,22,5.9,"PAH",706,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",706,1,3,0)="       1.  Patient File Update Utility is not dinuming patients with "
^DIC(9.4,47,22,5.9,"PAH",706,1,4,0)="           multiple races correctly."
^DIC(9.4,47,22,5.9,"PAH",707,0)="915 SEQ #799^3160105.115737^54"
^DIC(9.4,47,22,5.9,"PAH",707,1,0)="^^3^3^3160105"
^DIC(9.4,47,22,5.9,"PAH",707,1,1,0)="ENTERPRISE REGISTRATION - ITERATION 14"
^DIC(9.4,47,22,5.9,"PAH",707,1,2,0)="Refer to patch DG*5.3*915 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",707,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",708,0)="865^3160105.120853^54"
^DIC(9.4,47,22,5.9,"PAH",708,1,0)="^^3^3^3160105"
^DIC(9.4,47,22,5.9,"PAH",708,1,1,0)="This patch contains VistA changes to support technology and business"
^DIC(9.4,47,22,5.9,"PAH",708,1,2,0)="changes that are occurring with the implementation of the Email Address "
^DIC(9.4,47,22,5.9,"PAH",708,1,3,0)="Indicator project."
^DIC(9.4,47,22,5.9,"PAH",709,0)="891^3160105.121137^54"
^DIC(9.4,47,22,5.9,"PAH",709,1,0)="^^19^19^3160105"
^DIC(9.4,47,22,5.9,"PAH",709,1,1,0)="The Health Eligibility Center (HEC) requested modifications to the "
^DIC(9.4,47,22,5.9,"PAH",709,1,2,0)="Enrollment System (ES) and VistA Registration, Enrollment and Eligibility "
^DIC(9.4,47,22,5.9,"PAH",709,1,3,0)="(VistA REE) software to support the requirements of the Means Test Report "
^DIC(9.4,47,22,5.9,"PAH",709,1,4,0)="for ES project 4.0.  "
^DIC(9.4,47,22,5.9,"PAH",709,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",709,1,6,0)="The new requirements check whether the patient means test is current or  "
^DIC(9.4,47,22,5.9,"PAH",709,1,7,0)="not.  If the means test is current than the patient record is not "
^DIC(9.4,47,22,5.9,"PAH",709,1,8,0)="displayed.  "
^DIC(9.4,47,22,5.9,"PAH",709,1,9,0)=" "
^DIC(9.4,47,22,5.9,"PAH",709,1,10,0)="The following are the new guidelines on whether a patient means test is "
^DIC(9.4,47,22,5.9,"PAH",709,1,11,0)="current."
^DIC(9.4,47,22,5.9,"PAH",709,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",709,1,13,0)="1. The Means Test Effective Date is between (inclusive): 1/2/2012 and "
^DIC(9.4,47,22,5.9,"PAH",709,1,14,0)="   12/31/2012"
^DIC(9.4,47,22,5.9,"PAH",709,1,15,0)="2. The Mean Test Effective Date is greater than 1/1/2013 AND has a MT"
^DIC(9.4,47,22,5.9,"PAH",709,1,16,0)="   Status of MT Copay Exempt, GMT Copay Required, or Pending Adjudication"
^DIC(9.4,47,22,5.9,"PAH",709,1,17,0)="3. The MT Status equals MT Copay Required"
^DIC(9.4,47,22,5.9,"PAH",709,1,18,0)="4. The MT Status equals No Longer Required"
^DIC(9.4,47,22,5.9,"PAH",709,1,19,0)="5. The Means Test Effective Date is not a future date"
^DIC(9.4,47,22,5.9,"PAH",710,0)="871^3160105.121139^54"
^DIC(9.4,47,22,5.9,"PAH",710,1,0)="^^30^30^3160105"
^DIC(9.4,47,22,5.9,"PAH",710,1,1,0)=" *************************************************************************"
^DIC(9.4,47,22,5.9,"PAH",710,1,2,0)=" Note:  This patch is being released in support of the Enrollment System"
^DIC(9.4,47,22,5.9,"PAH",710,1,3,0)="        Re-design (ESR) Health Benefit Plans project.  DG*5.3*871 is"
^DIC(9.4,47,22,5.9,"PAH",710,1,4,0)="        released in host file DG_53_P891.KID along with several other"
^DIC(9.4,47,22,5.9,"PAH",710,1,5,0)="        patches."
^DIC(9.4,47,22,5.9,"PAH",710,1,6,0)="  "
^DIC(9.4,47,22,5.9,"PAH",710,1,7,0)="        It is imperative that this patch be installed no later than the"
^DIC(9.4,47,22,5.9,"PAH",710,1,8,0)="        compliance date.  Your understanding and support is appreciated."
^DIC(9.4,47,22,5.9,"PAH",710,1,9,0)=" "
^DIC(9.4,47,22,5.9,"PAH",710,1,10,0)=" *************************************************************************"
^DIC(9.4,47,22,5.9,"PAH",710,1,11,0)="  "
^DIC(9.4,47,22,5.9,"PAH",710,1,12,0)=" The Health Eligibility Center (HEC) requested modifications to the "
^DIC(9.4,47,22,5.9,"PAH",710,1,13,0)=" Enrollment System Redesign (ESR) and VistA Registration, Enrollment and"
^DIC(9.4,47,22,5.9,"PAH",710,1,14,0)=" Eligibility (Vista REE) software to support the requirements of the"
^DIC(9.4,47,22,5.9,"PAH",710,1,15,0)=" Health Benefit Plans project."
^DIC(9.4,47,22,5.9,"PAH",710,1,16,0)="  "
^DIC(9.4,47,22,5.9,"PAH",710,1,17,0)=" This patch modifies the Registration v5.3 application as described below:"
^DIC(9.4,47,22,5.9,"PAH",710,1,18,0)="  "
^DIC(9.4,47,22,5.9,"PAH",710,1,19,0)="   --   Create a new file containing the Health Benefit Plans and their"
^DIC(9.4,47,22,5.9,"PAH",710,1,20,0)="        expanded descriptions."
^DIC(9.4,47,22,5.9,"PAH",710,1,21,0)="   --   Modify Register a Patient [DG REGISTER PATIENT], "
^DIC(9.4,47,22,5.9,"PAH",710,1,22,0)="        Load/Edit Patient Data [DG LOAD PATIENT DATA] and "
^DIC(9.4,47,22,5.9,"PAH",710,1,23,0)="        View Registration Data [DG REGISTRATION VIEW]"
^DIC(9.4,47,22,5.9,"PAH",710,1,24,0)="        to allow user to view HBP profile for a veteran."
^DIC(9.4,47,22,5.9,"PAH",710,1,25,0)="   --   Display expanded help text for HBP"
^DIC(9.4,47,22,5.9,"PAH",710,1,26,0)="   --   Store all history of assignments for HBP and be able to view"
^DIC(9.4,47,22,5.9,"PAH",710,1,27,0)="   --   Store data from the Z11 message when received from ES"
^DIC(9.4,47,22,5.9,"PAH",710,1,28,0)="   --   Create an API that will provide HBP information to Vista "
^DIC(9.4,47,22,5.9,"PAH",710,1,29,0)="        downstream applications to include the HBP Name and HBP"
^DIC(9.4,47,22,5.9,"PAH",710,1,30,0)="        Description."
^DIC(9.4,47,22,5.9,"PAH",711,0)="890^3160105.121139^54"
^DIC(9.4,47,22,5.9,"PAH",711,1,0)="^^32^32^3160105"
^DIC(9.4,47,22,5.9,"PAH",711,1,1,0)="*************************************************************************"
^DIC(9.4,47,22,5.9,"PAH",711,1,2,0)=" Note:  This patch is being released in support of the Enrollment System"
^DIC(9.4,47,22,5.9,"PAH",711,1,3,0)="        (ES) 4.0 project.  DG*5.3*890 is released in host file"
^DIC(9.4,47,22,5.9,"PAH",711,1,4,0)="        DG_53_P891.KID along with several other patches."
^DIC(9.4,47,22,5.9,"PAH",711,1,5,0)="  "
^DIC(9.4,47,22,5.9,"PAH",711,1,6,0)="        It is imperative that this patch be installed no later than the"
^DIC(9.4,47,22,5.9,"PAH",711,1,7,0)="        compliance date.  Your understanding and support is appreciated."
^DIC(9.4,47,22,5.9,"PAH",711,1,8,0)=" "
^DIC(9.4,47,22,5.9,"PAH",711,1,9,0)=" *************************************************************************"
^DIC(9.4,47,22,5.9,"PAH",711,1,10,0)=" "
^DIC(9.4,47,22,5.9,"PAH",711,1,11,0)="This patch modifies the Registration v5.3 application as described below:"
^DIC(9.4,47,22,5.9,"PAH",711,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",711,1,13,0)="Create a new data dictionary question for Contributed to Spousal Support."
^DIC(9.4,47,22,5.9,"PAH",711,1,14,0)="Create a new data dictionary question for Contributed to Child Support."
^DIC(9.4,47,22,5.9,"PAH",711,1,15,0)=" "
^DIC(9.4,47,22,5.9,"PAH",711,1,16,0)="--  Health Eligibility Center (HEC) requested the Contributed to "
^DIC(9.4,47,22,5.9,"PAH",711,1,17,0)="    Spouse and Contributed to Child field be converted to accept a True"
^DIC(9.4,47,22,5.9,"PAH",711,1,18,0)="    (Yes) or False (No) response instead of a dollar amount. This field  "
^DIC(9.4,47,22,5.9,"PAH",711,1,19,0)="    will be available to the user if the Lived with Patient Indicator"
^DIC(9.4,47,22,5.9,"PAH",711,1,20,0)="    is populated with a False (No) response. "
^DIC(9.4,47,22,5.9,"PAH",711,1,21,0)="--  This patch will decommission the AMOUNT CONTRIBUTED TO SPOUSE (Field "
^DIC(9.4,47,22,5.9,"PAH",711,1,22,0)="    #.07) and AMOUNT CONTRIBUTED TO CHILD (Field #.19) in the Income "
^DIC(9.4,47,22,5.9,"PAH",711,1,23,0)="    Relation (File #408.22). The Means Test and Rx Copay Test will no "
^DIC(9.4,47,22,5.9,"PAH",711,1,24,0)="    longer prompt for entry to these two fields."
^DIC(9.4,47,22,5.9,"PAH",711,1,25,0)="--  This patch will add a new CONTRIBUTED TO SPOUSAL SUPPORT (Field #.21) "
^DIC(9.4,47,22,5.9,"PAH",711,1,26,0)="    to the Income Relation File (File #408.22). The field will be a Y/N  "
^DIC(9.4,47,22,5.9,"PAH",711,1,27,0)="    or Null set. This patch will prompt for entry of this new field at "
^DIC(9.4,47,22,5.9,"PAH",711,1,28,0)="    the appropriate point in the Means Test and Rx Copay test process."
^DIC(9.4,47,22,5.9,"PAH",711,1,29,0)="--  Modified Z07 message builder to include the Contributed to Spouse"
^DIC(9.4,47,22,5.9,"PAH",711,1,30,0)="    indicator on the ORU Z07 ZIR segment."
^DIC(9.4,47,22,5.9,"PAH",711,1,31,0)="    Added a trigger for an ORF Z07 message when a change is made to"
^DIC(9.4,47,22,5.9,"PAH",711,1,32,0)="    the Contributed to Spouse indicator."
^DIC(9.4,47,22,5.9,"PAH",712,0)="904^3160105.121139^54"
^DIC(9.4,47,22,5.9,"PAH",712,1,0)="^^11^11^3160105"
^DIC(9.4,47,22,5.9,"PAH",712,1,1,0)="This patch modifies the Registration v5.3 application as described below:"
^DIC(9.4,47,22,5.9,"PAH",712,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",712,1,3,0)="--   This patch will display a new Beneficiary Travel Financial Indicator"
^DIC(9.4,47,22,5.9,"PAH",712,1,4,0)="     on the Means Test and Copay Test overview screens. The BT Financial"
^DIC(9.4,47,22,5.9,"PAH",712,1,5,0)="     indicator will be sent from the Enrollment System and share with all"
^DIC(9.4,47,22,5.9,"PAH",712,1,6,0)="     sites of record when the Income Verification Matching (IVM)"
^DIC(9.4,47,22,5.9,"PAH",712,1,7,0)="     application has performed a Conversion and/or Reversal on an income"
^DIC(9.4,47,22,5.9,"PAH",712,1,8,0)="     test where the Veteran had a BT award prior to the IVM action. A"
^DIC(9.4,47,22,5.9,"PAH",712,1,9,0)="     bulletin will be generated and sent to the BT CLAIMS PROCESSING"
^DIC(9.4,47,22,5.9,"PAH",712,1,10,0)="     Mailgroup to notify select members that there has been a change in"
^DIC(9.4,47,22,5.9,"PAH",712,1,11,0)="     the Veteran's BT Financial Indicator status."
^DIC(9.4,47,22,5.9,"PAH",713,0)="901^3160105.121141^54"
^DIC(9.4,47,22,5.9,"PAH",713,1,0)="^^3^3^3160105"
^DIC(9.4,47,22,5.9,"PAH",713,1,1,0)="This patch contains changes to the Date of Death application necessary to "
^DIC(9.4,47,22,5.9,"PAH",713,1,2,0)="accomodate having the Master Veteran Index become the authoritative "
^DIC(9.4,47,22,5.9,"PAH",713,1,3,0)="source for Date of Death data entry."
^DIC(9.4,47,22,5.9,"PAH",714,0)="906^3160105.121141^54"
^DIC(9.4,47,22,5.9,"PAH",715,0)="922^3160107.150418^54"
^DIC(9.4,47,22,5.9,"PAH",715,1,0)="^^5^5^3160107"
^DIC(9.4,47,22,5.9,"PAH",715,1,1,0)="This patch, DG*5.3*922 is one of three VistA 2016 threshold patches. It "
^DIC(9.4,47,22,5.9,"PAH",715,1,2,0)="updates the thresholds for the Means Tests and the Maximum Annual Pension "
^DIC(9.4,47,22,5.9,"PAH",715,1,3,0)="Rate. Patch EAS*1.0*134 will address the annual updates for the GMT "
^DIC(9.4,47,22,5.9,"PAH",715,1,4,0)="Thresholds and patch IB*2.0*557 will address the annual updates for the "
^DIC(9.4,47,22,5.9,"PAH",715,1,5,0)="Pharmacy Copay Thresholds."
^DIC(9.4,47,22,5.9,"PAH",716,0)="911 SEQ #808^3160310.171707^54"
^DIC(9.4,47,22,5.9,"PAH",716,1,0)="^^5^5^3160310"
^DIC(9.4,47,22,5.9,"PAH",716,1,1,0)="Patch DG*5.3*911 will address one issue:"
^DIC(9.4,47,22,5.9,"PAH",716,1,2,0)="Integrated Sites working with a Patient Record Flag must first"
^DIC(9.4,47,22,5.9,"PAH",716,1,3,0)="assign the flag to their ""main"" site and then edit the flag for"
^DIC(9.4,47,22,5.9,"PAH",716,1,4,0)="other sites to be able to receive/process the incoming HL7 messages, or"
^DIC(9.4,47,22,5.9,"PAH",716,1,5,0)="else the message is rejected as not coming from owning site."
^DIC(9.4,47,22,5.9,"PAH",717,0)="909^3160418.153015^54"
^DIC(9.4,47,22,5.9,"PAH",717,1,0)="^^4^4^3160418"
^DIC(9.4,47,22,5.9,"PAH",717,1,1,0)="DG*5.3*909 will update the Registration application to allow for the "
^DIC(9.4,47,22,5.9,"PAH",717,1,2,0)="entering and maintenance of the Camp Lejeune Eligibility related data."
^DIC(9.4,47,22,5.9,"PAH",717,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",717,1,4,0)="Please refer to Forum for a complete description of the updates."
^DIC(9.4,47,22,5.9,"PAH",718,0)="919 SEQ #810^3160608.163737^54"
^DIC(9.4,47,22,5.9,"PAH",718,1,0)="^^3^3^3160608"
^DIC(9.4,47,22,5.9,"PAH",718,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - ITERATION 15"
^DIC(9.4,47,22,5.9,"PAH",718,1,2,0)="Refer to patch DG*5.3*919 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",718,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",719,0)="917 SEQ #811^3160616.161513^54"
^DIC(9.4,47,22,5.9,"PAH",719,1,0)="^^4^4^3160616"
^DIC(9.4,47,22,5.9,"PAH",719,1,1,0)="Patch DG*5.3*917 addresses one issue:"
^DIC(9.4,47,22,5.9,"PAH",719,1,2,0)="1)      Menu option Add/Edit Suffix Effective Date [DG PTF SUFFIX EFF "
^DIC(9.4,47,22,5.9,"PAH",719,1,3,0)="        DATE EDIT] was marked Out of Order in a previous patch. "
^DIC(9.4,47,22,5.9,"PAH",719,1,4,0)="        Business Owner has requested that this option be re-activated"
^DIC(9.4,47,22,5.9,"PAH",720,0)="927 SEQ #813^3160916.133729^54"
^DIC(9.4,47,22,5.9,"PAH",720,1,0)="^^2^2^3160916"
^DIC(9.4,47,22,5.9,"PAH",720,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",720,1,2,0)="This patch inactivates Eleven Treating Specialty (TS) codes"
^DIC(9.4,47,22,5.9,"PAH",721,0)="916^3160916.142326^54"
^DIC(9.4,47,22,5.9,"PAH",722,0)="855^3161014.135219^54"
^DIC(9.4,47,22,5.9,"PAH",722,1,0)="^^35^35^3161014"
^DIC(9.4,47,22,5.9,"PAH",722,1,1,0)="Patch DG*5.3*797 added the new MILITARY SERVICE EPISODE sub-file #2.3216 "
^DIC(9.4,47,22,5.9,"PAH",722,1,2,0)="in the PATIENT (#2) file to store Military Service Episode (MSE) data."
^DIC(9.4,47,22,5.9,"PAH",722,1,3,0)="Changes in that patch included modifications to several consistency "
^DIC(9.4,47,22,5.9,"PAH",722,1,4,0)="checks that used MSE data.  The consistency checks that are listed in the "
^DIC(9.4,47,22,5.9,"PAH",722,1,5,0)="DG*5.3*797 patch description are correctly using the new MILITARY SERVICE "
^DIC(9.4,47,22,5.9,"PAH",722,1,6,0)="EPISODE sub-file #2.3216 and the new Screen 6.1 to edit the data."
^DIC(9.4,47,22,5.9,"PAH",722,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",722,1,8,0)="However, there is a set of consistency checks in the INCONSISTENT DATA "
^DIC(9.4,47,22,5.9,"PAH",722,1,9,0)="ELEMENTS (#38.6) file that are considered related to Eligibility.   If "
^DIC(9.4,47,22,5.9,"PAH",722,1,10,0)="any of those inconsistencies is edited, the user is prompted with a set "
^DIC(9.4,47,22,5.9,"PAH",722,1,11,0)="of eligibility-related fields that includes the Last Service Episode "
^DIC(9.4,47,22,5.9,"PAH",722,1,12,0)="fields.  Since these inconsistencies were not modified for DG*5.3*797, "
^DIC(9.4,47,22,5.9,"PAH",722,1,13,0)="the user is being prompted with the old MSE fields for SERVICE EPISODE "
^DIC(9.4,47,22,5.9,"PAH",722,1,14,0)="[LAST].  These are the inconsistencies that are considered related to "
^DIC(9.4,47,22,5.9,"PAH",722,1,15,0)="Eligibility:"
^DIC(9.4,47,22,5.9,"PAH",722,1,16,0)=" "
^DIC(9.4,47,22,5.9,"PAH",722,1,17,0)="   9            VETERAN STATUS UNSPECIFIED"
^DIC(9.4,47,22,5.9,"PAH",722,1,18,0)="   10           SC PROMPT UNANSWERED"
^DIC(9.4,47,22,5.9,"PAH",722,1,19,0)="   11           SC PROMPT INCONSISTENT"
^DIC(9.4,47,22,5.9,"PAH",722,1,20,0)="   12           SC% UNSPECIFIED FOR SC VET"
^DIC(9.4,47,22,5.9,"PAH",722,1,21,0)="   13           POS UNSPECIFIED"
^DIC(9.4,47,22,5.9,"PAH",722,1,22,0)="   14           ELIG CODE UNSPECIFIED"
^DIC(9.4,47,22,5.9,"PAH",722,1,23,0)="   18           ELIG/VET STATUS INCONSISTENT"
^DIC(9.4,47,22,5.9,"PAH",722,1,24,0)="   19           ELIG/NONVET STAT INCONSISTENT"
^DIC(9.4,47,22,5.9,"PAH",722,1,25,0)="   20           ELIG/SC% INCONSISTENT"
^DIC(9.4,47,22,5.9,"PAH",722,1,26,0)="   22           ELIG CODE INCONSISTENT"
^DIC(9.4,47,22,5.9,"PAH",722,1,27,0)="   24           POS/ELIG CODE INCONSISTENT"
^DIC(9.4,47,22,5.9,"PAH",722,1,28,0)="   36           PATIENT TYPE UNDEFINED"
^DIC(9.4,47,22,5.9,"PAH",722,1,29,0)="   "
^DIC(9.4,47,22,5.9,"PAH",722,1,30,0)=" "
^DIC(9.4,47,22,5.9,"PAH",722,1,31,0)="This patch fixes this problem which was reported in Remedy ticket "
^DIC(9.4,47,22,5.9,"PAH",722,1,32,0)="HD0000000623739 (DG*5.3*797 - MSDS MSE inappropriate prompts).  When "
^DIC(9.4,47,22,5.9,"PAH",722,1,33,0)="editing any of those eligibility-related inconsistencies, the user will "
^DIC(9.4,47,22,5.9,"PAH",722,1,34,0)="not be prompted with the old MSE fields and will now edit the MSE data in "
^DIC(9.4,47,22,5.9,"PAH",722,1,35,0)="sub-file #2.3216 on the new Screen 6.1."
^DIC(9.4,47,22,5.9,"PAH",723,0)="926 SEQ #815^3161220.151943^54"
^DIC(9.4,47,22,5.9,"PAH",723,1,0)="^^3^3^3161220"
^DIC(9.4,47,22,5.9,"PAH",723,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - ITERATION 16 / RELEASE 2"
^DIC(9.4,47,22,5.9,"PAH",723,1,2,0)="Refer to patch DG*5.3*926 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",723,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",724,0)="921^3170123.14263^54"
^DIC(9.4,47,22,5.9,"PAH",724,1,0)="^^25^25^3170123"
^DIC(9.4,47,22,5.9,"PAH",724,1,1,0)="Modified DG10 routine to allow for additional fields in file 2 to trigger"
^DIC(9.4,47,22,5.9,"PAH",724,1,2,0)="an unsolicited update.  Here are the fields that trigger freshness update:"
^DIC(9.4,47,22,5.9,"PAH",724,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",724,1,4,0)="Field #             Field Name"
^DIC(9.4,47,22,5.9,"PAH",724,1,5,0)="=======             =========="
^DIC(9.4,47,22,5.9,"PAH",724,1,6,0)=".033                Age"
^DIC(9.4,47,22,5.9,"PAH",724,1,7,0)=".133                Email Address"
^DIC(9.4,47,22,5.9,"PAH",724,1,8,0)=".1211               Temporary Address Line 1"
^DIC(9.4,47,22,5.9,"PAH",724,1,9,0)=".1212               Temporary Address Line 2"
^DIC(9.4,47,22,5.9,"PAH",724,1,10,0)=".1213               Temporary Address Line 3"
^DIC(9.4,47,22,5.9,"PAH",724,1,11,0)=".1214               Temporary City"
^DIC(9.4,47,22,5.9,"PAH",724,1,12,0)=".1215               Temporary State"
^DIC(9.4,47,22,5.9,"PAH",724,1,13,0)=".1216               Temporary Zipcode"
^DIC(9.4,47,22,5.9,"PAH",724,1,14,0)=".21011              Primary NOK Work Phone Number"
^DIC(9.4,47,22,5.9,"PAH",724,1,15,0)=".215                Primary NOK Streed Address Line 3"
^DIC(9.4,47,22,5.9,"PAH",724,1,16,0)=".331                Emergency Contact Name"
^DIC(9.4,47,22,5.9,"PAH",724,1,17,0)=".332                Emergency Contact Relationship"
^DIC(9.4,47,22,5.9,"PAH",724,1,18,0)=".333                Emergency Contact Street Address Line 1"
^DIC(9.4,47,22,5.9,"PAH",724,1,19,0)=".334                Emergency Contact Street Address Line 2"
^DIC(9.4,47,22,5.9,"PAH",724,1,20,0)=".335                Emergency Contact Street Address Line 3"
^DIC(9.4,47,22,5.9,"PAH",724,1,21,0)=".336                Emergency Contact City"
^DIC(9.4,47,22,5.9,"PAH",724,1,22,0)=".337                Emergency Contact State"
^DIC(9.4,47,22,5.9,"PAH",724,1,23,0)=".338                Emergency Contact Zipcode"
^DIC(9.4,47,22,5.9,"PAH",724,1,24,0)=".3731               Service COnnected Conditions"
^DIC(9.4,47,22,5.9,"PAH",724,1,25,0)=".3121               Insurance"
^DIC(9.4,47,22,5.9,"PAH",725,0)="930^3170123.144943^54"
^DIC(9.4,47,22,5.9,"PAH",725,1,0)="^^5^5^3170123"
^DIC(9.4,47,22,5.9,"PAH",725,1,1,0)="This patch, DG*5.3*930 is one of three VistA 2017 threshold patches. It "
^DIC(9.4,47,22,5.9,"PAH",725,1,2,0)="updates the thresholds for the Means Tests and the Maximum Annual Pension "
^DIC(9.4,47,22,5.9,"PAH",725,1,3,0)="Rate. Patch EAS*1.0*144 will address the annual updates for the GMT "
^DIC(9.4,47,22,5.9,"PAH",725,1,4,0)="Thresholds and patch IB*2.0*583 will address the annual updates for the "
^DIC(9.4,47,22,5.9,"PAH",725,1,5,0)="Pharmacy Copay Thresholds."
^DIC(9.4,47,22,5.9,"PAH",726,0)="887^3170313.144852^54"
^DIC(9.4,47,22,5.9,"PAH",726,1,0)="^^2^2^3170313"
^DIC(9.4,47,22,5.9,"PAH",726,1,1,0)="This patch allows for the addition of language data to the Patient file."
^DIC(9.4,47,22,5.9,"PAH",726,1,2,0)=""
^DIC(9.4,47,22,5.9,"PAH",727,0)="928 SEQ #819^3170427.163542^54"
^DIC(9.4,47,22,5.9,"PAH",727,1,0)="^^4^4^3170427"
^DIC(9.4,47,22,5.9,"PAH",727,1,1,0)="Registration/Enrollment system sends notification emails if there is an "
^DIC(9.4,47,22,5.9,"PAH",727,1,2,0)="issue with the Upload process to a remote email address that has been "
^DIC(9.4,47,22,5.9,"PAH",727,1,3,0)="decommissioned. This patch will not allow emails to be sent to the remote"
^DIC(9.4,47,22,5.9,"PAH",727,1,4,0)="email group, but continue to use the local mail group."
^DIC(9.4,47,22,5.9,"PAH",728,0)="903 SEQ #820^3170427.165848^54"
^DIC(9.4,47,22,5.9,"PAH",728,1,0)="^^27^27^3170427"
^DIC(9.4,47,22,5.9,"PAH",728,1,1,0)="Increase Engagement in My HealtheVet (IEMHV)"
^DIC(9.4,47,22,5.9,"PAH",728,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",728,1,3,0)="This patch contains enhancements to Pre-Registration functionality in the"
^DIC(9.4,47,22,5.9,"PAH",728,1,4,0)="Preregister a Patient [DGPRE PRE-REGISTER] option in the VistA"
^DIC(9.4,47,22,5.9,"PAH",728,1,5,0)="Registration V.5.3 package to increase patient engagement in My "
^DIC(9.4,47,22,5.9,"PAH",728,1,6,0)="HealtheVet."
^DIC(9.4,47,22,5.9,"PAH",728,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",728,1,8,0)="My HealtheVet Enrollment Alert/Reminder"
^DIC(9.4,47,22,5.9,"PAH",728,1,9,0)="---------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",728,1,10,0)="The Preregister a Patient [DGPRE PRE-REGISTER] option has been enhanced "
^DIC(9.4,47,22,5.9,"PAH",728,1,11,0)="to display a message alerting the clerk that the selected patient "
^DIC(9.4,47,22,5.9,"PAH",728,1,12,0)="has neither completed My HealtheVet registration, nor documented their "
^DIC(9.4,47,22,5.9,"PAH",728,1,13,0)="desire to be excluded from My HealtheVet registration. Recent assistance "
^DIC(9.4,47,22,5.9,"PAH",728,1,14,0)="provided by Pre-Registration clerks with the patient's My HealtheVet"
^DIC(9.4,47,22,5.9,"PAH",728,1,15,0)="enrollment is displayed within the alert/reminder."
^DIC(9.4,47,22,5.9,"PAH",728,1,16,0)=" "
^DIC(9.4,47,22,5.9,"PAH",728,1,17,0)="Socialization Questions and Responses"
^DIC(9.4,47,22,5.9,"PAH",728,1,18,0)="-------------------------------------"
^DIC(9.4,47,22,5.9,"PAH",728,1,19,0)="The Preregister a Patient [DGPRE PRE-REGISTER] option has been enhanced "
^DIC(9.4,47,22,5.9,"PAH",728,1,20,0)="to capture a patient's My HealtheVet registration status during the "
^DIC(9.4,47,22,5.9,"PAH",728,1,21,0)="pre-registration process."
^DIC(9.4,47,22,5.9,"PAH",728,1,22,0)=" "
^DIC(9.4,47,22,5.9,"PAH",728,1,23,0)="My HealtheVet Registration Actions"
^DIC(9.4,47,22,5.9,"PAH",728,1,24,0)="--------------------------------"
^DIC(9.4,47,22,5.9,"PAH",728,1,25,0)="The Preregister a Patient [DGPRE PRE-REGISTER] option has been enhanced "
^DIC(9.4,47,22,5.9,"PAH",728,1,26,0)="to capture actions Pre-Registration clerks performed to assist with a"
^DIC(9.4,47,22,5.9,"PAH",728,1,27,0)="patient's My HealtheVet registration."
^DIC(9.4,47,22,5.9,"PAH",729,0)="907 SEQ #821^3170530.154242^54"
^DIC(9.4,47,22,5.9,"PAH",729,1,0)="^^3^3^3170530"
^DIC(9.4,47,22,5.9,"PAH",729,1,1,0)="This patch modifies the Registration v5.3 application to update the "
^DIC(9.4,47,22,5.9,"PAH",729,1,2,0)="prompt text and display of the Birth Sex and Self-Identified Gender "
^DIC(9.4,47,22,5.9,"PAH",729,1,3,0)="Identity fields.  See patch description on Forum for full details."
^DIC(9.4,47,22,5.9,"PAH",730,0)="937 SEQ #822^3170601.173858^54"
^DIC(9.4,47,22,5.9,"PAH",730,1,0)="^^3^3^3170601"
^DIC(9.4,47,22,5.9,"PAH",730,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - 'PREFERRED NAME'"
^DIC(9.4,47,22,5.9,"PAH",730,1,2,0)="Refer to patch DG*5.3*937 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",730,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",731,0)="934 SEQ #823^3170627.150844^54"
^DIC(9.4,47,22,5.9,"PAH",732,0)="939 SEQ #824^3170627.15093^54"
^DIC(9.4,47,22,5.9,"PAH",732,1,0)="^^1^1^3170627"
^DIC(9.4,47,22,5.9,"PAH",732,1,1,0)="ENROLLMENT SYSTEM MODERNIZATION (ESM) MANAGE DATE OF DEATH IN VISTA"
^DIC(9.4,47,22,5.9,"PAH",733,0)="912 SEQ #825^3170629.174114^54"
^DIC(9.4,47,22,5.9,"PAH",733,1,0)="^^10^10^3170629"
^DIC(9.4,47,22,5.9,"PAH",733,1,1,0)="Patch DG*5.3*912 addresses 3 issues:"
^DIC(9.4,47,22,5.9,"PAH",733,1,2,0)="      "
^DIC(9.4,47,22,5.9,"PAH",733,1,3,0)="1.)  Issue with Patient Treatment File (PTF) 801 screen, Current "
^DIC(9.4,47,22,5.9,"PAH",733,1,4,0)="     Procedural Terminilogy (CPT) codes File (#81) SHORT NAME field (#2)"
^DIC(9.4,47,22,5.9,"PAH",733,1,5,0)="     has been deleted."
^DIC(9.4,47,22,5.9,"PAH",733,1,6,0)="2.)  Military Service Data Inconsistencies Detail Report has data "
^DIC(9.4,47,22,5.9,"PAH",733,1,7,0)="     listed when nothing is wrong in the patient record."
^DIC(9.4,47,22,5.9,"PAH",733,1,8,0)="3.)  Patient Treatment File with multiple Current Procedural"
^DIC(9.4,47,22,5.9,"PAH",733,1,9,0)="     Terminilogy (CPT) codes, enter the wrong deletion date if there are"
^DIC(9.4,47,22,5.9,"PAH",733,1,10,0)="     multiple records"
^DIC(9.4,47,22,5.9,"PAH",734,0)="943 SEQ #826^3170726.135505^54"
^DIC(9.4,47,22,5.9,"PAH",734,1,0)="^^3^3^3170726"
^DIC(9.4,47,22,5.9,"PAH",734,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - 'DATE OF DEATH'"
^DIC(9.4,47,22,5.9,"PAH",734,1,2,0)="Refer to patch DG*5.3*943 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",734,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",735,0)="938 SEQ #827^3170802.121235^54"
^DIC(9.4,47,22,5.9,"PAH",735,1,0)="^^5^5^3170802"
^DIC(9.4,47,22,5.9,"PAH",735,1,1,0)="Description:"
^DIC(9.4,47,22,5.9,"PAH",735,1,2,0)="==========="
