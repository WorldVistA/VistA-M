^DIC(9.4,3,22,0)="^9.49I^21^1"
^DIC(9.4,3,22,21,0)="8.0^3051119^2960606^1"
^DIC(9.4,3,22,21,1,0)="^^2^2^3051119"
^DIC(9.4,3,22,21,1,1,0)="Kernel 8.0 is the latest release of VA Kernel software.  This version"
^DIC(9.4,3,22,21,1,2,0)="supersedes version 7.1."
^DIC(9.4,3,22,21,"PAH",0)="^9.4901^628^625"
^DIC(9.4,3,22,21,"PAH",1,0)="21^2960606^1"
^DIC(9.4,3,22,21,"PAH",1,1,0)="^^99^99^2960715^"
^DIC(9.4,3,22,21,"PAH",1,1,1,0)=" This Kernel patch is dependent on MailMan patch XM*7.1*24.  Both"
^DIC(9.4,3,22,21,"PAH",1,1,2,0)="patches must be installed at the same time. This patch contains the"
^DIC(9.4,3,22,21,"PAH",1,1,3,0)="following features:"
^DIC(9.4,3,22,21,"PAH",1,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",1,1,5,0)="-KIDS will disable Protocols during the install process.  This"
^DIC(9.4,3,22,21,"PAH",1,1,6,0)=" functionality was removed in patch XU*8.0*10."
^DIC(9.4,3,22,21,"PAH",1,1,7,0)="-KIDS will not disable Options or Protocols which have an Action of"
^DIC(9.4,3,22,21,"PAH",1,1,8,0)=" 'USE AS LINK FOR MENU ITEMS'."
^DIC(9.4,3,22,21,"PAH",1,1,9,0)="-Two new functions, $$PRODE^XPDUTL and $$OPTDE^XPDUTL, can be called"
^DIC(9.4,3,22,21,"PAH",1,1,10,0)=" during the install process."
^DIC(9.4,3,22,21,"PAH",1,1,11,0)="-KIDS now creates Packman messages in a format that MailMan can"
^DIC(9.4,3,22,21,"PAH",1,1,12,0)=" understand."
^DIC(9.4,3,22,21,"PAH",1,1,13,0)="-Two options, 'Recover deleted option set' [XQOOREDO] and 'Toggle"
^DIC(9.4,3,22,21,"PAH",1,1,14,0)=" options/protocols on and off' [XQOOTOG] are now under 'Out-Of-Order"
^DIC(9.4,3,22,21,"PAH",1,1,15,0)=" Set Management' menu."
^DIC(9.4,3,22,21,"PAH",1,1,16,0)="-Corrects undefined error when 'Compare Transport Global to Current System'"
^DIC(9.4,3,22,21,"PAH",1,1,17,0)=" option is queued. NOIS OKL-0296-70233 and LAS-0396-60110"
^DIC(9.4,3,22,21,"PAH",1,1,18,0)="-When a link to Package file doesn't exist during the load process, the"
^DIC(9.4,3,22,21,"PAH",1,1,19,0)=" Install file wasn't being updated with a new link during the install"
^DIC(9.4,3,22,21,"PAH",1,1,20,0)=" process. This is now corrected."
^DIC(9.4,3,22,21,"PAH",1,1,21,0)="-The install process will display a message for each CPU it updates.  It"
^DIC(9.4,3,22,21,"PAH",1,1,22,0)=" use to only display a message for the first one."
^DIC(9.4,3,22,21,"PAH",1,1,23,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",1,1,24,0)="This patch can be installed with users on the system, no user should be"
^DIC(9.4,3,22,21,"PAH",1,1,25,0)="using KIDS during the install of this patch.  MSM sites must manually move"
^DIC(9.4,3,22,21,"PAH",1,1,26,0)="the routine XPDIJ to their other CPUs. KIDS cannot automatically move this"
^DIC(9.4,3,22,21,"PAH",1,1,27,0)="routine for you."
^DIC(9.4,3,22,21,"PAH",1,1,28,0)="  "
^DIC(9.4,3,22,21,"PAH",1,1,29,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",1,1,30,0)="  "
^DIC(9.4,3,22,21,"PAH",1,1,31,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",1,1,32,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",1,1,33,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",1,1,34,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",1,1,35,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",1,1,36,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",1,1,37,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",1,1,38,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,3,22,21,"PAH",1,1,39,0)="      'Verify Checksum in Transport Global' and verify that all routines"
^DIC(9.4,3,22,21,"PAH",1,1,40,0)="      have the correct checksums."
^DIC(9.4,3,22,21,"PAH",1,1,41,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,3,22,21,"PAH",1,1,42,0)="      'Backup a Transport Global' to make a backup copy of the old"
^DIC(9.4,3,22,21,"PAH",1,1,43,0)="      routines being brought in by this patch."
^DIC(9.4,3,22,21,"PAH",1,1,44,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,3,22,21,"PAH",1,1,45,0)="      'Install Package(s)'. Select the package 'XU*8.0*21' and proceed"
^DIC(9.4,3,22,21,"PAH",1,1,46,0)="      with install."
^DIC(9.4,3,22,21,"PAH",1,1,47,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",1,1,48,0)="      other CPUs?'."
^DIC(9.4,3,22,21,"PAH",1,1,49,0)="  8.  MSM Sites - D ^%RCOPY to move the routine XPDIJ to your other"
^DIC(9.4,3,22,21,"PAH",1,1,50,0)="      CPUs."
^DIC(9.4,3,22,21,"PAH",1,1,51,0)="  9.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",1,1,52,0)=" ====================================================================  "
^DIC(9.4,3,22,21,"PAH",1,1,53,0)="  "
^DIC(9.4,3,22,21,"PAH",1,1,54,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",1,1,55,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",1,1,56,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",1,1,57,0)=" "
^DIC(9.4,3,22,21,"PAH",1,1,58,0)=" Name           Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",1,1,59,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",1,1,60,0)=" XPDCOM          2299089         21"
^DIC(9.4,3,22,21,"PAH",1,1,61,0)=" XPDDI           7062234         21"
^DIC(9.4,3,22,21,"PAH",1,1,62,0)=" XPDDP          12102989         21"
^DIC(9.4,3,22,21,"PAH",1,1,63,0)=" XPDE           13757383         2,15,21"
^DIC(9.4,3,22,21,"PAH",1,1,64,0)=" XPDI           16025869         10,21"
^DIC(9.4,3,22,21,"PAH",1,1,65,0)=" XPDIA          10483361         10,15,21"
^DIC(9.4,3,22,21,"PAH",1,1,66,0)=" XPDIJ          17914806         2,21"
^DIC(9.4,3,22,21,"PAH",1,1,67,0)=" XPDIP           8712983         15,21"
^DIC(9.4,3,22,21,"PAH",1,1,68,0)=" XPDIPM          1775672         21"
^DIC(9.4,3,22,21,"PAH",1,1,69,0)=" XPDIQ           6662686         21"
^DIC(9.4,3,22,21,"PAH",1,1,70,0)=" XPDMENU         1821149         21"
^DIC(9.4,3,22,21,"PAH",1,1,71,0)=" XPDTC          11632956         10,15,21"
^DIC(9.4,3,22,21,"PAH",1,1,72,0)=" XPDTP           2309897         21"
^DIC(9.4,3,22,21,"PAH",1,1,73,0)=" XPDUTL          2331761         21"
^DIC(9.4,3,22,21,"PAH",1,1,74,0)=" XQOO           20281727         10,21"
^DIC(9.4,3,22,21,"PAH",1,1,75,0)=" XQOO1          14241374         10,21"
^DIC(9.4,3,22,21,"PAH",1,1,76,0)=" ==========================================================================="
^DIC(9.4,3,22,21,"PAH",1,1,77,0)=" OPTIONS:"
^DIC(9.4,3,22,21,"PAH",1,1,78,0)=""
^DIC(9.4,3,22,21,"PAH",1,1,79,0)="'Toggle options/protocols on and off'     Option name: XQOOTOG"
^DIC(9.4,3,22,21,"PAH",1,1,80,0)="     This option is used to write or remove Out-Of-Order messages from"
^DIC(9.4,3,22,21,"PAH",1,1,81,0)="     individual options or protocols."
^DIC(9.4,3,22,21,"PAH",1,1,82,0)="'Recover deleted option set'     Option name: XQOOREDO"
^DIC(9.4,3,22,21,"PAH",1,1,83,0)="     This option will recover an option set that has been deleted from ^XTMP"
^DIC(9.4,3,22,21,"PAH",1,1,84,0)="     by looping through the Option and Protocol Files to find all that have"
^DIC(9.4,3,22,21,"PAH",1,1,85,0)="     a particular Out-of-order message.  It rebuilds the option set in ^XTMP."
^DIC(9.4,3,22,21,"PAH",1,1,86,0)=""
^DIC(9.4,3,22,21,"PAH",1,1,87,0)=" ============================================================================"
^DIC(9.4,3,22,21,"PAH",1,1,88,0)=" DOCUMENTATION:"
^DIC(9.4,3,22,21,"PAH",1,1,89,0)=""
^DIC(9.4,3,22,21,"PAH",1,1,90,0)="These two functions can be called in a Pre-Init or Post-Init routine to"
^DIC(9.4,3,22,21,"PAH",1,1,91,0)="disable or enable an Option or Protocol."
^DIC(9.4,3,22,21,"PAH",1,1,92,0)=" $$PRODE^XPDUTL(name,action) ;Disable/Enable a Protocol"
^DIC(9.4,3,22,21,"PAH",1,1,93,0)="  name=Protocol Name,  action= 1-enable, 0-disable"
^DIC(9.4,3,22,21,"PAH",1,1,94,0)="  returns: 1-success, 0-failure"
^DIC(9.4,3,22,21,"PAH",1,1,95,0)=""
^DIC(9.4,3,22,21,"PAH",1,1,96,0)=" $$OPTDE^XPDUTL(name,action) ;Disable/Enable an Option"
^DIC(9.4,3,22,21,"PAH",1,1,97,0)="  name=Option Name,  action= 1-enable, 0-disable"
^DIC(9.4,3,22,21,"PAH",1,1,98,0)="  returns: 1-success, 0-failure"
^DIC(9.4,3,22,21,"PAH",1,1,99,0)=""
^DIC(9.4,3,22,21,"PAH",2,0)="28^2960606^1"
^DIC(9.4,3,22,21,"PAH",2,1,0)="^^113^113^2960606"
^DIC(9.4,3,22,21,"PAH",2,1,1,0)=" This Kernel patch  contains the following features:"
^DIC(9.4,3,22,21,"PAH",2,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,3,0)="-KIDS will now correctly turn off Alpha/Beta testing for a package."
^DIC(9.4,3,22,21,"PAH",2,1,4,0)="-The routine XQABTMP can be used to turn off Alpha/Beta testing for"
^DIC(9.4,3,22,21,"PAH",2,1,5,0)=" previously released packages that used KIDS.   i.e. Kernel 8.0,"
^DIC(9.4,3,22,21,"PAH",2,1,6,0)=" Radiology 4.5, Toolkit 7.3"
^DIC(9.4,3,22,21,"PAH",2,1,7,0)="-Build File Print now pages correctly when displaying the description."
^DIC(9.4,3,22,21,"PAH",2,1,8,0)="-New function $$PATCH^XPDUTL(patch) checks if patch has been installed."
^DIC(9.4,3,22,21,"PAH",2,1,9,0)="-The TYPE field in the OPTION file now contains B:Broker (Client/Server)."
^DIC(9.4,3,22,21,"PAH",2,1,10,0)="-A new field, PRE-TRANSPORTATION ROUTINE (#900), is in the BUILD file."
^DIC(9.4,3,22,21,"PAH",2,1,11,0)="-Updates to routines and data dictionary to support the new security features"
^DIC(9.4,3,22,21,"PAH",2,1,12,0)=" of the RPC Broker.  This patch is a prerequisite to installing the released"
^DIC(9.4,3,22,21,"PAH",2,1,13,0)=" version 1.0 of the RPC Broker.  RPC Broker version 1.0 is scheduled to be"
^DIC(9.4,3,22,21,"PAH",2,1,14,0)=" released at the end of May, 1996, and will need to be installed to support"
^DIC(9.4,3,22,21,"PAH",2,1,15,0)=" the PCMM with a graphical interface."
^DIC(9.4,3,22,21,"PAH",2,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,17,0)=" Please note: The sign-on project that was distributed with the RPC Broker"
^DIC(9.4,3,22,21,"PAH",2,1,18,0)="              Developer Preview Kit (version 1T11) will not function after"
^DIC(9.4,3,22,21,"PAH",2,1,19,0)="              this patch is installed.  The Preview Kit served the function"
^DIC(9.4,3,22,21,"PAH",2,1,20,0)="              of illustrating possible DHCP directions.  It was not intended"
^DIC(9.4,3,22,21,"PAH",2,1,21,0)="              for use in production environments.  We are providing this"
^DIC(9.4,3,22,21,"PAH",2,1,22,0)="              warning to you as an advisory."
^DIC(9.4,3,22,21,"PAH",2,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,24,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",2,1,25,0)="This patch should be installed during off-peak hours. Users can be on the"
^DIC(9.4,3,22,21,"PAH",2,1,26,0)="system, but no user should be using KIDS during the install of this patch."
^DIC(9.4,3,22,21,"PAH",2,1,27,0)="MSM sites must manually move the routine XPDIJ to their other CPUs. KIDS"
^DIC(9.4,3,22,21,"PAH",2,1,28,0)="cannot automatically move this routine for you.  "
^DIC(9.4,3,22,21,"PAH",2,1,29,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",2,1,30,0)="  "
^DIC(9.4,3,22,21,"PAH",2,1,31,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",2,1,32,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",2,1,33,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",2,1,34,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",2,1,35,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",2,1,36,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",2,1,37,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",2,1,38,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",2,1,39,0)="      options:"
^DIC(9.4,3,22,21,"PAH",2,1,40,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",2,1,41,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",2,1,42,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",2,1,43,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",2,1,44,0)="         Install Package(s)"
^DIC(9.4,3,22,21,"PAH",2,1,45,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",2,1,46,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",2,1,47,0)="  6.  MSM Sites - D ^%RCOPY to move the routine XPDIJ to your other"
^DIC(9.4,3,22,21,"PAH",2,1,48,0)="      CPUs."
^DIC(9.4,3,22,21,"PAH",2,1,49,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",2,1,50,0)=" ====================================================================  "
^DIC(9.4,3,22,21,"PAH",2,1,51,0)="  "
^DIC(9.4,3,22,21,"PAH",2,1,52,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",2,1,53,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",2,1,54,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",2,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",2,1,56,0)=" Name           Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",2,1,57,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",2,1,58,0)=" XPDDP          12181499        21,28"
^DIC(9.4,3,22,21,"PAH",2,1,59,0)=" XPDIA          12064759        10,15,21,28"
^DIC(9.4,3,22,21,"PAH",2,1,60,0)=" XPDIJ          18206759        2,21,28"
^DIC(9.4,3,22,21,"PAH",2,1,61,0)=" XPDIP          8727472         15,21,28"
^DIC(9.4,3,22,21,"PAH",2,1,62,0)=" XPDIPM         1817853         21,28"
^DIC(9.4,3,22,21,"PAH",2,1,63,0)=" XPDIQ          6693337         21,28"
^DIC(9.4,3,22,21,"PAH",2,1,64,0)=" XPDT           17164426        2,10,28"
^DIC(9.4,3,22,21,"PAH",2,1,65,0)=" XPDUTL         2564737         21,28"
^DIC(9.4,3,22,21,"PAH",2,1,66,0)=" XQABLOAD       13951526        28"
^DIC(9.4,3,22,21,"PAH",2,1,67,0)=" XQABTMP        2221215         new"
^DIC(9.4,3,22,21,"PAH",2,1,68,0)=" XQCS           9069982         15,28"
^DIC(9.4,3,22,21,"PAH",2,1,69,0)=" XQSET          11570399        28"
^DIC(9.4,3,22,21,"PAH",2,1,70,0)=" XUSRB          2627976         11,16,28"
^DIC(9.4,3,22,21,"PAH",2,1,71,0)=" XUSRB1         9903269         new"
^DIC(9.4,3,22,21,"PAH",2,1,72,0)=" ============================================================================"
^DIC(9.4,3,22,21,"PAH",2,1,73,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,74,0)=" DATA DICTIONARY:  Partial DDs"
^DIC(9.4,3,22,21,"PAH",2,1,75,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,76,0)="  File: BUILD #9.6, Field: PRE-TRANSPORTATION ROUTINE #900."
^DIC(9.4,3,22,21,"PAH",2,1,77,0)="    This field contains a [TAG^]ROUTINE that will be run during the"
^DIC(9.4,3,22,21,"PAH",2,1,78,0)="    transportation process for the Build.  This will allow a developer"
^DIC(9.4,3,22,21,"PAH",2,1,79,0)="    to populate the transport global using the variable XPDGREF."
^DIC(9.4,3,22,21,"PAH",2,1,80,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,81,0)="  File: OPTION #19, Field: TYPE #4."
^DIC(9.4,3,22,21,"PAH",2,1,82,0)="    This set of codes field has been updated to include the code"
^DIC(9.4,3,22,21,"PAH",2,1,83,0)="    B = Broker (Client/Server).    "
^DIC(9.4,3,22,21,"PAH",2,1,84,0)=" ==========================================================================="
^DIC(9.4,3,22,21,"PAH",2,1,85,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,86,0)=" FORMS:"
^DIC(9.4,3,22,21,"PAH",2,1,87,0)="  XPD EDIT BUILD      (File 9.6)"
^DIC(9.4,3,22,21,"PAH",2,1,88,0)="  Was change to add the field, PRE-TRANSPORTATION ROUTINE, to page 1."
^DIC(9.4,3,22,21,"PAH",2,1,89,0)=" ============================================================================"
^DIC(9.4,3,22,21,"PAH",2,1,90,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,91,0)=" DOCUMENTATION:"
^DIC(9.4,3,22,21,"PAH",2,1,92,0)="  Developers can now put information in the KIDS Transport Global, which"
^DIC(9.4,3,22,21,"PAH",2,1,93,0)=" can be used by the Pre- or Post-install routines. KIDS will run the"
^DIC(9.4,3,22,21,"PAH",2,1,94,0)=" [TAG^]ROUTINE in the field  PRE-TRANSPORTATION ROUTINE during the transport"
^DIC(9.4,3,22,21,"PAH",2,1,95,0)=" process. This routine can use the variable XPDGREF to set nodes in the"
^DIC(9.4,3,22,21,"PAH",2,1,96,0)=" transport global."
^DIC(9.4,3,22,21,"PAH",2,1,97,0)=" i.e.  S @XPDGREF@(""My Namespace"",1)=""Information I need during install"""
^DIC(9.4,3,22,21,"PAH",2,1,98,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,99,0)="  During the install process, in the Pre- or Post-install routines, the"
^DIC(9.4,3,22,21,"PAH",2,1,100,0)=" developer can retrieve the data by using the same variable, XPDGREF. Since"
^DIC(9.4,3,22,21,"PAH",2,1,101,0)=" these nodes are part of the transport global, they will be removed when the"
^DIC(9.4,3,22,21,"PAH",2,1,102,0)=" install is completed."
^DIC(9.4,3,22,21,"PAH",2,1,103,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,104,0)="  KIDS didn't turn off Alpha/Beta testing when the final version of a package"
^DIC(9.4,3,22,21,"PAH",2,1,105,0)=" was released. Because of this bug, Kernel 8.0 and Radiology 4.5 still have"
^DIC(9.4,3,22,21,"PAH",2,1,106,0)=" Alpha/Beta testing turned on.  You can run the routine XQABTMP to turn off"
^DIC(9.4,3,22,21,"PAH",2,1,107,0)=" testing for those packages."
^DIC(9.4,3,22,21,"PAH",2,1,108,0)=""
^DIC(9.4,3,22,21,"PAH",2,1,109,0)="  A new function is available to developers, $$PATCH^XPDUTL(patch) will return"
^DIC(9.4,3,22,21,"PAH",2,1,110,0)=" 1 if patch was loaded on current system and 0 if it wasn't loaded. This"
^DIC(9.4,3,22,21,"PAH",2,1,111,0)=" function can be used in your Environment Check routine."
^DIC(9.4,3,22,21,"PAH",2,1,112,0)=" i.e.  I '$$PATCH^XPDUTL(""XU*8.0*28"") W !,""You must install patch XU*8.0*28"""
^DIC(9.4,3,22,21,"PAH",2,1,113,0)=""
^DIC(9.4,3,22,21,"PAH",3,0)="30^2960606^1"
^DIC(9.4,3,22,21,"PAH",3,1,0)="^^45^45^2960606"
^DIC(9.4,3,22,21,"PAH",3,1,1,0)=" This Kernel patch  contains the following features:"
^DIC(9.4,3,22,21,"PAH",3,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",3,1,3,0)="-KIDS will now save Patch names that contain Sequence numbers in the"
^DIC(9.4,3,22,21,"PAH",3,1,4,0)=" Patch Application History field of the Package file."
^DIC(9.4,3,22,21,"PAH",3,1,5,0)="-KIDS will now check for duplicate Version numbers and Patch names when"
^DIC(9.4,3,22,21,"PAH",3,1,6,0)=" updating the Package file."
^DIC(9.4,3,22,21,"PAH",3,1,7,0)="-KIDS will now clean up missing Files in the Build file. This is done when"
^DIC(9.4,3,22,21,"PAH",3,1,8,0)=" using the 'Verify a Build' option."
^DIC(9.4,3,22,21,"PAH",3,1,9,0)="-Fixes problem in NOIS ELP-0596-70080, couldn't restart install if install"
^DIC(9.4,3,22,21,"PAH",3,1,10,0)=" was queued and it got an error during install."
^DIC(9.4,3,22,21,"PAH",3,1,11,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",3,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",3,1,13,0)="This patch should be installed during off-peak hours. Users can be on the"
^DIC(9.4,3,22,21,"PAH",3,1,14,0)="system, but no user should be using KIDS during the install of this patch."
^DIC(9.4,3,22,21,"PAH",3,1,15,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",3,1,16,0)="  "
^DIC(9.4,3,22,21,"PAH",3,1,17,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",3,1,18,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",3,1,19,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",3,1,20,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",3,1,21,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",3,1,22,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",3,1,23,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",3,1,24,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",3,1,25,0)="      options:"
^DIC(9.4,3,22,21,"PAH",3,1,26,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",3,1,27,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",3,1,28,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",3,1,29,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",3,1,30,0)="         Install Package(s)"
^DIC(9.4,3,22,21,"PAH",3,1,31,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",3,1,32,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",3,1,33,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",3,1,34,0)=" ====================================================================  "
^DIC(9.4,3,22,21,"PAH",3,1,35,0)="  "
^DIC(9.4,3,22,21,"PAH",3,1,36,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",3,1,37,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",3,1,38,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",3,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",3,1,40,0)=" Name           Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",3,1,41,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",3,1,42,0)=" XPDIP          9952535         15,21,28,30"
^DIC(9.4,3,22,21,"PAH",3,1,43,0)=" XPDIR          2689416         30"
^DIC(9.4,3,22,21,"PAH",3,1,44,0)=" XPDV           9093649         30"
^DIC(9.4,3,22,21,"PAH",3,1,45,0)=" ============================================================================"
^DIC(9.4,3,22,21,"PAH",4,0)="20^2960606^1"
^DIC(9.4,3,22,21,"PAH",4,1,0)="^^89^89^2960606"
^DIC(9.4,3,22,21,"PAH",4,1,1,0)="NOIS  DAY-0196-40185  If the listing of Unsuccessful Tasks was queued to"
^DIC(9.4,3,22,21,"PAH",4,1,2,0)="a printer it would cause a extra blank page on the printer."
^DIC(9.4,3,22,21,"PAH",4,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,4,0)="NOIS  NAS-1295-30824  Entering a ^ to exit from a listing of tasks being"
^DIC(9.4,3,22,21,"PAH",4,1,5,0)="requeued would cause an UNDEF error."
^DIC(9.4,3,22,21,"PAH",4,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,7,0)="MSG# 18395346 From Dave Alexander.  If in the Delete tasks option a ""^"" "
^DIC(9.4,3,22,21,"PAH",4,1,8,0)="wouldn't stop the listing."
^DIC(9.4,3,22,21,"PAH",4,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,10,0)="MSG# 19794130 From Dave Alexander.  This message asked for EN^XUTMDEVQ "
^DIC(9.4,3,22,21,"PAH",4,1,11,0)="to not new POP so that the calling routine can check the status. "
^DIC(9.4,3,22,21,"PAH",4,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,13,0)="A long standing requests to display more info on running tasks that have"
^DIC(9.4,3,22,21,"PAH",4,1,14,0)="deleted there entry in the %ZTSK global."
^DIC(9.4,3,22,21,"PAH",4,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,16,0)="NOIS CLE-1195-40343  In the ""Grant Access by Profile"" option. Secondary"
^DIC(9.4,3,22,21,"PAH",4,1,17,0)="Menu items that were in common with current secondary menu items would"
^DIC(9.4,3,22,21,"PAH",4,1,18,0)="get duplicated.  This has been fixed be adding a ""B"" X-ref to the"
^DIC(9.4,3,22,21,"PAH",4,1,19,0)="Secondary Menu subfile.  A post init will re-index this new X-ref on"
^DIC(9.4,3,22,21,"PAH",4,1,20,0)="current entries.  The adding of this B X-ref made it necessary to make"
^DIC(9.4,3,22,21,"PAH",4,1,21,0)="changes to other XQ routines that loop through the secondary menu list."
^DIC(9.4,3,22,21,"PAH",4,1,22,0)="  "
^DIC(9.4,3,22,21,"PAH",4,1,23,0)="NOIS BUT-1295-20458  BOS-0496-10026"
^DIC(9.4,3,22,21,"PAH",4,1,24,0)="In the ""Grant Access by Profile"" option. The "
^DIC(9.4,3,22,21,"PAH",4,1,25,0)="deletion of Keys, Files and Secondary options didn't work. If this"
^DIC(9.4,3,22,21,"PAH",4,1,26,0)="option was run twice in a row it would not use the new template user."
^DIC(9.4,3,22,21,"PAH",4,1,27,0)="This would only happen if the job wasn't queued. This has been fixed."
^DIC(9.4,3,22,21,"PAH",4,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,29,0)="NOIS --- The entry point EN^XQH leaves the variable XQH behind. This can"
^DIC(9.4,3,22,21,"PAH",4,1,30,0)="cause problems if the user goes back into XQH.  The change kills XQH at"
^DIC(9.4,3,22,21,"PAH",4,1,31,0)="the exit from the EN^XQH call."
^DIC(9.4,3,22,21,"PAH",4,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,33,0)="MSG# 19316051  It has been pointed out that files 4 and 49 are missing"
^DIC(9.4,3,22,21,"PAH",4,1,34,0)="the data type flag from the second piece of the .01 field.  The .01 field"
^DIC(9.4,3,22,21,"PAH",4,1,35,0)="for both files is included."
^DIC(9.4,3,22,21,"PAH",4,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,37,0)="It was pointed out that the QUEUED TO RUN ON VOLUME SET field in the "
^DIC(9.4,3,22,21,"PAH",4,1,38,0)="OPTION SCHEDULING file would not allow the use of the NODE syntax"
^DIC(9.4,3,22,21,"PAH",4,1,39,0)="that is allowed in the DEVICE file."
^DIC(9.4,3,22,21,"PAH",4,1,40,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,41,0)="DAY-0196-42100,  HUN-1195-21343,  BRX-1095-12548"
^DIC(9.4,3,22,21,"PAH",4,1,42,0)="After a user process all the alerts, it still asks to process alerts even       "
^DIC(9.4,3,22,21,"PAH",4,1,43,0)="though there no more alerts. it is nuisance. Why it happening? in XQALERT1      "
^DIC(9.4,3,22,21,"PAH",4,1,44,0)="DOIT+8 it  checks for the values XQX1 and XQAROU. After all alerts are          "
^DIC(9.4,3,22,21,"PAH",4,1,45,0)="processed, XQX1 is cleaned up properly but not XQAROU.  "
^DIC(9.4,3,22,21,"PAH",4,1,46,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,48,0)="routine         new checksum"
^DIC(9.4,3,22,21,"PAH",4,1,49,0)="XQ12             17600046"
^DIC(9.4,3,22,21,"PAH",4,1,50,0)="XQALERT1         19524336"
^DIC(9.4,3,22,21,"PAH",4,1,51,0)="XQH               8473100"
^DIC(9.4,3,22,21,"PAH",4,1,52,0)="XQLOCK           12699105"
^DIC(9.4,3,22,21,"PAH",4,1,53,0)="XQT              13634679"
^DIC(9.4,3,22,21,"PAH",4,1,54,0)="XQTOC             9046523"
^DIC(9.4,3,22,21,"PAH",4,1,55,0)="XUSERBLK         10269237"
^DIC(9.4,3,22,21,"PAH",4,1,56,0)="XUTMG19           3660168"
^DIC(9.4,3,22,21,"PAH",4,1,57,0)="XUTMD1            2754306"
^DIC(9.4,3,22,21,"PAH",4,1,58,0)="XUTMDEVQ           268897"
^DIC(9.4,3,22,21,"PAH",4,1,59,0)="XUTMQ             8141476"
^DIC(9.4,3,22,21,"PAH",4,1,60,0)="XUTMRP           15458022"
^DIC(9.4,3,22,21,"PAH",4,1,61,0)="XUTMTP           10672535"
^DIC(9.4,3,22,21,"PAH",4,1,62,0)="XUTMTP1           5115647"
^DIC(9.4,3,22,21,"PAH",4,1,63,0)="XUTMTPD           6357425"
^DIC(9.4,3,22,21,"PAH",4,1,64,0)="XUTMTPU           5891396"
^DIC(9.4,3,22,21,"PAH",4,1,65,0)="XUTMUTL           2233454"
^DIC(9.4,3,22,21,"PAH",4,1,66,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,67,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",4,1,68,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",4,1,69,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,70,0)=" 1. These routines may be mapped on systems that allow mapping, "
^DIC(9.4,3,22,21,"PAH",4,1,71,0)="    if so you will need to disable mapping for the effected routines.  "
^DIC(9.4,3,22,21,"PAH",4,1,72,0)=" 2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",4,1,73,0)="    option will load the KIDS package in this message onto your system."
^DIC(9.4,3,22,21,"PAH",4,1,74,0)=" 3. Answer NO to the question:"
^DIC(9.4,3,22,21,"PAH",4,1,75,0)="    'Shall I preserve what is on disk in a separate back-up message ?'"
^DIC(9.4,3,22,21,"PAH",4,1,76,0)=" 4. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,3,22,21,"PAH",4,1,77,0)="    'Verify Checksums in Transport Global' and verify that all routines"
^DIC(9.4,3,22,21,"PAH",4,1,78,0)="    have the correct checksum."
^DIC(9.4,3,22,21,"PAH",4,1,79,0)=" 5. Users can be on the system."
^DIC(9.4,3,22,21,"PAH",4,1,80,0)=" 6. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,3,22,21,"PAH",4,1,81,0)="    'Install Package(s)' Select the package 'XU*8.0*20' and proceed with"
^DIC(9.4,3,22,21,"PAH",4,1,82,0)="    install."
^DIC(9.4,3,22,21,"PAH",4,1,83,0)="    Their is a POST-INIT that will run to build a B X-ref for the"
^DIC(9.4,3,22,21,"PAH",4,1,84,0)="    Secondary menu in the New Person file."
^DIC(9.4,3,22,21,"PAH",4,1,85,0)=" 7. If you are a MSM site move the routines to the other servers.  "
^DIC(9.4,3,22,21,"PAH",4,1,86,0)="    On a mapped system, rebuild your map set.  "
^DIC(9.4,3,22,21,"PAH",4,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,88,0)=" "
^DIC(9.4,3,22,21,"PAH",4,1,89,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",5,0)="32^2960715^1"
^DIC(9.4,3,22,21,"PAH",5,1,0)="^^44^44^2960715"
^DIC(9.4,3,22,21,"PAH",5,1,1,0)="These routines have been patched in support of the RPC Broker 1T19."
^DIC(9.4,3,22,21,"PAH",5,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",5,1,3,0)="routine     new checksum"
^DIC(9.4,3,22,21,"PAH",5,1,4,0)="XUS3           5732668"
^DIC(9.4,3,22,21,"PAH",5,1,5,0)="XUSRB          2741649"
^DIC(9.4,3,22,21,"PAH",5,1,6,0)="ZTER          18166218"
^DIC(9.4,3,22,21,"PAH",5,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",5,1,8,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",5,1,9,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",5,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",5,1,11,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",5,1,12,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",5,1,13,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",5,1,14,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",5,1,15,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",5,1,16,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",5,1,17,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",5,1,18,0)="      options:"
^DIC(9.4,3,22,21,"PAH",5,1,19,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",5,1,20,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",5,1,21,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",5,1,22,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",5,1,23,0)="  4.  Inhibit users from login into system. "
^DIC(9.4,3,22,21,"PAH",5,1,24,0)="  5. Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",5,1,25,0)="    user are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",5,1,26,0)="    acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",5,1,27,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",5,1,28,0)="      options:"
^DIC(9.4,3,22,21,"PAH",5,1,29,0)="         Install Package(s)  'XU*8.0*23'"
^DIC(9.4,3,22,21,"PAH",5,1,30,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",5,1,31,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",5,1,32,0)="  8. After installing this patch, you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",5,1,33,0)="     your productions account to the manager account:"
^DIC(9.4,3,22,21,"PAH",5,1,34,0)="     ZTER"
^DIC(9.4,3,22,21,"PAH",5,1,35,0)="     and in the manager account rename"
^DIC(9.4,3,22,21,"PAH",5,1,36,0)="     ZTER       to %ZTER"
^DIC(9.4,3,22,21,"PAH",5,1,37,0)="     "
^DIC(9.4,3,22,21,"PAH",5,1,38,0)="       Example: ZL ZOSVVXD ZS %ZOSV"
^DIC(9.4,3,22,21,"PAH",5,1,39,0)="       "
^DIC(9.4,3,22,21,"PAH",5,1,40,0)="  9.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",5,1,41,0)=" 10.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",5,1,42,0)="     "
^DIC(9.4,3,22,21,"PAH",5,1,43,0)=" "
^DIC(9.4,3,22,21,"PAH",5,1,44,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",6,0)="18^2960606^1"
^DIC(9.4,3,22,21,"PAH",6,1,0)="^^101^101^2960606"
^DIC(9.4,3,22,21,"PAH",6,1,1,0)="This patch fixes several NOIS and FORUM mail message problems."
^DIC(9.4,3,22,21,"PAH",6,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,3,0)="NOIS HOT-0196-40372 When displaying the $JOB number in XUS91, if the number was"
^DIC(9.4,3,22,21,"PAH",6,1,4,0)="greater than 127 it was converted to a HEX value needed by DSM sites.  This "
^DIC(9.4,3,22,21,"PAH",6,1,5,0)="caused problems with the newer versions of MSM that can have $JOB values greater"
^DIC(9.4,3,22,21,"PAH",6,1,6,0)="than 127.  This has been changed to check for values greater than 32768."
^DIC(9.4,3,22,21,"PAH",6,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,8,0)="NOIS DAY-1295-41565 In %ZIS3 the use of %ZISQUIT in a hunt group would cause"
^DIC(9.4,3,22,21,"PAH",6,1,9,0)="the complete hunt group to fail, not the one entry.  This has been fixed"
^DIC(9.4,3,22,21,"PAH",6,1,10,0)="by killing %ZISQUIT after each try."
^DIC(9.4,3,22,21,"PAH",6,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,12,0)="NOIS SAT-0196-71702  The number of characters on the task number that were"
^DIC(9.4,3,22,21,"PAH",6,1,13,0)="included in the VMS name was to small for the current task numbers at some"
^DIC(9.4,3,22,21,"PAH",6,1,14,0)="sites.  This has been fixed in %ZTMS3 to allow more characters in the name."
^DIC(9.4,3,22,21,"PAH",6,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,16,0)="NOIS BRX-0196-10212  The executable help for the related frame subfield"
^DIC(9.4,3,22,21,"PAH",6,1,17,0)="of the Help frame file has bad code in it that prevents its use.  The"
^DIC(9.4,3,22,21,"PAH",6,1,18,0)="code has been commented out. (sent as a partial DD for file 9.2)"
^DIC(9.4,3,22,21,"PAH",6,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,20,0)="'IO/%ZTIO MM' TaskMan errors, This was used to confirm and understand an"
^DIC(9.4,3,22,21,"PAH",6,1,21,0)=" issue. The problem is understood and there isn't an need for the entry in"
^DIC(9.4,3,22,21,"PAH",6,1,22,0)=" the error log.  It has been removed from ZTMS2."
^DIC(9.4,3,22,21,"PAH",6,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,24,0)="Forum # 17283911  On this message it was agreed that IO should be restored"
^DIC(9.4,3,22,21,"PAH",6,1,25,0)="if POP was returned with a non-zero value.  It currently is returned as 'NULL'"
^DIC(9.4,3,22,21,"PAH",6,1,26,0)="in this case.  This has been fixed."
^DIC(9.4,3,22,21,"PAH",6,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",6,1,28,0)="Forum # 18837345  The help display of printers was impacted by a screen"
^DIC(9.4,3,22,21,"PAH",6,1,29,0)="%ZIS(""S"") that changed the naked.  This did not follow SAC guidelines, "
^DIC(9.4,3,22,21,"PAH",6,1,30,0)="and has been fixed in ZIS5."
^DIC(9.4,3,22,21,"PAH",6,1,31,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,32,0)="The OPEN/USE/CLOSE ^%ZISUTL calls didn't work.  This has been fixed in"
^DIC(9.4,3,22,21,"PAH",6,1,33,0)="ZISUTL and ZIS1.  The setting of IO(0) was changed to only happen one time"
^DIC(9.4,3,22,21,"PAH",6,1,34,0)="so that IO(0) should always point to the HOME device, fixed in ZIS."
^DIC(9.4,3,22,21,"PAH",6,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,36,0)="Hans found that the taskman resource logging was not being done. The fix"
^DIC(9.4,3,22,21,"PAH",6,1,37,0)="was found in XUTMG43.  To make the sorting of taskman work consistent"
^DIC(9.4,3,22,21,"PAH",6,1,38,0)="the resource log string was changed in %ZTMS and %ZTMS3"
^DIC(9.4,3,22,21,"PAH",6,1,39,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,40,0)="I was found that the order of event during error traping needed improvment."
^DIC(9.4,3,22,21,"PAH",6,1,41,0)="also requested was a hang to allow IO ports to reset during errors. This"
^DIC(9.4,3,22,21,"PAH",6,1,42,0)="has been done in %ZTMS."
^DIC(9.4,3,22,21,"PAH",6,1,43,0)=" "
^DIC(9.4,3,22,21,"PAH",6,1,44,0)="routine         new checksum"
^DIC(9.4,3,22,21,"PAH",6,1,45,0)="XUS91           8464418"
^DIC(9.4,3,22,21,"PAH",6,1,46,0)="XUTMG43          487942"
^DIC(9.4,3,22,21,"PAH",6,1,47,0)="ZIS             9225804"
^DIC(9.4,3,22,21,"PAH",6,1,48,0)="ZIS1            9986473"
^DIC(9.4,3,22,21,"PAH",6,1,49,0)="ZIS3            6454404"
^DIC(9.4,3,22,21,"PAH",6,1,50,0)="ZIS5            7443452"
^DIC(9.4,3,22,21,"PAH",6,1,51,0)="ZISUTL          2297285"
^DIC(9.4,3,22,21,"PAH",6,1,52,0)="ZTER           18033524"
^DIC(9.4,3,22,21,"PAH",6,1,53,0)="ZTER1           5362718"
^DIC(9.4,3,22,21,"PAH",6,1,54,0)="ZTMS            5438606"
^DIC(9.4,3,22,21,"PAH",6,1,55,0)="ZTMS2           5327585"
^DIC(9.4,3,22,21,"PAH",6,1,56,0)="ZTMS3           8978754"
^DIC(9.4,3,22,21,"PAH",6,1,57,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,58,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",6,1,59,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",6,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",6,1,61,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",6,1,62,0)="    option will load the KIDS package in this message onto your system."
^DIC(9.4,3,22,21,"PAH",6,1,63,0)=" 2. Answer NO to the question:"
^DIC(9.4,3,22,21,"PAH",6,1,64,0)="    'Shall I preserve what is on disk in a separate back-up message ?'"
^DIC(9.4,3,22,21,"PAH",6,1,65,0)=" 3. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,3,22,21,"PAH",6,1,66,0)="    'Verify Checksums in Transport Global' and verify that all routines"
^DIC(9.4,3,22,21,"PAH",6,1,67,0)="    have the correct checksum."
^DIC(9.4,3,22,21,"PAH",6,1,68,0)=" 4. Inhibit users from login into system. "
^DIC(9.4,3,22,21,"PAH",6,1,69,0)=" 5. From the 'Installation Menu' of the KIDS menu, run the option 'Install"
^DIC(9.4,3,22,21,"PAH",6,1,70,0)="    Package(s)' Select the package 'XU*8.0*18' and proceed with install."
^DIC(9.4,3,22,21,"PAH",6,1,71,0)=" 6. After installing this patch, you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",6,1,72,0)="    your productions account to the manager account:"
^DIC(9.4,3,22,21,"PAH",6,1,73,0)="    ZIS"
^DIC(9.4,3,22,21,"PAH",6,1,74,0)="    ZIS1"
^DIC(9.4,3,22,21,"PAH",6,1,75,0)="    ZIS3"
^DIC(9.4,3,22,21,"PAH",6,1,76,0)="    ZIS5"
^DIC(9.4,3,22,21,"PAH",6,1,77,0)="    ZISUTL"
^DIC(9.4,3,22,21,"PAH",6,1,78,0)="    ZTER"
^DIC(9.4,3,22,21,"PAH",6,1,79,0)="    ZTER1"
^DIC(9.4,3,22,21,"PAH",6,1,80,0)="    ZTMS"
^DIC(9.4,3,22,21,"PAH",6,1,81,0)="    ZTMS2"
^DIC(9.4,3,22,21,"PAH",6,1,82,0)="    ZTMS3"
^DIC(9.4,3,22,21,"PAH",6,1,83,0)="    and in the manager account rename"
^DIC(9.4,3,22,21,"PAH",6,1,84,0)="    ZIS    to %ZIS"
^DIC(9.4,3,22,21,"PAH",6,1,85,0)="    ZIS1   to %ZIS1"
^DIC(9.4,3,22,21,"PAH",6,1,86,0)="    ZIS3   to %ZIS3"
^DIC(9.4,3,22,21,"PAH",6,1,87,0)="    ZIS5   to %ZIS5"
^DIC(9.4,3,22,21,"PAH",6,1,88,0)="    ZISUTL to %ZISUTL"
^DIC(9.4,3,22,21,"PAH",6,1,89,0)="    ZTER   to %ZTER"
^DIC(9.4,3,22,21,"PAH",6,1,90,0)="    ZTER1  to %ZTER1"
^DIC(9.4,3,22,21,"PAH",6,1,91,0)="    ZTMS   to %ZTMS"
^DIC(9.4,3,22,21,"PAH",6,1,92,0)="    ZTMS2  to %ZTMS2"
^DIC(9.4,3,22,21,"PAH",6,1,93,0)="    ZTMS3  to %ZTMS3"
^DIC(9.4,3,22,21,"PAH",6,1,94,0)=""
^DIC(9.4,3,22,21,"PAH",6,1,95,0)="       Example: ZL ZOSVVXD ZS %ZOSV"
^DIC(9.4,3,22,21,"PAH",6,1,96,0)="       "
^DIC(9.4,3,22,21,"PAH",6,1,97,0)=" 7.  On MSM move the routines to the other servers.  "
^DIC(9.4,3,22,21,"PAH",6,1,98,0)="     On DSM, rebuild your map set.  "
^DIC(9.4,3,22,21,"PAH",6,1,99,0)=" 9. Enable user's login."
^DIC(9.4,3,22,21,"PAH",6,1,100,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",6,1,101,0)=""
^DIC(9.4,3,22,21,"PAH",7,0)="25^2960606^1"
^DIC(9.4,3,22,21,"PAH",7,1,0)="^^32^32^2960606"
^DIC(9.4,3,22,21,"PAH",7,1,1,0)="NOIS BEC-0296-21503  Taskman getting error after install of patch XU*8*13."
^DIC(9.4,3,22,21,"PAH",7,1,2,0)="This is only a issue for MSM sites, and then only for ones with"
^DIC(9.4,3,22,21,"PAH",7,1,3,0)="LOG SYSTEM RT turned on.  "
^DIC(9.4,3,22,21,"PAH",7,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",7,1,5,0)="routine         new checksum"
^DIC(9.4,3,22,21,"PAH",7,1,6,0)="ZOSVMSM          11540039"
^DIC(9.4,3,22,21,"PAH",7,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",7,1,8,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",7,1,9,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",7,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",7,1,11,0)=" 1. These routines is for MSM sites only. "
^DIC(9.4,3,22,21,"PAH",7,1,12,0)=" 2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",7,1,13,0)="    option will load the KIDS package in this message onto your system."
^DIC(9.4,3,22,21,"PAH",7,1,14,0)=" 3. Answer NO to the question:"
^DIC(9.4,3,22,21,"PAH",7,1,15,0)="    'Shall I preserve what is on disk in a separate back-up message ?'"
^DIC(9.4,3,22,21,"PAH",7,1,16,0)=" 4. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,3,22,21,"PAH",7,1,17,0)="    'Verify Checksums in Transport Global' and verify that all routines"
^DIC(9.4,3,22,21,"PAH",7,1,18,0)="    have the correct checksum."
^DIC(9.4,3,22,21,"PAH",7,1,19,0)=" 5. Inhibit users from login into system. "
^DIC(9.4,3,22,21,"PAH",7,1,20,0)=" 6. From the 'Installation Menu' of the KIDS menu, run the option 'Install"
^DIC(9.4,3,22,21,"PAH",7,1,21,0)="    Package(s)' Select the package 'XU*8.0*25' and proceed with install."
^DIC(9.4,3,22,21,"PAH",7,1,22,0)=" 7. After installing this patch, you need to move the routine from "
^DIC(9.4,3,22,21,"PAH",7,1,23,0)="    your productions account to the manager account:"
^DIC(9.4,3,22,21,"PAH",7,1,24,0)="    ZOSVMSM"
^DIC(9.4,3,22,21,"PAH",7,1,25,0)="    and in the manager account rename"
^DIC(9.4,3,22,21,"PAH",7,1,26,0)="    ZOSVMSM to %ZOSV"
^DIC(9.4,3,22,21,"PAH",7,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",7,1,28,0)="       Example: ZL ZOSVMSM ZS %ZOSV"
^DIC(9.4,3,22,21,"PAH",7,1,29,0)="       "
^DIC(9.4,3,22,21,"PAH",7,1,30,0)=" 8.  On MSM move the routines to the other servers.    "
^DIC(9.4,3,22,21,"PAH",7,1,31,0)=" 9. Enable user's login."
^DIC(9.4,3,22,21,"PAH",7,1,32,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",8,0)="19^2960606^1"
^DIC(9.4,3,22,21,"PAH",8,1,0)="^^2^2^2960606"
^DIC(9.4,3,22,21,"PAH",8,1,1,0)="This build fixes an <UNDEF> error that sometimes occurred when"
^DIC(9.4,3,22,21,"PAH",8,1,2,0)="transferring a users' keys."
^DIC(9.4,3,22,21,"PAH",9,0)="23^2960625^1"
^DIC(9.4,3,22,21,"PAH",9,1,0)="^^78^78^2960625"
^DIC(9.4,3,22,21,"PAH",9,1,1,0)="NOIS IVM-1295-30057    If printing a spool document to a slave device the"
^DIC(9.4,3,22,21,"PAH",9,1,2,0)="the question about the number of copies would go to the slave device."
^DIC(9.4,3,22,21,"PAH",9,1,3,0)="To fix the number of copies prompt was moved before the device prompt."
^DIC(9.4,3,22,21,"PAH",9,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",9,1,5,0)="NOIS  ANN-0296-40311  The ZISPL* routines were still looking at the old"
^DIC(9.4,3,22,21,"PAH",9,1,6,0)="Kernel site parameter file.  Fixed by having them and %ZIS4 look at the"
^DIC(9.4,3,22,21,"PAH",9,1,7,0)="new Kernel system parameter file."
^DIC(9.4,3,22,21,"PAH",9,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,9,0)="NOIS ALT-1195-20982  When taskman would internally set new run times for"
^DIC(9.4,3,22,21,"PAH",9,1,10,0)="tasks it was still using the old $H format.  (Cross CPU and waiting HFS)"
^DIC(9.4,3,22,21,"PAH",9,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,12,0)="When investigating another problem I notice that the load balance algorithm"
^DIC(9.4,3,22,21,"PAH",9,1,13,0)="would allow more that one system to start new work.  This was fixed by having"
^DIC(9.4,3,22,21,"PAH",9,1,14,0)="the node that was going to start new work to tell the other nodes to wait."
^DIC(9.4,3,22,21,"PAH",9,1,15,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,16,0)="Eric Jurasas, Change to %ZIS to work with TelNet virtual terminal on MSM 4.3"
^DIC(9.4,3,22,21,"PAH",9,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,18,0)="routine         new checksum"
^DIC(9.4,3,22,21,"PAH",9,1,19,0)="ZIS              9308978"
^DIC(9.4,3,22,21,"PAH",9,1,20,0)="ZIS4DTM          7025909"
^DIC(9.4,3,22,21,"PAH",9,1,21,0)="ZIS4MSM          6576195"
^DIC(9.4,3,22,21,"PAH",9,1,22,0)="ZIS4MSQ          8966654"
^DIC(9.4,3,22,21,"PAH",9,1,23,0)="ZIS4VXD          8256988"
^DIC(9.4,3,22,21,"PAH",9,1,24,0)="ZISPL           12813725"
^DIC(9.4,3,22,21,"PAH",9,1,25,0)="ZISPL1           8860672"
^DIC(9.4,3,22,21,"PAH",9,1,26,0)="ZISPL2           4292041"
^DIC(9.4,3,22,21,"PAH",9,1,27,0)="ZTM2             3666292"
^DIC(9.4,3,22,21,"PAH",9,1,28,0)="ZTM6             1889159"
^DIC(9.4,3,22,21,"PAH",9,1,29,0)="ZTMS2            5278281"
^DIC(9.4,3,22,21,"PAH",9,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,31,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",9,1,32,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",9,1,33,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,34,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",9,1,35,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",9,1,36,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",9,1,37,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",9,1,38,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",9,1,39,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",9,1,40,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",9,1,41,0)="      options:"
^DIC(9.4,3,22,21,"PAH",9,1,42,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",9,1,43,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",9,1,44,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",9,1,45,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",9,1,46,0)="  4.  Inhibit users from login into system. "
^DIC(9.4,3,22,21,"PAH",9,1,47,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",9,1,48,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",9,1,49,0)="      options:"
^DIC(9.4,3,22,21,"PAH",9,1,50,0)="         Install Package(s)  'XU*8.0*23'"
^DIC(9.4,3,22,21,"PAH",9,1,51,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",9,1,52,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",9,1,53,0)="  7. After installing this patch, you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",9,1,54,0)="     your productions account to the manager account:"
^DIC(9.4,3,22,21,"PAH",9,1,55,0)="     ZIS"
^DIC(9.4,3,22,21,"PAH",9,1,56,0)="     ZIS4DTM"
^DIC(9.4,3,22,21,"PAH",9,1,57,0)="     ZIS4MSM"
^DIC(9.4,3,22,21,"PAH",9,1,58,0)="     ZIS4MSQ"
^DIC(9.4,3,22,21,"PAH",9,1,59,0)="     ZIS4VXD"
^DIC(9.4,3,22,21,"PAH",9,1,60,0)="     ZTM2"
^DIC(9.4,3,22,21,"PAH",9,1,61,0)="     ZTM6"
^DIC(9.4,3,22,21,"PAH",9,1,62,0)="     ZTMS2"
^DIC(9.4,3,22,21,"PAH",9,1,63,0)="     and in the manager account rename"
^DIC(9.4,3,22,21,"PAH",9,1,64,0)="     ZIS        to %ZIS"
^DIC(9.4,3,22,21,"PAH",9,1,65,0)="     ZTM2       to %ZTM2"
^DIC(9.4,3,22,21,"PAH",9,1,66,0)="     ZTM6       to %ZTM6"
^DIC(9.4,3,22,21,"PAH",9,1,67,0)="     ZTMS2      to %ZTMS2"
^DIC(9.4,3,22,21,"PAH",9,1,68,0)="     ZIS4VXD    to %ZIS4   (for DSM sites)"
^DIC(9.4,3,22,21,"PAH",9,1,69,0)="     ZIS4MSM    to %ZIS4   (for MSM sites)"
^DIC(9.4,3,22,21,"PAH",9,1,70,0)="    "
^DIC(9.4,3,22,21,"PAH",9,1,71,0)="       Example: ZL ZOSVVXD ZS %ZOSV"
^DIC(9.4,3,22,21,"PAH",9,1,72,0)="       "
^DIC(9.4,3,22,21,"PAH",9,1,73,0)="  8.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",9,1,74,0)="  9.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",9,1,75,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",9,1,76,0)=""
^DIC(9.4,3,22,21,"PAH",9,1,77,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",9,1,78,0)=""
^DIC(9.4,3,22,21,"PAH",10,0)=2
^DIC(9.4,3,22,21,"PAH",11,0)=15
^DIC(9.4,3,22,21,"PAH",12,0)=16
^DIC(9.4,3,22,21,"PAH",13,0)="39^2960722^1"
^DIC(9.4,3,22,21,"PAH",13,1,0)="^^46^46^2960722"
^DIC(9.4,3,22,21,"PAH",13,1,1,0)=" This patch contains the following features:"
^DIC(9.4,3,22,21,"PAH",13,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",13,1,3,0)="-Fixes problem when installing new Protocols, they would remain disabled."
^DIC(9.4,3,22,21,"PAH",13,1,4,0)=" Nois CLA-0696-20835."
^DIC(9.4,3,22,21,"PAH",13,1,5,0)="-The function $$PATCH^XPDUTL(patch) will handle patches with sequence"
^DIC(9.4,3,22,21,"PAH",13,1,6,0)=" numbers, which were added in patch 30."
^DIC(9.4,3,22,21,"PAH",13,1,7,0)="-Setting XPDABORT=2 wasn't aborting install."
^DIC(9.4,3,22,21,"PAH",13,1,8,0)="-Out of Order message on an option now contains the package name."
^DIC(9.4,3,22,21,"PAH",13,1,9,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",13,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",13,1,11,0)="This patch should be installed during off-peak hours. Users can be on the"
^DIC(9.4,3,22,21,"PAH",13,1,12,0)="system, but no user should be using KIDS during the install of this patch."
^DIC(9.4,3,22,21,"PAH",13,1,13,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",13,1,14,0)="  "
^DIC(9.4,3,22,21,"PAH",13,1,15,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",13,1,16,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",13,1,17,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",13,1,18,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",13,1,19,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",13,1,20,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",13,1,21,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",13,1,22,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",13,1,23,0)="      options:"
^DIC(9.4,3,22,21,"PAH",13,1,24,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",13,1,25,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",13,1,26,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",13,1,27,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",13,1,28,0)="         Install Package(s)"
^DIC(9.4,3,22,21,"PAH",13,1,29,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",13,1,30,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",13,1,31,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",13,1,32,0)=" ==========================================================================="
^DIC(9.4,3,22,21,"PAH",13,1,33,0)="  "
^DIC(9.4,3,22,21,"PAH",13,1,34,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",13,1,35,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",13,1,36,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",13,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",13,1,38,0)=" Name           Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",13,1,39,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",13,1,40,0)=" XPDET          4659158         15,39"
^DIC(9.4,3,22,21,"PAH",13,1,41,0)=" XPDI           16016321        10,21,39"
^DIC(9.4,3,22,21,"PAH",13,1,42,0)=" XPDIL1         6256689         15,17,39"
^DIC(9.4,3,22,21,"PAH",13,1,43,0)=" XPDTC          12678971        10,15,21,39"
^DIC(9.4,3,22,21,"PAH",13,1,44,0)=" XPDUTL         2641528         21,28,39"
^DIC(9.4,3,22,21,"PAH",13,1,45,0)=" XQOO1          14071629        10,21,39"
^DIC(9.4,3,22,21,"PAH",13,1,46,0)=" ============================================================================"
^DIC(9.4,3,22,21,"PAH",14,0)="26^2960812^1"
^DIC(9.4,3,22,21,"PAH",14,1,0)="^^55^55^2960812"
^DIC(9.4,3,22,21,"PAH",14,1,1,0)="MSG # 19318228  Controlled Subs needed to have a second person witness"
^DIC(9.4,3,22,21,"PAH",14,1,2,0)="when 'wasting a narcotic dose'.  This patch adds a new supported reference"
^DIC(9.4,3,22,21,"PAH",14,1,3,0)="to provide a way to ask for a Access/Verify Code pair with out changing"
^DIC(9.4,3,22,21,"PAH",14,1,4,0)="DUZ or other gyrations."
^DIC(9.4,3,22,21,"PAH",14,1,5,0)=""
^DIC(9.4,3,22,21,"PAH",14,1,6,0)="routine         new checksum"
^DIC(9.4,3,22,21,"PAH",14,1,7,0)="XUS              7592994"
^DIC(9.4,3,22,21,"PAH",14,1,8,0)="XUVERIFY         3907067"
^DIC(9.4,3,22,21,"PAH",14,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",14,1,10,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",14,1,11,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",14,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",14,1,13,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",14,1,14,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",14,1,15,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",14,1,16,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",14,1,17,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",14,1,18,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",14,1,19,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",14,1,20,0)="      options:"
^DIC(9.4,3,22,21,"PAH",14,1,21,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",14,1,22,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",14,1,23,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",14,1,24,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",14,1,25,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",14,1,26,0)="      user are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",14,1,27,0)="      acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",14,1,28,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",14,1,29,0)="      options:"
^DIC(9.4,3,22,21,"PAH",14,1,30,0)="         Install Package(s)  'XU*8.0*26'"
^DIC(9.4,3,22,21,"PAH",14,1,31,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",14,1,32,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",14,1,33,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",14,1,34,0)="  8.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",14,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",14,1,36,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",14,1,37,0)="SUPPORTED REFERENCE."
^DIC(9.4,3,22,21,"PAH",14,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",14,1,39,0)="$$WITNESS^XUVERIFY(prefix_text,keys)"
^DIC(9.4,3,22,21,"PAH",14,1,40,0)=""
^DIC(9.4,3,22,21,"PAH",14,1,41,0)="  Returns the IEN of a entry in the new person file that has entered a"
^DIC(9.4,3,22,21,"PAH",14,1,42,0)="  valid ACCESS/VERIFY code pair."
^DIC(9.4,3,22,21,"PAH",14,1,43,0)="  "
^DIC(9.4,3,22,21,"PAH",14,1,44,0)="  prefix_text is a string that will be displayed before both the ACCESS"
^DIC(9.4,3,22,21,"PAH",14,1,45,0)="  and VERIFY code prompts."
^DIC(9.4,3,22,21,"PAH",14,1,46,0)="  "
^DIC(9.4,3,22,21,"PAH",14,1,47,0)="  keys is a list of '^' delimited security KEY names, One of which the"
^DIC(9.4,3,22,21,"PAH",14,1,48,0)="  person entering the A/V code must have so that the IEN is returned."
^DIC(9.4,3,22,21,"PAH",14,1,49,0)="  "
^DIC(9.4,3,22,21,"PAH",14,1,50,0)="$$CHKAV^XUVERIFY(access_"";""_verify)"
^DIC(9.4,3,22,21,"PAH",14,1,51,0)=""
^DIC(9.4,3,22,21,"PAH",14,1,52,0)="  Returns the IEN of the entry in the new person file that has this"
^DIC(9.4,3,22,21,"PAH",14,1,53,0)="  valid ACCESS/VERIFY code pair."
^DIC(9.4,3,22,21,"PAH",14,1,54,0)=""
^DIC(9.4,3,22,21,"PAH",14,1,55,0)=""
^DIC(9.4,3,22,21,"PAH",15,0)="24^2960820^1"
^DIC(9.4,3,22,21,"PAH",15,1,0)="^^153^153^2960820"
^DIC(9.4,3,22,21,"PAH",15,1,1,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,2,0)="E3R #8206   On VAX DSM to have TelNet links HALT from ZUVXD and not wait"
^DIC(9.4,3,22,21,"PAH",15,1,3,0)="for the next user."
^DIC(9.4,3,22,21,"PAH",15,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,5,0)="NOIS DAY-0596-40526  A syntax error at RES+1^%ZOSV1VXD"
^DIC(9.4,3,22,21,"PAH",15,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,7,0)="NOIS SDC-0596-60064  Problem was that users couldn't use ScreenMan after"
^DIC(9.4,3,22,21,"PAH",15,1,8,0)="doing 'Print a spool document' because the IO parameters didn't get reset."
^DIC(9.4,3,22,21,"PAH",15,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,10,0)="-- The '%Index of Routines' option doesn't call the new version."
^DIC(9.4,3,22,21,"PAH",15,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,12,0)="NOIS DAY-0496-41713  Submanager count always low. Site and John Beaufait"
^DIC(9.4,3,22,21,"PAH",15,1,13,0)="did a great job of researching this problem."
^DIC(9.4,3,22,21,"PAH",15,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,15,0)="NOIS WBP-0596-21109, SDC-0496-60862  After patch XU*8*18 if the site has"
^DIC(9.4,3,22,21,"PAH",15,1,16,0)="error screens setup in taskman, a task getting an error would not get"
^DIC(9.4,3,22,21,"PAH",15,1,17,0)="its status updated.  This was especially true when the error happened"
^DIC(9.4,3,22,21,"PAH",15,1,18,0)="setting up Network Mail tasks, Follow-up Mail would check on the status"
^DIC(9.4,3,22,21,"PAH",15,1,19,0)="of the task and not start new ones believing that one was starting."
^DIC(9.4,3,22,21,"PAH",15,1,20,0)="Thanks to David Dahlstrand for noticing the link."
^DIC(9.4,3,22,21,"PAH",15,1,21,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,22,0)="NOIS PUG-0596-51586  The new OPEN^%ZISH call wouldn't work to write a "
^DIC(9.4,3,22,21,"PAH",15,1,23,0)="newversion of a file.  Problem was only with the VAX DSM version."
^DIC(9.4,3,22,21,"PAH",15,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,25,0)="FILEMAN TEAM Problems with $$FTG^%ZISH on VAX DSM and reading records"
^DIC(9.4,3,22,21,"PAH",15,1,26,0)="greater than 255 char.  ZISHMSM had the same problem."
^DIC(9.4,3,22,21,"PAH",15,1,27,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,28,0)="NOIS DES-0795-41067  TaskMan on MSM system could see the SYSTEM SHUTDOWN"
^DIC(9.4,3,22,21,"PAH",15,1,29,0)="flag and would set the X-ref of the Inhibit Logon's field to prevent users"
^DIC(9.4,3,22,21,"PAH",15,1,30,0)="from login on.  If the shutdown was aborted the X-ref would keep user from"
^DIC(9.4,3,22,21,"PAH",15,1,31,0)="login on but looking at the Volume Set file would show the Logon Inhibit"
^DIC(9.4,3,22,21,"PAH",15,1,32,0)="field still set to NO, this was confusing to sites.  This has been fixed"
^DIC(9.4,3,22,21,"PAH",15,1,33,0)="by adding a new item to the set of codes System Shutdown that is set and"
^DIC(9.4,3,22,21,"PAH",15,1,34,0)="cleared by taskman."
^DIC(9.4,3,22,21,"PAH",15,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,36,0)="NOIS IHS-0696-N0286  Site found a call to a missing TAG in %ZISH, it was "
^DIC(9.4,3,22,21,"PAH",15,1,37,0)="part of some code that is undocumented and the call has been removed."
^DIC(9.4,3,22,21,"PAH",15,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,39,0)="NOIS DAY-0196-42100  Intermittent UNDEF in XQALDEV.  One entry point didn't"
^DIC(9.4,3,22,21,"PAH",15,1,40,0)="have all the variables setup."
^DIC(9.4,3,22,21,"PAH",15,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,42,0)="NOIS HUN-0396-20414  At VAX DSM sites running taskman from DCL the log "
^DIC(9.4,3,22,21,"PAH",15,1,43,0)="files could excced the VMS limit and bring Taskman to a stop.  The fix"
^DIC(9.4,3,22,21,"PAH",15,1,44,0)="is to not record a log file."
^DIC(9.4,3,22,21,"PAH",15,1,45,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,46,0)="FORUM errors.  UNDEF Error at SETVAR^%ZIS1 when slecting a item from the"
^DIC(9.4,3,22,21,"PAH",15,1,47,0)="Local Synonym list."
^DIC(9.4,3,22,21,"PAH",15,1,48,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,49,0)="BRX-0296-10688 Site needed to help identify devices to users.  Site wanted"
^DIC(9.4,3,22,21,"PAH",15,1,50,0)="the display the Mnemonic. This is a multipule and would cause problems."
^DIC(9.4,3,22,21,"PAH",15,1,51,0)="Added code to display the Device Location like the FM loopup does."
^DIC(9.4,3,22,21,"PAH",15,1,52,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,54,0)="routine     new checksum"
^DIC(9.4,3,22,21,"PAH",15,1,55,0)="XQALDEL          13827021"
^DIC(9.4,3,22,21,"PAH",15,1,56,0)="ZIS5              7634324"
^DIC(9.4,3,22,21,"PAH",15,1,57,0)="ZIS6              9961139"
^DIC(9.4,3,22,21,"PAH",15,1,58,0)="ZISC              8469046"
^DIC(9.4,3,22,21,"PAH",15,1,59,0)="ZISHMSM           5232475"
^DIC(9.4,3,22,21,"PAH",15,1,60,0)="ZISHVXD           6949854"
^DIC(9.4,3,22,21,"PAH",15,1,61,0)="ZISUTL            2111550"
^DIC(9.4,3,22,21,"PAH",15,1,62,0)="ZOSV1VXD          2355845"
^DIC(9.4,3,22,21,"PAH",15,1,63,0)="ZTER             18727059"
^DIC(9.4,3,22,21,"PAH",15,1,64,0)="ZTER1             5363987"
^DIC(9.4,3,22,21,"PAH",15,1,65,0)="ZTM               7509587"
^DIC(9.4,3,22,21,"PAH",15,1,66,0)="ZTM5              3649126"
^DIC(9.4,3,22,21,"PAH",15,1,67,0)="ZTMDCL             527042"
^DIC(9.4,3,22,21,"PAH",15,1,68,0)="ZTMS              4863268"
^DIC(9.4,3,22,21,"PAH",15,1,69,0)="ZTMS0             3205484"
^DIC(9.4,3,22,21,"PAH",15,1,70,0)="ZUVXD             4856063"
^DIC(9.4,3,22,21,"PAH",15,1,71,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,72,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",15,1,73,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",15,1,74,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,75,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",15,1,76,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",15,1,77,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",15,1,78,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",15,1,79,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",15,1,80,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",15,1,81,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",15,1,82,0)="      options:"
^DIC(9.4,3,22,21,"PAH",15,1,83,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",15,1,84,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",15,1,85,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",15,1,86,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",15,1,87,0)="  5.  Stop TASKMAN."
^DIC(9.4,3,22,21,"PAH",15,1,88,0)="      Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",15,1,89,0)="      user are on the system and the possibility of some CLOBER errors in "
^DIC(9.4,3,22,21,"PAH",15,1,90,0)="      %ZIS is acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",15,1,91,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",15,1,92,0)="      options:"
^DIC(9.4,3,22,21,"PAH",15,1,93,0)="         Install Package(s)  'XU*8.0*24'"
^DIC(9.4,3,22,21,"PAH",15,1,94,0)="  7.  VAX DSM Sites in the production account rename ZUVXD to ZU."
^DIC(9.4,3,22,21,"PAH",15,1,95,0)="  "
^DIC(9.4,3,22,21,"PAH",15,1,96,0)="      MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",15,1,97,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",15,1,98,0)="      NOTE: You will see the following message: TASKMAN is not running."
^DIC(9.4,3,22,21,"PAH",15,1,99,0)="      You must run the routine XPDCPU in the production UCI for each"
^DIC(9.4,3,22,21,"PAH",15,1,100,0)="      of the VOLUME SETS you have listed, once the installation starts."
^DIC(9.4,3,22,21,"PAH",15,1,101,0)="             "
^DIC(9.4,3,22,21,"PAH",15,1,102,0)="      MSM Sites - Once the install starts, KIDS will pause 5 minutes to"
^DIC(9.4,3,22,21,"PAH",15,1,103,0)="      allow time for you to go to the other CPUs, and make them ready to"
^DIC(9.4,3,22,21,"PAH",15,1,104,0)="      receive the patched routines."
^DIC(9.4,3,22,21,"PAH",15,1,105,0)="      'D ^XUP' to setup the enviroment, then 'D ^XPDCPU' to load them."
^DIC(9.4,3,22,21,"PAH",15,1,106,0)="           "
^DIC(9.4,3,22,21,"PAH",15,1,107,0)="  8.  After installing this patch, you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",15,1,108,0)="      your productions account to the manager account:"
^DIC(9.4,3,22,21,"PAH",15,1,109,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,110,0)="      ZIS5"
^DIC(9.4,3,22,21,"PAH",15,1,111,0)="      ZIS6"
^DIC(9.4,3,22,21,"PAH",15,1,112,0)="      ZISC"
^DIC(9.4,3,22,21,"PAH",15,1,113,0)="      ZISHVXD"
^DIC(9.4,3,22,21,"PAH",15,1,114,0)="      ZISHMSM"
^DIC(9.4,3,22,21,"PAH",15,1,115,0)="      ZISUTL"
^DIC(9.4,3,22,21,"PAH",15,1,116,0)="      ZOSV1VXD"
^DIC(9.4,3,22,21,"PAH",15,1,117,0)="      ZTER"
^DIC(9.4,3,22,21,"PAH",15,1,118,0)="      ZTER1"
^DIC(9.4,3,22,21,"PAH",15,1,119,0)="      ZTM"
^DIC(9.4,3,22,21,"PAH",15,1,120,0)="      ZTM5"
^DIC(9.4,3,22,21,"PAH",15,1,121,0)="      ZTMDCL"
^DIC(9.4,3,22,21,"PAH",15,1,122,0)="      ZTMS "
^DIC(9.4,3,22,21,"PAH",15,1,123,0)="      ZTMS0 "
^DIC(9.4,3,22,21,"PAH",15,1,124,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,125,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,126,0)="      and in the manager account rename"
^DIC(9.4,3,22,21,"PAH",15,1,127,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,128,0)="      Example: ZL ZISUTL ZS %ZISUTL"
^DIC(9.4,3,22,21,"PAH",15,1,129,0)="      "
^DIC(9.4,3,22,21,"PAH",15,1,130,0)="      ZIS5       to %ZIS5"
^DIC(9.4,3,22,21,"PAH",15,1,131,0)="      ZIS6       to %ZIS6"
^DIC(9.4,3,22,21,"PAH",15,1,132,0)="      ZISC       to %ZISC"
^DIC(9.4,3,22,21,"PAH",15,1,133,0)="      ZISHMSM    to %ZISH   (MSM only)"
^DIC(9.4,3,22,21,"PAH",15,1,134,0)="      ZISHVXD    to %ZISH   (VAX DSM only) "
^DIC(9.4,3,22,21,"PAH",15,1,135,0)="      ZISUTL     to %ZISUTL"
^DIC(9.4,3,22,21,"PAH",15,1,136,0)="      ZOSV1VXD   to %ZOSV1  (VAX DSM only)"
^DIC(9.4,3,22,21,"PAH",15,1,137,0)="      ZTER       to %ZTER"
^DIC(9.4,3,22,21,"PAH",15,1,138,0)="      ZTER1      to %ZTER1"
^DIC(9.4,3,22,21,"PAH",15,1,139,0)="      ZTM        to %ZTM"
^DIC(9.4,3,22,21,"PAH",15,1,140,0)="      ZTM5       to %ZTM5"
^DIC(9.4,3,22,21,"PAH",15,1,141,0)="      ZTMDCL     to %ZTMDCL"
^DIC(9.4,3,22,21,"PAH",15,1,142,0)="      ZTMS       to %ZTMS"
^DIC(9.4,3,22,21,"PAH",15,1,143,0)="      ZTMS0      to %ZTMS0"
^DIC(9.4,3,22,21,"PAH",15,1,144,0)="     "
^DIC(9.4,3,22,21,"PAH",15,1,145,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,146,0)="  9.  MSM sites now move both the % and non-% new routines to the MGR"
^DIC(9.4,3,22,21,"PAH",15,1,147,0)="      uci of the other CPU's.       "
^DIC(9.4,3,22,21,"PAH",15,1,148,0)="  9.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",15,1,149,0)=" 10.  Restart Taskman and enable user's login."
^DIC(9.4,3,22,21,"PAH",15,1,150,0)="     "
^DIC(9.4,3,22,21,"PAH",15,1,151,0)=""
^DIC(9.4,3,22,21,"PAH",15,1,152,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",15,1,153,0)=""
^DIC(9.4,3,22,21,"PAH",16,0)="40^2960903^1"
^DIC(9.4,3,22,21,"PAH",16,1,0)="^^47^47^2960903"
^DIC(9.4,3,22,21,"PAH",16,1,1,0)=" This patch changes the way KIDS secures a Packman Message. The prompt:"
^DIC(9.4,3,22,21,"PAH",16,1,2,0)="    'Enter the scramble hint:' "
^DIC(9.4,3,22,21,"PAH",16,1,3,0)=" has been removed.  A new prompt:"
^DIC(9.4,3,22,21,"PAH",16,1,4,0)="    'Do you wish to secure this message? No//'"
^DIC(9.4,3,22,21,"PAH",16,1,5,0)=" will be asked after you enter the text for a message. This correct the"
^DIC(9.4,3,22,21,"PAH",16,1,6,0)=" problem that was identified by Nois CLE-0696-40353."
^DIC(9.4,3,22,21,"PAH",16,1,7,0)=" This patch is the same as MailMan patch XM*7.1*33. Both patches contain"
^DIC(9.4,3,22,21,"PAH",16,1,8,0)=" the same MailMan and Kernel routines."
^DIC(9.4,3,22,21,"PAH",16,1,9,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",16,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",16,1,11,0)="This patch should be installed during off-peak hours. Users can be on the"
^DIC(9.4,3,22,21,"PAH",16,1,12,0)="system, but no user should be using KIDS during the install of this patch."
^DIC(9.4,3,22,21,"PAH",16,1,13,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",16,1,14,0)="  "
^DIC(9.4,3,22,21,"PAH",16,1,15,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",16,1,16,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",16,1,17,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",16,1,18,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",16,1,19,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",16,1,20,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",16,1,21,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",16,1,22,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",16,1,23,0)="      options:"
^DIC(9.4,3,22,21,"PAH",16,1,24,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",16,1,25,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",16,1,26,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",16,1,27,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",16,1,28,0)="         Install Package(s)"
^DIC(9.4,3,22,21,"PAH",16,1,29,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",16,1,30,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",16,1,31,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",16,1,32,0)=" ==========================================================================="
^DIC(9.4,3,22,21,"PAH",16,1,33,0)="  "
^DIC(9.4,3,22,21,"PAH",16,1,34,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",16,1,35,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",16,1,36,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",16,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",16,1,38,0)=" Name           Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",16,1,39,0)=" -----------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",16,1,40,0)=" XPDTP          2358145         21,40"
^DIC(9.4,3,22,21,"PAH",16,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",16,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",16,1,43,0)="       ;;7.1;MailMan;**33**;Jun 02, 1994"
^DIC(9.4,3,22,21,"PAH",16,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",16,1,45,0)=" XMASEC         4454626         33"
^DIC(9.4,3,22,21,"PAH",16,1,46,0)=" XMD            4879878         33"
^DIC(9.4,3,22,21,"PAH",16,1,47,0)=" ============================================================================"
^DIC(9.4,3,22,21,"PAH",17,0)="41^2960903^1"
^DIC(9.4,3,22,21,"PAH",17,1,0)="^^61^61^2960903"
^DIC(9.4,3,22,21,"PAH",17,1,1,0)=" This patch contains the following features:"
^DIC(9.4,3,22,21,"PAH",17,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",17,1,3,0)="-Fixes problems when installing PCE 1.0; "
^DIC(9.4,3,22,21,"PAH",17,1,4,0)="  When Options and Protocols are disabled and the Install is restarted, those"
^DIC(9.4,3,22,21,"PAH",17,1,5,0)="  Protocols remain disabled even when install finishes. Nois MAR-0896-20332"
^DIC(9.4,3,22,21,"PAH",17,1,6,0)="  Protocols are installed without pointer to the Package file."
^DIC(9.4,3,22,21,"PAH",17,1,7,0)="  All routines were not being installed on all CPUs."
^DIC(9.4,3,22,21,"PAH",17,1,8,0)="-Fixes bad expression error in DIK1 when loading patch GMRA*4*2 or DVBA*2.7*11"
^DIC(9.4,3,22,21,"PAH",17,1,9,0)=" Nois POR-0896-50403"
^DIC(9.4,3,22,21,"PAH",17,1,10,0)="-KIDS will now send an Alert if an Install encounters an error."
^DIC(9.4,3,22,21,"PAH",17,1,11,0)="=============================================================================="
^DIC(9.4,3,22,21,"PAH",17,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",17,1,13,0)="This patch should be installed during off-peak hours. Users can be on the"
^DIC(9.4,3,22,21,"PAH",17,1,14,0)="system, but no user should be using KIDS during the install of this patch."
^DIC(9.4,3,22,21,"PAH",17,1,15,0)="Since this patch is an update to KIDS, this patch should not be installed"
^DIC(9.4,3,22,21,"PAH",17,1,16,0)="with any other patch."
^DIC(9.4,3,22,21,"PAH",17,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",17,1,18,0)="**MSM sites must manually move the routines XPDIJ and XPDCPU to their other"
^DIC(9.4,3,22,21,"PAH",17,1,19,0)="  CPUs. KIDS cannot automatically move this routines for you.**"
^DIC(9.4,3,22,21,"PAH",17,1,20,0)="=============================================================================="
^DIC(9.4,3,22,21,"PAH",17,1,21,0)="  "
^DIC(9.4,3,22,21,"PAH",17,1,22,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",17,1,23,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",17,1,24,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",17,1,25,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",17,1,26,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",17,1,27,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",17,1,28,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",17,1,29,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",17,1,30,0)="      options:"
^DIC(9.4,3,22,21,"PAH",17,1,31,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",17,1,32,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",17,1,33,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",17,1,34,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",17,1,35,0)="         Install Package(s)"
^DIC(9.4,3,22,21,"PAH",17,1,36,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",17,1,37,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",17,1,38,0)="  6.  MSM Sites - D ^%RCOPY to move the routine XPDIJ and XPDCPU to your"
^DIC(9.4,3,22,21,"PAH",17,1,39,0)="      other CPUs."
^DIC(9.4,3,22,21,"PAH",17,1,40,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",17,1,41,0)=" ==========================================================================="
^DIC(9.4,3,22,21,"PAH",17,1,42,0)="  "
^DIC(9.4,3,22,21,"PAH",17,1,43,0)=" ROUTINES:"
^DIC(9.4,3,22,21,"PAH",17,1,44,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",17,1,45,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",17,1,46,0)=" "
^DIC(9.4,3,22,21,"PAH",17,1,47,0)=" Name           Checksum        Patch List"
