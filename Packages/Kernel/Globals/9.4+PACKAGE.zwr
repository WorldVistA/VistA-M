^DIC(9.4,13,22,7,"PAH",32,0)="54 SEQ #47^2981016^1"
^DIC(9.4,13,22,7,"PAH",32,1,0)="^^89^89^2981016"
^DIC(9.4,13,22,7,"PAH",32,1,1,0)="This patch corrects a problem when using FileMan Sort/Print functions that"
^DIC(9.4,13,22,7,"PAH",32,1,2,0)="have statistical operations within Sort/Print logic and there were NO"
^DIC(9.4,13,22,7,"PAH",32,1,3,0)="RECORDS TO PRINT.  The problem was the statistical line(s) would print"
^DIC(9.4,13,22,7,"PAH",32,1,4,0)="before the header and the No Records To Print message.  For Example:"
^DIC(9.4,13,22,7,"PAH",32,1,5,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,6,0)="TOTAL                  0.0"
^DIC(9.4,13,22,7,"PAH",32,1,7,0)="                    ------"
^DIC(9.4,13,22,7,"PAH",32,1,8,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,9,0)="MY REPORT                       Aug. 28, 1998           PAGE 1"
^DIC(9.4,13,22,7,"PAH",32,1,10,0)="NAME"
^DIC(9.4,13,22,7,"PAH",32,1,11,0)="--------------------------------------------------------------"
^DIC(9.4,13,22,7,"PAH",32,1,12,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,13,0)="                *** NO RECORDS TO PRINT ***"
^DIC(9.4,13,22,7,"PAH",32,1,14,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,15,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,16,0)="It will now look like:"
^DIC(9.4,13,22,7,"PAH",32,1,17,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,18,0)="MY REPORT                       Aug. 28, 1998           PAGE 1"
^DIC(9.4,13,22,7,"PAH",32,1,19,0)="NAME"
^DIC(9.4,13,22,7,"PAH",32,1,20,0)="--------------------------------------------------------------"
^DIC(9.4,13,22,7,"PAH",32,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,22,0)="                *** NO RECORDS TO PRINT ***"
^DIC(9.4,13,22,7,"PAH",32,1,23,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,24,0)="NOIS: "
^DIC(9.4,13,22,7,"PAH",32,1,25,0)="====="
^DIC(9.4,13,22,7,"PAH",32,1,26,0)="AUG-0695-30662"
^DIC(9.4,13,22,7,"PAH",32,1,27,0)="ISW-0197-21444"
^DIC(9.4,13,22,7,"PAH",32,1,28,0)="ISW-0798-22049"
