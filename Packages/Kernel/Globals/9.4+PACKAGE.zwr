^DIC(9.4,14,22,5.9,"PAH",55,1,477,0)=" Select Installation Option:"
^DIC(9.4,14,22,5.9,"PAH",55,1,478,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,479,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,480,0)=" End of example install"
^DIC(9.4,14,22,5.9,"PAH",55,1,481,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,482,0)=" *****************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",55,1,483,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,484,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,485,0)=" POST-INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",55,1,486,0)=" ------------------------------"
^DIC(9.4,14,22,5.9,"PAH",55,1,487,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,488,0)=" The following actions should be performed by the Lab Information Manager "
^DIC(9.4,14,22,5.9,"PAH",55,1,489,0)=" (LIM) or the person(s) responsible for the maintenance of the files LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",55,1,490,0)=" SITE (#69.9) and ACCESSION (#68)."
^DIC(9.4,14,22,5.9,"PAH",55,1,491,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,492,0)="  1. If a site is using local label routines or the Intermec 4100 label"
^DIC(9.4,14,22,5.9,"PAH",55,1,493,0)="     printers to print lab labels then perform the following steps."
^DIC(9.4,14,22,5.9,"PAH",55,1,494,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,495,0)="     To define local label routines on a printer by printer basis, complete"
^DIC(9.4,14,22,5.9,"PAH",55,1,496,0)="     fields ALTERNATE LABEL ENTRY (#.04) and ALTERNATE LABEL ROUTINE (#.05)."
^DIC(9.4,14,22,5.9,"PAH",55,1,497,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,498,0)="     a. Define printers in the LABEL DEVICE multiple field (#360) in the"
^DIC(9.4,14,22,5.9,"PAH",55,1,499,0)="        LABORATORY SITE file (#69.9)."
^DIC(9.4,14,22,5.9,"PAH",55,1,500,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,501,0)="        *** Start of example ***"
^DIC(9.4,14,22,5.9,"PAH",55,1,502,0)="        Select OPTION: 1  ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,14,22,5.9,"PAH",55,1,503,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,504,0)="        INPUT TO WHAT FILE: LABORATORY SITE//"
^DIC(9.4,14,22,5.9,"PAH",55,1,505,0)="        EDIT WHICH FIELD: ALL// LABEL DEVICE      (multiple)"
^DIC(9.4,14,22,5.9,"PAH",55,1,506,0)="        EDIT WHICH LABEL DEVICE SUB-FIELD: ALL// ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,507,0)="        Answer with LABEL DEVICE SUB-FIELD, or NUMBER"
^DIC(9.4,14,22,5.9,"PAH",55,1,508,0)="        Choose from:"
^DIC(9.4,14,22,5.9,"PAH",55,1,509,0)="           .01             LABEL DEVICE"
^DIC(9.4,14,22,5.9,"PAH",55,1,510,0)="           .02             PRINTER TYPE"
^DIC(9.4,14,22,5.9,"PAH",55,1,511,0)="           .03             LABEL STOCK"
^DIC(9.4,14,22,5.9,"PAH",55,1,512,0)="           .04             ALTERNATE LABEL ENTRY (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,513,0)="           .05             ALTERNATE LABEL ROUTINE (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,514,0)="           .06             DEFAULT ACCESSION AREA"
^DIC(9.4,14,22,5.9,"PAH",55,1,515,0)="        FOLLOW A FIELD NAME WITH ';""CAPTION""' TO HAVE THE FIELD ASKED AS"
^DIC(9.4,14,22,5.9,"PAH",55,1,516,0)="        'CAPTION: ' OR WITH ';T' TO USE THE FIELD 'TITLE' AS CAPTION"
^DIC(9.4,14,22,5.9,"PAH",55,1,517,0)="        EDIT WHICH LABEL DEVICE SUB-FIELD: ALL//"
^DIC(9.4,14,22,5.9,"PAH",55,1,518,0)="        THEN EDIT FIELD:"
^DIC(9.4,14,22,5.9,"PAH",55,1,519,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,520,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,521,0)="        Select LABORATORY SITE SITE NAME: 'name of your site'"
^DIC(9.4,14,22,5.9,"PAH",55,1,522,0)="        Select LABEL DEVICE:    IRM DEVELOP INTERMEC"
^DIC(9.4,14,22,5.9,"PAH",55,1,523,0)="        LABEL DEVICE: IRM DEVELOP INTERMEC//"
^DIC(9.4,14,22,5.9,"PAH",55,1,524,0)="        PRINTER TYPE: INTERMEC 4100// ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,525,0)="           Choose from:"
^DIC(9.4,14,22,5.9,"PAH",55,1,526,0)="             0        OTHER"
^DIC(9.4,14,22,5.9,"PAH",55,1,527,0)="             1        INTERMEC 4100"
^DIC(9.4,14,22,5.9,"PAH",55,1,528,0)="        PRINTER TYPE: INTERMEC 4100//"
^DIC(9.4,14,22,5.9,"PAH",55,1,529,0)="        LABEL STOCK: 2.5X4 10 PART// ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,530,0)="           Choose from:"
^DIC(9.4,14,22,5.9,"PAH",55,1,531,0)="             0        OTHER"
^DIC(9.4,14,22,5.9,"PAH",55,1,532,0)="             1        15/16X3"
^DIC(9.4,14,22,5.9,"PAH",55,1,533,0)="             2        1X2"
^DIC(9.4,14,22,5.9,"PAH",55,1,534,0)="             3        2.5X4 10 PART"
^DIC(9.4,14,22,5.9,"PAH",55,1,535,0)="        LABEL STOCK: 2.5X4 10 PART//"
^DIC(9.4,14,22,5.9,"PAH",55,1,536,0)="        ALTERNATE LABEL ENTRY: ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,537,0)="          Answer must be 1-8 uppercase alpha and/or numeric characters in"
^DIC(9.4,14,22,5.9,"PAH",55,1,538,0)="          length. Site can enter an alternate label entry point to be used"
^DIC(9.4,14,22,5.9,"PAH",55,1,539,0)="          instead of the standard lab label routines used by the lab package"
^DIC(9.4,14,22,5.9,"PAH",55,1,540,0)="          when printing labels using this device. Field ALTERNATE LABEL"
^DIC(9.4,14,22,5.9,"PAH",55,1,541,0)="          ROUTINE (#.05) must be completed for the software to use this field."
^DIC(9.4,14,22,5.9,"PAH",55,1,542,0)="          (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,543,0)="        ALTERNATE LABEL ENTRY:"
^DIC(9.4,14,22,5.9,"PAH",55,1,544,0)=""
^DIC(9.4,14,22,5.9,"PAH",55,1,545,0)="        ALTERNATE LABEL ROUTINE: ??"
^DIC(9.4,14,22,5.9,"PAH",55,1,546,0)="          Answer must be 1-8 uppercase alpha and/or numeric characters in"
^DIC(9.4,14,22,5.9,"PAH",55,1,547,0)="          length. Site can enter an alternate label routine to be used "
^DIC(9.4,14,22,5.9,"PAH",55,1,548,0)="          instead of the standard lab label routines used by the lab package"
^DIC(9.4,14,22,5.9,"PAH",55,1,549,0)="          when printing labels using this device."
^DIC(9.4,14,22,5.9,"PAH",55,1,550,0)="          (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,551,0)="        ALTERNATE LABEL ROUTINE:"
^DIC(9.4,14,22,5.9,"PAH",55,1,552,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,553,0)="        DEFAULT ACCESSION AREA: ??"
^DIC(9.4,14,22,5.9,"PAH",55,1,554,0)="          Select accession area to use for default characteristics."
^DIC(9.4,14,22,5.9,"PAH",55,1,555,0)="          This field is used by the label software when printing test"
^DIC(9.4,14,22,5.9,"PAH",55,1,556,0)="          or future order labels. When printing these types of labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,557,0)="          there is no accession area identified to determine label"
^DIC(9.4,14,22,5.9,"PAH",55,1,558,0)="          characteristics such as type of barcode or accession"
^DIC(9.4,14,22,5.9,"PAH",55,1,559,0)="          area alternate label routine."
^DIC(9.4,14,22,5.9,"PAH",55,1,560,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,561,0)="          The accession area designated for this device will be used"
^DIC(9.4,14,22,5.9,"PAH",55,1,562,0)="          by the software to obtain accession area specific"
^DIC(9.4,14,22,5.9,"PAH",55,1,563,0)="          characteristics when printing labels which are not associated"
^DIC(9.4,14,22,5.9,"PAH",55,1,564,0)="          with any particular accession area. Examples of these"
^DIC(9.4,14,22,5.9,"PAH",55,1,565,0)="          characteristics are barcode type, number of pad digits"
^DIC(9.4,14,22,5.9,"PAH",55,1,566,0)="          for barcode number, and alternate label routine."
^DIC(9.4,14,22,5.9,"PAH",55,1,567,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,568,0)="          *** End of example ***"
^DIC(9.4,14,22,5.9,"PAH",55,1,569,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,570,0)="     b. Program the Intermec 4100 label printer with new formats using"
^DIC(9.4,14,22,5.9,"PAH",55,1,571,0)="        the Lab Bar Code Label Formatter option [LR BAR CF] located on"
^DIC(9.4,14,22,5.9,"PAH",55,1,572,0)="        the Lab liaison menu [LRLIAISON]"
^DIC(9.4,14,22,5.9,"PAH",55,1,573,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,574,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,575,0)="  2. Edit the following fields in the ACCESSION file (#68), to set up the"
^DIC(9.4,14,22,5.9,"PAH",55,1,576,0)="     bar code parameters and/or local label routines for each accession"
^DIC(9.4,14,22,5.9,"PAH",55,1,577,0)="     area."
^DIC(9.4,14,22,5.9,"PAH",55,1,578,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,579,0)="            *** Start of example ***"
^DIC(9.4,14,22,5.9,"PAH",55,1,580,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,581,0)="     Select OPTION: 1  ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,14,22,5.9,"PAH",55,1,582,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,583,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,584,0)="     INPUT TO WHAT FILE: ACCESSION//"
^DIC(9.4,14,22,5.9,"PAH",55,1,585,0)="     EDIT WHICH FIELD: ALL// 5  BAR CODE PRINT"
^DIC(9.4,14,22,5.9,"PAH",55,1,586,0)="     THEN EDIT FIELD: 5.1  BAR CODE PAD"
^DIC(9.4,14,22,5.9,"PAH",55,1,587,0)="     THEN EDIT FIELD: 5.2  ALTERNATE LABEL ENTRY (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,588,0)="     THEN EDIT FIELD: 5.3  ALTERNATE LABEL ROUTINE (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,589,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,590,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,591,0)="     Select ACCESSION AREA: CHEMISTRY"
^DIC(9.4,14,22,5.9,"PAH",55,1,592,0)="     BAR CODE PRINT: CODE39 WITH CHECK DIGIT// ??"
^DIC(9.4,14,22,5.9,"PAH",55,1,593,0)="       This field is used by the label print utilities to determine if"
^DIC(9.4,14,22,5.9,"PAH",55,1,594,0)="       bar code labels should be printed for this accession area."
^DIC(9.4,14,22,5.9,"PAH",55,1,595,0)="       Choose from:"
^DIC(9.4,14,22,5.9,"PAH",55,1,596,0)="         0        NONE"
^DIC(9.4,14,22,5.9,"PAH",55,1,597,0)="         1        YES"
^DIC(9.4,14,22,5.9,"PAH",55,1,598,0)="         2        CODE39"
^DIC(9.4,14,22,5.9,"PAH",55,1,599,0)="         3        CODE39 WITH CHECK DIGIT"
^DIC(9.4,14,22,5.9,"PAH",55,1,600,0)="         4        CODE128"
^DIC(9.4,14,22,5.9,"PAH",55,1,601,0)="     BAR CODE PRINT: CODE39 WITH CHECK DIGIT//"
^DIC(9.4,14,22,5.9,"PAH",55,1,602,0)="     BAR CODE PAD: ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,603,0)="       Type a Number between 1 and 15, 0 Decimal Digits"
^DIC(9.4,14,22,5.9,"PAH",55,1,604,0)="       Enter the number of zeros (""0"") to pad an accession number when"
^DIC(9.4,14,22,5.9,"PAH",55,1,605,0)="       printing a bar code using the accession number. Used when site"
^DIC(9.4,14,22,5.9,"PAH",55,1,606,0)="       needs a minimum length bar code on labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,607,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,608,0)="       Example if need a four digit bar code then enter four."
^DIC(9.4,14,22,5.9,"PAH",55,1,609,0)="               This would produce the following:"
^DIC(9.4,14,22,5.9,"PAH",55,1,610,0)="               Accession number       Bar Code"
^DIC(9.4,14,22,5.9,"PAH",55,1,611,0)="                   1                  0001"
^DIC(9.4,14,22,5.9,"PAH",55,1,612,0)="                  12                  0012"
^DIC(9.4,14,22,5.9,"PAH",55,1,613,0)="                 123                  0123"
^DIC(9.4,14,22,5.9,"PAH",55,1,614,0)="                1234                  1234"
^DIC(9.4,14,22,5.9,"PAH",55,1,615,0)="               12345                 12345"
^DIC(9.4,14,22,5.9,"PAH",55,1,616,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,617,0)="     ALTERNATE LABEL ENTRY: ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,618,0)="       Answer must be 1-8 uppercase alpha and/or numeric characters"
^DIC(9.4,14,22,5.9,"PAH",55,1,619,0)="       in length."
^DIC(9.4,14,22,5.9,"PAH",55,1,620,0)="       Site can enter an alternate label entry point to be used instead of"
^DIC(9.4,14,22,5.9,"PAH",55,1,621,0)="       the standard lab label routine entry point defined in file"
^DIC(9.4,14,22,5.9,"PAH",55,1,622,0)="       LABORATORY SITE (#69.9)."
^DIC(9.4,14,22,5.9,"PAH",55,1,623,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,624,0)="       This field overrides the label routine settings in file LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",55,1,625,0)="       SITE (#69.9) for this accession area. Field ALTERNATE LABEL ROUTINE"
^DIC(9.4,14,22,5.9,"PAH",55,1,626,0)="       (#5.3) must be completed for the software to use this field."
^DIC(9.4,14,22,5.9,"PAH",55,1,627,0)="       See description of field #5.3."
^DIC(9.4,14,22,5.9,"PAH",55,1,628,0)="       (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,629,0)="     ALTERNATE LABEL ENTRY:"
^DIC(9.4,14,22,5.9,"PAH",55,1,630,0)="     ALTERNATE LABEL ROUTINE: ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,631,0)="       Answer must be 1-8 uppercase alpha and/or numeric characters"
^DIC(9.4,14,22,5.9,"PAH",55,1,632,0)="       in length."
^DIC(9.4,14,22,5.9,"PAH",55,1,633,0)="       Site can enter an alternate label routine to be used instead"
^DIC(9.4,14,22,5.9,"PAH",55,1,634,0)="       of the standard lab label routine defined in file LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",55,1,635,0)="       SITE (#69.9)."
^DIC(9.4,14,22,5.9,"PAH",55,1,636,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,637,0)="       This field overrides the label routine settings in file LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",55,1,638,0)="       SITE (#69.9) for this accession area. It is used in conjunction"
^DIC(9.4,14,22,5.9,"PAH",55,1,639,0)="       with field ALTERNATE LABEL ENTRY (#5.2) for building the"
^DIC(9.4,14,22,5.9,"PAH",55,1,640,0)="       variable LRLABEL."
^DIC(9.4,14,22,5.9,"PAH",55,1,641,0)="       (see note on FILE SECURITY)"
^DIC(9.4,14,22,5.9,"PAH",55,1,642,0)="     ALTERNATE LABEL ROUTINE:"
^DIC(9.4,14,22,5.9,"PAH",55,1,643,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,644,0)="    Select ACCESSION AREA:"
^DIC(9.4,14,22,5.9,"PAH",55,1,645,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,646,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,647,0)="  3. Edit new fields LABEL PRINT (#5) and ABBREVIATION (#6) in the URGENCY"
^DIC(9.4,14,22,5.9,"PAH",55,1,648,0)="     file (#62.05) using FileMan's Enter/Edit option."
^DIC(9.4,14,22,5.9,"PAH",55,1,649,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,650,0)="     Select OPTION: 1  ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,14,22,5.9,"PAH",55,1,651,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,652,0)="     INPUT TO WHAT FILE: URGENCY//"
^DIC(9.4,14,22,5.9,"PAH",55,1,653,0)="     EDIT WHICH FIELD: ALL// 5  LABEL PRINT"
^DIC(9.4,14,22,5.9,"PAH",55,1,654,0)="     THEN EDIT FIELD: 6  ABBREVIATION"
^DIC(9.4,14,22,5.9,"PAH",55,1,655,0)="     THEN EDIT FIELD:"
^DIC(9.4,14,22,5.9,"PAH",55,1,656,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,657,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,658,0)="     Select URGENCY: ROUTINE"
^DIC(9.4,14,22,5.9,"PAH",55,1,659,0)="     LABEL PRINT: YES// ?"
^DIC(9.4,14,22,5.9,"PAH",55,1,660,0)="        Select if abbreviation is to be printed."
^DIC(9.4,14,22,5.9,"PAH",55,1,661,0)="          Choose from:"
^DIC(9.4,14,22,5.9,"PAH",55,1,662,0)="                0        NO"
^DIC(9.4,14,22,5.9,"PAH",55,1,663,0)="                1        YES"
^DIC(9.4,14,22,5.9,"PAH",55,1,664,0)="                2        YES, REVERSE FIELD"
^DIC(9.4,14,22,5.9,"PAH",55,1,665,0)="     LABEL PRINT: YES// ??"
^DIC(9.4,14,22,5.9,"PAH",55,1,666,0)="        Determines if urgency's abbreviation is to be printed on labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,667,0)="        If ""YES, REVERSE FIELD"" is selected and label printer supports"
^DIC(9.4,14,22,5.9,"PAH",55,1,668,0)="        reverse field printing, then abbreviation will be printed with"
^DIC(9.4,14,22,5.9,"PAH",55,1,669,0)="        white letters on a black background."
^DIC(9.4,14,22,5.9,"PAH",55,1,670,0)="          Choose from:"
^DIC(9.4,14,22,5.9,"PAH",55,1,671,0)="                0        NO"
^DIC(9.4,14,22,5.9,"PAH",55,1,672,0)="                1        YES"
^DIC(9.4,14,22,5.9,"PAH",55,1,673,0)="                2        YES, REVERSE FIELD"
^DIC(9.4,14,22,5.9,"PAH",55,1,674,0)="     LABEL PRINT: YES//"
^DIC(9.4,14,22,5.9,"PAH",55,1,675,0)="     ABBREVIATION: ROUT"
^DIC(9.4,14,22,5.9,"PAH",55,1,676,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,677,0)="     Select URGENCY:"
^DIC(9.4,14,22,5.9,"PAH",55,1,678,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,679,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,680,0)="          *** End of example ***"
^DIC(9.4,14,22,5.9,"PAH",56,0)="217 SEQ #154^2980923^1"
^DIC(9.4,14,22,5.9,"PAH",56,1,0)="^^225^225^2980923"
^DIC(9.4,14,22,5.9,"PAH",56,1,1,0)=" This patch to the Laboratory package does not contain any changes to"
^DIC(9.4,14,22,5.9,"PAH",56,1,2,0)=" the VISTA BLOOD BANK Software as defined by VHA DIRECTIVE 97-033"
^DIC(9.4,14,22,5.9,"PAH",56,1,3,0)=" titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",56,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,6,0)=" This patch will address a locking problem concerning the LRO global and"
^DIC(9.4,14,22,5.9,"PAH",56,1,7,0)=" a fix to Laboratory Unique Identifier (UID) creation."
^DIC(9.4,14,22,5.9,"PAH",56,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,10,0)="   1. When patch LR*5.2*153 was released it contained changes to the code"
^DIC(9.4,14,22,5.9,"PAH",56,1,11,0)="      in routine LRX used to create the UID. These changes performed a"
^DIC(9.4,14,22,5.9,"PAH",56,1,12,0)="      check to determine if the UID that was to be created already existed."
^DIC(9.4,14,22,5.9,"PAH",56,1,13,0)="      The intent is to prevent the same UID being assigned to two or more"
^DIC(9.4,14,22,5.9,"PAH",56,1,14,0)="      accessions. If the UID already existed then routine LRX created an"
^DIC(9.4,14,22,5.9,"PAH",56,1,15,0)="      alternate UID substituting the accession area's numeric identifier"
^DIC(9.4,14,22,5.9,"PAH",56,1,16,0)="      with ""00""."
^DIC(9.4,14,22,5.9,"PAH",56,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,18,0)="      The code used to produce an alternate UID was setting a lock on"
^DIC(9.4,14,22,5.9,"PAH",56,1,19,0)="      the global LRO(68,""C"",uid) which was not being released."
^DIC(9.4,14,22,5.9,"PAH",56,1,20,0)="      This caused other lab users to ""hang"" until the user with the lock"
^DIC(9.4,14,22,5.9,"PAH",56,1,21,0)="      logged off and the lock was released. This condition has been found"
^DIC(9.4,14,22,5.9,"PAH",56,1,22,0)="      to occur under three scenarios."
^DIC(9.4,14,22,5.9,"PAH",56,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,24,0)="      The first is when a site switches the numeric identifier for an"
^DIC(9.4,14,22,5.9,"PAH",56,1,25,0)="      accession area and the identifier has been previously used."
^DIC(9.4,14,22,5.9,"PAH",56,1,26,0)="      The second is when a site has modified the data dictionary for field"
^DIC(9.4,14,22,5.9,"PAH",56,1,27,0)="      NUMERIC IDENTIFIER (#.4) in the ACCESSION file (#68) to allow more"
^DIC(9.4,14,22,5.9,"PAH",56,1,28,0)="      than one accession area to have the same identifier. The third is"
^DIC(9.4,14,22,5.9,"PAH",56,1,29,0)="      explained in #2 below."
^DIC(9.4,14,22,5.9,"PAH",56,1,30,0)="      "
^DIC(9.4,14,22,5.9,"PAH",56,1,31,0)="      See FileMan's field Description for fields TYPE OF ACCESSION NUMBER"
^DIC(9.4,14,22,5.9,"PAH",56,1,32,0)="      (#.092) and NUMERIC IDENTIFIER (#.4) in the ACCESSION file (#68)"
^DIC(9.4,14,22,5.9,"PAH",56,1,33,0)="      for further information."
^DIC(9.4,14,22,5.9,"PAH",56,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,35,0)="      Solution: modified code in routine LRX to remove setting lock on"
^DIC(9.4,14,22,5.9,"PAH",56,1,36,0)="                global LRO(68,""C"",uid). Since the routine also lock/unlocks"
^DIC(9.4,14,22,5.9,"PAH",56,1,37,0)="                global node LRO(68,""C""), this lock is not neccessary."
^DIC(9.4,14,22,5.9,"PAH",56,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,39,0)="      NOIS CTX-0798-71641, PAL-0898-60857, PUG-0498-51586, LAS-0798-60721"
^DIC(9.4,14,22,5.9,"PAH",56,1,40,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,41,0)="   2. It has been found that under the following conditions the code to"
^DIC(9.4,14,22,5.9,"PAH",56,1,42,0)="      create an accession's UID was being called twice. This resulted in"
^DIC(9.4,14,22,5.9,"PAH",56,1,43,0)="      the UID for the accession being changed to a UID that began with"
^DIC(9.4,14,22,5.9,"PAH",56,1,44,0)="      ""00"" even if the original UID was unique. This would occur when a"
^DIC(9.4,14,22,5.9,"PAH",56,1,45,0)="      site has accession areas in parallel and the parallel accession"
^DIC(9.4,14,22,5.9,"PAH",56,1,46,0)="      area has a lower internal entry number in the ACCESSION file (#68)."
^DIC(9.4,14,22,5.9,"PAH",56,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,48,0)="      Example: Accession area ""B"" is in parallel with accession area ""A""."
^DIC(9.4,14,22,5.9,"PAH",56,1,49,0)="               Accession area ""B"" has a lower internal entry number in file"
^DIC(9.4,14,22,5.9,"PAH",56,1,50,0)="               ACCESSION (#68). When building acccessions from an order"
^DIC(9.4,14,22,5.9,"PAH",56,1,51,0)="               the accessions are created based on the internal entry"
^DIC(9.4,14,22,5.9,"PAH",56,1,52,0)="               number in the ACCESSION file (#68). In this example, the"
^DIC(9.4,14,22,5.9,"PAH",56,1,53,0)="               acccession for accession area ""B"" would be created first."
^DIC(9.4,14,22,5.9,"PAH",56,1,54,0)="               But since it's in parallel with accession area ""A"" the"
^DIC(9.4,14,22,5.9,"PAH",56,1,55,0)="               software first creates an accession for accession area ""A"","
^DIC(9.4,14,22,5.9,"PAH",56,1,56,0)="               then uses acccession area's ""A"" accession number for"
^DIC(9.4,14,22,5.9,"PAH",56,1,57,0)="               accession area's ""B"" accession. Next when the Lab software"
^DIC(9.4,14,22,5.9,"PAH",56,1,58,0)="               attempted to put tests on accession area ""A"" it detected"
^DIC(9.4,14,22,5.9,"PAH",56,1,59,0)="               that the UID existed and generated the alternate UID using"
^DIC(9.4,14,22,5.9,"PAH",56,1,60,0)="               ""00"" as the NUMERIC IDENTIFIER even though it was the"
^DIC(9.4,14,22,5.9,"PAH",56,1,61,0)="               same accession."
^DIC(9.4,14,22,5.9,"PAH",56,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,63,0)="      Solution: modified code in routine LRX to only generate an alternate"
^DIC(9.4,14,22,5.9,"PAH",56,1,64,0)="                UID if the UID exists and is not for the same accession."
^DIC(9.4,14,22,5.9,"PAH",56,1,65,0)="                NOIS PUG-0498-511586"
^DIC(9.4,14,22,5.9,"PAH",56,1,66,0)=""
^DIC(9.4,14,22,5.9,"PAH",56,1,67,0)=" "
^DIC(9.4,14,22,5.9,"PAH",56,1,68,0)="  Associated NOIS"
^DIC(9.4,14,22,5.9,"PAH",56,1,69,0)="  --------------"
^DIC(9.4,14,22,5.9,"PAH",56,1,70,0)=" "
