^DIC(9.4,73,22,9,"PAH",15,1,4,0)="    Deletion of Old messages in postmaster baskets"
^DIC(9.4,73,22,9,"PAH",15,1,5,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,6,0)=" "
