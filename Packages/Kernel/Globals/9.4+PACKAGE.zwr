^DIC(9.4,48,22,5.28,"PAH",663,1,10,0)="          in the SDES2 namespace to address sensitive patient records."
^DIC(9.4,48,22,5.28,"PAH",663,1,11,0)="VSE-6848: BF - SDES2 Priority 35: Rewrite SDES GET APPT REQ LIST BY DFN, "
^DIC(9.4,48,22,5.28,"PAH",663,1,12,0)="          SDES GET CONSULTS BY DFN, SDES GET CONSULTS BY IEN, SDES GET"
^DIC(9.4,48,22,5.28,"PAH",663,1,13,0)="          APPT REQ BY DFN, and SDES GET APPT REQ BY IEN in the SDES2"
^DIC(9.4,48,22,5.28,"PAH",663,1,14,0)="          namespace to address sensitive patient records."
^DIC(9.4,48,22,5.28,"PAH",663,1,15,0)="VSE-6887: JS - VistA: Modify SDEC and SDES code to return an error when "
^DIC(9.4,48,22,5.28,"PAH",663,1,16,0)="          MRTC child request has a duplicate PID."
^DIC(9.4,48,22,5.28,"PAH",663,1,17,0)="VSE-7118: BB - VistA: Modify SDES GET APPT REQ RPCs to return child "
^DIC(9.4,48,22,5.28,"PAH",663,1,18,0)="          sequence field."
^DIC(9.4,48,22,5.28,"PAH",663,1,19,0)="VSE-7306: LB - VistA: Modify SDES2 GET CONTACT ATTEMPTS to quit out when "
^DIC(9.4,48,22,5.28,"PAH",663,1,20,0)="          no contact is found."
^DIC(9.4,48,22,5.28,"PAH",663,1,21,0)="VSE-7451: BF - VistA: Modify SDES2 QUERY APPT REQUESTS and associated "
^DIC(9.4,48,22,5.28,"PAH",663,1,22,0)="          SDES2 RPCs"
^DIC(9.4,48,22,5.28,"PAH",663,1,23,0)="VSE-7465: BB - VistA: Fix issue with SDES2 CREATE APPOINTMENT where "
^DIC(9.4,48,22,5.28,"PAH",663,1,24,0)="          Inpatients are not idenified"
^DIC(9.4,48,22,5.28,"PAH",663,1,25,0)="VSE-7466: BB - VistA: Fix issue with SDES2 CANCEL CLINC AVAIL to prevent "
^DIC(9.4,48,22,5.28,"PAH",663,1,26,0)="          <UNDEFINED> error"
