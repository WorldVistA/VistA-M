^DIC(9.4,100,22,15,"PAH",21,1,105,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,106,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",21,1,107,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",21,1,108,0)="        1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,100,22,15,"PAH",21,1,109,0)="           option will load the KIDS package in this message onto your"
^DIC(9.4,100,22,15,"PAH",21,1,110,0)="           system."
^DIC(9.4,100,22,15,"PAH",21,1,111,0)="        2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",21,1,112,0)="           system. You now need to use KIDS to install the Transport"
^DIC(9.4,100,22,15,"PAH",21,1,113,0)="           global. On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,100,22,15,"PAH",21,1,114,0)="           following options:"
^DIC(9.4,100,22,15,"PAH",21,1,115,0)="  "
^DIC(9.4,100,22,15,"PAH",21,1,116,0)="                Print Transport Global"
^DIC(9.4,100,22,15,"PAH",21,1,117,0)="                Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",21,1,118,0)="                Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",21,1,119,0)="                Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",21,1,120,0)="  "
^DIC(9.4,100,22,15,"PAH",21,1,121,0)="        3. Installation of this patch should be at off peak hours."
^DIC(9.4,100,22,15,"PAH",21,1,122,0)="        4. Users may remain on the system."
^DIC(9.4,100,22,15,"PAH",21,1,123,0)="        5. Installation will take less than five minutes. Installation of"
^DIC(9.4,100,22,15,"PAH",21,1,124,0)="           this patch requires no additional memory space."
^DIC(9.4,100,22,15,"PAH",21,1,125,0)="        6. From the 'Installation Menu' of the KIDS menu, run the option "
^DIC(9.4,100,22,15,"PAH",21,1,126,0)="           'Install Package(s)' Select the package 'YS*5.01*43' and proceed"
^DIC(9.4,100,22,15,"PAH",21,1,127,0)="           with install."
^DIC(9.4,100,22,15,"PAH",21,1,128,0)="        7. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,100,22,15,"PAH",21,1,129,0)="           and Protocols? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",21,1,130,0)="        8. Follow the HL LOGICAL LINK [YS GAF-SND] set up example below."
^DIC(9.4,100,22,15,"PAH",21,1,131,0)="        9. WARNING!!! This part should be done at off peak hours.  "
^DIC(9.4,100,22,15,"PAH",21,1,132,0)="           Execute the call point EN^YSGAFTR.  An example of the running "
^DIC(9.4,100,22,15,"PAH",21,1,133,0)="           the call point is below."
^DIC(9.4,100,22,15,"PAH",21,1,134,0)="       10. Delete YS43POST. "
^DIC(9.4,100,22,15,"PAH",21,1,135,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,136,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,137,0)="Example of the HL Logical Link [YS GAF-SND] set up "
^DIC(9.4,100,22,15,"PAH",21,1,138,0)="--------------------------------------------------"
^DIC(9.4,100,22,15,"PAH",21,1,139,0)="VAH,DEV>D ^XUP"
^DIC(9.4,100,22,15,"PAH",21,1,140,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,141,0)="Setting up programmer environment"
^DIC(9.4,100,22,15,"PAH",21,1,142,0)="Terminal Type set to: C-VT320"
^DIC(9.4,100,22,15,"PAH",21,1,143,0)=" "
^DIC(9.4,100,22,15,"PAH",21,1,144,0)="Select OPTION NAME: EVE"
^DIC(9.4,100,22,15,"PAH",21,1,145,0)="                    ---"
^DIC(9.4,100,22,15,"PAH",21,1,146,0)="     1   EVE          Systems Manager Menu"
^DIC(9.4,100,22,15,"PAH",21,1,147,0)="     2   EVENT CAPTURE DATA ENTRY  ECENTER        Event Capture Data Entry"
^DIC(9.4,100,22,15,"PAH",21,1,148,0)="     3   EVENT CAPTURE EXTRACT  ECXEC        Event Capture Extract"
^DIC(9.4,100,22,15,"PAH",21,1,149,0)="     4   EVENT CAPTURE MANAGEMENT MENU  ECMGR        Event Capture "
^DIC(9.4,100,22,15,"PAH",21,1,150,0)="                                                     Management Menu"
^DIC(9.4,100,22,15,"PAH",21,1,151,0)="     5   EVENT CAPTURE MENU  ECMENU        Event Capture Menu"
