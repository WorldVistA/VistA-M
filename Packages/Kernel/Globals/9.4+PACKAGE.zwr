^DIC(9.4,47,22,5.9,"PAH",221,1,0)="^^4^4^3010122"
^DIC(9.4,47,22,5.9,"PAH",221,1,1,0)="Patch DG*5.3*353 addresses NOIS LOM-0900-60219 where the ""Yes or No"""
