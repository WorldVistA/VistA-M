^DIC(9.4,77,22,17,"PAH",245,1,73,0)="None. "
^DIC(9.4,77,22,17,"PAH",245,1,74,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,75,0)="Options Associated:"
^DIC(9.4,77,22,17,"PAH",245,1,76,0)="-------------------"
^DIC(9.4,77,22,17,"PAH",245,1,77,0)="Clinic Orders Menu                      [PSJ CLINIC ORDERS MENU]"
^DIC(9.4,77,22,17,"PAH",245,1,78,0)="Edit Clinic Med Orders Start Date/Time  [PSJ ECO]"
^DIC(9.4,77,22,17,"PAH",245,1,79,0)="Pharmacy Master Menu                    [PHARMACY MASTER MENU]"
^DIC(9.4,77,22,17,"PAH",245,1,80,0)="Unit Dose Medications                   [PSJU MGR]"
^DIC(9.4,77,22,17,"PAH",245,1,81,0)="IV Menu                                 [PSJI MGR]"
^DIC(9.4,77,22,17,"PAH",245,1,82,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,83,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,84,0)="Protocols Associated:"
