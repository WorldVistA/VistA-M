^DIC(9.4,3,22,21,"PAH",103,1,58,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",103,1,59,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",103,1,60,0)=""
^DIC(9.4,3,22,21,"PAH",103,1,61,0)=""
^DIC(9.4,3,22,21,"PAH",103,1,62,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",103,1,63,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",103,1,64,0)="     "
^DIC(9.4,3,22,21,"PAH",103,1,65,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",103,1,66,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",103,1,67,0)="     "
^DIC(9.4,3,22,21,"PAH",103,1,68,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",103,1,69,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",103,1,70,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",103,1,71,0)="      options:"
^DIC(9.4,3,22,21,"PAH",103,1,72,0)="      "
^DIC(9.4,3,22,21,"PAH",103,1,73,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",103,1,74,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",103,1,75,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",103,1,76,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",103,1,77,0)="     "
^DIC(9.4,3,22,21,"PAH",103,1,78,0)="  4.  Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",103,1,79,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",103,1,80,0)="     "
^DIC(9.4,3,22,21,"PAH",103,1,81,0)="  5.  Use ""D ^XPDKRN"" then "
^DIC(9.4,3,22,21,"PAH",103,1,82,0)="        Install Package(s)  'XU*8.0*108'"
^DIC(9.4,3,22,21,"PAH",103,1,83,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",103,1,84,0)="                             "
^DIC(9.4,3,22,21,"PAH",103,1,85,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",103,1,86,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",103,1,87,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",103,1,88,0)="     "
^DIC(9.4,3,22,21,"PAH",103,1,89,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",103,1,90,0)=""
^DIC(9.4,3,22,21,"PAH",104,0)="123 SEQ #109^2990719^1"
^DIC(9.4,3,22,21,"PAH",105,0)="115 SEQ #110^2990914^1"
^DIC(9.4,3,22,21,"PAH",105,1,0)="^^60^60^2990914"
^DIC(9.4,3,22,21,"PAH",105,1,1,0)="This patch is in support of changes coming to the RPC Broker."
^DIC(9.4,3,22,21,"PAH",105,1,2,0)="Added a ""B"" cross-reference to the Division multiple in the New Person "
^DIC(9.4,3,22,21,"PAH",105,1,3,0)="file. Created/Added new RPC to set the division during logon."
^DIC(9.4,3,22,21,"PAH",105,1,4,0)="A new field in the Kernel System parameters file to hold a broker parameter,"
^DIC(9.4,3,22,21,"PAH",105,1,5,0)="the Broker Activity Timeout field. Updated forms and templates for the new"
^DIC(9.4,3,22,21,"PAH",105,1,6,0)="field."
^DIC(9.4,3,22,21,"PAH",105,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",105,1,8,0)="RIC-0799-20190  Reported an error that is fixed with this patch."
^DIC(9.4,3,22,21,"PAH",105,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",105,1,10,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",105,1,11,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",105,1,12,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",105,1,13,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
