^DIC(9.4,14,22,5.9,"PAH",126,1,210,0)="========================= "
^DIC(9.4,14,22,5.9,"PAH",126,1,211,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",126,1,212,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,213,0)="The patch LR*5.2*274 KIDS build file named LR52_274.KID stored in the "
^DIC(9.4,14,22,5.9,"PAH",126,1,214,0)="ASCII format can be obtained from the following Office of Information "
^DIC(9.4,14,22,5.9,"PAH",126,1,215,0)="Field Offices(OIFOs) ANONYMOUS SOFTWARE directories"
^DIC(9.4,14,22,5.9,"PAH",126,1,216,0)="OIFO         FTP Address                Directory"
^DIC(9.4,14,22,5.9,"PAH",126,1,217,0)="Albany       ftp.fo-albany.domain.ext   anonymous.software "
^DIC(9.4,14,22,5.9,"PAH",126,1,218,0)="Hines        ftp.fo-hines.domain.ext    anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",126,1,219,0)="Salt Lake    ftp.fo-slc.domain.ext      anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",126,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,221,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,222,0)="All users may remain on the system."
^DIC(9.4,14,22,5.9,"PAH",126,1,223,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,224,0)="Note: The patch should be installed during off peak hours."
^DIC(9.4,14,22,5.9,"PAH",126,1,225,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,226,0)="No laboratory background jobs need to be stopped. No options need to be"
^DIC(9.4,14,22,5.9,"PAH",126,1,227,0)="placed out of service."
^DIC(9.4,14,22,5.9,"PAH",126,1,228,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,229,0)="From the Kernel Installation & Distribution System (KIDS) menu "
^DIC(9.4,14,22,5.9,"PAH",126,1,230,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,231,0)="         1. Use the 'Load a Distribution' option to load the "
^DIC(9.4,14,22,5.9,"PAH",126,1,232,0)="            LR52_274.KIDS file onto your system."
^DIC(9.4,14,22,5.9,"PAH",126,1,233,0)="         2. The patch has now been loaded into a Transport global"
^DIC(9.4,14,22,5.9,"PAH",126,1,234,0)="            on your system. You now need to use KIDS to install"
^DIC(9.4,14,22,5.9,"PAH",126,1,235,0)="            the Transport global."
^DIC(9.4,14,22,5.9,"PAH",126,1,236,0)="            On the KIDS menu, under the 'Installation' menu, use "
^DIC(9.4,14,22,5.9,"PAH",126,1,237,0)="            the following options:"
^DIC(9.4,14,22,5.9,"PAH",126,1,238,0)="                Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",126,1,239,0)="                Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",126,1,240,0)="                Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",126,1,241,0)="                Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",126,1,242,0)="         3. Users may remain on the system, but installation "
^DIC(9.4,14,22,5.9,"PAH",126,1,243,0)="            should be done at off peak hours."
^DIC(9.4,14,22,5.9,"PAH",126,1,244,0)="         4. Installation time is less than 5 minutes during off "
^DIC(9.4,14,22,5.9,"PAH",126,1,245,0)="            peak hours and less than 15 minutes during peak hours."
^DIC(9.4,14,22,5.9,"PAH",126,1,246,0)="         5. Installation of this patch requires no additional "
^DIC(9.4,14,22,5.9,"PAH",126,1,247,0)="            memory space."
^DIC(9.4,14,22,5.9,"PAH",126,1,248,0)="         6. From the 'Installation Menu' of the KIDS menu, run the "
^DIC(9.4,14,22,5.9,"PAH",126,1,249,0)="            option"
^DIC(9.4,14,22,5.9,"PAH",126,1,250,0)="            'Install Package(s)' Select the package 'LR*5.2*274' "
^DIC(9.4,14,22,5.9,"PAH",126,1,251,0)="            and proceed with the install."
^DIC(9.4,14,22,5.9,"PAH",126,1,252,0)="         7. When prompted 'Want KIDS to INHIBIT LOGONS during the"
^DIC(9.4,14,22,5.9,"PAH",126,1,253,0)="            install? YES//' respond NO."
^DIC(9.4,14,22,5.9,"PAH",126,1,254,0)="         8. When prompted 'Want to DISABLE scheduled Options, Menu"
^DIC(9.4,14,22,5.9,"PAH",126,1,255,0)="            Options, and Protocols? YES//' respond NO."
^DIC(9.4,14,22,5.9,"PAH",126,1,256,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,257,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,258,0)="======================"
^DIC(9.4,14,22,5.9,"PAH",126,1,259,0)="Example of install:"
^DIC(9.4,14,22,5.9,"PAH",126,1,260,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,261,0)="Select Installation Option: INSTAll Package(s)                 "
^DIC(9.4,14,22,5.9,"PAH",126,1,262,0)="Select INSTALL NAME: LR*5.2*274       Loaded from Distribution  "
^DIC(9.4,14,22,5.9,"PAH",126,1,263,0)="7/11/02@09:42:27"
^DIC(9.4,14,22,5.9,"PAH",126,1,264,0)="     => LR*5.2*274                                                      "
^DIC(9.4,14,22,5.9,"PAH",126,1,265,0)="                                                                  "
^DIC(9.4,14,22,5.9,"PAH",126,1,266,0)="This Distribution was loaded on Jul 11, 2002@09:42:27 with header of      "
