^DIC(9.4,60,22,13,"PAH",602,1,474,0)="                       eRx Received on 1/30/24@11:25 "
^DIC(9.4,60,22,13,"PAH",602,1,475,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,476,0)=" 3. (HDSO-7266) Batch eRx Remove and Un-Remove Functionality "
^DIC(9.4,60,22,13,"PAH",602,1,477,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,478,0)="    The current Remove and Un-Remove actions were modified to now allow users "
^DIC(9.4,60,22,13,"PAH",602,1,479,0)="    to perform a batch Remove and Un-Remove of eRx for a patient.  "
^DIC(9.4,60,22,13,"PAH",602,1,480,0)="    Every time a prescription is Remove or Un-Remove, the software will check "
^DIC(9.4,60,22,13,"PAH",602,1,481,0)="    if other prescriptions exist for that patient that were sent by the same "
^DIC(9.4,60,22,13,"PAH",602,1,482,0)="    prescriber on the same day.  "
^DIC(9.4,60,22,13,"PAH",602,1,483,0)="    If any are found, the software will ask the user if they want to Remove "
^DIC(9.4,60,22,13,"PAH",602,1,484,0)="    (or Un-Remove) those additional eRx records as well, as shown below: "
^DIC(9.4,60,22,13,"PAH",602,1,485,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,486,0)="    3.1 Batch eRx Remove Functionality: "
^DIC(9.4,60,22,13,"PAH",602,1,487,0)="        ------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,488,0)="    Select Action: Next Screen// RM   Remove eRx "
^DIC(9.4,60,22,13,"PAH",602,1,489,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,490,0)="    Select REMOVAL reason code: REM01 Drug out of stock or on backorder and un "
^DIC(9.4,60,22,13,"PAH",602,1,491,0)="    available for processing "
^DIC(9.4,60,22,13,"PAH",602,1,492,0)="    Additional Comments (Optional): TESTING REMOVE "
^DIC(9.4,60,22,13,"PAH",602,1,493,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,494,0)="    Would you like to 'Remove' eRx #12345678901236? Y// ES "
^DIC(9.4,60,22,13,"PAH",602,1,495,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,496,0)="    The following prescriptions are from the same provider and received on the"
^DIC(9.4,60,22,13,"PAH",602,1,497,0)="    same day: "
^DIC(9.4,60,22,13,"PAH",602,1,498,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,499,0)="    PROVIDER: PROVIDER,PROVIDERNAME   eRx RECEIVED DATE: FEB 07, 2024@11:11:54"
^DIC(9.4,60,22,13,"PAH",602,1,500,0)="    ERX ID              DRUG NAME                  PROVIDER                STS"
^DIC(9.4,60,22,13,"PAH",602,1,501,0)="    --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,502,0)="    12345678901235      ASPIRIN 325MG EC TAB       PROVIDER,PROVIDERNAME   HUR"
^DIC(9.4,60,22,13,"PAH",602,1,503,0)="    12345678901237      LISINOPRIL 20MG TAB        PROVIDER,PROVIDERNAME   HUR"
^DIC(9.4,60,22,13,"PAH",602,1,504,0)="    12345678901238      NAPROXEN 500MG TAB         PROVIDER,PROVIDERNAME   HUR"
^DIC(9.4,60,22,13,"PAH",602,1,505,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,506,0)="    Do you want to 'Remove' them - REM01? No// YES "
^DIC(9.4,60,22,13,"PAH",602,1,507,0)="    Updating...done.  "
^DIC(9.4,60,22,13,"PAH",602,1,508,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,509,0)="    3.2 Batch eRx Un-Remove Functionality: "
^DIC(9.4,60,22,13,"PAH",602,1,510,0)="        ---------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,511,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,512,0)="    Select Action: Next Screen// UR   UR "
^DIC(9.4,60,22,13,"PAH",602,1,513,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,514,0)="    Select HOLD reason code: HUR//        UN-REMOVED "
^DIC(9.4,60,22,13,"PAH",602,1,515,0)="    Additional Comments (Optional): TESTING UN-REMOVED "
^DIC(9.4,60,22,13,"PAH",602,1,516,0)="    Would you like to 'Un-Remove' eRx #12345678901235? Y// ES "
^DIC(9.4,60,22,13,"PAH",602,1,517,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,518,0)="    The following prescriptions are from the same provider and received on the"
^DIC(9.4,60,22,13,"PAH",602,1,519,0)="    same day: "
^DIC(9.4,60,22,13,"PAH",602,1,520,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,521,0)="    PROVIDER: PROVIDER,PROVIDERNAME   eRx RECEIVED DATE: FEB 07, 2024@11:09:39"
^DIC(9.4,60,22,13,"PAH",602,1,522,0)="    ERX ID              DRUG NAME                 PROVIDER                STS"
^DIC(9.4,60,22,13,"PAH",602,1,523,0)="    --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,524,0)="    12345678901236      IBUPROFEN 800MG TAB       PROVIDER,PROVIDERNAME  REM03"
^DIC(9.4,60,22,13,"PAH",602,1,525,0)="    12345678901237      LISINOPRIL 20MG TAB       PROVIDER,PROVIDERNAME  REM03"
^DIC(9.4,60,22,13,"PAH",602,1,526,0)="    12345678901238      NAPROXEN 500MG TAB        PROVIDER,PROVIDERNAME  REM03"
^DIC(9.4,60,22,13,"PAH",602,1,527,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,528,0)="    Do you want to 'Un-Remove' them? No// YES "
^DIC(9.4,60,22,13,"PAH",602,1,529,0)="    Updating...done.  "
^DIC(9.4,60,22,13,"PAH",602,1,530,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,531,0)="4. (HDSO-7264) Pending Order Suggested Fill Date auto calculation "
^DIC(9.4,60,22,13,"PAH",602,1,532,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,533,0)="   Currently, the Fill Date field for an eRx Pending Order is always set to "
^DIC(9.4,60,22,13,"PAH",602,1,534,0)="   the current date. In some cases this is not ideal because the patient might"
^DIC(9.4,60,22,13,"PAH",602,1,535,0)="   still have enough medication to last a few more days and a future fill "
^DIC(9.4,60,22,13,"PAH",602,1,536,0)="   date, based on the last fill for the medication might be more appropriate. "
^DIC(9.4,60,22,13,"PAH",602,1,537,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,538,0)="   The algorithm will auto calculate the suggested Fill Date using the "
^DIC(9.4,60,22,13,"PAH",602,1,539,0)="   following logic: "
^DIC(9.4,60,22,13,"PAH",602,1,540,0)="     Requirement: "
^DIC(9.4,60,22,13,"PAH",602,1,541,0)="       - A previous prescription for the exact same drug must be found on the"
^DIC(9.4,60,22,13,"PAH",602,1,542,0)="         patient's profile "
^DIC(9.4,60,22,13,"PAH",602,1,543,0)="       - The SIG from the previous prescription must match exactly with the "
^DIC(9.4,60,22,13,"PAH",602,1,544,0)="         SIG for the new eRx Pending Order (excluding Patient Instructions)"
^DIC(9.4,60,22,13,"PAH",602,1,545,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,546,0)="     Suggested Future Fill Date: "
^DIC(9.4,60,22,13,"PAH",602,1,547,0)="       - If Last Fill is Released and the Release Date + Days Supply results "
^DIC(9.4,60,22,13,"PAH",602,1,548,0)="         in a future date, this futures date suggested as the Fill Date for "
^DIC(9.4,60,22,13,"PAH",602,1,549,0)="         the eRx Pending Order.  "
^DIC(9.4,60,22,13,"PAH",602,1,550,0)="       - If the CMOP Transmission status for the Last Fill is TRANSMITTED or"
^DIC(9.4,60,22,13,"PAH",602,1,551,0)="         RE-TRANSMITTED, the Fill Date for the eRx Pending Order will be"
^DIC(9.4,60,22,13,"PAH",602,1,552,0)="         today's date + Days Supply for the Suspended fill.  "
^DIC(9.4,60,22,13,"PAH",602,1,553,0)="       - If Last Fill is Suspended with a future Fill Date this future date"
^DIC(9.4,60,22,13,"PAH",602,1,554,0)="         will be suggested as the Fill Date for the eRx Pending Order.  "
^DIC(9.4,60,22,13,"PAH",602,1,555,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,556,0)="5. (HDSO-7380) Removal of VistA Drug Selection Restriction "
^DIC(9.4,60,22,13,"PAH",602,1,557,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,558,0)="   Currently, when they user tries to select a VistA Drug to match to the eRx "
^DIC(9.4,60,22,13,"PAH",602,1,559,0)="   they are not able to select drugs that are marked as INVESTIGATIONAL, BULK "
^DIC(9.4,60,22,13,"PAH",602,1,560,0)="   COMPOUND or MANUFACTURED IN PHARMACY (DEA SPECIAL HDLG field contains ""I"", "
^DIC(9.4,60,22,13,"PAH",602,1,561,0)="   ""M"" or ""0""). This patch removes such restriction.  "
^DIC(9.4,60,22,13,"PAH",602,1,562,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,563,0)="6. (HDSO-7449) Provider Auto-Validation for VAMCs"
^DIC(9.4,60,22,13,"PAH",602,1,564,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,565,0)="   The Provider Auto-Validation functionality released with patch PSO*7*700, "
^DIC(9.4,60,22,13,"PAH",602,1,566,0)="   will now work at VA Medical Centers as well. In order for the provider to"
^DIC(9.4,60,22,13,"PAH",602,1,567,0)="   be auto-validated the following conditions must be fulfilled:"
^DIC(9.4,60,22,13,"PAH",602,1,568,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,569,0)="    - eRx Providers was auto-matched to a VistA Provider"
^DIC(9.4,60,22,13,"PAH",602,1,570,0)="    - eRx Provider last name matches VistA Provider last name"
^DIC(9.4,60,22,13,"PAH",602,1,571,0)="    - First letter of eRx Provider first name matches first letter of VistA"
^DIC(9.4,60,22,13,"PAH",602,1,572,0)="      Provider first name"
^DIC(9.4,60,22,13,"PAH",602,1,573,0)="    - Zip code for the eRx Provider matches the zip code for the VistA"
^DIC(9.4,60,22,13,"PAH",602,1,574,0)="      Provider"
^DIC(9.4,60,22,13,"PAH",602,1,575,0)="    - eRx is not electronically signed (CS eRx) "
^DIC(9.4,60,22,13,"PAH",602,1,576,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,577,0)="7. (HDSO-7450) Clinic name in the Validate Provider Screen"
^DIC(9.4,60,22,13,"PAH",602,1,578,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,579,0)="   The field Clinic is being added to the Provider Validation Screen. It will"
^DIC(9.4,60,22,13,"PAH",602,1,580,0)="   display the eRx Provider Business Name when there is one. There will be no"
^DIC(9.4,60,22,13,"PAH",602,1,581,0)="   corresponding information on the VistA side of the side-by-side screen."
^DIC(9.4,60,22,13,"PAH",602,1,582,0)="   This information will also display on the eRx Summary Display screen:"
^DIC(9.4,60,22,13,"PAH",602,1,583,0)="    ______________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",602,1,584,0)="              ERX PROVIDER                |          VISTA PROVIDER    "
^DIC(9.4,60,22,13,"PAH",602,1,585,0)="    Name: TEST,PROVIDER                   |Name: TEST, PROVIDER MD     "
^DIC(9.4,60,22,13,"PAH",602,1,586,0)="    NPI : 9999999999                      |NPI : 9999999999         "
^DIC(9.4,60,22,13,"PAH",602,1,587,0)="    DEA : XX9999999                       |DEA : XX9999999        "
^DIC(9.4,60,22,13,"PAH",602,1,588,0)="    Clinic: BUSINESS NAME                 |                   "
^DIC(9.4,60,22,13,"PAH",602,1,589,0)="    ______________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",602,1,590,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,591,0)="8. (HDSO-7768) Hold for Future Fill Functionality"
^DIC(9.4,60,22,13,"PAH",602,1,592,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,593,0)="   A new hold code named HOLD FOR FUTURE FILL (HFF) is being added. This new"
^DIC(9.4,60,22,13,"PAH",602,1,594,0)="   hold code will work differently than all other hold codes. Once the user"
^DIC(9.4,60,22,13,"PAH",602,1,595,0)="   selects this code, the software will prompt the user to enter a future fill"
^DIC(9.4,60,22,13,"PAH",602,1,596,0)="   date. If there is an effective fill date on file for the eRx, this date"
^DIC(9.4,60,22,13,"PAH",602,1,597,0)="   will be used as the default date, as seen below:"
^DIC(9.4,60,22,13,"PAH",602,1,598,0)="     ..."
^DIC(9.4,60,22,13,"PAH",602,1,599,0)="     Select Action:Next Screen// H   Hold  "
^DIC(9.4,60,22,13,"PAH",602,1,600,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,601,0)="     Select HOLD reason code: HFF       HOLD FOR FUTURE FILL"
^DIC(9.4,60,22,13,"PAH",602,1,602,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,603,0)="     The eRx will be un-held automatically on the date you enter below and"
^DIC(9.4,60,22,13,"PAH",602,1,604,0)="     placed in 'IN PROCESS' status."
^DIC(9.4,60,22,13,"PAH",602,1,605,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,606,0)="     Future Fill Hold Date: MM/DD/YY//"
^DIC(9.4,60,22,13,"PAH",602,1,607,0)="   "
^DIC(9.4,60,22,13,"PAH",602,1,608,0)="   The Status History (SH) and History Log (HL) actions will display the"
^DIC(9.4,60,22,13,"PAH",602,1,609,0)="   the hold date."
^DIC(9.4,60,22,13,"PAH",602,1,610,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,611,0)="     Status History:"
^DIC(9.4,60,22,13,"PAH",602,1,612,0)="      05/02/24@15:01:06  HFF    HOLD FOR FUTURE FILL (MAY 12, 2024)"
^DIC(9.4,60,22,13,"PAH",602,1,613,0)="      Entered By: ROCHA,MARCELO"
^DIC(9.4,60,22,13,"PAH",602,1,614,0)="      Comments: COMMENT..."
^DIC(9.4,60,22,13,"PAH",602,1,615,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,616,0)="     History Log:"
^DIC(9.4,60,22,13,"PAH",602,1,617,0)="       Status History:                                           "
^DIC(9.4,60,22,13,"PAH",602,1,618,0)="       Date/Time         Status                                   Entered By"
^DIC(9.4,60,22,13,"PAH",602,1,619,0)="       ---------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,620,0)="       05/02/24@15:01:06 HFF-HOLD FOR FUTURE FILL (May 12, 2024)  USER,NAME"
^DIC(9.4,60,22,13,"PAH",602,1,621,0)="       Comments: COMMENT..."
^DIC(9.4,60,22,13,"PAH",602,1,622,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,623,0)="   On the date the eRx was held for it will be automatically un-held and"
^DIC(9.4,60,22,13,"PAH",602,1,624,0)="   and placed on the eRx Holding Queue as In-Process or Wait status."
^DIC(9.4,60,22,13,"PAH",602,1,625,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,626,0)="9. (HDSO-7769) Manually Hold and Un-Hold with HC hold code"
^DIC(9.4,60,22,13,"PAH",602,1,627,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,628,0)="   The hold code HOLD FOR CHANGE (HC) was used solely for Change Requests,"
^DIC(9.4,60,22,13,"PAH",602,1,629,0)="   which was assigned automatically after the users sent a Change Request to"
^DIC(9.4,60,22,13,"PAH",602,1,630,0)="   the prescriber. This is being changed to allow the user to manually use"
^DIC(9.4,60,22,13,"PAH",602,1,631,0)="   this code to place eRx's on hold and also to un-hold eRx's held with this"
^DIC(9.4,60,22,13,"PAH",602,1,632,0)="   code."
^DIC(9.4,60,22,13,"PAH",602,1,633,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,634,0)="10.(HDSO-7770) Prescriber Drug Use Evaluation (DUE) Information"
^DIC(9.4,60,22,13,"PAH",602,1,635,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,636,0)="   The prescriber DUE information will be included in the Single eRx View/"
^DIC(9.4,60,22,13,"PAH",602,1,637,0)="   Display Screen for New Rx, Change Response, Renewal Response records as"
^DIC(9.4,60,22,13,"PAH",602,1,638,0)="   well as in the Validate Drug Screen, Pending order (OP) screen and CPRS"
^DIC(9.4,60,22,13,"PAH",602,1,639,0)="   Progress Notes Addendum, as shown below:"
^DIC(9.4,60,22,13,"PAH",602,1,640,0)="   New Rx:"
^DIC(9.4,60,22,13,"PAH",602,1,641,0)="   ------"
^DIC(9.4,60,22,13,"PAH",602,1,642,0)="   ... "
^DIC(9.4,60,22,13,"PAH",602,1,643,0)="    SIG:                                   |SIG:        "
^DIC(9.4,60,22,13,"PAH",602,1,644,0)="     TAKE 1 CAP PO 3X DAILY                | TAKE ONE CAPSULE BY MOUTH THREE"
^DIC(9.4,60,22,13,"PAH",602,1,645,0)="                                           | TIMES A DAY WITH FOOD     "
^DIC(9.4,60,22,13,"PAH",602,1,646,0)="                                           | PATIENT INSTRUCTIONS      "
^DIC(9.4,60,22,13,"PAH",602,1,647,0)="    Prescriber Drug Use Evaluation:        |     Dosage: 300 (MG)      "
^DIC(9.4,60,22,13,"PAH",602,1,648,0)="    Co-Agent: Nsaids (Non-Steroidal Anti-In|       Verb: TAKE          "
^DIC(9.4,60,22,13,"PAH",602,1,649,0)="              flammatory Drug)             |Disp. Units: 1             "
^DIC(9.4,60,22,13,"PAH",602,1,650,0)="    Reason: Drug-Allergy                   |       Noun: CAPSULE       "
^DIC(9.4,60,22,13,"PAH",602,1,651,0)="    Result: Prescribed w/ acknowledgements |      Route: ORAL          "
^DIC(9.4,60,22,13,"PAH",602,1,652,0)="    Acknowledgement: Previously Tolerated  |   Schedule: BID-WITH FOOD "
^DIC(9.4,60,22,13,"PAH",602,1,653,0)="   ..."
^DIC(9.4,60,22,13,"PAH",602,1,654,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,655,0)="   Change Response/Renewal Response/CPRS Progress Notes Addendum:"
^DIC(9.4,60,22,13,"PAH",602,1,656,0)="   -------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,657,0)="   ..."
^DIC(9.4,60,22,13,"PAH",602,1,658,0)="   Prescriber Drug Use Evaluation:    "
^DIC(9.4,60,22,13,"PAH",602,1,659,0)="   Co-Agent: Ibuprofen                "
^DIC(9.4,60,22,13,"PAH",602,1,660,0)="   Reason: Drug-Allergy               "
^DIC(9.4,60,22,13,"PAH",602,1,661,0)="   Result: Prescribed w/ acknowledgements"
^DIC(9.4,60,22,13,"PAH",602,1,662,0)="   Acknowledgement: Previously Tolerated "
