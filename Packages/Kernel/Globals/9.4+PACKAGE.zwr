^DIC(9.4,60,22,13,"PAH",514,0)="641 SEQ #532^3210830.092527^17"
^DIC(9.4,60,22,13,"PAH",514,1,0)="^^18^18^3210830"
^DIC(9.4,60,22,13,"PAH",514,1,1,0)="1. INC17334684 - When doing a speed reprint on a suspended Rx, it is not "
^DIC(9.4,60,22,13,"PAH",514,1,2,0)="giving you a warning message"
^DIC(9.4,60,22,13,"PAH",514,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",514,1,4,0)="   Problem:"
^DIC(9.4,60,22,13,"PAH",514,1,5,0)="   -------"
^DIC(9.4,60,22,13,"PAH",514,1,6,0)="   When doing a reprint from the Medication Profile and doing a reprint "
^DIC(9.4,60,22,13,"PAH",514,1,7,0)="   of a suspended RX, the label doesn't print and no warning message is"
^DIC(9.4,60,22,13,"PAH",514,1,8,0)="   displayed to the user.  Conversely, when doing a reprint on the single"
^DIC(9.4,60,22,13,"PAH",514,1,9,0)="   RX (OP Medications) screen, a warning message is displayed; 'RX MAY NOT"
^DIC(9.4,60,22,13,"PAH",514,1,10,0)="   BE PRINTED using this option, use SUSPENSE FUNCTIONS Options.'"
^DIC(9.4,60,22,13,"PAH",514,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",514,1,12,0)="   Resolution:"
^DIC(9.4,60,22,13,"PAH",514,1,13,0)="   ----------"
^DIC(9.4,60,22,13,"PAH",514,1,14,0)="   Modify routine PSORXRP1 to display the message:"
^DIC(9.4,60,22,13,"PAH",514,1,15,0)="   #2  Rx 2297932 MAY NOT BE PRINTED using this option"
^DIC(9.4,60,22,13,"PAH",514,1,16,0)="   use SUSPENSE FUNCTIONS Options."
^DIC(9.4,60,22,13,"PAH",514,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",514,1,18,0)="   Type <Enter> to continue or '^' to exit:"
^DIC(9.4,60,22,13,"PAH",515,0)="638 SEQ #533^3210909.101425^17"
^DIC(9.4,60,22,13,"PAH",515,1,0)="^^6^6^3210909"
^DIC(9.4,60,22,13,"PAH",515,1,1,0)="This patch will fix the following:"
^DIC(9.4,60,22,13,"PAH",515,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",515,1,3,0)="The Rx reference of an original fill that is displayed on an activity log "
^DIC(9.4,60,22,13,"PAH",515,1,4,0)="record is incorrect when the CMOP site reports a change in the Rx's "
^DIC(9.4,60,22,13,"PAH",515,1,5,0)="National Drug Code (NDC). This occurs when the Rx has a suspended refill "
^DIC(9.4,60,22,13,"PAH",515,1,6,0)="and the original fill's fill date is changed.            "
^DIC(9.4,60,22,13,"PAH",516,0)="561^3210913.110935^17"
^DIC(9.4,60,22,13,"PAH",517,0)="617 SEQ #535^3211119.152651^17"
^DIC(9.4,60,22,13,"PAH",517,1,0)="^^555^555^3211119"
^DIC(9.4,60,22,13,"PAH",517,1,1,0)="The Inbound Electronic Prescribing (eRx) v5.0 enhancements include updates to"
^DIC(9.4,60,22,13,"PAH",517,1,2,0)="the current eRx functionality to allow the VA to receive and dispense "
^DIC(9.4,60,22,13,"PAH",517,1,3,0)="electronic prescriptions for controlled substance medications. Up until now"
^DIC(9.4,60,22,13,"PAH",517,1,4,0)="the eRx Holding Queue restricted the selection of a controlled substance VA"
^DIC(9.4,60,22,13,"PAH",517,1,5,0)="dispense drug for any incoming electronic prescription due to the fact that"
^DIC(9.4,60,22,13,"PAH",517,1,6,0)="the functionality was not 100% compliant with the DEA requirements (21 CFR"
^DIC(9.4,60,22,13,"PAH",517,1,7,0)="Part 1311 Subpart C) for receiving, processing and dispensing controlled"
^DIC(9.4,60,22,13,"PAH",517,1,8,0)="substance electronic prescriptions. This project addresses all the DEA"
^DIC(9.4,60,22,13,"PAH",517,1,9,0)="requirements and enables the eRx Holding Queue to process incoming electronic"
^DIC(9.4,60,22,13,"PAH",517,1,10,0)="prescriptions for controlled substance medications."
^DIC(9.4,60,22,13,"PAH",517,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,12,0)="Below is a list of all the applications involved in this project along with"
^DIC(9.4,60,22,13,"PAH",517,1,13,0)="their patch number:"
^DIC(9.4,60,22,13,"PAH",517,1,14,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,15,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,60,22,13,"PAH",517,1,16,0)="   -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,17,0)="   OUTPATIENT PHARMACY (PSO) V. 7.0                      PSO*7*617"
^DIC(9.4,60,22,13,"PAH",517,1,18,0)="   CONTROLLED SUBSTANCE (PSD) V. 3.0                     PSD*3*89"
^DIC(9.4,60,22,13,"PAH",517,1,19,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,20,0)="Below is a list of new and changed functionality delivered by this patch to"
^DIC(9.4,60,22,13,"PAH",517,1,21,0)="satisfy the DEA requirements for receiving, processing and dispensing"
^DIC(9.4,60,22,13,"PAH",517,1,22,0)="electronic prescriptions for controlled substance medications."
^DIC(9.4,60,22,13,"PAH",517,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,24,0)="1. New HOLD, REJECT and REMOVE codes"
^DIC(9.4,60,22,13,"PAH",517,1,25,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,26,0)="   The following new codes have been added:"
^DIC(9.4,60,22,13,"PAH",517,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,28,0)="   HOLD Codes:"
^DIC(9.4,60,22,13,"PAH",517,1,29,0)="   -----------"
^DIC(9.4,60,22,13,"PAH",517,1,30,0)="   HCR - PRESCRIBER'S CS CREDENTIAL IS NOT APPROPRIATE (New)"
^DIC(9.4,60,22,13,"PAH",517,1,31,0)="   HWR - CS PRESCRIPTION WRITTEN/ISSUE DATE HAS PROBLEMS (New)"
^DIC(9.4,60,22,13,"PAH",517,1,32,0)="   HIS - PROVIDER DEA# ISSUE (New)"
^DIC(9.4,60,22,13,"PAH",517,1,33,0)="   HRX - HOLD FOR RX EDIT (New)"
^DIC(9.4,60,22,13,"PAH",517,1,34,0)="   HDE - DRUG USE EVALUATION (New)"
^DIC(9.4,60,22,13,"PAH",517,1,35,0)="   HTI - THERAPUTIC INTERCHANGE (New)"
^DIC(9.4,60,22,13,"PAH",517,1,36,0)="   HSC - SCRIPT CLARIFICATION (New)"
^DIC(9.4,60,22,13,"PAH",517,1,37,0)="   HGS - GENERIC SUBSTITUTION (New)"
^DIC(9.4,60,22,13,"PAH",517,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,39,0)="   REJECT Codes:"
^DIC(9.4,60,22,13,"PAH",517,1,40,0)="   -------------"
^DIC(9.4,60,22,13,"PAH",517,1,41,0)="   PVD03 - Missing/bad digital signature on inbound CS ERX (New)"
^DIC(9.4,60,22,13,"PAH",517,1,42,0)="   PVD04 - Prescriber's CS credential is not appropriate (New)"
^DIC(9.4,60,22,13,"PAH",517,1,43,0)="   PTT03 - Patient's mailing address is missing/mismatched (New)"
^DIC(9.4,60,22,13,"PAH",517,1,44,0)="   DRU06 - Controlled Substances are disallowed (Renamed)"
^DIC(9.4,60,22,13,"PAH",517,1,45,0)="   DRU06 - CS prescription written/issue date has problems (New name)"
^DIC(9.4,60,22,13,"PAH",517,1,46,0)="   ERR99 - Other"
^DIC(9.4,60,22,13,"PAH",517,1,47,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,48,0)="   REMOVE Codes:"
^DIC(9.4,60,22,13,"PAH",517,1,49,0)="   -------------"
^DIC(9.4,60,22,13,"PAH",517,1,50,0)="   REM09 - ERX Issue not resolved-Provider contacted (New)"
^DIC(9.4,60,22,13,"PAH",517,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,52,0)="2. CMOP Controlled Substance Rx Dispense Report [PSO CMOP CS RX DISPENSE"
^DIC(9.4,60,22,13,"PAH",517,1,53,0)="   REPORT]"
^DIC(9.4,60,22,13,"PAH",517,1,54,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,55,0)="   The report option above was modified to include the ampersand sign (&)"
^DIC(9.4,60,22,13,"PAH",517,1,56,0)="   before the Rx # to indicate the prescription is an eRx prescription (e.g.,"
^DIC(9.4,60,22,13,"PAH",517,1,57,0)="   &29039001A)"
^DIC(9.4,60,22,13,"PAH",517,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,59,0)="3. Released and Unreleased Prescription Report [PSO RELEASE REPORT]"
^DIC(9.4,60,22,13,"PAH",517,1,60,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,61,0)="   The report option above was modified to include the ampersand sign (&)"
^DIC(9.4,60,22,13,"PAH",517,1,62,0)="   before the Rx # to indicate the prescription is an eRx prescription (e.g.,"
^DIC(9.4,60,22,13,"PAH",517,1,63,0)="   &29039001A)"
^DIC(9.4,60,22,13,"PAH",517,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,65,0)="4. Complete Orders from eRx [PSO ERX FINISH]"
^DIC(9.4,60,22,13,"PAH",517,1,66,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,67,0)="   A few changes have bene made to the eRx Holding queue option above to"
^DIC(9.4,60,22,13,"PAH",517,1,68,0)="   comply and facilitate the processing of controlled substance medication"
^DIC(9.4,60,22,13,"PAH",517,1,69,0)="   prescriptions."
^DIC(9.4,60,22,13,"PAH",517,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,71,0)="   a) A new filter was introduced to allow the user to select the type of"
^DIC(9.4,60,22,13,"PAH",517,1,72,0)="      prescriptions to be loaded on the eRx Holding Queue as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,74,0)="          Select one of the following:"
^DIC(9.4,60,22,13,"PAH",517,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,76,0)="              Non-CS    Non-Controlled Substance"
^DIC(9.4,60,22,13,"PAH",517,1,77,0)="              CS        Controlled Substance"
^DIC(9.4,60,22,13,"PAH",517,1,78,0)="              B         Both"
^DIC(9.4,60,22,13,"PAH",517,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,80,0)="          Select eRx Record Type: B// "
^DIC(9.4,60,22,13,"PAH",517,1,81,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,82,0)="   b) If the selection above is either CS or B, a new filter prompt was added"
^DIC(9.4,60,22,13,"PAH",517,1,83,0)="      to allow the user to further filter based on the CS Schedule of the "
^DIC(9.4,60,22,13,"PAH",517,1,84,0)="      controlled substance medication as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,86,0)="          Select one of the following:"
^DIC(9.4,60,22,13,"PAH",517,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,88,0)="              1         Schedule II"
^DIC(9.4,60,22,13,"PAH",517,1,89,0)="              2         Schedules III - V"
^DIC(9.4,60,22,13,"PAH",517,1,90,0)="              3         Schedules II - V"
^DIC(9.4,60,22,13,"PAH",517,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,92,0)="          Select Schedule(s): 3// "
^DIC(9.4,60,22,13,"PAH",517,1,93,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,94,0)="   c) In the Patient Centric View if a patient has a prescription for a "
^DIC(9.4,60,22,13,"PAH",517,1,95,0)="      controlled substance medication the line item will be marked with a "
^DIC(9.4,60,22,13,"PAH",517,1,96,0)="      closing square bracket (]) following the line number as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,97,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,98,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,99,0)="   PSO ERX PATIENT CENTRIC VIEW   Feb 26, 2021@14:19:30        Page:    1 of 2"
^DIC(9.4,60,22,13,"PAH",517,1,100,0)="                       Patient Centric View"
^DIC(9.4,60,22,13,"PAH",517,1,101,0)="              ERX LOOK-BACK DAYS: Default value 365 (Feb 27, 2020)"
^DIC(9.4,60,22,13,"PAH",517,1,102,0)="      ERX PATIENT        DOB         ED  LOCKED BY     NW WT IP HD CCR OTH TOT"
^DIC(9.4,60,22,13,"PAH",517,1,103,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,104,0)="   1]  TESTONE,ONE        08/12/1956   12               0  0  4  0   0   0   4"
^DIC(9.4,60,22,13,"PAH",517,1,105,0)="   2]  TESTTWO,TWO        08/12/1956   12               0  0  7  1   0   0   8"
^DIC(9.4,60,22,13,"PAH",517,1,106,0)="   3.  TESTSIX,SIX        09/30/1938    6               0  0  1  1   0   0   2"
^DIC(9.4,60,22,13,"PAH",517,1,107,0)="   4.  TESTFOUR,FOUR      11/10/1965    3               0  0  4  0   0   0   4"
^DIC(9.4,60,22,13,"PAH",517,1,108,0)="   5]  TESTNINE,NINE      12/18/2014    1               1  0  2  0   0   0   3"
^DIC(9.4,60,22,13,"PAH",517,1,109,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,111,0)="   In the example above lines 1, 2 and 5 have a ']' indicating that those "
^DIC(9.4,60,22,13,"PAH",517,1,112,0)="   patients have at least one controlled substance medication prescription."
^DIC(9.4,60,22,13,"PAH",517,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,114,0)="   d) In the Prescription View the prescriptions for controlled substance "
^DIC(9.4,60,22,13,"PAH",517,1,115,0)="      medication will also be marked with ']' as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,116,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,117,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,118,0)="   PSO ERX HOLDING QUEUE          Feb 26, 2021@14:26:24       Page:    1 of  1"
^DIC(9.4,60,22,13,"PAH",517,1,119,0)="   PSO ERX HOLDING QUEUE"
^DIC(9.4,60,22,13,"PAH",517,1,120,0)="              ERX LOOK-BACK DAYS: Default value 365 (Feb 27, 2020)"
^DIC(9.4,60,22,13,"PAH",517,1,121,0)="     Patient           DOB      Drug                   Provider   STA Rec Date"
^DIC(9.4,60,22,13,"PAH",517,1,122,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,123,0)="   1]  TESTONE,ONE     8/12/56  ALPRAZOLAM 1MG TAB     PROV,TEST  I   02/28/21"
^DIC(9.4,60,22,13,"PAH",517,1,124,0)="   2]  TESTONE,ONE     8/12/56  TESTOSTERONE PATCH     PROV,TEST  I   02/12/21"
^DIC(9.4,60,22,13,"PAH",517,1,125,0)="   3]  TESTONE,ONE     8/12/56  METHYLPHENIDATE 5MG T  PROV,TEST  I   01/31/21"
^DIC(9.4,60,22,13,"PAH",517,1,126,0)="   4.  TESTONE,ONE     8/12/56  ALBUTEROL INHALER      PROV,TEST  I   01/29/21"
^DIC(9.4,60,22,13,"PAH",517,1,127,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,128,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,129,0)="    In the example above lines 1, 2 and 3 have a ']' indicating that the"
^DIC(9.4,60,22,13,"PAH",517,1,130,0)="    prescription is for a controlled substance."
^DIC(9.4,60,22,13,"PAH",517,1,131,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,132,0)="   e) In the Patient Centric View the SORT ENTRIES (SO) action was modified to"
^DIC(9.4,60,22,13,"PAH",517,1,133,0)="      add a new option to sort: ELAPSED DAYS (ED). The action was also changed"
^DIC(9.4,60,22,13,"PAH",517,1,134,0)="      to allow the user to separate the sorted prescriptions into two groups: "
^DIC(9.4,60,22,13,"PAH",517,1,135,0)="      Controlled and Non-Controlled Substances. Independently of which option"
^DIC(9.4,60,22,13,"PAH",517,1,136,0)="      the user picks they will be prompted whether they want to group the list"
^DIC(9.4,60,22,13,"PAH",517,1,137,0)="      by controlled substance or not as shown in the example below:"
^DIC(9.4,60,22,13,"PAH",517,1,138,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,139,0)="        Select Item(s): Next Screen// SO   SORT ENTRIES  "
^DIC(9.4,60,22,13,"PAH",517,1,140,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,141,0)="         1.) PATIENT NAME"
^DIC(9.4,60,22,13,"PAH",517,1,142,0)="         2.) DATE OF BIRTH"
^DIC(9.4,60,22,13,"PAH",517,1,143,0)="         3.) ELAPSED DAYS (ED)"
^DIC(9.4,60,22,13,"PAH",517,1,144,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,145,0)="        Select one of the following sort criteria: "
^DIC(9.4,60,22,13,"PAH",517,1,146,0)="       "
^DIC(9.4,60,22,13,"PAH",517,1,147,0)="        Enter response: 3  ELAPSED DAYS (ED)"
^DIC(9.4,60,22,13,"PAH",517,1,148,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,149,0)="        Do you want to group by controlled substance? "
^DIC(9.4,60,22,13,"PAH",517,1,150,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,151,0)="        Enter Yes or No: YES// "
^DIC(9.4,60,22,13,"PAH",517,1,152,0)="    "
^DIC(9.4,60,22,13,"PAH",517,1,153,0)="      If the user answers YES the patients with at least one prescriptions for"
^DIC(9.4,60,22,13,"PAH",517,1,154,0)="      a controlled substance medication will be moved to the top of the list "
^DIC(9.4,60,22,13,"PAH",517,1,155,0)="      while the others will be moved to the bottom as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,156,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,157,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,158,0)="   1]  TESTONE,ONE        08/12/1956    6               0  0  4  0   0   0   4"
^DIC(9.4,60,22,13,"PAH",517,1,159,0)="   2]  TESTTWO,TWO        08/12/1956    5               0  0  7  1   0   0   8"
^DIC(9.4,60,22,13,"PAH",517,1,160,0)="   3]  TESTNINE,NINE      12/18/2014    2               1  0  2  0   0   0   3"
^DIC(9.4,60,22,13,"PAH",517,1,161,0)="   3.  TESTSIX,SIX        09/30/1938    3               0  0  1  1   0   0   2"
^DIC(9.4,60,22,13,"PAH",517,1,162,0)="   5.  TESTFOUR,FOUR      11/10/1965    0               0  0  4  0   0   0   4"
^DIC(9.4,60,22,13,"PAH",517,1,163,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,164,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,165,0)="   f) When a DO NOT FILL marked record is received in the eRx Holding Queue it"
^DIC(9.4,60,22,13,"PAH",517,1,166,0)="      will be identified in the header with the text below (in reverse video)"
^DIC(9.4,60,22,13,"PAH",517,1,167,0)="      when the user is view viewing such record, as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,168,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,169,0)="   eRx Holding Queue Display     Apr 01, 2021@09:58:15        Page:   1  of  3"
^DIC(9.4,60,22,13,"PAH",517,1,170,0)="   eRx Patient: TEST,PATIENT"
^DIC(9.4,60,22,13,"PAH",517,1,171,0)="   eRx Reference #: 2002894  ERX HAS DO NOT FILL INDICATOR PER PROVIDER"
^DIC(9.4,60,22,13,"PAH",517,1,172,0)="   eRx HT: (cm)()                   eRx WT: (kg)()"
^DIC(9.4,60,22,13,"PAH",517,1,173,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,174,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,175,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,176,0)="   Note: The only two actions that can be performed on a DO NOT FILL record are "
^DIC(9.4,60,22,13,"PAH",517,1,177,0)="         REJECT and REMOVE."
^DIC(9.4,60,22,13,"PAH",517,1,178,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,179,0)="   g) When viewing an eRx record the DEA# will be displayed along with the"
^DIC(9.4,60,22,13,"PAH",517,1,180,0)="      other information about the Provider (eRx and VistA) as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,181,0)="     "
^DIC(9.4,60,22,13,"PAH",517,1,182,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,183,0)="   eRx Provider Primary Telephone: 555-220-0303                             "
^DIC(9.4,60,22,13,"PAH",517,1,184,0)="   eRx Provider: TEST,PROVIDER"
^DIC(9.4,60,22,13,"PAH",517,1,185,0)="                                  DEA#: TP1234568              NPI: 123456789"
^DIC(9.4,60,22,13,"PAH",517,1,186,0)="   Vista Provider: TEST, PROVIDER F."
^DIC(9.4,60,22,13,"PAH",517,1,187,0)="                                  DEA#: TP1234568              NPI: 123456789"
^DIC(9.4,60,22,13,"PAH",517,1,188,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,189,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,190,0)="   h) For controlled substance medication eRx records the DEA Schedule will"
^DIC(9.4,60,22,13,"PAH",517,1,191,0)="      be displayed right after the drug name (eRx and Vista) in the following"
^DIC(9.4,60,22,13,"PAH",517,1,192,0)="      format:"
^DIC(9.4,60,22,13,"PAH",517,1,193,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,194,0)="   eRx Holding Queue Display     Apr 06, 2021@10:22:57       Page:    1  of  3"
^DIC(9.4,60,22,13,"PAH",517,1,195,0)="   eRx Patient: CS-ONLY,ONE"
^DIC(9.4,60,22,13,"PAH",517,1,196,0)="   eRx Reference #: 4928403"
^DIC(9.4,60,22,13,"PAH",517,1,197,0)="   eRx HT: (cm)()                   eRx WT: (kg)()"
^DIC(9.4,60,22,13,"PAH",517,1,198,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,199,0)="   eRx Drug: MEPHOBARBITAL 100MG TABLET [C-IV]                               "
^DIC(9.4,60,22,13,"PAH",517,1,200,0)="   eRx Qty: 30    eRx Refills: 0   eRx Days Supply: 30  eRx Date: APR 06, 2021"
^DIC(9.4,60,22,13,"PAH",517,1,201,0)="   eRx Sig: TAKE ONE TABLET BY MOUTH ONCE DAILY                     "
^DIC(9.4,60,22,13,"PAH",517,1,202,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,203,0)="   Vista Drug: MEPHOBARBITAL 100MG TAB [C-IV]                     "
^DIC(9.4,60,22,13,"PAH",517,1,204,0)="   Vista Qty: 30             Vista Refills: 0           Vista Days Supply: 30"
^DIC(9.4,60,22,13,"PAH",517,1,205,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,206,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,207,0)="   i) The VistA Patient selection/validation for controlled substance"
^DIC(9.4,60,22,13,"PAH",517,1,208,0)="      medication eRx records will perform a check whether the selected VistA"
^DIC(9.4,60,22,13,"PAH",517,1,209,0)="      patient has a ZIP CODE on file or not. If the VistA patient does not"
^DIC(9.4,60,22,13,"PAH",517,1,210,0)="      have a ZIP CODE on file the following message will be displayed: "
^DIC(9.4,60,22,13,"PAH",517,1,211,0)="    "
^DIC(9.4,60,22,13,"PAH",517,1,212,0)="      i1. VistA Patient Selection/Edit (user will be allowed to proceed):"
^DIC(9.4,60,22,13,"PAH",517,1,213,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,214,0)="      ****************************   WARNING(S)  *****************************"
^DIC(9.4,60,22,13,"PAH",517,1,215,0)="      Patient does not have a current mailing or residential address on file."
^DIC(9.4,60,22,13,"PAH",517,1,216,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,217,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,218,0)="      i2. VistA Patient Validation (user will not be allowed to proceed):"
^DIC(9.4,60,22,13,"PAH",517,1,219,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,220,0)="     Unable to validate - VistA Patient does not have a current mailing"
^DIC(9.4,60,22,13,"PAH",517,1,221,0)="     or residential address on file."
^DIC(9.4,60,22,13,"PAH",517,1,222,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,223,0)="   j) The VistA Provider selection/validation for controlled substance"
^DIC(9.4,60,22,13,"PAH",517,1,224,0)="      medication eRx records will perform a few checks to validate whether the"
^DIC(9.4,60,22,13,"PAH",517,1,225,0)="      selected VistA Provider is eligible to write the prescription:"
^DIC(9.4,60,22,13,"PAH",517,1,226,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,227,0)="      j1. Provider does not have a valid not expired DEA# on file:"
^DIC(9.4,60,22,13,"PAH",517,1,228,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,229,0)="      ***************************INVALID PROVIDER*****************************"
^DIC(9.4,60,22,13,"PAH",517,1,230,0)="      Missing VistA Provider DEA#"
^DIC(9.4,60,22,13,"PAH",517,1,231,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,232,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,233,0)="      j2. The VistA Drug was previously selected and VistA Provider is not"
^DIC(9.4,60,22,13,"PAH",517,1,234,0)="          authorized to write to the VistA drug DEA schedule:"
^DIC(9.4,60,22,13,"PAH",517,1,235,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,236,0)="      ***************************INVALID PROVIDER*****************************"
^DIC(9.4,60,22,13,"PAH",517,1,237,0)="      VistA Provider TEST,PROVIDER is NOT authorized to write to the schedule"
^DIC(9.4,60,22,13,"PAH",517,1,238,0)="      (C-II) of the VistA drug selected."
^DIC(9.4,60,22,13,"PAH",517,1,239,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,240,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,241,0)="      j3. VistA Provider's DEA # expires prior to eRx written/issue date:"
^DIC(9.4,60,22,13,"PAH",517,1,242,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,243,0)="      ***************************INVALID PROVIDER*****************************"
^DIC(9.4,60,22,13,"PAH",517,1,244,0)="      eRx Written Date/Issue Date is after the VistA Provider DEA expiration"
^DIC(9.4,60,22,13,"PAH",517,1,245,0)="      date (MM/DD/YY)."
^DIC(9.4,60,22,13,"PAH",517,1,246,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,247,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,248,0)="      j4. eRx Provider's DEA # does not match VistA Provider DEA # (allows "
^DIC(9.4,60,22,13,"PAH",517,1,249,0)="          selecting the provider with a warning but blocks validation)"
^DIC(9.4,60,22,13,"PAH",517,1,250,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,251,0)="      *********** WARNING (edit) / INVALID PROVIDER (validation) *************"
^DIC(9.4,60,22,13,"PAH",517,1,252,0)="      Provider DEA mismatch (eRx: TP123456 | VistA: TP654321)"
^DIC(9.4,60,22,13,"PAH",517,1,253,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,254,0)="      "
^DIC(9.4,60,22,13,"PAH",517,1,255,0)="      j5. The VistA Drug was previously selected and is a DETOX drug and VistA"
^DIC(9.4,60,22,13,"PAH",517,1,256,0)="          Provider does not have a valid not expired DETOX # on file (VistA"
^DIC(9.4,60,22,13,"PAH",517,1,257,0)="          drug must be previously selected):"
^DIC(9.4,60,22,13,"PAH",517,1,258,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,259,0)="      *********** WARNING (edit) / INVALID PROVIDER (validation) *************"
^DIC(9.4,60,22,13,"PAH",517,1,260,0)="      VistA Provider TEST,PROVIDER does not have a valid DETOX#"
^DIC(9.4,60,22,13,"PAH",517,1,261,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,262,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,263,0)="      j6. During Provider validation the functionality that allows the user to"
^DIC(9.4,60,22,13,"PAH",517,1,264,0)="          assign the same provider to other prescriptions that match the eRx"
^DIC(9.4,60,22,13,"PAH",517,1,265,0)="          provider was changed to check whether the VistA provider is "
^DIC(9.4,60,22,13,"PAH",517,1,266,0)="          authorized to write each prescription if they are for a controlled "
^DIC(9.4,60,22,13,"PAH",517,1,267,0)="          substance or detox medication. If the VistA provider is not "
^DIC(9.4,60,22,13,"PAH",517,1,268,0)="          authorized a message will be displayed for the eRx and it will not"
^DIC(9.4,60,22,13,"PAH",517,1,269,0)="          be selected/validated for the prescription."
^DIC(9.4,60,22,13,"PAH",517,1,270,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,271,0)="   k) The VistA Drug selection/validation for controlled substance medication"
^DIC(9.4,60,22,13,"PAH",517,1,272,0)="      eRx records will perform a few checks to validate whether the selected "
^DIC(9.4,60,22,13,"PAH",517,1,273,0)="      VistA Drug can be used for the prescription:"
^DIC(9.4,60,22,13,"PAH",517,1,274,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,275,0)="      k1. When the user selects the VALIDATE DRUG/SIG (VD) action and then"
^DIC(9.4,60,22,13,"PAH",517,1,276,0)="          selects the Edit (E) action to select the VistA dispense drug to"
^DIC(9.4,60,22,13,"PAH",517,1,277,0)="          associate it with the eRx record the prompt 'Select GENERIC DRUG"
^DIC(9.4,60,22,13,"PAH",517,1,278,0)="          NAME:' will now allow the selection of a drug marked as Controlled"
^DIC(9.4,60,22,13,"PAH",517,1,279,0)="          Substance. Before, CS drugs were not allowed to be selected."
^DIC(9.4,60,22,13,"PAH",517,1,280,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,281,0)="      k2. VistA Drug selected is NOT marked as a controlled substance "
^DIC(9.4,60,22,13,"PAH",517,1,282,0)="          medication the eRx record is for a controlled substance (user will"
^DIC(9.4,60,22,13,"PAH",517,1,283,0)="          be allowed to proceed with a warning):"
^DIC(9.4,60,22,13,"PAH",517,1,284,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,285,0)="      **********************************WARNING*******************************"
^DIC(9.4,60,22,13,"PAH",517,1,286,0)="      eRx Drug is indicated by the prescriber as CS ([C-IV]) and VistA Drug"
^DIC(9.4,60,22,13,"PAH",517,1,287,0)="      selected is Non-CS. Please, review and make sure you selected the"
^DIC(9.4,60,22,13,"PAH",517,1,288,0)="      correct drug."
^DIC(9.4,60,22,13,"PAH",517,1,289,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,290,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,291,0)="      k3. The VistA Drug selected is locally (not NDF matched) marked as a "
^DIC(9.4,60,22,13,"PAH",517,1,292,0)="          controlled substance medication and the eRx record is not for a"
^DIC(9.4,60,22,13,"PAH",517,1,293,0)="          controlled substance (does not have a  digital signature). User will"
^DIC(9.4,60,22,13,"PAH",517,1,294,0)="          not be able to select the drug:"
^DIC(9.4,60,22,13,"PAH",517,1,295,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,296,0)="      *******************************INVALID DRUG*****************************"
^DIC(9.4,60,22,13,"PAH",517,1,297,0)="      eRx is not digitally signed and VistA drug is non-CS and VistA drug is"
^DIC(9.4,60,22,13,"PAH",517,1,298,0)="      not matched to an NDF item marked with a CS Federal Schedule but is"
^DIC(9.4,60,22,13,"PAH",517,1,299,0)="      locally marked as a controlled substance ([C-II])."
^DIC(9.4,60,22,13,"PAH",517,1,300,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,301,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,302,0)="      k4. The VistA Drug selected is matched to and NDF item marked as a"
^DIC(9.4,60,22,13,"PAH",517,1,303,0)="          controlled substance medication and the eRx record is not eligible"
^DIC(9.4,60,22,13,"PAH",517,1,304,0)="          for a controlled substance (does not have a  digital signature). User"
^DIC(9.4,60,22,13,"PAH",517,1,305,0)="          will not be able to select the drug:"
^DIC(9.4,60,22,13,"PAH",517,1,306,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,307,0)="      *******************************INVALID DRUG*****************************"
^DIC(9.4,60,22,13,"PAH",517,1,308,0)="      eRx is not digitally signed and VistA Drug is marked as CS ([C-III])."
^DIC(9.4,60,22,13,"PAH",517,1,309,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,310,0)="     "
^DIC(9.4,60,22,13,"PAH",517,1,311,0)="      k5. The VistA Provider was previously selected and is not authorized to"
^DIC(9.4,60,22,13,"PAH",517,1,312,0)="          write to prescription for the DEA schedule of the VistA Drug :"
^DIC(9.4,60,22,13,"PAH",517,1,313,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,314,0)="      ******************************INVALID DRUG******************************"
^DIC(9.4,60,22,13,"PAH",517,1,315,0)="      VistA Provider TEST,PROVIDER is NOT authorized to write to the schedule"
^DIC(9.4,60,22,13,"PAH",517,1,316,0)="      (C-II) of the VistA drug selected."
^DIC(9.4,60,22,13,"PAH",517,1,317,0)="      ************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,318,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,319,0)="      k6. The VistA Provider was previously selected and does not have a valid"
^DIC(9.4,60,22,13,"PAH",517,1,320,0)="          not expired DETOX # and the VistA Drug selected is a DETOX drug."
^DIC(9.4,60,22,13,"PAH",517,1,321,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,322,0)="      *********** WARNING (edit) / INVALID PROVIDER (validation) **************"
^DIC(9.4,60,22,13,"PAH",517,1,323,0)="      VistA Provider TEST,PROVIDER does not have a valid DETOX#"
^DIC(9.4,60,22,13,"PAH",517,1,324,0)="      *************************************************************************"
^DIC(9.4,60,22,13,"PAH",517,1,325,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,326,0)="   l) In the eRx Holding Queue Display where a single prescription is displayed"
^DIC(9.4,60,22,13,"PAH",517,1,327,0)="      a new hidden action called View Audit Log (AU) was introduced. This new"
^DIC(9.4,60,22,13,"PAH",517,1,328,0)="      functionality will allow the user to track every edit made to the eRx"
^DIC(9.4,60,22,13,"PAH",517,1,329,0)="      during the transcription of the eRx data to match the VistA corresponding"
^DIC(9.4,60,22,13,"PAH",517,1,330,0)="      entries. The log looks like the screen below and can be sorted by "
^DIC(9.4,60,22,13,"PAH",517,1,331,0)="      DATE/TIME, FIELD NAME or EDITED BY columns."
^DIC(9.4,60,22,13,"PAH",517,1,332,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,333,0)="      eRx Audit Log              May 14, 2021@15:27:57       Page:    1   of  2 "
^DIC(9.4,60,22,13,"PAH",517,1,334,0)="      -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,335,0)="      eRx Patient: TEST,OUTPONE F"
^DIC(9.4,60,22,13,"PAH",517,1,336,0)="      eRx Reference #: 494949"
^DIC(9.4,60,22,13,"PAH",517,1,337,0)="      -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,338,0)="      DATE/TIME [^]              FIELD NAME                EDITED BY"
^DIC(9.4,60,22,13,"PAH",517,1,339,0)="      -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,340,0)="      Jan 28, 2021@09:47:45      PATIENT                   TEST,USER F"
^DIC(9.4,60,22,13,"PAH",517,1,341,0)="      Old Value:"
^DIC(9.4,60,22,13,"PAH",517,1,342,0)="      New Value: TEST,OUTPONE (L4SSN: 7944 | DOB: DEC 18,2014)"
^DIC(9.4,60,22,13,"PAH",517,1,343,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,344,0)="      Jan 28, 2021@09:48:06      DRUG                      TEST,USER F "
^DIC(9.4,60,22,13,"PAH",517,1,345,0)="      Old Value:                                              "
^DIC(9.4,60,22,13,"PAH",517,1,346,0)="      New Value: LOESTRIN FE 1/20 TAB,28 (NDC#: 51285-0080-70)"
^DIC(9.4,60,22,13,"PAH",517,1,347,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,348,0)="      Jan 28, 2021@09:48:13      SIG                       TEST,USER F "
^DIC(9.4,60,22,13,"PAH",517,1,349,0)="      Old Value:                                                 "
^DIC(9.4,60,22,13,"PAH",517,1,350,0)="      New Value: TAKE ONE TABLET PO ONCE DAILY                   "
^DIC(9.4,60,22,13,"PAH",517,1,351,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,352,0)="      Jan 28, 2021@09:48:18      QTY                       TEST,USER F  "
^DIC(9.4,60,22,13,"PAH",517,1,353,0)="      Old Value:                "
^DIC(9.4,60,22,13,"PAH",517,1,354,0)="      New Value: 30                               "
^DIC(9.4,60,22,13,"PAH",517,1,355,0)="      -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,356,0)="      +         Enter ?? for more actions            "
^DIC(9.4,60,22,13,"PAH",517,1,357,0)="      DT Sort by DATE/TIME      EB Sort by EDITED BY"
^DIC(9.4,60,22,13,"PAH",517,1,358,0)="      FN Sort by FIELD          SH Show/Hide eRx Value"
^DIC(9.4,60,22,13,"PAH",517,1,359,0)="      Select Item(s): Next Screen//  "
^DIC(9.4,60,22,13,"PAH",517,1,360,0)="     "
^DIC(9.4,60,22,13,"PAH",517,1,361,0)="      l1) The actions DT, FN and EB are used to sort the list by the columns "
^DIC(9.4,60,22,13,"PAH",517,1,362,0)="          DATE/TIME, FIELD NAME and EDITED BY respectively. The SH action will"
^DIC(9.4,60,22,13,"PAH",517,1,363,0)="          show o hide the original prescription value for the field from the"
^DIC(9.4,60,22,13,"PAH",517,1,364,0)="          eRx record as shown below: "
^DIC(9.4,60,22,13,"PAH",517,1,365,0)="      ..."
^DIC(9.4,60,22,13,"PAH",517,1,366,0)="      Jan 28, 2021@09:47:45      PATIENT                   TEST,USER F"
^DIC(9.4,60,22,13,"PAH",517,1,367,0)="      eRx Value: TEST,OUTPONE F (L4SSN: 7944 | DOB: DEC 18, 2014)     "
^DIC(9.4,60,22,13,"PAH",517,1,368,0)="      Old Value:                                                      "
^DIC(9.4,60,22,13,"PAH",517,1,369,0)="      New Value: TEST,OUTPONE (L4SSN: 7944 | DOB: DEC 18,2014)        "
^DIC(9.4,60,22,13,"PAH",517,1,370,0)="      ..."
^DIC(9.4,60,22,13,"PAH",517,1,371,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,372,0)="   m) Besides the ""]"" (closing square bracket) described in the letter d)"
^DIC(9.4,60,22,13,"PAH",517,1,373,0)="      above to identify CS (digitally signed) eRx records once you select a"
^DIC(9.4,60,22,13,"PAH",517,1,374,0)="      specific record it will display on the top right corner of the"
^DIC(9.4,60,22,13,"PAH",517,1,375,0)="      scrollable are the following note (in reverse video) ""EPCS DEA"
^DIC(9.4,60,22,13,"PAH",517,1,376,0)="      VALIDATED"" to indicate to the user processing the record that the "
^DIC(9.4,60,22,13,"PAH",517,1,377,0)="      electronic digital signature has been validate and also to comply with"
^DIC(9.4,60,22,13,"PAH",517,1,378,0)="      SureScripts requirements for CS prescriptions. In addition, these "
^DIC(9.4,60,22,13,"PAH",517,1,379,0)="      records will also contains the foot note:"
^DIC(9.4,60,22,13,"PAH",517,1,380,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,381,0)="      This prescription meets the requirements of the Drug Enforcement"
^DIC(9.4,60,22,13,"PAH",517,1,382,0)="      Administration (DEA) electronic prescribing for controlled substances"
^DIC(9.4,60,22,13,"PAH",517,1,383,0)="      rules (21 CFR Parts 1300,1304, 1306, & 1311)."
^DIC(9.4,60,22,13,"PAH",517,1,384,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,385,0)="   n) When the user selects the action EC (eRx Change Request) for a CS eRx"
^DIC(9.4,60,22,13,"PAH",517,1,386,0)="      record they will be limited to selecting only one of the following two"
^DIC(9.4,60,22,13,"PAH",517,1,387,0)="      values below (P or U):"
^DIC(9.4,60,22,13,"PAH",517,1,388,0)="     "
^DIC(9.4,60,22,13,"PAH",517,1,389,0)="      Select RX change message request code: ?"
^DIC(9.4,60,22,13,"PAH",517,1,390,0)="      Answer with ERX SERVICE REASON CODES, or NUMBER, or BRIEF DESCRIPTION,"
^DIC(9.4,60,22,13,"PAH",517,1,391,0)="         or CODE TYPE ABBREVIATION, or NCIT SUBTYPE"
^DIC(9.4,60,22,13,"PAH",517,1,392,0)="      Do you want the entire ERX SERVICE REASON CODES List? y  (Yes)"
^DIC(9.4,60,22,13,"PAH",517,1,393,0)="      Choose from:"
^DIC(9.4,60,22,13,"PAH",517,1,394,0)="      9999         P     Prior Authorization Required"
^DIC(9.4,60,22,13,"PAH",517,1,395,0)="      9999         U     Prescriber Authorization"
^DIC(9.4,60,22,13,"PAH",517,1,396,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,397,0)="      Select RX change message request code:"
^DIC(9.4,60,22,13,"PAH",517,1,398,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,399,0)="   o) When a Pending Order is un-accepted (see 5a below) a new entry will be"
^DIC(9.4,60,22,13,"PAH",517,1,400,0)="      added to the Status History for the related eRx record to indicate that"
^DIC(9.4,60,22,13,"PAH",517,1,401,0)="      it was un-accepted and sent back to the eRx Holding Queue. Below is an"
^DIC(9.4,60,22,13,"PAH",517,1,402,0)="      example how it will display:"
^DIC(9.4,60,22,13,"PAH",517,1,403,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,404,0)="      Select Action:Next Screen// SH   Status History  "
^DIC(9.4,60,22,13,"PAH",517,1,405,0)="      -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,406,0)="      ..."
^DIC(9.4,60,22,13,"PAH",517,1,407,0)="      07/17/20@10:48:50  PR     PROCESSED"
^DIC(9.4,60,22,13,"PAH",517,1,408,0)="      Entered By: USER, NAME F"
^DIC(9.4,60,22,13,"PAH",517,1,409,0)="      Comments: "
^DIC(9.4,60,22,13,"PAH",517,1,410,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,411,0)="      07/18/21@14:17:30  HRX    HOLD FOR RX EDIT (eRx Un-Accepted)"
^DIC(9.4,60,22,13,"PAH",517,1,412,0)="      Entered By: USER, NAME F"
^DIC(9.4,60,22,13,"PAH",517,1,413,0)="      Comments: Wrong Patient associated with Rx"
^DIC(9.4,60,22,13,"PAH",517,1,414,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,415,0)="      Type <Enter> to continue or '^' to exit: "
^DIC(9.4,60,22,13,"PAH",517,1,416,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,417,0)="5. Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",517,1,418,0)="   Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",517,1,419,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,420,0)="   A few changes have been made to the Pharmacy Backdoor options listed above"
^DIC(9.4,60,22,13,"PAH",517,1,421,0)="   to comply and facilitate the processing of controlled substance medication"
^DIC(9.4,60,22,13,"PAH",517,1,422,0)="   prescriptions:"
^DIC(9.4,60,22,13,"PAH",517,1,423,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,424,0)="   a) When viewing a Pending eRx Order the user will have the available a new"
^DIC(9.4,60,22,13,"PAH",517,1,425,0)="      hidden action called 'Un Accept eRx' (UA) which after answering a few"
^DIC(9.4,60,22,13,"PAH",517,1,426,0)="      prompts the record will be sent back to the eRx Holding Queue for"
^DIC(9.4,60,22,13,"PAH",517,1,427,0)="      further processing there, as shown below:"
^DIC(9.4,60,22,13,"PAH",517,1,428,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,429,0)="   ..."
^DIC(9.4,60,22,13,"PAH",517,1,430,0)="   Select Item(s): Next Screen// UA   UA  "
^DIC(9.4,60,22,13,"PAH",517,1,431,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,432,0)="   Select HOLD reason code: HOLD FOR RX EDIT//   HRX     HOLD FOR RX EDIT"
^DIC(9.4,60,22,13,"PAH",517,1,433,0)="   Comments (Optional): Wrong Patient associated with Rx"
^DIC(9.4,60,22,13,"PAH",517,1,434,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,435,0)="   This eRx will be Un-Accepted and sent back to the eRx Holding Queue."
^DIC(9.4,60,22,13,"PAH",517,1,436,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,437,0)="   Confirm? N// YES                        Please wait..."
^DIC(9.4,60,22,13,"PAH",517,1,438,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,439,0)="   eRx successfully un-accepted and placed back on the eRx Holding Queue."
^DIC(9.4,60,22,13,"PAH",517,1,440,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,441,0)="   Type <Enter> to continue or '^' to exit:"
^DIC(9.4,60,22,13,"PAH",517,1,442,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,443,0)="   b) When viewing a digitally signed eRx pending order the first line of the"
^DIC(9.4,60,22,13,"PAH",517,1,444,0)="      scrollable area will display the text ""Processing Digitally Signed eRx"
^DIC(9.4,60,22,13,"PAH",517,1,445,0)="      Order"" in reverse video to indicate to the user the they are processing"
^DIC(9.4,60,22,13,"PAH",517,1,446,0)="      a prescription for a controlled substance medication."
^DIC(9.4,60,22,13,"PAH",517,1,447,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,448,0)="   c) Also, for digitally signed eRx pending orders at the end of the"
^DIC(9.4,60,22,13,"PAH",517,1,449,0)="      scrollable area there will be a foot note that says:"
^DIC(9.4,60,22,13,"PAH",517,1,450,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,451,0)="      This prescription meets the requirements of the Drug Enforcement"
^DIC(9.4,60,22,13,"PAH",517,1,452,0)="      Administration (DEA) electronic prescribing for controlled substances"
^DIC(9.4,60,22,13,"PAH",517,1,453,0)="      rules (21 CFR Parts 1300,1304, 1306, & 1311)."
^DIC(9.4,60,22,13,"PAH",517,1,454,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,455,0)="   d) Digitally signed eRx pending orders cannot be edited. In order to edit"
^DIC(9.4,60,22,13,"PAH",517,1,456,0)="      any field on this type of pending orders they user would have to either"
^DIC(9.4,60,22,13,"PAH",517,1,457,0)="      Un-Accept the pending order, edit it in the eRx Holding Queue and then"
^DIC(9.4,60,22,13,"PAH",517,1,458,0)="      Re-Accept it; or finish the pending order and then edit the Active or"
^DIC(9.4,60,22,13,"PAH",517,1,459,0)="      Suspended prescription."
^DIC(9.4,60,22,13,"PAH",517,1,460,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,461,0)="   e) A new hidden action called Jump to eRx (JE) was included in the list of"
^DIC(9.4,60,22,13,"PAH",517,1,462,0)="      hidden actions available for an eRx pending order or an eRx active "
^DIC(9.4,60,22,13,"PAH",517,1,463,0)="      prescription. When a user viewing a pending order or an active"
^DIC(9.4,60,22,13,"PAH",517,1,464,0)="      prescription types JE it will take them to the eRx Holding queue to"
^DIC(9.4,60,22,13,"PAH",517,1,465,0)="      the screen showing the corresponding eRx record. Once they quit out of"
^DIC(9.4,60,22,13,"PAH",517,1,466,0)="      eRx record they will return them back to pending order or active"
^DIC(9.4,60,22,13,"PAH",517,1,467,0)="      prescription."
^DIC(9.4,60,22,13,"PAH",517,1,468,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,469,0)="   f) When a new CS eRx is finished and becomes an ACTIVE prescription it will"
^DIC(9.4,60,22,13,"PAH",517,1,470,0)="      display ""Digitally Signed eRx Order"" on the message bar right above the"
^DIC(9.4,60,22,13,"PAH",517,1,471,0)="      actions."
^DIC(9.4,60,22,13,"PAH",517,1,472,0)="    "
^DIC(9.4,60,22,13,"PAH",517,1,473,0)="   g) The trailing document of the prescription label will have the ""(DSIG)"""
^DIC(9.4,60,22,13,"PAH",517,1,474,0)="      to indicate that the prescription was digitally signed."
^DIC(9.4,60,22,13,"PAH",517,1,475,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,476,0)="   h) The 30th piece of the ORC segment in the HL7 message sent over to OPAI                (Outpatient Pharmacy Automated Interface) will contain ""EL"" for "
^DIC(9.4,60,22,13,"PAH",517,1,477,0)="      Digitally Signed eRx Controlled Substance prescriptions."
^DIC(9.4,60,22,13,"PAH",517,1,478,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,479,0)="6. HPS Sustaintment issues"
^DIC(9.4,60,22,13,"PAH",517,1,480,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",517,1,481,0)="   The Inbound eRx JAVA application is a component of the PRE IEP program that"
^DIC(9.4,60,22,13,"PAH",517,1,482,0)="   provides the capability to receive inbound eRx's from an external provider."
^DIC(9.4,60,22,13,"PAH",517,1,483,0)="   The JAVA application provides a user interface that allows end users to "
^DIC(9.4,60,22,13,"PAH",517,1,484,0)="   manage and monitor eRx processing from external sources. "
^DIC(9.4,60,22,13,"PAH",517,1,485,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,486,0)="   This patch resolves the incomplete users list displayed by the User "
^DIC(9.4,60,22,13,"PAH",517,1,487,0)="   Management screen in the Inbound eRx web-based application."
^DIC(9.4,60,22,13,"PAH",517,1,488,0)="   "
^DIC(9.4,60,22,13,"PAH",517,1,489,0)="   Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,60,22,13,"PAH",517,1,490,0)="   ============================================"
^DIC(9.4,60,22,13,"PAH",517,1,491,0)="   INC11772378 - Inbound eRX web application not displaying correctly"
^DIC(9.4,60,22,13,"PAH",517,1,492,0)="   INC18070242 - Inbound eRX web application not displaying correctly"
^DIC(9.4,60,22,13,"PAH",517,1,493,0)="  "
^DIC(9.4,60,22,13,"PAH",517,1,494,0)="   Problem:"
^DIC(9.4,60,22,13,"PAH",517,1,495,0)="   --------"
^DIC(9.4,60,22,13,"PAH",517,1,496,0)="   The User Management screen allows Administrators to add new users to one or"
^DIC(9.4,60,22,13,"PAH",517,1,497,0)="   more sites (Station ID), enable users, disable users, modify user roles and"
^DIC(9.4,60,22,13,"PAH",517,1,498,0)="   existing user records by assigning them to one or more sites. This screen"
^DIC(9.4,60,22,13,"PAH",517,1,499,0)="   will only display for users with Administrator access. However, User "
^DIC(9.4,60,22,13,"PAH",517,1,500,0)="   Management screen is currently displaying limited number of users, not the"
^DIC(9.4,60,22,13,"PAH",517,1,501,0)="   entire list of users."
^DIC(9.4,60,22,13,"PAH",517,1,502,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,503,0)="   Resolution:"
^DIC(9.4,60,22,13,"PAH",517,1,504,0)="   ----------"
^DIC(9.4,60,22,13,"PAH",517,1,505,0)="   Refactored Java code in order to fix the User Management component of the "
^DIC(9.4,60,22,13,"PAH",517,1,506,0)="   Inbound eRx application. After the fix is implemented, complete list of users"
^DIC(9.4,60,22,13,"PAH",517,1,507,0)="   is displayed on the User Management screen."
^DIC(9.4,60,22,13,"PAH",517,1,508,0)=" "
^DIC(9.4,60,22,13,"PAH",517,1,509,0)=" "
