^DIC(9.4,3,22,21,"PAH",115,1,85,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",115,1,86,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",115,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,88,0)="  2.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",115,1,89,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",115,1,90,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",115,1,91,0)="      options:"
^DIC(9.4,3,22,21,"PAH",115,1,92,0)=" "
