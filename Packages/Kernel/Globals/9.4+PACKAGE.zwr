^DIC(9.4,11,22,5.03,"PAH",21,1,536,0)="               May 11, 2000@16:24:52"
^DIC(9.4,11,22,5.03,"PAH",21,1,537,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,538,0)=" Install Message sent #23893"
^DIC(9.4,11,22,5.03,"PAH",22,0)="59 SEQ #42^3010625^1"
^DIC(9.4,11,22,5.03,"PAH",22,1,0)="^^191^191^3010625"
^DIC(9.4,11,22,5.03,"PAH",22,1,1,0)="VISTA Laboratory Package patch LA*5.2*59 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",22,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",22,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",22,1,4,0)="Patch LA*5.2*59 addresses a fix to the Lab Universal Interface (UI)"
^DIC(9.4,11,22,5.03,"PAH",22,1,5,0)="incoming message processing. Released patch LA*5.2*57 introduced changes"
^DIC(9.4,11,22,5.03,"PAH",22,1,6,0)="to the processing of HL7 result (ORU) messages that can result in the"
^DIC(9.4,11,22,5.03,"PAH",22,1,7,0)="processing routine LA7UIIN1 entering an endless loop. This occurs when the"
^DIC(9.4,11,22,5.03,"PAH",22,1,8,0)="UI processes a message that is for an accession area that is not associated"
^DIC(9.4,11,22,5.03,"PAH",22,1,9,0)="with the ""CH"" subscript. Patch LA*5.2*59 changes routine LA7UIIN1 to ignore"
^DIC(9.4,11,22,5.03,"PAH",22,1,10,0)="results for accessions that are not in the ""CH"" or ""MI"" subscripts if the"
^DIC(9.4,11,22,5.03,"PAH",22,1,11,0)="site is a test site for under development patch LA*5.2*41. Patch LA*5.2*41"
^DIC(9.4,11,22,5.03,"PAH",22,1,12,0)="adds support for microbiology instruments results that are processed within"
^DIC(9.4,11,22,5.03,"PAH",22,1,13,0)="the ""MI"" subscript."
^DIC(9.4,11,22,5.03,"PAH",22,1,14,0)=""
^DIC(9.4,11,22,5.03,"PAH",22,1,15,0)="As part of the install of this patch, the post-install routine performs"
^DIC(9.4,11,22,5.03,"PAH",22,1,16,0)="a check to determine if under development patch LA*5.2*41 has been"
^DIC(9.4,11,22,5.03,"PAH",22,1,17,0)="installed. If patch LA*5.2*41 is detected a mail message will be"
^DIC(9.4,11,22,5.03,"PAH",22,1,18,0)="triggered to the Lab Development team at the Dallas OI Field Office."
^DIC(9.4,11,22,5.03,"PAH",22,1,19,0)="The message will contain information concerning patch routine checksums,"
^DIC(9.4,11,22,5.03,"PAH",22,1,20,0)="status of patch installation from the PACKAGE file (#9.4) and a copy"
^DIC(9.4,11,22,5.03,"PAH",22,1,21,0)="of the patch routines."
^DIC(9.4,11,22,5.03,"PAH",22,1,22,0)=""
^DIC(9.4,11,22,5.03,"PAH",22,1,23,0)=""
^DIC(9.4,11,22,5.03,"PAH",22,1,24,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",22,1,25,0)="---------------"
