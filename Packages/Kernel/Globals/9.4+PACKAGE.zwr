^DIC(9.4,14,22,5.9,"PAH",281,1,410,0)="Print Reporting/Printing Facility                 None"
^DIC(9.4,14,22,5.9,"PAH",281,1,411,0)="Days to keep of instrument data 1                 2"
^DIC(9.4,14,22,5.9,"PAH",281,1,412,0)="Lab STS Default Mapping Files Directory           "
^DIC(9.4,14,22,5.9,"PAH",281,1,413,0)="Lab STS Default Mapping Filespec                  *.TXT"
