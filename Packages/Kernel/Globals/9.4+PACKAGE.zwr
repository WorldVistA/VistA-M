^DIC(9.4,28,22,6,"PAH",5,1,70,0)="GECSSEG                   New          1165320             24"
^DIC(9.4,28,22,6,"PAH",5,1,71,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,72,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,73,0)="Installation Instruction:"
^DIC(9.4,28,22,6,"PAH",5,1,74,0)="========================"
^DIC(9.4,28,22,6,"PAH",5,1,75,0)="NOTE OF IMPORTANCE:"
^DIC(9.4,28,22,6,"PAH",5,1,76,0)="Routine will automatically execute in the Post-Install immediately after"
^DIC(9.4,28,22,6,"PAH",5,1,77,0)="the installation of this package.  This routine should not be queued to"
^DIC(9.4,28,22,6,"PAH",5,1,78,0)="run at a later time."
^DIC(9.4,28,22,6,"PAH",5,1,79,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,80,0)="1. Users are allowed to be on the system during the Installation."
^DIC(9.4,28,22,6,"PAH",5,1,81,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,82,0)="2. Routine mapping is NOT recommended for these routines."
^DIC(9.4,28,22,6,"PAH",5,1,83,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,84,0)="3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,28,22,6,"PAH",5,1,85,0)="loads the patch into a Transport Global onto your system."
^DIC(9.4,28,22,6,"PAH",5,1,86,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,87,0)="4. You Do Not need to stop TaskMan or the background filers."
^DIC(9.4,28,22,6,"PAH",5,1,88,0)="   (AXP Sites - Place TaskMan in a WAIT state."
^DIC(9.4,28,22,6,"PAH",5,1,89,0)="   OpenM/Cache Sites - STOP TaskMan.)"
^DIC(9.4,28,22,6,"PAH",5,1,90,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,91,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,92,0)="5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,28,22,6,"PAH",5,1,93,0)="   following options to install the Transport Global:"
^DIC(9.4,28,22,6,"PAH",5,1,94,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,95,0)="  Verify Checksums in Transport Global"
^DIC(9.4,28,22,6,"PAH",5,1,96,0)="  Print Transport Global"
^DIC(9.4,28,22,6,"PAH",5,1,97,0)="  Compare Transport Global to Current System"
^DIC(9.4,28,22,6,"PAH",5,1,98,0)="  Backup a Transport Global"
^DIC(9.4,28,22,6,"PAH",5,1,99,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,100,0)="  Install Package(s)"
^DIC(9.4,28,22,6,"PAH",5,1,101,0)="             INSTALL NAME:  GEC*2.0*24"
^DIC(9.4,28,22,6,"PAH",5,1,102,0)="                            =========="
^DIC(9.4,28,22,6,"PAH",5,1,103,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,104,0)="  Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,28,22,6,"PAH",5,1,105,0)="                                                        =="
^DIC(9.4,28,22,6,"PAH",5,1,106,0)="  Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,28,22,6,"PAH",5,1,107,0)="  Protocols? YES// NO"
^DIC(9.4,28,22,6,"PAH",5,1,108,0)="                   ==   "
^DIC(9.4,28,22,6,"PAH",5,1,109,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,110,0)="6. AXP Sites - Answer NO to the question ""Want to MOVE routines"
^DIC(9.4,28,22,6,"PAH",5,1,111,0)="   to other CPUs?"""
^DIC(9.4,28,22,6,"PAH",5,1,112,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,113,0)="7. If the routines were unmapped, the mapped set should be rebuilt"
^DIC(9.4,28,22,6,"PAH",5,1,114,0)="   once the installation has run to completion."
^DIC(9.4,28,22,6,"PAH",5,1,115,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,116,0)="8. AXP and OpenM/Cache Sites Only - Remove TaskMan from a WAIT/STOP state."
^DIC(9.4,28,22,6,"PAH",6,0)="25 SEQ #22^3000229^1"
^DIC(9.4,28,22,6,"PAH",6,1,0)="^^85^85^3000229"
^DIC(9.4,28,22,6,"PAH",6,1,1,0)="    This patch may not be installed during the Y2K Leap Year Lockdown"
^DIC(9.4,28,22,6,"PAH",6,1,2,0)="    period of 2/28/2000 to 3/3/2000."
^DIC(9.4,28,22,6,"PAH",6,1,3,0)=" "
^DIC(9.4,28,22,6,"PAH",6,1,4,0)="1.  The Austin Automation Center VHA Work Measurement(VWM) System will"
^DIC(9.4,28,22,6,"PAH",6,1,5,0)="    not be able to accommendate the inactive segments, all segments in"
^DIC(9.4,28,22,6,"PAH",6,1,6,0)="    file #2101.2 will be placed in a status of active."
^DIC(9.4,28,22,6,"PAH",6,1,7,0)=" "
^DIC(9.4,28,22,6,"PAH",6,1,8,0)=" "
^DIC(9.4,28,22,6,"PAH",6,1,9,0)="SPECIAL NOTE OF IMPORTANCE:"
^DIC(9.4,28,22,6,"PAH",6,1,10,0)="==========================="
^DIC(9.4,28,22,6,"PAH",6,1,11,0)="1. IF YOUR SITE (HAS NOT) INSTALLED PATCH GEC*2.0*24, THEN (DONOT) INSTALL"
^DIC(9.4,28,22,6,"PAH",6,1,12,0)="   THIS PATCH GEC*2.0*25."
^DIC(9.4,28,22,6,"PAH",6,1,13,0)=" "
^DIC(9.4,28,22,6,"PAH",6,1,14,0)="2. IF YOUR SITE (HAS) INSTALLED PATCH GEC*2.0*24, THEN PLEASE (DO) INSTALL"
^DIC(9.4,28,22,6,"PAH",6,1,15,0)="   THIS PATCH GEC*2.0*25."
^DIC(9.4,28,22,6,"PAH",6,1,16,0)=" "
^DIC(9.4,28,22,6,"PAH",6,1,17,0)=" "
