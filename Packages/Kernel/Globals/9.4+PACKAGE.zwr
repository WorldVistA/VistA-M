^DIC(9.4,121,6,1,0)="The first version of this package is about to begin Beta test."
^DIC(9.4,121,6,2,0)=" "
^DIC(9.4,121,6,3,0)="Future versions of the package will include additional modules for claims,"
^DIC(9.4,121,6,4,0)="binding, other holdings and an automated card index."
