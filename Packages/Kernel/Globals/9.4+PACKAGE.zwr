^DIC(9.4,108,0)="SURVEY GENERATOR^QAP^Generates surveys and allows participation in them."
^DIC(9.4,108,1,0)="^^3^3^2950620^^^"
^DIC(9.4,108,1,1,0)="This package will completely generate a survey with information provided"
^DIC(9.4,108,1,2,0)="by the survey author, then allow participation of designated audiences."
^DIC(9.4,108,1,3,0)="Once the participation is finished, the author may generate statistics."
^DIC(9.4,108,4,0)="^9.44PA^5^4"
^DIC(9.4,108,4,1,0)=748
^DIC(9.4,108,4,1,222)="y^y^^n^^^n^^"
^DIC(9.4,108,4,2,0)=748.25
