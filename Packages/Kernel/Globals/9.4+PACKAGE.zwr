^DIC(9.4,35,22,3,"PAH",360,1,127,0)="------------------------------------ "
^DIC(9.4,35,22,3,"PAH",360,1,128,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,129,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,130,0)="Pre/Post Installation Overview"
^DIC(9.4,35,22,3,"PAH",360,1,131,0)="------------------------------"
^DIC(9.4,35,22,3,"PAH",360,1,132,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,133,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,134,0)="Pre-Installation Instructions"
^DIC(9.4,35,22,3,"PAH",360,1,135,0)="-------------------------"
^DIC(9.4,35,22,3,"PAH",360,1,136,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,35,22,3,"PAH",360,1,137,0)="recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,35,22,3,"PAH",360,1,138,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,35,22,3,"PAH",360,1,139,0)="minutes to install."
^DIC(9.4,35,22,3,"PAH",360,1,140,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,141,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,142,0)="Installation Instructions"
^DIC(9.4,35,22,3,"PAH",360,1,143,0)="-----------------------------"
^DIC(9.4,35,22,3,"PAH",360,1,144,0)="1.      Choose the PackMan message containing this patch."
^DIC(9.4,35,22,3,"PAH",360,1,145,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,146,0)="2.      Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,35,22,3,"PAH",360,1,147,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,148,0)="3.      From the Kernel Installation and Distribution System Menu, select "
^DIC(9.4,35,22,3,"PAH",360,1,149,0)="        the Installation Menu.  From this menu, you may elect to use the "
^DIC(9.4,35,22,3,"PAH",360,1,150,0)="        following options. When prompted for the INSTALL NAME enter"
^DIC(9.4,35,22,3,"PAH",360,1,151,0)="        OR*3.0*422."
^DIC(9.4,35,22,3,"PAH",360,1,152,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,153,0)="        a. Verify Checksums in Transport Global - This option will "
^DIC(9.4,35,22,3,"PAH",360,1,154,0)="            allow you to ensure the integrity of the routines that are in"
^DIC(9.4,35,22,3,"PAH",360,1,155,0)="            the transport global."
^DIC(9.4,35,22,3,"PAH",360,1,156,0)="        b. Print Transport Global - This option will allow you to view"
^DIC(9.4,35,22,3,"PAH",360,1,157,0)="            the components of the KIDS build."
^DIC(9.4,35,22,3,"PAH",360,1,158,0)="        c. Compare Transport Global to Current System - This option will"
^DIC(9.4,35,22,3,"PAH",360,1,159,0)="            allow you to view all changes that will be made when this "
^DIC(9.4,35,22,3,"PAH",360,1,160,0)="            patch is installed.  It compares all components of this patch"
^DIC(9.4,35,22,3,"PAH",360,1,161,0)="            (routines, DD's, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",360,1,162,0)="        d. Backup a Transport Global - This option will create a backup"
^DIC(9.4,35,22,3,"PAH",360,1,163,0)="            message of any routines exported with this patch. It will not"
^DIC(9.4,35,22,3,"PAH",360,1,164,0)="            backup any other changes such as DD's or templates."
^DIC(9.4,35,22,3,"PAH",360,1,165,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,166,0)="4.      From the Installation Menu, select the Install Package(s) option "
^DIC(9.4,35,22,3,"PAH",360,1,167,0)="        and choose the patch to install."
^DIC(9.4,35,22,3,"PAH",360,1,168,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,169,0)="5.      When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,35,22,3,"PAH",360,1,170,0)="        Install? NO// Press <Enter>"
^DIC(9.4,35,22,3,"PAH",360,1,171,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,172,0)="6.      When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,35,22,3,"PAH",360,1,173,0)="        NO// Press <Enter>"
^DIC(9.4,35,22,3,"PAH",360,1,174,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,175,0)="7.      When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,35,22,3,"PAH",360,1,176,0)="        and Protocols? NO// Press <Enter>"
^DIC(9.4,35,22,3,"PAH",360,1,177,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,178,0)="8.      If prompted ""Delay Install (Minutes):  (0 - 60): 0// respond 0."
^DIC(9.4,35,22,3,"PAH",360,1,179,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,180,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,181,0)="Post-Installation Instructions"
^DIC(9.4,35,22,3,"PAH",360,1,182,0)="N/A"
^DIC(9.4,35,22,3,"PAH",361,0)="423^3160923.155437^54"
^DIC(9.4,35,22,3,"PAH",361,1,0)="^^1^1^3160923"
^DIC(9.4,35,22,3,"PAH",361,1,1,0)="The description of this patch can be found in the National Patch Module."
^DIC(9.4,35,22,3,"PAH",362,0)="425 SEQ #370^3161212.121014^54"
^DIC(9.4,35,22,3,"PAH",362,1,0)="^^23^23^3161212"
^DIC(9.4,35,22,3,"PAH",362,1,1,0)="Patch OR*3.0*425 allows inpatient delayed "
^DIC(9.4,35,22,3,"PAH",362,1,2,0)="orders (with the exception of Unit-Dose "
^DIC(9.4,35,22,3,"PAH",362,1,3,0)="Meds orders and Diet orders) to be manually "
^DIC(9.4,35,22,3,"PAH",362,1,4,0)="released to outpatient locations. Without "
^DIC(9.4,35,22,3,"PAH",362,1,5,0)="this modification, care to patients can be "
^DIC(9.4,35,22,3,"PAH",362,1,6,0)="delayed while providers re-enter orders "
^DIC(9.4,35,22,3,"PAH",362,1,7,0)="previously entered as inpatient orders."
^DIC(9.4,35,22,3,"PAH",362,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",362,1,9,0)="This solution is designed to address the "
^DIC(9.4,35,22,3,"PAH",362,1,10,0)="specific scenario in which inpatient delayed "
^DIC(9.4,35,22,3,"PAH",362,1,11,0)="orders are written for an admission event, "
^DIC(9.4,35,22,3,"PAH",362,1,12,0)="but then the patient is not admitted (post "
^DIC(9.4,35,22,3,"PAH",362,1,13,0)="treatment/post procedure the patient remains "
^DIC(9.4,35,22,3,"PAH",362,1,14,0)="an outpatient) and the delayed orders are "
^DIC(9.4,35,22,3,"PAH",362,1,15,0)="required at an outpatient location, such as "
^DIC(9.4,35,22,3,"PAH",362,1,16,0)="a Post Anesthesia Care Unit. Under the current "
^DIC(9.4,35,22,3,"PAH",362,1,17,0)="functionality, these inpatient delayed orders "
^DIC(9.4,35,22,3,"PAH",362,1,18,0)="cannot be released to the outpatient location "
^DIC(9.4,35,22,3,"PAH",362,1,19,0)="because the admission event never occurred. "
^DIC(9.4,35,22,3,"PAH",362,1,20,0)="After implementation of this patch, the delayed "
^DIC(9.4,35,22,3,"PAH",362,1,21,0)="orders (with the exception of Unit-Dose Meds "
^DIC(9.4,35,22,3,"PAH",362,1,22,0)="orders and Diet orders) can be successfully "
^DIC(9.4,35,22,3,"PAH",362,1,23,0)="released to an outpatient location."
^DIC(9.4,35,22,3,"PAH",363,0)="417 SEQ #371^3161220.145732^54"
^DIC(9.4,35,22,3,"PAH",363,1,0)="^^34^34^3161220"
^DIC(9.4,35,22,3,"PAH",363,1,1,0)="OR*3.0*417 makes changes to order details in support of Bar Code"
^DIC(9.4,35,22,3,"PAH",363,1,2,0)="Medications Administration (BCMA) and Inpatient Medications enhancements"
^DIC(9.4,35,22,3,"PAH",363,1,3,0)="for Transdermal Administrations."
^DIC(9.4,35,22,3,"PAH",363,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,5,0)="******************************* ATTENTION ********************************"
^DIC(9.4,35,22,3,"PAH",363,1,6,0)="  "
^DIC(9.4,35,22,3,"PAH",363,1,7,0)="Clinical Ancillary Services (CAS) Development-Delivery of Pharmacy "
^DIC(9.4,35,22,3,"PAH",363,1,8,0)="Enhancements (DDPE) VA Inpatient Medication Administration - Transdermal"
^DIC(9.4,35,22,3,"PAH",363,1,9,0)="enhancement includes 5 patches which must be installed in the following"
^DIC(9.4,35,22,3,"PAH",363,1,10,0)="order:"
^DIC(9.4,35,22,3,"PAH",363,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,12,0)="1.      PSS*1*191"
^DIC(9.4,35,22,3,"PAH",363,1,13,0)="2.      PSJ*5*315"
^DIC(9.4,35,22,3,"PAH",363,1,14,0)="3.      PSB*3*83"
^DIC(9.4,35,22,3,"PAH",363,1,15,0)="4.      PSB*3*87"
^DIC(9.4,35,22,3,"PAH",363,1,16,0)="5.      OR*3*417"
^DIC(9.4,35,22,3,"PAH",363,1,17,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,18,0)="ATTENTION: This enhancement also includes a new Graphical User Interface"
^DIC(9.4,35,22,3,"PAH",363,1,19,0)="(GUI) executable, BCMA GUI PSB3_P083.EXE. Installation of this GUI is"
^DIC(9.4,35,22,3,"PAH",363,1,20,0)="required immediately after the KIDS install for the Patch to function."
^DIC(9.4,35,22,3,"PAH",363,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,22,0)="For retrieval and installation instructions, please see the Client "
^DIC(9.4,35,22,3,"PAH",363,1,23,0)="Installation Instructions section."
^DIC(9.4,35,22,3,"PAH",363,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,25,0)="**************************************************************************"
^DIC(9.4,35,22,3,"PAH",363,1,26,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,27,0)="The change made by OR*3*417 is in support of requirements for patch"
^DIC(9.4,35,22,3,"PAH",363,1,28,0)="PSB*3.0*83.  All the patches in this group should be installed  prior to "
^DIC(9.4,35,22,3,"PAH",363,1,29,0)="patch OR*3.0*417."
^DIC(9.4,35,22,3,"PAH",363,1,30,0)=" "
^DIC(9.4,35,22,3,"PAH",363,1,31,0)="The change will add a line to the Order Details report and the Medication"
^DIC(9.4,35,22,3,"PAH",363,1,32,0)="Administration History Report in the Computerized Patient Record System"
^DIC(9.4,35,22,3,"PAH",363,1,33,0)="(CPRS). These reports will display the Removal times for Medications"
^DIC(9.4,35,22,3,"PAH",363,1,34,0)="that Require Removal (MRRs)."
^DIC(9.4,35,22,3,"PAH",364,0)="421^3170123.14263^54"
^DIC(9.4,35,22,3,"PAH",364,1,0)="^^17^17^3170123"
^DIC(9.4,35,22,3,"PAH",364,1,1,0)="Changes were needed in OE/RR to store data for the eHMP (Enterprise "
^DIC(9.4,35,22,3,"PAH",364,1,2,0)="Health Management Platform).  The eHMP needed data that has dates and "
^DIC(9.4,35,22,3,"PAH",364,1,3,0)="times with seconds and also required triggers when relevant OE/RR data "
^DIC(9.4,35,22,3,"PAH",364,1,4,0)="were created and/or edited.  The OR* namespace routines were modified to "
^DIC(9.4,35,22,3,"PAH",364,1,5,0)="call the appropriate eHMP API (application programmer interface) line "
^DIC(9.4,35,22,3,"PAH",364,1,6,0)="tags, where needed."
^DIC(9.4,35,22,3,"PAH",364,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",364,1,8,0)="These eHMP APIs store the data with a date and time stamp that has "
^DIC(9.4,35,22,3,"PAH",364,1,9,0)="seconds, which are required by the JDS (JSON data store).  The JDS is the "
^DIC(9.4,35,22,3,"PAH",364,1,10,0)="repository for the eHMP data."
^DIC(9.4,35,22,3,"PAH",364,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",364,1,12,0)="The changes include tracking when an Order was flagged or unflagged by a "
^DIC(9.4,35,22,3,"PAH",364,1,13,0)="user.  There were also changes to store clinical data in the JDS for "
^DIC(9.4,35,22,3,"PAH",364,1,14,0)="unsigned, as well as signed, orders.  Additionally, discontinued orders "
^DIC(9.4,35,22,3,"PAH",364,1,15,0)="now trigger updates to the JDS."
^DIC(9.4,35,22,3,"PAH",364,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",364,1,17,0)="Includes changes related to patches: 286,424,269"
^DIC(9.4,35,22,3,"PAH",365,0)="415 SEQ #373^3170310.132755^54"
^DIC(9.4,35,22,3,"PAH",365,1,0)="^^1^1^3170310"
^DIC(9.4,35,22,3,"PAH",365,1,1,0)="OR*3.0*415"
^DIC(9.4,35,22,3,"PAH",366,0)="420 SEQ #374^3170403.135025^54"
^DIC(9.4,35,22,3,"PAH",366,1,0)="^^216^216^3170403"
^DIC(9.4,35,22,3,"PAH",366,1,1,0)="Patch OR*3.0*420 modifies the existing Pharmacy package in VistA to"
^DIC(9.4,35,22,3,"PAH",366,1,2,0)="display the most recent associated lab results when a clinician is"
^DIC(9.4,35,22,3,"PAH",366,1,3,0)="ordering medication using the Computerized Patient Record System (CPRS)"
^DIC(9.4,35,22,3,"PAH",366,1,4,0)="Inpatient or Outpatient Medication Order dialogs. Without this"
^DIC(9.4,35,22,3,"PAH",366,1,5,0)="modification, the clinician must look in numerous locations for this"
^DIC(9.4,35,22,3,"PAH",366,1,6,0)="information. The information is important for safe and effective"
^DIC(9.4,35,22,3,"PAH",366,1,7,0)="medication management. "
^DIC(9.4,35,22,3,"PAH",366,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,9,0)="The lab results for the most recent lab test associated with an Orderable "
^DIC(9.4,35,22,3,"PAH",366,1,10,0)="Item will be displayed in the Information field in the Medication Order "
^DIC(9.4,35,22,3,"PAH",366,1,11,0)="dialog once an Orderable Item is selected. Once a dispense drug is chosen "
^DIC(9.4,35,22,3,"PAH",366,1,12,0)="(by selecting a dosage in the order dialog), the lab test information "
^DIC(9.4,35,22,3,"PAH",366,1,13,0)="will be replaced by the National Standard Drug Information found in the"
^DIC(9.4,35,22,3,"PAH",366,1,14,0)="MESSAGE (#101) field of the DRUG (#50) file. This message currently"
^DIC(9.4,35,22,3,"PAH",366,1,15,0)="shows in CPRS when ordering a dispense drug and is not changed by this"
^DIC(9.4,35,22,3,"PAH",366,1,16,0)="modification."
^DIC(9.4,35,22,3,"PAH",366,1,17,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,18,0)="Note: Follow-on work to allow persistence of the lab test information in "
^DIC(9.4,35,22,3,"PAH",366,1,19,0)="the Medication Order dialog is expected to be addressed in CPRS v32."
^DIC(9.4,35,22,3,"PAH",366,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,21,0)="In order to monitor lab results, lab tests are associated with an "
^DIC(9.4,35,22,3,"PAH",366,1,22,0)="Orderable Item using the PSS DRUG ENTER/EDIT option in VistA by entering "
^DIC(9.4,35,22,3,"PAH",366,1,23,0)="a lab test in the LAB TEST MONITOR (#17.2) field of the DRUG (#50) file. "
^DIC(9.4,35,22,3,"PAH",366,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,25,0)="The NSR for this intake addresses the following requirement: "
^DIC(9.4,35,22,3,"PAH",366,1,26,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,27,0)="* VHBAO:NEED126: Ability to display laboratory test results, in a single "
^DIC(9.4,35,22,3,"PAH",366,1,28,0)="                 view, for ordering inpatient and outpatient medications"
^DIC(9.4,35,22,3,"PAH",366,1,29,0)="                 while viewing the Medication Order dialog in CPRS."
^DIC(9.4,35,22,3,"PAH",366,1,30,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,31,0)="This modification has been implemented locally at the VA centers in "
^DIC(9.4,35,22,3,"PAH",366,1,32,0)="Clarksburg, WV; Hines, IL; Iron Mountain, MI; and Chicago, IL."
^DIC(9.4,35,22,3,"PAH",366,1,33,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,34,0)="This build contains the components for the CPRS Graphical User Interface "
^DIC(9.4,35,22,3,"PAH",366,1,35,0)="(GUI) to display relevant laboratory results in the Medication Ordering "
^DIC(9.4,35,22,3,"PAH",366,1,36,0)="dialog."
^DIC(9.4,35,22,3,"PAH",366,1,37,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,38,0)="To use the features, the following setup steps are advised:"
^DIC(9.4,35,22,3,"PAH",366,1,39,0)=" * Establish drug-to-lab mapping relationship using the PSS DRUG "
^DIC(9.4,35,22,3,"PAH",366,1,40,0)="   ENTER/EDIT option.  Follow the OUTPATIENT marking pathway to set up a"
^DIC(9.4,35,22,3,"PAH",366,1,41,0)="   LAB MONITOR drug.  Lab name, specimen type and number of days to look"
^DIC(9.4,35,22,3,"PAH",366,1,42,0)="   back are required fields for the program to work."
^DIC(9.4,35,22,3,"PAH",366,1,43,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,44,0)=" * If not already set correctly, review the site local terms for SERUM "
^DIC(9.4,35,22,3,"PAH",366,1,45,0)="   CREATININE and SERUM SPECIMEN in the CPRS Order Check menus.  This is "
^DIC(9.4,35,22,3,"PAH",366,1,46,0)="   required for calculation of Creatinine Clearance."
^DIC(9.4,35,22,3,"PAH",366,1,47,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,48,0)=" * When the lab requested is ""Creatinine"", a second line for CrCl will be "
^DIC(9.4,35,22,3,"PAH",366,1,49,0)="   returned."
^DIC(9.4,35,22,3,"PAH",366,1,50,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,51,0)="The routine ORWDPLM2 is included.  This is a version of the display that"
^DIC(9.4,35,22,3,"PAH",366,1,52,0)="will work as a TIU OBJECT.  The object method is:"
^DIC(9.4,35,22,3,"PAH",366,1,53,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,54,0)="S X=$$SL^ORWDLPM2(DFN,"
^DIC(9.4,35,22,3,"PAH",366,1,55,0)="$S($G(X0)]"""":$P(X0,U),$G(NODE0)]"""":$P(NODE0,U),1:""""),""^TMP($J,""""ORWDPLM2"""""
^DIC(9.4,35,22,3,"PAH",366,1,56,0)=")"")"
^DIC(9.4,35,22,3,"PAH",366,1,57,0)=" "
^DIC(9.4,35,22,3,"PAH",366,1,58,0)="The display is wrapped for ease of reading, but the object method must be "
^DIC(9.4,35,22,3,"PAH",366,1,59,0)="entered as part of one single line."
^DIC(9.4,35,22,3,"PAH",366,1,60,0)=" "
