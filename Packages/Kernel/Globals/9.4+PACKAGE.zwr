^DIC(9.4,175,22,2,"PAH",115,0)="151^3170207.132835^54"
^DIC(9.4,175,22,2,"PAH",115,1,0)="^^38^38^3170207"
^DIC(9.4,175,22,2,"PAH",115,1,1,0)="VistA Imaging V3.0 Patch 151 - Scanning Enhancements"
^DIC(9.4,175,22,2,"PAH",115,1,2,0)="    "
^DIC(9.4,175,22,2,"PAH",115,1,3,0)="Patch 151 has fixes for the Clinical Capture Client. "
^DIC(9.4,175,22,2,"PAH",115,1,4,0)="Summary of the issues fixed:"
^DIC(9.4,175,22,2,"PAH",115,1,5,0)="Progress Notes window has been modified to fix errors when"
^DIC(9.4,175,22,2,"PAH",115,1,6,0)=" returning a list of Patient Notes."
^DIC(9.4,175,22,2,"PAH",115,1,7,0)="Issues when Scanning Images as PDF files have been fixed"
^DIC(9.4,175,22,2,"PAH",115,1,8,0)="Abstracts are now created for PDF files."
^DIC(9.4,175,22,2,"PAH",115,1,9,0)="Specialty, Proc/Event values were incorrectly saved."
^DIC(9.4,175,22,2,"PAH",115,1,10,0)="Option to add Additional Images to an Existing Image Group."
^DIC(9.4,175,22,2,"PAH",115,1,11,0)="More details included in the list of Patient Consults."
^DIC(9.4,175,22,2,"PAH",115,1,12,0)="TWAIN device sharing issues fixed."
^DIC(9.4,175,22,2,"PAH",115,1,13,0)="Unsigned Notes are now correctly displayed for a Patient."
^DIC(9.4,175,22,2,"PAH",115,1,14,0)="User is no longer asked to select Patient for Lab Selection."
^DIC(9.4,175,22,2,"PAH",115,1,15,0)="Date/Time dialog correctly displays am/pm for selected time."
^DIC(9.4,175,22,2,"PAH",115,1,16,0)="Option to display Configuration Buttons on Top or Left of window."
^DIC(9.4,175,22,2,"PAH",115,1,17,0)="Changes to captured PDF images (rotate ) are now"
^DIC(9.4,175,22,2,"PAH",115,1,18,0)="saved correctly."
^DIC(9.4,175,22,2,"PAH",115,1,19,0)="Annotations are no longer created in the Capture"
^DIC(9.4,175,22,2,"PAH",115,1,20,0)="application.  Capture application now communicates with"
^DIC(9.4,175,22,2,"PAH",115,1,21,0)="the Display application. Starting with Clinical Display patch 167"
^DIC(9.4,175,22,2,"PAH",115,1,22,0)="an annotation window will open automatically and enable"
^DIC(9.4,175,22,2,"PAH",115,1,23,0)="the user to annotate immediately after the image is"
^DIC(9.4,175,22,2,"PAH",115,1,24,0)="captured.  User can also select any image from the 'Latest"
^DIC(9.4,175,22,2,"PAH",115,1,25,0)="Patient Images' window, and have that image open in the"
^DIC(9.4,175,22,2,"PAH",115,1,26,0)="Annotation window of Clinical Display"
^DIC(9.4,175,22,2,"PAH",115,1,27,0)="    "
^DIC(9.4,175,22,2,"PAH",115,1,28,0)="Please note that routine MAGIP151 is deleted after the KIDS Build is"
^DIC(9.4,175,22,2,"PAH",115,1,29,0)="installed."
^DIC(9.4,175,22,2,"PAH",115,1,30,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",115,1,31,0)="Select BUILD NAME:    MAG*3.0*151     IMAGING"
^DIC(9.4,175,22,2,"PAH",115,1,32,0)="MAGGA03A  value = 26454333"
