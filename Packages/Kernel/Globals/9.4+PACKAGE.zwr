^DIC(9.4,14,22,5.9,"PAH",98,1,414,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,415,0)=" Removing CPT Code 83019"
^DIC(9.4,14,22,5.9,"PAH",98,1,416,0)="  "
