^DIC(9.4,42,"DEV")="SALT LAKE CITY"
^DIC(9.4,42,"DIBT",0)="^9.48^1^1"
^DIC(9.4,42,"DIBT",1,0)="GMTS TASK LOCATIONS SORT^142"
^DIC(9.4,42,"DIE",0)="^9.47^1^2"
^DIC(9.4,42,"DIE",1,0)="GMTS DELETE HLTH SUM TYPE^142"
^DIC(9.4,42,"DIE",2,0)="GMTS EDIT HLTH SUM TYPE^142"
^DIC(9.4,42,"DIPT",0)="^9.46^9^9"
^DIC(9.4,42,"DIPT",1,0)="GMTS TYPE LIST^142"
