^DIC(9.4,13,22,8,"PAH",18,1,143,0)="  DIC2           5005952         5078251         4,17,20"
^DIC(9.4,13,22,8,"PAH",18,1,144,0)="  DIC3           7365376         7735073         1,16,4,17,20"
^DIC(9.4,13,22,8,"PAH",18,1,145,0)="  DIC4           5435232         5480003         4,20"
