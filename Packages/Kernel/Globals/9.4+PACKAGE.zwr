^DIC(9.4,52,22,28,"PAH",40,0)="117 SEQ #102^2970501^1"
^DIC(9.4,52,22,28,"PAH",40,1,0)="^^2^2^2970501"
^DIC(9.4,52,22,28,"PAH",40,1,1,0)=" "
^DIC(9.4,52,22,28,"PAH",40,1,2,0)="Enhancement to create purchase card order from temporary request."
^DIC(9.4,52,22,28,"PAH",41,0)="113 SEQ #103^2970508^1"
^DIC(9.4,52,22,28,"PAH",41,1,0)="^^1^1^2970508"
^DIC(9.4,52,22,28,"PAH",41,1,1,0)="Various purchase card fixes."
^DIC(9.4,52,22,28,"PAH",42,0)="120 SEQ #104^2970528^1"
^DIC(9.4,52,22,28,"PAH",42,1,0)="^^2^2^2970528"
^DIC(9.4,52,22,28,"PAH",42,1,1,0)="This patch is being issued to distribute direct delivery functionality"
^DIC(9.4,52,22,28,"PAH",42,1,2,0)="for purchase cards, and to create the IMPAC Account Information report."
^DIC(9.4,52,22,28,"PAH",43,0)="123 SEQ #105^2970616^1"
^DIC(9.4,52,22,28,"PAH",43,1,0)="^^2^2^2970616"
^DIC(9.4,52,22,28,"PAH",43,1,1,0)="This KIDS install will remove all references to files 3-6-16-20 from IFCAP"
^DIC(9.4,52,22,28,"PAH",43,1,2,0)="5.0."
^DIC(9.4,52,22,28,"PAH",44,0)="109 SEQ #106^2970619^1"
^DIC(9.4,52,22,28,"PAH",44,1,0)="^^4^4^2970619"
^DIC(9.4,52,22,28,"PAH",44,1,1,0)="This will update the IFCAP ISMS, EDI and FMS servers to present more and"
^DIC(9.4,52,22,28,"PAH",44,1,2,0)="better error messages to the user.  Since these servers run in the"
^DIC(9.4,52,22,28,"PAH",44,1,3,0)="background the error messages will be sent to ISM or FMS mail group.  If"
^DIC(9.4,52,22,28,"PAH",44,1,4,0)="the mail group isn't available then the message will go to POSTMASTER."
^DIC(9.4,52,22,28,"PAH",45,0)="106 SEQ #107^2970625^1"
^DIC(9.4,52,22,28,"PAH",45,1,0)="^^2^2^2970625"
^DIC(9.4,52,22,28,"PAH",45,1,1,0)=" "
^DIC(9.4,52,22,28,"PAH",45,1,2,0)="IFCAP Patch PRC*5*106"
^DIC(9.4,52,22,28,"PAH",46,0)="122 SEQ #108^2970717^1"
^DIC(9.4,52,22,28,"PAH",46,1,0)="^^1^1^2970717"
^DIC(9.4,52,22,28,"PAH",46,1,1,0)="Fiscal Budget Related Patch"
^DIC(9.4,52,22,28,"PAH",47,0)="131 SEQ #109^2970717^1"
^DIC(9.4,52,22,28,"PAH",47,1,0)="^^3^3^2970717"
^DIC(9.4,52,22,28,"PAH",47,1,1,0)="This patch will increase the number of amendments that can be entered to a"
^DIC(9.4,52,22,28,"PAH",47,1,2,0)="Purchase Order from 99 to 999, a ten-fold increase in the number of"
^DIC(9.4,52,22,28,"PAH",47,1,3,0)="amendments able to be entered."
^DIC(9.4,52,22,28,"PAH",48,0)="132 SEQ #111^2970728^1"
^DIC(9.4,52,22,28,"PAH",48,1,0)="^^1^1^2970728"
^DIC(9.4,52,22,28,"PAH",48,1,1,0)="This patch will check your file 442.3 and report its status to FORUM."
^DIC(9.4,52,22,28,"PAH",49,0)="125 SEQ #112^2970728^1"
^DIC(9.4,52,22,28,"PAH",49,1,0)="^^1^1^2970728"
^DIC(9.4,52,22,28,"PAH",49,1,1,0)="PROSTHETIC/IFCAP AMENDMENT AND RECONCILIATION ENHANCEMENT"
^DIC(9.4,52,22,28,"PAH",50,0)="135 SEQ #113^2970804^1"
^DIC(9.4,52,22,28,"PAH",50,1,0)="^^2^2^2970804"
^DIC(9.4,52,22,28,"PAH",50,1,1,0)="This patch will allow users to Re-transmit the IRS PRE-OFFSET"
^DIC(9.4,52,22,28,"PAH",50,1,2,0)="code sheet Batch."
^DIC(9.4,52,22,28,"PAH",51,0)="104 SEQ #114^2970822^1"
^DIC(9.4,52,22,28,"PAH",51,1,0)="^^1^1^2970822"
^DIC(9.4,52,22,28,"PAH",51,1,1,0)="IFCAP Patch PRC*5*104."
^DIC(9.4,52,22,28,"PAH",52,0)="118 SEQ #115^2971006^1"
^DIC(9.4,52,22,28,"PAH",52,1,0)="^^5^5^2971006"
^DIC(9.4,52,22,28,"PAH",52,1,1,0)="This patch deals with Federal Procurement Data System(FPDS) reporting"
^DIC(9.4,52,22,28,"PAH",52,1,2,0)="requirements data and how IFCAP collates procurement data in the Summary"
^DIC(9.4,52,22,28,"PAH",52,1,3,0)="of Actions of $25,000 or less."
^DIC(9.4,52,22,28,"PAH",52,1,4,0)="Two nois(s) ALT-0792-20001 and CMO-0797-41042 are also addressed in this"
^DIC(9.4,52,22,28,"PAH",52,1,5,0)="patch."
^DIC(9.4,52,22,28,"PAH",53,0)="133 SEQ #116^2971006^1"
^DIC(9.4,52,22,28,"PAH",53,1,0)="^^1^1^2971006"
^DIC(9.4,52,22,28,"PAH",53,1,1,0)="ALL ET-RECORDS WITH ACTION CODE 'E'"
^DIC(9.4,52,22,28,"PAH",54,0)="137 SEQ #117^2971006^1"
^DIC(9.4,52,22,28,"PAH",54,1,0)="^^1^1^2971006"
^DIC(9.4,52,22,28,"PAH",54,1,1,0)="GENERAL LEDGER CHANGES"
^DIC(9.4,52,22,28,"PAH",55,0)="127 SEQ #119^2971021^1"
^DIC(9.4,52,22,28,"PAH",55,1,0)="^^7^7^2971021"
^DIC(9.4,52,22,28,"PAH",55,1,1,0)="Two issues are addressed."
^DIC(9.4,52,22,28,"PAH",55,1,2,0)=" "
^DIC(9.4,52,22,28,"PAH",55,1,3,0)="1.  The Supply Fund Requests and Orders were missing a value in the BOC"
^DIC(9.4,52,22,28,"PAH",55,1,4,0)="    field."
^DIC(9.4,52,22,28,"PAH",55,1,5,0)=" "
^DIC(9.4,52,22,28,"PAH",55,1,6,0)="2.  The discount was miscalculated when users entered a '$' sign and a"
^DIC(9.4,52,22,28,"PAH",55,1,7,0)="    comma in field 'Percent/Dollar Amount'."
^DIC(9.4,52,22,28,"PAH",56,0)="119 SEQ #120^2971028^1"
^DIC(9.4,52,22,28,"PAH",56,1,0)="^^1^1^2971028"
^DIC(9.4,52,22,28,"PAH",56,1,1,0)="Slave device handling fixes."
^DIC(9.4,52,22,28,"PAH",57,0)="128 SEQ #121^2971028^1"
^DIC(9.4,52,22,28,"PAH",58,0)="139 SEQ #122^2971105^1"
^DIC(9.4,52,22,28,"PAH",58,1,0)="^^1^1^2971105"
^DIC(9.4,52,22,28,"PAH",58,1,1,0)="2237 FIXES - APPROVAL LOOP & REQUESTOR NAME CHANGES"
^DIC(9.4,52,22,28,"PAH",59,0)="141 SEQ #124^2971204^1"
^DIC(9.4,52,22,28,"PAH",59,1,0)="^^1^1^2971204"
^DIC(9.4,52,22,28,"PAH",59,1,1,0)="NEW OPTIONS FOR UNREG. CARD CHARGES."
^DIC(9.4,52,22,28,"PAH",60,0)="138 SEQ #125^2971215^1"
^DIC(9.4,52,22,28,"PAH",60,1,0)="^^9^9^2971215"
^DIC(9.4,52,22,28,"PAH",60,1,1,0)="When ceiling transactions are entered via Create Multiple Transactions,"
^DIC(9.4,52,22,28,"PAH",60,1,2,0)="these transactions do not appear on the Transaction reports.  At one time,"
^DIC(9.4,52,22,28,"PAH",60,1,3,0)="the transactions generated a non-standard appropriation number and so"
^DIC(9.4,52,22,28,"PAH",60,1,4,0)="appeared under a second heading (ergo the complaint that the summary gives"
^DIC(9.4,52,22,28,"PAH",60,1,5,0)="2 totals).  However, the code to set up the appropriation number had been"
^DIC(9.4,52,22,28,"PAH",60,1,6,0)="commented out."
^DIC(9.4,52,22,28,"PAH",60,1,7,0)=" "
^DIC(9.4,52,22,28,"PAH",60,1,8,0)="Also, there was a request to display the transaction numbers generated, so"
^DIC(9.4,52,22,28,"PAH",60,1,9,0)="this functionality was added. "
^DIC(9.4,52,22,28,"PAH",61,0)="129 SEQ #126^2980112^1"
^DIC(9.4,52,22,28,"PAH",61,1,0)="^^2^2^2980112"
^DIC(9.4,52,22,28,"PAH",61,1,1,0)=" "
^DIC(9.4,52,22,28,"PAH",61,1,2,0)="VARIOUS PURCHASE CARD REPORT ENHANCEMENTS"
^DIC(9.4,52,22,28,"PAH",62,0)="65 SEQ #127^2980112^1"
^DIC(9.4,52,22,28,"PAH",62,1,0)="^^1^1^2980112"
^DIC(9.4,52,22,28,"PAH",62,1,1,0)="This patch fixes numerous bugs related to delivery schedule."
^DIC(9.4,52,22,28,"PAH",63,0)="152 SEQ #128^2980129^1"
^DIC(9.4,52,22,28,"PAH",63,1,0)="^^1^1^2980129"
^DIC(9.4,52,22,28,"PAH",63,1,1,0)="PREVENT TERMINATED USERS IN FCP"
^DIC(9.4,52,22,28,"PAH",64,0)="148 SEQ #129^2980129^1"
^DIC(9.4,52,22,28,"PAH",64,1,0)="^^1^1^2980129"
^DIC(9.4,52,22,28,"PAH",64,1,1,0)="REPORT SPOOLER PROBLEMS"
^DIC(9.4,52,22,28,"PAH",65,0)="144 SEQ #130^2980202^1"
^DIC(9.4,52,22,28,"PAH",65,1,0)="^^1^1^2980202"
^DIC(9.4,52,22,28,"PAH",65,1,1,0)="FCP REPORT FIXES"
^DIC(9.4,52,22,28,"PAH",66,0)="146 SEQ #131^2980220^1"
^DIC(9.4,52,22,28,"PAH",66,1,0)="^^1^1^2980220"
^DIC(9.4,52,22,28,"PAH",66,1,1,0)="NEW OPTS: DETAIL ACCRUAL, CHARGE COUNT, AUDIT"
^DIC(9.4,52,22,28,"PAH",67,0)="154 SEQ #132^2980220^1"
^DIC(9.4,52,22,28,"PAH",67,1,0)="^^10^10^2980220"
^DIC(9.4,52,22,28,"PAH",67,1,1,0)="This change will correct 3 NOIS entries."
^DIC(9.4,52,22,28,"PAH",67,1,2,0)="      HAC-1197-50154"
^DIC(9.4,52,22,28,"PAH",67,1,3,0)="      COS-1297-40227"
^DIC(9.4,52,22,28,"PAH",67,1,4,0)="      NOP-0397-11470"
^DIC(9.4,52,22,28,"PAH",67,1,5,0)=" "
^DIC(9.4,52,22,28,"PAH",67,1,6,0)="This change will now display all cards a user holds.  If a user has 67"
^DIC(9.4,52,22,28,"PAH",67,1,7,0)="cards the display of the cards, when a ? was entered, displayed cards 1-20"
^DIC(9.4,52,22,28,"PAH",67,1,8,0)="on the first screen, cards 22-40 on the second screen, cards 43-60 on the"
^DIC(9.4,52,22,28,"PAH",67,1,9,0)="third screen and 61-67 on the fourth screen.  Note that cards 21, 41 and"
^DIC(9.4,52,22,28,"PAH",67,1,10,0)="42 didn't display.  After the change all the cards display."
^DIC(9.4,52,22,28,"PAH",68,0)="156 SEQ #133^2980319^1"
^DIC(9.4,52,22,28,"PAH",69,0)="158 SEQ #134^2980403^1"
^DIC(9.4,52,22,28,"PAH",69,1,0)="^^1^1^2980403"
^DIC(9.4,52,22,28,"PAH",69,1,1,0)="This patch fixes NOIS ISH-0495-40396 and SDH-1196-N0212."
^DIC(9.4,52,22,28,"PAH",70,0)="155 SEQ #135^2980417^1"
^DIC(9.4,52,22,28,"PAH",70,1,0)="^^1^1^2980417"
^DIC(9.4,52,22,28,"PAH",70,1,1,0)="Y2K Renovations"
^DIC(9.4,52,22,28,"PAH",71,0)="149 SEQ #136^2980417^1"
^DIC(9.4,52,22,28,"PAH",71,1,0)="^^14^14^2980417"
^DIC(9.4,52,22,28,"PAH",71,1,1,0)="o Removes hard sets of COST CENTER 600000 into control point activity"
^DIC(9.4,52,22,28,"PAH",71,1,2,0)="  documents involving the Supply Fund."
^DIC(9.4,52,22,28,"PAH",71,1,3,0)="o Clarifies error messages presented to users who do not have proper"
^DIC(9.4,52,22,28,"PAH",71,1,4,0)="  access for autogeneration of repetitive item lists."
^DIC(9.4,52,22,28,"PAH",71,1,5,0)="o Causes inventory adjustments to appear correctly on Stock Status"
^DIC(9.4,52,22,28,"PAH",71,1,6,0)="  Reports."
^DIC(9.4,52,22,28,"PAH",71,1,7,0)="o Insures that local variables PRC(""SITE"") and PRC(""CP"") are set p[roperly"
^DIC(9.4,52,22,28,"PAH",71,1,8,0)="  for repetitive item lists, so that budget fiscal years and other"
^DIC(9.4,52,22,28,"PAH",71,1,9,0)="  accounting data will be correct."
^DIC(9.4,52,22,28,"PAH",71,1,10,0)="o Inserts time delay into an IRL download routine so that downloads to"
^DIC(9.4,52,22,28,"PAH",71,1,11,0)="  Janus portable bar code readers will be more reliable. Also displays"
^DIC(9.4,52,22,28,"PAH",71,1,12,0)="  download and upload times, preserves data that was uploaded"
^DIC(9.4,52,22,28,"PAH",71,1,13,0)="  unsuccessfully (for diagnostic purposes), and corrects documentation"
^DIC(9.4,52,22,28,"PAH",71,1,14,0)="  errors."
^DIC(9.4,52,22,28,"PAH",72,0)="160 SEQ #137^2980423^1"
^DIC(9.4,52,22,28,"PAH",72,1,0)="^^1^1^2980423"
^DIC(9.4,52,22,28,"PAH",72,1,1,0)="BLOCK TERMINATED USERS FROM FCP"
^DIC(9.4,52,22,28,"PAH",73,0)="130 SEQ #139^2980511^1"
^DIC(9.4,52,22,28,"PAH",73,1,0)="^^1^1^2980511"
^DIC(9.4,52,22,28,"PAH",73,1,1,0)="This patch will fix a couple of E3Rs and NOISs."
^DIC(9.4,52,22,28,"PAH",74,0)="145 SEQ #140^2980511^1"
^DIC(9.4,52,22,28,"PAH",74,1,0)="^^2^2^2980511"
^DIC(9.4,52,22,28,"PAH",74,1,1,0)="Cancelled Supply P.O. does not return funds."
^DIC(9.4,52,22,28,"PAH",74,1,2,0)="Undefined string."
^DIC(9.4,52,22,28,"PAH",75,0)="161 SEQ #141^2980527^1"
^DIC(9.4,52,22,28,"PAH",75,1,0)="^^1^1^2980527"
^DIC(9.4,52,22,28,"PAH",75,1,1,0)="Undef errors in Transaction Report"
^DIC(9.4,52,22,28,"PAH",76,0)="88 SEQ #142^2980616^1"
^DIC(9.4,52,22,28,"PAH",76,1,0)="^^1^1^2980616"
^DIC(9.4,52,22,28,"PAH",76,1,1,0)="Payment/Invoice Tracking fixes."
^DIC(9.4,52,22,28,"PAH",77,0)="166 SEQ #143^2980626^1"
^DIC(9.4,52,22,28,"PAH",77,1,0)="^^1^1^2980626"
^DIC(9.4,52,22,28,"PAH",77,1,1,0)="IFCAP PATCH PRC*5*166"
^DIC(9.4,52,22,28,"PAH",78,0)="136 SEQ #144^2980701^1"
^DIC(9.4,52,22,28,"PAH",78,1,0)="^^1^1^2980701"
^DIC(9.4,52,22,28,"PAH",78,1,1,0)="IFCAP PATCH PRC*5.0*136"
^DIC(9.4,52,22,28,"PAH",79,0)="157 SEQ #145^2980725^1"
^DIC(9.4,52,22,28,"PAH",79,1,0)="^^1^1^2980725"
^DIC(9.4,52,22,28,"PAH",79,1,1,0)="Resolution of Purchase Card problems and multiple access to Amendments."
^DIC(9.4,52,22,28,"PAH",80,0)="153 SEQ #146^2980808^1"
^DIC(9.4,52,22,28,"PAH",80,1,0)="^^1^1^2980808"
^DIC(9.4,52,22,28,"PAH",80,1,1,0)="MISSING BBFY AND PC RR AT FICSCAL OFFICE"
^DIC(9.4,52,22,28,"PAH",81,0)="126 SEQ #147^2980808^1"
^DIC(9.4,52,22,28,"PAH",81,1,0)="^^11^11^2980808"
^DIC(9.4,52,22,28,"PAH",81,1,1,0)="This patch addresses several E3R and NOIS.  Issues addressed include 1) "
^DIC(9.4,52,22,28,"PAH",81,1,2,0)="Importing Purchase Card information into BI segment of PHA and on hard"
^DIC(9.4,52,22,28,"PAH",81,1,3,0)="copy Purchase Orders for use in EDI Orders where Method of Processing is"
^DIC(9.4,52,22,28,"PAH",81,1,4,0)="Purchase Card.  Purchase Card Number and Expiration Date are to be"
^DIC(9.4,52,22,28,"PAH",81,1,5,0)="encrypted while Purchase Card Holder is unencrypted in the PHA.  Only"
^DIC(9.4,52,22,28,"PAH",81,1,6,0)="non-sensitive information Purchase Card Holder and Purchase Card Name,"
^DIC(9.4,52,22,28,"PAH",81,1,7,0)="both unencrypted, are to be included on the hard copy PO. 2) Adding a"
^DIC(9.4,52,22,28,"PAH",81,1,8,0)="mechanism for suppressing the EDI order to EDI registered vendors. 3)"
^DIC(9.4,52,22,28,"PAH",81,1,9,0)="Activating the printing of Imprest Fund orders in supply. 4) Fixes for"
^DIC(9.4,52,22,28,"PAH",81,1,10,0)="illegal number errors when contract number or ACC contains embedded 'E'"
^DIC(9.4,52,22,28,"PAH",81,1,11,0)="and system was evaluating them as exponential notation numbers."
^DIC(9.4,52,22,28,"PAH",82,0)="140 SEQ #148^2980831^1"
^DIC(9.4,52,22,28,"PAH",82,1,0)="^^1^1^2980831"
^DIC(9.4,52,22,28,"PAH",82,1,1,0)="IFCAP Patch PRC*5.0*140"
^DIC(9.4,52,22,28,"PAH",83,0)="174 SEQ #149^2980923^1"
^DIC(9.4,52,22,28,"PAH",83,1,0)="^^1^1^2980923"
^DIC(9.4,52,22,28,"PAH",83,1,1,0)="TEMPORARY EMPLOYEES AS FCP USERS"
^DIC(9.4,52,22,28,"PAH",84,0)="163 SEQ #150^2980923^1"
^DIC(9.4,52,22,28,"PAH",84,1,0)="^^1^1^2980923"
^DIC(9.4,52,22,28,"PAH",84,1,1,0)="General Post Fund Fixes"
^DIC(9.4,52,22,28,"PAH",85,0)="181 SEQ #151^2980923^1"
^DIC(9.4,52,22,28,"PAH",86,0)="164 SEQ #152^2980923^1"
^DIC(9.4,52,22,28,"PAH",86,1,0)="^^8^8^2980923"
^DIC(9.4,52,22,28,"PAH",86,1,1,0)="In Amendments module this patch will fix the logic to display the original"
^DIC(9.4,52,22,28,"PAH",86,1,2,0)="dollar amount correctly and print discount information of amendments that"
^DIC(9.4,52,22,28,"PAH",86,1,3,0)="are obligated in Fiscal."
^DIC(9.4,52,22,28,"PAH",86,1,4,0)=" "
^DIC(9.4,52,22,28,"PAH",86,1,5,0)="It fixes a couple of NOIS as listed. "
^DIC(9.4,52,22,28,"PAH",86,1,6,0)=" "
^DIC(9.4,52,22,28,"PAH",86,1,7,0)="     1.  LOU-0896-42124"
^DIC(9.4,52,22,28,"PAH",86,1,8,0)="     2.  GAI-0296-30038"
^DIC(9.4,52,22,28,"PAH",87,0)="170 SEQ #153^2981104^1"
^DIC(9.4,52,22,28,"PAH",87,1,0)="^^3^3^2981104"
^DIC(9.4,52,22,28,"PAH",87,1,1,0)="This KIDS build deals with various Purchase Card Reports which may be"
^DIC(9.4,52,22,28,"PAH",87,1,2,0)="found in the following menus: Approving Official Menu, Purchase Card"
^DIC(9.4,52,22,28,"PAH",87,1,3,0)="Coordinator's Menu, and Purchase Card Reports Menu."
^DIC(9.4,52,22,28,"PAH",88,0)="134 SEQ #154^2981104^1"
^DIC(9.4,52,22,28,"PAH",89,0)="168 SEQ #155^2981104^1"
^DIC(9.4,52,22,28,"PAH",89,1,0)="^^1^1^2981104"
^DIC(9.4,52,22,28,"PAH",89,1,1,0)="Block FCP# edits, change rollover date, and fix typos"
^DIC(9.4,52,22,28,"PAH",90,0)="151 SEQ #156^2981104^1"
^DIC(9.4,52,22,28,"PAH",90,1,0)="^^1^1^2981104"
^DIC(9.4,52,22,28,"PAH",90,1,1,0)="This patch will upgrade the ARCHIVE and PURGE process."
^DIC(9.4,52,22,28,"PAH",91,0)="69 SEQ #157^2981104^1"
^DIC(9.4,52,22,28,"PAH",91,1,0)="^^1^1^2981104"
^DIC(9.4,52,22,28,"PAH",91,1,1,0)="Fixes to several un-related nois messages."
^DIC(9.4,52,22,28,"PAH",92,0)="180 SEQ #158^2981104^1"
^DIC(9.4,52,22,28,"PAH",92,1,0)="^^7^7^2981104"
^DIC(9.4,52,22,28,"PAH",92,1,1,0)="This patch will set up an Extrinsic Function to allow an AR user to select"
^DIC(9.4,52,22,28,"PAH",92,1,2,0)="an IFCAP vendor."
^DIC(9.4,52,22,28,"PAH",92,1,3,0)="If the vendor has FMS VENDOR CODE present, nothing else is done to it."
^DIC(9.4,52,22,28,"PAH",92,1,4,0)="If the vendor is missing the FMS VENDOR CODE but has all"
^DIC(9.4,52,22,28,"PAH",92,1,5,0)="the other required fields necessary to create a VRQ, one will be created."
^DIC(9.4,52,22,28,"PAH",92,1,6,0)="If the vendor is missing the FMS VENDOR CODE and other required fields, it"
^DIC(9.4,52,22,28,"PAH",92,1,7,0)="will be edited to fill in the missing fields needed to be vendorized."
^DIC(9.4,52,22,28,"PAH",93,0)="167 SEQ #159^2981112^1"
^DIC(9.4,52,22,28,"PAH",93,1,0)="^^5^5^2981112"
^DIC(9.4,52,22,28,"PAH",93,1,1,0)="o Prevents queueing a task to a virtual terminal."
^DIC(9.4,52,22,28,"PAH",93,1,2,0)="o Checks for and ignores blank lines when user is attempting to upload"
^DIC(9.4,52,22,28,"PAH",93,1,3,0)="  data from a portable bar code reader to the central processor. This is a"
^DIC(9.4,52,22,28,"PAH",93,1,4,0)="  common problem at Open-M sites."
^DIC(9.4,52,22,28,"PAH",93,1,5,0)="o Remove inappropriate post-conditional from WRITE command in ^PRCTLAB."
^DIC(9.4,52,22,28,"PAH",94,0)="178 SEQ #160^2981112^1"
^DIC(9.4,52,22,28,"PAH",94,1,0)="^^1^1^2981112"
^DIC(9.4,52,22,28,"PAH",94,1,1,0)="AUTO SET BBFY IN PURCHASE CARD REQUEST"
^DIC(9.4,52,22,28,"PAH",95,0)="150 SEQ #161^2981119^1"
^DIC(9.4,52,22,28,"PAH",95,1,0)="^^18^18^2981119"
^DIC(9.4,52,22,28,"PAH",95,1,1,0)="Item Master File updates and related E3R's."
^DIC(9.4,52,22,28,"PAH",95,1,2,0)=" "
^DIC(9.4,52,22,28,"PAH",95,1,3,0)="This patch covers several E3Rs.  They all involve Entry, Editing"
^DIC(9.4,52,22,28,"PAH",95,1,4,0)="or Printing associated with the Item Master, Procurement & Accounting"
^DIC(9.4,52,22,28,"PAH",95,1,5,0)="Transactions, Amendments and Control Point Activity files."
^DIC(9.4,52,22,28,"PAH",95,1,6,0)="The patch includes changes to routines, a new routine, edit and sort"
^DIC(9.4,52,22,28,"PAH",95,1,7,0)="and print templates, and a new field added to the 'Item Master' file."
^DIC(9.4,52,22,28,"PAH",95,1,8,0)=" "
^DIC(9.4,52,22,28,"PAH",95,1,9,0)="This patch addresses the following E3R's:"
^DIC(9.4,52,22,28,"PAH",95,1,10,0)=" "
^DIC(9.4,52,22,28,"PAH",95,1,11,0)="E3Rs: 2349 - Make Package Multiple Field on Item Master File mandatory."
^DIC(9.4,52,22,28,"PAH",95,1,12,0)="             (Cancelled because covered by E3R 5673.)"
^DIC(9.4,52,22,28,"PAH",95,1,13,0)="      5673 - Make Package Multiple & Unit Conversion Factor mandatory"
^DIC(9.4,52,22,28,"PAH",95,1,14,0)="                before allowing completion of PO."
^DIC(9.4,52,22,28,"PAH",95,1,15,0)="      2558 - Make Drug Type Code pull fm Item Master File & mandatory."
^DIC(9.4,52,22,28,"PAH",95,1,16,0)="      3344 - Control Point Item History Does Not Go Back Far Enough."
^DIC(9.4,52,22,28,"PAH",95,1,17,0)="      10365- Procurement Item History Does Not Go Back Far Enough."
^DIC(9.4,52,22,28,"PAH",95,1,18,0)="      10230- Add Synonym field to Item Master File."
^DIC(9.4,52,22,28,"PAH",96,0)="171 SEQ #162^2981119^1"
^DIC(9.4,52,22,28,"PAH",96,1,0)="^^1^1^2981119"
^DIC(9.4,52,22,28,"PAH",96,1,1,0)="NEW CHARGE CARD VENDOR (CITI BANK)"
^DIC(9.4,52,22,28,"PAH",97,0)="196 SEQ #163^2990105^1"
^DIC(9.4,52,22,28,"PAH",97,1,0)="^^1^1^2990105"
^DIC(9.4,52,22,28,"PAH",97,1,1,0)="EDITING INVALID PURCHASE CARD DEMOGRAPHIC DATA"
