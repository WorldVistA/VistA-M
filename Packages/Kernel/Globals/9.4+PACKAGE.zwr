^DIC(9.4,13,22,8,"PAH",10,1,132,0)="  DIP10          5293036         5158897         2"
^DIC(9.4,13,22,8,"PAH",10,1,133,0)="  DIP22          6717942         6867188         2"
^DIC(9.4,13,22,8,"PAH",10,1,134,0)="  DIP31          1504438         1478503         2"
