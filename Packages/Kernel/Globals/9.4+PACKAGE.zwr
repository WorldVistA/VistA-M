^DIC(9.4,35,22,3,"PAH",464,1,0)="^^5^5^3210720"
^DIC(9.4,35,22,3,"PAH",464,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",464,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",464,1,3,0)="If an order dialog is defined containing more than one prompt having the "
^DIC(9.4,35,22,3,"PAH",464,1,4,0)="same ""ID"", information might not be stored when placing the order and/or "
^DIC(9.4,35,22,3,"PAH",464,1,5,0)="a software error might occur in CPRS."
^DIC(9.4,35,22,3,"PAH",465,0)="553b^3210726"
