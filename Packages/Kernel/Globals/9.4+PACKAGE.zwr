^DIC(9.4,180,22,2,"PAH",47,0)="62^3161028.150513^54"
^DIC(9.4,180,22,2,"PAH",47,1,0)="^^79^79^3161028"
^DIC(9.4,180,22,2,"PAH",47,1,1,0)="This patch is in support of the Mental Health PCL-5 instrument patch.  It "
^DIC(9.4,180,22,2,"PAH",47,1,2,0)="will modify nationally released clinical reminders and reminder dialogs "
^DIC(9.4,180,22,2,"PAH",47,1,3,0)="to use the PCL-5 instrument instead of the previously used PCLC "
^DIC(9.4,180,22,2,"PAH",47,1,4,0)="instrument.  The PCLC and PCLM instruments are inactivated with the "
^DIC(9.4,180,22,2,"PAH",47,1,5,0)="associated mental health patch."
^DIC(9.4,180,22,2,"PAH",47,1,6,0)=" "
^DIC(9.4,180,22,2,"PAH",47,1,7,0)="  Please refer to the information contained in the Mental Health patch"
^DIC(9.4,180,22,2,"PAH",47,1,8,0)="  for installation instructions."
^DIC(9.4,180,22,2,"PAH",47,1,9,0)=" "
^DIC(9.4,180,22,2,"PAH",47,1,10,0)="The following clinical reminder items are updated to use PCL-5 as a"
^DIC(9.4,180,22,2,"PAH",47,1,11,0)="finding instead of PCLC:"
^DIC(9.4,180,22,2,"PAH",47,1,12,0)=" "
^DIC(9.4,180,22,2,"PAH",47,1,13,0)="  VA-PTSD REASSESSMENT (PCL)      reminder definition"
^DIC(9.4,180,22,2,"PAH",47,1,14,0)=" "
^DIC(9.4,180,22,2,"PAH",47,1,15,0)="  VA-MH CPT ASSESSMENT GROUP      dialog group"
^DIC(9.4,180,22,2,"PAH",47,1,16,0)="  VA-MH PEI ASSESSMENT GP         dialog group"
^DIC(9.4,180,22,2,"PAH",47,1,17,0)=" "
^DIC(9.4,180,22,2,"PAH",47,1,18,0)="  VA-PTSD EVALUATION (PCL)        reminder dialog"
^DIC(9.4,180,22,2,"PAH",47,1,19,0)="  VA-PTSD SCREENING               reminder dialog"
^DIC(9.4,180,22,2,"PAH",47,1,20,0)=" "
^DIC(9.4,180,22,2,"PAH",47,1,21,0)="The effects of updating the dialog groups will be seen in the VA-MH CPT* "
