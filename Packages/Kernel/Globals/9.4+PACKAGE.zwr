^DIC(9.4,164,22,1,"PAH",141,0)="158 SEQ #142^3110428.161424^17"
^DIC(9.4,164,22,1,"PAH",141,1,0)="^^74^74^3110428"
^DIC(9.4,164,22,1,"PAH",141,1,1,0)="This patch contains software modifications to the Pharmacy Data Management "
^DIC(9.4,164,22,1,"PAH",141,1,2,0)="(PDM) V. 1.0 application to support the FDA Medication Guides project. The "
^DIC(9.4,164,22,1,"PAH",141,1,3,0)="project objective is to allow pharmacy staff to retrieve the FDA Medication "
^DIC(9.4,164,22,1,"PAH",141,1,4,0)="Guide for prescriptions that contain FDA approved information that can help"
^DIC(9.4,164,22,1,"PAH",141,1,5,0)="patients avoid serious adverse events. The FDA requires that Medication"
^DIC(9.4,164,22,1,"PAH",141,1,6,0)="Guides be included with certain prescribed drugs and biological products "
^DIC(9.4,164,22,1,"PAH",141,1,7,0)="when the Agency determines that: "
^DIC(9.4,164,22,1,"PAH",141,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,9,0)=" . Certain information is necessary to prevent serious adverse effects "
^DIC(9.4,164,22,1,"PAH",141,1,10,0)=" . Patient decision-making should be advised by information about a known"
^DIC(9.4,164,22,1,"PAH",141,1,11,0)="   serious side effect with a product, or "
^DIC(9.4,164,22,1,"PAH",141,1,12,0)=" . Patient adherence to directions for the use of a product is essential"
^DIC(9.4,164,22,1,"PAH",141,1,13,0)="   to its effectiveness. "
^DIC(9.4,164,22,1,"PAH",141,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,15,0)="The features in the FDA Medication Guides project are being delivered in"
^DIC(9.4,164,22,1,"PAH",141,1,16,0)="incremental releases. This patch is part of the Increment 2 release. The "
^DIC(9.4,164,22,1,"PAH",141,1,17,0)="features included in this release are:"
^DIC(9.4,164,22,1,"PAH",141,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,19,0)=" . Establishment of a Server Repository for FDA Medication Guides within "
^DIC(9.4,164,22,1,"PAH",141,1,20,0)="   the VA network."
^DIC(9.4,164,22,1,"PAH",141,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,22,0)=" . Updates to 900+ entries in the VA PRODUCT file (#50.68) to store the "
^DIC(9.4,164,22,1,"PAH",141,1,23,0)="   corresponding FDA Medication Guide document name will be provided via"
^DIC(9.4,164,22,1,"PAH",141,1,24,0)="   the NDF Monthly Data Update patches."
^DIC(9.4,164,22,1,"PAH",141,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,26,0)=" . Introduction of a PC based Java software component to enable the"
^DIC(9.4,164,22,1,"PAH",141,1,27,0)="   automatic retrieval of an FDA Medication Guide from within VistA. The"
^DIC(9.4,164,22,1,"PAH",141,1,28,0)="   software does not require any direct user interaction. It works as a "
^DIC(9.4,164,22,1,"PAH",141,1,29,0)="   bridge between VistA and the PC where it is installed. The software "
^DIC(9.4,164,22,1,"PAH",141,1,30,0)="   identifies a request from VistA for a specific FDA Medication Guide and"
^DIC(9.4,164,22,1,"PAH",141,1,31,0)="   automatically retrieves it from the Server Repository and displays to the"
^DIC(9.4,164,22,1,"PAH",141,1,32,0)="   user via the Internet Explorer browser. "
^DIC(9.4,164,22,1,"PAH",141,1,33,0)="  "
^DIC(9.4,164,22,1,"PAH",141,1,34,0)=" . Introduction of a new option called Display FDA Medication Guide [PSN MED"
^DIC(9.4,164,22,1,"PAH",141,1,35,0)="   GUIDE] to the National Drug File V. 4.0 application for retrieving and "
^DIC(9.4,164,22,1,"PAH",141,1,36,0)="   displaying the FDA Medication Guide for a specific VA Product."
^DIC(9.4,164,22,1,"PAH",141,1,37,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,38,0)=" . Introduction of new functionality to the Patient Prescription Processing"
^DIC(9.4,164,22,1,"PAH",141,1,39,0)="   [PSO LM BACKDOOR] option in the Outpatient Pharmacy V. 7.0 application"
^DIC(9.4,164,22,1,"PAH",141,1,40,0)="   for retrieving and displaying the FDA Medication Guide for a specific "
^DIC(9.4,164,22,1,"PAH",141,1,41,0)="   prescription."
^DIC(9.4,164,22,1,"PAH",141,1,42,0)="  "
^DIC(9.4,164,22,1,"PAH",141,1,43,0)="Below is a list of all the applications involved in this release along"
^DIC(9.4,164,22,1,"PAH",141,1,44,0)="with their patch number:"
^DIC(9.4,164,22,1,"PAH",141,1,45,0)="  "
^DIC(9.4,164,22,1,"PAH",141,1,46,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,164,22,1,"PAH",141,1,47,0)="   -----------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",141,1,48,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*343"
^DIC(9.4,164,22,1,"PAH",141,1,49,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                      PSN*4*263"
^DIC(9.4,164,22,1,"PAH",141,1,50,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*158"
^DIC(9.4,164,22,1,"PAH",141,1,51,0)="   "
^DIC(9.4,164,22,1,"PAH",141,1,52,0)="The FDA Medication Guides project is expected to complete in three "
^DIC(9.4,164,22,1,"PAH",141,1,53,0)="increments. Among other features, the next Increment will automate the "
^DIC(9.4,164,22,1,"PAH",141,1,54,0)="printing of FDA Medication Guides for prescriptions dispensed by the VA"
^DIC(9.4,164,22,1,"PAH",141,1,55,0)="via Outpatient Pharmacy application when the prescription label is printed."
^DIC(9.4,164,22,1,"PAH",141,1,56,0)="   "
^DIC(9.4,164,22,1,"PAH",141,1,57,0)="The following modifications are included in this patch (PSS*1*158):"
^DIC(9.4,164,22,1,"PAH",141,1,58,0)="   "
^DIC(9.4,164,22,1,"PAH",141,1,59,0)="  1. New Data Dictionary field added to PHARMACY SYSTEM (#59.7) file"
^DIC(9.4,164,22,1,"PAH",141,1,60,0)=" "
^DIC(9.4,164,22,1,"PAH",141,1,61,0)="  A new field called FDA MED GUIDE SERVER URL (#100) is being added to the"
^DIC(9.4,164,22,1,"PAH",141,1,62,0)="  PHARMACY SYSTEM (#59.7) file. This field will be used to store the FDA"
^DIC(9.4,164,22,1,"PAH",141,1,63,0)="  Medication Guide Web server URL which will be used in conjunction with"
^DIC(9.4,164,22,1,"PAH",141,1,64,0)="  the FDA MED GUIDE (#100) field in the VA PRODUCT (#50.68) file to compose"
^DIC(9.4,164,22,1,"PAH",141,1,65,0)="  the complete FDA Medication Guide URL for a specific VA Product entry."
^DIC(9.4,164,22,1,"PAH",141,1,66,0)="  "
^DIC(9.4,164,22,1,"PAH",141,1,67,0)="  2. A post-install routine will run to set this new field with the value"
^DIC(9.4,164,22,1,"PAH",141,1,68,0)="  shown below, which is the current FDA Medication Guides web Server URL:"
^DIC(9.4,164,22,1,"PAH",141,1,69,0)="  "
^DIC(9.4,164,22,1,"PAH",141,1,70,0)="     http://vaww.national.cmop.domain.ext/FDAMedGuides/"
^DIC(9.4,164,22,1,"PAH",141,1,71,0)="  "
^DIC(9.4,164,22,1,"PAH",141,1,72,0)="  Note: Integration Control Registration (ICR) #2613 is being modified to"
^DIC(9.4,164,22,1,"PAH",141,1,73,0)="        include this new field in the list of fields that can be read by"
^DIC(9.4,164,22,1,"PAH",141,1,74,0)="        the National Drug File (NDF) application."
^DIC(9.4,164,22,1,"PAH",142,0)="155 SEQ #143^3110428.161628^17"
^DIC(9.4,164,22,1,"PAH",142,1,0)="^^55^55^3110428"
^DIC(9.4,164,22,1,"PAH",142,1,1,0)="This patch addresses the New Service Request (NSR) #20070434 to prevent"
^DIC(9.4,164,22,1,"PAH",142,1,2,0)="the inadvertent creation of supra-therapeutic possible dosages for high"
^DIC(9.4,164,22,1,"PAH",142,1,3,0)="risk medications during the dosage creation segment of Pharmacy Data"
^DIC(9.4,164,22,1,"PAH",142,1,4,0)="Management and National Drug File (NDF) updates.  The Pharmacy Data"
^DIC(9.4,164,22,1,"PAH",142,1,5,0)="Management V. 1.0 and the National Drug File V. 4.0 were modified"
^DIC(9.4,164,22,1,"PAH",142,1,6,0)="to satisfy the request. The NDF portion is addressed in patch PSN*4*262."
^DIC(9.4,164,22,1,"PAH",142,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,8,0)="This patch has the following enhancements:"
^DIC(9.4,164,22,1,"PAH",142,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,10,0)="1. This enhancement utilizes three new fields that were added to the"
^DIC(9.4,164,22,1,"PAH",142,1,11,0)="   VA PRODUCT file (#50.68) as part of patch PSN*4*261. These fields will"
^DIC(9.4,164,22,1,"PAH",142,1,12,0)="   be used during the Match/Rematch process of the Drug Enter/Edit [PSS"
^DIC(9.4,164,22,1,"PAH",142,1,13,0)="   DRUG ENTER/EDIT] and the Enter/Edit Dosages [PSS EDIT DOSAGES] options"
^DIC(9.4,164,22,1,"PAH",142,1,14,0)="   to determine if possible dosages should be auto- created or not. The"
^DIC(9.4,164,22,1,"PAH",142,1,15,0)="   three fields are:"
^DIC(9.4,164,22,1,"PAH",142,1,16,0)="         - CREATE DEFAULT POSSIBLE DOSAGE field (#40)"
^DIC(9.4,164,22,1,"PAH",142,1,17,0)="         - POSSIBLE DOSAGES TO CREATE field (#41)"
^DIC(9.4,164,22,1,"PAH",142,1,18,0)="         - PACKAGE field (#42)"
^DIC(9.4,164,22,1,"PAH",142,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,20,0)="When CREATE DEFAULT POSSIBLE DOSAGE field (#40) is ""YES"", then the"
^DIC(9.4,164,22,1,"PAH",142,1,21,0)="existing functionality of auto-creating possible dosages will be retained."
^DIC(9.4,164,22,1,"PAH",142,1,22,0)="When this field is ""NO"", it will be used in combination with the value in"
^DIC(9.4,164,22,1,"PAH",142,1,23,0)="POSSIBLE DOSAGES TO CREATE field (#41) to determine the auto-creation of"
^DIC(9.4,164,22,1,"PAH",142,1,24,0)="possible dosages."
^DIC(9.4,164,22,1,"PAH",142,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,26,0)="The following conditions will apply when CREATE DEFAULT POSSIBLE DOSAGE"
^DIC(9.4,164,22,1,"PAH",142,1,27,0)="field (#40) is ""NO"":"
^DIC(9.4,164,22,1,"PAH",142,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,29,0)="   a. If POSSIBLE DOSAGES TO CREATE field (#41) is ""NO"", no possible"
^DIC(9.4,164,22,1,"PAH",142,1,30,0)="      dosages will be auto-created and the following message will be"
^DIC(9.4,164,22,1,"PAH",142,1,31,0)="      displayed:"
^DIC(9.4,164,22,1,"PAH",142,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,33,0)="     ""Due to National Drug File settings no possible dosages were"
^DIC(9.4,164,22,1,"PAH",142,1,34,0)="      auto-created."""
^DIC(9.4,164,22,1,"PAH",142,1,35,0)="   b. If POSSIBLE DOSAGES TO CREATE field (#41) is ""O"", 1x possible dosage"
^DIC(9.4,164,22,1,"PAH",142,1,36,0)="      will be auto-created for the package specified by the new PACKAGE"
^DIC(9.4,164,22,1,"PAH",142,1,37,0)="      field (#42) and the following message will be displayed:"
^DIC(9.4,164,22,1,"PAH",142,1,38,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,39,0)="      ""Due to National Drug File settings only one possible dosage will be"
^DIC(9.4,164,22,1,"PAH",142,1,40,0)="       auto-created."
^DIC(9.4,164,22,1,"PAH",142,1,41,0)="       If other dosages are needed, create POSSIBLE DOSAGES or LOCAL"
^DIC(9.4,164,22,1,"PAH",142,1,42,0)="       POSSIBLE DOSAGES as appropriate."""
^DIC(9.4,164,22,1,"PAH",142,1,43,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,44,0)="   c. If POSSIBLE DOSAGES TO CREATE field (#41) is ""B"", 1x and 2x possible"
^DIC(9.4,164,22,1,"PAH",142,1,45,0)="      dosages will be auto-created for the package specified by the new"
^DIC(9.4,164,22,1,"PAH",142,1,46,0)="      PACKAGE field (#42)."
^DIC(9.4,164,22,1,"PAH",142,1,47,0)=" "
^DIC(9.4,164,22,1,"PAH",142,1,48,0)="2. This patch retires the Auto Create Dosages [PSS DOSAGE CONVERSION]"
^DIC(9.4,164,22,1,"PAH",142,1,49,0)="   option. This option is retired because, if it is run inadvertently, it"
^DIC(9.4,164,22,1,"PAH",142,1,50,0)="   will delete all existing ""Possible Dosages"" and ""Local Possible"
^DIC(9.4,164,22,1,"PAH",142,1,51,0)="   Dosages"" and will re-set the Possible Dosages back to NDF settings. The"
^DIC(9.4,164,22,1,"PAH",142,1,52,0)="   changes that were entered locally by the site for ""Possible Dosages"""
^DIC(9.4,164,22,1,"PAH",142,1,53,0)="   and ""Local Possible Dosages"" will be lost. Upon patch installation,"
^DIC(9.4,164,22,1,"PAH",142,1,54,0)="   this option will be removed from the Dosages [PSS DOSAGES MANAGEMENT]"
^DIC(9.4,164,22,1,"PAH",142,1,55,0)="   menu."
^DIC(9.4,164,22,1,"PAH",143,0)="163^3110812.135831^17"
^DIC(9.4,164,22,1,"PAH",143,1,0)="^^22^22^3110812"
^DIC(9.4,164,22,1,"PAH",143,1,1,0)="This patch makes a change to the interface when order checks are sent from"
^DIC(9.4,164,22,1,"PAH",143,1,2,0)="VistA to the Medication Order Check HealthCare Application (MOCHA). When"
^DIC(9.4,164,22,1,"PAH",143,1,3,0)="Order Checks cannot be performed for any reason, a warning message is "
^DIC(9.4,164,22,1,"PAH",143,1,4,0)="displayed to the user that order checks did not occur. There was an "
^DIC(9.4,164,22,1,"PAH",143,1,5,0)="occurrence reported in a test account where Order Checks did not occur, "
^DIC(9.4,164,22,1,"PAH",143,1,6,0)="but no message was displayed to the user. At the end of all the order"
^DIC(9.4,164,22,1,"PAH",143,1,7,0)="check processing, this patch will add an additional check to see if the"
^DIC(9.4,164,22,1,"PAH",143,1,8,0)="flag that indicates the success or failure of the order checks is set. If"
^DIC(9.4,164,22,1,"PAH",143,1,9,0)="it is not set, it will set the flag that will indicate to the calling"
^DIC(9.4,164,22,1,"PAH",143,1,10,0)="application that the message indicating order checks were not performed be"
^DIC(9.4,164,22,1,"PAH",143,1,11,0)="displayed to the user."
^DIC(9.4,164,22,1,"PAH",143,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",143,1,13,0)="Additionally, any time order checks are sent through the interface for "
^DIC(9.4,164,22,1,"PAH",143,1,14,0)="the PSS INTERFACE SCHEDULER job or as an individual user, certain fields "
^DIC(9.4,164,22,1,"PAH",143,1,15,0)="are required numeric values. Is these fields are not numeric, the "
^DIC(9.4,164,22,1,"PAH",143,1,16,0)="interface request will fail. This patch will check those fields and "
^DIC(9.4,164,22,1,"PAH",143,1,17,0)="substitute a value if necessary. These fields are as follows:"
^DIC(9.4,164,22,1,"PAH",143,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",143,1,19,0)="DUZ (User's internal entry number) - the software will replace with 0."
^DIC(9.4,164,22,1,"PAH",143,1,20,0)="Job Number - the software will replace with 0."
^DIC(9.4,164,22,1,"PAH",143,1,21,0)="Station Number - the software will use the leading numerics, but if"
^DIC(9.4,164,22,1,"PAH",143,1,22,0)="there are no leading numerics, the software will replace with 0."
^DIC(9.4,164,22,1,"PAH",144,0)="149 SEQ #145^3110829.15551^17"
^DIC(9.4,164,22,1,"PAH",144,1,0)="^^11^11^3110829"
^DIC(9.4,164,22,1,"PAH",144,1,1,0)="This patch will correct the issues reported in Remedy Tickets:"
^DIC(9.4,164,22,1,"PAH",144,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",144,1,3,0)="1) HD0000000222760 - Pharmacy standard schedule problem"
^DIC(9.4,164,22,1,"PAH",144,1,4,0)="The use of the @ in the ADMINISTRATION SCHEDULE file #51.1 Name field "
^DIC(9.4,164,22,1,"PAH",144,1,5,0)=".01 with the exception of day-of-week schedules, causes the user to be"
^DIC(9.4,164,22,1,"PAH",144,1,6,0)="locked into a prescription for a 1 time order (reorder)"
^DIC(9.4,164,22,1,"PAH",144,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",144,1,8,0)="2) HD0000000422160 - <UNDEFINED>ENPSJ+6^PSSJSV *X"
^DIC(9.4,164,22,1,"PAH",144,1,9,0)="When using the VistA Standard Schedule Edit[ PSS SCHEDULE EDIT] option and"
^DIC(9.4,164,22,1,"PAH",144,1,10,0)="the user enters a schedule with ""QD"",""QOD"",""HS"",""TIW"" the user is kicked"
^DIC(9.4,164,22,1,"PAH",144,1,11,0)="out of Vista with this error <UNDEFINED>ENPSJ+6^PSSJSV *X."
^DIC(9.4,164,22,1,"PAH",145,0)="159 SEQ #146^3111207.151905^17"
^DIC(9.4,164,22,1,"PAH",145,1,0)="^^55^55^3111207"
^DIC(9.4,164,22,1,"PAH",145,1,1,0)="This enhancement, approved by the Pharmacy Legacy Enhancement (PLE) User"
^DIC(9.4,164,22,1,"PAH",145,1,2,0)="Group, will resolve Patient Safety Issue PSI-08-026/PSPO #852 reported in"
^DIC(9.4,164,22,1,"PAH",145,1,3,0)="Remedy Ticket HD233682."
^DIC(9.4,164,22,1,"PAH",145,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,5,0)="This patch will help mitigate incorrect medication routes being displayed"
^DIC(9.4,164,22,1,"PAH",145,1,6,0)="for selection in the Computerized Patient Record System (CPRS) V. 3.0."
^DIC(9.4,164,22,1,"PAH",145,1,7,0)="This enhancement affects Inpatient Medications unit dose orders, IV Fluids"
^DIC(9.4,164,22,1,"PAH",145,1,8,0)="orders, and Outpatient Pharmacy orders entered via CPRS orders dialog."
^DIC(9.4,164,22,1,"PAH",145,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,10,0)="The pharmacy Integration Control Registration (ICR) #2418 is modified"
^DIC(9.4,164,22,1,"PAH",145,1,11,0)="to return appropriate medication routes for the orderable item (OI) in"
^DIC(9.4,164,22,1,"PAH",145,1,12,0)="CPRS ordering dialog with the following conditions."
^DIC(9.4,164,22,1,"PAH",145,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,14,0)="Note: The fields referenced below are from the PHARMACY ORDERABLE ITEM"
^DIC(9.4,164,22,1,"PAH",145,1,15,0)="      file (#50.7):"
^DIC(9.4,164,22,1,"PAH",145,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,17,0)="  1. ICR Modifications"
^DIC(9.4,164,22,1,"PAH",145,1,18,0)="   - Default Med Route"
^DIC(9.4,164,22,1,"PAH",145,1,19,0)="     It will be derived from the DEFAULT MED ROUTE field (#.06) if it's"
^DIC(9.4,164,22,1,"PAH",145,1,20,0)="     populated or from the POSSIBLE MED ROUTES multiple (#50.711) if it's"
^DIC(9.4,164,22,1,"PAH",145,1,21,0)="     populated with single entry and the USE DOSAGE FORM MED ROUTE LIST"
^DIC(9.4,164,22,1,"PAH",145,1,22,0)="     field (#10) is set to ""NO."""
^DIC(9.4,164,22,1,"PAH",145,1,23,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,24,0)="   - Optional Med Routes"
^DIC(9.4,164,22,1,"PAH",145,1,25,0)="     The medication route selection list in CPRS will be populated with"
^DIC(9.4,164,22,1,"PAH",145,1,26,0)="     entries from the POSSIBLE MED ROUTES multiple (#50.711) if the USE"
^DIC(9.4,164,22,1,"PAH",145,1,27,0)="     DOSAGE FORM MED ROUTE LIST field (#10) is set to ""NO."" Otherwise, it"
^DIC(9.4,164,22,1,"PAH",145,1,28,0)="     will be populated from the medication routes associated with the"
^DIC(9.4,164,22,1,"PAH",145,1,29,0)="     orderable item's dosage form, which is the current logic."
^DIC(9.4,164,22,1,"PAH",145,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,31,0)="  2. The logic for editing the medication route has been modified in the "
^DIC(9.4,164,22,1,"PAH",145,1,32,0)="     following options:"
^DIC(9.4,164,22,1,"PAH",145,1,33,0)="     - Edit Orderable Items [PSS EDIT ORDERABLE ITEMS]"
^DIC(9.4,164,22,1,"PAH",145,1,34,0)="     - Drug Enter/Edit [PSS DRUG ENTER/EDIT]"
^DIC(9.4,164,22,1,"PAH",145,1,35,0)="     - Dispense Drug/Orderable Item Maintenance [PSS MAINTAIN ORDERABLE"
^DIC(9.4,164,22,1,"PAH",145,1,36,0)="       ITEMS]"
^DIC(9.4,164,22,1,"PAH",145,1,37,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,38,0)="     The software will now ensure that the DEFAULT MED ROUTE field (#.06)"
^DIC(9.4,164,22,1,"PAH",145,1,39,0)="     of the PHARMACY ORDERABLE ITEM file (#50.7) is either defined and/or"
^DIC(9.4,164,22,1,"PAH",145,1,40,0)="     at least one entry is defined in the POSSIBLE MED ROUTES multiple"
^DIC(9.4,164,22,1,"PAH",145,1,41,0)="     (#50.711) or the USE DOSAGE FORM MED ROUTE LIST field (#10) is set to"
^DIC(9.4,164,22,1,"PAH",145,1,42,0)="     YES so that the medication route selection during order entry is"
^DIC(9.4,164,22,1,"PAH",145,1,43,0)="     listed appropriately."
^DIC(9.4,164,22,1,"PAH",145,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,45,0)="     Note: This patch will change USE DOSAGE FORM MED ROUTE LIST field"
^DIC(9.4,164,22,1,"PAH",145,1,46,0)="           (#10) of the PHARMACY ORDERABLE ITEM file (#50.7) from not"
^DIC(9.4,164,22,1,"PAH",145,1,47,0)="           required to a required field. In order to use the new"
^DIC(9.4,164,22,1,"PAH",145,1,48,0)="           functionality introduced in this patch, it is imperative that"
^DIC(9.4,164,22,1,"PAH",145,1,49,0)="           the user marks this field YES or NO. This field will be used to"
^DIC(9.4,164,22,1,"PAH",145,1,50,0)="           determine the medication route selection during order entry."
^DIC(9.4,164,22,1,"PAH",145,1,51,0)=" "
^DIC(9.4,164,22,1,"PAH",145,1,52,0)="  3. The Pharmacy System Parameters Edit [PSS SYS EDIT] option is modified"
^DIC(9.4,164,22,1,"PAH",145,1,53,0)="     to remove the DEFAULT MED ROUTE FOR CPRS field (#80.7) of the "
^DIC(9.4,164,22,1,"PAH",145,1,54,0)="     PHARMACY SYSTEM file (#59.7) from the list of fields that can be"
^DIC(9.4,164,22,1,"PAH",145,1,55,0)="     edited."
^DIC(9.4,164,22,1,"PAH",146,0)="168 SEQ #147^3120206.144914^17"
^DIC(9.4,164,22,1,"PAH",146,1,0)="^^22^22^3120206"
^DIC(9.4,164,22,1,"PAH",146,1,1,0)="When calls are made to the Medication Order Check Healthcare Application "
^DIC(9.4,164,22,1,"PAH",146,1,2,0)="(MOCHA), a ""Ping"" type of call is made first to test the communication, "
^DIC(9.4,164,22,1,"PAH",146,1,3,0)="and if that is successful, the subsequent order check call is made. If "
^DIC(9.4,164,22,1,"PAH",146,1,4,0)="either call fails, the process is aborted, and a message is displayed "
^DIC(9.4,164,22,1,"PAH",146,1,5,0)="indicating that order checks cannot be performed."
^DIC(9.4,164,22,1,"PAH",146,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",146,1,7,0)="What this patch introduces is a ""re-try"" if either of these calls fail. "
^DIC(9.4,164,22,1,"PAH",146,1,8,0)="After a three second hang, the call (Ping or order check) will be"
^DIC(9.4,164,22,1,"PAH",146,1,9,0)="attempted again, then if the same call fails a second time, the process"
^DIC(9.4,164,22,1,"PAH",146,1,10,0)="will be aborted with the message indicating that order checks cannot be"
^DIC(9.4,164,22,1,"PAH",146,1,11,0)="performed."
^DIC(9.4,164,22,1,"PAH",146,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",146,1,13,0)="This patch also addresses an issue (in conjunction with patch PSO*7.0*379)"
^DIC(9.4,164,22,1,"PAH",146,1,14,0)="concerning Orderable Items that are flaggeed as Supplies. If an order "
^DIC(9.4,164,22,1,"PAH",146,1,15,0)="check is to be performed on an order that only has an Orderable Item with "
^DIC(9.4,164,22,1,"PAH",146,1,16,0)="no Dispense Drug, an attempt is made to find the best drug available that "
^DIC(9.4,164,22,1,"PAH",146,1,17,0)="is matched to the Orderable Item for the order check. Currently, if the "
^DIC(9.4,164,22,1,"PAH",146,1,18,0)="Orderable Item is marked as a supply, no order checks are performed. But "
^DIC(9.4,164,22,1,"PAH",146,1,19,0)="if the Orderable Item has both Supply and non-Supply Items matched to it, "
^DIC(9.4,164,22,1,"PAH",146,1,20,0)="order checks can possibly be performed on one of the non-supply items. "
^DIC(9.4,164,22,1,"PAH",146,1,21,0)="This patch makes the change to look for non-Supply Items matched to the "
^DIC(9.4,164,22,1,"PAH",146,1,22,0)="supply Orderable Item to perform the order checks on."
^DIC(9.4,164,22,1,"PAH",147,0)="156 SEQ #148^3120307.105012^17"
^DIC(9.4,164,22,1,"PAH",147,1,0)="^^27^27^3120307"
^DIC(9.4,164,22,1,"PAH",147,1,1,0)="This patch is being released as part of Pharmacy Legacy Enhancements Fiscal"
^DIC(9.4,164,22,1,"PAH",147,1,2,0)="Year 2011 to address the Outpatient Pharmacy Automation Interface (OPAI) "
^DIC(9.4,164,22,1,"PAH",147,1,3,0)="Enhancements. The Outpatient Pharmacy patch PSO*7*354 is also being released "
^DIC(9.4,164,22,1,"PAH",147,1,4,0)="as part of this enhancement."
^DIC(9.4,164,22,1,"PAH",147,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",147,1,6,0)="Veterans Affairs Medical Center (VAMC) facilities have moved to using multiple"
^DIC(9.4,164,22,1,"PAH",147,1,7,0)="vendors for automated medication dispensing systems to improve the efficiency"
^DIC(9.4,164,22,1,"PAH",147,1,8,0)="of outpatient pharmacy operations. The following enhancements were made to "
^DIC(9.4,164,22,1,"PAH",147,1,9,0)="the Pharmacy Data Management software to allow any one division to have more "
^DIC(9.4,164,22,1,"PAH",147,1,10,0)="than one Automated Dispensing Device (ADD) communicating with Veterans Health "
^DIC(9.4,164,22,1,"PAH",147,1,11,0)="Information Systems and Technology Architecture (VistA) through OPAI."
^DIC(9.4,164,22,1,"PAH",147,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",147,1,13,0)="1.A new OPAI sub-file (#50.0906) was added to the DRUG file (#50). It gives"
^DIC(9.4,164,22,1,"PAH",147,1,14,0)="  sites the flexibility to define ADDs at the drug level. The sub-file "
^DIC(9.4,164,22,1,"PAH",147,1,15,0)="  (#50.0906) contains the following new fields:  "
^DIC(9.4,164,22,1,"PAH",147,1,16,0)="     DIVISION  - This is the division associated with the ADD for the drug."
^DIC(9.4,164,22,1,"PAH",147,1,17,0)="                 This field is a pointer to the OUTPATIENT SITE file (#59)."
^DIC(9.4,164,22,1,"PAH",147,1,18,0)="     WINDOW    - This field is a pointer to the PHARMACY AUTOMATED DISPENSING"
^DIC(9.4,164,22,1,"PAH",147,1,19,0)="      DNS NAME   DEVICES file (#52.53). Orders with a route of WINDOW will be"
^DIC(9.4,164,22,1,"PAH",147,1,20,0)="                 sent to this ADD."
^DIC(9.4,164,22,1,"PAH",147,1,21,0)="     MAIL      - This field is a pointer to the PHARMACY AUTOMATED DISPENSING"
^DIC(9.4,164,22,1,"PAH",147,1,22,0)="      DNS NAME   DEVICES file (#52.53). Orders with a route of MAIL will be"
^DIC(9.4,164,22,1,"PAH",147,1,23,0)="                 sent to this ADD."
^DIC(9.4,164,22,1,"PAH",147,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",147,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",147,1,26,0)="2.  The Drug Enter/Edit [PSS DRUG ENTER/EDIT] option was modified to include"
^DIC(9.4,164,22,1,"PAH",147,1,27,0)="    the new fields as part of data entry."
^DIC(9.4,164,22,1,"PAH",148,0)="167 SEQ #149^3120430.114129^17"
^DIC(9.4,164,22,1,"PAH",148,1,0)="^^34^34^3120430"
^DIC(9.4,164,22,1,"PAH",148,1,1,0)=" This patch is an enhancement patch. It will create five (5) new security"
^DIC(9.4,164,22,1,"PAH",148,1,2,0)=" keys. They will be used to authenticate users using Kernel Authentication"
^DIC(9.4,164,22,1,"PAH",148,1,3,0)=" & Authorization for J2EE (KAAJEE). Users using the Pharmacy Product System-"
^DIC(9.4,164,22,1,"PAH",148,1,4,0)=" National (PPS-N) should be assigned these keys after installing this patch."
^DIC(9.4,164,22,1,"PAH",148,1,5,0)=" PPS-N is a new development effort underway, which is a re-engineered"
^DIC(9.4,164,22,1,"PAH",148,1,6,0)=" product to eventually replace the National Drug File Management System"
^DIC(9.4,164,22,1,"PAH",148,1,7,0)=" (NDFMS). No routines are included in this patch."
^DIC(9.4,164,22,1,"PAH",148,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,10,0)="This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",148,1,11,0)="----------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",148,1,12,0)="There are no Remedy tickets associated with this patch."
^DIC(9.4,164,22,1,"PAH",148,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,14,0)="Associated PSIs: "
^DIC(9.4,164,22,1,"PAH",148,1,15,0)="----------------"
^DIC(9.4,164,22,1,"PAH",148,1,16,0)="N/A "
^DIC(9.4,164,22,1,"PAH",148,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,18,0)="Overview of Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",148,1,19,0)="-----------------------------"
^DIC(9.4,164,22,1,"PAH",148,1,20,0)="N/A"
^DIC(9.4,164,22,1,"PAH",148,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,22,0)="Components Exported With Patch: "
^DIC(9.4,164,22,1,"PAH",148,1,23,0)="-------------------------------"
^DIC(9.4,164,22,1,"PAH",148,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,26,0)="The following is a list of Security Keys included in this patch:"
^DIC(9.4,164,22,1,"PAH",148,1,27,0)=" "
^DIC(9.4,164,22,1,"PAH",148,1,28,0)="Security Key Name               Action"
^DIC(9.4,164,22,1,"PAH",148,1,29,0)="-------------------             -------"
^DIC(9.4,164,22,1,"PAH",148,1,30,0)="PSS_PPSN_MANAGER                SEND TO SITE"
^DIC(9.4,164,22,1,"PAH",148,1,31,0)="PSS_PPSN_MIGRATOR               SEND TO SITE"
^DIC(9.4,164,22,1,"PAH",148,1,32,0)="PSS_PPSN_SECOND-APPROVER        SEND TO SITE"
^DIC(9.4,164,22,1,"PAH",148,1,33,0)="PSS_PPSN_SUPERVISOR             SEND TO SITE"
^DIC(9.4,164,22,1,"PAH",148,1,34,0)="PSS_PPSN_VIEWER                 SEND TO SITE"
^DIC(9.4,164,22,1,"PAH",149,0)="146 SEQ #150^3120829.111323^17"
^DIC(9.4,164,22,1,"PAH",149,1,0)="^^85^85^3120829"
^DIC(9.4,164,22,1,"PAH",149,1,1,0)="This patch corrects a patient safety issue in which editing the IV "
^DIC(9.4,164,22,1,"PAH",149,1,2,0)="ADDITIVES file (#52.6) and/or IV SOLUTIONS file (#52.7) using the Drug"
^DIC(9.4,164,22,1,"PAH",149,1,3,0)="Enter/Edit [PSS DRUG ENTER/EDIT] option is problematic. The current"
^DIC(9.4,164,22,1,"PAH",149,1,4,0)="functionality needs to be changed to prevent erroneous matching with"
^DIC(9.4,164,22,1,"PAH",149,1,5,0)="Dispense Drugs. It is very easy to select the wrong item and incorrectly"
^DIC(9.4,164,22,1,"PAH",149,1,6,0)="change the PRINT NAME field (#.01) of the additives or solutions files."
^DIC(9.4,164,22,1,"PAH",149,1,7,0)="Also, once an additive or solution is selected, it is unclear as to"
^DIC(9.4,164,22,1,"PAH",149,1,8,0)="whether or not the user is still selecting or editing."
^DIC(9.4,164,22,1,"PAH",149,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,10,0)="This process has been enhanced by displaying the previously entered Print"
^DIC(9.4,164,22,1,"PAH",149,1,11,0)="Name as the default if only one is entered."
^DIC(9.4,164,22,1,"PAH",149,1,12,0)="  Example:"
^DIC(9.4,164,22,1,"PAH",149,1,13,0)="    +------------------------------------------------------------+"
^DIC(9.4,164,22,1,"PAH",149,1,14,0)="    |    Select IV ADDITIVES PRINT NAME: ADDITIVE1//             |"
^DIC(9.4,164,22,1,"PAH",149,1,15,0)="    +------------------------------------------------------------+"
^DIC(9.4,164,22,1,"PAH",149,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,17,0)="If more than one Print Name were previously entered, the software will"
^DIC(9.4,164,22,1,"PAH",149,1,18,0)="display the list of all linked Additives and/or Solutions to select from"
^DIC(9.4,164,22,1,"PAH",149,1,19,0)="so an edit may be made. Example:"
^DIC(9.4,164,22,1,"PAH",149,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,21,0)="  Example:"
^DIC(9.4,164,22,1,"PAH",149,1,22,0)="    +------------------------------------------------------------+     "
^DIC(9.4,164,22,1,"PAH",149,1,23,0)="    | <DRUG NAME> currently linked to the following IV Additives:|"
^DIC(9.4,164,22,1,"PAH",149,1,24,0)="    |                                                            |"
^DIC(9.4,164,22,1,"PAH",149,1,25,0)="    |       1. ADDITIVE1                                         |"
^DIC(9.4,164,22,1,"PAH",149,1,26,0)="    |       2. ADDITIVE2                                         |"
^DIC(9.4,164,22,1,"PAH",149,1,27,0)="    |                                                            |"
^DIC(9.4,164,22,1,"PAH",149,1,28,0)="    |    Select 1-2 from list above or type 'NEW' to link        |"
^DIC(9.4,164,22,1,"PAH",149,1,29,0)="    |    to a new IV Additive:                                   |"
^DIC(9.4,164,22,1,"PAH",149,1,30,0)="    +------------------------------------------------------------+"
^DIC(9.4,164,22,1,"PAH",149,1,31,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,32,0)="The new enhancement will also allow the user to enter a new Additive or"
^DIC(9.4,164,22,1,"PAH",149,1,33,0)="Solution and link it to the dispense drug. The software will give the user"
^DIC(9.4,164,22,1,"PAH",149,1,34,0)="the choice to enter and link the dispense drug to a new Additive or"
^DIC(9.4,164,22,1,"PAH",149,1,35,0)="Solution as well as require a confirmation of the selected dispense drug"
^DIC(9.4,164,22,1,"PAH",149,1,36,0)="that will be linked to the selected Additive/Solution. "
^DIC(9.4,164,22,1,"PAH",149,1,37,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,38,0)="  Example (Create new IV Additive and link to drug):"
^DIC(9.4,164,22,1,"PAH",149,1,39,0)="  +--------------------------------------------------------------------+"
^DIC(9.4,164,22,1,"PAH",149,1,40,0)="  | <DRUG NAME> currently linked to the following IV Additives:        |"
^DIC(9.4,164,22,1,"PAH",149,1,41,0)="  |                                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,42,0)="  |    1. ADDITIVE1                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,43,0)="  |    2. ADDITIVE2                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,44,0)="  |                                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,45,0)="  |    Select 1-2 from list above or type 'NEW' to link                |"
^DIC(9.4,164,22,1,"PAH",149,1,46,0)="  |    to a new IV Additive: NEW                                       |"
^DIC(9.4,164,22,1,"PAH",149,1,47,0)="  |                                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,48,0)="  | Select IV ADDITIVES PRINT NAME: TEST                               |"
^DIC(9.4,164,22,1,"PAH",149,1,49,0)="  |   Are you adding 'TEST' as a new IV ADDITIVES (the 33RD)? No// Yes |"
^DIC(9.4,164,22,1,"PAH",149,1,50,0)="  | IV ADDITIVES DRUG UNIT: GM  GM                                     |"
^DIC(9.4,164,22,1,"PAH",149,1,51,0)="  | PRINT NAME: TEST//                                                 |"
^DIC(9.4,164,22,1,"PAH",149,1,52,0)="  | Select DRUG GENERIC NAME: CEFAMANDOLE 1GM INJ//  AM116             |"
^DIC(9.4,164,22,1,"PAH",149,1,53,0)="  | ARE YOU SURE YOU WANT TO SELECT CEFAMANDOLE 1GM INJ? No// Y  (Yes) |"
^DIC(9.4,164,22,1,"PAH",149,1,54,0)="  | ...                                                                |"
^DIC(9.4,164,22,1,"PAH",149,1,55,0)="  |                                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,56,0)="  | <DRUG NAME> currently linked to the following IV Additives:        |"
^DIC(9.4,164,22,1,"PAH",149,1,57,0)="  |                                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,58,0)="  |    1. ADDITIVE1                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,59,0)="  |    2. ADDITIVE2                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,60,0)="  |    3. TEST                                                         |"
^DIC(9.4,164,22,1,"PAH",149,1,61,0)="  |                                                                    |"
^DIC(9.4,164,22,1,"PAH",149,1,62,0)="  |    Select 1-3 from list above or type 'NEW' to link                |"
^DIC(9.4,164,22,1,"PAH",149,1,63,0)="  |    to a new IV Additive: NEW                                       |"
^DIC(9.4,164,22,1,"PAH",149,1,64,0)="  +--------------------------------------------------------------------+"
^DIC(9.4,164,22,1,"PAH",149,1,65,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,66,0)="The new enhancement will also create the new sub-menu Inpatient Drug "
^DIC(9.4,164,22,1,"PAH",149,1,67,0)="Management [PSS INP MGR]. This sub-menu will be located under the "
^DIC(9.4,164,22,1,"PAH",149,1,68,0)="Pharmacy Data Management [PSS MGR] menu and will include the following "
^DIC(9.4,164,22,1,"PAH",149,1,69,0)="options:"
^DIC(9.4,164,22,1,"PAH",149,1,70,0)=" - ADditives File [PSSJI DRUG]"
^DIC(9.4,164,22,1,"PAH",149,1,71,0)=" - Dispense Drug Fields [PSSJU DRG]"
^DIC(9.4,164,22,1,"PAH",149,1,72,0)=" - Dispense Drug/ATC Set Up [PSSJU DRUG/ATC SET UP]"
^DIC(9.4,164,22,1,"PAH",149,1,73,0)=" - Edit Cost Data [PSSJU DCC]"
^DIC(9.4,164,22,1,"PAH",149,1,74,0)=" - EDit Drug Cost (IV) [PSSJI EDIT DRUG COST]"
^DIC(9.4,164,22,1,"PAH",149,1,75,0)=" - MARk/Unmark Dispense Drugs For Unit Dose [PSSJU MARK UD ITEMS]"
^DIC(9.4,164,22,1,"PAH",149,1,76,0)=" - PRimary Solution File (IV) [PSSJI SOLN]"
^DIC(9.4,164,22,1,"PAH",149,1,77,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,78,0)=" "
^DIC(9.4,164,22,1,"PAH",149,1,79,0)="In addition to these enhancements, an unrelated defect that was discovered"
^DIC(9.4,164,22,1,"PAH",149,1,80,0)="with the PSSIV ADD Input Template during testing was corrected in this "
^DIC(9.4,164,22,1,"PAH",149,1,81,0)="patch. The error prevented valid ADMINISTRATION TIMES from being "
^DIC(9.4,164,22,1,"PAH",149,1,82,0)="associated with the IV ADDITIVE as well as QUICK CODES associated with "
^DIC(9.4,164,22,1,"PAH",149,1,83,0)="the IV ADDITIVE. The error was addressed by correctly validating the "
^DIC(9.4,164,22,1,"PAH",149,1,84,0)="ADMINISTRATION TIMES fields using the same validation as is used in the "
^DIC(9.4,164,22,1,"PAH",149,1,85,0)="ADMINISTRATION SCHEDULE file (#51.1)."
^DIC(9.4,164,22,1,"PAH",150,0)="171 SEQ #151^3120912.162559^17"
^DIC(9.4,164,22,1,"PAH",150,1,0)="^^56^56^3120912"
^DIC(9.4,164,22,1,"PAH",150,1,1,0)="Special Instructions/Other Print Info"
^DIC(9.4,164,22,1,"PAH",150,1,2,0)="________________________________________"
^DIC(9.4,164,22,1,"PAH",150,1,3,0)="With this enhancement, Special Instructions and Other Print Info have been"
^DIC(9.4,164,22,1,"PAH",150,1,4,0)="modified to support an unlimited amount of text. The existing"
^DIC(9.4,164,22,1,"PAH",150,1,5,0)="functionality that copies the provider comments from the Computerized"
^DIC(9.4,164,22,1,"PAH",150,1,6,0)="Patient Record System (CPRS) to be copied into each field has been"
^DIC(9.4,164,22,1,"PAH",150,1,7,0)="retained, and an additional action has been added to optionally open a"
^DIC(9.4,164,22,1,"PAH",150,1,8,0)="word processing edit dialog after copying the provider comments into the"
^DIC(9.4,164,22,1,"PAH",150,1,9,0)="appropriate field (Special Instructions for Unit Dose, Other Print Info"
^DIC(9.4,164,22,1,"PAH",150,1,10,0)="for IV)."
^DIC(9.4,164,22,1,"PAH",150,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,12,0)="Special Instructions and Other Print Info may also be entered"
^DIC(9.4,164,22,1,"PAH",150,1,13,0)="and/or edited from within Inpatient Medications V. 5.0 order entry"
^DIC(9.4,164,22,1,"PAH",150,1,14,0)="options."
^DIC(9.4,164,22,1,"PAH",150,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,16,0)="Prior to this enhancement, Inpatient Medications maximum character"
^DIC(9.4,164,22,1,"PAH",150,1,17,0)="length for Special Instructions was 180 characters and for Other Print"
^DIC(9.4,164,22,1,"PAH",150,1,18,0)="Info the maximum length was 60 characters. This enhancement resolves"
^DIC(9.4,164,22,1,"PAH",150,1,19,0)="Patient Safety Issues PSPO 42, 1466 / Remedy Ticket HD336419"
^DIC(9.4,164,22,1,"PAH",150,1,20,0)="- Comment lengths between CPRS and Pharmacy."
^DIC(9.4,164,22,1,"PAH",150,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,22,0)="No Allergy Assessment"
^DIC(9.4,164,22,1,"PAH",150,1,23,0)="________________________"
^DIC(9.4,164,22,1,"PAH",150,1,24,0)="The No Allergy Assessment enhancement provides an interactive alert to the"
^DIC(9.4,164,22,1,"PAH",150,1,25,0)="pharmacist in Inpatient Medications V. 5.0 when no allergy assessment is"
^DIC(9.4,164,22,1,"PAH",150,1,26,0)="on file for the patient, and a method for the pharmacist to enter an"
^DIC(9.4,164,22,1,"PAH",150,1,27,0)="allergy assessment after receiving the alert.  A pharmacy intervention"
^DIC(9.4,164,22,1,"PAH",150,1,28,0)="is automatically created if the pharmacist chooses to not enter an"
^DIC(9.4,164,22,1,"PAH",150,1,29,0)="assessment."
^DIC(9.4,164,22,1,"PAH",150,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,31,0)="The No Allergy Assessment functionality will be available at the"
^DIC(9.4,164,22,1,"PAH",150,1,32,0)="following options:"
^DIC(9.4,164,22,1,"PAH",150,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,34,0)="Delete Orders [PSJI DELETE ORDER]"
^DIC(9.4,164,22,1,"PAH",150,1,35,0)="Inpatient Order Entry [PSJ OE]"
^DIC(9.4,164,22,1,"PAH",150,1,36,0)="Non-Verified/Pending Orders [PSJU VBW]"
^DIC(9.4,164,22,1,"PAH",150,1,37,0)="Order Entry [PSJU NE]"
^DIC(9.4,164,22,1,"PAH",150,1,38,0)="Order Entry (IV) [PSJI ORDER]"
^DIC(9.4,164,22,1,"PAH",150,1,39,0)="Profile (IV) [PSJI PROFILE]"
^DIC(9.4,164,22,1,"PAH",150,1,40,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,41,0)="When a patient with no allergy assessment is selected from one of the"
^DIC(9.4,164,22,1,"PAH",150,1,42,0)="affected options, the following message will be displayed to the"
^DIC(9.4,164,22,1,"PAH",150,1,43,0)="pharmacist:"
^DIC(9.4,164,22,1,"PAH",150,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,45,0)="""NO ALLERGY ASSESSMENT exists for this patient! Would you like to enter"
^DIC(9.4,164,22,1,"PAH",150,1,46,0)="one now?"""
^DIC(9.4,164,22,1,"PAH",150,1,47,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,48,0)=" - If the pharmacist enters 'YES' at this prompt, they are prompted"
^DIC(9.4,164,22,1,"PAH",150,1,49,0)="   for allergy information."
^DIC(9.4,164,22,1,"PAH",150,1,50,0)=" - If the pharmacist enters 'NO' at this prompt, a pharmacist intervention"
^DIC(9.4,164,22,1,"PAH",150,1,51,0)="   is created, with a type of 'NO ALLERGY ASSESSMENT'. The pharmacist is"
^DIC(9.4,164,22,1,"PAH",150,1,52,0)="   then prompted for Provider and Recommendation. A new Recommendation,"
^DIC(9.4,164,22,1,"PAH",150,1,53,0)="   'UNABLE TO ASSESS', has been created specifically  for this type of"
^DIC(9.4,164,22,1,"PAH",150,1,54,0)="   intervention."
^DIC(9.4,164,22,1,"PAH",150,1,55,0)=" "
^DIC(9.4,164,22,1,"PAH",150,1,56,0)="This enhancement will address Patient Safety Issue PSPO 445."
^DIC(9.4,164,22,1,"PAH",151,0)="164 SEQ #152^3130212.103822^17"
^DIC(9.4,164,22,1,"PAH",151,1,0)="^^36^36^3130212"
^DIC(9.4,164,22,1,"PAH",151,1,1,0)=" This patch makes three enhancements to Pharmacy Data Management (PDM)"
^DIC(9.4,164,22,1,"PAH",151,1,2,0)=" and re-introduces an option from PSS*1*129 as a ""stand alone"" option:"
^DIC(9.4,164,22,1,"PAH",151,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",151,1,4,0)=" The first enhancement adds a new menu option under the menu option"
^DIC(9.4,164,22,1,"PAH",151,1,5,0)=" entitled ""PEPS Services"" [PSS PEPS SERVICES]. This new option is entitled"
^DIC(9.4,164,22,1,"PAH",151,1,6,0)=" ""Print Interface Data File"" [PSS VENDOR INTERFACE REPORT]. This report"
^DIC(9.4,164,22,1,"PAH",151,1,7,0)=" prints entries from the VENDOR INTERFACE DATA file (#59.74). The user is"
^DIC(9.4,164,22,1,"PAH",151,1,8,0)=" asked for a date/time range and the report is sorted by the most recent"
^DIC(9.4,164,22,1,"PAH",151,1,9,0)=" downtime first."
^DIC(9.4,164,22,1,"PAH",151,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",151,1,11,0)=" The second enhancement is a change to the menu option entitled"
^DIC(9.4,164,22,1,"PAH",151,1,12,0)=" ""Print PEPS Services Setup"" {PSS CHECK PEPS SERVICES SETUP]. Additional"
^DIC(9.4,164,22,1,"PAH",151,1,13,0)=" functionality is provided to the user with a device prompt to send the"
^DIC(9.4,164,22,1,"PAH",151,1,14,0)=" output to a printer device or they may choose to print to the screen."
^DIC(9.4,164,22,1,"PAH",151,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",151,1,16,0)=" The third enhancement deals with the way entries in the DOSE UNITS file"
^DIC(9.4,164,22,1,"PAH",151,1,17,0)=" (#51.24) are displayed. Some of the entries in this file are composed"
^DIC(9.4,164,22,1,"PAH",151,1,18,0)=" of TallMan lettering (mixed case). Under the menu option entitled"
^DIC(9.4,164,22,1,"PAH",151,1,19,0)=" ""Request Change to Dose Unit"" [PSS DOSE UNIT REQUEST], if a user"
^DIC(9.4,164,22,1,"PAH",151,1,20,0)=" requests a change to an entry that is composed of Tallman lettering,"
^DIC(9.4,164,22,1,"PAH",151,1,21,0)=" previously, these entries did not collate as desired. Any entry"
^DIC(9.4,164,22,1,"PAH",151,1,22,0)=" composed of TallMan lettering is converted to uppercase when doing the"
^DIC(9.4,164,22,1,"PAH",151,1,23,0)=" lookup so that alphabetic sorting is maintained while still preserving"
^DIC(9.4,164,22,1,"PAH",151,1,24,0)=" Ta1lMan lettering. A Post-Install routine PSS164P is included to re-index"
^DIC(9.4,164,22,1,"PAH",151,1,25,0)=" the DOSE UNITS file (#51.24)."
^DIC(9.4,164,22,1,"PAH",151,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",151,1,27,0)=" The option ""Find Unmapped Local Possible Dosages"" [PSS LOCAL DOSAGES"
^DIC(9.4,164,22,1,"PAH",151,1,28,0)=" EDIT ALL] is exported and re-introduced as a ""stand alone"" option. The"
^DIC(9.4,164,22,1,"PAH",151,1,29,0)=" option loops through all Local Possible Dosages, identifies entries"
^DIC(9.4,164,22,1,"PAH",151,1,30,0)=" eligible for dosage checks that do not have data in the new Dose Unit"
^DIC(9.4,164,22,1,"PAH",151,1,31,0)=" and Numeric Dose fields, and prompts for data entry into these fields."
^DIC(9.4,164,22,1,"PAH",151,1,32,0)=" It was purposely deleted with the install of MOCHA V1.0. It was thought"
^DIC(9.4,164,22,1,"PAH",151,1,33,0)=" that it was no longer needed. It is being exported at the request of"
^DIC(9.4,164,22,1,"PAH",151,1,34,0)=" the sites. It was found that some had not fully mapped their dosages"
^DIC(9.4,164,22,1,"PAH",151,1,35,0)=" completely and have since added new drugs to DRUG file (#50) as well"
^DIC(9.4,164,22,1,"PAH",151,1,36,0)=" as have unmatched some drugs to National Drug File (NDF)."
^DIC(9.4,164,22,1,"PAH",152,0)="169 SEQ #153^3130212.103829^17"
^DIC(9.4,164,22,1,"PAH",153,0)="150 SEQ #154^3130327.150424^17"
^DIC(9.4,164,22,1,"PAH",153,1,0)="^^8^8^3130327"
^DIC(9.4,164,22,1,"PAH",153,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,164,22,1,"PAH",153,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",153,1,3,0)=" Update the calculation for slashed dosages in outpatient pharmacy by "
^DIC(9.4,164,22,1,"PAH",153,1,4,0)=" correctly calculating duration in reation to dosage."
^DIC(9.4,164,22,1,"PAH",153,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",153,1,6,0)=" Prevent display of non-editable field IV FLAG (#.03) in the PHARMACY "
^DIC(9.4,164,22,1,"PAH",153,1,7,0)=" ORDERABLE ITEM FILE (#50.7) from displaying when attempting to edit "
^DIC(9.4,164,22,1,"PAH",153,1,8,0)=" via fileman."
^DIC(9.4,164,22,1,"PAH",154,0)="166^3130614.090129^17"
^DIC(9.4,164,22,1,"PAH",154,1,0)="^^40^40^3130614"
^DIC(9.4,164,22,1,"PAH",154,1,1,0)="This patch is being released as part of the DEA e-Prescribing of "
^DIC(9.4,164,22,1,"PAH",154,1,2,0)="Controlled Substances (CS) project using Public Key Infrastructure (PKI)"
^DIC(9.4,164,22,1,"PAH",154,1,3,0)="to satisfy requirements requested by the Drug Enforcement Administration"
^DIC(9.4,164,22,1,"PAH",154,1,4,0)="(DEA)."
^DIC(9.4,164,22,1,"PAH",154,1,5,0)="The applications involved in this project along with their patch numbers "
^DIC(9.4,164,22,1,"PAH",154,1,6,0)="are listed below and the same order should be followed when installing "
^DIC(9.4,164,22,1,"PAH",154,1,7,0)="the patches."
^DIC(9.4,164,22,1,"PAH",154,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,9,0)="   APPLICATION                                            PATCH"
^DIC(9.4,164,22,1,"PAH",154,1,10,0)="   -----------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",154,1,11,0)="   KERNEL V. 8.0                                          XU*8*580"
^DIC(9.4,164,22,1,"PAH",154,1,12,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                  PSS*1*166"
^DIC(9.4,164,22,1,"PAH",154,1,13,0)="   COMPUTERIZED PATIENT RECORD SYSTEM (CPRS) V. 3.0       OR*3*306"
^DIC(9.4,164,22,1,"PAH",154,1,14,0)="   CONTROLLED SUBSTANCES (CS) V. 3.0                      PSD*3*73"
^DIC(9.4,164,22,1,"PAH",154,1,15,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                        PSO*7*391"
^DIC(9.4,164,22,1,"PAH",154,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,17,0)="Note: Patches PSO*7*391 and PSD*3*73 will be released in the Kernel "
^DIC(9.4,164,22,1,"PAH",154,1,18,0)="      Installation and Distribution System (KIDS) multi-build distribution"
^DIC(9.4,164,22,1,"PAH",154,1,19,0)="      CPRSV29_PSO_PSD."
^DIC(9.4,164,22,1,"PAH",154,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,21,0)="This is the Pharmacy Data Management patch (PSS*1*166) that provides"
^DIC(9.4,164,22,1,"PAH",154,1,22,0)="the following enhancements and will be in the KIDS distribution PSS_1_166."
^DIC(9.4,164,22,1,"PAH",154,1,23,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,24,0)="1. This patch modifies Integration Control Registration (ICR) #3737 by"
^DIC(9.4,164,22,1,"PAH",154,1,25,0)="   adding the following two new Application Programming Interface (API):"
^DIC(9.4,164,22,1,"PAH",154,1,26,0)="   a. The API $$DETOX^PSSOPKI will return a ""1"" (one) if the drug name "
^DIC(9.4,164,22,1,"PAH",154,1,27,0)="      contains ""BUPREN"", a detoxification drug or a ""0"" (zero) otherwise."
^DIC(9.4,164,22,1,"PAH",154,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,29,0)="   b. The API $$OIDETOX^PSSOPKI is provided to CPRS to determine"
^DIC(9.4,164,22,1,"PAH",154,1,30,0)="   whether an orderable item has an associated detoxification drug."
^DIC(9.4,164,22,1,"PAH",154,1,31,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,32,0)="2. This patch modifies ICR #3784 - API $$IVDEA^PSSUTIL1 to return the "
^DIC(9.4,164,22,1,"PAH",154,1,33,0)="   specific CS FEDERAL SCHEDULE field (#19) code of the VA PRODUCT file"
^DIC(9.4,164,22,1,"PAH",154,1,34,0)="   (#50.68) or the specific DEA, SPECIAL HDLG field (#3) code of the DRUG"
^DIC(9.4,164,22,1,"PAH",154,1,35,0)="   file (#50) of the drugs tied to the Orderable Item."
^DIC(9.4,164,22,1,"PAH",154,1,36,0)=" "
^DIC(9.4,164,22,1,"PAH",154,1,37,0)="3. Patch PSS*1*159 introduced an issue where the user was prevented from"
^DIC(9.4,164,22,1,"PAH",154,1,38,0)="   up-arrowing (^) to quit out of the template in the Edit Orderable Items"
^DIC(9.4,164,22,1,"PAH",154,1,39,0)="   [PSS EDIT ORDERABLE ITEMS] option. This patch resolves that issue by"
^DIC(9.4,164,22,1,"PAH",154,1,40,0)="   allowing the user to up-arrow out of the template."
^DIC(9.4,164,22,1,"PAH",155,0)="176 SEQ #156^3130911.115015^17"
^DIC(9.4,164,22,1,"PAH",155,1,0)="^^15^15^3130911"
^DIC(9.4,164,22,1,"PAH",155,1,1,0)="This patch will correct the issues reported in:"
^DIC(9.4,164,22,1,"PAH",155,1,2,0)="INC000000607659 - Incorrect Drug Cost in Outpt Rx Clean up need"
^DIC(9.4,164,22,1,"PAH",155,1,3,0)="Incorrect drug costs in Outpatient Pharmacy associated with the National"
^DIC(9.4,164,22,1,"PAH",155,1,4,0)="Drug Class (NDC)"
^DIC(9.4,164,22,1,"PAH",155,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",155,1,6,0)="When a prescription is released, the multiple, NDC BY OUTPATIENT SITE "
^DIC(9.4,164,22,1,"PAH",155,1,7,0)="(#50.032) in the DRUG file (#50) is getting stored.  Only the drugs that"
^DIC(9.4,164,22,1,"PAH",155,1,8,0)="are E-PAYABLE should have this multiple stored in the DRUG file. "
^DIC(9.4,164,22,1,"PAH",155,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",155,1,10,0)="INC000000720652 - Audit File/Drug File Issue"
^DIC(9.4,164,22,1,"PAH",155,1,11,0)="The DRUG file (#50) uses a cross-reference trigger to update the PRICE PER"
^DIC(9.4,164,22,1,"PAH",155,1,12,0)="DISPENSE UNIT field (#16) whenever the PRICE PER ORDER UNIT field (#13)"
^DIC(9.4,164,22,1,"PAH",155,1,13,0)="and/or the DISPENSE UNITS PER ORDER UNIT field (#15) are changed.  These"
^DIC(9.4,164,22,1,"PAH",155,1,14,0)="cross-reference triggers are currently configured incorrectly and when "
^DIC(9.4,164,22,1,"PAH",155,1,15,0)="sites turn auditing on for these fields no data is collected."
^DIC(9.4,164,22,1,"PAH",156,0)="174 SEQ #157^3131203.152343^17"
^DIC(9.4,164,22,1,"PAH",156,1,0)="^^233^233^3131203"
^DIC(9.4,164,22,1,"PAH",156,1,1,0)="This patch will address Patient Safety Issue PSPO00001088 and"
^DIC(9.4,164,22,1,"PAH",156,1,2,0)="New Service Request (NSR) 20110308 as well as defects introduced"
^DIC(9.4,164,22,1,"PAH",156,1,3,0)="by patch PSS*1.0*146."
^DIC(9.4,164,22,1,"PAH",156,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,5,0)="1) When adding a new IV Additive to the IV ADDITIVES File (#52.6),"
^DIC(9.4,164,22,1,"PAH",156,1,6,0)="and the user is at the GENERIC DRUG prompt, there is no way"
^DIC(9.4,164,22,1,"PAH",156,1,7,0)="to exit from the prompt. The input does not allow the user"
^DIC(9.4,164,22,1,"PAH",156,1,8,0)="to use the caret (^) to exit. The code that was modified"
^DIC(9.4,164,22,1,"PAH",156,1,9,0)="in routine PSSVIDRG for patch PSS*1.0*146 changed the code"
^DIC(9.4,164,22,1,"PAH",156,1,10,0)="at the GENERIC DRUG prompt and introduced this issue.  Patch"
^DIC(9.4,164,22,1,"PAH",156,1,11,0)="PSS*1.0*174 will fix this problem by properly allowing the"
^DIC(9.4,164,22,1,"PAH",156,1,12,0)="user to exit the GENERIC DRUG prompt by using the caret (^)."
^DIC(9.4,164,22,1,"PAH",156,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,14,0)="2) Another issue addressed with this patch is the wording when the"
^DIC(9.4,164,22,1,"PAH",156,1,15,0)="User is linking an IV Additive to a Generic Drug at the "
^DIC(9.4,164,22,1,"PAH",156,1,16,0)="GENERIC DRUG prompt in menu option ADditives File [PSSJI DRUG].  It was"
^DIC(9.4,164,22,1,"PAH",156,1,17,0)="unclear which drug name was the Additive and which was the"
^DIC(9.4,164,22,1,"PAH",156,1,18,0)="Generic Drug when selecting.  This patch will remove the "
^DIC(9.4,164,22,1,"PAH",156,1,19,0)="uncertainty by clearly stating to the user which is the"
^DIC(9.4,164,22,1,"PAH",156,1,20,0)="IV Additive and which is the Generic Drug.  For example:"
^DIC(9.4,164,22,1,"PAH",156,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,22,0)="PRINT NAME: CEFAZOLIN// "
^DIC(9.4,164,22,1,"PAH",156,1,23,0)="GENERIC DRUG: CEFAZOLIN SOD 10GM M/D INJ// CEFAZ"
^DIC(9.4,164,22,1,"PAH",156,1,24,0)="     1   CEFAZOLIN OPTH SOLN 50MG/CC  (15CC) "
^DIC(9.4,164,22,1,"PAH",156,1,25,0)="     2   CEFAZOLIN SOD 10GM M/D INJ           AM115     "
^DIC(9.4,164,22,1,"PAH",156,1,26,0)="     3   CEFAZOLIN SOD 1GM INJ           AM115     N/F   "
^DIC(9.4,164,22,1,"PAH",156,1,27,0)="CHOOSE 1-3: 3  CEFAZOLIN SOD 1GM INJ         AM115     N/"
^DIC(9.4,164,22,1,"PAH",156,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,29,0)="You are about to change the GENERIC DRUG linked to this ADDITIVE."
^DIC(9.4,164,22,1,"PAH",156,1,30,0)="ADDITIVE CEFAZOLIN is currently linked to "
^DIC(9.4,164,22,1,"PAH",156,1,31,0)="GENERIC DRUG CEFAZOLIN SOD 10GM M/D INJ."
^DIC(9.4,164,22,1,"PAH",156,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,33,0)="Are you sure you want to link ADDITIVE CEFAZOLIN"
^DIC(9.4,164,22,1,"PAH",156,1,34,0)="to GENERIC DRUG CEFAZOLIN SOD 1GM INJ? No//"
^DIC(9.4,164,22,1,"PAH",156,1,35,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,36,0)="3) This patch will also serve as the overall resolution to the"
^DIC(9.4,164,22,1,"PAH",156,1,37,0)="issue of ambiguous IV Additive strength when a pharmacist is"
^DIC(9.4,164,22,1,"PAH",156,1,38,0)="finishing an IV by adding a STRENGTH (#19) field to the "
^DIC(9.4,164,22,1,"PAH",156,1,39,0)="IV ADDITIVES File (#52.6).  The new STRENGTH (#19) field"
^DIC(9.4,164,22,1,"PAH",156,1,40,0)="can be populated when adding a new IV Additive or when editing"
^DIC(9.4,164,22,1,"PAH",156,1,41,0)="an existing IV Additive via menu option ADditives File [PSSJI DRUG]."
^DIC(9.4,164,22,1,"PAH",156,1,42,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,43,0)="For example:"
^DIC(9.4,164,22,1,"PAH",156,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,45,0)="PRINT NAME: CEFAZOLIN// "
^DIC(9.4,164,22,1,"PAH",156,1,46,0)="GENERIC DRUG: CEFAZOLIN SOD 10GM M/D INJ//       AM115"
^DIC(9.4,164,22,1,"PAH",156,1,47,0)="USED IN IV FLUID ORDER ENTRY: YES// "
^DIC(9.4,164,22,1,"PAH",156,1,48,0)="DRUG UNIT: GM// "
^DIC(9.4,164,22,1,"PAH",156,1,49,0)="STRENGTH: 1// ??"
^DIC(9.4,164,22,1,"PAH",156,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,51,0)="This field identifies the numeric amount of medication that is"
^DIC(9.4,164,22,1,"PAH",156,1,52,0)="provided by one unit-of-use for the identified product."
^DIC(9.4,164,22,1,"PAH",156,1,53,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,54,0)="For example, if one vial contains 50 MG of medication, the"
^DIC(9.4,164,22,1,"PAH",156,1,55,0)="STRENGTH will be entered as '50'.  The DRUG UNIT of 'MG'"
^DIC(9.4,164,22,1,"PAH",156,1,56,0)="is populated by the DRUG UNIT (#2) field."
^DIC(9.4,164,22,1,"PAH",156,1,57,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,58,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,59,0)="Whenever a lookup is performed on the IV ADDITIVES File (#52.6), the "
^DIC(9.4,164,22,1,"PAH",156,1,60,0)="STRENGTH (#19) field will display next to the NAME (#.01) field"
^DIC(9.4,164,22,1,"PAH",156,1,61,0)="with the words ""Additive Strength:"" and then its value."
^DIC(9.4,164,22,1,"PAH",156,1,62,0)="Additionally, the DRUG UNIT (#2) field will be appended to the"
^DIC(9.4,164,22,1,"PAH",156,1,63,0)="STRENGTH (#19) field.  If the STRENGTH (#19) field is not"
^DIC(9.4,164,22,1,"PAH",156,1,64,0)="populated for the IV Additive, the text ""N/A"" will display, and"
^DIC(9.4,164,22,1,"PAH",156,1,65,0)="the DRUG UNIT (#2) field will not display."
^DIC(9.4,164,22,1,"PAH",156,1,66,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,67,0)="For example:"
^DIC(9.4,164,22,1,"PAH",156,1,68,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,69,0)="Select IV TYPE: PIGGYBACK."
^DIC(9.4,164,22,1,"PAH",156,1,70,0)="Select ADDITIVE: CEFAZOL"
^DIC(9.4,164,22,1,"PAH",156,1,71,0)="     1   CEFAZOLIN         Additive Strength: 1 GM  "
^DIC(9.4,164,22,1,"PAH",156,1,72,0)="               IV ROOM ONLY"
^DIC(9.4,164,22,1,"PAH",156,1,73,0)="     2   CEFAZOLIN         Additive Strength: 2 GM  "
^DIC(9.4,164,22,1,"PAH",156,1,74,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,75,0)="     3   CEFAZOLIN PREMIX         Additive Strength: N/A  "
^DIC(9.4,164,22,1,"PAH",156,1,76,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,77,0)="CHOOSE 1-3:"
^DIC(9.4,164,22,1,"PAH",156,1,78,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,79,0)="4) Additionally, this patch makes a small enhancement to the display"
^DIC(9.4,164,22,1,"PAH",156,1,80,0)="of Quick Codes during the selection of an IV ADDITIVE during"
^DIC(9.4,164,22,1,"PAH",156,1,81,0)="order entry.  When a lookup is performed on an IV ADDITIVE, if there"
^DIC(9.4,164,22,1,"PAH",156,1,82,0)="are QUICK CODES defined for the IV ADDITIVE, the QUICK CODE"
^DIC(9.4,164,22,1,"PAH",156,1,83,0)="STRENGTH (#1) field and the USUAL IV SCHEDULE (#4) field from the"
^DIC(9.4,164,22,1,"PAH",156,1,84,0)="QUICK CODE Subfile (#52.61) will display next to the QUICK CODE."
^DIC(9.4,164,22,1,"PAH",156,1,85,0)="If the QUICK CODE STRENGTH (#1) field is null, ""N/A"" will be displayed."
^DIC(9.4,164,22,1,"PAH",156,1,86,0)="If the USUAL IV SCHEDULE (#4) field is null, ""N/A"" will be displayed."
^DIC(9.4,164,22,1,"PAH",156,1,87,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,88,0)="For example:"
^DIC(9.4,164,22,1,"PAH",156,1,89,0)="Select ADDITIVE: CEFAZ"
^DIC(9.4,164,22,1,"PAH",156,1,90,0)="     1   CEFAZOLIN         Additive Strength: 1 GM  "
^DIC(9.4,164,22,1,"PAH",156,1,91,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,92,0)="       - CEFAZ1GM -        Quick Code Strength: 1 GM     Schedule: N/A"
^DIC(9.4,164,22,1,"PAH",156,1,93,0)="       - CEFAZ2GM -        Quick Code Strength: N/A     Schedule: BID"
^DIC(9.4,164,22,1,"PAH",156,1,94,0)="     2   CEFAZOLIN         Additive Strength: 2 GM  "
^DIC(9.4,164,22,1,"PAH",156,1,95,0)="               IV ROOM ONLY"
^DIC(9.4,164,22,1,"PAH",156,1,96,0)="     3   CEFAZOLIN PREMIX         Additive Strength: N/A  "
^DIC(9.4,164,22,1,"PAH",156,1,97,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,98,0)="CHOOSE 1-3: "
^DIC(9.4,164,22,1,"PAH",156,1,99,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,100,0)="5) This patch will also enhance the capabilities of the IV ADDITIVES"
^DIC(9.4,164,22,1,"PAH",156,1,101,0)="File (#52.6) and IV SOLUTIONS File (#52.7) so that a user can enter"
^DIC(9.4,164,22,1,"PAH",156,1,102,0)="a new additive or solution that has the same name as an existing entry."
^DIC(9.4,164,22,1,"PAH",156,1,103,0)="Previously, a Fileman workaround had to be used to enter an identically"
^DIC(9.4,164,22,1,"PAH",156,1,104,0)="named entry.  With this patch, if the user types in a name that already"
^DIC(9.4,164,22,1,"PAH",156,1,105,0)="exists in the file, they will first be presented with a list of available"
^DIC(9.4,164,22,1,"PAH",156,1,106,0)="selections.  If the user scrolls through the list without selecting an"
^DIC(9.4,164,22,1,"PAH",156,1,107,0)="entry, they will be presented with the prompt to add a new entry."
^DIC(9.4,164,22,1,"PAH",156,1,108,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,109,0)="For example - IV ADDITIVES File (#52.6)"
^DIC(9.4,164,22,1,"PAH",156,1,110,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,111,0)="CHOOSE 1-2: 1  PSSJI DRUG     ADditives File"
^DIC(9.4,164,22,1,"PAH",156,1,112,0)="ADditives File"
^DIC(9.4,164,22,1,"PAH",156,1,113,0)="Select IV ADDITIVES PRINT NAME: TESTDRUG"
^DIC(9.4,164,22,1,"PAH",156,1,114,0)="  Lookup: PRINT NAME"
^DIC(9.4,164,22,1,"PAH",156,1,115,0)="     1   TESTDRUG         Additive Strength: 10 MG  "
^DIC(9.4,164,22,1,"PAH",156,1,116,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,117,0)="     2   TESTDRUG         Additive Strength: N/A  "
^DIC(9.4,164,22,1,"PAH",156,1,118,0)="     3   TESTDRUG         Additive Strength: 5 GM  "
^DIC(9.4,164,22,1,"PAH",156,1,119,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,120,0)="     4   TESTDRUG         Additive Strength: 12 GM  "
^DIC(9.4,164,22,1,"PAH",156,1,121,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,122,0)="CHOOSE 1-4: "
^DIC(9.4,164,22,1,"PAH",156,1,123,0)="  Are you adding 'TESTDRUG' as a new IV ADDITIVES (the 77TH)? No// Y  "
^DIC(9.4,164,22,1,"PAH",156,1,124,0)="(Yes)"
^DIC(9.4,164,22,1,"PAH",156,1,125,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,126,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,127,0)="For example - IV SOLUTIONS File (#52.7)"
^DIC(9.4,164,22,1,"PAH",156,1,128,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,129,0)="Select OPTION NAME: PSSJI SOLN       PRimary Solution File (IV)"
^DIC(9.4,164,22,1,"PAH",156,1,130,0)="PRimary Solution File (IV)"
^DIC(9.4,164,22,1,"PAH",156,1,131,0)="Select IV SOLUTIONS PRINT NAME: 0.9% SODIUM CHLORIDE"
^DIC(9.4,164,22,1,"PAH",156,1,132,0)="  Lookup: PRINT NAME"
^DIC(9.4,164,22,1,"PAH",156,1,133,0)="     1   0.9% SODIUM CHLORIDE            250 ML                 "
^DIC(9.4,164,22,1,"PAH",156,1,134,0)="     2   0.9% SODIUM CHLORIDE            50 ML  "
^DIC(9.4,164,22,1,"PAH",156,1,135,0)="               "
^DIC(9.4,164,22,1,"PAH",156,1,136,0)="     3   0.9% SODIUM CHLORIDE            25 ML  "
^DIC(9.4,164,22,1,"PAH",156,1,137,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,138,0)="CHOOSE 1-3: "
^DIC(9.4,164,22,1,"PAH",156,1,139,0)=" "
^DIC(9.4,164,22,1,"PAH",156,1,140,0)="  Are you adding '0.9% SODIUM CHLORIDE' as "
