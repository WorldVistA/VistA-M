^DIC(9.4,14,22,5.9,"PAH",282,0)="464 SEQ #380^3170123.143817^54"
^DIC(9.4,14,22,5.9,"PAH",282,1,0)="^^12^12^3170123"
^DIC(9.4,14,22,5.9,"PAH",282,1,1,0)="The NSR20140715 Surgical Pathology Report Enhancements for Readability "
^DIC(9.4,14,22,5.9,"PAH",282,1,2,0)="intake modifies the Laboratory Surgical Pathology report by lining up the "
^DIC(9.4,14,22,5.9,"PAH",282,1,3,0)="columns so that the report is more legible. "
^DIC(9.4,14,22,5.9,"PAH",282,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",282,1,5,0)="This intake has been implemented locally at the Kansas City, Kansas VAMC. "
^DIC(9.4,14,22,5.9,"PAH",282,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",282,1,7,0)="The NSR for this intake addresses the following requirement: "
^DIC(9.4,14,22,5.9,"PAH",282,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",282,1,9,0)="* VHBAO: NEED502503 Surgical Pathology Report Enhancement: As a health "
^DIC(9.4,14,22,5.9,"PAH",282,1,10,0)="care provider, I need to view the Laboratory Surgical Pathology Report "
^DIC(9.4,14,22,5.9,"PAH",282,1,11,0)="columns in-line, so the report is legible and I can provide timely care "
^DIC(9.4,14,22,5.9,"PAH",282,1,12,0)="for the patient. "
^DIC(9.4,14,22,5.9,"PAH",283,0)="482 SEQ #381^3170203.1544^54"
^DIC(9.4,14,22,5.9,"PAH",283,1,0)="^^247^247^3170203"
^DIC(9.4,14,22,5.9,"PAH",283,1,1,0)="Subject:  ANATOMIC PATHOLOGY ORDER DIALOG ENHANCEMENT - FIX FOR AUTOPSY "
^DIC(9.4,14,22,5.9,"PAH",283,1,2,0)="ERROR"
^DIC(9.4,14,22,5.9,"PAH",283,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,4,0)="Category:  PATCH FOR A PATCH"
^DIC(9.4,14,22,5.9,"PAH",283,1,5,0)="           EMERGENCY PATCH"
^DIC(9.4,14,22,5.9,"PAH",283,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,7,0)="Description:"
^DIC(9.4,14,22,5.9,"PAH",283,1,8,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",283,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,10,0)="Associated Patches: LR*5.2*462"
^DIC(9.4,14,22,5.9,"PAH",283,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,12,0)="The build for this patch is distributed in support of the VistA Lab "
^DIC(9.4,14,22,5.9,"PAH",283,1,13,0)="Enhancement (VLE) Anatomic Pathology order dialog enhancements. This "
^DIC(9.4,14,22,5.9,"PAH",283,1,14,0)="patch is to fix an error to released patch LR*5.2*462 [ANATOMIC PATHOLOGY "
^DIC(9.4,14,22,5.9,"PAH",283,1,15,0)="ORDER DIALOG ENHANCEMENT]. It resolves the error generated when using the "
^DIC(9.4,14,22,5.9,"PAH",283,1,16,0)="option ""Verify/release reports, anat path"" [LRAPR] to verify/release an "
^DIC(9.4,14,22,5.9,"PAH",283,1,17,0)="Autopsy (AU) accession. This patch is being released as an emergency "
^DIC(9.4,14,22,5.9,"PAH",283,1,18,0)="patch with a compliance date of Feb 5, 2017 to coincide with the "
^DIC(9.4,14,22,5.9,"PAH",283,1,19,0)="LR*5.2*462 compliance date of Feb 5, 2017"
^DIC(9.4,14,22,5.9,"PAH",283,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,21,0)="Defect Addressed - 451608"
^DIC(9.4,14,22,5.9,"PAH",283,1,22,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,23,0)="The patch contains two routine, no option or menus."
^DIC(9.4,14,22,5.9,"PAH",283,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,25,0)="Blood Bank Review:"
^DIC(9.4,14,22,5.9,"PAH",283,1,26,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",283,1,27,0)="All of the above changes have been reviewed by the VISTA Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",283,1,28,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",283,1,29,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",283,1,30,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,31,0)="RISK ANALYSIS: Changes made by patch LR*5.2*482 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",283,1,32,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",283,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,34,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*482 does not "
^DIC(9.4,14,22,5.9,"PAH",283,1,35,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",283,1,36,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",283,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,38,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to routines and "
^DIC(9.4,14,22,5.9,"PAH",283,1,39,0)="files identified in ProPath standard titled: BBM Team Review of VistA "
^DIC(9.4,14,22,5.9,"PAH",283,1,40,0)="Patches, group B listing. The changes have no effect on Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",283,1,41,0)="functionality or medical device control functions. There is no adverse "
^DIC(9.4,14,22,5.9,"PAH",283,1,42,0)="potential to sites."
^DIC(9.4,14,22,5.9,"PAH",283,1,43,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,44,0)=" "
