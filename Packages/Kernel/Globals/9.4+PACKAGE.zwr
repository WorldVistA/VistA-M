^DIC(9.4,96,22,1.2,"PAH",4,1,131,0)="ROUTINE SUMMARY                                                          "
^DIC(9.4,96,22,1.2,"PAH",4,1,132,0)="==============="
^DIC(9.4,96,22,1.2,"PAH",4,1,133,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,96,22,1.2,"PAH",4,1,134,0)="second line of each of these routines now looks like:                  "
^DIC(9.4,96,22,1.2,"PAH",4,1,135,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,136,0)="<tab>;;1.2;DENTAL;**[PATCH LIST]**;Oct 08, 1992                          "
^DIC(9.4,96,22,1.2,"PAH",4,1,137,0)="                                                                    "
^DIC(9.4,96,22,1.2,"PAH",4,1,138,0)="              CHECK^XTSUMBLD results"
^DIC(9.4,96,22,1.2,"PAH",4,1,139,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,140,0)="Routine Name     Before Patch     After Patch     Patch List"
^DIC(9.4,96,22,1.2,"PAH",4,1,141,0)="------------     ------------     -----------     ----------"
