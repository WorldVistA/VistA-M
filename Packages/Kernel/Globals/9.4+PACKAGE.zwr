^DIC(9.4,202,22,1,"PAH",2,1,157,0)="  ================INSTALLATION INSTRUCTIONS ================="
^DIC(9.4,202,22,1,"PAH",2,1,158,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,159,0)="The patch is distributed in KIDS format in a PackMan message."
^DIC(9.4,202,22,1,"PAH",2,1,160,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,161,0)="This patch requires MHV*1*1"
^DIC(9.4,202,22,1,"PAH",2,1,162,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,163,0)="Install time - less than 5 minutes. "
^DIC(9.4,202,22,1,"PAH",2,1,164,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,165,0)="This patch can be installed with users on the system, and should be "
^DIC(9.4,202,22,1,"PAH",2,1,166,0)="installed during off-peak hours.  No options need to be disabled to "
^DIC(9.4,202,22,1,"PAH",2,1,167,0)="install this patch."
^DIC(9.4,202,22,1,"PAH",2,1,168,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,169,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,170,0)="Pre/Post Installation Overview"
^DIC(9.4,202,22,1,"PAH",2,1,171,0)="------------------------------"
^DIC(9.4,202,22,1,"PAH",2,1,172,0)="The pre-init routine PRE^MHV1P2 turns on MHV Application Logging.  It "
^DIC(9.4,202,22,1,"PAH",2,1,173,0)="will log information about MHV HL7 messages received during the patch "
^DIC(9.4,202,22,1,"PAH",2,1,174,0)="install.  This is only a precaution as the MHV application is tolerant of "
^DIC(9.4,202,22,1,"PAH",2,1,175,0)="messaging failures that might be caused by loading the patch.  If a "
^DIC(9.4,202,22,1,"PAH",2,1,176,0)="message was received during the patch installation, you will be notified "
^DIC(9.4,202,22,1,"PAH",2,1,177,0)="and asked to check the error trap for errors in the MHV namespace.  If "
^DIC(9.4,202,22,1,"PAH",2,1,178,0)="any are found, you should log a remedy ticket."
^DIC(9.4,202,22,1,"PAH",2,1,179,0)="The post init routine POST^MHV1P2 will update the MHVVA logical link and "
^DIC(9.4,202,22,1,"PAH",2,1,180,0)="turn off MHV Application Logging.  For test systems, it will remove data "
^DIC(9.4,202,22,1,"PAH",2,1,181,0)="from the DNS DOMAIN (#.08), TCP/IP ADDRESS (#400.01), and TCP/IP PORT "
^DIC(9.4,202,22,1,"PAH",2,1,182,0)="(#400.02) fields and set AUTOSTART (#4.5) to Disabled.  For production "
^DIC(9.4,202,22,1,"PAH",2,1,183,0)="systems, it will ensure the correct values are in the DNS DOMAIN (#.08), "
^DIC(9.4,202,22,1,"PAH",2,1,184,0)="TCP/IP ADDRESS (#400.01), and TCP/IP PORT (#400.02) fields and set "
^DIC(9.4,202,22,1,"PAH",2,1,185,0)="AUTOSTART (#4.5) to Enabled."
^DIC(9.4,202,22,1,"PAH",2,1,186,0)="    "
^DIC(9.4,202,22,1,"PAH",2,1,187,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,188,0)="1.  LOAD TRANSPORT GLOBAL "
^DIC(9.4,202,22,1,"PAH",2,1,189,0)="    ---------------------"
^DIC(9.4,202,22,1,"PAH",2,1,190,0)="    Choose the PackMan message containing this patch and invoke the "
^DIC(9.4,202,22,1,"PAH",2,1,191,0)="    INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,202,22,1,"PAH",2,1,192,0)="             "
^DIC(9.4,202,22,1,"PAH",2,1,193,0)="2.  START UP KIDS "
^DIC(9.4,202,22,1,"PAH",2,1,194,0)="    -------------"
^DIC(9.4,202,22,1,"PAH",2,1,195,0)="    Start up the Kernel Installation and Distribution System Menu "
^DIC(9.4,202,22,1,"PAH",2,1,196,0)="    [XPD MAIN]: "
^DIC(9.4,202,22,1,"PAH",2,1,197,0)="   "
^DIC(9.4,202,22,1,"PAH",2,1,198,0)="         Edits and Distribution ...  "
^DIC(9.4,202,22,1,"PAH",2,1,199,0)="         Utilities ...  "
^DIC(9.4,202,22,1,"PAH",2,1,200,0)="         Installation ...  "
^DIC(9.4,202,22,1,"PAH",2,1,201,0)="   "
^DIC(9.4,202,22,1,"PAH",2,1,202,0)="Select Kernel Installation & Distribution System Option: INStallation "
^DIC(9.4,202,22,1,"PAH",2,1,203,0)="                                                         ---"
^DIC(9.4,202,22,1,"PAH",2,1,204,0)="         Load a Distribution "
^DIC(9.4,202,22,1,"PAH",2,1,205,0)="         Print Transport Global "
^DIC(9.4,202,22,1,"PAH",2,1,206,0)="         Compare Transport Global to Current System "
^DIC(9.4,202,22,1,"PAH",2,1,207,0)="         Verify Checksums in Transport Global "
^DIC(9.4,202,22,1,"PAH",2,1,208,0)="         Install Package(s) "
^DIC(9.4,202,22,1,"PAH",2,1,209,0)="         Restart Install of Package(s) "
^DIC(9.4,202,22,1,"PAH",2,1,210,0)="         Unload a Distribution "
^DIC(9.4,202,22,1,"PAH",2,1,211,0)="         Backup a Transport Global "
^DIC(9.4,202,22,1,"PAH",2,1,212,0)="   "
^DIC(9.4,202,22,1,"PAH",2,1,213,0)="Select Installation Option: "
^DIC(9.4,202,22,1,"PAH",2,1,214,0)="   "
^DIC(9.4,202,22,1,"PAH",2,1,215,0)="3.  Select Installation Option: "
^DIC(9.4,202,22,1,"PAH",2,1,216,0)="    ---------------------------"
^DIC(9.4,202,22,1,"PAH",2,1,217,0)="    NOTE:  The following are OPTIONAL - (When prompted for the"
^DIC(9.4,202,22,1,"PAH",2,1,218,0)="           INSTALL NAME, enter MHV*1.0*2):"
^DIC(9.4,202,22,1,"PAH",2,1,219,0)="      "
^DIC(9.4,202,22,1,"PAH",2,1,220,0)="    a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,202,22,1,"PAH",2,1,221,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,202,22,1,"PAH",2,1,222,0)="        backup any other changes such as DD's or templates."
^DIC(9.4,202,22,1,"PAH",2,1,223,0)="    b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,202,22,1,"PAH",2,1,224,0)="        allow you to view all changes that will be made when this"
^DIC(9.4,202,22,1,"PAH",2,1,225,0)="        patch is installed.  It compares all components of this patch"
^DIC(9.4,202,22,1,"PAH",2,1,226,0)="        (routines, DD's, templates, etc.)."
^DIC(9.4,202,22,1,"PAH",2,1,227,0)="    c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,202,22,1,"PAH",2,1,228,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,202,22,1,"PAH",2,1,229,0)="        transport global."
^DIC(9.4,202,22,1,"PAH",2,1,230,0)="     "
^DIC(9.4,202,22,1,"PAH",2,1,231,0)="4.  Select Installation Option: Install Package(s) "
^DIC(9.4,202,22,1,"PAH",2,1,232,0)="    ----------------------------------------------"
^DIC(9.4,202,22,1,"PAH",2,1,233,0)="    **This is the step to start the installation of this KIDS patch: "
^DIC(9.4,202,22,1,"PAH",2,1,234,0)="   "
^DIC(9.4,202,22,1,"PAH",2,1,235,0)="    a.  Choose the Install Package(s) option to start the patch"
^DIC(9.4,202,22,1,"PAH",2,1,236,0)="        install."
^DIC(9.4,202,22,1,"PAH",2,1,237,0)="b.      When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,202,22,1,"PAH",2,1,238,0)="        install? YES//' answer NO "
^DIC(9.4,202,22,1,"PAH",2,1,239,0)="    c.  When prompted 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,202,22,1,"PAH",2,1,240,0)="        Options, and Protocols? YES//' answer NO"
^DIC(9.4,202,22,1,"PAH",3,0)="5 SEQ #3^3090422.113455^17"
^DIC(9.4,202,22,1,"PAH",3,1,0)="^^9^9^3090422"
^DIC(9.4,202,22,1,"PAH",3,1,1,0)="MHV*1*5 Secure Messaging"
^DIC(9.4,202,22,1,"PAH",3,1,2,0)=" "
^DIC(9.4,202,22,1,"PAH",3,1,3,0)="Summary"
^DIC(9.4,202,22,1,"PAH",3,1,4,0)="-------"
^DIC(9.4,202,22,1,"PAH",3,1,5,0)="MHV*1*5 delivers HL7 interfaces needed to support Secure Messaging.  "
^DIC(9.4,202,22,1,"PAH",3,1,6,0)="Secure Messaging leverages the existing TIUHL7 interface to save message "
^DIC(9.4,202,22,1,"PAH",3,1,7,0)="threads as progress notes.  MHV*1*5 installs the components necessary to "
^DIC(9.4,202,22,1,"PAH",3,1,8,0)="use the TIUHL7 interface.  MHV*1*5 also installs a new demographics query "
^DIC(9.4,202,22,1,"PAH",3,1,9,0)="used to support secure messaging."
^DIC(9.4,202,22,1,"PAH",4,0)="6 SEQ #4^3090422.113505^17"
^DIC(9.4,202,22,1,"PAH",4,1,0)="^^8^8^3090422"
^DIC(9.4,202,22,1,"PAH",4,1,1,0)="Summary"
^DIC(9.4,202,22,1,"PAH",4,1,2,0)="-------"
^DIC(9.4,202,22,1,"PAH",4,1,3,0)="MHV*1*6 delivers the HL7 interfaces needed to support Secure Messaging.  "
^DIC(9.4,202,22,1,"PAH",4,1,4,0)="There are nine new queries in the MHV namespace that support the "
^DIC(9.4,202,22,1,"PAH",4,1,5,0)="administration and daily operation of the Secure Messaging enterprise "
^DIC(9.4,202,22,1,"PAH",4,1,6,0)="system. MHV*1*6 installs the components necessary to execute the admin"
^DIC(9.4,202,22,1,"PAH",4,1,7,0)="queries to retrieve information on patients, providers, clinics, and"
^DIC(9.4,202,22,1,"PAH",4,1,8,0)="teams."
^DIC(9.4,202,22,1,"PAH",5,0)="9 SEQ #5^3111207.151843^17"
^DIC(9.4,202,22,1,"PAH",5,1,0)="^^41^41^3111207"
^DIC(9.4,202,22,1,"PAH",5,1,1,0)="  "
^DIC(9.4,202,22,1,"PAH",5,1,2,0)="MHV*1*9 Secure Messaging"
^DIC(9.4,202,22,1,"PAH",5,1,3,0)="  "
^DIC(9.4,202,22,1,"PAH",5,1,4,0)="Summary"
^DIC(9.4,202,22,1,"PAH",5,1,5,0)="-------"
^DIC(9.4,202,22,1,"PAH",5,1,6,0)="When My HealtheVet (MHV) Secure Messaging (SM) patients are assigned to"
^DIC(9.4,202,22,1,"PAH",5,1,7,0)="Primary Care Management Module (PCMM) teams other than their Primary Care"
^DIC(9.4,202,22,1,"PAH",5,1,8,0)="provider team, their MHV SM PCMM Primary Care provider association is broken."
^DIC(9.4,202,22,1,"PAH",5,1,9,0)="This results in MHV SM users not able to send messages to/from their"
^DIC(9.4,202,22,1,"PAH",5,1,10,0)="SM Primary Care team."
^DIC(9.4,202,22,1,"PAH",5,1,11,0)="     "
^DIC(9.4,202,22,1,"PAH",5,1,12,0)="MHV*1*9 uses a different support PCMM call to always return the patient's"
^DIC(9.4,202,22,1,"PAH",5,1,13,0)=" currently assigned, Primary Care provider."
^DIC(9.4,202,22,1,"PAH",5,1,14,0)="  "
^DIC(9.4,202,22,1,"PAH",5,1,15,0)="  "
^DIC(9.4,202,22,1,"PAH",5,1,16,0)="Detailed Description"
^DIC(9.4,202,22,1,"PAH",5,1,17,0)="--------------------"
^DIC(9.4,202,22,1,"PAH",5,1,18,0)="Secure Messaging allows patients and clinicians to email each other securely"
^DIC(9.4,202,22,1,"PAH",5,1,19,0)="and confidentially, and allows clinicians to post those email threads to the"
^DIC(9.4,202,22,1,"PAH",5,1,20,0)="medical record as progress notes."
^DIC(9.4,202,22,1,"PAH",5,1,21,0)="     "
^DIC(9.4,202,22,1,"PAH",5,1,22,0)="Relationships between patients and clinicians are established based on"
^DIC(9.4,202,22,1,"PAH",5,1,23,0)="PCMM providers, clinic appointments and Order Entry/Results Reporting (OE/RR)"
^DIC(9.4,202,22,1,"PAH",5,1,24,0)="teams.  Secure Messaging uses triage groups based on these relationships to"
^DIC(9.4,202,22,1,"PAH",5,1,25,0)="manage which patients are able to email which providers.  More information"
^DIC(9.4,202,22,1,"PAH",5,1,26,0)="on Secure Messaging can be found on the MHV product web site"
^DIC(9.4,202,22,1,"PAH",5,1,27,0)="     "
^DIC(9.4,202,22,1,"PAH",5,1,28,0)="http://vaww1.domain.ext/MyHealtheVet/, and MHV web site www.myhealth.domain.ext."
^DIC(9.4,202,22,1,"PAH",5,1,29,0)="     "
^DIC(9.4,202,22,1,"PAH",5,1,30,0)="When patients are assigned to other PCMM teams their MHV SM PCMM provider"
^DIC(9.4,202,22,1,"PAH",5,1,31,0)="association is broken.  This results in MHV SM users not able to send messages"
^DIC(9.4,202,22,1,"PAH",5,1,32,0)="to/from their SM Primary Care team."
^DIC(9.4,202,22,1,"PAH",5,1,33,0)="             "
^DIC(9.4,202,22,1,"PAH",5,1,34,0)="Before this patch, MHV application routines (MHVXPAT and MHVXDEMS) call,"
^DIC(9.4,202,22,1,"PAH",5,1,35,0)="IA#1916 SCAPMC - SUPPORTED PCMM CALLS, application programmer interface (API)"
^DIC(9.4,202,22,1,"PAH",5,1,36,0)="call to $$PRPT^SCAPMC() to return a patient's Primary Care provider to MHV SM."
^DIC(9.4,202,22,1,"PAH",5,1,37,0)="This API does not always return the current Primary Care provider."
^DIC(9.4,202,22,1,"PAH",5,1,38,0)="     "
^DIC(9.4,202,22,1,"PAH",5,1,39,0)="MHV*1*9 patch resolves the issue by always returning the SM patient's Primary Care"
^DIC(9.4,202,22,1,"PAH",5,1,40,0)="provider using the support call, IA#1252 PRIMARY CARE INPUT AND OUTPUT API CALLS,"
^DIC(9.4,202,22,1,"PAH",5,1,41,0)="API $$OUTPTPR^SDUTL3()."
^DIC(9.4,202,22,1,"PAH",6,0)="10 SEQ #6^3130619.143356^17"
^DIC(9.4,202,22,1,"PAH",7,0)="11 SEQ#14^3150820.145616"
^DIC(9.4,202,22,1,"PAH",8,0)="22 SEQ #16^3151211.144316^17"
^DIC(9.4,202,22,1,"PAH",8,1,0)="^^1^1^3151211"
^DIC(9.4,202,22,1,"PAH",8,1,1,0)="MHV Secure Messaging Workload Credit (SM WLC) ICD 10 EMERGENCY Issues Fix"
