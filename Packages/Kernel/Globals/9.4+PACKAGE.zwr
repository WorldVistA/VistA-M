^DIC(9.4,73,22,9,"PAH",15,1,49,0)="  =========================="
^DIC(9.4,73,22,9,"PAH",15,1,50,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,51,0)="     1. Users ARE allowed to be on the system during the installation."
^DIC(9.4,73,22,9,"PAH",15,1,52,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,53,0)="     2. DSM/AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,73,22,9,"PAH",15,1,54,0)="        routines in the Routine Summary section are mapped, disable"
^DIC(9.4,73,22,9,"PAH",15,1,55,0)="        mapping for the affected routine."
^DIC(9.4,73,22,9,"PAH",15,1,56,0)=" "
^DIC(9.4,73,22,9,"PAH",15,1,57,0)="     3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu."
^DIC(9.4,73,22,9,"PAH",15,1,58,0)="        This loads the patch into a Transport Global onto your system."
^DIC(9.4,73,22,9,"PAH",15,1,59,0)="    "
^DIC(9.4,73,22,9,"PAH",15,1,60,0)="     4. You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,73,22,9,"PAH",15,1,61,0)="              "
^DIC(9.4,73,22,9,"PAH",15,1,62,0)="     5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,73,22,9,"PAH",15,1,63,0)="        following options to install the Transport Global:"
^DIC(9.4,73,22,9,"PAH",15,1,64,0)="           Verify Checksums in Transport Global"
^DIC(9.4,73,22,9,"PAH",15,1,65,0)="           Print Transport Global "
