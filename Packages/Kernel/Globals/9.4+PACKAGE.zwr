^DIC(9.4,93,22,21,"PAH",166,1,194,0)="TBA"
^DIC(9.4,93,22,21,"PAH",166,1,195,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,196,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,93,22,21,"PAH",166,1,197,0)="----------------------------------------------------"
^DIC(9.4,93,22,21,"PAH",166,1,198,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,199,0)="Software being released as a host file and/or documentation describing"
^DIC(9.4,93,22,21,"PAH",166,1,200,0)="the new functionality introduced by this patch are available."
^DIC(9.4,93,22,21,"PAH",166,1,201,0)="  "
^DIC(9.4,93,22,21,"PAH",166,1,202,0)="The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,93,22,21,"PAH",166,1,203,0)="This transmits the files from the first available server. Sites may"
^DIC(9.4,93,22,21,"PAH",166,1,204,0)="also elect to retrieve files directly from a specific server.  "
^DIC(9.4,93,22,21,"PAH",166,1,205,0)="  "
^DIC(9.4,93,22,21,"PAH",166,1,206,0)="Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,93,22,21,"PAH",166,1,207,0)="Secure File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE"
^DIC(9.4,93,22,21,"PAH",166,1,208,0)="directory at the following OI Field Offices:"
^DIC(9.4,93,22,21,"PAH",166,1,209,0)="  "
^DIC(9.4,93,22,21,"PAH",166,1,210,0)="  Hines:          fo-hines.domain.ext"
^DIC(9.4,93,22,21,"PAH",166,1,211,0)="  Salt Lake City: fo-slc.domain.ext"
^DIC(9.4,93,22,21,"PAH",166,1,212,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,213,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,214,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,93,22,21,"PAH",166,1,215,0)="at:"
^DIC(9.4,93,22,21,"PAH",166,1,216,0)="http://www4.domain.ext/vdl/"
^DIC(9.4,93,22,21,"PAH",166,1,217,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,218,0)="Title                                          File Name          FTP Mode"
^DIC(9.4,93,22,21,"PAH",166,1,219,0)="--------------------------------------------------------------------------"
^DIC(9.4,93,22,21,"PAH",166,1,220,0)="N/A"
^DIC(9.4,93,22,21,"PAH",166,1,221,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,222,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,223,0)="Patch Installation:"
^DIC(9.4,93,22,21,"PAH",166,1,224,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,225,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,226,0)="Pre/Post Installation Overview"
^DIC(9.4,93,22,21,"PAH",166,1,227,0)="------------------------------"
^DIC(9.4,93,22,21,"PAH",166,1,228,0)="There are no pre- or post-installation tasks for this patch."
^DIC(9.4,93,22,21,"PAH",166,1,229,0)="  "
^DIC(9.4,93,22,21,"PAH",166,1,230,0)="Installation Instructions"
^DIC(9.4,93,22,21,"PAH",166,1,231,0)="-------------------------"
^DIC(9.4,93,22,21,"PAH",166,1,232,0)="Install Time - less than 5 minutes."
^DIC(9.4,93,22,21,"PAH",166,1,233,0)="    "
^DIC(9.4,93,22,21,"PAH",166,1,234,0)="   1. Use the INSTALL/CHECK MESSAGE option on the PackMan menu."
^DIC(9.4,93,22,21,"PAH",166,1,235,0)="   "
^DIC(9.4,93,22,21,"PAH",166,1,236,0)="   2. From the Kernel Installation & Distribution System menu, select"
^DIC(9.4,93,22,21,"PAH",166,1,237,0)="      the Installation menu."
^DIC(9.4,93,22,21,"PAH",166,1,238,0)="   "
^DIC(9.4,93,22,21,"PAH",166,1,239,0)="   3. From this menu, you may select to use the following options"
^DIC(9.4,93,22,21,"PAH",166,1,240,0)="      (when prompted for INSTALL NAME, enter DVBA*2.7*208):"
^DIC(9.4,93,22,21,"PAH",166,1,241,0)="          a.  Verify Checksums in Transport Global - This option will "
^DIC(9.4,93,22,21,"PAH",166,1,242,0)="allow"
^DIC(9.4,93,22,21,"PAH",166,1,243,0)="              you to ensure the integrity of the routines that are in the"
^DIC(9.4,93,22,21,"PAH",166,1,244,0)="              transport global."
^DIC(9.4,93,22,21,"PAH",166,1,245,0)="          b.  Print Transport Global - This option will allow you to view"
^DIC(9.4,93,22,21,"PAH",166,1,246,0)="              the components of the KIDS build."
^DIC(9.4,93,22,21,"PAH",166,1,247,0)="          c.  Compare Transport Global to Current System - This option "
^DIC(9.4,93,22,21,"PAH",166,1,248,0)="will"
^DIC(9.4,93,22,21,"PAH",166,1,249,0)="              allow you to view all changes that will be made when this "
^DIC(9.4,93,22,21,"PAH",166,1,250,0)="              patch is installed.  It compares all components of this"
^DIC(9.4,93,22,21,"PAH",166,1,251,0)="              patch (routines, DD's, templates, etc.)."
^DIC(9.4,93,22,21,"PAH",166,1,252,0)="          d.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,93,22,21,"PAH",166,1,253,0)="              message of any routines exported with this patch. It will "
^DIC(9.4,93,22,21,"PAH",166,1,254,0)="not"
^DIC(9.4,93,22,21,"PAH",166,1,255,0)="              backup any other changes such as DD's or templates."
^DIC(9.4,93,22,21,"PAH",166,1,256,0)="   "
^DIC(9.4,93,22,21,"PAH",166,1,257,0)="   4. Use the Install Package(s) option and select the package "
^DIC(9.4,93,22,21,"PAH",166,1,258,0)="DVBA*2.7*208."
^DIC(9.4,93,22,21,"PAH",166,1,259,0)="   "
^DIC(9.4,93,22,21,"PAH",166,1,260,0)="   5. When prompted ""Want KIDS to INHIBIT LOGONs during the install? NO//"""
^DIC(9.4,93,22,21,"PAH",166,1,261,0)="      respond NO."
^DIC(9.4,93,22,21,"PAH",166,1,262,0)="   6. When prompted ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,93,22,21,"PAH",166,1,263,0)="      Protocols? NO//"", respond NO"
^DIC(9.4,93,22,21,"PAH",166,1,264,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,265,0)="Back-Out/Roll Back Plan:"
^DIC(9.4,93,22,21,"PAH",166,1,266,0)="------------------------"
^DIC(9.4,93,22,21,"PAH",166,1,267,0)="In the event of a catastrophic failure, the Facility Chief Information "
^DIC(9.4,93,22,21,"PAH",166,1,268,0)="Officer may make the decision to back-out the patch."
^DIC(9.4,93,22,21,"PAH",166,1,269,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,270,0)="It is imperative that you have performed a backup of the routines and"
^DIC(9.4,93,22,21,"PAH",166,1,271,0)="the routines included matches the pre-patch checksum from the patch"
^DIC(9.4,93,22,21,"PAH",166,1,272,0)="description."
^DIC(9.4,93,22,21,"PAH",166,1,273,0)=" "
^DIC(9.4,93,22,21,"PAH",166,1,274,0)="This patch only contains routine updates. To back-out the patch please"
^DIC(9.4,93,22,21,"PAH",166,1,275,0)="restore the backup message from the patch installation process."
^DIC(9.4,93,22,21,"PAH",167,0)="213 SEQ #181^3190827.090105^65"
^DIC(9.4,93,22,21,"PAH",167,1,0)="^^4^4^3190827"
^DIC(9.4,93,22,21,"PAH",167,1,1,0)="The ""Get Docs from Virtual VA"" option is still visible in CAPRI for some "
^DIC(9.4,93,22,21,"PAH",167,1,2,0)="users even though it has been discontinued. This is due to users still "
^DIC(9.4,93,22,21,"PAH",167,1,3,0)="holding instances of the 'DVBA CAPRI GETVBADOCS' key from the SECURITY KEY"
^DIC(9.4,93,22,21,"PAH",167,1,4,0)="(#19.1) File."
^DIC(9.4,93,22,21,"PAH",168,0)="212 SEQ #182^3191016.161735^65"
^DIC(9.4,93,22,21,"PAH",168,1,0)="^^24^24^3191016"
^DIC(9.4,93,22,21,"PAH",168,1,1,0)="CAPRI currently operates on XML schema 1.0 when transmitting "
^DIC(9.4,93,22,21,"PAH",168,1,2,0)="Disability Benefits Questionnaires (DBQ's). To comply with IEPD standards"
^DIC(9.4,93,22,21,"PAH",168,1,3,0)="for transmitting data and to maintain system and security standards, an"
^DIC(9.4,93,22,21,"PAH",168,1,4,0)="update is required to the most current standards."
^DIC(9.4,93,22,21,"PAH",168,1,5,0)="These changes are for the following fields of data:"
^DIC(9.4,93,22,21,"PAH",168,1,6,0)="-Facility Type"
^DIC(9.4,93,22,21,"PAH",168,1,7,0)="-Service Provider Client Association Type"
^DIC(9.4,93,22,21,"PAH",168,1,8,0)="-Exam Detail Type"
^DIC(9.4,93,22,21,"PAH",168,1,9,0)="-Claim Information Type"
^DIC(9.4,93,22,21,"PAH",168,1,10,0)="-Veteran of Interest Type"
^DIC(9.4,93,22,21,"PAH",168,1,11,0)="-Document Type"
^DIC(9.4,93,22,21,"PAH",168,1,12,0)="-Service Provider Type"
^DIC(9.4,93,22,21,"PAH",168,1,13,0)="-Approver Type"
^DIC(9.4,93,22,21,"PAH",168,1,14,0)="-Person Type"
^DIC(9.4,93,22,21,"PAH",168,1,15,0)="-Client Type"
^DIC(9.4,93,22,21,"PAH",168,1,16,0)=" "
^DIC(9.4,93,22,21,"PAH",168,1,17,0)=" "
^DIC(9.4,93,22,21,"PAH",168,1,18,0)="Patch DVBA*2.7*212 will also fix the following issues:"
^DIC(9.4,93,22,21,"PAH",168,1,19,0)="-Other facilities visited button/message will be updated to display an "
^DIC(9.4,93,22,21,"PAH",168,1,20,0)=" appropriate message to users"
^DIC(9.4,93,22,21,"PAH",168,1,21,0)="-Completed date and Release date does not get populated when exam "
^DIC(9.4,93,22,21,"PAH",168,1,22,0)=" templates are signed in CPRS"
^DIC(9.4,93,22,21,"PAH",168,1,23,0)="-Enterprise Search not routing appropriately"
^DIC(9.4,93,22,21,"PAH",168,1,24,0)="-Transmission to VLER Failed message not accurate in some cases"
^DIC(9.4,93,22,21,"PAH",169,0)="215 SEQ #183^3191122.113502^65"
^DIC(9.4,93,22,21,"PAH",169,1,0)="^^9^9^3191122"
^DIC(9.4,93,22,21,"PAH",169,1,1,0)="Certain sites are receiving an undefined error message when running"
^DIC(9.4,93,22,21,"PAH",169,1,2,0)="reports on cancellations within the Compensation and Pension Record"
^DIC(9.4,93,22,21,"PAH",169,1,3,0)="Interchange (CAPRI) GUI application.  The sites generating this"
^DIC(9.4,93,22,21,"PAH",169,1,4,0)="error are populating new corrupt entries in the DATE STATUS LAST"
^DIC(9.4,93,22,21,"PAH",169,1,5,0)="CHANGED (AH) cross-reference of the 2507 REQUEST (#396.3) file daily"
^DIC(9.4,93,22,21,"PAH",169,1,6,0)="due to the task DVBA C PURGE 2507 - Purge Old 2507 Requests being"
^DIC(9.4,93,22,21,"PAH",169,1,7,0)="scheduled to run each day.  These cancellation reports are not able"
^DIC(9.4,93,22,21,"PAH",169,1,8,0)="to display when VistA attempts to cycle through the DATE STATUS LAST"
^DIC(9.4,93,22,21,"PAH",169,1,9,0)="CHANGED (AH) cross-reference because of these corrupt data entries."
^DIC(9.4,93,22,21,"PAH",170,0)="219 SEQ #184^3200325.110606^70"
^DIC(9.4,93,22,21,"PAH",170,1,0)="^^3^3^3200325"
^DIC(9.4,93,22,21,"PAH",170,1,1,0)="This patch will modify the REMOTE APPLICATION file (#8994.5) "
^DIC(9.4,93,22,21,"PAH",170,1,2,0)="CALLBACKSERVER (#.03) field in support of the CLAIMS server migration"
^DIC(9.4,93,22,21,"PAH",170,1,3,0)="to Linux."
^DIC(9.4,93,22,21,"PAH",171,0)="218 SEQ #185^3200623.18143^65"
^DIC(9.4,93,22,21,"PAH",171,1,0)="^^3^3^3200623"
^DIC(9.4,93,22,21,"PAH",171,1,1,0)="This patch addresses a request to add the option Reset Copay Status List"
^DIC(9.4,93,22,21,"PAH",171,1,2,0)="Manager [PSOCP RESET COPAY STATUS LM] to the HRC Pharmacy Menu [DVBA"
^DIC(9.4,93,22,21,"PAH",171,1,3,0)="HRC MENU PHARMACY]."
^DIC(9.4,93,22,21,"PAH",172,0)="220 SEQ #187^3200730.151802^65"
^DIC(9.4,93,22,21,"PAH",172,1,0)="^^35^35^3200730"
^DIC(9.4,93,22,21,"PAH",172,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,2,0)="Patch DVBA*2.7*220 will update the Compensation and Pension"
^DIC(9.4,93,22,21,"PAH",172,1,3,0)="Record Interchange (CAPRI) GUI to Delphi Version XE10 to implement the "
^DIC(9.4,93,22,21,"PAH",172,1,4,0)="new Remote Procedure Call (RPC) broker allowing compliance of Two "
^DIC(9.4,93,22,21,"PAH",172,1,5,0)="Factor Authentication (2FA) which will require the use of a Personal"
^DIC(9.4,93,22,21,"PAH",172,1,6,0)="Identity Verification (PIV) card."
^DIC(9.4,93,22,21,"PAH",172,1,7,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,8,0)="Patch DVBA*2.7*220 also adds and/or changes the following functionality "
^DIC(9.4,93,22,21,"PAH",172,1,9,0)="-updates the Compensation and Pension Record Interchange (CAPRI) GUI to"
^DIC(9.4,93,22,21,"PAH",172,1,10,0)="add functionality to manually transmit documents and data to Veterans"
^DIC(9.4,93,22,21,"PAH",172,1,11,0)="Benefits Management Systems (VBMS)."
^DIC(9.4,93,22,21,"PAH",172,1,12,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,13,0)="-adds a feature to store failed Disability Benefits Questionnaires (DBQ)"
^DIC(9.4,93,22,21,"PAH",172,1,14,0)="transmissions.  The user will be prompted to transmit stored DBQ's when"
^DIC(9.4,93,22,21,"PAH",172,1,15,0)="CAPRI opens and when CAPRI closes."
^DIC(9.4,93,22,21,"PAH",172,1,16,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,17,0)="-adds two new selections for the Special Consideration File 396.25"
^DIC(9.4,93,22,21,"PAH",172,1,18,0)=" -Purple Heart Recipient"
^DIC(9.4,93,22,21,"PAH",172,1,19,0)=" -Incarcerated"
^DIC(9.4,93,22,21,"PAH",172,1,20,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,21,0)="-adds a Self-Referral Flag selection to allow users to indicate on the "
^DIC(9.4,93,22,21,"PAH",172,1,22,0)="C&P Worksheet Screen if the DBQ is self-referred."
^DIC(9.4,93,22,21,"PAH",172,1,23,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,24,0)="-adds a feature to display Behavioral Patient Record Flags and detailed "
^DIC(9.4,93,22,21,"PAH",172,1,25,0)="information if selected."
^DIC(9.4,93,22,21,"PAH",172,1,26,0)=" "
^DIC(9.4,93,22,21,"PAH",172,1,27,0)="This patch also addresses the following issues:"
^DIC(9.4,93,22,21,"PAH",172,1,28,0)="1.) CAPRI Error #701 & Error #312 reports when attempting to submit "
^DIC(9.4,93,22,21,"PAH",172,1,29,0)="    Insufficient Exam"
^DIC(9.4,93,22,21,"PAH",172,1,30,0)="2.) CAPRI Screen text is very small and needs to be changed."
^DIC(9.4,93,22,21,"PAH",172,1,31,0)="3.) CAPRI: A&A template not recognizing presence of the DBQ Medical "
^DIC(9.4,93,22,21,"PAH",172,1,32,0)="    Opinion template"
^DIC(9.4,93,22,21,"PAH",172,1,33,0)="4.) CAPRI connect error message display change for Enterprise Search or "
^DIC(9.4,93,22,21,"PAH",172,1,34,0)="    Other Sites Visited option"
^DIC(9.4,93,22,21,"PAH",172,1,35,0)="5.) CAPRI copy with CTRL+C causes error"
^DIC(9.4,93,22,21,"PAH",173,0)="214 SEQ #188^3200827.13133^65"
^DIC(9.4,93,22,21,"PAH",173,1,0)="^^1^1^3200827"
^DIC(9.4,93,22,21,"PAH",173,1,1,0)="Please refer to patch description on FORUM."
^DIC(9.4,93,22,21,"PAH",174,0)="223 SEQ #189^3201023.091249^17"
^DIC(9.4,93,22,21,"PAH",174,1,0)="^^102^102^3201023"
^DIC(9.4,93,22,21,"PAH",174,1,1,0)="As the transition to Cerner occurs, there are two different process flows"
^DIC(9.4,93,22,21,"PAH",174,1,2,0)="depending on if the data available for the patient existed prior to the "
^DIC(9.4,93,22,21,"PAH",174,1,3,0)="conversion or was added after conversion.  The ""Enterprise Search"" and "
^DIC(9.4,93,22,21,"PAH",174,1,4,0)="""Other Facilities Visited"" functionality will qualify the entry depending "
^DIC(9.4,93,22,21,"PAH",174,1,5,0)="on when the records were created relative to when the conversion occurred "
^DIC(9.4,93,22,21,"PAH",174,1,6,0)="(before or after the conversion).  When Cerner only data exists, the "
^DIC(9.4,93,22,21,"PAH",174,1,7,0)="Cerner entry will be qualified with ""Treatment Record Exist""."
^DIC(9.4,93,22,21,"PAH",174,1,8,0)="Example:"
^DIC(9.4,93,22,21,"PAH",174,1,9,0)="200CRNR-Treatment Records Exist"
^DIC(9.4,93,22,21,"PAH",174,1,10,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,11,0)="CAPRI Enterprise Record Search and ""other facilities visited"" "
^DIC(9.4,93,22,21,"PAH",174,1,12,0)="functionality will be updated to use a new Remote Procedure Call to "
^DIC(9.4,93,22,21,"PAH",174,1,13,0)="retrieve the list of treating facilities associated with the record, "
^DIC(9.4,93,22,21,"PAH",174,1,14,0)="including a Cerner Indicator along with the ""Date Last Treated"" "
^DIC(9.4,93,22,21,"PAH",174,1,15,0)="identifying patients at a Cerner converted site.  This will allow CAPRI "
^DIC(9.4,93,22,21,"PAH",174,1,16,0)="to correctly communicate whether the patient record was migrated from "
^DIC(9.4,93,22,21,"PAH",174,1,17,0)="Vista or if it was created on/after the conversion so that VBA users will "
^DIC(9.4,93,22,21,"PAH",174,1,18,0)="be able to route claims accordingly."
^DIC(9.4,93,22,21,"PAH",174,1,19,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,20,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,21,0)="The following defects that were entered after the release of Patch"
^DIC(9.4,93,22,21,"PAH",174,1,22,0)="DVBA*2.7*220:"
^DIC(9.4,93,22,21,"PAH",174,1,23,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,24,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,25,0)="CAPRI-209 - CAPRI users connecting to remote sites via Claims are not "
^DIC(9.4,93,22,21,"PAH",174,1,26,0)="able to transmit reports or DBQs to eFolder"
^DIC(9.4,93,22,21,"PAH",174,1,27,0)="CAPRI-210 - Unable to select all progress notes via single scroll"
^DIC(9.4,93,22,21,"PAH",174,1,28,0)="CAPRI-211 - Claims user prompted to enter password again when user has "
^DIC(9.4,93,22,21,"PAH",174,1,29,0)="more than one division"
^DIC(9.4,93,22,21,"PAH",174,1,30,0)="CAPRI-238 - Patient Selector Add 508 Compliance"
^DIC(9.4,93,22,21,"PAH",174,1,31,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,32,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,33,0)="1.) CAPRI-209 - CAPRI users connecting to remote sites via Claims are not "
^DIC(9.4,93,22,21,"PAH",174,1,34,0)="                able to transmit reports or DBQs to eFolder"
^DIC(9.4,93,22,21,"PAH",174,1,35,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,36,0)="    Problem: "
^DIC(9.4,93,22,21,"PAH",174,1,37,0)="    --------"
^DIC(9.4,93,22,21,"PAH",174,1,38,0)="    DBQs and reports are transmitted from VBA users (reports) and VHA "
^DIC(9.4,93,22,21,"PAH",174,1,39,0)="    users (DBQs) to VLER DAS. "
^DIC(9.4,93,22,21,"PAH",174,1,40,0)="    VBA users connecting to a remote site via Claims are not able to "
^DIC(9.4,93,22,21,"PAH",174,1,41,0)="    transmit reports to the VBA eFolder Queue (VLER DAS).  This issue is"
^DIC(9.4,93,22,21,"PAH",174,1,42,0)="    caused by a failure by the kernel M code to validate"
^DIC(9.4,93,22,21,"PAH",174,1,43,0)="    a guest account which is attempting to send the report XML request to "
^DIC(9.4,93,22,21,"PAH",174,1,44,0)="    DAS.  The specific failure is that the guest account on the remote"
^DIC(9.4,93,22,21,"PAH",174,1,45,0)="    site gets proxyauthfailed when the proxy server attempts"
^DIC(9.4,93,22,21,"PAH",174,1,46,0)="    to validate the token sent by the guest account."
^DIC(9.4,93,22,21,"PAH",174,1,47,0)="   "
^DIC(9.4,93,22,21,"PAH",174,1,48,0)="  "
^DIC(9.4,93,22,21,"PAH",174,1,49,0)="    Resolution:"
^DIC(9.4,93,22,21,"PAH",174,1,50,0)="    -----------"
^DIC(9.4,93,22,21,"PAH",174,1,51,0)="    Temporarily this enhancement is being removed for all CAPRI users "
^DIC(9.4,93,22,21,"PAH",174,1,52,0)="    to allow for additional modifications needed downstream in the"
^DIC(9.4,93,22,21,"PAH",174,1,53,0)="    process.   "
^DIC(9.4,93,22,21,"PAH",174,1,54,0)="    This will be addressed in a future patch.  Send to Virtual VA button "
^DIC(9.4,93,22,21,"PAH",174,1,55,0)="    is being re-instated to its prior functionality."
^DIC(9.4,93,22,21,"PAH",174,1,56,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,57,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,58,0)="2.) CAPRI-210 - Unable to select all progress notes via single scroll "
^DIC(9.4,93,22,21,"PAH",174,1,59,0)="    "
^DIC(9.4,93,22,21,"PAH",174,1,60,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",174,1,61,0)="    --------"
^DIC(9.4,93,22,21,"PAH",174,1,62,0)="    In Patch 212, the user was able to select all the entries in one "
^DIC(9.4,93,22,21,"PAH",174,1,63,0)="    selection.  In Patch 220, the selection stops at next to last entry.  "
^DIC(9.4,93,22,21,"PAH",174,1,64,0)="    All functionality still works as expected if you navigate"
^DIC(9.4,93,22,21,"PAH",174,1,65,0)="    to the first and last entries of your selection and shift+click."
^DIC(9.4,93,22,21,"PAH",174,1,66,0)="    "
^DIC(9.4,93,22,21,"PAH",174,1,67,0)="    Resolution:"
^DIC(9.4,93,22,21,"PAH",174,1,68,0)="    -----------"
^DIC(9.4,93,22,21,"PAH",174,1,69,0)="    Modified the TORListBox component to include the last (partially "
^DIC(9.4,93,22,21,"PAH",174,1,70,0)="    displayed) row.  This restored the continuous scroll down behavior"
^DIC(9.4,93,22,21,"PAH",174,1,71,0)="    that the user had seen in patch 212."
^DIC(9.4,93,22,21,"PAH",174,1,72,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,73,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,74,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,75,0)="3.) CAPRI-211 - Claims user prompted to enter division again when user "
^DIC(9.4,93,22,21,"PAH",174,1,76,0)="                has more than one division"
^DIC(9.4,93,22,21,"PAH",174,1,77,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,78,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",174,1,79,0)="    --------"
^DIC(9.4,93,22,21,"PAH",174,1,80,0)="    Remote users are prompted multiple time to select a division because "
^DIC(9.4,93,22,21,"PAH",174,1,81,0)="    the broker is connecting to the home server,"
^DIC(9.4,93,22,21,"PAH",174,1,82,0)="    if they have more then one division assigned to them on the claims "
^DIC(9.4,93,22,21,"PAH",174,1,83,0)="    server. "
^DIC(9.4,93,22,21,"PAH",174,1,84,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,85,0)="    Resolution:"
^DIC(9.4,93,22,21,"PAH",174,1,86,0)="    ----------- "
^DIC(9.4,93,22,21,"PAH",174,1,87,0)="    Changes were made to the process in CAPRI that handles broker "
^DIC(9.4,93,22,21,"PAH",174,1,88,0)="    connections to the home server.  CAPRI will now "
^DIC(9.4,93,22,21,"PAH",174,1,89,0)="    store the division after the first selection and use this division "
^DIC(9.4,93,22,21,"PAH",174,1,90,0)="    each time the home server is connected to during the session."
^DIC(9.4,93,22,21,"PAH",174,1,91,0)="   "
^DIC(9.4,93,22,21,"PAH",174,1,92,0)="4.) CAPRI-238 - Patient Selector Add 508 Compliance"
^DIC(9.4,93,22,21,"PAH",174,1,93,0)="   "
^DIC(9.4,93,22,21,"PAH",174,1,94,0)="    Problem:"
^DIC(9.4,93,22,21,"PAH",174,1,95,0)="    --------"
^DIC(9.4,93,22,21,"PAH",174,1,96,0)="    During 508 Compliance Audit it was found that the Patient Selector "
^DIC(9.4,93,22,21,"PAH",174,1,97,0)="    Window did not meet compliance."
^DIC(9.4,93,22,21,"PAH",174,1,98,0)=" "
^DIC(9.4,93,22,21,"PAH",174,1,99,0)="    Resolution:"
^DIC(9.4,93,22,21,"PAH",174,1,100,0)="    -----------"
^DIC(9.4,93,22,21,"PAH",174,1,101,0)="    Changes were made to the Patient ID ListBox to label this componenet, "
^DIC(9.4,93,22,21,"PAH",174,1,102,0)="    which will allow for 508 compliance to be met."
^DIC(9.4,93,22,21,"PAH",175,0)="224 SEQ #190^3201231.140213^65"
^DIC(9.4,93,22,21,"PAH",175,1,0)="^^4^4^3201231"
^DIC(9.4,93,22,21,"PAH",175,1,1,0)="Patch DVBA*2.7*224 will update the Compensation and Pension"
^DIC(9.4,93,22,21,"PAH",175,1,2,0)="Record Interchange (CAPRI) GUI CAPRI News service.  If the News "
^DIC(9.4,93,22,21,"PAH",175,1,3,0)="Server is unavailable, the GUI will bypass this service this allowing the "
^DIC(9.4,93,22,21,"PAH",175,1,4,0)="user to continue launching the application and eliminating any downtime."
^DIC(9.4,93,22,21,"PAH",176,0)="221 SEQ #191^3210127.121312^17"
^DIC(9.4,93,22,21,"PAH",176,1,0)="^^5^5^3210127"
^DIC(9.4,93,22,21,"PAH",176,1,1,0)="Print C&P Final Report (Manual) is not clearing results which have a "
^DIC(9.4,93,22,21,"PAH",176,1,2,0)="CLAIM NUMBER (#.313) field in the PATIENT (#2) file that's value matches "
^DIC(9.4,93,22,21,"PAH",176,1,3,0)="the patient's SOCIAL SECURITY NUMBER (#.09) field in the PATIENT (#2) "
^DIC(9.4,93,22,21,"PAH",176,1,4,0)="file or has no value. CAPRI API's will be modified to allow the above"
^DIC(9.4,93,22,21,"PAH",176,1,5,0)="situations to function properly."
^DIC(9.4,93,22,21,"PAH",177,0)="225 SEQ #192^3210218.14395^17"
^DIC(9.4,93,22,21,"PAH",177,1,0)="^^2^2^3210218"
^DIC(9.4,93,22,21,"PAH",177,1,1,0)="This patch fixes a name spacing error in the option Edit C&P Request "
^DIC(9.4,93,22,21,"PAH",177,1,2,0)="Information [DVBA C EDIT C&P REQUEST INFO]."
