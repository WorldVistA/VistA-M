^DIC(9.4,11,22,5.03,"PAH",32,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,49,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",32,1,50,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",32,1,51,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",32,1,52,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",32,1,53,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",32,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,55,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",32,1,56,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",32,1,57,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",32,1,58,0)="   LA71             N/A            4588676        **71** (Deleted by KIDS)"
^DIC(9.4,11,22,5.03,"PAH",32,1,59,0)="   LA7VOBX1         4535705        4442510        **46,61,63,64,71**"
^DIC(9.4,11,22,5.03,"PAH",32,1,60,0)="   LA7VORU          8366274        8469558        **27,46,61,64,71**"
^DIC(9.4,11,22,5.03,"PAH",32,1,61,0)="  "
^DIC(9.4,11,22,5.03,"PAH",32,1,62,0)=" List of preceding patches: 64"
^DIC(9.4,11,22,5.03,"PAH",32,1,63,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,11,22,5.03,"PAH",32,1,64,0)="  "
^DIC(9.4,11,22,5.03,"PAH",32,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,66,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",32,1,67,0)="-------------------------"
^DIC(9.4,11,22,5.03,"PAH",32,1,68,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,11,22,5.03,"PAH",32,1,69,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",32,1,70,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",32,1,71,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,73,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,11,22,5.03,"PAH",32,1,74,0)="      problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",32,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,76,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",32,1,77,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",32,1,78,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,79,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,80,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",32,1,81,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,82,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,11,22,5.03,"PAH",32,1,83,0)="        option will load the KIDS package onto your system."
^DIC(9.4,11,22,5.03,"PAH",32,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,85,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",32,1,86,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",32,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,88,0)="  4.  From this menu, you may then elect to use the following options"
^DIC(9.4,11,22,5.03,"PAH",32,1,89,0)="      (when prompted for the INSTALL NAME, enter LA*5.2*71):"
^DIC(9.4,11,22,5.03,"PAH",32,1,90,0)="        a. Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",32,1,91,0)="        b. Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",32,1,92,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",32,1,93,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,11,22,5.03,"PAH",32,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,95,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",32,1,96,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",32,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,98,0)="  5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",32,1,99,0)="      and select the package 'LA*5.2*71'.  When prompted 'Want KIDS to"
^DIC(9.4,11,22,5.03,"PAH",32,1,100,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,11,22,5.03,"PAH",32,1,101,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,11,22,5.03,"PAH",32,1,102,0)="      YES//', choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",32,1,103,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,104,0)="      The install will automatically disable the following options:"
^DIC(9.4,11,22,5.03,"PAH",32,1,105,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,106,0)="       Accession order then immediately enter data LR ACC THEN DATA"
^DIC(9.4,11,22,5.03,"PAH",32,1,107,0)="       Batch data entry (chem, hem, tox, etc.) [LRSTUF]"
^DIC(9.4,11,22,5.03,"PAH",32,1,108,0)="       Bypass normal data entry [LRFAST]"
^DIC(9.4,11,22,5.03,"PAH",32,1,109,0)="       Enter/verify data (Load list) [LRVRW2]"
^DIC(9.4,11,22,5.03,"PAH",32,1,110,0)="       Enter/verify data (Work list) [LRVRW]"
^DIC(9.4,11,22,5.03,"PAH",32,1,111,0)="       Enter/verify data (auto instrument) [LRVR]"
^DIC(9.4,11,22,5.03,"PAH",32,1,112,0)="       Enter/verify/modify data (manual) [LRENTER]"
^DIC(9.4,11,22,5.03,"PAH",32,1,113,0)="       Fast Bypass Data Entry/Verify [LRFASTS]"
^DIC(9.4,11,22,5.03,"PAH",32,1,114,0)="       Group verify (EA, EL, EW)[ LRGV]"
^DIC(9.4,11,22,5.03,"PAH",32,1,115,0)="       Special test accessioning [LRNONCOM]"
^DIC(9.4,11,22,5.03,"PAH",32,1,116,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,117,0)="  6.  On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",32,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,119,0)=" Note: Routine LA71 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",32,1,120,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,121,0)=" "
