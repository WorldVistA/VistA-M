^DIC(9.4,47,22,5.9,"PAH",296,0)="436 SEQ #375^3020315^1"
^DIC(9.4,47,22,5.9,"PAH",296,1,0)="^^4^4^3020315"
^DIC(9.4,47,22,5.9,"PAH",296,1,1,0)="Co-Pay Tests are incorrectly displaying as required for Inpatients.  A"
^DIC(9.4,47,22,5.9,"PAH",296,1,2,0)="previous patch (DG*5.3*358) has corrected most of the menu options for"
^DIC(9.4,47,22,5.9,"PAH",296,1,3,0)="patients who have been admitted on a domiciliary ward, and do not display"
^DIC(9.4,47,22,5.9,"PAH",296,1,4,0)="Means Test and Medication Co-payment Exemption messages."
^DIC(9.4,47,22,5.9,"PAH",297,0)="440 SEQ #376^3020315^1"
^DIC(9.4,47,22,5.9,"PAH",297,1,0)="^^3^3^3020315"
