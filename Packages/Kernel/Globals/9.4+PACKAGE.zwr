^DIC(9.4,44,22,3,"PAH",81,1,192,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,193,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,194,0)="Service Desk Manager (SDM) Ticket(s) & Overview"
^DIC(9.4,44,22,3,"PAH",81,1,195,0)="-----------------------------------------------"
^DIC(9.4,44,22,3,"PAH",81,1,196,0)="1. I16857061FY18 Consults are showing activities out of order in CPRS; "
^DIC(9.4,44,22,3,"PAH",81,1,197,0)="                 VistA FM shows activities in correct chronological order"
^DIC(9.4,44,22,3,"PAH",81,1,198,0)="  "
^DIC(9.4,44,22,3,"PAH",81,1,199,0)="Problem:"
^DIC(9.4,44,22,3,"PAH",81,1,200,0)="-------"
^DIC(9.4,44,22,3,"PAH",81,1,201,0)="Our site is experiencing issues with Consults where the activities being "
^DIC(9.4,44,22,3,"PAH",81,1,202,0)="recorded are out of order. I originally thought this was a result of the "
^DIC(9.4,44,22,3,"PAH",81,1,203,0)="CONSULT TOOLBOX tool, but there are multiple sites reporting this issue, "
^DIC(9.4,44,22,3,"PAH",81,1,204,0)="and the consensus is that this is being caused by VSE."
^DIC(9.4,44,22,3,"PAH",81,1,205,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,206,0)="Resolution:"
^DIC(9.4,44,22,3,"PAH",81,1,207,0)="----------"
^DIC(9.4,44,22,3,"PAH",81,1,208,0)="The code that saves the SCHEDULED or STATUS CHANGE event when the "
^DIC(9.4,44,22,3,"PAH",81,1,209,0)="appointment is scheduled or canceled was corrected to save the timestamp"
^DIC(9.4,44,22,3,"PAH",81,1,210,0)="correctly."
^DIC(9.4,44,22,3,"PAH",81,1,211,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,212,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,213,0)="Test Sites:"
^DIC(9.4,44,22,3,"PAH",81,1,214,0)="----------"
^DIC(9.4,44,22,3,"PAH",81,1,215,0)="TBA"
^DIC(9.4,44,22,3,"PAH",81,1,216,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,217,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,218,0)="Documentation Retrieval Instructions"
^DIC(9.4,44,22,3,"PAH",81,1,219,0)="------------------------------------ "
^DIC(9.4,44,22,3,"PAH",81,1,220,0)="Updated documentation describing the new functionality introduced by this "
^DIC(9.4,44,22,3,"PAH",81,1,221,0)="patch is available."
^DIC(9.4,44,22,3,"PAH",81,1,222,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,223,0)="The preferred method is to FTP the files from "
^DIC(9.4,44,22,3,"PAH",81,1,224,0)="ftp://download.vista.domain.ext/."
^DIC(9.4,44,22,3,"PAH",81,1,225,0)="This transmits the files from the first available FTP server. Sites may "
^DIC(9.4,44,22,3,"PAH",81,1,226,0)="also elect to retrieve software directly from a specific server as "
^DIC(9.4,44,22,3,"PAH",81,1,227,0)="follows:"
^DIC(9.4,44,22,3,"PAH",81,1,228,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,229,0)=" Hines          ftp.fo-hines.domain.ext   <ftp://ftp.fo-hines.domain.ext>"
^DIC(9.4,44,22,3,"PAH",81,1,230,0)=" Salt Lake City ftp.fo-slc.domain.ext     <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,44,22,3,"PAH",81,1,231,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,232,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,44,22,3,"PAH",81,1,233,0)="at:"
^DIC(9.4,44,22,3,"PAH",81,1,234,0)="http://www4.domain.ext/vdl/"
^DIC(9.4,44,22,3,"PAH",81,1,235,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,236,0)="Title                                          File Name          FTP Mode"
^DIC(9.4,44,22,3,"PAH",81,1,237,0)="--------------------------------------------------------------------------"
^DIC(9.4,44,22,3,"PAH",81,1,238,0)="VistA Scheduling Enhancements GUI User Guide   VSE_VA_GUI_UG.PDF  Binary"
^DIC(9.4,44,22,3,"PAH",81,1,239,0)="VistA Scheduling Enhancements Technical Manual VSE_TM.PDF         Binary"
^DIC(9.4,44,22,3,"PAH",81,1,240,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,241,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,242,0)="Patch Installation:"
^DIC(9.4,44,22,3,"PAH",81,1,243,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,244,0)=" "
^DIC(9.4,44,22,3,"PAH",81,1,245,0)="  Pre/Post Installation Overview"
^DIC(9.4,44,22,3,"PAH",81,1,246,0)="  ------------------------------"
^DIC(9.4,44,22,3,"PAH",81,1,247,0)="  The components sent with this patch GMRC*3.0*98 have been included in "
^DIC(9.4,44,22,3,"PAH",81,1,248,0)="  the Host File SD_GMRC_VSE_BUNDLE_1_5.KID. Please follow the instructions"
^DIC(9.4,44,22,3,"PAH",81,1,249,0)="  listed in the INSTALLATION INSTRUCTIONS section of the patch description"
^DIC(9.4,44,22,3,"PAH",81,1,250,0)="  for patch SD*5.3*679."
^DIC(9.4,44,22,3,"PAH",81,1,251,0)="  "
^DIC(9.4,44,22,3,"PAH",81,1,252,0)="  "
^DIC(9.4,44,22,3,"PAH",81,1,253,0)="  Installation Instructions"
^DIC(9.4,44,22,3,"PAH",81,1,254,0)="  -------------------------"
^DIC(9.4,44,22,3,"PAH",81,1,255,0)="  The components sent with this patch GMRC*3.0*98 have been included in "
^DIC(9.4,44,22,3,"PAH",81,1,256,0)="  the Host File SD_GMRC_VSE_BUNDLE_1_5.KID. Please follow the instructions"
^DIC(9.4,44,22,3,"PAH",81,1,257,0)="  listed in the INSTALLATION INSTRUCTIONS section of the patch description"
^DIC(9.4,44,22,3,"PAH",81,1,258,0)="  for patch SD*5.3*679."
^DIC(9.4,44,22,3,"PAH",82,0)="96 SEQ #85^3180706.124315^54"
^DIC(9.4,44,22,3,"PAH",83,0)="99 SEQ #90^3181101.140717^54"
^DIC(9.4,44,22,3,"PAH",83,1,0)="^^2^2^3181101"
^DIC(9.4,44,22,3,"PAH",83,1,1,0)="Added a call to Health Management Platform (HMP) API to initiate an "
^DIC(9.4,44,22,3,"PAH",83,1,2,0)="unsolicited sync action to send a comment as it is added to the consult."
^DIC(9.4,44,22,3,"PAH",84,0)="106 SEQ #91^3181101.140917^54"
^DIC(9.4,44,22,3,"PAH",84,1,0)="^^1^1^3181101"
^DIC(9.4,44,22,3,"PAH",84,1,1,0)="GMRC patch 106 test version 3"
^DIC(9.4,44,22,3,"PAH",85,0)="104 SEQ #93^3181102.155848^54"
^DIC(9.4,44,22,3,"PAH",85,1,0)="^^4^4^3181102"
^DIC(9.4,44,22,3,"PAH",85,1,1,0)="Patch GMRC*3*104 addresses the following issue:"
^DIC(9.4,44,22,3,"PAH",85,1,2,0)=" "
^DIC(9.4,44,22,3,"PAH",85,1,3,0)="1. Deleting sub-service entries in the REQUEST SERVICES [123.5] file "
^DIC(9.4,44,22,3,"PAH",85,1,4,0)="causes data integrity issues."
^DIC(9.4,44,22,3,"PAH",86,0)="107 SEQ #94^3190102.174158^54"
^DIC(9.4,44,22,3,"PAH",86,1,0)="^^6^6^3190102"
^DIC(9.4,44,22,3,"PAH",86,1,1,0)="This report is sorted by a From Date and a To Date.  The report is then "
^DIC(9.4,44,22,3,"PAH",86,1,2,0)="displayed by Consult to Service/Specialty headers along with a list of "
^DIC(9.4,44,22,3,"PAH",86,1,3,0)="the Releasing Person as a sub-header to the above header group.  The "
^DIC(9.4,44,22,3,"PAH",86,1,4,0)="sub-header has a total field which represents the number of consults"
^DIC(9.4,44,22,3,"PAH",86,1,5,0)="released by policy for each Releasing Person.  The header contains a"
^DIC(9.4,44,22,3,"PAH",86,1,6,0)="grand total of all the sub-totals."
^DIC(9.4,44,22,3,"PAH",87,0)="114 SEQ #95^3190103.162^54"
^DIC(9.4,44,22,3,"PAH",87,1,0)="^^2^2^3190103"
^DIC(9.4,44,22,3,"PAH",87,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,44,22,3,"PAH",87,1,2,0)="under GMRC*3.0*114."
^DIC(9.4,44,22,3,"PAH",88,0)="110 SEQ #98^3190201.15183^54"
^DIC(9.4,44,22,3,"PAH",89,0)="113 SEQ #99^3190301.154727^54"
^DIC(9.4,44,22,3,"PAH",90,0)="119 SEQ #100^3190402.143251^54"
^DIC(9.4,44,22,3,"PAH",90,1,0)="^^7^7^3190402"
^DIC(9.4,44,22,3,"PAH",90,1,1,0)="This patch is being released to correct a defect identified in Incident"
^DIC(9.4,44,22,3,"PAH",90,1,2,0)="INC3759691, and to add descriptions to three new reports on the Consult "
^DIC(9.4,44,22,3,"PAH",90,1,3,0)="Management menu (GMRC MGR):"
^DIC(9.4,44,22,3,"PAH",90,1,4,0)=" "
^DIC(9.4,44,22,3,"PAH",90,1,5,0)="   GR     Administratively Released Consults by Group"
^DIC(9.4,44,22,3,"PAH",90,1,6,0)="   ST     Completion Time Statistics"
^DIC(9.4,44,22,3,"PAH",90,1,7,0)="   US     Administratively Released Consults by User"
^DIC(9.4,44,22,3,"PAH",91,0)="121 SEQ #101^3190501.145824^54"
^DIC(9.4,44,22,3,"PAH",91,1,0)="^^2^2^3190501"
^DIC(9.4,44,22,3,"PAH",91,1,1,0)="This patch creates an NTE segment in the ORMO001 message which will"
^DIC(9.4,44,22,3,"PAH",91,1,2,0)="contain the UCID."
^DIC(9.4,44,22,3,"PAH",92,0)="112 SEQ #102^3190501.150006^54"
^DIC(9.4,44,22,3,"PAH",92,1,0)="^^2^2^3190501"
^DIC(9.4,44,22,3,"PAH",92,1,1,0)="GMRC PATCH 112 - Emergency patch to fix control character issues in"
^DIC(9.4,44,22,3,"PAH",92,1,2,0)="consult file, causing infinite looping in HL7 message processing"
^DIC(9.4,44,22,3,"PAH",93,0)="124 SEQ #106^3190604.175851^54"
^DIC(9.4,44,22,3,"PAH",93,1,0)="^^6^6^3190604"
^DIC(9.4,44,22,3,"PAH",93,1,1,0)="Associated patches: Informational Patch GMRC*3.0*125"
^DIC(9.4,44,22,3,"PAH",93,1,2,0)=" "
^DIC(9.4,44,22,3,"PAH",93,1,3,0)="This Decision Support Tool VistA patch includes a protocol that invokes a "
^DIC(9.4,44,22,3,"PAH",93,1,4,0)="process to retrieve the consult factor text from DST and insert it into a "
^DIC(9.4,44,22,3,"PAH",93,1,5,0)="consult comment whenever a consult order is signed that contains the "
^DIC(9.4,44,22,3,"PAH",93,1,6,0)="string ""DST ID:"" in the Reason for Request field."
^DIC(9.4,44,22,3,"PAH",94,0)="105^3190722.171056^65"
^DIC(9.4,44,22,3,"PAH",94,1,0)="^^2^2^3190722"
^DIC(9.4,44,22,3,"PAH",94,1,1,0)="GMRC*3.0*105 - Please refer to the patch description in Forum for "
^DIC(9.4,44,22,3,"PAH",94,1,2,0)="installation instructions."
^DIC(9.4,44,22,3,"PAH",95,0)="123 SEQ #121^3190815.160537^65"
^DIC(9.4,44,22,3,"PAH",95,1,0)="^^16^16^3190815"
^DIC(9.4,44,22,3,"PAH",95,1,1,0)="   The Community Care Referrals and Authorizations (CCR&A) application is "
^DIC(9.4,44,22,3,"PAH",95,1,2,0)="   an enterprise-wide system used by Community Care (CC) staff to "
^DIC(9.4,44,22,3,"PAH",95,1,3,0)="   automatically generate referrals and authorizations for all Veterans "
^DIC(9.4,44,22,3,"PAH",95,1,4,0)="   receiving care in the community. Clinical and VA CC staff located at "
^DIC(9.4,44,22,3,"PAH",95,1,5,0)="   VA Medical Centers, Outpatient Clinics, Community Based Outpatient"
^DIC(9.4,44,22,3,"PAH",95,1,6,0)="   Clinics, and VISN offices use this application.  The CCR&A solution is"
^DIC(9.4,44,22,3,"PAH",95,1,7,0)="   an integral component of the VA Community Care Information Technology"
^DIC(9.4,44,22,3,"PAH",95,1,8,0)="   (IT) architecture that allows Veterans to receive care from Community "
^DIC(9.4,44,22,3,"PAH",95,1,9,0)="   Providers. "
^DIC(9.4,44,22,3,"PAH",95,1,10,0)="   "
^DIC(9.4,44,22,3,"PAH",95,1,11,0)="   This patch builds upon the HL7 processes created in patches "
^DIC(9.4,44,22,3,"PAH",95,1,12,0)="   GMRC*3.0*99 and GMRC*3.0*106.  It includes an update to the Other"
^DIC(9.4,44,22,3,"PAH",95,1,13,0)="   Health Information (OHI) data being sent from VistA to the HealthShare"
^DIC(9.4,44,22,3,"PAH",95,1,14,0)="   Referral Management system (HSRM), adding several new OHI fields and"
^DIC(9.4,44,22,3,"PAH",95,1,15,0)="   the provider NPI value. It also allows VistA to receive consult status"
^DIC(9.4,44,22,3,"PAH",95,1,16,0)="   updates from HSRM and associated consult notes."
^DIC(9.4,44,22,3,"PAH",96,0)="134 SEQ #124^3191113.142117^65"
^DIC(9.4,44,22,3,"PAH",97,0)="139 SEQ #125^3191203.144528^65"
^DIC(9.4,44,22,3,"PAH",98,0)="146 SEQ #129^3200211.10082^65"
^DIC(9.4,44,22,3,"PAH",98,1,0)="^^3^3^3200211"
^DIC(9.4,44,22,3,"PAH",98,1,1,0)="GMRC*3.0*146"
^DIC(9.4,44,22,3,"PAH",98,1,2,0)="Add Admin Complete consult notes"
^DIC(9.4,44,22,3,"PAH",98,1,3,0)="Fix DX issue"
^DIC(9.4,44,22,3,"PAH",99,0)="152 SEQ #132^3200420.124855^70"
^DIC(9.4,44,22,3,"PAH",100,0)="88^3200624.121444^65"
^DIC(9.4,44,22,3,"PAH",100,1,0)="^^2^2^3200624"
^DIC(9.4,44,22,3,"PAH",100,1,1,0)="Companion patch for CPRS GUI v31b. Will be distributed as part of the "
^DIC(9.4,44,22,3,"PAH",100,1,2,0)="REQUIRIED bundle for 31b."
^DIC(9.4,44,22,3,"PAH",101,0)="158 SEQ #136^3200709.16285^65"
^DIC(9.4,44,22,3,"PAH",102,0)="154 SEQ #139^3201008.085836^17"
^DIC(9.4,44,22,3,"PAH",102,1,0)="^^249^249^3201008"
^DIC(9.4,44,22,3,"PAH",102,1,1,0)="When Cerner Millenium replaces any given VistA instance, it will be "
^DIC(9.4,44,22,3,"PAH",102,1,2,0)="necessary for the InterFacility Consults (IFC) system to recognize that"
^DIC(9.4,44,22,3,"PAH",102,1,3,0)="the HL7 message should no longer be routed to the VistA instance, but"
^DIC(9.4,44,22,3,"PAH",102,1,4,0)="should go to the VDIF (Veterans Data Integration and Federation) router. A"
^DIC(9.4,44,22,3,"PAH",102,1,5,0)="new status, ""C"", has already been added to the Treating Facility List"
^DIC(9.4,44,22,3,"PAH",102,1,6,0)="(#391.91) to indicate a specific site has been converted. When the new"
^DIC(9.4,44,22,3,"PAH",102,1,7,0)="status is detected within the IFC process the originally intended VistA"
^DIC(9.4,44,22,3,"PAH",102,1,8,0)="system destination will be changed to one of 4 VDIF production routers"
^DIC(9.4,44,22,3,"PAH",102,1,9,0)="that are regionally located."
^DIC(9.4,44,22,3,"PAH",102,1,10,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,11,0)="The generated HL7 message will not route to the converted VistA but to the"
^DIC(9.4,44,22,3,"PAH",102,1,12,0)="appropriate VDIF Regional Router. This will happen via one of the 4 GMRC"
^DIC(9.4,44,22,3,"PAH",102,1,13,0)="IFC Logical Links that are included in this patch. These links are"
^DIC(9.4,44,22,3,"PAH",102,1,14,0)="designated ""GMRC IFC1"" through ""GMRC IFC4""."
^DIC(9.4,44,22,3,"PAH",102,1,15,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,16,0)="In the case of test systems, a fifth GMRC IFC Logical Link is included "
^DIC(9.4,44,22,3,"PAH",102,1,17,0)="labeled ""GMRC IFC0"", this Logical Link has no configuration included and"
^DIC(9.4,44,22,3,"PAH",102,1,18,0)="will need to be setup to send to the appropriate VDIF Test router. As"
^DIC(9.4,44,22,3,"PAH",102,1,19,0)="there are numerous test systems involved the Logical Link configuration"
^DIC(9.4,44,22,3,"PAH",102,1,20,0)="will need to be done manually for test systems. As there is an unknown"
^DIC(9.4,44,22,3,"PAH",102,1,21,0)="number of test configurations, the local test site will need to determine"
^DIC(9.4,44,22,3,"PAH",102,1,22,0)="the appropriate values for the test Logical Link."
^DIC(9.4,44,22,3,"PAH",102,1,23,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,24,0)="The Test system is determined by the presence of the ^%ZOSF(""TEST"") node "
^DIC(9.4,44,22,3,"PAH",102,1,25,0)="on the installed system."
^DIC(9.4,44,22,3,"PAH",102,1,26,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,27,0)="If there is a need to change the automatically assigned VDIF Logical Link"
^DIC(9.4,44,22,3,"PAH",102,1,28,0)="this information is held in a new Parameter, GMRC IFC REGIONAL ROUTER"
^DIC(9.4,44,22,3,"PAH",102,1,29,0)="which contains the name of the Logical Link to be used when a converted"
^DIC(9.4,44,22,3,"PAH",102,1,30,0)="site is detected by the IFC system."
^DIC(9.4,44,22,3,"PAH",102,1,31,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,32,0)="If this installation is in a Test system, the default VDIF router will be"
^DIC(9.4,44,22,3,"PAH",102,1,33,0)="GMRC IFC0 which will require the manual entry of the URL and Port to be"
^DIC(9.4,44,22,3,"PAH",102,1,34,0)="used to connect to the Test VDIF router."
^DIC(9.4,44,22,3,"PAH",102,1,35,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,36,0)="Fileman should be used to add this information. You will need to acquire"
^DIC(9.4,44,22,3,"PAH",102,1,37,0)="the correct test VDIF Router from the appropriate IT personnel involved in"
^DIC(9.4,44,22,3,"PAH",102,1,38,0)="the Cerner Testing and Deployment."
^DIC(9.4,44,22,3,"PAH",102,1,39,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,40,0)="The steps for adding this information are as follows:"
^DIC(9.4,44,22,3,"PAH",102,1,41,0)=" VISTA>D P^DI"
^DIC(9.4,44,22,3,"PAH",102,1,42,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,43,0)=" VA FileMan 22.2"
^DIC(9.4,44,22,3,"PAH",102,1,44,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,45,0)=" Select OPTION: 1 ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,44,22,3,"PAH",102,1,46,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,47,0)=" Input to what File: HL LOGICAL LINK// (141 entries)"
^DIC(9.4,44,22,3,"PAH",102,1,48,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,49,0)=" EDIT WHICH FIELD: ALL// <<<< you can enter DNS DOMAIN,or TCP/IP ADDRESS"
^DIC(9.4,44,22,3,"PAH",102,1,50,0)=" and you will need to add TCP/IP PORT"
^DIC(9.4,44,22,3,"PAH",102,1,51,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,52,0)=" Select HL LOGICAL LINK NODE: GMRC IFC0 "
^DIC(9.4,44,22,3,"PAH",102,1,53,0)=" DNS DOMAIN: <<< you can enter a URL here OR"
^DIC(9.4,44,22,3,"PAH",102,1,54,0)=" TCP/IP ADDRESS: <<< or you can enter a TCP/IP address here"
^DIC(9.4,44,22,3,"PAH",102,1,55,0)=" TCP/IP PORT: <<< Enter a port number"
^DIC(9.4,44,22,3,"PAH",102,1,56,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,57,0)="You will need to consult with IT involved with the Cerner Implementation"
^DIC(9.4,44,22,3,"PAH",102,1,58,0)="And Testing in order to get the properly values for your test system"
^DIC(9.4,44,22,3,"PAH",102,1,59,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,60,0)="Back-Out Plan: "
^DIC(9.4,44,22,3,"PAH",102,1,61,0)="--------------------"
^DIC(9.4,44,22,3,"PAH",102,1,62,0)="If there is a need to backout this patch. The routine save that was made "
^DIC(9.4,44,22,3,"PAH",102,1,63,0)="at the time of install will need to be used to overwrite the routines in"
^DIC(9.4,44,22,3,"PAH",102,1,64,0)="this patch. Once this is done the other elements included in this patch"
^DIC(9.4,44,22,3,"PAH",102,1,65,0)="will become non-functional and incapable of affecting the system."
^DIC(9.4,44,22,3,"PAH",102,1,66,0)="_________________________________________________________________________"
^DIC(9.4,44,22,3,"PAH",102,1,67,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,68,0)=" Defect: <UNDEFINED>OTHER+13^GMRCIACT ^GMR(123,370322041,12)"
^DIC(9.4,44,22,3,"PAH",102,1,69,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,70,0)=" This patch addresses the following defect that occurs when Cerner sends"
^DIC(9.4,44,22,3,"PAH",102,1,71,0)=" an update via HL7 to a previously filed Vista Prosthetics IFC order:"
^DIC(9.4,44,22,3,"PAH",102,1,72,0)=" ERROR TEXT: <UNDEFINED>OTHER+13^GMRCIACT ^GMR(123,370322041,12)"
^DIC(9.4,44,22,3,"PAH",102,1,73,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,74,0)=" The error occurs when the Vista Consult Request Tracking Interfacility"
^DIC(9.4,44,22,3,"PAH",102,1,75,0)=" Consult (IFC) processing logic assuming the incoming Cerner Order number"
^DIC(9.4,44,22,3,"PAH",102,1,76,0)=" is a local Consult order number. Prior to EHRM Prosthetics IFC, there "
^DIC(9.4,44,22,3,"PAH",102,1,77,0)=" were always two different Vista stations involved in an IFC transaction. "
^DIC(9.4,44,22,3,"PAH",102,1,78,0)=" With the implementation of the EHRM Prosthetics IFC interface, both the "
^DIC(9.4,44,22,3,"PAH",102,1,79,0)=" Placer System (Cerner) order number and the Filler System (Vista "
^DIC(9.4,44,22,3,"PAH",102,1,80,0)=" Prosthetics) order number are associated with the same Vista station."
^DIC(9.4,44,22,3,"PAH",102,1,81,0)=" As a result, checking the station number associated with the consult "
^DIC(9.4,44,22,3,"PAH",102,1,82,0)=" order is not sufficient to determine which order (Placer or Filler) is "
^DIC(9.4,44,22,3,"PAH",102,1,83,0)=" the local order."
^DIC(9.4,44,22,3,"PAH",102,1,84,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,85,0)=" To address this issue, Consults Request Tracking will use the Filler "
^DIC(9.4,44,22,3,"PAH",102,1,86,0)=" System order number as the local order number if the following are true:"
^DIC(9.4,44,22,3,"PAH",102,1,87,0)="   1) The Filler System station is equal to the Placer System station"
^DIC(9.4,44,22,3,"PAH",102,1,88,0)="    -AND-"
^DIC(9.4,44,22,3,"PAH",102,1,89,0)="   2) The incoming IFC message is a PROSTHETICS IFC order"
^DIC(9.4,44,22,3,"PAH",102,1,90,0)="    -AND-"
^DIC(9.4,44,22,3,"PAH",102,1,91,0)="   3) The Filler System station is equal to the local system's station"
^DIC(9.4,44,22,3,"PAH",102,1,92,0)="    -AND-"
^DIC(9.4,44,22,3,"PAH",102,1,93,0)="   4) The Filler System order exists in local REQUEST/COSULTATION file "
^DIC(9.4,44,22,3,"PAH",102,1,94,0)="      (#123)."
^DIC(9.4,44,22,3,"PAH",102,1,95,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,96,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,97,0)="Patch Components:"
^DIC(9.4,44,22,3,"PAH",102,1,98,0)="----------------"
