^DIC(9.4,175,22,2,"PAH",114,1,1,0)="VistA Imaging V3.0 Patch 168 - BACKGROUND PROCESSOR 2012 Windows Compliant"
^DIC(9.4,175,22,2,"PAH",114,1,2,0)=" - This patch tests the BP to ensure it works with Windows Server 2012"
