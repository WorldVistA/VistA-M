^DIC(9.4,104,22,7,"PAH",3,0)="5^2961230^1"
^DIC(9.4,104,22,7,"PAH",3,1,0)="^^4^4^2961230"
^DIC(9.4,104,22,7,"PAH",3,1,1,0)="This patch fixes a problem reported in E3R #8958. The Create Vital"
^DIC(9.4,104,22,7,"PAH",3,1,2,0)="Measurement Quick Order Protocol [GMRVORQUICK] option limits the creation"
^DIC(9.4,104,22,7,"PAH",3,1,3,0)="of quick orders to one quick order per vital measurement. This is wrong."
^DIC(9.4,104,22,7,"PAH",3,1,4,0)="It should allow any number of quick orders per vital measurement."
