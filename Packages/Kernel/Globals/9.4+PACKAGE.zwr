^DIC(9.4,73,22,9,"PAH",22,1,43,0)=" "
^DIC(9.4,73,22,9,"PAH",22,1,44,0)="INSTALLATION:"
^DIC(9.4,73,22,9,"PAH",22,1,45,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",22,1,46,0)="is at a minimum.  It requires patch AFJX*5.1*33."
^DIC(9.4,73,22,9,"PAH",22,1,47,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,73,22,9,"PAH",22,1,48,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,73,22,9,"PAH",22,1,49,0)="    affected routine(s).  "
^DIC(9.4,73,22,9,"PAH",22,1,50,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,73,22,9,"PAH",22,1,51,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,73,22,9,"PAH",22,1,52,0)="4.  You do not need to stop TaskMan.  Users may be on the system."
^DIC(9.4,73,22,9,"PAH",22,1,53,0)="5.  On the KIDS:Installation menu, use the following options to install"
^DIC(9.4,73,22,9,"PAH",22,1,54,0)="    the Transport Global."
^DIC(9.4,73,22,9,"PAH",22,1,55,0)="       Verify Checksums in Transport Global"
^DIC(9.4,73,22,9,"PAH",22,1,56,0)="       Print Transport Global"
^DIC(9.4,73,22,9,"PAH",22,1,57,0)="       Compare Transport Global to Current System"
^DIC(9.4,73,22,9,"PAH",22,1,58,0)="       Backup a Transport Global"
^DIC(9.4,73,22,9,"PAH",22,1,59,0)="       Install Package(s)"
^DIC(9.4,73,22,9,"PAH",22,1,60,0)=" Select INSTALL NAME:   AFJX*5.1*34   Loaded from Distribution <date/time>"
^DIC(9.4,73,22,9,"PAH",22,1,61,0)="                        ==========="
^DIC(9.4,73,22,9,"PAH",22,1,62,0)=" Install Questions:"
^DIC(9.4,73,22,9,"PAH",22,1,63,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,73,22,9,"PAH",22,1,64,0)="                                                       =="
^DIC(9.4,73,22,9,"PAH",22,1,65,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,73,22,9,"PAH",22,1,66,0)="                                                                       =="
^DIC(9.4,73,22,9,"PAH",22,1,67,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,73,22,9,"PAH",22,1,68,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,73,22,9,"PAH",22,1,69,0)=" Enter a '^' to abort the install."
^DIC(9.4,73,22,9,"PAH",22,1,70,0)=" "
^DIC(9.4,73,22,9,"PAH",22,1,71,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,73,22,9,"PAH",22,1,72,0)="                ------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",22,1,73,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if"
^DIC(9.4,73,22,9,"PAH",22,1,74,0)="    necessary."
^DIC(9.4,73,22,9,"PAH",22,1,75,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",23,0)="35 SEQ #30^3030520^1"
^DIC(9.4,73,22,9,"PAH",23,1,0)="^^107^107^3030520"
^DIC(9.4,73,22,9,"PAH",23,1,1,0)="Patch AFJX*5.1*35"
^DIC(9.4,73,22,9,"PAH",23,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",23,1,3,0)="NOIS: WRJ-0403-11925, SFC-0403-61371"
^DIC(9.4,73,22,9,"PAH",23,1,4,0)="Test Sites: White River Junction, VT; San Francisco VAMC; Erie, PA"
^DIC(9.4,73,22,9,"PAH",23,1,5,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,6,0)="The problem concerns the following menu in option [AFJXNHEX REQUEST]"
^DIC(9.4,73,22,9,"PAH",23,1,7,0)="Network Health Exchange Options:"
^DIC(9.4,73,22,9,"PAH",23,1,8,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,9,0)="VistA Network Health Exchange Menu            TRUSTED,USER"
^DIC(9.4,73,22,9,"PAH",23,1,10,0)="====================================================================="
^DIC(9.4,73,22,9,"PAH",23,1,11,0)="     Select one of the following:"
^DIC(9.4,73,22,9,"PAH",23,1,12,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,13,0)="          1         Brief (12 months) Medical Record Information"
^DIC(9.4,73,22,9,"PAH",23,1,14,0)="          2         Total Medical Record Information"
^DIC(9.4,73,22,9,"PAH",23,1,15,0)="          3         Brief (12 months) Pharmacy Information"
^DIC(9.4,73,22,9,"PAH",23,1,16,0)="          4         Total Pharmacy Information"
^DIC(9.4,73,22,9,"PAH",23,1,17,0)="          5         Print (Completed Requests Only)"
^DIC(9.4,73,22,9,"PAH",23,1,18,0)="          6         Print By Type of Information (Completed Requests)"
^DIC(9.4,73,22,9,"PAH",23,1,19,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,20,0)="Option #6 chops off ""Discharge Summary"" and ""Progress Notes"" before"
^DIC(9.4,73,22,9,"PAH",23,1,21,0)="displaying them completely.  They can be fully seen in option #5."
^DIC(9.4,73,22,9,"PAH",23,1,22,0)="This patch fixes the problem."
^DIC(9.4,73,22,9,"PAH",23,1,23,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,24,0)="As an added bonus, we are adding a cross reference to the NAME (#.01)"
^DIC(9.4,73,22,9,"PAH",23,1,25,0)="field of the VAMC NETWORK HEALTH TYPES (#537015) file.  The new C cross"
^DIC(9.4,73,22,9,"PAH",23,1,26,0)="reference will be all upper-case, so that the user doesn't have to enter"
^DIC(9.4,73,22,9,"PAH",23,1,27,0)="the exact mixed case component name during ^DIC lookups.  The post-init,"
^DIC(9.4,73,22,9,"PAH",23,1,28,0)="POST^AFJXYP35, will create the new cross reference."
^DIC(9.4,73,22,9,"PAH",23,1,29,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,30,0)="STANDARD DATA DICTIONARY #537015 -- VAMC NETWORK HEALTH TYPES FILE"
^DIC(9.4,73,22,9,"PAH",23,1,31,0)="STORED IN ^AFJ(537015,                               (VERSION 5.1)"
^DIC(9.4,73,22,9,"PAH",23,1,32,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,33,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,73,22,9,"PAH",23,1,34,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,73,22,9,"PAH",23,1,35,0)="----------------------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",23,1,36,0)="537015,.01 NAME                   0;1 FREE TEXT (Required)"
^DIC(9.4,73,22,9,"PAH",23,1,37,0)="           INPUT TRANSFORM:  K:$L(X)>30!(X?.N)!($L(X)<3)!'(X'?1P.E) X"
^DIC(9.4,73,22,9,"PAH",23,1,38,0)="           LAST EDITED:      APR 30, 2003"
^DIC(9.4,73,22,9,"PAH",23,1,39,0)="           HELP-PROMPT:      NAME MUST BE 3-30 CHARACTERS, NOT NUMERIC OR"
^DIC(9.4,73,22,9,"PAH",23,1,40,0)="                             STARTING WITH PUNCTUATION"
^DIC(9.4,73,22,9,"PAH",23,1,41,0)="           CROSS-REFERENCE:  537015^B"
^DIC(9.4,73,22,9,"PAH",23,1,42,0)="                             1)= S ^AFJ(537015,""B"",$E(X,1,30),DA)="""""
^DIC(9.4,73,22,9,"PAH",23,1,43,0)="                             2)= K ^AFJ(537015,""B"",$E(X,1,30),DA)"
^DIC(9.4,73,22,9,"PAH",23,1,44,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,45,0)="           FIELD INDEX:      C (#30)    REGULAR    IR    LOOKUP & SORTING"
^DIC(9.4,73,22,9,"PAH",23,1,46,0)="               Short Descr:  All upper-case"
^DIC(9.4,73,22,9,"PAH",23,1,47,0)="               Description:  This xref is all upper-case to ease DIC"
^DIC(9.4,73,22,9,"PAH",23,1,48,0)="                             lookups."
^DIC(9.4,73,22,9,"PAH",23,1,49,0)="                 Set Logic:  S ^AFJ(537015,""C"",$E(X,1,30),DA)="""""
^DIC(9.4,73,22,9,"PAH",23,1,50,0)="                Kill Logic:  K ^AFJ(537015,""C"",$E(X,1,30),DA)"
^DIC(9.4,73,22,9,"PAH",23,1,51,0)="                Whole Kill:  K ^AFJ(537015,""C"")"
^DIC(9.4,73,22,9,"PAH",23,1,52,0)="                      X(1):  NAME  (537015,.01)  (Subscr 1)  (Len 30)"
^DIC(9.4,73,22,9,"PAH",23,1,53,0)="                             (forwards)"
^DIC(9.4,73,22,9,"PAH",23,1,54,0)="                               Transform (Storage):  S X=$$UP^XLFSTR(X)"
^DIC(9.4,73,22,9,"PAH",23,1,55,0)="                                Transform (Lookup):  S X=$$UP^XLFSTR(X)"
^DIC(9.4,73,22,9,"PAH",23,1,56,0)=""
^DIC(9.4,73,22,9,"PAH",23,1,57,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",23,1,58,0)="is at a minimum.  It requires patch AFJX*5.1*34."
