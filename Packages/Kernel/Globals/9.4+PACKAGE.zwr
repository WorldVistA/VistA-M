^DIC(9.4,59,22,5,"PAH",477,1,5,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",477,1,6,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",477,1,7,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",477,1,8,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",477,1,9,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",477,1,10,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",477,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",477,1,12,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",477,1,13,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",477,1,14,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",477,1,15,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",477,1,16,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",477,1,17,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",478,0)="476 SEQ #479^3161028.150728^54"
^DIC(9.4,59,22,5,"PAH",479,0)="497^3161028.151151^54"
^DIC(9.4,59,22,5,"PAH",479,1,0)="^^16^16^3161028"
^DIC(9.4,59,22,5,"PAH",479,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",479,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",479,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",479,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",479,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",479,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",479,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",479,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",479,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",479,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",479,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",479,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",479,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",479,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",479,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",479,1,16,0)="are no longer primary ingredients."
