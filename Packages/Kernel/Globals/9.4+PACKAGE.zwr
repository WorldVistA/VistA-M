^DIC(9.4,35,22,3,"PAH",197,0)="222 SEQ #201^3041111^1"
^DIC(9.4,35,22,3,"PAH",197,1,0)="^^1^1^3041111"
^DIC(9.4,35,22,3,"PAH",197,1,1,0)="Group Notes"
^DIC(9.4,35,22,3,"PAH",198,0)="225 SEQ #202^3041126^1"
^DIC(9.4,35,22,3,"PAH",198,1,0)="^^1^1^3041126"
^DIC(9.4,35,22,3,"PAH",198,1,1,0)="Update to performance monitor to exclude Non-VA med entries."
^DIC(9.4,35,22,3,"PAH",199,0)="157^3041228^1"
^DIC(9.4,35,22,3,"PAH",199,1,0)="^^1^1^3041228"
^DIC(9.4,35,22,3,"PAH",199,1,1,0)="Implement Clinical Reminders index."
^DIC(9.4,35,22,3,"PAH",200,0)="227 SEQ #204^3041228^1"
^DIC(9.4,35,22,3,"PAH",200,1,0)="^^1^1^3041228"
^DIC(9.4,35,22,3,"PAH",200,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",201,0)="217 SEQ #205^3050204^1"
^DIC(9.4,35,22,3,"PAH",201,1,0)="^^126^126^3050204"
^DIC(9.4,35,22,3,"PAH",201,1,1,0)="Patch Description:"
^DIC(9.4,35,22,3,"PAH",201,1,2,0)="=================="
^DIC(9.4,35,22,3,"PAH",201,1,3,0)="This patch provides a utility, consisting of a set of three routines, to "
^DIC(9.4,35,22,3,"PAH",201,1,4,0)="find records in the ORDERABLE ITEM FILE # 101.43 which do not have "
^DIC(9.4,35,22,3,"PAH",201,1,5,0)="matching records in their source files. It will flag any active Orderable "
^DIC(9.4,35,22,3,"PAH",201,1,6,0)="Item record without a matching source record as inactive and print a "
^DIC(9.4,35,22,3,"PAH",201,1,7,0)="detailed report of its findings."
^DIC(9.4,35,22,3,"PAH",201,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,9,0)="The issue is an active orderable item record that does not have a "
^DIC(9.4,35,22,3,"PAH",201,1,10,0)="matching source record. To address this issue a utility has been written "
^DIC(9.4,35,22,3,"PAH",201,1,11,0)="that will perform an analysis of the ORDERABLE ITEM FILE, file # 101.43, "
^DIC(9.4,35,22,3,"PAH",201,1,12,0)="and produce a detailed report of its findings. This utility will scan the "
^DIC(9.4,35,22,3,"PAH",201,1,13,0)="the ORDERABLE ITEM FILE record by record. This utility  determines the "
^DIC(9.4,35,22,3,"PAH",201,1,14,0)="following about the current ORDBERABLE ITEM FILE record being processed:"
^DIC(9.4,35,22,3,"PAH",201,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,16,0)="1. Is the ID field null?"
^DIC(9.4,35,22,3,"PAH",201,1,17,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,18,0)="2. Is the source record IEN stored in the ID field null?"
^DIC(9.4,35,22,3,"PAH",201,1,19,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,20,0)="3. Is the source record package code stored in the ID field null?"
^DIC(9.4,35,22,3,"PAH",201,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,22,0)="4. Is the data stored in the ID field properly formatted?"
^DIC(9.4,35,22,3,"PAH",201,1,23,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,24,0)="5. Is the source record package code part of the current interface "
^DIC(9.4,35,22,3,"PAH",201,1,25,0)="specification?"
^DIC(9.4,35,22,3,"PAH",201,1,26,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,27,0)="6. Is there a matching source record?"
^DIC(9.4,35,22,3,"PAH",201,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,29,0)="7. Is it currently flagged as active?"
^DIC(9.4,35,22,3,"PAH",201,1,30,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,31,0)="A temporary global is build tracking all of the above for a detailed "
^DIC(9.4,35,22,3,"PAH",201,1,32,0)="report. Only an ORDERABLE ITEM FILE record passing all tests is modified."
^DIC(9.4,35,22,3,"PAH",201,1,33,0)="At this point it will be flagged as inactive effective immediately. After"
^DIC(9.4,35,22,3,"PAH",201,1,34,0)="the utility has printed its report the temporary global created by this"
^DIC(9.4,35,22,3,"PAH",201,1,35,0)="utility is deleted. The utility is to be run at any time the null"
^DIC(9.4,35,22,3,"PAH",201,1,36,0)="subscript error is encountered during the ordering process."
^DIC(9.4,35,22,3,"PAH",201,1,37,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,38,0)="It is these invalid orderable items with no matching source records that "
^DIC(9.4,35,22,3,"PAH",201,1,39,0)="are generating the NULLSUBSCR errors described in the associated NOIS "
^DIC(9.4,35,22,3,"PAH",201,1,40,0)="cases. The flagging of records in the ORDERABLE ITEM FILE # 101.43 "
^DIC(9.4,35,22,3,"PAH",201,1,41,0)="without matching source records as inactive will prevent CPRS GUI from "
^DIC(9.4,35,22,3,"PAH",201,1,42,0)="presenting them to the user as valid orderable items. The routines in "
^DIC(9.4,35,22,3,"PAH",201,1,43,0)="this patch can be run anytime a selected orderable item generates the "
^DIC(9.4,35,22,3,"PAH",201,1,44,0)="NULLSUBSCR error."
^DIC(9.4,35,22,3,"PAH",201,1,45,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,46,0)="Associated NOIS:"
^DIC(9.4,35,22,3,"PAH",201,1,47,0)="================"
^DIC(9.4,35,22,3,"PAH",201,1,48,0)="1. ALB-1001-51034 - UNDEF VAR LOAD+6~ORWDLR32"
^DIC(9.4,35,22,3,"PAH",201,1,49,0)="2. DAN-0204-42157 - Error on Order of Lab Test"
^DIC(9.4,35,22,3,"PAH",201,1,50,0)="3. NJH-0402-20607 - Receiving error message in CPRS"
^DIC(9.4,35,22,3,"PAH",201,1,51,0)="4. SBY-0803-30443 - LOAD+4~ORWDLR32:1,%DSM-E-NULLSUBSCR"
^DIC(9.4,35,22,3,"PAH",201,1,52,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,53,0)="OPTIONS"
^DIC(9.4,35,22,3,"PAH",201,1,54,0)="======="
^DIC(9.4,35,22,3,"PAH",201,1,55,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,56,0)="CPRS Clean-up Utilities menu (ORE MGR, a menu option) was modified. A new "
^DIC(9.4,35,22,3,"PAH",201,1,57,0)="option was added to it."
^DIC(9.4,35,22,3,"PAH",201,1,58,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,59,0)="Orderable Items Records Validation (ORE ORDERABLE ITEMS VALIDATION, a run "
^DIC(9.4,35,22,3,"PAH",201,1,60,0)="routine option) was created. It has been added to the CPRS Clean-up "
^DIC(9.4,35,22,3,"PAH",201,1,61,0)="Utilities menu."
^DIC(9.4,35,22,3,"PAH",201,1,62,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,63,0)="The menu path to the new option is:"
^DIC(9.4,35,22,3,"PAH",201,1,64,0)="        CPRS Manger Menu"
^DIC(9.4,35,22,3,"PAH",201,1,65,0)="        CPRS Configuration (IRM) - IR"
^DIC(9.4,35,22,3,"PAH",201,1,66,0)="        CPRS Clean-up Utilities - UT"
^DIC(9.4,35,22,3,"PAH",201,1,67,0)="        Orderable Items Records Validation - OI"
^DIC(9.4,35,22,3,"PAH",201,1,68,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,69,0)="HOW TO RUN THE UTILITY:"
^DIC(9.4,35,22,3,"PAH",201,1,70,0)="======================="
^DIC(9.4,35,22,3,"PAH",201,1,71,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,72,0)="1. Enter the ""CPRS Manager Menu""."
^DIC(9.4,35,22,3,"PAH",201,1,73,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,74,0)="2. Select the ""CPRS Configuration (IRM)"" option."
^DIC(9.4,35,22,3,"PAH",201,1,75,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,76,0)="3. Select the ""CPRS Clean-up Utilities"" option."
^DIC(9.4,35,22,3,"PAH",201,1,77,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,78,0)="4. Select the ""Orderable Items Records Validation"" option."
^DIC(9.4,35,22,3,"PAH",201,1,79,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,80,0)="5. The user will be presented with a screen with a brief description of "
^DIC(9.4,35,22,3,"PAH",201,1,81,0)="the option's functionality. At the ""Do you wish to run this program? "
^DIC(9.4,35,22,3,"PAH",201,1,82,0)="Enter Yes or No?"" prompt enter Y for yes. Entering N for No will return "
^DIC(9.4,35,22,3,"PAH",201,1,83,0)="the user to the menu."
^DIC(9.4,35,22,3,"PAH",201,1,84,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,85,0)="6. The user will be prompted for a device for the utilities output. The "
^DIC(9.4,35,22,3,"PAH",201,1,86,0)="output can be sent to the terminal screen. A printer for hard copy can be "
^DIC(9.4,35,22,3,"PAH",201,1,87,0)="selected. This is recommended. It can be queued to the Kernel Spool and "
^DIC(9.4,35,22,3,"PAH",201,1,88,0)="set to run at a preferred later time. "
^DIC(9.4,35,22,3,"PAH",201,1,89,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,90,0)="ROUTINE SUMMARY:"
^DIC(9.4,35,22,3,"PAH",201,1,91,0)="================"
^DIC(9.4,35,22,3,"PAH",201,1,92,0)="The following routines are included in this patch.  The second line of "
^DIC(9.4,35,22,3,"PAH",201,1,93,0)="each of these routines now looks like:"
^DIC(9.4,35,22,3,"PAH",201,1,94,0)=" ;;3.0;ORDER ENTRY/RESULTS REPORTING;**[Patch List]**;Dec 17, 1997"
^DIC(9.4,35,22,3,"PAH",201,1,95,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,96,0)="Routine name    Before Patch    After Patch        Patch List"
^DIC(9.4,35,22,3,"PAH",201,1,97,0)="============    ============    ===========        =========="
^DIC(9.4,35,22,3,"PAH",201,1,98,0)="OREORV                   N/A       4346077             217"
^DIC(9.4,35,22,3,"PAH",201,1,99,0)="OREORV1                  N/A       3985270             217"
^DIC(9.4,35,22,3,"PAH",201,1,100,0)="OREORV2                  N/A       8511634             217"
^DIC(9.4,35,22,3,"PAH",201,1,101,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,102,0)="Installation Instructions:"
^DIC(9.4,35,22,3,"PAH",201,1,103,0)="=========================="
^DIC(9.4,35,22,3,"PAH",201,1,104,0)="This patch should be loaded during non-peak hours to minimize disruption "
^DIC(9.4,35,22,3,"PAH",201,1,105,0)="to users. Installation should take less than 2 minutes. Users are allowed "
^DIC(9.4,35,22,3,"PAH",201,1,106,0)="to be on the system during the installation. TaskMan does not need to be "
^DIC(9.4,35,22,3,"PAH",201,1,107,0)="stopped."
^DIC(9.4,35,22,3,"PAH",201,1,108,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,109,0)="1. Use the INSTALL/CHECK MESSAGE option on the PackMan menu."
^DIC(9.4,35,22,3,"PAH",201,1,110,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,111,0)="2. From the Kernel Installation and Distribution System Menu, select the "
^DIC(9.4,35,22,3,"PAH",201,1,112,0)="Installation menu."
^DIC(9.4,35,22,3,"PAH",201,1,113,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,114,0)="3. From this menu, you may elect to use the following options (when "
^DIC(9.4,35,22,3,"PAH",201,1,115,0)="prompted for INSTALL NAME, enter OR*3.0*217):"
^DIC(9.4,35,22,3,"PAH",201,1,116,0)="    a. Backup a Transport Global"
^DIC(9.4,35,22,3,"PAH",201,1,117,0)="    b. Compare Transport Global to Current System"
^DIC(9.4,35,22,3,"PAH",201,1,118,0)="    c. Verify Checksums in Transport Global"
^DIC(9.4,35,22,3,"PAH",201,1,119,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,120,0)="4. Use the Install Package(s) options and select the package OR*3.0*217."
^DIC(9.4,35,22,3,"PAH",201,1,121,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,122,0)="5. When prompted 'Want KIDS to INHIBIT LOGONS during install? YES//', "
^DIC(9.4,35,22,3,"PAH",201,1,123,0)="respond ""NO""."
^DIC(9.4,35,22,3,"PAH",201,1,124,0)=" "
^DIC(9.4,35,22,3,"PAH",201,1,125,0)="6. When prompted 'Want to DISABLE Scheduled Options, Menu Options and "
^DIC(9.4,35,22,3,"PAH",201,1,126,0)="Protocols? YES//', respond ""NO""."
^DIC(9.4,35,22,3,"PAH",202,0)="195^3050204^1"
^DIC(9.4,35,22,3,"PAH",203,0)="216 SEQ #207^3050212^1"
^DIC(9.4,35,22,3,"PAH",203,1,0)="^^3^3^3050212"
^DIC(9.4,35,22,3,"PAH",203,1,1,0)="CPRS M-side changes in support of removing allergies as"
^DIC(9.4,35,22,3,"PAH",203,1,2,0)="orders.  Please see the forum module for a complete description"
^DIC(9.4,35,22,3,"PAH",203,1,3,0)="of this patch."
^DIC(9.4,35,22,3,"PAH",204,0)="226^3050311^1"
^DIC(9.4,35,22,3,"PAH",205,0)="210^3050311^1"
^DIC(9.4,35,22,3,"PAH",206,0)="231^3050506^1"
^DIC(9.4,35,22,3,"PAH",207,0)="229 SEQ #212^3050506^1"
^DIC(9.4,35,22,3,"PAH",208,0)="211^3050525^1"
^DIC(9.4,35,22,3,"PAH",209,0)="234 SEQ #215^3050625^1"
^DIC(9.4,35,22,3,"PAH",210,0)="235^3050709^1"
^DIC(9.4,35,22,3,"PAH",211,0)="233 SEQ #217^3050813^1"
^DIC(9.4,35,22,3,"PAH",211,1,0)="^^2^2^3050813"
^DIC(9.4,35,22,3,"PAH",211,1,1,0)="Support for allergy data standardization updates that are needed"
^DIC(9.4,35,22,3,"PAH",211,1,2,0)="in the CPRS package.  Please see FORUM for a complete description."
^DIC(9.4,35,22,3,"PAH",212,0)="221 SEQ #218^3051020^1"
^DIC(9.4,35,22,3,"PAH",213,0)="239 SEQ #219^3051020^1"
^DIC(9.4,35,22,3,"PAH",213,1,0)="^^1^1^3051020"
^DIC(9.4,35,22,3,"PAH",213,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",214,0)="220 SEQ #220^3051115^1"
^DIC(9.4,35,22,3,"PAH",215,0)="240 SEQ #221^3051221^1"
^DIC(9.4,35,22,3,"PAH",216,0)="241 SEQ #222^3060112^1"
^DIC(9.4,35,22,3,"PAH",216,1,0)="^^1^1^3060112"
^DIC(9.4,35,22,3,"PAH",216,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",217,0)="237^3060308^1"
^DIC(9.4,35,22,3,"PAH",217,1,0)="^^2^2^3060308"
^DIC(9.4,35,22,3,"PAH",217,1,1,0)="This the OR part of a multi package patch to add Additional IV Drug Units"
^DIC(9.4,35,22,3,"PAH",217,1,2,0)="- MG-PE & NANOGRAM the primary patch will be in PSJ*5.0*152."
^DIC(9.4,35,22,3,"PAH",218,0)="247 SEQ #224^3060410^1"
^DIC(9.4,35,22,3,"PAH",218,1,0)="^^1^1^3060410"
^DIC(9.4,35,22,3,"PAH",218,1,1,0)="CORRECT THE FILING OF THE PATIENT NAME IN THE AUTO LINKED LIST PROCESS. "
^DIC(9.4,35,22,3,"PAH",219,0)="215^3060505^1"
^DIC(9.4,35,22,3,"PAH",219,1,0)="^^1^1^3060505"
^DIC(9.4,35,22,3,"PAH",219,1,1,0)="CPRS GUI 26"
^DIC(9.4,35,22,3,"PAH",220,0)="251 SEQ #226^3060526^1"
^DIC(9.4,35,22,3,"PAH",221,0)="258^3060711^1"
^DIC(9.4,35,22,3,"PAH",222,0)="257 SEQ #228^3060711^1"
^DIC(9.4,35,22,3,"PAH",222,1,0)="^^1^1^3060711"
^DIC(9.4,35,22,3,"PAH",222,1,1,0)="UPDATING ORWRP TIME/OCC LIMITS ALL PARAMETER"
^DIC(9.4,35,22,3,"PAH",223,0)="264 SEQ #229^3060807^1"
^DIC(9.4,35,22,3,"PAH",223,1,0)="^^3^3^3060807"
^DIC(9.4,35,22,3,"PAH",223,1,1,0)=" This patch fixes an incorrect Web address for activating VistaWeb from"
^DIC(9.4,35,22,3,"PAH",223,1,2,0)=" CPRS. The parameter: ORWRP VISTAWEB ADDRESS is changed to:"
^DIC(9.4,35,22,3,"PAH",223,1,3,0)="  ""https://vistaweb.domain.ext/ToolsPage.aspx"""
^DIC(9.4,35,22,3,"PAH",224,0)="253 SEQ #230^3060923^1"
^DIC(9.4,35,22,3,"PAH",224,1,0)="^^3^3^3060923"
^DIC(9.4,35,22,3,"PAH",224,1,1,0)="FIX UNSIGNED ORDERS NOT GENERATING ALERTS."
^DIC(9.4,35,22,3,"PAH",224,1,2,0)="MORE USEFUL NUMERIC PROMPT ERROR MESSAGES"
^DIC(9.4,35,22,3,"PAH",224,1,3,0)="FIX RESTRICTED PATIENT LIST SCROLLING BUG."
^DIC(9.4,35,22,3,"PAH",225,0)="228 SEQ #231^3060923.020338^1"
^DIC(9.4,35,22,3,"PAH",225,1,0)="^^28^28^3060923"
^DIC(9.4,35,22,3,"PAH",225,1,1,0)="This patch is part of the Patient Financial Services System (PFSS) "
^DIC(9.4,35,22,3,"PAH",225,1,2,0)="project.  PFSS patches are being released on various schedules.  Some "
^DIC(9.4,35,22,3,"PAH",225,1,3,0)="patch functionality will not be active until a new PFSS switch is "
^DIC(9.4,35,22,3,"PAH",225,1,4,0)="activated during final implementation. PFSS will initially be implemented "
^DIC(9.4,35,22,3,"PAH",225,1,5,0)="at select pilot sites ONLY."
^DIC(9.4,35,22,3,"PAH",225,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",225,1,7,0)="The purpose of the PFSS project is to prepare the VistA environment for "
^DIC(9.4,35,22,3,"PAH",225,1,8,0)="the implementation of a commercial off-the-shelf (COTS) billing "
^DIC(9.4,35,22,3,"PAH",225,1,9,0)="replacement system.  The project consists of the implementation of the "
^DIC(9.4,35,22,3,"PAH",225,1,10,0)="billing replacement system, business process improvements, and "
^DIC(9.4,35,22,3,"PAH",225,1,11,0)="enhancements to Veterans Health Information Systems and Technology "
^DIC(9.4,35,22,3,"PAH",225,1,12,0)="Architecture (VistA) to support integration with the COTS billing "
^DIC(9.4,35,22,3,"PAH",225,1,13,0)="replacement system.  Significant changes to VistA legacy systems and "
^DIC(9.4,35,22,3,"PAH",225,1,14,0)="ancillary packages are necessary."
^DIC(9.4,35,22,3,"PAH",225,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",225,1,16,0)="Some of the PFSS software components are not operational until the PFSS "
^DIC(9.4,35,22,3,"PAH",225,1,17,0)="On/Off Switch, distributed with patch IB*2*260, is set to ""ON .  The "
^DIC(9.4,35,22,3,"PAH",225,1,18,0)="ability for the local site to set the switch to ""ON  will be provided at "
^DIC(9.4,35,22,3,"PAH",225,1,19,0)="the appropriate time with the release of a subsequent Integrated Billing "
^DIC(9.4,35,22,3,"PAH",225,1,20,0)="patch."
^DIC(9.4,35,22,3,"PAH",225,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",225,1,22,0)="For more information about the PFSS project, review the documentation "
^DIC(9.4,35,22,3,"PAH",225,1,23,0)="accompanying this patch and refer to the following website: "
^DIC(9.4,35,22,3,"PAH",225,1,24,0)="http://vista.domain.ext/billreplace/"
^DIC(9.4,35,22,3,"PAH",225,1,25,0)=" "
^DIC(9.4,35,22,3,"PAH",225,1,26,0)="The OR*3.0*228 patch is phase II of the CPRS portion of the PFSS "
^DIC(9.4,35,22,3,"PAH",225,1,27,0)="project.  Phase I of the CPRS portion of the project is contained in "
^DIC(9.4,35,22,3,"PAH",225,1,28,0)="OR*3.0*215."
^DIC(9.4,35,22,3,"PAH",226,0)="261 SEQ #232^3061122.213007^1"
^DIC(9.4,35,22,3,"PAH",226,1,0)="^^1^1^3061122"
^DIC(9.4,35,22,3,"PAH",226,1,1,0)="Corrects problem with CIDC assign parameter and disable for all providers."
^DIC(9.4,35,22,3,"PAH",227,0)="255 SEQ #233^3061122.223911^1"
^DIC(9.4,35,22,3,"PAH",227,1,0)="^^3^3^3061122"
^DIC(9.4,35,22,3,"PAH",227,1,1,0)="This patch addresses two issues, First orderable items not turning off"
^DIC(9.4,35,22,3,"PAH",227,1,2,0)="Reminders. Second the DEA# and VA# fields are not being check, when"
^DIC(9.4,35,22,3,"PAH",227,1,3,0)="narcotics are ordered with the outpatient IV dialog in CPRS."
^DIC(9.4,35,22,3,"PAH",228,0)="250 SEQ #234^3061122.230112^1"
^DIC(9.4,35,22,3,"PAH",228,1,0)="^^5^5^3061122"
^DIC(9.4,35,22,3,"PAH",228,1,1,0)="This patch addresses problems with:"
^DIC(9.4,35,22,3,"PAH",228,1,2,0)="-The LAB Quick Orders not displaying (CH) LAB Quick Orders."
^DIC(9.4,35,22,3,"PAH",228,1,3,0)="-Expert System VITALS^ORQQVI not finding all vital measurements."
^DIC(9.4,35,22,3,"PAH",228,1,4,0)="-Display Patient Alerts and Alert Recipients, display truncating Order "
^DIC(9.4,35,22,3,"PAH",228,1,5,0)=" number.   "
^DIC(9.4,35,22,3,"PAH",229,0)="249 SEQ #235^3061122.234938^1"
^DIC(9.4,35,22,3,"PAH",229,1,0)="^^2^2^3061122"
^DIC(9.4,35,22,3,"PAH",229,1,1,0)="THIS PATCH ADDRESSES A PROBLEM WITH THE PROBLEM LIST LEX SEARCH AND ADDS "
^DIC(9.4,35,22,3,"PAH",229,1,2,0)="THE WOR DRUG TO THE ORDER CHECK  DUPLICATE DRUG CHECK WARNING."
^DIC(9.4,35,22,3,"PAH",230,0)="244 SEQ #236^3061123.002009^1"
^DIC(9.4,35,22,3,"PAH",230,1,0)="^^3^3^3061123"
^DIC(9.4,35,22,3,"PAH",230,1,1,0)="This patch contains the routine ORY244 which will scan Order file #100 "
^DIC(9.4,35,22,3,"PAH",230,1,2,0)="for missing abnormal results, from Fileman date 3050901 to present and "
^DIC(9.4,35,22,3,"PAH",230,1,3,0)="restore them. "
^DIC(9.4,35,22,3,"PAH",231,0)="242 SEQ #237^3061211.161721^1"
^DIC(9.4,35,22,3,"PAH",232,0)="260 SEQ #238^3061229.09213^1"
^DIC(9.4,35,22,3,"PAH",232,1,0)="^^1^1^3061229"
^DIC(9.4,35,22,3,"PAH",232,1,1,0)="CPRS Miscelaneous fixes."
^DIC(9.4,35,22,3,"PAH",233,0)="254 SEQ #239^3070627.212811^1"
^DIC(9.4,35,22,3,"PAH",233,1,0)="^^2^2^3070627"
^DIC(9.4,35,22,3,"PAH",233,1,1,0)="This patch corrects an error that was causing IV orders to only be "
^DIC(9.4,35,22,3,"PAH",233,1,2,0)="valid for 6 minutes after the time the order was placed."
^DIC(9.4,35,22,3,"PAH",234,0)="270^3070627.220916^1"
^DIC(9.4,35,22,3,"PAH",235,0)="248 SEQ #241^3070904.2258^1"
^DIC(9.4,35,22,3,"PAH",236,0)="262 SEQ #242^3070904.230535^1"
^DIC(9.4,35,22,3,"PAH",236,1,0)="^^1^1^3070904"
^DIC(9.4,35,22,3,"PAH",236,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",237,0)="245 SEQ #243^3070904.230621^1"
^DIC(9.4,35,22,3,"PAH",237,1,0)="^^2^2^3070904"
^DIC(9.4,35,22,3,"PAH",237,1,1,0)="Adds option for editing quick orders by user.  Fixes bugs when editing "
^DIC(9.4,35,22,3,"PAH",237,1,2,0)="quick orders."
^DIC(9.4,35,22,3,"PAH",238,0)="232 SEQ #244^3070904.230749^1"
^DIC(9.4,35,22,3,"PAH",239,0)="267 SEQ #245^3070904.231258^1"
^DIC(9.4,35,22,3,"PAH",240,0)="265 SEQ #247^3070904.233902^1"
^DIC(9.4,35,22,3,"PAH",240,1,0)="^^20^20^3070904"
^DIC(9.4,35,22,3,"PAH",240,1,1,0)="This build/patch address 3 issues:"
^DIC(9.4,35,22,3,"PAH",240,1,2,0)="1. ""AW"" Cross Reference on TO field of File 100 not updated when order "
^DIC(9.4,35,22,3,"PAH",240,1,3,0)="changes."
^DIC(9.4,35,22,3,"PAH",240,1,4,0)="2. Lab Threshold exceeded warning not working when results has a greater "
^DIC(9.4,35,22,3,"PAH",240,1,5,0)="than or less than symbol. Example: <5 or >5"
^DIC(9.4,35,22,3,"PAH",240,1,6,0)="3. Quick Orders not retaining Dosage when edited and dose is over 20 "
^DIC(9.4,35,22,3,"PAH",240,1,7,0)="characters."
^DIC(9.4,35,22,3,"PAH",240,1,8,0)="4.Update the routine ORB3TIM2 to work the alert even when not passed in "
^DIC(9.4,35,22,3,"PAH",240,1,9,0)="ORBLST (expired)."
^DIC(9.4,35,22,3,"PAH",240,1,10,0)="5. The correct IEN for pointer for Imaging is"
^DIC(9.4,35,22,3,"PAH",240,1,11,0)="checked and update if needed by the post init routine ORY26508."
^DIC(9.4,35,22,3,"PAH",240,1,12,0)="6. Modify SESSION^ORCHECK to also check the ADVERSE REACTION ASSESSMENT "
^DIC(9.4,35,22,3,"PAH",240,1,13,0)="(120.86) for allergies before assuming the error message stored at "
^DIC(9.4,35,22,3,"PAH",240,1,14,0)="^OR(100,+ORIFN,9 is up to date and displaying the ""no allergy assessment"" "
^DIC(9.4,35,22,3,"PAH",240,1,15,0)="error again upon signing the order."
^DIC(9.4,35,22,3,"PAH",240,1,16,0)="7. If they comment is the same, set the ORDIALOG flag "
^DIC(9.4,35,22,3,"PAH",240,1,17,0)="""FORMAT"" to ""@"" to prevent the duplication of the comment in CPRS."
^DIC(9.4,35,22,3,"PAH",240,1,18,0)="8. Modify MEDHIST^ORWPS to set ORPHMID regardless if the flag CKPKG for "
^DIC(9.4,35,22,3,"PAH",240,1,19,0)="PSB*2.0*19 is set.  Use ORPHMID in the call to HISTORY^PSBMLHS instead"
^DIC(9.4,35,22,3,"PAH",240,1,20,0)="of ORPSID."
^DIC(9.4,35,22,3,"PAH",241,0)="271 SEQ #249^3070904.234434^1"
^DIC(9.4,35,22,3,"PAH",241,1,0)="^^2^2^3070904"
^DIC(9.4,35,22,3,"PAH",241,1,1,0)="Correct CPRS RPC used by CAPRI, that was trying to return future "
^DIC(9.4,35,22,3,"PAH",241,1,2,0)="appointments."
^DIC(9.4,35,22,3,"PAH",242,0)="275 SEQ #250^3070905.012206^1"
^DIC(9.4,35,22,3,"PAH",242,1,0)="^^3^3^3070905"
^DIC(9.4,35,22,3,"PAH",242,1,1,0)="This patch corrects the issue introduced in OR*3.0*265 where pending "
^DIC(9.4,35,22,3,"PAH",242,1,2,0)="orders no longer display the Medication Administration History.It also "
^DIC(9.4,35,22,3,"PAH",242,1,3,0)="addresses a subscript error and a disk full error from ORWPS1"
^DIC(9.4,35,22,3,"PAH",243,0)="263 SEQ #251^3071212.204607^1"
^DIC(9.4,35,22,3,"PAH",243,1,0)="^^17^17^3071212"
^DIC(9.4,35,22,3,"PAH",243,1,1,0)=" "
^DIC(9.4,35,22,3,"PAH",243,1,2,0)="This patch will address a few issues:"
^DIC(9.4,35,22,3,"PAH",243,1,3,0)="1.  When using the Search orders by nature or status option, if the user "
^DIC(9.4,35,22,3,"PAH",243,1,4,0)="entere a start date of T-1 and an end date of T, the search will return "
^DIC(9.4,35,22,3,"PAH",243,1,5,0)="no results."
^DIC(9.4,35,22,3,"PAH",243,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",243,1,7,0)="2. In the option 'Search orders by nature or status', the help text for"
^DIC(9.4,35,22,3,"PAH",243,1,8,0)="the date ranges state that the start date must be older than the end"
^DIC(9.4,35,22,3,"PAH",243,1,9,0)="date. But the option will allow the user to enter an end date older than"
^DIC(9.4,35,22,3,"PAH",243,1,10,0)="the start date."
^DIC(9.4,35,22,3,"PAH",243,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",243,1,12,0)="3. Creating a new menu by copying an existing menu is resulting in an "
^DIC(9.4,35,22,3,"PAH",243,1,13,0)="error."
^DIC(9.4,35,22,3,"PAH",243,1,14,0)=" "
^DIC(9.4,35,22,3,"PAH",243,1,15,0)="4. If a patient has only clinical procedures reports in the Procedures "
^DIC(9.4,35,22,3,"PAH",243,1,16,0)="(local only) section of the CPRS reports tab, the reports will not print "
^DIC(9.4,35,22,3,"PAH",243,1,17,0)="to a printer."
^DIC(9.4,35,22,3,"PAH",244,0)="278 SEQ #252^3071212.212908^1"
^DIC(9.4,35,22,3,"PAH",244,1,0)="^^3^3^3071212"
^DIC(9.4,35,22,3,"PAH",244,1,1,0)="Corrects the issue with Tasks accumulating while  waiting  for a "
^DIC(9.4,35,22,3,"PAH",244,1,2,0)="partition. Caused by ORMEVNT exiting without unlocking a global that it "
^DIC(9.4,35,22,3,"PAH",244,1,3,0)="locked. "
^DIC(9.4,35,22,3,"PAH",245,0)="274 SEQ #254^3071212.214356^1"
^DIC(9.4,35,22,3,"PAH",246,0)="277^3071212.221502^1"
^DIC(9.4,35,22,3,"PAH",246,1,0)="^^1^1^3071212"
^DIC(9.4,35,22,3,"PAH",246,1,1,0)="CPRS GUI 26"
^DIC(9.4,35,22,3,"PAH",247,0)="256 SEQ #255^3080203.220448^1"
^DIC(9.4,35,22,3,"PAH",247,1,0)="^^1^1^3080203"
^DIC(9.4,35,22,3,"PAH",247,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",248,0)="279 SEQ #256^3080203.223506^1"
^DIC(9.4,35,22,3,"PAH",248,1,0)="^^23^23^3080203"
^DIC(9.4,35,22,3,"PAH",248,1,1,0)="The purpose of this patch is to address an issue that has been reported "
^DIC(9.4,35,22,3,"PAH",248,1,2,0)="with the drug name missing from pending orders."
^DIC(9.4,35,22,3,"PAH",248,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",248,1,4,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",248,1,5,0)="========="
^DIC(9.4,35,22,3,"PAH",248,1,6,0)="1. HD199896      Drug name missing from Pending Orders"
^DIC(9.4,35,22,3,"PAH",248,1,7,0)="    HD154624     duplicate"
^DIC(9.4,35,22,3,"PAH",248,1,8,0)="    HD157144     duplicate"
^DIC(9.4,35,22,3,"PAH",248,1,9,0)="    HD163806     duplicate"
^DIC(9.4,35,22,3,"PAH",248,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",248,1,11,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",248,1,12,0)="   --------"
^DIC(9.4,35,22,3,"PAH",248,1,13,0)="   The problem deals with the display of the order information for "
^DIC(9.4,35,22,3,"PAH",248,1,14,0)="   Outpatient prescriptions once the order has been accepted in CPRS."
^DIC(9.4,35,22,3,"PAH",248,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",248,1,16,0)="   The drug name is missing from the order text in the display. The "
^DIC(9.4,35,22,3,"PAH",248,1,17,0)="   problem was traced back to "
^DIC(9.4,35,22,3,"PAH",248,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",248,1,19,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",248,1,20,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",248,1,21,0)="   OR*2.5*49 released a menu option that performs a conversion on"
^DIC(9.4,35,22,3,"PAH",248,1,22,0)="   the ORDER DIALOG (#101.41) file. The [ORCM CONVERT MENUS] option is"
^DIC(9.4,35,22,3,"PAH",248,1,23,0)="   being removed."
^DIC(9.4,35,22,3,"PAH",249,0)="287 SEQ #257^3080526.150302^1"
^DIC(9.4,35,22,3,"PAH",250,0)="246 SEQ #258^3080722.07414^1"
^DIC(9.4,35,22,3,"PAH",250,1,0)="^^1^1^3080722"
^DIC(9.4,35,22,3,"PAH",250,1,1,0)="UPDATE ORDER DOSAGE WITH NEW FORMAT"
^DIC(9.4,35,22,3,"PAH",251,0)="238^3090421.1015^17"
^DIC(9.4,35,22,3,"PAH",252,0)="281 SEQ #259^3090421.143832^17"
^DIC(9.4,35,22,3,"PAH",252,1,0)="^^181^181^3090421"
^DIC(9.4,35,22,3,"PAH",252,1,1,0)="1. A problem was discovered with the Results Reporting [OR RESULTS"
^DIC(9.4,35,22,3,"PAH",252,1,2,0)="REPORTING] menu after the installation of GMTS*2.7*85. This patch corrects"
^DIC(9.4,35,22,3,"PAH",252,1,3,0)="this problem. HD0000000241916"
^DIC(9.4,35,22,3,"PAH",252,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,5,0)="2. OR*3*243 will add a ""Reason for Study"" prompt to the Computerized "
^DIC(9.4,35,22,3,"PAH",252,1,6,0)="Patient Record System (CPRS) Graphical User Interface (GUI) ""Order an"
^DIC(9.4,35,22,3,"PAH",252,1,7,0)="Imaging Procedure"" dialog. The ""Reason for Study"" requirement was"
^DIC(9.4,35,22,3,"PAH",252,1,8,0)="implemented in the Radiology package with  RA*5.0*75. Existing Radiology"
^DIC(9.4,35,22,3,"PAH",252,1,9,0)="and Imaging quick orders that have text in ""History and Reason for Exam"""
^DIC(9.4,35,22,3,"PAH",252,1,10,0)="may need some text moved to ""Reason for Study"". Since ""Reason for Study"""
^DIC(9.4,35,22,3,"PAH",252,1,11,0)="has a size limit of 64 characters changes must be made by a person who can"
^DIC(9.4,35,22,3,"PAH",252,1,12,0)="review what, if any, portion of the text should be moved into the new"
^DIC(9.4,35,22,3,"PAH",252,1,13,0)="field. This patch will allow sites to produce a list of existing quick"
^DIC(9.4,35,22,3,"PAH",252,1,14,0)="orders that should be reviewed. HD0000000217362"
^DIC(9.4,35,22,3,"PAH",252,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,16,0)="3. There should no longer be a default of 'TODAY' for ""Date Desired"" on a "
^DIC(9.4,35,22,3,"PAH",252,1,17,0)="Radiology quick order. Some sites have requested the ability to"
^DIC(9.4,35,22,3,"PAH",252,1,18,0)="automatically remove 'TODAY' from the ""Date Desired"" prompt. In addition,"
^DIC(9.4,35,22,3,"PAH",252,1,19,0)="there was a request to be able to exclude quick orders with an order"
^DIC(9.4,35,22,3,"PAH",252,1,20,0)="urgency of 'STAT'. HD0000000232271"
^DIC(9.4,35,22,3,"PAH",252,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,22,0)="Associated Remedy:"
^DIC(9.4,35,22,3,"PAH",252,1,23,0)="=================="
^DIC(9.4,35,22,3,"PAH",252,1,24,0)="1. HD0000000241916 GMTS *85 Problem"
^DIC(9.4,35,22,3,"PAH",252,1,25,0)="2. HD0000000217362 Need routine to identify potential quick order problems"
^DIC(9.4,35,22,3,"PAH",252,1,26,0)="3. HD0000000232271 Need routine to identify Radiology QOs with default"
^DIC(9.4,35,22,3,"PAH",252,1,27,0)="                   date "
^DIC(9.4,35,22,3,"PAH",252,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,29,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",252,1,30,0)="=================="
^DIC(9.4,35,22,3,"PAH",252,1,31,0)="N/A"
^DIC(9.4,35,22,3,"PAH",252,1,32,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,33,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",252,1,34,0)="==========="
^DIC(9.4,35,22,3,"PAH",252,1,35,0)="TBD "
^DIC(9.4,35,22,3,"PAH",252,1,36,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,37,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",252,1,38,0)="========="
^DIC(9.4,35,22,3,"PAH",252,1,39,0)="1. HD0000000241916 GMTS *85 Problem"
^DIC(9.4,35,22,3,"PAH",252,1,40,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,41,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",252,1,42,0)="   --------"
^DIC(9.4,35,22,3,"PAH",252,1,43,0)="   After a site installed GMTS*2.7*85, they discovered an error would"
^DIC(9.4,35,22,3,"PAH",252,1,44,0)="   occur if they used the Results Reporting Menu [OR RESULTS REPORTING]"
^DIC(9.4,35,22,3,"PAH",252,1,45,0)="   option to display Health Summary results.  It was discovered that the"
^DIC(9.4,35,22,3,"PAH",252,1,46,0)="   variable XQORNOD was being set by the Order Entry Results Reporting"
^DIC(9.4,35,22,3,"PAH",252,1,47,0)="   package incorrectly, with only one piece, and this was causing a"
^DIC(9.4,35,22,3,"PAH",252,1,48,0)="   <SYNTAX>OP+3^XQCHK error to appear."
^DIC(9.4,35,22,3,"PAH",252,1,49,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,50,0)="   Example:"
^DIC(9.4,35,22,3,"PAH",252,1,51,0)="   --------"
^DIC(9.4,35,22,3,"PAH",252,1,52,0)="Select OPTION NAME: OR RESULTS REPORTING       Results Reporting Menu"
^DIC(9.4,35,22,3,"PAH",252,1,53,0)="Results Reporting Menu"
^DIC(9.4,35,22,3,"PAH",252,1,54,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,55,0)="Select Patient:    GMTS,TEST PATIENT       DOB    ######### "
^DIC(9.4,35,22,3,"PAH",252,1,56,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,57,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,58,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,59,0)="                        R E S U L T S   R E P O R T I N G           "
^DIC(9.4,35,22,3,"PAH",252,1,60,0)="GMTS,TEST PATIENT     ###-##-####             DOB (AGE)       Wt (lb): NF"
^DIC(9.4,35,22,3,"PAH",252,1,61,0)="-------------------------------------------------------------------------"
^DIC(9.4,35,22,3,"PAH",252,1,62,0)="                            --- Main Results Menu ---"
^DIC(9.4,35,22,3,"PAH",252,1,63,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,64,0)="1    Health Summary                8    Daily Order Summary"
^DIC(9.4,35,22,3,"PAH",252,1,65,0)="2    Lab Results (Interim)         9    Order Summary for Date/time Range"
^DIC(9.4,35,22,3,"PAH",252,1,66,0)="3    Graph Lab Tests               10   Customized Order Summary"
^DIC(9.4,35,22,3,"PAH",252,1,67,0)="4    Blood Bank Report             11   Print Chart Copy Summary"
^DIC(9.4,35,22,3,"PAH",252,1,68,0)="5    Anatomic Pathology Report     12   Outpatient RX Profile"
^DIC(9.4,35,22,3,"PAH",252,1,69,0)="6    Vitals SF511 Report                        "
^DIC(9.4,35,22,3,"PAH",252,1,70,0)="7    Vitals Cumulative Report           Ad Hoc Health Summary"
^DIC(9.4,35,22,3,"PAH",252,1,71,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,72,0)="Select Item(s): 1   Health Summary  "
^DIC(9.4,35,22,3,"PAH",252,1,73,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,74,0)="                             --- Health Summary ---"
^DIC(9.4,35,22,3,"PAH",252,1,75,0)="Select Health Summary Type: CLINICAL REMINDERS//   <<<Can choose any "
^DIC(9.4,35,22,3,"PAH",252,1,76,0)="Health"
^DIC(9.4,35,22,3,"PAH",252,1,77,0)="                                                      Summary Type"
^DIC(9.4,35,22,3,"PAH",252,1,78,0)="DEVICE: HOME//   TELNET TERMINAL"
^DIC(9.4,35,22,3,"PAH",252,1,79,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,80,0)="                                                           04/22/2008 "
^DIC(9.4,35,22,3,"PAH",252,1,81,0)="11:58"
^DIC(9.4,35,22,3,"PAH",252,1,82,0)="***************  CONFIDENTIAL CLINICAL REMINDERS SUMMARY  "
^DIC(9.4,35,22,3,"PAH",252,1,83,0)="*****************"
^DIC(9.4,35,22,3,"PAH",252,1,84,0)="I $D(XQORNOD) S "
^DIC(9.4,35,22,3,"PAH",252,1,85,0)="%XQ=+XQORNOD,%XQ1=U_$P(XQORNOD,"";"",2),%XQ=@(%XQ1_%XQ_"",0)""),"
^DIC(9.4,35,22,3,"PAH",252,1,86,0)="                                                       ^"
^DIC(9.4,35,22,3,"PAH",252,1,87,0)="XQOPT=$P(%XQ,U)_U_$P(%XQ,U,2)"
^DIC(9.4,35,22,3,"PAH",252,1,88,0)="<SYNTAX>OP+3^XQCHK"
^DIC(9.4,35,22,3,"PAH",252,1,89,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,90,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",252,1,91,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",252,1,92,0)="   Routine ORPRS07 has been modified to properly set two pieces into"
^DIC(9.4,35,22,3,"PAH",252,1,93,0)="   XQORNOD and thus not generate the error when displaying Health Summary"
^DIC(9.4,35,22,3,"PAH",252,1,94,0)="   results when using the Results Reporting Menu [OR RESULTS REPORTING]"
^DIC(9.4,35,22,3,"PAH",252,1,95,0)="   option."
^DIC(9.4,35,22,3,"PAH",252,1,96,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,97,0)="2. HD0000000217362 Need routine to identify potential quick order problems"
^DIC(9.4,35,22,3,"PAH",252,1,98,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,99,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",252,1,100,0)="   --------"
^DIC(9.4,35,22,3,"PAH",252,1,101,0)="   Radiology and Imaging quick orders may need to be updated as a result"
^DIC(9.4,35,22,3,"PAH",252,1,102,0)="   of the changes in OR*3*243."
^DIC(9.4,35,22,3,"PAH",252,1,103,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,104,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",252,1,105,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",252,1,106,0)="   A new option will be provided, Radiology/Imaging Quick Order Search"
^DIC(9.4,35,22,3,"PAH",252,1,107,0)="   [ORCM RA SEARCH]. This option will search for Radiology and Imaging"
^DIC(9.4,35,22,3,"PAH",252,1,108,0)="   quick orders that have free text fields that contain text. A sample"
^DIC(9.4,35,22,3,"PAH",252,1,109,0)="   message and additional details are included below the 'Important "
^DIC(9.4,35,22,3,"PAH",252,1,110,0)="   Notes' section."
^DIC(9.4,35,22,3,"PAH",252,1,111,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,112,0)="3. HD0000000232271 Need routine to identify Radiology QOs with default"
^DIC(9.4,35,22,3,"PAH",252,1,113,0)="                   date"
^DIC(9.4,35,22,3,"PAH",252,1,114,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,115,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",252,1,116,0)="   --------"
^DIC(9.4,35,22,3,"PAH",252,1,117,0)="   Radiology and Imaging quick orders should no longer contain a default"
^DIC(9.4,35,22,3,"PAH",252,1,118,0)="   of TODAY for Date Desired. Sites need assistance in locating and "
^DIC(9.4,35,22,3,"PAH",252,1,119,0)="   updating the quick orders that need to be updated."
^DIC(9.4,35,22,3,"PAH",252,1,120,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,121,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",252,1,122,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",252,1,123,0)="   The search option for item 2 includes a search for quick orders that"
^DIC(9.4,35,22,3,"PAH",252,1,124,0)="   contain either 'T' or 'TODAY' for the Date Desired prompt. In addition,"
^DIC(9.4,35,22,3,"PAH",252,1,125,0)="   the option will remove the Date Desired default as requested by the"
^DIC(9.4,35,22,3,"PAH",252,1,126,0)="   user. A sample message and additional details are included below."
^DIC(9.4,35,22,3,"PAH",252,1,127,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,128,0)="***Important Notes*** "
^DIC(9.4,35,22,3,"PAH",252,1,129,0)="If you identify quick orders that need to be updated, you must wait "
^DIC(9.4,35,22,3,"PAH",252,1,130,0)="until after the installation of OR*3*243 to make these updates. Use the"
^DIC(9.4,35,22,3,"PAH",252,1,131,0)="Enter/edit quick orders [ORCM QUICK ORDERS] option to update the quick "
^DIC(9.4,35,22,3,"PAH",252,1,132,0)="orders, where appropriate. It may also be necessary for providers to edit"
^DIC(9.4,35,22,3,"PAH",252,1,133,0)="their personal quick orders."
^DIC(9.4,35,22,3,"PAH",252,1,134,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,135,0)="Even disabled quick orders will be shown, for review purposes. The results"
^DIC(9.4,35,22,3,"PAH",252,1,136,0)="will be sent as a mail message to the person who ran the option. Please"
^DIC(9.4,35,22,3,"PAH",252,1,137,0)="note, it may be necessary for this menu option to be assigned to the"
^DIC(9.4,35,22,3,"PAH",252,1,138,0)="person responsible for the review (i.e. Clinical Coordinator and/or"
^DIC(9.4,35,22,3,"PAH",252,1,139,0)="Radiology ADPAC)."
^DIC(9.4,35,22,3,"PAH",252,1,140,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,141,0)="The following shows a sample message. It is difficult to read since it is "
^DIC(9.4,35,22,3,"PAH",252,1,142,0)="formatted to print 132 characters. In the column for ""Text or Start "
^DIC(9.4,35,22,3,"PAH",252,1,143,0)="Date/Time"", there will be a ""T"" or ""D"" to indicate ""Text"" or ""Date""."
^DIC(9.4,35,22,3,"PAH",252,1,144,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,145,0)="Select OPTION NAME: ORCM RA SEARCH     RADIOLOGY/IMAGING QUICK ORDER"
^DIC(9.4,35,22,3,"PAH",252,1,146,0)="SEARCH"
^DIC(9.4,35,22,3,"PAH",252,1,147,0)="RADIOLOGY/IMAGING QUICK ORDER SEARCH"
^DIC(9.4,35,22,3,"PAH",252,1,148,0)="Clear Date Desired with a response of ""TODAY""? Y"
^DIC(9.4,35,22,3,"PAH",252,1,149,0)="Exclude quick orders with STAT urgency? Y"
^DIC(9.4,35,22,3,"PAH",252,1,150,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,151,0)="Requested Start Time: NOW//  (NOV 19, 2007@11:36:42)"
^DIC(9.4,35,22,3,"PAH",252,1,152,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,153,0)="The check of Radiology/Imaging Quick Orders is queued"
^DIC(9.4,35,22,3,"PAH",252,1,154,0)=" (to start NOW)."
^DIC(9.4,35,22,3,"PAH",252,1,155,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,156,0)="YOU WILL RECEIVE A MAILMAN MESSAGE WHEN TASK #154113 HAS COMPLETED."
^DIC(9.4,35,22,3,"PAH",252,1,157,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,158,0)="Sample mail message:"
^DIC(9.4,35,22,3,"PAH",252,1,159,0)="Subj: RADIOLOGY/IMAGING QUICK ORDERS  [#668609] 04/15/08@20:39  592 lines "
^DIC(9.4,35,22,3,"PAH",252,1,160,0)="From: CPRS, SEARCH  In 'IN' basket.   Page 1"
^DIC(9.4,35,22,3,"PAH",252,1,161,0)="--------------------------------------------------------------------------"
^DIC(9.4,35,22,3,"PAH",252,1,162,0)="  The check of Radiology/Imaging Quick Orders is complete."
^DIC(9.4,35,22,3,"PAH",252,1,163,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,164,0)="  Here is the list of all quick orders that should be reviewed: "
^DIC(9.4,35,22,3,"PAH",252,1,165,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,166,0)="Quick Order Name                       Disable Text     Text or Start "
^DIC(9.4,35,22,3,"PAH",252,1,167,0)="Date/Time"
^DIC(9.4,35,22,3,"PAH",252,1,168,0)="                 Ancestors/Menus or Reminders"
^DIC(9.4,35,22,3,"PAH",252,1,169,0)="  "
^DIC(9.4,35,22,3,"PAH",252,1,170,0)="RAGR CHEST 2 VIEWS PA&LAT STAT QO                       D: TODAY"
^DIC(9.4,35,22,3,"PAH",252,1,171,0)="                 On a menu or in an order set"
^DIC(9.4,35,22,3,"PAH",252,1,172,0)="                                                        T: POST OP SURGERY"
^DIC(9.4,35,22,3,"PAH",252,1,173,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,174,0)="RAGR CHEST 2 VIEW                      DISABLED         T: TEST"
^DIC(9.4,35,22,3,"PAH",252,1,175,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,176,0)="ORWDQ E87030CE                         no longer used   T: TESTING"
^DIC(9.4,35,22,3,"PAH",252,1,177,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,178,0)="ORWDQ 3A173B44                                          T: h/o high grade "
^DIC(9.4,35,22,3,"PAH",252,1,179,0)="fever"
^DIC(9.4,35,22,3,"PAH",252,1,180,0)=" "
^DIC(9.4,35,22,3,"PAH",252,1,181,0)="End sample mail message"
^DIC(9.4,35,22,3,"PAH",253,0)="243^3090421.155125^17"
^DIC(9.4,35,22,3,"PAH",254,0)="299 SEQ #261^3090421.155332^17"
^DIC(9.4,35,22,3,"PAH",254,1,0)="^^60^60^3090421"
^DIC(9.4,35,22,3,"PAH",254,1,1,0)="1. For very lengthy patient instructions, there is the possibility that"
^DIC(9.4,35,22,3,"PAH",254,1,2,0)="they can be truncated when transferred from Outpatient Pharmacy V. 7.0 to"
^DIC(9.4,35,22,3,"PAH",254,1,3,0)="Order Entry/Results Reporting V. 3.0. Patch OR*3.0*243 corrects the"
^DIC(9.4,35,22,3,"PAH",254,1,4,0)="problem with the truncation. However, there is no way to identify orders"
^DIC(9.4,35,22,3,"PAH",254,1,5,0)="that need to be corrected. This patch corrects this problem by creating a "
^DIC(9.4,35,22,3,"PAH",254,1,6,0)="routine to search through the previous 365 days of Outpatient "
^DIC(9.4,35,22,3,"PAH",254,1,7,0)="prescriptions, comparing patient instructions. A report will be sent to "
^DIC(9.4,35,22,3,"PAH",254,1,8,0)="the person who installs the patch. It will be sorted by division."
^DIC(9.4,35,22,3,"PAH",254,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,10,0)="The report will contain the orderable item name, dispense drug name, "
^DIC(9.4,35,22,3,"PAH",254,1,11,0)="prescription number and the internal entry number (IEN) of the entry from "
^DIC(9.4,35,22,3,"PAH",254,1,12,0)="the ORDERS file (#100) as well as other information about the patient and "
^DIC(9.4,35,22,3,"PAH",254,1,13,0)="order. Below is a sample output for the report:"
^DIC(9.4,35,22,3,"PAH",254,1,14,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,15,0)="Subj: TRUNCATED PATIENT INSTRUCTIONS  [#660505] 02/28/08@23:43  7 lines"
^DIC(9.4,35,22,3,"PAH",254,1,16,0)="From: CPRS, SEARCH  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,35,22,3,"PAH",254,1,17,0)="--------------------------------------------------------------------------"
^DIC(9.4,35,22,3,"PAH",254,1,18,0)="  The check for truncated Patient Instructions is complete."
^DIC(9.4,35,22,3,"PAH",254,1,19,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,20,0)="  Here is the list of the affected orders: "
^DIC(9.4,35,22,3,"PAH",254,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,22,0)="Patient/Division      SSN   Item/Dispense         Status/RX#    Stop/OIEN"
^DIC(9.4,35,22,3,"PAH",254,1,23,0)="CPRSPATIENT,GENERAL   1234  ACETAZOLAMIDE TAB     ACTIVE        09/24/2008"
^DIC(9.4,35,22,3,"PAH",254,1,24,0)="DAYTON                      ACETAZOLAMIDE 250MG   2666845       12608385"
^DIC(9.4,35,22,3,"PAH",254,1,25,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,26,0)="In addition to reporting the orders, this routine will also correct the "
^DIC(9.4,35,22,3,"PAH",254,1,27,0)="information in the ORDERS file (#100). It is important to check these "
^DIC(9.4,35,22,3,"PAH",254,1,28,0)="orders and verify the corrected information is accurate."
^DIC(9.4,35,22,3,"PAH",254,1,29,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,30,0)="Associated Remedy:"
^DIC(9.4,35,22,3,"PAH",254,1,31,0)="=================="
^DIC(9.4,35,22,3,"PAH",254,1,32,0)="1. HD0000000236377    Patient instructions are truncated"
^DIC(9.4,35,22,3,"PAH",254,1,33,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,34,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",254,1,35,0)="=================="
^DIC(9.4,35,22,3,"PAH",254,1,36,0)="N/A"
^DIC(9.4,35,22,3,"PAH",254,1,37,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,38,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",254,1,39,0)="==========="
^DIC(9.4,35,22,3,"PAH",254,1,40,0)="TBD "
^DIC(9.4,35,22,3,"PAH",254,1,41,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,42,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",254,1,43,0)="========="
^DIC(9.4,35,22,3,"PAH",254,1,44,0)="1. HD0000000236377   Patient instructions are truncated"
^DIC(9.4,35,22,3,"PAH",254,1,45,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,46,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",254,1,47,0)="   --------"
^DIC(9.4,35,22,3,"PAH",254,1,48,0)="   For very lengthy patient instructions, there is the possibility that "
^DIC(9.4,35,22,3,"PAH",254,1,49,0)="   they can be truncated when transferred from Outpatient Pharmacy V. 7.0"
^DIC(9.4,35,22,3,"PAH",254,1,50,0)="   to Order Entry/Results Reporting V. 3.0. Patch OR*3.0*243 corrects the"
^DIC(9.4,35,22,3,"PAH",254,1,51,0)="   problem with the truncation. However, there is no way to identify "
^DIC(9.4,35,22,3,"PAH",254,1,52,0)="   orders that need to be corrected."
^DIC(9.4,35,22,3,"PAH",254,1,53,0)=" "
^DIC(9.4,35,22,3,"PAH",254,1,54,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",254,1,55,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",254,1,56,0)="   Routine ORY299 will execute as a post-install routine. It will search"
^DIC(9.4,35,22,3,"PAH",254,1,57,0)="   through the last 365 days of Outpatient prescriptions, comparing"
^DIC(9.4,35,22,3,"PAH",254,1,58,0)="   patient instructions. A report will be sent to the person who installed"
^DIC(9.4,35,22,3,"PAH",254,1,59,0)="   the patch. In addition, the routine will use the patient instructions"
^DIC(9.4,35,22,3,"PAH",254,1,60,0)="   from Pharmacy to correct truncated patient instructions."
^DIC(9.4,35,22,3,"PAH",255,0)="304^3090422.152001^17"
^DIC(9.4,35,22,3,"PAH",256,0)="303 SEQ #264^3090422.160908^17"
^DIC(9.4,35,22,3,"PAH",257,0)="301 SEQ #265^3090423.105112^17"
^DIC(9.4,35,22,3,"PAH",257,1,0)="^^2^2^3090423"
^DIC(9.4,35,22,3,"PAH",257,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,35,22,3,"PAH",257,1,2,0)="under OR*3.0*301."
^DIC(9.4,35,22,3,"PAH",258,0)="292 SEQ #266^3090423.105424^17"
^DIC(9.4,35,22,3,"PAH",258,1,0)="^^50^50^3090423"
^DIC(9.4,35,22,3,"PAH",258,1,1,0)="1. A site reported a problem with accessing a patient's records afte r"
^DIC(9.4,35,22,3,"PAH",258,1,2,0)="their system was co-located. A problem was discovered with the length of"
^DIC(9.4,35,22,3,"PAH",258,1,3,0)="the lock timeouts. This patch corrects this problem by modifying the locks"
^DIC(9.4,35,22,3,"PAH",258,1,4,0)="to use the system parameter for timeouts, if available. HD0000000223856"
^DIC(9.4,35,22,3,"PAH",258,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,6,0)="2. A site reported an issue with the help text/description associated with"
^DIC(9.4,35,22,3,"PAH",258,1,7,0)="the parameter OR OREMAS MED ORDERS. The description for this parameter"
^DIC(9.4,35,22,3,"PAH",258,1,8,0)="does not make it clear that it only affects Inpatient Medications orders. "
^DIC(9.4,35,22,3,"PAH",258,1,9,0)="HD0000000069676"
^DIC(9.4,35,22,3,"PAH",258,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,11,0)="Associated Remedy:"
^DIC(9.4,35,22,3,"PAH",258,1,12,0)="=================="
^DIC(9.4,35,22,3,"PAH",258,1,13,0)="1. HD0000000223856 Intermittent Error message when signing lab orders."
^DIC(9.4,35,22,3,"PAH",258,1,14,0)="2. HD0000000069676  help description no longer true"
^DIC(9.4,35,22,3,"PAH",258,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,16,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",258,1,17,0)="=================="
^DIC(9.4,35,22,3,"PAH",258,1,18,0)="N/A"
^DIC(9.4,35,22,3,"PAH",258,1,19,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,20,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",258,1,21,0)="==========="
^DIC(9.4,35,22,3,"PAH",258,1,22,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,23,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",258,1,24,0)="========="
^DIC(9.4,35,22,3,"PAH",258,1,25,0)="1. HD0000000223856 Intermittent Error message when signing lab orders."
^DIC(9.4,35,22,3,"PAH",258,1,26,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,27,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",258,1,28,0)="   --------"
^DIC(9.4,35,22,3,"PAH",258,1,29,0)="   The problem has to do with errors occasionally showing up when"
^DIC(9.4,35,22,3,"PAH",258,1,30,0)="   attempting to sign orders. However, the message detail shows no name"
^DIC(9.4,35,22,3,"PAH",258,1,31,0)="   for the person who is working on the order."
^DIC(9.4,35,22,3,"PAH",258,1,32,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,33,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",258,1,34,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",258,1,35,0)="   The lock timeouts in routine ORX2 have been updated to use the new"
^DIC(9.4,35,22,3,"PAH",258,1,36,0)="   system parameter."
^DIC(9.4,35,22,3,"PAH",258,1,37,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,38,0)="2. HD0000000069676 help description no longer true"
^DIC(9.4,35,22,3,"PAH",258,1,39,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,40,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",258,1,41,0)="   --------"
^DIC(9.4,35,22,3,"PAH",258,1,42,0)="   The problem has to do with the description associated with the OR"
^DIC(9.4,35,22,3,"PAH",258,1,43,0)="   OREMAS MED ORDERS parameter. The description does not indicate that"
^DIC(9.4,35,22,3,"PAH",258,1,44,0)="   this parameters only affects Inpatient Medications orders."
^DIC(9.4,35,22,3,"PAH",258,1,45,0)=" "
^DIC(9.4,35,22,3,"PAH",258,1,46,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",258,1,47,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",258,1,48,0)="   The DESCRIPTION field (#8989.512) of the PARAMETER DEFINITION file"
^DIC(9.4,35,22,3,"PAH",258,1,49,0)="   (#8989.51) was updated to accurately reflect what orders are covered by"
^DIC(9.4,35,22,3,"PAH",258,1,50,0)="   this paramter."
^DIC(9.4,35,22,3,"PAH",259,0)="285 SEQ #267^3090423.110112^17"
^DIC(9.4,35,22,3,"PAH",259,1,0)="^^43^43^3090423"
^DIC(9.4,35,22,3,"PAH",259,1,1,0)="Currently, the Computerized Patient Record System (CPRS) V. 1.0 uses the"
^DIC(9.4,35,22,3,"PAH",259,1,2,0)="GMRV VITAL MEASUREMENT file (#120.5) to retrieve vitals information to"
^DIC(9.4,35,22,3,"PAH",259,1,3,0)="display on the Cover Sheet."
^DIC(9.4,35,22,3,"PAH",259,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,5,0)="The purpose of this patch is to modify the retrieval of vitals "
^DIC(9.4,35,22,3,"PAH",259,1,6,0)="information to use the Clinical Reminders Index global in conjunction "
^DIC(9.4,35,22,3,"PAH",259,1,7,0)="with a standard Application Program Interface supplied by the GEN. MED. "
^DIC(9.4,35,22,3,"PAH",259,1,8,0)="REC. - VITALS V. 5.0 package. No functional changes are included, only the"
^DIC(9.4,35,22,3,"PAH",259,1,9,0)="access method."
^DIC(9.4,35,22,3,"PAH",259,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,11,0)="A new software package, Clinical Observations, will also collect patient"
^DIC(9.4,35,22,3,"PAH",259,1,12,0)="vital signs but store the records in a different file. However, both GEN."
^DIC(9.4,35,22,3,"PAH",259,1,13,0)="MED. REC. - VITALS V. 5.0 and the new Clinical Observations package will"
^DIC(9.4,35,22,3,"PAH",259,1,14,0)="update the Clinical Reminders Index global, specifically, the 120.5"
^DIC(9.4,35,22,3,"PAH",259,1,15,0)="section. This patch ensures that vitals information, regardless of its'"
^DIC(9.4,35,22,3,"PAH",259,1,16,0)="source will continue to display appropriately on the CPRS cover sheet."
^DIC(9.4,35,22,3,"PAH",259,1,17,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,18,0)="Associated Remedy:"
^DIC(9.4,35,22,3,"PAH",259,1,19,0)="=================="
^DIC(9.4,35,22,3,"PAH",259,1,20,0)="HD 222625       CPRS Vitals API"
^DIC(9.4,35,22,3,"PAH",259,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,22,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",259,1,23,0)="=================="
^DIC(9.4,35,22,3,"PAH",259,1,24,0)="N/A"
^DIC(9.4,35,22,3,"PAH",259,1,25,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,26,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",259,1,27,0)="==========="
^DIC(9.4,35,22,3,"PAH",259,1,28,0)="TBD "
^DIC(9.4,35,22,3,"PAH",259,1,29,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,30,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",259,1,31,0)="========="
^DIC(9.4,35,22,3,"PAH",259,1,32,0)="1. HD222625     CPRS Vitals API"
^DIC(9.4,35,22,3,"PAH",259,1,33,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,34,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",259,1,35,0)="   --------"
^DIC(9.4,35,22,3,"PAH",259,1,36,0)="   Vitals information will no longer be stored in file 120.5. CPRS must"
^DIC(9.4,35,22,3,"PAH",259,1,37,0)="   retrieve data using the Clinical Reminders Index global."
^DIC(9.4,35,22,3,"PAH",259,1,38,0)=" "
^DIC(9.4,35,22,3,"PAH",259,1,39,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",259,1,40,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",259,1,41,0)="   CPRS access to retrieve vitals information will now be retrieved using"
^DIC(9.4,35,22,3,"PAH",259,1,42,0)="   the Clinical Reminders Index global and the Application Programming"
^DIC(9.4,35,22,3,"PAH",259,1,43,0)="   Interface (API) provided by the GEN. MED. REC. - VITALS V. 5.0 package."
^DIC(9.4,35,22,3,"PAH",260,0)="289 SEQ #268^3090423.111747^17"
^DIC(9.4,35,22,3,"PAH",260,1,0)="^^12^12^3090423"
^DIC(9.4,35,22,3,"PAH",260,1,1,0)="1. When an Outpatient complex prescription contains an EXCEPT conjunction "
^DIC(9.4,35,22,3,"PAH",260,1,2,0)="there is a problem when it is transferred to Inpatient Medications. The "
^DIC(9.4,35,22,3,"PAH",260,1,3,0)="new order created does not adequately reflect the provider's intent. This "
^DIC(9.4,35,22,3,"PAH",260,1,4,0)="patch corrects this problem by no longer allowing an Outpatient complex "
^DIC(9.4,35,22,3,"PAH",260,1,5,0)="order with a conjunction of 'EXCEPT' to be transferred to Inpatient. "
^DIC(9.4,35,22,3,"PAH",260,1,6,0)="HD0000000269669, PSPO #1031"
^DIC(9.4,35,22,3,"PAH",260,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",260,1,8,0)="2. With the release of OR*3*243, there is no longer a 'Give additional "
^DIC(9.4,35,22,3,"PAH",260,1,9,0)="dose NOW' prompt in the [ORCM QUICK ORDERS] menu option. This patch "
^DIC(9.4,35,22,3,"PAH",260,1,10,0)="corrects this problem by prompting for 'Give additional dose NOW' if the "
^DIC(9.4,35,22,3,"PAH",260,1,11,0)="schedule does not have a schedule type of 'ONE-TIME'. "
^DIC(9.4,35,22,3,"PAH",260,1,12,0)="HD0000000277913, PSPO #1140"
^DIC(9.4,35,22,3,"PAH",261,0)="282 SEQ #269^3090423.134944^17"
^DIC(9.4,35,22,3,"PAH",261,1,0)="^^37^37^3090423"
^DIC(9.4,35,22,3,"PAH",261,1,1,0)="1. A site reported that the parameter ORQQLR DATE RANGE INPT does not"
^DIC(9.4,35,22,3,"PAH",261,1,2,0)="honor the value at the location level. Routine ORWCV has been modified to"
^DIC(9.4,35,22,3,"PAH",261,1,3,0)="include the patient's location when an inpatient is selected. "
^DIC(9.4,35,22,3,"PAH",261,1,4,0)="HD0000000069279"
^DIC(9.4,35,22,3,"PAH",261,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",261,1,6,0)="2. When entering continuous lab orders with schedules that have a 'once"
^DIC(9.4,35,22,3,"PAH",261,1,7,0)="daily' frequency, a response to 'How Long?' of n or xn should calculate"
^DIC(9.4,35,22,3,"PAH",261,1,8,0)="the same stop date/time. Routine ORCSEND1 has been modified to use the"
^DIC(9.4,35,22,3,"PAH",261,1,9,0)="collection date and time of the last child order created as the stop date"
^DIC(9.4,35,22,3,"PAH",261,1,10,0)="and time of the parent order. when an inpatient is selected. "
^DIC(9.4,35,22,3,"PAH",261,1,11,0)="HD0000000069365, HD0000000069851"
^DIC(9.4,35,22,3,"PAH",261,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",261,1,13,0)="3. When entering a continuous lab order, with a response to 'How Long?'"
^DIC(9.4,35,22,3,"PAH",261,1,14,0)="that exceeds one day, the stop date is displaying incorrectly. The change"
^DIC(9.4,35,22,3,"PAH",261,1,15,0)="in item #2 for ORCSEND1 corrects this issue, as well, The collection date"
^DIC(9.4,35,22,3,"PAH",261,1,16,0)="and time of the last child order created will be used as the stop date and"
^DIC(9.4,35,22,3,"PAH",261,1,17,0)="time of the parent order. HD0000000070009"
^DIC(9.4,35,22,3,"PAH",261,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",261,1,19,0)="4. A provider accidentally selected both a parent lab order as well as"
^DIC(9.4,35,22,3,"PAH",261,1,20,0)="multiple child orders and then chose the action of 'discontinue'. Upon "
^DIC(9.4,35,22,3,"PAH",261,1,21,0)="signature, an error box displayed indicating the order had already been"
^DIC(9.4,35,22,3,"PAH",261,1,22,0)="signed. Two changes have been made to address this issue. "
^DIC(9.4,35,22,3,"PAH",261,1,23,0)=" "
^DIC(9.4,35,22,3,"PAH",261,1,24,0)="First, lab orders will no longer display the parent order. Only the child"
^DIC(9.4,35,22,3,"PAH",261,1,25,0)="orders will be displayed once the parent order is signed and released to"
^DIC(9.4,35,22,3,"PAH",261,1,26,0)="service. Routine ORCSEND1 has been modified to 'veil' the parent order"
^DIC(9.4,35,22,3,"PAH",261,1,27,0)="once the child orders are all created."
^DIC(9.4,35,22,3,"PAH",261,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",261,1,29,0)="Second, routine ORQ2 was modified to include the parent's stop date and"
^DIC(9.4,35,22,3,"PAH",261,1,30,0)="time in the detail display of the child order. This refers to the detail"
^DIC(9.4,35,22,3,"PAH",261,1,31,0)="display from the Orders tab. HD0000000070670"
^DIC(9.4,35,22,3,"PAH",261,1,32,0)=" "
^DIC(9.4,35,22,3,"PAH",261,1,33,0)="5. When troubleshooting an alert problem, it appears that the child orders"
^DIC(9.4,35,22,3,"PAH",261,1,34,0)="for a lab order do not show all the needed information. Routine ORCSEND3"
^DIC(9.4,35,22,3,"PAH",261,1,35,0)="was modified to treat child orders exactly as parent orders or a single"
^DIC(9.4,35,22,3,"PAH",261,1,36,0)="lab order. All the available information, such as signature, order checks,"
^DIC(9.4,35,22,3,"PAH",261,1,37,0)="etc. will now be found in the detailed display of each child order."
^DIC(9.4,35,22,3,"PAH",262,0)="212^3090609.153608^17"
^DIC(9.4,35,22,3,"PAH",262,1,0)="^^3^3^3090609"
^DIC(9.4,35,22,3,"PAH",262,1,1,0)="This patch implements the interface between CPRS and VBECS, installing"
^DIC(9.4,35,22,3,"PAH",262,1,2,0)="a new order dialog and other supporting components.  CPRS and VBECS are"
^DIC(9.4,35,22,3,"PAH",262,1,3,0)="both required to install this patch."
^DIC(9.4,35,22,3,"PAH",263,0)="298 SEQ #271^3090624.144052^17"
^DIC(9.4,35,22,3,"PAH",263,1,0)="^^1^1^3090624"
^DIC(9.4,35,22,3,"PAH",263,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",264,0)="283 SEQ #272^3090702.123423^17"
^DIC(9.4,35,22,3,"PAH",264,1,0)="^^97^97^3090702"
^DIC(9.4,35,22,3,"PAH",264,1,1,0)="1. A site reported a problem with duplicate orders in Inpatient"
^DIC(9.4,35,22,3,"PAH",264,1,2,0)="Medications V. 5.0. If there were delayed-event orders manually released"
^DIC(9.4,35,22,3,"PAH",264,1,3,0)="at the same time that the associated event occurred, duplicate orders were"
^DIC(9.4,35,22,3,"PAH",264,1,4,0)="sent to the service. PSI-07-128"
^DIC(9.4,35,22,3,"PAH",264,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,6,0)="2. Two of the test sites reported a problem regarding the change in item "
^DIC(9.4,35,22,3,"PAH",264,1,7,0)="#1 adversely affecting delayed Radiology orders."
^DIC(9.4,35,22,3,"PAH",264,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,9,0)="3. Two test sites reported a problem of receiving intermittent errors in "
^DIC(9.4,35,22,3,"PAH",264,1,10,0)="the ORWDX routine."
^DIC(9.4,35,22,3,"PAH",264,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,12,0)="4. During unit testing of the changes for the problem of duplicate "
^DIC(9.4,35,22,3,"PAH",264,1,13,0)="orders, an issue was found with locking of patient events. When multiple "
^DIC(9.4,35,22,3,"PAH",264,1,14,0)="orders for the same event are manually released, a lock on the patient "
^DIC(9.4,35,22,3,"PAH",264,1,15,0)="event remains after the process is completed."
^DIC(9.4,35,22,3,"PAH",264,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,17,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,18,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",264,1,19,0)="========="
^DIC(9.4,35,22,3,"PAH",264,1,20,0)="1. HD0000000199004     Discontinued order not showing in CPRS"
^DIC(9.4,35,22,3,"PAH",264,1,21,0)="   HD0000000069901     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,22,0)="   HD0000000070256     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,23,0)="   HD0000000092874     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,24,0)="   HD0000000165137     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,25,0)="   HD0000000174026     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,26,0)="   HD0000000280582     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,27,0)="   HD0000000300668     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,29,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",264,1,30,0)="   --------"
^DIC(9.4,35,22,3,"PAH",264,1,31,0)="   A series of delayed orders for Inpatient Medications was written. The "
^DIC(9.4,35,22,3,"PAH",264,1,32,0)="   orders were released to the service manually from the Computerized "
^DIC(9.4,35,22,3,"PAH",264,1,33,0)="   Patient Record System (CPRS) GUI at the same time the associated"
^DIC(9.4,35,22,3,"PAH",264,1,34,0)="   patient movement was performed. This resulted in some of the orders"
^DIC(9.4,35,22,3,"PAH",264,1,35,0)="   being duplicated in Inpatient Medications."
^DIC(9.4,35,22,3,"PAH",264,1,36,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,37,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",264,1,38,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",264,1,39,0)="   The locking logic in the release process has been modified to handle "
^DIC(9.4,35,22,3,"PAH",264,1,40,0)="   this situation. If the movement and manual release begin at the same "
^DIC(9.4,35,22,3,"PAH",264,1,41,0)="   time, only one will be allowed to process the orders. Routine ORWDX "
^DIC(9.4,35,22,3,"PAH",264,1,42,0)="   was modified to handle this."
^DIC(9.4,35,22,3,"PAH",264,1,43,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,44,0)="   In addition to the locking issue that was identified, there was a "
^DIC(9.4,35,22,3,"PAH",264,1,45,0)="   check added to ORWDX to ensure that the order had not already been "
^DIC(9.4,35,22,3,"PAH",264,1,46,0)="   released by a movement if the user selected manual release. This check "
^DIC(9.4,35,22,3,"PAH",264,1,47,0)="   already existed in the movement routine."
^DIC(9.4,35,22,3,"PAH",264,1,48,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,49,0)="2. HD0000000281619     Delayed Radiology orders discontinuing on release"
^DIC(9.4,35,22,3,"PAH",264,1,50,0)="   HD0000000284481     duplicate"
^DIC(9.4,35,22,3,"PAH",264,1,51,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,52,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",264,1,53,0)="   --------"
^DIC(9.4,35,22,3,"PAH",264,1,54,0)="   Delayed Radiology orders were being rejected by Radiology upon manual "
^DIC(9.4,35,22,3,"PAH",264,1,55,0)="   release. The error message was 'missing/invalid location'."
^DIC(9.4,35,22,3,"PAH",264,1,56,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,57,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",264,1,58,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",264,1,59,0)="   Routine ORWDX has been modified to record the location and treating    "
^DIC(9.4,35,22,3,"PAH",264,1,60,0)="   specialty for an order after the lock is successful, but before "
^DIC(9.4,35,22,3,"PAH",264,1,61,0)="   transmitting the order to the service."
^DIC(9.4,35,22,3,"PAH",264,1,62,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,63,0)="3. HD0000000298397     Intermittent ORWDX errors"
^DIC(9.4,35,22,3,"PAH",264,1,64,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,65,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",264,1,66,0)="   --------"
^DIC(9.4,35,22,3,"PAH",264,1,67,0)="   Under certain conditions, an error occurs in ORWDX when attempting to"
^DIC(9.4,35,22,3,"PAH",264,1,68,0)="   build the error message back to the user."
^DIC(9.4,35,22,3,"PAH",264,1,69,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,70,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",264,1,71,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",264,1,72,0)="   Routine ORWDX has been modified to ensure the error message array"
^DIC(9.4,35,22,3,"PAH",264,1,73,0)="   contains all the appropriate information so that no error will occur"
^DIC(9.4,35,22,3,"PAH",264,1,74,0)="   when the patient event is locked."
^DIC(9.4,35,22,3,"PAH",264,1,75,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,76,0)="4. HD0000000307535     Manual release of delayed orders could leave event "
^DIC(9.4,35,22,3,"PAH",264,1,77,0)="                       lock"
^DIC(9.4,35,22,3,"PAH",264,1,78,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,79,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",264,1,80,0)="   --------"
^DIC(9.4,35,22,3,"PAH",264,1,81,0)="   When manually releasing more than one delayed order for a single "
^DIC(9.4,35,22,3,"PAH",264,1,82,0)="   patient event, the event can remain locked once the process finishes."
^DIC(9.4,35,22,3,"PAH",264,1,83,0)="   Specifically, ^ORE(100.2,event number,0) will remain locked."
^DIC(9.4,35,22,3,"PAH",264,1,84,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,85,0)="   The problem is that routine ORWDX issues an incremental lock for the "
^DIC(9.4,35,22,3,"PAH",264,1,86,0)="   patient event associated with each order that is being released."
^DIC(9.4,35,22,3,"PAH",264,1,87,0)="   However, when the process completes, a single 'unlock' is issued. For "
^DIC(9.4,35,22,3,"PAH",264,1,88,0)="   example: three orders, associate with event number 9573 are manually "
^DIC(9.4,35,22,3,"PAH",264,1,89,0)="   released. When the process completes, the following entry remains in"
^DIC(9.4,35,22,3,"PAH",264,1,90,0)="   the lock table:"
^DIC(9.4,35,22,3,"PAH",264,1,91,0)="   38) 20E5C892 2       ^[""^^_$1$DGA228:[CHEY19.VBB]""]ORE(100.2,9573, 0)"
^DIC(9.4,35,22,3,"PAH",264,1,92,0)=" "
^DIC(9.4,35,22,3,"PAH",264,1,93,0)="   Solution:"
^DIC(9.4,35,22,3,"PAH",264,1,94,0)="   ---------"
^DIC(9.4,35,22,3,"PAH",264,1,95,0)="   Routine ORWDX has been modified to only issue one lock per event, "
^DIC(9.4,35,22,3,"PAH",264,1,96,0)="   regardless of the number of orders released that are associated with"
^DIC(9.4,35,22,3,"PAH",264,1,97,0)="   the event."
^DIC(9.4,35,22,3,"PAH",265,0)="296^3090828.101532^17"
^DIC(9.4,35,22,3,"PAH",266,0)="302^3090924.104729^17"
^DIC(9.4,35,22,3,"PAH",267,0)="268 SEQ #275^3090928.113327^17"
^DIC(9.4,35,22,3,"PAH",267,1,0)="^^70^70^3090928"
^DIC(9.4,35,22,3,"PAH",267,1,1,0)="A site reported a patient safety issue with the alert information "
^DIC(9.4,35,22,3,"PAH",267,1,2,0)="displayed when imaging results, either abnormal or not, are completed. "
^DIC(9.4,35,22,3,"PAH",267,1,3,0)="The problem stems from the fact that the alerts can be disabled and, if "
^DIC(9.4,35,22,3,"PAH",267,1,4,0)="so, due to the text of the alert, the provider may miss some critical "
^DIC(9.4,35,22,3,"PAH",267,1,5,0)="information."
^DIC(9.4,35,22,3,"PAH",267,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,7,0)="The final solution is considered an enhancement and the Radiology subject "
^DIC(9.4,35,22,3,"PAH",267,1,8,0)="matter expert will be working with the patient safety office to formulate "
^DIC(9.4,35,22,3,"PAH",267,1,9,0)="a new service request to outline the desired behavior."
^DIC(9.4,35,22,3,"PAH",267,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,11,0)="In the interim, the alert text is being modified to alleviate some of the "
^DIC(9.4,35,22,3,"PAH",267,1,12,0)="confusion. In addition, some documentation updates are being made to "
^DIC(9.4,35,22,3,"PAH",267,1,13,0)="remind sites to enable both of the alerts to ensure the provider gets all "
^DIC(9.4,35,22,3,"PAH",267,1,14,0)="the appropriate information."
^DIC(9.4,35,22,3,"PAH",267,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,16,0)="The NAME field (.01) and the MESSAGE TEXT field (.03) of the OE/RR "
^DIC(9.4,35,22,3,"PAH",267,1,17,0)="NOTIFICATIONS file (#100.9) are being modified for alerts 22 and 25 "
^DIC(9.4,35,22,3,"PAH",267,1,18,0)="(internal entry numbers for the two alerts). Alert 22 is being changed "
^DIC(9.4,35,22,3,"PAH",267,1,19,0)="from IMAGING RESULTS to IMAGING RESULTS, NON CRITICAL. Alert 25 is being "
^DIC(9.4,35,22,3,"PAH",267,1,20,0)="changed from ABNORMAL IMAGING RESULTS to ABNL IMAGING RESLT, NEED ATTN."
^DIC(9.4,35,22,3,"PAH",267,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,22,0)="The change is being made using a post-installation routine. The person "
^DIC(9.4,35,22,3,"PAH",267,1,23,0)="installing the patch will receive a MailMan message with a subject of "
^DIC(9.4,35,22,3,"PAH",267,1,24,0)="'OE/RR NOTIFICATIONS ALERT NAME UPDATES' when the update is complete."
^DIC(9.4,35,22,3,"PAH",267,1,25,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,26,0)="This patch requires a change in the Radiology/Nuclear Medicine V. 5.0 "
^DIC(9.4,35,22,3,"PAH",267,1,27,0)="package. The documentation changes to update the notification name will "
^DIC(9.4,35,22,3,"PAH",267,1,28,0)="be included in a separate documentation release."
^DIC(9.4,35,22,3,"PAH",267,1,29,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,30,0)="Please note: the post-install routine, ORY268, will be removed in a "
^DIC(9.4,35,22,3,"PAH",267,1,31,0)="future patch."
^DIC(9.4,35,22,3,"PAH",267,1,32,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,33,0)="Associated Remedy:"
^DIC(9.4,35,22,3,"PAH",267,1,34,0)="=================="
^DIC(9.4,35,22,3,"PAH",267,1,35,0)="1. HD0000000132027 Imaging Results versus Abnormal imaging results"
^DIC(9.4,35,22,3,"PAH",267,1,36,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,37,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",267,1,38,0)="=================="
^DIC(9.4,35,22,3,"PAH",267,1,39,0)="N/A"
^DIC(9.4,35,22,3,"PAH",267,1,40,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,41,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",267,1,42,0)="==========="
^DIC(9.4,35,22,3,"PAH",267,1,43,0)="TBA"
^DIC(9.4,35,22,3,"PAH",267,1,44,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,45,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",267,1,46,0)="========="
^DIC(9.4,35,22,3,"PAH",267,1,47,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,48,0)="1. HD0000000132027 Imaging Results versus Abnormal imaging results"
^DIC(9.4,35,22,3,"PAH",267,1,49,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,50,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",267,1,51,0)="   ========="
^DIC(9.4,35,22,3,"PAH",267,1,52,0)="   The Radiology Package currently always sends the following alert "
^DIC(9.4,35,22,3,"PAH",267,1,53,0)="   notifications to OERR/CPRS, conditioned on the type of result (normal, "
^DIC(9.4,35,22,3,"PAH",267,1,54,0)="   abnormal, amended - normal or abnormal)"
^DIC(9.4,35,22,3,"PAH",267,1,55,0)="      22 - IMAGING RESULTS (contains normal results)"
^DIC(9.4,35,22,3,"PAH",267,1,56,0)="      25 - ABNORMAL IMAGING RESULTS (contains abnormal results)"
^DIC(9.4,35,22,3,"PAH",267,1,57,0)="      53 - IMAGING RESULTS AMENDED (contains both normal and abnormal)"
^DIC(9.4,35,22,3,"PAH",267,1,58,0)="   Based on the parameter settings, some of these alerts may not display. "
^DIC(9.4,35,22,3,"PAH",267,1,59,0)="   Due to the text of the alert subject, this may be misleading for the "
^DIC(9.4,35,22,3,"PAH",267,1,60,0)="   provider."
^DIC(9.4,35,22,3,"PAH",267,1,61,0)=" "
^DIC(9.4,35,22,3,"PAH",267,1,62,0)="   Solution:"
^DIC(9.4,35,22,3,"PAH",267,1,63,0)="   ========="
^DIC(9.4,35,22,3,"PAH",267,1,64,0)="   The 'imaging results' notification may refer to both normal and "
^DIC(9.4,35,22,3,"PAH",267,1,65,0)="   abnormal results. The abnormal results are non-critical. The agreement "
^DIC(9.4,35,22,3,"PAH",267,1,66,0)="   between the Computerized Patient Record System (CPRS) Clinical"
^DIC(9.4,35,22,3,"PAH",267,1,67,0)="   Workgroup and the Radiology subject matter expert is to modify the"
^DIC(9.4,35,22,3,"PAH",267,1,68,0)="   text of alerts 22 and 25 to reduce the confusion. Alert 22 will    "
^DIC(9.4,35,22,3,"PAH",267,1,69,0)="   become 'IMAGING RESULTS NON CRITICAL'. Alert 25 will become 'ABNL"
^DIC(9.4,35,22,3,"PAH",267,1,70,0)="   IMAGING RESLT, NEED ATTN'."
^DIC(9.4,35,22,3,"PAH",268,0)="295^3091118.095639^17"
^DIC(9.4,35,22,3,"PAH",269,0)="319 SEQ #277^3100105.170032^17"
^DIC(9.4,35,22,3,"PAH",269,1,0)="^^2^2^3100105"
^DIC(9.4,35,22,3,"PAH",269,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",269,1,2,0)="under OR*3*319."
^DIC(9.4,35,22,3,"PAH",270,0)="307 SEQ #278^3100317.101349^17"
^DIC(9.4,35,22,3,"PAH",270,1,0)="^^2^2^3100317"
^DIC(9.4,35,22,3,"PAH",270,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",270,1,2,0)="under OR*3*307."
^DIC(9.4,35,22,3,"PAH",271,0)="309 SEQ #279^3100325.161703^17"
^DIC(9.4,35,22,3,"PAH",271,1,0)="^^1^1^3100325"
^DIC(9.4,35,22,3,"PAH",271,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",272,0)="290 SEQ #280^3100722.155016^17"
^DIC(9.4,35,22,3,"PAH",272,1,0)="^^24^24^3100722"
^DIC(9.4,35,22,3,"PAH",272,1,1,0)="A site reported a problem where a narcotic order replaced an audiology "
^DIC(9.4,35,22,3,"PAH",272,1,2,0)="consult order."
^DIC(9.4,35,22,3,"PAH",272,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",272,1,4,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",272,1,5,0)="========="
^DIC(9.4,35,22,3,"PAH",272,1,6,0)="HD0000000296920    Unexpected narcotic order found in OERR for a patient"
^DIC(9.4,35,22,3,"PAH",272,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",272,1,8,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",272,1,9,0)="   --------"
^DIC(9.4,35,22,3,"PAH",272,1,10,0)="   Upon examining the order affected in the ORDERS file (#100), it was "
^DIC(9.4,35,22,3,"PAH",272,1,11,0)="   discovered that an Outpatient Pharmacy prescription had over-written"
^DIC(9.4,35,22,3,"PAH",272,1,12,0)="   the audiology consult."
^DIC(9.4,35,22,3,"PAH",272,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",272,1,14,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",272,1,15,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",272,1,16,0)="   An issue was found in the Class III code which performs the AudioCare "
^DIC(9.4,35,22,3,"PAH",272,1,17,0)="   renewal process. The issue was in the difference between how the "
^DIC(9.4,35,22,3,"PAH",272,1,18,0)="   Computerized Patient Records System (CPRS) assigns a new order number"
^DIC(9.4,35,22,3,"PAH",272,1,19,0)="   and the process AudioCare renewal was using."
^DIC(9.4,35,22,3,"PAH",272,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",272,1,21,0)="   The decision was to create a Class I interface from the AudioCare "
^DIC(9.4,35,22,3,"PAH",272,1,22,0)="   refill/renewal system. The refill portion will not be affected. The "
^DIC(9.4,35,22,3,"PAH",272,1,23,0)="   renewal process will now use a standard CPRS Application Programming "
^DIC(9.4,35,22,3,"PAH",272,1,24,0)="   Interface (API) to perform the renewal."
^DIC(9.4,35,22,3,"PAH",273,0)="316 SEQ #281^3101018.112845^17"
^DIC(9.4,35,22,3,"PAH",273,1,0)="^^8^8^3101018"
^DIC(9.4,35,22,3,"PAH",273,1,1,0)="This patch will correct the following problems."
^DIC(9.4,35,22,3,"PAH",273,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",273,1,3,0)="HD0000000339814 - Glucophage Contrast Media Order Check not triggered."
^DIC(9.4,35,22,3,"PAH",273,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",273,1,5,0)="   Glucophage Contrast Media and Glucophage Lab Results Order Checks are "
^DIC(9.4,35,22,3,"PAH",273,1,6,0)="   not triggered for a metformin order with lower case letters in the drug"
^DIC(9.4,35,22,3,"PAH",273,1,7,0)="   name.  For instance, a site using TALLman lettering for a metformin"
^DIC(9.4,35,22,3,"PAH",273,1,8,0)="   order (metFORMIN) did not fire checks."
^DIC(9.4,35,22,3,"PAH",274,0)="330 SEQ #282^3101019.111655^17"
^DIC(9.4,35,22,3,"PAH",274,1,0)="^^2^2^3101019"
^DIC(9.4,35,22,3,"PAH",274,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",274,1,2,0)="under OR*3*330."
^DIC(9.4,35,22,3,"PAH",275,0)="317 SEQ #283^3101116.095425^17"
^DIC(9.4,35,22,3,"PAH",275,1,0)="^^8^8^3101116"
^DIC(9.4,35,22,3,"PAH",275,1,1,0)="This patch corrects 2 issues within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",275,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",275,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",275,1,4,0)="1. Signing multiple Lab Collect orders can result in a crash if their "
^DIC(9.4,35,22,3,"PAH",275,1,5,0)="   collection time has passed."
^DIC(9.4,35,22,3,"PAH",275,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",275,1,7,0)="2. IV Medication quick orders do not show the ""Give additional dose NOW?"" "
^DIC(9.4,35,22,3,"PAH",275,1,8,0)="   prompt when appropriate."
^DIC(9.4,35,22,3,"PAH",276,0)="336 SEQ #284^3110110.115121^17"
^DIC(9.4,35,22,3,"PAH",276,1,0)="^^24^24^3110110"
^DIC(9.4,35,22,3,"PAH",276,1,1,0)="A site reported a problem where a narcotic order replaced an audiology "
^DIC(9.4,35,22,3,"PAH",276,1,2,0)="consult order."
^DIC(9.4,35,22,3,"PAH",276,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",276,1,4,0)="Overview:"
^DIC(9.4,35,22,3,"PAH",276,1,5,0)="========="
^DIC(9.4,35,22,3,"PAH",276,1,6,0)="HD0000000296920    Unexpected narcotic order found in OERR for a patient"
^DIC(9.4,35,22,3,"PAH",276,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",276,1,8,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",276,1,9,0)="   --------"
^DIC(9.4,35,22,3,"PAH",276,1,10,0)="   Upon examining the order affected in the ORDERS file (#100), it was "
^DIC(9.4,35,22,3,"PAH",276,1,11,0)="   discovered that an Outpatient Pharmacy prescription had over-written"
^DIC(9.4,35,22,3,"PAH",276,1,12,0)="   the audiology consult."
^DIC(9.4,35,22,3,"PAH",276,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",276,1,14,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",276,1,15,0)="   -----------"
^DIC(9.4,35,22,3,"PAH",276,1,16,0)="   An issue was found in the Class III code which performs the AudioCare "
^DIC(9.4,35,22,3,"PAH",276,1,17,0)="   renewal process. The issue was in the difference between how the "
^DIC(9.4,35,22,3,"PAH",276,1,18,0)="   Computerized Patient Records System (CPRS) assigns a new order number"
^DIC(9.4,35,22,3,"PAH",276,1,19,0)="   and the process AudioCare renewal was using."
^DIC(9.4,35,22,3,"PAH",276,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",276,1,21,0)="   The decision was to create a Class I interface from the AudioCare "
^DIC(9.4,35,22,3,"PAH",276,1,22,0)="   refill/renewal system. The refill portion will not be affected. The "
^DIC(9.4,35,22,3,"PAH",276,1,23,0)="   renewal process will now use a standard CPRS Application Programming "
^DIC(9.4,35,22,3,"PAH",276,1,24,0)="   Interface (API) to perform the renewal."
^DIC(9.4,35,22,3,"PAH",277,0)="323 SEQ #285^3110210.105852^17"
^DIC(9.4,35,22,3,"PAH",277,1,0)="^^19^19^3110210"
^DIC(9.4,35,22,3,"PAH",277,1,1,0)="This patch corrects the following issue within the ORDER ENTRY/RESULTS"
^DIC(9.4,35,22,3,"PAH",277,1,2,0)="REPORTING package:"
^DIC(9.4,35,22,3,"PAH",277,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",277,1,4,0)="HD0000000352115 - Delayed order release event for repeating lab quick "
^DIC(9.4,35,22,3,"PAH",277,1,5,0)="                  order."
^DIC(9.4,35,22,3,"PAH",277,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",277,1,7,0)="   A repeating lab order with a released delay will wrongly copy the value"
^DIC(9.4,35,22,3,"PAH",277,1,8,0)="   Ordering Parameters Location field found in the firing event to the"
^DIC(9.4,35,22,3,"PAH",277,1,9,0)="   Ordering Location of the child order. "
^DIC(9.4,35,22,3,"PAH",277,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",277,1,11,0)="HD0000000377607 - DC1+5^ORCSEND Errors"
^DIC(9.4,35,22,3,"PAH",277,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",277,1,13,0)="   The Order file's veiled field originally was used to hide unreleased "
^DIC(9.4,35,22,3,"PAH",277,1,14,0)="   orders many years ago. The functionality was brought to use once more "
^DIC(9.4,35,22,3,"PAH",277,1,15,0)="   by patch OR*3*282 to hide lab parent orders once they are signed."
^DIC(9.4,35,22,3,"PAH",277,1,16,0)="   Unfortunately, it was not discovered that running the Lab Order Checks"
^DIC(9.4,35,22,3,"PAH",277,1,17,0)="   clean up utilities purged old veiled orders. This functionality may "
^DIC(9.4,35,22,3,"PAH",277,1,18,0)="   have been appropriate for unsigned new orders but not for signed parent"
^DIC(9.4,35,22,3,"PAH",277,1,19,0)="   orders."
^DIC(9.4,35,22,3,"PAH",278,0)="294 SEQ #286^3110303.113033^17"
^DIC(9.4,35,22,3,"PAH",279,0)="293^3110308.135203^17"
^DIC(9.4,35,22,3,"PAH",280,0)="280^3110308.135257^17"
^DIC(9.4,35,22,3,"PAH",280,1,0)="^^2^2^3110308"
^DIC(9.4,35,22,3,"PAH",280,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",280,1,2,0)="under OR*3*280."
^DIC(9.4,35,22,3,"PAH",281,0)="337^3110308.135721^17"
^DIC(9.4,35,22,3,"PAH",281,1,0)="^^2^2^3110308"
^DIC(9.4,35,22,3,"PAH",281,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",281,1,2,0)="under OR*3*280."
^DIC(9.4,35,22,3,"PAH",282,0)="272^3110428.1607^17"
^DIC(9.4,35,22,3,"PAH",283,0)="339 SEQ #291^3110628.123145^17"
^DIC(9.4,35,22,3,"PAH",283,1,0)="^^38^38^3110628"
^DIC(9.4,35,22,3,"PAH",283,1,1,0)="This patch resolves the following problems:"
^DIC(9.4,35,22,3,"PAH",283,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",283,1,3,0)="  Assure that cosigner is identified as primary provider in PCE, if user "
^DIC(9.4,35,22,3,"PAH",283,1,4,0)="  is a non-Provider (e.g., Student, Pharmacy Tech, etc.)."
^DIC(9.4,35,22,3,"PAH",283,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",283,1,6,0)="  Problem with Other Indication not being ""remembered"" between sessions."
^DIC(9.4,35,22,3,"PAH",283,1,7,0)="    "
^DIC(9.4,35,22,3,"PAH",283,1,8,0)="  Assure that Scheduled (in addition to Pending or Active) Consults get "
^DIC(9.4,35,22,3,"PAH",283,1,9,0)="  completed when Initial Note is filed."
^DIC(9.4,35,22,3,"PAH",283,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",283,1,11,0)="  Implemented key filtering and range checking for daily dosages. Problem "
^DIC(9.4,35,22,3,"PAH",283,1,12,0)="  with auto-calculation of daily dosage, and problem changing tablets in"
^DIC(9.4,35,22,3,"PAH",283,1,13,0)="  daily dosing."
^DIC(9.4,35,22,3,"PAH",283,1,14,0)=" "
^DIC(9.4,35,22,3,"PAH",283,1,15,0)="  <UNDEFINED> error on start-up, which occurs when entering a New Patient "
^DIC(9.4,35,22,3,"PAH",283,1,16,0)="  whose most recent INR was cancelled."
^DIC(9.4,35,22,3,"PAH",283,1,17,0)="    "
^DIC(9.4,35,22,3,"PAH",283,1,18,0)="  Replacing the number of tablets in daily dosing may result in a zero "
^DIC(9.4,35,22,3,"PAH",283,1,19,0)="  being appended unintentionally."
^DIC(9.4,35,22,3,"PAH",283,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",283,1,21,0)="  Division by zero error in Rosendaal Report, which occurs when "
^DIC(9.4,35,22,3,"PAH",283,1,22,0)="  patienthas two consecutive INRs which are identical, one in-range and "
^DIC(9.4,35,22,3,"PAH",283,1,23,0)="  one-out, due to goal range change. "
^DIC(9.4,35,22,3,"PAH",283,1,24,0)="    "
^DIC(9.4,35,22,3,"PAH",283,1,25,0)="  Problem where lab orders were not being placed by Anticoagulator unless "
^DIC(9.4,35,22,3,"PAH",283,1,26,0)="  a note was also written. This was happening because the Order Entry API "
^DIC(9.4,35,22,3,"PAH",283,1,27,0)="  requires an Encounter Location, and the corresponding variable was only "
^DIC(9.4,35,22,3,"PAH",283,1,28,0)="  being set if a note was also entered."
^DIC(9.4,35,22,3,"PAH",283,1,29,0)=" "
^DIC(9.4,35,22,3,"PAH",283,1,30,0)="  Problem where changes in the patient location were not being recorded "
^DIC(9.4,35,22,3,"PAH",283,1,31,0)="  when the user clicked on the Save and Exit button."
^DIC(9.4,35,22,3,"PAH",283,1,32,0)="    "
^DIC(9.4,35,22,3,"PAH",283,1,33,0)="  The original application didn't allow INRs to be ordered for collection "
^DIC(9.4,35,22,3,"PAH",283,1,34,0)="  on the weekend. Site's reported that they often need to order for "
^DIC(9.4,35,22,3,"PAH",283,1,35,0)="  weekend collection. The application was modified to inform the user "
^DIC(9.4,35,22,3,"PAH",283,1,36,0)="  that the date they selected for the next draw is a Saturday (or "
^DIC(9.4,35,22,3,"PAH",283,1,37,0)="  Sunday), and allow them to leave it or change it, as they deem "
^DIC(9.4,35,22,3,"PAH",283,1,38,0)="  appropriate."
^DIC(9.4,35,22,3,"PAH",284,0)="346 SEQ #292^3110812.135933^17"
^DIC(9.4,35,22,3,"PAH",285,0)="333^3110908.140905^17"
^DIC(9.4,35,22,3,"PAH",285,1,0)="^^5^5^3110908"
^DIC(9.4,35,22,3,"PAH",285,1,1,0)=" This patch will correct an issue with complex orders entered through"
^DIC(9.4,35,22,3,"PAH",285,1,2,0)=" CPRS. If the complex order uses a THEN conjunction and the admin time of "
^DIC(9.4,35,22,3,"PAH",285,1,3,0)=" a single section of the order is before the current time, that"
^DIC(9.4,35,22,3,"PAH",285,1,4,0)=" administration was being dropped off. This would only happen on a section"
^DIC(9.4,35,22,3,"PAH",285,1,5,0)=" of the complex order other than the first section."
^DIC(9.4,35,22,3,"PAH",286,0)="338 SEQ #294^3111013.114609^17"
^DIC(9.4,35,22,3,"PAH",286,1,0)="^^2^2^3111013"
^DIC(9.4,35,22,3,"PAH",286,1,1,0)="This patch will correct an index out of bounds error that occurs when a "
^DIC(9.4,35,22,3,"PAH",286,1,2,0)="user adds too many coversheet reports to the CPRS gui."
^DIC(9.4,35,22,3,"PAH",287,0)="329 SEQ #295^3111021.11334^17"
^DIC(9.4,35,22,3,"PAH",287,1,0)="^^5^5^3111021"
^DIC(9.4,35,22,3,"PAH",287,1,1,0)="Unseen orders are being auto-unflagged when processing a flagged orders "
^DIC(9.4,35,22,3,"PAH",287,1,2,0)="alert."
^DIC(9.4,35,22,3,"PAH",287,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",287,1,4,0)="A flagged order recipient doesn't see a notification if an order is "
^DIC(9.4,35,22,3,"PAH",287,1,5,0)="flagged too soon after a previous flagged order."
^DIC(9.4,35,22,3,"PAH",288,0)="332 SEQ #296^3111129.12491^17"
^DIC(9.4,35,22,3,"PAH",288,1,0)="^^1^1^3111129"
^DIC(9.4,35,22,3,"PAH",288,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",289,0)="297 SEQ #297^3111212.151426^17"
^DIC(9.4,35,22,3,"PAH",289,1,0)="^^13^13^3111212"
^DIC(9.4,35,22,3,"PAH",289,1,1,0)="1. Patch OR*3*281 added a temporary menu option and routine to the system"
^DIC(9.4,35,22,3,"PAH",289,1,2,0)="to assist in cleaning up Radiology quick orders. This patch removes that"
^DIC(9.4,35,22,3,"PAH",289,1,3,0)="option and routine. HD0000000218893"
^DIC(9.4,35,22,3,"PAH",289,1,4,0)="2. Patch OR*3*299 added a temporary routine to the system to clean up "
^DIC(9.4,35,22,3,"PAH",289,1,5,0)="problem Outpatient medication orders. This patch removes that routine."
^DIC(9.4,35,22,3,"PAH",289,1,6,0)="HD0000000284146"
^DIC(9.4,35,22,3,"PAH",289,1,7,0)="3. Enter/edit QO restriction [ORCM QO ITEMS] allows PHARMACY as a "
^DIC(9.4,35,22,3,"PAH",289,1,8,0)="restriction. However, the code that processes restrictions does not check "
^DIC(9.4,35,22,3,"PAH",289,1,9,0)="for this. The workgroup decision was that the specific package needed to "
^DIC(9.4,35,22,3,"PAH",289,1,10,0)="be used. This patch removes PHARMACY as an option."
^DIC(9.4,35,22,3,"PAH",289,1,11,0)="4. Enter/edit quick orders [ORCM QUICK ORDERS] option would get an "
^DIC(9.4,35,22,3,"PAH",289,1,12,0)="undefined error when editing the infusion rate field if the text was over "
^DIC(9.4,35,22,3,"PAH",289,1,13,0)="20 characters in length."
^DIC(9.4,35,22,3,"PAH",290,0)="204 SEQ #298^3120104.091018^17"
^DIC(9.4,35,22,3,"PAH",290,1,0)="^^26^26^3120104"
^DIC(9.4,35,22,3,"PAH",290,1,1,0)="Problem:"
^DIC(9.4,35,22,3,"PAH",290,1,2,0)="A site reported a problem with the transfer of complex Outpatient "
^DIC(9.4,35,22,3,"PAH",290,1,3,0)="Medication orders that contained a conjunction of THEN. The problem is "
^DIC(9.4,35,22,3,"PAH",290,1,4,0)="that when the order goes (in its entirety) to Inpatient Medications there "
^DIC(9.4,35,22,3,"PAH",290,1,5,0)="is no way for the provider or the finishing pharmacist to determine how "
^DIC(9.4,35,22,3,"PAH",290,1,6,0)="far into the process the order has progressed."
^DIC(9.4,35,22,3,"PAH",290,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,8,0)="The patient safety workgroup recommended that transfer of Outpatient "
^DIC(9.4,35,22,3,"PAH",290,1,9,0)="medication orders with a THEN conjunction should be prevented."
^DIC(9.4,35,22,3,"PAH",290,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,11,0)="Resolution:"
^DIC(9.4,35,22,3,"PAH",290,1,12,0)="Modified routine ORCACT0 to disallow the transfer of a complex order with "
^DIC(9.4,35,22,3,"PAH",290,1,13,0)="THEN as the conjunction."
^DIC(9.4,35,22,3,"PAH",290,1,14,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,15,0)="Associated Remedy:"
^DIC(9.4,35,22,3,"PAH",290,1,16,0)="=================="
^DIC(9.4,35,22,3,"PAH",290,1,17,0)="HD0000000205100  -  1 Complex Orders Transferring for Providers"
^DIC(9.4,35,22,3,"PAH",290,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,19,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,20,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",290,1,21,0)="=================="
^DIC(9.4,35,22,3,"PAH",290,1,22,0)="N/A"
^DIC(9.4,35,22,3,"PAH",290,1,23,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",290,1,25,0)="Test Sites:"
^DIC(9.4,35,22,3,"PAH",290,1,26,0)="==========="
^DIC(9.4,35,22,3,"PAH",291,0)="318 SEQ #299^3120104.091027^17"
^DIC(9.4,35,22,3,"PAH",291,1,0)="^^5^5^3120104"
^DIC(9.4,35,22,3,"PAH",291,1,1,0)="This patch corrects an issue within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",291,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",291,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",291,1,4,0)="HD0000000343856 - If there are multiple lab orders in a given day then"
^DIC(9.4,35,22,3,"PAH",291,1,5,0)="the Lab Orders clinical report will only display one."
^DIC(9.4,35,22,3,"PAH",292,0)="347 SEQ #300^3120113.105047^17"
^DIC(9.4,35,22,3,"PAH",292,1,0)="^^12^12^3120113"
^DIC(9.4,35,22,3,"PAH",292,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,35,22,3,"PAH",292,1,2,0)="1)Relative dates are not saving time in custom views in the CPRS orders "
^DIC(9.4,35,22,3,"PAH",292,1,3,0)="  tab."
^DIC(9.4,35,22,3,"PAH",292,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",292,1,5,0)="2)Data on the clinical surgery report is hanging over from one item to "
^DIC(9.4,35,22,3,"PAH",292,1,6,0)="  another."
^DIC(9.4,35,22,3,"PAH",292,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",292,1,8,0)="3)When creating a new patient movement, discontinued orders are "
^DIC(9.4,35,22,3,"PAH",292,1,9,0)="  displaying on the ""Copy active orders for selected event"" dialog"
^DIC(9.4,35,22,3,"PAH",292,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",292,1,11,0)="4)Incorrect data is showing up on the Search orders by Nature or Status "
^DIC(9.4,35,22,3,"PAH",292,1,12,0)="  [OR NATURE/STATUS ORDER SEARCH] report."
^DIC(9.4,35,22,3,"PAH",293,0)="324 SEQ #301^3120201.11432^17"
^DIC(9.4,35,22,3,"PAH",293,1,0)="^^14^14^3120201"
^DIC(9.4,35,22,3,"PAH",293,1,1,0)="This patch will correct the following issues"
^DIC(9.4,35,22,3,"PAH",293,1,2,0)="When a patient is discharged and the user, at the Review Delayed Orders "
^DIC(9.4,35,22,3,"PAH",293,1,3,0)="prompt, enters ""^^"" or lets the system timeout the discharge process does"
^DIC(9.4,35,22,3,"PAH",293,1,4,0)="not fully complete. Once the Review Delayed Orders prompt is exited in one"
^DIC(9.4,35,22,3,"PAH",293,1,5,0)="of the ways described above, processes that are supposed to take place"
^DIC(9.4,35,22,3,"PAH",293,1,6,0)="during the discharge don't happen. This is causing some orders to not"
^DIC(9.4,35,22,3,"PAH",293,1,7,0)="discontinue."
^DIC(9.4,35,22,3,"PAH",293,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",293,1,9,0)="It was discovered that if a patient is discharged and only has pharmacy "
^DIC(9.4,35,22,3,"PAH",293,1,10,0)="and/or dietetic orders, the auto discontinue of these orders is not being"
^DIC(9.4,35,22,3,"PAH",293,1,11,0)="recorded in the OE/RR PATIENT EVENT file (#100.2). There is also a rare"
^DIC(9.4,35,22,3,"PAH",293,1,12,0)="circumstance in which if the user discharging the patient is assigned to a"
^DIC(9.4,35,22,3,"PAH",293,1,13,0)="different division than the location of the ward. The entry to the OE/RR"
^DIC(9.4,35,22,3,"PAH",293,1,14,0)="PATIENT EVENT file (#100.2) is not created."
^DIC(9.4,35,22,3,"PAH",294,0)="340 SEQ #302^3120213.14064^17"
^DIC(9.4,35,22,3,"PAH",294,1,0)="^^7^7^3120213"
^DIC(9.4,35,22,3,"PAH",294,1,1,0)="This patch is part of the Identification of Principal Mental Health"
^DIC(9.4,35,22,3,"PAH",294,1,2,0)="Provider(IPMHP) project.  It is to be released in conjunction with PCMM"
^DIC(9.4,35,22,3,"PAH",294,1,3,0)="patch SD*5.3*575, with SD*5.3*575 being installed first.  The purpose of"
^DIC(9.4,35,22,3,"PAH",294,1,4,0)="this patch is to implement the API being released in SD*5.3*575 to display"
^DIC(9.4,35,22,3,"PAH",294,1,5,0)="the Principal Mental Health Provider in two locations within CPRS GUI, one"
^DIC(9.4,35,22,3,"PAH",294,1,6,0)="being the patient detail display and the other being the Primary Care"
^DIC(9.4,35,22,3,"PAH",294,1,7,0)="button detailed display."
^DIC(9.4,35,22,3,"PAH",295,0)="327 SEQ #303^3120323.125147^17"
^DIC(9.4,35,22,3,"PAH",295,1,0)="^^21^21^3120323"
^DIC(9.4,35,22,3,"PAH",295,1,1,0)="1.  HD0000000377325 - 9 SHWTLT+10^XPAREDT3 Error "
^DIC(9.4,35,22,3,"PAH",295,1,2,0)="    --------------------------------------------"
^DIC(9.4,35,22,3,"PAH",295,1,3,0)="    Selecting the GUI Reports User Display Parameters option causes a "
^DIC(9.4,35,22,3,"PAH",295,1,4,0)="    SHWTLT+10^XPAREDT3 Error."
^DIC(9.4,35,22,3,"PAH",295,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",295,1,6,0)=" 2. HD0000000069559 - 9 PUG-1101-51042  Can't change user values-Report "
^DIC(9.4,35,22,3,"PAH",295,1,7,0)="    parameters "
^DIC(9.4,35,22,3,"PAH",295,1,8,0)="    --------------------------------------------"
^DIC(9.4,35,22,3,"PAH",295,1,9,0)="    The GUI Reports User Display Parameters option does not allow user "
^DIC(9.4,35,22,3,"PAH",295,1,10,0)="    selection."
^DIC(9.4,35,22,3,"PAH",295,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",295,1,12,0)=" 3. HD0000000300224 - 2 LAB QUICK ORDER"
^DIC(9.4,35,22,3,"PAH",295,1,13,0)="    --------------------------------------------"
^DIC(9.4,35,22,3,"PAH",295,1,14,0)="    When building a quick order the How long field does not properly"
^DIC(9.4,35,22,3,"PAH",295,1,15,0)="    apply the Max days limit when using Xnumber of times format."
^DIC(9.4,35,22,3,"PAH",295,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",295,1,17,0)=" 4. HD0000000406792 - 3 Standard Schedule (Changed) Creates Endless "
^DIC(9.4,35,22,3,"PAH",295,1,18,0)="    Loop for Finishing Pharmacist"
^DIC(9.4,35,22,3,"PAH",295,1,19,0)="    --------------------------------------------"
^DIC(9.4,35,22,3,"PAH",295,1,20,0)="    When renewing an order with an invalid/changed schedule, IV orders"
^DIC(9.4,35,22,3,"PAH",295,1,21,0)="    are not properly verified."
^DIC(9.4,35,22,3,"PAH",296,0)="314 SEQ #304^3120329.183706^17"
^DIC(9.4,35,22,3,"PAH",296,1,0)="^^4^4^3120329"
^DIC(9.4,35,22,3,"PAH",296,1,1,0)="This patch corrects an issue with a recursive lookup that causes a very"
^DIC(9.4,35,22,3,"PAH",296,1,2,0)="long pause in the software.  It also corrects a situation where a user"
^DIC(9.4,35,22,3,"PAH",296,1,3,0)="can select a large number of items to replace, but only some of them are"
^DIC(9.4,35,22,3,"PAH",296,1,4,0)="updated."
^DIC(9.4,35,22,3,"PAH",297,0)="284 SEQ #305^3120418.162652^17"
^DIC(9.4,35,22,3,"PAH",297,1,0)="^^14^14^3120418"
^DIC(9.4,35,22,3,"PAH",297,1,1,0)="1. The Display Patient Alerts and Alert Recipeients [ORB3 ALERT"
^DIC(9.4,35,22,3,"PAH",297,1,2,0)="RECIPIENTS] option always uses the default action of 'Close' - even when "
^DIC(9.4,35,22,3,"PAH",297,1,3,0)="there is more than one screen of alerts. This patch modifies this "
^DIC(9.4,35,22,3,"PAH",297,1,4,0)="behavior so that if a screen is not the last screen of the display, the "
^DIC(9.4,35,22,3,"PAH",297,1,5,0)="default action is 'Next Screen'. HD0000000069366"
^DIC(9.4,35,22,3,"PAH",297,1,6,0)="2. The Orders tab detailed display shows the order along with the most"
^DIC(9.4,35,22,3,"PAH",297,1,7,0)="recent Chart Review information. However, when there is a change to the"
^DIC(9.4,35,22,3,"PAH",297,1,8,0)="original order, and that change has a chart review performed, the detail"
^DIC(9.4,35,22,3,"PAH",297,1,9,0)="information is incorrect. The problem is that the current chart review "
^DIC(9.4,35,22,3,"PAH",297,1,10,0)="information is written over the previous information. This patch corrects "
^DIC(9.4,35,22,3,"PAH",297,1,11,0)="this problem by having the chart review information behave the same as the"
^DIC(9.4,35,22,3,"PAH",297,1,12,0)="other verify actions. If an action is chart reviewed, and the previous"
^DIC(9.4,35,22,3,"PAH",297,1,13,0)="action was not chart reviewed, the current chart review information is"
^DIC(9.4,35,22,3,"PAH",297,1,14,0)="used for the previous action. HD0000000268742"
^DIC(9.4,35,22,3,"PAH",298,0)="341 SEQ #306^3120829.121749^17"
^DIC(9.4,35,22,3,"PAH",298,1,0)="^^11^11^3120829"
^DIC(9.4,35,22,3,"PAH",298,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,35,22,3,"PAH",298,1,2,0)="1)An undefined error when a patient in observation is discharged."
^DIC(9.4,35,22,3,"PAH",298,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",298,1,4,0)="2)When using the Manage orderable items [ORCM ORDERABLES MENU] for "
^DIC(9.4,35,22,3,"PAH",298,1,5,0)="editing orderable items, orderable items are selectable for edit by "
^DIC(9.4,35,22,3,"PAH",298,1,6,0)="internalentry number (IEN) even if they are not in the appropriate "
^DIC(9.4,35,22,3,"PAH",298,1,7,0)="display group."
^DIC(9.4,35,22,3,"PAH",298,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",298,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",298,1,10,0)="3)A subscript error when an ordernumber of 0 is sent back to the ORWDX1 "
^DIC(9.4,35,22,3,"PAH",298,1,11,0)="ORDMATCH Remote procedure call."
^DIC(9.4,35,22,3,"PAH",299,0)="322 SEQ #307^3120829.122303^17"
^DIC(9.4,35,22,3,"PAH",299,1,0)="^^23^23^3120829"
^DIC(9.4,35,22,3,"PAH",299,1,1,0)="This patch corrects 4 issues within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",299,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",299,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",299,1,4,0)="1. Cancelling orders from a Delayed Orders list in CPRS (Computerized "
^DIC(9.4,35,22,3,"PAH",299,1,5,0)="   Patient Record System) GUI (Graphical User Interface) causes them "
^DIC(9.4,35,22,3,"PAH",299,1,6,0)="   to appear in the Active Orders list. They should be filtered out "
^DIC(9.4,35,22,3,"PAH",299,1,7,0)="   until the release event happens."
^DIC(9.4,35,22,3,"PAH",299,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",299,1,9,0)="2. Patch OR*3*296 added the prompt 'Do you wish to continue?' to Vista"
^DIC(9.4,35,22,3,"PAH",299,1,10,0)="   option Medication Quick Order Report [OR MEDICATION QO CHECKER]. If "
^DIC(9.4,35,22,3,"PAH",299,1,11,0)="   the user enters a lower case letter 'n' the report runs anyway."
^DIC(9.4,35,22,3,"PAH",299,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",299,1,13,0)="3. When using the remove function for VistA option Team List Mgmt Menu"
^DIC(9.4,35,22,3,"PAH",299,1,14,0)="   [ORLP TEAM MENU] the special number '999' is used to display more "
^DIC(9.4,35,22,3,"PAH",299,1,15,0)="   patients. When the list contains more than 998 patients, the entry"
^DIC(9.4,35,22,3,"PAH",299,1,16,0)="   '999' removes the patient in position 999 instead of displaying more"
^DIC(9.4,35,22,3,"PAH",299,1,17,0)="   patients."
^DIC(9.4,35,22,3,"PAH",299,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",299,1,19,0)="4. When using the remove function for VistA option Team List Mgmt Menu"
^DIC(9.4,35,22,3,"PAH",299,1,20,0)="   [ORLP TEAM MENU] the special number '999' is used to display more "
^DIC(9.4,35,22,3,"PAH",299,1,21,0)="   patients. When the list contains more than 39 patients and one of the "
^DIC(9.4,35,22,3,"PAH",299,1,22,0)="   patients has an IEN of 999, the entry '999' has you select between the "
^DIC(9.4,35,22,3,"PAH",299,1,23,0)="   patient and the more option."
^DIC(9.4,35,22,3,"PAH",300,0)="357^3120829.122452^17"
^DIC(9.4,35,22,3,"PAH",300,1,0)="^^3^3^3120829"
^DIC(9.4,35,22,3,"PAH",300,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,35,22,3,"PAH",300,1,2,0)="under OR*3.0*357."
^DIC(9.4,35,22,3,"PAH",300,1,3,0)=""
^DIC(9.4,35,22,3,"PAH",301,0)="362 SEQ #309^3121101.115708^17"
^DIC(9.4,35,22,3,"PAH",301,1,0)="^^4^4^3121101"
^DIC(9.4,35,22,3,"PAH",301,1,1,0)="The purpose of this patch is to provide a software bug fix for CPRS.  "
^DIC(9.4,35,22,3,"PAH",301,1,2,0)="This patch corrects the following issue:"
^DIC(9.4,35,22,3,"PAH",301,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",301,1,4,0)="-Schedule change error for IMO orders"
^DIC(9.4,35,22,3,"PAH",302,0)="331 SEQ #310^3121113.160317^17"
^DIC(9.4,35,22,3,"PAH",302,1,0)="^^15^15^3121113"
^DIC(9.4,35,22,3,"PAH",302,1,1,0)="This patch corrects 4 issues within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",302,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",302,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",302,1,4,0)="1. Copying a generic order that used static dates (eg Jul 9, "
^DIC(9.4,35,22,3,"PAH",302,1,5,0)="   2010) instead of relative dates (eg T+3) may result in a new order with"
^DIC(9.4,35,22,3,"PAH",302,1,6,0)="   invalid dates."
^DIC(9.4,35,22,3,"PAH",302,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",302,1,8,0)="2. Renewing a nursing order with static dates may result in a new order "
^DIC(9.4,35,22,3,"PAH",302,1,9,0)="   with invalid dates."
^DIC(9.4,35,22,3,"PAH",302,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",302,1,11,0)="3. Copying a lab order with a static date results in a new order with a "
^DIC(9.4,35,22,3,"PAH",302,1,12,0)="   blank date."
^DIC(9.4,35,22,3,"PAH",302,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",302,1,14,0)="4. Copying a lab order will not generate a duplicate check against the"
^DIC(9.4,35,22,3,"PAH",302,1,15,0)="   original order."
^DIC(9.4,35,22,3,"PAH",303,0)="313 SEQ #311^3130103.115131^17"
^DIC(9.4,35,22,3,"PAH",303,1,0)="^^6^6^3130103"
^DIC(9.4,35,22,3,"PAH",303,1,1,0)="This patch updates the OE/RR NOTIFICATION (#100.9) alert CONSULT/REQUEST"
^DIC(9.4,35,22,3,"PAH",303,1,2,0)="UPDATED to inform the user of all actions that triggers the alert. The "
^DIC(9.4,35,22,3,"PAH",303,1,3,0)="patch also updates the ORDER DIALOG (#101.41) entry GMRCOR REQUEST to "
^DIC(9.4,35,22,3,"PAH",303,1,4,0)="always prompt the user with the RELATED SERVICES saved on the Quick Order "
^DIC(9.4,35,22,3,"PAH",303,1,5,0)="and allow them to change it, if needed.  The help text when creating a "
^DIC(9.4,35,22,3,"PAH",303,1,6,0)="new prompt has been updated to remove the ""subfile"" wording."
^DIC(9.4,35,22,3,"PAH",304,0)="351 SEQ #312^3130103.115139^17"
^DIC(9.4,35,22,3,"PAH",304,1,0)="^^9^9^3130103"
^DIC(9.4,35,22,3,"PAH",304,1,1,0)="This patch will correct the following"
^DIC(9.4,35,22,3,"PAH",304,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",304,1,3,0)="1. When a patient has changed clinics and is displaying on the team "
^DIC(9.4,35,22,3,"PAH",304,1,4,0)="   list for the new clinic. They are not being removed from the old"
^DIC(9.4,35,22,3,"PAH",304,1,5,0)="   clinic's team list."
^DIC(9.4,35,22,3,"PAH",304,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",304,1,7,0)="2. When listing all patients on a clinic team list using the "
^DIC(9.4,35,22,3,"PAH",304,1,8,0)="   Anticoagulation Patinet Lists [ORAM PATIENT LIST MENU] option, patients"
^DIC(9.4,35,22,3,"PAH",304,1,9,0)="   whos name begins with the letter Z do not show up."
^DIC(9.4,35,22,3,"PAH",305,0)="352 SEQ #313^3130212.103812^17"
^DIC(9.4,35,22,3,"PAH",305,1,0)="^^5^5^3130212"
^DIC(9.4,35,22,3,"PAH",305,1,1,0)="This is a companion patch to the Medication Order Check Healthcare "
^DIC(9.4,35,22,3,"PAH",305,1,2,0)="Application (MOCHA) version 1.0 Enhancements 1 group of patches that will"
^DIC(9.4,35,22,3,"PAH",305,1,3,0)="resolve a number of issues with the Computerized Patient Record System"
^DIC(9.4,35,22,3,"PAH",305,1,4,0)="(CPRS) version 3.0 order checking functionality. See the patch message for"
^DIC(9.4,35,22,3,"PAH",305,1,5,0)="a full listing of issues addressed and installation instructions."
^DIC(9.4,35,22,3,"PAH",306,0)="315 SEQ #314^3130213.120214^17"
^DIC(9.4,35,22,3,"PAH",306,1,0)="^^58^58^3130213"
^DIC(9.4,35,22,3,"PAH",306,1,1,0)="1. In the Computerized Patient Record System (CPRS), on the Labs tab,"
^DIC(9.4,35,22,3,"PAH",306,1,2,0)="under Anatomic Pathology, the accession number display should be changed"
^DIC(9.4,35,22,3,"PAH",306,1,3,0)="to show the Commercial-Off-The-Shelf (COTS) accession number. This patch"
^DIC(9.4,35,22,3,"PAH",306,1,4,0)="makes this change by looking for the presence of the Application"
^DIC(9.4,35,22,3,"PAH",306,1,5,0)="Programming Interface (API) GETACC^LRJWLST. If that API exists, CPRS will"
^DIC(9.4,35,22,3,"PAH",306,1,6,0)="use it to retrieve the COTS accession number from the LAB DATA file "
^DIC(9.4,35,22,3,"PAH",306,1,7,0)="(#63). If no COTS accession number is available, the legacy accession "
^DIC(9.4,35,22,3,"PAH",306,1,8,0)="number will display."
^DIC(9.4,35,22,3,"PAH",306,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,10,0)="2. In CPRS, on the Labs tab, under Microbiology, the accession number"
^DIC(9.4,35,22,3,"PAH",306,1,11,0)="display should be changed to show the COTS accession number. This patch"
^DIC(9.4,35,22,3,"PAH",306,1,12,0)="makes this change by looking for the presence of the API GETACC^LRJWLST"
^DIC(9.4,35,22,3,"PAH",306,1,13,0)="and, if present, uses the API to retrieve the COTS accession number from"
^DIC(9.4,35,22,3,"PAH",306,1,14,0)="the LAB DATA file (#63). If no COTS accession number is available, the "
^DIC(9.4,35,22,3,"PAH",306,1,15,0)="legacy accession number will display."
^DIC(9.4,35,22,3,"PAH",306,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,17,0)="3. Laboratory V5.2 patch LR*5.2*425 is adding the ability to inactivate a"
^DIC(9.4,35,22,3,"PAH",306,1,18,0)="collection sample. CPRS will now honor the INACTIVE DATE (#64.9101) field"
^DIC(9.4,35,22,3,"PAH",306,1,19,0)="in the COLLECTION SAMPLE (#62) file."
^DIC(9.4,35,22,3,"PAH",306,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,21,0)="4. An error was occurring in CPRS when attempting to display the Anatomic "
^DIC(9.4,35,22,3,"PAH",306,1,22,0)="Pathology supplemental report. The error was caused by a modification "
^DIC(9.4,35,22,3,"PAH",306,1,23,0)="done in support of the LEDI v4 release. In order to eliminate the error, "
^DIC(9.4,35,22,3,"PAH",306,1,24,0)="a modification was done to CPRS to support the LEDI v4 change."
^DIC(9.4,35,22,3,"PAH",306,1,25,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,26,0)="5. There are two new order reasons being used by Laboratory V5.2. They "
^DIC(9.4,35,22,3,"PAH",306,1,27,0)="are Obsolete Order and Purged Order. A request was made that these two "
^DIC(9.4,35,22,3,"PAH",306,1,28,0)="reasons be added to the ORDER REASON file (#100.03). The post install of "
^DIC(9.4,35,22,3,"PAH",306,1,29,0)="this patch will automatically add these reasons."
^DIC(9.4,35,22,3,"PAH",306,1,30,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,31,0)="6. The Lab users have requested that when certain fields are updated in "
^DIC(9.4,35,22,3,"PAH",306,1,32,0)="the LABORATORY TEST (#60) file, there should be a CPRS call made to search"
^DIC(9.4,35,22,3,"PAH",306,1,33,0)="for quick orders that contain the test that was updated. If any are found,"
^DIC(9.4,35,22,3,"PAH",306,1,34,0)="the appropriate personnel will be notified. This patch addresses this"
^DIC(9.4,35,22,3,"PAH",306,1,35,0)="issue by creating a new routine ORLRQO that will search for the specified"
^DIC(9.4,35,22,3,"PAH",306,1,36,0)="test and notify the members of the OR CACS mail group. They will be told"
^DIC(9.4,35,22,3,"PAH",306,1,37,0)="the quick order name and whether it is active or inactive."
^DIC(9.4,35,22,3,"PAH",306,1,38,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,39,0)="7. Since the COTS system, when present, will now be considered the Lab"
^DIC(9.4,35,22,3,"PAH",306,1,40,0)="system of record, the date/time completed from the COTS system should be"
^DIC(9.4,35,22,3,"PAH",306,1,41,0)="what is stored in the Lab system as the date/time completed. However, this"
^DIC(9.4,35,22,3,"PAH",306,1,42,0)="might cause some concern on the CPRS side since there may be a delay if"
^DIC(9.4,35,22,3,"PAH",306,1,43,0)="the interface from VistA to the COTS system is down for any reason. In"
^DIC(9.4,35,22,3,"PAH",306,1,44,0)="order to help mitigate this issue, this patch will modify the information"
^DIC(9.4,35,22,3,"PAH",306,1,45,0)="stored in the RESULTS DATE/TIME field (#71) of the ORDER file (#100) to"
^DIC(9.4,35,22,3,"PAH",306,1,46,0)="contain the date/time the results information was sent to CPRS, rather"
^DIC(9.4,35,22,3,"PAH",306,1,47,0)="than the date/time completed from the COTS system."
^DIC(9.4,35,22,3,"PAH",306,1,48,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,49,0)="8. Laboratory V5.2 patch LR*5.2*425 is adding the ability to inactivate a"
^DIC(9.4,35,22,3,"PAH",306,1,50,0)="topography. CPRS will now honor the INACTIVE DATE (#64.9103) field"
^DIC(9.4,35,22,3,"PAH",306,1,51,0)="in the TOPOGRAPHY FIELD (#61) file."
^DIC(9.4,35,22,3,"PAH",306,1,52,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,53,0)="9. The Laboratory Lab System Re-engineering project (LSRP) has requested"
^DIC(9.4,35,22,3,"PAH",306,1,54,0)="an API to allow Lab to unveil an order in CPRS. This patch adds that new"
^DIC(9.4,35,22,3,"PAH",306,1,55,0)="API."
^DIC(9.4,35,22,3,"PAH",306,1,56,0)=" "
^DIC(9.4,35,22,3,"PAH",306,1,57,0)="10. LSRP has requested an API to update the PACKAGE REFERENCE field (#33) "
^DIC(9.4,35,22,3,"PAH",306,1,58,0)="of the ORDER file (#100). This patch adds that new API."
^DIC(9.4,35,22,3,"PAH",307,0)="348^3130516.125604^17"
^DIC(9.4,35,22,3,"PAH",307,1,0)="^^2^2^3130516"
^DIC(9.4,35,22,3,"PAH",307,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,35,22,3,"PAH",307,1,2,0)="under OR*3.0*348."
^DIC(9.4,35,22,3,"PAH",308,0)="218^3130614.08594^17"
^DIC(9.4,35,22,3,"PAH",308,1,0)="^^3^3^3130614"
^DIC(9.4,35,22,3,"PAH",308,1,1,0)="CONTAINS COMPONENTS NEEDED TO COMPLETE THE PRE-INSTALLATION OF"
^DIC(9.4,35,22,3,"PAH",308,1,2,0)="COMPUTERIZED PATIENT RECORD SYSTEM (CPRS) VERSION 29. REFER TO THE PATCH"
^DIC(9.4,35,22,3,"PAH",308,1,3,0)="DESCRIPTION FOR INSTALLATION INSTRUCTIONS AND COMPONENT INFORMATION."
^DIC(9.4,35,22,3,"PAH",309,0)="306^3130614.090305^17"
^DIC(9.4,35,22,3,"PAH",309,1,0)="^^2^2^3130614"
^DIC(9.4,35,22,3,"PAH",309,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",309,1,2,0)="under OR*3*306."
^DIC(9.4,35,22,3,"PAH",310,0)="371^3130614.090327^17"
^DIC(9.4,35,22,3,"PAH",311,0)="366 SEQ #319^3130620.110832^17"
^DIC(9.4,35,22,3,"PAH",312,0)="356 SEQ #320^3130829.111138^17"
^DIC(9.4,35,22,3,"PAH",312,1,0)="^^13^13^3130829"
^DIC(9.4,35,22,3,"PAH",312,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,35,22,3,"PAH",312,1,2,0)="1) When ordering certain types of quick orders. Information about the "
^DIC(9.4,35,22,3,"PAH",312,1,3,0)="   order such as service connected and treatment factors display, even "
^DIC(9.4,35,22,3,"PAH",312,1,4,0)="   though there has been no opportunity to enter this information about "
^DIC(9.4,35,22,3,"PAH",312,1,5,0)="   the order."
^DIC(9.4,35,22,3,"PAH",312,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",312,1,7,0)="2) When orderable items are flagged to display an alert to the provider "
^DIC(9.4,35,22,3,"PAH",312,1,8,0)="   when they are expiring. They were not creating alerts correctly for "
^DIC(9.4,35,22,3,"PAH",312,1,9,0)="   the outpatient paramter."
^DIC(9.4,35,22,3,"PAH",312,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",312,1,11,0)="3) In certain scenarios, when entries to the Orders File (#100) are  "
^DIC(9.4,35,22,3,"PAH",312,1,12,0)="   deleted, there are dangling cross references that are left behind. "
^DIC(9.4,35,22,3,"PAH",312,1,13,0)="   These cause errors during nightly processing and cprs order views."
^DIC(9.4,35,22,3,"PAH",313,0)="363 SEQ #321^3130904.094532^17"
^DIC(9.4,35,22,3,"PAH",314,0)="354 SEQ #322^3130905.130132^17"
^DIC(9.4,35,22,3,"PAH",314,1,0)="^^24^24^3130905"
^DIC(9.4,35,22,3,"PAH",314,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,35,22,3,"PAH",314,1,2,0)="1) When running the Anticoagulation Management GUI, in some cases "
^DIC(9.4,35,22,3,"PAH",314,1,3,0)="   the help file will fail to be found."
^DIC(9.4,35,22,3,"PAH",314,1,4,0)="  "
^DIC(9.4,35,22,3,"PAH",314,1,5,0)="2) After a Missed Appointment has been filed, there are cases in "
^DIC(9.4,35,22,3,"PAH",314,1,6,0)="   which the Daily dosing schedule and total weekly dose don't "
^DIC(9.4,35,22,3,"PAH",314,1,7,0)="   coincide with what has been entered into the patient notes."
^DIC(9.4,35,22,3,"PAH",314,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",314,1,9,0)="3) The clinic and facility-wide calculation of the time in therapeutic "
^DIC(9.4,35,22,3,"PAH",314,1,10,0)="   range (TTR) using the Rosendaal method count inactive patients. "
^DIC(9.4,35,22,3,"PAH",314,1,11,0)="   This is incorrect because the Rosendaal method makes no mention of "
^DIC(9.4,35,22,3,"PAH",314,1,12,0)="   missed appointments."
^DIC(9.4,35,22,3,"PAH",314,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",314,1,14,0)="4) It is possible to create progress notes that contain no text. This "
^DIC(9.4,35,22,3,"PAH",314,1,15,0)="   is caused by the user having the ability to continue and file the "
^DIC(9.4,35,22,3,"PAH",314,1,16,0)="   note before making a selection about what data to put in the note."
^DIC(9.4,35,22,3,"PAH",314,1,17,0)=" "
^DIC(9.4,35,22,3,"PAH",314,1,18,0)="5) The patients lost to follow up utility does not take missed "
^DIC(9.4,35,22,3,"PAH",314,1,19,0)="   appointments into account. This will cause a provider to incorrectly "
^DIC(9.4,35,22,3,"PAH",314,1,20,0)="   believe that a patient has been seen, where he/she may have, in "
^DIC(9.4,35,22,3,"PAH",314,1,21,0)="   reality, just missed an appointment."
^DIC(9.4,35,22,3,"PAH",314,1,22,0)="   "
^DIC(9.4,35,22,3,"PAH",314,1,23,0)="6) Error ""'¼' is not a valid floating point value"" is displaying when "
^DIC(9.4,35,22,3,"PAH",314,1,24,0)="   entering 0.25 as the tablet size for a Monday dose."
^DIC(9.4,35,22,3,"PAH",315,0)="320 SEQ #323^3130910.10412^17"
^DIC(9.4,35,22,3,"PAH",315,1,0)="^^9^9^3130910"
^DIC(9.4,35,22,3,"PAH",315,1,1,0)="This patch corrects 1 issue within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",315,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",315,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",315,1,4,0)="1. The Patient Selection screen can be set up to display a clinic's "
^DIC(9.4,35,22,3,"PAH",315,1,5,0)="   appointments for a date range. The screen will show no more than 200"
^DIC(9.4,35,22,3,"PAH",315,1,6,0)="   appointments. The screen does not show the user any message that the"
^DIC(9.4,35,22,3,"PAH",315,1,7,0)="   maximum has been reached and that some of the appointments for the date"
^DIC(9.4,35,22,3,"PAH",315,1,8,0)="   range are not being displayed. The appointments dropped can be from any"
^DIC(9.4,35,22,3,"PAH",315,1,9,0)="   part of the date range."
^DIC(9.4,35,22,3,"PAH",316,0)="380 SEQ #324^3131018.162755^17"
^DIC(9.4,35,22,3,"PAH",317,0)="266 SEQ #325^3131212.141153^17"
^DIC(9.4,35,22,3,"PAH",317,1,0)="^^4^4^3131212"
^DIC(9.4,35,22,3,"PAH",317,1,1,0)="In support of the Clinic Orders project, a need has been identified to "
^DIC(9.4,35,22,3,"PAH",317,1,2,0)="send Nurse Verify information from the Computerized Patient Record System "
^DIC(9.4,35,22,3,"PAH",317,1,3,0)="V. 1.0 to Inpatient Medications V. 5.0. The purpose of this patch is to "
^DIC(9.4,35,22,3,"PAH",317,1,4,0)="make this modification."
^DIC(9.4,35,22,3,"PAH",318,0)="372 SEQ #326^3140106.161559^17"
^DIC(9.4,35,22,3,"PAH",319,0)="383 SEQ #327^3140205.141654^17"
^DIC(9.4,35,22,3,"PAH",320,0)="349 SEQ #328^3140220.150401^17"
^DIC(9.4,35,22,3,"PAH",320,1,0)="^^12^12^3140220"
^DIC(9.4,35,22,3,"PAH",320,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,35,22,3,"PAH",320,1,2,0)="1) Parameter definition description missing for OR AUTORENEWAL USER."
^DIC(9.4,35,22,3,"PAH",320,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",320,1,4,0)="2) Renewed prescriptions processed by AUDIOCARE are showing the user "
^DIC(9.4,35,22,3,"PAH",320,1,5,0)="   who processed audiocare renewals as the person who entered the "
^DIC(9.4,35,22,3,"PAH",320,1,6,0)="   renewal."
^DIC(9.4,35,22,3,"PAH",320,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",320,1,8,0)="3) Mail messages from AudioCare Auto-renewal are not displaying "
^DIC(9.4,35,22,3,"PAH",320,1,9,0)="   enough information to identify a patient in CPRS."
^DIC(9.4,35,22,3,"PAH",320,1,10,0)="  "
^DIC(9.4,35,22,3,"PAH",320,1,11,0)="4) When a mail message from AudiCare Auto-renwal is alerting about an "
^DIC(9.4,35,22,3,"PAH",320,1,12,0)="   invalid Provider status, the provider in question is not known."
^DIC(9.4,35,22,3,"PAH",321,0)="370 SEQ #329^3140307.085529^17"
^DIC(9.4,35,22,3,"PAH",321,1,0)="^^1^1^3140307"
^DIC(9.4,35,22,3,"PAH",321,1,1,0)="Prevent notes without text from being signed"
^DIC(9.4,35,22,3,"PAH",322,0)="345^3140407.172333^17"
^DIC(9.4,35,22,3,"PAH",323,0)="311^3140407.172403^17"
^DIC(9.4,35,22,3,"PAH",323,1,0)="^^3^3^3140407"
^DIC(9.4,35,22,3,"PAH",323,1,1,0)="CONTAINS FOLLOW-UP FIXES FOR ORDER ENTRY/RESULTS REPORTING SOFTWARE "
^DIC(9.4,35,22,3,"PAH",323,1,2,0)="VERSION 3.0 PATCH 345 (OR*3*345). REFER TO THE PATCH DESCRIPTION FOR "
^DIC(9.4,35,22,3,"PAH",323,1,3,0)="INSTALLATION INSTRUCTIONS AND COMPONENT INFORMATION."
^DIC(9.4,35,22,3,"PAH",324,0)="381^3140407.172418^17"
^DIC(9.4,35,22,3,"PAH",324,1,0)="^^4^4^3140407"
^DIC(9.4,35,22,3,"PAH",324,1,1,0)="THIS PATCH CORRECTS THE SAME PATIENT SAFETY ISSUE CORRECTED IN PATCH "
^DIC(9.4,35,22,3,"PAH",324,1,2,0)="OR*3*380, HOWEVER, IT INCORPORATES OTHER CHANGES MADE BY PATCH OR*3*311, "
^DIC(9.4,35,22,3,"PAH",324,1,3,0)="PART OF THE MOCHA 2 BUILD. REFER TO THE PATCH DESCRIPTION FOR A DETAILED "
^DIC(9.4,35,22,3,"PAH",324,1,4,0)="EXPLANATION."
^DIC(9.4,35,22,3,"PAH",325,0)="367 SEQ #333^3140414.104638^17"
^DIC(9.4,35,22,3,"PAH",326,0)="384 SEQ #334^3140414.104645^17"
^DIC(9.4,35,22,3,"PAH",327,0)="334 SEQ #335^3140421.160648^17"
^DIC(9.4,35,22,3,"PAH",327,1,0)="^^6^6^3140421"
^DIC(9.4,35,22,3,"PAH",327,1,1,0)="This patch corrects 1 issue within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",327,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",327,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",327,1,4,0)="1. The Auto-unflagging of orders with the ORPF AUTO UNFLAG parameter set"
^DIC(9.4,35,22,3,"PAH",327,1,5,0)="   to YES has resulted in pharmacy queries or reccomendations not being"
^DIC(9.4,35,22,3,"PAH",327,1,6,0)="   read or responded to."
^DIC(9.4,35,22,3,"PAH",328,0)="375 SEQ #336^3140423.091937^17"
^DIC(9.4,35,22,3,"PAH",328,1,0)="^^1^1^3140423"
^DIC(9.4,35,22,3,"PAH",328,1,1,0)="Delayed order-Framestack-Cumulative Report fixes"
^DIC(9.4,35,22,3,"PAH",329,0)="286 SEQ #337^3140424.141721^17"
^DIC(9.4,35,22,3,"PAH",329,1,0)="^^10^10^3140424"
^DIC(9.4,35,22,3,"PAH",329,1,1,0)="This patch corrects 3 issues within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",329,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",329,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",329,1,4,0)="1. Changing an unsigned order does not update the entering provider."
^DIC(9.4,35,22,3,"PAH",329,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",329,1,6,0)="2. Chart Copies are enabled for printing even when no format has "
^DIC(9.4,35,22,3,"PAH",329,1,7,0)="   been set up."
^DIC(9.4,35,22,3,"PAH",329,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",329,1,9,0)="3. There is a discrepancy in metric measure conversions for weight between"
^DIC(9.4,35,22,3,"PAH",329,1,10,0)="   the Cover Sheet and the Vitals entry form."
^DIC(9.4,35,22,3,"PAH",330,0)="379 SEQ #338^3140610.093913^17"
^DIC(9.4,35,22,3,"PAH",330,1,0)="^^3^3^3140610"
^DIC(9.4,35,22,3,"PAH",330,1,1,0)="Modified the API LMENTRY^ORB3U1 to properly parse out the alert message "
^DIC(9.4,35,22,3,"PAH",330,1,2,0)="containing the CV tagged data in addition to the current parsing "
^DIC(9.4,35,22,3,"PAH",330,1,3,0)="mechanism in place."
^DIC(9.4,35,22,3,"PAH",331,0)="388 SEQ #339^3140624.11162^17"
^DIC(9.4,35,22,3,"PAH",332,0)="361^3140805.163719^17"
^DIC(9.4,35,22,3,"PAH",332,1,0)="^^2^2^3140805"
^DIC(9.4,35,22,3,"PAH",332,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",332,1,2,0)="under OR*3*361."
^DIC(9.4,35,22,3,"PAH",333,0)="392 SEQ #341^3140807.100729^17"
^DIC(9.4,35,22,3,"PAH",333,1,0)="^^2^2^3140807"
^DIC(9.4,35,22,3,"PAH",333,1,1,0)="CPRS RPC changes for the VIA project. See patch description for further "
^DIC(9.4,35,22,3,"PAH",333,1,2,0)="details."
^DIC(9.4,35,22,3,"PAH",334,0)="374 SEQ #342^3140811.17344^17"
^DIC(9.4,35,22,3,"PAH",334,1,0)="^^1^1^3140811"
^DIC(9.4,35,22,3,"PAH",334,1,1,0)="See patch description for full content description."
^DIC(9.4,35,22,3,"PAH",335,0)="386 SEQ #343^3140814.143722^17"
^DIC(9.4,35,22,3,"PAH",336,0)="394 SEQ #344^3140826.170136^17"
^DIC(9.4,35,22,3,"PAH",337,0)="111 SEQ #345^3140902.125502^17"
^DIC(9.4,35,22,3,"PAH",337,1,0)="^^2^2^3140902"
^DIC(9.4,35,22,3,"PAH",337,1,1,0)="The purpose of this patch is to provide an API to Pharmacy for returning "
^DIC(9.4,35,22,3,"PAH",337,1,2,0)="the nature of order for a CPRS order."
^DIC(9.4,35,22,3,"PAH",338,0)="273 SEQ #346^3140905.100925^17"
^DIC(9.4,35,22,3,"PAH",338,1,0)="^^17^17^3140905"
^DIC(9.4,35,22,3,"PAH",338,1,1,0)="This patch corrects 6 issues within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",338,1,2,0)="package relating to team lists:"
^DIC(9.4,35,22,3,"PAH",338,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",338,1,4,0)="1. Error on entering ""^"" at the Type prompt of option ORLP TEAM ADD."
^DIC(9.4,35,22,3,"PAH",338,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",338,1,6,0)="2. Team list visibility is changed when edited."
^DIC(9.4,35,22,3,"PAH",338,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",338,1,8,0)="3. Locks are set late when creating or renaming lists."
^DIC(9.4,35,22,3,"PAH",338,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",338,1,10,0)="4. CPRS will allow a duplicate team list name when entering personal "
^DIC(9.4,35,22,3,"PAH",338,1,11,0)="   lists."
^DIC(9.4,35,22,3,"PAH",338,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",338,1,13,0)="5. Occasionally, the option ORLP3M DISPLAY LIST SOURCE displays the"
^DIC(9.4,35,22,3,"PAH",338,1,14,0)="   current user's list source instead of the selected user."
^DIC(9.4,35,22,3,"PAH",338,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",338,1,16,0)="6. Various ORLP options do not timeout when selecting a list in use "
^DIC(9.4,35,22,3,"PAH",338,1,17,0)="   elsewhere."
^DIC(9.4,35,22,3,"PAH",339,0)="385^3140905.101138^17"
^DIC(9.4,35,22,3,"PAH",339,1,0)="^^2^2^3140905"
^DIC(9.4,35,22,3,"PAH",339,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",339,1,2,0)="under OR*3.0*385."
^DIC(9.4,35,22,3,"PAH",340,0)="353 SEQ #348^3140905.101156^17"
^DIC(9.4,35,22,3,"PAH",340,1,0)="^^19^19^3140905"
^DIC(9.4,35,22,3,"PAH",340,1,1,0)="The International Classification of Diseases, Tenth Revision (ICD-10) "
^DIC(9.4,35,22,3,"PAH",340,1,2,0)="Class 1 Software Remediation project replaces the 30-year-old set of "
^DIC(9.4,35,22,3,"PAH",340,1,3,0)="diagnosis and procedure codes (ICD-9-CM) that medical personnel use. "
^DIC(9.4,35,22,3,"PAH",340,1,4,0)="Dates of service, or dates of discharge for inpatients, that occur on or "
^DIC(9.4,35,22,3,"PAH",340,1,5,0)="after the implementation date will use the ICD-10 code set. Clinical "
^DIC(9.4,35,22,3,"PAH",340,1,6,0)="Modification (ICD-10-CM) diagnosis codes increase from about 13,000 ICD-9 "
^DIC(9.4,35,22,3,"PAH",340,1,7,0)="codes to more than 68,000. Procedure Coding System (ICD-10-PCS) procedure "
^DIC(9.4,35,22,3,"PAH",340,1,8,0)="codes increase from about 3,800 ICD-9 codes to nearly 87,000. Both "
^DIC(9.4,35,22,3,"PAH",340,1,9,0)="systems also expand the number of characters allotted to seven "
^DIC(9.4,35,22,3,"PAH",340,1,10,0)="alpha-numeric characters. This value does not include the decimal point, "
^DIC(9.4,35,22,3,"PAH",340,1,11,0)="which follows the third character for the ICD-10-CM code set. There is no "
^DIC(9.4,35,22,3,"PAH",340,1,12,0)="decimal point in the ICD-10-PCS code set. "
^DIC(9.4,35,22,3,"PAH",340,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",340,1,14,0)="These code sets have the potential to reveal more about quality of care, "
^DIC(9.4,35,22,3,"PAH",340,1,15,0)="so that data can be used in a more meaningful way to better understand "
^DIC(9.4,35,22,3,"PAH",340,1,16,0)="complications, better design clinically robust algorithms, and better "
^DIC(9.4,35,22,3,"PAH",340,1,17,0)="track the outcomes of care. ICD-10-CM also incorporates greater "
^DIC(9.4,35,22,3,"PAH",340,1,18,0)="specificity and clinical detail to provide information for clinical "
^DIC(9.4,35,22,3,"PAH",340,1,19,0)="decision making and outcomes research."
^DIC(9.4,35,22,3,"PAH",341,0)="404^3141110.164617^17"
^DIC(9.4,35,22,3,"PAH",342,0)="398^3150128.155431^17"
^DIC(9.4,35,22,3,"PAH",342,1,0)="^^2^2^3150128"
^DIC(9.4,35,22,3,"PAH",342,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",342,1,2,0)="under OR*3.0*398."
^DIC(9.4,35,22,3,"PAH",343,0)="312 SEQ #351^3150317.164604^17"
^DIC(9.4,35,22,3,"PAH",343,1,0)="^^1^1^3150317"
^DIC(9.4,35,22,3,"PAH",343,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",344,0)="391^3150520.091102^17"
^DIC(9.4,35,22,3,"PAH",344,1,0)="^^2^2^3150520"
^DIC(9.4,35,22,3,"PAH",344,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,35,22,3,"PAH",344,1,2,0)="under OR*3.0*391."
^DIC(9.4,35,22,3,"PAH",345,0)="406^3150916.111012^17"
^DIC(9.4,35,22,3,"PAH",345,1,0)="^^2^2^3150916"
^DIC(9.4,35,22,3,"PAH",345,1,1,0)="Sets the ORWRP TIME/OCC LIMITS INDV parameter at the Package level for "
^DIC(9.4,35,22,3,"PAH",345,1,2,0)="several OE/RR REPORT file entries."
^DIC(9.4,35,22,3,"PAH",346,0)="418 SEQ #354^3150916.112605^17"
^DIC(9.4,35,22,3,"PAH",346,1,0)="^^1^1^3150916"
^DIC(9.4,35,22,3,"PAH",346,1,1,0)="Emergency release of 30.A to address ICD10 issues."
^DIC(9.4,35,22,3,"PAH",347,0)="409 SEQ #355^3151007.16045^17"
^DIC(9.4,35,22,3,"PAH",347,1,0)="^^5^5^3151007"
^DIC(9.4,35,22,3,"PAH",347,1,1,0)="The purpose of this patch is to provide a software bug fix for CPRS "
^DIC(9.4,35,22,3,"PAH",347,1,2,0)="orders functionality.  This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",347,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",347,1,4,0)="-'Treating Specialty' disappears when order is renewed or Give Additional "
^DIC(9.4,35,22,3,"PAH",347,1,5,0)="Dose Now is selected."
^DIC(9.4,35,22,3,"PAH",348,0)="410^3151201.174229^54"
^DIC(9.4,35,22,3,"PAH",348,1,0)="^^6^6^3151201"
^DIC(9.4,35,22,3,"PAH",348,1,1,0)="This patch corrects 2 issues within the ORDER ENTRY/RESULTS REPORTING "
^DIC(9.4,35,22,3,"PAH",348,1,2,0)="package:"
^DIC(9.4,35,22,3,"PAH",348,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",348,1,4,0)="1. Non-OERR alerts are being deleted without the rights to do so."
^DIC(9.4,35,22,3,"PAH",348,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",348,1,6,0)="2. Typo in the CPRS User Guide:GUI Version."
^DIC(9.4,35,22,3,"PAH",349,0)="387^3151211.143643^17"
^DIC(9.4,35,22,3,"PAH",349,1,0)="^^2^2^3151211"
^DIC(9.4,35,22,3,"PAH",349,1,1,0)="This build changes the source of Primary Care information in the "
^DIC(9.4,35,22,3,"PAH",349,1,2,0)="header and details wondow from VistA to PCMMR."
^DIC(9.4,35,22,3,"PAH",350,0)="411 SEQ #358^3151211.144041^17"
^DIC(9.4,35,22,3,"PAH",351,0)="402 SEQ #359^3160108.114223^54"
^DIC(9.4,35,22,3,"PAH",351,1,0)="^^1^1^3160108"
^DIC(9.4,35,22,3,"PAH",351,1,1,0)="OR*3.0*402"
^DIC(9.4,35,22,3,"PAH",352,0)="395 SEQ #360^3160127.152737^54"
^DIC(9.4,35,22,3,"PAH",353,0)="389 SEQ #361^3160310.145231^54"
^DIC(9.4,35,22,3,"PAH",354,0)="350^3160310.154808^54"
^DIC(9.4,35,22,3,"PAH",354,1,0)="^^4^4^3160310"
^DIC(9.4,35,22,3,"PAH",354,1,1,0)="This build contains the OE/RR items affected by the rename of EARLIEST "
^DIC(9.4,35,22,3,"PAH",354,1,2,0)="DATE (123;17) to CLINICALLY INDICATED DATE."
^DIC(9.4,35,22,3,"PAH",354,1,3,0)="This build should restore the M routines, order dialogs, and ORCDGMRC"
^DIC(9.4,35,22,3,"PAH",354,1,4,0)="EARLIEST DATE DEFAULT parameter to a pre-OR*3.0*350 state."
^DIC(9.4,35,22,3,"PAH",355,0)="424^3160310.170055^54"
^DIC(9.4,35,22,3,"PAH",356,0)="390^3160407.160228^54"
^DIC(9.4,35,22,3,"PAH",357,0)="426 SEQ #365^3160504.125304^54"
^DIC(9.4,35,22,3,"PAH",358,0)="269^3160526.154916^54"
^DIC(9.4,35,22,3,"PAH",358,1,0)="^^6^6^3160526"
^DIC(9.4,35,22,3,"PAH",358,1,1,0)="CONTAINS ROUTINE UPDATES THAT WILL ENABLE COMPUTERIZED PATIENT RECORD "
^DIC(9.4,35,22,3,"PAH",358,1,2,0)="SYSTEM (CPRS) VERSION 1.0.29 TO DISPLAY SIGNS/SYMPTOMS WITH MEDICATION "
^DIC(9.4,35,22,3,"PAH",358,1,3,0)="ORDER CHECK MESSAGES AND WILL ENABLE REMOTE DATA INTEROPERABILITY (RDI) "
^DIC(9.4,35,22,3,"PAH",358,1,4,0)="TO RETRIEVE SIGN/SYMPTOM, SEVERITY, AND OBSERVED/HISTORICAL DATA FOR AN "
^DIC(9.4,35,22,3,"PAH",358,1,5,0)="ADVERSE REACTION FROM THE HEALTH DATA REPOSITORY (HDR). REFER TO THE "
^DIC(9.4,35,22,3,"PAH",358,1,6,0)="PATCH DESCRIPTION FOR INSTALLATION INSTRUCTIONS AND FURTHER INFORMATION."
^DIC(9.4,35,22,3,"PAH",359,0)="433 SEQ #367^3160916.134041^54"
^DIC(9.4,35,22,3,"PAH",359,1,0)="^^1^1^3160916"
^DIC(9.4,35,22,3,"PAH",359,1,1,0)="OR RPC updates for VIAB*1*7."
^DIC(9.4,35,22,3,"PAH",360,0)="422 SEQ #368^3160923.155334^54"
^DIC(9.4,35,22,3,"PAH",360,1,0)="^^182^182^3160923"
^DIC(9.4,35,22,3,"PAH",360,1,1,0)="The OR*3.0*422 patch allows the use of special characters (particularly "
^DIC(9.4,35,22,3,"PAH",360,1,2,0)="punctuation) within the Order Menu Management Menu Editor. A previous "
^DIC(9.4,35,22,3,"PAH",360,1,3,0)="VistA patch disallowed use of special characters. The patch was intended "
^DIC(9.4,35,22,3,"PAH",360,1,4,0)="to prevent display problems within ListManager; however, most sites are "
^DIC(9.4,35,22,3,"PAH",360,1,5,0)="using the Computerized Patient Record System (CPRS) Graphical User "
^DIC(9.4,35,22,3,"PAH",360,1,6,0)="Interface (GUI) and the inability to utilize punctuation can negatively "
^DIC(9.4,35,22,3,"PAH",360,1,7,0)="impact the clarity of menu options and instructions. This modification "
^DIC(9.4,35,22,3,"PAH",360,1,8,0)="restores the ability to use certain special characters in Order Menu "
^DIC(9.4,35,22,3,"PAH",360,1,9,0)="Management so that users can more clearly specify order menu options. "
^DIC(9.4,35,22,3,"PAH",360,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,11,0)="Use of the following special characters will now be allowed: hyphen (-), "
^DIC(9.4,35,22,3,"PAH",360,1,12,0)="semicolon (;), comma (,), and equal sign (=). Use of the caret (^) is "
^DIC(9.4,35,22,3,"PAH",360,1,13,0)="still restricted because it is used as a field delimiter in VistA. "
^DIC(9.4,35,22,3,"PAH",360,1,14,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,15,0)="Additional changes will be made to the Data Dictionary elements of the "
^DIC(9.4,35,22,3,"PAH",360,1,16,0)="ORDER DIALOG (#101.41) file to modify the Help displayed when entering a "
^DIC(9.4,35,22,3,"PAH",360,1,17,0)="question mark at a VistA prompt. The affected fields are: "
^DIC(9.4,35,22,3,"PAH",360,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,19,0)="* ORDER DIALOG (#101.41) file, DISPLAY TEXT (#2) field "
^DIC(9.4,35,22,3,"PAH",360,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,21,0)="* ORDER DIALOG (#101.41) file, ITEMS (#10) sub-file, DISPLAY TEXT (#4) "
^DIC(9.4,35,22,3,"PAH",360,1,22,0)="field "
^DIC(9.4,35,22,3,"PAH",360,1,23,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,24,0)="This intake has been implemented locally at the VA centers in Fargo, ND; "
^DIC(9.4,35,22,3,"PAH",360,1,25,0)="Sioux Falls, SD; Meade, MD; Minneapolis, MN; Omaha, NE; Richmond, VA; St. "
^DIC(9.4,35,22,3,"PAH",360,1,26,0)="Cloud, MN; Seattle, WA; Milwaukee, WI; Hot Springs, AR; Des Moines, IA; "
^DIC(9.4,35,22,3,"PAH",360,1,27,0)="and Iowa City, IA. "
^DIC(9.4,35,22,3,"PAH",360,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,29,0)="The NSR for this intake addresses the following requirement: "
^DIC(9.4,35,22,3,"PAH",360,1,30,0)=" "
^DIC(9.4,35,22,3,"PAH",360,1,31,0)="* VHBAO: NEED3045 Provide the ability for the users to include "
^DIC(9.4,35,22,3,"PAH",360,1,32,0)="punctuation and other special characters in CPRS order menu notes."
^DIC(9.4,35,22,3,"PAH",360,1,33,0)=" "
