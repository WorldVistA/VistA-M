^DIC(9.4,14,22,5.9,"PAH",102,1,86,0)="                 MAN-0800-10125   REN-0700-62117   FRE-0700-60219"
^DIC(9.4,14,22,5.9,"PAH",102,1,87,0)="                 IND-0600-42277   HAM-0900-22088   BHS-0900-12254"
^DIC(9.4,14,22,5.9,"PAH",102,1,88,0)="                 SAJ-1000-71270   SDC-1000-60114   LEX-1000-40050"
^DIC(9.4,14,22,5.9,"PAH",102,1,89,0)="                 FTL-1000-50009   MAD-0900-42468   PHO-0900-62454"
^DIC(9.4,14,22,5.9,"PAH",102,1,90,0)="                 MEM-0900-72282   BHS-0900-12254   HAM-0900-71979"
^DIC(9.4,14,22,5.9,"PAH",102,1,91,0)="                 SHR-0900-71979   MIN-0900-41468   WIN-0900-40871"
^DIC(9.4,14,22,5.9,"PAH",102,1,92,0)="                 LEB-0900-20354   DAY-0900-40304   NJH-0900-20290"
