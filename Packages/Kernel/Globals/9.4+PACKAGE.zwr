^DIC(9.4,77,22,17,"PAH",395,0)="447^3251119.084847^90"
^DIC(9.4,77,22,17,"PAH",395,1,0)="^^7^7^3251119"
^DIC(9.4,77,22,17,"PAH",395,1,1,0)="This patch, along with other patches, adds Pharmacogenomic (PGx) order"
^DIC(9.4,77,22,17,"PAH",395,1,2,0)="checking to medication orders entered through Inpatient Medications,"
^DIC(9.4,77,22,17,"PAH",395,1,3,0)="Outpatient Pharmacy and Computerized Patient Record System (CPRS). A "
^DIC(9.4,77,22,17,"PAH",395,1,4,0)="patient's genomic test results will be retrieved from the Health Data"
^DIC(9.4,77,22,17,"PAH",395,1,5,0)="Repository (HDR), and along with the prospective drug(s) of a medication"
^DIC(9.4,77,22,17,"PAH",395,1,6,0)="order is sent to the vendor to retrieve interactions between the patient's"
^DIC(9.4,77,22,17,"PAH",395,1,7,0)="genes and the prospective drug(s)."
