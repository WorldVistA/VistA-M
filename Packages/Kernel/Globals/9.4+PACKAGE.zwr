^DIC(9.4,140,22,20,"PAH",10,1,36,0)="RMPR*3*12"
^DIC(9.4,140,22,20,"PAH",10,1,37,0)="RMPR*3*15"
^DIC(9.4,140,22,20,"PAH",10,1,38,0)="RMPR*3*19"
^DIC(9.4,140,22,20,"PAH",10,1,39,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,40,0)="Installation Overview"
^DIC(9.4,140,22,20,"PAH",10,1,41,0)="---------------------"
^DIC(9.4,140,22,20,"PAH",10,1,42,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,43,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,44,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",10,1,45,0)="------------"
^DIC(9.4,140,22,20,"PAH",10,1,46,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",10,1,47,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,48,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,49,0)="Installation"
^DIC(9.4,140,22,20,"PAH",10,1,50,0)="------------"
^DIC(9.4,140,22,20,"PAH",10,1,51,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,52,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,140,22,20,"PAH",10,1,53,0)="option l load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",10,1,54,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,55,0)="2. The patch has now been loaded into a Transport global on your "
^DIC(9.4,140,22,20,"PAH",10,1,56,0)="system. You now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",10,1,57,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,58,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums "
^DIC(9.4,140,22,20,"PAH",10,1,59,0)="'in the Transport Global' and verify that all routines have the "
^DIC(9.4,140,22,20,"PAH",10,1,60,0)="correct checksum."
^DIC(9.4,140,22,20,"PAH",10,1,61,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,62,0)="4. On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,140,22,20,"PAH",10,1,63,0)="'Install Package(s)'. Select the package 'RMPR*3.0*20' and proceed "
^DIC(9.4,140,22,20,"PAH",10,1,64,0)="with installation."
^DIC(9.4,140,22,20,"PAH",10,1,65,0)=" "
^DIC(9.4,140,22,20,"PAH",10,1,66,0)="CHECK^XTSUMBLD results"
^DIC(9.4,140,22,20,"PAH",10,1,67,0)="----------------------"
^DIC(9.4,140,22,20,"PAH",10,1,68,0)="RMPR29P   value = 8396439"
^DIC(9.4,140,22,20,"PAH",10,1,69,0)="RMPR421   value = 4996627"
^DIC(9.4,140,22,20,"PAH",10,1,70,0)="RMPR421A  value = 13010718"
^DIC(9.4,140,22,20,"PAH",10,1,71,0)="RMPR421B  value = 5444806"
^DIC(9.4,140,22,20,"PAH",10,1,72,0)="RMPR421C  value = 6607288"
^DIC(9.4,140,22,20,"PAH",10,1,73,0)="RMPR4C1   value = 8115231"
^DIC(9.4,140,22,20,"PAH",10,1,74,0)="RMPR4C21  value = 6415903"
^DIC(9.4,140,22,20,"PAH",10,1,75,0)="RMPR4LI   value = 7506137"
^DIC(9.4,140,22,20,"PAH",10,1,76,0)="RMPR4LOP  value = 12607366"
^DIC(9.4,140,22,20,"PAH",10,1,77,0)="RMPR4OPN  value = 11453190"
^DIC(9.4,140,22,20,"PAH",10,1,78,0)="RMPR4P22  value = 11642686"
^DIC(9.4,140,22,20,"PAH",10,1,79,0)="RMPR4P24  value = 5567655"
^DIC(9.4,140,22,20,"PAH",10,1,80,0)="RMPR4UTL  value = 6093300"
^DIC(9.4,140,22,20,"PAH",10,1,81,0)="RMPRAINQ  value = 8060339"
^DIC(9.4,140,22,20,"PAH",10,1,82,0)="RMPRP55   value = 18639880"
^DIC(9.4,140,22,20,"PAH",10,1,83,0)="RMPRPAT5  value = 8036386"
^DIC(9.4,140,22,20,"PAH",10,1,84,0)="RMPRSE1   value = 15550927"
^DIC(9.4,140,22,20,"PAH",10,1,85,0)=" "
^DIC(9.4,140,22,20,"PAH",11,0)="22 SEQ #20^2970122^1"
^DIC(9.4,140,22,20,"PAH",11,1,0)="^^46^46^2970122"
^DIC(9.4,140,22,20,"PAH",11,1,1,0)="This patch will fix the problem of some vendors from "
^DIC(9.4,140,22,20,"PAH",11,1,2,0)="looping.  If a vendor does not have a contract, the prompt for "
^DIC(9.4,140,22,20,"PAH",11,1,3,0)="Contract Number will not be displayed."
^DIC(9.4,140,22,20,"PAH",11,1,4,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,5,0)="This patch also addresses the problems from the following NOIS "
^DIC(9.4,140,22,20,"PAH",11,1,6,0)="reports:"
^DIC(9.4,140,22,20,"PAH",11,1,7,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,8,0)="NOIS"
^DIC(9.4,140,22,20,"PAH",11,1,9,0)="---------------"
^DIC(9.4,140,22,20,"PAH",11,1,10,0)="CMS-0197-31032"
^DIC(9.4,140,22,20,"PAH",11,1,11,0)="BIL-0197-30995"
^DIC(9.4,140,22,20,"PAH",11,1,12,0)="CLE-0197-40968"
^DIC(9.4,140,22,20,"PAH",11,1,13,0)="BEC-0197-20893"
^DIC(9.4,140,22,20,"PAH",11,1,14,0)="ATG-0197-30576"
^DIC(9.4,140,22,20,"PAH",11,1,15,0)="MAD-0197-40460"
^DIC(9.4,140,22,20,"PAH",11,1,16,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,17,0)="Patch Dependencies"
^DIC(9.4,140,22,20,"PAH",11,1,18,0)="------------------"
^DIC(9.4,140,22,20,"PAH",11,1,19,0)="The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",11,1,20,0)="RMPR*3*20"
^DIC(9.4,140,22,20,"PAH",11,1,21,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,22,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",11,1,23,0)="------------"
^DIC(9.4,140,22,20,"PAH",11,1,24,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",11,1,25,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,26,0)="Installation"
^DIC(9.4,140,22,20,"PAH",11,1,27,0)="------------"
^DIC(9.4,140,22,20,"PAH",11,1,28,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,29,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,140,22,20,"PAH",11,1,30,0)="option l load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",11,1,31,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,32,0)="2. The patch has now been loaded into a Transport global on your "
^DIC(9.4,140,22,20,"PAH",11,1,33,0)="system. You now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",11,1,34,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,35,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums "
^DIC(9.4,140,22,20,"PAH",11,1,36,0)="'in the Transport Global' and verify that all routines have the "
^DIC(9.4,140,22,20,"PAH",11,1,37,0)="correct checksum."
^DIC(9.4,140,22,20,"PAH",11,1,38,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,39,0)="4. On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,140,22,20,"PAH",11,1,40,0)="'Install Package(s)'. Select the package 'RMPR*3.0*22' and proceed "
^DIC(9.4,140,22,20,"PAH",11,1,41,0)="with installation."
^DIC(9.4,140,22,20,"PAH",11,1,42,0)=" "
^DIC(9.4,140,22,20,"PAH",11,1,43,0)="CHECK^XTSUMBLD results"
^DIC(9.4,140,22,20,"PAH",11,1,44,0)="----------------------"
^DIC(9.4,140,22,20,"PAH",11,1,45,0)="RMPR421A  value = 13049745"
^DIC(9.4,140,22,20,"PAH",11,1,46,0)=" "
^DIC(9.4,140,22,20,"PAH",12,0)="23 SEQ #21^2970303^1"
^DIC(9.4,140,22,20,"PAH",12,1,0)="^^17^17^2970303"
^DIC(9.4,140,22,20,"PAH",12,1,1,0)=" "
^DIC(9.4,140,22,20,"PAH",12,1,2,0)=" "
^DIC(9.4,140,22,20,"PAH",12,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",12,1,4,0)="This patch is in response to NOIS MGY-0197-31093."
^DIC(9.4,140,22,20,"PAH",12,1,5,0)="It updates the address for the National Footwear Center in New YorK"
^DIC(9.4,140,22,20,"PAH",12,1,6,0)="from: 252 7th Avenue, Floor 2, New York, NY 10001 "
^DIC(9.4,140,22,20,"PAH",12,1,7,0)="to  : 210 Varick Street, Floor 10,  New York, NY 10014"
^DIC(9.4,140,22,20,"PAH",12,1,8,0)=" "
^DIC(9.4,140,22,20,"PAH",12,1,9,0)=" "
^DIC(9.4,140,22,20,"PAH",12,1,10,0)="It is also in response to NOIS TAM-0197-31968"
^DIC(9.4,140,22,20,"PAH",12,1,11,0)="The variable RMPRTRN was being killed off too soon."
^DIC(9.4,140,22,20,"PAH",12,1,12,0)="The KILL statement is moved after the I block, which may sometimes be"
^DIC(9.4,140,22,20,"PAH",12,1,13,0)="executed and does use the variable to set a data node."
^DIC(9.4,140,22,20,"PAH",12,1,14,0)=" "
^DIC(9.4,140,22,20,"PAH",12,1,15,0)="To install: Have all Prosthetic Lab users off the system.  "
^DIC(9.4,140,22,20,"PAH",12,1,16,0)="            Use Kids to Load the Patch."
^DIC(9.4,140,22,20,"PAH",12,1,17,0)="            Move the routine to all systems."
^DIC(9.4,140,22,20,"PAH",13,0)="24 SEQ #22^2970317^1"
^DIC(9.4,140,22,20,"PAH",13,1,0)="^^20^20^2970317"
^DIC(9.4,140,22,20,"PAH",13,1,1,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",13,1,2,0)="------------"
^DIC(9.4,140,22,20,"PAH",13,1,3,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",13,1,4,0)=" "
^DIC(9.4,140,22,20,"PAH",13,1,5,0)=" "
^DIC(9.4,140,22,20,"PAH",13,1,6,0)="Installation"
^DIC(9.4,140,22,20,"PAH",13,1,7,0)="------------"
^DIC(9.4,140,22,20,"PAH",13,1,8,0)=" "
^DIC(9.4,140,22,20,"PAH",13,1,9,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option"
^DIC(9.4,140,22,20,"PAH",13,1,10,0)="load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",13,1,11,0)=" "
^DIC(9.4,140,22,20,"PAH",13,1,12,0)="2. The patch has now been loaded into a Transport global on your system. You"
^DIC(9.4,140,22,20,"PAH",13,1,13,0)="now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",13,1,14,0)=" "
^DIC(9.4,140,22,20,"PAH",13,1,15,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums 'in the"
^DIC(9.4,140,22,20,"PAH",13,1,16,0)="Transport Global' and verify that all routines have the correct checksum."
^DIC(9.4,140,22,20,"PAH",13,1,17,0)=" "
^DIC(9.4,140,22,20,"PAH",13,1,18,0)="4. On the KIDS menu, under the 'Installation' menu, use the option 'Install"
^DIC(9.4,140,22,20,"PAH",13,1,19,0)="Package(s)'. Select the package 'RMPR*3.0*24' and proceed with installation."
^DIC(9.4,140,22,20,"PAH",13,1,20,0)=" "
^DIC(9.4,140,22,20,"PAH",14,0)="25 SEQ #23^2970808^1"
^DIC(9.4,140,22,20,"PAH",14,1,0)="^^40^40^2970808"
^DIC(9.4,140,22,20,"PAH",14,1,1,0)=" This patch contains corrections to the following NOISs."
^DIC(9.4,140,22,20,"PAH",14,1,2,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,3,0)=" NOIS SYR-0497-10562"
^DIC(9.4,140,22,20,"PAH",14,1,4,0)=" -------------------"
^DIC(9.4,140,22,20,"PAH",14,1,5,0)=" This patch corrects a printing problem reported in NOIS SYR-0497-10562."
^DIC(9.4,140,22,20,"PAH",14,1,6,0)=" Under certain circumstances, when the user executes the ""Display/Print"
^DIC(9.4,140,22,20,"PAH",14,1,7,0)=" Patient 2319"" option, sorted by ""Appliance Transactions"" the total cost"
^DIC(9.4,140,22,20,"PAH",14,1,8,0)=" heading displayed more than one numeric value. This patch contains"
^DIC(9.4,140,22,20,"PAH",14,1,9,0)=" modifications that will display the total cost value only once. In"
^DIC(9.4,140,22,20,"PAH",14,1,10,0)=" routine RMPRPAT3, logical conditions were inserted to print either the"
^DIC(9.4,140,22,20,"PAH",14,1,11,0)=" shipping/delivery or total labor cost if the total cost field is null."
^DIC(9.4,140,22,20,"PAH",14,1,12,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,13,0)=" NOIS LAS-0597-62425"
^DIC(9.4,140,22,20,"PAH",14,1,14,0)=" -------------------"
^DIC(9.4,140,22,20,"PAH",14,1,15,0)=" This patch corrects problems associated with NOIS LAS-0597-62425 (and"
^DIC(9.4,140,22,20,"PAH",14,1,16,0)=" others). If a user executes the menu Purchase Card Site Parameter and"
^DIC(9.4,140,22,20,"PAH",14,1,17,0)=" receives the following statement:"
^DIC(9.4,140,22,20,"PAH",14,1,18,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,19,0)="      Enter the IFCAP Site used with the Purchase Card Module"
^DIC(9.4,140,22,20,"PAH",14,1,20,0)="      The following site you select will be used on all your"
^DIC(9.4,140,22,20,"PAH",14,1,21,0)="      Purchase Card Transactions in IFCAP only."
^DIC(9.4,140,22,20,"PAH",14,1,22,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,23,0)=" YOU ARE NOT AN AUTHORIZED FISCAL USER.  CONTACT SITE MANAGER."
^DIC(9.4,140,22,20,"PAH",14,1,24,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,25,0)=" This action will cause PRC(""SITE"") to be undefined."
^DIC(9.4,140,22,20,"PAH",14,1,26,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,27,0)=" As a result, this would cause the error reported in the NOIS. However,"
^DIC(9.4,140,22,20,"PAH",14,1,28,0)=" when a valid FISCAL USER moves through the menu, the site parameter would"
^DIC(9.4,140,22,20,"PAH",14,1,29,0)=" be reset."
^DIC(9.4,140,22,20,"PAH",14,1,30,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,31,0)=" To resolve this problem, the code was changed to not allow a null value. "
^DIC(9.4,140,22,20,"PAH",14,1,32,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,33,0)=" "
^DIC(9.4,140,22,20,"PAH",14,1,34,0)=" NOIS NIN-0497-41607"
^DIC(9.4,140,22,20,"PAH",14,1,35,0)=" -------------------"
^DIC(9.4,140,22,20,"PAH",14,1,36,0)=" This patch corrects a problem with the COCP limitation reported in NOIS"
^DIC(9.4,140,22,20,"PAH",14,1,37,0)=" SYR-0497-10562. When the user executes the ""Close Out Purchase"" option"
^DIC(9.4,140,22,20,"PAH",14,1,38,0)=" and answer yes to the cost out transactions, the option responded with"
^DIC(9.4,140,22,20,"PAH",14,1,39,0)=" Dollar amount must be within contract authority guidelines.  Changes were"
^DIC(9.4,140,22,20,"PAH",14,1,40,0)=" made to remove the $25000 and $2500 limitations."
^DIC(9.4,140,22,20,"PAH",15,0)="26 SEQ #24^2971213^1"
^DIC(9.4,140,22,20,"PAH",15,1,0)="^^16^16^2971213"
^DIC(9.4,140,22,20,"PAH",15,1,1,0)=" "
^DIC(9.4,140,22,20,"PAH",15,1,2,0)="PATCH SUBJ: VISALEVEL II, RECONCILIATION"
^DIC(9.4,140,22,20,"PAH",15,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",15,1,4,0)="Patch Description:"
^DIC(9.4,140,22,20,"PAH",15,1,5,0)=" "
^DIC(9.4,140,22,20,"PAH",15,1,6,0)="IFCAP PATCH PRC*5*125 MUST BE INSTALLED BEFORE INSTALLING THIS PATCH."
^DIC(9.4,140,22,20,"PAH",15,1,7,0)=" "
^DIC(9.4,140,22,20,"PAH",15,1,8,0)="Patch RMPR*3.0*26 is an enhancement to the Close Out Purchase Card"
^DIC(9.4,140,22,20,"PAH",15,1,9,0)="Transaction [RMPR4 CLOSE OUT] option. This option is now called"
^DIC(9.4,140,22,20,"PAH",15,1,10,0)="RECONCILE/CLOSE OUT PURCHASE CARD TRANSACTION"
^DIC(9.4,140,22,20,"PAH",15,1,11,0)="and located under the PURCHASING"
^DIC(9.4,140,22,20,"PAH",15,1,12,0)="[RMPR PURCHASING MENU] option.  The Reconcile/Close Out Purchase Card"
^DIC(9.4,140,22,20,"PAH",15,1,13,0)="Transaction option allows you to perform IFCAP amendments or adjustment"
^DIC(9.4,140,22,20,"PAH",15,1,14,0)="and reconciliation during the closing of prosthetic purchase orders."
^DIC(9.4,140,22,20,"PAH",15,1,15,0)="Before this enhancement, users had to switch between both Prosthetics and"
^DIC(9.4,140,22,20,"PAH",15,1,16,0)="IFCAP packages to complete these function."
^DIC(9.4,140,22,20,"PAH",16,0)="28^2980330^1"
^DIC(9.4,140,22,20,"PAH",16,1,0)="^^7^7^2980330"
^DIC(9.4,140,22,20,"PAH",16,1,1,0)="Patch RMPR*3.0*28 will export a new global RMPR(661.1, options [RMPR"
^DIC(9.4,140,22,20,"PAH",16,1,2,0)="ADD/EDIT HCPCS, RMPR NPPD HCPCS and RMPR HCPCS HISTORY],"
^DIC(9.4,140,22,20,"PAH",16,1,3,0)="modify input template [RMPRE2319], replaces all occurences of"
^DIC(9.4,140,22,20,"PAH",16,1,4,0)="prompt 'Enter HCPCS' to 'Enter PSAS HCPCS',reverse display of records in"
^DIC(9.4,140,22,20,"PAH",16,1,5,0)="all SUSPENSE MENU options.  The patch will also"
^DIC(9.4,140,22,20,"PAH",16,1,6,0)="export a partial DD update for files 660, 664 and 664.1 and create a ""G"""
^DIC(9.4,140,22,20,"PAH",16,1,7,0)="cross referenced for file #660."
^DIC(9.4,140,22,20,"PAH",17,0)="30 SEQ #26^2980616^1"
^DIC(9.4,140,22,20,"PAH",17,1,0)="^^2^2^2980616"
^DIC(9.4,140,22,20,"PAH",17,1,1,0)="This patch will correct string error, missing fields for shipping entries"
^DIC(9.4,140,22,20,"PAH",17,1,2,0)="in file #660 and PSAS HCPCS prompt during the close-out of 1358."
^DIC(9.4,140,22,20,"PAH",18,0)="31^2980725^1"
^DIC(9.4,140,22,20,"PAH",19,0)="32 SEQ #28^2981007^1"
^DIC(9.4,140,22,20,"PAH",20,0)="33^2990316^1"
^DIC(9.4,140,22,20,"PAH",20,1,0)="^^1^1^2990316"
^DIC(9.4,140,22,20,"PAH",20,1,1,0)="This is the new Prosthetic Inventory module and a modified lab module."
