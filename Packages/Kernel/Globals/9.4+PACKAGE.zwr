^DIC(9.4,4,22,1,"PAH",67,1,54,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",67,1,55,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",67,1,56,0)=" Enter a '^' to abort the install."
