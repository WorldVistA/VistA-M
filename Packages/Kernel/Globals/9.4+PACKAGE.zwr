^DIC(9.4,33,22,1.4,"PAH",32,1,218,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,219,0)="New Options:"
^DIC(9.4,33,22,1.4,"PAH",32,1,220,0)="============================== "
^DIC(9.4,33,22,1.4,"PAH",32,1,221,0)=" 'TCP/IP Link Manager Start/Stop'  Option name: HL START/STOP LINK MANAGER"
^DIC(9.4,33,22,1.4,"PAH",32,1,222,0)=" 'Autostart Link Manager'          Option name: HL AUTOSTART LINK MANAGER"
^DIC(9.4,33,22,1.4,"PAH",32,1,223,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,224,0)="New for Systems Link Monitor:"
^DIC(9.4,33,22,1.4,"PAH",32,1,225,0)="=============================="
^DIC(9.4,33,22,1.4,"PAH",32,1,226,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,227,0)="  1.  Status of whether TaskMan is currently running."
^DIC(9.4,33,22,1.4,"PAH",32,1,228,0)="  2.  Status of whether Link Manager currently running."
^DIC(9.4,33,22,1.4,"PAH",32,1,229,0)="  3.  Additional STATES for non-persistent client links:"
^DIC(9.4,33,22,1.4,"PAH",32,1,230,0)="      o  ENABLED"
^DIC(9.4,33,22,1.4,"PAH",32,1,231,0)="      o  INACTIVE"
^DIC(9.4,33,22,1.4,"PAH",32,1,232,0)="  4.  New DEVICE TYPE column replaces DEVICE ON-LINE column."
^DIC(9.4,33,22,1.4,"PAH",32,1,233,0)="  5.  New DEVICE TYPES:"
^DIC(9.4,33,22,1.4,"PAH",32,1,234,0)="                              PC -- Persistent TCP/IP Client"
^DIC(9.4,33,22,1.4,"PAH",32,1,235,0)="                              NC -- Non-Persistent TCP/IP Client"
^DIC(9.4,33,22,1.4,"PAH",32,1,236,0)="                              SS -- Single-threaded TCP/IP Server"
^DIC(9.4,33,22,1.4,"PAH",32,1,237,0)="                              MS -- Multi-threaded TCP/IP Server"
^DIC(9.4,33,22,1.4,"PAH",32,1,238,0)="                              SH -- Serial HLLP"
^DIC(9.4,33,22,1.4,"PAH",32,1,239,0)="                              SX -- Serial X3.28"
^DIC(9.4,33,22,1.4,"PAH",32,1,240,0)="                              MM -- MailMan"
^DIC(9.4,33,22,1.4,"PAH",32,1,241,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,242,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,243,0)="Configuration considerations:"
^DIC(9.4,33,22,1.4,"PAH",32,1,244,0)="=============================="
^DIC(9.4,33,22,1.4,"PAH",32,1,245,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,246,0)=" The only configuration parameter is Retention.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,247,0)=" This may be edited per Logical Link using the Interface Workbench.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,248,0)=" Also, a Default Retention time may be edited "
^DIC(9.4,33,22,1.4,"PAH",32,1,249,0)=" using the 'Edit Communication Server parameters' option.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,250,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,251,0)=" The order of precedence for Retention is as follows: "
^DIC(9.4,33,22,1.4,"PAH",32,1,252,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,253,0)="           1.  Retention (Per Logical Link value overrides any defaults)."
^DIC(9.4,33,22,1.4,"PAH",32,1,254,0)="           2.  Default Retention (System-wide account default."
^DIC(9.4,33,22,1.4,"PAH",32,1,255,0)="                                 If valued, this field is the default"
^DIC(9.4,33,22,1.4,"PAH",32,1,256,0)="                                 per Logical Link when the Retention"
^DIC(9.4,33,22,1.4,"PAH",32,1,257,0)="                                 field is left unvalued)."
^DIC(9.4,33,22,1.4,"PAH",32,1,258,0)="           3.  15 seconds (System-wide account default.  This value"
^DIC(9.4,33,22,1.4,"PAH",32,1,259,0)="                          is used when both Retention and Default"
^DIC(9.4,33,22,1.4,"PAH",32,1,260,0)="                          Retention are left unvalued)."
^DIC(9.4,33,22,1.4,"PAH",32,1,261,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,262,0)=" You may wish to accept the system-wide default of 15 seconds for "
^DIC(9.4,33,22,1.4,"PAH",32,1,263,0)=" Retention of your non-persistent TCP/IP client Logical Links.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,264,0)=" Once you become more familiar with the frequency and load of each link, "
^DIC(9.4,33,22,1.4,"PAH",32,1,265,0)=" you may adjust these Retention values accordingly.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,266,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,267,0)="Troubleshooting information:"
^DIC(9.4,33,22,1.4,"PAH",32,1,268,0)="============================"
^DIC(9.4,33,22,1.4,"PAH",32,1,269,0)=" The HL7 Systems Link Monitor is a useful tool to help"
^DIC(9.4,33,22,1.4,"PAH",32,1,270,0)=" you troubleshoot problems with either the Link Manager"
^DIC(9.4,33,22,1.4,"PAH",32,1,271,0)=" or the individual Logical Links.  This tool will monitor"
^DIC(9.4,33,22,1.4,"PAH",32,1,272,0)=" both TaskMan and Link Manager. When either of these"
^DIC(9.4,33,22,1.4,"PAH",32,1,273,0)=" does not appear to be running, a warning will be"
^DIC(9.4,33,22,1.4,"PAH",32,1,274,0)=" displayed on the Systems Link Monitor."
^DIC(9.4,33,22,1.4,"PAH",32,1,275,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,276,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,277,0)=" ALERT NOTIFICATION"
^DIC(9.4,33,22,1.4,"PAH",32,1,278,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,279,0)=" It highly recommended that sites establish a mail group"
^DIC(9.4,33,22,1.4,"PAH",32,1,280,0)=" for HL7 related alerts.  Once this has been establish,"
^DIC(9.4,33,22,1.4,"PAH",32,1,281,0)=" use the 'Edit Communication Server parameters' option"
^DIC(9.4,33,22,1.4,"PAH",32,1,282,0)=" to identify the Mail Group for Alerts."
^DIC(9.4,33,22,1.4,"PAH",32,1,283,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,284,0)=" If a mail group has been created and identified, the Link Manager"
^DIC(9.4,33,22,1.4,"PAH",32,1,285,0)=" will use this mail group to send the following alert whenever"
^DIC(9.4,33,22,1.4,"PAH",32,1,286,0)=" it finds a configuration problem between the links and TaskMan:"
^DIC(9.4,33,22,1.4,"PAH",32,1,287,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,288,0)=" HL7 Logical Link LLname shutdown due to TaskMan unable to process task request"
^DIC(9.4,33,22,1.4,"PAH",32,1,289,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,290,0)=" The most likely cause for receiving such an alert is having TaskMan running"
^DIC(9.4,33,22,1.4,"PAH",32,1,291,0)=" in non-DCL context and having a Logical Link with an associated"
^DIC(9.4,33,22,1.4,"PAH",32,1,292,0)=" STARTUP NODE other than where TaskMan is currently running.  This applies"
^DIC(9.4,33,22,1.4,"PAH",32,1,293,0)=" to both the AXP and AVANTI sites."
^DIC(9.4,33,22,1.4,"PAH",32,1,294,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,295,0)=" After receiving this alert, make the needed corrections and restart"
^DIC(9.4,33,22,1.4,"PAH",32,1,296,0)=" the Logical Link if necessary."
^DIC(9.4,33,22,1.4,"PAH",33,0)="39 SEQ #46^2991019^1"
^DIC(9.4,33,22,1.4,"PAH",33,1,0)="^^1^1^2991019"
^DIC(9.4,33,22,1.4,"PAH",33,1,1,0)="Distribute VA TCP Logical Link definitions. "
^DIC(9.4,33,22,1.4,"PAH",34,0)="54 SEQ #47^3000204^1"
^DIC(9.4,33,22,1.4,"PAH",34,1,0)="^^58^58^3000204"
^DIC(9.4,33,22,1.4,"PAH",34,1,1,0)="This patch does the following works to comply with the HL7 standard:"
^DIC(9.4,33,22,1.4,"PAH",34,1,2,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,3,0)="  1. Modifies some entries in file #779.001 (HL7 Event Type Code file) and"
^DIC(9.4,33,22,1.4,"PAH",34,1,4,0)="     #771.2 (HL7 Message Type file)."
^DIC(9.4,33,22,1.4,"PAH",34,1,5,0)="  2. Finds duplicate entries in file #779.001 and #771.2."
^DIC(9.4,33,22,1.4,"PAH",34,1,6,0)="  3. Resolves duplicate entries pointers for the following fields:"
^DIC(9.4,33,22,1.4,"PAH",34,1,7,0)="     - #101,770.4 (event type)."
^DIC(9.4,33,22,1.4,"PAH",34,1,8,0)="     - #101,770.3 (message type)."
^DIC(9.4,33,22,1.4,"PAH",34,1,9,0)="     - #101,770.11 (message type)."
^DIC(9.4,33,22,1.4,"PAH",34,1,10,0)="     - #773,16 (event type)."
^DIC(9.4,33,22,1.4,"PAH",34,1,11,0)="     - #773,15 (message type)."
^DIC(9.4,33,22,1.4,"PAH",34,1,12,0)="     - Sub-field: #771.06,.01 (message type) of field #771,6."
^DIC(9.4,33,22,1.4,"PAH",34,1,13,0)="  4. Deletes duplicate entries in file #779.001 and #771.2."
^DIC(9.4,33,22,1.4,"PAH",34,1,14,0)="  5. Bring new data of version, event types, and message types into files,"
^DIC(9.4,33,22,1.4,"PAH",34,1,15,0)="     #771.5 (HL7 Version file), #779.001 and #771.2, to comply with HL7"
^DIC(9.4,33,22,1.4,"PAH",34,1,16,0)="     2.3 and 2.3.1 Standard."
^DIC(9.4,33,22,1.4,"PAH",34,1,17,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,18,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,19,0)="Routine Summary:"
^DIC(9.4,33,22,1.4,"PAH",34,1,20,0)="================"
^DIC(9.4,33,22,1.4,"PAH",34,1,21,0)="The following is a list of the routines included in this patch.  The"
^DIC(9.4,33,22,1.4,"PAH",34,1,22,0)="second line of each of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",34,1,23,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,24,0)="     <tab>;;1.6;HEALTH LEVEL SEVEN;**[patch list]**;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",34,1,25,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,27,0)="Checksums:"
^DIC(9.4,33,22,1.4,"PAH",34,1,28,0)="=========="
^DIC(9.4,33,22,1.4,"PAH",34,1,29,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,30,0)="  Routine Name    Checksum Before    Checksum After       Patch List"
^DIC(9.4,33,22,1.4,"PAH",34,1,31,0)="  ------------    ---------------    --------------       ----------"
^DIC(9.4,33,22,1.4,"PAH",34,1,32,0)="    HLPAT54            new              7691750               54"
^DIC(9.4,33,22,1.4,"PAH",34,1,33,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,34,0)="    From CHECK^XTSUMBLD "
^DIC(9.4,33,22,1.4,"PAH",34,1,35,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,36,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,37,0)="Installation Instructions:"
^DIC(9.4,33,22,1.4,"PAH",34,1,38,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",34,1,39,0)="  1.  Users are allowed to be on the system during the installation."
^DIC(9.4,33,22,1.4,"PAH",34,1,40,0)="  2.  Stop all the Logical links, incoming and outgoing filers."
^DIC(9.4,33,22,1.4,"PAH",34,1,41,0)="  3.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,33,22,1.4,"PAH",34,1,42,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",34,1,43,0)="  4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,33,22,1.4,"PAH",34,1,44,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,33,22,1.4,"PAH",34,1,45,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,33,22,1.4,"PAH",34,1,46,0)="      options:"
^DIC(9.4,33,22,1.4,"PAH",34,1,47,0)=" "
^DIC(9.4,33,22,1.4,"PAH",34,1,48,0)="         Verify Checksums in Transport Global"
^DIC(9.4,33,22,1.4,"PAH",34,1,49,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",34,1,50,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",34,1,51,0)="         Backup a Transport Global"
^DIC(9.4,33,22,1.4,"PAH",34,1,52,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",34,1,53,0)="         INSTALL NAME: HL*1.6*54"
^DIC(9.4,33,22,1.4,"PAH",34,1,54,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",34,1,55,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,33,22,1.4,"PAH",34,1,56,0)="         and Protocols?'."
^DIC(9.4,33,22,1.4,"PAH",34,1,57,0)="  5.  Restart all the Logical links, incoming and outgoing filers, which"
^DIC(9.4,33,22,1.4,"PAH",34,1,58,0)="      have been stopped in step #3."
^DIC(9.4,33,22,1.4,"PAH",35,0)="57 SEQ #48^3000229^1"
^DIC(9.4,33,22,1.4,"PAH",35,1,0)="^^594^594^3000229"
^DIC(9.4,33,22,1.4,"PAH",35,1,1,0)=" VISTA HL7 patch HL*1.6*57 addresses most of the outstanding HL7 1.6"
^DIC(9.4,33,22,1.4,"PAH",35,1,2,0)="deficiencies cited by the HL7 Joint Application Development (JAD) Focus"
^DIC(9.4,33,22,1.4,"PAH",35,1,3,0)="Group and Part 2 of the OpenVISTA Tactical Plan."
^DIC(9.4,33,22,1.4,"PAH",35,1,4,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,5,0)="1.     Exportable Interface Definitions. Class I Interface definitions are"
^DIC(9.4,33,22,1.4,"PAH",35,1,6,0)="now exportable to all VISTA systems with little or no modification at the"
^DIC(9.4,33,22,1.4,"PAH",35,1,7,0)="site. "
^DIC(9.4,33,22,1.4,"PAH",35,1,8,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,9,0)="2.     Reduction in Interface Development, Testing and Activation Time."
^DIC(9.4,33,22,1.4,"PAH",35,1,10,0)="Interfaces are now more intuitive, consistent and simpler regardless of"
^DIC(9.4,33,22,1.4,"PAH",35,1,11,0)="the role of the VISTA system as sender or receiver or the mode of"
^DIC(9.4,33,22,1.4,"PAH",35,1,12,0)="communication (Mailman, TCP, serial, local app-to-app). The number of"
^DIC(9.4,33,22,1.4,"PAH",35,1,13,0)="protocol definitions that are required to support a simple interface has"
^DIC(9.4,33,22,1.4,"PAH",35,1,14,0)="been reduced in most cases to just two."
^DIC(9.4,33,22,1.4,"PAH",35,1,15,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,16,0)="3.     Redesigned Menu. The HL7 MAIN MENU option has been completely"
^DIC(9.4,33,22,1.4,"PAH",35,1,17,0)="reorganized to reflect user preferences both from the field and the JAD"
^DIC(9.4,33,22,1.4,"PAH",35,1,18,0)="Focus Group."
^DIC(9.4,33,22,1.4,"PAH",35,1,19,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,20,0)="4.     Event types for version 2.1 messages are no longer required. HL7"
^DIC(9.4,33,22,1.4,"PAH",35,1,21,0)="1.6 is now backward compatible to HL7 Standard, version 2.1 transactions."
^DIC(9.4,33,22,1.4,"PAH",35,1,22,0)="VISTA HL7 version 1.5 interfaces should be upgraded to 1.6 as soon as"
^DIC(9.4,33,22,1.4,"PAH",35,1,23,0)="possible. Version 1.5 fields have been marked for removal from the system."
^DIC(9.4,33,22,1.4,"PAH",35,1,24,0)="Once this occurs, version 1.5 interfaces will no longer function. There"
^DIC(9.4,33,22,1.4,"PAH",35,1,25,0)="should be no new development using the 1.5 interface method."
^DIC(9.4,33,22,1.4,"PAH",35,1,26,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,27,0)="5.     Merger of Split Logical Link and Lower Level Protocol Parameter"
^DIC(9.4,33,22,1.4,"PAH",35,1,28,0)="Files. File 870 (Logical Link) and file 869.2 (HL LOWER LEVEL PROTOCOL"
^DIC(9.4,33,22,1.4,"PAH",35,1,29,0)="PARAMETER) have been merged into a single file."
^DIC(9.4,33,22,1.4,"PAH",35,1,30,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,31,0)="6.     Response message type and event type can now be different from the"
^DIC(9.4,33,22,1.4,"PAH",35,1,32,0)="initial message's message type/event type pair. The Transaction Message"
^DIC(9.4,33,22,1.4,"PAH",35,1,33,0)="type and Event type are no longer defined on the subscriber protocol for a"
^DIC(9.4,33,22,1.4,"PAH",35,1,34,0)="message to be successfully delivered. This information is now derived from"
^DIC(9.4,33,22,1.4,"PAH",35,1,35,0)="the Event Point Protocol only. The Response Message Type and Event Type"
^DIC(9.4,33,22,1.4,"PAH",35,1,36,0)="fields are now used for defining the message type and event type of the"
^DIC(9.4,33,22,1.4,"PAH",35,1,37,0)="subscriber response. "
^DIC(9.4,33,22,1.4,"PAH",35,1,38,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,39,0)="7.     ""Report"" Option Fixed. The HL7 option, ""Report"" has been fixed to"
^DIC(9.4,33,22,1.4,"PAH",35,1,40,0)="properly display non-TCP status codes and errors. The option has been"
^DIC(9.4,33,22,1.4,"PAH",35,1,41,0)="renamed to, ""Link Error/Status Report (non-TCP)."""
^DIC(9.4,33,22,1.4,"PAH",35,1,42,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,43,0)="8.     Same-System Batch Messages. It has not been possible to exchange"
^DIC(9.4,33,22,1.4,"PAH",35,1,44,0)="batch messages between applications running on the same system. This has"
^DIC(9.4,33,22,1.4,"PAH",35,1,45,0)="been corrected."
^DIC(9.4,33,22,1.4,"PAH",35,1,46,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,47,0)="9.     Message Header Enhancements to Improve Security. Message headers"
^DIC(9.4,33,22,1.4,"PAH",35,1,48,0)="have been enhanced to improve security. It is now possible to identify the"
^DIC(9.4,33,22,1.4,"PAH",35,1,49,0)="source of a message and route (deferred) acknowledgements based entirely"
^DIC(9.4,33,22,1.4,"PAH",35,1,50,0)="on header information. When enabled, the facility id field contains the"
^DIC(9.4,33,22,1.4,"PAH",35,1,51,0)="source domain and destination domain as well as the Institution Number."
^DIC(9.4,33,22,1.4,"PAH",35,1,52,0)="Facility ID follows the HL7 Version 2.3 format, INSTITUTION"
^DIC(9.4,33,22,1.4,"PAH",35,1,53,0)="NUMBER_cs_DOMAIN_NAME_cs_""DNS."" For improved security, it is now possible"
^DIC(9.4,33,22,1.4,"PAH",35,1,54,0)="to validate a source domain against entries in the logical link file. When"
^DIC(9.4,33,22,1.4,"PAH",35,1,55,0)="valid domain information is present in the message header, the HL7 package"
^DIC(9.4,33,22,1.4,"PAH",35,1,56,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,57,0)="(1) attempts to resolve the domain to the corresponding logical link and"
^DIC(9.4,33,22,1.4,"PAH",35,1,58,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,59,0)="(2) uses this information as the return path for responses in place of"
^DIC(9.4,33,22,1.4,"PAH",35,1,60,0)="what may be defined in the Protocol file, Logical Link field."
^DIC(9.4,33,22,1.4,"PAH",35,1,61,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,62,0)="10.    Message Header Enhancements Facilitate Message Broker Integration."
^DIC(9.4,33,22,1.4,"PAH",35,1,63,0)="Enhancements to message header also facilitate the integration of Message"
^DIC(9.4,33,22,1.4,"PAH",35,1,64,0)="Brokers into our Enterprise Application Integration strategy. In a future"
^DIC(9.4,33,22,1.4,"PAH",35,1,65,0)="enhancement, it will be possible to query a DNS for current IP"
^DIC(9.4,33,22,1.4,"PAH",35,1,66,0)="information. Note that any data that currently exists in the HL7"
^DIC(9.4,33,22,1.4,"PAH",35,1,67,0)="Application Parameter file (771), Facility ID field, overrides this"
^DIC(9.4,33,22,1.4,"PAH",35,1,68,0)="enhancement. Data for the 'default' Sending Facility ID (if required and"
^DIC(9.4,33,22,1.4,"PAH",35,1,69,0)="no Application Parameter is defined) is derived from the HL7 Communication"
^DIC(9.4,33,22,1.4,"PAH",35,1,70,0)="Server Parameter file and edited using the option, Edit Site Parameters."
^DIC(9.4,33,22,1.4,"PAH",35,1,71,0)="Data for the Receiving Facility ID field is derived from the HL7 Logical"
^DIC(9.4,33,22,1.4,"PAH",35,1,72,0)="Link File (870)."
^DIC(9.4,33,22,1.4,"PAH",35,1,73,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,74,0)="11.    Processing ID Field Checking. Another improved security feature"
^DIC(9.4,33,22,1.4,"PAH",35,1,75,0)="includes a check of the processing id field against the protocol"
^DIC(9.4,33,22,1.4,"PAH",35,1,76,0)="definition or the site parameter file. On the receiving system, a mismatch"
^DIC(9.4,33,22,1.4,"PAH",35,1,77,0)="between the message and the local definition results in an error. This can"
^DIC(9.4,33,22,1.4,"PAH",35,1,78,0)="prevent test or debug messages from being processed in production"
^DIC(9.4,33,22,1.4,"PAH",35,1,79,0)="accounts, and vice versa. "
^DIC(9.4,33,22,1.4,"PAH",35,1,80,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,81,0)="12.    Startup and Shutdown Enhancements. A new option has been created,"
^DIC(9.4,33,22,1.4,"PAH",35,1,82,0)="""Stop All Logical Links And Filers"". The ""Restart All Links And Filers"""
^DIC(9.4,33,22,1.4,"PAH",35,1,83,0)="option has also been fixed; it was shutting down all links, and then"
^DIC(9.4,33,22,1.4,"PAH",35,1,84,0)="restarting only those links with AUTOSTART ENABLED. Now only AUTOSTART"
^DIC(9.4,33,22,1.4,"PAH",35,1,85,0)="links are shut down and restarted."
^DIC(9.4,33,22,1.4,"PAH",35,1,86,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,87,0)="13.    Interface Workbench Replacement. The former HL7 option, ""Interface"
^DIC(9.4,33,22,1.4,"PAH",35,1,88,0)="Workbench,"" has been replaced. Due to the HL7 package's underlying"
^DIC(9.4,33,22,1.4,"PAH",35,1,89,0)="architecture, it is relatively unintuitive to use and has been a problem"
^DIC(9.4,33,22,1.4,"PAH",35,1,90,0)="to maintain. The new user interface also eliminates 21 routines and 62"
^DIC(9.4,33,22,1.4,"PAH",35,1,91,0)="protocols."
^DIC(9.4,33,22,1.4,"PAH",35,1,92,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,93,0)="14.    Message Synchronization Over TCP. When a connection is broken it is"
^DIC(9.4,33,22,1.4,"PAH",35,1,94,0)="possible for subsequent transactions to get out of synch. A fix is"
^DIC(9.4,33,22,1.4,"PAH",35,1,95,0)="provided to assist with re-synchronizing the two systems. The following"
^DIC(9.4,33,22,1.4,"PAH",35,1,96,0)="changes were added:"
^DIC(9.4,33,22,1.4,"PAH",35,1,97,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,98,0)="(1) A new field has been added to the HL LOGICAL LINK file, #870.  When a TCP"
^DIC(9.4,33,22,1.4,"PAH",35,1,99,0)=" client exceeds the parameter value for the maximum number of"
^DIC(9.4,33,22,1.4,"PAH",35,1,100,0)=" re-transmissions, the action below will be performed."
^DIC(9.4,33,22,1.4,"PAH",35,1,101,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,102,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,103,0)=" 200.21 EXCEED RE-TRANSMIT ACTION 200;10 SET"
^DIC(9.4,33,22,1.4,"PAH",35,1,104,0)="   'I' FOR ignore; "
^DIC(9.4,33,22,1.4,"PAH",35,1,105,0)="   'R' FOR restart; "
^DIC(9.4,33,22,1.4,"PAH",35,1,106,0)="   'S' FOR shutdown;"
^DIC(9.4,33,22,1.4,"PAH",35,1,107,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,108,0)="  DESCRIPTION:      This field determines what to do when a message exceeds"
^DIC(9.4,33,22,1.4,"PAH",35,1,109,0)=" the number of retry attempts for this Logical Link."
^DIC(9.4,33,22,1.4,"PAH",35,1,110,0)=" Actions are: Ignore  = send alert once and keep trying to resend"
^DIC(9.4,33,22,1.4,"PAH",35,1,111,0)="              Restart = send alert once and shutdown link then start link"
^DIC(9.4,33,22,1.4,"PAH",35,1,112,0)="             Shutdown = send alert once and shutdown link"
^DIC(9.4,33,22,1.4,"PAH",35,1,113,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,114,0)="(2)     There is a new entry in HL7 ERROR MESSAGE file, #771.7."
^DIC(9.4,33,22,1.4,"PAH",35,1,115,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,116,0)="  CODE: 109                               SHORT TEXT: Duplicate Message"
^DIC(9.4,33,22,1.4,"PAH",35,1,117,0)=" DESCRIPTION:   Message has already been received and processed.  This is"
^DIC(9.4,33,22,1.4,"PAH",35,1,118,0)="                a duplicate. "
^DIC(9.4,33,22,1.4,"PAH",35,1,119,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,120,0)=" The following NOIS's are addressed by this patch:"
^DIC(9.4,33,22,1.4,"PAH",35,1,121,0)="       ISF-0499-61219"
^DIC(9.4,33,22,1.4,"PAH",35,1,122,0)="       ISF-0499-61021"
^DIC(9.4,33,22,1.4,"PAH",35,1,123,0)="       BRX-0499-11335"
^DIC(9.4,33,22,1.4,"PAH",35,1,124,0)="       MIA-0499-31927"
^DIC(9.4,33,22,1.4,"PAH",35,1,125,0)="       SAG-0599-42045"
^DIC(9.4,33,22,1.4,"PAH",35,1,126,0)="       ISH-0696-40781"
^DIC(9.4,33,22,1.4,"PAH",35,1,127,0)="       BAY-1099-32639"
^DIC(9.4,33,22,1.4,"PAH",35,1,128,0)="       SLC-1099-51078"
^DIC(9.4,33,22,1.4,"PAH",35,1,129,0)="       BAY-0499-31357"
^DIC(9.4,33,22,1.4,"PAH",35,1,130,0)="       SDC-1099-62397"
^DIC(9.4,33,22,1.4,"PAH",35,1,131,0)="       ISB-1099-31173"
^DIC(9.4,33,22,1.4,"PAH",35,1,132,0)="       BAC-0699-40281"
^DIC(9.4,33,22,1.4,"PAH",35,1,133,0)="       BIG-0999-72027"
^DIC(9.4,33,22,1.4,"PAH",35,1,134,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,135,0)="15. The DATE/TIME field of the HL7 Message Header has been enhanced to"
^DIC(9.4,33,22,1.4,"PAH",35,1,136,0)="include the timezone offset."
^DIC(9.4,33,22,1.4,"PAH",35,1,137,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,138,0)="16. New public functions:"
^DIC(9.4,33,22,1.4,"PAH",35,1,139,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,140,0)="      MSGSTAT^HLUTIL(X)      ;message status"
^DIC(9.4,33,22,1.4,"PAH",35,1,141,0)="        input value:   X = message id"
^DIC(9.4,33,22,1.4,"PAH",35,1,142,0)="        return value: status^status updated^error msg.^error type pointer^"
^DIC(9.4,33,22,1.4,"PAH",35,1,143,0)="              status:"
^DIC(9.4,33,22,1.4,"PAH",35,1,144,0)="                       0 = message doesn't exist"
^DIC(9.4,33,22,1.4,"PAH",35,1,145,0)="                       1 = pending transmission"
^DIC(9.4,33,22,1.4,"PAH",35,1,146,0)="                     1.5 = being transmitted"
^DIC(9.4,33,22,1.4,"PAH",35,1,147,0)="                       2 = awaiting application acknowledgement"
^DIC(9.4,33,22,1.4,"PAH",35,1,148,0)="                       3 = successfully completed"
^DIC(9.4,33,22,1.4,"PAH",35,1,149,0)="                       4 = error"
^DIC(9.4,33,22,1.4,"PAH",35,1,150,0)="                       8 = being generated"
^DIC(9.4,33,22,1.4,"PAH",35,1,151,0)="                       9 = awaiting processing"
^DIC(9.4,33,22,1.4,"PAH",35,1,152,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,153,0)="      MSGACT^HLUTIL(X,HLIENACT)      ;outgoing message action"
^DIC(9.4,33,22,1.4,"PAH",35,1,154,0)="        input value:   X = message id"
^DIC(9.4,33,22,1.4,"PAH",35,1,155,0)="                       HLIENACT = 1-cancel; 2-requeue"
^DIC(9.4,33,22,1.4,"PAH",35,1,156,0)="        return value:  1 = action sucessfull"
^DIC(9.4,33,22,1.4,"PAH",35,1,157,0)="                       0 = action failed"
^DIC(9.4,33,22,1.4,"PAH",35,1,158,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,159,0)="      CHKLL^HLUTIL(X)        ;check setup of Logical Link"
^DIC(9.4,33,22,1.4,"PAH",35,1,160,0)="        input value:   X = institution name or number"
^DIC(9.4,33,22,1.4,"PAH",35,1,161,0)="        return value:  1 = setup OK"
^DIC(9.4,33,22,1.4,"PAH",35,1,162,0)="                       0 = LL setup incorrect"
^DIC(9.4,33,22,1.4,"PAH",35,1,163,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,164,0)="17. New Option: ""Validate Interfaces"""
^DIC(9.4,33,22,1.4,"PAH",35,1,165,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,166,0)="Use this option to check your interface setups for potential problems."
^DIC(9.4,33,22,1.4,"PAH",35,1,167,0)="Starting with an Event Driver Protocol, the event driver, subscriber(s)"
^DIC(9.4,33,22,1.4,"PAH",35,1,168,0)="and application definitions will be scanned and a report generated."
^DIC(9.4,33,22,1.4,"PAH",35,1,169,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,170,0)="After patch 57 is installed, your pre-57 interfaces will continue to work."
^DIC(9.4,33,22,1.4,"PAH",35,1,171,0)="However, you may be interested in upgrading your existing interfaces to"
^DIC(9.4,33,22,1.4,"PAH",35,1,172,0)="the post-57 style to take advantage of the new features. If you run this"
^DIC(9.4,33,22,1.4,"PAH",35,1,173,0)="option on a pre-57 setup, you can use the report as a guide for making"
^DIC(9.4,33,22,1.4,"PAH",35,1,174,0)="modifications. If your post-57 setup results in fewer protocols, be sure"
^DIC(9.4,33,22,1.4,"PAH",35,1,175,0)="to remove the unneeded protocols. Remember-if the report on a pre-57"
^DIC(9.4,33,22,1.4,"PAH",35,1,176,0)="interface reports errors, it does NOT mean the interface has been broken"
^DIC(9.4,33,22,1.4,"PAH",35,1,177,0)="or will stop working because of patch 57. Use the report as a guide only"
^DIC(9.4,33,22,1.4,"PAH",35,1,178,0)="for upgrading or for troubleshooting an existing POST-57 interface."
^DIC(9.4,33,22,1.4,"PAH",35,1,179,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,180,0)="No conversion of existing interfaces that have been properly defined will"
^DIC(9.4,33,22,1.4,"PAH",35,1,181,0)="be necessary."
^DIC(9.4,33,22,1.4,"PAH",35,1,182,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,183,0)="Additional details regarding changes to the Application Parameter File,"
^DIC(9.4,33,22,1.4,"PAH",35,1,184,0)="Event Point Protocols, Subscriber Protocols and key related fields are"
^DIC(9.4,33,22,1.4,"PAH",35,1,185,0)="defined below. "
^DIC(9.4,33,22,1.4,"PAH",35,1,186,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,187,0)=" The following routines are included in this patch.  The second line of each"
^DIC(9.4,33,22,1.4,"PAH",35,1,188,0)=" of these routines now looks like:"
^DIC(9.4,33,22,1.4,"PAH",35,1,189,0)="  ;;1.6;HEALTH LEVEL SEVEN;<patchlist>;Oct 13, 1995"
^DIC(9.4,33,22,1.4,"PAH",35,1,190,0)=" "
^DIC(9.4,33,22,1.4,"PAH",35,1,191,0)=" CHECK^XTSUMBLD results: "
^DIC(9.4,33,22,1.4,"PAH",35,1,192,0)="   "
^DIC(9.4,33,22,1.4,"PAH",35,1,193,0)=" Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,33,22,1.4,"PAH",35,1,194,0)=" ============   ============    ===========     =========="
^DIC(9.4,33,22,1.4,"PAH",35,1,195,0)=" HLCS             5743323         5745388       2,9,14,19,43,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,196,0)=" HLCS2            8763479        10072062       14,40,43,49,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,197,0)=" HLCSAS1          1742491         1743950       43,57"
