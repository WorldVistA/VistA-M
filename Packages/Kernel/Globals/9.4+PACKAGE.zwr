^DIC(9.4,161,22,1,"PAH",12,1,19,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",12,1,20,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,21,0)="ICPTZ2"
^DIC(9.4,161,22,1,"PAH",12,1,22,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",12,1,23,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,24,0)="ICPTZUP"
^DIC(9.4,161,22,1,"PAH",12,1,25,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",12,1,26,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,27,0)="ICPTZSRT"
^DIC(9.4,161,22,1,"PAH",12,1,28,0)="include CPT code in the list for Austin"
^DIC(9.4,161,22,1,"PAH",12,1,29,0)="if only the short description is changed"
