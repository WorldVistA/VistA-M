^DIC(9.4,48,22,5.28,"PAH",491,1,29,0)="PRECEPTOR ASSIGNMENT HISTORY FILE (#404.53)"
^DIC(9.4,48,22,5.28,"PAH",491,1,30,0)=".01    TEAM POSITION"
^DIC(9.4,48,22,5.28,"PAH",491,1,31,0)="  Xref-AEVENT1"
