^DIC(9.4,48,22,5.28,"PAH",579,1,276,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,277,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",579,1,278,0)="Updated the GUI to use SDEC GET PAT CONSULT BY IEN RPC when selecting an "
^DIC(9.4,48,22,5.28,"PAH",579,1,279,0)="appointment from the pending appointments list. "
^DIC(9.4,48,22,5.28,"PAH",579,1,280,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,281,0)="21) Jira #VSE-719 - Update GUI to use new SDEC GET PAT CONSULT RPC"
^DIC(9.4,48,22,5.28,"PAH",579,1,282,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,283,0)="Problem:"
