^DIC(9.4,3,22,21,"PAH",59,1,81,0)="XQT2                12236113  (no patches)  12277933  **46**"
^DIC(9.4,3,22,21,"PAH",59,1,82,0)="XQT3                12852830  (no patches)  12864808  **46**"
^DIC(9.4,3,22,21,"PAH",59,1,83,0)="XQT4                15421169  (no patches)  15441632  **46**"
^DIC(9.4,3,22,21,"PAH",59,1,84,0)="XQOPED                     New               1020766  **46**"
