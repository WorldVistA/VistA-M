^DIC(9.4,14,22,5.9,"PAH",100,1,105,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",100,1,106,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",100,1,107,0)="  "
^DIC(9.4,14,22,5.9,"PAH",100,1,108,0)=" "
^DIC(9.4,14,22,5.9,"PAH",100,1,109,0)="   NOTE: This KIDS install does not place any options out of service"
^DIC(9.4,14,22,5.9,"PAH",100,1,110,0)="         during the install and no user options are affected."
^DIC(9.4,14,22,5.9,"PAH",100,1,111,0)="         If KIDS prompts:"
^DIC(9.4,14,22,5.9,"PAH",100,1,112,0)="   "
