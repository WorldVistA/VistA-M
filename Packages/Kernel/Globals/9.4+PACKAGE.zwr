^DIC(9.4,4,22,1,"PAH",174,1,65,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,66,0)=" DEVICE: HOME// <You may queue it, if you wish>"
^DIC(9.4,4,22,1,"PAH",174,1,67,0)="                -------------------------------"
