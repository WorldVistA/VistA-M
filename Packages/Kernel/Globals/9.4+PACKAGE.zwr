^DIC(9.4,4,22,1,"PAH",131,1,43,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",131,1,44,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",131,1,45,0)=" Select INSTALL NAME:    XM*7.1*164    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",131,1,46,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",131,1,47,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",131,1,48,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",131,1,49,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",131,1,50,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",131,1,51,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",131,1,52,0)=" Enter the Device you want to print the Install messages."
