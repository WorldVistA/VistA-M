^DIC(9.4,5,22,13,"PAH",29,1,0)="^^62^62^3000816"
^DIC(9.4,5,22,13,"PAH",29,1,1,0)="ISD-0200-72703  XINDX51 If run against a build that deleted PRE/POST INIT"
