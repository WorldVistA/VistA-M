^DIC(9.4,35,22,3,"PAH",405,1,156,0)="Documentation Retrieval Instructions"
^DIC(9.4,35,22,3,"PAH",405,1,157,0)="------------------------------------"
^DIC(9.4,35,22,3,"PAH",405,1,158,0)="Updated documentation describing the new functionality introduced by this "
^DIC(9.4,35,22,3,"PAH",405,1,159,0)="patch is available."
^DIC(9.4,35,22,3,"PAH",405,1,160,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,161,0)="The preferred method is to retrieve files from download.vista.domain.ext. "
^DIC(9.4,35,22,3,"PAH",405,1,162,0)="This transmits the files from the first available server. Sites may also "
^DIC(9.4,35,22,3,"PAH",405,1,163,0)="select to retrieve files directly from a specific server."
^DIC(9.4,35,22,3,"PAH",405,1,164,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,165,0)="Sites may retrieve the documentation directly using Secure File Transfer "
^DIC(9.4,35,22,3,"PAH",405,1,166,0)="Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory at the following OI "
^DIC(9.4,35,22,3,"PAH",405,1,167,0)="Field Offices:"
^DIC(9.4,35,22,3,"PAH",405,1,168,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,169,0)="   Hines:                        fo-hines.domain.ext   "
^DIC(9.4,35,22,3,"PAH",405,1,170,0)="   Salt Lake City:               fo-slc.domain.ext"
^DIC(9.4,35,22,3,"PAH",405,1,171,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,172,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,35,22,3,"PAH",405,1,173,0)="at: "
^DIC(9.4,35,22,3,"PAH",405,1,174,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,175,0)="http://www.domain.ext/vdl/"
^DIC(9.4,35,22,3,"PAH",405,1,176,0)=" "
^DIC(9.4,35,22,3,"PAH",405,1,177,0)="Title                         File Name                       FTP Mode"
