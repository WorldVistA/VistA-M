^DIC(9.4,111,22,1,"PAH",70,1,1,0)="Visit File Creation"
^DIC(9.4,111,22,1,"PAH",71,0)="67 SEQ #72^3000516^1"
^DIC(9.4,111,22,1,"PAH",71,1,0)="^^1^1^3000516"
^DIC(9.4,111,22,1,"PAH",71,1,1,0)="PCE Encounter Lock"
^DIC(9.4,111,22,1,"PAH",72,0)="75^3000612^1"
^DIC(9.4,111,22,1,"PAH",72,1,0)="^^1^1^3000612"
^DIC(9.4,111,22,1,"PAH",72,1,1,0)="Suppress GAF score for collateral patients"
^DIC(9.4,111,22,1,"PAH",73,0)="89 SEQ #74^3000816^1"
^DIC(9.4,111,22,1,"PAH",74,0)="94 SEQ #75^3000816^1"
^DIC(9.4,111,22,1,"PAH",74,1,0)="^^4^4^3000816"
^DIC(9.4,111,22,1,"PAH",74,1,1,0)="REPORT BY DIAGNOSIS"
^DIC(9.4,111,22,1,"PAH",74,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",74,1,3,0)="A description for this build can be found on the National Patch Module"
^DIC(9.4,111,22,1,"PAH",74,1,4,0)="under Patch PX*1*94."
^DIC(9.4,111,22,1,"PAH",75,0)="91 SEQ #76^3000824^1"
^DIC(9.4,111,22,1,"PAH",75,1,0)="^^1^1^3000824"
^DIC(9.4,111,22,1,"PAH",75,1,1,0)="This is a one-time PATIENT/IHS file clean up. "
^DIC(9.4,111,22,1,"PAH",76,0)="69 SEQ #77^3000824^1"
^DIC(9.4,111,22,1,"PAH",76,1,0)="^^4^4^3000824"
^DIC(9.4,111,22,1,"PAH",76,1,1,0)="DATA2PCE API Errors."
^DIC(9.4,111,22,1,"PAH",76,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",76,1,3,0)="A description for this build can be found on the National Patch Module"
^DIC(9.4,111,22,1,"PAH",76,1,4,0)="under Patch PX*1*69."
^DIC(9.4,111,22,1,"PAH",77,0)="95 SEQ #78^3001004^1"
^DIC(9.4,111,22,1,"PAH",78,0)="43 SEQ #79^3001027^1"
^DIC(9.4,111,22,1,"PAH",79,0)="100 SEQ #80^3001027^1"
^DIC(9.4,111,22,1,"PAH",79,1,0)="^^4^4^3001027"
^DIC(9.4,111,22,1,"PAH",79,1,1,0)="PCE Cross Reference Cleanup Error."
^DIC(9.4,111,22,1,"PAH",79,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",79,1,3,0)="A description for this build can be found on the National Patch Module"
^DIC(9.4,111,22,1,"PAH",79,1,4,0)="under Patch PX*1*100."
^DIC(9.4,111,22,1,"PAH",80,0)="102 SEQ #81^3001127^1"
^DIC(9.4,111,22,1,"PAH",80,1,0)="^^4^4^3001127"
^DIC(9.4,111,22,1,"PAH",80,1,1,0)="DATA2PCE API Provider Primary/Secondary status check."
^DIC(9.4,111,22,1,"PAH",80,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",80,1,3,0)="A description for this build can be found on the National Patch Module"
^DIC(9.4,111,22,1,"PAH",80,1,4,0)="under Patch PX*1*102."
^DIC(9.4,111,22,1,"PAH",81,0)="105 SEQ #82^3010430^1"
^DIC(9.4,111,22,1,"PAH",81,1,0)="^^42^42^3010430"
^DIC(9.4,111,22,1,"PAH",81,1,1,0)="This patch addresses the PCE provider selection and lookup issue, as"
^DIC(9.4,111,22,1,"PAH",81,1,2,0)="follows:"
^DIC(9.4,111,22,1,"PAH",81,1,3,0)=" "
^DIC(9.4,111,22,1,"PAH",81,1,4,0)="Several NOIS calls have reported an error while processing provider data"
^DIC(9.4,111,22,1,"PAH",81,1,5,0)="specifically provider lookups in different PCE modules.  The error"
^DIC(9.4,111,22,1,"PAH",81,1,6,0)="presented itself at the RELOOK+7 label in routine"
^DIC(9.4,111,22,1,"PAH",81,1,7,0)="PXBGPRV2.  The exact error displayed as follows:"
^DIC(9.4,111,22,1,"PAH",81,1,8,0)=" "
^DIC(9.4,111,22,1,"PAH",81,1,9,0)="%DSM-E-UNDEF, undefined variable ^TMP(""PXBTOTAL"",557880418,""DILIST"",0)"
^DIC(9.4,111,22,1,"PAH",81,1,10,0)="-DSM-I-ECODE, MUMPS error code: M7"
^DIC(9.4,111,22,1,"PAH",81,1,11,0)="%DSM-I-ATLABEL, RELOOK+7^PXBGPRV2:1 S"
^DIC(9.4,111,22,1,"PAH",81,1,12,0)="TOTAL=$P(^TMP(""PXBTOTAL"",$J,""DILIST"",0"
^DIC(9.4,111,22,1,"PAH",81,1,13,0)="),""^"",1)"
^DIC(9.4,111,22,1,"PAH",81,1,14,0)=" "
^DIC(9.4,111,22,1,"PAH",81,1,15,0)=" "
^DIC(9.4,111,22,1,"PAH",81,1,16,0)="The second subscript of the global-variable ^TMP would contain a  ""$J"""
^DIC(9.4,111,22,1,"PAH",81,1,17,0)="value.  The problem seems to have been caused by errant data in a"
^DIC(9.4,111,22,1,"PAH",81,1,18,0)="""person/provider's record"" .  "
^DIC(9.4,111,22,1,"PAH",81,1,19,0)=" "
^DIC(9.4,111,22,1,"PAH",81,1,20,0)="During a lookup, LIST^DIC (by default) retrieves a record's ""WRITE"""
^DIC(9.4,111,22,1,"PAH",81,1,21,0)="fields; the ""TITLE"" field of a person's record is such a field. The WRITE"
^DIC(9.4,111,22,1,"PAH",81,1,22,0)="fields may vary per source file.  The TITLE field is a non-"
^DIC(9.4,111,22,1,"PAH",81,1,23,0)="required (""null"" is not invalid), pointer field. When LIST^DIC "
^DIC(9.4,111,22,1,"PAH",81,1,24,0)="encounters a ""broken pointer""/invalid data in any person's TITLE "
^DIC(9.4,111,22,1,"PAH",81,1,25,0)="field while attempting to create a PCE provider selection list,  "
^DIC(9.4,111,22,1,"PAH",81,1,26,0)="LIST^DIC immediately generates an error, discontinues the lookup "
^DIC(9.4,111,22,1,"PAH",81,1,27,0)="process, and does not return any list of provider choices [i.e. "
^DIC(9.4,111,22,1,"PAH",81,1,28,0)="^TMP(...""DILIST"")].  The standard LIST^DIC call does not account "
^DIC(9.4,111,22,1,"PAH",81,1,29,0)="for errant data in fields that should have been validated early "
^DIC(9.4,111,22,1,"PAH",81,1,30,0)="during person record processing. The errant data in a person "
^DIC(9.4,111,22,1,"PAH",81,1,31,0)="record's TITLE field and the standard LIST^DIC call in the PCE "
^DIC(9.4,111,22,1,"PAH",81,1,32,0)="routine PXBGPRV2 caused provider lookups to fail when processing"
^DIC(9.4,111,22,1,"PAH",81,1,33,0)="in PCE."
^DIC(9.4,111,22,1,"PAH",81,1,34,0)=" "
^DIC(9.4,111,22,1,"PAH",81,1,35,0)="Addressing the ""RELOOK+7^PXBGPRV2"" error,  patch PX*1*105 redesigns the"
^DIC(9.4,111,22,1,"PAH",81,1,36,0)="LIST^DIC call in PXBGPRV2 suppressing LIST^DIC 's  need of valid TITLE"
^DIC(9.4,111,22,1,"PAH",81,1,37,0)="data.  The standard PCE LIST^DIC call explicitly requests ""NAME"" as a"
^DIC(9.4,111,22,1,"PAH",81,1,38,0)="result of a lookup and implicitly requests default WRITE fields such as"
^DIC(9.4,111,22,1,"PAH",81,1,39,0)="the TITLE field.  The redesigned call in PXBGPRV2 will force LIST^DIC to"
^DIC(9.4,111,22,1,"PAH",81,1,40,0)="""ignore"" WRITE fields and return only NAME data, therefore complete"
^DIC(9.4,111,22,1,"PAH",81,1,41,0)="provider lookup processing within PCE and avoid fields unneeded by PCE"
^DIC(9.4,111,22,1,"PAH",81,1,42,0)="that may contain errant data. PX*1*105 will resolve this issue in PCE."
^DIC(9.4,111,22,1,"PAH",82,0)="104 SEQ #83^3010608^1"
^DIC(9.4,111,22,1,"PAH",82,1,0)="^^3^3^3010608"
^DIC(9.4,111,22,1,"PAH",82,1,1,0)="This patch enables adding/editing CPT Procedures to an Encounter that is not"
^DIC(9.4,111,22,1,"PAH",82,1,2,0)="an Appointment and which was created with a Credit Stop Code."
^DIC(9.4,111,22,1,"PAH",82,1,3,0)=""
^DIC(9.4,111,22,1,"PAH",83,0)="78 SEQ #84^3010710^1"
^DIC(9.4,111,22,1,"PAH",83,1,0)="^^5^5^3010710"
^DIC(9.4,111,22,1,"PAH",83,1,1,0)="PRACTICE PROFILING/PCE PHASE II"
^DIC(9.4,111,22,1,"PAH",83,1,2,0)="The Under Secretary for Health chartered a Steering Committee to develop"
^DIC(9.4,111,22,1,"PAH",83,1,3,0)="a national strategy and plan for implementing Practice Profiling"
^DIC(9.4,111,22,1,"PAH",83,1,4,0)="nationwide."
^DIC(9.4,111,22,1,"PAH",83,1,5,0)="This patch implements the PCE requirements for Practice Profiling"
^DIC(9.4,111,22,1,"PAH",84,0)="99 SEQ #85^3010802^1"
^DIC(9.4,111,22,1,"PAH",85,0)="92 SEQ #86^3010802^1"
^DIC(9.4,111,22,1,"PAH",85,1,0)="^^9^9^3010802"
^DIC(9.4,111,22,1,"PAH",85,1,1,0)="Patch PX*1.0*92 has been created in response to several NOIS's -"
^DIC(9.4,111,22,1,"PAH",85,1,2,0)="BAY-1100-31050 and its duplicates.  The error <SUBSCRIPT>LI1+19^PXBPPOV"
^DIC(9.4,111,22,1,"PAH",85,1,3,0)="re-occurred and was caused by a ^DIC Lookup that, in some cases, is"
^DIC(9.4,111,22,1,"PAH",85,1,4,0)="unable to return a selected, listed value.  ^DIC is not able to"
^DIC(9.4,111,22,1,"PAH",85,1,5,0)="choose between values that are interpreted as ""identical.""  As an example"
^DIC(9.4,111,22,1,"PAH",85,1,6,0)="^DIC considers ""94.0"" and ""94."" identical; so if the user selected"
^DIC(9.4,111,22,1,"PAH",85,1,7,0)="""94."" , ^DIC needs to know the user means exactly ""94.""  PX*1*92"
^DIC(9.4,111,22,1,"PAH",85,1,8,0)="resolves this issue by redesigning the ^DIC Lookup and allows the"
^DIC(9.4,111,22,1,"PAH",85,1,9,0)="retrieval of ""exact"" user selections."
^DIC(9.4,111,22,1,"PAH",86,0)="107 SEQ #87^3010906^1"
^DIC(9.4,111,22,1,"PAH",86,1,0)="^^3^3^3010906"
^DIC(9.4,111,22,1,"PAH",86,1,1,0)="This Patch makes modification to DBIA #2348: 'SERVICE CONNECTED CONDITIONS'"
^DIC(9.4,111,22,1,"PAH",86,1,2,0)="call."
^DIC(9.4,111,22,1,"PAH",86,1,3,0)=""
^DIC(9.4,111,22,1,"PAH",87,0)="111^3011210^1"
^DIC(9.4,111,22,1,"PAH",87,1,0)="^^3^3^3011210"
^DIC(9.4,111,22,1,"PAH",87,1,1,0)="The changes included in this patch are described in the description of"
^DIC(9.4,111,22,1,"PAH",87,1,2,0)="patch PX*1*111 (Mill Bill - LTC/Visit/Medication Co-Pay) in the National"
^DIC(9.4,111,22,1,"PAH",87,1,3,0)="Patch Module."
^DIC(9.4,111,22,1,"PAH",88,0)="106 SEQ #89^3011231^1"
^DIC(9.4,111,22,1,"PAH",88,1,0)="^^12^12^3011231"
^DIC(9.4,111,22,1,"PAH",88,1,1,0)="This patch corrects the following problems related to the PXTT EDIT HEALTH"
^DIC(9.4,111,22,1,"PAH",88,1,2,0)="FACTORS option:"
^DIC(9.4,111,22,1,"PAH",88,1,3,0)="- users could exit before filling in all required fields and that could have"
^DIC(9.4,111,22,1,"PAH",88,1,4,0)="  contributed to the further syntax errors."
^DIC(9.4,111,22,1,"PAH",88,1,5,0)="- validation of a duplicate name was not working correctly when an originally"
^DIC(9.4,111,22,1,"PAH",88,1,6,0)="  entered factor, displayed as default, was changed into an already existing"
^DIC(9.4,111,22,1,"PAH",88,1,7,0)="  one."
^DIC(9.4,111,22,1,"PAH",88,1,8,0)=""
^DIC(9.4,111,22,1,"PAH",88,1,9,0)="Additionally the patch introduced PXNAT varable to be set to 1 for"
^DIC(9.4,111,22,1,"PAH",88,1,10,0)="setting/editing a national package."
^DIC(9.4,111,22,1,"PAH",88,1,11,0)=" "
^DIC(9.4,111,22,1,"PAH",88,1,12,0)=""
^DIC(9.4,111,22,1,"PAH",89,0)="117 SEQ #90^3020327^1"
^DIC(9.4,111,22,1,"PAH",89,1,0)="^^4^4^3020327"
^DIC(9.4,111,22,1,"PAH",89,1,1,0)="This patch adresses multiple NOIS, related to missing fields in V CPT records,"
^DIC(9.4,111,22,1,"PAH",89,1,2,0)="starting from PROVIDER NARRATIVE. That missing field was causing errors that"
^DIC(9.4,111,22,1,"PAH",89,1,3,0)="originated the NOIS(es)."
^DIC(9.4,111,22,1,"PAH",89,1,4,0)=""
^DIC(9.4,111,22,1,"PAH",90,0)="113^3020423^1"
^DIC(9.4,111,22,1,"PAH",90,1,0)="^^9^9^3020423"
^DIC(9.4,111,22,1,"PAH",90,1,1,0)="This patch is in response to Item #22 in the Rossio Report.  In the area"
^DIC(9.4,111,22,1,"PAH",90,1,2,0)="of Means Test (MT) Deficiencies, Item #22 required that the Veterans"
^DIC(9.4,111,22,1,"PAH",90,1,3,0)="Health Administration (VHA) identify best practices for means testing and"
^DIC(9.4,111,22,1,"PAH",90,1,4,0)="acquiring veterans' signatures at the local level and explore the"
^DIC(9.4,111,22,1,"PAH",90,1,5,0)="promulgation of these best practices throughout the system.  This patch"
^DIC(9.4,111,22,1,"PAH",90,1,6,0)="incorporates into the Patient Care Encounter software an Enrollment"
^DIC(9.4,111,22,1,"PAH",90,1,7,0)="Application Systems (EAS) API which will inidcate whether to block the"
^DIC(9.4,111,22,1,"PAH",90,1,8,0)="checkout of an existing appointment through the PCE menu or not.  This"
^DIC(9.4,111,22,1,"PAH",90,1,9,0)="blocking is based on the veterans current means test status."
^DIC(9.4,111,22,1,"PAH",91,0)="118 SEQ #92^3020516^1"
^DIC(9.4,111,22,1,"PAH",91,1,0)="^^5^5^3020516"
^DIC(9.4,111,22,1,"PAH",91,1,1,0)="This is a clean up patch of V CPT records, following already released "
^DIC(9.4,111,22,1,"PAH",91,1,2,0)="PX*1.0*117 that prevents future occurrences of filing incomplete V CPT records."
^DIC(9.4,111,22,1,"PAH",91,1,3,0)="Additionally a correction is made to VSIT routine to return a correct"
^DIC(9.4,111,22,1,"PAH",91,1,4,0)="information, related to entered either Visit IEN or Visit's ID."
^DIC(9.4,111,22,1,"PAH",91,1,5,0)=""
^DIC(9.4,111,22,1,"PAH",92,0)="115^3020528^1"
^DIC(9.4,111,22,1,"PAH",92,1,0)="^^2^2^3020528"
^DIC(9.4,111,22,1,"PAH",92,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,111,22,1,"PAH",92,1,2,0)="section of patch PX*1*115 in the National Patch Module."
^DIC(9.4,111,22,1,"PAH",93,0)="108 SEQ #94^3030115^1"
^DIC(9.4,111,22,1,"PAH",93,1,0)="^^9^9^3030115"
^DIC(9.4,111,22,1,"PAH",93,1,1,0)="Correctly evaluate and display different formats of CPT codes when entered"
^DIC(9.4,111,22,1,"PAH",93,1,2,0)="separately or as multiple. Additionally prompts for the provider and other"
^DIC(9.4,111,22,1,"PAH",93,1,3,0)="entries, related to the selected procedure, when procedures are entered as"
^DIC(9.4,111,22,1,"PAH",93,1,4,0)="multiple."
^DIC(9.4,111,22,1,"PAH",93,1,5,0)="Calls for a list of providers for an encounter were redesigned to return"
^DIC(9.4,111,22,1,"PAH",93,1,6,0)="the correct list without duplicates, if any. Also, the PCE will not change"
^DIC(9.4,111,22,1,"PAH",93,1,7,0)="the primary provider if not requested."
^DIC(9.4,111,22,1,"PAH",93,1,8,0)=""
^DIC(9.4,111,22,1,"PAH",93,1,9,0)=""
^DIC(9.4,111,22,1,"PAH",94,0)="122^3030603^1"
^DIC(9.4,111,22,1,"PAH",94,1,0)="^^24^24^3030603"
^DIC(9.4,111,22,1,"PAH",94,1,1,0)="In response to Policy Board (NLB) comment on the VHA Veterans Equitable"
^DIC(9.4,111,22,1,"PAH",94,1,2,0)="Resource Allocation (VERA) process, the CBO requests the removal of:"
^DIC(9.4,111,22,1,"PAH",94,1,3,0)=" "
^DIC(9.4,111,22,1,"PAH",94,1,4,0)="(1) the current restriction that blocks transmission of outpatient "
^DIC(9.4,111,22,1,"PAH",94,1,5,0)="encounters (ACRP) to the National Patient Care Database (NPCD) if a"
^DIC(9.4,111,22,1,"PAH",94,1,6,0)="veteran's updated financial assessment (Means Test) information is not"
^DIC(9.4,111,22,1,"PAH",94,1,7,0)="complete, and "
^DIC(9.4,111,22,1,"PAH",94,1,8,0)="(2) the restriction that blocks the ability to schedule"
^DIC(9.4,111,22,1,"PAH",94,1,9,0)="future appointments for veterans whose financial assessments need"
^DIC(9.4,111,22,1,"PAH",94,1,10,0)="updating."
^DIC(9.4,111,22,1,"PAH",94,1,11,0)=" "
^DIC(9.4,111,22,1,"PAH",94,1,12,0)="Current policy establishes a requirement to block transmission of "
^DIC(9.4,111,22,1,"PAH",94,1,13,0)="outpatient encounters (ACRP) to the National Patient Care Database if the"
^DIC(9.4,111,22,1,"PAH",94,1,14,0)="patient's current Means Test status equals ""Required.""  This leads to"
^DIC(9.4,111,22,1,"PAH",94,1,15,0)="under-reported workload and inaccurate information in national"
^DIC(9.4,111,22,1,"PAH",94,1,16,0)="databases.  "
^DIC(9.4,111,22,1,"PAH",94,1,17,0)=" "
^DIC(9.4,111,22,1,"PAH",94,1,18,0)="Software has been implemented which blocks the ability to schedule future "
^DIC(9.4,111,22,1,"PAH",94,1,19,0)="appointments for veterans whose financial assessment needs updating.  VHA "
^DIC(9.4,111,22,1,"PAH",94,1,20,0)="Directive 2002-019, dated April 4, 2002, provided guidance to facilities "
^DIC(9.4,111,22,1,"PAH",94,1,21,0)="on the implementation of the appointment blocking software.  If a "
^DIC(9.4,111,22,1,"PAH",94,1,22,0)="veteran's financial assessment needs updating, the software prevents the "
^DIC(9.4,111,22,1,"PAH",94,1,23,0)="ability to make future appointments for the veteran.  This restriction "
^DIC(9.4,111,22,1,"PAH",94,1,24,0)="shall also be removed at the request of the CBO.  "
^DIC(9.4,111,22,1,"PAH",95,0)="96 SEQ #96^3030715^1"
^DIC(9.4,111,22,1,"PAH",95,1,0)="^^8^8^3030715"
^DIC(9.4,111,22,1,"PAH",95,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,111,22,1,"PAH",95,1,2,0)="- modifies DATA2PCE^PXAPI to support the entry of the Outside Location and"
^DIC(9.4,111,22,1,"PAH",95,1,3,0)="  properly determines the TYPE of the encounter."
^DIC(9.4,111,22,1,"PAH",95,1,4,0)="- the problem to delete completely a visit and its corresponding outpatient"
^DIC(9.4,111,22,1,"PAH",95,1,5,0)="  encounter, as well a credit stop visit if applicable."
^DIC(9.4,111,22,1,"PAH",95,1,6,0)="- acceptance and a proper filing of the INSITUTION if passed to PCE and it "
^DIC(9.4,111,22,1,"PAH",95,1,7,0)="  is different than a pointer from the Division filed of the Hospital Location."
^DIC(9.4,111,22,1,"PAH",95,1,8,0)=" "
^DIC(9.4,111,22,1,"PAH",96,0)="112 SEQ #97^3030912^1"
^DIC(9.4,111,22,1,"PAH",96,1,0)="^^4^4^3030912"
^DIC(9.4,111,22,1,"PAH",96,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,111,22,1,"PAH",96,1,2,0)="- allows to enter only one primary diagnosis and not allows for duplicates"
^DIC(9.4,111,22,1,"PAH",96,1,3,0)="- only one E&M procedure code may be accepted and with quantity=1 only"
^DIC(9.4,111,22,1,"PAH",96,1,4,0)="- fix a misspelling in a called label to address MIW-0503-41153."
^DIC(9.4,111,22,1,"PAH",97,0)="121^3030924^1"
^DIC(9.4,111,22,1,"PAH",97,1,0)="^^2^2^3030924"
^DIC(9.4,111,22,1,"PAH",97,1,1,0)="Please see the National Patch Module for details"
^DIC(9.4,111,22,1,"PAH",97,1,2,0)="of the enhancements included in this patch."
^DIC(9.4,111,22,1,"PAH",98,0)="135 SEQ #100^3040330^1"
^DIC(9.4,111,22,1,"PAH",99,0)="139 SEQ #101^3040330^1"
^DIC(9.4,111,22,1,"PAH",100,0)="116 SEQ #102^3040427^1"
^DIC(9.4,111,22,1,"PAH",100,1,0)="^^4^4^3040427"
^DIC(9.4,111,22,1,"PAH",100,1,1,0)="This patch will modify PCE so that it will create a visit with the progress"
^DIC(9.4,111,22,1,"PAH",100,1,2,0)="note associated with a disposition location in the same way like with"
^DIC(9.4,111,22,1,"PAH",100,1,3,0)="other locations."
^DIC(9.4,111,22,1,"PAH",100,1,4,0)=""
^DIC(9.4,111,22,1,"PAH",101,0)="142 SEQ #103^3040521^1"
^DIC(9.4,111,22,1,"PAH",101,1,0)="^^1^1^3040521"
^DIC(9.4,111,22,1,"PAH",101,1,1,0)="Create 132 column version of HEALTH FACTOR LIST report."
^DIC(9.4,111,22,1,"PAH",102,0)="132 SEQ #104^3040702^1"
^DIC(9.4,111,22,1,"PAH",102,1,0)="^^7^7^3040702"
^DIC(9.4,111,22,1,"PAH",102,1,1,0)="Currently if a CPT code is part of a subset of E & M codes the user is "
^DIC(9.4,111,22,1,"PAH",102,1,2,0)="allowed to enter that CPT code only once per encounter and with a "
^DIC(9.4,111,22,1,"PAH",102,1,3,0)="quantity of only 1. There are 2 problems being addressed with this logic."
^DIC(9.4,111,22,1,"PAH",102,1,4,0)="1) If a CPT code begins with a letter it is being identified as an E & M "
^DIC(9.4,111,22,1,"PAH",102,1,5,0)="code whether or not it truly is. "
^DIC(9.4,111,22,1,"PAH",102,1,6,0)="2) Certain E & M codes need to allow a quantity of more than 1 to be "
^DIC(9.4,111,22,1,"PAH",102,1,7,0)="ordered."
^DIC(9.4,111,22,1,"PAH",103,0)="136 SEQ #105^3040702^1"
^DIC(9.4,111,22,1,"PAH",103,1,0)="^^13^13^3040702"
^DIC(9.4,111,22,1,"PAH",103,1,1,0)="PROBLEM 1:"
^DIC(9.4,111,22,1,"PAH",103,1,2,0)="     In PCE, while running the CP (CPT Procedure) Protocol, the code does "
^DIC(9.4,111,22,1,"PAH",103,1,3,0)="not check to see if the CPT code is an E&M code in file 357.69 (Type of "
^DIC(9.4,111,22,1,"PAH",103,1,4,0)="Visit). An E&M code may only be placed on an encounter once with the"
^DIC(9.4,111,22,1,"PAH",103,1,5,0)="""Quantity"" field only allowing a ""1"" unless the ""Type of Visit"" file is"
^DIC(9.4,111,22,1,"PAH",103,1,6,0)="set up to allow more than one. This business rule is, therefore, not "
^DIC(9.4,111,22,1,"PAH",103,1,7,0)="being enforced."
^DIC(9.4,111,22,1,"PAH",103,1,8,0)=" "
^DIC(9.4,111,22,1,"PAH",103,1,9,0)="PROBLEM 2:"
^DIC(9.4,111,22,1,"PAH",103,1,10,0)="     In the Check Out function of PCE the user is asked to enter an ICD9 "
^DIC(9.4,111,22,1,"PAH",103,1,11,0)="code. If the user enters a partial CPT code then the Check Out procedure "
^DIC(9.4,111,22,1,"PAH",103,1,12,0)="will generate a list of codes that match. However, if one of the matching "
^DIC(9.4,111,22,1,"PAH",103,1,13,0)="ICD9 codes has a blank Description field the program will error."
^DIC(9.4,111,22,1,"PAH",104,0)="133 SEQ #106^3040702^1"
^DIC(9.4,111,22,1,"PAH",104,1,0)="^^1^1^3040702"
^DIC(9.4,111,22,1,"PAH",104,1,1,0)="Fix error in PCE Encounter Summary when clinic is null. "
^DIC(9.4,111,22,1,"PAH",105,0)="134 SEQ #107^3040702^1"
^DIC(9.4,111,22,1,"PAH",105,1,0)="^^3^3^3040702"
^DIC(9.4,111,22,1,"PAH",105,1,1,0)="Fixing a problem where the checkout process errors when bad data is "
^DIC(9.4,111,22,1,"PAH",105,1,2,0)="passed to a fileman call while looking up and displaying ICD9 codes "
^DIC(9.4,111,22,1,"PAH",105,1,3,0)="already on the encounter."
^DIC(9.4,111,22,1,"PAH",106,0)="130^3040802^1"
^DIC(9.4,111,22,1,"PAH",106,1,0)="^^2^2^3040802"
^DIC(9.4,111,22,1,"PAH",106,1,1,0)="Please see the National Patch Module for details"
^DIC(9.4,111,22,1,"PAH",106,1,2,0)="of the enhancements included in this patch."
^DIC(9.4,111,22,1,"PAH",107,0)="131 SEQ #109^3040802^1"
^DIC(9.4,111,22,1,"PAH",107,1,0)="^^1^1^3040802"
^DIC(9.4,111,22,1,"PAH",107,1,1,0)="FIX V FILE INTEGRITY CHECKER PROMPTING."
^DIC(9.4,111,22,1,"PAH",108,0)="143 SEQ #110^3040802^1"
^DIC(9.4,111,22,1,"PAH",108,1,0)="^^5^5^3040802"
^DIC(9.4,111,22,1,"PAH",108,1,1,0)="Fix three problems. 1) Editing provider information for an encounter is "
^DIC(9.4,111,22,1,"PAH",108,1,2,0)="not triggering a re-transmission to the NPCDB. 2) The prompts under the CP"
^DIC(9.4,111,22,1,"PAH",108,1,3,0)="protocol work incorrectly when editing a CPT code that begins with a "
^DIC(9.4,111,22,1,"PAH",108,1,4,0)="letter. 3) Editing the Provider does not update the User Class when "
^DIC(9.4,111,22,1,"PAH",108,1,5,0)="changing an existing provider to a different provider."
^DIC(9.4,111,22,1,"PAH",109,0)="141 SEQ #111^3040917^1"
^DIC(9.4,111,22,1,"PAH",109,1,0)="^^1^1^3040917"
^DIC(9.4,111,22,1,"PAH",109,1,1,0)="Provider coming up as invalid provider"
^DIC(9.4,111,22,1,"PAH",110,0)="146 SEQ #112^3040924^1"
^DIC(9.4,111,22,1,"PAH",110,1,0)="^^3^3^3040924"
^DIC(9.4,111,22,1,"PAH",110,1,1,0)="This will address the CASELOAD PROFILE BY CLINIC [PXRR CASELOAD"
^DIC(9.4,111,22,1,"PAH",110,1,2,0)="PROFILE BY CL] option of the PATIENT CARE ENCOUNTER (PCE) package."
^DIC(9.4,111,22,1,"PAH",110,1,3,0)="The report did not correctly display unscheduled encounters."
^DIC(9.4,111,22,1,"PAH",111,0)="123 SEQ #113^3041015^1"
^DIC(9.4,111,22,1,"PAH",111,1,0)="^^4^4^3041015"
^DIC(9.4,111,22,1,"PAH",111,1,1,0)="PX*1.0*123"
^DIC(9.4,111,22,1,"PAH",111,1,2,0)="Patch 123 for PCE Patient Care Encounter 1.0"
^DIC(9.4,111,22,1,"PAH",111,1,3,0)="See National Patch Module for a description of the changes incorporated in"
^DIC(9.4,111,22,1,"PAH",111,1,4,0)="this patch."
^DIC(9.4,111,22,1,"PAH",112,0)="147 SEQ #114^3041015^1"
^DIC(9.4,111,22,1,"PAH",112,1,0)="^^6^6^3041015"
^DIC(9.4,111,22,1,"PAH",112,1,1,0)="Date of death display warning. Addresses the selecting of deceased "
^DIC(9.4,111,22,1,"PAH",112,1,2,0)="patients, within PCE, that currently does not check and display for date "
^DIC(9.4,111,22,1,"PAH",112,1,3,0)="of death."
^DIC(9.4,111,22,1,"PAH",112,1,4,0)=" "
^DIC(9.4,111,22,1,"PAH",112,1,5,0)="Also, addresses [PXRR PROVIDER ENCOUNTER COUNTS] where the prompt for "
^DIC(9.4,111,22,1,"PAH",112,1,6,0)="selection by Person Class was limited to 30 characters."
^DIC(9.4,111,22,1,"PAH",113,0)="149^3041015^1"
^DIC(9.4,111,22,1,"PAH",114,0)="119^3041228^1"
