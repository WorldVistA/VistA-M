^DIC(9.4,59,22,5,"PAH",154,1,10,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",154,1,11,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",154,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",154,1,13,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",154,1,14,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",154,1,15,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",154,1,16,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",154,1,17,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",154,1,18,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",155,0)="168 SEQ #155^3080526.160245^1"
^DIC(9.4,59,22,5,"PAH",155,1,0)="^^11^11^3080526"
^DIC(9.4,59,22,5,"PAH",155,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",155,1,2,0)="""AMASTERVUID"" cross references were created on the MASTER ENTRY FOR VUID"
^DIC(9.4,59,22,5,"PAH",155,1,3,0)="field (#99.98) in the DRUG INGREDIENTS (#50.416), VA DRUG CLASS (#50.605),"
^DIC(9.4,59,22,5,"PAH",155,1,4,0)="VA GENERIC (#50.6), and VA PRODUCT (#50.68) files.  These cross"
^DIC(9.4,59,22,5,"PAH",155,1,5,0)="references were not properly created.  New style cross references were"
^DIC(9.4,59,22,5,"PAH",155,1,6,0)="created to correct the problem.  This patch removes the obsolete cross"
^DIC(9.4,59,22,5,"PAH",155,1,7,0)="references and deletes the incorrect entries in the cross reference."
^DIC(9.4,59,22,5,"PAH",155,1,8,0)=" "
^DIC(9.4,59,22,5,"PAH",155,1,9,0)="This patch also changes the file description for these four files to"
^DIC(9.4,59,22,5,"PAH",155,1,10,0)="indicate that according to VHA Directive 2005-044 the data dictionaries"
^DIC(9.4,59,22,5,"PAH",155,1,11,0)="of these files must not be changed."
^DIC(9.4,59,22,5,"PAH",156,0)="170^3080526.192518^1"
^DIC(9.4,59,22,5,"PAH",156,1,0)="^^17^17^3080526"
^DIC(9.4,59,22,5,"PAH",156,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",156,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",156,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",156,1,4,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",156,1,5,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",156,1,6,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",156,1,7,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",156,1,8,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",156,1,9,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",156,1,10,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",156,1,11,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",156,1,12,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",156,1,13,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",156,1,14,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",156,1,15,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",156,1,16,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",156,1,17,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",157,0)="171^3080526.192716^1"
^DIC(9.4,59,22,5,"PAH",157,1,0)="^^18^18^3080526"
^DIC(9.4,59,22,5,"PAH",157,1,1,0)=" "
