^DIC(9.4,134,22,17,"PAH",20,1,91,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,92,0)="  "
^DIC(9.4,134,22,17,"PAH",20,1,93,0)=" INSTALLATION INSTRUCTIONS:"
^DIC(9.4,134,22,17,"PAH",20,1,94,0)=" =========================="
^DIC(9.4,134,22,17,"PAH",20,1,95,0)=" >>> Users may remain on the system"
^DIC(9.4,134,22,17,"PAH",20,1,96,0)=" >>> TaskMan does NOT need to be stopped"
^DIC(9.4,134,22,17,"PAH",20,1,97,0)=" >>> Time to install patch is less than 2 minutes"
^DIC(9.4,134,22,17,"PAH",20,1,98,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,99,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,134,22,17,"PAH",20,1,100,0)="option will load the KIDS package onto your system."
^DIC(9.4,134,22,17,"PAH",20,1,101,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,102,0)=" 2. The patch has now been loaded into a Transport global on your system. "
^DIC(9.4,134,22,17,"PAH",20,1,103,0)="From the KIDS menu, you can use the following options:"
^DIC(9.4,134,22,17,"PAH",20,1,104,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,105,0)="        Verify Checksums in Transport Global (optional)"
^DIC(9.4,134,22,17,"PAH",20,1,106,0)="        Print Transport Global (optional)"
^DIC(9.4,134,22,17,"PAH",20,1,107,0)="        Compare Transport Global to Current System (optional)"
^DIC(9.4,134,22,17,"PAH",20,1,108,0)="        Backup a Transport Global (optional)"
^DIC(9.4,134,22,17,"PAH",20,1,109,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,110,0)=" 5. From the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,134,22,17,"PAH",20,1,111,0)="option to install the patch:"
^DIC(9.4,134,22,17,"PAH",20,1,112,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,113,0)="  Install Package(s) QAC*2.0*21"
^DIC(9.4,134,22,17,"PAH",20,1,114,0)="  ."
^DIC(9.4,134,22,17,"PAH",20,1,115,0)="  ."
^DIC(9.4,134,22,17,"PAH",20,1,116,0)="  ."
^DIC(9.4,134,22,17,"PAH",20,1,117,0)="  Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,134,22,17,"PAH",20,1,118,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,119,0)="  Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,134,22,17,"PAH",20,1,120,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,121,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,122,0)="DOCUMENTATION:"
^DIC(9.4,134,22,17,"PAH",20,1,123,0)="================= "
^DIC(9.4,134,22,17,"PAH",20,1,124,0)="Documents for the PATS system can be obtained by using FTP from the"
^DIC(9.4,134,22,17,"PAH",20,1,125,0)="appropriate Customer Service directory:"
^DIC(9.4,134,22,17,"PAH",20,1,126,0)="  "
^DIC(9.4,134,22,17,"PAH",20,1,127,0)="    OI FIELD OFFICE    FTP ADDRESS    DIRECTORY"
^DIC(9.4,134,22,17,"PAH",20,1,128,0)="    ===============    ===========    =================="
^DIC(9.4,134,22,17,"PAH",20,1,129,0)="                       download.vista.domain.ext"
^DIC(9.4,134,22,17,"PAH",20,1,130,0)="    Albany                            ftp.fo-albany.domain.ext"
^DIC(9.4,134,22,17,"PAH",20,1,131,0)="    Hines                             ftp.fo-hines.domain.ext "
^DIC(9.4,134,22,17,"PAH",20,1,132,0)="    Salt Lake City                    ftp.fo-slc.domain.ext"
^DIC(9.4,134,22,17,"PAH",20,1,133,0)="  "
^DIC(9.4,134,22,17,"PAH",20,1,134,0)=" Document can also be downloaded from the VistA Documentation Library"
^DIC(9.4,134,22,17,"PAH",20,1,135,0)="(VDL) Web page:"
^DIC(9.4,134,22,17,"PAH",20,1,136,0)="  "
^DIC(9.4,134,22,17,"PAH",20,1,137,0)="    <http://www.domain.ext/vdl/section.asp?secid=4>"
^DIC(9.4,134,22,17,"PAH",20,1,138,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,139,0)=" "
