^DIC(9.4,14,22,5.9,"PAH",182,0)="328 SEQ #280^3061122.234608^1"
^DIC(9.4,14,22,5.9,"PAH",182,1,0)="^^209^209^3061122"
^DIC(9.4,14,22,5.9,"PAH",182,1,1,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*328 does not"
^DIC(9.4,14,22,5.9,"PAH",182,1,2,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,14,22,5.9,"PAH",182,1,3,0)="DIRECTIVE 2004-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",182,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,5,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*328 does not"
^DIC(9.4,14,22,5.9,"PAH",182,1,6,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",182,1,7,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",182,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,9,0)="RISK ANALYSIS: Changes made by patch LR*5.2*328 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",182,1,10,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",182,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,12,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes"
^DIC(9.4,14,22,5.9,"PAH",182,1,13,0)="made, no specific validation requirements exist as a result of installation"
^DIC(9.4,14,22,5.9,"PAH",182,1,14,0)="of this patch."
^DIC(9.4,14,22,5.9,"PAH",182,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,17,0)="Nature of Problem:"
^DIC(9.4,14,22,5.9,"PAH",182,1,18,0)=" PSI-04-059 identified a patient safety issue identified during the"
^DIC(9.4,14,22,5.9,"PAH",182,1,19,0)=" testing phase of the Laboratory Electronic Data Interchange (LEDI III)"
^DIC(9.4,14,22,5.9,"PAH",182,1,20,0)=" software patches LA*5.2*64 and LR*5.2*286."
^DIC(9.4,14,22,5.9,"PAH",182,1,21,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,22,0)=" Two test sites reported an undefined error related to the variable SEX"
^DIC(9.4,14,22,5.9,"PAH",182,1,23,0)=" which contains the patient's sex. During analysis of the reported error,"
^DIC(9.4,14,22,5.9,"PAH",182,1,24,0)=" it was determined, by the laboratory development team, that the variable"
^DIC(9.4,14,22,5.9,"PAH",182,1,25,0)=" that referenced the patient's sex was being killed between accessions when"
^DIC(9.4,14,22,5.9,"PAH",182,1,26,0)=" a laboratory order created two or more accessions."
^DIC(9.4,14,22,5.9,"PAH",182,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,28,0)=" The problem occurs when laboratory users enter laboratory test results"
^DIC(9.4,14,22,5.9,"PAH",182,1,29,0)=" using the VistA Laboratory option ""Accession order then immediately enter"
^DIC(9.4,14,22,5.9,"PAH",182,1,30,0)=" data [LR ACC THEN DATA]"".  If the laboratory order being processed"
^DIC(9.4,14,22,5.9,"PAH",182,1,31,0)=" creates two or more accessions, the second and any subsequent accessions,"
^DIC(9.4,14,22,5.9,"PAH",182,1,32,0)=" may calculate age and/or sex based normals and abnormals incorrectly."
^DIC(9.4,14,22,5.9,"PAH",182,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,34,0)=" We believe this to be a pre-existing problem; however, we cannot"
^DIC(9.4,14,22,5.9,"PAH",182,1,35,0)=" determine how long the problem has been occurring. It is unknown as to"
^DIC(9.4,14,22,5.9,"PAH",182,1,36,0)=" whether any specific incidents have occurred if any.  Also, but most"
^DIC(9.4,14,22,5.9,"PAH",182,1,37,0)=" importantly, no patients were harmed."
^DIC(9.4,14,22,5.9,"PAH",182,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,39,0)="Solution:"
^DIC(9.4,14,22,5.9,"PAH",182,1,40,0)=" The LR*5.2*328 patch was developed which will set patient's demographics"
^DIC(9.4,14,22,5.9,"PAH",182,1,41,0)=" between processing of accessions when using the ""Accession order then"
^DIC(9.4,14,22,5.9,"PAH",182,1,42,0)=" immediately enter data [LR ACC THEN DATA]"" option.  This will ensure that"
^DIC(9.4,14,22,5.9,"PAH",182,1,43,0)=" the patient's age/sex is defined before calculating any age/sex based"
^DIC(9.4,14,22,5.9,"PAH",182,1,44,0)=" normals and determining abnormality flags."
^DIC(9.4,14,22,5.9,"PAH",182,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,46,0)=" The routine LRFAST is modified to define the applicable patient "
^DIC(9.4,14,22,5.9,"PAH",182,1,47,0)=" demographic values for sex, date of birth, and age when processing each"
^DIC(9.4,14,22,5.9,"PAH",182,1,48,0)=" accession associated with the order."
^DIC(9.4,14,22,5.9,"PAH",182,1,49,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,51,0)=" ASSOCIATED E3R"
^DIC(9.4,14,22,5.9,"PAH",182,1,52,0)=" --------------"
^DIC(9.4,14,22,5.9,"PAH",182,1,53,0)=" None"
^DIC(9.4,14,22,5.9,"PAH",182,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,55,0)=" ASSOCIATED REMEDY"
^DIC(9.4,14,22,5.9,"PAH",182,1,56,0)=" ---------------"
^DIC(9.4,14,22,5.9,"PAH",182,1,57,0)=" None"
^DIC(9.4,14,22,5.9,"PAH",182,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,59,0)=" ASSOCIATED PSI"
^DIC(9.4,14,22,5.9,"PAH",182,1,60,0)=" ---------------"
^DIC(9.4,14,22,5.9,"PAH",182,1,61,0)=" PSI-04-059 PATIENT SAFETY ISSUE: Laboratory, 11/3/2004 5:20:06 PM"
^DIC(9.4,14,22,5.9,"PAH",182,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",182,1,63,0)="  "
