^DIC(9.4,197,22,1,"PAH",72,1,1,0)="Backup of MD*1.0*88 on Jan 10, 2025"
^DIC(9.4,197,22,1,"PAH",72,1,2,0)=" "
^DIC(9.4,197,22,1,"PAH",72,1,3,0)="Warning:  Installing this backup patch message will install older versions"
