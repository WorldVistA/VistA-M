^DIC(9.4,4,22,1,"PAH",141,1,27,0)=" "
^DIC(9.4,4,22,1,"PAH",141,1,28,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",141,1,29,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",141,1,30,0)="is at a minimum.  It requires MailMan patches XM*7.1*116, XM*7.1*149,"
^DIC(9.4,4,22,1,"PAH",141,1,31,0)="and XM*7.1*156."
^DIC(9.4,4,22,1,"PAH",141,1,32,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",141,1,33,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",141,1,34,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",141,1,35,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",141,1,36,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",141,1,37,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",141,1,38,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",141,1,39,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",141,1,40,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",141,1,41,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",141,1,42,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",141,1,43,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",141,1,44,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",141,1,45,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",141,1,46,0)=" Select INSTALL NAME:    XM*7.1*168    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",141,1,47,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",141,1,48,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",141,1,49,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",141,1,50,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",141,1,51,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",141,1,52,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",141,1,53,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",141,1,54,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",141,1,55,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",141,1,56,0)=""
^DIC(9.4,4,22,1,"PAH",141,1,57,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
