^DIC(9.4,11,15002)="^26^ASSIGNED"
^DIC(9.4,11,"DEV")="STALLING,F/DALISC"
^DIC(9.4,11,"DIPT",0)="^9.46"
^DIC(9.4,11,"EX",0)="^9.432^1^1"
^DIC(9.4,11,"EX",1,0)="LAZ"
^DIC(9.4,11,"INIT")="LAIPOST^2960605.18344"
^DIC(9.4,11,"M",0)="^9.495^3^3"
^DIC(9.4,11,"M",1,0)="LR DO!^943"
^DIC(9.4,11,"M",2,0)="LRSUPERVISOR^943"
^DIC(9.4,11,"M",3,0)="LRMI^952"
