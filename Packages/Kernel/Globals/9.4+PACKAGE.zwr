^DIC(9.4,4,22,1,"PAH",61,1,68,0)="This is what some (post-patch XM*7.1*50) sites see:"
^DIC(9.4,4,22,1,"PAH",61,1,69,0)=">D ^%G"
^DIC(9.4,4,22,1,"PAH",61,1,70,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,71,0)="Global ^DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,72,0)="        DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,73,0)="^DD(3.9,0,""IX"",""AI"",3.9,9) = "
