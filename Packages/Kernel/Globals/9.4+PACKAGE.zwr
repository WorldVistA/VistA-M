^DIC(9.4,48,22,5.28,"PAH",676,1,11,0)="          $$INACTIVE^SDES2UTIL"
^DIC(9.4,48,22,5.28,"PAH",676,1,12,0)="VSE-8246: JJ - VistA: Modify SDES2 SEARCH CLINIC ATTRIBUTES to correct"
^DIC(9.4,48,22,5.28,"PAH",676,1,13,0)="          the empty object name and routine documentation"
^DIC(9.4,48,22,5.28,"PAH",676,1,14,0)="VSE-8259: BF - VistA: Modify SDES2 GET CLINIC AVAIL BY SVC to adjust the "
^DIC(9.4,48,22,5.28,"PAH",676,1,15,0)="          way the Maximum records returned is calculated"
