^DIC(9.4,114,22,30,"PAH",118,1,179,0)=" Documentation Retrieval Instructions:"
^DIC(9.4,114,22,30,"PAH",118,1,180,0)=" -------------------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,181,0)=" Updated documentation describing the new functionality introduced by this"
^DIC(9.4,114,22,30,"PAH",118,1,182,0)=" patch is available."
^DIC(9.4,114,22,30,"PAH",118,1,183,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,184,0)=" The preferred method is to FTP the files from ftp://download.vista.domain.ext/"
^DIC(9.4,114,22,30,"PAH",118,1,185,0)=" This transmits the files from the first available FTP server. Sites may also"
^DIC(9.4,114,22,30,"PAH",118,1,186,0)=" elect to retrieve software directly from a specific server as follows:"
^DIC(9.4,114,22,30,"PAH",118,1,187,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,188,0)="   Albany         ftp.fo-albany.domain.ext  <ftp://ftp.fo-albany.domain.ext>"
^DIC(9.4,114,22,30,"PAH",118,1,189,0)="   Hines          ftp.fo-hines.domain.ext   <ftp://ftp.fo-hines.domain.ext>"
^DIC(9.4,114,22,30,"PAH",118,1,190,0)="   Salt Lake City ftp.fo-slc.domain.ext     <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,114,22,30,"PAH",118,1,191,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,192,0)="  The documentation will be in the form of Adobe Acrobat files."
^DIC(9.4,114,22,30,"PAH",118,1,193,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,194,0)="  Documentation can also be found on the VA Software Documentation Library"
^DIC(9.4,114,22,30,"PAH",118,1,195,0)="  at: http://www4.domain.ext/vdl/"
^DIC(9.4,114,22,30,"PAH",118,1,196,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,197,0)="  File Description                          File Name             FTP Mode"
^DIC(9.4,114,22,30,"PAH",118,1,198,0)="  --------------------------------------------------------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,199,0)="  Fee Basis User Manual                     fb3_5um.pdf           Binary"
^DIC(9.4,114,22,30,"PAH",118,1,200,0)="  PIMS v5.3 ADT User Manual Registration    dg_5_3_reg_um.pdf     Binary"
^DIC(9.4,114,22,30,"PAH",118,1,201,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,202,0)=" The procedure guide, Care for Newborn of Women Veterans, located at"
^DIC(9.4,114,22,30,"PAH",118,1,203,0)=" http://nonvacare.hac.domain.ext/policy-programs/procedure-guides.asp,"
^DIC(9.4,114,22,30,"PAH",118,1,204,0)=" should be distributed to those personnel registering newborns and/or"
^DIC(9.4,114,22,30,"PAH",118,1,205,0)=" processing newborn claims."
^DIC(9.4,114,22,30,"PAH",118,1,206,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,207,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,208,0)="  Patch Installation:"
^DIC(9.4,114,22,30,"PAH",118,1,209,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,210,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,211,0)=" Pre/Post Installation Overview"
^DIC(9.4,114,22,30,"PAH",118,1,212,0)=" ------------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,213,0)=" There are three post installation routines associated with this patch DG867PO,"
^DIC(9.4,114,22,30,"PAH",118,1,214,0)=" FB146PO, and IB499PO. These routines primarily serve as filters for the data"
^DIC(9.4,114,22,30,"PAH",118,1,215,0)=" transmitted to the appropriate files listed above, so that only the intended"
^DIC(9.4,114,22,30,"PAH",118,1,216,0)=" data is delivered. The only exception is the IB499PO routine which"
^DIC(9.4,114,22,30,"PAH",118,1,217,0)=" programmatically makes an addition to the help text of the FAMILY PREFIX field"
^DIC(9.4,114,22,30,"PAH",118,1,218,0)=" (#.03) in the SPONSOR RELATIONSHIP file (#355.81). These post installation"
^DIC(9.4,114,22,30,"PAH",118,1,219,0)=" routines may be deleted after successful installation of the NEWBORN DG FB IB"
^DIC(9.4,114,22,30,"PAH",118,1,220,0)=" BUNDLE 1.0"
^DIC(9.4,114,22,30,"PAH",118,1,221,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,222,0)=" Installation Instructions"
^DIC(9.4,114,22,30,"PAH",118,1,223,0)=" -------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,224,0)=" This patch may be installed with users on the system although it is"
^DIC(9.4,114,22,30,"PAH",118,1,225,0)=" recommended that it be installed during non-peak hours to minimize potential"
^DIC(9.4,114,22,30,"PAH",118,1,226,0)=" disruption to users. This patch should take less than 5 minutes to install."
^DIC(9.4,114,22,30,"PAH",118,1,227,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,228,0)=" FB*3.5*147 is a required patch and must be installed before DG*5.3*867."
^DIC(9.4,114,22,30,"PAH",118,1,229,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,230,0)=" DG*5.3*867 is one of three patches for this release (including FB*3.5*146 and"
^DIC(9.4,114,22,30,"PAH",118,1,231,0)=" IB*2.0*499). The patches will be installed as a bundle in the following order:"
^DIC(9.4,114,22,30,"PAH",118,1,232,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,233,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,234,0)=" 1) DG*5.3*867"
^DIC(9.4,114,22,30,"PAH",118,1,235,0)=" 2) FB*3.5*146"
^DIC(9.4,114,22,30,"PAH",118,1,236,0)=" 3) IB*2.0*499"
^DIC(9.4,114,22,30,"PAH",118,1,237,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,238,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,239,0)="  Pre-Installation Instructions"
^DIC(9.4,114,22,30,"PAH",118,1,240,0)="  -----------------------------"
^DIC(9.4,114,22,30,"PAH",118,1,241,0)="  1.  OBTAIN PATCHES"
^DIC(9.4,114,22,30,"PAH",118,1,242,0)="      --------------"
^DIC(9.4,114,22,30,"PAH",118,1,243,0)=" Obtain the host file NEWBORN_1_2_DG_FB_IB.KID which contains the following"
^DIC(9.4,114,22,30,"PAH",118,1,244,0)=" patches:"
^DIC(9.4,114,22,30,"PAH",118,1,245,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,246,0)="  DG*5.3*867"
^DIC(9.4,114,22,30,"PAH",118,1,247,0)="  FB*3.5*146"
^DIC(9.4,114,22,30,"PAH",118,1,248,0)="  IB*2.0*499"
^DIC(9.4,114,22,30,"PAH",118,1,249,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,250,0)=" Sites can retrieve VistA software from the following FTP addresses. The"
^DIC(9.4,114,22,30,"PAH",118,1,251,0)=" preferred method is to FTP the files from:"
^DIC(9.4,114,22,30,"PAH",118,1,252,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,253,0)="                      download.vista.domain.ext"
^DIC(9.4,114,22,30,"PAH",118,1,254,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,255,0)=" This will transmit the files from the first available FTP server. Sites may"
^DIC(9.4,114,22,30,"PAH",118,1,256,0)=" also elect to retrieve software directly from a specific server as follows:"
^DIC(9.4,114,22,30,"PAH",118,1,257,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,258,0)="         Albany                  ftp.fo-albany.domain.ext"
^DIC(9.4,114,22,30,"PAH",118,1,259,0)="         Hines                   ftp.fo-hines.domain.ext"
^DIC(9.4,114,22,30,"PAH",118,1,260,0)="         Salt Lake City          ftp.fo-slc.domain.ext"
^DIC(9.4,114,22,30,"PAH",118,1,261,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,262,0)=" The NEWBORN_1_2_DG_FB_IB.KID host file is located in the anonymous.software"
^DIC(9.4,114,22,30,"PAH",118,1,263,0)=" directory. Use ASCII Mode when downloading the file."
^DIC(9.4,114,22,30,"PAH",118,1,264,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,265,0)="  2.  START UP KIDS"
^DIC(9.4,114,22,30,"PAH",118,1,266,0)="      -------------"
^DIC(9.4,114,22,30,"PAH",118,1,267,0)="      Start up the Kernel Installation and Distribution System Menu option"
^DIC(9.4,114,22,30,"PAH",118,1,268,0)="      [XPD MAIN]:"
^DIC(9.4,114,22,30,"PAH",118,1,269,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,270,0)="           Edits and Distribution ..."
^DIC(9.4,114,22,30,"PAH",118,1,271,0)="           Utilities ..."
^DIC(9.4,114,22,30,"PAH",118,1,272,0)="           Installation ..."
^DIC(9.4,114,22,30,"PAH",118,1,273,0)=" "
^DIC(9.4,114,22,30,"PAH",118,1,274,0)="      Select Kernel Installation & Distribution System Option: Installation"
^DIC(9.4,114,22,30,"PAH",118,1,275,0)="                                                               ---"
^DIC(9.4,114,22,30,"PAH",118,1,276,0)="           Load a Distribution"
^DIC(9.4,114,22,30,"PAH",118,1,277,0)="           Print Transport Global"
