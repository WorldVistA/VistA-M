^DIC(9.4,11,22,5.03,"PAH",26,1,193,0)=" LA*5.2*62 Installed."
^DIC(9.4,11,22,5.03,"PAH",26,1,194,0)="               Jun 10, 2002@16:10:22"
^DIC(9.4,11,22,5.03,"PAH",26,1,195,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,196,0)=" Install Message sent #xxxxx"
^DIC(9.4,11,22,5.03,"PAH",27,0)="65 SEQ #47^3020906^1"
^DIC(9.4,11,22,5.03,"PAH",27,1,0)="^^165^165^3020906"
^DIC(9.4,11,22,5.03,"PAH",27,1,1,0)="VISTA Laboratory Package patch LA*5.2*65 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",27,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",27,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,4,0)="Patch LA*5.2*65 corrects a null subscript error in routine LA7SMU1. The"
^DIC(9.4,11,22,5.03,"PAH",27,1,5,0)="error occurs when processing a HL7 Result (ORU) message that contains"
^DIC(9.4,11,22,5.03,"PAH",27,1,6,0)="an invalid shipping manifest number. The routine will check for a valid"
^DIC(9.4,11,22,5.03,"PAH",27,1,7,0)="pointer to file LAB SHIPPING MANIFEST (#62.8) before attempting to"
^DIC(9.4,11,22,5.03,"PAH",27,1,8,0)="associate a test result with it's associated test on a shipping manifest."
^DIC(9.4,11,22,5.03,"PAH",27,1,9,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,11,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,12,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",27,1,13,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",27,1,14,0)=" ALB-0602-51133"
^DIC(9.4,11,22,5.03,"PAH",27,1,15,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,16,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,17,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",27,1,18,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",27,1,19,0)=" Albuquerque VAMC"
^DIC(9.4,11,22,5.03,"PAH",27,1,20,0)=" Milwaukee VAMC"
^DIC(9.4,11,22,5.03,"PAH",27,1,21,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,22,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,23,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",27,1,24,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",27,1,25,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",27,1,26,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",27,1,27,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",27,1,28,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,29,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",27,1,30,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",27,1,31,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",27,1,32,0)="   LA65             N/A            4454886        **65** (Deleted by KIDS)"
^DIC(9.4,11,22,5.03,"PAH",27,1,33,0)="   LA7SMU1          6241668        6300206        **27,46,65** "
^DIC(9.4,11,22,5.03,"PAH",27,1,34,0)=""
^DIC(9.4,11,22,5.03,"PAH",27,1,35,0)=" List of preceding patches: 46"
^DIC(9.4,11,22,5.03,"PAH",27,1,36,0)=" Sites should use CHECK^XTSUMBLD to verify checksums. "
^DIC(9.4,11,22,5.03,"PAH",27,1,37,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,38,0)="  "
^DIC(9.4,11,22,5.03,"PAH",27,1,39,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",27,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,41,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",27,1,42,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",27,1,43,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,44,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,11,22,5.03,"PAH",27,1,45,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",27,1,46,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",27,1,47,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,48,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,49,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,11,22,5.03,"PAH",27,1,50,0)="      problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",27,1,51,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,52,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",27,1,53,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",27,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,55,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,56,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",27,1,57,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,58,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",27,1,59,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",27,1,60,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,61,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",27,1,62,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",27,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,64,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",27,1,65,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",27,1,66,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,67,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",27,1,68,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",27,1,69,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",27,1,70,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",27,1,71,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",27,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,73,0)="  6.  Perform the following steps if applicable:"
^DIC(9.4,11,22,5.03,"PAH",27,1,74,0)="      All Lab LEDI (LA7V*) related HL v1.6 LLPs should be shutdown."
^DIC(9.4,11,22,5.03,"PAH",27,1,75,0)="      Use the HL menu option Start/Stop Links [HL START] to shutdown"
^DIC(9.4,11,22,5.03,"PAH",27,1,76,0)="      these LLPs if they are running."
^DIC(9.4,11,22,5.03,"PAH",27,1,77,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,78,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,79,0)="  7.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",27,1,80,0)="      and select the package 'LA*5.2*65'.  When prompted 'Want KIDS to"
^DIC(9.4,11,22,5.03,"PAH",27,1,81,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,11,22,5.03,"PAH",27,1,82,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,11,22,5.03,"PAH",27,1,83,0)="      YES//', choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",27,1,84,0)=""
^DIC(9.4,11,22,5.03,"PAH",27,1,85,0)="  "
^DIC(9.4,11,22,5.03,"PAH",27,1,86,0)="  8. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",27,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,88,0)=" Note: Routine LA65 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",27,1,89,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,90,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,91,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,11,22,5.03,"PAH",27,1,92,0)="==============================="
^DIC(9.4,11,22,5.03,"PAH",27,1,93,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,94,0)="1. Restart any LA7V* HL v1.6 LLP's shutdown as part of the patch"
^DIC(9.4,11,22,5.03,"PAH",27,1,95,0)="installation process. Use the Start LLP [HL START] option to restart"
^DIC(9.4,11,22,5.03,"PAH",27,1,96,0)="LA7V* HL v1.6 LLP's."
^DIC(9.4,11,22,5.03,"PAH",27,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,98,0)=" "
^DIC(9.4,11,22,5.03,"PAH",27,1,99,0)="************************************************************************"
