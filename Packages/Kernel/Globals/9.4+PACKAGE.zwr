^DIC(9.4,60,22,13,"PAH",273,1,49,0)="              SIG: TAKE ONE-HALF TABLET BY MOUTH EVERY EVENING TESTING"
^DIC(9.4,60,22,13,"PAH",273,1,50,0)="                   FOR PATTESTING FOR PATIENT TESTING FOR PATTESTING"
^DIC(9.4,60,22,13,"PAH",273,1,51,0)="                   FOR PATIENTENT INTRUCTION ON SIG1 TESTING FOR"
^DIC(9.4,60,22,13,"PAH",273,1,52,0)="                   PATIENT INTRUCTION ON SIG1 TESTING FOR PATIENT"
^DIC(9.4,60,22,13,"PAH",273,1,53,0)="                   REPLACE IENT WITH IENT TESTING FOR PATIENT"
^DIC(9.4,60,22,13,"PAH",273,1,54,0)="+         Enter ?? for more actions"
^DIC(9.4,60,22,13,"PAH",273,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,56,0)="Select Action:Next Screen//"
^DIC(9.4,60,22,13,"PAH",273,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,58,0)="2. In the Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option,"
^DIC(9.4,60,22,13,"PAH",273,1,59,0)="   on the Patient Medication Profile screen, a new hidden ListMan action"
^DIC(9.4,60,22,13,"PAH",273,1,60,0)="   called DR [DISPLAY REMOTE] was added to display a patient's remote"
^DIC(9.4,60,22,13,"PAH",273,1,61,0)="   prescriptions."
^DIC(9.4,60,22,13,"PAH",273,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,63,0)="3. In the Complete Orders from OERR [PSO LMOE FINISH] option, if a user"
^DIC(9.4,60,22,13,"PAH",273,1,64,0)="   answer ""Yes"" to the prompt 'Do you want to see Medication Profile?',"
^DIC(9.4,60,22,13,"PAH",273,1,65,0)="   then if a patient has remote prescription(s), the user will be"
^DIC(9.4,60,22,13,"PAH",273,1,66,0)="   prompted with the following question."
^DIC(9.4,60,22,13,"PAH",273,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,68,0)="          REMOTE PRESCRIPTIONS AVAILABLE!"
^DIC(9.4,60,22,13,"PAH",273,1,69,0)="          Display Remote Data? N//"
^DIC(9.4,60,22,13,"PAH",273,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,71,0)="   If the response is ""No"", then there are no changes to the existing"
^DIC(9.4,60,22,13,"PAH",273,1,72,0)="   functionality. If the response is ""Yes"", then it provides a new screen"
^DIC(9.4,60,22,13,"PAH",273,1,73,0)="   as shown in item #1."
^DIC(9.4,60,22,13,"PAH",273,1,74,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,75,0)="4. In the Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE] COLUMN"
^DIC(9.4,60,22,13,"PAH",273,1,76,0)="   option, if a patient has remote prescription(s) then they are printed"
^DIC(9.4,60,22,13,"PAH",273,1,77,0)="   at the end of the report as shown in the following example."
^DIC(9.4,60,22,13,"PAH",273,1,78,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,79,0)="                     MEDICATION PROFILE FROM OTHER VAMC(s)          Page: 4"
^DIC(9.4,60,22,13,"PAH",273,1,80,0)="                            Date Printed: 12/22/2008"
^DIC(9.4,60,22,13,"PAH",273,1,81,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,82,0)="Patient: PSOPATIENT,ONE                                      DOB: 05/01/1955"
^DIC(9.4,60,22,13,"PAH",273,1,83,0)="==============================================================================="
^DIC(9.4,60,22,13,"PAH",273,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",273,1,85,0)="   RX #        DRUG                               ST  QTY  ISSUED   LAST"
^DIC(9.4,60,22,13,"PAH",273,1,86,0)="FILLED"
^DIC(9.4,60,22,13,"PAH",273,1,87,0)="==============================================================================="
