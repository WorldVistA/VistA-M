^DIC(9.4,35,22,3,"PAH",139,1,0)="^^2^2^3020906"
^DIC(9.4,35,22,3,"PAH",139,1,1,0)="This patch includes a API EN^ORBCMA2 required by BCMA V2. The #DBIA for "
^DIC(9.4,35,22,3,"PAH",139,1,2,0)="this API is 3616."
^DIC(9.4,35,22,3,"PAH",140,0)="155 SEQ #142^3020906^1"
^DIC(9.4,35,22,3,"PAH",140,1,0)="^^2^2^3020906"
^DIC(9.4,35,22,3,"PAH",140,1,1,0)="This patch is being released to turn off the spell checking functionality "
^DIC(9.4,35,22,3,"PAH",140,1,2,0)="based on input from the National Center for Patient Safety."
^DIC(9.4,35,22,3,"PAH",141,0)="143 SEQ #143^3021008^1"
^DIC(9.4,35,22,3,"PAH",142,0)="139 SEQ #144^3021008^1"
^DIC(9.4,35,22,3,"PAH",143,0)="152 SEQ #146^3021025^1"
^DIC(9.4,35,22,3,"PAH",143,1,0)="^^3^3^3021025"
^DIC(9.4,35,22,3,"PAH",143,1,1,0)="This patch is in support of the Hui/VHA CIO SD&D Pharmacy Data Interchange"
^DIC(9.4,35,22,3,"PAH",143,1,2,0)="project. The project provides a method for the one-way electronic transfer"
^DIC(9.4,35,22,3,"PAH",143,1,3,0)="of prescription orders from an external system to VistA."
^DIC(9.4,35,22,3,"PAH",144,0)="127 SEQ #147^3021108^1"
^DIC(9.4,35,22,3,"PAH",145,0)="161 SEQ #148^3021122^1"
^DIC(9.4,35,22,3,"PAH",145,1,0)="^^2^2^3021122"
^DIC(9.4,35,22,3,"PAH",145,1,1,0)="Fixes problem with November dates being interpreted as ""NOW"".  Please see "
^DIC(9.4,35,22,3,"PAH",145,1,2,0)="patch description on FORUM for complete details."
