^DIC(9.4,4,22,1,"PAH",96,1,6,0)="to ensure that the baskets are always in alphabet order."
^DIC(9.4,4,22,1,"PAH",96,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,8,0)="Example:"
^DIC(9.4,4,22,1,"PAH",96,1,9,0)="Before this patch, the xref looks like this:"
^DIC(9.4,4,22,1,"PAH",96,1,10,0)="^TMP(""XMLIST"",539496244,""BSKT"",""98 BASKET^10"",1) = "
^DIC(9.4,4,22,1,"PAH",96,1,11,0)="^TMP(""XMLIST"",539496244,""BSKT"",""DELIVERY^8"",2) = "
^DIC(9.4,4,22,1,"PAH",96,1,12,0)="^TMP(""XMLIST"",539496244,""BSKT"",""FREDOLINA^9"",3) = "
^DIC(9.4,4,22,1,"PAH",96,1,13,0)="^TMP(""XMLIST"",539496244,""BSKT"",""FRED^2"",11) =     < - not in alpha order!"
^DIC(9.4,4,22,1,"PAH",96,1,14,0)="^TMP(""XMLIST"",539496244,""BSKT"",""IN^1"",4) = "
^DIC(9.4,4,22,1,"PAH",96,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,16,0)="After this patch, the xref looks like this:"
^DIC(9.4,4,22,1,"PAH",96,1,17,0)="^TMP(""XMLIST"",539496244,""BSKT"",""98 BASKET"",1) = "
^DIC(9.4,4,22,1,"PAH",96,1,18,0)="^TMP(""XMLIST"",539496244,""BSKT"",""DELIVERY"",2) = "
^DIC(9.4,4,22,1,"PAH",96,1,19,0)="^TMP(""XMLIST"",539496244,""BSKT"",""FRED"",11) = "
^DIC(9.4,4,22,1,"PAH",96,1,20,0)="^TMP(""XMLIST"",539496244,""BSKT"",""FREDOLINA"",3) = "
^DIC(9.4,4,22,1,"PAH",96,1,21,0)="^TMP(""XMLIST"",539496244,""BSKT"",""IN"",4) = "
^DIC(9.4,4,22,1,"PAH",96,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,23,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",96,1,24,0)="is at a minimum.  It requires MailMan patch XM*7.1*115."
^DIC(9.4,4,22,1,"PAH",96,1,25,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",96,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,27,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",96,1,28,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",96,1,29,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",96,1,30,0)=" "
^DIC(9.4,4,22,1,"PAH",96,1,31,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",96,1,32,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",96,1,33,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",96,1,34,0)="XMXBSKT       12324702        12283844        50,106,115,126"
^DIC(9.4,4,22,1,"PAH",96,1,35,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,36,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",96,1,37,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,38,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",96,1,39,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",96,1,40,0)=" "
^DIC(9.4,4,22,1,"PAH",96,1,41,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",96,1,42,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",96,1,43,0)="is at a minimum.  It requires MailMan patch XM*7.1*115."
^DIC(9.4,4,22,1,"PAH",96,1,44,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",96,1,45,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",96,1,46,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",96,1,47,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",96,1,48,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",96,1,49,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",96,1,50,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",96,1,51,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",96,1,52,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",96,1,53,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",96,1,54,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",96,1,55,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",96,1,56,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",96,1,57,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",96,1,58,0)=" Select INSTALL NAME:    XM*7.1*126    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",96,1,59,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",96,1,60,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",96,1,61,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",96,1,62,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",96,1,63,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",96,1,64,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",96,1,65,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",96,1,66,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",96,1,67,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",96,1,68,0)=""
^DIC(9.4,4,22,1,"PAH",96,1,69,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",96,1,70,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",96,1,71,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",96,1,72,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",97,0)="110 SEQ #122^3000516^1"
^DIC(9.4,4,22,1,"PAH",97,1,0)="^^153^153^3000516"
^DIC(9.4,4,22,1,"PAH",97,1,1,0)="Patch XM*7.1*110"
^DIC(9.4,4,22,1,"PAH",97,1,2,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,3,0)="NOIS:  ALN-1199-12259"
^DIC(9.4,4,22,1,"PAH",97,1,4,0)="Test Site:  Albany, NY"
^DIC(9.4,4,22,1,"PAH",97,1,5,0)="When you save a new message to a different basket, it updates the last message"
^DIC(9.4,4,22,1,"PAH",97,1,6,0)="arrival date, and MailMan may tell you that a new message arrived, when it"
^DIC(9.4,4,22,1,"PAH",97,1,7,0)="really didn't.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",97,1,8,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,9,0)="NOIS:  DAY-0899-41718"
^DIC(9.4,4,22,1,"PAH",97,1,10,0)="Test Site:  Dayton, OH"
^DIC(9.4,4,22,1,"PAH",97,1,11,0)="Don't display user's DUZ when displaying a list of latered messages from which"
^DIC(9.4,4,22,1,"PAH",97,1,12,0)="to choose."
^DIC(9.4,4,22,1,"PAH",97,1,13,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,14,0)="NOIS:  ISD-0200-71796"
^DIC(9.4,4,22,1,"PAH",97,1,15,0)="Test Site:  CIOFO-Dallas"
^DIC(9.4,4,22,1,"PAH",97,1,16,0)="If you copy a PackMan or KIDS message and send it ""priority"", MailMan might"
^DIC(9.4,4,22,1,"PAH",97,1,17,0)="not recognize the copy as a PackMan or KIDS message.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",97,1,18,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,19,0)="NOIS:  TAM-0200-32595"
^DIC(9.4,4,22,1,"PAH",97,1,20,0)="Test Site:  Tampa, FL"
^DIC(9.4,4,22,1,"PAH",97,1,21,0)="The bulletin APIs SENDBULL^XMXAPI and TASKBULL^XMXAPI are changed so that"
^DIC(9.4,4,22,1,"PAH",97,1,22,0)="they don't insist on having XMBODY, which is an optional parameter."
^DIC(9.4,4,22,1,"PAH",97,1,23,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,24,0)="NOIS:  WAS-1299-20453"
^DIC(9.4,4,22,1,"PAH",97,1,25,0)="Test Site:  Washington, DC"
^DIC(9.4,4,22,1,"PAH",97,1,26,0)="If a scrambled message with no hint is sent to a remote site, MailMan does"
^DIC(9.4,4,22,1,"PAH",97,1,27,0)="not recognize that it is scrambled.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",97,1,28,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,29,0)="NOIS:  WBP-0100-21166"
^DIC(9.4,4,22,1,"PAH",97,1,30,0)="Test Site:  Wilkes Barre, PA"
^DIC(9.4,4,22,1,"PAH",97,1,31,0)="If you queue a range of messages to print later, and then delete the messages"
^DIC(9.4,4,22,1,"PAH",97,1,32,0)="you queued, MailMan won't print them.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",97,1,33,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,34,0)="E3R 12092, 13084 - Provide ""new toggle"" command to make messages new if"
^DIC(9.4,4,22,1,"PAH",97,1,35,0)="they're not new, and make them not new if they're new.  The command is ""NT""."
^DIC(9.4,4,22,1,"PAH",97,1,36,0)="Help frames have been updated to include the new command, and a new help"
^DIC(9.4,4,22,1,"PAH",97,1,37,0)="frame, XM-U-M-NEW-2, explains it.  New API: NTOGLMSG^XMXAPI"
^DIC(9.4,4,22,1,"PAH",97,1,38,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,39,0)="E3R 12169 - Provide a command to add the user's network signature to an"
^DIC(9.4,4,22,1,"PAH",97,1,40,0)="original message.  The command is ""NS"", and is available at the transmit"
^DIC(9.4,4,22,1,"PAH",97,1,41,0)="prompt when sending a new message.  It is also available when editing a"
^DIC(9.4,4,22,1,"PAH",97,1,42,0)="message sent only to oneself.  Help frames have been updated to include the"
^DIC(9.4,4,22,1,"PAH",97,1,43,0)="new command, and a new help frame, XM-U-M-NETWORK SIGNATURE, explains it."
^DIC(9.4,4,22,1,"PAH",97,1,44,0)="New API: NETSIG^XMXEDIT"
^DIC(9.4,4,22,1,"PAH",97,1,45,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,46,0)="E3R 13400 - Upon return from ANSWER, COPY, or WRITE command, redisplay"
^DIC(9.4,4,22,1,"PAH",97,1,47,0)="message header to make it clear that you are back at original message. "
^DIC(9.4,4,22,1,"PAH",97,1,48,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,49,0)="Additional enhancements:"
^DIC(9.4,4,22,1,"PAH",97,1,50,0)="- When editing a message the user has sent only to himself, the user may now"
^DIC(9.4,4,22,1,"PAH",97,1,51,0)="scramble or unscramble the message, and add his network signature to the"
^DIC(9.4,4,22,1,"PAH",97,1,52,0)="message, too."
^DIC(9.4,4,22,1,"PAH",97,1,53,0)="- When answering a message, if the user doesn't have a network signature,"
^DIC(9.4,4,22,1,"PAH",97,1,54,0)="MailMan now asks the user if he would like to create one."
^DIC(9.4,4,22,1,"PAH",97,1,55,0)="- Added entry and exit action to option XMEDITMG so that MailMan knows that"
^DIC(9.4,4,22,1,"PAH",97,1,56,0)="a user is interactively editing a mail group."
^DIC(9.4,4,22,1,"PAH",97,1,57,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,58,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",97,1,59,0)="minimum.  It requires FileMan patch DI*22.0*17 and MailMan patches XM*7.1*72,"
^DIC(9.4,4,22,1,"PAH",97,1,60,0)="XM*7.1*79, XM*7.1*95, XM*7.1*100, XM*7.1*101, and XM*7.1*121."
^DIC(9.4,4,22,1,"PAH",97,1,61,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",97,1,62,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,63,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",97,1,64,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",97,1,65,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",97,1,66,0)=" "
