^DIC(9.4,89,0)="PHARMACY PRESCRIPTION PRACTICE^PPP^3P"
^DIC(9.4,89,1,0)="^^4^4^2950407^^^^"
^DIC(9.4,89,1,1,0)="The Pharmacy Prescription Practices Package is a set of routines for"
^DIC(9.4,89,1,2,0)="determining whether a patient has visited other VAMC's and the making"
^DIC(9.4,89,1,3,0)="the prescription data from those facilities aviable to the local"
^DIC(9.4,89,1,4,0)="pharmacist"
^DIC(9.4,89,4,0)="^9.44PA^9^9"
^DIC(9.4,89,4,1,0)=1020.1
^DIC(9.4,89,4,1,222)="y^y^^n^^^n^m^y"
^DIC(9.4,89,4,2,0)=1020.2
^DIC(9.4,89,4,2,222)="y^y^^n^^^n^^n"
^DIC(9.4,89,4,3,0)=1020.3
^DIC(9.4,89,4,3,222)="y^y^^n^^^n"
^DIC(9.4,89,4,4,0)=1020.4
^DIC(9.4,89,4,4,222)="y^y^^n^^^n"
^DIC(9.4,89,4,5,0)=1020.5
^DIC(9.4,89,4,5,222)="y^y^^n^^^n"
^DIC(9.4,89,4,6,0)=1020.6
^DIC(9.4,89,4,6,222)="y^y^^n^^^y^o^n"
^DIC(9.4,89,4,7,0)=1020.7
^DIC(9.4,89,4,7,222)="y^y^^n^^^n"
^DIC(9.4,89,4,8,0)=1020.8
^DIC(9.4,89,4,8,222)="y^y^^n^^^n^^y"
^DIC(9.4,89,4,9,0)=394.61
^DIC(9.4,89,4,9,1,0)="^9.45A^1^1"
^DIC(9.4,89,4,9,1,1,0)="Current Status"
^DIC(9.4,89,4,9,1,"B","Current Status",1)=""
^DIC(9.4,89,4,9,222)="y^n^^n^^^n"
^DIC(9.4,89,4,"B",394.61,9)=""
^DIC(9.4,89,4,"B",1020.1,1)=""
^DIC(9.4,89,4,"B",1020.2,2)=""
^DIC(9.4,89,4,"B",1020.3,3)=""
^DIC(9.4,89,4,"B",1020.4,4)=""
^DIC(9.4,89,4,"B",1020.5,5)=""
^DIC(9.4,89,4,"B",1020.6,6)=""
^DIC(9.4,89,4,"B",1020.7,7)=""
^DIC(9.4,89,4,"B",1020.8,8)=""
^DIC(9.4,89,5)="ALBANY"
^DIC(9.4,89,7)="^^I"
^DIC(9.4,89,9)=""
^DIC(9.4,89,11)="1020^1022"
^DIC(9.4,89,22,0)="^9.49I^6^1"
^DIC(9.4,89,22,1,0)="1.0^3051119^2960722"
^DIC(9.4,89,22,1,"PAH",0)="^9.4901^19^19"
^DIC(9.4,89,22,1,"PAH",1,0)="11 SEQ #9^2971006^1"
^DIC(9.4,89,22,1,"PAH",1,1,0)="^^4^4^2971006"
^DIC(9.4,89,22,1,"PAH",1,1,1,0)=" This option has been modified to reduce the amount of indirection calls"
^DIC(9.4,89,22,1,"PAH",1,1,2,0)=" utilized in build the FOREIGN FACILTIY XREF File (#1020.2). Test sites"
^DIC(9.4,89,22,1,"PAH",1,1,3,0)=" for this patch have concluded that the new method reduces the time to"
^DIC(9.4,89,22,1,"PAH",1,1,4,0)=" build the file to 1/10th of the original process."
^DIC(9.4,89,22,1,"PAH",2,0)="16 SEQ #11^2971105^1"
^DIC(9.4,89,22,1,"PAH",2,1,0)="^^3^3^2971105"
^DIC(9.4,89,22,1,"PAH",2,1,1,0)="Prior to the final release of patch PPP*1.0*11, a Quit statement was inserted"
^DIC(9.4,89,22,1,"PAH",2,1,2,0)="into the routine while checking problems associated with the CD-Rom server."
^DIC(9.4,89,22,1,"PAH",2,1,3,0)="This line was left in the program by mistake."
^DIC(9.4,89,22,1,"PAH",3,0)="9 SEQ #12^2971127^1"
^DIC(9.4,89,22,1,"PAH",3,1,0)="^^4^4^2971127"
^DIC(9.4,89,22,1,"PAH",3,1,1,0)="This patch using KIDS will install the changes necessary in routine"
^DIC(9.4,89,22,1,"PAH",3,1,2,0)="PPPSCN2, to correct the problem of PDX requests being made daily on the"
^DIC(9.4,89,22,1,"PAH",3,1,3,0)="same patients. "
^DIC(9.4,89,22,1,"PAH",3,1,4,0)=" "
^DIC(9.4,89,22,1,"PAH",4,0)="8 SEQ #13^2971231^1"
^DIC(9.4,89,22,1,"PAH",4,1,0)="^^2^2^2971231"
^DIC(9.4,89,22,1,"PAH",4,1,1,0)=" This patch addresses the problems associated with entries in the "
^DIC(9.4,89,22,1,"PAH",4,1,2,0)=" INSTITUTION file (#4) not being dinummed."
^DIC(9.4,89,22,1,"PAH",5,0)="10 SEQ #14^2971231^1"
^DIC(9.4,89,22,1,"PAH",5,1,0)="^^11^11^2971231"
^DIC(9.4,89,22,1,"PAH",5,1,1,0)=" This patch corrects a problem of when more than one patient's information "
^DIC(9.4,89,22,1,"PAH",5,1,2,0)=" was requested in the Display Visits to other Facilities"
^DIC(9.4,89,22,1,"PAH",5,1,3,0)=" [PPP DISPLAY FOREIGN VISITS] option. "
^DIC(9.4,89,22,1,"PAH",5,1,4,0)=" "
^DIC(9.4,89,22,1,"PAH",5,1,5,0)=" A temporary global was still intact after each patient which would "
^DIC(9.4,89,22,1,"PAH",5,1,6,0)=" display the previous patient's data along with the current patient.  "
^DIC(9.4,89,22,1,"PAH",5,1,7,0)=" "
^DIC(9.4,89,22,1,"PAH",5,1,8,0)=" This also contributed to the problem of more than one patients' data "
^DIC(9.4,89,22,1,"PAH",5,1,9,0)=" being returned on the PPP -Medication Profiles. Warning messages are "
^DIC(9.4,89,22,1,"PAH",5,1,10,0)=" now displayed indicating if there are any differences in the patient's "
^DIC(9.4,89,22,1,"PAH",5,1,11,0)=" profile."
^DIC(9.4,89,22,1,"PAH",6,0)="19 SEQ #16^2980318^1"
^DIC(9.4,89,22,1,"PAH",6,1,0)="^^7^7^2980318"
^DIC(9.4,89,22,1,"PAH",6,1,1,0)="Patch 8 had a routine that was looking into the wrong file for a new"
^DIC(9.4,89,22,1,"PAH",6,1,2,0)="domain name."
^DIC(9.4,89,22,1,"PAH",6,1,3,0)="Also, the new look-up to get a station number from the PPP DOMAIN XREF"
^DIC(9.4,89,22,1,"PAH",6,1,4,0)="file (#1020.8), does not accept entries that have changed their station"
^DIC(9.4,89,22,1,"PAH",6,1,5,0)="numbers. Since this file is a pointer to the INSTITUTIONN file (#4), the"
^DIC(9.4,89,22,1,"PAH",6,1,6,0)="non-dinummed entries can not be located. Therefore we are changing the call"
^DIC(9.4,89,22,1,"PAH",6,1,7,0)="back to the INSTITUTION file (#4)."
^DIC(9.4,89,22,1,"PAH",7,0)="17 SEQ #19^2981214^1"
^DIC(9.4,89,22,1,"PAH",7,1,0)="^^14^14^2981214"
^DIC(9.4,89,22,1,"PAH",7,1,1,0)=" Patch PPP*1*11 which reduced the amount of time it takes to extract the"
^DIC(9.4,89,22,1,"PAH",7,1,2,0)=" CD-ROM patient data and build the PPP FOREIGN FACILITY X-REF file "
^DIC(9.4,89,22,1,"PAH",7,1,3,0)=" (#1020.2),  did not allow non-domain associated entries, therefore, when"
^DIC(9.4,89,22,1,"PAH",7,1,4,0)=" the PPP EDIT DOMAIN [Edit Unresolved Domain Entries] option is executed,"
^DIC(9.4,89,22,1,"PAH",7,1,5,0)=" no entries can be found."
^DIC(9.4,89,22,1,"PAH",7,1,6,0)=" "
^DIC(9.4,89,22,1,"PAH",7,1,7,0)=" This patch to that process will allow the entries without an associated"
^DIC(9.4,89,22,1,"PAH",7,1,8,0)=" domain to be entered into the file."
^DIC(9.4,89,22,1,"PAH",7,1,9,0)=" "
^DIC(9.4,89,22,1,"PAH",7,1,10,0)=" A new field has been added to the PPP DOMAIN XREF file (#1020.8), this"
^DIC(9.4,89,22,1,"PAH",7,1,11,0)=" field is called STATION NUMBER (#12). Currently the STATION field (.01)"
^DIC(9.4,89,22,1,"PAH",7,1,12,0)=" within this file is a pointer to the INSTITUTION file (#4). With the"
^DIC(9.4,89,22,1,"PAH",7,1,13,0)=" entries in the INSTITUTION file being changed sometimes, this new field"
^DIC(9.4,89,22,1,"PAH",7,1,14,0)=" will be the basis for collecting the proper data from the CD-ROM."
^DIC(9.4,89,22,1,"PAH",8,0)="21 SEQ #20^2990624^1"
^DIC(9.4,89,22,1,"PAH",8,1,0)="^^14^14^2990624"
^DIC(9.4,89,22,1,"PAH",8,1,1,0)="This patch provides more information to the error messages sent to"
^DIC(9.4,89,22,1,"PAH",8,1,2,0)="the user informing them of missing information about patients."
^DIC(9.4,89,22,1,"PAH",8,1,3,0)=" "
^DIC(9.4,89,22,1,"PAH",8,1,4,0)="Also, the date of the last build is now stored in the PPP Parameter file"
^DIC(9.4,89,22,1,"PAH",8,1,5,0)="(#1020.1), and a call to EN^DIQ1 was added to the functionality of routine"
^DIC(9.4,89,22,1,"PAH",8,1,6,0)="PPPGET1."
^DIC(9.4,89,22,1,"PAH",8,1,7,0)=" "
^DIC(9.4,89,22,1,"PAH",8,1,8,0)="Problems with the purge option not running to completion have been "
^DIC(9.4,89,22,1,"PAH",8,1,9,0)="re-programmed to execute faster. The previous use of Fileman deletion"
^DIC(9.4,89,22,1,"PAH",8,1,10,0)="of entries for 300,000 plus patients took too much system time."
^DIC(9.4,89,22,1,"PAH",8,1,11,0)=" "
^DIC(9.4,89,22,1,"PAH",8,1,12,0)="20JAN99 - the routine PPPGET3 had a coding mistake in it, that asked"
^DIC(9.4,89,22,1,"PAH",8,1,13,0)="for a code check to be done if the value of the variable was null. The"
^DIC(9.4,89,22,1,"PAH",8,1,14,0)="check should have been in place to check if the variable was NOT null."
^DIC(9.4,89,22,1,"PAH",9,0)="26 SEQ #25^3000816^1"
^DIC(9.4,89,22,1,"PAH",9,1,0)="^^22^22^3000816"
^DIC(9.4,89,22,1,"PAH",9,1,1,0)="1). Currently there are problems being reported with facilities trying "
^DIC(9.4,89,22,1,"PAH",9,1,2,0)="to create the FOREIGN FACILITY CROSS REFERENCE file (#1020.2). The "
^DIC(9.4,89,22,1,"PAH",9,1,3,0)="problem cannot be traced to either Pharmacy Prescription Practices or "
^DIC(9.4,89,22,1,"PAH",9,1,4,0)="Minimal Patient Dataset. The current process of extracting the Pharmacy "
^DIC(9.4,89,22,1,"PAH",9,1,5,0)="Prescription Practices data from the Minimal Patient Dataset CD-ROM "
^DIC(9.4,89,22,1,"PAH",9,1,6,0)="consists of transmitting all the selected social security numbers to the "
^DIC(9.4,89,22,1,"PAH",9,1,7,0)="CD-ROM, and then waiting for the visit data on each to be re-collected by"
^DIC(9.4,89,22,1,"PAH",9,1,8,0)="the PPP program before the file can be built. "
^DIC(9.4,89,22,1,"PAH",9,1,9,0)=" "
^DIC(9.4,89,22,1,"PAH",9,1,10,0)="The new method will transmit several hundred entries at a time. In this "
^DIC(9.4,89,22,1,"PAH",9,1,11,0)="manner, File #1020.2, can be built a little at a time. "
^DIC(9.4,89,22,1,"PAH",9,1,12,0)=" "
^DIC(9.4,89,22,1,"PAH",9,1,13,0)="2). When a new patient is entered, a MUMPS cross-reference is "
^DIC(9.4,89,22,1,"PAH",9,1,14,0)="executed which calls a PPP routine that adds the patient to PPP. "
^DIC(9.4,89,22,1,"PAH",9,1,15,0)="PPP then tries to find any visits to other facilities by trying to access "
^DIC(9.4,89,22,1,"PAH",9,1,16,0)="the MPD CD-ROM. If access cannot be obtained, an error bulletin is "
^DIC(9.4,89,22,1,"PAH",9,1,17,0)="generated. "
^DIC(9.4,89,22,1,"PAH",9,1,18,0)=" "
^DIC(9.4,89,22,1,"PAH",9,1,19,0)="Since the Prescription Practices Daily Batch Routine [PPP BATCH] option "
^DIC(9.4,89,22,1,"PAH",9,1,20,0)="is scheduled to run nightly to gather new patient data, the action taken "
^DIC(9.4,89,22,1,"PAH",9,1,21,0)="by the SOCIAL SECURITY NUMBER (#.09) field's cross-reference is not "
^DIC(9.4,89,22,1,"PAH",9,1,22,0)="needed."
^DIC(9.4,89,22,1,"PAH",10,0)="30 SEQ #27^3010228^1"
^DIC(9.4,89,22,1,"PAH",10,1,0)="^^2^2^3010228"
^DIC(9.4,89,22,1,"PAH",10,1,1,0)="See Patch PPP*1*30 in the National Patch Module for description of the"
^DIC(9.4,89,22,1,"PAH",10,1,2,0)="Build."
^DIC(9.4,89,22,1,"PAH",11,0)="32 SEQ #30^3010802^1"
^DIC(9.4,89,22,1,"PAH",11,1,0)="^^6^6^3010802"
^DIC(9.4,89,22,1,"PAH",11,1,1,0)=" Patch XM*7.1*51 restructured some domain names to XXX.DOMAIN.EXT for "
^DIC(9.4,89,22,1,"PAH",11,1,2,0)=" stations that requested it. When routine PPPPDX3 tries to locate the "
^DIC(9.4,89,22,1,"PAH",11,1,3,0)=" domain name, a null subscript error occurs at line PDXDDX+34."
^DIC(9.4,89,22,1,"PAH",11,1,4,0)=" "
^DIC(9.4,89,22,1,"PAH",11,1,5,0)=" To correct this problem, additional checks have been added to ensure"
^DIC(9.4,89,22,1,"PAH",11,1,6,0)=" a correct domain entry is located."
^DIC(9.4,89,22,1,"PAH",12,0)="35 SEQ #32^3020906^1"
^DIC(9.4,89,22,1,"PAH",12,1,0)="^^9^9^3020906"
^DIC(9.4,89,22,1,"PAH",12,1,1,0)=" The Pharmacy Prescription Practices (PPP) software relies on patient"
^DIC(9.4,89,22,1,"PAH",12,1,2,0)=" visit information provided quarterly by the Minimal Patient Dataset"
^DIC(9.4,89,22,1,"PAH",12,1,3,0)=" (MPD) CD-ROM. This CD is no longer distributed to facilities."
^DIC(9.4,89,22,1,"PAH",12,1,4,0)=" To ensure the continuing functionality of PPP, the method of acquiring"
^DIC(9.4,89,22,1,"PAH",12,1,5,0)=" patient visit history information must be changed. This enhancement"
^DIC(9.4,89,22,1,"PAH",12,1,6,0)=" updates the PPP software to use the Master Patient Index/Patient"
^DIC(9.4,89,22,1,"PAH",12,1,7,0)=" Demographics (MPI/PD) package files as the source of data. "
^DIC(9.4,89,22,1,"PAH",12,1,8,0)=" The MPI/PD package stores the same information required by PPP in the"
^DIC(9.4,89,22,1,"PAH",12,1,9,0)=" TREATING FACILITY LIST (#391.91) file."
^DIC(9.4,89,22,1,"PAH",13,0)="38 SEQ #33^3031023^1"
^DIC(9.4,89,22,1,"PAH",13,1,0)="^^3^3^3031023"
^DIC(9.4,89,22,1,"PAH",13,1,1,0)="This patch will modify the routine that does the daily update to the PPP "
^DIC(9.4,89,22,1,"PAH",13,1,2,0)="FOREIGN FACILITY XREF file (PPP(1020.2))."
^DIC(9.4,89,22,1,"PAH",13,1,3,0)="This patch will also update the file description for file 1020.2."
^DIC(9.4,89,22,1,"PAH",14,0)="37 SEQ #34^3041228^1"
^DIC(9.4,89,22,1,"PAH",14,1,0)="^^4^4^3041228"
^DIC(9.4,89,22,1,"PAH",14,1,1,0)="This patch updates the domain names in the Pharmacy Prescription Practice"
^DIC(9.4,89,22,1,"PAH",14,1,2,0)="(PPP) files. The files are: "
^DIC(9.4,89,22,1,"PAH",14,1,3,0)=" "
^DIC(9.4,89,22,1,"PAH",14,1,4,0)="PPP DOMAIN XREF (#1020.8) & PPP CONVERSION SITE (#1020.128)"
^DIC(9.4,89,22,1,"PAH",15,0)="39 SEQ #35^3060213^1"
^DIC(9.4,89,22,1,"PAH",15,1,0)="^^2^2^3060213"
^DIC(9.4,89,22,1,"PAH",15,1,1,0)=" This patch corrects the problem of using the incorrect IEN (Internal"
^DIC(9.4,89,22,1,"PAH",15,1,2,0)=" Entry Number) for the institution."
^DIC(9.4,89,22,1,"PAH",16,0)="41 SEQ #36^3060711^1"
^DIC(9.4,89,22,1,"PAH",16,1,0)="^^8^8^3060711"
^DIC(9.4,89,22,1,"PAH",16,1,1,0)="PPPBLD1A CHANGE VAR I TO PPPI TO PREVENT POSS UNDEF ERROR"
^DIC(9.4,89,22,1,"PAH",16,1,2,0)=" "
^DIC(9.4,89,22,1,"PAH",16,1,3,0)="PPPMPI MODIFY PPP BUILD FFX TO PREVENT DUPLICATE ENTRIES"
^DIC(9.4,89,22,1,"PAH",16,1,4,0)=" "
^DIC(9.4,89,22,1,"PAH",16,1,5,0)="PPPMPI UPDATE DATE OF LAST AUTO BUILD"
^DIC(9.4,89,22,1,"PAH",16,1,6,0)=" "
^DIC(9.4,89,22,1,"PAH",16,1,7,0)="PPPSCN2 MODIFY ROUTINE TO LOOK AT THE FILE 44.003 MULTIPLE INSTEAD OF "
^DIC(9.4,89,22,1,"PAH",16,1,8,0)="JUST THE FIRST ENTRY"
^DIC(9.4,89,22,1,"PAH",17,0)="42 SEQ #37^3071212.205557^1"
^DIC(9.4,89,22,1,"PAH",18,0)="43 SEQ #38^3090423.113219^17"
^DIC(9.4,89,22,1,"PAH",18,1,0)="^^5^5^3090423"
^DIC(9.4,89,22,1,"PAH",18,1,1,0)="All options within the Pharmacy Prescription Practices (PPP) "
^DIC(9.4,89,22,1,"PAH",18,1,2,0)="application will be marked Out Of Order, with the message "
^DIC(9.4,89,22,1,"PAH",18,1,3,0)="OPTION RETIRED BY PATCH PPP*1*43 AS PER PSI-07-114. "
^DIC(9.4,89,22,1,"PAH",18,1,4,0)="Additionally, the Outpatient Pharmacy application and AudioFax"
^DIC(9.4,89,22,1,"PAH",18,1,5,0)="will be modified to ignore all calls to the PPP applications."
^DIC(9.4,89,22,1,"PAH",19,0)="44 SEQ #39^3100105.165947^17"
^DIC(9.4,89,22,1,"PAH",19,1,0)="^^60^60^3100105"
^DIC(9.4,89,22,1,"PAH",19,1,1,0)="The FY09 Q4 Enhancement Release includes the retirement of the Pharmacy"
^DIC(9.4,89,22,1,"PAH",19,1,2,0)="Prescription Practices (PPP) V. 1.0 package. This is a follow-up patch for"
^DIC(9.4,89,22,1,"PAH",19,1,3,0)="the nationally released patch PPP*1*43 to resolve Patient Safety Issue"
^DIC(9.4,89,22,1,"PAH",19,1,4,0)="PSI-07-114. Per PSI-07-114, the PPP package does not provide the most"
^DIC(9.4,89,22,1,"PAH",19,1,5,0)="recent and up-to-date data on prescriptions from other sites. Patch"
^DIC(9.4,89,22,1,"PAH",19,1,6,0)="PPP*1*43 made the PPP options unavailable by marking them as 'Out of"
^DIC(9.4,89,22,1,"PAH",19,1,7,0)="Order'. This patch, PPP*1*44, will remove every component (see list below)"
^DIC(9.4,89,22,1,"PAH",19,1,8,0)="of the PPP package from sites."
^DIC(9.4,89,22,1,"PAH",19,1,9,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,10,0)="1. The following PPP options will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,11,0)="    PPP (EDIT) PARAMETER                PPP MAIN"
^DIC(9.4,89,22,1,"PAH",19,1,12,0)="    PPP BACKGROUND PURGE LOGFILE        PPP MERGED SITE EDIT"
^DIC(9.4,89,22,1,"PAH",19,1,13,0)="    PPP BACKGROUND PURGE XREF           PPP PRINT CLINIC PROFILES"
^DIC(9.4,89,22,1,"PAH",19,1,14,0)="    PPP BATCH                           PPP PRINT FFX"
^DIC(9.4,89,22,1,"PAH",19,1,15,0)="    PPP BUILD FFX                       PPP PRINT LOG"
^DIC(9.4,89,22,1,"PAH",19,1,16,0)="    PPP DISPLAY FOREIGN VISITS          PPP PRINT STATISTICS"
^DIC(9.4,89,22,1,"PAH",19,1,17,0)="    PPP EDIT DOMAIN                     PPP PURGE LOGFILE"
^DIC(9.4,89,22,1,"PAH",19,1,18,0)="    PPP EDIT FFX                        PPP PURGE LOGFILE MENU"
^DIC(9.4,89,22,1,"PAH",19,1,19,0)="    PPP INIT PURGE LOGFILE JOB          PPP PURGE XREF MENU"
^DIC(9.4,89,22,1,"PAH",19,1,20,0)="    PPP INIT PURGE XREF JOB             PPP XREF PURGE"
^DIC(9.4,89,22,1,"PAH",19,1,21,0)="    PPP INIT STAT"
^DIC(9.4,89,22,1,"PAH",19,1,22,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,23,0)="2. The PPP input template, PPP EDIT FILE, will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,24,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,25,0)="3. The PPP sort template, PPP LOGS, will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,26,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,27,0)="4. The following PPP list templates will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,28,0)="    PPP FFX DISPLAY    PPP LOG DISPL   PPP PROFILE           PPP VISITS"
^DIC(9.4,89,22,1,"PAH",19,1,29,0)="    PPP FFX REPORTS    PPP PRINT       PPP UNRESOLVED DOM    PPP XREF EDIT"
^DIC(9.4,89,22,1,"PAH",19,1,30,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,31,0)="5. The following PPP print templates will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,32,0)="    PPP CODE LIST      PPP LOGP"
^DIC(9.4,89,22,1,"PAH",19,1,33,0)="    PPP LOG            PPPSTAP"
^DIC(9.4,89,22,1,"PAH",19,1,34,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,35,0)="6. The following PPP protocols will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,36,0)="    PPP (MENU) DOM      PPP ADD FF ENTRY    PPP DEL FF ENTRY  PPP EDIT FF ENTRY"
^DIC(9.4,89,22,1,"PAH",19,1,37,0)="    PPP (MENU) FF XREF  PPP CHANGE ALL DOM  PPP DISPL BOTH"
^DIC(9.4,89,22,1,"PAH",19,1,38,0)="    PPP (MENU) VISITS   PPP CHANGE DOM      PPP DISPL OTHER"
^DIC(9.4,89,22,1,"PAH",19,1,39,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,40,0)="7. The PPP security key, PPP UTIL, will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,41,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,42,0)="8. All PPP standard routines will be removed. If after the patch is installed"
^DIC(9.4,89,22,1,"PAH",19,1,43,0)="   there are still routines starting with PPP then the site will be"
^DIC(9.4,89,22,1,"PAH",19,1,44,0)="   responsible for reviewing and deleting those routines."
^DIC(9.4,89,22,1,"PAH",19,1,45,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,46,0)="9. The following PPP files and data will be removed."
^DIC(9.4,89,22,1,"PAH",19,1,47,0)="    PPP PARAMETER File #1020.1              PPP EXCLUSION File #1020.5"
^DIC(9.4,89,22,1,"PAH",19,1,48,0)="    PPP CONVERSION SITE File #1020.128      PPP CODE File #1020.6"
^DIC(9.4,89,22,1,"PAH",19,1,49,0)="    PPP FOREIGN FACILITY XREF File #1020.2  PPP NEW SSN File #1020.7"
^DIC(9.4,89,22,1,"PAH",19,1,50,0)="    PPP STATISTIC File #1020.3              PPP DOMAIN XREF File #1020.8"
^DIC(9.4,89,22,1,"PAH",19,1,51,0)="    PPP LOG File #1020.4"
^DIC(9.4,89,22,1,"PAH",19,1,52,0)=" "
^DIC(9.4,89,22,1,"PAH",19,1,53,0)="10. A background job will be tasked when the patch is installed to remove"
^DIC(9.4,89,22,1,"PAH",19,1,54,0)="    the PPP files and data. Upon completion of the job, a MailMan message"
^DIC(9.4,89,22,1,"PAH",19,1,55,0)="    with the subject ""PPP Package Data & Data Dictionary Removal"" is"
^DIC(9.4,89,22,1,"PAH",19,1,56,0)="    generated showing a list of files that were deleted. If there are"
^DIC(9.4,89,22,1,"PAH",19,1,57,0)="    routines that begin with PPP that were not removed, then they will be"
^DIC(9.4,89,22,1,"PAH",19,1,58,0)="    listed in the message. These routines will need to be reviewed by IRM"
^DIC(9.4,89,22,1,"PAH",19,1,59,0)="    to determine if they should be removed."
^DIC(9.4,89,22,1,"PAH",19,1,60,0)=""
