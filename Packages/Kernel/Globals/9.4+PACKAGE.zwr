^DIC(9.4,77,22,17,"PAH",237,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",237,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",237,1,4,0)="-Cannot send data to ATC"
^DIC(9.4,77,22,17,"PAH",238,0)="283 SEQ #239^3130103.114637^17"
^DIC(9.4,77,22,17,"PAH",238,1,0)="^^5^5^3130103"
^DIC(9.4,77,22,17,"PAH",238,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",238,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",238,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",238,1,4,0)="-Invalid start time for lab orders"
^DIC(9.4,77,22,17,"PAH",238,1,5,0)="-<NOLINE> error when running Total Cost to Date report"
^DIC(9.4,77,22,17,"PAH",239,0)="285 SEQ #240^3130211.114946^17"
^DIC(9.4,77,22,17,"PAH",239,1,0)="^^6^6^3130211"
^DIC(9.4,77,22,17,"PAH",239,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",239,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",239,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",239,1,4,0)="-Invalid infusion rate error"
^DIC(9.4,77,22,17,"PAH",239,1,5,0)="-<UNDEFINED> error when editing day-of-week schedule admin times"
^DIC(9.4,77,22,17,"PAH",239,1,6,0)="-Invalid frequency for IV orders"
^DIC(9.4,77,22,17,"PAH",240,0)="268 SEQ #241^3130212.103855^17"
^DIC(9.4,77,22,17,"PAH",240,1,0)="^^13^13^3130212"
^DIC(9.4,77,22,17,"PAH",240,1,1,0)="This patch is designed and intended to ""decouple"" the automated dispensing"
^DIC(9.4,77,22,17,"PAH",240,1,2,0)="machine interface calls from the current Inpatient Medication (IP) package"
^DIC(9.4,77,22,17,"PAH",240,1,3,0)="routines. The interfaces calls are currently imbedded in regular ""patched"
^DIC(9.4,77,22,17,"PAH",240,1,4,0)="routines"" at the sites using a Pyxis, Omnicell, or McKesson automated"
^DIC(9.4,77,22,17,"PAH",240,1,5,0)="dispensing machine. This patch creates a new ""shell"" routine  (PSJADM) which"
^DIC(9.4,77,22,17,"PAH",240,1,6,0)=" interface calls can be added. The routines being affected by"
^DIC(9.4,77,22,17,"PAH",240,1,7,0)="""decoupling"" are PSGOEE, PSGOETO, PSGOEV, PSJHLV, PSJCOMR, and PSJOEA2. In"
^DIC(9.4,77,22,17,"PAH",240,1,8,0)="the past, anytime these routines were patched at the sites using one of the"
^DIC(9.4,77,22,17,"PAH",240,1,9,0)="machines listed above, the local modified routine(s) would have to be"
^DIC(9.4,77,22,17,"PAH",240,1,10,0)="backed up and saved before patching could occur. The local mods would be"
^DIC(9.4,77,22,17,"PAH",240,1,11,0)="lost otherwise. After patching, the patched routines would"
^DIC(9.4,77,22,17,"PAH",240,1,12,0)="have to be incorporated into the locally modified routines in order for the"
^DIC(9.4,77,22,17,"PAH",240,1,13,0)="automated dispensing machines to operate properly and appropriately."
^DIC(9.4,77,22,17,"PAH",241,0)="260 SEQ #242^3130212.103904^17"
^DIC(9.4,77,22,17,"PAH",242,0)="288 SEQ #243^3130212.10391^17"
^DIC(9.4,77,22,17,"PAH",243,0)="287 SEQ #244^3130416.102551^17"
^DIC(9.4,77,22,17,"PAH",243,1,0)="^^5^5^3130416"
^DIC(9.4,77,22,17,"PAH",243,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",243,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",243,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",243,1,4,0)="-Infinite loop for admin time edit                             "
^DIC(9.4,77,22,17,"PAH",243,1,5,0)="-IV order renewal with invalid schedule"
^DIC(9.4,77,22,17,"PAH",244,0)="228 SEQ #245^3130422.104456^17"
^DIC(9.4,77,22,17,"PAH",244,1,0)="^^7^7^3130422"
^DIC(9.4,77,22,17,"PAH",244,1,1,0)="The purpose of this patch is to provide software bug fixes for Inpatient "
^DIC(9.4,77,22,17,"PAH",244,1,2,0)="Medications.  This patch corrects the following issues:"
^DIC(9.4,77,22,17,"PAH",244,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",244,1,4,0)="1. Dispense Drug with multiple lines is not being highlighted."
^DIC(9.4,77,22,17,"PAH",244,1,5,0)=" "
^DIC(9.4,77,22,17,"PAH",244,1,6,0)="2. Print alignment problem for IV orders in Inpatient Order Entry "
^DIC(9.4,77,22,17,"PAH",244,1,7,0)="   [PSJ OE]."
^DIC(9.4,77,22,17,"PAH",245,0)="275 SEQ #246^3130529.120525^17"
^DIC(9.4,77,22,17,"PAH",245,1,0)="^^196^196^3130529"
^DIC(9.4,77,22,17,"PAH",245,1,1,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,2,0)="Edit Clinic Med Orders Start Date/Time"
^DIC(9.4,77,22,17,"PAH",245,1,3,0)="======================================"
^DIC(9.4,77,22,17,"PAH",245,1,4,0)="This patch implements a new Vista option that allows users to"
^DIC(9.4,77,22,17,"PAH",245,1,5,0)="quickly find clinic orders that are associated with a specific"
^DIC(9.4,77,22,17,"PAH",245,1,6,0)="clinic location (or specific patient), and date range, and quickly "
^DIC(9.4,77,22,17,"PAH",245,1,7,0)="change the Start Date/Time of one or more selected clinic orders."
^DIC(9.4,77,22,17,"PAH",245,1,8,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,9,0)="The new option EDIT CLINIC MED ORDERS START DATE/TIME [PSJ ECO] allows"
^DIC(9.4,77,22,17,"PAH",245,1,10,0)="the user to search for clinic orders by clinic group, clinic, or by"
^DIC(9.4,77,22,17,"PAH",245,1,11,0)="patient. After entering a clinic group, clinic, or patient, a beginning"
^DIC(9.4,77,22,17,"PAH",245,1,12,0)="and ending date range must be entered to find orders with a start"
^DIC(9.4,77,22,17,"PAH",245,1,13,0)="date/time within the specified range."
^DIC(9.4,77,22,17,"PAH",245,1,14,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,15,0)="When searching by clinic, all patients with at least one clinic order"
^DIC(9.4,77,22,17,"PAH",245,1,16,0)="for the specified clinic and date range are displayed in a list, and"
^DIC(9.4,77,22,17,"PAH",245,1,17,0)="one or more patients may be selected from the list. After a patient is"
^DIC(9.4,77,22,17,"PAH",245,1,18,0)="selected, only clinic orders matching the specified clinic and date range "
^DIC(9.4,77,22,17,"PAH",245,1,19,0)="are displayed."
^DIC(9.4,77,22,17,"PAH",245,1,20,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,21,0)="When searching by clinic group, all patients with at least one clinic "
^DIC(9.4,77,22,17,"PAH",245,1,22,0)="order in the specified clinic group are displayed in a list, and one or"
^DIC(9.4,77,22,17,"PAH",245,1,23,0)="more patients may be selected from the list. After a patient is selected,"
^DIC(9.4,77,22,17,"PAH",245,1,24,0)="only the clinic orders matching the specified clinic group and date range "
^DIC(9.4,77,22,17,"PAH",245,1,25,0)="are displayed."
^DIC(9.4,77,22,17,"PAH",245,1,26,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,27,0)="When searching by patient, clinic location is not specified, therefore, "
^DIC(9.4,77,22,17,"PAH",245,1,28,0)="all clinic orders within the selected date range are displayed, for "
^DIC(9.4,77,22,17,"PAH",245,1,29,0)="all clinic locations."
^DIC(9.4,77,22,17,"PAH",245,1,30,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,31,0)="For searches by clinic and by patient, from the clinic profile view, "
^DIC(9.4,77,22,17,"PAH",245,1,32,0)="one or more clinic orders may be selected for start date/time editing."
^DIC(9.4,77,22,17,"PAH",245,1,33,0)="The new start date/time is entered once, and applied to all selected"
^DIC(9.4,77,22,17,"PAH",245,1,34,0)="clinic orders. "
^DIC(9.4,77,22,17,"PAH",245,1,35,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,36,0)="Two new actions are available from the clinic profile view: VP (View"
^DIC(9.4,77,22,17,"PAH",245,1,37,0)="Profile), and VD (View Details). The VP (View Profile) action displays "
^DIC(9.4,77,22,17,"PAH",245,1,38,0)="the full Inpatient medication profile, and the VD (View Details) action"
^DIC(9.4,77,22,17,"PAH",245,1,39,0)="prompts for a specific clinic order from the numbered list, and"
^DIC(9.4,77,22,17,"PAH",245,1,40,0)="displays the detailed view of the order."
^DIC(9.4,77,22,17,"PAH",245,1,41,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,42,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,43,0)="Patient Profile Clinic Orders"
^DIC(9.4,77,22,17,"PAH",245,1,44,0)="============================="
^DIC(9.4,77,22,17,"PAH",245,1,45,0)="Clinic Orders will display in the patient profile grouped by Clinic, "
^DIC(9.4,77,22,17,"PAH",245,1,46,0)="separate from non-Clinic Orders. Clinic Orders will display after all "
^DIC(9.4,77,22,17,"PAH",245,1,47,0)="active, pending, and non-verified non-Clinic Orders. Non-Active "
^DIC(9.4,77,22,17,"PAH",245,1,48,0)="non-Clinic orders will display after Clinic Orders."
^DIC(9.4,77,22,17,"PAH",245,1,49,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,50,0)="The following menu options, and any actions that execute these options,"
^DIC(9.4,77,22,17,"PAH",245,1,51,0)="will be enhanced to separate clinic orders from non-clinic orders:"
^DIC(9.4,77,22,17,"PAH",245,1,52,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,53,0)="      Inpatient Order Entry [PSJ OE] "
^DIC(9.4,77,22,17,"PAH",245,1,54,0)="      Order Entry [PSJU NE] "
^DIC(9.4,77,22,17,"PAH",245,1,55,0)="      Non-Verified/Pending Orders [PSJU VBW] "
^DIC(9.4,77,22,17,"PAH",245,1,56,0)="      Order Entry (IV) [PSJI ORDER] "
^DIC(9.4,77,22,17,"PAH",245,1,57,0)="      Patient Profile (IV) [PSJI PROFILE]"
^DIC(9.4,77,22,17,"PAH",245,1,58,0)="      Action Profile  #1 [PSJU AP-1] "
^DIC(9.4,77,22,17,"PAH",245,1,59,0)="      Action Profile #2  [PSJU AP-2]"
^DIC(9.4,77,22,17,"PAH",245,1,60,0)="      Patient Profile (Unit Dose) [PSJU PR]"
^DIC(9.4,77,22,17,"PAH",245,1,61,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,62,0)=" "
^DIC(9.4,77,22,17,"PAH",245,1,63,0)="Patch Components"
^DIC(9.4,77,22,17,"PAH",245,1,64,0)="================"
^DIC(9.4,77,22,17,"PAH",245,1,65,0)=" "
