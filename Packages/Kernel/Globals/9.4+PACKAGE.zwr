^DIC(9.4,53,22,20,"PAH",260,1,204,0)="------------------    -------------------     --------------------"
^DIC(9.4,53,22,20,"PAH",260,1,205,0)="N/A"
^DIC(9.4,53,22,20,"PAH",260,1,206,0)=" "
