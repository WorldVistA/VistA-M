^DIC(9.4,13,22,8,"PAH",18,1,147,0)="  DICF           8504495         8884337         20"
^DIC(9.4,13,22,8,"PAH",18,1,148,0)="  DICF2          8940451         9016160         4,20"
^DIC(9.4,13,22,8,"PAH",18,1,149,0)="  DICL2          4796448         4973816         20"
^DIC(9.4,13,22,8,"PAH",18,1,150,0)="  DICM           8330209         8458025         4,20"
^DIC(9.4,13,22,8,"PAH",18,1,151,0)="  DICM0          9037748         9043441         16,4,20"
^DIC(9.4,13,22,8,"PAH",18,1,152,0)="  DICM1          6170473         6277445         20"
^DIC(9.4,13,22,8,"PAH",18,1,153,0)="  DICM3          4576635         4769867         16,4,20"
^DIC(9.4,13,22,8,"PAH",18,1,154,0)="  DICUIX         7050873         7091249         20"
^DIC(9.4,13,22,8,"PAH",18,1,155,0)="  DIKCFORM      10827227        10615684         20"
^DIC(9.4,13,22,8,"PAH",18,1,156,0)="  DIKCP1         7463319         7673038         20"
^DIC(9.4,13,22,8,"PAH",18,1,157,0)="  DINIT0F1       5527731         5526766         20"
^DIC(9.4,13,22,8,"PAH",18,1,158,0)="  DINIT0FA       7807085         9430600         20"
^DIC(9.4,13,22,8,"PAH",18,1,159,0)="  DINIT0FB       9020615        10086109         20"
^DIC(9.4,13,22,8,"PAH",18,1,160,0)="  DINIT2A3      13176711        14045038         1,20"
^DIC(9.4,13,22,8,"PAH",18,1,161,0)="  DINIT2A4       9326344        10531062         1,20"
^DIC(9.4,13,22,8,"PAH",18,1,162,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,163,0)="  "
^DIC(9.4,13,22,8,"PAH",18,1,164,0)="Installation Instructions: "
^DIC(9.4,13,22,8,"PAH",18,1,165,0)="=========================="
^DIC(9.4,13,22,8,"PAH",18,1,166,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to be "
^DIC(9.4,13,22,8,"PAH",18,1,167,0)="STOPPED.  Failure to do so may result in a 'source routine edited' error, the"
^DIC(9.4,13,22,8,"PAH",18,1,168,0)="edits will be lost and records may be left in an inconsistent state.  "
^DIC(9.4,13,22,8,"PAH",18,1,169,0)="** "
^DIC(9.4,13,22,8,"PAH",18,1,170,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,171,0)="     1.  AXP sites: Review your mapped routine set.  If any of the routine(s)"
^DIC(9.4,13,22,8,"PAH",18,1,172,0)="listed in the ROUTINE SUMMARY section are mapped, they should be removed from"
^DIC(9.4,13,22,8,"PAH",18,1,173,0)="the mapped set at this time.  "
^DIC(9.4,13,22,8,"PAH",18,1,174,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,175,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This "
^DIC(9.4,13,22,8,"PAH",18,1,176,0)="option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,8,"PAH",18,1,177,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,178,0)="         The environment check routine DIENVWRN will run automatically.  "
^DIC(9.4,13,22,8,"PAH",18,1,179,0)="Routine DIENVWRN is sent in order to prevent the inadvertent queuing during the"
^DIC(9.4,13,22,8,"PAH",18,1,180,0)="installation of this patch.  "
^DIC(9.4,13,22,8,"PAH",18,1,181,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,182,0)="     3.  The patch has now been loaded into a transport global on your system. "
^DIC(9.4,13,22,8,"PAH",18,1,183,0)="You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,8,"PAH",18,1,184,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,185,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,8,"PAH",18,1,186,0)="options: "
^DIC(9.4,13,22,8,"PAH",18,1,187,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,188,0)="            Print Transport Global "
^DIC(9.4,13,22,8,"PAH",18,1,189,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,8,"PAH",18,1,190,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,8,"PAH",18,1,191,0)="            Backup a Transport Global "
^DIC(9.4,13,22,8,"PAH",18,1,192,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,193,0)="     5.  Inhibit users' login into the system.  The consequence of having users"
^DIC(9.4,13,22,8,"PAH",18,1,194,0)="on the system while installing this patch are that users editing records will"
^DIC(9.4,13,22,8,"PAH",18,1,195,0)="get a 'source routine edited' error, the edits will be lost and records may be"
^DIC(9.4,13,22,8,"PAH",18,1,196,0)="left in an inconsistent state.  Note that most of these routines are heavily"
^DIC(9.4,13,22,8,"PAH",18,1,197,0)="used in DHCP applications.  "
^DIC(9.4,13,22,8,"PAH",18,1,198,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,199,0)="     6.  AXP Sites - Place TaskMan in a WAIT State.  "
^DIC(9.4,13,22,8,"PAH",18,1,200,0)="         OpenM/Cache Sites - STOP TaskMan.  "
^DIC(9.4,13,22,8,"PAH",18,1,201,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,202,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,13,22,8,"PAH",18,1,203,0)="option: "
^DIC(9.4,13,22,8,"PAH",18,1,204,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,205,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,8,"PAH",18,1,206,0)="            Select INSTALL NAME: DI*22.0*20"
^DIC(9.4,13,22,8,"PAH",18,1,207,0)="                                 =========="
^DIC(9.4,13,22,8,"PAH",18,1,208,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,209,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,13,22,8,"PAH",18,1,210,0)="Protocols? "
^DIC(9.4,13,22,8,"PAH",18,1,211,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,212,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,213,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map set,"
^DIC(9.4,13,22,8,"PAH",18,1,214,0)="if necessary.  "
^DIC(9.4,13,22,8,"PAH",18,1,215,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,216,0)="     9.  AXP Sites - Remove TaskMan from WAIT State.  "
^DIC(9.4,13,22,8,"PAH",18,1,217,0)="         OpenM/Cache Sites - Restart TaskMan.  "
^DIC(9.4,13,22,8,"PAH",18,1,218,0)=" "
^DIC(9.4,13,22,8,"PAH",18,1,219,0)="    10.  Enable users' login.  "
^DIC(9.4,13,22,8,"PAH",19,0)="29 SEQ #19^3000229^1"
^DIC(9.4,13,22,8,"PAH",19,1,0)="^^2^2^3000229"
^DIC(9.4,13,22,8,"PAH",19,1,1,0)="See patch DI*22*29 in the National Patch Module for complete information"
^DIC(9.4,13,22,8,"PAH",19,1,2,0)="on this patch."
^DIC(9.4,13,22,8,"PAH",20,0)="8 SEQ #20^3000229^1"
^DIC(9.4,13,22,8,"PAH",20,1,0)="^^2^2^3000229"
^DIC(9.4,13,22,8,"PAH",20,1,1,0)="See patch DI*22*8 in the National Patch Module on FORUM for complete"
^DIC(9.4,13,22,8,"PAH",20,1,2,0)="information on this patch."
