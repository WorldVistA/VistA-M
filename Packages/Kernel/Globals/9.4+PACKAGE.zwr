^DIC(9.4,3,22,21,"PAH",208,1,207,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",208,1,208,0)="                Special Post Installation Instructions"
^DIC(9.4,3,22,21,"PAH",208,1,209,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",208,1,210,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,211,0)="        For Those Sites Who ARE NOT part of the Hui/VHA OI SD&D "
^DIC(9.4,3,22,21,"PAH",208,1,212,0)="Pharmacy                        "
^DIC(9.4,3,22,21,"PAH",208,1,213,0)="Data Interchange project, no further action is necessary."
^DIC(9.4,3,22,21,"PAH",208,1,214,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,215,0)="========================================================================"
^DIC(9.4,3,22,21,"PAH",208,1,216,0)="        For Those Sites Who ARE part of the Hui/VHA OI SD&D Pharmacy Data "
^DIC(9.4,3,22,21,"PAH",208,1,217,0)="Interchange project, perform the following steps:"
^DIC(9.4,3,22,21,"PAH",208,1,218,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,219,0)="Part 1: Removal of the 'DISABLE' message so the Protocols will launch:"
^DIC(9.4,3,22,21,"PAH",208,1,220,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,221,0)=">D Q^DI "
^DIC(9.4,3,22,21,"PAH",208,1,222,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,223,0)="VA FileMan 22.0"
^DIC(9.4,3,22,21,"PAH",208,1,224,0)="  "
^DIC(9.4,3,22,21,"PAH",208,1,225,0)="Select OPTION: ENTER OR EDIT FILE ENTRIES  "
^DIC(9.4,3,22,21,"PAH",208,1,226,0)="  "
^DIC(9.4,3,22,21,"PAH",208,1,227,0)="INPUT TO WHAT FILE: PROTOCOL// "
^DIC(9.4,3,22,21,"PAH",208,1,228,0)="EDIT WHICH FIELD: ALL// DISABLE  "
^DIC(9.4,3,22,21,"PAH",208,1,229,0)="THEN EDIT FIELD: "
^DIC(9.4,3,22,21,"PAH",208,1,230,0)="  "
^DIC(9.4,3,22,21,"PAH",208,1,231,0)="Select PROTOCOL NAME: XUHUI"
^DIC(9.4,3,22,21,"PAH",208,1,232,0)="     1   XUHUI FIELD CHANGE EVENT       Field Change Event  "
^DIC(9.4,3,22,21,"PAH",208,1,233,0)="     2   XUHUI MFK         "
^DIC(9.4,3,22,21,"PAH",208,1,234,0)="     3   XUHUI MFN         "
^DIC(9.4,3,22,21,"PAH",208,1,235,0)="     4   XUHUI SEND HL7 MESSAGE       Send HL7 MFN message  "
^DIC(9.4,3,22,21,"PAH",208,1,236,0)="     5   XUHUI SEND MESSAGE       Send Notification Message  "
^DIC(9.4,3,22,21,"PAH",208,1,237,0)="CHOOSE 1-5: 1  XUHUI FIELD CHANGE EVENT     Field Change Event  "
^DIC(9.4,3,22,21,"PAH",208,1,238,0)="DISABLE: *Do not remove this message  Replace @"
^DIC(9.4,3,22,21,"PAH",208,1,239,0)="   SURE YOU WANT TO DELETE? Y  (Yes)"
^DIC(9.4,3,22,21,"PAH",208,1,240,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,241,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,242,0)="Select PROTOCOL NAME: XUHUI"
^DIC(9.4,3,22,21,"PAH",208,1,243,0)="     1   XUHUI FIELD CHANGE EVENT       Field Change Event  "
^DIC(9.4,3,22,21,"PAH",208,1,244,0)="     2   XUHUI MFK         "
^DIC(9.4,3,22,21,"PAH",208,1,245,0)="     3   XUHUI MFN         "
^DIC(9.4,3,22,21,"PAH",208,1,246,0)="     4   XUHUI SEND HL7 MESSAGE       Send HL7 MFN message  "
^DIC(9.4,3,22,21,"PAH",208,1,247,0)="     5   XUHUI SEND MESSAGE       Send Notification Message  "
^DIC(9.4,3,22,21,"PAH",208,1,248,0)="CHOOSE 1-5: 4  XUHUI SEND HL7 MESSAGE     Send HL7 MFN message  "
^DIC(9.4,3,22,21,"PAH",208,1,249,0)="DISABLE: *Do not remove this message  Replace @"
^DIC(9.4,3,22,21,"PAH",208,1,250,0)="   SURE YOU WANT TO DELETE? Y  (Yes) "
^DIC(9.4,3,22,21,"PAH",208,1,251,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,252,0)="Part 2: Enabling AUTOSTART in the HUI PROV logical link:"
^DIC(9.4,3,22,21,"PAH",208,1,253,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,254,0)="INPUT TO WHAT FILE: PROTOCOL// HL LOGICAL LINK    (205 entries)"
^DIC(9.4,3,22,21,"PAH",208,1,255,0)="EDIT WHICH FIELD: ALL// AUTOSTART  "
^DIC(9.4,3,22,21,"PAH",208,1,256,0)="THEN EDIT FIELD: "
^DIC(9.4,3,22,21,"PAH",208,1,257,0)=" "
