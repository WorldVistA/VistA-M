^DIC(9.4,49,22,10,"PAH",391,1,168,0)=" Documentation Retrieval Instructions:"
^DIC(9.4,49,22,10,"PAH",391,1,169,0)=" -------------------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,170,0)=" Updated documentation describing the new functionality introduced by this"
^DIC(9.4,49,22,10,"PAH",391,1,171,0)=" patch is available."
^DIC(9.4,49,22,10,"PAH",391,1,172,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,173,0)=" The preferred method is to FTP the files from ftp://download.vista.domain.ext/"
^DIC(9.4,49,22,10,"PAH",391,1,174,0)=" This transmits the files from the first available FTP server. Sites may also"
^DIC(9.4,49,22,10,"PAH",391,1,175,0)=" elect to retrieve software directly from a specific server as follows:"
^DIC(9.4,49,22,10,"PAH",391,1,176,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,177,0)="   Albany         ftp.fo-albany.domain.ext  <ftp://ftp.fo-albany.domain.ext>"
^DIC(9.4,49,22,10,"PAH",391,1,178,0)="   Hines          ftp.fo-hines.domain.ext   <ftp://ftp.fo-hines.domain.ext>"
^DIC(9.4,49,22,10,"PAH",391,1,179,0)="   Salt Lake City ftp.fo-slc.domain.ext     <ftp://ftp.fo-slc.domain.ext>"
^DIC(9.4,49,22,10,"PAH",391,1,180,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,181,0)="  The documentation will be in the form of Adobe Acrobat files."
^DIC(9.4,49,22,10,"PAH",391,1,182,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,183,0)="  Documentation can also be found on the VA Software Documentation Library"
^DIC(9.4,49,22,10,"PAH",391,1,184,0)="  at: http://www4.domain.ext/vdl/"
^DIC(9.4,49,22,10,"PAH",391,1,185,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,186,0)="  File Description                          File Name             FTP Mode"
^DIC(9.4,49,22,10,"PAH",391,1,187,0)="  --------------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,188,0)="  Fee Basis User Manual                     fb3_5um.pdf           Binary"
^DIC(9.4,49,22,10,"PAH",391,1,189,0)="  PIMS v5.3 ADT User Manual Registration    dg_5_3_reg_um.pdf     Binary"
^DIC(9.4,49,22,10,"PAH",391,1,190,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,191,0)=" The procedure guide, Care for Newborn of Women Veterans, located at"
^DIC(9.4,49,22,10,"PAH",391,1,192,0)=" http://nonvacare.hac.domain.ext/policy-programs/procedure-guides.asp,"
^DIC(9.4,49,22,10,"PAH",391,1,193,0)=" should be distributed to those personnel registering newborns and/or"
^DIC(9.4,49,22,10,"PAH",391,1,194,0)=" processing newborn claims."
^DIC(9.4,49,22,10,"PAH",391,1,195,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,196,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,197,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,198,0)="  Patch Installation:"
^DIC(9.4,49,22,10,"PAH",391,1,199,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,200,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,201,0)=" Pre/Post Installation Overview"
^DIC(9.4,49,22,10,"PAH",391,1,202,0)=" ------------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,203,0)=" There are three post installation routines associated with this patch"
^DIC(9.4,49,22,10,"PAH",391,1,204,0)=" DG867PO, FB146PO, and IB499PO. These routines primarily serve as filters for"
^DIC(9.4,49,22,10,"PAH",391,1,205,0)=" the data transmitted to the appropriate files listed above, so that only the"
^DIC(9.4,49,22,10,"PAH",391,1,206,0)=" intended data is delivered. The only exception is the IB499PO routine which"
^DIC(9.4,49,22,10,"PAH",391,1,207,0)=" programmatically makes an addition to the help text of the FAMILY PREFIX"
^DIC(9.4,49,22,10,"PAH",391,1,208,0)=" field(#.03) in the SPONSOR RELATIONSHIP file (#355.81). These post"
^DIC(9.4,49,22,10,"PAH",391,1,209,0)=" installation routines may be deleted after successful installation of the"
^DIC(9.4,49,22,10,"PAH",391,1,210,0)=" NEWBORN DG FB IB BUNDLE 1.0."
^DIC(9.4,49,22,10,"PAH",391,1,211,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,212,0)=" Installation Instructions"
^DIC(9.4,49,22,10,"PAH",391,1,213,0)=" -------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,214,0)=" This patch may be installed with users on the system although it is"
^DIC(9.4,49,22,10,"PAH",391,1,215,0)=" recommended that it be installed during non-peak hours to minimize potential"
^DIC(9.4,49,22,10,"PAH",391,1,216,0)=" disruption to users. This patch should take less than 5 minutes to install."
^DIC(9.4,49,22,10,"PAH",391,1,217,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,218,0)=" FB*3.5*147 is a required patch and must be installed before DG*5.3*867."
^DIC(9.4,49,22,10,"PAH",391,1,219,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,220,0)=" DG*5.3*867 is one of three patches for this release (including FB*3.5*146 and"
^DIC(9.4,49,22,10,"PAH",391,1,221,0)=" IB*2.0*499). The patches will be installed as a bundle in the following order:"
^DIC(9.4,49,22,10,"PAH",391,1,222,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,223,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,224,0)=" 1) DG*5.3*867"
^DIC(9.4,49,22,10,"PAH",391,1,225,0)=" 2) FB*3.5*146"
^DIC(9.4,49,22,10,"PAH",391,1,226,0)=" 3) IB*2.0*499"
^DIC(9.4,49,22,10,"PAH",391,1,227,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,228,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,229,0)="  Pre-Installation Instructions"
^DIC(9.4,49,22,10,"PAH",391,1,230,0)="  -----------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,231,0)="  1.  OBTAIN PATCHES"
^DIC(9.4,49,22,10,"PAH",391,1,232,0)="      --------------"
^DIC(9.4,49,22,10,"PAH",391,1,233,0)=" Obtain the host file NEWBORN_1_2_DG_FB_IB.KID which contains the following"
^DIC(9.4,49,22,10,"PAH",391,1,234,0)=" patches:"
^DIC(9.4,49,22,10,"PAH",391,1,235,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,236,0)="  DG*5.3*867"
^DIC(9.4,49,22,10,"PAH",391,1,237,0)="  FB*3.5*146"
^DIC(9.4,49,22,10,"PAH",391,1,238,0)="  IB*2.0*499"
^DIC(9.4,49,22,10,"PAH",391,1,239,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,240,0)=" Sites can retrieve VistA software from the following FTP addresses.  The"
^DIC(9.4,49,22,10,"PAH",391,1,241,0)=" preferred method is to FTP the files from:"
^DIC(9.4,49,22,10,"PAH",391,1,242,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,243,0)="                      download.vista.domain.ext"
^DIC(9.4,49,22,10,"PAH",391,1,244,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,245,0)=" This will transmit the files from the first available FTP server. Sites may"
^DIC(9.4,49,22,10,"PAH",391,1,246,0)=" also elect to retrieve software directly from a specific server as follows:"
^DIC(9.4,49,22,10,"PAH",391,1,247,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,248,0)="         Albany                  ftp.fo-albany.domain.ext"
^DIC(9.4,49,22,10,"PAH",391,1,249,0)="         Hines                   ftp.fo-hines.domain.ext"
^DIC(9.4,49,22,10,"PAH",391,1,250,0)="         Salt Lake City          ftp.fo-slc.domain.ext"
^DIC(9.4,49,22,10,"PAH",391,1,251,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,252,0)=" The NEWBORN_1_2_DG_FB_IB.KID host file is located in the anonymous.software"
^DIC(9.4,49,22,10,"PAH",391,1,253,0)=" directory. Use ASCII Mode when downloading the file."
^DIC(9.4,49,22,10,"PAH",391,1,254,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,255,0)="  2.  START UP KIDS"
^DIC(9.4,49,22,10,"PAH",391,1,256,0)="      -------------"
^DIC(9.4,49,22,10,"PAH",391,1,257,0)="      Start up the Kernel Installation and Distribution System Menu option"
^DIC(9.4,49,22,10,"PAH",391,1,258,0)="      [XPD MAIN]:"
^DIC(9.4,49,22,10,"PAH",391,1,259,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,260,0)="           Edits and Distribution ..."
^DIC(9.4,49,22,10,"PAH",391,1,261,0)="           Utilities ..."
^DIC(9.4,49,22,10,"PAH",391,1,262,0)="           Installation ..."
^DIC(9.4,49,22,10,"PAH",391,1,263,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,264,0)="      Select Kernel Installation & Distribution System Option: Installation"
^DIC(9.4,49,22,10,"PAH",391,1,265,0)="                                                               ---"
^DIC(9.4,49,22,10,"PAH",391,1,266,0)="           Load a Distribution"
^DIC(9.4,49,22,10,"PAH",391,1,267,0)="           Print Transport Global"
^DIC(9.4,49,22,10,"PAH",391,1,268,0)="           Compare Transport Global to Current System"
^DIC(9.4,49,22,10,"PAH",391,1,269,0)="           Verify Checksums in Transport Global"
^DIC(9.4,49,22,10,"PAH",391,1,270,0)="           Install Package(s)"
^DIC(9.4,49,22,10,"PAH",391,1,271,0)="           Restart Install of Package(s)"
^DIC(9.4,49,22,10,"PAH",391,1,272,0)="           Unload a Distribution"
^DIC(9.4,49,22,10,"PAH",391,1,273,0)="           Backup a Transport Global"
^DIC(9.4,49,22,10,"PAH",391,1,274,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,275,0)="      Select Installation Option:"
^DIC(9.4,49,22,10,"PAH",391,1,276,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,277,0)="  3.  LOAD TRANSPORT GLOBAL FOR MULTI-BUILD"
^DIC(9.4,49,22,10,"PAH",391,1,278,0)="      -------------------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,279,0)="      From the Installation menu, select the Load a Distribution option."
^DIC(9.4,49,22,10,"PAH",391,1,280,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,281,0)="      When prompted for ""Enter a Host File:"" Enter the full directory path"
^DIC(9.4,49,22,10,"PAH",391,1,282,0)="      where you saved the host file NEWBORN_1_2_DG_FB_IB.KID"
^DIC(9.4,49,22,10,"PAH",391,1,283,0)="      (e.g., SYS$SYSDEVICE:[ANONYMOUS]NEWBORN_1_2_DG_FB_IB.KID)"
^DIC(9.4,49,22,10,"PAH",391,1,284,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,285,0)="  When prompted for ""OK to continue with Load? NO//"", Enter ""YES."""
^DIC(9.4,49,22,10,"PAH",391,1,286,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,287,0)="      The following will display:"
^DIC(9.4,49,22,10,"PAH",391,1,288,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,289,0)="        Loading Distribution..."
^DIC(9.4,49,22,10,"PAH",391,1,290,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,291,0)="     NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,49,22,10,"PAH",391,1,292,0)="     DG*5.3*867"
^DIC(9.4,49,22,10,"PAH",391,1,293,0)="     FB*3.5*146"
^DIC(9.4,49,22,10,"PAH",391,1,294,0)="     IB*2.0*499"
^DIC(9.4,49,22,10,"PAH",391,1,295,0)="     Use INSTALL NAME: NEWBORN DG FB IB BUNDLE 1.0 to install this"
^DIC(9.4,49,22,10,"PAH",391,1,296,0)="     distribution."
^DIC(9.4,49,22,10,"PAH",391,1,297,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,298,0)="  4.  RUN OPTIONAL INSTALLATION OPTIONS FOR MULTI-BUILD"
^DIC(9.4,49,22,10,"PAH",391,1,299,0)="      -------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,300,0)="      From the Installation menu, you may select to use the following options"
^DIC(9.4,49,22,10,"PAH",391,1,301,0)="     (when prompted for the INSTALL NAME, enter NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,49,22,10,"PAH",391,1,302,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,303,0)="      a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,49,22,10,"PAH",391,1,304,0)="          message of any routines exported with this patch. It will not"
^DIC(9.4,49,22,10,"PAH",391,1,305,0)="          backup any other changes such as data dictionaries or templates."
^DIC(9.4,49,22,10,"PAH",391,1,306,0)="      b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,49,22,10,"PAH",391,1,307,0)="          allow you to view all changes that will be made when this patch"
^DIC(9.4,49,22,10,"PAH",391,1,308,0)="          is installed.  It compares all components of this patch"
^DIC(9.4,49,22,10,"PAH",391,1,309,0)="          (routines, data dictionaries, templates, etc.)."
^DIC(9.4,49,22,10,"PAH",391,1,310,0)="      c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,49,22,10,"PAH",391,1,311,0)="          you to ensure the integrity of the routines that are in the"
^DIC(9.4,49,22,10,"PAH",391,1,312,0)="          transport global."
^DIC(9.4,49,22,10,"PAH",391,1,313,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,314,0)="  5.  INSTALL MULTI-BUILD"
^DIC(9.4,49,22,10,"PAH",391,1,315,0)="      -------------------"
^DIC(9.4,49,22,10,"PAH",391,1,316,0)="      This is the step to start the installation of this KIDS patch. This will"
^DIC(9.4,49,22,10,"PAH",391,1,317,0)="      need to be run for the NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,49,22,10,"PAH",391,1,318,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,319,0)="     a.  Choose the Install Package(s) option to start the patch"
^DIC(9.4,49,22,10,"PAH",391,1,320,0)="          install."
^DIC(9.4,49,22,10,"PAH",391,1,321,0)="     b.  When prompted for the ""Select INSTALL NAME:"" enter"
^DIC(9.4,49,22,10,"PAH",391,1,322,0)="           NEWBORN DG FB IB BUNDLE 1.0"
^DIC(9.4,49,22,10,"PAH",391,1,323,0)="     c.  When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,49,22,10,"PAH",391,1,324,0)="          NO//"", answer NO"
^DIC(9.4,49,22,10,"PAH",391,1,325,0)="     d.  When prompted ""Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,49,22,10,"PAH",391,1,326,0)="          and Protocols? NO//"", answer NO"
^DIC(9.4,49,22,10,"PAH",391,1,327,0)="     e.  When prompted ""Device: HOME//"", enter HOME"
^DIC(9.4,49,22,10,"PAH",391,1,328,0)="          to display the Install message on the screen (or enter the device"
^DIC(9.4,49,22,10,"PAH",391,1,329,0)="          you want to print the Install message). You may queue the"
^DIC(9.4,49,22,10,"PAH",391,1,330,0)="          install if you wish."
^DIC(9.4,49,22,10,"PAH",391,1,331,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,332,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,333,0)=" Post-Installation Instructions"
^DIC(9.4,49,22,10,"PAH",391,1,334,0)=" ------------------------------"
^DIC(9.4,49,22,10,"PAH",391,1,335,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,336,0)=" *** IMPORTANT NOTE ***"
^DIC(9.4,49,22,10,"PAH",391,1,337,0)=" Please note there are three post installation routines that may be deleted"
^DIC(9.4,49,22,10,"PAH",391,1,338,0)=" after successful installation of the NEWBORN DG FB IB BUNDLE 1.0. These are:"
^DIC(9.4,49,22,10,"PAH",391,1,339,0)=" "
^DIC(9.4,49,22,10,"PAH",391,1,340,0)=" DG867PO"
^DIC(9.4,49,22,10,"PAH",391,1,341,0)=" FB146PO"
^DIC(9.4,49,22,10,"PAH",391,1,342,0)=" IB499PO"
^DIC(9.4,49,22,10,"PAH",392,0)="512 SEQ #463^3131211.112152^17"
^DIC(9.4,49,22,10,"PAH",392,1,0)="^^2^2^3131211"
^DIC(9.4,49,22,10,"PAH",392,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes to reflect "
^DIC(9.4,49,22,10,"PAH",392,1,2,0)="Fiscal Year 2014 changes (Mid Year)."
^DIC(9.4,49,22,10,"PAH",393,0)="494^3140106.161658^17"
^DIC(9.4,49,22,10,"PAH",393,1,0)="^^1^1^3140106"
^DIC(9.4,49,22,10,"PAH",393,1,1,0)="EPHARMACY OPERATING RULES"
^DIC(9.4,49,22,10,"PAH",394,0)="514^3140106.162439^17"
^DIC(9.4,49,22,10,"PAH",395,0)="479 SEQ #466^3140114.151814^17"
^DIC(9.4,49,22,10,"PAH",395,1,0)="^^5^5^3140114"
^DIC(9.4,49,22,10,"PAH",395,1,1,0)="This patch addresses two issues. The first issue is about the extract name"
^DIC(9.4,49,22,10,"PAH",395,1,2,0)="displaying incorrectly for IV section in the MCCR Site Parameter Display/"
^DIC(9.4,49,22,10,"PAH",395,1,3,0)="Edit option. The second issue concerns the CPT codes on an inpatient bill "
^DIC(9.4,49,22,10,"PAH",395,1,4,0)="duplicated thousands of times in the Enter/Edit Billing Information"
^DIC(9.4,49,22,10,"PAH",395,1,5,0)="option."
^DIC(9.4,49,22,10,"PAH",396,0)="510 SEQ #467^3140114.152406^17"
^DIC(9.4,49,22,10,"PAH",396,1,0)="^^5^5^3140114"
^DIC(9.4,49,22,10,"PAH",396,1,1,0)="This patch addresses two issues. The first issue is about the update of "
^DIC(9.4,49,22,10,"PAH",396,1,2,0)="the administrative charge based on a new dispensing fee $13.18 for rate "
^DIC(9.4,49,22,10,"PAH",396,1,3,0)="types: Humanitarian and Ineligible on third party pharmacy prescription "
^DIC(9.4,49,22,10,"PAH",396,1,4,0)="claims. The second issue is to inactivate the non-billable reason code:"
^DIC(9.4,49,22,10,"PAH",396,1,5,0)="CV25 HDHP PLAN NOT BILLED for the Claims Tracking module."
^DIC(9.4,49,22,10,"PAH",397,0)="503 SEQ #468^3140203.142514^17"
^DIC(9.4,49,22,10,"PAH",397,1,0)="^^8^8^3140203"
^DIC(9.4,49,22,10,"PAH",397,1,1,0)="This patch addresses two issues. This first issue is about the "
^DIC(9.4,49,22,10,"PAH",397,1,2,0)="update of the administrative charge for the rate types based on "
^DIC(9.4,49,22,10,"PAH",397,1,3,0)="a new dispensing fee and adjustments for third party pharmacy "
^DIC(9.4,49,22,10,"PAH",397,1,4,0)="prescription claims with an effective date of January 1st, 2014."
^DIC(9.4,49,22,10,"PAH",397,1,5,0)="The second issue concerns that there is no space between the line item"
^DIC(9.4,49,22,10,"PAH",397,1,6,0)="number and the bill from date to display if a patient has more than 99"
^DIC(9.4,49,22,10,"PAH",397,1,7,0)="charges in the Cancel/Edit/Add Patient Charges [IB CANCEL/EDIT/ADD"
^DIC(9.4,49,22,10,"PAH",397,1,8,0)="CHARGES] option."
^DIC(9.4,49,22,10,"PAH",398,0)="509 SEQ #469^3140212.164959^17"
^DIC(9.4,49,22,10,"PAH",398,1,0)="^^5^5^3140212"
^DIC(9.4,49,22,10,"PAH",398,1,1,0)="This patch will update the following HL LOGICAL LINK (#870) entries with "
^DIC(9.4,49,22,10,"PAH",398,1,2,0)="new IP addresses:"
^DIC(9.4,49,22,10,"PAH",398,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",398,1,4,0)="BPS NCPDP"
^DIC(9.4,49,22,10,"PAH",398,1,5,0)="EPHARM OUT"
^DIC(9.4,49,22,10,"PAH",399,0)="513 SEQ #470^3140213.132346^17"
^DIC(9.4,49,22,10,"PAH",399,1,0)="^^1^1^3140213"
^DIC(9.4,49,22,10,"PAH",399,1,1,0)="Reasonable Charges v3.14"
^DIC(9.4,49,22,10,"PAH",400,0)="497 SEQ #471^3140311.122702^17"
^DIC(9.4,49,22,10,"PAH",401,0)="520 SEQ #472^3140324.153814^17"
^DIC(9.4,49,22,10,"PAH",401,1,0)="^^1^1^3140324"
^DIC(9.4,49,22,10,"PAH",401,1,1,0)="Revised Reasonable Charges v3.14"
^DIC(9.4,49,22,10,"PAH",402,0)="385^3140324.154004^17"
^DIC(9.4,49,22,10,"PAH",403,0)="498 SEQ #474^3140520.092809^17"
^DIC(9.4,49,22,10,"PAH",403,1,0)="^^6^6^3140520"
^DIC(9.4,49,22,10,"PAH",403,1,1,0)="This patch contains two issues. The first issue is about three "
^DIC(9.4,49,22,10,"PAH",403,1,2,0)="non-billable HCPCS (Healthcare Common Procedure Coding System) codes for"
^DIC(9.4,49,22,10,"PAH",403,1,3,0)="prosthetic items that need to be filtered out of the Claims Tracking "
^DIC(9.4,49,22,10,"PAH",403,1,4,0)="module. The second issue is about CHAMPVA & CHAMPVA REIMBURSEMENT "
^DIC(9.4,49,22,10,"PAH",403,1,5,0)="INSURANCE rate schedules linking to RC charge sets are not automatically"
^DIC(9.4,49,22,10,"PAH",403,1,6,0)="updated in the Rate Schedule file (#363)."
^DIC(9.4,49,22,10,"PAH",404,0)="515 SEQ #475^3140520.092822^17"
^DIC(9.4,49,22,10,"PAH",404,1,0)="^^2^2^3140520"
^DIC(9.4,49,22,10,"PAH",404,1,1,0)="The purpose of this patch is to update the MCCR Utility file and the"
^DIC(9.4,49,22,10,"PAH",404,1,2,0)="Revenue Code file and the Place of Service file for 2014."
^DIC(9.4,49,22,10,"PAH",405,0)="489 SEQ #476^3140520.15071^17"
^DIC(9.4,49,22,10,"PAH",405,1,0)="^^5^5^3140520"
^DIC(9.4,49,22,10,"PAH",405,1,1,0)="This patch addresses two issues. This first issue is about duplicate "
^DIC(9.4,49,22,10,"PAH",405,1,2,0)="encounters for the outpatient care added to the Claims Tracking when the"
^DIC(9.4,49,22,10,"PAH",405,1,3,0)="'REPORTS ADD TO CLAIMS TRACKING' site parameter set to 'YES'. The second "
^DIC(9.4,49,22,10,"PAH",405,1,4,0)="issue is the line items which are not listed under the appropriate "
^DIC(9.4,49,22,10,"PAH",405,1,5,0)="heading in the [IBJ THIRD PARTY JOINT INQUIRY] option."
^DIC(9.4,49,22,10,"PAH",406,0)="506 SEQ #477^3140724.102754^17"
^DIC(9.4,49,22,10,"PAH",406,1,0)="^^1^1^3140724"
^DIC(9.4,49,22,10,"PAH",406,1,1,0)="eInsurance System Modification effort"
^DIC(9.4,49,22,10,"PAH",407,0)="531 SEQ #478^3140910.110005^17"
^DIC(9.4,49,22,10,"PAH",407,1,0)="^^2^2^3140910"
^DIC(9.4,49,22,10,"PAH",407,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes to reflect "
^DIC(9.4,49,22,10,"PAH",407,1,2,0)="Fiscal Year 2015 changes."
^DIC(9.4,49,22,10,"PAH",408,0)="488 SEQ #479^3140929.140414^17"
^DIC(9.4,49,22,10,"PAH",408,1,0)="^^74^74^3140929"
^DIC(9.4,49,22,10,"PAH",408,1,1,0)="The HIPAA 5010 D.0 Level II Phase 2 project includes the following"
^DIC(9.4,49,22,10,"PAH",408,1,2,0)="modifications to the Electronic Billing V. 2.0 application:"
^DIC(9.4,49,22,10,"PAH",408,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,4,0)="1. Remove Ability to Print Claim at Clearinghouse"
^DIC(9.4,49,22,10,"PAH",408,1,5,0)="   ----------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,6,0)="   Modified VistA IB to remove the user's ability to force the claim to"
^DIC(9.4,49,22,10,"PAH",408,1,7,0)="   print at the clearinghouse.  The capability to force a claim to print"
^DIC(9.4,49,22,10,"PAH",408,1,8,0)="   at the clearinghouse was REMOVED.  Screen 10, Section 6 was modified"
^DIC(9.4,49,22,10,"PAH",408,1,9,0)="   by removing the ability to view and select 2 'FORCE CLEARINGHOUSE"
^DIC(9.4,49,22,10,"PAH",408,1,10,0)="   PRINT'. Selections 0 'NO FORCED PRINT' and 1 'FORCE LOCAL PRINT' still"
^DIC(9.4,49,22,10,"PAH",408,1,11,0)="   remain and function as they always have: if this field"
^DIC(9.4,49,22,10,"PAH",408,1,12,0)="   [Force to Print?] is set to 0, the claim will be transmitted"
^DIC(9.4,49,22,10,"PAH",408,1,13,0)="   electronically to the payer; otherwise, if this field is set to 1, the"
^DIC(9.4,49,22,10,"PAH",408,1,14,0)="   claim will be printed locally."
^DIC(9.4,49,22,10,"PAH",408,1,15,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,16,0)="2. Prevent Creation of Claims with PAYER ID of HPRNT/SPRNT"
^DIC(9.4,49,22,10,"PAH",408,1,17,0)="   -------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,18,0)="   Modified VistA IB so that claims with Payer ID HPRNT/SPRNT display"
^DIC(9.4,49,22,10,"PAH",408,1,19,0)="   a fatal error message and force the removal of the HPRNT/SPRNT"
^DIC(9.4,49,22,10,"PAH",408,1,20,0)="   Payer ID from the Insurance Company file (#36)."
^DIC(9.4,49,22,10,"PAH",408,1,21,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,22,0)="3. Prevent Creation of Claims with Zero Procedures"
^DIC(9.4,49,22,10,"PAH",408,1,23,0)="   -----------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,24,0)="   Modified VistA IB to prevent the creation of claims with no procedures."
^DIC(9.4,49,22,10,"PAH",408,1,25,0)="   IB validation logic has been incorporated to ensure a claim that is"
^DIC(9.4,49,22,10,"PAH",408,1,26,0)="   being created or edited cannot be submitted unless it contains at least"
^DIC(9.4,49,22,10,"PAH",408,1,27,0)="   one procedure.  If there are no procedures on the created or edited"
^DIC(9.4,49,22,10,"PAH",408,1,28,0)="   claim, a fatal error message will display to the user notifying them of"
^DIC(9.4,49,22,10,"PAH",408,1,29,0)="   this condition and will not allow the claim to be submitted.  Claims"
^DIC(9.4,49,22,10,"PAH",408,1,30,0)="   will continue to allow $0 line item(s) but these will also be required"
^DIC(9.4,49,22,10,"PAH",408,1,31,0)="   to have at least one procedure.  The only exception to this is that"
^DIC(9.4,49,22,10,"PAH",408,1,32,0)="   UB-04 Inpatient claims with no procedures may still be created."
^DIC(9.4,49,22,10,"PAH",408,1,33,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,34,0)="4. Modify the Provider Contact Field Names for Property & Casualty Claims"
^DIC(9.4,49,22,10,"PAH",408,1,35,0)="   ----------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,36,0)="   Modified the Contact Name, Phone and Extension field names in the"
^DIC(9.4,49,22,10,"PAH",408,1,37,0)="   IB NON/OTHER VA BILLING PROVIDER(#355.93) file so that users will see"
^DIC(9.4,49,22,10,"PAH",408,1,38,0)="   the following prompts/labels while in the PROVIDER ID MAINTENANCE"
^DIC(9.4,49,22,10,"PAH",408,1,39,0)="   [IBCE PROVIDER MAINT] option: P&C Contact Name, P&C Contact Phone"
^DIC(9.4,49,22,10,"PAH",408,1,40,0)="   Number and P&C Contact Phone Extension.  The P&C Contact Phone Number"
^DIC(9.4,49,22,10,"PAH",408,1,41,0)="   field was also updated to require a minimum of 10 digits."
^DIC(9.4,49,22,10,"PAH",408,1,42,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,43,0)="5. Modify the Non-VA Facility Street Address & Zip Code Fields"
^DIC(9.4,49,22,10,"PAH",408,1,44,0)="   -----------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,45,0)="   Modified VistA so that the STREET ADDRESS field (#355.93,#.05) will no"
^DIC(9.4,49,22,10,"PAH",408,1,46,0)="   longer accept PO Box and other variations of post office box as a"
^DIC(9.4,49,22,10,"PAH",408,1,47,0)="   valid street address.  This validation does not apply to the STREET"
^DIC(9.4,49,22,10,"PAH",408,1,48,0)="   ADDRESS LINE 2 field (#355.93,#.1).  The ZIP CODE field (#355.93,#.08)"
^DIC(9.4,49,22,10,"PAH",408,1,49,0)="   has been modified so that only 9 digit ZIP codes are valid.  Entering"
^DIC(9.4,49,22,10,"PAH",408,1,50,0)="   ""0000"" as the last four digits of a ZIP code is not acceptable."
^DIC(9.4,49,22,10,"PAH",408,1,51,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,52,0)="6.  Modify Third Party Joint Inquiry [IBJ THIRD PARTY JOINT INQUIRY]"
^DIC(9.4,49,22,10,"PAH",408,1,53,0)="    ----------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,54,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,55,0)="    Modified VistA to improve the readability of ERA data in the Third "
^DIC(9.4,49,22,10,"PAH",408,1,56,0)="    Party Joint Inquiry [IBJ THIRD PARTY JOINT INQUIRY] option that "
^DIC(9.4,49,22,10,"PAH",408,1,57,0)="    display when the BC ""Billing Charges"" action is selected.  The"
^DIC(9.4,49,22,10,"PAH",408,1,58,0)="    display was modified to remove the RAW DATA display for those EOBs"
^DIC(9.4,49,22,10,"PAH",408,1,59,0)="    that contained ""Message Storage Errors"" and make the reported"
^DIC(9.4,49,22,10,"PAH",408,1,60,0)="    error(s) more readable.  The formerly known ""MESSAGE STORAGE ERRORS"""
^DIC(9.4,49,22,10,"PAH",408,1,61,0)="    are now known as ""DATA MISMATCH ERRORS""."
^DIC(9.4,49,22,10,"PAH",408,1,62,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,63,0)="7.  Include ERAs with errors on the Medicare Remittance Advice Worklist "
^DIC(9.4,49,22,10,"PAH",408,1,64,0)="    -------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",408,1,65,0)="    Modified VistA so that claims containing an error condition from"
^DIC(9.4,49,22,10,"PAH",408,1,66,0)="    processing the 835 will now display on the Medicare Remittance"
^DIC(9.4,49,22,10,"PAH",408,1,67,0)="    Advice Worklist (MRW), which is accessed via the option MRA"
^DIC(9.4,49,22,10,"PAH",408,1,68,0)="    Management WorkList [IBCE MRA MANAGEMENT].  These specific claims"
^DIC(9.4,49,22,10,"PAH",408,1,69,0)="    will be identified on the MRW with an ""!"" exclamation point"
^DIC(9.4,49,22,10,"PAH",408,1,70,0)="    displayed immediately in front of the claim number."
^DIC(9.4,49,22,10,"PAH",408,1,71,0)=" "
^DIC(9.4,49,22,10,"PAH",408,1,72,0)="The routine IBCEP8 was added to this patch to reintroduce the changes"
^DIC(9.4,49,22,10,"PAH",408,1,73,0)="that were previouly introduced by patch IB*2.0*447 which were subsequently"
^DIC(9.4,49,22,10,"PAH",408,1,74,0)="inadvertently omitted by the patch IB*2.0*476."
^DIC(9.4,49,22,10,"PAH",409,0)="461 SEQ #481^3141022.102802^17"
^DIC(9.4,49,22,10,"PAH",409,1,0)="^^1^1^3141022"
^DIC(9.4,49,22,10,"PAH",409,1,1,0)="Integrated Billing (IB) update for ICD-10 Diagnosis and Procedures."
^DIC(9.4,49,22,10,"PAH",410,0)="526 SEQ #482^3141031.155522^17"
^DIC(9.4,49,22,10,"PAH",410,1,0)="^^4^4^3141031"
^DIC(9.4,49,22,10,"PAH",410,1,1,0)="This patch addresses two issues. The first issue is about the tricare"
^DIC(9.4,49,22,10,"PAH",410,1,2,0)="express bills being rejected due to the approving official is undefined."
^DIC(9.4,49,22,10,"PAH",410,1,3,0)="The second issue is the update to the Occurrence Span Code 72 in the MCCR"
^DIC(9.4,49,22,10,"PAH",410,1,4,0)="Utility file (#399.1)."
^DIC(9.4,49,22,10,"PAH",411,0)="524 SEQ #483^3141031.155709^17"
^DIC(9.4,49,22,10,"PAH",411,1,0)="^^6^6^3141031"
^DIC(9.4,49,22,10,"PAH",411,1,1,0)="This patch addresses two issues. The first issue contains updates to the "
^DIC(9.4,49,22,10,"PAH",411,1,2,0)="IB Action Type file (#350.1) and the IB Action Charge file (#350.2)."
^DIC(9.4,49,22,10,"PAH",411,1,3,0)="The second issue involves the IBJD Billing Lag Time report showing the"
^DIC(9.4,49,22,10,"PAH",411,1,4,0)="last patient with blank information on the first page and the name then"
^DIC(9.4,49,22,10,"PAH",411,1,5,0)="repeated on the top of the next page with the associated claim activity"
^DIC(9.4,49,22,10,"PAH",411,1,6,0)="data."
^DIC(9.4,49,22,10,"PAH",412,0)="519 SEQ #484^3141216.133457^17"
^DIC(9.4,49,22,10,"PAH",412,1,0)="^^21^21^3141216"
^DIC(9.4,49,22,10,"PAH",412,1,1,0)="The Health Plan Identifier (HPID) project implements a new national "
^DIC(9.4,49,22,10,"PAH",412,1,2,0)="standard of having a single identifier to use on electronic transmissions"
^DIC(9.4,49,22,10,"PAH",412,1,3,0)="pertaining to health care. All entities that are financially responsible"
^DIC(9.4,49,22,10,"PAH",412,1,4,0)="for care are assigned a HPID or Other Entity Identifier (OEID), used for"
^DIC(9.4,49,22,10,"PAH",412,1,5,0)="entities that aren't traditional health plans. This new standard increases"
^DIC(9.4,49,22,10,"PAH",412,1,6,0)="interoperability by replacing clearinghouse-specific identifiers for "
^DIC(9.4,49,22,10,"PAH",412,1,7,0)="health plans."
^DIC(9.4,49,22,10,"PAH",412,1,8,0)=" "
^DIC(9.4,49,22,10,"PAH",412,1,9,0)="This patch updates the Integrated Billing (IB) package to enable it to"
^DIC(9.4,49,22,10,"PAH",412,1,10,0)="store these new HPIDs and OEIDs, and to associate the entries in the local"
^DIC(9.4,49,22,10,"PAH",412,1,11,0)="Insurance Company file (#36) with a new National Insurance File (NIF),"
^DIC(9.4,49,22,10,"PAH",412,1,12,0)="owned by the Financial Services Center (FSC), which will centrally manage"
^DIC(9.4,49,22,10,"PAH",412,1,13,0)="distribution of HPID/OEID data."
^DIC(9.4,49,22,10,"PAH",412,1,14,0)=" "
^DIC(9.4,49,22,10,"PAH",412,1,15,0)="In order to accomplish this, this patch introduces a new HL7 interface"
^DIC(9.4,49,22,10,"PAH",412,1,16,0)="for exchanging insurance information with the NIF. Included with this new"
^DIC(9.4,49,22,10,"PAH",412,1,17,0)="interface is a logging function which generates (periodically purged)"
^DIC(9.4,49,22,10,"PAH",412,1,18,0)="transaction records, allowing troubleshooting."
^DIC(9.4,49,22,10,"PAH",412,1,19,0)=" "
^DIC(9.4,49,22,10,"PAH",412,1,20,0)="When installed, this patch will create a flat-file extract that can be"
^DIC(9.4,49,22,10,"PAH",412,1,21,0)="sent to the FSC in order to assist in setup of the NIF."
^DIC(9.4,49,22,10,"PAH",413,0)="540^3150106.115626^17"
^DIC(9.4,49,22,10,"PAH",413,1,0)="^^1^1^3150106"
^DIC(9.4,49,22,10,"PAH",413,1,1,0)="2015 RX COPAY THRESHOLDS"
^DIC(9.4,49,22,10,"PAH",414,0)="533 SEQ #486^3150106.125835^17"
^DIC(9.4,49,22,10,"PAH",414,1,0)="^^3^3^3150106"
^DIC(9.4,49,22,10,"PAH",414,1,1,0)="This patch fixes issues where incorrect data is being transmitted in "
^DIC(9.4,49,22,10,"PAH",414,1,2,0)="the PID segment for billing records and appointment generated "
^DIC(9.4,49,22,10,"PAH",414,1,3,0)="inquiries are getting stuck. "
^DIC(9.4,49,22,10,"PAH",415,0)="532 SEQ #487^3150106.125937^17"
^DIC(9.4,49,22,10,"PAH",415,1,0)="^^9^9^3150106"
^DIC(9.4,49,22,10,"PAH",415,1,1,0)="This patch addresses two issues. "
^DIC(9.4,49,22,10,"PAH",415,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",415,1,3,0)="The first issue is about a new entry - LABORATRY SERVICES PROVIDED TO"
^DIC(9.4,49,22,10,"PAH",415,1,4,0)="NON-PATIENTS added to the MCCR Utility file (#399.1) for UB-04 Bill "
^DIC(9.4,49,22,10,"PAH",415,1,5,0)="Classification on the second digit type of bill."
^DIC(9.4,49,22,10,"PAH",415,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",415,1,7,0)="The second issue concerns several misspellings in the display messages "
^DIC(9.4,49,22,10,"PAH",415,1,8,0)="for the chiropractic-related dates and the statement covers dates in the "
^DIC(9.4,49,22,10,"PAH",415,1,9,0)="[IB EDIT BILLING INFO] Enter/Edit Billing Information option."
^DIC(9.4,49,22,10,"PAH",416,0)="537 SEQ #488^3150114.120206^17"
^DIC(9.4,49,22,10,"PAH",416,1,0)="^^2^2^3150114"
^DIC(9.4,49,22,10,"PAH",416,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes to reflect "
^DIC(9.4,49,22,10,"PAH",416,1,2,0)="Fiscal Year 2015 mid-year changes."
^DIC(9.4,49,22,10,"PAH",417,0)="536 SEQ #489^3150123.113644^17"
^DIC(9.4,49,22,10,"PAH",417,1,0)="^^1^1^3150123"
^DIC(9.4,49,22,10,"PAH",417,1,1,0)="Reasonable Charges v3.15"
^DIC(9.4,49,22,10,"PAH",418,0)="521^3150209.124323^17"
^DIC(9.4,49,22,10,"PAH",419,0)="541 SEQ #491^3150217.102142^17"
^DIC(9.4,49,22,10,"PAH",419,1,0)="^^3^3^3150217"
^DIC(9.4,49,22,10,"PAH",419,1,1,0)="This patch will update the pharmacy administrative charge based on a new "
^DIC(9.4,49,22,10,"PAH",419,1,2,0)="dispensing fee of $11.16 for Tricare and Tricare Reimbursement Insurance "
^DIC(9.4,49,22,10,"PAH",419,1,3,0)="prescription claims with an effective date of February 20, 2015."
^DIC(9.4,49,22,10,"PAH",420,0)="538 SEQ #492^3150311.112119^17"
^DIC(9.4,49,22,10,"PAH",420,1,0)="^^10^10^3150311"
^DIC(9.4,49,22,10,"PAH",420,1,1,0)="This patch addresses two issues."
^DIC(9.4,49,22,10,"PAH",420,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",420,1,3,0)="1. The administrative charge $13.07 needs to be added to the prescription"
^DIC(9.4,49,22,10,"PAH",420,1,4,0)="   cost for the rate type: Interagency with an effective date of January"
^DIC(9.4,49,22,10,"PAH",420,1,5,0)="   1st, 2014."
^DIC(9.4,49,22,10,"PAH",420,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",420,1,7,0)="2. The administrative charge $13.10 needs to be added to the prescription"
^DIC(9.4,49,22,10,"PAH",420,1,8,0)="   cost for the rate types: Reimbursable Insurance, No Fault Insurance,"
^DIC(9.4,49,22,10,"PAH",420,1,9,0)="   Workers' Compensation, Tort Feasor, Humanitarian, Ineligible and"
^DIC(9.4,49,22,10,"PAH",420,1,10,0)="   Interagency with an effective date of January 1st, 2015."
^DIC(9.4,49,22,10,"PAH",421,0)="539 SEQ #493^3150316.160928^17"
^DIC(9.4,49,22,10,"PAH",421,1,0)="^^2^2^3150316"
^DIC(9.4,49,22,10,"PAH",421,1,1,0)="This patch will install the Cost-Based and Inter-agency billing rates"
^DIC(9.4,49,22,10,"PAH",421,1,2,0)="into the Charge Item file (#363.2), with an effective date of 11/04/2014."
^DIC(9.4,49,22,10,"PAH",422,0)="542 SEQ #494^3150331.141554^17"
^DIC(9.4,49,22,10,"PAH",422,1,0)="^^1^1^3150331"
^DIC(9.4,49,22,10,"PAH",422,1,1,0)="Reasonable Charges v3.16"
^DIC(9.4,49,22,10,"PAH",423,0)="516 SEQ #495^3150512.113645^17"
^DIC(9.4,49,22,10,"PAH",423,1,0)="^^1^1^3150512"
^DIC(9.4,49,22,10,"PAH",423,1,1,0)="eBilling Build 3"
^DIC(9.4,49,22,10,"PAH",424,0)="511^3150514.101154^17"
^DIC(9.4,49,22,10,"PAH",425,0)="543 SEQ #497^3150625.11485^17"
^DIC(9.4,49,22,10,"PAH",425,1,0)="^^6^6^3150625"
^DIC(9.4,49,22,10,"PAH",425,1,1,0)="This patch addresses 2 issues."
^DIC(9.4,49,22,10,"PAH",425,1,2,0)="1. The first issue is to update the MCCR Utility file and the Revenue Code"
^DIC(9.4,49,22,10,"PAH",425,1,3,0)="file and the Place of Service file for 2015. "
^DIC(9.4,49,22,10,"PAH",425,1,4,0)=" "
^DIC(9.4,49,22,10,"PAH",425,1,5,0)="2. The second issue concerns ICD10 procedure codes being truncated on"
^DIC(9.4,49,22,10,"PAH",425,1,6,0)="page 2 of the printed bill when they contain 7 characters in length."
^DIC(9.4,49,22,10,"PAH",426,0)="551 SEQ #498^3150827.154804^17"
^DIC(9.4,49,22,10,"PAH",426,1,0)="^^2^2^3150827"
^DIC(9.4,49,22,10,"PAH",426,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes to reflect "
^DIC(9.4,49,22,10,"PAH",426,1,2,0)="Fiscal Year 2016 changes."
^DIC(9.4,49,22,10,"PAH",427,0)="522^3150916.111011^17"
^DIC(9.4,49,22,10,"PAH",427,1,0)="^^1^1^3150916"
^DIC(9.4,49,22,10,"PAH",427,1,1,0)="Integrated Billing update for PTF Diagnosis and Procedure code expansion."
^DIC(9.4,49,22,10,"PAH",428,0)="546 SEQ #500^3151026.150942^17"
^DIC(9.4,49,22,10,"PAH",428,1,0)="^^4^4^3151026"
^DIC(9.4,49,22,10,"PAH",428,1,1,0)="This patch will fix an issue identified while running the Queue Means"
^DIC(9.4,49,22,10,"PAH",428,1,2,0)="Test Compilation of Charges [IB MT NIGHT COMP] background job that"
^DIC(9.4,49,22,10,"PAH",428,1,3,0)="leads to a runaway alert process where hundreds of thousands of "
^DIC(9.4,49,22,10,"PAH",428,1,4,0)="alerts are generated for a single record/instance."
^DIC(9.4,49,22,10,"PAH",429,0)="553^3151201.17482^54"
^DIC(9.4,49,22,10,"PAH",429,1,0)="^^2^2^3151201"
^DIC(9.4,49,22,10,"PAH",429,1,1,0)="The purpose of this patch is to update the names of the Occurrence Span"
^DIC(9.4,49,22,10,"PAH",429,1,2,0)="Codes to the MCCR UTILITY (#399.1) file."
^DIC(9.4,49,22,10,"PAH",430,0)="482 SEQ #502^3151211.144559^17"
^DIC(9.4,49,22,10,"PAH",430,1,0)="^^3^3^3151211"
^DIC(9.4,49,22,10,"PAH",430,1,1,0)="This patch addresses an issue concerning payment amounts on e-Pharmacy"
^DIC(9.4,49,22,10,"PAH",430,1,2,0)="claims where the bill amount is different than what is shown via the ECME"
^DIC(9.4,49,22,10,"PAH",430,1,3,0)="Billing Events Report [IB ECME BILLING EVENTS] option."
^DIC(9.4,49,22,10,"PAH",431,0)="557^3160107.151021^54"
^DIC(9.4,49,22,10,"PAH",431,1,0)="^^5^5^3160107"
^DIC(9.4,49,22,10,"PAH",431,1,1,0)="This patch, IB*2.0*557, is one of three VistA 2016 threshold patches. It "
^DIC(9.4,49,22,10,"PAH",431,1,2,0)="addresses the annual updates for the Pharmacy Copay Thresholds. Patch "
^DIC(9.4,49,22,10,"PAH",431,1,3,0)="DG*5.3*922 will update the thresholds for the Means Tests and the Maximum"
^DIC(9.4,49,22,10,"PAH",431,1,4,0)="Annual Pension Rate. Patch EAS*1.0*134 will address the annual updates for"
^DIC(9.4,49,22,10,"PAH",431,1,5,0)="the GMT Thresholds."
^DIC(9.4,49,22,10,"PAH",432,0)="548 SEQ #504^3160108.115748^54"
^DIC(9.4,49,22,10,"PAH",432,1,0)="^^2^2^3160108"
^DIC(9.4,49,22,10,"PAH",432,1,1,0)="In preparation for the VA's transition from IPv4 to IPv6 the IB package "
^DIC(9.4,49,22,10,"PAH",432,1,2,0)="will require modifications to make it IPv6 ready."
^DIC(9.4,49,22,10,"PAH",433,0)="556 SEQ #505^3160115.154516^54"
^DIC(9.4,49,22,10,"PAH",433,1,0)="^^1^1^3160115"
^DIC(9.4,49,22,10,"PAH",433,1,1,0)="Reasonable Charges v3.17"
^DIC(9.4,49,22,10,"PAH",434,0)="534^3160211.171632^54"
^DIC(9.4,49,22,10,"PAH",434,1,0)="^^1^1^3160211"
^DIC(9.4,49,22,10,"PAH",434,1,1,0)="HAPE EDI Revenue project - NCPDP Continuous Maintenance Standards"
^DIC(9.4,49,22,10,"PAH",435,0)="558 SEQ #508^3160226.131915^54"
^DIC(9.4,49,22,10,"PAH",435,1,0)="^^4^4^3160226"
^DIC(9.4,49,22,10,"PAH",435,1,1,0)="This patch addresses two issues. The first issue contains the TRICARE"
^DIC(9.4,49,22,10,"PAH",435,1,2,0)="pharmacy administrative fee update based on a new dispensing fee of $12.19"
^DIC(9.4,49,22,10,"PAH",435,1,3,0)="with an effective date of January 1st, 2016. The second issue is about"
^DIC(9.4,49,22,10,"PAH",435,1,4,0)="the update of the Place of Service file (#353.1)."
^DIC(9.4,49,22,10,"PAH",436,0)="559 SEQ #509^3160318.143^54"
^DIC(9.4,49,22,10,"PAH",436,1,0)="^^1^1^3160318"
^DIC(9.4,49,22,10,"PAH",436,1,1,0)="Reasonable Charges v3.18"
^DIC(9.4,49,22,10,"PAH",437,0)="552 SEQ #510^3160329.131108^54"
^DIC(9.4,49,22,10,"PAH",437,1,0)="^^3^3^3160329"
^DIC(9.4,49,22,10,"PAH",437,1,1,0)="This patch fixes issues during MESSAGE CHECKSUM calculations leading"
^DIC(9.4,49,22,10,"PAH",437,1,2,0)="to <MAXNUMBER> errors and the potential for the back billing process"
^DIC(9.4,49,22,10,"PAH",437,1,3,0)="to bill a negative amount."
^DIC(9.4,49,22,10,"PAH",438,0)="555 SEQ #511^3160407.160114^54"
^DIC(9.4,49,22,10,"PAH",438,1,0)="^^4^4^3160407"
^DIC(9.4,49,22,10,"PAH",438,1,1,0)="This patch addresses two issues. The first issue contains two new "
^DIC(9.4,49,22,10,"PAH",438,1,2,0)="Ineligible Dental for Cost-Based and Inter-agency billing rates for FY"
^DIC(9.4,49,22,10,"PAH",438,1,3,0)="2015. The second issue is about the [IB OUTPUT DAYS ON HOLD] Days On Hold"
^DIC(9.4,49,22,10,"PAH",438,1,4,0)="Report in the running process which is never complete."
^DIC(9.4,49,22,10,"PAH",439,0)="528^3160418.152907^54"
^DIC(9.4,49,22,10,"PAH",439,1,0)="^^8^8^3160418"
^DIC(9.4,49,22,10,"PAH",439,1,1,0)="MCCF ENHANCEMENTS PROJECT - EIV"
^DIC(9.4,49,22,10,"PAH",439,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",439,1,3,0)="This patch implements changes to VistA's Integrated Billing (IB), "
^DIC(9.4,49,22,10,"PAH",439,1,4,0)="Insurance Company, and Patient Insurance File modules are requested by "
^DIC(9.4,49,22,10,"PAH",439,1,5,0)="the Veterans Health Administration (VHA) Chief Business Office (CBO)"
^DIC(9.4,49,22,10,"PAH",439,1,6,0)="eBusiness Solutions Department to comply with the legislative"
^DIC(9.4,49,22,10,"PAH",439,1,7,0)="changes mandated by the Health Insurance Portability and Accountability "
^DIC(9.4,49,22,10,"PAH",439,1,8,0)="Act of 1996 (HIPAA)."
^DIC(9.4,49,22,10,"PAH",440,0)="525^3160418.152908^54"
^DIC(9.4,49,22,10,"PAH",440,1,0)="^^5^5^3160418"
^DIC(9.4,49,22,10,"PAH",440,1,1,0)="This patch implements changes to VistA's Integrated Billing (IB) module "
^DIC(9.4,49,22,10,"PAH",440,1,2,0)="as requested by the Veterans Health Administration (VHA) Chief Business "
^DIC(9.4,49,22,10,"PAH",440,1,3,0)="Office (CBO) eBusiness Solutions Department to comply with the "
^DIC(9.4,49,22,10,"PAH",440,1,4,0)="legislative changes mandated by the Health Insurance Portability and "
^DIC(9.4,49,22,10,"PAH",440,1,5,0)="Accountability Act of 1996 (HIPAA)."
^DIC(9.4,49,22,10,"PAH",441,0)="566 SEQ #514^3160616.161317^54"
^DIC(9.4,49,22,10,"PAH",441,1,0)="^^3^3^3160616"
^DIC(9.4,49,22,10,"PAH",441,1,1,0)="The patch contains the fix for the patch IB*2.0*528. It is replacing "
^DIC(9.4,49,22,10,"PAH",441,1,2,0)="references to the old security key IBCNE IIV AUTO MATCH with IBCNE EIV"
^DIC(9.4,49,22,10,"PAH",441,1,3,0)="MAINTENANCE in two routines IBCNEAMC and IBCNEUT6."
^DIC(9.4,49,22,10,"PAH",442,0)="530^3160701.141133^54"
^DIC(9.4,49,22,10,"PAH",442,1,0)="^^35^35^3160701"
^DIC(9.4,49,22,10,"PAH",442,1,1,0)="MCCF ENHANCEMENTS PROJECT - CARC/RARC"
^DIC(9.4,49,22,10,"PAH",442,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",442,1,3,0)="VA's compliance with Electronic Funds Transfer (EFT) & Electronic "
^DIC(9.4,49,22,10,"PAH",442,1,4,0)="Remittance Advice (ERA) Operating Rules and enables VA to more "
^DIC(9.4,49,22,10,"PAH",442,1,5,0)="effectively use ERA data, resulting in better revenue and cash flow "
^DIC(9.4,49,22,10,"PAH",442,1,6,0)="management; provides the infrastructure foundation for electronic "
^DIC(9.4,49,22,10,"PAH",442,1,7,0)="exchange of claim payment information and promotes an interoperable "
^DIC(9.4,49,22,10,"PAH",442,1,8,0)="system; reduces the time elapsed between receipt of the 835 and receipt "
^DIC(9.4,49,22,10,"PAH",442,1,9,0)="of the CCD+ transaction; ensures that trace numbers between payments and "
^DIC(9.4,49,22,10,"PAH",442,1,10,0)="remittances can be used by VA, reducing the level of open accounts "
^DIC(9.4,49,22,10,"PAH",442,1,11,0)="receivable and allowing claim denials to be more quickly addressed; and "
^DIC(9.4,49,22,10,"PAH",442,1,12,0)="standardizes EFT & ERA enrollment, reducing workload burden on VA staff.  "
^DIC(9.4,49,22,10,"PAH",442,1,13,0)="  "
^DIC(9.4,49,22,10,"PAH",442,1,14,0)="This patch contains changes to the ePayments (835 and EFT) program area "
^DIC(9.4,49,22,10,"PAH",442,1,15,0)="to ensure compliance. Specifically, enhancements to the VistA Third Party "
^DIC(9.4,49,22,10,"PAH",442,1,16,0)="EDI Lockbox module to increase timely and accurate processing of payments "
^DIC(9.4,49,22,10,"PAH",442,1,17,0)="for electronic pharmacy claims in compliance with HIPAA and VHA Fiscal "
^DIC(9.4,49,22,10,"PAH",442,1,18,0)="Accounting policies will also be required.  The ePayments system is used "
^DIC(9.4,49,22,10,"PAH",442,1,19,0)="by AR staff to process payments from third party payers for both medical "
^DIC(9.4,49,22,10,"PAH",442,1,20,0)="and pharmacy claims. The objectives of the requested ePayments software "
^DIC(9.4,49,22,10,"PAH",442,1,21,0)="modifications are to expedite accurate payments by enhancing the "
^DIC(9.4,49,22,10,"PAH",442,1,22,0)="ePayments software to streamline the user's ability to process the "
^DIC(9.4,49,22,10,"PAH",442,1,23,0)="pharmacy 835 while:"
^DIC(9.4,49,22,10,"PAH",442,1,24,0)=" "
^DIC(9.4,49,22,10,"PAH",442,1,25,0)="Complying with HIPAA legislative requirements to meet patient needs and "
^DIC(9.4,49,22,10,"PAH",442,1,26,0)="secure Protected Health Information (PHI)."
^DIC(9.4,49,22,10,"PAH",442,1,27,0)=" "
^DIC(9.4,49,22,10,"PAH",442,1,28,0)="Conducting payment accounting in accordance with the Office of Management "
^DIC(9.4,49,22,10,"PAH",442,1,29,0)="and Budget (OMB) directives."
^DIC(9.4,49,22,10,"PAH",442,1,30,0)=" "
^DIC(9.4,49,22,10,"PAH",442,1,31,0)="Systematically enforcing VHA Fiscal Accounting policy."
^DIC(9.4,49,22,10,"PAH",442,1,32,0)=" "
^DIC(9.4,49,22,10,"PAH",442,1,33,0)="Providing software tools in support of efficient business models to"
^DIC(9.4,49,22,10,"PAH",442,1,34,0)="maximize the volume of electronic data received from third party "
^DIC(9.4,49,22,10,"PAH",442,1,35,0)="payers to increase revenue and save productive dollars."
^DIC(9.4,49,22,10,"PAH",443,0)="529 SEQ #516^3160701.143029^54"
^DIC(9.4,49,22,10,"PAH",443,1,0)="^^1^1^3160701"
^DIC(9.4,49,22,10,"PAH",443,1,1,0)="MEDICAL CARE COLLECTION FUND (MCCF) ENHANCEMENTS PROJECT - ePAYMENTS"
^DIC(9.4,49,22,10,"PAH",444,0)="545 SEQ #517^3160713.125529^54"
^DIC(9.4,49,22,10,"PAH",444,1,0)="^^51^51^3160713"
^DIC(9.4,49,22,10,"PAH",444,1,1,0)="This patch is part of the Pharmacy Safety Updates project which was "
^DIC(9.4,49,22,10,"PAH",444,1,2,0)="established to address specific New Service Requests (NSRs) as well as a"
^DIC(9.4,49,22,10,"PAH",444,1,3,0)="Remedy Ticket and a Patient Safety Issue (PSI) related to the VistA Pharmacy"
^DIC(9.4,49,22,10,"PAH",444,1,4,0)="applications as approved by the Health Systems Enterprise Systems Manager"
^DIC(9.4,49,22,10,"PAH",444,1,5,0)="(ESM)."
^DIC(9.4,49,22,10,"PAH",444,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",444,1,7,0)="This project is comprised of patches from five different applications, as"
^DIC(9.4,49,22,10,"PAH",444,1,8,0)="shown below:"
^DIC(9.4,49,22,10,"PAH",444,1,9,0)="  "
^DIC(9.4,49,22,10,"PAH",444,1,10,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,49,22,10,"PAH",444,1,11,0)="   -----------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",444,1,12,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*444"
^DIC(9.4,49,22,10,"PAH",444,1,13,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*545"
^DIC(9.4,49,22,10,"PAH",444,1,14,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*189"
^DIC(9.4,49,22,10,"PAH",444,1,15,0)="   NATIONAL DRUG FILE (NDF) V. 4.0                      PSN*4*429"
^DIC(9.4,49,22,10,"PAH",444,1,16,0)="   INPATIENT MEDICATIONS (IM) V.5.0                     PSJ*5*313"
^DIC(9.4,49,22,10,"PAH",444,1,17,0)=" "
^DIC(9.4,49,22,10,"PAH",444,1,18,0)=" "
^DIC(9.4,49,22,10,"PAH",444,1,19,0)="The following New service Requests (NSR) are related to this patch:"
^DIC(9.4,49,22,10,"PAH",444,1,20,0)=" "
^DIC(9.4,49,22,10,"PAH",444,1,21,0)=" NSRs 20060601/20111206 Allow Dispensing of Greater Than 90 Day Supply"
^DIC(9.4,49,22,10,"PAH",444,1,22,0)=" ---------------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",444,1,23,0)=" The Outpatient Pharmacy and supporting VistA applications are being modified"
^DIC(9.4,49,22,10,"PAH",444,1,24,0)=" to allow dispensing of more than 90 day supply fill for outpatient "
^DIC(9.4,49,22,10,"PAH",444,1,25,0)=" prescriptions. The new limit will be 365 days and will be set for each drug"
^DIC(9.4,49,22,10,"PAH",444,1,26,0)=" individually. See below for more information on specific menu "
^DIC(9.4,49,22,10,"PAH",444,1,27,0)=" options related to this enhancement.  "
^DIC(9.4,49,22,10,"PAH",444,1,28,0)=" "
^DIC(9.4,49,22,10,"PAH",444,1,29,0)=" NSR 20110308 Addition of a STRENGTH Property to IV ADDITIVES and Premixed "
^DIC(9.4,49,22,10,"PAH",444,1,30,0)="              IV SOLUTIONS"
^DIC(9.4,49,22,10,"PAH",444,1,31,0)=" ----------------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",444,1,32,0)=" Although patches PSJ*5*289 and PSS*1*174 introduced quite a few enhancements"
^DIC(9.4,49,22,10,"PAH",444,1,33,0)=" to the IV Additives and IV Solutions ordering functionality they did not go"
^DIC(9.4,49,22,10,"PAH",444,1,34,0)=" far enough in addressing all the issues originally in the NSR. Patches "
^DIC(9.4,49,22,10,"PAH",444,1,35,0)=" PSJ*5*313 and PSS*1*189 will extend the display of the IV Additive strength"
^DIC(9.4,49,22,10,"PAH",444,1,36,0)=" to other parts of the Inpatient Medications and Pharmacy Data Management "
^DIC(9.4,49,22,10,"PAH",444,1,37,0)=" applications. In addition, it will also impose a new rule where an Orderable"
^DIC(9.4,49,22,10,"PAH",444,1,38,0)=" Item can only have one IV Solution for a specific volume when it is marked"
^DIC(9.4,49,22,10,"PAH",444,1,39,0)=" to be used in the CPRS IV Fluid Order Entry. "
^DIC(9.4,49,22,10,"PAH",444,1,40,0)="   "
^DIC(9.4,49,22,10,"PAH",444,1,41,0)="The following Integrated Billing copay functionality was modified:"
^DIC(9.4,49,22,10,"PAH",444,1,42,0)="  "
^DIC(9.4,49,22,10,"PAH",444,1,43,0)="1. Cancel/Edit/Add Patient Charges [IB CANCEL/EDIT/ADD CHARGES] option"
^DIC(9.4,49,22,10,"PAH",444,1,44,0)="   This menu option was modified to allow up to 12 copay units to be added"
^DIC(9.4,49,22,10,"PAH",444,1,45,0)="   for a patient. Before the maximum limit was 3, given that 90 days supply"
^DIC(9.4,49,22,10,"PAH",444,1,46,0)="   corresponded to 3 copay units (1 unit for each 30 days supply)"
^DIC(9.4,49,22,10,"PAH",444,1,47,0)="  "
^DIC(9.4,49,22,10,"PAH",444,1,48,0)="2. The upper limit for the value allowed for the DAYS SUPPLY field (#.06) in"
^DIC(9.4,49,22,10,"PAH",444,1,49,0)="   the IB BILL/CLAIMS PRESCRIPTION REFILL file (#362.4) was changed from 90"
^DIC(9.4,49,22,10,"PAH",444,1,50,0)="   to 365 in order to accommodate the new limit for this field in the"
^DIC(9.4,49,22,10,"PAH",444,1,51,0)="   Outpatient Pharmacy application."
^DIC(9.4,49,22,10,"PAH",445,0)="561 SEQ #518^3160713.125933^54"
^DIC(9.4,49,22,10,"PAH",445,1,0)="^^3^3^3160713"
^DIC(9.4,49,22,10,"PAH",445,1,1,0)="This patch addresses the request to default the revenue code to 124  "
^DIC(9.4,49,22,10,"PAH",445,1,2,0)="(PSYCHIATRIC) for five Mental Health Diagnosis Related Groups (DRGs)"
^DIC(9.4,49,22,10,"PAH",445,1,3,0)="in the Charge Item file (#363.2)."
^DIC(9.4,49,22,10,"PAH",446,0)="562 SEQ #519^3160815.124011^54"
^DIC(9.4,49,22,10,"PAH",446,1,0)="^^6^6^3160815"
^DIC(9.4,49,22,10,"PAH",446,1,1,0)="Patch IB*2.0*562 addresses 1 issue:"
^DIC(9.4,49,22,10,"PAH",446,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",446,1,3,0)="1.)     Numerous sites have reported an issue with intermittent records "
^DIC(9.4,49,22,10,"PAH",446,1,4,0)="of the Special Inpatient Billing Cases File (#351.2) not having discharge "
^DIC(9.4,49,22,10,"PAH",446,1,5,0)="dates when this information is present in the Patient Movement File "
^DIC(9.4,49,22,10,"PAH",446,1,6,0)="(#405).  "
^DIC(9.4,49,22,10,"PAH",447,0)="550^3160829.125628^54"
^DIC(9.4,49,22,10,"PAH",447,1,0)="^^1^1^3160829"
^DIC(9.4,49,22,10,"PAH",447,1,1,0)="MCCF ePharmacy Compliance Phase 3"
^DIC(9.4,49,22,10,"PAH",448,0)="547 SEQ #521^3160902.134331^54"
^DIC(9.4,49,22,10,"PAH",449,0)="569 SEQ #522^3160902.134728^54"
^DIC(9.4,49,22,10,"PAH",449,1,0)="^^3^3^3160902"
^DIC(9.4,49,22,10,"PAH",449,1,1,0)="This patch will update the administrative charge based on a new"
^DIC(9.4,49,22,10,"PAH",449,1,2,0)="dispensing fee $14.29 for third party pharmacy prescription claims with"
^DIC(9.4,49,22,10,"PAH",449,1,3,0)="an effective date of January 1st, 2016."
^DIC(9.4,49,22,10,"PAH",450,0)="517 SEQ #523^3160902.13492^54"
^DIC(9.4,49,22,10,"PAH",451,0)="572 SEQ #524^3160916.133413^54"
^DIC(9.4,49,22,10,"PAH",451,1,0)="^^8^8^3160916"
^DIC(9.4,49,22,10,"PAH",451,1,1,0)="Previously released patch IB*2.0*561 applied default revenue code 124 "
^DIC(9.4,49,22,10,"PAH",451,1,2,0)="(PSYCHIATRIC) to five Mental Health Diagnosis Related Groups (DRGs) 881, "
^DIC(9.4,49,22,10,"PAH",451,1,3,0)="882, 883, 885 and 886.  These charge items included R&B (Room & Board)"
^DIC(9.4,49,22,10,"PAH",451,1,4,0)="101, Intensive Care Unit 200, and Ancillary Services 240 in the CHARGE"
^DIC(9.4,49,22,10,"PAH",451,1,5,0)="ITEM file (#363.2)."
^DIC(9.4,49,22,10,"PAH",451,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",451,1,7,0)="This patch will still apply default code 124 to R&B but remove it for"
^DIC(9.4,49,22,10,"PAH",451,1,8,0)="Intensive Care Unit 200, and Ancillary Services 240."
^DIC(9.4,49,22,10,"PAH",452,0)="549^3160916.142324^54"
^DIC(9.4,49,22,10,"PAH",453,0)="571 SEQ #526^3160923.155235^54"
^DIC(9.4,49,22,10,"PAH",453,1,0)="^^2^2^3160923"
^DIC(9.4,49,22,10,"PAH",453,1,1,0)="This patch updates Integrated Billing Clinic Stop Codes to reflect "
^DIC(9.4,49,22,10,"PAH",453,1,2,0)="Fiscal Year 2017 changes."
^DIC(9.4,49,22,10,"PAH",454,0)="570 SEQ #527^3161006.124528^54"
^DIC(9.4,49,22,10,"PAH",454,1,0)="^^6^6^3161006"
^DIC(9.4,49,22,10,"PAH",454,1,1,0)="This patch contains two updates:"
^DIC(9.4,49,22,10,"PAH",454,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",454,1,3,0)="* 68 Cost Based and Inter-Agency billing rates with an effective date of "
^DIC(9.4,49,22,10,"PAH",454,1,4,0)="  07/07/2016 in the CHARGE ITEM file (#363.2)."
^DIC(9.4,49,22,10,"PAH",454,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",454,1,6,0)="* 1 Condition Code in the MCCR UTILITY file (#399.1)."
^DIC(9.4,49,22,10,"PAH",455,0)="567 SEQ #528^3161028.150621^54"
^DIC(9.4,49,22,10,"PAH",455,1,0)="^^2^2^3161028"
^DIC(9.4,49,22,10,"PAH",455,1,1,0)="This patch will update the PAYER file (#365.12) with any missing"
^DIC(9.4,49,22,10,"PAH",455,1,2,0)="entries."
^DIC(9.4,49,22,10,"PAH",456,0)="580 SEQ #529^3161201.154121^54"
^DIC(9.4,49,22,10,"PAH",456,1,0)="^^3^3^3161201"
^DIC(9.4,49,22,10,"PAH",456,1,1,0)="This patch will correct the cost based and interagency charge rates for"
^DIC(9.4,49,22,10,"PAH",456,1,2,0)="Polytrauma and PM&RS (Physical Medicine & Rehabilitation Service)"
^DIC(9.4,49,22,10,"PAH",456,1,3,0)="being reversed with the release of IB*2.0*570."
^DIC(9.4,49,22,10,"PAH",457,0)="573 SEQ #530^3161212.120749^54"
^DIC(9.4,49,22,10,"PAH",457,1,0)="^^1^1^3161212"
^DIC(9.4,49,22,10,"PAH",457,1,1,0)="Reasonable Charges v3.19"
^DIC(9.4,49,22,10,"PAH",458,0)="565 SEQ #531^3161220.150203^54"
^DIC(9.4,49,22,10,"PAH",458,1,0)="^^6^6^3161220"
^DIC(9.4,49,22,10,"PAH",458,1,1,0)="This patch addresses two issues. The first issue contains a PARAMETER "
^DIC(9.4,49,22,10,"PAH",458,1,2,0)="error related to a group plan's comment in the Move Subscribers to a"
^DIC(9.4,49,22,10,"PAH",458,1,3,0)="Different Plan [IBCN MOVE SUBSCRIB TO PLAN] option. The second issue is"
^DIC(9.4,49,22,10,"PAH",458,1,4,0)="regarding numerous claim tracking entries incorrectly filled with the"
^DIC(9.4,49,22,10,"PAH",458,1,5,0)="visit date/time for inpatient events in the Admit a Patient [DG ADMIT"
^DIC(9.4,49,22,10,"PAH",458,1,6,0)="PATIENT] option."
^DIC(9.4,49,22,10,"PAH",459,0)="563^3161220.152252^54"
^DIC(9.4,49,22,10,"PAH",460,0)="574 SEQ #533^3161220.153532^54"
^DIC(9.4,49,22,10,"PAH",460,1,0)="^^210^210^3161220"
^DIC(9.4,49,22,10,"PAH",460,1,1,0)="Description:"
^DIC(9.4,49,22,10,"PAH",460,1,2,0)="==========="
^DIC(9.4,49,22,10,"PAH",460,1,3,0)="MCCF (Medical Care Collection Fund) warranty fix for the FY15 eBilling "
^DIC(9.4,49,22,10,"PAH",460,1,4,0)="Compliance Phase 3 project."
^DIC(9.4,49,22,10,"PAH",460,1,5,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,6,0)="This patch contains a fix for the installed patch IB*2.0*547.  When "
^DIC(9.4,49,22,10,"PAH",460,1,7,0)="testing with FSC, customer reported that they are not able to enter a "
^DIC(9.4,49,22,10,"PAH",460,1,8,0)="professional alternate payer ID on Bill Screen 10 when the charge type is "
^DIC(9.4,49,22,10,"PAH",460,1,9,0)="institutional and the form type is a CMS-1500.  The version of routine "
^DIC(9.4,49,22,10,"PAH",460,1,10,0)="IBCSC10 released in IB*2.0*547 does not handle this scenario correctly."
^DIC(9.4,49,22,10,"PAH",460,1,11,0)="This warranty patch corrects this defect in routine IBCSC10."
^DIC(9.4,49,22,10,"PAH",460,1,12,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,13,0)="In addition, requirements defects were also discovered.  There were "
^DIC(9.4,49,22,10,"PAH",460,1,14,0)="several changes made in patch 547 to remove the printing and transmission "
^DIC(9.4,49,22,10,"PAH",460,1,15,0)="of admission dates on all outpatient claims.  During the warranty period "
^DIC(9.4,49,22,10,"PAH",460,1,16,0)="it was discovered that Outpatient Home Health and Outpatient Hospice "
^DIC(9.4,49,22,10,"PAH",460,1,17,0)="claims still require the admission date and time or they will be rejected.  "
^DIC(9.4,49,22,10,"PAH",460,1,18,0)=" "
^DIC(9.4,49,22,10,"PAH",460,1,19,0)="A function ($$HHLTH) was added to routine IBCEF1 to determine if a claim is "
^DIC(9.4,49,22,10,"PAH",460,1,20,0)="Home Health or Hospice.  This function was inserted into entries #77, 98 "
^DIC(9.4,49,22,10,"PAH",460,1,21,0)="and #1305 of file 364.7 to output the date for all inpatient claims AND "
^DIC(9.4,49,22,10,"PAH",460,1,22,0)="all Outpatient home health and hospice claims."
^DIC(9.4,49,22,10,"PAH",460,1,23,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,24,0)="The purpose of this patch is to meet the requirements for the MCCF "
^DIC(9.4,49,22,10,"PAH",460,1,25,0)="eBilling Compliance Phase 3 project related to Integrated Billing (IB)."
^DIC(9.4,49,22,10,"PAH",460,1,26,0)="Integrated Billing is a software module within Veterans Health Information"
^DIC(9.4,49,22,10,"PAH",460,1,27,0)="Systems and Technology Architecture (VistA) that provides the ability for"
^DIC(9.4,49,22,10,"PAH",460,1,28,0)="billing personnel to submit claims in either a paper or electronic format"
^DIC(9.4,49,22,10,"PAH",460,1,29,0)="to third-party payers. "
^DIC(9.4,49,22,10,"PAH",460,1,30,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,31,0)="     "
^DIC(9.4,49,22,10,"PAH",460,1,32,0)="Patch Components"
^DIC(9.4,49,22,10,"PAH",460,1,33,0)="================"
^DIC(9.4,49,22,10,"PAH",460,1,34,0)="       "
