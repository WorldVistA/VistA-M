^DIC(9.4,3,22,21,"PAH",144,1,30,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",144,1,31,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",144,1,32,0)=""
^DIC(9.4,3,22,21,"PAH",144,1,33,0)=">>>Do not allow users to log in to the system during installation."
^DIC(9.4,3,22,21,"PAH",144,1,34,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",144,1,35,0)=">>>Taskman does not need to be stopped."
^DIC(9.4,3,22,21,"PAH",144,1,36,0)=""
^DIC(9.4,3,22,21,"PAH",144,1,37,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",144,1,38,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",144,1,39,0)="     "
^DIC(9.4,3,22,21,"PAH",144,1,40,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",144,1,41,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",144,1,42,0)="     "
^DIC(9.4,3,22,21,"PAH",144,1,43,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",144,1,44,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",144,1,45,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",144,1,46,0)="      options:"
^DIC(9.4,3,22,21,"PAH",144,1,47,0)="      "
