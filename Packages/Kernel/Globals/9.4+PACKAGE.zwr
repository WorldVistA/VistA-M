^DIC(9.4,191,0)="FOUNDATIONS^XOBU"
^DIC(9.4,191,1,0)="^^5^5^3030903^"
^DIC(9.4,191,1,1,0)="Contains common files, libraries, etc. used by all the XOB*"
^DIC(9.4,191,1,2,0)="packages.  "
^DIC(9.4,191,1,3,0)=" "
^DIC(9.4,191,1,4,0)="Also, contains options, protocols and list templates used to"
^DIC(9.4,191,1,5,0)="manage Foundations site parameters and operations."
^DIC(9.4,191,20,0)="^9.402P^^"
^DIC(9.4,191,22,0)="^9.49I^3^3"
^DIC(9.4,191,22,1,0)="1.0^3120508^3031121^1"
^DIC(9.4,191,22,1,1,0)="^^5^5^3120508"
^DIC(9.4,191,22,1,1,1,0)="This build contains common files, libraries, etc. used by all the XOB* "
^DIC(9.4,191,22,1,1,2,0)="packages."
^DIC(9.4,191,22,1,1,3,0)=" "
^DIC(9.4,191,22,1,1,4,0)="It also contains options, protocols and list templates used to manage "
^DIC(9.4,191,22,1,1,5,0)="Foundations site parameters and operations."
^DIC(9.4,191,22,2,0)="1.5^3050909^3060608^1"
^DIC(9.4,191,22,2,1,0)="^^7^7^3060608"
^DIC(9.4,191,22,2,1,1,0)="This build contains common files, libraries, etc. used by all the XOB* "
^DIC(9.4,191,22,2,1,2,0)="packages."
^DIC(9.4,191,22,2,1,3,0)=" "
^DIC(9.4,191,22,2,1,4,0)="It also contains options, protocols and list templates used to manage "
^DIC(9.4,191,22,2,1,5,0)="Foundations site parameters and operations."
^DIC(9.4,191,22,2,1,6,0)=" "
^DIC(9.4,191,22,2,1,7,0)="[Build: 1.5.0.026]"
^DIC(9.4,191,22,3,0)="1.6^3090508^3110120^17"
^DIC(9.4,191,22,3,1,0)="^^5^5^3110120"
^DIC(9.4,191,22,3,1,1,0)="This build contains common files, libraries, etc. used by all the XOB* "
^DIC(9.4,191,22,3,1,2,0)="packages."
^DIC(9.4,191,22,3,1,3,0)=" "
^DIC(9.4,191,22,3,1,4,0)="It also contains options, protocols and list templates used to manage "
^DIC(9.4,191,22,3,1,5,0)="Foundations site parameters and operations."
