^DIC(9.4,59,22,5,"PAH",99,1,0)="^^16^16^3060308"
^DIC(9.4,59,22,5,"PAH",99,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",99,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",99,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",99,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",99,1,5,0)="This patch generates three mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",99,1,6,0)="and all are sent to members of the NDF DATA mail group, holders of the"
^DIC(9.4,59,22,5,"PAH",99,1,7,0)="PSNMGR security key, and the person installing the patch.  The first"
^DIC(9.4,59,22,5,"PAH",99,1,8,0)="message, with the subject DATA UPDATE FOR NDF, lists new products,"
^DIC(9.4,59,22,5,"PAH",99,1,9,0)="CMOP ID (if one exists), dispense units, and associated NDCs,"
^DIC(9.4,59,22,5,"PAH",99,1,10,0)="products for which the national formulary indicator has changed,"
^DIC(9.4,59,22,5,"PAH",99,1,11,0)="products that have been unmatched from CMOP, and products for which"
^DIC(9.4,59,22,5,"PAH",99,1,12,0)="the national formulary restriction has changed.  The second,"
^DIC(9.4,59,22,5,"PAH",99,1,13,0)="with the subject UPDATED INTERACTIONS, lists interactions that"
^DIC(9.4,59,22,5,"PAH",99,1,14,0)="have been added, edited, or inactivated. The third, with the subject"
^DIC(9.4,59,22,5,"PAH",99,1,15,0)="DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the DRUG file"
^DIC(9.4,59,22,5,"PAH",99,1,16,0)="(#50) which have been unmatched from NDF."
^DIC(9.4,59,22,5,"PAH",100,0)="112 SEQ #100^3060410^1"
^DIC(9.4,59,22,5,"PAH",100,1,0)="^^6^6^3060410"
^DIC(9.4,59,22,5,"PAH",100,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",100,1,2,0)="The input transform on the VUID field (#99.99) in the DRUG INGREDIENTS file"
^DIC(9.4,59,22,5,"PAH",100,1,3,0)="(#50.416) became corrupted in such a way that editing that field would cause"
^DIC(9.4,59,22,5,"PAH",100,1,4,0)="a syntax error.  That field is not edited at VAMCs.  This patch corrects"
^DIC(9.4,59,22,5,"PAH",100,1,5,0)="the syntax of that input transform."
^DIC(9.4,59,22,5,"PAH",100,1,6,0)=" "
^DIC(9.4,59,22,5,"PAH",101,0)="113 SEQ #101^3060410^1"
^DIC(9.4,59,22,5,"PAH",101,1,0)="^^7^7^3060410"
^DIC(9.4,59,22,5,"PAH",101,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",101,1,2,0)="Under certain circumstances, if an entry in the VA PRODUCT file (#50.68)"
^DIC(9.4,59,22,5,"PAH",101,1,3,0)="was reactivated - that is if the INACTIVATION DATE field (#21) was deleted -"
^DIC(9.4,59,22,5,"PAH",101,1,4,0)="this deletion was not captured in the VA FileMan audits and therefore was"
^DIC(9.4,59,22,5,"PAH",101,1,5,0)="not transmitted to the field.  The cause of this problem has been removed."
^DIC(9.4,59,22,5,"PAH",101,1,6,0)="This patch corrects those entries which have an inactivation date but"
^DIC(9.4,59,22,5,"PAH",101,1,7,0)="should not."
^DIC(9.4,59,22,5,"PAH",102,0)="107 SEQ #102^3060410^1"
^DIC(9.4,59,22,5,"PAH",102,1,0)="^^57^57^3060410"
^DIC(9.4,59,22,5,"PAH",102,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,3,0)="It has been noted that several sites have made local entries in the DRUG"
^DIC(9.4,59,22,5,"PAH",102,1,4,0)="INGREDIENTS file (#50.416).  This should not have been done.  Patch"
^DIC(9.4,59,22,5,"PAH",102,1,5,0)="PSN*4*89 changed the data dictionary of that file to prevent further"
^DIC(9.4,59,22,5,"PAH",102,1,6,0)="additions.  Some of these local entries may have already been overwritten"
^DIC(9.4,59,22,5,"PAH",102,1,7,0)="by national entries."
^DIC(9.4,59,22,5,"PAH",102,1,8,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,9,0)="It has also been noted that some sites have added local entries in the"
^DIC(9.4,59,22,5,"PAH",102,1,10,0)="DRUG INTERACTION file (#56) involving these locally added ingredients."
^DIC(9.4,59,22,5,"PAH",102,1,11,0)="If the locally added ingredients have been overwritten, these interactions"
^DIC(9.4,59,22,5,"PAH",102,1,12,0)="will check for ingredients other than those indicated by the name of the"
^DIC(9.4,59,22,5,"PAH",102,1,13,0)="interaction."
^DIC(9.4,59,22,5,"PAH",102,1,14,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,15,0)="This patch performs six functions."
^DIC(9.4,59,22,5,"PAH",102,1,16,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,17,0)="1.  It creates a new style cross-reference on the NAME field (#.01) and the"
^DIC(9.4,59,22,5,"PAH",102,1,18,0)="    PRIMARY INGREDIENT field (#2) of the DRUG INGREDIENTS file (#50.416). "
^DIC(9.4,59,22,5,"PAH",102,1,19,0)="    This new cross-reference replaces the old ""P"" cross-reference on the"
^DIC(9.4,59,22,5,"PAH",102,1,20,0)="    NAME field (#.01). The ""P"" cross reference was not working properly"
^DIC(9.4,59,22,5,"PAH",102,1,21,0)="    and included entries that should not have been referenced. This"
^DIC(9.4,59,22,5,"PAH",102,1,22,0)="    corrects the Patient Safety Issue PSI-05-008."
^DIC(9.4,59,22,5,"PAH",102,1,23,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,24,0)="2.  Any entries in the DRUG INGREDIENTS file (#50.416) with an internal"
^DIC(9.4,59,22,5,"PAH",102,1,25,0)="    entry number (IEN) greater than that of the last nationally entered"
^DIC(9.4,59,22,5,"PAH",102,1,26,0)="    ingredient will be deleted. These would be locally entered ingredients"
^DIC(9.4,59,22,5,"PAH",102,1,27,0)="    that would eventually be overwritten with national ingredients released"
^DIC(9.4,59,22,5,"PAH",102,1,28,0)="    with NDF Data Updates."
^DIC(9.4,59,22,5,"PAH",102,1,29,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,30,0)="3.  Any entries in the DRUG INTERACTIONS file (#56) which have ingredients"
^DIC(9.4,59,22,5,"PAH",102,1,31,0)="    pointing to these deleted locally entered ingredients will be deleted."
^DIC(9.4,59,22,5,"PAH",102,1,32,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,33,0)="4.  Any entries in the DRUG INTERACTIONS file (#56) which point to ingredients"
^DIC(9.4,59,22,5,"PAH",102,1,34,0)="    other than those indicated by the name will be deleted. These would "
^DIC(9.4,59,22,5,"PAH",102,1,35,0)="    be interactions created with a locally entered ingredient that was"
^DIC(9.4,59,22,5,"PAH",102,1,36,0)="    subsequently overwritten by a national ingredient."
^DIC(9.4,59,22,5,"PAH",102,1,37,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,38,0)="5.  A mail message with the subject INGREDIENTS AND INTERACTIONS DELETED"
^DIC(9.4,59,22,5,"PAH",102,1,39,0)="    will be sent from NDF MANAGER to members of the mail group NDF DATA,"
^DIC(9.4,59,22,5,"PAH",102,1,40,0)="    holders of the PSNMGR security key, and the person installing the"
^DIC(9.4,59,22,5,"PAH",102,1,41,0)="    patch.  This message lists deleted ingredients, interactions deleted"
^DIC(9.4,59,22,5,"PAH",102,1,42,0)="    because they pointed to deleted ingredients, and interactions which"
^DIC(9.4,59,22,5,"PAH",102,1,43,0)="    pointed to ingredients other than those indicated in the name.  In"
^DIC(9.4,59,22,5,"PAH",102,1,44,0)="    the last case, both the name (containing the original ingredients)"
^DIC(9.4,59,22,5,"PAH",102,1,45,0)="    and the current ingredients are displayed."
^DIC(9.4,59,22,5,"PAH",102,1,46,0)=" "
^DIC(9.4,59,22,5,"PAH",102,1,47,0)="6.  The GMR ALLERGY field (#1) and the DRUG INGREDIENT field (#.01)"
^DIC(9.4,59,22,5,"PAH",102,1,48,0)="    of the DRUG INGREDIENTS multiple field (#2) in the PATIENT ALLERGIES file"
^DIC(9.4,59,22,5,"PAH",102,1,49,0)="    (#120.8) and the DRUG INGREDIENT field (#.01) of the DRUG INGREDIENTS"
^DIC(9.4,59,22,5,"PAH",102,1,50,0)="    multiple field (#2) in the GMR ALLERGIES file (#120.82) point to the"
^DIC(9.4,59,22,5,"PAH",102,1,51,0)="    DRUG INGREDIENTS file (#50.416).  Any entries in these fields that"
^DIC(9.4,59,22,5,"PAH",102,1,52,0)="    point to ingredients that were deleted as described in item 2 above"
^DIC(9.4,59,22,5,"PAH",102,1,53,0)="    will be deleted.  In addition, the selection of drug ingredients in the"
^DIC(9.4,59,22,5,"PAH",102,1,54,0)="    PATIENT ALLERGIES file (#120.8) should allow the selection of only"
^DIC(9.4,59,22,5,"PAH",102,1,55,0)="    primary ingredients.  Any entries that point to ingredients that are"
^DIC(9.4,59,22,5,"PAH",102,1,56,0)="    not primary ingredients will be repointed to the proper primary"
^DIC(9.4,59,22,5,"PAH",102,1,57,0)="    ingredient."
^DIC(9.4,59,22,5,"PAH",103,0)="114^3060504^1"
^DIC(9.4,59,22,5,"PAH",103,1,0)="^^16^16^3060504"
^DIC(9.4,59,22,5,"PAH",103,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",103,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",103,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",103,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",103,1,5,0)="This patch generates three mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",103,1,6,0)="and all are sent to members of the NDF DATA mail group, holders of the"
^DIC(9.4,59,22,5,"PAH",103,1,7,0)="PSNMGR security key, and the person installing the patch.  The first"
^DIC(9.4,59,22,5,"PAH",103,1,8,0)="message, with the subject DATA UPDATE FOR NDF, lists new products,"
^DIC(9.4,59,22,5,"PAH",103,1,9,0)="CMOP ID (if one exists), dispense units, and associated NDCs,"
^DIC(9.4,59,22,5,"PAH",103,1,10,0)="products for which the national formulary indicator has changed,"
^DIC(9.4,59,22,5,"PAH",103,1,11,0)="products that have been unmatched from CMOP, and products for which"
^DIC(9.4,59,22,5,"PAH",103,1,12,0)="the national formulary restriction has changed.  The second,"
^DIC(9.4,59,22,5,"PAH",103,1,13,0)="with the subject UPDATED INTERACTIONS, lists interactions that"
^DIC(9.4,59,22,5,"PAH",103,1,14,0)="have been added, edited, or inactivated. The third, with the subject"
^DIC(9.4,59,22,5,"PAH",103,1,15,0)="DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the DRUG file"
^DIC(9.4,59,22,5,"PAH",103,1,16,0)="(#50) which have been unmatched from NDF."
^DIC(9.4,59,22,5,"PAH",104,0)="115^3060504^1"
^DIC(9.4,59,22,5,"PAH",104,1,0)="^^16^16^3060504"
^DIC(9.4,59,22,5,"PAH",104,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",104,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",104,1,3,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",104,1,4,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",104,1,5,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",104,1,6,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",104,1,7,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",104,1,8,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",104,1,9,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",104,1,10,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",104,1,11,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",104,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",104,1,13,0)="The post-install routine for this patch, PSN106P, deletes existing"
^DIC(9.4,59,22,5,"PAH",104,1,14,0)="entries in these files, loads the new data, and rematches entries in"
^DIC(9.4,59,22,5,"PAH",104,1,15,0)="the VA PRODUCT file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",104,1,16,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",105,0)="120 SEQ #105^3060525^1"
^DIC(9.4,59,22,5,"PAH",105,1,0)="^^4^4^3060525"
^DIC(9.4,59,22,5,"PAH",105,1,1,0)="During the installation of patch PSN*4*107, certain cross references in"
^DIC(9.4,59,22,5,"PAH",105,1,2,0)="the DRUG INTERACTION file (#56) were not properly deleted.  This has"
^DIC(9.4,59,22,5,"PAH",105,1,3,0)="caused some problems with the installation of day update patch PSN*4*114."
^DIC(9.4,59,22,5,"PAH",105,1,4,0)="This patch corrects that problem."
^DIC(9.4,59,22,5,"PAH",106,0)="116 SEQ #106^3060711^1"
^DIC(9.4,59,22,5,"PAH",106,1,0)="^^1^1^3060711"
^DIC(9.4,59,22,5,"PAH",106,1,1,0)="DRUG INTERACTION REPORT NOT SHOWING INACTIVATION DATE"
^DIC(9.4,59,22,5,"PAH",107,0)="103 SEQ #107^3060711^1"
^DIC(9.4,59,22,5,"PAH",107,1,0)="^^60^60^3060711"
^DIC(9.4,59,22,5,"PAH",107,1,1,0)="This NATIONAL DRUG FILE (NDF) patch is part of the Patient Financial"
^DIC(9.4,59,22,5,"PAH",107,1,2,0)="Services System (PFSS) project. PFSS patches are being released on various"
^DIC(9.4,59,22,5,"PAH",107,1,3,0)="schedules. Some patch functionality will not be active until a new PFSS"
^DIC(9.4,59,22,5,"PAH",107,1,4,0)="switch is activated during final implementation. PFSS will initially be"
^DIC(9.4,59,22,5,"PAH",107,1,5,0)="implemented at select pilot sites ONLY."
^DIC(9.4,59,22,5,"PAH",107,1,6,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,7,0)="The purpose of the PFSS project is to prepare the Veterans Health"
^DIC(9.4,59,22,5,"PAH",107,1,8,0)="Information Systems and Technology Architecture (VistA) environment for"
^DIC(9.4,59,22,5,"PAH",107,1,9,0)="the implementation of a commercial off-the-shelf (COTS) billing"
^DIC(9.4,59,22,5,"PAH",107,1,10,0)="replacement system. The project consists of the implementation of the"
^DIC(9.4,59,22,5,"PAH",107,1,11,0)="billing replacement system, business process improvements, and"
^DIC(9.4,59,22,5,"PAH",107,1,12,0)="enhancements to VistA to support integration with the COTS billing"
^DIC(9.4,59,22,5,"PAH",107,1,13,0)="replacement system. Significant changes to VistA legacy systems and"
^DIC(9.4,59,22,5,"PAH",107,1,14,0)="ancillary packages are necessary."
^DIC(9.4,59,22,5,"PAH",107,1,15,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,16,0)="Some of the PFSS software components are not operational until the PFSS"
^DIC(9.4,59,22,5,"PAH",107,1,17,0)="On/Off Switch, distributed with patch IB*2*260, is set to ""ON"". The"
^DIC(9.4,59,22,5,"PAH",107,1,18,0)="ability for the local site to set the switch to ""ON"" will be provided at"
^DIC(9.4,59,22,5,"PAH",107,1,19,0)="the appropriate time with the release of a subsequent Integrated Billing"
^DIC(9.4,59,22,5,"PAH",107,1,20,0)="patch."
^DIC(9.4,59,22,5,"PAH",107,1,21,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,22,0)="For more information about the PFSS project, review the documentation"
^DIC(9.4,59,22,5,"PAH",107,1,23,0)="accompanying this patch and refer to the following website:"
^DIC(9.4,59,22,5,"PAH",107,1,24,0)="http://vista.domain.ext/billreplace/."
^DIC(9.4,59,22,5,"PAH",107,1,25,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,26,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,27,0)="Functional Description:"
^DIC(9.4,59,22,5,"PAH",107,1,28,0)="======================="
^DIC(9.4,59,22,5,"PAH",107,1,29,0)="The Charge Description Master (CDM) is an industry standard financial tool"
^DIC(9.4,59,22,5,"PAH",107,1,30,0)="common to all commercial billing systems and used in virtually every"
^DIC(9.4,59,22,5,"PAH",107,1,31,0)="private hospital. The CDM is a comprehensive listing of all services"
^DIC(9.4,59,22,5,"PAH",107,1,32,0)="performed, drugs supplied, or supplies provided in a particular hospital"
^DIC(9.4,59,22,5,"PAH",107,1,33,0)="along with the value of those services/drugs/items, or charge amounts."
^DIC(9.4,59,22,5,"PAH",107,1,34,0)="Each of these entries are represented by a Charge Code, and the Charge"
^DIC(9.4,59,22,5,"PAH",107,1,35,0)="Code is made up of a Department Code and Service Code. The Charge Code for"
^DIC(9.4,59,22,5,"PAH",107,1,36,0)="Pharmacy will be the Department Code 160 concatenated with the assigned"
^DIC(9.4,59,22,5,"PAH",107,1,37,0)="Service Code for the drug. The Department Code 160 will not be stored in"
^DIC(9.4,59,22,5,"PAH",107,1,38,0)="any files and the Service Code will be established/approved by a central"
^DIC(9.4,59,22,5,"PAH",107,1,39,0)="CDM Change Control Board (CCB). The implementation of the COTS billing"
^DIC(9.4,59,22,5,"PAH",107,1,40,0)="system requires the VA PRODUCT file (#50.68) to link the service master"
^DIC(9.4,59,22,5,"PAH",107,1,41,0)="Service Code to every Pharmacy prescription fill or refill. Pharmacy will"
^DIC(9.4,59,22,5,"PAH",107,1,42,0)="create and populate a Service Code (in the 600,001 - 699,999 range) for"
^DIC(9.4,59,22,5,"PAH",107,1,43,0)="each entry in the VA PRODUCT file (#50.68). Initially, the Service Code"
^DIC(9.4,59,22,5,"PAH",107,1,44,0)="will be populated by this patch and subsequently the CDM CCB assigned"
^DIC(9.4,59,22,5,"PAH",107,1,45,0)="Service Codes will be distributed as data update patches within the NDF"
^DIC(9.4,59,22,5,"PAH",107,1,46,0)="releases."
^DIC(9.4,59,22,5,"PAH",107,1,47,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,48,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,49,0)="Technical Description:"
^DIC(9.4,59,22,5,"PAH",107,1,50,0)="======================"
^DIC(9.4,59,22,5,"PAH",107,1,51,0)="This NDF patch PSN*4*103 provides the following functionality needed to"
^DIC(9.4,59,22,5,"PAH",107,1,52,0)="support the PFSS project:"
^DIC(9.4,59,22,5,"PAH",107,1,53,0)=" "
^DIC(9.4,59,22,5,"PAH",107,1,54,0)="1. A new SERVICE CODE field (#2000) was added to the VA PRODUCT file"
^DIC(9.4,59,22,5,"PAH",107,1,55,0)="   (#50.68)."
^DIC(9.4,59,22,5,"PAH",107,1,56,0)="2. A Post-install routine that initially populates the new SERVICE"
^DIC(9.4,59,22,5,"PAH",107,1,57,0)="   CODE field (#2000) for every entry in the VA PRODUCT file (#50.68) with"
^DIC(9.4,59,22,5,"PAH",107,1,58,0)="   a six digit number to be within the range 600001-699999. The logic"
^DIC(9.4,59,22,5,"PAH",107,1,59,0)="   comprises of the Internal Entry number (IEN) padding it with zeroes as"
^DIC(9.4,59,22,5,"PAH",107,1,60,0)="   needed and adding a ""6"" on the front to make up a six digit number."
^DIC(9.4,59,22,5,"PAH",108,0)="118^3060711^1"
^DIC(9.4,59,22,5,"PAH",108,1,0)="^^14^14^3060711"
^DIC(9.4,59,22,5,"PAH",108,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",108,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",108,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",108,1,4,0)="This patch generates three mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",108,1,5,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",108,1,6,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",108,1,7,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",108,1,8,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",108,1,9,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",108,1,10,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",108,1,11,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",108,1,12,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",108,1,13,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",108,1,14,0)="DRUG file (#50) which have been unmatched from NDF."
^DIC(9.4,59,22,5,"PAH",109,0)="119^3060711^1"
^DIC(9.4,59,22,5,"PAH",109,1,0)="^^18^18^3060711"
^DIC(9.4,59,22,5,"PAH",109,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",109,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",109,1,3,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",109,1,4,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",109,1,5,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",109,1,6,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",109,1,7,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",109,1,8,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",109,1,9,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",109,1,10,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",109,1,11,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",109,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",109,1,13,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",109,1,14,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",109,1,15,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",109,1,16,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",109,1,17,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",109,1,18,0)="The source of the data for the PMIs is First Data Bank."
^DIC(9.4,59,22,5,"PAH",110,0)="121^3060923^1"
^DIC(9.4,59,22,5,"PAH",110,1,0)="^^14^14^3060923"
^DIC(9.4,59,22,5,"PAH",110,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",110,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",110,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",110,1,4,0)="This patch generates three mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",110,1,5,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",110,1,6,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",110,1,7,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
