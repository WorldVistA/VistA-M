^DIC(9.4,4,22,1,"PAH",152,1,0)="^^119^119^3010529"
^DIC(9.4,4,22,1,"PAH",152,1,1,0)="Patch XM*7.1*51"
^DIC(9.4,4,22,1,"PAH",152,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,3,0)="Test Sites:  Montana HCS; Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",152,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,5,0)="NOIS: DET-0898-40391, CIH-1197-40757, ALL-0297-41999, BTM-1095-10195"
^DIC(9.4,4,22,1,"PAH",152,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,7,0)="Patch XM*7.1*50, released August 1999, added "".DOMAIN.EXT"" synonyms in the"
^DIC(9.4,4,22,1,"PAH",152,1,8,0)="DOMAIN file for every site which requested it.  It also added new names as"
^DIC(9.4,4,22,1,"PAH",152,1,9,0)="synonyms for sites which have merged or which requested and had name changes"
^DIC(9.4,4,22,1,"PAH",152,1,10,0)="approved. "
^DIC(9.4,4,22,1,"PAH",152,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,12,0)="This patch will complete the 2-step domain name change process begun in patch"
^DIC(9.4,4,22,1,"PAH",152,1,13,0)="XM*7.1*50. The synonyms will become the new domain names, and the old domain"
^DIC(9.4,4,22,1,"PAH",152,1,14,0)="names will become the synonyms.  The domain names will be changed in the"
^DIC(9.4,4,22,1,"PAH",152,1,15,0)="transmission scripts.  The names of the transmission queues will be changed."
^DIC(9.4,4,22,1,"PAH",152,1,16,0)="(These are the Postmaster's baskets where the messages waiting to be"
^DIC(9.4,4,22,1,"PAH",152,1,17,0)="transmitted are kept.)  And finally, the domain name of the site will be"
^DIC(9.4,4,22,1,"PAH",152,1,18,0)="changed, too, if it is one of the sites which requested it. "
^DIC(9.4,4,22,1,"PAH",152,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,20,0)="This will all happen automatically, during the post-init.  It should take"
^DIC(9.4,4,22,1,"PAH",152,1,21,0)="less than 5 minutes.  You will be instructed to review the install file print"
^DIC(9.4,4,22,1,"PAH",152,1,22,0)="to check for and correct any errors after the patch has been installed. "
^DIC(9.4,4,22,1,"PAH",152,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,24,0)="The domain name changes will not adversely affect the flow of mail."
^DIC(9.4,4,22,1,"PAH",152,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,26,0)="This patch will also begin the 2-step domain name change process for the"
^DIC(9.4,4,22,1,"PAH",152,1,27,0)="second round of domain name changes.  It will add as synonyms the desired"
^DIC(9.4,4,22,1,"PAH",152,1,28,0)="new names for sites which requested it.  For all other VA sites, which did"
^DIC(9.4,4,22,1,"PAH",152,1,29,0)="not express any interest in changing their names, it will add a synonym of"
^DIC(9.4,4,22,1,"PAH",152,1,30,0)="xxx.DOMAIN.EXT.  A future patch will complete the domain name change"
^DIC(9.4,4,22,1,"PAH",152,1,31,0)="process, once all sites have installed this patch."
^DIC(9.4,4,22,1,"PAH",152,1,32,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,33,0)="NOTE: This patch requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",152,1,34,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",152,1,35,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,36,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",152,1,37,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",152,1,38,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",152,1,39,0)=" "
^DIC(9.4,4,22,1,"PAH",152,1,40,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",152,1,41,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",152,1,42,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",152,1,43,0)="XMUDNC         3683283        13102674        50,51"
^DIC(9.4,4,22,1,"PAH",152,1,44,0)="XMYPOSTA       2107256         4556859        50,51"
^DIC(9.4,4,22,1,"PAH",152,1,45,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",152,1,46,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",152,1,47,0)=" "
^DIC(9.4,4,22,1,"PAH",152,1,48,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",152,1,49,0)="NOTE: This patch requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",152,1,50,0)="1.  Users should not be on the system during patch installation."
^DIC(9.4,4,22,1,"PAH",152,1,51,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",152,1,52,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",152,1,53,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",152,1,54,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",152,1,55,0)="4.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",152,1,56,0)="    option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",152,1,57,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",152,1,58,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",152,1,59,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",152,1,60,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",152,1,61,0)="5.  Place TaskMan in a WAIT State.  Shut down the listeners."
^DIC(9.4,4,22,1,"PAH",152,1,62,0)="    You may also wish to shut down HL7 filers/LLP's and other background"
^DIC(9.4,4,22,1,"PAH",152,1,63,0)="    tasks which may attempt to create new messages.  During the installation"
^DIC(9.4,4,22,1,"PAH",152,1,64,0)="    of this patch, we do not want any messages coming in or going out."
^DIC(9.4,4,22,1,"PAH",152,1,65,0)="    Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",152,1,66,0)="6.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",152,1,67,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",152,1,68,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",152,1,69,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",152,1,70,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",152,1,71,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",152,1,72,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",152,1,73,0)=" Select INSTALL NAME:    XM*7.1*51     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",152,1,74,0)="                         ========="
^DIC(9.4,4,22,1,"PAH",152,1,75,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",152,1,76,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,4,22,1,"PAH",152,1,77,0)="                                                       ==="
^DIC(9.4,4,22,1,"PAH",152,1,78,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// YES"
^DIC(9.4,4,22,1,"PAH",152,1,79,0)="                                                                       ==="
^DIC(9.4,4,22,1,"PAH",152,1,80,0)=" Enter options you wish to mark as 'Out Of Order': XMUSER       MailMan Menu"
^DIC(9.4,4,22,1,"PAH",152,1,81,0)="                                                   ======"
^DIC(9.4,4,22,1,"PAH",152,1,82,0)=" Enter options you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",152,1,83,0)="                                                   =============="
^DIC(9.4,4,22,1,"PAH",152,1,84,0)=" Enter protocols you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",152,1,85,0)="                                                     =============="
^DIC(9.4,4,22,1,"PAH",152,1,86,0)=" Delay Install (Minutes):  (0-60): 0// <press return>"
^DIC(9.4,4,22,1,"PAH",152,1,87,0)="                                       =============="
^DIC(9.4,4,22,1,"PAH",152,1,88,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",152,1,89,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",152,1,90,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",152,1,91,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,92,0)=" DEVICE: HOME// <Do not queue this.>"
^DIC(9.4,4,22,1,"PAH",152,1,93,0)="                --------------------"
^DIC(9.4,4,22,1,"PAH",152,1,94,0)="7.  Remove TaskMan from a WAIT State.  If you shut down HL7 filers/LLP's"
^DIC(9.4,4,22,1,"PAH",152,1,95,0)="    and other background tasks in step 4, be sure to restart them, too."
^DIC(9.4,4,22,1,"PAH",152,1,96,0)="8.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",152,1,97,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",152,1,98,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",152,1,99,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",152,1,100,0)="9.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",152,1,101,0)="10. On the KIDS:Utilites menu, use the following option to review the"
^DIC(9.4,4,22,1,"PAH",152,1,102,0)="install:"
^DIC(9.4,4,22,1,"PAH",152,1,103,0)="    Install File Print"
^DIC(9.4,4,22,1,"PAH",152,1,104,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,105,0)="Review the automatic synonym additions which occurred during the PRE-INIT."
^DIC(9.4,4,22,1,"PAH",152,1,106,0)="If there were any errors noted for a particular domain, that domain did not"
^DIC(9.4,4,22,1,"PAH",152,1,107,0)="have its new name added as a synonym.  (Error messages are preceded by ***,"
^DIC(9.4,4,22,1,"PAH",152,1,108,0)="and tell you what was wrong.)  You must correct the error manually and add"
^DIC(9.4,4,22,1,"PAH",152,1,109,0)="the synonym manually.  Remember, you are not to change any domain name."
^DIC(9.4,4,22,1,"PAH",152,1,110,0)="Just add the new name as a synonym. "
^DIC(9.4,4,22,1,"PAH",152,1,111,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,112,0)="Review the automatic domain name changes which occurred during the POST-INIT."
^DIC(9.4,4,22,1,"PAH",152,1,113,0)="If there were any errors noted for a particular domain, that domain did not"
^DIC(9.4,4,22,1,"PAH",152,1,114,0)="have its name changed.  (Error messages are preceded by ***,"
^DIC(9.4,4,22,1,"PAH",152,1,115,0)="and tell you what was wrong.)  You must correct the error manually and"
^DIC(9.4,4,22,1,"PAH",152,1,116,0)="perform the name change manually."
^DIC(9.4,4,22,1,"PAH",152,1,117,0)=""
^DIC(9.4,4,22,1,"PAH",152,1,118,0)="If you have questions or need any help, please enter a NOIS."
^DIC(9.4,4,22,1,"PAH",152,1,119,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",153,0)="183 SEQ #178^3010529^1"
^DIC(9.4,4,22,1,"PAH",153,1,0)="^^58^58^3010529"
^DIC(9.4,4,22,1,"PAH",153,1,1,0)="Patch XM*7.1*183"
^DIC(9.4,4,22,1,"PAH",153,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",153,1,3,0)="NOIS: MON-0501-50530"
^DIC(9.4,4,22,1,"PAH",153,1,4,0)="Test Site:  Montana HCS"
^DIC(9.4,4,22,1,"PAH",153,1,5,0)="When a surrogate saves messages to the WASTE basket, MailMan allows"
^DIC(9.4,4,22,1,"PAH",153,1,6,0)="confidential messages to be saved, too.  It shouldn't.  This patch fixes"
^DIC(9.4,4,22,1,"PAH",153,1,7,0)="that."
^DIC(9.4,4,22,1,"PAH",153,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",153,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",153,1,10,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",153,1,11,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",153,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",153,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",153,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",153,1,15,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",153,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",153,1,17,0)="             Before       After"
^DIC(9.4,4,22,1,"PAH",153,1,18,0)="Name         Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",153,1,19,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",153,1,20,0)="XMJMORX1      6931876      7025098     50,110,177,183"
^DIC(9.4,4,22,1,"PAH",153,1,21,0)="XMXMSGS2      8054067      8470689     50,106,110,127,131,143,177,183"
^DIC(9.4,4,22,1,"PAH",153,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",153,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",153,1,24,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",153,1,25,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",153,1,26,0)=" "
^DIC(9.4,4,22,1,"PAH",153,1,27,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",153,1,28,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",153,1,29,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",153,1,30,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",153,1,31,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",153,1,32,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",153,1,33,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",153,1,34,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",153,1,35,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",153,1,36,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",153,1,37,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",153,1,38,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",153,1,39,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",153,1,40,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",153,1,41,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",153,1,42,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",153,1,43,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",153,1,44,0)=" Select INSTALL NAME:    XM*7.1*183    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",153,1,45,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",153,1,46,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",153,1,47,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",153,1,48,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",153,1,49,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",153,1,50,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",153,1,51,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",153,1,52,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",153,1,53,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",153,1,54,0)=""
^DIC(9.4,4,22,1,"PAH",153,1,55,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",153,1,56,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",153,1,57,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",153,1,58,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",154,0)="184 SEQ #179^3010608^1"
^DIC(9.4,4,22,1,"PAH",154,1,0)="^^58^58^3010608"
^DIC(9.4,4,22,1,"PAH",154,1,1,0)="Patch XM*7.1*184"
^DIC(9.4,4,22,1,"PAH",154,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",154,1,3,0)="NOIS: REN-0501-61866"
^DIC(9.4,4,22,1,"PAH",154,1,4,0)="Test Site:  Reno, NV"
^DIC(9.4,4,22,1,"PAH",154,1,5,0)="If a user, who does not hold the XMMGR key and is not a Postmaster"
^DIC(9.4,4,22,1,"PAH",154,1,6,0)="surrogate, goes into SHARED,MAIL and attempts to resequence messages"
^DIC(9.4,4,22,1,"PAH",154,1,7,0)="in a basket, MailMan tells the user he's resequencing, but then doesn't"
^DIC(9.4,4,22,1,"PAH",154,1,8,0)="resequence them.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",154,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",154,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",154,1,11,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",154,1,12,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",154,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",154,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",154,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",154,1,16,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",154,1,17,0)=" "
^DIC(9.4,4,22,1,"PAH",154,1,18,0)="             Before       After"
^DIC(9.4,4,22,1,"PAH",154,1,19,0)="Name         Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",154,1,20,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",154,1,21,0)="XMXBSKT      12536572     12498784     50,106,115,126,177,184"
^DIC(9.4,4,22,1,"PAH",154,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",154,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",154,1,24,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",154,1,25,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",154,1,26,0)=" "
^DIC(9.4,4,22,1,"PAH",154,1,27,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",154,1,28,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",154,1,29,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",154,1,30,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",154,1,31,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",154,1,32,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",154,1,33,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",154,1,34,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",154,1,35,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",154,1,36,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",154,1,37,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",154,1,38,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",154,1,39,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",154,1,40,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",154,1,41,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",154,1,42,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",154,1,43,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",154,1,44,0)=" Select INSTALL NAME:    XM*7.1*184    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",154,1,45,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",154,1,46,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",154,1,47,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",154,1,48,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",154,1,49,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",154,1,50,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",154,1,51,0)=" Enter the Device you want to print the Install messages."
