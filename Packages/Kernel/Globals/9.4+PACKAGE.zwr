^DIC(9.4,201,"VERSION")="1.0"
^DIC(9.4,202,0)="My HealtheVet^MHV^Support for My HealtheVet web site."
^DIC(9.4,202,1,0)="^9.41A^2^2^3051118^^^^"
^DIC(9.4,202,1,1,0)="This package supports the My HealtheVet website.  It exposes interfaces "
^DIC(9.4,202,1,2,0)="for extracting patient data, supporting prescription refill, and more."
^DIC(9.4,202,7)="^^I"
^DIC(9.4,202,20,0)="^9.402P^^"
^DIC(9.4,202,22,0)="^9.49I^1^1"
^DIC(9.4,202,22,1,0)="1.0^3051119^3050905^1"
^DIC(9.4,202,22,1,1,0)="^^3^3^3051119"
^DIC(9.4,202,22,1,1,1,0)="The is the initial release the My HealtheVet package.  It defines HL7 "
^DIC(9.4,202,22,1,1,2,0)="interfaces for supporting internet prescription refill and queries for "
^DIC(9.4,202,22,1,1,3,0)="prescription information."
^DIC(9.4,202,22,1,"PAH",0)="^9.4901^13^13"
^DIC(9.4,202,22,1,"PAH",1,0)="1 SEQ #1^3060807^1"
^DIC(9.4,202,22,1,"PAH",1,1,0)="^^172^172^3060807"
^DIC(9.4,202,22,1,"PAH",1,1,1,0)="DESCRIPTION:"
^DIC(9.4,202,22,1,"PAH",1,1,2,0)="============"
^DIC(9.4,202,22,1,"PAH",1,1,3,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,4,0)="The MHV 1.0 release for MHV Rx Refill went to the field with logging to a"
^DIC(9.4,202,22,1,"PAH",1,1,5,0)="TMP global left on.  The non-standard use of TMP by the MHV log causes"
^DIC(9.4,202,22,1,"PAH",1,1,6,0)="the TMP entries to not be cleaned up automatically."
^DIC(9.4,202,22,1,"PAH",1,1,7,0)="This patch will turn off logging in the HL7 receiver routines allowing it"
^DIC(9.4,202,22,1,"PAH",1,1,8,0)="to be switched on and off externally as designed.  An XTMP global will be"
^DIC(9.4,202,22,1,"PAH",1,1,9,0)="used instead of TMP.  Options will be added to control logging and to"
^DIC(9.4,202,22,1,"PAH",1,1,10,0)="facilitate automatically purging the log.  A post-init will run to clean"
^DIC(9.4,202,22,1,"PAH",1,1,11,0)="up any existing TMP(""MHV7LOG"") entries."
^DIC(9.4,202,22,1,"PAH",1,1,12,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,13,0)="A new menu, MHV LOG MENU, has been added.  The log provides information "
^DIC(9.4,202,22,1,"PAH",1,1,14,0)="of use to MHV developers, and should only be used by IRM staff in the "
^DIC(9.4,202,22,1,"PAH",1,1,15,0)="event troubleshooting an MHV interface becomes necessary.  The MHV user "
^DIC(9.4,202,22,1,"PAH",1,1,16,0)="manual provides information on how to use these options."
^DIC(9.4,202,22,1,"PAH",1,1,17,0)="Included options are:"
^DIC(9.4,202,22,1,"PAH",1,1,18,0)="        MHV LOG CONFIG     Configure Logging Parameters"
^DIC(9.4,202,22,1,"PAH",1,1,19,0)="        MHV LOG INFO       Display Log Information"
^DIC(9.4,202,22,1,"PAH",1,1,20,0)="        MHV LOG OFF        Turn Off Logging"
^DIC(9.4,202,22,1,"PAH",1,1,21,0)="        MHV LOG ON         Turn On Logging"
^DIC(9.4,202,22,1,"PAH",1,1,22,0)="        MHV LOG PURGE      Purge Log"
^DIC(9.4,202,22,1,"PAH",1,1,23,0)="        MHV LOG SIZE       Display Log Size"
^DIC(9.4,202,22,1,"PAH",1,1,24,0)="        MHV LOG VIEW       View Log Entries"
^DIC(9.4,202,22,1,"PAH",1,1,25,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,26,0)="A new option has been added, MHV CLIENT, as a broker context for a future "
^DIC(9.4,202,22,1,"PAH",1,1,27,0)="MHV GUI client.  The following remote procedures are also included:"
^DIC(9.4,202,22,1,"PAH",1,1,28,0)="        MHV LOG INFO"
^DIC(9.4,202,22,1,"PAH",1,1,29,0)="        MHV LOG OFF"
^DIC(9.4,202,22,1,"PAH",1,1,30,0)="        MHV LOG ON"
^DIC(9.4,202,22,1,"PAH",1,1,31,0)="        MHV LOG PURGE"
^DIC(9.4,202,22,1,"PAH",1,1,32,0)="        MHV LOG SIZE"
^DIC(9.4,202,22,1,"PAH",1,1,33,0)="        MHV LOG CONFIG"
^DIC(9.4,202,22,1,"PAH",1,1,34,0)="        MHV LOG SUMMARY"
^DIC(9.4,202,22,1,"PAH",1,1,35,0)="        MHV LOG DETAIL"
^DIC(9.4,202,22,1,"PAH",1,1,36,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,37,0)="The MHV 1.0 release went to the field with two HL7 protocols having the"
^DIC(9.4,202,22,1,"PAH",1,1,38,0)="""debug"" flag set.  These event driver protocols will be released with the "
^DIC(9.4,202,22,1,"PAH",1,1,39,0)="flag turned off.  The following protocols are being shipped:"
^DIC(9.4,202,22,1,"PAH",1,1,40,0)="        MHV OMP-O09 Event Driver"
^DIC(9.4,202,22,1,"PAH",1,1,41,0)="        MHV OMP-O09 Subscriber"
^DIC(9.4,202,22,1,"PAH",1,1,42,0)="        MHV QBP-Q13 Event Driver"
^DIC(9.4,202,22,1,"PAH",1,1,43,0)="        MHV QBP-Q13 Subscriber"
^DIC(9.4,202,22,1,"PAH",1,1,44,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,45,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,46,0)="Associated Remedy Ticket"
^DIC(9.4,202,22,1,"PAH",1,1,47,0)="===================="
^DIC(9.4,202,22,1,"PAH",1,1,48,0)="HD 131029"
^DIC(9.4,202,22,1,"PAH",1,1,49,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,50,0)="Test Sites"
^DIC(9.4,202,22,1,"PAH",1,1,51,0)="=========="
^DIC(9.4,202,22,1,"PAH",1,1,52,0)="Tampa VAMC"
^DIC(9.4,202,22,1,"PAH",1,1,53,0)="Bay Pines VAMC"
^DIC(9.4,202,22,1,"PAH",1,1,54,0)="Baltimore VAMC"
^DIC(9.4,202,22,1,"PAH",1,1,55,0)="VISN 2 "
^DIC(9.4,202,22,1,"PAH",1,1,56,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,57,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,58,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,202,22,1,"PAH",1,1,59,0)="=========================="
^DIC(9.4,202,22,1,"PAH",1,1,60,0)="The patch is distributed in KIDS format in a PackMan message."
^DIC(9.4,202,22,1,"PAH",1,1,61,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,62,0)="This patch requires MHV 1.0"
^DIC(9.4,202,22,1,"PAH",1,1,63,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,64,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,65,0)="                       **WARNING**"
^DIC(9.4,202,22,1,"PAH",1,1,66,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,67,0)="Inbound HL7 messages for MHV should not be processed during installation"
^DIC(9.4,202,22,1,"PAH",1,1,68,0)="of this patch. All incoming filers should be stopped before installation."
^DIC(9.4,202,22,1,"PAH",1,1,69,0)="  "
^DIC(9.4,202,22,1,"PAH",1,1,70,0)="Before you install this patch in production, please identify all the"
^DIC(9.4,202,22,1,"PAH",1,1,71,0)="production node(s) that have the TMP(""MHV7LOG"") global.  This should be"
^DIC(9.4,202,22,1,"PAH",1,1,72,0)="the same node(s) running the HL7 Listener.  You will need to log on to"
^DIC(9.4,202,22,1,"PAH",1,1,73,0)="each of these node(s) and run the post-init routine CLEANLOG^MHV1P1 will"
^DIC(9.4,202,22,1,"PAH",1,1,74,0)="delete the global entries since TMP is not translated.  The"
^DIC(9.4,202,22,1,"PAH",1,1,75,0)="TMP(""MHV7LOG"") global should have many entries."
^DIC(9.4,202,22,1,"PAH",1,1,76,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,77,0)="                           ****"
^DIC(9.4,202,22,1,"PAH",1,1,78,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,79,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,80,0)="                       **Notice**"
^DIC(9.4,202,22,1,"PAH",1,1,81,0)="This patch includes new options."
^DIC(9.4,202,22,1,"PAH",1,1,82,0)="When an option is included in the patch build, the question REBUILD MENUS"
^DIC(9.4,202,22,1,"PAH",1,1,83,0)="is asked as a PRE-INSTALL question. If you choose to have KIDs rebuild"
^DIC(9.4,202,22,1,"PAH",1,1,84,0)="the menus it will happen at the end of the build installation and may"
^DIC(9.4,202,22,1,"PAH",1,1,85,0)="take several hours."
^DIC(9.4,202,22,1,"PAH",1,1,86,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,87,0)="Note: Most sites have a nightly batch job that rebuilds the menus so if"
^DIC(9.4,202,22,1,"PAH",1,1,88,0)="you queued the installations ensure that it will complete prior to the"
^DIC(9.4,202,22,1,"PAH",1,1,89,0)="batch job.  Or, if you are installing several builds, wait until the"
^DIC(9.4,202,22,1,"PAH",1,1,90,0)="last one to use the KIDs rebuild functionality."
^DIC(9.4,202,22,1,"PAH",1,1,91,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,92,0)="                          ****"
^DIC(9.4,202,22,1,"PAH",1,1,93,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,94,0)="The install time for this patch is less than 5 minutes. This patch can be"
^DIC(9.4,202,22,1,"PAH",1,1,95,0)="installed with users on the system."
^DIC(9.4,202,22,1,"PAH",1,1,96,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,97,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,98,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,99,0)=" 1.  These routines should not be mapped."
^DIC(9.4,202,22,1,"PAH",1,1,100,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,101,0)=" 2.  Unload the distribution"
^DIC(9.4,202,22,1,"PAH",1,1,102,0)="     Use the INSTALL/CHECK MESSAGE option on the PackMan menu to unload"
^DIC(9.4,202,22,1,"PAH",1,1,103,0)="     the KIDS distribution included with this message."
^DIC(9.4,202,22,1,"PAH",1,1,104,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,105,0)=" 3.  Stop all incoming filers."
^DIC(9.4,202,22,1,"PAH",1,1,106,0)="     On the 'Filer and Link Management Options' menu, select the"
^DIC(9.4,202,22,1,"PAH",1,1,107,0)="     'Monitor, Start, Stop Filers' option.  At that menu level, choose"
^DIC(9.4,202,22,1,"PAH",1,1,108,0)="     the action 'Stop incoming filer' to stop each incoming filer."
^DIC(9.4,202,22,1,"PAH",1,1,109,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,110,0)=" 4.  Install the transport global."
^DIC(9.4,202,22,1,"PAH",1,1,111,0)="     From the Kernel Installation and Distribution System Menu,"
^DIC(9.4,202,22,1,"PAH",1,1,112,0)="     select the Installation menu."
^DIC(9.4,202,22,1,"PAH",1,1,113,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,114,0)=" 5.  From this menu, you may elect to use the following options"
^DIC(9.4,202,22,1,"PAH",1,1,115,0)="     (when prompted for INSTALL NAME, enter MHV*1.0*1):"
^DIC(9.4,202,22,1,"PAH",1,1,116,0)="     a.  Backup a Transport Global - this option will create a backup"
^DIC(9.4,202,22,1,"PAH",1,1,117,0)="         message of any routines exported with the patch.  It will NOT"
^DIC(9.4,202,22,1,"PAH",1,1,118,0)="         backup any other changes such as DDs or templates."
^DIC(9.4,202,22,1,"PAH",1,1,119,0)="     b.  Compare Transport Global to Current System  - this option will"
^DIC(9.4,202,22,1,"PAH",1,1,120,0)="         allow you to view all changes that will be made when the patch"
^DIC(9.4,202,22,1,"PAH",1,1,121,0)="         is installed.  It compares all components of the patch"
^DIC(9.4,202,22,1,"PAH",1,1,122,0)="         (routines, DDs, templates, etc.)."
^DIC(9.4,202,22,1,"PAH",1,1,123,0)="     c.  Verify Checksums in Transport Global - this option will"
^DIC(9.4,202,22,1,"PAH",1,1,124,0)="         allow you to ensure the integrity of the routines that are in"
^DIC(9.4,202,22,1,"PAH",1,1,125,0)="         the transport global."
^DIC(9.4,202,22,1,"PAH",1,1,126,0)="     d.  Print Transport Global - this option will allow you to view the"
^DIC(9.4,202,22,1,"PAH",1,1,127,0)="         components of the KIDS build."
^DIC(9.4,202,22,1,"PAH",1,1,128,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,129,0)=" 6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,202,22,1,"PAH",1,1,130,0)="     and select the package 'MHV*1.0*1'."
^DIC(9.4,202,22,1,"PAH",1,1,131,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,132,0)=" 7.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,202,22,1,"PAH",1,1,133,0)="     Install? YES//',  Respond as fits your situation, see note above."
^DIC(9.4,202,22,1,"PAH",1,1,134,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,135,0)=" 8.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,202,22,1,"PAH",1,1,136,0)="     YES//',  respond NO."
^DIC(9.4,202,22,1,"PAH",1,1,137,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,138,0)=" 9.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,202,22,1,"PAH",1,1,139,0)="     Protocols? YES//', choose 'NO'."
^DIC(9.4,202,22,1,"PAH",1,1,140,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,141,0)="10.  At the DEVICE prompt, you can send your output to any printer or"
^DIC(9.4,202,22,1,"PAH",1,1,142,0)="     HFS file, display it on the terminal screen, or queue it to run"
^DIC(9.4,202,22,1,"PAH",1,1,143,0)="     at a scheduled time."
^DIC(9.4,202,22,1,"PAH",1,1,144,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,145,0)="11.  After the install, restart the incoming filers."
^DIC(9.4,202,22,1,"PAH",1,1,146,0)="     On the 'Filer and Link Management Options' menu, select the"
^DIC(9.4,202,22,1,"PAH",1,1,147,0)="     'Monitor, Start, Stop Filers' option.  At that menu level, choose"
^DIC(9.4,202,22,1,"PAH",1,1,148,0)="     the action 'Start incoming filer' to start the default number of"
^DIC(9.4,202,22,1,"PAH",1,1,149,0)="     incoming filers."
^DIC(9.4,202,22,1,"PAH",1,1,150,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,151,0)="12.  Log on to each node running the HL7 listener and run the post init"
^DIC(9.4,202,22,1,"PAH",1,1,152,0)="     Routine CLEANLOG^MHV1P1."
^DIC(9.4,202,22,1,"PAH",1,1,153,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,154,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,155,0)="  "
^DIC(9.4,202,22,1,"PAH",1,1,156,0)="ROUTINE SUMMARY:"
^DIC(9.4,202,22,1,"PAH",1,1,157,0)="================"
^DIC(9.4,202,22,1,"PAH",1,1,158,0)="The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,202,22,1,"PAH",1,1,159,0)="second line of each of these routine(s) will look like:"
^DIC(9.4,202,22,1,"PAH",1,1,160,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,161,0)="     <tab> ;;1.0;My HealtheVet;**1**;Aug 23, 2005"
^DIC(9.4,202,22,1,"PAH",1,1,162,0)=" "
^DIC(9.4,202,22,1,"PAH",1,1,163,0)="                            CHECK^XTSUMBLD results"
^DIC(9.4,202,22,1,"PAH",1,1,164,0)="Routine name      Before Patch          After Patch         Patch List"
^DIC(9.4,202,22,1,"PAH",1,1,165,0)="============      ============          ===========         =========="
^DIC(9.4,202,22,1,"PAH",1,1,166,0)="MHV1P1            N/A                   674288                1"
^DIC(9.4,202,22,1,"PAH",1,1,167,0)="MHV7R1            7907937               7704915               1"
^DIC(9.4,202,22,1,"PAH",1,1,168,0)="MHV7R2            8857636               8693511               1"
^DIC(9.4,202,22,1,"PAH",1,1,169,0)="MHV7U             6547453               7067072               1"
^DIC(9.4,202,22,1,"PAH",1,1,170,0)="MHVUL1            N/A                   5527922               1"
^DIC(9.4,202,22,1,"PAH",1,1,171,0)="MHVUL2            N/A                   5279644               1"
^DIC(9.4,202,22,1,"PAH",1,1,172,0)="MHVUL3            N/A                   10342175              1"
^DIC(9.4,202,22,1,"PAH",2,0)="2 SEQ #2^3090420.155028^1"
^DIC(9.4,202,22,1,"PAH",2,1,0)="^^240^240^3090420"
^DIC(9.4,202,22,1,"PAH",2,1,1,0)="MHV*1*2 PHR Infrastructure"
^DIC(9.4,202,22,1,"PAH",2,1,2,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,3,0)="Summary"
^DIC(9.4,202,22,1,"PAH",2,1,4,0)="-------"
^DIC(9.4,202,22,1,"PAH",2,1,5,0)="MHV*1*2 delivers infrastructure changes in support of upcoming Personal "
^DIC(9.4,202,22,1,"PAH",2,1,6,0)="Health Record (PHR) HL7 interfaces. It also consolidates features common "
^DIC(9.4,202,22,1,"PAH",2,1,7,0)="to message receivers and builders, and encapsulates interaction with the "
^DIC(9.4,202,22,1,"PAH",2,1,8,0)="HL7 v1.6 package to ease transition to HLO based interfaces should that "
^DIC(9.4,202,22,1,"PAH",2,1,9,0)="become necessary.  Most routines were modified to take advantage of the "
^DIC(9.4,202,22,1,"PAH",2,1,10,0)="logging features released with MHV*1*1."
^DIC(9.4,202,22,1,"PAH",2,1,11,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,12,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,13,0)="Detailed Description"
^DIC(9.4,202,22,1,"PAH",2,1,14,0)="--------------------"
^DIC(9.4,202,22,1,"PAH",2,1,15,0)="MHV*1*2 releases a number of infrastructure changes to improve interface "
^DIC(9.4,202,22,1,"PAH",2,1,16,0)="development and support.  Processing common to many interfaces such as "
^DIC(9.4,202,22,1,"PAH",2,1,17,0)="validating patient identifiers, and common segment builders has been "
^DIC(9.4,202,22,1,"PAH",2,1,18,0)="consolidated into centralized functions.  Use of HL7 package APIs and "
^DIC(9.4,202,22,1,"PAH",2,1,19,0)="variables has been moved from individual interfaces and encapsulated in "
^DIC(9.4,202,22,1,"PAH",2,1,20,0)="centralized functions.  If a move from HL7 v1.6 to the new HLO engine "
^DIC(9.4,202,22,1,"PAH",2,1,21,0)="becomes necessary, the impact will be minimized.  All interfaces and "
^DIC(9.4,202,22,1,"PAH",2,1,22,0)="extractors have been updated to use the logging utility introduced with "
^DIC(9.4,202,22,1,"PAH",2,1,23,0)="MHV*1*1.  The message transmitter now provides support for extractors "
^DIC(9.4,202,22,1,"PAH",2,1,24,0)="that need to use a local array to hold extracted data.  "
^DIC(9.4,202,22,1,"PAH",2,1,25,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,26,0)="The MHV Rx refill interfaces introduced with MHV 1.0 use original mode "
^DIC(9.4,202,22,1,"PAH",2,1,27,0)="acknowledgements, a synchronous call into VistA, and do not require a "
^DIC(9.4,202,22,1,"PAH",2,1,28,0)="logical link to respond to the MHV system.  The MHV HL7 interface "
^DIC(9.4,202,22,1,"PAH",2,1,29,0)="framework also supports enhanced mode acknowledgments, an asynchronous "
^DIC(9.4,202,22,1,"PAH",2,1,30,0)="call into VistA.  The PHR HL7 interfaces will use enhanced mode "
^DIC(9.4,202,22,1,"PAH",2,1,31,0)="acknowledgements, and require a logical link to define the connection to "
^DIC(9.4,202,22,1,"PAH",2,1,32,0)="the MHV system.  The new link is MHVVA and is distributed with this "
^DIC(9.4,202,22,1,"PAH",2,1,33,0)="patch.  This link references a new domain, MHV.DOMAIN.EXT, but does not "
^DIC(9.4,202,22,1,"PAH",2,1,34,0)="require this domain to be entered in the DOMAIN file (#4.2)."
^DIC(9.4,202,22,1,"PAH",2,1,35,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,36,0)="Event driver and subscriber protocols for the RTB^K13 query response "
^DIC(9.4,202,22,1,"PAH",2,1,37,0)="message and the ORP^O10 order response message are being released to "
^DIC(9.4,202,22,1,"PAH",2,1,38,0)="support a future change in Rx refill messaging from original mode "
^DIC(9.4,202,22,1,"PAH",2,1,39,0)="acknowledgements to enhanced mode acknowledgements."
^DIC(9.4,202,22,1,"PAH",2,1,40,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,41,0)="MHV*1*2 updates the MHV REQUEST TYPE file #2275.3 with entries to support "
^DIC(9.4,202,22,1,"PAH",2,1,42,0)="the new PHR interfaces.  These entries are disabled by having the BLOCKED "
^DIC(9.4,202,22,1,"PAH",2,1,43,0)="field #.03 set to YES.  A new field, ROUTINE BUILDER field #.06, holds "
^DIC(9.4,202,22,1,"PAH",2,1,44,0)="the name of the query specific builder routine used by RTB^K13 types.  A "
^DIC(9.4,202,22,1,"PAH",2,1,45,0)="new field DESCRIPTION field #2 provides a brief description of the "
^DIC(9.4,202,22,1,"PAH",2,1,46,0)="interface supported by that request type."
^DIC(9.4,202,22,1,"PAH",2,1,47,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,48,0)="The MHV RESPONSE MAP file #2275.4 is new with this release.  It is used "
^DIC(9.4,202,22,1,"PAH",2,1,49,0)="to map inbound messages to the protocol and routine used to create the "
^DIC(9.4,202,22,1,"PAH",2,1,50,0)="response message, and the segment used to break messages on a whole "
^DIC(9.4,202,22,1,"PAH",2,1,51,0)="record boundary."
^DIC(9.4,202,22,1,"PAH",2,1,52,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,53,0)="PHR HL7 interfaces have the potential to carry very large messages.  "
^DIC(9.4,202,22,1,"PAH",2,1,54,0)="MHV*1*2 introduces the ability to break those messages into multiple "
^DIC(9.4,202,22,1,"PAH",2,1,55,0)="smaller messages for a ""bolus"" style response."
^DIC(9.4,202,22,1,"PAH",2,1,56,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,57,0)="MHV*1*2 fixes a bug where the TX field formatter did not correctly "
^DIC(9.4,202,22,1,"PAH",2,1,58,0)="calculate the size of the data put in the field, and thus could not "
^DIC(9.4,202,22,1,"PAH",2,1,59,0)="enforce field size constraints.  This issue was not encountered in "
^DIC(9.4,202,22,1,"PAH",2,1,60,0)="production because existing interfaces do not require such constraints.  "
^DIC(9.4,202,22,1,"PAH",2,1,61,0)="The TX field formatter was rewritten to use an improved algorithm and fix "
^DIC(9.4,202,22,1,"PAH",2,1,62,0)="this bug."
^DIC(9.4,202,22,1,"PAH",2,1,63,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,64,0)="MHV*1*2 also fixes a bug where an incorrect ACK code and segment "
^DIC(9.4,202,22,1,"PAH",2,1,65,0)="descriptor could be returned on negative acknowledgments triggered by the "
^DIC(9.4,202,22,1,"PAH",2,1,66,0)="request manager.  This issue was not encountered in production because "
^DIC(9.4,202,22,1,"PAH",2,1,67,0)="the conditions required to trigger it have not occurred.  These are "
^DIC(9.4,202,22,1,"PAH",2,1,68,0)="improper interface configuration, and catastrophic data integrity errors."
^DIC(9.4,202,22,1,"PAH",2,1,69,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,70,0)="The pre-init routine PRE^MHV1P2 turns on MHV Application Logging.  It "
^DIC(9.4,202,22,1,"PAH",2,1,71,0)="will log information about MHV HL7 messages received during the patch "
^DIC(9.4,202,22,1,"PAH",2,1,72,0)="install.  This is only a precaution as the MHV application is tolerant of "
^DIC(9.4,202,22,1,"PAH",2,1,73,0)="messaging failures that might be caused by loading the patch.  If a "
^DIC(9.4,202,22,1,"PAH",2,1,74,0)="message was received during the patch installation, you will be notified "
^DIC(9.4,202,22,1,"PAH",2,1,75,0)="and asked to check the error trap for errors in the MHV namespace.  If "
^DIC(9.4,202,22,1,"PAH",2,1,76,0)="any are found, you should log a remedy ticket."
^DIC(9.4,202,22,1,"PAH",2,1,77,0)="The post init routine POST^MHV1P2 will update the MHVVA logical link and "
^DIC(9.4,202,22,1,"PAH",2,1,78,0)="turn off MHV Application Logging.  For test systems, it will remove data "
^DIC(9.4,202,22,1,"PAH",2,1,79,0)="from the DNS DOMAIN (#.08), TCP/IP ADDRESS (#400.01), and TCP/IP PORT "
^DIC(9.4,202,22,1,"PAH",2,1,80,0)="(#400.02) fields and set AUTOSTART (#4.5) to Disabled.  For production "
^DIC(9.4,202,22,1,"PAH",2,1,81,0)="systems, it will ensure the correct values are in the DNS DOMAIN (#.08), "
^DIC(9.4,202,22,1,"PAH",2,1,82,0)="TCP/IP ADDRESS (#400.01), and TCP/IP PORT (#400.02) fields and set "
^DIC(9.4,202,22,1,"PAH",2,1,83,0)="AUTOSTART (#4.5) to Enabled."
^DIC(9.4,202,22,1,"PAH",2,1,84,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,85,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,86,0)="New Service Request (NSR):"
^DIC(9.4,202,22,1,"PAH",2,1,87,0)="--------------------------"
^DIC(9.4,202,22,1,"PAH",2,1,88,0)="There is no NSR associated with this patch."
^DIC(9.4,202,22,1,"PAH",2,1,89,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,90,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,91,0)="Remedy Ticket(s):"
^DIC(9.4,202,22,1,"PAH",2,1,92,0)="-----------------"
^DIC(9.4,202,22,1,"PAH",2,1,93,0)="There are no Remedy tickets associated with this patch."
^DIC(9.4,202,22,1,"PAH",2,1,94,0)=" "
^DIC(9.4,202,22,1,"PAH",2,1,95,0)=" "
