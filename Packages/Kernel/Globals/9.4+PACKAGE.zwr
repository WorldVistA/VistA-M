^DIC(9.4,14,22,5.9,"PAH",150,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,123,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",150,1,124,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",150,1,125,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",150,1,126,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",150,1,127,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",150,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,129,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",150,1,130,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",150,1,131,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",150,1,132,0)="   LR303            N/A            4831421        **303** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",150,1,133,0)="   LRLNCPMP         7461913        7416816        **215,232,278,303**"
^DIC(9.4,14,22,5.9,"PAH",150,1,134,0)="   LRSRVR           16543787       5915085        **232,303**"
^DIC(9.4,14,22,5.9,"PAH",150,1,135,0)="   LRSRVR1          N/A            11247287       **303**"
^DIC(9.4,14,22,5.9,"PAH",150,1,136,0)="   LRSRVR2          N/A            12542186       **303**"
^DIC(9.4,14,22,5.9,"PAH",150,1,137,0)="   LRSRVR3          N/A            13571036       **303**"
^DIC(9.4,14,22,5.9,"PAH",150,1,138,0)="   LRSRVR4          N/A            538253         **303**"
^DIC(9.4,14,22,5.9,"PAH",150,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,140,0)=" List of preceding patches: 232, 278"
^DIC(9.4,14,22,5.9,"PAH",150,1,141,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",150,1,142,0)="  "
^DIC(9.4,14,22,5.9,"PAH",150,1,143,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,144,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",150,1,145,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",150,1,146,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",150,1,147,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",150,1,148,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",150,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,150,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,151,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",150,1,152,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",150,1,153,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,154,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",150,1,155,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",150,1,156,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,157,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,158,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",150,1,159,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,160,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",150,1,161,0)="        option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",150,1,162,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,163,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",150,1,164,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",150,1,165,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,166,0)="  4.  From this menu, you may then elect to use the following options"
^DIC(9.4,14,22,5.9,"PAH",150,1,167,0)="      (when prompted for the INSTALL NAME, enter LR*5.2*303):"
^DIC(9.4,14,22,5.9,"PAH",150,1,168,0)="        a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",150,1,169,0)="        b. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",150,1,170,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",150,1,171,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",150,1,172,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,173,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",150,1,174,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",150,1,175,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,176,0)="  5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",150,1,177,0)="      and select the package 'LR*5.2*303'.  When prompted 'Want KIDS to"
^DIC(9.4,14,22,5.9,"PAH",150,1,178,0)="      INHIBIT LOGONs during the install? YES// choose 'NO'.  When prompted"
^DIC(9.4,14,22,5.9,"PAH",150,1,179,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,14,22,5.9,"PAH",150,1,180,0)="      YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",150,1,181,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,182,0)="  6.  On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",150,1,183,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,184,0)=" Note: Routine LR303 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",150,1,185,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,186,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,187,0)="INSTALLATION EXAMPLE"
^DIC(9.4,14,22,5.9,"PAH",150,1,188,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",150,1,189,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,190,0)="Select Installation Option:"
^DIC(9.4,14,22,5.9,"PAH",150,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,192,0)="Select Kernel Installation & Distribution System Option:  Installation"
^DIC(9.4,14,22,5.9,"PAH",150,1,193,0)=" "
^DIC(9.4,14,22,5.9,"PAH",150,1,194,0)="Select Installation Option:  Install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",150,1,195,0)="Select INSTALL NAME: LR*5.2*303 Loaded from Distribution 12/21/04@13:39:35"
