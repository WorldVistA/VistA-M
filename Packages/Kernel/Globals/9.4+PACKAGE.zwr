^DIC(9.4,14,22,5.9,"PAH",132,1,114,0)=" Reporting Site:   None"
^DIC(9.4,14,22,5.9,"PAH",132,1,115,0)="  "
^DIC(9.4,14,22,5.9,"PAH",132,1,116,0)=" Test Site(s):     "
^DIC(9.4,14,22,5.9,"PAH",132,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,118,0)="  "
^DIC(9.4,14,22,5.9,"PAH",132,1,119,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",132,1,120,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",132,1,121,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",132,1,122,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",132,1,123,0)="  <tab> ;;0.5;VBECS;<patchlist>;APR 26, 2002"
^DIC(9.4,14,22,5.9,"PAH",132,1,124,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,125,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",132,1,126,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",132,1,127,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",132,1,128,0)="   VBECA1            NEW            7650459        294"
^DIC(9.4,14,22,5.9,"PAH",132,1,129,0)="   VBECA1A           NEW            1999149        294"
^DIC(9.4,14,22,5.9,"PAH",132,1,130,0)="   VBECA3A           NEW            6174129        294"
^DIC(9.4,14,22,5.9,"PAH",132,1,131,0)="   VBECA3B           NEW            7215596        294"
^DIC(9.4,14,22,5.9,"PAH",132,1,132,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,133,0)="List of preceding patches: None"
^DIC(9.4,14,22,5.9,"PAH",132,1,134,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",132,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,136,0)="  Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",132,1,137,0)="  =========================="
^DIC(9.4,14,22,5.9,"PAH",132,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,139,0)="  NOTE: This KIDS install does not place any options out of service"
^DIC(9.4,14,22,5.9,"PAH",132,1,140,0)="        during the install and no user options are affected."
^DIC(9.4,14,22,5.9,"PAH",132,1,141,0)="        If KIDS prompts:"
^DIC(9.4,14,22,5.9,"PAH",132,1,142,0)="  "
^DIC(9.4,14,22,5.9,"PAH",132,1,143,0)="        ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",132,1,144,0)="         Install? YES// NO"""
^DIC(9.4,14,22,5.9,"PAH",132,1,145,0)="        ""Want KIDS to INHIBIT LOGONs during the install? YES// NO"""
^DIC(9.4,14,22,5.9,"PAH",132,1,146,0)="        ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",132,1,147,0)="        Protocols? YES// NO"""
^DIC(9.4,14,22,5.9,"PAH",132,1,148,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,149,0)="        The site should answer ""NO"" to all three questions."
^DIC(9.4,14,22,5.9,"PAH",132,1,150,0)="            Note: You may not receive all three prompts at your site.  "
^DIC(9.4,14,22,5.9,"PAH",132,1,151,0)="  "
^DIC(9.4,14,22,5.9,"PAH",132,1,152,0)="        1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,14,22,5.9,"PAH",132,1,153,0)="           This option will load the KIDS package in this message onto"
^DIC(9.4,14,22,5.9,"PAH",132,1,154,0)="           your system."
^DIC(9.4,14,22,5.9,"PAH",132,1,155,0)="        2. Review your mapped set.  If the routines are mapped, they"
^DIC(9.4,14,22,5.9,"PAH",132,1,156,0)="           should be removed from the mapped set at this time."
^DIC(9.4,14,22,5.9,"PAH",132,1,157,0)="        3. The patch has now been loaded into a Transport global on"
^DIC(9.4,14,22,5.9,"PAH",132,1,158,0)="           your system. You now need to use KIDS to install the"
^DIC(9.4,14,22,5.9,"PAH",132,1,159,0)="           Transport global."
^DIC(9.4,14,22,5.9,"PAH",132,1,160,0)="           On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,14,22,5.9,"PAH",132,1,161,0)="           following options:"
^DIC(9.4,14,22,5.9,"PAH",132,1,162,0)="               Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",132,1,163,0)="               Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",132,1,164,0)="               Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",132,1,165,0)="               Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",132,1,166,0)="        4. Users may remain on the system."
^DIC(9.4,14,22,5.9,"PAH",132,1,167,0)="        5. No options need to be placed out of service."
^DIC(9.4,14,22,5.9,"PAH",132,1,168,0)="        6. Installation time is less than 2 minutes during off peak"
^DIC(9.4,14,22,5.9,"PAH",132,1,169,0)="           hours and less the 5 minutes during peak hours."
^DIC(9.4,14,22,5.9,"PAH",132,1,170,0)="        7. Installation of this patch requires no additional memory"
^DIC(9.4,14,22,5.9,"PAH",132,1,171,0)="           space."
^DIC(9.4,14,22,5.9,"PAH",132,1,172,0)="        8. From the 'Installation Menu' of the KIDS menu, run the"
^DIC(9.4,14,22,5.9,"PAH",132,1,173,0)="           option 'Install Package(s)' Select the package 'LR*5.2*294'"
^DIC(9.4,14,22,5.9,"PAH",132,1,174,0)="           and proceed with the install."
^DIC(9.4,14,22,5.9,"PAH",132,1,175,0)="        9. If any routines were unmapped as part of step 2, they should"
^DIC(9.4,14,22,5.9,"PAH",132,1,176,0)="           be returned to the mapped set once the installation has run"
^DIC(9.4,14,22,5.9,"PAH",132,1,177,0)="           to completion."
^DIC(9.4,14,22,5.9,"PAH",133,0)="301 SEQ #231^3030924^1"
^DIC(9.4,14,22,5.9,"PAH",133,1,0)="^^121^121^3030924"
^DIC(9.4,14,22,5.9,"PAH",133,1,1,0)="This patch is being released in support of the VBECS (Vista Blood "
^DIC(9.4,14,22,5.9,"PAH",133,1,2,0)="Establishment Computer Software) Blood Bank Modernization Project.  In "
^DIC(9.4,14,22,5.9,"PAH",133,1,3,0)="the future, data will be transitioned from the existing M database to a "
^DIC(9.4,14,22,5.9,"PAH",133,1,4,0)="Microsoft SQL database.  This patch will begin the Lab packages "
^DIC(9.4,14,22,5.9,"PAH",133,1,5,0)="transition to the new database."
^DIC(9.4,14,22,5.9,"PAH",133,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,8,0)=" Routine     Area Affected"
^DIC(9.4,14,22,5.9,"PAH",133,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,10,0)=" LR7OR1      This routine provides an API for the retrieval of Lab"
^DIC(9.4,14,22,5.9,"PAH",133,1,11,0)="             results for a patient.  All references to the BB subscript"
^DIC(9.4,14,22,5.9,"PAH",133,1,12,0)="             (BLOOD BANK subfile #63.01) of the LAB DATA file (#63)"
^DIC(9.4,14,22,5.9,"PAH",133,1,13,0)="             have been removed."
^DIC(9.4,14,22,5.9,"PAH",133,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,15,0)=" LRDPA1      The retrieval of ABO data for a patient has been"
^DIC(9.4,14,22,5.9,"PAH",133,1,16,0)="             transitioned from direct global reads to the ABO^VBECA1"
^DIC(9.4,14,22,5.9,"PAH",133,1,17,0)="             API (DBIA 3181-B)."
^DIC(9.4,14,22,5.9,"PAH",133,1,18,0)="             The retrieval of RH factor data for a patient has been"
^DIC(9.4,14,22,5.9,"PAH",133,1,19,0)="             transitioned from direct global reads to the RH^VBECA1"
^DIC(9.4,14,22,5.9,"PAH",133,1,20,0)="             API. (DBIA 3181-C)"
^DIC(9.4,14,22,5.9,"PAH",133,1,21,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,22,0)=" LRDPA2      The retrieval of Blood Bank Comments for a patient has"
^DIC(9.4,14,22,5.9,"PAH",133,1,23,0)="             been transitioned from direct global reads to the"
^DIC(9.4,14,22,5.9,"PAH",133,1,24,0)="             BBCMT^VBECA1 API (DBIA 3181-H)."
^DIC(9.4,14,22,5.9,"PAH",133,1,25,0)="             The retrieval of Antibodies Identified for a patient has"
^DIC(9.4,14,22,5.9,"PAH",133,1,26,0)="             been transitioned from direct global reads to the"
^DIC(9.4,14,22,5.9,"PAH",133,1,27,0)="             ABID^VBECA1 API (DBIA 3181-D)."
^DIC(9.4,14,22,5.9,"PAH",133,1,28,0)="             The retrieval of Transfusion Reactions for a patient has"
^DIC(9.4,14,22,5.9,"PAH",133,1,29,0)="             been transitioned from direct global reads to the"
^DIC(9.4,14,22,5.9,"PAH",133,1,30,0)="             TRRX^VBECA1 API (DBIA 3181-G)."
^DIC(9.4,14,22,5.9,"PAH",133,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,33,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*301 does not "
^DIC(9.4,14,22,5.9,"PAH",133,1,34,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",133,1,35,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",133,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,37,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*301 does not "
^DIC(9.4,14,22,5.9,"PAH",133,1,38,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",133,1,39,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",133,1,40,0)=" "
^DIC(9.4,14,22,5.9,"PAH",133,1,41,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*301 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",133,1,42,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",133,1,43,0)=" "
