^DIC(9.4,77,22,16,"PAH","B","42 SEQ #47",18)=""
^DIC(9.4,77,22,16,"PAH","B","43 SEQ #42",13)=""
^DIC(9.4,77,22,16,"PAH","B","44 SEQ #40",11)=""
^DIC(9.4,77,22,16,"PAH","B","45 SEQ #43",14)=""
^DIC(9.4,77,22,16,"PAH","B","47 SEQ #49",20)=""
^DIC(9.4,77,22,16,"PAH","B","48 SEQ #44",15)=""
^DIC(9.4,77,22,16,"PAH","B","49 SEQ #51",22)=""
^DIC(9.4,77,22,16,"PAH","B","50 SEQ #54",25)=""
^DIC(9.4,77,22,16,"PAH","B","51 SEQ #48",19)=""
^DIC(9.4,77,22,16,"PAH","B","52 SEQ #50",21)=""
^DIC(9.4,77,22,16,"PAH","B","53 SEQ #52",23)=""
^DIC(9.4,77,22,16,"PAH","B","54 SEQ #53",24)=""
^DIC(9.4,77,22,16,"PAH","B","60 SEQ #61",32)=""
^DIC(9.4,77,22,16,"PAH","B","61 SEQ #60",31)=""
^DIC(9.4,77,22,16,"PAH","B","62 SEQ #64",35)=""
^DIC(9.4,77,22,16,"PAH","B","63 SEQ #65",36)=""
^DIC(9.4,77,22,16,"PAH","B","64 SEQ #62",33)=""
^DIC(9.4,77,22,16,"PAH","B","65 SEQ #63",34)=""
