^DIC(9.4,47,22,5.9,"PAH",892,1,3,0)="Assignment History (#26.14) file after the release of patch DG*5.3*1078."
^DIC(9.4,47,22,5.9,"PAH",892,1,4,0)="This patch will correct any records with a null value after the install of"
^DIC(9.4,47,22,5.9,"PAH",892,1,5,0)="patch DG*5.3*1078. This patch also stores the site ID for any other"
