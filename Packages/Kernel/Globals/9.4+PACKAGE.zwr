^DIC(9.4,149,"DEV")="BECKER/ALTOONA"
^DIC(9.4,149,"INI")="ABSVIPRE^2960925.133356"
^DIC(9.4,149,"INIT")="ABSVIPST^2960925.133512"
^DIC(9.4,149,"PRE")="ABSVINST^2960925.133352"
^DIC(9.4,149,"VERSION")="5.0"
^DIC(9.4,150,0)="QUASAR^ACKQ^Quality: Audiology and Speech Pathology Audit and Review"
^DIC(9.4,150,1,0)="^^3^3^2960414^^^^"
^DIC(9.4,150,1,1,0)="Quality: Audiology and Speech Pathology Audit and Review (QUASAR)"
^DIC(9.4,150,1,2,0)="is designed to capture patient treatment and workload information"
^DIC(9.4,150,1,3,0)="for Audiology and Speech Pathology clinic visits."
^DIC(9.4,150,5)="Birmingham IRMFO"
^DIC(9.4,150,7)="^^I"
^DIC(9.4,150,20,0)="^9.402P^^"
^DIC(9.4,150,22,0)="^9.49I^2^2"
^DIC(9.4,150,22,1,0)="2.0^3021112^2960926^1"
^DIC(9.4,150,22,1,1,0)="^^3^3^3021112"
^DIC(9.4,150,22,1,1,1,0)="Quality: Audiology and Speech Pathology Audit and Review (QUASAR) is"
^DIC(9.4,150,22,1,1,2,0)="designed to capture patient treatment and workload information for"
^DIC(9.4,150,22,1,1,3,0)="Audiology and Speech Pathology clinic visits."
^DIC(9.4,150,22,1,"PAH",0)="^9.4901^7^7"
^DIC(9.4,150,22,1,"PAH",1,0)="3^2970417^1"
^DIC(9.4,150,22,1,"PAH",1,1,0)="^^22^22^2970417"
^DIC(9.4,150,22,1,"PAH",1,1,1,0)=" During the New Clinic Visits option, some QUASAR users may see an "
^DIC(9.4,150,22,1,"PAH",1,1,2,0)=" additional prompt while entering the DIAGNOSTIC CODE(s). This "
^DIC(9.4,150,22,1,"PAH",1,1,3,0)=" additional prompt is Select DIAGNOSTIC CONDITION. The prompt "
^DIC(9.4,150,22,1,"PAH",1,1,4,0)=" occurs after the diagnostic code has been entered into the A&SP "
^DIC(9.4,150,22,1,"PAH",1,1,5,0)=" CLINIC VISIT file (#509850.6) and while the A&SP PATIENT file's "
^DIC(9.4,150,22,1,"PAH",1,1,6,0)=" (#509850.2) diagnostic condition multiple (patient diagnostic "
^DIC(9.4,150,22,1,"PAH",1,1,7,0)=" history) is being updated."
^DIC(9.4,150,22,1,"PAH",1,1,8,0)=" "
^DIC(9.4,150,22,1,"PAH",1,1,9,0)=" Why do some QUASAR users see this additional prompt, while "
^DIC(9.4,150,22,1,"PAH",1,1,10,0)=" others do not? Recent FileMan patches clean up the utilities "
^DIC(9.4,150,22,1,"PAH",1,1,11,0)=" for creating and entering data in sub-files (FILE^DICN  and DIE)."
^DIC(9.4,150,22,1,"PAH",1,1,12,0)=" We believe the QUASAR problem shows up after the FM patches are "
^DIC(9.4,150,22,1,"PAH",1,1,13,0)=" installed."
^DIC(9.4,150,22,1,"PAH",1,1,14,0)="  "
^DIC(9.4,150,22,1,"PAH",1,1,15,0)=" The legacy QUASAR code used old methodology for this call and "
^DIC(9.4,150,22,1,"PAH",1,1,16,0)=" needed to be updated. Patch ACKQ*2*3 corrects this problem."
^DIC(9.4,150,22,1,"PAH",1,1,17,0)="  "
^DIC(9.4,150,22,1,"PAH",1,1,18,0)=" What is the impact of this bug on QUASAR data? Depending on how "
^DIC(9.4,150,22,1,"PAH",1,1,19,0)=" the Select DIAGNOSTIC CONDITION prompt is answered, the patient "
^DIC(9.4,150,22,1,"PAH",1,1,20,0)=" diagnostic history in the A&SP PATIENT file (#509850.2) may not "
^DIC(9.4,150,22,1,"PAH",1,1,21,0)=" be complete. It is advisable to use the Inquire - A&SP Patient "
^DIC(9.4,150,22,1,"PAH",1,1,22,0)=" option to update the diagnostic history."
^DIC(9.4,150,22,1,"PAH",2,0)="4^2970717^1"
^DIC(9.4,150,22,1,"PAH",2,1,0)="^^7^7^2970717"
^DIC(9.4,150,22,1,"PAH",2,1,1,0)=" The AMIE C&P AUDIO worksheet (#1305) format has been "
^DIC(9.4,150,22,1,"PAH",2,1,2,0)=" reconfigured. The worksheet headings and organization have "
^DIC(9.4,150,22,1,"PAH",2,1,3,0)=" changed. Patch ACKQ*2*4 corrects this for QUASAR."
^DIC(9.4,150,22,1,"PAH",2,1,4,0)="  "
^DIC(9.4,150,22,1,"PAH",2,1,5,0)=" Additionally, this patch replaces all ""W *7"" code with ""W $C(7)"""
^DIC(9.4,150,22,1,"PAH",2,1,6,0)=" in nine (9) QUASAR routines and in the ACKQAS VISIT ENTRY input"
^DIC(9.4,150,22,1,"PAH",2,1,7,0)=" template on the A&SP CLINIC VISIT file (#509850.6). "
^DIC(9.4,150,22,1,"PAH",3,0)="5^2970808^1"
^DIC(9.4,150,22,1,"PAH",3,1,0)="^^7^7^2970808"
^DIC(9.4,150,22,1,"PAH",3,1,1,0)=" When a C&P exam is adequated in QUASAR, the results are "
^DIC(9.4,150,22,1,"PAH",3,1,2,0)=" transmitted to the AMIE C&P software. If the transmission "
^DIC(9.4,150,22,1,"PAH",3,1,3,0)=" attempt to AMIE fails and the data is not successfully sent, "
^DIC(9.4,150,22,1,"PAH",3,1,4,0)=" QUASAR currently does not leave the visit in a ""signed off on, "
^DIC(9.4,150,22,1,"PAH",3,1,5,0)=" but not adequated"" state. This patch corrects this problem by "
^DIC(9.4,150,22,1,"PAH",3,1,6,0)=" leaving the visit in a ""signed off on, but not adequated"" state "
^DIC(9.4,150,22,1,"PAH",3,1,7,0)=" so that re-transmission can take place."
^DIC(9.4,150,22,1,"PAH",4,0)="6^2970922^1"
^DIC(9.4,150,22,1,"PAH",4,1,0)="^^4^4^2970922"
^DIC(9.4,150,22,1,"PAH",4,1,1,0)=" This patch corrects a problem reported in NOIS CTX-0997-70706."
^DIC(9.4,150,22,1,"PAH",4,1,2,0)=" After installing ACKQ*2*5, sites reported that the adequator "
^DIC(9.4,150,22,1,"PAH",4,1,3,0)=" signature block does not print on the AMIE report.  Patch "
^DIC(9.4,150,22,1,"PAH",4,1,4,0)=" ACKQ*2*6 corrects this problem."
^DIC(9.4,150,22,1,"PAH",5,0)="7^2980403^1"
^DIC(9.4,150,22,1,"PAH",5,1,0)="^^1^1^2980403"
^DIC(9.4,150,22,1,"PAH",5,1,1,0)="Y2K COMPLIANCE PATCH"
^DIC(9.4,150,22,1,"PAH",6,0)="8^2981229^1"
^DIC(9.4,150,22,1,"PAH",6,1,0)="^^1^1^2981229"
^DIC(9.4,150,22,1,"PAH",6,1,1,0)="See description of patch on FORUM."
^DIC(9.4,150,22,1,"PAH",7,0)="9 SEQ #9^2990719^1"
^DIC(9.4,150,22,1,"PAH","B",3,1)=""
^DIC(9.4,150,22,1,"PAH","B",4,2)=""
^DIC(9.4,150,22,1,"PAH","B",5,3)=""
^DIC(9.4,150,22,1,"PAH","B",6,4)=""
^DIC(9.4,150,22,1,"PAH","B",7,5)=""
^DIC(9.4,150,22,1,"PAH","B",8,6)=""
^DIC(9.4,150,22,1,"PAH","B","9 SEQ #9",7)=""
^DIC(9.4,150,22,2,0)="3.0^3051119^3000626^1"
^DIC(9.4,150,22,2,1,0)="^^2^2^3051119"
^DIC(9.4,150,22,2,1,1,0)=" "
^DIC(9.4,150,22,2,1,2,0)="TEST INSTALL VERSION 3"
^DIC(9.4,150,22,2,"PAH",0)="^9.4901^18^18"
^DIC(9.4,150,22,2,"PAH",1,0)="1 SEQ #1^3010122^1"
^DIC(9.4,150,22,2,"PAH",2,0)="2 SEQ #2^3010412^1"
^DIC(9.4,150,22,2,"PAH",3,0)="4 SEQ #3^3021108^1"
^DIC(9.4,150,22,2,"PAH",3,1,0)="^^1^1^3021108"
^DIC(9.4,150,22,2,"PAH",3,1,1,0)="Fix event capture error's."
^DIC(9.4,150,22,2,"PAH",4,0)="5 SEQ #4^3030329^1"
^DIC(9.4,150,22,2,"PAH",4,1,0)="^^2^2^3030329"
^DIC(9.4,150,22,2,"PAH",4,1,1,0)="This patch fixes the problem with updating diagnosis histories in the "
^DIC(9.4,150,22,2,"PAH",4,1,2,0)="A&SP Patient file (#509850.2)."
^DIC(9.4,150,22,2,"PAH",5,0)="7 SEQ #5^3030715^1"
^DIC(9.4,150,22,2,"PAH",5,1,0)="^^2^2^3030715"
^DIC(9.4,150,22,2,"PAH",5,1,1,0)="This patch fixes problems with the updating of the Problem List via the "
^DIC(9.4,150,22,2,"PAH",5,1,2,0)="PCE interface."
^DIC(9.4,150,22,2,"PAH",6,0)="6 SEQ #6^3030924^1"
^DIC(9.4,150,22,2,"PAH",6,1,0)="^^2^2^3030924"
^DIC(9.4,150,22,2,"PAH",6,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,150,22,2,"PAH",6,1,2,0)="included in this patch."
^DIC(9.4,150,22,2,"PAH",7,0)="3 SEQ #7^3031107^1"
^DIC(9.4,150,22,2,"PAH",7,1,0)="^^188^188^3031107"
^DIC(9.4,150,22,2,"PAH",7,1,1,0)="The Audiometric module was developed in conjunction"
^DIC(9.4,150,22,2,"PAH",7,1,2,0)="with the Remote Order Entry System (ROES 3.0) at the VA Denver"
^DIC(9.4,150,22,2,"PAH",7,1,3,0)="Distribution Center. [Prior ROES 2 VistA applications may be run"
^DIC(9.4,150,22,2,"PAH",7,1,4,0)="concurrently with the new system during the switchover]"
^DIC(9.4,150,22,2,"PAH",7,1,5,0)="This patch includes two new options. These two options are only"
^DIC(9.4,150,22,2,"PAH",7,1,6,0)=" available in the Windows environment. Please refer to the "
^DIC(9.4,150,22,2,"PAH",7,1,7,0)="Installation Guide for instructions on setting these options up."
^DIC(9.4,150,22,2,"PAH",7,1,8,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,9,0)="The 2 new GUI options are:"
^DIC(9.4,150,22,2,"PAH",7,1,10,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,11,0)="(1) [ACKQROES3E] Enter or edit the data into file 509850.9. When"
^DIC(9.4,150,22,2,"PAH",7,1,12,0)="     signed, this transmits the data to the DDC for use with ROES 3"
^DIC(9.4,150,22,2,"PAH",7,1,13,0)="     Custom Hearing Aid orders."
^DIC(9.4,150,22,2,"PAH",7,1,14,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,15,0)="(2) [ACKQROES3] View the audiogram generated from that data and"
^DIC(9.4,150,22,2,"PAH",7,1,16,0)="    print VA form 10-2364."
^DIC(9.4,150,22,2,"PAH",7,1,17,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,18,0)="NOIS references addressed in this patch"
^DIC(9.4,150,22,2,"PAH",7,1,19,0)="======================================="
^DIC(9.4,150,22,2,"PAH",7,1,20,0)="There are no NOIS or E3R references."
^DIC(9.4,150,22,2,"PAH",7,1,21,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,22,0)="Test Sites"
^DIC(9.4,150,22,2,"PAH",7,1,23,0)="=========="
^DIC(9.4,150,22,2,"PAH",7,1,24,0)="Denver"
^DIC(9.4,150,22,2,"PAH",7,1,25,0)="New York"
^DIC(9.4,150,22,2,"PAH",7,1,26,0)="Columbia"
^DIC(9.4,150,22,2,"PAH",7,1,27,0)="Mountain Home"
^DIC(9.4,150,22,2,"PAH",7,1,28,0)="Atlanta"
^DIC(9.4,150,22,2,"PAH",7,1,29,0)="Nashville"
^DIC(9.4,150,22,2,"PAH",7,1,30,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,31,0)="FTP Software and Documentation"
^DIC(9.4,150,22,2,"PAH",7,1,32,0)="=============================="
^DIC(9.4,150,22,2,"PAH",7,1,33,0)="This patch will be distributed in a PackMan message through the"
^DIC(9.4,150,22,2,"PAH",7,1,34,0)="National Patch Module and should be obtained from there."
^DIC(9.4,150,22,2,"PAH",7,1,35,0)="The KIDS build for this patch is ACKQ*3.0*3."
^DIC(9.4,150,22,2,"PAH",7,1,36,0)="KIDS File (ACKQ*3.0*3): ACKQ_3_P3.KID"
^DIC(9.4,150,22,2,"PAH",7,1,37,0)="ZIP file of executables: AUDIOGRAM.ZIP"
^DIC(9.4,150,22,2,"PAH",7,1,38,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,39,0)="Documentation:"
^DIC(9.4,150,22,2,"PAH",7,1,40,0)="     ACKQ_3_P3_IG.PDF     Installation guide"
^DIC(9.4,150,22,2,"PAH",7,1,41,0)="     ACKQ_3_P3_SG.PDF     Security guide"
^DIC(9.4,150,22,2,"PAH",7,1,42,0)="     ACKQ_3_P3_TM.PDF     Technical manual"
^DIC(9.4,150,22,2,"PAH",7,1,43,0)="     ACKQ_3_P3_UM.PDF     User manual"
^DIC(9.4,150,22,2,"PAH",7,1,44,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,45,0)="Note: The .PDF and .ZIP files are binary files and must be "
^DIC(9.4,150,22,2,"PAH",7,1,46,0)="transferred in binary, not ASCII mode. These files can be read"
^DIC(9.4,150,22,2,"PAH",7,1,47,0)="using the Adobe Acrobat Reader program."
^DIC(9.4,150,22,2,"PAH",7,1,48,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,49,0)="This patch contains the following enhancements:"
^DIC(9.4,150,22,2,"PAH",7,1,50,0)="=============================================="
^DIC(9.4,150,22,2,"PAH",7,1,51,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,52,0)="The Audiometric Exam Module (ACKQ*3.0*3) provides new"
^DIC(9.4,150,22,2,"PAH",7,1,53,0)="functionality for ASPS, to simplify and enhance the entry, display"
^DIC(9.4,150,22,2,"PAH",7,1,54,0)="and use of information obtained during the Audiometric exam of"
^DIC(9.4,150,22,2,"PAH",7,1,55,0)="a patient.  This module is comprised of two distinct application"
^DIC(9.4,150,22,2,"PAH",7,1,56,0)="functions: Audiogram Edit function and the Audiogram Display"
^DIC(9.4,150,22,2,"PAH",7,1,57,0)="function."
^DIC(9.4,150,22,2,"PAH",7,1,58,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,59,0)="Records are stored in a local QUASAR global (#509850.9)."
^DIC(9.4,150,22,2,"PAH",7,1,60,0)="When signed they are also transmitted from this application to the"
^DIC(9.4,150,22,2,"PAH",7,1,61,0)="Denver Distribution Center (DDC) through the VistA MailMan system"
^DIC(9.4,150,22,2,"PAH",7,1,62,0)="for inclusion with orders for hearing aids and repairs when"
^DIC(9.4,150,22,2,"PAH",7,1,63,0)="ordered through the VistA Remote Order Entry System (ROES)"
^DIC(9.4,150,22,2,"PAH",7,1,64,0)="package."
^DIC(9.4,150,22,2,"PAH",7,1,65,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,66,0)="The 'Audiogram Edit' function is a Windows based software"
^DIC(9.4,150,22,2,"PAH",7,1,67,0)="application that allows clinicians to enter, edit or view the"
^DIC(9.4,150,22,2,"PAH",7,1,68,0)="audiometric exam information from the Computerized Patient"
^DIC(9.4,150,22,2,"PAH",7,1,69,0)="Record System (CPRS) Tools menu.  Using this function, a new"
^DIC(9.4,150,22,2,"PAH",7,1,70,0)="audiogram record can be entered, or an existing one can be edited."
^DIC(9.4,150,22,2,"PAH",7,1,71,0)=" Once signed, the edited data can only be viewed."
^DIC(9.4,150,22,2,"PAH",7,1,72,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,73,0)="The 'Audiogram Display' function is a Windows based software"
^DIC(9.4,150,22,2,"PAH",7,1,74,0)="application that allows clinicians to view a patient's audiogram"
^DIC(9.4,150,22,2,"PAH",7,1,75,0)="from the CPRS Tools menu.  It can also be called from the "
^DIC(9.4,150,22,2,"PAH",7,1,76,0)="Audiogram Edit application, if they exist in the same directory"
^DIC(9.4,150,22,2,"PAH",7,1,77,0)="and folder. This function presents the clinical information in a"
^DIC(9.4,150,22,2,"PAH",7,1,78,0)="standard format recognized within the hearing industry. The user"
^DIC(9.4,150,22,2,"PAH",7,1,79,0)="has a choice of viewing just the last audiogram, or the last two"
^DIC(9.4,150,22,2,"PAH",7,1,80,0)="in the file."
^DIC(9.4,150,22,2,"PAH",7,1,81,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,82,0)="ROUTINE SUMMARY"
^DIC(9.4,150,22,2,"PAH",7,1,83,0)="==============="
^DIC(9.4,150,22,2,"PAH",7,1,84,0)="The second line of all listed routines will look like:"
^DIC(9.4,150,22,2,"PAH",7,1,85,0)="  <tab> ;;3.0;QUASAR AUDIOMETRIC MODULE;**3**;11/01/02"
^DIC(9.4,150,22,2,"PAH",7,1,86,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,87,0)="CHECK^XTSUMBLD results:"
^DIC(9.4,150,22,2,"PAH",7,1,88,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,89,0)="ACKQAG01<tab>N/A<tab>9433779<tab>3"
^DIC(9.4,150,22,2,"PAH",7,1,90,0)="ACKQAG02<tab>N/A<tab>14506291<tab>3"
^DIC(9.4,150,22,2,"PAH",7,1,91,0)="ACKQAG03<tab>N/A<tab>4940176<tab>3"
^DIC(9.4,150,22,2,"PAH",7,1,92,0)="ACKQAG04<tab>N/A<tab>133577359<tab>3"
^DIC(9.4,150,22,2,"PAH",7,1,93,0)="ACKQAG05<tab>N/A<tab>1171193<tab>3"
^DIC(9.4,150,22,2,"PAH",7,1,94,0)="ACKQAG06<tab>N/A<tab>12622668<tab>3"
^DIC(9.4,150,22,2,"PAH",7,1,95,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,96,0)="Technical Description"
^DIC(9.4,150,22,2,"PAH",7,1,97,0)="====================="
^DIC(9.4,150,22,2,"PAH",7,1,98,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,99,0)="1. New file introduced with this patch:"
^DIC(9.4,150,22,2,"PAH",7,1,100,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,101,0)="  509850.9<tab>AUDIOMETRIC EXAM<tab>^ACK(509850.9"
^DIC(9.4,150,22,2,"PAH",7,1,102,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,103,0)="2. New options introduced with this patch:"
^DIC(9.4,150,22,2,"PAH",7,1,104,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,105,0)="   ACKQROES3<tab>Audiogram Display"
^DIC(9.4,150,22,2,"PAH",7,1,106,0)="      Uses new remote procedure call: ACKQAUD1. See Option file"
^DIC(9.4,150,22,2,"PAH",7,1,107,0)="      entries to see other existing XWB, XUS, and DDR RPCs"
^DIC(9.4,150,22,2,"PAH",7,1,108,0)="      accessed."
^DIC(9.4,150,22,2,"PAH",7,1,109,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,110,0)="   ACKQROES3E<tab>Audiogram Data Edit"
^DIC(9.4,150,22,2,"PAH",7,1,111,0)="      Uses new remote procedure calls: ACKQROES and ACKQAUD2."
^DIC(9.4,150,22,2,"PAH",7,1,112,0)="      See Option file entries to see other existing XWB, XUS,"
^DIC(9.4,150,22,2,"PAH",7,1,113,0)="      and DDR RPCs accessed."
^DIC(9.4,150,22,2,"PAH",7,1,114,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,115,0)="3. New remote procedure introduced with this patch:"
^DIC(9.4,150,22,2,"PAH",7,1,116,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,117,0)="   ACKQAUD1: returns array of data for last 2 exams"
^DIC(9.4,150,22,2,"PAH",7,1,118,0)="      Uses routines: ACKQAG01 and ACKQAG06"
^DIC(9.4,150,22,2,"PAH",7,1,119,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,120,0)="   ACKQAUD2: returns array of data for a specific exam"
^DIC(9.4,150,22,2,"PAH",7,1,121,0)="      Uses routine: ACKQAG02"
^DIC(9.4,150,22,2,"PAH",7,1,122,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,123,0)="   ACKQROES: transmits data to DDC & returns msg#, DDC msg#,"
^DIC(9.4,150,22,2,"PAH",7,1,124,0)="      error# and error msg."
^DIC(9.4,150,22,2,"PAH",7,1,125,0)="      Uses routines: ACKQAG03, ACKQAG04 and ACKQAG05"
^DIC(9.4,150,22,2,"PAH",7,1,126,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,127,0)="Installation Instructions:"
^DIC(9.4,150,22,2,"PAH",7,1,128,0)="========================="
^DIC(9.4,150,22,2,"PAH",7,1,129,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,130,0)="This patch was created with Kernel V8 KIDS."
^DIC(9.4,150,22,2,"PAH",7,1,131,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,132,0)="1. This is a completely new installation, so it will not affect"
^DIC(9.4,150,22,2,"PAH",7,1,133,0)="   any current ROES 3 users or others on the system. You do not"
^DIC(9.4,150,22,2,"PAH",7,1,134,0)="   need to restrict users from signing on or lock any options."
^DIC(9.4,150,22,2,"PAH",7,1,135,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,136,0)="2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,150,22,2,"PAH",7,1,137,0)="   This option will load the KIDS package onto your system."
^DIC(9.4,150,22,2,"PAH",7,1,138,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,139,0)="3. You DO NOT need to stop Taskman or the background filers. None"
^DIC(9.4,150,22,2,"PAH",7,1,140,0)="   of the routines require mapping, so mapping does not need to be"
^DIC(9.4,150,22,2,"PAH",7,1,141,0)="   disabled."
^DIC(9.4,150,22,2,"PAH",7,1,142,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,143,0)="4. Using the Kernel Installation and Distribution System menu"
^DIC(9.4,150,22,2,"PAH",7,1,144,0)="   (KIDS), you may choose the following options prior to "
^DIC(9.4,150,22,2,"PAH",7,1,145,0)="   installing this patch:"
^DIC(9.4,150,22,2,"PAH",7,1,146,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,147,0)="   a) All routines are new, so there should be no need to Backup"
^DIC(9.4,150,22,2,"PAH",7,1,148,0)="      the Transport Global."
^DIC(9.4,150,22,2,"PAH",7,1,149,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,150,0)="   b) Again, this is an all new module, so there should be no"
^DIC(9.4,150,22,2,"PAH",7,1,151,0)="      need to Compare Transport Global to the Current System."
^DIC(9.4,150,22,2,"PAH",7,1,152,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,153,0)="   c) Verify Checksums in the Transport Global. This option will"
^DIC(9.4,150,22,2,"PAH",7,1,154,0)="      allow you to ensure the integrity of the routines that are"
^DIC(9.4,150,22,2,"PAH",7,1,155,0)="      in the transport global."
^DIC(9.4,150,22,2,"PAH",7,1,156,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,157,0)="5. Use the 'Install Package(s)' option under the 'Installation'"
^DIC(9.4,150,22,2,"PAH",7,1,158,0)="   menu. Installation should only take a few minutes."
^DIC(9.4,150,22,2,"PAH",7,1,159,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,160,0)="   a) Select INSTALL NAME: ACKQ*3.0*3"
^DIC(9.4,150,22,2,"PAH",7,1,161,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,162,0)="   b) When prompted 'Want KIDS to Rebuild Menu Trees Upon"
^DIC(9.4,150,22,2,"PAH",7,1,163,0)="      Completion of Install?' YES// respond ""NO"""
^DIC(9.4,150,22,2,"PAH",7,1,164,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,165,0)="   c) When prompted 'Want KIDS to INHIBIT LOGONs during the "
^DIC(9.4,150,22,2,"PAH",7,1,166,0)="      install?' YES// respond ""NO""."
^DIC(9.4,150,22,2,"PAH",7,1,167,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,168,0)="   d) When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,150,22,2,"PAH",7,1,169,0)="      Option and Protocols?' NO// respond ""NO""."
^DIC(9.4,150,22,2,"PAH",7,1,170,0)=" "
^DIC(9.4,150,22,2,"PAH",7,1,171,0)="   e) When prompted 'Want to MOVE routines to other CPUs?' YES//"
^DIC(9.4,150,22,2,"PAH",7,1,172,0)="      respond ""NO""."
^DIC(9.4,150,22,2,"PAH",7,1,173,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,174,0)="6. Unzip the Audiogram.zip file containing the executables"
^DIC(9.4,150,22,2,"PAH",7,1,175,0)="   ACKQROES3.EXE and ACKQROES3E.EXE onto the network. They must"
^DIC(9.4,150,22,2,"PAH",7,1,176,0)="   reside in the same directory in order for the practitioner to"
^DIC(9.4,150,22,2,"PAH",7,1,177,0)="   view the audiogram display(ACKQROES3) from the audiogram edit"
^DIC(9.4,150,22,2,"PAH",7,1,178,0)="   program (ACKQROES3E). [An alternative is to place the"
^DIC(9.4,150,22,2,"PAH",7,1,179,0)="   executables on each client computer, referencing it in the"
^DIC(9.4,150,22,2,"PAH",7,1,180,0)="   application path of the CPRS Tools menu.]"
^DIC(9.4,150,22,2,"PAH",7,1,181,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,182,0)="7. Assign Broker options ACKQROES3 and ACKQROES3E to selected ASPS"
^DIC(9.4,150,22,2,"PAH",7,1,183,0)="   staff members. This will provide access to the options and"
^DIC(9.4,150,22,2,"PAH",7,1,184,0)="   allow them to startup successfully when the user logs in."
^DIC(9.4,150,22,2,"PAH",7,1,185,0)="  "
^DIC(9.4,150,22,2,"PAH",7,1,186,0)="8. Add the ACKQROES3 and ACKQROES3E applications to the CPRS Tools"
^DIC(9.4,150,22,2,"PAH",7,1,187,0)="   menu. [See the separate installation guide for further"
^DIC(9.4,150,22,2,"PAH",7,1,188,0)="   instructions.]"
^DIC(9.4,150,22,2,"PAH",8,0)="8 SEQ #8^3041015^1"
^DIC(9.4,150,22,2,"PAH",8,1,0)="^^1^1^3041015"
^DIC(9.4,150,22,2,"PAH",8,1,1,0)="Updates for Code Text Versioning. "
^DIC(9.4,150,22,2,"PAH",9,0)="12 SEQ #9^3060112^1"
^DIC(9.4,150,22,2,"PAH",9,1,0)="^^307^307^3060112"
^DIC(9.4,150,22,2,"PAH",9,1,1,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,2,0)="This patch addresses several issues that came up at the VAMC stations as"
^DIC(9.4,150,22,2,"PAH",9,1,3,0)="a result of the initial release of the Audiometric Exam Module (patch"
^DIC(9.4,150,22,2,"PAH",9,1,4,0)="ACKQ*3.0*3). These changes have been made to the GUI(Windows based)"
^DIC(9.4,150,22,2,"PAH",9,1,5,0)="Enter/Edit(ACKQROES3E.EXE) and Display(ACKQROES3.EXE) applications in the"
^DIC(9.4,150,22,2,"PAH",9,1,6,0)="package for both the CPRS Toolbar and Desktop versions, as well as to the"
^DIC(9.4,150,22,2,"PAH",9,1,7,0)="VistA part of the application. The VistA part includes the file data"
^DIC(9.4,150,22,2,"PAH",9,1,8,0)="dictionary, Remote Procedure Calls and routines."
^DIC(9.4,150,22,2,"PAH",9,1,9,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,10,0)="The Audiometric Exam Module was developed in conjunction with the Remote"
^DIC(9.4,150,22,2,"PAH",9,1,11,0)="Order Entry System (ROES 3.0) at the VA Denver Distribution Center(DDC)"
^DIC(9.4,150,22,2,"PAH",9,1,12,0)="and is only available to run in the Windows environment. The application"
^DIC(9.4,150,22,2,"PAH",9,1,13,0)="can be installed completely from this patch, if ACKQ*3.0*3 was not"
^DIC(9.4,150,22,2,"PAH",9,1,14,0)="installed. Users are encouraged to consult the full Installation Guide"
^DIC(9.4,150,22,2,"PAH",9,1,15,0)="referenced below if AKCQ*3.0*3 was not installed. If ACKQ*3.0*3 was "
^DIC(9.4,150,22,2,"PAH",9,1,16,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,17,0)="installed, then installing the KIDS build and copying the new executables "
^DIC(9.4,150,22,2,"PAH",9,1,18,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,19,0)="over the original executables of the same name will complete"
^DIC(9.4,150,22,2,"PAH",9,1,20,0)="the install."
^DIC(9.4,150,22,2,"PAH",9,1,21,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,22,0)="REMEDY ticket(s) addressed in this patch"
^DIC(9.4,150,22,2,"PAH",9,1,23,0)=" ========================================"
^DIC(9.4,150,22,2,"PAH",9,1,24,0)=" HD000000063808"
^DIC(9.4,150,22,2,"PAH",9,1,25,0)=" HD000000063675"
^DIC(9.4,150,22,2,"PAH",9,1,26,0)=" HD000000063875"
^DIC(9.4,150,22,2,"PAH",9,1,27,0)=" HD000000063682"
^DIC(9.4,150,22,2,"PAH",9,1,28,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,29,0)=" Overview of Remedy ticket(s):"
^DIC(9.4,150,22,2,"PAH",9,1,30,0)=" ----------------------------"
^DIC(9.4,150,22,2,"PAH",9,1,31,0)=" Problem: When a user without context accessed the Edit Module, they were"
^DIC(9.4,150,22,2,"PAH",9,1,32,0)=" allowed to enter the application and view the screens. They were not able"
^DIC(9.4,150,22,2,"PAH",9,1,33,0)=" to actually edit the data."
^DIC(9.4,150,22,2,"PAH",9,1,34,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,35,0)=" Solution: The application [ACKQROES3E.EXE] was modified to exit and halt"
^DIC(9.4,150,22,2,"PAH",9,1,36,0)=" the application if the user did not have the appropriate VistA"
^DIC(9.4,150,22,2,"PAH",9,1,37,0)=" application assigned to create context."
^DIC(9.4,150,22,2,"PAH",9,1,38,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,39,0)=" Associated Remedy Ticket: HD000000063808"
^DIC(9.4,150,22,2,"PAH",9,1,40,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,41,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,42,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,43,0)=" -----"
^DIC(9.4,150,22,2,"PAH",9,1,44,0)=" Problem: Sites encountered a Null Subscript at EN2+4^ACKQAG02 when"
^DIC(9.4,150,22,2,"PAH",9,1,45,0)=" entering a new record and cancels out of entering the date and time of"
^DIC(9.4,150,22,2,"PAH",9,1,46,0)=" the exam."
^DIC(9.4,150,22,2,"PAH",9,1,47,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,48,0)=" Solution: A fix is applied in routine ACKQAG02 and in the record setup"
^DIC(9.4,150,22,2,"PAH",9,1,49,0)=" to give the appropriate error message and exit the application if a valid"
^DIC(9.4,150,22,2,"PAH",9,1,50,0)=" date and time are not entered."
^DIC(9.4,150,22,2,"PAH",9,1,51,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,52,0)=" Associated Remedy Tickets: HD000000063675 and HD000000063875"
^DIC(9.4,150,22,2,"PAH",9,1,53,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,54,0)=" -----"
^DIC(9.4,150,22,2,"PAH",9,1,55,0)=" Problem: Some error messages or message prompts were coming up behind"
^DIC(9.4,150,22,2,"PAH",9,1,56,0)=" other screens. The only way for them to show up was to select the"
^DIC(9.4,150,22,2,"PAH",9,1,57,0)=" application from the bottom task bar."
^DIC(9.4,150,22,2,"PAH",9,1,58,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,59,0)=" Solution: Most of the messages in the Audiogram Edit application are now"
^DIC(9.4,150,22,2,"PAH",9,1,60,0)=" enclosed in code to send them to topmost position and after the message"
^DIC(9.4,150,22,2,"PAH",9,1,61,0)=" ends, to restore the previous topmost setup.  This may not be a complete"
^DIC(9.4,150,22,2,"PAH",9,1,62,0)=" solution, but available documentation indicates it should help, if not"
^DIC(9.4,150,22,2,"PAH",9,1,63,0)=" eliminate the problem from this application."
^DIC(9.4,150,22,2,"PAH",9,1,64,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,65,0)=" Associated Remedy Ticket: HD000000063682"
^DIC(9.4,150,22,2,"PAH",9,1,66,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,67,0)=" -----"
^DIC(9.4,150,22,2,"PAH",9,1,68,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,69,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,70,0)="This patch contains the following enhancements:"
^DIC(9.4,150,22,2,"PAH",9,1,71,0)="==============================================="
^DIC(9.4,150,22,2,"PAH",9,1,72,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,73,0)="The Audiometric Exam Module provided new functionality for Audiology and"
^DIC(9.4,150,22,2,"PAH",9,1,74,0)="Speech Pathology Services(ASPS), to simplify and enhance the entry,"
^DIC(9.4,150,22,2,"PAH",9,1,75,0)="display and use of information obtained during the Audiometric exam of a"
^DIC(9.4,150,22,2,"PAH",9,1,76,0)="patient. This module is comprised of two distinct application functions:"
^DIC(9.4,150,22,2,"PAH",9,1,77,0)="        Audiogram Edit function [ACKQROES3E.EXE]"
^DIC(9.4,150,22,2,"PAH",9,1,78,0)="        Audiogram Display function [ACKQROES3.EXE]"
^DIC(9.4,150,22,2,"PAH",9,1,79,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,80,0)="Records are stored in the local AUDIOMETRIC EXAM file (^ACK(509850.9)."
^DIC(9.4,150,22,2,"PAH",9,1,81,0)="When signed, the records are also transmitted from this global to the DDC"
^DIC(9.4,150,22,2,"PAH",9,1,82,0)="through the VistA Mailman system. At the DDC, data from these records is"
^DIC(9.4,150,22,2,"PAH",9,1,83,0)="included with orders for hearing aids and repairs when the orders are"
^DIC(9.4,150,22,2,"PAH",9,1,84,0)="placed through the VistA Remote Order Entry System (ROES) package."
^DIC(9.4,150,22,2,"PAH",9,1,85,0)="They may also be viewed remotely from the ROES Patient Information screen"
^DIC(9.4,150,22,2,"PAH",9,1,86,0)="of the ROES web application."
^DIC(9.4,150,22,2,"PAH",9,1,87,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,88,0)="ACKQ*3.0*12 implements the following changes:"
^DIC(9.4,150,22,2,"PAH",9,1,89,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,90,0)=" 1. Removal of Buttons"
^DIC(9.4,150,22,2,"PAH",9,1,91,0)=" In both audiogram GUI applications, the buttons previously on the screens"
^DIC(9.4,150,22,2,"PAH",9,1,92,0)=" have been replaced by menu options at the top of the form."
^DIC(9.4,150,22,2,"PAH",9,1,93,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,94,0)=" 2. Loop to Another Patient or Record"
^DIC(9.4,150,22,2,"PAH",9,1,95,0)=" In both applications, a menu option (Get New Record) has been added to"
^DIC(9.4,150,22,2,"PAH",9,1,96,0)=" allow the user to go to another record without exiting the application."
^DIC(9.4,150,22,2,"PAH",9,1,97,0)=" If accessing through CPRS, record selection is limited to the current"
^DIC(9.4,150,22,2,"PAH",9,1,98,0)=" patient. From the Desktop application, users may select another patient"
^DIC(9.4,150,22,2,"PAH",9,1,99,0)=" or go to another record for the same patient."
^DIC(9.4,150,22,2,"PAH",9,1,100,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,101,0)=" 3. Comments"
^DIC(9.4,150,22,2,"PAH",9,1,102,0)=" A comment box has been added to the Edit application where the clinician"
^DIC(9.4,150,22,2,"PAH",9,1,103,0)=" can enter up to 300 characters of text. A checkbox has been inserted"
^DIC(9.4,150,22,2,"PAH",9,1,104,0)=" directly above the comment area for use if the clinician would like to"
^DIC(9.4,150,22,2,"PAH",9,1,105,0)=" automatically insert the words ""NOT ADEQUATE FOR RATING PURPOSES"". This"
^DIC(9.4,150,22,2,"PAH",9,1,106,0)=" text will be saved to the file and will be imported into VA form 10-2364."
^DIC(9.4,150,22,2,"PAH",9,1,107,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,108,0)=" 4. Update VA form 10-2364"
^DIC(9.4,150,22,2,"PAH",9,1,109,0)=" VA form 10 2364 has been modified to reflect the changes made to the form"
^DIC(9.4,150,22,2,"PAH",9,1,110,0)=" since the release of patch ACKQ*3.0*3. The comment section of the form is"
^DIC(9.4,150,22,2,"PAH",9,1,111,0)=" no longer editable."
^DIC(9.4,150,22,2,"PAH",9,1,112,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,113,0)=" 5. Color Changes"
^DIC(9.4,150,22,2,"PAH",9,1,114,0)=" Color has been removed from the data entry boxes. This allows for a"
^DIC(9.4,150,22,2,"PAH",9,1,115,0)=" cleaner presentation and makes more of the screen available for the edit"
^DIC(9.4,150,22,2,"PAH",9,1,116,0)=" boxes."
^DIC(9.4,150,22,2,"PAH",9,1,117,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,118,0)=" 6. Retransmit Audiogram"
^DIC(9.4,150,22,2,"PAH",9,1,119,0)=" In the Edit application, a menu option has been added to allow"
^DIC(9.4,150,22,2,"PAH",9,1,120,0)=" retransmission of a signed audiogram.  This is necessary to transfer the"
^DIC(9.4,150,22,2,"PAH",9,1,121,0)=" speech, word and other readings that were not a part of the original"
^DIC(9.4,150,22,2,"PAH",9,1,122,0)=" transmission."
^DIC(9.4,150,22,2,"PAH",9,1,123,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,124,0)=" 7. Removing Audiogram"
^DIC(9.4,150,22,2,"PAH",9,1,125,0)=" In the Edit application, a menu option has been added to allow deletion"
^DIC(9.4,150,22,2,"PAH",9,1,126,0)=" of a signed audiogram. This became necessary because, in their haste to"
^DIC(9.4,150,22,2,"PAH",9,1,127,0)=" enter audiograms under heavy workload pressures, users sometimes entered"
^DIC(9.4,150,22,2,"PAH",9,1,128,0)=" audiograms under the wrong patient and the error was not discovered until"
^DIC(9.4,150,22,2,"PAH",9,1,129,0)=" after transmission. This would then become a problem when data would be"
^DIC(9.4,150,22,2,"PAH",9,1,130,0)=" on duplicate systems for the wrong patient. After installing this patch,"
^DIC(9.4,150,22,2,"PAH",9,1,131,0)=" when a local signed audiogram is deleted, a message with identifying"
^DIC(9.4,150,22,2,"PAH",9,1,132,0)=" information is sent to the DDC to delete the record there also."
^DIC(9.4,150,22,2,"PAH",9,1,133,0)=" Clinicians should use utmost caution in both entering and removing"
^DIC(9.4,150,22,2,"PAH",9,1,134,0)=" audiograms."
^DIC(9.4,150,22,2,"PAH",9,1,135,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,136,0)=" 8. File Changes"
^DIC(9.4,150,22,2,"PAH",9,1,137,0)=" Numerous fields were added to the AUDIOMETRIC EXAM file to provide the"
^DIC(9.4,150,22,2,"PAH",9,1,138,0)=" additional data needed for diagnostic and reporting purposes. The data"
^DIC(9.4,150,22,2,"PAH",9,1,139,0)=" type of many fields was changed at the request of the national program"
^DIC(9.4,150,22,2,"PAH",9,1,140,0)=" office to more efficiently handle the text and tags required in the"
^DIC(9.4,150,22,2,"PAH",9,1,141,0)=" fields. Many that were numeric are now free text. Refer to the"
^DIC(9.4,150,22,2,"PAH",9,1,142,0)=" CHANGES/ADDITIONS TO FILE section for more detailed information."
^DIC(9.4,150,22,2,"PAH",9,1,143,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,144,0)=" 9. New Fields on Edit Pages"
^DIC(9.4,150,22,2,"PAH",9,1,145,0)=" The new editable fields (bullet 8) and data type screening were added to"
^DIC(9.4,150,22,2,"PAH",9,1,146,0)=" the Edit program."
^DIC(9.4,150,22,2,"PAH",9,1,147,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,148,0)=" 10. Masking Change"
^DIC(9.4,150,22,2,"PAH",9,1,149,0)=" Masking is no longer referenced in the fields with an '*', but will"
^DIC(9.4,150,22,2,"PAH",9,1,150,0)=" instead be indicated by a non-zero numeric value in the 'Masking Level'"
^DIC(9.4,150,22,2,"PAH",9,1,151,0)=" field. Prior instances of the data without a masking level will continue"
^DIC(9.4,150,22,2,"PAH",9,1,152,0)=" to display the '*' sign."
^DIC(9.4,150,22,2,"PAH",9,1,153,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,154,0)=" 11. No Response Change"
^DIC(9.4,150,22,2,"PAH",9,1,155,0)=" The symbol for 'No Response'(+) will now be stored in the text field with"
^DIC(9.4,150,22,2,"PAH",9,1,156,0)=" the numeric value."
^DIC(9.4,150,22,2,"PAH",9,1,157,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,158,0)=" 12. No Testing, No Masking"
^DIC(9.4,150,22,2,"PAH",9,1,159,0)=" 'CNM', 'CNT', 'DNT' and 'FLAT; are now accommodated in the appropriate"
^DIC(9.4,150,22,2,"PAH",9,1,160,0)=" text fields in the file as well as in the Edit program."
^DIC(9.4,150,22,2,"PAH",9,1,161,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,162,0)=" 13. Transducer Type"
^DIC(9.4,150,22,2,"PAH",9,1,163,0)=" Users can now indicate if testing was done via inserts or headphones."
^DIC(9.4,150,22,2,"PAH",9,1,164,0)=" This is also displayed on the 10-2364."
^DIC(9.4,150,22,2,"PAH",9,1,165,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,166,0)=" 14. Eliminate Duplicate Presentation and Material"
^DIC(9.4,150,22,2,"PAH",9,1,167,0)=" One selection of the Presentation Method and Material are now applicable"
^DIC(9.4,150,22,2,"PAH",9,1,168,0)=" to all of the Word Recognition tests, via a single drop down list."
^DIC(9.4,150,22,2,"PAH",9,1,169,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,170,0)=" 15. Tympanogram Type and Other Test"
^DIC(9.4,150,22,2,"PAH",9,1,171,0)=" Tympanogram Type and 'Other Test' types have been added to the Acoustic"
^DIC(9.4,150,22,2,"PAH",9,1,172,0)=" Immittance page."
^DIC(9.4,150,22,2,"PAH",9,1,173,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,174,0)=" 16. Claim Number"
^DIC(9.4,150,22,2,"PAH",9,1,175,0)=" The Claim Number has been added to the Edit form so that it can be"
^DIC(9.4,150,22,2,"PAH",9,1,176,0)=" included on VA form 10-2364."
^DIC(9.4,150,22,2,"PAH",9,1,177,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,178,0)=" 17. Maximum Value Change"
^DIC(9.4,150,22,2,"PAH",9,1,179,0)=" Maximum values allowed have been updated and associated 'Hints' have been"
^DIC(9.4,150,22,2,"PAH",9,1,180,0)=" adjusted."
^DIC(9.4,150,22,2,"PAH",9,1,181,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,182,0)=" 18. Hints"
^DIC(9.4,150,22,2,"PAH",9,1,183,0)=" It is now possible for the user to inactivate or reactivate the hint"
^DIC(9.4,150,22,2,"PAH",9,1,184,0)=" feature."
^DIC(9.4,150,22,2,"PAH",9,1,185,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,186,0)=" 19. Clinician Title"
^DIC(9.4,150,22,2,"PAH",9,1,187,0)=" The title of the clinician and location will now show on the display."
^DIC(9.4,150,22,2,"PAH",9,1,188,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,189,0)=" 20. Presentation Method"
^DIC(9.4,150,22,2,"PAH",9,1,190,0)=" CD and Tape have been consolidated into a single Recorded type."
^DIC(9.4,150,22,2,"PAH",9,1,191,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,192,0)=" 21. About Box"
^DIC(9.4,150,22,2,"PAH",9,1,193,0)=" An 'About' box was added to the main forms to comply with VistA"
^DIC(9.4,150,22,2,"PAH",9,1,194,0)=" convention."
^DIC(9.4,150,22,2,"PAH",9,1,195,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,196,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,197,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,198,0)="Software and Documentation Retrieval"
^DIC(9.4,150,22,2,"PAH",9,1,199,0)="===================================="
^DIC(9.4,150,22,2,"PAH",9,1,200,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,201,0)=" The software and documentation for this patch can be found in the"
^DIC(9.4,150,22,2,"PAH",9,1,202,0)=" following [ANONYMOUS.SOFTWARE] directories:"
^DIC(9.4,150,22,2,"PAH",9,1,203,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,204,0)="                                        Preferred Address"
^DIC(9.4,150,22,2,"PAH",9,1,205,0)="                                        ----------------------"
^DIC(9.4,150,22,2,"PAH",9,1,206,0)="        First available FTP server      download.vista.domain.ext"
^DIC(9.4,150,22,2,"PAH",9,1,207,0)=" "
