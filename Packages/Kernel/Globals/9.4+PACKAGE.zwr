^DIC(9.4,60,22,12,"PAH",12,1,0)="^^1^1^2980120"
^DIC(9.4,60,22,12,"PAH",12,1,1,0)="See the patch description PSO*6*165."
^DIC(9.4,60,22,12,"PAH",13,0)="166 SEQ #165^2980220^1"
^DIC(9.4,60,22,12,"PAH",13,1,0)="^^1^1^2980220"
^DIC(9.4,60,22,12,"PAH",13,1,1,0)="See the patch description PSO*6*166."
