^DIC(9.4,77,22,17,"PAH",234,1,1,0)="The purpose of this patch is to provide software bug fixes for Inpatient "
^DIC(9.4,77,22,17,"PAH",234,1,2,0)="Medications.  This patch corrects the following issues:"
^DIC(9.4,77,22,17,"PAH",234,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",234,1,4,0)="-Nurse not authorized to edit Dispense Drugs"
^DIC(9.4,77,22,17,"PAH",234,1,5,0)="-Display Status of reinstated orders incorrect"
^DIC(9.4,77,22,17,"PAH",235,0)="248 SEQ #236^3121004.170558^17"
^DIC(9.4,77,22,17,"PAH",235,1,0)="^9.49011^7^7^3121004"
^DIC(9.4,77,22,17,"PAH",235,1,1,0)="The purpose of this patch is to provide software bug fixes for Inpatient "
^DIC(9.4,77,22,17,"PAH",235,1,2,0)="Medications and the IV Site Parameters option to correct several errors.  "
^DIC(9.4,77,22,17,"PAH",235,1,3,0)="This patch corrects the following issues:"
^DIC(9.4,77,22,17,"PAH",235,1,4,0)=" "
^DIC(9.4,77,22,17,"PAH",235,1,5,0)="-Edit IVPB Stop Date Warning Message"
^DIC(9.4,77,22,17,"PAH",235,1,6,0)="-7-Day MAR Undefined Error"
^DIC(9.4,77,22,17,"PAH",235,1,7,0)="-IV Site Parameters Undefined Error"
^DIC(9.4,77,22,17,"PAH",236,0)="278 SEQ #237^3121024.142318^17"
^DIC(9.4,77,22,17,"PAH",236,1,0)="^^5^5^3121024"
^DIC(9.4,77,22,17,"PAH",236,1,1,0)="This patch will resolve the following issues in the Inpatient Medications "
^DIC(9.4,77,22,17,"PAH",236,1,2,0)="package:"
^DIC(9.4,77,22,17,"PAH",236,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",236,1,4,0)="-Orderable item not updating on renewal"
^DIC(9.4,77,22,17,"PAH",236,1,5,0)="-<SUBSCRIPT> error when viewing patient profiles"
^DIC(9.4,77,22,17,"PAH",237,0)="284 SEQ #238^3121212.091247^17"
^DIC(9.4,77,22,17,"PAH",237,1,0)="^^4^4^3121212"
