^DIC(9.4,13,22,7,"PAH",15,1,10,0)="     Houston VAMC"
^DIC(9.4,13,22,7,"PAH",15,1,11,0)="     White City VAMC"
^DIC(9.4,13,22,7,"PAH",15,1,12,0)="     George Timson"
^DIC(9.4,13,22,7,"PAH",15,1,13,0)="     Michael Ogi"
^DIC(9.4,13,22,7,"PAH",15,1,14,0)=" "
