^DIC(9.4,82,11)="50^554"
^DIC(9.4,82,22,0)="^9.49I^2^2"
^DIC(9.4,82,22,1,0)="1.0^2950510^2960718"
^DIC(9.4,82,22,1,"PAH",0)="^9.4901^4^4"
^DIC(9.4,82,22,1,"PAH",1,0)="4^2960718^1"
^DIC(9.4,82,22,1,"PAH",1,1,0)="^^2^2^2960718"
^DIC(9.4,82,22,1,"PAH",1,1,1,0)="Consolidated Mail Outpatient Pharmacy Patch # 4 - Corrects days to pull"
^DIC(9.4,82,22,1,"PAH",1,1,2,0)="ahead parameter and Drug Warning problems."
^DIC(9.4,82,22,1,"PAH",2,0)="8^2960718^1"
^DIC(9.4,82,22,1,"PAH",2,1,0)="^^1^1^2960718"
^DIC(9.4,82,22,1,"PAH",2,1,1,0)="This build corrects a problem in PSX*1*4."
^DIC(9.4,82,22,1,"PAH",3,0)="10^2960829^1"
^DIC(9.4,82,22,1,"PAH",3,1,0)="^^1^1^2960829"
^DIC(9.4,82,22,1,"PAH",3,1,1,0)="Correct a problem with the automated recovery process."
^DIC(9.4,82,22,1,"PAH",4,0)="11^2961123^1"
^DIC(9.4,82,22,1,"PAH",4,1,0)="^^8^8^2961123"
^DIC(9.4,82,22,1,"PAH",4,1,1,0)="When a user unmarks a drug for Outpatient use, the drug will now be"
^DIC(9.4,82,22,1,"PAH",4,1,2,0)="automatically unmarked for CMOP transmission."
^DIC(9.4,82,22,1,"PAH",4,1,3,0)=" "
^DIC(9.4,82,22,1,"PAH",4,1,4,0)="The Outpatient one year patch conflicted with code that determines how to"
^DIC(9.4,82,22,1,"PAH",4,1,5,0)="display refills.  The number 6 was a code used to indicate that the fill"
^DIC(9.4,82,22,1,"PAH",4,1,6,0)="was a partial so the sixth refill was being diplayed as a partial. CMOP"
^DIC(9.4,82,22,1,"PAH",4,1,7,0)="routines now mimic the O.P. method to display the refill correctly while"
^DIC(9.4,82,22,1,"PAH",4,1,8,0)="allowing partials to display correctly."
^DIC(9.4,82,22,1,"PAH","B",4,1)=""
^DIC(9.4,82,22,1,"PAH","B",8,2)=""
^DIC(9.4,82,22,1,"PAH","B",10,3)=""
^DIC(9.4,82,22,1,"PAH","B",11,4)=""
^DIC(9.4,82,22,2,0)="2.0^3051119^2970414^1"
^DIC(9.4,82,22,2,1,0)="^^1^1^3051119"
^DIC(9.4,82,22,2,1,1,0)="CMOP V 2.0T9 ALPHA BUILD FOR MEDICAL CENTERS"
^DIC(9.4,82,22,2,"PAH",0)="^9.4901^82^82"
^DIC(9.4,82,22,2,"PAH",1,0)="1^2970528^1"
^DIC(9.4,82,22,2,"PAH",1,1,0)="^^1^1^2970528"
^DIC(9.4,82,22,2,"PAH",1,1,1,0)="Patch 1 for version 2 to correct problems with V1 sites going to V2."
^DIC(9.4,82,22,2,"PAH",2,0)="2^2970602^1"
^DIC(9.4,82,22,2,"PAH",2,1,0)="^^1^1^2970602"
^DIC(9.4,82,22,2,"PAH",2,1,1,0)="Patch 2 to correct problems with V2."
^DIC(9.4,82,22,2,"PAH",3,0)="4 SEQ #3^2970819^1"
^DIC(9.4,82,22,2,"PAH",3,1,0)="^^1^1^2970819"
^DIC(9.4,82,22,2,"PAH",3,1,1,0)="This patch is being distributed in response to NOIS ALN-0597-12107."
^DIC(9.4,82,22,2,"PAH",4,0)="5 SEQ #4^2970819^1"
^DIC(9.4,82,22,2,"PAH",4,1,0)="^^1^1^2970819"
^DIC(9.4,82,22,2,"PAH",4,1,1,0)="This patch is being distributed as a correction to patch PSX*2*4."
^DIC(9.4,82,22,2,"PAH",5,0)="7 SEQ #6^2971105^1"
^DIC(9.4,82,22,2,"PAH",5,1,0)="^^1^1^2971105"
^DIC(9.4,82,22,2,"PAH",5,1,1,0)="This patch is being distributed in response to NOIS MAR-0897-21215."
^DIC(9.4,82,22,2,"PAH",6,0)="10 SEQ #7^2980202^1"
^DIC(9.4,82,22,2,"PAH",6,1,0)="^^1^1^2980202"
^DIC(9.4,82,22,2,"PAH",6,1,1,0)="See the patch description for PSX*2.0*10."
^DIC(9.4,82,22,2,"PAH",7,0)="9 SEQ #8^2980330^1"
^DIC(9.4,82,22,2,"PAH",7,1,0)="^^1^1^2980330"
^DIC(9.4,82,22,2,"PAH",7,1,1,0)="This patch is being distributed in response to NOIS CMM-0997-N0446."
^DIC(9.4,82,22,2,"PAH",8,0)="13 SEQ #9^2980403^1"
^DIC(9.4,82,22,2,"PAH",8,1,0)="^^1^1^2980403"
^DIC(9.4,82,22,2,"PAH",8,1,1,0)="See the patch description for PSX*2.0*13."
^DIC(9.4,82,22,2,"PAH",9,0)="11 SEQ #10^2980417^1"
^DIC(9.4,82,22,2,"PAH",9,1,0)="^^1^1^2980417"
^DIC(9.4,82,22,2,"PAH",9,1,1,0)="See the patch description for PSX*2.0*11."
^DIC(9.4,82,22,2,"PAH",10,0)="16 SEQ #11^2980527^1"
^DIC(9.4,82,22,2,"PAH",10,1,0)="^^1^1^2980527"
^DIC(9.4,82,22,2,"PAH",10,1,1,0)="See the patch description for PSX*2.0*16."
^DIC(9.4,82,22,2,"PAH",11,0)="12^2980701^1"
^DIC(9.4,82,22,2,"PAH",11,1,0)="^^1^1^2980701"
^DIC(9.4,82,22,2,"PAH",11,1,1,0)="See the patch description for PSX*2.0*12."
^DIC(9.4,82,22,2,"PAH",12,0)="14 SEQ #13^2980831^1"
^DIC(9.4,82,22,2,"PAH",12,1,0)="^^1^1^2980831"
^DIC(9.4,82,22,2,"PAH",12,1,1,0)="See the patch description for PSX*2*14."
^DIC(9.4,82,22,2,"PAH",13,0)="3 SEQ #14^2980923^1"
^DIC(9.4,82,22,2,"PAH",13,1,0)="^^58^58^2980923"
^DIC(9.4,82,22,2,"PAH",13,1,1,0)="The patch modifies CMOP routines to work with Outpatient Pharmacy V6 and"
^DIC(9.4,82,22,2,"PAH",13,1,2,0)="V7. "
^DIC(9.4,82,22,2,"PAH",13,1,3,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,4,0)="The following modifications were made to CMOP routines so that the CMOP"
^DIC(9.4,82,22,2,"PAH",13,1,5,0)="process will work with either OP6 or OP7."
^DIC(9.4,82,22,2,"PAH",13,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,7,0)="ROUTINE        Summary of Modifications"
^DIC(9.4,82,22,2,"PAH",13,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,9,0)="PSXAUTO        Makes a call to the PSXUTL routine to get the version"
^DIC(9.4,82,22,2,"PAH",13,1,10,0)="               of OP that is on the system. Sets the PSXVER variable"
^DIC(9.4,82,22,2,"PAH",13,1,11,0)="               to indicate the OP version. This variable determines the"
^DIC(9.4,82,22,2,"PAH",13,1,12,0)="               location of the Status and SIG fields in the Rx file (#52)."
^DIC(9.4,82,22,2,"PAH",13,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,14,0)="PSXBLD         Modified to get the Status and SIG fields from the proper"
^DIC(9.4,82,22,2,"PAH",13,1,15,0)="               location in the Rx file (#52) based on the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,17,0)="PSXBLD1        Modified to get the Status from the proper location in"
^DIC(9.4,82,22,2,"PAH",13,1,18,0)="               the Rx file (#52) based on the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,19,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,20,0)="PSXCOPAY       Modified to get the Status from the proper location in the"
^DIC(9.4,82,22,2,"PAH",13,1,21,0)="               Rx file (#52) based on the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,23,0)="PSXERR         Modified to provide an error message if the package file"
^DIC(9.4,82,22,2,"PAH",13,1,24,0)="               entry for the OP package is missing the version number."
^DIC(9.4,82,22,2,"PAH",13,1,25,0)="               This error message is the CMOP Error Encountered mail msg."
^DIC(9.4,82,22,2,"PAH",13,1,26,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,27,0)="PSXMISC1       Modified to set the new fields in the Rx Suspense file when"
^DIC(9.4,82,22,2,"PAH",13,1,28,0)="               marking the Rx as 'Loading' and/or 'Transmitted'."
^DIC(9.4,82,22,2,"PAH",13,1,29,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,30,0)="PSXRESUB       Modified to set the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,31,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,32,0)="PSXRCVRY       Modified to set the Status field in the Rx file (#52) based"
^DIC(9.4,82,22,2,"PAH",13,1,33,0)="               on the OP version. Makes the call to PSOHLSN1 to send"
^DIC(9.4,82,22,2,"PAH",13,1,34,0)="               send changes in the status field in the Prescription file"
^DIC(9.4,82,22,2,"PAH",13,1,35,0)="               (#52) to CPRS."
^DIC(9.4,82,22,2,"PAH",13,1,36,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,37,0)="PSXRPPL        Modified to check the Status field and SIG field in the Rx"
^DIC(9.4,82,22,2,"PAH",13,1,38,0)="               file (#52) based on the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,39,0)="               Makes the call to PSOHLSN1 to send changes in the status"
^DIC(9.4,82,22,2,"PAH",13,1,40,0)="               field in the Prescription file (#52) to CPRS."
^DIC(9.4,82,22,2,"PAH",13,1,41,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,42,0)="PSXRPPL1       Modified to check the Status field and SIG field in the Rx"
^DIC(9.4,82,22,2,"PAH",13,1,43,0)="               file (#52) based on the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,44,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,45,0)="PSXRSUS        Modified to ZTSAVE the variable, PSXVER. This variable is "
^DIC(9.4,82,22,2,"PAH",13,1,46,0)="               used to determine the location of the Status and SIG fields"
^DIC(9.4,82,22,2,"PAH",13,1,47,0)="               in the Rx file (#52) based on the OP version."
^DIC(9.4,82,22,2,"PAH",13,1,48,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,49,0)="PSXSRP         This is a new routine to allow users to reprint CMOP Rx's"
^DIC(9.4,82,22,2,"PAH",13,1,50,0)="               that were printed at the remote medical center by batch."
^DIC(9.4,82,22,2,"PAH",13,1,51,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,52,0)="PSXSRST        This is a new routine to allow users to reprint by batch"
^DIC(9.4,82,22,2,"PAH",13,1,53,0)="               CMOP Rx's that were printed at the remote medical center."
^DIC(9.4,82,22,2,"PAH",13,1,54,0)="               Makes the call to PSOHLSN1 to send changes in the status"
^DIC(9.4,82,22,2,"PAH",13,1,55,0)="               field in the Prescription file (#52) to CPRS."
^DIC(9.4,82,22,2,"PAH",13,1,56,0)=" "
^DIC(9.4,82,22,2,"PAH",13,1,57,0)="PSXUTL         Modified to set the variable PSXVER. This variable is used"
^DIC(9.4,82,22,2,"PAH",13,1,58,0)="               determine the OP version."
^DIC(9.4,82,22,2,"PAH",14,0)="18 SEQ #15^2980923^1"
^DIC(9.4,82,22,2,"PAH",14,1,0)="^^1^1^2980923"
^DIC(9.4,82,22,2,"PAH",14,1,1,0)="See the patch description for PSX*2.0*18."
^DIC(9.4,82,22,2,"PAH",15,0)="19 SEQ #16^2981026^1"
^DIC(9.4,82,22,2,"PAH",15,1,0)="^^2^2^2981026"
^DIC(9.4,82,22,2,"PAH",15,1,1,0)="This patch addresses concerns aired in NOIS #'s"
^DIC(9.4,82,22,2,"PAH",15,1,2,0)="OKL-1098-70296,CMP-0398-62763 and BOI-1098-50491."
^DIC(9.4,82,22,2,"PAH",16,0)="20 SEQ #17^2990417^1"
^DIC(9.4,82,22,2,"PAH",16,1,0)="^^3^3^2990417"
^DIC(9.4,82,22,2,"PAH",16,1,1,0)="The variable PSOSITE, used by both the CMOP and OUTPATIENT PHARMACY"
^DIC(9.4,82,22,2,"PAH",16,1,2,0)="packages is killed in the ^PSXRESUB routine.  This causes an undefined"
^DIC(9.4,82,22,2,"PAH",16,1,3,0)="variable to occur in the OUTPATIENT PHARMACY package in certain instances."
^DIC(9.4,82,22,2,"PAH",17,0)="15 SEQ #18^2990602^1"
^DIC(9.4,82,22,2,"PAH",17,1,0)="^^3^3^2990602"
^DIC(9.4,82,22,2,"PAH",17,1,1,0)="This patch contains a routine that will notify the CLINICAL INFORMATION"
^DIC(9.4,82,22,2,"PAH",17,1,2,0)="RESOURCES NETWORK (CIRN) V.1.0 package when a CMOP prescription is  "
^DIC(9.4,82,22,2,"PAH",17,1,3,0)="released."
^DIC(9.4,82,22,2,"PAH",18,0)="17 SEQ #19^2990622^1"
^DIC(9.4,82,22,2,"PAH",18,1,0)="^^6^6^2990622"
^DIC(9.4,82,22,2,"PAH",18,1,1,0)="The CMOP DUAL LINE INTERFACE enhancement modifies the lower layer "
^DIC(9.4,82,22,2,"PAH",18,1,2,0)="communication link software utilized by CMOP Host systems and vendor "
^DIC(9.4,82,22,2,"PAH",18,1,3,0)="automated dispensing systems for electronic data exchange of prescription"
^DIC(9.4,82,22,2,"PAH",18,1,4,0)="information. Functionality allows CMOP Host facilities to simultaneously"
^DIC(9.4,82,22,2,"PAH",18,1,5,0)="perform transmission data download and query request for prescription"
^DIC(9.4,82,22,2,"PAH",18,1,6,0)="information."
^DIC(9.4,82,22,2,"PAH",19,0)="21 SEQ #20^2990622^1"
^DIC(9.4,82,22,2,"PAH",19,1,0)="^^8^8^2990622"
^DIC(9.4,82,22,2,"PAH",19,1,1,0)="Patch PSX*2*20 corrected an undefined error in the variable PSOSITE,"
^DIC(9.4,82,22,2,"PAH",19,1,2,0)="which was shared by the Outpatient Pharmacy and CONSOLIDATED MAIL"
^DIC(9.4,82,22,2,"PAH",19,1,3,0)="OUTPATIENT PHARMACY (CMOP) packages.  The CMOP package killed this"
^DIC(9.4,82,22,2,"PAH",19,1,4,0)="variable, causing the undefined condition.  This condition was corrected"
^DIC(9.4,82,22,2,"PAH",19,1,5,0)="by the patch, but, depending on how the user entered the option to"
^DIC(9.4,82,22,2,"PAH",19,1,6,0)="resubmit the Rx, the variable PSOSITE might not be defined at all.  This"
^DIC(9.4,82,22,2,"PAH",19,1,7,0)="patch checks for the existence of the variable PSOSITE and prevents the"
^DIC(9.4,82,22,2,"PAH",19,1,8,0)="second undefined error from occurring."
^DIC(9.4,82,22,2,"PAH",20,0)="24 SEQ #21^2991123^1"
^DIC(9.4,82,22,2,"PAH",20,1,0)="^^11^11^2991123"
^DIC(9.4,82,22,2,"PAH",20,1,1,0)="1.     An adjustment to the CMOP software has become necessary with the"
^DIC(9.4,82,22,2,"PAH",20,1,2,0)="distribution of  MailMan patch 50. The % variable returned from the"
^DIC(9.4,82,22,2,"PAH",20,1,3,0)="NOW^%DTC function is being killed in a MailMan routine where it was"
^DIC(9.4,82,22,2,"PAH",20,1,4,0)="previously not."
^DIC(9.4,82,22,2,"PAH",20,1,5,0)="2.     A modification to the CMOP software has become necessary with the"
^DIC(9.4,82,22,2,"PAH",20,1,6,0)="release of Fileman V. 22.  The variable DIC(0) is now killed where is was"
^DIC(9.4,82,22,2,"PAH",20,1,7,0)="previously not."
^DIC(9.4,82,22,2,"PAH",20,1,8,0)="3.     A second modification was necessary as a result of MailMan patches."
^DIC(9.4,82,22,2,"PAH",20,1,9,0)="CMOP error messages normally delivered to the holders of the PSXMAIL key"
^DIC(9.4,82,22,2,"PAH",20,1,10,0)="were being held up.  Changing the way the routing was handled fixed this"
^DIC(9.4,82,22,2,"PAH",20,1,11,0)="problem."
^DIC(9.4,82,22,2,"PAH",21,0)="22 SEQ #22^3000229^1"
^DIC(9.4,82,22,2,"PAH",21,1,0)="^^14^14^3000229"
^DIC(9.4,82,22,2,"PAH",21,1,1,0)="Problem:"
^DIC(9.4,82,22,2,"PAH",21,1,2,0)="========"
^DIC(9.4,82,22,2,"PAH",21,1,3,0)="A problem was reported with the Drug Cost by Drug Report for One Month"
^DIC(9.4,82,22,2,"PAH",21,1,4,0)="[PSX COST ONE MONTH DRUG REPORT] where if the user selects a specific drug"
^DIC(9.4,82,22,2,"PAH",21,1,5,0)="and specific facility, the RX in the heading is incorrect."
^DIC(9.4,82,22,2,"PAH",21,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",21,1,7,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",21,1,8,0)="==========="
^DIC(9.4,82,22,2,"PAH",21,1,9,0)="The variable PSXDGID is used in NAME^PSXCSUTL (Utility to get drug name"
^DIC(9.4,82,22,2,"PAH",21,1,10,0)="using CMOP ID).  The drug name is correct in the body of the report"
^DIC(9.4,82,22,2,"PAH",21,1,11,0)="because PSXDGID is set before calling NAME^PSXCSUTL.  However, when"
^DIC(9.4,82,22,2,"PAH",21,1,12,0)="printing the drug name in heading of the report, the routine PSXCSMN1 does"
^DIC(9.4,82,22,2,"PAH",21,1,13,0)="not set the variable PSXDGID. This patch will correct the problem by"
^DIC(9.4,82,22,2,"PAH",21,1,14,0)="setting PSXDGID in routine PSXCSMN1."
^DIC(9.4,82,22,2,"PAH",22,0)="25 SEQ #23^3000417^1"
^DIC(9.4,82,22,2,"PAH",22,1,0)="^^9^9^3000417"
^DIC(9.4,82,22,2,"PAH",22,1,1,0)="Problem:"
^DIC(9.4,82,22,2,"PAH",22,1,2,0)=" "
^DIC(9.4,82,22,2,"PAH",22,1,3,0)="The CMOP process is taking very long times to find the next available"
^DIC(9.4,82,22,2,"PAH",22,1,4,0)="vacancy in the file for creating entries."
^DIC(9.4,82,22,2,"PAH",22,1,5,0)=" "
^DIC(9.4,82,22,2,"PAH",22,1,6,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",22,1,7,0)=" "
^DIC(9.4,82,22,2,"PAH",22,1,8,0)="The process has been modified with recent extensions of the M language to"
^DIC(9.4,82,22,2,"PAH",22,1,9,0)="find the next available vacancy in the file with one program call."
^DIC(9.4,82,22,2,"PAH",23,0)="23^3000516^1"
^DIC(9.4,82,22,2,"PAH",23,1,0)="^^69^69^3000516"
^DIC(9.4,82,22,2,"PAH",23,1,1,0)="This patch is part of the CMOP - Controlled Substance Rxs enhancements."
^DIC(9.4,82,22,2,"PAH",23,1,2,0)="It modifies functions within the Consolidated Mail Outpatient Pharmacy"
^DIC(9.4,82,22,2,"PAH",23,1,3,0)="package to support the transmission of controlled substance prescriptions"
^DIC(9.4,82,22,2,"PAH",23,1,4,0)="to the Consolidated Mail Outpatient Pharmacy facilities."
^DIC(9.4,82,22,2,"PAH",23,1,5,0)=" "
^DIC(9.4,82,22,2,"PAH",23,1,6,0)="This patch will be installed in conjunction with three other patches"
^DIC(9.4,82,22,2,"PAH",23,1,7,0)="(PSD*3*21, PSO*7*33, and PSS*1*28). Refer to the CMOP - Controlled"
^DIC(9.4,82,22,2,"PAH",23,1,8,0)="Substance Rxs Installation Guide for installation instructions."
^DIC(9.4,82,22,2,"PAH",23,1,9,0)=" "
^DIC(9.4,82,22,2,"PAH",23,1,10,0)="The Installation Guide for the CMOP - Controlled Substance Rxs project"
^DIC(9.4,82,22,2,"PAH",23,1,11,0)="can be obtained on the VISTA Consolidated Mail Outpatient Pharmacy web"
^DIC(9.4,82,22,2,"PAH",23,1,12,0)="page.  The address is http://vista2.domain.ext/cmop/. The Installation"
^DIC(9.4,82,22,2,"PAH",23,1,13,0)="Guide is also available on the ANONYMOUS.SOFTWARE directory at one of the"
^DIC(9.4,82,22,2,"PAH",23,1,14,0)="following Office of Information (OI) Field Offices. The file name is"
^DIC(9.4,82,22,2,"PAH",23,1,15,0)="CMOPCS_IG.PDF."
^DIC(9.4,82,22,2,"PAH",23,1,16,0)="    "
^DIC(9.4,82,22,2,"PAH",23,1,17,0)="  OI FIELD OFFICE                FTP ADDRESS             DIRECTORY"
^DIC(9.4,82,22,2,"PAH",23,1,18,0)="  ===============                ===========             ========="
^DIC(9.4,82,22,2,"PAH",23,1,19,0)="  Albany                         152.127.1.5          anonymous.software"
^DIC(9.4,82,22,2,"PAH",23,1,20,0)="  Hines                          152.129.1.110        anonymous.software"
^DIC(9.4,82,22,2,"PAH",23,1,21,0)="  Salt Lake City                 152.131.2.1          anonymous.software"
^DIC(9.4,82,22,2,"PAH",23,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",23,1,23,0)="CMOP software modifications:"
^DIC(9.4,82,22,2,"PAH",23,1,24,0)=" "
^DIC(9.4,82,22,2,"PAH",23,1,25,0)="1. The Loop CMOP Match to Local Drug File option [PSXX LOOP MARK] was"
^DIC(9.4,82,22,2,"PAH",23,1,26,0)="   modified to allow drugs identified as schedule III-IV controlled"
^DIC(9.4,82,22,2,"PAH",23,1,27,0)="   substances to be marked for processing by CMOP facilities."
^DIC(9.4,82,22,2,"PAH",23,1,28,0)="2. The CMOP Data from Your Local Drug File report option [PSXX LOCAL"
^DIC(9.4,82,22,2,"PAH",23,1,29,0)="   DATA] was modified to add the reporting of drugs identified as"
^DIC(9.4,82,22,2,"PAH",23,1,30,0)="   schedule III-IV controlled substances that are marked for CMOP."
^DIC(9.4,82,22,2,"PAH",23,1,31,0)="3. The Drugs not Flagged for CMOP Transmission option [PSXX NOCMOP] was"
^DIC(9.4,82,22,2,"PAH",23,1,32,0)="   modified to report drugs identified as schedule III-IV controlled"
^DIC(9.4,82,22,2,"PAH",23,1,33,0)="   substances."
^DIC(9.4,82,22,2,"PAH",23,1,34,0)="4. The CMOP Mark/Unmark (Single drug) option [PSXX MARK] will be"
^DIC(9.4,82,22,2,"PAH",23,1,35,0)="   deleted. This functionality is duplicated in the Pharmacy Data"
^DIC(9.4,82,22,2,"PAH",23,1,36,0)="   Management package."
^DIC(9.4,82,22,2,"PAH",23,1,37,0)="5. The Unreleased Rx's Report option [PSX UNRELEASED] was modified to"
^DIC(9.4,82,22,2,"PAH",23,1,38,0)="   sort by controlled substances, non-controlled substances or both types"
^DIC(9.4,82,22,2,"PAH",23,1,39,0)="   of prescriptions."
^DIC(9.4,82,22,2,"PAH",23,1,40,0)="6. A new option, Setup CMOP CS Auto-transmission [PSXR AUTO TRANSMIT"
^DIC(9.4,82,22,2,"PAH",23,1,41,0)="   CS] was created to manage the automatic transmissions of  controlled"
^DIC(9.4,82,22,2,"PAH",23,1,42,0)="   substances to the CMOP facilities."
^DIC(9.4,82,22,2,"PAH",23,1,43,0)="7. The CMOP manual transmission function, called by the Outpatient"
^DIC(9.4,82,22,2,"PAH",23,1,44,0)="   Pharmacy option Print from Suspense File [PSO PNDLBL] has been modified"
^DIC(9.4,82,22,2,"PAH",23,1,45,0)="   to transmit prescriptions written for drugs identified as schedule"
^DIC(9.4,82,22,2,"PAH",23,1,46,0)="   III-IV controlled substances that are marked for CMOP."
^DIC(9.4,82,22,2,"PAH",23,1,47,0)="8. This patch addresses NOIS CHA-1297-30037. The CMOP software"
^DIC(9.4,82,22,2,"PAH",23,1,48,0)="   currently only allows the medical centers to select the CMOPs that were"
^DIC(9.4,82,22,2,"PAH",23,1,49,0)="   on-line when CMOP V2.0 software was released. Modifications now enable"
^DIC(9.4,82,22,2,"PAH",23,1,50,0)="   the medical centers to select any of the current operating CMOPs."
^DIC(9.4,82,22,2,"PAH",23,1,51,0)="9. This patch addresses NOIS BIR-0299-31299. Current functionality"
^DIC(9.4,82,22,2,"PAH",23,1,52,0)="   could allow two fills of a prescription to be suspended on top of one"
^DIC(9.4,82,22,2,"PAH",23,1,53,0)="   another, which could cause the patient to lose one.  The transmission"
^DIC(9.4,82,22,2,"PAH",23,1,54,0)="   timing has been adjusted to prevent the second fill from being"
^DIC(9.4,82,22,2,"PAH",23,1,55,0)="   suspended until the first has been transmitted."
^DIC(9.4,82,22,2,"PAH",23,1,56,0)="10.This patch addresses NOIS DAY-0499-42275. Under certain circumstances"
^DIC(9.4,82,22,2,"PAH",23,1,57,0)="   the patient profile print device could be left undefined, causing an"
^DIC(9.4,82,22,2,"PAH",23,1,58,0)="   error in the Outpatient Pharmacy software.  Calling a different entry"
^DIC(9.4,82,22,2,"PAH",23,1,59,0)="   point in the Outpatient Pharmacy software allows the user to select a"
^DIC(9.4,82,22,2,"PAH",23,1,60,0)="   device, if desired."
^DIC(9.4,82,22,2,"PAH",23,1,61,0)="11.This patch also addresses NOIS DAY-0899-42676. Test patients with SSN's"
^DIC(9.4,82,22,2,"PAH",23,1,62,0)="   of 000-00-0000 are being sent to the CMOP.  A screen was placed in the"
^DIC(9.4,82,22,2,"PAH",23,1,63,0)="   software to prevent this from occurring."
^DIC(9.4,82,22,2,"PAH",23,1,64,0)="12.A new subfile,the AUTO TRANSMIT CS (#550.09) and eight new fields have"
^DIC(9.4,82,22,2,"PAH",23,1,65,0)="   been added to the CMOP SYSTEM file (#550) to track CMOP controlled"
^DIC(9.4,82,22,2,"PAH",23,1,66,0)="   substances transmissions at the medical centers."
^DIC(9.4,82,22,2,"PAH",23,1,67,0)="13.A new field, CONTROLLED SUBS FLAG (#19), has been added to the CMOP"
^DIC(9.4,82,22,2,"PAH",23,1,68,0)="   MASTER DATABASE file (#552.4) on the host CMOP system to track"
^DIC(9.4,82,22,2,"PAH",23,1,69,0)="   controlled substance prescriptions."
^DIC(9.4,82,22,2,"PAH",24,0)="26 SEQ #25^3000711^1"
^DIC(9.4,82,22,2,"PAH",24,1,0)="^^14^14^3000711"
^DIC(9.4,82,22,2,"PAH",24,1,1,0)="1. Problem: Site number lookup into the INSTITUTION file (#4) is failing"
^DIC(9.4,82,22,2,"PAH",24,1,2,0)="as CMOP is using more than the first three numbers in the element taken"
^DIC(9.4,82,22,2,"PAH",24,1,3,0)="from the INPATIENT SITE file (#59.4)."
^DIC(9.4,82,22,2,"PAH",24,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",24,1,5,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",24,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",24,1,7,0)="The lookup has been recoded to use only the first three numbers."
^DIC(9.4,82,22,2,"PAH",24,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",24,1,9,0)="2. Problem: The user instructions in printing from CMOP suspense are"
^DIC(9.4,82,22,2,"PAH",24,1,10,0)="confusing and misleading."
^DIC(9.4,82,22,2,"PAH",24,1,11,0)=" "
^DIC(9.4,82,22,2,"PAH",24,1,12,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",24,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",24,1,14,0)="The user instructions have been corrected."
^DIC(9.4,82,22,2,"PAH",25,0)="29 SEQ #26^3000717^1"
^DIC(9.4,82,22,2,"PAH",25,1,0)="^^7^7^3000717"
^DIC(9.4,82,22,2,"PAH",25,1,1,0)="Problem: Undefined errors are occurring in the routine PSXBLD when a"
^DIC(9.4,82,22,2,"PAH",25,1,2,0)="refill is deleted in pharmacy while the CMOP transmission is in the"
^DIC(9.4,82,22,2,"PAH",25,1,3,0)="building process."
^DIC(9.4,82,22,2,"PAH",25,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",25,1,5,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",25,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",25,1,7,0)="The CMOP coding has been changed to guard against the undefined error."
^DIC(9.4,82,22,2,"PAH",26,0)="27 SEQ #27^3000816^1"
^DIC(9.4,82,22,2,"PAH",26,1,0)="^^25^25^3000816"
^DIC(9.4,82,22,2,"PAH",26,1,1,0)="1. Problem: The release of XM*7.1*50 has changed the API calls other"
^DIC(9.4,82,22,2,"PAH",26,1,2,0)="packages are to use in evoking Mailman functions. The CMOP package is not"
^DIC(9.4,82,22,2,"PAH",26,1,3,0)="using these calls in sending messages to servers."
^DIC(9.4,82,22,2,"PAH",26,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,5,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",26,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,7,0)="The CMOP coding of XM calls has been changed to be within the prescribed"
^DIC(9.4,82,22,2,"PAH",26,1,8,0)="APIs published for servers."
^DIC(9.4,82,22,2,"PAH",26,1,9,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,10,0)="2. Problem: The messages from the CMOP software to the users and managers"
^DIC(9.4,82,22,2,"PAH",26,1,11,0)="had been marked 'informational only' preventing them from easily"
^DIC(9.4,82,22,2,"PAH",26,1,12,0)="corresponding with other staff members on how to resolve problems being"
^DIC(9.4,82,22,2,"PAH",26,1,13,0)="reported."
^DIC(9.4,82,22,2,"PAH",26,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,15,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",26,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,17,0)="The 'informational only' tag has been removed from all user messages."
^DIC(9.4,82,22,2,"PAH",26,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,19,0)="3. Problem: A variable was not defined in some PSX calls to the line"
^DIC(9.4,82,22,2,"PAH",26,1,20,0)="tag MM^PSXVND."
^DIC(9.4,82,22,2,"PAH",26,1,21,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,22,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",26,1,23,0)=" "
^DIC(9.4,82,22,2,"PAH",26,1,24,0)="The appropriate variable is now set within the code located in the"
^DIC(9.4,82,22,2,"PAH",26,1,25,0)="subroutine MM^PSXVND."
^DIC(9.4,82,22,2,"PAH",27,0)="31 SEQ #28^3011121^1"
^DIC(9.4,82,22,2,"PAH",27,1,0)="^^22^22^3011121"
^DIC(9.4,82,22,2,"PAH",27,1,1,0)="1. E3R 9128 requests that all CMOP reports provide the ability to select"
^DIC(9.4,82,22,2,"PAH",27,1,2,0)="one, more, or all divisions and display the report details by divisions."
^DIC(9.4,82,22,2,"PAH",27,1,3,0)=" "
^DIC(9.4,82,22,2,"PAH",27,1,4,0)="Resolution: The reports have been modified. They are:"
^DIC(9.4,82,22,2,"PAH",27,1,5,0)=" "
^DIC(9.4,82,22,2,"PAH",27,1,6,0)="Count of CMOP Suspended Rx's [PSXR SUSPENSE COUNT]"
^DIC(9.4,82,22,2,"PAH",27,1,7,0)="Medical Center Activity Report [PSXR ACTIVITY]"
^DIC(9.4,82,22,2,"PAH",27,1,8,0)="Rx Workload Report [PSXR RX WORKLOAD REPORT]"
^DIC(9.4,82,22,2,"PAH",27,1,9,0)=" "
^DIC(9.4,82,22,2,"PAH",27,1,10,0)="2. E3R 9434 requests that several new columns be added to the Rx Workload"
^DIC(9.4,82,22,2,"PAH",27,1,11,0)="Report. Those columns are to be under the categories of 'Entered Window'"
^DIC(9.4,82,22,2,"PAH",27,1,12,0)="and 'Released Window' and are to reflect prescriptions that are refilled"
^DIC(9.4,82,22,2,"PAH",27,1,13,0)="or original renewals."
^DIC(9.4,82,22,2,"PAH",27,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",27,1,15,0)="Resolution: The Rx Workload Report [PSXR RX WORKLOAD REPORT] option has"
^DIC(9.4,82,22,2,"PAH",27,1,16,0)="been modified."
^DIC(9.4,82,22,2,"PAH",27,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",27,1,18,0)="3. Problem: The ""Transmitted By"" on the CMOP TRANSMISSION CONFIRMATION"
^DIC(9.4,82,22,2,"PAH",27,1,19,0)="report is blank."
^DIC(9.4,82,22,2,"PAH",27,1,20,0)=" "
^DIC(9.4,82,22,2,"PAH",27,1,21,0)="Resolution: The software has been corrected and the ""Transmitted By"" on"
^DIC(9.4,82,22,2,"PAH",27,1,22,0)="the CMOP TRANSMISSION CONFIRMATION report is populated in the message."
^DIC(9.4,82,22,2,"PAH",28,0)="35 SEQ #29^3011121^1"
^DIC(9.4,82,22,2,"PAH",28,1,0)="^^82^82^3011121"
^DIC(9.4,82,22,2,"PAH",28,1,1,0)="1. Problem:  The CMOP software shall be modified to no longer check the Rx"
^DIC(9.4,82,22,2,"PAH",28,1,2,0)="copay status of a prescription during the release process. The Rx copay"
^DIC(9.4,82,22,2,"PAH",28,1,3,0)="status shall be re-evaluated by the Outpatient Pharmacy application with"
^DIC(9.4,82,22,2,"PAH",28,1,4,0)="each fill/refill.  "
^DIC(9.4,82,22,2,"PAH",28,1,5,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,6,0)="Resolution:  Routine PSXVND was modified to call routine PSOCP without"
^DIC(9.4,82,22,2,"PAH",28,1,7,0)="qualification, in support of the Outpatient Pharmacy Copay enhancement"
^DIC(9.4,82,22,2,"PAH",28,1,8,0)="project."
^DIC(9.4,82,22,2,"PAH",28,1,9,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,10,0)="E3R 13012:   There are many ""CMOP REMOTE ERROR CONDITION NOTICE"""
^DIC(9.4,82,22,2,"PAH",28,1,11,0)="messages generated and sent. It is requested that the message have the"
^DIC(9.4,82,22,2,"PAH",28,1,12,0)="site number added as a prefix to each message generated."
^DIC(9.4,82,22,2,"PAH",28,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,14,0)="Resolution: The coding has been modified such that the site number has"
^DIC(9.4,82,22,2,"PAH",28,1,15,0)="been added as a prefix to the messages."
^DIC(9.4,82,22,2,"PAH",28,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,17,0)="Note:  Routine PSXCOPAY will be deleted from the system.  This routine is"
^DIC(9.4,82,22,2,"PAH",28,1,18,0)="not being used."
^DIC(9.4,82,22,2,"PAH",28,1,19,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,20,0)="Associated NOIS:"
^DIC(9.4,82,22,2,"PAH",28,1,21,0)="================ "
^DIC(9.4,82,22,2,"PAH",28,1,22,0)="N/A"
^DIC(9.4,82,22,2,"PAH",28,1,23,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,24,0)="Test Sites:"
^DIC(9.4,82,22,2,"PAH",28,1,25,0)="=========== "
^DIC(9.4,82,22,2,"PAH",28,1,26,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,27,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,28,0)="Routine Summary:"
^DIC(9.4,82,22,2,"PAH",28,1,29,0)="================ "
^DIC(9.4,82,22,2,"PAH",28,1,30,0)="The following is a list of the routines included in this patch."
^DIC(9.4,82,22,2,"PAH",28,1,31,0)="The second line of each of these routines now looks like:"
^DIC(9.4,82,22,2,"PAH",28,1,32,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,33,0)="<tab>;;2.0;CMOP;**[patch list]**;11 Apr 97"
^DIC(9.4,82,22,2,"PAH",28,1,34,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,35,0)="               CHECK^XTSUMBLD results"
^DIC(9.4,82,22,2,"PAH",28,1,36,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,37,0)="Routine Name   Before Patch     After Patch     Patch List"
^DIC(9.4,82,22,2,"PAH",28,1,38,0)="------------   ------------     -----------     ----------"
^DIC(9.4,82,22,2,"PAH",28,1,39,0)="PSXVND         15932593         16276949        1,2,4,5,14,18,19"
^DIC(9.4,82,22,2,"PAH",28,1,40,0)="                                                15,24,23,27,35"
^DIC(9.4,82,22,2,"PAH",28,1,41,0)="PSXVEND        16202580         16667384        23,27,35"
^DIC(9.4,82,22,2,"PAH",28,1,42,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,43,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,44,0)="Installation Instructions:"
^DIC(9.4,82,22,2,"PAH",28,1,45,0)="========================== "
^DIC(9.4,82,22,2,"PAH",28,1,46,0)="  This patch can be installed with users on the system. Installation will"
^DIC(9.4,82,22,2,"PAH",28,1,47,0)="  take less than 1 minute. There are no scheduling restrictions or"
^DIC(9.4,82,22,2,"PAH",28,1,48,0)="  recommendations."
^DIC(9.4,82,22,2,"PAH",28,1,49,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,50,0)="  1.   Use the INSTALL/CHECK MESSAGE option on the PackMan menu."
^DIC(9.4,82,22,2,"PAH",28,1,51,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,52,0)="  2.   Review your mapped set. If the routines are mapped, they should"
^DIC(9.4,82,22,2,"PAH",28,1,53,0)="       be removed from the mapped set at this time. Currently there are no"
^DIC(9.4,82,22,2,"PAH",28,1,54,0)="       routines that are recommended by the package to be placed into the"
^DIC(9.4,82,22,2,"PAH",28,1,55,0)="       mapped set."
^DIC(9.4,82,22,2,"PAH",28,1,56,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,57,0)="  3.   From the Kernel Installation & Distribution System menu, select"
^DIC(9.4,82,22,2,"PAH",28,1,58,0)="       the Installation menu."
^DIC(9.4,82,22,2,"PAH",28,1,59,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,60,0)="  4.   From this menu, you may select to use the following options"
^DIC(9.4,82,22,2,"PAH",28,1,61,0)="       (when prompted for INSTALL NAME, enter PSX*2.0*35):"
^DIC(9.4,82,22,2,"PAH",28,1,62,0)="    a. Backup a Transport Global - this option will create a backup"
^DIC(9.4,82,22,2,"PAH",28,1,63,0)="       message of any routines exported with the patch. It will NOT"
^DIC(9.4,82,22,2,"PAH",28,1,64,0)="       backup any other changes such as DDs or templates."
^DIC(9.4,82,22,2,"PAH",28,1,65,0)="    b. Compare Transport Global to Current System - this option will"
^DIC(9.4,82,22,2,"PAH",28,1,66,0)="       allow you to view all changes that will be made when the patch"
^DIC(9.4,82,22,2,"PAH",28,1,67,0)="       is installed. It compares all components of the patch (routines,"
^DIC(9.4,82,22,2,"PAH",28,1,68,0)="       DDs, templates, etc.)."
^DIC(9.4,82,22,2,"PAH",28,1,69,0)="    c. Verify Checksums in Transport Global - this option will ensure"
^DIC(9.4,82,22,2,"PAH",28,1,70,0)="       the integrity of the routines that are in the transport global."
^DIC(9.4,82,22,2,"PAH",28,1,71,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,72,0)="  5. Use the Install Package(s) option and select the package PSX*2.0*35."
^DIC(9.4,82,22,2,"PAH",28,1,73,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,74,0)="  6. When prompted ""Want KIDS to INHIBIT LOGONs during the install? YES//"""
^DIC(9.4,82,22,2,"PAH",28,1,75,0)="     respond NO."
^DIC(9.4,82,22,2,"PAH",28,1,76,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,77,0)="  7. When prompted ""Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,82,22,2,"PAH",28,1,78,0)="     Protocols? YES//"" respond NO."
^DIC(9.4,82,22,2,"PAH",28,1,79,0)=" "
^DIC(9.4,82,22,2,"PAH",28,1,80,0)="  8. If any routines were unmapped as part of step 2, they should be"
^DIC(9.4,82,22,2,"PAH",28,1,81,0)="     returned to the mapped set once the installation has run to"
^DIC(9.4,82,22,2,"PAH",28,1,82,0)="     completion."
^DIC(9.4,82,22,2,"PAH",29,0)="39 SEQ #30^3020204^1"
^DIC(9.4,82,22,2,"PAH",29,1,0)="^^19^19^3020204"
^DIC(9.4,82,22,2,"PAH",29,1,1,0)="This is an EMERGENCY patch and must be installed within 24 hours."
^DIC(9.4,82,22,2,"PAH",29,1,2,0)=" "
^DIC(9.4,82,22,2,"PAH",29,1,3,0)="1. Problem: The release of the Consolidated Mail Outpatient Pharmacy"
^DIC(9.4,82,22,2,"PAH",29,1,4,0)="(CMOP) patch PSX*2*35 introduced a potential problem for Outpatient"
^DIC(9.4,82,22,2,"PAH",29,1,5,0)="Pharmacy divisions where the ""BARCODES ON ACTION PROFILES"" prompt, on the"
^DIC(9.4,82,22,2,"PAH",29,1,6,0)="Site Parameter Enter/Edit [PSO SITE PARAMETERS] option, is set to ""NO""."
^DIC(9.4,82,22,2,"PAH",29,1,7,0)="Because of this problem, there was no Co-pay charge for any CMOP"
^DIC(9.4,82,22,2,"PAH",29,1,8,0)="prescription released after the installation of PSX*2*35.  This patch"
^DIC(9.4,82,22,2,"PAH",29,1,9,0)="corrects the problem.  A patch to Outpatient Pharmacy V.7.0, PSO*7*93,"
^DIC(9.4,82,22,2,"PAH",29,1,10,0)="will be released to correct existing prescriptions so that they are billed"
^DIC(9.4,82,22,2,"PAH",29,1,11,0)="correctly."
^DIC(9.4,82,22,2,"PAH",29,1,12,0)=" "
^DIC(9.4,82,22,2,"PAH",29,1,13,0)="Resolution:  The code has been modified to correct this problem."
^DIC(9.4,82,22,2,"PAH",29,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",29,1,15,0)="2. Problem: Error reported when division was missing from the "
^DIC(9.4,82,22,2,"PAH",29,1,16,0)="prescription file for a Consolidated Mail Outpatient Pharmacy (CMOP) "
^DIC(9.4,82,22,2,"PAH",29,1,17,0)="prescription."
^DIC(9.4,82,22,2,"PAH",29,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",29,1,19,0)="Resolution:  The code has been modified to find the first active division."
^DIC(9.4,82,22,2,"PAH",30,0)="33 SEQ #31^3020226^1"
^DIC(9.4,82,22,2,"PAH",30,1,0)="^^28^28^3020226"
^DIC(9.4,82,22,2,"PAH",30,1,1,0)="1.  Problem:  NOIS CMC-1101-31545 describes a situation where two "
^DIC(9.4,82,22,2,"PAH",30,1,2,0)="patient's prescription data gets merged within a Consolidated Mail "
^DIC(9.4,82,22,2,"PAH",30,1,3,0)="Outpatient Pharmacy (CMOP) transmission.  In this particular case, the "
^DIC(9.4,82,22,2,"PAH",30,1,4,0)="prescription data was from a single pharmacy division.  While building "
^DIC(9.4,82,22,2,"PAH",30,1,5,0)="the transmission, the prescription data from one patient was overwritten "
^DIC(9.4,82,22,2,"PAH",30,1,6,0)="with the data of another, but imperfectly, leaving remnants of the first "
^DIC(9.4,82,22,2,"PAH",30,1,7,0)="as if appended to end of the data sequence.  This instance posed no "
^DIC(9.4,82,22,2,"PAH",30,1,8,0)="threat to patient safety as the data stream was corrupted and caused the "
^DIC(9.4,82,22,2,"PAH",30,1,9,0)="download to terminate.  However, there is the slight possibility that a "
^DIC(9.4,82,22,2,"PAH",30,1,10,0)="""perfect"" merge could occur, sending the wrong medication to a patient. "
^DIC(9.4,82,22,2,"PAH",30,1,11,0)="Analysis of this problem revealed that two patient orders were assigned "
^DIC(9.4,82,22,2,"PAH",30,1,12,0)="the same record number in the file that allowed overwriting of data to "
^DIC(9.4,82,22,2,"PAH",30,1,13,0)="occur."
^DIC(9.4,82,22,2,"PAH",30,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",30,1,15,0)="Resolution:  Safeguards have been put in place to prevent the same record "
^DIC(9.4,82,22,2,"PAH",30,1,16,0)="number from being used by two distinct patient orders."
^DIC(9.4,82,22,2,"PAH",30,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",30,1,18,0)="1. Problem:  When prescriptions are transmitted to CMOP, an update is sent"
^DIC(9.4,82,22,2,"PAH",30,1,19,0)="to the Computerized Patient Record System ( CPRS) that says the"
^DIC(9.4,82,22,2,"PAH",30,1,20,0)="prescription is no longer suspended, and now has an Active Status.  The"
^DIC(9.4,82,22,2,"PAH",30,1,21,0)="problem occurred because the wrong number was being sent to CPRS, and this"
^DIC(9.4,82,22,2,"PAH",30,1,22,0)="caused the CPRS status of an Outpatient order to become active, when is"
^DIC(9.4,82,22,2,"PAH",30,1,23,0)="shouldn't.  No Pharmacy statuses were set improperly, only these CPRS"
^DIC(9.4,82,22,2,"PAH",30,1,24,0)="statuses, which would show on the Orders Tab."
^DIC(9.4,82,22,2,"PAH",30,1,25,0)=" "
^DIC(9.4,82,22,2,"PAH",30,1,26,0)="Resolution:  The CMOP code was passing the internal entry number of the "
^DIC(9.4,82,22,2,"PAH",30,1,27,0)="wrong file to CPRS.  The offending variable has been replaced by the "
^DIC(9.4,82,22,2,"PAH",30,1,28,0)="variable housing the correct value."
^DIC(9.4,82,22,2,"PAH",31,0)="28 SEQ #32^3020226^1"
^DIC(9.4,82,22,2,"PAH",31,1,0)="^^106^106^3020226"
^DIC(9.4,82,22,2,"PAH",31,1,1,0)="1) Problem:  Attempting to use the Print from Suspense File [PSO PNDLBL]"
^DIC(9.4,82,22,2,"PAH",31,1,2,0)="option to send transmissions to Consolidated Mail Outpatient Pharmacy "
^DIC(9.4,82,22,2,"PAH",31,1,3,0)="(CMOP) hosts often resulted in an undefined error."
^DIC(9.4,82,22,2,"PAH",31,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,5,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,7,0)="Code modifications have been made to prevent the error."
^DIC(9.4,82,22,2,"PAH",31,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,9,0)="2) Problem:  The CMOP host Unreleased Rx's Report [PSX UNRELEASED] option"
^DIC(9.4,82,22,2,"PAH",31,1,10,0)="was not reporting the correct figures in certain instances."
^DIC(9.4,82,22,2,"PAH",31,1,11,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,12,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,14,0)="The software has been modified to correct these errors."
^DIC(9.4,82,22,2,"PAH",31,1,15,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,16,0)="3) Problem:  The use of the PSX resource device has long been a source of"
^DIC(9.4,82,22,2,"PAH",31,1,17,0)="difficulty for the CMOP data transmission process. Anything from system"
^DIC(9.4,82,22,2,"PAH",31,1,18,0)="failures to users entering the wrong parameters in the file could result"
^DIC(9.4,82,22,2,"PAH",31,1,19,0)="in two CMOP transmission jobs running at the same time. More often than"
^DIC(9.4,82,22,2,"PAH",31,1,20,0)="not, this resulted in data merges between the simultaneously running"
^DIC(9.4,82,22,2,"PAH",31,1,21,0)="jobs."
^DIC(9.4,82,22,2,"PAH",31,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,23,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,24,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,25,0)="To prevent this, a new method of ensuring that only one CMOP transmission"
^DIC(9.4,82,22,2,"PAH",31,1,26,0)="job runs at a time has been developed. A data switch is set when a CMOP"
^DIC(9.4,82,22,2,"PAH",31,1,27,0)="transmission is started. No subsequent transmissions are allowed until"
^DIC(9.4,82,22,2,"PAH",31,1,28,0)="this switch is cleared. Also, transmission jobs waiting to run"
^DIC(9.4,82,22,2,"PAH",31,1,29,0)="periodically check the progress of the running job.  If the running job"
^DIC(9.4,82,22,2,"PAH",31,1,30,0)="exceeds allowable time limits, the jobs waiting are stopped and a message"
^DIC(9.4,82,22,2,"PAH",31,1,31,0)="is sent to the users.  If the time limit was exceeded due to system"
^DIC(9.4,82,22,2,"PAH",31,1,32,0)="problems and the original job finished normally, albeit very slowly, then"
^DIC(9.4,82,22,2,"PAH",31,1,33,0)="the user simply restarts the transmissions manually.  If the time limit"
^DIC(9.4,82,22,2,"PAH",31,1,34,0)="was exceeded due to job failure, the troubleshooting process is not"
^DIC(9.4,82,22,2,"PAH",31,1,35,0)="complicated by multiple transmission jobs. Because the waiting jobs were"
^DIC(9.4,82,22,2,"PAH",31,1,36,0)="stopped, the chance of merging data is reduced considerably. Finally, the"
^DIC(9.4,82,22,2,"PAH",31,1,37,0)="automatic CMOP recovery process has been modified to reset the data switch"
^DIC(9.4,82,22,2,"PAH",31,1,38,0)="if a software repair of the problem is possible."
^DIC(9.4,82,22,2,"PAH",31,1,39,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,40,0)="4) Problem:  There are several CMOP processes that may be running"
^DIC(9.4,82,22,2,"PAH",31,1,41,0)="concurrently and trying to access the same files at the same time causing"
^DIC(9.4,82,22,2,"PAH",31,1,42,0)="one job or the other to error."
^DIC(9.4,82,22,2,"PAH",31,1,43,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,44,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,45,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,46,0)="The locking of files has been moved to the record level letting each job"
^DIC(9.4,82,22,2,"PAH",31,1,47,0)="perform its tasks."
^DIC(9.4,82,22,2,"PAH",31,1,48,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,49,0)="5) E3R 12510:  There have been occurrences where control"
^DIC(9.4,82,22,2,"PAH",31,1,50,0)="characters have been picked up in the patients address information and"
^DIC(9.4,82,22,2,"PAH",31,1,51,0)="sent to the host sites breaking their import procedure."
^DIC(9.4,82,22,2,"PAH",31,1,52,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,53,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,54,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,55,0)="The software has been modified to test and remove unwanted characters"
^DIC(9.4,82,22,2,"PAH",31,1,56,0)="from the patients address information."
^DIC(9.4,82,22,2,"PAH",31,1,57,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,58,0)="6) Problem:  Control characters are being observed within the"
^DIC(9.4,82,22,2,"PAH",31,1,59,0)="prescriptions' SIGs. These and HL7 delimiter characters ""|~^\"" in the SIG "
^DIC(9.4,82,22,2,"PAH",31,1,60,0)="|"
^DIC(9.4,82,22,2,"PAH",31,1,61,0)="break or scramble the communication to the vendors dispensing"
^DIC(9.4,82,22,2,"PAH",31,1,62,0)="prescriptions."
^DIC(9.4,82,22,2,"PAH",31,1,63,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,64,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,65,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,66,0)="The code has been modified to test for control characters and the HL7"
^DIC(9.4,82,22,2,"PAH",31,1,67,0)="delimiter characters ""|~^\"". If found an error message is generated and |"
^DIC(9.4,82,22,2,"PAH",31,1,68,0)="sent referring to the prescription, the refill number, and that the SIG"
^DIC(9.4,82,22,2,"PAH",31,1,69,0)="is either invalid or missing. This safeguards the vendor transmission"
^DIC(9.4,82,22,2,"PAH",31,1,70,0)="process but does not resolve the issue of control characters getting"
^DIC(9.4,82,22,2,"PAH",31,1,71,0)="placed into the SIG."
^DIC(9.4,82,22,2,"PAH",31,1,72,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,73,0)="7) E3R 11958:  The Print from Suspense File [PSO PNDLBL] option transmits"
^DIC(9.4,82,22,2,"PAH",31,1,74,0)="one division at a time. It is desired to have the option work transmit all"
^DIC(9.4,82,22,2,"PAH",31,1,75,0)="divisions if desired."
^DIC(9.4,82,22,2,"PAH",31,1,76,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,77,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",31,1,78,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,79,0)="The software has been modified to provide the ability to process all"
^DIC(9.4,82,22,2,"PAH",31,1,80,0)="divisions. The process has also been modified to present two levels of"
^DIC(9.4,82,22,2,"PAH",31,1,81,0)="questions."
^DIC(9.4,82,22,2,"PAH",31,1,82,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,83,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,84,0)="Select Suspense Functions Option: PR<cr>int from Suspense File"
^DIC(9.4,82,22,2,"PAH",31,1,85,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,86,0)="  1 - Initiate Standard CMOP Transmission"
^DIC(9.4,82,22,2,"PAH",31,1,87,0)="  2 - Initiate CS CMOP Transmission"
^DIC(9.4,82,22,2,"PAH",31,1,88,0)="  3 - Print Current Division -  Standard CMOP from Suspense"
^DIC(9.4,82,22,2,"PAH",31,1,89,0)="  4 - Print Current Division -  CS CMOP from Suspense"
^DIC(9.4,82,22,2,"PAH",31,1,90,0)="  5 - Standard Print from Suspense"
^DIC(9.4,82,22,2,"PAH",31,1,91,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,92,0)="Select (1, 2, 3, 4, 5):  1"
^DIC(9.4,82,22,2,"PAH",31,1,93,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,94,0)="  1 - Initiate Standard CMOP Transmission"
^DIC(9.4,82,22,2,"PAH",31,1,95,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,96,0)="Transmit Data for All Divisions ? ? YES// ?"
^DIC(9.4,82,22,2,"PAH",31,1,97,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,98,0)="Yes - Transmit/Print All Divisions"
^DIC(9.4,82,22,2,"PAH",31,1,99,0)="No  - Transmit/Print One Division:  CHEYENNE VAM&ROC"
^DIC(9.4,82,22,2,"PAH",31,1,100,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,101,0)="Transmit Data for All Divisions ? ? YES//"
^DIC(9.4,82,22,2,"PAH",31,1,102,0)=" "
^DIC(9.4,82,22,2,"PAH",31,1,103,0)="Job queued:       CHEYENNE VAM&ROC"
^DIC(9.4,82,22,2,"PAH",31,1,104,0)="Job queued:       FORT COLLINS CLINIC"
^DIC(9.4,82,22,2,"PAH",31,1,105,0)="Job queued:       GREELEY CLINIC"
^DIC(9.4,82,22,2,"PAH",31,1,106,0)="Job queued:       SIDNEY CLINIC"
^DIC(9.4,82,22,2,"PAH",32,0)="36 SEQ #33^3020408^1"
^DIC(9.4,82,22,2,"PAH",32,1,0)="^^12^12^3020408"
^DIC(9.4,82,22,2,"PAH",32,1,1,0)="1. Problem:  If an inactive pharmacy division is discovered during a"
^DIC(9.4,82,22,2,"PAH",32,1,2,0)="Consolidated Mail Outpatient Pharmacy (CMOP) data transmission, the "
^DIC(9.4,82,22,2,"PAH",32,1,3,0)="following error message is generated: ""Invalid or Missing Data"".     "
^DIC(9.4,82,22,2,"PAH",32,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",32,1,5,0)="Resolution:  Routines PSXAUTO and PSXAUTOC have been modified to evaluate "
^DIC(9.4,82,22,2,"PAH",32,1,6,0)="the inactive date field during processing for the transmission."
^DIC(9.4,82,22,2,"PAH",32,1,7,0)=" "
^DIC(9.4,82,22,2,"PAH",32,1,8,0)="2. Problem:  An error is encountered when CMOP fulfillment data is"
^DIC(9.4,82,22,2,"PAH",32,1,9,0)="received back from the host to the medical center."
^DIC(9.4,82,22,2,"PAH",32,1,10,0)="NOIS DAY-0102-42990"
^DIC(9.4,82,22,2,"PAH",32,1,11,0)=" "
^DIC(9.4,82,22,2,"PAH",32,1,12,0)="Resolution:  Routine PSXVND has been modified to correct this error."
^DIC(9.4,82,22,2,"PAH",33,0)="30 SEQ #34^3020528^1"
^DIC(9.4,82,22,2,"PAH",33,1,0)="^^60^60^3020528"
^DIC(9.4,82,22,2,"PAH",33,1,1,0)="1.      Problem: The patient prescriptions that have been suspended for "
^DIC(9.4,82,22,2,"PAH",33,1,2,0)="Consolidated Mail Outpatient Pharmacy (CMOP) are transmitted to the CMOP "
^DIC(9.4,82,22,2,"PAH",33,1,3,0)="host even if the patient's mail status has been changed to ""DO NOT MAIL""."
^DIC(9.4,82,22,2,"PAH",33,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,5,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",33,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,7,0)="The CMOP functionality has been changed to test the mailing status of "
^DIC(9.4,82,22,2,"PAH",33,1,8,0)="patients during the building of a transmission. If it has changed, the "
^DIC(9.4,82,22,2,"PAH",33,1,9,0)="prescriptions for that patient are not sent and appropriate entries are "
^DIC(9.4,82,22,2,"PAH",33,1,10,0)="added to the MailMan message ""CMOP Error Encountered"", which is sent to "
^DIC(9.4,82,22,2,"PAH",33,1,11,0)="the holders of the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",33,1,12,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,13,0)="2.      Problem: CMOP data validation does test and reject prescriptions "
^DIC(9.4,82,22,2,"PAH",33,1,14,0)="whose drug's warning is greater than eleven characters. However, no "
^DIC(9.4,82,22,2,"PAH",33,1,15,0)="message is sent to inform the users and the users resubmit the "
^DIC(9.4,82,22,2,"PAH",33,1,16,0)="prescriptions to have them again rejected without knowing why."
^DIC(9.4,82,22,2,"PAH",33,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,18,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",33,1,19,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,20,0)="The CMOP data validation has been modified to set an appropriate entry in "
^DIC(9.4,82,22,2,"PAH",33,1,21,0)="the MailMan message ""CMOP Error Encountered"", which is sent to the "
^DIC(9.4,82,22,2,"PAH",33,1,22,0)="holders of the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",33,1,23,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,24,0)="3.      Problem: Transmissions do not test to see if a patient is in the "
^DIC(9.4,82,22,2,"PAH",33,1,25,0)="process of being merged. "
^DIC(9.4,82,22,2,"PAH",33,1,26,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,27,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",33,1,28,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,29,0)="The transmission process code has been modified to test if the patient is "
^DIC(9.4,82,22,2,"PAH",33,1,30,0)="being merged. If a patient is being merged, the prescription remains in "
^DIC(9.4,82,22,2,"PAH",33,1,31,0)="suspense and an error entry is added to the MailMan message ""CMOP Error "
^DIC(9.4,82,22,2,"PAH",33,1,32,0)="Encountered"", which is sent to the holders of the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",33,1,33,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,34,0)="4.      E3R 12951: The patient name and ID are requested to be added to "
^DIC(9.4,82,22,2,"PAH",33,1,35,0)="the MailMan message ""CMOP Error Encountered"" generated where data needs "
^DIC(9.4,82,22,2,"PAH",33,1,36,0)="to be corrected so prescriptions can be more easily corrected and then "
^DIC(9.4,82,22,2,"PAH",33,1,37,0)="sent to the CMOP host."
^DIC(9.4,82,22,2,"PAH",33,1,38,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,39,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",33,1,40,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,41,0)="The appropriate transmission error entries now include patient name & ID."
^DIC(9.4,82,22,2,"PAH",33,1,42,0)="The MailMan message ""CMOP Error Encountered"" is sent to the holders of "
^DIC(9.4,82,22,2,"PAH",33,1,43,0)="the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",33,1,44,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,45,0)="5. E3R 11711: CMOP works in a divisional manner generating many messages. "
^DIC(9.4,82,22,2,"PAH",33,1,46,0)="It is requested that the subjects of the messages have a prefix of "
^DIC(9.4,82,22,2,"PAH",33,1,47,0)="division number added so that the users can easily see which messages are "
^DIC(9.4,82,22,2,"PAH",33,1,48,0)="for their specific division."
^DIC(9.4,82,22,2,"PAH",33,1,49,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,50,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",33,1,51,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,52,0)="High volume messages' subjects have been recoded to include a division "
^DIC(9.4,82,22,2,"PAH",33,1,53,0)="number as a prefix. The following MailMan message subjects have been "
^DIC(9.4,82,22,2,"PAH",33,1,54,0)="amended:"
^DIC(9.4,82,22,2,"PAH",33,1,55,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,56,0)="""CMOP Error Encountered"" which is sent to holders of the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",33,1,57,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,58,0)="""CMOP Not Dispensed Rx List"" which is sent to holders of the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",33,1,59,0)=" "
^DIC(9.4,82,22,2,"PAH",33,1,60,0)="""CMOP Acknowledgement not Received"" sent to holders of the ""PSXCMOPMGR"" key."
^DIC(9.4,82,22,2,"PAH",34,0)="32 SEQ #35^3020626^1"
^DIC(9.4,82,22,2,"PAH",34,1,0)="^^52^52^3020626"
^DIC(9.4,82,22,2,"PAH",34,1,1,0)="NOTE: Facilities will see the expected following error message as the "
^DIC(9.4,82,22,2,"PAH",34,1,2,0)="software will be installing a data field for the Consolidated Mail "
^DIC(9.4,82,22,2,"PAH",34,1,3,0)="Outpatient Pharmacy (CMOP) hosts in a file the facilities do not have."
^DIC(9.4,82,22,2,"PAH",34,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,5,0)="Installing Data Dictionaries:"
^DIC(9.4,82,22,2,"PAH",34,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,7,0)="** ERROR IN DATA DICTIONARY FOR FILE # 554 **"
^DIC(9.4,82,22,2,"PAH",34,1,8,0)="Data Dictionary not installed; Partial DD/File does not exist.    "
^DIC(9.4,82,22,2,"PAH",34,1,9,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,11,0)="1. E3R 9441: It is requested that the Facility Activity Report [PSX "
^DIC(9.4,82,22,2,"PAH",34,1,12,0)="ACTIVITY] option should allow time to be entered as part of the criteria "
^DIC(9.4,82,22,2,"PAH",34,1,13,0)="for setting the date range of the report."
^DIC(9.4,82,22,2,"PAH",34,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,15,0)="Resolution: The report has been modified to sort by Date/Time vs. just "
^DIC(9.4,82,22,2,"PAH",34,1,16,0)="Date."
^DIC(9.4,82,22,2,"PAH",34,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,18,0)="2. Problem: The vendor software is to send package ID and carrier "
^DIC(9.4,82,22,2,"PAH",34,1,19,0)="information for each prescription that is completed. When that segment of "
^DIC(9.4,82,22,2,"PAH",34,1,20,0)="information is missing, the software trying to process the missing "
^DIC(9.4,82,22,2,"PAH",34,1,21,0)="information generates an error."
^DIC(9.4,82,22,2,"PAH",34,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,23,0)="Resolution: The code has been modified to accommodate instances of "
^DIC(9.4,82,22,2,"PAH",34,1,24,0)="missing information."
^DIC(9.4,82,22,2,"PAH",34,1,25,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,26,0)="3. E3R 9881: It is requested that a CMOP host site parameter be added to "
^DIC(9.4,82,22,2,"PAH",34,1,27,0)="control whether or not the report ""CMOP DRUG Cost Missing"" as processing "
^DIC(9.4,82,22,2,"PAH",34,1,28,0)="of vendor data is performed."
^DIC(9.4,82,22,2,"PAH",34,1,29,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,30,0)="Resolution: The software has been modified and a new field CMOP DRUG Cost "
^DIC(9.4,82,22,2,"PAH",34,1,31,0)="Missing Reports (#8) has been added to CMOP OPERATIONS file (#554) to "
^DIC(9.4,82,22,2,"PAH",34,1,32,0)="control the generation of the report ""CMOP DRUG Cost Missing""  "
^DIC(9.4,82,22,2,"PAH",34,1,33,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,34,0)="The editing of the parameter has been added to the CMOP host System "
^DIC(9.4,82,22,2,"PAH",34,1,35,0)="Parameter Enter/Edit [PSX SITE PARAMETERS] option."
^DIC(9.4,82,22,2,"PAH",34,1,36,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,37,0)="This is the new text found within the existing option."
^DIC(9.4,82,22,2,"PAH",34,1,38,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,39,0)="CMOP DRUG Cost Missing reports: YES// ??"
^DIC(9.4,82,22,2,"PAH",34,1,40,0)="        This parameter controls the generation of the ""CMOP DRUG Cost "
^DIC(9.4,82,22,2,"PAH",34,1,41,0)="Missing"" report."
^DIC(9.4,82,22,2,"PAH",34,1,42,0)=" "
^DIC(9.4,82,22,2,"PAH",34,1,43,0)="     Choose from:"
^DIC(9.4,82,22,2,"PAH",34,1,44,0)="       Y        YES"
^DIC(9.4,82,22,2,"PAH",34,1,45,0)="       N        NO"
^DIC(9.4,82,22,2,"PAH",34,1,46,0)="CMOP DRUG Cost Missing reports: YES// ?"
^DIC(9.4,82,22,2,"PAH",34,1,47,0)="     Do you want the ""CMOP DRUG Cost Missing"" error report generated? "
^DIC(9.4,82,22,2,"PAH",34,1,48,0)="(Y/N)"
^DIC(9.4,82,22,2,"PAH",34,1,49,0)="     Choose from:"
^DIC(9.4,82,22,2,"PAH",34,1,50,0)="       Y        YES"
^DIC(9.4,82,22,2,"PAH",34,1,51,0)="       N        NO"
^DIC(9.4,82,22,2,"PAH",34,1,52,0)="CMOP DRUG Cost Missing reports: YES//"
^DIC(9.4,82,22,2,"PAH",35,0)="40 SEQ #36^3020724^1"
^DIC(9.4,82,22,2,"PAH",35,1,0)="^^25^25^3020724"
^DIC(9.4,82,22,2,"PAH",35,1,1,0)="1) Problem:   The facility patient data can contain the character ""|"". "
^DIC(9.4,82,22,2,"PAH",35,1,2,0)="This disrupts the transmission interpretation as that character is used "
^DIC(9.4,82,22,2,"PAH",35,1,3,0)="as a separator in processing the data streams."
^DIC(9.4,82,22,2,"PAH",35,1,4,0)="CMH-0801-N0271"
^DIC(9.4,82,22,2,"PAH",35,1,5,0)="  "
^DIC(9.4,82,22,2,"PAH",35,1,6,0)="Resolution:   The software has been modified to substitute the space "
^DIC(9.4,82,22,2,"PAH",35,1,7,0)="character "" "" for the ""|"" as the patient data for transmissions is being "
^DIC(9.4,82,22,2,"PAH",35,1,8,0)="built."
^DIC(9.4,82,22,2,"PAH",35,1,9,0)="  "
^DIC(9.4,82,22,2,"PAH",35,1,10,0)="2) Problem:   The outpatient function 'Print Current Division -  Standard "
^DIC(9.4,82,22,2,"PAH",35,1,11,0)="CMOP from Suspense' generates an error ""undefined variable PSXPTR"" while "
^DIC(9.4,82,22,2,"PAH",35,1,12,0)="printing outpatient suspense labels."
^DIC(9.4,82,22,2,"PAH",35,1,13,0)="HAM-0302-21530"
^DIC(9.4,82,22,2,"PAH",35,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",35,1,15,0)="Resolution:   The code has been modified so that the variable being used "
^DIC(9.4,82,22,2,"PAH",35,1,16,0)="is proper and defined."
^DIC(9.4,82,22,2,"PAH",35,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",35,1,18,0)="3) E3R 11027:  It is requested that the patient phone number be "
^DIC(9.4,82,22,2,"PAH",35,1,19,0)="transmitted to the Consolidated Mail Outpatient Pharmacy (CMOP) facility "
^DIC(9.4,82,22,2,"PAH",35,1,20,0)="as part of the patient address.  It is required information for overnight "
^DIC(9.4,82,22,2,"PAH",35,1,21,0)="delivery of packages."
^DIC(9.4,82,22,2,"PAH",35,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",35,1,23,0)="Resolution:  The software has been modified to pull the patient phone "
^DIC(9.4,82,22,2,"PAH",35,1,24,0)="number from Veterans Health Information Systems and Technology "
^DIC(9.4,82,22,2,"PAH",35,1,25,0)="Architecture (VISTA) and provide it to the vendor software. "
^DIC(9.4,82,22,2,"PAH",36,0)="42 SEQ #37^3020927^1"
^DIC(9.4,82,22,2,"PAH",36,1,0)="^^26^26^3020927"
^DIC(9.4,82,22,2,"PAH",36,1,1,0)="1) Problem: The Consolidated Mail Outpatient Pharmacy (CMOP) software is "
^DIC(9.4,82,22,2,"PAH",36,1,2,0)="erroneously including prescriptions currently being filled in the list of"
^DIC(9.4,82,22,2,"PAH",36,1,3,0)="prescriptions in suspense for future processing."
^DIC(9.4,82,22,2,"PAH",36,1,4,0)="CON-0502-11795"
^DIC(9.4,82,22,2,"PAH",36,1,5,0)="CMC-0602-30991"
^DIC(9.4,82,22,2,"PAH",36,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",36,1,7,0)="Resolution: The code has been modified to correct the problem."
^DIC(9.4,82,22,2,"PAH",36,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",36,1,9,0)="2) Problem: The ""CMOP Error Encountered"" message is not displaying the "
^DIC(9.4,82,22,2,"PAH",36,1,10,0)="proper patient associated with the prescriptions being reported."
^DIC(9.4,82,22,2,"PAH",36,1,11,0)="TNV-0502-32862"
^DIC(9.4,82,22,2,"PAH",36,1,12,0)="CLE-0702-40600"
^DIC(9.4,82,22,2,"PAH",36,1,13,0)="CMD-0702-71865"
^DIC(9.4,82,22,2,"PAH",36,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",36,1,15,0)="Resolution: The code has been modified to reflect the proper patient "
^DIC(9.4,82,22,2,"PAH",36,1,16,0)="name and social security number (SSN) on each line in the error next to "
^DIC(9.4,82,22,2,"PAH",36,1,17,0)="the prescription number."
^DIC(9.4,82,22,2,"PAH",36,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",36,1,19,0)="3) Problem: Prescriptions that are in CMOP suspense, for patients who "
^DIC(9.4,82,22,2,"PAH",36,1,20,0)="are having their mail routing changed in a manner that would disable them "
^DIC(9.4,82,22,2,"PAH",36,1,21,0)="from going to CMOP, are not dropping into local suspense but are "
^DIC(9.4,82,22,2,"PAH",36,1,22,0)="remaining in CMOP suspense."
^DIC(9.4,82,22,2,"PAH",36,1,23,0)="ISB-0702-30004"
^DIC(9.4,82,22,2,"PAH",36,1,24,0)=" "
^DIC(9.4,82,22,2,"PAH",36,1,25,0)="Resolution: The code has been modified to notify the user and move the "
^DIC(9.4,82,22,2,"PAH",36,1,26,0)="prescription into local suspense and create an activity log entry."
^DIC(9.4,82,22,2,"PAH",37,0)="34 SEQ #38^3021008^1"
^DIC(9.4,82,22,2,"PAH",37,1,0)="^^103^103^3021008"
^DIC(9.4,82,22,2,"PAH",37,1,1,0)="!! NOTE: !!  Health care facilities do not have the Consolidated Mail "
^DIC(9.4,82,22,2,"PAH",37,1,2,0)="Outpatient Pharmacy (CMOP) Reference file and the installation will"
^DIC(9.4,82,22,2,"PAH",37,1,3,0)="generate an error that can be ignored for health care facilities."
^DIC(9.4,82,22,2,"PAH",37,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,5,0)="The error reported is:"
^DIC(9.4,82,22,2,"PAH",37,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,7,0)="** ERROR IN DATA DICTIONARY FOR FILE # 552.1 **"
^DIC(9.4,82,22,2,"PAH",37,1,8,0)="Data Dictionary not installed; Partial DD/File does not exist."
^DIC(9.4,82,22,2,"PAH",37,1,9,0)="              May 22, 2002@10:07:09"
^DIC(9.4,82,22,2,"PAH",37,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,11,0)="1. Enhancement: CMOP HOSTS: A new field, CONTROLLED SUBSTANCE (#21)"
^DIC(9.4,82,22,2,"PAH",37,1,12,0)="has been added to CMOP REFERENCE file (#552.1) to track controlled"
^DIC(9.4,82,22,2,"PAH",37,1,13,0)="substance transmissions."
^DIC(9.4,82,22,2,"PAH",37,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,15,0)="552.1,21      CONTROLLED SUBSTANCE   0;8 SET"
^DIC(9.4,82,22,2,"PAH",37,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,17,0)="                                '0' FOR Non-CS Transmission; "
^DIC(9.4,82,22,2,"PAH",37,1,18,0)="                                '1' FOR CS Transmission; "
^DIC(9.4,82,22,2,"PAH",37,1,19,0)="              LAST EDITED:      MAY 21, 2002 "
^DIC(9.4,82,22,2,"PAH",37,1,20,0)="              HELP-PROMPT:      Enter a 0 or 1, 1 for Controlled "
^DIC(9.4,82,22,2,"PAH",37,1,21,0)="                                Substances Transmission"
^DIC(9.4,82,22,2,"PAH",37,1,22,0)="              DESCRIPTION:      A 1 indicates that this CMOP batch "
^DIC(9.4,82,22,2,"PAH",37,1,23,0)="                                contains controlled substances."
^DIC(9.4,82,22,2,"PAH",37,1,24,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,25,0)="              TECHNICAL DESCR:  This field is populated by routine "
^DIC(9.4,82,22,2,"PAH",37,1,26,0)="                                PSXRECV. This field should not be edited"
^DIC(9.4,82,22,2,"PAH",37,1,27,0)="                                by users."
^DIC(9.4,82,22,2,"PAH",37,1,28,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,29,0)="              CROSS-REFERENCE:  552.1^C "
^DIC(9.4,82,22,2,"PAH",37,1,30,0)="                                1)= S ^PSX(552.1,""C"",$E(X,1,30),DA)="""""
^DIC(9.4,82,22,2,"PAH",37,1,31,0)="                                2)= K ^PSX(552.1,""C"",$E(X,1,30),DA)"
^DIC(9.4,82,22,2,"PAH",37,1,32,0)="                                This cross reference is set when a "
^DIC(9.4,82,22,2,"PAH",37,1,33,0)="                                transmission is downloaded from the"
^DIC(9.4,82,22,2,"PAH",37,1,34,0)="                                medical center.  A 1 indicates the"
^DIC(9.4,82,22,2,"PAH",37,1,35,0)="                                transmission is a controlled substance"
^DIC(9.4,82,22,2,"PAH",37,1,36,0)="                                transmission.  "
^DIC(9.4,82,22,2,"PAH",37,1,37,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,38,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,39,0)="2. E3R 9440:    CMOP HOSTS: It is requested that the Unreleased Rx's "
^DIC(9.4,82,22,2,"PAH",37,1,40,0)="Report [PSX UNRELEASED] be modified to included selection of date ranges,"
^DIC(9.4,82,22,2,"PAH",37,1,41,0)="facilities, and types of transmissions (Controlled Substances and "
^DIC(9.4,82,22,2,"PAH",37,1,42,0)="Non-Controlled Substances).  It is also requested to reveal and"
^DIC(9.4,82,22,2,"PAH",37,1,43,0)="sort by the order number within the batches displayed."
^DIC(9.4,82,22,2,"PAH",37,1,44,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,45,0)="Resolution:     The code has been modified to accommodate the requests. An"
^DIC(9.4,82,22,2,"PAH",37,1,46,0)="example of the new user dialog and printout follows."
^DIC(9.4,82,22,2,"PAH",37,1,47,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,48,0)="Select OPTION NAME: PSX REPORTS MENU       Reports"
^DIC(9.4,82,22,2,"PAH",37,1,49,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,50,0)="Select Reports Option: Unreleased Rx's Report"
^DIC(9.4,82,22,2,"PAH",37,1,51,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,52,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,53,0)="Select CMOP Batch # or RETURN for all:  ?"
^DIC(9.4,82,22,2,"PAH",37,1,54,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,55,0)=" Answer with CMOP REFERENCE FACILITY BATCH REFERENCE"
^DIC(9.4,82,22,2,"PAH",37,1,56,0)=" Do you want the entire 70522-Entry CMOP REFERENCE List? N  (No)"
^DIC(9.4,82,22,2,"PAH",37,1,57,0)="Select CMOP Batch # or RETURN for all: <CR>"
^DIC(9.4,82,22,2,"PAH",37,1,58,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,59,0)=" (NOTE: If a single batch is selected the dialog skips to the device question.)"
^DIC(9.4,82,22,2,"PAH",37,1,60,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,61,0)="     Select one of the following:"
^DIC(9.4,82,22,2,"PAH",37,1,62,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,63,0)="          C         Controlled Subs"
^DIC(9.4,82,22,2,"PAH",37,1,64,0)="          N         Non-Controlled Subs"
^DIC(9.4,82,22,2,"PAH",37,1,65,0)="          B         Both"
^DIC(9.4,82,22,2,"PAH",37,1,66,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,67,0)="Enter response: ?"
^DIC(9.4,82,22,2,"PAH",37,1,68,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,69,0)="Enter ""C"" to report controlled substances, ""N"" for non-controlled"
^DIC(9.4,82,22,2,"PAH",37,1,70,0)="substances or ""B"" to include both."
^DIC(9.4,82,22,2,"PAH",37,1,71,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,72,0)="Enter response: Both"
^DIC(9.4,82,22,2,"PAH",37,1,73,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,74,0)="Enter date to BEGIN SUMMARY: TODAY//T-30  (JAN 23, 2001)"
^DIC(9.4,82,22,2,"PAH",37,1,75,0)="Enter date to END SUMMARY:  TODAY//T-2  (FEB 20, 2001)"
^DIC(9.4,82,22,2,"PAH",37,1,76,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,77,0)="Select FACILITY or RETURN for all: ?"
^DIC(9.4,82,22,2,"PAH",37,1,78,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,79,0)=" Answer with CMOP NATIONAL SITE FACILITY, or STATUS"
^DIC(9.4,82,22,2,"PAH",37,1,80,0)=" Do you want the entire 72-Entry CMOP NATIONAL SITE List? N  (No)"
^DIC(9.4,82,22,2,"PAH",37,1,81,0)="Select FACILITY or RETURN for all:"
^DIC(9.4,82,22,2,"PAH",37,1,82,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,83,0)="DEVICE: HOME//   TELNET"
^DIC(9.4,82,22,2,"PAH",37,1,84,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,85,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,86,0)="               Report of Unreleased Rxs for Transmission 460-1625"
^DIC(9.4,82,22,2,"PAH",37,1,87,0)="                       Printed : Feb 22, 2001 4:12:32 pm"
^DIC(9.4,82,22,2,"PAH",37,1,88,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,89,0)="Facility: WILMINGTON, DE                 Pharmacy Division: WILMINGTON VAMC"
^DIC(9.4,82,22,2,"PAH",37,1,90,0)="Transmitted: Feb 21, 2001 0:02:33 am     Received: Feb 20, 2001 11:25:03 pm"
^DIC(9.4,82,22,2,"PAH",37,1,91,0)="Batch Type: Non-Controlled Substance"
^DIC(9.4,82,22,2,"PAH",37,1,92,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,93,0)="ORDER #           RX NUMBER FILL DRUG NAME                            DRUG ID"
^DIC(9.4,82,22,2,"PAH",37,1,94,0)="----------------------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",37,1,95,0)=" "
^DIC(9.4,82,22,2,"PAH",37,1,96,0)="460-1625-13       1064494C  3    ISOSORBIDE DINITRATE 20MG TAB,ORAL   I0076"
^DIC(9.4,82,22,2,"PAH",37,1,97,0)="460-1625-13       1079105C  3    FUROSEMIDE 40MG TAB                  F0078"
^DIC(9.4,82,22,2,"PAH",37,1,98,0)="460-1625-13       1118354B  3    SPIRONOLACTONE 25MG TAB              S0043"
^DIC(9.4,82,22,2,"PAH",37,1,99,0)="460-1625-167      1172873   3    NITROGLYCERIN 0.4MG TAB,SUBLINGUAL   N0057"
^DIC(9.4,82,22,2,"PAH",37,1,100,0)="460-1625-167      1113467A  1    POTASSIUM CHLORIDE 8MEQ TAB,SA       P0086"
^DIC(9.4,82,22,2,"PAH",37,1,101,0)="460-1625-167      1113468A  1    RANITIDINE HCL 150MG TAB             R0005"
^DIC(9.4,82,22,2,"PAH",37,1,102,0)="460-1625-167      1113469A  1    SIMVASTATIN 40MG TAB                 S0022"
