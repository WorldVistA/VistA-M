^DIC(9.4,100,22,15,"PAH",38,1,27,0)="    "
^DIC(9.4,100,22,15,"PAH",38,1,28,0)=""
^DIC(9.4,100,22,15,"PAH",38,1,29,0)="                                   Checksum Values"
^DIC(9.4,100,22,15,"PAH",38,1,30,0)=""
