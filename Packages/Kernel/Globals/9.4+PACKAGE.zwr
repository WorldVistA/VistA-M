^DIC(9.4,11,22,5.03,"PAH",21,1,319,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,320,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",21,1,321,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",21,1,322,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",21,1,323,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",21,1,324,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",21,1,325,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,326,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",21,1,327,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",21,1,328,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",21,1,329,0)="   LA57             N/A            5998709        **57** (Deleted by KIDS)"
^DIC(9.4,11,22,5.03,"PAH",21,1,330,0)="   LA7ADL           10978189       5237792        **17,25,23,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,331,0)="   LA7ADL1          7046668        4892374        **17,23,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,332,0)="   LA7UID           2037413        2071504        **17,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,333,0)="   LA7UID1          5866288        2775829        **17,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,334,0)="   LA7UID2          9041764        8668527        **17,27,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,335,0)="   LA7UIIN1         10176639       5544723        **17,23,27,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,336,0)="   LADOWN           9641097        5592262        **17,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,337,0)="   LADOWN1          1620875        814617         **17,42,57**"
^DIC(9.4,11,22,5.03,"PAH",21,1,338,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,339,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,340,0)="List of preceding patches: 27, 42"
^DIC(9.4,11,22,5.03,"PAH",21,1,341,0)="Sites should use CHECK^XTSUMBLD to verify checksums. "
^DIC(9.4,11,22,5.03,"PAH",21,1,342,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,343,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,344,0)="FILE SECURITY"
^DIC(9.4,11,22,5.03,"PAH",21,1,345,0)="============= "
^DIC(9.4,11,22,5.03,"PAH",21,1,346,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,347,0)=" There are six existing fields which have FileMan Write Access changed to"
^DIC(9.4,11,22,5.03,"PAH",21,1,348,0)=" ""@"". This is required for security purposes. To edit these fields requires"
^DIC(9.4,11,22,5.03,"PAH",21,1,349,0)=" the user to have FileMan Programmer's Access. The fields affected are:"
^DIC(9.4,11,22,5.03,"PAH",21,1,350,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,351,0)="  - PROGRAM (#2), DOWNLOAD ENTRY (#91), DOWNLOAD PROTOCOL ROUTINE (#92),"
^DIC(9.4,11,22,5.03,"PAH",21,1,352,0)="    FILE BUILD ENTRY (#93) and FILE BUILD ROUTINE (#94) of the"
^DIC(9.4,11,22,5.03,"PAH",21,1,353,0)="    AUTO INSTRUMENT file (#62.4)."
^DIC(9.4,11,22,5.03,"PAH",21,1,354,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,355,0)="  - PARAM 1 (#2) within CHEM TESTS multiple field (#30) of the AUTO"
^DIC(9.4,11,22,5.03,"PAH",21,1,356,0)="    INSTRUMENT file (#62.4)."
^DIC(9.4,11,22,5.03,"PAH",21,1,357,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,358,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",21,1,359,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,360,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",21,1,361,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",21,1,362,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,363,0)="  The install time for this patch is less than 5 minutes. This patch"
^DIC(9.4,11,22,5.03,"PAH",21,1,364,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",21,1,365,0)="  Suggested time to install: non-peak hours. "
^DIC(9.4,11,22,5.03,"PAH",21,1,366,0)="  The install will disable option Download a load list to an Instrument"
^DIC(9.4,11,22,5.03,"PAH",21,1,367,0)="  [LA DOWN] as specified in #7 below and turn off Lab Universal Interface"
^DIC(9.4,11,22,5.03,"PAH",21,1,368,0)="  Auto Download. Accessioning should not be occurring within the"
^DIC(9.4,11,22,5.03,"PAH",21,1,369,0)="  Laboratory package during the installation of this patch."
^DIC(9.4,11,22,5.03,"PAH",21,1,370,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,371,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,372,0)="NOTE: Kernel, MailMan and HL7 patches must be current on the target system"
^DIC(9.4,11,22,5.03,"PAH",21,1,373,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",21,1,374,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,375,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",21,1,376,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",21,1,377,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,378,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,379,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",21,1,380,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,381,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",21,1,382,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",21,1,383,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,384,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",21,1,385,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",21,1,386,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,387,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",21,1,388,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",21,1,389,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,390,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",21,1,391,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",21,1,392,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,393,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",21,1,394,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",21,1,395,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",21,1,396,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",21,1,397,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",21,1,398,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,399,0)="      If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,11,22,5.03,"PAH",21,1,400,0)="      prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,11,22,5.03,"PAH",21,1,401,0)="      option at this time.  You may also compare the routines in your"
^DIC(9.4,11,22,5.03,"PAH",21,1,402,0)="      production account to the routines in the patch by using the 'Compare"
^DIC(9.4,11,22,5.03,"PAH",21,1,403,0)="      a Transport Global to Current System' option."
^DIC(9.4,11,22,5.03,"PAH",21,1,404,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,405,0)="  7.  The install will disable the following Lab option during patch"
^DIC(9.4,11,22,5.03,"PAH",21,1,406,0)="      installation."
^DIC(9.4,11,22,5.03,"PAH",21,1,407,0)="     "
^DIC(9.4,11,22,5.03,"PAH",21,1,408,0)="      Download a load list to an Instrument [LA DOWN]"
^DIC(9.4,11,22,5.03,"PAH",21,1,409,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,410,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",21,1,411,0)="      and select the package 'LA*5.2*57'.  When prompted 'Want to"
^DIC(9.4,11,22,5.03,"PAH",21,1,412,0)="      DISABLE Scheduled Options, Menu Options, and Protocols? YES//',"
^DIC(9.4,11,22,5.03,"PAH",21,1,413,0)="      choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",21,1,414,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,415,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",21,1,416,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,417,0)=" 10. Routine LA57 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",21,1,418,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,419,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,420,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,11,22,5.03,"PAH",21,1,421,0)="==============================="
^DIC(9.4,11,22,5.03,"PAH",21,1,422,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,423,0)="The Lab ADPAC/LIM should review the AUTO INSTRUMENT and LOAD/WORK LIST"
^DIC(9.4,11,22,5.03,"PAH",21,1,424,0)="files to adjust any field settings based on the corrections/enhancements "
^DIC(9.4,11,22,5.03,"PAH",21,1,425,0)="introduced by this patch."
^DIC(9.4,11,22,5.03,"PAH",21,1,426,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,427,0)="Note: Use FileMan Enter/Edit option to edit LOAD/WORK LIST file (#68.2)"
^DIC(9.4,11,22,5.03,"PAH",21,1,428,0)="      and AUTO INSTRUMENT file (#62.4)."
^DIC(9.4,11,22,5.03,"PAH",21,1,429,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,430,0)="1. If using the auto download feature of the Lab Universal Interface then"
^DIC(9.4,11,22,5.03,"PAH",21,1,431,0)="shutdown the auto download process first before making changes. This can"
^DIC(9.4,11,22,5.03,"PAH",21,1,432,0)="be performed by using the Start/Stop Auto Download Background Job"
^DIC(9.4,11,22,5.03,"PAH",21,1,433,0)="[LA7 ADL START/STOP] option and selecting action: 2 Shutdown Auto Download"
^DIC(9.4,11,22,5.03,"PAH",21,1,434,0)="Job."
^DIC(9.4,11,22,5.03,"PAH",21,1,435,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,436,0)="2. To prevent uncollected accessions from being downloaded via the"
^DIC(9.4,11,22,5.03,"PAH",21,1,437,0)="Universal Interface, use FileMan Enter/Edit to set INCLUDE UNCOLLECTED"
^DIC(9.4,11,22,5.03,"PAH",21,1,438,0)="ACCESSIONS (#.1) field in the LOAD/WORK LIST file (#68.2) to NO for the"
^DIC(9.4,11,22,5.03,"PAH",21,1,439,0)="load/work list that is associated with an instrument in the AUTO INSTRUMENT"
^DIC(9.4,11,22,5.03,"PAH",21,1,440,0)="file via LOAD/WORK LIST field (#3)."
^DIC(9.4,11,22,5.03,"PAH",21,1,441,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,442,0)="3. Configure those tests that will require download eligibility screening."
^DIC(9.4,11,22,5.03,"PAH",21,1,443,0)="Using FileMan Enter/Edit, edit these tests in the AUTO INSTRUMENT file that"
^DIC(9.4,11,22,5.03,"PAH",21,1,444,0)="should be screened by editing the fields ACCESSION AREA (#7), SPECIMEN (#8)"
^DIC(9.4,11,22,5.03,"PAH",21,1,445,0)="and URGENCY (#9) within CHEM TESTS multiple field (#30) of the AUTO"
^DIC(9.4,11,22,5.03,"PAH",21,1,446,0)="INSTRUMENT file (#62.4)."
^DIC(9.4,11,22,5.03,"PAH",21,1,447,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,448,0)="If the same test requires different screening criteria, the test can be"
^DIC(9.4,11,22,5.03,"PAH",21,1,449,0)="entered multiple times and configured appropriately."
^DIC(9.4,11,22,5.03,"PAH",21,1,450,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,451,0)="4. Restart the auto download if stopped in number #1 above using the same"
^DIC(9.4,11,22,5.03,"PAH",21,1,452,0)="option and selecting action: 1 Start/Restart Auto Download Job."
^DIC(9.4,11,22,5.03,"PAH",21,1,453,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,454,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,455,0)="  "
^DIC(9.4,11,22,5.03,"PAH",21,1,456,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",21,1,457,0)="Installation example: "
^DIC(9.4,11,22,5.03,"PAH",21,1,458,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,459,0)="Select Installation Option: 6  Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",21,1,460,0)="Select INSTALL NAME: LA*5.2*57  Loaded from Distribution  5/11/00@15:44:21"
^DIC(9.4,11,22,5.03,"PAH",21,1,461,0)="     => LA*5.2*57"
^DIC(9.4,11,22,5.03,"PAH",21,1,462,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,463,0)="This Distribution was loaded on May 11, 2000@15:44:21 with header of"
^DIC(9.4,11,22,5.03,"PAH",21,1,464,0)="   LA*5.2*57"
^DIC(9.4,11,22,5.03,"PAH",21,1,465,0)="   It consisted of the following Install(s):"
^DIC(9.4,11,22,5.03,"PAH",21,1,466,0)="      LA*5.2*57"
^DIC(9.4,11,22,5.03,"PAH",21,1,467,0)="Checking Install for Package LA*5.2*57"
^DIC(9.4,11,22,5.03,"PAH",21,1,468,0)="Will first run the Environment Check Routine, LA57"
^DIC(9.4,11,22,5.03,"PAH",21,1,469,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,470,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,471,0)="                        --- Environment Check is Ok ---"
^DIC(9.4,11,22,5.03,"PAH",21,1,472,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,473,0)="Install Questions for LA*5.2*57"
^DIC(9.4,11,22,5.03,"PAH",21,1,474,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,475,0)="Incoming Files:"
^DIC(9.4,11,22,5.03,"PAH",21,1,476,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,477,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,478,0)="   62.4      AUTO INSTRUMENT  (Partial Definition)"
^DIC(9.4,11,22,5.03,"PAH",21,1,479,0)="Note:  You already have the 'AUTO INSTRUMENT' File."
^DIC(9.4,11,22,5.03,"PAH",21,1,480,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,481,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,11,22,5.03,"PAH",21,1,482,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,483,0)=" "
^DIC(9.4,11,22,5.03,"PAH",21,1,484,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,11,22,5.03,"PAH",21,1,485,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,11,22,5.03,"PAH",21,1,486,0)=" "
