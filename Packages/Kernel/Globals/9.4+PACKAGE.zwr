^DIC(9.4,48,22,5.28,"PAH",669,1,7,0)="VSE-7631: MB - VistA: Modify SDES2 GET CONTACT ATTEMPT RPC to correct an "
^DIC(9.4,48,22,5.28,"PAH",669,1,8,0)="                issue with the error return "
^DIC(9.4,48,22,5.28,"PAH",669,1,9,0)="VSE-7648: AP - VistA: Modify SDES2 GET EXPANDED ENTRY 2 to return "
^DIC(9.4,48,22,5.28,"PAH",669,1,10,0)="                Yes/No/NA for IsClassificationActive"
^DIC(9.4,48,22,5.28,"PAH",669,1,11,0)="VSE-7666: BF - VistA: Modify SDESUTIL to recognize that there may be "
^DIC(9.4,48,22,5.28,"PAH",669,1,12,0)="                times when there are both active and inactive AMIS stop"
^DIC(9.4,48,22,5.28,"PAH",669,1,13,0)="                codes"
^DIC(9.4,48,22,5.28,"PAH",669,1,14,0)="VSE-7680: JS - VistA: Create 2 new routines in the SDES2 namespace"
^DIC(9.4,48,22,5.28,"PAH",669,1,15,0)="VSE-7692: BB - VistA: Modify SDEC07A routine to rewrite the logic around "
^DIC(9.4,48,22,5.28,"PAH",669,1,16,0)="                consults"
^DIC(9.4,48,22,5.28,"PAH",669,1,17,0)="VSE-7712: BF - VistA: Fix an issue with the query tool "
^DIC(9.4,48,22,5.28,"PAH",669,1,18,0)="VSE-7739: BF - VistA: Backup SD PURGE menu option and then remove it "
^DIC(9.4,48,22,5.28,"PAH",669,1,19,0)="                form the menu"
^DIC(9.4,48,22,5.28,"PAH",669,1,20,0)="VSE-7862: BF - VistA: Rewrite SDES GET APPT REQ BY TYPE VET into the SDES2"
^DIC(9.4,48,22,5.28,"PAH",669,1,21,0)="               namespace"
^DIC(9.4,48,22,5.28,"PAH",669,1,22,0)="VSE-7867: TB - VistA: Modify SDES2 ADD CONTACT ATTEMPT and SDES2 GET"
^DIC(9.4,48,22,5.28,"PAH",669,1,23,0)="               CONTACT ATTEMPTS so that date time entered is in system"
^DIC(9.4,48,22,5.28,"PAH",669,1,24,0)="               time"
^DIC(9.4,48,22,5.28,"PAH",669,1,25,0)="VSE-7869: LB - VistA: Modify SDES2 CANCEL APPOINTMENT RPC to correctly "
^DIC(9.4,48,22,5.28,"PAH",669,1,26,0)="               update recall request pointers"
^DIC(9.4,48,22,5.28,"PAH",669,1,27,0)="VSE-7876: MD - VistA: Update the Privileged User validation in routine "
^DIC(9.4,48,22,5.28,"PAH",669,1,28,0)="               SDES2VAL44A"
^DIC(9.4,48,22,5.28,"PAH",669,1,29,0)="VSE-7943: BF - VistA: Modify SDES2 GET DEMOGRAPHICS to only send active "
