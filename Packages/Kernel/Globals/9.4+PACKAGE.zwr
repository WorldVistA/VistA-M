^DIC(9.4,48,22,5.28,"PAH",310,1,0)="^^4^4^3050924"
^DIC(9.4,48,22,5.28,"PAH",310,1,1,0)="The Institution selection in several EWL reports only includes"
^DIC(9.4,48,22,5.28,"PAH",310,1,2,0)="institutions that have been set up via EWL Parameter enter/edit.  Logic"
