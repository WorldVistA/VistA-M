^DIC(9.4,192,22,3,"PAH",0)="^9.4901^3^3"
^DIC(9.4,192,22,3,"PAH",1,0)="3^3190201.144656^54"
^DIC(9.4,192,22,3,"PAH",1,1,0)="^^2^2^3190201"
^DIC(9.4,192,22,3,"PAH",1,1,1,0)="Adds a new RPC, XOBV VALIDATE SAML that is used to sign in with a PIV "
^DIC(9.4,192,22,3,"PAH",1,1,2,0)="card using 2 Factor Authentication."
^DIC(9.4,192,22,3,"PAH",2,0)="4^3221004.133623^89"
^DIC(9.4,192,22,3,"PAH",2,1,0)="^^4^4^3221004"
^DIC(9.4,192,22,3,"PAH",2,1,1,0)="This patch corrects an issue within the VISTALINK package:"
^DIC(9.4,192,22,3,"PAH",2,1,2,0)=" "
^DIC(9.4,192,22,3,"PAH",2,1,3,0)="VistaLink server errors are not respecting the Kernel's limits for logging"
^DIC(9.4,192,22,3,"PAH",2,1,4,0)="errors. "
^DIC(9.4,192,22,3,"PAH",3,0)="6 SEQ #6^3221004.134043^89"
^DIC(9.4,192,22,3,"PAH",3,1,0)="^^13^13^3221004"
^DIC(9.4,192,22,3,"PAH",3,1,1,0)="1. Fix Non-Provisioned User Login Problem"
^DIC(9.4,192,22,3,"PAH",3,1,2,0)=" "
^DIC(9.4,192,22,3,"PAH",3,1,3,0)="   When a non-provisioned user fails a login, subsequent attempts result "
^DIC(9.4,192,22,3,"PAH",3,1,4,0)="   in a ""Socket timeout has occurred"" error, when they should still"
^DIC(9.4,192,22,3,"PAH",3,1,5,0)="   receive the ""Error processing login credentials"" error."
^DIC(9.4,192,22,3,"PAH",3,1,6,0)=" "
^DIC(9.4,192,22,3,"PAH",3,1,7,0)="2. Fix Three Issues in Routine XOBVLL"
^DIC(9.4,192,22,3,"PAH",3,1,8,0)=" "
^DIC(9.4,192,22,3,"PAH",3,1,9,0)="   There are three known issues in routine XOBVLL: two occurrences of"
^DIC(9.4,192,22,3,"PAH",3,1,10,0)="   syntax errors when code stored in the $ET and $EC variables executes;"
^DIC(9.4,192,22,3,"PAH",3,1,11,0)="   and a problem of blanks appearing in the error descriptions in the "
^DIC(9.4,192,22,3,"PAH",3,1,12,0)="   error trap due to extrinsic function EZBLD^DIALOG being called"
^DIC(9.4,192,22,3,"PAH",3,1,13,0)="   incorrectly."
