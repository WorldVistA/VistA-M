^DIC(9.4,4,22,1,"PAH",50,1,5,0)="When a PackMan message is copied, field 1.7 (MESSAGE TYPE) in the MESSAGE"
^DIC(9.4,4,22,1,"PAH",50,1,6,0)="file should be set to either ""K"" for KIDS or ""X"" for PackMan.  MailMan"
^DIC(9.4,4,22,1,"PAH",50,1,7,0)="patch XM*7.1*50 inadvertently omitted this.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",50,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",50,1,9,0)="NOTE: This patch should be installed after hours, when user activity is at a"
