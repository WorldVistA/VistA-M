^DIC(9.4,59,22,5,"PAH",211,0)="181 SEQ #211^3091130.135936^17"
^DIC(9.4,59,22,5,"PAH",211,1,0)="^^10^10^3091130"
^DIC(9.4,59,22,5,"PAH",211,1,1,0)="This patch is part of FY09-Q1 Enhancement release and should be installed"
^DIC(9.4,59,22,5,"PAH",211,1,2,0)="along with OUTPATIENT PHARMACY (OP) V. 7.0 patch PSO*7*326. It is a"
^DIC(9.4,59,22,5,"PAH",211,1,3,0)="required patch for PSO*7*326."
^DIC(9.4,59,22,5,"PAH",211,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",211,1,5,0)="This Enhancement is related to Patient Safety Issue PSI-07-090 (PSPO #543)"
^DIC(9.4,59,22,5,"PAH",211,1,6,0)="and Remedy Ticket #189923. The Social Security Number (SSN) was removed"
^DIC(9.4,59,22,5,"PAH",211,1,7,0)="from the Integration Control Registration (ICR) #2261, which is related to"
^DIC(9.4,59,22,5,"PAH",211,1,8,0)="the following OP report option:"
^DIC(9.4,59,22,5,"PAH",211,1,9,0)="  Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,59,22,5,"PAH",211,1,10,0)="    - Hidden action (OTH) - MI Print Medication Instructions."
^DIC(9.4,59,22,5,"PAH",212,0)="222^3091130.140137^17"
^DIC(9.4,59,22,5,"PAH",212,1,0)="^^17^17^3091130"
^DIC(9.4,59,22,5,"PAH",212,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",212,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",212,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",212,1,4,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",212,1,5,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",212,1,6,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",212,1,7,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",212,1,8,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",212,1,9,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",212,1,10,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",212,1,11,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",212,1,12,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",212,1,13,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",212,1,14,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",212,1,15,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",212,1,16,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",212,1,17,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",213,0)="223^3091130.140238^17"
^DIC(9.4,59,22,5,"PAH",213,1,0)="^^6^6^3091130"
^DIC(9.4,59,22,5,"PAH",213,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",213,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",213,1,3,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",213,1,4,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",213,1,5,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
^DIC(9.4,59,22,5,"PAH",213,1,6,0)="file (#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",214,0)="224^3091207.105455^17"
^DIC(9.4,59,22,5,"PAH",214,1,0)="^^18^18^3091207"
^DIC(9.4,59,22,5,"PAH",214,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",214,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",214,1,3,0)="with the Patient Medication Instruction Sheet (PMI) portion of the"
^DIC(9.4,59,22,5,"PAH",214,1,4,0)="National Drug File (NDF) application.  The seven files are:"
^DIC(9.4,59,22,5,"PAH",214,1,5,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",214,1,6,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",214,1,7,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",214,1,8,0)="   50.624        PMI MAP-SPANISH          "
^DIC(9.4,59,22,5,"PAH",214,1,9,0)="   50.625        WARNING LABEL-ENGLISH    "
^DIC(9.4,59,22,5,"PAH",214,1,10,0)="   50.626        WARNING LABEL-SPANISH    "
^DIC(9.4,59,22,5,"PAH",214,1,11,0)="   50.627        WARNING LABEL MAP     "
^DIC(9.4,59,22,5,"PAH",214,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",214,1,13,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",214,1,14,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",214,1,15,0)="The post-install routine for this patch deletes existing entries in these"
^DIC(9.4,59,22,5,"PAH",214,1,16,0)="files, loads the new data, and rematches entries in the VA PRODUCT file "
^DIC(9.4,59,22,5,"PAH",214,1,17,0)="(#50.68) to the proper PMIs."
^DIC(9.4,59,22,5,"PAH",214,1,18,0)="The source of the data for the PMIs is First Data Bank."
