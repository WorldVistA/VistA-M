^DIC(9.4,49,22,10,"PAH",133,1,1,0)="REASONS NOT BILLABLE/FOLLOW-UP/VETS WITH UNVERIFIED ELIG. REPORTS"
^DIC(9.4,49,22,10,"PAH",134,0)="220 SEQ #201^3030802^1"
^DIC(9.4,49,22,10,"PAH",134,1,0)="^^4^4^3030802"
^DIC(9.4,49,22,10,"PAH",134,1,1,0)="This patch corrects a problem with the range selection in the"
