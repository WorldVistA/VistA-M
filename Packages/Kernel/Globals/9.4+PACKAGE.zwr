^DIC(9.4,170,0)="CLINICAL INFO RESOURCE NETWORK^RG^CIRN"
^DIC(9.4,170,1,0)="^^1^1^2981028^^^^"
^DIC(9.4,170,1,1,0)="Clinical Information Resource Network (CIRN)"
^DIC(9.4,170,14,0)="^9.4014^1^1"
