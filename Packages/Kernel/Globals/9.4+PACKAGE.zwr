^DIC(9.4,14,22,5.9,"PAH",140,1,254,0)="   <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",140,1,255,0)="  "
