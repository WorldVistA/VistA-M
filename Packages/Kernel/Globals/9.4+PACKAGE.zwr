^DIC(9.4,14,22,5.9,"PAH",210,1,333,0)="The second line of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",210,1,334,0)=" ;;5.2;LAB SERVICE;**[Patch List]**;Sep 27, 1994;Build 21"
^DIC(9.4,14,22,5.9,"PAH",210,1,335,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,336,0)="The checksums below are new checksums, and"
^DIC(9.4,14,22,5.9,"PAH",210,1,337,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,14,22,5.9,"PAH",210,1,338,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,339,0)="Routine Name: LR309"
^DIC(9.4,14,22,5.9,"PAH",210,1,340,0)="    Before:       n/a   After: B56461511  **309**"
^DIC(9.4,14,22,5.9,"PAH",210,1,341,0)="Routine Name: LRAUAW"
^DIC(9.4,14,22,5.9,"PAH",210,1,342,0)="    Before:  B5818727   After:  B5111264  **72,115,121,309**"
^DIC(9.4,14,22,5.9,"PAH",210,1,343,0)=" "
^DIC(9.4,14,22,5.9,"PAH",210,1,344,0)="Routine list of preceding patches: 121"
^DIC(9.4,14,22,5.9,"PAH",211,0)="394 SEQ #310^3090623.103624^17"
^DIC(9.4,14,22,5.9,"PAH",212,0)="392 SEQ #311^3090914.135902^17"
^DIC(9.4,14,22,5.9,"PAH",212,1,0)="^^9^9^3090914"
^DIC(9.4,14,22,5.9,"PAH",212,1,1,0)="This patch is a VM general purpose lab patch that addresses 2 issues."
^DIC(9.4,14,22,5.9,"PAH",212,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",212,1,3,0)="   1. When printing an autopsy report through option ""Entries by dates,"
^DIC(9.4,14,22,5.9,"PAH",212,1,4,0)="      patient and accession number"", an <UNDEFINED> error occurs."
^DIC(9.4,14,22,5.9,"PAH",212,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",212,1,6,0)="   2. There are 3 indicators for DRAW TIMES related to antibiotics: PEAK,"
^DIC(9.4,14,22,5.9,"PAH",212,1,7,0)="      TROUGH, and RANDOM.  The designator ""RANDOM"" does not appear on"
^DIC(9.4,14,22,5.9,"PAH",212,1,8,0)="      a report under the LABS tab in CPRS GUI, as do the designators "
^DIC(9.4,14,22,5.9,"PAH",212,1,9,0)="      ""PEAK"" and ""TROUGH""."
^DIC(9.4,14,22,5.9,"PAH",213,0)="315 SEQ #312^3090928.113221^17"
^DIC(9.4,14,22,5.9,"PAH",213,1,0)="^^372^372^3090928"
^DIC(9.4,14,22,5.9,"PAH",213,1,1,0)="BLOOD BANK Clearance:"
^DIC(9.4,14,22,5.9,"PAH",213,1,2,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",213,1,3,0)="VISTA Laboratory Package patch LR*5.2*315 contains changes to software "
^DIC(9.4,14,22,5.9,"PAH",213,1,4,0)="controlled by VHA DIRECTIVE 2004-058, titled VISTA BLOOD BANK SOFTWARE. "
^DIC(9.4,14,22,5.9,"PAH",213,1,5,0)="Changes include: "
^DIC(9.4,14,22,5.9,"PAH",213,1,6,0)=" Routines:"
^DIC(9.4,14,22,5.9,"PAH",213,1,7,0)=" ---------"
^DIC(9.4,14,22,5.9,"PAH",213,1,8,0)=" LRBLJPP1"
^DIC(9.4,14,22,5.9,"PAH",213,1,9,0)=" LRBLPC1"
^DIC(9.4,14,22,5.9,"PAH",213,1,10,0)=" LRBLPCSS"
^DIC(9.4,14,22,5.9,"PAH",213,1,11,0)=" LRBLS"
^DIC(9.4,14,22,5.9,"PAH",213,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,13,0)="All of the above changes have been reviewed by the VISTA Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",213,1,14,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",213,1,15,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",213,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,17,0)="RISK ANALYSIS: Changes made by patch LR*5.2*315 have limited effect on "
^DIC(9.4,14,22,5.9,"PAH",213,1,18,0)="Blood Bank software functionality, therefore RISK is low."
^DIC(9.4,14,22,5.9,"PAH",213,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,20,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*315 does not "
^DIC(9.4,14,22,5.9,"PAH",213,1,21,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",213,1,22,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",213,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,24,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 4 routines and "
^DIC(9.4,14,22,5.9,"PAH",213,1,25,0)="0 files identified in Veterans Health Administration (VHA) Directive "
^DIC(9.4,14,22,5.9,"PAH",213,1,26,0)="2004-058, group A listing."
^DIC(9.4,14,22,5.9,"PAH",213,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,28,0)="VALIDATION REQUIREMENTS BY OPTION: "
^DIC(9.4,14,22,5.9,"PAH",213,1,29,0)="---"
^DIC(9.4,14,22,5.9,"PAH",213,1,30,0)="OPTION: (EF-MS) Maximum surgical blood order edit  [LRBLSMS]"
^DIC(9.4,14,22,5.9,"PAH",213,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,32,0)=" NORMAL:"
^DIC(9.4,14,22,5.9,"PAH",213,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,34,0)=" 1.  Enter a valid entry from the Current Procedure Terminology"
^DIC(9.4,14,22,5.9,"PAH",213,1,35,0)="     File (#81) at the ""Select OPERATION"" prompt."
^DIC(9.4,14,22,5.9,"PAH",213,1,36,0)=" 2.  Verify that the text displayed is the correct text for the"
^DIC(9.4,14,22,5.9,"PAH",213,1,37,0)="     procedure selected."
^DIC(9.4,14,22,5.9,"PAH",213,1,38,0)=" 3.  Press ""Enter"" at the ""Selection OK ? YES//"" prompt"
^DIC(9.4,14,22,5.9,"PAH",213,1,39,0)=" 4.  Verify that the ""Select BLOOD COMPONENT REQUEST:"" prompt is "
^DIC(9.4,14,22,5.9,"PAH",213,1,40,0)="displayed."
^DIC(9.4,14,22,5.9,"PAH",213,1,41,0)=" 5.  Enter ""^"" at the ""Select BLOOD COMPONENT REQUEST:"" prompt and ""Enter"""
^DIC(9.4,14,22,5.9,"PAH",213,1,42,0)="     at the ""Select OPERATION:"" prompt to exit."
^DIC(9.4,14,22,5.9,"PAH",213,1,43,0)="  "
^DIC(9.4,14,22,5.9,"PAH",213,1,44,0)="   **EXPECTED OUTCOME:"
^DIC(9.4,14,22,5.9,"PAH",213,1,45,0)="       The correct text is displayed for the procedure selected."
^DIC(9.4,14,22,5.9,"PAH",213,1,46,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,47,0)=" EXCEPTIONAL:"
^DIC(9.4,14,22,5.9,"PAH",213,1,48,0)=" N/A for coding changes made"
^DIC(9.4,14,22,5.9,"PAH",213,1,49,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,50,0)=" BOUNDARY:"
^DIC(9.4,14,22,5.9,"PAH",213,1,51,0)=" This scenario applies to all sites."
^DIC(9.4,14,22,5.9,"PAH",213,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,53,0)=" STRESS:"
^DIC(9.4,14,22,5.9,"PAH",213,1,54,0)=" Repeat this scenario for 3 different procedures."
^DIC(9.4,14,22,5.9,"PAH",213,1,55,0)="---"
^DIC(9.4,14,22,5.9,"PAH",213,1,56,0)="OPTION: (UR-TX) Transfusion follow-up tests  [LRBLTXA]"
^DIC(9.4,14,22,5.9,"PAH",213,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,58,0)=" NORMAL:"
^DIC(9.4,14,22,5.9,"PAH",213,1,59,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,60,0)=" 1.  Enter a valid start date at the ""Start with Date TODAY//"" prompt."
^DIC(9.4,14,22,5.9,"PAH",213,1,61,0)=" 2.  Press ""Enter"" at the ""Go to Date TODAY//"" prompt."
^DIC(9.4,14,22,5.9,"PAH",213,1,62,0)=" 4.  Verify that the descriptive text listed for the ICD 9 codes is "
^DIC(9.4,14,22,5.9,"PAH",213,1,63,0)="accurate."
^DIC(9.4,14,22,5.9,"PAH",213,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,65,0)="  "
^DIC(9.4,14,22,5.9,"PAH",213,1,66,0)="   **EXPECTED OUTCOME:"
^DIC(9.4,14,22,5.9,"PAH",213,1,67,0)="       The correct text is displayed for the ICD 9 code displayed."
^DIC(9.4,14,22,5.9,"PAH",213,1,68,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,69,0)=" EXCEPTIONAL:"
^DIC(9.4,14,22,5.9,"PAH",213,1,70,0)=" N/A for coding changes made"
^DIC(9.4,14,22,5.9,"PAH",213,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,72,0)=" BOUNDARY:"
^DIC(9.4,14,22,5.9,"PAH",213,1,73,0)=" This scenario applies to all sites."
^DIC(9.4,14,22,5.9,"PAH",213,1,74,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,75,0)=" STRESS:"
^DIC(9.4,14,22,5.9,"PAH",213,1,76,0)=" N/A."
^DIC(9.4,14,22,5.9,"PAH",213,1,77,0)="---"
^DIC(9.4,14,22,5.9,"PAH",213,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,79,0)="MINIMAL TEST CASE SCENARIOS BY OPTION, INCLUSIVE OF ALL CONTROL FUNCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",213,1,80,0)="There are no test case scenarios for this patch."
^DIC(9.4,14,22,5.9,"PAH",213,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,83,0)="Description:"
^DIC(9.4,14,22,5.9,"PAH",213,1,84,0)="============"
^DIC(9.4,14,22,5.9,"PAH",213,1,85,0)="1). This patch corrects the following problem which can occur when an "
^DIC(9.4,14,22,5.9,"PAH",213,1,86,0)="Anatomic Pathology (AP) report is released:"
^DIC(9.4,14,22,5.9,"PAH",213,1,87,0)="PROBLEM (HVH-0804-11491/HD0000000070948): When an AP report is released "
^DIC(9.4,14,22,5.9,"PAH",213,1,88,0)="containing 3 sequential characters defined in the BLANK CHARACTER STRING "
^DIC(9.4,14,22,5.9,"PAH",213,1,89,0)="field (#1.06), of the TIU PARAMETERS file (#8925.99), the Text "
^DIC(9.4,14,22,5.9,"PAH",213,1,90,0)="Integration Utility (TIU) electronic signature fails without giving "
^DIC(9.4,14,22,5.9,"PAH",213,1,91,0)="notification to the user.  The AP report is successfully created and "
^DIC(9.4,14,22,5.9,"PAH",213,1,92,0)="stored in TIU, but is marked in TIU as an unsigned document, which in "
^DIC(9.4,14,22,5.9,"PAH",213,1,93,0)="turn, may generate an alert in Computerized Patient Record System (CPRS)."
^DIC(9.4,14,22,5.9,"PAH",213,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,95,0)="RESOLUTION: This patch adds a new parameter to the code that "
^DIC(9.4,14,22,5.9,"PAH",213,1,96,0)="calls the TIU API, NEW^TIUPNAPI. This TIU API is called at the time the "
^DIC(9.4,14,22,5.9,"PAH",213,1,97,0)="AP report is released; it creates and stores the AP report in the TIU "
^DIC(9.4,14,22,5.9,"PAH",213,1,98,0)="DOCUMENT file (#8925)."
^DIC(9.4,14,22,5.9,"PAH",213,1,99,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,100,0)=" Old call: D NEW^TIUPNAPI(.LRTIUPTR,DFN,DUZ,LRNTIME,LRTITLE,,,,DUZ)"
^DIC(9.4,14,22,5.9,"PAH",213,1,101,0)=" New call: "
^DIC(9.4,14,22,5.9,"PAH",213,1,102,0)="D NEW^TIUPNAPI(.LRTIUPTR,DFN,DUZ,LRNTIME,LRTITLE,,,,DUZ,,1)"
^DIC(9.4,14,22,5.9,"PAH",213,1,103,0)="where 1 is the new parameter."
^DIC(9.4,14,22,5.9,"PAH",213,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,105,0)="When the new parameter is set to 1 the following functionality is "
^DIC(9.4,14,22,5.9,"PAH",213,1,106,0)="evoked:"
^DIC(9.4,14,22,5.9,"PAH",213,1,107,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,108,0)="a. Triggers the TIU API to abort creation and storage of the AP "
^DIC(9.4,14,22,5.9,"PAH",213,1,109,0)="Report in TIU if the electronic signature fails. "
^DIC(9.4,14,22,5.9,"PAH",213,1,110,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,111,0)="b. An error message provides detailed information on the aborted "
^DIC(9.4,14,22,5.9,"PAH",213,1,112,0)="storage of the AP Report in TIU when an electronic signature fails.  The "
^DIC(9.4,14,22,5.9,"PAH",213,1,113,0)="error message is:"
^DIC(9.4,14,22,5.9,"PAH",213,1,114,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,115,0)="     *** Report is being processed for storage in TIU.  One moment please."
^DIC(9.4,14,22,5.9,"PAH",213,1,116,0)="***    "
^DIC(9.4,14,22,5.9,"PAH",213,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,118,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,119,0)="    *** Signature in TIU failed. ***"
^DIC(9.4,14,22,5.9,"PAH",213,1,120,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,121,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,122,0)="Possible causes:"
^DIC(9.4,14,22,5.9,"PAH",213,1,123,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,124,0)="1. Report contains 3 sequential characters matching those defined"
^DIC(9.4,14,22,5.9,"PAH",213,1,125,0)="in the BLANK CHARACTER STRING field (#1.06), TIU PARAMETERS file "
^DIC(9.4,14,22,5.9,"PAH",213,1,126,0)="(#8925.99)"
^DIC(9.4,14,22,5.9,"PAH",213,1,127,0)="which are @@@."
^DIC(9.4,14,22,5.9,"PAH",213,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,129,0)="To correct this situation use a data entry option to remove"
^DIC(9.4,14,22,5.9,"PAH",213,1,130,0)="these characters from this report."
^DIC(9.4,14,22,5.9,"PAH",213,1,131,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,132,0)="2.  There is some other TIU document setup problem."
^DIC(9.4,14,22,5.9,"PAH",213,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,134,0)="Report this situation to the Laboratory ADP Coordinator."
^DIC(9.4,14,22,5.9,"PAH",213,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,136,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,137,0)="     *** Report storage in TIU failed. ***"
^DIC(9.4,14,22,5.9,"PAH",213,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,140,0)="2). The patch updates routine: LREPI3 and LREPI5 to point to the correct"
^DIC(9.4,14,22,5.9,"PAH",213,1,141,0)="    ICD9 code for LEGIONNAIRES' DISEASE. Changed from 482.80 to 482.84"
^DIC(9.4,14,22,5.9,"PAH",213,1,142,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,143,0)="3). API Updates:"
^DIC(9.4,14,22,5.9,"PAH",213,1,144,0)="    ------------ "
^DIC(9.4,14,22,5.9,"PAH",213,1,145,0)="    a. The ICD DIAGNOSIS file (#80) has unsupported fields: (#3) DIAGNOSIS"
^DIC(9.4,14,22,5.9,"PAH",213,1,146,0)="       and (#10) DESCRIPTION. The following APIs have been provided"
^DIC(9.4,14,22,5.9,"PAH",213,1,147,0)="       to retrieve these fields:"
^DIC(9.4,14,22,5.9,"PAH",213,1,148,0)="       $$ICDDX^ICDCODE and $$ICDD^ICDCODE."
^DIC(9.4,14,22,5.9,"PAH",213,1,149,0)="       The Lab Service routines affected are as follows:"
^DIC(9.4,14,22,5.9,"PAH",213,1,150,0)="       LR7OB63C, LR7OB63D, LR7OSAP1, LRAPCUM1, LRAPQAT1, LRAPT3, LRAUSICD,"
^DIC(9.4,14,22,5.9,"PAH",213,1,151,0)="       LRBEBA, LRBEBA2, LRBLJPP1, LRBLPC1, LREPI1A, LREPI3, LRSPRPT1,"
^DIC(9.4,14,22,5.9,"PAH",213,1,152,0)="       LRSPSICD and LRPXAPIU."
^DIC(9.4,14,22,5.9,"PAH",213,1,153,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,154,0)="    b. The ICD OPERATION/PROCEDURE file (#80.1) has unsupported fields:"
^DIC(9.4,14,22,5.9,"PAH",213,1,155,0)="       (#4) OPERATION/PROCEDURE and (#10) DESCRIPTION. The following API"
^DIC(9.4,14,22,5.9,"PAH",213,1,156,0)="       has been provided to retrieve these fields:"
^DIC(9.4,14,22,5.9,"PAH",213,1,157,0)="       $$ICDOP^ICDCODE"
^DIC(9.4,14,22,5.9,"PAH",213,1,158,0)="       The Lab Service routines affected are as follows:"
^DIC(9.4,14,22,5.9,"PAH",213,1,159,0)="       LRBLPC1, LRBLJPP1 and LRAPQAT1."
^DIC(9.4,14,22,5.9,"PAH",213,1,160,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,161,0)="    c. The CPT file (#81) has an unsupported field: (#2) SHORT NAME."
^DIC(9.4,14,22,5.9,"PAH",213,1,162,0)="       The following APIs have been provided to retrieve the field:"
^DIC(9.4,14,22,5.9,"PAH",213,1,163,0)="       $$CPT^ICPTCOD and $$CPTD^ICPTCOD."
^DIC(9.4,14,22,5.9,"PAH",213,1,164,0)="       The Lab Service routines affected are as follows:"
^DIC(9.4,14,22,5.9,"PAH",213,1,165,0)="       LRBEECPT, LRBLPCSS and LRBLS."
^DIC(9.4,14,22,5.9,"PAH",213,1,166,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,168,0)="Associated E3R:"
^DIC(9.4,14,22,5.9,"PAH",213,1,169,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",213,1,170,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",213,1,171,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,172,0)="Associated NOIS / Remedy Ticket:"
