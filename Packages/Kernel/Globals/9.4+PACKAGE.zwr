^DIC(9.4,14,22,5.9,"PAH",198,1,293,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,294,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",198,1,295,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",198,1,296,0)="This patch is being distributed in the OR*3.0*243 CPRS v27 build."
^DIC(9.4,14,22,5.9,"PAH",198,1,297,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,298,0)="This patch may be installed with users on the system; however, it should"
^DIC(9.4,14,22,5.9,"PAH",198,1,299,0)="be installed at a non-peak time to minimize disruption to the users."
^DIC(9.4,14,22,5.9,"PAH",198,1,300,0)="Installation of this patch should take less than 1 minute."
^DIC(9.4,14,22,5.9,"PAH",198,1,301,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,302,0)="1.  Use the INSTALL/CHECK MESSAGE option on the PackMan Menu.  "
^DIC(9.4,14,22,5.9,"PAH",198,1,303,0)="  "
^DIC(9.4,14,22,5.9,"PAH",198,1,304,0)="2.  From the Kernel Installation and Distribution System (KIDS) Menu, "
^DIC(9.4,14,22,5.9,"PAH",198,1,305,0)="    select the Installation menu.  "
^DIC(9.4,14,22,5.9,"PAH",198,1,306,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,307,0)="3.  From the Installation menu, you may select to use the following "
^DIC(9.4,14,22,5.9,"PAH",198,1,308,0)="    options (when prompted for INSTALL NAME, enter LR*5.2*365): "
^DIC(9.4,14,22,5.9,"PAH",198,1,309,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,310,0)="    a.  Backup a Transport Global "
^DIC(9.4,14,22,5.9,"PAH",198,1,311,0)="    b.  Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",198,1,312,0)="    c.  Print Transport Global "
^DIC(9.4,14,22,5.9,"PAH",198,1,313,0)="    d.  Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",198,1,314,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,315,0)="4.  Use the Install Package(s) option and select the package LR*5.2*365."
^DIC(9.4,14,22,5.9,"PAH",198,1,316,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,317,0)="5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",198,1,318,0)="    Install? YES//', respond YES.  Responding ""Yes"" to this prompt can"
^DIC(9.4,14,22,5.9,"PAH",198,1,319,0)="    significantly increase install time."
^DIC(9.4,14,22,5.9,"PAH",198,1,320,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,321,0)="6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//',"
^DIC(9.4,14,22,5.9,"PAH",198,1,322,0)="    respond NO."
^DIC(9.4,14,22,5.9,"PAH",198,1,323,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,324,0)="7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,14,22,5.9,"PAH",198,1,325,0)="    Protocols? YES//', respond NO."
^DIC(9.4,14,22,5.9,"PAH",198,1,326,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,327,0)=" Note: Routine LR365 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",198,1,328,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,329,0)="Routine Information:"
^DIC(9.4,14,22,5.9,"PAH",198,1,330,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",198,1,331,0)="The second line of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",198,1,332,0)=" ;;5.2;LAB SERVICE;**[Patch List]**;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",198,1,333,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,334,0)="The checksums below are new checksums, and"
^DIC(9.4,14,22,5.9,"PAH",198,1,335,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,14,22,5.9,"PAH",198,1,336,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,337,0)="Routine Name: LR365"
^DIC(9.4,14,22,5.9,"PAH",198,1,338,0)="    Before:       n/a   After:  B3322693  **365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,339,0)="Routine Name: LR7OSAP2"
^DIC(9.4,14,22,5.9,"PAH",198,1,340,0)="    Before: B59162352   After: B59966352  **230,256,259,317,365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,341,0)="Routine Name: LR7OSAP4"
^DIC(9.4,14,22,5.9,"PAH",198,1,342,0)="    Before:       n/a   After:  B2801060  **365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,343,0)="Routine Name: LRAPALRT"
^DIC(9.4,14,22,5.9,"PAH",198,1,344,0)="    Before:       n/a   After:  B3310137  **365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,345,0)="Routine Name: LRAPDA"
^DIC(9.4,14,22,5.9,"PAH",198,1,346,0)="    Before: B76606340   After: B81540087  "
^DIC(9.4,14,22,5.9,"PAH",198,1,347,0)="**72,73,91,121,248,259,295,317,365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,348,0)="Routine Name: LRAPR"
^DIC(9.4,14,22,5.9,"PAH",198,1,349,0)="    Before: B84430863   After: B88035016  **72,248,259,317,365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,350,0)="Routine Name: LRAPRES1"
^DIC(9.4,14,22,5.9,"PAH",198,1,351,0)="    Before: B43595923   After: B43214564  **259,336,369,365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,352,0)="Routine Name: LRWOMEN"
^DIC(9.4,14,22,5.9,"PAH",198,1,353,0)="    Before:  B1458269   After:  B1173687  **231,248,311,324,365**"
^DIC(9.4,14,22,5.9,"PAH",198,1,354,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,355,0)="Routine list of preceding patches: 317, 324, 369"
^DIC(9.4,14,22,5.9,"PAH",199,0)="384 SEQ #298^3090421.160205^17"
^DIC(9.4,14,22,5.9,"PAH",199,1,0)="^^5^5^3090421"
^DIC(9.4,14,22,5.9,"PAH",199,1,1,0)="This patch is a general purpose lab patch that addresses 2 issues."
^DIC(9.4,14,22,5.9,"PAH",199,1,2,0)="It corrects a formatting issue in the option Search for Criticals"
^DIC(9.4,14,22,5.9,"PAH",199,1,3,0)="(LRSORC).  It also resolves an issue in LR7OSUM1 where 2 identical"
^DIC(9.4,14,22,5.9,"PAH",199,1,4,0)="values are compared and they are evaluated as different because"
^DIC(9.4,14,22,5.9,"PAH",199,1,5,0)="one of the values has a trailing or leading 0."
^DIC(9.4,14,22,5.9,"PAH",200,0)="381 SEQ #299^3090422.12393^17"
^DIC(9.4,14,22,5.9,"PAH",200,1,0)="^^3^3^3090422"
^DIC(9.4,14,22,5.9,"PAH",200,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",200,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",200,1,3,0)="This patch resolves an <UNDEF> scenario in the Short Accession List."
^DIC(9.4,14,22,5.9,"PAH",201,0)="372 SEQ #300^3090422.130444^17"
^DIC(9.4,14,22,5.9,"PAH",201,1,0)="^^5^5^3090422"
^DIC(9.4,14,22,5.9,"PAH",201,1,1,0)="Patch LR*5.2*356 made changes to the way Laboratory Test results are "
^DIC(9.4,14,22,5.9,"PAH",201,1,2,0)="displayed on the Labs Tab of CPRS GUI."
^DIC(9.4,14,22,5.9,"PAH",201,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",201,1,4,0)="This patch will make further modifications to the reports on the Labs Tab "
^DIC(9.4,14,22,5.9,"PAH",201,1,5,0)="and Coversheet of CPRS GUI."
^DIC(9.4,14,22,5.9,"PAH",202,0)="386 SEQ #301^3090422.130455^17"
^DIC(9.4,14,22,5.9,"PAH",202,1,0)="^^8^8^3090422"
^DIC(9.4,14,22,5.9,"PAH",202,1,1,0)="This patch is a VM general purpose lab patch that addresses 3 issues."
^DIC(9.4,14,22,5.9,"PAH",202,1,2,0)="It corrects a problem with the DSS Lab Results Extract whereby results"
^DIC(9.4,14,22,5.9,"PAH",202,1,3,0)="that are greater than 10 characters long cause the record to be omitted"
^DIC(9.4,14,22,5.9,"PAH",202,1,4,0)="from the extract.  It also addresses a merge problem whereby ""ghost"""
^DIC(9.4,14,22,5.9,"PAH",202,1,5,0)="tests are added to a merged patient because of a failure to cleanup"
^DIC(9.4,14,22,5.9,"PAH",202,1,6,0)="after the previous merge attempt.  The third issue that is addressed "
^DIC(9.4,14,22,5.9,"PAH",202,1,7,0)="allows for a result that is supposed to be numeric to be entered with"
^DIC(9.4,14,22,5.9,"PAH",202,1,8,0)="2 decimal points. This should not be allowed."
^DIC(9.4,14,22,5.9,"PAH",203,0)="385^3090422.152306^17"
^DIC(9.4,14,22,5.9,"PAH",204,0)="388 SEQ #303^3090423.105725^17"
^DIC(9.4,14,22,5.9,"PAH",204,1,0)="^^8^8^3090423"
^DIC(9.4,14,22,5.9,"PAH",204,1,1,0)="This patch is a VM general purpose lab patch that addresses 3 issues."
^DIC(9.4,14,22,5.9,"PAH",204,1,2,0)="It corrects a problem with the inability to enter antibiotic "
^DIC(9.4,14,22,5.9,"PAH",204,1,3,0)="concentrations,"
^DIC(9.4,14,22,5.9,"PAH",204,1,4,0)="addresses a problem in file #64.1 (Workload Data) whereby incorrect data"
^DIC(9.4,14,22,5.9,"PAH",204,1,5,0)="gets stored in the file when the order date is different from the "
^DIC(9.4,14,22,5.9,"PAH",204,1,6,0)="collection"
^DIC(9.4,14,22,5.9,"PAH",204,1,7,0)="date, and also addresses a problem whereby the draw time designator of"
^DIC(9.4,14,22,5.9,"PAH",204,1,8,0)="RANDOM is not displayed on the patient report."
^DIC(9.4,14,22,5.9,"PAH",205,0)="352 SEQ #304^3090423.134416^17"
^DIC(9.4,14,22,5.9,"PAH",206,0)="387 SEQ #308^3090609.120202^17"
^DIC(9.4,14,22,5.9,"PAH",206,1,0)="^^179^179^3090609"
^DIC(9.4,14,22,5.9,"PAH",206,1,1,0)="This patch will allow the Computerized Patient Record System (CPRS) to "
^DIC(9.4,14,22,5.9,"PAH",206,1,2,0)="retrieve data for the Cumulative report from the pre-existing VBECS API's."
^DIC(9.4,14,22,5.9,"PAH",206,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,4,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",206,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,6,0)="NEW OPTIONS:"
^DIC(9.4,14,22,5.9,"PAH",206,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,8,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",206,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,10,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",206,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,12,0)="REQUIRED PATCHES:"
^DIC(9.4,14,22,5.9,"PAH",206,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,14,0)="LR*5.2*292"
^DIC(9.4,14,22,5.9,"PAH",206,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,16,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",206,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,18,0)="NEW PROTOCOLS:"
^DIC(9.4,14,22,5.9,"PAH",206,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,20,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",206,1,21,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,22,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",206,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,24,0)="BLOOD BANK CLEARANCE"
^DIC(9.4,14,22,5.9,"PAH",206,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,26,0)="VISTA Laboratory Package patch LR*5.2*387 contains changes to software "
^DIC(9.4,14,22,5.9,"PAH",206,1,27,0)="controlled by VHA DIRECTIVE 2004-058, titled VISTA BLOOD BANK SOFTWARE. "
^DIC(9.4,14,22,5.9,"PAH",206,1,28,0)="Changes include: "
^DIC(9.4,14,22,5.9,"PAH",206,1,29,0)="  Routine: LR7OSBR"
^DIC(9.4,14,22,5.9,"PAH",206,1,30,0)="  Routine: LR7OSBR1"
^DIC(9.4,14,22,5.9,"PAH",206,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,32,0)="All of the above changes have been reviewed by the VISTA Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",206,1,33,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",206,1,34,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",206,1,35,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,36,0)="RISK ANALYSIS: Changes made by patch LR*5.2*387 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",206,1,37,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",206,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,39,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*387 does not "
^DIC(9.4,14,22,5.9,"PAH",206,1,40,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",206,1,41,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",206,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,43,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 2 routines and "
^DIC(9.4,14,22,5.9,"PAH",206,1,44,0)="0 files identified in Veterans Health Administration (VHA) Directive "
^DIC(9.4,14,22,5.9,"PAH",206,1,45,0)="2004-058, group B listing. The changes have no effect on Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",206,1,46,0)="functionality or medical device control functions. There is no adverse "
^DIC(9.4,14,22,5.9,"PAH",206,1,47,0)="potential to sites."
^DIC(9.4,14,22,5.9,"PAH",206,1,48,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,49,0)="VALIDATION REQUIREMENTS BY OPTION: "
^DIC(9.4,14,22,5.9,"PAH",206,1,50,0)="There are no validation requirements or options to be validated."
^DIC(9.4,14,22,5.9,"PAH",206,1,51,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,52,0)="MINIMAL TEST CASE SCENARIOS BY OPTION, INCLUSIVE OF ALL CONTROL FUNCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",206,1,53,0)="There are no validation scenarios necessary with this patch."
^DIC(9.4,14,22,5.9,"PAH",206,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",206,1,55,0)="==========================="
^DIC(9.4,14,22,5.9,"PAH",206,1,56,0)=" "
