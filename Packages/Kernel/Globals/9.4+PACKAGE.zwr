^DIC(9.4,207,22,1,1,224,0)="XINDEX displays the following warning. The Standards And Conventions "
^DIC(9.4,207,22,1,1,225,0)="Committee granted an exemption to allow the use of a star read on May 4th "
^DIC(9.4,207,22,1,1,226,0)="2006."
^DIC(9.4,207,22,1,1,227,0)=" "
^DIC(9.4,207,22,1,1,228,0)="VBECRL   * *  114 Lines,  4099 Bytes, Checksum: B10917646"
^DIC(9.4,207,22,1,1,229,0)="         FOR  READ VBECX#VBECREAD:VBECTO SET TOFLAG=$T DO:VBECFRST CHK "
