^DIC(9.4,100,22,15,"PAH",106,0)="171 SEQ #133^3210422.123256^17"
^DIC(9.4,100,22,15,"PAH",106,1,0)="^^6^6^3210422"
^DIC(9.4,100,22,15,"PAH",106,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,100,22,15,"PAH",106,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",106,1,3,0)="1. If a user elects to produce an XML Export by location, validation is"
^DIC(9.4,100,22,15,"PAH",106,1,4,0)="   not referencing the correct location file."
^DIC(9.4,100,22,15,"PAH",106,1,5,0)="2. The user is not allowed to gracefully exit various prompts by entering "
^DIC(9.4,100,22,15,"PAH",106,1,6,0)="   ""^"" or return."
^DIC(9.4,100,22,15,"PAH",107,0)="158b^3210512"
^DIC(9.4,100,22,15,"PAH",107,1,0)="^^5^5^3210512"
