^DIC(9.4,4,22,1,"PAH",170,0)="200 SEQ #195^3011231^1"
^DIC(9.4,4,22,1,"PAH",170,1,0)="^^204^204^3011231"
^DIC(9.4,4,22,1,"PAH",170,1,1,0)="Patch XM*7.1*200"
^DIC(9.4,4,22,1,"PAH",170,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,3,0)="NOIS PUG-1101-52069"
^DIC(9.4,4,22,1,"PAH",170,1,4,0)="Test Site: Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",170,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,6,0)="When auto-forwarding or filter-forwarding messages, MailMan does not retain"
^DIC(9.4,4,22,1,"PAH",170,1,7,0)="the event chain as well as it should.  This can lead to questions as to how"
^DIC(9.4,4,22,1,"PAH",170,1,8,0)="a message was forwarded.  This patch addresses that problem by making it"
^DIC(9.4,4,22,1,"PAH",170,1,9,0)="clear how messages came to be forwarded."
^DIC(9.4,4,22,1,"PAH",170,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,11,0)="Here are some scenarios:"
^DIC(9.4,4,22,1,"PAH",170,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,13,0)="1. A user has a forwarding address, with no local delivery.  Someone"
^DIC(9.4,4,22,1,"PAH",170,1,14,0)="forwards the user a message, and it gets auto-forwarded.  We can't tell"
^DIC(9.4,4,22,1,"PAH",170,1,15,0)="who forwarded the message to the user.  This is the situation described"
^DIC(9.4,4,22,1,"PAH",170,1,16,0)="in the NOIS.  Here's the QD before the patch:"
^DIC(9.4,4,22,1,"PAH",170,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,18,0)="ANNA.GLYPTA@DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",170,1,19,0)="                   Forwarded by: GLYPTA,ANNA 27 Nov 01 11:11"
^DIC(9.4,4,22,1,"PAH",170,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,21,0)="Here's the QD after the patch:"
^DIC(9.4,4,22,1,"PAH",170,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,23,0)="ANNA.GLYPTA@DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",170,1,24,0)="                   Auto-Forwarded by: GLYPTA,ANNA 27 Nov 01 11:11"
^DIC(9.4,4,22,1,"PAH",170,1,25,0)="                   Forwarded to GLYPTA,ANNA by: OLEUM,LYNN"
^DIC(9.4,4,22,1,"PAH",170,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,27,0)="2. Same scenario as above, but a different forwarder."
^DIC(9.4,4,22,1,"PAH",170,1,28,0)="Here's the QD before the patch:"
^DIC(9.4,4,22,1,"PAH",170,1,29,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,30,0)="ANNA.GLYPTA@DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",170,1,31,0)="                   Forwarded by: GLYPTA,ANNA 27 Nov 01 11:11"
^DIC(9.4,4,22,1,"PAH",170,1,32,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,33,0)="Here's the QD after the patch:"
^DIC(9.4,4,22,1,"PAH",170,1,34,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,35,0)="ANNA.GLYPTA@DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",170,1,36,0)="                   Auto-Forwarded by: GLYPTA,ANNA 27 Nov 01 11:11"
^DIC(9.4,4,22,1,"PAH",170,1,37,0)="                   Filter-Forwarded to GLYPTA,ANNA by: PATCH,USER"
^DIC(9.4,4,22,1,"PAH",170,1,38,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,39,0)="3. This is a simpler scenario.  There's no question as to who forwarded"
^DIC(9.4,4,22,1,"PAH",170,1,40,0)="the message, but we're not sure how.  Here's the QD before the patch:"
^DIC(9.4,4,22,1,"PAH",170,1,41,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,42,0)="GLYPTA,ANNA"
^DIC(9.4,4,22,1,"PAH",170,1,43,0)="                   Forwarded by: PATCH,USER 27 Nov 01 11:11"
^DIC(9.4,4,22,1,"PAH",170,1,44,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,45,0)="Here's the QD after the patch:"
^DIC(9.4,4,22,1,"PAH",170,1,46,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,47,0)="GLYPTA,ANNA"
^DIC(9.4,4,22,1,"PAH",170,1,48,0)="                   Filter-Forwarded by: PATCH,USER 27 Nov 01 11:11"
^DIC(9.4,4,22,1,"PAH",170,1,49,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,50,0)="The API QD^XMXUTIL3 is enhanced to include this new information.  Additional"
^DIC(9.4,4,22,1,"PAH",170,1,51,0)="fields returned under XMTROOT for each recipient:"
^DIC(9.4,4,22,1,"PAH",170,1,52,0)="""FWD TYPE""         (present only if forwarding is not ""regular"")"
^DIC(9.4,4,22,1,"PAH",170,1,53,0)="                   Type of forwarding."
^DIC(9.4,4,22,1,"PAH",170,1,54,0)="                   ""F"" - Filter-Forward"
^DIC(9.4,4,22,1,"PAH",170,1,55,0)="                   ""A"" - Auto-Forward"
^DIC(9.4,4,22,1,"PAH",170,1,56,0)="                   ""R"" - Regular-Forward (default)"
^DIC(9.4,4,22,1,"PAH",170,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,58,0)="""FWD BY ORIG""      (present only if ""FWD TYPE"" is ""A"")"
^DIC(9.4,4,22,1,"PAH",170,1,59,0)="                   Name of the person, possibly followed by, in parentheses,"
^DIC(9.4,4,22,1,"PAH",170,1,60,0)="                   the name of the surrogate of the person, who forwarded"
^DIC(9.4,4,22,1,"PAH",170,1,61,0)="                   the message to the recipient, who had auto-forwarding."
^DIC(9.4,4,22,1,"PAH",170,1,62,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,63,0)="""FWD TYPE ORIG""    (present only if ""FWD TYPE"" is ""A"" and the ""FWD BY ORIG"""
^DIC(9.4,4,22,1,"PAH",170,1,64,0)="                   person filter-forwarded to the recipient.)"
^DIC(9.4,4,22,1,"PAH",170,1,65,0)="                   Type of forwarding, which led to the auto-forwarding."
^DIC(9.4,4,22,1,"PAH",170,1,66,0)="                   ""F"" - Filter-Forward"
^DIC(9.4,4,22,1,"PAH",170,1,67,0)="                   ""R"" - Regular-Forward (default)"
^DIC(9.4,4,22,1,"PAH",170,1,68,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,69,0)="In order to facilitate this, three new fields are added to the recipient"
^DIC(9.4,4,22,1,"PAH",170,1,70,0)="multiple in file 3.9:"
^DIC(9.4,4,22,1,"PAH",170,1,71,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,72,0)="STANDARD DATA DICTIONARY #3.91 -- RECIPIENT SUB-FILE STORED IN ^XMB(3.9,"
^DIC(9.4,4,22,1,"PAH",170,1,73,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,74,0)="DATA       NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",170,1,75,0)="ELEMENT    TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",170,1,76,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",170,1,77,0)="3.91,8.02  FWD TYPE               F;3 SET"
^DIC(9.4,4,22,1,"PAH",170,1,78,0)="                             'F' FOR Filter-Forward;"
^DIC(9.4,4,22,1,"PAH",170,1,79,0)="                             'A' FOR Auto-Forward;"
^DIC(9.4,4,22,1,"PAH",170,1,80,0)="                             'R' FOR Regular-Forward;"
^DIC(9.4,4,22,1,"PAH",170,1,81,0)="           LAST EDITED:      NOV 28, 2001"
^DIC(9.4,4,22,1,"PAH",170,1,82,0)="           HELP-PROMPT:      What kind of forwarding?"
^DIC(9.4,4,22,1,"PAH",170,1,83,0)="           DESCRIPTION:      Regular-Forward - A user simply forwarded this"
^DIC(9.4,4,22,1,"PAH",170,1,84,0)="                             message to the recipient in the .01 field."
^DIC(9.4,4,22,1,"PAH",170,1,85,0)="                             This is the default, if this field is null."
^DIC(9.4,4,22,1,"PAH",170,1,86,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,87,0)="                             Auto-Forward - A user has a forwarding address"
^DIC(9.4,4,22,1,"PAH",170,1,88,0)="                             listing the recipient in the .01 field.  This"
^DIC(9.4,4,22,1,"PAH",170,1,89,0)="                             message was sent to the user and then"
^DIC(9.4,4,22,1,"PAH",170,1,90,0)="                             automatically forwarded to the recipient."
^DIC(9.4,4,22,1,"PAH",170,1,91,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,92,0)="                             Filter-Forward - A user has an active message"
^DIC(9.4,4,22,1,"PAH",170,1,93,0)="                             filter listing the recipient in the .01 field"
^DIC(9.4,4,22,1,"PAH",170,1,94,0)="                             as a ""forward to"" person.  This message was"
^DIC(9.4,4,22,1,"PAH",170,1,95,0)="                             sent to the user and then automatically"
^DIC(9.4,4,22,1,"PAH",170,1,96,0)="                             forwarded to the recipient during message"
^DIC(9.4,4,22,1,"PAH",170,1,97,0)="                             delivery."
^DIC(9.4,4,22,1,"PAH",170,1,98,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,99,0)="3.91,8.03  FWD BY ORIGINAL        F;4 FREE TEXT"
^DIC(9.4,4,22,1,"PAH",170,1,100,0)="           INPUT TRANSFORM:  K:$L(X)>110!($L(X)<1) X"
^DIC(9.4,4,22,1,"PAH",170,1,101,0)="           LAST EDITED:      NOV 28, 2001"
^DIC(9.4,4,22,1,"PAH",170,1,102,0)="           HELP-PROMPT:      Answer must be 1-110 characters in length."
^DIC(9.4,4,22,1,"PAH",170,1,103,0)="           DESCRIPTION:      This field is only used if FWD TYPE is"
^DIC(9.4,4,22,1,"PAH",170,1,104,0)="                             Auto-Forward.  This field lists the original"
^DIC(9.4,4,22,1,"PAH",170,1,105,0)="                             user (and possibly the user's surrogate) who"
^DIC(9.4,4,22,1,"PAH",170,1,106,0)="                             forwarded the message to the user with the"
^DIC(9.4,4,22,1,"PAH",170,1,107,0)="                             forwarding address."
^DIC(9.4,4,22,1,"PAH",170,1,108,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,109,0)="3.91,8.04  FWD TYPE ORIGINAL      F;5 SET"
^DIC(9.4,4,22,1,"PAH",170,1,110,0)="                             'F' FOR Filter-Forward;"
^DIC(9.4,4,22,1,"PAH",170,1,111,0)="                             'R' FOR Regular-Forward;"
^DIC(9.4,4,22,1,"PAH",170,1,112,0)="           LAST EDITED:      NOV 28, 2001"
^DIC(9.4,4,22,1,"PAH",170,1,113,0)="           HELP-PROMPT:      What kind of forwarding, originally?"
^DIC(9.4,4,22,1,"PAH",170,1,114,0)="           DESCRIPTION:      This field is only used if FWD TYPE is"
^DIC(9.4,4,22,1,"PAH",170,1,115,0)="                             Auto-Forward.  This field reveals how the"
^DIC(9.4,4,22,1,"PAH",170,1,116,0)="                             message was forwarded to the user who had the"
^DIC(9.4,4,22,1,"PAH",170,1,117,0)="                             forwarding address listing the recipient in"
^DIC(9.4,4,22,1,"PAH",170,1,118,0)="                             the .01 field."
^DIC(9.4,4,22,1,"PAH",170,1,119,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,120,0)="                             Regular-Forward - A user simply forwarded this"
^DIC(9.4,4,22,1,"PAH",170,1,121,0)="                             message to the user with the forwarding"
^DIC(9.4,4,22,1,"PAH",170,1,122,0)="                             address.  This is the default, if this field"
^DIC(9.4,4,22,1,"PAH",170,1,123,0)="                             is null."
^DIC(9.4,4,22,1,"PAH",170,1,124,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,125,0)="                             Filter-Forward - A user has an active message"
^DIC(9.4,4,22,1,"PAH",170,1,126,0)="                             filter listing the user with the forwarding"
^DIC(9.4,4,22,1,"PAH",170,1,127,0)="                             address as a ""forward to"" person.  This message"
^DIC(9.4,4,22,1,"PAH",170,1,128,0)="                             was sent to the user and then automatically"
^DIC(9.4,4,22,1,"PAH",170,1,129,0)="                             forwarded to the user during message delivery."
^DIC(9.4,4,22,1,"PAH",170,1,130,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,131,0)="                             Note that Auto-Forward is not a possibility,"
^DIC(9.4,4,22,1,"PAH",170,1,132,0)="                             because Auto-Forward is allowed only to remote"
^DIC(9.4,4,22,1,"PAH",170,1,133,0)="                             recipients or to devices or servers."
^DIC(9.4,4,22,1,"PAH",170,1,134,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,135,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",170,1,136,0)="is at a minimum.  It requires MailMan patches XM*7.1*163 & *177."
^DIC(9.4,4,22,1,"PAH",170,1,137,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",170,1,138,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,139,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",170,1,140,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",170,1,141,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",170,1,142,0)=" "
^DIC(9.4,4,22,1,"PAH",170,1,143,0)="           Before       After"
^DIC(9.4,4,22,1,"PAH",170,1,144,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",170,1,145,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",170,1,146,0)="XMJMQ      13062269     14102654     40,57,70,50,96,110,131,172,200"
^DIC(9.4,4,22,1,"PAH",170,1,147,0)="XMKP       16277893     16071912     50,89,119,147,151,200"
^DIC(9.4,4,22,1,"PAH",170,1,148,0)="XMKP1       * NEW *      1811191     200"
^DIC(9.4,4,22,1,"PAH",170,1,149,0)="XMTDT       8336537      8338601     50,142,150,177,200"
^DIC(9.4,4,22,1,"PAH",170,1,150,0)="XMXADDR    15486856     15771323     50,96,101,104,107,131,148,163,200"
^DIC(9.4,4,22,1,"PAH",170,1,151,0)="XMXUTIL4    8751511      9367334     50,96,127,200"
^DIC(9.4,4,22,1,"PAH",170,1,152,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",170,1,153,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,154,0)="This patch introduces the following new routines:"
^DIC(9.4,4,22,1,"PAH",170,1,155,0)="XMKP1 - has no user-callable entry point"
^DIC(9.4,4,22,1,"PAH",170,1,156,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",170,1,157,0)=" "
^DIC(9.4,4,22,1,"PAH",170,1,158,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",170,1,159,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",170,1,160,0)="is at a minimum.  It requires MailMan patches XM*7.1*163 & *177."
^DIC(9.4,4,22,1,"PAH",170,1,161,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",170,1,162,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",170,1,163,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",170,1,164,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",170,1,165,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",170,1,166,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,1,"PAH",170,1,167,0)="    but you should stop the background filer."
^DIC(9.4,4,22,1,"PAH",170,1,168,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",170,1,169,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",170,1,170,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",170,1,171,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",170,1,172,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",170,1,173,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",170,1,174,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",170,1,175,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",170,1,176,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",170,1,177,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",170,1,178,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",170,1,179,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",170,1,180,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",170,1,181,0)=" Select INSTALL NAME:    XM*7.1*200    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",170,1,182,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",170,1,183,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",170,1,184,0)=" Incoming Files:"
^DIC(9.4,4,22,1,"PAH",170,1,185,0)="   3.9       MESSAGE  (Partial Definition)"
^DIC(9.4,4,22,1,"PAH",170,1,186,0)=" Note:  You already have the 'MESSAGE' File."
^DIC(9.4,4,22,1,"PAH",170,1,187,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,188,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",170,1,189,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",170,1,190,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",170,1,191,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",170,1,192,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",170,1,193,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",170,1,194,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",170,1,195,0)=""
^DIC(9.4,4,22,1,"PAH",170,1,196,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",170,1,197,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",170,1,198,0)="6.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",170,1,199,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",170,1,200,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",170,1,201,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",170,1,202,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",170,1,203,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",170,1,204,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",171,0)="201 SEQ #196^3020116^1"
^DIC(9.4,4,22,1,"PAH",171,1,0)="^^72^72^3020116"
^DIC(9.4,4,22,1,"PAH",171,1,1,0)="Patch XM*7.1*201"
^DIC(9.4,4,22,1,"PAH",171,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,3,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",171,1,4,0)="Test Site: Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",171,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,6,0)="If the Postmaster goes into one of the baskets of messages waiting to be"
^DIC(9.4,4,22,1,"PAH",171,1,7,0)="transmitted to a remote site, and does a query to find a particular set of"
^DIC(9.4,4,22,1,"PAH",171,1,8,0)="messages, and then tries to toggle the transmission priority on some of"
^DIC(9.4,4,22,1,"PAH",171,1,9,0)="them, MailMan will abort.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",171,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,11,0)="If you reply to a scrambled message while reading new messages, and hit"
^DIC(9.4,4,22,1,"PAH",171,1,12,0)="'transmit', MailMan informs you that it is ""scrambling..."" your reply."
^DIC(9.4,4,22,1,"PAH",171,1,13,0)="If you reply to a scrambled message while reading existing messages in a"
^DIC(9.4,4,22,1,"PAH",171,1,14,0)="basket, and hit 'transmit', MailMan fails to inform you that it is"
^DIC(9.4,4,22,1,"PAH",171,1,15,0)="""scrambling..."" your reply. This patch fixes that. "
^DIC(9.4,4,22,1,"PAH",171,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,17,0)="If an address to a remote, non-MailMan site has blanks in it (but no commas),"
^DIC(9.4,4,22,1,"PAH",171,1,18,0)="the blanks should be translated to underscores, but aren't.  This patch fixes"
^DIC(9.4,4,22,1,"PAH",171,1,19,0)="that."
^DIC(9.4,4,22,1,"PAH",171,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,21,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",171,1,22,0)="minimum.  It requires MailMan patch XM*7.1*196 and *199."
^DIC(9.4,4,22,1,"PAH",171,1,23,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",171,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,25,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",171,1,26,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",171,1,27,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",171,1,28,0)=" "
^DIC(9.4,4,22,1,"PAH",171,1,29,0)="           Before     After"
^DIC(9.4,4,22,1,"PAH",171,1,30,0)="Name       Checksum   Checksum   Patch List"
^DIC(9.4,4,22,1,"PAH",171,1,31,0)="-----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",171,1,32,0)="XMJMLN     14755647   14794710   50,110,131,201"
^DIC(9.4,4,22,1,"PAH",171,1,33,0)="XMJMRO      5040542    5049970   50,89,110,127,172,196,201"
^DIC(9.4,4,22,1,"PAH",171,1,34,0)="XMSMAIL     4045228    4109319   59,50,107,176,173,194,199,201"
^DIC(9.4,4,22,1,"PAH",171,1,35,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",171,1,36,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,37,0)="This patch introduces no new routines:"
^DIC(9.4,4,22,1,"PAH",171,1,38,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",171,1,39,0)=" "
^DIC(9.4,4,22,1,"PAH",171,1,40,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",171,1,41,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",171,1,42,0)="minimum.  It requires MailMan patch XM*7.1*196 and *199."
^DIC(9.4,4,22,1,"PAH",171,1,43,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",171,1,44,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",171,1,45,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",171,1,46,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",171,1,47,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",171,1,48,0)="4.  Users may be on the system.  You do not need to stop TaskMan or the"
^DIC(9.4,4,22,1,"PAH",171,1,49,0)="    background filer."
^DIC(9.4,4,22,1,"PAH",171,1,50,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",171,1,51,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",171,1,52,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",171,1,53,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",171,1,54,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",171,1,55,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",171,1,56,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",171,1,57,0)=" Select INSTALL NAME:    XM*7.1*201     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",171,1,58,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",171,1,59,0)=" Install Questions for XM*7.1*201"
^DIC(9.4,4,22,1,"PAH",171,1,60,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,61,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",171,1,62,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",171,1,63,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",171,1,64,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",171,1,65,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",171,1,66,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",171,1,67,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",171,1,68,0)=""
^DIC(9.4,4,22,1,"PAH",171,1,69,0)=" DEVICE: HOME// <You may queue it, if you wish>"
^DIC(9.4,4,22,1,"PAH",171,1,70,0)="                -------------------------------"
^DIC(9.4,4,22,1,"PAH",171,1,71,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",171,1,72,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",172,0)="198 SEQ #197^3020116^1"
^DIC(9.4,4,22,1,"PAH",172,1,0)="^^124^124^3020116"
^DIC(9.4,4,22,1,"PAH",172,1,1,0)="         * * * * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,4,22,1,"PAH",172,1,2,0)="                           ATTENTION!"
^DIC(9.4,4,22,1,"PAH",172,1,3,0)="              After installing this patch, please"
^DIC(9.4,4,22,1,"PAH",172,1,4,0)="           Review the Install File Print for errors."
^DIC(9.4,4,22,1,"PAH",172,1,5,0)="         See the Installation Instructions for details."
^DIC(9.4,4,22,1,"PAH",172,1,6,0)="         * * * * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,4,22,1,"PAH",172,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,8,0)="Patch XM*7.1*198"
^DIC(9.4,4,22,1,"PAH",172,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,10,0)="Test Sites:  Montana HCS; Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",172,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,12,0)="NOIS: none; E3R: none"
^DIC(9.4,4,22,1,"PAH",172,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,14,0)="Patch XM*7.1*51, released May 2001, ensured that every VHA site had"
^DIC(9.4,4,22,1,"PAH",172,1,15,0)="a "".DOMAIN.EXT"" synonym in the DOMAIN file.  It also added new names as"
^DIC(9.4,4,22,1,"PAH",172,1,16,0)="synonyms for sites which requested name changes because of mergers, or"
^DIC(9.4,4,22,1,"PAH",172,1,17,0)="otherwise, and had name changes approved. "
^DIC(9.4,4,22,1,"PAH",172,1,18,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,19,0)="This patch will complete the 2-step domain name change process begun in"
^DIC(9.4,4,22,1,"PAH",172,1,20,0)="patch XM*7.1*51. The synonyms will become the new domain names, and the"
^DIC(9.4,4,22,1,"PAH",172,1,21,0)="old domain names will become the synonyms.  The domain names will be"
^DIC(9.4,4,22,1,"PAH",172,1,22,0)="changed in the transmission scripts.  The names of the transmission queues"
^DIC(9.4,4,22,1,"PAH",172,1,23,0)="will be changed.  (These are the Postmaster's baskets where the messages"
^DIC(9.4,4,22,1,"PAH",172,1,24,0)="waiting to be transmitted are kept.)  And finally, the domain name of the"
^DIC(9.4,4,22,1,"PAH",172,1,25,0)="site will be changed, too, if it is one of the sites which requested it. "
^DIC(9.4,4,22,1,"PAH",172,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,27,0)="This will all happen automatically, during the post-init.  It should take"
^DIC(9.4,4,22,1,"PAH",172,1,28,0)="less than 5 minutes.  You will be instructed to review the install file print"
^DIC(9.4,4,22,1,"PAH",172,1,29,0)="to check for and correct any errors after the patch has been installed. "
^DIC(9.4,4,22,1,"PAH",172,1,30,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,31,0)="The domain name changes will not adversely affect the flow of mail."
^DIC(9.4,4,22,1,"PAH",172,1,32,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,33,0)="This patch will also begin the 2-step domain name change process for the"
^DIC(9.4,4,22,1,"PAH",172,1,34,0)="next round of domain name changes.  It will add as synonyms the desired"
^DIC(9.4,4,22,1,"PAH",172,1,35,0)="new names for sites which requested it.  A future patch will complete the"
^DIC(9.4,4,22,1,"PAH",172,1,36,0)="domain name change process, once all sites have installed this patch."
^DIC(9.4,4,22,1,"PAH",172,1,37,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,38,0)="NOTE: This patch requires MailMan patch XM*7.1*51."
^DIC(9.4,4,22,1,"PAH",172,1,39,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",172,1,40,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,41,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",172,1,42,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",172,1,43,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",172,1,44,0)=" "
^DIC(9.4,4,22,1,"PAH",172,1,45,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",172,1,46,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",172,1,47,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",172,1,48,0)="XMUDNC        13102674        14015749        50,51,198"
^DIC(9.4,4,22,1,"PAH",172,1,49,0)="XMYPOSTA       4556859         3414561        50,51,198"
^DIC(9.4,4,22,1,"PAH",172,1,50,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",172,1,51,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",172,1,52,0)=" "
^DIC(9.4,4,22,1,"PAH",172,1,53,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",172,1,54,0)="NOTE: This patch requires MailMan patch XM*7.1*51."
^DIC(9.4,4,22,1,"PAH",172,1,55,0)="1.  Users should not be on the system during patch installation."
^DIC(9.4,4,22,1,"PAH",172,1,56,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",172,1,57,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",172,1,58,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",172,1,59,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",172,1,60,0)="4.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",172,1,61,0)="    option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",172,1,62,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",172,1,63,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",172,1,64,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",172,1,65,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",172,1,66,0)="5.  Place TaskMan in a WAIT State.  Shut down the listeners."
^DIC(9.4,4,22,1,"PAH",172,1,67,0)="    You may also wish to shut down HL7 filers/LLP's and other background"
^DIC(9.4,4,22,1,"PAH",172,1,68,0)="    tasks which may attempt to create new messages.  During the installation"
^DIC(9.4,4,22,1,"PAH",172,1,69,0)="    of this patch, we do not want any messages coming in or going out."
^DIC(9.4,4,22,1,"PAH",172,1,70,0)="    Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",172,1,71,0)="6.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",172,1,72,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",172,1,73,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",172,1,74,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",172,1,75,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",172,1,76,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",172,1,77,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",172,1,78,0)=" Select INSTALL NAME:    XM*7.1*198     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",172,1,79,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",172,1,80,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",172,1,81,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// YES"
^DIC(9.4,4,22,1,"PAH",172,1,82,0)="                                                       ==="
^DIC(9.4,4,22,1,"PAH",172,1,83,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// YES"
^DIC(9.4,4,22,1,"PAH",172,1,84,0)="                                                                       ==="
^DIC(9.4,4,22,1,"PAH",172,1,85,0)=" Enter options you wish to mark as 'Out Of Order': XMUSER       MailMan Menu"
^DIC(9.4,4,22,1,"PAH",172,1,86,0)="                                                   ======"
^DIC(9.4,4,22,1,"PAH",172,1,87,0)=" Enter options you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",172,1,88,0)="                                                   =============="
^DIC(9.4,4,22,1,"PAH",172,1,89,0)=" Enter protocols you wish to mark as 'Out Of Order': <press return>"
^DIC(9.4,4,22,1,"PAH",172,1,90,0)="                                                     =============="
^DIC(9.4,4,22,1,"PAH",172,1,91,0)=" Delay Install (Minutes):  (0-60): 0// <press return>"
^DIC(9.4,4,22,1,"PAH",172,1,92,0)="                                       =============="
^DIC(9.4,4,22,1,"PAH",172,1,93,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",172,1,94,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",172,1,95,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",172,1,96,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,97,0)=" DEVICE: HOME// <Do not queue this.>"
^DIC(9.4,4,22,1,"PAH",172,1,98,0)="                --------------------"
^DIC(9.4,4,22,1,"PAH",172,1,99,0)="7.  Remove TaskMan from a WAIT State.  If you shut down HL7 filers/LLP's"
^DIC(9.4,4,22,1,"PAH",172,1,100,0)="    and other background tasks in step 4, be sure to restart them, too."
^DIC(9.4,4,22,1,"PAH",172,1,101,0)="8.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",172,1,102,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",172,1,103,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",172,1,104,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",172,1,105,0)="9.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",172,1,106,0)="10. On the KIDS:Utilites menu, use the following option to review the"
^DIC(9.4,4,22,1,"PAH",172,1,107,0)="install:"
^DIC(9.4,4,22,1,"PAH",172,1,108,0)="    Install File Print"
^DIC(9.4,4,22,1,"PAH",172,1,109,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,110,0)="Review the automatic synonym additions which occurred during the PRE-INIT."
^DIC(9.4,4,22,1,"PAH",172,1,111,0)="If there were any errors noted for a particular domain, that domain did not"
^DIC(9.4,4,22,1,"PAH",172,1,112,0)="have its new name added as a synonym.  (Error messages are preceded by ***,"
^DIC(9.4,4,22,1,"PAH",172,1,113,0)="and tell you what was wrong.)  You must correct the error manually and add"
^DIC(9.4,4,22,1,"PAH",172,1,114,0)="the synonym manually.  Remember, you are not to change any domain name."
^DIC(9.4,4,22,1,"PAH",172,1,115,0)="Just add the new name as a synonym. "
^DIC(9.4,4,22,1,"PAH",172,1,116,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,117,0)="Review the automatic domain name changes which occurred during the POST-INIT."
^DIC(9.4,4,22,1,"PAH",172,1,118,0)="If there were any errors noted for a particular domain, that domain did not"
^DIC(9.4,4,22,1,"PAH",172,1,119,0)="have its name changed.  (Error messages are preceded by ***,"
^DIC(9.4,4,22,1,"PAH",172,1,120,0)="and tell you what was wrong.)  You must correct the error manually and"
^DIC(9.4,4,22,1,"PAH",172,1,121,0)="perform the name change manually."
^DIC(9.4,4,22,1,"PAH",172,1,122,0)=""
^DIC(9.4,4,22,1,"PAH",172,1,123,0)="If you have questions or need any help, please enter a NOIS."
^DIC(9.4,4,22,1,"PAH",172,1,124,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",173,0)="202 SEQ #198^3020204^1"
^DIC(9.4,4,22,1,"PAH",173,1,0)="^^70^70^3020204"
^DIC(9.4,4,22,1,"PAH",173,1,1,0)="Patch XM*7.1*202"
^DIC(9.4,4,22,1,"PAH",173,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,3,0)="NOIS: LAS-0102-62116"
^DIC(9.4,4,22,1,"PAH",173,1,4,0)="Test Site: Las Vegas, NV; Puget Sound HCS; FORUM"
^DIC(9.4,4,22,1,"PAH",173,1,5,0)="If a site has its own domain closed (FLAGS=C) in the Domain file 4.2,"
^DIC(9.4,4,22,1,"PAH",173,1,6,0)="MailMan will accept mail addressed to the site by its name, but reject"
^DIC(9.4,4,22,1,"PAH",173,1,7,0)="mail addressed to the site by any of its synonyms.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",173,1,8,0)="The mail is now accepted, regardless of whether it's addressed using the"
^DIC(9.4,4,22,1,"PAH",173,1,9,0)="site name or synonym, or the value of the FLAGS field."
^DIC(9.4,4,22,1,"PAH",173,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,11,0)="E3R: 15051, 16001"
^DIC(9.4,4,22,1,"PAH",173,1,12,0)="Test Site: Puget Sound HCS; FORUM"
^DIC(9.4,4,22,1,"PAH",173,1,13,0)="Currently, when displaying a list of messages using the Summary message"
^DIC(9.4,4,22,1,"PAH",173,1,14,0)="display, the number of characters allotted to the subject is the same as"
^DIC(9.4,4,22,1,"PAH",173,1,15,0)="the number of characters allotted to the sender.  This patch changes that"
^DIC(9.4,4,22,1,"PAH",173,1,16,0)="ratio.  Now twice as many characters are allotted to the subject as are"
^DIC(9.4,4,22,1,"PAH",173,1,17,0)="allotted to the sender.  This is the same ratio as has always been used"
^DIC(9.4,4,22,1,"PAH",173,1,18,0)="in the Detail message display."
^DIC(9.4,4,22,1,"PAH",173,1,19,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,20,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",173,1,21,0)="minimum.  It requires MailMan patch XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",173,1,22,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",173,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,24,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",173,1,25,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",173,1,26,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",173,1,27,0)=" "
^DIC(9.4,4,22,1,"PAH",173,1,28,0)="           Before     After"
^DIC(9.4,4,22,1,"PAH",173,1,29,0)="Name       Checksum   Checksum   Patch List"
^DIC(9.4,4,22,1,"PAH",173,1,30,0)="-----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",173,1,31,0)="XMJML      11937833   11875758   50,131,202"
^DIC(9.4,4,22,1,"PAH",173,1,32,0)="XMXADDRD    9985665    9903650   50,104,107,148,202"
^DIC(9.4,4,22,1,"PAH",173,1,33,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",173,1,34,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,35,0)="This patch introduces no new routines:"
^DIC(9.4,4,22,1,"PAH",173,1,36,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",173,1,37,0)=" "
^DIC(9.4,4,22,1,"PAH",173,1,38,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",173,1,39,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",173,1,40,0)="minimum.  It requires MailMan patch XM*7.1*148."
^DIC(9.4,4,22,1,"PAH",173,1,41,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",173,1,42,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",173,1,43,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",173,1,44,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",173,1,45,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",173,1,46,0)="4.  Users may be on the system.  You do not need to stop TaskMan or the"
^DIC(9.4,4,22,1,"PAH",173,1,47,0)="    background filer."
^DIC(9.4,4,22,1,"PAH",173,1,48,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",173,1,49,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",173,1,50,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",173,1,51,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",173,1,52,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",173,1,53,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",173,1,54,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",173,1,55,0)=" Select INSTALL NAME:    XM*7.1*202     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",173,1,56,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",173,1,57,0)=" Install Questions for XM*7.1*202"
^DIC(9.4,4,22,1,"PAH",173,1,58,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,59,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",173,1,60,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",173,1,61,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",173,1,62,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",173,1,63,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",173,1,64,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",173,1,65,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",173,1,66,0)=""
^DIC(9.4,4,22,1,"PAH",173,1,67,0)=" DEVICE: HOME// <You may queue it, if you wish>"
^DIC(9.4,4,22,1,"PAH",173,1,68,0)="                -------------------------------"
^DIC(9.4,4,22,1,"PAH",173,1,69,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",173,1,70,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",174,0)="203 SEQ #199^3020315^1"
^DIC(9.4,4,22,1,"PAH",174,1,0)="^^69^69^3020315"
^DIC(9.4,4,22,1,"PAH",174,1,1,0)="Patch XM*7.1*203"
^DIC(9.4,4,22,1,"PAH",174,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,3,0)="NOIS: DAY-0202-42705"
^DIC(9.4,4,22,1,"PAH",174,1,4,0)="Test Site: Dayton, OH"
^DIC(9.4,4,22,1,"PAH",174,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,6,0)="If MailMan detects a control character in a routine when creating a PackMan"
^DIC(9.4,4,22,1,"PAH",174,1,7,0)="message, it aborts with a ""level"" error.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",174,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,9,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",174,1,10,0)="Test Site: FORUM"
^DIC(9.4,4,22,1,"PAH",174,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,12,0)="If a message in a remote transmit queue has already transmitted, but for"
^DIC(9.4,4,22,1,"PAH",174,1,13,0)="whatever reason is stuck in the queue, it holds up all the rest of the"
^DIC(9.4,4,22,1,"PAH",174,1,14,0)="messages in the queue.  Manual intervention is required to delete the"
^DIC(9.4,4,22,1,"PAH",174,1,15,0)="message from the queue.  This patch fixes that.  Such a message is now"
^DIC(9.4,4,22,1,"PAH",174,1,16,0)="automatically deleted from the queue."
^DIC(9.4,4,22,1,"PAH",174,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,18,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",174,1,19,0)="minimum.  It requires MailMan patches XM*7.1*175 & *201."
^DIC(9.4,4,22,1,"PAH",174,1,20,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",174,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,22,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",174,1,23,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",174,1,24,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",174,1,25,0)=" "
^DIC(9.4,4,22,1,"PAH",174,1,26,0)="           Before     After"
^DIC(9.4,4,22,1,"PAH",174,1,27,0)="Name       Checksum   Checksum   Patch List"
^DIC(9.4,4,22,1,"PAH",174,1,28,0)="----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",174,1,29,0)="XMPH        4915924    4952939   34,50,175,203"
^DIC(9.4,4,22,1,"PAH",174,1,30,0)="XMR1A       3017305    3080398   13,36,50,203"
^DIC(9.4,4,22,1,"PAH",174,1,31,0)="XMSMAIL     4109319    4164879   59,50,107,176,173,194,199,201,203"
^DIC(9.4,4,22,1,"PAH",174,1,32,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",174,1,33,0)=""
^DIC(9.4,4,22,1,"PAH",174,1,34,0)="This patch introduces no new routines:"
^DIC(9.4,4,22,1,"PAH",174,1,35,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",174,1,36,0)=" "
^DIC(9.4,4,22,1,"PAH",174,1,37,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",174,1,38,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",174,1,39,0)="minimum.  It requires MailMan patches XM*7.1*175 & *201."
^DIC(9.4,4,22,1,"PAH",174,1,40,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",174,1,41,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",174,1,42,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",174,1,43,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",174,1,44,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",174,1,45,0)="4.  Users may be on the system.  You do not need to stop TaskMan or the"
^DIC(9.4,4,22,1,"PAH",174,1,46,0)="    background filer."
^DIC(9.4,4,22,1,"PAH",174,1,47,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",174,1,48,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",174,1,49,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",174,1,50,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",174,1,51,0)="       Compare Transport Global to Current System"
