^DIC(9.4,85,22,1.5,"PAH",13,0)="38 SEQ #35^3020906^1"
^DIC(9.4,85,22,1.5,"PAH",13,1,0)="^^60^60^3020906"
^DIC(9.4,85,22,1.5,"PAH",13,1,1,0)="Patch VAQ*1.5*38"
^DIC(9.4,85,22,1.5,"PAH",13,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",13,1,3,0)="NOIS MAD-1001-42696"
^DIC(9.4,85,22,1.5,"PAH",13,1,4,0)="Test Sites: Madison, WI; Milwaukee, WI; Tomah, WI; Iron Mountain, MI"
^DIC(9.4,85,22,1.5,"PAH",13,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",13,1,6,0)="If a veteran declines to give income information, PDX should display the"
^DIC(9.4,85,22,1.5,"PAH",13,1,7,0)="means test as CAT C.  Instead, PDX may display it as CAT A.  This patch"
^DIC(9.4,85,22,1.5,"PAH",13,1,8,0)="fixes that."
^DIC(9.4,85,22,1.5,"PAH",13,1,9,0)=""
^DIC(9.4,85,22,1.5,"PAH",13,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",13,1,11,0)="is at a minimum.  It has no patch prerequisite."
^DIC(9.4,85,22,1.5,"PAH",13,1,12,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",13,1,13,0)=" "
^DIC(9.4,85,22,1.5,"PAH",13,1,14,0)="ROUTINES:"
^DIC(9.4,85,22,1.5,"PAH",13,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,85,22,1.5,"PAH",13,1,16,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",13,1,17,0)=" "
^DIC(9.4,85,22,1.5,"PAH",13,1,18,0)="             Before        After"
^DIC(9.4,85,22,1.5,"PAH",13,1,19,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,85,22,1.5,"PAH",13,1,20,0)="-----------------------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",13,1,21,0)="VAQDBIM     4078867      4144431     38"
^DIC(9.4,85,22,1.5,"PAH",13,1,22,0)="VAQDBIM4    3774719      4191649     38"
