^DIC(9.4,3,22,21,"PAH",107,1,80,0)="List of preceding patches: 1, 69, 78, 88, 94, 104, 107, 112"
^DIC(9.4,3,22,21,"PAH",107,1,81,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",107,1,82,0)=""
^DIC(9.4,3,22,21,"PAH",107,1,83,0)="Be sure to follow step 11 below."
^DIC(9.4,3,22,21,"PAH",107,1,84,0)=""
^DIC(9.4,3,22,21,"PAH",107,1,85,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",107,1,86,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",107,1,87,0)=""
^DIC(9.4,3,22,21,"PAH",107,1,88,0)="Users can remain on the system"
^DIC(9.4,3,22,21,"PAH",107,1,89,0)=""
^DIC(9.4,3,22,21,"PAH",107,1,90,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",107,1,91,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",107,1,92,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,93,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",107,1,94,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",107,1,95,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,96,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",107,1,97,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",107,1,98,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",107,1,99,0)="      options:"
^DIC(9.4,3,22,21,"PAH",107,1,100,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,101,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",107,1,102,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",107,1,103,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",107,1,104,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",107,1,105,0)="         "
^DIC(9.4,3,22,21,"PAH",107,1,106,0)=" 4.  Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",107,1,107,0)="      Stop TASKMAN, and have submanagers stop."
^DIC(9.4,3,22,21,"PAH",107,1,108,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,109,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,110,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",107,1,111,0)="      option:"
^DIC(9.4,3,22,21,"PAH",107,1,112,0)="         Install Package(s)  'XU*8.0*118'"
^DIC(9.4,3,22,21,"PAH",107,1,113,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",107,1,114,0)="                              "
^DIC(9.4,3,22,21,"PAH",107,1,115,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",107,1,116,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",107,1,117,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",107,1,118,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,119,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",107,1,120,0)="      OpenM Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",107,1,121,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",107,1,122,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",107,1,123,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,124,0)="ZIS2"
^DIC(9.4,3,22,21,"PAH",107,1,125,0)="ZIS6"
^DIC(9.4,3,22,21,"PAH",107,1,126,0)="ZISTCP"
^DIC(9.4,3,22,21,"PAH",107,1,127,0)="ZISTCPS"
^DIC(9.4,3,22,21,"PAH",107,1,128,0)="ZISUTL"
^DIC(9.4,3,22,21,"PAH",107,1,129,0)="ZOSVMSM"
^DIC(9.4,3,22,21,"PAH",107,1,130,0)="ZOSVONT"
^DIC(9.4,3,22,21,"PAH",107,1,131,0)="ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",107,1,132,0)="ZTLOAD"
^DIC(9.4,3,22,21,"PAH",107,1,133,0)="ZTLOAD1"
^DIC(9.4,3,22,21,"PAH",107,1,134,0)="ZTLOAD2"
^DIC(9.4,3,22,21,"PAH",107,1,135,0)="ZTER"
^DIC(9.4,3,22,21,"PAH",107,1,136,0)="ZTM"
^DIC(9.4,3,22,21,"PAH",107,1,137,0)="ZTM0"
^DIC(9.4,3,22,21,"PAH",107,1,138,0)="ZTM1"
^DIC(9.4,3,22,21,"PAH",107,1,139,0)="ZTM2"
^DIC(9.4,3,22,21,"PAH",107,1,140,0)="ZTM4"
^DIC(9.4,3,22,21,"PAH",107,1,141,0)="ZTM5"
^DIC(9.4,3,22,21,"PAH",107,1,142,0)="ZTM6"
^DIC(9.4,3,22,21,"PAH",107,1,143,0)="ZTMKU"
^DIC(9.4,3,22,21,"PAH",107,1,144,0)="ZTMON"
^DIC(9.4,3,22,21,"PAH",107,1,145,0)="ZTMON1"
^DIC(9.4,3,22,21,"PAH",107,1,146,0)="ZTMS"
^DIC(9.4,3,22,21,"PAH",107,1,147,0)="ZTMS0"
^DIC(9.4,3,22,21,"PAH",107,1,148,0)="ZTMS1"
^DIC(9.4,3,22,21,"PAH",107,1,149,0)="ZTMS2"
^DIC(9.4,3,22,21,"PAH",107,1,150,0)="ZTMS3"
^DIC(9.4,3,22,21,"PAH",107,1,151,0)="ZTMS7"
^DIC(9.4,3,22,21,"PAH",107,1,152,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,153,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",107,1,154,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",107,1,155,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",107,1,156,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",107,1,157,0)="      Patch number to load: 118"
^DIC(9.4,3,22,21,"PAH",107,1,158,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",107,1,159,0)="       "
^DIC(9.4,3,22,21,"PAH",107,1,160,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",107,1,161,0)=" "
^DIC(9.4,3,22,21,"PAH",107,1,162,0)=" 11.  In the production account, You will need to edit file 14.7"
^DIC(9.4,3,22,21,"PAH",107,1,163,0)="      first DO ^ZTMCHK and from the second screen look for"
^DIC(9.4,3,22,21,"PAH",107,1,164,0)="      ""Cpu-volume Pair:  ROU:APP1""."
^DIC(9.4,3,22,21,"PAH",107,1,165,0)="      Edit file 14.7 and change the name from ROU to ROU:APP1"
^DIC(9.4,3,22,21,"PAH",107,1,166,0)="      then add a new entry ROU:APP3.  The ROU is the volume set name you"
^DIC(9.4,3,22,21,"PAH",107,1,167,0)="      gave the system and the APP1 should be your Cache configuration "
^DIC(9.4,3,22,21,"PAH",107,1,168,0)="      name.  The Avanti team will provide more info on setting up for"
^DIC(9.4,3,22,21,"PAH",107,1,169,0)="      running dual taskman nodes."
^DIC(9.4,3,22,21,"PAH",107,1,170,0)="      "
^DIC(9.4,3,22,21,"PAH",107,1,171,0)=" 12.  Restart TASKMAN with D RESTART^ZTMB.  DSM sites this may require"
^DIC(9.4,3,22,21,"PAH",107,1,172,0)="      a privileged user."
^DIC(9.4,3,22,21,"PAH",107,1,173,0)=""
^DIC(9.4,3,22,21,"PAH",107,1,174,0)=""
^DIC(9.4,3,22,21,"PAH",107,1,175,0)="=========================================================================="
^DIC(9.4,3,22,21,"PAH",108,0)="120 SEQ #113^2991003^1"
^DIC(9.4,3,22,21,"PAH",108,1,0)="^^106^106^2991003"
^DIC(9.4,3,22,21,"PAH",108,1,1,0)="ISF-0699-00000 XTER1A   The fix to XTER1A for working with Mailman patch"
^DIC(9.4,3,22,21,"PAH",108,1,2,0)="TAM-0899-30289          XM*7.1*50 broke printing.  Fixed."
^DIC(9.4,3,22,21,"PAH",108,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,4,0)="MON-0599-52241 XUTMRP   Under some conditions the Taskman Repoint Waiting"
^DIC(9.4,3,22,21,"PAH",108,1,5,0)="TAM-0499-30489 XUTMRP1  Task would error out. Also some of the prompts were"
^DIC(9.4,3,22,21,"PAH",108,1,6,0)="MON-0599-52241          not meaningful, Fixed."
^DIC(9.4,3,22,21,"PAH",108,1,7,0)="               "
^DIC(9.4,3,22,21,"PAH",108,1,8,0)="HARDHATS       XUTMDEVQ A request to be able to return ZTSK. Added a 5th"
^DIC(9.4,3,22,21,"PAH",108,1,9,0)="                        parameter to stop the newing of ZTSK."
^DIC(9.4,3,22,21,"PAH",108,1,10,0)="                        If the 5th parameter is missing or 0 then it will"
^DIC(9.4,3,22,21,"PAH",108,1,11,0)="                        work as before, a 1 will prevent ZTSK from being newed."
^DIC(9.4,3,22,21,"PAH",108,1,12,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,13,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,14,0)="FAV-0499-70417 ZTEDIT*  If the user has the screenman editor as default then"
^DIC(9.4,3,22,21,"PAH",108,1,15,0)="                        they get a UNDEF error.  Fixed."
^DIC(9.4,3,22,21,"PAH",108,1,16,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,17,0)="WPB-0599-32576          The New Person file doesn't have a New User Bulletin."
^DIC(9.4,3,22,21,"PAH",108,1,18,0)="STX-0599-72647          Added it back in."
^DIC(9.4,3,22,21,"PAH",108,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,20,0)="               XLFSTR   Updated function call "
^DIC(9.4,3,22,21,"PAH",108,1,21,0)="                        $$TRIM^XLFSTR(x[,""[L][R]""][,char])."
^DIC(9.4,3,22,21,"PAH",108,1,22,0)="                        This call will trim spaces or other char from the left,"
^DIC(9.4,3,22,21,"PAH",108,1,23,0)="                        right or both sides of a input string."
^DIC(9.4,3,22,21,"PAH",108,1,24,0)="                        W ""[""_$$TRIM^XLFSTR(""  A B C  "")_""]"" => [A B C]"
^DIC(9.4,3,22,21,"PAH",108,1,25,0)="                        W ""[""_$$TRIM^XLFSTR(""//A B C//"",,""/"")_""]"" => [A B C]"
^DIC(9.4,3,22,21,"PAH",108,1,26,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,27,0)="ISL-0699-51707 XLFDT    The FMADD call would return 141301 if passed (0,0)"
^DIC(9.4,3,22,21,"PAH",108,1,28,0)="                        This has been fixed."
^DIC(9.4,3,22,21,"PAH",108,1,29,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,30,0)="Y2K testing    XLFDT3   The SCH^XLFDT didn't handle Feb 29, 2000."
^DIC(9.4,3,22,21,"PAH",108,1,31,0)="                        This has been fixed."
^DIC(9.4,3,22,21,"PAH",108,1,32,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,33,0)="MCM-1195-51777          Option XUERTRP CLEAN was not on the XUERRS menu."
^DIC(9.4,3,22,21,"PAH",108,1,34,0)="                        Linked up."
^DIC(9.4,3,22,21,"PAH",108,1,35,0)="                        "
^DIC(9.4,3,22,21,"PAH",108,1,36,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,37,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",108,1,38,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",108,1,39,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",108,1,40,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",108,1,41,0)=""
