^DIC(9.4,4,22,1,"PAH",5,1,90,0)=" XMRTCP        4812676           8,25,27"
^DIC(9.4,4,22,1,"PAH",5,1,91,0)=" XMRUCX        338699            27"
^DIC(9.4,4,22,1,"PAH",5,1,92,0)=" XMS0          9449052           8,13,20,23,27"
^DIC(9.4,4,22,1,"PAH",5,1,93,0)=" XMS5          12968983          8,13,23,27"
^DIC(9.4,4,22,1,"PAH",5,1,94,0)=" XMUT5C        3064751           27"
^DIC(9.4,4,22,1,"PAH",5,1,95,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",5,1,96,0)=" DOCUMENTATION:"
^DIC(9.4,4,22,1,"PAH",5,1,97,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,98,0)=" In order to fully utilize the new Error Processing in MailMan, you should"
^DIC(9.4,4,22,1,"PAH",5,1,99,0)=" start screening the 'Disconnect Errors'. To do this, look at the following"
^DIC(9.4,4,22,1,"PAH",5,1,100,0)=" options:"
^DIC(9.4,4,22,1,"PAH",5,1,101,0)=" Taskman Management ..."
^DIC(9.4,4,22,1,"PAH",5,1,102,0)="   Taskman Management Utilities ..."
^DIC(9.4,4,22,1,"PAH",5,1,103,0)="     Taskman Error Log ..."
^DIC(9.4,4,22,1,"PAH",5,1,104,0)="        List Error Screens"
^DIC(9.4,4,22,1,"PAH",5,1,105,0)="        Add Error Screens"
^DIC(9.4,4,22,1,"PAH",5,1,106,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,107,0)=" Use the option 'List Error Screens' to see what errors you are currently"
^DIC(9.4,4,22,1,"PAH",5,1,108,0)=" screening.  Use the option 'Add Error Screens' to add the following errors:"
^DIC(9.4,4,22,1,"PAH",5,1,109,0)="               AXP sites                       486 sites"
^DIC(9.4,4,22,1,"PAH",5,1,110,0)="               ---------                       ---------"
^DIC(9.4,4,22,1,"PAH",5,1,111,0)="               DISCON                          DSCON"
^DIC(9.4,4,22,1,"PAH",5,1,112,0)="               HANGUP"
^DIC(9.4,4,22,1,"PAH",5,1,113,0)="               REJECT"
^DIC(9.4,4,22,1,"PAH",5,1,114,0)="               CONNECFAIL"
^DIC(9.4,4,22,1,"PAH",5,1,115,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,116,0)=" OPTION:"
^DIC(9.4,4,22,1,"PAH",5,1,117,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,118,0)=" Manage Mailman ..."
^DIC(9.4,4,22,1,"PAH",5,1,119,0)="   Network Management ..."
^DIC(9.4,4,22,1,"PAH",5,1,120,0)="     Transmission Management ..."
^DIC(9.4,4,22,1,"PAH",5,1,121,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,122,0)=" 'Toggle a script out of service'     Option name: XMSCRIPTOUT"
^DIC(9.4,4,22,1,"PAH",5,1,123,0)="   This options lets you edit the OUT OF SERVICE field for a Transmission"
^DIC(9.4,4,22,1,"PAH",5,1,124,0)="   Script in the Domain file. You can also requeue the Domain for transmission"
^DIC(9.4,4,22,1,"PAH",5,1,125,0)="   from this option."
^DIC(9.4,4,22,1,"PAH",5,1,126,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,127,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,128,0)=" DATA DICTIONARY:  Partial DD"
^DIC(9.4,4,22,1,"PAH",5,1,129,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,130,0)="  File:  DOMAIN #4.2"
^DIC(9.4,4,22,1,"PAH",5,1,131,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,132,0)="   Field:"
^DIC(9.4,4,22,1,"PAH",5,1,133,0)="    4      TRANSMISSION SCRIPT"
^DIC(9.4,4,22,1,"PAH",5,1,134,0)="    Subfield:"
^DIC(9.4,4,22,1,"PAH",5,1,135,0)="    1.5    OUT OF SERVICE"
^DIC(9.4,4,22,1,"PAH",5,1,136,0)="             This is the preferred field to set to take a script out of"
^DIC(9.4,4,22,1,"PAH",5,1,137,0)="             service,to prevent it from being used."
^DIC(9.4,4,22,1,"PAH",5,1,138,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,139,0)="  File:  MESSAGE STATISTICS #4.2999"
^DIC(9.4,4,22,1,"PAH",5,1,140,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,141,0)="   Fields:"
^DIC(9.4,4,22,1,"PAH",5,1,142,0)="    41     XMIT START DATE/TIME"
^DIC(9.4,4,22,1,"PAH",5,1,143,0)="             This field helps MailMan determine, after a fatal error,"
^DIC(9.4,4,22,1,"PAH",5,1,144,0)="             whether to start the transmission process at script 1,"
^DIC(9.4,4,22,1,"PAH",5,1,145,0)="             try 1, or to start elsewhere."
^DIC(9.4,4,22,1,"PAH",5,1,146,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,147,0)="    42     XMIT FINISH DATE/TIME"
^DIC(9.4,4,22,1,"PAH",5,1,148,0)="             This may be useful information for debugging purposes."
^DIC(9.4,4,22,1,"PAH",5,1,149,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,150,0)="    43     XMIT SCRIPT"
^DIC(9.4,4,22,1,"PAH",5,1,151,0)="             This tells MailMan which script is/was being used."
^DIC(9.4,4,22,1,"PAH",5,1,152,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,153,0)="    44     XMIT TRIES"
^DIC(9.4,4,22,1,"PAH",5,1,154,0)="             This tells MailMan how many tries have been made with"
^DIC(9.4,4,22,1,"PAH",5,1,155,0)="             the current script."
^DIC(9.4,4,22,1,"PAH",5,1,156,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,157,0)="    45     XMIT LATEST TRY DATE/TIME"
^DIC(9.4,4,22,1,"PAH",5,1,158,0)="             This may be useful information for debugging purposes."
^DIC(9.4,4,22,1,"PAH",5,1,159,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,160,0)="    46     XMIT SCRIPT CYCLE ITERATIONS"
^DIC(9.4,4,22,1,"PAH",5,1,161,0)="             This is the number of script cycles we have tried.  This"
^DIC(9.4,4,22,1,"PAH",5,1,162,0)="             field starts off at 0.  After we have tried all the scripts"
^DIC(9.4,4,22,1,"PAH",5,1,163,0)="             available, we bump up this field by 1."
^DIC(9.4,4,22,1,"PAH",5,1,164,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,165,0)="    47     XMIT FIRST SCRIPT"
^DIC(9.4,4,22,1,"PAH",5,1,166,0)="             This field notes which script has the highest priority, that"
^DIC(9.4,4,22,1,"PAH",5,1,167,0)="             is, which script was tried first."
^DIC(9.4,4,22,1,"PAH",5,1,168,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,169,0)="    51     XMIT SCRIPT RECORD"
^DIC(9.4,4,22,1,"PAH",5,1,170,0)="             This is a copy of the zero node of the latest script used."
^DIC(9.4,4,22,1,"PAH",5,1,171,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,172,0)="    60     XMIT AUDIT"
^DIC(9.4,4,22,1,"PAH",5,1,173,0)="             This multiple contains an audit of the attempts that have"
^DIC(9.4,4,22,1,"PAH",5,1,174,0)="             been made during this transmission."
^DIC(9.4,4,22,1,"PAH",6,0)="33 SEQ #27^2961028^1"
^DIC(9.4,4,22,1,"PAH",6,1,0)="^^46^46^2961028"
^DIC(9.4,4,22,1,"PAH",6,1,1,0)=" This patch changes the way KIDS secures a Packman Message. The prompt:"
^DIC(9.4,4,22,1,"PAH",6,1,2,0)="    'Enter the scramble hint:' "
^DIC(9.4,4,22,1,"PAH",6,1,3,0)=" has been removed.  A new prompt:"
^DIC(9.4,4,22,1,"PAH",6,1,4,0)="    'Do you wish to secure this message? No//'"
^DIC(9.4,4,22,1,"PAH",6,1,5,0)=" will be asked after you enter the text for a message. This correct the"
^DIC(9.4,4,22,1,"PAH",6,1,6,0)=" problem that was identified by Nois CLE-0696-40353."
^DIC(9.4,4,22,1,"PAH",6,1,7,0)=" This patch is the same as Kernel patch XU*8*40. Both patches contain"
^DIC(9.4,4,22,1,"PAH",6,1,8,0)=" the same MailMan and Kernel routines."
^DIC(9.4,4,22,1,"PAH",6,1,9,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",6,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",6,1,11,0)="This patch should be installed during off-peak hours. Users can be on the"
^DIC(9.4,4,22,1,"PAH",6,1,12,0)="system, but no user should be using KIDS during the install of this patch."
^DIC(9.4,4,22,1,"PAH",6,1,13,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",6,1,14,0)="  "
^DIC(9.4,4,22,1,"PAH",6,1,15,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",6,1,16,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",6,1,17,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,4,22,1,"PAH",6,1,18,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",6,1,19,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",6,1,20,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",6,1,21,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",6,1,22,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",6,1,23,0)="      options:"
^DIC(9.4,4,22,1,"PAH",6,1,24,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",6,1,25,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",6,1,26,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",6,1,27,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",6,1,28,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",6,1,29,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",6,1,30,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",6,1,31,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",6,1,32,0)=" ==========================================================================="
^DIC(9.4,4,22,1,"PAH",6,1,33,0)="  "
^DIC(9.4,4,22,1,"PAH",6,1,34,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",6,1,35,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",6,1,36,0)="       ;;7.1;MailMan;**33**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",6,1,37,0)=" "
^DIC(9.4,4,22,1,"PAH",6,1,38,0)=" Name           Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",6,1,39,0)=" -----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",6,1,40,0)=" XMASEC         4454626         33"
^DIC(9.4,4,22,1,"PAH",6,1,41,0)=" XMD            4879878         33"
^DIC(9.4,4,22,1,"PAH",6,1,42,0)=""
^DIC(9.4,4,22,1,"PAH",6,1,43,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,4,22,1,"PAH",6,1,44,0)=""
^DIC(9.4,4,22,1,"PAH",6,1,45,0)=" XPDTP          2358145         21,40"
^DIC(9.4,4,22,1,"PAH",6,1,46,0)=" ============================================================================"
^DIC(9.4,4,22,1,"PAH",7,0)="30 SEQ #28^2961104^1"
^DIC(9.4,4,22,1,"PAH",7,1,0)="^^40^40^2961104"
^DIC(9.4,4,22,1,"PAH",7,1,1,0)=" "
^DIC(9.4,4,22,1,"PAH",7,1,2,0)=" This MailMan patch is in response to Nois BRX-1195-11719 and E3R 7344, to"
^DIC(9.4,4,22,1,"PAH",7,1,3,0)="stop message bouncing caused by invalid subdomains.  If a message is"
^DIC(9.4,4,22,1,"PAH",7,1,4,0)="addressed to a subdomain not known to its parent domain, the message will"
^DIC(9.4,4,22,1,"PAH",7,1,5,0)="be rejected.  It will not be bounced back to FORUM, as it was previously."
^DIC(9.4,4,22,1,"PAH",7,1,6,0)="The originator will receive a message; 'Sub-domain XXX not found.'"
^DIC(9.4,4,22,1,"PAH",7,1,7,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",7,1,8,0)=" "
^DIC(9.4,4,22,1,"PAH",7,1,9,0)=" This patch can be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",7,1,10,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",7,1,11,0)=" "
^DIC(9.4,4,22,1,"PAH",7,1,12,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",7,1,13,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",7,1,14,0)="      so you will need to disable mapping for the effected routine."
^DIC(9.4,4,22,1,"PAH",7,1,15,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",7,1,16,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",7,1,17,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",7,1,18,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",7,1,19,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",7,1,20,0)="      options:"
^DIC(9.4,4,22,1,"PAH",7,1,21,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",7,1,22,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",7,1,23,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",7,1,24,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",7,1,25,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",7,1,26,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",7,1,27,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",7,1,28,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",7,1,29,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",7,1,30,0)="  "
^DIC(9.4,4,22,1,"PAH",7,1,31,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",7,1,32,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",7,1,33,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",7,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",7,1,35,0)="               Before          After"
^DIC(9.4,4,22,1,"PAH",7,1,36,0)=" Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",7,1,37,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",7,1,38,0)=" XMA21A        8460688         8186870         4,30"
^DIC(9.4,4,22,1,"PAH",7,1,39,0)=" XMR           6264225         6434522         30"
^DIC(9.4,4,22,1,"PAH",7,1,40,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",8,0)="38 SEQ #29^2961107^1"
^DIC(9.4,4,22,1,"PAH",8,1,0)="^^42^42^2961107"
^DIC(9.4,4,22,1,"PAH",8,1,1,0)="MailMan patch XM*7.1*38 is a patch for XM*7.1*27.  It contains the following"
^DIC(9.4,4,22,1,"PAH",8,1,2,0)="bug fix:"
^DIC(9.4,4,22,1,"PAH",8,1,3,0)=""
^DIC(9.4,4,22,1,"PAH",8,1,4,0)="Fixes 'undefined variable' problem with the variable XMB(""ITERATIONS"")."
^DIC(9.4,4,22,1,"PAH",8,1,5,0)="This problem occurs when patch XM*7.1*27 is loaded after remote transmission"
^DIC(9.4,4,22,1,"PAH",8,1,6,0)="tasks have been queued, but before they have a chance to run."
^DIC(9.4,4,22,1,"PAH",8,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",8,1,8,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",8,1,9,0)=" This patch should be installed after hours, when user activity is at"
^DIC(9.4,4,22,1,"PAH",8,1,10,0)=" a minimum.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",8,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",8,1,12,0)=" MSM Sites: The routine XMRTCP must be moved to your NT machine and then"
^DIC(9.4,4,22,1,"PAH",8,1,13,0)=" reboot MSM on the NT machine.  This will restart the TCP/IP poller."
^DIC(9.4,4,22,1,"PAH",8,1,14,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",8,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",8,1,16,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",8,1,17,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",8,1,18,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,4,22,1,"PAH",8,1,19,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",8,1,20,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",8,1,21,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",8,1,22,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",8,1,23,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",8,1,24,0)="      options:"
^DIC(9.4,4,22,1,"PAH",8,1,25,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",8,1,26,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",8,1,27,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",8,1,28,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",8,1,29,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",8,1,30,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",8,1,31,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",8,1,32,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",8,1,33,0)="===========================================================================  "
^DIC(9.4,4,22,1,"PAH",8,1,34,0)="  "
^DIC(9.4,4,22,1,"PAH",8,1,35,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",8,1,36,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",8,1,37,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",8,1,38,0)="               Checksum       Checksum"
^DIC(9.4,4,22,1,"PAH",8,1,39,0)=" Name           Before         After           Patch List"
^DIC(9.4,4,22,1,"PAH",8,1,40,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",8,1,41,0)=" XMBPOST       9662243        9856673      4,13,23,24,27,38"
^DIC(9.4,4,22,1,"PAH",8,1,42,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",9,0)="31 SEQ #30^2961224^1"
^DIC(9.4,4,22,1,"PAH",9,1,0)="^^122^122^2961224"
^DIC(9.4,4,22,1,"PAH",9,1,1,0)="MailMan Patch XM*7.1*31"
^DIC(9.4,4,22,1,"PAH",9,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,3,0)="NOIS: BRX-0496-11847     Routines: ^XMA5,^XMA5A"
^DIC(9.4,4,22,1,"PAH",9,1,4,0)=" Fixes subscript error when  QD'ing numeric recipients, such as those"
^DIC(9.4,4,22,1,"PAH",9,1,5,0)=" @AOL.COM"
^DIC(9.4,4,22,1,"PAH",9,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,7,0)="NOIS: DAY-0995-40521     Routines: ^XMA21"
^DIC(9.4,4,22,1,"PAH",9,1,8,0)=" Removes phantom recipients when using XMY array during programmer calls"
^DIC(9.4,4,22,1,"PAH",9,1,9,0)=" to ^XMB(bulletin) or ^XMD(message)."
^DIC(9.4,4,22,1,"PAH",9,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,11,0)="NOIS: NAS-1295-30255     Routines: ^XMB1"
^DIC(9.4,4,22,1,"PAH",9,1,12,0)="      CLE-0396-41473"
^DIC(9.4,4,22,1,"PAH",9,1,13,0)=" Later'd messages report will now appear even if ^'d out of prior option."
^DIC(9.4,4,22,1,"PAH",9,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,15,0)="NOIS: BRX-0396-10222     Routines: ^XMAD2"
^DIC(9.4,4,22,1,"PAH",9,1,16,0)="      MAD-0196-40136"
^DIC(9.4,4,22,1,"PAH",9,1,17,0)="      MCM-0896-50571"
^DIC(9.4,4,22,1,"PAH",9,1,18,0)=" Fixes error caused by Later'd messages becoming new after the user has"
^DIC(9.4,4,22,1,"PAH",9,1,19,0)=" been deactivated and deleted from ^XMB(3.7."
^DIC(9.4,4,22,1,"PAH",9,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,21,0)="NOIS: TOM-1195-41441     Routines: ^XMA21"
^DIC(9.4,4,22,1,"PAH",9,1,22,0)=" Sender doesn't have to broadcast twice when forwarding."
^DIC(9.4,4,22,1,"PAH",9,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,24,0)="NOIS: CMO-1195-40423     Routines: ^XMA24"
^DIC(9.4,4,22,1,"PAH",9,1,25,0)=" Lets sender deselect ('-*') broadcast."
^DIC(9.4,4,22,1,"PAH",9,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,27,0)="NOIS: FTM-1195-41507     Routines: ^XMA24"
^DIC(9.4,4,22,1,"PAH",9,1,28,0)=" Ask sender for basket when sending to SHARED,MAIL, whether or not ""ask"
^DIC(9.4,4,22,1,"PAH",9,1,29,0)=" basket"" is set to ""yes""."
^DIC(9.4,4,22,1,"PAH",9,1,30,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,31,0)="NOIS: GRJ-1094-50087      Routines: ^XMA21G"
^DIC(9.4,4,22,1,"PAH",9,1,32,0)=" Make error message clearer by changing from ""not found"" to ""mail group"
^DIC(9.4,4,22,1,"PAH",9,1,33,0)=" not found""."
^DIC(9.4,4,22,1,"PAH",9,1,34,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,35,0)="NOIS: none                Routines: ^XMA21,^XMA210"
^DIC(9.4,4,22,1,"PAH",9,1,36,0)=" No Nois, refer to FORUM mail msg 19872177."
^DIC(9.4,4,22,1,"PAH",9,1,37,0)=" If user enters a number in response to 'send to:' prompt, and the DUZ is"
^DIC(9.4,4,22,1,"PAH",9,1,38,0)=" not found in ^VA(200, MailMan will no longer try to use the number as an"
^DIC(9.4,4,22,1,"PAH",9,1,39,0)=" IEN to pick out a mail name or remote user."
^DIC(9.4,4,22,1,"PAH",9,1,40,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,41,0)="NOIS: MWV-0396-21324      Routines: ^XMA21,^XMA21G"
^DIC(9.4,4,22,1,"PAH",9,1,42,0)=" This concerns what happens when a user deselects an addressee (-name or"
^DIC(9.4,4,22,1,"PAH",9,1,43,0)=" -g.group) at a 'send to:' prompt, after already broadcasting ('*')."
^DIC(9.4,4,22,1,"PAH",9,1,44,0)=" If ""-g.group"", MailMan lets the user know that the message will still go"
^DIC(9.4,4,22,1,"PAH",9,1,45,0)=" to all local users."
^DIC(9.4,4,22,1,"PAH",9,1,46,0)=" If ""-name"", MailMan checks to see if the ""name"" is already specified as a"
^DIC(9.4,4,22,1,"PAH",9,1,47,0)=" recipient.  If he is, then MailMan tells the user that the message will still"
^DIC(9.4,4,22,1,"PAH",9,1,48,0)=" go to all local users.  If he isn't, then MailMan just tells the user that"
^DIC(9.4,4,22,1,"PAH",9,1,49,0)=" ""name"" is not found."
^DIC(9.4,4,22,1,"PAH",9,1,50,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,51,0)="E3R: 8885                 Routines: ^XMA21"
^DIC(9.4,4,22,1,"PAH",9,1,52,0)=" Removes all SSN cross-references from the lookup at the 'Send to:' prompt. "
^DIC(9.4,4,22,1,"PAH",9,1,53,0)=" This ensures that if the user enters a number, it cannot partial match  (and"
^DIC(9.4,4,22,1,"PAH",9,1,54,0)=" display) an SSN.  Lookup on the ^VA(200 is now confined to the following"
^DIC(9.4,4,22,1,"PAH",9,1,55,0)=" cross references:  NAME(B), ALIAS(BB), INITIAL(C), NICK NAME(D) "
^DIC(9.4,4,22,1,"PAH",9,1,56,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,57,0)="NOIS: ALB-0596-50002      Routines: ^XMRENT"
^DIC(9.4,4,22,1,"PAH",9,1,58,0)=" Prevents an error from occuring when the SENDER field (piece 4) of a message"
^DIC(9.4,4,22,1,"PAH",9,1,59,0)=" is zero."
^DIC(9.4,4,22,1,"PAH",9,1,60,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,61,0)="NOIS: DAY-1096-41059      Routines: ^XMGAPI0"
^DIC(9.4,4,22,1,"PAH",9,1,62,0)=" If a message subject is longer than 65 characters, it is truncated to the"
^DIC(9.4,4,22,1,"PAH",9,1,63,0)=" first 250 characters."
^DIC(9.4,4,22,1,"PAH",9,1,64,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,65,0)="NOIS: ANN-1096-41381      Routines: ^XMRPCTS0"
^DIC(9.4,4,22,1,"PAH",9,1,66,0)=" Check to make sure a task is running, rather than just assuming it is."
^DIC(9.4,4,22,1,"PAH",9,1,67,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,68,0)="NOIS: WPB-0894-30125      Routine: ^XMA1"
^DIC(9.4,4,22,1,"PAH",9,1,69,0)=" The default message action for a message which is NEWed is IGNORE, even if"
^DIC(9.4,4,22,1,"PAH",9,1,70,0)=" the site or the user has specified that the default message action is"
^DIC(9.4,4,22,1,"PAH",9,1,71,0)=" DELETE.  If a user deletes a message after NEWing it, the message will be"
^DIC(9.4,4,22,1,"PAH",9,1,72,0)=" deleted.  The default is changed only for the duration of your actions on"
^DIC(9.4,4,22,1,"PAH",9,1,73,0)=" that particular message.  When you get to the next message, your default is"
^DIC(9.4,4,22,1,"PAH",9,1,74,0)=" whatever it is supposed to be. "
^DIC(9.4,4,22,1,"PAH",9,1,75,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",9,1,76,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,77,0)=" This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",9,1,78,0)=" minimum.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",9,1,79,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",9,1,80,0)=" "
^DIC(9.4,4,22,1,"PAH",9,1,81,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",9,1,82,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",9,1,83,0)="      so you will need to disable mapping for the affected routine."
^DIC(9.4,4,22,1,"PAH",9,1,84,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",9,1,85,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",9,1,86,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",9,1,87,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",9,1,88,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",9,1,89,0)="      options:"
^DIC(9.4,4,22,1,"PAH",9,1,90,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",9,1,91,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",9,1,92,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",9,1,93,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",9,1,94,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",9,1,95,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",9,1,96,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",9,1,97,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",9,1,98,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",9,1,99,0)="  "
^DIC(9.4,4,22,1,"PAH",9,1,100,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",9,1,101,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",9,1,102,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",9,1,103,0)=" "
^DIC(9.4,4,22,1,"PAH",9,1,104,0)="               Before          After"
^DIC(9.4,4,22,1,"PAH",9,1,105,0)=" Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",9,1,106,0)=" ---------------------------------------------------------- "
^DIC(9.4,4,22,1,"PAH",9,1,107,0)=" XMA1          10558704         9575986         31"
^DIC(9.4,4,22,1,"PAH",9,1,108,0)=" XMA21          9603768        11321545         4,31"
^DIC(9.4,4,22,1,"PAH",9,1,109,0)=" XMA210         1925522         1920955         31"
^DIC(9.4,4,22,1,"PAH",9,1,110,0)=" XMA21G        10231186         9710102         31"
^DIC(9.4,4,22,1,"PAH",9,1,111,0)=" XMA24         10412829        10721719         31"
^DIC(9.4,4,22,1,"PAH",9,1,112,0)=" XMA5          11164486        11197080         31"
^DIC(9.4,4,22,1,"PAH",9,1,113,0)=" XMA5A         14101090        14213526         31"
^DIC(9.4,4,22,1,"PAH",9,1,114,0)=" XMAD2          2440129         2503657         31"
^DIC(9.4,4,22,1,"PAH",9,1,115,0)=" XMB1           8922945         8930890         31"
^DIC(9.4,4,22,1,"PAH",9,1,116,0)=" XMGAPI0        2337589         2451955         31"
^DIC(9.4,4,22,1,"PAH",9,1,117,0)=" XMRENT         2314897         2303842         31"
^DIC(9.4,4,22,1,"PAH",9,1,118,0)=" XMRPCTS        5007367         4760679         6,11,31"
^DIC(9.4,4,22,1,"PAH",9,1,119,0)=" XMRPCTS0       5966846         6044236         6,12,31"
^DIC(9.4,4,22,1,"PAH",9,1,120,0)=" XMRPCTSA       4903763         3483840         6,31"
^DIC(9.4,4,22,1,"PAH",9,1,121,0)=""
^DIC(9.4,4,22,1,"PAH",9,1,122,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",10,0)="34 SEQ #31^2970303^1"
^DIC(9.4,4,22,1,"PAH",10,1,0)="^^63^63^2970303"
^DIC(9.4,4,22,1,"PAH",10,1,1,0)=" This MailMan patch is in response to the following:"
^DIC(9.4,4,22,1,"PAH",10,1,2,0)="ANN-1196-40100  Packman will now halt properly when an error is found in"
^DIC(9.4,4,22,1,"PAH",10,1,3,0)=" a routine it is trying to transport."
^DIC(9.4,4,22,1,"PAH",10,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",10,1,5,0)="BRX-1295-11486, AUG-0796-31857, FTM-0296-42025  Mailman now keeps track of"
^DIC(9.4,4,22,1,"PAH",10,1,6,0)=" the old and new Validations number.  If the link breaks before a site"
^DIC(9.4,4,22,1,"PAH",10,1,7,0)=" receives a new Val. number, MM will allow the old number next time the"
^DIC(9.4,4,22,1,"PAH",10,1,8,0)=" site reconnects."
^DIC(9.4,4,22,1,"PAH",10,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",10,1,10,0)="MGY-1295-31820  Postmaster will no longer put messages in its waste basket."
^DIC(9.4,4,22,1,"PAH",10,1,11,0)=" The messages will be deleted."
^DIC(9.4,4,22,1,"PAH",10,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",10,1,13,0)="FNC-1196-32114  XMAUTOPURGE get no open error when queued."
^DIC(9.4,4,22,1,"PAH",10,1,14,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",10,1,15,0)=" This patch should be installed during off-peak hours when network mail"
^DIC(9.4,4,22,1,"PAH",10,1,16,0)=" activity is low. This patch can be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",10,1,17,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",10,1,18,0)=" "
^DIC(9.4,4,22,1,"PAH",10,1,19,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",10,1,20,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",10,1,21,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,4,22,1,"PAH",10,1,22,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",10,1,23,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",10,1,24,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",10,1,25,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",10,1,26,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",10,1,27,0)="      options:"
^DIC(9.4,4,22,1,"PAH",10,1,28,0)="         2 Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",10,1,29,0)="         3 Print Transport Global"
^DIC(9.4,4,22,1,"PAH",10,1,30,0)="         4 Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",10,1,31,0)="         5 Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",10,1,32,0)="         6 Install Package(s)"
^DIC(9.4,4,22,1,"PAH",10,1,33,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",10,1,34,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",10,1,35,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",10,1,36,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",10,1,37,0)="  "
^DIC(9.4,4,22,1,"PAH",10,1,38,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",10,1,39,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",10,1,40,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",10,1,41,0)=" "
^DIC(9.4,4,22,1,"PAH",10,1,42,0)="               Before          After"
^DIC(9.4,4,22,1,"PAH",10,1,43,0)=" Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",10,1,44,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",10,1,45,0)=" XMPH          4682271         4842981         34"
^DIC(9.4,4,22,1,"PAH",10,1,46,0)=" XMR           6434522         6876928         30,34"
