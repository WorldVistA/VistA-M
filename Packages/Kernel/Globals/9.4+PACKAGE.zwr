^DIC(9.4,100,22,15,"PAH",143,1,1,0)="Updates to MHA Functionality."
^DIC(9.4,100,22,15,"PAH",143,1,2,0)="Update for User Preference Parameters to validate Last Assignment."
^DIC(9.4,100,22,15,"PAH",143,1,3,0)="Update MH REPORT to have new message if restricted instrument."
^DIC(9.4,100,22,15,"PAH",143,1,4,0)="Update Instrument Exchange to handle Orlando progress note titles of"
^DIC(9.4,100,22,15,"PAH",143,1,5,0)="MH DIAGNOSTIC STUDY NOTE and MH CONSULT NOTE"
^DIC(9.4,100,22,15,"PAH",143,1,6,0)="Update BOMC report."
^DIC(9.4,100,22,15,"PAH",143,1,7,0)="Update PSS-3-2ND report."
^DIC(9.4,100,22,15,"PAH",143,1,8,0)="Fix EAT-26 scoring for zero height."
^DIC(9.4,100,22,15,"PAH",143,1,9,0)="Fix CCSA-DSM5 skipped question error in scoring."
^DIC(9.4,100,22,15,"PAH",143,1,10,0)="Fix YMRS response item number."
^DIC(9.4,100,22,15,"PAH",143,1,11,0)=" "
^DIC(9.4,100,22,15,"PAH",143,1,12,0)="Add AAQ-II-7"
^DIC(9.4,100,22,15,"PAH",143,1,13,0)="Add ALSFRS-R"
^DIC(9.4,100,22,15,"PAH",143,1,14,0)="Add ALSSQOL-SF"
^DIC(9.4,100,22,15,"PAH",143,1,15,0)="Reactivate BBHI-2"
^DIC(9.4,100,22,15,"PAH",143,1,16,0)=" "
^DIC(9.4,100,22,15,"PAH",143,1,17,0)="Add Parameter YS MHA LOG APPLICATION ERRORS to control error trapping for"
^DIC(9.4,100,22,15,"PAH",143,1,18,0)="administrations.  It is implemented turned off by default, deactivating "
^DIC(9.4,100,22,15,"PAH",143,1,19,0)="error trapping for administration double click errors. Double clicking is "
^DIC(9.4,100,22,15,"PAH",143,1,20,0)="deactivated in the web application itself."
