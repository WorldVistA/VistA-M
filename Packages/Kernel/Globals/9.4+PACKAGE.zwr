^DIC(9.4,100,22,15,"PAH",98,1,124,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,125,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,100,22,15,"PAH",98,1,126,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,127,0)=" 1. Rational ID Defect 1262531"
^DIC(9.4,100,22,15,"PAH",98,1,128,0)="    Sites Not Able to Transmit Clozapine Prescription Data"
^DIC(9.4,100,22,15,"PAH",98,1,129,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,130,0)=" Problem:"
^DIC(9.4,100,22,15,"PAH",98,1,131,0)=" --------"
^DIC(9.4,100,22,15,"PAH",98,1,132,0)="Some sites were not transmitting data via the OPTION Daily Clozapine "
^DIC(9.4,100,22,15,"PAH",98,1,133,0)="Transmission [YSCL DAILY TRANSMISSION].  The cause was a missing FileMan "
^DIC(9.4,100,22,15,"PAH",98,1,134,0)="date in the log that is stored in the zero node of ^XTMP(""YSCLTRN"")."
^DIC(9.4,100,22,15,"PAH",98,1,135,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,136,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,137,0)=" Resolution:"
^DIC(9.4,100,22,15,"PAH",98,1,138,0)=" -----------"
^DIC(9.4,100,22,15,"PAH",98,1,139,0)="The YSCLTST5 routine was modified to prevent this problem.  The code now "
^DIC(9.4,100,22,15,"PAH",98,1,140,0)="forces the initial loop value to zero and the logic proceeds."
^DIC(9.4,100,22,15,"PAH",98,1,141,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,142,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,143,0)="Test Sites:"
^DIC(9.4,100,22,15,"PAH",98,1,144,0)="-----------"
^DIC(9.4,100,22,15,"PAH",98,1,145,0)="N. FLORIDA/S. GEORGIA VHS   (573)"
^DIC(9.4,100,22,15,"PAH",98,1,146,0)="   VA NORTH FLORIDA/SOUTH GEORGIA HEALTH SYSTEM - GAINESVILLE "
^DIC(9.4,100,22,15,"PAH",98,1,147,0)="DIVISION     "
^DIC(9.4,100,22,15,"PAH",98,1,148,0)="   Gainesville, FL       "
^DIC(9.4,100,22,15,"PAH",98,1,149,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,150,0)="WEST LA VAMC   (691)"
^DIC(9.4,100,22,15,"PAH",98,1,151,0)="   VA GREATER LOS ANGELES HEALTHCARE SYSTEM - WEST LOS ANGELES"
^DIC(9.4,100,22,15,"PAH",98,1,152,0)="   Los Angeles, CA"
^DIC(9.4,100,22,15,"PAH",98,1,153,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,154,0)="CONNECTICUT HCS   (689)"
^DIC(9.4,100,22,15,"PAH",98,1,155,0)="   CONNECTICUT HEALTH CARE SYSTEM - WEST HAVEN DIVISION"
^DIC(9.4,100,22,15,"PAH",98,1,156,0)="   West Haven, CT "
^DIC(9.4,100,22,15,"PAH",98,1,157,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,158,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,100,22,15,"PAH",98,1,159,0)="--------------------------------------------------"
^DIC(9.4,100,22,15,"PAH",98,1,160,0)="The software for this patch is being released in a PackMan "
^DIC(9.4,100,22,15,"PAH",98,1,161,0)="message."
^DIC(9.4,100,22,15,"PAH",98,1,162,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,163,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,164,0)="Documentation describing the new functionality is included in "
^DIC(9.4,100,22,15,"PAH",98,1,165,0)="this release. Documentation can be found on the VA Software "
^DIC(9.4,100,22,15,"PAH",98,1,166,0)="Documentation Library at: https://www.domain.ext/vdl/"
^DIC(9.4,100,22,15,"PAH",98,1,167,0)="     Clinical >> Mental Health"
^DIC(9.4,100,22,15,"PAH",98,1,168,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,169,0)="Documentation Title                             File "
^DIC(9.4,100,22,15,"PAH",98,1,170,0)="Name                     "
^DIC(9.4,100,22,15,"PAH",98,1,171,0)="National Clozapine Coordination Project VistA User Guide"
^DIC(9.4,100,22,15,"PAH",98,1,172,0)="                     VistA Clozapine User Guide YS149 Updates.docx"
^DIC(9.4,100,22,15,"PAH",98,1,173,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,174,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,175,0)="Patch Installation:"
^DIC(9.4,100,22,15,"PAH",98,1,176,0)="-------------------"
^DIC(9.4,100,22,15,"PAH",98,1,177,0)="  "
^DIC(9.4,100,22,15,"PAH",98,1,178,0)="Pre/Post-Installation Overview:"
^DIC(9.4,100,22,15,"PAH",98,1,179,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,180,0)="After the patch is installed the new option Transmit Clozapine Rx HL7 "
^DIC(9.4,100,22,15,"PAH",98,1,181,0)="Messages [YSCL HL7 CLOZ TRANSMISSION] needs to be scheduled in TaskMan.  "
^DIC(9.4,100,22,15,"PAH",98,1,182,0)="Instructions are listed below."
^DIC(9.4,100,22,15,"PAH",98,1,183,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,184,0)="Also, after installing the patch the coordinator for the YSCLHL7 LOGS "
^DIC(9.4,100,22,15,"PAH",98,1,185,0)="Mail Group should be notified that the patch was installed and that users "
^DIC(9.4,100,22,15,"PAH",98,1,186,0)="can be added to the Mail Group.  MailMan messages with information about "
^DIC(9.4,100,22,15,"PAH",98,1,187,0)="the HL7 message transmissions will be sent to that group."
^DIC(9.4,100,22,15,"PAH",98,1,188,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,189,0)="This is an example:"
^DIC(9.4,100,22,15,"PAH",98,1,190,0)=" "
^DIC(9.4,100,22,15,"PAH",98,1,191,0)="Subj: Clozapine HL7 report ST ELIGIUS HOSPITAL (999)  [#30896] "
^DIC(9.4,100,22,15,"PAH",98,1,192,0)="11/29/19@16:42"
^DIC(9.4,100,22,15,"PAH",98,1,193,0)="22 lines"
^DIC(9.4,100,22,15,"PAH",98,1,194,0)="From: HRUBOVCAK,JC  In 'IN' basket.   Page 1"
