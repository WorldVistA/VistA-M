^DIC(9.4,53,22,20,"PAH",52,0)="91 SEQ #82^2980318^1"
^DIC(9.4,53,22,20,"PAH",52,1,0)="^^4^4^2980318"
^DIC(9.4,53,22,20,"PAH",52,1,1,0)="DATE SORTED PAYMENT REPORT"
^DIC(9.4,53,22,20,"PAH",52,1,2,0)="This patch contains the new 'Date Sorted Payment Report' [PRCAD DATE"
^DIC(9.4,53,22,20,"PAH",52,1,3,0)="SORTED] option which is found on the 'Reconciliation Reports' [PRCAD"
^DIC(9.4,53,22,20,"PAH",52,1,4,0)="RECONCILE MENU] menu. The report can be run as summary or detailed. "
^DIC(9.4,53,22,20,"PAH",53,0)="92 SEQ #83^2980318^1"
^DIC(9.4,53,22,20,"PAH",53,1,0)="^^1^1^2980318"
^DIC(9.4,53,22,20,"PAH",53,1,1,0)="FISCAL YEAR NOT CHANGED IN AR"
^DIC(9.4,53,22,20,"PAH",54,0)="104 SEQ #84^2980330^1"
^DIC(9.4,53,22,20,"PAH",54,1,0)="^^1^1^2980330"
^DIC(9.4,53,22,20,"PAH",54,1,1,0)="Year 2000 changes."
^DIC(9.4,53,22,20,"PAH",55,0)="100 SEQ #85^2980423^1"
