^DIC(9.4,42,22,7,"PAH",103,1,17,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,18,0)="Mail Groups Associated:     N/A"
^DIC(9.4,42,22,7,"PAH",103,1,19,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,20,0)="Options Associated:         N/A"
^DIC(9.4,42,22,7,"PAH",103,1,21,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,22,0)="Protocols Associated:       N/A"
^DIC(9.4,42,22,7,"PAH",103,1,23,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,24,0)="Security Keys Associated:   N/A"
