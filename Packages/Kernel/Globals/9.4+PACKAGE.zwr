^DIC(9.4,33,22,1.4,"PAH",1,1,1,0)="This patch prevents a NULLSUBSCR error from occuring on inbound batch"
^DIC(9.4,33,22,1.4,"PAH",1,1,2,0)="acknowledgments and corrects a problem with the format of the MSA segment."
^DIC(9.4,33,22,1.4,"PAH",2,0)="9 SEQ #7^2960627^1"
^DIC(9.4,33,22,1.4,"PAH",2,1,0)="^^6^6^2960627"
^DIC(9.4,33,22,1.4,"PAH",2,1,1,0)="This patch to patch number 2 corrects errors in the first and second lines"
^DIC(9.4,33,22,1.4,"PAH",2,1,2,0)="of the routines HLCS and HLCSDR2. Remaining code is unchanged."
^DIC(9.4,33,22,1.4,"PAH",2,1,3,0)=" "
