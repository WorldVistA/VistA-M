^DIC(9.4,4,22,1,"PAH",112,0)="143 SEQ #137^3000816^1"
^DIC(9.4,4,22,1,"PAH",112,1,0)="^^74^74^3000816"
^DIC(9.4,4,22,1,"PAH",112,1,1,0)="Patch XM*7.1*143"
^DIC(9.4,4,22,1,"PAH",112,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,3,0)="NOIS: MON-0800-50661"
^DIC(9.4,4,22,1,"PAH",112,1,4,0)="Test Site:  Montana HCS"
^DIC(9.4,4,22,1,"PAH",112,1,5,0)="Fix logic which results in improper deletion of vaporize date when"
^DIC(9.4,4,22,1,"PAH",112,1,6,0)="broadcasting a message by forwarding it."
^DIC(9.4,4,22,1,"PAH",112,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,8,0)="NOIS: TAM-0800-30156"
^DIC(9.4,4,22,1,"PAH",112,1,9,0)="Test Site:  Tampa, FL"
^DIC(9.4,4,22,1,"PAH",112,1,10,0)="Fix an abort which occurred because of typos in parameter checking routine"
^DIC(9.4,4,22,1,"PAH",112,1,11,0)="for MailMan APIs."
^DIC(9.4,4,22,1,"PAH",112,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,13,0)="NOIS: WBP-0100-22822"
^DIC(9.4,4,22,1,"PAH",112,1,14,0)="Test Site:  Wilkes Barre, PA; Dayton, OH"
^DIC(9.4,4,22,1,"PAH",112,1,15,0)="Remove an errant DIR(""B"") which was hanging around after MailMan exits and"
^DIC(9.4,4,22,1,"PAH",112,1,16,0)="popping up in unexpected places elsewhere."
^DIC(9.4,4,22,1,"PAH",112,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,18,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",112,1,19,0)="Test Site:  DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",112,1,20,0)="Fix an abort which occurred on FORUM because of a badly written $G() command."
^DIC(9.4,4,22,1,"PAH",112,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,22,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",112,1,23,0)="is at a minimum.  It requires MailMan patch XM*7.1*131."
^DIC(9.4,4,22,1,"PAH",112,1,24,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",112,1,25,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,26,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",112,1,27,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",112,1,28,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",112,1,29,0)=" "
^DIC(9.4,4,22,1,"PAH",112,1,30,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",112,1,31,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",112,1,32,0)="-----------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",112,1,33,0)="XMJBM         10732311        10627394        50,110,131,143"
^DIC(9.4,4,22,1,"PAH",112,1,34,0)="XMJMOI        18181531        18282681        50,87,89,110,127,131,143"
^DIC(9.4,4,22,1,"PAH",112,1,35,0)="XMXMSGS       10394514        10461549        50,110,124,131,143"
^DIC(9.4,4,22,1,"PAH",112,1,36,0)="XMXMSGS2       7750414         7663790        50,106,110,127,131,143"
^DIC(9.4,4,22,1,"PAH",112,1,37,0)="XMXPARM       15160844        15143763        50,96,107,127,131,143"
^DIC(9.4,4,22,1,"PAH",112,1,38,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",112,1,39,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,40,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",112,1,41,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",112,1,42,0)=" "
^DIC(9.4,4,22,1,"PAH",112,1,43,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",112,1,44,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",112,1,45,0)="is at a minimum.  It requires MailMan patch XM*7.1*131."
^DIC(9.4,4,22,1,"PAH",112,1,46,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",112,1,47,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",112,1,48,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",112,1,49,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",112,1,50,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",112,1,51,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",112,1,52,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",112,1,53,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",112,1,54,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",112,1,55,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",112,1,56,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",112,1,57,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",112,1,58,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",112,1,59,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",112,1,60,0)=" Select INSTALL NAME:    XM*7.1*143    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",112,1,61,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",112,1,62,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",112,1,63,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",112,1,64,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",112,1,65,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",112,1,66,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",112,1,67,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",112,1,68,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",112,1,69,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",112,1,70,0)=""
^DIC(9.4,4,22,1,"PAH",112,1,71,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",112,1,72,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",112,1,73,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
