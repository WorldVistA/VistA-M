^DIC(9.4,48,22,5.28,"PAH",88,1,0)="^^1^1^2980129"
^DIC(9.4,48,22,5.28,"PAH",88,1,1,0)="Incomplete Encounter Management"
^DIC(9.4,48,22,5.28,"PAH",89,0)="131^2980227^1"
^DIC(9.4,48,22,5.28,"PAH",89,1,0)="^^14^14^2980227"
^DIC(9.4,48,22,5.28,"PAH",89,1,1,0)="                     **** ACRP Interface Toolkit ****"
^DIC(9.4,48,22,5.28,"PAH",89,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",89,1,3,0)=" This build contains the ACRP Interface Toolkit (AIT) supported by scheduling"
^DIC(9.4,48,22,5.28,"PAH",89,1,4,0)=" that provides access to ACRP encounter data. Use of the AIT does not"
^DIC(9.4,48,22,5.28,"PAH",89,1,5,0)=" require an integration agreement. "
^DIC(9.4,48,22,5.28,"PAH",89,1,6,0)=""
^DIC(9.4,48,22,5.28,"PAH",89,1,7,0)=" National and local developers should use the AIT to obtain the following"
^DIC(9.4,48,22,5.28,"PAH",89,1,8,0)=" ACRP encounter related data:"
^DIC(9.4,48,22,5.28,"PAH",89,1,9,0)="            - procedures"
^DIC(9.4,48,22,5.28,"PAH",89,1,10,0)="            - diagnoses"
^DIC(9.4,48,22,5.28,"PAH",89,1,11,0)="            - provider"
^DIC(9.4,48,22,5.28,"PAH",89,1,12,0)="            - general administrative "
^DIC(9.4,48,22,5.28,"PAH",89,1,13,0)=""
^DIC(9.4,48,22,5.28,"PAH",89,1,14,0)="Refer to National Patch Module for more details on patch SD*5.3*131."
^DIC(9.4,48,22,5.28,"PAH",90,0)="143^2980302^1"
^DIC(9.4,48,22,5.28,"PAH",90,1,0)="^^6^6^2980302"
^DIC(9.4,48,22,5.28,"PAH",90,1,1,0)="This build contains the changes as a result of three NOIS issues.  The"
^DIC(9.4,48,22,5.28,"PAH",90,1,2,0)="following is a listing of the problems it will fix."
^DIC(9.4,48,22,5.28,"PAH",90,1,3,0)="-up-arrow not being recognized in the summary report."
^DIC(9.4,48,22,5.28,"PAH",90,1,4,0)="-Extra questions appearing in question 4 of screen one of load/edit.  They"
^DIC(9.4,48,22,5.28,"PAH",90,1,5,0)="will be removed."
^DIC(9.4,48,22,5.28,"PAH",90,1,6,0)="-A020 errors appearing on duplicate stop codes."
^DIC(9.4,48,22,5.28,"PAH",91,0)="141 SEQ #129^2980302^1"
^DIC(9.4,48,22,5.28,"PAH",91,1,0)="^^1^1^2980302"
^DIC(9.4,48,22,5.28,"PAH",91,1,1,0)="VA Health Services R&D Alzheimer's Project"
^DIC(9.4,48,22,5.28,"PAH",92,0)="138 SEQ #130^2980305^1"
^DIC(9.4,48,22,5.28,"PAH",92,1,0)="^^2^2^2980305"
^DIC(9.4,48,22,5.28,"PAH",92,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,48,22,5.28,"PAH",92,1,2,0)="of patch SD*5.3*138 in the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",93,0)="139 SEQ #131^2980318^1"
^DIC(9.4,48,22,5.28,"PAH",93,1,0)="^^1^1^2980318"
^DIC(9.4,48,22,5.28,"PAH",93,1,1,0)="ACRP Reports Module (phase 1)"
^DIC(9.4,48,22,5.28,"PAH",94,0)="140 SEQ #132^2980330^1"
^DIC(9.4,48,22,5.28,"PAH",94,1,0)="^^3^3^2980330"
^DIC(9.4,48,22,5.28,"PAH",94,1,1,0)="This patch makes the necessary modifications to Scheduling/PCMM"
^DIC(9.4,48,22,5.28,"PAH",94,1,2,0)="rotuines to meet the Year 2000 compliancy standards for date handling and"
^DIC(9.4,48,22,5.28,"PAH",94,1,3,0)="display.  See the patch description SD*5.3*140 for detailed information."
^DIC(9.4,48,22,5.28,"PAH",95,0)="145 SEQ #133^2980511^1"
^DIC(9.4,48,22,5.28,"PAH",95,1,0)="^^2^2^2980511"
