^DIC(9.4,33,22,1.4,"PAH",32,1,83,0)=" HLCSLM          NEW             6276510        49"
^DIC(9.4,33,22,1.4,"PAH",32,1,84,0)=" HLCSLNCH       11368535        12855635        6,19,43,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,85,0)=" HLCSLSM         NEW              154819        49"
^DIC(9.4,33,22,1.4,"PAH",32,1,86,0)=" HLCSMM1         1462301         1445162        35,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,87,0)=" HLCSMON         9506155        10703763        34,40,48,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,88,0)=" HLCSMON1        3987859         5535017        15,40,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,89,0)=" HLCSTCP         4005742         4550642        19,43,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,90,0)=" HLCSTCP2        7436704         7773433        19,43,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,91,0)=" HLCSTERM        2560922         2618931        40,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,92,0)=" HLDTIW2A        4178875         4164880        14,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,93,0)=" HLDTIW2B        5012027         5250753        14,19,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,94,0)=" HLDTIWP1        8445958         8449802        14,49"
^DIC(9.4,33,22,1.4,"PAH",32,1,95,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,96,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,97,0)="Installation Instructions: "
^DIC(9.4,33,22,1.4,"PAH",32,1,98,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",32,1,99,0)="  1.  Users are allowed to be on the system during the installation.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,100,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,101,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in "
^DIC(9.4,33,22,1.4,"PAH",32,1,102,0)="      the Routine Summary section are mapped, they should be removed from "
^DIC(9.4,33,22,1.4,"PAH",32,1,103,0)="      the mapped set at this time.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,104,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,105,0)="  3.  Shutdown all Logical Links and incoming and outgoing filers. Use the "
^DIC(9.4,33,22,1.4,"PAH",32,1,106,0)="      'Shut Down All Logical Links', 'Stop all incoming filers', and 'Stop "
^DIC(9.4,33,22,1.4,"PAH",32,1,107,0)="      all outgoing filers' options."
^DIC(9.4,33,22,1.4,"PAH",32,1,108,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,109,0)="      For DSM sites ONLY, if you have an HL7 UCX Service associated"
^DIC(9.4,33,22,1.4,"PAH",32,1,110,0)="      with the account(uci/directory) where you are installing this patch,"
^DIC(9.4,33,22,1.4,"PAH",32,1,111,0)="      please disable this service."
^DIC(9.4,33,22,1.4,"PAH",32,1,112,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,113,0)="  4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,33,22,1.4,"PAH",32,1,114,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,115,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,116,0)="  5.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,33,22,1.4,"PAH",32,1,117,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,118,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,33,22,1.4,"PAH",32,1,119,0)="      options: "
^DIC(9.4,33,22,1.4,"PAH",32,1,120,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,121,0)="         2 Verify Checksums in Transport Global "
^DIC(9.4,33,22,1.4,"PAH",32,1,122,0)="         3 Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",32,1,123,0)="         4 Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",32,1,124,0)="         5 Backup a Transport Global "
^DIC(9.4,33,22,1.4,"PAH",32,1,125,0)="         6 Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",32,1,126,0)="             INSTALL NAME: HL*1.6*49"
^DIC(9.4,33,22,1.4,"PAH",32,1,127,0)="                           ========="
^DIC(9.4,33,22,1.4,"PAH",32,1,128,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,33,22,1.4,"PAH",32,1,129,0)="         and Protocols?'.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,130,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,131,0)="  6.  Startup all Logical Links and incoming and outgoing filers. Use the "
^DIC(9.4,33,22,1.4,"PAH",32,1,132,0)="      'Restart All Links and Filers' option.  "
^DIC(9.4,33,22,1.4,"PAH",32,1,133,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,134,0)="      For DSM sites ONLY, if you previously disabled an HL7 UCX Service"
^DIC(9.4,33,22,1.4,"PAH",32,1,135,0)="      for this installation, you may now enable it."
^DIC(9.4,33,22,1.4,"PAH",32,1,136,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,137,0)="  7.  DSM Sites: Rebuild your mapped set if necessary."
^DIC(9.4,33,22,1.4,"PAH",32,1,138,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,139,0)="  8.  Start Link Manager as follows:"
^DIC(9.4,33,22,1.4,"PAH",32,1,140,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,141,0)=" STEP 1:  HL7 Main Menu"
^DIC(9.4,33,22,1.4,"PAH",32,1,142,0)=" STEP 2:  V1.6 OPTIONS"
^DIC(9.4,33,22,1.4,"PAH",32,1,143,0)=" STEP 3:  Communications Server"
^DIC(9.4,33,22,1.4,"PAH",32,1,144,0)=" STEP 4:  TCP/IP Link Manager Start/Stop"
^DIC(9.4,33,22,1.4,"PAH",32,1,145,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,146,0)="Link Manager is NOT currently running!"
^DIC(9.4,33,22,1.4,"PAH",32,1,147,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,148,0)=" Would you like to start the Link Manager now? YES// "
^DIC(9.4,33,22,1.4,"PAH",32,1,149,0)=" Link Manager queued as task number 2712635"
^DIC(9.4,33,22,1.4,"PAH",32,1,150,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,151,0)="  9.  Create entry in OPTION SCHEDULING file as follows:"
^DIC(9.4,33,22,1.4,"PAH",32,1,152,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,153,0)=" In order to set up this option to startup when the system/TaskMan starts,"
^DIC(9.4,33,22,1.4,"PAH",32,1,154,0)=" please find the following HL7 options to create an entry"
^DIC(9.4,33,22,1.4,"PAH",32,1,155,0)=" in the OPTION SCHEDULING file:"
^DIC(9.4,33,22,1.4,"PAH",32,1,156,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,157,0)=" STEP 1:  Taskman Management ...  "
^DIC(9.4,33,22,1.4,"PAH",32,1,158,0)=" STEP 2:  Schedule/Unschedule Options "
^DIC(9.4,33,22,1.4,"PAH",32,1,159,0)=" STEP 3 (Create the following entry): "
^DIC(9.4,33,22,1.4,"PAH",32,1,160,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,161,0)="Select OPTION to schedule or reschedule: HL AUTOSTART LINK MANAGER "
^DIC(9.4,33,22,1.4,"PAH",32,1,162,0)="  Are you adding 'HL AUTOSTART LINK MANAGER' as "
^DIC(9.4,33,22,1.4,"PAH",32,1,163,0)="    a new OPTION SCHEDULING (the 12TH)? No// Y "
^DIC(9.4,33,22,1.4,"PAH",32,1,164,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,165,0)=" STEP 4 (From STEP 3 you will automatically enter the FileMan ScreenMan form "
^DIC(9.4,33,22,1.4,"PAH",32,1,166,0)="        as follows and you should edit the 'SPECIAL QUEUEING' field "
^DIC(9.4,33,22,1.4,"PAH",32,1,167,0)="        to have a value of 'Startup Persistent'): "
^DIC(9.4,33,22,1.4,"PAH",32,1,168,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,169,0)="                          Edit Option Schedule"
^DIC(9.4,33,22,1.4,"PAH",32,1,170,0)="    Option Name: HL AUTOSTART LINK MANAGER     "
^DIC(9.4,33,22,1.4,"PAH",32,1,171,0)="    Menu Text: Autostart Link Manager                    TASK ID:"
^DIC(9.4,33,22,1.4,"PAH",32,1,172,0)="  __________________________________________________________________________"
^DIC(9.4,33,22,1.4,"PAH",32,1,173,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,174,0)="  QUEUED TO RUN AT WHAT TIME:"
^DIC(9.4,33,22,1.4,"PAH",32,1,175,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,176,0)="DEVICE FOR QUEUED JOB OUTPUT:"
^DIC(9.4,33,22,1.4,"PAH",32,1,177,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,178,0)=" QUEUED TO RUN ON VOLUME SET:"
^DIC(9.4,33,22,1.4,"PAH",32,1,179,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,180,0)="      RESCHEDULING FREQUENCY:"
^DIC(9.4,33,22,1.4,"PAH",32,1,181,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,182,0)="             TASK PARAMETERS:"
^DIC(9.4,33,22,1.4,"PAH",32,1,183,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,184,0)="            SPECIAL QUEUEING: Startup Persistent  "
^DIC(9.4,33,22,1.4,"PAH",32,1,185,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,186,0)="_______________________________________________________________________________"
^DIC(9.4,33,22,1.4,"PAH",32,1,187,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,188,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,189,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,190,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,191,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,192,0)="COMMAND:                                       Press <PF1>H for help    Insert "
^DIC(9.4,33,22,1.4,"PAH",32,1,193,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,194,0)="=============================================================================  "
^DIC(9.4,33,22,1.4,"PAH",32,1,195,0)="Data Dictionary Modifications: "
^DIC(9.4,33,22,1.4,"PAH",32,1,196,0)="============================== "
^DIC(9.4,33,22,1.4,"PAH",32,1,197,0)=" 869.2  HL LOWER LEVEL PROTOCOL PARAMETER "
^DIC(9.4,33,22,1.4,"PAH",32,1,198,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,199,0)="        400.05    RETENTION (NJ6,0), [400;5]  (new)"
^DIC(9.4,33,22,1.4,"PAH",32,1,200,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,201,0)=" 869.3  HL COMMUNICATION SERVER PARAMETERS"
^DIC(9.4,33,22,1.4,"PAH",32,1,202,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,203,0)="        51        DEFAULT RETENTION (NJ6,0), [5;1]  (new)"
^DIC(9.4,33,22,1.4,"PAH",32,1,204,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,205,0)="        52        LINK MANAGER TASK NUMBER (NJ15,0), [5;2]  (new)"
^DIC(9.4,33,22,1.4,"PAH",32,1,206,0)=" "
^DIC(9.4,33,22,1.4,"PAH",32,1,207,0)="        53        STOP LINK MANAGER (S), [5;3]  (new)"
^DIC(9.4,33,22,1.4,"PAH",32,1,208,0)=" "
