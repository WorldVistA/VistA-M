^DIC(9.4,47,22,5.9,"PAH",769,0)="981 SEQ #861^3191016.163112^65"
^DIC(9.4,47,22,5.9,"PAH",769,1,0)="^^3^3^3191016"
^DIC(9.4,47,22,5.9,"PAH",769,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - EHRM SUPPORT"
^DIC(9.4,47,22,5.9,"PAH",769,1,2,0)="Refer to patch DG*5.3*981 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",769,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",770,0)="984 SEQ #862^3191028.121639^65"
^DIC(9.4,47,22,5.9,"PAH",770,1,0)="^^3^3^3191028"
^DIC(9.4,47,22,5.9,"PAH",770,1,1,0)="Patch DG*5.3*984 modifies routine VAFHLZPD to use a different Application "
^DIC(9.4,47,22,5.9,"PAH",770,1,2,0)="Program Interface (API) call when retrieving the Homeless Indicator due "
^DIC(9.4,47,22,5.9,"PAH",770,1,3,0)="to the decommissioning of the Social Work (SOWK) package."
^DIC(9.4,47,22,5.9,"PAH",771,0)="982 SEQ #863^3191031.144238^65"
^DIC(9.4,47,22,5.9,"PAH",771,1,0)="^^2^2^3191031"
^DIC(9.4,47,22,5.9,"PAH",771,1,1,0)="Please see the DG*5.3*982 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",771,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",772,0)="972^3191206.155523^65"
^DIC(9.4,47,22,5.9,"PAH",772,1,0)="^^2^2^3191206"
^DIC(9.4,47,22,5.9,"PAH",772,1,1,0)="Please see the DG*5.3*972 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",772,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",773,0)="995^3191230.124659^65"
^DIC(9.4,47,22,5.9,"PAH",773,1,0)="^^4^4^3191230"
^DIC(9.4,47,22,5.9,"PAH",773,1,1,0)="The Means Test thresholds for Calendar Year 2020 are distributed with this"
^DIC(9.4,47,22,5.9,"PAH",773,1,2,0)="patch. The post-installation routine, DG53995P, will create a new subentry"
^DIC(9.4,47,22,5.9,"PAH",773,1,3,0)="(or replace an existing one) for calendar year 2020 in the MEANS TEST DATA"
^DIC(9.4,47,22,5.9,"PAH",773,1,4,0)="(#250) multiple field of the MAS PARAMETERS (#43) file."
^DIC(9.4,47,22,5.9,"PAH",774,0)="985^3200122.162128^65"
^DIC(9.4,47,22,5.9,"PAH",774,1,0)="^^2^2^3200122"
^DIC(9.4,47,22,5.9,"PAH",774,1,1,0)="Please see the DG*5.3*985 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",774,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",775,0)="952^3200220.141208^65"
^DIC(9.4,47,22,5.9,"PAH",775,1,0)="^^23^23^3200220"
^DIC(9.4,47,22,5.9,"PAH",775,1,1,0)="The patch is delivered in a bundle with IVM*2.0*184 and implements "
^DIC(9.4,47,22,5.9,"PAH",775,1,2,0)="EXPANDED MH CARE NON-ENROLLEES as a primary eligibility code (and a"
^DIC(9.4,47,22,5.9,"PAH",775,1,3,0)="Medical Administration Service (MAS) eligibility code) in VistA"
^DIC(9.4,47,22,5.9,"PAH",775,1,4,0)="Registration to identify and support Other Than Honorably (OTH) discharged"
^DIC(9.4,47,22,5.9,"PAH",775,1,5,0)="patients who need mental healthcare services, in order to help reduce the"
^DIC(9.4,47,22,5.9,"PAH",775,1,6,0)="number of Veteran suicides.  These patients are awaiting adjudication and"
^DIC(9.4,47,22,5.9,"PAH",775,1,7,0)="are entitled to receiving mental health treatment during that timeframe"
^DIC(9.4,47,22,5.9,"PAH",775,1,8,0)="from the VA either for 90-day episodes of care for service related"
^DIC(9.4,47,22,5.9,"PAH",775,1,9,0)="emergent mental health issues."
^DIC(9.4,47,22,5.9,"PAH",775,1,10,0)=" "
^DIC(9.4,47,22,5.9,"PAH",775,1,11,0)="This patch also introduces a sub-eligibility, which is implemented as a"
^DIC(9.4,47,22,5.9,"PAH",775,1,12,0)="new ""EXPANDED MH CARE TYPE"" field in VistA PATIENT file (#2), for EMERGENT"
^DIC(9.4,47,22,5.9,"PAH",775,1,13,0)="MH OTH type that supports providing mental health care in one or more"
^DIC(9.4,47,22,5.9,"PAH",775,1,14,0)="90-day periods (additional periods require authorization) for eligible"
^DIC(9.4,47,22,5.9,"PAH",775,1,15,0)="patients."
^DIC(9.4,47,22,5.9,"PAH",775,1,16,0)=" "
^DIC(9.4,47,22,5.9,"PAH",775,1,17,0)="This patch also introduces supportive reporting to identify those patients"
^DIC(9.4,47,22,5.9,"PAH",775,1,18,0)="registered as ""EMERGENT MH OTH"" (abbreviated as OTH-90). "
^DIC(9.4,47,22,5.9,"PAH",775,1,19,0)=" "
^DIC(9.4,47,22,5.9,"PAH",775,1,20,0)="HL7 messaging has been updated in this patch to ensure VistA Registration "
^DIC(9.4,47,22,5.9,"PAH",775,1,21,0)="changes are communicated to the Enrollment System (ES). OTH patient data"
^DIC(9.4,47,22,5.9,"PAH",775,1,22,0)="will be shared with ES and if a patient record is updated in ES, it will "
^DIC(9.4,47,22,5.9,"PAH",775,1,23,0)="continue to be updated in VistA."
^DIC(9.4,47,22,5.9,"PAH",776,0)="989 SEQ #868^3200228.125842^65"
^DIC(9.4,47,22,5.9,"PAH",776,1,0)="^^4^4^3200228"
^DIC(9.4,47,22,5.9,"PAH",776,1,1,0)="Patch DG*5.3*989 will update the QRD segment of an HL7 Z11 query message"
^DIC(9.4,47,22,5.9,"PAH",776,1,2,0)="to pass in the Integration Control Number (ICN) (#991.01) field of the"
^DIC(9.4,47,22,5.9,"PAH",776,1,3,0)="Patient (#2) file as requested by the Enrollment System Redesign (ESR)"
^DIC(9.4,47,22,5.9,"PAH",776,1,4,0)="team."
^DIC(9.4,47,22,5.9,"PAH",777,0)="1002 SEQ #869^3200302.154129^65"
^DIC(9.4,47,22,5.9,"PAH",777,1,0)="^^3^3^3200302"
