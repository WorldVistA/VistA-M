^DIC(9.4,14,22,5.9,"PAH",176,1,115,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",176,1,116,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",176,1,117,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",176,1,118,0)="  of each of these routines now looks like:"
