^DIC(9.4,13,22,7,"PAH",32,1,49,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",32,1,50,0)="  DIO4           5969086         6003254         54"
^DIC(9.4,13,22,7,"PAH",32,1,51,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,52,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,53,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",32,1,54,0)="=========================="
^DIC(9.4,13,22,7,"PAH",32,1,55,0)="This patch can be installed with VISTA users online.  However, it is "
^DIC(9.4,13,22,7,"PAH",32,1,56,0)="recommended that it be Queued for a time of generally least activity."
^DIC(9.4,13,22,7,"PAH",32,1,57,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,58,0)="     1.  AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,13,22,7,"PAH",32,1,59,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, they should"
^DIC(9.4,13,22,7,"PAH",32,1,60,0)="be removed from the mapped set at this time."
^DIC(9.4,13,22,7,"PAH",32,1,61,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,62,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,13,22,7,"PAH",32,1,63,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",32,1,64,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,65,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",32,1,66,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,7,"PAH",32,1,67,0)="  "
^DIC(9.4,13,22,7,"PAH",32,1,68,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",32,1,69,0)="following options:"
^DIC(9.4,13,22,7,"PAH",32,1,70,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",32,1,71,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",32,1,72,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",32,1,73,0)="            Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",32,1,74,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,75,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",32,1,76,0)="following option:"
^DIC(9.4,13,22,7,"PAH",32,1,77,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",32,1,78,0)="            Select INSTALL NAME: DI*21.0*54"
^DIC(9.4,13,22,7,"PAH",32,1,79,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",32,1,80,0)="  "
^DIC(9.4,13,22,7,"PAH",32,1,81,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",32,1,82,0)="Options, and Protocols?"
^DIC(9.4,13,22,7,"PAH",32,1,83,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,84,0)="     6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,13,22,7,"PAH",32,1,85,0)="other CPUs?'.  Then enter the names of your other Compute and Print "
^DIC(9.4,13,22,7,"PAH",32,1,86,0)="server(s)."
^DIC(9.4,13,22,7,"PAH",32,1,87,0)=" "
^DIC(9.4,13,22,7,"PAH",32,1,88,0)="     7.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,7,"PAH",32,1,89,0)="set, if necessary."
^DIC(9.4,13,22,7,"PAH",33,0)="50 SEQ #48^2981026^1"
^DIC(9.4,13,22,7,"PAH",33,1,0)="^^94^94^2981026"
^DIC(9.4,13,22,7,"PAH",33,1,1,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,2,0)="                         Notice:"
^DIC(9.4,13,22,7,"PAH",33,1,3,0)="    ** This patch should be installed with NO users online ** "
^DIC(9.4,13,22,7,"PAH",33,1,4,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,5,0)="Background: PreKIDS - when packages were installed, a set of routines were"
^DIC(9.4,13,22,7,"PAH",33,1,6,0)="created by the developer(s) to export Data Dictionary changes."
^DIC(9.4,13,22,7,"PAH",33,1,7,0)="  "
^DIC(9.4,13,22,7,"PAH",33,1,8,0)="These were in the form of <nmsp>INIT.  From the programmer prompt you "
^DIC(9.4,13,22,7,"PAH",33,1,9,0)="would D ^<nmsp>INIT, i.e. D ^ABCINIT, and the package would be installed "
^DIC(9.4,13,22,7,"PAH",33,1,10,0)="onto your system. The problem was that if a developer changed the name of "
^DIC(9.4,13,22,7,"PAH",33,1,11,0)="a file or subfile the INIT would add another 'NM' node, instead of "
^DIC(9.4,13,22,7,"PAH",33,1,12,0)="removing the old 'NM' node and then adding the new node.  "
^DIC(9.4,13,22,7,"PAH",33,1,13,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,14,0)="This patch corrects these duplicate ""NM"" nodes located in: "
^DIC(9.4,13,22,7,"PAH",33,1,15,0)="^DD(<file/subfile#>,0,""NM"",<file name>)="""" "
^DIC(9.4,13,22,7,"PAH",33,1,16,0)="using the same logic that FileMan Option: "
^DIC(9.4,13,22,7,"PAH",33,1,17,0)="Check/Fix DD Structure [DI DDUCHK] uses when Fix is specified.  "
^DIC(9.4,13,22,7,"PAH",33,1,18,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,19,0)="The routine DIPR50 loops through all of the DHCP files, looking for "
^DIC(9.4,13,22,7,"PAH",33,1,20,0)="duplicate ""NM"" nodes and corrects any duplicates that are found.  The"
^DIC(9.4,13,22,7,"PAH",33,1,21,0)="following is a sample dialog when a duplicate 'NM' node is encountered:"
^DIC(9.4,13,22,7,"PAH",33,1,22,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,23,0)="File/Subfile: 662001 has duplicate 'NM' nodes."
^DIC(9.4,13,22,7,"PAH",33,1,24,0)="     Duplicate 'NM' node(s) were deleted and fixed."
^DIC(9.4,13,22,7,"PAH",33,1,25,0)="        'NM' node will be set to: ZZTAMI TEST"
^DIC(9.4,13,22,7,"PAH",33,1,26,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,27,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,28,0)="Related NOIS: "
^DIC(9.4,13,22,7,"PAH",33,1,29,0)="============="
^DIC(9.4,13,22,7,"PAH",33,1,30,0)="CTX-0397-71390 "
^DIC(9.4,13,22,7,"PAH",33,1,31,0)="TUA-0798-31699 "
^DIC(9.4,13,22,7,"PAH",33,1,32,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,33,0)="Thanks to Test Sites: "
^DIC(9.4,13,22,7,"PAH",33,1,34,0)="====================="
^DIC(9.4,13,22,7,"PAH",33,1,35,0)="Clarksburg, WV"
^DIC(9.4,13,22,7,"PAH",33,1,36,0)="Tuscaloosa, AL "
^DIC(9.4,13,22,7,"PAH",33,1,37,0)="Central Texas HCS "
^DIC(9.4,13,22,7,"PAH",33,1,38,0)="Dayton, OH"
^DIC(9.4,13,22,7,"PAH",33,1,39,0)="Several CIOFOs"
^DIC(9.4,13,22,7,"PAH",33,1,40,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,41,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",33,1,42,0)="================"
^DIC(9.4,13,22,7,"PAH",33,1,43,0)="The following routine is included in this patch.  The second line of "
^DIC(9.4,13,22,7,"PAH",33,1,44,0)="this routine looks like: "
^DIC(9.4,13,22,7,"PAH",33,1,45,0)="<tab>;;21.0;VA FileMan;[patch list];Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",33,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,47,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",33,1,48,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,49,0)="Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",33,1,50,0)="============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",33,1,51,0)="DIPR50         N/A             982490          50 "
^DIC(9.4,13,22,7,"PAH",33,1,52,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,53,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",33,1,54,0)="=========================="
^DIC(9.4,13,22,7,"PAH",33,1,55,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,56,0)="        1.  There is no routine mapping involved.  "
^DIC(9.4,13,22,7,"PAH",33,1,57,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,58,0)="        2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  "
^DIC(9.4,13,22,7,"PAH",33,1,59,0)="This option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,7,"PAH",33,1,60,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,61,0)="        3.  The patch has now been loaded into a transport global on your "
^DIC(9.4,13,22,7,"PAH",33,1,62,0)="system.  You now need to use KIDS to finish the preperation for "
^DIC(9.4,13,22,7,"PAH",33,1,63,0)="installation.  "
^DIC(9.4,13,22,7,"PAH",33,1,64,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,65,0)="        4.  Optionally on the KIDS menu, under the 'Installation menu', "
^DIC(9.4,13,22,7,"PAH",33,1,66,0)="use the following options: "
^DIC(9.4,13,22,7,"PAH",33,1,67,0)="                Print Transport Global "
^DIC(9.4,13,22,7,"PAH",33,1,68,0)="                Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",33,1,69,0)="                Verify Checksums in Transport Global.  "
^DIC(9.4,13,22,7,"PAH",33,1,70,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,71,0)="     5.  Inhibit users' login into the system.  The consequence of having "
^DIC(9.4,13,22,7,"PAH",33,1,72,0)="users on the system while installing this patch are that users editing "
^DIC(9.4,13,22,7,"PAH",33,1,73,0)="records will get an Undefined error, the edits will be lost and records "
^DIC(9.4,13,22,7,"PAH",33,1,74,0)="may be left in an inconsistent state.  Note that most of these "
^DIC(9.4,13,22,7,"PAH",33,1,75,0)="DD's are heavily used in DHCP applications.  "
^DIC(9.4,13,22,7,"PAH",33,1,76,0)="  "
^DIC(9.4,13,22,7,"PAH",33,1,77,0)="     6.  AXP Sites - Place Taskman in a WAIT State.  "
^DIC(9.4,13,22,7,"PAH",33,1,78,0)="         MSM Sites - STOP Taskman.  "
^DIC(9.4,13,22,7,"PAH",33,1,79,0)="  "
^DIC(9.4,13,22,7,"PAH",33,1,80,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,7,"PAH",33,1,81,0)="following option: "
^DIC(9.4,13,22,7,"PAH",33,1,82,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",33,1,83,0)="            Select INSTALL NAME: DI*21.0*50 "
^DIC(9.4,13,22,7,"PAH",33,1,84,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",33,1,85,0)="  "
^DIC(9.4,13,22,7,"PAH",33,1,86,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,13,22,7,"PAH",33,1,87,0)="Options, and Protocols? "
^DIC(9.4,13,22,7,"PAH",33,1,88,0)="Note to MSM Sites - Answer NO to the question 'Want to MOVE routines to "
^DIC(9.4,13,22,7,"PAH",33,1,89,0)="other CPUs?'.  "
^DIC(9.4,13,22,7,"PAH",33,1,90,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,91,0)="        8.  Restart TaskMan, any background filers, and reenable user "
^DIC(9.4,13,22,7,"PAH",33,1,92,0)="logons.  "
^DIC(9.4,13,22,7,"PAH",33,1,93,0)=" "
^DIC(9.4,13,22,7,"PAH",33,1,94,0)="        9. You may now delete DIPR50.  "
^DIC(9.4,13,22,7,"PAH",34,0)="52 SEQ #49^2981214^1"
^DIC(9.4,13,22,7,"PAH",34,1,0)="^^104^104^2981214"
^DIC(9.4,13,22,7,"PAH",34,1,1,0)="Bug Fixes"
^DIC(9.4,13,22,7,"PAH",34,1,2,0)="========="
^DIC(9.4,13,22,7,"PAH",34,1,3,0)="1. If a computed field expression was too complex for DICOMP to interpret,"
^DIC(9.4,13,22,7,"PAH",34,1,4,0)="an error would result. With this patch, if an expression that is too"
^DIC(9.4,13,22,7,"PAH",34,1,5,0)="complex is entered, a beep and '??' will be displayed."
^DIC(9.4,13,22,7,"PAH",34,1,6,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,7,0)="2. If a backward extended pointer was used, and the name of the file"
^DIC(9.4,13,22,7,"PAH",34,1,8,0)="contained a '/', the expression was rejected with a beep and '??'."
^DIC(9.4,13,22,7,"PAH",34,1,9,0)="For example:"
^DIC(9.4,13,22,7,"PAH",34,1,10,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,11,0)="Select OPTION: PRINT FILE ENTRIES  "
^DIC(9.4,13,22,7,"PAH",34,1,12,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,13,0)="OUTPUT FROM WHAT FILE: PATIENT// "
^DIC(9.4,13,22,7,"PAH",34,1,14,0)="SORT BY: NAME// RAD/NUC MED PATIENT:"
^DIC(9.4,13,22,7,"PAH",34,1,15,0)="   By 'RAD', do you mean the RAD/NUC MED PATIENT File,"
^DIC(9.4,13,22,7,"PAH",34,1,16,0)="       pointing via its 'NAME' Field? Yes//   (Yes)??"
^DIC(9.4,13,22,7,"PAH",34,1,17,0)="SORT BY: NAME// "
^DIC(9.4,13,22,7,"PAH",34,1,18,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,19,0)="This problem is fixed with this patch."
^DIC(9.4,13,22,7,"PAH",34,1,20,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,21,0)="3. When 2 separate fields are defined as Pointer to a File and they point"
^DIC(9.4,13,22,7,"PAH",34,1,22,0)="to the same file and they are printed one after each other, an error would"
^DIC(9.4,13,22,7,"PAH",34,1,23,0)="occur.  For example:"
^DIC(9.4,13,22,7,"PAH",34,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,25,0)="Select OPTION: PRINT FILE ENTRIES"
^DIC(9.4,13,22,7,"PAH",34,1,26,0)="OUTPUT FROM WHAT FILE: S0 TEST #1// "
^DIC(9.4,13,22,7,"PAH",34,1,27,0)="SORT BY: NAME// "
^DIC(9.4,13,22,7,"PAH",34,1,28,0)="START WITH NAME: FIRST// "
^DIC(9.4,13,22,7,"PAH",34,1,29,0)="FIRST PRINT FIELD: PT200A:"
^DIC(9.4,13,22,7,"PAH",34,1,30,0)="  THEN PRINT NEW PERSON FIELD: SSN    "
^DIC(9.4,13,22,7,"PAH",34,1,31,0)="  THEN PRINT NEW PERSON FIELD: "
^DIC(9.4,13,22,7,"PAH",34,1,32,0)="THEN PRINT FIELD: PT200B:"
^DIC(9.4,13,22,7,"PAH",34,1,33,0)="  THEN PRINT NEW PERSON FIELD: SSN    "
^DIC(9.4,13,22,7,"PAH",34,1,34,0)="  THEN PRINT NEW PERSON FIELD: "
^DIC(9.4,13,22,7,"PAH",34,1,35,0)="THEN PRINT FIELD: "
^DIC(9.4,13,22,7,"PAH",34,1,36,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,37,0)="NOISes"
^DIC(9.4,13,22,7,"PAH",34,1,38,0)="======"
^DIC(9.4,13,22,7,"PAH",34,1,39,0)="BRX-1297-10331"
^DIC(9.4,13,22,7,"PAH",34,1,40,0)="BRX-0397-12607"
^DIC(9.4,13,22,7,"PAH",34,1,41,0)="WRJ-0497-10294"
^DIC(9.4,13,22,7,"PAH",34,1,42,0)="DAY-0997-40744"
^DIC(9.4,13,22,7,"PAH",34,1,43,0)="REN-1097-61379"
^DIC(9.4,13,22,7,"PAH",34,1,44,0)="WBP-0196-21370"
^DIC(9.4,13,22,7,"PAH",34,1,45,0)="BRX-0995-11874"
^DIC(9.4,13,22,7,"PAH",34,1,46,0)="FNC-0494-30103"
^DIC(9.4,13,22,7,"PAH",34,1,47,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,48,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,49,0)="Thanks to Test Sites"
^DIC(9.4,13,22,7,"PAH",34,1,50,0)="===================="
^DIC(9.4,13,22,7,"PAH",34,1,51,0)="White River Junction, VT"
^DIC(9.4,13,22,7,"PAH",34,1,52,0)="Bronx, NY"
^DIC(9.4,13,22,7,"PAH",34,1,53,0)="Dayton, OH"
^DIC(9.4,13,22,7,"PAH",34,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,55,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",34,1,56,0)="================"
^DIC(9.4,13,22,7,"PAH",34,1,57,0)=" The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,7,"PAH",34,1,58,0)="these routines now look like:"
^DIC(9.4,13,22,7,"PAH",34,1,59,0)="  "
^DIC(9.4,13,22,7,"PAH",34,1,60,0)="  <tab>;;21.0;VA FileMan;**[patch list]**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",34,1,61,0)="  "
^DIC(9.4,13,22,7,"PAH",34,1,62,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",34,1,63,0)="  "
^DIC(9.4,13,22,7,"PAH",34,1,64,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",34,1,65,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",34,1,66,0)="  DICOMP1        6095234         6197157         52"
^DIC(9.4,13,22,7,"PAH",34,1,67,0)="  DICOMPV        7196555         7170031         13,52"
^DIC(9.4,13,22,7,"PAH",34,1,68,0)="  DICOMPW        8864346         8886232         52"
^DIC(9.4,13,22,7,"PAH",34,1,69,0)="  DICOMPX        3767023         3939321         24,52"
^DIC(9.4,13,22,7,"PAH",34,1,70,0)="  DIL1           6752508         6849303         52 "
^DIC(9.4,13,22,7,"PAH",34,1,71,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,72,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",34,1,73,0)="=========================="
^DIC(9.4,13,22,7,"PAH",34,1,74,0)="This patch can be installed with VISTA users online.  However, it is "
^DIC(9.4,13,22,7,"PAH",34,1,75,0)="recommended that it be Queued for a time of generally least activity."
^DIC(9.4,13,22,7,"PAH",34,1,76,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,77,0)="     1.  AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,13,22,7,"PAH",34,1,78,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, they should"
^DIC(9.4,13,22,7,"PAH",34,1,79,0)="be removed from the mapped set at this time."
^DIC(9.4,13,22,7,"PAH",34,1,80,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,81,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,13,22,7,"PAH",34,1,82,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",34,1,83,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,84,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",34,1,85,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,7,"PAH",34,1,86,0)="  "
^DIC(9.4,13,22,7,"PAH",34,1,87,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",34,1,88,0)="following options:"
^DIC(9.4,13,22,7,"PAH",34,1,89,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",34,1,90,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",34,1,91,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",34,1,92,0)="            Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",34,1,93,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,94,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",34,1,95,0)="following option:"
^DIC(9.4,13,22,7,"PAH",34,1,96,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",34,1,97,0)="            Select INSTALL NAME: DI*21.0*52"
^DIC(9.4,13,22,7,"PAH",34,1,98,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",34,1,99,0)="  "
^DIC(9.4,13,22,7,"PAH",34,1,100,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",34,1,101,0)="Options, and Protocols?"
^DIC(9.4,13,22,7,"PAH",34,1,102,0)=" "
^DIC(9.4,13,22,7,"PAH",34,1,103,0)="     6.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,7,"PAH",34,1,104,0)="set, if necessary."
^DIC(9.4,13,22,7,"PAH",35,0)="49 SEQ #50^2990105^1"
^DIC(9.4,13,22,7,"PAH",35,1,0)="^^107^107^2990105"
^DIC(9.4,13,22,7,"PAH",35,1,1,0)=" Description:"
^DIC(9.4,13,22,7,"PAH",35,1,2,0)=" ============"
^DIC(9.4,13,22,7,"PAH",35,1,3,0)=" ** NOTICE: It is HIGHLY recommended that all users be logged off the"
^DIC(9.4,13,22,7,"PAH",35,1,4,0)=" VistA system. **"
^DIC(9.4,13,22,7,"PAH",35,1,5,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,6,0)=" Prior to this change, VAL^DIE and the DBS calls that use it, like"
^DIC(9.4,13,22,7,"PAH",35,1,7,0)=" UPDATE^DIE and FILE^DIE, were returning Dialog Error message #701 when an"
^DIC(9.4,13,22,7,"PAH",35,1,8,0)=" external form of a set of codes field was passed in, but the external"
^DIC(9.4,13,22,7,"PAH",35,1,9,0)=" code was ambiguous."
^DIC(9.4,13,22,7,"PAH",35,1,10,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,11,0)=" For example, if the codes are:"
^DIC(9.4,13,22,7,"PAH",35,1,12,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,13,0)="     &       AND"
^DIC(9.4,13,22,7,"PAH",35,1,14,0)="     &'      AND NOT"
^DIC(9.4,13,22,7,"PAH",35,1,15,0)="     !       OR"
^DIC(9.4,13,22,7,"PAH",35,1,16,0)="     !'      OR NOT"
^DIC(9.4,13,22,7,"PAH",35,1,17,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,18,0)=" and the value 'AND' is passed to the Updater with ""E"" flag, the message:"
^DIC(9.4,13,22,7,"PAH",35,1,19,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,20,0)="     The value 'AND' for field xxxxx in file xxxxx is not valid."
^DIC(9.4,13,22,7,"PAH",35,1,21,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,22,0)=" With this change, if the external code is ambiguous but exact, the value"
^DIC(9.4,13,22,7,"PAH",35,1,23,0)=" is accepted.  Also, display a 4-digit year in the prompt for a Date read,"
^DIC(9.4,13,22,7,"PAH",35,1,24,0)=" when an earliest and latest date are specified or in the error message"
^DIC(9.4,13,22,7,"PAH",35,1,25,0)=" when the date entered is out of the specified range."
^DIC(9.4,13,22,7,"PAH",35,1,26,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,27,0)=" NOIS:"
^DIC(9.4,13,22,7,"PAH",35,1,28,0)=" ====="
^DIC(9.4,13,22,7,"PAH",35,1,29,0)=" DAY-0698-41519"
^DIC(9.4,13,22,7,"PAH",35,1,30,0)=" ISL-1297-50203"
^DIC(9.4,13,22,7,"PAH",35,1,31,0)=" MIA-0698-31649"
^DIC(9.4,13,22,7,"PAH",35,1,32,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,33,0)=" Thanks to Test Sites:"
^DIC(9.4,13,22,7,"PAH",35,1,34,0)=" ====================="
^DIC(9.4,13,22,7,"PAH",35,1,35,0)=" Dayton, OH"
^DIC(9.4,13,22,7,"PAH",35,1,36,0)=" Salt Lake City CIOFO"
^DIC(9.4,13,22,7,"PAH",35,1,37,0)=" Fargo, ND"
^DIC(9.4,13,22,7,"PAH",35,1,38,0)=" Clarksburg, WV"
^DIC(9.4,13,22,7,"PAH",35,1,39,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,40,0)=" Routine Summary: "
^DIC(9.4,13,22,7,"PAH",35,1,41,0)=" ================"
^DIC(9.4,13,22,7,"PAH",35,1,42,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,43,0)=" The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,7,"PAH",35,1,44,0)=" these routines now look like:"
^DIC(9.4,13,22,7,"PAH",35,1,45,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,46,0)="   <tab>;;21.0;VA FileMan;**[patch list]**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",35,1,47,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,48,0)=" CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",35,1,49,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,50,0)=" Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",35,1,51,0)=" ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",35,1,52,0)=" DIR1           7982983         8449705         6,13,19,41,49"
^DIC(9.4,13,22,7,"PAH",35,1,53,0)=" DIR2           9053765         9159183         41,49"
^DIC(9.4,13,22,7,"PAH",35,1,54,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,55,0)=" Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",35,1,56,0)=" =========================="
^DIC(9.4,13,22,7,"PAH",35,1,57,0)=" ** It is HIGHLY recommended that ALL Users and VISTA Background jobs to"
^DIC(9.4,13,22,7,"PAH",35,1,58,0)=" be STOPPED.  Failure to do so may result in a 'source routine edited'"
^DIC(9.4,13,22,7,"PAH",35,1,59,0)=" error, the edits will be lost and records may be left in an inconsistent"
^DIC(9.4,13,22,7,"PAH",35,1,60,0)=" state. **"
^DIC(9.4,13,22,7,"PAH",35,1,61,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,62,0)="     1.  AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,13,22,7,"PAH",35,1,63,0)=" routine(s) listed in the ROUTINE SUMMARY section are mapped, they should "
^DIC(9.4,13,22,7,"PAH",35,1,64,0)=" be removed from the mapped set at this time.  "
^DIC(9.4,13,22,7,"PAH",35,1,65,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,66,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,13,22,7,"PAH",35,1,67,0)=" option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,7,"PAH",35,1,68,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,69,0)=" The environment check routine DIENVWRN will run automatically.  Routine"
^DIC(9.4,13,22,7,"PAH",35,1,70,0)=" DIENVWRN is sent in order to prevent the inadvertent queuing during the "
^DIC(9.4,13,22,7,"PAH",35,1,71,0)=" installation of this patch.  "
^DIC(9.4,13,22,7,"PAH",35,1,72,0)="   "
^DIC(9.4,13,22,7,"PAH",35,1,73,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",35,1,74,0)=" system. You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,7,"PAH",35,1,75,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,76,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",35,1,77,0)=" following options: "
^DIC(9.4,13,22,7,"PAH",35,1,78,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",35,1,79,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",35,1,80,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",35,1,81,0)="            Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",35,1,82,0)=" "
^DIC(9.4,13,22,7,"PAH",35,1,83,0)="     5.  Inhibit users' login into the system.  The consequence of having"
^DIC(9.4,13,22,7,"PAH",35,1,84,0)=" users on the system while installing this patch are that users editing"
^DIC(9.4,13,22,7,"PAH",35,1,85,0)=" records will get a 'source routine edited' error, the edits will be lost"
^DIC(9.4,13,22,7,"PAH",35,1,86,0)=" and records may be left in an inconsistent state.  Note that most of"
^DIC(9.4,13,22,7,"PAH",35,1,87,0)=" these routines are heavily used in DHCP applications.  "
^DIC(9.4,13,22,7,"PAH",35,1,88,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,89,0)="     6.  AXP Sites - Place Taskman in a WAIT State.  "
^DIC(9.4,13,22,7,"PAH",35,1,90,0)="         OpenM/Cache Sites - STOP Taskman.  "
^DIC(9.4,13,22,7,"PAH",35,1,91,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,92,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",35,1,93,0)=" following option:"
^DIC(9.4,13,22,7,"PAH",35,1,94,0)="         Select Installation Option: Install Package(s)"
^DIC(9.4,13,22,7,"PAH",35,1,95,0)="         Select INSTALL NAME: DI*21.0*49"
^DIC(9.4,13,22,7,"PAH",35,1,96,0)="                              =========="
^DIC(9.4,13,22,7,"PAH",35,1,97,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,98,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,13,22,7,"PAH",35,1,99,0)=" and Protocols? "
^DIC(9.4,13,22,7,"PAH",35,1,100,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,101,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,7,"PAH",35,1,102,0)=" set, if necessary. "
^DIC(9.4,13,22,7,"PAH",35,1,103,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,104,0)="     9.  AXP Sites - Remove Taskman from WAIT State.  "
^DIC(9.4,13,22,7,"PAH",35,1,105,0)="         OpenM/Cache Sites - Restart Taskman.  "
^DIC(9.4,13,22,7,"PAH",35,1,106,0)="  "
^DIC(9.4,13,22,7,"PAH",35,1,107,0)="    10.  Enable users' login."
^DIC(9.4,13,22,7,"PAH",36,0)="57 SEQ #51^2990316^1"
^DIC(9.4,13,22,7,"PAH",36,1,0)="^^89^89^2990316"
^DIC(9.4,13,22,7,"PAH",36,1,1,0)="        ** NOTICE: It is HIGHLY recommended that all users be logged off"
^DIC(9.4,13,22,7,"PAH",36,1,2,0)="                   the VistA system. **"
^DIC(9.4,13,22,7,"PAH",36,1,3,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,4,0)="Bug Fix"
^DIC(9.4,13,22,7,"PAH",36,1,5,0)="======="
^DIC(9.4,13,22,7,"PAH",36,1,6,0)="This patch fixes the following problem: "
^DIC(9.4,13,22,7,"PAH",36,1,7,0)="  When a user answered the Alert prompt for what action to take, they"
^DIC(9.4,13,22,7,"PAH",36,1,8,0)="could inadvertenly enter a control character (i.e. BackSpace, Tab) which"
^DIC(9.4,13,22,7,"PAH",36,1,9,0)="would cause a looping within the DIR* routines.  This patch corrects that"
^DIC(9.4,13,22,7,"PAH",36,1,10,0)="problem."
^DIC(9.4,13,22,7,"PAH",36,1,11,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,12,0)="NOIS"
^DIC(9.4,13,22,7,"PAH",36,1,13,0)="===="
^DIC(9.4,13,22,7,"PAH",36,1,14,0)="CLA-1298-20489"
^DIC(9.4,13,22,7,"PAH",36,1,15,0)="MUS-1298-70900"
^DIC(9.4,13,22,7,"PAH",36,1,16,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,17,0)="Thanks to Test Sites"
^DIC(9.4,13,22,7,"PAH",36,1,18,0)="===================="
^DIC(9.4,13,22,7,"PAH",36,1,19,0)="Martinez, CA"
^DIC(9.4,13,22,7,"PAH",36,1,20,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,22,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",36,1,23,0)="================"
^DIC(9.4,13,22,7,"PAH",36,1,24,0)=" The following routines are included in this patch.  The second line of"
^DIC(9.4,13,22,7,"PAH",36,1,25,0)="these routines now look like:"
^DIC(9.4,13,22,7,"PAH",36,1,26,0)="  "
^DIC(9.4,13,22,7,"PAH",36,1,27,0)="  <tab>;;21.0;VA FileMan;**[patch list]**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",36,1,28,0)="  "
^DIC(9.4,13,22,7,"PAH",36,1,29,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",36,1,30,0)="  "
^DIC(9.4,13,22,7,"PAH",36,1,31,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",36,1,32,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",36,1,33,0)="  DIR1           8449705         8500908         6,13,19,41,49,57 "
^DIC(9.4,13,22,7,"PAH",36,1,34,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,35,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",36,1,36,0)="=========================="
^DIC(9.4,13,22,7,"PAH",36,1,37,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,38,0)="** It is HIGHLY recommended that ALL Users and VISTA Background jobs to be"
^DIC(9.4,13,22,7,"PAH",36,1,39,0)="   STOPPED.  Failure to do so may result in a 'source routine edited'"
^DIC(9.4,13,22,7,"PAH",36,1,40,0)="   error, the edits will be lost and records may be left in an"
^DIC(9.4,13,22,7,"PAH",36,1,41,0)="   inconsistent state. **"
^DIC(9.4,13,22,7,"PAH",36,1,42,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,43,0)="     1.  AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,13,22,7,"PAH",36,1,44,0)="routine(s) listed in the ROUTINE SUMMARY section are mapped, they should"
^DIC(9.4,13,22,7,"PAH",36,1,45,0)="be removed from the mapped set at this time."
^DIC(9.4,13,22,7,"PAH",36,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,47,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,13,22,7,"PAH",36,1,48,0)="option will load the KIDS package onto your system."
^DIC(9.4,13,22,7,"PAH",36,1,49,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,50,0)="The environment check routine DIENVWRN will run automatically.  Routine"
^DIC(9.4,13,22,7,"PAH",36,1,51,0)="DIENVWRN is sent in order to prevent the inadvertent queueing during the"
^DIC(9.4,13,22,7,"PAH",36,1,52,0)="installation of this patch."
^DIC(9.4,13,22,7,"PAH",36,1,53,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,54,0)="     3.  The patch has now been loaded into a transport global on your"
^DIC(9.4,13,22,7,"PAH",36,1,55,0)="system. You now need to use KIDS to install the transport global."
^DIC(9.4,13,22,7,"PAH",36,1,56,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,57,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",36,1,58,0)="following options:"
^DIC(9.4,13,22,7,"PAH",36,1,59,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",36,1,60,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",36,1,61,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",36,1,62,0)="            Backup a Transport Global"
^DIC(9.4,13,22,7,"PAH",36,1,63,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,64,0)="     5.  Inhibit users' login into the system.  The consequence of having"
^DIC(9.4,13,22,7,"PAH",36,1,65,0)="users on the system while installing this patch are that users editing"
^DIC(9.4,13,22,7,"PAH",36,1,66,0)="records will get a 'source routine edited' error, the edits will be lost"
^DIC(9.4,13,22,7,"PAH",36,1,67,0)="and records may be left in an inconsistent state.  Note that most of these"
^DIC(9.4,13,22,7,"PAH",36,1,68,0)="routines are heavily used in DHCP applications."
^DIC(9.4,13,22,7,"PAH",36,1,69,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,70,0)="     6.  AXP Sites - Place Taskman in a WAIT State.  "
^DIC(9.4,13,22,7,"PAH",36,1,71,0)="         OpenM/Cache Sites - STOP Taskman.  "
^DIC(9.4,13,22,7,"PAH",36,1,72,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,73,0)="     7.  On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,13,22,7,"PAH",36,1,74,0)="following option:"
^DIC(9.4,13,22,7,"PAH",36,1,75,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",36,1,76,0)="            Select INSTALL NAME: DI*21.0*57"
^DIC(9.4,13,22,7,"PAH",36,1,77,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",36,1,78,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,79,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,13,22,7,"PAH",36,1,80,0)="Options, and Protocols?"
^DIC(9.4,13,22,7,"PAH",36,1,81,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,82,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,83,0)="     8.  AXP Sites - After the patch has been installed, rebuild your map"
^DIC(9.4,13,22,7,"PAH",36,1,84,0)="set, if necessary. "
^DIC(9.4,13,22,7,"PAH",36,1,85,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,86,0)="     9.  AXP Sites - Remove Taskman from WAIT State.  "
^DIC(9.4,13,22,7,"PAH",36,1,87,0)="         OpenM/Cache Sites - Restart Taskman.  "
^DIC(9.4,13,22,7,"PAH",36,1,88,0)=" "
^DIC(9.4,13,22,7,"PAH",36,1,89,0)="    10.  Enable users' login."
^DIC(9.4,13,22,7,"PAH",37,0)="58 SEQ #52^2990510^1"
^DIC(9.4,13,22,7,"PAH",37,1,0)="^^74^74^2990510"
^DIC(9.4,13,22,7,"PAH",37,1,1,0)="Bug Fix"
^DIC(9.4,13,22,7,"PAH",37,1,2,0)="======="
^DIC(9.4,13,22,7,"PAH",37,1,3,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,4,0)="File #1 has a multiple called APPLICATION GROUP (Field #10) and on this"
^DIC(9.4,13,22,7,"PAH",37,1,5,0)="multiple there is a whole file cross reference - ""AC"".  It was"
^DIC(9.4,13,22,7,"PAH",37,1,6,0)="recently discovered that at some time in a past version that this cross"
^DIC(9.4,13,22,7,"PAH",37,1,7,0)="reference was not being properly killed off.  This patch will go through"
^DIC(9.4,13,22,7,"PAH",37,1,8,0)="this cross reference and remove any of the erroneous entries.  The routine"
^DIC(9.4,13,22,7,"PAH",37,1,9,0)="will also check the APPLICATION GROUP multiple's ""B"" cross reference and"
^DIC(9.4,13,22,7,"PAH",37,1,10,0)="remove any of the erroneous entries."
^DIC(9.4,13,22,7,"PAH",37,1,11,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,12,0)="NOIS: "
^DIC(9.4,13,22,7,"PAH",37,1,13,0)="====="
^DIC(9.4,13,22,7,"PAH",37,1,14,0)="CHA-0299-32411"
^DIC(9.4,13,22,7,"PAH",37,1,15,0)="DAY-0399-42742"
^DIC(9.4,13,22,7,"PAH",37,1,16,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,17,0)="Thanks to Test Sites: "
^DIC(9.4,13,22,7,"PAH",37,1,18,0)="====================="
^DIC(9.4,13,22,7,"PAH",37,1,19,0)="Dallas CIOF"
^DIC(9.4,13,22,7,"PAH",37,1,20,0)="Dayton, OH"
^DIC(9.4,13,22,7,"PAH",37,1,21,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,22,0)="Routine Summary:"
^DIC(9.4,13,22,7,"PAH",37,1,23,0)="================"
^DIC(9.4,13,22,7,"PAH",37,1,24,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,25,0)="The following routine is included in this patch.  The second line of"
^DIC(9.4,13,22,7,"PAH",37,1,26,0)="the routine now look like: "
^DIC(9.4,13,22,7,"PAH",37,1,27,0)="  "
^DIC(9.4,13,22,7,"PAH",37,1,28,0)="  <tab>;;21.0;VA FileMan;**[patch list]**;Dec 28, 1994 "
^DIC(9.4,13,22,7,"PAH",37,1,29,0)="  "
^DIC(9.4,13,22,7,"PAH",37,1,30,0)="CHECK^XTSUMBLD results: "
^DIC(9.4,13,22,7,"PAH",37,1,31,0)="  "
^DIC(9.4,13,22,7,"PAH",37,1,32,0)="  Routine Name   Before Patch    After Patch     Patch List "
^DIC(9.4,13,22,7,"PAH",37,1,33,0)="  ============   ============    ===========     =========="
^DIC(9.4,13,22,7,"PAH",37,1,34,0)="  DIPR58         N/A             1686734         58"
^DIC(9.4,13,22,7,"PAH",37,1,35,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,36,0)="Installation Instructions: "
^DIC(9.4,13,22,7,"PAH",37,1,37,0)="=========================="
^DIC(9.4,13,22,7,"PAH",37,1,38,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,39,0)="        This patch may be installed anytime during non-peak activity"
^DIC(9.4,13,22,7,"PAH",37,1,40,0)="and may be Queued to install during non-peak hours. The installation"
^DIC(9.4,13,22,7,"PAH",37,1,41,0)="time will only take a couple of minutes.  "
^DIC(9.4,13,22,7,"PAH",37,1,42,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,43,0)="     1.  Routine mapping is NOT recommended for this routine. If you"
^DIC(9.4,13,22,7,"PAH",37,1,44,0)="are using routine mapping, ensure that this routine is NOT in your"
^DIC(9.4,13,22,7,"PAH",37,1,45,0)="mapped routine set before proceeding.  "
^DIC(9.4,13,22,7,"PAH",37,1,46,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,47,0)="     2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,13,22,7,"PAH",37,1,48,0)="This option will load the KIDS package onto your system.  "
^DIC(9.4,13,22,7,"PAH",37,1,49,0)="   "
^DIC(9.4,13,22,7,"PAH",37,1,50,0)="     3.  The patch has now been loaded into a transport global on your "
^DIC(9.4,13,22,7,"PAH",37,1,51,0)="system. You now need to use KIDS to install the transport global.  "
^DIC(9.4,13,22,7,"PAH",37,1,52,0)="  "
^DIC(9.4,13,22,7,"PAH",37,1,53,0)="     4.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,7,"PAH",37,1,54,0)="following options: "
^DIC(9.4,13,22,7,"PAH",37,1,55,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,56,0)="            Print Transport Global "
^DIC(9.4,13,22,7,"PAH",37,1,57,0)="            Compare Transport Global to Current System "
^DIC(9.4,13,22,7,"PAH",37,1,58,0)="            Verify Checksums in Transport Global "
^DIC(9.4,13,22,7,"PAH",37,1,59,0)="            Backup a Transport Global "
^DIC(9.4,13,22,7,"PAH",37,1,60,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,61,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,13,22,7,"PAH",37,1,62,0)="following option: "
^DIC(9.4,13,22,7,"PAH",37,1,63,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,64,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,13,22,7,"PAH",37,1,65,0)="            Select INSTALL NAME: DI*21.0*58 "
^DIC(9.4,13,22,7,"PAH",37,1,66,0)="                                 =========="
^DIC(9.4,13,22,7,"PAH",37,1,67,0)="            Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,13,22,7,"PAH",37,1,68,0)="Options, and Protocols? "
^DIC(9.4,13,22,7,"PAH",37,1,69,0)="  "
^DIC(9.4,13,22,7,"PAH",37,1,70,0)="     6.  MSM Sites - Answer YES to the question 'Want to MOVE routines"
^DIC(9.4,13,22,7,"PAH",37,1,71,0)="to other CPUs?'. Then enter the names of your other Compute and Print "
^DIC(9.4,13,22,7,"PAH",37,1,72,0)="server(s). "
^DIC(9.4,13,22,7,"PAH",37,1,73,0)=" "
^DIC(9.4,13,22,7,"PAH",37,1,74,0)="    7. You may now delete DIPR58. "
^DIC(9.4,13,22,7,"PAH","B",8,4)=""
