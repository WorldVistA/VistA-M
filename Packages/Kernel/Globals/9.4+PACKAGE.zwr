^DIC(9.4,59,22,5,"PAH",114,0)="117 SEQ #114^3061123.002244^1"
^DIC(9.4,59,22,5,"PAH",114,1,0)="^^17^17^3061123"
^DIC(9.4,59,22,5,"PAH",114,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",114,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",114,1,3,0)="1.  Certain entries in the DRUG INTERACTION file (#56) may have been"
^DIC(9.4,59,22,5,"PAH",114,1,4,0)="    created using ingredients that are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",114,1,5,0)="    The routine included in this patch will replace those ingredients"
^DIC(9.4,59,22,5,"PAH",114,1,6,0)="    with the corresponding primary ingredients."
^DIC(9.4,59,22,5,"PAH",114,1,7,0)=" "
^DIC(9.4,59,22,5,"PAH",114,1,8,0)="2.  Certain entries in the PATIENT ALLERGIES file (#120.8) may include"
^DIC(9.4,59,22,5,"PAH",114,1,9,0)="    non-primary ingredients.  The routine included in this patch will"
^DIC(9.4,59,22,5,"PAH",114,1,10,0)="    change those entries to the corresponding primary ingredients."
^DIC(9.4,59,22,5,"PAH",114,1,11,0)=" "
^DIC(9.4,59,22,5,"PAH",114,1,12,0)="********************************NOTE***********************************"
^DIC(9.4,59,22,5,"PAH",114,1,13,0)="The routine included in this patch will not be run when the patch is"
^DIC(9.4,59,22,5,"PAH",114,1,14,0)="installed.  It will be called as part of the post-install during future"
^DIC(9.4,59,22,5,"PAH",114,1,15,0)="data update patches."
^DIC(9.4,59,22,5,"PAH",114,1,16,0)="***********************************************************************"
^DIC(9.4,59,22,5,"PAH",114,1,17,0)=" "
^DIC(9.4,59,22,5,"PAH",115,0)="125^3061123.002715^1"
^DIC(9.4,59,22,5,"PAH",115,1,0)="^^17^17^3061123"
^DIC(9.4,59,22,5,"PAH",115,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",115,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",115,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",115,1,4,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",115,1,5,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",115,1,6,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",115,1,7,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",115,1,8,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",115,1,9,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",115,1,10,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",115,1,11,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",115,1,12,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",115,1,13,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",115,1,14,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",115,1,15,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",115,1,16,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",115,1,17,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",116,0)="126^3061123.003154^1"
^DIC(9.4,59,22,5,"PAH",116,1,0)="^^18^18^3061123"
^DIC(9.4,59,22,5,"PAH",116,1,1,0)=" "
