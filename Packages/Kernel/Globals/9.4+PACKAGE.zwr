^DIC(9.4,53,22,20,"PAH",306,0)="379 SEQ #334^3210823.132133^17"
^DIC(9.4,53,22,20,"PAH",306,1,0)="^^3^3^3210823"
^DIC(9.4,53,22,20,"PAH",306,1,1,0)="This patch implements the report that allows CPAC users to view first"
^DIC(9.4,53,22,20,"PAH",306,1,2,0)="party charges for patients with the High Risk of Suicide patient "
^DIC(9.4,53,22,20,"PAH",306,1,3,0)="record flag."
^DIC(9.4,53,22,20,"PAH",307,0)="390 SEQ #335^3211014.160106^17"
^DIC(9.4,53,22,20,"PAH",308,0)="383 SEQ #336^3211027.111247^17"
^DIC(9.4,53,22,20,"PAH",309,0)="349^3211117.142308^17"
^DIC(9.4,53,22,20,"PAH",309,1,0)="^^1^1^3211117"
^DIC(9.4,53,22,20,"PAH",309,1,1,0)="E-Payments builds 10, 13 and 14.  Accounts receivable patch."
^DIC(9.4,53,22,20,"PAH",310,0)="388 SEQ #338^3211118.10534^17"
^DIC(9.4,53,22,20,"PAH",311,0)="396 SEQ #339^3211129.095847^17"
^DIC(9.4,53,22,20,"PAH",312,0)="391 SEQ #340^3220103.124252^17"
^DIC(9.4,53,22,20,"PAH",313,0)="380 SEQ #341^3220323.155151^86"
^DIC(9.4,53,22,20,"PAH",314,0)="343 SEQ #342^3220413.163221^86"
^DIC(9.4,53,22,20,"PAH",314,1,0)="^^24^24^3220413"
^DIC(9.4,53,22,20,"PAH",314,1,1,0)=" This patch will address 7 issues:"
^DIC(9.4,53,22,20,"PAH",314,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,3,0)=" 1. This patch will change the fields and number of days used in the debt"
^DIC(9.4,53,22,20,"PAH",314,1,4,0)="    referral calculations for Debt Management Center (DMC), Treasury"
^DIC(9.4,53,22,20,"PAH",314,1,5,0)="    Cross-Servicing Program (TCSP), and Treasury Offset Program (TOP) to "
^DIC(9.4,53,22,20,"PAH",314,1,6,0)="    ensure the debt time line is compliant with Veterans Health "
^DIC(9.4,53,22,20,"PAH",314,1,7,0)="    Administration (VHA) Policy and Statues."
^DIC(9.4,53,22,20,"PAH",314,1,8,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,9,0)=" 2. Control the resending of recurrent rejected cross-service transactions"
^DIC(9.4,53,22,20,"PAH",314,1,10,0)="    to Treasury."
^DIC(9.4,53,22,20,"PAH",314,1,11,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,12,0)=" 3. Weekly cross-service batch run is resending re-established bills to"
^DIC(9.4,53,22,20,"PAH",314,1,13,0)="    Treasury."
^DIC(9.4,53,22,20,"PAH",314,1,14,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,15,0)=" 4. Control the rejection of a Vista bill recall transaction to Treasury "
^DIC(9.4,53,22,20,"PAH",314,1,16,0)="    to not reset the date sent to Treasury if bill not active status."
^DIC(9.4,53,22,20,"PAH",314,1,17,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,18,0)=" 5. Correct the teleplone number format appearing on profile views."
^DIC(9.4,53,22,20,"PAH",314,1,19,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,20,0)=" 6. The entry of all zeroes for telephone number is sending all"
^DIC(9.4,53,22,20,"PAH",314,1,21,0)="    zeroes to CS and rejecting."
^DIC(9.4,53,22,20,"PAH",314,1,22,0)=" "
^DIC(9.4,53,22,20,"PAH",314,1,23,0)=" 7. Ensure re-established bills are sent if there is also an active Refer"
^DIC(9.4,53,22,20,"PAH",314,1,24,0)="    Return transaction on bill."
^DIC(9.4,53,22,20,"PAH",315,0)="386 SEQ #343^3220427.132425^86"
^DIC(9.4,53,22,20,"PAH",315,1,0)="^^9^9^3220427"
^DIC(9.4,53,22,20,"PAH",315,1,1,0)="Patch PRCA*4.5*386 will address three issues: "
^DIC(9.4,53,22,20,"PAH",315,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",315,1,3,0)="1. Cancelled charges should NOT appear on Exempt Reports"
^DIC(9.4,53,22,20,"PAH",315,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",315,1,5,0)="2. The date of service for any I/P type of copayment should be "
^DIC(9.4,53,22,20,"PAH",315,1,6,0)="   based on the Admit date on Exempt Reports"
^DIC(9.4,53,22,20,"PAH",315,1,7,0)=" "
^DIC(9.4,53,22,20,"PAH",315,1,8,0)="3. Urgent Care copayment charges should NOT appear on Exempt "
^DIC(9.4,53,22,20,"PAH",315,1,9,0)="   Reports"
^DIC(9.4,53,22,20,"PAH",316,0)="384 SEQ #344^3220517.164747^86"
^DIC(9.4,53,22,20,"PAH",316,1,0)="^^8^8^3220517"
^DIC(9.4,53,22,20,"PAH",316,1,1,0)="The A&A Pension, Housebound Exempt Charge Reconciliation Report shows all "
^DIC(9.4,53,22,20,"PAH",316,1,2,0)="bills containing charges with a distinct date of service on or after the"
^DIC(9.4,53,22,20,"PAH",316,1,3,0)="co-payment exemption effective date for Veterans"
^DIC(9.4,53,22,20,"PAH",316,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",316,1,5,0)="The report captures any charges WITHOUT an IB status of cancelled, and "
^DIC(9.4,53,22,20,"PAH",316,1,6,0)="WITHOUT an AR category of CC URGENT CARE and with an AR Status of Active,"
^DIC(9.4,53,22,20,"PAH",316,1,7,0)="Open, Suspended, Write-Off, or Collected/ Closed or ALL of these status'"
^DIC(9.4,53,22,20,"PAH",316,1,8,0)="with a date of service on or after the exemption effective date."
^DIC(9.4,53,22,20,"PAH",317,0)="378 SEQ #345^3220523.151715^86"
^DIC(9.4,53,22,20,"PAH",318,0)="404 SEQ #346^3220523.151833^86"
^DIC(9.4,53,22,20,"PAH",319,0)="397 SEQ #347^3220523.151958^86"
^DIC(9.4,53,22,20,"PAH",320,0)="367 SEQ #348^3220713.122744^86"
^DIC(9.4,53,22,20,"PAH",320,1,0)="^^1^1^3220713"
^DIC(9.4,53,22,20,"PAH",320,1,1,0)="ePayments release 16"
^DIC(9.4,53,22,20,"PAH",321,0)="403 SEQ #349^3220727.132419^86"
^DIC(9.4,53,22,20,"PAH",322,0)="402 SEQ #350^3220727.153105^86"
^DIC(9.4,53,22,20,"PAH",322,1,0)="^^6^6^3220727"
^DIC(9.4,53,22,20,"PAH",322,1,1,0)="Patch PRCA*4.5*402 fixes TRICARE Pharmacy Financial Management System "
^DIC(9.4,53,22,20,"PAH",322,1,2,0)="(FMS) error issue."
^DIC(9.4,53,22,20,"PAH",322,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",322,1,4,0)="Sites claimed that decrease adjustments for TRICARE Pharmacy bills cannot "
^DIC(9.4,53,22,20,"PAH",322,1,5,0)="be transmitted to FMS since no Billing Document (BD) code sheet is being "
^DIC(9.4,53,22,20,"PAH",322,1,6,0)="generated."
^DIC(9.4,53,22,20,"PAH",323,0)="393 SEQ #351^3220803.140701^86"
^DIC(9.4,53,22,20,"PAH",324,0)="392 SEQ #352^3220928.07551^90"
^DIC(9.4,53,22,20,"PAH",325,0)="394 SEQ #353^3221110.092109^89"
^DIC(9.4,53,22,20,"PAH",325,1,0)="^^1^1^3221110"
^DIC(9.4,53,22,20,"PAH",325,1,1,0)="1. Reset the 'hanging' bills sent to TOP after TCSP cutoff date 8-15-2015"
^DIC(9.4,53,22,20,"PAH",326,0)="411 SEQ #354^3221123.171802^89"
^DIC(9.4,53,22,20,"PAH",326,1,0)="^^4^4^3221123"
^DIC(9.4,53,22,20,"PAH",326,1,1,0)="Patch PRCA*4.5*411 will address one issue: "
^DIC(9.4,53,22,20,"PAH",326,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",326,1,3,0)="1. Ensure ERA Worklist does not error when 'Deleted' Prescription "
^DIC(9.4,53,22,20,"PAH",326,1,4,0)="   encountered during ERA processing"
