^DIC(9.4,52,22,29,"PAH",117,1,0)="^^7^7^3101130"
^DIC(9.4,52,22,29,"PAH",117,1,1,0)="This patch will address the following issues:"
^DIC(9.4,52,22,29,"PAH",117,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",117,1,3,0)="1. No CLRS data feed"
^DIC(9.4,52,22,29,"PAH",117,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",117,1,5,0)="2. Contract Number on original 1358 but dropped on adjustments"
^DIC(9.4,52,22,29,"PAH",117,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",117,1,7,0)="3. Option PRCSR1358 has wrong line label in routine  "
^DIC(9.4,52,22,29,"PAH",118,0)="145 SEQ #120^3101208.110447^17"
^DIC(9.4,52,22,29,"PAH",118,1,0)="^^3^3^3101208"
^DIC(9.4,52,22,29,"PAH",118,1,1,0)="1. IFCAP NIF maint errors mail message (to Outlook)"
^DIC(9.4,52,22,29,"PAH",118,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",118,1,3,0)="2. Running Balance report and FCP recalculations"
^DIC(9.4,52,22,29,"PAH",119,0)="143 SEQ #121^3110104.143425^17"
^DIC(9.4,52,22,29,"PAH",119,1,0)="^^13^13^3110104"
^DIC(9.4,52,22,29,"PAH",119,1,1,0)="This patch will address the following 3 issues:"
^DIC(9.4,52,22,29,"PAH",119,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",119,1,3,0)="1. When site transfers funds from one Control Point to another they "
^DIC(9.4,52,22,29,"PAH",119,1,4,0)="   receive the message ""'No Records To Print' when trying to review "
^DIC(9.4,52,22,29,"PAH",119,1,5,0)="   the entry."
^DIC(9.4,52,22,29,"PAH",119,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",119,1,7,0)="2. When user edits an incomplete detailed Purchase Card Order, the "
^DIC(9.4,52,22,29,"PAH",119,1,8,0)="   existing Cost Center value may not be displayed."
^DIC(9.4,52,22,29,"PAH",119,1,9,0)=" "
^DIC(9.4,52,22,29,"PAH",119,1,10,0)="3. SHIP TO ADDRESS inconsistent between information entered during"
^DIC(9.4,52,22,29,"PAH",119,1,11,0)="   Prosthetics GUI order entry and reprinting order in IFCAP using "
^DIC(9.4,52,22,29,"PAH",119,1,12,0)="   options REPRINT PURCHASE CARD ORDER or DISPLAY PURCHASE "
^DIC(9.4,52,22,29,"PAH",119,1,13,0)="   ORDER/REQUISITION."
^DIC(9.4,52,22,29,"PAH",120,0)="128 SEQ #122^3110208.093315^17"
^DIC(9.4,52,22,29,"PAH",120,1,0)="^^2^2^3110208"
^DIC(9.4,52,22,29,"PAH",120,1,1,0)="1. Amendment to decrease line item quantity to less than delivery"
^DIC(9.4,52,22,29,"PAH",120,1,2,0)="   schedule causes infinite error message loop."
^DIC(9.4,52,22,29,"PAH",121,0)="139 SEQ #123^3110208.093322^17"
^DIC(9.4,52,22,29,"PAH",121,1,0)="^^4^4^3110208"
^DIC(9.4,52,22,29,"PAH",121,1,1,0)="1. Duplicate feeds of CLRS data to Austin when testing on the "
^DIC(9.4,52,22,29,"PAH",121,1,2,0)="   test/mirror account."
^DIC(9.4,52,22,29,"PAH",121,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",121,1,4,0)="2. Ceiling Transactions out of numbers "
^DIC(9.4,52,22,29,"PAH",122,0)="148 SEQ #124^3110208.093332^17"
^DIC(9.4,52,22,29,"PAH",122,1,0)="^^5^5^3110208"
^DIC(9.4,52,22,29,"PAH",122,1,1,0)="Enhancement for 1358 miscellaneous obligations:"
^DIC(9.4,52,22,29,"PAH",122,1,2,0)="  o enforce segregation of duties"
^DIC(9.4,52,22,29,"PAH",122,1,3,0)="  o enter additional data on a 1358 request"
^DIC(9.4,52,22,29,"PAH",122,1,4,0)="  o require mandatory fields to be populated"
^DIC(9.4,52,22,29,"PAH",122,1,5,0)="  o include the new authority/sub-authority codes on the SO code sheet "
^DIC(9.4,52,22,29,"PAH",123,0)="147 SEQ #125^3110315.171709^17"
^DIC(9.4,52,22,29,"PAH",123,1,0)="^^5^5^3110315"
^DIC(9.4,52,22,29,"PAH",123,1,1,0)="1. SPD - Special Inventory Point type"
^DIC(9.4,52,22,29,"PAH",123,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",123,1,3,0)="2. IFCAP archiving problem"
^DIC(9.4,52,22,29,"PAH",123,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",123,1,5,0)="3. Invalid routine referenced, ^PRC(410)"
^DIC(9.4,52,22,29,"PAH",124,0)="151 SEQ #126^3110404.142331^17"
^DIC(9.4,52,22,29,"PAH",124,1,0)="^^12^12^3110404"
^DIC(9.4,52,22,29,"PAH",124,1,1,0)="        This patch adds eight new fields to the F20 CLRS extract and the"
^DIC(9.4,52,22,29,"PAH",124,1,2,0)="Control Point Activities - F20 extract validation template."
^DIC(9.4,52,22,29,"PAH",124,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",124,1,4,0)="The eight new fields are:"
^DIC(9.4,52,22,29,"PAH",124,1,5,0)="                - IEN of Authority Code"
^DIC(9.4,52,22,29,"PAH",124,1,6,0)="                - Authority Code"
^DIC(9.4,52,22,29,"PAH",124,1,7,0)="                - Authority Description"
^DIC(9.4,52,22,29,"PAH",124,1,8,0)="                - IEN of Subauthority Code"
^DIC(9.4,52,22,29,"PAH",124,1,9,0)="                - Subauthority Code"
^DIC(9.4,52,22,29,"PAH",124,1,10,0)="                - Subauthority Description"
^DIC(9.4,52,22,29,"PAH",124,1,11,0)="                - Service End Date"
^DIC(9.4,52,22,29,"PAH",124,1,12,0)="                - Service Start Date"
^DIC(9.4,52,22,29,"PAH",125,0)="141 SEQ #127^3110428.161455^17"
^DIC(9.4,52,22,29,"PAH",125,1,0)="^^2^2^3110428"
^DIC(9.4,52,22,29,"PAH",125,1,1,0)="Prosthetics GUI Required date field does not transfer to Purchase Card "
^DIC(9.4,52,22,29,"PAH",125,1,2,0)="order."
^DIC(9.4,52,22,29,"PAH",126,0)="152 SEQ #128^3110531.143916^17"
^DIC(9.4,52,22,29,"PAH",126,1,0)="^^5^5^3110531"
^DIC(9.4,52,22,29,"PAH",126,1,1,0)="This enhancement patch provides new APIs to enable the Fee Basis"
^DIC(9.4,52,22,29,"PAH",126,1,2,0)="application to enforce and report on segregation of duties for the"
^DIC(9.4,52,22,29,"PAH",126,1,3,0)="Certifier of a Fee payment batch. Per segregation of duties a Certifier"
^DIC(9.4,52,22,29,"PAH",126,1,4,0)="cannot have previously acted in the role of Requestor, Approver or"
^DIC(9.4,52,22,29,"PAH",126,1,5,0)="Obligator on the 1358 that is linked to the payment batch."
^DIC(9.4,52,22,29,"PAH",127,0)="142 SEQ #129^3110627.115539^17"
^DIC(9.4,52,22,29,"PAH",127,1,0)="^^7^7^3110627"
^DIC(9.4,52,22,29,"PAH",127,1,1,0)="Replacement patch for PRC*5.1*127 Entered in Error."
^DIC(9.4,52,22,29,"PAH",127,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",127,1,3,0)="1. GIP Transaction Register Report print limitation"
^DIC(9.4,52,22,29,"PAH",127,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",127,1,5,0)="2. GIP Issue"
^DIC(9.4,52,22,29,"PAH",127,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",127,1,7,0)="3. PRCB MONTHLY ACCRUAL"
^DIC(9.4,52,22,29,"PAH",128,0)="154 SEQ #130^3110705.143721^17"
^DIC(9.4,52,22,29,"PAH",128,1,0)="^^5^5^3110705"
^DIC(9.4,52,22,29,"PAH",128,1,1,0)="This patch implements Segregation of Duties for 1358s in the"
^DIC(9.4,52,22,29,"PAH",128,1,2,0)="Invoice Tracking module, such that a Requestor, Approver, or"
^DIC(9.4,52,22,29,"PAH",128,1,3,0)="Obligator may not be the Certifier for Payment of an invoice"
^DIC(9.4,52,22,29,"PAH",128,1,4,0)="against the same 1358.  It also enhances the CLRS (NLD) extract"
^DIC(9.4,52,22,29,"PAH",128,1,5,0)="to include data from the Invoice Tracking file (#421.5)."
^DIC(9.4,52,22,29,"PAH",129,0)="153 SEQ #131^3110715.120455^17"
^DIC(9.4,52,22,29,"PAH",129,1,0)="^^3^3^3110715"
^DIC(9.4,52,22,29,"PAH",129,1,1,0)="This patch provides a one-way data exchange of Miscellaneous Obligations "
^DIC(9.4,52,22,29,"PAH",129,1,2,0)="data from IFCAP to the On-Line Certification System (OLCS) at the "
^DIC(9.4,52,22,29,"PAH",129,1,3,0)="Financial Services Center (FSC) in Austin."
^DIC(9.4,52,22,29,"PAH",130,0)="149 SEQ #132^3110815.141706^17"
^DIC(9.4,52,22,29,"PAH",130,1,0)="^^12^12^3110815"
^DIC(9.4,52,22,29,"PAH",130,1,1,0)="1. Site found that during Reconciliation processing it was possible to "
^DIC(9.4,52,22,29,"PAH",130,1,2,0)="   mark more than one charge as 'FINAL CHARGE' which should not be allowed"
^DIC(9.4,52,22,29,"PAH",130,1,3,0)="   as it causes the Approving Official to be delinquent on the Delinquent"
^DIC(9.4,52,22,29,"PAH",130,1,4,0)="   Approval Report."
^DIC(9.4,52,22,29,"PAH",130,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",130,1,6,0)="2. Site reports that Carry Forward processing takes a long time and "
^DIC(9.4,52,22,29,"PAH",130,1,7,0)="   purchase order finalization through Prosthetics GUI will time out "
^DIC(9.4,52,22,29,"PAH",130,1,8,0)="   without completing the order processing."
^DIC(9.4,52,22,29,"PAH",130,1,9,0)=" "
^DIC(9.4,52,22,29,"PAH",130,1,10,0)="3. Site reports that running 'Summary report of Unpaid Purchase Card "
^DIC(9.4,52,22,29,"PAH",130,1,11,0)="   Transactions' under LINUX OS (print queuing is required) results in"
^DIC(9.4,52,22,29,"PAH",130,1,12,0)="   system error."
^DIC(9.4,52,22,29,"PAH",131,0)="144 SEQ #133^3110913.124323^17"
^DIC(9.4,52,22,29,"PAH",131,1,0)="^^8^8^3110913"
^DIC(9.4,52,22,29,"PAH",131,1,1,0)="This patch resolves ticket HD341117 and corrects a problem where"
^DIC(9.4,52,22,29,"PAH",131,1,2,0)="certain invalid Vendor Update records caused a program crash."
^DIC(9.4,52,22,29,"PAH",131,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",131,1,4,0)="This patch resolves ticket HD126460 and disallows certain users"
^DIC(9.4,52,22,29,"PAH",131,1,5,0)="from entering an Adjustment Voucher on a P/C order."
^DIC(9.4,52,22,29,"PAH",131,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",131,1,7,0)="This patch resolves ticket HD249121 where an FPDS question was "
^DIC(9.4,52,22,29,"PAH",131,1,8,0)="reflecting a wrong dollar amount for a contract."
^DIC(9.4,52,22,29,"PAH",132,0)="158 SEQ #134^3111013.114617^17"
^DIC(9.4,52,22,29,"PAH",132,1,0)="^^2^2^3111013"
^DIC(9.4,52,22,29,"PAH",132,1,1,0)="This patch modifies IFCAP to remove the reference ""Miscellaneous"" or"
^DIC(9.4,52,22,29,"PAH",132,1,2,0)="""MISC."" from 1358 Obligations."
^DIC(9.4,52,22,29,"PAH",133,0)="163 SEQ #135^3111104.131023^17"
^DIC(9.4,52,22,29,"PAH",133,1,0)="^^1^1^3111104"
^DIC(9.4,52,22,29,"PAH",133,1,1,0)="1. PRCH Purchase Card Adjustment Security Error in error display"
^DIC(9.4,52,22,29,"PAH",134,0)="138 SEQ #136^3120125.114131^17"
^DIC(9.4,52,22,29,"PAH",134,1,0)="^^6^6^3120125"
^DIC(9.4,52,22,29,"PAH",134,1,1,0)="1. Discount entries are not properly linking to item entries which is"
^DIC(9.4,52,22,29,"PAH",134,1,2,0)="   causing amendment processing errors to occur."
^DIC(9.4,52,22,29,"PAH",134,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",134,1,4,0)="2. The option 'Load IFCAP File 417 Data into PurgeMaster' there is a"
^DIC(9.4,52,22,29,"PAH",134,1,5,0)="   misspelling of the word, ""reconciliation'.  Currently, it reads as "
^DIC(9.4,52,22,29,"PAH",134,1,6,0)="   ""reconilliation""."
^DIC(9.4,52,22,29,"PAH",135,0)="166 SEQ #137^3120227.110342^17"
^DIC(9.4,52,22,29,"PAH",135,1,0)="^^2^2^3120227"
^DIC(9.4,52,22,29,"PAH",135,1,1,0)="1. Clinical Logistics Report Server (CLRS) being relocated effective"
^DIC(9.4,52,22,29,"PAH",135,1,2,0)="   03/01/2012."
^DIC(9.4,52,22,29,"PAH",136,0)="129 SEQ #138^3120418.115025^17"
^DIC(9.4,52,22,29,"PAH",136,1,0)="^^9^9^3120418"
^DIC(9.4,52,22,29,"PAH",136,1,1,0)="1. Tasking the option 'Inactivate Expired Charge Cards' does not work as"
^DIC(9.4,52,22,29,"PAH",136,1,2,0)="   the processing asks for STATION which cannot be answered once tasked."
^DIC(9.4,52,22,29,"PAH",136,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",136,1,4,0)="2. Option, New Purchase Order [PRCHPC PO ADD], must have query INVOICE "
^DIC(9.4,52,22,29,"PAH",136,1,5,0)="   ADDRESS default 'FMS' changed to ""VA FSC'."
^DIC(9.4,52,22,29,"PAH",136,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",136,1,7,0)="3. Routine PRCHNPO6 is not in compliance with SACC (VistA Programming "
^DIC(9.4,52,22,29,"PAH",136,1,8,0)="   Standards and Conventions) since lock ':0' is less than the value of"
^DIC(9.4,52,22,29,"PAH",136,1,9,0)="   the kernel variable ""DILOCKTM"". "
^DIC(9.4,52,22,29,"PAH",137,0)="159 SEQ #139^3120423.142407^17"
^DIC(9.4,52,22,29,"PAH",137,1,0)="^^8^8^3120423"
^DIC(9.4,52,22,29,"PAH",137,1,1,0)=" "
^DIC(9.4,52,22,29,"PAH",137,1,2,0)="1. Duplicate 'AB' cross references exist in file 442 [PROCUREMENT & "
^DIC(9.4,52,22,29,"PAH",137,1,3,0)="   ACCOUNTING TRANSACTIONS."
^DIC(9.4,52,22,29,"PAH",137,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",137,1,5,0)="2. Modify IFCAP security key PRCSCPO 'Keep at Terminate' setting to 'NO'."
^DIC(9.4,52,22,29,"PAH",137,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",137,1,7,0)="3. Option PRCB MONTHLY ACCRUAL creating multiple monthly accrual nodes in"
^DIC(9.4,52,22,29,"PAH",137,1,8,0)="   file 440.7 [MONTHLY ACCRUAL]."
^DIC(9.4,52,22,29,"PAH",138,0)="156 SEQ #140^3120829.114129^17"
^DIC(9.4,52,22,29,"PAH",138,1,0)="^^5^5^3120829"
^DIC(9.4,52,22,29,"PAH",138,1,1,0)="1. Option 'Convert a Temporary 2237 request to a Purchase Order' results "
^DIC(9.4,52,22,29,"PAH",138,1,2,0)="   in duplicate entries reported in Running Balance report"
^DIC(9.4,52,22,29,"PAH",138,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",138,1,4,0)="2. Entering Purchase Order for succeeding fiscal year results in "
^DIC(9.4,52,22,29,"PAH",138,1,5,0)="   requisition with current fiscal year"
^DIC(9.4,52,22,29,"PAH",139,0)="157 SEQ #141^3120911.095736^17"
^DIC(9.4,52,22,29,"PAH",139,1,0)="^^6^6^3120911"
^DIC(9.4,52,22,29,"PAH",139,1,1,0)="1. Site reported that they were able to cancel a Purchase Card order "
^DIC(9.4,52,22,29,"PAH",139,1,2,0)="   before the reconciliation charges were removed."
^DIC(9.4,52,22,29,"PAH",139,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",139,1,4,0)="2. In File Description information for file #410 [CONTROL POINT ACTIVITY],"
^DIC(9.4,52,22,29,"PAH",139,1,5,0)="   #442 [PROCUREMENT & ACCOUNTING TRANSACTIONS] AND #443.6 [AMENDMENTS] "
^DIC(9.4,52,22,29,"PAH",139,1,6,0)="   add informational warning: *********DO NOT RE-INDEX THIS FILE**********"
^DIC(9.4,52,22,29,"PAH",140,0)="167 SEQ #142^3130103.113601^17"
^DIC(9.4,52,22,29,"PAH",140,1,0)="^^7^7^3130103"
^DIC(9.4,52,22,29,"PAH",140,1,1,0)="This patch will establish bidirectional communication (HL7 "
^DIC(9.4,52,22,29,"PAH",140,1,2,0)="Interface) between IFCAP and the commercial Electronic Contract"
^DIC(9.4,52,22,29,"PAH",140,1,3,0)="Management System (eCMS) in Austin, in order to capitalize on the"
^DIC(9.4,52,22,29,"PAH",140,1,4,0)="abilities of eCMS to consolidate  multiple requests, electronically"
^DIC(9.4,52,22,29,"PAH",140,1,5,0)="prepare and issue solicitation documents, receive electronic offers,"
^DIC(9.4,52,22,29,"PAH",140,1,6,0)="automate contract administration, and provide interfaces to the Integrated"
^DIC(9.4,52,22,29,"PAH",140,1,7,0)="Acquisition Environment initiatives."
^DIC(9.4,52,22,29,"PAH",141,0)="172 SEQ #143^3130114.114327^17"
^DIC(9.4,52,22,29,"PAH",141,1,0)="^^2^2^3130114"
^DIC(9.4,52,22,29,"PAH",141,1,1,0)="1. Clinical Logistics CLRS TRANSMISSION processing update for those sites"
^DIC(9.4,52,22,29,"PAH",141,1,2,0)="   that have migrated to Full LINUX OS."
^DIC(9.4,52,22,29,"PAH",142,0)="175 SEQ #144^3130116.17033^17"
^DIC(9.4,52,22,29,"PAH",142,1,0)="^^1^1^3130116"
^DIC(9.4,52,22,29,"PAH",142,1,1,0)="1. RUNAWAY JOURNALING WHEN CANCELLING A PROSTHETICS PURCHASE ORDER"
^DIC(9.4,52,22,29,"PAH",143,0)="162 SEQ #145^3130205.124113^17"
^DIC(9.4,52,22,29,"PAH",143,1,0)="^^3^3^3130205"
^DIC(9.4,52,22,29,"PAH",143,1,1,0)="VistA Fee Automation Enhancement"
^DIC(9.4,52,22,29,"PAH",143,1,2,0)=" o modify PRCS58CC to conditionally skip the control point access check"
^DIC(9.4,52,22,29,"PAH",143,1,3,0)=" o delete accounting technician options used to process 994 code sheets"
^DIC(9.4,52,22,29,"PAH",144,0)="161 SEQ #146^3130219.123426^17"
^DIC(9.4,52,22,29,"PAH",144,1,0)="^^5^5^3130219"
^DIC(9.4,52,22,29,"PAH",144,1,1,0)="1. Add the ability to review a 1358 during Obligating process."
^DIC(9.4,52,22,29,"PAH",144,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",144,1,3,0)="2. Option PRCF PRINT FROM LIST causing disk free space warning"
^DIC(9.4,52,22,29,"PAH",144,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",144,1,5,0)="3. Documentation issue with CPO User's Guide"
^DIC(9.4,52,22,29,"PAH",145,0)="120 SEQ #147^3130222.11164^17"
^DIC(9.4,52,22,29,"PAH",145,1,0)="^^7^7^3130222"
^DIC(9.4,52,22,29,"PAH",145,1,1,0)="1. EDI (Electronic Data Interchange) flagged orders via Fund Control Point"
^DIC(9.4,52,22,29,"PAH",145,1,2,0)="   and Vendor do not appear on UNOBL Running Balance when not passed    "
^DIC(9.4,52,22,29,"PAH",145,1,3,0)="   through fiscal."
^DIC(9.4,52,22,29,"PAH",145,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",145,1,5,0)="2. When Fund Control Point flag 'FCP ALL/DELIVERY ORDER SWITCH' is set to"
^DIC(9.4,52,22,29,"PAH",145,1,6,0)="   (A)ll Orders or (D)elivery orders, orders automatically get obligated"
^DIC(9.4,52,22,29,"PAH",145,1,7,0)="   which affect the Running Balance Report."
^DIC(9.4,52,22,29,"PAH",146,0)="150 SEQ #148^3130408.100935^17"
^DIC(9.4,52,22,29,"PAH",146,1,0)="^^7^7^3130408"
^DIC(9.4,52,22,29,"PAH",146,1,1,0)="1. Requisition deletions causing filing errors."
^DIC(9.4,52,22,29,"PAH",146,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",146,1,3,0)="2. Temporary requests being changed to a new transaction number do not "
^DIC(9.4,52,22,29,"PAH",146,1,4,0)="   clear the temporary request cross reference pointers."
^DIC(9.4,52,22,29,"PAH",146,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",146,1,6,0)="3. Changing the description on a Fund Control Point will cause previous"
^DIC(9.4,52,22,29,"PAH",146,1,7,0)="   temporary transactions to fall off the Temporary Transaction Listing."
^DIC(9.4,52,22,29,"PAH",147,0)="178 SEQ #149^3130506.172238^17"
^DIC(9.4,52,22,29,"PAH",147,1,0)="^^2^2^3130506"
^DIC(9.4,52,22,29,"PAH",147,1,1,0)="1. COST CENTER modification for SUB COST CENTER in MOA HL7 segment for FMS"
^DIC(9.4,52,22,29,"PAH",147,1,2,0)="   DOCUMENT TRANSMISSION."
^DIC(9.4,52,22,29,"PAH",148,0)="165 SEQ #150^3130703.12322^17"
^DIC(9.4,52,22,29,"PAH",148,1,0)="^^7^7^3130703"
^DIC(9.4,52,22,29,"PAH",148,1,1,0)="1. Items falling below emergency stock level are not showing on Auto-Gen"
^DIC(9.4,52,22,29,"PAH",148,1,2,0)="   suggested orders."
^DIC(9.4,52,22,29,"PAH",148,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",148,1,4,0)="2. Amendment problem where user is not authorized to amend order."
^DIC(9.4,52,22,29,"PAH",148,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",148,1,6,0)="3. User encountered subscript error while running option 'APPROVE "
^DIC(9.4,52,22,29,"PAH",148,1,7,0)="   REQUESTS'."
^DIC(9.4,52,22,29,"PAH",149,0)="170 SEQ #151^3130805.125229^17"
^DIC(9.4,52,22,29,"PAH",149,1,0)="^^6^6^3130805"
^DIC(9.4,52,22,29,"PAH",149,1,1,0)="1. Entering invalid quantity when receiving order can result in incorrect"
^DIC(9.4,52,22,29,"PAH",149,1,2,0)="   quantity received."
^DIC(9.4,52,22,29,"PAH",149,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",149,1,4,0)="2. Cancel Imprest Funds Purchase Order must be for unobligated order."
^DIC(9.4,52,22,29,"PAH",149,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",149,1,6,0)="3. Testing Cache 2011 found compile error with routine PRCBR1."
^DIC(9.4,52,22,29,"PAH",150,0)="168 SEQ #152^3130820.165708^17"
^DIC(9.4,52,22,29,"PAH",150,1,0)="^^5^5^3130820"
^DIC(9.4,52,22,29,"PAH",150,1,1,0)="1. Display/print for 1358 prints out of sequence when more than 999"
^DIC(9.4,52,22,29,"PAH",150,1,2,0)="   transactions."
^DIC(9.4,52,22,29,"PAH",150,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",150,1,4,0)="2. Modify IFCAP security key PRCFA SUPERVISOR 'Keep at Terminate' setting"
^DIC(9.4,52,22,29,"PAH",150,1,5,0)="   to 'NO'."
^DIC(9.4,52,22,29,"PAH",151,0)="171 SEQ #153^3130930.101921^17"
^DIC(9.4,52,22,29,"PAH",151,1,0)="^^8^8^3130930"
^DIC(9.4,52,22,29,"PAH",151,1,1,0)="1. Distribution Order Processing option is not scrolling correctly when"
^DIC(9.4,52,22,29,"PAH",151,1,2,0)="   using Enter/Edit Inventory Items."
^DIC(9.4,52,22,29,"PAH",151,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",151,1,4,0)="2. Remove option 'Enter/Edit Control Point Users' to keep user assignment "
^DIC(9.4,52,22,29,"PAH",151,1,5,0)="   solely under Fiscal control."
^DIC(9.4,52,22,29,"PAH",151,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",151,1,7,0)="3. Delivery Orders create obligated amount on Running Balance with auto "
^DIC(9.4,52,22,29,"PAH",151,1,8,0)="   obligate turned off."
^DIC(9.4,52,22,29,"PAH",152,0)="174 SEQ #154^3140107.102655^17"
^DIC(9.4,52,22,29,"PAH",152,1,0)="^^2^2^3140107"
^DIC(9.4,52,22,29,"PAH",152,1,1,0)="This patch delivers Phase 2, Increment 1 of the IFCAP/eCMS Interface"
^DIC(9.4,52,22,29,"PAH",152,1,2,0)="project."
^DIC(9.4,52,22,29,"PAH",153,0)="173 SEQ #155^3140116.131523^17"
^DIC(9.4,52,22,29,"PAH",153,1,0)="^^5^5^3140116"
^DIC(9.4,52,22,29,"PAH",153,1,1,0)="1. Monthly Accrual Document Cost Center issue"
^DIC(9.4,52,22,29,"PAH",153,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",153,1,3,0)="2. Audit/control File 442 Internal Entry number (IEN) setting"
^DIC(9.4,52,22,29,"PAH",153,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",153,1,5,0)="3. 1358 Adjustments causing FMS SO Document error"
^DIC(9.4,52,22,29,"PAH",154,0)="179 SEQ #156^3140403.143306^17"
^DIC(9.4,52,22,29,"PAH",154,1,0)="^^5^5^3140403"
^DIC(9.4,52,22,29,"PAH",154,1,1,0)="1. Incorrect site when adding new secondary inventory point"
^DIC(9.4,52,22,29,"PAH",154,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",154,1,3,0)="2. 2237 Request Display missing comments"
^DIC(9.4,52,22,29,"PAH",154,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",154,1,5,0)="3. Purchase Order Issue - Obligations not showing on Running Balance"
^DIC(9.4,52,22,29,"PAH",155,0)="180 SEQ #158^3140520.150702^17"
^DIC(9.4,52,22,29,"PAH",155,1,0)="^^6^6^3140520"
^DIC(9.4,52,22,29,"PAH",155,1,1,0)=" "
^DIC(9.4,52,22,29,"PAH",155,1,2,0)="1. Add new sub authority to Authority 3."
^DIC(9.4,52,22,29,"PAH",155,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",155,1,4,0)="2. Amendment for Delivery Date with Document transmission to FMS"
^DIC(9.4,52,22,29,"PAH",155,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",155,1,6,0)="3. Daily 1358 record entry cannot be entered"
^DIC(9.4,52,22,29,"PAH",156,0)="185 SEQ #159^3140729.142017^17"
^DIC(9.4,52,22,29,"PAH",156,1,0)="^^5^5^3140729"
^DIC(9.4,52,22,29,"PAH",156,1,1,0)="1. Non Supply Personnel able to enter/sign off on P.O."
^DIC(9.4,52,22,29,"PAH",156,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",156,1,3,0)="2. Cannot access Inventory Point using Abbreviated Name"
^DIC(9.4,52,22,29,"PAH",156,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",156,1,5,0)="3. Full Purchase Card number appears under two display options"
^DIC(9.4,52,22,29,"PAH",157,0)="181 SEQ #160^3140905.100917^17"
^DIC(9.4,52,22,29,"PAH",157,1,0)="^^6^6^3140905"
^DIC(9.4,52,22,29,"PAH",157,1,1,0)=" "
^DIC(9.4,52,22,29,"PAH",157,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",157,1,3,0)="1. Purchase Card Orders - duplicate transction numbers occur "
^DIC(9.4,52,22,29,"PAH",157,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",157,1,5,0)="2. Amendment of purchase order for Prompt Pay Type creates incorrect FCP "
^DIC(9.4,52,22,29,"PAH",157,1,6,0)="   adjustment as seen on Running Balance report"
^DIC(9.4,52,22,29,"PAH",158,0)="183 SEQ #161^3140909.123934^17"
^DIC(9.4,52,22,29,"PAH",158,1,0)="^^3^3^3140909"
^DIC(9.4,52,22,29,"PAH",158,1,1,0)="1. Amendment error - undefined PCT+2^PRCHSF3"
^DIC(9.4,52,22,29,"PAH",158,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",158,1,3,0)="2. Inquire Purchase Card surrogate add error"
^DIC(9.4,52,22,29,"PAH",159,0)="176 SEQ #162^3141031.15553^17"
^DIC(9.4,52,22,29,"PAH",159,1,0)="^^9^9^3141031"
^DIC(9.4,52,22,29,"PAH",159,1,1,0)="This Patch Addresses 2 issues:"
^DIC(9.4,52,22,29,"PAH",159,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",159,1,3,0)="1. A duplicate 1358 is created if 2 people are obligating a request"
^DIC(9.4,52,22,29,"PAH",159,1,4,0)="at the same time."
^DIC(9.4,52,22,29,"PAH",159,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",159,1,6,0)="2. Invalid entries in the ""B"" and ""C"" cross references in the BUDGET"
^DIC(9.4,52,22,29,"PAH",159,1,7,0)="OBJECT CODE (#420.2) file are causing the wrong BOC code "
^DIC(9.4,52,22,29,"PAH",159,1,8,0)="Description to display when using the ADD/EDIT BOC [PRCB BOC"
^DIC(9.4,52,22,29,"PAH",159,1,9,0)="ADD/EDIT] option."
^DIC(9.4,52,22,29,"PAH",160,0)="188 SEQ #163^3150106.114939^17"
^DIC(9.4,52,22,29,"PAH",160,1,0)="^^5^5^3150106"
^DIC(9.4,52,22,29,"PAH",160,1,1,0)="1. Remove 8243 from Control Point Listing w/Cost Center Exceptions"
^DIC(9.4,52,22,29,"PAH",160,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",160,1,3,0)="2. Site references need to be removed from IFCAP Technical Manual"
^DIC(9.4,52,22,29,"PAH",160,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",160,1,5,0)="3. Prevent fractional quantities being entered on inventory item receipts"
^DIC(9.4,52,22,29,"PAH",161,0)="189 SEQ #164^3150501.150709^17"
^DIC(9.4,52,22,29,"PAH",161,1,0)="^^5^5^3150501"
^DIC(9.4,52,22,29,"PAH",161,1,1,0)="1. 1358 Authorization maximum entry warning"
^DIC(9.4,52,22,29,"PAH",161,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",161,1,3,0)="2. Site was able to receive same order multiple times"
^DIC(9.4,52,22,29,"PAH",161,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",161,1,5,0)="3. Prompt Pay processing issues "
^DIC(9.4,52,22,29,"PAH",162,0)="182 SEQ #165^3150515.093224^17"
^DIC(9.4,52,22,29,"PAH",162,1,0)="^^1^1^3150515"
^DIC(9.4,52,22,29,"PAH",162,1,1,0)="1. Update FSC/PSC codes from current national master file"
^DIC(9.4,52,22,29,"PAH",163,0)="186 SEQ #166^3150924.121941^17"
^DIC(9.4,52,22,29,"PAH",163,1,0)="^^5^5^3150924"
^DIC(9.4,52,22,29,"PAH",163,1,1,0)="1. Direct sets causing duplicate entries in file 443. "
^DIC(9.4,52,22,29,"PAH",163,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",163,1,3,0)="2. Fiscal Pending Action report not showing approved amendments."
^DIC(9.4,52,22,29,"PAH",163,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",163,1,5,0)="3. All/Delivery orders not auto obligating for Delivery Orders."
^DIC(9.4,52,22,29,"PAH",164,0)="190 SEQ #167^3150929.140316^17"
^DIC(9.4,52,22,29,"PAH",164,1,0)="^^5^5^3150929"
^DIC(9.4,52,22,29,"PAH",164,1,1,0)="1. Do not ask Delivery Date when cancelling order via amendment"
^DIC(9.4,52,22,29,"PAH",164,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",164,1,3,0)="2. Subscript error when cleansing/purging files 424/424.1"
^DIC(9.4,52,22,29,"PAH",164,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",164,1,5,0)="3. Vendor lookup by DUN & Bradstreet number fails "
^DIC(9.4,52,22,29,"PAH",165,0)="184 SEQ #168^3160606.103801^17"
^DIC(9.4,52,22,29,"PAH",165,1,0)="^^6^6^3160606"
^DIC(9.4,52,22,29,"PAH",165,1,1,0)=" "
^DIC(9.4,52,22,29,"PAH",165,1,2,0)="1. Purchase Card and Delivery orders reaching 2237 max on backend filing"
^DIC(9.4,52,22,29,"PAH",165,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",165,1,4,0)="2. Purchase Card accrual issue from one quarter to next with Carry Forward"
^DIC(9.4,52,22,29,"PAH",165,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",165,1,6,0)="3. Documentation error in Control Point Official's Manual"
^DIC(9.4,52,22,29,"PAH",166,0)="193 SEQ #169^3160706.155542^54"
^DIC(9.4,52,22,29,"PAH",166,1,0)="^^2^2^3160706"
^DIC(9.4,52,22,29,"PAH",166,1,1,0)="1. Modify the Annual IFCAP Purge process to be controlled by a"
^DIC(9.4,52,22,29,"PAH",166,1,2,0)="   universal date process"
^DIC(9.4,52,22,29,"PAH",167,0)="191 SEQ #170^3160726.140623^54"
^DIC(9.4,52,22,29,"PAH",167,1,0)="^^5^5^3160726"
^DIC(9.4,52,22,29,"PAH",167,1,1,0)="1. 1358 Authorization maximum entry warning"
^DIC(9.4,52,22,29,"PAH",167,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",167,1,3,0)="2. Site was able to receive same order multiple times"
^DIC(9.4,52,22,29,"PAH",167,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",167,1,5,0)="3. Prompt Pay processing issues "
^DIC(9.4,52,22,29,"PAH",168,0)="192 SEQ #171^3161006.130108^54"
^DIC(9.4,52,22,29,"PAH",168,1,0)="^^6^6^3161006"
^DIC(9.4,52,22,29,"PAH",168,1,1,0)="1. Delivery Orders not reflecting the Prompt Pay %"
^DIC(9.4,52,22,29,"PAH",168,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",168,1,3,0)="2. Raise order limit to $3500 for Simplified orders"
^DIC(9.4,52,22,29,"PAH",168,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",168,1,5,0)="3. Insure correct Fund Control Point (FCP) adjusted for FMS deposits "
^DIC(9.4,52,22,29,"PAH",168,1,6,0)="   received by IFCAP"
^DIC(9.4,52,22,29,"PAH",169,0)="199 SEQ #173^3170627.1514^54"
^DIC(9.4,52,22,29,"PAH",169,1,0)="^^4^4^3170627"
^DIC(9.4,52,22,29,"PAH",169,1,1,0)="1. FMS Exception Report not working due to Fileman date call."
^DIC(9.4,52,22,29,"PAH",169,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",169,1,3,0)="2. Prosthetics GUI times out when entering order against FCP with multiple"
^DIC(9.4,52,22,29,"PAH",169,1,4,0)="   Inventory Points attached."
^DIC(9.4,52,22,29,"PAH",170,0)="200 SEQ #174^3170830.171636^54"
^DIC(9.4,52,22,29,"PAH",170,1,0)="^^2^2^3170830"
^DIC(9.4,52,22,29,"PAH",170,1,1,0)="1. Keep Perpetual Inventory not working correctly for inventory "
^DIC(9.4,52,22,29,"PAH",170,1,2,0)="   distribution of items to the Secondary Inventory Point."
^DIC(9.4,52,22,29,"PAH",171,0)="194 SEQ #175^3170928.152746^54"
^DIC(9.4,52,22,29,"PAH",171,1,0)="^^5^5^3170928"
^DIC(9.4,52,22,29,"PAH",171,1,1,0)="This patch will address the following 3 issues:"
^DIC(9.4,52,22,29,"PAH",171,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",171,1,3,0)="1. Option PRCHLO CLO PROCUREMENT maintenance"
^DIC(9.4,52,22,29,"PAH",171,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",171,1,5,0)="2. Error when entering 2237 in new FY"
^DIC(9.4,52,22,29,"PAH",172,0)="196^3180130.150817^54"
^DIC(9.4,52,22,29,"PAH",172,1,0)="^^5^5^3180130"
^DIC(9.4,52,22,29,"PAH",172,1,1,0)="1. Add new Transaction (Ceiling) may have endless loop at times"
^DIC(9.4,52,22,29,"PAH",172,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",172,1,3,0)="2. Auto obligation of Delivery Orders ignores Overcommit (off)."
^DIC(9.4,52,22,29,"PAH",172,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",172,1,5,0)="3. Next FY 1358s, 2237s and orders rejected by FMS in that FY."
^DIC(9.4,52,22,29,"PAH",173,0)="202 SEQ #177^3180301.152618^54"
^DIC(9.4,52,22,29,"PAH",173,1,0)="^^7^7^3180301"
^DIC(9.4,52,22,29,"PAH",173,1,1,0)="This patch will fix two issues:"
^DIC(9.4,52,22,29,"PAH",173,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",173,1,3,0)="1) When a Receiving Report is deleted the default status is not a valid"
^DIC(9.4,52,22,29,"PAH",173,1,4,0)="entry, so when it times out the status is set to an invalid status"
^DIC(9.4,52,22,29,"PAH",173,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",173,1,6,0)="2) A message is served for POA, PRJ, and ACT the ISMS/FMS TRANS (#423.6) "
^DIC(9.4,52,22,29,"PAH",173,1,7,0)="   file is not cleared"
^DIC(9.4,52,22,29,"PAH",174,0)="201 SEQ #178^3180302.152324^54"
^DIC(9.4,52,22,29,"PAH",174,1,0)="^^3^3^3180302"
^DIC(9.4,52,22,29,"PAH",174,1,1,0)="When the user enters a ""^^"" into Copy Control Point User and Profiles"
^DIC(9.4,52,22,29,"PAH",174,1,2,0)="[PRCB FCP USER COPY] option to exit out and then enters a ""^"" it receives "
^DIC(9.4,52,22,29,"PAH",174,1,3,0)="and error."
^DIC(9.4,52,22,29,"PAH",175,0)="204 SEQ #179^3180424.162345^54"
^DIC(9.4,52,22,29,"PAH",175,1,0)="^^15^15^3180424"
^DIC(9.4,52,22,29,"PAH",175,1,1,0)="Resolves four issues:"
^DIC(9.4,52,22,29,"PAH",175,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",175,1,3,0)="1) When a user enters a temporary transaction, exits out of the session "
^DIC(9.4,52,22,29,"PAH",175,1,4,0)="and then tries to edit that request there will be an undefined error."
^DIC(9.4,52,22,29,"PAH",175,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",175,1,6,0)="2) If a user exits while creating a 2237, then edits that same 2237, but "
^DIC(9.4,52,22,29,"PAH",175,1,7,0)="times out at the field ""DATE OF REQUEST"" an error will occur."
^DIC(9.4,52,22,29,"PAH",175,1,8,0)=" "
^DIC(9.4,52,22,29,"PAH",175,1,9,0)="3) An error will occur if a temporary transaction is edited in the 2237."
^DIC(9.4,52,22,29,"PAH",175,1,10,0)=" "
^DIC(9.4,52,22,29,"PAH",175,1,11,0)="4) When entering a new 2237 if the user ""jumps"" at the ""PRIORITY OF "
^DIC(9.4,52,22,29,"PAH",175,1,12,0)="REQUEST"" field to the ""COMMENTS"" field then exits an error occurs."
^DIC(9.4,52,22,29,"PAH",175,1,13,0)=" "
^DIC(9.4,52,22,29,"PAH",175,1,14,0)="5) If a fund has a multi-approriation the beginning budget fiscal year"
^DIC(9.4,52,22,29,"PAH",175,1,15,0)="may not match the fiscal year."
^DIC(9.4,52,22,29,"PAH",176,0)="205 SEQ #180^3180706.121823^54"
^DIC(9.4,52,22,29,"PAH",176,1,0)="^^3^3^3180706"
^DIC(9.4,52,22,29,"PAH",176,1,1,0)="This patch addresses an issue with the Distribution Order Processing"
^DIC(9.4,52,22,29,"PAH",176,1,2,0)="[PRCP DIST ORDER PROCESSING] option when an item quantity is null or 0 "
^DIC(9.4,52,22,29,"PAH",176,1,3,0)="which leads to an undefined error."
^DIC(9.4,52,22,29,"PAH",177,0)="208 SEQ #181^3180925.152504^54"
^DIC(9.4,52,22,29,"PAH",177,1,0)="^^3^3^3180925"
^DIC(9.4,52,22,29,"PAH",177,1,1,0)="Modify $3500 limit to be $10000 for micro-purchase threshold for goods "
^DIC(9.4,52,22,29,"PAH",177,1,2,0)="and services. Also, the SPL was increased to $10000 for all PCards for "
^DIC(9.4,52,22,29,"PAH",177,1,3,0)="simplified orders."
^DIC(9.4,52,22,29,"PAH",178,0)="211 SEQ #184^3190905.164659^65"
^DIC(9.4,52,22,29,"PAH",178,1,0)="^^2^2^3190905"
^DIC(9.4,52,22,29,"PAH",178,1,1,0)="1. Vendor VR code sheets (document file) are not flagged as accepted"
^DIC(9.4,52,22,29,"PAH",178,1,2,0)="   when FMS passes back the VUP vendor confirmation to Vista"
^DIC(9.4,52,22,29,"PAH",179,0)="209 SEQ #185^3190923.113432^65"
^DIC(9.4,52,22,29,"PAH",179,1,0)="^^6^6^3190923"
^DIC(9.4,52,22,29,"PAH",179,1,1,0)="1) If there is not a unique Appropriation Code for a Fund Control Point "
^DIC(9.4,52,22,29,"PAH",179,1,2,0)="(FCP) an error will be prompted warning that it is not unique. "
^DIC(9.4,52,22,29,"PAH",179,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",179,1,4,0)="2) When an appropriation in a no-year fund has the incorrect value for "
^DIC(9.4,52,22,29,"PAH",179,1,5,0)="the Fiscal Year, it will prompt the user with an error saying it is the "
^DIC(9.4,52,22,29,"PAH",179,1,6,0)="wrong fiscal year.  "
^DIC(9.4,52,22,29,"PAH",180,0)="212 SEQ #186^3191219.144757^65"
^DIC(9.4,52,22,29,"PAH",180,1,0)="^^2^2^3191219"
^DIC(9.4,52,22,29,"PAH",180,1,1,0)="This patch adds the national option IFCAP USERS BY ROLES COUNTS [PRCHUSER "
^DIC(9.4,52,22,29,"PAH",180,1,2,0)="ROLE COUNTS], which can be scheduled to run quarterly. "
^DIC(9.4,52,22,29,"PAH",181,0)="213^3191230.125918^65"
^DIC(9.4,52,22,29,"PAH",181,1,0)="^^2^2^3191230"
^DIC(9.4,52,22,29,"PAH",181,1,1,0)="1. All Cost Centers link to a Fund Control Point are not presented for"
^DIC(9.4,52,22,29,"PAH",181,1,2,0)="   selection (the current limit is 70 cost centers compiled)"
^DIC(9.4,52,22,29,"PAH",182,0)="198 SEQ #188^3200211.100106^65"
^DIC(9.4,52,22,29,"PAH",182,1,0)="^^9^9^3200211"
^DIC(9.4,52,22,29,"PAH",182,1,1,0)="This patch enhances the NIF/IFCAP ITEM MASTER file (#441) interface "
^DIC(9.4,52,22,29,"PAH",182,1,2,0)="by implementing the import of new item file entries and the population"
^DIC(9.4,52,22,29,"PAH",182,1,3,0)="of additional fields. The interface also supports updates to existing "
^DIC(9.4,52,22,29,"PAH",182,1,4,0)="item entries in station specific transactions when supplied the IMF#"
^DIC(9.4,52,22,29,"PAH",182,1,5,0)="for the item at that site. The MANUFACTURER file (#440.4) is introduced,"
^DIC(9.4,52,22,29,"PAH",182,1,6,0)="as well as, a means to populate the file through a batch load or"
^DIC(9.4,52,22,29,"PAH",182,1,7,0)="interactive user edit. It also sets up restricted vendor and item ien"
^DIC(9.4,52,22,29,"PAH",182,1,8,0)="ranges for only privileged users to edit entries controlled by the"
^DIC(9.4,52,22,29,"PAH",182,1,9,0)="Procurement & Logistic Office (P&LO)."
^DIC(9.4,52,22,29,"PAH",183,0)="216 SEQ #189^3200228.130203^65"
^DIC(9.4,52,22,29,"PAH",183,1,0)="^^1^1^3200228"
^DIC(9.4,52,22,29,"PAH",183,1,1,0)="1) This patch updates the AUTHORITY OF REQUEST (#410.9) file."
^DIC(9.4,52,22,29,"PAH",184,0)="215 SEQ #190^3200311.110517^65"
^DIC(9.4,52,22,29,"PAH",184,1,0)="^^7^7^3200311"
^DIC(9.4,52,22,29,"PAH",184,1,1,0)="1) This patch fixes an infinite loop in the Reconciliation Menu [PRCH "
^DIC(9.4,52,22,29,"PAH",184,1,2,0)="RECONCILE MENU] when two cards have replaced each other"
^DIC(9.4,52,22,29,"PAH",184,1,3,0)=" "
^DIC(9.4,52,22,29,"PAH",184,1,4,0)="2) This patch also adds a help prompt in field VENDOR (#5) in file "
^DIC(9.4,52,22,29,"PAH",184,1,5,0)="PROCUREMENT & ACCOUNTING TRANSACTIONS (#442), and modifies the input "
^DIC(9.4,52,22,29,"PAH",184,1,6,0)="template PRCHVENDOR to prompt for field FEDERAL SOURCE (.06) in file "
^DIC(9.4,52,22,29,"PAH",184,1,7,0)="VENDOR (#440) when adding a new vendor."
^DIC(9.4,52,22,29,"PAH",185,0)="217 SEQ #191^3200810.130322^65"
^DIC(9.4,52,22,29,"PAH",185,1,0)="^^7^7^3200810"
^DIC(9.4,52,22,29,"PAH",185,1,1,0)="1) This patch fixes an issue when a Delivery Order fails because it was "
^DIC(9.4,52,22,29,"PAH",185,1,2,0)="originally a Purchase Order which was converted. In file PROCUREMENT & "
^DIC(9.4,52,22,29,"PAH",185,1,3,0)="ACCOUNTING TRANSACTIONS (#442) field PROCESSING REQUIRED IN FISCAL (#63) "
^DIC(9.4,52,22,29,"PAH",185,1,4,0)="exists when it should not. "
^DIC(9.4,52,22,29,"PAH",185,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",185,1,6,0)="2) This patch fixes printing formatting issues with the option Fiscal "
^DIC(9.4,52,22,29,"PAH",185,1,7,0)="Pending Action [PRCB RPT FISCAL PENDING ACTION]."
^DIC(9.4,52,22,29,"PAH",186,0)="221b^3210720"
^DIC(9.4,52,22,29,"PAH",186,1,0)="^^5^5^3210720"
^DIC(9.4,52,22,29,"PAH",186,1,1,0)="Backup of PRC*5.1*221 on Jul 20, 2021"
^DIC(9.4,52,22,29,"PAH",186,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",186,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,52,22,29,"PAH",186,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,52,22,29,"PAH",186,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,52,22,29,"PAH",187,0)="221 SEQ #193^3210720.14201^17"
^DIC(9.4,52,22,29,"PAH",187,1,0)="^^6^6^3210720"
^DIC(9.4,52,22,29,"PAH",187,1,1,0)="1. IFCAP Edit Inventory item for $0 Total Value and On-hand>0 "
^DIC(9.4,52,22,29,"PAH",187,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",187,1,3,0)="2. Ensure Order Item description does not violate order printability"
^DIC(9.4,52,22,29,"PAH",187,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",187,1,5,0)="3. Prevent <undefined> error when an order is displayed at the same time"
^DIC(9.4,52,22,29,"PAH",187,1,6,0)="   the order amendment is approved"
^DIC(9.4,52,22,29,"PAH",188,0)="223b^3210728"
^DIC(9.4,52,22,29,"PAH",188,1,0)="^^5^5^3210728"
^DIC(9.4,52,22,29,"PAH",188,1,1,0)="Backup of PRC*5.1*223 on Jul 28, 2021"
^DIC(9.4,52,22,29,"PAH",188,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",188,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,52,22,29,"PAH",188,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,52,22,29,"PAH",188,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,52,22,29,"PAH",189,0)="223 SEQ #194^3210728.100254^17"
^DIC(9.4,52,22,29,"PAH",189,1,0)="^^9^9^3210728"
^DIC(9.4,52,22,29,"PAH",189,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,52,22,29,"PAH",189,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",189,1,3,0)="1. APAR missing due-in orders from Vista"
^DIC(9.4,52,22,29,"PAH",189,1,4,0)=" "
^DIC(9.4,52,22,29,"PAH",189,1,5,0)="2. Correct FMS Transaction date handling in Invoice Processing for Payment"
^DIC(9.4,52,22,29,"PAH",189,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",189,1,7,0)="3. Modify fiscal receipt handling/transmission "
^DIC(9.4,52,22,29,"PAH",189,1,8,0)=" "
^DIC(9.4,52,22,29,"PAH",189,1,9,0)="4. Add a new Sub-Authority to 1358 handling"
^DIC(9.4,52,22,29,"PAH",190,0)="220b^3210728"
^DIC(9.4,52,22,29,"PAH",190,1,0)="^^5^5^3210728"
^DIC(9.4,52,22,29,"PAH",190,1,1,0)="Backup of PRC*5.1*220 on Jul 28, 2021"
^DIC(9.4,52,22,29,"PAH",190,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",190,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,52,22,29,"PAH",190,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,52,22,29,"PAH",190,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,52,22,29,"PAH",191,0)="220 SEQ #195^3210728.174322^17"
^DIC(9.4,52,22,29,"PAH",191,1,0)="^^3^3^3210728"
^DIC(9.4,52,22,29,"PAH",191,1,1,0)="There is one incident corrected in this patch:"
^DIC(9.4,52,22,29,"PAH",191,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",191,1,3,0)="1. STOP FPDS MESSAGE TRANSMISSION TO AAC"
^DIC(9.4,52,22,29,"PAH",192,0)="224 SEQ #196^3220103.124447^17"
^DIC(9.4,52,22,29,"PAH",192,1,0)="^^3^3^3220103"
^DIC(9.4,52,22,29,"PAH",192,1,1,0)="Patch PRC*5.1*224 will update line item internal entry numbers (IENs)"
^DIC(9.4,52,22,29,"PAH",192,1,2,0)="and remove associated discounts when a line item is deleted using the"
^DIC(9.4,52,22,29,"PAH",192,1,3,0)="Edit an Incomplete Purchase Order [PRCHPC PO EDIT] option."
^DIC(9.4,52,22,29,"PAH",193,0)="225 SEQ #197^3220413.163239^86"
^DIC(9.4,52,22,29,"PAH",193,1,0)="^^2^2^3220413"
^DIC(9.4,52,22,29,"PAH",193,1,1,0)="This patch creates a Purchase Card Order accrual data extract in support"
^DIC(9.4,52,22,29,"PAH",193,1,2,0)="of the FMBT (Financial Management Business Transformation) initiative."
^DIC(9.4,52,22,29,"PAH",194,0)="226 SEQ #198^3220503.111932^86"
^DIC(9.4,52,22,29,"PAH",194,1,0)="^^3^3^3220503"
^DIC(9.4,52,22,29,"PAH",194,1,1,0)="This patch changes the default directory for the ""Enter the file's "
^DIC(9.4,52,22,29,"PAH",194,1,2,0)="directory: "" prompts for the item and manufacturer bulk load options.  It "
^DIC(9.4,52,22,29,"PAH",194,1,3,0)="also provides a default file name for the manufacturer bulk load option."
^DIC(9.4,52,22,29,"PAH",195,0)="227 SEQ #199^3220920.220058^90"
^DIC(9.4,52,22,29,"PAH",195,1,0)="^^6^6^3220920"
^DIC(9.4,52,22,29,"PAH",195,1,1,0)="This patch creates fields in the VENDOR (#440) File and the VENDOR EDIT"
^DIC(9.4,52,22,29,"PAH",195,1,2,0)="(#440.3) File to store the GSA SAM Unique Entity Identifier (UEI).  It"
^DIC(9.4,52,22,29,"PAH",195,1,3,0)="also adds the UEI to the VENDOR File's Identifier. It also adds the UEI"
^DIC(9.4,52,22,29,"PAH",195,1,4,0)="to Input Templates so that the value can be entered into the VENDOR File"
^DIC(9.4,52,22,29,"PAH",195,1,5,0)="entries.  Additionally, this patch adds the UEI field to the OMN^O07 HL7"
^DIC(9.4,52,22,29,"PAH",195,1,6,0)="message sending 2237 data from IFCAP to eCMS."
^DIC(9.4,52,22,29,"PAH",196,0)="228 SEQ #200^3221227.102139^90"
^DIC(9.4,52,22,29,"PAH",196,1,0)="^^1^1^3221227"
^DIC(9.4,52,22,29,"PAH",196,1,1,0)="1. Usage Demand Analysis Report time period calculation is off by 1 month"
^DIC(9.4,52,22,29,"PAH",197,0)="230 SEQ #201^3230627.141301^89"
^DIC(9.4,52,22,29,"PAH",197,1,0)="^^3^3^3230627"
^DIC(9.4,52,22,29,"PAH",197,1,1,0)="Patch PRC*5.1*230 addresses an issue where 1st and 2nd digits of 4 digit"
^DIC(9.4,52,22,29,"PAH",197,1,2,0)="year were used for fiscal year instead of 3rd and 4th digits of 4 digit "
^DIC(9.4,52,22,29,"PAH",197,1,3,0)="year for fiscal year."
^DIC(9.4,52,22,29,"PAH",198,0)="232 SEQ #202^3231122.115332^89"
^DIC(9.4,52,22,29,"PAH",198,1,0)="^^1^1^3231122"
^DIC(9.4,52,22,29,"PAH",198,1,1,0)="REMOVE SEMI-COLONS BEFORE SENDING TO FILEMAN"
^DIC(9.4,52,22,29,"PAH",199,0)="232b^3231128.111926^89"
^DIC(9.4,52,22,29,"PAH",199,1,0)="^^5^5^3231128"
^DIC(9.4,52,22,29,"PAH",199,1,1,0)="Backup of PRC*5.1*232 on Nov 22, 2023"
^DIC(9.4,52,22,29,"PAH",199,1,2,0)=" "
^DIC(9.4,52,22,29,"PAH",199,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,52,22,29,"PAH",199,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,52,22,29,"PAH",199,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,52,22,29,"PAH",200,0)="233 SEQ #203^3240411.105718^89"
^DIC(9.4,52,22,29,"PAH",200,1,0)="^^1^1^3240411"
^DIC(9.4,52,22,29,"PAH",200,1,1,0)="REMOVE SEMI-COLONS BEFORE SENDING TO FILEMAN"
^DIC(9.4,52,22,29,"PAH",201,0)="229 SEQ #204^3240528.105507^89"
^DIC(9.4,52,22,29,"PAH",201,1,0)="^^1^1^3240528"
^DIC(9.4,52,22,29,"PAH",201,1,1,0)="CLEAR BAD DATA NODES IN THE FUND CONTROL POINT (#420) FILE"
^DIC(9.4,52,22,29,"PAH",202,0)="236 SEQ #206^3241115.143412^89"
^DIC(9.4,52,22,29,"PAH",202,1,0)="^^2^2^3241115"
^DIC(9.4,52,22,29,"PAH",202,1,1,0)="Patch PRC*5.1*236 adds FORTY (40) federal supply classification numbers"
^DIC(9.4,52,22,29,"PAH",202,1,2,0)="to the FEDERAL SUPPLY CLASSIFICATION (#441.2) file."
^DIC(9.4,52,22,29,"PAH",203,0)="231 SEQ #207^3250324.115051^90"
^DIC(9.4,52,22,29,"PAH",203,1,0)="^^7^7^3250324"
^DIC(9.4,52,22,29,"PAH",203,1,1,0)="The purpose of this patch is to count the description and comment fields "
^DIC(9.4,52,22,29,"PAH",203,1,2,0)="character size accumulated for transmission and limit those fields output "
^DIC(9.4,52,22,29,"PAH",203,1,3,0)="for transmission to 210 characters."
^DIC(9.4,52,22,29,"PAH",203,1,4,0)="When an entry in the PROCUREMENT & ACCOUNTING TRANSACTIONS FILE "
^DIC(9.4,52,22,29,"PAH",203,1,5,0)="Description field or COMMENTS contain more than 210 characters the "
^DIC(9.4,52,22,29,"PAH",203,1,6,0)="VISTA/IFCAP receiving reports do not transmitt to the VA accounting "
^DIC(9.4,52,22,29,"PAH",203,1,7,0)="system due to oversize transaction."
^DIC(9.4,52,22,29,"PAH",204,0)="238 SEQ #209^3250709.094644^90"
^DIC(9.4,52,22,29,"PAH",204,1,0)="^^8^8^3250709"
^DIC(9.4,52,22,29,"PAH",204,1,1,0)="IFCAP-GIP Users are currently prompted to respond to Federal Procurement"
^DIC(9.4,52,22,29,"PAH",204,1,2,0)="Data System (FPDS) questions during order entry. However, answers have not"
^DIC(9.4,52,22,29,"PAH",204,1,3,0)="been sent to the Austin Accounting Center (AAC) since the interface was "
^DIC(9.4,52,22,29,"PAH",204,1,4,0)="shutdown via IFCAP patch PRC*5.1*220 (STOP FPDS MESSAGE TRANSMISSION) "
^DIC(9.4,52,22,29,"PAH",204,1,5,0)="that was nationally released in July 2021. "
^DIC(9.4,52,22,29,"PAH",204,1,6,0)=" "
^DIC(9.4,52,22,29,"PAH",204,1,7,0)="Supply chain users are prompted to provide responses to FPDS, this patch"
^DIC(9.4,52,22,29,"PAH",204,1,8,0)="is removing the FPDS questions."
^DIC(9.4,52,22,29,"PAH",205,0)="246 SEQ #211^3251022.133017^90"
^DIC(9.4,52,22,29,"PAH",205,1,0)="^^9^9^3251022"
^DIC(9.4,52,22,29,"PAH",205,1,1,0)="When reviewing a New Purchase Order, the total cost is being shown in the "
^DIC(9.4,52,22,29,"PAH",205,1,2,0)="header section as 0.00 instead of the correct total cost. This patch "
^DIC(9.4,52,22,29,"PAH",205,1,3,0)="corrects this to ensure the total cost is correctly displayed in the "
^DIC(9.4,52,22,29,"PAH",205,1,4,0)="header."
^DIC(9.4,52,22,29,"PAH",205,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",205,1,6,0)="Apply code to the PRCHNPO1 routine to set the global ^PRC(442,,0) 15th "
^DIC(9.4,52,22,29,"PAH",205,1,7,0)="piece to the total cost value before the final FileMan DIE call to various"
^DIC(9.4,52,22,29,"PAH",205,1,8,0)="templates and DR strings, ensuring the correct value is displayed"
^DIC(9.4,52,22,29,"PAH",205,1,9,0)="regardless of the branching."
^DIC(9.4,52,22,29,"PAH",206,0)="247 SEQ #212^3251022.135203^90"
^DIC(9.4,52,22,29,"PAH",206,1,0)="^^1^1^3251022"
^DIC(9.4,52,22,29,"PAH",206,1,1,0)="Patch PRC*5.1*247 marks the PRCHL GUI option out of order"
^DIC(9.4,52,22,29,"PAH",207,0)="244 SEQ #213^3251118.152555^90"
^DIC(9.4,52,22,29,"PAH",207,1,0)="^^6^6^3251118"
^DIC(9.4,52,22,29,"PAH",207,1,1,0)="This patch adds the ability to define and store the ABC Classification "
^DIC(9.4,52,22,29,"PAH",207,1,2,0)="code for inventory items. A new field, ABC INVENTORY CLASSIFICATION "
^DIC(9.4,52,22,29,"PAH",207,1,3,0)="(#.45) in the INVENTORY ITEM (#445.01) subfile of the GENERIC INVENTORY "
^DIC(9.4,52,22,29,"PAH",207,1,4,0)="(#445) file, has been added to store the ABC Classification, and the "
^DIC(9.4,52,22,29,"PAH",207,1,5,0)="PRCPEILM, PRCPEITE, and PRCPEIL1 routines have been updated to access and "
^DIC(9.4,52,22,29,"PAH",207,1,6,0)="store to this variable when editing Inventory Items."
^DIC(9.4,52,22,29,"PAH",208,0)="250 SEQ #214^3260316.125457^90"
^DIC(9.4,52,22,29,"PAH",208,1,0)="^^1^1^3260316"
^DIC(9.4,52,22,29,"PAH",208,1,1,0)="NEED TO INCREASE PURCHASE CARD LIMIT"
