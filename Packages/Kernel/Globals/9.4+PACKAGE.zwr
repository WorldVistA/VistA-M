^DIC(9.4,47,22,5.9,"PAH",319,0)="449 SEQ #398^3020724^1"
^DIC(9.4,47,22,5.9,"PAH",319,1,0)="^^3^3^3020724"
^DIC(9.4,47,22,5.9,"PAH",319,1,1,0)="REMOVE TREATING FACILITY SCREEN"
^DIC(9.4,47,22,5.9,"PAH",319,1,2,0)="Refer to patch DG*5.3*449 in the FORUM Patch Module for a complete"
