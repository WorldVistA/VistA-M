^DIC(9.4,28,22,6,"PAH",4,1,15,0)="Tuscaloosa, AL - 679"
^DIC(9.4,28,22,6,"PAH",4,1,16,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,17,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,18,0)="Routine Summary:"
^DIC(9.4,28,22,6,"PAH",4,1,19,0)="==============="
