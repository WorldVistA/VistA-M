^DIC(9.4,165,22,1,"PAH",127,1,0)="^^2^2^3130909"
^DIC(9.4,165,22,1,"PAH",127,1,1,0)="Patch ECX*3.0*146 adds 41 new clinic codes and updates the description"
^DIC(9.4,165,22,1,"PAH",127,1,2,0)="of 4 existing codes in the NATIONAL CLINIC (#728.441) file."
^DIC(9.4,165,22,1,"PAH",128,0)="142 SEQ #130^3130912.104229^17"
^DIC(9.4,165,22,1,"PAH",128,1,0)="^^12^12^3130912"
^DIC(9.4,165,22,1,"PAH",128,1,1,0)="Patch ECX*3.0*142 addresses three different issues:"
^DIC(9.4,165,22,1,"PAH",128,1,2,0)=" "
^DIC(9.4,165,22,1,"PAH",128,1,3,0)="        1.  IVP Source Audit Report is displaying test patients."
^DIC(9.4,165,22,1,"PAH",128,1,4,0)=" "
^DIC(9.4,165,22,1,"PAH",128,1,5,0)="  "
^DIC(9.4,165,22,1,"PAH",128,1,6,0)="        2.  After editing DSS Clinic Stop Codes routine (ECXSCLD) does"
^DIC(9.4,165,22,1,"PAH",128,1,7,0)="            not prompt for another clinic but returns to the prior menu."
^DIC(9.4,165,22,1,"PAH",128,1,8,0)=" "
^DIC(9.4,165,22,1,"PAH",128,1,9,0)=" "
^DIC(9.4,165,22,1,"PAH",128,1,10,0)=" "
^DIC(9.4,165,22,1,"PAH",128,1,11,0)="        3.  Worksheets for DSS Clinic Stops [ECXSCLOAD] option does not"
^DIC(9.4,165,22,1,"PAH",128,1,12,0)="            display edit to Inactive Clinics."
^DIC(9.4,165,22,1,"PAH",129,0)="144 SEQ #131^3131029.153512^17"
