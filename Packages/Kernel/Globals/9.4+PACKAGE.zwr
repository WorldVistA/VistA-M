^DIC(9.4,48,22,5.28,"PAH",696,1,4,0)="VSE-9509: JJ - VistA: Update the veteran crisis line telephone number to"
^DIC(9.4,48,22,5.28,"PAH",696,1,5,0)="               ""988 x 1"", so that ISS reflects the preference set from"
^DIC(9.4,48,22,5.28,"PAH",696,1,6,0)="VSE-9574: MB - VistA: Modify SDES2 GET CLINIC INFO to include the "
^DIC(9.4,48,22,5.28,"PAH",696,1,7,0)="               diagnosis multiple and privileged user multiple IVC."
^DIC(9.4,48,22,5.28,"PAH",696,1,8,0)="VSE-9575: JC - VistA: Create a new SDES2 RPC to replace SDES GET VISTA "
^DIC(9.4,48,22,5.28,"PAH",696,1,9,0)="               DEVICES "
^DIC(9.4,48,22,5.28,"PAH",696,1,10,0)="VSE-9691: TB - VistA: The SDES REACTIVATE CLINIC has logic to check for"
^DIC(9.4,48,22,5.28,"PAH",696,1,11,0)="               an error returned by FileMan but it is flawed"
^DIC(9.4,48,22,5.28,"PAH",696,1,12,0)="VSE-9700: JJ - VistA: Modify the SDES2 SEARCH CLIN BY STOP CODE RPC to "
^DIC(9.4,48,22,5.28,"PAH",696,1,13,0)="               prevent the return of a null return, which causes a 500"
^DIC(9.4,48,22,5.28,"PAH",696,1,14,0)="               error in CCMM"
^DIC(9.4,48,22,5.28,"PAH",696,1,15,0)="VSE-9701: JV - VistA: MRTC parent requests were left open even though "
^DIC(9.4,48,22,5.28,"PAH",696,1,16,0)="               all the children requests have been dispositioned"
^DIC(9.4,48,22,5.28,"PAH",696,1,17,0)="VSE-9702: JS - VistA: Update SDES2 EDIT APPOINTMENT RPC to prevent null "
^DIC(9.4,48,22,5.28,"PAH",696,1,18,0)="               Note values in the Note Audit section"
^DIC(9.4,48,22,5.28,"PAH",696,1,19,0)="VSE-9711: MB - VistA: Users are unable to inactivate a clinic at the "
^DIC(9.4,48,22,5.28,"PAH",696,1,20,0)="               exact 6 month mark"
^DIC(9.4,48,22,5.28,"PAH",696,1,21,0)="VSE-9747: LB - VistA: Modify FMTISO API to no longer use the kernel "
^DIC(9.4,48,22,5.28,"PAH",696,1,22,0)="               logic to convert date"
^DIC(9.4,48,22,5.28,"PAH",696,1,23,0)="VSE-9995: LB - VistA: Modify SDES2 GET CANCELLED SLOTS RPC to return"
^DIC(9.4,48,22,5.28,"PAH",696,1,24,0)="               back a Boolean fullDayCancelled flag "
