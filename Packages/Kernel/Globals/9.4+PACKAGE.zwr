^DIC(9.4,48,22,5.28,"PAH",676,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",676,1,4,0)="VSE-8228: JS - VistA: Modify GET CLIN* RPCs to return the new Veteran "
^DIC(9.4,48,22,5.28,"PAH",676,1,5,0)="          Self Cancel field."
^DIC(9.4,48,22,5.28,"PAH",676,1,6,0)="VSE-8230: JS - VistA: Add Veteran self-cancel to the clinic object "
^DIC(9.4,48,22,5.28,"PAH",676,1,7,0)="          returned by SDES2 GET APPT* RPC's"
^DIC(9.4,48,22,5.28,"PAH",676,1,8,0)="VSE-8231: JS - VistA: Create a post-install routine that will set the "
^DIC(9.4,48,22,5.28,"PAH",676,1,9,0)="          Veteran self-cancel flag for clinics"
