^DIC(9.4,4,22,1,"PAH",161,1,46,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",161,1,47,0)=" Select INSTALL NAME:    XM*7.1*190    Loaded from Distribution  <date/time>"
