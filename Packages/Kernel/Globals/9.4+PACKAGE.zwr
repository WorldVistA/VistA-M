^DIC(9.4,47,22,5.9,"PAH",638,1,0)="^^4^4^3100326"
^DIC(9.4,47,22,5.9,"PAH",638,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",638,1,2,0)="VETERAN ON-LINE APPLICATION (VOA) ENHANCEMENT"
