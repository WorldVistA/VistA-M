^DIC(9.4,4,22,1,"PAH",84,1,143,0)="This patch introduces the following new routines:"
^DIC(9.4,4,22,1,"PAH",84,1,144,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,145,0)="Routine      Callable at     Description"
^DIC(9.4,4,22,1,"PAH",84,1,146,0)="---------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",84,1,147,0)="XMXADDR3     N/A"
^DIC(9.4,4,22,1,"PAH",84,1,148,0)="XMXADDR4     N/A"
^DIC(9.4,4,22,1,"PAH",84,1,149,0)="XMYPOSTB     N/A"
^DIC(9.4,4,22,1,"PAH",84,1,150,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",84,1,151,0)=" "
^DIC(9.4,4,22,1,"PAH",84,1,152,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",84,1,153,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",84,1,154,0)="minimum.  It requires Kernel patch XU*8.0*135 and MailMan patches XM*7.1*74,"
^DIC(9.4,4,22,1,"PAH",84,1,155,0)="XM*7.1*94, XM*7.1*99, XM*7.1*102, XM*7.1*103, XM*7.1*104, XM*7.1*105,"
^DIC(9.4,4,22,1,"PAH",84,1,156,0)="and XM*7.1*106."
^DIC(9.4,4,22,1,"PAH",84,1,157,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",84,1,158,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",84,1,159,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",84,1,160,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",84,1,161,0)="3.  You do not need to stop TaskMan, but you should stop the background"
^DIC(9.4,4,22,1,"PAH",84,1,162,0)="    filer.  On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",84,1,163,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",84,1,164,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",84,1,165,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",84,1,166,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",84,1,167,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",84,1,168,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",84,1,169,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",84,1,170,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",84,1,171,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",84,1,172,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",84,1,173,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",84,1,174,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",84,1,175,0)=" Select INSTALL NAME:    XM*7.1*107     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",84,1,176,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",84,1,177,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",84,1,178,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",84,1,179,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",84,1,180,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",84,1,181,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",84,1,182,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",84,1,183,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",84,1,184,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",84,1,185,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,186,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,1,"PAH",84,1,187,0)="                ------------------"
^DIC(9.4,4,22,1,"PAH",84,1,188,0)="5.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",84,1,189,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",84,1,190,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",84,1,191,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",84,1,192,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",84,1,193,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",84,1,194,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",85,0)="116 SEQ #110^3000229^1"
^DIC(9.4,4,22,1,"PAH",85,1,0)="^^55^55^3000229"
^DIC(9.4,4,22,1,"PAH",85,1,1,0)="Patch XM*7.1*116"
^DIC(9.4,4,22,1,"PAH",85,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",85,1,3,0)="This patch may be installed at any time,"
^DIC(9.4,4,22,1,"PAH",85,1,4,0)="EXCEPT from 2/28/2000 through 3/3/2000 (the Leapyear Lockdown Period). "
^DIC(9.4,4,22,1,"PAH",85,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",85,1,6,0)="NOIS: NHM-0100-12338"
^DIC(9.4,4,22,1,"PAH",85,1,7,0)="Test Site: Northampton, MA"
^DIC(9.4,4,22,1,"PAH",85,1,8,0)="Fixes a bug which causes messages queued for later delivery to a personal"
^DIC(9.4,4,22,1,"PAH",85,1,9,0)="mail group not to be delivered."
^DIC(9.4,4,22,1,"PAH",85,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",85,1,11,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",85,1,12,0)="minimum.  It requires MailMan patch XM*7.1*107."
^DIC(9.4,4,22,1,"PAH",85,1,13,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",85,1,14,0)=""
^DIC(9.4,4,22,1,"PAH",85,1,15,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",85,1,16,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",85,1,17,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",85,1,18,0)=" "
