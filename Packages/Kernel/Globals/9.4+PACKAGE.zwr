^DIC(9.4,14,22,5.9,"PAH",141,1,121,0)=""
^DIC(9.4,14,22,5.9,"PAH",141,1,122,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",141,1,123,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",141,1,124,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",141,1,125,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",141,1,126,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",141,1,127,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,128,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",141,1,129,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",141,1,130,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",141,1,131,0)="   LR313            N/A            4332118        **313** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",141,1,132,0)="   LREGFR           2490467        3964631        **289,313**"
^DIC(9.4,14,22,5.9,"PAH",141,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,134,0)=" List of preceding patches: 289"
^DIC(9.4,14,22,5.9,"PAH",141,1,135,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",141,1,136,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,137,0)="  "
^DIC(9.4,14,22,5.9,"PAH",141,1,138,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",141,1,139,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",141,1,140,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,141,0)=" The install time for this patch is less than 5 minute. This patch can be"
^DIC(9.4,14,22,5.9,"PAH",141,1,142,0)=" installed when Laboratory users are on the system. However these users"
^DIC(9.4,14,22,5.9,"PAH",141,1,143,0)=" should not be using any of the Laboratory's package verifying options."
^DIC(9.4,14,22,5.9,"PAH",141,1,144,0)=" Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",141,1,145,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,146,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,147,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",141,1,148,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",141,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,150,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",141,1,151,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",141,1,152,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,153,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,154,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",141,1,155,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,156,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",141,1,157,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",141,1,158,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,159,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",141,1,160,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",141,1,161,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,162,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",141,1,163,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",141,1,164,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,165,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",141,1,166,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",141,1,167,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",141,1,168,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",141,1,169,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",141,1,170,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,171,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,172,0)="  6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",141,1,173,0)="      and select the package 'LR*5.2*313'."
^DIC(9.4,14,22,5.9,"PAH",141,1,174,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,175,0)="      When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//"
^DIC(9.4,14,22,5.9,"PAH",141,1,176,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",141,1,177,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,178,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",141,1,179,0)="      Protocols?  YES//', choose 'NO' unless site has additional local"
^DIC(9.4,14,22,5.9,"PAH",141,1,180,0)="      laboratory verifying options that should be disabled during install."
^DIC(9.4,14,22,5.9,"PAH",141,1,181,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,182,0)="      The install will automatically disable the following options:"
^DIC(9.4,14,22,5.9,"PAH",141,1,183,0)="      Accession order then immediately enter data         LR ACC THEN DATA"
^DIC(9.4,14,22,5.9,"PAH",141,1,184,0)="      Batch data entry (chem, hem, tox, etc.)             LRSTUF"
^DIC(9.4,14,22,5.9,"PAH",141,1,185,0)="      Bypass normal data entry                            LRFAST"
^DIC(9.4,14,22,5.9,"PAH",141,1,186,0)="      Enter/verify data (Load list)                       LRVRW2"
^DIC(9.4,14,22,5.9,"PAH",141,1,187,0)="      Enter/verify data (Work list)                       LRVRW"
^DIC(9.4,14,22,5.9,"PAH",141,1,188,0)="      Enter/verify data (auto instrument)                 LRVR"
^DIC(9.4,14,22,5.9,"PAH",141,1,189,0)="      Enter/verify/modify data (manual)                   LRENTER"
^DIC(9.4,14,22,5.9,"PAH",141,1,190,0)="      Fast Bypass Data Entry/Verify                       LRFASTS"
^DIC(9.4,14,22,5.9,"PAH",141,1,191,0)="      Group data review (verified & EM)                   LRGVP"
^DIC(9.4,14,22,5.9,"PAH",141,1,192,0)="      Group verify (EA, EL, EW)                           LRGV"
^DIC(9.4,14,22,5.9,"PAH",141,1,193,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,194,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,195,0)="  7. On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",141,1,196,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,197,0)=" Note: Routine LR313 will be deleted after successful patch installation. "
^DIC(9.4,14,22,5.9,"PAH",141,1,198,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,199,0)=" "
^DIC(9.4,14,22,5.9,"PAH",141,1,200,0)=" "
