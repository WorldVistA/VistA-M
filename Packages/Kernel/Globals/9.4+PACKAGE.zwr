^DIC(9.4,14,22,5.9,"PAH",176,1,132,0)="    LR7O MOVEMENT EVENT  (deleted)"
^DIC(9.4,14,22,5.9,"PAH",176,1,133,0)="    LR7O MOVEMENT EVENT TASK  (deleted)"
^DIC(9.4,14,22,5.9,"PAH",176,1,134,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,136,0)="DATA DICTIONARIES"
^DIC(9.4,14,22,5.9,"PAH",176,1,137,0)="    LABORATORY SITE file (#69.9)"
^DIC(9.4,14,22,5.9,"PAH",176,1,138,0)="        CANCEL ON ADMIT field (#150.3)  (deleted)"
^DIC(9.4,14,22,5.9,"PAH",176,1,139,0)="        CANCEL ON DISCHARGE field (#150.4)  (deleted)"
^DIC(9.4,14,22,5.9,"PAH",176,1,140,0)="        CANCEL ON SPECIALTY TRANSFER field (#150.5)  (deleted)"
^DIC(9.4,14,22,5.9,"PAH",176,1,141,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,142,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,143,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",176,1,144,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",176,1,145,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,146,0)="  The install time for this patch is approximately 6 minutes."
^DIC(9.4,14,22,5.9,"PAH",176,1,147,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",176,1,148,0)="  This patch can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",176,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,150,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,151,0)="                     I  M  P  O  R  T  A  N  T"
^DIC(9.4,14,22,5.9,"PAH",176,1,152,0)="                   ============================="
^DIC(9.4,14,22,5.9,"PAH",176,1,153,0)="                 THIS INSTALLATION MUST BE QUEUED"
^DIC(9.4,14,22,5.9,"PAH",176,1,154,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,155,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,156,0)="  NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",176,1,157,0)="        problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",176,1,158,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,159,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",176,1,160,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",176,1,161,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,162,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,163,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",176,1,164,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",176,1,165,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,166,0)="  2.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",176,1,167,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",176,1,168,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,169,0)="  3.  Use the 'Verify Checksum in Transport Global' option and verify"
^DIC(9.4,14,22,5.9,"PAH",176,1,170,0)="      that all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",176,1,171,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,172,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",176,1,173,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",176,1,174,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",176,1,175,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",176,1,176,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",176,1,177,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,178,0)="  5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",176,1,179,0)="      and select the package 'LR*5.2*343*'"
^DIC(9.4,14,22,5.9,"PAH",176,1,180,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,181,0)="      If prompted ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",176,1,182,0)="      Install?"" choose ""NO"".  Note: Responding ""Yes"" to the prompt for"
^DIC(9.4,14,22,5.9,"PAH",176,1,183,0)="      rebuilding menu trees can significantly increase install time."
^DIC(9.4,14,22,5.9,"PAH",176,1,184,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,185,0)="      If prompted ""Want KIDS to INHIBIT LOGONs during the install?"""
^DIC(9.4,14,22,5.9,"PAH",176,1,186,0)="      choose ""NO""."
^DIC(9.4,14,22,5.9,"PAH",176,1,187,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,188,0)="      If prompted ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",176,1,189,0)="      Protocols? YES//"" choose ""NO"" unless the site has additional local"
^DIC(9.4,14,22,5.9,"PAH",176,1,190,0)="      laboratory options that should be disabled during install."
^DIC(9.4,14,22,5.9,"PAH",176,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,192,0)="  6.  When prompted for the DEVICE, enter ""Q"" to queue the build.  If you"
^DIC(9.4,14,22,5.9,"PAH",176,1,193,0)="      do not queue the installation KIDS will abort the install.  When"
^DIC(9.4,14,22,5.9,"PAH",176,1,194,0)="      you try to restart the install you may encounter an <UNDEF> error"
^DIC(9.4,14,22,5.9,"PAH",176,1,195,0)="      due to a bug in KIDS.  If this happens you will need to use FileMan"
^DIC(9.4,14,22,5.9,"PAH",176,1,196,0)="      to modify the INSTALL file (#9.7) for entry LR*5.2*343 which "
^DIC(9.4,14,22,5.9,"PAH",176,1,197,0)="      currently has the status of ""Start of Install"" and set its' STATUS "
^DIC(9.4,14,22,5.9,"PAH",176,1,198,0)="      field to ""Install Completed"".  Reload the transport global and "
^DIC(9.4,14,22,5.9,"PAH",176,1,199,0)="      install the patch again. "
^DIC(9.4,14,22,5.9,"PAH",176,1,200,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,201,0)="  7.  Check your system for errors which may have occurred during the "
^DIC(9.4,14,22,5.9,"PAH",176,1,202,0)="      time this patch was installed.  If the PROTOCOL DGPM MOVEMENT "
^DIC(9.4,14,22,5.9,"PAH",176,1,203,0)="      EVENTS was called during this patch installation, system errors "
^DIC(9.4,14,22,5.9,"PAH",176,1,204,0)="      (such as ""Can't return to source"" for routine LR7OEVNT) may have "
^DIC(9.4,14,22,5.9,"PAH",176,1,205,0)="      been generated.  If so, those patient movements will have to be re-"
^DIC(9.4,14,22,5.9,"PAH",176,1,206,0)="      created. "
^DIC(9.4,14,22,5.9,"PAH",176,1,207,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,208,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,209,0)="INSTALLATION EXAMPLE"
^DIC(9.4,14,22,5.9,"PAH",176,1,210,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",176,1,211,0)=" "
