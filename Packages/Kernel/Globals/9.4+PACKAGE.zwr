^DIC(9.4,164,22,1,"PAH",169,1,272,0)="          IV DISPENSE DRUG (IEN)"
^DIC(9.4,164,22,1,"PAH",169,1,273,0)="             IV SOLUTION (IEN)"
^DIC(9.4,164,22,1,"PAH",169,1,274,0)="    -------------------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",169,1,275,0)="    DEXTROSE (196)"
^DIC(9.4,164,22,1,"PAH",169,1,276,0)="       Solution Volume: 1000 ML"
^DIC(9.4,164,22,1,"PAH",169,1,277,0)="          DEXTROSE 10% IN WATER (620)"
^DIC(9.4,164,22,1,"PAH",169,1,278,0)="             DEXTROSE 10%  (7)"
^DIC(9.4,164,22,1,"PAH",169,1,279,0)="          DEXTROSE 5% IN 0.45% NS (623)"
^DIC(9.4,164,22,1,"PAH",169,1,280,0)="             DEXTROSE 5% 1/2 NS (10)"
^DIC(9.4,164,22,1,"PAH",169,1,281,0)="          DEXTROSE 5% 1000ML INJ (627)"
^DIC(9.4,164,22,1,"PAH",169,1,282,0)="         5% DEXTROSE (1)"
^DIC(9.4,164,22,1,"PAH",169,1,283,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,284,0)="15. IV Solution Post-Install Automatic Clean-up (Post-install routine)"
^DIC(9.4,164,22,1,"PAH",169,1,285,0)="    IV Solutions that are no longer used, meaning that either the IV"
^DIC(9.4,164,22,1,"PAH",169,1,286,0)="    Solution and/or the Dispense Drug and/or the Orderable Item are marked"
^DIC(9.4,164,22,1,"PAH",169,1,287,0)="    INACTIVE will have the field USED IN IV FLUID ORDER ENTRY set to 'NO'."
^DIC(9.4,164,22,1,"PAH",169,1,288,0)="    A list of such IV Solutions will be sent to all users holding the"
^DIC(9.4,164,22,1,"PAH",169,1,289,0)="    following security keys: PSIVMGR, PSIJ MGR, PSNMGR. The message will"
^DIC(9.4,164,22,1,"PAH",169,1,290,0)="    contain a list of all IV Solutions that have been automatically updated"
^DIC(9.4,164,22,1,"PAH",169,1,291,0)="    as seen in the sample message below:"
^DIC(9.4,164,22,1,"PAH",169,1,292,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,293,0)="    Subj: Auto-update of the IV Solution file  [#216328] 08/18/15@09:58 "
^DIC(9.4,164,22,1,"PAH",169,1,294,0)="    From: PATCH PSS*1*189  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,164,22,1,"PAH",169,1,295,0)="    -------------------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",169,1,296,0)="    The list below shows IV Solutions in your database that had the field"
^DIC(9.4,164,22,1,"PAH",169,1,297,0)="    USED IN IV FLUID ORDER ENTRY set to 'NO' because either the Orderable"
^DIC(9.4,164,22,1,"PAH",169,1,298,0)="    Item, the Dispense Drug or the IV Solution itself was marked INACTIVE."
^DIC(9.4,164,22,1,"PAH",169,1,299,0)="    "
^DIC(9.4,164,22,1,"PAH",169,1,300,0)="    Run Date/Time: Aug 18, 2015@09:58:38"
^DIC(9.4,164,22,1,"PAH",169,1,301,0)="    -------------------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",169,1,302,0)="    ORDERABLE ITEM (IEN)"
^DIC(9.4,164,22,1,"PAH",169,1,303,0)="       IV DISPENSE DRUG (IEN)"
^DIC(9.4,164,22,1,"PAH",169,1,304,0)="          IV SOLUTION (IEN/VOLUME)"
^DIC(9.4,164,22,1,"PAH",169,1,305,0)="    -------------------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",169,1,306,0)="    CEFAZOLIN (106)"
^DIC(9.4,164,22,1,"PAH",169,1,307,0)="       CEFAZOLIN SOD 1GM INJ (1498)"
^DIC(9.4,164,22,1,"PAH",169,1,308,0)="          20% DEXTROSE (2/500 ML)   *** INACTIVE DATE: JAN 11, 1994 ***"
^DIC(9.4,164,22,1,"PAH",169,1,309,0)="          20% DEXTROSE (11/500 ML)   *** INACTIVE DATE: JAN 11, 1994 ***"
^DIC(9.4,164,22,1,"PAH",169,1,310,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,311,0)="16. New API for CPRS: $$MAXDS^PSSUTIL1"
^DIC(9.4,164,22,1,"PAH",169,1,312,0)="    This new API was created for CPRS to retrieve the Maximum Days Supply"
^DIC(9.4,164,22,1,"PAH",169,1,313,0)="    value for a specific medication. This API is available to CPRS through"
^DIC(9.4,164,22,1,"PAH",169,1,314,0)="    the Integration Control Registration (ICR) #3239. Below is a detailed "
^DIC(9.4,164,22,1,"PAH",169,1,315,0)="    description of the API."
^DIC(9.4,164,22,1,"PAH",169,1,316,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,317,0)="       $$MAXDS^PSSUTIL1(INPUT)"
^DIC(9.4,164,22,1,"PAH",169,1,318,0)="       This API accepts an array containing the Pharmacy Orderable Item"
^DIC(9.4,164,22,1,"PAH",169,1,319,0)="       (required) and Dispense Drug (optional) and returns the maximum number"
^DIC(9.4,164,22,1,"PAH",169,1,320,0)="       of Days Supply allowed to be dispensed for the specific medication."
^DIC(9.4,164,22,1,"PAH",169,1,321,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,322,0)="       Parameters:"
^DIC(9.4,164,22,1,"PAH",169,1,323,0)="       Input:  INPUT(""PSOI"") (Required)"
^DIC(9.4,164,22,1,"PAH",169,1,324,0)="               Pointer to the PHARMACY ORDERABLE ITEM file (#50.7). "
^DIC(9.4,164,22,1,"PAH",169,1,325,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,326,0)="               INPUT(""DRUG"") (Optional)"
^DIC(9.4,164,22,1,"PAH",169,1,327,0)="               Pointer to the DRUG file (#50). This parameter is optional."
^DIC(9.4,164,22,1,"PAH",169,1,328,0)="               If not passed, the API will return the highest value from all"
^DIC(9.4,164,22,1,"PAH",169,1,329,0)="               the dispense drugs linked to the Pharmacy Orderable Item.      "
^DIC(9.4,164,22,1,"PAH",169,1,330,0)="    "
^DIC(9.4,164,22,1,"PAH",169,1,331,0)="       Output $$MAXDS"
^DIC(9.4,164,22,1,"PAH",169,1,332,0)="              Maximum number of days supply that can be dispensed for the"
^DIC(9.4,164,22,1,"PAH",169,1,333,0)="              orderable item and/or dispense drug."
^DIC(9.4,164,22,1,"PAH",169,1,334,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,335,0)="17. IV Additives and Solutions - Display ""INACTIVATION DATE"""
^DIC(9.4,164,22,1,"PAH",169,1,336,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,337,0)="     The INACTIVATION DATE will display whenever a VistA lookup is done on"
^DIC(9.4,164,22,1,"PAH",169,1,338,0)="     IV Additives and Solutions."
^DIC(9.4,164,22,1,"PAH",169,1,339,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,340,0)="     This was accomplished by making the following two fields identifiers:"
^DIC(9.4,164,22,1,"PAH",169,1,341,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,342,0)="     FIELD NAME           FIELD NUMBER     FILE NAME/NUMBER"
^DIC(9.4,164,22,1,"PAH",169,1,343,0)="     ----------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",169,1,344,0)="     INACTIVATION DATE         12          IV ADDITIVES (#52.6)"
^DIC(9.4,164,22,1,"PAH",169,1,345,0)="     INACTIVATION DATE          8          IV SOLUTIONS (#52.7)"
^DIC(9.4,164,22,1,"PAH",169,1,346,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,347,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,348,0)="     Note: The following 'HELP'-PROMPT text will display for fields 8 & 12"
^DIC(9.4,164,22,1,"PAH",169,1,349,0)="           ""Enter the date this drug was inactivated."
^DIC(9.4,164,22,1,"PAH",169,1,350,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,351,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,352,0)=" "
^DIC(9.4,164,22,1,"PAH",169,1,353,0)="       ********************* EXAMPLE(1) ADDITIVES *********************"
^DIC(9.4,164,22,1,"PAH",169,1,354,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,355,0)=" Inpatient Drug Management - Additives File [PSSJI DRUG] "
^DIC(9.4,164,22,1,"PAH",169,1,356,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,357,0)=" Select Inpatient Drug Management Option: Additives File"
^DIC(9.4,164,22,1,"PAH",169,1,358,0)=" Select IV ADDITIVES PRINT NAME: PIPERACILLIN"
^DIC(9.4,164,22,1,"PAH",169,1,359,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,360,0)=" Lookup: IV ADDITIVES  PRINT NAME"
^DIC(9.4,164,22,1,"PAH",169,1,361,0)="  1   PIPERACILLIN/TAZOBACTAM              Additive Strength: 3.375 GM"
^DIC(9.4,164,22,1,"PAH",169,1,362,0)="  2   PIPERACILLIN/TAZOBACTAM              Additive Strength: 2.25 GM "
^DIC(9.4,164,22,1,"PAH",169,1,363,0)="  3   PIPERACILLIN/TAZOBACTAM   03-5-2015  Additive Strength: 4.5 GM "
^DIC(9.4,164,22,1,"PAH",169,1,364,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,365,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,366,0)="      ********************* EXAMPLE(2) SOLUTIONS *********************"
^DIC(9.4,164,22,1,"PAH",169,1,367,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,368,0)=" Inpatient Drug Management - Primary Solution File (IV)"
^DIC(9.4,164,22,1,"PAH",169,1,369,0)="  "
^DIC(9.4,164,22,1,"PAH",169,1,370,0)=" Select Inpatient Drug Management Option: PRImary Solution File(IV) "
^DIC(9.4,164,22,1,"PAH",169,1,371,0)=" Select IV SOLUTIONS PRINT NAME: DEXTROSE 5% / NACL"
^DIC(9.4,164,22,1,"PAH",169,1,372,0)="   Lookup: PRINT NAME"
^DIC(9.4,164,22,1,"PAH",169,1,373,0)="      1   DEXTROSE 5% / NACL 0.2%       1000 ML                "
^DIC(9.4,164,22,1,"PAH",169,1,374,0)="      2   DEXTROSE 5% / NACL 0.33%      1000 ML                "
^DIC(9.4,164,22,1,"PAH",169,1,375,0)="      3   DEXTROSE 5% / NACL 0.45%      1000 ML   12-03-15     "
^DIC(9.4,164,22,1,"PAH",169,1,376,0)="      4   DEXTROSE 5% / NACL 0.9%       1000 ML    "
^DIC(9.4,164,22,1,"PAH",169,1,377,0)="                "
^DIC(9.4,164,22,1,"PAH",169,1,378,0)="       ********************* END EXAMPLES ********************* "
^DIC(9.4,164,22,1,"PAH",170,0)="194 SEQ #171^3160713.125811^54"
^DIC(9.4,164,22,1,"PAH",170,1,0)="^^11^11^3160713"
^DIC(9.4,164,22,1,"PAH",170,1,1,0)="This patch addresses three (3) issues:"
^DIC(9.4,164,22,1,"PAH",170,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",170,1,3,0)="1. Users may not be aware that changing a drug's strength does not change"
^DIC(9.4,164,22,1,"PAH",170,1,4,0)="   the concentration."
^DIC(9.4,164,22,1,"PAH",170,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",170,1,6,0)="2. The FileMan Description on the SYNONYM (#.01) field of the SYNONYM "
^DIC(9.4,164,22,1,"PAH",170,1,7,0)="   SUB-FIELD (#50.1) file for the DRUG (#50) file does not match the"
^DIC(9.4,164,22,1,"PAH",170,1,8,0)="   Input Transform."
^DIC(9.4,164,22,1,"PAH",170,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",170,1,10,0)="3. Incorrect cross references may remain, and errors may occur during"
^DIC(9.4,164,22,1,"PAH",170,1,11,0)="   execution of the PSS EDIT TEXT option."
^DIC(9.4,164,22,1,"PAH",171,0)="192^3160829.125629^54"
^DIC(9.4,164,22,1,"PAH",171,1,0)="^^1^1^3160829"
^DIC(9.4,164,22,1,"PAH",171,1,1,0)="MCCF ePharmacy Compliance Phase 3"
^DIC(9.4,164,22,1,"PAH",172,0)="184 SEQ #173^3160916.134156^54"
^DIC(9.4,164,22,1,"PAH",172,1,0)="^^14^14^3160916"
^DIC(9.4,164,22,1,"PAH",172,1,1,0)="This patch will correct the following reported issues:"
^DIC(9.4,164,22,1,"PAH",172,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",172,1,3,0)="1) An error occurs during the drug renewal process if the drug has a "
^DIC(9.4,164,22,1,"PAH",172,1,4,0)="   lengthy drug-drug interaction check."
^DIC(9.4,164,22,1,"PAH",172,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",172,1,6,0)="2) An error may occur in the option PSS SCHEDULE EDIT if the user jumps "
^DIC(9.4,164,22,1,"PAH",172,1,7,0)="   ahead to various fields."
^DIC(9.4,164,22,1,"PAH",172,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",172,1,9,0)="3) Numerous background tasks might be tasked if the scheduling frequency "
^DIC(9.4,164,22,1,"PAH",172,1,10,0)="   in option PSS SCHEDULE PEPS INTERFACE CK is set to a low value,"
^DIC(9.4,164,22,1,"PAH",172,1,11,0)="   resulting in system issues."
^DIC(9.4,164,22,1,"PAH",172,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",172,1,13,0)="4) Drug-Drug Interaction Order Check cannot be validated when performing "
^DIC(9.4,164,22,1,"PAH",172,1,14,0)="   option PSS CHECK PEPS SERVICES SETUP."
^DIC(9.4,164,22,1,"PAH",173,0)="193 SEQ #174^3161006.130207^54"
^DIC(9.4,164,22,1,"PAH",173,1,0)="^^35^35^3161006"
^DIC(9.4,164,22,1,"PAH",173,1,1,0)="The Pharmacy Interface Automation Project will provide a new standard"
^DIC(9.4,164,22,1,"PAH",173,1,2,0)="bi-directional HL7 interface to the Pharmacy Automated Dispensing"
^DIC(9.4,164,22,1,"PAH",173,1,3,0)="Equipment (PADE) located at the point of care areas such as Inpatient"
^DIC(9.4,164,22,1,"PAH",173,1,4,0)="wards, Outpatient Clinics etc. The outbound HL7 messages will be triggered"
^DIC(9.4,164,22,1,"PAH",173,1,5,0)="when drugs are added or modified depending on the site parameter setup."
^DIC(9.4,164,22,1,"PAH",173,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,7,0)="The following two patches are provided for this project:"
^DIC(9.4,164,22,1,"PAH",173,1,8,0)="  PSJ*5*317 - Inpatient Medications V. 5.0."
^DIC(9.4,164,22,1,"PAH",173,1,9,0)="  PSS*1*193 - Pharmacy Data Management V. 1.0."
^DIC(9.4,164,22,1,"PAH",173,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,11,0)="Note: The patches should be installed in the order listed above as the "
^DIC(9.4,164,22,1,"PAH",173,1,12,0)="logical link, PSJ PADE used in the PSS patch is transported in the PSJ"
^DIC(9.4,164,22,1,"PAH",173,1,13,0)="patch."
^DIC(9.4,164,22,1,"PAH",173,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,15,0)="As part of this patch PSS*1*193, the following enhancements were made:"
^DIC(9.4,164,22,1,"PAH",173,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,17,0)="1. Two new protocols PSS MFNM01 CLIENT and PSS MFNM01 SERVER were added to"
^DIC(9.4,164,22,1,"PAH",173,1,18,0)="facilitate sending MFN HL7 drug messages to PADE."
^DIC(9.4,164,22,1,"PAH",173,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,20,0)="2. The Send Entire Drug File to External Interface [PSS MASTER FILE "
^DIC(9.4,164,22,1,"PAH",173,1,21,0)="ALL]  option was modified to allow transmission of the drug file to an "
^DIC(9.4,164,22,1,"PAH",173,1,22,0)="Inpatient Interface (PADE) depending on the PADE setup. It also "
^DIC(9.4,164,22,1,"PAH",173,1,23,0)="provides the flexibility of sending all drugs marked for Unit Dose, "
^DIC(9.4,164,22,1,"PAH",173,1,24,0)="Intravenous (IV) or Ward Stock or send selected drugs to PADE."
^DIC(9.4,164,22,1,"PAH",173,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,26,0)="Since this option now allows to send all or selected drugs to PADE, the"
^DIC(9.4,164,22,1,"PAH",173,1,27,0)="option name ""Send Entire Drug File to External Interface"" was changed  "
^DIC(9.4,164,22,1,"PAH",173,1,28,0)="to ""Send Drug File Entries to External Interface"""
^DIC(9.4,164,22,1,"PAH",173,1,29,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,30,0)="3. A new PSS PADE INIT security key was added so that holders of this key "
^DIC(9.4,164,22,1,"PAH",173,1,31,0)="can only send ""all"" drugs to PADE noted in item 2."
^DIC(9.4,164,22,1,"PAH",173,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",173,1,33,0)="4. Option Drug Enter/Edit [PSS DRUG ENTER/EDIT] was modified to send an "
^DIC(9.4,164,22,1,"PAH",173,1,34,0)="addition/update/both or none to PADE provided it is setup to receive such"
^DIC(9.4,164,22,1,"PAH",173,1,35,0)="updates."
^DIC(9.4,164,22,1,"PAH",174,0)="199 SEQ #175^3161212.121049^54"
^DIC(9.4,164,22,1,"PAH",174,1,0)="^^13^13^3161212"
^DIC(9.4,164,22,1,"PAH",174,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,164,22,1,"PAH",174,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",174,1,3,0)="1) The API DRGIEN^PSS50P7 that returns the Dispense Drugs in the DRUG "
^DIC(9.4,164,22,1,"PAH",174,1,4,0)="   file (#50) matched to a PHARMACY ORDERABLE ITEM file (#50.7) is not "
^DIC(9.4,164,22,1,"PAH",174,1,5,0)="   returning all matches if a Dispense Drug happens to have the same "
^DIC(9.4,164,22,1,"PAH",174,1,6,0)="   internal entry number in the DRUG (#50) file as the PHARMACY ORDERABLE "
^DIC(9.4,164,22,1,"PAH",174,1,7,0)="   ITEM (#50.7) file entry it points to.  "
^DIC(9.4,164,22,1,"PAH",174,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",174,1,9,0)="2) Lines may scroll off the screen when checking drug interactions.  The "
^DIC(9.4,164,22,1,"PAH",174,1,10,0)="   user may not be aware that not all lines are displaying on the screen."
^DIC(9.4,164,22,1,"PAH",174,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",174,1,12,0)="3) Outpatient Pharmacy CK Action not working after Check Drug "
^DIC(9.4,164,22,1,"PAH",174,1,13,0)="   Interactions option is invoked if user enters ""^"" to exit out."
^DIC(9.4,164,22,1,"PAH",175,0)="200^3161220.152135^54"
^DIC(9.4,164,22,1,"PAH",176,0)="207 SEQ #177^3170123.141652^54"
^DIC(9.4,164,22,1,"PAH",177,0)="197^3170123.14263^54"
^DIC(9.4,164,22,1,"PAH",178,0)="198 SEQ #179^3170504.173552^54"
^DIC(9.4,164,22,1,"PAH",178,1,0)="^^14^14^3170504"
^DIC(9.4,164,22,1,"PAH",178,1,1,0)="This patch addresses the following three (3) issues:"
^DIC(9.4,164,22,1,"PAH",178,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",178,1,3,0)="(1) Patch PSS*1*127 incorrectly populated the NCPDP DISPENSE UNIT (#82) "
^DIC(9.4,164,22,1,"PAH",178,1,4,0)="    field of the DRUG (#50) file entry matched to VA PRODUCT (#50.68) "
^DIC(9.4,164,22,1,"PAH",178,1,5,0)="    file entry ""MEMANTINE HCL 5MG/10MG TAB TITRATION PAK,49"" (internal"
^DIC(9.4,164,22,1,"PAH",178,1,6,0)="    entry number 16512) as ""RA"" instead of ""EA""."
^DIC(9.4,164,22,1,"PAH",178,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",178,1,8,0)="(2) When invoking the PSS MAINTAIN ORDERABLE ITEMS option, several "
^DIC(9.4,164,22,1,"PAH",178,1,9,0)="    issues may occur involving the ""INACTIVE DATE"" prompt."
^DIC(9.4,164,22,1,"PAH",178,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",178,1,11,0)="(3) The FIRST DATABANK UNIT (#1) field of the DOSE UNITS (#51.24) file "
^DIC(9.4,164,22,1,"PAH",178,1,12,0)="    for ""APPLICATORFUL(S)"" should be ""APPLICATORFUL"" instead of "
^DIC(9.4,164,22,1,"PAH",178,1,13,0)="    ""APPLICATORFUL/S"", and for ""SUPPOSITOR(IES)"", it should be"
^DIC(9.4,164,22,1,"PAH",178,1,14,0)="    ""SUPPOSITORY"" instead of ""SUPPOSITORY/IES""."
^DIC(9.4,164,22,1,"PAH",179,0)="201 SEQ #180^3170601.162621^54"
^DIC(9.4,164,22,1,"PAH",179,1,0)="^^1^1^3170601"
^DIC(9.4,164,22,1,"PAH",179,1,1,0)="MOCHA 2.1 Dosing Enhancements."
^DIC(9.4,164,22,1,"PAH",180,0)="195 SEQ #181^3170830.150149^54"
^DIC(9.4,164,22,1,"PAH",181,0)="208 SEQ #182^3171128.124445^54"
^DIC(9.4,164,22,1,"PAH",181,1,0)="^^21^21^3171128"
^DIC(9.4,164,22,1,"PAH",181,1,1,0)="This patch addresses three (3) issues:"
^DIC(9.4,164,22,1,"PAH",181,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",181,1,3,0)="1. When using Drug Enter/Edit [PSS DRUG ENTER/EDIT] Option for a drug"
^DIC(9.4,164,22,1,"PAH",181,1,4,0)="   that has been unmatched from the NDF, the NATIONAL FORUMULARY"
^DIC(9.4,164,22,1,"PAH",181,1,5,0)="   INDICATOR field on the screen displays 'YES"" instead of 'NOT"
^DIC(9.4,164,22,1,"PAH",181,1,6,0)="   Matched to NDF'."
^DIC(9.4,164,22,1,"PAH",181,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",181,1,8,0)="2. The Data Dictionary for the DRUG File (#50) PRICE PER DISPENSE UNIT "
^DIC(9.4,164,22,1,"PAH",181,1,9,0)="   Field (#16) is incorrect.  The Prompt Message displays ""Type a Number "
^DIC(9.4,164,22,1,"PAH",181,1,10,0)="   between 0 and 222, 4 decimal digits"".  This does not accurately   "
^DIC(9.4,164,22,1,"PAH",181,1,11,0)="   reflect the data stored in this field.  There are many drug items"
^DIC(9.4,164,22,1,"PAH",181,1,12,0)="   on the market with a Price Per Dispense Unit greater than $222."
^DIC(9.4,164,22,1,"PAH",181,1,13,0)="   "
^DIC(9.4,164,22,1,"PAH",181,1,14,0)="   The Data Dictionary needs to be updated to more accurately reflect"
^DIC(9.4,164,22,1,"PAH",181,1,15,0)="   the content of the field. "
^DIC(9.4,164,22,1,"PAH",181,1,16,0)="  "
^DIC(9.4,164,22,1,"PAH",181,1,17,0)="3. There is an issue with the PRINT NAME Field (#.01) in the IV ADDITIVE "
^DIC(9.4,164,22,1,"PAH",181,1,18,0)="   File (#52.6) when it contains a tilde (~).  When an IV label is "
^DIC(9.4,164,22,1,"PAH",181,1,19,0)="   printed for an additive that has a print name that contains a tilde, "
^DIC(9.4,164,22,1,"PAH",181,1,20,0)="   it may not display the amount of the IV additive.  When the tilde is"
^DIC(9.4,164,22,1,"PAH",181,1,21,0)="   removed, the IV additive amount will print."
^DIC(9.4,164,22,1,"PAH",182,0)="213 SEQ #183^3171201.124345^54"
^DIC(9.4,164,22,1,"PAH",183,0)="212 SEQ #184^3180130.153541^54"
^DIC(9.4,164,22,1,"PAH",184,0)="209 SEQ #185^3180228.171645^54"
^DIC(9.4,164,22,1,"PAH",184,1,0)="^^6^6^3180228"
^DIC(9.4,164,22,1,"PAH",184,1,1,0)=" "
^DIC(9.4,164,22,1,"PAH",184,1,2,0)="This patch addresses one issue:"
^DIC(9.4,164,22,1,"PAH",184,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",184,1,4,0)="1.  New BUPRENORPHINE Dosage Form (FILM,BUCCAL) has been approved"
^DIC(9.4,164,22,1,"PAH",184,1,5,0)="    for the treatment of chronic pain and necessitates an update"
^DIC(9.4,164,22,1,"PAH",184,1,6,0)="    in the Detox API"
^DIC(9.4,164,22,1,"PAH",185,0)="178^3180302.140429^54"
^DIC(9.4,164,22,1,"PAH",185,1,0)="^^1^1^3180302"
^DIC(9.4,164,22,1,"PAH",185,1,1,0)="MOCHA 2.1 Dosing Enhancements."
^DIC(9.4,164,22,1,"PAH",186,0)="206^3180302.140921^54"
^DIC(9.4,164,22,1,"PAH",186,1,0)="^^1^1^3180302"
^DIC(9.4,164,22,1,"PAH",186,1,1,0)="MOCHA 2.1b Follow Up patch."
^DIC(9.4,164,22,1,"PAH",187,0)="204 SEQ #188^3180403.154905^54"
^DIC(9.4,164,22,1,"PAH",187,1,0)="^^5^5^3180403"
^DIC(9.4,164,22,1,"PAH",187,1,1,0)="This build has been created to provide a Packman message-type patch for "
^DIC(9.4,164,22,1,"PAH",187,1,2,0)="Indications for Use for Prescriptions and Medication Orders. This will "
^DIC(9.4,164,22,1,"PAH",187,1,3,0)="give the user the ability to enter most common indications and/or"
^DIC(9.4,164,22,1,"PAH",187,1,4,0)="additional indications for the medications in the Pharmacy Orderable Items"
^DIC(9.4,164,22,1,"PAH",187,1,5,0)="file (#50.7)."
^DIC(9.4,164,22,1,"PAH",188,0)="211 SEQ #189^3180403.172536^54"
^DIC(9.4,164,22,1,"PAH",188,1,0)="^^5^5^3180403"
^DIC(9.4,164,22,1,"PAH",188,1,1,0)="This patch implements Medications Dosage Form domain changes required by "
^DIC(9.4,164,22,1,"PAH",188,1,2,0)="the Collaborative Terminology Tooling & Data Management (CTT & DM) Native"
^DIC(9.4,164,22,1,"PAH",188,1,3,0)="Standardization (NDS) project."
^DIC(9.4,164,22,1,"PAH",188,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",188,1,5,0)="Please see FORUM for full patch description and installation instructions."
^DIC(9.4,164,22,1,"PAH",189,0)="217 SEQ #190^3180424.161529^54"
^DIC(9.4,164,22,1,"PAH",190,0)="210 SEQ #191^3180501.142126^54"
^DIC(9.4,164,22,1,"PAH",190,1,0)="^^8^8^3180501"
^DIC(9.4,164,22,1,"PAH",190,1,1,0)="1.  Free text is accepted in the NAME field (#.01) of the "
^DIC(9.4,164,22,1,"PAH",190,1,2,0)="    ADMINISTRATION SCHEDULE file (#51.1) when the TYPE OF"
^DIC(9.4,164,22,1,"PAH",190,1,3,0)="    SCHEDULE field (#5) is set to D (Day of the Week)."
^DIC(9.4,164,22,1,"PAH",190,1,4,0)="               "
^DIC(9.4,164,22,1,"PAH",190,1,5,0)="2.  Changes made to the NAME field (#.01) of the "
^DIC(9.4,164,22,1,"PAH",190,1,6,0)="    PHARMACY ORDERABLE ITEMS file (#50.7) via the Drug "
^DIC(9.4,164,22,1,"PAH",190,1,7,0)="    Enter/Edit [PSS DRUG ENTER/EDIT] option are not  "
^DIC(9.4,164,22,1,"PAH",190,1,8,0)="    always reflected in the ORDERABLE ITEMS file (#101.43)."
^DIC(9.4,164,22,1,"PAH",191,0)="203 SEQ #192^3180601.150838^54"
^DIC(9.4,164,22,1,"PAH",191,1,0)="^^1^1^3180601"
^DIC(9.4,164,22,1,"PAH",191,1,1,0)="EPIP PSS REMEDIATION 1.0"
^DIC(9.4,164,22,1,"PAH",192,0)="224^3180706.154247^54"
^DIC(9.4,164,22,1,"PAH",192,1,0)="^^1^1^3180706"
^DIC(9.4,164,22,1,"PAH",192,1,1,0)="Warranty issue repairs for MOCHA 2.1B."
^DIC(9.4,164,22,1,"PAH",193,0)="219 SEQ #194^3180904.153329^54"
^DIC(9.4,164,22,1,"PAH",193,1,0)="^^1^1^3180904"
^DIC(9.4,164,22,1,"PAH",193,1,1,0)="Updates to dosage forms for Buprenorphine containing products."
^DIC(9.4,164,22,1,"PAH",194,0)="227 SEQ #195^3180907.131303^54"
^DIC(9.4,164,22,1,"PAH",194,1,0)="^^1^1^3180907"
^DIC(9.4,164,22,1,"PAH",194,1,1,0)="PSS*1.0*227"
^DIC(9.4,164,22,1,"PAH",195,0)="229 SEQ #196^3181004.145108^54"
^DIC(9.4,164,22,1,"PAH",195,1,0)="^^28^28^3181004"
^DIC(9.4,164,22,1,"PAH",195,1,1,0)="Issues:"
^DIC(9.4,164,22,1,"PAH",195,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,3,0)="1. When invoking option PSSJI DRUG:"
^DIC(9.4,164,22,1,"PAH",195,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,5,0)="   a) An error occurs if an additive is defined to have ""UNIT DOSE "
^DIC(9.4,164,22,1,"PAH",195,1,6,0)="      MEDICATIONS"" usage defined as ""quick order only""."
^DIC(9.4,164,22,1,"PAH",195,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,8,0)="   b) Quick order restrictions are removed if ""IV MEDICATIONS"" and/or "
^DIC(9.4,164,22,1,"PAH",195,1,9,0)="      ""IV ADDITIVES"" usages are defined as ""quick order only."
^DIC(9.4,164,22,1,"PAH",195,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,11,0)="2. When invoking option PSSJI SOLN:"
^DIC(9.4,164,22,1,"PAH",195,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,13,0)="   a) An error occurs if a solution is defined to have 'UNIT DOSE "
^DIC(9.4,164,22,1,"PAH",195,1,14,0)="      MEDICATIONS"" usage defined as ""quick order only""."
^DIC(9.4,164,22,1,"PAH",195,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,16,0)="   b) Quick order restrictions are removed if ""IV MEDICATIONS"" and/or "
^DIC(9.4,164,22,1,"PAH",195,1,17,0)="      ""IV SOLUTIONS"" usages are defined as ""quick order only""."
^DIC(9.4,164,22,1,"PAH",195,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,19,0)="Resolution:"
^DIC(9.4,164,22,1,"PAH",195,1,20,0)="----------"
^DIC(9.4,164,22,1,"PAH",195,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,22,0)="Modified routines PSSVIDRG and ORMFN to preserve quick order settings on "
^DIC(9.4,164,22,1,"PAH",195,1,23,0)="additives and solutions.  These changes also prevented the error which "
^DIC(9.4,164,22,1,"PAH",195,1,24,0)="occurred when a solution or additive was defined to have unit doses as "
^DIC(9.4,164,22,1,"PAH",195,1,25,0)="""quick order only""."
^DIC(9.4,164,22,1,"PAH",195,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",195,1,27,0)="Routine ORMFN is included in patch OR*3.0*487U which will be installed "
^DIC(9.4,164,22,1,"PAH",195,1,28,0)="along with routine PSSVIDRG in this patch."
^DIC(9.4,164,22,1,"PAH",196,0)="218 SEQ #197^3181102.152901^54"
^DIC(9.4,164,22,1,"PAH",196,1,0)="^^21^21^3181102"
^DIC(9.4,164,22,1,"PAH",196,1,1,0)="This patch has the following enhancements for Clinical Ancillary Services"
^DIC(9.4,164,22,1,"PAH",196,1,2,0)="(CAS) Enhancements (RXSU2)."
^DIC(9.4,164,22,1,"PAH",196,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",196,1,4,0)="1. Update DEA SPECIAL HANDLING Field Documentation"
^DIC(9.4,164,22,1,"PAH",196,1,5,0)="   "
^DIC(9.4,164,22,1,"PAH",196,1,6,0)="   A new code letter ""K"" was added to for the DEA, SPECIAL HDLG (#3) in "
^DIC(9.4,164,22,1,"PAH",196,1,7,0)="   the DRUG file (#50) to document in VistA when providers renew"
^DIC(9.4,164,22,1,"PAH",196,1,8,0)="   medications for patients that cannot be automatically renewed by the"
^DIC(9.4,164,22,1,"PAH",196,1,9,0)="   patient via Audiocare."
^DIC(9.4,164,22,1,"PAH",196,1,10,0)="     "
^DIC(9.4,164,22,1,"PAH",196,1,11,0)="   Help text added for this field during PSS DRUG ENTER/EDIT option:"
^DIC(9.4,164,22,1,"PAH",196,1,12,0)="   "
^DIC(9.4,164,22,1,"PAH",196,1,13,0)="         ""K      Not Renewable (by telephone)"
^DIC(9.4,164,22,1,"PAH",196,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",196,1,15,0)="2. Manage Lookup List Inactive Entries"
^DIC(9.4,164,22,1,"PAH",196,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",196,1,17,0)="   The following files have added a new field identifier to their data "
^DIC(9.4,164,22,1,"PAH",196,1,18,0)="   dictionaries to indicate if they are marked as Inactive entries."
^DIC(9.4,164,22,1,"PAH",196,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",196,1,20,0)="    a. ADMINISTRATION SCHEDULE file (#51.1) the INACTIVE field (#12)."
^DIC(9.4,164,22,1,"PAH",196,1,21,0)="    b. DRUG TEXT file (#51.7) the INACTIVATION DATE field (#2)."
^DIC(9.4,164,22,1,"PAH",197,0)="220 SEQ #198^3181206.160409^54"
^DIC(9.4,164,22,1,"PAH",197,1,0)="^^4^4^3181206"
^DIC(9.4,164,22,1,"PAH",197,1,1,0)="1) Errors when using the PSS LOOK option in VistA"
^DIC(9.4,164,22,1,"PAH",197,1,2,0)="2) Hard error within PSS DRUG ENTER/EDIT option for Lab Monitoring"
^DIC(9.4,164,22,1,"PAH",197,1,3,0)="3) Duplicate prompt to create a new Orderable Item when entering a new "
^DIC(9.4,164,22,1,"PAH",197,1,4,0)="   Drug File entry"
^DIC(9.4,164,22,1,"PAH",198,0)="215^3181206.161704^54"
^DIC(9.4,164,22,1,"PAH",198,1,0)="^^11^11^3181206"
^DIC(9.4,164,22,1,"PAH",198,1,1,0)="Patch PSS*1.0*215 is part of a Multi Build with patch PS0*7.0*452."
^DIC(9.4,164,22,1,"PAH",198,1,2,0)="PSO*7.0*452 contains the routine changes."
^DIC(9.4,164,22,1,"PAH",198,1,3,0)="PSS*1.0*215 contains the DD changes."
^DIC(9.4,164,22,1,"PAH",198,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",198,1,5,0)="The NSRs involved in this build are:"
^DIC(9.4,164,22,1,"PAH",198,1,6,0)="NSR20150311 High Cost Rx Report;  NSR20151109 Pharmacy Print from Suspense"
^DIC(9.4,164,22,1,"PAH",198,1,7,0)="by Category; NSR20150512 Early Warning Advisory for Approaching the "
^DIC(9.4,164,22,1,"PAH",198,1,8,0)="end of Rx Number Ranges; and NSR20151001 Pharmacy Patient Demographics."
^DIC(9.4,164,22,1,"PAH",198,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",198,1,10,0)="This build contains the Data Dictionary changes in support of PSO*7.0*452 "
^DIC(9.4,164,22,1,"PAH",198,1,11,0)="and is a required build for PSO*7.0*452"
^DIC(9.4,164,22,1,"PAH",199,0)="214^3190201.1438^54"
^DIC(9.4,164,22,1,"PAH",199,1,0)="^^1^1^3190201"
^DIC(9.4,164,22,1,"PAH",199,1,1,0)="MCCF EDI TAS EPHARMACY BUILDS 5 & 6"
^DIC(9.4,164,22,1,"PAH",200,0)="225 SEQ #201^3190201.152107^54"
^DIC(9.4,164,22,1,"PAH",200,1,0)="^^8^8^3190201"
^DIC(9.4,164,22,1,"PAH",200,1,1,0)="This patch addresses the request from NSR #20170515 - Adds Respiratory "
^DIC(9.4,164,22,1,"PAH",200,1,2,0)="Therapy Report."
^DIC(9.4,164,22,1,"PAH",200,1,3,0)="This patch distributes one new field, #15, added to file #50.7. The option"
^DIC(9.4,164,22,1,"PAH",200,1,4,0)="Edit Orderable Items [PSS EDIT ORDERABLE ITEMS] is updated by this patch"
^DIC(9.4,164,22,1,"PAH",200,1,5,0)="via its driver routine PSSPOIMO, and is used to mark a drug for use in"
^DIC(9.4,164,22,1,"PAH",200,1,6,0)="respiratory therapy treatment of patients. The drugs prescribed to"
^DIC(9.4,164,22,1,"PAH",200,1,7,0)="patients for respiratory therapy treatment will be displayed in the Report"
^DIC(9.4,164,22,1,"PAH",200,1,8,0)="for Respiratory Therapy Medications."
^DIC(9.4,164,22,1,"PAH",201,0)="231 SEQ #202^3190301.154115^54"
^DIC(9.4,164,22,1,"PAH",201,1,0)="^^8^8^3190301"
^DIC(9.4,164,22,1,"PAH",201,1,1,0)="Subject:  FIX ERRORS CALLING DOSAGE CHECK"
^DIC(9.4,164,22,1,"PAH",201,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",201,1,3,0)="1)  Dosing check fails when values are added and then deleted from field"
^DIC(9.4,164,22,1,"PAH",201,1,4,0)="DRUG(S) FOR DOSING CHK FREQ (#11.1) in the ADMINISTRATION SCHEDULE FILE"
^DIC(9.4,164,22,1,"PAH",201,1,5,0)="(#51.1)"
^DIC(9.4,164,22,1,"PAH",201,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",201,1,7,0)="2)  Dosing check fails when an OLD SCHEDULE NAME(S) is used with a PRN"
^DIC(9.4,164,22,1,"PAH",201,1,8,0)="designation."
^DIC(9.4,164,22,1,"PAH",202,0)="232 SEQ #203^3190401.170834^54"
^DIC(9.4,164,22,1,"PAH",202,1,0)="^^35^35^3190401"
^DIC(9.4,164,22,1,"PAH",202,1,1,0)="This patch will resolve the following issue."
^DIC(9.4,164,22,1,"PAH",202,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",202,1,3,0)="INC2574335 - Our drug file entry will not let me add the labs associated with"
^DIC(9.4,164,22,1,"PAH",202,1,4,0)="             the drug Clozapine that needs labs attached so that drug checks"
^DIC(9.4,164,22,1,"PAH",202,1,5,0)="             can be performed"
^DIC(9.4,164,22,1,"PAH",202,1,6,0)="  "
^DIC(9.4,164,22,1,"PAH",202,1,7,0)="      "
^DIC(9.4,164,22,1,"PAH",202,1,8,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,164,22,1,"PAH",202,1,9,0)="--------------------------------------------"
^DIC(9.4,164,22,1,"PAH",202,1,10,0)="INC2574335 - Our drug file entry will not let me add the labs associated with"
^DIC(9.4,164,22,1,"PAH",202,1,11,0)="             the drug Clozapine that needs labs attached so that drug checks"
^DIC(9.4,164,22,1,"PAH",202,1,12,0)="             can be performed"
^DIC(9.4,164,22,1,"PAH",202,1,13,0)="          "
^DIC(9.4,164,22,1,"PAH",202,1,14,0)="Problem: "
^DIC(9.4,164,22,1,"PAH",202,1,15,0)="--------"
^DIC(9.4,164,22,1,"PAH",202,1,16,0)="Noth Texas VAMC reported a problem when trying to use the Drug Enter/Edit "
^DIC(9.4,164,22,1,"PAH",202,1,17,0)="[PSS DRUG ENTER/EDIT] option to mark a dispense drug a 'Clozapine' drug."
^DIC(9.4,164,22,1,"PAH",202,1,18,0)="After entering the lab test (WBC) and Specimen Type (BLOOD) they would get"
^DIC(9.4,164,22,1,"PAH",202,1,19,0)="a double question mark (??) after answering 'YES' at the 'Is this Correct?'"
^DIC(9.4,164,22,1,"PAH",202,1,20,0)="prompt. "
^DIC(9.4,164,22,1,"PAH",202,1,21,0)="       "
^DIC(9.4,164,22,1,"PAH",202,1,22,0)="Resolution:"
^DIC(9.4,164,22,1,"PAH",202,1,23,0)="-----------"
^DIC(9.4,164,22,1,"PAH",202,1,24,0)="The problem was a result of an internal call to Fileman to save the lab test"
^DIC(9.4,164,22,1,"PAH",202,1,25,0)="data. Fileman was getting lost because it found more than one match to the"
^DIC(9.4,164,22,1,"PAH",202,1,26,0)="IEN for 'BLOOD' in the TOPOGRAPHY FIELD file (#61) because it did not "
^DIC(9.4,164,22,1,"PAH",202,1,27,0)="restrict the lookup to IEN only and other entries in that file had the "
^DIC(9.4,164,22,1,"PAH",202,1,28,0)="ABBREVIATION field (#6) set with a value that matched the IEN for 'BLOOD'."
^DIC(9.4,164,22,1,"PAH",202,1,29,0)="  "
^DIC(9.4,164,22,1,"PAH",202,1,30,0)="Technical Resolution:"
^DIC(9.4,164,22,1,"PAH",202,1,31,0)="---------------------"
^DIC(9.4,164,22,1,"PAH",202,1,32,0)="Changed the routine PSSCLOZ at CLOZAD2+2 to use 4 slashes (////) instead of"
^DIC(9.4,164,22,1,"PAH",202,1,33,0)="3 slashes (///) when saving SPECIMEN TYPE FIELD (#2), as shown below:"
^DIC(9.4,164,22,1,"PAH",202,1,34,0)=" "
^DIC(9.4,164,22,1,"PAH",202,1,35,0)=" S DIC(""DR"")=""2////""_PSSPTYN_"";3///""_PSSTUFF"
^DIC(9.4,164,22,1,"PAH",203,0)="233 SEQ #204^3190402.164743^54"
^DIC(9.4,164,22,1,"PAH",203,1,0)="^^2^2^3190402"
^DIC(9.4,164,22,1,"PAH",203,1,1,0)="This patch addresses some display issues in the Lookup into Dispense "
^DIC(9.4,164,22,1,"PAH",203,1,2,0)="Drug File Option [PSS LOOK]"
^DIC(9.4,164,22,1,"PAH",204,0)="235 SEQ #205^3190501.155512^54"
^DIC(9.4,164,22,1,"PAH",204,1,0)="^^2^2^3190501"
^DIC(9.4,164,22,1,"PAH",204,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,164,22,1,"PAH",204,1,2,0)="under PSS*1*235."
^DIC(9.4,164,22,1,"PAH",205,0)="234 SEQ #206^3190708.16395^65"
^DIC(9.4,164,22,1,"PAH",205,1,0)="^^5^5^3190708"
^DIC(9.4,164,22,1,"PAH",205,1,1,0)="The purpose of this build is to export the data dictionary for the "
^DIC(9.4,164,22,1,"PAH",205,1,2,0)="PHARMACY ORDERABLE ITEM file (#50.7) in order to update the APPLICATION "
^DIC(9.4,164,22,1,"PAH",205,1,3,0)="GROUP field to add GMTS. In addition, it exports the routine to return "
^DIC(9.4,164,22,1,"PAH",205,1,4,0)="the pharmacy orderable item information in order to support the Ad Hoc "
^DIC(9.4,164,22,1,"PAH",205,1,5,0)="report summary."
^DIC(9.4,164,22,1,"PAH",206,0)="236 SEQ #207^3191024.121411^65"
^DIC(9.4,164,22,1,"PAH",206,1,0)="^^2^2^3191024"
^DIC(9.4,164,22,1,"PAH",206,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,164,22,1,"PAH",206,1,2,0)="under PSS*1*236."
^DIC(9.4,164,22,1,"PAH",207,0)="240 SEQ #208^3200211.095613^65"
^DIC(9.4,164,22,1,"PAH",207,1,0)="^^1^1^3200211"
^DIC(9.4,164,22,1,"PAH",207,1,1,0)="CORRECT THE URL FOR MEDICATION ROUTE REQUEST"
^DIC(9.4,164,22,1,"PAH",208,0)="238 SEQ #209^3200325.102431^70"
^DIC(9.4,164,22,1,"PAH",209,0)="243 SEQ #210^3200624.140452^65"
^DIC(9.4,164,22,1,"PAH",209,1,0)="^^49^49^3200624"
^DIC(9.4,164,22,1,"PAH",209,1,1,0)="This patch, along with patch PSN*4*569 will address the following ePrescribing"
^DIC(9.4,164,22,1,"PAH",209,1,2,0)="(eRx) issue: "
^DIC(9.4,164,22,1,"PAH",209,1,3,0)="  "
^DIC(9.4,164,22,1,"PAH",209,1,4,0)="1. INC9317643 - We have noticed a number of drugs that do not auto match for"
^DIC(9.4,164,22,1,"PAH",209,1,5,0)="   inbound eRx orders"
^DIC(9.4,164,22,1,"PAH",209,1,6,0)="   "
^DIC(9.4,164,22,1,"PAH",209,1,7,0)="   DUPLICATE - INC9105989 - erx software auto-matched wrong drug product"
^DIC(9.4,164,22,1,"PAH",209,1,8,0)="  "
^DIC(9.4,164,22,1,"PAH",209,1,9,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,164,22,1,"PAH",209,1,10,0)="--------------------------------------------"
^DIC(9.4,164,22,1,"PAH",209,1,11,0)="1. INC9317643 - We have noticed a number of drugs that do not auto match for"
^DIC(9.4,164,22,1,"PAH",209,1,12,0)="   inbound eRx orders"
^DIC(9.4,164,22,1,"PAH",209,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",209,1,14,0)="   DUPLICATE - INC9105989 - erx software auto-matched wrong drug product"
^DIC(9.4,164,22,1,"PAH",209,1,15,0)="  "
^DIC(9.4,164,22,1,"PAH",209,1,16,0)="Problem: "
^DIC(9.4,164,22,1,"PAH",209,1,17,0)="--------"
^DIC(9.4,164,22,1,"PAH",209,1,18,0)="The VA Health Administration Center Denver reported and issue with incoming"
^DIC(9.4,164,22,1,"PAH",209,1,19,0)="ePrescribing orders (eRx) not automatically matching the ordered drug with a"
^DIC(9.4,164,22,1,"PAH",209,1,20,0)="VistA corresponding Dispense Drug, even when the NDC received matches 1 to 1"
^DIC(9.4,164,22,1,"PAH",209,1,21,0)="with a specific VA Product entry. They also noticed the issue to be more"
^DIC(9.4,164,22,1,"PAH",209,1,22,0)="prevalent with dispense drugs that have been recently re-matched to a "
^DIC(9.4,164,22,1,"PAH",209,1,23,0)="different VA Product entry due to changes from MG to MGC in the strength. "
^DIC(9.4,164,22,1,"PAH",209,1,24,0)="After researching this issue it was determined that the root cause of the"
^DIC(9.4,164,22,1,"PAH",209,1,25,0)="problem was a 'corruption' of the ""APR"" cross-reference in the DRUG file (#50)"
^DIC(9.4,164,22,1,"PAH",209,1,26,0)="which was not properly set or killed after Dispense Drugs were matched,"
^DIC(9.4,164,22,1,"PAH",209,1,27,0)="un-matched or re-matched to VA Product entries. Such cross-reference is used"
^DIC(9.4,164,22,1,"PAH",209,1,28,0)="by the eRx drug auto-matching processing and that's the reason it failed"
^DIC(9.4,164,22,1,"PAH",209,1,29,0)="for some drugs. It turned out that two other cross-references ""AND"" and ""APN"""
^DIC(9.4,164,22,1,"PAH",209,1,30,0)="also had the same issue. No user functionality side-effects have been"
^DIC(9.4,164,22,1,"PAH",209,1,31,0)="reported related to these other two cross-references though."
^DIC(9.4,164,22,1,"PAH",209,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",209,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",209,1,34,0)="Resolution: "
^DIC(9.4,164,22,1,"PAH",209,1,35,0)="-----------"
^DIC(9.4,164,22,1,"PAH",209,1,36,0)="The setting and killing of the ""APR"", ""AND"" and ""APN"" cross-reference have"
^DIC(9.4,164,22,1,"PAH",209,1,37,0)="been completely reviewed at every point where a Dispense Drug is matched,"
^DIC(9.4,164,22,1,"PAH",209,1,38,0)="un-matched or re-matched to a VA Product and after this patch is installed"
^DIC(9.4,164,22,1,"PAH",209,1,39,0)="they should be properly maintained. Furthermore, a post-install routine"
^DIC(9.4,164,22,1,"PAH",209,1,40,0)="will completely kill off the 3 cross-references and re-build them completely."
^DIC(9.4,164,22,1,"PAH",209,1,41,0)="The NDF (National Drug File) patch PSS*1*243 is also being released along with"
^DIC(9.4,164,22,1,"PAH",209,1,42,0)="this patch because the matching functionality is available in both"
^DIC(9.4,164,22,1,"PAH",209,1,43,0)="applications, NDF and PDM (Pharmacy Data Management). "
^DIC(9.4,164,22,1,"PAH",209,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",209,1,45,0)="        "
^DIC(9.4,164,22,1,"PAH",209,1,46,0)="Technical Resolution: "
^DIC(9.4,164,22,1,"PAH",209,1,47,0)="---------------------"
^DIC(9.4,164,22,1,"PAH",209,1,48,0)="Changed the routines PSSDEE1 and PSSUTIL to kill and set the cross-references"
^DIC(9.4,164,22,1,"PAH",209,1,49,0)="""AND"", ""APN"" and ""APR"" properly."
^DIC(9.4,164,22,1,"PAH",210,0)="241 SEQ #211^3200721.134641^65"
^DIC(9.4,164,22,1,"PAH",210,1,0)="^^1^1^3200721"
^DIC(9.4,164,22,1,"PAH",210,1,1,0)="Remove HANG command from ST in PSSPRICE."
^DIC(9.4,164,22,1,"PAH",211,0)="242 SEQ #212^3200810.125253^65"
^DIC(9.4,164,22,1,"PAH",211,1,0)="^^7^7^3200810"
^DIC(9.4,164,22,1,"PAH",211,1,1,0)="This patch provides the functionality to add the other language "
^DIC(9.4,164,22,1,"PAH",211,1,2,0)="Indications for Use in the PHARMACY ORDERABLE ITEMS file (#50.7)."
^DIC(9.4,164,22,1,"PAH",211,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",211,1,4,0)="The menu options Edit Orderable Items [PSS EDIT ORDERABLE ITEMS], "
^DIC(9.4,164,22,1,"PAH",211,1,5,0)="Dispense Drug/Orderable Item Maintenance [PSS MAINTAIN ORDERABLE ITEMS] "
^DIC(9.4,164,22,1,"PAH",211,1,6,0)="and Drug Enter/Edit [PSS DRUG ENTER/EDIT] have been modified to prompt for"
^DIC(9.4,164,22,1,"PAH",211,1,7,0)="other indications for use."
^DIC(9.4,164,22,1,"PAH",212,0)="245 SEQ #213^3200819.112722^65"
^DIC(9.4,164,22,1,"PAH",212,1,0)="^^41^41^3200819"
^DIC(9.4,164,22,1,"PAH",212,1,1,0)="1. INC9511598 Med Instructions Display incorrectly with Clinic Medications"
^DIC(9.4,164,22,1,"PAH",212,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",212,1,3,0)="   Problem:"
^DIC(9.4,164,22,1,"PAH",212,1,4,0)="   -------"
^DIC(9.4,164,22,1,"PAH",212,1,5,0)="   The Med Route abbreviation for Clinic Meds and Inpatient Meds expands "
^DIC(9.4,164,22,1,"PAH",212,1,6,0)="   in the EMLR using the Med Instruction Name if the abbreviation is"
^DIC(9.4,164,22,1,"PAH",212,1,7,0)="   identical, which may result in a mismatch of clinical terminology if"
^DIC(9.4,164,22,1,"PAH",212,1,8,0)="   the fields were not defined properly."
^DIC(9.4,164,22,1,"PAH",212,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",212,1,10,0)="   Resolution:"
^DIC(9.4,164,22,1,"PAH",212,1,11,0)="   ----------"
^DIC(9.4,164,22,1,"PAH",212,1,12,0)="   This patch adds a new report which displays matches between the "
^DIC(9.4,164,22,1,"PAH",212,1,13,0)="   Medication Instruction file (#51) and the Medication Routes file "
^DIC(9.4,164,22,1,"PAH",212,1,14,0)="   (#51.2). "
^DIC(9.4,164,22,1,"PAH",212,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",212,1,16,0)="   The MEDICATION INSTRUCTION Name field (File #51) and MEDICATION ROUTE"
^DIC(9.4,164,22,1,"PAH",212,1,17,0)="   Abbreviation field (File #51.2) may have entries that use similar"
^DIC(9.4,164,22,1,"PAH",212,1,18,0)="   terminology and abbreviations but with different clinical meanings."
^DIC(9.4,164,22,1,"PAH",212,1,19,0)="   The MED INSTRUCTION MED ROUTE TERM REPORT option identifies instances"
^DIC(9.4,164,22,1,"PAH",212,1,20,0)="   where the MEDICATION INSTRUCTION Name field and the MEDICATION ROUTE"
^DIC(9.4,164,22,1,"PAH",212,1,21,0)="   Abbreviation field are identical to facilitate review and correction"
^DIC(9.4,164,22,1,"PAH",212,1,22,0)="   of clinically inconsistent terminology between the two files. Local"
^DIC(9.4,164,22,1,"PAH",212,1,23,0)="   Pharmacy Informaticists should review and evaluate this report for"
^DIC(9.4,164,22,1,"PAH",212,1,24,0)="   possible corrective action to ensure that reports which use the"
^DIC(9.4,164,22,1,"PAH",212,1,25,0)="   expansion from the MEDICATION INSTRUCTION file are clinically valid"
^DIC(9.4,164,22,1,"PAH",212,1,26,0)="   when the data originates in the MEDICATION ROUTE file.  "
^DIC(9.4,164,22,1,"PAH",212,1,27,0)=" "
^DIC(9.4,164,22,1,"PAH",212,1,28,0)="   This patch adds the Med Instruction Med Term Route Report to the"
^DIC(9.4,164,22,1,"PAH",212,1,29,0)="   Medication Instruction Management menu (PSS MED INSTRUCTION "
^DIC(9.4,164,22,1,"PAH",212,1,30,0)="   MANAGEMENT) and the Medication Routes Management menu (PSS MEDICATION"
^DIC(9.4,164,22,1,"PAH",212,1,31,0)="   ROUTES MGMT)."
^DIC(9.4,164,22,1,"PAH",212,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",212,1,33,0)="   Upon running the report, sites should refer to the Pharmacy Data"
^DIC(9.4,164,22,1,"PAH",212,1,34,0)="   Management User Manual located on the VistA Software Document Library"
^DIC(9.4,164,22,1,"PAH",212,1,35,0)="   for the dedicated Pharmacy website to discuss the potential options "
^DIC(9.4,164,22,1,"PAH",212,1,36,0)="   for file management or to see previous site's decisions on how similar"
^DIC(9.4,164,22,1,"PAH",212,1,37,0)="   entries were handled."
^DIC(9.4,164,22,1,"PAH",212,1,38,0)=" "
^DIC(9.4,164,22,1,"PAH",212,1,39,0)="   Documentation updates are applied to the Pharmacy Data Management User"
^DIC(9.4,164,22,1,"PAH",212,1,40,0)="   Manual as well as the Pharmacy Data Management Technical "
^DIC(9.4,164,22,1,"PAH",212,1,41,0)="   Manual/Security Guide."
^DIC(9.4,164,22,1,"PAH",213,0)="246 SEQ #214^3201106.161515^17"
^DIC(9.4,164,22,1,"PAH",213,1,0)="^^10^10^3201106"
^DIC(9.4,164,22,1,"PAH",213,1,1,0)="The released patch PSS*1*219 provided functionality to exclude "
^DIC(9.4,164,22,1,"PAH",213,1,2,0)="buprenorphine-containing products from requiring an X-number (Detox "
^DIC(9.4,164,22,1,"PAH",213,1,3,0)="Number) when they are specifically FDA approved with indication for the"
^DIC(9.4,164,22,1,"PAH",213,1,4,0)="treatment of pain. This was done by dosage form so that Butrans (patch)"
^DIC(9.4,164,22,1,"PAH",213,1,5,0)="and Belbuca (film, buccal), the products available at the time, could be"
^DIC(9.4,164,22,1,"PAH",213,1,6,0)="excluded.  However, a new product, Bunavail has been released to market.  "
^DIC(9.4,164,22,1,"PAH",213,1,7,0)="This is also a buccal film but is primarily indicated for treatment of"
^DIC(9.4,164,22,1,"PAH",213,1,8,0)="opioid substance use disorder. Therefore, changes are needed that will"
^DIC(9.4,164,22,1,"PAH",213,1,9,0)="require an X-number when a Bunavail order is placed with a dosage form of"
^DIC(9.4,164,22,1,"PAH",213,1,10,0)="buccal film.  "
^DIC(9.4,164,22,1,"PAH",214,0)="248b^3210513"
^DIC(9.4,164,22,1,"PAH",214,1,0)="^^5^5^3210513"
^DIC(9.4,164,22,1,"PAH",214,1,1,0)="Backup of PSS*1.0*248 on May 13, 2021"
^DIC(9.4,164,22,1,"PAH",214,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",214,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,164,22,1,"PAH",214,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,164,22,1,"PAH",214,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,164,22,1,"PAH",215,0)="248 SEQ #215^3210513.171514^17"
^DIC(9.4,164,22,1,"PAH",215,1,0)="^^15^15^3210513"
^DIC(9.4,164,22,1,"PAH",215,1,1,0)="The current CMOP Share site is being decommissioned and will be"
^DIC(9.4,164,22,1,"PAH",215,1,2,0)="inaccessible for Med Guide retrieval. The application requires a "
^DIC(9.4,164,22,1,"PAH",215,1,3,0)="configuration upgrade and installation to access the new URL. "
^DIC(9.4,164,22,1,"PAH",215,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",215,1,5,0)="This patch will update the Pharmacy System File (File #59.7) FDA MED GUIDE"
^DIC(9.4,164,22,1,"PAH",215,1,6,0)="SERVER URL field (Field #100) with the new secure URL."
^DIC(9.4,164,22,1,"PAH",215,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",215,1,8,0)="Post-init routine PSS248P will change the FDA MED GUIDE SERVER URL field"
^DIC(9.4,164,22,1,"PAH",215,1,9,0)="from this: "
^DIC(9.4,164,22,1,"PAH",215,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",215,1,11,0)="https://vaww.cmopnational.domain.ext/CR/FDAMedGuides/ "
^DIC(9.4,164,22,1,"PAH",215,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",215,1,13,0)="To:"
^DIC(9.4,164,22,1,"PAH",215,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",215,1,15,0)="https://vaww.vashare.domain.ext/sites/PBMNat/FDAMedGuides/ "
^DIC(9.4,164,22,1,"PAH",216,0)="249b^3210617"
