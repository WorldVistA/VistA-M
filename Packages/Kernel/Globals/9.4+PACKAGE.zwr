^DIC(9.4,47,22,5.9,"PAH",157,1,0)="^^1^1^3000204"
^DIC(9.4,47,22,5.9,"PAH",157,1,1,0)="See the national patch module for details."
^DIC(9.4,47,22,5.9,"PAH",158,0)="146 SEQ #236^3000204^1"
^DIC(9.4,47,22,5.9,"PAH",158,1,0)="^^1^1^3000204"
^DIC(9.4,47,22,5.9,"PAH",158,1,1,0)="PATIENT MERGE/MEANS TEST MODIFICATION"
^DIC(9.4,47,22,5.9,"PAH",159,0)="249 SEQ #237^3000204^1"
^DIC(9.4,47,22,5.9,"PAH",159,1,0)="^^17^17^3000204"
^DIC(9.4,47,22,5.9,"PAH",159,1,1,0)="This patch contains modifications to the patient look up process for GUI"
^DIC(9.4,47,22,5.9,"PAH",159,1,2,0)="interfaces and provides functionality for Privacy Act compliance for"
^DIC(9.4,47,22,5.9,"PAH",159,1,3,0)="employees."
^DIC(9.4,47,22,5.9,"PAH",159,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",159,1,5,0)="If the patient's primary eligibility code is employee, the DOB and SSN"
^DIC(9.4,47,22,5.9,"PAH",159,1,6,0)="fields will display *SENSITIVE* until the user acknowledges they wish to"
^DIC(9.4,47,22,5.9,"PAH",159,1,7,0)="access the sensitive record.  The DG Security Log file is updated and"
^DIC(9.4,47,22,5.9,"PAH",159,1,8,0)="the Sensitive Record Access mail message generated."
^DIC(9.4,47,22,5.9,"PAH",159,1,9,0)=" "
^DIC(9.4,47,22,5.9,"PAH",159,1,10,0)="Two RPCs will be created for GUI applications:"
^DIC(9.4,47,22,5.9,"PAH",159,1,11,0)=" "
^DIC(9.4,47,22,5.9,"PAH",159,1,12,0)="     - DG SENSITIVE RECORD ACCESS determines if the user is accessing"
^DIC(9.4,47,22,5.9,"PAH",159,1,13,0)="his/her own Patient file record, if the record is sensitive or if"
^DIC(9.4,47,22,5.9,"PAH",159,1,14,0)="the patient's primary eligibility code is employee."
^DIC(9.4,47,22,5.9,"PAH",159,1,15,0)=" "
^DIC(9.4,47,22,5.9,"PAH",159,1,16,0)="     - DG SENSITIVE RECORD BULLETIN updates the DG Security Log file and"
^DIC(9.4,47,22,5.9,"PAH",159,1,17,0)="generates the Sensitive Record Access mail message."
^DIC(9.4,47,22,5.9,"PAH",160,0)="265 SEQ #238^3000204^1"
^DIC(9.4,47,22,5.9,"PAH",161,0)="276 SEQ #239^3000229^1"
^DIC(9.4,47,22,5.9,"PAH",161,1,0)="^^1^1^3000229"
^DIC(9.4,47,22,5.9,"PAH",161,1,1,0)="Excess HL7 messages from patient lookup"
^DIC(9.4,47,22,5.9,"PAH",162,0)="256 SEQ #240^3000229^1"
^DIC(9.4,47,22,5.9,"PAH",162,1,0)="^^2^2^3000229"
^DIC(9.4,47,22,5.9,"PAH",162,1,1,0)="This patch modifies routine DGPTMOVE to correctly display the next fiscal"
^DIC(9.4,47,22,5.9,"PAH",162,1,2,0)="year in the Move Trim Values, [DG PTF MOVE TRIM], option."
^DIC(9.4,47,22,5.9,"PAH",163,0)="265^3000306^1"
