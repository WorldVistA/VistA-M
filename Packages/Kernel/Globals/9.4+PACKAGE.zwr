^DIC(9.4,161,22,1,"PAH",12,1,33,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,34,0)="ICPTZM0"
^DIC(9.4,161,22,1,"PAH",12,1,35,0)="split into ICPTZM0 and ICPTZM01"
^DIC(9.4,161,22,1,"PAH",12,1,36,0)="various changes to update the Modifier file from Ingenix file"
^DIC(9.4,161,22,1,"PAH",12,1,37,0)="(see also ICPTZM09)"
^DIC(9.4,161,22,1,"PAH",12,1,38,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,39,0)="These routines are included in the build:"
^DIC(9.4,161,22,1,"PAH",12,1,40,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,41,0)="ICPT613R (preinit)"
^DIC(9.4,161,22,1,"PAH",12,1,42,0)="host file names changed"
^DIC(9.4,161,22,1,"PAH",12,1,43,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,44,0)="ICPT613E (environment check)"
^DIC(9.4,161,22,1,"PAH",12,1,45,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,46,0)="ICPTPRN"
^DIC(9.4,161,22,1,"PAH",12,1,47,0)="date hard-coded"
^DIC(9.4,161,22,1,"PAH",12,1,48,0)=" "
^DIC(9.4,161,22,1,"PAH",12,1,49,0)="ICPTSR1 thru ICPTSR3"
^DIC(9.4,161,22,1,"PAH",12,1,50,0)="routines that contain all revised CPT codes - all AMA codes included"
^DIC(9.4,161,22,1,"PAH",12,1,51,0)="again this year because we went back to using AMA file instead of"
^DIC(9.4,161,22,1,"PAH",12,1,52,0)="Ingenix file and short descriptions are different."
