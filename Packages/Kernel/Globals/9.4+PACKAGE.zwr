^DIC(9.4,60,22,13,"PAH",480,1,315,0)=" Software and Documentation Retrieval Instructions:"
^DIC(9.4,60,22,13,"PAH",480,1,316,0)=" --------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",480,1,317,0)=" The software for this patch is being released as a host file."
^DIC(9.4,60,22,13,"PAH",480,1,318,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,319,0)=" The host file is available at the following location:  "
^DIC(9.4,60,22,13,"PAH",480,1,320,0)=" /srv/vista/patches/SOFTWARE/PSO_YS_CLOZ_COVID.KID  "
^DIC(9.4,60,22,13,"PAH",480,1,321,0)="      "
^DIC(9.4,60,22,13,"PAH",480,1,322,0)=" Documentation describing the new functionality is included in this"
^DIC(9.4,60,22,13,"PAH",480,1,323,0)=" release. Documentation can be found on the VA Software Documentation "
^DIC(9.4,60,22,13,"PAH",480,1,324,0)=" Library at: https://www.domain.ext/vdl/"
^DIC(9.4,60,22,13,"PAH",480,1,325,0)=" "
^DIC(9.4,60,22,13,"PAH",480,1,326,0)=" -------------------------------------------------------------------------"
