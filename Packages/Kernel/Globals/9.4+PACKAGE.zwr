^DIC(9.4,91,22,4,"PAH",1,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,91,22,4,"PAH",1,1,2,0)="of patch DVB*4*28 in the National Patch Module."
^DIC(9.4,91,22,4,"PAH",2,0)="29^2970401^1"
^DIC(9.4,91,22,4,"PAH",2,1,0)="^^3^3^2970401"
^DIC(9.4,91,22,4,"PAH",2,1,1,0)="This patch updates the Disability Condition file (#31), adding new codes"
^DIC(9.4,91,22,4,"PAH",2,1,2,0)="and modifying names and descriptions of others.  See NPM for complete"
^DIC(9.4,91,22,4,"PAH",2,1,3,0)="description."
^DIC(9.4,91,22,4,"PAH",3,0)="30^2980112^1"
^DIC(9.4,91,22,4,"PAH",3,1,0)="^^1^1^2980112"
^DIC(9.4,91,22,4,"PAH",3,1,1,0)="See Patch Description in National Patch Module for DVB*4*30."
^DIC(9.4,91,22,4,"PAH",4,0)="31^2980330^1"
^DIC(9.4,91,22,4,"PAH",4,1,0)="^^2^2^2980330"
^DIC(9.4,91,22,4,"PAH",4,1,1,0)="DVB*4.0*31"
^DIC(9.4,91,22,4,"PAH",4,1,2,0)="Revisions for Y2K."
^DIC(9.4,91,22,4,"PAH",5,0)="32^2981007^1"
^DIC(9.4,91,22,4,"PAH",5,1,0)="^^1^1^2981007"
^DIC(9.4,91,22,4,"PAH",5,1,1,0)="Clean up outstanding NOIS issues."
^DIC(9.4,91,22,4,"PAH",6,0)="33^2990201^1"
^DIC(9.4,91,22,4,"PAH",6,1,0)="^^6^6^2990201"
^DIC(9.4,91,22,4,"PAH",6,1,1,0)="This install converts HINQ to use IP routing for connection to remote RDPCs."
^DIC(9.4,91,22,4,"PAH",6,1,2,0)="   "
^DIC(9.4,91,22,4,"PAH",6,1,3,0)="After the KIDS build is loaded, the environment routine DVBH4033 may also"
^DIC(9.4,91,22,4,"PAH",6,1,4,0)="be used as a diagnostic routine.  It is a copy of the updated DVBHQDX "
^DIC(9.4,91,22,4,"PAH",6,1,5,0)="routine included in the build.  D ^XUP before using DVBH4033 as a diagnostic"
^DIC(9.4,91,22,4,"PAH",6,1,6,0)="routine. "
^DIC(9.4,91,22,4,"PAH",7,0)="34 SEQ #34^2991003^1"
^DIC(9.4,91,22,4,"PAH",7,1,0)="^^7^7^2991003"
^DIC(9.4,91,22,4,"PAH",7,1,1,0)="This install should reduce READ and ENDOFFILE errors and trap them"
^DIC(9.4,91,22,4,"PAH",7,1,2,0)="at Cache, OpenM sites.  These errors occur after the installation of"
^DIC(9.4,91,22,4,"PAH",7,1,3,0)="patch DVB*4*33, HINQ FRAME RELAY."
^DIC(9.4,91,22,4,"PAH",7,1,4,0)=" "
^DIC(9.4,91,22,4,"PAH",7,1,5,0)="This install will implement TCP connections in DSM systems.  The"
^DIC(9.4,91,22,4,"PAH",7,1,6,0)="LAT ports, devices and the LAT/TCP gateway on the local router will no"
^DIC(9.4,91,22,4,"PAH",7,1,7,0)="longer be used.  "
^DIC(9.4,91,22,4,"PAH",8,0)="35 SEQ #35^3000405^1"
^DIC(9.4,91,22,4,"PAH",8,1,0)="^^3^3^3000405"
^DIC(9.4,91,22,4,"PAH",8,1,1,0)="This patch corrects the incorrectly assumed EOD and RAD in the parser"
^DIC(9.4,91,22,4,"PAH",8,1,2,0)="routine of HINQ full response. The patch also adds documentation to some"
^DIC(9.4,91,22,4,"PAH",8,1,3,0)="of the parser routines of the HINQ full response."
^DIC(9.4,91,22,4,"PAH",9,0)="37 SEQ #36^3000525^1"
^DIC(9.4,91,22,4,"PAH",9,1,0)="^^5^5^3000525"
^DIC(9.4,91,22,4,"PAH",9,1,1,0)="This patch will display the dates in the abbreviated HINQ response without"
^DIC(9.4,91,22,4,"PAH",9,1,2,0)="the century. Once VBA sends in 4 digit years for the dates in the"
^DIC(9.4,91,22,4,"PAH",9,1,3,0)="abbreviated HINQ response, a following patch will be initiated to refelect"
^DIC(9.4,91,22,4,"PAH",9,1,4,0)="the change, and have the dates in the abbreviated HINQ response displayed"
^DIC(9.4,91,22,4,"PAH",9,1,5,0)="with the century."
^DIC(9.4,91,22,4,"PAH",10,0)="36 SEQ #37^3000816^1"
^DIC(9.4,91,22,4,"PAH",10,1,0)="^^2^2^3000816"
^DIC(9.4,91,22,4,"PAH",10,1,1,0)="This patch corrects the problem that HINQ requestor information doesn't"
^DIC(9.4,91,22,4,"PAH",10,1,2,0)="get updated when making HINQ inquiries using [Individual HINQ Request]."
^DIC(9.4,91,22,4,"PAH",11,0)="40 SEQ #38^3010608^1"
^DIC(9.4,91,22,4,"PAH",11,1,0)="^^1^1^3010608"
^DIC(9.4,91,22,4,"PAH",11,1,1,0)="Correct the Null subscript error after processing the HINQ"
^DIC(9.4,91,22,4,"PAH",12,0)="38 SEQ #39^3010710^1"
^DIC(9.4,91,22,4,"PAH",12,1,0)="^^1^1^3010710"
^DIC(9.4,91,22,4,"PAH",12,1,1,0)="Modify HINQ routines to reflect the new VBA schedule."
^DIC(9.4,91,22,4,"PAH",13,0)="41 SEQ #40^3020506^1"
^DIC(9.4,91,22,4,"PAH",13,1,0)="^^1^1^3020506"
^DIC(9.4,91,22,4,"PAH",13,1,1,0)="Two codes will be added/updated via a post install utility."
^DIC(9.4,91,22,4,"PAH",14,0)="42 SEQ #41^3030301^1"
^DIC(9.4,91,22,4,"PAH",15,0)="44 SEQ #42^3030417^1"
^DIC(9.4,91,22,4,"PAH",16,0)="46 SEQ #43^3030912^1"
^DIC(9.4,91,22,4,"PAH",16,1,0)="^^2^2^3030912"
^DIC(9.4,91,22,4,"PAH",16,1,1,0)="Upgrading to Cache 4.1.x created a problem when the I/O device is not "
^DIC(9.4,91,22,4,"PAH",16,1,2,0)="defined."
^DIC(9.4,91,22,4,"PAH",17,0)="43 SEQ #44^3031121^1"
^DIC(9.4,91,22,4,"PAH",17,1,0)="^^2^2^3031121"
^DIC(9.4,91,22,4,"PAH",17,1,1,0)="Errors occur when processing INDIVIDUAL HINQ'S, VIEWING ALERTS, AND "
^DIC(9.4,91,22,4,"PAH",17,1,2,0)="PRINTING THE HINQ SUSPENSE FILE."
^DIC(9.4,91,22,4,"PAH",18,0)="45 SEQ #45^3031121^1"
^DIC(9.4,91,22,4,"PAH",19,0)="48 SEQ #46^3040702^1"
^DIC(9.4,91,22,4,"PAH",19,1,0)="^^1^1^3040702"
^DIC(9.4,91,22,4,"PAH",19,1,1,0)="THIS PATCH WILL UPDATE THE DISABILITY CONDITION FILE(#31)"
