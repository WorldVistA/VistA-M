^DIC(9.4,9,22,3.3,0)="5.0^3051119^2960605"
^DIC(9.4,9,22,3.3,"PAH",0)="^9.4901^37^37"
^DIC(9.4,9,22,3.3,"PAH",1,0)="4^2960923^1"
^DIC(9.4,9,22,3.3,"PAH",1,1,0)="^^1^1^2960923"
^DIC(9.4,9,22,3.3,"PAH",1,1,1,0)="Dietetics Version 5.0 patch 4 Assessment and Patient Movements."
^DIC(9.4,9,22,3.3,"PAH",2,0)="5^2961003^1"
^DIC(9.4,9,22,3.3,"PAH",2,1,0)="^^1^1^2961003"
^DIC(9.4,9,22,3.3,"PAH",2,1,1,0)="This is Dietetics Patch 5."
^DIC(9.4,9,22,3.3,"PAH",3,0)="7^2961108^1"
^DIC(9.4,9,22,3.3,"PAH",3,1,0)="^^1^1^2961108"
^DIC(9.4,9,22,3.3,"PAH",3,1,1,0)="This is Dietetics Version 5.0 Patch 7."
^DIC(9.4,9,22,3.3,"PAH",4,0)="8 SEQ #7^2970528^1"
^DIC(9.4,9,22,3.3,"PAH",4,1,0)="^^1^1^2970528"
^DIC(9.4,9,22,3.3,"PAH",4,1,1,0)="This is Patch 8 of Dietetics Version 5."
^DIC(9.4,9,22,3.3,"PAH",5,0)="9 SEQ #8^2970819^1"
^DIC(9.4,9,22,3.3,"PAH",5,1,0)="^^1^1^2970819"
^DIC(9.4,9,22,3.3,"PAH",5,1,1,0)="THIS PATCH ADDRESSES FOUR DIETETIC NOIS MESSAGES AND TWO E3Rs."
^DIC(9.4,9,22,3.3,"PAH",6,0)="10 SEQ #9^2971028^1"
^DIC(9.4,9,22,3.3,"PAH",6,1,0)="^^3^3^2971028"
^DIC(9.4,9,22,3.3,"PAH",6,1,1,0)="Change second line in FHPATM and FHSEL1."
^DIC(9.4,9,22,3.3,"PAH",6,1,2,0)=" "
^DIC(9.4,9,22,3.3,"PAH",6,1,3,0)="*** MAKE SURE PATCH 9 IS LOADED! ***"
^DIC(9.4,9,22,3.3,"PAH",7,0)="11 SEQ #10^2971105^1"
^DIC(9.4,9,22,3.3,"PAH",7,1,0)="^^1^1^2971105"
^DIC(9.4,9,22,3.3,"PAH",7,1,1,0)="Patch to display Dietitians name who entered Nutritional Assessment."
^DIC(9.4,9,22,3.3,"PAH",8,0)="12 SEQ #11^2980305^1"
^DIC(9.4,9,22,3.3,"PAH",8,1,0)="^^105^105^2980305"
^DIC(9.4,9,22,3.3,"PAH",8,1,1,0)="This patch is the Dietetics portion of the Order Entry 3.0 (CPRS Version 1)"
^DIC(9.4,9,22,3.3,"PAH",8,1,2,0)="pre-install.  It contains five routines, FHORD, FHORT3, FHWORI, FHWOR6, and "
^DIC(9.4,9,22,3.3,"PAH",8,1,3,0)="FHXOR3.  These routines will be used to populate, and update Order Entry's"
^DIC(9.4,9,22,3.3,"PAH",8,1,4,0)="Orderable Item file (#101.43) with the Diet and Tubefeeding entries from    "
^DIC(9.4,9,22,3.3,"PAH",8,1,5,0)="the Diet file (#111) and the Tubefeeding file (#118.2).                      "
^DIC(9.4,9,22,3.3,"PAH",8,1,6,0)="   "
^DIC(9.4,9,22,3.3,"PAH",8,1,7,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,8,0)="ROUTINE: FHXOR3"
^DIC(9.4,9,22,3.3,"PAH",8,1,9,0)="                                                                           "
^DIC(9.4,9,22,3.3,"PAH",8,1,10,0)="This routine is a post-init routine which will add three Dietetics protocols"
^DIC(9.4,9,22,3.3,"PAH",8,1,11,0)="to the Protocol file (#101).  They are the following:"
^DIC(9.4,9,22,3.3,"PAH",8,1,12,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,13,0)="FH EVSEND OR                                                                "
^DIC(9.4,9,22,3.3,"PAH",8,1,14,0)="FH RECEIVE                                                                  "
^DIC(9.4,9,22,3.3,"PAH",8,1,15,0)="FH ORDERABLE ITEM UPDATE                                                    "
^DIC(9.4,9,22,3.3,"PAH",8,1,16,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,17,0)="ROUTINE: FHORD, FHORT3, FHWORI, and FHWOR6                                  "
^DIC(9.4,9,22,3.3,"PAH",8,1,18,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,19,0)="Routine FHWORI, that does the initial population of the Orderable Items, "
^DIC(9.4,9,22,3.3,"PAH",8,1,20,0)="will be executed in a post-init routine in patch 49, OR*2.5*49, of Order"
^DIC(9.4,9,22,3.3,"PAH",8,1,21,0)="Entry version 2.5.  Routines FHORD, FHORT3, and FHWOR6 have the changes"
^DIC(9.4,9,22,3.3,"PAH",8,1,22,0)="that will update the Orderable Items in file (#101.43).                        "
^DIC(9.4,9,22,3.3,"PAH",8,1,23,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,24,0)="You can install this patch and the routines will not effect the current "
^DIC(9.4,9,22,3.3,"PAH",8,1,25,0)="system of Dietetics or Order Entry.  There will be no Orderable Item file "
^DIC(9.4,9,22,3.3,"PAH",8,1,26,0)="population or update until patch OR*2.5*49 is installed.                       "
^DIC(9.4,9,22,3.3,"PAH",8,1,27,0)="                                         "
^DIC(9.4,9,22,3.3,"PAH",8,1,28,0)="Test Sites                                                                  "
^DIC(9.4,9,22,3.3,"PAH",8,1,29,0)="==========                                                                      "
^DIC(9.4,9,22,3.3,"PAH",8,1,30,0)="                   "
^DIC(9.4,9,22,3.3,"PAH",8,1,31,0)="Tuscaloosa"
^DIC(9.4,9,22,3.3,"PAH",8,1,32,0)="West Palm Beach"
^DIC(9.4,9,22,3.3,"PAH",8,1,33,0)="Puget Sound,"
^DIC(9.4,9,22,3.3,"PAH",8,1,34,0)="Washington D.C."
^DIC(9.4,9,22,3.3,"PAH",8,1,35,0)="                                                                             "
^DIC(9.4,9,22,3.3,"PAH",8,1,36,0)="                                 "
^DIC(9.4,9,22,3.3,"PAH",8,1,37,0)="Routine Summary                                                             "
^DIC(9.4,9,22,3.3,"PAH",8,1,38,0)="===============                                                             "
^DIC(9.4,9,22,3.3,"PAH",8,1,39,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,40,0)="The following routines are included in this patch.  The second line of      "
^DIC(9.4,9,22,3.3,"PAH",8,1,41,0)="these routines should look like:                                         "
^DIC(9.4,9,22,3.3,"PAH",8,1,42,0)="                                                                          "
^DIC(9.4,9,22,3.3,"PAH",8,1,43,0)="<tab>;;5.0;Dietetics;**[patch list]**;Oct 11, 1995                          "
^DIC(9.4,9,22,3.3,"PAH",8,1,44,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,45,0)="          CHECK^XTSUMBLD results                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,46,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,47,0)="Routine Name     Before Patch     After Patch     Patch List                "
^DIC(9.4,9,22,3.3,"PAH",8,1,48,0)="------------     ------------     -----------     ----------               "
^DIC(9.4,9,22,3.3,"PAH",8,1,49,0)="FHORD            1618989          3227945         **12**                    "
^DIC(9.4,9,22,3.3,"PAH",8,1,50,0)="FHORT3           2509939          3722308         **12**                    "
^DIC(9.4,9,22,3.3,"PAH",8,1,51,0)="FHWOR6           N/A              6435773         **12**"
^DIC(9.4,9,22,3.3,"PAH",8,1,52,0)="FHWORI           N/A              3970884         **12**                    "
^DIC(9.4,9,22,3.3,"PAH",8,1,53,0)="FHXOR3           N/A              8083732         **12**                    "
^DIC(9.4,9,22,3.3,"PAH",8,1,54,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,55,0)="General Information                                                         "
^DIC(9.4,9,22,3.3,"PAH",8,1,56,0)="===================                                                         "
^DIC(9.4,9,22,3.3,"PAH",8,1,57,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,58,0)="This patch should be installed into your test UCI then your production UCI."
^DIC(9.4,9,22,3.3,"PAH",8,1,59,0)="The install time should not take more than 10 minutes.  No options need to "
^DIC(9.4,9,22,3.3,"PAH",8,1,60,0)="be disabled.  Users do not need to be off the system.                        "
^DIC(9.4,9,22,3.3,"PAH",8,1,61,0)="  "
^DIC(9.4,9,22,3.3,"PAH",8,1,62,0)="                                                                             "
^DIC(9.4,9,22,3.3,"PAH",8,1,63,0)="  "
^DIC(9.4,9,22,3.3,"PAH",8,1,64,0)="Documentation                                                               "
^DIC(9.4,9,22,3.3,"PAH",8,1,65,0)="=============                                                               "
^DIC(9.4,9,22,3.3,"PAH",8,1,66,0)="                                                                         "
^DIC(9.4,9,22,3.3,"PAH",8,1,67,0)="The documentation for this patch contains in detail the Orderable Item HL7"
^DIC(9.4,9,22,3.3,"PAH",8,1,68,0)="message interface between Dietetics and Order Entry.  Documentation for "
^DIC(9.4,9,22,3.3,"PAH",8,1,69,0)="this patch will be mailed from NCD (National Center for Documentation).  "
^DIC(9.4,9,22,3.3,"PAH",8,1,70,0)="This shipment will contain pages the site can append in the "
^DIC(9.4,9,22,3.3,"PAH",8,1,71,0)="Dietetics Version 5.0 Technical Manual.  These pages are available in a .PDF"
^DIC(9.4,9,22,3.3,"PAH",8,1,72,0)="file in the following IRM Field Offices ANONYMOUS.SOFTWARE directories. "
^DIC(9.4,9,22,3.3,"PAH",8,1,73,0)="                                                                         "
^DIC(9.4,9,22,3.3,"PAH",8,1,74,0)="                       IRM FIELD OFFICE                      FTP Address"
^DIC(9.4,9,22,3.3,"PAH",8,1,75,0)="                       ----------------                      -----------"
^DIC(9.4,9,22,3.3,"PAH",8,1,76,0)="                       Hines                                 152.129.1.110"
^DIC(9.4,9,22,3.3,"PAH",8,1,77,0)="                       Albany                                152.127.1.5"
^DIC(9.4,9,22,3.3,"PAH",8,1,78,0)="                       Salt Lake                             152.131.2.1"
^DIC(9.4,9,22,3.3,"PAH",8,1,79,0)="                                                                          "
^DIC(9.4,9,22,3.3,"PAH",8,1,80,0)="                       FILE"
^DIC(9.4,9,22,3.3,"PAH",8,1,81,0)="                       ----                                              "
^DIC(9.4,9,22,3.3,"PAH",8,1,82,0)="                       FH5_0P12.PDF  "
^DIC(9.4,9,22,3.3,"PAH",8,1,83,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,84,0)="All VAMCs are encouraged to log into TCP/IP host using FTP to obtain it."
^DIC(9.4,9,22,3.3,"PAH",8,1,85,0)="The .PDF file can be read on a PC using the Adobe Acrobat Reader browser"
^DIC(9.4,9,22,3.3,"PAH",8,1,86,0)="program.  The .PDF file is a BINary file, so you must make sure"
^DIC(9.4,9,22,3.3,"PAH",8,1,87,0)="when using the file transfer, to enter the appropriate command for BINary"
^DIC(9.4,9,22,3.3,"PAH",8,1,88,0)="file transfer.                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,89,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,90,0)="If there are any questions, your supporting CIOFO Customer Service"
^DIC(9.4,9,22,3.3,"PAH",8,1,91,0)="Clinical 2 team will address them.                                          "
^DIC(9.4,9,22,3.3,"PAH",8,1,92,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,93,0)="Installation Instructions                                                  "
^DIC(9.4,9,22,3.3,"PAH",8,1,94,0)="=========================                                                   "
^DIC(9.4,9,22,3.3,"PAH",8,1,95,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",8,1,96,0)="This Patch is created with Kernel V8 KIDS.  Follow these instructions:      "
^DIC(9.4,9,22,3.3,"PAH",8,1,97,0)="1) Use Packman option 'INSTALL/CHECK MESSAGE' to load the KIDS build"
^DIC(9.4,9,22,3.3,"PAH",8,1,98,0)="   onto your system.                                                        "
^DIC(9.4,9,22,3.3,"PAH",8,1,99,0)="2) On the KIDS menu, under the 'Installation' menu, use the                 "
^DIC(9.4,9,22,3.3,"PAH",8,1,100,0)="   option 'Verify Checksum in Transport Global' and verify that all         "
^DIC(9.4,9,22,3.3,"PAH",8,1,101,0)="   routines have the correct checksums.                                     "
^DIC(9.4,9,22,3.3,"PAH",8,1,102,0)="3) From the 'Installation' Menu of KIDS, use the option                     "
^DIC(9.4,9,22,3.3,"PAH",8,1,103,0)="   'Install Package(s)'.  Select the package 'FH*5.0*12' and proceed with"
^DIC(9.4,9,22,3.3,"PAH",8,1,104,0)="   install.                                                                 "
^DIC(9.4,9,22,3.3,"PAH",8,1,105,0)="4) On a mapped system, rebuild your map set."
^DIC(9.4,9,22,3.3,"PAH",9,0)="13^2980313^1"
^DIC(9.4,9,22,3.3,"PAH",9,1,0)="^^1^1^2980603^"
^DIC(9.4,9,22,3.3,"PAH",9,1,1,0)="Refer to the patch for the patch description."
^DIC(9.4,9,22,3.3,"PAH",10,0)="14^2980428^1"
^DIC(9.4,9,22,3.3,"PAH",10,1,0)="^^1^1^2980603^"
^DIC(9.4,9,22,3.3,"PAH",10,1,1,0)="Patient Movement Report with Multi-Divisional Format."
^DIC(9.4,9,22,3.3,"PAH",11,0)="17 SEQ #16^2980808^1"
^DIC(9.4,9,22,3.3,"PAH",11,1,0)="^^1^1^2980808"
^DIC(9.4,9,22,3.3,"PAH",11,1,1,0)="Refer to the patch for the patch description."
^DIC(9.4,9,22,3.3,"PAH",12,0)="18^2980924^1"
^DIC(9.4,9,22,3.3,"PAH",13,0)="19^2981007^1"
^DIC(9.4,9,22,3.3,"PAH",13,1,0)="^^1^1^2981007"
^DIC(9.4,9,22,3.3,"PAH",13,1,1,0)="Refer to the patch for the patch description."
^DIC(9.4,9,22,3.3,"PAH",14,0)="20^2981007^1"
^DIC(9.4,9,22,3.3,"PAH",15,0)="21^2981119^1"
^DIC(9.4,9,22,3.3,"PAH",15,1,0)="^^1^1^2981119"
^DIC(9.4,9,22,3.3,"PAH",15,1,1,0)="Refer to the Patch Description."
^DIC(9.4,9,22,3.3,"PAH",16,0)="22^2990119^1"
^DIC(9.4,9,22,3.3,"PAH",17,0)="6^2990416^1"
^DIC(9.4,9,22,3.3,"PAH",17,1,0)="^^247^247^2990416"
^DIC(9.4,9,22,3.3,"PAH",17,1,1,0)="This patch updates the Dietetics System to interact with Order Entry"
^DIC(9.4,9,22,3.3,"PAH",17,1,2,0)="version 3.0 or higher."
^DIC(9.4,9,22,3.3,"PAH",17,1,3,0)="                                                                       "
^DIC(9.4,9,22,3.3,"PAH",17,1,4,0)="This patch will be distributed with Order Entry version 3.0 (CPRS) and"
^DIC(9.4,9,22,3.3,"PAH",17,1,5,0)="it would be installed with Order Entry Version 3.0 or higher.  If your"
^DIC(9.4,9,22,3.3,"PAH",17,1,6,0)="site is a test site of Order Entry 3.0 (CPRS) that is listed in the TEST"
^DIC(9.4,9,22,3.3,"PAH",17,1,7,0)="SITES section, please install this patch so your site will have all the"
^DIC(9.4,9,22,3.3,"PAH",17,1,8,0)="final changes made in the Dietetics routines.                                "
^DIC(9.4,9,22,3.3,"PAH",17,1,9,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",17,1,10,0)="The protocol FHW6 Dietetic Consult will not be converted when OE/RR version "
^DIC(9.4,9,22,3.3,"PAH",17,1,11,0)="3 (CPRS) is installed.  Dietetic Consults should be entered through the "
^DIC(9.4,9,22,3.3,"PAH",17,1,12,0)="Consult/Request Tracking package when OE/RR 3.0 is released.                 "
^DIC(9.4,9,22,3.3,"PAH",17,1,13,0)="                                                                        "
^DIC(9.4,9,22,3.3,"PAH",17,1,14,0)="After the install, a list of 8 routines will be deleted from the"
^DIC(9.4,9,22,3.3,"PAH",17,1,15,0)="site.  The routines are Order Entry 2.5 interface routines.  They"
^DIC(9.4,9,22,3.3,"PAH",17,1,16,0)="are the following:"
^DIC(9.4,9,22,3.3,"PAH",17,1,17,0)="    FHORDW                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,18,0)="    FHORDW1                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,19,0)="    FHORDW2                                                                 "
^DIC(9.4,9,22,3.3,"PAH",17,1,20,0)="    FHORDW3                                                                  "
^DIC(9.4,9,22,3.3,"PAH",17,1,21,0)="    FHORCW                                                                   "
^DIC(9.4,9,22,3.3,"PAH",17,1,22,0)="    FHOREW                                                                   "
^DIC(9.4,9,22,3.3,"PAH",17,1,23,0)="    FHOROW                                                                   "
^DIC(9.4,9,22,3.3,"PAH",17,1,24,0)="    FHORTW                                                            "
^DIC(9.4,9,22,3.3,"PAH",17,1,25,0)="                                                                            "
^DIC(9.4,9,22,3.3,"PAH",17,1,26,0)="Routine FHWWFIX will also be deleted if it wasn't deleted after FH*5*5"
^DIC(9.4,9,22,3.3,"PAH",17,1,27,0)="was installed.                                                              "
^DIC(9.4,9,22,3.3,"PAH",17,1,28,0)="                                                                      "
^DIC(9.4,9,22,3.3,"PAH",17,1,29,0)="A routine, FHXUTL, can be executed by the site to clean up the Dietetics"
^DIC(9.4,9,22,3.3,"PAH",17,1,30,0)="2.5 protocols after the protocols have been converted to Order Dialogs with"
^DIC(9.4,9,22,3.3,"PAH",17,1,31,0)="the Order Entry Version 3."
^DIC(9.4,9,22,3.3,"PAH",17,1,32,0)="                                                                             "
^DIC(9.4,9,22,3.3,"PAH",17,1,33,0)="The following is a sample run:                                                "
^DIC(9.4,9,22,3.3,"PAH",17,1,34,0)="                                                                      "
^DIC(9.4,9,22,3.3,"PAH",17,1,35,0)="D ^FHXUTL                                                               "
^DIC(9.4,9,22,3.3,"PAH",17,1,36,0)="                                                                   "
^DIC(9.4,9,22,3.3,"PAH",17,1,37,0)="Clean up 2.5 Dietetics Protocols...                                         "
^DIC(9.4,9,22,3.3,"PAH",17,1,38,0)="Protocol FHWM Removed From ORADD                                           "
^DIC(9.4,9,22,3.3,"PAH",17,1,39,0)="Protocol FHWPRO1 Removed From OROPRO                                      "
^DIC(9.4,9,22,3.3,"PAH",17,1,40,0)="Protocol FHWMENU Removed From ORZ 39A ADMIT                                "
^DIC(9.4,9,22,3.3,"PAH",17,1,41,0)="Protocol FHW1 Removed From ORZ 84D REORDER/RE-EVALUATION                   "
^DIC(9.4,9,22,3.3,"PAH",17,1,42,0)="Protocol FHWD1 Removed From ORZ ADD MENU 4WEST DOC                        "
^DIC(9.4,9,22,3.3,"PAH",17,1,43,0)="Protocol FHWMENU Removed From ORZ ADD MENU 4WEST DOC                       "
^DIC(9.4,9,22,3.3,"PAH",17,1,44,0)="Protocol FHWD1 Removed From ORZ ADD MENU IKE2                              "
^DIC(9.4,9,22,3.3,"PAH",17,1,45,0)="Protocol FHWMENU Removed From ORZ ADD MENU IKE2                            "
^DIC(9.4,9,22,3.3,"PAH",17,1,46,0)="Protocol FHWD1 Removed From ORZ ADD MENU NHCU DOC                          "
^DIC(9.4,9,22,3.3,"PAH",17,1,47,0)="Protocol FHWMENU Removed From ORZ ADD MENU NHCU DOC                        "
^DIC(9.4,9,22,3.3,"PAH",17,1,48,0)="Protocol FHWD1 Removed From ORZ ADD MENU NURSE                             "
^DIC(9.4,9,22,3.3,"PAH",17,1,49,0)="Protocol FHWMENU Removed From ORZ ADD MENU NURSE                           "
^DIC(9.4,9,22,3.3,"PAH",17,1,50,0)="Protocol FHWD1 Removed From ORZ ADD MENU NURSE NHCU                        "
^DIC(9.4,9,22,3.3,"PAH",17,1,51,0)="Protocol FHWMENU Removed From ORZ ADD MENU NURSE NHCU                      "
^DIC(9.4,9,22,3.3,"PAH",17,1,52,0)="Protocol FHWD1 Removed From ORZ ADD ORDERS DETOX                           "
^DIC(9.4,9,22,3.3,"PAH",17,1,53,0)="Protocol FHWMENU Removed From ORZ ADD ORDERS DETOX                         "
^DIC(9.4,9,22,3.3,"PAH",17,1,54,0)="Protocol FHWN1 Removed From ORZ ADD ORDERS WARD CLERK                      "
