^DIC(9.4,59,22,5,"PAH",137,0)="148^3071212.201326^1"
^DIC(9.4,59,22,5,"PAH",137,1,0)="^^17^17^3071212"
^DIC(9.4,59,22,5,"PAH",137,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",137,1,2,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",137,1,3,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",137,1,4,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",137,1,5,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",137,1,6,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",137,1,7,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",137,1,8,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",137,1,9,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",137,1,10,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",137,1,11,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",137,1,12,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",137,1,13,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",137,1,14,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",137,1,15,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",137,1,16,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",137,1,17,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",138,0)="151 SEQ #138^3071212.201403^1"
^DIC(9.4,59,22,5,"PAH",138,1,0)="^^10^10^3071212"
^DIC(9.4,59,22,5,"PAH",138,1,1,0)="Patch PSN*4*148 inadvertently deleted the GCNSEQNO field (#11) for four"
^DIC(9.4,59,22,5,"PAH",138,1,2,0)="entries in the VA PRODUCT file (#50.68).  This field provides mapping to"
^DIC(9.4,59,22,5,"PAH",138,1,3,0)="patient medication instructions sheets.  The four entries involved are:"
^DIC(9.4,59,22,5,"PAH",138,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",138,1,5,0)="DIGOXIN (LANOXIN) 0.125MG TAB"
^DIC(9.4,59,22,5,"PAH",138,1,6,0)="DIGOXIN (LANOXIN) 0.25MG TAB"
^DIC(9.4,59,22,5,"PAH",138,1,7,0)="DIGOXIN 0.125MG TAB,UD"
^DIC(9.4,59,22,5,"PAH",138,1,8,0)="DIGOXIN 0.25MG TAB,UD"
^DIC(9.4,59,22,5,"PAH",138,1,9,0)="  "
^DIC(9.4,59,22,5,"PAH",138,1,10,0)="This patch restores those fields."
^DIC(9.4,59,22,5,"PAH",139,0)="149^3071212.211345^1"
^DIC(9.4,59,22,5,"PAH",139,1,0)="^^17^17^3071212"
^DIC(9.4,59,22,5,"PAH",139,1,1,0)=" "
