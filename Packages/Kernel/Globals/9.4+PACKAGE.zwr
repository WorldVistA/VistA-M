^DIC(9.4,93,22,21,"PAH",203,1,150,0)="N/A"
^DIC(9.4,93,22,21,"PAH",203,1,151,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,152,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,153,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,93,22,21,"PAH",203,1,154,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,155,0)="1. INC40155755: DBQs are showing as editable in VBMS eFolder"
^DIC(9.4,93,22,21,"PAH",203,1,156,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,157,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,158,0)="---------"
^DIC(9.4,93,22,21,"PAH",203,1,159,0)="For merged templated DBQs transmitted to VBMS, some pages are showing as "
^DIC(9.4,93,22,21,"PAH",203,1,160,0)="editable in VBMS eFolder. While changes can be entered, the user cannot "
^DIC(9.4,93,22,21,"PAH",203,1,161,0)="save any changes."
^DIC(9.4,93,22,21,"PAH",203,1,162,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,163,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,164,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,165,0)="Modified the CAPRI code that was making the PDF flat (read-only) before "
^DIC(9.4,93,22,21,"PAH",203,1,166,0)="transmitting it to VBMS. The code now ensures that all DBQs in the merged "
^DIC(9.4,93,22,21,"PAH",203,1,167,0)="worksheet are set to read-only. Prior to this modification, only the last "
^DIC(9.4,93,22,21,"PAH",203,1,168,0)="DBQ in the merged worksheet was being set to read-only."
^DIC(9.4,93,22,21,"PAH",203,1,169,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,170,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,171,0)="2. INC40032912, INC40054773, INC40070450, INC40076207, INC40293176: "
^DIC(9.4,93,22,21,"PAH",203,1,172,0)="   Partial EDIPI and/or single zero EDIPI value in DBQ XML Header causing"
^DIC(9.4,93,22,21,"PAH",203,1,173,0)="   DBQ transmission to fail reaching VBMS eFolder"
^DIC(9.4,93,22,21,"PAH",203,1,174,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,175,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,176,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,177,0)="Partial EDIPI values are being sent in the DBQ XML Header which is "
^DIC(9.4,93,22,21,"PAH",203,1,178,0)="causing transmission errors. "
^DIC(9.4,93,22,21,"PAH",203,1,179,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,180,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,181,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,182,0)="Modified the CAPRI code to handle RPC returns. If the RPC returns empty, "
^DIC(9.4,93,22,21,"PAH",203,1,183,0)="we replace a null value with ten zeros, if it returns less than ten "
^DIC(9.4,93,22,21,"PAH",203,1,184,0)="characters, we add additional zeros as needed."
^DIC(9.4,93,22,21,"PAH",203,1,185,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,186,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,187,0)="3. INC40104480: Transmission List not Displaying during Failed "
^DIC(9.4,93,22,21,"PAH",203,1,188,0)="   Transmission"
^DIC(9.4,93,22,21,"PAH",203,1,189,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,190,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,191,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,192,0)="On sign out, the user gets an Unsent Transmissions notification when the "
^DIC(9.4,93,22,21,"PAH",203,1,193,0)="site has transmissions that need to be sent. When the user takes the "
^DIC(9.4,93,22,21,"PAH",203,1,194,0)="action to click ""Yes"" on the pop-up the list of transmissions appears to "
^DIC(9.4,93,22,21,"PAH",203,1,195,0)="the user as blank. "
^DIC(9.4,93,22,21,"PAH",203,1,196,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,197,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,198,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,199,0)="Routine DVBCTXML was modified to correctly determine if there was any "
^DIC(9.4,93,22,21,"PAH",203,1,200,0)="qualifying failed transmission that needed to be sent, giving an accurate "
^DIC(9.4,93,22,21,"PAH",203,1,201,0)="count for the pop up notification."
^DIC(9.4,93,22,21,"PAH",203,1,202,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,203,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,204,0)="4. INC40220293: CAPRI Report-CNH Display Error"
^DIC(9.4,93,22,21,"PAH",203,1,205,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,206,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,207,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,208,0)="User Selects CNH Display Episode of Care from the File>Reports and "
^DIC(9.4,93,22,21,"PAH",203,1,209,0)="receives an Application Exception Error"
^DIC(9.4,93,22,21,"PAH",203,1,210,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,211,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,212,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,213,0)="Modified Delphi code to prevent windows from being brought forward when "
^DIC(9.4,93,22,21,"PAH",203,1,214,0)="additional functional code was being executed."
^DIC(9.4,93,22,21,"PAH",203,1,215,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,216,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,217,0)="5. INC40098921, INC40246093, INC40205143: User unable to transmit DBQs, "
^DIC(9.4,93,22,21,"PAH",203,1,218,0)="   receives error ""RPC DVBA CAPRI SAVE EXAM PDF could not be accessed!"
^DIC(9.4,93,22,21,"PAH",203,1,219,0)="   Error encountered."""
^DIC(9.4,93,22,21,"PAH",203,1,220,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,221,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,222,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,223,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,224,0)="Based on the audit and exception logs, it appears that the autosave timer "
^DIC(9.4,93,22,21,"PAH",203,1,225,0)="was calling for a save of the pdfs on the worksheet at the same time that "
^DIC(9.4,93,22,21,"PAH",203,1,226,0)="a FileMan call was being used to clear the open exams in the Signature "
^DIC(9.4,93,22,21,"PAH",203,1,227,0)="Validation window.  "
^DIC(9.4,93,22,21,"PAH",203,1,228,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,229,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,230,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,231,0)="Ensure that the autosave timer on the worksheet is turned off and stays "
^DIC(9.4,93,22,21,"PAH",203,1,232,0)="off when the user is on the Signature Validation window."
^DIC(9.4,93,22,21,"PAH",203,1,233,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,234,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,235,0)="6. INC40098932: Cannot Submit DBQ"
^DIC(9.4,93,22,21,"PAH",203,1,236,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,237,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,238,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,239,0)="AEU is unable to sign off on a template (big or small) because CAPRI "
^DIC(9.4,93,22,21,"PAH",203,1,240,0)="hangs at the Requests Available box and never loads the exam list. This "
^DIC(9.4,93,22,21,"PAH",203,1,241,0)="eventually times out and either crashes or prompts the user to sign in "
^DIC(9.4,93,22,21,"PAH",203,1,242,0)="again and then crashes."
^DIC(9.4,93,22,21,"PAH",203,1,243,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,244,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,245,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,246,0)="Modified code to remove the direct FileMan call that was retrieving a "
^DIC(9.4,93,22,21,"PAH",203,1,247,0)="large amount of unnecessary data."
^DIC(9.4,93,22,21,"PAH",203,1,248,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,249,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,250,0)="7. INC40433009: submitting a 7131 in East Orange Capri will not let me "
^DIC(9.4,93,22,21,"PAH",203,1,251,0)="   select routing location to submit"
^DIC(9.4,93,22,21,"PAH",203,1,252,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,253,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,254,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,255,0)="When using the Edit Exam List Parameters(MAS) tab form will open and "
^DIC(9.4,93,22,21,"PAH",203,1,256,0)="automatically duplicate some of the Division C&P Exam Lists."
^DIC(9.4,93,22,21,"PAH",203,1,257,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,258,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,259,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,260,0)="Modified code to update the direct FileMan call that was retrieving the "
^DIC(9.4,93,22,21,"PAH",203,1,261,0)="wrong IEN value for the comparison of the Division and C&P Exam Lists."
^DIC(9.4,93,22,21,"PAH",203,1,262,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,263,0)="8.  INC34388396: CAPRI transmitting records to wrong VBMS eFolder"
^DIC(9.4,93,22,21,"PAH",203,1,264,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,265,0)="Problem:"
^DIC(9.4,93,22,21,"PAH",203,1,266,0)="--------"
^DIC(9.4,93,22,21,"PAH",203,1,267,0)="Claim Numbers in CAPRI are often blank, or do not identify the correct "
^DIC(9.4,93,22,21,"PAH",203,1,268,0)="Veteran in VBMS. This causes failed transmissions when sending documents "
^DIC(9.4,93,22,21,"PAH",203,1,269,0)="from CAPRI to the VBA eFolder (403 Error). In rare cases, this could "
^DIC(9.4,93,22,21,"PAH",203,1,270,0)="cause documents to be uploaded to an incorrect Veteran's eFolder."
^DIC(9.4,93,22,21,"PAH",203,1,271,0)=" "
^DIC(9.4,93,22,21,"PAH",203,1,272,0)="Resolution:"
^DIC(9.4,93,22,21,"PAH",203,1,273,0)="-----------"
^DIC(9.4,93,22,21,"PAH",203,1,274,0)="VBA eFolder uploads now use identifiers that are constant across CAPRI "
^DIC(9.4,93,22,21,"PAH",203,1,275,0)="and VBMS. Removed Claim Number as the identifier used for sending"
^DIC(9.4,93,22,21,"PAH",203,1,276,0)="documents to the eFolder."
^DIC(9.4,93,22,21,"PAH",203,1,277,0)="Instead, use EDIPI and ICN as identifiers for uploads. These are "
^DIC(9.4,93,22,21,"PAH",203,1,278,0)="constant across CAPRI and VBMS."
^DIC(9.4,93,22,21,"PAH","B",53,50)=""
