^DIC(9.4,4,22,1,"PAH",142,1,3,0)="Test Site:  Dublin, GA"
^DIC(9.4,4,22,1,"PAH",142,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",142,1,5,0)="NOIS: DUB-1099-31240"
^DIC(9.4,4,22,1,"PAH",142,1,6,0)="If you attempt to play a script for a queue which already has a task"
^DIC(9.4,4,22,1,"PAH",142,1,7,0)="associated with it, you could be stuck in an endless warning loop,"
^DIC(9.4,4,22,1,"PAH",142,1,8,0)="if you do not possess the XUPROGMODE key.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",142,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",142,1,10,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",142,1,11,0)="It requires MailMan patch XM*7.1*50."
