^DIC(9.4,4,22,0)="^9.49I^2^2"
^DIC(9.4,4,22,1,0)="7.1^2961030^2960604"
^DIC(9.4,4,22,1,1,0)="^^1^1^2990603"
^DIC(9.4,4,22,1,1,1,0)="Mailman patched through 30 Oct 1996"
^DIC(9.4,4,22,1,"PAH",0)="^9.4901^174^174"
^DIC(9.4,4,22,1,"PAH",1,0)="24^2960606^1"
^DIC(9.4,4,22,1,"PAH",1,1,0)="^^72^72^2960606"
^DIC(9.4,4,22,1,"PAH",1,1,1,0)=" This MailMan patch is in KIDS format.  Please make sure you follow the"
^DIC(9.4,4,22,1,"PAH",1,1,2,0)=" Installation instructions.  This patch contains the following features:"
^DIC(9.4,4,22,1,"PAH",1,1,3,0)=""
^DIC(9.4,4,22,1,"PAH",1,1,4,0)="-PackMan will now be KIDS aware. Patches created after Kernel patch"
^DIC(9.4,4,22,1,"PAH",1,1,5,0)=" XU*8*21 is installed will be able to use Summarize, Print, and Text Print"
^DIC(9.4,4,22,1,"PAH",1,1,6,0)=" options of PackMan. Nois: MAC-1095-60621, ISA-0595-10416."
^DIC(9.4,4,22,1,"PAH",1,1,7,0)="-You can now '^' out of the Print Message option in PackMan, Nois:"
^DIC(9.4,4,22,1,"PAH",1,1,8,0)=" CHY-0595-50665."
^DIC(9.4,4,22,1,"PAH",1,1,9,0)="-Corrects allocation error when XMTEXT is to large and passed to XMB."
^DIC(9.4,4,22,1,"PAH",1,1,10,0)=" Nois: ISW-1195-21138, LEX-0895-42101."
^DIC(9.4,4,22,1,"PAH",1,1,11,0)="-Fixes undefined error in screening logic, Nois: WIM-0196-20064,"
^DIC(9.4,4,22,1,"PAH",1,1,12,0)=" LAS-1295-61714."
^DIC(9.4,4,22,1,"PAH",1,1,13,0)="-The Copy action will now work on a patch in KIDS format."
^DIC(9.4,4,22,1,"PAH",1,1,14,0)="-The Copy action will also copy the date/time of the responses to a"
^DIC(9.4,4,22,1,"PAH",1,1,15,0)=" message.  E3R 7877"
^DIC(9.4,4,22,1,"PAH",1,1,16,0)="  "
^DIC(9.4,4,22,1,"PAH",1,1,17,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",1,1,18,0)=" This patch should be installed after hours, when there is minimum users on"
^DIC(9.4,4,22,1,"PAH",1,1,19,0)=" the system.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",1,1,20,0)="  "
^DIC(9.4,4,22,1,"PAH",1,1,21,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",1,1,22,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",1,1,23,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",1,1,24,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,4,22,1,"PAH",1,1,25,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",1,1,26,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",1,1,27,0)="  3.  Answer NO to the question:"
^DIC(9.4,4,22,1,"PAH",1,1,28,0)="      'Shall I preserve what is on disk in a separate back-up message ?'."
^DIC(9.4,4,22,1,"PAH",1,1,29,0)="  4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",1,1,30,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",1,1,31,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,4,22,1,"PAH",1,1,32,0)="      'Verify Checksum in Transport Global' and verify that all routines"
^DIC(9.4,4,22,1,"PAH",1,1,33,0)="      have the correct checksums."
^DIC(9.4,4,22,1,"PAH",1,1,34,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,4,22,1,"PAH",1,1,35,0)="      'Install Package(s)'. Select the package 'XM*7.1*24' and proceed"
^DIC(9.4,4,22,1,"PAH",1,1,36,0)="      with install."
^DIC(9.4,4,22,1,"PAH",1,1,37,0)="  7.  Answer YES to the question:"
^DIC(9.4,4,22,1,"PAH",1,1,38,0)="      'Want to DISABLE Scheduled Options and Menu Options?'"
^DIC(9.4,4,22,1,"PAH",1,1,39,0)="  8.  Enter XMUSER at the question:"
^DIC(9.4,4,22,1,"PAH",1,1,40,0)="      'Enter options you wish to mark as 'Out Of Order':'"
^DIC(9.4,4,22,1,"PAH",1,1,41,0)="  9.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",1,1,42,0)="      other CPUs?'."
^DIC(9.4,4,22,1,"PAH",1,1,43,0)=" 10.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",1,1,44,0)=" ====================================================================  "
^DIC(9.4,4,22,1,"PAH",1,1,45,0)="  "
^DIC(9.4,4,22,1,"PAH",1,1,46,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",1,1,47,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",1,1,48,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",1,1,49,0)=" "
^DIC(9.4,4,22,1,"PAH",1,1,50,0)=" Name          Checksum          Patch List"
^DIC(9.4,4,22,1,"PAH",1,1,51,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",1,1,52,0)=" XMA2C0        8936155           24"
^DIC(9.4,4,22,1,"PAH",1,1,53,0)=" XMA7G1        1193700           24"
^DIC(9.4,4,22,1,"PAH",1,1,54,0)=" XMAD1         7085638           24"
^DIC(9.4,4,22,1,"PAH",1,1,55,0)=" XMAP          8812311           24"
^DIC(9.4,4,22,1,"PAH",1,1,56,0)=" XMB           7281814           3,7,24"
^DIC(9.4,4,22,1,"PAH",1,1,57,0)=" XMBPOST       6164025           4,13,23,24"
^DIC(9.4,4,22,1,"PAH",1,1,58,0)=" XMP           8440919           4,24"
^DIC(9.4,4,22,1,"PAH",1,1,59,0)=" XMP2          9454113           24"
^DIC(9.4,4,22,1,"PAH",1,1,60,0)=" XMP2A         9900587           24"
^DIC(9.4,4,22,1,"PAH",1,1,61,0)=" XMP3          7025241           24"
^DIC(9.4,4,22,1,"PAH",1,1,62,0)=" "
^DIC(9.4,4,22,1,"PAH",1,1,63,0)=""
^DIC(9.4,4,22,1,"PAH",1,1,64,0)=" ====================================================================="
^DIC(9.4,4,22,1,"PAH",1,1,65,0)=" DATA DICTIONARY:"
^DIC(9.4,4,22,1,"PAH",1,1,66,0)=""
^DIC(9.4,4,22,1,"PAH",1,1,67,0)=" A new code was added to the MESSAGE TYPE field (Set of Codes);"
^DIC(9.4,4,22,1,"PAH",1,1,68,0)=" K for KIDS Distribution."
^DIC(9.4,4,22,1,"PAH",1,1,69,0)=""
^DIC(9.4,4,22,1,"PAH",1,1,70,0)=" FILE:  MESSAGE #3.9"
^DIC(9.4,4,22,1,"PAH",1,1,71,0)=" FIELD: MESSAGE TYPE #1.7"
^DIC(9.4,4,22,1,"PAH",1,1,72,0)=""
^DIC(9.4,4,22,1,"PAH",2,0)="26 SEQ #23^2960606^1"
^DIC(9.4,4,22,1,"PAH",2,1,0)="^^45^45^2960606"
^DIC(9.4,4,22,1,"PAH",2,1,1,0)=" This patch corrects a missing node in bulletins that was introduced"
^DIC(9.4,4,22,1,"PAH",2,1,2,0)=" with patch XM*7.1*24.  NOIS MIN-0396-4104"
^DIC(9.4,4,22,1,"PAH",2,1,3,0)=""
^DIC(9.4,4,22,1,"PAH",2,1,4,0)=" This MailMan patch is in KIDS format.  Please make sure you follow the"
^DIC(9.4,4,22,1,"PAH",2,1,5,0)=" Installation instructions."
^DIC(9.4,4,22,1,"PAH",2,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",2,1,7,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",2,1,8,0)=" This patch should be installed after hours, when there is minimum users on"
^DIC(9.4,4,22,1,"PAH",2,1,9,0)=" the system.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",2,1,10,0)="  "
^DIC(9.4,4,22,1,"PAH",2,1,11,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",2,1,12,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",2,1,13,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",2,1,14,0)="      so you will need to disable mapping for this routine."
^DIC(9.4,4,22,1,"PAH",2,1,15,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",2,1,16,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",2,1,17,0)="  3.  Answer NO to the question:"
^DIC(9.4,4,22,1,"PAH",2,1,18,0)="      'Shall I preserve what is on disk in a separate back-up message ?'."
^DIC(9.4,4,22,1,"PAH",2,1,19,0)="  4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",2,1,20,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",2,1,21,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,4,22,1,"PAH",2,1,22,0)="      'Verify Checksum in Transport Global' and verify that all routines"
^DIC(9.4,4,22,1,"PAH",2,1,23,0)="      have the correct checksums."
^DIC(9.4,4,22,1,"PAH",2,1,24,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,4,22,1,"PAH",2,1,25,0)="      'Install Package(s)'. Select the package 'XM*7.1*26' and proceed"
^DIC(9.4,4,22,1,"PAH",2,1,26,0)="      with install."
^DIC(9.4,4,22,1,"PAH",2,1,27,0)="  7.  Answer YES to the question:"
^DIC(9.4,4,22,1,"PAH",2,1,28,0)="      'Want to DISABLE Scheduled Options and Menu Options?'"
^DIC(9.4,4,22,1,"PAH",2,1,29,0)="  8.  Enter XMUSER at the question:"
^DIC(9.4,4,22,1,"PAH",2,1,30,0)="      'Enter options you wish to mark as 'Out Of Order':'"
^DIC(9.4,4,22,1,"PAH",2,1,31,0)="  9.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",2,1,32,0)="      other CPUs?'."
^DIC(9.4,4,22,1,"PAH",2,1,33,0)=" 10.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",2,1,34,0)=" ====================================================================  "
^DIC(9.4,4,22,1,"PAH",2,1,35,0)="  "
^DIC(9.4,4,22,1,"PAH",2,1,36,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",2,1,37,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",2,1,38,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",2,1,39,0)=" "
^DIC(9.4,4,22,1,"PAH",2,1,40,0)=" Name          Checksum          Patch List"
^DIC(9.4,4,22,1,"PAH",2,1,41,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",2,1,42,0)=" XMB           7219230           3,7,24,26"
^DIC(9.4,4,22,1,"PAH",2,1,43,0)=" "
^DIC(9.4,4,22,1,"PAH",2,1,44,0)=""
^DIC(9.4,4,22,1,"PAH",2,1,45,0)=""
^DIC(9.4,4,22,1,"PAH",3,0)="25 SEQ #24^2960606^1"
^DIC(9.4,4,22,1,"PAH",3,1,0)="^^43^43^2960606"
^DIC(9.4,4,22,1,"PAH",3,1,1,0)=""
^DIC(9.4,4,22,1,"PAH",3,1,2,0)=" This MailMan patch is in KIDS format.  Please make sure you follow the"
^DIC(9.4,4,22,1,"PAH",3,1,3,0)=" Installation instructions.  This patch corrects an error with the TCP/IP"
^DIC(9.4,4,22,1,"PAH",3,1,4,0)=" poller, on the NT machine, that was introduced with Kernel patch 18,"
^DIC(9.4,4,22,1,"PAH",3,1,5,0)=" XU*8.0*18. NOIS: WRJ-0396-10453"
^DIC(9.4,4,22,1,"PAH",3,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",3,1,7,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",3,1,8,0)=" This patch can be installed with users on the system. This patch will only"
^DIC(9.4,4,22,1,"PAH",3,1,9,0)=" install 1 routine, XMRTCP. You must move the routine to your NT machine and"
^DIC(9.4,4,22,1,"PAH",3,1,10,0)=" then reboot MSM on the NT machine.  This will restart the TCP/IP poller."
^DIC(9.4,4,22,1,"PAH",3,1,11,0)="  "
^DIC(9.4,4,22,1,"PAH",3,1,12,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",3,1,13,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",3,1,14,0)="  1.  This routine might be mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",3,1,15,0)="      so you will need to disable mapping for the routine."
^DIC(9.4,4,22,1,"PAH",3,1,16,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",3,1,17,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",3,1,18,0)="  3.  Answer NO to the question:"
^DIC(9.4,4,22,1,"PAH",3,1,19,0)="      'Shall I preserve what is on disk in a separate back-up message ?'."
^DIC(9.4,4,22,1,"PAH",3,1,20,0)="  4.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",3,1,21,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",3,1,22,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,4,22,1,"PAH",3,1,23,0)="      'Verify Checksum in Transport Global' and verify that all routines"
^DIC(9.4,4,22,1,"PAH",3,1,24,0)="      have the correct checksums."
^DIC(9.4,4,22,1,"PAH",3,1,25,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the option "
^DIC(9.4,4,22,1,"PAH",3,1,26,0)="      'Install Package(s)'. Select the package 'XM*7.1*25' and proceed"
^DIC(9.4,4,22,1,"PAH",3,1,27,0)="      with install."
^DIC(9.4,4,22,1,"PAH",3,1,28,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",3,1,29,0)="      other CPUs?'."
^DIC(9.4,4,22,1,"PAH",3,1,30,0)="  8.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",3,1,31,0)="  9.  MSM Sites, after patch has installed, move the routine XMRTCP to"
^DIC(9.4,4,22,1,"PAH",3,1,32,0)="      your NT machine.  Then reboot MSM on the NT machine, this will"
^DIC(9.4,4,22,1,"PAH",3,1,33,0)="      restart the TCP/IP mail poller."
^DIC(9.4,4,22,1,"PAH",3,1,34,0)=" ====================================================================  "
^DIC(9.4,4,22,1,"PAH",3,1,35,0)="  "
^DIC(9.4,4,22,1,"PAH",3,1,36,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",3,1,37,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",3,1,38,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",3,1,39,0)=" "
^DIC(9.4,4,22,1,"PAH",3,1,40,0)=" Name          Checksum          Patch List"
^DIC(9.4,4,22,1,"PAH",3,1,41,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",3,1,42,0)=" XMRTCP        2975517           8,25"
^DIC(9.4,4,22,1,"PAH",3,1,43,0)=""
^DIC(9.4,4,22,1,"PAH",4,0)="29 SEQ #25^2960812^1"
^DIC(9.4,4,22,1,"PAH",4,1,0)="^^51^51^2960812"
^DIC(9.4,4,22,1,"PAH",4,1,1,0)=" This Mailman patch will set the vaporization date for messages that are"
^DIC(9.4,4,22,1,"PAH",4,1,2,0)=" distributed via the XMYB-BROADCAST-VA-WIDE Server Option, for example, "
^DIC(9.4,4,22,1,"PAH",4,1,3,0)=" Secretary Brown's Daily Message. The vaporization date is set only if"
^DIC(9.4,4,22,1,"PAH",4,1,4,0)=" the message stays in the users IN BASKET. If a user saves the message to"
^DIC(9.4,4,22,1,"PAH",4,1,5,0)=" another Basket, the vaporization date is not maintained. A user can enter"
^DIC(9.4,4,22,1,"PAH",4,1,6,0)=" a new vaporization date by entering 'V' at the 'MESSAGE Action' prompt."
^DIC(9.4,4,22,1,"PAH",4,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",4,1,8,0)=" This patch will not effect broadcast messages that originate locally, but "
^DIC(9.4,4,22,1,"PAH",4,1,9,0)=" only those originated from FORUM. The vaporization date is depended on how"
^DIC(9.4,4,22,1,"PAH",4,1,10,0)=" the parameter is set in the Routine field for the XMYB-BROADCAST-VA-WIDE"
^DIC(9.4,4,22,1,"PAH",4,1,11,0)=" Option."
^DIC(9.4,4,22,1,"PAH",4,1,12,0)=" "
^DIC(9.4,4,22,1,"PAH",4,1,13,0)=" Case #1 - if Routine field looks like: ENT^XMGAPI3(""*""), this means"
^DIC(9.4,4,22,1,"PAH",4,1,14,0)=" that the message was sent to ALL mail users, then the Vaporization date"
^DIC(9.4,4,22,1,"PAH",4,1,15,0)=" will be set to T+7."
^DIC(9.4,4,22,1,"PAH",4,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",4,1,17,0)=" Case #2 - if the Routine entry looks like: ENT^XMAPI3("".6""), this means"
^DIC(9.4,4,22,1,"PAH",4,1,18,0)=" that the message was sent to *just* SHARED MAIL's IN BASKET, then the"
^DIC(9.4,4,22,1,"PAH",4,1,19,0)=" Vaporization date will be set to T+30."
^DIC(9.4,4,22,1,"PAH",4,1,20,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",4,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",4,1,22,0)=" This patch can be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",4,1,23,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",4,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",4,1,25,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",4,1,26,0)="  1.  This routine is usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",4,1,27,0)="      so you will need to disable mapping for the effected routine."
^DIC(9.4,4,22,1,"PAH",4,1,28,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",4,1,29,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",4,1,30,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",4,1,31,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",4,1,32,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",4,1,33,0)="      options:"
^DIC(9.4,4,22,1,"PAH",4,1,34,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",4,1,35,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",4,1,36,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",4,1,37,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",4,1,38,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",4,1,39,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",4,1,40,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",4,1,41,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",4,1,42,0)="===========================================================================  "
^DIC(9.4,4,22,1,"PAH",4,1,43,0)="  "
^DIC(9.4,4,22,1,"PAH",4,1,44,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",4,1,45,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",4,1,46,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",4,1,47,0)=" "
^DIC(9.4,4,22,1,"PAH",4,1,48,0)=" Name          Checksum          Patch List"
^DIC(9.4,4,22,1,"PAH",4,1,49,0)=" ----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",4,1,50,0)=" XMGAPI3        2791662           29"
^DIC(9.4,4,22,1,"PAH",4,1,51,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",5,0)="27 SEQ #26^2961028^1"
^DIC(9.4,4,22,1,"PAH",5,1,0)="^^174^174^2961028"
^DIC(9.4,4,22,1,"PAH",5,1,1,0)=" This MailMan patch is dependent on Kernel patch XU*8*24, which should"
^DIC(9.4,4,22,1,"PAH",5,1,2,0)=" be installed before this patch.  This patch contains the following bug"
^DIC(9.4,4,22,1,"PAH",5,1,3,0)=" fixes and features:"
^DIC(9.4,4,22,1,"PAH",5,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,5,0)="-Sites getting errors with TCP/IP mail in ^XMC1A. Nois NCH-0696-41098,"
^DIC(9.4,4,22,1,"PAH",5,1,6,0)=" WNY-0696-10208, & BRX-0696-11028."
^DIC(9.4,4,22,1,"PAH",5,1,7,0)="-The date/time of original message is added to a copied message."
^DIC(9.4,4,22,1,"PAH",5,1,8,0)="-The 'TCP/IP POLLER RUN FLAG' in file 4.3 is cleared when poller is"
^DIC(9.4,4,22,1,"PAH",5,1,9,0)=" restarted."
^DIC(9.4,4,22,1,"PAH",5,1,10,0)="-Transmission scripts were not switching over. Nois BRX-0496-10709 &"
^DIC(9.4,4,22,1,"PAH",5,1,11,0)=" ALB-0596-51476."
^DIC(9.4,4,22,1,"PAH",5,1,12,0)="-XMDUZ is undefined when receiving mail. Nois IVM-0896-31669."
^DIC(9.4,4,22,1,"PAH",5,1,13,0)="-Statistics was not collecting Response time. Nois DAY-0596-40308."
^DIC(9.4,4,22,1,"PAH",5,1,14,0)="-XMB will now 'NEW X'. Nois MEM-0496-70250, MIN-0396-42065, &"
^DIC(9.4,4,22,1,"PAH",5,1,15,0)=" NAS-0496-30171."
^DIC(9.4,4,22,1,"PAH",5,1,16,0)="-Change the header of the statistics report, 'Last Sign On' is now"
^DIC(9.4,4,22,1,"PAH",5,1,17,0)=" 'Last Mail Use'. Nois DAY-0196-41801."
^DIC(9.4,4,22,1,"PAH",5,1,18,0)="-Undefined error on Headerless print of messages. Nois BRX-0196-10570."
^DIC(9.4,4,22,1,"PAH",5,1,19,0)="-Subscript errors from internet messages when the address is to long."
^DIC(9.4,4,22,1,"PAH",5,1,20,0)=" Nois HIN-0296-41163."
^DIC(9.4,4,22,1,"PAH",5,1,21,0)="-More information is being recorded in the MESSAGE STATISTICS file,"
^DIC(9.4,4,22,1,"PAH",5,1,22,0)=" # 4.2999. This will help with debugging transmission scripts."
^DIC(9.4,4,22,1,"PAH",5,1,23,0)="-A new Option 'Toggle a script out of service' can be used to place a"
^DIC(9.4,4,22,1,"PAH",5,1,24,0)=" Transmission Script out of service and requeue the domain."
^DIC(9.4,4,22,1,"PAH",5,1,25,0)="-MM now uses the new M95 Error trap in DSM. This change and the updating"
^DIC(9.4,4,22,1,"PAH",5,1,26,0)=" of the Taskman Error Screening should prevent numerous disconnect error from"
^DIC(9.4,4,22,1,"PAH",5,1,27,0)=" showing up in your error trap."
^DIC(9.4,4,22,1,"PAH",5,1,28,0)="-Purge by date was not purging Internet messages. Nois HIN-0896-40170 and"
^DIC(9.4,4,22,1,"PAH",5,1,29,0)=" PHO-0796-60127"
^DIC(9.4,4,22,1,"PAH",5,1,30,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",5,1,31,0)=" *** You MUST install Kernel patch XU*8*24 before installing this patch ***"
^DIC(9.4,4,22,1,"PAH",5,1,32,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,33,0)=" This patch should be installed after hours, when there is minimum users on"
^DIC(9.4,4,22,1,"PAH",5,1,34,0)=" the system.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",5,1,35,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,36,0)=" MSM Sites: The routine XMRTCP must be moved to your NT machine and then"
^DIC(9.4,4,22,1,"PAH",5,1,37,0)=" reboot MSM on the NT machine.  This will restart the TCP/IP poller."
^DIC(9.4,4,22,1,"PAH",5,1,38,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",5,1,39,0)=""
^DIC(9.4,4,22,1,"PAH",5,1,40,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",5,1,41,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,4,22,1,"PAH",5,1,42,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,4,22,1,"PAH",5,1,43,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,4,22,1,"PAH",5,1,44,0)="      option will load the KIDS package onto your system."
^DIC(9.4,4,22,1,"PAH",5,1,45,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,4,22,1,"PAH",5,1,46,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,4,22,1,"PAH",5,1,47,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,4,22,1,"PAH",5,1,48,0)="      options:"
^DIC(9.4,4,22,1,"PAH",5,1,49,0)="         Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",5,1,50,0)="         Print Transport Global"
^DIC(9.4,4,22,1,"PAH",5,1,51,0)="         Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",5,1,52,0)="         Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",5,1,53,0)="         Install Package(s)"
^DIC(9.4,4,22,1,"PAH",5,1,54,0)="  5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",5,1,55,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",5,1,56,0)="  6.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",5,1,57,0)="===========================================================================  "
^DIC(9.4,4,22,1,"PAH",5,1,58,0)="  "
^DIC(9.4,4,22,1,"PAH",5,1,59,0)=" ROUTINES:"
^DIC(9.4,4,22,1,"PAH",5,1,60,0)="   The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",5,1,61,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",5,1,62,0)=" "
