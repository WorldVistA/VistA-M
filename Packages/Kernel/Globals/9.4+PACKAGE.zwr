^DIC(9.4,14,22,5.9,"PAH",274,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",274,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",275,0)="473 SEQ #373^3161028.150651^54"
