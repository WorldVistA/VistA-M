^DIC(9.4,3,22,21,"PAH",199,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,64,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",199,1,65,0)="============================="
^DIC(9.4,3,22,21,"PAH",199,1,66,0)="Clearance - 4/5/2002"
^DIC(9.4,3,22,21,"PAH",199,1,67,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,68,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,69,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",199,1,70,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,71,0)="     1.   Users ARE allowed to be on the system during the"
^DIC(9.4,3,22,21,"PAH",199,1,72,0)="     installation."
^DIC(9.4,3,22,21,"PAH",199,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,74,0)="     2.   DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",199,1,75,0)="     so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",199,1,76,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,77,0)="     3.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,3,22,21,"PAH",199,1,78,0)="     This option will load the KIDS (Kernel Installation and Distribution"
^DIC(9.4,3,22,21,"PAH",199,1,79,0)="     System) package onto your system."
^DIC(9.4,3,22,21,"PAH",199,1,80,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,81,0)="     4.   You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",199,1,82,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,83,0)="     5.   The patch has now been loaded into a transport global on your"
^DIC(9.4,3,22,21,"PAH",199,1,84,0)="     system.  On the KIDS menu, select the 'Installation' menu and use"
^DIC(9.4,3,22,21,"PAH",199,1,85,0)="     the following options:"
^DIC(9.4,3,22,21,"PAH",199,1,86,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",199,1,87,0)="           Print Transport Global"
^DIC(9.4,3,22,21,"PAH",199,1,88,0)="           Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",199,1,89,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",199,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,91,0)="           Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",199,1,92,0)="           Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",199,1,93,0)="                               ======="
^DIC(9.4,3,22,21,"PAH",199,1,94,0)="            Install Package(s)"
^DIC(9.4,3,22,21,"PAH",199,1,95,0)="            Select INSTALL NAME: XU*8.0*174"
^DIC(9.4,3,22,21,"PAH",199,1,96,0)="                                 =========="
^DIC(9.4,3,22,21,"PAH",199,1,97,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,98,0)="        Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES//"
^DIC(9.4,3,22,21,"PAH",199,1,99,0)="        NO "
^DIC(9.4,3,22,21,"PAH",199,1,100,0)="        =="
^DIC(9.4,3,22,21,"PAH",199,1,101,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",199,1,102,0)="                                                              =="
^DIC(9.4,3,22,21,"PAH",199,1,103,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,3,22,21,"PAH",199,1,104,0)="        YES// NO"
^DIC(9.4,3,22,21,"PAH",199,1,105,0)="              =="
^DIC(9.4,3,22,21,"PAH",199,1,106,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,107,0)="     6.  AXP Sites - Answer 'NO' to the question 'Want to MOVE"
^DIC(9.4,3,22,21,"PAH",199,1,108,0)="     routines to other CPUs?'."
^DIC(9.4,3,22,21,"PAH",199,1,109,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,110,0)="     7.  If the routines were unmapped as part of step 2, they should be"
^DIC(9.4,3,22,21,"PAH",199,1,111,0)="     returned to the mapped set once the installation has run to"
^DIC(9.4,3,22,21,"PAH",199,1,112,0)="     completion."
^DIC(9.4,3,22,21,"PAH",200,0)="238 SEQ #207^3020927^1"
^DIC(9.4,3,22,21,"PAH",200,1,0)="^^90^90^3020927"
^DIC(9.4,3,22,21,"PAH",200,1,1,0)="This patch removes a command that is not necessary and conflicts with "
^DIC(9.4,3,22,21,"PAH",200,1,2,0)="the M-to-M Broker."
^DIC(9.4,3,22,21,"PAH",200,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,4,0)="Other than removing this one command, this patch is equivalent to "
^DIC(9.4,3,22,21,"PAH",200,1,5,0)="XU*8*234.  For those sites which do not install various packages, e.g., "
^DIC(9.4,3,22,21,"PAH",200,1,6,0)="CMOP, etc., this patch may be installed without installation of patch "
^DIC(9.4,3,22,21,"PAH",200,1,7,0)="XU*8*234 (which was released as a part of YS*5.01*71).  However, if "
^DIC(9.4,3,22,21,"PAH",200,1,8,0)="such a site subsequently installs XU*8*234 after this patch, this patch "
^DIC(9.4,3,22,21,"PAH",200,1,9,0)="should be installed again."
^DIC(9.4,3,22,21,"PAH",200,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,12,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",200,1,13,0)="============================="
^DIC(9.4,3,22,21,"PAH",200,1,14,0)="  Clearance - Aug 28, 2002"
^DIC(9.4,3,22,21,"PAH",200,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,16,0)="Thanks To Test Sites:"
^DIC(9.4,3,22,21,"PAH",200,1,17,0)="====================="
^DIC(9.4,3,22,21,"PAH",200,1,18,0)="  Clarksburg, WV"
^DIC(9.4,3,22,21,"PAH",200,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,22,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",200,1,23,0)="================"
^DIC(9.4,3,22,21,"PAH",200,1,24,0)="The following routine is included in this patch.  The second"
^DIC(9.4,3,22,21,"PAH",200,1,25,0)="line of this routine now looks like:"
^DIC(9.4,3,22,21,"PAH",200,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,27,0)="     <tab>;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",200,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,29,0)="Checksums:"
^DIC(9.4,3,22,21,"PAH",200,1,30,0)="=========="
^DIC(9.4,3,22,21,"PAH",200,1,31,0)="Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",200,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,33,0)=" Rtn Nm    Chksum Before   Chksum After    Patch List"
^DIC(9.4,3,22,21,"PAH",200,1,34,0)=" ------    -------------   ------------    ----------"
^DIC(9.4,3,22,21,"PAH",200,1,35,0)=" XUSRB           8323600*       8315324    **11,16,28,32,59,70,82"
^DIC(9.4,3,22,21,"PAH",200,1,36,0)="                                             109,115,165,150,180"
^DIC(9.4,3,22,21,"PAH",200,1,37,0)="                                             213,234,238**"
^DIC(9.4,3,22,21,"PAH",200,1,38,0)="                                             "
^DIC(9.4,3,22,21,"PAH",200,1,39,0)="*If patch XU*8*234, which was released as a part of patch YS*5.01*71,is "
^DIC(9.4,3,22,21,"PAH",200,1,40,0)="NOT installed (not required for this patch) the Chksum Before would be "
^DIC(9.4,3,22,21,"PAH",200,1,41,0)="8143764."
^DIC(9.4,3,22,21,"PAH",200,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,43,0)="List of preceding patches: 213 (234 may be installed as well)"
^DIC(9.4,3,22,21,"PAH",200,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,46,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",200,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,48,0)="     1.   Users ARE allowed to be on the system during the "
^DIC(9.4,3,22,21,"PAH",200,1,49,0)="     installation.  However, you should select a time when minimal"
^DIC(9.4,3,22,21,"PAH",200,1,50,0)="     users are on the system.  Installation of this patch may affect "
^DIC(9.4,3,22,21,"PAH",200,1,51,0)="     users who are just connecting from a client application with "
^DIC(9.4,3,22,21,"PAH",200,1,52,0)="     RPCBroker."
^DIC(9.4,3,22,21,"PAH",200,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,54,0)="     2.   DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",200,1,55,0)="     so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",200,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,57,0)="     3.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,3,22,21,"PAH",200,1,58,0)="     This option will load the KIDS (Kernel Installation and Distribution "
^DIC(9.4,3,22,21,"PAH",200,1,59,0)="     System) package onto your system."
^DIC(9.4,3,22,21,"PAH",200,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,61,0)="     4.   You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",200,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,63,0)="     5.   The patch has now been loaded into a transport global on your "
^DIC(9.4,3,22,21,"PAH",200,1,64,0)="     system.  On the KIDS menu, select the 'Installation' menu and use"
^DIC(9.4,3,22,21,"PAH",200,1,65,0)="     the following options: "
^DIC(9.4,3,22,21,"PAH",200,1,66,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",200,1,67,0)="           Print Transport Global "
^DIC(9.4,3,22,21,"PAH",200,1,68,0)="           Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",200,1,69,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",200,1,70,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,71,0)="           Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",200,1,72,0)="           Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",200,1,73,0)="                               ======="
^DIC(9.4,3,22,21,"PAH",200,1,74,0)="            Install Package(s) "
^DIC(9.4,3,22,21,"PAH",200,1,75,0)="            Select INSTALL NAME: XU*8.0*238"
^DIC(9.4,3,22,21,"PAH",200,1,76,0)="                                 =========="
^DIC(9.4,3,22,21,"PAH",200,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,78,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,79,0)="         Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",200,1,80,0)="                                                               =="
^DIC(9.4,3,22,21,"PAH",200,1,81,0)="         Want to DISABLE Scheduled Options, Menu Options, and Protocols? "
^DIC(9.4,3,22,21,"PAH",200,1,82,0)=" YES// NO"
^DIC(9.4,3,22,21,"PAH",200,1,83,0)="       =="
^DIC(9.4,3,22,21,"PAH",200,1,84,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,85,0)="     6.  AXP Sites - Answer 'NO' to the question 'Want to MOVE "
^DIC(9.4,3,22,21,"PAH",200,1,86,0)="     routines to other CPUs?'."
^DIC(9.4,3,22,21,"PAH",200,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",200,1,88,0)="     7.  If the routines were unmapped as part of step 2, they should be "
^DIC(9.4,3,22,21,"PAH",200,1,89,0)="     returned to the mapped set once the installation has run to "
^DIC(9.4,3,22,21,"PAH",200,1,90,0)="     completion."
