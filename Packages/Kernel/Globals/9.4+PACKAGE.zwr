^DIC(9.4,4,22,2,"PAH",21,1,57,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",21,1,58,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",22,0)="22 SEQ #22^3040330^1"
^DIC(9.4,4,22,2,"PAH",22,1,0)="^^164^164^3040330"
^DIC(9.4,4,22,2,"PAH",22,1,1,0)="            * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,4,22,2,"PAH",22,1,2,0)="                    !! A T T E N T I O N !!"
^DIC(9.4,4,22,2,"PAH",22,1,3,0)="            You must manually CHECK entries in the"
^DIC(9.4,4,22,2,"PAH",22,1,4,0)="                       DEVICE FILE and"
^DIC(9.4,4,22,2,"PAH",22,1,5,0)="                 COMMUNICATIONS PROTOCOL FILE"
^DIC(9.4,4,22,2,"PAH",22,1,6,0)="                and CORRECT them, if necessary."
^DIC(9.4,4,22,2,"PAH",22,1,7,0)="                       See instructions."
^DIC(9.4,4,22,2,"PAH",22,1,8,0)="            * * * * * * * * * * * * * * * * * * * *"
^DIC(9.4,4,22,2,"PAH",22,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,10,0)="Patch XM*8.0*22"
^DIC(9.4,4,22,2,"PAH",22,1,11,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,12,0)="NOIS: CMC-0803-31054"
^DIC(9.4,4,22,2,"PAH",22,1,13,0)="Test Sites: Tennessee Valley HCS (DSM/VMS); Murfreesboro CMOP (Cache/NT);"
^DIC(9.4,4,22,2,"PAH",22,1,14,0)="            Charleston CMOP (Cache/NT); Portland, OR (Cache/VMS)"
^DIC(9.4,4,22,2,"PAH",22,1,15,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,16,0)="Attempts to use the option Sequential Media Queue Transmission"
^DIC(9.4,4,22,2,"PAH",22,1,17,0)="[XMS-SEQ-TRANSMIT] fail with the variable ER undefined."
^DIC(9.4,4,22,2,"PAH",22,1,18,0)="This patch fixes that."
^DIC(9.4,4,22,2,"PAH",22,1,19,0)=" "
^DIC(9.4,4,22,2,"PAH",22,1,20,0)="IMPORTANT: If you are using the HFS device to receive the mail, you should"
^DIC(9.4,4,22,2,"PAH",22,1,21,0)="either have an HFS_IN device with the Open Parameter set to ReadOnly or set"
^DIC(9.4,4,22,2,"PAH",22,1,22,0)="the ASK HFS I/O OPERATION to YES and choose READONLY when using the device."
^DIC(9.4,4,22,2,"PAH",22,1,23,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,24,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",22,1,25,0)="is at a minimum.  It has no patch pre-requisites."
^DIC(9.4,4,22,2,"PAH",22,1,26,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",22,1,27,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,28,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",22,1,29,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",22,1,30,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",22,1,31,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,32,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",22,1,33,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",22,1,34,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",22,1,35,0)="XMCB           3553056         3880657        22"
