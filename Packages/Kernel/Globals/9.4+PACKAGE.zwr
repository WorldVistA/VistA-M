^DIC(9.4,165,22,1,"PAH",48,0)="57^3030924^1"
^DIC(9.4,165,22,1,"PAH",49,0)="56 SEQ #50^3031002^1"
^DIC(9.4,165,22,1,"PAH",49,1,0)="^^1^1^3031002"
^DIC(9.4,165,22,1,"PAH",49,1,1,0)="Update National Clinic File (#728.441) codes for FY2004"
^DIC(9.4,165,22,1,"PAH",50,0)="50 SEQ #51^3031023^1"
^DIC(9.4,165,22,1,"PAH",50,1,0)="^^2^2^3031023"
^DIC(9.4,165,22,1,"PAH",50,1,1,0)="This patch addresses the problem of the admission date field (36) storing "
^DIC(9.4,165,22,1,"PAH",50,1,2,0)="the wrong admission date in Surgery Extract (727.811;36)."
^DIC(9.4,165,22,1,"PAH",51,0)="49^3031110^1"
^DIC(9.4,165,22,1,"PAH",52,0)="51 SEQ #54^3031231^1"
^DIC(9.4,165,22,1,"PAH",53,0)="58 SEQ #56^3031231^1"
^DIC(9.4,165,22,1,"PAH",54,0)="66 SEQ #57^3040131^1"
^DIC(9.4,165,22,1,"PAH",55,0)="62 SEQ #58^3040131^1"
^DIC(9.4,165,22,1,"PAH",56,0)="54 SEQ #55^3040131^1"
^DIC(9.4,165,22,1,"PAH",57,0)="55 SEQ #59^3040302^1"
^DIC(9.4,165,22,1,"PAH",57,1,0)="^^3^3^3040302"
^DIC(9.4,165,22,1,"PAH",57,1,1,0)="This patch addresses the problem when an inquiry is made to DSS"
^DIC(9.4,165,22,1,"PAH",57,1,2,0)="Mental Health Tests (727.5) file thru Fileman. The data for the"
^DIC(9.4,165,22,1,"PAH",57,1,3,0)="Test Name field (.01) is not being displayed."
^DIC(9.4,165,22,1,"PAH",58,0)="64 SEQ #60^3040302^1"
^DIC(9.4,165,22,1,"PAH",58,1,0)="^^5^5^3040302"
^DIC(9.4,165,22,1,"PAH",58,1,1,0)=" "
^DIC(9.4,165,22,1,"PAH",58,1,2,0)="The QUASAR Extract [ECXQSR] is incorrectly pulling invalid provider"
^DIC(9.4,165,22,1,"PAH",58,1,3,0)="numbers from the QUASAR A&SP Visit File.  The extract is pulling the A&SP"
^DIC(9.4,165,22,1,"PAH",58,1,4,0)="provider without using the A&SP provider pointer logic resulting in an"
^DIC(9.4,165,22,1,"PAH",58,1,5,0)="invalid NEW PERSON file lookup."
^DIC(9.4,165,22,1,"PAH",59,0)="60 SEQ #61^3040330^1"
^DIC(9.4,165,22,1,"PAH",59,1,0)="^^7^7^3040330"
^DIC(9.4,165,22,1,"PAH",59,1,1,0)="The DSS Clinics and StopCodes Worksheet file (#728.44) data entry "
^DIC(9.4,165,22,1,"PAH",59,1,2,0)="currently allows invalid Stop Code values and it should not.  It allows "
^DIC(9.4,165,22,1,"PAH",59,1,3,0)="them to be entered into the DSS Stop Code and the DSS Credit Stop Code "
^DIC(9.4,165,22,1,"PAH",59,1,4,0)="fields.  During data entry both these fields should be checked against "
^DIC(9.4,165,22,1,"PAH",59,1,5,0)="valid stop codes in the Clinic Stop file (#40.7) and not allow entry of a "
^DIC(9.4,165,22,1,"PAH",59,1,6,0)="stopcode that does not exist in file #40.7, but instead give an error "
^DIC(9.4,165,22,1,"PAH",59,1,7,0)="message when that occurs."
^DIC(9.4,165,22,1,"PAH",60,0)="65 SEQ #62^3040330^1"
^DIC(9.4,165,22,1,"PAH",60,1,0)="^^2^2^3040330"
^DIC(9.4,165,22,1,"PAH",60,1,1,0)="Fix for problem of picking up incorrect losing ward for Discharge While "
^DIC(9.4,165,22,1,"PAH",60,1,2,0)="ASIH type discharge records in MOV Extract."
^DIC(9.4,165,22,1,"PAH",61,0)="67 SEQ #63^3040427^1"
^DIC(9.4,165,22,1,"PAH",61,1,0)="^^1^1^3040427"
^DIC(9.4,165,22,1,"PAH",61,1,1,0)="Review Extract for Transmission not working. "
^DIC(9.4,165,22,1,"PAH",62,0)="70 SEQ #64^3040802^1"
^DIC(9.4,165,22,1,"PAH",62,1,0)="^^1^1^3040802"
^DIC(9.4,165,22,1,"PAH",62,1,1,0)="Fix for duplicate observation encounters in the Laboratory Extract."
^DIC(9.4,165,22,1,"PAH",63,0)="68 SEQ #65^3040903^1"
^DIC(9.4,165,22,1,"PAH",63,1,0)="^^5^5^3040903"
^DIC(9.4,165,22,1,"PAH",63,1,1,0)="Add 'S' prefixed NDC codes to Pharmacy Extracts Incomplete Feeder Key"
^DIC(9.4,165,22,1,"PAH",63,1,2,0)="Report, update YEAR MONTH field definition for the Clinic "
^DIC(9.4,165,22,1,"PAH",63,1,3,0)="Extract file, identify inactive divisions in division selection list for "
^DIC(9.4,165,22,1,"PAH",63,1,4,0)="the Surgery Extract Audit Report, update DSS documentation with "
^DIC(9.4,165,22,1,"PAH",63,1,5,0)="global journaling recommendation."
^DIC(9.4,165,22,1,"PAH",64,0)="52 SEQ #66^3041029^1"
^DIC(9.4,165,22,1,"PAH",64,1,0)="^^2^2^3041029"
^DIC(9.4,165,22,1,"PAH",64,1,1,0)="This patch provides the fix to the CLINICAL EXTRACT and Quasar Extract"
^DIC(9.4,165,22,1,"PAH",64,1,2,0)="Report."
^DIC(9.4,165,22,1,"PAH",65,0)="75 SEQ #67^3041029^1"
^DIC(9.4,165,22,1,"PAH",65,1,0)="^^2^2^3041029"
^DIC(9.4,165,22,1,"PAH",65,1,1,0)="This patch provides a fix to the DSS Extracts when transmitting"
^DIC(9.4,165,22,1,"PAH",65,1,2,0)="extracts to the production queue."
^DIC(9.4,165,22,1,"PAH",66,0)="74 SEQ #68^3041228^1"
^DIC(9.4,165,22,1,"PAH",66,1,0)="^^2^2^3041228"
^DIC(9.4,165,22,1,"PAH",66,1,1,0)="This patch provides changes to file #727.813 -- LABORATORY EXTRACT (LAB)"
^DIC(9.4,165,22,1,"PAH",66,1,2,0)="File Data Definition."
^DIC(9.4,165,22,1,"PAH",67,0)="71^3041228^1"
^DIC(9.4,165,22,1,"PAH",67,1,0)="^^1^1^3041228"
^DIC(9.4,165,22,1,"PAH",67,1,1,0)="Decision Support System's Fiscal Year 2005 updates."
^DIC(9.4,165,22,1,"PAH",68,0)="79 SEQ #70^3050212^1"
^DIC(9.4,165,22,1,"PAH",68,1,0)="^^1^1^3050212"
^DIC(9.4,165,22,1,"PAH",68,1,1,0)="This patch updates VISTA file 728.441."
^DIC(9.4,165,22,1,"PAH",69,0)="78 SEQ #71^3050401^1"
^DIC(9.4,165,22,1,"PAH",69,1,0)="^^7^7^3050401"
^DIC(9.4,165,22,1,"PAH",69,1,1,0)="The DSS Blood Bank Extract project will provide a means of exporting data "
^DIC(9.4,165,22,1,"PAH",69,1,2,0)="from the VistA Blood Bank application and transmitting it to a DSS "
^DIC(9.4,165,22,1,"PAH",69,1,3,0)="database residing at the AAC. Data from the VistA Blood Bank package will"
^DIC(9.4,165,22,1,"PAH",69,1,4,0)="be stored by the extract routine in an intermediate file, where it will be"
^DIC(9.4,165,22,1,"PAH",69,1,5,0)="temporarily available for local site DSS review and audit prior to running"
^DIC(9.4,165,22,1,"PAH",69,1,6,0)="of the extract. The data will then be transmitted to the AAC, where it "
^DIC(9.4,165,22,1,"PAH",69,1,7,0)="will be formatted and uploaded into other software products."
^DIC(9.4,165,22,1,"PAH",70,0)="76 SEQ #72^3050401^1"
^DIC(9.4,165,22,1,"PAH",70,1,0)="^^2^2^3050401"
^DIC(9.4,165,22,1,"PAH",70,1,1,0)="The purpose of this patch is to add 960 F NPPD code to PRO Extract Audit"
^DIC(9.4,165,22,1,"PAH",70,1,2,0)="Report."
^DIC(9.4,165,22,1,"PAH",71,0)="72^3050426^1"
^DIC(9.4,165,22,1,"PAH",72,0)="80 SEQ #74^3050506^1"
^DIC(9.4,165,22,1,"PAH",72,1,0)="^^1^1^3050506"
^DIC(9.4,165,22,1,"PAH",72,1,1,0)="Wrong Production Division being pulled for Lab Extracts."
