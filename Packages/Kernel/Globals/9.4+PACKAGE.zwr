^DIC(9.4,33,22,1.4,"PAH",110,0)="157 SEQ #125^3120912.162704^17"
^DIC(9.4,33,22,1.4,"PAH",110,1,0)="^^1^1^3120912"
^DIC(9.4,33,22,1.4,"PAH",110,1,1,0)=""
^DIC(9.4,33,22,1.4,"PAH",111,0)="158 SEQ #126^3120919.17064^17"
^DIC(9.4,33,22,1.4,"PAH",111,1,0)="^^2^2^3120919"
^DIC(9.4,33,22,1.4,"PAH",111,1,1,0)="See the National Patch Module on Forum for the patch description."
^DIC(9.4,33,22,1.4,"PAH",111,1,2,0)=""
^DIC(9.4,33,22,1.4,"PAH",112,0)="161 SEQ #127^3131210.165446^17"
^DIC(9.4,33,22,1.4,"PAH",112,1,0)="^^9^9^3131210"
^DIC(9.4,33,22,1.4,"PAH",112,1,1,0)="This patch addresses the following:"
^DIC(9.4,33,22,1.4,"PAH",112,1,2,0)=" "
^DIC(9.4,33,22,1.4,"PAH",112,1,3,0)="-Problems caused while editing active HL Logical Links"
^DIC(9.4,33,22,1.4,"PAH",112,1,4,0)="-Problems with ""AE"" cross reference leading to incorrect setting"
^DIC(9.4,33,22,1.4,"PAH",112,1,5,0)=" values and inability to delete."
^DIC(9.4,33,22,1.4,"PAH",112,1,6,0)="-Incorrect documentation for HL7 API GENACK^HLMA1 and potential"
^DIC(9.4,33,22,1.4,"PAH",112,1,7,0)=" <UNDEFINED> error."
^DIC(9.4,33,22,1.4,"PAH",112,1,8,0)="-Extrinsic function NEWEVENT^HLEVAPI could potentially execute"
^DIC(9.4,33,22,1.4,"PAH",112,1,9,0)=" without returning a value resulting in a <COMMAND> error. "
^DIC(9.4,33,22,1.4,"PAH",113,0)="162 SEQ #128^3140702.164925^17"
^DIC(9.4,33,22,1.4,"PAH",113,1,0)="^^5^5^3140702"
^DIC(9.4,33,22,1.4,"PAH",113,1,1,0)="To allow for the creation of new links via the Link Edit [HL EDIT LOGICAL "
^DIC(9.4,33,22,1.4,"PAH",113,1,2,0)="LINKS] option, the validation logic will allow users to proceed to the "
^DIC(9.4,33,22,1.4,"PAH",113,1,3,0)="edit screen if the link is new.  Also, it will allow users to proceed if"
^DIC(9.4,33,22,1.4,"PAH",113,1,4,0)="the Logical Link is a Multithreaded Listener regardless of the SHUTDOWN "
^DIC(9.4,33,22,1.4,"PAH",113,1,5,0)="LLP? (#14) field value in the HL LOGICAL LINK (#870) file."
^DIC(9.4,33,22,1.4,"PAH",114,0)="163 SEQ #129^3151027.133819^17"
^DIC(9.4,33,22,1.4,"PAH",114,1,0)="^^2^2^3151027"
^DIC(9.4,33,22,1.4,"PAH",114,1,1,0)="In preparation for the VA's transition from IPv4 to IPv6 the HL7 package "
^DIC(9.4,33,22,1.4,"PAH",114,1,2,0)="will require modifications to make it IPv6 ready."
^DIC(9.4,33,22,1.4,"PAH",115,0)="167 SEQ #130^3160829.13094^54"
^DIC(9.4,33,22,1.4,"PAH",115,1,0)="^^2^2^3160829"
^DIC(9.4,33,22,1.4,"PAH",115,1,1,0)="This patch modifies the Fileman validation logic to account"
^DIC(9.4,33,22,1.4,"PAH",115,1,2,0)="for the upgrade to Fileman V22.2."
^DIC(9.4,33,22,1.4,"PAH",116,0)="166 SEQ #131^3170123.141432^54"
^DIC(9.4,33,22,1.4,"PAH",116,1,0)="^^3^3^3170123"
^DIC(9.4,33,22,1.4,"PAH",116,1,1,0)="This patch addresses issues when editing HL LOGICAL LINKS, <STORE> errors"
^DIC(9.4,33,22,1.4,"PAH",116,1,2,0)="caused by excessive out queue arrays and potential issues with router"
^DIC(9.4,33,22,1.4,"PAH",116,1,3,0)="protocols where additional, unwanted data is processed."
^DIC(9.4,33,22,1.4,"PAH",117,0)="165 SEQ #132^3170403.154358^54"
^DIC(9.4,33,22,1.4,"PAH",117,1,0)="^^2^2^3170403"
^DIC(9.4,33,22,1.4,"PAH",117,1,1,0)="Resolve issues with the HL7 receiving process that could lead to the "
^DIC(9.4,33,22,1.4,"PAH",117,1,2,0)="process getting stuck in an endless loop."
^DIC(9.4,33,22,1.4,"PAH",118,0)="168 SEQ #133^3171227.13514^54"
^DIC(9.4,33,22,1.4,"PAH",118,1,0)="^^2^2^3171227"
^DIC(9.4,33,22,1.4,"PAH",118,1,1,0)="Resolves issue with the HL7 process that a bad value for"
^DIC(9.4,33,22,1.4,"PAH",118,1,2,0)="HLL(""LINKS"") would affect subsequent process with HL7"
^DIC(9.4,33,22,1.4,"PAH",119,0)="169 SEQ #134^3180301.151122^54"
^DIC(9.4,33,22,1.4,"PAH",119,1,0)="^^2^2^3180301"
^DIC(9.4,33,22,1.4,"PAH",119,1,1,0)="This patch updates the MPI (Master Patient Index) listener to work on"
^DIC(9.4,33,22,1.4,"PAH",119,1,2,0)="Linux and Unix systems."
^DIC(9.4,33,22,1.4,"PAH",120,0)="171 SEQ #135^3190708.180224^65"
^DIC(9.4,33,22,1.4,"PAH",120,1,0)="^^6^6^3190708"
^DIC(9.4,33,22,1.4,"PAH",120,1,1,0)=" This patch will address 1 issue:"
^DIC(9.4,33,22,1.4,"PAH",120,1,2,0)=" "
^DIC(9.4,33,22,1.4,"PAH",120,1,3,0)=" 1. When several HL7 event driver protocols share the same sending"
^DIC(9.4,33,22,1.4,"PAH",120,1,4,0)="    application, message type, event type, and version ID, the HL7 "
^DIC(9.4,33,22,1.4,"PAH",120,1,5,0)="    software will only retrieve the first protocol, even if it is not the"
^DIC(9.4,33,22,1.4,"PAH",120,1,6,0)="    correct protocol for the current message being processed."
^DIC(9.4,33,22,1.4,"PAH",121,0)="172 SEQ #136^3200923.154614^65"
^DIC(9.4,33,22,1.4,"PAH",121,1,0)="^^2^2^3200923"
^DIC(9.4,33,22,1.4,"PAH",121,1,1,0)="This patch updates the Health Level Seven (HL7) routines with a version "
^DIC(9.4,33,22,1.4,"PAH",121,1,2,0)="check that does not include ""IRIS""."
^DIC(9.4,33,22,1.4,"PAH",122,0)="173 SEQ #137^3211014.160055^17"
^DIC(9.4,33,22,1.4,"PAH",122,1,0)="^^3^3^3211014"
^DIC(9.4,33,22,1.4,"PAH",122,1,1,0)="Health Level Seven (HL7) patch HL*1.6*173 modifies the software to"
^DIC(9.4,33,22,1.4,"PAH",122,1,2,0)="ensure the most recently run HL7 monitor is used when checking against"
^DIC(9.4,33,22,1.4,"PAH",122,1,3,0)="the REQUEUE MIN-MONITOR (#4) field in the HL7 MONITOR (#776.1) file."
^DIC(9.4,33,22,1.4,"PAH",123,0)="174 SEQ #138^3220628.154617^86"
^DIC(9.4,33,22,1.4,"PAH",123,1,0)="^^6^6^3220628"
^DIC(9.4,33,22,1.4,"PAH",123,1,1,0)="Patch HL*1.6*174 addresses 2 issues"
^DIC(9.4,33,22,1.4,"PAH",123,1,2,0)="1. An undefined DUZ(2) error in the XPAR1 routine due to the DUZ() array "
^DIC(9.4,33,22,1.4,"PAH",123,1,3,0)="   not being set up properly."
^DIC(9.4,33,22,1.4,"PAH",123,1,4,0)="2. An undefined HLNK error in the HLTPCK1A routine due to the domain"
^DIC(9.4,33,22,1.4,"PAH",123,1,5,0)="   of the sending site not being found in the DOMAIN(4.2) file ""B"" cross"
^DIC(9.4,33,22,1.4,"PAH",123,1,6,0)="   reference."
^DIC(9.4,33,22,1.4,"PAH",124,0)="175 SEQ #139^3230313.153112^89"
^DIC(9.4,33,22,1.4,"PAH",124,1,0)="^^1^1^3230313"
^DIC(9.4,33,22,1.4,"PAH",124,1,1,0)="MAKE ALL HL FILERS PERSISTENT"
^DIC(9.4,33,22,1.4,"PAH",125,0)="176 SEQ #140^3240411.105741^89"
^DIC(9.4,33,22,1.4,"PAH",125,1,0)="^^2^2^3240411"
^DIC(9.4,33,22,1.4,"PAH",125,1,1,0)="Patch HL*1.6*176 addresses an <UNDEFINED> ZTSKMST error when using the"
^DIC(9.4,33,22,1.4,"PAH",125,1,2,0)="Monitoring master job start menu [HLEV MASTER JOB START] option."
^DIC(9.4,33,22,1.4,"PAH",126,0)="177 SEQ #141^3260327.104214^90"
^DIC(9.4,33,22,1.4,"PAH",126,1,0)="^^2^2^3260327"
^DIC(9.4,33,22,1.4,"PAH",126,1,1,0)="This patch includes a single routine containing read-only calls to "
^DIC(9.4,33,22,1.4,"PAH",126,1,2,0)="support the VistA System Monitor Operations Dashboard."
