^DIC(9.4,49,22,10,"PAH",193,1,208,0)="------------------------------------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",193,1,209,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,210,0)="361.1       EXPLANATION OF BENEFITS      YES   NO    NO                 NO"
^DIC(9.4,49,22,10,"PAH",193,1,211,0)="Partial DD: subDD: 361.1      fld: .14"
