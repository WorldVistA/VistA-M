^DIC(9.4,14,22,5.9,"PAH",189,1,404,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,14,22,5.9,"PAH",189,1,405,0)="each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",189,1,406,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,407,0)="  <tab> ;;5.2;LAB SERVICE;**[patchlist]**;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",189,1,408,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,409,0)="                 Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",189,1,410,0)="Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",189,1,411,0)="------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,412,0)="LR331             N/A            5261822       331  (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",189,1,413,0)="LR7OGMG          5478031        5490638        187,230,286,290,331"
^DIC(9.4,14,22,5.9,"PAH",189,1,414,0)="LRWLST1          12664045       11171614       48,65,121,153,261,286,331"
^DIC(9.4,14,22,5.9,"PAH",189,1,415,0)="LRWLST11         16883055       15996378       121,128,153,202,286,331"
^DIC(9.4,14,22,5.9,"PAH",189,1,416,0)=""
^DIC(9.4,14,22,5.9,"PAH",190,0)="368 SEQ #289^3070905.012523^1"
^DIC(9.4,14,22,5.9,"PAH",190,1,0)="^^1^1^3070905"
^DIC(9.4,14,22,5.9,"PAH",190,1,1,0)="This patch corrects an improperly formatted FileMan call."
^DIC(9.4,14,22,5.9,"PAH",191,0)="364 SEQ #290^3071212.222227^1"
^DIC(9.4,14,22,5.9,"PAH",191,1,0)="^^2^2^3071212"
^DIC(9.4,14,22,5.9,"PAH",191,1,1,0)="This patch corrects a problem with 2 CPRS displays which show a "
^DIC(9.4,14,22,5.9,"PAH",191,1,2,0)="collection time that is not correct. "
^DIC(9.4,14,22,5.9,"PAH",192,0)="363 SEQ #291^3071212.230023^1"
^DIC(9.4,14,22,5.9,"PAH",192,1,0)="^^2^2^3071212"
^DIC(9.4,14,22,5.9,"PAH",192,1,1,0)="This patch corrects a problem whereby a partial AP report is"
^DIC(9.4,14,22,5.9,"PAH",192,1,2,0)="sent to TIU."
^DIC(9.4,14,22,5.9,"PAH",193,0)="373 SEQ #292^3080203.223351^1"
^DIC(9.4,14,22,5.9,"PAH",193,1,0)="^^1^1^3080203"
^DIC(9.4,14,22,5.9,"PAH",193,1,1,0)="This is a general purpose lab patch."
^DIC(9.4,14,22,5.9,"PAH",194,0)="377 SEQ #293^3080203.223847^1"
^DIC(9.4,14,22,5.9,"PAH",194,1,0)="^^4^4^3080203"
^DIC(9.4,14,22,5.9,"PAH",194,1,1,0)="This patch adds a new routine LREGFR2 to support a new constant value of "
^DIC(9.4,14,22,5.9,"PAH",194,1,2,0)="175 for the eGFR formula. It details the creation of a new delta check "
^DIC(9.4,14,22,5.9,"PAH",194,1,3,0)="EGFR2 to call the new routine and how to edit the existing Creatinine "
^DIC(9.4,14,22,5.9,"PAH",194,1,4,0)="record in the LABORATORY TEST file (file # 60) to use the new delta check."
^DIC(9.4,14,22,5.9,"PAH",195,0)="378 SEQ #294^3080526.151409^1"
^DIC(9.4,14,22,5.9,"PAH",195,1,0)="^^6^6^3080526"
^DIC(9.4,14,22,5.9,"PAH",195,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",195,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",195,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",195,1,4,0)="This patch corrects a problem with the Labserver reports"
^DIC(9.4,14,22,5.9,"PAH",195,1,5,0)="whereby the reports are held up because the subject line "
^DIC(9.4,14,22,5.9,"PAH",195,1,6,0)="in the MailMan message is too long (greater than 65 characters)."
^DIC(9.4,14,22,5.9,"PAH",196,0)="375 SEQ #295^3080526.15454^1"
^DIC(9.4,14,22,5.9,"PAH",196,1,0)="^^2^2^3080526"
^DIC(9.4,14,22,5.9,"PAH",196,1,1,0)="This patch corrects a problem related to ""in common"" accession"
^DIC(9.4,14,22,5.9,"PAH",196,1,2,0)="areas when tests with unique accession numbers are involved."
^DIC(9.4,14,22,5.9,"PAH",197,0)="379 SEQ #296^3080526.193723^1"
^DIC(9.4,14,22,5.9,"PAH",197,1,0)="^^6^6^3080526"
^DIC(9.4,14,22,5.9,"PAH",197,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",197,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",197,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",197,1,4,0)="This patch corrects a problem whereby a <SUBSCRIPT> error occurs"
^DIC(9.4,14,22,5.9,"PAH",197,1,5,0)="in routine LA7ADL because of an inability to get a lock for setting"
^DIC(9.4,14,22,5.9,"PAH",197,1,6,0)="data into file 68 (Accession file) in routine LRWLST1."
^DIC(9.4,14,22,5.9,"PAH",198,0)="365^3090421.154938^17"
^DIC(9.4,14,22,5.9,"PAH",198,1,0)="^^355^355^3090421"
^DIC(9.4,14,22,5.9,"PAH",198,1,1,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*365 does not "
^DIC(9.4,14,22,5.9,"PAH",198,1,2,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",198,1,3,0)="DIRECTIVE 2004-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",198,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,5,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*365 does"
^DIC(9.4,14,22,5.9,"PAH",198,1,6,0)="not alter or modify any software design safeguards or safety critical"
^DIC(9.4,14,22,5.9,"PAH",198,1,7,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",198,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,9,0)="RISK ANALYSIS: Changes made by patch LR*5.2*365 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",198,1,10,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",198,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,12,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",198,1,13,0)="made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",198,1,14,0)="installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",198,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,16,0)="This patch is being distributed in the OR*3*243 CPRS v27 build."
^DIC(9.4,14,22,5.9,"PAH",198,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,18,0)="VistA Laboratory Anatomic Pathology (AP) Alerts and Clinical Patient "
^DIC(9.4,14,22,5.9,"PAH",198,1,19,0)="Record System (CPRS) Report Changes Patch LR*5.2*365 software "
^DIC(9.4,14,22,5.9,"PAH",198,1,20,0)="release addresses 7 Patient Safety Issues (PSIs). Individual reports "
^DIC(9.4,14,22,5.9,"PAH",198,1,21,0)="are displayed as one continuous scrolling display. A single row of "
^DIC(9.4,14,22,5.9,"PAH",198,1,22,0)="the equal (=) sign is used to separate one report from the next. "
^DIC(9.4,14,22,5.9,"PAH",198,1,23,0)="Additionally, the text- ""Next SURGICAL PATHOLOGY Specimen..."" is "
^DIC(9.4,14,22,5.9,"PAH",198,1,24,0)="also used to separate reports. However, with multiple reports and "
^DIC(9.4,14,22,5.9,"PAH",198,1,25,0)="the use of single dashed lines in each report, it can be difficult "
^DIC(9.4,14,22,5.9,"PAH",198,1,26,0)="to distinguish the separation between AP reports. A new API has been "
^DIC(9.4,14,22,5.9,"PAH",198,1,27,0)="created (EN^LR7OSAP4) for retrieving a detailed report for an "
^DIC(9.4,14,22,5.9,"PAH",198,1,28,0)="individual Anatomic Pathology Specimen. This helps resolve the PSI "
^DIC(9.4,14,22,5.9,"PAH",198,1,29,0)="by allowing a package interface, like CPRS, to present each "
^DIC(9.4,14,22,5.9,"PAH",198,1,30,0)="accession and related specimens to the user and then display the "
^DIC(9.4,14,22,5.9,"PAH",198,1,31,0)="related report for the accession/specimens."
^DIC(9.4,14,22,5.9,"PAH",198,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,33,0)="Patches OR*3*210 and LR*5.2*311 implemented informational alerts "
^DIC(9.4,14,22,5.9,"PAH",198,1,34,0)="generated for AP pathology results. Recipients of VA view alerts for "
^DIC(9.4,14,22,5.9,"PAH",198,1,35,0)="Anatomic Pathology complained that clicking on the alert did not "
^DIC(9.4,14,22,5.9,"PAH",198,1,36,0)="open up or display the report to them in the same manner as other "
^DIC(9.4,14,22,5.9,"PAH",198,1,37,0)="lab alerts are displayed. Once the recipients click on the alert, it "
^DIC(9.4,14,22,5.9,"PAH",198,1,38,0)="is gone from view. If they did not make a note as to who the patient "
^DIC(9.4,14,22,5.9,"PAH",198,1,39,0)="was, they can not get the alert back. Providers can easily erase the "
^DIC(9.4,14,22,5.9,"PAH",198,1,40,0)="alerts without recording the patient's name. A potential malignancy "
^DIC(9.4,14,22,5.9,"PAH",198,1,41,0)="report could be missed. Problem was identified from complaints of "
^DIC(9.4,14,22,5.9,"PAH",198,1,42,0)="surgeons and oncologists/hematologists. To correct this issue the "
^DIC(9.4,14,22,5.9,"PAH",198,1,43,0)="new action alert is provided to display AP reports. The Anatomic "
^DIC(9.4,14,22,5.9,"PAH",198,1,44,0)="Pathology informational alerts are now modified into action alerts "
^DIC(9.4,14,22,5.9,"PAH",198,1,45,0)="that upon processing will direct the user to the associated report "
^DIC(9.4,14,22,5.9,"PAH",198,1,46,0)="in the Clinical Reports section under the Reports tab of the CPRS "
^DIC(9.4,14,22,5.9,"PAH",198,1,47,0)="GUI or to a List manager display of the associated report results. "
^DIC(9.4,14,22,5.9,"PAH",198,1,48,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,49,0)="This patch provides action alerts for Anatomic Pathology tests "
^DIC(9.4,14,22,5.9,"PAH",198,1,50,0)="including Electron Microscopy (EM), Surgical Pathology (SP), "
^DIC(9.4,14,22,5.9,"PAH",198,1,51,0)="Cytology (CY), and Autopsy (AU) results. These action alerts are "
^DIC(9.4,14,22,5.9,"PAH",198,1,52,0)="sent automatically to the Ordering Provider, Primary Physician, or "
^DIC(9.4,14,22,5.9,"PAH",198,1,53,0)="Primary Care Provider at the time the report is released. If "
^DIC(9.4,14,22,5.9,"PAH",198,1,54,0)="requested, alerts may be sent to additional person(s) and "
^DIC(9.4,14,22,5.9,"PAH",198,1,55,0)="mail group(s). These additional alerts are also action alerts. This "
^DIC(9.4,14,22,5.9,"PAH",198,1,56,0)="functionality is now the same whether electronic signature (ES) is "
^DIC(9.4,14,22,5.9,"PAH",198,1,57,0)="turned ON or OFF. Before this patch, additional alerts could not be "
^DIC(9.4,14,22,5.9,"PAH",198,1,58,0)="requested with electronic signature (ES) turned OFF."
^DIC(9.4,14,22,5.9,"PAH",198,1,59,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,60,0)="This patch provides the new Send an AP Alert [LRAP ALERT] option "
^DIC(9.4,14,22,5.9,"PAH",198,1,61,0)="that is available on the Verify/release menu, anat path [LRAPVR] "
^DIC(9.4,14,22,5.9,"PAH",198,1,62,0)="which allows a pathologist to send an action alert to a provider, "
^DIC(9.4,14,22,5.9,"PAH",198,1,63,0)="other individuals, or mail group(s) after the report has been "
^DIC(9.4,14,22,5.9,"PAH",198,1,64,0)="released. Before this software release if the user did not answer "
^DIC(9.4,14,22,5.9,"PAH",198,1,65,0)="YES to the prompt to send an alert after a report was released, an "
^DIC(9.4,14,22,5.9,"PAH",198,1,66,0)="alert could not be sent unless the AP report was reopened and "
^DIC(9.4,14,22,5.9,"PAH",198,1,67,0)="re-released."
^DIC(9.4,14,22,5.9,"PAH",198,1,68,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,69,0)="1) PSI-05-027 and PSI-07-135 identified a patient safety issue using the"
^DIC(9.4,14,22,5.9,"PAH",198,1,70,0)="CPRS Graphic User Interface (GUI) Lab Tab, Laboratory Results- Anatomic"
^DIC(9.4,14,22,5.9,"PAH",198,1,71,0)="Pathology (AP).  The individual reports are displayed as one continuous"
^DIC(9.4,14,22,5.9,"PAH",198,1,72,0)="scrolling display.  A single row of equal (=) signs is used to separate"
^DIC(9.4,14,22,5.9,"PAH",198,1,73,0)="one report from the next.  Additionally, the text- ""Next SURGICAL"
^DIC(9.4,14,22,5.9,"PAH",198,1,74,0)="PATHOLOGY Specimen..."" is also used to separate reports.  However, with"
^DIC(9.4,14,22,5.9,"PAH",198,1,75,0)="multiple reports and the use of single dashed lines in each report, it"
^DIC(9.4,14,22,5.9,"PAH",198,1,76,0)="can be difficult to distinguish the separation between AP reports."
^DIC(9.4,14,22,5.9,"PAH",198,1,77,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,78,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",198,1,79,0)="A new API has been created (EN^LR7OSAP4) for retrieving a detailed report "
^DIC(9.4,14,22,5.9,"PAH",198,1,80,0)="for an individual Anatomic Pathology Specimen.  This resolves the "
^DIC(9.4,14,22,5.9,"PAH",198,1,81,0)="PSI by allowing a package interface, like CPRS, to present each specimen "
^DIC(9.4,14,22,5.9,"PAH",198,1,82,0)="to the user and then get the report on the specimen."
^DIC(9.4,14,22,5.9,"PAH",198,1,83,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,84,0)="2) PSI-06-068, PSI-07-014, PSI-05-001, PSI-06-134, and PSI-07-031"
^DIC(9.4,14,22,5.9,"PAH",198,1,85,0)="identified a patient safety issue with the Anatomic Pathology notification"
^DIC(9.4,14,22,5.9,"PAH",198,1,86,0)="alerts. Patches OR*3*210 and LR*5.2*311 implemented informational alerts"
^DIC(9.4,14,22,5.9,"PAH",198,1,87,0)="generated for pathology results.  Recipients of VA view alerts for "
^DIC(9.4,14,22,5.9,"PAH",198,1,88,0)="Anatomic Pathology have complained that clicking on the alert does not"
^DIC(9.4,14,22,5.9,"PAH",198,1,89,0)="open up or display the report to them in the same manner as other lab"
^DIC(9.4,14,22,5.9,"PAH",198,1,90,0)="alerts do (CH subscripted).  Once they click on the alert, it's gone from"
^DIC(9.4,14,22,5.9,"PAH",198,1,91,0)="view.  If they didn't make a note as to who the patient was, they can't"
^DIC(9.4,14,22,5.9,"PAH",198,1,92,0)="get it back.  It would be helpful to have an action alert for these"
^DIC(9.4,14,22,5.9,"PAH",198,1,93,0)="results. Providers can easily erase them without recording the patient's"
^DIC(9.4,14,22,5.9,"PAH",198,1,94,0)="name.  A potential malignancy report could be missed. Problem was"
^DIC(9.4,14,22,5.9,"PAH",198,1,95,0)="identified from complaints of surgeons and oncologists/hematologists."
^DIC(9.4,14,22,5.9,"PAH",198,1,96,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,97,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",198,1,98,0)="The Anatomic Pathology informational alerts are now modified into action"
^DIC(9.4,14,22,5.9,"PAH",198,1,99,0)="alerts that upon processing will direct the user to the associated report"
^DIC(9.4,14,22,5.9,"PAH",198,1,100,0)="in the Clinical Reports section under the Reports tab of the CPRS GUI or "
^DIC(9.4,14,22,5.9,"PAH",198,1,101,0)="to a List manager display of the associated report results."
^DIC(9.4,14,22,5.9,"PAH",198,1,102,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,103,0)="This patch provides action alerts for Anatomic Pathology reports including"
^DIC(9.4,14,22,5.9,"PAH",198,1,104,0)="Electron Microscopy (EM), Surgical Pathology (SP), Cytology (CY), and "
^DIC(9.4,14,22,5.9,"PAH",198,1,105,0)="Autopsy (AU) reports.  These action alerts are sent automatically to the"
^DIC(9.4,14,22,5.9,"PAH",198,1,106,0)="ordering provider and the primary care physician (PCP) at the time the"
^DIC(9.4,14,22,5.9,"PAH",198,1,107,0)="report is released.  If requested, alerts may be sent to additional"
^DIC(9.4,14,22,5.9,"PAH",198,1,108,0)="person(s).  These additional alerts are also action alerts.  This"
^DIC(9.4,14,22,5.9,"PAH",198,1,109,0)="functionality is now the same whether electronic signature (ES) is "
^DIC(9.4,14,22,5.9,"PAH",198,1,110,0)="turned ON or OFF.  Before this patch, additional alerts could not be"
^DIC(9.4,14,22,5.9,"PAH",198,1,111,0)="requested with electronic signature (ES) turned OFF."
^DIC(9.4,14,22,5.9,"PAH",198,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,113,0)="The Supplementary report release, anat path [LRAPRS] option now sends "
^DIC(9.4,14,22,5.9,"PAH",198,1,114,0)="action alerts automatically to the ordering provider and the PCP at the"
^DIC(9.4,14,22,5.9,"PAH",198,1,115,0)="time the supplementary report is released.  If requested, alerts may be"
^DIC(9.4,14,22,5.9,"PAH",198,1,116,0)="sent to additional person(s).  These additional alerts are also action"
^DIC(9.4,14,22,5.9,"PAH",198,1,117,0)="alerts.  These alerts are sent whether electronic signature is turned ON"
^DIC(9.4,14,22,5.9,"PAH",198,1,118,0)="or OFF."
^DIC(9.4,14,22,5.9,"PAH",198,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,120,0)=" Modified options:"
^DIC(9.4,14,22,5.9,"PAH",198,1,121,0)=" ================"
^DIC(9.4,14,22,5.9,"PAH",198,1,122,0)="  NAME: LRAPR"
^DIC(9.4,14,22,5.9,"PAH",198,1,123,0)="  MENU TEXT: Verify/release reports, anat path"
^DIC(9.4,14,22,5.9,"PAH",198,1,124,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",198,1,125,0)="  LOCK: LRVERIFY"
^DIC(9.4,14,22,5.9,"PAH",198,1,126,0)="  DESCRIPTION:   This option is used to verify/release pathology reports."
^DIC(9.4,14,22,5.9,"PAH",198,1,127,0)=" The user is prompted for the accession number of the report to be"
^DIC(9.4,14,22,5.9,"PAH",198,1,128,0)=" released.  If electronic signature is not activated, the user is asked if"
^DIC(9.4,14,22,5.9,"PAH",198,1,129,0)=" the report is to be released, yes or no. If electronic signature has been"
^DIC(9.4,14,22,5.9,"PAH",198,1,130,0)=" activated, the option is used to electronically sign and store pathology"
^DIC(9.4,14,22,5.9,"PAH",198,1,131,0)=" reports.  It also allows CPT coding to be performed regardless of the"
^DIC(9.4,14,22,5.9,"PAH",198,1,132,0)=" release status of the chosen report.  Another feature is the ability to"
^DIC(9.4,14,22,5.9,"PAH",198,1,133,0)=" print SNOMED codes for the given accession/report.  Action alerts are"
^DIC(9.4,14,22,5.9,"PAH",198,1,134,0)=" sent automatically to the ordering provider and the primary physician or"
^DIC(9.4,14,22,5.9,"PAH",198,1,135,0)=" PCP at the time the report is released. If requested, alerts may be sent"
^DIC(9.4,14,22,5.9,"PAH",198,1,136,0)=" to additional person(s) and/or mail group(s). These additional alerts are"
^DIC(9.4,14,22,5.9,"PAH",198,1,137,0)=" also action alerts."
^DIC(9.4,14,22,5.9,"PAH",198,1,138,0)="  ROUTINE: LRAPR  "
^DIC(9.4,14,22,5.9,"PAH",198,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,140,0)="  NAME: LRAPRS"
^DIC(9.4,14,22,5.9,"PAH",198,1,141,0)="  MENU TEXT: Supplementary report release, anat path"
^DIC(9.4,14,22,5.9,"PAH",198,1,142,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",198,1,143,0)="  DESCRIPTION:   Releases supplementary reports for Surgical Pathology,"
^DIC(9.4,14,22,5.9,"PAH",198,1,144,0)=" Cytopathology, Electron Microscopy, or Autopsy.  If all supplementary "
^DIC(9.4,14,22,5.9,"PAH",198,1,145,0)=" reports that exist for the chosen accession have already been released or"
^DIC(9.4,14,22,5.9,"PAH",198,1,146,0)=" if no supplementary reports exist for the accession, the user will be"
^DIC(9.4,14,22,5.9,"PAH",198,1,147,0)=" notified.  If electronic signature is not activated, the user is asked if"
^DIC(9.4,14,22,5.9,"PAH",198,1,148,0)=" the report is to be released, yes or no.  If electronic signature has"
^DIC(9.4,14,22,5.9,"PAH",198,1,149,0)=" been activated, the option is used to sign and store the supplementary"
^DIC(9.4,14,22,5.9,"PAH",198,1,150,0)=" report. Action alerts are sent automatically to the ordering provider and"
^DIC(9.4,14,22,5.9,"PAH",198,1,151,0)=" the primary physician or PCP at the time the supplementary reports are"
^DIC(9.4,14,22,5.9,"PAH",198,1,152,0)=" released.  If requested, alerts may be sent to additional person(s)"
^DIC(9.4,14,22,5.9,"PAH",198,1,153,0)=" and/or mail group(s). These additional alerts are also action alerts."
^DIC(9.4,14,22,5.9,"PAH",198,1,154,0)=" These alerts are sent whether electronic signature is on or off."
^DIC(9.4,14,22,5.9,"PAH",198,1,155,0)="  ROUTINE: EN^LRAPR"
^DIC(9.4,14,22,5.9,"PAH",198,1,156,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,157,0)="3) This patch provides a new option, Send an AP Alert [LRAP ALERT] "
^DIC(9.4,14,22,5.9,"PAH",198,1,158,0)="available on the Verify/release menu, anat path [LRAPVR] menu which"
^DIC(9.4,14,22,5.9,"PAH",198,1,159,0)="allows a pathologist to send an action alert to a provider or other"
^DIC(9.4,14,22,5.9,"PAH",198,1,160,0)="person(s) or mail group(s) after the case has been released.  The use"
^DIC(9.4,14,22,5.9,"PAH",198,1,161,0)="of this option requires the LRVERIFY key.  Before, if they did not answer"
^DIC(9.4,14,22,5.9,"PAH",198,1,162,0)="YES to the prompt to send an alert after a report was released, an alert"
^DIC(9.4,14,22,5.9,"PAH",198,1,163,0)="could not be sent unless the case was reopened and re-released."
^DIC(9.4,14,22,5.9,"PAH",198,1,164,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,165,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,166,0)=" New Option:"
^DIC(9.4,14,22,5.9,"PAH",198,1,167,0)=" ==========="
^DIC(9.4,14,22,5.9,"PAH",198,1,168,0)="  NAME: LRAP ALERT                      MENU TEXT: Send an AP Alert"
^DIC(9.4,14,22,5.9,"PAH",198,1,169,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",198,1,170,0)="  LOCK: LRVERIFY"
^DIC(9.4,14,22,5.9,"PAH",198,1,171,0)="  DESCRIPTION:   This option allows a pathologist to send an action alert "
^DIC(9.4,14,22,5.9,"PAH",198,1,172,0)=" to a provider or other person(s) or mail group(s) after the case has been"
^DIC(9.4,14,22,5.9,"PAH",198,1,173,0)=" released.  "
^DIC(9.4,14,22,5.9,"PAH",198,1,174,0)="  ROUTINE: LRAPALRT  "
^DIC(9.4,14,22,5.9,"PAH",198,1,175,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,176,0)="The following option was modified to include the new option, Send an AP "
^DIC(9.4,14,22,5.9,"PAH",198,1,177,0)="Alert [LRAP ALERT] on the Verify/release menu, anat path [LRAPVR] menu."
^DIC(9.4,14,22,5.9,"PAH",198,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",198,1,179,0)=" Modified Option:"
^DIC(9.4,14,22,5.9,"PAH",198,1,180,0)=" ================"
^DIC(9.4,14,22,5.9,"PAH",198,1,181,0)="  NAME: LRAPVR"
^DIC(9.4,14,22,5.9,"PAH",198,1,182,0)="  MENU TEXT: Verify/release menu, anat path"
^DIC(9.4,14,22,5.9,"PAH",198,1,183,0)="  TYPE: menu"
^DIC(9.4,14,22,5.9,"PAH",198,1,184,0)="  DESCRIPTION:   Anatomic pathology verify and release option menu.  "
^DIC(9.4,14,22,5.9,"PAH",198,1,185,0)=" ITEM: LRAPR                             SYNONYM: RR"
^DIC(9.4,14,22,5.9,"PAH",198,1,186,0)="  DISPLAY ORDER: 1"
^DIC(9.4,14,22,5.9,"PAH",198,1,187,0)=" ITEM: LRAPV                             SYNONYM: LU"
^DIC(9.4,14,22,5.9,"PAH",198,1,188,0)="  DISPLAY ORDER: 3"
^DIC(9.4,14,22,5.9,"PAH",198,1,189,0)=" ITEM: LRAPRS                            SYNONYM: RS"
^DIC(9.4,14,22,5.9,"PAH",198,1,190,0)="  DISPLAY ORDER: 2"
^DIC(9.4,14,22,5.9,"PAH",198,1,191,0)=" ITEM: LRCAPES                           SYNONYM: CPT"
^DIC(9.4,14,22,5.9,"PAH",198,1,192,0)="  DISPLAY ORDER: 4"
^DIC(9.4,14,22,5.9,"PAH",198,1,193,0)=" ITEM: LRAP ALERT                        SYNONYM: SA"
^DIC(9.4,14,22,5.9,"PAH",198,1,194,0)=" "
