^DIC(9.4,175,22,2,"PAH",108,0)="158^3151211.144121^17"
^DIC(9.4,175,22,2,"PAH",108,1,0)="^^23^23^3151211"
^DIC(9.4,175,22,2,"PAH",108,1,1,0)="VistA Imaging V3.0 Patch 158 - Import API OCX fix"
^DIC(9.4,175,22,2,"PAH",108,1,2,0)=" - This patch tests the Modified Import OCX, new MagThumbnailMaker.exe"
^DIC(9.4,175,22,2,"PAH",108,1,3,0)="   and new mag_MakeAbs.exe"
^DIC(9.4,175,22,2,"PAH",108,1,4,0)="   Import OCX has been modified to perform the Copy to Network in a back"
^DIC(9.4,175,22,2,"PAH",108,1,5,0)="   background thread.  This enables the main thread to maintain "
^DIC(9.4,175,22,2,"PAH",108,1,6,0)="   connection to the VistA Server."
^DIC(9.4,175,22,2,"PAH",108,1,7,0)="   MagThumbnailMaker.exe is a new abstract/thumbnail maker.  It will"
^DIC(9.4,175,22,2,"PAH",108,1,8,0)="   be called by the new mag_MakeAbs.exe."
^DIC(9.4,175,22,2,"PAH",108,1,9,0)="   mag_MakeAbs.exe has been changed.  Instead of making the abstracts, "
^DIC(9.4,175,22,2,"PAH",108,1,10,0)="   it will send a windows message to MagThumbnailMaker, wait for a "
^DIC(9.4,175,22,2,"PAH",108,1,11,0)="   response back, then terminate itself."
^DIC(9.4,175,22,2,"PAH",108,1,12,0)="   This design will allow the BP to continue processing abstracts as"
^DIC(9.4,175,22,2,"PAH",108,1,13,0)="   it does now.  no change to the BP application is needed."
^DIC(9.4,175,22,2,"PAH",108,1,14,0)=" "
^DIC(9.4,175,22,2,"PAH",108,1,15,0)=" "
^DIC(9.4,175,22,2,"PAH",108,1,16,0)="                 Checksums"
^DIC(9.4,175,22,2,"PAH",108,1,17,0)="Routine         Old         New        Patch List"
^DIC(9.4,175,22,2,"PAH",108,1,18,0)="MAGGSFT       8060991     12528057    **7,8,94,158**"
^DIC(9.4,175,22,2,"PAH",108,1,19,0)="MAGIP158      n/a         4832681     **158**"
