^DIC(9.4,104,22,9,"PAH",18,0)="24 SEQ #18^3100504.095139^17"
^DIC(9.4,104,22,9,"PAH",18,1,0)="^^3^3^3100504"
^DIC(9.4,104,22,9,"PAH",18,1,1,0)="This patch will correct the hospital location pointers in the GMRV VITAL "
^DIC(9.4,104,22,9,"PAH",18,1,2,0)="MEASUREMENT file (#120.5) by making a call to the Registration package to "
^DIC(9.4,104,22,9,"PAH",18,1,3,0)="get the hospital location pointer the patient was checked in to."
^DIC(9.4,104,22,9,"PAH",19,0)="26 SEQ #19^3110628.123154^17"
^DIC(9.4,104,22,9,"PAH",19,1,0)="^^1^1^3110628"
^DIC(9.4,104,22,9,"PAH",19,1,1,0)="VARIOUS GUI CORRECTIONS"
^DIC(9.4,104,22,9,"PAH",20,0)="29 SEQ #20^3140618.104212^17"
^DIC(9.4,104,22,9,"PAH",20,1,0)="^^1^1^3140618"
^DIC(9.4,104,22,9,"PAH",20,1,1,0)="ADD VHIC API CALL FOR PATIENT LOOKUP"
^DIC(9.4,104,22,9,"PAH",21,0)="28^3160310.155112^54"
^DIC(9.4,104,22,9,"PAH",22,0)="30 SEQ #22^3161028.151706^54"
^DIC(9.4,104,22,9,"PAH",22,1,0)="^^41^41^3161028"
^DIC(9.4,104,22,9,"PAH",22,1,1,0)="This patch will include the creation of a new field that will incorporate "
^DIC(9.4,104,22,9,"PAH",22,1,2,0)="data from the respective Standards Development Organization (SDO) to the "
^DIC(9.4,104,22,9,"PAH",22,1,3,0)="Vitals Type (#120.51), Vitals Qualifier (#120.52) and Vitals Category "
^DIC(9.4,104,22,9,"PAH",22,1,4,0)="(#120.53) files. "
^DIC(9.4,104,22,9,"PAH",22,1,5,0)="The Vital Type, Vital Qualifier, and Vital Category  files will be "
^DIC(9.4,104,22,9,"PAH",22,1,6,0)="addressed during this effort due to the nature of the data within these "
^DIC(9.4,104,22,9,"PAH",22,1,7,0)="files that are necessary for referencing, reporting, and interoperability "
^DIC(9.4,104,22,9,"PAH",22,1,8,0)="purposes. "
^DIC(9.4,104,22,9,"PAH",22,1,9,0)="The following three files are associated with the Vital Signs Domain:"
^DIC(9.4,104,22,9,"PAH",22,1,10,0)="Vitals Type File (#120.51): This file contains a list of vital "
^DIC(9.4,104,22,9,"PAH",22,1,11,0)="sign types, for example, height, weight, and temperature"
^DIC(9.4,104,22,9,"PAH",22,1,12,0)="Vitals Qualifier File (#120.52): Description of how the patient "
^DIC(9.4,104,22,9,"PAH",22,1,13,0)="vital signs and measurements were taken. Categorized by location (e.g., "
^DIC(9.4,104,22,9,"PAH",22,1,14,0)="right arm, left leg), position (e.g., lying, sitting, standing), method "
^DIC(9.4,104,22,9,"PAH",22,1,15,0)="(e.g., cuff, Doppler, assisted ventilator, etc.), site (e.g., right, "
^DIC(9.4,104,22,9,"PAH",22,1,16,0)="left), quality (e.g., actual, estimated), and cuff size (e.g., adult, "
^DIC(9.4,104,22,9,"PAH",22,1,17,0)="small adult, pediatric)."
^DIC(9.4,104,22,9,"PAH",22,1,18,0)="Vitals Category File (#120.53): This file contains the cuff size, "
^DIC(9.4,104,22,9,"PAH",22,1,19,0)="location, method, position, quality, and site of the vitals which are "
^DIC(9.4,104,22,9,"PAH",22,1,20,0)="simply ways of grouping qualifiers which store the important data."
^DIC(9.4,104,22,9,"PAH",22,1,21,0)="GMRV VITAL TYPE (#120.51) file shall be updated to include a new field to "
^DIC(9.4,104,22,9,"PAH",22,1,22,0)="store LOINC code field from the respective SDO. The new field s shall be "
^DIC(9.4,104,22,9,"PAH",22,1,23,0)="set as a multiple in order to accommodate the potential future need to "
^DIC(9.4,104,22,9,"PAH",22,1,24,0)="utilize an additional or different code type, such as CPT, for "
^DIC(9.4,104,22,9,"PAH",22,1,25,0)="association with a given Vital Type term. The data gathered from the "
^DIC(9.4,104,22,9,"PAH",22,1,26,0)="needed LOINC CT mapping effort will be used to populate this field."
^DIC(9.4,104,22,9,"PAH",22,1,27,0)="GMRV VITAL QUALIFIER (#120.52) file shall be updated to include a new "
^DIC(9.4,104,22,9,"PAH",22,1,28,0)="field to store the SNOMED CT code from the respective SDO. The new field "
^DIC(9.4,104,22,9,"PAH",22,1,29,0)="shall be set as a multiple in order to accommodate multiple SNOMED CT "
^DIC(9.4,104,22,9,"PAH",22,1,30,0)="codes per term within file 120.52, since there may be one-to-many "
^DIC(9.4,104,22,9,"PAH",22,1,31,0)="relationships in addition to one-to-one relationships when the active "
^DIC(9.4,104,22,9,"PAH",22,1,32,0)="terms in files 120.52 are associated to SNOMED CT codes. The data "
^DIC(9.4,104,22,9,"PAH",22,1,33,0)="gathered from the needed SNOMED CT mapping effort will be used to "
^DIC(9.4,104,22,9,"PAH",22,1,34,0)="populate this field."
^DIC(9.4,104,22,9,"PAH",22,1,35,0)="GMRV VITAL CATEGORY (#120.53) file shall be updated to include a new "
^DIC(9.4,104,22,9,"PAH",22,1,36,0)="field to store the SNOMED CT code from the respective SDO. The new field "
^DIC(9.4,104,22,9,"PAH",22,1,37,0)="shall be set as a multiple in order to accommodate multiple SNOMED CT "
^DIC(9.4,104,22,9,"PAH",22,1,38,0)="codes per term within file 120.53 since there may be one to many "
^DIC(9.4,104,22,9,"PAH",22,1,39,0)="relationships in addition to one to one when the active terms in files "
^DIC(9.4,104,22,9,"PAH",22,1,40,0)="120.53 are associated to SNOMED CT codes. The data gathered from the "
^DIC(9.4,104,22,9,"PAH",22,1,41,0)="needed SNOMED CT mapping effort will be used to populate this field."
^DIC(9.4,104,22,9,"PAH",23,0)="32^3170123.14263^54"
^DIC(9.4,104,22,9,"PAH",24,0)="35 SEQ #24^3170313.144046^54"
^DIC(9.4,104,22,9,"PAH",25,0)="27 SEQ #25^3170504.173615^54"
^DIC(9.4,104,22,9,"PAH",25,1,0)="^^4^4^3170504"
^DIC(9.4,104,22,9,"PAH",25,1,1,0)="In preparation for the VA's transition to become two factor authentication"
^DIC(9.4,104,22,9,"PAH",25,1,2,0)="(2FA) compliant the Vitals User and Vitals Manager Graphical User "
^DIC(9.4,104,22,9,"PAH",25,1,3,0)="Interface (GUI) requires an upgrade to Delphi version XE8 in order to "
^DIC(9.4,104,22,9,"PAH",25,1,4,0)="implement the new Remote Procedure Call (RPC) Broker allowing compliance."
^DIC(9.4,104,22,9,"PAH",26,0)="31 SEQ #26^3170929.16365^54"
