^DIC(9.4,49,22,10,"PAH",669,1,0)="^^4^4^3250116"
^DIC(9.4,49,22,10,"PAH",669,1,1,0)="Integrated Billing patch, IB*2.0*810, updates the administrative"
^DIC(9.4,49,22,10,"PAH",669,1,2,0)="charge based on the following rate types, with new dispensing fee for"
