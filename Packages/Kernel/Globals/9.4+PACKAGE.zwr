^DIC(9.4,14,22,5.9,"PAH",143,1,68,0)="    LR320            N/A              2912182      320(Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",143,1,69,0)="    LREPI1           11822436         11922889     132,157,175,260,281,320"
^DIC(9.4,14,22,5.9,"PAH",143,1,70,0)="    LREPI2           8491199          8531292      132,157,175,242,260,281,320"
^DIC(9.4,14,22,5.9,"PAH",143,1,71,0)="    LREPI3           9184652          9874365      132,175,260,281,320"
^DIC(9.4,14,22,5.9,"PAH",143,1,72,0)="    LREPIRP          20442264         20526099     132,157,175,260,281,320"
^DIC(9.4,14,22,5.9,"PAH",143,1,73,0)="    LREPIRP5         11788836         11827526     281,320"
^DIC(9.4,14,22,5.9,"PAH",143,1,74,0)="    LREPIRP7         17171829         17482896     281,320"
^DIC(9.4,14,22,5.9,"PAH",143,1,75,0)=""
^DIC(9.4,14,22,5.9,"PAH",143,1,76,0)=" ASSOCIATED NOIS:"
^DIC(9.4,14,22,5.9,"PAH",143,1,77,0)=" ================"
^DIC(9.4,14,22,5.9,"PAH",143,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",143,1,79,0)=" PHO-0604-62256"
^DIC(9.4,14,22,5.9,"PAH",143,1,80,0)=" DUR-0604-31907"
^DIC(9.4,14,22,5.9,"PAH",143,1,81,0)=" CTX-0604-71980"
^DIC(9.4,14,22,5.9,"PAH",143,1,82,0)=" DAY-0704-40732"
^DIC(9.4,14,22,5.9,"PAH",143,1,83,0)=""
