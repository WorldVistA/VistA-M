^DIC(9.4,11,22,5.03,"PAH",31,1,259,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",31,1,260,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",31,1,261,0)=" "
^DIC(9.4,11,22,5.03,"PAH",31,1,262,0)="See LABORATORY ELECTRONIC DATA INTERCHANGE III (LEDI III) INSTALLATION GUIDE"
^DIC(9.4,11,22,5.03,"PAH",31,1,263,0)="    LA*5.2*64/LR*5.2*286"
^DIC(9.4,11,22,5.03,"PAH",32,0)="71 SEQ #52^3050611^1"
^DIC(9.4,11,22,5.03,"PAH",32,1,0)="^^199^199^3050611"
^DIC(9.4,11,22,5.03,"PAH",32,1,1,0)="Blood Bank Clearance"
^DIC(9.4,11,22,5.03,"PAH",32,1,2,0)="===================="
^DIC(9.4,11,22,5.03,"PAH",32,1,3,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*71 does not"
^DIC(9.4,11,22,5.03,"PAH",32,1,4,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,11,22,5.03,"PAH",32,1,5,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,11,22,5.03,"PAH",32,1,6,0)=""
^DIC(9.4,11,22,5.03,"PAH",32,1,7,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*71 does not"
^DIC(9.4,11,22,5.03,"PAH",32,1,8,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,11,22,5.03,"PAH",32,1,9,0)="functions."
^DIC(9.4,11,22,5.03,"PAH",32,1,10,0)=""
^DIC(9.4,11,22,5.03,"PAH",32,1,11,0)="RISK ANALYSIS: Changes made by patch LA*5.2*71 have no effect on Blood"
^DIC(9.4,11,22,5.03,"PAH",32,1,12,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",32,1,13,0)=""
^DIC(9.4,11,22,5.03,"PAH",32,1,14,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes"
^DIC(9.4,11,22,5.03,"PAH",32,1,15,0)="made, no specific validation requirements exist as a result of installation"
^DIC(9.4,11,22,5.03,"PAH",32,1,16,0)="of this patch."
^DIC(9.4,11,22,5.03,"PAH",32,1,17,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,19,0)="NOIS NCH-0105-417985 reported the inability to verify corrected "
^DIC(9.4,11,22,5.03,"PAH",32,1,20,0)="Laboratory Electronic Data Interchange (LEDI) results when the reference"
^DIC(9.4,11,22,5.03,"PAH",32,1,21,0)="(host) laboratory removes the previously reported result and changes the"
^DIC(9.4,11,22,5.03,"PAH",32,1,22,0)="result to 'pending'. The result of 'pending' was not being sent to the"
^DIC(9.4,11,22,5.03,"PAH",32,1,23,0)="collecting facility via LEDI HL7 messaging."
^DIC(9.4,11,22,5.03,"PAH",32,1,24,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,25,0)="This patch allows users at the collecting facility who are verifying"
^DIC(9.4,11,22,5.03,"PAH",32,1,26,0)="reference laboratory results to release amended (corrected) results"
^DIC(9.4,11,22,5.03,"PAH",32,1,27,0)="that are 'pending'."
^DIC(9.4,11,22,5.03,"PAH",32,1,28,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,29,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,30,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,31,0)=" ASSOCIATED E3R"
^DIC(9.4,11,22,5.03,"PAH",32,1,32,0)=" --------------"
^DIC(9.4,11,22,5.03,"PAH",32,1,33,0)=" None"
^DIC(9.4,11,22,5.03,"PAH",32,1,34,0)=" "
^DIC(9.4,11,22,5.03,"PAH",32,1,35,0)=" ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",32,1,36,0)=" ---------------"
^DIC(9.4,11,22,5.03,"PAH",32,1,37,0)=" NCH-0105-417985/Remedy ticket HD0000000071220"
