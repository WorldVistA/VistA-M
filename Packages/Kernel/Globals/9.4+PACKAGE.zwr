^DIC(9.4,148,22,8,"PAH",3,1,103,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,104,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,105,0)="General Information"
^DIC(9.4,148,22,8,"PAH",3,1,106,0)="==================="
^DIC(9.4,148,22,8,"PAH",3,1,107,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,108,0)="This patch should be installed into your production UCI.  It can be"
^DIC(9.4,148,22,8,"PAH",3,1,109,0)="installed at anytime.  Install time should not take more than ten minutes."
^DIC(9.4,148,22,8,"PAH",3,1,110,0)="This patch has no other dependencies.  No options need to be disabled."
^DIC(9.4,148,22,8,"PAH",3,1,111,0)="If there are any questions, your supporting CIOFO Customer Service Patient"
^DIC(9.4,148,22,8,"PAH",3,1,112,0)="Information Management team will address them."
^DIC(9.4,148,22,8,"PAH",3,1,113,0)="  "
^DIC(9.4,148,22,8,"PAH",3,1,114,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,115,0)="Installation instructions:                                                 "
^DIC(9.4,148,22,8,"PAH",3,1,116,0)="=========================                                                 "
^DIC(9.4,148,22,8,"PAH",3,1,117,0)="                                                                         "
^DIC(9.4,148,22,8,"PAH",3,1,118,0)="This Patch is created with Kernel V8 KIDS.  Follow these instructions:      "
^DIC(9.4,148,22,8,"PAH",3,1,119,0)="                                                                           "
^DIC(9.4,148,22,8,"PAH",3,1,120,0)="1) Use Packman option 'INSTALL/CHECK MESSAGE' to load the KIDS build onto    "
^DIC(9.4,148,22,8,"PAH",3,1,121,0)="   your system.                                                              "
^DIC(9.4,148,22,8,"PAH",3,1,122,0)="2) On the KIDS menu, under the 'Installation' menu, use the option 'Verify    "
^DIC(9.4,148,22,8,"PAH",3,1,123,0)="   Checksum in Transport Global' and verify that all routines have the      "
^DIC(9.4,148,22,8,"PAH",3,1,124,0)="   correct checksums.                                                        "
^DIC(9.4,148,22,8,"PAH",3,1,125,0)="3) From the 'Installation' Menu of KIDS, use the option 'Install             "
^DIC(9.4,148,22,8,"PAH",3,1,126,0)="   Package(s)'.  Select the package 'SPN*2*3' and proceed with install.      "
^DIC(9.4,148,22,8,"PAH",3,1,127,0)="4) If you are a MSM site, move the routines to the other servers.            "
^DIC(9.4,148,22,8,"PAH",3,1,128,0)="5) On a mapped system, rebuild your map set.                                  "
^DIC(9.4,148,22,8,"PAH",3,1,129,0)="6) Delete the post-init routine SPNPST03.                                "
