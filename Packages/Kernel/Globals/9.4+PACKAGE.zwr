^DIC(9.4,3,22,21,"PAH",158,1,84,0)="List of preceding patches: 36, 102, 149, 150"
^DIC(9.4,3,22,21,"PAH",158,1,85,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",158,1,86,0)=" "
^DIC(9.4,3,22,21,"PAH",158,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",158,1,88,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",158,1,89,0)="Installation: "
^DIC(9.4,3,22,21,"PAH",158,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",158,1,91,0)=">>>Users may remain on the system.  "
^DIC(9.4,3,22,21,"PAH",158,1,92,0)=">>>Taskman does not need to be stopped.  "
^DIC(9.4,3,22,21,"PAH",158,1,93,0)=" "
^DIC(9.4,3,22,21,"PAH",158,1,94,0)="  1.  DSM sites - Some of these routines are usually mapped, "
^DIC(9.4,3,22,21,"PAH",158,1,95,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",158,1,96,0)="     "
^DIC(9.4,3,22,21,"PAH",158,1,97,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",158,1,98,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",158,1,99,0)="     "
^DIC(9.4,3,22,21,"PAH",158,1,100,0)="  3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",158,1,101,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,3,22,21,"PAH",158,1,102,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,3,22,21,"PAH",158,1,103,0)="      options: "
^DIC(9.4,3,22,21,"PAH",158,1,104,0)="      "
^DIC(9.4,3,22,21,"PAH",158,1,105,0)="         Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",158,1,106,0)="         Print Transport Global "
^DIC(9.4,3,22,21,"PAH",158,1,107,0)="         Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",158,1,108,0)="         Backup a Transport Global "
^DIC(9.4,3,22,21,"PAH",158,1,109,0)="     "
^DIC(9.4,3,22,21,"PAH",158,1,110,0)="  4.  Users can remain on the system if installed at non-peak hours."
^DIC(9.4,3,22,21,"PAH",158,1,111,0)="      There is a small chance that a user could get a CLOBER error if they"
^DIC(9.4,3,22,21,"PAH",158,1,112,0)="      are signing on at the time the routines change.  "
^DIC(9.4,3,22,21,"PAH",158,1,113,0)="      This patch can be queued and installed at non-peak time.  "
^DIC(9.4,3,22,21,"PAH",158,1,114,0)="      TASKMAN can remain running.  "
^DIC(9.4,3,22,21,"PAH",158,1,115,0)="           "
^DIC(9.4,3,22,21,"PAH",158,1,116,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,3,22,21,"PAH",158,1,117,0)="      option: "
^DIC(9.4,3,22,21,"PAH",158,1,118,0)="        Install Package(s)  'XU*8.0*180' "
^DIC(9.4,3,22,21,"PAH",158,1,119,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",158,1,120,0)="         "
^DIC(9.4,3,22,21,"PAH",158,1,121,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO "
^DIC(9.4,3,22,21,"PAH",158,1,122,0)="        "
^DIC(9.4,3,22,21,"PAH",158,1,123,0)="        No Options or Protocols need to be placed out-of-order.  "
^DIC(9.4,3,22,21,"PAH",158,1,124,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO "
^DIC(9.4,3,22,21,"PAH",158,1,125,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",158,1,126,0)="     "
^DIC(9.4,3,22,21,"PAH",158,1,127,0)="  6.  DSM Sites, after patch has installed, rebuild your map set.  "
^DIC(9.4,3,22,21,"PAH",158,1,128,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",159,0)="184 SEQ #166^3010507^1"
^DIC(9.4,3,22,21,"PAH",160,0)="155 SEQ #167^3010608^1"
^DIC(9.4,3,22,21,"PAH",160,1,0)="^^78^78^3010608"
^DIC(9.4,3,22,21,"PAH",160,1,1,0)="                              XU*8*155"
^DIC(9.4,3,22,21,"PAH",160,1,2,0)="Description"
^DIC(9.4,3,22,21,"PAH",160,1,3,0)="==========="
^DIC(9.4,3,22,21,"PAH",160,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,5,0)="        With the advent of the Cache 3.2 Operating system the underlying"
^DIC(9.4,3,22,21,"PAH",160,1,6,0)="character set of ASCII has been changed to Latin I, an ISO standard that"
^DIC(9.4,3,22,21,"PAH",160,1,7,0)="the VA supports.  This change caused, however, an ancient piece of code to"
^DIC(9.4,3,22,21,"PAH",160,1,8,0)="break that has been promulgated throughout the Menu System over the years"
^DIC(9.4,3,22,21,"PAH",160,1,9,0)="which was used to change strings of code to all uppercase.  White City"
^DIC(9.4,3,22,21,"PAH",160,1,10,0)="experienced an endless loop when control characters were somehow"
^DIC(9.4,3,22,21,"PAH",160,1,11,0)="entered into the prompt looking for an option name.  This patch changes"
^DIC(9.4,3,22,21,"PAH",160,1,12,0)="those errant lines of code to standard, Kernel calls to UP^%XLFSTR()."
^DIC(9.4,3,22,21,"PAH",160,1,13,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,14,0)="List of Test Sites"
^DIC(9.4,3,22,21,"PAH",160,1,15,0)="=================="
^DIC(9.4,3,22,21,"PAH",160,1,16,0)="White City, OR"
^DIC(9.4,3,22,21,"PAH",160,1,17,0)="Roseburg, OR"
^DIC(9.4,3,22,21,"PAH",160,1,18,0)="Bay Pines, FLA"
^DIC(9.4,3,22,21,"PAH",160,1,19,0)="Mike Boggess"
^DIC(9.4,3,22,21,"PAH",160,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,21,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",160,1,22,0)="==============="
^DIC(9.4,3,22,21,"PAH",160,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",160,1,24,0)="The second line of these routines should look like this:"
