^DIC(9.4,14,22,5.9,"PAH",233,1,166,0)="LR7OU5          13182116         12982551      127,201,272,334"
^DIC(9.4,14,22,5.9,"PAH",233,1,167,0)="LRLNCC          2634007          2869430       232,280,334"
^DIC(9.4,14,22,5.9,"PAH",233,1,168,0)="LRLNCST         N/A              5628677       334"
^DIC(9.4,14,22,5.9,"PAH",233,1,169,0)=" "
^DIC(9.4,14,22,5.9,"PAH",233,1,170,0)=" "
