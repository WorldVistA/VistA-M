^DIC(9.4,3,22,21,"PAH",45,1,57,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",45,1,58,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",45,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",45,1,60,0)="  1.  DSM sites - Some of these routines may be mapped,"
^DIC(9.4,3,22,21,"PAH",45,1,61,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",45,1,62,0)="      "
^DIC(9.4,3,22,21,"PAH",45,1,63,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",45,1,64,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",45,1,65,0)="      "
^DIC(9.4,3,22,21,"PAH",45,1,66,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",45,1,67,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",45,1,68,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",45,1,69,0)="      options:"
^DIC(9.4,3,22,21,"PAH",45,1,70,0)="      "
^DIC(9.4,3,22,21,"PAH",45,1,71,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",45,1,72,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",45,1,73,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",45,1,74,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",45,1,75,0)="         "
^DIC(9.4,3,22,21,"PAH",45,1,76,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",45,1,77,0)="      non-peek time."
^DIC(9.4,3,22,21,"PAH",45,1,78,0)="      "
^DIC(9.4,3,22,21,"PAH",45,1,79,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",45,1,80,0)="      option:"
^DIC(9.4,3,22,21,"PAH",45,1,81,0)="         Install Package(s)  'XU*8.0*71'"
^DIC(9.4,3,22,21,"PAH",45,1,82,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",45,1,83,0)="         "
^DIC(9.4,3,22,21,"PAH",45,1,84,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",45,1,85,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",45,1,86,0)="      "
^DIC(9.4,3,22,21,"PAH",45,1,87,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",45,1,88,0)="      DSM sites - you need to move one routines from "
^DIC(9.4,3,22,21,"PAH",45,1,89,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",45,1,90,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",45,1,91,0)="      ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",45,1,92,0)="      "
^DIC(9.4,3,22,21,"PAH",45,1,93,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",45,1,94,0)="       "
^DIC(9.4,3,22,21,"PAH",45,1,95,0)="      DSM sites:"
^DIC(9.4,3,22,21,"PAH",45,1,96,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",45,1,97,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",45,1,98,0)="      Patch number to load: 71"
^DIC(9.4,3,22,21,"PAH",45,1,99,0)="                            =="
^DIC(9.4,3,22,21,"PAH",45,1,100,0)="                            "
^DIC(9.4,3,22,21,"PAH",45,1,101,0)="  9.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",45,1,102,0)=""
^DIC(9.4,3,22,21,"PAH",45,1,103,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",45,1,104,0)=""
^DIC(9.4,3,22,21,"PAH",46,0)="77 SEQ #60^2980403^1"
^DIC(9.4,3,22,21,"PAH",46,1,0)="^^47^47^2980403"
^DIC(9.4,3,22,21,"PAH",46,1,1,0)="BOI-0398-52635,  BRX-0398-12325"
^DIC(9.4,3,22,21,"PAH",46,1,2,0)="HIN-0398-42171   XUWORKDY"
^DIC(9.4,3,22,21,"PAH",46,1,3,0)="During the fixing of XUWORKDY for Y2K issues the changes weren't tested"
^DIC(9.4,3,22,21,"PAH",46,1,4,0)="with data that couldn't be calculated.  Dates missing the month or day"
^DIC(9.4,3,22,21,"PAH",46,1,5,0)="are invalid. "
^DIC(9.4,3,22,21,"PAH",46,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",46,1,7,0)="DAY-0398-42487"
^DIC(9.4,3,22,21,"PAH",46,1,8,0)="HOU-0398-72500   XTER2"
^DIC(9.4,3,22,21,"PAH",46,1,9,0)="During the fixing of XTER2 for Y2K issues, Testing didn't find that"
^DIC(9.4,3,22,21,"PAH",46,1,10,0)="entering mm/dd/yy would not report the errors there were on that date."
^DIC(9.4,3,22,21,"PAH",46,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",46,1,12,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",46,1,13,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",46,1,14,0)="XTER2        10464968  10468040    **71,77**"
^DIC(9.4,3,22,21,"PAH",46,1,15,0)="XUWORKDY       902683    908391    **65,71,77**"
^DIC(9.4,3,22,21,"PAH",46,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",46,1,17,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",46,1,18,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",46,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",46,1,20,0)="  1.  DSM sites - This routine may be mapped,"
^DIC(9.4,3,22,21,"PAH",46,1,21,0)="      so you will need to disable mapping for the effected routines. "
^DIC(9.4,3,22,21,"PAH",46,1,22,0)="     "
^DIC(9.4,3,22,21,"PAH",46,1,23,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",46,1,24,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",46,1,25,0)="     "
^DIC(9.4,3,22,21,"PAH",46,1,26,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",46,1,27,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",46,1,28,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",46,1,29,0)="      options:"
^DIC(9.4,3,22,21,"PAH",46,1,30,0)="      "
^DIC(9.4,3,22,21,"PAH",46,1,31,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",46,1,32,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",46,1,33,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",46,1,34,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",46,1,35,0)="     "
^DIC(9.4,3,22,21,"PAH",46,1,36,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",46,1,37,0)="      non-peak time.  (There is a very small possibility of some CLOBER"
^DIC(9.4,3,22,21,"PAH",46,1,38,0)="      errors)"
^DIC(9.4,3,22,21,"PAH",46,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",46,1,40,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",46,1,41,0)="      option:"
^DIC(9.4,3,22,21,"PAH",46,1,42,0)="        Install Package(s)  'XU*8.0*77'"
^DIC(9.4,3,22,21,"PAH",46,1,43,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",46,1,44,0)="        "
^DIC(9.4,3,22,21,"PAH",46,1,45,0)="     "
^DIC(9.4,3,22,21,"PAH",46,1,46,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",46,1,47,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",47,0)="62^2970807"
^DIC(9.4,3,22,21,"PAH",47,1,0)="^^18^18^2980408"
^DIC(9.4,3,22,21,"PAH",47,1,1,0)="Enhancements to Unwinder routines (XQOR*) in support of CPRS 1.0"
^DIC(9.4,3,22,21,"PAH",47,1,2,0)="These enhancements include:"
^DIC(9.4,3,22,21,"PAH",47,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",47,1,4,0)="  1) A new parameter which may be passed to XQORM - XQORM(""ALT"")"
^DIC(9.4,3,22,21,"PAH",47,1,5,0)="     This allows the calling routine to supply an alternative lookup"
^DIC(9.4,3,22,21,"PAH",47,1,6,0)="     to be used if the user types something that does not appear on"
^DIC(9.4,3,22,21,"PAH",47,1,7,0)="     the menu."
^DIC(9.4,3,22,21,"PAH",47,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",47,1,9,0)="  2) Fixed a bug that caused the menu to be exited if numeric ranges"
^DIC(9.4,3,22,21,"PAH",47,1,10,0)="     were allowed, the user erroneously entered something like 1-4B,"
^DIC(9.4,3,22,21,"PAH",47,1,11,0)="     and then typed a return at 'For entry 1-4B enter: ""."
^DIC(9.4,3,22,21,"PAH",47,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",47,1,13,0)="  3) Added ""E"" as a flag for XQORM(0).  It will allow ambiguous lookups"
^DIC(9.4,3,22,21,"PAH",47,1,14,0)="     to be resolved interactively when XQORM is called without XQORM(0)"
^DIC(9.4,3,22,21,"PAH",47,1,15,0)="     containing an ""A""."
^DIC(9.4,3,22,21,"PAH",47,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",47,1,17,0)="  4) Made a change that sets full screen earlier when being called by"
^DIC(9.4,3,22,21,"PAH",47,1,18,0)="     list manager so that selection lists are properly displayed."
^DIC(9.4,3,22,21,"PAH",48,0)="68^2980213"
^DIC(9.4,3,22,21,"PAH",48,1,0)="^^74^74^2980408"
^DIC(9.4,3,22,21,"PAH",48,1,1,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",48,1,2,0)="    ****** This patch must be QUEUED during the install process ******"
^DIC(9.4,3,22,21,"PAH",48,1,3,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",48,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",48,1,5,0)="This patch contains fixes that were identified by mail messages and E3R"
^DIC(9.4,3,22,21,"PAH",48,1,6,0)=" -A patch will not be installed if the site is not running the correct version"
^DIC(9.4,3,22,21,"PAH",48,1,7,0)="  for the package."
^DIC(9.4,3,22,21,"PAH",48,1,8,0)=" -Multiple Build definition will now be sent to the site, along with all the"
^DIC(9.4,3,22,21,"PAH",48,1,9,0)="  builds that make up the Multiple Build."
^DIC(9.4,3,22,21,"PAH",48,1,10,0)="  E3R #10306."
^DIC(9.4,3,22,21,"PAH",48,1,11,0)=" -Protocols will now delete properly at the site."
^DIC(9.4,3,22,21,"PAH",48,1,12,0)=" -The variable XPDABORT will correctly abort the install in both the Pre &"
^DIC(9.4,3,22,21,"PAH",48,1,13,0)="  Post install routines."
^DIC(9.4,3,22,21,"PAH",48,1,14,0)=" -The variable DIR is newed before call to environment check routine."
^DIC(9.4,3,22,21,"PAH",48,1,15,0)="  ISW-0597-21778"
^DIC(9.4,3,22,21,"PAH",48,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",48,1,17,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",48,1,18,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",48,1,19,0)="   Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",48,1,20,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",48,1,21,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",48,1,22,0)=""
