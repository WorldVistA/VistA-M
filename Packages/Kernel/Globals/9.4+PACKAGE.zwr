^DIC(9.4,127,22,0)="^9.49I^3^1"
^DIC(9.4,127,22,3,0)="3.0^3051119^2960829"
^DIC(9.4,127,22,3,"PAH",0)="^9.4901^155^155"
^DIC(9.4,127,22,3,"PAH",1,0)="58^2961022^1"
^DIC(9.4,127,22,3,"PAH",1,1,0)="^^1^1^2961022"
^DIC(9.4,127,22,3,"PAH",1,1,1,0)="Surgery patch SR*3*58, SURGERY INTERFACE TO PCE."
^DIC(9.4,127,22,3,"PAH",2,0)="55^2970122^1"
^DIC(9.4,127,22,3,"PAH",3,0)="61 SEQ #56^2970122^1"
^DIC(9.4,127,22,3,"PAH",4,0)="48^2970122^1"
^DIC(9.4,127,22,3,"PAH",4,1,0)="^^3^3^2970122"
^DIC(9.4,127,22,3,"PAH",4,1,1,0)="This patch installs the SURGERY DISPOSITION file (#131.6), converts the"
^DIC(9.4,127,22,3,"PAH",4,1,2,0)="three disposition fields to point to this file and updates reports that"
^DIC(9.4,127,22,3,"PAH",4,1,3,0)="access disposition data."
^DIC(9.4,127,22,3,"PAH",5,0)="62 SEQ #58^2970326^1"
^DIC(9.4,127,22,3,"PAH",5,1,0)="^^1^1^2970326"
^DIC(9.4,127,22,3,"PAH",5,1,1,0)="Surgery Patch SR*3*62."
^DIC(9.4,127,22,3,"PAH",6,0)="63 SEQ #59^2970414^1"
^DIC(9.4,127,22,3,"PAH",6,1,0)="^^1^1^2970414"
^DIC(9.4,127,22,3,"PAH",6,1,1,0)="Surgery patch SR*3*63, Fixes and Enhancements."
^DIC(9.4,127,22,3,"PAH",7,0)="64 SEQ #60^2970414^1"
^DIC(9.4,127,22,3,"PAH",7,1,0)="^^2^2^2970414"
^DIC(9.4,127,22,3,"PAH",7,1,1,0)="The information contained in this KIDS Build relates to the Surgery patch"
^DIC(9.4,127,22,3,"PAH",7,1,2,0)="SR*3*64."
^DIC(9.4,127,22,3,"PAH",8,0)="65 SEQ #61^2970501^1"
^DIC(9.4,127,22,3,"PAH",9,0)="67 SEQ #62^2970528^1"
^DIC(9.4,127,22,3,"PAH",9,1,0)="^^1^1^2970528"
^DIC(9.4,127,22,3,"PAH",9,1,1,0)="This is Surgery patch SR*3*67."
^DIC(9.4,127,22,3,"PAH",10,0)="66 SEQ #63^2970625^1"
^DIC(9.4,127,22,3,"PAH",10,1,0)="^^1^1^2970625"
^DIC(9.4,127,22,3,"PAH",10,1,1,0)="Surgery patch SR*3*66 includes modifications specifically for Imaging."
^DIC(9.4,127,22,3,"PAH",11,0)="69 SEQ #64^2970922^1"
^DIC(9.4,127,22,3,"PAH",11,1,0)="^^1^1^2970922"
^DIC(9.4,127,22,3,"PAH",11,1,1,0)="Surgery patch SR*3*69 - Surgery/PCE/NPCD Reporting"
^DIC(9.4,127,22,3,"PAH",12,0)="68 SEQ #65^2970922^1"
^DIC(9.4,127,22,3,"PAH",12,1,0)="^^1^1^2970922"
^DIC(9.4,127,22,3,"PAH",12,1,1,0)="Surgery patch SR*3*68 - July 97 Fixes and Updates"
^DIC(9.4,127,22,3,"PAH",13,0)="71 SEQ #66^2971105^1"
^DIC(9.4,127,22,3,"PAH",13,1,0)="^^1^1^2971105"
^DIC(9.4,127,22,3,"PAH",13,1,1,0)="National Surgical Quality Improvement Program (NSQIP) enhancements patch."
^DIC(9.4,127,22,3,"PAH",14,0)="70 SEQ #67^2971118^1"
^DIC(9.4,127,22,3,"PAH",14,1,0)="^^1^1^2971118"
^DIC(9.4,127,22,3,"PAH",14,1,1,0)="Surgery patch SR*3*70 - September 97 Fixes"
^DIC(9.4,127,22,3,"PAH",15,0)="76 SEQ #68^2980112^1"
^DIC(9.4,127,22,3,"PAH",15,1,0)="^^3^3^2980112"
^DIC(9.4,127,22,3,"PAH",15,1,1,0)="This patch removes the SURGEON'S OPERATION TIMES file (#131.2) from your"
^DIC(9.4,127,22,3,"PAH",15,1,2,0)="system. This file has been obsolete since the release of Surgery V. 3.0 in"
^DIC(9.4,127,22,3,"PAH",15,1,3,0)="1993."
^DIC(9.4,127,22,3,"PAH",16,0)="72 SEQ #69^2980112^1"
^DIC(9.4,127,22,3,"PAH",16,1,0)="^^10^10^2980112"
^DIC(9.4,127,22,3,"PAH",16,1,1,0)="This patch modifies the routine ^SROCODE used for flagging anesthesia"
^DIC(9.4,127,22,3,"PAH",16,1,2,0)="agents. With the release of Pharmacy Data Management V. 1.0, existing"
^DIC(9.4,127,22,3,"PAH",16,1,3,0)="calls to the Inpatient Medications routine ^PSGIU will be replaced by"
^DIC(9.4,127,22,3,"PAH",16,1,4,0)="the Pharmacy Data Management routine ^PSSGIU.  This modification allows"
^DIC(9.4,127,22,3,"PAH",16,1,5,0)="the function to work with or without the installation of Pharmacy"
^DIC(9.4,127,22,3,"PAH",16,1,6,0)="Data Management V. 1.0."
^DIC(9.4,127,22,3,"PAH",16,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",16,1,8,0)="This patch also modifies the routine ^SROXR1 which is used for canceling"
^DIC(9.4,127,22,3,"PAH",16,1,9,0)="IV orders upon start of a surgical procedure. This routine has been"
^DIC(9.4,127,22,3,"PAH",16,1,10,0)="enhanced to create a background task for performing this function."
^DIC(9.4,127,22,3,"PAH",17,0)="73 SEQ #70^2980112^1"
^DIC(9.4,127,22,3,"PAH",17,1,0)="^^11^11^2980112"
^DIC(9.4,127,22,3,"PAH",17,1,1,0)="This patch contains modifications to routines used to file information to"
^DIC(9.4,127,22,3,"PAH",17,1,2,0)="OE/RR. Changes will allow the software to function in it's current form"
^DIC(9.4,127,22,3,"PAH",17,1,3,0)="when using Order Entry/Results Reporting V2.5, but will inactivate the"
^DIC(9.4,127,22,3,"PAH",17,1,4,0)="interface for sites using CPRS and Order Entry/Results Reporting V3.0. The"
^DIC(9.4,127,22,3,"PAH",17,1,5,0)="interface for Surgery used within Order Entry/Results Reporting V2.5 is"
^DIC(9.4,127,22,3,"PAH",17,1,6,0)="not supported with CPRS and Order Entry/Results Reporting V3.0, causing"
^DIC(9.4,127,22,3,"PAH",17,1,7,0)="errors when using the Surgery software."
^DIC(9.4,127,22,3,"PAH",17,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",17,1,9,0)="At the time of release of this patch, it is unclear when the interface"
^DIC(9.4,127,22,3,"PAH",17,1,10,0)="between Surgery and Order Entry/Results Reporting will be reestablished. A"
^DIC(9.4,127,22,3,"PAH",17,1,11,0)="future patch will be necessary when that time comes."
^DIC(9.4,127,22,3,"PAH",18,0)="75 SEQ #71^2980129^1"
^DIC(9.4,127,22,3,"PAH",18,1,0)="^^1^1^2980129"
^DIC(9.4,127,22,3,"PAH",18,1,1,0)="Surgery patch SR*3*75 - DELAYED OP REPORT COMMENTS ERROR"
^DIC(9.4,127,22,3,"PAH",19,0)="78 SEQ #72^2980227^1"
^DIC(9.4,127,22,3,"PAH",19,1,0)="^^4^4^2980227"
^DIC(9.4,127,22,3,"PAH",19,1,1,0)="This patch modifies the routines SROCON and SROCON1 used in creating the"
^DIC(9.4,127,22,3,"PAH",19,1,2,0)="data to be stored in Concurrent Cases. A problem was discovered when a"
^DIC(9.4,127,22,3,"PAH",19,1,3,0)="free text field contained a semi colon (;). The patch resolves this"
^DIC(9.4,127,22,3,"PAH",19,1,4,0)="problem."
^DIC(9.4,127,22,3,"PAH",20,0)="77^2980330^1"
^DIC(9.4,127,22,3,"PAH",20,1,0)="^^2^2^2980330"
^DIC(9.4,127,22,3,"PAH",20,1,1,0)="Patch SR*3*77 provides software renovations related to Y2K (Year 2000)"
^DIC(9.4,127,22,3,"PAH",20,1,2,0)="compliance."
^DIC(9.4,127,22,3,"PAH",21,0)="74^2980604^1"
^DIC(9.4,127,22,3,"PAH",21,1,0)="^^20^20^2980604"
^DIC(9.4,127,22,3,"PAH",21,1,1,0)=" This patch contains a new option [SR BLOOD PRODUCT VERIFICATION] within"
^DIC(9.4,127,22,3,"PAH",21,1,2,0)=" the VistA Surgery package which will be used for transfusion error risk"
^DIC(9.4,127,22,3,"PAH",21,1,3,0)=" management. The new option is contained on the Surgery ""Operations Menu""."
^DIC(9.4,127,22,3,"PAH",21,1,4,0)=" The option performs the following function; after scanning the blood unit"
^DIC(9.4,127,22,3,"PAH",21,1,5,0)=" ID, the software will check for an association with the patient"
^DIC(9.4,127,22,3,"PAH",21,1,6,0)=" identified. If there are multiple entries with the Unit ID scanned, these"
^DIC(9.4,127,22,3,"PAH",21,1,7,0)=" entries will be listed along with the Blood Component, Patient"
^DIC(9.4,127,22,3,"PAH",21,1,8,0)=" Associated, and Expiration Date. The user will then be prompted to select"
^DIC(9.4,127,22,3,"PAH",21,1,9,0)=" the one that matches the blood product about to be administered.  If the"
^DIC(9.4,127,22,3,"PAH",21,1,10,0)=" selected product is not associated with the patient identified, the"
^DIC(9.4,127,22,3,"PAH",21,1,11,0)=" warning message will be displayed."
^DIC(9.4,127,22,3,"PAH",21,1,12,0)=" "
^DIC(9.4,127,22,3,"PAH",21,1,13,0)=" A new option called [SR BLOOD PRODUCT VERIFY AUDIT] is included to allow"
^DIC(9.4,127,22,3,"PAH",21,1,14,0)=" auditing of the option above. It has been placed on the ""Chief of Surgery"
^DIC(9.4,127,22,3,"PAH",21,1,15,0)=" Menu"" on the ""Management Reports Menu""."
^DIC(9.4,127,22,3,"PAH",21,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",21,1,17,0)=" After installing this patch, IRM needs to turn on the KERNEL Audit Option"
^DIC(9.4,127,22,3,"PAH",21,1,18,0)=" by invoking the option, [XUAUDIT] for the new option exported with this"
^DIC(9.4,127,22,3,"PAH",21,1,19,0)=" patch [SR BLOOD PRODUCT VERIFICATION]. The expiration date for the audit"
^DIC(9.4,127,22,3,"PAH",21,1,20,0)=" should be set to a date 100 years into the future."
^DIC(9.4,127,22,3,"PAH",22,0)="41^2980712^1"
^DIC(9.4,127,22,3,"PAH",22,1,0)="^^6^6^2980725^^"
^DIC(9.4,127,22,3,"PAH",22,1,1,0)="The Surgery Interface is a generic interface that sends and receives"
^DIC(9.4,127,22,3,"PAH",22,1,2,0)="Surgery and Patient information by way of the VistA HL7 package.  The"
^DIC(9.4,127,22,3,"PAH",22,1,3,0)="interface consists of QRY (Query), ORU (Observation Results Unsolicited),"
^DIC(9.4,127,22,3,"PAH",22,1,4,0)="and ZIU (Scheduling Information Unsolicited) messages.  Certain specified"
^DIC(9.4,127,22,3,"PAH",22,1,5,0)="information is sent from the interface based on trigger events in the"
^DIC(9.4,127,22,3,"PAH",22,1,6,0)="VistA Surgery package."
^DIC(9.4,127,22,3,"PAH",23,0)="79 SEQ #76^2980725^1"
^DIC(9.4,127,22,3,"PAH",23,1,0)="^^12^12^2980725"
^DIC(9.4,127,22,3,"PAH",23,1,1,0)=" This patch adds ""ORAL"" as a medications route to the set of codes within"
^DIC(9.4,127,22,3,"PAH",23,1,2,0)=" Surgery file (#130) and modifies the routine SROMED to reflect this"
^DIC(9.4,127,22,3,"PAH",23,1,3,0)=" addition."
^DIC(9.4,127,22,3,"PAH",23,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",23,1,5,0)=" This patch also changes the definition of the field Major/Minor"
^DIC(9.4,127,22,3,"PAH",23,1,6,0)=" per Dr. Gerald McDonald, Acting Director, Surgical Service, VACO and the "
^DIC(9.4,127,22,3,"PAH",23,1,7,0)=" National Surgical Quality Improvement Program (NSQIP) Executive"
^DIC(9.4,127,22,3,"PAH",23,1,8,0)=" Committee."
^DIC(9.4,127,22,3,"PAH",23,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",23,1,10,0)=" This patch modifies the routine SROXR1 to correct a problem at entry"
^DIC(9.4,127,22,3,"PAH",23,1,11,0)=" point IV with an undefined variable 'Y' and converts a read/write at"
^DIC(9.4,127,22,3,"PAH",23,1,12,0)=" entry point IV1 to a FileMan call."
^DIC(9.4,127,22,3,"PAH",24,0)="83 SEQ #77^2980831^1"
^DIC(9.4,127,22,3,"PAH",24,1,0)="^^1^1^2980831"
^DIC(9.4,127,22,3,"PAH",24,1,1,0)="This is Surgery patch SR*3*83."
^DIC(9.4,127,22,3,"PAH",25,0)="82 SEQ #78^2981007^1"
^DIC(9.4,127,22,3,"PAH",25,1,0)="^^5^5^2981007"
^DIC(9.4,127,22,3,"PAH",25,1,1,0)="This patch modifies one Surgery routine, SROQM, which is used to transmit"
^DIC(9.4,127,22,3,"PAH",25,1,2,0)="mail messages related to the Quarterly Report.  Current code, while it"
^DIC(9.4,127,22,3,"PAH",25,1,3,0)="works properly, needs to be updated based on guidance received from the"
^DIC(9.4,127,22,3,"PAH",25,1,4,0)="MailMan development team.  The changes included in this patch should be"
^DIC(9.4,127,22,3,"PAH",25,1,5,0)="transparent."
^DIC(9.4,127,22,3,"PAH",26,0)="80 SEQ #79^2981007^1"
^DIC(9.4,127,22,3,"PAH",26,1,0)="^^5^5^2981007"
^DIC(9.4,127,22,3,"PAH",26,1,1,0)="This patch corrects an undefined variable condition when the OERR Task"
^DIC(9.4,127,22,3,"PAH",26,1,2,0)="Order Purge option [ORTASK PURGE] runs after installing patch SR*3*41."
^DIC(9.4,127,22,3,"PAH",26,1,3,0)="This patch also reinstalls the protocols included in patch SR*3*41.  The"
^DIC(9.4,127,22,3,"PAH",26,1,4,0)="install process for SR*3*41 did not properly update HL7 related fields for"
^DIC(9.4,127,22,3,"PAH",26,1,5,0)="these protocols in virgin installs."
^DIC(9.4,127,22,3,"PAH",27,0)="50^2981026^1"
^DIC(9.4,127,22,3,"PAH",27,1,0)="^^1^1^2981026"
^DIC(9.4,127,22,3,"PAH",27,1,1,0)="This is Surgery patch SR*3*50, REPORTS BY DIVISION & OTHER FIXES."
^DIC(9.4,127,22,3,"PAH",28,0)="84 SEQ #81^2981214^1"
^DIC(9.4,127,22,3,"PAH",28,1,0)="^^1^1^2981214"
^DIC(9.4,127,22,3,"PAH",28,1,1,0)="Surgery Patch SR*3*84 - XQUIT Processing"
^DIC(9.4,127,22,3,"PAH",29,0)="81 SEQ #82^2981229^1"
^DIC(9.4,127,22,3,"PAH",29,1,0)="^^1^1^2981229"
^DIC(9.4,127,22,3,"PAH",29,1,1,0)="Surgery patch SR*3*81 - NSQIP/VHA Directive 98-025"
^DIC(9.4,127,22,3,"PAH",30,0)="85 SEQ #83^2990223^1"
^DIC(9.4,127,22,3,"PAH",30,1,0)="^^5^5^2990223"
^DIC(9.4,127,22,3,"PAH",30,1,1,0)="This patch modifies one Surgery routine, SRBLOOD.  This routine is used by"
^DIC(9.4,127,22,3,"PAH",30,1,2,0)="the Blood Product Verification option [SR BLOOD PRODUCT VERIFICATION]."
^DIC(9.4,127,22,3,"PAH",30,1,3,0)="It is possible, but rare, that this routine could result in a software"
^DIC(9.4,127,22,3,"PAH",30,1,4,0)="error when reading the Blood Unit ID. This patch eliminates the potential"
^DIC(9.4,127,22,3,"PAH",30,1,5,0)="hole in the logic."
^DIC(9.4,127,22,3,"PAH",31,0)="86 SEQ #84^2990316^1"
^DIC(9.4,127,22,3,"PAH",31,1,0)="^^1^1^2990316"
^DIC(9.4,127,22,3,"PAH",31,1,1,0)="This is Surgery patch SR*3*86."
^DIC(9.4,127,22,3,"PAH",32,0)="87 SEQ #85^2990316^1"
^DIC(9.4,127,22,3,"PAH",32,1,0)="^^2^2^2990316"
^DIC(9.4,127,22,3,"PAH",32,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,127,22,3,"PAH",32,1,2,0)="of patch SR*3*87 in the National Patch Module."
^DIC(9.4,127,22,3,"PAH",33,0)="89 SEQ #86^2990622^1"
^DIC(9.4,127,22,3,"PAH",33,1,0)="^^4^4^2990622"
^DIC(9.4,127,22,3,"PAH",33,1,1,0)="This patch enhances the API written for the Imaging software. It updates"
^DIC(9.4,127,22,3,"PAH",33,1,2,0)="the data to use a 4-digit year format when sending the DATE OF OPERATION"
^DIC(9.4,127,22,3,"PAH",33,1,3,0)="field (#.09) from the SURGERY file (#130).  Changes have also been made to"
^DIC(9.4,127,22,3,"PAH",33,1,4,0)="provide the total number of images associated with the surgery case."
^DIC(9.4,127,22,3,"PAH",34,0)="91 SEQ #87^2990719^1"
^DIC(9.4,127,22,3,"PAH",34,1,0)="^^5^5^2990719"
^DIC(9.4,127,22,3,"PAH",34,1,1,0)=" Under some circumstances, incorrect nursing personnel were appearing on"
^DIC(9.4,127,22,3,"PAH",34,1,2,0)=" the Operation Report when using the option Batch Print Transcripted"
^DIC(9.4,127,22,3,"PAH",34,1,3,0)=" Operation Notes [SRSTRANS PRINT]. The problem occurs when a previous case"
^DIC(9.4,127,22,3,"PAH",34,1,4,0)=" in the batch has more entries for the fields OR SCRUB SUPPORT (#.112) or"
^DIC(9.4,127,22,3,"PAH",34,1,5,0)=" OR CIRC SUPPORT (#.111) of the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",35,0)="90 SEQ #88^2990803^1"
^DIC(9.4,127,22,3,"PAH",35,1,0)="^^16^16^2990803"
^DIC(9.4,127,22,3,"PAH",35,1,1,0)="1. Information from the STROKE/CVA field (#256) of the SURGERY file (#130)"
^DIC(9.4,127,22,3,"PAH",35,1,2,0)="was not correctly extracted for cardiac risk assessments. This patch"
^DIC(9.4,127,22,3,"PAH",35,1,3,0)="corrects the problem.  The patch also provides a post-installation routine"
^DIC(9.4,127,22,3,"PAH",35,1,4,0)="to retransmit missing information for all surgical cases in which the"
^DIC(9.4,127,22,3,"PAH",35,1,5,0)="STROKE/CVA field (#256) was answered ""YES""."
^DIC(9.4,127,22,3,"PAH",35,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",35,1,7,0)="2. This patch updates the cardiac assessment transmission routines"
^DIC(9.4,127,22,3,"PAH",35,1,8,0)="(SROATCM, SROATCM1 and SROATCM2) so that in references to the global ^TMP"
^DIC(9.4,127,22,3,"PAH",35,1,9,0)="the first two subscripts are a package namespaced subscript followed by"
^DIC(9.4,127,22,3,"PAH",35,1,10,0)="$J."
^DIC(9.4,127,22,3,"PAH",35,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",35,1,12,0)="3. The list of station numbers that identify medical centers that perform"
^DIC(9.4,127,22,3,"PAH",35,1,13,0)="cardiac surgery is updated in the routine SROAUTLC, replacing 525"
^DIC(9.4,127,22,3,"PAH",35,1,14,0)="(Brockton/West Roxbury) with 523 (Boston).  This routine is further"
^DIC(9.4,127,22,3,"PAH",35,1,15,0)="modified updating several reads and writes with calls to ^DIR and"
^DIC(9.4,127,22,3,"PAH",35,1,16,0)="EN^DDIOL."
^DIC(9.4,127,22,3,"PAH",36,0)="88^2991210^1"
^DIC(9.4,127,22,3,"PAH",36,1,0)="^^4^4^2991210"
^DIC(9.4,127,22,3,"PAH",36,1,1,0)="Surgery patch SR*3*88 provides the ability to enter CPT modifiers and"
^DIC(9.4,127,22,3,"PAH",36,1,2,0)="provides for displaying these CPT modifiers on screens and reports that"
^DIC(9.4,127,22,3,"PAH",36,1,3,0)="display CPT codes within the Surgery package.  The patch also includes"
^DIC(9.4,127,22,3,"PAH",36,1,4,0)="several software updates related to NSQIP and multi-division facilities."
^DIC(9.4,127,22,3,"PAH",37,0)="93 SEQ #90^3000405^1"
^DIC(9.4,127,22,3,"PAH",37,1,0)="^^42^42^3000405"
^DIC(9.4,127,22,3,"PAH",37,1,1,0)="1. The cardiac risk assessment transmission routines SROATCM, SROATCM1 and"
^DIC(9.4,127,22,3,"PAH",37,1,2,0)="SROATCM2 are modified by this patch to do the following:"
^DIC(9.4,127,22,3,"PAH",37,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,4,0)="   a. For both the admission and the discharge movements associated with"
^DIC(9.4,127,22,3,"PAH",37,1,5,0)="   the assessed operation, the entry in the TRANSFER FACILITY field (#.05)"
^DIC(9.4,127,22,3,"PAH",37,1,6,0)="   in the PATIENT MOVEMENT file (#405) is added to the transmission."
^DIC(9.4,127,22,3,"PAH",37,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,8,0)="   b. The patient's address, including street address, city and state, and"
^DIC(9.4,127,22,3,"PAH",37,1,9,0)="   the patient's phone number are added to the transmission."
^DIC(9.4,127,22,3,"PAH",37,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,11,0)="This patch includes a post-install process that will transmit the added"
^DIC(9.4,127,22,3,"PAH",37,1,12,0)="pieces of information for all cardiac assessments that have already"
^DIC(9.4,127,22,3,"PAH",37,1,13,0)="transmitted."
^DIC(9.4,127,22,3,"PAH",37,1,14,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,15,0)="2. For cardiac assessments, when using the Resource Data [SROA CARDIAC"
^DIC(9.4,127,22,3,"PAH",37,1,16,0)="RESOURCE] option or the Update Assessment Status to 'COMPLETE' [SROA"
^DIC(9.4,127,22,3,"PAH",37,1,17,0)="COMPLETE ASSESSMENT] option, if the admission date is later than the"
^DIC(9.4,127,22,3,"PAH",37,1,18,0)="discharge date, the following message will be displayed on the screen:"
^DIC(9.4,127,22,3,"PAH",37,1,19,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,20,0)="  ***  NOTE: Discharge Date precedes Admission Date!!  Please check.  ***"
^DIC(9.4,127,22,3,"PAH",37,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,22,0)="Similarly, when using the Cardiac Procedures Requiring CPB (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",37,1,23,0)="[SROA CARDIAC PROCEDURES] option or the Update Assessment Status to"
^DIC(9.4,127,22,3,"PAH",37,1,24,0)="'COMPLETE' [SROA COMPLETE ASSESSMENT] option, if the ischemic time is"
^DIC(9.4,127,22,3,"PAH",37,1,25,0)="greater than the CPB (cardiopulmonary bypass) time, the following message"
^DIC(9.4,127,22,3,"PAH",37,1,26,0)="will be displayed on the screen:"
^DIC(9.4,127,22,3,"PAH",37,1,27,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,28,0)="  ***  NOTE: Ischemic Time is greater than CPB Time!!  Please check.  ***"
^DIC(9.4,127,22,3,"PAH",37,1,29,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,30,0)="These changes require modifications to the routines SROACAR, SROACPM,"
^DIC(9.4,127,22,3,"PAH",37,1,31,0)="SROACR1 and SROACOM."
^DIC(9.4,127,22,3,"PAH",37,1,32,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,33,0)="3. The non-cardiac transmission routines SROATM1 and SROATMNO are modified"
^DIC(9.4,127,22,3,"PAH",37,1,34,0)="by this patch to add to the transmissions the entry in the INTUBATED ?"
^DIC(9.4,127,22,3,"PAH",37,1,35,0)="(Y/N) field (#42) for the principal anesthesia technique defined in the"
^DIC(9.4,127,22,3,"PAH",37,1,36,0)="ANESTHESIA TECHNIQUE multiple field (#.37) in SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",37,1,37,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,38,0)="This patch includes a post-install process that will transmit this added"
^DIC(9.4,127,22,3,"PAH",37,1,39,0)="piece of information for all FY2000 cases that have already transmitted."
^DIC(9.4,127,22,3,"PAH",37,1,40,0)=" "
^DIC(9.4,127,22,3,"PAH",37,1,41,0)="4. The routine SRSUP1 is modified to correct the problem described in NOIS"
^DIC(9.4,127,22,3,"PAH",37,1,42,0)="DAY-0200-41350."
^DIC(9.4,127,22,3,"PAH",38,0)="92 SEQ #91^3000405^1"
^DIC(9.4,127,22,3,"PAH",38,1,0)="^^22^22^3000405"
^DIC(9.4,127,22,3,"PAH",38,1,1,0)="1. When using the option Print Surgery Waiting List [SRSWL2] to print the"
^DIC(9.4,127,22,3,"PAH",38,1,2,0)="brief form by tentative date of operation, entering ""^"" to quit may not work."
^DIC(9.4,127,22,3,"PAH",38,1,3,0)="(See NOIS ALB-1199-52220.)  This patch modifies the routines SRSWL12 and"
^DIC(9.4,127,22,3,"PAH",38,1,4,0)="SRSWL14 to correct the problem."
^DIC(9.4,127,22,3,"PAH",38,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",38,1,6,0)="2. The Monthly Surgical Case Workload Report [SROA MONTHLY WORKLOAD REPORT]"
^DIC(9.4,127,22,3,"PAH",38,1,7,0)="option may generate an error if the report is run for a month prior to"
^DIC(9.4,127,22,3,"PAH",38,1,8,0)="October 1995.  (See NOIS TAM-1299-31004.)  The routine SROAWL1 is modified to"
^DIC(9.4,127,22,3,"PAH",38,1,9,0)="correct the problem."
^DIC(9.4,127,22,3,"PAH",38,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",38,1,11,0)="3. The options Operation Requests for a Day [SROP REQ] and Report of Missing"
^DIC(9.4,127,22,3,"PAH",38,1,12,0)="Quarterly Report Data [SROQ MISSING DATA] are updated to make the reports"
^DIC(9.4,127,22,3,"PAH",38,1,13,0)="print by division.  This change requires that the following routines be"
^DIC(9.4,127,22,3,"PAH",38,1,14,0)="modified: SROPREQ, SROQN, SROREQ, SROREQ1, SROREQ2, SROREQ3 and SROREQ4."
^DIC(9.4,127,22,3,"PAH",38,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",38,1,16,0)="4. When entering a request for an operation, if the normal request deadline"
^DIC(9.4,127,22,3,"PAH",38,1,17,0)="falls on a holiday, the method used by the software to recalculate the"
^DIC(9.4,127,22,3,"PAH",38,1,18,0)="deadline to allow for the holiday is problematic.  (See NOIS BAY-0100-31625.)"
^DIC(9.4,127,22,3,"PAH",38,1,19,0)="This patch modifies the routines SRSCAN2 and SRSREQ.  After installing this"
^DIC(9.4,127,22,3,"PAH",38,1,20,0)="patch, if the normal request deadline falls on a holiday, the software will"
^DIC(9.4,127,22,3,"PAH",38,1,21,0)="use the deadline for the closest valid scheduling date prior to the operation"
^DIC(9.4,127,22,3,"PAH",38,1,22,0)="request date."
^DIC(9.4,127,22,3,"PAH",39,0)="94 SEQ #92^3000626^1"
^DIC(9.4,127,22,3,"PAH",39,1,0)="^^63^63^3000626"
^DIC(9.4,127,22,3,"PAH",39,1,1,0)="1. This patch modifies the routine SROASSP adding the call to %ZISC to close"
^DIC(9.4,127,22,3,"PAH",39,1,2,0)="the printer device.  This change fixes the problem described by NOIS"
^DIC(9.4,127,22,3,"PAH",39,1,3,0)="TAM-0300-32135 and NOIS ALB-0200-51214."
^DIC(9.4,127,22,3,"PAH",39,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,5,0)="2. The routine SRSDISP is modified to allow the display of the first 8"
^DIC(9.4,127,22,3,"PAH",39,1,6,0)="characters of the name of the operating room on the operating room"
^DIC(9.4,127,22,3,"PAH",39,1,7,0)="availability display graph.  This change is made in response to NOIS"
^DIC(9.4,127,22,3,"PAH",39,1,8,0)="GNH-0300-42659"
^DIC(9.4,127,22,3,"PAH",39,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,10,0)="3. The routines SROREST and SROIRR are modified to correct the problem"
^DIC(9.4,127,22,3,"PAH",39,1,11,0)="described in NOIS V02-0400-N0176.  When using the option Enter Irrigation and"
^DIC(9.4,127,22,3,"PAH",39,1,12,0)="Restraints [SROMEN-REST], if the number of active entries in the IRRIGATION"
^DIC(9.4,127,22,3,"PAH",39,1,13,0)="file (#133.6) or in the RESTRAINTS AND POSITIONAL AIDS file (#132.05) is"
^DIC(9.4,127,22,3,"PAH",39,1,14,0)="greater than 36, items will be displayed on multiple screen pages with no"
^DIC(9.4,127,22,3,"PAH",39,1,15,0)="more than 36 items per page.                                              "
^DIC(9.4,127,22,3,"PAH",39,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,17,0)="4. Before installing this patch, if the nurse reviewer used the option"
^DIC(9.4,127,22,3,"PAH",39,1,18,0)="Non-Cardiac Assessment Information (Enter/Edit) [SROA ENTER/EDIT] or the"
^DIC(9.4,127,22,3,"PAH",39,1,19,0)="option Cardiac Risk Assessment Information (Enter/Edit) [SROA CARDIAC"
^DIC(9.4,127,22,3,"PAH",39,1,20,0)="ENTER/EDIT] to update a risk assessment that was already transmitted, the"
^DIC(9.4,127,22,3,"PAH",39,1,21,0)="software required the nurse reviewer to go to the option Update Assessment"
^DIC(9.4,127,22,3,"PAH",39,1,22,0)="Completed/Transmitted in Error [SROA TRANSMITTED IN ERROR] to change the"
^DIC(9.4,127,22,3,"PAH",39,1,23,0)="assessment status to incomplete before updating was allowed.  After installing"
^DIC(9.4,127,22,3,"PAH",39,1,24,0)="this patch, if the nurse reviewer attempts to update a risk assessment using"
^DIC(9.4,127,22,3,"PAH",39,1,25,0)="the option Non-Cardiac Assessment Information (Enter/Edit) [SROA ENTER/EDIT]"
^DIC(9.4,127,22,3,"PAH",39,1,26,0)="or the option Cardiac Risk Assessment Information (Enter/Edit) [SROA CARDIAC"
^DIC(9.4,127,22,3,"PAH",39,1,27,0)="ENTER/EDIT], the option will allow the nurse reviewer to change the assessment"
^DIC(9.4,127,22,3,"PAH",39,1,28,0)="status to incomplete without having to go to another option first.  The"
^DIC(9.4,127,22,3,"PAH",39,1,29,0)="routine SROASS is modified to provide this change."
^DIC(9.4,127,22,3,"PAH",39,1,30,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,31,0)="5. Obsolete code used originally to check for old Surgery Risk Assessment data"
^DIC(9.4,127,22,3,"PAH",39,1,32,0)="was removed from the routine SROASS.  This code was called by the entry action"
^DIC(9.4,127,22,3,"PAH",39,1,33,0)="of 6 options whose entry actions are also updated by this patch.  Those 6"
^DIC(9.4,127,22,3,"PAH",39,1,34,0)="options are listed below."
^DIC(9.4,127,22,3,"PAH",39,1,35,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,36,0)="   Exclusion Criteria (Enter/Edit) [SR NO ASSESSMENT REASON]"
^DIC(9.4,127,22,3,"PAH",39,1,37,0)="   List of Surgery Risk Assessments [SROA ASSESSMENT LIST]"
^DIC(9.4,127,22,3,"PAH",39,1,38,0)="   Non-Cardiac Assessment Information (Enter/Edit) [SROA ENTER/EDIT]"
^DIC(9.4,127,22,3,"PAH",39,1,39,0)="   Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT]"
^DIC(9.4,127,22,3,"PAH",39,1,40,0)="   Print 30 Day Follow-up Letters [SROA REPRINT LETTERS]"
^DIC(9.4,127,22,3,"PAH",39,1,41,0)="   Update Assessment Completed/Transmitted in Error [SROA TRANSMITTED IN ERROR]"
^DIC(9.4,127,22,3,"PAH",39,1,42,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,43,0)="6. This patch modifies the routines SRODLAY, SRODLA1, SRODLA2, SROREAS,"
^DIC(9.4,127,22,3,"PAH",39,1,44,0)="SROREA1, SROREA2, SRODLT, SRODLT0, SROCAN, SROCAN0, SROCRAT, SRORAT1 and"
^DIC(9.4,127,22,3,"PAH",39,1,45,0)="SRORAT2 allowing the following report options to print reports for all"
^DIC(9.4,127,22,3,"PAH",39,1,46,0)="divisions or for a selected division:"
^DIC(9.4,127,22,3,"PAH",39,1,47,0)="   Report of Delayed Operations [SRODELA]"
^DIC(9.4,127,22,3,"PAH",39,1,48,0)="   Report of Delay Reasons [SROREAS]"
^DIC(9.4,127,22,3,"PAH",39,1,49,0)="   Report of Delay Time [SRO DELAY TIME]"
^DIC(9.4,127,22,3,"PAH",39,1,50,0)="   Report of Cancellations [SROCAN]"
^DIC(9.4,127,22,3,"PAH",39,1,51,0)="   Report of Cancellation Rates [SROCRAT]"
^DIC(9.4,127,22,3,"PAH",39,1,52,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,53,0)="7. This patch updates the data dictionary for the following fields in"
^DIC(9.4,127,22,3,"PAH",39,1,54,0)="SURGERY file (#130) to require the inclusion of at least one space in"
^DIC(9.4,127,22,3,"PAH",39,1,55,0)="every 31 characters of input.  See NOIS HVH-0500-10303.  "
^DIC(9.4,127,22,3,"PAH",39,1,56,0)=" "
^DIC(9.4,127,22,3,"PAH",39,1,57,0)="   OTHER PREOP DIAGNOSIS multiple field (#.72, sub-file #130.17)"
^DIC(9.4,127,22,3,"PAH",39,1,58,0)="       OTHER PREOP DIAGNOSIS field (#.01)"
^DIC(9.4,127,22,3,"PAH",39,1,59,0)="   OTHER POSTOP DIAGS multiple field (#.74, sub-file #130.18)"
^DIC(9.4,127,22,3,"PAH",39,1,60,0)="       OTHER POSTOP DIAGS field (#.01)"
^DIC(9.4,127,22,3,"PAH",39,1,61,0)="   PRINCIPAL PRE-OP DIAGNOSIS field (#32)"
^DIC(9.4,127,22,3,"PAH",39,1,62,0)="   PRINCIPAL DIAGNOSIS field (#33)"
^DIC(9.4,127,22,3,"PAH",39,1,63,0)="   PRINCIPAL POST-OP DIAGNOSIS field (#34)"
^DIC(9.4,127,22,3,"PAH",40,0)="95 SEQ #93^3001106^1"
^DIC(9.4,127,22,3,"PAH",40,1,0)="^^4^4^3001106"
^DIC(9.4,127,22,3,"PAH",40,1,1,0)="This patch provides enhancements in support of the Continuous Improvement"
^DIC(9.4,127,22,3,"PAH",40,1,2,0)="in Cardiac Surgery Program Expansion (CICSP-X). "
^DIC(9.4,127,22,3,"PAH",40,1,3,0)="See Patch SR*3*95 in the National Patch Module for description of the"
^DIC(9.4,127,22,3,"PAH",40,1,4,0)="Build."
^DIC(9.4,127,22,3,"PAH",41,0)="97 SEQ #94^3010202^1"
^DIC(9.4,127,22,3,"PAH",41,1,0)="^^2^2^3010202"
^DIC(9.4,127,22,3,"PAH",41,1,1,0)="See Patch SR*3*97 in the National Patch Module for description of the"
^DIC(9.4,127,22,3,"PAH",41,1,2,0)="Build."
^DIC(9.4,127,22,3,"PAH",42,0)="98 SEQ #95^3010228^1"
^DIC(9.4,127,22,3,"PAH",42,1,0)="^^2^2^3010228"
^DIC(9.4,127,22,3,"PAH",42,1,1,0)="See patch SR*3*98 in the National Patch Module for description of this"
^DIC(9.4,127,22,3,"PAH",42,1,2,0)="build."
^DIC(9.4,127,22,3,"PAH",43,0)="99 SEQ #96^3010326^1"
^DIC(9.4,127,22,3,"PAH",43,1,0)="^^13^13^3010326"
^DIC(9.4,127,22,3,"PAH",43,1,1,0)="1. The input screen of the Cardiac Procedures Requiring CPB (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",43,1,2,0)="   [SROA CARDIAC PROCEDURES] option, for the BATISTA PROCEDURE USED field"
^DIC(9.4,127,22,3,"PAH",43,1,3,0)="   (#439) the screen displays what is in the MISC. CARDIAC PROCEDURES"
^DIC(9.4,127,22,3,"PAH",43,1,4,0)="   field (#375) of the SURGERY file (#130). This patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",43,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",43,1,6,0)="2. The cardiac assessment transmission is modified to include the"
^DIC(9.4,127,22,3,"PAH",43,1,7,0)="   patient's date of birth."
^DIC(9.4,127,22,3,"PAH",43,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",43,1,9,0)="3. On the Resource Data [SROA CARDIAC RESOURCE] option, the code ""RI"""
^DIC(9.4,127,22,3,"PAH",43,1,10,0)="   expands to ""RI-Remains in ICU at 30 days"" when entered for D/T PATIENT"
^DIC(9.4,127,22,3,"PAH",43,1,11,0)="   EXTUBATED field (#470) in the SURGERY file (#130). Actually, it should"
^DIC(9.4,127,22,3,"PAH",43,1,12,0)="   expand to ""RI-Remains intubated at 30 days"". This patch fixes this"
^DIC(9.4,127,22,3,"PAH",43,1,13,0)="   problem."
^DIC(9.4,127,22,3,"PAH",44,0)="101 SEQ #97^3010430^1"
^DIC(9.4,127,22,3,"PAH",44,1,0)="^^11^11^3010430"
^DIC(9.4,127,22,3,"PAH",44,1,1,0)="1. On the Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] option,"
^DIC(9.4,127,22,3,"PAH",44,1,2,0)="   the code ""RI"" expands to ""RI-Remains in ICU at 30 days"" when entered"
^DIC(9.4,127,22,3,"PAH",44,1,3,0)="   for D/T PATIENT EXTUBATED field (#470) in the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",44,1,4,0)="   Actually, it should expand to ""RI-Remains intubated at 30 days"". This"
^DIC(9.4,127,22,3,"PAH",44,1,5,0)="   patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",44,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",44,1,7,0)="2. On the Blood Product Verification [SR BLOOD PRODUCT VERIFICATION]"
^DIC(9.4,127,22,3,"PAH",44,1,8,0)="   option, if the blood unit is expired the system displays the worning"
^DIC(9.4,127,22,3,"PAH",44,1,9,0)="   message ""Blood Product Expiration Date is later than today's date."","
^DIC(9.4,127,22,3,"PAH",44,1,10,0)="   this patch rewords the message to read ""Today's date exceeds the blood"
^DIC(9.4,127,22,3,"PAH",44,1,11,0)="   product expiration date.""."
^DIC(9.4,127,22,3,"PAH",45,0)="102 SEQ #98^3010515^1"
^DIC(9.4,127,22,3,"PAH",45,1,0)="^^14^14^3010515"
^DIC(9.4,127,22,3,"PAH",45,1,1,0)="1. This patch modifies the RISK ASSESSMENT IN USE (Y/N) field (#15) in the"
^DIC(9.4,127,22,3,"PAH",45,1,2,0)="   SURGERY SITE PARAMETERS file (#133), changing the name of the field to"
^DIC(9.4,127,22,3,"PAH",45,1,3,0)="   CARDIAC RISK ASSESSMENT IN USE(Y/N).  After installing this patch, the"
^DIC(9.4,127,22,3,"PAH",45,1,4,0)="   entry action on the Cardiac Risk Assessment Information (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",45,1,5,0)="   [SROA CARDIAC ENTER/EDIT] menu will check this parameter field to"
^DIC(9.4,127,22,3,"PAH",45,1,6,0)="   determine if menu access is allowed. This parameter may be edited using"
^DIC(9.4,127,22,3,"PAH",45,1,7,0)="   the Surgery Site Parameters (Enter/Edit) [SROPARAM] option on the Surgery "
^DIC(9.4,127,22,3,"PAH",45,1,8,0)="   Package Management Menu [SRO PACKAGE MANAGEMENT].  This change enables"
^DIC(9.4,127,22,3,"PAH",45,1,9,0)="   local control of menu access and replaces the current function that "
^DIC(9.4,127,22,3,"PAH",45,1,10,0)="   controls access based upon the sites default institution station number."
^DIC(9.4,127,22,3,"PAH",45,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",45,1,12,0)="2. This patch fixes the problem reported in NOIS SDC-0301-62902 to prevent"
^DIC(9.4,127,22,3,"PAH",45,1,13,0)="   the undefined variable error that may occur when completing a"
^DIC(9.4,127,22,3,"PAH",45,1,14,0)="   non-cardiac risk assessment."
^DIC(9.4,127,22,3,"PAH",46,0)="103 SEQ #99^3010802^1"
^DIC(9.4,127,22,3,"PAH",46,1,0)="^^16^16^3010802"
^DIC(9.4,127,22,3,"PAH",46,1,1,0)="1. As reported in NOIS DUR-0501-32617, the value in the DATE/TIME OR"
^DIC(9.4,127,22,3,"PAH",46,1,2,0)="REQUEST MADE field (#1.098) in SURGERY file (#130) occasionally includes"
^DIC(9.4,127,22,3,"PAH",46,1,3,0)="trailing zeros that cause the exclusion of such values when sorting by a"
^DIC(9.4,127,22,3,"PAH",46,1,4,0)="date range.  This patch modifies the routines SRSCAN0, SRSCAN2, SRSCHUN,"
^DIC(9.4,127,22,3,"PAH",46,1,5,0)="SRSDT and SRSRQST so that trailing zeros will be removed before the value"
^DIC(9.4,127,22,3,"PAH",46,1,6,0)="is stored.  A post-install process will loop through SURGERY file (#130)"
^DIC(9.4,127,22,3,"PAH",46,1,7,0)="and remove any trailing zeros in the DATE/TIME OR REQUEST MADE field"
^DIC(9.4,127,22,3,"PAH",46,1,8,0)="(#1.098)."
^DIC(9.4,127,22,3,"PAH",46,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",46,1,10,0)="2. NOIS CPH-0601-41315 reported that the Surgery Quarterly Report is"
^DIC(9.4,127,22,3,"PAH",46,1,11,0)="continuing to use inactive CPT codes in the Index Procedures section of"
^DIC(9.4,127,22,3,"PAH",46,1,12,0)="the report.  This patch modifies the routine SROQ0A, replacing the 3"
^DIC(9.4,127,22,3,"PAH",46,1,13,0)="inactive CPT codes (56340, 56341 and 56342) with the 3 replacement codes"
^DIC(9.4,127,22,3,"PAH",46,1,14,0)="(47562, 47563 and 47564).  The post-install process will task the"
^DIC(9.4,127,22,3,"PAH",46,1,15,0)="Quarterly Reports for the past reporting periods of FY 2001 to transmit"
^DIC(9.4,127,22,3,"PAH",46,1,16,0)="again."
^DIC(9.4,127,22,3,"PAH",47,0)="96 SEQ #100^3010815^1"
^DIC(9.4,127,22,3,"PAH",47,1,0)="^^8^8^3010815"
^DIC(9.4,127,22,3,"PAH",47,1,1,0)="1. This patch modifies routine SROPRPT, adding the call to HOME^%ZIS to"
^DIC(9.4,127,22,3,"PAH",47,1,2,0)="   fix the error ""DEVICE OR FILE NOT OPEN"" that occurs occasionally due to"
^DIC(9.4,127,22,3,"PAH",47,1,3,0)="   the printer device not being closed prior to running the Operation"
^DIC(9.4,127,22,3,"PAH",47,1,4,0)="   Report [SROSRPT] option."
^DIC(9.4,127,22,3,"PAH",47,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",47,1,6,0)="2. This patch fixes the problem reported in NOIS PUG-0701-50135, of an"
^DIC(9.4,127,22,3,"PAH",47,1,7,0)="   extrinsic function call in routine SROAUTLC which quits without a"
^DIC(9.4,127,22,3,"PAH",47,1,8,0)="   value."
^DIC(9.4,127,22,3,"PAH",48,0)="104 SEQ #101^3011106^1"
^DIC(9.4,127,22,3,"PAH",48,1,0)="^^8^8^3011106"
^DIC(9.4,127,22,3,"PAH",48,1,1,0)="1. This patch fixes the Undefined Error reported on NOIS LAH-0901-60445."
^DIC(9.4,127,22,3,"PAH",48,1,2,0)="   The error is generated as a result of not killing variable DR before"
^DIC(9.4,127,22,3,"PAH",48,1,3,0)="   calling Surgery screen server routine SRCUSS."
^DIC(9.4,127,22,3,"PAH",48,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",48,1,5,0)="2. When using the Delete Service Blockout [SRSBDEL] option at a"
^DIC(9.4,127,22,3,"PAH",48,1,6,0)="   multi-division facility, it was reported that this option displays all"
^DIC(9.4,127,22,3,"PAH",48,1,7,0)="   operations, where as it should display only those operations for the"
^DIC(9.4,127,22,3,"PAH",48,1,8,0)="   selected division. This patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",49,0)="105 SEQ #102^3020102^1"
^DIC(9.4,127,22,3,"PAH",49,1,0)="^^39^39^3020102"
^DIC(9.4,127,22,3,"PAH",49,1,1,0)="1. This patch corrects the problem described in NOIS UNY-1101-11002 and NOIS "
^DIC(9.4,127,22,3,"PAH",49,1,2,0)="HAM-1101-21180."
^DIC(9.4,127,22,3,"PAH",49,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",49,1,4,0)="2. This patch modifies the Surgery software to include the Military Sexual "
^DIC(9.4,127,22,3,"PAH",49,1,5,0)="Trauma (MST) classification question and the Head and/or Neck Cancer (HNC) "
^DIC(9.4,127,22,3,"PAH",49,1,6,0)="classification question on the list of potential classification questions "
^DIC(9.4,127,22,3,"PAH",49,1,7,0)="that must be answered on ambulatory surgeries that are passed to PCE if the "
^DIC(9.4,127,22,3,"PAH",49,1,8,0)="Surgery interface to PCE is turned on and the ASK CLASSIFICATION QUESTIONS "
^DIC(9.4,127,22,3,"PAH",49,1,9,0)="field (#19) in SURGERY SITE PARAMETERS file (#133) is set to YES."
^DIC(9.4,127,22,3,"PAH",49,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",49,1,11,0)="This patch adds the following new fields to store responses to the MST and "
^DIC(9.4,127,22,3,"PAH",49,1,12,0)="HNC classification questions that will be passed to PCE with the other "
^DIC(9.4,127,22,3,"PAH",49,1,13,0)="surgical encounter information:"
^DIC(9.4,127,22,3,"PAH",49,1,14,0)=" - File: SURGERY (#130)"
^DIC(9.4,127,22,3,"PAH",49,1,15,0)="   Field: MILITARY SEXUAL TRAUMA  (#.022)      SET"
^DIC(9.4,127,22,3,"PAH",49,1,16,0)="   Description: This field will be used to indicate if this surgery or non-OR"
^DIC(9.4,127,22,3,"PAH",49,1,17,0)="                procedure is treating a VA patient for a problem that is"
^DIC(9.4,127,22,3,"PAH",49,1,18,0)="                related to Military Sexual Trauma.  This information may be "
^DIC(9.4,127,22,3,"PAH",49,1,19,0)="                passed to the VISIT file (#9000010) for use by PCE."
^DIC(9.4,127,22,3,"PAH",49,1,20,0)=" "
^DIC(9.4,127,22,3,"PAH",49,1,21,0)="   Field: HEAD AND/OR NECK CANCER (#.023)         SET"
^DIC(9.4,127,22,3,"PAH",49,1,22,0)="   Description: This field will be used to indicate if this surgery or non-OR"
^DIC(9.4,127,22,3,"PAH",49,1,23,0)="                procedure is treating a VA patient for a problem that is "
^DIC(9.4,127,22,3,"PAH",49,1,24,0)="                related to Head and/or Neck Cancer.  This information may be "
^DIC(9.4,127,22,3,"PAH",49,1,25,0)="                passed to the VISIT file (#9000010) for use by PCE."
^DIC(9.4,127,22,3,"PAH",49,1,26,0)=" "
^DIC(9.4,127,22,3,"PAH",49,1,27,0)=" - File: SURGERY WAITING LIST (#133.8)"
^DIC(9.4,127,22,3,"PAH",49,1,28,0)="   Field: PATIENT (#1) (Multiple, sub-file #133.801)"
^DIC(9.4,127,22,3,"PAH",49,1,29,0)="   Sub-Field: MILITARY SEXUAL TRAUMA (#21)     SET"
^DIC(9.4,127,22,3,"PAH",49,1,30,0)="   Description: This field will be used to indicate if this surgery is "
^DIC(9.4,127,22,3,"PAH",49,1,31,0)="                treating a VA patient for a problem related to military "
^DIC(9.4,127,22,3,"PAH",49,1,32,0)="                sexual trauma.  This information may be passed to the VISIT"
^DIC(9.4,127,22,3,"PAH",49,1,33,0)="                file (#9000010) to be used by PCE."
^DIC(9.4,127,22,3,"PAH",49,1,34,0)=" "
^DIC(9.4,127,22,3,"PAH",49,1,35,0)="   Sub-Field: HEAD AND/OR NECK CANCER (#22)       SET"
^DIC(9.4,127,22,3,"PAH",49,1,36,0)="   Description: This field will be used to indicate if this surgery is "
^DIC(9.4,127,22,3,"PAH",49,1,37,0)="                treating a VA patient for a problem related to Head and/or"
^DIC(9.4,127,22,3,"PAH",49,1,38,0)="                Neck Cancer.  This information may be passed to the VISIT"
^DIC(9.4,127,22,3,"PAH",49,1,39,0)="                file (#9000010) to be used by PCE."
^DIC(9.4,127,22,3,"PAH",50,0)="106 SEQ #103^3020315^1"
^DIC(9.4,127,22,3,"PAH",50,1,0)="^^12^12^3020315"
^DIC(9.4,127,22,3,"PAH",50,1,1,0)="1. It was reported that, when using the Report of Unscheduled Admissions"
^DIC(9.4,127,22,3,"PAH",50,1,2,0)="   to ICU [SROICU] option, if the site is a multi-division facility, this"
^DIC(9.4,127,22,3,"PAH",50,1,3,0)="   report populates the data from all the divisions. This patch modifies"
^DIC(9.4,127,22,3,"PAH",50,1,4,0)="   the routines SROICU, SROICU1, and SROICU2 to enhance printing of this"
^DIC(9.4,127,22,3,"PAH",50,1,5,0)="   report to be a division specific."
^DIC(9.4,127,22,3,"PAH",50,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",50,1,7,0)="2. When using the Nurse Intraoperative Reprot [SRONRPT] option, there is a"
^DIC(9.4,127,22,3,"PAH",50,1,8,0)="   problem which causes the job to hang.  If the NURSING CARE COMMENTS"
^DIC(9.4,127,22,3,"PAH",50,1,9,0)="   field (#.29) of the SURGERY file (#130) contains spaces in the first 78"
^DIC(9.4,127,22,3,"PAH",50,1,10,0)="   characters, but no spaces in the  next 80 or more  characters after the"
^DIC(9.4,127,22,3,"PAH",50,1,11,0)="   last space, the software would loop, causing the job to hang. This"
^DIC(9.4,127,22,3,"PAH",50,1,12,0)="   patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",51,0)="108 SEQ #104^3021008^1"
^DIC(9.4,127,22,3,"PAH",51,1,0)="^^15^15^3021008"
^DIC(9.4,127,22,3,"PAH",51,1,1,0)="1. The calls to the Imaging (MAG) V 1.0 package software that are in the"
^DIC(9.4,127,22,3,"PAH",51,1,2,0)="   Surgery routines were added to those routines by patch SR*3*66 to"
^DIC(9.4,127,22,3,"PAH",51,1,3,0)="   facilitate the use of the Imaging software. These calls are obsolete,"
^DIC(9.4,127,22,3,"PAH",51,1,4,0)="   any reference to those calls will cause the software to generate an"
^DIC(9.4,127,22,3,"PAH",51,1,5,0)="   error.  This patch removes all of these references."
^DIC(9.4,127,22,3,"PAH",51,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",51,1,7,0)="2. It was reported that the REQ FROZ SECT field (#1.02) in the SURGERY"
^DIC(9.4,127,22,3,"PAH",51,1,8,0)="   file (#130) is not printed when generating the Operating Room"
^DIC(9.4,127,22,3,"PAH",51,1,9,0)="   Schedule report using the Schedule of Operations [SROSCH] option. This"
^DIC(9.4,127,22,3,"PAH",51,1,10,0)="   patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",51,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",51,1,12,0)="3. It was observed that when editing any multiple fields via the Surgery"
^DIC(9.4,127,22,3,"PAH",51,1,13,0)="   Screen Server Utility it's currently not allow editing of any multiple"
^DIC(9.4,127,22,3,"PAH",51,1,14,0)="   fields if those fields have only the top level field (.01) in the Input"
^DIC(9.4,127,22,3,"PAH",51,1,15,0)="   Template. This patch will ensure that such fields are editable."
^DIC(9.4,127,22,3,"PAH",52,0)="110 SEQ #105^3021025^1"
^DIC(9.4,127,22,3,"PAH",52,1,0)="^^4^4^3021025"
^DIC(9.4,127,22,3,"PAH",52,1,1,0)="This patch exports a new ""AOE"" cross-reference to the TIME PAT OUT OR"
^DIC(9.4,127,22,3,"PAH",52,1,2,0)="field (#.232) in the SURGERY file (#130). The new cross-reference will"
^DIC(9.4,127,22,3,"PAH",52,1,3,0)="allow the Computerized Patient Record System (CPRS) to automatically"
^DIC(9.4,127,22,3,"PAH",52,1,4,0)="discontinue or release orders when patient leaves the Operating Room."
^DIC(9.4,127,22,3,"PAH",53,0)="109 SEQ #106^3021209^1"
^DIC(9.4,127,22,3,"PAH",53,1,0)="^^17^17^3021209"
^DIC(9.4,127,22,3,"PAH",53,1,1,0)="In preparation for the VistA Blood Establishment Computer Software "
^DIC(9.4,127,22,3,"PAH",53,1,2,0)="(VBECS), changes are necessary in the Surgery V. 3.0 package. Any "
^DIC(9.4,127,22,3,"PAH",53,1,3,0)="reference to the blood bank information needs to be modified to prepare "
^DIC(9.4,127,22,3,"PAH",53,1,4,0)="for the VBECS release. This patch makes these modifications."
^DIC(9.4,127,22,3,"PAH",53,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",53,1,6,0)="As a part of these changes, it is necessary to convert the existing data. "
^DIC(9.4,127,22,3,"PAH",53,1,7,0)="Pointers from the SURGERY SITE PARAMETERS file (#133) and the SURGERY "
^DIC(9.4,127,22,3,"PAH",53,1,8,0)="file (#130) that reference the BLOOD PRODUCT file (#66) will be changed "
^DIC(9.4,127,22,3,"PAH",53,1,9,0)="to actually contain the name of the product. This process will run as a "
^DIC(9.4,127,22,3,"PAH",53,1,10,0)="post-install routine. A mail message will be sent to the person who "
^DIC(9.4,127,22,3,"PAH",53,1,11,0)="started the installation to let them know the conversion is complete and "
^DIC(9.4,127,22,3,"PAH",53,1,12,0)="any problems that were encountered. The subject of the message will be: "
^DIC(9.4,127,22,3,"PAH",53,1,13,0)="SURGERY POINTER CONVERSION COMPLETED. Please note: if problems were "
^DIC(9.4,127,22,3,"PAH",53,1,14,0)="encountered, the message will contain information on correcting the "
^DIC(9.4,127,22,3,"PAH",53,1,15,0)="problems and re-running the conversion. However, it is not required to do "
^DIC(9.4,127,22,3,"PAH",53,1,16,0)="this. Just be aware that these entries will now simply display as a "
^DIC(9.4,127,22,3,"PAH",53,1,17,0)="number."
^DIC(9.4,127,22,3,"PAH",54,0)="111 SEQ #107^3030109^1"
^DIC(9.4,127,22,3,"PAH",54,1,0)="^^22^22^3030109"
^DIC(9.4,127,22,3,"PAH",54,1,1,0)="This patch contains modifications to the Surgery package to include new"
^DIC(9.4,127,22,3,"PAH",54,1,2,0)="Ethnicity and multiple Race fields in four Surgery options as listed "
^DIC(9.4,127,22,3,"PAH",54,1,3,0)="below. The new fields comply with the new Race and Ethnicity Standards as"
^DIC(9.4,127,22,3,"PAH",54,1,4,0)="set forth by the Office of Management and Budget."
^DIC(9.4,127,22,3,"PAH",54,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",54,1,6,0)="1.  Tissue Examination Report [SROTRPT].  Ethnicity and multiple Races "
^DIC(9.4,127,22,3,"PAH",54,1,7,0)="    appear in the report footer."
^DIC(9.4,127,22,3,"PAH",54,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",54,1,9,0)="2.  Non-Cardiac Assessment Information (Enter/Edit) [SROA ENTER/EDIT]."
^DIC(9.4,127,22,3,"PAH",54,1,10,0)="    Ethnicity and multiple Races display on the report.  These fields are "
^DIC(9.4,127,22,3,"PAH",54,1,11,0)="    not editable through the Surgery package options."
^DIC(9.4,127,22,3,"PAH",54,1,12,0)=" "
^DIC(9.4,127,22,3,"PAH",54,1,13,0)="3.  Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT].  Ethnicity "
^DIC(9.4,127,22,3,"PAH",54,1,14,0)="    and multiple races appear on the report."
^DIC(9.4,127,22,3,"PAH",54,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",54,1,16,0)="4.  Queue Assessment Transmissions [SROA TRANSMIT ASSESSMENTS]."
^DIC(9.4,127,22,3,"PAH",54,1,17,0)="        a.  Non-Cardiac Risk Assessment transmission.  Old Race "
^DIC(9.4,127,22,3,"PAH",54,1,18,0)="            information is retained on node 7.  New Ethnicity and multiple"
^DIC(9.4,127,22,3,"PAH",54,1,19,0)="            Races are transmitted on node 13."
^DIC(9.4,127,22,3,"PAH",54,1,20,0)="        b.  Cardiac Risk Assessment transmission.  Old Race information is"
^DIC(9.4,127,22,3,"PAH",54,1,21,0)="            retained on node 24.  New Ethnicity and multiple Races "
^DIC(9.4,127,22,3,"PAH",54,1,22,0)="            are transmitted on node 6."
^DIC(9.4,127,22,3,"PAH",55,0)="107 SEQ #108^3030301^1"
^DIC(9.4,127,22,3,"PAH",55,1,0)="^^46^46^3030301"
^DIC(9.4,127,22,3,"PAH",55,1,1,0)="This is an enhancement patch to the Surgery V. 3.0 software. It will"
^DIC(9.4,127,22,3,"PAH",55,1,2,0)="replace the existing Surgery interface with the Integrated Funds"
^DIC(9.4,127,22,3,"PAH",55,1,3,0)="Distribution, Control Point Activity, Accounting, and Procurement (IFCAP)"
^DIC(9.4,127,22,3,"PAH",55,1,4,0)="with a new interface to the Core Financial and Logistics System (CoreFLS)."
^DIC(9.4,127,22,3,"PAH",55,1,5,0)="Functionally, the new interface expands the features provided in the"
^DIC(9.4,127,22,3,"PAH",55,1,6,0)="existing interface. The interface will provide Surgery case information to"
^DIC(9.4,127,22,3,"PAH",55,1,7,0)="Supply Processing and Distribution (SPD) so that the specific Surgery"
^DIC(9.4,127,22,3,"PAH",55,1,8,0)="case carts needed for the case can be created. The modifications include"
^DIC(9.4,127,22,3,"PAH",55,1,9,0)="the following items:"
^DIC(9.4,127,22,3,"PAH",55,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,11,0)="1. The new SPD COMMENTS field (#80) of the SURGERY file (#130) is added to"
^DIC(9.4,127,22,3,"PAH",55,1,12,0)="   the following options:"
^DIC(9.4,127,22,3,"PAH",55,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,14,0)="  - Make Operation Requests [SROOPREQ]"
^DIC(9.4,127,22,3,"PAH",55,1,15,0)="  - Delete or Update Operation Requests [SRSUPRQ]"
^DIC(9.4,127,22,3,"PAH",55,1,16,0)="  - Make a Request from the Waiting List [SRSWREQ]"
^DIC(9.4,127,22,3,"PAH",55,1,17,0)="  - Make a Request for Concurrent Cases [SRSREQCC]"
^DIC(9.4,127,22,3,"PAH",55,1,18,0)="  - Schedule Unrequested Operations [SROSRES]"
^DIC(9.4,127,22,3,"PAH",55,1,19,0)="  - Schedule Unrequested Concurrent Cases [SRSCHDC]"
^DIC(9.4,127,22,3,"PAH",55,1,20,0)="  - Reschedule or Update a Scheduled Operation [SRSCHUP]"
^DIC(9.4,127,22,3,"PAH",55,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,22,0)="2. The new AUTOMATED CASE CART ORDERING field (#37) will be added to the"
^DIC(9.4,127,22,3,"PAH",55,1,23,0)="   SURGERY SITE PARAMETERS file (#133) input template SRPARAM so that"
^DIC(9.4,127,22,3,"PAH",55,1,24,0)="   this field may be edited using the Surgery Site Parameters (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",55,1,25,0)="   [SROPARAM] option. This field will be checked to determine if the"
^DIC(9.4,127,22,3,"PAH",55,1,26,0)="   CoreFLS interface for Surgery is in use at the facility before sending"
^DIC(9.4,127,22,3,"PAH",55,1,27,0)="   the Surgery data to the CoreFLS package."
^DIC(9.4,127,22,3,"PAH",55,1,28,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,29,0)="3. This patch modifies all options used to create or schedule a Surgery"
^DIC(9.4,127,22,3,"PAH",55,1,30,0)="   case so that information can be provided to SPD for the creation of"
^DIC(9.4,127,22,3,"PAH",55,1,31,0)="   Surgery case carts."
^DIC(9.4,127,22,3,"PAH",55,1,32,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,33,0)="4. This patch modifies the Surgery software to send updates to SPD"
^DIC(9.4,127,22,3,"PAH",55,1,34,0)="   whenever any of the information provided on the messages has been"
^DIC(9.4,127,22,3,"PAH",55,1,35,0)="   modified using any data entry option."
^DIC(9.4,127,22,3,"PAH",55,1,36,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,37,0)="5. This patch enhances the following options to initiate HL7 update"
^DIC(9.4,127,22,3,"PAH",55,1,38,0)="   messages if the Surgery Health Level 7 (HL7) interface is in use at"
^DIC(9.4,127,22,3,"PAH",55,1,39,0)="   the facility for the following options:"
^DIC(9.4,127,22,3,"PAH",55,1,40,0)=" "
^DIC(9.4,127,22,3,"PAH",55,1,41,0)="   - Enter PAC(U) Information [SROMEN-PACU]"
^DIC(9.4,127,22,3,"PAH",55,1,42,0)="   - Patient Demographics (Enter/Edit) [SROA DEMOGRAPHICS]"
^DIC(9.4,127,22,3,"PAH",55,1,43,0)="   - Operative Risk Summary Data (Enter/Edit) [SROA CARDIAC OPERATIVE"
^DIC(9.4,127,22,3,"PAH",55,1,44,0)="     RISK]"
^DIC(9.4,127,22,3,"PAH",55,1,45,0)="   - Exclusion Criteria (Enter/Edit) [SR NO ASSESSMENT REASON]"
^DIC(9.4,127,22,3,"PAH",55,1,46,0)="   - Update 1-Liner Case [SROA ONE-LINER UPDATE]"
^DIC(9.4,127,22,3,"PAH",56,0)="113 SEQ #109^3030329^1"
^DIC(9.4,127,22,3,"PAH",56,1,0)="^^4^4^3030329"
^DIC(9.4,127,22,3,"PAH",56,1,1,0)="This patch provides the ability to display a new confidential "
^DIC(9.4,127,22,3,"PAH",56,1,2,0)="communication address when using the Print 30 Day Follow-up Letters [SROA "
^DIC(9.4,127,22,3,"PAH",56,1,3,0)="REPRINT LETTERS] option within VISTA Surgery if the Confidential "
^DIC(9.4,127,22,3,"PAH",56,1,4,0)="Communication Types contain ""All Others""."
^DIC(9.4,127,22,3,"PAH",57,0)="115 SEQ #110^3030417^1"
^DIC(9.4,127,22,3,"PAH",57,1,0)="^^8^8^3030417"
^DIC(9.4,127,22,3,"PAH",57,1,1,0)="This patch is created in support of directive 2002-070, ENSURING CORRECT"
^DIC(9.4,127,22,3,"PAH",57,1,2,0)="SURGERY."
^DIC(9.4,127,22,3,"PAH",57,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",57,1,4,0)="The patch adds two new fields in the SURGERY file (#130).  They are"
^DIC(9.4,127,22,3,"PAH",57,1,5,0)="needed to document that the operating room team performed a ""time out"" to"
^DIC(9.4,127,22,3,"PAH",57,1,6,0)="ensure that the correct surgery is being done.  The new fields are:"
^DIC(9.4,127,22,3,"PAH",57,1,7,0)="  1. TIME OUT VERIFIED (#71)"
^DIC(9.4,127,22,3,"PAH",57,1,8,0)="  2. IMAGING CONFIRMED (#72)"
^DIC(9.4,127,22,3,"PAH",58,0)="112 SEQ #111^3030520^1"
^DIC(9.4,127,22,3,"PAH",58,1,0)="^^23^23^3030520"
^DIC(9.4,127,22,3,"PAH",58,1,1,0)="1. This patch fixes the ""NULLSUBSCR"" error generated when using the PRINT"
^DIC(9.4,127,22,3,"PAH",58,1,2,0)="   FILE ENTRIES FileMan option to print one or more of the following"
^DIC(9.4,127,22,3,"PAH",58,1,3,0)="   fields in the SURGERY file (#130) if these fields contain no data:"
^DIC(9.4,127,22,3,"PAH",58,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",58,1,5,0)="   - OTHER RESPIRATORY OCCURRENCE field (#253)"
^DIC(9.4,127,22,3,"PAH",58,1,6,0)="   - OTHER URINARY TRACT OCCURRENCE field (#286)"
^DIC(9.4,127,22,3,"PAH",58,1,7,0)="   - OTHER CNS OCCURRENCE field (#343)"
^DIC(9.4,127,22,3,"PAH",58,1,8,0)="   - OTHER CARDIAC OCCURRENCE field (#344)"
^DIC(9.4,127,22,3,"PAH",58,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",58,1,10,0)="2. This patch adds the description to the Data Dictionary of the"
^DIC(9.4,127,22,3,"PAH",58,1,11,0)="   DEFAULT BLOOD COMPONENT field (#41) in the SURGERY SITE PARAMETERS file"
^DIC(9.4,127,22,3,"PAH",58,1,12,0)="   (#133)."
^DIC(9.4,127,22,3,"PAH",58,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",58,1,14,0)="3. When updating a Risk Assessment Status to ""COMPLETE"", the software"
^DIC(9.4,127,22,3,"PAH",58,1,15,0)="   checks for missing information and provides the ability to update it."
^DIC(9.4,127,22,3,"PAH",58,1,16,0)="   This option was overlooked when doing the Race & Ethnicity changes"
^DIC(9.4,127,22,3,"PAH",58,1,17,0)="   (patch SR*3*111). This patch removes the current checking for the RACE "
^DIC(9.4,127,22,3,"PAH",58,1,18,0)="   field (#417) in the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",58,1,19,0)=" "
^DIC(9.4,127,22,3,"PAH",58,1,20,0)="4. When using the Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT]"
^DIC(9.4,127,22,3,"PAH",58,1,21,0)="   option, there is a possibility of getting an undefined error if the"
^DIC(9.4,127,22,3,"PAH",58,1,22,0)="   length of the race data is found to be more than forty characters."
^DIC(9.4,127,22,3,"PAH",58,1,23,0)="   This patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",59,0)="114 SEQ #112^3030912^1"
^DIC(9.4,127,22,3,"PAH",59,1,0)="^^32^32^3030912"
^DIC(9.4,127,22,3,"PAH",59,1,1,0)="1. Surgery is using the Flag Drugs for Use as Anesthesia Agents [SROCODE] "
^DIC(9.4,127,22,3,"PAH",59,1,2,0)="   option to flag drugs in the DRUG file (#50) for use as anesthesia "
^DIC(9.4,127,22,3,"PAH",59,1,3,0)="   agents. This patch modifies this option to call Pharmacy Data"
^DIC(9.4,127,22,3,"PAH",59,1,4,0)="   Management V. 1.0 (PDM) package so that PDM possibly generates an HL7"
^DIC(9.4,127,22,3,"PAH",59,1,5,0)="   outgoing drug message."
^DIC(9.4,127,22,3,"PAH",59,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",59,1,7,0)="2. When canceling a concurrent case using the Cancel Scheduled Operation "
^DIC(9.4,127,22,3,"PAH",59,1,8,0)="   [SRSCAN] option, the software prompts, ""There is a concurrent case "
^DIC(9.4,127,22,3,"PAH",59,1,9,0)="   associated with this operation. Do you want to cancel it also? YES//""."
^DIC(9.4,127,22,3,"PAH",59,1,10,0)="   If the user quits using the up-arrow (""^""), the software does not"
^DIC(9.4,127,22,3,"PAH",59,1,11,0)="   respond correctly and subsequently errors out. This patch fixes this"
^DIC(9.4,127,22,3,"PAH",59,1,12,0)="   problem."
^DIC(9.4,127,22,3,"PAH",59,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",59,1,14,0)="3. It was reported that if the Surgery case was in a requested state "
^DIC(9.4,127,22,3,"PAH",59,1,15,0)="   and if an entry is made in the TIME PAT IN OR field (#.205) of the "
^DIC(9.4,127,22,3,"PAH",59,1,16,0)="   SURGERY file (#130), it is found that the time gets appended to the"
^DIC(9.4,127,22,3,"PAH",59,1,17,0)="   DATE OF OPERATION field (#.09) of the SURGERY file (#130). This is"
^DIC(9.4,127,22,3,"PAH",59,1,18,0)="   causing the time to appear in the scheduling grid and prevents the case"
^DIC(9.4,127,22,3,"PAH",59,1,19,0)="   scheduling. This entry should be made only if the case is in a"
^DIC(9.4,127,22,3,"PAH",59,1,20,0)="   scheduled state or entered via the Operation Menu [SROPER] option. This"
^DIC(9.4,127,22,3,"PAH",59,1,21,0)="   patch provides the user the option to delete any of the following"
^DIC(9.4,127,22,3,"PAH",59,1,22,0)="   entered date fields as a pre-condition for scheduling such cases:"
^DIC(9.4,127,22,3,"PAH",59,1,23,0)=" "
^DIC(9.4,127,22,3,"PAH",59,1,24,0)="    - ANES CARE START TIME field (#.21), TIME OPERATION BEGAN "
^DIC(9.4,127,22,3,"PAH",59,1,25,0)="      field (#.22), TIME OPERATION ENDS field (#.23), ANES CARE END TIME"
^DIC(9.4,127,22,3,"PAH",59,1,26,0)="      field (#.24), TIME PAT IN OR field (#.205), and TIME PAT OUT OR"
^DIC(9.4,127,22,3,"PAH",59,1,27,0)="      field (#.232)"
^DIC(9.4,127,22,3,"PAH",59,1,28,0)=" "
^DIC(9.4,127,22,3,"PAH",59,1,29,0)="   This functionality is added to the following options:"
^DIC(9.4,127,22,3,"PAH",59,1,30,0)="    - Delete or Update Operation Requests [SRSUPRQ] option"
^DIC(9.4,127,22,3,"PAH",59,1,31,0)="    - Schedule Requested Operations [SRSCHD1] option"
^DIC(9.4,127,22,3,"PAH",59,1,32,0)="    - Reschedule or Update a Scheduled Operation [SRSCHUP] option"
^DIC(9.4,127,22,3,"PAH",60,0)="120 SEQ #113^3030924^1"
^DIC(9.4,127,22,3,"PAH",60,1,0)="^^21^21^3030924"
^DIC(9.4,127,22,3,"PAH",60,1,1,0)="As a follow-up enhancement to Surgery patch SR*3*115, this patch adds a "
^DIC(9.4,127,22,3,"PAH",60,1,2,0)="new report option to assist in reviewing compliance with the process "
^DIC(9.4,127,22,3,"PAH",60,1,3,0)="defined by directive 2002-070, ENSURING CORRECT SURGERY. Ensuring Correct "
^DIC(9.4,127,22,3,"PAH",60,1,4,0)="Surgery Compliance Report [SRO ECS COMPLIANCE] option is added to the "
^DIC(9.4,127,22,3,"PAH",60,1,5,0)="Management Reports [SRO-CHIEF REPORTS] menu on the Chief of Surgery Menu"
^DIC(9.4,127,22,3,"PAH",60,1,6,0)="[SROCHIEF] option. "
^DIC(9.4,127,22,3,"PAH",60,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",60,1,8,0)="This report checks the two fields added to SURGERY file (#130) by Surgery "
^DIC(9.4,127,22,3,"PAH",60,1,9,0)="patch SR*3*115, the TIME OUT VERIFIED field (#71) and the IMAGING "
^DIC(9.4,127,22,3,"PAH",60,1,10,0)="CONFIRMED field (#72). A surgical case is counted as compliant with the "
^DIC(9.4,127,22,3,"PAH",60,1,11,0)="documentation process for ensuring correct surgery if the TIME OUT "
^DIC(9.4,127,22,3,"PAH",60,1,12,0)="VERIFIED field (#71) is YES and if the IMAGING CONFIRMED field (#72) is "
^DIC(9.4,127,22,3,"PAH",60,1,13,0)="either YES or NOT APPLICABLE."
^DIC(9.4,127,22,3,"PAH",60,1,14,0)=" "
^DIC(9.4,127,22,3,"PAH",60,1,15,0)="This report includes two parts, either of which may be printed separately "
^DIC(9.4,127,22,3,"PAH",60,1,16,0)="or combined: "
^DIC(9.4,127,22,3,"PAH",60,1,17,0)=" 1. Compliance Summary - This part shows the number of cases with each of"
^DIC(9.4,127,22,3,"PAH",60,1,18,0)="    the possible data scenarios for the two fields in question and their"
^DIC(9.4,127,22,3,"PAH",60,1,19,0)="    percentage of the total cases performed."
^DIC(9.4,127,22,3,"PAH",60,1,20,0)=" 2. List of Non-Compliant Cases - This part provides a list of surgical"
^DIC(9.4,127,22,3,"PAH",60,1,21,0)="    cases that are not compliant (as defined above)."
^DIC(9.4,127,22,3,"PAH",61,0)="116^3030924^1"
^DIC(9.4,127,22,3,"PAH",61,1,0)="^^2^2^3030924"
^DIC(9.4,127,22,3,"PAH",61,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,127,22,3,"PAH",61,1,2,0)="included in this patch."
^DIC(9.4,127,22,3,"PAH",62,0)="123 SEQ #115^3031002^1"
^DIC(9.4,127,22,3,"PAH",62,1,0)="^^12^12^3031002"
^DIC(9.4,127,22,3,"PAH",62,1,1,0)="As a follow-up enhancement to Surgery patch SR*3*115 (released April 8, "
^DIC(9.4,127,22,3,"PAH",62,1,2,0)="2003), this patch updates the Quarterly Report by adding the Compliance "
^DIC(9.4,127,22,3,"PAH",62,1,3,0)="Summary portion of the Ensuring Correct Surgery Compliance Report (made "
^DIC(9.4,127,22,3,"PAH",62,1,4,0)="available by patch SR*3*120) to the end of the existing Quarterly Report."
^DIC(9.4,127,22,3,"PAH",62,1,5,0)="This additional information will be transmitted as part of the Quarterly"
^DIC(9.4,127,22,3,"PAH",62,1,6,0)="Report that goes to Surgical Service, Central Office."
^DIC(9.4,127,22,3,"PAH",62,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",62,1,8,0)="A post-install process will automatically transmit the Quarterly Report "
^DIC(9.4,127,22,3,"PAH",62,1,9,0)="for the third quarter of Fiscal Year 2003. If this patch is installed"
^DIC(9.4,127,22,3,"PAH",62,1,10,0)="after November 13, 2003, the Quarterly Report for the fourth quarter of"
^DIC(9.4,127,22,3,"PAH",62,1,11,0)="Fiscal Year 2003 will also be automatically transmitted by a post-install"
^DIC(9.4,127,22,3,"PAH",62,1,12,0)="process."
^DIC(9.4,127,22,3,"PAH",63,0)="121 SEQ #116^3031023^1"
^DIC(9.4,127,22,3,"PAH",63,1,0)="^^15^15^3031023"
^DIC(9.4,127,22,3,"PAH",63,1,1,0)="This is an enhancement patch to the Surgery V. 3.0 software. It will"
^DIC(9.4,127,22,3,"PAH",63,1,2,0)="allow assessment lookups by assessment (case) number, in addition to the"
^DIC(9.4,127,22,3,"PAH",63,1,3,0)="lookups by patient. The following options under the Surgery Risk"
^DIC(9.4,127,22,3,"PAH",63,1,4,0)="Assessment Menu [SROA RISK ASSESSMENT] option has this functionality"
^DIC(9.4,127,22,3,"PAH",63,1,5,0)="incorporated:"
^DIC(9.4,127,22,3,"PAH",63,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",63,1,7,0)=" - Non-Cardiac Assessment Information (Enter/Edit) [SROA ENTER/EDIT]"
^DIC(9.4,127,22,3,"PAH",63,1,8,0)=" - Cardiac Risk Assessment Information (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",63,1,9,0)="    [SROA CARDIAC ENTER/EDIT]"
^DIC(9.4,127,22,3,"PAH",63,1,10,0)=" - Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT]"
^DIC(9.4,127,22,3,"PAH",63,1,11,0)=" - Update Assessment Completed/Transmitted in Error"
^DIC(9.4,127,22,3,"PAH",63,1,12,0)="    [SROA TRANSMITTED IN ERROR]"
^DIC(9.4,127,22,3,"PAH",63,1,13,0)=" - Print 30 Day Follow-up Letters [SROA REPRINT LETTERS]"
^DIC(9.4,127,22,3,"PAH",63,1,14,0)=" - Exclusion Criteria (Enter/Edit) [SR NO ASSESSMENT REASON]"
^DIC(9.4,127,22,3,"PAH",63,1,15,0)=" - Update 1-Liner Case [SROA ONE-LINER UPDATE]"
^DIC(9.4,127,22,3,"PAH",64,0)="118 SEQ #117^3031107^1"
^DIC(9.4,127,22,3,"PAH",64,1,0)="^^7^7^3031107"
^DIC(9.4,127,22,3,"PAH",64,1,1,0)="This patch corrects two problems. It corrects the problem in the "
^DIC(9.4,127,22,3,"PAH",64,1,2,0)="display when entering ""Other Procedures"" in the Operation [SROMEN-OP]"
^DIC(9.4,127,22,3,"PAH",64,1,3,0)="Option. The display is limited to 15 entries, and sometimes more"
^DIC(9.4,127,22,3,"PAH",64,1,4,0)="than 15 ""Other Procedures"" entries are needed. The patch also corrects"
^DIC(9.4,127,22,3,"PAH",64,1,5,0)="a problem that occurs when printing the PCE Filing Status report. "
^DIC(9.4,127,22,3,"PAH",64,1,6,0)="Long names should list the initial for the patient's first name.  "
^DIC(9.4,127,22,3,"PAH",64,1,7,0)="Currently, the report drops the first name completely."
^DIC(9.4,127,22,3,"PAH",65,0)="124 SEQ #118^3031107^1"
^DIC(9.4,127,22,3,"PAH",65,1,0)="^^1^1^3031107"
^DIC(9.4,127,22,3,"PAH",65,1,1,0)="This patch corrects the null subscript error in SROPRPT routine."
^DIC(9.4,127,22,3,"PAH",66,0)="122 SEQ #119^3040330^1"
^DIC(9.4,127,22,3,"PAH",66,1,0)="^^3^3^3040330"
^DIC(9.4,127,22,3,"PAH",66,1,1,0)="This patch updates the PROTOCOL file(#101) and HL LOGICAL LINK file(#870) "
^DIC(9.4,127,22,3,"PAH",66,1,2,0)="for the Surgery interface.  HL LOGICAL LINK file(#870) does not contain "
^DIC(9.4,127,22,3,"PAH",66,1,3,0)="any site specific data."
^DIC(9.4,127,22,3,"PAH",67,0)="126 SEQ #120^3040330^1"
^DIC(9.4,127,22,3,"PAH",67,1,0)="^^48^48^3040330"
^DIC(9.4,127,22,3,"PAH",67,1,1,0)="This patch is an enhancement to the Surgery software providing additional"
^DIC(9.4,127,22,3,"PAH",67,1,2,0)="changes related to Ensuring Correct Surgery. This patch is Phase I of the"
^DIC(9.4,127,22,3,"PAH",67,1,3,0)="enhancement."
^DIC(9.4,127,22,3,"PAH",67,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,5,0)="This patch exports the following new fields in the SURGERY file (#130):"
^DIC(9.4,127,22,3,"PAH",67,1,6,0)=" - The MARKED SITE CONFIRMED field (#73) will have three choices:"
^DIC(9.4,127,22,3,"PAH",67,1,7,0)="   ""Y, YES"", ""M, MARKING NOT REQUIRED FOR THIS PROCEDURE"" and ""N, NO -"
^DIC(9.4,127,22,3,"PAH",67,1,8,0)="   MARKING REQUIRED BUT NOT DONE (see CORRECT SURGERY COMMENTS)""."
^DIC(9.4,127,22,3,"PAH",67,1,9,0)=" - The CORRECT SURGERY COMMENTS field (#74) which is a word processing"
^DIC(9.4,127,22,3,"PAH",67,1,10,0)="   type field."
^DIC(9.4,127,22,3,"PAH",67,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,12,0)="This patch modifies the following four existing fields in the SURGERY"
^DIC(9.4,127,22,3,"PAH",67,1,13,0)="file (#130):"
^DIC(9.4,127,22,3,"PAH",67,1,14,0)=" - A minor change is made to the description of the ""NO"" choice in"
^DIC(9.4,127,22,3,"PAH",67,1,15,0)="   the TIME OUT VERIFIED field (#71)."
^DIC(9.4,127,22,3,"PAH",67,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,17,0)=" - The PREOPERATIVE IMAGING CONFIRMED field (#72) will have three"
^DIC(9.4,127,22,3,"PAH",67,1,18,0)="   choices: ""Y, YES"", ""I, IMAGING NOT REQUIRED FOR THIS PROCEDURE"" and"
^DIC(9.4,127,22,3,"PAH",67,1,19,0)="   ""N, NO - IMAGING REQUIRED BUT NOT VIEWED (see CORRECT SURGERY"
^DIC(9.4,127,22,3,"PAH",67,1,20,0)="   COMMENTS)"""
^DIC(9.4,127,22,3,"PAH",67,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,22,0)=" - The description of the different choices of the ATTENDING CODE"
^DIC(9.4,127,22,3,"PAH",67,1,23,0)="   field (#.165) is modified."
^DIC(9.4,127,22,3,"PAH",67,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,25,0)=" - The maximum number of years of surgical residency (post graduate)"
^DIC(9.4,127,22,3,"PAH",67,1,26,0)="   of the PGY OF PRIMARY SURGEON field (#214) is changed from 10 to 12."
^DIC(9.4,127,22,3,"PAH",67,1,27,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,28,0)="This patch also exports the following new date/time fields that will be"
^DIC(9.4,127,22,3,"PAH",67,1,29,0)="used to time-stamp when the three correct Surgery fields (TIME OUT"
^DIC(9.4,127,22,3,"PAH",67,1,30,0)="VERIFIED (#71), PREOPERATIVE IMAGING CONFIRMED (#72), and MARKED SITE"
^DIC(9.4,127,22,3,"PAH",67,1,31,0)="CONFIRMED (#73)) of the SURGERY file (#130) are entered or edited, and"
^DIC(9.4,127,22,3,"PAH",67,1,32,0)="they are not editable fields:"
^DIC(9.4,127,22,3,"PAH",67,1,33,0)=" - TOV TIMESTAMP field (#75)"
^DIC(9.4,127,22,3,"PAH",67,1,34,0)=" - IMAG TIMESTAMP field (#76)"
^DIC(9.4,127,22,3,"PAH",67,1,35,0)=" - SITE MARK TIMESTAMP field (#77)"
^DIC(9.4,127,22,3,"PAH",67,1,36,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,37,0)="These fields MARKED SITE CONFIRMED (#73), PREOPERATIVE IMAGING CONFIRMED"
^DIC(9.4,127,22,3,"PAH",67,1,38,0)="(#72), and CORRECT SURGERY COMMENTS (#74) are found under the following"
^DIC(9.4,127,22,3,"PAH",67,1,39,0)="menu options:"
^DIC(9.4,127,22,3,"PAH",67,1,40,0)=" - Operation [SROMEN-OP] option"
^DIC(9.4,127,22,3,"PAH",67,1,41,0)=" - Operation (Short Screen) [SROMEN-OUT] option"
^DIC(9.4,127,22,3,"PAH",67,1,42,0)=" - Operation Startup [SROMEN-START] option"
^DIC(9.4,127,22,3,"PAH",67,1,43,0)=" "
^DIC(9.4,127,22,3,"PAH",67,1,44,0)="This patch will disable the Ensuring Correct Surgery Compliance Report"
^DIC(9.4,127,22,3,"PAH",67,1,45,0)="[SRO ECS COMPLIANCE] option. Also, the compliance section of the"
^DIC(9.4,127,22,3,"PAH",67,1,46,0)="Quarterly Report - Surgical Service [SRO QUARTERLY REPORT] option will be"
^DIC(9.4,127,22,3,"PAH",67,1,47,0)="disabled until Correct Surgery Enhancements 2004 Phase II is released,"
^DIC(9.4,127,22,3,"PAH",67,1,48,0)="targeted date is June 2004."
^DIC(9.4,127,22,3,"PAH",68,0)="100^3040427^1"
^DIC(9.4,127,22,3,"PAH",68,1,0)="^^12^12^3040427"
^DIC(9.4,127,22,3,"PAH",68,1,1,0)="This patch provides the ability to electronically sign operative reports "
^DIC(9.4,127,22,3,"PAH",68,1,2,0)="contained within the VISTA Surgery V. 3.0 application. These reports"
^DIC(9.4,127,22,3,"PAH",68,1,3,0)="include the Operation Report, the Nurse Intraoperative Report, the"
^DIC(9.4,127,22,3,"PAH",68,1,4,0)="Anesthesia Report and the Procedure Report (Non-O.R.). This patch provides"
^DIC(9.4,127,22,3,"PAH",68,1,5,0)="the ability to view these signed reports through the Computerized Patient"
^DIC(9.4,127,22,3,"PAH",68,1,6,0)="Record System (CPRS) by storing them in the Text Integration Utilities"
^DIC(9.4,127,22,3,"PAH",68,1,7,0)="(TIU) V. 1.0 application. Tools provided by the TIU software will be used"
^DIC(9.4,127,22,3,"PAH",68,1,8,0)="to sign and manage the electronic documents."
^DIC(9.4,127,22,3,"PAH",68,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",68,1,10,0)="Features provided by this patch are described in the Surgery Electronic "
^DIC(9.4,127,22,3,"PAH",68,1,11,0)="Signature for Operative Reports Release Notes and in the Surgery "
^DIC(9.4,127,22,3,"PAH",68,1,12,0)="Electronic Signature for Operative Reports Implementation Guide."
^DIC(9.4,127,22,3,"PAH",69,0)="128 SEQ #122^3040507^1"
^DIC(9.4,127,22,3,"PAH",69,1,0)="^^20^20^3040507"
^DIC(9.4,127,22,3,"PAH",69,1,1,0)="This patch addresses follow-up issues related to the Surgery Electronic "
^DIC(9.4,127,22,3,"PAH",69,1,2,0)="Signature for Operative Reports patch (SR*3*100)."
^DIC(9.4,127,22,3,"PAH",69,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",69,1,4,0)="1. Converted documents for historical surgical/non-OR cases are stored in "
^DIC(9.4,127,22,3,"PAH",69,1,5,0)="   the TIU DOCUMENT file (#8925) with a status of COMPLETED, but they "
^DIC(9.4,127,22,3,"PAH",69,1,6,0)="   have no signature date. Therefore, when one of these converted"
^DIC(9.4,127,22,3,"PAH",69,1,7,0)="   documents is printed, the following line is printed at the end of the"
^DIC(9.4,127,22,3,"PAH",69,1,8,0)="   document text:"
^DIC(9.4,127,22,3,"PAH",69,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",69,1,10,0)="**DRAFT COPY - DRAFT COPY -- ABOVE NOTE IS UNSIGNED-- DRAFT COPY - DRAFT COPY**"
^DIC(9.4,127,22,3,"PAH",69,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",69,1,12,0)="   This patch modifies the routine SROESPR1 to prevent the display of this"
^DIC(9.4,127,22,3,"PAH",69,1,13,0)="   line if the document has a status of COMPLETED. See NOIS"
^DIC(9.4,127,22,3,"PAH",69,1,14,0)="   FAR-0104-40622."
^DIC(9.4,127,22,3,"PAH",69,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",69,1,16,0)="2. The input template SROARPT is used by the Anesthesia Report [SROARPT] "
^DIC(9.4,127,22,3,"PAH",69,1,17,0)="   option to edit fields that are part of the Anesthesia Report. This "
^DIC(9.4,127,22,3,"PAH",69,1,18,0)="   patch modifies this input template to remove the INTRAOPERATIVE"
^DIC(9.4,127,22,3,"PAH",69,1,19,0)="   OCCURRENCES field (#1.14) and the POSTOP OCCURRENCE field (#1.16) since"
^DIC(9.4,127,22,3,"PAH",69,1,20,0)="   these two fields do not appear on the Anesthesia Report."
^DIC(9.4,127,22,3,"PAH",70,0)="129 SEQ #123^3040903^1"
^DIC(9.4,127,22,3,"PAH",70,1,0)="^^114^114^3040903"
^DIC(9.4,127,22,3,"PAH",70,1,1,0)="******************************* N O T E **********************************"
^DIC(9.4,127,22,3,"PAH",70,1,2,0)="There is no conflict between this patch and the CoreFLS software."
^DIC(9.4,127,22,3,"PAH",70,1,3,0)="Installation of this patch by the CoreFLS sites will not cause any "
^DIC(9.4,127,22,3,"PAH",70,1,4,0)="problems."
^DIC(9.4,127,22,3,"PAH",70,1,5,0)="**************************************************************************"
^DIC(9.4,127,22,3,"PAH",70,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,7,0)="1. RESIDENT SUPERVISION"
^DIC(9.4,127,22,3,"PAH",70,1,8,0)="   The Veterans Health Administration (VHA) Handbook 1400.1, dated May 3, "
^DIC(9.4,127,22,3,"PAH",70,1,9,0)="   2004, changed the levels of resident supervision for operating room "
^DIC(9.4,127,22,3,"PAH",70,1,10,0)="   procedures. This patch implements the new levels of resident "
^DIC(9.4,127,22,3,"PAH",70,1,11,0)="   supervision in the Surgery software and includes the following"
^DIC(9.4,127,22,3,"PAH",70,1,12,0)="   features:"
^DIC(9.4,127,22,3,"PAH",70,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,14,0)=" (a) A new file, ATTENDING CODES file (#132.9), is created to store all "
^DIC(9.4,127,22,3,"PAH",70,1,15,0)="     attending codes used by the Surgery software. These codes include "
^DIC(9.4,127,22,3,"PAH",70,1,16,0)="     both sets of Levels 0 to 3 (before and after patch SR*3*126, all"
^DIC(9.4,127,22,3,"PAH",70,1,17,0)="     flagged as inactive codes) and the latest codes for Levels A to F"
^DIC(9.4,127,22,3,"PAH",70,1,18,0)="     (active codes)."
^DIC(9.4,127,22,3,"PAH",70,1,19,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,20,0)=" (b) The name of the existing ATTENDING CODE field (#.165) in the SURGERY"
^DIC(9.4,127,22,3,"PAH",70,1,21,0)="     file (#130) is changed to *ATTENDING CODE - NOT USED and a new"
^DIC(9.4,127,22,3,"PAH",70,1,22,0)="     ATTENDING CODE field (#.166) is created that points to the ATTENDING"
^DIC(9.4,127,22,3,"PAH",70,1,23,0)="     CODES file (#132.9)."
^DIC(9.4,127,22,3,"PAH",70,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,25,0)=" (c) The patch includes a post-install conversion that loops through all "
^DIC(9.4,127,22,3,"PAH",70,1,26,0)="     the cases in the SURGERY file (#130) and matches the attending code"
^DIC(9.4,127,22,3,"PAH",70,1,27,0)="     in the old field (#.165) with the equivalent code in the new"
^DIC(9.4,127,22,3,"PAH",70,1,28,0)="     ATTENDING CODE field (#.166), storing the equivalent code in the new"
^DIC(9.4,127,22,3,"PAH",70,1,29,0)="     field. The content of the old field is not changed by the conversion."
^DIC(9.4,127,22,3,"PAH",70,1,30,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,31,0)=" (d) The following data entry options are updated to use the new ATTENDING"
^DIC(9.4,127,22,3,"PAH",70,1,32,0)="     CODE field (#.166): "
^DIC(9.4,127,22,3,"PAH",70,1,33,0)="     - Post Operation [SROMEN-POST] "
^DIC(9.4,127,22,3,"PAH",70,1,34,0)="     - Operation (Short Screen) [SROMEN-OUT] "
^DIC(9.4,127,22,3,"PAH",70,1,35,0)="     - Surgical Staff [SROMEN-STAFF] "
^DIC(9.4,127,22,3,"PAH",70,1,36,0)="     - Edit Non-O.R. Procedure [SRONOP-EDIT] "
^DIC(9.4,127,22,3,"PAH",70,1,37,0)="     - Update 1-Liner Case [SROA ONE-LINER UPDATE]"
^DIC(9.4,127,22,3,"PAH",70,1,38,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,39,0)=" (e) The following report and display options are updated to use the new "
^DIC(9.4,127,22,3,"PAH",70,1,40,0)="     ATTENDING CODE field (#.166): "
^DIC(9.4,127,22,3,"PAH",70,1,41,0)="     - Attending Surgeon Reports [SROATT] "
^DIC(9.4,127,22,3,"PAH",70,1,42,0)="     - View Patient Perioperative Occurrences [SROMEN-M&M] "
^DIC(9.4,127,22,3,"PAH",70,1,43,0)="     - Operation Information [SROMEN-OPINFO] "
^DIC(9.4,127,22,3,"PAH",70,1,44,0)="     - Quarterly Report - Surgical Service [SRO QUARTERLY REPORT] "
^DIC(9.4,127,22,3,"PAH",70,1,45,0)="       Note: The Perioperative Occurrence Categories on this report are"
^DIC(9.4,127,22,3,"PAH",70,1,46,0)="       updated to reflect the categories used by the National Surgical"
^DIC(9.4,127,22,3,"PAH",70,1,47,0)="       Quality Improvement Program (NSQIP) and the Continuous Improvement"
^DIC(9.4,127,22,3,"PAH",70,1,48,0)="       in Cardiac Surgery Program (CICSP). Some of these categories may"
^DIC(9.4,127,22,3,"PAH",70,1,49,0)="       not be immediately available for selection, but will be included"
^DIC(9.4,127,22,3,"PAH",70,1,50,0)="       later in the NSQIP/CICSP ENHANCEMENTS 2004 patch (SR*3*125)."
^DIC(9.4,127,22,3,"PAH",70,1,51,0)="     - List of Operations Included on Quarterly Report [SROQ LIST OPS] "
^DIC(9.4,127,22,3,"PAH",70,1,52,0)="     - Report of Missing Quarterly Report Data [SROQ MISSING DATA]"
^DIC(9.4,127,22,3,"PAH",70,1,53,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,54,0)=" (f) The patch updates the transmission of Quarterly Report data to the "
^DIC(9.4,127,22,3,"PAH",70,1,55,0)="     national database to use the new ATTENDING CODE field (#.166).  "
^DIC(9.4,127,22,3,"PAH",70,1,56,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,57,0)="2. ENSURING CORRECT SURGERY PHASE II"
^DIC(9.4,127,22,3,"PAH",70,1,58,0)="   Phase II of the Ensuring Correct Surgery Enhancement Project provides"
^DIC(9.4,127,22,3,"PAH",70,1,59,0)="   the following enhancements:"
^DIC(9.4,127,22,3,"PAH",70,1,60,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,61,0)=" (a) The following new fields are added to the SURGERY file (#130):"
^DIC(9.4,127,22,3,"PAH",70,1,62,0)="     - TIME OUT VERIFIED COMMENTS field (#82)"
^DIC(9.4,127,22,3,"PAH",70,1,63,0)="     - IMAGING CONFIRMED COMMENTS field (#83)"
^DIC(9.4,127,22,3,"PAH",70,1,64,0)="     - MARKED SITE COMMENTS field (#84)"
^DIC(9.4,127,22,3,"PAH",70,1,65,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,66,0)="     These fields are added to capture the comments corresponding to the"
^DIC(9.4,127,22,3,"PAH",70,1,67,0)="     following:"
^DIC(9.4,127,22,3,"PAH",70,1,68,0)="     - TIME OUT VERIFIED field (#71)"
^DIC(9.4,127,22,3,"PAH",70,1,69,0)="     - PREOPERATIVE IMAGING CONFIRMED field (#72)"
^DIC(9.4,127,22,3,"PAH",70,1,70,0)="     - MARKED SITE CONFIRMED field (#73)"
^DIC(9.4,127,22,3,"PAH",70,1,71,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,72,0)=" (b) The following data entry options will be modified to include"
^DIC(9.4,127,22,3,"PAH",70,1,73,0)="     the new comment fields noted in item (a):"
^DIC(9.4,127,22,3,"PAH",70,1,74,0)="     - Operation [SROMEN-OP]"
^DIC(9.4,127,22,3,"PAH",70,1,75,0)="     - Operation (Short Screen) [SROMEN-OUT]"
^DIC(9.4,127,22,3,"PAH",70,1,76,0)="     - Nurse Intraoperative Report [SRONRPT]"
^DIC(9.4,127,22,3,"PAH",70,1,77,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,78,0)="     Entry of ""NO"" in any of the three Correct Surgery fields will prompt"
^DIC(9.4,127,22,3,"PAH",70,1,79,0)="     the user to enter the associated comment field. Entry of ""NO"" in"
^DIC(9.4,127,22,3,"PAH",70,1,80,0)="     any of the three Correct Surgery fields will not automatically force"
^DIC(9.4,127,22,3,"PAH",70,1,81,0)="     entry into the respective comment field."
^DIC(9.4,127,22,3,"PAH",70,1,82,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,83,0)=" (c) Nurse Intraoperative Report Changes"
^DIC(9.4,127,22,3,"PAH",70,1,84,0)="     If any of the three Correct Surgery fields are not answered, the"
^DIC(9.4,127,22,3,"PAH",70,1,85,0)="     nurse will not be able to electronically sign the Nurse"
^DIC(9.4,127,22,3,"PAH",70,1,86,0)="     Intraoperative Report. If any of the three Correct Surgery fields is"
^DIC(9.4,127,22,3,"PAH",70,1,87,0)="     answered ""NO"" but does not have information in the corresponding"
^DIC(9.4,127,22,3,"PAH",70,1,88,0)="     comments field, the nurse will not be able to electronically sign the"
^DIC(9.4,127,22,3,"PAH",70,1,89,0)="     Nurse Intraoperative Report. The nurse will be able to update this"
^DIC(9.4,127,22,3,"PAH",70,1,90,0)="     information at time of signature without leaving the option."
^DIC(9.4,127,22,3,"PAH",70,1,91,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,92,0)=" (d) The compliance reports, which were disabled in phase I are "
^DIC(9.4,127,22,3,"PAH",70,1,93,0)="     reactivated and are modified to display the new formats for the three"
^DIC(9.4,127,22,3,"PAH",70,1,94,0)="     Correct Surgery fields."
^DIC(9.4,127,22,3,"PAH",70,1,95,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,96,0)=" (e) Convert Existing Comments"
^DIC(9.4,127,22,3,"PAH",70,1,97,0)="     For each of the three Correct Surgery fields answered with a ""NO"" "
^DIC(9.4,127,22,3,"PAH",70,1,98,0)="     response, the information in the CORRECT SURGERY COMMENTS field (#27)"
^DIC(9.4,127,22,3,"PAH",70,1,99,0)="     of the SURGERY file (#130) will be replicated in the corresponding"
^DIC(9.4,127,22,3,"PAH",70,1,100,0)="     comment field."
^DIC(9.4,127,22,3,"PAH",70,1,101,0)="     At the end of the conversion process, this patch will delete the data"
^DIC(9.4,127,22,3,"PAH",70,1,102,0)="     dictionary of the CORRECT SURGERY COMMENTS field (#74) in the SURGERY"
^DIC(9.4,127,22,3,"PAH",70,1,103,0)="     file (#130), which was exported in phase I of the Ensuring Correct"
^DIC(9.4,127,22,3,"PAH",70,1,104,0)="     Surgery patch SR*3.0*126."
^DIC(9.4,127,22,3,"PAH",70,1,105,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,106,0)="3. SURGEON PRESENT TIME ON NURSE INTRAOPERATIVE REPORT"
^DIC(9.4,127,22,3,"PAH",70,1,107,0)="   Patch SR*3*25 modified the Nurse Intraoperative Report so that it "
^DIC(9.4,127,22,3,"PAH",70,1,108,0)="   displayed the SURG PRESENT TIME field (#.206) only if data was entered."
^DIC(9.4,127,22,3,"PAH",70,1,109,0)="   This functionality, omitted unintentionally by patch SR*3*100, is"
^DIC(9.4,127,22,3,"PAH",70,1,110,0)="   restored by this patch."
^DIC(9.4,127,22,3,"PAH",70,1,111,0)=" "
^DIC(9.4,127,22,3,"PAH",70,1,112,0)="4. DOCUMENTS PRINTED FROM TIU"
^DIC(9.4,127,22,3,"PAH",70,1,113,0)="   This patch modifies the routine SROESPR to correct a possible problem "
^DIC(9.4,127,22,3,"PAH",70,1,114,0)="   if no print group is defined when a document is printed."
^DIC(9.4,127,22,3,"PAH",71,0)="132 SEQ #124^3040903^1"
^DIC(9.4,127,22,3,"PAH",71,1,0)="^^27^27^3040903"
^DIC(9.4,127,22,3,"PAH",71,1,1,0)="******************************* N O T E *********************************"
^DIC(9.4,127,22,3,"PAH",71,1,2,0)="There is no conflict between this patch and the CoreFLS software."
^DIC(9.4,127,22,3,"PAH",71,1,3,0)="Installation of this patch by the CoreFLS sites will not cause any "
^DIC(9.4,127,22,3,"PAH",71,1,4,0)="problems."
^DIC(9.4,127,22,3,"PAH",71,1,5,0)="*************************************************************************"
^DIC(9.4,127,22,3,"PAH",71,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",71,1,7,0)="Prior to patch SR*3*100, the Procedure Report (Non-OR) included an "
^DIC(9.4,127,22,3,"PAH",71,1,8,0)="""op-top"" section that included many of the data fields documenting the "
^DIC(9.4,127,22,3,"PAH",71,1,9,0)="procedure in the SURGERY file (#130) in addition to the provider's "
^DIC(9.4,127,22,3,"PAH",71,1,10,0)="dictated summary, if present. After patch SR*3*100, the Procedure Report "
^DIC(9.4,127,22,3,"PAH",71,1,11,0)="(Non-OR) includes only the provider's dictated summary since only the "
^DIC(9.4,127,22,3,"PAH",71,1,12,0)="provider's dictated summary is electronically signed. The only way to "
^DIC(9.4,127,22,3,"PAH",71,1,13,0)="review the information entered into the data fields documenting the "
^DIC(9.4,127,22,3,"PAH",71,1,14,0)="procedure in the SURGERY file (#130) is by way of the data entry options "
^DIC(9.4,127,22,3,"PAH",71,1,15,0)="on the Non-O.R. Procedures (Enter/Edit) [SRONOP-ENTER] menu."
^DIC(9.4,127,22,3,"PAH",71,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",71,1,17,0)="This patch adds the Non-OR Procedure Information [SR NON-OR INFO] option, "
^DIC(9.4,127,22,3,"PAH",71,1,18,0)="to the Non-O.R. Procedures (Enter/Edit) [SRONOP-ENTER] menu and to the "
^DIC(9.4,127,22,3,"PAH",71,1,19,0)="CPT/ICD9 Update/Verify Menu [SRCODING UPDATE/VERIFY MENU]. This option "
^DIC(9.4,127,22,3,"PAH",71,1,20,0)="will display the ""op-top"" information that formerly was part of the "
^DIC(9.4,127,22,3,"PAH",71,1,21,0)="Procedure Report (Non-OR). The output from this option may be viewed on "
^DIC(9.4,127,22,3,"PAH",71,1,22,0)="the user's screen or may be printed.  "
^DIC(9.4,127,22,3,"PAH",71,1,23,0)=" "
^DIC(9.4,127,22,3,"PAH",71,1,24,0)="A future enhancement is planned that will incorporate the ""op-top"""
^DIC(9.4,127,22,3,"PAH",71,1,25,0)="information into an electronically signed document and thus be viewable in"
^DIC(9.4,127,22,3,"PAH",71,1,26,0)="the Computerized Patient Record System (CPRS). At this time, the details"
^DIC(9.4,127,22,3,"PAH",71,1,27,0)="of this enhancement and schedule for release are not known."
^DIC(9.4,127,22,3,"PAH",72,0)="125^3040903^1"
^DIC(9.4,127,22,3,"PAH",72,1,0)="^^37^37^3040903"
^DIC(9.4,127,22,3,"PAH",72,1,1,0)="******************************* N O T E **********************************"
^DIC(9.4,127,22,3,"PAH",72,1,2,0)="There is no conflict between this patch and the CoreFLS software."
^DIC(9.4,127,22,3,"PAH",72,1,3,0)="Installation of this patch by the CoreFLS sites will not cause any "
^DIC(9.4,127,22,3,"PAH",72,1,4,0)="problems."
^DIC(9.4,127,22,3,"PAH",72,1,5,0)="**************************************************************************"
^DIC(9.4,127,22,3,"PAH",72,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",72,1,7,0)="1. This patch updates the Surgery Risk Assessment software of the VISTA "
^DIC(9.4,127,22,3,"PAH",72,1,8,0)="   Surgery V. 3.0 application as requested by the National Surgical"
^DIC(9.4,127,22,3,"PAH",72,1,9,0)="   Quality Improvement Program (NSQIP) Executive Committee to bring the"
^DIC(9.4,127,22,3,"PAH",72,1,10,0)="   VA's NSQIP module more in line with the data collected in the private"
^DIC(9.4,127,22,3,"PAH",72,1,11,0)="   sector. This patch also include updates to the Continuous Improvement"
^DIC(9.4,127,22,3,"PAH",72,1,12,0)="   in Cardiac Surgery Program (CICSP) module. "
^DIC(9.4,127,22,3,"PAH",72,1,13,0)="   "
^DIC(9.4,127,22,3,"PAH",72,1,14,0)="   Modifications to the Surgery V. 3.0 software include:"
^DIC(9.4,127,22,3,"PAH",72,1,15,0)="   - the addition of 22 new fields to SURGERY file (#130)"
^DIC(9.4,127,22,3,"PAH",72,1,16,0)="   - the update of approximately 120 field descriptions for NSQIP and "
^DIC(9.4,127,22,3,"PAH",72,1,17,0)="     CICSP data elements in the SURGERY file (#130)"
^DIC(9.4,127,22,3,"PAH",72,1,18,0)="   - the update of data input screens to allow the input of additional"
^DIC(9.4,127,22,3,"PAH",72,1,19,0)="     data elements as well as to delete some data elements no longer "
^DIC(9.4,127,22,3,"PAH",72,1,20,0)="     needed"
^DIC(9.4,127,22,3,"PAH",72,1,21,0)="   - the addition of two new data input options, Laboratory Test Results "
^DIC(9.4,127,22,3,"PAH",72,1,22,0)="     (Enter/Edit) [SROA LAB-CARDIAC] and Outcome Information (Enter/Edit) "
^DIC(9.4,127,22,3,"PAH",72,1,23,0)="     [SROA CARDIAC-OUTCOMES], on the Cardiac Risk Assessment Information "
^DIC(9.4,127,22,3,"PAH",72,1,24,0)="     (Enter/Edit) [SROA CARDIAC ENTER/EDIT] menu"
^DIC(9.4,127,22,3,"PAH",72,1,25,0)="   - the removal of the option Update Operations as Unrelated/Related to "
^DIC(9.4,127,22,3,"PAH",72,1,26,0)="     Death [SRO DEATH RELATED] from Surgery Risk Assessment Menu [SROA"
^DIC(9.4,127,22,3,"PAH",72,1,27,0)="     RISK ASSESSMENT]"
^DIC(9.4,127,22,3,"PAH",72,1,28,0)="   - the update of assessment transmissions to reflect the current "
^DIC(9.4,127,22,3,"PAH",72,1,29,0)="     set of NSQIP and CICSP data elements"
^DIC(9.4,127,22,3,"PAH",72,1,30,0)="   - the update of occurrence categories in the PERIOPERATIVE OCCURRENCE"
^DIC(9.4,127,22,3,"PAH",72,1,31,0)="     CATEGORY file (#136.5)"
^DIC(9.4,127,22,3,"PAH",72,1,32,0)=" "
^DIC(9.4,127,22,3,"PAH",72,1,33,0)="2. This patch will enhance the lookup by case/assessment number feature"
^DIC(9.4,127,22,3,"PAH",72,1,34,0)="   introduced in patch SR*3*121. Within the Surgery Risk Assessment Menu "
^DIC(9.4,127,22,3,"PAH",72,1,35,0)="   [SROA RISK ASSESSMENT] option, at the ""Select Patient"" prompt, lookup"
^DIC(9.4,127,22,3,"PAH",72,1,36,0)="   by case/assessment number is allowed by entering the case number"
^DIC(9.4,127,22,3,"PAH",72,1,37,0)="   preceded by #, e.g., enter #6785 to go to case #6785."
^DIC(9.4,127,22,3,"PAH",73,0)="135 SEQ #126^3041015^1"
^DIC(9.4,127,22,3,"PAH",73,1,0)="^^21^21^3041015"
^DIC(9.4,127,22,3,"PAH",73,1,1,0)="1. NON-CARDIAC PREOP INFORMATION SCREEN, PAGE 1"
^DIC(9.4,127,22,3,"PAH",73,1,2,0)="   When editing all the GENERAL items on the first page of the"
^DIC(9.4,127,22,3,"PAH",73,1,3,0)="   Preoperative Information (Enter/Edit) [SROA PREOP DATA] option, the"
^DIC(9.4,127,22,3,"PAH",73,1,4,0)="   last two items are not presented for editing in the same order they"
^DIC(9.4,127,22,3,"PAH",73,1,5,0)="   appear on the main screen. This patch changes the order of presentation"
^DIC(9.4,127,22,3,"PAH",73,1,6,0)="   for editing to match the order on the main screen."
^DIC(9.4,127,22,3,"PAH",73,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",73,1,8,0)="2. SPELLING CORRECTION"
^DIC(9.4,127,22,3,"PAH",73,1,9,0)="   In the field description of the PREVIOUS CARDIAC SURGERY field (#266)"
^DIC(9.4,127,22,3,"PAH",73,1,10,0)="   in the SURGERY file (#130), the word aneurysectomy is changed to"
^DIC(9.4,127,22,3,"PAH",73,1,11,0)="   aneurysmectomy."
^DIC(9.4,127,22,3,"PAH",73,1,12,0)=" "
^DIC(9.4,127,22,3,"PAH",73,1,13,0)="3. REPEAT VENTILATOR W/IN 30 DAYS"
^DIC(9.4,127,22,3,"PAH",73,1,14,0)="   This patch modifies the cardiac assessment creation process to set the "
^DIC(9.4,127,22,3,"PAH",73,1,15,0)="   default value of the REPEAT VENTILATOR W/IN 30 DAYS field (#490) in "
^DIC(9.4,127,22,3,"PAH",73,1,16,0)="   the SURGERY file (#130) to NO if null."
^DIC(9.4,127,22,3,"PAH",73,1,17,0)=" "
^DIC(9.4,127,22,3,"PAH",73,1,18,0)="4. CPB STATUS"
^DIC(9.4,127,22,3,"PAH",73,1,19,0)="   This patch updates how the cardiopulmonary bypass status associated "
^DIC(9.4,127,22,3,"PAH",73,1,20,0)="   with a repeat cardiac surgical procedure outcome is updated and"
^DIC(9.4,127,22,3,"PAH",73,1,21,0)="   transmitted for cardiac assessments."
^DIC(9.4,127,22,3,"PAH",74,0)="127 SEQ #127^3041015^1"
^DIC(9.4,127,22,3,"PAH",74,1,0)="^^27^27^3041015"
^DIC(9.4,127,22,3,"PAH",74,1,1,0)="Office of Information Assurance, Office of Information, Veterans Health"
^DIC(9.4,127,22,3,"PAH",74,1,2,0)="Administration (VHA), requested modifications to the VHA Information"
^DIC(9.4,127,22,3,"PAH",74,1,3,0)="Systems and Technical Architecture (VistA) Patient Information Management"
^DIC(9.4,127,22,3,"PAH",74,1,4,0)="System (PIMS) package that would allow for the use of multiple versions of"
^DIC(9.4,127,22,3,"PAH",74,1,5,0)="the code sets employed in financial transactions. This work was completed"
^DIC(9.4,127,22,3,"PAH",74,1,6,0)="in 2003 in the Code Set Versioning (CSV) project that was deployed in"
^DIC(9.4,127,22,3,"PAH",74,1,7,0)="October of 2003. CSV included the Health Information Portability and"
^DIC(9.4,127,22,3,"PAH",74,1,8,0)="Accessibility Act (HIPAA) stipulation that diagnosis and procedure codes"
^DIC(9.4,127,22,3,"PAH",74,1,9,0)="used for billing purposes must be the codes that were applicable at the"
^DIC(9.4,127,22,3,"PAH",74,1,10,0)="time service was provided. Four code sets, (ICD-9-CM, CPT, CPT modifiers,"
^DIC(9.4,127,22,3,"PAH",74,1,11,0)="DRG) for this project were modified as required under HIPAA legislation to"
^DIC(9.4,127,22,3,"PAH",74,1,12,0)="be date-sensitive under the first phase of the project."
^DIC(9.4,127,22,3,"PAH",74,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",74,1,14,0)="At the time that CSV was developed, a request was made to defer"
^DIC(9.4,127,22,3,"PAH",74,1,15,0)="applicable text versioning to the next iteration. This deferment of the"
^DIC(9.4,127,22,3,"PAH",74,1,16,0)="short and long-text versions from the CSV project makes up the scope of"
^DIC(9.4,127,22,3,"PAH",74,1,17,0)="this Code Text Descriptor (CTD) project. This follow-up project, CTD,"
^DIC(9.4,127,22,3,"PAH",74,1,18,0)="intends to add the functionality of date-sensitive versioning"
^DIC(9.4,127,22,3,"PAH",74,1,19,0)="for all applicable code text descriptors for the four code sets, effective"
^DIC(9.4,127,22,3,"PAH",74,1,20,0)="with all textual changes occurring since October 1, 2002."
^DIC(9.4,127,22,3,"PAH",74,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",74,1,22,0)="This patch addresses the changes done within the Surgery V. 3.0 software"
^DIC(9.4,127,22,3,"PAH",74,1,23,0)="in compliance with the CTD project."
^DIC(9.4,127,22,3,"PAH",74,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",74,1,25,0)="The only noticeable difference users may see will occur when a specific"
^DIC(9.4,127,22,3,"PAH",74,1,26,0)="CPT, CPT modifier or ICD9 code descriptor changes base on the date of"
^DIC(9.4,127,22,3,"PAH",74,1,27,0)="operation for the case."
^DIC(9.4,127,22,3,"PAH",75,0)="130 SEQ #128^3041015^1"
^DIC(9.4,127,22,3,"PAH",75,1,0)="^^2^2^3041015"
^DIC(9.4,127,22,3,"PAH",75,1,1,0)="THIS PATCH WILL ALLOW SURGERY USERS TO ENTER MORE THEN 15 LINE ITEMS FOR"
^DIC(9.4,127,22,3,"PAH",75,1,2,0)="ALL MULTIPLE FIELDS."
^DIC(9.4,127,22,3,"PAH",76,0)="136 SEQ #129^3041111^1"
^DIC(9.4,127,22,3,"PAH",76,1,0)="^^3^3^3041111"
^DIC(9.4,127,22,3,"PAH",76,1,1,0)="This patch prevents the infinite loop condition described in NOIS "
^DIC(9.4,127,22,3,"PAH",76,1,2,0)="ISW-0904-20140 when the Imaging software attempts to display an Operation"
^DIC(9.4,127,22,3,"PAH",76,1,3,0)="Report that is not complete."
^DIC(9.4,127,22,3,"PAH",77,0)="138 SEQ #130^3041111^1"
^DIC(9.4,127,22,3,"PAH",77,1,0)="^^3^3^3041111"
^DIC(9.4,127,22,3,"PAH",77,1,1,0)="This patch corrects the problem reported in NOIS WRJ-1004-10891 in which "
^DIC(9.4,127,22,3,"PAH",77,1,2,0)="ORGAN/SPACE SSI occurrence categories were not appearing on the "
^DIC(9.4,127,22,3,"PAH",77,1,3,0)="non-cardiac assessment printout."
^DIC(9.4,127,22,3,"PAH",78,0)="131 SEQ #132^3041228^1"
^DIC(9.4,127,22,3,"PAH",78,1,0)="^^3^3^3041228"
^DIC(9.4,127,22,3,"PAH",78,1,1,0)="This patch will clean up old variables after the call to EN^DIQ1."
^DIC(9.4,127,22,3,"PAH",78,1,2,0)="It will also replace the Anesthesia Agent Dose that was removed during "
^DIC(9.4,127,22,3,"PAH",78,1,3,0)="the install of SR*3*100."
^DIC(9.4,127,22,3,"PAH",79,0)="134 SEQ #133^3041228^1"
^DIC(9.4,127,22,3,"PAH",79,1,0)="^^86^86^3041228"
^DIC(9.4,127,22,3,"PAH",79,1,1,0)="1. LOCKING OF SURGICAL CASES FOR EDITING"
^DIC(9.4,127,22,3,"PAH",79,1,2,0)="   Patch SR*3*100 introduced locking of a surgical case when a user opens"
^DIC(9.4,127,22,3,"PAH",79,1,3,0)="   the case for editing, allowing only one user at a time to edit the same"
^DIC(9.4,127,22,3,"PAH",79,1,4,0)="   case. This patch alters how surgical cases are locked and allows"
^DIC(9.4,127,22,3,"PAH",79,1,5,0)="   multiple users to open the same case for editing up until the time that"
^DIC(9.4,127,22,3,"PAH",79,1,6,0)="   either the Nurse Intraoperative Report or the Anesthesia Report is"
^DIC(9.4,127,22,3,"PAH",79,1,7,0)="   signed. When a user enters the function to sign either report and after"
^DIC(9.4,127,22,3,"PAH",79,1,8,0)="   either report is signed, the software will again allow only one user at"
^DIC(9.4,127,22,3,"PAH",79,1,9,0)="   a time to open the case for editing. Neither report for a case can be"
^DIC(9.4,127,22,3,"PAH",79,1,10,0)="   signed while the case or a concurrent case is open for editing. If a"
^DIC(9.4,127,22,3,"PAH",79,1,11,0)="   case is locked and another user attempts to open the same case for"
^DIC(9.4,127,22,3,"PAH",79,1,12,0)="   editing, a message will appear on the screen indicating the name of the"
^DIC(9.4,127,22,3,"PAH",79,1,13,0)="   user that has the case locked. Likewise, if a user attempts to sign "
^DIC(9.4,127,22,3,"PAH",79,1,14,0)="   the Nurse Intraoperative Report or the Anesthesia Report while the "
^DIC(9.4,127,22,3,"PAH",79,1,15,0)="   case is open for editing, a message will appear on the screen "
^DIC(9.4,127,22,3,"PAH",79,1,16,0)="   indicating the name of the user that has the case open for editing."
^DIC(9.4,127,22,3,"PAH",79,1,17,0)="   "
^DIC(9.4,127,22,3,"PAH",79,1,18,0)="2. ALLOW CHART PRINT OUTSIDE MAS"
^DIC(9.4,127,22,3,"PAH",79,1,19,0)="   This patch modifies the software responsible for printing"
^DIC(9.4,127,22,3,"PAH",79,1,20,0)="   electronically signed surgery reports to honor the ALLOW CHART PRINT"
^DIC(9.4,127,22,3,"PAH",79,1,21,0)="   OUTSIDE MAS parameter defined in the TIU DOCUMENT PARAMETERS file"
^DIC(9.4,127,22,3,"PAH",79,1,22,0)="   (#8925.95). If this parameter is set to YES or is null, users will be"
^DIC(9.4,127,22,3,"PAH",79,1,23,0)="   allowed to choose between printing a work copy or a chart copy. If this"
^DIC(9.4,127,22,3,"PAH",79,1,24,0)="   parameter is set to NO, only users in MAS will be allowed to print a"
^DIC(9.4,127,22,3,"PAH",79,1,25,0)="   chart copy and all other users will be allowed to print a work copy"
^DIC(9.4,127,22,3,"PAH",79,1,26,0)="   only."
^DIC(9.4,127,22,3,"PAH",79,1,27,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,28,0)="3. QUARTERLY REPORT ARRAY CLEANUP"
^DIC(9.4,127,22,3,"PAH",79,1,29,0)="   This patch updates the software that generates the Surgery Quarterly "
^DIC(9.4,127,22,3,"PAH",79,1,30,0)="   Report to kill a variable array that may cause problems when the"
^DIC(9.4,127,22,3,"PAH",79,1,31,0)="   Surgery Quarterly Report is transmitted from multidivisional"
^DIC(9.4,127,22,3,"PAH",79,1,32,0)="   facilities."
^DIC(9.4,127,22,3,"PAH",79,1,33,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,34,0)="4. DATE/TIME OUTPUT TRANSFORM CORRECTION"
^DIC(9.4,127,22,3,"PAH",79,1,35,0)="   This patch corrects the output transform used to display the external "
^DIC(9.4,127,22,3,"PAH",79,1,36,0)="   format of several date/time fields modified by patch SR*3*125. Also, an"
^DIC(9.4,127,22,3,"PAH",79,1,37,0)="   update is made to the way admission, transfer and discharge date/times "
^DIC(9.4,127,22,3,"PAH",79,1,38,0)="   are retrieved and stored for Surgery Risk Assessment."
^DIC(9.4,127,22,3,"PAH",79,1,39,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,40,0)="5. DOCUMENTATION ERROR CORRECTION"
^DIC(9.4,127,22,3,"PAH",79,1,41,0)="   The patch SR*3*100 documentation problem described in NOIS"
^DIC(9.4,127,22,3,"PAH",79,1,42,0)="   PUG-0604-51225 is corrected in documentation distributed with this"
^DIC(9.4,127,22,3,"PAH",79,1,43,0)="   patch."
^DIC(9.4,127,22,3,"PAH",79,1,44,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,45,0)="6. FIELD DESCRIPTION UPDATE"
^DIC(9.4,127,22,3,"PAH",79,1,46,0)="   In the SURGERY file (#130), the CONGESTIVE HEART FAILURE field (#207) "
^DIC(9.4,127,22,3,"PAH",79,1,47,0)="   field description is updated with the 2004 definition."
^DIC(9.4,127,22,3,"PAH",79,1,48,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,49,0)="7. PATIENT NAME/ID ON CARDIAC ASSESSMENT PRINTOUT"
^DIC(9.4,127,22,3,"PAH",79,1,50,0)="   This patch corrects a problem with the cardiac assessment printout in "
^DIC(9.4,127,22,3,"PAH",79,1,51,0)="   which the patient ID is truncated if the patient's name is more than "
^DIC(9.4,127,22,3,"PAH",79,1,52,0)="   16 characters in length."
^DIC(9.4,127,22,3,"PAH",79,1,53,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,54,0)="8. NOIS SHR-0904-71756"
^DIC(9.4,127,22,3,"PAH",79,1,55,0)="   This patch corrects the problem described in NOIS SHR-0904-71756 so"
^DIC(9.4,127,22,3,"PAH",79,1,56,0)="   that the printer is closed after printing the assessment upon"
^DIC(9.4,127,22,3,"PAH",79,1,57,0)="   assessment completion."
^DIC(9.4,127,22,3,"PAH",79,1,58,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,59,0)="9. CARDIAC TRANSMISSION UPDATE"
^DIC(9.4,127,22,3,"PAH",79,1,60,0)="   The cardiac assessment transmission is modified by this patch to "
^DIC(9.4,127,22,3,"PAH",79,1,61,0)="   update the formatting of the date of death, if present."
^DIC(9.4,127,22,3,"PAH",79,1,62,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,63,0)="10. NOIS SBY-0904-31547"
^DIC(9.4,127,22,3,"PAH",79,1,64,0)="   Application of this patch prevents the problem described in NOIS"
^DIC(9.4,127,22,3,"PAH",79,1,65,0)="   SBY-0904-31547."
^DIC(9.4,127,22,3,"PAH",79,1,66,0)=" "
^DIC(9.4,127,22,3,"PAH",79,1,67,0)="11. ATTENDING REQUIRED BEFORE COMPLETING CASE"
^DIC(9.4,127,22,3,"PAH",79,1,68,0)="   To prevent possible cosigner problems with the Operation Report and "
^DIC(9.4,127,22,3,"PAH",79,1,69,0)="   the Procedure Report (Non-OR), this patch will require the attending "
^DIC(9.4,127,22,3,"PAH",79,1,70,0)="   surgeon/provider to be entered before the case can be completed. "
^DIC(9.4,127,22,3,"PAH",79,1,71,0)="   "
^DIC(9.4,127,22,3,"PAH",79,1,72,0)="   When a user enters the TIME PAT OUT OR field (#.232) in the SURGERY "
^DIC(9.4,127,22,3,"PAH",79,1,73,0)="   file (#130), to complete a surgical case, if the ATTEND SURGEON field "
^DIC(9.4,127,22,3,"PAH",79,1,74,0)="   (#.164) is blank, the software will prompt the user to enter the "
^DIC(9.4,127,22,3,"PAH",79,1,75,0)="   attending surgeon. For non-OR procedures, when a user enters the TIME "
^DIC(9.4,127,22,3,"PAH",79,1,76,0)="   PROCEDURE ENDED field (#122), if the ATTEND PROVIDER field (#124) is "
^DIC(9.4,127,22,3,"PAH",79,1,77,0)="   blank, the software will prompt the user to enter the attending "
^DIC(9.4,127,22,3,"PAH",79,1,78,0)="   provider."
^DIC(9.4,127,22,3,"PAH",79,1,79,0)="   "
^DIC(9.4,127,22,3,"PAH",79,1,80,0)="   If the SURGICAL RESIDENTS (Y/N) field (#33) in the SURGERY SITE "
^DIC(9.4,127,22,3,"PAH",79,1,81,0)="   PARAMETERS file (#133) is set to NO, when a surgeon is entered in the "
^DIC(9.4,127,22,3,"PAH",79,1,82,0)="   SURGEON field (#.14) in the SURGERY file (#130), the software will "
^DIC(9.4,127,22,3,"PAH",79,1,83,0)="   enter the surgeon in the ATTEND SURGEON field (#.164). For non-OR "
^DIC(9.4,127,22,3,"PAH",79,1,84,0)="   procedures, when the provider is entered in the PROVIDER field (#123), "
^DIC(9.4,127,22,3,"PAH",79,1,85,0)="   the software will enter the provider in the ATTEND PROVIDER field "
^DIC(9.4,127,22,3,"PAH",79,1,86,0)="   (#124)."
^DIC(9.4,127,22,3,"PAH",80,0)="137 SEQ #131^3041228^1"
^DIC(9.4,127,22,3,"PAH",80,1,0)="^^1^1^3041228"
^DIC(9.4,127,22,3,"PAH",80,1,1,0)="Variables not printing correctly in Risk Assessment report"
^DIC(9.4,127,22,3,"PAH",81,0)="141 SEQ #134^3050204^1"
^DIC(9.4,127,22,3,"PAH",81,1,0)="^^14^14^3050204"
^DIC(9.4,127,22,3,"PAH",81,1,1,0)="1. This patch fixes the problem reported in NOIS BAY-0105-30051. The "
^DIC(9.4,127,22,3,"PAH",81,1,2,0)="   problem was introduced by patch SR*3*134."
^DIC(9.4,127,22,3,"PAH",81,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",81,1,4,0)="2. This patch fixes the problem reported in NOIS CLA-0105-20215. This "
^DIC(9.4,127,22,3,"PAH",81,1,5,0)="   problem occurs only at facilities with multiple divisions defined in"
^DIC(9.4,127,22,3,"PAH",81,1,6,0)="   the SURGERY SITE PARAMETERS file (#133) with all but one division "
^DIC(9.4,127,22,3,"PAH",81,1,7,0)="   flagged as inactive."
^DIC(9.4,127,22,3,"PAH",81,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",81,1,9,0)="3. When using the option Preoperative Information (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",81,1,10,0)="   PREOP DATA] on the menu Non-Cardiac Assessment Information "
^DIC(9.4,127,22,3,"PAH",81,1,11,0)="   (Enter/Edit) [SROA ENTER/EDIT] on the menu Surgery Risk Assessment "
^DIC(9.4,127,22,3,"PAH",81,1,12,0)="   Menu [SROA RISK ASSESSMENT] to edit items under GENERAL on page 1, "
^DIC(9.4,127,22,3,"PAH",81,1,13,0)="   entering a caret (^) to exit at one of the sub-item prompts does "
^DIC(9.4,127,22,3,"PAH",81,1,14,0)="   not work correctly. This patch corrects this problem."
^DIC(9.4,127,22,3,"PAH",82,0)="140 SEQ #135^3050401^1"
^DIC(9.4,127,22,3,"PAH",82,1,0)="^^1^1^3050401"
^DIC(9.4,127,22,3,"PAH",82,1,1,0)="This patch enables the user to delete surgery images."
^DIC(9.4,127,22,3,"PAH",83,0)="143 SEQ #136^3050426^1"
^DIC(9.4,127,22,3,"PAH",83,1,0)="^^20^20^3050426"
^DIC(9.4,127,22,3,"PAH",83,1,1,0)="1. In support of the Surgical Infection Project (SIP), this patch "
^DIC(9.4,127,22,3,"PAH",83,1,2,0)="   modifies the Nurse Intraoperative Report [SRONRPT] option to display"
^DIC(9.4,127,22,3,"PAH",83,1,3,0)="   and to allow editing of the following additional information related"
^DIC(9.4,127,22,3,"PAH",83,1,4,0)="   to medications:"
^DIC(9.4,127,22,3,"PAH",83,1,5,0)="     Time Administered"
^DIC(9.4,127,22,3,"PAH",83,1,6,0)="     Route"
^DIC(9.4,127,22,3,"PAH",83,1,7,0)="     Dosage"
^DIC(9.4,127,22,3,"PAH",83,1,8,0)="     Ordered By"
^DIC(9.4,127,22,3,"PAH",83,1,9,0)="     Administered By"
^DIC(9.4,127,22,3,"PAH",83,1,10,0)="     Medication Comments"
^DIC(9.4,127,22,3,"PAH",83,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",83,1,12,0)="2. The Morbidity & Mortality Reports [SROMM] option and the M&M "
^DIC(9.4,127,22,3,"PAH",83,1,13,0)="   Verification Report [SRO M&M VERIFICATION REPORT] option are "
^DIC(9.4,127,22,3,"PAH",83,1,14,0)="   modified to display the sepsis category for SYSTEMIC SEPSIS"
^DIC(9.4,127,22,3,"PAH",83,1,15,0)="   occurrences."
^DIC(9.4,127,22,3,"PAH",83,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",83,1,17,0)="3. This patch modifies the DYSPNEA field (#325) in the SURGERY file "
^DIC(9.4,127,22,3,"PAH",83,1,18,0)="   (#130) changing MINIMAL EXERTION in the set of choices to MODERATE "
^DIC(9.4,127,22,3,"PAH",83,1,19,0)="   EXERTION. This change makes the set of codes agree with the field "
^DIC(9.4,127,22,3,"PAH",83,1,20,0)="   description."
^DIC(9.4,127,22,3,"PAH",84,0)="119^3050905^1"
^DIC(9.4,127,22,3,"PAH",84,1,0)="^^1^1^3050905"
^DIC(9.4,127,22,3,"PAH",84,1,1,0)="CLINICAL INDICATOR DATA CAPTURE - SURGERY"
^DIC(9.4,127,22,3,"PAH",85,0)="145 SEQ #138^3051202^1"
^DIC(9.4,127,22,3,"PAH",85,1,0)="^^3^3^3051202"
^DIC(9.4,127,22,3,"PAH",85,1,1,0)="In Remedy HD 94190, when using the Patient Demographics (Enter/Edit) [SROA"
^DIC(9.4,127,22,3,"PAH",85,1,2,0)="DEMOGRAPHICS] option, an undefined error occurs if the length of the race"
^DIC(9.4,127,22,3,"PAH",85,1,3,0)="data is found to be more than 72 characters."
^DIC(9.4,127,22,3,"PAH",86,0)="147 SEQ #139^3051202^1"
^DIC(9.4,127,22,3,"PAH",86,1,0)="^^13^13^3051202"
^DIC(9.4,127,22,3,"PAH",86,1,1,0)="1. For CPRS-R (ReHosting), a cache of patient data will be maintained for"
^DIC(9.4,127,22,3,"PAH",86,1,2,0)="   the duration of his/her inpatient stay (or outpatient visit) for ease"
^DIC(9.4,127,22,3,"PAH",86,1,3,0)="   of searching and sorting within the new Java client; rather than making"
^DIC(9.4,127,22,3,"PAH",86,1,4,0)="   frequent calls back to each application's database. To this end, this"
^DIC(9.4,127,22,3,"PAH",86,1,5,0)="   patch contains modifications that will allow the Surgery software to"
^DIC(9.4,127,22,3,"PAH",86,1,6,0)="   update the CPRS-R (ReHosting) cache of patient data when a case is"
^DIC(9.4,127,22,3,"PAH",86,1,7,0)="   created or edited."
^DIC(9.4,127,22,3,"PAH",86,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",86,1,9,0)="2. This patch updates the data dictionary of the PREOP SHAVE BY field"
^DIC(9.4,127,22,3,"PAH",86,1,10,0)="   (#.12) in the SURGERY file (#130). The field is renamed ""PREOP HAIR"
^DIC(9.4,127,22,3,"PAH",86,1,11,0)="   CLIPPING BY"" and the title and description of this field are updated."
^DIC(9.4,127,22,3,"PAH",86,1,12,0)="   The field titles on the Nurse Intraoperative Report are changed as"
^DIC(9.4,127,22,3,"PAH",86,1,13,0)="   well."
^DIC(9.4,127,22,3,"PAH",87,0)="149 SEQ #140^3051221^1"
^DIC(9.4,127,22,3,"PAH",87,1,0)="^^2^2^3051221"
^DIC(9.4,127,22,3,"PAH",87,1,1,0)="THIS PATCH WILL INSERT ""N SRX"" TO THE BEGINNING OF SEVERAL SURGERY"
^DIC(9.4,127,22,3,"PAH",87,1,2,0)="FILE (#130) INPUT TRANSFORMS."
^DIC(9.4,127,22,3,"PAH",88,0)="150 SEQ #141^3060112^1"
^DIC(9.4,127,22,3,"PAH",88,1,0)="^^1^1^3060112"
^DIC(9.4,127,22,3,"PAH",88,1,1,0)="THIS PATCH CORRECTS FOUR ISSUES RELATED TO CIDC."
^DIC(9.4,127,22,3,"PAH",89,0)="148 SEQ #142^3060112^1"
^DIC(9.4,127,22,3,"PAH",89,1,0)="^^4^4^3060112"
^DIC(9.4,127,22,3,"PAH",89,1,1,0)="This patch modifies the Blood Product Verification [SR BLOOD PRODUCT "
^DIC(9.4,127,22,3,"PAH",89,1,2,0)="VERIFICATION] option to reference the VistA Blood Establishment Computer "
^DIC(9.4,127,22,3,"PAH",89,1,3,0)="Software (VBECS) if installed. This change allows the option to maintain "
^DIC(9.4,127,22,3,"PAH",89,1,4,0)="its current functionality before and after VBECS is installed."
^DIC(9.4,127,22,3,"PAH",90,0)="151 SEQ #143^3060308^1"
^DIC(9.4,127,22,3,"PAH",90,1,0)="^^10^10^3060308"
^DIC(9.4,127,22,3,"PAH",90,1,1,0)="As existing pharmacy software modules are being re-engineered through"
^DIC(9.4,127,22,3,"PAH",90,1,2,0)="new development and the purchase of commercial off-the-shelf products"
^DIC(9.4,127,22,3,"PAH",90,1,3,0)="(COTS). Transition to the new Pharmacy Re-Engineered system eliminates the"
^DIC(9.4,127,22,3,"PAH",90,1,4,0)="VistA Pharmacy files currently referenced. Therefore, all Surgery existing"
^DIC(9.4,127,22,3,"PAH",90,1,5,0)="references (direct global reads/writes, VA FileMan reads/writes) to all"
^DIC(9.4,127,22,3,"PAH",90,1,6,0)="pharmacy application files must be replaced with Application Programmer"
^DIC(9.4,127,22,3,"PAH",90,1,7,0)="Interfaces (APIs)."
^DIC(9.4,127,22,3,"PAH",90,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",90,1,9,0)="This enhancement does not entail any user functionality change, only a"
^DIC(9.4,127,22,3,"PAH",90,1,10,0)="'behind-the-scenes' process to enable exchange of medication data."
^DIC(9.4,127,22,3,"PAH",91,0)="155 SEQ #144^3060410^1"
^DIC(9.4,127,22,3,"PAH",91,1,0)="^^3^3^3060410"
^DIC(9.4,127,22,3,"PAH",91,1,1,0)="This patch is a follow up patch for SR*3*151. It fixes the undefined"
^DIC(9.4,127,22,3,"PAH",91,1,2,0)="error reported by Dublin when using the Anesthesia Provider Report"
^DIC(9.4,127,22,3,"PAH",91,1,3,0)="[SROADOC] option."
^DIC(9.4,127,22,3,"PAH",92,0)="142 SEQ #145^3060504^1"
^DIC(9.4,127,22,3,"PAH",92,1,0)="^^169^169^3060504"
^DIC(9.4,127,22,3,"PAH",92,1,1,0)="This patch is part of the Patient Financial Services System (PFSS) project."
^DIC(9.4,127,22,3,"PAH",92,1,2,0)="PFSS patches are being released on various schedules. Some patch"
^DIC(9.4,127,22,3,"PAH",92,1,3,0)="functionality will not be active until a new PFSS switch is activated"
^DIC(9.4,127,22,3,"PAH",92,1,4,0)="during final implementation. PFSS will initially be implemented at select"
^DIC(9.4,127,22,3,"PAH",92,1,5,0)="pilot sites ONLY."
^DIC(9.4,127,22,3,"PAH",92,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,7,0)="The purpose of the PFSS project is to prepare the Veterans Health "
^DIC(9.4,127,22,3,"PAH",92,1,8,0)="Information Systems and Technology Architecture (VistA) environment for the"
^DIC(9.4,127,22,3,"PAH",92,1,9,0)="implementation of a commercial off-the-shelf (COTS) billing replacement"
^DIC(9.4,127,22,3,"PAH",92,1,10,0)="system. The project consists of the implementation of the billing"
^DIC(9.4,127,22,3,"PAH",92,1,11,0)="replacement system, business process improvements, and enhancements to"
^DIC(9.4,127,22,3,"PAH",92,1,12,0)="VistA to support integration with the COTS billing replacement system."
^DIC(9.4,127,22,3,"PAH",92,1,13,0)="Significant changes to VistA legacy systems and ancillary packages are"
^DIC(9.4,127,22,3,"PAH",92,1,14,0)="necessary."
^DIC(9.4,127,22,3,"PAH",92,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,16,0)="Some of the PFSS software components are not operational until the PFSS "
^DIC(9.4,127,22,3,"PAH",92,1,17,0)="On/Off Switch, distributed with patch IB*2*260, is set to ""ON"". The ability"
^DIC(9.4,127,22,3,"PAH",92,1,18,0)="for the local site to set the switch to ""ON"" will be provided at the"
^DIC(9.4,127,22,3,"PAH",92,1,19,0)="appropriate time with the release of a subsequent Integrated Billing patch."
^DIC(9.4,127,22,3,"PAH",92,1,20,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,21,0)="For more information about the PFSS project, review the documentation "
^DIC(9.4,127,22,3,"PAH",92,1,22,0)="accompanying this patch and refer to the following website: "
^DIC(9.4,127,22,3,"PAH",92,1,23,0)="http://vista.domain.ext/billreplace/"
^DIC(9.4,127,22,3,"PAH",92,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,25,0)="Features of patch SR*3*142 are listed below:"
^DIC(9.4,127,22,3,"PAH",92,1,26,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,27,0)="1. Modified Surgery Coding Option"
^DIC(9.4,127,22,3,"PAH",92,1,28,0)="   Coders currently use the Update/Verify Procedure/Diagnosis Codes "
^DIC(9.4,127,22,3,"PAH",92,1,29,0)="   [SRCODING EDIT] option, which updates coded data directly in the "
^DIC(9.4,127,22,3,"PAH",92,1,30,0)="   SURGERY file (#130). However, the SURGERY file (#130) does not"
^DIC(9.4,127,22,3,"PAH",92,1,31,0)="   currently make a distinction between procedure and diagnosis data"
^DIC(9.4,127,22,3,"PAH",92,1,32,0)="   entered by clinicians and that entered by coders. Today, coding a"
^DIC(9.4,127,22,3,"PAH",92,1,33,0)="   surgical case impacts the clinical data for the patient and causes an"
^DIC(9.4,127,22,3,"PAH",92,1,34,0)="   addendum to be generated because each code is directly associated with"
^DIC(9.4,127,22,3,"PAH",92,1,35,0)="   a free-text procedure or diagnosis entry. This patch separates final"
^DIC(9.4,127,22,3,"PAH",92,1,36,0)="   coded procedures and diagnoses from the clinically captured procedures"
^DIC(9.4,127,22,3,"PAH",92,1,37,0)="   and diagnoses."
^DIC(9.4,127,22,3,"PAH",92,1,38,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,39,0)="   A new file, the SURGERY PROCEDURE/DIAGNOSIS CODES file (#136), is"
^DIC(9.4,127,22,3,"PAH",92,1,40,0)="   created to store coded procedure and coded diagnosis data for a Surgery"
^DIC(9.4,127,22,3,"PAH",92,1,41,0)="   case. Data entered into this file will be the new source coding data"
^DIC(9.4,127,22,3,"PAH",92,1,42,0)="   sent by the Surgery package to PCE. In the SURGERY file (#130), the"
^DIC(9.4,127,22,3,"PAH",92,1,43,0)="   existing PRINCIPAL CPT Code field (#27), PRIN DIAGNOSIS CODE field "
^DIC(9.4,127,22,3,"PAH",92,1,44,0)="   (#66), OTHER PROCEDURE CPT CODE field (#3 of sub-file #130.16) and ICD"
^DIC(9.4,127,22,3,"PAH",92,1,45,0)="   DIAGNOSIS CODE field (#3 of sub-file #130.18) are modified to include"
^DIC(9.4,127,22,3,"PAH",92,1,46,0)="   the word ""PLANNED"" in the field labels and titles."
^DIC(9.4,127,22,3,"PAH",92,1,47,0)="   "
^DIC(9.4,127,22,3,"PAH",92,1,48,0)="   The Update/Verify Procedure/Diagnosis Codes [SRCODING EDIT] option is "
^DIC(9.4,127,22,3,"PAH",92,1,49,0)="   modified to allow entry of final billing Current Procedural "
^DIC(9.4,127,22,3,"PAH",92,1,50,0)="   Terminology (CPT) codes for surgical procedures and International"
^DIC(9.4,127,22,3,"PAH",92,1,51,0)="   Classification of Disease (ICD) diagnosis codes in the SURGERY"
^DIC(9.4,127,22,3,"PAH",92,1,52,0)="   PROCEDURE/DIAGNOSIS CODES file (#136)."
^DIC(9.4,127,22,3,"PAH",92,1,53,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,54,0)="   Modified features of the Update/Verify Procedure/Diagnosis Codes"
^DIC(9.4,127,22,3,"PAH",92,1,55,0)="   [SRCODING EDIT] option are listed below:"
^DIC(9.4,127,22,3,"PAH",92,1,56,0)="   - Upon record creation for a case in the SURGERY PROCEDURE/DIAGNOSIS"
^DIC(9.4,127,22,3,"PAH",92,1,57,0)="     CODES file (#136), the record will be auto-populated with clinician"
^DIC(9.4,127,22,3,"PAH",92,1,58,0)="     entered coding data, if any, from the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",92,1,59,0)="   - A principal ICD code and a principal CPT code are initial"
^DIC(9.4,127,22,3,"PAH",92,1,60,0)="     requirements for coding a surgical case. "
^DIC(9.4,127,22,3,"PAH",92,1,61,0)="   - An unlimited number of ICD codes may be entered for other diagnoses"
^DIC(9.4,127,22,3,"PAH",92,1,62,0)="     and an unlimited number of CPT codes may be entered for other"
^DIC(9.4,127,22,3,"PAH",92,1,63,0)="     procedures performed."
^DIC(9.4,127,22,3,"PAH",92,1,64,0)="   - Each CPT code entered must be assigned the associated ICD code(s)"
^DIC(9.4,127,22,3,"PAH",92,1,65,0)="     related to the procedure performed."
^DIC(9.4,127,22,3,"PAH",92,1,66,0)="   - An unlimited number of CPT modifiers may be entered for each CPT code"
^DIC(9.4,127,22,3,"PAH",92,1,67,0)="     entered."
^DIC(9.4,127,22,3,"PAH",92,1,68,0)="   - For every ICD code entered, the following questions must be answered"
^DIC(9.4,127,22,3,"PAH",92,1,69,0)="     as appropriate for the patient based upon enrollment indicators:"
^DIC(9.4,127,22,3,"PAH",92,1,70,0)="     o Treatment related to Service Connected condition?"
^DIC(9.4,127,22,3,"PAH",92,1,71,0)="     o Treatment related to Agent Orange Exposure?"
^DIC(9.4,127,22,3,"PAH",92,1,72,0)="     o Treatment related to Ionizing Radiation Exposure?"
^DIC(9.4,127,22,3,"PAH",92,1,73,0)="     o Treatment related to Environmental Contaminant Exposure?"
^DIC(9.4,127,22,3,"PAH",92,1,74,0)="     o Treatment related to Military Sexual Trauma?"
^DIC(9.4,127,22,3,"PAH",92,1,75,0)="     o Treatment related to Head and/or Neck Cancer?"
^DIC(9.4,127,22,3,"PAH",92,1,76,0)="     o Treatment related to Combat?"
^DIC(9.4,127,22,3,"PAH",92,1,77,0)="   - Upon completion of coding for a case, the coder is allowed to mark"
^DIC(9.4,127,22,3,"PAH",92,1,78,0)="     the record as complete and to send the record immediately to PCE."
^DIC(9.4,127,22,3,"PAH",92,1,79,0)="   - Before allowing the record to be marked as complete, the option"
^DIC(9.4,127,22,3,"PAH",92,1,80,0)="     checks to see if a specific code, 065.0 CRIMEAN HEMORRHAGIC FEV, is"
^DIC(9.4,127,22,3,"PAH",92,1,81,0)="     entered as a diagnosis code. If it is entered, the software prompts"
^DIC(9.4,127,22,3,"PAH",92,1,82,0)="     the user to make sure that the code is correct for the case. This"
^DIC(9.4,127,22,3,"PAH",92,1,83,0)="     check is added to prevent the inadvertent assignment of code 065.0"
^DIC(9.4,127,22,3,"PAH",92,1,84,0)="     when ""CHF"" is entered for the Principal or Other ICD Diagnosis"
^DIC(9.4,127,22,3,"PAH",92,1,85,0)="     codes."
^DIC(9.4,127,22,3,"PAH",92,1,86,0)="   "
^DIC(9.4,127,22,3,"PAH",92,1,87,0)="2. Modified Surgery Reports and Other Options"
^DIC(9.4,127,22,3,"PAH",92,1,88,0)="   - The following Surgery reports and options as modified to use the"
^DIC(9.4,127,22,3,"PAH",92,1,89,0)="     coder entered CPT and/or ICD codes from the SURGERY "
^DIC(9.4,127,22,3,"PAH",92,1,90,0)="     PROCEDURE/DIAGNOSIS CODES file (#136):"
^DIC(9.4,127,22,3,"PAH",92,1,91,0)="     o Cumulative Report of CPT Codes [SROACCT] option"
^DIC(9.4,127,22,3,"PAH",92,1,92,0)="     o Report of CPT Coding Accuracy [SR CPT ACCURACY] option"
^DIC(9.4,127,22,3,"PAH",92,1,93,0)="     o List Completed Cases Missing CPT Codes [SRSCPT] option"
^DIC(9.4,127,22,3,"PAH",92,1,94,0)="       Note: The option descriptions are updated to read ""The List"
^DIC(9.4,127,22,3,"PAH",92,1,95,0)="       Completed Cases Missing CPT Codes option generates a report of"
^DIC(9.4,127,22,3,"PAH",92,1,96,0)="       completed cases that are missing the Principal CPT code for a"
^DIC(9.4,127,22,3,"PAH",92,1,97,0)="       specified date range."""
^DIC(9.4,127,22,3,"PAH",92,1,98,0)="     o Annual Report of Surgical Procedures [SROARSP] option"
^DIC(9.4,127,22,3,"PAH",92,1,99,0)="     o PCE Filing Status Report [SRO PCE STATUS] option"
^DIC(9.4,127,22,3,"PAH",92,1,100,0)="     o Quarterly Report - Surgical Service [SRO QUARTERLY REPORT] option"
^DIC(9.4,127,22,3,"PAH",92,1,101,0)="     o Report of Missing Quarterly Report Data [SROQ MISSING DATA] option"
^DIC(9.4,127,22,3,"PAH",92,1,102,0)="       Note: The Other CPT Codes no longer affect this report and "
^DIC(9.4,127,22,3,"PAH",92,1,103,0)="       references to Other CPT Codes are removed. The display of ""I"" in "
^DIC(9.4,127,22,3,"PAH",92,1,104,0)="       the footer of this report is removed."
^DIC(9.4,127,22,3,"PAH",92,1,105,0)="     o Annual Report of Non-O.R. Procedures [SRONOP-ANNUAL] option"
^DIC(9.4,127,22,3,"PAH",92,1,106,0)="     o List of Invasive Diagnostic Procedures [SROQIDP] option"
^DIC(9.4,127,22,3,"PAH",92,1,107,0)="   - The following Surgery reports and options are modified to remove CPT "
^DIC(9.4,127,22,3,"PAH",92,1,108,0)="     and/or ICD codes from the display."
^DIC(9.4,127,22,3,"PAH",92,1,109,0)="     o Update Status of Returns within 30 Days [SRO UPDATE RETURNS] option"
^DIC(9.4,127,22,3,"PAH",92,1,110,0)="     o Update Operations as Unrelated/Related to Death [SRO DEATH RELATED]"
^DIC(9.4,127,22,3,"PAH",92,1,111,0)="       option"
^DIC(9.4,127,22,3,"PAH",92,1,112,0)="     o Non-OR Procedure Information [SR NON-OR INFO] option"
^DIC(9.4,127,22,3,"PAH",92,1,113,0)="     o Deaths Within 30 Days of Surgery [SROQD] option"
^DIC(9.4,127,22,3,"PAH",92,1,114,0)="     o Admissions Within 14 Days of Outpatient Surgery [SROQADM] option"
^DIC(9.4,127,22,3,"PAH",92,1,115,0)="     o List of Operations Included on Quarterly Report [SROQ LIST OPS]"
^DIC(9.4,127,22,3,"PAH",92,1,116,0)="       option"
^DIC(9.4,127,22,3,"PAH",92,1,117,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,118,0)="3. Modified Risk Assessment Options"
^DIC(9.4,127,22,3,"PAH",92,1,119,0)="   - Surgery case CPT and/or ICD codes used in the following options are "
^DIC(9.4,127,22,3,"PAH",92,1,120,0)="     displayed from the SURGERY PROCEDURE/DIAGNOSIS CODES file (#136):"
^DIC(9.4,127,22,3,"PAH",92,1,121,0)="     o Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] option"
^DIC(9.4,127,22,3,"PAH",92,1,122,0)="     o List of Surgery Risk Assessments [SROA ASSESSMENT LIST] option "
^DIC(9.4,127,22,3,"PAH",92,1,123,0)="     o Exclusion Criteria (Enter/Edit) [SR NO ASSESSMENT REASON] option"
^DIC(9.4,127,22,3,"PAH",92,1,124,0)="       Note: The new CPT code fields will not be editable from this"
^DIC(9.4,127,22,3,"PAH",92,1,125,0)="       option."
^DIC(9.4,127,22,3,"PAH",92,1,126,0)="     o Update 1-Liner Case [SROA ONE-LINER UPDATE] option"
^DIC(9.4,127,22,3,"PAH",92,1,127,0)="       Note: The new CPT code fields will not be editable from this"
^DIC(9.4,127,22,3,"PAH",92,1,128,0)="       option."
^DIC(9.4,127,22,3,"PAH",92,1,129,0)="     o Queue Assessment Transmissions [SROA TRANSMIT ASSESSMENTS] option"
^DIC(9.4,127,22,3,"PAH",92,1,130,0)="   - In the following options CPT codes are removed from the screen"
^DIC(9.4,127,22,3,"PAH",92,1,131,0)="     headings:"
^DIC(9.4,127,22,3,"PAH",92,1,132,0)="     o Preoperative Information (Enter/Edit) [SROA PREOP DATA] option "
^DIC(9.4,127,22,3,"PAH",92,1,133,0)="     o Laboratory Test Results (Enter/Edit) [SROA LAB] option"
^DIC(9.4,127,22,3,"PAH",92,1,134,0)="     o Operation Information (Enter/Edit) [SROA OPERATION DATA] option"
^DIC(9.4,127,22,3,"PAH",92,1,135,0)="       Note: The CPT code and Postoperative Diagnosis fields will not be "
^DIC(9.4,127,22,3,"PAH",92,1,136,0)="       editable from this option. "
^DIC(9.4,127,22,3,"PAH",92,1,137,0)="     o Patient Demographics (Enter/Edit) [SROA DEMOGRAPHICS] option"
^DIC(9.4,127,22,3,"PAH",92,1,138,0)="     o Intraoperative Occurrences (Enter/Edit) [SRO INTRAOP COMP] option"
^DIC(9.4,127,22,3,"PAH",92,1,139,0)="     o Postoperative Occurrences (Enter/Edit) [SRO POSTOP COMP] option"
^DIC(9.4,127,22,3,"PAH",92,1,140,0)="     o Clinical Information (Enter/Edit) [SROA CLINICAL INFORMATION]"
^DIC(9.4,127,22,3,"PAH",92,1,141,0)="       option"
^DIC(9.4,127,22,3,"PAH",92,1,142,0)="     o Laboratory Test Results (Enter/Edit) [SROA LAB-CARDIAC] option"
^DIC(9.4,127,22,3,"PAH",92,1,143,0)="     o Enter Cardiac Catheterization & Angiographic Data [SROA "
^DIC(9.4,127,22,3,"PAH",92,1,144,0)="       CATHETERIZATION] option "
^DIC(9.4,127,22,3,"PAH",92,1,145,0)="     o Operative Risk Summary Data (Enter/Edit) [SROA CARDIAC OPERATIVE "
^DIC(9.4,127,22,3,"PAH",92,1,146,0)="       RISK] option"
^DIC(9.4,127,22,3,"PAH",92,1,147,0)="       Note: The CPT code fields will not be editable from this option."
^DIC(9.4,127,22,3,"PAH",92,1,148,0)="     o Cardiac Procedures Operative Data (Enter/Edit) [SROA CARDIAC "
^DIC(9.4,127,22,3,"PAH",92,1,149,0)="       PROCEDURES] option"
^DIC(9.4,127,22,3,"PAH",92,1,150,0)="     o Outcome Information (Enter/Edit) [SROA CARDIAC-OUTCOMES] option"
^DIC(9.4,127,22,3,"PAH",92,1,151,0)="     o Resource Data [SROA CARDIAC RESOURCE] option"
^DIC(9.4,127,22,3,"PAH",92,1,152,0)="   - The Update Assessment Status to 'COMPLETE' [SROA COMPLETE ASSESSMENT]"
^DIC(9.4,127,22,3,"PAH",92,1,153,0)="     option is modified to remove the ability to edit CPT and ICD codes "
^DIC(9.4,127,22,3,"PAH",92,1,154,0)="     from this option."
^DIC(9.4,127,22,3,"PAH",92,1,155,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,156,0)="4. Functions that are currently part of the Surgery Nightly Cleanup and "
^DIC(9.4,127,22,3,"PAH",92,1,157,0)="   Updates [SRTASK-NIGHT] option are modified as follows:"
^DIC(9.4,127,22,3,"PAH",92,1,158,0)="   - Store Operation Times function uses the CPT code fields in the "
^DIC(9.4,127,22,3,"PAH",92,1,159,0)="     SURGERY PROCEDURE/DIAGNOSIS CODES file (#136)."
^DIC(9.4,127,22,3,"PAH",92,1,160,0)="   - File Surgery Data in PCE function is removed."
^DIC(9.4,127,22,3,"PAH",92,1,161,0)=" "
^DIC(9.4,127,22,3,"PAH",92,1,162,0)="5. The Surgery to PCE interface is modified to send coding data from the "
^DIC(9.4,127,22,3,"PAH",92,1,163,0)="   SURGERY PROCEDURE/DIAGNOSIS CODES file (#136). The interface now passes"
^DIC(9.4,127,22,3,"PAH",92,1,164,0)="   data to PCE in real time when the coder completes the coding process"
^DIC(9.4,127,22,3,"PAH",92,1,165,0)="   for a case. After a case is filed with PCE, if certain data passed to "
^DIC(9.4,127,22,3,"PAH",92,1,166,0)="   PCE is changed within the Surgery software, the Surgery to PCE"
^DIC(9.4,127,22,3,"PAH",92,1,167,0)="   interface sends an update to PCE immediately. ICD coding related data "
^DIC(9.4,127,22,3,"PAH",92,1,168,0)="   is updated through the Update/Verify Procedure/Diagnosis Codes"
^DIC(9.4,127,22,3,"PAH",92,1,169,0)="   [SRCODING EDIT] option."
^DIC(9.4,127,22,3,"PAH",93,0)="146 SEQ #146^3060504^1"
^DIC(9.4,127,22,3,"PAH",93,1,0)="^^49^49^3060504"
^DIC(9.4,127,22,3,"PAH",93,1,1,0)="1. At many sites the Risk Assessment Nurse Reviewers are involved with the"
^DIC(9.4,127,22,3,"PAH",93,1,2,0)="Health Information Management Systems (HIMS) staff in determining the"
^DIC(9.4,127,22,3,"PAH",93,1,3,0)="final codes for a Surgery case. An Alert Coder Option will allow the Risk"
^DIC(9.4,127,22,3,"PAH",93,1,4,0)="Assessment Nurse Reviewer to alert the coder if there is a question on the"
^DIC(9.4,127,22,3,"PAH",93,1,5,0)="Current Procedural Terminology (CPT) or International Classification of"
^DIC(9.4,127,22,3,"PAH",93,1,6,0)="Diseases (ICD) codes on a Surgery case."
^DIC(9.4,127,22,3,"PAH",93,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",93,1,8,0)=" o The new Alert Coder Regarding Coding Issues [SROA CODE ISSUE] option"
^DIC(9.4,127,22,3,"PAH",93,1,9,0)="   will appear on both the Non-Cardiac Assessment Information (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",93,1,10,0)="   [SROA ENTER/EDIT] and Cardiac Risk Assessment Information (Enter/Edit) "
^DIC(9.4,127,22,3,"PAH",93,1,11,0)="   [SROA CARDIAC ENTER/EDIT] menus."
^DIC(9.4,127,22,3,"PAH",93,1,12,0)=" o The Alert Coder Regarding Coding Issues [SROA CODE ISSUE] option will"
^DIC(9.4,127,22,3,"PAH",93,1,13,0)="   not check the PFSS On/Off switch."
^DIC(9.4,127,22,3,"PAH",93,1,14,0)=" o The Alert Coder Regarding Coding Issues [SROA CODE ISSUE] option will"
^DIC(9.4,127,22,3,"PAH",93,1,15,0)="   display basic surgery case information including Patient, Case Number,"
^DIC(9.4,127,22,3,"PAH",93,1,16,0)="   Surgery Date, and Procedure."
^DIC(9.4,127,22,3,"PAH",93,1,17,0)=" o The Alert Coder Regarding Coding Issues [SROA CODE ISSUE] option will"
^DIC(9.4,127,22,3,"PAH",93,1,18,0)="   display the following coded information:  the PRINCIPAL CPT CODE, OTHER"
^DIC(9.4,127,22,3,"PAH",93,1,19,0)="   CPT CODE, and PRINCIPAL DIAGNOSIS CODE."
^DIC(9.4,127,22,3,"PAH",93,1,20,0)=" o The Alert Coder Regarding Coding Issues [SROA CODE ISSUE] option will"
^DIC(9.4,127,22,3,"PAH",93,1,21,0)="   allow the Reviewer to enter a free text comment field to send coding"
^DIC(9.4,127,22,3,"PAH",93,1,22,0)="   concerns to the coder, as well as to members of a predefined mail group"
^DIC(9.4,127,22,3,"PAH",93,1,23,0)="   identified in the CODE ISSUE MAIL GROUP parameter."
^DIC(9.4,127,22,3,"PAH",93,1,24,0)=" o Values for the CODING COMPLETED BY field (#.01) of the CODING "
^DIC(9.4,127,22,3,"PAH",93,1,25,0)="   COMPLETED BY multiple (#136.011) of the SURGERY PROCEDURE/DIAGNOSIS"
^DIC(9.4,127,22,3,"PAH",93,1,26,0)="   CODES file (#136) or the CODE ISSUE MAIL GROUP will be present when the"
^DIC(9.4,127,22,3,"PAH",93,1,27,0)="   user selects the Alert Coder Regarding Coding Issues [SROA CODE ISSUE]"
^DIC(9.4,127,22,3,"PAH",93,1,28,0)="   option. If neither are valued, the user will be notified that the"
^DIC(9.4,127,22,3,"PAH",93,1,29,0)="   message cannot be sent without one of these two items defined."
^DIC(9.4,127,22,3,"PAH",93,1,30,0)=" o The CODE ISSUE MAIL GROUP field (#43) is added in the SURGERY SITE"
^DIC(9.4,127,22,3,"PAH",93,1,31,0)="   PARAMETERS file (#133) to allow the site to create a designated mail"
^DIC(9.4,127,22,3,"PAH",93,1,32,0)="   group for the Alert Coder Regarding Coding Issues [SROA CODE ISSUE]"
^DIC(9.4,127,22,3,"PAH",93,1,33,0)="   option."
^DIC(9.4,127,22,3,"PAH",93,1,34,0)=" o The Surgery Site Parameters (Enter/Edit) [SROPARAM] option within"
^DIC(9.4,127,22,3,"PAH",93,1,35,0)="   the Surgery Package Management Menu [SRO PACKAGE MANAGEMENT] option is "
^DIC(9.4,127,22,3,"PAH",93,1,36,0)="   modified to allow entry and editing of the new CODE ISSUE MAIL GROUP."
^DIC(9.4,127,22,3,"PAH",93,1,37,0)=" "
^DIC(9.4,127,22,3,"PAH",93,1,38,0)="2. When creating a request from a waiting list entry, the Surgery screen "
^DIC(9.4,127,22,3,"PAH",93,1,39,0)="server incorrectly displays ""SCHEDULING"" in the screen header. This patch "
^DIC(9.4,127,22,3,"PAH",93,1,40,0)="makes a modification to display ""REQUEST"" instead."
^DIC(9.4,127,22,3,"PAH",93,1,41,0)=" "
^DIC(9.4,127,22,3,"PAH",93,1,42,0)="3. This patch corrects problems with the two trigger cross references that"
^DIC(9.4,127,22,3,"PAH",93,1,43,0)="were added to the SITE field (#.01) of the SURGERY SITE PARAMETERS file"
^DIC(9.4,127,22,3,"PAH",93,1,44,0)="(#133) by patch SR*3*150."
^DIC(9.4,127,22,3,"PAH",93,1,45,0)=" "
^DIC(9.4,127,22,3,"PAH",93,1,46,0)="Note: This patch includes a post-installation process that updates each"
^DIC(9.4,127,22,3,"PAH",93,1,47,0)="entry in the SURGERY SITE PARAMETERS file (#133) as follows:"
^DIC(9.4,127,22,3,"PAH",93,1,48,0)=" - UPDATES TO PCE field (#18) is set to ALL CASES."
^DIC(9.4,127,22,3,"PAH",93,1,49,0)=" - ASK CLASSIFICATION QUESTIONS field (#19) is set to YES.  "
^DIC(9.4,127,22,3,"PAH",94,0)="152 SEQ #147^3060608^1"
^DIC(9.4,127,22,3,"PAH",94,1,0)="^^19^19^3060608"
^DIC(9.4,127,22,3,"PAH",94,1,1,0)="Project 112/SHAD (Shipboard Hazard and Defense) is a new environmental "
^DIC(9.4,127,22,3,"PAH",94,1,2,0)="indicator added to VistA as part of the Enrollment System Redesign (ESR) "
^DIC(9.4,127,22,3,"PAH",94,1,3,0)="project."
^DIC(9.4,127,22,3,"PAH",94,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",94,1,5,0)="1. This patch provides the ability to enter and edit Project 112/SHAD"
^DIC(9.4,127,22,3,"PAH",94,1,6,0)="   Environmental Indicator information in the Surgery package. The "
^DIC(9.4,127,22,3,"PAH",94,1,7,0)="   patient's Project 112/SHAD enrollment status is displayed when creating"
^DIC(9.4,127,22,3,"PAH",94,1,8,0)="   or editing a surgical case, and the user will be prompted to answer the"
^DIC(9.4,127,22,3,"PAH",94,1,9,0)="   Project 112/SHAD questions with ""yes"" or ""no""."
^DIC(9.4,127,22,3,"PAH",94,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",94,1,11,0)="   The Project 112/SHAD information will be forwarded to Patient Care "
^DIC(9.4,127,22,3,"PAH",94,1,12,0)="   Encounter (PCE) as part of the normal case coding activities."
^DIC(9.4,127,22,3,"PAH",94,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",94,1,14,0)="2. This patch will prevent the PRIN PRE-OP ICD DIAGNOSIS CODE field"
^DIC(9.4,127,22,3,"PAH",94,1,15,0)="   (#32.5) of the SURGERY file (#130) from being sent to PCE."
^DIC(9.4,127,22,3,"PAH",94,1,16,0)="   "
^DIC(9.4,127,22,3,"PAH",94,1,17,0)="3. This patch adds the Alert Coder Regarding Coding Issues [SROA CODE "
^DIC(9.4,127,22,3,"PAH",94,1,18,0)="   ISSUE] option to the Surgery Risk Assessment Menu [SROA RISK "
^DIC(9.4,127,22,3,"PAH",94,1,19,0)="   ASSESSMENT] option."
^DIC(9.4,127,22,3,"PAH",95,0)="144 SEQ #148^3060614^1"
^DIC(9.4,127,22,3,"PAH",95,1,0)="^^48^48^3060614"
^DIC(9.4,127,22,3,"PAH",95,1,1,0)="This patch is part of the Patient Financial Services System (PFSS) "
^DIC(9.4,127,22,3,"PAH",95,1,2,0)="project. PFSS patches are being released on various schedules. Some patch"
^DIC(9.4,127,22,3,"PAH",95,1,3,0)="functionality will not be active until a new PFSS switch is activated"
^DIC(9.4,127,22,3,"PAH",95,1,4,0)="during final implementation. PFSS will initially be implemented at select"
^DIC(9.4,127,22,3,"PAH",95,1,5,0)="pilot sites ONLY."
^DIC(9.4,127,22,3,"PAH",95,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,7,0)="The purpose of the PFSS project is to prepare the Veterans Health "
^DIC(9.4,127,22,3,"PAH",95,1,8,0)="Information Systems and Technology Architecture (VistA) environment for "
^DIC(9.4,127,22,3,"PAH",95,1,9,0)="the implementation of a Commercial Off-The-Shelf (COTS) billing "
^DIC(9.4,127,22,3,"PAH",95,1,10,0)="replacement system. The project consists of the implementation of the "
^DIC(9.4,127,22,3,"PAH",95,1,11,0)="billing replacement system, business process improvements, and "
^DIC(9.4,127,22,3,"PAH",95,1,12,0)="enhancements to VistA to support integration with the COTS billing "
^DIC(9.4,127,22,3,"PAH",95,1,13,0)="replacement system. Significant changes to VistA legacy systems and "
^DIC(9.4,127,22,3,"PAH",95,1,14,0)="ancillary packages are necessary."
^DIC(9.4,127,22,3,"PAH",95,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,16,0)="Some of the PFSS software components are not operational until the PFSS "
^DIC(9.4,127,22,3,"PAH",95,1,17,0)="On/Off Switch, distributed with patch IB*2*260, is set to ""ON"". The "
^DIC(9.4,127,22,3,"PAH",95,1,18,0)="ability for the local site to set the switch to ""ON"" will be provided at "
^DIC(9.4,127,22,3,"PAH",95,1,19,0)="the appropriate time with the release of a subsequent Integrated Billing "
^DIC(9.4,127,22,3,"PAH",95,1,20,0)="patch."
^DIC(9.4,127,22,3,"PAH",95,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,22,0)="For more information about the PFSS project, review the documentation "
^DIC(9.4,127,22,3,"PAH",95,1,23,0)="accompanying this patch and refer to the following website: "
^DIC(9.4,127,22,3,"PAH",95,1,24,0)="http://vista.domain.ext/billreplace/"
^DIC(9.4,127,22,3,"PAH",95,1,25,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,26,0)="Features of patch SR*3*144 are listed below:"
^DIC(9.4,127,22,3,"PAH",95,1,27,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,28,0)="1. The VistA Surgery software will be enhanced to request an account"
^DIC(9.4,127,22,3,"PAH",95,1,29,0)="   number for every Surgery Request Consult. This activity will support"
^DIC(9.4,127,22,3,"PAH",95,1,30,0)="   the Revenue Office's need to pre-certify with insurance companies the"
^DIC(9.4,127,22,3,"PAH",95,1,31,0)="   requested Surgery. A national guideline will be issued defining the"
^DIC(9.4,127,22,3,"PAH",95,1,32,0)="   minimum format for creating a Surgery Request Consult within the VistA"
^DIC(9.4,127,22,3,"PAH",95,1,33,0)="   Consults package that will collect the data required by PFSS. The"
^DIC(9.4,127,22,3,"PAH",95,1,34,0)="   Surgery Request Consult will not create a Surgery case. This guideline"
^DIC(9.4,127,22,3,"PAH",95,1,35,0)="   does not require that sites use the Consults package for creating"
^DIC(9.4,127,22,3,"PAH",95,1,36,0)="   Surgery requests. Sites using VistA Surgery Request options can"
^DIC(9.4,127,22,3,"PAH",95,1,37,0)="   continue to use that approach."
^DIC(9.4,127,22,3,"PAH",95,1,38,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,39,0)="   VistA Surgery will be enhanced to also request a PFSS ACCOUNT"
^DIC(9.4,127,22,3,"PAH",95,1,40,0)="   REFERENCE, and it will be stored in the PFSS ACCOUNT REFERENCE field"
^DIC(9.4,127,22,3,"PAH",95,1,41,0)="   (#500) of the SURGERY file (#130). The association to a PFSS ACCOUNT"
^DIC(9.4,127,22,3,"PAH",95,1,42,0)="   REFERENCE is obtained when the Surgery case is created and is sent to"
^DIC(9.4,127,22,3,"PAH",95,1,43,0)="   the PATIENT CARE ENCOUNTER (PCE) application upon completion of coding."
^DIC(9.4,127,22,3,"PAH",95,1,44,0)=" "
^DIC(9.4,127,22,3,"PAH",95,1,45,0)="2. This patch changes the List Completed Cases Missing CPT Codes [SRSCPT]"
^DIC(9.4,127,22,3,"PAH",95,1,46,0)="   option to list only those completed cases that do not have a final CPT "
^DIC(9.4,127,22,3,"PAH",95,1,47,0)="   code entered in the PRINCIPAL PROCEDURE CODE field (#.02) of the"
^DIC(9.4,127,22,3,"PAH",95,1,48,0)="   SURGERY PROCEDURE/DIAGNOSIS CODES file (#136)."
^DIC(9.4,127,22,3,"PAH",96,0)="156 SEQ #149^3060711^1"
^DIC(9.4,127,22,3,"PAH",96,1,0)="^^9^9^3060711"
^DIC(9.4,127,22,3,"PAH",96,1,1,0)="1. The Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] option for"
^DIC(9.4,127,22,3,"PAH",96,1,2,0)="   Non-Cardiac assessments is corrected to display the PRIN POSTOP"
^DIC(9.4,127,22,3,"PAH",96,1,3,0)="   DIAGNOSIS CODE field (#.03) stored in the SURGERY PROCEDURE/DIAGNOSIS"
^DIC(9.4,127,22,3,"PAH",96,1,4,0)="   CODES file (#136)."
^DIC(9.4,127,22,3,"PAH",96,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",96,1,6,0)="2. The Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] option for"
^DIC(9.4,127,22,3,"PAH",96,1,7,0)="   Non-Cardiac assessments is corrected to display the PRINCIPAL PROCEDURE"
^DIC(9.4,127,22,3,"PAH",96,1,8,0)="   CODE field (#.02) stored in the SURGERY PROCEDURE/DIAGNOSIS CODES file"
^DIC(9.4,127,22,3,"PAH",96,1,9,0)="   (#136) when referencing CPT Codes for Returns within 30 Days."
^DIC(9.4,127,22,3,"PAH",97,0)="154 SEQ #150^3060807^1"
^DIC(9.4,127,22,3,"PAH",97,1,0)="^^3^3^3060807"
^DIC(9.4,127,22,3,"PAH",97,1,1,0)="An undefined error occurs when two users attempt to access the "
^DIC(9.4,127,22,3,"PAH",97,1,2,0)="same record at the same time.  One user is creating a surgery request and "
^DIC(9.4,127,22,3,"PAH",97,1,3,0)="the other is attempting to delete that same user request."
^DIC(9.4,127,22,3,"PAH",98,0)="158 SEQ #151^3060807^1"
^DIC(9.4,127,22,3,"PAH",98,1,0)="^^12^12^3060807"
^DIC(9.4,127,22,3,"PAH",98,1,1,0)="After installing patch SR*3*144, if the SURGICAL RESIDENTS (Y/N) field "
^DIC(9.4,127,22,3,"PAH",98,1,2,0)="(#33) in the SURGERY SITE PARAMETERS file (#133) is NO, surgical cases for"
^DIC(9.4,127,22,3,"PAH",98,1,3,0)="that division created using the Schedule Unrequested Operations [SROSRES]"
^DIC(9.4,127,22,3,"PAH",98,1,4,0)="option will contain the textual name of the attending surgeon instead of "
^DIC(9.4,127,22,3,"PAH",98,1,5,0)="the pointer value in the ATTEND SURG field (#.164) in the SURGERY file"
^DIC(9.4,127,22,3,"PAH",98,1,6,0)="(#130)."
^DIC(9.4,127,22,3,"PAH",98,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",98,1,8,0)="This patch modifies the Schedule Unrequested Operations [SROSRES] option "
^DIC(9.4,127,22,3,"PAH",98,1,9,0)="so that the ATTEND SURG field (#.164) in the SURGERY file (#130) is set"
^DIC(9.4,127,22,3,"PAH",98,1,10,0)="correctly. This patch includes a post-installation process that will check"
^DIC(9.4,127,22,3,"PAH",98,1,11,0)="each surgical case and correct any textual entries that may exist in the"
^DIC(9.4,127,22,3,"PAH",98,1,12,0)="ATTEND SURG field (#.164) in the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",99,0)="153 SEQ #152^3060824^1"
^DIC(9.4,127,22,3,"PAH",99,1,0)="^^123^123^3060824"
^DIC(9.4,127,22,3,"PAH",99,1,1,0)="his patch updates the Surgery Risk Assessment software of the Veterans"
^DIC(9.4,127,22,3,"PAH",99,1,2,0)="Health Information Systems and Technology Architecture (VistA)"
^DIC(9.4,127,22,3,"PAH",99,1,3,0)="Surgery application as requested by the Executive Board of the National"
^DIC(9.4,127,22,3,"PAH",99,1,4,0)="Surgical Quality Improvement Program (NSQIP) and by the Cardiac Surgery"
^DIC(9.4,127,22,3,"PAH",99,1,5,0)="Consultants Board of the Continuous Improvement in Cardiac Surgery"
^DIC(9.4,127,22,3,"PAH",99,1,6,0)="Program (CICSP). These updates include the addition of new data fields,"
^DIC(9.4,127,22,3,"PAH",99,1,7,0)="changes to existing data fields, changes to data entry screens, changes"
^DIC(9.4,127,22,3,"PAH",99,1,8,0)="to reports used in Surgery Risk Assessment management process and changes"
^DIC(9.4,127,22,3,"PAH",99,1,9,0)="to the Surgery Risk Assessment transmissions."
^DIC(9.4,127,22,3,"PAH",99,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,11,0)="NOTE: All fields listed below are in the SURGERY file (#130) unless"
^DIC(9.4,127,22,3,"PAH",99,1,12,0)="otherwise indicated."
^DIC(9.4,127,22,3,"PAH",99,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,14,0)="Cardiac Risk Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",99,1,15,0)="-------------------------------------"
^DIC(9.4,127,22,3,"PAH",99,1,16,0)=" o Modifications to the Clinical Information (Enter/Edit) [SROA CLINICAL"
^DIC(9.4,127,22,3,"PAH",99,1,17,0)="   INFORMATION] option"
^DIC(9.4,127,22,3,"PAH",99,1,18,0)="  - The software is modified to auto-populate the HEIGHT field (#236) and"
^DIC(9.4,127,22,3,"PAH",99,1,19,0)="    the WEIGHT field (#237) as documented in the Vitals software."
^DIC(9.4,127,22,3,"PAH",99,1,20,0)="  - The Current Smoker item under this option is modified to reference to"
^DIC(9.4,127,22,3,"PAH",99,1,21,0)="    the new CURRENT SMOKER (CARDIAC) field (#510) instead of the old field"
^DIC(9.4,127,22,3,"PAH",99,1,22,0)="    CURRENT SMOKER field (#202), which will be utilized by the NSQIP"
^DIC(9.4,127,22,3,"PAH",99,1,23,0)="    options."
^DIC(9.4,127,22,3,"PAH",99,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,25,0)=" o Modifications to the Laboratory Test Results (Enter/Edit) [SROA"
^DIC(9.4,127,22,3,"PAH",99,1,26,0)="   LAB-CARDIAC] option"
^DIC(9.4,127,22,3,"PAH",99,1,27,0)="  - The HEMOGLOBIN A1C field (#504) and the HEMOGLOBIN A1C, DATE field"
^DIC(9.4,127,22,3,"PAH",99,1,28,0)="    (#504.1) are added to the list of preoperative lab results."
^DIC(9.4,127,22,3,"PAH",99,1,29,0)="  - The software is modified to use a date range of 1000 days prior to the"
^DIC(9.4,127,22,3,"PAH",99,1,30,0)="    date of operation when searching for the most recent preoperative lab"
^DIC(9.4,127,22,3,"PAH",99,1,31,0)="    test result for the HDL (CARDIAC) field (#457), the LDL (CARDIAC)"
^DIC(9.4,127,22,3,"PAH",99,1,32,0)="    field (#461), the TOTAL CHOLESTEROL (CARDIAC) field (#462), the SERUM"
^DIC(9.4,127,22,3,"PAH",99,1,33,0)="    TRIGLYCERIDE (CARDIAC) field (#458), and the HEMOGLOBIN A1C field"
^DIC(9.4,127,22,3,"PAH",99,1,34,0)="    (#504)."
^DIC(9.4,127,22,3,"PAH",99,1,35,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,36,0)=" o The Enter Cardiac Catheterization & Angiographic Data [SROA CARDIAC"
^DIC(9.4,127,22,3,"PAH",99,1,37,0)="   PROCEDURES] option is modified to allow all fields to be"
^DIC(9.4,127,22,3,"PAH",99,1,38,0)="   auto-populated with 'NS' (NO STUDY) when 'NS' is entered in the"
^DIC(9.4,127,22,3,"PAH",99,1,39,0)="   PROCEDURE TYPE field (#476)."
^DIC(9.4,127,22,3,"PAH",99,1,40,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,41,0)=" o Modifications to the Cardiac Procedures Operative Data (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",99,1,42,0)="   [SROA CARDIAC PROCEDURES] option"
^DIC(9.4,127,22,3,"PAH",99,1,43,0)="  - The GREAT VESSEL REPAIR (Y/N) field (#372) is moved to screen #1 under"
^DIC(9.4,127,22,3,"PAH",99,1,44,0)="    this option as item #20."
^DIC(9.4,127,22,3,"PAH",99,1,45,0)="  - The ENDOVASCULAR REPAIR field (#505) is added in screen #1 as item"
^DIC(9.4,127,22,3,"PAH",99,1,46,0)="    #21."
^DIC(9.4,127,22,3,"PAH",99,1,47,0)="  - The OTHER CT PROCEDURE field (#484) in the first screen is now"
^DIC(9.4,127,22,3,"PAH",99,1,48,0)="    replaced by the OTHER CARDIAC PROCEDURES (Y/N) field (#502). If this"
^DIC(9.4,127,22,3,"PAH",99,1,49,0)="    field value is ""YES"" the software will prompt the user for the OTHER"
^DIC(9.4,127,22,3,"PAH",99,1,50,0)="    CARDIAC PROCEDURES-LIST field (#484)."
^DIC(9.4,127,22,3,"PAH",99,1,51,0)="  - The OTHER NON-CT PROCEDURES field (#491) is removed from the second"
^DIC(9.4,127,22,3,"PAH",99,1,52,0)="    screen and a blank line is added before ""Other Operative Data"
^DIC(9.4,127,22,3,"PAH",99,1,53,0)="    details"" header."
^DIC(9.4,127,22,3,"PAH",99,1,54,0)="  - The software is modified so that entering ""N"" for the VALVE REPAIR"
^DIC(9.4,127,22,3,"PAH",99,1,55,0)="    field (#370) shall result in ""5. None"". The existing N's will be"
^DIC(9.4,127,22,3,"PAH",99,1,56,0)="    converted to '5' upon patch installation."
^DIC(9.4,127,22,3,"PAH",99,1,57,0)="  - This option is updated to reference the new MAZE PROCEDURE field"
^DIC(9.4,127,22,3,"PAH",99,1,58,0)="    (#512) as item 13 in the first data entry screen."
^DIC(9.4,127,22,3,"PAH",99,1,59,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,60,0)=" o A new occurrence category REPEAT VENTILATOR SUPPORT W/IN 30 DAYS is"
^DIC(9.4,127,22,3,"PAH",99,1,61,0)="   created in the PERIOPERATIVE OCCURRENCE CATEGORY file (#136.5). This"
^DIC(9.4,127,22,3,"PAH",99,1,62,0)="   occurrence category will be selectable only for cardiac assessed cases."
^DIC(9.4,127,22,3,"PAH",99,1,63,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,64,0)=" o The following fields on the Resource Data [SROA CARDIAC RESOURCE]"
^DIC(9.4,127,22,3,"PAH",99,1,65,0)="   option are modified to assume a default of ""past date"" when no year is"
^DIC(9.4,127,22,3,"PAH",99,1,66,0)="   specified:"
^DIC(9.4,127,22,3,"PAH",99,1,67,0)="  - ESTIMATE OF MORTALITY, DATE field (#364.1)"
^DIC(9.4,127,22,3,"PAH",99,1,68,0)="  - D/T PATIENT EXTUBATED field (#470)"
^DIC(9.4,127,22,3,"PAH",99,1,69,0)="  - D/T PATIENT DISCH FROM ICU field (#471)"
^DIC(9.4,127,22,3,"PAH",99,1,70,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,71,0)=" o This patch will allow the retransmission of a cardiac risk assessment."
^DIC(9.4,127,22,3,"PAH",99,1,72,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,73,0)="Non-Cardiac Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",99,1,74,0)="------------------------------------"
^DIC(9.4,127,22,3,"PAH",99,1,75,0)=" o Modifications to the Preoperative Information (Enter/Edit) [SROA PREOP"
^DIC(9.4,127,22,3,"PAH",99,1,76,0)="   DATA] option"
^DIC(9.4,127,22,3,"PAH",99,1,77,0)="  - The software is modified to auto-populate the HEIGHT field (#236) and"
^DIC(9.4,127,22,3,"PAH",99,1,78,0)="    the WEIGHT field (#237) as documented in the Vitals software."
^DIC(9.4,127,22,3,"PAH",99,1,79,0)="  - The PREGNANCY field (#269) is added to the NUTRITIONAL/IMMUNE/OTHER"
^DIC(9.4,127,22,3,"PAH",99,1,80,0)="    section."
^DIC(9.4,127,22,3,"PAH",99,1,81,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,82,0)=" o Modifications to the Laboratory Test Results (Enter/Edit) [SROA LAB]"
^DIC(9.4,127,22,3,"PAH",99,1,83,0)="   option"
^DIC(9.4,127,22,3,"PAH",99,1,84,0)="  - The PREOPERATIVE ANION GAP field (#444) and the PREOP ANION GAP, DATE"
^DIC(9.4,127,22,3,"PAH",99,1,85,0)="    field (#444.1) are added to the list of preoperative lab results."
^DIC(9.4,127,22,3,"PAH",99,1,86,0)="  - The HIGHEST ANION GAP field (#445) and the HIGH ANION GAP, DATE field"
^DIC(9.4,127,22,3,"PAH",99,1,87,0)="    (445.1) are added to the list of postoperative lab results."
^DIC(9.4,127,22,3,"PAH",99,1,88,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,89,0)=" o The Operation Information (Enter/Edit) [SROA OPERATION DATA] option is"
^DIC(9.4,127,22,3,"PAH",99,1,90,0)="   modified to add the INTRAOP DISSEMINATED CANCER field (#443)."
^DIC(9.4,127,22,3,"PAH",99,1,91,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,92,0)="Other Risk Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",99,1,93,0)="-----------------------------------"
^DIC(9.4,127,22,3,"PAH",99,1,94,0)=" o The Print a Surgery Risk Assessment [SROA Print Assessment] option is"
^DIC(9.4,127,22,3,"PAH",99,1,95,0)="   modified to include the new data elements."
^DIC(9.4,127,22,3,"PAH",99,1,96,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,97,0)=" o The transmissions to the national databases are modified to include the"
^DIC(9.4,127,22,3,"PAH",99,1,98,0)="   new fields."
^DIC(9.4,127,22,3,"PAH",99,1,99,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,100,0)=" o Modification to some of the user entries of fields that allow text to"
^DIC(9.4,127,22,3,"PAH",99,1,101,0)="   be entered to accept lower case or all CAPS"
^DIC(9.4,127,22,3,"PAH",99,1,102,0)="  - The NUM OF PRIOR HEART SURGERIES field (#352) is modified to allow the"
^DIC(9.4,127,22,3,"PAH",99,1,103,0)="    entry of lowercase letter ""N"" to represent ""0 - NONE"". Any existing"
^DIC(9.4,127,22,3,"PAH",99,1,104,0)="    N's will be converted to '0' for NONE by he post install routine."
^DIC(9.4,127,22,3,"PAH",99,1,105,0)="  - The ESTIMATE OF MORTALITY field (#364) is modified to allow the entry"
^DIC(9.4,127,22,3,"PAH",99,1,106,0)="    of lowercase letter ""ns"" to represent ""NO STUDY""."
^DIC(9.4,127,22,3,"PAH",99,1,107,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,108,0)=" o Modifications to the List of Surgery Risk Assessments [SROA ASSESSMENT"
^DIC(9.4,127,22,3,"PAH",99,1,109,0)="   LIST] option"
^DIC(9.4,127,22,3,"PAH",99,1,110,0)="  - Each report is modified to display the final CPT codes from the case"
^DIC(9.4,127,22,3,"PAH",99,1,111,0)="    coding record in the SURGERY PROCEDURE/DIAGNOSIS CODES file (#136)."
^DIC(9.4,127,22,3,"PAH",99,1,112,0)="  - List of 1-Liner Cases Missing Information (list #8) is added."
^DIC(9.4,127,22,3,"PAH",99,1,113,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,114,0)="General Surgery Items"
^DIC(9.4,127,22,3,"PAH",99,1,115,0)="---------------------"
^DIC(9.4,127,22,3,"PAH",99,1,116,0)=" o The PREOP HAIR CLIPPING BY field (#.12) is renamed HAIR REMOVAL BY."
^DIC(9.4,127,22,3,"PAH",99,1,117,0)=" "
^DIC(9.4,127,22,3,"PAH",99,1,118,0)=" o The HAIR REMOVAL METHOD field (#506) and the HAIR REMOVAL COMMENTS"
^DIC(9.4,127,22,3,"PAH",99,1,119,0)="   field (#508) are added to the Operation Startup [SROMEN-START] option"
^DIC(9.4,127,22,3,"PAH",99,1,120,0)="   and the Operation (Short Screen) [SROMEN-OUT] option. Those two fields"
^DIC(9.4,127,22,3,"PAH",99,1,121,0)="   and the HAIR REMOVAL BY field (#.12) are added to the Nurse"
^DIC(9.4,127,22,3,"PAH",99,1,122,0)="   Intraoperative Report and became a mandatory documentation field to"
^DIC(9.4,127,22,3,"PAH",99,1,123,0)="   satisfy the record review process for quality measurement purposes."
^DIC(9.4,127,22,3,"PAH",100,0)="157 SEQ #153^3061122.232036^1"
^DIC(9.4,127,22,3,"PAH",100,1,0)="^^20^20^3061122"
^DIC(9.4,127,22,3,"PAH",100,1,1,0)="1. The Surgery-Tracking Prosthesis Items project enhances the Surgery"
^DIC(9.4,127,22,3,"PAH",100,1,2,0)="   software, adding new fields to the PROSTHESIS INSTALLED sub-file"
^DIC(9.4,127,22,3,"PAH",100,1,3,0)="   (#130.01) in the SURGERY file (#130). These new fields will"
^DIC(9.4,127,22,3,"PAH",100,1,4,0)="   function to mark the prosthesis item as sterile and record the"
^DIC(9.4,127,22,3,"PAH",100,1,5,0)="   expiration date of the sterile implant. The information entered into"
^DIC(9.4,127,22,3,"PAH",100,1,6,0)="   these fields will display on the Nurse Intraoperative Report. As an"
^DIC(9.4,127,22,3,"PAH",100,1,7,0)="   added safety/quality measure, the new fields will be mandatory for"
^DIC(9.4,127,22,3,"PAH",100,1,8,0)="   signing the Nurse Intraoperative Report. The report cannot be signed"
^DIC(9.4,127,22,3,"PAH",100,1,9,0)="   until all documentation is completed."
^DIC(9.4,127,22,3,"PAH",100,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",100,1,11,0)="2. Unrelated to the Prosthesis features, the trigger event for"
^DIC(9.4,127,22,3,"PAH",100,1,12,0)="   discontinuing orders will be moved from the TIME PAT OUT OR field"
^DIC(9.4,127,22,3,"PAH",100,1,13,0)="   (#.232) of the SURGERY file (#130) to the TIME PAT IN OR field (#.205)"
^DIC(9.4,127,22,3,"PAH",100,1,14,0)="   of the SURGERY file (#130). This enhancement is required as part of"
^DIC(9.4,127,22,3,"PAH",100,1,15,0)="   the Documenting Preoperative Antibiotics (Gainesville Solution)"
^DIC(9.4,127,22,3,"PAH",100,1,16,0)="   project."
^DIC(9.4,127,22,3,"PAH",100,1,17,0)=" "
^DIC(9.4,127,22,3,"PAH",100,1,18,0)="3. On the Nurse Intraoperative Report, replace references to CORRECT"
^DIC(9.4,127,22,3,"PAH",100,1,19,0)="   SURGERY COMMENTS to TIME OUT VERIFIED COMMENTS, IMAGING CONFIRMED"
^DIC(9.4,127,22,3,"PAH",100,1,20,0)="   COMMENTS, and MARKED SITE COMMENTS, as appropriate."
^DIC(9.4,127,22,3,"PAH",101,0)="160 SEQ #154^3070905.003141^1"
^DIC(9.4,127,22,3,"PAH",101,1,0)="^^170^170^3070905"
^DIC(9.4,127,22,3,"PAH",101,1,1,0)="This patch updates the Surgery Risk Assessment software of the Veterans"
^DIC(9.4,127,22,3,"PAH",101,1,2,0)="Health Information Systems and Technology Architecture (VistA) Surgery"
^DIC(9.4,127,22,3,"PAH",101,1,3,0)="application as requested by the Executive Board of the National Surgical"
^DIC(9.4,127,22,3,"PAH",101,1,4,0)="Quality Improvement Program (NSQIP) and by the Cardiac Surgery Consultants"
^DIC(9.4,127,22,3,"PAH",101,1,5,0)="Board of the Continuous Improvement in Cardiac Surgery Program (CICSP)."
^DIC(9.4,127,22,3,"PAH",101,1,6,0)="The updates include the addition of new data fields, changes to existing "
^DIC(9.4,127,22,3,"PAH",101,1,7,0)="data fields, changes to data entry screens, changes to reports used in "
^DIC(9.4,127,22,3,"PAH",101,1,8,0)="Surgery Risk Assessment management process and changes to the Surgery Risk"
^DIC(9.4,127,22,3,"PAH",101,1,9,0)="Assessment transmissions."
^DIC(9.4,127,22,3,"PAH",101,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,11,0)="Non-Cardiac Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",101,1,12,0)="------------------------------------"
^DIC(9.4,127,22,3,"PAH",101,1,13,0)=" * Note: All fields named below are in the SURGERY file (#130) unless "
^DIC(9.4,127,22,3,"PAH",101,1,14,0)="         otherwise indicated."
^DIC(9.4,127,22,3,"PAH",101,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,16,0)="- These updates include functionality for selecting cases for risk"
^DIC(9.4,127,22,3,"PAH",101,1,17,0)="  assessment based upon case Current Procedural Terminology (CPT) codes,"
^DIC(9.4,127,22,3,"PAH",101,1,18,0)="  replacing the use of the Major or Minor surgery definition."
^DIC(9.4,127,22,3,"PAH",101,1,19,0)="   o When selecting a case to be assessed, the software will check the "
^DIC(9.4,127,22,3,"PAH",101,1,20,0)="     case CPT codes and display an informational statement if no CPT codes"
^DIC(9.4,127,22,3,"PAH",101,1,21,0)="     have been assigned to the case or if the case should be excluded from"
^DIC(9.4,127,22,3,"PAH",101,1,22,0)="     assessment."
^DIC(9.4,127,22,3,"PAH",101,1,23,0)="   o A new report called ""List of Eligible Cases"" is added to the reports "
^DIC(9.4,127,22,3,"PAH",101,1,24,0)="     contained in the List of Surgery Risk Assessments [SROA ASSESSMENT "
^DIC(9.4,127,22,3,"PAH",101,1,25,0)="     LIST] option."
^DIC(9.4,127,22,3,"PAH",101,1,26,0)="   o The MAJOR/MINOR field (#.03) is removed from NSQIP input options and "
^DIC(9.4,127,22,3,"PAH",101,1,27,0)="     from the Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] "
^DIC(9.4,127,22,3,"PAH",101,1,28,0)="     option."
^DIC(9.4,127,22,3,"PAH",101,1,29,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,30,0)="- A new field called INTRAOPERATIVE ASCITES (#446) is created:"
^DIC(9.4,127,22,3,"PAH",101,1,31,0)="   o Added to the Operation Information (Enter/Edit) [SROA OPERATION DATA]"
^DIC(9.4,127,22,3,"PAH",101,1,32,0)="     option"
^DIC(9.4,127,22,3,"PAH",101,1,33,0)="   o Added to the Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] "
^DIC(9.4,127,22,3,"PAH",101,1,34,0)="     option"
^DIC(9.4,127,22,3,"PAH",101,1,35,0)="   o Added to data set transmitted to the national database"
^DIC(9.4,127,22,3,"PAH",101,1,36,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,37,0)="- A new field called CLOSTRIDIUM DIFFICILE COLITIS (#447) is created:"
^DIC(9.4,127,22,3,"PAH",101,1,38,0)="   o Added to the Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] "
^DIC(9.4,127,22,3,"PAH",101,1,39,0)="     option"
^DIC(9.4,127,22,3,"PAH",101,1,40,0)="   o Added to the PERIOPERATIVE OCCURRENCE CATEGORIES section of the "
^DIC(9.4,127,22,3,"PAH",101,1,41,0)="     Surgery Quarterly Report"
^DIC(9.4,127,22,3,"PAH",101,1,42,0)="   o CLOSTRIDIUM DIFFICILE COLITIS is added as a new occurrence category "
^DIC(9.4,127,22,3,"PAH",101,1,43,0)="     to the PERIOPERATIVE OCCURRENCE CATEGORY file (#136.5)"
^DIC(9.4,127,22,3,"PAH",101,1,44,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,45,0)="- The description is updated and/or other data dictionary changes are made"
^DIC(9.4,127,22,3,"PAH",101,1,46,0)="  for the following items:"
^DIC(9.4,127,22,3,"PAH",101,1,47,0)="   o SURGERY SPECIALTY field (#.04)"
^DIC(9.4,127,22,3,"PAH",101,1,48,0)="   o WOUND CLASSIFICATION field (#1.09)"
^DIC(9.4,127,22,3,"PAH",101,1,49,0)="   o REASON FOR NO ASSESSMENT field (#102)"
^DIC(9.4,127,22,3,"PAH",101,1,50,0)="   o HISTORY OF COPD field (#203)"
^DIC(9.4,127,22,3,"PAH",101,1,51,0)="   o WEIGHT LOSS > 10% field (#215)"
^DIC(9.4,127,22,3,"PAH",101,1,52,0)="   o BLEEDING DISORDERS field (#216)"
^DIC(9.4,127,22,3,"PAH",101,1,53,0)="   o OPEN WOUND field (#218)"
^DIC(9.4,127,22,3,"PAH",101,1,54,0)="   o PREOPERATIVE SEPSIS field (#218.1)"
^DIC(9.4,127,22,3,"PAH",101,1,55,0)="   o PREVIOUS PCI field (#220)"
^DIC(9.4,127,22,3,"PAH",101,1,56,0)="   o SYSTEMIC SEPSIS field (#250) and the SYSTEMIC SEPSIS occurrence "
^DIC(9.4,127,22,3,"PAH",101,1,57,0)="     category in the PERIOPERATIVE OCCURRENCE CATEGORY file (#136.5)"
^DIC(9.4,127,22,3,"PAH",101,1,58,0)="   o PNEUMONIA field (#251) and the PNEUMONIA occurrence category in the "
^DIC(9.4,127,22,3,"PAH",101,1,59,0)="     PERIOPERATIVE OCCURRENCE CATEGORY file (#136.5)"
^DIC(9.4,127,22,3,"PAH",101,1,60,0)="   o PULMONARY EMBOLISM field (#252) and the PULMONARY EMBOLISM occurrence"
^DIC(9.4,127,22,3,"PAH",101,1,61,0)="     category in file (#136.5)"
^DIC(9.4,127,22,3,"PAH",101,1,62,0)="   o ACUTE RENAL FAILURE field (#254) and the ACUTE RENAL FAILURE"
^DIC(9.4,127,22,3,"PAH",101,1,63,0)="     occurrence category in file (#136.5)"
^DIC(9.4,127,22,3,"PAH",101,1,64,0)="   o PREGNANCY field (#269)"
^DIC(9.4,127,22,3,"PAH",101,1,65,0)="   o PERIPHERAL NERVE INJURY field (#287) and the PERIPHERAL NERVE INJURY "
^DIC(9.4,127,22,3,"PAH",101,1,66,0)="     occurrence category in the PERIOPERATIVE OCCURRENCE CATEGORY file "
^DIC(9.4,127,22,3,"PAH",101,1,67,0)="     (#136.5)"
^DIC(9.4,127,22,3,"PAH",101,1,68,0)="   o DYSPNEA field (#325)"
^DIC(9.4,127,22,3,"PAH",101,1,69,0)="   o CURRENT PNEUMONIA field (#326)"
^DIC(9.4,127,22,3,"PAH",101,1,70,0)="   o REST PAIN/GANGRENE (Y/N) field (#330)"
^DIC(9.4,127,22,3,"PAH",101,1,71,0)="   o CHEMOTHERAPY IN LAST 30 DAYS field (#338.1)"
^DIC(9.4,127,22,3,"PAH",101,1,72,0)="   o QUADRIPLEGIA (Y/N) field (#398)"
^DIC(9.4,127,22,3,"PAH",101,1,73,0)="   o TUMOR INVOLVING CNS (Y/N) field (#401)"
^DIC(9.4,127,22,3,"PAH",101,1,74,0)="   o INTRAOP DISSEMINATED CANCER field (#443)"
^DIC(9.4,127,22,3,"PAH",101,1,75,0)="   o DATE COMP NOTED field (#2, sub-file #130.22)"
^DIC(9.4,127,22,3,"PAH",101,1,76,0)="   o SEPSIS CATEGORY field (#7, sub-file #130.22)"
^DIC(9.4,127,22,3,"PAH",101,1,77,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,78,0)="- Hemoglobin A1c is added to the set of preoperative lab test results."
^DIC(9.4,127,22,3,"PAH",101,1,79,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,80,0)="- This patch modifies all Lab fields under the Laboratory Test Results"
^DIC(9.4,127,22,3,"PAH",101,1,81,0)="  (Enter/Edit) [SROA LAB] option to assume a past date if the user enters"
^DIC(9.4,127,22,3,"PAH",101,1,82,0)="  a date without a year."
^DIC(9.4,127,22,3,"PAH",101,1,83,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,84,0)="- The DATE OF DEATH field (#342) is modified to allow the entry of time as"
^DIC(9.4,127,22,3,"PAH",101,1,85,0)="  well as date and is added to the Patient Demographics (Enter/Edit) [SROA"
^DIC(9.4,127,22,3,"PAH",101,1,86,0)="  DEMOGRAPHICS] option."
^DIC(9.4,127,22,3,"PAH",101,1,87,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,88,0)="- Airway Trauma, Mallampati Scale and Airway Index are removed from the"
^DIC(9.4,127,22,3,"PAH",101,1,89,0)="  set of information collected and transmitted to NSQIP."
^DIC(9.4,127,22,3,"PAH",101,1,90,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,91,0)="- The letter produced by the Print 30 Day Follow-up Letters [SROA REPRINT "
^DIC(9.4,127,22,3,"PAH",101,1,92,0)="  LETTERS] option is modified to display the date of operation and the "
^DIC(9.4,127,22,3,"PAH",101,1,93,0)="  local surgical specialty."
^DIC(9.4,127,22,3,"PAH",101,1,94,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,95,0)="- The Monthly Surgical Case Workload Report [SROA MONTHLY WORKLOAD REPORT]"
^DIC(9.4,127,22,3,"PAH",101,1,96,0)="  option is modified to replace references to major/minor with eligible or"
^DIC(9.4,127,22,3,"PAH",101,1,97,0)="  excluded."
^DIC(9.4,127,22,3,"PAH",101,1,98,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,99,0)="  "
^DIC(9.4,127,22,3,"PAH",101,1,100,0)="Cardiac Risk Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",101,1,101,0)="-------------------------------------"
^DIC(9.4,127,22,3,"PAH",101,1,102,0)="- The software is modified to expand the answer options of the PREOP"
^DIC(9.4,127,22,3,"PAH",101,1,103,0)="  CIRCULATORY DEVICE field (#474) to include ""ARTIFICIAL HEART"" and to "
^DIC(9.4,127,22,3,"PAH",101,1,104,0)="  transmit ""A"" to CICSP for new raw value of this answer option."
^DIC(9.4,127,22,3,"PAH",101,1,105,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,106,0)="- This patch modifies all Lab fields under the Laboratory Test Results"
^DIC(9.4,127,22,3,"PAH",101,1,107,0)="  (Enter/Edit) [SROA LAB-CARDIAC] option to assume a past date if the user"
^DIC(9.4,127,22,3,"PAH",101,1,108,0)="  enters a date without a year."
^DIC(9.4,127,22,3,"PAH",101,1,109,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,110,0)="- Reinstitute the default functionality of the CARDIAC SURG PERFORMED "
^DIC(9.4,127,22,3,"PAH",101,1,111,0)="  NON-VA field (#472) in the SURGERY file (#130), so that it defaults to"
^DIC(9.4,127,22,3,"PAH",101,1,112,0)="  ""NO"". "
^DIC(9.4,127,22,3,"PAH",101,1,113,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,114,0)="- The description is updated and/or other data dictionary changes are made"
^DIC(9.4,127,22,3,"PAH",101,1,115,0)="  for the following items:"
^DIC(9.4,127,22,3,"PAH",101,1,116,0)="   o CONGESTIVE HEART FAILURE field (#207)"
^DIC(9.4,127,22,3,"PAH",101,1,117,0)="   o ON VENTILATOR >48 HOURS field (#285)"
^DIC(9.4,127,22,3,"PAH",101,1,118,0)="   o PERIOPERATIVE MI field (#385)"
^DIC(9.4,127,22,3,"PAH",101,1,119,0)="   o PREOP CIRCULATORY DEVICE field (#474)"
^DIC(9.4,127,22,3,"PAH",101,1,120,0)="   o AORTIC STENOSIS field (#477)"
^DIC(9.4,127,22,3,"PAH",101,1,121,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,122,0)="- Data Quality Queries"
^DIC(9.4,127,22,3,"PAH",101,1,123,0)="  The data entry that does not meet the criteria is permitted, but would "
^DIC(9.4,127,22,3,"PAH",101,1,124,0)="  cause a warning message to check the data for accuracy."
^DIC(9.4,127,22,3,"PAH",101,1,125,0)="   o The D/T PATIENT EXTUBATED field (#470) should be later than the TIME"
^DIC(9.4,127,22,3,"PAH",101,1,126,0)="     PAT OUT OR field (#.232)."
^DIC(9.4,127,22,3,"PAH",101,1,127,0)="   o The D/T PATIENT EXTUBATED field (#470) should be earlier than the D/T"
^DIC(9.4,127,22,3,"PAH",101,1,128,0)="     PATIENT DISCH FROM ICU field (#471)."
^DIC(9.4,127,22,3,"PAH",101,1,129,0)="   o The D/T PATIENT DISCH FROM ICU field (#471) should be later than the"
^DIC(9.4,127,22,3,"PAH",101,1,130,0)="     D/T PATIENT EXTUBATED field (#470)."
^DIC(9.4,127,22,3,"PAH",101,1,131,0)="   o D/T PATIENT DISCH FROM ICU field (#471) be equal to or earlier than"
^DIC(9.4,127,22,3,"PAH",101,1,132,0)="     the HOSPITAL DISCHARGE DATE field (#419)."
^DIC(9.4,127,22,3,"PAH",101,1,133,0)="   o The SURGICAL PRIORITY, DATE field (#414.1) should be earlier than"
^DIC(9.4,127,22,3,"PAH",101,1,134,0)="     the TIME PAT IN OR field (#.205)."
^DIC(9.4,127,22,3,"PAH",101,1,135,0)="   o The ESTIMATE OF MORTALITY, DATE field (#364.1) should be earlier than"
^DIC(9.4,127,22,3,"PAH",101,1,136,0)="     the TIME PAT IN OR field (#.205)."
^DIC(9.4,127,22,3,"PAH",101,1,137,0)="   o If TOTAL CPB TIME field (#451) > 0, the CONVERT FROM OFF PUMP TO CPB"
^DIC(9.4,127,22,3,"PAH",101,1,138,0)="     field (#469) should not be answered ""NO, began off/stayed off""."
^DIC(9.4,127,22,3,"PAH",101,1,139,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,140,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,141,0)="General Surgery Items"
^DIC(9.4,127,22,3,"PAH",101,1,142,0)="---------------------"
^DIC(9.4,127,22,3,"PAH",101,1,143,0)="- Remedy Ticket #HD0000000152814"
^DIC(9.4,127,22,3,"PAH",101,1,144,0)="  This patch addresses two issues related to the Update Assessment Status"
^DIC(9.4,127,22,3,"PAH",101,1,145,0)="  to 'COMPLETE' [SROA COMPLETE ASSESSMENT] option missing items list:"
^DIC(9.4,127,22,3,"PAH",101,1,146,0)="  (1) For the NUM OF PRIOR HEART SURGERIES field (#352) in the SURGERY"
^DIC(9.4,127,22,3,"PAH",101,1,147,0)="      file (#130), the field is corrected to display ""Number of Prior"
^DIC(9.4,127,22,3,"PAH",101,1,148,0)="      Heart Surgeries"" instead of ""Prior Heart Surgery (Y/N)""."
^DIC(9.4,127,22,3,"PAH",101,1,149,0)="  (2) For the field ""PRIOR HEART SURGERIES"" field (#485) in the SURGERY "
^DIC(9.4,127,22,3,"PAH",101,1,150,0)="      file (#130), the data input functionality is modified to use the"
^DIC(9.4,127,22,3,"PAH",101,1,151,0)="      same controlled data input functionality used by the Clinical"
^DIC(9.4,127,22,3,"PAH",101,1,152,0)="      Information (Enter/Edit) [SROA CLINICAL INFORMATION] option. "
^DIC(9.4,127,22,3,"PAH",101,1,153,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,154,0)="- Remedy Ticket #HD0000000177807"
^DIC(9.4,127,22,3,"PAH",101,1,155,0)="  After installing this patch, if procedure and diagnosis coding is not"
^DIC(9.4,127,22,3,"PAH",101,1,156,0)="  complete at the time the Update Assessment Status to 'COMPLETE' [SROA"
^DIC(9.4,127,22,3,"PAH",101,1,157,0)="  COMPLETE ASSESSMENT] option is run, the software will display ""The"
^DIC(9.4,127,22,3,"PAH",101,1,158,0)="  coding for Procedure and Diagnosis is not complete"" immediately before"
^DIC(9.4,127,22,3,"PAH",101,1,159,0)="  asking, ""Are you sure you want to complete this assessment ?""."
^DIC(9.4,127,22,3,"PAH",101,1,160,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,161,0)="- Remedy Ticket #HD0000000185045"
^DIC(9.4,127,22,3,"PAH",101,1,162,0)="  When using the Outcome Information (Enter/Edit) [SROA CARDIAC-OUTCOMES] "
^DIC(9.4,127,22,3,"PAH",101,1,163,0)="  option to edit the OPERATIVE DEATH field (#384), entering YES or NO "
^DIC(9.4,127,22,3,"PAH",101,1,164,0)="  causes the NEW MECHANICAL CIRCULATORY field (#467) to be changed to the "
^DIC(9.4,127,22,3,"PAH",101,1,165,0)="  same value. Editing the NEW MECHANICAL CIRCULATORY field (#467) field "
^DIC(9.4,127,22,3,"PAH",101,1,166,0)="  does not change the OPERATIVE DEATH field (#384)."
^DIC(9.4,127,22,3,"PAH",101,1,167,0)=" "
^DIC(9.4,127,22,3,"PAH",101,1,168,0)="- Short LOCK Timeouts"
^DIC(9.4,127,22,3,"PAH",101,1,169,0)="  This patch updates the 1 second LOCK timeouts in the routine SROUTL to "
^DIC(9.4,127,22,3,"PAH",101,1,170,0)="  use the VA FileMan variable DILOCKTM if it exists."
^DIC(9.4,127,22,3,"PAH",102,0)="161 SEQ #155^3070905.010912^1"
^DIC(9.4,127,22,3,"PAH",102,1,0)="^^27^27^3070905"
^DIC(9.4,127,22,3,"PAH",102,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,127,22,3,"PAH",102,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",102,1,3,0)="1.  HD136616  SROPCEP  Primary and Secondary Provider incorrect from "
^DIC(9.4,127,22,3,"PAH",102,1,4,0)="Surgery pkg"
^DIC(9.4,127,22,3,"PAH",102,1,5,0)="The information  passed from the surgical package to PCE when received in "
^DIC(9.4,127,22,3,"PAH",102,1,6,0)="PCE the "
^DIC(9.4,127,22,3,"PAH",102,1,7,0)="SURGEON is listed as the PRIAMRY PROVIDER and the ATTENDING is listed as "
^DIC(9.4,127,22,3,"PAH",102,1,8,0)="the "
^DIC(9.4,127,22,3,"PAH",102,1,9,0)="SECONDARY PROVIDER.  Claims are being rejected if the PRIMARY PROVIDER is "
^DIC(9.4,127,22,3,"PAH",102,1,10,0)="a RESIDNET"
^DIC(9.4,127,22,3,"PAH",102,1,11,0)=" "
^DIC(9.4,127,22,3,"PAH",102,1,12,0)="2.  HD175983   SROCON   Error - <UNDEFINED>HELP+1^SROCON"
^DIC(9.4,127,22,3,"PAH",102,1,13,0)="When entering Anesthesia data for a surgical case, ^SROCON routine errors "
^DIC(9.4,127,22,3,"PAH",102,1,14,0)="at the"
^DIC(9.4,127,22,3,"PAH",102,1,15,0)="""Do you want to store this information in the concurrent case ?  YES//"" "
^DIC(9.4,127,22,3,"PAH",102,1,16,0)="prompt if "
^DIC(9.4,127,22,3,"PAH",102,1,17,0)="a ""?"" is entered and concurrent cases exist."
^DIC(9.4,127,22,3,"PAH",102,1,18,0)=" "
^DIC(9.4,127,22,3,"PAH",102,1,19,0)="3.  HD177449  SROREQ4   UNDEF ERROR"
^DIC(9.4,127,22,3,"PAH",102,1,20,0)="When running the : Operation Requests for a Day  [SROP REQ] option the "
^DIC(9.4,127,22,3,"PAH",102,1,21,0)="report "
^DIC(9.4,127,22,3,"PAH",102,1,22,0)="generates an error <UNDEFINED>PRINT+2^SROREQ4"
^DIC(9.4,127,22,3,"PAH",102,1,23,0)=" S S(0)=^SRF(SRTN,0),DFN=$P(S(0),""^""),CNT=CNT+1"
^DIC(9.4,127,22,3,"PAH",102,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",102,1,25,0)="4.  HD153358  SROCDX1   Error - <UNDEFINED>PADD1+4^SROCDX1"
^DIC(9.4,127,22,3,"PAH",102,1,26,0)="An <UNDEFINDED> error was encountered when trying to verify some ICD-9 "
^DIC(9.4,127,22,3,"PAH",102,1,27,0)="codes or Procedure codes."
^DIC(9.4,127,22,3,"PAH",103,0)="159 SEQ #156^3071212.201701^1"
^DIC(9.4,127,22,3,"PAH",103,1,0)="^^20^20^3071212"
^DIC(9.4,127,22,3,"PAH",103,1,1,0)="1. This patch changes the Environmental Indicator ENVIRONMENTAL "
^DIC(9.4,127,22,3,"PAH",103,1,2,0)="CONTAMINANTS name to SOUTHWEST ASIA CONDITIONS."
^DIC(9.4,127,22,3,"PAH",103,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",103,1,4,0)="  - The Surgery package data dictionaries for ENVIRONMENTAL CONTAMINANTS "
^DIC(9.4,127,22,3,"PAH",103,1,5,0)="  will be changed to SOUTHWEST ASIA CONDITIONS. The field help text will "
^DIC(9.4,127,22,3,"PAH",103,1,6,0)="  be updated with the new name. Other field cross references will be"
^DIC(9.4,127,22,3,"PAH",103,1,7,0)="  updated with the new name."
^DIC(9.4,127,22,3,"PAH",103,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",103,1,9,0)="  - In user dialog where the mnemonic ""EC:"" is used to display the "
^DIC(9.4,127,22,3,"PAH",103,1,10,0)="  ENVIRONMENTAL CONTAMINANTS the mnemonic ""SWAC:"" will be displayed. The "
^DIC(9.4,127,22,3,"PAH",103,1,11,0)="  user dialog ""Treatment related to Environmental Contaminants (Y/N)"" "
^DIC(9.4,127,22,3,"PAH",103,1,12,0)="  will be changed to ""Treatment related to SW Asia (Y/N)""."
^DIC(9.4,127,22,3,"PAH",103,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",103,1,14,0)="2. This patch modifies the Surgery software to always use a YES default "
^DIC(9.4,127,22,3,"PAH",103,1,15,0)="when initially prompting for ""Treatment related to Combat (Y/N)""."
^DIC(9.4,127,22,3,"PAH",103,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",103,1,17,0)="3. This patch modifies the Surgery software so that when entering or "
^DIC(9.4,127,22,3,"PAH",103,1,18,0)="editing a waiting list entry, service connected and environmental "
^DIC(9.4,127,22,3,"PAH",103,1,19,0)="indicator questions will be asked if appropriate for the patient "
^DIC(9.4,127,22,3,"PAH",103,1,20,0)="regardless of the patient's admission status."
^DIC(9.4,127,22,3,"PAH",104,0)="163 SEQ #157^3071212.210043^1"
^DIC(9.4,127,22,3,"PAH",104,1,0)="^^20^20^3071212"
^DIC(9.4,127,22,3,"PAH",104,1,1,0)="This patch makes changes to the Surgery software following the "
^DIC(9.4,127,22,3,"PAH",104,1,2,0)="installation of patch DG*5.3*757 (SURGICAL SPECIALTY FILE CHANGES) for "
^DIC(9.4,127,22,3,"PAH",104,1,3,0)="the PTF Fields No Longer Needed Project:"
^DIC(9.4,127,22,3,"PAH",104,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",104,1,5,0)="1. The Quarterly Report - Surgical Service [SRO QUARTERLY REPORT] option "
^DIC(9.4,127,22,3,"PAH",104,1,6,0)="is updated to correspond with the codes and specialties that exist in the "
^DIC(9.4,127,22,3,"PAH",104,1,7,0)="updated SURGICAL SPECIALTY file (#45.3)."
^DIC(9.4,127,22,3,"PAH",104,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",104,1,9,0)="2. The functionality that allows the input of preoperative risk "
^DIC(9.4,127,22,3,"PAH",104,1,10,0)="assessment information when entering or updating a surgery request if the "
^DIC(9.4,127,22,3,"PAH",104,1,11,0)="ASK FOR RISK PREOP INFO field (#17) in the SURGERY SITE PARAMETERS file "
^DIC(9.4,127,22,3,"PAH",104,1,12,0)="(#133) is set to YES is updated so that this functionality works "
^DIC(9.4,127,22,3,"PAH",104,1,13,0)="correctly with the updated code for CARDIAC SURGERY in the SURGICAL "
^DIC(9.4,127,22,3,"PAH",104,1,14,0)="SPECIALTY FILE (#45.3)."
^DIC(9.4,127,22,3,"PAH",104,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",104,1,16,0)="3. The logic executed when editing the CASE SCHEDULE TYPE field (#.035) "
^DIC(9.4,127,22,3,"PAH",104,1,17,0)="in the SURGERY file (#130) is updated so that this logic works correctly "
^DIC(9.4,127,22,3,"PAH",104,1,18,0)="with the updated code for CARDIAC SURGERY in the SURGICAL SPECIALTY file "
^DIC(9.4,127,22,3,"PAH",104,1,19,0)="(#45.3) to populate the CARDIAC SURGICAL PRIORITY field (#414) in the "
^DIC(9.4,127,22,3,"PAH",104,1,20,0)="SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",105,0)="164 SEQ #158^3071212.22202^1"
^DIC(9.4,127,22,3,"PAH",105,1,0)="^^25^25^3071212"
^DIC(9.4,127,22,3,"PAH",105,1,1,0)="1. This patch adds the SURGERY CONSULT DATE field (#513) to the SURGERY "
^DIC(9.4,127,22,3,"PAH",105,1,2,0)="file (#130) for use by the Cardiac Risk Assessment module to document the "
^DIC(9.4,127,22,3,"PAH",105,1,3,0)="date that the patient was notified that Surgery was needed, effectively "
^DIC(9.4,127,22,3,"PAH",105,1,4,0)="documenting the start of the patient's wait time. "
^DIC(9.4,127,22,3,"PAH",105,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",105,1,6,0)="2. The Resource Data [SROA CARDIAC RESOURCE] option is updated to include "
^DIC(9.4,127,22,3,"PAH",105,1,7,0)="the SURGERY CONSULT DATE field (#513) for input."
^DIC(9.4,127,22,3,"PAH",105,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",105,1,9,0)="3. The Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] option is "
^DIC(9.4,127,22,3,"PAH",105,1,10,0)="updated to display the SURGERY CONSULT DATE field (#513) when printing a "
^DIC(9.4,127,22,3,"PAH",105,1,11,0)="cardiac risk assessment."
^DIC(9.4,127,22,3,"PAH",105,1,12,0)=" "
^DIC(9.4,127,22,3,"PAH",105,1,13,0)="4. The missing information functionality for cardiac risk assessments is "
^DIC(9.4,127,22,3,"PAH",105,1,14,0)="updated to include the SURGERY CONSULT DATE field (#513) for surgical"
^DIC(9.4,127,22,3,"PAH",105,1,15,0)="cases after September 30, 2007. This functionality is used by the Update"
^DIC(9.4,127,22,3,"PAH",105,1,16,0)="Assessment Status to 'COMPLETE' [SROA COMPLETE ASSESSMENT] option and the"
^DIC(9.4,127,22,3,"PAH",105,1,17,0)="List of Surgery Risk Assessments [SROA ASSESSMENT LIST] option."
^DIC(9.4,127,22,3,"PAH",105,1,18,0)=" "
^DIC(9.4,127,22,3,"PAH",105,1,19,0)="5. The SURGERY CONSULT DATE field (#513) is added to the cardiac risk "
^DIC(9.4,127,22,3,"PAH",105,1,20,0)="assessment transmission data set."
^DIC(9.4,127,22,3,"PAH",105,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",105,1,22,0)="6. This patch adds the WAIT TIME START field (#21) to the SURGERY file "
^DIC(9.4,127,22,3,"PAH",105,1,23,0)="(#130). This field will be auto-populated when the SURGERY CONSULT DATE "
^DIC(9.4,127,22,3,"PAH",105,1,24,0)="field (#513) is entered. There are no plans to build additional functions "
^DIC(9.4,127,22,3,"PAH",105,1,25,0)="for this field at this time.  "
^DIC(9.4,127,22,3,"PAH",106,0)="162 SEQ #159^3080526.154208^1"
^DIC(9.4,127,22,3,"PAH",106,1,0)="^^1^1^3080526"
^DIC(9.4,127,22,3,"PAH",106,1,1,0)="Correct multiple Surgery tickets"
^DIC(9.4,127,22,3,"PAH",107,0)="166 SEQ #160^3080526.160211^1"
^DIC(9.4,127,22,3,"PAH",107,1,0)="^^164^164^3080526"
^DIC(9.4,127,22,3,"PAH",107,1,1,0)="This patch updates the Surgery Risk Assessment software of the Veterans"
^DIC(9.4,127,22,3,"PAH",107,1,2,0)="Health Information Systems and Technology Architecture (VistA) Surgery"
^DIC(9.4,127,22,3,"PAH",107,1,3,0)="application as requested by the Executive Board of the National Surgical"
^DIC(9.4,127,22,3,"PAH",107,1,4,0)="Quality Improvement Program (NSQIP) and by the Cardiac Surgery Consultants"
^DIC(9.4,127,22,3,"PAH",107,1,5,0)="Board of the Continuous Improvement in Cardiac Surgery Program (CICSP)."
^DIC(9.4,127,22,3,"PAH",107,1,6,0)="The updates include the addition of new data fields, changes to existing "
^DIC(9.4,127,22,3,"PAH",107,1,7,0)="data fields, changes to data entry screens, changes to reports used in "
^DIC(9.4,127,22,3,"PAH",107,1,8,0)="Surgery Risk Assessment management process and changes to the Surgery Risk"
^DIC(9.4,127,22,3,"PAH",107,1,9,0)="Assessment transmissions."
^DIC(9.4,127,22,3,"PAH",107,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,11,0)="Non-Cardiac Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",107,1,12,0)="------------------------------------"
^DIC(9.4,127,22,3,"PAH",107,1,13,0)="- List of Surgery Risk Assessment [SROA ASSESSMENT LIST] option"
^DIC(9.4,127,22,3,"PAH",107,1,14,0)="  o When printing the List of Transmitted Assessments to screen or"
^DIC(9.4,127,22,3,"PAH",107,1,15,0)="    printer, the user is prompted to view/print assessed cases only,"
^DIC(9.4,127,22,3,"PAH",107,1,16,0)="    excluded cases only or both. Additionally, the user is prompted to"
^DIC(9.4,127,22,3,"PAH",107,1,17,0)="    view/print the list by date of operation or by date of transmission."
^DIC(9.4,127,22,3,"PAH",107,1,18,0)="  o When printing the List of Eligible Cases to screen or printer, the "
^DIC(9.4,127,22,3,"PAH",107,1,19,0)="    user is prompted to view/print assessed cases only, excluded cases "
^DIC(9.4,127,22,3,"PAH",107,1,20,0)="    only, non-assessed cases only or all cases."
^DIC(9.4,127,22,3,"PAH",107,1,21,0)="  o A new list, the List of Cases With No CPT Codes is added. This list "
^DIC(9.4,127,22,3,"PAH",107,1,22,0)="    displays all completed cases that have not been coded with CPT codes."
^DIC(9.4,127,22,3,"PAH",107,1,23,0)="  o A new list, the Summary List of Assessed Cases is added. This report "
^DIC(9.4,127,22,3,"PAH",107,1,24,0)="    displays the total count of incomplete, complete and transmitted risk"
^DIC(9.4,127,22,3,"PAH",107,1,25,0)="    assessments and the count of excluded cases. This report may be "
^DIC(9.4,127,22,3,"PAH",107,1,26,0)="    printed for all or for selected surgical specialties and for all "
^DIC(9.4,127,22,3,"PAH",107,1,27,0)="    divisions or for a selected division."
^DIC(9.4,127,22,3,"PAH",107,1,28,0)="    "
^DIC(9.4,127,22,3,"PAH",107,1,29,0)="- M&M Verification Report [SRO M&M VERIFICATION REPORT] option"
^DIC(9.4,127,22,3,"PAH",107,1,30,0)="  This report is modified to display additional information as available,"
^DIC(9.4,127,22,3,"PAH",107,1,31,0)="  including the case number, final CPT codes and review of death comments."
^DIC(9.4,127,22,3,"PAH",107,1,32,0)="  "
^DIC(9.4,127,22,3,"PAH",107,1,33,0)="- Clostridium Difficile Colitis (C. difficile) definition updated"
^DIC(9.4,127,22,3,"PAH",107,1,34,0)="  o In the SURGERY file (#130), the description for the CLOSTRIDIUM"
^DIC(9.4,127,22,3,"PAH",107,1,35,0)="    DIFFICILE COLITIS field (#446) is updated."
^DIC(9.4,127,22,3,"PAH",107,1,36,0)="  o In the PERIOPERATIVE OCCURRENCE CATEGORY file (#136.5), the "
^DIC(9.4,127,22,3,"PAH",107,1,37,0)="    description for the CLOSTRIDIUM DIFFICILE COLITIS (C-DIFFICILE)"
^DIC(9.4,127,22,3,"PAH",107,1,38,0)="    category is updated."
^DIC(9.4,127,22,3,"PAH",107,1,39,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,40,0)="- In the SURGERY file (#130), the description for the PREOP FUNCT. HEALTH"
^DIC(9.4,127,22,3,"PAH",107,1,41,0)="  STATUS field (#492) is updated."
^DIC(9.4,127,22,3,"PAH",107,1,42,0)="    "
^DIC(9.4,127,22,3,"PAH",107,1,43,0)="- Risk Model Lab Test (Enter/Edit) [SROA LAB TEST EDIT] option"
^DIC(9.4,127,22,3,"PAH",107,1,44,0)="  This new option is added to the Surgery Risk Assessment Menu [SROA RISK"
^DIC(9.4,127,22,3,"PAH",107,1,45,0)="  ASSESSMENT] to assist the nurse reviewers in mapping entries in the "
^DIC(9.4,127,22,3,"PAH",107,1,46,0)="  RISK MODEL LAB TEST file (#139.2) to the LAB DATA file (#63)."
^DIC(9.4,127,22,3,"PAH",107,1,47,0)="  "
^DIC(9.4,127,22,3,"PAH",107,1,48,0)="- REGIONAL Anesthesia Technique added"
^DIC(9.4,127,22,3,"PAH",107,1,49,0)="  o REGIONAL is added to the list of choices when entering the ANESTHESIA"
^DIC(9.4,127,22,3,"PAH",107,1,50,0)="    TECHNIQUE field (#.37) in the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",107,1,51,0)="  o The Anesthesia AMIS [SROAMIS] option is inactivated and removed from"
^DIC(9.4,127,22,3,"PAH",107,1,52,0)="    the Anesthesia Menu [SROANES1] and from the Anesthesia Reports [SR"
^DIC(9.4,127,22,3,"PAH",107,1,53,0)="    ANESTH REPORTS] menu options."
^DIC(9.4,127,22,3,"PAH",107,1,54,0)="    "
^DIC(9.4,127,22,3,"PAH",107,1,55,0)="- Preoperative Information (Enter/Edit) [SROA PREOP DATA] option updated"
^DIC(9.4,127,22,3,"PAH",107,1,56,0)="  o The following items are no longer required and are removed from the"
^DIC(9.4,127,22,3,"PAH",107,1,57,0)="    input screens:"
^DIC(9.4,127,22,3,"PAH",107,1,58,0)="    > On Page 1, under GENERAL"
^DIC(9.4,127,22,3,"PAH",107,1,59,0)="      E. Pack/Years"
^DIC(9.4,127,22,3,"PAH",107,1,60,0)="      I. Pre-illness Funct Status"
^DIC(9.4,127,22,3,"PAH",107,1,61,0)="    > On Page 2, under CENTRAL NERVOUS SYSTEM"
^DIC(9.4,127,22,3,"PAH",107,1,62,0)="      H. Paraplegia "
^DIC(9.4,127,22,3,"PAH",107,1,63,0)="      I. Quadriplegia"
^DIC(9.4,127,22,3,"PAH",107,1,64,0)="  o The following changes are made relating to the capture of height from"
^DIC(9.4,127,22,3,"PAH",107,1,65,0)="    the Vitals software:"
^DIC(9.4,127,22,3,"PAH",107,1,66,0)="    > The 1 year date range limitation is removed from the height capture "
^DIC(9.4,127,22,3,"PAH",107,1,67,0)="      process so that the most recent height measurement is returned "
^DIC(9.4,127,22,3,"PAH",107,1,68,0)="      regardless of when it was taken."
^DIC(9.4,127,22,3,"PAH",107,1,69,0)="    > If the height capture process returns a height measurement from the "
^DIC(9.4,127,22,3,"PAH",107,1,70,0)="      Vitals software, the date of the measurement will be stored and "
^DIC(9.4,127,22,3,"PAH",107,1,71,0)="      displayed on the data input screen."
^DIC(9.4,127,22,3,"PAH",107,1,72,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,73,0)="- Print a Surgery Risk Assessment [SROA PRINT ASSESSMENT] option"
^DIC(9.4,127,22,3,"PAH",107,1,74,0)="  If the user responds YES to batch printing for a specific date range,"
^DIC(9.4,127,22,3,"PAH",107,1,75,0)="  the user will be allowed to print for a single surgical specialty or for"
^DIC(9.4,127,22,3,"PAH",107,1,76,0)="  all surgical specialties."
^DIC(9.4,127,22,3,"PAH",107,1,77,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,78,0)="- Surgery Consult Dates added"
^DIC(9.4,127,22,3,"PAH",107,1,79,0)="  The Patient Demographics (Enter/Edit) [SROA DEMOGRAPHICS] option is "
^DIC(9.4,127,22,3,"PAH",107,1,80,0)="  updated to include 2 additional date fields:"
^DIC(9.4,127,22,3,"PAH",107,1,81,0)="  o Surgery Consult Date"
^DIC(9.4,127,22,3,"PAH",107,1,82,0)="  o Date Surgery Consult Requested"
^DIC(9.4,127,22,3,"PAH",107,1,83,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,84,0)="Cardiac Assessment Modifications"
^DIC(9.4,127,22,3,"PAH",107,1,85,0)="------------------------------------"
^DIC(9.4,127,22,3,"PAH",107,1,86,0)="- Clinical Information (Enter/Edit) [SROA CLINICAL INFORMATION]"
^DIC(9.4,127,22,3,"PAH",107,1,87,0)="  The HEIGHT field (#236) and the WEIGHT field (#237) will no longer   "
^DIC(9.4,127,22,3,"PAH",107,1,88,0)="  accept an entry of NS for ""No Study"". System will only accept numeric"
^DIC(9.4,127,22,3,"PAH",107,1,89,0)="  values in the field."
^DIC(9.4,127,22,3,"PAH",107,1,90,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,91,0)="- Operative Risk Summary Data (Enter/Edit) [SROA CARDIAC OPERATIVE RISK]"
^DIC(9.4,127,22,3,"PAH",107,1,92,0)="  This option is modified to allow users to enter a value of NS (No Study)"
^DIC(9.4,127,22,3,"PAH",107,1,93,0)="  into the Physician's Preoperative Estimate of Operative Mortality field."
^DIC(9.4,127,22,3,"PAH",107,1,94,0)="  Upon entry of NS, the system will automatically populate the Date/Time"
^DIC(9.4,127,22,3,"PAH",107,1,95,0)="  of Estimate of Operative Mortality field with a value of NS (No Study)."
^DIC(9.4,127,22,3,"PAH",107,1,96,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,97,0)="- Update Assessment Status to 'COMPLETE' [SROA COMPLETE ASSESSMENT] "
^DIC(9.4,127,22,3,"PAH",107,1,98,0)="  This option is modified to list items missing from the assessment based "
^DIC(9.4,127,22,3,"PAH",107,1,99,0)="  upon the order in the field number in SURGERY file (#130). An"
^DIC(9.4,127,22,3,"PAH",107,1,100,0)="  enhancement to this option shall list missing items in the same order as"
^DIC(9.4,127,22,3,"PAH",107,1,101,0)="  the standard assessment screens."
^DIC(9.4,127,22,3,"PAH",107,1,102,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,103,0)="- Cardiac Procedures Operative Data (Enter/Edit) [SROA CARDIAC PROCEDURES]"
^DIC(9.4,127,22,3,"PAH",107,1,104,0)="  The system is modified to initially prompts user to ""Select Operative "
^DIC(9.4,127,22,3,"PAH",107,1,105,0)="  Information to Edit."" A new entry of ""N"" shall allow the user to ""Set"
^DIC(9.4,127,22,3,"PAH",107,1,106,0)="  All to No"" for the 22 Cardiac Procedures fields. A verification prompt"
^DIC(9.4,127,22,3,"PAH",107,1,107,0)="  will follow to ensure that user understands entry."
^DIC(9.4,127,22,3,"PAH",107,1,108,0)="  "
^DIC(9.4,127,22,3,"PAH",107,1,109,0)="  Fields that do not have YES/NO responses will be updated as follows:"
^DIC(9.4,127,22,3,"PAH",107,1,110,0)="    Items #1-#5 are numeric and their values will be set to 0."
^DIC(9.4,127,22,3,"PAH",107,1,111,0)="    #9 Valve Repair will be set to NONE"
^DIC(9.4,127,22,3,"PAH",107,1,112,0)="    #13 Maze Procedure will be set to NO MAZE PERFORMED"
^DIC(9.4,127,22,3,"PAH",107,1,113,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,114,0)="- Laboratory Test Results (Enter/Edit) [SROA LAB-CARDIAC]"
^DIC(9.4,127,22,3,"PAH",107,1,115,0)="  If the lab values entered into the screen are out of range, they will be"
^DIC(9.4,127,22,3,"PAH",107,1,116,0)="  flagged as high or low during data entry."
^DIC(9.4,127,22,3,"PAH",107,1,117,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,118,0)="- Resource Data [SROA CARDIAC RESOURCE]"
^DIC(9.4,127,22,3,"PAH",107,1,119,0)="  o When editing the D/T PATIENT DISCH FROM ICU field (#471), the software"
^DIC(9.4,127,22,3,"PAH",107,1,120,0)="    is modified to provide the user with a select option to allow user to"
^DIC(9.4,127,22,3,"PAH",107,1,121,0)="    pull date/time from existing list of possible entries or manually"
^DIC(9.4,127,22,3,"PAH",107,1,122,0)="    enter a date/time"
^DIC(9.4,127,22,3,"PAH",107,1,123,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,124,0)="  o Postop Extubation Hours"
^DIC(9.4,127,22,3,"PAH",107,1,125,0)="    If the extubation time is entered, the software will display the "
^DIC(9.4,127,22,3,"PAH",107,1,126,0)="    number of hours between the time the patient left the operating room "
^DIC(9.4,127,22,3,"PAH",107,1,127,0)="    and the time the patient was extubated."
^DIC(9.4,127,22,3,"PAH",107,1,128,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,129,0)="  o PRIMARY CAUSE FOR DELAY field (#515)"
^DIC(9.4,127,22,3,"PAH",107,1,130,0)="    If a Cardiac patient's surgery is greater than 30 days from initial VA"
^DIC(9.4,127,22,3,"PAH",107,1,131,0)="    Cardiothoracic Surgery Consultation (as calculated between the CT"
^DIC(9.4,127,22,3,"PAH",107,1,132,0)="    CONSULT DATE to DATE OF SURGERY), user is requested to enter cause as"
^DIC(9.4,127,22,3,"PAH",107,1,133,0)="    defined in the field. If date is less than or equal to 30 days, system"
^DIC(9.4,127,22,3,"PAH",107,1,134,0)="    shall automatically default entry to NONE."
^DIC(9.4,127,22,3,"PAH",107,1,135,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,136,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,137,0)="General Surgery Items"
^DIC(9.4,127,22,3,"PAH",107,1,138,0)="---------------------"
^DIC(9.4,127,22,3,"PAH",107,1,139,0)="1. The following fields in the SURGERY file (#130) are updated to utilize "
^DIC(9.4,127,22,3,"PAH",107,1,140,0)="   VistA Pharmacy supported API's in reference to the DRUG file (#50):"
^DIC(9.4,127,22,3,"PAH",107,1,141,0)="    - MEDICATIONS field (#.01, sub-file #130.33)"
^DIC(9.4,127,22,3,"PAH",107,1,142,0)="    - ANESTHESIA AGENTS field (#.01, sub-file #130.47 of sub-file #130.06)"
^DIC(9.4,127,22,3,"PAH",107,1,143,0)="    - TEST DOSE field (#.01, sub-file #130.48 of sub-file #130.06)"
^DIC(9.4,127,22,3,"PAH",107,1,144,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,145,0)="2. Remedy Ticket #HD0000000203815"
^DIC(9.4,127,22,3,"PAH",107,1,146,0)="   When making an operation request, a site parameter controls whether "
^DIC(9.4,127,22,3,"PAH",107,1,147,0)="   preoperative risk assessment information can be entered. If set to YES,"
^DIC(9.4,127,22,3,"PAH",107,1,148,0)="   there are occasions within two screens delete variables causing an"
^DIC(9.4,127,22,3,"PAH",107,1,149,0)="   undefined error. This patch fixes this problem."
^DIC(9.4,127,22,3,"PAH",107,1,150,0)=" "
^DIC(9.4,127,22,3,"PAH",107,1,151,0)="3. Remedy Ticket #HD0000000231157 "
^DIC(9.4,127,22,3,"PAH",107,1,152,0)="   The problem reported in this Remedy ticket is corrected by this patch."
^DIC(9.4,127,22,3,"PAH",107,1,153,0)="   In the SURGERY file (#130), lookups on the DRUG file (#50) are modified"
^DIC(9.4,127,22,3,"PAH",107,1,154,0)="   to use only the GENERIC NAME field (#.01) and the SYNONYM field (#9)."
^DIC(9.4,127,22,3,"PAH",107,1,155,0)="  "
^DIC(9.4,127,22,3,"PAH",107,1,156,0)="4. The following date/time fields in the SURGERY file (#130) are modified "
^DIC(9.4,127,22,3,"PAH",107,1,157,0)="   to assume a past date if the user enters a date without a year:"
^DIC(9.4,127,22,3,"PAH",107,1,158,0)="   SURGICAL PRIORITY, DATE field (#414.1)"
^DIC(9.4,127,22,3,"PAH",107,1,159,0)="   HOSPITAL ADMISSION DATE field (#418)"
^DIC(9.4,127,22,3,"PAH",107,1,160,0)="   HOSPITAL DISCHARGE DATE field (#419) "
^DIC(9.4,127,22,3,"PAH",107,1,161,0)="   ADMISSION/TRANSFER DATE field (#420)"
^DIC(9.4,127,22,3,"PAH",107,1,162,0)="   DISCHARGE/TRANSFER DATE field (#421)"
^DIC(9.4,127,22,3,"PAH",107,1,163,0)="   OBSERVATION ADMISSION DATE field (#452)"
^DIC(9.4,127,22,3,"PAH",107,1,164,0)="   OBSERVATION DISCHARGE DATE field (#453)"
^DIC(9.4,127,22,3,"PAH",108,0)="169 SEQ #161^3090421.135427^17"
^DIC(9.4,127,22,3,"PAH",108,1,0)="^^4^4^3090421"
^DIC(9.4,127,22,3,"PAH",108,1,1,0)="The CPT EXCLUSIONS file (#137) stores CPT codes that have been identified"
^DIC(9.4,127,22,3,"PAH",108,1,2,0)="by the National Surgical Quality Improvement Program (NSQIP) as procedures"
^DIC(9.4,127,22,3,"PAH",108,1,3,0)="that should not be risk assessed. This patch updates this file with data"
^DIC(9.4,127,22,3,"PAH",108,1,4,0)="for fiscal year 2008."
^DIC(9.4,127,22,3,"PAH",109,0)="168 SEQ #162^3090422.123907^17"
^DIC(9.4,127,22,3,"PAH",109,1,0)="^^74^74^3090422"
^DIC(9.4,127,22,3,"PAH",109,1,1,0)="This patch modifies the Blood Product Verification [SR BLOOD PRODUCT "
^DIC(9.4,127,22,3,"PAH",109,1,2,0)="VERIFICATION] option to accept the manually entered eye-readable code as "
^DIC(9.4,127,22,3,"PAH",109,1,3,0)="well as the scanned bar code for Codabar labels."
^DIC(9.4,127,22,3,"PAH",109,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,6,0)="Associated Remedy Ticket(s):"
^DIC(9.4,127,22,3,"PAH",109,1,7,0)="============================"
^DIC(9.4,127,22,3,"PAH",109,1,8,0)="N/A"
^DIC(9.4,127,22,3,"PAH",109,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,10,0)="New Service Request (NSR):"
^DIC(9.4,127,22,3,"PAH",109,1,11,0)="=========================="
^DIC(9.4,127,22,3,"PAH",109,1,12,0)="N/A"
^DIC(9.4,127,22,3,"PAH",109,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,14,0)="Test Sites:"
^DIC(9.4,127,22,3,"PAH",109,1,15,0)="==========="
^DIC(9.4,127,22,3,"PAH",109,1,16,0)="HEARTLAND-EAST HCS"
^DIC(9.4,127,22,3,"PAH",109,1,17,0)="PHILADELPHIA, PA"
^DIC(9.4,127,22,3,"PAH",109,1,18,0)="SAN DIEGO, CA"
^DIC(9.4,127,22,3,"PAH",109,1,19,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,20,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,21,0)="Documentation Retrieval:"
^DIC(9.4,127,22,3,"PAH",109,1,22,0)="========================"
^DIC(9.4,127,22,3,"PAH",109,1,23,0)="No new documents or changes to existing documents are included in this "
^DIC(9.4,127,22,3,"PAH",109,1,24,0)="patch."
^DIC(9.4,127,22,3,"PAH",109,1,25,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,26,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,27,0)="Installation Instructions:"
^DIC(9.4,127,22,3,"PAH",109,1,28,0)="=========================="
^DIC(9.4,127,22,3,"PAH",109,1,29,0)="This patch can be installed at any time with users on the system."
^DIC(9.4,127,22,3,"PAH",109,1,30,0)="Installation should take less than two minutes."
^DIC(9.4,127,22,3,"PAH",109,1,31,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,32,0)=" 1. Use the INSTALL/CHECK MESSAGE option on the PackMan menu."
^DIC(9.4,127,22,3,"PAH",109,1,33,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,34,0)=" 2. From the Kernel Installation & Distribution System menu, select"
^DIC(9.4,127,22,3,"PAH",109,1,35,0)="    the Installation menu."
^DIC(9.4,127,22,3,"PAH",109,1,36,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,37,0)=" 3. From this menu, you may elect to use the following options (when"
^DIC(9.4,127,22,3,"PAH",109,1,38,0)="    prompted for the INSTALL NAME, enter SR*3.0*168):"
^DIC(9.4,127,22,3,"PAH",109,1,39,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,40,0)="    (a) Backup a Transport Global - this option will create a backup"
^DIC(9.4,127,22,3,"PAH",109,1,41,0)="        message of any routines exported with the patch. It will NOT"
^DIC(9.4,127,22,3,"PAH",109,1,42,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,127,22,3,"PAH",109,1,43,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,44,0)="    (b) Compare Transport Global to Current System - this option will"
^DIC(9.4,127,22,3,"PAH",109,1,45,0)="        allow you to view all changes that will be made when the patch is"
^DIC(9.4,127,22,3,"PAH",109,1,46,0)="        installed. It compares all components of the patch (routines,"
^DIC(9.4,127,22,3,"PAH",109,1,47,0)="        DDs, templates, etc.)."
^DIC(9.4,127,22,3,"PAH",109,1,48,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,49,0)="    (c) Verify Checksums in Transport Global - this option will allow you"
^DIC(9.4,127,22,3,"PAH",109,1,50,0)="        to ensure the integrity of the routines that are in the transport"
^DIC(9.4,127,22,3,"PAH",109,1,51,0)="        global."
^DIC(9.4,127,22,3,"PAH",109,1,52,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,53,0)="    (d) Print Transport Global - this option will allow you to view the"
^DIC(9.4,127,22,3,"PAH",109,1,54,0)="        components of the KIDS build."
^DIC(9.4,127,22,3,"PAH",109,1,55,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,56,0)=" 4. Use the Install Package(s) option and select the package SR*3.0*168."
^DIC(9.4,127,22,3,"PAH",109,1,57,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,58,0)=" 5. When prompted ""Want KIDS to INHIBIT LOGONs during the install? NO//"""
^DIC(9.4,127,22,3,"PAH",109,1,59,0)="    respond NO."
^DIC(9.4,127,22,3,"PAH",109,1,60,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,61,0)=" 6. When prompted ""Want to DISABLE Scheduled options, Menu options, and"
^DIC(9.4,127,22,3,"PAH",109,1,62,0)="    Protocols? NO//"" respond NO."
^DIC(9.4,127,22,3,"PAH",109,1,63,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,64,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,65,0)="Routine Summary:"
^DIC(9.4,127,22,3,"PAH",109,1,66,0)="================"
^DIC(9.4,127,22,3,"PAH",109,1,67,0)="The following is a list of the routine(s) included in this patch. The"
^DIC(9.4,127,22,3,"PAH",109,1,68,0)="second line of each of these routine(s) will look like:"
^DIC(9.4,127,22,3,"PAH",109,1,69,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,70,0)="    <TAB>;;3.0; Surgery ;**[patch list]**;24 Jun 93;Build 2"
^DIC(9.4,127,22,3,"PAH",109,1,71,0)=" "
^DIC(9.4,127,22,3,"PAH",109,1,72,0)=" Routine Name  Before Patch  After Patch  Patch List"
^DIC(9.4,127,22,3,"PAH",109,1,73,0)=" ------------  ------------  -----------  ----------"
^DIC(9.4,127,22,3,"PAH",109,1,74,0)=" SRBL          8388831       8708447      148,168"
^DIC(9.4,127,22,3,"PAH",110,0)="167 SEQ #163^3090422.13035^17"
^DIC(9.4,127,22,3,"PAH",110,1,0)="^^54^54^3090422"
^DIC(9.4,127,22,3,"PAH",110,1,1,0)="This patch adds the Transplant Assessment module to the Surgery software."
^DIC(9.4,127,22,3,"PAH",110,1,2,0)="This enhancement provides the ability to create assessments for lung,"
^DIC(9.4,127,22,3,"PAH",110,1,3,0)="liver, kidney and heart transplants."
^DIC(9.4,127,22,3,"PAH",110,1,4,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,5,0)="A new menu, Transplant Assessment Menu [SR TRANSPLANT ASSESSMENT], is"
^DIC(9.4,127,22,3,"PAH",110,1,6,0)="added to the Surgery Menu [SROMENU] option. This new menu includes the"
^DIC(9.4,127,22,3,"PAH",110,1,7,0)="following four options:"
^DIC(9.4,127,22,3,"PAH",110,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,9,0)=" (1) Enter/Edit Transplant Assessments [SR TRANSPLANT ENTER/EDIT]"
^DIC(9.4,127,22,3,"PAH",110,1,10,0)="     This option is used to enter and update the information required for"
^DIC(9.4,127,22,3,"PAH",110,1,11,0)="     the transplant assessments. This option also allows the assessment"
^DIC(9.4,127,22,3,"PAH",110,1,12,0)="     to be completed and transmitted."
^DIC(9.4,127,22,3,"PAH",110,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,14,0)=" (2) Print Transplant Assessment [SRTP PRINT ASSESSMENT]"
^DIC(9.4,127,22,3,"PAH",110,1,15,0)="     This option is used to print a single Surgery Transplant Assessment."
^DIC(9.4,127,22,3,"PAH",110,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,17,0)=" (3) List of Transplant Assessments [SRTP ASSESSMENT LIST]"
^DIC(9.4,127,22,3,"PAH",110,1,18,0)="     This option is used to print the List of Transplant Assessments. It"
^DIC(9.4,127,22,3,"PAH",110,1,19,0)="     provides summary information for assessments within the sort"
^DIC(9.4,127,22,3,"PAH",110,1,20,0)="     parameters selected."
^DIC(9.4,127,22,3,"PAH",110,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,22,0)=" (4) Transplant Assessment Parameters (Enter/Edit) [SR TRANSPLANT"
^DIC(9.4,127,22,3,"PAH",110,1,23,0)="     PARAMETER]"
^DIC(9.4,127,22,3,"PAH",110,1,24,0)="     This option is used to update local site parameters for the Surgery"
^DIC(9.4,127,22,3,"PAH",110,1,25,0)="     Transplants Assessment module. Sites that are transplant centers must"
^DIC(9.4,127,22,3,"PAH",110,1,26,0)="     designate the types of organ transplants performed or assessed in"
^DIC(9.4,127,22,3,"PAH",110,1,27,0)="     order to streamline the transplant selection process when entering"
^DIC(9.4,127,22,3,"PAH",110,1,28,0)="     data."
^DIC(9.4,127,22,3,"PAH",110,1,29,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,30,0)="- The collected transplant assessments data will be stored in the SURGERY"
^DIC(9.4,127,22,3,"PAH",110,1,31,0)="  TRANSPLANT ASSESSMENTS file (#139.5)."
^DIC(9.4,127,22,3,"PAH",110,1,32,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,33,0)="- Transplant Assessments Transmissions"
^DIC(9.4,127,22,3,"PAH",110,1,34,0)="  When editing an individual transplant assessment, upon leaving the"
^DIC(9.4,127,22,3,"PAH",110,1,35,0)="  final page, the software allows the user to transmit the assessment to"
^DIC(9.4,127,22,3,"PAH",110,1,36,0)="  the national database."
^DIC(9.4,127,22,3,"PAH",110,1,37,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,38,0)="  o The data of the non-cardiac transplant assessments (lung, liver, and"
^DIC(9.4,127,22,3,"PAH",110,1,39,0)="    kidney) will be transmitted to national NSQIP database in Chicago,"
^DIC(9.4,127,22,3,"PAH",110,1,40,0)="    Illinois."
^DIC(9.4,127,22,3,"PAH",110,1,41,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,42,0)="  o The data of the heart transplant assessments (cardiac) will be"
^DIC(9.4,127,22,3,"PAH",110,1,43,0)="    transmitted to national NSQIP database in Chicago, Illinois, as well"
^DIC(9.4,127,22,3,"PAH",110,1,44,0)="    as to national CICSP database in Denver, Colorado."
^DIC(9.4,127,22,3,"PAH",110,1,45,0)=" "
^DIC(9.4,127,22,3,"PAH",110,1,46,0)="- Followup to patch SR*3*169"
^DIC(9.4,127,22,3,"PAH",110,1,47,0)="  This patch includes a pre-installation process that removes the"
^DIC(9.4,127,22,3,"PAH",110,1,48,0)="  following CPT codes from the CPT EXCLUSIONS file (#137) that were"
^DIC(9.4,127,22,3,"PAH",110,1,49,0)="  overlooked in the NSQIP - CPT EXCLUSION update patch for fiscal year"
^DIC(9.4,127,22,3,"PAH",110,1,50,0)="  2008 (SR*3*169)."
^DIC(9.4,127,22,3,"PAH",110,1,51,0)="  "
^DIC(9.4,127,22,3,"PAH",110,1,52,0)="   33945   TRANSPLANTATION OF HEART "
^DIC(9.4,127,22,3,"PAH",110,1,53,0)="   47135   TRANSPLANTATION OF LIVER"
^DIC(9.4,127,22,3,"PAH",110,1,54,0)="   47136   TRANSPLANTATION OF LIVER"
^DIC(9.4,127,22,3,"PAH",111,0)="170 SEQ #164^3091007.110019^17"
^DIC(9.4,127,22,3,"PAH",111,1,0)="^^29^29^3091007"
^DIC(9.4,127,22,3,"PAH",111,1,1,0)="This patch addresses one minor issue, updates the CPT Exclusion List for "
^DIC(9.4,127,22,3,"PAH",111,1,2,0)="NSQIP, and modifies a data element collected by NSQIP and CICSP. Each is "
^DIC(9.4,127,22,3,"PAH",111,1,3,0)="explained in more detail."
^DIC(9.4,127,22,3,"PAH",111,1,4,0)="  "
^DIC(9.4,127,22,3,"PAH",111,1,5,0)="1. The Health Insurance Portability and Accessibility Act (HIPAA) "
^DIC(9.4,127,22,3,"PAH",111,1,6,0)="stipulated that diagnostic and procedure codes and terms used for billing "
^DIC(9.4,127,22,3,"PAH",111,1,7,0)="purposes must be the codes and terms that were applicable at the time the "
^DIC(9.4,127,22,3,"PAH",111,1,8,0)="service was provided."
^DIC(9.4,127,22,3,"PAH",111,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",111,1,10,0)="In October 2003, under the Code Set Versioning Project, the code names,"
^DIC(9.4,127,22,3,"PAH",111,1,11,0)="descriptions, inactive flags and dates were replaced by versioned data"
^DIC(9.4,127,22,3,"PAH",111,1,12,0)="elements, each with an effective date of use. Additionally, VA software"
^DIC(9.4,127,22,3,"PAH",111,1,13,0)="packages who utilize the ICD/CPT files were provided with Code Set"
^DIC(9.4,127,22,3,"PAH",111,1,14,0)="Application Programmer Interfaces (APIs) to retrieve the new data and"
^DIC(9.4,127,22,3,"PAH",111,1,15,0)="instructed to discontinue the use of the old un-versioned data elements."
^DIC(9.4,127,22,3,"PAH",111,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",111,1,17,0)="This patch modifies the routine SROCMPED to make use of one of the Code "
^DIC(9.4,127,22,3,"PAH",111,1,18,0)="Set APIs to retrieve and display versioned data."
^DIC(9.4,127,22,3,"PAH",111,1,19,0)=" "
^DIC(9.4,127,22,3,"PAH",111,1,20,0)="2. The CPT EXCLUSIONS file (#137) stores CPT codes that have been  "
^DIC(9.4,127,22,3,"PAH",111,1,21,0)="identified by the National Surgical Quality Improvement Program (NSQIP) as"
^DIC(9.4,127,22,3,"PAH",111,1,22,0)="procedures that should not be risk assessed. This patch updates this file"
^DIC(9.4,127,22,3,"PAH",111,1,23,0)="with data for fiscal year 2009."
^DIC(9.4,127,22,3,"PAH",111,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",111,1,25,0)="3. The lower range for HEIGHT field (#236) in the SURGERY file (#130)"
^DIC(9.4,127,22,3,"PAH",111,1,26,0)="collected by the National Surgical Quality Improvement Program (NSQIP) and"
^DIC(9.4,127,22,3,"PAH",111,1,27,0)="Continuous Improvement in Cardiac Surgery Program (CICSP) has been lowered"
^DIC(9.4,127,22,3,"PAH",111,1,28,0)="to account for post amputation height of patients with both legs"
^DIC(9.4,127,22,3,"PAH",111,1,29,0)="amputated."
^DIC(9.4,127,22,3,"PAH",112,0)="171 SEQ #165^3100510.144458^17"
^DIC(9.4,127,22,3,"PAH",112,1,0)="^^10^10^3100510"
^DIC(9.4,127,22,3,"PAH",112,1,1,0)="There are two fixes in this patch: The first issue concerns an"
^DIC(9.4,127,22,3,"PAH",112,1,2,0)="UNDEFINED error occurring when trying to enter a DISCHARGE"
^DIC(9.4,127,22,3,"PAH",112,1,3,0)="FROM PACU (DPACU) time that is earlier than the PATIENT IN ROOM"
^DIC(9.4,127,22,3,"PAH",112,1,4,0)="(PIR) time even though the date is for the next day under the"
^DIC(9.4,127,22,3,"PAH",112,1,5,0)="OPERATION INFORMATION option of the NON-CARDIAC ASSESSMENT"
^DIC(9.4,127,22,3,"PAH",112,1,6,0)="INFORMATION. The second issue is under the same NON-CARDIAC "
^DIC(9.4,127,22,3,"PAH",112,1,7,0)="ASSESSMENT INFORMATION option OPERATION INFORMATION and an "
^DIC(9.4,127,22,3,"PAH",112,1,8,0)="UNDEFINED error is being generated due to an expected variable"
^DIC(9.4,127,22,3,"PAH",112,1,9,0)="DA(1) not being set. This prevents users from being able to enter "
^DIC(9.4,127,22,3,"PAH",112,1,10,0)="a PRINC. ANESTHESIA TECHNIQUE for their patients."
^DIC(9.4,127,22,3,"PAH",113,0)="174 SEQ #166^3101115.104502^17"
^DIC(9.4,127,22,3,"PAH",113,1,0)="^^119^119^3101115"
^DIC(9.4,127,22,3,"PAH",113,1,1,0)="This patch provides the annual updates to the Veterans Health Information "
^DIC(9.4,127,22,3,"PAH",113,1,2,0)="Systems and Technology Architecture (VistA) Surgery package in support of"
^DIC(9.4,127,22,3,"PAH",113,1,3,0)="the VA Surgery Quality Improvement Program (VASQIP). The updates include"
^DIC(9.4,127,22,3,"PAH",113,1,4,0)="the addition of new data fields, changes to existing fields, changes to "
^DIC(9.4,127,22,3,"PAH",113,1,5,0)="data entry screens, changes to reports, and changes to the Surgery Risk "
^DIC(9.4,127,22,3,"PAH",113,1,6,0)="Assessment transmissions."
^DIC(9.4,127,22,3,"PAH",113,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,8,0)="Non-Cardiac Assessment Modifications:"
^DIC(9.4,127,22,3,"PAH",113,1,9,0)="-------------------------------------"
^DIC(9.4,127,22,3,"PAH",113,1,10,0)="- The frequency of transmission of 1-liner cases is changed from the 45th "
^DIC(9.4,127,22,3,"PAH",113,1,11,0)="  day past the end of the quarter to the 45th day past the end of the"
^DIC(9.4,127,22,3,"PAH",113,1,12,0)="  month."
^DIC(9.4,127,22,3,"PAH",113,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,14,0)="- Patient gender is added to the information transmitted on 1-liner cases."
^DIC(9.4,127,22,3,"PAH",113,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,16,0)="- New fields added to SURGERY file (#130):"
^DIC(9.4,127,22,3,"PAH",113,1,17,0)="  o ASSESSMENT COMPLETED BY field (#272.1)"
^DIC(9.4,127,22,3,"PAH",113,1,18,0)="    When a non-cardiac assessment is completed, the user who completed the"
^DIC(9.4,127,22,3,"PAH",113,1,19,0)="    assessment will be identified in this field and the name of the user "
^DIC(9.4,127,22,3,"PAH",113,1,20,0)="    will be transmitted with the assessment."
^DIC(9.4,127,22,3,"PAH",113,1,21,0)="  o PREOPERATIVE SLEEP APNEA field (#237.1)"
^DIC(9.4,127,22,3,"PAH",113,1,22,0)="    This field is added to the Preoperative Information (Enter/Edit) [SROA"
^DIC(9.4,127,22,3,"PAH",113,1,23,0)="    PREOP DATA] option, the assessment printout, assessment transmission"
^DIC(9.4,127,22,3,"PAH",113,1,24,0)="    and the list of missing items functionality."
^DIC(9.4,127,22,3,"PAH",113,1,25,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,26,0)="- The SURGERY CONSULT DATE field (#513) and the SURGERY CONSULT REQUESTED "
^DIC(9.4,127,22,3,"PAH",113,1,27,0)="  field (#516) are eliminated as non-cardiac assessment variables."
^DIC(9.4,127,22,3,"PAH",113,1,28,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,29,0)="- This patch updates the CPT EXCLUSIONS file (#137) with data for fiscal "
^DIC(9.4,127,22,3,"PAH",113,1,30,0)="  year 2010."
^DIC(9.4,127,22,3,"PAH",113,1,31,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,32,0)="- Field descriptions are modified in the following fields in SURGERY file "
^DIC(9.4,127,22,3,"PAH",113,1,33,0)="  (#130):"
^DIC(9.4,127,22,3,"PAH",113,1,34,0)="  o HEIGHT field (#236)"
^DIC(9.4,127,22,3,"PAH",113,1,35,0)="    The description and the input transform are modified."
^DIC(9.4,127,22,3,"PAH",113,1,36,0)="  o WEIGHT field (#237)"
^DIC(9.4,127,22,3,"PAH",113,1,37,0)="    The description and the input transform are modified."
^DIC(9.4,127,22,3,"PAH",113,1,38,0)="  o HISTORY OF COPD field (#203)"
^DIC(9.4,127,22,3,"PAH",113,1,39,0)="  o ASCITES field (#212)"
^DIC(9.4,127,22,3,"PAH",113,1,40,0)="  o DISSEMINATED CANCER (Y/N) field (#338)"
^DIC(9.4,127,22,3,"PAH",113,1,41,0)="  o INTRAOP DISSEMINATED CANCER field (#443)"
^DIC(9.4,127,22,3,"PAH",113,1,42,0)="  o BLEEDING DISORDERS field (#216)"
^DIC(9.4,127,22,3,"PAH",113,1,43,0)="  o OTHER PROCEDURE field (#.01 of OTHER PROCEDURES multiple field #.42)"
^DIC(9.4,127,22,3,"PAH",113,1,44,0)="  o INTRAOPERATIVE ASCITES field (#446)"
^DIC(9.4,127,22,3,"PAH",113,1,45,0)="  o DVT/THROMBOPHLEBITIS field (#263)"
^DIC(9.4,127,22,3,"PAH",113,1,46,0)="    Note: The description of DVT/THROMBOPHLEBITIS in the PERIOPERATIVE "
^DIC(9.4,127,22,3,"PAH",113,1,47,0)="    OCCURRENCE CATEGORY file (#136.5) is updated as well."
^DIC(9.4,127,22,3,"PAH",113,1,48,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,49,0)="- On the Operation Information (Enter/Edit) [SROA OPERATION DATA] option:"
^DIC(9.4,127,22,3,"PAH",113,1,50,0)="  o When selecting item #3, CPT Codes (view only), the following note is "
^DIC(9.4,127,22,3,"PAH",113,1,51,0)="    added to the screen:"
^DIC(9.4,127,22,3,"PAH",113,1,52,0)="       CPT Codes should be verified. If need be, report discrepancies to"
^DIC(9.4,127,22,3,"PAH",113,1,53,0)="       the official CPT coder for surgery."
^DIC(9.4,127,22,3,"PAH",113,1,54,0)="  o When selecting item #5, Concurrent Procedure, the following note is "
^DIC(9.4,127,22,3,"PAH",113,1,55,0)="    added to the screen:"
^DIC(9.4,127,22,3,"PAH",113,1,56,0)="       Concurrent Procedure: An additional operative procedure performed"
^DIC(9.4,127,22,3,"PAH",113,1,57,0)="       by different surgical team (i.e., a different specialty/service)"
^DIC(9.4,127,22,3,"PAH",113,1,58,0)="       under the same anesthetic which has a CPT code different from that"
^DIC(9.4,127,22,3,"PAH",113,1,59,0)="       of the Principal Operative Procedure (e.g., fixation of a femur"
^DIC(9.4,127,22,3,"PAH",113,1,60,0)="       fracture in a patient undergoing a laparotomy for trauma). This"
^DIC(9.4,127,22,3,"PAH",113,1,61,0)="       field should be verified and, if need be, report discrepancies to"
^DIC(9.4,127,22,3,"PAH",113,1,62,0)="       the official CPT coder for surgery."
^DIC(9.4,127,22,3,"PAH",113,1,63,0)="       "
^DIC(9.4,127,22,3,"PAH",113,1,64,0)="- A new entry, N - NONE ASSIGNED, is added to the ASA CLASS file (#132.8)."
^DIC(9.4,127,22,3,"PAH",113,1,65,0)="  The output transform on ASA CLASS field (#1.13) in SURGERY file (#130)"
^DIC(9.4,127,22,3,"PAH",113,1,66,0)="  is modified to allow the display of the new entry."
^DIC(9.4,127,22,3,"PAH",113,1,67,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,68,0)="- The list of missing items functionality is updated to remove deleted "
^DIC(9.4,127,22,3,"PAH",113,1,69,0)="  variables and to include the new variables."
^DIC(9.4,127,22,3,"PAH",113,1,70,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,71,0)="Cardiac Assessment Modifications:"
^DIC(9.4,127,22,3,"PAH",113,1,72,0)="---------------------------------"
^DIC(9.4,127,22,3,"PAH",113,1,73,0)="- The SURGERY CONSULT DATE field (#513) and the PRIMARY CAUSE FOR DELAY "
^DIC(9.4,127,22,3,"PAH",113,1,74,0)="  field (#515) are eliminated as cardiac assessment variables."
^DIC(9.4,127,22,3,"PAH",113,1,75,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,76,0)="- New fields added to SURGERY file (#130) as new cardiac variables:"
^DIC(9.4,127,22,3,"PAH",113,1,77,0)="  o PREOP ATRIAL FIBRILLATION field (#509)"
^DIC(9.4,127,22,3,"PAH",113,1,78,0)="    This field is added to the Clinical Information (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",113,1,79,0)="    CLINICAL INFORMATION] option."
^DIC(9.4,127,22,3,"PAH",113,1,80,0)="  o PULMONARY VALVE PROCEDURE field (#493)"
^DIC(9.4,127,22,3,"PAH",113,1,81,0)="    This field is added to the Cardiac Procedures Operative Data "
^DIC(9.4,127,22,3,"PAH",113,1,82,0)="    (Enter/Edit) [SROA CARDIAC PROCEDURES] option."
^DIC(9.4,127,22,3,"PAH",113,1,83,0)="  o BNP field (#507)"
^DIC(9.4,127,22,3,"PAH",113,1,84,0)="    This field is added to the Laboratory Test Results (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",113,1,85,0)="    LAB-CARDIAC] option."
^DIC(9.4,127,22,3,"PAH",113,1,86,0)="  o BNP DATE field (#507.1)"
^DIC(9.4,127,22,3,"PAH",113,1,87,0)="    This field is added to the Laboratory Test Results (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",113,1,88,0)="    LAB-CARDIAC] option."
^DIC(9.4,127,22,3,"PAH",113,1,89,0)="  o POSTOP ATRIAL FIBRILLATION field (#448)"
^DIC(9.4,127,22,3,"PAH",113,1,90,0)="    This field is added to the Outcome Information (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",113,1,91,0)="    CARDIAC-OUTCOMES] option. Associated with this yes/no field is a new "
^DIC(9.4,127,22,3,"PAH",113,1,92,0)="    entry, POSTOPERATIVE ATRIAL FIBRILLATION, in the PERIOPERATIVE "
^DIC(9.4,127,22,3,"PAH",113,1,93,0)="    OCCURRENCE CATEGORY file (#136.5)."
^DIC(9.4,127,22,3,"PAH",113,1,94,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,95,0)="- The following fields in SURGERY file (#130) are modified:"
^DIC(9.4,127,22,3,"PAH",113,1,96,0)="  o AORTIC VALVE PROCEDURE field (#367)"
^DIC(9.4,127,22,3,"PAH",113,1,97,0)="  o MITRAL VALVE PROCEDURE field (#368)"
^DIC(9.4,127,22,3,"PAH",113,1,98,0)="  o TRICUSPID VALVE PROCEDURE field (#369)"
^DIC(9.4,127,22,3,"PAH",113,1,99,0)="  o FUNCTIONAL HEALTH STATUS field (#240)"
^DIC(9.4,127,22,3,"PAH",113,1,100,0)="  o PREOP CIRCULATORY DEVICE field (#474)"
^DIC(9.4,127,22,3,"PAH",113,1,101,0)="  o ENDOVASCULAR REPAIR field (#505)"
^DIC(9.4,127,22,3,"PAH",113,1,102,0)="  o D/T PATIENT DISCH FROM ICU field (#471)"
^DIC(9.4,127,22,3,"PAH",113,1,103,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,104,0)="- Corrections are made to the list of missing items functionality for the"
^DIC(9.4,127,22,3,"PAH",113,1,105,0)="  following fields in the SURGERY file (#130):"
^DIC(9.4,127,22,3,"PAH",113,1,106,0)="  o ANGINA field (#267)"
^DIC(9.4,127,22,3,"PAH",113,1,107,0)="  o CONVERT FROM OFF PUMP TO CPB field (#469)"
^DIC(9.4,127,22,3,"PAH",113,1,108,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,109,0)="- TIME OPERATION BEGAN field (#.22) and TIME OPERATION ENDS field (#.23) "
^DIC(9.4,127,22,3,"PAH",113,1,110,0)="  are moved from the Operative Risk Summary Data (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",113,1,111,0)="  CARDIAC OPERATIVE RISK] option to the Resource Data [SROA CARDIAC"
^DIC(9.4,127,22,3,"PAH",113,1,112,0)="  RESOURCE] option."
^DIC(9.4,127,22,3,"PAH",113,1,113,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,114,0)="- The list of missing items functionality is updated to remove deleted "
^DIC(9.4,127,22,3,"PAH",113,1,115,0)="  variables and to include the new variables."
^DIC(9.4,127,22,3,"PAH",113,1,116,0)=" "
^DIC(9.4,127,22,3,"PAH",113,1,117,0)="- The SURGERY CONSULT DATE field (#513) and the PRIMARY CAUSE FOR"
^DIC(9.4,127,22,3,"PAH",113,1,118,0)="  DELAY field (#515) are removed from the Resource Data [SROA CARDIAC "
^DIC(9.4,127,22,3,"PAH",113,1,119,0)="  RESOURCE] option."
^DIC(9.4,127,22,3,"PAH",114,0)="165 SEQ #167^3101118.113742^17"
^DIC(9.4,127,22,3,"PAH",114,1,0)="^^13^13^3101118"
^DIC(9.4,127,22,3,"PAH",114,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,127,22,3,"PAH",114,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",114,1,3,0)="1.  HD194156 - Input transform for CPT Modifier 51 in Surgery"
^DIC(9.4,127,22,3,"PAH",114,1,4,0)="The Lexicon package has been working to update the CPT code ranges for "
^DIC(9.4,127,22,3,"PAH",114,1,5,0)="the CPT Modifier 51. Part of this update is to include all Surgical "
^DIC(9.4,127,22,3,"PAH",114,1,6,0)="Procedures with the exception of those listed in Appendix E of the CPT"
^DIC(9.4,127,22,3,"PAH",114,1,7,0)="Manual.  During the analysis phase for this project, it was discovered "
^DIC(9.4,127,22,3,"PAH",114,1,8,0)="that this unique CPT Modifier carries with it the stipulation that it "
^DIC(9.4,127,22,3,"PAH",114,1,9,0)="can not be used in conjunction with the principal procedure."
^DIC(9.4,127,22,3,"PAH",114,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",114,1,11,0)="2.  HD238998 - FGH - service block issue on 5th week of month"
^DIC(9.4,127,22,3,"PAH",114,1,12,0)="When a monthly service block is set for a day in the 4th week, users are"
^DIC(9.4,127,22,3,"PAH",114,1,13,0)="unable to set a service block for that day in the 5th week of a month."
^DIC(9.4,127,22,3,"PAH",115,0)="175 SEQ #168^3110822.112141^17"
^DIC(9.4,127,22,3,"PAH",115,1,0)="^^188^188^3110822"
^DIC(9.4,127,22,3,"PAH",115,1,1,0)="This patch provides the VASQIP 2011 Increment 1 to the Veterans Health"
^DIC(9.4,127,22,3,"PAH",115,1,2,0)="Information Systems and Technology Architecture (VistA) Surgery package in"
^DIC(9.4,127,22,3,"PAH",115,1,3,0)="support of the VA Surgery Quality Improvement Program (VASQIP). The"
^DIC(9.4,127,22,3,"PAH",115,1,4,0)="updates include the addition of new data fields, changes to existing"
^DIC(9.4,127,22,3,"PAH",115,1,5,0)="fields, changes to data entry screens, changes to reports, changes to the"
^DIC(9.4,127,22,3,"PAH",115,1,6,0)="Surgery Risk Assessment transmissions, and changes to Transplant"
^DIC(9.4,127,22,3,"PAH",115,1,7,0)="components of the VistA Surgery application."
^DIC(9.4,127,22,3,"PAH",115,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,10,0)="I. General Surgery Updates:"
^DIC(9.4,127,22,3,"PAH",115,1,11,0)="--------------------------"
^DIC(9.4,127,22,3,"PAH",115,1,12,0)="1. All options under the Quarterly Report Menu [SROQ MENU] are retired"
^DIC(9.4,127,22,3,"PAH",115,1,13,0)="   except the Admissions Within 14 Days of Outpatient Surgery [SROQADM]"
^DIC(9.4,127,22,3,"PAH",115,1,14,0)="   option, the Report of Missing Quarterly Report Data [SROQ MISSING DATA]"
^DIC(9.4,127,22,3,"PAH",115,1,15,0)="   option and Deaths Within 30 Days of Surgery [SROQD], which are"
^DIC(9.4,127,22,3,"PAH",115,1,16,0)="   relocated under the Management Reports [SRO-CHIEF REPORTS] menu."
^DIC(9.4,127,22,3,"PAH",115,1,17,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,18,0)="2. Remove references to ""NSQIP"" and ""CICSP"" in field labels and field "
^DIC(9.4,127,22,3,"PAH",115,1,19,0)="   definitions. When the text is not in the header of a definition, the "
^DIC(9.4,127,22,3,"PAH",115,1,20,0)="   terms ""NSQIP"" and ""CICSP"" are replaced with ""VASQIP""."
^DIC(9.4,127,22,3,"PAH",115,1,21,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,22,0)="   The complete list of these fields is listed in the Release Notes "
^DIC(9.4,127,22,3,"PAH",115,1,23,0)="   manual."
^DIC(9.4,127,22,3,"PAH",115,1,24,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,25,0)="3. Addition of Scheduling Date fields"
^DIC(9.4,127,22,3,"PAH",115,1,26,0)="   The following new fields are added to the SURGERY file (#130):"
^DIC(9.4,127,22,3,"PAH",115,1,27,0)="  - ORIGINAL DESIRED PROCEDURE DATE field (#612)"
^DIC(9.4,127,22,3,"PAH",115,1,28,0)="  - D/T OF DESIRED PROCEDURE DATE ENTRY field (#613)"
^DIC(9.4,127,22,3,"PAH",115,1,29,0)="  - ORIGINAL SCHEDULED DATE field (#614)"
^DIC(9.4,127,22,3,"PAH",115,1,30,0)="  - D/T OF SCHEDULED DATE ENTRY field (#615)"
^DIC(9.4,127,22,3,"PAH",115,1,31,0)="  - DESIRED PROCEDURE DATE field (#616)"
^DIC(9.4,127,22,3,"PAH",115,1,32,0)="  - SCHEDULED DATE field (#617)"
^DIC(9.4,127,22,3,"PAH",115,1,33,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,34,0)="4. Add Time Out Verified Utilizing Checklist"
^DIC(9.4,127,22,3,"PAH",115,1,35,0)=" (a) The following new fields are added to the SURGERY file (#130):"
^DIC(9.4,127,22,3,"PAH",115,1,36,0)="   - CONFIRM PATIENT IDENTITY field (#600)"
^DIC(9.4,127,22,3,"PAH",115,1,37,0)="   - PROCEDURE TO BE PERFORMED field (#601)"
^DIC(9.4,127,22,3,"PAH",115,1,38,0)="   - SITE OF PROCEDURE field (#602)"
^DIC(9.4,127,22,3,"PAH",115,1,39,0)="   - VALID CONSENT FORM field (#603)"
^DIC(9.4,127,22,3,"PAH",115,1,40,0)="   - CONFIRM PATIENT POSITION field (#604)"
^DIC(9.4,127,22,3,"PAH",115,1,41,0)="   - MARKED SITE CONFIRMED field (#605)"
^DIC(9.4,127,22,3,"PAH",115,1,42,0)="   - PREOPERATIVE IMAGES CONFIRMED field (#606)"
^DIC(9.4,127,22,3,"PAH",115,1,43,0)="   - CORRECT MEDICAL IMPLANTS field (#607)"
^DIC(9.4,127,22,3,"PAH",115,1,44,0)="   - ANTIBIOTIC PROPHYLAXIS field (#608)"
^DIC(9.4,127,22,3,"PAH",115,1,45,0)="   - APPROPRIATE DVT PROPHYLAXIS field (#609)"
^DIC(9.4,127,22,3,"PAH",115,1,46,0)="   - BLOOD AVAILABILITY field (#610)"
^DIC(9.4,127,22,3,"PAH",115,1,47,0)="   - AVAILABILITY OF SPECIAL EQUIP field (#611)"
^DIC(9.4,127,22,3,"PAH",115,1,48,0)="   - CHECKLIST COMMENT field (#85)"
^DIC(9.4,127,22,3,"PAH",115,1,49,0)="     "
^DIC(9.4,127,22,3,"PAH",115,1,50,0)=" (b) The VALID ID/CONSENT CONFIRMED BY field (#.69) has been renamed to"
^DIC(9.4,127,22,3,"PAH",115,1,51,0)="     CHECKLIST CONFIRMED BY."
^DIC(9.4,127,22,3,"PAH",115,1,52,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,53,0)=" (c) All the above new fields are added to the new Time Out Verified"
^DIC(9.4,127,22,3,"PAH",115,1,54,0)="     Utilizing Checklist option [SROMEN-VERF], which has been added to the"
^DIC(9.4,127,22,3,"PAH",115,1,55,0)="     Operation Menu [SROPER]."
^DIC(9.4,127,22,3,"PAH",115,1,56,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,57,0)=" (d) The existing ensuring correct surgery fields (MARKED SITE CONFIRMED"
^DIC(9.4,127,22,3,"PAH",115,1,58,0)="     field (#73), PREOPERATIVE IMAGING CONFIRMED field (#72), TIME OUT"
^DIC(9.4,127,22,3,"PAH",115,1,59,0)="     VERIFIED field (#71), MARKED SITE COMMENTS field (#84), IMAGING"
^DIC(9.4,127,22,3,"PAH",115,1,60,0)="     CONFIRMED COMMENTS field (#83), TIME OUT VERIFIED COMMENTS field "
^DIC(9.4,127,22,3,"PAH",115,1,61,0)="     (#82), and VALID ID/CONSENT CONFIRMED BY field (#.69)) will be"
^DIC(9.4,127,22,3,"PAH",115,1,62,0)="     removed from the following Operation Menu options:"
^DIC(9.4,127,22,3,"PAH",115,1,63,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,64,0)="     - Operation Startup [SROMEN-START]"
^DIC(9.4,127,22,3,"PAH",115,1,65,0)="     - Operation [SROMEN-OP]"
^DIC(9.4,127,22,3,"PAH",115,1,66,0)="     - Operation (Short Screen) [SROMEN-OUT]"
^DIC(9.4,127,22,3,"PAH",115,1,67,0)="     - Nurse Intraoperative Report [SRONRPT]"
^DIC(9.4,127,22,3,"PAH",115,1,68,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,69,0)=" (e) The existing ensuring correct surgery fields in the Nurse"
^DIC(9.4,127,22,3,"PAH",115,1,70,0)="     Intraoperative Report are replaced with the new Time Out Verified"
^DIC(9.4,127,22,3,"PAH",115,1,71,0)="     Utilizing Checklist fields (the fields listed in item ""a"" and ""b"" of"
^DIC(9.4,127,22,3,"PAH",115,1,72,0)="     this section are added)."
^DIC(9.4,127,22,3,"PAH",115,1,73,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,74,0)="5. OR Cancellation Report"
^DIC(9.4,127,22,3,"PAH",115,1,75,0)="  - The pre-existing reasons have been inactivated and will not be "
^DIC(9.4,127,22,3,"PAH",115,1,76,0)="    editable but can be viewed."
^DIC(9.4,127,22,3,"PAH",115,1,77,0)="  - A new selection list for Cancellation Reasons has been added."
^DIC(9.4,127,22,3,"PAH",115,1,78,0)="  - The SURGERY CANCELLATION REASON file (#135) will be locked with "
^DIC(9.4,127,22,3,"PAH",115,1,79,0)="    this patch so it will no longer be editable at sites."
^DIC(9.4,127,22,3,"PAH",115,1,80,0)="  - The Update Site Configurable Files [SR UPDATE FILES] option has been "
^DIC(9.4,127,22,3,"PAH",115,1,81,0)="    updated to remove the Surgery Cancellation Reasons from the Site "
^DIC(9.4,127,22,3,"PAH",115,1,82,0)="    Configurable Files."
^DIC(9.4,127,22,3,"PAH",115,1,83,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,84,0)="6. The CPT Code Exclusion list for 2011 has been updated so that the"
^DIC(9.4,127,22,3,"PAH",115,1,85,0)="   surgical package can accurately calculate the VASQIP eligible list"
^DIC(9.4,127,22,3,"PAH",115,1,86,0)="   (affecting the CPT EXCLUSIONS file (#137) and the Workload Report/List"
^DIC(9.4,127,22,3,"PAH",115,1,87,0)="   #9)."
^DIC(9.4,127,22,3,"PAH",115,1,88,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,89,0)="7. Two pre-existing fields for the SURGERY file (#130), PRINC"
^DIC(9.4,127,22,3,"PAH",115,1,90,0)="   ANESTHETIST field (#.31) and ANESTHESIOLOGIST SUPVR field (#.34), have"
^DIC(9.4,127,22,3,"PAH",115,1,91,0)="   been added to the Non-OR Procedure report."
^DIC(9.4,127,22,3,"PAH",115,1,92,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,93,0)="8. This patch updates the Anesthesia Report and the Nurse Intraoperative"
^DIC(9.4,127,22,3,"PAH",115,1,94,0)="   Report to display values of less than 1 for the fields below with a"
^DIC(9.4,127,22,3,"PAH",115,1,95,0)="   leading zero in reports they are displayed."
^DIC(9.4,127,22,3,"PAH",115,1,96,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,97,0)="   - DOSE field (#1) of the MEDICATIONS multiple (#130.33)"
^DIC(9.4,127,22,3,"PAH",115,1,98,0)="   - TIME ADM field (#1) of the TIME ADM multiple (#130.34)"
^DIC(9.4,127,22,3,"PAH",115,1,99,0)="   - DOSE field (#1) and the ANESTHESIA AGENTS field (#.01) of the"
^DIC(9.4,127,22,3,"PAH",115,1,100,0)="     ANESTHESIA AGENTS Multiple (#130.47) of the ANESTHESIA TECHNIQUE"
^DIC(9.4,127,22,3,"PAH",115,1,101,0)="     Multiple (#130.06)"
^DIC(9.4,127,22,3,"PAH",115,1,102,0)="   - DOSE field (#.1) of the TEST DOSE Multiple (#130.48) of the"
^DIC(9.4,127,22,3,"PAH",115,1,103,0)="     ANESTHESIA TECHNIQUE Multiple (#130.06)"
^DIC(9.4,127,22,3,"PAH",115,1,104,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,105,0)="9. The Clean Wound Infection Summary Report is updated to include"
^DIC(9.4,127,22,3,"PAH",115,1,106,0)="   the ORGAN/SPACE SSI field (#488) in the algorithm for calculating the"
^DIC(9.4,127,22,3,"PAH",115,1,107,0)="   clean wound infection rates. For cardiac assessed cases, "
^DIC(9.4,127,22,3,"PAH",115,1,108,0)="   ENDOCARDITIS field (#386) and MEDIASTINITIS field (#388) will be"
^DIC(9.4,127,22,3,"PAH",115,1,109,0)="   included in the algorithm for calculating the clean wound infection"
^DIC(9.4,127,22,3,"PAH",115,1,110,0)="   rates."
^DIC(9.4,127,22,3,"PAH",115,1,111,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,112,0)="10. The Perioperative Occurrences Report, under the Morbidity & Mortality "
^DIC(9.4,127,22,3,"PAH",115,1,113,0)="    Reports [SROMM] option, will be modified to allow three selections as "
^DIC(9.4,127,22,3,"PAH",115,1,114,0)="    follows:"
^DIC(9.4,127,22,3,"PAH",115,1,115,0)="        1-Intraoperative Occurrences"
^DIC(9.4,127,22,3,"PAH",115,1,116,0)="        2-Postoperative Occurrences "
^DIC(9.4,127,22,3,"PAH",115,1,117,0)="        3-Intraoperative and Postoperative Occurrences "
^DIC(9.4,127,22,3,"PAH",115,1,118,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,119,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,120,0)="II. Non-Cardiac Module Updates:"
^DIC(9.4,127,22,3,"PAH",115,1,121,0)="--------------------------------"
^DIC(9.4,127,22,3,"PAH",115,1,122,0)="1. A new 30 DAY DEATH field (#342.1) has been added to the"
^DIC(9.4,127,22,3,"PAH",115,1,123,0)="   SURGERY file (#130). This field is added to the Patient "
^DIC(9.4,127,22,3,"PAH",115,1,124,0)="   Demographics (Enter/Edit) [SROA DEMOGRAPHICS] option and it will "
^DIC(9.4,127,22,3,"PAH",115,1,125,0)="   indicate operative death has occurred within 30 days of surgery. This"
^DIC(9.4,127,22,3,"PAH",115,1,126,0)="   field will be auto populated based on an entry into the DATE OF DEATH "
^DIC(9.4,127,22,3,"PAH",115,1,127,0)="   field (#342). If Date of Death occurs within 30 days or less of"
^DIC(9.4,127,22,3,"PAH",115,1,128,0)="   the date in the DATE OF OPERATION field (#.09), then this field is"
^DIC(9.4,127,22,3,"PAH",115,1,129,0)="   automatically updated to ""Yes"" when the Date of Death is saved. If the"
^DIC(9.4,127,22,3,"PAH",115,1,130,0)="   Date of Death is greater than 30 days from the Date of Operation then"
^DIC(9.4,127,22,3,"PAH",115,1,131,0)="   this field is automatically updated to ""No"" when the Date of Death is"
^DIC(9.4,127,22,3,"PAH",115,1,132,0)="   saved."
^DIC(9.4,127,22,3,"PAH",115,1,133,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,134,0)="2. The data dictionary of the PREOPERATIVE SLEEP APNEA field (#237.1)"
^DIC(9.4,127,22,3,"PAH",115,1,135,0)="   of the SURGERY file (#130) has been changed to allow for an entry of"
^DIC(9.4,127,22,3,"PAH",115,1,136,0)="   ""N"" for ""NONE"" on the Preoperative Information (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",115,1,137,0)="   [SROA PREOP DATA] option. "
^DIC(9.4,127,22,3,"PAH",115,1,138,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,139,0)="3. Update the printed Assessment to now include the field ASSESSMENT"
^DIC(9.4,127,22,3,"PAH",115,1,140,0)="   COMPLETED BY field (#272.1) of the SURGERY file (#130)."
^DIC(9.4,127,22,3,"PAH",115,1,141,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,142,0)="                                                            "
^DIC(9.4,127,22,3,"PAH",115,1,143,0)="III. Cardiac Module Updates:"
^DIC(9.4,127,22,3,"PAH",115,1,144,0)="---------------------------"
^DIC(9.4,127,22,3,"PAH",115,1,145,0)="1. The field name ""Myectomy for IHSS"" is changed to ""Myectomy"" in the"
^DIC(9.4,127,22,3,"PAH",115,1,146,0)="   option for the Cardiac Procedures Operative Data (Enter/Edit)"
^DIC(9.4,127,22,3,"PAH",115,1,147,0)="   [SROA CARDIAC PROCEDURES] option and the the Print Assessment Report."
^DIC(9.4,127,22,3,"PAH",115,1,148,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,149,0)="2. The data dictionary of the BRIDGE TO TRANSPLANT/DEVICE field"
^DIC(9.4,127,22,3,"PAH",115,1,150,0)="   (#481) is modified from the current values of ""Yes"" and ""No"" to ""None"","
^DIC(9.4,127,22,3,"PAH",115,1,151,0)="   ""Bridge to Transplant"", and ""Destination Therapy"""
^DIC(9.4,127,22,3,"PAH",115,1,152,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,153,0)="3. The existing field, WOUND CLASSIFICATION (#1.09), is added to the"
^DIC(9.4,127,22,3,"PAH",115,1,154,0)="   Operative Risk Summary Data (Enter/Edit) [SROA CARDIAC OPERATIVE RISK] "
^DIC(9.4,127,22,3,"PAH",115,1,155,0)="   option. This field has been added to the Cardiac Print Assessment"
^DIC(9.4,127,22,3,"PAH",115,1,156,0)="   Report."
^DIC(9.4,127,22,3,"PAH",115,1,157,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,158,0)="4. The current WOUND DISRUPTION field (#404) of the Surgery file (#130)"
^DIC(9.4,127,22,3,"PAH",115,1,159,0)="   is added to the Outcome Information (Enter/Edit)[SROA CARDIAC-OUTCOMES]"
^DIC(9.4,127,22,3,"PAH",115,1,160,0)="   option. This information will appear on the Printed Assessment"
^DIC(9.4,127,22,3,"PAH",115,1,161,0)="   Report and added to the Cardiac Transmission."
^DIC(9.4,127,22,3,"PAH",115,1,162,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,163,0)="5. The Clinical Information (Enter/Edit)[SROA CLINICAL INFORMATION] option"
^DIC(9.4,127,22,3,"PAH",115,1,164,0)="   is updated to allow a response of ""N"" or ""NO"" at the prompt to update"
^DIC(9.4,127,22,3,"PAH",115,1,165,0)="   all the fields to a negative value except Height, Weight, FEV1, "
^DIC(9.4,127,22,3,"PAH",115,1,166,0)="   Functional Status, Angina, and CHF."
^DIC(9.4,127,22,3,"PAH",115,1,167,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,168,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,169,0)="IV. Transplant Module Updates:"
^DIC(9.4,127,22,3,"PAH",115,1,170,0)="-------------------------------"
^DIC(9.4,127,22,3,"PAH",115,1,171,0)="1. HLA Typing fields in the SURGERY TRANSPLANT ASSESSMENTS file (#139.5)"
^DIC(9.4,127,22,3,"PAH",115,1,172,0)="   across all four organ types are updated to allow entry of 4 digits "
^DIC(9.4,127,22,3,"PAH",115,1,173,0)="   (#,#,#,#). The Transplant Transmission is also updated."
^DIC(9.4,127,22,3,"PAH",115,1,174,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,175,0)="2. The C-PEPTIDE AT TIME OF LISTING field (#136) of the SURGERY "
^DIC(9.4,127,22,3,"PAH",115,1,176,0)="   TRANSPLANT ASSESSMENTS file (#139.5) has been changed to allow for a"
^DIC(9.4,127,22,3,"PAH",115,1,177,0)="   value less than 1. When the value is less than 1, it will be displayed"
^DIC(9.4,127,22,3,"PAH",115,1,178,0)="   with a leading zero (i.e., 0.6). "
^DIC(9.4,127,22,3,"PAH",115,1,179,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,180,0)="3. The POST-TX PROPHYLAXIS - TB field (#92) of the SURGERY TRANSPLANT"
^DIC(9.4,127,22,3,"PAH",115,1,181,0)="   ASSESSMENTS file (#139.5) has been updated to allow a value to be"
^DIC(9.4,127,22,3,"PAH",115,1,182,0)="   entered of ""N/A"". This information is added to the Transmission."
^DIC(9.4,127,22,3,"PAH",115,1,183,0)=" "
^DIC(9.4,127,22,3,"PAH",115,1,184,0)="4. The COLD ISCHEMIA TIME FOR ORGAN field (#87) and WARM ISCHEMIA TIME FOR"
^DIC(9.4,127,22,3,"PAH",115,1,185,0)="   ORGAN field (#85) of the SURGERY TRANSPLANT ASSESSMENTS file (#139.5)"
^DIC(9.4,127,22,3,"PAH",115,1,186,0)="   has been added to page #1 of the Enter/Edit Transplant Assessments [SR"
^DIC(9.4,127,22,3,"PAH",115,1,187,0)="   TRANSPLANT ENTER/EDIT] option and to the Print Transplant Assessment"
^DIC(9.4,127,22,3,"PAH",115,1,188,0)="   [SRTP PRINT ASSESSMENT] option for VA and Non-VA heart transplants."
^DIC(9.4,127,22,3,"PAH",116,0)="176 SEQ #169^3120829.111441^17"
^DIC(9.4,127,22,3,"PAH",116,1,0)="^^130^130^3120829"
^DIC(9.4,127,22,3,"PAH",116,1,1,0)="In support of the VA Surgery Quality Improvement Program (VASQIP), this "
^DIC(9.4,127,22,3,"PAH",116,1,2,0)="patch provides the VASQIP Increment 2 update to the Veterans Health "
^DIC(9.4,127,22,3,"PAH",116,1,3,0)="Information Systems and Technology Architecture (VistA) Surgery package."
^DIC(9.4,127,22,3,"PAH",116,1,4,0)="The updates include the addition of new data fields, changes to existing"
^DIC(9.4,127,22,3,"PAH",116,1,5,0)="fields, changes to data entry screens, changes to reports, changes to the"
^DIC(9.4,127,22,3,"PAH",116,1,6,0)="Surgery Risk Assessment transmissions, and changes to transplant"
^DIC(9.4,127,22,3,"PAH",116,1,7,0)="components of the VistA Surgery application."
^DIC(9.4,127,22,3,"PAH",116,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,9,0)=" 1. Surgery Cancellation Modifications"
^DIC(9.4,127,22,3,"PAH",116,1,10,0)="   a. Surgery cancellation functionality is modified so that any surgery "
^DIC(9.4,127,22,3,"PAH",116,1,11,0)="      case that is placed on the surgery schedule and then cancelled will "
^DIC(9.4,127,22,3,"PAH",116,1,12,0)="      be retained in the SURGERY file (#130) as a cancelled case"
^DIC(9.4,127,22,3,"PAH",116,1,13,0)="      regardless of when the case is cancelled. Also, a cancellation"
^DIC(9.4,127,22,3,"PAH",116,1,14,0)="      reason is required for every cancellation. Any scheduled case that"
^DIC(9.4,127,22,3,"PAH",116,1,15,0)="      is cancelled will be counted as a cancellation on the Report of"
^DIC(9.4,127,22,3,"PAH",116,1,16,0)="      Cancellations generated by the Report of Cancellations [SROCAN]"
^DIC(9.4,127,22,3,"PAH",116,1,17,0)="      option."
^DIC(9.4,127,22,3,"PAH",116,1,18,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,19,0)="   b. The Report of Cancellations, generated by the Report of "
^DIC(9.4,127,22,3,"PAH",116,1,20,0)="      Cancellations [SROCAN] option, is modified to group patient data "
^DIC(9.4,127,22,3,"PAH",116,1,21,0)="      together within specialty so that all cases for a single patient"
^DIC(9.4,127,22,3,"PAH",116,1,22,0)="      will be shown together. The report will also order based on "
^DIC(9.4,127,22,3,"PAH",116,1,23,0)="      operations so the same operation descriptions will show next to each"
^DIC(9.4,127,22,3,"PAH",116,1,24,0)="      other for the same patient.  "
^DIC(9.4,127,22,3,"PAH",116,1,25,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,26,0)=" 2. Miscellaneous Additions to Risk Assessment Transmissions"
^DIC(9.4,127,22,3,"PAH",116,1,27,0)="   a. The name of the operating room as defined in the HOSPITAL LOCATION "
^DIC(9.4,127,22,3,"PAH",116,1,28,0)="      file (#44) is added to each cardiac and non-cardiac risk assessment "
^DIC(9.4,127,22,3,"PAH",116,1,29,0)="      transmission and to each 1-liner case transmission."
^DIC(9.4,127,22,3,"PAH",116,1,30,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,31,0)="   b. The following four fields in the SURGERY file (#130) are added to"
^DIC(9.4,127,22,3,"PAH",116,1,32,0)="      each 1-liner case transmission and to the list of items checked for"
^DIC(9.4,127,22,3,"PAH",116,1,33,0)="      by the List of 1-Liner Cases Missing Information which is one of the"
^DIC(9.4,127,22,3,"PAH",116,1,34,0)="      reports generated by the List of Surgery Risk Assessments [SROA"
^DIC(9.4,127,22,3,"PAH",116,1,35,0)="      ASSESSMENT LIST] option:"
^DIC(9.4,127,22,3,"PAH",116,1,36,0)="       - TIME OPERATION BEGAN (#.22)"
^DIC(9.4,127,22,3,"PAH",116,1,37,0)="       - TIME OPERATION ENDS (#.23)"
^DIC(9.4,127,22,3,"PAH",116,1,38,0)="       - TIME PAT IN OR (#.205)"
^DIC(9.4,127,22,3,"PAH",116,1,39,0)="       - TIME PAT OUT OR (#.232)"
^DIC(9.4,127,22,3,"PAH",116,1,40,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,41,0)=" 3. Positive Drug Screening"
^DIC(9.4,127,22,3,"PAH",116,1,42,0)="    A new POSITIVE DRUG SCREENING  field (#618) is added to the SURGERY "
^DIC(9.4,127,22,3,"PAH",116,1,43,0)="    file (#130). This field is added to the Preoperative Information "
^DIC(9.4,127,22,3,"PAH",116,1,44,0)="    (Enter/Edit)[SROA PREOP DATA] option, the Clinical Information "
^DIC(9.4,127,22,3,"PAH",116,1,45,0)="    (Enter/Edit)[SROA CLINICAL INFORMATION] option and the Print a Surgery"
^DIC(9.4,127,22,3,"PAH",116,1,46,0)="    Risk Assessment [SROA PRINT ASSESSMENT] option. This field is also"
^DIC(9.4,127,22,3,"PAH",116,1,47,0)="    added to the cardiac and non-cardiac risk assessment transmissions and"
^DIC(9.4,127,22,3,"PAH",116,1,48,0)="    is added to the list of missing items functionality."
^DIC(9.4,127,22,3,"PAH",116,1,49,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,50,0)=" 4. Consolidation of Shared Cardiac, Non-Cardiac and Transplant Fields"
^DIC(9.4,127,22,3,"PAH",116,1,51,0)="    This patch updates various fields in the SURGERY file (#130) and in"
^DIC(9.4,127,22,3,"PAH",116,1,52,0)="    the SURGERY TRANSPLANT ASSESSMENTS file (#139.5) as well as various"
^DIC(9.4,127,22,3,"PAH",116,1,53,0)="    occurrence category descriptions in the PERIOPERATIVE OCCURRENCE"
^DIC(9.4,127,22,3,"PAH",116,1,54,0)="    CATEGORY file (#136.5) so that common items share common definitions."
^DIC(9.4,127,22,3,"PAH",116,1,55,0)="    This patch also replaces various fields with new fields in order to"
^DIC(9.4,127,22,3,"PAH",116,1,56,0)="    enhance and refine certain data elements that are in common with"
^DIC(9.4,127,22,3,"PAH",116,1,57,0)="    cardiac and non-cardiac risk assessments and transplant assessments."
^DIC(9.4,127,22,3,"PAH",116,1,58,0)="    All the associated data input options, assessment printouts and"
^DIC(9.4,127,22,3,"PAH",116,1,59,0)="    transmissions are updated accordingly."
^DIC(9.4,127,22,3,"PAH",116,1,60,0)="    "
^DIC(9.4,127,22,3,"PAH",116,1,61,0)="    The complete list of updated fields, new fields and replaced "
^DIC(9.4,127,22,3,"PAH",116,1,62,0)="    fields is in the patch release notes."
^DIC(9.4,127,22,3,"PAH",116,1,63,0)="    "
^DIC(9.4,127,22,3,"PAH",116,1,64,0)=" 5. Add Serial Number for Prosthesis Items"
^DIC(9.4,127,22,3,"PAH",116,1,65,0)="     - Two new fields, LOT NUMBER (#11) and SERIAL NUMBER (#12) are "
^DIC(9.4,127,22,3,"PAH",116,1,66,0)="       added to the PROSTHESIS INSTALLED multiple field (#.47, sub-file "
^DIC(9.4,127,22,3,"PAH",116,1,67,0)="       #130.01) to replace the existing LOT/SERIAL NO field (#2.5). The "
^DIC(9.4,127,22,3,"PAH",116,1,68,0)="       Operation [SROMEN-OP] option and the Nurse Intraoperative Report "
^DIC(9.4,127,22,3,"PAH",116,1,69,0)="       [SRONRPT] option are updated to allow editing and display of these"
^DIC(9.4,127,22,3,"PAH",116,1,70,0)="       two new fields."
^DIC(9.4,127,22,3,"PAH",116,1,71,0)="     - LOT NUMBER field (#8) and SERIAL NUMBER field (#9) are added to"
^DIC(9.4,127,22,3,"PAH",116,1,72,0)="       the PROSTHESIS file (#131.9). The Update Site Configurable Files"
^DIC(9.4,127,22,3,"PAH",116,1,73,0)="       [SR UPDATE FILES] option is modified to allow editing of these new"
^DIC(9.4,127,22,3,"PAH",116,1,74,0)="       fields and to disallow editing of the LOT/SERIAL NO field (#4) and"
^DIC(9.4,127,22,3,"PAH",116,1,75,0)="       the STERILE CODE field (#3)."
^DIC(9.4,127,22,3,"PAH",116,1,76,0)="       "
^DIC(9.4,127,22,3,"PAH",116,1,77,0)=" 6. Flash Sterilization"
^DIC(9.4,127,22,3,"PAH",116,1,78,0)="    Six new fields are added to the SURGERY file (#130) to document the"
^DIC(9.4,127,22,3,"PAH",116,1,79,0)="    number of episodes of each type of flash sterilization that happened"
^DIC(9.4,127,22,3,"PAH",116,1,80,0)="    for an operation:"
^DIC(9.4,127,22,3,"PAH",116,1,81,0)="     - FLASH-CONTAMINATION (#619)"
^DIC(9.4,127,22,3,"PAH",116,1,82,0)="     - FLASH-SPD/OR MGT ISSUE (#620)"
^DIC(9.4,127,22,3,"PAH",116,1,83,0)="     - FLASH-EMERGENCY CASE (#621)"
^DIC(9.4,127,22,3,"PAH",116,1,84,0)="     - FLASH-NO BETTER OPTION (#622)"
^DIC(9.4,127,22,3,"PAH",116,1,85,0)="     - FLASH-LOANER INSTRUMENT (#623)"
^DIC(9.4,127,22,3,"PAH",116,1,86,0)="     - FLASH-DECONTAMINATION (#624)"
^DIC(9.4,127,22,3,"PAH",116,1,87,0)="       "
^DIC(9.4,127,22,3,"PAH",116,1,88,0)="    The Post Operation [SROMEN-POST] option and the Nurse Intraoperative"
^DIC(9.4,127,22,3,"PAH",116,1,89,0)="    Report [SRONRPT] option are updated to allow editing and display of"
^DIC(9.4,127,22,3,"PAH",116,1,90,0)="    these two new fields."
^DIC(9.4,127,22,3,"PAH",116,1,91,0)="    "
^DIC(9.4,127,22,3,"PAH",116,1,92,0)=" 7. 30-Day Readmission"
^DIC(9.4,127,22,3,"PAH",116,1,93,0)="    This patch creates a transmission report that lists inpatient "
^DIC(9.4,127,22,3,"PAH",116,1,94,0)="    surgery cases which were followed by the patient being readmitted "
^DIC(9.4,127,22,3,"PAH",116,1,95,0)="    within 30 days of discharge. This report is run by the Surgery "
^DIC(9.4,127,22,3,"PAH",116,1,96,0)="    Nightly Cleanup and Updates [SRTASK-NIGHT] option and will transmit to"
^DIC(9.4,127,22,3,"PAH",116,1,97,0)="    the VASQIP database automatically each quarter."
^DIC(9.4,127,22,3,"PAH",116,1,98,0)="    "
^DIC(9.4,127,22,3,"PAH",116,1,99,0)=" 8. Update ICD9 to ICD"
^DIC(9.4,127,22,3,"PAH",116,1,100,0)="    References to ICD9 are replaced with ICD in the following menu "
^DIC(9.4,127,22,3,"PAH",116,1,101,0)="    options:"
^DIC(9.4,127,22,3,"PAH",116,1,102,0)="     - CPT/ICD9 Coding Menu [SRCODING MENU]"
^DIC(9.4,127,22,3,"PAH",116,1,103,0)="     - CPT/ICD9 Update/Verify Menu [SRCODING UPDATE/VERIFY MENU]"
^DIC(9.4,127,22,3,"PAH",116,1,104,0)="     - Update/verify Procedure/Diagnosis Codes [SRCODING EDIT]"
^DIC(9.4,127,22,3,"PAH",116,1,105,0)="    "
^DIC(9.4,127,22,3,"PAH",116,1,106,0)=" 9. Remove Quarterly Report References"
^DIC(9.4,127,22,3,"PAH",116,1,107,0)="   a. References to ""Quarterly Report"" are removed from the Deaths Within"
^DIC(9.4,127,22,3,"PAH",116,1,108,0)="      30 Days of Surgery [SROQD] option."
^DIC(9.4,127,22,3,"PAH",116,1,109,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,110,0)="   b. The routines that provided the Surgery Quarterly Report"
^DIC(9.4,127,22,3,"PAH",116,1,111,0)="      functionality are removed. Those routines are SROQ1, SROQ1A, SROQ2,"
^DIC(9.4,127,22,3,"PAH",116,1,112,0)="      SROQM, SROQM0, SROQM1 and SROQT."
^DIC(9.4,127,22,3,"PAH",116,1,113,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,114,0)="10. Add Superficial Incisional SSI to Cardiac Outcomes"
^DIC(9.4,127,22,3,"PAH",116,1,115,0)="    The SUPERFICIAL INCISIONAL SSI field (#248) in the SURGERY file "
^DIC(9.4,127,22,3,"PAH",116,1,116,0)="    (#130) is added to the Outcome Information (Enter/Edit) [SROA "
^DIC(9.4,127,22,3,"PAH",116,1,117,0)="    CARDIAC-OUTCOMES] option, the cardiac assessment transmission and to "
^DIC(9.4,127,22,3,"PAH",116,1,118,0)="    the cardiac assessment printout."
^DIC(9.4,127,22,3,"PAH",116,1,119,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,120,0)="11. The following routines associated with obsolete functionality are "
^DIC(9.4,127,22,3,"PAH",116,1,121,0)="    removed: SROAC, SROAC1, SROAC2, SROACCR, SROACRC, SROACS, SROASWAP,"
^DIC(9.4,127,22,3,"PAH",116,1,122,0)="    SROASWP, SROASWP0, SROASWP1, SROASWP2, SROAWSP3, SROASWPD, SRSLOOK,"
^DIC(9.4,127,22,3,"PAH",116,1,123,0)="    and SRSLOOK1."
^DIC(9.4,127,22,3,"PAH",116,1,124,0)="    "
^DIC(9.4,127,22,3,"PAH",116,1,125,0)="12. This patch fixes the issue reported by Remedy ticket #528445, where "
^DIC(9.4,127,22,3,"PAH",116,1,126,0)="    the PREOPERATIVE IMAGES CONFIRMED field (#606) displays the same data"
^DIC(9.4,127,22,3,"PAH",116,1,127,0)="    as MARKED SITE CONFIRMED field (#605)."
^DIC(9.4,127,22,3,"PAH",116,1,128,0)=" "
^DIC(9.4,127,22,3,"PAH",116,1,129,0)="13. This patch updates the CPT EXCLUSIONS file (#137) with data for "
^DIC(9.4,127,22,3,"PAH",116,1,130,0)="    fiscal year 2012."
^DIC(9.4,127,22,3,"PAH",117,0)="173 SEQ #170^3120829.120231^17"
^DIC(9.4,127,22,3,"PAH",117,1,0)="^^9^9^3120829"
^DIC(9.4,127,22,3,"PAH",117,1,1,0)=" "
^DIC(9.4,127,22,3,"PAH",117,1,2,0)="This patch addresses the following issues:"
^DIC(9.4,127,22,3,"PAH",117,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",117,1,4,0)="(1) Users are receiving an UNDEFINED error at SRHLXTMP+7^SRHLXTMP when"
^DIC(9.4,127,22,3,"PAH",117,1,5,0)="their system runs the nightly task SRTASK-NIGHT option. (2) A user "
^DIC(9.4,127,22,3,"PAH",117,1,6,0)="reported that addendums created in VistA are not always being "
^DIC(9.4,127,22,3,"PAH",117,1,7,0)="transmitted to CPRS. The reason being it appears that TIU BUSINESS RULES"
^DIC(9.4,127,22,3,"PAH",117,1,8,0)="for certain document types or user classes are being created which can"
^DIC(9.4,127,22,3,"PAH",117,1,9,0)="cause unforeseen issues."
^DIC(9.4,127,22,3,"PAH",118,0)="177 SEQ #172^3140818.120311^17"
^DIC(9.4,127,22,3,"PAH",118,1,0)="^^22^22^3140818"
^DIC(9.4,127,22,3,"PAH",118,1,1,0)="The International Classification of Diseases, Tenth Revision (ICD-10) "
^DIC(9.4,127,22,3,"PAH",118,1,2,0)="Class 1 Software Remediation project replaces the 30-year-old set of "
^DIC(9.4,127,22,3,"PAH",118,1,3,0)="diagnosis and procedure codes (ICD-9-CM) that medical personnel use. "
^DIC(9.4,127,22,3,"PAH",118,1,4,0)="Dates of service, or dates of discharge for inpatients, that occur on or "
^DIC(9.4,127,22,3,"PAH",118,1,5,0)="after October 10, 2013 will use the ICD-10 code set. Clinical Modification"
^DIC(9.4,127,22,3,"PAH",118,1,6,0)="(ICD-10-CM) diagnosis codes increase from about 13,000 ICD-9 codes to "
^DIC(9.4,127,22,3,"PAH",118,1,7,0)="more than 68,000. Procedure Coding System (ICD-10-PCS) procedure codes "
^DIC(9.4,127,22,3,"PAH",118,1,8,0)="increase from about 3,800 ICD-9 codes to nearly 87,000. Both systems also "
^DIC(9.4,127,22,3,"PAH",118,1,9,0)="expand the number of characters allotted to seven alpha-numeric "
^DIC(9.4,127,22,3,"PAH",118,1,10,0)="characters. This value does not include the decimal point, which follows "
^DIC(9.4,127,22,3,"PAH",118,1,11,0)="the third character for the ICD-10-CM code set. There is no decimal point "
^DIC(9.4,127,22,3,"PAH",118,1,12,0)="in the ICD-10-PCS code set. "
^DIC(9.4,127,22,3,"PAH",118,1,13,0)="These code sets have the potential to reveal more about quality of care, "
^DIC(9.4,127,22,3,"PAH",118,1,14,0)="so that data can be used in a more meaningful way to better understand "
^DIC(9.4,127,22,3,"PAH",118,1,15,0)="complications, better design clinically robust algorithms, and better "
^DIC(9.4,127,22,3,"PAH",118,1,16,0)="track the outcomes of care. ICD-10-CM also incorporates greater "
^DIC(9.4,127,22,3,"PAH",118,1,17,0)="specificity and clinical detail to provide information for clinical "
^DIC(9.4,127,22,3,"PAH",118,1,18,0)="decision making and outcomes research."
^DIC(9.4,127,22,3,"PAH",118,1,19,0)=" "
^DIC(9.4,127,22,3,"PAH",118,1,20,0)="The only noticeable difference users may see will occur when a specific "
^DIC(9.4,127,22,3,"PAH",118,1,21,0)="ICD diagnosis code descriptor changes based on the date of operation for "
^DIC(9.4,127,22,3,"PAH",118,1,22,0)="the case."
^DIC(9.4,127,22,3,"PAH",119,0)="178 SEQ #173^3141031.155619^17"
^DIC(9.4,127,22,3,"PAH",119,1,0)="^^19^19^3141031"
^DIC(9.4,127,22,3,"PAH",119,1,1,0)="  This patch will correct the following issues currently occurring in"
^DIC(9.4,127,22,3,"PAH",119,1,2,0)="  the VistA Surgery application:"
^DIC(9.4,127,22,3,"PAH",119,1,3,0)=" "
^DIC(9.4,127,22,3,"PAH",119,1,4,0)="  In the Surgery option Exclusion Criteria (Enter/Edit) [SR NO"
^DIC(9.4,127,22,3,"PAH",119,1,5,0)="  ASSESSMENT REASON] when users try to enter exclusion criteria"
^DIC(9.4,127,22,3,"PAH",119,1,6,0)="  beginning with 'EXCEEDS' at the 'Reason an Assessment was not"
^DIC(9.4,127,22,3,"PAH",119,1,7,0)="  Created:' prompt, the response 'EXCEEDS MAX ASSMNTS' is always"
^DIC(9.4,127,22,3,"PAH",119,1,8,0)="  always displaying no matter what the user has entered/selected."
^DIC(9.4,127,22,3,"PAH",119,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",119,1,10,0)="  Next, the FIELD field (#2) for the ATTENDING CODE entry of the Surgery"
^DIC(9.4,127,22,3,"PAH",119,1,11,0)="  Interface Parameter file (#133.2) points to the ATTENDING CODE field"
^DIC(9.4,127,22,3,"PAH",119,1,12,0)="  (#.165) of the SURGERY file (#130) which is no longer used.  It should"
^DIC(9.4,127,22,3,"PAH",119,1,13,0)="  point to ATTENDING CODE field (#.166) of the SURGERY file."
^DIC(9.4,127,22,3,"PAH",119,1,14,0)=" "
^DIC(9.4,127,22,3,"PAH",119,1,15,0)=" "
^DIC(9.4,127,22,3,"PAH",119,1,16,0)="  Finally, when printing the 'LONG' form version of an operation request"
^DIC(9.4,127,22,3,"PAH",119,1,17,0)="  for a particular surgical specialty in the Operation Requests for a"
^DIC(9.4,127,22,3,"PAH",119,1,18,0)="  Day [SROP REQ] option in the Surgery Menu, a site noticed the Case"
^DIC(9.4,127,22,3,"PAH",119,1,19,0)="  Order number is not displaying correctly."
^DIC(9.4,127,22,3,"PAH",120,0)="182 SEQ #174^3150106.114915^17"
^DIC(9.4,127,22,3,"PAH",120,1,0)="^^2^2^3150106"
^DIC(9.4,127,22,3,"PAH",120,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,127,22,3,"PAH",120,1,2,0)="under SR*3*182."
^DIC(9.4,127,22,3,"PAH",121,0)="184 SEQ #175^3160108.115302^54"
^DIC(9.4,127,22,3,"PAH",121,1,0)="^^2^2^3160108"
^DIC(9.4,127,22,3,"PAH",121,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,127,22,3,"PAH",121,1,2,0)="under SR*3*184."
^DIC(9.4,127,22,3,"PAH",122,0)="185 SEQ #176^3160323.115357^54"
^DIC(9.4,127,22,3,"PAH",122,1,0)="^^11^11^3160323"
^DIC(9.4,127,22,3,"PAH",122,1,1,0)="The patch addresses two (2) issues:"
^DIC(9.4,127,22,3,"PAH",122,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",122,1,3,0)="1.   During transmission of Surgery Risk Assessments, an UNDEF error "
^DIC(9.4,127,22,3,"PAH",122,1,4,0)="     occurs when routine SROATMNO calls routine ADM1^SROAPIMS without"
^DIC(9.4,127,22,3,"PAH",122,1,5,0)="     initializing the needed local variable SRSOUT."
^DIC(9.4,127,22,3,"PAH",122,1,6,0)=" "
^DIC(9.4,127,22,3,"PAH",122,1,7,0)="2.   Routines that generate the Report of Non-O.R. Procedures [SRONOR]"
^DIC(9.4,127,22,3,"PAH",122,1,8,0)="     need to be modified to recognize recent modifications to the "
^DIC(9.4,127,22,3,"PAH",122,1,9,0)="     IN/OUT-PATIENT field (#.011) in the SURGERY FILE (#130): three (3)"
^DIC(9.4,127,22,3,"PAH",122,1,10,0)="     values have been added to the SET of allowable choices (""1"" FOR "
^DIC(9.4,127,22,3,"PAH",122,1,11,0)="     SAME DAY, ""2"" FOR ADMISSION, ""3"" FOR HOSPITALIZED)."
^DIC(9.4,127,22,3,"PAH",123,0)="186 SEQ #177^3160504.12533^54"
^DIC(9.4,127,22,3,"PAH",123,1,0)="^^12^12^3160504"
^DIC(9.4,127,22,3,"PAH",123,1,1,0)="The patch addresses two (2) issues:"
^DIC(9.4,127,22,3,"PAH",123,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",123,1,3,0)="1.   When a user edits the PROSTHESIS INSTALLED data for a completed"
^DIC(9.4,127,22,3,"PAH",123,1,4,0)="     surgery case using the Operation option [SROMEN-OP] of the"
^DIC(9.4,127,22,3,"PAH",123,1,5,0)="     Operation Menu option [SROPER] of the Surgery Menu option"
^DIC(9.4,127,22,3,"PAH",123,1,6,0)="     [SROMENU] and answers ""NO"" when prompted to create an addendum,"
^DIC(9.4,127,22,3,"PAH",123,1,7,0)="     an application error occurs."
^DIC(9.4,127,22,3,"PAH",123,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",123,1,9,0)="2.   When a user edits Surgery Flag Interface Fields and enters a"
^DIC(9.4,127,22,3,"PAH",123,1,10,0)="     caret (""^"") to escape the edit session prior to completion, the"
^DIC(9.4,127,22,3,"PAH",123,1,11,0)="     application erroneously adds a field delimiter to the selected"
^DIC(9.4,127,22,3,"PAH",123,1,12,0)="     category record in the SURGERY INTERFACE PARAMETER File (#133.2)."
^DIC(9.4,127,22,3,"PAH",124,0)="188 SEQ #178^3170106.125624^54"
^DIC(9.4,127,22,3,"PAH",124,1,0)="^^12^12^3170106"
^DIC(9.4,127,22,3,"PAH",124,1,1,0)="The patch addresses three (3) issues:"
^DIC(9.4,127,22,3,"PAH",124,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",124,1,3,0)="1.   Cases aborted prior to the release of SR*3.0*184 are displayed as "
^DIC(9.4,127,22,3,"PAH",124,1,4,0)="     ""CANCELLED"" in the Operation Menu option [SROPER]."
^DIC(9.4,127,22,3,"PAH",124,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",124,1,6,0)="2.   Nurses are unable to sign their Nurse Intraoperative Report (NIR) "
^DIC(9.4,127,22,3,"PAH",124,1,7,0)="     in the Surgical Package when the case has been aborted using the "
^DIC(9.4,127,22,3,"PAH",124,1,8,0)="     Abort/Cancel Operation option [SROABRT]."
^DIC(9.4,127,22,3,"PAH",124,1,9,0)=" "
^DIC(9.4,127,22,3,"PAH",124,1,10,0)="3.   Users are unable to enter a D Code (Dental) in the PLANNED "
^DIC(9.4,127,22,3,"PAH",124,1,11,0)="     PRINCIPAL PROCEDURE field (#27) of the SURGERY file (#130) using"
^DIC(9.4,127,22,3,"PAH",124,1,12,0)="     the Non-O.R. Procedure option [SRONOP] in the Surgery package."
^DIC(9.4,127,22,3,"PAH",125,0)="187 SEQ #179^3170224.170317^54"
^DIC(9.4,127,22,3,"PAH",125,1,0)="^^13^13^3170224"
^DIC(9.4,127,22,3,"PAH",125,1,1,0)="The patch addresses four (4) issues:"
^DIC(9.4,127,22,3,"PAH",125,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",125,1,3,0)="1. When Surgery sends HL7 (Health Level-7) DG1 (Diagnosis) Segments to"
^DIC(9.4,127,22,3,"PAH",125,1,4,0)="   Ancillary systems, messages with other preoperative diagnoses have"
^DIC(9.4,127,22,3,"PAH",125,1,5,0)="   an incorrect value for the ICD diagnosis code."
^DIC(9.4,127,22,3,"PAH",125,1,6,0)="2. When a Wound Classification Report is generated at an institution "
^DIC(9.4,127,22,3,"PAH",125,1,7,0)="   that has only one (1) Active surgery site and the Active site isn't "
^DIC(9.4,127,22,3,"PAH",125,1,8,0)="   the installation's default institution, the report displays no data "
^DIC(9.4,127,22,3,"PAH",125,1,9,0)="   regardless of the date range selected."
^DIC(9.4,127,22,3,"PAH",125,1,10,0)="3. Surgery Post Operation and CPT/ICD Update/Verify options incorrectly"
^DIC(9.4,127,22,3,"PAH",125,1,11,0)="   allow CPT Modifier 51 to be entered on the Principle Procedure."
^DIC(9.4,127,22,3,"PAH",125,1,12,0)="4. The Surgery Schedule of Operations report truncates the patient "
^DIC(9.4,127,22,3,"PAH",125,1,13,0)="   name inappropriately when its length is great than 23 characters."
^DIC(9.4,127,22,3,"PAH",126,0)="189 SEQ #180^3170310.124201^54"
^DIC(9.4,127,22,3,"PAH",126,1,0)="^^4^4^3170310"
^DIC(9.4,127,22,3,"PAH",126,1,1,0)="Patch SR*3.0*189 addresses the following Surgery issue:"
^DIC(9.4,127,22,3,"PAH",126,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",126,1,3,0)="  1. The SURGERY file (#130) ADT and ARS cross references do not merge "
^DIC(9.4,127,22,3,"PAH",126,1,4,0)="during a patient merge."
^DIC(9.4,127,22,3,"PAH",127,0)="190 SEQ #181^3180228.164907^54"
^DIC(9.4,127,22,3,"PAH",127,1,0)="^^4^4^3180228"
^DIC(9.4,127,22,3,"PAH",127,1,1,0)="The patch addresses one (1) issues:"
^DIC(9.4,127,22,3,"PAH",127,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",127,1,3,0)="1.   Under certain conditions, the transplant/donor section is not"
^DIC(9.4,127,22,3,"PAH",127,1,4,0)="     displayed on the Nurse Intraoperative Report (NIR)"
^DIC(9.4,127,22,3,"PAH",128,0)="193 SEQ #183^3190402.17163^54"
^DIC(9.4,127,22,3,"PAH",128,1,0)="^^1^1^3190402"
^DIC(9.4,127,22,3,"PAH",128,1,1,0)="Preoperative CVD data fields assigned invalid values"
^DIC(9.4,127,22,3,"PAH",129,0)="194 SEQ #182^3190530.124949^17"
^DIC(9.4,127,22,3,"PAH",129,1,0)="^^1^1^3190530"
^DIC(9.4,127,22,3,"PAH",129,1,1,0)="HOSPITAL ADMISSION STATUS field defaults to an inactive code"
^DIC(9.4,127,22,3,"PAH",130,0)="195 SEQ #184^3190819.120446^65"
^DIC(9.4,127,22,3,"PAH",130,1,0)="^^2^2^3190819"
^DIC(9.4,127,22,3,"PAH",130,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,127,22,3,"PAH",130,1,2,0)="under SR*3*195."
^DIC(9.4,127,22,3,"PAH",131,0)="196 SEQ #185^3200115.12273^65"
^DIC(9.4,127,22,3,"PAH",131,1,0)="^^8^8^3200115"
^DIC(9.4,127,22,3,"PAH",131,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,127,22,3,"PAH",131,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",131,1,3,0)="1.   When the MAKE OPERATION REQUEST [SROOPREQ] option is used to "
^DIC(9.4,127,22,3,"PAH",131,1,4,0)="     delete an outstanding surgery request with a concurrent case "
^DIC(9.4,127,22,3,"PAH",131,1,5,0)="     request, the user is asked if they want to delete the concurrent"
^DIC(9.4,127,22,3,"PAH",131,1,6,0)="     case and defaults to ""yes"". If the user accepts the default the"
^DIC(9.4,127,22,3,"PAH",131,1,7,0)="     outstanding request AND concurrent cases are deleted regardless"
^DIC(9.4,127,22,3,"PAH",131,1,8,0)="     whether the concurrent case is completed case."
^DIC(9.4,127,22,3,"PAH",132,0)="201 SEQ #186^3201123.100958^17"
^DIC(9.4,127,22,3,"PAH",132,1,0)="^^11^11^3201123"
^DIC(9.4,127,22,3,"PAH",132,1,1,0)="The patch addresses two (2) issue:"
^DIC(9.4,127,22,3,"PAH",132,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",132,1,3,0)="1.   When a POSTOP OCCURRENCE for ""OUT-OF-OR UNPLANNED INTUBATION "
^DIC(9.4,127,22,3,"PAH",132,1,4,0)="     W/IN 30 DAYS"" is entered and then deleted, the printed risk "
^DIC(9.4,127,22,3,"PAH",132,1,5,0)="     assessment improperly displays ""NO DATE"" rather than ""NO"" for"
^DIC(9.4,127,22,3,"PAH",132,1,6,0)="     the occurrence."
^DIC(9.4,127,22,3,"PAH",132,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",132,1,8,0)="2.   When two (2) users accidently attempt to schedule or reschedule"
^DIC(9.4,127,22,3,"PAH",132,1,9,0)="     an operation for the same patient, they can inadvertently "
^DIC(9.4,127,22,3,"PAH",132,1,10,0)="     schedule the same case for different times or rooms and block "
^DIC(9.4,127,22,3,"PAH",132,1,11,0)="     those resources from other users."
^DIC(9.4,127,22,3,"PAH",133,0)="202b^3210623"
^DIC(9.4,127,22,3,"PAH",133,1,0)="^^5^5^3210623"
^DIC(9.4,127,22,3,"PAH",133,1,1,0)="Backup of SR*3.0*202 on Jun 23, 2021"
^DIC(9.4,127,22,3,"PAH",133,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",133,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,127,22,3,"PAH",133,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,127,22,3,"PAH",133,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,127,22,3,"PAH",134,0)="202 SEQ #187^3210623.113347^17"
^DIC(9.4,127,22,3,"PAH",134,1,0)="^^4^4^3210623"
^DIC(9.4,127,22,3,"PAH",134,1,1,0)="The patch will address the following issue: "
^DIC(9.4,127,22,3,"PAH",134,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",134,1,3,0)="The CPT EXCLUSIONS file (#137) needs to be updated for fiscal year 2021 "
^DIC(9.4,127,22,3,"PAH",134,1,4,0)="(FY21)."
^DIC(9.4,127,22,3,"PAH",135,0)="200 SEQ #188^3211129.095837^17"
^DIC(9.4,127,22,3,"PAH",135,1,0)="^^22^22^3211129"
^DIC(9.4,127,22,3,"PAH",135,1,1,0)="This enhancement to the VISTA Surgery package includes a new field "
^DIC(9.4,127,22,3,"PAH",135,1,2,0)="ROBOTIC ASSISTANCE (Y/N) for tracking whether robotic assistance was used "
^DIC(9.4,127,22,3,"PAH",135,1,3,0)="when completing a surgery procedure. The new field is included on the "
^DIC(9.4,127,22,3,"PAH",135,1,4,0)="Operation, Operation Short Screen, and Nurse Intraoperative Report "
^DIC(9.4,127,22,3,"PAH",135,1,5,0)="options within the Operation Menu and is required to be entered prior to "
^DIC(9.4,127,22,3,"PAH",135,1,6,0)="signing the Nurse Intraoperative Report. The field is also included on "
^DIC(9.4,127,22,3,"PAH",135,1,7,0)="Non-Cardiac and Cardiac Risk Assessment data entry options.  This "
^DIC(9.4,127,22,3,"PAH",135,1,8,0)="indicator is transmitted to VASQIP for all cases. A new field, ROBOTIC "
^DIC(9.4,127,22,3,"PAH",135,1,9,0)="DEFAULT (#12) has been added to the LOCAL SURGICAL  SPECIALTY file"
^DIC(9.4,127,22,3,"PAH",135,1,10,0)="(137.45).  If defined for a local specialty, the software will"
^DIC(9.4,127,22,3,"PAH",135,1,11,0)="automatically enter NO in the ROBOTIC ASSISTANCE (Y/N) field when"
^DIC(9.4,127,22,3,"PAH",135,1,12,0)="a surgery case is created for the selected specialty."
^DIC(9.4,127,22,3,"PAH",135,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",135,1,14,0)="Update to transmission code to restrict date/time field 613 to 12 "
^DIC(9.4,127,22,3,"PAH",135,1,15,0)="characters."
^DIC(9.4,127,22,3,"PAH",135,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",135,1,17,0)="Update to Nurse Intraoperative report to have Laser Duration notes as "
^DIC(9.4,127,22,3,"PAH",135,1,18,0)="seconds (not minutes).  Update to file #130.11, field #14 to reflect this "
^DIC(9.4,127,22,3,"PAH",135,1,19,0)="change."
^DIC(9.4,127,22,3,"PAH",135,1,20,0)=" "
^DIC(9.4,127,22,3,"PAH",135,1,21,0)="Update to include a search for any height for the patient, not just a "
^DIC(9.4,127,22,3,"PAH",135,1,22,0)="height in the past year."
^DIC(9.4,127,22,3,"PAH",136,0)="204 SEQ #189^3220822.144604^86"
^DIC(9.4,127,22,3,"PAH",136,1,0)="^^12^12^3220822"
^DIC(9.4,127,22,3,"PAH",136,1,1,0)="The patch addresses two (2) issues: "
^DIC(9.4,127,22,3,"PAH",136,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",136,1,3,0)="1.  One Liner (1-Liner) cases are not transmitting to the National Risk"
^DIC(9.4,127,22,3,"PAH",136,1,4,0)="    Assessment database because the SURGERY FILE (#130) AQ XREF is being "
^DIC(9.4,127,22,3,"PAH",136,1,5,0)="    killed and not reset when the TIME PAT OUT OR field (#.232) in the "
^DIC(9.4,127,22,3,"PAH",136,1,6,0)="    SURGERY FILE (#130) is edited for a surgery case with a signed Nurse"
^DIC(9.4,127,22,3,"PAH",136,1,7,0)="    Intraoperative Report with coding complete."
^DIC(9.4,127,22,3,"PAH",136,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",136,1,9,0)="2.  A request is to increase the numeric upper limit of the TOTAL JOULES"
^DIC(9.4,127,22,3,"PAH",136,1,10,0)="    DELIVERED field (#9) in the LASER PERFORMED multiple (#135) in the "
^DIC(9.4,127,22,3,"PAH",136,1,11,0)="    SURGERY FILE (#130). Specifically: the request is to increase the "
^DIC(9.4,127,22,3,"PAH",136,1,12,0)="    largest allowable value to 99999.9."
^DIC(9.4,127,22,3,"PAH",137,0)="206 SEQ #190^3221012.092907^90"
^DIC(9.4,127,22,3,"PAH",137,1,0)="^^4^4^3221012"
^DIC(9.4,127,22,3,"PAH",137,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",137,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",137,1,3,0)="The patch will address the following issue: the CPT EXCLUSIONS file (#137)"
^DIC(9.4,127,22,3,"PAH",137,1,4,0)="needs to be updated for fiscal year 2022 (FY22)."
^DIC(9.4,127,22,3,"PAH",138,0)="203 SEQ #192^3230118.161257^89"
^DIC(9.4,127,22,3,"PAH",138,1,0)="^^17^17^3230118"
^DIC(9.4,127,22,3,"PAH",138,1,1,0)="The patch addresses three (3) issue: "
^DIC(9.4,127,22,3,"PAH",138,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",138,1,3,0)="1.  When using the ""Scheduled Unrequested Operations"" [SROSRES] option"
^DIC(9.4,127,22,3,"PAH",138,1,4,0)="    at the PRIMARY SURGEON prompt and the VistA session is terminated,"
^DIC(9.4,127,22,3,"PAH",138,1,5,0)="    the Operating Room schedule is blocked. If the VistA session times"
^DIC(9.4,127,22,3,"PAH",138,1,6,0)="    out at the same prompt, the Operating Room schedule is not blocked."
^DIC(9.4,127,22,3,"PAH",138,1,7,0)=" "
^DIC(9.4,127,22,3,"PAH",138,1,8,0)="2.  When using the ""Schedule Unrequested Concurrent Cases"" [SRSCHDC] "
^DIC(9.4,127,22,3,"PAH",138,1,9,0)="    Option at the PRIMARY SURGEON prompt and the VistA session is"
^DIC(9.4,127,22,3,"PAH",138,1,10,0)="    Abnormally terminated, the Operating Room schedule is blocked. If "
^DIC(9.4,127,22,3,"PAH",138,1,11,0)="    the VistA session times out at the same prompt, the Operating Room"
^DIC(9.4,127,22,3,"PAH",138,1,12,0)="    schedule is not blocked."
^DIC(9.4,127,22,3,"PAH",138,1,13,0)=" "
^DIC(9.4,127,22,3,"PAH",138,1,14,0)="3.  The Cardiac Assessment option only captures the height if entered "
^DIC(9.4,127,22,3,"PAH",138,1,15,0)="    into the Vitals package in the past year instead of  capturing height "
^DIC(9.4,127,22,3,"PAH",138,1,16,0)="    regardless of when the measurement was taken like the Non-Cardiac "
^DIC(9.4,127,22,3,"PAH",138,1,17,0)="    Assessment option."
^DIC(9.4,127,22,3,"PAH",139,0)="207 SEQ #193^3230414.113013^90"
^DIC(9.4,127,22,3,"PAH",139,1,0)="^^5^5^3230414"
^DIC(9.4,127,22,3,"PAH",139,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",139,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",139,1,3,0)="1.  Under certain circumstance, completed concurrent surgical cases (the "
^DIC(9.4,127,22,3,"PAH",139,1,4,0)="TIME PAT OUT OR field {#.232} in the SURGERY FILE {#130} is entered) are "
^DIC(9.4,127,22,3,"PAH",139,1,5,0)="allowed to be deleted from the VistA Surgery package."
^DIC(9.4,127,22,3,"PAH",140,0)="209 SEQ #194^3230523.09394^89"
^DIC(9.4,127,22,3,"PAH",140,1,0)="^^6^6^3230523"
^DIC(9.4,127,22,3,"PAH",140,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",140,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",140,1,3,0)="1.  The National Surgery Office requests that the help text for wound "
^DIC(9.4,127,22,3,"PAH",140,1,4,0)="classification information in VistA Surgery be updated so that 2018 CDC "
^DIC(9.4,127,22,3,"PAH",140,1,5,0)="Wound Classification definitions are displayed rather than the current "
^DIC(9.4,127,22,3,"PAH",140,1,6,0)="definitions (2007)."
^DIC(9.4,127,22,3,"PAH",141,0)="210 SEQ #195^3230614.174455^89"
^DIC(9.4,127,22,3,"PAH",141,1,0)="^^4^4^3230614"
^DIC(9.4,127,22,3,"PAH",141,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",141,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",141,1,3,0)="The patch will address the following issue: the CPT EXCLUSIONS file (#137)"
^DIC(9.4,127,22,3,"PAH",141,1,4,0)="needs to be updated for fiscal year 2023 (FY23)."
^DIC(9.4,127,22,3,"PAH",142,0)="211 SEQ #196^3230901.141114^89"
^DIC(9.4,127,22,3,"PAH",142,1,0)="^^5^5^3230901"
^DIC(9.4,127,22,3,"PAH",142,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",142,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",142,1,3,0)="The CONCURRENT CASE field (#35) in the SURGERY FILE (#130) in a completed "
^DIC(9.4,127,22,3,"PAH",142,1,4,0)="concurrent case is cleared however the CONCURRENT CASE field is not "
^DIC(9.4,127,22,3,"PAH",142,1,5,0)="cleared in a cancelled concurrent case."
^DIC(9.4,127,22,3,"PAH",143,0)="212 SEQ #197^3231101.113059^89"
^DIC(9.4,127,22,3,"PAH",143,1,0)="^^9^9^3231101"
^DIC(9.4,127,22,3,"PAH",143,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",143,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",143,1,3,0)="Under certain circumstances, the CULTURES title/data does not display on "
^DIC(9.4,127,22,3,"PAH",143,1,4,0)="the Nurse Intraoperative Report using the VistA Nurse Intraoperative "
^DIC(9.4,127,22,3,"PAH",143,1,5,0)="Report display/print option or on the SURGERY tab in CPRS.  This occurs "
^DIC(9.4,127,22,3,"PAH",143,1,6,0)="when the NURSE INTRAOP REPORT field (#29) in the SURGERY SITE PARAMETERS "
^DIC(9.4,127,22,3,"PAH",143,1,7,0)="FILE (#133) is set to ""PRINT TITLES WITH INFO ONLY"" and the CULTURES "
^DIC(9.4,127,22,3,"PAH",143,1,8,0)="field (#64) in the SURGERY FILE (#130) contains data and the SPECIMENS "
^DIC(9.4,127,22,3,"PAH",143,1,9,0)="field (#49) does not."
^DIC(9.4,127,22,3,"PAH",144,0)="213 SEQ #198^3231206.154232^89"
^DIC(9.4,127,22,3,"PAH",144,1,0)="^^6^6^3231206"
^DIC(9.4,127,22,3,"PAH",144,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",144,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",144,1,3,0)="Under certain circumstances, the CVD REPAIR/OBSTRUCT field (#521) value "
^DIC(9.4,127,22,3,"PAH",144,1,4,0)="in the SURGERY File (#130) is not displaying/printing for a NON-CARDIAC "
^DIC(9.4,127,22,3,"PAH",144,1,5,0)="RISK ASSESSMENT using the ""Print a Surgery Risk Assessment"" [SROA PRINT "
^DIC(9.4,127,22,3,"PAH",144,1,6,0)="ASSESSMENT] option."
^DIC(9.4,127,22,3,"PAH",145,0)="214 SEQ #199^3240325.095523^89"
^DIC(9.4,127,22,3,"PAH",145,1,0)="^^16^16^3240325"
^DIC(9.4,127,22,3,"PAH",145,1,1,0)="The patch addresses one (2) issues: "
^DIC(9.4,127,22,3,"PAH",145,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",145,1,3,0)="1. In certain circumstances if a value is entered in the REFERRING"
^DIC(9.4,127,22,3,"PAH",145,1,4,0)="PHYSICIAN field (#23) of the SURGERY FILE (#130) in a surgery case the"
^DIC(9.4,127,22,3,"PAH",145,1,5,0)="value is carried over and DISPLAYS in the SPECIAL EQUIPMENT (#680),"
^DIC(9.4,127,22,3,"PAH",145,1,6,0)="PLANNED IMPLANTS (#681), SPECIAL SUPPLIES (#682), SPECIAL INSTRUMENTS"
^DIC(9.4,127,22,3,"PAH",145,1,7,0)="(#683) or PHARMACY ITEMS (#684) fields."
^DIC(9.4,127,22,3,"PAH",145,1,8,0)=" "
^DIC(9.4,127,22,3,"PAH",145,1,9,0)="2. In certain circumstances ""Select Surgical Specialty:"" displays "
^DIC(9.4,127,22,3,"PAH",145,1,10,0)="erroneously instead of the field name/title when adding a new entry to "
^DIC(9.4,127,22,3,"PAH",145,1,11,0)="several multiples in the SURGERY file (#130) when entering a new surgery "
^DIC(9.4,127,22,3,"PAH",145,1,12,0)="case using the ""Operation Menu"".  The multiples are: OTHER PROCEDURES "
^DIC(9.4,127,22,3,"PAH",145,1,13,0)="(#.42), OTHER PREOP DIAGNOISIS (#.72)"
^DIC(9.4,127,22,3,"PAH",145,1,14,0)="SURGERY POSITION (#65), REQ BLOOD KIND (#1.05), SPECIAL EQUIPMENT (#680), "
^DIC(9.4,127,22,3,"PAH",145,1,15,0)="PLANNED IMPLANTS (#681), SPECIAL SUPPLIES (#682), SPECIAL INSTRUMENTS "
^DIC(9.4,127,22,3,"PAH",145,1,16,0)="(#683), PHARMACY ITEMS (#684), and REFERRING PHYSICIAN (#23)."
^DIC(9.4,127,22,3,"PAH",146,0)="205 SEQ #200^3240808.172659^89"
^DIC(9.4,127,22,3,"PAH",146,1,0)="^^50^50^3240808"
^DIC(9.4,127,22,3,"PAH",146,1,1,0)="This enhancement to the VistA Surgery package includes:"
^DIC(9.4,127,22,3,"PAH",146,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,3,0)="1. An update to the SET OF CODES for the DONOR VESSEL DISPOSITION (#665)"
^DIC(9.4,127,22,3,"PAH",146,1,4,0)="field in the SURGERY (#130) file"
^DIC(9.4,127,22,3,"PAH",146,1,5,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,6,0)="'NA - NOT APPLICABLE' has been added to the set of codes that can be"
^DIC(9.4,127,22,3,"PAH",146,1,7,0)="selected for the DONOR VESSEL DISPOSITION (#665) field in the SURGERY "
^DIC(9.4,127,22,3,"PAH",146,1,8,0)="(#130) file.  Surgery Risk Assessment transmissions have been modified to"
^DIC(9.4,127,22,3,"PAH",146,1,9,0)="accommodate the new 2 character code."
^DIC(9.4,127,22,3,"PAH",146,1,10,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,11,0)="STORED IN ^SRF(  (XX ENTRIES)   SITE: XXXXXXX                UCI: XXXXXXX"
^DIC(9.4,127,22,3,"PAH",146,1,12,0)="                                                              (VERSION 3)"
^DIC(9.4,127,22,3,"PAH",146,1,13,0)="DATA          NAME                  GLOBAL        DATA"
^DIC(9.4,127,22,3,"PAH",146,1,14,0)="ELEMENT       TITLE                 LOCATION      TYPE"
^DIC(9.4,127,22,3,"PAH",146,1,15,0)="-------------------------------------------------------------------------"
^DIC(9.4,127,22,3,"PAH",146,1,16,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,17,0)="130,665       DONOR VESSEL DISPOSITION VER1;16 SET"
^DIC(9.4,127,22,3,"PAH",146,1,18,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,19,0)="              Donor Vessel Disposition if not used   "
^DIC(9.4,127,22,3,"PAH",146,1,20,0)="                                'N' FOR NO DONOR VESSELS RECEIVED; "
^DIC(9.4,127,22,3,"PAH",146,1,21,0)="                                'D' FOR DISCARDED; "
^DIC(9.4,127,22,3,"PAH",146,1,22,0)="                                'R' FOR RETURNED TO OPO; "
^DIC(9.4,127,22,3,"PAH",146,1,23,0)="                                'S' FOR STORED; "
^DIC(9.4,127,22,3,"PAH",146,1,24,0)="                               *'NA' FOR NOT APPLICABLE; <--"
^DIC(9.4,127,22,3,"PAH",146,1,25,0)="              LAST EDITED:      MAY 18, 2022 "
^DIC(9.4,127,22,3,"PAH",146,1,26,0)="              HELP-PROMPT:      Enter disposition of donor vessels. "
^DIC(9.4,127,22,3,"PAH",146,1,27,0)="              DESCRIPTION:"
^DIC(9.4,127,22,3,"PAH",146,1,28,0)="                                Document disposition of donor vessels."
^DIC(9.4,127,22,3,"PAH",146,1,29,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,30,0)="2. Input template (order of menu options) realignment"
^DIC(9.4,127,22,3,"PAH",146,1,31,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,32,0)="The SRONRPT, SRONRPT1, and SRONRPT2 input templates that are executed when"
^DIC(9.4,127,22,3,"PAH",146,1,33,0)="the Nurse Intraoperative Report [SRONRPT] option is selected have been"
^DIC(9.4,127,22,3,"PAH",146,1,34,0)="updated to follow the order of menu options requested by the National"
^DIC(9.4,127,22,3,"PAH",146,1,35,0)="Surgery Office (NSO)."
^DIC(9.4,127,22,3,"PAH",146,1,36,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,37,0)="3. Deactivation of the POSSIBLE ITEM RETENTION (#630) field in the SURGERY"
^DIC(9.4,127,22,3,"PAH",146,1,38,0)="(#130) file"
^DIC(9.4,127,22,3,"PAH",146,1,39,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,40,0)="The POSSIBLE ITEM RETENTION (#630) field has been marked as "
^DIC(9.4,127,22,3,"PAH",146,1,41,0)="UNEDITABLE in the SURGERY (#130) file and will no longer be included in"
^DIC(9.4,127,22,3,"PAH",146,1,42,0)="any VistA Surgery input templates for entry or editing. This field will"
^DIC(9.4,127,22,3,"PAH",146,1,43,0)="also no longer be required to electronically sign the Nurse Intraoperative"
^DIC(9.4,127,22,3,"PAH",146,1,44,0)="report. It will, however, continue to display in completed Nurse"
^DIC(9.4,127,22,3,"PAH",146,1,45,0)="Intraoperative Reports for historical cases."
^DIC(9.4,127,22,3,"PAH",146,1,46,0)=" "
^DIC(9.4,127,22,3,"PAH",146,1,47,0)="4. Correction of spelling for GLASSES/GOOGLES to GLASSES/GOGGLES in the "
^DIC(9.4,127,22,3,"PAH",146,1,48,0)="PATIENT PRECAUTIONS (#15) subfield of the LASER PERFORMED (#130.11)"
^DIC(9.4,127,22,3,"PAH",146,1,49,0)="multiple in the SURGERY (#130) file for display/print in the Nurse"
^DIC(9.4,127,22,3,"PAH",146,1,50,0)="Intraoperative Report."
^DIC(9.4,127,22,3,"PAH",147,0)="215 SEQ #201^3240903.103052^89"
^DIC(9.4,127,22,3,"PAH",147,1,0)="^^4^4^3240903"
^DIC(9.4,127,22,3,"PAH",147,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,127,22,3,"PAH",147,1,2,0)=" "
^DIC(9.4,127,22,3,"PAH",147,1,3,0)="The patch will address the following issue: the CPT EXCLUSIONS file (#137)"
^DIC(9.4,127,22,3,"PAH",147,1,4,0)="needs to be updated for fiscal year 2024 (FY24)."
