^DIC(9.4,11,22,5.03,"PAH",16,0)="53 SEQ #36^3000525^1"
^DIC(9.4,11,22,5.03,"PAH",16,1,0)="^^307^307^3000525"
^DIC(9.4,11,22,5.03,"PAH",16,1,1,0)="This patch to the Laboratory package does not contain any changes to the"
^DIC(9.4,11,22,5.03,"PAH",16,1,2,0)="VISTA BLOOD BANK Software as defined by VHA DIRECTIVE 99-053 titled VISTA"
^DIC(9.4,11,22,5.03,"PAH",16,1,3,0)="BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",16,1,4,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,5,0)="This patch will install the CareVue interface package under the Namespace"
^DIC(9.4,11,22,5.03,"PAH",16,1,6,0)="LA7D as a Class I national patch."
^DIC(9.4,11,22,5.03,"PAH",16,1,7,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,8,0)="1. Problem: Current CareVue interface is Class III software."
^DIC(9.4,11,22,5.03,"PAH",16,1,9,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,10,0)="   Solution: The code has been validated, brought up to national"
^DIC(9.4,11,22,5.03,"PAH",16,1,11,0)="             standard and released as a Class I national patch."
^DIC(9.4,11,22,5.03,"PAH",16,1,12,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,13,0)="This patch REQUIRES that patch LR*5.2*254 be installed in order for the"
^DIC(9.4,11,22,5.03,"PAH",16,1,14,0)="CareVue interface to work properly."
^DIC(9.4,11,22,5.03,"PAH",16,1,15,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,16,0)="An interface engine must exist to connect CareVue (or other clinical"
^DIC(9.4,11,22,5.03,"PAH",16,1,17,0)="system) and Vista using TCP/IP and HL7 messages.  Three possible contacts"
^DIC(9.4,11,22,5.03,"PAH",16,1,18,0)="for this interface engine are STC, Inc. MSI Solutions Inc. and Agilent"
^DIC(9.4,11,22,5.03,"PAH",16,1,19,0)="Technologies."
^DIC(9.4,11,22,5.03,"PAH",16,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,21,0)="STC, Inc. can be contacted at:"
^DIC(9.4,11,22,5.03,"PAH",16,1,22,0)="      Richard Garcia"
^DIC(9.4,11,22,5.03,"PAH",16,1,23,0)="      voice: 626.471.6000 x6755"
^DIC(9.4,11,22,5.03,"PAH",16,1,24,0)="      fax:   626.471.6104"
^DIC(9.4,11,22,5.03,"PAH",16,1,25,0)="      email: rmg@stc.com"
^DIC(9.4,11,22,5.03,"PAH",16,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,27,0)="MSI Solutions, Inc. can be contacted at:"
^DIC(9.4,11,22,5.03,"PAH",16,1,28,0)="      Bob Kelliher"
^DIC(9.4,11,22,5.03,"PAH",16,1,29,0)="      voice: 678.256.4505"
^DIC(9.4,11,22,5.03,"PAH",16,1,30,0)="      fax:   678.256.4677"
^DIC(9.4,11,22,5.03,"PAH",16,1,31,0)="      email: bob.kelliher@msi-solutions.com"
^DIC(9.4,11,22,5.03,"PAH",16,1,32,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,33,0)="Agilent Technologies can be contacted at:"
^DIC(9.4,11,22,5.03,"PAH",16,1,34,0)="      Linda Vanderhulst"
^DIC(9.4,11,22,5.03,"PAH",16,1,35,0)="      voice: 847.342.2521"
^DIC(9.4,11,22,5.03,"PAH",16,1,36,0)="      email: linda_vanderhulst@agilent.com"
^DIC(9.4,11,22,5.03,"PAH",16,1,37,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,38,0)="About this software:"
^DIC(9.4,11,22,5.03,"PAH",16,1,39,0)="===================="
^DIC(9.4,11,22,5.03,"PAH",16,1,40,0)="1.  An option to enter/delete supported wards for the FOREIGN "
^DIC(9.4,11,22,5.03,"PAH",16,1,41,0)="    INTERFACE file (#62.487) is exported with this version of the patch."
^DIC(9.4,11,22,5.03,"PAH",16,1,42,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,43,0)="    **NOTE** "
^DIC(9.4,11,22,5.03,"PAH",16,1,44,0)="       All wards in the hospital location file (#44) that will be"
^DIC(9.4,11,22,5.03,"PAH",16,1,45,0)="       used for the CareVue interface must have a UNIQUE abbreviation for"
^DIC(9.4,11,22,5.03,"PAH",16,1,46,0)="       each ward (Inactive and Active)"
^DIC(9.4,11,22,5.03,"PAH",16,1,47,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,48,0)="2.  Resulting from this installation, the entries DHCP CARELIFE and"
^DIC(9.4,11,22,5.03,"PAH",16,1,49,0)="    MRTS CARELIFE will automatically be added to the HL7 APPLICATION "
^DIC(9.4,11,22,5.03,"PAH",16,1,50,0)="    PARAMETER file (#771).  These entries will be used to send HL7"
^DIC(9.4,11,22,5.03,"PAH",16,1,51,0)="    messages to the CareVue system.  These parameters also need to be"
^DIC(9.4,11,22,5.03,"PAH",16,1,52,0)="    edited to enter your facility name."
^DIC(9.4,11,22,5.03,"PAH",16,1,53,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,54,0)="3.  The following file is included in this release.  It is in the LA7D"
^DIC(9.4,11,22,5.03,"PAH",16,1,55,0)="    namespace, also listed in the main installation procedure:"
^DIC(9.4,11,22,5.03,"PAH",16,1,56,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,57,0)="            File #62.487 File name FOREIGN INTERFACE"
^DIC(9.4,11,22,5.03,"PAH",16,1,58,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,59,0)="4.  The following mail group will be automatically added to the MAIL"
^DIC(9.4,11,22,5.03,"PAH",16,1,60,0)="    GROUP file (#3.8) during this installation:  CARELIFE RESULT ERROR"
^DIC(9.4,11,22,5.03,"PAH",16,1,61,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,62,0)="5.  This installation automatically adds the two new protocols to the"
^DIC(9.4,11,22,5.03,"PAH",16,1,63,0)="    PROTOCOL file (#101).  They are:  LA7D CARELIFE RESULTS"
^DIC(9.4,11,22,5.03,"PAH",16,1,64,0)="                                      LA7D CARELIFE SERVER"
^DIC(9.4,11,22,5.03,"PAH",16,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,66,0)="6.  Sites will need to set up a Logical Link for HL7 parameters."
^DIC(9.4,11,22,5.03,"PAH",16,1,67,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,68,0)="7.  The routines exported with this release, listed in the Routines "
^DIC(9.4,11,22,5.03,"PAH",16,1,69,0)="    section of this document, are customized to send verified "
^DIC(9.4,11,22,5.03,"PAH",16,1,70,0)="    Laboratory data to CareVue for all patients located on a CareVue "
^DIC(9.4,11,22,5.03,"PAH",16,1,71,0)="    ward."
^DIC(9.4,11,22,5.03,"PAH",16,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,73,0)="     "
^DIC(9.4,11,22,5.03,"PAH",16,1,74,0)=" Associated NOIS"
^DIC(9.4,11,22,5.03,"PAH",16,1,75,0)=" ==============="
^DIC(9.4,11,22,5.03,"PAH",16,1,76,0)=" None"
^DIC(9.4,11,22,5.03,"PAH",16,1,77,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,78,0)=" Test Sites"
^DIC(9.4,11,22,5.03,"PAH",16,1,79,0)=" =============== "
^DIC(9.4,11,22,5.03,"PAH",16,1,80,0)=" Philadelphia, PA"
^DIC(9.4,11,22,5.03,"PAH",16,1,81,0)=" Martinsburg, WVA"
^DIC(9.4,11,22,5.03,"PAH",16,1,82,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,83,0)=" ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",16,1,84,0)=" ================="
^DIC(9.4,11,22,5.03,"PAH",16,1,85,0)=" The following is a list of routines included in this patch. The second"
^DIC(9.4,11,22,5.03,"PAH",16,1,86,0)=" line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",16,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,88,0)=" <tab>;;5.2;LAB SERVICE;**[patch list]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",16,1,89,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,90,0)="                 CHECK^XTSUMBLD Results"
^DIC(9.4,11,22,5.03,"PAH",16,1,91,0)="  Routine Name    Before Patch      After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",16,1,92,0)="  ------------    ------------      -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",16,1,93,0)="  LA7DVC                NEW             7338732          53"
^DIC(9.4,11,22,5.03,"PAH",16,1,94,0)="  LA7DVEXT              NEW             5483063          53"
^DIC(9.4,11,22,5.03,"PAH",16,1,95,0)="  LA7DVM                NEW             6983644          53"
^DIC(9.4,11,22,5.03,"PAH",16,1,96,0)="  LA7DEDT               NEW             3756680          53"
^DIC(9.4,11,22,5.03,"PAH",16,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,98,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,99,0)="CareVue installation manuals"
^DIC(9.4,11,22,5.03,"PAH",16,1,100,0)="============================"
^DIC(9.4,11,22,5.03,"PAH",16,1,101,0)="VAMC's are encouraged to use their FTP capability to obtain the"
^DIC(9.4,11,22,5.03,"PAH",16,1,102,0)="Documentation PDF files from one of the following OI Field Office's"
^DIC(9.4,11,22,5.03,"PAH",16,1,103,0)="ANONYMOUS directories.  "
^DIC(9.4,11,22,5.03,"PAH",16,1,104,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,105,0)="    OI FIELD OFFICE       FTP ADDRESS             DIRECTORY"
^DIC(9.4,11,22,5.03,"PAH",16,1,106,0)="    ===============       ===========             =========="
^DIC(9.4,11,22,5.03,"PAH",16,1,107,0)="     HINES               152.129.1.110      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,11,22,5.03,"PAH",16,1,108,0)="     SALT LAKE CITY      152.131.2.1        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,11,22,5.03,"PAH",16,1,109,0)="     ALBANY              152.127.1.5        [ANONYMOUS.SOFTWARE]"
^DIC(9.4,11,22,5.03,"PAH",16,1,110,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,111,0)=" File names are:                                                  "
^DIC(9.4,11,22,5.03,"PAH",16,1,112,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,113,0)=" BINARY FILES"
^DIC(9.4,11,22,5.03,"PAH",16,1,114,0)="  LA7DIG.PDF  -- CareVue Installation Guide"
^DIC(9.4,11,22,5.03,"PAH",16,1,115,0)="  LA7DIS.PDF  -- CareVue Interface Specifications"
^DIC(9.4,11,22,5.03,"PAH",16,1,116,0)="  LA7DTP.PDF  -- CareVue Interface Test Plan"
^DIC(9.4,11,22,5.03,"PAH",16,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,118,0)="The CareVue interface utilizes VISTA'S Laboratory Test Result system to"
^DIC(9.4,11,22,5.03,"PAH",16,1,119,0)="send Observation Request Unsolicited (ORU) messages to the CareVue system."
^DIC(9.4,11,22,5.03,"PAH",16,1,120,0)="The interface messages are based on ward location and passed to an"
^DIC(9.4,11,22,5.03,"PAH",16,1,121,0)="interface engine.  When Lab results are verified and the requesting ward"
^DIC(9.4,11,22,5.03,"PAH",16,1,122,0)="is identified as having a supported entry in the new CareVue Foreign"
^DIC(9.4,11,22,5.03,"PAH",16,1,123,0)="Interface file #62.487, the lab results are forwarded, via HL7, to the"
^DIC(9.4,11,22,5.03,"PAH",16,1,124,0)="interface engine and then on to the CareVue Clinical Information"
^DIC(9.4,11,22,5.03,"PAH",16,1,125,0)="Management System."
^DIC(9.4,11,22,5.03,"PAH",16,1,126,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,127,0)="Each facility will need to refer to the CareVue Interface Specifications"
^DIC(9.4,11,22,5.03,"PAH",16,1,128,0)="manual LA7DIS.PDF as noted above for further requirements regarding"
^DIC(9.4,11,22,5.03,"PAH",16,1,129,0)="interface engines."
^DIC(9.4,11,22,5.03,"PAH",16,1,130,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,131,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",16,1,132,0)="=========================="
^DIC(9.4,11,22,5.03,"PAH",16,1,133,0)="The patch is distributed in KIDS format in a PackMan message."
^DIC(9.4,11,22,5.03,"PAH",16,1,134,0)="It is recommended that this patch be installed in a test environment first"
^DIC(9.4,11,22,5.03,"PAH",16,1,135,0)="before installing into production.  Each environment (test and production)"
^DIC(9.4,11,22,5.03,"PAH",16,1,136,0)="uses a separate database and a separate integration interface.  Because of"
^DIC(9.4,11,22,5.03,"PAH",16,1,137,0)="this the data that is communicated from VistA may not always be consistent"
^DIC(9.4,11,22,5.03,"PAH",16,1,138,0)="with the data that will be communicated from the production environment."
^DIC(9.4,11,22,5.03,"PAH",16,1,139,0)="Another impact is that patient data may have to be manually entered into"
^DIC(9.4,11,22,5.03,"PAH",16,1,140,0)="the VistA test environment in order to test the proper handling of"
^DIC(9.4,11,22,5.03,"PAH",16,1,141,0)="messages going to VistA."
^DIC(9.4,11,22,5.03,"PAH",16,1,142,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,143,0)="The install time for this patch is less than 2 minutes. This patch can be"
^DIC(9.4,11,22,5.03,"PAH",16,1,144,0)="installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",16,1,145,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,146,0)="1.    All routines installed with this patch are new to the system and "
^DIC(9.4,11,22,5.03,"PAH",16,1,147,0)="      mapping is not recommended."
^DIC(9.4,11,22,5.03,"PAH",16,1,148,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,149,0)="2.    Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.      "
^DIC(9.4,11,22,5.03,"PAH",16,1,150,0)="      This option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",16,1,151,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,152,0)="3.    The patch has now been loaded into a Transport global on your   "
^DIC(9.4,11,22,5.03,"PAH",16,1,153,0)="      system. You now need to use KIDS to install the transport "
^DIC(9.4,11,22,5.03,"PAH",16,1,154,0)="      global."
^DIC(9.4,11,22,5.03,"PAH",16,1,155,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,156,0)="       On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,11,22,5.03,"PAH",16,1,157,0)="       following options:"
^DIC(9.4,11,22,5.03,"PAH",16,1,158,0)="           Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",16,1,159,0)="           Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",16,1,160,0)="           Verify Checksums in Transport Global"
^DIC(9.4,11,22,5.03,"PAH",16,1,161,0)="           Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",16,1,162,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,163,0)="4.    Use the 'Install Package(s)' option under the 'Installation' men"
^DIC(9.4,11,22,5.03,"PAH",16,1,164,0)="      and select the package 'LA*5.2*53'.  When prompted 'Want to "
^DIC(9.4,11,22,5.03,"PAH",16,1,165,0)="      DISABLE Scheduled Options, Menu Options, and Protocols? YES//',  "
^DIC(9.4,11,22,5.03,"PAH",16,1,166,0)="      choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",16,1,167,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,168,0)="5.    At the DEVICE prompt, you can send your output to any printer of"
^DIC(9.4,11,22,5.03,"PAH",16,1,169,0)="      HFS file, display it on the terminal screen, or queue it to run "
^DIC(9.4,11,22,5.03,"PAH",16,1,170,0)="      at a scheduled time."
^DIC(9.4,11,22,5.03,"PAH",16,1,171,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,172,0)="6.    No options need to be placed out of service."
^DIC(9.4,11,22,5.03,"PAH",16,1,173,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,174,0)="7.    This installation automatically adds the two new protocols to "
^DIC(9.4,11,22,5.03,"PAH",16,1,175,0)="      the PROTOCOL file (#101). They are:  LA7D CARELIFE RESULTS"
^DIC(9.4,11,22,5.03,"PAH",16,1,176,0)="                                           LA7D CARELIFE SERVER"
^DIC(9.4,11,22,5.03,"PAH",16,1,177,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,178,0)="8.    User will need to enter your facility name in the HL7 "
^DIC(9.4,11,22,5.03,"PAH",16,1,179,0)="      APPPLICATION PARAMETER file (#771)."
^DIC(9.4,11,22,5.03,"PAH",16,1,180,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,181,0)="NOTE:  Fields marked with  <-- below need to have information entered."
^DIC(9.4,11,22,5.03,"PAH",16,1,182,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,183,0)="Select OPTION: ENTER OR EDIT FILE ENTRIES  <--  "
^DIC(9.4,11,22,5.03,"PAH",16,1,184,0)="INPUT TO WHAT FILE: FOREIGN INTERFACE// HL7 APPLICATION PARAMETER <--  "
^DIC(9.4,11,22,5.03,"PAH",16,1,185,0)="                                          (34 entries)"
^DIC(9.4,11,22,5.03,"PAH",16,1,186,0)="EDIT WHICH FIELD: ALL// FACILITY NAME  <--  "
^DIC(9.4,11,22,5.03,"PAH",16,1,187,0)="THEN EDIT FIELD: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,188,0)="Select HL7 APPLICATION PARAMETER NAME: DHCP CARELIFE        ACTIVE <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,189,0)="FACILITY NAME: 428// 428      enter your facility name here        <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,190,0)="Select HL7 APPLICATION PARAMETER NAME: MRTS CARELIFE        ACTIVE <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,191,0)="FACILITY NAME: 642// 428     enter your facility name here         <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,192,0)="Select HL7 APPLICATION PARAMETER NAME: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,193,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,194,0)="9.    The new mail group CARELIFE RESULT ERROR was created as part of "
^DIC(9.4,11,22,5.03,"PAH",16,1,195,0)="      the installation.  However the entry in the MAIL GROUP file (3.8)"
^DIC(9.4,11,22,5.03,"PAH",16,1,196,0)="      is only a stub and requires the site to perform the following edit:"
^DIC(9.4,11,22,5.03,"PAH",16,1,197,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,198,0)="NOTE:  Fields marked with <--  below need to have information entered."
^DIC(9.4,11,22,5.03,"PAH",16,1,199,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,200,0)="Select MAIL GROUP NAME: CARELIFE RESULT ERROR  <--  "
^DIC(9.4,11,22,5.03,"PAH",16,1,201,0)="NAME: CARELIFE RESULT ERROR  Replace "
^DIC(9.4,11,22,5.03,"PAH",16,1,202,0)="Select MEMBER: CROSS,PAM                 <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,203,0)="  Are you adding 'CROSS,PAM' as a new MEMBER (the 1ST for this MAIL"
^DIC(9.4,11,22,5.03,"PAH",16,1,204,0)="GROUP)"
^DIC(9.4,11,22,5.03,"PAH",16,1,205,0)="? No// Y (Yes)                                 <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,206,0)="  TYPE: "
^DIC(9.4,11,22,5.03,"PAH",16,1,207,0)="Select MEMBER: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,208,0)="DESCRIPTION:"
^DIC(9.4,11,22,5.03,"PAH",16,1,209,0)="  No existing text"
^DIC(9.4,11,22,5.03,"PAH",16,1,210,0)="  Edit? NO//  YES                              <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,211,0)="  All error report for CAREVUE ORU Messages    <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,212,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,213,0)="TYPE: public// PUBLIC                          <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,214,0)="ORGANIZER: CROSS,PAM                     <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,215,0)="COORDINATOR: CROSS,PAM                   <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,216,0)="Select AUTHORIZED SENDER: "
^DIC(9.4,11,22,5.03,"PAH",16,1,217,0)="ALLOW SELF ENROLLMENT?: NO//  NO               <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,218,0)="REFERENCE COUNT: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,219,0)="LAST REFERENCED:  <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,220,0)="RESTRICTIONS: INDIV/LOCAL/ORGANIZER// <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,221,0)="Select MEMBER GROUP NAME: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,222,0)="Select REMOTE MEMBER: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,223,0)="Select DISTRIBUTION LIST: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,224,0)="Select FAX RECIPIENT: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,225,0)="Select FAX GROUP: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,226,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,227,0)="Select MAIL GROUP NAME: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,228,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,229,0)="10.     The FOREIGN INTERFACE file (#62.487) was put on the system during"
^DIC(9.4,11,22,5.03,"PAH",16,1,230,0)="        the installation process but it does not contain any data.  You"
^DIC(9.4,11,22,5.03,"PAH",16,1,231,0)="        must enter your site's data concerning your CareVue wards.  This"
^DIC(9.4,11,22,5.03,"PAH",16,1,232,0)="        option will need to be added to users secondary menus under the"
^DIC(9.4,11,22,5.03,"PAH",16,1,233,0)="        namespace LA7D."
^DIC(9.4,11,22,5.03,"PAH",16,1,234,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,235,0)="NOTE:  Fields marked with <-- below need to have information entered."
^DIC(9.4,11,22,5.03,"PAH",16,1,236,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,237,0)="Select MailMan Menu Option: Edit Foreign Interface Parameters   "
^DIC(9.4,11,22,5.03,"PAH",16,1,238,0)="Enter BEDSIDE MONITOR INTERFACE NAME: CAREVUE <--   "
^DIC(9.4,11,22,5.03,"PAH",16,1,239,0)="Enter CAREVUE WARD: ICU         <--      enter your CareVue wards here"
^DIC(9.4,11,22,5.03,"PAH",16,1,240,0)="Enter CAREVUE WARD: ADMISSIONS  <-- "
^DIC(9.4,11,22,5.03,"PAH",16,1,241,0)="Enter CAREVUE WARD: ^"
^DIC(9.4,11,22,5.03,"PAH",16,1,242,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,243,0)="   **NOTE** "
^DIC(9.4,11,22,5.03,"PAH",16,1,244,0)="       All wards in the hospital location file (#44) that will be"
^DIC(9.4,11,22,5.03,"PAH",16,1,245,0)="       used for the CareVue interface must have a UNIQUE abbreviation for"
^DIC(9.4,11,22,5.03,"PAH",16,1,246,0)="       each ward (Inactive and Active)"
^DIC(9.4,11,22,5.03,"PAH",16,1,247,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,248,0)="11.     Set up Logical Link for HL7 parameters.  This will need to contain"
^DIC(9.4,11,22,5.03,"PAH",16,1,249,0)="        the outgoing device name used from VistA to the interface engine."
^DIC(9.4,11,22,5.03,"PAH",16,1,250,0)="        Sites should ensure that entries corresponding to their unique"
^DIC(9.4,11,22,5.03,"PAH",16,1,251,0)="        system requirements be input at the recommended places."
^DIC(9.4,11,22,5.03,"PAH",16,1,252,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,253,0)="NOTE:  Fields marked with <-- below need to have information entered."
^DIC(9.4,11,22,5.03,"PAH",16,1,254,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,255,0)="Select Systems Manager Menu Option:  HL7 Main Menu"
^DIC(9.4,11,22,5.03,"PAH",16,1,256,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,257,0)="Select HL7 Main Menu Option:  V1.6 OPTIONS"
^DIC(9.4,11,22,5.03,"PAH",16,1,258,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,259,0)="Slect V1.6 OPTIONS Option:  Interface Workbench"
^DIC(9.4,11,22,5.03,"PAH",16,1,260,0)="At the bottom of the screen you will see:"
^DIC(9.4,11,22,5.03,"PAH",16,1,261,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,262,0)="Select Tool: Jump to Next App// SL   Show Logical Links"
^DIC(9.4,11,22,5.03,"PAH",16,1,263,0)="Select Tool: Jump to Next Link// CL  Create Logical Link"
^DIC(9.4,11,22,5.03,"PAH",16,1,264,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,265,0)="Select HL LOGICAL LINK NODE:  VOICE1   <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,266,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,267,0)="Logical Link information"
^DIC(9.4,11,22,5.03,"PAH",16,1,268,0)="------------------------"
^DIC(9.4,11,22,5.03,"PAH",16,1,269,0)="Queue Size:  245             <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,270,0)="LLP Parameter:  HLLP         <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,271,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,272,0)="LLP Parameters"
^DIC(9.4,11,22,5.03,"PAH",16,1,273,0)="--------------"
^DIC(9.4,11,22,5.03,"PAH",16,1,274,0)="LLP Type:  HLLP              <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,275,0)="Device: OG_LAB_PROD          <--  this will be your device name"
^DIC(9.4,11,22,5.03,"PAH",16,1,276,0)="Version ID: 2.3              <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,277,0)="Block Size: 245              <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,278,0)="Read Timeout: 30             <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,279,0)="ACK Timeout: 2               <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,280,0)="Re-transmission Attempts: 3  <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,281,0)="Start Block Character: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,282,0)="End Block Character: <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,283,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,284,0)="Select Tool: Jump to Next Link// ^"
^DIC(9.4,11,22,5.03,"PAH",16,1,285,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,286,0)="NOTE:  Add the Logical Link just created to the LA7D CARELIFE"
^DIC(9.4,11,22,5.03,"PAH",16,1,287,0)="       RESULTS protocol."
^DIC(9.4,11,22,5.03,"PAH",16,1,288,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,289,0)="NOTE:  Fields marked with <-- below need to have information entered."
^DIC(9.4,11,22,5.03,"PAH",16,1,290,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,291,0)="Select OPTION: ENTER OR EDIT FILE ENTRIES  "
^DIC(9.4,11,22,5.03,"PAH",16,1,292,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,293,0)="INPUT TO WHAT FILE: PROTOCOL// PROTOCOL  <--  (3569 entries)"
^DIC(9.4,11,22,5.03,"PAH",16,1,294,0)="EDIT WHICH FIELD: ALL// NAME             <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,295,0)="THEN EDIT FIELD: LOGICAL LINK            <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,296,0)="THEN EDIT FIELD: "
^DIC(9.4,11,22,5.03,"PAH",16,1,297,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,298,0)="Select PROTOCOL NAME: LA7D CARELIFE RESULTS <--"
^DIC(9.4,11,22,5.03,"PAH",16,1,299,0)="     This client is tied to the MRTS CARELIFE entry"
^DIC(9.4,11,22,5.03,"PAH",16,1,300,0)="NAME: LA7D CARELIFE RESULTS  Replace <RET>"
^DIC(9.4,11,22,5.03,"PAH",16,1,301,0)="LOGICAL LINK: OG_LAB_PROD    <--  Enter your Logical Link that was set up"
^DIC(9.4,11,22,5.03,"PAH",16,1,302,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,303,0)="12.     Follow the Interface Specifications Manual LA7DIS.PDF for"
^DIC(9.4,11,22,5.03,"PAH",16,1,304,0)="        interface engine requirements."
^DIC(9.4,11,22,5.03,"PAH",16,1,305,0)=" "
^DIC(9.4,11,22,5.03,"PAH",16,1,306,0)="13.     Follow the CareVue Test Plan Manual LA7DTP.PDF to test the CareVue"
^DIC(9.4,11,22,5.03,"PAH",16,1,307,0)="        package."
^DIC(9.4,11,22,5.03,"PAH",17,0)="55 SEQ #37^3000711^1"
^DIC(9.4,11,22,5.03,"PAH",17,1,0)="^^198^198^3000711"
^DIC(9.4,11,22,5.03,"PAH",17,1,1,0)="VISTA Laboratory Package patch LA*5.2*55 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",17,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",17,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,4,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,5,0)="DESCRIPTION"
^DIC(9.4,11,22,5.03,"PAH",17,1,6,0)="==========="
^DIC(9.4,11,22,5.03,"PAH",17,1,7,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,8,0)="The LEDI Setup option [LA7V SETUP] fails to add the member S.HL V16"
^DIC(9.4,11,22,5.03,"PAH",17,1,9,0)="SERVER@remote mail domain to the mail group used to transmit HL7 messages"
^DIC(9.4,11,22,5.03,"PAH",17,1,10,0)="via the MailMan transmission protocol. This occurs when the entry in the"
^DIC(9.4,11,22,5.03,"PAH",17,1,11,0)="INSTITUTION file (#4) has an internal entry number which is different"
^DIC(9.4,11,22,5.03,"PAH",17,1,12,0)="from the VA Station Number. The software is assuming that the station"
^DIC(9.4,11,22,5.03,"PAH",17,1,13,0)="number and the internal entry are the same."
^DIC(9.4,11,22,5.03,"PAH",17,1,14,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,15,0)="Routines LA7VLL, LA7VSET, and LA7VSET1 have been changed to use the"
^DIC(9.4,11,22,5.03,"PAH",17,1,16,0)="internal entry number from the INSTITUTION file when retrieving the DOMAIN"
^DIC(9.4,11,22,5.03,"PAH",17,1,17,0)="field from the INSTITUTION file."
^DIC(9.4,11,22,5.03,"PAH",17,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,19,0)="The patch also corrects the misspelling of the word ""transmissions"" in "
^DIC(9.4,11,22,5.03,"PAH",17,1,20,0)="routines LA7VSET and LA7VSET1."
^DIC(9.4,11,22,5.03,"PAH",17,1,21,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,22,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,23,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",17,1,24,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",17,1,25,0)=" CHA-0300-32805 "
^DIC(9.4,11,22,5.03,"PAH",17,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,27,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",17,1,28,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",17,1,29,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,30,0)=" Charleston VAMC "
^DIC(9.4,11,22,5.03,"PAH",17,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,32,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,33,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",17,1,34,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",17,1,35,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,36,0)="  The following is a list of routines included in this patch."
^DIC(9.4,11,22,5.03,"PAH",17,1,37,0)="  The second line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",17,1,38,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,39,0)="  <tab>;;5.2;AUTOMATED LAB INSTRUMENTS;**[Patch List]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",17,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,41,0)="                    CHECK^XTSUMBLD results"
^DIC(9.4,11,22,5.03,"PAH",17,1,42,0)="  "
^DIC(9.4,11,22,5.03,"PAH",17,1,43,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",17,1,44,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",17,1,45,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",17,1,46,0)="   LA55             N/A            4557897        **55**(deleted by KIDS)"
^DIC(9.4,11,22,5.03,"PAH",17,1,47,0)="   LA7VLL           4967061        5170411        **27,51,55**"
^DIC(9.4,11,22,5.03,"PAH",17,1,48,0)="   LA7VSET          19562009       19500034       **27,51,55**"
^DIC(9.4,11,22,5.03,"PAH",17,1,49,0)="   LA7VSET1         12823333       12858976       **27,51,55**"
^DIC(9.4,11,22,5.03,"PAH",17,1,50,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,51,0)=""
^DIC(9.4,11,22,5.03,"PAH",17,1,52,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,53,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",17,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,55,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",17,1,56,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",17,1,57,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,58,0)="  The install time for this patch is less than 5 minutes. This patch"
^DIC(9.4,11,22,5.03,"PAH",17,1,59,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,11,22,5.03,"PAH",17,1,60,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",17,1,61,0)="  However the following conditions apply:"
^DIC(9.4,11,22,5.03,"PAH",17,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,63,0)="     - The install will disable LEDI Setup option during installation."
^DIC(9.4,11,22,5.03,"PAH",17,1,64,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,66,0)="NOTE: Kernel and MailMan patches must be current on the target system"
^DIC(9.4,11,22,5.03,"PAH",17,1,67,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",17,1,68,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,69,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",17,1,70,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",17,1,71,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,72,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,73,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",17,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,75,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",17,1,76,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",17,1,77,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,78,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",17,1,79,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",17,1,80,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,81,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",17,1,82,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",17,1,83,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,84,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",17,1,85,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",17,1,86,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,87,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",17,1,88,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",17,1,89,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",17,1,90,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",17,1,91,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",17,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,93,0)="      If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,11,22,5.03,"PAH",17,1,94,0)="      prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,11,22,5.03,"PAH",17,1,95,0)="      option at this time.  You may also compare the routines in your"
^DIC(9.4,11,22,5.03,"PAH",17,1,96,0)="      production account to the routines in the patch by using the 'Compare"
^DIC(9.4,11,22,5.03,"PAH",17,1,97,0)="      a Transport Global to Current System' option."
^DIC(9.4,11,22,5.03,"PAH",17,1,98,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,99,0)="  7.  The install will disable the following Lab verifying options during"
^DIC(9.4,11,22,5.03,"PAH",17,1,100,0)="      patch installation."
^DIC(9.4,11,22,5.03,"PAH",17,1,101,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,102,0)="      LEDI Setup [LA7V SETUP]"
^DIC(9.4,11,22,5.03,"PAH",17,1,103,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,104,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,105,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",17,1,106,0)="      and select the package 'LA*5.2*55'.  When prompted 'Want to"
^DIC(9.4,11,22,5.03,"PAH",17,1,107,0)="      DISABLE Scheduled Options, Menu Options, and Protocols? YES//',"
^DIC(9.4,11,22,5.03,"PAH",17,1,108,0)="      choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",17,1,109,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,110,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",17,1,111,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,112,0)=" 10. Routine LA55 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",17,1,113,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,114,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,115,0)="POST-INSTALLATION INSTRUCTIONS: NONE"
^DIC(9.4,11,22,5.03,"PAH",17,1,116,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,119,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,120,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",17,1,121,0)="Installation example: "
^DIC(9.4,11,22,5.03,"PAH",17,1,122,0)=" "
^DIC(9.4,11,22,5.03,"PAH",17,1,123,0)="Select Installation Option: 6  Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",17,1,124,0)="Select INSTALL NAME: LA*5.2*55  Loaded from Distribution  4/13/00@10:16:44"
^DIC(9.4,11,22,5.03,"PAH",17,1,125,0)="     => LA*5.2*55"
^DIC(9.4,11,22,5.03,"PAH",17,1,126,0)=" "
