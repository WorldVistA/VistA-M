^DIC(9.4,186,22,2,"PAH",19,0)="20 SEQ #19^3130514.142909^17"
^DIC(9.4,186,22,2,"PAH",20,0)="23 SEQ #20^3140618.123305^17"
^DIC(9.4,186,22,2,"PAH",21,0)="19 SEQ #21^3140902.12544^17"
^DIC(9.4,186,22,2,"PAH",21,1,0)="^^1^1^3140902"
^DIC(9.4,186,22,2,"PAH",21,1,1,0)="Build for ICD-10 Class 1 Remediation"
^DIC(9.4,186,22,2,"PAH",22,0)="21 SEQ #22^3141125.151858^17"
^DIC(9.4,186,22,2,"PAH",22,1,0)="^^3^3^3141125"
^DIC(9.4,186,22,2,"PAH",22,1,1,0)="Enhancements to Clinical Case Registries to include new SLEEP APNEA "
^DIC(9.4,186,22,2,"PAH",22,1,2,0)="registry and report enhancements for screen on gender and addition of "
^DIC(9.4,186,22,2,"PAH",22,1,3,0)="optional ICN column."
^DIC(9.4,186,22,2,"PAH",23,0)="22 SEQ #23^3150106.120233^17"
^DIC(9.4,186,22,2,"PAH",23,1,0)="^^4^4^3150106"
^DIC(9.4,186,22,2,"PAH",23,1,1,0)="Updates for ICD-10 for local registries, add additional data element"
^DIC(9.4,186,22,2,"PAH",23,1,2,0)="OEF/OIF/OND period of service for selection of patients, notify mail group"
^DIC(9.4,186,22,2,"PAH",23,1,3,0)="if nightly job does not run due to user not possessing the ROR VA IRM"
^DIC(9.4,186,22,2,"PAH",23,1,4,0)="security key and add 2 new HEP-C registry drugs."
^DIC(9.4,186,22,2,"PAH",24,0)="24 SEQ #24^3150203.101136^17"
^DIC(9.4,186,22,2,"PAH",24,1,0)="^^2^2^3150203"
^DIC(9.4,186,22,2,"PAH",24,1,1,0)="Patch reference and additional information may be found on Forum for "
^DIC(9.4,186,22,2,"PAH",24,1,2,0)="ROR*1.5*24"
^DIC(9.4,186,22,2,"PAH",25,0)="27 SEQ #25^3150610.154435^17"
^DIC(9.4,186,22,2,"PAH",25,1,0)="^^2^2^3150610"
^DIC(9.4,186,22,2,"PAH",25,1,1,0)="Enhancements to Clinical Case Registries to include new registries"
^DIC(9.4,186,22,2,"PAH",25,1,2,0)="and report enhancements."
^DIC(9.4,186,22,2,"PAH",26,0)="25^3150916.111012^17"
^DIC(9.4,186,22,2,"PAH",26,1,0)="^^2^2^3150916"
^DIC(9.4,186,22,2,"PAH",26,1,1,0)="Updates to support ICD-10 for PTF's increase in the number of ICD-10"
^DIC(9.4,186,22,2,"PAH",26,1,2,0)="codes to 25."
^DIC(9.4,186,22,2,"PAH",27,0)="26 SEQ #27^3151211.144304^17"
^DIC(9.4,186,22,2,"PAH",27,1,0)="^^2^2^3151211"
^DIC(9.4,186,22,2,"PAH",27,1,1,0)="Patch reference and additional information may be found on Forum for "
^DIC(9.4,186,22,2,"PAH",27,1,2,0)="ROR*1.5*26"
^DIC(9.4,186,22,2,"PAH",28,0)="28 SEQ #28^3160815.124158^54"
^DIC(9.4,186,22,2,"PAH",28,1,0)="^^2^2^3160815"
^DIC(9.4,186,22,2,"PAH",28,1,1,0)="Patch reference and additional information may be found on Forum for "
^DIC(9.4,186,22,2,"PAH",28,1,2,0)="patch ROR*1.5*28"
^DIC(9.4,186,22,2,"PAH",29,0)="29 SEQ #29^3170123.142944^54"
^DIC(9.4,186,22,2,"PAH",29,1,0)="^^6^6^3170123"
^DIC(9.4,186,22,2,"PAH",29,1,1,0)="This patch contains changes to the following:"
^DIC(9.4,186,22,2,"PAH",29,1,2,0)=" "
^DIC(9.4,186,22,2,"PAH",29,1,3,0)="1.      A new Selection Panel on each report to allow the user to limit "
^DIC(9.4,186,22,2,"PAH",29,1,4,0)="the report to patients with a diagnosis of interest in a date range. "
^DIC(9.4,186,22,2,"PAH",29,1,5,0)=" "
^DIC(9.4,186,22,2,"PAH",29,1,6,0)="2.      Two new reports Hep A and Hep B are included in this patch. "
^DIC(9.4,186,22,2,"PAH",30,0)="30 SEQ #30^3170830.171812^54"
^DIC(9.4,186,22,2,"PAH",30,1,0)="^^23^23^3170830"
^DIC(9.4,186,22,2,"PAH",30,1,1,0)="Include two New Registries: "
^DIC(9.4,186,22,2,"PAH",30,1,2,0)="    VA IPF         - Idiopathic Pulmonary Fibrosis (IPF) Registry"
^DIC(9.4,186,22,2,"PAH",30,1,3,0)="    VA HYPOPARA    - Hypoparathyroidism Registry"
^DIC(9.4,186,22,2,"PAH",30,1,4,0)=" "
^DIC(9.4,186,22,2,"PAH",30,1,5,0)="The following medications will be added to the ROR GENERIC DRUG File "
^DIC(9.4,186,22,2,"PAH",30,1,6,0)="(#799.51):"
^DIC(9.4,186,22,2,"PAH",30,1,7,0)="    Add HEPC Registry Medication SOFOSBUVIR/VELPATASVIR"
^DIC(9.4,186,22,2,"PAH",30,1,8,0)=" "
^DIC(9.4,186,22,2,"PAH",30,1,9,0)="The medication, SOFOSBUVIR/VELPATASVIR, will be added to the ROR GENERIC"
^DIC(9.4,186,22,2,"PAH",30,1,10,0)="DRUG file (#799.51) as a NATIONAL entry for use in the CCR VA HEPC "
^DIC(9.4,186,22,2,"PAH",30,1,11,0)="Registry."
^DIC(9.4,186,22,2,"PAH",30,1,12,0)=" "
^DIC(9.4,186,22,2,"PAH",30,1,13,0)="Added code to change the LOINC Codes result values to uppercase as "
^DIC(9.4,186,22,2,"PAH",30,1,14,0)="positive values were being missed if the site used mixed case to store a "
^DIC(9.4,186,22,2,"PAH",30,1,15,0)="positive result. "
^DIC(9.4,186,22,2,"PAH",30,1,16,0)=" "
^DIC(9.4,186,22,2,"PAH",30,1,17,0)="Update Labels to Reference ""Birth"
^DIC(9.4,186,22,2,"PAH",30,1,18,0)="Sex"" on all Report Panels"
^DIC(9.4,186,22,2,"PAH",30,1,19,0)="The existing ""Sex"" labels on all report panels will be changed to ""Birth "
^DIC(9.4,186,22,2,"PAH",30,1,20,0)="Sex.""  In addition, the change will be implemented under Report Options "
^DIC(9.4,186,22,2,"PAH",30,1,21,0)="in the General Utilization and Demographics Report Selection Panel.  As "
^DIC(9.4,186,22,2,"PAH",30,1,22,0)="this list is alphabetized, the order will change to maintain alphabetical "
^DIC(9.4,186,22,2,"PAH",30,1,23,0)="order.  "
^DIC(9.4,186,22,2,"PAH",31,0)="31 SEQ #31^3180131.163614^54"
^DIC(9.4,186,22,2,"PAH",31,1,0)="^^2^2^3180131"
^DIC(9.4,186,22,2,"PAH",31,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,186,22,2,"PAH",31,1,2,0)="under ROR*1.5*31."
^DIC(9.4,186,22,2,"PAH",32,0)="32 SEQ #32^3180425.172748^54"
^DIC(9.4,186,22,2,"PAH",32,1,0)="^^2^2^3180425"
^DIC(9.4,186,22,2,"PAH",32,1,1,0)="Patch reference and additional information may be found on Forum for "
^DIC(9.4,186,22,2,"PAH",32,1,2,0)="ROR*1.5*32."
^DIC(9.4,186,22,2,"PAH",33,0)="33 SEQ #33^3180925.152332^54"
^DIC(9.4,186,22,2,"PAH",33,1,0)="^^29^29^3180925"
^DIC(9.4,186,22,2,"PAH",33,1,1,0)="1. Six new local registries added"
^DIC(9.4,186,22,2,"PAH",33,1,2,0)="2. Three new medications are added to the ROR GENERIC DRUG file"
^DIC(9.4,186,22,2,"PAH",33,1,3,0)="   (#799.51) to be used as inclusion criteria for patients in the"
^DIC(9.4,186,22,2,"PAH",33,1,4,0)="   respective registry(s)."
^DIC(9.4,186,22,2,"PAH",33,1,5,0)="      a. HIV registry    : "
^DIC(9.4,186,22,2,"PAH",33,1,6,0)="            BICTEGRAVIR/EMTRICITABINE/TENOFOVIR"
^DIC(9.4,186,22,2,"PAH",33,1,7,0)=" "
^DIC(9.4,186,22,2,"PAH",33,1,8,0)="            EFAVIRENZ/LAMIVUDINE/TENOFOVIR"
^DIC(9.4,186,22,2,"PAH",33,1,9,0)=" "
^DIC(9.4,186,22,2,"PAH",33,1,10,0)="            LAMIVUDINE/ TDF"
^DIC(9.4,186,22,2,"PAH",33,1,11,0)="  "
^DIC(9.4,186,22,2,"PAH",33,1,12,0)=" 3. A  new Future Appointment selection paneladded to selected reports"
^DIC(9.4,186,22,2,"PAH",33,1,13,0)=" 4. The new panel will have a radio button with a label "
^DIC(9.4,186,22,2,"PAH",33,1,14,0)="    ""All Patients"" which will be the default. A second button"
^DIC(9.4,186,22,2,"PAH",33,1,15,0)="     with a label ""Only patients with an appointment in the"
^DIC(9.4,186,22,2,"PAH",33,1,16,0)="     next X days""."
^DIC(9.4,186,22,2,"PAH",33,1,17,0)=" "
^DIC(9.4,186,22,2,"PAH",33,1,18,0)="5. On the report header for reports that display ""Only patients with"
^DIC(9.4,186,22,2,"PAH",33,1,19,0)="    appointment in the X number of days"", new text will be displayed as"
^DIC(9.4,186,22,2,"PAH",33,1,20,0)="    follows to et the user know that the report was run for future "
^DIC(9.4,186,22,2,"PAH",33,1,21,0)="    appointments only."
^DIC(9.4,186,22,2,"PAH",33,1,22,0)=" "
^DIC(9.4,186,22,2,"PAH",33,1,23,0)="6. New LOINC codes have been added to the ROR LAB SEARCH file (#798.9) "
^DIC(9.4,186,22,2,"PAH",33,1,24,0)="   to add patients to the HIV pending list."
^DIC(9.4,186,22,2,"PAH",33,1,25,0)="7. A correction was made on the Combined Meds and Labs, "
^DIC(9.4,186,22,2,"PAH",33,1,26,0)="    DAA Lab Monitoring, Hepatitis A and the Hepatitis B"
^DIC(9.4,186,22,2,"PAH",33,1,27,0)="    reports when sorting by the ICN, PACT or PCP columns. "
^DIC(9.4,186,22,2,"PAH",33,1,28,0)="      "
^DIC(9.4,186,22,2,"PAH",33,1,29,0)=" 8. The version of the CCR software has been updated "
^DIC(9.4,186,22,2,"PAH",34,0)="34 SEQ #34^3190501.1601^54"
^DIC(9.4,186,22,2,"PAH",34,1,0)="^^9^9^3190501"
^DIC(9.4,186,22,2,"PAH",34,1,1,0)="The following functionality is included in this patch."
^DIC(9.4,186,22,2,"PAH",34,1,2,0)=" "
^DIC(9.4,186,22,2,"PAH",34,1,3,0)="Current Inpatient report with admission date time for diagnosis."
^DIC(9.4,186,22,2,"PAH",34,1,4,0)=" "
^DIC(9.4,186,22,2,"PAH",34,1,5,0)="All reports with future appointments listed will include the future "
^DIC(9.4,186,22,2,"PAH",34,1,6,0)="clinic also."
^DIC(9.4,186,22,2,"PAH",34,1,7,0)=" "
^DIC(9.4,186,22,2,"PAH",34,1,8,0)="Fix Hep A/B LOINC code table."
^DIC(9.4,186,22,2,"PAH",34,1,9,0)="Add Future Appointment panel to the Diagnosis and Procedure reports"
^DIC(9.4,186,22,2,"PAH",35,0)="35 SEQ #35^3200305.154955^17"
^DIC(9.4,186,22,2,"PAH",35,1,0)="^^12^12^3200305"
^DIC(9.4,186,22,2,"PAH",35,1,1,0)="Two new local registries will be added to this patch.  VA HEAD AND NECK "
^DIC(9.4,186,22,2,"PAH",35,1,2,0)="and VA HYPOTHYROIDISM."
^DIC(9.4,186,22,2,"PAH",35,1,3,0)="The AUTO CONFIRM  field of the ROR REGISTRY PARAMETERS (798.1) will be "
^DIC(9.4,186,22,2,"PAH",35,1,4,0)="set to Yes to auto confirm for the two national registries VA HEPC and VA "
^DIC(9.4,186,22,2,"PAH",35,1,5,0)="HIV."
^DIC(9.4,186,22,2,"PAH",35,1,6,0)="All code pertaining to pending in the two national registries VA HEPC and "
^DIC(9.4,186,22,2,"PAH",35,1,7,0)="VA HIV will be documented in the code as pending but will be commented as "
^DIC(9.4,186,22,2,"PAH",35,1,8,0)="such."
^DIC(9.4,186,22,2,"PAH",35,1,9,0)="A new HIV drug will be added to the file."
^DIC(9.4,186,22,2,"PAH",35,1,10,0)="A conversion included in the post-init to set the status from pending to "
^DIC(9.4,186,22,2,"PAH",35,1,11,0)="confirmed for all HEPC and HIV records in the registries.   Also pending "
^DIC(9.4,186,22,2,"PAH",35,1,12,0)="comments will be deleted out."
^DIC(9.4,186,22,2,"PAH",36,0)="36 SEQ #36^3200624.140204^65"
^DIC(9.4,186,22,2,"PAH",36,1,0)="^^1^1^3200624"
^DIC(9.4,186,22,2,"PAH",36,1,1,0)="Create and populate the VA COVID19 registry."
^DIC(9.4,186,22,2,"PAH",37,0)="37 SEQ #37^3210304.101833^17"
^DIC(9.4,186,22,2,"PAH",37,1,0)="^^7^7^3210304"
^DIC(9.4,186,22,2,"PAH",37,1,1,0)="This patch adds a new registry called VA RECENT PATIENTS that adds "
^DIC(9.4,186,22,2,"PAH",37,1,2,0)="patients that have had an admission or an event within the last two "
^DIC(9.4,186,22,2,"PAH",37,1,3,0)="years.  The nightly job ROR TASK when runs will set those entries in the "
^DIC(9.4,186,22,2,"PAH",37,1,4,0)="VA RECENT PATIENTS registy to a status of delete (5) if the entry has not "
^DIC(9.4,186,22,2,"PAH",37,1,5,0)="had activity within the last two years.  Also 34 new LOINC"
^DIC(9.4,186,22,2,"PAH",37,1,6,0)="codes have been added to the ROR LAB SEARCH file for the VA COVID19 "
^DIC(9.4,186,22,2,"PAH",37,1,7,0)="registry."
^DIC(9.4,186,22,2,"PAH",38,0)="38 SEQ #38^3210927.090453^17"
^DIC(9.4,186,22,2,"PAH",38,1,0)="^^9^9^3210927"
^DIC(9.4,186,22,2,"PAH",38,1,1,0)="The Clinical Case Registries (CCR) identifies patients with positive "
^DIC(9.4,186,22,2,"PAH",38,1,2,0)="antibody results for inclusion in the HIV and HCV registries. This patch "
^DIC(9.4,186,22,2,"PAH",38,1,3,0)="fixes an error where patients with laboratory results that are not "
^DIC(9.4,186,22,2,"PAH",38,1,4,0)="positive are incorrectly categorized as positive and are incorrectly "
^DIC(9.4,186,22,2,"PAH",38,1,5,0)="included in the HIV and HCV registries. Code changes have been made to the"
^DIC(9.4,186,22,2,"PAH",38,1,6,0)="RORUPD04 and RORX024A routines to rectify this issue."
^DIC(9.4,186,22,2,"PAH",38,1,7,0)=" "
^DIC(9.4,186,22,2,"PAH",38,1,8,0)="A revised Graphical User Interface (GUI) executable is included in the"
^DIC(9.4,186,22,2,"PAH",38,1,9,0)="patch so the version of the CCR software is updated to 1.5.38."
^DIC(9.4,186,22,2,"PAH",39,0)="39 SEQ #39^3220303.150023^17"
^DIC(9.4,186,22,2,"PAH",39,1,0)="^^3^3^3220303"
^DIC(9.4,186,22,2,"PAH",39,1,1,0)=" "
^DIC(9.4,186,22,2,"PAH",39,1,2,0)="Routines changed to eliminate the SSN number from display."
^DIC(9.4,186,22,2,"PAH",39,1,3,0)="DIALOG changes for SSN."
^DIC(9.4,186,22,2,"PAH",40,0)="40 SEQ #40^3221201.114716^89"
^DIC(9.4,186,22,2,"PAH",40,1,0)="^^4^4^3221201"
^DIC(9.4,186,22,2,"PAH",40,1,1,0)="Two drugs are added to the ROR GENERIC DRUG (#799.51) file for use by the"
^DIC(9.4,186,22,2,"PAH",40,1,2,0)="VA HIV registry. They are; 1)CABOTEGRAVIR and 2)CABOTEGRAVIR/RILPIVIRINE."
^DIC(9.4,186,22,2,"PAH",40,1,3,0)=" "
^DIC(9.4,186,22,2,"PAH",40,1,4,0)="There is a new GUI. The version number is 1.5.40."
^DIC(9.4,186,22,2,"PAH",41,0)="41 SEQ #41^3230323.121555^89"
^DIC(9.4,186,22,2,"PAH",41,1,0)="^^26^26^3230323"
^DIC(9.4,186,22,2,"PAH",41,1,1,0)="This patch changes the value of the NATIONAL (#.09) field in the ROR "
^DIC(9.4,186,22,2,"PAH",41,1,2,0)="REGISTRY PARAMETERS (#798.1) file for two entries; 1) VA HEPC and"
^DIC(9.4,186,22,2,"PAH",41,1,3,0)="2) VA HIV."
^DIC(9.4,186,22,2,"PAH",41,1,4,0)=" "
^DIC(9.4,186,22,2,"PAH",41,1,5,0)="Before the patch, the value is ""1"" (i.e., YES). "
^DIC(9.4,186,22,2,"PAH",41,1,6,0)="After the patch, the value is ""0"" (i.e., NO)."
^DIC(9.4,186,22,2,"PAH",41,1,7,0)=" "
^DIC(9.4,186,22,2,"PAH",41,1,8,0)="Prior to this patch, these two registries were considered ""national"" and "
^DIC(9.4,186,22,2,"PAH",41,1,9,0)="their patient data was transmitted to a national database every day. All "
^DIC(9.4,186,22,2,"PAH",41,1,10,0)="other registries in the package are considered ""local"" and their patient "
^DIC(9.4,186,22,2,"PAH",41,1,11,0)="data is not transmitted to any other database. "
^DIC(9.4,186,22,2,"PAH",41,1,12,0)=" "
^DIC(9.4,186,22,2,"PAH",41,1,13,0)="With this patch, these two registries are changed to ""local"", too. Their "
^DIC(9.4,186,22,2,"PAH",41,1,14,0)="patient data will no longer be transmitted to any other database."
^DIC(9.4,186,22,2,"PAH",41,1,15,0)=" "
^DIC(9.4,186,22,2,"PAH",41,1,16,0)="The CCR package checks many VistA packages for patient information to "
^DIC(9.4,186,22,2,"PAH",41,1,17,0)="update its various registries. Therefore, the ROR TASK option that is"
^DIC(9.4,186,22,2,"PAH",41,1,18,0)="currently scheduled to run on all VistA systems should continue to run"
^DIC(9.4,186,22,2,"PAH",41,1,19,0)="every day so that all registries at the site can continue to be updated on"
^DIC(9.4,186,22,2,"PAH",41,1,20,0)="a daily basis."
^DIC(9.4,186,22,2,"PAH",41,1,21,0)=" "
^DIC(9.4,186,22,2,"PAH",41,1,22,0)="NOTE: This patch should be installed at sites that run CERNER, too."
^DIC(9.4,186,22,2,"PAH",41,1,23,0)="      However, CERNER sites do not need to have the ROR TASK option"
^DIC(9.4,186,22,2,"PAH",41,1,24,0)="      scheduled."
^DIC(9.4,186,22,2,"PAH",41,1,25,0)=" "
^DIC(9.4,186,22,2,"PAH",41,1,26,0)="There is a new GUI. The version number is 1.5.41."
^DIC(9.4,186,22,2,"PAH",42,0)="42 SEQ #42^3240930.180246^89"
^DIC(9.4,186,22,2,"PAH",42,1,0)="^^25^25^3240930"
^DIC(9.4,186,22,2,"PAH",42,1,1,0)="This patch includes the following changes to the Clinical Case Registries"
^DIC(9.4,186,22,2,"PAH",42,1,2,0)="(CCR) package."
^DIC(9.4,186,22,2,"PAH",42,1,3,0)=" "
^DIC(9.4,186,22,2,"PAH",42,1,4,0)=" 1. One drug is added to the ROR GENERIC DRUG (#799.51) file for use by "
^DIC(9.4,186,22,2,"PAH",42,1,5,0)="    the VA HIV registry. The drug is LENACAPAVIR."
^DIC(9.4,186,22,2,"PAH",42,1,6,0)=" "
^DIC(9.4,186,22,2,"PAH",42,1,7,0)=" 2. The VA TRANSGENDER registry is inactivated. The REGISTRY STATUS field"
^DIC(9.4,186,22,2,"PAH",42,1,8,0)="    (#11) of the ROR REGISTRY PARAMETERS (#798.1) file for this registry  "
^DIC(9.4,186,22,2,"PAH",42,1,9,0)="    is set to 1 (i.e., INACTIVE). The daily update process will no longer"
^DIC(9.4,186,22,2,"PAH",42,1,10,0)="    update this registry. Also, this registry will no longer appear in the"
^DIC(9.4,186,22,2,"PAH",42,1,11,0)="    list of registries displayed to the users so they will not be able to"
^DIC(9.4,186,22,2,"PAH",42,1,12,0)="    select it."
^DIC(9.4,186,22,2,"PAH",42,1,13,0)=" "
^DIC(9.4,186,22,2,"PAH",42,1,14,0)=" 3. The Graphical User Interface (GUI) now supports the latest changes to"
^DIC(9.4,186,22,2,"PAH",42,1,15,0)="    the RPC Broker package. The latest Personal Identity Verification"
^DIC(9.4,186,22,2,"PAH",42,1,16,0)="    (PIV) certificate will be selected automatically, however, a new"
^DIC(9.4,186,22,2,"PAH",42,1,17,0)="    ""/showcerts"" command line switch was added to allow the user to"
^DIC(9.4,186,22,2,"PAH",42,1,18,0)="    display the PIV certificate selection screen in case it is needed."
^DIC(9.4,186,22,2,"PAH",42,1,19,0)=" "
^DIC(9.4,186,22,2,"PAH",42,1,20,0)=" 4. The version of the CCR software is updated to 1.5.42."
^DIC(9.4,186,22,2,"PAH",42,1,21,0)=" "
^DIC(9.4,186,22,2,"PAH",42,1,22,0)=" "
^DIC(9.4,186,22,2,"PAH",42,1,23,0)="    NOTE: This patch should be installed at sites that run CERNER, too."
^DIC(9.4,186,22,2,"PAH",42,1,24,0)="          However, CERNER sites do not need to have the ROR TASK option"
^DIC(9.4,186,22,2,"PAH",42,1,25,0)="          scheduled."
^DIC(9.4,186,22,2,"PAH","B",25,26)=""
