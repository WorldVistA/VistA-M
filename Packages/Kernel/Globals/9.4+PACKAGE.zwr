^DIC(9.4,14,22,5.9,"PAH",125,1,339,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,340,0)=" When users select the Interim report for selected tests as ordered"
^DIC(9.4,14,22,5.9,"PAH",125,1,341,0)=" [LRRSP] option and enters a patient who requires a means test an undefined "
^DIC(9.4,14,22,5.9,"PAH",125,1,342,0)=" variable error occurred.  This undefined variable I at BEGIN in routine LRRSP"
^DIC(9.4,14,22,5.9,"PAH",125,1,343,0)=" has been fixed.   "
^DIC(9.4,14,22,5.9,"PAH",125,1,344,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,345,0)="ASSOCIATED NOIS:"
