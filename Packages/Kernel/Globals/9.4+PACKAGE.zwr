^DIC(9.4,14,22,5.9,"PAH",123,1,52,0)=" Test Site(s):     Beckley, WV"
^DIC(9.4,14,22,5.9,"PAH",123,1,53,0)="                   Durham, NC"
^DIC(9.4,14,22,5.9,"PAH",123,1,54,0)="                   Puget Sound HCS"
^DIC(9.4,14,22,5.9,"PAH",123,1,55,0)="                   San Diego, CA"
^DIC(9.4,14,22,5.9,"PAH",123,1,56,0)=" "
^DIC(9.4,14,22,5.9,"PAH",123,1,57,0)="  "
^DIC(9.4,14,22,5.9,"PAH",123,1,58,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",123,1,59,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",123,1,60,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",123,1,61,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",123,1,62,0)="  <tab> ;;0.5;VBECS;<patchlist>;APR 26, 2002"
^DIC(9.4,14,22,5.9,"PAH",123,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",123,1,64,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",123,1,65,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",123,1,66,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",123,1,67,0)="   VBECA4           NEW            4083168        288"
^DIC(9.4,14,22,5.9,"PAH",123,1,68,0)="   VBECA5A          NEW            790890         288"
^DIC(9.4,14,22,5.9,"PAH",123,1,69,0)=" "
^DIC(9.4,14,22,5.9,"PAH",123,1,70,0)="List of preceding patches: None"
^DIC(9.4,14,22,5.9,"PAH",123,1,71,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",123,1,72,0)=" "
^DIC(9.4,14,22,5.9,"PAH",123,1,73,0)="  Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",123,1,74,0)="  =========================="
^DIC(9.4,14,22,5.9,"PAH",123,1,75,0)=" "
^DIC(9.4,14,22,5.9,"PAH",123,1,76,0)="  NOTE: This KIDS install does not place any options out of service"
^DIC(9.4,14,22,5.9,"PAH",123,1,77,0)="        during the install and no user options are affected."
^DIC(9.4,14,22,5.9,"PAH",123,1,78,0)="        If KIDS prompts:"
^DIC(9.4,14,22,5.9,"PAH",123,1,79,0)="  "
^DIC(9.4,14,22,5.9,"PAH",123,1,80,0)="        ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",123,1,81,0)="         Install? YES// NO"""
^DIC(9.4,14,22,5.9,"PAH",123,1,82,0)="        ""Want KIDS to INHIBIT LOGONs during the install? YES// NO"""
^DIC(9.4,14,22,5.9,"PAH",123,1,83,0)="        ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",123,1,84,0)="        Protocols? YES// NO"""
^DIC(9.4,14,22,5.9,"PAH",123,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",123,1,86,0)="        The site should answer ""NO"" to all three questions."
^DIC(9.4,14,22,5.9,"PAH",123,1,87,0)="            Note: You may not receive all three prompts at your site.  "
^DIC(9.4,14,22,5.9,"PAH",123,1,88,0)="  "
^DIC(9.4,14,22,5.9,"PAH",123,1,89,0)="        1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,14,22,5.9,"PAH",123,1,90,0)="           This option will load the KIDS package in this message onto"
^DIC(9.4,14,22,5.9,"PAH",123,1,91,0)="           your system."
^DIC(9.4,14,22,5.9,"PAH",123,1,92,0)="        2. Review your mapped set.  If the routines are mapped, they"
^DIC(9.4,14,22,5.9,"PAH",123,1,93,0)="           should be removed from the mapped set at this time."
^DIC(9.4,14,22,5.9,"PAH",123,1,94,0)="        3. The patch has now been loaded into a Transport global on"
^DIC(9.4,14,22,5.9,"PAH",123,1,95,0)="           your system. You now need to use KIDS to install the"
^DIC(9.4,14,22,5.9,"PAH",123,1,96,0)="           Transport global."
^DIC(9.4,14,22,5.9,"PAH",123,1,97,0)="           On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,14,22,5.9,"PAH",123,1,98,0)="           following options:"
^DIC(9.4,14,22,5.9,"PAH",123,1,99,0)="               Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",123,1,100,0)="               Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",123,1,101,0)="               Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",123,1,102,0)="               Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",123,1,103,0)="        4. Users may remain on the system."
^DIC(9.4,14,22,5.9,"PAH",123,1,104,0)="        5. No options need to be placed out of service."
^DIC(9.4,14,22,5.9,"PAH",123,1,105,0)="        6. Installation time is less than 2 minutes during off peak"
^DIC(9.4,14,22,5.9,"PAH",123,1,106,0)="           hours and less the 5 minutes during peak hours."
^DIC(9.4,14,22,5.9,"PAH",123,1,107,0)="        7. Installation of this patch requires no additional memory"
^DIC(9.4,14,22,5.9,"PAH",123,1,108,0)="           space."
^DIC(9.4,14,22,5.9,"PAH",123,1,109,0)="        8. From the 'Installation Menu' of the KIDS menu, run the"
^DIC(9.4,14,22,5.9,"PAH",123,1,110,0)="           option 'Install Package(s)' Select the package 'LR*5.2*288'"
^DIC(9.4,14,22,5.9,"PAH",123,1,111,0)="           and proceed with the install."
^DIC(9.4,14,22,5.9,"PAH",123,1,112,0)="        9. If any routines were unmapped as part of step 2, they should"
^DIC(9.4,14,22,5.9,"PAH",123,1,113,0)="           be returned to the mapped set once the installation has run"
^DIC(9.4,14,22,5.9,"PAH",123,1,114,0)="           to completion."
^DIC(9.4,14,22,5.9,"PAH",124,0)="292 SEQ #222^3021220^1"
^DIC(9.4,14,22,5.9,"PAH",124,1,0)="^^109^109^3021220"
^DIC(9.4,14,22,5.9,"PAH",124,1,1,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*292 does not "
^DIC(9.4,14,22,5.9,"PAH",124,1,2,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,14,22,5.9,"PAH",124,1,3,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",124,1,4,0)="  "
^DIC(9.4,14,22,5.9,"PAH",124,1,5,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*292 does not "
^DIC(9.4,14,22,5.9,"PAH",124,1,6,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",124,1,7,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",124,1,8,0)="  "
^DIC(9.4,14,22,5.9,"PAH",124,1,9,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*292 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",124,1,10,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",124,1,11,0)="  "
^DIC(9.4,14,22,5.9,"PAH",124,1,12,0)="  "
^DIC(9.4,14,22,5.9,"PAH",124,1,13,0)=" The Blood Bank Report under the Reports tab in CPRS was hard coded to "
^DIC(9.4,14,22,5.9,"PAH",124,1,14,0)="display ""Blood Bank"" as the location of the unit if the unit has been "
^DIC(9.4,14,22,5.9,"PAH",124,1,15,0)="crossmatched and not dispositioned.  "
^DIC(9.4,14,22,5.9,"PAH",124,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,17,0)="  Old Format:"
^DIC(9.4,14,22,5.9,"PAH",124,1,18,0)="                             ---- BLOOD BANK ----"
^DIC(9.4,14,22,5.9,"PAH",124,1,19,0)="ABO Rh:  O POS"
^DIC(9.4,14,22,5.9,"PAH",124,1,20,0)="   Antibodies identified: ANTI E; "
^DIC(9.4,14,22,5.9,"PAH",124,1,21,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,22,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,23,0)="     Unit assigned/xmatched:            Exp date        Loc"
^DIC(9.4,14,22,5.9,"PAH",124,1,24,0)=" 1)  04ABC  CPDA-1 RED BLOOD CE  O POS  Apr 25, 2002    Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",124,1,25,0)=" 2)  04ABC2 CPDA-1 RED BLOOD CE  O POS  Apr 25, 2002    5 DALLAS"
^DIC(9.4,14,22,5.9,"PAH",124,1,26,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,27,0)=" The report has been changed to display ""BB-"" and the institution that "
^DIC(9.4,14,22,5.9,"PAH",124,1,28,0)="logged the unit."
^DIC(9.4,14,22,5.9,"PAH",124,1,29,0)="  "
^DIC(9.4,14,22,5.9,"PAH",124,1,30,0)="  New Format:"
^DIC(9.4,14,22,5.9,"PAH",124,1,31,0)="                             ---- BLOOD BANK ----"
^DIC(9.4,14,22,5.9,"PAH",124,1,32,0)="ABO Rh:  O POS"
^DIC(9.4,14,22,5.9,"PAH",124,1,33,0)="   Antibodies identified: ANTI E; "
^DIC(9.4,14,22,5.9,"PAH",124,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,35,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,36,0)="     Unit assigned/xmatched:            Exp date        Loc"
^DIC(9.4,14,22,5.9,"PAH",124,1,37,0)=" 1)  04ABC  CPDA-1 RED BLOOD CE  O POS  Apr 25, 2002    BB-Dallas CIOFO"
^DIC(9.4,14,22,5.9,"PAH",124,1,38,0)=" 2)  04ABC2 CPDA-1 RED BLOOD CE  O POS  Apr 25, 2002    5 DALLAS"
^DIC(9.4,14,22,5.9,"PAH",124,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",124,1,40,0)=" "
