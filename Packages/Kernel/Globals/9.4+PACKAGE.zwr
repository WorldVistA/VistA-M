^DIC(9.4,14,22,5.9,"PAH",213,1,198,0)="Veterans Health Information Systems and Architecture (VistA) Laboratory"
^DIC(9.4,14,22,5.9,"PAH",213,1,199,0)="Anatomic Pathology (AP) Report Causes Unsigned Computerized Patient Record"
^DIC(9.4,14,22,5.9,"PAH",213,1,200,0)="System (CPRS) Alert and New Current Procedural Terminology (CPT) "
^DIC(9.4,14,22,5.9,"PAH",213,1,201,0)="Application Programming Interface (APIs) Patch LR*5.2*315 User Guide is"
^DIC(9.4,14,22,5.9,"PAH",213,1,202,0)="available at the following Office of Information Field Offices (OIFOs)"
