^DIC(9.4,48,22,5.28,"PAH",531,1,89,0)="  ----------------------------  "
^DIC(9.4,48,22,5.28,"PAH",531,1,90,0)="  N/A"
^DIC(9.4,48,22,5.28,"PAH",531,1,91,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,92,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,93,0)="  Patient Safety Issues (PSIs):"
^DIC(9.4,48,22,5.28,"PAH",531,1,94,0)="  -----------------------------"
^DIC(9.4,48,22,5.28,"PAH",531,1,95,0)="  HITPS-6559"
^DIC(9.4,48,22,5.28,"PAH",531,1,96,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,97,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,98,0)="  Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,48,22,5.28,"PAH",531,1,99,0)="  --------------------------------------------"
^DIC(9.4,48,22,5.28,"PAH",531,1,100,0)="  1. RTC 1087933 - Appointment fix options (manual and automatic) do not "
^DIC(9.4,48,22,5.28,"PAH",531,1,101,0)="     fix appointments that are cancelled in the patient (#2) and location "
^DIC(9.4,48,22,5.28,"PAH",531,1,102,0)="     (#44) files but not in the appointment file (#409.84).  Also to"
^DIC(9.4,48,22,5.28,"PAH",531,1,103,0)="     activate a cancelled appointment file entry if the patient file entry"
^DIC(9.4,48,22,5.28,"PAH",531,1,104,0)="     is active."
^DIC(9.4,48,22,5.28,"PAH",531,1,105,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,106,0)="  Problem:"
^DIC(9.4,48,22,5.28,"PAH",531,1,107,0)="  -------"
^DIC(9.4,48,22,5.28,"PAH",531,1,108,0)="  The appointment fixing routine developed for patch 723 does not repair "
^DIC(9.4,48,22,5.28,"PAH",531,1,109,0)="  active appointment file (#409.84) entries when the patient file (#2) "
^DIC(9.4,48,22,5.28,"PAH",531,1,110,0)="  appointment is cancelled and vice versa.  This problem was discovered "
^DIC(9.4,48,22,5.28,"PAH",531,1,111,0)="  during production IOC testing."
^DIC(9.4,48,22,5.28,"PAH",531,1,112,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,113,0)="  Resolution:"
^DIC(9.4,48,22,5.28,"PAH",531,1,114,0)="  ----------"
^DIC(9.4,48,22,5.28,"PAH",531,1,115,0)="  The appointment fixing routine was modifed to change appointment data "
^DIC(9.4,48,22,5.28,"PAH",531,1,116,0)="  from active to cancelled and cancelled to active."
^DIC(9.4,48,22,5.28,"PAH",531,1,117,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,118,0)="  The instructions for using the two appointment fixing options are "
^DIC(9.4,48,22,5.28,"PAH",531,1,119,0)="  described in detail in patch 723."
^DIC(9.4,48,22,5.28,"PAH",531,1,120,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,121,0)="  2. INC6787649 - Cancels wrong pt. appointment when original appointment "
^DIC(9.4,48,22,5.28,"PAH",531,1,122,0)="     was made through self scheduling."
^DIC(9.4,48,22,5.28,"PAH",531,1,123,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,124,0)="  Problem:"
^DIC(9.4,48,22,5.28,"PAH",531,1,125,0)="  -------"
^DIC(9.4,48,22,5.28,"PAH",531,1,126,0)="  When a VAOS-created appointment is cancelled in VSE, the appointment "
^DIC(9.4,48,22,5.28,"PAH",531,1,127,0)="  for the previously scheduled appointment, for another patient, is "
^DIC(9.4,48,22,5.28,"PAH",531,1,128,0)="  cancelled instead."
^DIC(9.4,48,22,5.28,"PAH",531,1,129,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,130,0)="  Resolution:"
^DIC(9.4,48,22,5.28,"PAH",531,1,131,0)="  ----------"
^DIC(9.4,48,22,5.28,"PAH",531,1,132,0)="  Appointment cancellation can be performed from the appointment context "
^DIC(9.4,48,22,5.28,"PAH",531,1,133,0)="  menu associated with the appointment from either the Pending"
^DIC(9.4,48,22,5.28,"PAH",531,1,134,0)="  Appointments list or the calendar.  A change was made to a MUMPS routine"
^DIC(9.4,48,22,5.28,"PAH",531,1,135,0)="  (SDECEPT) that blocked access to the cancel appointment option on the"
^DIC(9.4,48,22,5.28,"PAH",531,1,136,0)="  calendar.  The block resulted from time being filed along with date in"
^DIC(9.4,48,22,5.28,"PAH",531,1,137,0)="  the CID field by VAOS.  SDECEPT strips off time when it returns data to"
^DIC(9.4,48,22,5.28,"PAH",531,1,138,0)="  VS GUI.  The presence of time resulted in an ""unhandled exception"" error"
^DIC(9.4,48,22,5.28,"PAH",531,1,139,0)="  in VS GUI blocking access to the cancel appointment option."
^DIC(9.4,48,22,5.28,"PAH",531,1,140,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,141,0)="  Note:  This code change does not correct the error in the cancel option "
^DIC(9.4,48,22,5.28,"PAH",531,1,142,0)="  on the Pending Appointments list.  That correction will require a change"
^DIC(9.4,48,22,5.28,"PAH",531,1,143,0)="  to VS GUI and will appear in a future release of the software."
^DIC(9.4,48,22,5.28,"PAH",531,1,144,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,145,0)="=========================================================================="
^DIC(9.4,48,22,5.28,"PAH",531,1,146,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,147,0)="  Test Sites:"
^DIC(9.4,48,22,5.28,"PAH",531,1,148,0)="  ----------"
^DIC(9.4,48,22,5.28,"PAH",531,1,149,0)="  North Texas"
^DIC(9.4,48,22,5.28,"PAH",531,1,150,0)="  Fayetteville, NC"
^DIC(9.4,48,22,5.28,"PAH",531,1,151,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,152,0)="  Software and Documentation Retrieval Instructions:"
^DIC(9.4,48,22,5.28,"PAH",531,1,153,0)="  ---------------------------------------------------- "
^DIC(9.4,48,22,5.28,"PAH",531,1,154,0)="  Software being released as a host file and/or documentation describing "
^DIC(9.4,48,22,5.28,"PAH",531,1,155,0)="  the new functionality introduced by this patch are available."
^DIC(9.4,48,22,5.28,"PAH",531,1,156,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,157,0)="  The preferred method is to retrieve files from "
^DIC(9.4,48,22,5.28,"PAH",531,1,158,0)="  download.vista.domain.ext. This transmits the files from the first"
^DIC(9.4,48,22,5.28,"PAH",531,1,159,0)="  available server. Sites may also elect to retrieve files directly from a"
^DIC(9.4,48,22,5.28,"PAH",531,1,160,0)="  specific server. "
^DIC(9.4,48,22,5.28,"PAH",531,1,161,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,162,0)="  Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,48,22,5.28,"PAH",531,1,163,0)="  Secure File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE"
^DIC(9.4,48,22,5.28,"PAH",531,1,164,0)="  directory at the following OI Field Offices:"
^DIC(9.4,48,22,5.28,"PAH",531,1,165,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,166,0)="  Hines:    fo-hines.domain.ext  "
^DIC(9.4,48,22,5.28,"PAH",531,1,167,0)="  Salt Lake City:    fo-slc.domain.ext"
^DIC(9.4,48,22,5.28,"PAH",531,1,168,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,169,0)="  Documentation can also be found on the VA Software Documentation "
^DIC(9.4,48,22,5.28,"PAH",531,1,170,0)="  Library at: http://www4.domain.ext/vdl/"
^DIC(9.4,48,22,5.28,"PAH",531,1,171,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,172,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,173,0)="  Title                                          File Name       FTP Mode"
^DIC(9.4,48,22,5.28,"PAH",531,1,174,0)="--------------------------------------------------------------------------"
^DIC(9.4,48,22,5.28,"PAH",531,1,175,0)="  VistA Scheduling Enhancements User Guide       VSE_UG.PDF         Binary"
^DIC(9.4,48,22,5.28,"PAH",531,1,176,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,177,0)="  Patch Installation:"
^DIC(9.4,48,22,5.28,"PAH",531,1,178,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,179,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,180,0)="  Pre/Post Installation Overview:"
^DIC(9.4,48,22,5.28,"PAH",531,1,181,0)="  -------------------------------"
^DIC(9.4,48,22,5.28,"PAH",531,1,182,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,183,0)="  Pre-Installation Instructions:"
^DIC(9.4,48,22,5.28,"PAH",531,1,184,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,185,0)="  This patch may be installed with users on the system although it is"
^DIC(9.4,48,22,5.28,"PAH",531,1,186,0)="  recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,48,22,5.28,"PAH",531,1,187,0)="  potential disruption to users.  This patch should take less than 5"
^DIC(9.4,48,22,5.28,"PAH",531,1,188,0)="  minutes to install."
^DIC(9.4,48,22,5.28,"PAH",531,1,189,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,190,0)="  No pre- or post-installation steps are required."
^DIC(9.4,48,22,5.28,"PAH",531,1,191,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,192,0)="  Installation Instructions:"
^DIC(9.4,48,22,5.28,"PAH",531,1,193,0)="  --------------------------"
^DIC(9.4,48,22,5.28,"PAH",531,1,194,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,195,0)="  1. Choose the PackMan message containing this patch."
^DIC(9.4,48,22,5.28,"PAH",531,1,196,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,197,0)="  2. Choose the INSTALL/CHECK MESSAGE PackMan option. "
^DIC(9.4,48,22,5.28,"PAH",531,1,198,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,199,0)="  3. From the Kernel Installation and Distribution System Menu, select the"
^DIC(9.4,48,22,5.28,"PAH",531,1,200,0)="  Installation Menu.  From this menu, you may elect to use the following"
^DIC(9.4,48,22,5.28,"PAH",531,1,201,0)="  options. When prompted for the INSTALL NAME enter the patch number (ex. "
^DIC(9.4,48,22,5.28,"PAH",531,1,202,0)="  SD*5.3*731):"
^DIC(9.4,48,22,5.28,"PAH",531,1,203,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,204,0)="  a. Backup a Transport Global - This option will create a backup message "
^DIC(9.4,48,22,5.28,"PAH",531,1,205,0)="  of any routines exported with this patch. It will not backup any other"
^DIC(9.4,48,22,5.28,"PAH",531,1,206,0)="  changes such as DDs or templates."
^DIC(9.4,48,22,5.28,"PAH",531,1,207,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,208,0)="  b. Compare Transport Global to Current System - This option will (allow "
^DIC(9.4,48,22,5.28,"PAH",531,1,209,0)="  you to view all changes that will be made when this patch is installed."
^DIC(9.4,48,22,5.28,"PAH",531,1,210,0)="  It compares all components of this patch routines, DDs, templates,"
^DIC(9.4,48,22,5.28,"PAH",531,1,211,0)="  etc.)."
^DIC(9.4,48,22,5.28,"PAH",531,1,212,0)=" "
^DIC(9.4,48,22,5.28,"PAH",531,1,213,0)="  c. Verify Checksums in Transport Global - This option will allow you to"
^DIC(9.4,48,22,5.28,"PAH",531,1,214,0)="  ensure the integrity of the routines that are in the transport global."
^DIC(9.4,48,22,5.28,"PAH",531,1,215,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,216,0)="  4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,48,22,5.28,"PAH",531,1,217,0)="  choose the patch to install."
^DIC(9.4,48,22,5.28,"PAH",531,1,218,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,219,0)="  5. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,48,22,5.28,"PAH",531,1,220,0)="  Install? YES//', respond YES."
^DIC(9.4,48,22,5.28,"PAH",531,1,221,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,222,0)="  6. When prompted 'Want KIDS to INHIBIT LOGONs during the install? NO//',"
^DIC(9.4,48,22,5.28,"PAH",531,1,223,0)="  respond NO."
^DIC(9.4,48,22,5.28,"PAH",531,1,224,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,225,0)="  7. When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,48,22,5.28,"PAH",531,1,226,0)="  Protocols? NO//', respond NO."
^DIC(9.4,48,22,5.28,"PAH",531,1,227,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,228,0)="  8. If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,48,22,5.28,"PAH",531,1,229,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,230,0)="   "
^DIC(9.4,48,22,5.28,"PAH",531,1,231,0)="  Back-Out Plan:"
^DIC(9.4,48,22,5.28,"PAH",531,1,232,0)="  --------------------"
^DIC(9.4,48,22,5.28,"PAH",531,1,233,0)="  In order to back out this patch, restore the transport global that was "
^DIC(9.4,48,22,5.28,"PAH",531,1,234,0)="  saved in Step 3.a. of the installation.  Delete the options that  "
^DIC(9.4,48,22,5.28,"PAH",531,1,235,0)="  were included in the patch except SDSUP. Edit the SDSUP option to remove"
^DIC(9.4,48,22,5.28,"PAH",531,1,236,0)="  the new option."
^DIC(9.4,48,22,5.28,"PAH",532,0)="734 SEQ #595^3191209.164013^65"
^DIC(9.4,48,22,5.28,"PAH",533,0)="686 SEQ #596^3200122.161106^65"
^DIC(9.4,48,22,5.28,"PAH",533,1,0)="^^505^505^3200122"
^DIC(9.4,48,22,5.28,"PAH",533,1,1,0)="**************************************************************************"
^DIC(9.4,48,22,5.28,"PAH",533,1,2,0)="**"
^DIC(9.4,48,22,5.28,"PAH",533,1,3,0)="*                             GUI UPDATE "
^DIC(9.4,48,22,5.28,"PAH",533,1,4,0)="NOTICE                            *"
^DIC(9.4,48,22,5.28,"PAH",533,1,5,0)="*-------------------------------------------------------------------------"
^DIC(9.4,48,22,5.28,"PAH",533,1,6,0)="-*"
^DIC(9.4,48,22,5.28,"PAH",533,1,7,0)="* This patch MUST be installed before the GUI update for release "
^DIC(9.4,48,22,5.28,"PAH",533,1,8,0)="1.5.1     *  "
^DIC(9.4,48,22,5.28,"PAH",533,1,9,0)="* of VistA Scheduling GUI is installed. The previous 1.5 release will "
^DIC(9.4,48,22,5.28,"PAH",533,1,10,0)="work *"
^DIC(9.4,48,22,5.28,"PAH",533,1,11,0)="* with no problems after this patch has been installed. However, if "
^DIC(9.4,48,22,5.28,"PAH",533,1,12,0)="the    *"
^DIC(9.4,48,22,5.28,"PAH",533,1,13,0)="* 1.5.1 version is used without this patch, then all fields for "
^DIC(9.4,48,22,5.28,"PAH",533,1,14,0)="selecting  *"
^DIC(9.4,48,22,5.28,"PAH",533,1,15,0)="* clinics, as well as the Audit Report, will not work "
^DIC(9.4,48,22,5.28,"PAH",533,1,16,0)="properly.            *"
^DIC(9.4,48,22,5.28,"PAH",533,1,17,0)="**************************************************************************"
^DIC(9.4,48,22,5.28,"PAH",533,1,18,0)="**"
^DIC(9.4,48,22,5.28,"PAH",533,1,19,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,20,0)="This patch contains the VistA components necessary to support the 1.5.1 "
^DIC(9.4,48,22,5.28,"PAH",533,1,21,0)="release of VistA Scheduling Enhancements (VSE) as well as addressing the"
^DIC(9.4,48,22,5.28,"PAH",533,1,22,0)="following issues:"
^DIC(9.4,48,22,5.28,"PAH",533,1,23,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,24,0)="1. R18120703FY18  - The VS GUI application freezes when the Audit Report "
^DIC(9.4,48,22,5.28,"PAH",533,1,25,0)="is"
^DIC(9.4,48,22,5.28,"PAH",533,1,26,0)="                    run for all schedulers due to performance issues."
^DIC(9.4,48,22,5.28,"PAH",533,1,27,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,28,0)="2. R17856900FY18, - If an appointment had been scheduled for a consult, "
^DIC(9.4,48,22,5.28,"PAH",533,1,29,0)="   R18564968FY18,   then that consult was completed, and finally the"
^DIC(9.4,48,22,5.28,"PAH",533,1,30,0)="   R18648321FY18    appointment was canceled, the consult will be marked"
^DIC(9.4,48,22,5.28,"PAH",533,1,31,0)="                    as active, even though it should remain as complete."
^DIC(9.4,48,22,5.28,"PAH",533,1,32,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,33,0)="3. R17415367FY18  - If a user locks an appointment request (in this case,"
^DIC(9.4,48,22,5.28,"PAH",533,1,34,0)="                    a consult request in particular) by selecting it in "
^DIC(9.4,48,22,5.28,"PAH",533,1,35,0)="the"
^DIC(9.4,48,22,5.28,"PAH",533,1,36,0)="                    RM grid, then exits the GUI with it still locked, a "
^DIC(9.4,48,22,5.28,"PAH",533,1,37,0)="user"
^DIC(9.4,48,22,5.28,"PAH",533,1,38,0)="                    in VistA will be unable to select the same request,"
^DIC(9.4,48,22,5.28,"PAH",533,1,39,0)="                    instead receiving a message stating that the request "
^DIC(9.4,48,22,5.28,"PAH",533,1,40,0)="is"
^DIC(9.4,48,22,5.28,"PAH",533,1,41,0)="                    locked."
^DIC(9.4,48,22,5.28,"PAH",533,1,42,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,43,0)="4. R17039175FY18  - When using clinic lookup, if the user pauses the input"
^DIC(9.4,48,22,5.28,"PAH",533,1,44,0)="                            is wiped out and has to be re-entered."
^DIC(9.4,48,22,5.28,"PAH",533,1,45,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,46,0)="5. R18477670FY18  - When scheduling an appointment for an Inter-Facility"
^DIC(9.4,48,22,5.28,"PAH",533,1,47,0)="                            Consult (IFC), the remote facility is not "
^DIC(9.4,48,22,5.28,"PAH",533,1,48,0)="notified."
^DIC(9.4,48,22,5.28,"PAH",533,1,49,0)=" "
^DIC(9.4,48,22,5.28,"PAH",533,1,50,0)="This patch also contains modifications to routines (SDECAR1 and SDECAR2)"
^DIC(9.4,48,22,5.28,"PAH",533,1,51,0)="and RPCs (SDEC ARGET and SDEC ARSET) as well changes to FileMan files"
^DIC(9.4,48,22,5.28,"PAH",533,1,52,0)="(Appointment Request #409.85) related to a future enhancement - the "
^DIC(9.4,48,22,5.28,"PAH",533,1,53,0)="integration of Scheduling Manager functionality into the VS GUI."
