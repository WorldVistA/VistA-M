^DIC(9.4,42,0)="HEALTH SUMMARY^GMTS^Integrated Health Summary Tools"
^DIC(9.4,42,1,0)="^^3^3^2950830^^^^"
^DIC(9.4,42,1,1,0)="Tools to build and display health summaries.  The health summary pulls"
^DIC(9.4,42,1,2,0)="information from ancillary packages and presents it in an integrated"
^DIC(9.4,42,1,3,0)="fashion."
^DIC(9.4,42,4,0)="^9.44PA^5^3"
^DIC(9.4,42,4,2,0)=142.1
^DIC(9.4,42,4,2,222)="y^y^^n^^^y^o^n"
^DIC(9.4,42,4,3,0)=142
^DIC(9.4,42,4,3,222)="y^y^^n^^^y^o^n"
^DIC(9.4,42,4,5,0)=142.99
^DIC(9.4,42,4,5,222)="y^y^^n^^^n^^n"
