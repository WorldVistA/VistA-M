^DIC(9.4,49,22,10,"PAH",124,1,0)="^^4^4^3030403"
^DIC(9.4,49,22,10,"PAH",124,1,1,0)="This patch modifies two entries in file 364.7 - IB FORM FIELD CONTENT"
