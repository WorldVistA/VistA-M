^DIC(9.4,48,22,5.28,"PAH",39,0)="88 SEQ #77^2970221^1"
^DIC(9.4,48,22,5.28,"PAH",39,1,0)="^^2^2^2970221"
^DIC(9.4,48,22,5.28,"PAH",39,1,1,0)="Fixes problem in Patient Listing w/ Team Assignments Report.  For complete"
^DIC(9.4,48,22,5.28,"PAH",39,1,2,0)="details, see NPM."
^DIC(9.4,48,22,5.28,"PAH",40,0)="86 SEQ #78^2970221^1"
^DIC(9.4,48,22,5.28,"PAH",40,1,0)="^^2^2^2970221"
^DIC(9.4,48,22,5.28,"PAH",40,1,1,0)="This uses SSN if PID does not exist in PCMM's patient lookup.  For"
