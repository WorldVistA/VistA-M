^DIC(9.4,8,22,14,"PAH",77,0)="98^3191113.145324^65"
^DIC(9.4,8,22,14,"PAH",77,1,0)="^^2^2^3191113"
^DIC(9.4,8,22,14,"PAH",77,1,1,0)="Patch ICD*18.0*98 will update multiple field names and descriptions"
^DIC(9.4,8,22,14,"PAH",77,1,2,0)="in the DRG (#80.2) file that are no longer updated or in use."
^DIC(9.4,8,22,14,"PAH",78,0)="99^3200218.102659^65"
^DIC(9.4,8,22,14,"PAH",78,1,0)="^^14^14^3200218"
^DIC(9.4,8,22,14,"PAH",78,1,1,0)="This patch provides the annual update to the Medicare Severity Diagnosis"
^DIC(9.4,8,22,14,"PAH",78,1,2,0)="Related Group (MS-DRG) Grouper version 37."
^DIC(9.4,8,22,14,"PAH",78,1,3,0)=" 1) INC6959379 - FY2020 ICD DRG Grouper annual update patch needed"
^DIC(9.4,8,22,14,"PAH",78,1,4,0)="    The following changes are published in the Federal Register, Vol. 84,"
^DIC(9.4,8,22,14,"PAH",78,1,5,0)="    No. 159, dated August 16, 2019 with an effective date of October 1,"
^DIC(9.4,8,22,14,"PAH",78,1,6,0)="    2019. All page references below are for this annual update and"
^DIC(9.4,8,22,14,"PAH",78,1,7,0)="    resource documents can be found at https://www.cms.gov/."
^DIC(9.4,8,22,14,"PAH",78,1,8,0)="Changes include:"
^DIC(9.4,8,22,14,"PAH",78,1,9,0)="      I.   Revised DRGs."
^DIC(9.4,8,22,14,"PAH",78,1,10,0)="     II.   Revised DRG relative weights & average length of stay (ALOS)"
^DIC(9.4,8,22,14,"PAH",78,1,11,0)="           values for all DRGs."
^DIC(9.4,8,22,14,"PAH",78,1,12,0)="    III.   DRG Reclassification changes to the Grouper."
^DIC(9.4,8,22,14,"PAH",78,1,13,0)="     IV.   Additional DRG-related data for the new ICD codes introduced by"
^DIC(9.4,8,22,14,"PAH",78,1,14,0)="           patch LEX*2.0*123 (released September 23, 2019)."
^DIC(9.4,8,22,14,"PAH",79,0)="101^3200325.094634^70"
^DIC(9.4,8,22,14,"PAH",80,0)="102^3200402.172056^70"
^DIC(9.4,8,22,14,"PAH",81,0)="103 SEQ #94^3200514.18092^70"
^DIC(9.4,8,22,14,"PAH",81,1,0)="^^7^7^3200514"
^DIC(9.4,8,22,14,"PAH",81,1,1,0)="In response to the national emergency that was declared concerning the"
^DIC(9.4,8,22,14,"PAH",81,1,2,0)="COVID-19 outbreak, the Centers for Disease Control and Prevention's (CDC)"
^DIC(9.4,8,22,14,"PAH",81,1,3,0)="National Center for Health Statistics (NCHS) is implementing a new"
^DIC(9.4,8,22,14,"PAH",81,1,4,0)="diagnosis code, U07.1, COVID-19, into the International Classification"
^DIC(9.4,8,22,14,"PAH",81,1,5,0)="of Diseases, Tenth Revision, Clinical Modification (ICD-10-CM), effective"
^DIC(9.4,8,22,14,"PAH",81,1,6,0)="April 1, 2020.  They are also implementing diagnosis code U07.0"
^DIC(9.4,8,22,14,"PAH",81,1,7,0)="(Vaping-related disorder)."
^DIC(9.4,8,22,14,"PAH",82,0)="104^3200928.135324^17"
^DIC(9.4,8,22,14,"PAH",83,0)="106^3201231.142926^65"
^DIC(9.4,8,22,14,"PAH",84,0)="105^3210211.131809^17"
^DIC(9.4,8,22,14,"PAH",84,1,0)="^^15^15^3210211"
^DIC(9.4,8,22,14,"PAH",84,1,1,0)=" This patch provides the annual update to the Medicare Severity Diagnosis"
^DIC(9.4,8,22,14,"PAH",84,1,2,0)=" Related Group (MS-DRG) Grouper version 38.  Also, in response to the"
^DIC(9.4,8,22,14,"PAH",84,1,3,0)=" national emergency that was declared concerning the COVID-19 outbreak, the"
^DIC(9.4,8,22,14,"PAH",84,1,4,0)=" Centers for Disease Control and Prevention's (CDC) is implementing new"
^DIC(9.4,8,22,14,"PAH",84,1,5,0)=" codes into the Medicare Severity Diagnosis Related Group (MS-DRG) Grouper"
^DIC(9.4,8,22,14,"PAH",84,1,6,0)=" version 38.1, effective January 1, 2021."
^DIC(9.4,8,22,14,"PAH",84,1,7,0)="+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
^DIC(9.4,8,22,14,"PAH",84,1,8,0)=" "
^DIC(9.4,8,22,14,"PAH",84,1,9,0)=" PLEASE NOTE:"
^DIC(9.4,8,22,14,"PAH",84,1,10,0)="   Be aware of the shortened compliance date. The dates listed in the patch"
^DIC(9.4,8,22,14,"PAH",84,1,11,0)="   description are accurate as the FY2021 annual patch was delayed."
^DIC(9.4,8,22,14,"PAH",84,1,12,0)="   The changes included in this patch were effective as of 10/1/2020 per"
^DIC(9.4,8,22,14,"PAH",84,1,13,0)="   the Federal Register Vol. 85, No. 182, dated September 18, 2020."
^DIC(9.4,8,22,14,"PAH",84,1,14,0)=" "
^DIC(9.4,8,22,14,"PAH",84,1,15,0)="+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
^DIC(9.4,8,22,14,"PAH",85,0)="107^3210907.100726^17"
^DIC(9.4,8,22,14,"PAH",86,0)="108^3211209.154246^17"
^DIC(9.4,8,22,14,"PAH",86,1,0)="^^11^11^3211209"
^DIC(9.4,8,22,14,"PAH",86,1,1,0)=" This patch provides the annual update to the Medicare Severity Diagnosis"
^DIC(9.4,8,22,14,"PAH",86,1,2,0)=" Related Group (MS-DRG) Grouper version 39.  "
^DIC(9.4,8,22,14,"PAH",86,1,3,0)="+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
^DIC(9.4,8,22,14,"PAH",86,1,4,0)=" "
^DIC(9.4,8,22,14,"PAH",86,1,5,0)=" PLEASE NOTE:"
^DIC(9.4,8,22,14,"PAH",86,1,6,0)="   Be aware of the shortened compliance date. The dates listed in the patch"
^DIC(9.4,8,22,14,"PAH",86,1,7,0)="   description are accurate as the FY2022 annual patch was delayed."
^DIC(9.4,8,22,14,"PAH",86,1,8,0)="   The changes included in this patch were effective as of 10/1/2021 per"
^DIC(9.4,8,22,14,"PAH",86,1,9,0)="   the Federal Register Vol. 86, No. 154, dated August 13, 2021."
^DIC(9.4,8,22,14,"PAH",86,1,10,0)=" "
^DIC(9.4,8,22,14,"PAH",86,1,11,0)="+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
^DIC(9.4,8,22,14,"PAH",87,0)="110^3220323.155713^86"
^DIC(9.4,8,22,14,"PAH",88,0)="109^3220407.125915^86"
^DIC(9.4,8,22,14,"PAH",88,1,0)="^^5^5^3220407"
^DIC(9.4,8,22,14,"PAH",88,1,1,0)=" In response to the ongoing national emergency concerning COVID-19, the Centers"
^DIC(9.4,8,22,14,"PAH",88,1,2,0)=" for Disease Control and Preventions (CDC) National Center for Health Statistics"
^DIC(9.4,8,22,14,"PAH",88,1,3,0)=" (NCHS) is implementing 3 new diagnosis codes and 7 new procedure codes, into"
^DIC(9.4,8,22,14,"PAH",88,1,4,0)=" the International Classification of Diseases, Tenth Revision, for reporting"
^DIC(9.4,8,22,14,"PAH",88,1,5,0)=" COVID-19 vaccination status effective April 1, 2022."
^DIC(9.4,8,22,14,"PAH",89,0)="111^3220921.111824^89"
^DIC(9.4,8,22,14,"PAH",90,0)="112^3230201.173837^89"
^DIC(9.4,8,22,14,"PAH",90,1,0)="^^9^9^3230201"
^DIC(9.4,8,22,14,"PAH",90,1,1,0)="++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
^DIC(9.4,8,22,14,"PAH",90,1,2,0)="   PLEASE NOTE:"
^DIC(9.4,8,22,14,"PAH",90,1,3,0)="     Be aware of the shortened compliance date. The dates listed in the "
^DIC(9.4,8,22,14,"PAH",90,1,4,0)="     patch"
^DIC(9.4,8,22,14,"PAH",90,1,5,0)="     description are accurate as the FY2023 annual patch was delayed."
^DIC(9.4,8,22,14,"PAH",90,1,6,0)="     The changes included in this patch were effective as of 10/1/2022 per"
^DIC(9.4,8,22,14,"PAH",90,1,7,0)="     the Federal Register Vol. 87, No. 153, dated August 10, 2022"
^DIC(9.4,8,22,14,"PAH",90,1,8,0)="  "
^DIC(9.4,8,22,14,"PAH",90,1,9,0)="++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
