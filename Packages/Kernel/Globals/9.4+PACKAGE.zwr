^DIC(9.4,48,22,0)="^9.49I^5.28^1"
^DIC(9.4,48,22,5.28,0)="5.3^3051119^2960613"
^DIC(9.4,48,22,5.28,"PAH",0)="^9.4901^723^723"
^DIC(9.4,48,22,5.28,"PAH",1,0)="42 SEQ #39^2960626^1"
^DIC(9.4,48,22,5.28,"PAH",1,1,0)="^^2^2^2960626"
^DIC(9.4,48,22,5.28,"PAH",1,1,1,0)="See National Patch Module (NPM) for a description of the contents of this"
^DIC(9.4,48,22,5.28,"PAH",1,1,2,0)="patch."
^DIC(9.4,48,22,5.28,"PAH",2,0)="39 SEQ #37^2960626^1"
^DIC(9.4,48,22,5.28,"PAH",2,1,0)="^^3^3^2960626"
^DIC(9.4,48,22,5.28,"PAH",2,1,1,0)="This is the FY 96 quarterly update patch #1.  The changes "
^DIC(9.4,48,22,5.28,"PAH",2,1,2,0)="included in this patch are described in the description of patch"
^DIC(9.4,48,22,5.28,"PAH",2,1,3,0)="SD*5.3*39 in the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",3,0)="41^2960715^1"
^DIC(9.4,48,22,5.28,"PAH",3,1,0)="^^1^1^2960715"
^DIC(9.4,48,22,5.28,"PAH",3,1,1,0)="Primary Care Management Module - SD*5.3*41"
^DIC(9.4,48,22,5.28,"PAH",4,0)="45 SEQ #41^2960715^1"
^DIC(9.4,48,22,5.28,"PAH",4,1,0)="^^4^4^2960715"
^DIC(9.4,48,22,5.28,"PAH",4,1,1,0)="This contains fixes related to the PCMM software (distributed as"
^DIC(9.4,48,22,5.28,"PAH",4,1,2,0)="SD*5.3*41).  This should be installed immediately after the installation"
^DIC(9.4,48,22,5.28,"PAH",4,1,3,0)="of SD*5.3*41.  See National Patch Module (NPM) for a description of the"
^DIC(9.4,48,22,5.28,"PAH",4,1,4,0)="contents of this patch."
^DIC(9.4,48,22,5.28,"PAH",5,0)="46 SEQ #42^2960812^1"
^DIC(9.4,48,22,5.28,"PAH",5,1,0)="^^1^1^2960812"
^DIC(9.4,48,22,5.28,"PAH",5,1,1,0)="See NPM for description."
^DIC(9.4,48,22,5.28,"PAH",6,0)="47 SEQ #43^2960821^1"
^DIC(9.4,48,22,5.28,"PAH",6,1,0)="^^1^1^2960821"
^DIC(9.4,48,22,5.28,"PAH",6,1,1,0)="Access Performance Measure "
^DIC(9.4,48,22,5.28,"PAH",7,0)="27^2960822^1"
^DIC(9.4,48,22,5.28,"PAH",7,1,0)="^^2^2^2960822"
^DIC(9.4,48,22,5.28,"PAH",7,1,1,0)="See National Patch Module for a description of the changes incorporated in"
^DIC(9.4,48,22,5.28,"PAH",7,1,2,0)="this patch."
^DIC(9.4,48,22,5.28,"PAH",8,0)="44^2960922^1"
^DIC(9.4,48,22,5.28,"PAH",8,1,0)="^^5^5^2960922"
^DIC(9.4,48,22,5.28,"PAH",8,1,1,0)=" KIDS distribution of the Scheduling portion of the Ambulatory Care"
^DIC(9.4,48,22,5.28,"PAH",8,1,2,0)=" Reporting Project."
^DIC(9.4,48,22,5.28,"PAH",8,1,3,0)="   "
^DIC(9.4,48,22,5.28,"PAH",8,1,4,0)=" The changes included in this patch are described in the description of"
^DIC(9.4,48,22,5.28,"PAH",8,1,5,0)=" patch SD*5.3*44 in the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",9,0)="49 SEQ #46^2960923^1"
^DIC(9.4,48,22,5.28,"PAH",9,1,0)="^^1^1^2960923"
^DIC(9.4,48,22,5.28,"PAH",9,1,1,0)="See NPM for description."
^DIC(9.4,48,22,5.28,"PAH",10,0)="48 SEQ #47^2960923^1"
^DIC(9.4,48,22,5.28,"PAH",10,1,0)="^^5^5^2960923"
^DIC(9.4,48,22,5.28,"PAH",10,1,1,0)="This contains fixes related to output fixes for the PCMM software"
^DIC(9.4,48,22,5.28,"PAH",10,1,2,0)="(distributed as SD*5.3*41)."
^DIC(9.4,48,22,5.28,"PAH",10,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",10,1,4,0)="Both SD*5.3*41 and SD*5.3*45 must be installed prior to loading this"
^DIC(9.4,48,22,5.28,"PAH",10,1,5,0)="patch."
^DIC(9.4,48,22,5.28,"PAH",11,0)="56 SEQ #48^2960924^1"
^DIC(9.4,48,22,5.28,"PAH",11,1,0)="^^1^1^2960924"
^DIC(9.4,48,22,5.28,"PAH",11,1,1,0)="See National Patch Module for description."
^DIC(9.4,48,22,5.28,"PAH",12,0)="57 SEQ #50^2961004^1"
^DIC(9.4,48,22,5.28,"PAH",12,1,0)="^^8^8^2961004"
^DIC(9.4,48,22,5.28,"PAH",12,1,1,0)="See NPM for complete description."
^DIC(9.4,48,22,5.28,"PAH",12,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",12,1,3,0)="(1) This has an environment check routine to make sure SD*5.3*44 (ACRP) is"
^DIC(9.4,48,22,5.28,"PAH",12,1,4,0)="installed."
^DIC(9.4,48,22,5.28,"PAH",12,1,5,0)="(2) In conjunction with DG*5.3*102, this modifies how occasion of service"
^DIC(9.4,48,22,5.28,"PAH",12,1,6,0)="encounters are handled."
^DIC(9.4,48,22,5.28,"PAH",12,1,7,0)="(3) This has a post-install routine to output clinics that either have no"
^DIC(9.4,48,22,5.28,"PAH",12,1,8,0)="STOP CODE or an inactive one."
^DIC(9.4,48,22,5.28,"PAH",13,0)="59 SEQ #51^2961004^1"
^DIC(9.4,48,22,5.28,"PAH",13,1,0)="^^4^4^2961004"
^DIC(9.4,48,22,5.28,"PAH",13,1,1,0)="This fixes an infinite loop that occurs in the ACRP's nightly background"
^DIC(9.4,48,22,5.28,"PAH",13,1,2,0)="job."
^DIC(9.4,48,22,5.28,"PAH",13,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",13,1,4,0)="For a complete description, see the NPM."
^DIC(9.4,48,22,5.28,"PAH",14,0)="61 SEQ #52^2961008^1"
^DIC(9.4,48,22,5.28,"PAH",14,1,0)="^^4^4^2961008"
^DIC(9.4,48,22,5.28,"PAH",14,1,1,0)="This increases the AMB CARE LAG FOR ACK field (#704) of the SCHEDULING"
^DIC(9.4,48,22,5.28,"PAH",14,1,2,0)="PARAMETER File (#404.91) to at least 7 days."
^DIC(9.4,48,22,5.28,"PAH",14,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",14,1,4,0)="For a complete description, see the NPM."
^DIC(9.4,48,22,5.28,"PAH",15,0)="55 SEQ #53^2961008^1"
^DIC(9.4,48,22,5.28,"PAH",15,1,0)="^^2^2^2961008"
^DIC(9.4,48,22,5.28,"PAH",15,1,1,0)="This patch contains fixes to the ambulatory care module.  See the National"
^DIC(9.4,48,22,5.28,"PAH",15,1,2,0)="Patch Module for a complete description of the changes."
^DIC(9.4,48,22,5.28,"PAH",16,0)="54 SEQ #54^2961009^1"
^DIC(9.4,48,22,5.28,"PAH",16,1,0)="^^5^5^2961009"
^DIC(9.4,48,22,5.28,"PAH",16,1,1,0)="This contains fixes for the PCMM RPC, the SC PATIENT LOOKUP."
^DIC(9.4,48,22,5.28,"PAH",16,1,2,0)="It used to error out when value entered resulted in a large list of"
^DIC(9.4,48,22,5.28,"PAH",16,1,3,0)="patients (e.g.'SMITH').  Now the limit is 500."
^DIC(9.4,48,22,5.28,"PAH",16,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",16,1,5,0)="For a complete description, see NPM."
^DIC(9.4,48,22,5.28,"PAH",17,0)="67 SEQ #55^2961011^1"
^DIC(9.4,48,22,5.28,"PAH",17,1,0)="^^1^1^2961011"
^DIC(9.4,48,22,5.28,"PAH",17,1,1,0)="See National Patch Module for description."
^DIC(9.4,48,22,5.28,"PAH",18,0)="64 SEQ #56^2961015^1"
^DIC(9.4,48,22,5.28,"PAH",18,1,0)="^^5^5^2961015"
^DIC(9.4,48,22,5.28,"PAH",18,1,1,0)="This prevents creation of records in TRANSMITTED OUTPATIENT ENCOUNTER FIle"
^DIC(9.4,48,22,5.28,"PAH",18,1,2,0)="(#409.73) for visits prior to 10/1/96.  Post-installation cleans up"
^DIC(9.4,48,22,5.28,"PAH",18,1,3,0)="existing entries of this type."
^DIC(9.4,48,22,5.28,"PAH",18,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",18,1,5,0)="For complete description see NPM."
^DIC(9.4,48,22,5.28,"PAH",19,0)="58 SEQ #57^2961023^1"
^DIC(9.4,48,22,5.28,"PAH",19,1,0)="^^1^1^2961023"
^DIC(9.4,48,22,5.28,"PAH",19,1,1,0)=" Health Promotion Initiative extract"
^DIC(9.4,48,22,5.28,"PAH",20,0)="68 SEQ #58^2961023^1"
^DIC(9.4,48,22,5.28,"PAH",20,1,0)="^^9^9^2961023"
^DIC(9.4,48,22,5.28,"PAH",20,1,1,0)=" Please refer to the National Patch Module for complete details."
^DIC(9.4,48,22,5.28,"PAH",20,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",20,1,3,0)=" This distribution contains the following enhancements:"
^DIC(9.4,48,22,5.28,"PAH",20,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",20,1,5,0)="   * For a user specified patient, mark all encounters that were"
^DIC(9.4,48,22,5.28,"PAH",20,1,6,0)="     rejected by the National Patient Care Database for retransmission"
^DIC(9.4,48,22,5.28,"PAH",20,1,7,0)=" "
^DIC(9.4,48,22,5.28,"PAH",20,1,8,0)="   * Do not include the DG1 HL7 segment when transmitting an Occasion of"
^DIC(9.4,48,22,5.28,"PAH",20,1,9,0)="     Service to the National Patient Care Database"
^DIC(9.4,48,22,5.28,"PAH",21,0)="63 SEQ #59^2961028^1"
^DIC(9.4,48,22,5.28,"PAH",21,1,0)="^^2^2^2961028"
^DIC(9.4,48,22,5.28,"PAH",21,1,1,0)="This patch is being issued in conjunction with patches from Lab,"
^DIC(9.4,48,22,5.28,"PAH",21,1,2,0)="Radiology, and PCE.  For details, see the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",22,0)="69 SEQ #60^2961030^1"
^DIC(9.4,48,22,5.28,"PAH",22,1,0)="^^1^1^2961030"
^DIC(9.4,48,22,5.28,"PAH",22,1,1,0)="See National Patch Module for description."
^DIC(9.4,48,22,5.28,"PAH",23,0)="74 SEQ #61^2961101^1"
^DIC(9.4,48,22,5.28,"PAH",23,1,0)="^^2^2^2961101"
