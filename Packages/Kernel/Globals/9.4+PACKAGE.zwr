^DIC(9.4,3,22,21,"PAH",108,1,58,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",108,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,60,0)="=============================================================================="
^DIC(9.4,3,22,21,"PAH",108,1,61,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",108,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,63,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,64,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",108,1,65,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",108,1,66,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,67,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",108,1,68,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",108,1,69,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,70,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",108,1,71,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",108,1,72,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",108,1,73,0)="      options:"
^DIC(9.4,3,22,21,"PAH",108,1,74,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,75,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",108,1,76,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",108,1,77,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",108,1,78,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",108,1,79,0)="         "
^DIC(9.4,3,22,21,"PAH",108,1,80,0)=" 4.  This patch can be loaded any non-peak time."
^DIC(9.4,3,22,21,"PAH",108,1,81,0)="     Users can remain on the system. "
^DIC(9.4,3,22,21,"PAH",108,1,82,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,83,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",108,1,84,0)="      option:"
^DIC(9.4,3,22,21,"PAH",108,1,85,0)="         Install Package(s)  'XU*8.0*120'"
^DIC(9.4,3,22,21,"PAH",108,1,86,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",108,1,87,0)="                              "
^DIC(9.4,3,22,21,"PAH",108,1,88,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",108,1,89,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",108,1,90,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",108,1,91,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,92,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",108,1,93,0)="      OpenM Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",108,1,94,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",108,1,95,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",108,1,96,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,97,0)="ZTEDIT*"
^DIC(9.4,3,22,21,"PAH",108,1,98,0)=""
^DIC(9.4,3,22,21,"PAH",108,1,99,0)="      "
^DIC(9.4,3,22,21,"PAH",108,1,100,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",108,1,101,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",108,1,102,0)="      DO ^ZTEDIT"
^DIC(9.4,3,22,21,"PAH",108,1,103,0)="       "
^DIC(9.4,3,22,21,"PAH",108,1,104,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",108,1,105,0)=""
