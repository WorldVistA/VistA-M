^DIC(9.4,11,22,5.03,"PAH",45,1,60,0)="LA UI AUTO RELEASE MASTER             New"
^DIC(9.4,11,22,5.03,"PAH",45,1,61,0)="LA UI PROVIDER CONTACT INFO           New "
^DIC(9.4,11,22,5.03,"PAH",45,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,64,0)="The following are new entries new entry in the file LA7 MESSAGE LOG "
^DIC(9.4,11,22,5.03,"PAH",45,1,65,0)="BULLETINS (#62.485):"
^DIC(9.4,11,22,5.03,"PAH",45,1,66,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,67,0)="CODE: 301"
^DIC(9.4,11,22,5.03,"PAH",45,1,68,0)="TEXT: Msg #|1|, User |2| [DUZ: |3|] does not own the LRVERIFY security "
^DIC(9.4,11,22,5.03,"PAH",45,1,69,0)="key. Auto Release not allowed for accession UID |4|."
^DIC(9.4,11,22,5.03,"PAH",45,1,70,0)="SEND ALERT: YES"
^DIC(9.4,11,22,5.03,"PAH",45,1,71,0)="   "
^DIC(9.4,11,22,5.03,"PAH",45,1,72,0)="CODE: 302"
^DIC(9.4,11,22,5.03,"PAH",45,1,73,0)="TEXT: Msg #|1|, User |2| [DUZ: |3|] is not an active user on the system. "
^DIC(9.4,11,22,5.03,"PAH",45,1,74,0)="Auto Release not allowed for accession UID |4|."
^DIC(9.4,11,22,5.03,"PAH",45,1,75,0)="SEND ALERT: YES                      "
^DIC(9.4,11,22,5.03,"PAH",45,1,76,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,77,0)="CODE: 303"
^DIC(9.4,11,22,5.03,"PAH",45,1,78,0)="TEXT: Msg #|1|, No verifying user or application proxy found. Auto "
^DIC(9.4,11,22,5.03,"PAH",45,1,79,0)="Release not allowed for accession UID |2|."
^DIC(9.4,11,22,5.03,"PAH",45,1,80,0)="SEND ALERT: YES                      "
^DIC(9.4,11,22,5.03,"PAH",45,1,81,0)="   "
^DIC(9.4,11,22,5.03,"PAH",45,1,82,0)="CODE: 304"
^DIC(9.4,11,22,5.03,"PAH",45,1,83,0)="TEXT: Msg #|1|, User |2| [DUZ: |3|] is not a valid user to verify "
^DIC(9.4,11,22,5.03,"PAH",45,1,84,0)="results. Auto Release not allowed for accession UID |4|."
^DIC(9.4,11,22,5.03,"PAH",45,1,85,0)="SEND ALERT: YES                        "
^DIC(9.4,11,22,5.03,"PAH",45,1,86,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,87,0)="CODE: 305"
^DIC(9.4,11,22,5.03,"PAH",45,1,88,0)="TEXT: Msg #|1|, User |2| [DUZ: |3|] is not allowed to verify. Only auto "
^DIC(9.4,11,22,5.03,"PAH",45,1,89,0)="verification enabled for this instrument. Auto Release not allowed for "
^DIC(9.4,11,22,5.03,"PAH",45,1,90,0)="accession UID |4|."
^DIC(9.4,11,22,5.03,"PAH",45,1,91,0)="SEND ALERT: YES                        "
^DIC(9.4,11,22,5.03,"PAH",45,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,93,0)="CODE: 306"
^DIC(9.4,11,22,5.03,"PAH",45,1,94,0)="TEXT: Msg #|1|, User |2| [DUZ: |3|] is not allowed to verify. Only tech "
^DIC(9.4,11,22,5.03,"PAH",45,1,95,0)="verification enabled for this instrument.  Auto Release not allowed for "
^DIC(9.4,11,22,5.03,"PAH",45,1,96,0)="accession UID |4|."
^DIC(9.4,11,22,5.03,"PAH",45,1,97,0)="SEND ALERT: YES                        "
^DIC(9.4,11,22,5.03,"PAH",45,1,98,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,99,0)="CODE: 307"
