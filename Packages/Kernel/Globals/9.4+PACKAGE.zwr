^DIC(9.4,48,22,5.28,"PAH",649,1,4,0)="Jira Tickets:"
^DIC(9.4,48,22,5.28,"PAH",649,1,5,0)="============="
^DIC(9.4,48,22,5.28,"PAH",649,1,6,0)="VSE-5522: MD - VistA: Create a new version of the SDES CREATE CLINIC RPC "
^DIC(9.4,48,22,5.28,"PAH",649,1,7,0)="               that adheres to SDES standards"
^DIC(9.4,48,22,5.28,"PAH",649,1,8,0)="VSE-5523: BF - VistA: Create a new version of SDES EDIT CLINIC RPC that "
^DIC(9.4,48,22,5.28,"PAH",649,1,9,0)="               adheres to SDES standards"
^DIC(9.4,48,22,5.28,"PAH",649,1,10,0)="VSE-5564: BB - VistA: Rewrite SDES CREATE APPT BLK AND MOVE to accept a "
^DIC(9.4,48,22,5.28,"PAH",649,1,11,0)="               clinic IEN"
^DIC(9.4,48,22,5.28,"PAH",649,1,12,0)="VSE-5566: JS - VistA: Create a new SDES2 RPC to get the medication list"
^DIC(9.4,48,22,5.28,"PAH",649,1,13,0)="VSE-5576: BF - VistA: Create RPC to return all open appt requests, "
^DIC(9.4,48,22,5.28,"PAH",649,1,14,0)="               consults, and recall reminders for a given institution"
^DIC(9.4,48,22,5.28,"PAH",649,1,15,0)="VSE-5620: LB - VistA: Create new versions of SDES CONTACT ADD/UPDATE and "
^DIC(9.4,48,22,5.28,"PAH",649,1,16,0)="               SDES CONTACT DISPLAY RPCs to include a context/metadata"
^DIC(9.4,48,22,5.28,"PAH",649,1,17,0)="               array as the first input parameter"
^DIC(9.4,48,22,5.28,"PAH",649,1,18,0)="VSE-5701: TB - VSE Error when scheduling walk in appts between 12a-1am"
^DIC(9.4,48,22,5.28,"PAH",649,1,19,0)="VSE-5742: BF - VistA: Create a new SDES2 GET HOLIDAYS to allow for an "
^DIC(9.4,48,22,5.28,"PAH",649,1,20,0)="               optional end date"
^DIC(9.4,48,22,5.28,"PAH",649,1,21,0)="VSE-5819: AP - VistA: Create a new RPC to return patient registration "
^DIC(9.4,48,22,5.28,"PAH",649,1,22,0)="               data for the ids passed in"
^DIC(9.4,48,22,5.28,"PAH",649,1,23,0)="VSE-5873: AP - VistA: Modify SDESCHECKOUT routine to lock/unlock record "
^DIC(9.4,48,22,5.28,"PAH",649,1,24,0)="               in SDE file"
^DIC(9.4,48,22,5.28,"PAH",649,1,25,0)="VSE-5889: DS - VistA: Modify SDES GET PATIENT REGISTRATION2 to return the "
^DIC(9.4,48,22,5.28,"PAH",649,1,26,0)="               Date of Death"
