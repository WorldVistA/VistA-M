^DIC(9.4,3,22,21,"PAH",274,1,408,0)="Blood Bank Clearance:"
^DIC(9.4,3,22,21,"PAH",274,1,409,0)="============================="
^DIC(9.4,3,22,21,"PAH",274,1,410,0)="Clearance - Mar. 19, 2004"
^DIC(9.4,3,22,21,"PAH",274,1,411,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch XU*8*285 "
^DIC(9.4,3,22,21,"PAH",274,1,412,0)="contains changes to a package referenced in VHA IO SEPG SOP 192-023 "
^DIC(9.4,3,22,21,"PAH",274,1,413,0)="""Review of VISTA Patches for Effects on VISTA Blood Bank Software . This "
^DIC(9.4,3,22,21,"PAH",274,1,414,0)="patch does not alter or modify any VistA Blood Bank software design "
^DIC(9.4,3,22,21,"PAH",274,1,415,0)="safeguards or safety critical elements functions."
^DIC(9.4,3,22,21,"PAH",274,1,416,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,417,0)="RISK ANALYSIS: Changes made by patch XU*8*285 have no effect on Blood "
^DIC(9.4,3,22,21,"PAH",274,1,418,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,3,22,21,"PAH",274,1,419,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,420,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,421,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",274,1,422,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,423,0)="     1.   Users ARE allowed to be on the system during the"
^DIC(9.4,3,22,21,"PAH",274,1,424,0)="     installation."
^DIC(9.4,3,22,21,"PAH",274,1,425,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,426,0)="     2.   DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",274,1,427,0)="     so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",274,1,428,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,429,0)="     3.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,3,22,21,"PAH",274,1,430,0)="     This option will load the KIDS (Kernel Installation and Distribution"
^DIC(9.4,3,22,21,"PAH",274,1,431,0)="     System) package onto your system."
^DIC(9.4,3,22,21,"PAH",274,1,432,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,433,0)="     4.   You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",274,1,434,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,435,0)="     5.   The patch has now been loaded into a transport global on your"
^DIC(9.4,3,22,21,"PAH",274,1,436,0)="     system.  On the KIDS menu, select the 'Installation' menu and use"
^DIC(9.4,3,22,21,"PAH",274,1,437,0)="     the following options:"
^DIC(9.4,3,22,21,"PAH",274,1,438,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",274,1,439,0)="           Print Transport Global"
^DIC(9.4,3,22,21,"PAH",274,1,440,0)="           Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",274,1,441,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",274,1,442,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,443,0)="           Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",274,1,444,0)="           Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",274,1,445,0)="                               ======="
^DIC(9.4,3,22,21,"PAH",274,1,446,0)="            Install Package(s)"
^DIC(9.4,3,22,21,"PAH",274,1,447,0)="            Select INSTALL NAME: XU*8.0*285"
^DIC(9.4,3,22,21,"PAH",274,1,448,0)="                                 =========="
^DIC(9.4,3,22,21,"PAH",274,1,449,0)="                                 "
^DIC(9.4,3,22,21,"PAH",274,1,450,0)="        Enter the Coordinator for Mail Group 'XQAL UNPROCESSED ALERTS': "
^DIC(9.4,3,22,21,"PAH",274,1,451,0)="        username"
^DIC(9.4,3,22,21,"PAH",274,1,452,0)="        ========"
^DIC(9.4,3,22,21,"PAH",274,1,453,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",274,1,454,0)="                                                              =="
^DIC(9.4,3,22,21,"PAH",274,1,455,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,3,22,21,"PAH",274,1,456,0)="        YES// NO"
^DIC(9.4,3,22,21,"PAH",274,1,457,0)="              =="
^DIC(9.4,3,22,21,"PAH",274,1,458,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,459,0)="     6.  AXP Sites - Answer 'NO' to the question 'Want to MOVE"
^DIC(9.4,3,22,21,"PAH",274,1,460,0)="     routines to other CPUs?'."
^DIC(9.4,3,22,21,"PAH",274,1,461,0)=" "
^DIC(9.4,3,22,21,"PAH",274,1,462,0)="     7.  If the routines were unmapped as part of step 2, they should be"
^DIC(9.4,3,22,21,"PAH",274,1,463,0)="     returned to the mapped set once the installation has run to"
^DIC(9.4,3,22,21,"PAH",274,1,464,0)="     completion."
