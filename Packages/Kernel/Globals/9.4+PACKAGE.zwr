^DIC(9.4,11,22,5.03,"PAH",18,1,222,0)="                                                                                "
^DIC(9.4,11,22,5.03,"PAH",18,1,223,0)="                                                                                "
^DIC(9.4,11,22,5.03,"PAH",18,1,224,0)="                                                                                "
