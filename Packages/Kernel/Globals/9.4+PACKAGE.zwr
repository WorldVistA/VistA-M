^DIC(9.4,49,22,10,0)="2.0^3051119^2960627"
^DIC(9.4,49,22,10,"PAH",0)="^9.4901^703^703"
^DIC(9.4,49,22,10,"PAH",1,0)="55^2960807^1"
^DIC(9.4,49,22,10,"PAH",1,1,0)="^^5^5^2960807"
^DIC(9.4,49,22,10,"PAH",1,1,1,0)="Patch IB*2*55 for Integrated Billing adds the ability to flag Stop Codes"
^DIC(9.4,49,22,10,"PAH",1,1,2,0)="and Clinics as non-billable or non-auto billable for Third Party Billing."
^DIC(9.4,49,22,10,"PAH",1,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",1,1,4,0)="Please see the National Patch Module description for this patch for more"
^DIC(9.4,49,22,10,"PAH",1,1,5,0)="detailed information."
^DIC(9.4,49,22,10,"PAH",2,0)="60^2960823^1"
^DIC(9.4,49,22,10,"PAH",2,1,0)="^^6^6^2960823"
^DIC(9.4,49,22,10,"PAH",2,1,1,0)="This is patch IB*2*60 for the Integrated Billing package.  This patch"
^DIC(9.4,49,22,10,"PAH",2,1,2,0)="supports the Ambulatory Data Capture requirements for 10/1/96, as well as"
^DIC(9.4,49,22,10,"PAH",2,1,3,0)="the release of PCE."
^DIC(9.4,49,22,10,"PAH",2,1,4,0)=" "
^DIC(9.4,49,22,10,"PAH",2,1,5,0)="Please see the National Patch Module description for this patch for more"
^DIC(9.4,49,22,10,"PAH",2,1,6,0)="detailed information."
^DIC(9.4,49,22,10,"PAH",3,0)="62^2960920^1"
^DIC(9.4,49,22,10,"PAH",3,1,0)="^^5^5^2960920"
^DIC(9.4,49,22,10,"PAH",3,1,1,0)="This is patch IB*2*62 for the Integrated Billing package.  This patch"
^DIC(9.4,49,22,10,"PAH",3,1,2,0)="addresses various nois messages for the package."
^DIC(9.4,49,22,10,"PAH",3,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",3,1,4,0)="Please see the National Patch Module description for the patch for more"
^DIC(9.4,49,22,10,"PAH",3,1,5,0)="detailed information."
^DIC(9.4,49,22,10,"PAH",4,0)="63^2961113^1"
^DIC(9.4,49,22,10,"PAH",5,0)="64^2961126^1"
^DIC(9.4,49,22,10,"PAH",5,1,0)="^^6^6^2961126"
^DIC(9.4,49,22,10,"PAH",5,1,1,0)="This is patch IB*2*64 for the Integrated Billing package.  This patch"
^DIC(9.4,49,22,10,"PAH",5,1,2,0)="captures insurance carrier statistics for fiscal year 1996 for the"
^DIC(9.4,49,22,10,"PAH",5,1,3,0)="MCCR program office."
^DIC(9.4,49,22,10,"PAH",5,1,4,0)=" "
^DIC(9.4,49,22,10,"PAH",5,1,5,0)="Please see the National Patch Module description for this patch for more"
^DIC(9.4,49,22,10,"PAH",5,1,6,0)="detailed information."
^DIC(9.4,49,22,10,"PAH",6,0)="66 SEQ #62^2970401^1"
^DIC(9.4,49,22,10,"PAH",6,1,0)="^^1^1^2970401"
^DIC(9.4,49,22,10,"PAH",6,1,1,0)="Enhancements to the Vets with Insurance Reports"
^DIC(9.4,49,22,10,"PAH",7,0)="72 SEQ #63^2970414^1"
^DIC(9.4,49,22,10,"PAH",7,1,0)="^^1^1^2970414"
^DIC(9.4,49,22,10,"PAH",7,1,1,0)="INSURANCE TREND REPORT PROBLEM"
^DIC(9.4,49,22,10,"PAH",8,0)="68 SEQ #64^2970414^1"
^DIC(9.4,49,22,10,"PAH",8,1,0)="^^1^1^2970414"
^DIC(9.4,49,22,10,"PAH",8,1,1,0)="INSURANCE MODULE PROBLEMS"
^DIC(9.4,49,22,10,"PAH",9,0)="71 SEQ #65^2970417^1"
^DIC(9.4,49,22,10,"PAH",9,1,0)="^^1^1^2970417"
^DIC(9.4,49,22,10,"PAH",9,1,1,0)="SPECIAL CONDITION (SC) PROBLEM"
^DIC(9.4,49,22,10,"PAH",10,0)="69 SEQ #66^2970508^1"
^DIC(9.4,49,22,10,"PAH",10,1,0)="^^2^2^2970508"
^DIC(9.4,49,22,10,"PAH",10,1,1,0)="Patch IB*2*69 contains the Diagnostic Measures reports and includes a new"
^DIC(9.4,49,22,10,"PAH",10,1,2,0)="menu which is designed for the MCCR Coordinator."
^DIC(9.4,49,22,10,"PAH",11,0)="76 SEQ #67^2970528^1"
^DIC(9.4,49,22,10,"PAH",11,1,0)="^^1^1^2970528"
^DIC(9.4,49,22,10,"PAH",11,1,1,0)="Modifications for CPT v6.0 update."
^DIC(9.4,49,22,10,"PAH",12,0)="75 SEQ #68^2970602^1"
^DIC(9.4,49,22,10,"PAH",12,1,0)="^^2^2^2970602"
^DIC(9.4,49,22,10,"PAH",12,1,1,0)="This patch adds pre-registration as a new source of information"
^DIC(9.4,49,22,10,"PAH",12,1,2,0)="for patient insurance policies."
^DIC(9.4,49,22,10,"PAH",13,0)="83 SEQ #69^2970808^1"
^DIC(9.4,49,22,10,"PAH",13,1,0)="^^5^5^2970808"
^DIC(9.4,49,22,10,"PAH",13,1,1,0)="This patch fixes a problem whereby an illegal number error may occur"
^DIC(9.4,49,22,10,"PAH",13,1,2,0)="when using the 'SC Vets w/ NSC Episodes of Care Not Billed (Inpt)' option"
^DIC(9.4,49,22,10,"PAH",13,1,3,0)="when the BILL NUMBER field (.01) in the BILL/CLAIMS file (399) contains"
^DIC(9.4,49,22,10,"PAH",13,1,4,0)="an E, such as 5E1345."
^DIC(9.4,49,22,10,"PAH",13,1,5,0)="~"
^DIC(9.4,49,22,10,"PAH",14,0)="78 SEQ #70^2970808^1"
^DIC(9.4,49,22,10,"PAH",14,1,0)="^^1^1^2970808"
^DIC(9.4,49,22,10,"PAH",14,1,1,0)="PROBLEM WITH IBARXEC4"
^DIC(9.4,49,22,10,"PAH",15,0)="52^2970808^1"
^DIC(9.4,49,22,10,"PAH",15,1,0)="^^2^2^2970808"
^DIC(9.4,49,22,10,"PAH",15,1,1,0)=" "
^DIC(9.4,49,22,10,"PAH",15,1,2,0)="Patch for output formatter utility, Charge Master, and Tri-care."
^DIC(9.4,49,22,10,"PAH",16,0)="86 SEQ #72^2970819^1"
^DIC(9.4,49,22,10,"PAH",16,1,0)="^^2^2^2970819"
^DIC(9.4,49,22,10,"PAH",16,1,1,0)="Charge Item File (363.2) and the post init to add the Tort and Interagency"
^DIC(9.4,49,22,10,"PAH",16,1,2,0)="Rates."
^DIC(9.4,49,22,10,"PAH",17,0)="81 SEQ #73^2970819^1"
^DIC(9.4,49,22,10,"PAH",17,1,0)="^^6^6^2970819"
^DIC(9.4,49,22,10,"PAH",17,1,1,0)="This patch fixes a problem whereby the Earliest Auto Bill Date is being"
^DIC(9.4,49,22,10,"PAH",17,1,2,0)="changed to a date beyond the end of the billing cycle when the end"
^DIC(9.4,49,22,10,"PAH",17,1,3,0)="of the billing cycle is greater than the date the auto biller is running."
^DIC(9.4,49,22,10,"PAH",17,1,4,0)="As a result, the episode is not included on a bill until the next"
^DIC(9.4,49,22,10,"PAH",17,1,5,0)="billing cycle.  This problem occurs with both prescription refills"
^DIC(9.4,49,22,10,"PAH",17,1,6,0)="and outpatient visits."
^DIC(9.4,49,22,10,"PAH",18,0)="84 SEQ #74^2971028^1"
^DIC(9.4,49,22,10,"PAH",18,1,0)="^^1^1^2971028"
^DIC(9.4,49,22,10,"PAH",18,1,1,0)="OUTPUT FORMATTER PROBLEMS"
^DIC(9.4,49,22,10,"PAH",19,0)="77 SEQ #75^2971028^1"
^DIC(9.4,49,22,10,"PAH",19,1,0)="^^14^14^2971028"
^DIC(9.4,49,22,10,"PAH",19,1,1,0)="This is a coordinated patch between the Integrated Billing and Accounts"
^DIC(9.4,49,22,10,"PAH",19,1,2,0)="Receivable packages.  Patch IB*2.0*77 contains two modified routines,"
^DIC(9.4,49,22,10,"PAH",19,1,3,0)="one for Integrated Billing and one for Accounts Receivable.  Both are"
^DIC(9.4,49,22,10,"PAH",19,1,4,0)="being released under the IB*2.0*77 patch namespace to assure installation"
^DIC(9.4,49,22,10,"PAH",19,1,5,0)="at the same time, as one routine is dependent upon the other.  The"
^DIC(9.4,49,22,10,"PAH",19,1,6,0)="associated AR patch is PRCA*4.5*84, and is listed in the National Patch"
^DIC(9.4,49,22,10,"PAH",19,1,7,0)="Module as an information only patch.  A post-init routine is also sent"
^DIC(9.4,49,22,10,"PAH",19,1,8,0)="with this patch.  As part of the post-init process, the Accounts Receivable"
^DIC(9.4,49,22,10,"PAH",19,1,9,0)="package file will be updated to indicate successful installation of patch"
^DIC(9.4,49,22,10,"PAH",19,1,10,0)="PRCA*4.5*84."
^DIC(9.4,49,22,10,"PAH",19,1,11,0)=" "
^DIC(9.4,49,22,10,"PAH",19,1,12,0)="This coordinated patch fixes a problem whereby AR bills with an AMENDED"
^DIC(9.4,49,22,10,"PAH",19,1,13,0)="BILL status were not being cancelled when the associated IB bill was"
^DIC(9.4,49,22,10,"PAH",19,1,14,0)="cancelled."
^DIC(9.4,49,22,10,"PAH",20,0)="79 SEQ #77^2980129^1"
^DIC(9.4,49,22,10,"PAH",20,1,0)="^^1^1^2980129"
^DIC(9.4,49,22,10,"PAH",20,1,1,0)="STOP CHARGING CHAMPVA SUBSISTENCE"
^DIC(9.4,49,22,10,"PAH",21,0)="85 SEQ #78^2980227^1"
^DIC(9.4,49,22,10,"PAH",21,1,0)="^^1^1^2980227"
^DIC(9.4,49,22,10,"PAH",21,1,1,0)="Insurance updates and changes."
^DIC(9.4,49,22,10,"PAH",22,0)="70 SEQ #79^2980318^1"
^DIC(9.4,49,22,10,"PAH",22,1,0)="^^3^3^2980318"
^DIC(9.4,49,22,10,"PAH",22,1,1,0)="This is the first in a series of patches to address changes that must be"
^DIC(9.4,49,22,10,"PAH",22,1,2,0)="made to MCCR software (Integrated Billing and Accounts Receivable) in"
^DIC(9.4,49,22,10,"PAH",22,1,3,0)="order to implement General Counsel opinion VAOPGCPREC 3-96. "
^DIC(9.4,49,22,10,"PAH",23,0)="80^2980403^1"
^DIC(9.4,49,22,10,"PAH",23,1,0)="^^1^1^2980403"
^DIC(9.4,49,22,10,"PAH",23,1,1,0)="Coordination of Benefits patch."
^DIC(9.4,49,22,10,"PAH",24,0)="93 SEQ #81^2980403^1"
^DIC(9.4,49,22,10,"PAH",24,1,0)="^^1^1^2980403"
^DIC(9.4,49,22,10,"PAH",24,1,1,0)="Year 2000 changes."
^DIC(9.4,49,22,10,"PAH",25,0)="94 SEQ #82^2980513^1"
^DIC(9.4,49,22,10,"PAH",25,1,0)="^^1^1^2980513"
^DIC(9.4,49,22,10,"PAH",25,1,1,0)="Required for special processing of file 351.1 for patient merge."
^DIC(9.4,49,22,10,"PAH",26,0)="61 SEQ #83^2980527^1"
^DIC(9.4,49,22,10,"PAH",26,1,0)="^^1^1^2980527"
^DIC(9.4,49,22,10,"PAH",26,1,1,0)="IB*2.0*61 Regional Counsel Interface"
^DIC(9.4,49,22,10,"PAH",27,0)="91 SEQ #84^2980616^1"
^DIC(9.4,49,22,10,"PAH",27,1,0)="^^5^5^2980616"
^DIC(9.4,49,22,10,"PAH",27,1,1,0)="Scheduling Conversion Software changes: Integrated Billing's changes to"
^DIC(9.4,49,22,10,"PAH",27,1,2,0)="accomodate the removal of the Scheduling Visits, Outpatient Diagnosis,"
^DIC(9.4,49,22,10,"PAH",27,1,3,0)="Outpatient Provider files and their transfer to PCE and the Outpatient"
^DIC(9.4,49,22,10,"PAH",27,1,4,0)="Encounter file.  For more detailed information, refer to the patch"
^DIC(9.4,49,22,10,"PAH",27,1,5,0)="description in the National Patch Module."
^DIC(9.4,49,22,10,"PAH",28,0)="97 SEQ #85^2980616^1"
^DIC(9.4,49,22,10,"PAH",29,0)="92 SEQ #86^2980622^1"
^DIC(9.4,49,22,10,"PAH",29,1,0)="^^3^3^2980622"
^DIC(9.4,49,22,10,"PAH",29,1,1,0)="This patch includes the Medicare Remittance Advice Survey designed to"
^DIC(9.4,49,22,10,"PAH",29,1,2,0)="provide a one time national rollup of back billing potential of Medicare"
^DIC(9.4,49,22,10,"PAH",29,1,3,0)="Supplimental Carriers."
^DIC(9.4,49,22,10,"PAH",30,0)="99 SEQ #87^2980725^1"
^DIC(9.4,49,22,10,"PAH",30,1,0)="^^1^1^2980725"
^DIC(9.4,49,22,10,"PAH",30,1,1,0)="See the National Patch Module for patch details."
^DIC(9.4,49,22,10,"PAH",31,0)="88^2980831^1"
^DIC(9.4,49,22,10,"PAH",31,1,0)="^^4^4^2980831"
^DIC(9.4,49,22,10,"PAH",31,1,1,0)="This patch fixes a number of problems in IB."
^DIC(9.4,49,22,10,"PAH",31,1,2,0)="It fixes a string too long error, print status of a bill, output formatter"
^DIC(9.4,49,22,10,"PAH",31,1,3,0)="short timeout on a read command and a post init that does a cleanup"
^DIC(9.4,49,22,10,"PAH",31,1,4,0)="of file 364.7."
^DIC(9.4,49,22,10,"PAH",32,0)="102 SEQ #90^2981007^1"
^DIC(9.4,49,22,10,"PAH",32,1,0)="^^2^2^2981007"
^DIC(9.4,49,22,10,"PAH",32,1,1,0)="Change input transform so that PAST DATES are assumed when entering"
^DIC(9.4,49,22,10,"PAH",32,1,2,0)="INSURED'S DOB."
^DIC(9.4,49,22,10,"PAH",33,0)="96 SEQ #91^2981016^1"
^DIC(9.4,49,22,10,"PAH",33,1,0)="^^2^2^2981016"
^DIC(9.4,49,22,10,"PAH",33,1,1,0)="This build contains the correction to the TOP form on UB92 using output"
^DIC(9.4,49,22,10,"PAH",33,1,2,0)="formatter."
^DIC(9.4,49,22,10,"PAH",34,0)="82 SEQ #93^2981119^1"
^DIC(9.4,49,22,10,"PAH",34,1,0)="^^1^1^2981119"
^DIC(9.4,49,22,10,"PAH",34,1,1,0)="Insurance Buffer File."
^DIC(9.4,49,22,10,"PAH",35,0)="98 SEQ #94^2981229^1"
