^DIC(9.4,4,22,1,"PAH",66,0)="77 SEQ #91^2991019^1"
^DIC(9.4,4,22,1,"PAH",66,1,0)="^^59^59^2991019"
^DIC(9.4,4,22,1,"PAH",66,1,1,0)="Patch XM*7.1*77"
^DIC(9.4,4,22,1,"PAH",66,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",66,1,3,0)="NOIS:  BRX-0297-10955"
^DIC(9.4,4,22,1,"PAH",66,1,4,0)="Test Site:  Bronx"
^DIC(9.4,4,22,1,"PAH",66,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",66,1,6,0)="This patch ensures that duplicate members cannot be added to the"
^DIC(9.4,4,22,1,"PAH",66,1,7,0)="MEMBER multiple of the MAIL GROUP file. "
^DIC(9.4,4,22,1,"PAH",66,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",66,1,9,0)="The pre-init for this patch checks the MEMBER multiple of the MAIL GROUP"
^DIC(9.4,4,22,1,"PAH",66,1,10,0)="file and deletes any duplicates."
^DIC(9.4,4,22,1,"PAH",66,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",66,1,12,0)="The .01 field of the MEMBER multiple of the MAIL GROUP file is altered"
^DIC(9.4,4,22,1,"PAH",66,1,13,0)="as follows:"
^DIC(9.4,4,22,1,"PAH",66,1,14,0)="1. the ""B"" xref is converted from a traditional xref to a new index."
^DIC(9.4,4,22,1,"PAH",66,1,15,0)="2. a uniqueness key is added."
^DIC(9.4,4,22,1,"PAH",66,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",66,1,17,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",66,1,18,0)="minimum.  It requires MailMan patch XM*7.1*50 and FileMan patch DI*22.0*12."
^DIC(9.4,4,22,1,"PAH",66,1,19,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",66,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",66,1,21,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",66,1,22,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",66,1,23,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",66,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",66,1,25,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",66,1,26,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",66,1,27,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",66,1,28,0)="XMYPRE3       * NEW *          1406835        77"
