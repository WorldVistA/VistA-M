^DIC(9.4,3,22,21,"PAH",31,1,80,0)="XPDV         9865255        11643577        30,44,58"
^DIC(9.4,3,22,21,"PAH",31,1,81,0)="XQOO1       14519526        14826502        10,21,39,41,58"
^DIC(9.4,3,22,21,"PAH",31,1,82,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",31,1,83,0)="DOCUMENTATION:"
^DIC(9.4,3,22,21,"PAH",31,1,84,0)=" 1.  PARTIAL DD: BUILD #9.6"
^DIC(9.4,3,22,21,"PAH",31,1,85,0)="         SUB DD: ENTRIES #9.68"
^DIC(9.4,3,22,21,"PAH",31,1,86,0)="          FIELD: ACTION #.03"
^DIC(9.4,3,22,21,"PAH",31,1,87,0)="            0        SEND TO SITE"
^DIC(9.4,3,22,21,"PAH",31,1,88,0)="            1        DELETE AT SITE"
^DIC(9.4,3,22,21,"PAH",31,1,89,0)="            2        USE AS LINK FOR MENU ITEMS"
^DIC(9.4,3,22,21,"PAH",31,1,90,0)="            3        MERGE MENU ITEMS"
^DIC(9.4,3,22,21,"PAH",31,1,91,0)="            4        ATTACH TO MENU"
^DIC(9.4,3,22,21,"PAH",31,1,92,0)="            5        DISABLE DURING INSTALL"
^DIC(9.4,3,22,21,"PAH",31,1,93,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,94,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,95,0)=" 2. The 'Compare Transport Global to Current System' will now let you compare"
^DIC(9.4,3,22,21,"PAH",31,1,96,0)="    just the Routines or just the 2nd line of the Routines."
^DIC(9.4,3,22,21,"PAH",31,1,97,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,98,0)="EXAMPLE:"
^DIC(9.4,3,22,21,"PAH",31,1,99,0)="Select Kernel Installation & Distribution System Option: Installation"
^DIC(9.4,3,22,21,"PAH",31,1,100,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,101,0)="Select Installation Option: Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",31,1,102,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,103,0)="Select INSTALL NAME: TEST 2.2      Loaded from Distribution  2/26/97@13:04:56"
^DIC(9.4,3,22,21,"PAH",31,1,104,0)="     => TEST  ;Created on Feb 24, 1997@12:44:26"
^DIC(9.4,3,22,21,"PAH",31,1,105,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,106,0)="     Select one of the following:"
^DIC(9.4,3,22,21,"PAH",31,1,107,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,108,0)="          1         Full Comparison"
^DIC(9.4,3,22,21,"PAH",31,1,109,0)="          2         Second line of Routines only"
^DIC(9.4,3,22,21,"PAH",31,1,110,0)="          3         Routines only"
^DIC(9.4,3,22,21,"PAH",31,1,111,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,112,0)="Type of Compare: 2  Second line of Routines only"
^DIC(9.4,3,22,21,"PAH",31,1,113,0)="DEVICE: HOME// "
^DIC(9.4,3,22,21,"PAH",31,1,114,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,115,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,116,0)=" 3. When adding Options or Protocols to a Build, you now have 2 new 'Action"
^DIC(9.4,3,22,21,"PAH",31,1,117,0)="    Types': 4  ATTACH TO MENU and 5  DISABLE DURING INSTALL."
^DIC(9.4,3,22,21,"PAH",31,1,118,0)="    ATTACH TO MENU should be used to attach an Option or Protocol that you"
^DIC(9.4,3,22,21,"PAH",31,1,119,0)="    are not exporting to a Menu you are exporting."
^DIC(9.4,3,22,21,"PAH",31,1,120,0)="    DISABLE DURING INSTALL should be used to designate all the Options and"
^DIC(9.4,3,22,21,"PAH",31,1,121,0)="    Protocols that you are not exporting, but you want them put out of order"
^DIC(9.4,3,22,21,"PAH",31,1,122,0)="    during the install process."
^DIC(9.4,3,22,21,"PAH",31,1,123,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,124,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,125,0)=" 4. When a Mail Group is exported with KIDS, the installing user will be"
^DIC(9.4,3,22,21,"PAH",31,1,126,0)="    asked for the Mail Group Coordinator when they use the install option."
^DIC(9.4,3,22,21,"PAH",31,1,127,0)="    The Coordinator will only be added to the Mail Group if the Mail Group"
^DIC(9.4,3,22,21,"PAH",31,1,128,0)="    is new or there is currently not a Coordinator.  The Mail Group Coordinator"
^DIC(9.4,3,22,21,"PAH",31,1,129,0)="    is optional."
^DIC(9.4,3,22,21,"PAH",31,1,130,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,131,0)="EXAMPLE:"
^DIC(9.4,3,22,21,"PAH",31,1,132,0)="Select Kernel Installation & Distribution System Option: Installation"
^DIC(9.4,3,22,21,"PAH",31,1,133,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,134,0)="Select Installation Option: Install Package(s)"
^DIC(9.4,3,22,21,"PAH",31,1,135,0)="Select INSTALL NAME:    TEST 2.2        Loaded from Distribution"
^DIC(9.4,3,22,21,"PAH",31,1,136,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,137,0)="This Distribution was loaded on Feb 27, 1997@08:11:04 with header of "
^DIC(9.4,3,22,21,"PAH",31,1,138,0)="TEST  ;Created on Feb 24, 1997@12:44:26"
^DIC(9.4,3,22,21,"PAH",31,1,139,0)="It consisted of the following Install(s):"
^DIC(9.4,3,22,21,"PAH",31,1,140,0)="TEST 2.2"
^DIC(9.4,3,22,21,"PAH",31,1,141,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,142,0)="   TEST 2.2"
^DIC(9.4,3,22,21,"PAH",31,1,143,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,144,0)="Install Questions for TEST 2.2"
^DIC(9.4,3,22,21,"PAH",31,1,145,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,146,0)="Incoming Mail Groups:"
^DIC(9.4,3,22,21,"PAH",31,1,147,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,148,0)="Enter the Coordinator for Mail Group 'HL7': DIMICELI,RON          RD      "
^DIC(9.4,3,22,21,"PAH",31,1,149,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,150,0)="Enter the Coordinator for Mail Group 'RON TEST': "
^DIC(9.4,3,22,21,"PAH",31,1,151,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,152,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// "
^DIC(9.4,3,22,21,"PAH",31,1,153,0)=""
^DIC(9.4,3,22,21,"PAH",31,1,154,0)=""
^DIC(9.4,3,22,21,"PAH",32,0)="61 SEQ #47^2970408^1"
^DIC(9.4,3,22,21,"PAH",32,1,0)="^^52^52^2980615^"
^DIC(9.4,3,22,21,"PAH",32,1,1,0)=" PREREQUISITES: XU*8.0*58"
^DIC(9.4,3,22,21,"PAH",32,1,2,0)="============================================================================"
^DIC(9.4,3,22,21,"PAH",32,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",32,1,4,0)=" This patch corrects two errors that was introduced in patch XU*8.0*58."
^DIC(9.4,3,22,21,"PAH",32,1,5,0)="ISA-0497-1-448 An undefined error occurred at DIR+19^XPDIQ if the installing"
^DIC(9.4,3,22,21,"PAH",32,1,6,0)=" package asks an question without having a default answer."
^DIC(9.4,3,22,21,"PAH",32,1,7,0)="When moving routines to other CPUs and the install is not queued, the job on"
^DIC(9.4,3,22,21,"PAH",32,1,8,0)=" the other CPU will show the message, ""Can't Lock global, another XPDCPU must"
^DIC(9.4,3,22,21,"PAH",32,1,9,0)=" be running""."
^DIC(9.4,3,22,21,"PAH",32,1,10,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",32,1,11,0)="                    **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",32,1,12,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",32,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",32,1,14,0)=" This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",32,1,15,0)=" should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",32,1,16,0)=" Since this patch is an update to KIDS, no other patches should be installed"
^DIC(9.4,3,22,21,"PAH",32,1,17,0)=" during the installation of this patch."
^DIC(9.4,3,22,21,"PAH",32,1,18,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",32,1,19,0)="  "
^DIC(9.4,3,22,21,"PAH",32,1,20,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",32,1,21,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",32,1,22,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",32,1,23,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",32,1,24,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",32,1,25,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",32,1,26,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",32,1,27,0)="      global."
^DIC(9.4,3,22,21,"PAH",32,1,28,0)="  4.  Users can remain on the system. This patch can be queued and installed"
^DIC(9.4,3,22,21,"PAH",32,1,29,0)="      at any time.  TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",32,1,30,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",32,1,31,0)="      options:"
^DIC(9.4,3,22,21,"PAH",32,1,32,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",32,1,33,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",32,1,34,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",32,1,35,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",32,1,36,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",32,1,37,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",32,1,38,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",32,1,39,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",32,1,40,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",32,1,41,0)="  "
^DIC(9.4,3,22,21,"PAH",32,1,42,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",32,1,43,0)="   Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",32,1,44,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",32,1,45,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",32,1,46,0)=""
^DIC(9.4,3,22,21,"PAH",32,1,47,0)="            Before          After           Patch"
^DIC(9.4,3,22,21,"PAH",32,1,48,0)=" Routine     Checksum        Checksum        List"
^DIC(9.4,3,22,21,"PAH",32,1,49,0)=" ----------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",32,1,50,0)=" XPDIQ       7513883         7519323         21,28,58,61"
^DIC(9.4,3,22,21,"PAH",32,1,51,0)=" XPDI1       6631631         6640407         58,61"
^DIC(9.4,3,22,21,"PAH",32,1,52,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",33,0)="7^2970409^1"
^DIC(9.4,3,22,21,"PAH",33,1,0)="^^25^25^2970409"
^DIC(9.4,3,22,21,"PAH",33,1,1,0)="The routine ORBSTAT was transported as a part of Kernel 8.0 to insure that"
^DIC(9.4,3,22,21,"PAH",33,1,2,0)="the alert statistics would perform correctly with the movement of alert"
^DIC(9.4,3,22,21,"PAH",33,1,3,0)="data from file 200 to file 8992.  Unfortunately, a couple of references to"
^DIC(9.4,3,22,21,"PAH",33,1,4,0)="file 200 were not converted, resulting in no output for the total alert"
^DIC(9.4,3,22,21,"PAH",33,1,5,0)="count.  This patch includes correction of these references within the"
^DIC(9.4,3,22,21,"PAH",33,1,6,0)="routine and a print template for file 8992 which is used by this routine."
^DIC(9.4,3,22,21,"PAH",33,1,7,0)=" "
^DIC(9.4,3,22,21,"PAH",33,1,8,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",33,1,9,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",33,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",33,1,11,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",33,1,12,0)="    option will load the KIDS package in this message onto your system."
^DIC(9.4,3,22,21,"PAH",33,1,13,0)=" 2. Answer NO to the question:"
^DIC(9.4,3,22,21,"PAH",33,1,14,0)="    'Shall I preserve what is on disk in a separate back-up message ?'"
^DIC(9.4,3,22,21,"PAH",33,1,15,0)=" 3. From the 'Installion Menu' of the KIDS menu, run the option"
^DIC(9.4,3,22,21,"PAH",33,1,16,0)="    'Verify Checksums in Transport Global' and verify that all routines"
^DIC(9.4,3,22,21,"PAH",33,1,17,0)="    have the correct checksum."
^DIC(9.4,3,22,21,"PAH",33,1,18,0)=" 4. Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",33,1,19,0)="    user are on the system and the posibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",33,1,20,0)="    acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",33,1,21,0)=" 5. From the 'Installion Menu' of the KIDS menu, run the option"
^DIC(9.4,3,22,21,"PAH",33,1,22,0)="    'Install Package(s)' Select the package 'XU*8.0*7' and proceed with"
^DIC(9.4,3,22,21,"PAH",33,1,23,0)="    install."
^DIC(9.4,3,22,21,"PAH",33,1,24,0)=" 6. Enable user's login if inhibited."
^DIC(9.4,3,22,21,"PAH",33,1,25,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",34,0)="66 SEQ #48^2970711^1"
^DIC(9.4,3,22,21,"PAH",34,1,0)="^^54^54^2970711"
^DIC(9.4,3,22,21,"PAH",34,1,1,0)=" This patch contains the following fixes and features:"
^DIC(9.4,3,22,21,"PAH",34,1,2,0)=" - MUS-0497-71493  A no label error when installing patch XU*8*58 on an"
^DIC(9.4,3,22,21,"PAH",34,1,3,0)="  Open M system."
^DIC(9.4,3,22,21,"PAH",34,1,4,0)=" - The National Package install module on FORUM can now track patches."
^DIC(9.4,3,22,21,"PAH",34,1,5,0)="  KIDS will now be able to update the module for patches."
^DIC(9.4,3,22,21,"PAH",34,1,6,0)=" - Corrects a problem with multi-builds. When a multi-build contains more"
^DIC(9.4,3,22,21,"PAH",34,1,7,0)="  build names that can fit on one header line, a second header line is"
^DIC(9.4,3,22,21,"PAH",34,1,8,0)="  create.  The first build on the second line will begin with a colon, this"
^DIC(9.4,3,22,21,"PAH",34,1,9,0)="  will prevent the build from being installed."
^DIC(9.4,3,22,21,"PAH",34,1,10,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",34,1,11,0)="                    **** INSTALL INSTRUCTIONS ****"
^DIC(9.4,3,22,21,"PAH",34,1,12,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",34,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",34,1,14,0)=" This patch can be installed with users on the system, but no other users"
^DIC(9.4,3,22,21,"PAH",34,1,15,0)=" should be using KIDS while you install this patch."
^DIC(9.4,3,22,21,"PAH",34,1,16,0)=" Since this patch is an update to KIDS, no other patches should be installed"
^DIC(9.4,3,22,21,"PAH",34,1,17,0)=" during the installation of this patch."
^DIC(9.4,3,22,21,"PAH",34,1,18,0)="============================================================================="
^DIC(9.4,3,22,21,"PAH",34,1,19,0)="  "
^DIC(9.4,3,22,21,"PAH",34,1,20,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",34,1,21,0)="  1.  These routines are usually mapped on systems that allow mapping,"
^DIC(9.4,3,22,21,"PAH",34,1,22,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",34,1,23,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",34,1,24,0)="      option will load the KIDS Distribution onto your system."
^DIC(9.4,3,22,21,"PAH",34,1,25,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",34,1,26,0)="      system. You now need to use KIDS to install the patch in the Transport"
^DIC(9.4,3,22,21,"PAH",34,1,27,0)="      global."
^DIC(9.4,3,22,21,"PAH",34,1,28,0)="  4.  Users can remain on the system. This patch can be queued and installed"
^DIC(9.4,3,22,21,"PAH",34,1,29,0)="      at any time.  TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",34,1,30,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",34,1,31,0)="      options:"
^DIC(9.4,3,22,21,"PAH",34,1,32,0)="         2  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",34,1,33,0)="         3  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",34,1,34,0)="         4  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",34,1,35,0)="         5  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",34,1,36,0)="         6  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",34,1,37,0)="  6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",34,1,38,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",34,1,39,0)="  7.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",34,1,40,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",34,1,41,0)="  "
^DIC(9.4,3,22,21,"PAH",34,1,42,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",34,1,43,0)="   Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",34,1,44,0)="   The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",34,1,45,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",34,1,46,0)=""
^DIC(9.4,3,22,21,"PAH",34,1,47,0)="             Before          After           Patch"
^DIC(9.4,3,22,21,"PAH",34,1,48,0)=" Routine     Checksum        Checksum        List"
^DIC(9.4,3,22,21,"PAH",34,1,49,0)=" ----------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",34,1,50,0)=" XPDET       5058369         5059212         15,39,41,44,51,58,66"
^DIC(9.4,3,22,21,"PAH",34,1,51,0)=" XPDIL1      8511833         8519937         15,17,39,41,44,66"
^DIC(9.4,3,22,21,"PAH",34,1,52,0)=" XPDIST      2343711         2400065         66"
^DIC(9.4,3,22,21,"PAH",34,1,53,0)=" XPDT       19247892        19357441         2,10,28,41,44,51,58,66"
^DIC(9.4,3,22,21,"PAH",34,1,54,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",35,0)="49^2970822^1"
^DIC(9.4,3,22,21,"PAH",35,1,0)="^^175^175^2970822"
^DIC(9.4,3,22,21,"PAH",35,1,1,0)="PLEASE NOTE: Sites currently testing Broker version T9 or who have"
^DIC(9.4,3,22,21,"PAH",35,1,2,0)="installed a test version of XU*8*59 will need to reinstall XU*8*59 after"
^DIC(9.4,3,22,21,"PAH",35,1,3,0)="installing this patch."
^DIC(9.4,3,22,21,"PAH",35,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,5,0)="This patch fixes the following NOISs and REQUESTS:"
^DIC(9.4,3,22,21,"PAH",35,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,7,0)="    NOIS                       Description of fix: "
^DIC(9.4,3,22,21,"PAH",35,1,8,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,9,0)="LAS-1196-60534                 When using the option 'Resource Device"
^DIC(9.4,3,22,21,"PAH",35,1,10,0)="Edit,' the field 'RESOURCE SLOTS' would get reset to 1.  The patch"
^DIC(9.4,3,22,21,"PAH",35,1,11,0)="resolves this by performing changes to the DD."
^DIC(9.4,3,22,21,"PAH",35,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,13,0)="ISL-1196-50019                 When a system crashes, resources are left"
^DIC(9.4,3,22,21,"PAH",35,1,14,0)="and still allocated, preventing new jobs from starting.  This patch"
^DIC(9.4,3,22,21,"PAH",35,1,15,0)="provides a new option that can release all resources at startup (Clear all"
^DIC(9.4,3,22,21,"PAH",35,1,16,0)="Resources) and also an option to release a given slot on a resource (Clear"
^DIC(9.4,3,22,21,"PAH",35,1,17,0)="one Resource). New routine XUDHRES, change to ZIS6, ZISC."
^DIC(9.4,3,22,21,"PAH",35,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,19,0)="MUR-0196-30539-XQ33            The option to delete unreferenced options"
^DIC(9.4,3,22,21,"PAH",35,1,20,0)="from the option file didn't check for options used in the new TaskMan"
^DIC(9.4,3,22,21,"PAH",35,1,21,0)="Schedule file. Added field 209.2 (KEEP FROM DELETING) to the option file."
^DIC(9.4,3,22,21,"PAH",35,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,23,0)="CTX-0297-70559                 It was possible to get an earlier entry with"
^DIC(9.4,3,22,21,"PAH",35,1,24,0)="the Effective Date greater than the next entry.  This caused problems when"
^DIC(9.4,3,22,21,"PAH",35,1,25,0)="programes tried to find the current person class.  Fixed with a change to"
^DIC(9.4,3,22,21,"PAH",35,1,26,0)="the DD so only greater dates are allowed. "
^DIC(9.4,3,22,21,"PAH",35,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,29,0)="CHANGES MADE IN RESPONSE TO REQUESTS:"
^DIC(9.4,3,22,21,"PAH",35,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,31,0)="When using the RJD option to stop a TaskMan job, you used to have to"
^DIC(9.4,3,22,21,"PAH",35,1,32,0)="DISPLAY the task before you could delete it.  Modification to routine"
^DIC(9.4,3,22,21,"PAH",35,1,33,0)="XUTMRJD was made to allow site to say NO to the display and still delete"
^DIC(9.4,3,22,21,"PAH",35,1,34,0)="the task from the running task list.  MSG 1060759 (Pete Tichenor)"
^DIC(9.4,3,22,21,"PAH",35,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,36,0)="Removes the testing for MWAPI from ZUMSM.  (Trouble calls)"
^DIC(9.4,3,22,21,"PAH",35,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,38,0)="Have XUS display the Node the user is on.  Changed the XUS routine to"
^DIC(9.4,3,22,21,"PAH",35,1,39,0)="display the Volume-set:Node rather than just the Volume-set alone."
^DIC(9.4,3,22,21,"PAH",35,1,40,0)="Changed the first read to include output text as before in order to flush"
^DIC(9.4,3,22,21,"PAH",35,1,41,0)="the input buffer on certain systems, such as MSM.  (E3R 8568)"
^DIC(9.4,3,22,21,"PAH",35,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,43,0)="Cleans-up pointers to files 3,6,16,20 in sort and print templates.  It"
^DIC(9.4,3,22,21,"PAH",35,1,44,0)="adds checks to code of XUSERNEW, XUA4A7 so they are ready for file"
^DIC(9.4,3,22,21,"PAH",35,1,45,0)="3,6,16,20 cleanup."
^DIC(9.4,3,22,21,"PAH",35,1,46,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,47,0)="Cleans up cross-references in files DEVICE, OPTION, and KERMIT HOLDING."
^DIC(9.4,3,22,21,"PAH",35,1,48,0)="   "
^DIC(9.4,3,22,21,"PAH",35,1,49,0)="INVALID LOCK - This patch adds a timeout to the one lock without one."
^DIC(9.4,3,22,21,"PAH",35,1,50,0)="Routine XUTMK was modified to resolve this problem.  (E3R #9278)"
^DIC(9.4,3,22,21,"PAH",35,1,51,0)="   "
^DIC(9.4,3,22,21,"PAH",35,1,52,0)="Updates the ID nodes of files 3.2 and 3.5 to use DDIOL.  Routine XUINPCH"
^DIC(9.4,3,22,21,"PAH",35,1,53,0)="   "
^DIC(9.4,3,22,21,"PAH",35,1,54,0)="Corrects a problem with the status code returned by STAT^%ZTLOAD.  It"
^DIC(9.4,3,22,21,"PAH",35,1,55,0)="formerly returned ""Inactive: Interrupted"" when it should have returned"
^DIC(9.4,3,22,21,"PAH",35,1,56,0)="""Active: Running"". Fixed with changes to %ZTLOAD5."
^DIC(9.4,3,22,21,"PAH",35,1,57,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,58,0)="Changes a call in %ZTMS3 from ZSYNC to PURGELST^%MSMOPS on MSM 4.3"
^DIC(9.4,3,22,21,"PAH",35,1,59,0)="systems.  In response to a request from MSM."
^DIC(9.4,3,22,21,"PAH",35,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,61,0)="Changes the way ZTMS1 waits under load."
^DIC(9.4,3,22,21,"PAH",35,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,63,0)="Changes %ZIS4 to clean up the IO(""ERROR"") and IO(""LASTERR"") variable."
^DIC(9.4,3,22,21,"PAH",35,1,64,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,65,0)="This patch made a change to the setting of IO(""ZIO""). ZIS4VXD, ZIS4MSM."
^DIC(9.4,3,22,21,"PAH",35,1,66,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,67,0)="Changes PRIORITY code to keep jobs from assuming system priority."
^DIC(9.4,3,22,21,"PAH",35,1,68,0)="(Capacity Management ZOSVMSM) "
^DIC(9.4,3,22,21,"PAH",35,1,69,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,70,0)="Fix $$STATUS^%ZISH  not looking at the correct variable."
^DIC(9.4,3,22,21,"PAH",35,1,71,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,72,0)="Improves the $STACK reporting on DSM systems."
^DIC(9.4,3,22,21,"PAH",35,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,74,0)="Adds the following new entry point for modifying resource devices (please"
^DIC(9.4,3,22,21,"PAH",35,1,75,0)="see the Supported References file for full details):"
^DIC(9.4,3,22,21,"PAH",35,1,76,0)="$$RES^XUDHSET(device_name,resource_name,slot_count,description,subtype)"
^DIC(9.4,3,22,21,"PAH",35,1,77,0)="       device_name   For the resource device."
^DIC(9.4,3,22,21,"PAH",35,1,78,0)="       resource_name (optional) The resource name if not the same as the device"
^DIC(9.4,3,22,21,"PAH",35,1,79,0)="                     name."
^DIC(9.4,3,22,21,"PAH",35,1,80,0)="       slot_count    The number of concurrent jobs that can use this device."
^DIC(9.4,3,22,21,"PAH",35,1,81,0)="                     defaults to 1."
^DIC(9.4,3,22,21,"PAH",35,1,82,0)="       description   The device description, defaults to 'Resource Device'."
^DIC(9.4,3,22,21,"PAH",35,1,83,0)="       subtype       The subtype to use, defaults to P-OTHER."
^DIC(9.4,3,22,21,"PAH",35,1,84,0)="       returns       If an error '-1^text'"
^DIC(9.4,3,22,21,"PAH",35,1,85,0)="                     The 'IEN^device name' like a DIC call."
^DIC(9.4,3,22,21,"PAH",35,1,86,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,88,0)="  "
^DIC(9.4,3,22,21,"PAH",35,1,89,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",35,1,90,0)="================"
^DIC(9.4,3,22,21,"PAH",35,1,91,0)=" "
