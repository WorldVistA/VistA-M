^DIC(9.4,85,22,1.5,"PAH",8,1,67,0)="       Print Transport Global"
^DIC(9.4,85,22,1.5,"PAH",8,1,68,0)="       Compare Transport Global to Current System"
^DIC(9.4,85,22,1.5,"PAH",8,1,69,0)="       Backup a Transport Global"
^DIC(9.4,85,22,1.5,"PAH",8,1,70,0)="       Install Package(s)"
^DIC(9.4,85,22,1.5,"PAH",8,1,71,0)=" Select INSTALL NAME:   VAQ*1.5*34   Loaded from Distribution <date/time>"
^DIC(9.4,85,22,1.5,"PAH",8,1,72,0)="                        =========="
^DIC(9.4,85,22,1.5,"PAH",8,1,73,0)=" Install Questions:"
^DIC(9.4,85,22,1.5,"PAH",8,1,74,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,85,22,1.5,"PAH",8,1,75,0)="                                                       =="
^DIC(9.4,85,22,1.5,"PAH",8,1,76,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,85,22,1.5,"PAH",8,1,77,0)="                                                                       =="
^DIC(9.4,85,22,1.5,"PAH",8,1,78,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,85,22,1.5,"PAH",8,1,79,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,85,22,1.5,"PAH",8,1,80,0)=" Enter a '^' to abort the install."
^DIC(9.4,85,22,1.5,"PAH",8,1,81,0)=" "
