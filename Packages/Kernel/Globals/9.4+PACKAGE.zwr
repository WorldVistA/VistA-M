^DIC(9.4,49,22,10,"PAH",286,1,3,0)="from being incurred when they are selected as secondary codes."
^DIC(9.4,49,22,10,"PAH",287,0)="388 SEQ #355^3080203.224623^1"
^DIC(9.4,49,22,10,"PAH",287,1,0)="^^1^1^3080203"
^DIC(9.4,49,22,10,"PAH",287,1,1,0)="PHARMACY NPI FIX"
