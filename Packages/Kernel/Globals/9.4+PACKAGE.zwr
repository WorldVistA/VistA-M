^DIC(9.4,33,22,1.4,"PAH",26,1,47,0)="    ------------     ---------------     --------------      ------------"
^DIC(9.4,33,22,1.4,"PAH",26,1,48,0)="      HLFNC              6494537             5785780           38,42,51"
