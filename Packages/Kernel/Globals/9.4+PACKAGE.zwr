^DIC(9.4,48,22,5.28,"PAH",680,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",680,1,5,0)="VSE-7980: BB - VistA: Support re-opening length of appointment field as "
^DIC(9.4,48,22,5.28,"PAH",680,1,6,0)="          needed"
^DIC(9.4,48,22,5.28,"PAH",680,1,7,0)="VSE-8000: BB - VistA: Keep previously canceled timeslots in place when "
^DIC(9.4,48,22,5.28,"PAH",680,1,8,0)="          overwriting new clinic availability"
^DIC(9.4,48,22,5.28,"PAH",680,1,9,0)="VSE-8310: JS - VistA: Write 3 RPCs into SDES2 namespace and return error "
^DIC(9.4,48,22,5.28,"PAH",680,1,10,0)="          message for inactive users for all User Profile RPCs."
^DIC(9.4,48,22,5.28,"PAH",680,1,11,0)="VSE-8406: BF - VistA: Create a new RPC that sends back the set of code "
^DIC(9.4,48,22,5.28,"PAH",680,1,12,0)="          stored in the HOSPITAL LOCATION (#44) file, SERVICE (#9) field"
^DIC(9.4,48,22,5.28,"PAH",680,1,13,0)="          and the description for those codes"
^DIC(9.4,48,22,5.28,"PAH",680,1,14,0)="VSE-8408: BF - VistA: Create a Post init routine that would compare the "
^DIC(9.4,48,22,5.28,"PAH",680,1,15,0)="          Gold Standard for HOSPITAL LOCATION (#44), SERVICE (#9) field"
^DIC(9.4,48,22,5.28,"PAH",680,1,16,0)="VSE-8409: BF - VistA: lock down File 44 to prevent third party changes to "
^DIC(9.4,48,22,5.28,"PAH",680,1,17,0)="          the file"
^DIC(9.4,48,22,5.28,"PAH",680,1,18,0)="VSE-8610: JDJ - VistA: PtCSch request creation failed: Modify SDES2 CREATE"
^DIC(9.4,48,22,5.28,"PAH",680,1,19,0)="          RECALL REQUEST to correct and error with APPOINTMENT TYPE"
^DIC(9.4,48,22,5.28,"PAH",680,1,20,0)=" "
^DIC(9.4,48,22,5.28,"PAH",680,1,21,0)=" "
