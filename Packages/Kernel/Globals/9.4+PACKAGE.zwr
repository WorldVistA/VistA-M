^DIC(9.4,13,22,9,"PAH",9,1,69,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,70,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,13,22,9,"PAH",9,1,71,0)="--------------------------------------------"
^DIC(9.4,13,22,9,"PAH",9,1,72,0)=" 1. Ticket I13413576FY17"
^DIC(9.4,13,22,9,"PAH",9,1,73,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",9,1,74,0)=" --------"
^DIC(9.4,13,22,9,"PAH",9,1,75,0)=" Word Processing cannot parse a string greater than 999 and the FM 22.2"
^DIC(9.4,13,22,9,"PAH",9,1,76,0)=" allows strings up to 4K characters."
^DIC(9.4,13,22,9,"PAH",9,1,77,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,78,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",9,1,79,0)=" ----------"
^DIC(9.4,13,22,9,"PAH",9,1,80,0)=" Modified DIWP and changed 999 to 9999"
^DIC(9.4,13,22,9,"PAH",9,1,81,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,82,0)=" 2. Ticket I15917948FY17"
^DIC(9.4,13,22,9,"PAH",9,1,83,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",9,1,84,0)=" --------"
^DIC(9.4,13,22,9,"PAH",9,1,85,0)=" Patch DI*22.2*7 fixed the NUMDATE function in the FUNCTION file #.5,"
^DIC(9.4,13,22,9,"PAH",9,1,86,0)="  but DINIT restored the old function."
^DIC(9.4,13,22,9,"PAH",9,1,87,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,88,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",9,1,89,0)=" ----------"
^DIC(9.4,13,22,9,"PAH",9,1,90,0)=" Modified DINIT4 and added fix to NUMDATE"
^DIC(9.4,13,22,9,"PAH",9,1,91,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,92,0)=" 3. Ticket I16009474FY17"
^DIC(9.4,13,22,9,"PAH",9,1,93,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",9,1,94,0)=" --------"
^DIC(9.4,13,22,9,"PAH",9,1,95,0)=" The variable DO is not killed after a call to DIE if a user asked for"
^DIC(9.4,13,22,9,"PAH",9,1,96,0)="  help in a multiple Date field."
^DIC(9.4,13,22,9,"PAH",9,1,97,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,98,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",9,1,99,0)=" ----------"
^DIC(9.4,13,22,9,"PAH",9,1,100,0)=" Modified DIEQ and added DO to kill statement at line Q"
^DIC(9.4,13,22,9,"PAH",9,1,101,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,102,0)=" 4. Ticket R13102022FY17"
^DIC(9.4,13,22,9,"PAH",9,1,103,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",9,1,104,0)=" --------"
^DIC(9.4,13,22,9,"PAH",9,1,105,0)=" Need API to repoint a deleted value in a record, similar to what happens"
^DIC(9.4,13,22,9,"PAH",9,1,106,0)="  when a pointer field value is deleted."
^DIC(9.4,13,22,9,"PAH",9,1,107,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,108,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",9,1,109,0)=" ----------"
^DIC(9.4,13,22,9,"PAH",9,1,110,0)=" Modified DITP and added tag EN(file, list) where file=file number,"
^DIC(9.4,13,22,9,"PAH",9,1,111,0)=" list= array containing list of entries to be repointed(Passed by Reference)"
^DIC(9.4,13,22,9,"PAH",9,1,112,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,113,0)=" 5. Ticket R14175506FY17"
^DIC(9.4,13,22,9,"PAH",9,1,114,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",9,1,115,0)=" --------"
^DIC(9.4,13,22,9,"PAH",9,1,116,0)=" New options that were for adding new data types and released as part of"
^DIC(9.4,13,22,9,"PAH",9,1,117,0)=" patch DI*22.2*2 had no parent menu.  These option were not meant for"
^DIC(9.4,13,22,9,"PAH",9,1,118,0)=" general distribution.  The options are: DI DATA TYPE OPTIONS,"
^DIC(9.4,13,22,9,"PAH",9,1,119,0)="  DI DATA TYPE FILE, DI DATA TYPE METHOD FILE, and"
^DIC(9.4,13,22,9,"PAH",9,1,120,0)="  DI DATA TYPE PROPERTY FILE."
^DIC(9.4,13,22,9,"PAH",9,1,121,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,122,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",9,1,123,0)=" ----------"
^DIC(9.4,13,22,9,"PAH",9,1,124,0)=" All four options will be deleted from the OPTION file and added to the"
^DIC(9.4,13,22,9,"PAH",9,1,125,0)=" hard coded options in the DII routine.  Modified DII1 and DIFMEDT1"
^DIC(9.4,13,22,9,"PAH",9,1,126,0)=" routines."
^DIC(9.4,13,22,9,"PAH",9,1,127,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,128,0)=" 6. No ticket"
^DIC(9.4,13,22,9,"PAH",9,1,129,0)=" Problem:"
^DIC(9.4,13,22,9,"PAH",9,1,130,0)=" --------"
^DIC(9.4,13,22,9,"PAH",9,1,131,0)=" Developer needs API to check what entries points to a particular record"
^DIC(9.4,13,22,9,"PAH",9,1,132,0)="  in a file."
^DIC(9.4,13,22,9,"PAH",9,1,133,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,134,0)=" Resolution:"
^DIC(9.4,13,22,9,"PAH",9,1,135,0)=" ----------"
^DIC(9.4,13,22,9,"PAH",9,1,136,0)=" CHKPT^DIUTL(file, ien, message)."
^DIC(9.4,13,22,9,"PAH",9,1,137,0)=" ;INPUT: DIFILE=file number, DA=ien of record, DIMSG=closed global root"
^DIC(9.4,13,22,9,"PAH",9,1,138,0)="  or local array"
^DIC(9.4,13,22,9,"PAH",9,1,139,0)=" ;OUTPUT: DIMSG(0)=line count, DISMG(#)=""Entry ien in FILE (file #)"
^DIC(9.4,13,22,9,"PAH",9,1,140,0)="  refers to record DA"" "
^DIC(9.4,13,22,9,"PAH",9,1,141,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,142,0)=" Blood Bank Clearance:"
^DIC(9.4,13,22,9,"PAH",9,1,143,0)=" ---------------------"
^DIC(9.4,13,22,9,"PAH",9,1,144,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch DI*22.2*10 contains"
^DIC(9.4,13,22,9,"PAH",9,1,145,0)=" changes to a package referenced in ProPath standard titled: BBM Team Review"
^DIC(9.4,13,22,9,"PAH",9,1,146,0)=" of VistA Patches. This patch does not alter or modify any VistA Blood Bank"
^DIC(9.4,13,22,9,"PAH",9,1,147,0)=" software design safeguards or safety critical elements functions."
^DIC(9.4,13,22,9,"PAH",9,1,148,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,149,0)=" RISK ANALYSIS: Changes made by patch DI*22.2*10 have no effect on Blood Bank"
^DIC(9.4,13,22,9,"PAH",9,1,150,0)=" software functionality, therefore RISK is none."
^DIC(9.4,13,22,9,"PAH",9,1,151,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,152,0)=""
^DIC(9.4,13,22,9,"PAH",9,1,153,0)="Test Sites:"
^DIC(9.4,13,22,9,"PAH",9,1,154,0)="-----------"
^DIC(9.4,13,22,9,"PAH",9,1,155,0)=" Charleston"
^DIC(9.4,13,22,9,"PAH",9,1,156,0)=" West Palm Beach"
^DIC(9.4,13,22,9,"PAH",9,1,157,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,158,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,159,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,13,22,9,"PAH",9,1,160,0)="-------------------------------------------------- "
^DIC(9.4,13,22,9,"PAH",9,1,161,0)="Documentation describing the new api, EN^DITP, can be found in the"
^DIC(9.4,13,22,9,"PAH",9,1,162,0)="FM 22.2 Developer's Guide"
^DIC(9.4,13,22,9,"PAH",9,1,163,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,164,0)="Current documentation is on the VA Software Documentation Library "
^DIC(9.4,13,22,9,"PAH",9,1,165,0)="at: http://www.domain.ext/vdl/ "
^DIC(9.4,13,22,9,"PAH",9,1,166,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,167,0)="Title                                File Name          SFTP Mode"
^DIC(9.4,13,22,9,"PAH",9,1,168,0)="-----------------------------------------------------------------"
^DIC(9.4,13,22,9,"PAH",9,1,169,0)="FM 22.2 Developer's Guide              fm22_2dg.PDF    Binary"
^DIC(9.4,13,22,9,"PAH",9,1,170,0)="FM 22.2 User Manual                    fm22_2um1.PDF   Binary"
^DIC(9.4,13,22,9,"PAH",9,1,171,0)="FM 22.2 Advanced User Manual           fm22_2um2.PDF   Binary"
^DIC(9.4,13,22,9,"PAH",9,1,172,0)="FM 22.2 Technical Manual               fm22_2tm.PDF    Binary"
^DIC(9.4,13,22,9,"PAH",9,1,173,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,174,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,175,0)="Backout and Rollback Procedure:"
^DIC(9.4,13,22,9,"PAH",9,1,176,0)="-------------------------------"
^DIC(9.4,13,22,9,"PAH",9,1,177,0)="This patch only consists of routines. During the VistA Installation"
^DIC(9.4,13,22,9,"PAH",9,1,178,0)="Procedure of the KIDS build, the installer should back up the modified routines by the use of the 'Backup a Transport Global' action"
^DIC(9.4,13,22,9,"PAH",9,1,179,0)="(step 3b in the Installations Instructions below)."
^DIC(9.4,13,22,9,"PAH",9,1,180,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,181,0)="If rollback/backout is required, the installer can restore the routines"
^DIC(9.4,13,22,9,"PAH",9,1,182,0)="using the MailMan message that were saved prior to installing the"
^DIC(9.4,13,22,9,"PAH",9,1,183,0)="patch."
^DIC(9.4,13,22,9,"PAH",9,1,184,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,185,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,186,0)="Patch Installation:"
^DIC(9.4,13,22,9,"PAH",9,1,187,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,188,0)="  "
^DIC(9.4,13,22,9,"PAH",9,1,189,0)="Pre-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",9,1,190,0)="------------------------------"
^DIC(9.4,13,22,9,"PAH",9,1,191,0)="This patch can be queued for installation.  TaskMan does not have to be "
^DIC(9.4,13,22,9,"PAH",9,1,192,0)="stopped, HL7 filers do not need to be stopped, and users may be on the "
^DIC(9.4,13,22,9,"PAH",9,1,193,0)="system.  The patch should be installed during non-peak hours to minimize"
^DIC(9.4,13,22,9,"PAH",9,1,194,0)="potential for disruption to users.  This patch should take less than 1 "
^DIC(9.4,13,22,9,"PAH",9,1,195,0)="minute to install."
^DIC(9.4,13,22,9,"PAH",9,1,196,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,197,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,198,0)="Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",9,1,199,0)="--------------------------"
^DIC(9.4,13,22,9,"PAH",9,1,200,0)="1.  Choose the MailMan message containing this patch."
^DIC(9.4,13,22,9,"PAH",9,1,201,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,202,0)="2.  Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,13,22,9,"PAH",9,1,203,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,204,0)="3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,13,22,9,"PAH",9,1,205,0)="    the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,13,22,9,"PAH",9,1,206,0)="    following options. When prompted for the INSTALL NAME enter DI*22.2*10."
^DIC(9.4,13,22,9,"PAH",9,1,207,0)=" a.     Print Transport Global - This option lets you print the contents"
^DIC(9.4,13,22,9,"PAH",9,1,208,0)="        of a Transport Global that is currently loaded in the ^XTMP"
^DIC(9.4,13,22,9,"PAH",9,1,209,0)="        global."
^DIC(9.4,13,22,9,"PAH",9,1,210,0)=" b.     Backup a Transport Global - This option will create a backup"
^DIC(9.4,13,22,9,"PAH",9,1,211,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,13,22,9,"PAH",9,1,212,0)="        backup any other changes such as functions."
^DIC(9.4,13,22,9,"PAH",9,1,213,0)=" c.     Compare Transport Global to Current System - This option will"
^DIC(9.4,13,22,9,"PAH",9,1,214,0)="        allow you to view all changes that will be made when this patch"
^DIC(9.4,13,22,9,"PAH",9,1,215,0)="        is installed.  It compares all components of this patch"
^DIC(9.4,13,22,9,"PAH",9,1,216,0)="        (routines, DDs, templates, etc.)."
^DIC(9.4,13,22,9,"PAH",9,1,217,0)=" d.     Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,13,22,9,"PAH",9,1,218,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,13,22,9,"PAH",9,1,219,0)="        transport global."
^DIC(9.4,13,22,9,"PAH",9,1,220,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,221,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,13,22,9,"PAH",9,1,222,0)="    When prompted for the INSTALL NAME, enter DI*22.2*10."
^DIC(9.4,13,22,9,"PAH",9,1,223,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,224,0)="5.  If prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,13,22,9,"PAH",9,1,225,0)="    Install? NO//' respond NO."
^DIC(9.4,13,22,9,"PAH",9,1,226,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,227,0)="7.  When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,13,22,9,"PAH",9,1,228,0)="    NO//"" respond NO."
^DIC(9.4,13,22,9,"PAH",9,1,229,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,230,0)="8.  If prompted ""Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,13,22,9,"PAH",9,1,231,0)="    and Protocols? NO//"" respond NO. "
^DIC(9.4,13,22,9,"PAH",9,1,232,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,233,0)="9.  If prompted ""Delay Install (Minutes):  (0 - 60): 0//"" respond 0."
^DIC(9.4,13,22,9,"PAH",9,1,234,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,235,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,236,0)="Post-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",9,1,237,0)="-------------------------------"
^DIC(9.4,13,22,9,"PAH",9,1,238,0)="none"
^DIC(9.4,13,22,9,"PAH",9,1,239,0)=" "
^DIC(9.4,13,22,9,"PAH",9,1,240,0)=" "
^DIC(9.4,13,22,9,"PAH",10,0)="9^3190301.140536^54"
^DIC(9.4,13,22,9,"PAH",10,1,0)="^^358^358^3190301"
^DIC(9.4,13,22,9,"PAH",10,1,1,0)="This patch provides an option to map a VistA resource to a "
^DIC(9.4,13,22,9,"PAH",10,1,2,0)="representation of a Summary Document Architecture (SDA) data type."
^DIC(9.4,13,22,9,"PAH",10,1,3,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,4,0)="The patch includes a new ENTITY (#1.5) file.  The ENTITY file defines "
^DIC(9.4,13,22,9,"PAH",10,1,5,0)="the VistA resource being mapped to an SDA type."
^DIC(9.4,13,22,9,"PAH",10,1,6,0)=" "
