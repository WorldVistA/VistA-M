^DIC(9.4,14,22,5.9,"PAH",90,1,70,0)="          hours and less than 5 minutes during peak hours."
^DIC(9.4,14,22,5.9,"PAH",90,1,71,0)="       7. Installation of this patch requires no additional memory"
