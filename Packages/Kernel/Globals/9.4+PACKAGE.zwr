^DIC(9.4,59,22,5,"PAH",113,1,5,0)="   50.621        PMI-ENGLISH              "
^DIC(9.4,59,22,5,"PAH",113,1,6,0)="   50.622        PMI-SPANISH              "
^DIC(9.4,59,22,5,"PAH",113,1,7,0)="   50.623        PMI MAP-ENGLISH          "
^DIC(9.4,59,22,5,"PAH",113,1,8,0)="   50.624        PMI MAP-SPANISH          "
