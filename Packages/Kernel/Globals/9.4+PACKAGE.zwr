^DIC(9.4,52,22,29,"PAH",110,0)="136 SEQ #112^3091204.112551^17"
^DIC(9.4,52,22,29,"PAH",110,1,0)="^^8^8^3091204"
^DIC(9.4,52,22,29,"PAH",110,1,1,0)="The new Patch displays CPT (Current Procedural Terminology) code "
^DIC(9.4,52,22,29,"PAH",110,1,2,0)="of field #.01 and its Short Name (Versioned) of Multiple Field #61 (it "
^DIC(9.4,52,22,29,"PAH",110,1,3,0)="depends on date) of File #81 in General Inventory/Distribution related"
^DIC(9.4,52,22,29,"PAH",110,1,4,0)="options and reports."
^DIC(9.4,52,22,29,"PAH",110,1,5,0)=" "
^DIC(9.4,52,22,29,"PAH",110,1,6,0)="Before the Patch the IFCAP displays the IEN (Internal Entry Number) of"
^DIC(9.4,52,22,29,"PAH",110,1,7,0)="the CPT code and its Short Name of Field #2 (it is date independent) in"
^DIC(9.4,52,22,29,"PAH",110,1,8,0)="File #81. The Filed #2 will be phased out soon."
