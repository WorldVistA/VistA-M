^DIC(9.4,85,22,1.5,"PAH",4,1,81,0)="     6.  DSM/AXP Sites - Answer NO to the question ""Want to MOVE"
^DIC(9.4,85,22,1.5,"PAH",4,1,82,0)="          routines to other CPUs?"""
^DIC(9.4,85,22,1.5,"PAH",4,1,83,0)=" "
