^DIC(9.4,11,22,5.03,"PAH",25,1,384,0)="Select Installation Option: "
^DIC(9.4,11,22,5.03,"PAH",26,0)="62 SEQ #46^3020815^1"
^DIC(9.4,11,22,5.03,"PAH",26,1,0)="^^196^196^3020815"
^DIC(9.4,11,22,5.03,"PAH",26,1,1,0)="VISTA Laboratory Package patch LA*5.2*62 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",26,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",26,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,4,0)="Patch LA*5.2*62 implements support for patch HL*1.6*91 NAMESPACE field"
^DIC(9.4,11,22,5.03,"PAH",26,1,5,0)="(#16) in HL7 MESSAGE TEXT file (#772). The Laboratory HL7 clients"
^DIC(9.4,11,22,5.03,"PAH",26,1,6,0)="Laboratory Electronic Data Interchange (LEDI) and CareVue will pass the"
^DIC(9.4,11,22,5.03,"PAH",26,1,7,0)="namespace ""LA"" in the HL7 APIs that create messages or acknowledgements."
^DIC(9.4,11,22,5.03,"PAH",26,1,8,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,9,0)="During patch development, a software review identified the variable"
^DIC(9.4,11,22,5.03,"PAH",26,1,10,0)="HLRESLT, returned by various HL package APIs, misspelled in routines"
^DIC(9.4,11,22,5.03,"PAH",26,1,11,0)="LA7DVC and LA7DVM. The patch corrects the spelling of this variable."
^DIC(9.4,11,22,5.03,"PAH",26,1,12,0)="Additionally, these two routines referenced the variable VAIN(4) before"
^DIC(9.4,11,22,5.03,"PAH",26,1,13,0)="the variable was initialized. This patch calls supported API INP^VADPT"
^DIC(9.4,11,22,5.03,"PAH",26,1,14,0)="to initialize VAIN(4). "
^DIC(9.4,11,22,5.03,"PAH",26,1,15,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,16,0)=""
^DIC(9.4,11,22,5.03,"PAH",26,1,17,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",26,1,18,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",26,1,19,0)=" NONE"
^DIC(9.4,11,22,5.03,"PAH",26,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,21,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,22,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",26,1,23,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",26,1,24,0)=" Durham VAMC"
^DIC(9.4,11,22,5.03,"PAH",26,1,25,0)=" Milwaukee VAMC"
^DIC(9.4,11,22,5.03,"PAH",26,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,27,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,28,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",26,1,29,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",26,1,30,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",26,1,31,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",26,1,32,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",26,1,33,0)=" "
^DIC(9.4,11,22,5.03,"PAH",26,1,34,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",26,1,35,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",26,1,36,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",26,1,37,0)="   LA62             N/A            4560523        **62** (Deleted by KIDS)"
