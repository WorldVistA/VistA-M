^DIC(9.4,150,22,2,"PAH",9,1,238,0)="ROUTINE SUMMARY:"
^DIC(9.4,150,22,2,"PAH",9,1,239,0)="================"
^DIC(9.4,150,22,2,"PAH",9,1,240,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,241,0)="The following is a list of the routines included in this patch."
^DIC(9.4,150,22,2,"PAH",9,1,242,0)="The second line of each of these routines now looks like:"
^DIC(9.4,150,22,2,"PAH",9,1,243,0)=" "
^DIC(9.4,150,22,2,"PAH",9,1,244,0)="<tab>;;v 3.0;QUASAR AUDIOMETRIC EXAM MODULE;**[patch list]**;11/01/02"
