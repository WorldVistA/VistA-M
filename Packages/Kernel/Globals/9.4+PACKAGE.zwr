^DIC(9.4,135,22,14,"PAH",34,1,2,0)="under GMPL*2.0*45."
^DIC(9.4,135,22,14,"PAH",35,0)="40 SEQ #43^3160819.161837^54"
^DIC(9.4,135,22,14,"PAH",35,1,0)="^^2^2^3160819"
^DIC(9.4,135,22,14,"PAH",35,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,135,22,14,"PAH",35,1,2,0)="under GMPL*2.0*40."
^DIC(9.4,135,22,14,"PAH",36,0)="50 SEQ #44^3171102.11272^54"
^DIC(9.4,135,22,14,"PAH",36,1,0)="^^3^3^3171102"
^DIC(9.4,135,22,14,"PAH",36,1,1,0)="This patch will address a problem with an improperly altered SNOMED "
^DIC(9.4,135,22,14,"PAH",36,1,2,0)="narrative causing the routine GMPLSAVE to error out and fail to save a"
^DIC(9.4,135,22,14,"PAH",36,1,3,0)="new diagnosis to the Problem List from PCE and the PCE is lost."
^DIC(9.4,135,22,14,"PAH",37,0)="49^3171227.134002^54"
^DIC(9.4,135,22,14,"PAH",37,1,0)="^^2^2^3171227"
^DIC(9.4,135,22,14,"PAH",37,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,135,22,14,"PAH",37,1,2,0)="under GMPL*2.0*49."
^DIC(9.4,135,22,14,"PAH",38,0)="52 SEQ #46^3180803.154927^54"
^DIC(9.4,135,22,14,"PAH",39,0)="54 SEQ #47^3191113.142242^65"
^DIC(9.4,135,22,14,"PAH",39,1,0)="^^1^1^3191113"
^DIC(9.4,135,22,14,"PAH",39,1,1,0)="See patch description on Forum for installation instructions."
^DIC(9.4,135,22,14,"PAH",40,0)="55 SEQ #48^3200601.163003^70"
^DIC(9.4,135,22,14,"PAH",41,0)="56 SEQ #49^3201005.100327^17"
^DIC(9.4,135,22,14,"PAH",41,1,0)="^^1^1^3201005"
^DIC(9.4,135,22,14,"PAH",41,1,1,0)="CORRECT URL IN OR PROBLEM NTRT BULLETIN"
^DIC(9.4,135,22,14,"PAH",42,0)="53b^3210504"
^DIC(9.4,135,22,14,"PAH",42,1,0)="^^5^5^3210504"
^DIC(9.4,135,22,14,"PAH",42,1,1,0)="Backup of PCE STANDARDIZATION 1.0, PX*1.0*211, PXRM*2.0*42, GMT"
^DIC(9.4,135,22,14,"PAH",42,1,2,0)=" "
^DIC(9.4,135,22,14,"PAH",42,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,135,22,14,"PAH",42,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,135,22,14,"PAH",42,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,135,22,14,"PAH",43,0)="53^3210504.155731^17"
^DIC(9.4,135,22,14,"PAH",43,1,0)="^^13^13^3210504"
^DIC(9.4,135,22,14,"PAH",43,1,1,0)="This patch supports PCE standardization."
^DIC(9.4,135,22,14,"PAH",43,1,2,0)=""
^DIC(9.4,135,22,14,"PAH",43,1,3,0)="To take full advantage of the PCE standardization work, changes to VistA"
^DIC(9.4,135,22,14,"PAH",43,1,4,0)="applications that use PCE data are required. These applications include"
^DIC(9.4,135,22,14,"PAH",43,1,5,0)="Clinical Reminders, Health Summary, Problem List, and Order Entry/Results"
^DIC(9.4,135,22,14,"PAH",43,1,6,0)="Reporting. To make it easier for sites, the builds for PCE (PX*1.0*211),"
^DIC(9.4,135,22,14,"PAH",43,1,7,0)="Clinical Reminders (PXRM*2.0*42), Health Summary (GMTS*2.7*122), Problem List"
^DIC(9.4,135,22,14,"PAH",43,1,8,0)="(GMPL*2.0*53), and Order Entry/Results Reporting (OR*3.0*501) are being"
^DIC(9.4,135,22,14,"PAH",43,1,9,0)="distributed in a multi-package build named PCE STANDARDIZATION 1.0."
^DIC(9.4,135,22,14,"PAH",43,1,10,0)=" "
^DIC(9.4,135,22,14,"PAH",43,1,11,0)="For detailed information and installation instructions, please see the PCE"
^DIC(9.4,135,22,14,"PAH",43,1,12,0)="Standardization 1.0 Installation Guide."
^DIC(9.4,135,22,14,"PAH",43,1,13,0)=""
^DIC(9.4,135,22,14,"PAH",44,0)="57 SEQ #51^3220201.141143^17"
^DIC(9.4,135,22,14,"PAH",44,1,0)="^^6^6^3220201"
^DIC(9.4,135,22,14,"PAH",44,1,1,0)="The patch addresses one (1) request: "
^DIC(9.4,135,22,14,"PAH",44,1,2,0)=" "
^DIC(9.4,135,22,14,"PAH",44,1,3,0)="1. Update the text in the MESSAGE and DESCRIPTION fields for two (2) "
^DIC(9.4,135,22,14,"PAH",44,1,4,0)="   BULLETIN FILE (#3.6) entries: OR PROBLEM NTRT BULLETIN and GMPL"
^DIC(9.4,135,22,14,"PAH",44,1,5,0)="   PROBLEM NTRT BULLETIN. Also, enable the GMPL PROBLEM NTRT BULLETIN to"
^DIC(9.4,135,22,14,"PAH",44,1,6,0)="   be send to FORUM to the Problem List NTRT MAIL GROUP."
^DIC(9.4,135,22,14,"PAH",45,0)="58^3260508.090033^90"
^DIC(9.4,135,22,14,"PAH",45,1,0)="^^2^2^3260508"
^DIC(9.4,135,22,14,"PAH",45,1,1,0)="This patch is part of the CPRS v33CON combined build. Please see the "
^DIC(9.4,135,22,14,"PAH",45,1,2,0)="National Patch Module entry for more information."
