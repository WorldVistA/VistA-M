^DIC(9.4,14,22,5.9,"PAH",42,1,120,0)=" LR5XCNVD                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,121,0)=" LR5XCNVP                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,122,0)=" LR5XCNVU                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,123,0)=" LR5XCNVX                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,124,0)=" LR5XOK                         OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,125,0)=" LR5XOK3                        OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,126,0)=" LR5XOK31                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,127,0)=" LR5XOK5                        OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,128,0)=" LR5XOK51                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,129,0)=" LR5XOK8                        OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,130,0)=" LR5XOK81                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,131,0)=" LR5XOK9                        OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,132,0)=" LR5XOK91                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,133,0)=" LR5XOKA                        OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,134,0)=" LR5XOKA1                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,135,0)=" LR5XOKU                        OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,136,0)=" LR5XTIM2                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,137,0)=" LR5XTIME                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,138,0)=" LR7OSBR1   T                   dd/mm/yyyy"
^DIC(9.4,14,22,5.9,"PAH",42,1,139,0)="            L+1                 formatting for the extra 2 century"
^DIC(9.4,14,22,5.9,"PAH",42,1,140,0)="                                characters."
^DIC(9.4,14,22,5.9,"PAH",42,1,141,0)="            L+2                 formatting for the extra 2 century"
^DIC(9.4,14,22,5.9,"PAH",42,1,142,0)="                                characters."
^DIC(9.4,14,22,5.9,"PAH",42,1,143,0)="            R+1                 formatting for the extra 2 century"
^DIC(9.4,14,22,5.9,"PAH",42,1,144,0)="                                characters."
