^DIC(9.4,47,22,5.9,"PAH",538,0)="715 SEQ #625^3060711^1"
^DIC(9.4,47,22,5.9,"PAH",539,0)="705 SEQ #624^3060711^1"
^DIC(9.4,47,22,5.9,"PAH",540,0)="694 SEQ #626^3060807^1"
^DIC(9.4,47,22,5.9,"PAH",541,0)="701 SEQ #627^3060824^1"
^DIC(9.4,47,22,5.9,"PAH",541,1,0)="^^3^3^3060824"
^DIC(9.4,47,22,5.9,"PAH",541,1,1,0)="  This patch deals with non-VA PTF census problems, the inability to"
^DIC(9.4,47,22,5.9,"PAH",541,1,2,0)="select certain ICD9 codes on the 501 screen of PTF Load/Edit, and a "
^DIC(9.4,47,22,5.9,"PAH",541,1,3,0)="system error when transferring patients. "
^DIC(9.4,47,22,5.9,"PAH",542,0)="699 SEQ #628^3060824^1"
^DIC(9.4,47,22,5.9,"PAH",542,1,0)="^^2^2^3060824"
^DIC(9.4,47,22,5.9,"PAH",542,1,1,0)="This patch allows the patient security check to account for proxy users,"
^DIC(9.4,47,22,5.9,"PAH",542,1,2,0)="and protects a system variable before displaying patient record flags."
^DIC(9.4,47,22,5.9,"PAH",543,0)="718 SEQ #629^3060824^1"
^DIC(9.4,47,22,5.9,"PAH",543,1,0)="^^2^2^3060824"
^DIC(9.4,47,22,5.9,"PAH",543,1,1,0)="Please refer to patch DG*5.3*718 in the National Patch Module for a"
