^DIC(9.4,164,22,1,"PAH",140,1,44,0)="-----------                      ----      ----------------------"
^DIC(9.4,164,22,1,"PAH",140,1,45,0)="PSS ADDITIVE/SOLUTIONS           Menu      Send to Site"
^DIC(9.4,164,22,1,"PAH",140,1,46,0)="PSS ADDITIVE/SOLUTION REPORTS    Menu      Delete at Site"
^DIC(9.4,164,22,1,"PAH",140,1,47,0)="PSS DRG INTER MANAGEMENT         Menu      Delete at Site"
^DIC(9.4,164,22,1,"PAH",140,1,48,0)="PSS ENHANCED ORDER CHECKS        Menu      Delete at Site "
^DIC(9.4,164,22,1,"PAH",140,1,49,0)="PSS INTERACTION LOCAL ADD        Run       Delete at Site"
^DIC(9.4,164,22,1,"PAH",140,1,50,0)="PSS INTERACTION SEVERITY         Action    Delete at Site"
^DIC(9.4,164,22,1,"PAH",140,1,51,0)="PSS INTERFACE SCHEDULER          Run       Send to Site"
^DIC(9.4,164,22,1,"PAH",140,1,52,0)="PSS LOCAL DOSAGES EDIT           Run       Delete at Site"
^DIC(9.4,164,22,1,"PAH",140,1,53,0)="PSS LOCAL DOSAGES EDIT ALL       Run       Delete at Site"
