^DIC(9.4,164,22,1,"PAH",140,1,57,0)="PSS ORDER CHECK CHANGES          Run       Send to Site"
^DIC(9.4,164,22,1,"PAH",140,1,58,0)="PSS ORDER CHECK MANAGEMENT       Menu      Send to site"
