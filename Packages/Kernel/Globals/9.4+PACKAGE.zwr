^DIC(9.4,115,22,2,"PAH",41,0)="46 SEQ #41^3040521^1"
^DIC(9.4,115,22,2,"PAH",41,1,0)="^^1^1^3040521"
^DIC(9.4,115,22,2,"PAH",41,1,1,0)="See patch description for this patch for details."
^DIC(9.4,115,22,2,"PAH",42,0)="50 SEQ #42^3040802^1"
^DIC(9.4,115,22,2,"PAH",42,1,0)="^^6^6^3040802"
^DIC(9.4,115,22,2,"PAH",42,1,1,0)="NOTE: This patch addresses a Patient Safety Issue"
^DIC(9.4,115,22,2,"PAH",42,1,2,0)=" "
^DIC(9.4,115,22,2,"PAH",42,1,3,0)="This patch addresses the problem where an edit to an entry in the RAD/NUC"
^DIC(9.4,115,22,2,"PAH",42,1,4,0)="MED PROCEDURE MESSAGE file (# 71.4) with the menu Procedure Message"
^DIC(9.4,115,22,2,"PAH",42,1,5,0)="Entry/Edit [RA PROCMSGEDIT] does not update the content of the"
^DIC(9.4,115,22,2,"PAH",42,1,6,0)="related entries of the ORDERABLE ITEMS file (# 101.43)."
^DIC(9.4,115,22,2,"PAH",43,0)="48 SEQ #43^3041015^1"
^DIC(9.4,115,22,2,"PAH",43,1,0)="^^1^1^3041015"
^DIC(9.4,115,22,2,"PAH",43,1,1,0)="Please see Patch Description for details."
^DIC(9.4,115,22,2,"PAH",44,0)="33^3041228^1"
^DIC(9.4,115,22,2,"PAH",44,1,0)="^^1^1^3041228"
^DIC(9.4,115,22,2,"PAH",44,1,1,0)="This patch will be sent in a multi-build patch from PX*1.5*12."
^DIC(9.4,115,22,2,"PAH",45,0)="55 SEQ #46^3041228^1"
^DIC(9.4,115,22,2,"PAH",45,1,0)="^^1^1^3041228"
^DIC(9.4,115,22,2,"PAH",45,1,1,0)="Fix to add Addendums via VR Sysytems."
^DIC(9.4,115,22,2,"PAH",46,0)="51 SEQ #47^3050118^1"
^DIC(9.4,115,22,2,"PAH",47,0)="54 SEQ #48^3050401^1"
^DIC(9.4,115,22,2,"PAH",47,1,0)="^^7^7^3050401"
^DIC(9.4,115,22,2,"PAH",47,1,1,0)="This patch address two problems:"
^DIC(9.4,115,22,2,"PAH",47,1,2,0)="1)      A RAD/NUC MED PROCEDURE MESSAGE file (#71.4) entry may be edited "
^DIC(9.4,115,22,2,"PAH",47,1,3,0)="by more than one user at a time with the option Procedure Message "
^DIC(9.4,115,22,2,"PAH",47,1,4,0)="Entry/Edit [RA PROCMSGEDIT]."
^DIC(9.4,115,22,2,"PAH",47,1,5,0)="2)      The menu option Resend Radiology HL7 Message [RA HL7 MESSAGE "
^DIC(9.4,115,22,2,"PAH",47,1,6,0)="RESEND] communication is missing the 'exam registered' HL7 messages in "
^DIC(9.4,115,22,2,"PAH",47,1,7,0)="subsequent cases after the first case."
^DIC(9.4,115,22,2,"PAH",48,0)="45^3050525^1"
^DIC(9.4,115,22,2,"PAH",48,1,0)="^^2^2^3050525"
^DIC(9.4,115,22,2,"PAH",48,1,1,0)="Please refer to the patch description on FORUM for additional information "
^DIC(9.4,115,22,2,"PAH",48,1,2,0)="regarding patch RA*5.0*45."
^DIC(9.4,115,22,2,"PAH",49,0)="60 SEQ #50^3050525^1"
^DIC(9.4,115,22,2,"PAH",49,1,0)="^^2^2^3050525"
^DIC(9.4,115,22,2,"PAH",49,1,1,0)="This patch corrects an HL7 message generation error caused by patch "
^DIC(9.4,115,22,2,"PAH",49,1,2,0)="RA*5.0*54."
^DIC(9.4,115,22,2,"PAH",50,0)="59 SEQ #51^3050611^1"
^DIC(9.4,115,22,2,"PAH",50,1,0)="^^1^1^3050611"
^DIC(9.4,115,22,2,"PAH",50,1,1,0)="PERFORMANCE MEASURE CALC CORRECTION"
^DIC(9.4,115,22,2,"PAH",51,0)="41^3050905^1"
^DIC(9.4,115,22,2,"PAH",51,1,0)="^^1^1^3050905"
^DIC(9.4,115,22,2,"PAH",51,1,1,0)="Billing Awareness - Radiology"
