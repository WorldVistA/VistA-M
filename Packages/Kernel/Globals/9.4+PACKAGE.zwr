^DIC(9.4,3,22,21,"PAH",45,1,52,0)="XQDATE        1632193   1671306    **71**"
^DIC(9.4,3,22,21,"PAH",45,1,53,0)="XTER2        13615695  10464968    **71**"
^DIC(9.4,3,22,21,"PAH",45,1,54,0)="XUWORKDY      1331031    902683    **65,71**"
