^DIC(9.4,14,22,5.9,"PAH",148,1,53,0)="================"
^DIC(9.4,14,22,5.9,"PAH",148,1,54,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",148,1,55,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,56,0)="Routine Summary"
^DIC(9.4,14,22,5.9,"PAH",148,1,57,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",148,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,59,0)="The following is a list of routines included in this patch.  The"
^DIC(9.4,14,22,5.9,"PAH",148,1,60,0)="second line of each if these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",148,1,61,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,62,0)="     <tab>;;5.2;LAB SERVICE;**[patch list]**;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",148,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,64,0)="               CHECK^XTSUMBLD results"
^DIC(9.4,14,22,5.9,"PAH",148,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",148,1,66,0)="  Routine Name    Before Patch   After Patch   Patch List"
