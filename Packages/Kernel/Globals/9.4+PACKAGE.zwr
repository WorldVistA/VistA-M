^DIC(9.4,49,22,10,"PAH",283,1,1,0)="E-CLAIMS PLUS ITERATION 3, PART 1"
^DIC(9.4,49,22,10,"PAH",284,0)="382 SEQ #352^3080203.215323^1"
^DIC(9.4,49,22,10,"PAH",284,1,0)="^^1^1^3080203"
^DIC(9.4,49,22,10,"PAH",284,1,1,0)="Reasonable Charges v2.11.  Charges are effective 10/01/07."
^DIC(9.4,49,22,10,"PAH",285,0)="379^3080203.220337^1"
^DIC(9.4,49,22,10,"PAH",286,0)="387 SEQ #354^3080203.223319^1"
^DIC(9.4,49,22,10,"PAH",286,1,0)="^^3^3^3080203"
^DIC(9.4,49,22,10,"PAH",286,1,1,0)=" "
