^DIC(9.4,11,22,5.03,"PAH",36,1,263,0)=" Bacteriology or mycobacterium (TB) organism's susceptibilities -"
^DIC(9.4,11,22,5.03,"PAH",36,1,264,0)="  is based on local site's mapping of NATIONAL VA LAB CODE field (#64)"
^DIC(9.4,11,22,5.03,"PAH",36,1,265,0)="  in ANTIMICROBIAL SUSCEPTIBILITY file (#62.06) and the related default"
^DIC(9.4,11,22,5.03,"PAH",36,1,266,0)="  LOINC code associated with this VA NLT code. Use option Map/Unmap "
^DIC(9.4,11,22,5.03,"PAH",36,1,267,0)="  Antimicrobial Default LOINC Code [LR LOINC MAP ANTIMICROBIAL] to"
^DIC(9.4,11,22,5.03,"PAH",36,1,268,0)="  configure the default LOINC code for each antibiotic."
^DIC(9.4,11,22,5.03,"PAH",36,1,269,0)=" "
^DIC(9.4,11,22,5.03,"PAH",36,1,270,0)="6. Surgical Pathology results. The current Laboratory package does not"
^DIC(9.4,11,22,5.03,"PAH",36,1,271,0)="support LOINC encoding of surgical pathology results."
^DIC(9.4,11,22,5.03,"PAH",36,1,272,0)="LOINC codes valid as of version 2.14."
