^DIC(9.4,53,22,20,"PAH",55,1,1,0)="PATCH 100 - TEST VERSION 1"
^DIC(9.4,53,22,20,"PAH",56,0)="112 SEQ #86^2980423^1"
^DIC(9.4,53,22,20,"PAH",56,1,0)="^^6^6^2980423"
^DIC(9.4,53,22,20,"PAH",56,1,1,0)="This corrects the <UNDEF> error in V+4^PRCABP2"
^DIC(9.4,53,22,20,"PAH",56,1,2,0)="that occurs when a user tries to queue a 1080 to print."
^DIC(9.4,53,22,20,"PAH",56,1,3,0)="It also corrects <UNDEF> error in V+4^PRCABP1 when a"
^DIC(9.4,53,22,20,"PAH",56,1,4,0)="user tries to queue a 1081 to print."
^DIC(9.4,53,22,20,"PAH",56,1,5,0)="The following options will error:"
^DIC(9.4,53,22,20,"PAH",56,1,6,0)="New Bill (Enter), Display Pending Bill, and Approve/Print Pending Bill."
^DIC(9.4,53,22,20,"PAH",57,0)="110 SEQ #87^2980423^1"
^DIC(9.4,53,22,20,"PAH",57,1,0)="^^3^3^2980423"
^DIC(9.4,53,22,20,"PAH",57,1,1,0)="This patch changes the Patient Transaction History to show 'Debtor"
^DIC(9.4,53,22,20,"PAH",57,1,2,0)="Comments' even if there had been no other activity on the account. (NOIS"
^DIC(9.4,53,22,20,"PAH",57,1,3,0)="NJH-0198-20836)"
^DIC(9.4,53,22,20,"PAH",58,0)="63 SEQ #88^2980527^1"
^DIC(9.4,53,22,20,"PAH",58,1,0)="^^2^2^2980527"
^DIC(9.4,53,22,20,"PAH",58,1,1,0)="Regional Counsel Interface"
^DIC(9.4,53,22,20,"PAH",58,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",59,0)="101 SEQ #89^2980616^1"
^DIC(9.4,53,22,20,"PAH",59,1,0)="^^2^2^2980616"
^DIC(9.4,53,22,20,"PAH",59,1,1,0)="This patch contains functionality for the Bad Debt Report and new"
^DIC(9.4,53,22,20,"PAH",59,1,2,0)="MCCR fund 5287."
^DIC(9.4,53,22,20,"PAH",60,0)="113 SEQ #90^2980618^1"
^DIC(9.4,53,22,20,"PAH",60,1,0)="^^3^3^2980618"
^DIC(9.4,53,22,20,"PAH",60,1,1,0)="Wrong appropriation for CHAMPVA on 215 report."
^DIC(9.4,53,22,20,"PAH",60,1,2,0)="Appropriation should be 3220 for CHAMPVA SUBSISTENCE"
^DIC(9.4,53,22,20,"PAH",60,1,3,0)="and CHAMPVA THIRD PARTY."
^DIC(9.4,53,22,20,"PAH",61,0)="58 SEQ #91^2980625^1"
^DIC(9.4,53,22,20,"PAH",61,1,0)="^^2^2^2980625"
^DIC(9.4,53,22,20,"PAH",61,1,1,0)="Penalty charge will now be added to non-benefit debt that are delinquent."
^DIC(9.4,53,22,20,"PAH",61,1,2,0)="Also, interest will not be decreased off of bills it was just added to."
^DIC(9.4,53,22,20,"PAH",62,0)="115 SEQ #92^2980712^1"
^DIC(9.4,53,22,20,"PAH",62,1,0)="^^1^1^2980712"
