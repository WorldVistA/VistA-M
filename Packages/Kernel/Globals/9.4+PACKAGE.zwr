^DIC(9.4,47,22,5.9,"PAH",836,0)="1050 SEQ #921^3210714.143442^17"
^DIC(9.4,47,22,5.9,"PAH",836,1,0)="^^3^3^3210714"
^DIC(9.4,47,22,5.9,"PAH",836,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - ADDITIONAL TFL UPDATE"
^DIC(9.4,47,22,5.9,"PAH",836,1,2,0)="Refer to patch DG*5.3*1050 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",836,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",837,0)="1047^3210823.132039^17"
^DIC(9.4,47,22,5.9,"PAH",837,1,0)="^^13^13^3210823"
^DIC(9.4,47,22,5.9,"PAH",837,1,1,0)="This patch introduces the new report Potential Presumptive Psychosis "
^DIC(9.4,47,22,5.9,"PAH",837,1,2,0)="Patient Report [DG POTEN PRESUMPT PSYCHOSIS] to identify patients who have"
^DIC(9.4,47,22,5.9,"PAH",837,1,3,0)="been registered in VistA using the Presumptive Psychosis (PP) 'workaround'"
^DIC(9.4,47,22,5.9,"PAH",837,1,4,0)="process since 38U.S. Code 1702 was passed on 3/14/2013. The report is to"
^DIC(9.4,47,22,5.9,"PAH",837,1,5,0)="be used by Registration/Enrollment users to identify PP patients without"
^DIC(9.4,47,22,5.9,"PAH",837,1,6,0)="PP category and select the PP category for them."
^DIC(9.4,47,22,5.9,"PAH",837,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",837,1,8,0)="This patch implements two modifications to support benefits provided by "
^DIC(9.4,47,22,5.9,"PAH",837,1,9,0)="the Deborah Sampson Act for all Former Service Members (FSM) including "
^DIC(9.4,47,22,5.9,"PAH",837,1,10,0)="those eligible for Other Than Honorable (OTH) benefits. Per the Deborah "
^DIC(9.4,47,22,5.9,"PAH",837,1,11,0)="Sampson Act, Former Service Members who experienced Military Sexual Trauma"
^DIC(9.4,47,22,5.9,"PAH",837,1,12,0)="(MST) are eligible for the full range of MST-related care-both mental"
^DIC(9.4,47,22,5.9,"PAH",837,1,13,0)="health and other medical care."
^DIC(9.4,47,22,5.9,"PAH",838,0)="1045 SEQ #923^3210920.131431^17"
^DIC(9.4,47,22,5.9,"PAH",838,1,0)="^^2^2^3210920"
^DIC(9.4,47,22,5.9,"PAH",838,1,1,0)="Please see the DG*5.3*1045 patch description for detailed information"
^DIC(9.4,47,22,5.9,"PAH",838,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",839,0)="1056^3210924.132725^17"
^DIC(9.4,47,22,5.9,"PAH",839,1,0)="^^2^2^3210924"
^DIC(9.4,47,22,5.9,"PAH",839,1,1,0)="Please see the DG*5.3*1056 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",839,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",840,0)="1061 SEQ #925^3211012.113125^17"
^DIC(9.4,47,22,5.9,"PAH",840,1,0)="^^2^2^3211012"
^DIC(9.4,47,22,5.9,"PAH",840,1,1,0)="Please see the DG*5.3*1061 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",840,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",841,0)="1062 SEQ #926^3211022.104519^17"
^DIC(9.4,47,22,5.9,"PAH",841,1,0)="^^3^3^3211022"
^DIC(9.4,47,22,5.9,"PAH",841,1,1,0)="Business owner requested to add three procedure codes to trigger VistA to "
^DIC(9.4,47,22,5.9,"PAH",841,1,2,0)="ask the number of dialysis treatments. The codes are: 5A1D70Z, 5A1D80Z, "
^DIC(9.4,47,22,5.9,"PAH",841,1,3,0)="5A1D90Z. "
^DIC(9.4,47,22,5.9,"PAH",842,0)="1065 SEQ #927^3211104.093803^17"
^DIC(9.4,47,22,5.9,"PAH",842,1,0)="^^2^2^3211104"
^DIC(9.4,47,22,5.9,"PAH",842,1,1,0)="Please see the DG*5.3*1065 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",842,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",843,0)="1054 SEQ #928^3211117.14245^17"
^DIC(9.4,47,22,5.9,"PAH",843,1,0)="^^3^3^3211117"
^DIC(9.4,47,22,5.9,"PAH",843,1,1,0)="Patch DG*5.3*1054 addresses an issue where a user reported their Vista"
^DIC(9.4,47,22,5.9,"PAH",843,1,2,0)="instance freezing when sending a PRF Query message to Austin MHV during"
^DIC(9.4,47,22,5.9,"PAH",843,1,3,0)="the Registration process."
^DIC(9.4,47,22,5.9,"PAH",844,0)="1059 SEQ #929^3211129.095939^17"
^DIC(9.4,47,22,5.9,"PAH",844,1,0)="^^3^3^3211129"
^DIC(9.4,47,22,5.9,"PAH",844,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENT - NEW DEMOGRAPHIC FIELDS"
^DIC(9.4,47,22,5.9,"PAH",844,1,2,0)="Refer to patch DG*5.3*1059 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",844,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",845,0)="1057 SEQ #930^3220103.124304^17"
^DIC(9.4,47,22,5.9,"PAH",846,0)="1063 SEQ #931^3220103.124507^17"
^DIC(9.4,47,22,5.9,"PAH",846,1,0)="^^13^13^3220103"
^DIC(9.4,47,22,5.9,"PAH",846,1,1,0)="Patch DG*5.3*1063 addresses 2 issues. "
^DIC(9.4,47,22,5.9,"PAH",846,1,2,0)="1. Certain ICD10 codes are not being found in the Diagnostic Code "
^DIC(9.4,47,22,5.9,"PAH",846,1,3,0)="   PTF Record Search [DG PTF ICD DIAGNOSTIC SEARCH] option due "
^DIC(9.4,47,22,5.9,"PAH",846,1,4,0)="   to the DGVDT variable being set to the ICD10 code set "
^DIC(9.4,47,22,5.9,"PAH",846,1,5,0)="   implementation date and passing that date into an optional"
^DIC(9.4,47,22,5.9,"PAH",846,1,6,0)="   search date parameter causing any ICD10 code activated "
^DIC(9.4,47,22,5.9,"PAH",846,1,7,0)="   after 10/01/2015 to not be returned by the search function. "
^DIC(9.4,47,22,5.9,"PAH",846,1,8,0)="2. Discrepancies between PID encoding characters when using "
^DIC(9.4,47,22,5.9,"PAH",846,1,9,0)="   Record Flag Assignment [DGPF RECORD FLAG ASSIGNMENT]."
^DIC(9.4,47,22,5.9,"PAH",846,1,10,0)="   If the HL array exists from a previous process it will attempt"
^DIC(9.4,47,22,5.9,"PAH",846,1,11,0)="   to use it first, before the HLFS & HLECH variables causing a"
^DIC(9.4,47,22,5.9,"PAH",846,1,12,0)="   potential discrepancy in the PID build segments which is causing "
^DIC(9.4,47,22,5.9,"PAH",846,1,13,0)="   an error at receiving sites."
^DIC(9.4,47,22,5.9,"PAH",847,0)="1068 SEQ #932^3220103.124621^17"
^DIC(9.4,47,22,5.9,"PAH",847,1,0)="^^7^7^3220103"
^DIC(9.4,47,22,5.9,"PAH",847,1,1,0)="The Means Test thresholds for Calendar Year 2022 are distributed with this"
^DIC(9.4,47,22,5.9,"PAH",847,1,2,0)="patch. The post-installation routine, DG1068P, will create a new "
^DIC(9.4,47,22,5.9,"PAH",847,1,3,0)="subentry (or replace an existing one) for calendar year 2022 in the MEANS"
^DIC(9.4,47,22,5.9,"PAH",847,1,4,0)="TEST DATA (#250) multiple field of the MAS PARAMETERS (#43) file."
^DIC(9.4,47,22,5.9,"PAH",847,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",847,1,6,0)="Patch DG*5.3*1068 updates the thresholds for the Means Tests and the "
^DIC(9.4,47,22,5.9,"PAH",847,1,7,0)="Maximum Annual Pension Rate."
^DIC(9.4,47,22,5.9,"PAH",848,0)="1066 SEQ #933^3220126.113554^17"
^DIC(9.4,47,22,5.9,"PAH",848,1,0)="^^7^7^3220126"
^DIC(9.4,47,22,5.9,"PAH",848,1,1,0)="This patch will update the description in the Patient Address Update [DG "
^DIC(9.4,47,22,5.9,"PAH",848,1,2,0)="ADDRESS UPDATE] option to add parentheses around the file (#301.7) to "
^DIC(9.4,47,22,5.9,"PAH",848,1,3,0)="meet proper FileMan formatting."
^DIC(9.4,47,22,5.9,"PAH",848,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",848,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",848,1,6,0)="It will also correct the name (#.01) OFFICE OF ECONOMIC OPPORTUNITY in "
^DIC(9.4,47,22,5.9,"PAH",848,1,7,0)="the Other Federal Agency file (#35) to be spelled correctly."
^DIC(9.4,47,22,5.9,"PAH",849,0)="1052 SEQ #935^3220223.110042^84"
^DIC(9.4,47,22,5.9,"PAH",849,1,0)="^^13^13^3220223"
^DIC(9.4,47,22,5.9,"PAH",849,1,1,0)="Patch DG*5.3*1052 addresses 3 issues."
^DIC(9.4,47,22,5.9,"PAH",849,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",849,1,3,0)="        1. User reported an UNDEFINED ODS+2^DGDIS error after entering '^'"
^DIC(9.4,47,22,5.9,"PAH",849,1,4,0)="        at the 'Select the type of disposition:' prompt in the Disposition"
^DIC(9.4,47,22,5.9,"PAH",849,1,5,0)="        an Application [DG DISPOSITION APPLICATION] option."
^DIC(9.4,47,22,5.9,"PAH",849,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",849,1,7,0)="        2. User reported an UNDEFINED ANS+15^DGDIS error after entering"
^DIC(9.4,47,22,5.9,"PAH",849,1,8,0)="        '^' at one of multiple possible prompts in the Disposition an"
^DIC(9.4,47,22,5.9,"PAH",849,1,9,0)="        Application [DG DISPOSITION APPLICATION] option."
^DIC(9.4,47,22,5.9,"PAH",849,1,10,0)=" "
^DIC(9.4,47,22,5.9,"PAH",849,1,11,0)="        3. An update to the Collateral Patient Register [DG COLLATERAL"
^DIC(9.4,47,22,5.9,"PAH",849,1,12,0)="        PATIENT] option to add a 'WARNING' message to notify users that"
^DIC(9.4,47,22,5.9,"PAH",849,1,13,0)="        they could potentially be editing the identity of a patient."
^DIC(9.4,47,22,5.9,"PAH",850,0)="1067^3220225.153826^84"
^DIC(9.4,47,22,5.9,"PAH",850,1,0)="^^2^2^3220225"
