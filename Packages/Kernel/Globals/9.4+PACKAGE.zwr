^DIC(9.4,13,22,9,"PAH",5,1,1,0)="Please refer to the Description in Forum Patch Module for details."
^DIC(9.4,13,22,9,"PAH",6,0)="5 SEQ #6^3170726.130454^54"
^DIC(9.4,13,22,9,"PAH",6,1,0)="^^1^1^3170726"
^DIC(9.4,13,22,9,"PAH",6,1,1,0)="Corrections for three defects in VA FileMan 22.2."
^DIC(9.4,13,22,9,"PAH",7,0)="8 SEQ #7^3170830.144841^54"
^DIC(9.4,13,22,9,"PAH",7,1,0)="^^1^1^3170830"
^DIC(9.4,13,22,9,"PAH",7,1,1,0)="Please refer to the Description in Forum Patch Module for details."
^DIC(9.4,13,22,9,"PAH",8,0)="13 SEQ #8^3171005.12232^54"
^DIC(9.4,13,22,9,"PAH",8,1,0)="^^1^1^3171005"
^DIC(9.4,13,22,9,"PAH",8,1,1,0)="Seven routines with corrections to five defects in VA FileMan 22.2"
^DIC(9.4,13,22,9,"PAH",9,0)="10 SEQ #9^3180601.162124^54"
^DIC(9.4,13,22,9,"PAH",9,1,0)="^^240^240^3180601"
^DIC(9.4,13,22,9,"PAH",9,1,1,0)="Patch DI*22.2*10 repairs the following defects:"
^DIC(9.4,13,22,9,"PAH",9,1,2,0)=" 1.     DIWP only supports strings up to 999 characters"
^DIC(9.4,13,22,9,"PAH",9,1,3,0)=" 2.     NUMDATE fix in patch 7 was not added to DINIT"
^DIC(9.4,13,22,9,"PAH",9,1,4,0)=" 3.     The variable DO is not killed after call to DIE"
^DIC(9.4,13,22,9,"PAH",9,1,5,0)=" 4.     New api EN^DITP for repointing deleted records"
^DIC(9.4,13,22,9,"PAH",9,1,6,0)=" 5.     New options for editing Data Types in patch 2 have no parent"
^DIC(9.4,13,22,9,"PAH",9,1,7,0)=" 6.     New API CHKPT^DIUTL(file, ien, message)"
^DIC(9.4,13,22,9,"PAH",9,1,8,0)=""
