^DIC(9.4,48,22,5.28,"PAH",194,1,42,0)=" "
^DIC(9.4,48,22,5.28,"PAH",194,1,43,0)="   ROUTINE SUMMARY:"
^DIC(9.4,48,22,5.28,"PAH",194,1,44,0)="   ================"
