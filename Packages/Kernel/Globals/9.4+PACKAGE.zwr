^DIC(9.4,60,22,13,"PAH",602,1,796,0)="14.(HDSO-7774) RESEND eRx Change Request"
^DIC(9.4,60,22,13,"PAH",602,1,797,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,798,0)="   The new action called Resend Change Request (REC) will now allow the user"
^DIC(9.4,60,22,13,"PAH",602,1,799,0)="   to send the previously sent eRx Change Request to the prescriber. Right"
^DIC(9.4,60,22,13,"PAH",602,1,800,0)="   after user enters REC in the Select Action:Next Screen// prompt, the"
^DIC(9.4,60,22,13,"PAH",602,1,801,0)="   software will display the RX CHANGE REQUEST SUMMARY. This allows the user"
^DIC(9.4,60,22,13,"PAH",602,1,802,0)="   to review the previously sent eRx Change Request. The user can edit the"
^DIC(9.4,60,22,13,"PAH",602,1,803,0)="   existing eRx Change Request or just leave them as is, as shown below:"
^DIC(9.4,60,22,13,"PAH",602,1,804,0)=" "
