^DIC(9.4,4,22,1,"PAH",157,0)="187 SEQ #182^3010608^1"
^DIC(9.4,4,22,1,"PAH",157,1,0)="^^59^59^3010608"
^DIC(9.4,4,22,1,"PAH",157,1,1,0)="Patch XM*7.1*187"
^DIC(9.4,4,22,1,"PAH",157,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",157,1,3,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",157,1,4,0)="Test Site:  FORUM"
^DIC(9.4,4,22,1,"PAH",157,1,5,0)="When sending a message from FORUM to GK, if GK does not like the FROM"
^DIC(9.4,4,22,1,"PAH",157,1,6,0)="address, it returns ""501 Syntax Error"".  MailMan moves on to the next"
^DIC(9.4,4,22,1,"PAH",157,1,7,0)="message, but does not delete the message from the queue or attempt to"
^DIC(9.4,4,22,1,"PAH",157,1,8,0)="notify the sender of the problem.  This patch ensures that both actions"
^DIC(9.4,4,22,1,"PAH",157,1,9,0)="occur."
^DIC(9.4,4,22,1,"PAH",157,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",157,1,11,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",157,1,12,0)="is at a minimum.  It requires MailMan patch XM*7.1*182."
^DIC(9.4,4,22,1,"PAH",157,1,13,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",157,1,14,0)=""
