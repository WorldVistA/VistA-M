^DIC(9.4,14,22,5.9,"PAH",283,1,94,0)="New Service Requests (NSRs):"
^DIC(9.4,14,22,5.9,"PAH",283,1,95,0)="----------------------------   "
^DIC(9.4,14,22,5.9,"PAH",283,1,96,0)="#20140511"
^DIC(9.4,14,22,5.9,"PAH",283,1,97,0)="The Anatomic Pathology (AP) laboratory service needs a mechanism for "
^DIC(9.4,14,22,5.9,"PAH",283,1,98,0)="clinicians to provide required patient-specific, procedure-specific, and "
^DIC(9.4,14,22,5.9,"PAH",283,1,99,0)="specimen-specific information to facilitate specimen processing by "
^DIC(9.4,14,22,5.9,"PAH",283,1,100,0)="pathologists. This mechanism must be in place for use by the specimen "
^DIC(9.4,14,22,5.9,"PAH",283,1,101,0)="labeling application in order to generate a primary specimen label that "
^DIC(9.4,14,22,5.9,"PAH",283,1,102,0)="positively identifies the specimen and accurately associates it with the "
^DIC(9.4,14,22,5.9,"PAH",283,1,103,0)="patient."
^DIC(9.4,14,22,5.9,"PAH",283,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",283,1,105,0)="Patient Safety Issues (PSIs):"
