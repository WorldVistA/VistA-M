^DIC(9.4,4,22,1,"PAH",72,0)="103 SEQ #97^2991019^1"
^DIC(9.4,4,22,1,"PAH",72,1,0)="^^54^54^2991019"
^DIC(9.4,4,22,1,"PAH",72,1,1,0)="Patch XM*7.1*103"
^DIC(9.4,4,22,1,"PAH",72,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",72,1,3,0)="NOIS:  LOM-1099-61129"
^DIC(9.4,4,22,1,"PAH",72,1,4,0)="Test Site:  Loma Linda, CA"
^DIC(9.4,4,22,1,"PAH",72,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",72,1,6,0)="Patch XM*7.1*50 introduced a bug into EN1^XMD.  It replaced the FROM field"
^DIC(9.4,4,22,1,"PAH",72,1,7,0)="in the message stub with DUZ.  This patch puts a stop to that."
^DIC(9.4,4,22,1,"PAH",72,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",72,1,9,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",72,1,10,0)="minimum.  It requires MailMan patch XM*7.1*98."
^DIC(9.4,4,22,1,"PAH",72,1,11,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",72,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",72,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",72,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",72,1,15,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",72,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",72,1,17,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",72,1,18,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",72,1,19,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",72,1,20,0)="XMD            6947940         7129791        33,50,98,103"
^DIC(9.4,4,22,1,"PAH",72,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",72,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
