^DIC(9.4,150,22,"B","2.0",1)=""
^DIC(9.4,150,22,"B","3.0",2)=""
^DIC(9.4,150,"DEV")="PICKUP,JERRY L T/AUGUSTA VAMC"
^DIC(9.4,150,"VERSION")="3.0"
^DIC(9.4,151,0)="EVENT CAPTURE^EC^Event Capture Workload Capture System^"
^DIC(9.4,151,1,0)="^^5^5^2960331^^^^"
^DIC(9.4,151,1,1,0)="Event Capture is that portion of the Decision Support System (DSS) which"
^DIC(9.4,151,1,2,0)="has been designed to capture the workload for those areas which do not"
^DIC(9.4,151,1,3,0)="currently have a software system which may be extracted.  Such areas as"
^DIC(9.4,151,1,4,0)="Chaplain, Canteen, and non-associated clinics can use Event Capture to"
^DIC(9.4,151,1,5,0)="track their workload."
^DIC(9.4,151,5)="BIRMINGHAM"
^DIC(9.4,151,7)="^^"
^DIC(9.4,151,20,0)="^9.402P^^"
^DIC(9.4,151,22,0)="^9.49I^1^1"
^DIC(9.4,151,22,1,0)="2.0^3051119^2960926^1"
^DIC(9.4,151,22,1,1,0)="^^5^5^3051119"
^DIC(9.4,151,22,1,1,1,0)="The Event Capture module provides a mechanism to track and account for"
^DIC(9.4,151,22,1,1,2,0)="patient workload performed that is not recorded in any existing DHCP"
^DIC(9.4,151,22,1,1,3,0)="package.  These procedures and services are associated with the patient"
^DIC(9.4,151,22,1,1,4,0)="to whom they were delivered, the provider rendering the service or"
^DIC(9.4,151,22,1,1,5,0)="procedure, and the workload unit responsible for delivering the service."
^DIC(9.4,151,22,1,"PAH",0)="^9.4901^154^154"
^DIC(9.4,151,22,1,"PAH",1,0)="1^2960926^1"
^DIC(9.4,151,22,1,"PAH",1,1,0)="^^108^108^2960926"
^DIC(9.4,151,22,1,"PAH",1,1,1,0)="  This patch corrects several miscellaneous data entry problems that"
^DIC(9.4,151,22,1,"PAH",1,1,2,0)="  have been identified."
^DIC(9.4,151,22,1,"PAH",1,1,3,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,4,0)="  Problem 1."
^DIC(9.4,151,22,1,"PAH",1,1,5,0)="  NOIS #OKL-0596-72092 reported an <UNDEF> error at SELC+1^ECBEN2A."
^DIC(9.4,151,22,1,"PAH",1,1,6,0)="  The variable EC1 was undefined.  All data entry options have been"
^DIC(9.4,151,22,1,"PAH",1,1,7,0)="  reviewed to ensure that the variable EC1 is defined."
^DIC(9.4,151,22,1,"PAH",1,1,8,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,9,0)="  Problem 2."
^DIC(9.4,151,22,1,"PAH",1,1,10,0)="  NOIS #LON-0596-61759 reported a duplicate screen display when using"
^DIC(9.4,151,22,1,"PAH",1,1,11,0)="  the ""Batch Data Entry by Patient"" or ""Data Entry (Batch) by Procedure"""
^DIC(9.4,151,22,1,"PAH",1,1,12,0)="  options.  After selecting a procedure, from the listing of available"
^DIC(9.4,151,22,1,"PAH",1,1,13,0)="  procedures, the procedure name is echoed back plus printing the name"
^DIC(9.4,151,22,1,"PAH",1,1,14,0)="  two additional times.  The additional printing of the procedure names"
^DIC(9.4,151,22,1,"PAH",1,1,15,0)="  has been eliminated."
^DIC(9.4,151,22,1,"PAH",1,1,16,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,17,0)="  Problem 3."
^DIC(9.4,151,22,1,"PAH",1,1,18,0)="  NOIS #LON-0596-61762 reported that when using the ""Batch Data Entry"
^DIC(9.4,151,22,1,"PAH",1,1,19,0)="  by Patient"", if an ""^"" is entered at the prompt ""Is this information"
^DIC(9.4,151,22,1,"PAH",1,1,20,0)="  correct?"" the user is not exited from the option.  The user is then"
^DIC(9.4,151,22,1,"PAH",1,1,21,0)="  prompted to ""Select Next Patient"".  If a patient is selected the list of"
^DIC(9.4,151,22,1,"PAH",1,1,22,0)="  selected patients is numbered incorrectly.  Now when an ""^"" is entered"
^DIC(9.4,151,22,1,"PAH",1,1,23,0)="  at ""Is this information correct?"" a screen displayed alerting the user"
^DIC(9.4,151,22,1,"PAH",1,1,24,0)="  that ""**NOTE**  No action taken. You must  re-enter the correct patient"
^DIC(9.4,151,22,1,"PAH",1,1,25,0)="  and procedure data that has NOT been filed during this session. "".  The"
^DIC(9.4,151,22,1,"PAH",1,1,26,0)="  user is then prompted to ""Select Patient""."
^DIC(9.4,151,22,1,"PAH",1,1,27,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,28,0)="  Problem 4."
^DIC(9.4,151,22,1,"PAH",1,1,29,0)="  After confirming a category using the ""Local Category (Enter/Edit)"""
^DIC(9.4,151,22,1,"PAH",1,1,30,0)="  option the screen will display ""??"".  The option correctly updated the"
^DIC(9.4,151,22,1,"PAH",1,1,31,0)="  category name but was not updating the date created information when "
^DIC(9.4,151,22,1,"PAH",1,1,32,0)="  the category was initially entered."
^DIC(9.4,151,22,1,"PAH",1,1,33,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,34,0)="  Problem 5."
^DIC(9.4,151,22,1,"PAH",1,1,35,0)="  NOIS STC-0696-40797 reported when creating an Event Code Screen the"
^DIC(9.4,151,22,1,"PAH",1,1,36,0)="  user is prompted with ""Is the following information correct? YES// """
^DIC(9.4,151,22,1,"PAH",1,1,37,0)="  when the data is listed previously on the screen.  The display"
^DIC(9.4,151,22,1,"PAH",1,1,38,0)="  message has been changed to read ""Is this information correct? YES// ""."
^DIC(9.4,151,22,1,"PAH",1,1,39,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,40,0)="  Problem 6."
^DIC(9.4,151,22,1,"PAH",1,1,41,0)="  The routines ECED and ECDSSYN killed the variable ^TMP(""ECPRO"")"
^DIC(9.4,151,22,1,"PAH",1,1,42,0)="  incorrectly.  The correct method killing ^TMP(""ECPRO"",$J) has"
^DIC(9.4,151,22,1,"PAH",1,1,43,0)="  been inserted.  This will prevent procedure lists from being"
^DIC(9.4,151,22,1,"PAH",1,1,44,0)="  deleted by mistake."
^DIC(9.4,151,22,1,"PAH",1,1,45,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,46,0)="  Problem 7."
^DIC(9.4,151,22,1,"PAH",1,1,47,0)="  When using the data entry options and selecting a procedure from"
^DIC(9.4,151,22,1,"PAH",1,1,48,0)="  the listing displayed, an <UNDEF> error could occur if ""01"" was"
^DIC(9.4,151,22,1,"PAH",1,1,49,0)="  entered instead of ""1"".  This error has been corrected."
^DIC(9.4,151,22,1,"PAH",1,1,50,0)="  "
^DIC(9.4,151,22,1,"PAH",1,1,51,0)="ROUTINE SUMMARY: "
^DIC(9.4,151,22,1,"PAH",1,1,52,0)="=================="
^DIC(9.4,151,22,1,"PAH",1,1,53,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,54,0)="  The following routine is included in this patch.  The second line of the"
^DIC(9.4,151,22,1,"PAH",1,1,55,0)="  routines will look like:"
^DIC(9.4,151,22,1,"PAH",1,1,56,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,57,0)="  <tab>;;2.0; EVENT CAPTURE ;**[patch list]**;8 May 96"
^DIC(9.4,151,22,1,"PAH",1,1,58,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,59,0)="        CHECK^XTSUMBLD results:"
^DIC(9.4,151,22,1,"PAH",1,1,60,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,61,0)="Routine Name         Before Patch       After Patch              Patch List"
^DIC(9.4,151,22,1,"PAH",1,1,62,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,63,0)="   ECBEN2A             16143247           17248422                     1"
^DIC(9.4,151,22,1,"PAH",1,1,64,0)="   ECBEP1B              6124470           15735188                     1"
^DIC(9.4,151,22,1,"PAH",1,1,65,0)="   ECDSS2               3173984            3165330                     1"
^DIC(9.4,151,22,1,"PAH",1,1,66,0)="   ECDSSYN             11622115           11631282                     1"
^DIC(9.4,151,22,1,"PAH",1,1,67,0)="   ECED                 9546738            9549509                     1"
^DIC(9.4,151,22,1,"PAH",1,1,68,0)="   ECED2                9397816            9471887                     1"
^DIC(9.4,151,22,1,"PAH",1,1,69,0)="   ECED3               14007833           14074752                     1 "
^DIC(9.4,151,22,1,"PAH",1,1,70,0)="   ECSCR                5323033            5255260                     1"
^DIC(9.4,151,22,1,"PAH",1,1,71,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,72,0)="INSTALLATION INSTRUCTIONS: "
^DIC(9.4,151,22,1,"PAH",1,1,73,0)="=========================="
^DIC(9.4,151,22,1,"PAH",1,1,74,0)=" "
^DIC(9.4,151,22,1,"PAH",1,1,75,0)="  This patch may be loaded during regular hours.  It mainly affects users of"
^DIC(9.4,151,22,1,"PAH",1,1,76,0)="  the Event Capture software.  Installation will take less than 5 minutes.  "
^DIC(9.4,151,22,1,"PAH",1,1,77,0)="  1.  Use the INSTALL/CHECK MESSAGE option on the PackMan menu"
^DIC(9.4,151,22,1,"PAH",1,1,78,0)="      and answer NO to the question 'Shall I preserve what is on disk in a "
^DIC(9.4,151,22,1,"PAH",1,1,79,0)="      separate back-up message ?'.  Answer YES to the prompt 'Want to "
^DIC(9.4,151,22,1,"PAH",1,1,80,0)="      Continue with Load? YES//' "
^DIC(9.4,151,22,1,"PAH",1,1,81,0)="  2.  Review your mapped set.  If any of the routines listed in the "
^DIC(9.4,151,22,1,"PAH",1,1,82,0)="      ROUTINE INFORMATION section are mapped, they should be "
^DIC(9.4,151,22,1,"PAH",1,1,83,0)="      removed from the mapped set at this time.  None of the patched "
^DIC(9.4,151,22,1,"PAH",1,1,84,0)="      routines are on the recommended mapping list.  "
^DIC(9.4,151,22,1,"PAH",1,1,85,0)="  3.  From the Kernel Installation and Distribution System Menu, select "
^DIC(9.4,151,22,1,"PAH",1,1,86,0)="      the Installation menu.  "
^DIC(9.4,151,22,1,"PAH",1,1,87,0)="  4.  From this menu, you may elect to use the following options "
^DIC(9.4,151,22,1,"PAH",1,1,88,0)="      (when prompted for INSTALL NAME, enter EC*2.0*1): "
^DIC(9.4,151,22,1,"PAH",1,1,89,0)="      a.  Backup a Transport Global - this option will create a backup "
^DIC(9.4,151,22,1,"PAH",1,1,90,0)="          message of any routines exported with the patch."
^DIC(9.4,151,22,1,"PAH",1,1,91,0)="      b.  Compare Transport Global to Current System  - this option will "
^DIC(9.4,151,22,1,"PAH",1,1,92,0)="          allow you to view all changes that will be made when the patch "
^DIC(9.4,151,22,1,"PAH",1,1,93,0)="          is installed."
^DIC(9.4,151,22,1,"PAH",1,1,94,0)="      c.  Verify Checksums in Transport Global - this option will "
^DIC(9.4,151,22,1,"PAH",1,1,95,0)="          allow you to ensure the integrity of the routines that are in "
^DIC(9.4,151,22,1,"PAH",1,1,96,0)="          the transport global.  "
^DIC(9.4,151,22,1,"PAH",1,1,97,0)="  5.  Use the Install Package(s) option and select the package EC*2.0*1.  "
^DIC(9.4,151,22,1,"PAH",1,1,98,0)="  6.  When prompted 'Want to DISABLE Scheduled Options and Options? "
^DIC(9.4,151,22,1,"PAH",1,1,99,0)="      YES//', respond YES.  When prompted to select the options you would "
^DIC(9.4,151,22,1,"PAH",1,1,100,0)="      like to place out of order, enter the following: "
^DIC(9.4,151,22,1,"PAH",1,1,101,0)="          ECPAT Enter/Edit Patient Procedures"
^DIC(9.4,151,22,1,"PAH",1,1,102,0)="          ECBATCH Batch Enter Data by Patient"
^DIC(9.4,151,22,1,"PAH",1,1,103,0)="          ECBATCH PROC Data Entry (Batch) by Procedure"
^DIC(9.4,151,22,1,"PAH",1,1,104,0)="  7.  MSM sites:  Please ensure you answer YES when asked if you want "
^DIC(9.4,151,22,1,"PAH",1,1,105,0)="      to move the routines to other systems and indicate the appropriate "
^DIC(9.4,151,22,1,"PAH",1,1,106,0)="      CPUs.  Alternately, you can wait until the installation is complete "
^DIC(9.4,151,22,1,"PAH",1,1,107,0)="      and move the routines listed in the ROUTINE INFORMATION section "
^DIC(9.4,151,22,1,"PAH",1,1,108,0)="      to all systems.  "
^DIC(9.4,151,22,1,"PAH",2,0)="2^2960926^1"
^DIC(9.4,151,22,1,"PAH",2,1,0)="^^20^20^2960926"
^DIC(9.4,151,22,1,"PAH",2,1,1,0)="This patch updates entries in the EC NATIONAL PROCEDURE file (#725)."
^DIC(9.4,151,22,1,"PAH",2,1,2,0)=" "
^DIC(9.4,151,22,1,"PAH",2,1,3,0)="The procedure ""PC-THEODICY-PT SPIRITUAL"", national number ""CH058"","
^DIC(9.4,151,22,1,"PAH",2,1,4,0)="will be changed to ""PC-THEODICY-UNFAIRNESS OF GOD/LIFE 14091""."
^DIC(9.4,151,22,1,"PAH",2,1,5,0)="The internal entry number is 58.  This patch will not install if entry"
^DIC(9.4,151,22,1,"PAH",2,1,6,0)="number 58 is not ""PC-THEODICY-PT SPIRITUAL""."
^DIC(9.4,151,22,1,"PAH",2,1,7,0)=" "
^DIC(9.4,151,22,1,"PAH",2,1,8,0)="New entries follow:"
^DIC(9.4,151,22,1,"PAH",2,1,9,0)="IEN     NATIONAL #        NAME"
^DIC(9.4,151,22,1,"PAH",2,1,10,0)="==       ==========        ======"
^DIC(9.4,151,22,1,"PAH",2,1,11,0)=" "
^DIC(9.4,151,22,1,"PAH",2,1,12,0)="169       CH062                 COMMUNION"
^DIC(9.4,151,22,1,"PAH",2,1,13,0)="170       CH063                 COMPUTERIZED SPIRITUAL ASSESSMENT"
^DIC(9.4,151,22,1,"PAH",2,1,14,0)="171       CH064                 FIFTH STEP"
^DIC(9.4,151,22,1,"PAH",2,1,15,0)="172       CH065                 FUNERAL"
^DIC(9.4,151,22,1,"PAH",2,1,16,0)="173       CH066                 PATIENT EDUCATION-ADVANCED DIRECTIVES"
^DIC(9.4,151,22,1,"PAH",2,1,17,0)="174       CH067                 GROUP ON SPIRITUALITY EDUCATION"
^DIC(9.4,151,22,1,"PAH",2,1,18,0)="175       CH068                 PC-SEXUALITY"
^DIC(9.4,151,22,1,"PAH",2,1,19,0)="176       CH069                 PC-SPIRITUAL ASSESSMENT"
^DIC(9.4,151,22,1,"PAH",2,1,20,0)="177       CH070                 ADVANCE DIRECTIVE CONSULTATION"
^DIC(9.4,151,22,1,"PAH",3,0)="4^2970422^1"
^DIC(9.4,151,22,1,"PAH",3,1,0)="^^265^265^2970422"
^DIC(9.4,151,22,1,"PAH",3,1,1,0)="*** Patient Care Encounter (PCE) Version 1.0 should be installed "
^DIC(9.4,151,22,1,"PAH",3,1,2,0)="    before installing this patch.  "
^DIC(9.4,151,22,1,"PAH",3,1,3,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,4,0)="Three patches are required before installing this patch.  Event"
^DIC(9.4,151,22,1,"PAH",3,1,5,0)="Capture patches EC*2*1, EC*2*2, and KERNEL patch XU*8*44.  "
^DIC(9.4,151,22,1,"PAH",3,1,6,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,7,0)="This patch will impact the DSS Extracts ECS Feeder Key report"
^DIC(9.4,151,22,1,"PAH",3,1,8,0)="and the ECS extract.  A DSS Extracts patch, ECX*2*23, is currently"
^DIC(9.4,151,22,1,"PAH",3,1,9,0)="under development that addresses the ECS feeder keys for FY97 and"
^DIC(9.4,151,22,1,"PAH",3,1,10,0)="the ECS extract fix.  Targeted release date for patch ECX*2*23"
^DIC(9.4,151,22,1,"PAH",3,1,11,0)="is May 10, 1997."
^DIC(9.4,151,22,1,"PAH",3,1,12,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,13,0)="NOTE:  Your site should NOT run the ECS extract, after installing"
^DIC(9.4,151,22,1,"PAH",3,1,14,0)="EC*2*4, until the DSS Extracts patch ECX*2*23 is released and"
^DIC(9.4,151,22,1,"PAH",3,1,15,0)="installed on your system.  Any ECS extract your site generated"
^DIC(9.4,151,22,1,"PAH",3,1,16,0)="prior to installing EC*2*4 is not affected. The ECS extract will only"
^DIC(9.4,151,22,1,"PAH",3,1,17,0)="be impacted AFTER EC*2*4 is installed."
^DIC(9.4,151,22,1,"PAH",3,1,18,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,19,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,20,0)="This patch implements new functionality in the Event"
^DIC(9.4,151,22,1,"PAH",3,1,21,0)="Capture (EC) package to allow the non-interactive filing of"
^DIC(9.4,151,22,1,"PAH",3,1,22,0)="the EC system workload data to the Patient Care Encounter"
^DIC(9.4,151,22,1,"PAH",3,1,23,0)="(PCE) software.  By utilizing this EC to PCE filing process,"
^DIC(9.4,151,22,1,"PAH",3,1,24,0)="the need for duplicate data entry into both packages diminishes"
^DIC(9.4,151,22,1,"PAH",3,1,25,0)="while supporting the transmission of workload data to"
^DIC(9.4,151,22,1,"PAH",3,1,26,0)="nationally supported databases.  Outpatient data entered into"
^DIC(9.4,151,22,1,"PAH",3,1,27,0)="EC, passed through PCE, updates the National Patient Care"
^DIC(9.4,151,22,1,"PAH",3,1,28,0)="Database (NPCBD) at the Austin Automation Center (AAC).  All"
^DIC(9.4,151,22,1,"PAH",3,1,29,0)="data entered into EC is passed to the Decision Support System"
^DIC(9.4,151,22,1,"PAH",3,1,30,0)="(DSS) at the AAC using the VISTA DSS Extracts software."
^DIC(9.4,151,22,1,"PAH",3,1,31,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,32,0)="This is a mandatory patch and MUST be installed.  If your site does"
^DIC(9.4,151,22,1,"PAH",3,1,33,0)="not anticipate sending Event Capture data to PCE, this patch still"
^DIC(9.4,151,22,1,"PAH",3,1,34,0)="MUST be installed.  The only difference your users will see is both"
^DIC(9.4,151,22,1,"PAH",3,1,35,0)="DATE and TIME are now required to enter workload data into Event"
^DIC(9.4,151,22,1,"PAH",3,1,36,0)="Capture.  They will never see the additional prompts required for"
^DIC(9.4,151,22,1,"PAH",3,1,37,0)="the filing of data to PCE."
^DIC(9.4,151,22,1,"PAH",3,1,38,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,39,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,40,0)="Three NOIS messages are addressed in this patch.  The AMIS Reports"
^DIC(9.4,151,22,1,"PAH",3,1,41,0)="are modified to correct the problems reported in the following NOIS: "
^DIC(9.4,151,22,1,"PAH",3,1,42,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,43,0)=" ATG-1196-30490 AMIS Report Producing Incorrect Totals "
^DIC(9.4,151,22,1,"PAH",3,1,44,0)=" LON-0896-60887 AMIS Summary - Dropping Procedure "
^DIC(9.4,151,22,1,"PAH",3,1,45,0)=" BRX-0297-11162 Original Default Volume "
^DIC(9.4,151,22,1,"PAH",3,1,46,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,47,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,48,0)="The data dictionary changes made by this patch are listed below,"
^DIC(9.4,151,22,1,"PAH",3,1,49,0)="followed by a summary of the PCE filing process and patch"
^DIC(9.4,151,22,1,"PAH",3,1,50,0)="installation instructions.  "
^DIC(9.4,151,22,1,"PAH",3,1,51,0)="EC NATIONAL PROCEDURE file (#725): A new field called CPT"
^DIC(9.4,151,22,1,"PAH",3,1,52,0)="(field #4) is added which should be edited for each local"
^DIC(9.4,151,22,1,"PAH",3,1,53,0)="procedure entry that sends workload data to PCE.  A Current"
^DIC(9.4,151,22,1,"PAH",3,1,54,0)="Procedural Terminology (CPT) code is required to pass EC"
^DIC(9.4,151,22,1,"PAH",3,1,55,0)="procedural data to PCE.  Only the local EC procedures"
^DIC(9.4,151,22,1,"PAH",3,1,56,0)="representing workload that your sites wants sent to PCE"
^DIC(9.4,151,22,1,"PAH",3,1,57,0)="require an associated CPT code.  The option Local Procedure"
^DIC(9.4,151,22,1,"PAH",3,1,58,0)="(Enter/Edit) [ECDSS PROCEDURE] is modified for users to edit"
^DIC(9.4,151,22,1,"PAH",3,1,59,0)="this field for local procedures and is exported as part of the"
^DIC(9.4,151,22,1,"PAH",3,1,60,0)="Event Capture Management Menu [ECMGR]."
^DIC(9.4,151,22,1,"PAH",3,1,61,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,62,0)="Many new nationally defined procedures added in this patch"
^DIC(9.4,151,22,1,"PAH",3,1,63,0)="include Speech Pathology  and Blood Bank.  Products for Social"
^DIC(9.4,151,22,1,"PAH",3,1,64,0)="Work and Chaplain service have been completely redefined.  A"
^DIC(9.4,151,22,1,"PAH",3,1,65,0)="generic CPT code is associated with each existing active"
^DIC(9.4,151,22,1,"PAH",3,1,66,0)="national procedure entry.  Use the National/Local Procedure"
^DIC(9.4,151,22,1,"PAH",3,1,67,0)="Reports [ECDSS1] option on the Management Reports [ECDSRPT] menu"
^DIC(9.4,151,22,1,"PAH",3,1,68,0)="to review the new and updated entries in this file.   "
^DIC(9.4,151,22,1,"PAH",3,1,69,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,70,0)=" Field 4 - CPT "
^DIC(9.4,151,22,1,"PAH",3,1,71,0)="  The Current Procedural Terminology (CPT) code equivalent for this "
^DIC(9.4,151,22,1,"PAH",3,1,72,0)="  national or local procedure.  Each EC recognized procedure must "
^DIC(9.4,151,22,1,"PAH",3,1,73,0)="  have an associated CPT code for filing with PCE.  "
^DIC(9.4,151,22,1,"PAH",3,1,74,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,75,0)="DSS UNIT file (#724): The DATA ENTRY DATE/TIME DEFAULT field"
^DIC(9.4,151,22,1,"PAH",3,1,76,0)="(#11) is modified to accept N for NOW or X for NONE as a date/time"
^DIC(9.4,151,22,1,"PAH",3,1,77,0)="default.  T for TODAY is no longer a valid date/time default."
^DIC(9.4,151,22,1,"PAH",3,1,78,0)="All existing DSS Units using T for TODAY will be updated to use"
^DIC(9.4,151,22,1,"PAH",3,1,79,0)="N for NOW during the installation process."
^DIC(9.4,151,22,1,"PAH",3,1,80,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,81,0)="One new field, SEND TO PCE (field #13), is added which must"
^DIC(9.4,151,22,1,"PAH",3,1,82,0)="be edited in order to activate the filing process. The option"
^DIC(9.4,151,22,1,"PAH",3,1,83,0)="DSS Units for Event Capture (Enter/Edit) [ECSECT] is modified"
^DIC(9.4,151,22,1,"PAH",3,1,84,0)="to edit these fields and is exported with the Event Capture"
^DIC(9.4,151,22,1,"PAH",3,1,85,0)="Management Menu [ECMGR]."
^DIC(9.4,151,22,1,"PAH",3,1,86,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,87,0)=" Field 13 -  SEND TO PCE "
^DIC(9.4,151,22,1,"PAH",3,1,88,0)="  This field controls the method of sending data, by DSS Unit, to the "
^DIC(9.4,151,22,1,"PAH",3,1,89,0)="  PCE software.  If this field contains an O, only outpatient data, for "
^DIC(9.4,151,22,1,"PAH",3,1,90,0)="  this DSS Unit, will be filed with PCE.  If the field contains an A, "
^DIC(9.4,151,22,1,"PAH",3,1,91,0)="  all records, for this DSS Unit, can be filed with PCE.  If the field "
^DIC(9.4,151,22,1,"PAH",3,1,92,0)="  contains an N or is null, no filing will occur.  This field is exported "
^DIC(9.4,151,22,1,"PAH",3,1,93,0)="  null.  "
^DIC(9.4,151,22,1,"PAH",3,1,94,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,95,0)="EC EVENT CODE SCREENS FILE (#720.3): This file contains a single new field"
^DIC(9.4,151,22,1,"PAH",3,1,96,0)="that allows the site to associate a clinic with an event code screen."
^DIC(9.4,151,22,1,"PAH",3,1,97,0)="This field is described below."
^DIC(9.4,151,22,1,"PAH",3,1,98,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,99,0)=" Field 55 - ASSOCIATED CLINIC"
^DIC(9.4,151,22,1,"PAH",3,1,100,0)="  This field will indicate the default clinic associated with workload "
^DIC(9.4,151,22,1,"PAH",3,1,101,0)="  performed by this event code screen.  This clinic will be used as the"
^DIC(9.4,151,22,1,"PAH",3,1,102,0)="  hospital location for the EC system workload records for PCE filing"
^DIC(9.4,151,22,1,"PAH",3,1,103,0)="  purposes.  This clinic will also be the source for the stop code"
^DIC(9.4,151,22,1,"PAH",3,1,104,0)="  (DSS ID) needed by PCE.  This field should be edited for each event"
^DIC(9.4,151,22,1,"PAH",3,1,105,0)="  code screen that will send to PCE.  The clinic associated with the"
^DIC(9.4,151,22,1,"PAH",3,1,106,0)="  event code screen will be displayed to users during the data entry"
^DIC(9.4,151,22,1,"PAH",3,1,107,0)="  processes."
^DIC(9.4,151,22,1,"PAH",3,1,108,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,109,0)="EVENT CAPTURE PATIENT file (#721): The DATE/TIME OF PROCEDURE field"
^DIC(9.4,151,22,1,"PAH",3,1,110,0)="(#2) is modified to require time for every record entered.  New"
^DIC(9.4,151,22,1,"PAH",3,1,111,0)="fields which have been added to this file are described below."
^DIC(9.4,151,22,1,"PAH",3,1,112,0)="The data entry options Enter/Edit Patient Procedures [ECPAT],"
^DIC(9.4,151,22,1,"PAH",3,1,113,0)="Batch Enter Data by Patient [ECBATCH], and Data Entry (Batch) by"
^DIC(9.4,151,22,1,"PAH",3,1,114,0)="Procedure [ECBATCH PROC] are modified to ask users these questions"
^DIC(9.4,151,22,1,"PAH",3,1,115,0)="or update the fields automatically when appropriate.  "
^DIC(9.4,151,22,1,"PAH",3,1,116,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,117,0)=" Field 19 - PCE CPT CODE "
^DIC(9.4,151,22,1,"PAH",3,1,118,0)="  The Current Procedural Terminology (CPT) code for the patient "
^DIC(9.4,151,22,1,"PAH",3,1,119,0)="  procedure performed.  "
^DIC(9.4,151,22,1,"PAH",3,1,120,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,121,0)=" Field 20 - ICD-9 CODE "
^DIC(9.4,151,22,1,"PAH",3,1,122,0)="  The ICD-9 (diagnosis) for the procedure performed.  This data "
^DIC(9.4,151,22,1,"PAH",3,1,123,0)="  element is required for all workload records.  "
^DIC(9.4,151,22,1,"PAH",3,1,124,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,125,0)=" Field 21 - AGENT ORANGE "
^DIC(9.4,151,22,1,"PAH",3,1,126,0)="  This field will be used to indicate if this procedure is treating "
^DIC(9.4,151,22,1,"PAH",3,1,127,0)="  a VA patient for a problem that is related to Agent Orange Exposure."
^DIC(9.4,151,22,1,"PAH",3,1,128,0)="  Data is Y if this patient was exposed to agent orange, N if not, "
^DIC(9.4,151,22,1,"PAH",3,1,129,0)="  or U if unknown.  "
^DIC(9.4,151,22,1,"PAH",3,1,130,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,131,0)=" Field 22 - RADIATION EXPOSURE "
^DIC(9.4,151,22,1,"PAH",3,1,132,0)="  This field will be used to indicate if this procedure is treating "
^DIC(9.4,151,22,1,"PAH",3,1,133,0)="  a VA patient for a problem that is related to Ionizing Radiation "
^DIC(9.4,151,22,1,"PAH",3,1,134,0)="  Exposure.  Data is Y if this patient claims exposure to ionizing "
^DIC(9.4,151,22,1,"PAH",3,1,135,0)="  radiation, N if not, or U if unknown.  "
^DIC(9.4,151,22,1,"PAH",3,1,136,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,137,0)=" Field 23 - ENVIRONMENTAL CONTAMINANTS "
^DIC(9.4,151,22,1,"PAH",3,1,138,0)="  This field will be used to indicate if this procedure is treating "
^DIC(9.4,151,22,1,"PAH",3,1,139,0)="  a VA patient for a problem that is related to Environmental "
^DIC(9.4,151,22,1,"PAH",3,1,140,0)="  Contaminant Exposure.  Data is Y if this patient claims exposure "
^DIC(9.4,151,22,1,"PAH",3,1,141,0)="  to environmental contaminants, N if not, or U if unknown.  "
^DIC(9.4,151,22,1,"PAH",3,1,142,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,143,0)=" Field 24 - SERVICE CONNECTED "
^DIC(9.4,151,22,1,"PAH",3,1,144,0)="  This field will be used to indicate if this procedure is treating "
^DIC(9.4,151,22,1,"PAH",3,1,145,0)="  a VA patient for a service connected problem.  Data is Y if this "
^DIC(9.4,151,22,1,"PAH",3,1,146,0)="  patient is service connected or N if not service connected for this  "
^DIC(9.4,151,22,1,"PAH",3,1,147,0)="  treatment."
^DIC(9.4,151,22,1,"PAH",3,1,148,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,149,0)=" Field 25 - SENT TO PCE "
^DIC(9.4,151,22,1,"PAH",3,1,150,0)="  This field flags data that has been sent from Event Capture to PCE."
^DIC(9.4,151,22,1,"PAH",3,1,151,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,152,0)=" Field 26 - ASSOCIATED CLINIC "
^DIC(9.4,151,22,1,"PAH",3,1,153,0)="  This is the clinic associated with this record.  "
^DIC(9.4,151,22,1,"PAH",3,1,154,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,155,0)=" Field 27 - DSS ID "
^DIC(9.4,151,22,1,"PAH",3,1,156,0)="  The DSS ID, formerly stop code, associated with this patient record."
^DIC(9.4,151,22,1,"PAH",3,1,157,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,158,0)=" Field 28 - VISIT "
^DIC(9.4,151,22,1,"PAH",3,1,159,0)="  This is the visit associated with this patient procedure.  This"
^DIC(9.4,151,22,1,"PAH",3,1,160,0)="  field is a pointer to the VISIT file (#9000010)."
^DIC(9.4,151,22,1,"PAH",3,1,161,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,162,0)=" Field 29 -IN/OUTPATIENT "
^DIC(9.4,151,22,1,"PAH",3,1,163,0)="  The status of the patient when this event occurred. The code ""I"" "
^DIC(9.4,151,22,1,"PAH",3,1,164,0)="  represents an inpatient event or an ""O"" represents an outpatient "
^DIC(9.4,151,22,1,"PAH",3,1,165,0)="  event occurred.  "
^DIC(9.4,151,22,1,"PAH",3,1,166,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,167,0)=" Field 30 - PCE DATA FEED "
^DIC(9.4,151,22,1,"PAH",3,1,168,0)="  The field contains the EC data formatted to feed the Patient Care "
^DIC(9.4,151,22,1,"PAH",3,1,169,0)="  Encounter (PCE) software.  "
^DIC(9.4,151,22,1,"PAH",3,1,170,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,171,0)=" Field 31 - SEND TO PCE "
^DIC(9.4,151,22,1,"PAH",3,1,172,0)="  This flag controls the EC system data that is ready to send to PCE.  "
^DIC(9.4,151,22,1,"PAH",3,1,173,0)="  If this record should be sent to PCE, this flag will be set with a "
^DIC(9.4,151,22,1,"PAH",3,1,174,0)="  date. "
^DIC(9.4,151,22,1,"PAH",3,1,175,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,176,0)=" Field 32 - CHECKOUT D/T "
^DIC(9.4,151,22,1,"PAH",3,1,177,0)="  This field contains the checkout date and time of this procedure.  "
^DIC(9.4,151,22,1,"PAH",3,1,178,0)="  The checkout date and time is generated when the nightly background "
^DIC(9.4,151,22,1,"PAH",3,1,179,0)="  job is run.  "
^DIC(9.4,151,22,1,"PAH",3,1,180,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,181,0)=" Field 33 - REASON"
^DIC(9.4,151,22,1,"PAH",3,1,182,0)="  This field contains the reasons why this patient record was"
^DIC(9.4,151,22,1,"PAH",3,1,183,0)="  not sent to the Patient Care Encounter (PCE) software.  This"
^DIC(9.4,151,22,1,"PAH",3,1,184,0)="  field is automatically populated during the PCE filing"
^DIC(9.4,151,22,1,"PAH",3,1,185,0)="  process."
^DIC(9.4,151,22,1,"PAH",3,1,186,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,187,0)="NEW CROSS REFERENCES:   This patch includes a new MUMPS cross reference"
^DIC(9.4,151,22,1,"PAH",3,1,188,0)="in the EVENT CAPTURE PATIENT file (#721).  The AD cross reference on the"
^DIC(9.4,151,22,1,"PAH",3,1,189,0)="SEND TO PCE field (#31) controls the filing of the data that is ready"
^DIC(9.4,151,22,1,"PAH",3,1,190,0)="for PCE.  "
^DIC(9.4,151,22,1,"PAH",3,1,191,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,192,0)="NEW OPTIONS:  This patch adds two new options to collect, maintain, and"
^DIC(9.4,151,22,1,"PAH",3,1,193,0)="report the data filing to PCE.  "
^DIC(9.4,151,22,1,"PAH",3,1,194,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,195,0)=" Nightly Data Feed to PCE [EC NIGHT] "
^DIC(9.4,151,22,1,"PAH",3,1,196,0)="  This option controls the routine that sends Event Capture data "
^DIC(9.4,151,22,1,"PAH",3,1,197,0)="  to Patient Care Encounter (PCE) software nightly.  The EC system "
^DIC(9.4,151,22,1,"PAH",3,1,198,0)="  data is stored in the EVENT CAPTURE PATIENT file (#721).  EC data "
^DIC(9.4,151,22,1,"PAH",3,1,199,0)="  that has been flagged to send to PCE will be picked and sent when "
^DIC(9.4,151,22,1,"PAH",3,1,200,0)="  this routine is run. This routine should run nightly, therefore "
^DIC(9.4,151,22,1,"PAH",3,1,201,0)="  the rescheduling frequency is 1D.  The time to queue this option "
^DIC(9.4,151,22,1,"PAH",3,1,202,0)="  to run should not conflict with system backup.  "
^DIC(9.4,151,22,1,"PAH",3,1,203,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,204,0)=" PCE Data Summary [ECPCER] "
^DIC(9.4,151,22,1,"PAH",3,1,205,0)="  This option is exported on the Event Capture Reports [ECREPS] menu.  "
^DIC(9.4,151,22,1,"PAH",3,1,206,0)="  This Event Capture data summary lists, by patient, key information "
^DIC(9.4,151,22,1,"PAH",3,1,207,0)="  that has been sent to the Patient Care Encounter (PCE) software.  "
^DIC(9.4,151,22,1,"PAH",3,1,208,0)="  The date and time of the procedure, procedure name listed in PCE, "
^DIC(9.4,151,22,1,"PAH",3,1,209,0)="  volume of procedures sent, CPT and ICD-9 codes, associated clinic "
^DIC(9.4,151,22,1,"PAH",3,1,210,0)="  and DSS ID (formerly stop code), and the provider of care are listed "
^DIC(9.4,151,22,1,"PAH",3,1,211,0)="  on this report.  "
^DIC(9.4,151,22,1,"PAH",3,1,212,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,213,0)="HELP FRAMES:  The following help frame is created.  "
^DIC(9.4,151,22,1,"PAH",3,1,214,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,215,0)="ECPCER "
^DIC(9.4,151,22,1,"PAH",3,1,216,0)="  This Event Capture data summary lists, by patient, key information "
^DIC(9.4,151,22,1,"PAH",3,1,217,0)="  that has been sent to the Patient Care Encounter (PCE) software.  "
^DIC(9.4,151,22,1,"PAH",3,1,218,0)="  The date and time of the procedure, procedure name listed in PCE, "
^DIC(9.4,151,22,1,"PAH",3,1,219,0)="  volume of procedures sent, CPT and ICD-9 codes, associated clinic "
^DIC(9.4,151,22,1,"PAH",3,1,220,0)="  and DSS ID (formerly stop code), and the provider of care are listed "
^DIC(9.4,151,22,1,"PAH",3,1,221,0)="  on this report.  "
^DIC(9.4,151,22,1,"PAH",3,1,222,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,223,0)="SUMMARY OF THE PCE FILING PROCESS: "
^DIC(9.4,151,22,1,"PAH",3,1,224,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,225,0)="Each DSS Unit should be edited to update the SEND TO PCE information."
^DIC(9.4,151,22,1,"PAH",3,1,226,0)="If a DSS Unit is marked to send data to PCE, then when creating new"
^DIC(9.4,151,22,1,"PAH",3,1,227,0)="event code screens within this DSS Unit or editing existing event"
^DIC(9.4,151,22,1,"PAH",3,1,228,0)="code screens defined within this DSS Unit, a new prompt for an"
^DIC(9.4,151,22,1,"PAH",3,1,229,0)="ASSOCIATED CLINIC is displayed."
^DIC(9.4,151,22,1,"PAH",3,1,230,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,231,0)="An associated clinic should be defined for each event code screen"
^DIC(9.4,151,22,1,"PAH",3,1,232,0)="defined for DSS Units marked to send data to PCE.  For entering new"
^DIC(9.4,151,22,1,"PAH",3,1,233,0)="event code screens, use the Event Code Screens (Create) [ECSCREEN]"
^DIC(9.4,151,22,1,"PAH",3,1,234,0)="option. For existing event code screens, use the Procedure"
^DIC(9.4,151,22,1,"PAH",3,1,235,0)="Synonym/Default Volume (Enter/Edit) [ECDSSYN] option.  These"
^DIC(9.4,151,22,1,"PAH",3,1,236,0)="associated clinics will be displayed to users during data entry"
^DIC(9.4,151,22,1,"PAH",3,1,237,0)="processes.  "
^DIC(9.4,151,22,1,"PAH",3,1,238,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,239,0)="The data entry options Enter/Edit Patient Procedures [ECPAT],"
^DIC(9.4,151,22,1,"PAH",3,1,240,0)="Batch Enter Data by Patient [ECBATCH], and Data Entry (Batch)"
^DIC(9.4,151,22,1,"PAH",3,1,241,0)="by Procedure [ECBATCH PROC] are updated to ask users the PCE"
^DIC(9.4,151,22,1,"PAH",3,1,242,0)="required prompts.  The DATE/TIME OF PROCEDURE field (#2) now"
^DIC(9.4,151,22,1,"PAH",3,1,243,0)="requires time as part of every procedure date.  Each patient"
^DIC(9.4,151,22,1,"PAH",3,1,244,0)="record entered must include a diagnosis code (ICD-9), an"
^DIC(9.4,151,22,1,"PAH",3,1,245,0)="inpatient/outpatient indicator, and an active clinic.  Users"
^DIC(9.4,151,22,1,"PAH",3,1,246,0)="manually entering this data must answer diagnosis, determine an"
^DIC(9.4,151,22,1,"PAH",3,1,247,0)="inpatient or outpatient status, and accept the default clinic"
^DIC(9.4,151,22,1,"PAH",3,1,248,0)="or select an active clinic.  If it is an outpatient encounter,"
^DIC(9.4,151,22,1,"PAH",3,1,249,0)="users are also prompted to answer agent orange exposure,"
^DIC(9.4,151,22,1,"PAH",3,1,250,0)="ionizing radiation exposure, environmental contaminants exposure,"
^DIC(9.4,151,22,1,"PAH",3,1,251,0)="and related service connection.  "
^DIC(9.4,151,22,1,"PAH",3,1,252,0)=" "
^DIC(9.4,151,22,1,"PAH",3,1,253,0)="After the PCE prompts are answered, all appropriate patient"
^DIC(9.4,151,22,1,"PAH",3,1,254,0)="records are formatted to file the data with PCE.  This formatted"
^DIC(9.4,151,22,1,"PAH",3,1,255,0)="data string is stored in the PCE DATA FEED field (#30).  The"
^DIC(9.4,151,22,1,"PAH",3,1,256,0)="flag to file this record is then set in the SEND TO PCE field"
^DIC(9.4,151,22,1,"PAH",3,1,257,0)="(#31).  These fields exist in the EVENT CAPTURE PATIENT file"
^DIC(9.4,151,22,1,"PAH",3,1,258,0)="(#721).  The nightly scheduled Nightly Data Feed to PCE [EC NIGHT]"
^DIC(9.4,151,22,1,"PAH",3,1,259,0)="option will file the data with PCE and store a pointer to the"
^DIC(9.4,151,22,1,"PAH",3,1,260,0)="corresponding visit created in the VISIT file (#9000010)."
^DIC(9.4,151,22,1,"PAH",3,1,261,0)="Patient data records that have been filed with PCE and are"
^DIC(9.4,151,22,1,"PAH",3,1,262,0)="later edited or deleted in the EC system will automatically"
^DIC(9.4,151,22,1,"PAH",3,1,263,0)="send an update to PCE. For those records that should be filed"
^DIC(9.4,151,22,1,"PAH",3,1,264,0)="to PCE but are not sent due to missing or incorrect data will"
^DIC(9.4,151,22,1,"PAH",3,1,265,0)="store a reason in the REASON file (#33)."
^DIC(9.4,151,22,1,"PAH",4,0)="6 SEQ #4^2970922^1"
