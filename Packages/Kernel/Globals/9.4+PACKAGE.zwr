^DIC(9.4,111,22,1,"PAH",136,0)="178 SEQ #138^3061122.223457^1"
^DIC(9.4,111,22,1,"PAH",136,1,0)="^^1^1^3061122"
^DIC(9.4,111,22,1,"PAH",136,1,1,0)="Allow entry of duplicate Health Factors per encounter."
^DIC(9.4,111,22,1,"PAH",137,0)="182 SEQ #139^3070904.223226^1"
^DIC(9.4,111,22,1,"PAH",137,1,0)="^^3^3^3070904"
^DIC(9.4,111,22,1,"PAH",137,1,1,0)="Default DX during Appt Check Out.  Also, invalid code when entering "
^DIC(9.4,111,22,1,"PAH",137,1,2,0)="diagnosis for PCE procedures.  Also, if no procedure, only option is to "
^DIC(9.4,111,22,1,"PAH",137,1,3,0)="delete encounter."
^DIC(9.4,111,22,1,"PAH",138,0)="183 SEQ #140^3070905.01^1"
^DIC(9.4,111,22,1,"PAH",138,1,0)="^^10^10^3070905"
^DIC(9.4,111,22,1,"PAH",138,1,1,0)="This patch addresses four issues related to the Patient Care Encounter "
^DIC(9.4,111,22,1,"PAH",138,1,2,0)="(PCE) module that were reported on the Remedy tickets listed below:"
^DIC(9.4,111,22,1,"PAH",138,1,3,0)=" "
^DIC(9.4,111,22,1,"PAH",138,1,4,0)="  1) HD123432 - IBDF UTIL MAINT UTILITY PROBLEM"
^DIC(9.4,111,22,1,"PAH",138,1,5,0)="  2) HD135534 - IB MT NIGHT COMP erroring out with "
^DIC(9.4,111,22,1,"PAH",138,1,6,0)="                <SUBSCRIPT>ENCEVENT+10~PXKENC"
^DIC(9.4,111,22,1,"PAH",138,1,7,0)="  3) HD136528 - Warning on Patient Death - warning displayed with not "
^DIC(9.4,111,22,1,"PAH",138,1,8,0)="                a related patient"
^DIC(9.4,111,22,1,"PAH",138,1,9,0)="  4) HD173398 - Event Capture Issue - update to the User Manual regarding"
^DIC(9.4,111,22,1,"PAH",138,1,10,0)="                 PXCE Data entry functionality"
^DIC(9.4,111,22,1,"PAH",139,0)="188 SEQ #141^3071212.211814^1"
^DIC(9.4,111,22,1,"PAH",139,1,0)="^^2^2^3071212"
^DIC(9.4,111,22,1,"PAH",139,1,1,0)="This patch fixes problems with keep patient data after not selecting a "
^DIC(9.4,111,22,1,"PAH",139,1,2,0)="new patient."
^DIC(9.4,111,22,1,"PAH",140,0)="186^3071212.213209^1"
^DIC(9.4,111,22,1,"PAH",140,1,0)="^^2^2^3071212"
^DIC(9.4,111,22,1,"PAH",140,1,1,0)="Please refer to patch PX*1.0*186 in the National Patch Module for a"
^DIC(9.4,111,22,1,"PAH",140,1,2,0)="complete description of this patch."
^DIC(9.4,111,22,1,"PAH",141,0)="184^3071212.214012^1"
^DIC(9.4,111,22,1,"PAH",141,1,0)="^^2^2^3071212"
^DIC(9.4,111,22,1,"PAH",141,1,1,0)="Please refer to patch PX*1.0*184 in the National Patch Module for a"
^DIC(9.4,111,22,1,"PAH",141,1,2,0)="complete description of this patch."
^DIC(9.4,111,22,1,"PAH",142,0)="190 SEQ #144^3090420.154745^1"
^DIC(9.4,111,22,1,"PAH",142,1,0)="^^10^10^3090420"
^DIC(9.4,111,22,1,"PAH",142,1,1,0)="This patch will fix an undefined variable error which occurs when the "
^DIC(9.4,111,22,1,"PAH",142,1,2,0)="FileMan ENTER OR EDIT FILE ENTRIES option is used to edit a POV (Problem "
^DIC(9.4,111,22,1,"PAH",142,1,3,0)="of Visit used by VA or Purpose of Visit used by IHS) code."
^DIC(9.4,111,22,1,"PAH",142,1,4,0)=" "
^DIC(9.4,111,22,1,"PAH",142,1,5,0)="This patch will also fix a subscript error which occurs when the CPT Code "
^DIC(9.4,111,22,1,"PAH",142,1,6,0)="contains very lengthy ASCII control characters. User was in Appointment "
^DIC(9.4,111,22,1,"PAH",142,1,7,0)="Management [SDAM APPT MGT] going through the checkout process and was "
^DIC(9.4,111,22,1,"PAH",142,1,8,0)="being prompted for a CPT code. At the 'Enter PROCEDURE (CPT CODE): ' "
^DIC(9.4,111,22,1,"PAH",142,1,9,0)="prompt, the user input 99456 but then pressed and hold the <TAB> key long"
^DIC(9.4,111,22,1,"PAH",142,1,10,0)="enough to fill up about a screen, then hit <ENTER> key."
^DIC(9.4,111,22,1,"PAH",143,0)="185 SEQ #145^3090421.14084^17"
^DIC(9.4,111,22,1,"PAH",143,1,0)="^^4^4^3090421"
^DIC(9.4,111,22,1,"PAH",143,1,1,0)="Change field #.08 in the Health Factors file (9999999.64) to a required "
^DIC(9.4,111,22,1,"PAH",143,1,2,0)="field.  Also, add a warning message for PCE Health Factors to let users "
^DIC(9.4,111,22,1,"PAH",143,1,3,0)="know when a Health Factor is not set up to display on a Health Summary"
^DIC(9.4,111,22,1,"PAH",143,1,4,0)="report."
^DIC(9.4,111,22,1,"PAH",144,0)="168^3090423.1341^17"
^DIC(9.4,111,22,1,"PAH",145,0)="193 SEQ #147^3090715.122345^17"
^DIC(9.4,111,22,1,"PAH",145,1,0)="^^3^3^3090715"
^DIC(9.4,111,22,1,"PAH",145,1,1,0)="This patch fixes the sequence numbers of the Education Subtopic out of "
^DIC(9.4,111,22,1,"PAH",145,1,2,0)="order and word wrapping problems for the Goals and Standards of the"
^DIC(9.4,111,22,1,"PAH",145,1,3,0)="Education Topics."
^DIC(9.4,111,22,1,"PAH",146,0)="195 SEQ #148^3100105.170001^17"
^DIC(9.4,111,22,1,"PAH",146,1,0)="^^5^5^3100105"
^DIC(9.4,111,22,1,"PAH",146,1,1,0)="This patch addresses the problem where a date and time is missing when "
^DIC(9.4,111,22,1,"PAH",146,1,2,0)="validates the status of the Diagnosis Code."
^DIC(9.4,111,22,1,"PAH",146,1,3,0)=" "
^DIC(9.4,111,22,1,"PAH",146,1,4,0)="This patch will also update the CREATED BY USER (#.23) field description "
^DIC(9.4,111,22,1,"PAH",146,1,5,0)="of the Visit (#9000010) file to reflect the current functionality."
^DIC(9.4,111,22,1,"PAH",147,0)="189 SEQ #149^3100217.121904^17"
^DIC(9.4,111,22,1,"PAH",147,1,0)="^^15^15^3100217"
^DIC(9.4,111,22,1,"PAH",147,1,1,0)="This patch will change the existing code for the Caseload Profile by "
^DIC(9.4,111,22,1,"PAH",147,1,2,0)="Clinic [PXRR CASELOAD PROFILE BY CL] report to remove the existing direct"
^DIC(9.4,111,22,1,"PAH",147,1,3,0)="global read, so data is now pulled from the PXRMINDX index."
^DIC(9.4,111,22,1,"PAH",147,1,4,0)=" "
^DIC(9.4,111,22,1,"PAH",147,1,5,0)="The second item this patch will modify is the report logic to display"
^DIC(9.4,111,22,1,"PAH",147,1,6,0)="historical encounters that with no Loc. of Encounter (#.06) field"
^DIC(9.4,111,22,1,"PAH",147,1,7,0)="populated in the Visit (#9000010) file when running the report Provider"
^DIC(9.4,111,22,1,"PAH",147,1,8,0)="Encounter Counts [PXRR PROVIDER ENCOUNTER COUNTS] and selecting Service"
^DIC(9.4,111,22,1,"PAH",147,1,9,0)="Category ""EVENT (HISTORICAL)"", it returns very few or no encounters. "
^DIC(9.4,111,22,1,"PAH",147,1,10,0)="Encounters occurred at Non-VA sites will be included in the report as "
^DIC(9.4,111,22,1,"PAH",147,1,11,0)="well."
^DIC(9.4,111,22,1,"PAH",147,1,12,0)=" "
^DIC(9.4,111,22,1,"PAH",147,1,13,0)="The last item this patch will fix is an 'O' displayed after accepting the "
^DIC(9.4,111,22,1,"PAH",147,1,14,0)="default value N from a prompt when running the Provider Encounter Counts "
^DIC(9.4,111,22,1,"PAH",147,1,15,0)="report."
^DIC(9.4,111,22,1,"PAH",148,0)="194 SEQ #150^3101115.104441^17"
^DIC(9.4,111,22,1,"PAH",148,1,0)="^^4^4^3101115"
^DIC(9.4,111,22,1,"PAH",148,1,1,0)="This patch addresses the upcoming deletion of unsupported fields in the"
^DIC(9.4,111,22,1,"PAH",148,1,2,0)="ICD Diagnosis File, #80, and the CPT File, #81. Modifications are being"
^DIC(9.4,111,22,1,"PAH",148,1,3,0)="made to affected Patient Care Encounter routines to replace unsupported"
^DIC(9.4,111,22,1,"PAH",148,1,4,0)="calls to the deleted data fields with the appropriate supported API."
^DIC(9.4,111,22,1,"PAH",149,0)="197 SEQ #151^3110823.144444^17"
^DIC(9.4,111,22,1,"PAH",149,1,0)="^^3^3^3110823"
^DIC(9.4,111,22,1,"PAH",149,1,1,0)=" This patch will prevent the credit stop visit entry from being "
^DIC(9.4,111,22,1,"PAH",149,1,2,0)="deleted when the primary visit receives a request to delete ""ALL"""
^DIC(9.4,111,22,1,"PAH",149,1,3,0)="entries while the visit is associated with an appointment."
^DIC(9.4,111,22,1,"PAH",150,0)="203 SEQ #152^3140618.123249^17"
^DIC(9.4,111,22,1,"PAH",151,0)="199 SEQ #153^3140805.163625^17"
^DIC(9.4,111,22,1,"PAH",151,1,0)="^^3^3^3140805"
^DIC(9.4,111,22,1,"PAH",151,1,1,0)="ICD-10 REMEDIATION "
^DIC(9.4,111,22,1,"PAH",151,1,2,0)="This patch distributes the necessary components of PCE to allow"
^DIC(9.4,111,22,1,"PAH",151,1,3,0)="for the transition to the ICD-10-CM diagnosis coding system."
^DIC(9.4,111,22,1,"PAH",152,0)="200 SEQ #154^3140915.095248^17"
^DIC(9.4,111,22,1,"PAH",152,1,0)="^^1^1^3140915"
^DIC(9.4,111,22,1,"PAH",152,1,1,0)="See patch description."
^DIC(9.4,111,22,1,"PAH",153,0)="201^3141201.154847^17"
^DIC(9.4,111,22,1,"PAH",153,1,0)="^^15^15^3141201"
^DIC(9.4,111,22,1,"PAH",153,1,1,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,111,22,1,"PAH",153,1,2,0)="(VistA) Immunizations Enhancements (VIMM) 1.0 project modifies existing"
^DIC(9.4,111,22,1,"PAH",153,1,3,0)="immunization files and adds additional files to enable VA to quickly and"
^DIC(9.4,111,22,1,"PAH",153,1,4,0)="reliably document and exchange standardized immunization information on"
^DIC(9.4,111,22,1,"PAH",153,1,5,0)="beneficiaries across services and departments. Additionally, modifications"
^DIC(9.4,111,22,1,"PAH",153,1,6,0)="support Certification for Meaningful Use as well as VistA Evolution"
^DIC(9.4,111,22,1,"PAH",153,1,7,0)="requirements. This provides a Veteran patient-centric vaccine record"
^DIC(9.4,111,22,1,"PAH",153,1,8,0)="exchangeable with the external community. Clinicians will have access to a"
^DIC(9.4,111,22,1,"PAH",153,1,9,0)="more complete medical history in the VistA electronic medical record"
^DIC(9.4,111,22,1,"PAH",153,1,10,0)="resulting in improved health status as well as public health monitoring."
^DIC(9.4,111,22,1,"PAH",153,1,11,0)=" "
^DIC(9.4,111,22,1,"PAH",153,1,12,0)="The goals for the VIMM 1.0 project are to deliver an Initial Operating"
^DIC(9.4,111,22,1,"PAH",153,1,13,0)="Capability comprised of standard, interoperable immunization data for"
^DIC(9.4,111,22,1,"PAH",153,1,14,0)="exchange with external trading partners based on the modernization of"
^DIC(9.4,111,22,1,"PAH",153,1,15,0)="the VistA Patient Care Encounter (PCE) package."
^DIC(9.4,111,22,1,"PAH",154,0)="204 SEQ #156^3141215.121624^17"
^DIC(9.4,111,22,1,"PAH",154,1,0)="^^4^4^3141215"
^DIC(9.4,111,22,1,"PAH",154,1,1,0)="Patch PX*1*204 addresses the following Patient Care Encounter issues:"
^DIC(9.4,111,22,1,"PAH",154,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",154,1,3,0)=" 1. ADD+3^AUPNVSIT errors."
^DIC(9.4,111,22,1,"PAH",154,1,4,0)=" 2. EVISITDT+23^PXCEVSIT error."
^DIC(9.4,111,22,1,"PAH",155,0)="208 SEQ #157^3150427.173933^17"
^DIC(9.4,111,22,1,"PAH",155,1,0)="^^4^4^3150427"
^DIC(9.4,111,22,1,"PAH",155,1,1,0)="Patch PX*1.0*208 addresses the following issue:"
^DIC(9.4,111,22,1,"PAH",155,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",155,1,3,0)="- Series, reaction, and contraindicated values may not get filed into a"
^DIC(9.4,111,22,1,"PAH",155,1,4,0)="patient's immunization record."
^DIC(9.4,111,22,1,"PAH",156,0)="205 SEQ #158^3150519.121139^17"
^DIC(9.4,111,22,1,"PAH",156,1,0)="^^5^5^3150519"
^DIC(9.4,111,22,1,"PAH",156,1,1,0)="Patch PX*1*205 addresses the following Patient Care Encounter issues:"
^DIC(9.4,111,22,1,"PAH",156,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",156,1,3,0)=" 1. AUDIT+9^PXQFV errors"
^DIC(9.4,111,22,1,"PAH",156,1,4,0)=" 2. OCC+40^PXBGPRV errors"
^DIC(9.4,111,22,1,"PAH",156,1,5,0)=" 3. No CHECK for non-unique names on editing Health Factors"
^DIC(9.4,111,22,1,"PAH",157,0)="209 SEQ #159^3150916.111117^17"
^DIC(9.4,111,22,1,"PAH",158,0)="206^3150916.120218^17"
^DIC(9.4,111,22,1,"PAH",158,1,0)="^^15^15^3150916"
^DIC(9.4,111,22,1,"PAH",158,1,1,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,111,22,1,"PAH",158,1,2,0)="(VistA) Immunizations Enhancements (VIMM) 2.0 project modifies existing"
^DIC(9.4,111,22,1,"PAH",158,1,3,0)="Skin Test files and adds additional files to enable VA to quickly and"
^DIC(9.4,111,22,1,"PAH",158,1,4,0)="reliably document and exchange standardized skin test and immunization"
^DIC(9.4,111,22,1,"PAH",158,1,5,0)="information on beneficiaries across services and departments."
^DIC(9.4,111,22,1,"PAH",158,1,6,0)="Additionally, modifications support VistA Evolution requirements. This"
^DIC(9.4,111,22,1,"PAH",158,1,7,0)="provides a Veteran patient-centric vaccine record exchangeable with the"
^DIC(9.4,111,22,1,"PAH",158,1,8,0)="external community. Clinicians will have access to a more complete medical"
^DIC(9.4,111,22,1,"PAH",158,1,9,0)="history in the VistA electronic medical record resulting in improved"
^DIC(9.4,111,22,1,"PAH",158,1,10,0)="health status as well as public health monitoring."
^DIC(9.4,111,22,1,"PAH",158,1,11,0)=" "
^DIC(9.4,111,22,1,"PAH",158,1,12,0)="The goals for the VIMM 2.0 project are to deliver an Initial Operating"
^DIC(9.4,111,22,1,"PAH",158,1,13,0)="Capability comprised of standard, interoperable skin test and immunization"
^DIC(9.4,111,22,1,"PAH",158,1,14,0)="data for exchange with external trading partners based on the"
^DIC(9.4,111,22,1,"PAH",158,1,15,0)="modernization of the VistA Patient Care Encounter (PCE) package."
^DIC(9.4,111,22,1,"PAH",159,0)="210 SEQ #161^3160310.171053^54"
^DIC(9.4,111,22,1,"PAH",159,1,0)="^^7^7^3160310"
^DIC(9.4,111,22,1,"PAH",159,1,1,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,111,22,1,"PAH",159,1,2,0)="(VistA) Immunizations Enhancements (VIMM) 2.0 project, Increment 2, "
^DIC(9.4,111,22,1,"PAH",159,1,3,0)="builds upon the file structures and standardized data introduced by "
^DIC(9.4,111,22,1,"PAH",159,1,4,0)="Increment 1 by adding functional enhancements to the existing VistA "
^DIC(9.4,111,22,1,"PAH",159,1,5,0)="Patient Care Encounter (PCE) package."
^DIC(9.4,111,22,1,"PAH",159,1,6,0)=" "
^DIC(9.4,111,22,1,"PAH",159,1,7,0)="See the National Patch Module for a more detailed description."
^DIC(9.4,111,22,1,"PAH",160,0)="212 SEQ #162^3160531.141423^54"
^DIC(9.4,111,22,1,"PAH",160,1,0)="^^6^6^3160531"
^DIC(9.4,111,22,1,"PAH",160,1,1,0)="Patch PX*1.0*212 addresses the following issues:"
^DIC(9.4,111,22,1,"PAH",160,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",160,1,3,0)="- Data Dictionary technical description misspells classification in"
^DIC(9.4,111,22,1,"PAH",160,1,4,0)="the VISIT file [#9000010]"
^DIC(9.4,111,22,1,"PAH",160,1,5,0)="- References to SHORT NAME field [#2] of the CPT file [#81] need to be "
^DIC(9.4,111,22,1,"PAH",160,1,6,0)="removed."
^DIC(9.4,111,22,1,"PAH",161,0)="215 SEQ #163^3161118.171252^54"
^DIC(9.4,111,22,1,"PAH",161,1,0)="^^5^5^3161118"
^DIC(9.4,111,22,1,"PAH",161,1,1,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,111,22,1,"PAH",161,1,2,0)="(VistA) Immunizations Enhancements (VIMM) 2.0 project, Increment 3, builds"
^DIC(9.4,111,22,1,"PAH",161,1,3,0)="upon the file structures and standardized data introduced in Increments 1"
^DIC(9.4,111,22,1,"PAH",161,1,4,0)="and 2 by adding functional enhancements to the existing VistA Patient Care"
^DIC(9.4,111,22,1,"PAH",161,1,5,0)="Encounter (PCE) package."
^DIC(9.4,111,22,1,"PAH",162,0)="216 SEQ #164^3161118.172231^54"
^DIC(9.4,111,22,1,"PAH",162,1,0)="^^5^5^3161118"
^DIC(9.4,111,22,1,"PAH",162,1,1,0)="The Veterans Health Information Systems and Technology Architecture"
^DIC(9.4,111,22,1,"PAH",162,1,2,0)="(VistA) Immunizations Enhancements (VIMM) 2.0 project, Increment 4, builds"
^DIC(9.4,111,22,1,"PAH",162,1,3,0)="upon the file structures and standardized data introduced in Increments 1,"
^DIC(9.4,111,22,1,"PAH",162,1,4,0)="2 and 3 by adding functional enhancements to the existing VistA Patient"
^DIC(9.4,111,22,1,"PAH",162,1,5,0)="Care Encounter (PCE) package."
^DIC(9.4,111,22,1,"PAH",163,0)="219 SEQ #165^3171227.16301^54"
^DIC(9.4,111,22,1,"PAH",163,1,0)="^^15^15^3171227"
^DIC(9.4,111,22,1,"PAH",163,1,1,0)="This patch will fix 2 issues:"
^DIC(9.4,111,22,1,"PAH",163,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",163,1,3,0)="1. A user can select an end date prior to a start date within the PXCE"
^DIC(9.4,111,22,1,"PAH",163,1,4,0)="Options:"
^DIC(9.4,111,22,1,"PAH",163,1,5,0)="  PCE Encounter Data Entry [PXCE ENCOUNTER DATA ENTRY]"
^DIC(9.4,111,22,1,"PAH",163,1,6,0)="  PCE Encounter Data Entry and Delete [PXCE ENCOUNTER ENTRY & DELETE]"
^DIC(9.4,111,22,1,"PAH",163,1,7,0)="  PCE Encounter Data Entry without Delete [PXCE ENCOUNTER ENTRY NO DELETE]"
^DIC(9.4,111,22,1,"PAH",163,1,8,0)="  PCE Encounter Data Entry - Supervisor [PXCE ENCOUNTER ENTRY SUPER]"
^DIC(9.4,111,22,1,"PAH",163,1,9,0)="  PCE Encounter Viewer [PXCE ENCOUNTER VIEWER]"
^DIC(9.4,111,22,1,"PAH",163,1,10,0)="and the application will switch the dates to make logical sense but gives"
^DIC(9.4,111,22,1,"PAH",163,1,11,0)="no indication to the user. "
^DIC(9.4,111,22,1,"PAH",163,1,12,0)=" "
^DIC(9.4,111,22,1,"PAH",163,1,13,0)="2. User requests to have the user manual updated for the Patient Care "
^DIC(9.4,111,22,1,"PAH",163,1,14,0)="Encounter (PCE) VistA application to add the option PCE\SD Debugging"
^DIC(9.4,111,22,1,"PAH",163,1,15,0)="Utilities [PXQ PCE/SD DEBUGGING UTILITIES] back into the document."
^DIC(9.4,111,22,1,"PAH",164,0)="220 SEQ #166^3180706.14481^54"
^DIC(9.4,111,22,1,"PAH",164,1,0)="^^2^2^3180706"
^DIC(9.4,111,22,1,"PAH",164,1,1,0)="This patch resolves potential runtime errors when $$OCCUP^PXBGPRV is run "
^DIC(9.4,111,22,1,"PAH",164,1,2,0)="with an invalid provider passed in."
^DIC(9.4,111,22,1,"PAH",165,0)="222 SEQ #167^3190103.162346^54"
^DIC(9.4,111,22,1,"PAH",165,1,0)="^^2^2^3190103"
^DIC(9.4,111,22,1,"PAH",165,1,1,0)="This patch prevents an <UNDEFINED> error from occurring when PXRRECSE "
^DIC(9.4,111,22,1,"PAH",165,1,2,0)="attempts to sort corrupt data identified by an invalid x-ref."
^DIC(9.4,111,22,1,"PAH",166,0)="225 SEQ #168^3200819.112228^65"
^DIC(9.4,111,22,1,"PAH",166,1,0)="^^2^2^3200819"
^DIC(9.4,111,22,1,"PAH",166,1,1,0)="This patch updates local entries that have no Vaccine Administered (CVX) "
^DIC(9.4,111,22,1,"PAH",166,1,2,0)="code mapped in the IMMUNIZATION file (#9999999.14)."
^DIC(9.4,111,22,1,"PAH",167,0)="211^3210504.155729^17"
^DIC(9.4,111,22,1,"PAH",167,1,0)="^^11^11^3210504"
^DIC(9.4,111,22,1,"PAH",167,1,1,0)="PCE data standardization, for detailed information and installation"
^DIC(9.4,111,22,1,"PAH",167,1,2,0)="instructions, please see the PCE Standardization 1.0 Installation Guide."
^DIC(9.4,111,22,1,"PAH",167,1,3,0)=""
^DIC(9.4,111,22,1,"PAH",167,1,4,0)="To take full advantage of the PCE standardization work, changes to VistA"
^DIC(9.4,111,22,1,"PAH",167,1,5,0)="applications that use PCE data are required. These applications include"
^DIC(9.4,111,22,1,"PAH",167,1,6,0)="Clinical Reminders, Health Summary, Problem List, and Order Entry/Results"
^DIC(9.4,111,22,1,"PAH",167,1,7,0)="Reporting. To make it easier for sites, the builds for PCE (PX*1.0*211),"
^DIC(9.4,111,22,1,"PAH",167,1,8,0)="Clinical Reminders (PXRM*2.0*42), Health Summary (GMTS*2.7*122), Problem List"
^DIC(9.4,111,22,1,"PAH",167,1,9,0)="(GMPL*2.0*53), and Order Entry/Results Reporting (OR*3.0*501) are being"
^DIC(9.4,111,22,1,"PAH",167,1,10,0)="distributed in a multi-package build named PCE STANDARDIZATION 1.0."
^DIC(9.4,111,22,1,"PAH",167,1,11,0)=""
^DIC(9.4,111,22,1,"PAH",168,0)="227b^3210512"
^DIC(9.4,111,22,1,"PAH",168,1,0)="^^5^5^3210512"
^DIC(9.4,111,22,1,"PAH",168,1,1,0)="Backup of SD*5.3*777, PX*1.0*227 on May 12, 2021"
^DIC(9.4,111,22,1,"PAH",168,1,2,0)=" "
^DIC(9.4,111,22,1,"PAH",168,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,111,22,1,"PAH",168,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,111,22,1,"PAH",168,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,111,22,1,"PAH",169,0)="227^3210512.15165^17"
^DIC(9.4,111,22,1,"PAH",169,1,0)="^^2^2^3210512"
^DIC(9.4,111,22,1,"PAH",169,1,1,0)="Patient Care Encounter (PCE) patch PX*1.0*227 modifies the software to"
^DIC(9.4,111,22,1,"PAH",169,1,2,0)="account for Blue Water Navy changes introduced in patch DG*5.3*1018."
^DIC(9.4,111,22,1,"PAH",170,0)="228^3211104.093822^17"
^DIC(9.4,111,22,1,"PAH",170,1,0)="^^17^17^3211104"
^DIC(9.4,111,22,1,"PAH",170,1,1,0)="The documentation for DATA2PCE describes two ways to mark a diagnosis as "
^DIC(9.4,111,22,1,"PAH",170,1,2,0)="primary:"
^DIC(9.4,111,22,1,"PAH",170,1,3,0)=" "
^DIC(9.4,111,22,1,"PAH",170,1,4,0)="(""DX/PL"",i,""PRIMARY"")"
^DIC(9.4,111,22,1,"PAH",170,1,5,0)=" "
^DIC(9.4,111,22,1,"PAH",170,1,6,0)="Code that specifies that the diagnosis is the ""primary"" diagnosis for "
^DIC(9.4,111,22,1,"PAH",170,1,7,0)="this encounter. Only one ""primary"" diagnosis is"
^DIC(9.4,111,22,1,"PAH",170,1,8,0)="recorded for each encounter"
^DIC(9.4,111,22,1,"PAH",170,1,9,0)=" "
^DIC(9.4,111,22,1,"PAH",170,1,10,0)="""P""::=Primary"
^DIC(9.4,111,22,1,"PAH",170,1,11,0)="""S""::=Secondary"
^DIC(9.4,111,22,1,"PAH",170,1,12,0)="Alternatively"
^DIC(9.4,111,22,1,"PAH",170,1,13,0)="1::=Primary"
^DIC(9.4,111,22,1,"PAH",170,1,14,0)="0::=Secondary"
^DIC(9.4,111,22,1,"PAH",170,1,15,0)=" "
^DIC(9.4,111,22,1,"PAH",170,1,16,0)="There was a bug that prevented the ""P"" from working, patch PX*1*228 fixes "
^DIC(9.4,111,22,1,"PAH",170,1,17,0)="that bug."
^DIC(9.4,111,22,1,"PAH",171,0)="229 SEQ #172^3220103.124243^17"
^DIC(9.4,111,22,1,"PAH",171,1,0)="^^1^1^3220103"
^DIC(9.4,111,22,1,"PAH",171,1,1,0)="This patch fixes a CPT code incorrect display issue."
^DIC(9.4,111,22,1,"PAH",172,0)="230 SEQ #173^3220503.112101^86"
^DIC(9.4,111,22,1,"PAH",172,1,0)="^^2^2^3220503"
^DIC(9.4,111,22,1,"PAH",172,1,1,0)="Patient Care Encounter (PCE) patch PX*1.0*230 corrects an issue"
^DIC(9.4,111,22,1,"PAH",172,1,2,0)="with duplicate CPT code entries for encounters."
^DIC(9.4,111,22,1,"PAH",173,0)="231 SEQ #174^3220811.151627^86"
^DIC(9.4,111,22,1,"PAH",174,0)="217^3221005.145507^89"
^DIC(9.4,111,22,1,"PAH",174,1,0)="^^1^1^3221005"
^DIC(9.4,111,22,1,"PAH",174,1,1,0)="PX ICE WEB (RPC, ROUTINES, FILE and XPAR)"
^DIC(9.4,111,22,1,"PAH",175,0)="233^3230228.130742^89"
^DIC(9.4,111,22,1,"PAH",176,0)="232 SEQ #177^3230523.093825^89"
^DIC(9.4,111,22,1,"PAH",176,1,0)="^^3^3^3230523"
^DIC(9.4,111,22,1,"PAH",176,1,1,0)="Patch PX*1.0*232 addresses an issue where the CPT code is being displayed"
^DIC(9.4,111,22,1,"PAH",176,1,2,0)="in internal format and causing an error message to display making it"
^DIC(9.4,111,22,1,"PAH",176,1,3,0)="unselectable."
^DIC(9.4,111,22,1,"PAH",177,0)="234 SEQ #178^3230706.155327^89"
^DIC(9.4,111,22,1,"PAH",177,1,0)="^^3^3^3230706"
^DIC(9.4,111,22,1,"PAH",177,1,1,0)="The purpose of this patch is to repair corrupted V HEALTH FACTORS "
^DIC(9.4,111,22,1,"PAH",177,1,2,0)="measurements. A complete description can be found in the Forum patch "
^DIC(9.4,111,22,1,"PAH",177,1,3,0)="module entry of this patch."
^DIC(9.4,111,22,1,"PAH",178,0)="236^3231026.094606^89"
^DIC(9.4,111,22,1,"PAH",178,1,0)="^^2^2^3231026"
^DIC(9.4,111,22,1,"PAH",178,1,1,0)="Refer to the patch description for an explanation of the changes included "
^DIC(9.4,111,22,1,"PAH",178,1,2,0)="in this patch."
^DIC(9.4,111,22,1,"PAH",179,0)="235 SEQ #180^3240102.144139^89"
^DIC(9.4,111,22,1,"PAH",180,0)="238^3240808.173421^89"
^DIC(9.4,111,22,1,"PAH",181,0)="240^3241030.124512^89"
^DIC(9.4,111,22,1,"PAH",182,0)="248 SEQ #183^3250430.095547^90"
^DIC(9.4,111,22,1,"PAH",183,0)="241^3251118.152808^90"
^DIC(9.4,111,22,1,"PAH",184,0)="246^3260327.103932^90"
^DIC(9.4,111,22,1,"PAH",185,0)="247^3260327.111838^90"
^DIC(9.4,111,22,1,"PAH",186,0)="244^3260508.090033^90"
^DIC(9.4,111,22,1,"PAH",186,1,0)="^^2^2^3260508"
^DIC(9.4,111,22,1,"PAH",186,1,1,0)="This patch is part of the CPRS v33CON combined build. Please see the "
^DIC(9.4,111,22,1,"PAH",186,1,2,0)="National Patch Module entry for more information."
