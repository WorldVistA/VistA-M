^DIC(9.4,60,22,13,"PAH",602,1,91,0)="-----------------------"
^DIC(9.4,60,22,13,"PAH",602,1,92,0)="New Service Requests (NSRs): N/A "
^DIC(9.4,60,22,13,"PAH",602,1,93,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,94,0)="Patient Safety Issues (PSIs): "
^DIC(9.4,60,22,13,"PAH",602,1,95,0)="-----------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,96,0)="N/A "
^DIC(9.4,60,22,13,"PAH",602,1,97,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,98,0)="Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,60,22,13,"PAH",602,1,99,0)="============================================"
^DIC(9.4,60,22,13,"PAH",602,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,101,0)="1. (HDSO-7262) New eRx RX CHANGE REQUEST user interface"
^DIC(9.4,60,22,13,"PAH",602,1,102,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,103,0)="   The current eRx Change Request (EC) is being significantly improved to "
^DIC(9.4,60,22,13,"PAH",602,1,104,0)="   facilitate the submission of RX CHANGE REQUEST messages to the prescriber."
^DIC(9.4,60,22,13,"PAH",602,1,105,0)="   Below is a list of modifications delivered in this patch: "
^DIC(9.4,60,22,13,"PAH",602,1,106,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,107,0)="   a)When the user selects the CHANGE REQUEST CODE D - DUE (Drug Use "
^DIC(9.4,60,22,13,"PAH",602,1,108,0)="     Evaluation), they will be prompt to select a CHANGE REQUEST SUB-CODE as "
^DIC(9.4,60,22,13,"PAH",602,1,109,0)="     shown below: "
^DIC(9.4,60,22,13,"PAH",602,1,110,0)="     . . ."
^DIC(9.4,60,22,13,"PAH",602,1,111,0)="        Select one of the following: "
^DIC(9.4,60,22,13,"PAH",602,1,112,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,113,0)="            D         DUE (Drug Use Evaluation) "
^DIC(9.4,60,22,13,"PAH",602,1,114,0)="            G         Generic Substitution "
^DIC(9.4,60,22,13,"PAH",602,1,115,0)="            OS        Out of Stock "
^DIC(9.4,60,22,13,"PAH",602,1,116,0)="            P         Prior Authorization Required "
^DIC(9.4,60,22,13,"PAH",602,1,117,0)="            S         Script Clarification "
^DIC(9.4,60,22,13,"PAH",602,1,118,0)="            T         Therapeutic Interchange/Substitution "
^DIC(9.4,60,22,13,"PAH",602,1,119,0)="            U         Prescriber Authorization "
^DIC(9.4,60,22,13,"PAH",602,1,120,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,121,0)="      CHANGE REQUEST CODE: d  DUE (Drug Use Evaluation) "
^DIC(9.4,60,22,13,"PAH",602,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,123,0)="        Select one of the following: "
^DIC(9.4,60,22,13,"PAH",602,1,124,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,125,0)="          AR - Adverse Drug Reaction "
^DIC(9.4,60,22,13,"PAH",602,1,126,0)="          DA - Drug-Allergy "
^DIC(9.4,60,22,13,"PAH",602,1,127,0)="          DD - Drug-Drug Interaction "
^DIC(9.4,60,22,13,"PAH",602,1,128,0)="          DI - Drug Incompatibility "
^DIC(9.4,60,22,13,"PAH",602,1,129,0)="          DR - Dose Range Conflict "
^DIC(9.4,60,22,13,"PAH",602,1,130,0)="          HD - High Dose "
^DIC(9.4,60,22,13,"PAH",602,1,131,0)="          ID - Ingredient Duplication "
^DIC(9.4,60,22,13,"PAH",602,1,132,0)="          LD - Low Dose "
^DIC(9.4,60,22,13,"PAH",602,1,133,0)="          MS - Missing Information/Clarification "
^DIC(9.4,60,22,13,"PAH",602,1,134,0)="          PS - Product Selection Opportunity "
^DIC(9.4,60,22,13,"PAH",602,1,135,0)="          SX - Drug-Gender "
^DIC(9.4,60,22,13,"PAH",602,1,136,0)="          TD - Therapeutic "
^DIC(9.4,60,22,13,"PAH",602,1,137,0)="          TP - Payer/Processor "
^DIC(9.4,60,22,13,"PAH",602,1,138,0)="          UD - Duplicate Drug "
^DIC(9.4,60,22,13,"PAH",602,1,139,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,140,0)="         Type '?' for the full list. "
^DIC(9.4,60,22,13,"PAH",602,1,141,0)="     . . ."
^DIC(9.4,60,22,13,"PAH",602,1,142,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,143,0)="   b)The code G - Generic Substitution will always be available for selection "
^DIC(9.4,60,22,13,"PAH",602,1,144,0)="     and in case the user selects this code for an eRx that already allows "
^DIC(9.4,60,22,13,"PAH",602,1,145,0)="     substitution the following message will display: "
^DIC(9.4,60,22,13,"PAH",602,1,146,0)="     . . .       "
^DIC(9.4,60,22,13,"PAH",602,1,147,0)="     CHANGE REQUEST CODE: G  Generic Substitution "
^DIC(9.4,60,22,13,"PAH",602,1,148,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,149,0)="       Substitutions are already allowed by prescriber for this eRx.  "
^DIC(9.4,60,22,13,"PAH",602,1,150,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,151,0)="     CHANGE REQUEST CODE: "
^DIC(9.4,60,22,13,"PAH",602,1,152,0)="     . . ."
^DIC(9.4,60,22,13,"PAH",602,1,153,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,154,0)="   c)A new field called NOTE TO PROVIDER will be presented to the user after "
^DIC(9.4,60,22,13,"PAH",602,1,155,0)="     the code (and sub-code) is answered. It's a word-processing field and it"
^DIC(9.4,60,22,13,"PAH",602,1,156,0)="     will be pre-populated for most codes/sub-codes selected with a "
^DIC(9.4,60,22,13,"PAH",602,1,157,0)="     pre-defined template text. Some pre-defined texts contains place holders"
^DIC(9.4,60,22,13,"PAH",602,1,158,0)="     such as [ADD_TEXT_HERE] and [DRUG_NAME] that must be replaced with the "
^DIC(9.4,60,22,13,"PAH",602,1,159,0)="     actual information before proceeding.  "
^DIC(9.4,60,22,13,"PAH",602,1,160,0)="     . . ."
^DIC(9.4,60,22,13,"PAH",602,1,161,0)="     CHANGE REQUEST CODE: s  Script Clarification "
^DIC(9.4,60,22,13,"PAH",602,1,162,0)="   "
^DIC(9.4,60,22,13,"PAH",602,1,163,0)="    =[ WRAP ]=[INSERT ]======< NOTE TO PROVIDER >=[Press <PF1>H for help]===="
^DIC(9.4,60,22,13,"PAH",602,1,164,0)="    The eRx is missing or unclear on [ADD_TEXT_HERE], Please edit and respond"
^DIC(9.4,60,22,13,"PAH",602,1,165,0)="    or cancel Rx and send a new prescription with the requested information. "
^DIC(9.4,60,22,13,"PAH",602,1,166,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,167,0)="    =======T=======T=======T=======T=======T=======T=======T=======T=======T="
^DIC(9.4,60,22,13,"PAH",602,1,168,0)="    Saving Text...  "
^DIC(9.4,60,22,13,"PAH",602,1,169,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,170,0)="    The place holder [ADD_TEXT_HERE] must be replaced before proceeding.  "
^DIC(9.4,60,22,13,"PAH",602,1,171,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,172,0)="    Press Return to continue: "
^DIC(9.4,60,22,13,"PAH",602,1,173,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,174,0)="    =[ WRAP ]=[INSERT ]======< NOTE TO PROVIDER >=[Press <PF1>H for help]===="
^DIC(9.4,60,22,13,"PAH",602,1,175,0)="    The eRx is missing or unclear on [ADD_TEXT_HERE], Please edit and respond"
^DIC(9.4,60,22,13,"PAH",602,1,176,0)="    or cancel Rx and send a new prescription with the requested information."
^DIC(9.4,60,22,13,"PAH",602,1,177,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,178,0)="    =======T=======T=======T=======T=======T=======T=======T=======T=======T="
^DIC(9.4,60,22,13,"PAH",602,1,179,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,180,0)="   d)Users will now be allowed to send more than one change request for the "
^DIC(9.4,60,22,13,"PAH",602,1,181,0)="     same eRx. The software will inform the user that one (or more) Change "
^DIC(9.4,60,22,13,"PAH",602,1,182,0)="     Request(s) has already been sent for the eRx right after they select EC"
^DIC(9.4,60,22,13,"PAH",602,1,183,0)="     (eRx Change Request) and will allow them to proceed, as shown below: "
^DIC(9.4,60,22,13,"PAH",602,1,184,0)="    "
^DIC(9.4,60,22,13,"PAH",602,1,185,0)="        2 Rx Change Requests have already been sent for this eRx.  "
^DIC(9.4,60,22,13,"PAH",602,1,186,0)="  "
^DIC(9.4,60,22,13,"PAH",602,1,187,0)="   e)Users will be able to enter up to 9 different drug suggestions, before"
^DIC(9.4,60,22,13,"PAH",602,1,188,0)="     it was limited to a maximum 3 entries.  "
^DIC(9.4,60,22,13,"PAH",602,1,189,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,190,0)="   f)The interface for entering drug suggestion was improved to easily allow "
^DIC(9.4,60,22,13,"PAH",602,1,191,0)="     the user to view, edit and delete entries before submitting the RX CHANGE"
^DIC(9.4,60,22,13,"PAH",602,1,192,0)="     REQUEST to the prescriber, as shown below: "
^DIC(9.4,60,22,13,"PAH",602,1,193,0)="     ...  "
^DIC(9.4,60,22,13,"PAH",602,1,194,0)="     Select Drug Suggestion Option:  (N)EW  (F)INISH: NEW "
^DIC(9.4,60,22,13,"PAH",602,1,195,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,196,0)="        Select one of the following: "
^DIC(9.4,60,22,13,"PAH",602,1,197,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,198,0)="             E         USE ERX DRUG "
^DIC(9.4,60,22,13,"PAH",602,1,199,0)="             V         CHOOSE A VISTA DRUG "
^DIC(9.4,60,22,13,"PAH",602,1,200,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,201,0)="     DRUG SELECTION: E  USE ERX DRUG "
^DIC(9.4,60,22,13,"PAH",602,1,202,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,203,0)="     eRx Drug: ACETAMINOPHEN 325MG TAB      UPN: 00069306030 "
^DIC(9.4,60,22,13,"PAH",602,1,204,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,205,0)="     SUBSTITUTIONS? YES// "
^DIC(9.4,60,22,13,"PAH",602,1,206,0)="     QUANTITY: 120// "
^DIC(9.4,60,22,13,"PAH",602,1,207,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,208,0)="        Select one of the following: "
^DIC(9.4,60,22,13,"PAH",602,1,209,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,210,0)="             38        Original Quantity "
^DIC(9.4,60,22,13,"PAH",602,1,211,0)="             40        Remaining Quantity "
^DIC(9.4,60,22,13,"PAH",602,1,212,0)="             87        Quantity Received "
^DIC(9.4,60,22,13,"PAH",602,1,213,0)="             QS        Quantity sufficient as determined by the disp. pharmacy"
^DIC(9.4,60,22,13,"PAH",602,1,214,0)="             QT        Quantity Transferred "
^DIC(9.4,60,22,13,"PAH",602,1,215,0)="             CF        Compound Final Quantity "
^DIC(9.4,60,22,13,"PAH",602,1,216,0)="             UQ        Central Fill Unit of Use Quantity "
^DIC(9.4,60,22,13,"PAH",602,1,217,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,218,0)="     QTY QUALIFIER: 38//   Original Quantity "
^DIC(9.4,60,22,13,"PAH",602,1,219,0)="     QTY UNIT OF MEASURE: TABLET DOSING UNIT  C48542     TABLET DOSING UNIT "
^DIC(9.4,60,22,13,"PAH",602,1,220,0)="     DAYS SUPPLY:  (1-365): 30// "
^DIC(9.4,60,22,13,"PAH",602,1,221,0)="     # OF REFILLS:  (0-11): 0// "
^DIC(9.4,60,22,13,"PAH",602,1,222,0)="     SIG Text: ..  "
^DIC(9.4,60,22,13,"PAH",602,1,223,0)="     ==[ WRAP ]==[INSERT ]========< SIG Text >=====[Press <PF1>H for help]===="
^DIC(9.4,60,22,13,"PAH",602,1,224,0)="     TAKE ONE TABLET PO Q4H PRN FOR 10 DAYS "
^DIC(9.4,60,22,13,"PAH",602,1,225,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,226,0)="    =======T=======T=======T=======T=======T=======T=======T=======T=======T="
^DIC(9.4,60,22,13,"PAH",602,1,227,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,228,0)="    ADDITIONAL NOTE TO PROVIDER: NOTE TO PRESCRIBER "
^DIC(9.4,60,22,13,"PAH",602,1,229,0)="                                                                 Updating...OK"
^DIC(9.4,60,22,13,"PAH",602,1,230,0)="    #  DRUG                                     QTY  # REFS  DAYS SUPPLY  SUBS"
^DIC(9.4,60,22,13,"PAH",602,1,231,0)="    --------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,232,0)="    1  (E)ACETAMINOPHEN 325MG TAB               120     0        30       YES"
^DIC(9.4,60,22,13,"PAH",602,1,233,0)="       Sig : TAKE ONE TABLET PO Q4H PRN FOR 10 DAYS "
^DIC(9.4,60,22,13,"PAH",602,1,234,0)="       Note: NOTE TO PRESCRIBER "
^DIC(9.4,60,22,13,"PAH",602,1,235,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,236,0)="    Select Drug Suggestion Option:  (N)EW  (E)DIT  (D)ELETE  (F)INISH: "
^DIC(9.4,60,22,13,"PAH",602,1,237,0)="   "
^DIC(9.4,60,22,13,"PAH",602,1,238,0)="   g) After entering the suggested medications the user will be prompted to "
^DIC(9.4,60,22,13,"PAH",602,1,239,0)="      enter a comment for the field VA PROGRESS NOTE COMMENTS (Optional).  "
^DIC(9.4,60,22,13,"PAH",602,1,240,0)="      The input from the user will be appended to the patient progress note "
^DIC(9.4,60,22,13,"PAH",602,1,241,0)="      automatically created after the Change Request is submitted to the "
^DIC(9.4,60,22,13,"PAH",602,1,242,0)="      prescriber.  "
^DIC(9.4,60,22,13,"PAH",602,1,243,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,244,0)="   h) A Summary will be displayed to the user and a prompt asking if they "
^DIC(9.4,60,22,13,"PAH",602,1,245,0)="      want to edit the Change Request before submitting to the prescriber, as"
^DIC(9.4,60,22,13,"PAH",602,1,246,0)="      show below: "
^DIC(9.4,60,22,13,"PAH",602,1,247,0)="                          RX CHANGE REQUEST SUMMARY "
^DIC(9.4,60,22,13,"PAH",602,1,248,0)="      ------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,249,0)="      Change Request Reason Code: D - DUE (Drug Use Evaluation) "
^DIC(9.4,60,22,13,"PAH",602,1,250,0)="      Change Request Reason Sub-Code: AR - Adverse Drug Reaction "
^DIC(9.4,60,22,13,"PAH",602,1,251,0)="      Note to Provider: "
^DIC(9.4,60,22,13,"PAH",602,1,252,0)="      Patient has an adverse drug reaction to medication/component of"
^DIC(9.4,60,22,13,"PAH",602,1,253,0)="      medication prescribed. To fill as is, send denial to this request with"
^DIC(9.4,60,22,13,"PAH",602,1,254,0)="      note stating reason fill is acceptable. If med should not be filled-"
^DIC(9.4,60,22,13,"PAH",602,1,255,0)="      Cancel RX and send a replacement.  "
^DIC(9.4,60,22,13,"PAH",602,1,256,0)=" "
^DIC(9.4,60,22,13,"PAH",602,1,257,0)="      #  DRUG                                    QTY  # REFS  DAYS SUPPLY  SUBS"
^DIC(9.4,60,22,13,"PAH",602,1,258,0)="      -------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,259,0)="      1  (E)OMEPRAZOLE 20MG EC CAP               90    11        30        YES "
^DIC(9.4,60,22,13,"PAH",602,1,260,0)="         Sig : TAKE ONE CAPSULE BY MOUTH ONCE DAILY BEFORE MEAL "
