^DIC(9.4,3,22,21,"PAH",131,1,31,0)="Bronx, NY     - 526"
^DIC(9.4,3,22,21,"PAH",131,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,33,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",131,1,34,0)="================"
^DIC(9.4,3,22,21,"PAH",131,1,35,0)="The following routine(s) are included in this patch.  The second line of"
^DIC(9.4,3,22,21,"PAH",131,1,36,0)="each routine will look like:"
^DIC(9.4,3,22,21,"PAH",131,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,38,0)="            <tab>;;8.0;KERNEL;**[Patch List]**;07/03/95"
^DIC(9.4,3,22,21,"PAH",131,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,40,0)="Checksums:   CHECK^XTSUMBLD"
