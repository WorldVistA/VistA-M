^DIC(9.4,73,22,9,"PAH",10,1,46,0)="  Installation Instructions:"
^DIC(9.4,73,22,9,"PAH",10,1,47,0)="  =========================="
^DIC(9.4,73,22,9,"PAH",10,1,48,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,49,0)="     1. Users ARE allowed to be on the system during the installation."
^DIC(9.4,73,22,9,"PAH",10,1,50,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,51,0)="     2. DSM/AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,73,22,9,"PAH",10,1,52,0)="        routines in the Routine Summary section are mapped, disable"
^DIC(9.4,73,22,9,"PAH",10,1,53,0)="        mapping for the affected routine."
^DIC(9.4,73,22,9,"PAH",10,1,54,0)=" "
^DIC(9.4,73,22,9,"PAH",10,1,55,0)="     3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu."
^DIC(9.4,73,22,9,"PAH",10,1,56,0)="        This loads the patch into a Transport Global onto your system."
