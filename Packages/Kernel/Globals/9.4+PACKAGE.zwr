^DIC(9.4,3,22,21,"PAH",35,1,116,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,117,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",35,1,118,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",35,1,119,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,120,0)="  1.  Some of these routines are usually mapped on systems that allow "
^DIC(9.4,3,22,21,"PAH",35,1,121,0)="      mapping, so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",35,1,122,0)="      "
^DIC(9.4,3,22,21,"PAH",35,1,123,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",35,1,124,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",35,1,125,0)="      "
^DIC(9.4,3,22,21,"PAH",35,1,126,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",35,1,127,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",35,1,128,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",35,1,129,0)="      options:"
^DIC(9.4,3,22,21,"PAH",35,1,130,0)="      "
^DIC(9.4,3,22,21,"PAH",35,1,131,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",35,1,132,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",35,1,133,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",35,1,134,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",35,1,135,0)="               "
^DIC(9.4,3,22,21,"PAH",35,1,136,0)="  4.  Inhibit users from logging into the system."
^DIC(9.4,3,22,21,"PAH",35,1,137,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",35,1,138,0)="      "
^DIC(9.4,3,22,21,"PAH",35,1,139,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",35,1,140,0)="      options:"
^DIC(9.4,3,22,21,"PAH",35,1,141,0)="         Install Package(s)  'XU*8.0*49'"
^DIC(9.4,3,22,21,"PAH",35,1,142,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",35,1,143,0)="         "
^DIC(9.4,3,22,21,"PAH",35,1,144,0)="  6.  MSM Sites - With Taskman not working you need to move the routine to"
^DIC(9.4,3,22,21,"PAH",35,1,145,0)="      other CPU's with the D ^XPDCPU"
^DIC(9.4,3,22,21,"PAH",35,1,146,0)="      MSM Sites - On each cpu rename ZUMSM to ZU with: ZL ZUMSM ZS ZU"
^DIC(9.4,3,22,21,"PAH",35,1,147,0)="      "
^DIC(9.4,3,22,21,"PAH",35,1,148,0)="  7.  After installing this patch, you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",35,1,149,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",35,1,150,0)="      ZIS1"
^DIC(9.4,3,22,21,"PAH",35,1,151,0)="      ZIS4MSM"
^DIC(9.4,3,22,21,"PAH",35,1,152,0)="      ZIS4VXD"
^DIC(9.4,3,22,21,"PAH",35,1,153,0)="      ZIS6"
^DIC(9.4,3,22,21,"PAH",35,1,154,0)="      ZISC"
^DIC(9.4,3,22,21,"PAH",35,1,155,0)="      ZISHMSM"
^DIC(9.4,3,22,21,"PAH",35,1,156,0)="      ZOSVMSM"
^DIC(9.4,3,22,21,"PAH",35,1,157,0)="      ZTER1"
^DIC(9.4,3,22,21,"PAH",35,1,158,0)="      ZTLOAD5"
^DIC(9.4,3,22,21,"PAH",35,1,159,0)="      ZTMS1"
^DIC(9.4,3,22,21,"PAH",35,1,160,0)="      ZTMS3"
^DIC(9.4,3,22,21,"PAH",35,1,161,0)="    "
^DIC(9.4,3,22,21,"PAH",35,1,162,0)="      And in the manager account,"
^DIC(9.4,3,22,21,"PAH",35,1,163,0)="       "
^DIC(9.4,3,22,21,"PAH",35,1,164,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",35,1,165,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",35,1,166,0)="      Patch number to load: 49"
^DIC(9.4,3,22,21,"PAH",35,1,167,0)="                            =="
^DIC(9.4,3,22,21,"PAH",35,1,168,0)="      Move these MGR routines to your other CPU's."
^DIC(9.4,3,22,21,"PAH",35,1,169,0)="       "
^DIC(9.4,3,22,21,"PAH",35,1,170,0)="  8.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",35,1,171,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,172,0)="  9.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",35,1,173,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",35,1,174,0)=" "
^DIC(9.4,3,22,21,"PAH",35,1,175,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",36,0)="64 SEQ #50^2970922^1"
^DIC(9.4,3,22,21,"PAH",36,1,0)="^^2^2^2970922"
^DIC(9.4,3,22,21,"PAH",36,1,1,0)="Numerous Kernel fixes."
^DIC(9.4,3,22,21,"PAH",36,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",37,0)="59 SEQ #51^2971118^1"
^DIC(9.4,3,22,21,"PAH",37,1,0)="^^90^90^2980409^"
^DIC(9.4,3,22,21,"PAH",37,1,1,0)="This is the Auto Sign-on patch (aka Single Sign-on)"
^DIC(9.4,3,22,21,"PAH",37,1,2,0)="This patch has several Kernel routines as well as new fields in the Kernel"
^DIC(9.4,3,22,21,"PAH",37,1,3,0)="System parameteres file and the New Person file and the forms to edit"
^DIC(9.4,3,22,21,"PAH",37,1,4,0)="these files.  PLEASE be sure to edit the AUTO SIGN-ON field in the Kernel"
^DIC(9.4,3,22,21,"PAH",37,1,5,0)="System parameters file.  "
^DIC(9.4,3,22,21,"PAH",37,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,7,0)="*** This patch will increase the use of the LOCK table  ***"
^DIC(9.4,3,22,21,"PAH",37,1,8,0)="*** NOTE THAT AUTO SIGN-ON DOES NOT WORK ON MSM SYSTEMS ***"
^DIC(9.4,3,22,21,"PAH",37,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,10,0)="All of this work is in support of RPC Broker, CPRS and GUI clients."
^DIC(9.4,3,22,21,"PAH",37,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,12,0)="There were some other fixes that had been applied to the routines and "
^DIC(9.4,3,22,21,"PAH",37,1,13,0)="files needed by this patch so they are also fixed."
^DIC(9.4,3,22,21,"PAH",37,1,14,0)="                     To the ""Enter/Edit Kernel Site Parameters"" form;"
^DIC(9.4,3,22,21,"PAH",37,1,15,0)="                     Added the AUTO SIGN-ON field to page 1,"
^DIC(9.4,3,22,21,"PAH",37,1,16,0)="                     Added the DEFAULT DIRECTORY FOR HFS field to page 3."
^DIC(9.4,3,22,21,"PAH",37,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,18,0)="                     File 3.081 Field 1 changed from 15 to 30 characters."
^DIC(9.4,3,22,21,"PAH",37,1,19,0)="                     "
^DIC(9.4,3,22,21,"PAH",37,1,20,0)="WBP-0396-20726  XQ1  The setting of DIPCRIA, DIASKHD, and DISUPNO was not"
^DIC(9.4,3,22,21,"PAH",37,1,21,0)="                     correct and has been fixed."
^DIC(9.4,3,22,21,"PAH",37,1,22,0)="                     "
^DIC(9.4,3,22,21,"PAH",37,1,23,0)="DAY-0697-41746  XQ1  Startup Options Getting Deleted in file 19.2"
^DIC(9.4,3,22,21,"PAH",37,1,24,0)=""
^DIC(9.4,3,22,21,"PAH",37,1,25,0)="E3R #10159,          File 200 Field 20.2 changed from 30 to 40 characters. "
^DIC(9.4,3,22,21,"PAH",37,1,26,0)=""
