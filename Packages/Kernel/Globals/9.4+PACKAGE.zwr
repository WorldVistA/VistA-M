^DIC(9.4,4,22,1,"PAH",17,1,317,0)=" XMBGRP         5496318        5680054          13,36"
^DIC(9.4,4,22,1,"PAH",17,1,318,0)=" XMFAX          **new**        4957190          36"
^DIC(9.4,4,22,1,"PAH",17,1,319,0)=" XMR1A          6956680        6979581          13,36"
^DIC(9.4,4,22,1,"PAH",17,1,320,0)=" XMUT5G          380003         338629          36"
^DIC(9.4,4,22,1,"PAH",17,1,321,0)=" XMYPOST6       **new**          11500          36"
