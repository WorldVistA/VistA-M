^DIC(9.4,14,22,5.9,"PAH",207,1,358,0)="Installation Sequence "
^DIC(9.4,14,22,5.9,"PAH",207,1,359,0)="======================"
^DIC(9.4,14,22,5.9,"PAH",207,1,360,0)="The files listed below represent the patches will be part of the "
^DIC(9.4,14,22,5.9,"PAH",207,1,361,0)="controlled phased release.  Follow the sequence listed below when your "
^DIC(9.4,14,22,5.9,"PAH",207,1,362,0)="phased installation occurs."
^DIC(9.4,14,22,5.9,"PAH",207,1,363,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,364,0)="  1. LR*5.2*335"
^DIC(9.4,14,22,5.9,"PAH",207,1,365,0)="  2. LR*5.2*367"
^DIC(9.4,14,22,5.9,"PAH",207,1,366,0)="  3. VBECS Bundle (consisting of VBEC*1*0 and LR*5.2*325)"
^DIC(9.4,14,22,5.9,"PAH",207,1,367,0)="  4. VBEC*1.0*1"
^DIC(9.4,14,22,5.9,"PAH",207,1,368,0)="  5. OR*3.0*212"
^DIC(9.4,14,22,5.9,"PAH",207,1,369,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,370,0)="COMPONENT SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",207,1,371,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",207,1,372,0)="This patch installs ROUTINES, FILES, OPTIONS and a MAIL GROUP. For full "
^DIC(9.4,14,22,5.9,"PAH",207,1,373,0)="details about the components being imported with this patch, please see "
^DIC(9.4,14,22,5.9,"PAH",207,1,374,0)="the Blood Bank Pre-Implementation Data Validation, Mapping, and "
^DIC(9.4,14,22,5.9,"PAH",207,1,375,0)="Conversion Technical Manual"
^DIC(9.4,14,22,5.9,"PAH",207,1,376,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,377,0)="Documentation Retrieval:"
^DIC(9.4,14,22,5.9,"PAH",207,1,378,0)="========================"
^DIC(9.4,14,22,5.9,"PAH",207,1,379,0)="Although this is a controlled, phased released, the user & technical "
^DIC(9.4,14,22,5.9,"PAH",207,1,380,0)="documentation will be available to all sites when the patch is officially "
^DIC(9.4,14,22,5.9,"PAH",207,1,381,0)="released and the phased implementations start. This will allow sites the "
^DIC(9.4,14,22,5.9,"PAH",207,1,382,0)="opportunity to retrieve the documents before their phased installation "
^DIC(9.4,14,22,5.9,"PAH",207,1,383,0)="date"
^DIC(9.4,14,22,5.9,"PAH",207,1,384,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,385,0)="Documentation is available for the VBECS package on the "
^DIC(9.4,14,22,5.9,"PAH",207,1,386,0)="ANONYMOUS.SOFTWARE directory at one of the following Office of "
^DIC(9.4,14,22,5.9,"PAH",207,1,387,0)="Information (OI) Field Offices. Sites may retrieve documentation either "
^DIC(9.4,14,22,5.9,"PAH",207,1,388,0)="the "".PDF"" or ""DOC"" format in one of the following ways:"
^DIC(9.4,14,22,5.9,"PAH",207,1,389,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,390,0)="The preferred method is to FTP the files from:"
^DIC(9.4,14,22,5.9,"PAH",207,1,391,0)="Download.vista.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",207,1,392,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,393,0)="This transmits files from the first available FTP server. Sites may also "
^DIC(9.4,14,22,5.9,"PAH",207,1,394,0)="elect to retrieve documentation directly from a specific server as "
^DIC(9.4,14,22,5.9,"PAH",207,1,395,0)="follows:"
^DIC(9.4,14,22,5.9,"PAH",207,1,396,0)="       Albany                  ftp.fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",207,1,397,0)="       Hines                   ftp.fo-hines.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",207,1,398,0)="       Salt Lake City          ftp.fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",207,1,399,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,400,0)="NOTE:  The documentation files listed below will be listed in each of the "
^DIC(9.4,14,22,5.9,"PAH",207,1,401,0)="VBECS and LR patches that are part of the VBECS package and associate "
^DIC(9.4,14,22,5.9,"PAH",207,1,402,0)="patches, they only need to be downloaded once."
^DIC(9.4,14,22,5.9,"PAH",207,1,403,0)=" "
^DIC(9.4,14,22,5.9,"PAH",207,1,404,0)="File Name                                   Retrieval format:  Binary"
^DIC(9.4,14,22,5.9,"PAH",207,1,405,0)="===========                                 =========================="
