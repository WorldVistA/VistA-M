^DIC(9.4,48,22,5.28,"PAH",683,1,22,0)="VSE-6586: MD - VistA: Modify SDAMEP1, SDAMEP2, and SDM4 routines to "
^DIC(9.4,48,22,5.28,"PAH",683,1,23,0)="          include a call to PXCOMPACT"
^DIC(9.4,48,22,5.28,"PAH",683,1,24,0)="VSE-8451: JS - VistA: Create a sub specialty and a sub sub specialty"
^DIC(9.4,48,22,5.28,"PAH",683,1,25,0)="VSE-8704: TB - VistA: Create SDES2 PRINT APPT LETTER and SDES2 PRINT APPT "
^DIC(9.4,48,22,5.28,"PAH",683,1,26,0)="          LETTERS to send parts of the letter"
^DIC(9.4,48,22,5.28,"PAH",683,1,27,0)="VSE-8802: BB - VistA: DATA CLEAN UP - ""Update SDES2 CANCEL CLIN"
^DIC(9.4,48,22,5.28,"PAH",683,1,28,0)="          AVAILABILITY to cancel appointments before cancel availability"""
^DIC(9.4,48,22,5.28,"PAH",683,1,29,0)="VSE-8885: JS - VistA: Modify SDEC EDITAPPT, SDES2 EDIT"
^DIC(9.4,48,22,5.28,"PAH",683,1,30,0)="          APPOINTMENT, SDEC ARSET, SDES2 EDIT APPT REQ (User Comment"
