^DIC(9.4,100,22,15,"PAH",31,1,241,0)="Array(3)=[BEGIN ITEM]; BEGINS EACH ITEM"
^DIC(9.4,100,22,15,"PAH",31,1,242,0)="Array(4)=MMPI2^1 ;CODE^ITEM NUMBER"
^DIC(9.4,100,22,15,"PAH",31,1,243,0)="Array(5)=[INTRO];HEADER ALWAYS PRESENT OPTIONALY FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,244,0)="Array(12)=[TEXT];HEADER ALWAYS PRESENT ALWAYS FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,245,0)="Array(14)=[BOTTOM];HEADER ALWAYS PRESENT OPTIONALY FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,246,0)="Array(18)=[RESPONSE];HEADER ALWAYS PRESENT ALWAYS FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,247,0)="Array(21)=[END ITEM]; ENDS EACH ITEM"
^DIC(9.4,100,22,15,"PAH",31,1,248,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,249,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,250,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,251,0)="Array(1003)=[BEGIN ITEM]; BEGINS EACH ITEM"
^DIC(9.4,100,22,15,"PAH",31,1,252,0)="Array(1004)=MMPI2^567 ;CODE^ITEM NUMBER"
^DIC(9.4,100,22,15,"PAH",31,1,253,0)="Array(1005)=[INTRO];HEADER ALWAYS PRESENT OPTIONALY FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,254,0)="Array(1012)=[TEXT];HEADER ALWAYS PRESENT ALWAYS FOLLOWED BY TEXT"
^DIC(9.4,100,22,15,"PAH",31,1,255,0)="Array(1014)=[BOTTOM];HEADER ALWAYS PRESENT OPTIONALY FOLLOWED BY TEXT"
