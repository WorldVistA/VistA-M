^DIC(9.4,48,22,5.28,"PAH",626,1,1,0)="This patch will address two issues: "
^DIC(9.4,48,22,5.28,"PAH",626,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",626,1,3,0)="   1. Staff search results in Patient Centered Management Module "
^DIC(9.4,48,22,5.28,"PAH",626,1,4,0)="      (PCMM) Web do not include all staff members."
^DIC(9.4,48,22,5.28,"PAH",626,1,5,0)=" "
^DIC(9.4,48,22,5.28,"PAH",626,1,6,0)="   2. <UNDEFINED>AFTERTP+9^SCMCDD1 *SCTMAF error in error trap at multiple"
^DIC(9.4,48,22,5.28,"PAH",626,1,7,0)="      VistA sites."
