^DIC(9.4,11,22,5.03,"PAH",19,1,261,0)=" Install Message sent #28235"
^DIC(9.4,11,22,5.03,"PAH",20,0)="58^3010122^1"
^DIC(9.4,11,22,5.03,"PAH",20,1,0)="^^224^224^3010122"
^DIC(9.4,11,22,5.03,"PAH",20,1,1,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patches LA*5.2*58 and"
^DIC(9.4,11,22,5.03,"PAH",20,1,2,0)="LR*5.2*266 do not contain any changes to the VISTA BLOOD BANK Software as"
^DIC(9.4,11,22,5.03,"PAH",20,1,3,0)="defined by VHA DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION"
^DIC(9.4,11,22,5.03,"PAH",20,1,4,0)="5.2."
^DIC(9.4,11,22,5.03,"PAH",20,1,5,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,6,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patches LA*5.2*58 and"
^DIC(9.4,11,22,5.03,"PAH",20,1,7,0)="LR*5.2*266 do not alter or modify any software design safeguards or safety"
^DIC(9.4,11,22,5.03,"PAH",20,1,8,0)="critical elements functions."
^DIC(9.4,11,22,5.03,"PAH",20,1,9,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,10,0)=" RISK ANALYSIS: Changes made by patches LA*5.2*58 and LR*5.2*266 have no"
^DIC(9.4,11,22,5.03,"PAH",20,1,11,0)="effect on Blood Bank software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",20,1,12,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,13,0)="**NOTE**"
^DIC(9.4,11,22,5.03,"PAH",20,1,14,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,15,0)="Patches LA*5.2*58 and LR*5.2*266 are being released in a single"
^DIC(9.4,11,22,5.03,"PAH",20,1,16,0)="distribution.  Because of this, patch descriptions for LA*5.2*58 and"
^DIC(9.4,11,22,5.03,"PAH",20,1,17,0)="LR*5.2*266 are identical and contain routine summaries for both sets of"
^DIC(9.4,11,22,5.03,"PAH",20,1,18,0)="routines."
^DIC(9.4,11,22,5.03,"PAH",20,1,19,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,20,0)="**NOTE**"
^DIC(9.4,11,22,5.03,"PAH",20,1,21,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,22,0)="The laboratory routines LRVER3A and LRMIUT are being modified by this"
^DIC(9.4,11,22,5.03,"PAH",20,1,23,0)="patch.  These routines may have been locally modified at the sites.  The"
^DIC(9.4,11,22,5.03,"PAH",20,1,24,0)="sites must ensure that precautions are taken to prevent loss of local"
^DIC(9.4,11,22,5.03,"PAH",20,1,25,0)="modifications when patches to Laboratory are installed."
^DIC(9.4,11,22,5.03,"PAH",20,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,27,0)="**NOTE**"
^DIC(9.4,11,22,5.03,"PAH",20,1,28,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,29,0)="When initially setting up the FOREIGN INTERFACE file (#62.487), the"
^DIC(9.4,11,22,5.03,"PAH",20,1,30,0)="FOREIGN COMPUTER INTERFACE NAME field (#.01) should ALWAYS be set to"
^DIC(9.4,11,22,5.03,"PAH",20,1,31,0)="""CAREVUE"" (all caps, no leading or trailing spaces, and no quotes).  The"
^DIC(9.4,11,22,5.03,"PAH",20,1,32,0)="routines that access this file are looking specifically for CAREVUE.  The"
^DIC(9.4,11,22,5.03,"PAH",20,1,33,0)="routines will not be able to process the results for CareVue ward patients"
^DIC(9.4,11,22,5.03,"PAH",20,1,34,0)="if this is not done."
^DIC(9.4,11,22,5.03,"PAH",20,1,35,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,36,0)="This patch contains changes to Class I CareVue code and requires that"
^DIC(9.4,11,22,5.03,"PAH",20,1,37,0)="patch LA*5.2*53 and LR*5.2*263 be installed before LA*5.2*58.  Patches"
^DIC(9.4,11,22,5.03,"PAH",20,1,38,0)="LA*5.2*58 and LR*5.2*266 are contained in the same KID file"
^DIC(9.4,11,22,5.03,"PAH",20,1,39,0)="(LA_52_P58.KID) and will be installed together."
^DIC(9.4,11,22,5.03,"PAH",20,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,41,0)="This patch includes the following changes:"
^DIC(9.4,11,22,5.03,"PAH",20,1,42,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,43,0)="1.  This patch updates the documentation released with the CareVue"
^DIC(9.4,11,22,5.03,"PAH",20,1,44,0)="Interface patch (LA*5.2*53)."
^DIC(9.4,11,22,5.03,"PAH",20,1,45,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,46,0)="2.  This patch makes changes to the routines LRVER3A and LRMIUT, and will"
^DIC(9.4,11,22,5.03,"PAH",20,1,47,0)="create a new routine (LA7DLOC).  Currently, two routines (LRVER3A and"
^DIC(9.4,11,22,5.03,"PAH",20,1,48,0)="LRMIUT) contain the Class I software for the CareVue interface. This patch"
^DIC(9.4,11,22,5.03,"PAH",20,1,49,0)="will modify these routines to call the new routine (LA7DLOC).  LA7DLOC"
^DIC(9.4,11,22,5.03,"PAH",20,1,50,0)="contains the Class I code for determining if a patient is located in a"
^DIC(9.4,11,22,5.03,"PAH",20,1,51,0)="CareVue ward.  The current condition of the Class I code checks the CHEM,"
^DIC(9.4,11,22,5.03,"PAH",20,1,52,0)="HEM, TOX, RIA, SER, etc. field (#4) and the Microbiology field (#5) of the"
^DIC(9.4,11,22,5.03,"PAH",20,1,53,0)="Lab Data file (#63), but the updated routines will call LA7DLOC and will"
^DIC(9.4,11,22,5.03,"PAH",20,1,54,0)="look in the Ward Location field (#.1) of the Patient file (#2).  This"
^DIC(9.4,11,22,5.03,"PAH",20,1,55,0)="shows the current location of the patient.  There were problems with"
^DIC(9.4,11,22,5.03,"PAH",20,1,56,0)="patients that were not transferred to the CareVue ward until after the lab"
^DIC(9.4,11,22,5.03,"PAH",20,1,57,0)="order was taken. The old routine was checking where the patient was"
^DIC(9.4,11,22,5.03,"PAH",20,1,58,0)="located when the order was taken, and not the current location of the"
^DIC(9.4,11,22,5.03,"PAH",20,1,59,0)="patient."
^DIC(9.4,11,22,5.03,"PAH",20,1,60,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,61,0)="3.  Updates to the HL/7 date conversion routines. The previous standard"
^DIC(9.4,11,22,5.03,"PAH",20,1,62,0)="for HL/7 dates listed the date in YYYYMMDDHHMMSS format.  The degree of"
^DIC(9.4,11,22,5.03,"PAH",20,1,63,0)="precision was listed as a separate parameter.  The new standard format is"
^DIC(9.4,11,22,5.03,"PAH",20,1,64,0)="[YYYY[MM[DD[HH[MM[SS]]]]]-zzzz] where the bracketed sections are optional"
^DIC(9.4,11,22,5.03,"PAH",20,1,65,0)="depending on the existence of the subsequent set. Also, if either the"
^DIC(9.4,11,22,5.03,"PAH",20,1,66,0)="seconds or the minutes/seconds combination consist only of zeroes, the"
^DIC(9.4,11,22,5.03,"PAH",20,1,67,0)="minutes (if zeroes) and seconds will be omitted.  The length of the"
^DIC(9.4,11,22,5.03,"PAH",20,1,68,0)="date/time string specifies the degree of precision. In addition, a ZULU"
^DIC(9.4,11,22,5.03,"PAH",20,1,69,0)="time offset (-zzzz) is also included.  This is the number of hours between"
^DIC(9.4,11,22,5.03,"PAH",20,1,70,0)="Greenwich Mean Time and the local time where the date/time string was"
^DIC(9.4,11,22,5.03,"PAH",20,1,71,0)="created.  Routines LA7DVM and LA7DVEXT have been modified to use the"
^DIC(9.4,11,22,5.03,"PAH",20,1,72,0)="Kernel function ($$FMTHL7^XLFDT) to convert dates from FileMan to HL7"
^DIC(9.4,11,22,5.03,"PAH",20,1,73,0)="instead of the HL/7 date conversion utility ($$HDATE^HLFNC)."
^DIC(9.4,11,22,5.03,"PAH",20,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,75,0)="4.  This patch will use TaskMan to transfer data to the CareVue system."
^DIC(9.4,11,22,5.03,"PAH",20,1,76,0)="Currently, TaskMan is not invoked. This could cause a problem verifying a"
^DIC(9.4,11,22,5.03,"PAH",20,1,77,0)="result if an error was encountered in the CareVue routines."
^DIC(9.4,11,22,5.03,"PAH",20,1,78,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,79,0)="5.  This patch changes the LA7D EDIT FOREIGN INTERFACE (Edit Foreign"
^DIC(9.4,11,22,5.03,"PAH",20,1,80,0)="Interface Parameters) option.  It is now easier to add a Ward to a Foreign"
^DIC(9.4,11,22,5.03,"PAH",20,1,81,0)="Computer System Name."
^DIC(9.4,11,22,5.03,"PAH",20,1,82,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,83,0)="6.  This patch updates the Processing RTN field (#771) and the Response"
^DIC(9.4,11,22,5.03,"PAH",20,1,84,0)="Processing RTN field (#772) of the Protocol file (#101) for the LA7D"
^DIC(9.4,11,22,5.03,"PAH",20,1,85,0)="CARELIFE RESULTS and LA7D CARELIFE SERVER entries. The letter ""Q"" will be"
^DIC(9.4,11,22,5.03,"PAH",20,1,86,0)="entered by the post-init routine LR266 if no entry exists."
^DIC(9.4,11,22,5.03,"PAH",20,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,88,0)="NOIS - MIA-0600-30434"
^DIC(9.4,11,22,5.03,"PAH",20,1,89,0)="   Reported an error, MISSING PROCESSING ROUTINE, when sending the HL7"
^DIC(9.4,11,22,5.03,"PAH",20,1,90,0)="   message from VistA to CareVue.  The letter ""Q"" will be entered by"
^DIC(9.4,11,22,5.03,"PAH",20,1,91,0)="   the post-init routine LR266 if no entry exists."
^DIC(9.4,11,22,5.03,"PAH",20,1,92,0)="NOIS - MWV-0900-21094"
^DIC(9.4,11,22,5.03,"PAH",20,1,93,0)="   Reported that all CareVue ward patients tests were not being sent to"
^DIC(9.4,11,22,5.03,"PAH",20,1,94,0)="   the CareVue system.  It was discovered that these patients were ones"
^DIC(9.4,11,22,5.03,"PAH",20,1,95,0)="   who were transferred from a non-CareVue ward to a CareVue ward after"
^DIC(9.4,11,22,5.03,"PAH",20,1,96,0)="   the tests were ordered. The patient was bypassed since the location"
^DIC(9.4,11,22,5.03,"PAH",20,1,97,0)="   at time of order was not a CareVue ward.  This patch will correct"
^DIC(9.4,11,22,5.03,"PAH",20,1,98,0)="   this by looking at the Ward Location field (#.1) in the Patient file"
^DIC(9.4,11,22,5.03,"PAH",20,1,99,0)="   (#2) for the current location of the patient."
^DIC(9.4,11,22,5.03,"PAH",20,1,100,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,101,0)="Associated NOIS"
^DIC(9.4,11,22,5.03,"PAH",20,1,102,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",20,1,103,0)="MIA-0600-30434"
^DIC(9.4,11,22,5.03,"PAH",20,1,104,0)="MWV-0900-21094"
^DIC(9.4,11,22,5.03,"PAH",20,1,105,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,106,0)="Test Sites"
^DIC(9.4,11,22,5.03,"PAH",20,1,107,0)="=========="
^DIC(9.4,11,22,5.03,"PAH",20,1,108,0)="Martinsburg, West Virginia"
^DIC(9.4,11,22,5.03,"PAH",20,1,109,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,110,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,111,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",20,1,112,0)="================="
^DIC(9.4,11,22,5.03,"PAH",20,1,113,0)="The following is a list of routines included in patch LA*5.2*58. The"
^DIC(9.4,11,22,5.03,"PAH",20,1,114,0)="second line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",20,1,115,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,116,0)="<tab>;;5.2;AUTOMATED LAB INSTRUMENTS;**[patch list]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",20,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,118,0)="                 CHECK^XTSUMBLD Results"
^DIC(9.4,11,22,5.03,"PAH",20,1,119,0)="  Routine Name    Before Patch      After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",20,1,120,0)="  ------------    ------------      -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",20,1,121,0)="  LA7DEDT            3765930          5836716      53,58"
^DIC(9.4,11,22,5.03,"PAH",20,1,122,0)="  LA7DLOC             NEW              553499      58"
^DIC(9.4,11,22,5.03,"PAH",20,1,123,0)="  LA7DVM             6983644          6949969      53,58"
^DIC(9.4,11,22,5.03,"PAH",20,1,124,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,125,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,126,0)="The following is a list of routines included in patch LR*5.2*266. The"
^DIC(9.4,11,22,5.03,"PAH",20,1,127,0)="second line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",20,1,128,0)=" "
^DIC(9.4,11,22,5.03,"PAH",20,1,129,0)="<tab>;;5.2;LAB SERVICE;**[patch list]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",20,1,130,0)="                 CHECK^XTSUMBLD Results"
^DIC(9.4,11,22,5.03,"PAH",20,1,131,0)="  Routine Name    Before Patch      After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",20,1,132,0)="  ------------    ------------      -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",20,1,133,0)="  LR266               NEW             1529899      266"
^DIC(9.4,11,22,5.03,"PAH",20,1,134,0)="  LRMIUT             3673249          3951633      254,266"
^DIC(9.4,11,22,5.03,"PAH",20,1,135,0)="  LRVER3A           10780812         10508599      1,5,42,100,121"
^DIC(9.4,11,22,5.03,"PAH",20,1,136,0)="                                                   153,190,221,254,"
