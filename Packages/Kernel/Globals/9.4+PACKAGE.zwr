^DIC(9.4,175,22,2,"PAH",116,0)="167^3170224.165744^54"
^DIC(9.4,175,22,2,"PAH",116,1,0)="^^22^22^3170224"
^DIC(9.4,175,22,2,"PAH",116,1,1,0)="VistA Imaging V3.0 Patch 167 - Display Issues"
^DIC(9.4,175,22,2,"PAH",116,1,2,0)=" "
^DIC(9.4,175,22,2,"PAH",116,1,3,0)="This Patch includes a new Clinical Display Client"
^DIC(9.4,175,22,2,"PAH",116,1,4,0)="Changes in the Clinical Display client will address the"
^DIC(9.4,175,22,2,"PAH",116,1,5,0)="upgrade to MUSE API 3."
^DIC(9.4,175,22,2,"PAH",116,1,6,0)="Also, Clinical Capture users will be able to open images "
^DIC(9.4,175,22,2,"PAH",116,1,7,0)="in a seperate window of Clinical Display for Annotation."
^DIC(9.4,175,22,2,"PAH",116,1,8,0)="This patch also had fixes from patch 150 for the"
^DIC(9.4,175,22,2,"PAH",116,1,9,0)="Image Never Existed issue."
^DIC(9.4,175,22,2,"PAH",116,1,10,0)="A new option on the Image Delete window will allow"
^DIC(9.4,175,22,2,"PAH",116,1,11,0)="the user to Copy the Image to the local hard drive"
^DIC(9.4,175,22,2,"PAH",116,1,12,0)="before deleting.  This will enable the user to "
^DIC(9.4,175,22,2,"PAH",116,1,13,0)="import the image to a new Patient or Re-Index the "
^DIC(9.4,175,22,2,"PAH",116,1,14,0)="Image without the need to Print and ReScan. "
^DIC(9.4,175,22,2,"PAH",116,1,15,0)="  "
^DIC(9.4,175,22,2,"PAH",116,1,16,0)="This will check the routines from a BUILD file."
