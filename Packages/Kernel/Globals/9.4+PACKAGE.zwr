^DIC(9.4,115,22,2,"PAH",38,0)="43 SEQ #38^3030924^1"
^DIC(9.4,115,22,2,"PAH",38,1,0)="^^2^2^3030924"
^DIC(9.4,115,22,2,"PAH",38,1,1,0)="Plese refer the patch description on FORUM for a detailed account of the "
