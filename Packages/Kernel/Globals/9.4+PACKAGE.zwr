^DIC(9.4,100,22,15,"PAH",107,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,100,22,15,"PAH",107,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,100,22,15,"PAH",107,1,5,0)="Please verify with the Development Team that it is safe to install."
