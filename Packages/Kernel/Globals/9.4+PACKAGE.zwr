^DIC(9.4,169,22,1,"PAH",16,0)="18 SEQ #18^3051020^1"
^DIC(9.4,169,22,1,"PAH",16,1,0)="^^1^1^3051020"
^DIC(9.4,169,22,1,"PAH",16,1,1,0)="DUZ undefinied fix in WVRALINK"
^DIC(9.4,169,22,1,"PAH",17,0)="19 SEQ #19^3060824^1"
^DIC(9.4,169,22,1,"PAH",17,1,0)="^^3^3^3060824"
^DIC(9.4,169,22,1,"PAH",17,1,1,0)="This patch replaces the full SSN with the last 4 digits of the SSN"
^DIC(9.4,169,22,1,"PAH",17,1,2,0)="for the generic letter in Women's Health (790.6) and for each of the"
^DIC(9.4,169,22,1,"PAH",17,1,3,0)="notification letters in file 790.404."
^DIC(9.4,169,22,1,"PAH",18,0)="22 SEQ #20^3070904.222352^1"
^DIC(9.4,169,22,1,"PAH",18,1,0)="^^1^1^3070904"
^DIC(9.4,169,22,1,"PAH",18,1,1,0)="Replace CPT codes in file 790.2 for ones that have been inactivated."
^DIC(9.4,169,22,1,"PAH",19,0)="23^3090421.154937^17"
^DIC(9.4,169,22,1,"PAH",19,1,0)="^^2^2^3090421"
^DIC(9.4,169,22,1,"PAH",19,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,169,22,1,"PAH",19,1,2,0)="under WV*1.0*23."
^DIC(9.4,169,22,1,"PAH",20,0)="25 SEQ #22^3150323.110123^17"
^DIC(9.4,169,22,1,"PAH",20,1,0)="^^6^6^3150323"
^DIC(9.4,169,22,1,"PAH",20,1,1,0)="This patch is a VM patch that addresses 2 issues in the Women's Health"
^DIC(9.4,169,22,1,"PAH",20,1,2,0)="package."
^DIC(9.4,169,22,1,"PAH",20,1,3,0)=" "
^DIC(9.4,169,22,1,"PAH",20,1,4,0)="1.      No alert to case manager for PAP supplementary reports"
^DIC(9.4,169,22,1,"PAH",20,1,5,0)=" "
^DIC(9.4,169,22,1,"PAH",20,1,6,0)="2.      Errors when reports are sent to  Women's Health package"
^DIC(9.4,169,22,1,"PAH",21,0)="24^3200624.1214^65"
^DIC(9.4,169,22,1,"PAH",21,1,0)="^^10^10^3200624"
^DIC(9.4,169,22,1,"PAH",21,1,1,0)="This patch modifies the Women's Health package to improve monitoring of "
^DIC(9.4,169,22,1,"PAH",21,1,2,0)="high risk medcations prescribed or administered to women of childbearing"
^DIC(9.4,169,22,1,"PAH",21,1,3,0)="age or women who are lactating. Specifically, the software now tracks a"
^DIC(9.4,169,22,1,"PAH",21,1,4,0)="woman's pregnancy and lacation status and notifies providers of changes in"
^DIC(9.4,169,22,1,"PAH",21,1,5,0)="these statuses. These statuses are used during order checking to remind "
^DIC(9.4,169,22,1,"PAH",21,1,6,0)="providers about the potential harm of such medications."
^DIC(9.4,169,22,1,"PAH",21,1,7,0)=" "
^DIC(9.4,169,22,1,"PAH",21,1,8,0)="Please see the accompanying patch description for details and the "
^DIC(9.4,169,22,1,"PAH",21,1,9,0)="Computerized Patient Record System (CPRS) version 31.b installation manual"
^DIC(9.4,169,22,1,"PAH",21,1,10,0)="for installation instructions."
^DIC(9.4,169,22,1,"PAH",22,0)="26^3211207.151119^17"
^DIC(9.4,169,22,1,"PAH",22,1,0)="^^10^10^3211207"
^DIC(9.4,169,22,1,"PAH",22,1,1,0)="This patch modifies the Women's Health package to improve monitoring of "
^DIC(9.4,169,22,1,"PAH",22,1,2,0)="high risk medcations prescribed or administered to women of childbearing"
^DIC(9.4,169,22,1,"PAH",22,1,3,0)="age or women who are lactating. Specifically, the software now tracks a"
^DIC(9.4,169,22,1,"PAH",22,1,4,0)="woman's pregnancy and lacation status and notifies providers of changes in"
^DIC(9.4,169,22,1,"PAH",22,1,5,0)="these statuses. These statuses are used during order checking to remind "
^DIC(9.4,169,22,1,"PAH",22,1,6,0)="providers about the potential harm of such medications."
^DIC(9.4,169,22,1,"PAH",22,1,7,0)=" "
^DIC(9.4,169,22,1,"PAH",22,1,8,0)="Please see the accompanying patch description for details and the "
^DIC(9.4,169,22,1,"PAH",22,1,9,0)="Computerized Patient Record System (CPRS) version 31.b installation manual"
^DIC(9.4,169,22,1,"PAH",22,1,10,0)="for installation instructions."
