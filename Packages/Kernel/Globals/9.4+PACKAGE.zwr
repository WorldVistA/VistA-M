^DIC(9.4,28,22,6,"PAH",4,1,28,0)="Rtn Nm          Chksum Before          Chksum         Patch List"
^DIC(9.4,28,22,6,"PAH",4,1,29,0)="------------------------------------------------------------------"
^DIC(9.4,28,22,6,"PAH",4,1,30,0)="GECSPURG              5541863         5633010             23"
^DIC(9.4,28,22,6,"PAH",4,1,31,0)="GECSPUR1              6739363         7042889             23"
^DIC(9.4,28,22,6,"PAH",4,1,32,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,33,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,34,0)="Installation Instruction:"
^DIC(9.4,28,22,6,"PAH",4,1,35,0)="========================"
^DIC(9.4,28,22,6,"PAH",4,1,36,0)="1. This patch can be loaded with users on the system.  Installation"
^DIC(9.4,28,22,6,"PAH",4,1,37,0)="   will take less than 5 minutes. "
^DIC(9.4,28,22,6,"PAH",4,1,38,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,39,0)="2. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,28,22,6,"PAH",4,1,40,0)="   option will load the KIDS package onto your system."
^DIC(9.4,28,22,6,"PAH",4,1,41,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,42,0)="3. Routine mapping is NOT recommended for these routines."
^DIC(9.4,28,22,6,"PAH",4,1,43,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,44,0)="4. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,28,22,6,"PAH",4,1,45,0)="will load the KIDS package into your system."
^DIC(9.4,28,22,6,"PAH",4,1,46,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,47,0)="5. The patch has now been loaded into a transport global and you will"
^DIC(9.4,28,22,6,"PAH",4,1,48,0)="use KIDS to install the transport global.  On the KIDS menu, under the"
^DIC(9.4,28,22,6,"PAH",4,1,49,0)="'Installation' menu, use the following options"
^DIC(9.4,28,22,6,"PAH",4,1,50,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,51,0)="  Verify Checksums in Transport Global"
^DIC(9.4,28,22,6,"PAH",4,1,52,0)="  Print Transport Global"
^DIC(9.4,28,22,6,"PAH",4,1,53,0)="  Compare Transport Global to Current System"
^DIC(9.4,28,22,6,"PAH",4,1,54,0)="  Backup a Transport Global"
^DIC(9.4,28,22,6,"PAH",4,1,55,0)="  Install Package(s)"
^DIC(9.4,28,22,6,"PAH",4,1,56,0)="             INSTALL NAME:  GEC*2.0*23"
^DIC(9.4,28,22,6,"PAH",4,1,57,0)="                            =========="
^DIC(9.4,28,22,6,"PAH",4,1,58,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,59,0)="  Want KIDS to INHIBIT LOGONs during the install? YES//NO"
^DIC(9.4,28,22,6,"PAH",4,1,60,0)="                                                        =="
^DIC(9.4,28,22,6,"PAH",4,1,61,0)="  Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,28,22,6,"PAH",4,1,62,0)="                                                                  ==   "
^DIC(9.4,28,22,6,"PAH",4,1,63,0)=" "
^DIC(9.4,28,22,6,"PAH",4,1,64,0)="6. If routines were unmapped as part of step 3, they should be returned"
^DIC(9.4,28,22,6,"PAH",4,1,65,0)="to the mapped set once the installation has run to completion."
^DIC(9.4,28,22,6,"PAH",5,0)="24 SEQ #21^3000229^1"
^DIC(9.4,28,22,6,"PAH",5,1,0)="^^116^116^3000229"
^DIC(9.4,28,22,6,"PAH",5,1,1,0)="    Y2K Waiver Request ID#:Y2KW0001   Y2K Waiver Status: Approved"
^DIC(9.4,28,22,6,"PAH",5,1,2,0)="    this patch may be installed during the Y2K Moratorium, AFTER "
^DIC(9.4,28,22,6,"PAH",5,1,3,0)="    1/15/2000.  "
^DIC(9.4,28,22,6,"PAH",5,1,4,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,5,0)="1.  The Austin Automation Center in conjunction with the VHA CIO FO has"
^DIC(9.4,28,22,6,"PAH",5,1,6,0)="    developed a new interim database called the VHA Work Measurement(VWM)"
^DIC(9.4,28,22,6,"PAH",5,1,7,0)="    System.  With the development of this new database only the segments"
^DIC(9.4,28,22,6,"PAH",5,1,8,0)="    below will remain in an active status in file #2101.2, while all other"
^DIC(9.4,28,22,6,"PAH",5,1,9,0)="    segments will be in a inactive status.  A new routine GECSSEG has been"
^DIC(9.4,28,22,6,"PAH",5,1,10,0)="    created to allow the below segments to be put into a status of active"
^DIC(9.4,28,22,6,"PAH",5,1,11,0)="    and those not listed below will be set to a status of inactive."
^DIC(9.4,28,22,6,"PAH",5,1,12,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,13,0)="SPECIAL NOTE: ACTIVE SEGMENTS"
^DIC(9.4,28,22,6,"PAH",5,1,14,0)="============================="
^DIC(9.4,28,22,6,"PAH",5,1,15,0)="157 - Pharmacy Service - Outpatient Pharmacy"
^DIC(9.4,28,22,6,"PAH",5,1,16,0)="158 - Pharmacy Service - Inpatient Pharmacy"
^DIC(9.4,28,22,6,"PAH",5,1,17,0)="171 - Mental Health & Behavioral Sciences - Psych. Service Code Sheet"
^DIC(9.4,28,22,6,"PAH",5,1,18,0)="174 - Spinal Cord Injury Census Data"
^DIC(9.4,28,22,6,"PAH",5,1,19,0)="200 - Nursing Service - Manpower Utilization"
^DIC(9.4,28,22,6,"PAH",5,1,20,0)="201 - Nursing Service - Man-hours Worked"
^DIC(9.4,28,22,6,"PAH",5,1,21,0)="218 - Environmental Management - Environmental Care Operations"
^DIC(9.4,28,22,6,"PAH",5,1,22,0)="219 - Environmental Management - Textile Care Operations"
^DIC(9.4,28,22,6,"PAH",5,1,23,0)="220 - Environmental Management - Contracted Hours"
^DIC(9.4,28,22,6,"PAH",5,1,24,0)="290 - Medical Admin. Service - C&P Exams Code Sheet"
^DIC(9.4,28,22,6,"PAH",5,1,25,0)="334 - Medical Admin. Service - Psychiatry"
^DIC(9.4,28,22,6,"PAH",5,1,26,0)="335 - Medical Admin. Service - Intermediate"
^DIC(9.4,28,22,6,"PAH",5,1,27,0)="336 - Medical Admin. Service - Medicine"
^DIC(9.4,28,22,6,"PAH",5,1,28,0)="337 - Medical Admin. Service - Neurology"
^DIC(9.4,28,22,6,"PAH",5,1,29,0)="338 - Medical Admin. Service - Rehabilitation Medicine"
^DIC(9.4,28,22,6,"PAH",5,1,30,0)="339 - Medical Admin. Service - Blind Rehabilitation"
^DIC(9.4,28,22,6,"PAH",5,1,31,0)="340 - Medical Admin. Service - Spinal Cord Injury"
^DIC(9.4,28,22,6,"PAH",5,1,32,0)="341 - Medical Admin. Service - Surgery"
^DIC(9.4,28,22,6,"PAH",5,1,33,0)="344 - Medical Admin. Service - Non-VA Public Hospitals"
^DIC(9.4,28,22,6,"PAH",5,1,34,0)="345 - Medical Admin. Service - VA Nursing Home"
^DIC(9.4,28,22,6,"PAH",5,1,35,0)="346 - Medical Admin. Service - VA Domiciliary"
^DIC(9.4,28,22,6,"PAH",5,1,36,0)="347 - Medical Admin. Service - Non-VA Civil Hospitals"
^DIC(9.4,28,22,6,"PAH",5,1,37,0)="348 - Medical Admin. Service - Non-VA Federal Hospitals"
^DIC(9.4,28,22,6,"PAH",5,1,38,0)="349 - Medical Admin. Service - Community Nursing Home"
^DIC(9.4,28,22,6,"PAH",5,1,39,0)="350 - Medical Admin. Service - State Domiciliary"
^DIC(9.4,28,22,6,"PAH",5,1,40,0)="362 - Spinal Cord Injury Home Care Unit Data"
^DIC(9.4,28,22,6,"PAH",5,1,41,0)="363 - Spinal Cord Injury Home Care Special Programs Data"
^DIC(9.4,28,22,6,"PAH",5,1,42,0)="J15 - Medical Service - Cardiac Catheterization"
^DIC(9.4,28,22,6,"PAH",5,1,43,0)="J19 - Medical Service - Dialysis"
^DIC(9.4,28,22,6,"PAH",5,1,44,0)="J42 - Medical Service - SICU"
^DIC(9.4,28,22,6,"PAH",5,1,45,0)=" "
^DIC(9.4,28,22,6,"PAH",5,1,46,0)="Segment 228 (Medical Admin. Service - Outpatient Care-Visits to Fee"
^DIC(9.4,28,22,6,"PAH",5,1,47,0)="Physicians) and Segment 223 (Medical Admin. Service - Staff Visits to"
^DIC(9.4,28,22,6,"PAH",5,1,48,0)="Clinics) will be loaded using external data linkages and will be stored on"
^DIC(9.4,28,22,6,"PAH",5,1,49,0)="the VWM Database."
^DIC(9.4,28,22,6,"PAH",5,1,50,0)=" "
