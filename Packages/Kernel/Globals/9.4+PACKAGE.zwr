^DIC(9.4,73,22,9,"PAH",14,1,51,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,52,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,53,0)="   Installation Instructions:"
^DIC(9.4,73,22,9,"PAH",14,1,54,0)="   =========================="
^DIC(9.4,73,22,9,"PAH",14,1,55,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,56,0)="      1. Users ARE allowed to be on the system during the installation."
^DIC(9.4,73,22,9,"PAH",14,1,57,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,58,0)="      2. DSM/AXP sites: Review your mapped routine set.  If any of the"
^DIC(9.4,73,22,9,"PAH",14,1,59,0)="         routines in the Routine Summary section are mapped, disable"
^DIC(9.4,73,22,9,"PAH",14,1,60,0)="         mapping for the affected routine."
^DIC(9.4,73,22,9,"PAH",14,1,61,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,62,0)="      3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu."
^DIC(9.4,73,22,9,"PAH",14,1,63,0)="         This loads the patch into a Transport Global onto your system."
^DIC(9.4,73,22,9,"PAH",14,1,64,0)="     "
^DIC(9.4,73,22,9,"PAH",14,1,65,0)="      4. You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,73,22,9,"PAH",14,1,66,0)="               "
^DIC(9.4,73,22,9,"PAH",14,1,67,0)="      5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,73,22,9,"PAH",14,1,68,0)="         following options to install the Transport Global:"
^DIC(9.4,73,22,9,"PAH",14,1,69,0)="            Verify Checksums in Transport Global"
^DIC(9.4,73,22,9,"PAH",14,1,70,0)="            Print Transport Global "
^DIC(9.4,73,22,9,"PAH",14,1,71,0)="            Compare Transport Global to Current System"
^DIC(9.4,73,22,9,"PAH",14,1,72,0)="            Backup a Transport Global"
^DIC(9.4,73,22,9,"PAH",14,1,73,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,74,0)="            Install Package(s) "
^DIC(9.4,73,22,9,"PAH",14,1,75,0)="                INSTALL NAME: AFJX*5.1*23"
^DIC(9.4,73,22,9,"PAH",14,1,76,0)="                              ==========="
^DIC(9.4,73,22,9,"PAH",14,1,77,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,78,0)="            Want KIDS to INHIBIT LOGONs during the install?  YES// NO"
^DIC(9.4,73,22,9,"PAH",14,1,79,0)="                                                                  ==== "
^DIC(9.4,73,22,9,"PAH",14,1,80,0)="            Want to DISABLE Scheduled Options,  Menu Options, and"
^DIC(9.4,73,22,9,"PAH",14,1,81,0)="              Protocols?  YES//"
^DIC(9.4,73,22,9,"PAH",14,1,82,0)="                          ===="
^DIC(9.4,73,22,9,"PAH",14,1,83,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,84,0)="                 Enter options you wish to mark as 'Out"
^DIC(9.4,73,22,9,"PAH",14,1,85,0)="                         Of Order':   AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",14,1,86,0)="                                      ================"
^DIC(9.4,73,22,9,"PAH",14,1,87,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,88,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,89,0)="      6.  DSM/AXP Sites - Answer NO to the question ""Want to MOVE"
^DIC(9.4,73,22,9,"PAH",14,1,90,0)="           routines to other CPUs?"""
^DIC(9.4,73,22,9,"PAH",14,1,91,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,92,0)="      7.  DSM/AXP sites:  If the routines were unmapped, the mapped"
^DIC(9.4,73,22,9,"PAH",14,1,93,0)="          set should be rebuilt once the installation has run"
^DIC(9.4,73,22,9,"PAH",14,1,94,0)="          to completion."
^DIC(9.4,73,22,9,"PAH",14,1,95,0)="  "
^DIC(9.4,73,22,9,"PAH",14,1,96,0)="."
