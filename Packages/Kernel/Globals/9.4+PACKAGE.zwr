^DIC(9.4,137,"DEV")="STANLEY A. BROWN/BIRMINGHAM"
^DIC(9.4,137,"DIE",0)="^9.47^1^1"
^DIC(9.4,137,"DIE",1,0)="SOWKNWRK^200"
^DIC(9.4,137,"EX",0)="^9.432^3^2"
^DIC(9.4,137,"EX",1,0)="SW"
^DIC(9.4,137,"EX",2,0)="SOWKFG"
^DIC(9.4,137,"EX",3,0)="SW"
^DIC(9.4,137,"EX",4,0)="SOWKFG"
^DIC(9.4,137,"EX",5,0)="SOWKDBU"
^DIC(9.4,137,"INI")="SOWKCONV^2960924.165128"
^DIC(9.4,137,"INIT")="SOWKND^2960924.165218"
^DIC(9.4,137,"PRE")="SOWKPREI^2960924.165111"
^DIC(9.4,137,"VERSION")="3.0"
^DIC(9.4,140,0)="PROSTHETICS^RMPR^PROSTHETICS VERSION 3.0 ALPHA"
^DIC(9.4,140,1,0)="^^78^78^2951130^^^^"
^DIC(9.4,140,1,1,0)="The DHCP Prosthetic package automates many functions for Prosthetics.  The"
^DIC(9.4,140,1,2,0)="record of Prosthetics Service (VA Form 10-2319) and the appropriate"
^DIC(9.4,140,1,3,0)="VAF 1358 obligation, are updated at the time of purchase (entry into the"
^DIC(9.4,140,1,4,0)="computer) of the item or service provided to the veteran.  This update is"
^DIC(9.4,140,1,5,0)="accomplished through direct links to IFCAP and the electronic patient VAF"
^DIC(9.4,140,1,6,0)="10-2319. Purchasing is simplified by entering the information only once"
^DIC(9.4,140,1,7,0)="into the computer and letting it update your 1358 account balances and the"
^DIC(9.4,140,1,8,0)="patient VAF 10-2319."
^DIC(9.4,140,1,9,0)=" "
^DIC(9.4,140,1,10,0)="   Purchasing Module"
^DIC(9.4,140,1,11,0)=" "
^DIC(9.4,140,1,12,0)="Purchasing interfaces with IFCAP into the IFCAP 1358 module.  Forms "
^DIC(9.4,140,1,13,0)="printed include the Authorization Invoice (VAF 10-2421), and Authority to"
^DIC(9.4,140,1,14,0)="Exceed Amount on the Service Card (FL 10-55).  For tracking transactions"
^DIC(9.4,140,1,15,0)="associated with purchasing, Prosthetics will accommodate the Prosthetic"
^DIC(9.4,140,1,16,0)="Service Card Invoice (VAF 10-2520), the Prescription and Authorization for"
^DIC(9.4,140,1,17,0)="Eyeglasses (VAF 10-2914), No-Form, Pickup/Delivery Charges, Request for"
^DIC(9.4,140,1,18,0)="Estimate (FL10-90), and Patient Notification Letter."
^DIC(9.4,140,1,19,0)=" "
^DIC(9.4,140,1,20,0)=" "
^DIC(9.4,140,1,21,0)="   Electronic 10-2319 Module"
^DIC(9.4,140,1,22,0)="  "
^DIC(9.4,140,1,23,0)="Record of Prosthetics Services is fully incorporated into DHCP displayed in"
^DIC(9.4,140,1,24,0)="multiple terminal screens.  Appliances and services issued are"
^DIC(9.4,140,1,25,0)="automatically recorded to the electronic VAF 10-2319 when purchases are"
^DIC(9.4,140,1,26,0)="obligated or issued from stock.  In addition, PSC Card, Clothing"
^DIC(9.4,140,1,27,0)="Allowance, Auto Adaptive Equipment, Patient Correspondence, and other"
^DIC(9.4,140,1,28,0)="patient data is recorded and displayed within the Electronic VAF 10-2319"
^DIC(9.4,140,1,29,0)="Module.  This is the module that provides the basis for all AMIS reports."
^DIC(9.4,140,1,30,0)=" "
^DIC(9.4,140,1,31,0)="   Entitlement Records Module"
^DIC(9.4,140,1,32,0)="  "
^DIC(9.4,140,1,33,0)="Information collected by Medical Administration Service (MAS) to determine"
^DIC(9.4,140,1,34,0)="eligibility of benefits to the veteran is displayed in this module."
^DIC(9.4,140,1,35,0)="Patient data includes name, social security number, date of birth,"
^DIC(9.4,140,1,36,0)="address, remarks, temporary address, phone, sex, next of kin, military"
^DIC(9.4,140,1,37,0)="service, eligibility status, verification of eligibility, disability"
^DIC(9.4,140,1,38,0)="ratings, diagnostic codes, admission date, discharge date, type of"
^DIC(9.4,140,1,39,0)="discharge, clinic enrollment, and pending appointments."
^DIC(9.4,140,1,40,0)="  "
^DIC(9.4,140,1,41,0)="   AMIS Module"
^DIC(9.4,140,1,42,0)="  "
^DIC(9.4,140,1,43,0)="This module calculates the new and repair work sheets based on the infor-"
^DIC(9.4,140,1,44,0)="mation collected in the electronic 10-2319 file."
^DIC(9.4,140,1,45,0)="This module also automatically generates Genric Code sheets that will be"
^DIC(9.4,140,1,46,0)="saved for editing and transmission to Austin."
^DIC(9.4,140,1,47,0)=" "
^DIC(9.4,140,1,48,0)="   Inventory Module"
^DIC(9.4,140,1,49,0)="  "
^DIC(9.4,140,1,50,0)="Inventory is linked to the Generic Inventory Package.  Each station has the"
^DIC(9.4,140,1,51,0)="option to activate GIP."
^DIC(9.4,140,1,52,0)=" "
^DIC(9.4,140,1,53,0)=" "
^DIC(9.4,140,1,54,0)="   Correspondence Module"
^DIC(9.4,140,1,55,0)="  "
^DIC(9.4,140,1,56,0)="Letters sent to patients are generated from this module.  Denial letters"
^DIC(9.4,140,1,57,0)="are counted on AMIS automatically when end-of-quarter AMIS reports are"
^DIC(9.4,140,1,58,0)="run."
^DIC(9.4,140,1,59,0)="  "
^DIC(9.4,140,1,60,0)=" "
^DIC(9.4,140,1,61,0)="   Scheduled Meetings and Home/Liaison Visits Module"
^DIC(9.4,140,1,62,0)="  "
^DIC(9.4,140,1,63,0)="Appointment information for Prosthetics Clinics can be pulled over onto"
^DIC(9.4,140,1,64,0)="the Prosthetics VAF 10-2527 to be printed as Appointment Roster and Clinic"
^DIC(9.4,140,1,65,0)="Action Sheets."
^DIC(9.4,140,1,66,0)=" "
^DIC(9.4,140,1,67,0)="Home/Liaison visits can also be entered and printed in this module.  All"
^DIC(9.4,140,1,68,0)="Appointment Visits and Home/Liaison Visits will be calculated on AMIS at"
^DIC(9.4,140,1,69,0)="the end of the quarter."
^DIC(9.4,140,1,70,0)=" "
^DIC(9.4,140,1,71,0)="    Prosthetic Lab Module"
^DIC(9.4,140,1,72,0)=" "
^DIC(9.4,140,1,73,0)="The Prosthetic Lab module automates VA Form 10-2529-3, Request and Receipt"
^DIC(9.4,140,1,74,0)="for Prosthetic Appliances or Services, which is used to maintain a"
^DIC(9.4,140,1,75,0)="consolidated record of prosthetic services furnished to eligible veterans."
^DIC(9.4,140,1,76,0)="This includes activities at Orthotic Laboratories, Restoration"
^DIC(9.4,140,1,77,0)="Laboratories, Shoe Last Clinics, Wheelchair Repair Shops, National Foot"
^DIC(9.4,140,1,78,0)="Centers, and the Denver Distribution Center."
^DIC(9.4,140,4,0)="^9.44PA^50^24"
