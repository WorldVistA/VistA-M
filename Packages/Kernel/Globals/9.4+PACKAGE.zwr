^DIC(9.4,47,22,5.9,"PAH",816,0)="1043 SEQ #909^3210326.104417^17"
^DIC(9.4,47,22,5.9,"PAH",816,1,0)="^^7^7^3210326"
^DIC(9.4,47,22,5.9,"PAH",816,1,1,0)="Patch DG*5.3*1043 addresses the following issues:"
^DIC(9.4,47,22,5.9,"PAH",816,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",816,1,3,0)="1. An UNDEFINED EN+37^DGRUDYN Error occurs regularly due to the"
^DIC(9.4,47,22,5.9,"PAH",816,1,4,0)="   DGRU INPATIENT CAPTURE item protocol being enabled."
^DIC(9.4,47,22,5.9,"PAH",816,1,5,0)="2. EWL needs to be removed as a selectable option from the New "
^DIC(9.4,47,22,5.9,"PAH",816,1,6,0)="   Enrollee Appointment Request (NEAR) Management Edit option"
^DIC(9.4,47,22,5.9,"PAH",816,1,7,0)="   Status."
