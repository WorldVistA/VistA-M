^DIC(9.4,14,22,5.9,"PAH",90,1,9,0)="BLOOD BANK SOFTWARE VERSION."
^DIC(9.4,14,22,5.9,"PAH",90,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",90,1,11,0)="PROBLEM:   Date handling errors were found in the logic of patch"
^DIC(9.4,14,22,5.9,"PAH",90,1,12,0)="LR*5.2*242.  This patch corrects these errors."
^DIC(9.4,14,22,5.9,"PAH",90,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",90,1,14,0)="RISK ANALYSIS:   Changes made by patch LR*5.2*252 have no effect on Blood"
