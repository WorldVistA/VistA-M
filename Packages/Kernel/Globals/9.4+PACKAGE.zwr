^DIC(9.4,115,22,2,"PAH",130,1,1,0)="RA PROC OPTION SEMI-COLON ISSUE AND OUTSIDE RPT ENT OBSERVATION DT/TM"
^DIC(9.4,115,22,2,"PAH",131,0)="148 SEQ #136^3190402.143417^54"
^DIC(9.4,115,22,2,"PAH",131,1,0)="^^5^5^3190402"
^DIC(9.4,115,22,2,"PAH",131,1,1,0)="This patch allows the user to select an imaging order that has been "
^DIC(9.4,115,22,2,"PAH",131,1,2,0)="signed, create a consult order from that imaging order, automatically sign"
^DIC(9.4,115,22,2,"PAH",131,1,3,0)="the consult order which creates a consult, and the consult is submitted to"
^DIC(9.4,115,22,2,"PAH",131,1,4,0)="community care. Seven consult new services are created for use in this "
^DIC(9.4,115,22,2,"PAH",131,1,5,0)="process."
