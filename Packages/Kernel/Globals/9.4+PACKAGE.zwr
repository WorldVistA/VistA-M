^DIC(9.4,47,22,5.9,"PAH",826,0)="1034^3210429.142125^17"
^DIC(9.4,47,22,5.9,"PAH",826,1,0)="^^7^7^3210429"
^DIC(9.4,47,22,5.9,"PAH",826,1,1,0)="DG*5.3*1034 (Registration) is bundled with IB*2.0*688 (Integrated Billing)"
^DIC(9.4,47,22,5.9,"PAH",826,1,2,0)="in host file IB_2_0_P688.KID."
^DIC(9.4,47,22,5.9,"PAH",826,1,3,0)=" "
^DIC(9.4,47,22,5.9,"PAH",826,1,4,0)="This patch introduces reports to help Registration and Integrated Billing "
^DIC(9.4,47,22,5.9,"PAH",826,1,5,0)="application users identify veterans that are registered as eligible for "
^DIC(9.4,47,22,5.9,"PAH",826,1,6,0)="Other Than Honorable and Presumptive Psychosis benefits. List their"
^DIC(9.4,47,22,5.9,"PAH",826,1,7,0)="encounters and prescription in order to assist billing."
^DIC(9.4,47,22,5.9,"PAH",827,0)="1053b^3210429"
^DIC(9.4,47,22,5.9,"PAH",827,1,0)="^^5^5^3210429"
^DIC(9.4,47,22,5.9,"PAH",827,1,1,0)="Backup of DG*5.3*1053 on Apr 29, 2021"
^DIC(9.4,47,22,5.9,"PAH",827,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",827,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,47,22,5.9,"PAH",827,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,47,22,5.9,"PAH",827,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,47,22,5.9,"PAH",828,0)="1053 SEQ #916^3210429.142224^17"
^DIC(9.4,47,22,5.9,"PAH",828,1,0)="^^8^8^3210429"
^DIC(9.4,47,22,5.9,"PAH",828,1,1,0)="Patch DG*5.3*1053 addresses the following issues(s):"
^DIC(9.4,47,22,5.9,"PAH",828,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",828,1,3,0)="1. An UNDEFINED error, EN+37^DGRUDYN, occurs when a Patient's Ward does"
^DIC(9.4,47,22,5.9,"PAH",828,1,4,0)="   not have a RAI SUBSCRIPTION NUMBER (#900.1) field in the Medical"
^DIC(9.4,47,22,5.9,"PAH",828,1,5,0)="   Center Division (#40.8) file. Also, this patch will enable the "
^DIC(9.4,47,22,5.9,"PAH",828,1,6,0)="   RAI/MDS Inpatient event capture DGRU INPATIENT CAPTURE protocol"
^DIC(9.4,47,22,5.9,"PAH",828,1,7,0)="   disabled by patch DG*5.3*1043 and put it back on the Movement"
^DIC(9.4,47,22,5.9,"PAH",828,1,8,0)="   Events v 5.0 [DGPM MOVEMENT EVENTS] protocol menu."
^DIC(9.4,47,22,5.9,"PAH",829,0)="1055b^3210607"
^DIC(9.4,47,22,5.9,"PAH",829,1,0)="^^5^5^3210607"
^DIC(9.4,47,22,5.9,"PAH",829,1,1,0)="Backup of DG*5.3*1055 on Jun 07, 2021"
^DIC(9.4,47,22,5.9,"PAH",829,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",829,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,47,22,5.9,"PAH",829,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,47,22,5.9,"PAH",829,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,47,22,5.9,"PAH",830,0)="1055 SEQ #917^3210607.093926^17"
^DIC(9.4,47,22,5.9,"PAH",830,1,0)="^^3^3^3210607"
^DIC(9.4,47,22,5.9,"PAH",830,1,1,0)="MASTER VETERAN INDEX VISTA ISSUE - TFL SITE LIST"
^DIC(9.4,47,22,5.9,"PAH",830,1,2,0)="Refer to patch DG*5.3*1055 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",830,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",831,0)="1035^3210617.130308^17"
^DIC(9.4,47,22,5.9,"PAH",831,1,0)="^^11^11^3210617"
^DIC(9.4,47,22,5.9,"PAH",831,1,1,0)="This patch introduces reports to identify veterans that have been "
^DIC(9.4,47,22,5.9,"PAH",831,1,2,0)="registered for Presumptive Psychosis (PP) benefits by using the workaround"
^DIC(9.4,47,22,5.9,"PAH",831,1,3,0)="settings, and need additional PP category settings in Registration"
^DIC(9.4,47,22,5.9,"PAH",831,1,4,0)="database. List their episodes of care and released prescription in order"
^DIC(9.4,47,22,5.9,"PAH",831,1,5,0)="to assist billing."
^DIC(9.4,47,22,5.9,"PAH",831,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",831,1,7,0)="This patch will also add any localized messaging text to the OTH button in"
^DIC(9.4,47,22,5.9,"PAH",831,1,8,0)="CPRS if it is populated for the patient. The text ""Call Registration Team"
^DIC(9.4,47,22,5.9,"PAH",831,1,9,0)="for Details."" will always be displayed and cannot be edited.  Any further"
^DIC(9.4,47,22,5.9,"PAH",831,1,10,0)="information for localized messaging can be input by the Clinical"
^DIC(9.4,47,22,5.9,"PAH",831,1,11,0)="Application Coordinator."
^DIC(9.4,47,22,5.9,"PAH",832,0)="1027^3210701.113103^17"
^DIC(9.4,47,22,5.9,"PAH",832,1,0)="^^2^2^3210701"
^DIC(9.4,47,22,5.9,"PAH",832,1,1,0)="Please see the DG*5.3*1027 patch description for detailed information "
