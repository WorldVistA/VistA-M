^DIC(9.4,165,22,1,"PAH",111,1,1,0)="This patch has the following changes:"
^DIC(9.4,165,22,1,"PAH",111,1,2,0)="-makes an update to the QUASAR Extract (ECXQSR)."
^DIC(9.4,165,22,1,"PAH",111,1,3,0)="-corrects a problem when transmitting extracts.  "
^DIC(9.4,165,22,1,"PAH",112,0)="129 SEQ #114^3101109.101642^17"
^DIC(9.4,165,22,1,"PAH",112,1,0)="^^3^3^3101109"
^DIC(9.4,165,22,1,"PAH",112,1,1,0)="This patch will update the DSS Logical Observation Identifiers Names"
^DIC(9.4,165,22,1,"PAH",112,1,2,0)="and Codes (LOINC) (#727.29) FILE by adding 120 new codes, removing "
^DIC(9.4,165,22,1,"PAH",112,1,3,0)="5 existing codes, and changing the name of 6 DSS Test names."
^DIC(9.4,165,22,1,"PAH",113,0)="123 SEQ #115^3101115.104429^17"
^DIC(9.4,165,22,1,"PAH",114,0)="128 SEQ #116^3101117.091552^17"
^DIC(9.4,165,22,1,"PAH",114,1,0)="^^4^4^3101117"
^DIC(9.4,165,22,1,"PAH",114,1,1,0)="The patch is for an error occurring on the Transfer and Discharge Extract"
^DIC(9.4,165,22,1,"PAH",114,1,2,0)="[ECXMOV], to fix a problem that is occurring on the SUR Volume Report"
^DIC(9.4,165,22,1,"PAH",114,1,3,0)="[ECX SUR VOL REPORT], and to fix a problem on the Surgery Extract "
^DIC(9.4,165,22,1,"PAH",114,1,4,0)="[ECXSURG]."
^DIC(9.4,165,22,1,"PAH",115,0)="127 SEQ #117^3101214.142701^17"
^DIC(9.4,165,22,1,"PAH",115,1,0)="^^1^1^3101214"
^DIC(9.4,165,22,1,"PAH",115,1,1,0)="FY 2011 ENHANCEMENTS"
^DIC(9.4,165,22,1,"PAH",116,0)="131 SEQ #118^3110104.143441^17"
^DIC(9.4,165,22,1,"PAH",116,1,0)="^^2^2^3110104"
^DIC(9.4,165,22,1,"PAH",116,1,1,0)="Patch ECX*3.0*131 adds 1 new clinic code to the NATIONAL CLINIC "
^DIC(9.4,165,22,1,"PAH",116,1,2,0)="(#728.441) file."
^DIC(9.4,165,22,1,"PAH",117,0)="133 SEQ #119^3110705.143711^17"
^DIC(9.4,165,22,1,"PAH",117,1,0)="^^1^1^3110705"
^DIC(9.4,165,22,1,"PAH",117,1,1,0)="This patch will address an update to the NATIONAL CLINIC (#728.441) file."
^DIC(9.4,165,22,1,"PAH",118,0)="134 SEQ #120^3111017.141838^17"
^DIC(9.4,165,22,1,"PAH",118,1,0)="^^4^4^3111017"
^DIC(9.4,165,22,1,"PAH",118,1,1,0)="This patch will update the DSS Logical Observation Identifiers Names"
^DIC(9.4,165,22,1,"PAH",118,1,2,0)="and Codes (LOINC) (#727.29) FILE by adding 19 new codes. Two of these 19 "
^DIC(9.4,165,22,1,"PAH",118,1,3,0)="codes already exist, so they will first be deleted then added to the file "
^DIC(9.4,165,22,1,"PAH",118,1,4,0)="with the new information."
^DIC(9.4,165,22,1,"PAH",119,0)="132 SEQ #121^3111102.120332^17"
^DIC(9.4,165,22,1,"PAH",119,1,0)="^^1^1^3111102"
^DIC(9.4,165,22,1,"PAH",119,1,1,0)="FY12 DSS ENHANCEMENTS"
^DIC(9.4,165,22,1,"PAH",120,0)="135 SEQ #122^3120104.091115^17"
^DIC(9.4,165,22,1,"PAH",120,1,0)="^^2^2^3120104"
^DIC(9.4,165,22,1,"PAH",120,1,1,0)="Patch ECX*3.0*135 adds 35 new clinic codes and updates the description"
^DIC(9.4,165,22,1,"PAH",120,1,2,0)="of 2 existing codes in the NATIONAL CLINIC (#728.441) file."
^DIC(9.4,165,22,1,"PAH",121,0)="137 SEQ #123^3120829.115824^17"
^DIC(9.4,165,22,1,"PAH",121,1,0)="^^18^18^3120829"
^DIC(9.4,165,22,1,"PAH",121,1,1,0)="One of the changes made in the recently released DSS FY 2012 updates "
^DIC(9.4,165,22,1,"PAH",121,1,2,0)="patch was the addition of HO2 as a feeder location for the prosthetics "
^DIC(9.4,165,22,1,"PAH",121,1,3,0)="extracts. "
^DIC(9.4,165,22,1,"PAH",121,1,4,0)=" "
^DIC(9.4,165,22,1,"PAH",121,1,5,0)="Here is the description of the change from patch ECX*3*132:"
^DIC(9.4,165,22,1,"PAH",121,1,6,0)=" "
^DIC(9.4,165,22,1,"PAH",121,1,7,0)="Modify the PRO Extract programming to create a new Feeder Location value"
^DIC(9.4,165,22,1,"PAH",121,1,8,0)="for Home Oxygen records.  Add a Feeder Location for Home Oxygen (XXXXXHO2)"
^DIC(9.4,165,22,1,"PAH",121,1,9,0)="when the ""NPPD New Code"" =  800 x (where the x represents a letter code"
^DIC(9.4,165,22,1,"PAH",121,1,10,0)="and XXXXX represents the 3 to 5 character station code plus the characters"
^DIC(9.4,165,22,1,"PAH",121,1,11,0)="H, O and 2.)."
^DIC(9.4,165,22,1,"PAH",121,1,12,0)=" "
^DIC(9.4,165,22,1,"PAH",121,1,13,0)="This change caused an error to be encountered when running the"
^DIC(9.4,165,22,1,"PAH",121,1,14,0)="Prosthetics (PRO) YTD HCPCS Report [ECX PRO YTD REPORT]."
^DIC(9.4,165,22,1,"PAH",121,1,15,0)=" "
^DIC(9.4,165,22,1,"PAH",121,1,16,0)="Also, the package date on the 2nd line of routine ECXUPRO1 was "
^DIC(9.4,165,22,1,"PAH",121,1,17,0)="inadvertently Changed, and will be changed to the correct date of Dec 22,"
^DIC(9.4,165,22,1,"PAH",121,1,18,0)="1997."
^DIC(9.4,165,22,1,"PAH",122,0)="139 SEQ #124^3120927.12461^17"
^DIC(9.4,165,22,1,"PAH",122,1,0)="^^2^2^3120927"
^DIC(9.4,165,22,1,"PAH",122,1,1,0)="Patch ECX*3.0*139 adds 14 new clinic codes and updates the description"
