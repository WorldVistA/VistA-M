^DIC(9.4,83,22,16,"PAH",62,1,56,0)="   b) Two new fields are being added to the report output: 'Detox #'"
^DIC(9.4,83,22,16,"PAH",62,1,57,0)="      and '# of Refills'."
^DIC(9.4,83,22,16,"PAH",62,1,58,0)="    "
