^DIC(9.4,3,22,21,"PAH",208,1,40,0)="Protocol Summary: "
^DIC(9.4,3,22,21,"PAH",208,1,41,0)="================"
^DIC(9.4,3,22,21,"PAH",208,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,43,0)="AME: XUHUI FIELD CHANGE EVENT          ITEM TEXT: Field Change Event"
^DIC(9.4,3,22,21,"PAH",208,1,44,0)="  DISABLE: *Do not remove this message  TYPE: extended action"
^DIC(9.4,3,22,21,"PAH",208,1,45,0)="  CREATOR: GARCIA,JOSE"
^DIC(9.4,3,22,21,"PAH",208,1,46,0)=" DESCRIPTION:   This is used to launch, in the backgound, the protocols "
^DIC(9.4,3,22,21,"PAH",208,1,47,0)="that"
^DIC(9.4,3,22,21,"PAH",208,1,48,0)=" are listed in the ITEM multiple.  Called from routine: DEQUE^XUHUI.  "
^DIC(9.4,3,22,21,"PAH",208,1,49,0)="ITEM: XUHUI SEND MESSAGE"
^DIC(9.4,3,22,21,"PAH",208,1,50,0)="ITEM: XUHUI SEND HL7 MESSAGE"
^DIC(9.4,3,22,21,"PAH",208,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,52,0)="NAME: XUHUI SEND HL7 MESSAGE            ITEM TEXT: Send HL7 MFN message"
^DIC(9.4,3,22,21,"PAH",208,1,53,0)="  DISABLE: *Do not remove this message  TYPE: action"
^DIC(9.4,3,22,21,"PAH",208,1,54,0)="  CREATOR: GARCIA,JOSE"
^DIC(9.4,3,22,21,"PAH",208,1,55,0)=" DESCRIPTION:   This Action protocol is used to send an HL7 MFN message "
^DIC(9.4,3,22,21,"PAH",208,1,56,0)="to the"
^DIC(9.4,3,22,21,"PAH",208,1,57,0)=" HUI remote middleware.  "
^DIC(9.4,3,22,21,"PAH",208,1,58,0)=" ENTRY ACTION: D ^XUHUIHL7             "
^DIC(9.4,3,22,21,"PAH",208,1,59,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,60,0)="NAME: XUHUI MFN                         TYPE: event driver"
^DIC(9.4,3,22,21,"PAH",208,1,61,0)="  CREATOR: GARCIA,JOSE"
^DIC(9.4,3,22,21,"PAH",208,1,62,0)=" DESCRIPTION:   This HL7 event protocol is one of two protocols used to"
^DIC(9.4,3,22,21,"PAH",208,1,63,0)=" generate staff/practitioner master file (MFN) messages.  This particular"
^DIC(9.4,3,22,21,"PAH",208,1,64,0)=" protocol represents the sending system.  "
^DIC(9.4,3,22,21,"PAH",208,1,65,0)="  SENDING APPLICATION: XUHUI MFN        TRANSACTION MESSAGE TYPE: MFN"
^DIC(9.4,3,22,21,"PAH",208,1,66,0)="  EVENT TYPE: M02                       VERSION ID: 2.3.1"
^DIC(9.4,3,22,21,"PAH",208,1,67,0)="  RESPONSE PROCESSING ROUTINE: Q"
^DIC(9.4,3,22,21,"PAH",208,1,68,0)="SUBSCRIBERS: XUHUI MFK"
^DIC(9.4,3,22,21,"PAH",208,1,69,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,70,0)="NAME: XUHUI MFK                         TYPE: subscriber"
^DIC(9.4,3,22,21,"PAH",208,1,71,0)="  CREATOR: GARCIA,JOSE"
^DIC(9.4,3,22,21,"PAH",208,1,72,0)=" DESCRIPTION:   This HL7 event protocol is one of two protocols used to"
^DIC(9.4,3,22,21,"PAH",208,1,73,0)=" generate staff/practitioner master file (MFN) messages.  This particular"
^DIC(9.4,3,22,21,"PAH",208,1,74,0)=" protocol represents the receiving system.  "
^DIC(9.4,3,22,21,"PAH",208,1,75,0)="  RECEIVING APPLICATION: XUHUI MFK      EVENT TYPE: M02"
^DIC(9.4,3,22,21,"PAH",208,1,76,0)="  LOGICAL LINK: HUI PROV                RESPONSE MESSAGE TYPE: MFK"
^DIC(9.4,3,22,21,"PAH",208,1,77,0)="  PROCESSING ROUTINE: Q"
^DIC(9.4,3,22,21,"PAH",208,1,78,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,79,0)="HL7 Application Parameter Summary: "
^DIC(9.4,3,22,21,"PAH",208,1,80,0)="================"
^DIC(9.4,3,22,21,"PAH",208,1,81,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,82,0)="NAME: XUHUI MFN                         ACTIVE/INACTIVE: ACTIVE"
^DIC(9.4,3,22,21,"PAH",208,1,83,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,84,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,85,0)="NAME: XUHUI MFK                         ACTIVE/INACTIVE: ACTIVE"
^DIC(9.4,3,22,21,"PAH",208,1,86,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,87,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,88,0)="HL7 Logical Link Summary: "
^DIC(9.4,3,22,21,"PAH",208,1,89,0)="================"
^DIC(9.4,3,22,21,"PAH",208,1,90,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,91,0)="NODE: HUI PROV                          LLP TYPE: TCP"
^DIC(9.4,3,22,21,"PAH",208,1,92,0)="  AUTOSTART: Enabled                    QUEUE SIZE: 10"
^DIC(9.4,3,22,21,"PAH",208,1,93,0)="  TCP/IP ADDRESS: 127.0.0.1        TCP/IP PORT: 2080"
^DIC(9.4,3,22,21,"PAH",208,1,94,0)="  TCP/IP SERVICE TYPE: CLIENT (SENDER)  "
^DIC(9.4,3,22,21,"PAH",208,1,95,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,96,0)="Installation Instructions: "
^DIC(9.4,3,22,21,"PAH",208,1,97,0)="=========================="
^DIC(9.4,3,22,21,"PAH",208,1,98,0)="This patch can be installed with VISTA users online.  However, it is "
^DIC(9.4,3,22,21,"PAH",208,1,99,0)="recommended that it be Queued for a time of generally least activity.  "
^DIC(9.4,3,22,21,"PAH",208,1,100,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,101,0)="TaskMan does not need to be STOPPED or placed in a WAIT state and "
^DIC(9.4,3,22,21,"PAH",208,1,102,0)="installation should take less than a minute."
^DIC(9.4,3,22,21,"PAH",208,1,103,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,104,0)="     1.  AXP/DSM sites: No review of mapped routine set is necessary "
^DIC(9.4,3,22,21,"PAH",208,1,105,0)="since these routines are new."
^DIC(9.4,3,22,21,"PAH",208,1,106,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,107,0)="     2.  Shutdown all Logical Links, incoming and outgoing filers, and"
^DIC(9.4,3,22,21,"PAH",208,1,108,0)="the Link Manager using the Filer and Link Management options listed "
^DIC(9.4,3,22,21,"PAH",208,1,109,0)="below:"
^DIC(9.4,3,22,21,"PAH",208,1,110,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,111,0)="       Stop All Messaging Background Processes [HL STOP ALL]"
^DIC(9.4,3,22,21,"PAH",208,1,112,0)="       TCP Link Manager Start/Stop [HL START/STOP LINK MANAGER]"
^DIC(9.4,3,22,21,"PAH",208,1,113,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,114,0)="       AXP/DSM SITES ONLY: Disable all HL7 UCX Services for this"
^DIC(9.4,3,22,21,"PAH",208,1,115,0)="       installation."
^DIC(9.4,3,22,21,"PAH",208,1,116,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,117,0)="     3.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  "
^DIC(9.4,3,22,21,"PAH",208,1,118,0)="This option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",208,1,119,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,120,0)="     4.  The patch has now been loaded into a transport global on your "
^DIC(9.4,3,22,21,"PAH",208,1,121,0)="system. You now need to use KIDS to install the transport global.  "
^DIC(9.4,3,22,21,"PAH",208,1,122,0)="  "
^DIC(9.4,3,22,21,"PAH",208,1,123,0)="     5.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,3,22,21,"PAH",208,1,124,0)="following options: "
^DIC(9.4,3,22,21,"PAH",208,1,125,0)="            Print Transport Global "
^DIC(9.4,3,22,21,"PAH",208,1,126,0)="            Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",208,1,127,0)="            Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",208,1,128,0)="            Backup a Transport Global "
^DIC(9.4,3,22,21,"PAH",208,1,129,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,130,0)="     6.  On the KIDS menu, under the 'Installation' menu, use the "
^DIC(9.4,3,22,21,"PAH",208,1,131,0)="following option: "
^DIC(9.4,3,22,21,"PAH",208,1,132,0)="            Select Installation Option: Install Package(s) "
^DIC(9.4,3,22,21,"PAH",208,1,133,0)="            Select INSTALL NAME: XU*8*239"
^DIC(9.4,3,22,21,"PAH",208,1,134,0)="                                 =========="
^DIC(9.4,3,22,21,"PAH",208,1,135,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,136,0)="        Answer 'NO' to 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,3,22,21,"PAH",208,1,137,0)="        Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,3,22,21,"PAH",208,1,138,0)="        and Protocols? "
^DIC(9.4,3,22,21,"PAH",208,1,139,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,140,0)="    7.  Start up all Logical Links and incoming and outgoing filers using "
^DIC(9.4,3,22,21,"PAH",208,1,141,0)="the Filer and Link Management Option's 'Restart/Start All Links and "
^DIC(9.4,3,22,21,"PAH",208,1,142,0)="Filers "
^DIC(9.4,3,22,21,"PAH",208,1,143,0)="[HL TASK RESTART]' menu option."
^DIC(9.4,3,22,21,"PAH",208,1,144,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,145,0)="       (Note that links that do not have ""autostart"" enabled will need"
^DIC(9.4,3,22,21,"PAH",208,1,146,0)="       to be restarted manually.)"
^DIC(9.4,3,22,21,"PAH",208,1,147,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,148,0)="       AXP/DSM SITES ONLY: If you previously disabled an HL7 UCX Service"
^DIC(9.4,3,22,21,"PAH",208,1,149,0)="       for this installation, you may enable it now."
^DIC(9.4,3,22,21,"PAH",208,1,150,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,151,0)="     8.  AXP/DSM Sites - After the patch has been installed, no rebuilding"
^DIC(9.4,3,22,21,"PAH",208,1,152,0)="your map set is necessary."
^DIC(9.4,3,22,21,"PAH",208,1,153,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,154,0)=">>> Sample Installation Dialog <<<"
^DIC(9.4,3,22,21,"PAH",208,1,155,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,156,0)="Select INSTALL NAME: XU*8.0*239       Loaded from Distribution     Loaded "
^DIC(9.4,3,22,21,"PAH",208,1,157,0)="from D"
^DIC(9.4,3,22,21,"PAH",208,1,158,0)="istribution  7/10/02@11:33:20"
^DIC(9.4,3,22,21,"PAH",208,1,159,0)="     => XU*8*239 TEST v1"
^DIC(9.4,3,22,21,"PAH",208,1,160,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,161,0)="This Distribution was loaded on Jul 10, 2002@11:33:20 with header of "
^DIC(9.4,3,22,21,"PAH",208,1,162,0)="   XU*8*239 TEST v1"
^DIC(9.4,3,22,21,"PAH",208,1,163,0)="   It consisted of the following Install(s):"
^DIC(9.4,3,22,21,"PAH",208,1,164,0)="     XU*8.0*239"
^DIC(9.4,3,22,21,"PAH",208,1,165,0)="Checking Install for Package XU*8.0*239"
^DIC(9.4,3,22,21,"PAH",208,1,166,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,167,0)="Install Questions for XU*8.0*239"
^DIC(9.4,3,22,21,"PAH",208,1,168,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,169,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,170,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,171,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",208,1,172,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",208,1,173,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,174,0)="Enter the Device you want to print the Install messages."
^DIC(9.4,3,22,21,"PAH",208,1,175,0)="You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,3,22,21,"PAH",208,1,176,0)="Enter a '^' to abort the install."
^DIC(9.4,3,22,21,"PAH",208,1,177,0)=" "
^DIC(9.4,3,22,21,"PAH",208,1,178,0)="DEVICE: HOME// 0;P-OTHER;80;999  SYSTEM"
^DIC(9.4,3,22,21,"PAH",208,1,179,0)=" "
