^DIC(9.4,4,22,1,"PAH",43,1,593,0)="             $$SUBJ      Get message subject."
^DIC(9.4,4,22,1,"PAH",43,1,594,0)="             $$ZDATE     Get message date."
^DIC(9.4,4,22,1,"PAH",43,1,595,0)="             $$ZFROM     Get message from."
^DIC(9.4,4,22,1,"PAH",43,1,596,0)="             $$ZNODE     Get message zero node."
^DIC(9.4,4,22,1,"PAH",43,1,597,0)="             $$ZPRI      Is this message priority?"
^DIC(9.4,4,22,1,"PAH",43,1,598,0)="             $$ZREAD     How many responses has the user read?"
^DIC(9.4,4,22,1,"PAH",43,1,599,0)="             $$ZSUBJ     Get message subject."
