^DIC(9.4,3,22,21,"PAH",302,1,224,0)=" Blood Bank Clearance:"
^DIC(9.4,3,22,21,"PAH",302,1,225,0)=" ============================="
^DIC(9.4,3,22,21,"PAH",302,1,226,0)=" Clearance - Apr. 21, 2005"
^DIC(9.4,3,22,21,"PAH",302,1,227,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,228,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch XU*8*366 contains"
^DIC(9.4,3,22,21,"PAH",302,1,229,0)=" changes to a package referenced in VHA OI SEPG SOP 192-023 Review of VISTA"
^DIC(9.4,3,22,21,"PAH",302,1,230,0)=" Patches for Effects on VISTA Blood Bank Software. This patch does not"
^DIC(9.4,3,22,21,"PAH",302,1,231,0)=" alter or modify any VistA Blood Bank software design safeguards or safety"
^DIC(9.4,3,22,21,"PAH",302,1,232,0)=" critical elements functions."
^DIC(9.4,3,22,21,"PAH",302,1,233,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,234,0)=" RISK ANALYSIS: Changes made by patch XU*8*366 have no effect on Blood Bank"
^DIC(9.4,3,22,21,"PAH",302,1,235,0)=" software functionality, therefore RISK is none."
^DIC(9.4,3,22,21,"PAH",302,1,236,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,237,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,238,0)=" Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",302,1,239,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,240,0)="      1.   Users ARE allowed to be on the system during the"
^DIC(9.4,3,22,21,"PAH",302,1,241,0)="      installation."
^DIC(9.4,3,22,21,"PAH",302,1,242,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,243,0)="      2.   DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",302,1,244,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",302,1,245,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,246,0)="      3.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,3,22,21,"PAH",302,1,247,0)="      This option will load the KIDS (Kernel Installation and Distribution"
^DIC(9.4,3,22,21,"PAH",302,1,248,0)="      System) package onto your system."
^DIC(9.4,3,22,21,"PAH",302,1,249,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,250,0)="      4.   You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",302,1,251,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,252,0)="      5.   The patch has now been loaded into a transport global on your"
^DIC(9.4,3,22,21,"PAH",302,1,253,0)="      system.  On the KIDS menu, select the 'Installation' menu and use"
^DIC(9.4,3,22,21,"PAH",302,1,254,0)="      the following options:"
^DIC(9.4,3,22,21,"PAH",302,1,255,0)="            Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",302,1,256,0)="            Print Transport Global"
^DIC(9.4,3,22,21,"PAH",302,1,257,0)="            Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",302,1,258,0)="            Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",302,1,259,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,260,0)="            Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",302,1,261,0)="            Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",302,1,262,0)="                                ======="
^DIC(9.4,3,22,21,"PAH",302,1,263,0)="             Install Package(s)"
^DIC(9.4,3,22,21,"PAH",302,1,264,0)="             Select INSTALL NAME: XU*8.0*366"
^DIC(9.4,3,22,21,"PAH",302,1,265,0)="                                  =========="
^DIC(9.4,3,22,21,"PAH",302,1,266,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,267,0)="         Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",302,1,268,0)="                                                               =="
^DIC(9.4,3,22,21,"PAH",302,1,269,0)="         Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,3,22,21,"PAH",302,1,270,0)="         YES// NO"
^DIC(9.4,3,22,21,"PAH",302,1,271,0)="               =="
^DIC(9.4,3,22,21,"PAH",302,1,272,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,273,0)="      6.  AXP Sites - Answer 'NO' to the question 'Want to MOVE"
^DIC(9.4,3,22,21,"PAH",302,1,274,0)="      routines to other CPUs?'."
^DIC(9.4,3,22,21,"PAH",302,1,275,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,276,0)=" "
^DIC(9.4,3,22,21,"PAH",302,1,277,0)="      7.  If the routines were unmapped as part of step 2, they should be"
^DIC(9.4,3,22,21,"PAH",302,1,278,0)="      returned to the mapped set once the installation has run to"
^DIC(9.4,3,22,21,"PAH",302,1,279,0)="      completion."
