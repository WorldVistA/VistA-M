^DIC(9.4,59,22,5,"PAH",522,0)="542^3171227.175722^54"
^DIC(9.4,59,22,5,"PAH",522,1,0)="^^16^16^3171227"
^DIC(9.4,59,22,5,"PAH",522,1,1,0)="This patch provides updates to data in several of the files associated"
^DIC(9.4,59,22,5,"PAH",522,1,2,0)="with the National Drug File (NDF) application."
^DIC(9.4,59,22,5,"PAH",522,1,3,0)="This patch generates four mail messages.  All are sent from NDF MANAGER"
^DIC(9.4,59,22,5,"PAH",522,1,4,0)="to members of the NDF DATA mail group, holders of the PSNMGR security "
^DIC(9.4,59,22,5,"PAH",522,1,5,0)="key, and the person installing the patch.  The first message, with the"
^DIC(9.4,59,22,5,"PAH",522,1,6,0)="subject DATA UPDATE FOR NDF, lists new products, CMOP ID (if one exists),"
^DIC(9.4,59,22,5,"PAH",522,1,7,0)="dispense units, and associated NDCs, products for which the national"
^DIC(9.4,59,22,5,"PAH",522,1,8,0)="formulary indicator has changed, products that have been unmatched from"
^DIC(9.4,59,22,5,"PAH",522,1,9,0)="CMOP, and products for which the national formulary restriction has"
^DIC(9.4,59,22,5,"PAH",522,1,10,0)="changed.  The second, with the subject UPDATED INTERACTIONS, lists"
^DIC(9.4,59,22,5,"PAH",522,1,11,0)="interactions that have been added, edited, or inactivated. The third, with"
^DIC(9.4,59,22,5,"PAH",522,1,12,0)="the subject DRUGS UNMATCHED FROM NATIONAL DRUG FILE, lists entries in the"
^DIC(9.4,59,22,5,"PAH",522,1,13,0)="DRUG file (#50) which have been unmatched from NDF.  The fourth, with the"
^DIC(9.4,59,22,5,"PAH",522,1,14,0)="subject INTERACTIONS and ALLERGIES UPDATED, lists interactions and allergies"
^DIC(9.4,59,22,5,"PAH",522,1,15,0)="which have been changed because they were created with ingredients that"
^DIC(9.4,59,22,5,"PAH",522,1,16,0)="are no longer primary ingredients."
^DIC(9.4,59,22,5,"PAH",523,0)="543^3171227.175904^54"
^DIC(9.4,59,22,5,"PAH",523,1,0)="^^4^4^3171227"
^DIC(9.4,59,22,5,"PAH",523,1,1,0)="The environment check routine for this patch checks to see that the"
^DIC(9.4,59,22,5,"PAH",523,1,2,0)="installer is a valid user."
^DIC(9.4,59,22,5,"PAH",523,1,3,0)="The post-install routine for this patch matches entries in the VA PRODUCT "
