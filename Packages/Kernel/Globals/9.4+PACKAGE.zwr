^DIC(9.4,128,11)="160^169.99"
^DIC(9.4,128,22,0)="^9.49I^18^2"
^DIC(9.4,128,22,11,0)="2.11^3051119^2960924"
^DIC(9.4,128,22,11,1,0)="^9.54^1^1^2940715^"
^DIC(9.4,128,22,11,1,1,0)="This is a maintenance release that adds updated SEER codes effective 1/1/94."
^DIC(9.4,128,22,11,"PAH",0)="^9.4901^53^53"
^DIC(9.4,128,22,11,"PAH",1,0)="5^2960924^1"
^DIC(9.4,128,22,11,"PAH",2,0)="6^2961224^1"
^DIC(9.4,128,22,11,"PAH",3,0)="7^2970217^1"
^DIC(9.4,128,22,11,"PAH",4,0)="8^2970317^1"
^DIC(9.4,128,22,11,"PAH",5,0)="9^2970501^1"
^DIC(9.4,128,22,11,"PAH",5,1,0)="^^2^2^2970501"
^DIC(9.4,128,22,11,"PAH",5,1,1,0)="NAACR Annual Call for Data for the years 1985, 1990, 1995.  This patch is"
^DIC(9.4,128,22,11,"PAH",5,1,2,0)="to update the NAACR Annual Call for Data to the 1995 Data extract. "
^DIC(9.4,128,22,11,"PAH",6,0)="10^2970528^1"
^DIC(9.4,128,22,11,"PAH",6,1,0)="^^1^1^2970528"
^DIC(9.4,128,22,11,"PAH",6,1,1,0)="Correction to laterality field.  Laterality will except 9 as valid input."
^DIC(9.4,128,22,11,"PAH",7,0)="11^2970630^1"
^DIC(9.4,128,22,11,"PAH",8,0)="12^2970922^1"
^DIC(9.4,128,22,11,"PAH",8,1,0)="^^4^4^2970922"
^DIC(9.4,128,22,11,"PAH",8,1,1,0)="North American Association of Central Cancer Registries (NAACCR) Annual"
^DIC(9.4,128,22,11,"PAH",8,1,2,0)="Call for Data and State Data for the years 1985, 1990, 1995.  This patch"
^DIC(9.4,128,22,11,"PAH",8,1,3,0)="is to update the NAACCR Annual Call for Data and the State Data to the"
^DIC(9.4,128,22,11,"PAH",8,1,4,0)="1995 Data extract."
^DIC(9.4,128,22,11,"PAH",9,0)="13^2971127^1"
^DIC(9.4,128,22,11,"PAH",10,0)="14^2971222^1"
^DIC(9.4,128,22,11,"PAH",10,1,0)="^^74^74^2971222"
^DIC(9.4,128,22,11,"PAH",10,1,1,0)="Dependency:"
^DIC(9.4,128,22,11,"PAH",10,1,2,0)="==========="
^DIC(9.4,128,22,11,"PAH",10,1,3,0)="     PATCH ONC*2.11*13 MUST BE INSTALLED PRIOR TO INSTALLING THIS PATCH."
^DIC(9.4,128,22,11,"PAH",10,1,4,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,5,0)="Description:"
^DIC(9.4,128,22,11,"PAH",10,1,6,0)="==========="
^DIC(9.4,128,22,11,"PAH",10,1,7,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,8,0)="This patch will enhance Oncology 2.11 to support the Commission on"
^DIC(9.4,128,22,11,"PAH",10,1,9,0)="Cancers 1996 Annual Call for Data extract for the years 1986, 1991 and"
^DIC(9.4,128,22,11,"PAH",10,1,10,0)="1996 for the National Cancer Database. The Annual Call for Data extract"
^DIC(9.4,128,22,11,"PAH",10,1,11,0)="for 1996 will also include the Soft Tissue Sarcoma and Thyroid Patient"
^DIC(9.4,128,22,11,"PAH",10,1,12,0)="Care Evaluations (PCE)s."
^DIC(9.4,128,22,11,"PAH",10,1,13,0)="The following modifications have been made."
^DIC(9.4,128,22,11,"PAH",10,1,14,0)="          "
^DIC(9.4,128,22,11,"PAH",10,1,15,0)="     1)  This option has been enhanced to include the 1996 "
^DIC(9.4,128,22,11,"PAH",10,1,16,0)="         Soft Tissue Sarcoma and Thyroid PCEs."
^DIC(9.4,128,22,11,"PAH",10,1,17,0)="     2)  The patch includes an update to the data dictionary and data for"
^DIC(9.4,128,22,11,"PAH",10,1,18,0)="         file ONCOLOGY DATA EXTRACT FORMAT (#160.16)."
^DIC(9.4,128,22,11,"PAH",10,1,19,0)="     3)  The patch includes a new data dictionary and data for file"
^DIC(9.4,128,22,11,"PAH",10,1,20,0)="         ONCOLOGY PCE EXTRACT FORMAT (#160.17)."
^DIC(9.4,128,22,11,"PAH",10,1,21,0)="     4)  File FORMS/INSTRUCTIONS (#160.2) has been modified "
^DIC(9.4,128,22,11,"PAH",10,1,22,0)="         to reflect the new data help instructions displayed/printed"
^DIC(9.4,128,22,11,"PAH",10,1,23,0)="         when creating the ACoS data disk."
^DIC(9.4,128,22,11,"PAH",10,1,24,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,25,0)="Test Sites"
^DIC(9.4,128,22,11,"PAH",10,1,26,0)="=========="
^DIC(9.4,128,22,11,"PAH",10,1,27,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,28,0)="Alpha:              "
^DIC(9.4,128,22,11,"PAH",10,1,29,0)="Washington D. C."
^DIC(9.4,128,22,11,"PAH",10,1,30,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,31,0)="Beta:"
^DIC(9.4,128,22,11,"PAH",10,1,32,0)="Boston, MA"
^DIC(9.4,128,22,11,"PAH",10,1,33,0)="Buffalo, NY"
^DIC(9.4,128,22,11,"PAH",10,1,34,0)="Washington D. C."
^DIC(9.4,128,22,11,"PAH",10,1,35,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,36,0)="Routine"
^DIC(9.4,128,22,11,"PAH",10,1,37,0)="Summary:"
^DIC(9.4,128,22,11,"PAH",10,1,38,0)="================"
^DIC(9.4,128,22,11,"PAH",10,1,39,0)="The following routines are included in this patch.  The second line of "
^DIC(9.4,128,22,11,"PAH",10,1,40,0)="these routines should look like:"
^DIC(9.4,128,22,11,"PAH",10,1,41,0)="     "
^DIC(9.4,128,22,11,"PAH",10,1,42,0)="  <tab>;;2.11;ONCOLOGY;**[patch list]**;Mar 07, 1995"
^DIC(9.4,128,22,11,"PAH",10,1,43,0)="     "
^DIC(9.4,128,22,11,"PAH",10,1,44,0)="  CHECK^XTSUMBLD results:"
^DIC(9.4,128,22,11,"PAH",10,1,45,0)="     "
^DIC(9.4,128,22,11,"PAH",10,1,46,0)="Routine Name   Before Patch    After Patch    Patch List"
^DIC(9.4,128,22,11,"PAH",10,1,47,0)="============   ============    ===========    =========="
^DIC(9.4,128,22,11,"PAH",10,1,48,0)="  ONCACD1        3718409         6115810        9,12,14"
^DIC(9.4,128,22,11,"PAH",10,1,49,0)="  ONCACDU1       3701766         4046936        12,14"
^DIC(9.4,128,22,11,"PAH",10,1,50,0)="  ONCODIS        1041660         1041724        6,7,9,10,11,12,13,14"
^DIC(9.4,128,22,11,"PAH",10,1,51,0)="  ONCPRE14        N/A              24247        14"
^DIC(9.4,128,22,11,"PAH",10,1,52,0)="     "
^DIC(9.4,128,22,11,"PAH",10,1,53,0)="     "
^DIC(9.4,128,22,11,"PAH",10,1,54,0)="Installation Instruction:"
^DIC(9.4,128,22,11,"PAH",10,1,55,0)="========================="
^DIC(9.4,128,22,11,"PAH",10,1,56,0)="This Patch is created with Kernel V8 KIDS.  Follow these instructions:"
^DIC(9.4,128,22,11,"PAH",10,1,57,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,58,0)="1) Use Packman option 'INSTALL/CHECK MESSAGE' to load the KIDS build "
^DIC(9.4,128,22,11,"PAH",10,1,59,0)="   onto your system."
^DIC(9.4,128,22,11,"PAH",10,1,60,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,61,0)="2) On the KIDS menu, under the 'Installation' menu, use the               "
^DIC(9.4,128,22,11,"PAH",10,1,62,0)="   option 'Verify Checksum in Transport Global' and verify that all     "
^DIC(9.4,128,22,11,"PAH",10,1,63,0)="   routines have the correct checksums."
^DIC(9.4,128,22,11,"PAH",10,1,64,0)="  "
^DIC(9.4,128,22,11,"PAH",10,1,65,0)="3) From the 'Installation' Menu of KIDS, use the option"
^DIC(9.4,128,22,11,"PAH",10,1,66,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,67,0)="   'Install Package(s)'.  Select the package 'ONC*2.11*14' and proceed"
^DIC(9.4,128,22,11,"PAH",10,1,68,0)="    with install."
^DIC(9.4,128,22,11,"PAH",10,1,69,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,70,0)="4) If you are a NON-DSM site, move the routines to the other servers."
^DIC(9.4,128,22,11,"PAH",10,1,71,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,72,0)="5) On a mapped system, rebuild your map set."
^DIC(9.4,128,22,11,"PAH",10,1,73,0)=" "
^DIC(9.4,128,22,11,"PAH",10,1,74,0)="6) Delete the pre-init routine ONCPRE14.   "
