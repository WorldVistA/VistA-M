^DIC(9.4,14,22,5.9,"PAH",213,1,303,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,304,0)=" Enter options you wish to mark as 'Out Of Order': LRAP"
^DIC(9.4,14,22,5.9,"PAH",213,1,305,0)="      1   LRAP       Anatomic pathology"
^DIC(9.4,14,22,5.9,"PAH",213,1,306,0)="      2   LRAP ADD       Add patient(s) to report print queue"
^DIC(9.4,14,22,5.9,"PAH",213,1,307,0)="      3   LRAP DELETE       Delete report print queue"
^DIC(9.4,14,22,5.9,"PAH",213,1,308,0)="      4   LRAP ESIG SWITCH       Turn Electronic Signature On/Off"
^DIC(9.4,14,22,5.9,"PAH",213,1,309,0)="      5   LRAP PRINT ALL ON QUEUE       Print all reports on queue"
^DIC(9.4,14,22,5.9,"PAH",213,1,310,0)=" Press <RETURN> to see more, '^' to exit this list, OR"
^DIC(9.4,14,22,5.9,"PAH",213,1,311,0)=" CHOOSE 1-5: 1  LRAP     Anatomic pathology"
^DIC(9.4,14,22,5.9,"PAH",213,1,312,0)=" "
