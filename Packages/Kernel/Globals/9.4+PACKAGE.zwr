^DIC(9.4,73,22,9,"PAH",7,1,65,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,66,0)="         AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",7,1,67,0)="         ================"
^DIC(9.4,73,22,9,"PAH",7,1,68,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,69,0)="   4. Review your Mapped Routine set. If any of the routines listed in"
^DIC(9.4,73,22,9,"PAH",7,1,70,0)="      the ROUTINE SUMMARY section are mapped on your system, they"
^DIC(9.4,73,22,9,"PAH",7,1,71,0)="      should be unmapped at this time."
^DIC(9.4,73,22,9,"PAH",7,1,72,0)="   5. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,73,22,9,"PAH",7,1,73,0)="      option will load the KIDS package onto your system."
^DIC(9.4,73,22,9,"PAH",7,1,74,0)="   6. The patch has now been loaded into a Transport global on your"
^DIC(9.4,73,22,9,"PAH",7,1,75,0)="      system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,73,22,9,"PAH",7,1,76,0)="   7. From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,73,22,9,"PAH",7,1,77,0)="      the Installation menu. On the KIDS Installation menu, you may elect"
^DIC(9.4,73,22,9,"PAH",7,1,78,0)="      to use the following options:"
^DIC(9.4,73,22,9,"PAH",7,1,79,0)="      a. Verify checksums in the Transport Global - this option will"
^DIC(9.4,73,22,9,"PAH",7,1,80,0)="         allow you to ensure the integrity of the routines that are in"
^DIC(9.4,73,22,9,"PAH",7,1,81,0)="         the Transport Global."
^DIC(9.4,73,22,9,"PAH",7,1,82,0)="      b. Print Transport Global and Compare Transport Global to the"
^DIC(9.4,73,22,9,"PAH",7,1,83,0)="         Current System - this option will allow you to view all"
^DIC(9.4,73,22,9,"PAH",7,1,84,0)="         changes that will be made when the patch is installed. It"
^DIC(9.4,73,22,9,"PAH",7,1,85,0)="         compares all components of the patch (routines, DDs,"
^DIC(9.4,73,22,9,"PAH",7,1,86,0)="         templates, etc.)."
^DIC(9.4,73,22,9,"PAH",7,1,87,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,88,0)="      c. Backup a Transport Global - this option will create a backup"
^DIC(9.4,73,22,9,"PAH",7,1,89,0)="         message of any routines exported with the patch. It will NOT"
^DIC(9.4,73,22,9,"PAH",7,1,90,0)="         backup any other changes such as DDs or templates."
^DIC(9.4,73,22,9,"PAH",7,1,91,0)="         Use the Install Package(s) options and select the package:"
^DIC(9.4,73,22,9,"PAH",7,1,92,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,93,0)="         AFJX*5.1*11."
^DIC(9.4,73,22,9,"PAH",7,1,94,0)="         =========="
^DIC(9.4,73,22,9,"PAH",7,1,95,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,96,0)="   8. If the routines were unmapped as part of step 4, the mapped set"
^DIC(9.4,73,22,9,"PAH",7,1,97,0)="      should be rebuilt once the installation has run to completion."
^DIC(9.4,73,22,9,"PAH",7,1,98,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,99,0)=" "
^DIC(9.4,73,22,9,"PAH",7,1,100,0)="."
^DIC(9.4,73,22,9,"PAH",8,0)="15 SEQ #13^2990719^1"
^DIC(9.4,73,22,9,"PAH",8,1,0)="^^133^133^2990719"
^DIC(9.4,73,22,9,"PAH",8,1,1,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,3,0)=" Subject:"
^DIC(9.4,73,22,9,"PAH",8,1,4,0)="    Network Health Exchange interface with Health Summary"
^DIC(9.4,73,22,9,"PAH",8,1,5,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,6,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,7,0)=" Category:"
^DIC(9.4,73,22,9,"PAH",8,1,8,0)="    Routine"
^DIC(9.4,73,22,9,"PAH",8,1,9,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,10,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,11,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",8,1,12,0)=" ============"
^DIC(9.4,73,22,9,"PAH",8,1,13,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,14,0)="    This patch provides for NHE to call into the Health Summary"
^DIC(9.4,73,22,9,"PAH",8,1,15,0)="    package and retrieve the same information and display the"
^DIC(9.4,73,22,9,"PAH",8,1,16,0)="    same data to the NHE users as provided by Health Summary."
^DIC(9.4,73,22,9,"PAH",8,1,17,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,18,0)="    This patch makes the software Health Summary and Y2K"
^DIC(9.4,73,22,9,"PAH",8,1,19,0)="    compliant."
^DIC(9.4,73,22,9,"PAH",8,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,21,0)="    Since this software now uses the spooling device, it is"
^DIC(9.4,73,22,9,"PAH",8,1,22,0)="    important to note that a spool device to which Health"
^DIC(9.4,73,22,9,"PAH",8,1,23,0)="    Summary output may be directed, should be entered in the"
^DIC(9.4,73,22,9,"PAH",8,1,24,0)="    Health Summary Parameters File (142.99).  The spooling"
^DIC(9.4,73,22,9,"PAH",8,1,25,0)="    device should be a legal device in the Device File which"
^DIC(9.4,73,22,9,"PAH",8,1,26,0)="    points to a directory and file on the host system."
^DIC(9.4,73,22,9,"PAH",8,1,27,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,28,0)="    AFJXADD1 - routine to put 3 additional Type entries (Current"
^DIC(9.4,73,22,9,"PAH",8,1,29,0)="    Order, Surgery Non Or Procedures & Compensation & Pension"
^DIC(9.4,73,22,9,"PAH",8,1,30,0)="    Exams) into file #537015."
^DIC(9.4,73,22,9,"PAH",8,1,31,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,32,0)="    This patch will delete all the NHE routines that are no"
^DIC(9.4,73,22,9,"PAH",8,1,33,0)="    longer used for collecting data."
^DIC(9.4,73,22,9,"PAH",8,1,34,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,35,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,36,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,37,0)="  Test Sites:"
^DIC(9.4,73,22,9,"PAH",8,1,38,0)="  ==========="
^DIC(9.4,73,22,9,"PAH",8,1,39,0)="      Clarksburg, Wilkes-Barre, Long Beach"
^DIC(9.4,73,22,9,"PAH",8,1,40,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,41,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,42,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,43,0)="  Routine Summary:"
^DIC(9.4,73,22,9,"PAH",8,1,44,0)="  ================"
^DIC(9.4,73,22,9,"PAH",8,1,45,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,46,0)="    The following is a list of the routines included in this patch."
^DIC(9.4,73,22,9,"PAH",8,1,47,0)="    The second line of each of these routines will look like:"
^DIC(9.4,73,22,9,"PAH",8,1,48,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,49,0)="    <tab>;;5.1;Network Health Exchange;*<<patch list>>**;date"
^DIC(9.4,73,22,9,"PAH",8,1,50,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,51,0)="    Routine Name     Before Patch     After Patch       Patch List"
^DIC(9.4,73,22,9,"PAH",8,1,52,0)="    ============     ============     ===========       =========="
^DIC(9.4,73,22,9,"PAH",8,1,53,0)="    AFJXADD1         << NEW >>        469389            15"
^DIC(9.4,73,22,9,"PAH",8,1,54,0)="    AFJXALRT         16928883         13284766          6,15"
^DIC(9.4,73,22,9,"PAH",8,1,55,0)="    AFJXMABX         13034650         13418618          1,2,10,11,15"
^DIC(9.4,73,22,9,"PAH",8,1,56,0)="    AFJXREW          << NEW >>        5392938           15"
^DIC(9.4,73,22,9,"PAH",8,1,57,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,58,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,59,0)="    * From CHECK^XTSUMBLD"
^DIC(9.4,73,22,9,"PAH",8,1,60,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,61,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,62,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,63,0)="  Installation Instructions:"
^DIC(9.4,73,22,9,"PAH",8,1,64,0)="  =========================="
^DIC(9.4,73,22,9,"PAH",8,1,65,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,66,0)="   1. Users are allowed to be on the system during the installation;"
^DIC(9.4,73,22,9,"PAH",8,1,67,0)="      however, it is highly recommended to do the installation"
^DIC(9.4,73,22,9,"PAH",8,1,68,0)="      when a minimal number of users are on the system."
^DIC(9.4,73,22,9,"PAH",8,1,69,0)="   2. It is not necessary to place TaskMan in a WAIT/STOP state."
^DIC(9.4,73,22,9,"PAH",8,1,70,0)="   3. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,73,22,9,"PAH",8,1,71,0)="      and Protocols? Yes// <return>, respond YES. When prompted to select"
^DIC(9.4,73,22,9,"PAH",8,1,72,0)="                                             ==="
^DIC(9.4,73,22,9,"PAH",8,1,73,0)="      the option(s) you would like to place out of order, enter the"
^DIC(9.4,73,22,9,"PAH",8,1,74,0)="      following:"
^DIC(9.4,73,22,9,"PAH",8,1,75,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,76,0)="         AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",8,1,77,0)="         ================"
^DIC(9.4,73,22,9,"PAH",8,1,78,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,79,0)="   4. Review your Mapped Routine set. If any of the routines listed in"
^DIC(9.4,73,22,9,"PAH",8,1,80,0)="      the ROUTINE SUMMARY section are mapped on your system, they"
^DIC(9.4,73,22,9,"PAH",8,1,81,0)="      should be unmapped at this time."
^DIC(9.4,73,22,9,"PAH",8,1,82,0)="   5. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu.  This"
^DIC(9.4,73,22,9,"PAH",8,1,83,0)="      option will load the KIDS package onto your system."
^DIC(9.4,73,22,9,"PAH",8,1,84,0)="   6. The patch has now been loaded into a Transport global on your"
^DIC(9.4,73,22,9,"PAH",8,1,85,0)="      system.  You now need to use KIDS to install the Transport global."
^DIC(9.4,73,22,9,"PAH",8,1,86,0)="   7. From the Kernel Installation and Distribution System (KIDS) Menu,"
^DIC(9.4,73,22,9,"PAH",8,1,87,0)="      select the Installation menu. On the KIDS Installation menu,"
^DIC(9.4,73,22,9,"PAH",8,1,88,0)="      you may elect to use the following options:"
^DIC(9.4,73,22,9,"PAH",8,1,89,0)="      a. Verify checksums in the Transport Global - this option will"
^DIC(9.4,73,22,9,"PAH",8,1,90,0)="         allow you to ensure the integrity of the routines that are in"
^DIC(9.4,73,22,9,"PAH",8,1,91,0)="         the Transport Global."
^DIC(9.4,73,22,9,"PAH",8,1,92,0)="      b. Print Transport Global and Compare Transport Global to the"
^DIC(9.4,73,22,9,"PAH",8,1,93,0)="         Current System - this option will allow you to view all"
^DIC(9.4,73,22,9,"PAH",8,1,94,0)="         changes that will be made when the patch is installed. It"
^DIC(9.4,73,22,9,"PAH",8,1,95,0)="         compares all components of the patch (routines, DDs,"
^DIC(9.4,73,22,9,"PAH",8,1,96,0)="         templates, etc.)."
^DIC(9.4,73,22,9,"PAH",8,1,97,0)="      c. Backup a Transport Global - this option will create a backup"
^DIC(9.4,73,22,9,"PAH",8,1,98,0)="         message of any routines exported with the patch. It will NOT"
^DIC(9.4,73,22,9,"PAH",8,1,99,0)="         backup any other changes such as DDs or templates."
^DIC(9.4,73,22,9,"PAH",8,1,100,0)="         Use the Install Package(s) options and select the package:"
^DIC(9.4,73,22,9,"PAH",8,1,101,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,102,0)="         AFJX*5.1*15."
^DIC(9.4,73,22,9,"PAH",8,1,103,0)="         ==========="
^DIC(9.4,73,22,9,"PAH",8,1,104,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,105,0)="   8. If the routines were unmapped as part of step 4, the mapped set"
^DIC(9.4,73,22,9,"PAH",8,1,106,0)="      should be rebuilt once the installation has run to completion."
^DIC(9.4,73,22,9,"PAH",8,1,107,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,108,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,109,0)="   9. The following routines would automatically be deleted:"
^DIC(9.4,73,22,9,"PAH",8,1,110,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,111,0)="      AFJXADHB      AFJXEN7         AFJXSPTH        AFJXWCP8"
^DIC(9.4,73,22,9,"PAH",8,1,112,0)="      AFJXADHD      AFJXEN9         AFJXSURY        AFJXWCP9"
^DIC(9.4,73,22,9,"PAH",8,1,113,0)="      AFJXADPB      AFJXEND         AFJXUNDS        AFJXWCPA"
^DIC(9.4,73,22,9,"PAH",8,1,114,0)="      AFJXALER      AFJXFIX         AFJXUNIT        AFJXWCPC"
^DIC(9.4,73,22,9,"PAH",8,1,115,0)="      AFJXBLOO      AFJXGMR1        AFJXVISI        AFJXWCPE"
^DIC(9.4,73,22,9,"PAH",8,1,116,0)="      AFJXCAH       AFJXLABO        AFJXVITA        AFJXWCPF"
^DIC(9.4,73,22,9,"PAH",8,1,117,0)="      AFJXCAHB      AFJXLRM         AFJXVITS        AFJXWCPG"
^DIC(9.4,73,22,9,"PAH",8,1,118,0)="      AFJXCAHS      AFJXLRM1        AFJXWCCW        AFJXWCPH"
^DIC(9.4,73,22,9,"PAH",8,1,119,0)="      AFJXCYTO      AFJXLROC        AFJXWCL1        AFJXWCPJ"
^DIC(9.4,73,22,9,"PAH",8,1,120,0)="      AFJXDCS1      AFJXMEDI        AFJXWCL2        AFJXWCPL"
^DIC(9.4,73,22,9,"PAH",8,1,121,0)="      AFJXDCSU      AFJXNTEG        AFJXWCL4        AFJXWCPN"
^DIC(9.4,73,22,9,"PAH",8,1,122,0)="      AFJXDIE2      AFJXORDR        AFJXWCL5        AFJXWCPR"
^DIC(9.4,73,22,9,"PAH",8,1,123,0)="      AFJXDIET      AFJXPHCY        AFJXWCL7        AFJXWCPZ"
^DIC(9.4,73,22,9,"PAH",8,1,124,0)="      AFJXDISA      AFJXPHIV        AFJXWCL8        AFJXWPN"
^DIC(9.4,73,22,9,"PAH",8,1,125,0)="      AFJXDM1       AFJXPUL2        AFJXWCL9        AFJXWPN1"
^DIC(9.4,73,22,9,"PAH",8,1,126,0)="      AFJXEN2       AFJXPULM        AFJXWCP3        AFJXWPR2"
^DIC(9.4,73,22,9,"PAH",8,1,127,0)="      AFJXEN3       AFJXRADI        AFJXWCP4        AFJXWPRG"
^DIC(9.4,73,22,9,"PAH",8,1,128,0)="      AFJXEN4       AFJXRALT        AFJXWCP5"
^DIC(9.4,73,22,9,"PAH",8,1,129,0)="      AFJXEN6       AFJXRATS        AFJXWCP6"
^DIC(9.4,73,22,9,"PAH",8,1,130,0)="                    AFJXRIMP        AFJXWCP7"
^DIC(9.4,73,22,9,"PAH",8,1,131,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,132,0)=" "
^DIC(9.4,73,22,9,"PAH",8,1,133,0)="."
^DIC(9.4,73,22,9,"PAH",9,0)="17 SEQ #14^3000405^1"
^DIC(9.4,73,22,9,"PAH",9,1,0)="^^93^93^3000405"
^DIC(9.4,73,22,9,"PAH",9,1,1,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,2,0)=" Subject:"
^DIC(9.4,73,22,9,"PAH",9,1,3,0)="    Correcting hanging jobs (going thru an infinite "
^DIC(9.4,73,22,9,"PAH",9,1,4,0)="    loop) and not receiving any data"
^DIC(9.4,73,22,9,"PAH",9,1,5,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,6,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,7,0)=" Category:"
^DIC(9.4,73,22,9,"PAH",9,1,8,0)="    Routine"
^DIC(9.4,73,22,9,"PAH",9,1,9,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,10,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,11,0)=" Description:"
^DIC(9.4,73,22,9,"PAH",9,1,12,0)=" ============"
^DIC(9.4,73,22,9,"PAH",9,1,13,0)="     This patch corrects the problem of multiple jobs that are"
^DIC(9.4,73,22,9,"PAH",9,1,14,0)="     getting caught in an infinite loop in GMTSPDX.   It also"
^DIC(9.4,73,22,9,"PAH",9,1,15,0)="     corrects the problem of getting View Alerts with no patient"
^DIC(9.4,73,22,9,"PAH",9,1,16,0)="     information included.  In addition, this patch speeds up the"
^DIC(9.4,73,22,9,"PAH",9,1,17,0)="     retrieval of the patient's information."
^DIC(9.4,73,22,9,"PAH",9,1,18,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,19,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,20,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,21,0)="  List of Test Sites:"
^DIC(9.4,73,22,9,"PAH",9,1,22,0)="  =================="
^DIC(9.4,73,22,9,"PAH",9,1,23,0)="      New York, Madison, Coatesville, Lebanon, Clarksburg,"
^DIC(9.4,73,22,9,"PAH",9,1,24,0)="  Wilkes-Barre, Long Beach, Los Angeles, Philadelphia, Mountain Home,"
^DIC(9.4,73,22,9,"PAH",9,1,25,0)="  White-City"
^DIC(9.4,73,22,9,"PAH",9,1,26,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,27,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,28,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,29,0)="  ROUTINE SUMMARY                                                  "
^DIC(9.4,73,22,9,"PAH",9,1,30,0)="  ===============                                                  "
^DIC(9.4,73,22,9,"PAH",9,1,31,0)="         "
^DIC(9.4,73,22,9,"PAH",9,1,32,0)="   The following routines are included in this patch.  The"
^DIC(9.4,73,22,9,"PAH",9,1,33,0)="   second line of each of these routines now looks like:                  "
^DIC(9.4,73,22,9,"PAH",9,1,34,0)=" "
^DIC(9.4,73,22,9,"PAH",9,1,35,0)="   <tab>;;5.1;Network Health Exchange;**[patch list]**;Date"
^DIC(9.4,73,22,9,"PAH",9,1,36,0)="                 "
^DIC(9.4,73,22,9,"PAH",9,1,37,0)="    Routine Name     Chksum Before    Chksum After      Patch List"
^DIC(9.4,73,22,9,"PAH",9,1,38,0)="    ------------     -------------    ------------      ----------"
^DIC(9.4,73,22,9,"PAH",9,1,39,0)="    AFJXALRT         13284766         13885935          6,15,17"
