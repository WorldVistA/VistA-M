^DIC(9.4,33,22,1.4,"PAH",26,1,52,0)=" "
^DIC(9.4,33,22,1.4,"PAH",26,1,53,0)="Installation Instructions: "
^DIC(9.4,33,22,1.4,"PAH",26,1,54,0)="=========================="
^DIC(9.4,33,22,1.4,"PAH",26,1,55,0)="  1.  Users are allowed to be on the system during the installation.  "
^DIC(9.4,33,22,1.4,"PAH",26,1,56,0)="  2.  DSM SITES: Review your mapped set.  If any of the routines listed in"
^DIC(9.4,33,22,1.4,"PAH",26,1,57,0)="      the Routine Summary section are mapped, they should be removed from "
^DIC(9.4,33,22,1.4,"PAH",26,1,58,0)="      the mapped set at this time.  "
^DIC(9.4,33,22,1.4,"PAH",26,1,59,0)="  3.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,33,22,1.4,"PAH",26,1,60,0)="      option will load the KIDS package onto your system.  "
^DIC(9.4,33,22,1.4,"PAH",26,1,61,0)="  4.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,33,22,1.4,"PAH",26,1,62,0)="      system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,33,22,1.4,"PAH",26,1,63,0)="      On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,33,22,1.4,"PAH",26,1,64,0)="      options: "
^DIC(9.4,33,22,1.4,"PAH",26,1,65,0)="   "
^DIC(9.4,33,22,1.4,"PAH",26,1,66,0)="         Verify Checksums in Transport Global "
^DIC(9.4,33,22,1.4,"PAH",26,1,67,0)="         Print Transport Global "
^DIC(9.4,33,22,1.4,"PAH",26,1,68,0)="         Compare Transport Global to Current System "
^DIC(9.4,33,22,1.4,"PAH",26,1,69,0)="         Backup a Transport Global "
^DIC(9.4,33,22,1.4,"PAH",26,1,70,0)="         Install Package(s) "
^DIC(9.4,33,22,1.4,"PAH",26,1,71,0)="         INSTALL NAME: HL*1.6*51 "
^DIC(9.4,33,22,1.4,"PAH",26,1,72,0)="                       ========="
^DIC(9.4,33,22,1.4,"PAH",26,1,73,0)="         Answer 'NO' to 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,33,22,1.4,"PAH",26,1,74,0)="         and Protocols?'.  "
^DIC(9.4,33,22,1.4,"PAH",26,1,75,0)="  5.  DSM Sites: Rebuild your mapped set if necessary.  "
^DIC(9.4,33,22,1.4,"PAH",27,0)="48 SEQ #40^2990602^1"
^DIC(9.4,33,22,1.4,"PAH",27,1,0)="^^46^46^2990602"
^DIC(9.4,33,22,1.4,"PAH",27,1,1,0)="This patch solves the following problems:"
^DIC(9.4,33,22,1.4,"PAH",27,1,2,0)="  NOIS BHH-0299-40326: The Logical Links, displayed on the System Monitor"
^DIC(9.4,33,22,1.4,"PAH",27,1,3,0)="                       last screen, were duplicates from some of the"
^DIC(9.4,33,22,1.4,"PAH",27,1,4,0)="                       Logical Links of its previous screen."
^DIC(9.4,33,22,1.4,"PAH",27,1,5,0)=" "
