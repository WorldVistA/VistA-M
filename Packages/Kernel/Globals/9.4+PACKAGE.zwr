^DIC(9.4,53,22,20,"PAH",26,1,2,0)="TRANSACTIONS AND BILLS."
^DIC(9.4,53,22,20,"PAH",27,0)="61 SEQ #58^2970528^1"
^DIC(9.4,53,22,20,"PAH",27,1,0)="^^1^1^2970528"
^DIC(9.4,53,22,20,"PAH",27,1,1,0)="Regional Counsel Reconciliation"
^DIC(9.4,53,22,20,"PAH",28,0)="68 SEQ #59^2970528^1"
^DIC(9.4,53,22,20,"PAH",28,1,0)="^^3^3^2970528"
^DIC(9.4,53,22,20,"PAH",28,1,1,0)="This patch to Accounts Receivable contains new cross references and"
^DIC(9.4,53,22,20,"PAH",28,1,2,0)="a post init which fixes problems with a bills status and last date"
^DIC(9.4,53,22,20,"PAH",28,1,3,0)="updated (status)."
^DIC(9.4,53,22,20,"PAH",29,0)="80 SEQ #60^2970602^1"
^DIC(9.4,53,22,20,"PAH",30,0)="82 SEQ #61^2970613^1"
^DIC(9.4,53,22,20,"PAH",30,1,0)="^^1^1^2970613"
^DIC(9.4,53,22,20,"PAH",30,1,1,0)="<Null subscript> error in RCRCREC2"
^DIC(9.4,53,22,20,"PAH",31,0)="71 SEQ #62^2970619^1"
^DIC(9.4,53,22,20,"PAH",31,1,0)="^^17^17^2970619"
^DIC(9.4,53,22,20,"PAH",31,1,1,0)=" This patch fixes two problems:"
^DIC(9.4,53,22,20,"PAH",31,1,2,0)="  "
^DIC(9.4,53,22,20,"PAH",31,1,3,0)=" NOIS ISH-0297-40249"
^DIC(9.4,53,22,20,"PAH",31,1,4,0)=" - When creating a deposit ticket using the option, Create Deposit Ticket"
^DIC(9.4,53,22,20,"PAH",31,1,5,0)=" [PRCA CREATE DEPOSIT], the help text for entering a ""?"" at the prompt is"
^DIC(9.4,53,22,20,"PAH",31,1,6,0)=" inconsistent with the help text displayed when the user enters an invalid"
^DIC(9.4,53,22,20,"PAH",31,1,7,0)=" deposit ticket.  When entering a ""?"" the help text states the ticket"
^DIC(9.4,53,22,20,"PAH",31,1,8,0)=" number must be 6 digits. When entering an invalid ticket number the help"
^DIC(9.4,53,22,20,"PAH",31,1,9,0)=" text states the ticket must be 6 characters.  The patch has changed the"
^DIC(9.4,53,22,20,"PAH",31,1,10,0)=" help so it states 6 digits."
^DIC(9.4,53,22,20,"PAH",31,1,11,0)="  "
^DIC(9.4,53,22,20,"PAH",31,1,12,0)=" NOIS CLE-0197-40420"
^DIC(9.4,53,22,20,"PAH",31,1,13,0)=" - When waiving part of a 5014/2431 bill's balance using the Partial"
^DIC(9.4,53,22,20,"PAH",31,1,14,0)=" Waiver option [PRCAC  WAIVED PART], the software generates a Billing"
^DIC(9.4,53,22,20,"PAH",31,1,15,0)=" Document to be transmitted to FMS.  Since only detailed bill transactions"
^DIC(9.4,53,22,20,"PAH",31,1,16,0)=" should be sent to FMS, this patch ensures that summary bill's waivers do"
^DIC(9.4,53,22,20,"PAH",31,1,17,0)=" not get transmitted to FMS."
^DIC(9.4,53,22,20,"PAH",32,0)="81 SEQ #63^2970627^1"
^DIC(9.4,53,22,20,"PAH",32,1,0)="^^6^6^2970627"
^DIC(9.4,53,22,20,"PAH",32,1,1,0)="This patch fixes the multiple ""PRCA"" entries in ""C"""
^DIC(9.4,53,22,20,"PAH",32,1,2,0)="cross-reference of the package file.  There should be only"
^DIC(9.4,53,22,20,"PAH",32,1,3,0)="one PRCA prefix for the Accounts Receivable package.  Nothing"
^DIC(9.4,53,22,20,"PAH",32,1,4,0)="gets updated if there is only one package that has the PRCA"
^DIC(9.4,53,22,20,"PAH",32,1,5,0)="prefix.  Those packages that have the PRCA prefix and should"
^DIC(9.4,53,22,20,"PAH",32,1,6,0)="not, will have the prefix changed to PRCZ."
^DIC(9.4,53,22,20,"PAH",33,0)=81
^DIC(9.4,53,22,20,"PAH",33,1,0)="^^6^6^2970627"
^DIC(9.4,53,22,20,"PAH",33,1,1,0)="This patch fixes the multiple ""PRCA"" entries in ""C"""
^DIC(9.4,53,22,20,"PAH",33,1,2,0)="cross-reference of the package file.  There should be only"
^DIC(9.4,53,22,20,"PAH",33,1,3,0)="one PRCA prefix for the Accounts Receivable package.  Nothing"
^DIC(9.4,53,22,20,"PAH",33,1,4,0)="gets updated if there is only one package that has the PRCA"
^DIC(9.4,53,22,20,"PAH",33,1,5,0)="prefix.  Those packages that have the PRCA prefix and should"
^DIC(9.4,53,22,20,"PAH",33,1,6,0)="not, will have the prefix changed to PRCZ."
^DIC(9.4,53,22,20,"PAH",34,0)="48^2970808^1"
^DIC(9.4,53,22,20,"PAH",34,1,0)="^^1^1^2970808"
^DIC(9.4,53,22,20,"PAH",34,1,1,0)="This patch provides support for the Tricare billing program."
