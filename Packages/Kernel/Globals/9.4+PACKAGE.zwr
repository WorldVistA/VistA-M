^DIC(9.4,14,22,5.9,"PAH",118,1,208,0)="2^GLUCOSE^SERUM^72^84330.0000^0^2342-4"
^DIC(9.4,14,22,5.9,"PAH",118,1,209,0)="2^GLUCOSE^SERUM^72^84330.0000^3035^2342-4"
^DIC(9.4,14,22,5.9,"PAH",118,1,210,0)="2^GLUCOSE^SERUM^72^84330.0000^3103^2342-4"
^DIC(9.4,14,22,5.9,"PAH",118,1,211,0)="2^GLUCOSE^SERUM^72^84330.0000^8638^2342-4"
^DIC(9.4,14,22,5.9,"PAH",118,1,212,0)="3^UREA NITROGEN^RIGHT KIDNEY^11^84520.0000^0^3097-3"
^DIC(9.4,14,22,5.9,"PAH",118,1,213,0)="3^UREA NITROGEN^SERUM^72^84520.0000^0^6299-2"
^DIC(9.4,14,22,5.9,"PAH",118,1,214,0)="3^UREA NITROGEN^SERUM^72^84520.0000^3035^6299-2"
^DIC(9.4,14,22,5.9,"PAH",118,1,215,0)="3^UREA NITROGEN^SERUM^72^84520.0000^3103^6299-2"
^DIC(9.4,14,22,5.9,"PAH",118,1,216,0)="4^CREATININE^Missing^.8^82565.0000^0^2160-0"
^DIC(9.4,14,22,5.9,"PAH",118,1,217,0)="4^CREATININE^Missing^.9^82565.0000^0^2160-0"
^DIC(9.4,14,22,5.9,"PAH",118,1,218,0)="4^CREATININE^SERUM^72^82565.0000^0^2160-0"
^DIC(9.4,14,22,5.9,"PAH",118,1,219,0)="4^CREATININE^SERUM^72^82565.0000^3103^2160-0"
^DIC(9.4,14,22,5.9,"PAH",118,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,221,0)="B. STOP LOINC Mapping [LR LOINC HISTORICAL STOP 63] option"
^DIC(9.4,14,22,5.9,"PAH",118,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,223,0)="This option will stop all background LOINC historical mapping tasks. If "
^DIC(9.4,14,22,5.9,"PAH",118,1,224,0)="for some reason the user wishes to stop/suspend LOINC mapping, this "
^DIC(9.4,14,22,5.9,"PAH",118,1,225,0)="option will stop all background tasks. To continue the mapping process "
^DIC(9.4,14,22,5.9,"PAH",118,1,226,0)="from the last LRDFN, use the primary option, LAB DATA LOINC mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,227,0)="Option."
^DIC(9.4,14,22,5.9,"PAH",118,1,228,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,229,0)="Example of the option:"
^DIC(9.4,14,22,5.9,"PAH",118,1,230,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,231,0)="Select LOINC Historical Mapping Menu Option: STOP LOINC Mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,232,0)="     Stopping all background LOINC historical mapping jobs"
^DIC(9.4,14,22,5.9,"PAH",118,1,233,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,234,0)="Are you certain you want to continue? <YES>"
^DIC(9.4,14,22,5.9,"PAH",118,1,235,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,236,0)="End of example"
^DIC(9.4,14,22,5.9,"PAH",118,1,237,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",118,1,238,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,239,0)="C. Restart LOINC Historical Mapping [LR LOINC HISTORICAL RESTART 63]"
^DIC(9.4,14,22,5.9,"PAH",118,1,240,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,241,0)="This option will restart the mapping process from the very beginning. "
^DIC(9.4,14,22,5.9,"PAH",118,1,242,0)="This option will reset all counters and reinitiate the ^XTMP(""LRLNC63"") "
^DIC(9.4,14,22,5.9,"PAH",118,1,243,0)="global. After the temporary mapping globals have been reset, a call is "
^DIC(9.4,14,22,5.9,"PAH",118,1,244,0)="made to the LAB DATA LOINC Mapping entry point. Rerunning this option is "
^DIC(9.4,14,22,5.9,"PAH",118,1,245,0)="not harmful but the same 24 hours of low system usage considerations "
^DIC(9.4,14,22,5.9,"PAH",118,1,246,0)="should be honored. "
^DIC(9.4,14,22,5.9,"PAH",118,1,247,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,248,0)="Option is locked with the XUPROGMODE security key."
^DIC(9.4,14,22,5.9,"PAH",118,1,249,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,250,0)="  Example of the option:"
^DIC(9.4,14,22,5.9,"PAH",118,1,251,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,252,0)="Restart LOINC Historical Mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,253,0)=" This will re-run LOINC Historical Mapping from the beginning"
^DIC(9.4,14,22,5.9,"PAH",118,1,254,0)="                         resetting all globals to zero."
^DIC(9.4,14,22,5.9,"PAH",118,1,255,0)="                    To restart from a stopping point use the"
^DIC(9.4,14,22,5.9,"PAH",118,1,256,0)="                         LAB DATA LOINC Mapping Option."
^DIC(9.4,14,22,5.9,"PAH",118,1,257,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,258,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,259,0)="Are you certain you want to proceed? <YES>"
^DIC(9.4,14,22,5.9,"PAH",118,1,260,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,261,0)=" D STOP^LRLNC63 to stop all background historical mapping tasks."
^DIC(9.4,14,22,5.9,"PAH",118,1,262,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,263,0)=" This option should be run during 24 hour off peak time frame!!"
^DIC(9.4,14,22,5.9,"PAH",118,1,264,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,265,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,266,0)="        This option will queue multiple tasks to LOINC map"
^DIC(9.4,14,22,5.9,"PAH",118,1,267,0)="                    historical data in the LAB DATA (#63)."
^DIC(9.4,14,22,5.9,"PAH",118,1,268,0)="Are you certain you wish to proceed? <YES> "
^DIC(9.4,14,22,5.9,"PAH",118,1,269,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,270,0)="End of option example."
^DIC(9.4,14,22,5.9,"PAH",118,1,271,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,272,0)="================="
^DIC(9.4,14,22,5.9,"PAH",118,1,273,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,274,0)="D. Modify LOINC Historical Mapping [LR LOINC HISTORICAL MODIFY]"
^DIC(9.4,14,22,5.9,"PAH",118,1,275,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,276,0)="This is a very powerful utility option to be used to reconcile previous "
^DIC(9.4,14,22,5.9,"PAH",118,1,277,0)="LOINC historical mapping. A knowledgeable LOINC mapper (Laboratory "
^DIC(9.4,14,22,5.9,"PAH",118,1,278,0)="Information Manager) is required to properly implement this functionality."
^DIC(9.4,14,22,5.9,"PAH",118,1,279,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,280,0)="After the initial historical mapping has been completed, adjustments "
^DIC(9.4,14,22,5.9,"PAH",118,1,281,0)="maybe required to modify the LOINC code lookup parameters to properly map "
^DIC(9.4,14,22,5.9,"PAH",118,1,282,0)="past results. Careful review of current LOINC mapping should be done to "
^DIC(9.4,14,22,5.9,"PAH",118,1,283,0)="establish IF there is a systematic error in LOINC code assignments. File "
^DIC(9.4,14,22,5.9,"PAH",118,1,284,0)="definition corrections should be done to prevent future LOINC mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,285,0)="errors. Re-running LAB DATA LOINC Mapping [LR LOINC HISTORICAL MAPPER 63] "
^DIC(9.4,14,22,5.9,"PAH",118,1,286,0)="option will correct incorrectly assigned LOINC code problems.  "
^DIC(9.4,14,22,5.9,"PAH",118,1,287,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,288,0)="In those situations when editing LOINC mapping definition is not "
^DIC(9.4,14,22,5.9,"PAH",118,1,289,0)="desirable, this option provides a method for the user to intervene in the "
^DIC(9.4,14,22,5.9,"PAH",118,1,290,0)="mapping lookup logic for specific tests."
^DIC(9.4,14,22,5.9,"PAH",118,1,291,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,292,0)="The user is able to select a lab test(s) [Atomic or Panel], then assign a "
^DIC(9.4,14,22,5.9,"PAH",118,1,293,0)="specific suffix code to be used during LOINC mapping logic. In addition "
^DIC(9.4,14,22,5.9,"PAH",118,1,294,0)="the user is able to force the Result NLT CODE (#64.1) of LABORATORY TEST "
^DIC(9.4,14,22,5.9,"PAH",118,1,295,0)="(#60) for the test and the designated suffix code pair to override "
^DIC(9.4,14,22,5.9,"PAH",118,1,296,0)="previous LOINC mapping.  "
^DIC(9.4,14,22,5.9,"PAH",118,1,297,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,298,0)="This is a very powerful feature, great care and study of systematic "
^DIC(9.4,14,22,5.9,"PAH",118,1,299,0)="errors should be used before attempting correct past LOINC mapping "
^DIC(9.4,14,22,5.9,"PAH",118,1,300,0)="systematic errors."
^DIC(9.4,14,22,5.9,"PAH",118,1,301,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,302,0)="After the user has completed the modify LOINC mapping procedures, the LAB "
^DIC(9.4,14,22,5.9,"PAH",118,1,303,0)="DATA LOINC Mapping option is called. All considerations of this option "
^DIC(9.4,14,22,5.9,"PAH",118,1,304,0)="still apply. Most notably, only performing this mapping exercise during "
^DIC(9.4,14,22,5.9,"PAH",118,1,305,0)="week ends or in a 24 period of lowest system activity. Even with the "
^DIC(9.4,14,22,5.9,"PAH",118,1,306,0)="increased logic iterations, the process should complete within the 24 hr "
^DIC(9.4,14,22,5.9,"PAH",118,1,307,0)="window of time.  "
^DIC(9.4,14,22,5.9,"PAH",118,1,308,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,309,0)="This option will allow the user to manage how a specific data name (test) "
^DIC(9.4,14,22,5.9,"PAH",118,1,310,0)="will be mapped to LOINC Codes for historical data. The user is able to "
^DIC(9.4,14,22,5.9,"PAH",118,1,311,0)="override file definitions to correct past LOINC mappings."
^DIC(9.4,14,22,5.9,"PAH",118,1,312,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,313,0)=" 1. Select the CH subscripted test"
^DIC(9.4,14,22,5.9,"PAH",118,1,314,0)=" 2. Indicate the suffix to be used."
^DIC(9.4,14,22,5.9,"PAH",118,1,315,0)=" 3. The user can indicate if this suffix should override previous LOINC "
^DIC(9.4,14,22,5.9,"PAH",118,1,316,0)="    Mapping. "
^DIC(9.4,14,22,5.9,"PAH",118,1,317,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,318,0)="   Example of the option:"
^DIC(9.4,14,22,5.9,"PAH",118,1,319,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,320,0)="This option will REMAP your entire database using the parameters defined "
^DIC(9.4,14,22,5.9,"PAH",118,1,321,0)="by this option. "
^DIC(9.4,14,22,5.9,"PAH",118,1,322,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,323,0)="This option should only be run on week ends or after hours.  "
^DIC(9.4,14,22,5.9,"PAH",118,1,324,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,325,0)="   Do you wish to continue ? <YES> "
^DIC(9.4,14,22,5.9,"PAH",118,1,326,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,327,0)="    Selection can be a 'CH' Atomic or Panel test .  "
^DIC(9.4,14,22,5.9,"PAH",118,1,328,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,329,0)=" Select test you want to modify mapping: <CBC> "
^DIC(9.4,14,22,5.9,"PAH",118,1,330,0)=" Select Suffix Code: <.4322>    COULTER ELECTRONICS "
^DIC(9.4,14,22,5.9,"PAH",118,1,331,0)=" Override previous LOINC mapping? <YES> "
^DIC(9.4,14,22,5.9,"PAH",118,1,332,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,333,0)="          Selection can be a 'CH' Atomic or Panel test.  "
^DIC(9.4,14,22,5.9,"PAH",118,1,334,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,335,0)="  Select test you want to modify mapping: <CALCIUM>  "
^DIC(9.4,14,22,5.9,"PAH",118,1,336,0)="   Select Suffix Code: <AA DIRECT>   .3901   NOT SPECIFIED"
^DIC(9.4,14,22,5.9,"PAH",118,1,337,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,338,0)="  Override previous LOINC mapping? <ret>"
^DIC(9.4,14,22,5.9,"PAH",118,1,339,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,340,0)="       Selection can be a 'CH' Atomic or Panel test  "
^DIC(9.4,14,22,5.9,"PAH",118,1,341,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,342,0)="  Select test you want to modify mapping: <ret>"
^DIC(9.4,14,22,5.9,"PAH",118,1,343,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,344,0)="      Here is a list of what you have selected. "
^DIC(9.4,14,22,5.9,"PAH",118,1,345,0)="              [O] indicates override current mapping"
^DIC(9.4,14,22,5.9,"PAH",118,1,346,0)=" .  DEVICE: HOME//     Right Margin:80//"
^DIC(9.4,14,22,5.9,"PAH",118,1,347,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,348,0)="  1 [0] WBC           COULTER A      /.4322"
^DIC(9.4,14,22,5.9,"PAH",118,1,349,0)="  2 [0] MCV           COULTER A      /.4322"
^DIC(9.4,14,22,5.9,"PAH",118,1,350,0)="  3 [0] MCH           COULTER A      /.4322"
^DIC(9.4,14,22,5.9,"PAH",118,1,351,0)="  4 [0] MCHC          COULTER A      /.4322"
^DIC(9.4,14,22,5.9,"PAH",118,1,352,0)="  5 [0] RDW           COULTER A      /.4322"
^DIC(9.4,14,22,5.9,"PAH",118,1,353,0)="  6     CALCIUM       AA DIRECT      /. 3901 "
^DIC(9.4,14,22,5.9,"PAH",118,1,354,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,355,0)=" You wish to add more? <ret>"
^DIC(9.4,14,22,5.9,"PAH",118,1,356,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,357,0)=" Do you want to delete an entry? <ret>"
^DIC(9.4,14,22,5.9,"PAH",118,1,358,0)="   "
^DIC(9.4,14,22,5.9,"PAH",118,1,359,0)="[NOTE: Those tests in the panel or atomic test that do not have a RESULT "
^DIC(9.4,14,22,5.9,"PAH",118,1,360,0)="NLT CODE (RNLT) assigned will be omitted. If this is the case, abort and "
^DIC(9.4,14,22,5.9,"PAH",118,1,361,0)="attend to the missing tests RNLT codes.] "
^DIC(9.4,14,22,5.9,"PAH",118,1,362,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,363,0)="3.   Resolving the $SELECT  statements for normal ranges"
^DIC(9.4,14,22,5.9,"PAH",118,1,364,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,365,0)="This functionality provided by this patch is to resolve the normal "
^DIC(9.4,14,22,5.9,"PAH",118,1,366,0)="range data stored in a $SELECT format in the LAB DATA file (63). This "
^DIC(9.4,14,22,5.9,"PAH",118,1,367,0)="patch will determine the appropriate normal range for the result by "
^DIC(9.4,14,22,5.9,"PAH",118,1,368,0)="resolving the $S( statement using the age of the patient at the time the "
^DIC(9.4,14,22,5.9,"PAH",118,1,369,0)="specimen was collected. The $SELECT statement will be replaced with the "
^DIC(9.4,14,22,5.9,"PAH",118,1,370,0)="appropriate numerical value."
^DIC(9.4,14,22,5.9,"PAH",118,1,371,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,372,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,373,0)="The routines LRVER4 and LRVR4 are installed with this patch to prevent "
^DIC(9.4,14,22,5.9,"PAH",118,1,374,0)="the storage of the $S statement in ^LR(LRDFN,""CH"",LRIDT,LRSB) for future "
^DIC(9.4,14,22,5.9,"PAH",118,1,375,0)="results."
^DIC(9.4,14,22,5.9,"PAH",118,1,376,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,377,0)="The routine LRDAGE provides the patient's age at the time when the "
^DIC(9.4,14,22,5.9,"PAH",118,1,378,0)="specimen was collected. The resulting age is used to determine normal "
^DIC(9.4,14,22,5.9,"PAH",118,1,379,0)="range values for historical data."
^DIC(9.4,14,22,5.9,"PAH",118,1,380,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,381,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,382,0)=" NEW FILES OR FIELDS:"
^DIC(9.4,14,22,5.9,"PAH",118,1,383,0)=" ==================="
^DIC(9.4,14,22,5.9,"PAH",118,1,384,0)=" Two new fields are added during installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",118,1,385,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,386,0)=" In the LABORATORY SITE (#69.9) file the following fields have been added."
^DIC(9.4,14,22,5.9,"PAH",118,1,387,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,388,0)=" LOINC HISTORICAL MAPPING DATE (#95.3) field. "
^DIC(9.4,14,22,5.9,"PAH",118,1,389,0)=" This is the date that the LOINC Historical mapping was completed. The "
^DIC(9.4,14,22,5.9,"PAH",118,1,390,0)=" LAB DATA LOINC Mapping [LR LOINC HISTORICAL MAPPER 63] option populates"
^DIC(9.4,14,22,5.9,"PAH",118,1,391,0)=" this field after it has successfully completed all mapping."
^DIC(9.4,14,22,5.9,"PAH",118,1,392,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,393,0)=" LOINC HISTORICAL LAST LRDFN (#95.31) field."
^DIC(9.4,14,22,5.9,"PAH",118,1,394,0)=" This field is populated by the primary LOINC mapping option if all batch "
^DIC(9.4,14,22,5.9,"PAH",118,1,395,0)=" (sequences) successfully run to completion."
^DIC(9.4,14,22,5.9,"PAH",118,1,396,0)=" This field contains the last LRDFN that was mapped by the LAB DATA LOINC "
^DIC(9.4,14,22,5.9,"PAH",118,1,397,0)=" Mapping [LR LOINC HISTORICAL MAPPER 63] option."
^DIC(9.4,14,22,5.9,"PAH",118,1,398,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,399,0)=" ASSOCIATED NOIS"
^DIC(9.4,14,22,5.9,"PAH",118,1,400,0)=" ==============="
^DIC(9.4,14,22,5.9,"PAH",118,1,401,0)="   NONE"
^DIC(9.4,14,22,5.9,"PAH",118,1,402,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,403,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,404,0)=" TEST SITES"
^DIC(9.4,14,22,5.9,"PAH",118,1,405,0)=" =========="
^DIC(9.4,14,22,5.9,"PAH",118,1,406,0)="  Minneapolis, MN"
^DIC(9.4,14,22,5.9,"PAH",118,1,407,0)="  North Chicago, Il"
^DIC(9.4,14,22,5.9,"PAH",118,1,408,0)="  Milwaukee, WI"
^DIC(9.4,14,22,5.9,"PAH",118,1,409,0)="  Salem, NC"
^DIC(9.4,14,22,5.9,"PAH",118,1,410,0)="  Martinez, CA"
^DIC(9.4,14,22,5.9,"PAH",118,1,411,0)="  Palo Alto, CA"
^DIC(9.4,14,22,5.9,"PAH",118,1,412,0)="  Durham, NC"
^DIC(9.4,14,22,5.9,"PAH",118,1,413,0)="  Long Beach, CA"
^DIC(9.4,14,22,5.9,"PAH",118,1,414,0)="  Muskogee, OK"
^DIC(9.4,14,22,5.9,"PAH",118,1,415,0)="  Fargo, ND"
^DIC(9.4,14,22,5.9,"PAH",118,1,416,0)="  Cincinnati, OH"
^DIC(9.4,14,22,5.9,"PAH",118,1,417,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,418,0)=" ROUTINE SUMMARY "
^DIC(9.4,14,22,5.9,"PAH",118,1,419,0)=" ==============="
^DIC(9.4,14,22,5.9,"PAH",118,1,420,0)=" The following routines are included in this patch. The second line of "
^DIC(9.4,14,22,5.9,"PAH",118,1,421,0)=" these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",118,1,422,0)=" <tab> ;;5.2;LAB SERVICE;<patch list>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",118,1,423,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,424,0)=" Routine     Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",118,1,425,0)=" Name        Before Patch   After Patch   Patch List"
^DIC(9.4,14,22,5.9,"PAH",118,1,426,0)=" LR279       N/A            6316492       279 (Deleted"
^DIC(9.4,14,22,5.9,"PAH",118,1,427,0)="                                               by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",118,1,428,0)=" LRDAGE      N/A            1480375       279"
^DIC(9.4,14,22,5.9,"PAH",118,1,429,0)=" LRLNC63     N/A            14818231      279"
^DIC(9.4,14,22,5.9,"PAH",118,1,430,0)=" LRLNC63A    N/A            9008516       279"
^DIC(9.4,14,22,5.9,"PAH",118,1,431,0)=" LRLNC63B    N/A            7526980       279"
^DIC(9.4,14,22,5.9,"PAH",118,1,432,0)=" LRVER4      19181995       18527473      14,42,112,121,140"
^DIC(9.4,14,22,5.9,"PAH",118,1,433,0)="                                          171,153,188,279"
^DIC(9.4,14,22,5.9,"PAH",118,1,434,0)=" LRVR4       8661306        8664360       14,42,121,153,221"
^DIC(9.4,14,22,5.9,"PAH",118,1,435,0)="                                          263,279"
^DIC(9.4,14,22,5.9,"PAH",118,1,436,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,437,0)=" List of preceding required patches:"
^DIC(9.4,14,22,5.9,"PAH",118,1,438,0)=" LR*5.2*188, LR*5.2*232, LR*5.2*263, LR*5.2*278"
^DIC(9.4,14,22,5.9,"PAH",118,1,439,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,440,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",118,1,441,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,442,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,443,0)=" INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",118,1,444,0)=" ========================="
^DIC(9.4,14,22,5.9,"PAH",118,1,445,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,446,0)="The install time for this patch is less than 5 minutes. Laboratory users "
^DIC(9.4,14,22,5.9,"PAH",118,1,447,0)="should be off the system during installation. All other user may remain "
^DIC(9.4,14,22,5.9,"PAH",118,1,448,0)="on the system."
^DIC(9.4,14,22,5.9,"PAH",118,1,449,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,450,0)="Patch installation should be coordinated with the Laboratory Information "
^DIC(9.4,14,22,5.9,"PAH",118,1,451,0)="Manager (LIM)."
^DIC(9.4,14,22,5.9,"PAH",118,1,452,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,453,0)=" 1. If any of the above routines are mapped, disable mapping for those "
^DIC(9.4,14,22,5.9,"PAH",118,1,454,0)=" routines."
^DIC(9.4,14,22,5.9,"PAH",118,1,455,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,456,0)=" 2. Use the 'INSTALL/CHECK MESSAGE' option of the PackMan Menu. This "
^DIC(9.4,14,22,5.9,"PAH",118,1,457,0)=" option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",118,1,458,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,459,0)=" 3. The patch has now been loaded into a Transport global on your system. "
^DIC(9.4,14,22,5.9,"PAH",118,1,460,0)=" You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",118,1,461,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,462,0)=" 4. On the 'Kernel Installation & Distribution System's Menu (KIDS) "
^DIC(9.4,14,22,5.9,"PAH",118,1,463,0)=" select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",118,1,464,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,465,0)=" 5. Use the 'Verify Checksum in transport Global' option and verify that "
^DIC(9.4,14,22,5.9,"PAH",118,1,466,0)=" all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",118,1,467,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,468,0)=" 6. On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,14,22,5.9,"PAH",118,1,469,0)=" options:"
^DIC(9.4,14,22,5.9,"PAH",118,1,470,0)="     Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",118,1,471,0)="     Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",118,1,472,0)="     Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",118,1,473,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,474,0)="    If you wish to preserve a copy of the routines exported in this patch "
^DIC(9.4,14,22,5.9,"PAH",118,1,475,0)=" prior to installation, you should use the 'Backup a Transport Global' "
^DIC(9.4,14,22,5.9,"PAH",118,1,476,0)=" option. You may also compare the routines on your system to the routines "
^DIC(9.4,14,22,5.9,"PAH",118,1,477,0)=" in the patch by using the 'Compare a Transport Global to your Current "
^DIC(9.4,14,22,5.9,"PAH",118,1,478,0)=" System' option."
^DIC(9.4,14,22,5.9,"PAH",118,1,479,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,480,0)=" 7. Use the 'Install Package(s)' option under the 'Installation' menu and "
^DIC(9.4,14,22,5.9,"PAH",118,1,481,0)=" select the package 'LR*5.2*279'."
^DIC(9.4,14,22,5.9,"PAH",118,1,482,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,483,0)=" When prompted 'Want KIDS to INHIBIT LOGONs during install? YES// choose"
^DIC(9.4,14,22,5.9,"PAH",118,1,484,0)="'NO'."
^DIC(9.4,14,22,5.9,"PAH",118,1,485,0)=" "
^DIC(9.4,14,22,5.9,"PAH",118,1,486,0)=" When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",118,1,487,0)=" Protocols? YES//', choose 'NO'"
^DIC(9.4,14,22,5.9,"PAH",118,1,488,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,489,0)=" 8. On mapped system, rebuild map set"
^DIC(9.4,14,22,5.9,"PAH",118,1,490,0)="  "
^DIC(9.4,14,22,5.9,"PAH",118,1,491,0)=" 9. Routine LR279 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",118,1,492,0)=" "
