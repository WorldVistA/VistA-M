^DIC(9.4,60,22,13,"PAH",79,1,161,0)="               Jan 18, 2002@14:39:49"
^DIC(9.4,60,22,13,"PAH",79,1,162,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,163,0)="Build Distribution Date: Jan 18, 2002"
^DIC(9.4,60,22,13,"PAH",79,1,164,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,165,0)=" Installing Routines:"
^DIC(9.4,60,22,13,"PAH",79,1,166,0)="               Jan 18, 2002@14:39:49"
^DIC(9.4,60,22,13,"PAH",79,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,168,0)=" Running Post-Install Routine: ^PSOCPIBF"
^DIC(9.4,60,22,13,"PAH",79,1,169,0)="The background job to clean up unbilled, released CMOP prescription fills"
^DIC(9.4,60,22,13,"PAH",79,1,170,0)="must"
^DIC(9.4,60,22,13,"PAH",79,1,171,0)="be queued to run and complete before 02/01/2002 when tracking for the"
^DIC(9.4,60,22,13,"PAH",79,1,172,0)="annual copay cap begins."
^DIC(9.4,60,22,13,"PAH",79,1,173,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,174,0)="If no start date/time is entered when prompted, the background job will be"
^DIC(9.4,60,22,13,"PAH",79,1,175,0)="queued to run NOW."
^DIC(9.4,60,22,13,"PAH",79,1,176,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,177,0)="CMOP patch PSX*2*35 was first installed at your facility on SEP 15,"
^DIC(9.4,60,22,13,"PAH",79,1,178,0)="2001@14:15:4"
^DIC(9.4,60,22,13,"PAH",79,1,179,0)=4
^DIC(9.4,60,22,13,"PAH",79,1,180,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,181,0)="The Outpatient Site (File #59) parameter, 'BARCODES ON ACTION PROFILES'"
^DIC(9.4,60,22,13,"PAH",79,1,182,0)="for one or more outpatient sites is either not defined or set to 'No'."
^DIC(9.4,60,22,13,"PAH",79,1,183,0)="All copay eligible, released CMOP prescription fills from those outpatient"
^DIC(9.4,60,22,13,"PAH",79,1,184,0)="sites would not have been billed since the installation of PSX*2*35."
^DIC(9.4,60,22,13,"PAH",79,1,185,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,186,0)="NOTE:  If the estimated number of CMOP prescriptions involved is high"
^DIC(9.4,60,22,13,"PAH",79,1,187,0)="based"
^DIC(9.4,60,22,13,"PAH",79,1,188,0)="on when the patch was first installed and the number of outpatient sites"
^DIC(9.4,60,22,13,"PAH",79,1,189,0)="involved, you may want to disable journaling for Integrated Billing and"
^DIC(9.4,60,22,13,"PAH",79,1,190,0)="Accounts Receivable globals ^IB and ^PRCA while the clean up job"
^DIC(9.4,60,22,13,"PAH",79,1,191,0)="is running."
^DIC(9.4,60,22,13,"PAH",79,1,192,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,193,0)="When the background job is complete, a MailMan message will be sent to the"
^DIC(9.4,60,22,13,"PAH",79,1,194,0)="installer indicating how many copay eligible CMOP prescription fills were"
^DIC(9.4,60,22,13,"PAH",79,1,195,0)="successfully billed."
^DIC(9.4,60,22,13,"PAH",79,1,196,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,197,0)="Background job must be queued to start by Jan 30, 2002 or before."
^DIC(9.4,60,22,13,"PAH",79,1,198,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,199,0)="At the following prompt, enter a starting date/time after JAN 18,"
^DIC(9.4,60,22,13,"PAH",79,1,200,0)="2002@14:39:49"
^DIC(9.4,60,22,13,"PAH",79,1,201,0)="and before Jan 31, 2002 or enter NOW to queue the job immediately."
^DIC(9.4,60,22,13,"PAH",79,1,202,0)="If this prompting is during patch installation, you will not see what you"
^DIC(9.4,60,22,13,"PAH",79,1,203,0)="type."
^DIC(9.4,60,22,13,"PAH",79,1,204,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,205,0)="                                   PSO*7.0*93"
^DIC(9.4,60,22,13,"PAH",79,1,206,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",79,1,207,0)="------"
^DIC(9.4,60,22,13,"PAH",79,1,208,0)="Queue copay clean-up Job to run Date/Time:   (JAN 18, 2002@10:00) ??"
^DIC(9.4,60,22,13,"PAH",79,1,209,0)="Queue copay clean-up Job to run Date/Time:   (JAN 18, 2002@15:00)"
^DIC(9.4,60,22,13,"PAH",79,1,210,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,211,0)="Task will be queued to run JAN 18, 2002@15:00 Is that correct?  :"
^DIC(9.4,60,22,13,"PAH",79,1,212,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,213,0)="Queuing background job to reprocess unbilled copay CMOP Prescription"
^DIC(9.4,60,22,13,"PAH",79,1,214,0)="fills..."
^DIC(9.4,60,22,13,"PAH",79,1,215,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,216,0)="Task Queued !"
^DIC(9.4,60,22,13,"PAH",79,1,217,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,218,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,219,0)=" Updating Routine file..."
^DIC(9.4,60,22,13,"PAH",79,1,220,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,221,0)=" Updating KIDS files..."
^DIC(9.4,60,22,13,"PAH",79,1,222,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,223,0)=" PSO*7.0*93 Installed."
^DIC(9.4,60,22,13,"PAH",79,1,224,0)="               Jan 18, 2002@14:40:20"
^DIC(9.4,60,22,13,"PAH",79,1,225,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,226,0)=" Install Message sent #41853"
^DIC(9.4,60,22,13,"PAH",79,1,227,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",79,1,228,0)="------"
^DIC(9.4,60,22,13,"PAH",79,1,229,0)="          [------------------------------------------------------------]"
^DIC(9.4,60,22,13,"PAH",79,1,230,0)="  100%    |             25             50             75               |"
^DIC(9.4,60,22,13,"PAH",79,1,231,0)="Complete  [------------------------------------------------------------]"
^DIC(9.4,60,22,13,"PAH",79,1,232,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,233,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,234,0)=" "
^DIC(9.4,60,22,13,"PAH",79,1,235,0)="Install Completed"
^DIC(9.4,60,22,13,"PAH",80,0)="84 SEQ #82^3020207^1"
^DIC(9.4,60,22,13,"PAH",80,1,0)="^^16^16^3020207"
^DIC(9.4,60,22,13,"PAH",80,1,1,0)=" 1) When finishing pending orders using the Complete Orders from OERR [PSO"
^DIC(9.4,60,22,13,"PAH",80,1,2,0)=" LMOE FINISH] option, if PATIENT is selected for the sort prompt ""Select"
^DIC(9.4,60,22,13,"PAH",80,1,3,0)=" By:"", and ALL is selected for the prompt ""All Patients or Single"
^DIC(9.4,60,22,13,"PAH",80,1,4,0)=" Patient:"", it was found that the software does not show the medication"
^DIC(9.4,60,22,13,"PAH",80,1,5,0)=" profile of every patient who has pending orders. The problem is that if"
^DIC(9.4,60,22,13,"PAH",80,1,6,0)=" the software encounters a renewal and if that order is skipped by the"
^DIC(9.4,60,22,13,"PAH",80,1,7,0)=" user without completing it, then the process will quit instead of"
^DIC(9.4,60,22,13,"PAH",80,1,8,0)=" continuing with the rest of the patients. Also there is a possibility of"
^DIC(9.4,60,22,13,"PAH",80,1,9,0)=" getting an undefined error if the zero node of the PENDING OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",80,1,10,0)=" ORDERS file (#52.41) is missing. This patch corrects these problems."
^DIC(9.4,60,22,13,"PAH",80,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",80,1,12,0)=" 2) When finishing pending orders through the backdoor or using the"
^DIC(9.4,60,22,13,"PAH",80,1,13,0)=" Complete Orders from OERR [PSO LMOE FINISH] option, if multiple orders"
^DIC(9.4,60,22,13,"PAH",80,1,14,0)=" are selected, the BY Bypass ListMan action goes back to the patient"
^DIC(9.4,60,22,13,"PAH",80,1,15,0)=" profile instead of going to the next order in the selection list. This"
^DIC(9.4,60,22,13,"PAH",80,1,16,0)=" patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",81,0)="90 SEQ #83^3020226^1"
^DIC(9.4,60,22,13,"PAH",81,1,0)="^^20^20^3020226"
^DIC(9.4,60,22,13,"PAH",81,1,1,0)="1. When using the Free Text Dosage Report [PSO DOSAGE REPORT] option, "
^DIC(9.4,60,22,13,"PAH",81,1,2,0)="there is a possibility of a ""string too long"" error occurring when the "
^DIC(9.4,60,22,13,"PAH",81,1,3,0)="date range selected is for a long period. This patch corrects this "
^DIC(9.4,60,22,13,"PAH",81,1,4,0)="problem."
^DIC(9.4,60,22,13,"PAH",81,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",81,1,6,0)="2. With programmer access only, most Outpatient Pharmacy options can be "
^DIC(9.4,60,22,13,"PAH",81,1,7,0)="executed by entering the option name at the XUP routine's, ""Select OPTION "
^DIC(9.4,60,22,13,"PAH",81,1,8,0)="NAME:"" prompt. On quitting from these options the software takes you back "
^DIC(9.4,60,22,13,"PAH",81,1,9,0)="to the MUMPS programmer prompt except when using the Rx (Prescriptions) "
^DIC(9.4,60,22,13,"PAH",81,1,10,0)="[PSO RX] option when it puts you back to the VMS prompt. This patch "
^DIC(9.4,60,22,13,"PAH",81,1,11,0)="corrects this problem."
^DIC(9.4,60,22,13,"PAH",81,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",81,1,13,0)="3. When multiple edits are done while finishing a pending order, there is "
^DIC(9.4,60,22,13,"PAH",81,1,14,0)="a possibility of an undefined variable error occurring. This patch fixes"
^DIC(9.4,60,22,13,"PAH",81,1,15,0)="this problem."
^DIC(9.4,60,22,13,"PAH",81,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",81,1,17,0)="4. When using the Rx Verification by Clerk [PSO VR] option, for pre POE "
^DIC(9.4,60,22,13,"PAH",81,1,18,0)="orders that do not have a SIG, there is a possibility of the patient "
^DIC(9.4,60,22,13,"PAH",81,1,19,0)="instructions not getting appended to the constructed SIG. This patch"
^DIC(9.4,60,22,13,"PAH",81,1,20,0)="corrects this problem."
^DIC(9.4,60,22,13,"PAH",82,0)="91 SEQ #84^3020226^1"
^DIC(9.4,60,22,13,"PAH",82,1,0)="^^9^9^3020226"
^DIC(9.4,60,22,13,"PAH",82,1,1,0)="This patch addresses the following concerns: "
^DIC(9.4,60,22,13,"PAH",82,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",82,1,3,0)="1. When entering an outpatient pharmacy prescription a schedule is required"
^DIC(9.4,60,22,13,"PAH",82,1,4,0)="to complete the order. If the user enters a question mark at the ""Schedule:"""
^DIC(9.4,60,22,13,"PAH",82,1,5,0)="prompt to list the available choices, a list is not displayed as expected."
^DIC(9.4,60,22,13,"PAH",82,1,6,0)="This patch corrects this problem.  "
^DIC(9.4,60,22,13,"PAH",82,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",82,1,8,0)="2. This patch corrects a possible undefined error when entering new"
^DIC(9.4,60,22,13,"PAH",82,1,9,0)="Outpatient Backdoor Pharmacy orders. "
^DIC(9.4,60,22,13,"PAH",83,0)="87 SEQ #85^3020226^1"
^DIC(9.4,60,22,13,"PAH",83,1,0)="^^23^23^3020226"
^DIC(9.4,60,22,13,"PAH",83,1,1,0)="1. There is the potential for an undefined error to occur when renewing "
^DIC(9.4,60,22,13,"PAH",83,1,2,0)="prescriptions that were entered using the Outpatient Pharmacy v.7.0"
^DIC(9.4,60,22,13,"PAH",83,1,3,0)="package prior to installing the Pharmacy Ordering Enhancement (POE)"
^DIC(9.4,60,22,13,"PAH",83,1,4,0)="patch.  After POE has been installed and renewing these prescriptions from "
^DIC(9.4,60,22,13,"PAH",83,1,5,0)="the PRESCRIPTION file (#52), the SIG field (#10) could be blank which causes"
^DIC(9.4,60,22,13,"PAH",83,1,6,0)="an undefined error when the software attempts to display these prescriptions to"
^DIC(9.4,60,22,13,"PAH",83,1,7,0)="the screen.  This error does not affect prescriptions entered using Computerized"
^DIC(9.4,60,22,13,"PAH",83,1,8,0)="Patient Record System (CPRS).  "
^DIC(9.4,60,22,13,"PAH",83,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",83,1,10,0)="In addition to correcting the problem, this install will loop through the "
^DIC(9.4,60,22,13,"PAH",83,1,11,0)="entire PRESCRIPTION file (#52) and look for the ^PSRX(DA,""SIG"") node"
^DIC(9.4,60,22,13,"PAH",83,1,12,0)="that has only an up-arrow (^), is a renewal, and has a pointer to the prescription"
^DIC(9.4,60,22,13,"PAH",83,1,13,0)="that was renewed and then copy the SIG to the prescription with the missing SIG. "
^DIC(9.4,60,22,13,"PAH",83,1,14,0)="This looping that is a post-install routine could take up to an hour or more. "
^DIC(9.4,60,22,13,"PAH",83,1,15,0)="It is recommended that this install be queued to a printer so a terminal is"
^DIC(9.4,60,22,13,"PAH",83,1,16,0)="available during the install.  "
^DIC(9.4,60,22,13,"PAH",83,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",83,1,18,0)="2. With the release of the Pharmacy Ordering Enhancement (POE) patch the List"
^DIC(9.4,60,22,13,"PAH",83,1,19,0)="Manager action, Other OP Actions [PSO LM HIDDEN OTHER] was mistakenly"
^DIC(9.4,60,22,13,"PAH",83,1,20,0)="Removed from the List Manager Protocol, Outpatient Pharmacy Hidden Actions #2"
^DIC(9.4,60,22,13,"PAH",83,1,21,0)="[PSO HIDDEN ACTIONS #2]. This patch restores Other OP Actions [PSO LM HIDDEN"
^DIC(9.4,60,22,13,"PAH",83,1,22,0)="OTHER] protocol as an item to the Outpatient Pharmacy Hidden Actions #2 [PSO "
^DIC(9.4,60,22,13,"PAH",83,1,23,0)="HIDDEN ACTIONS #2] protocol.  "
^DIC(9.4,60,22,13,"PAH",84,0)="89 SEQ #86^3020226^1"
^DIC(9.4,60,22,13,"PAH",84,1,0)="^^8^8^3020226"
^DIC(9.4,60,22,13,"PAH",84,1,1,0)="This patch addresses the following concerns:"
^DIC(9.4,60,22,13,"PAH",84,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",84,1,3,0)="When running the following options: Nightly Rx Cost Compile [PSO COSTDAY "
^DIC(9.4,60,22,13,"PAH",84,1,4,0)="NIGHTJOB], Monthly Rx Cost Compilation [PSO COSTMONTH], and Daily Rx Cost [PSO"
^DIC(9.4,60,22,13,"PAH",84,1,5,0)="COSTDAY], a possible undefined error could happen if there is a bad "
^DIC(9.4,60,22,13,"PAH",84,1,6,0)="cross-reference in the REFILL DATE sub-file (#52.1) on the REFILL DATE field"
^DIC(9.4,60,22,13,"PAH",84,1,7,0)="(#.01).  This patch corrects this potential error.  "
^DIC(9.4,60,22,13,"PAH",84,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",85,0)="96 SEQ #87^3020226^1"
^DIC(9.4,60,22,13,"PAH",85,1,0)="^^49^49^3020226"
^DIC(9.4,60,22,13,"PAH",85,1,1,0)="1. When renewing a prescription and editing it before finishing the order,"
^DIC(9.4,60,22,13,"PAH",85,1,2,0)="and if the nature of order was marked as ""Verbal"", there is a possibility"
^DIC(9.4,60,22,13,"PAH",85,1,3,0)="of the renewed order not triggering an alert to the provider for his "
^DIC(9.4,60,22,13,"PAH",85,1,4,0)="signature. This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",85,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",85,1,6,0)="2. When finishing a renewal entered through Computerized Patient Record "
^DIC(9.4,60,22,13,"PAH",85,1,7,0)="System (CPRS) in Outpatient Pharmacy and answering YES to the prompt ""Do"
^DIC(9.4,60,22,13,"PAH",85,1,8,0)="you want to enter a Progress Note?  No//"", the software does not present"
^DIC(9.4,60,22,13,"PAH",85,1,9,0)="the pharmacist with the progress notes template. This patch fixes this"
^DIC(9.4,60,22,13,"PAH",85,1,10,0)="problem."
^DIC(9.4,60,22,13,"PAH",85,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",85,1,12,0)="3. Prior to the Pharmacy Ordering Enhancements patches, the Dispense "
^DIC(9.4,60,22,13,"PAH",85,1,13,0)="Drug of a prescription could be edited and not create a new order. This"
^DIC(9.4,60,22,13,"PAH",85,1,14,0)="would happen if the new Dispense Drug was matched to the same Pharmacy"
^DIC(9.4,60,22,13,"PAH",85,1,15,0)="Orderable Item as the old Dispense Drug. When this occurred, the drug was"
^DIC(9.4,60,22,13,"PAH",85,1,16,0)="not updated in Computerized Record Patient System (CPRS). If the order is"
^DIC(9.4,60,22,13,"PAH",85,1,17,0)="then renewed through CPRS after the install of the Pharmacy Ordering "
^DIC(9.4,60,22,13,"PAH",85,1,18,0)="Enhancements patches, and if this order can have Possible Dosages, it is "
^DIC(9.4,60,22,13,"PAH",85,1,19,0)="possible that Dosages are automatically assigned to the order by CPRS "
^DIC(9.4,60,22,13,"PAH",85,1,20,0)="based on the original order information. When the Pending Renewal is "
^DIC(9.4,60,22,13,"PAH",85,1,21,0)="displayed in Pharmacy, the Dispense Drug is always replaced with the "
^DIC(9.4,60,22,13,"PAH",85,1,22,0)="current Dispense Drug of the order. This could lead to the Possible "
^DIC(9.4,60,22,13,"PAH",85,1,23,0)="Dosages not matching the Dispense Drug on the Pending Renewal."
^DIC(9.4,60,22,13,"PAH",85,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",85,1,25,0)="To fix this problem, when the Renewal is done in CPRS, Pharmacy will "
^DIC(9.4,60,22,13,"PAH",85,1,26,0)="check the Drug from the PRESCRIPTION file (#52) against the Drug in the"
^DIC(9.4,60,22,13,"PAH",85,1,27,0)="ORDER file (#100), and if it is different, the order will be"
^DIC(9.4,60,22,13,"PAH",85,1,28,0)="Non-Renewable through CPRS."
^DIC(9.4,60,22,13,"PAH",85,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",85,1,30,0)="This functionality of this patch will not be seen until both this patch "
^DIC(9.4,60,22,13,"PAH",85,1,31,0)="(PSO*7*96) and the CPRS patch (OR*3*134) are installed. It will not cause"
^DIC(9.4,60,22,13,"PAH",85,1,32,0)="any problems if the Outpatient Pharmacy patch is installed without the "
^DIC(9.4,60,22,13,"PAH",85,1,33,0)="CPRS patch, it's just that the functionality will not be seen until both"
^DIC(9.4,60,22,13,"PAH",85,1,34,0)="are installed."
^DIC(9.4,60,22,13,"PAH",85,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",85,1,36,0)="4. When Renewing prescriptions that were entered prior to the "
^DIC(9.4,60,22,13,"PAH",85,1,37,0)="installation of the Pharmacy Ordering Enhancements patches, it is"
^DIC(9.4,60,22,13,"PAH",85,1,38,0)="possible that the Verb from one Renewal is carried over to the next"
^DIC(9.4,60,22,13,"PAH",85,1,39,0)="Renewal. This patch will fix this problem."
^DIC(9.4,60,22,13,"PAH",85,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",85,1,41,0)="5. A problem has been reported when finishing renewals entered through "
^DIC(9.4,60,22,13,"PAH",85,1,42,0)="CPRS, and when processing renewals through Outpatient Pharmacy. The"
^DIC(9.4,60,22,13,"PAH",85,1,43,0)="Instructions field sometimes displays with incorrect Instructions. This "
^DIC(9.4,60,22,13,"PAH",85,1,44,0)="is a result of a data problem that occurred prior to the Pharmacy"
^DIC(9.4,60,22,13,"PAH",85,1,45,0)="Ordering Enhancements project, and has since been fixed. But there is no"
^DIC(9.4,60,22,13,"PAH",85,1,46,0)="way to clean up any of the invalid data, so these invalid Instructions"
^DIC(9.4,60,22,13,"PAH",85,1,47,0)="still appear on the pending renewal screen. Since the Sig now shows on"
^DIC(9.4,60,22,13,"PAH",85,1,48,0)="the pending renewal screen, the software no longer needs to show the"
^DIC(9.4,60,22,13,"PAH",85,1,49,0)="Instructions, so the Instructions will now be removed from the display."
^DIC(9.4,60,22,13,"PAH",86,0)="86 SEQ #88^3020315^1"
^DIC(9.4,60,22,13,"PAH",86,1,0)="^^5^5^3020315"
^DIC(9.4,60,22,13,"PAH",86,1,1,0)="A problem has been reported of a status mismatch between Outpatient "
^DIC(9.4,60,22,13,"PAH",86,1,2,0)="Pharmacy orders and the corresponding order in Computerized Patient "
^DIC(9.4,60,22,13,"PAH",86,1,3,0)="Record System (CPRS).The specific problem would be that an order would be "
^DIC(9.4,60,22,13,"PAH",86,1,4,0)="Discontinued or Expired in Pharmacy, but Active in CPRS. This patch will "
^DIC(9.4,60,22,13,"PAH",86,1,5,0)="identify those orders, and update the CPRS order with the correct status."
^DIC(9.4,60,22,13,"PAH",87,0)="78 SEQ #90^3020327^1"
^DIC(9.4,60,22,13,"PAH",87,1,0)="^^51^51^3020327"
^DIC(9.4,60,22,13,"PAH",87,1,1,0)="1. With the release of the Pharmacy Ordering Enhancement patch (POE), "
^DIC(9.4,60,22,13,"PAH",87,1,2,0)="functionality was added to compute the quantity for prescriptions for"
^DIC(9.4,60,22,13,"PAH",87,1,3,0)="possible dosages.  During the testing phase for POE the computation of"
^DIC(9.4,60,22,13,"PAH",87,1,4,0)="quantity for CMOP prescriptions was not identified as being a problem.  The"
^DIC(9.4,60,22,13,"PAH",87,1,5,0)="problem for the CMOP prescription happens when, for instance a prescription"
^DIC(9.4,60,22,13,"PAH",87,1,6,0)="has a medication instruction that states to ""TAKE 1 TABLET FOR 90 DAYS""."
^DIC(9.4,60,22,13,"PAH",87,1,7,0)="For non-CMOP prescriptions a quantity of 90 tablets would normally be"
^DIC(9.4,60,22,13,"PAH",87,1,8,0)="dispensed, but for CMOP prescriptions the quantity often times should be a"
^DIC(9.4,60,22,13,"PAH",87,1,9,0)="quantity of 100.  When the CMOP prescriptions are renewed the quantity is"
^DIC(9.4,60,22,13,"PAH",87,1,10,0)="reduced from 100 to 90.  The correction to the software is that the quantity"
^DIC(9.4,60,22,13,"PAH",87,1,11,0)="for all renewals will not be calculated, but use the quantity already"
^DIC(9.4,60,22,13,"PAH",87,1,12,0)="entered for the prescription being renewed.  "
^DIC(9.4,60,22,13,"PAH",87,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",87,1,14,0)="2. The prescription editing functionality that allows prescriptions to be "
^DIC(9.4,60,22,13,"PAH",87,1,15,0)="edited has been enhanced to process all fields selected for editing and"
^DIC(9.4,60,22,13,"PAH",87,1,16,0)="verify that the edits do not cause a new prescription (order) to be created"
^DIC(9.4,60,22,13,"PAH",87,1,17,0)="before updating the PRESCRIPTION file (#52) and CPRS ORDERS file (#100)."
^DIC(9.4,60,22,13,"PAH",87,1,18,0)="Currently the software will update the prescription being edited and the"
^DIC(9.4,60,22,13,"PAH",87,1,19,0)="changes to the new prescription.  "
^DIC(9.4,60,22,13,"PAH",87,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",87,1,21,0)="3. An additional order check was added when entering backdoor prescriptions"
^DIC(9.4,60,22,13,"PAH",87,1,22,0)="and finishing prescriptions entered by the provider.  If maximum dispense"
^DIC(9.4,60,22,13,"PAH",87,1,23,0)="units per day is entered in the MAXIMUM DOSE PER DAY field (#4), in the DRUG"
^DIC(9.4,60,22,13,"PAH",87,1,24,0)="file (#50) it is used as an order check when the day supply is entered for"
^DIC(9.4,60,22,13,"PAH",87,1,25,0)="backdoor prescriptions.  The problem is that the order check is not done"
^DIC(9.4,60,22,13,"PAH",87,1,26,0)="when the quantity is entered or when finishing orders entered using CPRS."
^DIC(9.4,60,22,13,"PAH",87,1,27,0)="This patch now checks for maximum dispense units per day when the quantity"
^DIC(9.4,60,22,13,"PAH",87,1,28,0)="is entered through Backdoor Outpatient Pharmacy and when finishing"
^DIC(9.4,60,22,13,"PAH",87,1,29,0)="prescriptions entered by a provider.  "
^DIC(9.4,60,22,13,"PAH",87,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",87,1,31,0)="4. When entering prescriptions using the Outpatient Pharmacy package or the"
^DIC(9.4,60,22,13,"PAH",87,1,32,0)="Computerize Patient Record System (CPRS) for schedule 2 through 5 drugs the"
^DIC(9.4,60,22,13,"PAH",87,1,33,0)="maximum number of refills of 5 was being allowed.  A problem was discovered"
^DIC(9.4,60,22,13,"PAH",87,1,34,0)="that schedule 2 drugs should not allow any refills.  This patch corrects"
^DIC(9.4,60,22,13,"PAH",87,1,35,0)="this problem.  "
^DIC(9.4,60,22,13,"PAH",87,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",87,1,37,0)="5. When finishing orders from the Computerize Patient Record System (CPRS)"
^DIC(9.4,60,22,13,"PAH",87,1,38,0)="that have a dosage greater than 60 characters, pharmacy cannot finish those"
^DIC(9.4,60,22,13,"PAH",87,1,39,0)="orders without editing the dosage down to 60 characters or less. When the"
^DIC(9.4,60,22,13,"PAH",87,1,40,0)="dosage was edited the software was getting into a loop, which prevented the"
^DIC(9.4,60,22,13,"PAH",87,1,41,0)="edited order from being accepted.  This patch corrects this problem.  "
^DIC(9.4,60,22,13,"PAH",87,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",87,1,43,0)="6. When entering a backdoor order and an up-arrow is entered in the Route"
^DIC(9.4,60,22,13,"PAH",87,1,44,0)="field, the order entry process should abort but does not, which causes an"
^DIC(9.4,60,22,13,"PAH",87,1,45,0)="undefined error.  This patch corrects this.  "
^DIC(9.4,60,22,13,"PAH",87,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",87,1,47,0)="7. It appears that when a pharmacist is finishing orders and one is for a"
^DIC(9.4,60,22,13,"PAH",87,1,48,0)="possible dose, which would have units in parenthesis, and the second order"
^DIC(9.4,60,22,13,"PAH",87,1,49,0)="is for a local possible dosage, the units pointer variable is not killed"
^DIC(9.4,60,22,13,"PAH",87,1,50,0)="from the previous order and is displaying on the screen, but is not added"
^DIC(9.4,60,22,13,"PAH",87,1,51,0)="to the order.    "
^DIC(9.4,60,22,13,"PAH",88,0)="95^3020423^1"
^DIC(9.4,60,22,13,"PAH",88,1,0)="^^22^22^3020423"
^DIC(9.4,60,22,13,"PAH",88,1,1,0)="As a part of the Pharmacy Benefits Management (PBM) Extract enhancement "
^DIC(9.4,60,22,13,"PAH",88,1,2,0)="project, two new fields were added to the PHARMACY PATIENT file (#55).  "
^DIC(9.4,60,22,13,"PAH",88,1,3,0)="They are FIRST SERVICE DATE (#.07) and ACTUAL/HISTORICAL FLAG (#.08)."
^DIC(9.4,60,22,13,"PAH",88,1,4,0)="With the addition of these two fields, Inpatient Medications V. 5.0 and"
^DIC(9.4,60,22,13,"PAH",88,1,5,0)="Outpatient Pharmacy V. 7.0 have been modified to set this information when"
^DIC(9.4,60,22,13,"PAH",88,1,6,0)="the first order for a patient becomes active.  "
^DIC(9.4,60,22,13,"PAH",88,1,7,0)="  "
^DIC(9.4,60,22,13,"PAH",88,1,8,0)="This project consists of three patches combined in a master build.  "
^DIC(9.4,60,22,13,"PAH",88,1,9,0)="Installation of this master build should be coordinated among the three "
^DIC(9.4,60,22,13,"PAH",88,1,10,0)="packages affected since only one installation is necessary.  The patches, in"
^DIC(9.4,60,22,13,"PAH",88,1,11,0)="order of install, are: "
^DIC(9.4,60,22,13,"PAH",88,1,12,0)="  "
^DIC(9.4,60,22,13,"PAH",88,1,13,0)="       PSS*1*52  PHARMACY DATA MANAGEMENT V. 1.0 "
^DIC(9.4,60,22,13,"PAH",88,1,14,0)="       PSJ*5*68  INPATIENT MEDICATIONS V. 5.0 "
^DIC(9.4,60,22,13,"PAH",88,1,15,0)="       PSO*7*95  OUTPATIENT PHARMACY V. 7.0 "
^DIC(9.4,60,22,13,"PAH",88,1,16,0)="  "
^DIC(9.4,60,22,13,"PAH",88,1,17,0)="Upon completion of the installation of these three patches, the master build"
^DIC(9.4,60,22,13,"PAH",88,1,18,0)="will start a routine that will build the two new fields from historical data"
^DIC(9.4,60,22,13,"PAH",88,1,19,0)="in the PHARMACY PATIENT file (#55).  When the build is complete, the user"
^DIC(9.4,60,22,13,"PAH",88,1,20,0)="who initiated the install and the members of the PSU PBM mail group will"
^DIC(9.4,60,22,13,"PAH",88,1,21,0)="receive a message with a subject of BUILD OF FIRST PHARMACY SERVICE INFO"
^DIC(9.4,60,22,13,"PAH",88,1,22,0)="COMPLETE."
^DIC(9.4,60,22,13,"PAH",89,0)="100 SEQ #92^3020423^1"
^DIC(9.4,60,22,13,"PAH",89,1,0)="^^51^51^3020423"
^DIC(9.4,60,22,13,"PAH",89,1,1,0)="1) When orders entered prior to the Pharmacy Ordering Enhancements patches"
^DIC(9.4,60,22,13,"PAH",89,1,2,0)="are renewed through Computerized Patient Record System (CPRS), CPRS will"
^DIC(9.4,60,22,13,"PAH",89,1,3,0)="sometimes automatically assign Possible Dosages to these orders, based on"
^DIC(9.4,60,22,13,"PAH",89,1,4,0)="prior order information. A problem was reported in that process that"
^DIC(9.4,60,22,13,"PAH",89,1,5,0)="involved CPRS passing an invalid dosage that began with ""0..5"", or another"
^DIC(9.4,60,22,13,"PAH",89,1,6,0)="dosage that started with ""0.."", to Pharmacy when the Dispense Units per"
^DIC(9.4,60,22,13,"PAH",89,1,7,0)="Dose contained a decimal point. When these pre-POE orders are renewed, the"
^DIC(9.4,60,22,13,"PAH",89,1,8,0)="Sig is brought into the order from the order being renewed. If this "
^DIC(9.4,60,22,13,"PAH",89,1,9,0)="invalid dosage information is not edited, it stays with the order, along"
^DIC(9.4,60,22,13,"PAH",89,1,10,0)="with a Sig that can be valid, since it is from the previous order. The"
^DIC(9.4,60,22,13,"PAH",89,1,11,0)="problem occurs when that order is renewed again, because the Sig from that"
^DIC(9.4,60,22,13,"PAH",89,1,12,0)="point on is built from the Dosing information, which could produce an"
^DIC(9.4,60,22,13,"PAH",89,1,13,0)="invalid Sig."
^DIC(9.4,60,22,13,"PAH",89,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",89,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",89,1,16,0)="To fix this problem, CPRS patch OR*3*134 will identify these orders to"
^DIC(9.4,60,22,13,"PAH",89,1,17,0)="Pharmacy in a mail message. Pharmacy should then go and act accordingly on"
^DIC(9.4,60,22,13,"PAH",89,1,18,0)="these orders. Please refer to patch OR*3*134 for complete information."
^DIC(9.4,60,22,13,"PAH",89,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",89,1,20,0)="As an added precaution, this patch, PSO*7*100, is being released. This "
^DIC(9.4,60,22,13,"PAH",89,1,21,0)="patch will check the dosages associated with an order when that order is "
^DIC(9.4,60,22,13,"PAH",89,1,22,0)="renewed or copied through Outpatient Pharmacy, and if a Dosage is found in"
^DIC(9.4,60,22,13,"PAH",89,1,23,0)="the order that contains ""0.."", the process will not continue, and a"
^DIC(9.4,60,22,13,"PAH",89,1,24,0)="message will be given to the user giving the reason. In addition, when a"
^DIC(9.4,60,22,13,"PAH",89,1,25,0)="renewal of an Outpatient order is entered through CPRS, a call is made to"
^DIC(9.4,60,22,13,"PAH",89,1,26,0)="Outpatient Pharmacy that determines whether or not the order is renewable."
^DIC(9.4,60,22,13,"PAH",89,1,27,0)="When this occurs, a check will now be in place to look for dosages that"
^DIC(9.4,60,22,13,"PAH",89,1,28,0)="contain ""0.."", and if found, the renewal will not be allowed through"
^DIC(9.4,60,22,13,"PAH",89,1,29,0)="CPRS. And to prevent any other invalid Sigs from being created as a "
^DIC(9.4,60,22,13,"PAH",89,1,30,0)="result of invalid Dosing information automatically assigned to pre-POE"
^DIC(9.4,60,22,13,"PAH",89,1,31,0)="orders, this patch makes the change to the renewal process to always carry"
^DIC(9.4,60,22,13,"PAH",89,1,32,0)="over the Sig from the prescription being renewed, instead of building the"
^DIC(9.4,60,22,13,"PAH",89,1,33,0)="Sig from the Dosing information that could have been assigned improperly"
^DIC(9.4,60,22,13,"PAH",89,1,34,0)="when that prescription was originally renewed as a Pre-POE order."
^DIC(9.4,60,22,13,"PAH",89,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",89,1,36,0)="Since the change has been made to always populate the Sig from the "
^DIC(9.4,60,22,13,"PAH",89,1,37,0)="previous prescription on Renewals, a check will now be in place for a"
^DIC(9.4,60,22,13,"PAH",89,1,38,0)="missing Sig when prescriptions are renewed. If a prescription is renewed,"
^DIC(9.4,60,22,13,"PAH",89,1,39,0)="and that prescription is missing the Sig, the prescription will not be "
^DIC(9.4,60,22,13,"PAH",89,1,40,0)="renewable, and a message will be given to the user giving the reason."
^DIC(9.4,60,22,13,"PAH",89,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",89,1,42,0)="        "
^DIC(9.4,60,22,13,"PAH",89,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",89,1,44,0)="2) When using the Speed Renew function in Outpatient Pharmacy, after "
^DIC(9.4,60,22,13,"PAH",89,1,45,0)="selecting the orders to renew, a number of prompts appear, one of those "
^DIC(9.4,60,22,13,"PAH",89,1,46,0)="prompts being PATIENT STATUS. The response to that prompt is entered as "
^DIC(9.4,60,22,13,"PAH",89,1,47,0)="the Patient Status in the PHARMACY PATIENT (#55) file, but the "
^DIC(9.4,60,22,13,"PAH",89,1,48,0)="prescriptions that are renewed still have the same Patient Status of the "
^DIC(9.4,60,22,13,"PAH",89,1,49,0)="prescriptions being renewed. This patch will make the change to update "
^DIC(9.4,60,22,13,"PAH",89,1,50,0)="all of the renewals with the Patient Status entered at the PATIENT STATUS "
^DIC(9.4,60,22,13,"PAH",89,1,51,0)="prompt."
^DIC(9.4,60,22,13,"PAH",90,0)="98 SEQ #93^3020506^1"
^DIC(9.4,60,22,13,"PAH",90,1,0)="^^41^41^3020506"
^DIC(9.4,60,22,13,"PAH",90,1,1,0)="1) A problem was reported where a Pending Outpatient Pharmacy Order did "
^DIC(9.4,60,22,13,"PAH",90,1,2,0)="   not show up in the Complete Orders from OERR [PSO LMOE FINISH] option."
^DIC(9.4,60,22,13,"PAH",90,1,3,0)="   The problem occurs when the order is a ""change"" order from Computerized"
^DIC(9.4,60,22,13,"PAH",90,1,4,0)="   Patient Record System (CPRS), and it is a complex order with very long "
^DIC(9.4,60,22,13,"PAH",90,1,5,0)="   Dosing Instructions. The order would show up in the Patient"
^DIC(9.4,60,22,13,"PAH",90,1,6,0)="   Prescription Processing [PSO LM BACKDOOR ORDERS] option, but would not"
^DIC(9.4,60,22,13,"PAH",90,1,7,0)="   always show up in the Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",90,1,8,0)="   option. This patch fixes the problem, and also as part of a post-init,"
^DIC(9.4,60,22,13,"PAH",90,1,9,0)="   will find all of these Pending Outpatient orders, if there are any, and"
^DIC(9.4,60,22,13,"PAH",90,1,10,0)="   generate a mail message to the patch installer, and to all holders of"
^DIC(9.4,60,22,13,"PAH",90,1,11,0)="   the PSNMGR key. This message should be reviewed by the appropriate"
^DIC(9.4,60,22,13,"PAH",90,1,12,0)="   pharmacy personnel. The orders will not automatically be fixed to show"
^DIC(9.4,60,22,13,"PAH",90,1,13,0)="   up in the Complete Orders from OERR [PSO LMOE FINISH] option, since"
^DIC(9.4,60,22,13,"PAH",90,1,14,0)="   some of the orders may be old orders. But Pharmacy can review these"
^DIC(9.4,60,22,13,"PAH",90,1,15,0)="   orders from the mail message using the Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",90,1,16,0)="   [PSO LM BACKDOOR ORDERS] option to determine the appropriate action."
^DIC(9.4,60,22,13,"PAH",90,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",90,1,18,0)="2) When a renewal is entered through CPRS for an outpatient pharmacy"
^DIC(9.4,60,22,13,"PAH",90,1,19,0)="   order, and that renewal is signed and sent to the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",90,1,20,0)="   package, there are validation checks done on the renewal before the"
^DIC(9.4,60,22,13,"PAH",90,1,21,0)="   Outpatient Pharmacy package accepts the renewal. This patch will add"
^DIC(9.4,60,22,13,"PAH",90,1,22,0)="   two more validation checks."
^DIC(9.4,60,22,13,"PAH",90,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",90,1,24,0)="   When the renewal is received in Outpatient Pharmacy, the software will"
^DIC(9.4,60,22,13,"PAH",90,1,25,0)="   now check the patient in the message against the patient in the"
^DIC(9.4,60,22,13,"PAH",90,1,26,0)="   PRESCRIPTION file (#52) from the previous pharmacy order number sent in"
^DIC(9.4,60,22,13,"PAH",90,1,27,0)="   the message, and if the patient does not match, then renewal will not"
^DIC(9.4,60,22,13,"PAH",90,1,28,0)="   be accepted by the Outpatient Pharmacy package. A previous order number"
^DIC(9.4,60,22,13,"PAH",90,1,29,0)="   check will also be added to this process. When the renewal is received,"
^DIC(9.4,60,22,13,"PAH",90,1,30,0)="   if the previous CPRS number does not match the CPRS number stored in"
^DIC(9.4,60,22,13,"PAH",90,1,31,0)="   the previous pharmacy order, then the renewal will not be accepted by"
^DIC(9.4,60,22,13,"PAH",90,1,32,0)="   the Outpatient Pharmacy package."
^DIC(9.4,60,22,13,"PAH",90,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",90,1,34,0)="3) This patch fixes two problems with the Medication Profile [PSO P]"
^DIC(9.4,60,22,13,"PAH",90,1,35,0)="   option. If a profile is printed for a patient who has pending"
^DIC(9.4,60,22,13,"PAH",90,1,36,0)="   outpatient pharmacy orders, those pending orders print at the end of"
^DIC(9.4,60,22,13,"PAH",90,1,37,0)="   the report, but the patient name is not at the top of these pages. This"
^DIC(9.4,60,22,13,"PAH",90,1,38,0)="   patch adds the patient name to the top of those pages. Also, if a"
^DIC(9.4,60,22,13,"PAH",90,1,39,0)="   patient only had pending outpatient orders, and no prescriptions, the"
^DIC(9.4,60,22,13,"PAH",90,1,40,0)="   pending outpatient orders would not display. This patch fixes the "
^DIC(9.4,60,22,13,"PAH",90,1,41,0)="   problem."
^DIC(9.4,60,22,13,"PAH",91,0)="101 SEQ #94^3020506^1"
^DIC(9.4,60,22,13,"PAH",91,1,0)="^^11^11^3020506"
^DIC(9.4,60,22,13,"PAH",91,1,1,0)="A problem was reported where certain Outpatient Pharmacy orders displayed "
^DIC(9.4,60,22,13,"PAH",91,1,2,0)="in Computerized Patient Record System (CPRS) with a truncated Sig. This "
^DIC(9.4,60,22,13,"PAH",91,1,3,0)="problem only happens on complex Outpatient Pharmacy orders. CPRS patch "
^DIC(9.4,60,22,13,"PAH",91,1,4,0)="OR*3*134 contains a fix that will prevent the problem for occurring. "
^DIC(9.4,60,22,13,"PAH",91,1,5,0)="For the currents orders that already have this problem, this patch,"
^DIC(9.4,60,22,13,"PAH",91,1,6,0)="PSO*7*101, will search for all Outpatient Pharmacy orders with complex"
^DIC(9.4,60,22,13,"PAH",91,1,7,0)="Dosing Instructions. A background job will synchronize the medication "
^DIC(9.4,60,22,13,"PAH",91,1,8,0)="instructions between CPRS and Pharmacy so the displays will be correct.  "
^DIC(9.4,60,22,13,"PAH",91,1,9,0)="When the post install completes, a Mailman message will be sent to the "
^DIC(9.4,60,22,13,"PAH",91,1,10,0)="installer of this patch.  Other than installing these two patches, IRM "
^DIC(9.4,60,22,13,"PAH",91,1,11,0)="does not need to take any additional action."
^DIC(9.4,60,22,13,"PAH",92,0)="102 SEQ #95^3020506^1"
^DIC(9.4,60,22,13,"PAH",92,1,0)="^^17^17^3020506"
^DIC(9.4,60,22,13,"PAH",92,1,1,0)="1. With the release of PSO*7*78 and editing of the PHARMACIST field (#20) or"
^DIC(9.4,60,22,13,"PAH",92,1,2,0)="the DIVISION field (#23) in the PRESCRIPTION file (#52) data can become "
^DIC(9.4,60,22,13,"PAH",92,1,3,0)="corrupted by storing extra characters.  This patch prevents further corruption. "
^DIC(9.4,60,22,13,"PAH",92,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",92,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",92,1,6,0)="2. Currently when editing the # OF REFILLS field (#9) in the PRESCRIPTION file"
^DIC(9.4,60,22,13,"PAH",92,1,7,0)="(#52) there is not currently a check to prevent a number from being entered"
^DIC(9.4,60,22,13,"PAH",92,1,8,0)="less than the number of refills already dispensed.  If the prescription was"
^DIC(9.4,60,22,13,"PAH",92,1,9,0)="originally entered with a total of 3 refills and 3 refills are dispensed, there"
^DIC(9.4,60,22,13,"PAH",92,1,10,0)="should be zero (0) refills remaining, but if a user were to edit the # OF"
^DIC(9.4,60,22,13,"PAH",92,1,11,0)="REFILLS field (#9) to 2 after dispensing 3, the refills remaining would show -1"
^DIC(9.4,60,22,13,"PAH",92,1,12,0)="refills remaining.  This patch will prevent a total number of refills entered"
^DIC(9.4,60,22,13,"PAH",92,1,13,0)="to be less than the number of refills already dispensed.  "
^DIC(9.4,60,22,13,"PAH",92,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",92,1,15,0)="3. When editing # OF REFILLS field (#9) in the PRESCRIPTION file (#52) an "
^DIC(9.4,60,22,13,"PAH",92,1,16,0)="undefined error could occur when doing a VA FileMan lookup on the DRUG file"
^DIC(9.4,60,22,13,"PAH",92,1,17,0)="(#50).  This patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",93,0)="94 SEQ #96^3020516^1"
^DIC(9.4,60,22,13,"PAH",93,1,0)="^^34^34^3020516"
^DIC(9.4,60,22,13,"PAH",93,1,1,0)=" 1. When placing a new order through Outpatient Pharmacy that generates a "
^DIC(9.4,60,22,13,"PAH",93,1,2,0)=" duplicate drug check on another active order, if that new order is viewed"
^DIC(9.4,60,22,13,"PAH",93,1,3,0)=" through Computerized Patient Record System (CPRS) utilizing the Detailed "
^DIC(9.4,60,22,13,"PAH",93,1,4,0)=" Display, the nature of order will show as ""Duplicate"", regardless of what"
^DIC(9.4,60,22,13,"PAH",93,1,5,0)=" nature of order was entered during the prescription entry process. This "
^DIC(9.4,60,22,13,"PAH",93,1,6,0)=" patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",93,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",93,1,8,0)=" 2. When finishing an order entered through CPRS in Outpatient Pharmacy, "
^DIC(9.4,60,22,13,"PAH",93,1,9,0)=" and there is no Dispense Drug associated with the order, and the Pharmacy"
^DIC(9.4,60,22,13,"PAH",93,1,10,0)=" Orderable Item has Drug Text associated with it, then an error would "
^DIC(9.4,60,22,13,"PAH",93,1,11,0)=" occur if the ListMan hidden action ""DIN  Drug Restr/Guide (OP)"" is used. "
^DIC(9.4,60,22,13,"PAH",93,1,12,0)=" This patch prevents the error from occurring."
^DIC(9.4,60,22,13,"PAH",93,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",93,1,14,0)=" 3. This patch fixes the problem of patient names sometimes not displaying"
^DIC(9.4,60,22,13,"PAH",93,1,15,0)=" on the bingo board when the patient has window prescriptions released "
^DIC(9.4,60,22,13,"PAH",93,1,16,0)=" through the Outpatient Pharmacy package."
^DIC(9.4,60,22,13,"PAH",93,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",93,1,18,0)=" 4. This patch changes the default Nature of Order response from WRITTEN"
^DIC(9.4,60,22,13,"PAH",93,1,19,0)=" to SERVICE CORRECTION when edits are made to pending orders and"
^DIC(9.4,60,22,13,"PAH",93,1,20,0)=" prescriptions that create a new order. (E3R 16682)"
^DIC(9.4,60,22,13,"PAH",93,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",93,1,22,0)=" 5. When using the Complete Orders from OERR [PSO LMOE FINISH] option, it"
^DIC(9.4,60,22,13,"PAH",93,1,23,0)=" is possible that the METHOD OF PICK-UP entered for one patient's"
^DIC(9.4,60,22,13,"PAH",93,1,24,0)=" prescription can be carried over as the default response to the METHOD OF"
^DIC(9.4,60,22,13,"PAH",93,1,25,0)=" PICK-UP prompt for the next patient's prescription. This patches fixes"
^DIC(9.4,60,22,13,"PAH",93,1,26,0)=" this problem."
^DIC(9.4,60,22,13,"PAH",93,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",93,1,28,0)=" 6. When a Renewal is done through Outpatient Pharmacy, a Nature of Order"
^DIC(9.4,60,22,13,"PAH",93,1,29,0)=" is prompted. The response to the Nature of Order prompt is sent to CPRS"
^DIC(9.4,60,22,13,"PAH",93,1,30,0)=" as the nature of Order for the new prescription, and also for the "
^DIC(9.4,60,22,13,"PAH",93,1,31,0)=" prescription that was discontinued because of the Renewal. Sending the"
^DIC(9.4,60,22,13,"PAH",93,1,32,0)=" Nature of Order for the discontinued order can possibly require a"
^DIC(9.4,60,22,13,"PAH",93,1,33,0)=" signature for the original provider in CPRS. This patch makes the change "
^DIC(9.4,60,22,13,"PAH",93,1,34,0)=" to not send the Nature of Order on the discontinued prescription."
^DIC(9.4,60,22,13,"PAH",94,0)="85 SEQ #97^3020516^1"
^DIC(9.4,60,22,13,"PAH",94,1,0)="^^66^66^3020516"
^DIC(9.4,60,22,13,"PAH",94,1,1,0)="Patch PSO*7*71 is required before the installation of this patch."
^DIC(9.4,60,22,13,"PAH",94,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,4,0)="This patch is a follow-up to patch PSO*7*71 for the Mill Bill Medication"
^DIC(9.4,60,22,13,"PAH",94,1,5,0)="Copay functionality. Items included in this patch are:"
^DIC(9.4,60,22,13,"PAH",94,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,7,0)="1. Under the Reset Copay Status/Cancel Charges [PSOCP RESET COPAY STATUS]"
^DIC(9.4,60,22,13,"PAH",94,1,8,0)="option changes were made to:"
^DIC(9.4,60,22,13,"PAH",94,1,9,0)="  a. Display an informative message for any fills selected for"
^DIC(9.4,60,22,13,"PAH",94,1,10,0)="cancellation that have already been cancelled."
^DIC(9.4,60,22,13,"PAH",94,1,11,0)="  b. Use the current value of the SERVICE CONNECTED field (#116) of the"
^DIC(9.4,60,22,13,"PAH",94,1,12,0)="PRESCRIPTION file (#52) instead of attempting to derive it from"
^DIC(9.4,60,22,13,"PAH",94,1,13,0)="information from a call to Integrated Billing."
^DIC(9.4,60,22,13,"PAH",94,1,14,0)="  c. Added patient name on the line following the prompt ""Select"
^DIC(9.4,60,22,13,"PAH",94,1,15,0)="PRESCRIPTION RX #:""."
^DIC(9.4,60,22,13,"PAH",94,1,16,0)="  d. Made correction to display the released date for the original fill"
^DIC(9.4,60,22,13,"PAH",94,1,17,0)="if it is present in the selection list for cancels."
^DIC(9.4,60,22,13,"PAH",94,1,18,0)="  e. Display (RTS) beside original fills that have been Returned to Stock"
^DIC(9.4,60,22,13,"PAH",94,1,19,0)="since there will not be a released date."
^DIC(9.4,60,22,13,"PAH",94,1,20,0)="  f. When choosing from the selection list for cancels, validate that the"
^DIC(9.4,60,22,13,"PAH",94,1,21,0)="response only includes items that are on the list."
^DIC(9.4,60,22,13,"PAH",94,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,23,0)="2. At release of a fill changes were made to:"
^DIC(9.4,60,22,13,"PAH",94,1,24,0)="  a. Use the current value of the SERVICE CONNECTED field (#116) of the"
^DIC(9.4,60,22,13,"PAH",94,1,25,0)="PRESCRIPTION file (#52) instead of attempting to derive it from"
^DIC(9.4,60,22,13,"PAH",94,1,26,0)="information from a call to Integrated Billing."
^DIC(9.4,60,22,13,"PAH",94,1,27,0)="  b. Unless the prescription is already exempt, always call Integrated"
^DIC(9.4,60,22,13,"PAH",94,1,28,0)="Billing to check for income exemption. (Before this change, some"
^DIC(9.4,60,22,13,"PAH",94,1,29,0)="prescriptions may appear in the copay activity log as being changed from"
^DIC(9.4,60,22,13,"PAH",94,1,30,0)="no copay to copay and then immediately changed back from copay to no"
^DIC(9.4,60,22,13,"PAH",94,1,31,0)="copay)."
^DIC(9.4,60,22,13,"PAH",94,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,33,0)="3. For the RETURN MEDICATION TO STOCK option changes were made for:"
^DIC(9.4,60,22,13,"PAH",94,1,34,0)="  a. If the last fill of a copay prescription has previously been"
^DIC(9.4,60,22,13,"PAH",94,1,35,0)="cancelled, a message to that effect is displayed instead of prompting"
^DIC(9.4,60,22,13,"PAH",94,1,36,0)="for the CHARGE REMOVAL REASON."
^DIC(9.4,60,22,13,"PAH",94,1,37,0)="  b. If the last fill of a copay prescription has previously been"
^DIC(9.4,60,22,13,"PAH",94,1,38,0)="cancelled, Integrated Billing is not called to cancel the charge."
^DIC(9.4,60,22,13,"PAH",94,1,39,0)="This will prevent an error message from IB."
^DIC(9.4,60,22,13,"PAH",94,1,40,0)="  c. When an original fill for a copay prescription is returned to stock,"
^DIC(9.4,60,22,13,"PAH",94,1,41,0)="the IB node contains the IB cancellation number. Now that a new call to"
^DIC(9.4,60,22,13,"PAH",94,1,42,0)="Integrated Billing is available to check whether an IB number is a bill"
^DIC(9.4,60,22,13,"PAH",94,1,43,0)="number or a cancel number, a change was made to call IB to bill if the"
^DIC(9.4,60,22,13,"PAH",94,1,44,0)="fill is released again when the IB number present is a cancellation"
^DIC(9.4,60,22,13,"PAH",94,1,45,0)="number."
^DIC(9.4,60,22,13,"PAH",94,1,46,0)="  d. Messages were changed from ""No Action Taken!"" to ""Prescription Not"
^DIC(9.4,60,22,13,"PAH",94,1,47,0)="Returned to Stock!"" if the return to stock action is not completed."
^DIC(9.4,60,22,13,"PAH",94,1,48,0)="  e. Correction was made to cancel ""potential charge"" (charge exceeding"
^DIC(9.4,60,22,13,"PAH",94,1,49,0)="annual cap) if it exists for the fill being returned to stock."
^DIC(9.4,60,22,13,"PAH",94,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,51,0)="4. The site number was added to the subject line of the MailMan message"
^DIC(9.4,60,22,13,"PAH",94,1,52,0)="generated when one or more copay exemption questions has never been"
^DIC(9.4,60,22,13,"PAH",94,1,53,0)="answered. e.g. Subj: RX COPAY STATUS REVIEW NEEDED (7121). Also a change"
^DIC(9.4,60,22,13,"PAH",94,1,54,0)="was made to the MailMan message to clarify. The ""Providers:"" section was"
^DIC(9.4,60,22,13,"PAH",94,1,55,0)="added and ""Staff assigned to update the Prescription Copay Status:"" was"
^DIC(9.4,60,22,13,"PAH",94,1,56,0)="added just before the instructions for follow-up. The new text appears as:"
^DIC(9.4,60,22,13,"PAH",94,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,59,0)="Providers:"
^DIC(9.4,60,22,13,"PAH",94,1,60,0)="Please respond with your answer to the question(s) as a reply to this"
^DIC(9.4,60,22,13,"PAH",94,1,61,0)="message. The prescription will be updated by the appropriate staff."
^DIC(9.4,60,22,13,"PAH",94,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",94,1,63,0)="Staff assigned to update the Prescription Copay Status:"
^DIC(9.4,60,22,13,"PAH",94,1,64,0)="Please use the RESET COPAY STATUS/CANCEL CHARGES option to enter the"
^DIC(9.4,60,22,13,"PAH",94,1,65,0)="responses to the questions above, which may result in a Rx copay status"
^DIC(9.4,60,22,13,"PAH",94,1,66,0)="change and/or the need to remove copay charges."
^DIC(9.4,60,22,13,"PAH",95,0)="103 SEQ #98^3020605^1"
^DIC(9.4,60,22,13,"PAH",95,1,0)="^^5^5^3020605"
^DIC(9.4,60,22,13,"PAH",95,1,1,0)="Before the release of the Pharmacy Ordering Enhancement patch (POE) pharmacy"
^DIC(9.4,60,22,13,"PAH",95,1,2,0)="users entered the patient medication instructions (SIG) using quick codes that"
^DIC(9.4,60,22,13,"PAH",95,1,3,0)="expand into readable instructions for the patient.  There are some reported"
^DIC(9.4,60,22,13,"PAH",95,1,4,0)="instances  where the quick codes are missing and an undefined error occurs. "
^DIC(9.4,60,22,13,"PAH",95,1,5,0)="This patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",96,0)="104 SEQ #99^3020605^1"
^DIC(9.4,60,22,13,"PAH",96,1,0)="^^23^23^3020605"
^DIC(9.4,60,22,13,"PAH",96,1,1,0)="This patch addresses the following concerns: "
^DIC(9.4,60,22,13,"PAH",96,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",96,1,3,0)="1. This patch corrects an undefined error that occurs when all the dosage "
^DIC(9.4,60,22,13,"PAH",96,1,4,0)="information is not asked for by the software when entering new"
^DIC(9.4,60,22,13,"PAH",96,1,5,0)="prescriptions.  This was a random error that only happened on occasion."
^DIC(9.4,60,22,13,"PAH",96,1,6,0)="When this error occurred it caused incomplete data to be added to the"
^DIC(9.4,60,22,13,"PAH",96,1,7,0)="PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",96,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",96,1,9,0)="2. With the release of PSO*7*78 a prompt was added after editing a"
^DIC(9.4,60,22,13,"PAH",96,1,10,0)="prescription to ask the user, ""Are You Sure You Want to Update Rx"
^DIC(9.4,60,22,13,"PAH",96,1,11,0)="#? Yes//"", if the edits did not create a new prescription.  Updates"
^DIC(9.4,60,22,13,"PAH",96,1,12,0)="to the prescription do not occur now until after the user finishes making"
^DIC(9.4,60,22,13,"PAH",96,1,13,0)="changes to the fields selected for editing and accepts the changes at the"
^DIC(9.4,60,22,13,"PAH",96,1,14,0)="new prompt.  A problem was introduced with this patch in that when editing"
^DIC(9.4,60,22,13,"PAH",96,1,15,0)="free text fields and the input data contains a semi-colon (;), an error would"
^DIC(9.4,60,22,13,"PAH",96,1,16,0)="occur when trying to update the PRESCRIPTION file (#52) entry."
^DIC(9.4,60,22,13,"PAH",96,1,17,0)="This patch corrects this problem. "
^DIC(9.4,60,22,13,"PAH",96,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",96,1,19,0)="3. When editing prescriptions that cause new prescriptions to be created,"
^DIC(9.4,60,22,13,"PAH",96,1,20,0)="prescription numbers were being skipped.  For example, if the last number"
^DIC(9.4,60,22,13,"PAH",96,1,21,0)="used for a prescription was 5 and the next number to be used was 6.  A"
^DIC(9.4,60,22,13,"PAH",96,1,22,0)="prescription is edited in that it causes a new prescription to be created, the"
^DIC(9.4,60,22,13,"PAH",96,1,23,0)="next number was defaulting to 7 instead 6.  This patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",97,0)="105 SEQ #100^3020605^1"
^DIC(9.4,60,22,13,"PAH",97,1,0)="^^4^4^3020605"
^DIC(9.4,60,22,13,"PAH",97,1,1,0)="Both Computerized Patient Record System (CPRS) V. 1.0 and Inpatient "
^DIC(9.4,60,22,13,"PAH",97,1,2,0)="Medications V. 5.0 packages were inappropriately display order check with "
^DIC(9.4,60,22,13,"PAH",97,1,3,0)="an Inaction Date entered in the Inaction Date field (#7) of the Drug "
^DIC(9.4,60,22,13,"PAH",97,1,4,0)="Interaction file (#56)."
^DIC(9.4,60,22,13,"PAH",98,0)="92 SEQ #101^3020626^1"
^DIC(9.4,60,22,13,"PAH",98,1,0)="^^14^14^3020626"
^DIC(9.4,60,22,13,"PAH",98,1,1,0)="Central Texas Veterans Health Care System has received multiple complaints"
^DIC(9.4,60,22,13,"PAH",98,1,2,0)="from patients about their full Social Security Number (SSN) printing on"
^DIC(9.4,60,22,13,"PAH",98,1,3,0)="their prescription reorder documents.  Currently the SSN at the top of the"
^DIC(9.4,60,22,13,"PAH",98,1,4,0)="refill document shows the last 6 digits, however the full SSN shows next to"
^DIC(9.4,60,22,13,"PAH",98,1,5,0)="the patient's name on the last page, just above the NARRATIVE REFILLABLE RX"
^DIC(9.4,60,22,13,"PAH",98,1,6,0)="document.  This patch will change all instances of the patient's SSN on the"
^DIC(9.4,60,22,13,"PAH",98,1,7,0)="reorder documents to display only the last 6 digits. This patch will change"
^DIC(9.4,60,22,13,"PAH",98,1,8,0)="all instances of the patient's SSN on the reorder documents and to the"
^DIC(9.4,60,22,13,"PAH",98,1,9,0)="section that shows any possible allergies and adverse reactions to display"
^DIC(9.4,60,22,13,"PAH",98,1,10,0)="only the last 6 digits.  "
^DIC(9.4,60,22,13,"PAH",98,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",98,1,12,0)="Please Note: If your site is using any class 3 software that requires the"
^DIC(9.4,60,22,13,"PAH",98,1,13,0)="full social security number, it may be necessary to make that this patch will"
^DIC(9.4,60,22,13,"PAH",98,1,14,0)="not cause that software to malfunction if installed. "
^DIC(9.4,60,22,13,"PAH",99,0)="106 SEQ #102^3020626^1"
^DIC(9.4,60,22,13,"PAH",99,1,0)="^^11^11^3020626"
^DIC(9.4,60,22,13,"PAH",99,1,1,0)="1. When a user who does not possess the PSORPH key finishes a pending "
^DIC(9.4,60,22,13,"PAH",99,1,2,0)="order using the Complete Orders from OERR [PSO LMOE FINISH] option, the "
^DIC(9.4,60,22,13,"PAH",99,1,3,0)="order is flagged as active instead of non-verified. This patch corrects"
^DIC(9.4,60,22,13,"PAH",99,1,4,0)="this problem."
^DIC(9.4,60,22,13,"PAH",99,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",99,1,6,0)="2. When finishing a pending order using either the Patient Prescription "
^DIC(9.4,60,22,13,"PAH",99,1,7,0)="Processing [PSO LM BACKDOOR ORDERS] option, or the Complete Orders from"
^DIC(9.4,60,22,13,"PAH",99,1,8,0)="OERR [PSO LMOE FINISH] option, the METHOD OF PICK-UP entered for one"
^DIC(9.4,60,22,13,"PAH",99,1,9,0)="prescription is not carried over as the default response to the same"
^DIC(9.4,60,22,13,"PAH",99,1,10,0)="prompt for the rest of the prescriptions on the same patient. This patch"
^DIC(9.4,60,22,13,"PAH",99,1,11,0)="fixes this problem. "
^DIC(9.4,60,22,13,"PAH",100,0)="70 SEQ #103^3020626^1"
^DIC(9.4,60,22,13,"PAH",100,1,0)="^^51^51^3020626"
^DIC(9.4,60,22,13,"PAH",100,1,1,0)="1. If a site has the External Interface outpatient site parameter set to"
^DIC(9.4,60,22,13,"PAH",100,1,2,0)="   either ""2:SEND ALL ORDERS AND DON'T PRINT LABEL"" or ""3:SEND MARKED "
^DIC(9.4,60,22,13,"PAH",100,1,3,0)="   ORDERS AND DON'T PRINT"", a problem can occur when issuing a partial"
^DIC(9.4,60,22,13,"PAH",100,1,4,0)="   prescription. If there is already an original fill or refill suspended "
^DIC(9.4,60,22,13,"PAH",100,1,5,0)="   for a prescription, and a partial prescription is issued, the suspended"
^DIC(9.4,60,22,13,"PAH",100,1,6,0)="   fill will be removed from suspense, and the status of the prescription"
^DIC(9.4,60,22,13,"PAH",100,1,7,0)="   will be set to Active when the partial prescription is sent to the "
^DIC(9.4,60,22,13,"PAH",100,1,8,0)="   external interface. The prescription fill should remain in suspense,"
^DIC(9.4,60,22,13,"PAH",100,1,9,0)="   and the status of the prescription should remain Suspended. This patch"
^DIC(9.4,60,22,13,"PAH",100,1,10,0)="   will make that correction."
^DIC(9.4,60,22,13,"PAH",100,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,12,0)="2. This patch will fix errors that can possibly occur when the external"
^DIC(9.4,60,22,13,"PAH",100,1,13,0)="   interface encounters bad prescription data."
^DIC(9.4,60,22,13,"PAH",100,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,15,0)="3. It was reported by some sites that if the site has multiple dispensing"
^DIC(9.4,60,22,13,"PAH",100,1,16,0)="   machines, when the prescription is entered at one of these machines,"
^DIC(9.4,60,22,13,"PAH",100,1,17,0)="   the same prescription gets transmitted to the other machines. This"
^DIC(9.4,60,22,13,"PAH",100,1,18,0)="   patch is setting the HLL(""LINKS"") array to dynamically specify one or"
^DIC(9.4,60,22,13,"PAH",100,1,19,0)="   more recipients for the HL7 message to insure that the prescription"
^DIC(9.4,60,22,13,"PAH",100,1,20,0)="   entered at one of the devices will not be transmitted to the others."
^DIC(9.4,60,22,13,"PAH",100,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,23,0)="                        ***** NOTE *****"
^DIC(9.4,60,22,13,"PAH",100,1,24,0)="The new software design will be using the Dynamic Addressing setup as"
^DIC(9.4,60,22,13,"PAH",100,1,25,0)="described in the following steps:"
^DIC(9.4,60,22,13,"PAH",100,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,27,0)="1. It is recommended for the site to have only one Client and one Server"
^DIC(9.4,60,22,13,"PAH",100,1,28,0)="   Protocol, and to delete the LOGICAL LINK (LL) field (#770.7) of the"
^DIC(9.4,60,22,13,"PAH",100,1,29,0)="   PROTOCOL file (#101) for those Client and Server Protocols. Then the"
^DIC(9.4,60,22,13,"PAH",100,1,30,0)="   site would need to create a LL for every ""machine"" that it has."
^DIC(9.4,60,22,13,"PAH",100,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,32,0)="2. Deriving the LL for each prescription using the following methods:"
^DIC(9.4,60,22,13,"PAH",100,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,34,0)=" a) The software will use the LL entry from the CPRS ORDERING INSTITUTION"
^DIC(9.4,60,22,13,"PAH",100,1,35,0)="    subfile (#59.08) multiple of the OUTPATIENT SITE file (#59) if there"
^DIC(9.4,60,22,13,"PAH",100,1,36,0)="    is a Clinic associated with the prescription, and the Institution"
^DIC(9.4,60,22,13,"PAH",100,1,37,0)="    derived from that Clinic has an entry in this CPRS ORDERING"
^DIC(9.4,60,22,13,"PAH",100,1,38,0)="    INSTITUTION subfile (#59.08) multiple of the OUTPATIENT SITE file "
^DIC(9.4,60,22,13,"PAH",100,1,39,0)="    (#59) with an associated LL."
^DIC(9.4,60,22,13,"PAH",100,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,41,0)=" b) The LL on the top level will be used for the prescription in"
^DIC(9.4,60,22,13,"PAH",100,1,42,0)="    the following cases:"
^DIC(9.4,60,22,13,"PAH",100,1,43,0)="    - If there is no Clinic associated with the prescription."
^DIC(9.4,60,22,13,"PAH",100,1,44,0)="    - If there is a Clinic associated with the prescription, but the"
^DIC(9.4,60,22,13,"PAH",100,1,45,0)="      Institution derived from that Clinic does not have an entry in the"
^DIC(9.4,60,22,13,"PAH",100,1,46,0)="      CPRS ORDERING INSTITUTION subfile (#59.08) multiple of the "
^DIC(9.4,60,22,13,"PAH",100,1,47,0)="      OUTPATIENT SITE file (#59) with an associated LL for that Outpatient"
^DIC(9.4,60,22,13,"PAH",100,1,48,0)="      Site entry."
^DIC(9.4,60,22,13,"PAH",100,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",100,1,50,0)=" c) If the LL can't be derived through the previous steps then it's"
^DIC(9.4,60,22,13,"PAH",100,1,51,0)="    defaulted to ""PSO LLP1"" (sent out with Outpatient Pharmacy package)."
^DIC(9.4,60,22,13,"PAH",101,0)="107 SEQ #104^3020724^1"
^DIC(9.4,60,22,13,"PAH",101,1,0)="^^3^3^3020724"
^DIC(9.4,60,22,13,"PAH",101,1,1,0)="This patch replaces all occurrences of *13 with $C(13) in the Outpatient"
^DIC(9.4,60,22,13,"PAH",101,1,2,0)="Pharmacy V. 7.0 package in order to make it vendor independent as per"
^DIC(9.4,60,22,13,"PAH",101,1,3,0)="SOP 192-104."
^DIC(9.4,60,22,13,"PAH",102,0)="99 SEQ #105^3020814^1"
^DIC(9.4,60,22,13,"PAH",102,1,0)="^^64^64^3020814"
^DIC(9.4,60,22,13,"PAH",102,1,1,0)="1. When finishing a pending order entered through Computerized Patient"
^DIC(9.4,60,22,13,"PAH",102,1,2,0)="Record System (CPRS), and fields are edited during the finish process that"
^DIC(9.4,60,22,13,"PAH",102,1,3,0)="are used in the automatic Quantity calculation such as Days Supply or"
^DIC(9.4,60,22,13,"PAH",102,1,4,0)="Schedule, a recalculation is done on the Quantity of the prescription,"
^DIC(9.4,60,22,13,"PAH",102,1,5,0)="whether the edits created a new order or not. A request has been made to"
^DIC(9.4,60,22,13,"PAH",102,1,6,0)="not recalculate the Quantity based on these edits when finishing a pending"
^DIC(9.4,60,22,13,"PAH",102,1,7,0)="order from CPRS if any of the Schedules associated with the order contain"
^DIC(9.4,60,22,13,"PAH",102,1,8,0)="PRN, or if the drug is a Schedule 2, 3, 4, or 5, meaning the DEA,"
^DIC(9.4,60,22,13,"PAH",102,1,9,0)="SPECIAL HDLG field (#3) of the DRUG file (#50) for the drug associated"
^DIC(9.4,60,22,13,"PAH",102,1,10,0)="with the order contains a 2, 3, 4, or 5. This patch makes this change. A"
^DIC(9.4,60,22,13,"PAH",102,1,11,0)="message has also been added that will be displayed during the finish"
^DIC(9.4,60,22,13,"PAH",102,1,12,0)="process only when the quantity is automatically updated by the software,"
^DIC(9.4,60,22,13,"PAH",102,1,13,0)="due to edits of any of these fields."
^DIC(9.4,60,22,13,"PAH",102,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",102,1,15,0)="2. There are occurrences throughout the Outpatient Pharmacy package where "
^DIC(9.4,60,22,13,"PAH",102,1,16,0)="Possible Dosages and Dispense Units per Dose are displayed, and if that "
^DIC(9.4,60,22,13,"PAH",102,1,17,0)="numeric data begins with a decimal point, such as "".5,"" then that is how"
^DIC(9.4,60,22,13,"PAH",102,1,18,0)="it is displayed, as "".5"". This patch will make change to add a leading"
^DIC(9.4,60,22,13,"PAH",102,1,19,0)="zero to these displays, so "".5"" will now be displayed as ""0.5"". This"
^DIC(9.4,60,22,13,"PAH",102,1,20,0)="change will not apply to Local Possible Dosages. It will only apply to"
^DIC(9.4,60,22,13,"PAH",102,1,21,0)="Possible Dosages and Dispense Units per Dose."
^DIC(9.4,60,22,13,"PAH",102,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",102,1,23,0)="3. When prescriptions are entered that contain Possible Dosages, the Noun "
^DIC(9.4,60,22,13,"PAH",102,1,24,0)="that is applied to the Dosing Instruction comes from the DOSAGE FORM file "
^DIC(9.4,60,22,13,"PAH",102,1,25,0)="(#50.606). If that Noun ends in ""(S)"" or ""(s)"", such as TABLET(S) or "
^DIC(9.4,60,22,13,"PAH",102,1,26,0)="CAPSULE(S), the software will adjust the Noun based on the Dispense Units "
^DIC(9.4,60,22,13,"PAH",102,1,27,0)="per Dose. For example, if the Noun is TABLET(S), then the software will "
^DIC(9.4,60,22,13,"PAH",102,1,28,0)="change the Noun to TABLET if the Dispense Units per Dose is one or "
^DIC(9.4,60,22,13,"PAH",102,1,29,0)="less, and the software will change the Noun to TABLETS if the Dispense "
^DIC(9.4,60,22,13,"PAH",102,1,30,0)="Units per Dose is greater than one. When prescriptions and pending orders "
^DIC(9.4,60,22,13,"PAH",102,1,31,0)="are edited, this conversion of the Noun does not always take place. This "
^DIC(9.4,60,22,13,"PAH",102,1,32,0)="patch makes the change to convert the Noun to it's proper form when edits "
^DIC(9.4,60,22,13,"PAH",102,1,33,0)="are made."
^DIC(9.4,60,22,13,"PAH",102,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",102,1,35,0)="4. When finishing a pending order using either the Patient Prescription "
^DIC(9.4,60,22,13,"PAH",102,1,36,0)="Processing [PSO LM BACKDOOR ORDERS] option, or the Complete Orders from"
^DIC(9.4,60,22,13,"PAH",102,1,37,0)="OERR [PSO LMOE FINISH] option, an undefined error could occur if the"
^DIC(9.4,60,22,13,"PAH",102,1,38,0)="ListMan action ""EA Enter/Edit Allergy/ADR Data"" is selected to add or edit"
^DIC(9.4,60,22,13,"PAH",102,1,39,0)="allergy information. This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",102,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",102,1,41,0)="5. There is an order check for drugs with data entered in the MAXIMUM DOSE"
^DIC(9.4,60,22,13,"PAH",102,1,42,0)="PER DAY field (#4) of the DRUG file (#50), that divides Quantity by Days"
^DIC(9.4,60,22,13,"PAH",102,1,43,0)="Supply, and if that's greater than the MAXIMUM DOSE PER DAY, an order"
^DIC(9.4,60,22,13,"PAH",102,1,44,0)="check is given. A problem occurred when this order check was given when"
^DIC(9.4,60,22,13,"PAH",102,1,45,0)="finishing an order entered through Computerized Patient Record System"
^DIC(9.4,60,22,13,"PAH",102,1,46,0)="(CPRS). If an '^' is entered at the 'Do You Want to Edit Days Supply and"
^DIC(9.4,60,22,13,"PAH",102,1,47,0)="Quantity Fields?' prompt, the user will exit the process, but the"
^DIC(9.4,60,22,13,"PAH",102,1,48,0)="subsequent prompts for that order are still given, even though the order"
^DIC(9.4,60,22,13,"PAH",102,1,49,0)="will not be finished because of the '^' that was entered. This patch will"
^DIC(9.4,60,22,13,"PAH",102,1,50,0)="suppress those remaining prompts after the '^' is entered."
^DIC(9.4,60,22,13,"PAH",102,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",102,1,52,0)="6. When an active prescription is copied using the CO Copy (OP) hidden"
^DIC(9.4,60,22,13,"PAH",102,1,53,0)="action in Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option,"
^DIC(9.4,60,22,13,"PAH",102,1,54,0)="and if the CONJUNCTION field (#5) of the MEDICATION INSTRUCTIONS sub-file"
^DIC(9.4,60,22,13,"PAH",102,1,55,0)="(#52.0113) of the PRESCRIPTION file (#52) is deleted using the @ key, then"
^DIC(9.4,60,22,13,"PAH",102,1,56,0)="the software does not trigger the duplicate drug check and as a result"
^DIC(9.4,60,22,13,"PAH",102,1,57,0)="duplicate active prescriptions are created. Also it was observed that"
^DIC(9.4,60,22,13,"PAH",102,1,58,0)="deleting this field by using the @ key during the process of"
^DIC(9.4,60,22,13,"PAH",102,1,59,0)="creating/editing a prescription, the software prompts the question"
^DIC(9.4,60,22,13,"PAH",102,1,60,0)="""Deleting this conjunction will delete the dosing sequence that follows!"","
^DIC(9.4,60,22,13,"PAH",102,1,61,0)="even when no conjunctions are defined. In such a situation this patch will"
^DIC(9.4,60,22,13,"PAH",102,1,62,0)="display a message ""Invalid Entry - nothing to delete"" and will loop back"
^DIC(9.4,60,22,13,"PAH",102,1,63,0)="to the CONJUNCTION field (#5) of the MEDICATION INSTRUCTIONS sub-file "
^DIC(9.4,60,22,13,"PAH",102,1,64,0)="(#52.0113) of the PRESCRIPTION file (#52) prompt."
^DIC(9.4,60,22,13,"PAH",103,0)="108 SEQ #106^3020906^1"
^DIC(9.4,60,22,13,"PAH",103,1,0)="^^19^19^3020906"
^DIC(9.4,60,22,13,"PAH",103,1,1,0)="1. A site reported a problem with the maximum refills calculation for an "
^DIC(9.4,60,22,13,"PAH",103,1,2,0)="order placed through the Computerized Patient Records System (CPRS) V. "
^DIC(9.4,60,22,13,"PAH",103,1,3,0)="1.0. The problem occurred if a free-text dosage was used. This patch "
^DIC(9.4,60,22,13,"PAH",103,1,4,0)="corrects this problem. NOIS UNY-0302-12906"
^DIC(9.4,60,22,13,"PAH",103,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",103,1,6,0)="2. When finishing a pending order for a Clozapine drug using either the "
^DIC(9.4,60,22,13,"PAH",103,1,7,0)="Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option, or the"
^DIC(9.4,60,22,13,"PAH",103,1,8,0)="Complete Orders from OERR [PSO LMOE FINISH] option, the software sets the"
^DIC(9.4,60,22,13,"PAH",103,1,9,0)="default DAYS SUPPLY field (#8) of the PRESCRIPTION file (#52) to a maximum"
^DIC(9.4,60,22,13,"PAH",103,1,10,0)="of 7 days even if the pending order had 14 days supply. This patch ensures"
^DIC(9.4,60,22,13,"PAH",103,1,11,0)="that the DAYS SUPPLY field (#8) is set to a maximum of 7 or 14 days "
^DIC(9.4,60,22,13,"PAH",103,1,12,0)="depending on the DISPENSE FREQUENCY field (#2) of the CLOZAPINE PATIENT"
^DIC(9.4,60,22,13,"PAH",103,1,13,0)="LIST file (#603.01). NOIS TUA-0302-31000"
^DIC(9.4,60,22,13,"PAH",103,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",103,1,15,0)="3. In Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option, if "
^DIC(9.4,60,22,13,"PAH",103,1,16,0)="the CO Copy (OP) hidden action is used first and then if a pending order "
^DIC(9.4,60,22,13,"PAH",103,1,17,0)="is completed, the software displays the clinic name of the CLINIC field "
^DIC(9.4,60,22,13,"PAH",103,1,18,0)="(#5) of the PRESCRIPTION file (#52) that was in the previous prescription "
^DIC(9.4,60,22,13,"PAH",103,1,19,0)="that was copied. This patch corrects this problem. NOIS CON-0602-11684"
^DIC(9.4,60,22,13,"PAH",104,0)="88 SEQ #107^3020927^1"
^DIC(9.4,60,22,13,"PAH",104,1,0)="^^15^15^3020927"
^DIC(9.4,60,22,13,"PAH",104,1,1,0)="1. A potential patient safety issue is being addressed in this patch."
^DIC(9.4,60,22,13,"PAH",104,1,2,0)="Currently when a date of death is entered into the Date Of Death field"
^DIC(9.4,60,22,13,"PAH",104,1,3,0)="(#.351) in the Patient file (#2), all active prescriptions are automatically"
^DIC(9.4,60,22,13,"PAH",104,1,4,0)="discontinued.  The patient safety issue is when a date of death is entered"
^DIC(9.4,60,22,13,"PAH",104,1,5,0)="in error, which can cause the patient to missed their next fill because the"
^DIC(9.4,60,22,13,"PAH",104,1,6,0)="Outpatient Pharmacy system has no way of determining which prescriptions were"
^DIC(9.4,60,22,13,"PAH",104,1,7,0)="Discontinued and which ones should be reinstated.  This patch and the"
^DIC(9.4,60,22,13,"PAH",104,1,8,0)="DG*5.3*455 patch will correct this."
^DIC(9.4,60,22,13,"PAH",104,1,9,0)="  "
^DIC(9.4,60,22,13,"PAH",104,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",104,1,11,0)="2. This patch corrects a problem where prescriptions are automatically"
^DIC(9.4,60,22,13,"PAH",104,1,12,0)="discontinued by a date of death entry or 3 days after a patient has been"
^DIC(9.4,60,22,13,"PAH",104,1,13,0)="admitted to the medical center.  The problem occurred when the"
^DIC(9.4,60,22,13,"PAH",104,1,14,0)="prescriptions are reinstated.  The fill dates are not being reset correctly"
^DIC(9.4,60,22,13,"PAH",104,1,15,0)="to the dates prior to being automatically discontinued."
^DIC(9.4,60,22,13,"PAH",105,0)="111 SEQ #108^3021025^1"
^DIC(9.4,60,22,13,"PAH",105,1,0)="^^19^19^3021025"
^DIC(9.4,60,22,13,"PAH",105,1,1,0)="This patch is in support of the HUI/VHA CIO SD&D Pharmacy Data "
^DIC(9.4,60,22,13,"PAH",105,1,2,0)="Interchange project. The project provides a method for the one-way "
^DIC(9.4,60,22,13,"PAH",105,1,3,0)="electronic transfer of prescription orders from an external system to "
^DIC(9.4,60,22,13,"PAH",105,1,4,0)="VistA."
^DIC(9.4,60,22,13,"PAH",105,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",105,1,6,0)="This patch exports the PSO RECEIVE ORDER Protocol, the PSO RECEIVE HL7 "
^DIC(9.4,60,22,13,"PAH",105,1,7,0)="Application Parameter, and the PSO LLPO HL Logical Link. These can be "
^DIC(9.4,60,22,13,"PAH",105,1,8,0)="used to recieve new orders and cancel orders from an outside source into "
^DIC(9.4,60,22,13,"PAH",105,1,9,0)="the Outpatient Pharmacy Vista database. If sites do not wish to utilize "
^DIC(9.4,60,22,13,"PAH",105,1,10,0)="this functionality, nothing needs to be done besides installing the "
^DIC(9.4,60,22,13,"PAH",105,1,11,0)="patch. If sites want to utilize this functionality, more information on "
^DIC(9.4,60,22,13,"PAH",105,1,12,0)="the setup and the data elements are documented at:"
^DIC(9.4,60,22,13,"PAH",105,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",105,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",105,1,15,0)="This patch also fixes a problem of an undefined error that can occur "
^DIC(9.4,60,22,13,"PAH",105,1,16,0)="when entering a new prescription. At the PATIENT INSTRUCTIONS prompt, if "
^DIC(9.4,60,22,13,"PAH",105,1,17,0)="text is entered greater than 32 characters in length, without any spaces,"
^DIC(9.4,60,22,13,"PAH",105,1,18,0)="an error will occur. This patch will fix the error, and the user will now "
^DIC(9.4,60,22,13,"PAH",105,1,19,0)="be re-prompted for PATIENT INSTRUCTIONS when this occurs."
^DIC(9.4,60,22,13,"PAH",106,0)="114 SEQ #109^3021108^1"
^DIC(9.4,60,22,13,"PAH",106,1,0)="^^60^60^3021108"
^DIC(9.4,60,22,13,"PAH",106,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,2,0)="1. If a returned to stock prescription is put on HOLD, then UNHELD and a"
^DIC(9.4,60,22,13,"PAH",106,1,3,0)="   label prints, the label is not marked as a reprint, so the"
^DIC(9.4,60,22,13,"PAH",106,1,4,0)="   prescription cannot be released until the label reprint option is used."
^DIC(9.4,60,22,13,"PAH",106,1,5,0)="   This patch will mark the label as being a reprint and also will set the"
^DIC(9.4,60,22,13,"PAH",106,1,6,0)="   reprinted label indicator in the prescription file so that a returned"
^DIC(9.4,60,22,13,"PAH",106,1,7,0)="   to stock prescription can be released when unheld."
^DIC(9.4,60,22,13,"PAH",106,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,9,0)="  "
^DIC(9.4,60,22,13,"PAH",106,1,10,0)="2. If a prescription is put on HOLD and later on is UNHELD, the user is"
^DIC(9.4,60,22,13,"PAH",106,1,11,0)="   always prompted for ""FILL (or REFILL) DATE"" and ""MAIL/WINDOW"". This "
^DIC(9.4,60,22,13,"PAH",106,1,12,0)="   was allowing the user to overwrite the original fill/refill date on"
^DIC(9.4,60,22,13,"PAH",106,1,13,0)="   file, even after the prescription had already been released. This  "
^DIC(9.4,60,22,13,"PAH",106,1,14,0)="   was misleading, giving users the impression that the prescription"
^DIC(9.4,60,22,13,"PAH",106,1,15,0)="   would be filled and the labels would print. Since the prescription"
^DIC(9.4,60,22,13,"PAH",106,1,16,0)="   had already been released, the fill and the label print did not "
^DIC(9.4,60,22,13,"PAH",106,1,17,0)="   happen. Once this patch is installed, these two fields will only be"
^DIC(9.4,60,22,13,"PAH",106,1,18,0)="   asked if the prescription (or refill) has NOT yet been released."
^DIC(9.4,60,22,13,"PAH",106,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,20,0)="3. If one of the copay exemption questions applies to a patient, but has"
^DIC(9.4,60,22,13,"PAH",106,1,21,0)="   never been answered, under the RESET COPAY STATUS/CANCEL CHARGES"
^DIC(9.4,60,22,13,"PAH",106,1,22,0)="   [PSOCP RESET COPAY STATUS] option, the default for the question: ""Do"
^DIC(9.4,60,22,13,"PAH",106,1,23,0)="   you want to enter/edit any copay exemption flags? N//"" will be changed"
^DIC(9.4,60,22,13,"PAH",106,1,24,0)="   from N to Y."
^DIC(9.4,60,22,13,"PAH",106,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,26,0)="4. The MailMan message which is generated when a copay exemption question"
^DIC(9.4,60,22,13,"PAH",106,1,27,0)="   applies but has not been answered generated errors at at least one"
^DIC(9.4,60,22,13,"PAH",106,1,28,0)="   site when there was no provider in the prescription. This patch adds a"
^DIC(9.4,60,22,13,"PAH",106,1,29,0)="   check for the provider field being null and if so, does not attempt to"
^DIC(9.4,60,22,13,"PAH",106,1,30,0)="   queue the MailMan message to a non-existent provider."
^DIC(9.4,60,22,13,"PAH",106,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,32,0)="5. When using Backdoor Orders, if the user selected to edit the 'PATIENT"
^DIC(9.4,60,22,13,"PAH",106,1,33,0)="   STATUS' and '# OF REFILLS' (5,11) of a prescription, the possible "
^DIC(9.4,60,22,13,"PAH",106,1,34,0)="   range for number of refills was showing as '(0-999999999999)'. This "
^DIC(9.4,60,22,13,"PAH",106,1,35,0)="   allowed the user to enter any value between '0' and '999999999999'."
^DIC(9.4,60,22,13,"PAH",106,1,36,0)="   Once this patch is installed this problem will be corrected and the"
^DIC(9.4,60,22,13,"PAH",106,1,37,0)="   actual maximum number of refills will be shown as the maximum value "
^DIC(9.4,60,22,13,"PAH",106,1,38,0)="   for the range."
^DIC(9.4,60,22,13,"PAH",106,1,39,0)="   "
^DIC(9.4,60,22,13,"PAH",106,1,40,0)="6. When the user tried to delete a single dosage from a set of 4 or more"
^DIC(9.4,60,22,13,"PAH",106,1,41,0)="   dosages (complex dosage), the system was not deleting. It would accept"
^DIC(9.4,60,22,13,"PAH",106,1,42,0)="   the deletion, but when the user tried to accept the changes, it would "
^DIC(9.4,60,22,13,"PAH",106,1,43,0)="   block with the message ""dosage missing!"". This patch will fix this "
^DIC(9.4,60,22,13,"PAH",106,1,44,0)="   problem and the user will be able to delete such dosages."
^DIC(9.4,60,22,13,"PAH",106,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,46,0)="7. When an order entered through Computerized Patient Record System"
^DIC(9.4,60,22,13,"PAH",106,1,47,0)="   (CPRS) is finished in Pharmacy, and an edit is made that generates an"
^DIC(9.4,60,22,13,"PAH",106,1,48,0)="   automatic recalculation of the quantity of the prescription, a message"
^DIC(9.4,60,22,13,"PAH",106,1,49,0)="   is displayed to the screen indicating that the quantity has been"
^DIC(9.4,60,22,13,"PAH",106,1,50,0)="   updated. There are also occurrences when the quantity is updated"
^DIC(9.4,60,22,13,"PAH",106,1,51,0)="   automatically and that message is not displayed, such as editing after"
^DIC(9.4,60,22,13,"PAH",106,1,52,0)="   a Copy, or editing after entering a new prescription but prior to"
^DIC(9.4,60,22,13,"PAH",106,1,53,0)="   accepting, or editing after accepting an edit that creates a new order."
^DIC(9.4,60,22,13,"PAH",106,1,54,0)="   With this patch, the quantity update message will display every time an"
^DIC(9.4,60,22,13,"PAH",106,1,55,0)="   edit is made and a new quantity is automatically calculated."
^DIC(9.4,60,22,13,"PAH",106,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",106,1,57,0)="8. When entering a new prescription, at the PATIENT INSTRUCTIONS prompt,"
^DIC(9.4,60,22,13,"PAH",106,1,58,0)="   if text is entered greater than 32 characters in length, without any"
^DIC(9.4,60,22,13,"PAH",106,1,59,0)="   spaces, an error will occur. This patch will fix the error, and the"
^DIC(9.4,60,22,13,"PAH",106,1,60,0)="   user will now be re-prompted for PATIENT INSTRUCTIONS when this occurs."
^DIC(9.4,60,22,13,"PAH",107,0)="115 SEQ #110^3021122^1"
^DIC(9.4,60,22,13,"PAH",107,1,0)="^^28^28^3021122"
^DIC(9.4,60,22,13,"PAH",107,1,1,0)="Associated patches: (v)PSO*7*95  <<= must be installed BEFORE `PSO*7*115'"
^DIC(9.4,60,22,13,"PAH",107,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",107,1,3,0)="PSO*7*115 fixes a problem which may have caused some entries from the"
^DIC(9.4,60,22,13,"PAH",107,1,4,0)="PHARMACY PATIENT file (#55) to be deleted. This patch also provides a"
^DIC(9.4,60,22,13,"PAH",107,1,5,0)="post-install clean-up routine to rebuild any missing entries."
^DIC(9.4,60,22,13,"PAH",107,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",107,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",107,1,8,0)="Before this patch, an example of how this problem could happen is:"
^DIC(9.4,60,22,13,"PAH",107,1,9,0)="1) Place an order in CPRS for a brand new outpatient pharmacy patient (not"
^DIC(9.4,60,22,13,"PAH",107,1,10,0)="in the PHARMACY PATIENT file (#55))."
^DIC(9.4,60,22,13,"PAH",107,1,11,0)="2) Then place an order from CPRS for an outpatient pharmacy patient"
^DIC(9.4,60,22,13,"PAH",107,1,12,0)="already in the PHARMACY PATIENT file (#55), but is missing the PATIENT"
^DIC(9.4,60,22,13,"PAH",107,1,13,0)="STATUS field (#3) in that file."
^DIC(9.4,60,22,13,"PAH",107,1,14,0)="3) Then finish the orders in outpatient pharmacy for the patients in 1)"
^DIC(9.4,60,22,13,"PAH",107,1,15,0)="and 2) in that order, entering ""^"" for the Patient Status prompt for the"
^DIC(9.4,60,22,13,"PAH",107,1,16,0)="second patient. The entire entries for the second patient will be deleted"
^DIC(9.4,60,22,13,"PAH",107,1,17,0)="from the PHARMACY PATIENT file (#55), because a local variable from the "
^DIC(9.4,60,22,13,"PAH",107,1,18,0)="last new patient still existed."
^DIC(9.4,60,22,13,"PAH",107,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",107,1,20,0)="This patch ensures that the local variable is killed between each patient."
^DIC(9.4,60,22,13,"PAH",107,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",107,1,22,0)="Since the PHARMACY PATIENT file (#55) can contain both inpatient and"
^DIC(9.4,60,22,13,"PAH",107,1,23,0)="outpatient pharmacy information, the post-install routine will handle"
^DIC(9.4,60,22,13,"PAH",107,1,24,0)="rebuilding both types. It will send a MailMan message upon completion"
^DIC(9.4,60,22,13,"PAH",107,1,25,0)="indicating whether any missing entries were found and rebuilt for the"
^DIC(9.4,60,22,13,"PAH",107,1,26,0)="Inpatient Medications V. 5.0 orders or Outpatient Pharmacy V. 7.0"
^DIC(9.4,60,22,13,"PAH",107,1,27,0)="cross-references. The message will also show the global(s) that contain"
^DIC(9.4,60,22,13,"PAH",107,1,28,0)="the affected entries."
^DIC(9.4,60,22,13,"PAH",108,0)="129 SEQ #111^3021122^1"
^DIC(9.4,60,22,13,"PAH",108,1,0)="^^28^28^3021122"
^DIC(9.4,60,22,13,"PAH",108,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,2,0)="PSO*7*115 fixed a problem which may have caused some entries from the"
^DIC(9.4,60,22,13,"PAH",108,1,3,0)="PHARMACY PATIENT file (#55) to be deleted and a post-installation routine"
^DIC(9.4,60,22,13,"PAH",108,1,4,0)="in that patch reset the missing entries."
^DIC(9.4,60,22,13,"PAH",108,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,6,0)="Patch PSO*7*129 should not be installed until the post-install job of"
^DIC(9.4,60,22,13,"PAH",108,1,7,0)="patch PSO*7*115 has run to completion. When it is complete, a MailMan"
^DIC(9.4,60,22,13,"PAH",108,1,8,0)="message is sent to the installer of PSO*7*115 with a subject line of:"
^DIC(9.4,60,22,13,"PAH",108,1,9,0)="Subj: PHARMACY PATIENT File (#55) search for missing entries"
^DIC(9.4,60,22,13,"PAH",108,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,12,0)="Patch PSO*7*129 will create a MailMan message containing a list by patient"
^DIC(9.4,60,22,13,"PAH",108,1,13,0)="name of any cross references that were rebuilt by PSO*7*115. The subject"
^DIC(9.4,60,22,13,"PAH",108,1,14,0)="of the MailMan message will be one of the following:"
^DIC(9.4,60,22,13,"PAH",108,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,16,0)="Subj: PHARMACY PATIENT File (#55)  NO ENTRIES TO LIST"
^DIC(9.4,60,22,13,"PAH",108,1,17,0)="Subj: PHARMACY PATIENT File (#55)  LIST IN USE"
^DIC(9.4,60,22,13,"PAH",108,1,18,0)="Subj: PHARMACY PATIENT File (#55) listing of rebuilt entries"
^DIC(9.4,60,22,13,"PAH",108,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,20,0)="A MailMan message with the first subject would occur if there was nothing"
^DIC(9.4,60,22,13,"PAH",108,1,21,0)="in the temporary global created by patch PSO*7*115. That temporary global"
^DIC(9.4,60,22,13,"PAH",108,1,22,0)="is kept for 30 days. The second subject would occur if the post-install"
^DIC(9.4,60,22,13,"PAH",108,1,23,0)="job for patch PSO*7*115 is currently running. In this case, the"
^DIC(9.4,60,22,13,"PAH",108,1,24,0)="post-install job for patch PSO*7*129 can be queued later by running"
^DIC(9.4,60,22,13,"PAH",108,1,25,0)="^PSOPOST8 from programmers mode."
^DIC(9.4,60,22,13,"PAH",108,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",108,1,27,0)="The MailMan message is sent to the installer of the patch and holders of"
^DIC(9.4,60,22,13,"PAH",108,1,28,0)="the PSNMGR key."
^DIC(9.4,60,22,13,"PAH",109,0)="127 SEQ #113^3021220^1"
^DIC(9.4,60,22,13,"PAH",109,1,0)="^^42^42^3021220"
^DIC(9.4,60,22,13,"PAH",109,1,1,0)="The Deputy Undersecretary for Health for Operations and Management (10N) "
^DIC(9.4,60,22,13,"PAH",109,1,2,0)="convened a task force in April 2002 to review the controlled substance "
^DIC(9.4,60,22,13,"PAH",109,1,3,0)="process in VHA. The task force returned several recommendations. One of "
^DIC(9.4,60,22,13,"PAH",109,1,4,0)="the recommendations was to modify the Outpatient Pharmacy package to "
^DIC(9.4,60,22,13,"PAH",109,1,5,0)="provide a record of all address changes."
^DIC(9.4,60,22,13,"PAH",109,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",109,1,7,0)="Medical Center Pharmacy Managers are encouraged to contact their IRM and "
^DIC(9.4,60,22,13,"PAH",109,1,8,0)="arrange the regular auditing of changes to address and temporary address "
^DIC(9.4,60,22,13,"PAH",109,1,9,0)="fields in the Patient file (#2). Pharmacy Managers should monitor these"
^DIC(9.4,60,22,13,"PAH",109,1,10,0)="audits to discover and correct any patterns of inappropriate address"
^DIC(9.4,60,22,13,"PAH",109,1,11,0)="changes. An option created with this patch will facilitate the review of"
^DIC(9.4,60,22,13,"PAH",109,1,12,0)="the audits."
^DIC(9.4,60,22,13,"PAH",109,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",109,1,14,0)="Audits consume disk space on the VistA system so audit results cannot be "
^DIC(9.4,60,22,13,"PAH",109,1,15,0)="stored indefinitely. Pharmacy Managers should negotiate a timeframe for "
^DIC(9.4,60,22,13,"PAH",109,1,16,0)="the regular review of the audits so that the audits can be purged from "
^DIC(9.4,60,22,13,"PAH",109,1,17,0)="the system when no longer needed. The suggested fields for auditing are:"
^DIC(9.4,60,22,13,"PAH",109,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",109,1,19,0)="STREET ADDRESS [LINE 1]    (#.111)"
^DIC(9.4,60,22,13,"PAH",109,1,20,0)="STREET ADDRESS [LINE 2]    (#.112)"
^DIC(9.4,60,22,13,"PAH",109,1,21,0)="STREET ADDRESS [LINE 3]    (#.113)"
^DIC(9.4,60,22,13,"PAH",109,1,22,0)="CITY                       (#.114)"
^DIC(9.4,60,22,13,"PAH",109,1,23,0)="STATE                      (#.115)"
^DIC(9.4,60,22,13,"PAH",109,1,24,0)="ZIP CODE                   (#.116)"
^DIC(9.4,60,22,13,"PAH",109,1,25,0)="ZIP+4                      (#.1112)"
^DIC(9.4,60,22,13,"PAH",109,1,26,0)="TEMPORARY STREET [LINE 1]  (#.1211)"
^DIC(9.4,60,22,13,"PAH",109,1,27,0)="TEMPORARY STREET [LINE 2]  (#.1212)"
^DIC(9.4,60,22,13,"PAH",109,1,28,0)="TEMPORARY STREET [LINE 3]  (#.1213)"
^DIC(9.4,60,22,13,"PAH",109,1,29,0)="TEMPORARY CITY             (#.1214)"
^DIC(9.4,60,22,13,"PAH",109,1,30,0)="TEMPORARY STATE            (#.1215)"
^DIC(9.4,60,22,13,"PAH",109,1,31,0)="TEMPORARY ZIP CODE         (#.1216)"
^DIC(9.4,60,22,13,"PAH",109,1,32,0)="TEMPORARY ZIP+4            (#.12112)"
^DIC(9.4,60,22,13,"PAH",109,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",109,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",109,1,35,0)="The new option exported with this patch is named Patient Address Changes"
^DIC(9.4,60,22,13,"PAH",109,1,36,0)="Report [PSO ADDRESS CHANGE REPORT], and will be placed under the"
^DIC(9.4,60,22,13,"PAH",109,1,37,0)="Supervisor Functions [PSO SUPERVISOR] menu option. This option prints a"
^DIC(9.4,60,22,13,"PAH",109,1,38,0)="report that shows changes made to the various address fields listed above"
^DIC(9.4,60,22,13,"PAH",109,1,39,0)="from the PATIENT file (#2), over the date range specified. The report can"
^DIC(9.4,60,22,13,"PAH",109,1,40,0)="be run for one patient, or for all patients. A field can only be tracked"
^DIC(9.4,60,22,13,"PAH",109,1,41,0)="and shown on this report if the VA FileMan AUDIT function was turned on"
^DIC(9.4,60,22,13,"PAH",109,1,42,0)="for the field at the time the field was edited."
^DIC(9.4,60,22,13,"PAH",110,0)="122 SEQ #114^3021220^1"
^DIC(9.4,60,22,13,"PAH",110,1,0)="^^4^4^3021220"
^DIC(9.4,60,22,13,"PAH",110,1,1,0)="The Edit Data for a Patient in the Clozapine Program [PSOL EDIT] option "
^DIC(9.4,60,22,13,"PAH",110,1,2,0)="and the Register Clozapine Patient [PSOL REGISTER PATIENT] option will no     "
^DIC(9.4,60,22,13,"PAH",110,1,3,0)="longer check for race, sex, or zip code for Outpatient Pharmacy in the"
^DIC(9.4,60,22,13,"PAH",110,1,4,0)="Clozapine Program.  All three checks are no longer necessary."
^DIC(9.4,60,22,13,"PAH",111,0)="124 SEQ #115^3030115^1"
^DIC(9.4,60,22,13,"PAH",111,1,0)="^^30^30^3030115"
^DIC(9.4,60,22,13,"PAH",111,1,1,0)="Description:"
^DIC(9.4,60,22,13,"PAH",111,1,2,0)="==========="
^DIC(9.4,60,22,13,"PAH",111,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",111,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",111,1,5,0)="1. Currently, if a non-controlled substance prescription is entered with"
^DIC(9.4,60,22,13,"PAH",111,1,6,0)="   a day supply less than 5 days and there are no refills, the expiration"
^DIC(9.4,60,22,13,"PAH",111,1,7,0)="   date defaults to 5 days from the issue date.  If a controlled substance"
^DIC(9.4,60,22,13,"PAH",111,1,8,0)="   prescription is entered with a day supply less than 5 days without"
^DIC(9.4,60,22,13,"PAH",111,1,9,0)="   refills, the expiration date is the Issue Date plus the Days Supply."
^DIC(9.4,60,22,13,"PAH",111,1,10,0)="   The primary problem is that when these prescriptions were being"
^DIC(9.4,60,22,13,"PAH",111,1,11,0)="   transmitted to the CMOPs and they were behind on dispensing, the"
^DIC(9.4,60,22,13,"PAH",111,1,12,0)="   prescriptions were being rejected because the prescriptions had"
^DIC(9.4,60,22,13,"PAH",111,1,13,0)="   already expired. The default of 5 is being changed to 30 to"
^DIC(9.4,60,22,13,"PAH",111,1,14,0)="   accommodate the CMOPs and to allow the patients to receive their"
^DIC(9.4,60,22,13,"PAH",111,1,15,0)="   medications in a timely manner. Prescriptions will no longer expire"
^DIC(9.4,60,22,13,"PAH",111,1,16,0)="   before 30 days elapses from the Issue Date when the day supply is"
^DIC(9.4,60,22,13,"PAH",111,1,17,0)="   less than 30 days and there are no refills.  If a minimum of 1 refill"
^DIC(9.4,60,22,13,"PAH",111,1,18,0)="   is entered the one year/six month rule still applies."
^DIC(9.4,60,22,13,"PAH",111,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",111,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",111,1,21,0)="2. This patch also includes a correction to initialize the line "
^DIC(9.4,60,22,13,"PAH",111,1,22,0)="counter for the ""SIG1"" entries in the PRESCRIPTION file (#52). Before "
^DIC(9.4,60,22,13,"PAH",111,1,23,0)="this fix, the count could be incorrect sometimes which could cause"
^DIC(9.4,60,22,13,"PAH",111,1,24,0)="problems for external interfaces."
^DIC(9.4,60,22,13,"PAH",111,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",111,1,26,0)="3. This patch corrects a problem that caused a null subscript error.  "
^DIC(9.4,60,22,13,"PAH",111,1,27,0)="This would happen if records were being created in the PENDING OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",111,1,28,0)="ORDERS file (#52.41) and an attempt was made to pull up the patient's"
^DIC(9.4,60,22,13,"PAH",111,1,29,0)="medications in the Computerized Patient Record System (CPRS) at the same"
^DIC(9.4,60,22,13,"PAH",111,1,30,0)="moment."
^DIC(9.4,60,22,13,"PAH",112,0)="121 SEQ #116^3030123^1"
^DIC(9.4,60,22,13,"PAH",112,1,0)="^^29^29^3030123"
^DIC(9.4,60,22,13,"PAH",112,1,1,0)="1) When an order entered through Computerized Patient Record System "
^DIC(9.4,60,22,13,"PAH",112,1,2,0)="(CPRS) V. 3.0 is finished in Outpatient Pharmacy V. 7.0, fields can be"
^DIC(9.4,60,22,13,"PAH",112,1,3,0)="edited during that finish process. One of those fields is the PATIENT"
^DIC(9.4,60,22,13,"PAH",112,1,4,0)="STATUS field (#3) of the PRESCRIPTION file (#52). When this field is"
^DIC(9.4,60,22,13,"PAH",112,1,5,0)="edited during the finish process, not only does that field get updated for"
^DIC(9.4,60,22,13,"PAH",112,1,6,0)="that prescription, but the PATIENT STATUS field (#3) of the PHARMACY"
^DIC(9.4,60,22,13,"PAH",112,1,7,0)="PATIENT file (#55) also gets updated. Then when the next prescription is"
^DIC(9.4,60,22,13,"PAH",112,1,8,0)="entered for that patient, the PATIENT STATUS field (#3) of the PHARMACY"
^DIC(9.4,60,22,13,"PAH",112,1,9,0)="PATIENT file (#55) is used as the default Patient Status, and that"
^DIC(9.4,60,22,13,"PAH",112,1,10,0)="includes default and maximum values for various fields during the order"
^DIC(9.4,60,22,13,"PAH",112,1,11,0)="entry process, whether the order is being entered through CPRS V. 3.0 or "
^DIC(9.4,60,22,13,"PAH",112,1,12,0)="Outpatient Pharmacy V. 7.0. A request has been made to not update the"
^DIC(9.4,60,22,13,"PAH",112,1,13,0)="PATIENT STATUS field (#3) of the PHARMACY PATIENT file (#55) when the"
^DIC(9.4,60,22,13,"PAH",112,1,14,0)="Patient Status is edited during the finish process if ADMINISTERED IN"
^DIC(9.4,60,22,13,"PAH",112,1,15,0)="CLINIC was entered as the Pick Up for the order in CPRS V. 3.0."
^DIC(9.4,60,22,13,"PAH",112,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",112,1,17,0)="2) Outpatient Pharmacy V. 7.0 patch PSO*7*111 introduced new functionality"
^DIC(9.4,60,22,13,"PAH",112,1,18,0)="that enables the Outpatient Pharmacy V. 7.0 package to receive New and"
^DIC(9.4,60,22,13,"PAH",112,1,19,0)="Discontinue Pharmacy orders from an external system. When these orders are"
^DIC(9.4,60,22,13,"PAH",112,1,20,0)="received, an immediate update is then sent from Outpatient Pharmacy V. 7.0"
^DIC(9.4,60,22,13,"PAH",112,1,21,0)="to CPRS V. 3.0. A problem has been reported on the Discontinue orders,"
^DIC(9.4,60,22,13,"PAH",112,1,22,0)="when the update is sent from Outpatient Pharmacy V. 7.0 to CPRS V. 3.0. In"
^DIC(9.4,60,22,13,"PAH",112,1,23,0)="some cases, CPRS V. 3.0 will enter the current user into the DC'ed BY"
^DIC(9.4,60,22,13,"PAH",112,1,24,0)="field (#62) in the ORDER file (#100). Since the only defined user on the"
^DIC(9.4,60,22,13,"PAH",112,1,25,0)="system for this process could be the person who started the HL7 filers,"
^DIC(9.4,60,22,13,"PAH",112,1,26,0)="this patch makes the change to send the requesting provider as the current"
^DIC(9.4,60,22,13,"PAH",112,1,27,0)="user when the discontinue messages are sent to CPRS V. 3.0. This fix will"
^DIC(9.4,60,22,13,"PAH",112,1,28,0)="only affect orders received from an external system using the interface"
^DIC(9.4,60,22,13,"PAH",112,1,29,0)="introduced in patch PSO*7*111."
^DIC(9.4,60,22,13,"PAH",113,0)="110 SEQ #117^3030204^1"
^DIC(9.4,60,22,13,"PAH",113,1,0)="^^12^12^3030204"
^DIC(9.4,60,22,13,"PAH",113,1,1,0)="After installing patch PSO*7*107, some sites have reported problems in"
^DIC(9.4,60,22,13,"PAH",113,1,2,0)="printing labels, notably when there are bar codes in the label. In patch"
^DIC(9.4,60,22,13,"PAH",113,1,3,0)="PSO*7*107, we replaced the carriage return control code *13 with $C(13) to"
^DIC(9.4,60,22,13,"PAH",113,1,4,0)="make it vendor independent. The problem is that the $C(13) under DSM/VMS"
^DIC(9.4,60,22,13,"PAH",113,1,5,0)="does not initialize the column position to zero. This patch fixes this"
^DIC(9.4,60,22,13,"PAH",113,1,6,0)="problem."
^DIC(9.4,60,22,13,"PAH",113,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",113,1,8,0)="Please note: This patch and the associated patch PSO*7*107 are not "
^DIC(9.4,60,22,13,"PAH",113,1,9,0)="compatible with class 3 software for automated dispensing machines such as"
^DIC(9.4,60,22,13,"PAH",113,1,10,0)="Baker 2000, etc. If your site is using any class 3 software, please get"
^DIC(9.4,60,22,13,"PAH",113,1,11,0)="the corrections for these dispensing machines before installing this"
^DIC(9.4,60,22,13,"PAH",113,1,12,0)="patch."
^DIC(9.4,60,22,13,"PAH",114,0)="116 SEQ #118^3030301^1"
^DIC(9.4,60,22,13,"PAH",114,1,0)="^^8^8^3030301"
^DIC(9.4,60,22,13,"PAH",114,1,1,0)="The purpose of this patch is to support the implementation of Internet "
^DIC(9.4,60,22,13,"PAH",114,1,2,0)="Prescription Refill for Outpatient Pharmacy V. 7.0. This request has links"
^DIC(9.4,60,22,13,"PAH",114,1,3,0)="to the Health eVet project that will provide a mechanism to obtain copies"
^DIC(9.4,60,22,13,"PAH",114,1,4,0)="of key portions of their medical record, personalize that record with"
^DIC(9.4,60,22,13,"PAH",114,1,5,0)="relevant educational information and provide links to electronic service"
^DIC(9.4,60,22,13,"PAH",114,1,6,0)="delivery capabilities, such as prescription refills. The veteran will be"
^DIC(9.4,60,22,13,"PAH",114,1,7,0)="able to request a prescription refill and review his prescription profile"
^DIC(9.4,60,22,13,"PAH",114,1,8,0)="by using a web based interface on the internet."
^DIC(9.4,60,22,13,"PAH",115,0)="112 SEQ #119^3030329^1"
^DIC(9.4,60,22,13,"PAH",115,1,0)="^^29^29^3030329"
^DIC(9.4,60,22,13,"PAH",115,1,1,0)="When performing drug lookups, two issues were identified. First, the user"
^DIC(9.4,60,22,13,"PAH",115,1,2,0)="was not aware of which item was being matched. For example, was the match"
^DIC(9.4,60,22,13,"PAH",115,1,3,0)="for the GENERIC NAME of the drug or was it the SYNONYM. The second issue"
^DIC(9.4,60,22,13,"PAH",115,1,4,0)="had to do with the search matching to the NATIONAL DRUG CLASS NAME first,"
^DIC(9.4,60,22,13,"PAH",115,1,5,0)="before checking for a GENERIC NAME. This patch makes two changes to the"
^DIC(9.4,60,22,13,"PAH",115,1,6,0)="drug lookup. First, the search will display the item being searched on."
^DIC(9.4,60,22,13,"PAH",115,1,7,0)="Second, if one or more matches are found on an item, but the user doesn't"
^DIC(9.4,60,22,13,"PAH",115,1,8,0)="select one of the matches displayed, the search will continue through all"
^DIC(9.4,60,22,13,"PAH",115,1,9,0)="other items. A sample screen display follows:"
^DIC(9.4,60,22,13,"PAH",115,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",115,1,11,0)=" Select DRUG: hep"
^DIC(9.4,60,22,13,"PAH",115,1,12,0)="       Lookup: VA DRUG CLASS  CLASSIFICATION"
^DIC(9.4,60,22,13,"PAH",115,1,13,0)=" HEPARIN ANTAGONISTS  BL200"
^DIC(9.4,60,22,13,"PAH",115,1,14,0)="    HEPARIN ANTAGONISTS"
^DIC(9.4,60,22,13,"PAH",115,1,15,0)="     Lookup: DRUG  NATIONAL DRUG CLASS"
^DIC(9.4,60,22,13,"PAH",115,1,16,0)="   PROTAMINE SULFATE 5ML INJ         BL200"
^DIC(9.4,60,22,13,"PAH",115,1,17,0)="          ...OK? Yes// N  (No)"
^DIC(9.4,60,22,13,"PAH",115,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",115,1,19,0)="     Lookup: DRUG  GENERIC NAME"
^DIC(9.4,60,22,13,"PAH",115,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",115,1,21,0)="      1   HEPARIN 1,000 UNIT/ML 10ML INJ           BL100"
^DIC(9.4,60,22,13,"PAH",115,1,22,0)="      2   HEPARIN 1,000 UNITS/ML 30ML            BL100"
^DIC(9.4,60,22,13,"PAH",115,1,23,0)="      3   HEPARIN 10,000 UNITS 4ML           BL100"
^DIC(9.4,60,22,13,"PAH",115,1,24,0)="      4   HEPARIN BEEF 1,000 UNITS/ML 30ML           BL100"
^DIC(9.4,60,22,13,"PAH",115,1,25,0)="      5   HEPARIN, LOCK  100 UNIT/ML 1ML           BL100"
^DIC(9.4,60,22,13,"PAH",115,1,26,0)=" Press <RETURN> to see more, '^' to exit this list, OR"
^DIC(9.4,60,22,13,"PAH",115,1,27,0)=" CHOOSE 1-5:"
^DIC(9.4,60,22,13,"PAH",115,1,28,0)="      6   HEPATITIS-B IMMUNE GLOBULIN           IM500"
^DIC(9.4,60,22,13,"PAH",115,1,29,0)=" CHOOSE 1-6:"
^DIC(9.4,60,22,13,"PAH",116,0)="134 SEQ #120^3030329^1"
^DIC(9.4,60,22,13,"PAH",116,1,0)="^^6^6^3030329"
^DIC(9.4,60,22,13,"PAH",116,1,1,0)="1. When Pharmacy orders are entered through Computerized Patient Record "
^DIC(9.4,60,22,13,"PAH",116,1,2,0)="System (CPRS), certain order checks are performed by Pharmacy during "
^DIC(9.4,60,22,13,"PAH",116,1,3,0)="this process. One of the order checks is the duplicate drug class order"
^DIC(9.4,60,22,13,"PAH",116,1,4,0)="check. The software is currently looking for an exact match of the 5"
^DIC(9.4,60,22,13,"PAH",116,1,5,0)="characters that make up the drug class. It should only look for a match of"
^DIC(9.4,60,22,13,"PAH",116,1,6,0)="the first 4 characters. This patch corrects the problem."
^DIC(9.4,60,22,13,"PAH",117,0)="130 SEQ #121^3030329^1"
^DIC(9.4,60,22,13,"PAH",117,1,0)="^^26^26^3030329"
^DIC(9.4,60,22,13,"PAH",117,1,1,0)="1. When actions are not allowed to be taken on a specific order in"
^DIC(9.4,60,22,13,"PAH",117,1,2,0)="   Outpatient Pharmacy because that order is being acted upon by another"
^DIC(9.4,60,22,13,"PAH",117,1,3,0)="   user, a message is sometimes displayed that does not say who the other"
^DIC(9.4,60,22,13,"PAH",117,1,4,0)="   user is that has that order locked. This patch will change the message,"
^DIC(9.4,60,22,13,"PAH",117,1,5,0)="   wherever possible, to display the name of the user that has that order"
^DIC(9.4,60,22,13,"PAH",117,1,6,0)="   locked. All of the places where this message is displayed within the"
^DIC(9.4,60,22,13,"PAH",117,1,7,0)="   Outpatient Pharmacy package could not be fixed with this patch, because"
^DIC(9.4,60,22,13,"PAH",117,1,8,0)="   some of the routines were already in other patches. The changes will be"
^DIC(9.4,60,22,13,"PAH",117,1,9,0)="   made in those other places by those other patches."
^DIC(9.4,60,22,13,"PAH",117,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",117,1,11,0)="2. When completing renewal orders entered through Computerized Patient"
^DIC(9.4,60,22,13,"PAH",117,1,12,0)="   Record System (CPRS), there is a possibility of getting an undefined"
^DIC(9.4,60,22,13,"PAH",117,1,13,0)="   variable PSOX(""STATUS"") error. This error occurs if the prescription "
^DIC(9.4,60,22,13,"PAH",117,1,14,0)="   was originally entered through Outpatient Pharmacy, and the DEA,"
^DIC(9.4,60,22,13,"PAH",117,1,15,0)="   SPECIAL HDLG field (#3) of the DRUG file (#50) of the drug made it"
^DIC(9.4,60,22,13,"PAH",117,1,16,0)="   renewable, but not refillable. Then if that order is renewed through"
^DIC(9.4,60,22,13,"PAH",117,1,17,0)="   CPRS, the error can occur when Pharmacy finishes that order. This patch"
^DIC(9.4,60,22,13,"PAH",117,1,18,0)="   fixes this problem."
^DIC(9.4,60,22,13,"PAH",117,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",117,1,20,0)="3. Duplicate active prescriptions are being found in Outpatient Pharmacy,"
^DIC(9.4,60,22,13,"PAH",117,1,21,0)="   due to an order being renewed through CPRS at the same time a fill for"
^DIC(9.4,60,22,13,"PAH",117,1,22,0)="   that prescription is being transmitted to Consolidated Mail Outpatient"
^DIC(9.4,60,22,13,"PAH",117,1,23,0)="   Pharmacy (CMOP). A check is being added with this patch to not allow"
^DIC(9.4,60,22,13,"PAH",117,1,24,0)="   the renewal of an Outpatient order through CPRS if that order has a"
^DIC(9.4,60,22,13,"PAH",117,1,25,0)="   fill being loaded for transmission to the CMOP. The message that will"
^DIC(9.4,60,22,13,"PAH",117,1,26,0)="   show to the provider will be ""Rx is loading into a CMOP transmission""."
^DIC(9.4,60,22,13,"PAH",118,0)="137 SEQ #122^3030417^1"
^DIC(9.4,60,22,13,"PAH",118,1,0)="^^58^58^3030417"
^DIC(9.4,60,22,13,"PAH",118,1,1,0)="1. One site has reported an excessive number of prescriptions getting"
^DIC(9.4,60,22,13,"PAH",118,1,2,0)="automatically (incorrectly) changed at release from Copay to No Copay"
^DIC(9.4,60,22,13,"PAH",118,1,3,0)="with a reason of ""Service Connected"". It was determined that this is"
^DIC(9.4,60,22,13,"PAH",118,1,4,0)="happening because the Service Connected question does not apply for the"
^DIC(9.4,60,22,13,"PAH",118,1,5,0)="patient anymore, but the Computerized Patient Record System V. 1.0(CPRS)"
^DIC(9.4,60,22,13,"PAH",118,1,6,0)="passes the Service Connected question's answer from the renewed from or"
^DIC(9.4,60,22,13,"PAH",118,1,7,0)="copied from prescription to Outpatient Pharmacy V. 7.0."
^DIC(9.4,60,22,13,"PAH",118,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,9,0)="Solution:"
^DIC(9.4,60,22,13,"PAH",118,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,11,0)="This patch corrects the problem but will not do any back-billing."
^DIC(9.4,60,22,13,"PAH",118,1,12,0)="Information gathered from the results of this patch will be used by the"
^DIC(9.4,60,22,13,"PAH",118,1,13,0)="VHA Central Office to determine whether back-billing will be done for"
^DIC(9.4,60,22,13,"PAH",118,1,14,0)="these fills. A subsequent patch may be released to perform this"
^DIC(9.4,60,22,13,"PAH",118,1,15,0)="back-billing."
^DIC(9.4,60,22,13,"PAH",118,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,17,0)="  a. At release of a fill, if the Service Connected flag has a ""Yes"""
^DIC(9.4,60,22,13,"PAH",118,1,18,0)="answer, a call will be made to Integrated Billing to see if the Service"
^DIC(9.4,60,22,13,"PAH",118,1,19,0)="Connected question even applies for this patient anymore. If not, the"
^DIC(9.4,60,22,13,"PAH",118,1,20,0)="answer will be set to null in Outpatient Pharmacy and an update"
^DIC(9.4,60,22,13,"PAH",118,1,21,0)="transaction will be sent to CPRS to change their copy of the answer to"
^DIC(9.4,60,22,13,"PAH",118,1,22,0)="null."
^DIC(9.4,60,22,13,"PAH",118,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,24,0)="  b. A post-install job will loop through all released prescriptions"
^DIC(9.4,60,22,13,"PAH",118,1,25,0)="starting from 02/04/2002 (the date that the $7 copay amount went into"
^DIC(9.4,60,22,13,"PAH",118,1,26,0)="effect) and will tally the number of fills that could have been billed."
^DIC(9.4,60,22,13,"PAH",118,1,27,0)="The results of this patch will be maintained in a temporary location for"
^DIC(9.4,60,22,13,"PAH",118,1,28,0)="a limited time in order to speed the processing of any eventual"
^DIC(9.4,60,22,13,"PAH",118,1,29,0)="back-billing."
^DIC(9.4,60,22,13,"PAH",118,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,32,0)="A MailMan message with a subject of ""Subj: Patch PSO*7*137 Copay tally"""
^DIC(9.4,60,22,13,"PAH",118,1,33,0)="will be sent to the patch installer and holders of the PSO COPAY key"
^DIC(9.4,60,22,13,"PAH",118,1,34,0)="indicating the number of fills that have a potential for being"
^DIC(9.4,60,22,13,"PAH",118,1,35,0)="back-billed."
^DIC(9.4,60,22,13,"PAH",118,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,37,0)="A second MailMan message will be sent to developers of the patch on FORUM"
^DIC(9.4,60,22,13,"PAH",118,1,38,0)="with a subject of ""Subj: 'institution' - COUNTS. This message will"
^DIC(9.4,60,22,13,"PAH",118,1,39,0)="contain formatted tallies of fills eligible to be back-billed for 2002"
^DIC(9.4,60,22,13,"PAH",118,1,40,0)="and 2003."
^DIC(9.4,60,22,13,"PAH",118,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,42,0)="The MailMan messages will not contain any patient information."
^DIC(9.4,60,22,13,"PAH",118,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,44,0)="2. A problem was encountered when a patient who had previously reached"
^DIC(9.4,60,22,13,"PAH",118,1,45,0)="his annual copay cap had activity that brought his copay amount below the"
^DIC(9.4,60,22,13,"PAH",118,1,46,0)="annual cap. When that happens, Integrated Billing (IB) will look for any"
^DIC(9.4,60,22,13,"PAH",118,1,47,0)="previous fills that weren't billed because of the cap and will attempt to"
^DIC(9.4,60,22,13,"PAH",118,1,48,0)="bill for those. The problem occurred when the previous unbilled fill had"
^DIC(9.4,60,22,13,"PAH",118,1,49,0)="been returned to stock, Outpatient Pharmacy had an error in the process"
^DIC(9.4,60,22,13,"PAH",118,1,50,0)="that should have sent a cancel for those ""potential bills"" (fills that"
^DIC(9.4,60,22,13,"PAH",118,1,51,0)="would have been billed if the patient had not already reached his annual"
^DIC(9.4,60,22,13,"PAH",118,1,52,0)="copay cap), so IB attempted to initiate a charge for those. On returned to"
^DIC(9.4,60,22,13,"PAH",118,1,53,0)="stock refills, the refill level is removed from the prescription file, so"
^DIC(9.4,60,22,13,"PAH",118,1,54,0)="filing the IB-initiated charge caused undefined errors."
^DIC(9.4,60,22,13,"PAH",118,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",118,1,56,0)="Solution:"
^DIC(9.4,60,22,13,"PAH",118,1,57,0)="The canceling portion of the return to stock processing was corrected to"
^DIC(9.4,60,22,13,"PAH",118,1,58,0)="handle ""potential charges""."
^DIC(9.4,60,22,13,"PAH",119,0)="120 SEQ #123^3030501^1"
^DIC(9.4,60,22,13,"PAH",119,1,0)="^^6^6^3030501"
^DIC(9.4,60,22,13,"PAH",119,1,1,0)="The purpose of this patch is to provide the ability to print Outpatient "
^DIC(9.4,60,22,13,"PAH",119,1,2,0)="Pharmacy V. 7.0 prescription labels on laser printers. The output will "
^DIC(9.4,60,22,13,"PAH",119,1,3,0)="include the Patient Medication Information sheets."
^DIC(9.4,60,22,13,"PAH",119,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",119,1,5,0)="The new functionality will only be available on printers properly defined "
^DIC(9.4,60,22,13,"PAH",119,1,6,0)="in the TERMINAL TYPE file (#3.2)."
^DIC(9.4,60,22,13,"PAH",120,0)="123 SEQ #124^3030603^1"
^DIC(9.4,60,22,13,"PAH",120,1,0)="^^32^32^3030603"
^DIC(9.4,60,22,13,"PAH",120,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",120,1,2,0)="One site reported an excessive number of prescriptions getting"
^DIC(9.4,60,22,13,"PAH",120,1,3,0)="automatically (incorrectly) changed at release from Copay to No Copay"
^DIC(9.4,60,22,13,"PAH",120,1,4,0)="with a reason of ""Service Connected"". It was determined that this was"
^DIC(9.4,60,22,13,"PAH",120,1,5,0)="happening because the Service Connected question does not apply for the"
^DIC(9.4,60,22,13,"PAH",120,1,6,0)="patient anymore, but the Computerized Patient Record System (CPRS) V. 3.0"
^DIC(9.4,60,22,13,"PAH",120,1,7,0)="sends the Service Connected question's answer from the renewed from or"
^DIC(9.4,60,22,13,"PAH",120,1,8,0)="copied from prescription. For non-service connected veterans, prescription"
^DIC(9.4,60,22,13,"PAH",120,1,9,0)="fills that were flagged as Service Connected were not charged a copay when"
^DIC(9.4,60,22,13,"PAH",120,1,10,0)="they should have been."
^DIC(9.4,60,22,13,"PAH",120,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",120,1,12,0)="Solution:"
^DIC(9.4,60,22,13,"PAH",120,1,13,0)="The post-install job for patch PSO*7*137 identified potential prescription"
^DIC(9.4,60,22,13,"PAH",120,1,14,0)="fills that should have charged a copay. The starting date for examining"
^DIC(9.4,60,22,13,"PAH",120,1,15,0)="whether the released fills should have been charged a copay was"
^DIC(9.4,60,22,13,"PAH",120,1,16,0)="02/04/2002 (the date that the $7 copay amount went into effect). A"
^DIC(9.4,60,22,13,"PAH",120,1,17,0)="post-install job for this patch will use the global created by patch"
^DIC(9.4,60,22,13,"PAH",120,1,18,0)="PSO*7*137 to do the back-billing for the identified fills. If the global"
^DIC(9.4,60,22,13,"PAH",120,1,19,0)="has been removed from the system, the identification portion will be done"
^DIC(9.4,60,22,13,"PAH",120,1,20,0)="again by the post-install of this patch before doing the back-billing."
^DIC(9.4,60,22,13,"PAH",120,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",120,1,22,0)="A MailMan message with a subject of ""Subj: Outpatient Pharmacy Copay"
^DIC(9.4,60,22,13,"PAH",120,1,23,0)="Clean-up"" will be sent to the patch installer and holders of the PSO COPAY"
^DIC(9.4,60,22,13,"PAH",120,1,24,0)="key indicating the number of fills that were successfully billed. If any"
^DIC(9.4,60,22,13,"PAH",120,1,25,0)="fills were billed, the MailMan message will contain information on how to"
^DIC(9.4,60,22,13,"PAH",120,1,26,0)="print a report by patient name of prescription fills that were billed."
^DIC(9.4,60,22,13,"PAH",120,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",120,1,28,0)="A second MailMan message will be sent back to FORUM to some outpatient"
^DIC(9.4,60,22,13,"PAH",120,1,29,0)="pharmacy developers. This MailMan message's information will be compiled"
^DIC(9.4,60,22,13,"PAH",120,1,30,0)="with messages from other sites and forwarded to the Austin Automation"
^DIC(9.4,60,22,13,"PAH",120,1,31,0)="Center for their use in addressing a mail-out to the veterans affected by"
^DIC(9.4,60,22,13,"PAH",120,1,32,0)="the back-billing."
^DIC(9.4,60,22,13,"PAH",121,0)="119 SEQ #125^3030628^1"
^DIC(9.4,60,22,13,"PAH",121,1,0)="^^56^56^3030628"
^DIC(9.4,60,22,13,"PAH",121,1,1,0)="1. This patch contains a post-install job, which will correct a status"
^DIC(9.4,60,22,13,"PAH",121,1,2,0)="   mismatch between Outpatient Pharmacy V. 7.0 orders which have been"
^DIC(9.4,60,22,13,"PAH",121,1,3,0)="   deleted and the corresponding orders in the Computerized Patient Record"
^DIC(9.4,60,22,13,"PAH",121,1,4,0)="   System (CPRS) V. 1.0. The initial problem could have occurred if the"
^DIC(9.4,60,22,13,"PAH",121,1,5,0)="   Outpatient Pharmacy V. 7.0 package mistakenly sent an ""active"" message"
^DIC(9.4,60,22,13,"PAH",121,1,6,0)="   to CPRS V. 1.0 on an old order, making it active in CPRS V. 1.0 when it"
^DIC(9.4,60,22,13,"PAH",121,1,7,0)="   should be Discontinued, Expired, or Canceled. Patch PSO*7*86 updated"
^DIC(9.4,60,22,13,"PAH",121,1,8,0)="   the status in CPRS V. 1.0 for orders that were Canceled or"
^DIC(9.4,60,22,13,"PAH",121,1,9,0)="   Discontinued."
^DIC(9.4,60,22,13,"PAH",121,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,11,0)="   For deleted Outpatient Pharmacy V. 7.0 orders, the post-install "
^DIC(9.4,60,22,13,"PAH",121,1,12,0)="   job will change CPRS V. 1.0 orders with an active status to a status of"
^DIC(9.4,60,22,13,"PAH",121,1,13,0)="   deleted and will also change the stop date in CPRS V. 1.0 to the date"
^DIC(9.4,60,22,13,"PAH",121,1,14,0)="   deleted if the CPRS V. 1.0 status is Discontinued by Provider."
^DIC(9.4,60,22,13,"PAH",121,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,16,0)="2. This patch also corrects the problem of an extra delimiter being"
^DIC(9.4,60,22,13,"PAH",121,1,17,0)="   stored in the PRESCRIPTION file (#52) if an up-arrow (^) was entered"
^DIC(9.4,60,22,13,"PAH",121,1,18,0)="   for the LOT# field (#24) when editing a prescription. A symptom of this"
^DIC(9.4,60,22,13,"PAH",121,1,19,0)="   problem is a null subscript error when trying to access the DIVISION"
^DIC(9.4,60,22,13,"PAH",121,1,20,0)="   field (#20) of the PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",121,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,22,0)="   The post-install job will look for any entries with a null division and"
^DIC(9.4,60,22,13,"PAH",121,1,23,0)="   if the positions of the date fields appear to be shifted, it will"
^DIC(9.4,60,22,13,"PAH",121,1,24,0)="   remove the extra delimiter from the PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",121,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,26,0)="    "
^DIC(9.4,60,22,13,"PAH",121,1,27,0)="   Upon completion of the post-install job a MailMan message will be sent"
^DIC(9.4,60,22,13,"PAH",121,1,28,0)="   to the patch installer with a subject of ""Subj: Outpatient/CPRS Status"
^DIC(9.4,60,22,13,"PAH",121,1,29,0)="   clean-up"". The message will indicate how many mismatched statuses were"
^DIC(9.4,60,22,13,"PAH",121,1,30,0)="   corrected and how many prescriptions with missing divisions were"
^DIC(9.4,60,22,13,"PAH",121,1,31,0)="   corrected."
^DIC(9.4,60,22,13,"PAH",121,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,33,0)="    "
^DIC(9.4,60,22,13,"PAH",121,1,34,0)=" 3. During the building of the Patient Profile through the Patient "
^DIC(9.4,60,22,13,"PAH",121,1,35,0)="    Prescription Processing [PSO LM BACKDOOR] option, one of the "
^DIC(9.4,60,22,13,"PAH",121,1,36,0)="    criteria for forcing the Status to SUSPENDED of prescriptions "
^DIC(9.4,60,22,13,"PAH",121,1,37,0)="    that had an entry in the RX SUSPENSE file (#52.5) was at times"
^DIC(9.4,60,22,13,"PAH",121,1,38,0)="    found to be incorrect. If the entry in the RX SUSPENSE file"
^DIC(9.4,60,22,13,"PAH",121,1,39,0)="    (#52.5) was flagged as not printed, the software would force the"
^DIC(9.4,60,22,13,"PAH",121,1,40,0)="    prescription status to SUSPENDED. After this patch is installed,"
^DIC(9.4,60,22,13,"PAH",121,1,41,0)="    the software will also check if the prescription has already been"
^DIC(9.4,60,22,13,"PAH",121,1,42,0)="    transmitted to Consolidated Mail Outpatient Pharmacy (CMOP) V. 2.0"
^DIC(9.4,60,22,13,"PAH",121,1,43,0)="    system, and if so, the status will not be changed."
^DIC(9.4,60,22,13,"PAH",121,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,45,0)="4. When trying to edit a prescription, and the edit is not allowed "
^DIC(9.4,60,22,13,"PAH",121,1,46,0)="   because either the order or patient is locked by another user, the "
^DIC(9.4,60,22,13,"PAH",121,1,47,0)="   message indicating that the order or patient is locked will not always "
^DIC(9.4,60,22,13,"PAH",121,1,48,0)="   contain the person's name that has the lock. This patch corrects the "
^DIC(9.4,60,22,13,"PAH",121,1,49,0)="   problem."
^DIC(9.4,60,22,13,"PAH",121,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",121,1,51,0)="5. When the user edited a prescription in such a way that caused a new"
^DIC(9.4,60,22,13,"PAH",121,1,52,0)="   prescription to be created, the new prescription was not being "
^DIC(9.4,60,22,13,"PAH",121,1,53,0)="   displayed in the Bingo Board. This patch corrects the problem."
^DIC(9.4,60,22,13,"PAH",121,1,54,0)="   The prescription number from the previous edit could be associated to"
^DIC(9.4,60,22,13,"PAH",121,1,55,0)="   the next patient's list of prescriptions to be listed on the Bingo"
^DIC(9.4,60,22,13,"PAH",121,1,56,0)="   Board.  This patch also corrects this problem."
^DIC(9.4,60,22,13,"PAH",122,0)="138 SEQ #126^3030715^1"
^DIC(9.4,60,22,13,"PAH",122,1,0)="^^18^18^3030715"
^DIC(9.4,60,22,13,"PAH",122,1,1,0)="1. During testing of PSO*7*120, it was discovered that there was a "
^DIC(9.4,60,22,13,"PAH",122,1,2,0)="problem with the entry of 'y' at the prompt ""Print adhesive portion of "
^DIC(9.4,60,22,13,"PAH",122,1,3,0)="label only? "". The lowercase 'y' was being treated as a NO response. This "
^DIC(9.4,60,22,13,"PAH",122,1,4,0)="patch corrects this problem by handling either upper or lower case YES, "
^DIC(9.4,60,22,13,"PAH",122,1,5,0)="YE or Y as yes."
^DIC(9.4,60,22,13,"PAH",122,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",122,1,7,0)="2. A problem was found with the documentation of the Integration "
^DIC(9.4,60,22,13,"PAH",122,1,8,0)="Agreements in routine PSOLLU2. This patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",122,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",122,1,10,0)="3. In preparation for future enhancements to language handling within "
^DIC(9.4,60,22,13,"PAH",122,1,11,0)="label print, a change was necessary to allow the bottle label information "
^DIC(9.4,60,22,13,"PAH",122,1,12,0)="to print in a different language from the one on the pharmacy fill "
^DIC(9.4,60,22,13,"PAH",122,1,13,0)="document. This patch makes this change."
^DIC(9.4,60,22,13,"PAH",122,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",122,1,15,0)="4. The final contract award for the laser label stock made a slight "
^DIC(9.4,60,22,13,"PAH",122,1,16,0)="modification to the location of the perforation about the fill document. "
^DIC(9.4,60,22,13,"PAH",122,1,17,0)="This patch makes the modification to the printer setup routine to "
^DIC(9.4,60,22,13,"PAH",122,1,18,0)="accomodate this change."
^DIC(9.4,60,22,13,"PAH",123,0)="117 SEQ #127^3030715^1"
^DIC(9.4,60,22,13,"PAH",123,1,0)="^^65^65^3030715"
^DIC(9.4,60,22,13,"PAH",123,1,1,0)="1. This patch provides new functionality that allows the Veteran Affairs "
^DIC(9.4,60,22,13,"PAH",123,1,2,0)="Medical Centers to print a patient's prescription bottle label in another "
^DIC(9.4,60,22,13,"PAH",123,1,3,0)="language.  This functionality is accomplished by identifying which patients"
^DIC(9.4,60,22,13,"PAH",123,1,4,0)="have another language preference. To identify patients as having another"
^DIC(9.4,60,22,13,"PAH",123,1,5,0)="language preference use the Update Patient Record [PSO PAT] option and the"
^DIC(9.4,60,22,13,"PAH",123,1,6,0)="Patient Record Update [PSO PATIENT RECORD UPDATE] protocol action and enter"
^DIC(9.4,60,22,13,"PAH",123,1,7,0)="Yes in the new field OTHER LANGUAGE PREFERENCE field (#106) in the PHARMACY"
^DIC(9.4,60,22,13,"PAH",123,1,8,0)="PATIENT file (#55).  "
^DIC(9.4,60,22,13,"PAH",123,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,10,0)="2. This patch also addresses the following NOIS issues: "
^DIC(9.4,60,22,13,"PAH",123,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,12,0)="a) ISB-0702-32646 "
^DIC(9.4,60,22,13,"PAH",123,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,14,0)="For drugs that have possible dosages, if the dosage is edited using Patient"
^DIC(9.4,60,22,13,"PAH",123,1,15,0)="Prescription Processing [PSO LM BACKDOOR ORDERS] option, the software"
^DIC(9.4,60,22,13,"PAH",123,1,16,0)="calculates the new DISPENSE UNITS PER DOSE field (#1) of the MEDICATION"
^DIC(9.4,60,22,13,"PAH",123,1,17,0)="INSTRUCTIONS sub-file (#113) of the PRESCRIPTION file (#52), accordingly. At"
^DIC(9.4,60,22,13,"PAH",123,1,18,0)="the confirmation prompt that follows immediately if you respond ""NO"","
^DIC(9.4,60,22,13,"PAH",123,1,19,0)="meaning not to accept the new value, the software does not revert the"
^DIC(9.4,60,22,13,"PAH",123,1,20,0)="DISPENSE UNITS PER DOSE field (#1) back to it's original value. This patch"
^DIC(9.4,60,22,13,"PAH",123,1,21,0)="fixes this issue.  "
^DIC(9.4,60,22,13,"PAH",123,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,23,0)="b) CAH-0402-31866 "
^DIC(9.4,60,22,13,"PAH",123,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,25,0)="When entering a new prescription using the Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",123,1,26,0)="[PSO LM BACKDOOR ORDERS] option, if that prescription is discontinued before"
^DIC(9.4,60,22,13,"PAH",123,1,27,0)="it goes to the label queue prompt, currently, the label ""LABEL QUEUE/CHANGE"
^DIC(9.4,60,22,13,"PAH",123,1,28,0)="PRINTER/SUSPEND or '^' to bypass Q//"" is prompted. If this is the only order"
^DIC(9.4,60,22,13,"PAH",123,1,29,0)="in that session then there is no label to print and therefore the label queue"
^DIC(9.4,60,22,13,"PAH",123,1,30,0)="prompt should not be displayed. This patch fixes this problem.  "
^DIC(9.4,60,22,13,"PAH",123,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,32,0)="c) ISH-0902-40182 "
^DIC(9.4,60,22,13,"PAH",123,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,34,0)="Between the time an order was placed in Computerized Patient Record System"
^DIC(9.4,60,22,13,"PAH",123,1,35,0)="(CPRS) V.1.0 and the time the order is processed in the backdoor pharmacy,"
^DIC(9.4,60,22,13,"PAH",123,1,36,0)="if the dispense drug is made inactive, then there is a possibility of"
^DIC(9.4,60,22,13,"PAH",123,1,37,0)="getting an undefined error if a ""?"" is entered when editing the dosage"
^DIC(9.4,60,22,13,"PAH",123,1,38,0)="prompt . Since the drug is inactive the software does not gather the"
^DIC(9.4,60,22,13,"PAH",123,1,39,0)="available dosages and as a result the undefined error. In order to process"
^DIC(9.4,60,22,13,"PAH",123,1,40,0)="such an order (avoiding the undefined error), this patch will provide the"
^DIC(9.4,60,22,13,"PAH",123,1,41,0)="user the option of making a free text dosage entry.  "
^DIC(9.4,60,22,13,"PAH",123,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,43,0)="d) LIT-1102-71356 "
^DIC(9.4,60,22,13,"PAH",123,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,45,0)="When a site merges two patients together, the PHARMACY PATIENT file (#55)"
^DIC(9.4,60,22,13,"PAH",123,1,46,0)="contains all of the prescriptions from the ""merged from"" patient and the"
^DIC(9.4,60,22,13,"PAH",123,1,47,0)="""merged to"" patient under the internal entry number of the ""merged to"""
^DIC(9.4,60,22,13,"PAH",123,1,48,0)="patient. The old patient's internal entry number is kept in the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",123,1,49,0)="file (#52) for any prescriptions that were originally filed with that"
^DIC(9.4,60,22,13,"PAH",123,1,50,0)="number. If a new prescription is ordered for a drug that is already in the"
^DIC(9.4,60,22,13,"PAH",123,1,51,0)="prescription profile, the order entry process will discontinue the old"
^DIC(9.4,60,22,13,"PAH",123,1,52,0)="prescription correctly.  The problem is that if the discontinued order"
^DIC(9.4,60,22,13,"PAH",123,1,53,0)="belongs to the old patient internal entry number, the new prescription order"
^DIC(9.4,60,22,13,"PAH",123,1,54,0)="is filed with the old patient's internal entry number in the PHARMACY"
^DIC(9.4,60,22,13,"PAH",123,1,55,0)="PATIENT file (#55) and the PRESCRIPTION file (#52) and doesn't appear on the"
^DIC(9.4,60,22,13,"PAH",123,1,56,0)="prescription profile. This patch corrects this problem.  "
^DIC(9.4,60,22,13,"PAH",123,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,58,0)="3. A more descriptive message will now be given to the user when an order is"
^DIC(9.4,60,22,13,"PAH",123,1,59,0)="accessed, and that order is locked by another user, when copying a "
^DIC(9.4,60,22,13,"PAH",123,1,60,0)="prescription, selecting a pending order, discontinuing a prescription, and"
^DIC(9.4,60,22,13,"PAH",123,1,61,0)="processing a non-verified prescription.  "
^DIC(9.4,60,22,13,"PAH",123,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",123,1,63,0)="4. If pre-POE prescriptions are renewed or edited to create a new prescription,"
^DIC(9.4,60,22,13,"PAH",123,1,64,0)="the resulting prescription may have a missing SIG. This patch corrects the"
^DIC(9.4,60,22,13,"PAH",123,1,65,0)="problem.  "
^DIC(9.4,60,22,13,"PAH",124,0)="126 SEQ #128^3030715^1"
^DIC(9.4,60,22,13,"PAH",124,1,0)="^^43^43^3030715"
^DIC(9.4,60,22,13,"PAH",124,1,1,0)="This patch is a partner patch with the Consolidated Mail Outpatient"
^DIC(9.4,60,22,13,"PAH",124,1,2,0)="Pharmacy V. 2.0 (CMOP) patch PSX*2*41. PSO*7*126 must be installed before"
^DIC(9.4,60,22,13,"PAH",124,1,3,0)="the CMOP patch at remote facilities. This patch will be adding new data "
^DIC(9.4,60,22,13,"PAH",124,1,4,0)="dictionaries to be used in conjunction with the CMOP patch PSX*2*41."
^DIC(9.4,60,22,13,"PAH",124,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,6,0)="1. Problem: VISNs have been combining facilities and the running time of"
^DIC(9.4,60,22,13,"PAH",124,1,7,0)="transmissions is becoming very long.  The number of divisions has grown"
^DIC(9.4,60,22,13,"PAH",124,1,8,0)="to about fifty in the largest VISN.  This means 100 transmissions must be"
^DIC(9.4,60,22,13,"PAH",124,1,9,0)="processed each day."
^DIC(9.4,60,22,13,"PAH",124,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,11,0)="Solution: Several steps have been taken to reduce the time needed for"
^DIC(9.4,60,22,13,"PAH",124,1,12,0)="transmissions.  A special index built with 'type' and 'division' has been"
^DIC(9.4,60,22,13,"PAH",124,1,13,0)="added to CMOP INDICATOR field (#3) in the RX SUSPENSE file (#52.5) that"
^DIC(9.4,60,22,13,"PAH",124,1,14,0)="optimizes the picking of prescriptions for each transmission."
^DIC(9.4,60,22,13,"PAH",124,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,16,0)="2. Problem:   In support of the Hawaii DoD project, Pharmacy Data "
^DIC(9.4,60,22,13,"PAH",124,1,17,0)="Management (PDM) needs to know when changes are made to entries in the "
^DIC(9.4,60,22,13,"PAH",124,1,18,0)="DRUG file (#50). To meet this need a call needs to be made to PDM V. 1.0 "
^DIC(9.4,60,22,13,"PAH",124,1,19,0)="routine PSSHUIDG at line tag DRG whenever an edit is made to the DRUG "
^DIC(9.4,60,22,13,"PAH",124,1,20,0)="file (#50)."
^DIC(9.4,60,22,13,"PAH",124,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,22,0)="Solution: The routine PSOCMOP has been modified to call the PDM routine "
^DIC(9.4,60,22,13,"PAH",124,1,23,0)="PSSHUIDG"
^DIC(9.4,60,22,13,"PAH",124,1,24,0)="when an edit is made to the DRUG file (#50)."
^DIC(9.4,60,22,13,"PAH",124,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,26,0)="Environmental Check:"
^DIC(9.4,60,22,13,"PAH",124,1,27,0)="===================="
^DIC(9.4,60,22,13,"PAH",124,1,28,0)="An environmental check routine will run to check if the RX # (#.01) field"
^DIC(9.4,60,22,13,"PAH",124,1,29,0)="in the RX SUSPSENSE file (#52.5) is populated before continuing with"
^DIC(9.4,60,22,13,"PAH",124,1,30,0)="install.  If this field is missing, the following message will appear:"
^DIC(9.4,60,22,13,"PAH",124,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,32,0)="Checking the RX Suspense file for missing .01 fields."
^DIC(9.4,60,22,13,"PAH",124,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,34,0)="667    (A list of entry numbers that are missing the #.01 field)"
^DIC(9.4,60,22,13,"PAH",124,1,35,0)="..."
^DIC(9.4,60,22,13,"PAH",124,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,37,0)="The Suspense file #52.5 has been found to have entries without a .01"
^DIC(9.4,60,22,13,"PAH",124,1,38,0)="field."
^DIC(9.4,60,22,13,"PAH",124,1,39,0)="Please call NVS to clear this problem."
^DIC(9.4,60,22,13,"PAH",124,1,40,0)="<CR> - to continue:"
^DIC(9.4,60,22,13,"PAH",124,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",124,1,42,0)="You will need to log a NOIS to National Vista Support (NVS) to have this"
^DIC(9.4,60,22,13,"PAH",124,1,43,0)="problem resolved before the installation can continue."
^DIC(9.4,60,22,13,"PAH",125,0)="142 SEQ #129^3030802^1"
^DIC(9.4,60,22,13,"PAH",125,1,0)="^^21^21^3030802"
^DIC(9.4,60,22,13,"PAH",125,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",125,1,2,0)="This patch provides a report listing all back-billed patients from patch"
^DIC(9.4,60,22,13,"PAH",125,1,3,0)="PSO*7*123. For each back-billed copay fill it indicates whether the"
^DIC(9.4,60,22,13,"PAH",125,1,4,0)="patient had prescription insurance coverage as of the release date and/or"
^DIC(9.4,60,22,13,"PAH",125,1,5,0)="billed date for the fill. If the copay charge has been cancelled since"
^DIC(9.4,60,22,13,"PAH",125,1,6,0)="patch PSO*7*123 was installed, that information appears instead of the"
^DIC(9.4,60,22,13,"PAH",125,1,7,0)="insurance information."
^DIC(9.4,60,22,13,"PAH",125,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",125,1,9,0)="If the patient had prescription insurance coverage on the billed date,"
^DIC(9.4,60,22,13,"PAH",125,1,10,0)="the copay charge is held for 90 days before going out in the patient"
^DIC(9.4,60,22,13,"PAH",125,1,11,0)="statement. If the patient had coverage on the release date, the copay"
^DIC(9.4,60,22,13,"PAH",125,1,12,0)="bills and insurance bills should be reviewed to determine if the"
^DIC(9.4,60,22,13,"PAH",125,1,13,0)="copayment charge is applicable because of possible insurance payment."
^DIC(9.4,60,22,13,"PAH",125,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",125,1,15,0)="If the copay charge should be credited, it can be removed by using the"
^DIC(9.4,60,22,13,"PAH",125,1,16,0)="Reset Copay Status/Cancel Charges [PSOCP RESET COPAY STATUS] option."
^DIC(9.4,60,22,13,"PAH",125,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",125,1,18,0)="The temporary global ^XTMP(""PSOCPIB3"" from the patch PSO*7*123 install is"
^DIC(9.4,60,22,13,"PAH",125,1,19,0)="kept for 90 days, so this report must be run within that time frame. To"
^DIC(9.4,60,22,13,"PAH",125,1,20,0)="run the report, enter D ^PSOCPIB5 from the programmer's prompt. It prints"
^DIC(9.4,60,22,13,"PAH",125,1,21,0)="in 80-column format and can be queued to print."
^DIC(9.4,60,22,13,"PAH",126,0)="131 SEQ #130^3030802^1"
^DIC(9.4,60,22,13,"PAH",126,1,0)="^^30^30^3030802"
^DIC(9.4,60,22,13,"PAH",126,1,1,0)="Pharmacy Benefits Management (PBM) Strategic Healthcare Group in "
^DIC(9.4,60,22,13,"PAH",126,1,2,0)="collaboration with the Drug Enforcement Administration (DEA), requested"
^DIC(9.4,60,22,13,"PAH",126,1,3,0)="the development of the first Public Key Infrastructure (PKI) VistA pilot"
^DIC(9.4,60,22,13,"PAH",126,1,4,0)="project, named Electronic Prescription Order Entry for Schedule II"
^DIC(9.4,60,22,13,"PAH",126,1,5,0)="Controlled Substances. The objective is to develop an electronic order"
^DIC(9.4,60,22,13,"PAH",126,1,6,0)="entry system for Schedule II controlled substances using digital"
^DIC(9.4,60,22,13,"PAH",126,1,7,0)="signatures. To make this project viable, modifications to the following"
^DIC(9.4,60,22,13,"PAH",126,1,8,0)="packages were identified:"
^DIC(9.4,60,22,13,"PAH",126,1,9,0)="National Drug File (NDF) V. 4.0"
^DIC(9.4,60,22,13,"PAH",126,1,10,0)="Kernel V. 8.0"
^DIC(9.4,60,22,13,"PAH",126,1,11,0)="Computerized Patient Record System (CPRS) V. 1.0"
^DIC(9.4,60,22,13,"PAH",126,1,12,0)="Pharmacy Data Management (PDM) V. 1.0"
^DIC(9.4,60,22,13,"PAH",126,1,13,0)="Outpatient Pharmacy (OP) V. 7.0"
^DIC(9.4,60,22,13,"PAH",126,1,14,0)="Controlled Substances (CS) V. 3.0"
^DIC(9.4,60,22,13,"PAH",126,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",126,1,16,0)="This is the PSO patch that provides the following new functionality."
^DIC(9.4,60,22,13,"PAH",126,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",126,1,18,0)="1. This Outpatient Pharmacy patch contains the software changes to process"
^DIC(9.4,60,22,13,"PAH",126,1,19,0)="   digitally signed orders entered via the Computerized Patient Record"
^DIC(9.4,60,22,13,"PAH",126,1,20,0)="   System (CPRS) V. 1.0 for schedule II controlled substances. This patch"
^DIC(9.4,60,22,13,"PAH",126,1,21,0)="   lays the foundation for the future implementation of the Public Key"
^DIC(9.4,60,22,13,"PAH",126,1,22,0)="   Infrastructure (PKI) once the Drug Enforcement Administration's (DEA)"
^DIC(9.4,60,22,13,"PAH",126,1,23,0)="   regulations are revised and published, and will not be fully functional"
^DIC(9.4,60,22,13,"PAH",126,1,24,0)="   in this patch."
^DIC(9.4,60,22,13,"PAH",126,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",126,1,26,0)="2. This patch will ensure that no refills will be allowed for any"
^DIC(9.4,60,22,13,"PAH",126,1,27,0)="   Outpatient Pharmacy prescription for a drug that contains an ""F"" in the"
^DIC(9.4,60,22,13,"PAH",126,1,28,0)="   DEA SPECIAL HDLG field (#3) of the DRUG file (#50). This NON REFILLABLE"
^DIC(9.4,60,22,13,"PAH",126,1,29,0)="   (""F"") code was introduced by the Pharmacy Data Management (PDM) V. 1.0"
^DIC(9.4,60,22,13,"PAH",126,1,30,0)="   patch PSS*1*61."
^DIC(9.4,60,22,13,"PAH",127,0)="145^3030912^1"
^DIC(9.4,60,22,13,"PAH",127,1,0)="^^102^102^3030912"
^DIC(9.4,60,22,13,"PAH",127,1,1,0)="This is the Phase I patch of the Transitional Pharmacy Benefit Project"
^DIC(9.4,60,22,13,"PAH",127,1,2,0)="(TPB). This project provides functionality for the ""Medication Prescribed "
^DIC(9.4,60,22,13,"PAH",127,1,3,0)="by Non-VA Physicians"" to accommodate the Veterans Health Administration "
^DIC(9.4,60,22,13,"PAH",127,1,4,0)="(VHA) Directive 2003-047 that allows Department of Veterans Affairs (VA) "
^DIC(9.4,60,22,13,"PAH",127,1,5,0)="to furnish medications from non-VA physicians. It mandates that for"
^DIC(9.4,60,22,13,"PAH",127,1,6,0)="eligible veterans that meet certain criteria, VHA will fill prescriptions"
^DIC(9.4,60,22,13,"PAH",127,1,7,0)="written by non-VA physicians and dentists. To determine eligibility, a"
^DIC(9.4,60,22,13,"PAH",127,1,8,0)="patient must meet the following criteria:"
^DIC(9.4,60,22,13,"PAH",127,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,10,0)="1) The patient must be a veteran."
^DIC(9.4,60,22,13,"PAH",127,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,12,0)="2) The veteran must be enrolled for VA health care system before"
^DIC(9.4,60,22,13,"PAH",127,1,13,0)="   July 25, 2003."
^DIC(9.4,60,22,13,"PAH",127,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,15,0)="3) Before July 25,2003, the veteran must have requested their first "
^DIC(9.4,60,22,13,"PAH",127,1,16,0)="   primary care appointment with the VA."
^DIC(9.4,60,22,13,"PAH",127,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,18,0)="4) The veteran must have no active prescriptions dispensed by the local "
^DIC(9.4,60,22,13,"PAH",127,1,19,0)="   VHA pharmacy, excluding Supply and Investigational items, for the past "
^DIC(9.4,60,22,13,"PAH",127,1,20,0)="   485 days from October 22, 2003."
^DIC(9.4,60,22,13,"PAH",127,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,22,0)="5) The veteran must be waiting more than 30 days for their first "
^DIC(9.4,60,22,13,"PAH",127,1,23,0)="   appointment with a Primary Care Physician on or after October 22, "
^DIC(9.4,60,22,13,"PAH",127,1,24,0)="   2003, or the veteran is deemed eligible via an Electronic Wait"
^DIC(9.4,60,22,13,"PAH",127,1,25,0)="   List/Scheduling extract run at each local site."
^DIC(9.4,60,22,13,"PAH",127,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,29,0)="This patch is being sent out as a combined build, along with patch "
^DIC(9.4,60,22,13,"PAH",127,1,30,0)="SD*5.3*300."
^DIC(9.4,60,22,13,"PAH",127,1,31,0)="            "
^DIC(9.4,60,22,13,"PAH",127,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,33,0)="Outpatient Pharmacy will provide the following functionality in this "
^DIC(9.4,60,22,13,"PAH",127,1,34,0)="patch:"
^DIC(9.4,60,22,13,"PAH",127,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,36,0)="1. A Post-Install routine will scan through the PATIENT file (#2)"
^DIC(9.4,60,22,13,"PAH",127,1,37,0)="and the SD WAIT LIST file (#409.3), and will populate the new Outpatient"
^DIC(9.4,60,22,13,"PAH",127,1,38,0)="Pharmacy TPB ELIGIBILITY file (#52.91) with patients eligible for the"
^DIC(9.4,60,22,13,"PAH",127,1,39,0)="Transitional Pharmacy Benefit. Patients will either be entered into the"
^DIC(9.4,60,22,13,"PAH",127,1,40,0)="file as eligible, or ineligible. If they are entered into the file as"
^DIC(9.4,60,22,13,"PAH",127,1,41,0)="ineligible, an exclusion reason will also be entered into the file. Please"
^DIC(9.4,60,22,13,"PAH",127,1,42,0)="refer to the documentation for more details."
^DIC(9.4,60,22,13,"PAH",127,1,43,0)="  "
^DIC(9.4,60,22,13,"PAH",127,1,44,0)="The average run time of the Post-Install at the test sites was 1 hour."
^DIC(9.4,60,22,13,"PAH",127,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,47,0)="2. The following new options are provided in this patch:"
^DIC(9.4,60,22,13,"PAH",127,1,48,0)="   a. A new report option, TPB Patient Report [PSO TPB PATIENT REPORT], "
^DIC(9.4,60,22,13,"PAH",127,1,49,0)="      will be provided to display the patients in the TPB ELIGIBILITY file"
^DIC(9.4,60,22,13,"PAH",127,1,50,0)="      (#52.91). Various sort criteria are provided."
^DIC(9.4,60,22,13,"PAH",127,1,51,0)="   b. The Transitional Pharmacy Benefit Patient Enter/Edit [PSO TPB  "
^DIC(9.4,60,22,13,"PAH",127,1,52,0)="      PATIENT ENTER/EDIT] option will allow sites to add new patients, and"
^DIC(9.4,60,22,13,"PAH",127,1,53,0)="      edit existing patients. Note: This option will be set initially to"
^DIC(9.4,60,22,13,"PAH",127,1,54,0)="      ""Out of Order"", until the post-install runs to completion."
^DIC(9.4,60,22,13,"PAH",127,1,55,0)="   c. The TPB Institution Letter Enter/Edit [PSO TPB INSTITUTION LETTERS]"
^DIC(9.4,60,22,13,"PAH",127,1,56,0)="      option allows the user to edit each TPB institution's information"
^DIC(9.4,60,22,13,"PAH",127,1,57,0)="      elements that are to be printed on the letters to be sent to the"
^DIC(9.4,60,22,13,"PAH",127,1,58,0)="      patients."
^DIC(9.4,60,22,13,"PAH",127,1,59,0)="   d. The Report TPB Patients Letters Printed/NOT Printed [PSO TPB LETTERS"
^DIC(9.4,60,22,13,"PAH",127,1,60,0)="      PRINTED REPORT] option provides the user the ability to generate a"
^DIC(9.4,60,22,13,"PAH",127,1,61,0)="      report of patients' letters printed or not printed."
^DIC(9.4,60,22,13,"PAH",127,1,62,0)="   e. The Print TPB Patient Letter(s) [PSO TPB PRINT LETTERS] option"
^DIC(9.4,60,22,13,"PAH",127,1,63,0)="      provides the ability to print TPB letters to be sent to patients."
^DIC(9.4,60,22,13,"PAH",127,1,64,0)="                        "
^DIC(9.4,60,22,13,"PAH",127,1,65,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,66,0)="KIDS Build and Documentation Retrieval:"
^DIC(9.4,60,22,13,"PAH",127,1,67,0)="======================================================"
^DIC(9.4,60,22,13,"PAH",127,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,69,0)="The KIDS Build and VISTA documentation are available on the "
^DIC(9.4,60,22,13,"PAH",127,1,70,0)="ANONYMOUS.SOFTWARE directory at one of the following Office of Information"
^DIC(9.4,60,22,13,"PAH",127,1,71,0)="(OI) Field Offices."
^DIC(9.4,60,22,13,"PAH",127,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,74,0)="Sites may retrieve documentation in one of the following ways:"
^DIC(9.4,60,22,13,"PAH",127,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,76,0)="(1) The preferred method is to FTP the files from"
^DIC(9.4,60,22,13,"PAH",127,1,77,0)="    download.vista.domain.ext, which will transmit the files from the "
^DIC(9.4,60,22,13,"PAH",127,1,78,0)="    first available FTP server."
^DIC(9.4,60,22,13,"PAH",127,1,79,0)="  "
^DIC(9.4,60,22,13,"PAH",127,1,80,0)="(2) Sites may also elect to retrieve documentation directly from a"
^DIC(9.4,60,22,13,"PAH",127,1,81,0)="    specific server as follows:"
^DIC(9.4,60,22,13,"PAH",127,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,83,0)="    Albany          ftp.fo-albany.domain.ext"
^DIC(9.4,60,22,13,"PAH",127,1,84,0)="    Hines           ftp.fo-hines.domain.ext"
^DIC(9.4,60,22,13,"PAH",127,1,85,0)="    Salt Lake City  ftp.fo-slc.domain.ext"
^DIC(9.4,60,22,13,"PAH",127,1,86,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,88,0)="The software distribution includes: "
^DIC(9.4,60,22,13,"PAH",127,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,90,0)="    FILE NAMES                    DESCRIPTION"
^DIC(9.4,60,22,13,"PAH",127,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,92,0)="    PSO_TPB_ELIGIBILITY_1_0.KID   KIDS Build         "
^DIC(9.4,60,22,13,"PAH",127,1,93,0)="    PSO_7_P145_IG.PDF             Installation Guide"
^DIC(9.4,60,22,13,"PAH",127,1,94,0)="    PSO_7_UM_R0803.PDF            User Manual"
^DIC(9.4,60,22,13,"PAH",127,1,95,0)="    PSO_7_P145_UM_CP.PDF          User Manual Change Page Document"
^DIC(9.4,60,22,13,"PAH",127,1,96,0)="    PSO_7_TM_R0803.PDF            Technical Manual"
^DIC(9.4,60,22,13,"PAH",127,1,97,0)="    PSO_7_P145_TM_CP.PDF          Technical Manual Change Page Document"
^DIC(9.4,60,22,13,"PAH",127,1,98,0)="    PSO_7_P145_RN.PDF             Release Notes"
^DIC(9.4,60,22,13,"PAH",127,1,99,0)=" "
^DIC(9.4,60,22,13,"PAH",127,1,100,0)="(3) Documentation can also be retrieved from VISTA Documentation Library"
^DIC(9.4,60,22,13,"PAH",127,1,101,0)="(VDL) on the Internet at the following address,"
^DIC(9.4,60,22,13,"PAH",127,1,102,0)="http://www.domain.ext/vdl."
^DIC(9.4,60,22,13,"PAH",128,0)="144 SEQ #132^3030912^1"
^DIC(9.4,60,22,13,"PAH",128,1,0)="^^8^8^3030912"
^DIC(9.4,60,22,13,"PAH",128,1,1,0)="This patch contains enhancements in support of drug-drug interaction"
^DIC(9.4,60,22,13,"PAH",128,1,2,0)="order check exclusions. In addition, the National Drug File patch PSN*4*70"
^DIC(9.4,60,22,13,"PAH",128,1,3,0)="is required to support this function. When both patches are installed,"
^DIC(9.4,60,22,13,"PAH",128,1,4,0)="drug-drug interactions will be excluded for specifically identified drugs."
^DIC(9.4,60,22,13,"PAH",128,1,5,0)="The list of drugs and VA products flagged for exclusion can be found using"
^DIC(9.4,60,22,13,"PAH",128,1,6,0)="the options Local Drugs Excluded from Drug-Drug Interactions and VA Products"
^DIC(9.4,60,22,13,"PAH",128,1,7,0)="Excluded from Drug-Drug Interactions contained on the National Drug File"
^DIC(9.4,60,22,13,"PAH",128,1,8,0)="Reports menu within the National Drug File."
^DIC(9.4,60,22,13,"PAH",129,0)="146 SEQ #133^3030924^1"
^DIC(9.4,60,22,13,"PAH",129,1,0)="^^139^139^3030924"
^DIC(9.4,60,22,13,"PAH",129,1,1,0)="This is the Outpatient Pharmacy patch, (Phase II), for the Transitional"
^DIC(9.4,60,22,13,"PAH",129,1,2,0)="Pharmacy Benefit Project (TPB)."
^DIC(9.4,60,22,13,"PAH",129,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,4,0)="1. An Environment check routine is included in the patch, and the install "
^DIC(9.4,60,22,13,"PAH",129,1,5,0)="will be aborted if either of the following 2 conditions are met. If you"
^DIC(9.4,60,22,13,"PAH",129,1,6,0)="already have an entry named 'NON-VA' in the RX PATIENT STATUS file (#53),"
^DIC(9.4,60,22,13,"PAH",129,1,7,0)="the install will be aborted, because this patch exports an entry with that"
^DIC(9.4,60,22,13,"PAH",129,1,8,0)="same name. If you have not created an entry in the DOMAIN file (#4.2) "
^DIC(9.4,60,22,13,"PAH",129,1,9,0)="named ""TPB-AUSTIN.DOMAIN.EXT"", the install will be aborted, because that"
^DIC(9.4,60,22,13,"PAH",129,1,10,0)="domain is needed for the Health Level Seven (HL7)."
^DIC(9.4,60,22,13,"PAH",129,1,11,0)="extracts of the TPB Patient information."
^DIC(9.4,60,22,13,"PAH",129,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,14,0)="2. A Post-Install routine is included that will scan the TPB ELIGIBILITY"
^DIC(9.4,60,22,13,"PAH",129,1,15,0)="file (#52.91) and check each patient to see if that patient is flagged"
^DIC(9.4,60,22,13,"PAH",129,1,16,0)="with a DATE OF DEATH entry in the PATIENT file (#2). If that patient has a"
^DIC(9.4,60,22,13,"PAH",129,1,17,0)="DATE OF DEATH entry, and the patient is still active in the TPB"
^DIC(9.4,60,22,13,"PAH",129,1,18,0)="ELIGIBILITY file (#52.91), that patient will be marked inactive in the TPB"
^DIC(9.4,60,22,13,"PAH",129,1,19,0)="ELIGIBILITY file (#52.91)."
^DIC(9.4,60,22,13,"PAH",129,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,22,0)="3. A new 'NVA' code has been added to the SC/A&A/OTHER/INPATIENT field"
^DIC(9.4,60,22,13,"PAH",129,1,23,0)="(#6) of the RX PATIENT STATUS file (#53), to distinguish prescriptions "
^DIC(9.4,60,22,13,"PAH",129,1,24,0)="entered as part of the TPB project. The field will now be named"
^DIC(9.4,60,22,13,"PAH",129,1,25,0)="SC/A&A/OTHER/INPATIENT/NVA. The 'NVA' code will automatically be assigned "
^DIC(9.4,60,22,13,"PAH",129,1,26,0)="to the 'NON-VA' Rx Patient Status entry that is being exported with this "
^DIC(9.4,60,22,13,"PAH",129,1,27,0)="patch."
^DIC(9.4,60,22,13,"PAH",129,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,30,0)="4. A new field named TPB RX, field (#201), has been added to the "
^DIC(9.4,60,22,13,"PAH",129,1,31,0)="PRESCRIPTION file (#52). The software will automatically set this field "
^DIC(9.4,60,22,13,"PAH",129,1,32,0)="to 'Yes' for any prescription that meets all of the TPB requirements."
^DIC(9.4,60,22,13,"PAH",129,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,35,0)="5. The following fields were added to the NEW PERSON file (#200) by Kernel"
^DIC(9.4,60,22,13,"PAH",129,1,36,0)="patch XU*8.0*311:"
^DIC(9.4,60,22,13,"PAH",129,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,38,0)="53.91     NON-VA PRESCRIBER"
^DIC(9.4,60,22,13,"PAH",129,1,39,0)="53.92     TAX ID"
^DIC(9.4,60,22,13,"PAH",129,1,40,0)="53.93     EXCLUSIONARY CHECK PERFORMED"
^DIC(9.4,60,22,13,"PAH",129,1,41,0)="53.94     DATE EXCLUSIONARY LIST CHECKED"
^DIC(9.4,60,22,13,"PAH",129,1,42,0)="53.95     ON EXCLUSIONARY LIST"
^DIC(9.4,60,22,13,"PAH",129,1,43,0)="53.96     EXCLUSIONARY CHECKED BY"
^DIC(9.4,60,22,13,"PAH",129,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,45,0)="The following Outpatient Pharmacy options have been modified to allow the "
^DIC(9.4,60,22,13,"PAH",129,1,46,0)="editing of these new fields in the NEW PERSON file (#200):"
^DIC(9.4,60,22,13,"PAH",129,1,47,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,48,0)="Add New Providers [PSO PROVIDER ADD]"
^DIC(9.4,60,22,13,"PAH",129,1,49,0)="Edit Provider [PROVIDER EDIT]"
^DIC(9.4,60,22,13,"PAH",129,1,50,0)="View Provider [PSO PROVIDER INQUIRE] "
^DIC(9.4,60,22,13,"PAH",129,1,51,0)="   "
^DIC(9.4,60,22,13,"PAH",129,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,53,0)="6. The following fields have been added to the PHARMACY SYSTEM file "
^DIC(9.4,60,22,13,"PAH",129,1,54,0)="(#59.7). These fields will be used by the HL7 extracts of TPB Patient "
^DIC(9.4,60,22,13,"PAH",129,1,55,0)="information:"
^DIC(9.4,60,22,13,"PAH",129,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,57,0)="46.1    TRANSMISSION START DATE"
^DIC(9.4,60,22,13,"PAH",129,1,58,0)="46.2    TRANSMISSION END DATE"
^DIC(9.4,60,22,13,"PAH",129,1,59,0)="46.3    BATCH CONTROL ID"
^DIC(9.4,60,22,13,"PAH",129,1,60,0)="46.4    NUMBER OF MSH COUNT"
^DIC(9.4,60,22,13,"PAH",129,1,61,0)="46.5    NUMBER OF LINES COUNT"
^DIC(9.4,60,22,13,"PAH",129,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,63,0)="The HL7 extract will automatically be done on all patients upon initial "
^DIC(9.4,60,22,13,"PAH",129,1,64,0)="patch install, then the job will be automatically queued to run every "
^DIC(9.4,60,22,13,"PAH",129,1,65,0)="evening at 6:00pm, and the extract will check the day of the week, and "
^DIC(9.4,60,22,13,"PAH",129,1,66,0)="only send data on Sundays. In addition to the fields listed above, the "
^DIC(9.4,60,22,13,"PAH",129,1,67,0)="patch also exports the following to enable the HL7 extracts:"
^DIC(9.4,60,22,13,"PAH",129,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,69,0)="OPTION:"
^DIC(9.4,60,22,13,"PAH",129,1,70,0)="   PSO AUTOQUEUE JOBS "
^DIC(9.4,60,22,13,"PAH",129,1,71,0)="   PSO TPB HL7 EXTRACT"
^DIC(9.4,60,22,13,"PAH",129,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,73,0)="PROTOCOL:"
^DIC(9.4,60,22,13,"PAH",129,1,74,0)="   PSO TPB EV "
^DIC(9.4,60,22,13,"PAH",129,1,75,0)="   PSO TPB SUB"
^DIC(9.4,60,22,13,"PAH",129,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,77,0)="HL7 APPLICATION PARAMETER:"
^DIC(9.4,60,22,13,"PAH",129,1,78,0)="   PSO TPB-AAC   "
^DIC(9.4,60,22,13,"PAH",129,1,79,0)="   PSO TPB-PHARM"
^DIC(9.4,60,22,13,"PAH",129,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,81,0)="HL LOGICAL LINK:"
^DIC(9.4,60,22,13,"PAH",129,1,82,0)="   PSOTPBAAC   "
^DIC(9.4,60,22,13,"PAH",129,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,85,0)="The TPB HL7 Data Extract/Transmission [PSO TPB HL7 EXTRACT] option has "
^DIC(9.4,60,22,13,"PAH",129,1,86,0)="been added to the jobs that can be requeued from the Queue Background "
^DIC(9.4,60,22,13,"PAH",129,1,87,0)="Jobs [PSO AUTOQUEUE JOBS] option."
^DIC(9.4,60,22,13,"PAH",129,1,88,0)="                                  "
^DIC(9.4,60,22,13,"PAH",129,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,90,0)="7. A new stand-alone option, PSO TPB RX ENTRY [TPB Rx (Prescription)"
^DIC(9.4,60,22,13,"PAH",129,1,91,0)="Entry], is being exported with this patch. This option will provide the"
^DIC(9.4,60,22,13,"PAH",129,1,92,0)="capability to enter TPB prescriptions for TPB eligible patients. Included"
^DIC(9.4,60,22,13,"PAH",129,1,93,0)="in this option will be the ability to enter/edit Provider Information, "
^DIC(9.4,60,22,13,"PAH",129,1,94,0)="and the ability to enter/edit Allergy information. Only patients eligible"
^DIC(9.4,60,22,13,"PAH",129,1,95,0)="for the TPB benefit will be selectable through this option. When entering"
^DIC(9.4,60,22,13,"PAH",129,1,96,0)="the prescription information, the RX Patient Status must be 'NON-VA', and"
^DIC(9.4,60,22,13,"PAH",129,1,97,0)="the Provider that is selected for the prescription must meet the following"
^DIC(9.4,60,22,13,"PAH",129,1,98,0)="2 criteria: the NON-VA PRESCRIBER field (#53.91) in the NEW PERSON file"
^DIC(9.4,60,22,13,"PAH",129,1,99,0)="(#200) must be set to 'Yes', and the ON EXCLUSIONARY LIST field (#53.95)"
^DIC(9.4,60,22,13,"PAH",129,1,100,0)="in the NEW PERSON file (#200) must be set to 'No'. Any prescription"
^DIC(9.4,60,22,13,"PAH",129,1,101,0)="entered, verified, or completed through this option will be flagged as a"
^DIC(9.4,60,22,13,"PAH",129,1,102,0)="TPB RX."
^DIC(9.4,60,22,13,"PAH",129,1,103,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,105,0)="8. When patients or prescriptions  are selected or presented in the "
^DIC(9.4,60,22,13,"PAH",129,1,106,0)="following options, and the patient is eligible for the TPB benefit, a "
^DIC(9.4,60,22,13,"PAH",129,1,107,0)="warning will be given that this patient is eligible for the Transitional "
^DIC(9.4,60,22,13,"PAH",129,1,108,0)="Pharmacy Benefit. This warning is given because any new order created "
^DIC(9.4,60,22,13,"PAH",129,1,109,0)="through these options for a patient eligible for the TPB benefit will not "
^DIC(9.4,60,22,13,"PAH",129,1,110,0)="be flagged as a TPB prescription, since the new option, PSO TPB RX ENTRY"
^DIC(9.4,60,22,13,"PAH",129,1,111,0)="[TPB Rx (Prescription) Entry] was not used:"
^DIC(9.4,60,22,13,"PAH",129,1,112,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,113,0)="Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",129,1,114,0)="Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",129,1,115,0)="Edit Prescriptions [PSO RXEDIT]"
^DIC(9.4,60,22,13,"PAH",129,1,116,0)="Barcode Batch Prescription Entry [PSO BATCH BARCODE]"
^DIC(9.4,60,22,13,"PAH",129,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,119,0)="9. Anytime a prescription is discontinued, a check will be done on that "
^DIC(9.4,60,22,13,"PAH",129,1,120,0)="prescription and patient. If the prescription is a TPB prescription, and "
^DIC(9.4,60,22,13,"PAH",129,1,121,0)="the patient is still eligible for the Transitional Pharmacy Benefit, and"
^DIC(9.4,60,22,13,"PAH",129,1,122,0)="that patient has no more active TPB prescriptions, then the INACTIVATION"
^DIC(9.4,60,22,13,"PAH",129,1,123,0)="OF BENEFIT DATE field (#2) of the TPB ELIGIBILITY file (#52.91) will"
^DIC(9.4,60,22,13,"PAH",129,1,124,0)="automatically be set to the current date, making that patient ineligible"
^DIC(9.4,60,22,13,"PAH",129,1,125,0)="for the benefit. Also, the INACTIVATION REASON CODE field (#3) of the TPB"
^DIC(9.4,60,22,13,"PAH",129,1,126,0)="ELIGIBILITY file (#52.91) will automatically be set to 'ALL RX'S "
^DIC(9.4,60,22,13,"PAH",129,1,127,0)="INACTIVE'."
^DIC(9.4,60,22,13,"PAH",129,1,128,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,129,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,130,0)="10. Anytime a patient is inactivated in the TPB ELIGIBILITY file "
^DIC(9.4,60,22,13,"PAH",129,1,131,0)="(#52.91), a check will be done on the default Rx Patient Status for that "
^DIC(9.4,60,22,13,"PAH",129,1,132,0)="patient on the PATIENT STATUS field (#3) of the PHARMACY PATIENT file "
^DIC(9.4,60,22,13,"PAH",129,1,133,0)="(#55), and if that Rx Patient Status is 'NON-VA', it will be set to null."
^DIC(9.4,60,22,13,"PAH",129,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,135,0)=" "
^DIC(9.4,60,22,13,"PAH",129,1,136,0)="11. When entering new prescriptions through either the Patient "
^DIC(9.4,60,22,13,"PAH",129,1,137,0)="Prescription Processing [PSO LM BACKDOOR ORDERS] or the Complete Orders "
^DIC(9.4,60,22,13,"PAH",129,1,138,0)="from OERR [PSO LMOE FINISH], the Rx Patient Status of 'NON-VA' will not "
^DIC(9.4,60,22,13,"PAH",129,1,139,0)="be selectable, since these orders cannot be flagged as TPB prescriptions."
^DIC(9.4,60,22,13,"PAH",130,0)="136 SEQ #134^3031002^1"
^DIC(9.4,60,22,13,"PAH",130,1,0)="^^20^20^3031002"
^DIC(9.4,60,22,13,"PAH",130,1,1,0)=" Problem: "
^DIC(9.4,60,22,13,"PAH",130,1,2,0)=" ========"
^DIC(9.4,60,22,13,"PAH",130,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",130,1,4,0)="   The Patient Merge process was not updating entries in the PRESCRIPTION "
^DIC(9.4,60,22,13,"PAH",130,1,5,0)="   file (#52) with the new patient's internal entry number (IEN)."
^DIC(9.4,60,22,13,"PAH",130,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",130,1,7,0)=" Solution:"
^DIC(9.4,60,22,13,"PAH",130,1,8,0)=" ========="
^DIC(9.4,60,22,13,"PAH",130,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",130,1,10,0)="   The Patient Merge patch XT*7.3*73 fixed this problem to appropriately"
^DIC(9.4,60,22,13,"PAH",130,1,11,0)="   update the PATIENT field (#2) in the PRESCRIPTION file (#52) for"
^DIC(9.4,60,22,13,"PAH",130,1,12,0)="   future patient merges. Patch PSO*7*136 has a environment check routine"
^DIC(9.4,60,22,13,"PAH",130,1,13,0)="   PSOPI136 to update this field with the correct patient's internal"
^DIC(9.4,60,22,13,"PAH",130,1,14,0)="   entry number (""merged to"").  At the completion of this job, a MailMan"
^DIC(9.4,60,22,13,"PAH",130,1,15,0)="   message with the subject ""PSO*7*136 PRESCRIPTION file (#52) - Patient"
^DIC(9.4,60,22,13,"PAH",130,1,16,0)="   Merge clean up"", will be sent to the installer notifying the start"
^DIC(9.4,60,22,13,"PAH",130,1,17,0)="   time and time of completion.  The message will provide a list of"
^DIC(9.4,60,22,13,"PAH",130,1,18,0)="   prescriptions with the corrected patient's internal entry number."
^DIC(9.4,60,22,13,"PAH",130,1,19,0)="   It will also list prescriptions that had the CPRS status adjusted to"
^DIC(9.4,60,22,13,"PAH",130,1,20,0)="   match the Pharmacy status."
^DIC(9.4,60,22,13,"PAH",131,0)="139 SEQ #135^3031002^1"
^DIC(9.4,60,22,13,"PAH",131,1,0)="^^189^189^3031002"
^DIC(9.4,60,22,13,"PAH",131,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,2,0)="1. BIR-0203-30502"
^DIC(9.4,60,22,13,"PAH",131,1,3,0)="   This NOIS call reported the following software error that happened"
^DIC(9.4,60,22,13,"PAH",131,1,4,0)="   with a FastFill machine:"
^DIC(9.4,60,22,13,"PAH",131,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,6,0)="   $ZE= ACK+2^PSOHLSG:1, %DSM-E-UNDEF, undefined variable HL(""APAT""),"
^DIC(9.4,60,22,13,"PAH",131,1,7,0)="        -DSM-I-ECODE, MUMPS error code: M6"
^DIC(9.4,60,22,13,"PAH",131,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,9,0)="   The routine was corrected to reinitialize the variable if it does not"
^DIC(9.4,60,22,13,"PAH",131,1,10,0)="   exist."
^DIC(9.4,60,22,13,"PAH",131,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,13,0)="2. CLA-0303-20198"
^DIC(9.4,60,22,13,"PAH",131,1,14,0)="   The Manual Auto Expire Rxs [PSO MANUAL AUTO EXPIRE] option was"
^DIC(9.4,60,22,13,"PAH",131,1,15,0)="   initially provided to synchronize the expired order status between"
^DIC(9.4,60,22,13,"PAH",131,1,16,0)="   Outpatient Pharmacy prescriptions and Computerized Patient Record"
^DIC(9.4,60,22,13,"PAH",131,1,17,0)="   System (CPRS) V. 1.0 order entries. And as such, the start date was set"
^DIC(9.4,60,22,13,"PAH",131,1,18,0)="   to the date Outpatient Pharmacy Version 7.0 was installed minus 120"
^DIC(9.4,60,22,13,"PAH",131,1,19,0)="   days. A few sites have reported that some of the very old"
^DIC(9.4,60,22,13,"PAH",131,1,20,0)="   prescriptions, specifically those that are 120 days prior to the date"
^DIC(9.4,60,22,13,"PAH",131,1,21,0)="   Outpatient Pharmacy Version 7.0 was installed, show an active status"
^DIC(9.4,60,22,13,"PAH",131,1,22,0)="   when viewed via FileMan. In order to scan the PRESCRIPTION file (#52)"
^DIC(9.4,60,22,13,"PAH",131,1,23,0)="   and flag such orders as expired, this option has been modified to"
^DIC(9.4,60,22,13,"PAH",131,1,24,0)="   provide the user the flexibility to select a start date and the default"
^DIC(9.4,60,22,13,"PAH",131,1,25,0)="   is set to the date Outpatient Pharmacy Version 7.0 was installed minus"
^DIC(9.4,60,22,13,"PAH",131,1,26,0)="   120 days."
^DIC(9.4,60,22,13,"PAH",131,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,28,0)="3. CLE-0303-42391"
^DIC(9.4,60,22,13,"PAH",131,1,29,0)="   This NOIS call reported that the PROVIDER COMMENTS field (#39) of the"
^DIC(9.4,60,22,13,"PAH",131,1,30,0)="   PRESCRIPTION file (#52) was being lost when a prescription was renewed"
^DIC(9.4,60,22,13,"PAH",131,1,31,0)="   from Outpatient Pharmacy. A correction was made to send the comments to"
^DIC(9.4,60,22,13,"PAH",131,1,32,0)="   CPRS when the prescription is renewed from Outpatient Pharmacy."
^DIC(9.4,60,22,13,"PAH",131,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,34,0)="4. ISB-0403-31630"
^DIC(9.4,60,22,13,"PAH",131,1,35,0)="   This NOIS call reported a problem in the display of Allergy severity"
^DIC(9.4,60,22,13,"PAH",131,1,36,0)="   in the Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",131,1,37,0)="   option, on the Detailed Allergy Display screen. The content of the"
^DIC(9.4,60,22,13,"PAH",131,1,38,0)="   field ""Severity:"" was limited to one, and only one, value. The possible"
^DIC(9.4,60,22,13,"PAH",131,1,39,0)="   values were: MILD, MODERATE or SEVERE. The first Severity on file was"
^DIC(9.4,60,22,13,"PAH",131,1,40,0)="   displayed. Since it is possible to have more than one Severity per"
^DIC(9.4,60,22,13,"PAH",131,1,41,0)="   Allergy, this display was changed to show all the Severities on file,"
^DIC(9.4,60,22,13,"PAH",131,1,42,0)="   along with the dates on which each one was observed. See example below:"
^DIC(9.4,60,22,13,"PAH",131,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,44,0)="        Before:     Severity: MODERATE"
^DIC(9.4,60,22,13,"PAH",131,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,46,0)="        Now:        Severity: 04/07/03 MODERATE"
^DIC(9.4,60,22,13,"PAH",131,1,47,0)="                              04/15/03 MILD"
^DIC(9.4,60,22,13,"PAH",131,1,48,0)="                              04/17/03 SEVERE"
^DIC(9.4,60,22,13,"PAH",131,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,50,0)="   Besides the changes to this display, the HL7 message for External"
^DIC(9.4,60,22,13,"PAH",131,1,51,0)="   Interfaces was also changed. The ZAL segment will have one for each"
^DIC(9.4,60,22,13,"PAH",131,1,52,0)="   severity observed. Before, it would have only one entry for the"
^DIC(9.4,60,22,13,"PAH",131,1,53,0)="   oldest severity observed. Furthermore, the date the severity was"
^DIC(9.4,60,22,13,"PAH",131,1,54,0)="   observed is being added as field #8 of this segment. From the same"
^DIC(9.4,60,22,13,"PAH",131,1,55,0)="   example from above, here is how the ZAL segment will look:"
^DIC(9.4,60,22,13,"PAH",131,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,57,0)="     Before:"
^DIC(9.4,60,22,13,"PAH",131,1,58,0)="      ZAL|530|NIACIN 100MG TAB |ALLERGY|DRUG|VERIFIED|MODERATE"
^DIC(9.4,60,22,13,"PAH",131,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,60,0)="     Now:"
^DIC(9.4,60,22,13,"PAH",131,1,61,0)="      ZAL|530|NIACIN 100MG TAB |ALLERGY|DRUG|VERIFIED|MODERATE|20030407|"
^DIC(9.4,60,22,13,"PAH",131,1,62,0)="      ZAL|530|NIACIN 100MG TAB |ALLERGY|DRUG|VERIFIED|MILD|20030415|"
^DIC(9.4,60,22,13,"PAH",131,1,63,0)="      ZAL|530|NIACIN 100MG TAB |ALLERGY|DRUG|VERIFIED|SEVERE|20030417|"
^DIC(9.4,60,22,13,"PAH",131,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,65,0)="5. ANN-0902-40951"
^DIC(9.4,60,22,13,"PAH",131,1,66,0)="   An undefined error was reported when using the Patient Prescription"
^DIC(9.4,60,22,13,"PAH",131,1,67,0)="   Processing [PSO LM BACKDOOR ORDERS] option. If the drug of an active"
^DIC(9.4,60,22,13,"PAH",131,1,68,0)="   order is edited, but the user quits without saving the changes and a"
^DIC(9.4,60,22,13,"PAH",131,1,69,0)="   new order for the same drug is placed immediately afterwards, the error"
^DIC(9.4,60,22,13,"PAH",131,1,70,0)="   could occur. This patch fixes this issue."
^DIC(9.4,60,22,13,"PAH",131,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,72,0)="6. LAS-0503-60830 & BRX-0603-11755"
^DIC(9.4,60,22,13,"PAH",131,1,73,0)="   The ""NTE|2|"" segment in the HL7 message generated for external"
^DIC(9.4,60,22,13,"PAH",131,1,74,0)="   interfaces is composed by the concatenation of the following Freetext"
^DIC(9.4,60,22,13,"PAH",131,1,75,0)="   fields from the OUTPATIENT SITE file (#59) in this order:"
^DIC(9.4,60,22,13,"PAH",131,1,76,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,77,0)="       Field #   Name"
^DIC(9.4,60,22,13,"PAH",131,1,78,0)="       ------------------------------------------"
^DIC(9.4,60,22,13,"PAH",131,1,79,0)="       1005      NARRATIVE FOR REFILLABLE RX"
^DIC(9.4,60,22,13,"PAH",131,1,80,0)="       1006      NARRATIVE FOR NON-REFILLABLE RX"
^DIC(9.4,60,22,13,"PAH",131,1,81,0)="       1004      NARRATIVE FOR COPAY DOCUMENT"
^DIC(9.4,60,22,13,"PAH",131,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,83,0)="   When building this segment, the routine PSOHLSG2 was skipping one line"
^DIC(9.4,60,22,13,"PAH",131,1,84,0)="   between the content of each field. This line is being interpreted by"
^DIC(9.4,60,22,13,"PAH",131,1,85,0)="   some external interfaces, such as Optifill, as the end of the ""NTE|2|"""
^DIC(9.4,60,22,13,"PAH",131,1,86,0)="   segment, because all it contains is a carriage return character. This"
^DIC(9.4,60,22,13,"PAH",131,1,87,0)="   caused the external interface to reject messages with only a carriage"
^DIC(9.4,60,22,13,"PAH",131,1,88,0)="   return in the line. To solve this problem a blank space will be"
^DIC(9.4,60,22,13,"PAH",131,1,89,0)="   inserted between the content of each field. In the example below, the"
^DIC(9.4,60,22,13,"PAH",131,1,90,0)="   blank space will be added where the arrow (""->"") is pointing."
^DIC(9.4,60,22,13,"PAH",131,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,92,0)="        :"
^DIC(9.4,60,22,13,"PAH",131,1,93,0)="       NTE|2|"
^DIC(9.4,60,22,13,"PAH",131,1,94,0)="       Call in your refill on your touch-tone phone."
^DIC(9.4,60,22,13,"PAH",131,1,95,0)="       Outside the metropolitan area: 1-800-123-4567."
^DIC(9.4,60,22,13,"PAH",131,1,96,0)="     ->"
^DIC(9.4,60,22,13,"PAH",131,1,97,0)="       The copay required is $7.00 for every 30 day or less supply of"
^DIC(9.4,60,22,13,"PAH",131,1,98,0)="       medication or $21.00 for a 90-day supply. Be sure to indicate your"
^DIC(9.4,60,22,13,"PAH",131,1,99,0)="       complete SSN on your check."
^DIC(9.4,60,22,13,"PAH",131,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,101,0)="       NTE|3|"
^DIC(9.4,60,22,13,"PAH",131,1,102,0)="        :"
^DIC(9.4,60,22,13,"PAH",131,1,103,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,104,0)="7. WIM-0603-20338"
^DIC(9.4,60,22,13,"PAH",131,1,105,0)="   The Print from Suspense File [PSO PNDLBL] option allows an user"
^DIC(9.4,60,22,13,"PAH",131,1,106,0)="   to queue the printing of the labels at a later time by Taskman. A"
^DIC(9.4,60,22,13,"PAH",131,1,107,0)="   problem was found when the original task was re-queued through the"
^DIC(9.4,60,22,13,"PAH",131,1,108,0)="   Taskman Requeue Tasks [XUTM REQ] option by a different user. Once"
^DIC(9.4,60,22,13,"PAH",131,1,109,0)="   the labels printed, the label print activity log for the prescription"
^DIC(9.4,60,22,13,"PAH",131,1,110,0)="   was recorded as being performed by the second user, the one who"
^DIC(9.4,60,22,13,"PAH",131,1,111,0)="   re-queued the Taskman task, which is wrong. This patch makes the"
^DIC(9.4,60,22,13,"PAH",131,1,112,0)="   correction to keep the user who queued the label print through the"
^DIC(9.4,60,22,13,"PAH",131,1,113,0)="   Print from Suspense File [PSO PNDLBL] option in the label print"
^DIC(9.4,60,22,13,"PAH",131,1,114,0)="   activity log."
^DIC(9.4,60,22,13,"PAH",131,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,116,0)="8. MAC-0603-60315"
^DIC(9.4,60,22,13,"PAH",131,1,117,0)="   Patch PSO*7*124 introduced the following change:"
^DIC(9.4,60,22,13,"PAH",131,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,119,0)="         Currently, if a non-controlled substance prescription is entered"
^DIC(9.4,60,22,13,"PAH",131,1,120,0)="         with a day supply less than 5 days and there are no refills, the"
^DIC(9.4,60,22,13,"PAH",131,1,121,0)="         expiration date defaults to 5 days from the issue date. If a"
^DIC(9.4,60,22,13,"PAH",131,1,122,0)="         controlled substance prescription is entered with a day supply"
^DIC(9.4,60,22,13,"PAH",131,1,123,0)="         less than 5 days without refills, the expiration date is the"
^DIC(9.4,60,22,13,"PAH",131,1,124,0)="         Issue Date plus the Days Supply. The primary problem is that"
^DIC(9.4,60,22,13,"PAH",131,1,125,0)="         when these prescriptions were being transmitted to the CMOPs and"
^DIC(9.4,60,22,13,"PAH",131,1,126,0)="         they were behind on dispensing, the prescriptions were being"
^DIC(9.4,60,22,13,"PAH",131,1,127,0)="         rejected because the prescriptions had already expired. The"
^DIC(9.4,60,22,13,"PAH",131,1,128,0)="         default of 5 is being changed to 30 to accommodate the CMOPs and"
^DIC(9.4,60,22,13,"PAH",131,1,129,0)="         to allow the patients to receive their medications in a timely"
^DIC(9.4,60,22,13,"PAH",131,1,130,0)="         manner. Prescriptions will no longer expire before 30 days"
^DIC(9.4,60,22,13,"PAH",131,1,131,0)="         elapses from the Issue Date when the day supply is less than 30"
^DIC(9.4,60,22,13,"PAH",131,1,132,0)="         days and there are no refills.  If a minimum of 1 refill is"
^DIC(9.4,60,22,13,"PAH",131,1,133,0)="         entered the one year/six month rule still applies."
^DIC(9.4,60,22,13,"PAH",131,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,135,0)="   This created a problem for some sites with a rehab unit where some"
^DIC(9.4,60,22,13,"PAH",131,1,136,0)="   patients go out on Authorized Absence every weekend. The site then"
^DIC(9.4,60,22,13,"PAH",131,1,137,0)="   enters a prescription with a patient status of AUTHORIZED ABSENCE and"
^DIC(9.4,60,22,13,"PAH",131,1,138,0)="   no refills and a small number for days supply (3 or 4 days). Before,"
^DIC(9.4,60,22,13,"PAH",131,1,139,0)="   such prescriptions expired within 5 days from the issue date and no"
^DIC(9.4,60,22,13,"PAH",131,1,140,0)="   longer showed on the Medication Profile screen. Now, after PSO*7*124"
^DIC(9.4,60,22,13,"PAH",131,1,141,0)="   was installed, such prescriptions remain active for at least 30 days."
^DIC(9.4,60,22,13,"PAH",131,1,142,0)="   The result is that multiple prescriptions for a single drug are listed"
^DIC(9.4,60,22,13,"PAH",131,1,143,0)="   in the Medication Profile screen. Active prescriptions with a patient"
^DIC(9.4,60,22,13,"PAH",131,1,144,0)="   status of AUTHORIZED ABSENCE can contain the same drug already in"
^DIC(9.4,60,22,13,"PAH",131,1,145,0)="   another active prescription for the same patient."
^DIC(9.4,60,22,13,"PAH",131,1,146,0)="   Once this patch is installed, prescriptions with a patient status of"
^DIC(9.4,60,22,13,"PAH",131,1,147,0)="   AUTHORIZED ABSENCE and no refills will have the expiration date"
^DIC(9.4,60,22,13,"PAH",131,1,148,0)="   calculation reversed to a minimum of 5 days from the issue date,"
^DIC(9.4,60,22,13,"PAH",131,1,149,0)="   instead of the 30 days introduced by patch PSO*7*124."
^DIC(9.4,60,22,13,"PAH",131,1,150,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,151,0)="9. PUG-0603-50491"
^DIC(9.4,60,22,13,"PAH",131,1,152,0)="   This NOIS call reported a problem with the patient security check for"
^DIC(9.4,60,22,13,"PAH",131,1,153,0)="   the Complete Orders from OERR [PSO LMOE FINISH] option. An example of"
^DIC(9.4,60,22,13,"PAH",131,1,154,0)="   a patient security check is when an employee tries to get access to"
^DIC(9.4,60,22,13,"PAH",131,1,155,0)="   his own medical record and is denied. In the case of the menu option"
^DIC(9.4,60,22,13,"PAH",131,1,156,0)="   mentioned above, such security checks were not being performed when"
^DIC(9.4,60,22,13,"PAH",131,1,157,0)="   the user selected to process ALL the patients with pending orders."
^DIC(9.4,60,22,13,"PAH",131,1,158,0)="   Also, when processing by clinic, route or priority, there were no"
^DIC(9.4,60,22,13,"PAH",131,1,159,0)="   security checks performed. The only time the security checks were"
^DIC(9.4,60,22,13,"PAH",131,1,160,0)="   performed was when the user selected to process a single patient."
^DIC(9.4,60,22,13,"PAH",131,1,161,0)="   When this patch is installed, this problem will be resolved and the"
^DIC(9.4,60,22,13,"PAH",131,1,162,0)="   Complete Orders from OERR [PSO LMOE FINISH] option will perform the"
^DIC(9.4,60,22,13,"PAH",131,1,163,0)="   security checks consistently for all the possible selections when"
^DIC(9.4,60,22,13,"PAH",131,1,164,0)="   finishing pending orders."
^DIC(9.4,60,22,13,"PAH",131,1,165,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,166,0)="10. CON-0703-11685, MAR-0703-21567 & SBY-0703-31538"
^DIC(9.4,60,22,13,"PAH",131,1,167,0)="    When trying to reinstate discontinued prescriptions for a patient that"
^DIC(9.4,60,22,13,"PAH",131,1,168,0)="    had the DATE OF DEATH field (#.351) in the PATIENT file (#2) entered"
^DIC(9.4,60,22,13,"PAH",131,1,169,0)="    and then deleted, the user was getting an ""Undefined variable DA"""
^DIC(9.4,60,22,13,"PAH",131,1,170,0)="    error. This problem was introduced by patch PSO*7*117, more"
^DIC(9.4,60,22,13,"PAH",131,1,171,0)="    specifically by the changes described in item #2b which was made to"
^DIC(9.4,60,22,13,"PAH",131,1,172,0)="    address NOIS call CAH-0402-31866. This patch corrects the problem"
^DIC(9.4,60,22,13,"PAH",131,1,173,0)="    with the use of that variable."
^DIC(9.4,60,22,13,"PAH",131,1,174,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,175,0)="11. MIN-1202-40079, FRE-0303-60233 & RIC-0603-21344"
^DIC(9.4,60,22,13,"PAH",131,1,176,0)="    In some situations where a patient is being accessed by Inpatient"
^DIC(9.4,60,22,13,"PAH",131,1,177,0)="    Pharmacy Version 5.0, if an attempt is made to finish orders in"
^DIC(9.4,60,22,13,"PAH",131,1,178,0)="    Outpatient Pharmacy Version 7.0, a message is received that the"
^DIC(9.4,60,22,13,"PAH",131,1,179,0)="    patient is in use. Then if an ""^"" is entered for the PATIENT STATUS"
^DIC(9.4,60,22,13,"PAH",131,1,180,0)="    prompt, the cross-reference entries in the PHARMACY PATIENT file (#55)"
^DIC(9.4,60,22,13,"PAH",131,1,181,0)="    could be deleted for that patient. This patch corrects the problem.  A"
^DIC(9.4,60,22,13,"PAH",131,1,182,0)="    follow-up patch will provide a clean up to rebuild missing"
^DIC(9.4,60,22,13,"PAH",131,1,183,0)="    cross-references."
^DIC(9.4,60,22,13,"PAH",131,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",131,1,185,0)="12. HUN-0603-21419 & WPB-0803-30273"
^DIC(9.4,60,22,13,"PAH",131,1,186,0)="    There has been some instances where a prescription from one patient"
^DIC(9.4,60,22,13,"PAH",131,1,187,0)="    was being displayed on the Bingo Board for a different patient. This"
^DIC(9.4,60,22,13,"PAH",131,1,188,0)="    patch kills a variable that could accidentally get carried over    "
^DIC(9.4,60,22,13,"PAH",131,1,189,0)="    between patients."
^DIC(9.4,60,22,13,"PAH",132,0)="125 SEQ #136^3031023^1"
^DIC(9.4,60,22,13,"PAH",132,1,0)="^^9^9^3031023"
^DIC(9.4,60,22,13,"PAH",132,1,1,0)="1. If pre-Pharmacy Ordering Enhancements prescriptions are renewed or"
^DIC(9.4,60,22,13,"PAH",132,1,2,0)="edited to create a new prescription, the resulting prescription may have a"
^DIC(9.4,60,22,13,"PAH",132,1,3,0)="missing SIG. This patch corrects the problem for edited prescriptions."
^DIC(9.4,60,22,13,"PAH",132,1,4,0)="Other Pharmacy V. 7.0 patches have made the correction for renewals."
^DIC(9.4,60,22,13,"PAH",132,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",132,1,6,0)="2. This patch also corrects a null subscript error that happens if the"
^DIC(9.4,60,22,13,"PAH",132,1,7,0)="full patient name is entered in the Bingo Board User [PSO BINGO USER]"
^DIC(9.4,60,22,13,"PAH",132,1,8,0)="option."
^DIC(9.4,60,22,13,"PAH",132,1,9,0)="NOIS - SBY-0803-31924"
^DIC(9.4,60,22,13,"PAH",133,0)="141 SEQ #137^3031107^1"
^DIC(9.4,60,22,13,"PAH",133,1,0)="^^53^53^3031107"
^DIC(9.4,60,22,13,"PAH",133,1,1,0)="1. A site reported a problem with printing labels with long SIGs. If "
^DIC(9.4,60,22,13,"PAH",133,1,2,0)="there were no spaces in the SIG, the label print would get into an "
^DIC(9.4,60,22,13,"PAH",133,1,3,0)="infinite loop. This patch corrects this problem by making the SIG print "
^DIC(9.4,60,22,13,"PAH",133,1,4,0)="break on spaces and commas. If there are no spaces and no commas, the SIG "
^DIC(9.4,60,22,13,"PAH",133,1,5,0)="print will break on a character basis. "
^DIC(9.4,60,22,13,"PAH",133,1,6,0)="NOIS: SAM-0703-21864, SAM-0703-21873, IND-0703-41198, FAV-0603-70287, "
^DIC(9.4,60,22,13,"PAH",133,1,7,0)="MUS-0603-70207, SBY-0503-32205, CTX-0803-71468"
^DIC(9.4,60,22,13,"PAH",133,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,9,0)="2. A site reported a problem when printing multiple copies of labels that "
^DIC(9.4,60,22,13,"PAH",133,1,10,0)="contained SIG instructions that ran over one label. On the 2-n copies, "
^DIC(9.4,60,22,13,"PAH",133,1,11,0)="not all of the SIG printed correctly. This patch corrects this problem by "
^DIC(9.4,60,22,13,"PAH",133,1,12,0)="appropriately printing all of the SIG information on all copies."
^DIC(9.4,60,22,13,"PAH",133,1,13,0)="NOIS: MON-0703-50217, MAD-0603-41794, SPO-0603-50792, MAC-0803-60872"
^DIC(9.4,60,22,13,"PAH",133,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,15,0)="3. A site reported a problem that long mailing addresses were being "
^DIC(9.4,60,22,13,"PAH",133,1,16,0)="truncated on the mailing label. This patch corrects this problem by "
^DIC(9.4,60,22,13,"PAH",133,1,17,0)="adjusting the font size lower until the entire address will print. "
^DIC(9.4,60,22,13,"PAH",133,1,18,0)="NOIS: NIN-0803-40514"
^DIC(9.4,60,22,13,"PAH",133,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,20,0)="4. A site reported a problem with a long drug name overflowing onto the "
^DIC(9.4,60,22,13,"PAH",133,1,21,0)="warning label section. This patch corrects this problem by adjusting the "
^DIC(9.4,60,22,13,"PAH",133,1,22,0)="font size down until the drug name fits on the bottle label. In addition, "
^DIC(9.4,60,22,13,"PAH",133,1,23,0)="a utility is included to build the information into the TERMINAL TYPE "
^DIC(9.4,60,22,13,"PAH",133,1,24,0)="file (#3.2) for bolding the drug name at different fonts. Once the patch"
^DIC(9.4,60,22,13,"PAH",133,1,25,0)="is installed, run the routine PSOLLU3 in programmer mode. Once you have"
^DIC(9.4,60,22,13,"PAH",133,1,26,0)="updated all current laser label devices, the routine may be deleted."
^DIC(9.4,60,22,13,"PAH",133,1,27,0)="NOIS: TOM-0503-41452 "
^DIC(9.4,60,22,13,"PAH",133,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,29,0)="5. A site reported a problem with receiving an error if there was a TAB "
^DIC(9.4,60,22,13,"PAH",133,1,30,0)="character in the SIG text. This patch corrects this problem by handling "
^DIC(9.4,60,22,13,"PAH",133,1,31,0)="the entry of non-visible characters. NOIS: BRX-0703-12341, "
^DIC(9.4,60,22,13,"PAH",133,1,32,0)="WPB-0703-32079, SBY-0703-30153"
^DIC(9.4,60,22,13,"PAH",133,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,34,0)="6. A site reported a problem with the printing of the Method of Pickup "
^DIC(9.4,60,22,13,"PAH",133,1,35,0)="information. It was being truncated if it was over about 20 characters. "
^DIC(9.4,60,22,13,"PAH",133,1,36,0)="This patch corrects this problem by adjusting the font and allowing this "
^DIC(9.4,60,22,13,"PAH",133,1,37,0)="information to print on multiple lines. NOIS: ANN-0503-42213 "
^DIC(9.4,60,22,13,"PAH",133,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,39,0)="7. A problem was discovered with printing the narrative information on "
^DIC(9.4,60,22,13,"PAH",133,1,40,0)="the label. Under certain conditions, the text would not wrap correctly. "
^DIC(9.4,60,22,13,"PAH",133,1,41,0)="This patch corrects this problem by wrapping on the character size if the "
^DIC(9.4,60,22,13,"PAH",133,1,42,0)="text between spaces is too long for the allocated area on the label."
^DIC(9.4,60,22,13,"PAH",133,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,44,0)="8. A site reported a problem with adjusting the left margin of the laser "
^DIC(9.4,60,22,13,"PAH",133,1,45,0)="label print. The 'Qty' header wouldn't properly adjust. This patch "
^DIC(9.4,60,22,13,"PAH",133,1,46,0)="corrects this problem by adding the ability to move the line that prints "
^DIC(9.4,60,22,13,"PAH",133,1,47,0)="quantity information. NOIS: IRO-0503-40327"
^DIC(9.4,60,22,13,"PAH",133,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",133,1,49,0)="9. A site reported a problem of no physician name or an incorrect name "
^DIC(9.4,60,22,13,"PAH",133,1,50,0)="printing on the bottle label. This happened if the SIG was too long to "
^DIC(9.4,60,22,13,"PAH",133,1,51,0)="fit on the bottle label, but was not too long to fit on the filling "
^DIC(9.4,60,22,13,"PAH",133,1,52,0)="document. This patch corrects the problem. NOIS: SHR-0703-72297, "
^DIC(9.4,60,22,13,"PAH",133,1,53,0)="CLL-0803-41010"
^DIC(9.4,60,22,13,"PAH",134,0)="135 SEQ #138^3031121^1"
^DIC(9.4,60,22,13,"PAH",134,1,0)="^^31^31^3031121"
^DIC(9.4,60,22,13,"PAH",134,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",134,1,2,0)="This patch contains routines, new options, new Data Dictionary fields, and"
^DIC(9.4,60,22,13,"PAH",134,1,3,0)="documentation for implementing the ScripTalk(R) 'talking' prescription"
^DIC(9.4,60,22,13,"PAH",134,1,4,0)="labels functionality, which will greatly benefit visually impaired"
^DIC(9.4,60,22,13,"PAH",134,1,5,0)="veterans."
^DIC(9.4,60,22,13,"PAH",134,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",134,1,7,0)="Thanks to Rob Silverman at Hines for his extensive research and"
^DIC(9.4,60,22,13,"PAH",134,1,8,0)="development work for a class III solution, upon which this patch is based."
^DIC(9.4,60,22,13,"PAH",134,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",134,1,10,0)="ScripTalk(R) Talking Prescriptions will provide the ability for VA points"
^DIC(9.4,60,22,13,"PAH",134,1,11,0)="of care to purchase and distribute adaptive equipment to patients who are"
^DIC(9.4,60,22,13,"PAH",134,1,12,0)="unable to read the traditional label on prescription bottles. This patch "
^DIC(9.4,60,22,13,"PAH",134,1,13,0)="provides a way to print to a microchip-embedded label that can be applied "
^DIC(9.4,60,22,13,"PAH",134,1,14,0)="to a medication bottle. When the label is held next to a ScripTalk(R) "
^DIC(9.4,60,22,13,"PAH",134,1,15,0)="reader, the reader will read the contents of the label aloud to the "
^DIC(9.4,60,22,13,"PAH",134,1,16,0)="patient. This improves patient safety for patients with substantial loss "
^DIC(9.4,60,22,13,"PAH",134,1,17,0)="of vision as it allows them to safely determine the contents and "
^DIC(9.4,60,22,13,"PAH",134,1,18,0)="administration schedules of their medications."
^DIC(9.4,60,22,13,"PAH",134,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",134,1,20,0)="ScripTalk(R) is a registered trademark of En-Vision America."
^DIC(9.4,60,22,13,"PAH",134,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",134,1,22,0)="In addition to the ScripTalk changes, this patch corrects some laser"
^DIC(9.4,60,22,13,"PAH",134,1,23,0)="labels formatting problems in the warning label and method of pick-up"
^DIC(9.4,60,22,13,"PAH",134,1,24,0)="sections. "
^DIC(9.4,60,22,13,"PAH",134,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",134,1,26,0)="NOTE: As part of the laser labels corrections, the utility routine that "
^DIC(9.4,60,22,13,"PAH",134,1,27,0)="was used in patch PSO*7*141 has been modified. A correction for the return"
^DIC(9.4,60,22,13,"PAH",134,1,28,0)="mail initialization control code in the TERMINAL TYPE file (#3.2) has been"
^DIC(9.4,60,22,13,"PAH",134,1,29,0)="added. Once the patch is installed, run the routine PSOLLU3 in programmer"
^DIC(9.4,60,22,13,"PAH",134,1,30,0)="mode. Once you have updated all current laser label devices, the routine"
^DIC(9.4,60,22,13,"PAH",134,1,31,0)="may be deleted."
^DIC(9.4,60,22,13,"PAH",135,0)="153 SEQ #139^3031231^1"
^DIC(9.4,60,22,13,"PAH",135,1,0)="^^78^78^3031231"
^DIC(9.4,60,22,13,"PAH",135,1,1,0)="1. A new code has been added to the INACTIVATION REASON CODE field (#3)"
^DIC(9.4,60,22,13,"PAH",135,1,2,0)="of the TPB ELIGIBILITY file (#52.91). The code is PATIENT UNREACHABLE."
^DIC(9.4,60,22,13,"PAH",135,1,3,0)="This code will now be selectable when manually inactivating a patient"
^DIC(9.4,60,22,13,"PAH",135,1,4,0)="from the TPB ELIGIBILITY file (#52.91). It will also display, when"
^DIC(9.4,60,22,13,"PAH",135,1,5,0)="appropriate, on the reports generated by the Report TPB Patients Letters"
^DIC(9.4,60,22,13,"PAH",135,1,6,0)="Printed/NOT Printed [PSO TPB LETTERS PRINTED REPORT] option, and the TPB"
^DIC(9.4,60,22,13,"PAH",135,1,7,0)="Patient Report [PSO TPB PATIENT REPORT] option."
^DIC(9.4,60,22,13,"PAH",135,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,9,0)="2. Every Sunday, Transitional Pharmacy Benefit (TPB) patient data is sent"
^DIC(9.4,60,22,13,"PAH",135,1,10,0)="in an HL7 message to Austin. This patch exports a new mail group, PSO TPB"
^DIC(9.4,60,22,13,"PAH",135,1,11,0)="HL7 EXTRACT. Members of this mail group will receive weekly mail messages"
^DIC(9.4,60,22,13,"PAH",135,1,12,0)="concerning the HL7 extract of TPB patient information. These messages"
^DIC(9.4,60,22,13,"PAH",135,1,13,0)="will either display information that the message generation was"
^DIC(9.4,60,22,13,"PAH",135,1,14,0)="successful, or display information that the message generation was"
^DIC(9.4,60,22,13,"PAH",135,1,15,0)="unsuccessful, along with a reason why it was unsuccessful. Upon install,"
^DIC(9.4,60,22,13,"PAH",135,1,16,0)="the installer will be prompted for the coordinator of the mail group. The"
^DIC(9.4,60,22,13,"PAH",135,1,17,0)="Post-Install routine of this patch will automatically add the patch"
^DIC(9.4,60,22,13,"PAH",135,1,18,0)="installer as a member of the mail group."
^DIC(9.4,60,22,13,"PAH",135,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,20,0)="The Post-Install routine PSO153PS will also set the AUTOSTART field (#4.5)"
^DIC(9.4,60,22,13,"PAH",135,1,21,0)="of the HL LOGICAL LINK file (#870) of the PSOTPBAAC HL Logical Link to"
^DIC(9.4,60,22,13,"PAH",135,1,22,0)="""Enabled""."
^DIC(9.4,60,22,13,"PAH",135,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,24,0)="A correction has been made to the HL7 message to distinguish between"
^DIC(9.4,60,22,13,"PAH",135,1,25,0)="a new record and an edited record."
^DIC(9.4,60,22,13,"PAH",135,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,27,0)="3. The weekly HL7 transmission to Austin is found to cause problems at few"
^DIC(9.4,60,22,13,"PAH",135,1,28,0)="sites due to some bad ""AX"" cross-references of the TPB ELIGIBILITY file"
^DIC(9.4,60,22,13,"PAH",135,1,29,0)="(#52.91). This patch fixes this issue."
^DIC(9.4,60,22,13,"PAH",135,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,31,0)="4. There is a possibility of getting a null subscript error when using the"
^DIC(9.4,60,22,13,"PAH",135,1,32,0)="View Provider [PSO PROVIDER INQUIRE] option to view the provider details"
^DIC(9.4,60,22,13,"PAH",135,1,33,0)="after either of the following circumstances:"
^DIC(9.4,60,22,13,"PAH",135,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,35,0)="a. When a new provider was added using the Add New Providers [PSO PROVIDER"
^DIC(9.4,60,22,13,"PAH",135,1,36,0)="   ADD] option, and ""No"" was the response to the NON-VA PRESCRIBER field"
^DIC(9.4,60,22,13,"PAH",135,1,37,0)="   (#53.91) of NEW PERSON file (#200)."
^DIC(9.4,60,22,13,"PAH",135,1,38,0)="b. When a Provider was edited using the Edit Provider [PSO PROVIDER EDIT]"
^DIC(9.4,60,22,13,"PAH",135,1,39,0)="   option, and ""No"" was the response to the NON-VA PRESCRIBER field"
^DIC(9.4,60,22,13,"PAH",135,1,40,0)="   (#53.91) of NEW PERSON file (#200), and then an ""^"" was entered prior"
^DIC(9.4,60,22,13,"PAH",135,1,41,0)="   to responding to the prompts for these fields of the NEW PERSON file"
^DIC(9.4,60,22,13,"PAH",135,1,42,0)="   (#200):"
^DIC(9.4,60,22,13,"PAH",135,1,43,0)="   TAX ID field (#53.92)"
^DIC(9.4,60,22,13,"PAH",135,1,44,0)="   EXCLUSIONARY CHECK PERFORMED field (#53.93)"
^DIC(9.4,60,22,13,"PAH",135,1,45,0)="   DATE EXCLUSIONARY LIST CHECKED field (#53.94)"
^DIC(9.4,60,22,13,"PAH",135,1,46,0)="   ON EXCLUSIONARY LIST field  (#53.95)"
^DIC(9.4,60,22,13,"PAH",135,1,47,0)="   EXCLUSIONARY CHECKED BY field (#53.96)"
^DIC(9.4,60,22,13,"PAH",135,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,49,0)="This patch corrects the error."
^DIC(9.4,60,22,13,"PAH",135,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,51,0)="5. When selecting a provider using the TPB Rx (Prescription) Entry [PSO"
^DIC(9.4,60,22,13,"PAH",135,1,52,0)="TPB RXENTRY] option, if the provider is unauthorized to write med orders"
^DIC(9.4,60,22,13,"PAH",135,1,53,0)="or flagged as inactive, there are currently no alerts or warnings"
^DIC(9.4,60,22,13,"PAH",135,1,54,0)="indicating that the provider cannot be selected. This patch will provide"
^DIC(9.4,60,22,13,"PAH",135,1,55,0)="one of the following messages during provider selection if such conditions"
^DIC(9.4,60,22,13,"PAH",135,1,56,0)="are encountered:"
^DIC(9.4,60,22,13,"PAH",135,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,58,0)="a. This Provider is not Authorized to Write Med Orders. Use the Edit"
^DIC(9.4,60,22,13,"PAH",135,1,59,0)="   Provider [PSO PROVIDER EDIT] option to change the Authorization flag."
^DIC(9.4,60,22,13,"PAH",135,1,60,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,61,0)="b. This Provider is flagged as Inactive. Use the Edit Provider"
^DIC(9.4,60,22,13,"PAH",135,1,62,0)="   [PSO PROVIDER EDIT] option to change the Inactive Date."
^DIC(9.4,60,22,13,"PAH",135,1,63,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,64,0)="c. This Provider is not Authorized to Write Med Orders and flagged as"
^DIC(9.4,60,22,13,"PAH",135,1,65,0)="   Inactive. Use the Edit Provider [PSO PROVIDER EDIT] option to change"
^DIC(9.4,60,22,13,"PAH",135,1,66,0)="   them."
^DIC(9.4,60,22,13,"PAH",135,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,68,0)="6. The FAX NUMBER field (#.136) of the NEW PERSON file (#200) has been"
^DIC(9.4,60,22,13,"PAH",135,1,69,0)="added to the following options, for display and for editing:"
^DIC(9.4,60,22,13,"PAH",135,1,70,0)="Add New Providers [PSO PROVIDER ADD] option"
^DIC(9.4,60,22,13,"PAH",135,1,71,0)="Edit Provider [PSO PROVIDER EDIT] option"
^DIC(9.4,60,22,13,"PAH",135,1,72,0)="View Provider [PSO PROVIDER INQUIRE] option"
^DIC(9.4,60,22,13,"PAH",135,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,74,0)="This enhancement is requested by E3R 18457."
^DIC(9.4,60,22,13,"PAH",135,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",135,1,76,0)="7. This patch provides an API to the Scheduling V. 5.3 package that"
^DIC(9.4,60,22,13,"PAH",135,1,77,0)="returns a list of all patients eligible for the TPB, to be used for"
^DIC(9.4,60,22,13,"PAH",135,1,78,0)="reporting purposes."
^DIC(9.4,60,22,13,"PAH",136,0)="151 SEQ #140^3031231^1"
^DIC(9.4,60,22,13,"PAH",136,1,0)="^^25^25^3031231"
^DIC(9.4,60,22,13,"PAH",136,1,1,0)="1.  Currently, the HealtheVet system invokes the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",136,1,2,0)="V. 7.0 application to order a prescription refill and to check the status"
^DIC(9.4,60,22,13,"PAH",136,1,3,0)="of the prescription refill process. The required input parameters include"
^DIC(9.4,60,22,13,"PAH",136,1,4,0)="Integration Control Number (ICN), Social Security Number (SSN), and"
^DIC(9.4,60,22,13,"PAH",136,1,5,0)="Prescription number (Rx #). This has caused a duplication in functionality"
^DIC(9.4,60,22,13,"PAH",136,1,6,0)="and slow response time. To help speed up the process, a minor enhancement"
^DIC(9.4,60,22,13,"PAH",136,1,7,0)="has been requested that will eliminate the use of ICN and remove the cross"
^DIC(9.4,60,22,13,"PAH",136,1,8,0)="checking of SSN because the HealtheVet system itself verifies the accuracy"
^DIC(9.4,60,22,13,"PAH",136,1,9,0)="of the SSN and supplies the patient number. This patch would provide this"
^DIC(9.4,60,22,13,"PAH",136,1,10,0)="enhancement."
^DIC(9.4,60,22,13,"PAH",136,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",136,1,12,0)="Furthermore, besides the information that Outpatient Pharmacy V. 7.0 "
^DIC(9.4,60,22,13,"PAH",136,1,13,0)="currently returns to the HealtheVet system, it is also requested that two"
^DIC(9.4,60,22,13,"PAH",136,1,14,0)="new fields be made available to them: Outpatient Pharmacy Division and"
^DIC(9.4,60,22,13,"PAH",136,1,15,0)="Prescription Refill Status. This patch provides this information in the"
^DIC(9.4,60,22,13,"PAH",136,1,16,0)="requested format."
^DIC(9.4,60,22,13,"PAH",136,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",136,1,18,0)="2. The HealtheVet team has requested an additional Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",136,1,19,0)="V. 7.0 Application Program Interface (API) to provide Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",136,1,20,0)="division information. The information requested is Inactive Status,"
^DIC(9.4,60,22,13,"PAH",136,1,21,0)="Division Name, Area Code, Phone Number, and Refill Narrative Text. This"
^DIC(9.4,60,22,13,"PAH",136,1,22,0)="patch makes the required information available."
^DIC(9.4,60,22,13,"PAH",136,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",136,1,24,0)="Note: Sites installing this patch will not notice any changes unless they"
^DIC(9.4,60,22,13,"PAH",136,1,25,0)="are using the HealtheVet Internet Prescription Refill system."
^DIC(9.4,60,22,13,"PAH",137,0)="158 SEQ #141^3040131^1"
^DIC(9.4,60,22,13,"PAH",137,1,0)="^^22^22^3040131"
^DIC(9.4,60,22,13,"PAH",137,1,1,0)="Since the release of patch PSO*7*146, Transitional Pharmacy Benefits "
^DIC(9.4,60,22,13,"PAH",137,1,2,0)="(TPB), there has been an increase in the number of prescriptions which "
^DIC(9.4,60,22,13,"PAH",137,1,3,0)="have a pharmacy patient status of Non-VA. Pharmacy's current AMIS Report "
^DIC(9.4,60,22,13,"PAH",137,1,4,0)="option [PSO AMIS] and Daily AMIS Report option [PSO DAILY AMIS] do not "
^DIC(9.4,60,22,13,"PAH",137,1,5,0)="include Non-VA prescriptions in any of their counts. "
^DIC(9.4,60,22,13,"PAH",137,1,6,0)="This patch will modify the Compile AMIS Data (NIGHT JOB) option [PSO AMIS "
^DIC(9.4,60,22,13,"PAH",137,1,7,0)="COMPILE] and the Recompile AMIS Data option [PSO AMIS RECOMPILE] to "
^DIC(9.4,60,22,13,"PAH",137,1,8,0)="include the Non-VA prescription counts in a new NVA field (#17) in the "
^DIC(9.4,60,22,13,"PAH",137,1,9,0)="DIVISION multiple (#59.11) of the OUTPATIENT AMIS DATA file (#59.1). "
^DIC(9.4,60,22,13,"PAH",137,1,10,0)="Pharmacy's AMIS Report option [PSO AMIS] and Daily AMIS Report option "
^DIC(9.4,60,22,13,"PAH",137,1,11,0)="[PSO DAILY AMIS] will be modified to display this field in a new NVA "
^DIC(9.4,60,22,13,"PAH",137,1,12,0)="column."
^DIC(9.4,60,22,13,"PAH",137,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",137,1,14,0)="If you install this patch and wish to include all past prescriptions with "
^DIC(9.4,60,22,13,"PAH",137,1,15,0)="a Patient Status of Non-VA for past dates, you must run the Recompile "
^DIC(9.4,60,22,13,"PAH",137,1,16,0)="AMIS Data option [PSO AMIS RECOMPILE]."
^DIC(9.4,60,22,13,"PAH",137,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",137,1,18,0)="Keep in mind that if you ran the AMIS report in the past, the counts will "
^DIC(9.4,60,22,13,"PAH",137,1,19,0)="be different when you re-run the report for that past date, since the "
^DIC(9.4,60,22,13,"PAH",137,1,20,0)="compile will now include prescriptions with a pharmacy patient status of "
^DIC(9.4,60,22,13,"PAH",137,1,21,0)="Non-VA. Also note that the recompile is system intensive and should be "
^DIC(9.4,60,22,13,"PAH",137,1,22,0)="run after hours."
^DIC(9.4,60,22,13,"PAH",138,0)="160 SEQ #142^3040131^1"
^DIC(9.4,60,22,13,"PAH",138,1,0)="^^161^161^3040131"
^DIC(9.4,60,22,13,"PAH",138,1,1,0)="This is the Outpatient Pharmacy patch for the Transitional Pharmacy Benefit"
^DIC(9.4,60,22,13,"PAH",138,1,2,0)="(TPB) project. This phase consists of automated processes and additional"
^DIC(9.4,60,22,13,"PAH",138,1,3,0)="tools designed to assist the sites for which Transitional Pharmacy Benefit"
^DIC(9.4,60,22,13,"PAH",138,1,4,0)="data have not been accurately reported."
^DIC(9.4,60,22,13,"PAH",138,1,5,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,6,0)="Two of the most common events that have contributed to the discrepancies"
^DIC(9.4,60,22,13,"PAH",138,1,7,0)="in the TPB data are:"
^DIC(9.4,60,22,13,"PAH",138,1,8,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,9,0)="   a) TPB prescriptions have been entered for TPB eligible patients via the"
^DIC(9.4,60,22,13,"PAH",138,1,10,0)="      wrong Outpatient Pharmacy prescription processing options, such as"
^DIC(9.4,60,22,13,"PAH",138,1,11,0)="      the Patient Prescription Processing [PSO LM BACKDOOR] option and Complete"
^DIC(9.4,60,22,13,"PAH",138,1,12,0)="      Orders from OERR [PSO LMOE FINISH] option."
^DIC(9.4,60,22,13,"PAH",138,1,13,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,14,0)="   b) Patients who did not wish to take advantage of the TPB benefit or who are"
^DIC(9.4,60,22,13,"PAH",138,1,15,0)="      not prescribed medication after a VA appointment are still active for"
^DIC(9.4,60,22,13,"PAH",138,1,16,0)="      the TPB benefit in the system.  The inactivation of the TPB benefit is "
^DIC(9.4,60,22,13,"PAH",138,1,17,0)="      automatic when the last active TPB prescription is discontinued either "
^DIC(9.4,60,22,13,"PAH",138,1,18,0)="      through an Outpatient Pharmacy package action or through an action taken"
^DIC(9.4,60,22,13,"PAH",138,1,19,0)="      in CPRS. The entry of a prescription/order will not inactivate the "
^DIC(9.4,60,22,13,"PAH",138,1,20,0)="      benefit unless the result is that the last active TPB prescription is"
^DIC(9.4,60,22,13,"PAH",138,1,21,0)="      discontinued as a result of the new entry. "
^DIC(9.4,60,22,13,"PAH",138,1,22,0)="   "
^DIC(9.4,60,22,13,"PAH",138,1,23,0)="This patch is comprised of four components that will help the sites identify"
^DIC(9.4,60,22,13,"PAH",138,1,24,0)="and fix the data discrepancies described above. It will also provide them "
^DIC(9.4,60,22,13,"PAH",138,1,25,0)="with new tools to monitor events that could have an impact on patient's TPB"
^DIC(9.4,60,22,13,"PAH",138,1,26,0)="eligibility. And in some cases the patient's TPB eligibity will be updated"
^DIC(9.4,60,22,13,"PAH",138,1,27,0)="automatically."
^DIC(9.4,60,22,13,"PAH",138,1,28,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,29,0)="Below is a detailed description of each component:"
^DIC(9.4,60,22,13,"PAH",138,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",138,1,31,0)="   1) MARKING TPB PATIENT Rx's AS TPB (ONE-TIME PROCESS - POST INSTALL)"
^DIC(9.4,60,22,13,"PAH",138,1,32,0)="      -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",138,1,33,0)="      Problem: Because some prescriptions have been entered through the"
^DIC(9.4,60,22,13,"PAH",138,1,34,0)="               wrong menu options (see item a) above), these Rx's have not "
^DIC(9.4,60,22,13,"PAH",138,1,35,0)="               been correctly identified as TPB prescriptions. In other "
^DIC(9.4,60,22,13,"PAH",138,1,36,0)="               words, they have a different patient status than ""NON-VA"" AND"
^DIC(9.4,60,22,13,"PAH",138,1,37,0)="               do not contain a TPB flag in PRESCRIPTION file (#52), and "
^DIC(9.4,60,22,13,"PAH",138,1,38,0)="               therefore, are not identifiable as prescriptions filled"
^DIC(9.4,60,22,13,"PAH",138,1,39,0)="               under the TPB program."
^DIC(9.4,60,22,13,"PAH",138,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",138,1,41,0)="      Solution: A Post-Install process will search for prescriptions filled"
^DIC(9.4,60,22,13,"PAH",138,1,42,0)="                under the TPB program which are not marked as such and"
^DIC(9.4,60,22,13,"PAH",138,1,43,0)="                will mark these prescriptions as TPB. The two requisites "
^DIC(9.4,60,22,13,"PAH",138,1,44,0)="                that must be fulfilled for a prescription to be marked as "
^DIC(9.4,60,22,13,"PAH",138,1,45,0)="                TPB, are:"
^DIC(9.4,60,22,13,"PAH",138,1,46,0)="    "
^DIC(9.4,60,22,13,"PAH",138,1,47,0)="                  a) The prescription was entered during the period that"
^DIC(9.4,60,22,13,"PAH",138,1,48,0)="                     the patient's TPB benefit was active."
^DIC(9.4,60,22,13,"PAH",138,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",138,1,50,0)="                                      AND"
^DIC(9.4,60,22,13,"PAH",138,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",138,1,52,0)="                  b) The provider for the prescription is a ""NON-VA"""
^DIC(9.4,60,22,13,"PAH",138,1,53,0)="                     provider."
^DIC(9.4,60,22,13,"PAH",138,1,54,0)="                   "
^DIC(9.4,60,22,13,"PAH",138,1,55,0)="                If the requisites above are fulfilled, the following "
^DIC(9.4,60,22,13,"PAH",138,1,56,0)="                updates will be done for the prescription:"
^DIC(9.4,60,22,13,"PAH",138,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",138,1,58,0)="                  a) Patient status will be changed to ""NON-VA""."
^DIC(9.4,60,22,13,"PAH",138,1,59,0)="                  b) If an UNIQUE TPB clinic is identified (STOP CODE"
^DIC(9.4,60,22,13,"PAH",138,1,60,0)="                     equals 161) for the site, clinic will be changed to"
^DIC(9.4,60,22,13,"PAH",138,1,61,0)="                     this clinic."
^DIC(9.4,60,22,13,"PAH",138,1,62,0)="                  c) The TPB flag will be set in PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",138,1,63,0)="     "
^DIC(9.4,60,22,13,"PAH",138,1,64,0)="      Report: At the end of this process, a Mailman message will be sent"
^DIC(9.4,60,22,13,"PAH",138,1,65,0)="              to the newly created mail group called PSO TPB GROUP. The "
^DIC(9.4,60,22,13,"PAH",138,1,66,0)="              patients reported on this message had at least one Prescription"
^DIC(9.4,60,22,13,"PAH",138,1,67,0)="              edited by the Post-Install process. The sites will have the"
^DIC(9.4,60,22,13,"PAH",138,1,68,0)="              ability to enter the coordinator of this new mail group at time"
^DIC(9.4,60,22,13,"PAH",138,1,69,0)="              of installation of this patch. Even if the coordinator is not"
^DIC(9.4,60,22,13,"PAH",138,1,70,0)="              entered, this patch assures that at least the installer of the"
^DIC(9.4,60,22,13,"PAH",138,1,71,0)="              patch is a member of the mail group. The fields reported on this"
^DIC(9.4,60,22,13,"PAH",138,1,72,0)="              Mailman message are: PATIENT NAME(LAST4SSN), Rx#, DRUG NAME, "
^DIC(9.4,60,22,13,"PAH",138,1,73,0)="              PROVIDER NAME, CLINIC (Old and New) and the Rx PATIENT STATUS"
^DIC(9.4,60,22,13,"PAH",138,1,74,0)="              (Old and New)."
^DIC(9.4,60,22,13,"PAH",138,1,75,0)="   "
^DIC(9.4,60,22,13,"PAH",138,1,76,0)="      Important: If the site identifies prescriptions on this report that"
^DIC(9.4,60,22,13,"PAH",138,1,77,0)="                 have been wrongly flagged as TPB, it is possible to manually"
^DIC(9.4,60,22,13,"PAH",138,1,78,0)="                 remove the TPB flag from  such prescriptions through FileMan."
^DIC(9.4,60,22,13,"PAH",138,1,79,0)="                 Just repeat the steps below for each prescription you wish"
^DIC(9.4,60,22,13,"PAH",138,1,80,0)="                 to remove the TPB flag (as in this example):"
^DIC(9.4,60,22,13,"PAH",138,1,81,0)=" "
^DIC(9.4,60,22,13,"PAH",138,1,82,0)="                 VA FileMan 22.0"
^DIC(9.4,60,22,13,"PAH",138,1,83,0)="    "
^DIC(9.4,60,22,13,"PAH",138,1,84,0)="                 Select OPTION: ENTER OR EDIT FILE ENTRIES  "
^DIC(9.4,60,22,13,"PAH",138,1,85,0)="    "
^DIC(9.4,60,22,13,"PAH",138,1,86,0)="                 INPUT TO WHAT FILE: PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",138,1,87,0)="                 EDIT WHICH FIELD: ALL// TPB RX  "
^DIC(9.4,60,22,13,"PAH",138,1,88,0)="                 THEN EDIT FIELD:"
^DIC(9.4,60,22,13,"PAH",138,1,89,0)="      "
^DIC(9.4,60,22,13,"PAH",138,1,90,0)="                 Select PRESCRIPTION RX #: 123457690A  TYLENOL 250MG"
^DIC(9.4,60,22,13,"PAH",138,1,91,0)="                 TPB RX: YES// @"
^DIC(9.4,60,22,13,"PAH",138,1,92,0)="                    SURE YOU WANT TO DELETE? Y  (Yes)"
^DIC(9.4,60,22,13,"PAH",138,1,93,0)="    "
^DIC(9.4,60,22,13,"PAH",138,1,94,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,95,0)="   "
^DIC(9.4,60,22,13,"PAH",138,1,96,0)="   2) INACTIVATING PATIENT'S TPB BENEFIT (ONE-TIME PROCESS - POST INSTALL)"
^DIC(9.4,60,22,13,"PAH",138,1,97,0)="      --------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",138,1,98,0)="      Problem: Since not all patients eligible for the TPB program chose to"
^DIC(9.4,60,22,13,"PAH",138,1,99,0)="               take advantage of the TPB benefit or, after seeing the VA "
^DIC(9.4,60,22,13,"PAH",138,1,100,0)="               provider the patient was not prescribed any medication, his/her"
^DIC(9.4,60,22,13,"PAH",138,1,101,0)="               TPB eligibility remained active, when in reality it should have "
^DIC(9.4,60,22,13,"PAH",138,1,102,0)="               been inactivated."
^DIC(9.4,60,22,13,"PAH",138,1,103,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,104,0)="      Solution: A Post-Install process will search for TPB eligible patients "
^DIC(9.4,60,22,13,"PAH",138,1,105,0)="                and automatically inactivate the TPB eligibility of the "
^DIC(9.4,60,22,13,"PAH",138,1,106,0)="                patients that fulfill both of the following"
^DIC(9.4,60,22,13,"PAH",138,1,107,0)="                requisites:"
^DIC(9.4,60,22,13,"PAH",138,1,108,0)="                   "
^DIC(9.4,60,22,13,"PAH",138,1,109,0)="                  a) Patient does not have any ""active"" TPB prescription(s) on"
^DIC(9.4,60,22,13,"PAH",138,1,110,0)="                     file. The prescription statuses considered as ""active"""
^DIC(9.4,60,22,13,"PAH",138,1,111,0)="                     are the following:"
^DIC(9.4,60,22,13,"PAH",138,1,112,0)="                     ACTIVE, NON-VERIFIED, HOLD, DRUG INTERACTIONS, SUSPENDED"
^DIC(9.4,60,22,13,"PAH",138,1,113,0)="                     and PROVIDER HOLD.  "
^DIC(9.4,60,22,13,"PAH",138,1,114,0)="    "
^DIC(9.4,60,22,13,"PAH",138,1,115,0)="                                          AND"
^DIC(9.4,60,22,13,"PAH",138,1,116,0)="    "
^DIC(9.4,60,22,13,"PAH",138,1,117,0)="                  b) Patient has had an appointment at a designated TPB Clinic"
^DIC(9.4,60,22,13,"PAH",138,1,118,0)="                     (determined through a set of clinic stop codes) since the"
^DIC(9.4,60,22,13,"PAH",138,1,119,0)="                     date his/her TPB benefit began."
^DIC(9.4,60,22,13,"PAH",138,1,120,0)="     "
^DIC(9.4,60,22,13,"PAH",138,1,121,0)="      Report: At the end of this process, a Mailman message will be sent to"
^DIC(9.4,60,22,13,"PAH",138,1,122,0)="              the new mail group PSO TPB GROUP. The patients reported on this "
^DIC(9.4,60,22,13,"PAH",138,1,123,0)="              message were inactivated as TPB patients by the Post-Install"
^DIC(9.4,60,22,13,"PAH",138,1,124,0)="              process The fields reported on this message are: PATIENT NAME,"
^DIC(9.4,60,22,13,"PAH",138,1,125,0)="              LAST 4 DIGITS OF SSN, APPOINTMENT DATE/TIME, VA CLINIC NAME."
^DIC(9.4,60,22,13,"PAH",138,1,126,0)="   "
^DIC(9.4,60,22,13,"PAH",138,1,127,0)="   3) PATIENT'S TPB BENEFIT INACTIVATION (ENHANCEMENT - CONTINUOUS PROCESS)"
^DIC(9.4,60,22,13,"PAH",138,1,128,0)="      ---------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",138,1,129,0)="      Outpatient Pharmacy software will be notified by the Scheduling software"
^DIC(9.4,60,22,13,"PAH",138,1,130,0)="      every time a patient has an appointment at a VA clinic. If the patient"
^DIC(9.4,60,22,13,"PAH",138,1,131,0)="      is eligible for the TPB benefit, the appointment was at a designated TPB "
^DIC(9.4,60,22,13,"PAH",138,1,132,0)="      Clinic (determined through a set of clinic stop codes) AND the patient"
^DIC(9.4,60,22,13,"PAH",138,1,133,0)="      does not have any ""active"" (see list of statuses on item #2a above) TPB "
^DIC(9.4,60,22,13,"PAH",138,1,134,0)="      prescription(s) on file, this patient will have the TPB eligibility "
^DIC(9.4,60,22,13,"PAH",138,1,135,0)="      automatically inactivated. A Mailman message will be sent to the PSO TPB"
^DIC(9.4,60,22,13,"PAH",138,1,136,0)="      GROUP mail group with the following information:"
^DIC(9.4,60,22,13,"PAH",138,1,137,0)="       "
^DIC(9.4,60,22,13,"PAH",138,1,138,0)="          The following patient had the TPB (Transitional Pharmacy Benefit)"
^DIC(9.4,60,22,13,"PAH",138,1,139,0)="          Benefit automatically inactivated because the following appointment"
^DIC(9.4,60,22,13,"PAH",138,1,140,0)="          was found: "
^DIC(9.4,60,22,13,"PAH",138,1,141,0)="   "
^DIC(9.4,60,22,13,"PAH",138,1,142,0)="                     Patient         : LAST,FIRST(9999)"
^DIC(9.4,60,22,13,"PAH",138,1,143,0)="                     VA Clinic       : EAST MIDWAY CLINIC"
^DIC(9.4,60,22,13,"PAH",138,1,144,0)="                     Appointment Date: DEC 02, 2003@11:15"
^DIC(9.4,60,22,13,"PAH",138,1,145,0)="  "
^DIC(9.4,60,22,13,"PAH",138,1,146,0)="   4) REPORT OF PATIENTS WITH TPB AND NON-TPB Rx's (NEW REPORT)"
^DIC(9.4,60,22,13,"PAH",138,1,147,0)="      [PSO TPB PATIENT RX REPORT]"
^DIC(9.4,60,22,13,"PAH",138,1,148,0)="      ---------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",138,1,149,0)="      This new report is being released as a stand-alone option. It will "
^DIC(9.4,60,22,13,"PAH",138,1,150,0)="      print a list of TPB eligible patients that have ""active"" TPB and"
^DIC(9.4,60,22,13,"PAH",138,1,151,0)="      Non-TPB prescriptions on file. The report can be for ALL or selected "
^DIC(9.4,60,22,13,"PAH",138,1,152,0)="      institutions, as well as for ALL or selected TPB patients. It will be"
^DIC(9.4,60,22,13,"PAH",138,1,153,0)="      sorted by the INSTITUTION NAME first, then by the PATIENT NAME. There"
^DIC(9.4,60,22,13,"PAH",138,1,154,0)="      will be a page-break for each individual institution. The column"
^DIC(9.4,60,22,13,"PAH",138,1,155,0)="      headings on the report are: PATIENT NAME (LAST4SSN), VA Rx#, TPB Rx#, "
^DIC(9.4,60,22,13,"PAH",138,1,156,0)="      DRUG NAME. This report should be assigned to the site TPB Coordinator,"
^DIC(9.4,60,22,13,"PAH",138,1,157,0)="      Pharmacy ADPAC and any other individual deemed appropriate by the site."
^DIC(9.4,60,22,13,"PAH",138,1,158,0)="      "
^DIC(9.4,60,22,13,"PAH",138,1,159,0)="In order to allow the unflagging of TPB prescriptions as described in 1) "
^DIC(9.4,60,22,13,"PAH",138,1,160,0)="above, the TPB RX (#201) field in the PRESCRIPTION (#52) file is being "
^DIC(9.4,60,22,13,"PAH",138,1,161,0)="changed from ""UNEDITABLE"" to ""EDITABLE"". "
^DIC(9.4,60,22,13,"PAH",139,0)="154 SEQ #143^3040330^1"
^DIC(9.4,60,22,13,"PAH",139,1,0)="^^38^38^3040330"
^DIC(9.4,60,22,13,"PAH",139,1,1,0)="SBY-1003-30858"
^DIC(9.4,60,22,13,"PAH",139,1,2,0)="Prescriptions are not seen in Patient Prescription Processing "
^DIC(9.4,60,22,13,"PAH",139,1,3,0)="[PSO LM BACKDOOR ORDERS] option and in Computerized Patient Record System "
^DIC(9.4,60,22,13,"PAH",139,1,4,0)="(CPRS) Meds Tab but are seen in View Prescriptions [PSO VIEW] option and "
^DIC(9.4,60,22,13,"PAH",139,1,5,0)="CPRS Orders Tab."
^DIC(9.4,60,22,13,"PAH",139,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",139,1,7,0)="PSO*7*139 corrected the following problem:"
^DIC(9.4,60,22,13,"PAH",139,1,8,0)="    In some situations where a patient is being accessed by Inpatient"
^DIC(9.4,60,22,13,"PAH",139,1,9,0)="    Medications Version 5.0, if an attempt is made to finish orders in"
^DIC(9.4,60,22,13,"PAH",139,1,10,0)="    Outpatient Pharmacy Version 7.0, a message is received that the"
^DIC(9.4,60,22,13,"PAH",139,1,11,0)="    patient is in use. Then if an ""^"" is entered for the PATIENT STATUS"
^DIC(9.4,60,22,13,"PAH",139,1,12,0)="    prompt, the cross-reference entries in the PHARMACY PATIENT file (#55)"
^DIC(9.4,60,22,13,"PAH",139,1,13,0)="    could be deleted for that patient."
^DIC(9.4,60,22,13,"PAH",139,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",139,1,15,0)="This patch has a post install clean-up routine that will:"
^DIC(9.4,60,22,13,"PAH",139,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",139,1,17,0)="1. Look for entries in the PHARMACY PATIENT file (#55) affected by the"
^DIC(9.4,60,22,13,"PAH",139,1,18,0)="   problem above and will rebuild the missing cross-references."
^DIC(9.4,60,22,13,"PAH",139,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",139,1,20,0)="2. Once the cross-reference is rebuilt for a specific patient, the post"
^DIC(9.4,60,22,13,"PAH",139,1,21,0)="   install will check if the patient has been merged and in case the"
^DIC(9.4,60,22,13,"PAH",139,1,22,0)="   patient's prescriptions still contain the old patient internal entry "
^DIC(9.4,60,22,13,"PAH",139,1,23,0)="   number, it will correct them with the new patient number in the "
^DIC(9.4,60,22,13,"PAH",139,1,24,0)="   PRESCRIPTION file (#52). The database problems caused by"
^DIC(9.4,60,22,13,"PAH",139,1,25,0)="   patient merges have been fixed by PSO*7*136, however, patient entries"
^DIC(9.4,60,22,13,"PAH",139,1,26,0)="   in the PHARMACY PATIENT file (#55) with the problem above, could have"
^DIC(9.4,60,22,13,"PAH",139,1,27,0)="   been missed by PSO*7*136 cleanup job. "
^DIC(9.4,60,22,13,"PAH",139,1,28,0)="   This step of this cleanup will make sure these entries are fixed."
^DIC(9.4,60,22,13,"PAH",139,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",139,1,30,0)="During Installation of this patch the user will be asked: ""Queue the"
^DIC(9.4,60,22,13,"PAH",139,1,31,0)="Post-Install to run at what Date@Time: "". If the prompt is not "
^DIC(9.4,60,22,13,"PAH",139,1,32,0)="answered, the patch WILL NOT be installed. After the post install"
^DIC(9.4,60,22,13,"PAH",139,1,33,0)="routine is run to completion at the time the user indicated, a MailMan"
^DIC(9.4,60,22,13,"PAH",139,1,34,0)="message with the subject ""PHARMACY PATIENT File (#55) missing entries"""
^DIC(9.4,60,22,13,"PAH",139,1,35,0)="containing the list of prescription cross-references rebuilt will be sent"
^DIC(9.4,60,22,13,"PAH",139,1,36,0)="to the person installing the patch. The prescriptions will then appear in"
^DIC(9.4,60,22,13,"PAH",139,1,37,0)="the Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option and"
^DIC(9.4,60,22,13,"PAH",139,1,38,0)="the CPRS Meds Tab if they are not past their expiration date."
^DIC(9.4,60,22,13,"PAH",140,0)="164 SEQ #144^3040330^1"
^DIC(9.4,60,22,13,"PAH",140,1,0)="^^17^17^3040330"
^DIC(9.4,60,22,13,"PAH",140,1,1,0)="There is one occasion where in the Outpatient Pharmacy application"
^DIC(9.4,60,22,13,"PAH",140,1,2,0)="where the PATIENT INSTRUCTIONS field content from one prescription "
^DIC(9.4,60,22,13,"PAH",140,1,3,0)="can be carried over to another prescription automatically. This "
^DIC(9.4,60,22,13,"PAH",140,1,4,0)="problem was identified in the Complete Orders from OERR [PSO LMOE"
^DIC(9.4,60,22,13,"PAH",140,1,5,0)="FINISH] and Patient Prescription Processing [PSO LM BACKDOOR] menu "
^DIC(9.4,60,22,13,"PAH",140,1,6,0)="options. The scenario that this problem happens is the following:"
^DIC(9.4,60,22,13,"PAH",140,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",140,1,8,0)="   Patient has Rx A, which is active and the Patient Instructions "
^DIC(9.4,60,22,13,"PAH",140,1,9,0)="   field is not NULL (e.g. ""FOR ALLERGIES""). Two new prescriptions"
^DIC(9.4,60,22,13,"PAH",140,1,10,0)="   are entered through through CPRS, Rx B and Rx C. Rx B is a "
^DIC(9.4,60,22,13,"PAH",140,1,11,0)="   duplicate of Rx A. When finishing Rx B, an order check happens"
^DIC(9.4,60,22,13,"PAH",140,1,12,0)="   and Rx A is DC'd. Select Rx C and select to edit the Patient "
^DIC(9.4,60,22,13,"PAH",140,1,13,0)="   Instructions field. If this field was NULL before, it will now"
^DIC(9.4,60,22,13,"PAH",140,1,14,0)="   show a default value, which is the content of the Patient "
^DIC(9.4,60,22,13,"PAH",140,1,15,0)="   Instruction field from Rx A (""FOR ALLERGIES"")."
^DIC(9.4,60,22,13,"PAH",140,1,16,0)="   "
^DIC(9.4,60,22,13,"PAH",140,1,17,0)="This problem will be corrected by installing this patch.  "
^DIC(9.4,60,22,13,"PAH",141,0)="155 SEQ #145^3040427^1"
^DIC(9.4,60,22,13,"PAH",141,1,0)="^^20^20^3040427"
^DIC(9.4,60,22,13,"PAH",141,1,1,0)="1. Scheduling V. 5.3 package is moving the patient appointment information"
^DIC(9.4,60,22,13,"PAH",141,1,2,0)="stored in the APPOINTMENT sub-file (#2.98) of the PATIENT file (#2) and "
^DIC(9.4,60,22,13,"PAH",141,1,3,0)="the APPOINTMENT sub-file  (#44.001) of the HOSPITAL LOCATION file (#44) to"
^DIC(9.4,60,22,13,"PAH",141,1,4,0)="the Government Off-the-Shelf (GOTS) database. Eventually, these sub-files"
^DIC(9.4,60,22,13,"PAH",141,1,5,0)="will be deleted from the Scheduling files. As part of the Scheduling"
^DIC(9.4,60,22,13,"PAH",141,1,6,0)="Replacement Project, Scheduling V. 5.3 package is providing a series of"
^DIC(9.4,60,22,13,"PAH",141,1,7,0)="Application Programmer Interface calls (APIs) that will be used to get the"
^DIC(9.4,60,22,13,"PAH",141,1,8,0)="patient appointment information from the new GOTS database. This is the"
^DIC(9.4,60,22,13,"PAH",141,1,9,0)="Outpatient Pharmacy V. 7.0 patch that replaces all direct references to"
^DIC(9.4,60,22,13,"PAH",141,1,10,0)="the patient appointment information in the Action Profile (132 COLUMN"
^DIC(9.4,60,22,13,"PAH",141,1,11,0)="PRINTOUT) [PSO ACTION PROFILE ] option, with the new APIs."
^DIC(9.4,60,22,13,"PAH",141,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",141,1,13,0)="2. NOIS OKL-0204-7052"
^DIC(9.4,60,22,13,"PAH",141,1,14,0)="The Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE ] option is"
^DIC(9.4,60,22,13,"PAH",141,1,15,0)="supposed to list only the active med orders if zero is entered for the"
^DIC(9.4,60,22,13,"PAH",141,1,16,0)="prompt ""Profile Expiration/Discontinued Cutoff:  (0-9999): 120//"", but"
^DIC(9.4,60,22,13,"PAH",141,1,17,0)="it also shows discontinued med orders. This patch ensures that if the"
^DIC(9.4,60,22,13,"PAH",141,1,18,0)="cutoff days is zero, only the active med orders will be listed. For"
^DIC(9.4,60,22,13,"PAH",141,1,19,0)="all other cutoff days the report will show the discontinued and expired"
^DIC(9.4,60,22,13,"PAH",141,1,20,0)="med orders."
^DIC(9.4,60,22,13,"PAH",142,0)="133 SEQ #146^3040427^1"
^DIC(9.4,60,22,13,"PAH",142,1,0)="^^83^83^3040427"
^DIC(9.4,60,22,13,"PAH",142,1,1,0)="1. OKL-1202-71318"
^DIC(9.4,60,22,13,"PAH",142,1,2,0)="   When using the Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",142,1,3,0)="   option to edit the dispensed drug on an active order, if there is more"
^DIC(9.4,60,22,13,"PAH",142,1,4,0)="   than one drug tied to that Orderable item, if a different drug is"
^DIC(9.4,60,22,13,"PAH",142,1,5,0)="   selected from the displayed drug list, the software prompts 'Do You"
^DIC(9.4,60,22,13,"PAH",142,1,6,0)="   want to Edit the SIG? NO//'. On selecting 'Yes' you are prompted for"
^DIC(9.4,60,22,13,"PAH",142,1,7,0)="   these fields: dosage, verb, dispense unit, noun, route, schedule,"
^DIC(9.4,60,22,13,"PAH",142,1,8,0)="   duration or the conjunction. If changes are made to any of these"
^DIC(9.4,60,22,13,"PAH",142,1,9,0)="   fields, you are prompted  'Are You Sure You Want to Update Rx 999999?"
^DIC(9.4,60,22,13,"PAH",142,1,10,0)="   Yes//'. When selecting 'Yes', the software does not update the changes."
^DIC(9.4,60,22,13,"PAH",142,1,11,0)="   This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",142,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,13,0)="2. MOU-1202-31080"
^DIC(9.4,60,22,13,"PAH",142,1,14,0)="   Using Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option,"
^DIC(9.4,60,22,13,"PAH",142,1,15,0)="   when the drug of an active order is edited, the software checks for the"
^DIC(9.4,60,22,13,"PAH",142,1,16,0)="   change and prompts 'Do You want to Edit the SIG? NO//' and accordingly"
^DIC(9.4,60,22,13,"PAH",142,1,17,0)="   alerts the user with the message 'This change will create a new"
^DIC(9.4,60,22,13,"PAH",142,1,18,0)="   prescription!'. During the completion process of new orders entered"
^DIC(9.4,60,22,13,"PAH",142,1,19,0)="   through Computerized Patient Record System (CPRS), if the drug is"
^DIC(9.4,60,22,13,"PAH",142,1,20,0)="   edited, the software currently does not make any such checks on the"
^DIC(9.4,60,22,13,"PAH",142,1,21,0)="   edited drug. This patch ensures that the same functionality that is"
^DIC(9.4,60,22,13,"PAH",142,1,22,0)="   provided to the drug edits of an active order, is incorporated into the"
^DIC(9.4,60,22,13,"PAH",142,1,23,0)="   drug edits during the completion of orders entered through CPRS."
^DIC(9.4,60,22,13,"PAH",142,1,24,0)="   Also the completion of pending order process is enhanced in this patch"
^DIC(9.4,60,22,13,"PAH",142,1,25,0)="   to display the message ""Pending Order Not Updated!"" in the message box"
^DIC(9.4,60,22,13,"PAH",142,1,26,0)="   when an up-arrow (^) is entered at any of the dosage prompts to quit"
^DIC(9.4,60,22,13,"PAH",142,1,27,0)="   the process. This is similar to ""Prescription Not Updated!"" message"
^DIC(9.4,60,22,13,"PAH",142,1,28,0)="   that is provided when quitting during an edit of an active order with"
^DIC(9.4,60,22,13,"PAH",142,1,29,0)="   an up-arrow (^)."
^DIC(9.4,60,22,13,"PAH",142,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,31,0)="3. CLL-0403-41585"
^DIC(9.4,60,22,13,"PAH",142,1,32,0)="   When using the Patient Prescription Processing [PSO LM BACKDOOR"
^DIC(9.4,60,22,13,"PAH",142,1,33,0)="   ORDERS] or the Complete Orders from OERR [PSO LMOE FINISH] option, to"
^DIC(9.4,60,22,13,"PAH",142,1,34,0)="   complete orders entered through Computerized Patient Record System"
^DIC(9.4,60,22,13,"PAH",142,1,35,0)="   (CPRS), you cannot edit the Orderable Item using the synonym of that"
^DIC(9.4,60,22,13,"PAH",142,1,36,0)="   Orderable Item. This patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",142,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,38,0)="4. HWH-0303-40364"
^DIC(9.4,60,22,13,"PAH",142,1,39,0)="   When entering complex orders using Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",142,1,40,0)="   [PSO LM BACKDOOR ORDERS] option, if an up-arrow (^) and 3 characters"
^DIC(9.4,60,22,13,"PAH",142,1,41,0)="   are entered at the conjunction prompt in order to correct one of the"
^DIC(9.4,60,22,13,"PAH",142,1,42,0)="   dosage fields, the software goes into an endless loop going back to the"
^DIC(9.4,60,22,13,"PAH",142,1,43,0)="   beginning of the complex dosage. This happens only if the 3 characters"
^DIC(9.4,60,22,13,"PAH",142,1,44,0)="   entered do not point to one of the dosage fields. This patch fixes this"
^DIC(9.4,60,22,13,"PAH",142,1,45,0)="   problem. We also fixed the following related issue: Currently, to jump"
^DIC(9.4,60,22,13,"PAH",142,1,46,0)="   to the Limited Duration field within the dosage edit, you need to enter"
^DIC(9.4,60,22,13,"PAH",142,1,47,0)="   ""^DUR"" or ""^dur"", not ""^LIM"" or ""^lim"", as expected by many users. This"
^DIC(9.4,60,22,13,"PAH",142,1,48,0)="   patch provides the option of entering ""^LIM"" or ""^lim"" or ""^DUR"" or "
^DIC(9.4,60,22,13,"PAH",142,1,49,0)="   ""^dur"", to jump to the Limited Duration field."
^DIC(9.4,60,22,13,"PAH",142,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,51,0)="5. SBY-0503-30615"
^DIC(9.4,60,22,13,"PAH",142,1,52,0)="   Using Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option,"
^DIC(9.4,60,22,13,"PAH",142,1,53,0)="   when the Orderable Item of an active order is edited to a different"
^DIC(9.4,60,22,13,"PAH",142,1,54,0)="   item, this will alert the user with the message 'New Orderable Item"
^DIC(9.4,60,22,13,"PAH",142,1,55,0)="   selected. This edit will create a new prescription!', and it will do "
^DIC(9.4,60,22,13,"PAH",142,1,56,0)="   the order checking. During order checking process if it encounters any"
^DIC(9.4,60,22,13,"PAH",142,1,57,0)="   drug interactions with other active prescriptions, it will display the"
^DIC(9.4,60,22,13,"PAH",142,1,58,0)="   following:"
^DIC(9.4,60,22,13,"PAH",142,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,60,0)="     '***CRITICAL*** Drug Interaction with RX #9999999'"
^DIC(9.4,60,22,13,"PAH",142,1,61,0)="     'DRUG: ASPIRIN BUFFERED 325MG TAB' (the drug it had interaction with)"
^DIC(9.4,60,22,13,"PAH",142,1,62,0)="     'Do you want to Continue? Y// '."
^DIC(9.4,60,22,13,"PAH",142,1,63,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,64,0)="   At this prompt if you enter 'No' or up-arrow (^), or you enter 'Yes'"
^DIC(9.4,60,22,13,"PAH",142,1,65,0)="   and for the next prompt 'Do you want to Process medication METHOTREXATE"
^DIC(9.4,60,22,13,"PAH",142,1,66,0)="   2.5MG TAB: P// ?', (drug that is tied to the Orderable Item you"
^DIC(9.4,60,22,13,"PAH",142,1,67,0)="   selected to), if you enter '0' or '^' to Abort, there is a possibility"
^DIC(9.4,60,22,13,"PAH",142,1,68,0)="   of getting an undefined variable error PSODRUG(""OIN""). This patch"
^DIC(9.4,60,22,13,"PAH",142,1,69,0)="   corrects this problem."
^DIC(9.4,60,22,13,"PAH",142,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",142,1,71,0)="6. MAC-0503-60991"
^DIC(9.4,60,22,13,"PAH",142,1,72,0)="   Using the Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",142,1,73,0)="   option, when the drug of an active order is edited to a drug that is"
^DIC(9.4,60,22,13,"PAH",142,1,74,0)="   tied to a different Orderable Item, the software prompts 'Do You want"
^DIC(9.4,60,22,13,"PAH",142,1,75,0)="   to Edit the SIG? NO//'. On selecting 'No', you are alerted with the"
^DIC(9.4,60,22,13,"PAH",142,1,76,0)="   message 'This change will create a new prescription!'. When you accept"
^DIC(9.4,60,22,13,"PAH",142,1,77,0)="   the new order, since the dosage information is incomplete you will be"
^DIC(9.4,60,22,13,"PAH",142,1,78,0)="   forced to enter the dosage information. At the prompts; Verb, Schedule,"
^DIC(9.4,60,22,13,"PAH",142,1,79,0)="   Limited Duration or Conjunction, if you enter up-arrow (^) with the"
^DIC(9.4,60,22,13,"PAH",142,1,80,0)="   intention of quitting the order process, you are prompted to fill the"
^DIC(9.4,60,22,13,"PAH",142,1,81,0)="   rest of the fields. When it prompts you 'Is this correct? YES//', on"
^DIC(9.4,60,22,13,"PAH",142,1,82,0)="   selecting 'Yes', there is a possibility of getting an undefined"
^DIC(9.4,60,22,13,"PAH",142,1,83,0)="   variable error PSOX(""ENT""). This patch corrects this error."
^DIC(9.4,60,22,13,"PAH",143,0)="152 SEQ #147^3040507^1"
^DIC(9.4,60,22,13,"PAH",143,1,0)="^^45^45^3040507"
^DIC(9.4,60,22,13,"PAH",143,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,2,0)="1. CPH-0203-41084 "
^DIC(9.4,60,22,13,"PAH",143,1,3,0)="   When using the options Patient Prescription Processing [PSO LM BACKDOOR"
^DIC(9.4,60,22,13,"PAH",143,1,4,0)="   ORDERS] and Complete Orders from OERR [PSO LMOE FINISH] to complete a "
^DIC(9.4,60,22,13,"PAH",143,1,5,0)="   pending order, if the number of refills is five and the days supply is 60,"
^DIC(9.4,60,22,13,"PAH",143,1,6,0)="   the current logic calculates the maximum number of refills to two instead"
^DIC(9.4,60,22,13,"PAH",143,1,7,0)="   of five. This patch corrects this issue by modifying the maximum refills"
^DIC(9.4,60,22,13,"PAH",143,1,8,0)="   calculation to account for this scenario."
^DIC(9.4,60,22,13,"PAH",143,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,10,0)="2. CLE-0203-40018"
^DIC(9.4,60,22,13,"PAH",143,1,11,0)="   When trying to refill a drug that is unmarked for Outpatient Pharmacy use,"
^DIC(9.4,60,22,13,"PAH",143,1,12,0)="   the options Refill [PSO REFILL] and Refill (OP) [PSO SPEED REFILL] act"
^DIC(9.4,60,22,13,"PAH",143,1,13,0)="   differently.  The Refill [PSO REFILL] option does not allow this and the"
^DIC(9.4,60,22,13,"PAH",143,1,14,0)="   Refill (OP) [PSO SPEED REFILL] does allow this, and should not.  This"
^DIC(9.4,60,22,13,"PAH",143,1,15,0)="   patch will correct the Refill (OP) [PSO SPEED REFILL] option to not allow"
^DIC(9.4,60,22,13,"PAH",143,1,16,0)="   refills of a drug that is unmarked for Outpatient Pharmacy Use."
^DIC(9.4,60,22,13,"PAH",143,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,18,0)="3. CMC-0602-30921"
^DIC(9.4,60,22,13,"PAH",143,1,19,0)="   National Drug Codes (NDC) starting with non-numeric characters were not"
^DIC(9.4,60,22,13,"PAH",143,1,20,0)="   being displayed under the ""Comments"" column on the CMOP Event Log section"
^DIC(9.4,60,22,13,"PAH",143,1,21,0)="   of the View Prescription [PSO VIEW] option. This patch corrects this issue"
^DIC(9.4,60,22,13,"PAH",143,1,22,0)="   by modifying the display to accommodate these National Drug Codes (NDC)."
^DIC(9.4,60,22,13,"PAH",143,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,24,0)="4. NYH-0903-12478"
^DIC(9.4,60,22,13,"PAH",143,1,25,0)="   When a Health Level Seven (HL7) message is generated, the ZRL segment"
^DIC(9.4,60,22,13,"PAH",143,1,26,0)="   Sequence 13 (Non-Refillable), Sequence 14 (Refill Status) and Sequence"
^DIC(9.4,60,22,13,"PAH",143,1,27,0)="   20 (Fill Number) are not populated even though there are refills for the"
^DIC(9.4,60,22,13,"PAH",143,1,28,0)="   prescription. This patch will correct this issue by populating these"
^DIC(9.4,60,22,13,"PAH",143,1,29,0)="   Sequences for the ZRL segment."
^DIC(9.4,60,22,13,"PAH",143,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,31,0)="5. ISB-0203-32155"
^DIC(9.4,60,22,13,"PAH",143,1,32,0)="   This patch resolves compliance issues with the Standards and Conventions"
^DIC(9.4,60,22,13,"PAH",143,1,33,0)="   Committee's (SACC) standard regarding the documentation of Database"
^DIC(9.4,60,22,13,"PAH",143,1,34,0)="   Integration Agreements (DBIA).  This patch will correct this issue by"
^DIC(9.4,60,22,13,"PAH",143,1,35,0)="   adding this documentation."
^DIC(9.4,60,22,13,"PAH",143,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,37,0)="6. ISB-0903-31952"
^DIC(9.4,60,22,13,"PAH",143,1,38,0)="   This patch resolves compliance issues with the Standards and Conventions"
^DIC(9.4,60,22,13,"PAH",143,1,39,0)="   Committee's (SACC) standard regarding the format of the first line of a"
^DIC(9.4,60,22,13,"PAH",143,1,40,0)="   routine.  In this case, there was an extra space before the date.  This"
^DIC(9.4,60,22,13,"PAH",143,1,41,0)="   space has been removed to comply with the standard."
^DIC(9.4,60,22,13,"PAH",143,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",143,1,43,0)="7. PSO*7*152 TRACKER MESSAGE [#37406428] Response #8"
^DIC(9.4,60,22,13,"PAH",143,1,44,0)="   During the testing of this patch in Oklahoma City an undefined error"
^DIC(9.4,60,22,13,"PAH",143,1,45,0)="   occurred.  This error has been corrected in this patch."
^DIC(9.4,60,22,13,"PAH",144,0)="167 SEQ #148^3040521^1"
^DIC(9.4,60,22,13,"PAH",144,1,0)="^^32^32^3040521"
^DIC(9.4,60,22,13,"PAH",144,1,1,0)="NOIS TOM-0104-41317"
^DIC(9.4,60,22,13,"PAH",144,1,2,0)="When using the Patient Prescription Processing [PSO LM BACKDOOR ORDERS] "
^DIC(9.4,60,22,13,"PAH",144,1,3,0)="option to edit the division on an original prescription or refill that "
^DIC(9.4,60,22,13,"PAH",144,1,4,0)="is suspended for CMOP, the possibility exists that the prescription will "
^DIC(9.4,60,22,13,"PAH",144,1,5,0)="not be sent to CMOP due to an invalid cross-reference.  "
^DIC(9.4,60,22,13,"PAH",144,1,6,0)="This patch will fix this issue by maintaining the CMOP compound index "
^DIC(9.4,60,22,13,"PAH",144,1,7,0)="in the PRESCRIPTION SUSPENSE file (#52.5) correctly."
^DIC(9.4,60,22,13,"PAH",144,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",144,1,9,0)="This patch has a post install clean-up routine that will :"
^DIC(9.4,60,22,13,"PAH",144,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",144,1,11,0)="1. Look for entries in PRESCRIPTION SUSPENSE file #(52.5) affected by "
^DIC(9.4,60,22,13,"PAH",144,1,12,0)="   the problem above and will reset the ""CMP"" cross-reference for entries"
^DIC(9.4,60,22,13,"PAH",144,1,13,0)="   within 6 months from the date of install that have not been printed."
^DIC(9.4,60,22,13,"PAH",144,1,14,0)="   If there are any ""CMP"" entries existing that do not have a"
^DIC(9.4,60,22,13,"PAH",144,1,15,0)="   corresponding internal entry number in the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",144,1,16,0)="   SUSPENSE file (#52.5), the ""CMP"" entry will be deleted."
^DIC(9.4,60,22,13,"PAH",144,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",144,1,18,0)="2. During Installation of this patch the user will be asked: ""Queue the"
^DIC(9.4,60,22,13,"PAH",144,1,19,0)="   Post-Install to run at what Date@Time:  "". If the prompt is not answered,"
^DIC(9.4,60,22,13,"PAH",144,1,20,0)="   the patch WILL NOT be installed. After the post install routine "
^DIC(9.4,60,22,13,"PAH",144,1,21,0)="   is run to completion at the time the user indicated, a MailMan message "
^DIC(9.4,60,22,13,"PAH",144,1,22,0)="   with the subject ""PRESCRIPTION SUSPENSE File (#52.5) reset ""CMP"" XRef"" "
^DIC(9.4,60,22,13,"PAH",144,1,23,0)="   containing the list of prescriptions will be sent to the person installing "
^DIC(9.4,60,22,13,"PAH",144,1,24,0)="   the patch."
^DIC(9.4,60,22,13,"PAH",144,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",144,1,26,0)="3. It is possible that an old prescription in a non-transmitted state might"
^DIC(9.4,60,22,13,"PAH",144,1,27,0)="   be reset to a current division and be set up for transmission to CMOP."
^DIC(9.4,60,22,13,"PAH",144,1,28,0)="   Please review the mailman report and make modifications if necessary "
^DIC(9.4,60,22,13,"PAH",144,1,29,0)="   before turning the CMOP transmission back on."
^DIC(9.4,60,22,13,"PAH",144,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",144,1,31,0)="NOTE: ** THE POST-INSTALL SHOULD BE QUEUED TO RUN AT OFF-PEAK HOURS NOT"
^DIC(9.4,60,22,13,"PAH",144,1,32,0)="         INTERFERING WITH CMOP TRANSMISSION TIMES AT YOUR SITE. **"
^DIC(9.4,60,22,13,"PAH",145,0)="157 SEQ #149^3040521^1"
^DIC(9.4,60,22,13,"PAH",145,1,0)="^^142^142^3040521"
^DIC(9.4,60,22,13,"PAH",145,1,1,0)="The Chief Business Office (CBO) is requesting modifications to several"
^DIC(9.4,60,22,13,"PAH",145,1,2,0)="Veterans Health Information Systems and Technology Architecture (VistA)"
^DIC(9.4,60,22,13,"PAH",145,1,3,0)="packages to support implementation of VHA Directive 2002-049 - ""Combat"
^DIC(9.4,60,22,13,"PAH",145,1,4,0)="Veterans Are Eligible For Medical Services For 2-Years After Separation"
^DIC(9.4,60,22,13,"PAH",145,1,5,0)="From Military Service Notwithstanding Lack Of Evidence For Service"
^DIC(9.4,60,22,13,"PAH",145,1,6,0)="Connection"", which iterates VA's policy to provide medical care and other"
^DIC(9.4,60,22,13,"PAH",145,1,7,0)="medical services to combat veterans despite the absence of proof of"
^DIC(9.4,60,22,13,"PAH",145,1,8,0)="service connection."
^DIC(9.4,60,22,13,"PAH",145,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,10,0)="Software to support the Combat Veteran (CV) initiative is being developed"
^DIC(9.4,60,22,13,"PAH",145,1,11,0)="and introduced in a phased implementation strategy. The reason for this"
^DIC(9.4,60,22,13,"PAH",145,1,12,0)="type of deployment is due to the complexity of the functionality and the"
^DIC(9.4,60,22,13,"PAH",145,1,13,0)="number of product line dependencies. Phase I: Combat Veteran Interim"
^DIC(9.4,60,22,13,"PAH",145,1,14,0)="Solution (CVIS) was a VistA only solution that involved development in"
^DIC(9.4,60,22,13,"PAH",145,1,15,0)="the Integrated Billing (IB) and Registration/Enrollment product lines."
^DIC(9.4,60,22,13,"PAH",145,1,16,0)="It provided the logic to identify those veterans who met the criteria for"
^DIC(9.4,60,22,13,"PAH",145,1,17,0)="the combat veteran eligibility and provided billing reports"
^DIC(9.4,60,22,13,"PAH",145,1,18,0)="cross-referenced against this identifier to aid in the copayment billing"
^DIC(9.4,60,22,13,"PAH",145,1,19,0)="process. Phase II of this initiative will involve multiple product lines"
^DIC(9.4,60,22,13,"PAH",145,1,20,0)="and additional VistA only development. The main goals of Phase II will be"
^DIC(9.4,60,22,13,"PAH",145,1,21,0)="to fully automate the copayment billing processing of combat vets based on"
^DIC(9.4,60,22,13,"PAH",145,1,22,0)="episode of care by providing the appropriate questions at check-out as"
^DIC(9.4,60,22,13,"PAH",145,1,23,0)="supplied by CPRS."
^DIC(9.4,60,22,13,"PAH",145,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,25,0)="Product lines that have a stake in Phase II development include"
^DIC(9.4,60,22,13,"PAH",145,1,26,0)="Enrollment/Registration (VistA), IB, Outpatient Pharmacy, Consolidated"
^DIC(9.4,60,22,13,"PAH",145,1,27,0)="Mail Outpatient Pharmacy (CMOP), CPRS/TIU, Patient Care Encounter (PCE),"
^DIC(9.4,60,22,13,"PAH",145,1,28,0)="Ambulatory Care, Event Capture, Scheduling and PTF. The National Patient"
^DIC(9.4,60,22,13,"PAH",145,1,29,0)="Care Database (NPCD) will also require modifications to capture workload"
^DIC(9.4,60,22,13,"PAH",145,1,30,0)="reporting. The patches are listed below in the order that they must be"
^DIC(9.4,60,22,13,"PAH",145,1,31,0)="installed:"
^DIC(9.4,60,22,13,"PAH",145,1,32,0)="Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",145,1,33,0)="    PSO*7*157"
^DIC(9.4,60,22,13,"PAH",145,1,34,0)="    PSX*2*50"
^DIC(9.4,60,22,13,"PAH",145,1,35,0)="PCE/PTF/Event Capture/Scheduling  - PIMS Host file"
^DIC(9.4,60,22,13,"PAH",145,1,36,0)="    PX*1.0*130"
^DIC(9.4,60,22,13,"PAH",145,1,37,0)="    SD*5.3*325"
^DIC(9.4,60,22,13,"PAH",145,1,38,0)="    DG*5.3*565"
^DIC(9.4,60,22,13,"PAH",145,1,39,0)="    EC*2.0*54"
^DIC(9.4,60,22,13,"PAH",145,1,40,0)="Integrated Billing"
^DIC(9.4,60,22,13,"PAH",145,1,41,0)="    IB*2.0*247"
^DIC(9.4,60,22,13,"PAH",145,1,42,0)="CPRS"
^DIC(9.4,60,22,13,"PAH",145,1,43,0)="    OR*3.0*190"
^DIC(9.4,60,22,13,"PAH",145,1,44,0)="Product Features"
^DIC(9.4,60,22,13,"PAH",145,1,45,0)="There are three main areas addressed by this enhancement:"
^DIC(9.4,60,22,13,"PAH",145,1,46,0)="a. Identification/Notification of a CV Status veteran seeking medical care"
^DIC(9.4,60,22,13,"PAH",145,1,47,0)="   - The clinical applications shall obtain the CV Status for those"
^DIC(9.4,60,22,13,"PAH",145,1,48,0)="     veterans who qualify as such per the directive."
^DIC(9.4,60,22,13,"PAH",145,1,49,0)="   - The CV Status identification shall be displayed to the appropriate"
^DIC(9.4,60,22,13,"PAH",145,1,50,0)="     audience (pharmacist, clinician providing care, intake personnel,"
^DIC(9.4,60,22,13,"PAH",145,1,51,0)="     schedulers, etc.)."
^DIC(9.4,60,22,13,"PAH",145,1,52,0)="   - Provider shall be able to identify whether care provided CV veteran"
^DIC(9.4,60,22,13,"PAH",145,1,53,0)="     was for a condition potentially related to combat service in the same"
^DIC(9.4,60,22,13,"PAH",145,1,54,0)="     manner as identification of exposure related care; care for SC"
^DIC(9.4,60,22,13,"PAH",145,1,55,0)="     conditions, etc."
^DIC(9.4,60,22,13,"PAH",145,1,56,0)="b. Assistance in the communication of a treatment being determined as"
^DIC(9.4,60,22,13,"PAH",145,1,57,0)="   Combat Related"
^DIC(9.4,60,22,13,"PAH",145,1,58,0)="   - Provide a means for the billing and pharmacy software package to"
^DIC(9.4,60,22,13,"PAH",145,1,59,0)="     identify these patients and services provided care for a combat"
^DIC(9.4,60,22,13,"PAH",145,1,60,0)="     related condition."
^DIC(9.4,60,22,13,"PAH",145,1,61,0)="c. Automatically precludes inpatient and outpatient medical care,"
^DIC(9.4,60,22,13,"PAH",145,1,62,0)="   prescription and Long-term care copayments for CV Status veterans whose"
^DIC(9.4,60,22,13,"PAH",145,1,63,0)="   treatment/service has been deemed combat related."
^DIC(9.4,60,22,13,"PAH",145,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,65,0)="This is the Outpatient Pharmacy patch PSO*7*157 that provides the"
^DIC(9.4,60,22,13,"PAH",145,1,66,0)="functionality changes to accommodate the new copay classification called"
^DIC(9.4,60,22,13,"PAH",145,1,67,0)="""Combat Veteran""."
^DIC(9.4,60,22,13,"PAH",145,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,69,0)="1. For the following options, when creating a new order, renewing an"
^DIC(9.4,60,22,13,"PAH",145,1,70,0)="existing order, copying an existing order to a new order, or editing an"
^DIC(9.4,60,22,13,"PAH",145,1,71,0)="existing order that results in a new order, the copay status of the"
^DIC(9.4,60,22,13,"PAH",145,1,72,0)="prescription needs to be determined for billing purposes."
^DIC(9.4,60,22,13,"PAH",145,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,74,0)="a. Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",145,1,75,0)="b. TPB Rx (Prescription) Entry [PSO TPB RX ENTRY]"
^DIC(9.4,60,22,13,"PAH",145,1,76,0)="c. Barcode Batch Prescription Entry [PSO BATCH BARCODE]"
^DIC(9.4,60,22,13,"PAH",145,1,77,0)="d. Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",145,1,78,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,79,0)="Depending on the patient eligibility, the software currently provides"
^DIC(9.4,60,22,13,"PAH",145,1,80,0)="the following copay exemption questions to the pharmacist during"
^DIC(9.4,60,22,13,"PAH",145,1,81,0)="prescription finishing process:"
^DIC(9.4,60,22,13,"PAH",145,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,83,0)="""Is this Rx for treatment of Vietnam-Era Herbicide (Agent Orange)"
^DIC(9.4,60,22,13,"PAH",145,1,84,0)="exposure?"""
^DIC(9.4,60,22,13,"PAH",145,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,86,0)="""Is this Rx for treatment of ionizing radiation exposure?"""
^DIC(9.4,60,22,13,"PAH",145,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,88,0)="""Is this Rx for treatment of environmental contaminant exposure during the"
^DIC(9.4,60,22,13,"PAH",145,1,89,0)="Persian Gulf War?"""
^DIC(9.4,60,22,13,"PAH",145,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,91,0)="""Is this Rx for treatment of Military Sexual Trauma?"""
^DIC(9.4,60,22,13,"PAH",145,1,92,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,93,0)="""Is this Rx related to treatment of Head and/or Neck Cancer?"""
^DIC(9.4,60,22,13,"PAH",145,1,94,0)="and/or Neck Cancer veterans;"
^DIC(9.4,60,22,13,"PAH",145,1,95,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,96,0)="To fulfill the Directive 2002-049, this patch will add the following"
^DIC(9.4,60,22,13,"PAH",145,1,97,0)="Combat Veteran (CV) copay exemption question to the current copay list:"
^DIC(9.4,60,22,13,"PAH",145,1,98,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,99,0)="""Is this Rx potentially for treatment related to Combat?"""
^DIC(9.4,60,22,13,"PAH",145,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,101,0)="In the event that a patient is eligible for more than one copay"
^DIC(9.4,60,22,13,"PAH",145,1,102,0)="exemption, the CV prompt will be presented to the pharmacist first."
^DIC(9.4,60,22,13,"PAH",145,1,103,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,104,0)="A 'YES' or 'NO' response will be stored in the COMBAT VETERAN field"
^DIC(9.4,60,22,13,"PAH",145,1,105,0)="(#122) of the PRESCRIPTION file (#52). This is a new field introduced in"
^DIC(9.4,60,22,13,"PAH",145,1,106,0)="this patch."
^DIC(9.4,60,22,13,"PAH",145,1,107,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,108,0)="2. The Integration Agreement (IA) 2534 provides CPRS the copay related"
^DIC(9.4,60,22,13,"PAH",145,1,109,0)="questions that need to be asked during the outpatient medication order"
^DIC(9.4,60,22,13,"PAH",145,1,110,0)="entry process. This IA is modified to include the CV copay classification,"
^DIC(9.4,60,22,13,"PAH",145,1,111,0)="if applicable."
^DIC(9.4,60,22,13,"PAH",145,1,112,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,113,0)="3. The PENDING OUTPATIENT ORDERS file (#52.41) that stores the pharmacy"
^DIC(9.4,60,22,13,"PAH",145,1,114,0)="orders (new/renew) entered via CPRS is modified to include the provider"
^DIC(9.4,60,22,13,"PAH",145,1,115,0)="response to the CV question. The provider response will be stored in the"
^DIC(9.4,60,22,13,"PAH",145,1,116,0)="COMBAT VETERAN field (#110.1) of the PENDING OUTPATIENT ORDERS file"
^DIC(9.4,60,22,13,"PAH",145,1,117,0)="(#52.41). The COMBAT VETERAN field (#110.1) is a new field introduced in"
^DIC(9.4,60,22,13,"PAH",145,1,118,0)="this patch."
^DIC(9.4,60,22,13,"PAH",145,1,119,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,120,0)="4. During the release of a prescription, medication copay exemptions are"
^DIC(9.4,60,22,13,"PAH",145,1,121,0)="re-evaluated to see if there is a change in the billing status. This logic"
^DIC(9.4,60,22,13,"PAH",145,1,122,0)="is modified to include the CV copay classification. If a copay exemption"
^DIC(9.4,60,22,13,"PAH",145,1,123,0)="question applies and is unanswered, a MailMan message is generated. This"
^DIC(9.4,60,22,13,"PAH",145,1,124,0)="message is sent to the pharmacist, ordering provider, and holders of the"
^DIC(9.4,60,22,13,"PAH",145,1,125,0)="PSO COPAY key, to get answers to the exemption questions and reset the"
^DIC(9.4,60,22,13,"PAH",145,1,126,0)="prescription copay status if needed, using the Reset Copay Status/Cancel"
^DIC(9.4,60,22,13,"PAH",145,1,127,0)="Charges [PSOCP RESET COPAY STATUS] option ."
^DIC(9.4,60,22,13,"PAH",145,1,128,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,129,0)="5. The Reset Copay Status/Cancel Charges [PSOCP RESET COPAY STATUS] option"
^DIC(9.4,60,22,13,"PAH",145,1,130,0)="is modified to include the CV copay classification wherever applicable."
^DIC(9.4,60,22,13,"PAH",145,1,131,0)=" "
^DIC(9.4,60,22,13,"PAH",145,1,132,0)="6. During label printing of a prescription, if a prescription is deemed"
^DIC(9.4,60,22,13,"PAH",145,1,133,0)="billable then the software does a check on the following copay exemption"
^DIC(9.4,60,22,13,"PAH",145,1,134,0)="fields of the PRESCRIPTION file (#52):"
^DIC(9.4,60,22,13,"PAH",145,1,135,0)="117          MILITARY SEXUAL TRAUMA"
^DIC(9.4,60,22,13,"PAH",145,1,136,0)="118          AGENT ORANGE EXPOSURE"
^DIC(9.4,60,22,13,"PAH",145,1,137,0)="119          IONIZING RADIATION EXPOSURE"
^DIC(9.4,60,22,13,"PAH",145,1,138,0)="120          ENVIRONMENTAL CONTAMINANT"
^DIC(9.4,60,22,13,"PAH",145,1,139,0)="121          HEAD AND/OR NECK CANCER"
^DIC(9.4,60,22,13,"PAH",145,1,140,0)="122          COMBAT VETERAN"
^DIC(9.4,60,22,13,"PAH",145,1,141,0)="If the prescription is identified as copay exempt, the software will"
^DIC(9.4,60,22,13,"PAH",145,1,142,0)="print ""NO COPAY""."
^DIC(9.4,60,22,13,"PAH",146,0)="162 SEQ #150^3040521^1"
^DIC(9.4,60,22,13,"PAH",146,1,0)="^^17^17^3040521"
^DIC(9.4,60,22,13,"PAH",146,1,1,0)="This patch will fix two similar issues regarding missing text"
^DIC(9.4,60,22,13,"PAH",146,1,2,0)="on the printed prescription labels."
^DIC(9.4,60,22,13,"PAH",146,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",146,1,4,0)="The two issues this patch resolves are:"
^DIC(9.4,60,22,13,"PAH",146,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",146,1,6,0)="1.  When printing prescription labels there is a potential that part "
^DIC(9.4,60,22,13,"PAH",146,1,7,0)="    of the Narrative Text lines will be truncated.  Modifications"
^DIC(9.4,60,22,13,"PAH",146,1,8,0)="    have been made to resolve this problem while preserving the "
^DIC(9.4,60,22,13,"PAH",146,1,9,0)="    narrative text format entered by the customer.  The text that "
^DIC(9.4,60,22,13,"PAH",146,1,10,0)="    was previously truncated will now be moved to a new line."
^DIC(9.4,60,22,13,"PAH",146,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",146,1,12,0)="2.  When printing prescription labels there is a potential that some "
^DIC(9.4,60,22,13,"PAH",146,1,13,0)="    lines will be skipped from printing on the prescription in the"
^DIC(9.4,60,22,13,"PAH",146,1,14,0)="    warning label section.  This issue was happening in rare cases"
^DIC(9.4,60,22,13,"PAH",146,1,15,0)="    when lines in the warning label had been deleted and new lines"
^DIC(9.4,60,22,13,"PAH",146,1,16,0)="    were added.  Modifications have been made to print the warning"
^DIC(9.4,60,22,13,"PAH",146,1,17,0)="    labels lines when this scenario is encountered."
^DIC(9.4,60,22,13,"PAH",147,0)="163 SEQ #151^3040521^1"
^DIC(9.4,60,22,13,"PAH",147,1,0)="^^16^16^3040521"
^DIC(9.4,60,22,13,"PAH",147,1,1,0)="1. DAY-1202-41933"
^DIC(9.4,60,22,13,"PAH",147,1,2,0)="   An internal problem in the software was causing the content of the"
^DIC(9.4,60,22,13,"PAH",147,1,3,0)="   comment field, entered when a prescription was discontinued, to be "
^DIC(9.4,60,22,13,"PAH",147,1,4,0)="   replaced by a 0 (zero). This problem was detected when printing the"
^DIC(9.4,60,22,13,"PAH",147,1,5,0)="   Activity Log for the discontinued prescription. The comment field for"
^DIC(9.4,60,22,13,"PAH",147,1,6,0)="   the DISCONTINUED activity was displaying a 0 (zero) instead of the "
^DIC(9.4,60,22,13,"PAH",147,1,7,0)="   original comments entered by the user who discontinued the"
^DIC(9.4,60,22,13,"PAH",147,1,8,0)="   prescription. Once this patch is installed this problem will be"
^DIC(9.4,60,22,13,"PAH",147,1,9,0)="   resolved."
^DIC(9.4,60,22,13,"PAH",147,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",147,1,11,0)="2. SPO-0104-50404"
^DIC(9.4,60,22,13,"PAH",147,1,12,0)="   An internal problem in the software was causing an error during the"
^DIC(9.4,60,22,13,"PAH",147,1,13,0)="   Renewal process. This error occurred when a Transitional Pharmacy"
^DIC(9.4,60,22,13,"PAH",147,1,14,0)="   Benefit prescription was renewed and the PATIENT STATUS field (#3)"
^DIC(9.4,60,22,13,"PAH",147,1,15,0)="   of the PHARMACY PATIENT file (#55) had not previously been set."
^DIC(9.4,60,22,13,"PAH",147,1,16,0)="   Once this patch is installed this problem will be resolved."
^DIC(9.4,60,22,13,"PAH",148,0)="132 SEQ #152^3040521^1"
^DIC(9.4,60,22,13,"PAH",148,1,0)="^^11^11^3040521"
^DIC(9.4,60,22,13,"PAH",148,1,1,0)="Joint Commission for Accreditation of Healthcare Organizations (JCAHO)"
^DIC(9.4,60,22,13,"PAH",148,1,2,0)="requires that patients' use of OTC medications, Herbal supplements,"
^DIC(9.4,60,22,13,"PAH",148,1,3,0)="medications prescribed by the VA but purchased by the patient at an"
^DIC(9.4,60,22,13,"PAH",148,1,4,0)="outside pharmacy, and medications prescribed by providers outside the VA"
^DIC(9.4,60,22,13,"PAH",148,1,5,0)="be documented in patients' medical records.  These four categories of"
^DIC(9.4,60,22,13,"PAH",148,1,6,0)="medications will hereafter be referred to as Non-VA Meds. In September"
^DIC(9.4,60,22,13,"PAH",148,1,7,0)="2002, a team with members from different applications was put together to"
^DIC(9.4,60,22,13,"PAH",148,1,8,0)="come up with a national solution to address this requirement. The"
^DIC(9.4,60,22,13,"PAH",148,1,9,0)="applications involved in this project are Computerized Patient Record"
^DIC(9.4,60,22,13,"PAH",148,1,10,0)="System (CPRS), Outpatient Pharmacy, Pharmacy Data Management, Inpatient"
^DIC(9.4,60,22,13,"PAH",148,1,11,0)="Medications and National Drug File (NDF)."
^DIC(9.4,60,22,13,"PAH",149,0)="176 SEQ #153^3040702^1"
^DIC(9.4,60,22,13,"PAH",149,1,0)="^^10^10^3040702"
^DIC(9.4,60,22,13,"PAH",149,1,1,0)="This patch addresses the problem introduced by the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",149,1,2,0)="patch PSO*7*155."
^DIC(9.4,60,22,13,"PAH",149,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",149,1,4,0)="In the Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE] option,"
^DIC(9.4,60,22,13,"PAH",149,1,5,0)="the print by 'Clinic' function was not working correctly after installing"
^DIC(9.4,60,22,13,"PAH",149,1,6,0)="the patch PSO*7*155. One of the problems was related to queuing the report"
^DIC(9.4,60,22,13,"PAH",149,1,7,0)="to the printer. The report would show on the screen instead of the"
^DIC(9.4,60,22,13,"PAH",149,1,8,0)="printer. It also resolves the problem ""device or file not open"" reported"
^DIC(9.4,60,22,13,"PAH",149,1,9,0)="in NOISs LEB-0404-21298 and NCH-0404-41348. This patch fixes all problems"
^DIC(9.4,60,22,13,"PAH",149,1,10,0)="introduced by patch PSO*7*155."
^DIC(9.4,60,22,13,"PAH",150,0)="171 SEQ #154^3040702^1"
^DIC(9.4,60,22,13,"PAH",150,1,0)="^^20^20^3040702"
^DIC(9.4,60,22,13,"PAH",150,1,1,0)=" If a Pharmacist selects Multiple prescriptions in the Patient"
^DIC(9.4,60,22,13,"PAH",150,1,2,0)=" Prescription option ([PSO LM BACKDOOR ORDERS]) and one or more of these"
^DIC(9.4,60,22,13,"PAH",150,1,3,0)=" prescriptions are 'Pending', the possibility exists that another"
^DIC(9.4,60,22,13,"PAH",150,1,4,0)=" Pharmacist could have previously run the Complete Orders from OERR"
^DIC(9.4,60,22,13,"PAH",150,1,5,0)=" ([PSO LMOE FINISH]) option and already selected one of these orders to"
^DIC(9.4,60,22,13,"PAH",150,1,6,0)=" finish.  Locking on the pending order does not occur until the"
^DIC(9.4,60,22,13,"PAH",150,1,7,0)=" pharmacist pulls up that order to edit it. Once an order is finished,"
^DIC(9.4,60,22,13,"PAH",150,1,8,0)=" it is removed from the PENDING OUTPATIENT ORDERS file (#54.21). If the"
^DIC(9.4,60,22,13,"PAH",150,1,9,0)=" very last entry in the pending file is the one being finished by the"
^DIC(9.4,60,22,13,"PAH",150,1,10,0)=" other pharmacist, once it is removed, the next entry added to the "
^DIC(9.4,60,22,13,"PAH",150,1,11,0)=" ending file will contain the same internal entry number. If this new"
^DIC(9.4,60,22,13,"PAH",150,1,12,0)=" entry is a new order  (instead of a discontinued order or something"
^DIC(9.4,60,22,13,"PAH",150,1,13,0)=" else), when the first pharmacist gets to that item from his selection"
^DIC(9.4,60,22,13,"PAH",150,1,14,0)=" list, the information that is displayed is from the ""New"" order. So the"
^DIC(9.4,60,22,13,"PAH",150,1,15,0)=" pharmacist could unknowingly finish the prescription thinking it was"
^DIC(9.4,60,22,13,"PAH",150,1,16,0)=" for the patient that he is viewing on the profile . The order does get"
^DIC(9.4,60,22,13,"PAH",150,1,17,0)=" filed under the correct patient, just not the patient that the 1st"
^DIC(9.4,60,22,13,"PAH",150,1,18,0)=" pharmacist was processing. This patch corrects this problem by"
^DIC(9.4,60,22,13,"PAH",150,1,19,0)=" verifying that the pending order is for the same patient that the"
^DIC(9.4,60,22,13,"PAH",150,1,20,0)=" pharmacist is viewing."
^DIC(9.4,60,22,13,"PAH",151,0)="175 SEQ #155^3040903^1"
^DIC(9.4,60,22,13,"PAH",151,1,0)="^^55^55^3040903"
^DIC(9.4,60,22,13,"PAH",151,1,1,0)="The VistA Fee Basis Package will be replaced by a new application in a "
^DIC(9.4,60,22,13,"PAH",151,1,2,0)="phased approach. The new application will be hosted by the Health "
^DIC(9.4,60,22,13,"PAH",151,1,3,0)="Administration Center, which is located at Denver, CO. A future phase of "
^DIC(9.4,60,22,13,"PAH",151,1,4,0)="the VistA Fee replacement project will have the pharmacy invoices entered "
^DIC(9.4,60,22,13,"PAH",151,1,5,0)="and processed using the Fee replacement system."
^DIC(9.4,60,22,13,"PAH",151,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",151,1,7,0)="The Nightly Management Data Compile Job [PSO MGMT NIGHTLY COMPILE] option"
^DIC(9.4,60,22,13,"PAH",151,1,8,0)="is scheduled to run nightly. This option populates the OUTPATIENT PHARMACY"
^DIC(9.4,60,22,13,"PAH",151,1,9,0)="MANAGEMENT DATA file (#59.12) with cost related data from the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",151,1,10,0)="file (#52), and the local VistA FEE BASIS PHARMACY INVOICE file (#162.1)"
^DIC(9.4,60,22,13,"PAH",151,1,11,0)="for fee basis patients. Accessing the FEE BASIS PHARMACY INVOICE file"
^DIC(9.4,60,22,13,"PAH",151,1,12,0)="(#162.1) by Outpatient Pharmacy is provided by Integration Agreement (IA)"
^DIC(9.4,60,22,13,"PAH",151,1,13,0)="203. With the VistA Fee Basis Package migrating to a new platform, the Fee"
^DIC(9.4,60,22,13,"PAH",151,1,14,0)="Basis Encapsulation project is replacing IA 203 with IA 4395. IA 4395 will"
^DIC(9.4,60,22,13,"PAH",151,1,15,0)="provide Outpatient Pharmacy with the fee basis prescription count and cost"
^DIC(9.4,60,22,13,"PAH",151,1,16,0)="data either from the local VistA Fee Basis file or from the Fee "
^DIC(9.4,60,22,13,"PAH",151,1,17,0)="Replacement system. This will isolate the Outpatient Pharmacy from future"
^DIC(9.4,60,22,13,"PAH",151,1,18,0)="changes as the fee replacement system is implemented. This patch will"
^DIC(9.4,60,22,13,"PAH",151,1,19,0)="modify the Nightly Management Data Compile Job [PSO MGMT NIGHTLY COMPILE]"
^DIC(9.4,60,22,13,"PAH",151,1,20,0)="option, to make a call to the new API, $$RXSUM^FBRXUTL(), documented by IA"
^DIC(9.4,60,22,13,"PAH",151,1,21,0)="4395 that provides the fee basis prescription count and cost for a given"
^DIC(9.4,60,22,13,"PAH",151,1,22,0)="date."
^DIC(9.4,60,22,13,"PAH",151,1,23,0)="As the VistA Fee Basis Package is moving towards a National database, the"
^DIC(9.4,60,22,13,"PAH",151,1,24,0)="new API may also return a string value of "
^DIC(9.4,60,22,13,"PAH",151,1,25,0)="""-1^exception_number^exception_text"", indicating an exception has "
^DIC(9.4,60,22,13,"PAH",151,1,26,0)="occurred. To accommodate this exception, this patch will also generate a"
^DIC(9.4,60,22,13,"PAH",151,1,27,0)="new mail message to the holders of the PSORPH security key. Following is"
^DIC(9.4,60,22,13,"PAH",151,1,28,0)="an example of this mail message:"
^DIC(9.4,60,22,13,"PAH",151,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",151,1,30,0)="Subj: FEE Basis Cost Data - Incomplete Nightly Job  [#156131]"
^DIC(9.4,60,22,13,"PAH",151,1,31,0)="04/29/04@18:41  9 lines"
^DIC(9.4,60,22,13,"PAH",151,1,32,0)="From: OUTPATIENT PHARMACY PACKAGE  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",151,1,33,0)="-------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",151,1,34,0)="**************************************************"
^DIC(9.4,60,22,13,"PAH",151,1,35,0)="*** FEE Basis Cost data was not collected for  ***"
^DIC(9.4,60,22,13,"PAH",151,1,36,0)="*** the period 04/26/04 to 04/29/04.           ***"
^DIC(9.4,60,22,13,"PAH",151,1,37,0)="***                                            ***"
^DIC(9.4,60,22,13,"PAH",151,1,38,0)="*** The reason reported was:                   ***"
^DIC(9.4,60,22,13,"PAH",151,1,39,0)="*** Valid station number not specified         ***"
^DIC(9.4,60,22,13,"PAH",151,1,40,0)="***                                            ***"
^DIC(9.4,60,22,13,"PAH",151,1,41,0)="*** You may have to manually recompile this    ***"
^DIC(9.4,60,22,13,"PAH",151,1,42,0)="*** data at a later date.                      ***"
^DIC(9.4,60,22,13,"PAH",151,1,43,0)="**************************************************"
^DIC(9.4,60,22,13,"PAH",151,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",151,1,45,0)="This message will help in the future for site to manually recompile the"
^DIC(9.4,60,22,13,"PAH",151,1,46,0)="missing fee basis prescription count and cost for the noted dates from the"
^DIC(9.4,60,22,13,"PAH",151,1,47,0)="Fee Replacement system."
^DIC(9.4,60,22,13,"PAH",151,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",151,1,49,0)="Note:"
^DIC(9.4,60,22,13,"PAH",151,1,50,0)="The Cost of Prescriptions [PSO MGMT REPORT RX COSTS] option and the Cost"
^DIC(9.4,60,22,13,"PAH",151,1,51,0)="of Prescriptions [PSO MGMT MONTHLY RX COSTS] option, provides the daily"
^DIC(9.4,60,22,13,"PAH",151,1,52,0)="and monthly prescription cost report. While testing this patch it was"
^DIC(9.4,60,22,13,"PAH",151,1,53,0)="observed that the average participating pharmacy prescription cost under"
^DIC(9.4,60,22,13,"PAH",151,1,54,0)="the column heading ""AVG PARTIC PHARM RX"", was incorrect and displays a"
^DIC(9.4,60,22,13,"PAH",151,1,55,0)="zero value even with data present. This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",152,0)="166 SEQ #156^3040903^1"
^DIC(9.4,60,22,13,"PAH",152,1,0)="^^36^36^3040903"
^DIC(9.4,60,22,13,"PAH",152,1,1,0)="1. CHA-0204-30749"
^DIC(9.4,60,22,13,"PAH",152,1,2,0)="   Currently, if the NARCOTICS NUMBERED DIFFERENTLY (#1000) field in the"
^DIC(9.4,60,22,13,"PAH",152,1,3,0)="   OUTPATIENT SITE (#59) file is set to Yes, all prescriptions that have"
^DIC(9.4,60,22,13,"PAH",152,1,4,0)="   a drug with a DEA, SPECIAL HDLG (#3) field if file DRUG (#50) that contains"
^DIC(9.4,60,22,13,"PAH",152,1,5,0)="   an ""A"" (Narcotics) are numbered differently than other prescriptions.  This"
^DIC(9.4,60,22,13,"PAH",152,1,6,0)="   patch will change the check of the DEA, SPECIAL HDLG (#3) field in"
^DIC(9.4,60,22,13,"PAH",152,1,7,0)="   the DRUG (#50) file to check for all Schedule II drugs, denoted by"
^DIC(9.4,60,22,13,"PAH",152,1,8,0)="   a ""2"" in the DEA, SPECIAL HDLG (#3) field, instead of just an ""A""."
^DIC(9.4,60,22,13,"PAH",152,1,9,0)="   "
^DIC(9.4,60,22,13,"PAH",152,1,10,0)="2. CAH-1203-31567, DUB-0204-30722, NYH-120311822, WPB-1203-31609"
^DIC(9.4,60,22,13,"PAH",152,1,11,0)="   The functionality exists to modify the DEA, SPECIAL HDLG (#3) field"
^DIC(9.4,60,22,13,"PAH",152,1,12,0)="   of the DRUG (#50) file to contain an ""F"".  This code signifies that"
^DIC(9.4,60,22,13,"PAH",152,1,13,0)="   this drug in not refillable.  If the # OF REFILLS (#9) field of the"
^DIC(9.4,60,22,13,"PAH",152,1,14,0)="   PRESCRIPTION (#52) file is modified after the DEA, SPECIAL HDLG (#3)"
^DIC(9.4,60,22,13,"PAH",152,1,15,0)="   field has been changed to an ""F"", the # OF REFILLS (#9) field for"
^DIC(9.4,60,22,13,"PAH",152,1,16,0)="   the prescription is automatically reset to 0.  This is causing the"
^DIC(9.4,60,22,13,"PAH",152,1,17,0)="   prescription display to show the 'Refills Remaining' as a negative"
^DIC(9.4,60,22,13,"PAH",152,1,18,0)="   number. This patch will change how this situation is handled.  If a"
^DIC(9.4,60,22,13,"PAH",152,1,19,0)="   prescription has refills and the DEA, SPECIAL HDLG (#3) field has been"
^DIC(9.4,60,22,13,"PAH",152,1,20,0)="   changed to include an ""F"", the # OF REFILLS (#9) field will be changed to"
^DIC(9.4,60,22,13,"PAH",152,1,21,0)="   the actual number of refills given and the following message will be"
^DIC(9.4,60,22,13,"PAH",152,1,22,0)="   displayed:"
^DIC(9.4,60,22,13,"PAH",152,1,23,0)="   ""The drug has been changed and no longer allows refills."""
^DIC(9.4,60,22,13,"PAH",152,1,24,0)="   If no refills had been given, the # OF REFILLS (#9) field will be set to"
^DIC(9.4,60,22,13,"PAH",152,1,25,0)="   0 and the following message will be displayed:"
^DIC(9.4,60,22,13,"PAH",152,1,26,0)="   ""No refills allowed on this drug."""
^DIC(9.4,60,22,13,"PAH",152,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",152,1,28,0)="3. FGH-1203-31351"
^DIC(9.4,60,22,13,"PAH",152,1,29,0)="   If a prescription was transmitted to CMOP, then put on hold, it"
^DIC(9.4,60,22,13,"PAH",152,1,30,0)="   removes the fill date. It is then released and when the hold is"
^DIC(9.4,60,22,13,"PAH",152,1,31,0)="   removed, it does not prompt for a fill date since it is released,"
^DIC(9.4,60,22,13,"PAH",152,1,32,0)="   therefore the possibility exists that if the Fill Date is blank the"
^DIC(9.4,60,22,13,"PAH",152,1,33,0)="   subsequent fills will be rejected by the CMOP transmission."
^DIC(9.4,60,22,13,"PAH",152,1,34,0)="   This patch will prompt the user for a fill date with a default of"
^DIC(9.4,60,22,13,"PAH",152,1,35,0)="   the released date if a prescription is unheld after it is released"
^DIC(9.4,60,22,13,"PAH",152,1,36,0)="   and fill date field is blank."
^DIC(9.4,60,22,13,"PAH",153,0)="172 SEQ #157^3040917^1"
^DIC(9.4,60,22,13,"PAH",153,1,0)="^^21^21^3040917"
^DIC(9.4,60,22,13,"PAH",153,1,1,0)=" 1. LEX-0303-42244 & CTX-0504-70229"
^DIC(9.4,60,22,13,"PAH",153,1,2,0)="    While finishing a prescription using the Patient Prescription"
^DIC(9.4,60,22,13,"PAH",153,1,3,0)="    Processing option (PSO LM BACKDOOR ORDERS) for a controlled"
^DIC(9.4,60,22,13,"PAH",153,1,4,0)="    substance the number of refills could be set to eleven instead"
^DIC(9.4,60,22,13,"PAH",153,1,5,0)="    the maximum aloud, which is five.  This patch will resolve this"
^DIC(9.4,60,22,13,"PAH",153,1,6,0)="    problem."
^DIC(9.4,60,22,13,"PAH",153,1,7,0)="    "
^DIC(9.4,60,22,13,"PAH",153,1,8,0)=" 2. HOU-0404-71083"
^DIC(9.4,60,22,13,"PAH",153,1,9,0)="    When transmitting an HL7 message to the Optifill machine, the"
^DIC(9.4,60,22,13,"PAH",153,1,10,0)="    possibility exists that a carriage return could be included in"
^DIC(9.4,60,22,13,"PAH",153,1,11,0)="    the NTE2 segment.  This will cause the Optifill machine to reject"
^DIC(9.4,60,22,13,"PAH",153,1,12,0)="    the entire HL7 message.  This patch will resolve this problem."
^DIC(9.4,60,22,13,"PAH",153,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",153,1,14,0)=" 3. CLE-0404-40219"
^DIC(9.4,60,22,13,"PAH",153,1,15,0)="    When a pharmacist finishes an order using the Patient Prescription"
^DIC(9.4,60,22,13,"PAH",153,1,16,0)="    Processing option (PSO LM BACKDOOR ORDERS) for a patient and does"
^DIC(9.4,60,22,13,"PAH",153,1,17,0)="    not exit back to the menu prompt, the possibility exists that the"
^DIC(9.4,60,22,13,"PAH",153,1,18,0)="    patients order could still be locked.  This would prevent other"
^DIC(9.4,60,22,13,"PAH",153,1,19,0)="    pharmacists from accessing this order until the original pharmacist"
^DIC(9.4,60,22,13,"PAH",153,1,20,0)="    exits back to to the menu prompt.  This patch will resolve this"
^DIC(9.4,60,22,13,"PAH",153,1,21,0)="    problem."
^DIC(9.4,60,22,13,"PAH",154,0)="173 SEQ #158^3040924^1"
^DIC(9.4,60,22,13,"PAH",154,1,0)="^^5^5^3040924"
^DIC(9.4,60,22,13,"PAH",154,1,1,0)="  When using the option Print from Suspense File (PSO PNDLBL) the"
^DIC(9.4,60,22,13,"PAH",154,1,2,0)="  possibility exists that duplicate labels could be printed if"
^DIC(9.4,60,22,13,"PAH",154,1,3,0)="  this option was used previously and is still running.  This patch"
^DIC(9.4,60,22,13,"PAH",154,1,4,0)="  will resolve this issue by delaying the second job until the first"
^DIC(9.4,60,22,13,"PAH",154,1,5,0)="  job finishes."
^DIC(9.4,60,22,13,"PAH",155,0)="180 SEQ #159^3041015^1"
^DIC(9.4,60,22,13,"PAH",155,1,0)="^^6^6^3041015"
^DIC(9.4,60,22,13,"PAH",155,1,1,0)=" If a drug has been unmarked for Outpatient Pharmacy use by using the"
^DIC(9.4,60,22,13,"PAH",155,1,2,0)=" option Drug Enter/Edit [PSS DRUG ENTER/EDIT] then a pharmacist tries to"
^DIC(9.4,60,22,13,"PAH",155,1,3,0)=" refill a prescription that uses this drug, they will not be allowed."
^DIC(9.4,60,22,13,"PAH",155,1,4,0)=" This patch will modify this behavior by allowing a prescription to be"
^DIC(9.4,60,22,13,"PAH",155,1,5,0)=" refilled even after the drug has been unmarked for Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",155,1,6,0)=" use."
^DIC(9.4,60,22,13,"PAH",156,0)="156 SEQ #160^3041029^1"
^DIC(9.4,60,22,13,"PAH",156,1,0)="^^53^53^3041029"
^DIC(9.4,60,22,13,"PAH",156,1,1,0)=" There are three patches to support the Outpatient Pharmacy Automation "
^DIC(9.4,60,22,13,"PAH",156,1,2,0)=" Interface project. These patches should be installed separately in the "
^DIC(9.4,60,22,13,"PAH",156,1,3,0)=" following order: "
^DIC(9.4,60,22,13,"PAH",156,1,4,0)="                   PSO*7*156      Outpatient Pharmacy "
^DIC(9.4,60,22,13,"PAH",156,1,5,0)="                   PSS*1*82       Pharmacy Data Management "
^DIC(9.4,60,22,13,"PAH",156,1,6,0)="                   PSN*4*84       National Drug File "
^DIC(9.4,60,22,13,"PAH",156,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",156,1,8,0)=" They contain routines, templates, options, and data dictionary changes to "
^DIC(9.4,60,22,13,"PAH",156,1,9,0)=" implement the Outpatient Pharmacy Automation Interface features.  Please "
^DIC(9.4,60,22,13,"PAH",156,1,10,0)=" refer to the individual patch description of the other patches to get the "
^DIC(9.4,60,22,13,"PAH",156,1,11,0)=" names of the documentation files.  "
^DIC(9.4,60,22,13,"PAH",156,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",156,1,13,0)=" Each patch will share the same starting description with more detail "
^DIC(9.4,60,22,13,"PAH",156,1,14,0)=" for each patch in the corresponding namespace patch number.  There is "
^DIC(9.4,60,22,13,"PAH",156,1,15,0)=" only one installation guide.  It can be found on the anonymous "
^DIC(9.4,60,22,13,"PAH",156,1,16,0)=" directory.  The name of the installation guide is "
^DIC(9.4,60,22,13,"PAH",156,1,17,0)=" PS_OUTPATIENT_AUTOMATION_INTERFACE_IG.doc.  "
^DIC(9.4,60,22,13,"PAH",156,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",156,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",156,1,20,0)=" The patch enhances the current Health Level Seven (HL7) interface to "
^DIC(9.4,60,22,13,"PAH",156,1,21,0)=" ensure that the interface is compatible with all current Outpatient "
^DIC(9.4,60,22,13,"PAH",156,1,22,0)=" Pharmacy V. 7.0 automation systems used by the Veterans Affairs "
^DIC(9.4,60,22,13,"PAH",156,1,23,0)=" Medical Centers (VAMCs).  The current national VISTA HL7 interface is "
^DIC(9.4,60,22,13,"PAH",156,1,24,0)=" written to HL7 standard V. 2.2.  Automated dispensing systems, such as "
^DIC(9.4,60,22,13,"PAH",156,1,25,0)=" the Baker APS Pharmacy 2000, are currently using an interface written to "
^DIC(9.4,60,22,13,"PAH",156,1,26,0)=" V. 2.3.1 standard using locally developed software.  The automated "
^DIC(9.4,60,22,13,"PAH",156,1,27,0)=" dispensing systems have committed to be HL7 V. 2.4 compliant.  "
^DIC(9.4,60,22,13,"PAH",156,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",156,1,29,0)=" This patch includes the following new features: "
^DIC(9.4,60,22,13,"PAH",156,1,30,0)=" 1. Enhance the current Outpatient Pharmacy V. 7.0 HL7 interface to "
^DIC(9.4,60,22,13,"PAH",156,1,31,0)="    the current HL7 V. 2.4 standard.  "
^DIC(9.4,60,22,13,"PAH",156,1,32,0)=" 2. Creates a bi-directional interface.  The interface transmits "
^DIC(9.4,60,22,13,"PAH",156,1,33,0)="    outpatient pharmacy data to multiple vendor systems utilized by VAMCs "
^DIC(9.4,60,22,13,"PAH",156,1,34,0)="    and receives dispensed prescription data from the vendor systems.  "
^DIC(9.4,60,22,13,"PAH",156,1,35,0)=" 3. The dispense completion message received back from the vendor will "
^DIC(9.4,60,22,13,"PAH",156,1,36,0)="    automatically release the prescription in VISTA if the FILE RELEASE "
^DIC(9.4,60,22,13,"PAH",156,1,37,0)="    DATE/TIME field (#105.1) is set to YES in the PRESCRIPTION file (#52).  "
^DIC(9.4,60,22,13,"PAH",156,1,38,0)=" 4. The interface sends outpatient pharmacy prescription release "
^DIC(9.4,60,22,13,"PAH",156,1,39,0)="    information to the vendor once a prescription is manually released.  "
^DIC(9.4,60,22,13,"PAH",156,1,40,0)=" 5. The BusinessWare interface engine at each medical center is used "
^DIC(9.4,60,22,13,"PAH",156,1,41,0)="    to pass the HL7 data through from VISTA to the dispensing system.  "
^DIC(9.4,60,22,13,"PAH",156,1,42,0)="    There is no data manipulation on BusinessWare's part.  "
^DIC(9.4,60,22,13,"PAH",156,1,43,0)=" 6. Enhance the activity log entries for the sequence of events for a "
^DIC(9.4,60,22,13,"PAH",156,1,44,0)="    prescription's activity in the PRESCRIPTION file (#52).  "
^DIC(9.4,60,22,13,"PAH",156,1,45,0)=" 7. Add a fourth selection to the OUTPATIENT SITE file (#59), EXTERNAL "
^DIC(9.4,60,22,13,"PAH",156,1,46,0)="    INTERFACE field (#5).  This selection is titled 'SEND MARKED ORDERS "
^DIC(9.4,60,22,13,"PAH",156,1,47,0)="    AND PRINT LABEL'.  "
^DIC(9.4,60,22,13,"PAH",156,1,48,0)=" 8. This patch allows dispensing system printer(s) to be entered and used"
^DIC(9.4,60,22,13,"PAH",156,1,49,0)="    when selected, and the interface is in use, sending an HL7 message"
^DIC(9.4,60,22,13,"PAH",156,1,50,0)="    to the dispensing system."
^DIC(9.4,60,22,13,"PAH",156,1,51,0)=" 9. This patch added new functionality for reprinting Rxs and using the "
^DIC(9.4,60,22,13,"PAH",156,1,52,0)="    external interface.  If a reprint of an Rx is requested the user is "
^DIC(9.4,60,22,13,"PAH",156,1,53,0)="    asked if they want to resend the Rx to the external interface."
^DIC(9.4,60,22,13,"PAH",157,0)="189 SEQ #161^3041029^1"
^DIC(9.4,60,22,13,"PAH",157,1,0)="^^17^17^3041029"
^DIC(9.4,60,22,13,"PAH",157,1,1,0)="1. PSO*7*156 provided a two-way interface that returns a dispensing"
^DIC(9.4,60,22,13,"PAH",157,1,2,0)="message to VistA from the dispensing machine that indicates"
^DIC(9.4,60,22,13,"PAH",157,1,3,0)="dispensing of medication has completed.  When this dispensing message"
^DIC(9.4,60,22,13,"PAH",157,1,4,0)="is returned the first entry in the activity log for the prescription is"
^DIC(9.4,60,22,13,"PAH",157,1,5,0)="overwritten. This patch corrects this problem."
^DIC(9.4,60,22,13,"PAH",157,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",157,1,7,0)="2. When printing a prescription using a laser printer, the patient has a"
^DIC(9.4,60,22,13,"PAH",157,1,8,0)="language preference other than English, and more than one prescription is"
^DIC(9.4,60,22,13,"PAH",157,1,9,0)="entered and printed, text from the first prescription label is printing on"
^DIC(9.4,60,22,13,"PAH",157,1,10,0)="the prescription labels that follows."
^DIC(9.4,60,22,13,"PAH",157,1,11,0)="NOISs: SAM-0604-21393, BAC-1203-40321, WIM-0604-20277"
^DIC(9.4,60,22,13,"PAH",157,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",157,1,13,0)="3. When pulling an original fill early from suspense and printing"
^DIC(9.4,60,22,13,"PAH",157,1,14,0)="prescription labels using a laser printer the last dispense date is not"
^DIC(9.4,60,22,13,"PAH",157,1,15,0)="being updated correctly. When prescription are pulled from suspense the"
^DIC(9.4,60,22,13,"PAH",157,1,16,0)="fill date and the last dispense date should always reflect the date the fill"
^DIC(9.4,60,22,13,"PAH",157,1,17,0)="was pulled from suspense.  NOISs: HON-0904-62008, SAJ-0804-70774"
^DIC(9.4,60,22,13,"PAH",158,0)="159 SEQ #162^3041124^1"
^DIC(9.4,60,22,13,"PAH",158,1,0)="^^16^16^3041124"
^DIC(9.4,60,22,13,"PAH",158,1,1,0)=" 1. FAV-0501-71064, FGH-1199-32693, WIM-0704-21673, WPB-0604-31928"
^DIC(9.4,60,22,13,"PAH",158,1,2,0)="    and MAD-0504-40315"
^DIC(9.4,60,22,13,"PAH",158,1,3,0)="    When making an appointment using the [SDAM APPT MGT] Appointment"
^DIC(9.4,60,22,13,"PAH",158,1,4,0)="    Management or [SDMULTICLINIC] Multiple Clinic Display/Book options"
^DIC(9.4,60,22,13,"PAH",158,1,5,0)="    the possibility exists that an error could be generated in the"
^DIC(9.4,60,22,13,"PAH",158,1,6,0)="    program SDAMEVT or SDMUTL1.  This error is caused by the"
^DIC(9.4,60,22,13,"PAH",158,1,7,0)="    Outpatient Pharmacy programs responsible for returning"
^DIC(9.4,60,22,13,"PAH",158,1,8,0)="    prescription information in the Appointment options.  This patch"
^DIC(9.4,60,22,13,"PAH",158,1,9,0)="    will resolve this issue."
^DIC(9.4,60,22,13,"PAH",158,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",158,1,11,0)=" 2. SBY-0504-30082"
^DIC(9.4,60,22,13,"PAH",158,1,12,0)="    During a routine edit of a prescription using the option"
^DIC(9.4,60,22,13,"PAH",158,1,13,0)="    [PSO LM BACKDOOR ORDERS] (Patient Prescription Processing) the"
^DIC(9.4,60,22,13,"PAH",158,1,14,0)="    possibility exists to receive an 'undefined variable' error in"
^DIC(9.4,60,22,13,"PAH",158,1,15,0)="    the program PSOORED2 at line VER+4.  This patch will resolve this"
^DIC(9.4,60,22,13,"PAH",158,1,16,0)="    issue."
^DIC(9.4,60,22,13,"PAH",159,0)="182 SEQ #163^3041124^1"
^DIC(9.4,60,22,13,"PAH",159,1,0)="^^32^32^3041124"
^DIC(9.4,60,22,13,"PAH",159,1,1,0)="WPB-0304-31149"
^DIC(9.4,60,22,13,"PAH",159,1,2,0)="When a partial is processed for a Scriptalk patient, the scriptalk "
^DIC(9.4,60,22,13,"PAH",159,1,3,0)="printer label generated prints with the full quantity instead of the "
^DIC(9.4,60,22,13,"PAH",159,1,4,0)="partial quantity. This issue is resolved with this patch."
^DIC(9.4,60,22,13,"PAH",159,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,6,0)="CLE-0304-40723"
^DIC(9.4,60,22,13,"PAH",159,1,7,0)="Problem: For a Scriptalk patient, if the sig is greater than 196 "
^DIC(9.4,60,22,13,"PAH",159,1,8,0)="characters and the scriptalk label is printed, it truncates the sig."
^DIC(9.4,60,22,13,"PAH",159,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,10,0)="Solution: For a Scriptalk patient, if the sig is greater than 196 "
^DIC(9.4,60,22,13,"PAH",159,1,11,0)="characters and the scriptalk label is printed, the human readable section "
^DIC(9.4,60,22,13,"PAH",159,1,12,0)="will print in English and its Spanish translation as follows:"
^DIC(9.4,60,22,13,"PAH",159,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,14,0)="""SIG IS TOO LONG. REPRINT A NON-VOIDED VISTA LABEL AND PLACE OVER THIS "
^DIC(9.4,60,22,13,"PAH",159,1,15,0)="SCRIPTALK LABEL"""
^DIC(9.4,60,22,13,"PAH",159,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,17,0)="""INDICACIONES MUY LARGAS. IMPRIMA UNA ETIQUETA DE VISTA VALIDA Y "
^DIC(9.4,60,22,13,"PAH",159,1,18,0)="APLIQUELA SOBRE ESTA ETIQUETA DE SCRIPTALK EN LA BOTELLA."""
^DIC(9.4,60,22,13,"PAH",159,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,20,0)="HIN-0104-41546"
^DIC(9.4,60,22,13,"PAH",159,1,21,0)="When using [PSO SCRIPTALK PATIENT ENROLL ] option, the message displayed "
^DIC(9.4,60,22,13,"PAH",159,1,22,0)="is offset and incomplete. This patch will display the full message."
^DIC(9.4,60,22,13,"PAH",159,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,24,0)="BIG-0404-70352"
^DIC(9.4,60,22,13,"PAH",159,1,25,0)="1. When a patient has more than one eligibility code defined and the "
^DIC(9.4,60,22,13,"PAH",159,1,26,0)="patient profile is accessed using the [PSO LM BACKDOOR ORDERS] option, it "
^DIC(9.4,60,22,13,"PAH",159,1,27,0)="only displays one eligibility."
^DIC(9.4,60,22,13,"PAH",159,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,29,0)="2. When the patient status is not defined, and the patient is accessed, it"
^DIC(9.4,60,22,13,"PAH",159,1,30,0)="only displays one eligibility. "
^DIC(9.4,60,22,13,"PAH",159,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",159,1,32,0)="This patch will display multiple eligibilities defined for the patient."
^DIC(9.4,60,22,13,"PAH",160,0)="118^3041228^1"
^DIC(9.4,60,22,13,"PAH",160,1,0)="^^37^37^3041228"
^DIC(9.4,60,22,13,"PAH",160,1,1,0)="This project consists of 12 patches that work together to create a new"
^DIC(9.4,60,22,13,"PAH",160,1,2,0)="Clinical Reminders index global. The purpose of this index is to provide"
^DIC(9.4,60,22,13,"PAH",160,1,3,0)="rapid access to clinical data. All of the standard Clinical Reminders"
^DIC(9.4,60,22,13,"PAH",160,1,4,0)="finding types are included in the index."
^DIC(9.4,60,22,13,"PAH",160,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",160,1,6,0)="The 12 patches that comprise this project are:"
^DIC(9.4,60,22,13,"PAH",160,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",160,1,8,0)=" PXRM*1.5*12"
^DIC(9.4,60,22,13,"PAH",160,1,9,0)=" DG*5.3*478"
^DIC(9.4,60,22,13,"PAH",160,1,10,0)=" GMPL*2*27"
^DIC(9.4,60,22,13,"PAH",160,1,11,0)=" GMRV*4*15"
^DIC(9.4,60,22,13,"PAH",160,1,12,0)=" LR*5.2*295"
^DIC(9.4,60,22,13,"PAH",160,1,13,0)=" OR*3*157"
^DIC(9.4,60,22,13,"PAH",160,1,14,0)=" PSS*1.0*62"
^DIC(9.4,60,22,13,"PAH",160,1,15,0)=" PSJ*5.0*90"
^DIC(9.4,60,22,13,"PAH",160,1,16,0)=" PSO*7*118"
^DIC(9.4,60,22,13,"PAH",160,1,17,0)=" PX*1.0*119"
^DIC(9.4,60,22,13,"PAH",160,1,18,0)=" RA*5*33"
^DIC(9.4,60,22,13,"PAH",160,1,19,0)=" YS*5.01*77"
^DIC(9.4,60,22,13,"PAH",160,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",160,1,21,0)="The purpose of this patch (PSO*7*118) is to lay the groundwork for these"
^DIC(9.4,60,22,13,"PAH",160,1,22,0)="changes by creating new cross-references in the PRESCRIPTION file (#52)"
^DIC(9.4,60,22,13,"PAH",160,1,23,0)="that will be responsible for updating the new Clinical Reminders index"
^DIC(9.4,60,22,13,"PAH",160,1,24,0)="global. These are the new cross-references added to the PRESCRIPTION "
^DIC(9.4,60,22,13,"PAH",160,1,25,0)="file (#52) and the fields used as the trigger-points. The type of these"
^DIC(9.4,60,22,13,"PAH",160,1,26,0)="cross-references is 'New', not 'Traditional'."
^DIC(9.4,60,22,13,"PAH",160,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",160,1,28,0)="  X-ref  File/Sub-file              Trigger-point field(s)"
^DIC(9.4,60,22,13,"PAH",160,1,29,0)="  ----------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",160,1,30,0)="  ACRO   PRESCRIPTION (#52)         DAYS SUPPLY (#8)   "
^DIC(9.4,60,22,13,"PAH",160,1,31,0)="                                    RELEASED DATE/TIME (#31) "
^DIC(9.4,60,22,13,"PAH",160,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",160,1,33,0)="  ACRR   REFILL (#52.1)             DAYS SUPPLY (#1.1)"
^DIC(9.4,60,22,13,"PAH",160,1,34,0)="                                    RELEASED DATE/TIME (#17)"
^DIC(9.4,60,22,13,"PAH",160,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",160,1,36,0)="  ACRP   PARTIAL (#52.2)            DAYS SUPPLY (#.041)  "
^DIC(9.4,60,22,13,"PAH",160,1,37,0)="                                    RELEASED DATE/TIME (#8)"
^DIC(9.4,60,22,13,"PAH",161,0)="185 SEQ #165^3041228^1"
^DIC(9.4,60,22,13,"PAH",161,1,0)="^^68^68^3041228"
^DIC(9.4,60,22,13,"PAH",161,1,1,0)="***********************************NOTE***********************************"
^DIC(9.4,60,22,13,"PAH",161,1,2,0)="This patch does NOT conflict with CoreFLS and can be installed at CoreFLS"
^DIC(9.4,60,22,13,"PAH",161,1,3,0)="sites."
^DIC(9.4,60,22,13,"PAH",161,1,4,0)="**************************************************************************"
^DIC(9.4,60,22,13,"PAH",161,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,6,0)="PATCH OVERVIEW"
^DIC(9.4,60,22,13,"PAH",161,1,7,0)="Gail Graham, Director of Information Assurance requested that a process"
^DIC(9.4,60,22,13,"PAH",161,1,8,0)="of Patient Identity Management (PIM) be created that uniquely identifies a"
^DIC(9.4,60,22,13,"PAH",161,1,9,0)="patient prior to providing care. In order for the Health Data Repository"
^DIC(9.4,60,22,13,"PAH",161,1,10,0)="(HDR) to receive clinical data about patients the patient must have an"
^DIC(9.4,60,22,13,"PAH",161,1,11,0)="Integration Control Number (ICN) and Treating Facility (TF) List. VistA"
^DIC(9.4,60,22,13,"PAH",161,1,12,0)="under certain circumstances allows backdoor entry of clinical activity to"
^DIC(9.4,60,22,13,"PAH",161,1,13,0)="be recorded for a patient without ""requiring"" a patient to have an ICN."
^DIC(9.4,60,22,13,"PAH",161,1,14,0)="The immediate needs of the HDR have identified several issues within the"
^DIC(9.4,60,22,13,"PAH",161,1,15,0)="existing PIM to uniquely identify patients through the ICN enumeration"
^DIC(9.4,60,22,13,"PAH",161,1,16,0)="process. PIM services are tied into VistA at several points. In the"
^DIC(9.4,60,22,13,"PAH",161,1,17,0)="current VistA structure, up front identity management is done only within"
^DIC(9.4,60,22,13,"PAH",161,1,18,0)="Registration via several different menu options, as that has been the"
^DIC(9.4,60,22,13,"PAH",161,1,19,0)="traditional entry point of patients into the system. In addition, there"
^DIC(9.4,60,22,13,"PAH",161,1,20,0)="are ""hooks"" within Appointment Management, which assign a local ICN after"
^DIC(9.4,60,22,13,"PAH",161,1,21,0)="the patient has received care. Subsequently, the national ICN is obtained"
^DIC(9.4,60,22,13,"PAH",161,1,22,0)="through a nightly job or via manual resolution of the local ICN. The"
^DIC(9.4,60,22,13,"PAH",161,1,23,0)="requester states that the current method does not support good business"
^DIC(9.4,60,22,13,"PAH",161,1,24,0)="practices for updating patient identity traits at appropriate entry points"
^DIC(9.4,60,22,13,"PAH",161,1,25,0)="and does not provide the full functionality of the benefit of the ICN in"
^DIC(9.4,60,22,13,"PAH",161,1,26,0)="linking all patient data together."
^DIC(9.4,60,22,13,"PAH",161,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,28,0)="This is the Outpatient Pharmacy patch PSO*7*185 that places the ICN check"
^DIC(9.4,60,22,13,"PAH",161,1,29,0)="(hooks) within the Outpatient Pharmacy V. 7.0 options, to dynamically"
^DIC(9.4,60,22,13,"PAH",161,1,30,0)="assign a local ICN for a patient if one was not found."
^DIC(9.4,60,22,13,"PAH",161,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,32,0)="Outpatient Pharmacy will not make any changes to options where the"
^DIC(9.4,60,22,13,"PAH",161,1,33,0)="patient look up is done via the FileMan DIC call on the PATIENT file"
^DIC(9.4,60,22,13,"PAH",161,1,34,0)="(#2). As part of the PIM project, the Master Patient Index V. 1.0 package"
^DIC(9.4,60,22,13,"PAH",161,1,35,0)="will send out a separate patch that will have the ICN ""hooks"" in place."
^DIC(9.4,60,22,13,"PAH",161,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,37,0)="In Outpatient Pharmacy, the following options do not use the standard"
^DIC(9.4,60,22,13,"PAH",161,1,38,0)="patient lookup (FileMan DIC call on the PATIENT file (#2)), as the"
^DIC(9.4,60,22,13,"PAH",161,1,39,0)="primary input for selecting orders."
^DIC(9.4,60,22,13,"PAH",161,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,41,0)="Release Medication [PSO RELEASE]"
^DIC(9.4,60,22,13,"PAH",161,1,42,0)="Return Medication to Stock [PSO RETURNED STOCK]"
^DIC(9.4,60,22,13,"PAH",161,1,43,0)="Reset Copay Status/Cancel Charges [PSOCP RESET COPAY STATUS]"
^DIC(9.4,60,22,13,"PAH",161,1,44,0)="Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",161,1,45,0)="Barcode Batch Prescription Entry [PSO BATCH BARCODE]"
^DIC(9.4,60,22,13,"PAH",161,1,46,0)="Discontinue Prescription(s) [PSO C]"
^DIC(9.4,60,22,13,"PAH",161,1,47,0)="Edit Prescriptions [PSO RXEDIT]"
^DIC(9.4,60,22,13,"PAH",161,1,48,0)="Reprint an Outpatient Rx Label [PSO RXRPT]"
^DIC(9.4,60,22,13,"PAH",161,1,49,0)="View Prescriptions [PSO VIEW]"
^DIC(9.4,60,22,13,"PAH",161,1,50,0)="Pull Early from Suspense [PSO PNDRX]"
^DIC(9.4,60,22,13,"PAH",161,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,52,0)="For these options, a check is put in place to see if the INTEGRATION"
^DIC(9.4,60,22,13,"PAH",161,1,53,0)="CONTROL NUMBER (ICN) field (#991.01) of the PATIENT file (#2) is populated"
^DIC(9.4,60,22,13,"PAH",161,1,54,0)="by calling the API #2701, $$GETICN^MPIF001(DFN). If it is not populated"
^DIC(9.4,60,22,13,"PAH",161,1,55,0)="then a call is made to the API #3300, $$MPIQQ^MPIFAPI(DFN) that will"
^DIC(9.4,60,22,13,"PAH",161,1,56,0)="populate the INTEGRATION CONTROL NUMBER (ICN) field (#991.01) of the"
^DIC(9.4,60,22,13,"PAH",161,1,57,0)="PATIENT file (#2)."
^DIC(9.4,60,22,13,"PAH",161,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",161,1,59,0)="Note: This patch also carries a fix for NOIS PAL-0804-60841."
^DIC(9.4,60,22,13,"PAH",161,1,60,0)="Patch PSO*7*175 - FEE REPLACEMENT ENCAPSULATION PROJECT, calls the API"
^DIC(9.4,60,22,13,"PAH",161,1,61,0)="#4395, $$RXSUM^FBRXUTL(DATE,STATION_NUMBER), to collect the fee basis"
^DIC(9.4,60,22,13,"PAH",161,1,62,0)="prescription count and cost for a given date and the approving Veterans"
^DIC(9.4,60,22,13,"PAH",161,1,63,0)="Affairs Medical Center (VAMC) station number. The station number that is"
^DIC(9.4,60,22,13,"PAH",161,1,64,0)="passed to the API is the STATION NUMBER field (#99) of the INSTITUTION"
^DIC(9.4,60,22,13,"PAH",161,1,65,0)="file (#4), which constitutes a 3 digit station number plus any modifiers."
^DIC(9.4,60,22,13,"PAH",161,1,66,0)="The API #4395 requires only the first 3 digits of the station number"
^DIC(9.4,60,22,13,"PAH",161,1,67,0)="otherwise it will return an error message, ""Valid station number not"
^DIC(9.4,60,22,13,"PAH",161,1,68,0)="specified"". This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",162,0)="181 SEQ #166^3050118^1"
^DIC(9.4,60,22,13,"PAH",162,1,0)="^^6^6^3050118"
^DIC(9.4,60,22,13,"PAH",162,1,1,0)="This patch supports the VistA Data Extraction Framework (VDEF)"
^DIC(9.4,60,22,13,"PAH",162,1,2,0)="effort, allowing changes to the PRESCRIPTION file (#52) to be transmitted"
^DIC(9.4,60,22,13,"PAH",162,1,3,0)="to the Health Data Repository (HDR). The activation of the transmission "
^DIC(9.4,60,22,13,"PAH",162,1,4,0)="will be handled with the sites on an individual basis. Until that "
^DIC(9.4,60,22,13,"PAH",162,1,5,0)="activation occurs, the changes included in this patch will not affect "
^DIC(9.4,60,22,13,"PAH",162,1,6,0)="any Pharmacy functionality."
^DIC(9.4,60,22,13,"PAH",163,0)="190 SEQ #167^3050118^1"
^DIC(9.4,60,22,13,"PAH",163,1,0)="^^60^60^3050118"
^DIC(9.4,60,22,13,"PAH",163,1,1,0)="This patch is phase 2 of the patches that support the VistA Data"
^DIC(9.4,60,22,13,"PAH",163,1,2,0)="Extraction Framework (VDEF) effort, allowing changes to the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",163,1,3,0)="file (#52) to be transmitted to the Health Data Repository (HDR). The"
^DIC(9.4,60,22,13,"PAH",163,1,4,0)="activation of the transmission will be handled with the sites on an"
^DIC(9.4,60,22,13,"PAH",163,1,5,0)="individual basis. Until that activation occurs, the changes included in"
^DIC(9.4,60,22,13,"PAH",163,1,6,0)="this patch will not affect any Outpatient Pharmacy functionality."
^DIC(9.4,60,22,13,"PAH",163,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,8,0)="The following build components are being exported with this patch:"
^DIC(9.4,60,22,13,"PAH",163,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,10,0)="PROTOCOL:"
^DIC(9.4,60,22,13,"PAH",163,1,11,0)="   PSO VDEF RDE O11 OP PHARM PRES HR"
^DIC(9.4,60,22,13,"PAH",163,1,12,0)="   PSO VDEF RDE O11 OP PHARM PRES VS"
^DIC(9.4,60,22,13,"PAH",163,1,13,0)="   PSO VDEF RDS O13 OP PHARM PPAR HR"
^DIC(9.4,60,22,13,"PAH",163,1,14,0)="   PSO VDEF RDS O13 OP PHARM PPAR VS"
^DIC(9.4,60,22,13,"PAH",163,1,15,0)="   PSO VDEF RDS O13 OP PHARM PREF HR"
^DIC(9.4,60,22,13,"PAH",163,1,16,0)="   PSO VDEF RDS O13 OP PHARM PREF VS"
^DIC(9.4,60,22,13,"PAH",163,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,18,0)="HL7 APPLICATION PARAMETER:"
^DIC(9.4,60,22,13,"PAH",163,1,19,0)="   HDRPPAR"
^DIC(9.4,60,22,13,"PAH",163,1,20,0)="   HDRPREF"
^DIC(9.4,60,22,13,"PAH",163,1,21,0)="   HDRPRES"
^DIC(9.4,60,22,13,"PAH",163,1,22,0)="   PSO VDEF IE SIDE "
^DIC(9.4,60,22,13,"PAH",163,1,23,0)="                      "
^DIC(9.4,60,22,13,"PAH",163,1,24,0)="The routine PSOVDFK is used as the KIDS Post-Install routine to install "
^DIC(9.4,60,22,13,"PAH",163,1,25,0)="specific components for the Outpatient Pharmacy package in several VDEF"
^DIC(9.4,60,22,13,"PAH",163,1,26,0)="namespace globals that VDEF uses to construct a message.  It uses the VDEF"
^DIC(9.4,60,22,13,"PAH",163,1,27,0)="API POSTKID^VDEFVU to do this.  The specific components that are sent to"
^DIC(9.4,60,22,13,"PAH",163,1,28,0)="Post-install routine are:"
^DIC(9.4,60,22,13,"PAH",163,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,30,0)="1.      HL7 Message Type"
^DIC(9.4,60,22,13,"PAH",163,1,31,0)="2.      HL7 Event Type"
^DIC(9.4,60,22,13,"PAH",163,1,32,0)="3.      VistA Domain Subtype"
^DIC(9.4,60,22,13,"PAH",163,1,33,0)="4.      HL7 Protocol Event Driver name"
^DIC(9.4,60,22,13,"PAH",163,1,34,0)="5.      Application's Custodial Package name"
^DIC(9.4,60,22,13,"PAH",163,1,35,0)="6.      Name of the routine that does the message extraction"
^DIC(9.4,60,22,13,"PAH",163,1,36,0)="7.      VDEF Event Description"
^DIC(9.4,60,22,13,"PAH",163,1,37,0)="8.      VDEF Event Subtype description"
^DIC(9.4,60,22,13,"PAH",163,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,39,0)="The POSTKID^VDEFVU routine uses the components to create event-specific"
^DIC(9.4,60,22,13,"PAH",163,1,40,0)="parameters in VDEF files."
^DIC(9.4,60,22,13,"PAH",163,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,42,0)="The patch cannot be installed until VDEF 1.00 is installed. "
^DIC(9.4,60,22,13,"PAH",163,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,45,0)="** IMPORTANT **"
^DIC(9.4,60,22,13,"PAH",163,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",163,1,47,0)="Sites should not install this software prior to your assigned HDR"
^DIC(9.4,60,22,13,"PAH",163,1,48,0)="installation date; doing so may cause complications with your BCMA"
^DIC(9.4,60,22,13,"PAH",163,1,49,0)="application with versions prior to PSB*3*4. You will be contacted"
^DIC(9.4,60,22,13,"PAH",163,1,50,0)="approximately two weeks prior to your HDR installation date and provided"
^DIC(9.4,60,22,13,"PAH",163,1,51,0)="with instructions on when and in what order to install these patches and"
^DIC(9.4,60,22,13,"PAH",163,1,52,0)="the VDEF software. Additionally, sites should not configure or attempt to"
^DIC(9.4,60,22,13,"PAH",163,1,53,0)="utilize the VDEF software associated with these patches prior to your"
^DIC(9.4,60,22,13,"PAH",163,1,54,0)="assigned HDR installation date, at which time Technical Support Office"
^DIC(9.4,60,22,13,"PAH",163,1,55,0)="personnel will work with you to activate that application and start your"
^DIC(9.4,60,22,13,"PAH",163,1,56,0)="data transmissions to the HDR database. (If you do not know your HDR"
^DIC(9.4,60,22,13,"PAH",163,1,57,0)="installation date, you can find that information by going to "
^DIC(9.4,60,22,13,"PAH",163,1,58,0)="<http://vaww.teamshare.domain.ext/hdr_implementation/> and selecting "
^DIC(9.4,60,22,13,"PAH",163,1,59,0)="""Implementation Schedule"" from the Quick Launch panel on the left side of "
^DIC(9.4,60,22,13,"PAH",163,1,60,0)="the page.) "
^DIC(9.4,60,22,13,"PAH",164,0)="177 SEQ #168^3050118^1"
^DIC(9.4,60,22,13,"PAH",164,1,0)="^^18^18^3050118"
^DIC(9.4,60,22,13,"PAH",164,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",164,1,2,0)="While going through the option to finish an outpatient pharmacy order"
^DIC(9.4,60,22,13,"PAH",164,1,3,0)="[PSO LMOE FINISH], if the patient status field is left blank the first "
^DIC(9.4,60,22,13,"PAH",164,1,4,0)="time it is asked for, the program will ask for the patient status again."
^DIC(9.4,60,22,13,"PAH",164,1,5,0)="If the user doesn't enter the patient status the second time, an error is"
^DIC(9.4,60,22,13,"PAH",164,1,6,0)="generated."
^DIC(9.4,60,22,13,"PAH",164,1,7,0)="This patch will resolve this problem."
^DIC(9.4,60,22,13,"PAH",164,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",164,1,9,0)="2)HUN-0304-21898"
^DIC(9.4,60,22,13,"PAH",164,1,10,0)="The Label/Profile monitor field has 250 as the minimum value, but the "
^DIC(9.4,60,22,13,"PAH",164,1,11,0)="software that uses that field sets the minimum value to 1000."
^DIC(9.4,60,22,13,"PAH",164,1,12,0)="Each time the printer is used, an entry is made in the Label/Profile "
^DIC(9.4,60,22,13,"PAH",164,1,13,0)="monitor and if the monitor holds more entries than specified by this "
^DIC(9.4,60,22,13,"PAH",164,1,14,0)="parameter, the oldest entry is deleted."
^DIC(9.4,60,22,13,"PAH",164,1,15,0)="The documentation and field specifications for Label/Profile monitor "
^DIC(9.4,60,22,13,"PAH",164,1,16,0)="allows you to enter a minimum value of 250.  The field specification and "
^DIC(9.4,60,22,13,"PAH",164,1,17,0)="file manager documentation will be changed to allow a minimum value of "
^DIC(9.4,60,22,13,"PAH",164,1,18,0)="1000."
^DIC(9.4,60,22,13,"PAH",165,0)="193 SEQ #169^3050118^1"
^DIC(9.4,60,22,13,"PAH",165,1,0)="^^18^18^3050118"
^DIC(9.4,60,22,13,"PAH",165,1,1,0)="1. PSO*7*156 provided a two-way interface that returns dispensing"
^DIC(9.4,60,22,13,"PAH",165,1,2,0)="information to VistA from the dispensing machine that updates the "
^DIC(9.4,60,22,13,"PAH",165,1,3,0)="PRESCRIPTION file (#52) when dispensing of medication is completed."
^DIC(9.4,60,22,13,"PAH",165,1,4,0)="When developing this new two-way interface the Label/Profile Monitor"
^DIC(9.4,60,22,13,"PAH",165,1,5,0)="Reprint [PSO B] option was not enhanced to send label reprints to the"
^DIC(9.4,60,22,13,"PAH",165,1,6,0)="external interface.  BRX-0803-10283"
^DIC(9.4,60,22,13,"PAH",165,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",165,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",165,1,9,0)="2. PSO*7*156 provided a two-way interface that returns dispensing"
^DIC(9.4,60,22,13,"PAH",165,1,10,0)="information to VistA from the dispensing machine that updates the "
^DIC(9.4,60,22,13,"PAH",165,1,11,0)="PRESCRIPTION file (#52) when dispensing of medication is completed."
^DIC(9.4,60,22,13,"PAH",165,1,12,0)="Since being released to the field, it has been determined that additional"
^DIC(9.4,60,22,13,"PAH",165,1,13,0)="data validation checks were needed on the data being returned."
^DIC(9.4,60,22,13,"PAH",165,1,14,0)="This patch includes those additional data validation checks."
^DIC(9.4,60,22,13,"PAH",165,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",165,1,16,0)="3. When viewing a prescription using the View Prescriptions [PSO VIEW]"
^DIC(9.4,60,22,13,"PAH",165,1,17,0)="option, the initiator of activity does not display, however, if viewing from"
^DIC(9.4,60,22,13,"PAH",165,1,18,0)="the profile, it does display. NOIS: MAC-1104-61559"
^DIC(9.4,60,22,13,"PAH",166,0)="184 SEQ #170^3050311^1"
^DIC(9.4,60,22,13,"PAH",166,1,0)="^^36^36^3050311"
^DIC(9.4,60,22,13,"PAH",166,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",166,1,2,0)=" 1. MOU-1203-30359"
^DIC(9.4,60,22,13,"PAH",166,1,3,0)="    When using the Return Medication to Stock [PSO RETURNED STOCK]"
^DIC(9.4,60,22,13,"PAH",166,1,4,0)="    option for a controlled substance, the pharmacist is allowed to"
^DIC(9.4,60,22,13,"PAH",166,1,5,0)="    up-arrow (""^"") out of the comments field even though it is a"
^DIC(9.4,60,22,13,"PAH",166,1,6,0)="    required field.  When this happens, some Controlled Substance"
^DIC(9.4,60,22,13,"PAH",166,1,7,0)="    files are partially updated and will cause the medication to be"
^DIC(9.4,60,22,13,"PAH",166,1,8,0)="    returned twice.  This patch will resolve this issue by not allowing"
^DIC(9.4,60,22,13,"PAH",166,1,9,0)="    the pharmacist to up-arrow out of the comments field."
^DIC(9.4,60,22,13,"PAH",166,1,10,0)="    "
^DIC(9.4,60,22,13,"PAH",166,1,11,0)=" 2. SHE-0404-51324"
^DIC(9.4,60,22,13,"PAH",166,1,12,0)="    The potential exists to modify the number of refills for a"
^DIC(9.4,60,22,13,"PAH",166,1,13,0)="    controlled substance from a maximum of 5 to 11.  This can happen"
^DIC(9.4,60,22,13,"PAH",166,1,14,0)="    in the Patient Processing Option [PSO LM BACKDOOR ORDERS] while"
^DIC(9.4,60,22,13,"PAH",166,1,15,0)="    finishing a renewed order."
^DIC(9.4,60,22,13,"PAH",166,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",166,1,17,0)=" 3. DAY-0604-41287"
^DIC(9.4,60,22,13,"PAH",166,1,18,0)="    An issue was identified in the Imaging software that allowed the"
^DIC(9.4,60,22,13,"PAH",166,1,19,0)="    software to automatically select a patient based on name even if"
^DIC(9.4,60,22,13,"PAH",166,1,20,0)="    multiple patients existed with the same name.  A fix is being"
^DIC(9.4,60,22,13,"PAH",166,1,21,0)="    included in Pharmacy to kill an internal variable to not allow"
^DIC(9.4,60,22,13,"PAH",166,1,22,0)="    this behavior.  This change does not affect the pharmacy application"
^DIC(9.4,60,22,13,"PAH",166,1,23,0)="    in any way."
^DIC(9.4,60,22,13,"PAH",166,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",166,1,25,0)=" 4. CLL-0604-40968"
^DIC(9.4,60,22,13,"PAH",166,1,26,0)="    When using the Return Medication to Stock [PSO RETURNED STOCK]"
^DIC(9.4,60,22,13,"PAH",166,1,27,0)="    option it is possible to get the following message:"
^DIC(9.4,60,22,13,"PAH",166,1,28,0)="    "
^DIC(9.4,60,22,13,"PAH",166,1,29,0)="    Original Fill CANNOT be Returned!"
^DIC(9.4,60,22,13,"PAH",166,1,30,0)="    This fill entered before installation of version 6.  There are no"
^DIC(9.4,60,22,13,"PAH",166,1,31,0)="    refills."
^DIC(9.4,60,22,13,"PAH",166,1,32,0)="    "
^DIC(9.4,60,22,13,"PAH",166,1,33,0)="    This message is generated when the pharmacist try's to return a"
^DIC(9.4,60,22,13,"PAH",166,1,34,0)="    medication to stock for a prescription that has a fill date that"
^DIC(9.4,60,22,13,"PAH",166,1,35,0)="    is less than the date Version 6.0 of the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",166,1,36,0)="    application was installed.  This message will be removed."
^DIC(9.4,60,22,13,"PAH",167,0)="188 SEQ #171^3050311^1"
^DIC(9.4,60,22,13,"PAH",167,1,0)="^^10^10^3050311"
^DIC(9.4,60,22,13,"PAH",167,1,1,0)=" During order entry in backdoor Outpatient Pharmacy, Order checks are"
^DIC(9.4,60,22,13,"PAH",167,1,2,0)=" not being performed on Non-VA medications if other medications exist."
^DIC(9.4,60,22,13,"PAH",167,1,3,0)=" The possibility also exists that when a 'critical interaction'"
^DIC(9.4,60,22,13,"PAH",167,1,4,0)=" exists and is displayed, this critical interaction could be displayed"
^DIC(9.4,60,22,13,"PAH",167,1,5,0)=" for subsequent orders even though a 'critical interaction' does not"
^DIC(9.4,60,22,13,"PAH",167,1,6,0)=" exist on the order currently being entered."
^DIC(9.4,60,22,13,"PAH",167,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",167,1,8,0)=" When entering an order via backdoor Outpatient Pharmacy or CPRS, a"
^DIC(9.4,60,22,13,"PAH",167,1,9,0)=" critical interaction could be skipped if a significant interaction"
^DIC(9.4,60,22,13,"PAH",167,1,10,0)=" exists for the same drugs."
^DIC(9.4,60,22,13,"PAH",168,0)="194 SEQ #172^3050401^1"
^DIC(9.4,60,22,13,"PAH",169,0)="192 SEQ #173^3050401^1"
^DIC(9.4,60,22,13,"PAH",169,1,0)="^^1^1^3050401"
^DIC(9.4,60,22,13,"PAH",169,1,1,0)="SPELLING ERROR AND QUANTITY CHANGING"
^DIC(9.4,60,22,13,"PAH",170,0)="186 SEQ #174^3050401^1"
^DIC(9.4,60,22,13,"PAH",170,1,0)="^^6^6^3050401"
^DIC(9.4,60,22,13,"PAH",170,1,1,0)=" This patch will correct two DEA (Drug Enforcement Agency) Special"
^DIC(9.4,60,22,13,"PAH",170,1,2,0)=" Handling issues, one while completing the prescription via the PSO LM"
^DIC(9.4,60,22,13,"PAH",170,1,3,0)=" BACKDOOR ORDERS option, and one while refilling a prescription via the"
^DIC(9.4,60,22,13,"PAH",170,1,4,0)=" Barcode Batch Prescription Entry option on the PSO BARCODE MENU.  This"
^DIC(9.4,60,22,13,"PAH",170,1,5,0)=" patch will also correct a null subscript error while verifying a"
^DIC(9.4,60,22,13,"PAH",170,1,6,0)=" prescription via the PSO LM BACKDOOR ORDERS option."
^DIC(9.4,60,22,13,"PAH",171,0)="165 SEQ #175^3050401^1"
^DIC(9.4,60,22,13,"PAH",171,1,0)="^^13^13^3050401"
^DIC(9.4,60,22,13,"PAH",171,1,1,0)="This supported #1878 has been updated to include new data elements at the"
^DIC(9.4,60,22,13,"PAH",171,1,2,0)="request of Pharmacy Benefit Management (PBM).  See DBIA #1878 for"
^DIC(9.4,60,22,13,"PAH",171,1,3,0)="complete description."
^DIC(9.4,60,22,13,"PAH",171,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",171,1,5,0)="The follow data elements from the Prescription file (#52) were added."
^DIC(9.4,60,22,13,"PAH",171,1,6,0)=" NDC (original, refill, partial)"
^DIC(9.4,60,22,13,"PAH",171,1,7,0)=" LOGIN DATE (original, refill, partial)"
^DIC(9.4,60,22,13,"PAH",171,1,8,0)=" TPB RX"
^DIC(9.4,60,22,13,"PAH",171,1,9,0)=" EXPANDED PATIENT INSTRUCTIONS "
^DIC(9.4,60,22,13,"PAH",171,1,10,0)=" FINISHING PERSON"
^DIC(9.4,60,22,13,"PAH",171,1,11,0)=" MEDICATION INSTRUCTION sub-file fields:"
^DIC(9.4,60,22,13,"PAH",171,1,12,0)=" DOSAGE INSTRUCTION, DISPENSE UNITS PER DOSE, UNITS, NOUN, "
^DIC(9.4,60,22,13,"PAH",171,1,13,0)=" DURATION, CONJUNCTION, ROUTE, SCHEDULE, VERB"
^DIC(9.4,60,22,13,"PAH",172,0)="165^3050401^1"
^DIC(9.4,60,22,13,"PAH",172,1,0)="^^16^16^3050401"
^DIC(9.4,60,22,13,"PAH",172,1,1,0)="The routine PSOORDER, which supported DBIA #1878 has been updated to "
^DIC(9.4,60,22,13,"PAH",172,1,2,0)="include new data elements at the request of Pharmacy Benefit Management "
^DIC(9.4,60,22,13,"PAH",172,1,3,0)="(PBM).  See DBIA #1878 for complete details."
^DIC(9.4,60,22,13,"PAH",172,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",172,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",172,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",172,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",172,1,8,0)="The following data elements from the Prescription file (#52) were added."
^DIC(9.4,60,22,13,"PAH",172,1,9,0)=" NDC (original, refill, partial)"
^DIC(9.4,60,22,13,"PAH",172,1,10,0)=" LOGIN DATE (original, refill, partial)"
^DIC(9.4,60,22,13,"PAH",172,1,11,0)=" TPB RX"
^DIC(9.4,60,22,13,"PAH",172,1,12,0)=" EXPANDED PATIENT INSTRUCTIONS "
^DIC(9.4,60,22,13,"PAH",172,1,13,0)=" FINISHING PERSON"
^DIC(9.4,60,22,13,"PAH",172,1,14,0)=" MEDICATION INSTRUCTION sub-file fields:"
^DIC(9.4,60,22,13,"PAH",172,1,15,0)=" DOSAGE INSTRUCTION, DISPENSE UNITS PER DOSE, UNITS, NOUN, "
^DIC(9.4,60,22,13,"PAH",172,1,16,0)=" DURATION, CONJUNCTION, ROUTE, SCHEDULE, VERB"
^DIC(9.4,60,22,13,"PAH",173,0)="161 SEQ #176^3050426^1"
^DIC(9.4,60,22,13,"PAH",173,1,0)="^^168^168^3050426"
^DIC(9.4,60,22,13,"PAH",173,1,1,0)="This patch is part of the Outpatient Pharmacy V. 7.0 Laser Labels"
^DIC(9.4,60,22,13,"PAH",173,1,2,0)="Phase II project for printing prescription labels."
^DIC(9.4,60,22,13,"PAH",173,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,4,0)="***** NOTE TO SITES USING AUTOMATED FILLING EQUIPMENT *****"
^DIC(9.4,60,22,13,"PAH",173,1,5,0)="This patch changes the format and content of the laser labels print "
^DIC(9.4,60,22,13,"PAH",173,1,6,0)="stream. If you are using automated dispensing equipment that relies on "
^DIC(9.4,60,22,13,"PAH",173,1,7,0)="the data stream sent to the laser labels port, you have 2 options:"
^DIC(9.4,60,22,13,"PAH",173,1,8,0)="  1. Implement the Outpatient Automation Interface (OPAI) (available with"
^DIC(9.4,60,22,13,"PAH",173,1,9,0)="     released patch PSO*7*156) or "
^DIC(9.4,60,22,13,"PAH",173,1,10,0)="  2. Contact your vendor to make adjustments based on the new data stream."
^DIC(9.4,60,22,13,"PAH",173,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,12,0)="Although implementing OPAI is not mandated at this time, it is expected "
^DIC(9.4,60,22,13,"PAH",173,1,13,0)="to be in the future, so option 1 is the preferred solution. By "
^DIC(9.4,60,22,13,"PAH",173,1,14,0)="implementing OPAI, future changes to the label format will not affect the "
^DIC(9.4,60,22,13,"PAH",173,1,15,0)="dispensing equipment interface."
^DIC(9.4,60,22,13,"PAH",173,1,16,0)="*************************************************************************"
^DIC(9.4,60,22,13,"PAH",173,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,18,0)="To fully implement all portions of the new functionality, the "
^DIC(9.4,60,22,13,"PAH",173,1,19,0)="following are needed:"
^DIC(9.4,60,22,13,"PAH",173,1,20,0)="  1. Patch PSS*1*87 from Pharmacy Data Management V. 1.0 (PDM),to provide "
^DIC(9.4,60,22,13,"PAH",173,1,21,0)="an API for retrieving warning labels from the new data source."
^DIC(9.4,60,22,13,"PAH",173,1,22,0)="  2. Patches PSN*4*86 and PSN*4*88 from the National Drug File V. 4.0"
^DIC(9.4,60,22,13,"PAH",173,1,23,0)="(NDF) to create and populate a new gender field in the WARNING"
^DIC(9.4,60,22,13,"PAH",173,1,24,0)="LABEL-ENGLISH file (#50.625) and the WARNING LABEL-SPANISH file (#50.626)."
^DIC(9.4,60,22,13,"PAH",173,1,25,0)="  3. Patch PSX*2*54 from the Consolidated Mail Outpatient Pharmacy V. 2.0"
^DIC(9.4,60,22,13,"PAH",173,1,26,0)="(CMOP) to modify the way warnings are sent to CMOP."
^DIC(9.4,60,22,13,"PAH",173,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,29,0)=" This patch includes:"
^DIC(9.4,60,22,13,"PAH",173,1,30,0)="  1. Referencing a new commercial data source for printing prescription "
^DIC(9.4,60,22,13,"PAH",173,1,31,0)="warning labels.        "
^DIC(9.4,60,22,13,"PAH",173,1,32,0)="  2. Printing warning labels and Patient Information Sheets (PMI) by the"
^DIC(9.4,60,22,13,"PAH",173,1,33,0)="patient's PMI language preference setting."
^DIC(9.4,60,22,13,"PAH",173,1,34,0)="  3. A new MAILING COMMENTS field (#.081) is added to the OUTPATIENT SITE"
^DIC(9.4,60,22,13,"PAH",173,1,35,0)="file (#59.7) to be used for a site to enter anything they would like to "
^DIC(9.4,60,22,13,"PAH",173,1,36,0)="show on the Mail Address label. (i.e. whether mailing is ""Forwarding "
^DIC(9.4,60,22,13,"PAH",173,1,37,0)="service requested"" or  ""Address service requested""). The PSO SITE INPUT "
^DIC(9.4,60,22,13,"PAH",173,1,38,0)="TEMPLATE for the OUTPATIENT SITE file (#59.7) is changed to allow the "
^DIC(9.4,60,22,13,"PAH",173,1,39,0)="input of data into the new mailing comments."
^DIC(9.4,60,22,13,"PAH",173,1,40,0)="  4. A new Manual Print of Multi-Rx Forms [PSO LM MULTI-RX PRINT] option"
^DIC(9.4,60,22,13,"PAH",173,1,41,0)="is added under the Rx (Prescriptions) [PSO RX] option as well as under "
^DIC(9.4,60,22,13,"PAH",173,1,42,0)="the OTH hidden action while in the patient's profile to reprint the "
^DIC(9.4,60,22,13,"PAH",173,1,43,0)="Multi-Rx Refill Request form on laser label stock without having to"
^DIC(9.4,60,22,13,"PAH",173,1,44,0)="reprint the entire prescription's labels. The functionality is also"
^DIC(9.4,60,22,13,"PAH",173,1,45,0)="changed to stop printing the Multi-Rx refill form on reprints."
^DIC(9.4,60,22,13,"PAH",173,1,46,0)="  5. Various changes to the content/format of the labels - detailed below"
^DIC(9.4,60,22,13,"PAH",173,1,47,0)="under each label section."
^DIC(9.4,60,22,13,"PAH",173,1,48,0)="  6. Correction to only print one ScripTalk label when SIG is continued."
^DIC(9.4,60,22,13,"PAH",173,1,49,0)="(NOIS CLE-0304-40723. (The other part of this NOIS is addressed in patch"
^DIC(9.4,60,22,13,"PAH",173,1,50,0)="PSO*7*182, so this NOIS is not included in the associated patch list "
^DIC(9.4,60,22,13,"PAH",173,1,51,0)="below))."
^DIC(9.4,60,22,13,"PAH",173,1,52,0)="  7. A new Signature Log Reprint [PSO SIGLOG REPRINT] option is added"
^DIC(9.4,60,22,13,"PAH",173,1,53,0)="under the Rx (Prescriptions) [PSO RX] option. (Added for HIPAA/NCPDP)."
^DIC(9.4,60,22,13,"PAH",173,1,54,0)="  8. A change was made to not keep exact duplicates of the control code "
^DIC(9.4,60,22,13,"PAH",173,1,55,0)="settings (e.g. when running the set-up routine as a test site and again "
^DIC(9.4,60,22,13,"PAH",173,1,56,0)="when the patch is installed in production). NOIS PUG-1103-52110"
^DIC(9.4,60,22,13,"PAH",173,1,57,0)="  9. The other NOIS's listed below were for items already included in the"
^DIC(9.4,60,22,13,"PAH",173,1,58,0)="Laser Labels Phase II specifications."
^DIC(9.4,60,22,13,"PAH",173,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,60,0)="Bottle label section changes:"
^DIC(9.4,60,22,13,"PAH",173,1,61,0)="============================"
^DIC(9.4,60,22,13,"PAH",173,1,62,0)="  1. Currently long SIG's that do not fit on one bottle label print only 4"
^DIC(9.4,60,22,13,"PAH",173,1,63,0)="lines of SIG on the first bottle label and up to 4 lines on each "
^DIC(9.4,60,22,13,"PAH",173,1,64,0)="continuation label. This patch increases the number of lines of the SIG "
^DIC(9.4,60,22,13,"PAH",173,1,65,0)="that print on each bottle label to reduce the total number of labels"
^DIC(9.4,60,22,13,"PAH",173,1,66,0)="needed. This also will allow the overlapping of the multiple labels on the"
^DIC(9.4,60,22,13,"PAH",173,1,67,0)="bottle to eliminate the need for cutting the labels to make them fit."
^DIC(9.4,60,22,13,"PAH",173,1,68,0)="  2. The text ""Mfr_________"" will print for all prescriptions on the same "
^DIC(9.4,60,22,13,"PAH",173,1,69,0)="line as the ""Discard after"" information."
^DIC(9.4,60,22,13,"PAH",173,1,70,0)="  3. The text ""May refill nX by MMM DD,YYYY"" or ""NO REFILLS LEFT"" or ""NO "
^DIC(9.4,60,22,13,"PAH",173,1,71,0)="REFILL"" was added between the ""Discard after..."" line and the Qty: line."
^DIC(9.4,60,22,13,"PAH",173,1,72,0)="  4. On the trailing documents, a signature log will print in the bottle "
^DIC(9.4,60,22,13,"PAH",173,1,73,0)="label section for the patient to sign for the medications received. "
^DIC(9.4,60,22,13,"PAH",173,1,74,0)="(Added for HIPAA/NCPDP)."
^DIC(9.4,60,22,13,"PAH",173,1,75,0)="  "
^DIC(9.4,60,22,13,"PAH",173,1,76,0)="Warning label section changes:"
^DIC(9.4,60,22,13,"PAH",173,1,77,0)="============================="
^DIC(9.4,60,22,13,"PAH",173,1,78,0)="  1. A new API will be called to determine which warnings to print."
^DIC(9.4,60,22,13,"PAH",173,1,79,0)="  2. Warnings will print in English or Spanish depending on the patient's "
^DIC(9.4,60,22,13,"PAH",173,1,80,0)="PMI preference."
^DIC(9.4,60,22,13,"PAH",173,1,81,0)="  3. If there are fewer than five warning labels, the warning labels will "
^DIC(9.4,60,22,13,"PAH",173,1,82,0)="be bottom-justified."
^DIC(9.4,60,22,13,"PAH",173,1,83,0)="  4. If the DEA, SPECIAL HDLG field (#3) in the DRUG file (#50) begins"
^DIC(9.4,60,22,13,"PAH",173,1,84,0)="with numbers 1,2,3,4 or 5. The NO TRANSFER warning label from the RX"
^DIC(9.4,60,22,13,"PAH",173,1,85,0)="CONSULT file (#54) entry number 20 will print in the appropriate "
^DIC(9.4,60,22,13,"PAH",173,1,86,0)="language."
^DIC(9.4,60,22,13,"PAH",173,1,87,0)="  5. The new data source contains some lengthy warnings, especially the "
^DIC(9.4,60,22,13,"PAH",173,1,88,0)="Spanish translation. For the smallest font, this patch allows a 4th line"
^DIC(9.4,60,22,13,"PAH",173,1,89,0)="of text to print, if needed."
^DIC(9.4,60,22,13,"PAH",173,1,90,0)="  6. The top warning label was sometimes printing on or over the "
^DIC(9.4,60,22,13,"PAH",173,1,91,0)="perforated line. For some fonts, this patch reduces the white space "
^DIC(9.4,60,22,13,"PAH",173,1,92,0)="between the lines of the first warning to make it fit."
^DIC(9.4,60,22,13,"PAH",173,1,93,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,94,0)="Mail address section changes:"
^DIC(9.4,60,22,13,"PAH",173,1,95,0)="============================"
^DIC(9.4,60,22,13,"PAH",173,1,96,0)="  1. The current date will print in the upper right corner."
^DIC(9.4,60,22,13,"PAH",173,1,97,0)="  2. If there are any mailing comments defined, they will print after the "
^DIC(9.4,60,22,13,"PAH",173,1,98,0)="MAIL field (#.03) of the PHARMACY PATIENT file (#55)."
^DIC(9.4,60,22,13,"PAH",173,1,99,0)="  3. Patient name will print first name first instead of "
^DIC(9.4,60,22,13,"PAH",173,1,100,0)="lastname,firstname."
^DIC(9.4,60,22,13,"PAH",173,1,101,0)="  4. When the routing is ""Window"", the word ""Window"" will be bolded."
^DIC(9.4,60,22,13,"PAH",173,1,102,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,103,0)="Pharmacy fill card section changes:"
^DIC(9.4,60,22,13,"PAH",173,1,104,0)="=================================="
^DIC(9.4,60,22,13,"PAH",173,1,105,0)="  1. Seconds will be removed from the label date/time."
^DIC(9.4,60,22,13,"PAH",173,1,106,0)="  2. A new API will return the text for the DRUG WARNING list. The DRUG "
^DIC(9.4,60,22,13,"PAH",173,1,107,0)="WARNING entries will be separated by commas. If an entry in the list does "
^DIC(9.4,60,22,13,"PAH",173,1,108,0)="not have an ""N"" (for ""New""), it is from the RX CONSULT file (#54)."
^DIC(9.4,60,22,13,"PAH",173,1,109,0)="Otherwise it is from the WARNING LABEL-ENGLISH (#50.625) or the "
^DIC(9.4,60,22,13,"PAH",173,1,110,0)="WARNING LABEL-SPANISH (#50.626) file."
^DIC(9.4,60,22,13,"PAH",173,1,111,0)="  3. A new line containing the patient location and status is being added"
^DIC(9.4,60,22,13,"PAH",173,1,112,0)="beneath the DRUG WARNING list, so the list is being moved up slightly on"
^DIC(9.4,60,22,13,"PAH",173,1,113,0)="the label."
^DIC(9.4,60,22,13,"PAH",173,1,114,0)="  4. Patient name and last portion of the social security number are "
^DIC(9.4,60,22,13,"PAH",173,1,115,0)="bolded."
^DIC(9.4,60,22,13,"PAH",173,1,116,0)="  5. If the bottle cap is ""non-safety"", it will be bolded."
^DIC(9.4,60,22,13,"PAH",173,1,117,0)="  6. Currently long SIG's that do not fit on one pharmacy fill card label"
^DIC(9.4,60,22,13,"PAH",173,1,118,0)="print only 4 lines of SIG on the first label and up to 4 lines on each"
^DIC(9.4,60,22,13,"PAH",173,1,119,0)="continuation label. This patch increases the number of lines of the SIG "
^DIC(9.4,60,22,13,"PAH",173,1,120,0)="that print on each pharmacy fill card label to reduce the total number of"
^DIC(9.4,60,22,13,"PAH",173,1,121,0)="labels needed."
^DIC(9.4,60,22,13,"PAH",173,1,122,0)="  7. The words ""3rd Party Rx"" and the NDC number are added when that "
^DIC(9.4,60,22,13,"PAH",173,1,123,0)="information is available. (Added for HIPAA/NCPDP)."
^DIC(9.4,60,22,13,"PAH",173,1,124,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,125,0)="Patient fill section changes:"
^DIC(9.4,60,22,13,"PAH",173,1,126,0)="============================"
^DIC(9.4,60,22,13,"PAH",173,1,127,0)="  1. The barcode will print every time even if there are no refills."
^DIC(9.4,60,22,13,"PAH",173,1,128,0)="  2. The site telephone number will print when the ""PHONE IN OR MAIL THIS "
^DIC(9.4,60,22,13,"PAH",173,1,129,0)="REFILL REQUEST"" prints."
^DIC(9.4,60,22,13,"PAH",173,1,130,0)="  3. The text ""n refills left until MMM DD,YYYY is changed to ""May refill "
^DIC(9.4,60,22,13,"PAH",173,1,131,0)="nX by MMM DD,YYYY""."
^DIC(9.4,60,22,13,"PAH",173,1,132,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,133,0)="Prescription Document PMI section changes:"
^DIC(9.4,60,22,13,"PAH",173,1,134,0)="========================================="
^DIC(9.4,60,22,13,"PAH",173,1,135,0)="  1. The PMI will print in the patient's language preference."
^DIC(9.4,60,22,13,"PAH",173,1,136,0)="  2. The white spaces between sections of the PMI document will be "
^DIC(9.4,60,22,13,"PAH",173,1,137,0)="reduced to result in a few more lines fitting on the page."
^DIC(9.4,60,22,13,"PAH",173,1,138,0)="  3. If there are more than 5 warning labels, the additional warnings "
^DIC(9.4,60,22,13,"PAH",173,1,139,0)="will print at the top of the PMI section."
^DIC(9.4,60,22,13,"PAH",173,1,140,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,141,0)="Trailing document changes:"
^DIC(9.4,60,22,13,"PAH",173,1,142,0)="========================="
^DIC(9.4,60,22,13,"PAH",173,1,143,0)="  1. The patient's phone number followed by an underline will print on "
^DIC(9.4,60,22,13,"PAH",173,1,144,0)="the address change form."
^DIC(9.4,60,22,13,"PAH",173,1,145,0)="  2. In the Allergies/ADR section, the name and last six digits of the "
^DIC(9.4,60,22,13,"PAH",173,1,146,0)="social security number will be made larger and will be bolded."
^DIC(9.4,60,22,13,"PAH",173,1,147,0)="  3. In the Allergies/ADR section, if the HOSPITAL LOCATION file (#44), "
^DIC(9.4,60,22,13,"PAH",173,1,148,0)="TYPE field (#2) type equals ""W"" for any prescription printed for this "
^DIC(9.4,60,22,13,"PAH",173,1,149,0)="patient in the current print job, then the word ""INPATIENT"" will print "
^DIC(9.4,60,22,13,"PAH",173,1,150,0)="on the line following the patient name."
^DIC(9.4,60,22,13,"PAH",173,1,151,0)="  4. In the Allergies/ADR section, if some sections do not have data, the "
^DIC(9.4,60,22,13,"PAH",173,1,152,0)="header will not print. If no information exists, ""No Assessment Made"" "
^DIC(9.4,60,22,13,"PAH",173,1,153,0)="will print after the Verified Allergies heading."
^DIC(9.4,60,22,13,"PAH",173,1,154,0)="  5. In the refill narrative or copay narrative sections, if there are "
^DIC(9.4,60,22,13,"PAH",173,1,155,0)="more than seven lines from the original text, only the first seven lines "
^DIC(9.4,60,22,13,"PAH",173,1,156,0)="will print. (They could appear as more than seven lines if there is some "
^DIC(9.4,60,22,13,"PAH",173,1,157,0)="wrapping of the text)."
^DIC(9.4,60,22,13,"PAH",173,1,158,0)="  6. If the Multi-Rx refill section is blank, the SITE NUMBER field "
^DIC(9.4,60,22,13,"PAH",173,1,159,0)="(#.06) from the OUTPATIENT SITE file (#59) will print bottom right"
^DIC(9.4,60,22,13,"PAH",173,1,160,0)="justified."
^DIC(9.4,60,22,13,"PAH",173,1,161,0)=" "
^DIC(9.4,60,22,13,"PAH",173,1,162,0)="A utility routine is included in this patch to change some of the control"
^DIC(9.4,60,22,13,"PAH",173,1,163,0)="codes in the TERMINAL TYPE file (#3.2). "
^DIC(9.4,60,22,13,"PAH",173,1,164,0)="Once the patch is installed, running the routine PSOLLU4 in programmer"
^DIC(9.4,60,22,13,"PAH",173,1,165,0)="mode will make slight adjustments to PATIENT FILL INITIALIZATION, "
^DIC(9.4,60,22,13,"PAH",173,1,166,0)="PHARMACY FILL DOCUMENT WARNING, MAILING LABEL INITIALIZATION, and RETURN "
^DIC(9.4,60,22,13,"PAH",173,1,167,0)="MAIL INITIALIZATION settings."
^DIC(9.4,60,22,13,"PAH",173,1,168,0)="Note: you must have your FileMan access set to '@' to run the routine. "
^DIC(9.4,60,22,13,"PAH",174,0)="195 SEQ #177^3050525^1"
^DIC(9.4,60,22,13,"PAH",174,1,0)="^^3^3^3050525"
^DIC(9.4,60,22,13,"PAH",174,1,1,0)="Display Patient Record Flag consistently when finishing outpatient "
^DIC(9.4,60,22,13,"PAH",174,1,2,0)="pharmacy orders via the Complete Orders from OERR [PSO LMOE FINISH]"
^DIC(9.4,60,22,13,"PAH",174,1,3,0)="option."
^DIC(9.4,60,22,13,"PAH",175,0)="196 SEQ #178^3050611^1"
^DIC(9.4,60,22,13,"PAH",175,1,0)="^^4^4^3050611"
^DIC(9.4,60,22,13,"PAH",175,1,1,0)="If a user runs option Return Medication to Stock in the Outpatient "
^DIC(9.4,60,22,13,"PAH",175,1,2,0)="Pharmacy menu and then goes into the Controlled Substances option"
^DIC(9.4,60,22,13,"PAH",175,1,3,0)="Balance Adjustments, the dispensing site defaults to the one chosen when"
^DIC(9.4,60,22,13,"PAH",175,1,4,0)="doing the Return Medication to Stock option."
^DIC(9.4,60,22,13,"PAH",176,0)="202 SEQ #179^3050611^1"
^DIC(9.4,60,22,13,"PAH",176,1,0)="^^4^4^3050611"
^DIC(9.4,60,22,13,"PAH",176,1,1,0)="This patch corrects the duplicate medication checking of meds that were"
^DIC(9.4,60,22,13,"PAH",176,1,2,0)="ordered initially as both a NON-VA and an Outpatient med. This occurs in"
^DIC(9.4,60,22,13,"PAH",176,1,3,0)="Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option when you"
^DIC(9.4,60,22,13,"PAH",176,1,4,0)="verify a Non-Verified med"
^DIC(9.4,60,22,13,"PAH",177,0)="199 SEQ #180^3050709^1"
^DIC(9.4,60,22,13,"PAH",177,1,0)="^^1^1^3050709"
^DIC(9.4,60,22,13,"PAH",177,1,1,0)="DEATH ENTRY PROBLEM"
^DIC(9.4,60,22,13,"PAH",178,0)="174 SEQ #181^3050813^1"
^DIC(9.4,60,22,13,"PAH",178,1,0)="^^4^4^3050813"
^DIC(9.4,60,22,13,"PAH",178,1,1,0)="1. Partial deletion causing error. This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",178,1,2,0)="2. Methadone drug being the only drug released when the Nightly"
^DIC(9.4,60,22,13,"PAH",178,1,3,0)="Management Data Compile Job is run causing error."
^DIC(9.4,60,22,13,"PAH",178,1,4,0)="This patch fixes this problem."
^DIC(9.4,60,22,13,"PAH",179,0)="203 SEQ #182^3050813^1"
^DIC(9.4,60,22,13,"PAH",179,1,0)="^^2^2^3050813"
^DIC(9.4,60,22,13,"PAH",179,1,1,0)="Correct error when trying to add a NON-VA Med order to the PHARMACY "
^DIC(9.4,60,22,13,"PAH",179,1,2,0)="PATIENT file #55 in the ""NVA"" multiple file #55.05."
^DIC(9.4,60,22,13,"PAH",180,0)="205 SEQ #183^3050813^1"
^DIC(9.4,60,22,13,"PAH",180,1,0)="^^6^6^3050813"
^DIC(9.4,60,22,13,"PAH",180,1,1,0)="This patch adds the VUID (VHA Unique Identifiers) from the VA PRODUCT file"
^DIC(9.4,60,22,13,"PAH",180,1,2,0)="(#50.68) to the Outpatient Pharmacy VDEF (Vista Data Extraction Framework)"
^DIC(9.4,60,22,13,"PAH",180,1,3,0)="message that sends prescription information to the HDR (Health Data"
^DIC(9.4,60,22,13,"PAH",180,1,4,0)="Repository). It also replaces Set of Code fields in the message with"
^DIC(9.4,60,22,13,"PAH",180,1,5,0)="VUIDs. It also adds a check to screen out prescription information for"
^DIC(9.4,60,22,13,"PAH",180,1,6,0)="test patients from being sent to the HDR."
^DIC(9.4,60,22,13,"PAH",181,0)="210 SEQ #184^3050813^1"
^DIC(9.4,60,22,13,"PAH",181,1,0)="^^3^3^3050813"
^DIC(9.4,60,22,13,"PAH",181,1,1,0)="Correct a word wrapping problem with Provider Comments and Patient "
^DIC(9.4,60,22,13,"PAH",181,1,2,0)="Instructions when there is a very large word, greater than 30 characters."
^DIC(9.4,60,22,13,"PAH",181,1,3,0)="Usually the word is a list seperated by commas with no spaces."
^DIC(9.4,60,22,13,"PAH",182,0)="204 SEQ #185^3050905^1"
^DIC(9.4,60,22,13,"PAH",182,1,0)="^^56^56^3050905"
^DIC(9.4,60,22,13,"PAH",182,1,1,0)="1. My HealtheVet team in preparation for the My HealtyVet V. 1.0"
^DIC(9.4,60,22,13,"PAH",182,1,2,0)="    package (Internet Prescription Refill project), requested an"
^DIC(9.4,60,22,13,"PAH",182,1,3,0)="    additional Outpatient Pharmacy V. 7.0 Application Program Interface"
^DIC(9.4,60,22,13,"PAH",182,1,4,0)="    (API) #4687, to provide details of all (active, verified, on hold,"
^DIC(9.4,60,22,13,"PAH",182,1,5,0)="    suspended, discontinued, pending and expired), prescriptions for a"
^DIC(9.4,60,22,13,"PAH",182,1,6,0)="    patient within a given date."
^DIC(9.4,60,22,13,"PAH",182,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,8,0)=" 2. Also the existing API #3768 has been modified to provide the following"
^DIC(9.4,60,22,13,"PAH",182,1,9,0)="    status for Internet refill requests (used internally):"
^DIC(9.4,60,22,13,"PAH",182,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,11,0)="    Calling AP1 component will return the following status:"
^DIC(9.4,60,22,13,"PAH",182,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,13,0)="   -5      DFN does not match RX"
^DIC(9.4,60,22,13,"PAH",182,1,14,0)="   -4      Unable to resolve patient"
^DIC(9.4,60,22,13,"PAH",182,1,15,0)="   -3      Unable to resolve prescription"
^DIC(9.4,60,22,13,"PAH",182,1,16,0)="   -2      Status is pending"
^DIC(9.4,60,22,13,"PAH",182,1,17,0)="   -1      Result is back but not picked up"
^DIC(9.4,60,22,13,"PAH",182,1,18,0)="    0      Other error"
^DIC(9.4,60,22,13,"PAH",182,1,19,0)="    1      Filed in PRESCRIPTION REFILL REQUEST file (#52.43)"
^DIC(9.4,60,22,13,"PAH",182,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,21,0)="    Calling AP2 component will return the following status:"
^DIC(9.4,60,22,13,"PAH",182,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,23,0)="    -6     RX not in file #52.43"
^DIC(9.4,60,22,13,"PAH",182,1,24,0)="    -5     DFN does not match RX"
^DIC(9.4,60,22,13,"PAH",182,1,25,0)="    -4     Unable to resolve patient"
^DIC(9.4,60,22,13,"PAH",182,1,26,0)="    -3     Unable to resolve prescription"
^DIC(9.4,60,22,13,"PAH",182,1,27,0)="    -2     Status is pending"
^DIC(9.4,60,22,13,"PAH",182,1,28,0)="    -1     Result is back but not picked up"
^DIC(9.4,60,22,13,"PAH",182,1,29,0)="     1     Filled"
^DIC(9.4,60,22,13,"PAH",182,1,30,0)="     2     Not Filled"
^DIC(9.4,60,22,13,"PAH",182,1,31,0)="     n^x   n - Date the refill request was processed."
^DIC(9.4,60,22,13,"PAH",182,1,32,0)="           x - The result of the processing. This will be either FILLED or"
^DIC(9.4,60,22,13,"PAH",182,1,33,0)="               NOT FILLED."
^DIC(9.4,60,22,13,"PAH",182,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,35,0)="     Calling AP5 component will return the following status:"
^DIC(9.4,60,22,13,"PAH",182,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,37,0)="     -6     RX not in file #52.43"
^DIC(9.4,60,22,13,"PAH",182,1,38,0)="     -4     Unable to resolve patient"
^DIC(9.4,60,22,13,"PAH",182,1,39,0)="     -3     Unable to resolve prescription"
^DIC(9.4,60,22,13,"PAH",182,1,40,0)="     -2     Status is pending"
^DIC(9.4,60,22,13,"PAH",182,1,41,0)="      0     The update was not successful. This will occur if any of the"
^DIC(9.4,60,22,13,"PAH",182,1,42,0)="            information provided (DFN, RX #) are invalid."
^DIC(9.4,60,22,13,"PAH",182,1,43,0)="      1     The update was successful."
^DIC(9.4,60,22,13,"PAH",182,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,45,0)=" 3. A new PATIENT field (#9) was added to the PRESCRIPTION REFILL REQUEST"
^DIC(9.4,60,22,13,"PAH",182,1,46,0)="    file (#52.43) that is a pointer to the PAITENT file (#2).  A new"
^DIC(9.4,60,22,13,"PAH",182,1,47,0)="    ""AC"" cross reference was added, to index the file by PATIENT field"
^DIC(9.4,60,22,13,"PAH",182,1,48,0)="    (#9) and PRESCRIPTION IEN field (#8). The existing ""AA"", and ""AB"""
^DIC(9.4,60,22,13,"PAH",182,1,49,0)="    cross references were removed."
^DIC(9.4,60,22,13,"PAH",182,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",182,1,51,0)=" Note: This patch carries a Pre-install routine that will delete the"
^DIC(9.4,60,22,13,"PAH",182,1,52,0)=" Data Dictionary (DD) of the PRESCRIPTION REFILL REQUEST file (#52.43)"
^DIC(9.4,60,22,13,"PAH",182,1,53,0)=" before the install of the new DD. This file is not in use currently,"
^DIC(9.4,60,22,13,"PAH",182,1,54,0)=" however, it will not destroy any data in the test systems."
^DIC(9.4,60,22,13,"PAH",182,1,55,0)=" For more details, please refer to the installation guide or the technical"
^DIC(9.4,60,22,13,"PAH",182,1,56,0)=" manual of the My HealthyVet V. 1.0 package."
^DIC(9.4,60,22,13,"PAH",183,0)="209 SEQ #186^3050905^1"
^DIC(9.4,60,22,13,"PAH",183,1,0)="^^5^5^3050905"
^DIC(9.4,60,22,13,"PAH",183,1,1,0)="Corrects the following problems: 1) OPAI does not have an interface to "
^DIC(9.4,60,22,13,"PAH",183,1,2,0)="the Drug Accountability package. 2) OPAI when a code comes back to "
^DIC(9.4,60,22,13,"PAH",183,1,3,0)="indicate it did not dispense the drug, VistA Outpatient Pharmacy "
^DIC(9.4,60,22,13,"PAH",183,1,4,0)="indicates on the acitivity log that it did not, but actually does release "
^DIC(9.4,60,22,13,"PAH",183,1,5,0)="the drug,  3) On a refill from OPAI, the Copay is not billed correclty."
^DIC(9.4,60,22,13,"PAH",184,0)="215 SEQ #187^3050905^1"
^DIC(9.4,60,22,13,"PAH",184,1,0)="^^3^3^3050905"
^DIC(9.4,60,22,13,"PAH",184,1,1,0)="Produce a Tally message & report of all Outpatient Pharmacy refills that "
^DIC(9.4,60,22,13,"PAH",184,1,2,0)="were released via the OPAI 2.4 automated interface since the install of "
^DIC(9.4,60,22,13,"PAH",184,1,3,0)="patch PSO*7*156."
^DIC(9.4,60,22,13,"PAH",185,0)="143^3050905^1"
^DIC(9.4,60,22,13,"PAH",185,1,0)="^^1^1^3050905"
^DIC(9.4,60,22,13,"PAH",185,1,1,0)="PSO*7.0*143 = Outpatient Pharmacy Clinical Indicator Data Capture (CIDC) KIDS"
^DIC(9.4,60,22,13,"PAH",186,0)="198 SEQ #189^3051020^1"
^DIC(9.4,60,22,13,"PAH",186,1,0)="^^3^3^3051020"
^DIC(9.4,60,22,13,"PAH",186,1,1,0)="Correct partially built NTE6 segment sent via OPAI, correct run-on words "
^DIC(9.4,60,22,13,"PAH",186,1,2,0)="in the PMI segment in HL7 messages sent via OPAI, and correct PSO "
^DIC(9.4,60,22,13,"PAH",186,1,3,0)="Management Reports from skipping Released RX's with date and no times."
^DIC(9.4,60,22,13,"PAH",187,0)="217 SEQ #191^3051020^1"
^DIC(9.4,60,22,13,"PAH",187,1,0)="^^4^4^3051020"
^DIC(9.4,60,22,13,"PAH",187,1,1,0)="Prompt for a Tally or Back-Bill run and based on this response either "
^DIC(9.4,60,22,13,"PAH",187,1,2,0)="produce a Tally or Back-Billing message & report of all Outpatient"
^DIC(9.4,60,22,13,"PAH",187,1,3,0)="Pharmacy refills that were released via the OPAI 2.4 automated interface"
^DIC(9.4,60,22,13,"PAH",187,1,4,0)="since the install of patch PSO*7*156."
^DIC(9.4,60,22,13,"PAH",188,0)="221 SEQ #192^3051115^1"
^DIC(9.4,60,22,13,"PAH",188,1,0)="^^1^1^3051115"
^DIC(9.4,60,22,13,"PAH",188,1,1,0)="PFP PSO*7.0*221 UPDATE TO PSO*7.0*174"
^DIC(9.4,60,22,13,"PAH",189,0)="219 SEQ #193^3051202^1"
^DIC(9.4,60,22,13,"PAH",189,1,0)="^^223^223^3051202"
^DIC(9.4,60,22,13,"PAH",189,1,1,0)="This patch is a follow up for Outpatient Pharmacy Clinical Indicator Data"
^DIC(9.4,60,22,13,"PAH",189,1,2,0)="Capture (CIDC) patch PSO*7*143."
^DIC(9.4,60,22,13,"PAH",189,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,4,0)="Functional Description:"
^DIC(9.4,60,22,13,"PAH",189,1,5,0)="----------------------"
^DIC(9.4,60,22,13,"PAH",189,1,6,0)="This Outpatient Pharmacy patch PSO*7*219 corrects the following issues:"
^DIC(9.4,60,22,13,"PAH",189,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,8,0)="1.  The Application Program Interface (API) that is provided to "
^DIC(9.4,60,22,13,"PAH",189,1,9,0)="Computerized Patient Record System (CPRS) with the service connection (SC)"
^DIC(9.4,60,22,13,"PAH",189,1,10,0)="and environmental indicator (EI) questions was not set correctly for non"
^DIC(9.4,60,22,13,"PAH",189,1,11,0)="service connected (NSC) patients, as a result the following issues were"
^DIC(9.4,60,22,13,"PAH",189,1,12,0)="reported:"
^DIC(9.4,60,22,13,"PAH",189,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,14,0)="a. In CPRS, the SC related questions were incorrectly prompted for NSC"
^DIC(9.4,60,22,13,"PAH",189,1,15,0)="patients, and it should not have done so. It should prompt SC/EI question"
^DIC(9.4,60,22,13,"PAH",189,1,16,0)="only if applicable.(remedy ticket 114219)."
^DIC(9.4,60,22,13,"PAH",189,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,18,0)="b. Holders of the PSO COPAY key, the ordering provider, and the finishing"
^DIC(9.4,60,22,13,"PAH",189,1,19,0)="pharmacist were receiving increased volumes of mailman messages in "
^DIC(9.4,60,22,13,"PAH",189,1,20,0)="Outpatient Pharmacy.  Mailman messages were incorrectly sent for NSC"
^DIC(9.4,60,22,13,"PAH",189,1,21,0)="patients upon refill, new, and renewed orders (remedy ticket 114219)."
^DIC(9.4,60,22,13,"PAH",189,1,22,0)="These messages have been eliminated.  Mailman messages will still be"
^DIC(9.4,60,22,13,"PAH",189,1,23,0)="generated for the following scenarios:"
^DIC(9.4,60,22,13,"PAH",189,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,25,0)="                 SC percentage"
^DIC(9.4,60,22,13,"PAH",189,1,26,0)="                 - age changed   E/I question"
^DIC(9.4,60,22,13,"PAH",189,1,27,0)="     Type        to >0%          added?          Mailman Message sent?"
^DIC(9.4,60,22,13,"PAH",189,1,28,0)="     ---------   --------------  -------------   -------------------------"
^DIC(9.4,60,22,13,"PAH",189,1,29,0)="     NSC         N               N               N        "
^DIC(9.4,60,22,13,"PAH",189,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,31,0)="     NSC         N               Y               Y only if question was"
^DIC(9.4,60,22,13,"PAH",189,1,32,0)="                                                     not answered before"
^DIC(9.4,60,22,13,"PAH",189,1,33,0)="                                                     the prescription is"
^DIC(9.4,60,22,13,"PAH",189,1,34,0)="                                                     released"
^DIC(9.4,60,22,13,"PAH",189,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,36,0)="     NSC         Y               N/A             Y if question was not"
^DIC(9.4,60,22,13,"PAH",189,1,37,0)="                                                     answered before the"
^DIC(9.4,60,22,13,"PAH",189,1,38,0)="                                                     prescription is"
^DIC(9.4,60,22,13,"PAH",189,1,39,0)="                                                     released"
^DIC(9.4,60,22,13,"PAH",189,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,41,0)="     SC=>0%<50%  N/A             Y               Y  however, NO mailman"
^DIC(9.4,60,22,13,"PAH",189,1,42,0)="                                                      message will be sent"
^DIC(9.4,60,22,13,"PAH",189,1,43,0)="                                                      if any SC/EI = YES"
^DIC(9.4,60,22,13,"PAH",189,1,44,0)="                                                      on the original"
^DIC(9.4,60,22,13,"PAH",189,1,45,0)="                                                      prescription "
^DIC(9.4,60,22,13,"PAH",189,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,47,0)="     For SC>50% prescriptions and if patient has a new SC/EI added, the"
^DIC(9.4,60,22,13,"PAH",189,1,48,0)="     appropriate questions will be asked upon RENEW or COPY of the"
^DIC(9.4,60,22,13,"PAH",189,1,49,0)="     original prescription. At release, a MailMan message will not be sent"
^DIC(9.4,60,22,13,"PAH",189,1,50,0)="     if the patient, patient status, or drug is exempt from copay."
^DIC(9.4,60,22,13,"PAH",189,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,52,0)="Because the information requested by these Mailman messages are used to "
^DIC(9.4,60,22,13,"PAH",189,1,53,0)="determine the final VA copay and/or insurance billable status, the text "
^DIC(9.4,60,22,13,"PAH",189,1,54,0)="and format has changed.  The subject line was changed from ""RX COPAY "
^DIC(9.4,60,22,13,"PAH",189,1,55,0)="STATUS REVIEW NEEDED"" to ""PRESCRIPTION QUESTIONS REVIEW NEEDED"" and the"
^DIC(9.4,60,22,13,"PAH",189,1,56,0)="body of the message has additional information.  Also, the eligibility and"
^DIC(9.4,60,22,13,"PAH",189,1,57,0)="disability information is now included after the patient name. The"
^DIC(9.4,60,22,13,"PAH",189,1,58,0)="following is an example:"
^DIC(9.4,60,22,13,"PAH",189,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,60,0)="Subj: PRESCRIPTION QUESTIONS REVIEW NEEDED (800)  [#164897] 10/07/05@13:39"
^DIC(9.4,60,22,13,"PAH",189,1,61,0)="37 lines"
^DIC(9.4,60,22,13,"PAH",189,1,62,0)="From: OUTPATIENT PHARMACY PACKAGE  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",189,1,63,0)="-------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",189,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,65,0)="PATIENT,TEST  (XXXX)  "
^DIC(9.4,60,22,13,"PAH",189,1,66,0)="Eligibility: SC LESS THAN 50%     SC%: 10"
^DIC(9.4,60,22,13,"PAH",189,1,67,0)="             REIMBURSABLE INSURANCE"
^DIC(9.4,60,22,13,"PAH",189,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,69,0)="Disabilities: ARTHRITIS-10%(SC), FOREARM CONDITION-5%(NSC), "
^DIC(9.4,60,22,13,"PAH",189,1,70,0)="              FOREARM CONDITION-4%(NSC), BENIGN EYE GROWTH-0%(NSC), "
^DIC(9.4,60,22,13,"PAH",189,1,71,0)="              LOSS OF FIELD OF VISION-20%(SC), "
^DIC(9.4,60,22,13,"PAH",189,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,73,0)="Rx# #######B (1)    NO COPAY"
^DIC(9.4,60,22,13,"PAH",189,1,74,0)="AMITRIPTYLINE 100MG"
^DIC(9.4,60,22,13,"PAH",189,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,76,0)="Due to a change in criteria, additional information listed below is needed"
^DIC(9.4,60,22,13,"PAH",189,1,77,0)="to determine the final VA copay and/or insurance billable status for this "
^DIC(9.4,60,22,13,"PAH",189,1,78,0)="Rx so that appropriate action can be taken by pharmacy personnel."
^DIC(9.4,60,22,13,"PAH",189,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,80,0)="Is this Rx for a Service Connected Condition?"
^DIC(9.4,60,22,13,"PAH",189,1,81,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,83,0)="Enter RETURN to continue or '^' to exit: "
^DIC(9.4,60,22,13,"PAH",189,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,86,0)="Subj: PRESCRIPTION QUESTIONS REVIEW NEEDED (800)  [#164897]   Page 2"
^DIC(9.4,60,22,13,"PAH",189,1,87,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",189,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,89,0)="This message has been sent to the provider of record, the pharmacist who"
^DIC(9.4,60,22,13,"PAH",189,1,90,0)="finished the prescription order, and all holders of the PSO COPAY key."
^DIC(9.4,60,22,13,"PAH",189,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,92,0)="Providers:"
^DIC(9.4,60,22,13,"PAH",189,1,93,0)="Please respond with your answer to the question(s) as a reply to this"
^DIC(9.4,60,22,13,"PAH",189,1,94,0)="message. The prescription will be updated by the appropriate staff."
^DIC(9.4,60,22,13,"PAH",189,1,95,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,96,0)="Staff assigned to update the Prescription responses:"
^DIC(9.4,60,22,13,"PAH",189,1,97,0)="Please use the RESET COPAY STATUS/CANCEL CHARGES option to enter the "
^DIC(9.4,60,22,13,"PAH",189,1,98,0)="responses to the questions above, which may result in a Rx copay status"
^DIC(9.4,60,22,13,"PAH",189,1,99,0)="change and/or the need to remove VA copay charges or may result in a"
^DIC(9.4,60,22,13,"PAH",189,1,100,0)="charge to the patient's insurance carrier."
^DIC(9.4,60,22,13,"PAH",189,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,102,0)="Note: The SC question is now asked for Veterans who are SC>49% in order to"
^DIC(9.4,60,22,13,"PAH",189,1,103,0)="determine if the Rx can be billed to a third party insurance. These "
^DIC(9.4,60,22,13,"PAH",189,1,104,0)="Veterans will NOT be charged a VA copay."
^DIC(9.4,60,22,13,"PAH",189,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,106,0)="Supply and investigational drugs are not charged a VA copay but could be"
^DIC(9.4,60,22,13,"PAH",189,1,107,0)="reimbursable by third party insurance."
^DIC(9.4,60,22,13,"PAH",189,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,109,0)="Enter message action (in IN basket): Ignore// "
^DIC(9.4,60,22,13,"PAH",189,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,111,0)="c.  In CPRS, SC/EI related questions were not asked for supply items "
^DIC(9.4,60,22,13,"PAH",189,1,112,0)="and investigational drugs (remedy ticket 11421). CPRS and backdoor "
^DIC(9.4,60,22,13,"PAH",189,1,113,0)="Outpatient Pharmacy users will be required to complete SC/EI questions for"
^DIC(9.4,60,22,13,"PAH",189,1,114,0)="supplies and investigational drugs. Supply items and investigational drugs"
^DIC(9.4,60,22,13,"PAH",189,1,115,0)="could be reimbursable by third party insurance. Also, a VA copay will not"
^DIC(9.4,60,22,13,"PAH",189,1,116,0)="be charged for these."
^DIC(9.4,60,22,13,"PAH",189,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,118,0)="2.  During use of Complete Orders from OERR option [PSO LMOE FINISH], the"
^DIC(9.4,60,22,13,"PAH",189,1,119,0)="default answers for SC/EI's for CPRS SC>50% renewed orders were"
^DIC(9.4,60,22,13,"PAH",189,1,120,0)="occasionally displaying the previous orders answers during the finish"
^DIC(9.4,60,22,13,"PAH",189,1,121,0)="process.  A modification was made to display the SC/EI information entered"
^DIC(9.4,60,22,13,"PAH",189,1,122,0)="during the CPRS renewal process.  This anomaly was encountered during"
^DIC(9.4,60,22,13,"PAH",189,1,123,0)="unit testing, and there is no associated remedy ticket."
^DIC(9.4,60,22,13,"PAH",189,1,124,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,125,0)="3.  For renewal orders in Complete Orders from OERR option [PSO LMOE "
^DIC(9.4,60,22,13,"PAH",189,1,126,0)="FINISH] and Patient Prescription Processing option [PSO LM BACKDOOR "
^DIC(9.4,60,22,13,"PAH",189,1,127,0)="ORDERS], a message was erroneously displayed after the SC/EI prompts for"
^DIC(9.4,60,22,13,"PAH",189,1,128,0)="SC>50% prescriptions.  The following is an example of the message"
^DIC(9.4,60,22,13,"PAH",189,1,129,0)="displayed when eligibility is changed or the user enters an up arrows (^)"
^DIC(9.4,60,22,13,"PAH",189,1,130,0)="at an outpatient classification prompt.  Note that the bracketed"
^DIC(9.4,60,22,13,"PAH",189,1,131,0)="information can be SERVICE CONNECTED or NON SERVICE CONNECTED depending"
^DIC(9.4,60,22,13,"PAH",189,1,132,0)="upon the user's response to the question.  Or if the user up arrows (^)"
^DIC(9.4,60,22,13,"PAH",189,1,133,0)="out of the prompt, the default answer determines the value."
^DIC(9.4,60,22,13,"PAH",189,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,135,0)="           Was treatment for a Service Connected condition? YES// ^"
^DIC(9.4,60,22,13,"PAH",189,1,136,0)="           This Renewal has been designated as [SERVICE CONNECTED]"
^DIC(9.4,60,22,13,"PAH",189,1,137,0)="           Please use the 'Reset Copay Status/Cancel Charges' option to"
^DIC(9.4,60,22,13,"PAH",189,1,138,0)="           make corrections."
^DIC(9.4,60,22,13,"PAH",189,1,139,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,140,0)="The ""Please use the 'Reset Copay Status/Cancel Charges' option to make"
^DIC(9.4,60,22,13,"PAH",189,1,141,0)="corrections"" sentence will no longer be displayed for supply items,"
^DIC(9.4,60,22,13,"PAH",189,1,142,0)="investigational drugs, and SC>50% patients.  The first sentence will"
^DIC(9.4,60,22,13,"PAH",189,1,143,0)="remain in order to continue to inform the user of the answer stored for"
^DIC(9.4,60,22,13,"PAH",189,1,144,0)="the prompt.  Note that similar messages are displayed for environmental"
^DIC(9.4,60,22,13,"PAH",189,1,145,0)="indicator prompts and this change applies to them. The associated remedy"
^DIC(9.4,60,22,13,"PAH",189,1,146,0)="tickets are 11393 and 113931."
^DIC(9.4,60,22,13,"PAH",189,1,147,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,148,0)="4.  For CPRS prescription orders finished using the Complete Orders from"
^DIC(9.4,60,22,13,"PAH",189,1,149,0)="OERR option [PSO LMOE FINISH] or the Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",189,1,150,0)="option [PSO LM BACKDOOR ORDERS], a copay related message was displayed for"
^DIC(9.4,60,22,13,"PAH",189,1,151,0)="SC>50% patients, supply items and investigational drugs.  The following is"
^DIC(9.4,60,22,13,"PAH",189,1,152,0)="an example, and please note that bracketed information can be either COPAY"
^DIC(9.4,60,22,13,"PAH",189,1,153,0)="or NO COPAY depending on the providers response to the clinical indicator."
^DIC(9.4,60,22,13,"PAH",189,1,154,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,155,0)="     Do you want to enter a Progress Note? No//   NO"
^DIC(9.4,60,22,13,"PAH",189,1,156,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,157,0)="            SC Percent: 40%"
^DIC(9.4,60,22,13,"PAH",189,1,158,0)="            Disabilities: NONE STATED"
^DIC(9.4,60,22,13,"PAH",189,1,159,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,160,0)="     This Rx has been flagged by the provider as: [NO COPAY]"
^DIC(9.4,60,22,13,"PAH",189,1,161,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,162,0)="     Was treatment for Service Connected condition? YES"
^DIC(9.4,60,22,13,"PAH",189,1,163,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,164,0)="The ""This Rx has been flagged by the provider as: [COPAY/NO COPAY]"""
^DIC(9.4,60,22,13,"PAH",189,1,165,0)="message will no longer be displayed for SC>50% patients, supply items, "
^DIC(9.4,60,22,13,"PAH",189,1,166,0)="and investigational drugs.  There is no associated remedy ticket."
^DIC(9.4,60,22,13,"PAH",189,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,168,0)="5.  When an edit that creates a new order is performed in Outpatient "
^DIC(9.4,60,22,13,"PAH",189,1,169,0)="Pharmacy, a message is displayed to notate that the orderable item was"
^DIC(9.4,60,22,13,"PAH",189,1,170,0)="changed.  This message is displayed in the Complete Orders from OERR"
^DIC(9.4,60,22,13,"PAH",189,1,171,0)="[PSO LMOE FINISH] option and the Patient Prescription Processing option"
^DIC(9.4,60,22,13,"PAH",189,1,172,0)="[PSO LM BACKDOOR ORDERS]. The following is an example:"
^DIC(9.4,60,22,13,"PAH",189,1,173,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,174,0)="      CARBAMAZEPINE 100MG TAB"
^DIC(9.4,60,22,13,"PAH",189,1,175,0)="      PROVIDER,NAME           PROVIDER,NAME"
^DIC(9.4,60,22,13,"PAH",189,1,176,0)="      # of Refills: 3"
^DIC(9.4,60,22,13,"PAH",189,1,177,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,178,0)="      The Pharmacy Orderable Item has changed for this order. Please"
^DIC(9.4,60,22,13,"PAH",189,1,179,0)="      review any existing medication copay exemption defaults carefully"
^DIC(9.4,60,22,13,"PAH",189,1,180,0)="      for appropriateness."
^DIC(9.4,60,22,13,"PAH",189,1,181,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,182,0)="      SC Percent: 40%"
^DIC(9.4,60,22,13,"PAH",189,1,183,0)="      Disabilities: NONE STATED"
^DIC(9.4,60,22,13,"PAH",189,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,185,0)="      Was treatment for Service Connected condition? YES// "
^DIC(9.4,60,22,13,"PAH",189,1,186,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,187,0)="The above message has been modified to the following:"
^DIC(9.4,60,22,13,"PAH",189,1,188,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,189,0)="      The Pharmacy Orderable Item has changed for this order. Please"
^DIC(9.4,60,22,13,"PAH",189,1,190,0)="      review any existing SC or Environmental Indicator defaults carefully"
^DIC(9.4,60,22,13,"PAH",189,1,191,0)="      for appropriateness."
^DIC(9.4,60,22,13,"PAH",189,1,192,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,193,0)="Technical Description:"
^DIC(9.4,60,22,13,"PAH",189,1,194,0)="----------------------"
^DIC(9.4,60,22,13,"PAH",189,1,195,0)="The following correlates to each sequence in the Functional Description "
^DIC(9.4,60,22,13,"PAH",189,1,196,0)="above and the routines modified are shown in parentheses by each function:"
^DIC(9.4,60,22,13,"PAH",189,1,197,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,198,0)="1.  The SCNEW^PSOCP API was returning PSOTG(""SC"")="""" variable for NSC"
^DIC(9.4,60,22,13,"PAH",189,1,199,0)="patients which caused CPRS to erroneously prompt for them.  Also due to"
^DIC(9.4,60,22,13,"PAH",189,1,200,0)="this, Mailman messages for ""RX COPAY STATUS REVIEW NEEDED"" information was"
^DIC(9.4,60,22,13,"PAH",189,1,201,0)="sent in error for NSC prescriptions at release of the prescription. These"
^DIC(9.4,60,22,13,"PAH",189,1,202,0)="issues were corrected, and the PSOCPE routine was modified to show the"
^DIC(9.4,60,22,13,"PAH",189,1,203,0)="patient's eligibilities and disabilities as well as impart more accurate"
^DIC(9.4,60,22,13,"PAH",189,1,204,0)="information."
^DIC(9.4,60,22,13,"PAH",189,1,205,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,206,0)=" 2.  Modified renewal routines to always pull SC/EI information from the"
^DIC(9.4,60,22,13,"PAH",189,1,207,0)="data passed on the renewed order from CPRS (PSORENW1, PSORN52, PSORN52D)."
^DIC(9.4,60,22,13,"PAH",189,1,208,0)="This change affects renewals from CPRS and backdoor Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",189,1,209,0)="orders."
^DIC(9.4,60,22,13,"PAH",189,1,210,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,211,0)="3.  For SC>50% prescriptions, supply items and investigational drugs,"
^DIC(9.4,60,22,13,"PAH",189,1,212,0)="eliminated the display of ""Please use the 'Reset Copay Status/Cancel"
^DIC(9.4,60,22,13,"PAH",189,1,213,0)="Charges' option to make corrections."" sentence (PSOCPB, PSOMLLD2,"
^DIC(9.4,60,22,13,"PAH",189,1,214,0)="PSOMLLDT), but it will continue to be displayed for SC<50% prescriptions."
^DIC(9.4,60,22,13,"PAH",189,1,215,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,216,0)="4.  For SC>50% prescriptions, supply items and investigational drugs,"
^DIC(9.4,60,22,13,"PAH",189,1,217,0)="eliminated the display of ""This Rx has been flagged by the provider as:"
^DIC(9.4,60,22,13,"PAH",189,1,218,0)="[COPAY/NO COPAY]"" (PSOCPB, PSONEWF, PSORN52).  This message will continue"
^DIC(9.4,60,22,13,"PAH",189,1,219,0)="to be displayed for SC<50% patients."
^DIC(9.4,60,22,13,"PAH",189,1,220,0)=" "
^DIC(9.4,60,22,13,"PAH",189,1,221,0)="5.  For SC 0-100%, supply items and investigational drugs, modified the "
^DIC(9.4,60,22,13,"PAH",189,1,222,0)="wording of the message displayed when a prescription edit that creates a "
^DIC(9.4,60,22,13,"PAH",189,1,223,0)="new order is performed (PSOCPB, PSONEWF, PSONEWG)."
^DIC(9.4,60,22,13,"PAH",190,0)="212 SEQ #194^3051202^1"
^DIC(9.4,60,22,13,"PAH",190,1,0)="^^2^2^3051202"
^DIC(9.4,60,22,13,"PAH",190,1,1,0)="PREVENT THE Monthly Rx Cost Compilation OPTION FROM RUNNING MORE THAN "
^DIC(9.4,60,22,13,"PAH",190,1,2,0)="ONCE CON-CURRENTLY USING VARIBALE LOCKING TECHNIQUES."
^DIC(9.4,60,22,13,"PAH",191,0)="211 SEQ #195^3051202^1"
^DIC(9.4,60,22,13,"PAH",191,1,0)="^^5^5^3051202"
^DIC(9.4,60,22,13,"PAH",191,1,1,0)="This patch will modify the order process to require a physician to have a "
^DIC(9.4,60,22,13,"PAH",191,1,2,0)="DEA# or VA# to order controlled substances."
^DIC(9.4,60,22,13,"PAH",191,1,3,0)="It will also modify Script Talk label so if the instructions are more than"
^DIC(9.4,60,22,13,"PAH",191,1,4,0)="three lines, the message that the signature is too long will print "
^DIC(9.4,60,22,13,"PAH",191,1,5,0)="instead."
^DIC(9.4,60,22,13,"PAH",192,0)="216 SEQ #196^3051202^1"
^DIC(9.4,60,22,13,"PAH",192,1,0)="^^71^71^3051202"
^DIC(9.4,60,22,13,"PAH",192,1,1,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,2,0)="This patch will create and populate a new NCPDP NUMBER field (#1008) in"
^DIC(9.4,60,22,13,"PAH",192,1,3,0)="the OUTPATIENT SITE file (#59). This field is needed for the Remote Data"
^DIC(9.4,60,22,13,"PAH",192,1,4,0)="Interoperability Department of Defense (DoD) Clinical/Health Data "
^DIC(9.4,60,22,13,"PAH",192,1,5,0)="Repository (CHDR) application."
^DIC(9.4,60,22,13,"PAH",192,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,7,0)="NCPDP stands for the National Council for Prescription Drug Programs"
^DIC(9.4,60,22,13,"PAH",192,1,8,0)="formerly referred to as the National Association of Boards of Pharmacy"
^DIC(9.4,60,22,13,"PAH",192,1,9,0)="Number (NABP). The numbers being used to populate the field come from a"
^DIC(9.4,60,22,13,"PAH",192,1,10,0)="spreadsheet provided for this project dated 2/11/05."
^DIC(9.4,60,22,13,"PAH",192,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,12,0)="The PSO SITE INPUT TEMPLATE is changed to include the new field. Through"
^DIC(9.4,60,22,13,"PAH",192,1,13,0)="the PSO SITE PARAMETERS [Site Parameter Enter/Edit] option, the user can"
^DIC(9.4,60,22,13,"PAH",192,1,14,0)="add, edit, or delete the NCPDP assigned licensed pharmacy number."
^DIC(9.4,60,22,13,"PAH",192,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,16,0)="When the patch is installed, a post-install job will be queued to"
^DIC(9.4,60,22,13,"PAH",192,1,17,0)="populate the NCPDP number and a MailMan message will be sent indicating"
^DIC(9.4,60,22,13,"PAH",192,1,18,0)="the NCPDP numbers for each active division and site. If there is already"
^DIC(9.4,60,22,13,"PAH",192,1,19,0)="a value in the NCPDP number field, this patch will not overwrite it."
^DIC(9.4,60,22,13,"PAH",192,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,21,0)="Example MailMan message:"
^DIC(9.4,60,22,13,"PAH",192,1,22,0)="Subj: NCPDP NUMBER POPULATION  [#164410] 08/30/05@21:55  10 lines"
^DIC(9.4,60,22,13,"PAH",192,1,23,0)="From: PATCH PSO*7*216  In 'IN' basket.   Page 1"
^DIC(9.4,60,22,13,"PAH",192,1,24,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",192,1,25,0)="-----"
^DIC(9.4,60,22,13,"PAH",192,1,26,0)="Patch PSO*7*216 - POPULATE NCPDP NUMBER FIELD POST-INSTALL"
^DIC(9.4,60,22,13,"PAH",192,1,27,0)="This message is being sent to the installer of the patch and holders of"
^DIC(9.4,60,22,13,"PAH",192,1,28,0)="the PSORPH key."
^DIC(9.4,60,22,13,"PAH",192,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,30,0)="Please validate that the NCPDP number is correct for each active DIVISION "
^DIC(9.4,60,22,13,"PAH",192,1,31,0)="and"
^DIC(9.4,60,22,13,"PAH",192,1,32,0)="SITE NUMBER. If missing or incorrect, enter the correct number using the"
^DIC(9.4,60,22,13,"PAH",192,1,33,0)="Site Parameter Enter/Edit option."
^DIC(9.4,60,22,13,"PAH",192,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,35,0)="DIVISION:  EXT  SITE NUMBER:  500  NCPDP NUMBER: 0000001"
^DIC(9.4,60,22,13,"PAH",192,1,36,0)="DIVISION: TROY  SITE NUMBER:  514  NCPDP NUMBER: NO NUMBER FOUND"
^DIC(9.4,60,22,13,"PAH",192,1,37,0)="-------------------------------"
^DIC(9.4,60,22,13,"PAH",192,1,38,0)="This"
^DIC(9.4,60,22,13,"PAH",192,1,39,0)="patch will create and populate the NCPDP NUMBER field (#1008) in the"
^DIC(9.4,60,22,13,"PAH",192,1,40,0)="OUTPATIENT SITE file (#59). This field is needed for the Remote Data "
^DIC(9.4,60,22,13,"PAH",192,1,41,0)="Interoperability Department of Defense (DoD) CHDR application."
^DIC(9.4,60,22,13,"PAH",192,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,43,0)="NCPDP stands for the National Council for Prescription Drug Programs"
^DIC(9.4,60,22,13,"PAH",192,1,44,0)="formerly referred to as the National Association of Boards of Pharmacy "
^DIC(9.4,60,22,13,"PAH",192,1,45,0)="Number (NABP)."
^DIC(9.4,60,22,13,"PAH",192,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,47,0)="The PSO SITE INPUT TEMPLATE is changed to include the new field. Through"
^DIC(9.4,60,22,13,"PAH",192,1,48,0)="the PSO SITE PARAMETERS [Site Parameter Enter/Edit] option, the user can"
^DIC(9.4,60,22,13,"PAH",192,1,49,0)="add, edit, or delete the NCPDP assigned licensed pharmacy number."
^DIC(9.4,60,22,13,"PAH",192,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,51,0)="When the patch is installed, a post-install job will be queued to "
^DIC(9.4,60,22,13,"PAH",192,1,52,0)="populate the NCPDP number and a MailMan message will be sent indicating "
^DIC(9.4,60,22,13,"PAH",192,1,53,0)="the NCPDP numbers for each active division and site. If there is already "
^DIC(9.4,60,22,13,"PAH",192,1,54,0)="a value in the NCPDP number field, this patch will not overwrite it. "
^DIC(9.4,60,22,13,"PAH",192,1,55,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,56,0)="Example MailMan message:"
^DIC(9.4,60,22,13,"PAH",192,1,57,0)="Subj: NCPDP NUMBER POPULATION  [#164410] 08/30/05@21:55  10 lines"
^DIC(9.4,60,22,13,"PAH",192,1,58,0)="From: PATCH PSO*7*216  In 'IN' basket.   Page 1"
^DIC(9.4,60,22,13,"PAH",192,1,59,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",192,1,60,0)="-----"
^DIC(9.4,60,22,13,"PAH",192,1,61,0)="Patch PSO*7*216 - POPULATE NCPDP NUMBER FIELD POST-INSTALL"
^DIC(9.4,60,22,13,"PAH",192,1,62,0)="This message is being sent to the installer of the patch and holders of"
^DIC(9.4,60,22,13,"PAH",192,1,63,0)="the PSORPH key."
^DIC(9.4,60,22,13,"PAH",192,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,65,0)="Please validate that the NCPDP number is correct for each active DIVISION "
^DIC(9.4,60,22,13,"PAH",192,1,66,0)="and"
^DIC(9.4,60,22,13,"PAH",192,1,67,0)="SITE NUMBER. If missing or incorrect, enter the correct number using the"
^DIC(9.4,60,22,13,"PAH",192,1,68,0)="Site Parameter Enter/Edit option."
^DIC(9.4,60,22,13,"PAH",192,1,69,0)=" "
^DIC(9.4,60,22,13,"PAH",192,1,70,0)="DIVISION:  EXT  SITE NUMBER:  500  NCPDP NUMBER: 0000001"
^DIC(9.4,60,22,13,"PAH",192,1,71,0)="DIVISION: TROY  SITE NUMBER:  514  NCPDP NUMBER: NO NUMBER FOUND"
^DIC(9.4,60,22,13,"PAH",193,0)="220 SEQ #197^3051202^1"
^DIC(9.4,60,22,13,"PAH",193,1,0)="^^10^10^3051202"
^DIC(9.4,60,22,13,"PAH",193,1,1,0)="This patch adds the NCPDP (National Council for Prescription Drug "
^DIC(9.4,60,22,13,"PAH",193,1,2,0)="Programs) number from the OUTPATIENT SITE file (#59) to the Outpatient"
^DIC(9.4,60,22,13,"PAH",193,1,3,0)="Pharmacy VDEF (Vista Data Extraction Framework) message that sends"
^DIC(9.4,60,22,13,"PAH",193,1,4,0)="prescription information to the HDR (Health Data Repository). VistA must"
^DIC(9.4,60,22,13,"PAH",193,1,5,0)="collect and maintain this information and make this number readily "
^DIC(9.4,60,22,13,"PAH",193,1,6,0)="available for application interfaces to store and forward to meet "
^DIC(9.4,60,22,13,"PAH",193,1,7,0)="requirements for the CHDR (Clinical Data Repository / Health Data"
^DIC(9.4,60,22,13,"PAH",193,1,8,0)="Repository) project to provide this number to the DoD (Department of"
^DIC(9.4,60,22,13,"PAH",193,1,9,0)="Defense). This is a required field in the DoD PDTS (Pharmacy Data"
^DIC(9.4,60,22,13,"PAH",193,1,10,0)="Transaction Service) application."
^DIC(9.4,60,22,13,"PAH",194,0)="213 SEQ #198^3051202^1"
^DIC(9.4,60,22,13,"PAH",194,1,0)="^^25^25^3051202"
^DIC(9.4,60,22,13,"PAH",194,1,1,0)="This patch contains Application Program Interfaces (APIs) that will be "
^DIC(9.4,60,22,13,"PAH",194,1,2,0)="used by calling applications that currently do direct global reads or "
^DIC(9.4,60,22,13,"PAH",194,1,3,0)="writes to the Outpatient Pharmacy files.  Since the PRESCRIPTION file "
^DIC(9.4,60,22,13,"PAH",194,1,4,0)="(#52), PENDING OUTPATIENT ORDERS file (#52.41), RX SUSPENSE file (#52.5), "
^DIC(9.4,60,22,13,"PAH",194,1,5,0)="CLOZAPINE PRESCRIPTION OVERRIDES file (#52.52), TPB ELIGIBILITY file "
^DIC(9.4,60,22,13,"PAH",194,1,6,0)="(#52.91), RX PATIENT STATUS file (#53), and OUTPATIENT SITE file (#59) "
^DIC(9.4,60,22,13,"PAH",194,1,7,0)="are being replaced as part of the Pharmacy Re-engineering project, any "
^DIC(9.4,60,22,13,"PAH",194,1,8,0)="direct M-based global reads or writes to these files must be replaced by "
^DIC(9.4,60,22,13,"PAH",194,1,9,0)="calling the APIs provided in this patch. When the new data source is in "
^DIC(9.4,60,22,13,"PAH",194,1,10,0)="place, the calling applications will not be required to make any changes, "
^DIC(9.4,60,22,13,"PAH",194,1,11,0)="because these APIs will be flexible enough to retrieve the requested data "
^DIC(9.4,60,22,13,"PAH",194,1,12,0)="from the new data source, when the time comes."
^DIC(9.4,60,22,13,"PAH",194,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",194,1,14,0)="These are the files that are affected. If any application is making "
^DIC(9.4,60,22,13,"PAH",194,1,15,0)="direct global reads or writes to any of these files, they must be "
^DIC(9.4,60,22,13,"PAH",194,1,16,0)="replaced by using the APIs exported with this patch."
^DIC(9.4,60,22,13,"PAH",194,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",194,1,18,0)="File Name:                               File Number:"
^DIC(9.4,60,22,13,"PAH",194,1,19,0)="PRESCRIPTION                                 52"
^DIC(9.4,60,22,13,"PAH",194,1,20,0)="PENDING OUTPATIENT ORDERS                    52.41"
^DIC(9.4,60,22,13,"PAH",194,1,21,0)="RX SUSPENSE                                  52.5"
^DIC(9.4,60,22,13,"PAH",194,1,22,0)="CLOZAPINE PRESCRIPTION OVERRIDES             52.52"
^DIC(9.4,60,22,13,"PAH",194,1,23,0)="TPB ELIGIBILITY                              52.91"
^DIC(9.4,60,22,13,"PAH",194,1,24,0)="RX PATIENT STATUS                            53"
^DIC(9.4,60,22,13,"PAH",194,1,25,0)="OUTPATIENT SITE                              59"
^DIC(9.4,60,22,13,"PAH",195,0)="218 SEQ #199^3051221^1"
^DIC(9.4,60,22,13,"PAH",195,1,0)="^^3^3^3051221"
^DIC(9.4,60,22,13,"PAH",195,1,1,0)="Issue a warning message and do not allow a refill to be deleted when the "
^DIC(9.4,60,22,13,"PAH",195,1,2,0)="refill was sent to an external dispense machine is is still pending"
^DIC(9.4,60,22,13,"PAH",195,1,3,0)="release from that machine."
^DIC(9.4,60,22,13,"PAH",196,0)="207 SEQ #200^3060112^1"
^DIC(9.4,60,22,13,"PAH",196,1,0)="^^20^20^3060112"
^DIC(9.4,60,22,13,"PAH",196,1,1,0)="This patch adds the capability of doing order checking between local VA "
^DIC(9.4,60,22,13,"PAH",196,1,2,0)="facilities and remote VA or Department of Defense (DoD) facilities where "
^DIC(9.4,60,22,13,"PAH",196,1,3,0)="veterans have received prescriptions. This Remote Data Interoperability "
^DIC(9.4,60,22,13,"PAH",196,1,4,0)="(RDI) functionality includes receiving data from the Health Data"
^DIC(9.4,60,22,13,"PAH",196,1,5,0)="Repository (HDR) in order to perform the order checking against remote"
^DIC(9.4,60,22,13,"PAH",196,1,6,0)="data."
^DIC(9.4,60,22,13,"PAH",196,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",196,1,8,0)="After the release of this patch, a Computerized Patient Record System"
^DIC(9.4,60,22,13,"PAH",196,1,9,0)="(CPRS) patch will turn on a flag which enables the remote order checking"
^DIC(9.4,60,22,13,"PAH",196,1,10,0)="to occur. When turned on, the remote order checking includes checks for"
^DIC(9.4,60,22,13,"PAH",196,1,11,0)="duplicate drugs, duplicate drug classes, drug interactions, and drug"
^DIC(9.4,60,22,13,"PAH",196,1,12,0)="allergies."
^DIC(9.4,60,22,13,"PAH",196,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",196,1,14,0)="In addition to the new functionality, there are several help desk tickets"
^DIC(9.4,60,22,13,"PAH",196,1,15,0)="related to erroneous drug interactions with non-VA meds. The problem"
^DIC(9.4,60,22,13,"PAH",196,1,16,0)="and fix have been identified as a variable being carried over from prior "
^DIC(9.4,60,22,13,"PAH",196,1,17,0)="drug checks that should have been killed in between. Because the routine"
^DIC(9.4,60,22,13,"PAH",196,1,18,0)="that needs to be fixed is already being changed as part of the RDI"
^DIC(9.4,60,22,13,"PAH",196,1,19,0)="project, the change to kill the variable at the end of the interaction "
^DIC(9.4,60,22,13,"PAH",196,1,20,0)="checking will be included in this RDI patch."
^DIC(9.4,60,22,13,"PAH",197,0)="226 SEQ #201^3060112^1"
^DIC(9.4,60,22,13,"PAH",197,1,0)="^^113^113^3060112"
^DIC(9.4,60,22,13,"PAH",197,1,1,0)="This is the second follow up patch for Outpatient Pharmacy Clinical"
^DIC(9.4,60,22,13,"PAH",197,1,2,0)="Indicator Data Capture (CIDC) patch PSO*7*143.  The first follow-up patch"
^DIC(9.4,60,22,13,"PAH",197,1,3,0)="was PSO*7*219, and the follow-up patches were split into two patches in"
^DIC(9.4,60,22,13,"PAH",197,1,4,0)="order to quickly get the issues resolved by patch PSO*7*219 into the field"
^DIC(9.4,60,22,13,"PAH",197,1,5,0)="immediately."
^DIC(9.4,60,22,13,"PAH",197,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,7,0)="Functional Description:"
^DIC(9.4,60,22,13,"PAH",197,1,8,0)="======================="
^DIC(9.4,60,22,13,"PAH",197,1,9,0)="This patch PSO*7*226 corrects the following:"
^DIC(9.4,60,22,13,"PAH",197,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,11,0)="1.  For only edited prescriptions ordered prior to patch PSO*7*143 being "
^DIC(9.4,60,22,13,"PAH",197,1,12,0)="installed, the routine that passes information from Outpatient Pharmacy to"
^DIC(9.4,60,22,13,"PAH",197,1,13,0)="CPRS was passing an extra value and was not passing the Combat Veteran"
^DIC(9.4,60,22,13,"PAH",197,1,14,0)="indicator.  An edit to days supply, quantity, etc. on a prescription "
^DIC(9.4,60,22,13,"PAH",197,1,15,0)="results in a background transmission of data to CRPS.  This type of data"
^DIC(9.4,60,22,13,"PAH",197,1,16,0)="was passed and updated in CRPS correctly.  Because CPRS does not "
^DIC(9.4,60,22,13,"PAH",197,1,17,0)="currently update SC/EI's for edited prescriptions, there were no adverse"
^DIC(9.4,60,22,13,"PAH",197,1,18,0)="affects.  However, Outpatient Pharmacy sends all data for consistency, and"
^DIC(9.4,60,22,13,"PAH",197,1,19,0)="this was corrected.  There are no associated remedy tickets for this"
^DIC(9.4,60,22,13,"PAH",197,1,20,0)="change."
^DIC(9.4,60,22,13,"PAH",197,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,22,0)="2.  A dollar sign ($) was being displayed for exempt from copay"
^DIC(9.4,60,22,13,"PAH",197,1,23,0)="prescriptions, and it was being displayed up until the prescription was"
^DIC(9.4,60,22,13,"PAH",197,1,24,0)="released.  Also, 'COPAY' was being printed on the label for this type "
^DIC(9.4,60,22,13,"PAH",197,1,25,0)="of prescription."
^DIC(9.4,60,22,13,"PAH",197,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,27,0)="3.  Copays were erroneously being charged for non-service connected (NSC)"
^DIC(9.4,60,22,13,"PAH",197,1,28,0)="prescriptions fills that had an environmental indicator flagged as"
^DIC(9.4,60,22,13,"PAH",197,1,29,0)="""Yes"".   And, copays were charged for some service connected (SC) <50%"
^DIC(9.4,60,22,13,"PAH",197,1,30,0)="prescriptions, and this was due to a ""RX COPAY STATUS REVIEW NEEDED"""
^DIC(9.4,60,22,13,"PAH",197,1,31,0)="Mailman message being sent instead of prompting the user for the SC/EI"
^DIC(9.4,60,22,13,"PAH",197,1,32,0)="information.  Patch PSO*7*219 corrected this issue, but PSO*7*226 cancels"
^DIC(9.4,60,22,13,"PAH",197,1,33,0)="the erroneously billed copay(s) as well as restores the copay related"
^DIC(9.4,60,22,13,"PAH",197,1,34,0)="fields in PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",197,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,36,0)="When installing this patch, the 'copay correction' portion of this patch"
^DIC(9.4,60,22,13,"PAH",197,1,37,0)="is optional.  Each site can determine if they would be better suited to"
^DIC(9.4,60,22,13,"PAH",197,1,38,0)="run this automated process or correct them manually.  If you answer N (No)"
^DIC(9.4,60,22,13,"PAH",197,1,39,0)="to running the copay correction process and change your mind later, then"
^DIC(9.4,60,22,13,"PAH",197,1,40,0)="have your IRM run ^PSOCIDC1 from the programmers prompt.  Please keep in "
^DIC(9.4,60,22,13,"PAH",197,1,41,0)="mind that by not running the copay correction process that those"
^DIC(9.4,60,22,13,"PAH",197,1,42,0)="prescriptions where the IBQ node was not stored correctly will continue to"
^DIC(9.4,60,22,13,"PAH",197,1,43,0)="generate a copay until the fill is copied or renewed."
^DIC(9.4,60,22,13,"PAH",197,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,46,0)="Technical Description:"
^DIC(9.4,60,22,13,"PAH",197,1,47,0)="======================"
^DIC(9.4,60,22,13,"PAH",197,1,48,0)="The following correlates to each sequence in the Functional Description:"
^DIC(9.4,60,22,13,"PAH",197,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,50,0)="1.  In background processing, the PSOHLSN2 routine passes information from"
^DIC(9.4,60,22,13,"PAH",197,1,51,0)="Outpatient Pharmacy to CPRS when orders are created, edited, copied or"
^DIC(9.4,60,22,13,"PAH",197,1,52,0)="renewed from backdoor order entry.  Even though CPRS does not "
^DIC(9.4,60,22,13,"PAH",197,1,53,0)="currently update SC/EI information for edited prescriptions, Outpatient"
^DIC(9.4,60,22,13,"PAH",197,1,54,0)="Pharmacy passes them for consistency.  The code that handles pre-CIDC"
^DIC(9.4,60,22,13,"PAH",197,1,55,0)="edited prescriptions passed an extra value and did not pass the Combat"
^DIC(9.4,60,22,13,"PAH",197,1,56,0)="Veteran indicator.  Because CPRS does not update SC/EI's for edited"
^DIC(9.4,60,22,13,"PAH",197,1,57,0)="prescriptions, there were no adverse affects.  A change was made to pass"
^DIC(9.4,60,22,13,"PAH",197,1,58,0)="the Combat Veteran indicator and not pass the extra value."
^DIC(9.4,60,22,13,"PAH",197,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,60,0)="2.  Because a value denoting copay was allowed to remain in the COPAY "
^DIC(9.4,60,22,13,"PAH",197,1,61,0)="TRANSACTION TYPE field (#105) for exempt from copay prescriptions, the"
^DIC(9.4,60,22,13,"PAH",197,1,62,0)="$ sign was incorrectly being displayed and ""COPAY was being printed on "
^DIC(9.4,60,22,13,"PAH",197,1,63,0)="the prescription label.  Modifications were made to eliminate the display"
^DIC(9.4,60,22,13,"PAH",197,1,64,0)="of the $ sign for exempt from copay fills which in turn eliminates the"
^DIC(9.4,60,22,13,"PAH",197,1,65,0)="printing of 'COPAY' on the label.  Also, modifications were made to"
^DIC(9.4,60,22,13,"PAH",197,1,66,0)="eliminate this value for NSC and SC<50% prescriptions for all affected"
^DIC(9.4,60,22,13,"PAH",197,1,67,0)="fills finished between the installation date of patch PSO*7*143 until"
^DIC(9.4,60,22,13,"PAH",197,1,68,0)="present. This patch re-examines the PRESCRIPTION file (#52) for any NSC"
^DIC(9.4,60,22,13,"PAH",197,1,69,0)="and SC<50% prescription that has an ICD node and does not have an IBQ"
^DIC(9.4,60,22,13,"PAH",197,1,70,0)="node.  Using the SC/EI answers stored on the ICD node, the IBQ node is"
^DIC(9.4,60,22,13,"PAH",197,1,71,0)="defined and the COPAY TRANSACTION TYPE field (#105) is defined"
^DIC(9.4,60,22,13,"PAH",197,1,72,0)="appropriately."
^DIC(9.4,60,22,13,"PAH",197,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,74,0)="3.  For those prescriptions that were erroneously billed a copay from "
^DIC(9.4,60,22,13,"PAH",197,1,75,0)="the installation of PSO*7*143 until present, this patch evaluates any"
^DIC(9.4,60,22,13,"PAH",197,1,76,0)="prescription that was billed, that has an ICD node, but does not have an"
^DIC(9.4,60,22,13,"PAH",197,1,77,0)="IBQ node.  Using the SC/EI answers stored on the ICD node, the IBQ node is"
^DIC(9.4,60,22,13,"PAH",197,1,78,0)="defined.  Then, if a yes answer is defined for any SC or EI, IB is"
^DIC(9.4,60,22,13,"PAH",197,1,79,0)="notified to cancel copay for the fill."
^DIC(9.4,60,22,13,"PAH",197,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,81,0)="This patch prompts the user during installation when to run the copay"
^DIC(9.4,60,22,13,"PAH",197,1,82,0)="correction process.  The job name for this process is 'CANCEL COPAY'.  It"
^DIC(9.4,60,22,13,"PAH",197,1,83,0)="provides summary Mailman messages, and a detailed Results Report by"
^DIC(9.4,60,22,13,"PAH",197,1,84,0)="Veteran that can be run from Programmer mode.  Also, a Query Status of Job"
^DIC(9.4,60,22,13,"PAH",197,1,85,0)="function as well as a Stop Job Command function is provided.  See the"
^DIC(9.4,60,22,13,"PAH",197,1,86,0)="reports and samples section below for details and images of these"
^DIC(9.4,60,22,13,"PAH",197,1,87,0)="features."
^DIC(9.4,60,22,13,"PAH",197,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,89,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,90,0)="Reports Section:"
^DIC(9.4,60,22,13,"PAH",197,1,91,0)="================"
^DIC(9.4,60,22,13,"PAH",197,1,92,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,93,0)="* See the sample section below for images of these features."
^DIC(9.4,60,22,13,"PAH",197,1,94,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,95,0)="1.  The CANCEL COPAY process will produce a summary mail message of its "
^DIC(9.4,60,22,13,"PAH",197,1,96,0)="findings and display instructions on how to print a detailed report by "
^DIC(9.4,60,22,13,"PAH",197,1,97,0)="Veteran.  This MailMan message will be sent to all users that hold the "
^DIC(9.4,60,22,13,"PAH",197,1,98,0)="'PSO COPAY' security key and the installer of the patch.  This message "
^DIC(9.4,60,22,13,"PAH",197,1,99,0)="contains results by year and 30, 60, and 90 day fills for total "
^DIC(9.4,60,22,13,"PAH",197,1,100,0)="released, total un-released, and total cancelled copays."
^DIC(9.4,60,22,13,"PAH",197,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,102,0)="2.  A summary Mailman message will be sent to Management for their "
^DIC(9.4,60,22,13,"PAH",197,1,103,0)="review.  It can be cut and pasted into a .TXT file."
^DIC(9.4,60,22,13,"PAH",197,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,105,0)="3.  A detailed report by Veteran and fill number can be produced on "
^DIC(9.4,60,22,13,"PAH",197,1,106,0)="demand by entering D RPT^PSOCIDC3 at the programmers prompt. "
^DIC(9.4,60,22,13,"PAH",197,1,107,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,108,0)="4.  To check the status of the COPAY CANCEL background job while it is"
^DIC(9.4,60,22,13,"PAH",197,1,109,0)="running, then type from the direct programmers prompt the command "
^DIC(9.4,60,22,13,"PAH",197,1,110,0)="D STATUS^PSOCIDC1."
^DIC(9.4,60,22,13,"PAH",197,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",197,1,112,0)="5.  If you need to stop the COPAY CANCEL background job for any reason,"
^DIC(9.4,60,22,13,"PAH",197,1,113,0)="then from the direct programmers prompt, type the command D STOP^PSOCIDC1."
^DIC(9.4,60,22,13,"PAH",198,0)="227 SEQ #202^3060213^1"
^DIC(9.4,60,22,13,"PAH",198,1,0)="^^114^114^3060213"
^DIC(9.4,60,22,13,"PAH",198,1,1,0)="The Transitional Pharmacy Benefit (TPB) project that was providing"
^DIC(9.4,60,22,13,"PAH",198,1,2,0)="functionality to furnish medications prescribed by Non-VA Physicians"
^DIC(9.4,60,22,13,"PAH",198,1,3,0)="needs to be shut down as the period for its eligibility expired on"
^DIC(9.4,60,22,13,"PAH",198,1,4,0)="October 22, 2004.  Inactivation of the TPB functionality will be done in 2"
^DIC(9.4,60,22,13,"PAH",198,1,5,0)="steps, a manual step and a automatic step."
^DIC(9.4,60,22,13,"PAH",198,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,7,0)="Step I-To make sure that the Health Level Seven (HL7) data transmission"
^DIC(9.4,60,22,13,"PAH",198,1,8,0)="      of TPB eligible patients to the Austin Automation Center (AAC) is"
^DIC(9.4,60,22,13,"PAH",198,1,9,0)="      shutdown."
^DIC(9.4,60,22,13,"PAH",198,1,10,0)="Step II-The installation of this patch will automatically inactivate all"
^DIC(9.4,60,22,13,"PAH",198,1,11,0)="     the TPB functionality."
^DIC(9.4,60,22,13,"PAH",198,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,13,0)="***********************************************************************"
^DIC(9.4,60,22,13,"PAH",198,1,14,0)="***                    Step I - Manual Step                         ***"
^DIC(9.4,60,22,13,"PAH",198,1,15,0)="***********************************************************************"
^DIC(9.4,60,22,13,"PAH",198,1,16,0)="The data transmission of TPB eligible patient from the TPB ELIGIBILITY"
^DIC(9.4,60,22,13,"PAH",198,1,17,0)="file (#52.91) is performed by the PSOTPBACC HL7 logical link."
^DIC(9.4,60,22,13,"PAH",198,1,18,0)="By now most of the sites would have shut down this link. To check"
^DIC(9.4,60,22,13,"PAH",198,1,19,0)="whether this link is enabled or shutdown, do the following:"
^DIC(9.4,60,22,13,"PAH",198,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,21,0)="  a) Use the HL7 Main Menu [HL MAIN MENU] option and select the"
^DIC(9.4,60,22,13,"PAH",198,1,22,0)="     Systems Link Monitor [HL MESSAGE MONITOR] option, you should see the"
^DIC(9.4,60,22,13,"PAH",198,1,23,0)="     following screen:"
^DIC(9.4,60,22,13,"PAH",198,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,25,0)="                SYSTEM LINK MONITOR for BIRMINGHAM, AL. (Test System)"
^DIC(9.4,60,22,13,"PAH",198,1,26,0)="                MESSAGES  MESSAGES   MESSAGES  MESSAGES  DEVICE"
^DIC(9.4,60,22,13,"PAH",198,1,27,0)="     NODE       RECEIVED  PROCESSED  TO SEND   SENT      TYPE     STATE"
^DIC(9.4,60,22,13,"PAH",198,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,29,0)="     LL2VISN    51        51         85        51         NC      Open"
^DIC(9.4,60,22,13,"PAH",198,1,30,0)="     NPTF       0         0          163       0          N       Halting"
^DIC(9.4,60,22,13,"PAH",198,1,31,0)="     PSBCOTS1                        2397                         Shutdown"
^DIC(9.4,60,22,13,"PAH",198,1,32,0)="     PSD HLLP                        38                   N       Halting"
^DIC(9.4,60,22,13,"PAH",198,1,33,0)="     PSO DISP   1380      1380       10130     1380       NC      Openfail"
^DIC(9.4,60,22,13,"PAH",198,1,34,0)="     PSO LLP1                        238                  N       Halting"
^DIC(9.4,60,22,13,"PAH",198,1,35,0)="     PSOTPBAA                        28                           Enabled"
^DIC(9.4,60,22,13,"PAH",198,1,36,0)="     PSU SEND                        13"
^DIC(9.4,60,22,13,"PAH",198,1,37,0)="     TEST       21        21         21        21         SS      Idle"
^DIC(9.4,60,22,13,"PAH",198,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,39,0)="     Incoming filers running => Zero     TaskMan running"
^DIC(9.4,60,22,13,"PAH",198,1,40,0)="     Outgoing filers running => Zero     ***LINK MANAGER NOT RUNNING!!!***"
^DIC(9.4,60,22,13,"PAH",198,1,41,0)="                                             Monitor OVERDUE"
^DIC(9.4,60,22,13,"PAH",198,1,42,0)="    Select a Command:"
^DIC(9.4,60,22,13,"PAH",198,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,44,0)="  b) If the PSOTPBAAC logical link is enabled then you need to shut down"
^DIC(9.4,60,22,13,"PAH",198,1,45,0)="     the link by doing the following:"
^DIC(9.4,60,22,13,"PAH",198,1,46,0)="     - Use the HL7 Main Menu Option [HL MAIN]"
^DIC(9.4,60,22,13,"PAH",198,1,47,0)="     - Select the Filer and Link Management Options"
^DIC(9.4,60,22,13,"PAH",198,1,48,0)="        [HL MENU FILER LINK MGT]"
^DIC(9.4,60,22,13,"PAH",198,1,49,0)="     - Select the 'Start/Stop Links' option [HL START]"
^DIC(9.4,60,22,13,"PAH",198,1,50,0)="     - At the 'Select HL LOGICAL LINK NODE: ' prompt, type PSOTPBAAC and"
^DIC(9.4,60,22,13,"PAH",198,1,51,0)="       press enter. The system will prompt 'Okay to shut down this job?',"
^DIC(9.4,60,22,13,"PAH",198,1,52,0)="       answer 'YES' and press enter."
^DIC(9.4,60,22,13,"PAH",198,1,53,0)="       The system will display the following message:"
^DIC(9.4,60,22,13,"PAH",198,1,54,0)="       'The job for the PSOTPBAAC Lower Level Protocol will be shut down.'"
^DIC(9.4,60,22,13,"PAH",198,1,55,0)="     - To ensure the link is shut down use the Systems Link Monitor [HL"
^DIC(9.4,60,22,13,"PAH",198,1,56,0)="       MESSAGE MONITOR] option and make sure the status is 'Shutdown'"
^DIC(9.4,60,22,13,"PAH",198,1,57,0)="       (step a. above)."
^DIC(9.4,60,22,13,"PAH",198,1,58,0)="*************************************************************************"
^DIC(9.4,60,22,13,"PAH",198,1,59,0)="*** Step II - Automated Step                                          ***"
^DIC(9.4,60,22,13,"PAH",198,1,60,0)="*************************************************************************"
^DIC(9.4,60,22,13,"PAH",198,1,61,0)="1. This patch disables the following menu options by placing them to"
^DIC(9.4,60,22,13,"PAH",198,1,62,0)="   be out of order:"
^DIC(9.4,60,22,13,"PAH",198,1,63,0)="      - TPB HL7 Data Extract/Transmission [PSO TPB HL7 EXTRACT]"
^DIC(9.4,60,22,13,"PAH",198,1,64,0)="      - TPB Institution Letter Enter/Edit [PSO TPB INSTITUTION LETTERS]"
^DIC(9.4,60,22,13,"PAH",198,1,65,0)="      - Report TPB Patients Letters Printed/NOT Printed"
^DIC(9.4,60,22,13,"PAH",198,1,66,0)="         [PSO TPB LETTERS PRINTED REPORT]"
^DIC(9.4,60,22,13,"PAH",198,1,67,0)="      - Transitional Pharmacy Benefit Patient Enter/Edit"
^DIC(9.4,60,22,13,"PAH",198,1,68,0)="         [PSO TPB PATIENT ENTER/EDIT]"
^DIC(9.4,60,22,13,"PAH",198,1,69,0)="      - TPB Patient Report [PSO TPB PATIENT REPORT]"
^DIC(9.4,60,22,13,"PAH",198,1,70,0)="      - Report of Patients with TPB and Non-TPB Rx's"
^DIC(9.4,60,22,13,"PAH",198,1,71,0)="         [PSO TPB PATIENT RX REPORT]"
^DIC(9.4,60,22,13,"PAH",198,1,72,0)="      - Print TPB Patient Letter(s) [PSO TPB PRINT LETTERS]"
^DIC(9.4,60,22,13,"PAH",198,1,73,0)="      - TPB Rx (Prescription) Entry [PSO TPB RX ENTRY]"
^DIC(9.4,60,22,13,"PAH",198,1,74,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,75,0)="2. Inactivation of all active TPB patients"
^DIC(9.4,60,22,13,"PAH",198,1,76,0)="   This patch will scan all the entries in the TPB ELIGIBILITY file"
^DIC(9.4,60,22,13,"PAH",198,1,77,0)="   (#52.91) and will stuff the INACTIVATION OF BENEFIT DATE field (#2)"
^DIC(9.4,60,22,13,"PAH",198,1,78,0)="   of the active patients with today's date and the INACTIVATION REASON"
^DIC(9.4,60,22,13,"PAH",198,1,79,0)="   CODE field (#3) with the code ""10-PROGRAM ENDED""."
^DIC(9.4,60,22,13,"PAH",198,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,81,0)="3. When a prescription is discontinued, routine PSOTPCAN is called to"
^DIC(9.4,60,22,13,"PAH",198,1,82,0)="   check if that's the last active TPB prescription for an Active TPB"
^DIC(9.4,60,22,13,"PAH",198,1,83,0)="   patient, and if so, the patient TPB patient is inactivated from TPB"
^DIC(9.4,60,22,13,"PAH",198,1,84,0)="   ELIGIBILITY file (#52.91). Based on the fact that there will be no"
^DIC(9.4,60,22,13,"PAH",198,1,85,0)="   active TPB patient upon installing of this patch, routine PSOTPCAN is"
^DIC(9.4,60,22,13,"PAH",198,1,86,0)="   modified to quit without checking for last active TPB prescription."
^DIC(9.4,60,22,13,"PAH",198,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,88,0)="4. Prior to this patch, Outpatient Pharmacy software used to be notified"
^DIC(9.4,60,22,13,"PAH",198,1,89,0)="   by the Scheduling software every time a patient has an appointment at a"
^DIC(9.4,60,22,13,"PAH",198,1,90,0)="   VA clinic. If the patient is eligible for the TPB benefit, the"
^DIC(9.4,60,22,13,"PAH",198,1,91,0)="   appointment was at a clinic defined as primary care for the TPB program"
^DIC(9.4,60,22,13,"PAH",198,1,92,0)="   (determined through a set of clinic stop codes) AND the patient does"
^DIC(9.4,60,22,13,"PAH",198,1,93,0)="   not have any ""active"" TPB prescription(s) on file, this patient will"
^DIC(9.4,60,22,13,"PAH",198,1,94,0)="   have the TPB eligibility automatically inactivated (introduced by"
^DIC(9.4,60,22,13,"PAH",198,1,95,0)="   PSO*7*160). As all active TPB patient's will be inactivated (item #2"
^DIC(9.4,60,22,13,"PAH",198,1,96,0)="   above), there is no need for this functionality to continue. This patch"
^DIC(9.4,60,22,13,"PAH",198,1,97,0)="   will stop this functionality by removing the PSO TPB SD SUB protocol"
^DIC(9.4,60,22,13,"PAH",198,1,98,0)="   entry from the SDAM APPOINTMENT EVENTS Scheduling protocol."
^DIC(9.4,60,22,13,"PAH",198,1,99,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,100,0)="5. This patch will set the AUTOSTART field (#4.5) of the HL LOGICAL LINK"
^DIC(9.4,60,22,13,"PAH",198,1,101,0)="   file (#870) of the PSOTPBAAC Logical Link to ""Disabled"", to prevent"
^DIC(9.4,60,22,13,"PAH",198,1,102,0)="   restarting of the PSOTPBAAC logical link by TaskMan after a system"
^DIC(9.4,60,22,13,"PAH",198,1,103,0)="   reboot."
^DIC(9.4,60,22,13,"PAH",198,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,105,0)="6. The TPB data extraction job is queued to run daily and transmit"
^DIC(9.4,60,22,13,"PAH",198,1,106,0)="   data to the AAC every Sunday. This patch will remove the TPB HL7 Data"
^DIC(9.4,60,22,13,"PAH",198,1,107,0)="   Extract/Transmission [PSO TPB HL7 EXTRACT] option from the Task"
^DIC(9.4,60,22,13,"PAH",198,1,108,0)="   Manager."
^DIC(9.4,60,22,13,"PAH",198,1,109,0)=" "
^DIC(9.4,60,22,13,"PAH",198,1,110,0)="Note:"
^DIC(9.4,60,22,13,"PAH",198,1,111,0)="     - The post install routine (PSO227PO) included in this patch"
^DIC(9.4,60,22,13,"PAH",198,1,112,0)="       addresses all items in step II except #3."
^DIC(9.4,60,22,13,"PAH",198,1,113,0)="     - Most of the TPB routines that are transported in this patch are"
^DIC(9.4,60,22,13,"PAH",198,1,114,0)="       modified to ""QUIT"" if they are ever called by any other routine."
^DIC(9.4,60,22,13,"PAH",199,0)="229 SEQ #203^3060308^1"
^DIC(9.4,60,22,13,"PAH",199,1,0)="^^14^14^3060308"
^DIC(9.4,60,22,13,"PAH",199,1,1,0)="This is a follow-up patch to PHARMACY REENGINEERING ENCAPSULATION"
^DIC(9.4,60,22,13,"PAH",199,1,2,0)="CYCLE 2 APIS FOR OUTPATIENT PHARMACY patch (PSO*7*213)."
^DIC(9.4,60,22,13,"PAH",199,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",199,1,4,0)="The following changes are made in this path to the following application "
^DIC(9.4,60,22,13,"PAH",199,1,5,0)="program interfaces (APIs): "
^DIC(9.4,60,22,13,"PAH",199,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",199,1,7,0)="DBIA 4820 (PSO52API) is updated with newing of variable to prevent possible "
^DIC(9.4,60,22,13,"PAH",199,1,8,0)="undefinded errors.  "
^DIC(9.4,60,22,13,"PAH",199,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",199,1,10,0)="DBIA 4822 (PSO525AP) is updated to include omitted fields, Printed (#2) and "
^DIC(9.4,60,22,13,"PAH",199,1,11,0)="CMOP INDICATOR (#3) from the RX SUSPENSE file (#52.5).  "
^DIC(9.4,60,22,13,"PAH",199,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",199,1,13,0)="DBIA 4827 (PSO59) is updated to include omitted fields, SITE DEA NUMBER (#1)"
^DIC(9.4,60,22,13,"PAH",199,1,14,0)="and SITE (NATIONAL NAME) (#2) from the OUTPATIENT SITE file (#59)."
^DIC(9.4,60,22,13,"PAH",200,0)="230 SEQ #204^3060308^1"
^DIC(9.4,60,22,13,"PAH",200,1,0)="^^1^1^3060308"
^DIC(9.4,60,22,13,"PAH",200,1,1,0)="NO ASSESSMENT MADE FOR ALLERGY PRINTING."
^DIC(9.4,60,22,13,"PAH",201,0)="223 SEQ #207^3060410^1"
^DIC(9.4,60,22,13,"PAH",201,1,0)="^^1^1^3060410"
^DIC(9.4,60,22,13,"PAH",201,1,1,0)="INACCURATE OR NO DATA POPULATING THE CANCEL DATE FIELD"
^DIC(9.4,60,22,13,"PAH",202,0)="235 SEQ #208^3060410^1"
^DIC(9.4,60,22,13,"PAH",202,1,0)="^^16^16^3060410"
^DIC(9.4,60,22,13,"PAH",202,1,1,0)="This patch adds the proper escape sequences to the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",202,1,2,0)="VDEF (Vista Data Extraction Framework) message that sends prescription"
^DIC(9.4,60,22,13,"PAH",202,1,3,0)="information to the HDR (Health Data Repository). This will help avoid "
^DIC(9.4,60,22,13,"PAH",202,1,4,0)="errors that can occur when special delimiting characters are found in "
^DIC(9.4,60,22,13,"PAH",202,1,5,0)="Vista fields."
^DIC(9.4,60,22,13,"PAH",202,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",202,1,7,0)="This patch also makes modifications to the trigger events that send "
^DIC(9.4,60,22,13,"PAH",202,1,8,0)="prescription information to the HDR, using the VDEF. A problem was"
^DIC(9.4,60,22,13,"PAH",202,1,9,0)="reported where the Clinical ID information was not being sent in some"
^DIC(9.4,60,22,13,"PAH",202,1,10,0)="messages. This patch fixes that problem."
^DIC(9.4,60,22,13,"PAH",202,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",202,1,12,0)="A request has also been made add two new trigger events, those being when"
^DIC(9.4,60,22,13,"PAH",202,1,13,0)="the status of a prescription changes from Active to Suspended, and from"
^DIC(9.4,60,22,13,"PAH",202,1,14,0)="Suspended to Active. This patch add those trigger events."
^DIC(9.4,60,22,13,"PAH",202,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",202,1,16,0)="The name of the Institution has also been added to the message."
^DIC(9.4,60,22,13,"PAH",203,0)="242 SEQ #209^3060504^1"
^DIC(9.4,60,22,13,"PAH",203,1,0)="^^3^3^3060504"
^DIC(9.4,60,22,13,"PAH",203,1,1,0)="CORRECT THE OPTION PSO INTERNET REFILL, THE ""Q"" OPTION FROM SENDING"
^DIC(9.4,60,22,13,"PAH",203,1,2,0)="MULTIPLE RX #'S FROM DIFFERENT PATIENTS TO THE LABEL PRINT ROUTINES.  ALSO"
^DIC(9.4,60,22,13,"PAH",203,1,3,0)="CHANGE THE DEFAULT ""Q"" OPTION TO ""S"" FOR SUSPEND."
^DIC(9.4,60,22,13,"PAH",204,0)="214 SEQ #210^3060504^1"
^DIC(9.4,60,22,13,"PAH",204,1,0)="^^8^8^3060504"
^DIC(9.4,60,22,13,"PAH",204,1,1,0)="A site reported a problem with the Outpatient prescription status of "
^DIC(9.4,60,22,13,"PAH",204,1,2,0)="SUSPENDED. In some cases, it was being interpreted as being "
^DIC(9.4,60,22,13,"PAH",204,1,3,0)="non-refillable. A patient safety incident was entered regarding this "
^DIC(9.4,60,22,13,"PAH",204,1,4,0)="problem. The interim solution is to modify the Outpatient Pharmacy V. 7.0 "
^DIC(9.4,60,22,13,"PAH",204,1,5,0)="(OP) Applications Program Interface (API) that returns the prescription"
^DIC(9.4,60,22,13,"PAH",204,1,6,0)="status. Instead of returning SUSPENDED, the API will return ACTIVE/SUSP. "
^DIC(9.4,60,22,13,"PAH",204,1,7,0)="There will be no change to the display in the OP application."
^DIC(9.4,60,22,13,"PAH",204,1,8,0)="Remedy Ticket: HD67681"
^DIC(9.4,60,22,13,"PAH",205,0)="148^3060525^1"
^DIC(9.4,60,22,13,"PAH",205,1,0)="^^278^278^3060525"
^DIC(9.4,60,22,13,"PAH",205,1,1,0)="The National Council for Prescription Drug Programs (NCPDP) standard was"
^DIC(9.4,60,22,13,"PAH",205,1,2,0)="adopted under the Healthcare Insurance Portability and Accountability Act"
^DIC(9.4,60,22,13,"PAH",205,1,3,0)="(HIPAA) for pharmacy claims. The HIPAA NCPDP - GLOBAL project involves six"
^DIC(9.4,60,22,13,"PAH",205,1,4,0)="different applications that have been significantly changed to enable VA"
^DIC(9.4,60,22,13,"PAH",205,1,5,0)="Medical Centers to perform third party electronic billing for prescriptions"
^DIC(9.4,60,22,13,"PAH",205,1,6,0)="using the NCPDP standard. "
^DIC(9.4,60,22,13,"PAH",205,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,8,0)="Below is a list of all the applications involved in this project along with"
^DIC(9.4,60,22,13,"PAH",205,1,9,0)="their patch number:"
^DIC(9.4,60,22,13,"PAH",205,1,10,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,11,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,60,22,13,"PAH",205,1,12,0)="   -----------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",205,1,13,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*148"
^DIC(9.4,60,22,13,"PAH",205,1,14,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*276"
^DIC(9.4,60,22,13,"PAH",205,1,15,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*90"
^DIC(9.4,60,22,13,"PAH",205,1,16,0)="   CONSOLIDATED MAIL OUTPATIENT PHARMACY (CMOP) V. 2.0  PSX*2*48"
^DIC(9.4,60,22,13,"PAH",205,1,17,0)="   ACCOUNTS RECEIVABLE (AR) V. 4.5                      PRCA*4.5*230"
^DIC(9.4,60,22,13,"PAH",205,1,18,0)="   ELECTRONIC CLAIMS MANAGEMENT ENGINE (ECME) V. 1.0    BPS*1*1"
^DIC(9.4,60,22,13,"PAH",205,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,20,0)="Veterans Health Information Systems and Technology Architecture (VistA)"
^DIC(9.4,60,22,13,"PAH",205,1,21,0)="software applications and infrastructure were enhanced, in order to allow the"
^DIC(9.4,60,22,13,"PAH",205,1,22,0)="electronic transmission of outpatient pharmacy prescription claims (WINDOW"
^DIC(9.4,60,22,13,"PAH",205,1,23,0)="and MAIL fills) to third party payers via the network connections available"
^DIC(9.4,60,22,13,"PAH",205,1,24,0)="through the Austin Automation Center (AAC). VistA will be enhanced to receive"
^DIC(9.4,60,22,13,"PAH",205,1,25,0)="electronic adjudicated responses from the third party payers, which include"
^DIC(9.4,60,22,13,"PAH",205,1,26,0)="real-time processing for Drug Review Utilization and Refill Too Soon rejects."
^DIC(9.4,60,22,13,"PAH",205,1,27,0)="Reject information will be displayed to the pharmacist as the prescription is"
^DIC(9.4,60,22,13,"PAH",205,1,28,0)="being processed. The pharmacist will have the capability to take the"
^DIC(9.4,60,22,13,"PAH",205,1,29,0)="appropriate action to ensure patient safety or to override the reject and"
^DIC(9.4,60,22,13,"PAH",205,1,30,0)="resubmit the claim to the payer for payment. When a status of ""PAYABLE"" is"
^DIC(9.4,60,22,13,"PAH",205,1,31,0)="returned by the payer for a released prescription, VistA will automatically"
^DIC(9.4,60,22,13,"PAH",205,1,32,0)="create the bill in IB, authorize it and immediately create the receivable in"
^DIC(9.4,60,22,13,"PAH",205,1,33,0)="the AR application. Since the exact amount being paid by the payer is known,"
^DIC(9.4,60,22,13,"PAH",205,1,34,0)="a decrease adjustment will be automatically generated and applied so that the"
^DIC(9.4,60,22,13,"PAH",205,1,35,0)="receivable is equal to the net amount due from the payer."
^DIC(9.4,60,22,13,"PAH",205,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,37,0)="The system also provides electronic payment matching capability (for"
^DIC(9.4,60,22,13,"PAH",205,1,38,0)="electronically billable outpatient pharmacy prescriptions) using the existing"
^DIC(9.4,60,22,13,"PAH",205,1,39,0)="Electronic Data Interchange (EDI) Lockbox functionality which processes other"
^DIC(9.4,60,22,13,"PAH",205,1,40,0)="electronic payments from third party payers. This real-time electronic claims"
^DIC(9.4,60,22,13,"PAH",205,1,41,0)="processing capability will be provided in accordance with the HIPAA, EDI"
^DIC(9.4,60,22,13,"PAH",205,1,42,0)="and the NCPDP mandated format standards, specifically NCPDP Telecommunication"
^DIC(9.4,60,22,13,"PAH",205,1,43,0)="Standard V. 5.1. Additional functionality delivered with this project "
^DIC(9.4,60,22,13,"PAH",205,1,44,0)="includes:"
^DIC(9.4,60,22,13,"PAH",205,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,46,0)="   . Auto-Release/Outpatient Pharmacy Automation Interface (OPAI) Integration."
^DIC(9.4,60,22,13,"PAH",205,1,47,0)="   . Back-billing capability to allow electronic billing of claims from within"
^DIC(9.4,60,22,13,"PAH",205,1,48,0)="     the IB application."
^DIC(9.4,60,22,13,"PAH",205,1,49,0)="   . Capability to MOVE a group of subscribers from one insurance plan to"
^DIC(9.4,60,22,13,"PAH",205,1,50,0)="     another while automatically ""expiring"" the old plan, which is a major"
^DIC(9.4,60,22,13,"PAH",205,1,51,0)="     time saver."
^DIC(9.4,60,22,13,"PAH",205,1,52,0)="   . Pharmacy Dispensed As Written (DAW) prescription processing."
^DIC(9.4,60,22,13,"PAH",205,1,53,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,54,0)="Overview of the Process:"
^DIC(9.4,60,22,13,"PAH",205,1,55,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,56,0)="When a prescription is about to be filled and dispensed by the pharmacy, the"
^DIC(9.4,60,22,13,"PAH",205,1,57,0)="OP application submits the prescription to the new ECME application. ECME then"
^DIC(9.4,60,22,13,"PAH",205,1,58,0)="contacts IB to verify whether or not the prescription is electronically"
^DIC(9.4,60,22,13,"PAH",205,1,59,0)="billable. If so, ECME gathers the information necessary to generate a NCPDP"
^DIC(9.4,60,22,13,"PAH",205,1,60,0)="claim. The claim information is passed to the VistA Health Level Seven (HL7)"
^DIC(9.4,60,22,13,"PAH",205,1,61,0)="package. The HL7 package then sends the billing information to the AAC, where"
^DIC(9.4,60,22,13,"PAH",205,1,62,0)="it is routed to the corresponding third party insurance via Emdeon (formerly"
^DIC(9.4,60,22,13,"PAH",205,1,63,0)="WebMD)."
^DIC(9.4,60,22,13,"PAH",205,1,64,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,65,0)="Once the payer processes the information, the response coming back from the"
^DIC(9.4,60,22,13,"PAH",205,1,66,0)="payer is passed back to the site that made the request, and the information"
^DIC(9.4,60,22,13,"PAH",205,1,67,0)="is stored in the ECME package. If the third party payer accepted the claim,"
^DIC(9.4,60,22,13,"PAH",205,1,68,0)="the adjudicated information is passed along to IB. If the claim was rejected"
^DIC(9.4,60,22,13,"PAH",205,1,69,0)="the problem can be worked on and a new claim can be submitted to the payer."
^DIC(9.4,60,22,13,"PAH",205,1,70,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,71,0)="For electronically billable CMOP prescription processing, the third party"
^DIC(9.4,60,22,13,"PAH",205,1,72,0)="claim is sent before the prescription information is transmitted to the"
^DIC(9.4,60,22,13,"PAH",205,1,73,0)="CMOP facility to be filled. Once the adjudicating response is electronically"
^DIC(9.4,60,22,13,"PAH",205,1,74,0)="received from the third party payer, if there are no Drug Utilization Review"
^DIC(9.4,60,22,13,"PAH",205,1,75,0)="or Refill Too Soon rejects, the prescription is then transmitted to the CMOP"
^DIC(9.4,60,22,13,"PAH",205,1,76,0)="facility. When the CMOP center sends the dispensing information back to VistA,"
^DIC(9.4,60,22,13,"PAH",205,1,77,0)="the National Drug Code (NDC) information is checked against the NDC sent to"
^DIC(9.4,60,22,13,"PAH",205,1,78,0)="the third party payer and, if different, a new claim is generated in the"
^DIC(9.4,60,22,13,"PAH",205,1,79,0)="background and is sent to the third party payer. In case the CMOP facility"
^DIC(9.4,60,22,13,"PAH",205,1,80,0)="indicates that it is unable to fill a ""PAYABLE"" prescription fill, a reversal"
^DIC(9.4,60,22,13,"PAH",205,1,81,0)="is automatically submitted to the third party payer for the corresponding"
^DIC(9.4,60,22,13,"PAH",205,1,82,0)="fill."
^DIC(9.4,60,22,13,"PAH",205,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,84,0)="This patch modifies the OP application to perform real-time electronic claim"
^DIC(9.4,60,22,13,"PAH",205,1,85,0)="submission to third party payers. It will also enable OP users to see and act"
^DIC(9.4,60,22,13,"PAH",205,1,86,0)="on third party payer rejects such as Drug Utilization Review (DUR) and Refill"
^DIC(9.4,60,22,13,"PAH",205,1,87,0)="Too Soon rejects along with their daily normal prescription processing "
^DIC(9.4,60,22,13,"PAH",205,1,88,0)="activities. The following areas of OP have been changed:"
^DIC(9.4,60,22,13,"PAH",205,1,89,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,90,0)="1.  Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option "
^DIC(9.4,60,22,13,"PAH",205,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,92,0)="    At the point that the prescription is verified, the New Order, Edit,"
^DIC(9.4,60,22,13,"PAH",205,1,93,0)="    Renew, Refill, and Pull Early from Suspense functions will begin the"
^DIC(9.4,60,22,13,"PAH",205,1,94,0)="    third party billing evaluations. If IB determines that the"
^DIC(9.4,60,22,13,"PAH",205,1,95,0)="    prescription is third party billable, a message will be displayed on"
^DIC(9.4,60,22,13,"PAH",205,1,96,0)="    the user's screen stating that the claim is being submitted to ECME"
^DIC(9.4,60,22,13,"PAH",205,1,97,0)="    and it will also show the progress of the claim. If the payer rejects"
^DIC(9.4,60,22,13,"PAH",205,1,98,0)="    the claim for DUR or Refill Too Soon, the payer's information will be"
^DIC(9.4,60,22,13,"PAH",205,1,99,0)="    displayed, and the user will be given the opportunity to either ignore"
^DIC(9.4,60,22,13,"PAH",205,1,100,0)="    the payer's response and move on with the filling process; override"
^DIC(9.4,60,22,13,"PAH",205,1,101,0)="    the reject by resubmitting the claim or postpone the processing of the"
^DIC(9.4,60,22,13,"PAH",205,1,102,0)="    prescription by taking no action when the reject is received. For"
^DIC(9.4,60,22,13,"PAH",205,1,103,0)="    prescriptions that have been electronically submitted to the third"
^DIC(9.4,60,22,13,"PAH",205,1,104,0)="    party payer, an indicator is displayed on the Patient Prescription"
^DIC(9.4,60,22,13,"PAH",205,1,105,0)="    Processing screen. This indicator will take the form of ""e"" next to"
^DIC(9.4,60,22,13,"PAH",205,1,106,0)="    the prescription number (e.g.,""2090303$e"").  "
^DIC(9.4,60,22,13,"PAH",205,1,107,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,108,0)="    A new section called REFILL TOO SOON/DUR REJECTS (Third Party) has"
^DIC(9.4,60,22,13,"PAH",205,1,109,0)="    been created in the Medication Profile screen to single out"
^DIC(9.4,60,22,13,"PAH",205,1,110,0)="    prescription that had an electronic claim rejected by third party"
^DIC(9.4,60,22,13,"PAH",205,1,111,0)="    payers for REFILL TOO SOON or DUR reasons. Prescriptions under this"
^DIC(9.4,60,22,13,"PAH",205,1,112,0)="    section have certain restrictions. Basically, they cannot be renewed,"
^DIC(9.4,60,22,13,"PAH",205,1,113,0)="    refilled, reprinted, copied or released until the REJECT is resolved."
^DIC(9.4,60,22,13,"PAH",205,1,114,0)="    When an individual prescription is selected, the user will have a new"
^DIC(9.4,60,22,13,"PAH",205,1,115,0)="    hidden option called REJ - View Reject, which will allow them to"
^DIC(9.4,60,22,13,"PAH",205,1,116,0)="    resolve the REJECT and remove it from the REFILL TOO SOON/DUR REJECTS"
^DIC(9.4,60,22,13,"PAH",205,1,117,0)="    (Third Party) section."
^DIC(9.4,60,22,13,"PAH",205,1,118,0)="   "
^DIC(9.4,60,22,13,"PAH",205,1,119,0)="    The prescription release option was modified to perform NDC (National"
^DIC(9.4,60,22,13,"PAH",205,1,120,0)="    Drug Code) validation for electronically billable prescriptions. When"
^DIC(9.4,60,22,13,"PAH",205,1,121,0)="    the user selects a new NDC a new claim is submitted to the payer"
^DIC(9.4,60,22,13,"PAH",205,1,122,0)="    before the prescription is released."
^DIC(9.4,60,22,13,"PAH",205,1,123,0)="   "
^DIC(9.4,60,22,13,"PAH",205,1,124,0)="    In the OP Medications screen, a new DAW CODE field (#81) of the "
^DIC(9.4,60,22,13,"PAH",205,1,125,0)="    PRESCRIPTION file (#52) was created for electronically billable"
^DIC(9.4,60,22,13,"PAH",205,1,126,0)="    prescriptions and can be edited by selecting '21' at the 'Select"
^DIC(9.4,60,22,13,"PAH",205,1,127,0)="    Action' prompt. For non-electronically billable prescriptions this"
^DIC(9.4,60,22,13,"PAH",205,1,128,0)="    field is not displayed at all."
^DIC(9.4,60,22,13,"PAH",205,1,129,0)="    "
^DIC(9.4,60,22,13,"PAH",205,1,130,0)="    When the electronically billable prescription is released, this option"
^DIC(9.4,60,22,13,"PAH",205,1,131,0)="    will allow the user to edit the NDC code for the prescription. In the"
^DIC(9.4,60,22,13,"PAH",205,1,132,0)="    OP Medications screen the NDC field is listed under the Drug field"
^DIC(9.4,60,22,13,"PAH",205,1,133,0)="    and can be edited by selecting '2' to edit the drug at the 'Select"
^DIC(9.4,60,22,13,"PAH",205,1,134,0)="    Action' prompt. For sites that do not allow Drug editing, the option"
^DIC(9.4,60,22,13,"PAH",205,1,135,0)="    '2' will allow editing of the NDC only."
^DIC(9.4,60,22,13,"PAH",205,1,136,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,137,0)="2.  Return Medication to Stock [PSO RETURNED STOCK] option "
^DIC(9.4,60,22,13,"PAH",205,1,138,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,139,0)="    The Return Medication to Stock function was modified to notify the"
^DIC(9.4,60,22,13,"PAH",205,1,140,0)="    third party payer that a previously billed prescription was not"
^DIC(9.4,60,22,13,"PAH",205,1,141,0)="    actually filled. If the prescription was previously billed to a third"
^DIC(9.4,60,22,13,"PAH",205,1,142,0)="    party payer and a payable response was received, the claim will be"
^DIC(9.4,60,22,13,"PAH",205,1,143,0)="    reversed, and the pharmacy user will see messaging stating that the"
^DIC(9.4,60,22,13,"PAH",205,1,144,0)="    third party claim was submitted for reversal. If a claim for the"
^DIC(9.4,60,22,13,"PAH",205,1,145,0)="    prescription was previously rejected by the third party payer, the"
^DIC(9.4,60,22,13,"PAH",205,1,146,0)="    user will see a message indicating that no reversal was required. If"
^DIC(9.4,60,22,13,"PAH",205,1,147,0)="    the prescription was not previously billed to a third party payer, no"
^DIC(9.4,60,22,13,"PAH",205,1,148,0)="    message regarding electronic billing will be displayed."
^DIC(9.4,60,22,13,"PAH",205,1,149,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,150,0)="3.  Delete a Prescription [PSO RXDL] option "
^DIC(9.4,60,22,13,"PAH",205,1,151,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,152,0)="    The message for Delete a Prescription was modified to perform in the "
^DIC(9.4,60,22,13,"PAH",205,1,153,0)="    same manner as the Return Medication to Stock function described"
^DIC(9.4,60,22,13,"PAH",205,1,154,0)="    above."
^DIC(9.4,60,22,13,"PAH",205,1,155,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,156,0)="4.  Pull Early from Suspense [PSO PNDRX] option "
^DIC(9.4,60,22,13,"PAH",205,1,157,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,158,0)="    The Pull Early from Suspense function was modified to submit a third "
^DIC(9.4,60,22,13,"PAH",205,1,159,0)="    party claim for the prescription. A message will display to notify the"
^DIC(9.4,60,22,13,"PAH",205,1,160,0)="    user of the status of the claim as it is going through the submission "
^DIC(9.4,60,22,13,"PAH",205,1,161,0)="    process.  "
^DIC(9.4,60,22,13,"PAH",205,1,162,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,163,0)="5.  Print from Suspense File [PSO PNDLBL] option "
^DIC(9.4,60,22,13,"PAH",205,1,164,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,165,0)="    This option was modified to submit third party claims in the same"
^DIC(9.4,60,22,13,"PAH",205,1,166,0)="    manner as stated above except the Print from Suspense File function"
^DIC(9.4,60,22,13,"PAH",205,1,167,0)="    will be performed in the background. No user interaction will occur."
^DIC(9.4,60,22,13,"PAH",205,1,168,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,169,0)="6.  ePharmacy Menu [PSO EPHARMACY MENU] menu"
^DIC(9.4,60,22,13,"PAH",205,1,170,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,171,0)="    This new menu was created for electronic billing related options. It"
^DIC(9.4,60,22,13,"PAH",205,1,172,0)="    is being placed under the Rx (Prescriptions) [PSO RX] menu. Two new"
^DIC(9.4,60,22,13,"PAH",205,1,173,0)="    options are being added under this new menu:"
^DIC(9.4,60,22,13,"PAH",205,1,174,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,175,0)="    6.1 Third Party Payer Rejects - Worklist [PSO REJECTS WORKLIST] option"
^DIC(9.4,60,22,13,"PAH",205,1,176,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,177,0)="        This option is used to process third party payer rejects that have"
^DIC(9.4,60,22,13,"PAH",205,1,178,0)="        clinical significance. For now, only DUR (Drug Utilization Review)"
^DIC(9.4,60,22,13,"PAH",205,1,179,0)="        and REFILL TOO SOON rejects are being considered as having"
^DIC(9.4,60,22,13,"PAH",205,1,180,0)="        clinical significance."
^DIC(9.4,60,22,13,"PAH",205,1,181,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,182,0)="    6.2 Third Party Payer Rejects - View/Process [PSO REJECTS "
^DIC(9.4,60,22,13,"PAH",205,1,183,0)="        VIEW/PROCESS] option"
^DIC(9.4,60,22,13,"PAH",205,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,185,0)="        This option performs the same functionality as the option above."
^DIC(9.4,60,22,13,"PAH",205,1,186,0)="        However, the user has more filtering capabilities through this"
^DIC(9.4,60,22,13,"PAH",205,1,187,0)="        option. In addition, closed/resolved rejects can only be viewed by"
^DIC(9.4,60,22,13,"PAH",205,1,188,0)="        using this option."
^DIC(9.4,60,22,13,"PAH",205,1,189,0)="          "
^DIC(9.4,60,22,13,"PAH",205,1,190,0)="7.  Release Medication [PSO RELEASE] option "
^DIC(9.4,60,22,13,"PAH",205,1,191,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,192,0)="    The prescription release process was modified to perform NDC (National"
^DIC(9.4,60,22,13,"PAH",205,1,193,0)="    Drug Code) validation for electronically billable prescriptions. When"
^DIC(9.4,60,22,13,"PAH",205,1,194,0)="    the user selects a new NDC, a new claim is submitted to the payer"
^DIC(9.4,60,22,13,"PAH",205,1,195,0)="    before the prescription is released. Besides this option, the "
^DIC(9.4,60,22,13,"PAH",205,1,196,0)="    prescription can be released from the Medication Profile screen and"
^DIC(9.4,60,22,13,"PAH",205,1,197,0)="    from the Outpatient Rx's [PSD OUTPATIENT] option in the Controlled"
^DIC(9.4,60,22,13,"PAH",205,1,198,0)="    Substances application."
^DIC(9.4,60,22,13,"PAH",205,1,199,0)="   "
^DIC(9.4,60,22,13,"PAH",205,1,200,0)="8.  View Prescriptions [PSO VIEW] option"
^DIC(9.4,60,22,13,"PAH",205,1,201,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,202,0)="    This option was changed to include two new sections: ECME Log and ECME"
^DIC(9.4,60,22,13,"PAH",205,1,203,0)="    REJECT Log. Information about third party payer submission and rejects"
^DIC(9.4,60,22,13,"PAH",205,1,204,0)="    will be displayed under these sections."
^DIC(9.4,60,22,13,"PAH",205,1,205,0)="    "
^DIC(9.4,60,22,13,"PAH",205,1,206,0)="9.  Edit Prescriptions [PSO RXEDIT] option"
^DIC(9.4,60,22,13,"PAH",205,1,207,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,208,0)="    The new DAW CODE field (#81) of the PRESCRIPTION file (#52) was"
^DIC(9.4,60,22,13,"PAH",205,1,209,0)="    created for electronically billable prescriptions and can be edited"
^DIC(9.4,60,22,13,"PAH",205,1,210,0)="    through this option. For non-electronically billable prescriptions,"
^DIC(9.4,60,22,13,"PAH",205,1,211,0)="    the field is not displayed at all."
^DIC(9.4,60,22,13,"PAH",205,1,212,0)="    "
^DIC(9.4,60,22,13,"PAH",205,1,213,0)="    Once an electronically billable prescription is released, this option"
^DIC(9.4,60,22,13,"PAH",205,1,214,0)="    will allow the user to edit the NDC code. The NDC code is displayed on"
^DIC(9.4,60,22,13,"PAH",205,1,215,0)="    the screen just below the Drug field, and can be edited by selecting"
^DIC(9.4,60,22,13,"PAH",205,1,216,0)="    field '2' to edit the Drug. For sites that do not allow Drug editing,"
^DIC(9.4,60,22,13,"PAH",205,1,217,0)="    the field '2' can be used to edit the NDC code only."
^DIC(9.4,60,22,13,"PAH",205,1,218,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,219,0)="10. The NDC field (#4) under the CMOP EVENT multiple (#52.01) of the"
^DIC(9.4,60,22,13,"PAH",205,1,220,0)="    PRESCRIPTION file (#52) has been renamed to NDC RECEIVED. This field"
^DIC(9.4,60,22,13,"PAH",205,1,221,0)="    holds the NDC that was received from the CMOP facility with the"
^DIC(9.4,60,22,13,"PAH",205,1,222,0)="    dispensing message. The renaming was necessary due to the addition of "
^DIC(9.4,60,22,13,"PAH",205,1,223,0)="    the NDC SENT field (#12) under the same multiple that is being created"
^DIC(9.4,60,22,13,"PAH",205,1,224,0)="    by this project (see below item 11)."
^DIC(9.4,60,22,13,"PAH",205,1,225,0)="  "
^DIC(9.4,60,22,13,"PAH",205,1,226,0)="11. A new NDC SENT field (#12) is being created under the CMOP EVENT "
^DIC(9.4,60,22,13,"PAH",205,1,227,0)="    multiple (#52.01) of the PRESCRIPTION file (#52), to store the NDC"
^DIC(9.4,60,22,13,"PAH",205,1,228,0)="    that was transmission to CMOP. This field is used for electronic "
^DIC(9.4,60,22,13,"PAH",205,1,229,0)="    billing purposes to analyze the difference between the NDC sent to"
^DIC(9.4,60,22,13,"PAH",205,1,230,0)="    CMOP and the actual dispensed NDC by the CMOP facility."
^DIC(9.4,60,22,13,"PAH",205,1,231,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,232,0)="12. A new DAW CODE field (#81) is being created on the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",205,1,233,0)="    file (#52) and also under the REFILL multiple (#52.1) of the"
^DIC(9.4,60,22,13,"PAH",205,1,234,0)="    PRESCRIPTION file (#52). This field contains the NCPDP DAW used in the"
^DIC(9.4,60,22,13,"PAH",205,1,235,0)="    electronic claims submission to third party payers (insurance"
^DIC(9.4,60,22,13,"PAH",205,1,236,0)="    companies)."
^DIC(9.4,60,22,13,"PAH",205,1,237,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,238,0)="13. A new RE-TRANSMIT FLAG field (#82) is being created on the "
^DIC(9.4,60,22,13,"PAH",205,1,239,0)="    PRESCRIPTION file (#52) and also under the REFILL multiple (#52.1) of "
^DIC(9.4,60,22,13,"PAH",205,1,240,0)="    the PRESCRIPTION file (#52). This field is used to indicate that a"
^DIC(9.4,60,22,13,"PAH",205,1,241,0)="    claim should be electronically re-transmitted to the 3rd party payer"
^DIC(9.4,60,22,13,"PAH",205,1,242,0)="    (insurance company). It will be primarily used by CMOP and local mail"
^DIC(9.4,60,22,13,"PAH",205,1,243,0)="    prescriptions."
^DIC(9.4,60,22,13,"PAH",205,1,244,0)="   "
^DIC(9.4,60,22,13,"PAH",205,1,245,0)="14. A new multiple REJECT INFO field (#52.25) has been created on the"
^DIC(9.4,60,22,13,"PAH",205,1,246,0)="    PRESCRIPTION file (#52) to store information about DUR and Refill Too"
^DIC(9.4,60,22,13,"PAH",205,1,247,0)="    Soon Rejects returned by 3rd party payers. "
^DIC(9.4,60,22,13,"PAH",205,1,248,0)="    The following fields are part of this multiple:"
^DIC(9.4,60,22,13,"PAH",205,1,249,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,250,0)="        .01   NCPDP REJECT CODE      "
^DIC(9.4,60,22,13,"PAH",205,1,251,0)="          1   DATE/TIME DETECTED     "
^DIC(9.4,60,22,13,"PAH",205,1,252,0)="          2   PAYER MESSAGE          "
^DIC(9.4,60,22,13,"PAH",205,1,253,0)="          3   REASON                 "
^DIC(9.4,60,22,13,"PAH",205,1,254,0)="          4   PHARMACIST             "
^DIC(9.4,60,22,13,"PAH",205,1,255,0)="          5   FILL NUMBER            "
^DIC(9.4,60,22,13,"PAH",205,1,256,0)="          6   GROUP NAME             "
^DIC(9.4,60,22,13,"PAH",205,1,257,0)="          7   PLAN CONTACT           "
^DIC(9.4,60,22,13,"PAH",205,1,258,0)="          8   PLAN PREVIOUS FILL DATE"
^DIC(9.4,60,22,13,"PAH",205,1,259,0)="          9   STATUS   "
^DIC(9.4,60,22,13,"PAH",205,1,260,0)="         10   CLOSED DATE/TIME "
^DIC(9.4,60,22,13,"PAH",205,1,261,0)="         11   CLOSED BY"
^DIC(9.4,60,22,13,"PAH",205,1,262,0)="         12   CLOSE REASON"
^DIC(9.4,60,22,13,"PAH",205,1,263,0)="         13   CLOSE COMMENTS"
^DIC(9.4,60,22,13,"PAH",205,1,264,0)="         14   REASON FOR SERVICE CODE"
^DIC(9.4,60,22,13,"PAH",205,1,265,0)="         15   PROFESSIONAL SERVICE CODE"
^DIC(9.4,60,22,13,"PAH",205,1,266,0)="         16   RESPONSE ID"
^DIC(9.4,60,22,13,"PAH",205,1,267,0)="         17   OTHER REJECTS     "
^DIC(9.4,60,22,13,"PAH",205,1,268,0)="         18   DUR TEXT          "
^DIC(9.4,60,22,13,"PAH",205,1,269,0)="         19   RESULT OF SERVICE CODE"
^DIC(9.4,60,22,13,"PAH",205,1,270,0)="         20   INSURANCE NAME    "
^DIC(9.4,60,22,13,"PAH",205,1,271,0)="         21   GROUP NUMBER      "
^DIC(9.4,60,22,13,"PAH",205,1,272,0)="         22   CARDHOLDER ID "
^DIC(9.4,60,22,13,"PAH",205,1,273,0)="         23   RE-OPENED"
^DIC(9.4,60,22,13,"PAH",205,1,274,0)=" "
^DIC(9.4,60,22,13,"PAH",205,1,275,0)="    Two new cross-references named ""REJDAT"" and ""REJSTS"" were created for"
^DIC(9.4,60,22,13,"PAH",205,1,276,0)="    this multiple in the PRESCRIPTION file (#52). The ""REJDAT"" uses the"
^DIC(9.4,60,22,13,"PAH",205,1,277,0)="    DATE/TIME DETECTED field (#1) and the ""REJSTS"" uses the STATUS field"
^DIC(9.4,60,22,13,"PAH",205,1,278,0)="    (#9)."
^DIC(9.4,60,22,13,"PAH",206,0)="149 SEQ #212^3060711^1"
^DIC(9.4,60,22,13,"PAH",206,1,0)="^^114^114^3060711"
^DIC(9.4,60,22,13,"PAH",206,1,1,0)="The Registration application has released enhancements designed to"
^DIC(9.4,60,22,13,"PAH",206,1,2,0)="provide a more accurate and cleaner update of the patient address. One"
^DIC(9.4,60,22,13,"PAH",206,1,3,0)="of the things included in the enhancements is the automatic population"
^DIC(9.4,60,22,13,"PAH",206,1,4,0)="of city, state, and county based on entry of a zip code. For more"
^DIC(9.4,60,22,13,"PAH",206,1,5,0)="detailed information about this and the other enhancements recently "
^DIC(9.4,60,22,13,"PAH",206,1,6,0)="released by the Registration application, please refer to the patch "
^DIC(9.4,60,22,13,"PAH",206,1,7,0)="description of DG*5.3*522."
^DIC(9.4,60,22,13,"PAH",206,1,8,0)="  "
^DIC(9.4,60,22,13,"PAH",206,1,9,0)="This patch is responsible for updating Outpatient Pharmacy with the new"
^DIC(9.4,60,22,13,"PAH",206,1,10,0)="functionality made available by the Registration application. More"
^DIC(9.4,60,22,13,"PAH",206,1,11,0)="specifically, the update of the patient permanent address through the"
^DIC(9.4,60,22,13,"PAH",206,1,12,0)="Outpatient Pharmacy application will be enhanced with the new "
^DIC(9.4,60,22,13,"PAH",206,1,13,0)="functionality that was recently released by the Registration application"
^DIC(9.4,60,22,13,"PAH",206,1,14,0)="with the patch DG*5.3*522."
^DIC(9.4,60,22,13,"PAH",206,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,16,0)="For sites that have patch IVM*2*108 installed, the address history will"
^DIC(9.4,60,22,13,"PAH",206,1,17,0)="captured in the IVM ADDRESS UPDATE LOG File (#301.7)."
^DIC(9.4,60,22,13,"PAH",206,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,19,0)="Two places in the Outpatient Pharmacy application will be affected by"
^DIC(9.4,60,22,13,"PAH",206,1,20,0)="this change:"
^DIC(9.4,60,22,13,"PAH",206,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,22,0)=" 1) Menu option: Update Patient Record    [PSO PAT]"
^DIC(9.4,60,22,13,"PAH",206,1,23,0)=" 2) Patient Information screen, option PU - Patient Record Update"
^DIC(9.4,60,22,13,"PAH",206,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,25,0)=" Note: The Patient Information screen can be reached through the menu "
^DIC(9.4,60,22,13,"PAH",206,1,26,0)="       options Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",206,1,27,0)="       and Complete Orders from OERR [PSO LMOE FINISH]."
^DIC(9.4,60,22,13,"PAH",206,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,29,0)="The examples below show how the patient permanent address edit was before"
^DIC(9.4,60,22,13,"PAH",206,1,30,0)="and how it is going to be changed after this patch is installed:"
^DIC(9.4,60,22,13,"PAH",206,1,31,0)="  "
^DIC(9.4,60,22,13,"PAH",206,1,32,0)="    BEFORE THIS PATCH:"
^DIC(9.4,60,22,13,"PAH",206,1,33,0)="    ================="
^DIC(9.4,60,22,13,"PAH",206,1,34,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,35,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,36,0)="    STREET ADDRESS [LINE 1]: 123 FAKE ST <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,37,0)="    STREET ADDRESS [LINE 2]: <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,38,0)="    STREET ADDRESS [LINE 3]: <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,39,0)="    CITY: PLANO <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,40,0)="    STATE: TEXAS <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,41,0)="    ZIP+4: 75024 <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,42,0)="    COUNTY: COLLIN <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,43,0)="         1   COLLIN       085"
^DIC(9.4,60,22,13,"PAH",206,1,44,0)="         2   COLLINGSWORTH       087"
^DIC(9.4,60,22,13,"PAH",206,1,45,0)="    CHOOSE 1-2: 1 <RET>  COLLIN     085"
^DIC(9.4,60,22,13,"PAH",206,1,46,0)="    PHONE NUMBER [RESIDENCE]: 972-555-1234 <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,47,0)="    CNH CURRENT:"
^DIC(9.4,60,22,13,"PAH",206,1,48,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,49,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,51,0)="    AFTER THIS PATCH:"
^DIC(9.4,60,22,13,"PAH",206,1,52,0)="    ================"
^DIC(9.4,60,22,13,"PAH",206,1,53,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,54,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,55,0)="    Do you want to update the Permanent address/phone? NO// YES"
^DIC(9.4,60,22,13,"PAH",206,1,56,0)="    STREET ADDRESS [LINE 1]: 123 FAKE ST <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,57,0)="    STREET ADDRESS [LINE 2]: <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,58,0)="    ZIP+4: 75024 <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,60,0)="         Select one of the following:"
^DIC(9.4,60,22,13,"PAH",206,1,61,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,62,0)="              1         PLANO*"
^DIC(9.4,60,22,13,"PAH",206,1,63,0)="              99        FREE TEXT"
^DIC(9.4,60,22,13,"PAH",206,1,64,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,65,0)="    CITY: // 1  <RET> PLANO*"
^DIC(9.4,60,22,13,"PAH",206,1,66,0)="    STATE: TEXAS <DISPLAY>"
^DIC(9.4,60,22,13,"PAH",206,1,67,0)="    COUNTY: COLLIN <DISPLAY>"
^DIC(9.4,60,22,13,"PAH",206,1,68,0)="    PHONE NUMBER [RESIDENCE]: 972-555-1234 <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,69,0)="    PHONE NUMBER [WORK]: 972-555-4321 <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,70,0)="    BAD ADDRESS INDICATOR: ? <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,72,0)="    Please enter 1 if the address is 'UNDELIVERABLE', 2 if the patient"
^DIC(9.4,60,22,13,"PAH",206,1,73,0)="    is 'HOMELESS', or 3 for 'OTHER' bad address reasons."
^DIC(9.4,60,22,13,"PAH",206,1,74,0)="    Choose from: "
^DIC(9.4,60,22,13,"PAH",206,1,75,0)="    1        UNDELIVERABLE"
^DIC(9.4,60,22,13,"PAH",206,1,76,0)="    2        HOMELESS"
^DIC(9.4,60,22,13,"PAH",206,1,77,0)="    3        OTHER"
^DIC(9.4,60,22,13,"PAH",206,1,78,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,80,0)="    BAD ADDRESS INDICATOR:  <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,81,0)="    Are you sure that you want to save the above changes? NO// YES <RET>"
^DIC(9.4,60,22,13,"PAH",206,1,82,0)="    Change saved."
^DIC(9.4,60,22,13,"PAH",206,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,84,0)="    CNH CURRENT:"
^DIC(9.4,60,22,13,"PAH",206,1,85,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,86,0)="     :           :            :            :"
^DIC(9.4,60,22,13,"PAH",206,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,89,0)="    NOTES:"
^DIC(9.4,60,22,13,"PAH",206,1,90,0)="    ====="
^DIC(9.4,60,22,13,"PAH",206,1,91,0)="    1) Multiple "":""'s above indicate that other fields have been "
^DIC(9.4,60,22,13,"PAH",206,1,92,0)="       suppressed to abbreviate the example."
^DIC(9.4,60,22,13,"PAH",206,1,93,0)="    2) <RET> indicates the <RETURN> key."
^DIC(9.4,60,22,13,"PAH",206,1,94,0)="    3) <DISPLAY> indicates that the field was displayed and was not "
^DIC(9.4,60,22,13,"PAH",206,1,95,0)="       editable."
^DIC(9.4,60,22,13,"PAH",206,1,96,0)="    4) BAD ADDRESS INDICATOR is a new field introduced by the "
^DIC(9.4,60,22,13,"PAH",206,1,97,0)="       Registration application. For more information on this field,"
^DIC(9.4,60,22,13,"PAH",206,1,98,0)="       please refer to the documentation for that application."
^DIC(9.4,60,22,13,"PAH",206,1,99,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,100,0)="    IMPORTANT FUNCTIONALITY CHANGE:"
^DIC(9.4,60,22,13,"PAH",206,1,101,0)="    =============================="
^DIC(9.4,60,22,13,"PAH",206,1,102,0)="    - A new prompt ""Do you want to update the Permanent address/phone?"
^DIC(9.4,60,22,13,"PAH",206,1,103,0)="      //N"" will be displayed before editing the permanent address/phone"
^DIC(9.4,60,22,13,"PAH",206,1,104,0)="      information to give the user a chance to skip it. If the user"
^DIC(9.4,60,22,13,"PAH",206,1,105,0)="      responds with ""N"", the control will go to the CNH CURRENT field"
^DIC(9.4,60,22,13,"PAH",206,1,106,0)="      prompt. Otherwise, the user will go through editing the"
^DIC(9.4,60,22,13,"PAH",206,1,107,0)="      address/phone information fields."
^DIC(9.4,60,22,13,"PAH",206,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",206,1,109,0)="    - When entering a new or updating an existing patient permanent"
^DIC(9.4,60,22,13,"PAH",206,1,110,0)="      address, the information is not saved to the database until the"
^DIC(9.4,60,22,13,"PAH",206,1,111,0)="      prompt above ""Are you sure that you want to save the above changes?"""
^DIC(9.4,60,22,13,"PAH",206,1,112,0)="      is answered YES. If the application times out or an '^' (up-arrow)"
^DIC(9.4,60,22,13,"PAH",206,1,113,0)="      is entered in any of the permanent address fields above, the changes"
^DIC(9.4,60,22,13,"PAH",206,1,114,0)="      are NOT saved."
^DIC(9.4,60,22,13,"PAH",207,0)="232 SEQ #213^3060711^1"
^DIC(9.4,60,22,13,"PAH",207,1,0)="^^5^5^3060711"
^DIC(9.4,60,22,13,"PAH",207,1,1,0)="CORRECT SEVERAL PROBLEMS INCLUDING AMIS COMPILER TO FIND AND INCLUDE RX'S "
^DIC(9.4,60,22,13,"PAH",207,1,2,0)="THAT HAVE A DATE WITH NO TIME FOR RELEASE/DATE FIELD IN PRESCRIPTION FILE,"
^DIC(9.4,60,22,13,"PAH",207,1,3,0)="A NULL SUBSCRIPT ERROR DURING BINGO BOARD STARTUP, DO NOT MAIL ISSUE WHEN"
^DIC(9.4,60,22,13,"PAH",207,1,4,0)="OPAI SENDS HL7 MESSAGE, AND INCREASE DNS PORT NUMBER FIELD IN OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",207,1,5,0)="SITE FILE."
^DIC(9.4,60,22,13,"PAH",208,0)="237 SEQ #214^3060824^1"
^DIC(9.4,60,22,13,"PAH",208,1,0)="^^2^2^3060824"
^DIC(9.4,60,22,13,"PAH",208,1,1,0)="CORRECT CLOZAPINE OVERRRIDE LIST ERROR AND CORRECT FINISHING OF PENDING "
^DIC(9.4,60,22,13,"PAH",208,1,2,0)="ORDERS THAT ARE OLDER THAN A YEAR AND ARE BASICALLY EXPIRED."
^DIC(9.4,60,22,13,"PAH",209,0)="244 SEQ #215^3060824^1"
^DIC(9.4,60,22,13,"PAH",209,1,0)="^^2^2^3060824"
^DIC(9.4,60,22,13,"PAH",209,1,1,0)="Prevent newly Discontinued Rx's due to edit from being sent to the"
^DIC(9.4,60,22,13,"PAH",209,1,2,0)="External Dispense Machines."
^DIC(9.4,60,22,13,"PAH",210,0)="247^3060923^1"
^DIC(9.4,60,22,13,"PAH",210,1,0)="^^56^56^3060923"
^DIC(9.4,60,22,13,"PAH",210,1,1,0)="This patch supports the National Council for Prescription Drug Programs (NCPDP) "
^DIC(9.4,60,22,13,"PAH",210,1,2,0)="standard which was adopted under the Healthcare Insurance Portability and "
^DIC(9.4,60,22,13,"PAH",210,1,3,0)="Accountability Act (HIPAA) for pharmacy claims. This patch is one of six to be"
^DIC(9.4,60,22,13,"PAH",210,1,4,0)="released.  Three patches will be released in a KIDS multi-build distribution "
^DIC(9.4,60,22,13,"PAH",210,1,5,0)="containing: BPS*1*3, PSO*7*247, and IB*2*342.  Three patches will be released"
^DIC(9.4,60,22,13,"PAH",210,1,6,0)="individually and they are: PRCA*4.5*247, PSX*2*62, and PSS*1*115.  There is no "
^DIC(9.4,60,22,13,"PAH",210,1,7,0)="recommended order to installing the stand-alone patches and they can be "
^DIC(9.4,60,22,13,"PAH",210,1,8,0)="installed independently of the multi-build as there is no dependency between "
^DIC(9.4,60,22,13,"PAH",210,1,9,0)="the multi-build distribution and the stand-alone patches.  For more specific "
^DIC(9.4,60,22,13,"PAH",210,1,10,0)="instructions please refer to the installation steps provided in each of the "
^DIC(9.4,60,22,13,"PAH",210,1,11,0)="stand-alone patches."
^DIC(9.4,60,22,13,"PAH",210,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",210,1,13,0)="Enhancements included in the release of the six patches are a new option that "
^DIC(9.4,60,22,13,"PAH",210,1,14,0)="will enable the user to reopen a closed Electronic Claims Management Engine"
^DIC(9.4,60,22,13,"PAH",210,1,15,0)="(ECME) claim; updates to the Rx Activity Log; and permanent storage of Claims"
^DIC(9.4,60,22,13,"PAH",210,1,16,0)="activity information as reported by the ECME Billing Events Report.   "
^DIC(9.4,60,22,13,"PAH",210,1,17,0)="    "
^DIC(9.4,60,22,13,"PAH",210,1,18,0)="This patch modifies the Outpatient Pharmacy (OP) V. 7.0 application in the"
^DIC(9.4,60,22,13,"PAH",210,1,19,0)="following areas: "
^DIC(9.4,60,22,13,"PAH",210,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",210,1,21,0)="1. When the DAW CODE was edited on a released Consolidated Mail Outpatient "
^DIC(9.4,60,22,13,"PAH",210,1,22,0)="   Pharmacy (CMOP)  prescription it was not triggering an automatic claim "
^DIC(9.4,60,22,13,"PAH",210,1,23,0)="   reversal/re-submit to the third party payer. This patch corrects the "
^DIC(9.4,60,22,13,"PAH",210,1,24,0)="   problem. Editing the DAW CODE on a released CMOP prescription will work"
^DIC(9.4,60,22,13,"PAH",210,1,25,0)="   similar to editing a WINDOW prescription, it will reverse/re-submit a"
^DIC(9.4,60,22,13,"PAH",210,1,26,0)="   claim."
^DIC(9.4,60,22,13,"PAH",210,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",210,1,28,0)="2. The ECME Reject section of the prescription activity log was changed in"
^DIC(9.4,60,22,13,"PAH",210,1,29,0)="   the following ways: "
^DIC(9.4,60,22,13,"PAH",210,1,30,0)="   "
^DIC(9.4,60,22,13,"PAH",210,1,31,0)="   2.1) The column header ""Date/Time"" was changed to ""Date/Time Rcvd"" because"
^DIC(9.4,60,22,13,"PAH",210,1,32,0)="        a new column is being created (see 2.3)."
^DIC(9.4,60,22,13,"PAH",210,1,33,0)="   2.2) ""DRUG UTILIZATION REVIEW"" in the ""Reject"" column will now display as"
^DIC(9.4,60,22,13,"PAH",210,1,34,0)="        ""DUR"" for space saving purposes."
^DIC(9.4,60,22,13,"PAH",210,1,35,0)="   2.3) A new column is being created called ""Date/Time Resolved"" on the"
^DIC(9.4,60,22,13,"PAH",210,1,36,0)="        right hand side to display the Date/Time the reject was resolved."
^DIC(9.4,60,22,13,"PAH",210,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",210,1,38,0)="3. The option Third Party Payer Rejects - Worklist [PSO REJECTS WORKLIST]"
^DIC(9.4,60,22,13,"PAH",210,1,39,0)="   is being changed to allow the user to print a label for window"
^DIC(9.4,60,22,13,"PAH",210,1,40,0)="   prescriptions after a reject is resolved. The label print prompt will only"
^DIC(9.4,60,22,13,"PAH",210,1,41,0)="   be available if the prescription is active and no label was printed for"
^DIC(9.4,60,22,13,"PAH",210,1,42,0)="   the fill which reject was resolved. The following prompts will be "
^DIC(9.4,60,22,13,"PAH",210,1,43,0)="   presented to the user:"
^DIC(9.4,60,22,13,"PAH",210,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",210,1,45,0)="      Print Label? YES // YES"
^DIC(9.4,60,22,13,"PAH",210,1,46,0)="    "
^DIC(9.4,60,22,13,"PAH",210,1,47,0)="      Select LABEL DEVICE:"
^DIC(9.4,60,22,13,"PAH",210,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",210,1,49,0)="4. When the user resolved a third party reject using the 'Override Reject'"
^DIC(9.4,60,22,13,"PAH",210,1,50,0)="   action from the Third Party Payer Rejects - Worklist [PSO REJECTS "
^DIC(9.4,60,22,13,"PAH",210,1,51,0)="   WORKLIST] option, the entry in the Prescription activity log "
^DIC(9.4,60,22,13,"PAH",210,1,52,0)="   corresponding to this event was not displaying the NCPDP override codes"
^DIC(9.4,60,22,13,"PAH",210,1,53,0)="   entered by the user. Before this fix the comment displayed as "
^DIC(9.4,60,22,13,"PAH",210,1,54,0)="   'Submitted to ECME:REJECT WORKLIST-E PAYABLE'. After this patch is"
^DIC(9.4,60,22,13,"PAH",210,1,55,0)="   installed the comment will be logged as 'Submitted to ECME:REJECT "
^DIC(9.4,60,22,13,"PAH",210,1,56,0)="   WORKLIST-DUR OVERRIDE CODES(NN/AS/1B)-E PAYABLE', as an example."
^DIC(9.4,60,22,13,"PAH",211,0)="222 SEQ #217^3060923^1"
^DIC(9.4,60,22,13,"PAH",211,1,0)="^^65^65^3060923"
^DIC(9.4,60,22,13,"PAH",211,1,1,0)="The Department of Veterans Affairs National Clozapine Coordinating Center"
^DIC(9.4,60,22,13,"PAH",211,1,2,0)="(NCCC), is requesting modifications to Veterans Health Information Systems"
^DIC(9.4,60,22,13,"PAH",211,1,3,0)="and Technology Architecture (VistA) Outpatient Pharmacy and Mental Health"
^DIC(9.4,60,22,13,"PAH",211,1,4,0)="applications to meet revisions in the Food and Drug Administration (FDA)"
^DIC(9.4,60,22,13,"PAH",211,1,5,0)="monitoring requirements for blood monitoring in patients being treated"
^DIC(9.4,60,22,13,"PAH",211,1,6,0)="with Clozapine."
^DIC(9.4,60,22,13,"PAH",211,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,8,0)="This patch PSO*7*222 is associated with the MENTAL HEALTH V. 5.01 patch"
^DIC(9.4,60,22,13,"PAH",211,1,9,0)="YS*5.01*90 and patch YS*5.01*90 is a required patch for PSO*7*222. Please"
^DIC(9.4,60,22,13,"PAH",211,1,10,0)="read the patch description of YS*5.01*90 for complete details of this new"
^DIC(9.4,60,22,13,"PAH",211,1,11,0)="enhancement."
^DIC(9.4,60,22,13,"PAH",211,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,13,0)="This Outpatient Pharmacy patch PSO*7*222 contains the following"
^DIC(9.4,60,22,13,"PAH",211,1,14,0)="must-do-work enhancements for Clozapine dispensing:"
^DIC(9.4,60,22,13,"PAH",211,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,16,0)="1. Adjust the business rules to disallow prescription processing without"
^DIC(9.4,60,22,13,"PAH",211,1,17,0)="   override if 3500/mm3>WBC>3000/mm3 and 2000/mm3>ANC>1500/mm3."
^DIC(9.4,60,22,13,"PAH",211,1,18,0)="   These levels require twice weekly blood testing until the WBC"
^DIC(9.4,60,22,13,"PAH",211,1,19,0)="   stabilizes above 3500/mm3 and ANC above 2000/mm3 with no signs of"
^DIC(9.4,60,22,13,"PAH",211,1,20,0)="   infection."
^DIC(9.4,60,22,13,"PAH",211,1,21,0)="2. Modify routine logic to recognize the new monthly status and apply the"
^DIC(9.4,60,22,13,"PAH",211,1,22,0)="   appropriate restrictions for lab draw checks."
^DIC(9.4,60,22,13,"PAH",211,1,23,0)="3. Add a new field to the PRESCRIPTION file (#52) to store ANC value and"
^DIC(9.4,60,22,13,"PAH",211,1,24,0)="   modify routine logic to require both a WBC and ANC be drawn and"
^DIC(9.4,60,22,13,"PAH",211,1,25,0)="   reported before drug dispensing is allowed."
^DIC(9.4,60,22,13,"PAH",211,1,26,0)="4. Modify routine logic to prevent local users from editing the Patient"
^DIC(9.4,60,22,13,"PAH",211,1,27,0)="   Status within Clozapine module."
^DIC(9.4,60,22,13,"PAH",211,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,29,0)="This patch transports the following fields:"
^DIC(9.4,60,22,13,"PAH",211,1,30,0)="1. The field length of the WBC RESULT field (#302) of the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",211,1,31,0)="   file (#52) is modified from 3 to 5 digits to accommodate values up to"
^DIC(9.4,60,22,13,"PAH",211,1,32,0)="   99999 as these values will be stored in 1000s."
^DIC(9.4,60,22,13,"PAH",211,1,33,0)="2. A new field ANC RESULTS field (#304) is added to the PRESCRIPTION file"
^DIC(9.4,60,22,13,"PAH",211,1,34,0)="   (#52) to store the ANC test value."
^DIC(9.4,60,22,13,"PAH",211,1,35,0)="3. The field name of REASON FOR LOCKOUT field (#4) of the CLOZAPINE"
^DIC(9.4,60,22,13,"PAH",211,1,36,0)="   PRESCRIPTION OVERRIDES file (#52.52) is changed to REASON FOR OVERRIDE."
^DIC(9.4,60,22,13,"PAH",211,1,37,0)="   The set of codes have been modified and three new codes were added. The"
^DIC(9.4,60,22,13,"PAH",211,1,38,0)="   modified Data Dictionary (DD) is as follows:"
^DIC(9.4,60,22,13,"PAH",211,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,40,0)="   52.52,4       REASON FOR OVERRIDE    0;5 SET (Required)"
^DIC(9.4,60,22,13,"PAH",211,1,41,0)="                        '1' FOR NO WBC IN LAST 7 DAYS;"
^DIC(9.4,60,22,13,"PAH",211,1,42,0)="                        '2' FOR NO VERIFIED WBC;"
^DIC(9.4,60,22,13,"PAH",211,1,43,0)="                        '3' FOR LAST WBC RESULT < 3500;"
^DIC(9.4,60,22,13,"PAH",211,1,44,0)="                        '4' FOR 3 SEQ. WBC DECREASE;"
^DIC(9.4,60,22,13,"PAH",211,1,45,0)="                        '5' FOR LAST ANC RESULT < 2000;"
^DIC(9.4,60,22,13,"PAH",211,1,46,0)="                        '6' FOR 3 SEQ. ANC DECREASE ;"
^DIC(9.4,60,22,13,"PAH",211,1,47,0)="                        '7' FOR NCCC AUTHORIZED;"
^DIC(9.4,60,22,13,"PAH",211,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",211,1,50,0)="The Outpatient Pharmacy patch PSO*7*227, TRANSITIONAL PHARMACY BENEFIT"
^DIC(9.4,60,22,13,"PAH",211,1,51,0)="(TPB) inactivation, was placing the TPB HL7 Data Extract/Transmission [PSO"
^DIC(9.4,60,22,13,"PAH",211,1,52,0)="TPB HL7 EXTRACT] option out of order. Sites testing patch PSO*7*227"
^DIC(9.4,60,22,13,"PAH",211,1,53,0)="recommended that we remove this task totally from the OPTION SCHEDULING"
^DIC(9.4,60,22,13,"PAH",211,1,54,0)="file (#19.2). Therefore, a post-install routine (PSOP222) is included in"
^DIC(9.4,60,22,13,"PAH",211,1,55,0)="this patch PSO*7*222 to delete the TPB HL7 Data Extract/Transmission [PSO"
^DIC(9.4,60,22,13,"PAH",211,1,56,0)="TPB HL7 EXTRACT] option from the OPTION SCHEDULING file (#19.2)."
^DIC(9.4,60,22,13,"PAH",211,1,57,0)="The post-install routine will also provide the following changes:"
^DIC(9.4,60,22,13,"PAH",211,1,58,0)="1. As the patch PSO*7*227 inactivated the TPB functionality, the security"
^DIC(9.4,60,22,13,"PAH",211,1,59,0)="   access codes for the TPB ELIGIBILITY file (#52.91) still remains open."
^DIC(9.4,60,22,13,"PAH",211,1,60,0)="   These codes will be changed to ""@"" sign restricting access to"
^DIC(9.4,60,22,13,"PAH",211,1,61,0)="   programmers only."
^DIC(9.4,60,22,13,"PAH",211,1,62,0)="2. The read access code of the PRESCRIPTION REFILL REQUEST file (#52.43)"
^DIC(9.4,60,22,13,"PAH",211,1,63,0)="   is currently set to ""@"" sign (programmer access). As per the"
^DIC(9.4,60,22,13,"PAH",211,1,64,0)="   Electronic, Error and Enhancement Report (E3R) 19725 request, this will"
^DIC(9.4,60,22,13,"PAH",211,1,65,0)="   be changed to ""Pp"" (Pharmacy Package) access."
^DIC(9.4,60,22,13,"PAH",212,0)="233 SEQ #218^3061122.222^1"
^DIC(9.4,60,22,13,"PAH",212,1,0)="^^195^195^3061122"
^DIC(9.4,60,22,13,"PAH",212,1,1,0)="This patch enhances the usage of Application Program Interfaces (APIs) to"
^DIC(9.4,60,22,13,"PAH",212,1,2,0)="the Registration Package V. 5.3 to check the setting of the BAD ADDRESS"
^DIC(9.4,60,22,13,"PAH",212,1,3,0)="INDICATOR field (#.121) in the PATIENT file (#2) and to update the"
^DIC(9.4,60,22,13,"PAH",212,1,4,0)="permanent and temporary addresses. The BAD ADDRESS INDICATOR (referred to"
^DIC(9.4,60,22,13,"PAH",212,1,5,0)="as BAI in this description) is one of the fields presented when using the"
^DIC(9.4,60,22,13,"PAH",212,1,6,0)="API to update permanent address fields."
^DIC(9.4,60,22,13,"PAH",212,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,8,0)="Outpatient Pharmacy V. 7.0 options are modified to not print the "
^DIC(9.4,60,22,13,"PAH",212,1,9,0)="patient's address if a bad address is indicated and to prompt to update"
^DIC(9.4,60,22,13,"PAH",212,1,10,0)="the patient's address when appropriate. If the patient has the BAD ADDRESS"
^DIC(9.4,60,22,13,"PAH",212,1,11,0)="INDICATOR field set and no active temporary address, this is referred to"
^DIC(9.4,60,22,13,"PAH",212,1,12,0)="as a BAI condition in this description."
^DIC(9.4,60,22,13,"PAH",212,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,14,0)="Note: Related changes for the Outpatient Pharmacy Automation Interface"
^DIC(9.4,60,22,13,"PAH",212,1,15,0)="(OPAI) and Consolidated Mail Outpatient Pharmacy (CMOP) will be done in"
^DIC(9.4,60,22,13,"PAH",212,1,16,0)="patches PSO*7*200 and PSX*2*54."
^DIC(9.4,60,22,13,"PAH",212,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,19,0)="The following changes are made in this patch:"
^DIC(9.4,60,22,13,"PAH",212,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,21,0)="1. A new security key PSO ADDRESS UPDATE is added. Either the EDIT "
^DIC(9.4,60,22,13,"PAH",212,1,22,0)="PATIENT DATA field (#.123) in the PSO SITE file (#59) must be set to "
^DIC(9.4,60,22,13,"PAH",212,1,23,0)="""Yes"" or the user must have this new security key in order to be"
^DIC(9.4,60,22,13,"PAH",212,1,24,0)="prompted to update the address (permanent and/or temporary addresses)."
^DIC(9.4,60,22,13,"PAH",212,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,26,0)="2. When selecting a patient name in the Patient Prescription Processing "
^DIC(9.4,60,22,13,"PAH",212,1,27,0)="[PSO LM BACKDOOR ORDERS] option, if the patient's address is flagged with"
^DIC(9.4,60,22,13,"PAH",212,1,28,0)="a Bad Address Indicator, then a warning message is displayed. If the "
^DIC(9.4,60,22,13,"PAH",212,1,29,0)="EDIT PATIENT DATA is set to Yes or the user holds the new"
^DIC(9.4,60,22,13,"PAH",212,1,30,0)="PSO ADDRESS UPDATE security key, he will be asked if he wants to update"
^DIC(9.4,60,22,13,"PAH",212,1,31,0)="the patient's address. If there is a valid temporary address, a message to"
^DIC(9.4,60,22,13,"PAH",212,1,32,0)="that effect is displayed before the prompt to update the address."
^DIC(9.4,60,22,13,"PAH",212,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,34,0)="Example:"
^DIC(9.4,60,22,13,"PAH",212,1,35,0)="  PSOOUTPATIENT,ONE (000-00-0777)"
^DIC(9.4,60,22,13,"PAH",212,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,37,0)="        WARNING: The patient address is indicated as a bad"
^DIC(9.4,60,22,13,"PAH",212,1,38,0)="                 address (UNDELIVERABLE)."
^DIC(9.4,60,22,13,"PAH",212,1,39,0)="                 * Temporary address is active *"
^DIC(9.4,60,22,13,"PAH",212,1,40,0)="Do you want to update the address/phone? N// YES"
^DIC(9.4,60,22,13,"PAH",212,1,41,0)="Update (P)ermanent address, (T)emporary, or (B)oth: BOTH// "
^DIC(9.4,60,22,13,"PAH",212,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,43,0)="3. In the Medication Profile [PSO P] option, the Patient Prescription "
^DIC(9.4,60,22,13,"PAH",212,1,44,0)="Processing [PSO LM BACKDOOR ORDERS] option, and the Complete Orders from"
^DIC(9.4,60,22,13,"PAH",212,1,45,0)="OERR [PSO LMOE FINISH] option, the following changes were made:"
^DIC(9.4,60,22,13,"PAH",212,1,46,0)="a. When the medication profile is displayed, the letter ""B"" (for bad"
^DIC(9.4,60,22,13,"PAH",212,1,47,0)="address) is added to the status column if the last label activity for that"
^DIC(9.4,60,22,13,"PAH",212,1,48,0)="prescription indicated a BAI condition. If the address is corrected and"
^DIC(9.4,60,22,13,"PAH",212,1,49,0)="label reprinted, ""B"" no longer appears on the profile."
^DIC(9.4,60,22,13,"PAH",212,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,51,0)="Example:"
^DIC(9.4,60,22,13,"PAH",212,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,53,0)="                    Medication Profile Sorted by ISSUE DATE"
^DIC(9.4,60,22,13,"PAH",212,1,54,0)="                                                         REF"
^DIC(9.4,60,22,13,"PAH",212,1,55,0)=" Rx#         Drug                                     ST REM  Issued  "
^DIC(9.4,60,22,13,"PAH",212,1,56,0)="Last Fill"
^DIC(9.4,60,22,13,"PAH",212,1,57,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",212,1,58,0)="-----"
^DIC(9.4,60,22,13,"PAH",212,1,59,0)="$300920A     ACETIC ACID 2% OTIC SOL 15 ML            DCB  5 07-20-06 "
^DIC(9.4,60,22,13,"PAH",212,1,60,0)="07-20-06"
^DIC(9.4,60,22,13,"PAH",212,1,61,0)="     QTY: 1             SIG: INSTILL 2 DROPS AD AS NEEDED  "
^DIC(9.4,60,22,13,"PAH",212,1,62,0)="$100002514C  SIMVASTATIN                               S   5 06-29-06 "
^DIC(9.4,60,22,13,"PAH",212,1,63,0)="12-10-06"
^DIC(9.4,60,22,13,"PAH",212,1,64,0)="     QTY: 150           SIG: ONE IV TWICE A DAY"
^DIC(9.4,60,22,13,"PAH",212,1,65,0)="$300927      UREA 10% LOTION                          AB   5 06-29-06 "
^DIC(9.4,60,22,13,"PAH",212,1,66,0)="06-29-06"
^DIC(9.4,60,22,13,"PAH",212,1,67,0)="     QTY: 1             SIG: APPLY SPARINGLY TO AFFECTED AREA AS NEEDED"
^DIC(9.4,60,22,13,"PAH",212,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,69,0)="b. If there is no ending date for the temporary address, the fact that the"
^DIC(9.4,60,22,13,"PAH",212,1,70,0)="address was temporary was not being displayed in the patient profile."
^DIC(9.4,60,22,13,"PAH",212,1,71,0)="This patch adds the temporary indication including the text ""(no end"
^DIC(9.4,60,22,13,"PAH",212,1,72,0)="date)"" if no ending temporary date exists."
^DIC(9.4,60,22,13,"PAH",212,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,74,0)="Example:"
^DIC(9.4,60,22,13,"PAH",212,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,76,0)="Disabilities:                                                             "
^DIC(9.4,60,22,13,"PAH",212,1,77,0)="     "
^DIC(9.4,60,22,13,"PAH",212,1,78,0)="      (Temp Address from AUG 28,2006 till (no end date))"
^DIC(9.4,60,22,13,"PAH",212,1,79,0)="LINE1                  "
^DIC(9.4,60,22,13,"PAH",212,1,80,0)="ANYTOWN                                       PHONE: "
^DIC(9.4,60,22,13,"PAH",212,1,81,0)="555-1212                   "
^DIC(9.4,60,22,13,"PAH",212,1,82,0)="TEXAS  "
^DIC(9.4,60,22,13,"PAH",212,1,83,0)="77379                                                                    "
^DIC(9.4,60,22,13,"PAH",212,1,84,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,86,0)="4. The Input Template [PSO OUTPT] is modified to remove temporary"
^DIC(9.4,60,22,13,"PAH",212,1,87,0)="address update prompts. Instead, a new API to the Registration Package "
^DIC(9.4,60,22,13,"PAH",212,1,88,0)="V. 5.3 is used for updating temporary address for the Update Patient"
^DIC(9.4,60,22,13,"PAH",212,1,89,0)="Record [PSO PAT] option and the Patient Record Update [PU] action (within"
^DIC(9.4,60,22,13,"PAH",212,1,90,0)="the patient profile). This option and action are also changed to check for"
^DIC(9.4,60,22,13,"PAH",212,1,91,0)="the user holding the PSO ADDRESS UPDATE security key or the EDIT PATIENT"
^DIC(9.4,60,22,13,"PAH",212,1,92,0)="DATA field is set to ""Yes"" before the user is prompted to update the"
^DIC(9.4,60,22,13,"PAH",212,1,93,0)="addresses."
^DIC(9.4,60,22,13,"PAH",212,1,94,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,95,0)="5. The following changes are made to laser label printing:"
^DIC(9.4,60,22,13,"PAH",212,1,96,0)="a. If BAD ADDRESS INDICATOR is set and there is no active temporary"
^DIC(9.4,60,22,13,"PAH",212,1,97,0)="address, the Mailing label prints ** BAD ADDRESS INDICATED ** and does not"
^DIC(9.4,60,22,13,"PAH",212,1,98,0)="print the rest of the mailing address."
^DIC(9.4,60,22,13,"PAH",212,1,99,0)="b. An additional label log entry added for bad address indicated at the"
^DIC(9.4,60,22,13,"PAH",212,1,100,0)="time the label printed."
^DIC(9.4,60,22,13,"PAH",212,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,102,0)="6. In the Complete Orders from OERR [PSO LMOE FINISH] option, after the "
^DIC(9.4,60,22,13,"PAH",212,1,103,0)="prompt to display the medication profile and after the patient name and "
^DIC(9.4,60,22,13,"PAH",212,1,104,0)="social security number are shown, if the patient's address is flagged "
^DIC(9.4,60,22,13,"PAH",212,1,105,0)="with a Bad Address Indicator, a warning message is displayed. If the "
^DIC(9.4,60,22,13,"PAH",212,1,106,0)="temporary address is active, that information is displayed. The user"
^DIC(9.4,60,22,13,"PAH",212,1,107,0)="will not be prompted to update the address."
^DIC(9.4,60,22,13,"PAH",212,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,109,0)="Example:"
^DIC(9.4,60,22,13,"PAH",212,1,110,0)="Do you want to see Medication Profile? Yes// NO"
^DIC(9.4,60,22,13,"PAH",212,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,112,0)="          PERPATNM,FRED (666-00-0777)"
^DIC(9.4,60,22,13,"PAH",212,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,114,0)="        WARNING: The patient address is indicated as a bad"
^DIC(9.4,60,22,13,"PAH",212,1,115,0)="                 address (UNDELIVERABLE)."
^DIC(9.4,60,22,13,"PAH",212,1,116,0)="                 * Temporary address is active *"
^DIC(9.4,60,22,13,"PAH",212,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,118,0)="Press Return to continue: "
^DIC(9.4,60,22,13,"PAH",212,1,119,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,120,0)="7. The Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE] option "
^DIC(9.4,60,22,13,"PAH",212,1,121,0)="is modified to display **BAD ADDRESS INDICATED-(REASON)"" where REASON is "
^DIC(9.4,60,22,13,"PAH",212,1,122,0)="UNDELIVERABLE, HOMELESS, or OTHER."
^DIC(9.4,60,22,13,"PAH",212,1,123,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,124,0)="8. Although the Transitional Pharmacy Benefits (TPB) options have been "
^DIC(9.4,60,22,13,"PAH",212,1,125,0)="disabled, to keep the changes consistent, the routine to print TPB letters"
^DIC(9.4,60,22,13,"PAH",212,1,126,0)="is modified to look at the BAI condition and print ""** BAD ADDRESS"
^DIC(9.4,60,22,13,"PAH",212,1,127,0)="INDICATED ** if applicable."
^DIC(9.4,60,22,13,"PAH",212,1,128,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,129,0)="9.The Patient Address Changes Report [PSO ADDRESS CHANGE REPORT] option "
^DIC(9.4,60,22,13,"PAH",212,1,130,0)="is modified to display additional mailing address-related fields from the"
^DIC(9.4,60,22,13,"PAH",212,1,131,0)="PATIENT file (#2) and some fields related to the mail setting from the"
^DIC(9.4,60,22,13,"PAH",212,1,132,0)="PHARMACY PATIENT file (#55). The user should use FileMan to turn "
^DIC(9.4,60,22,13,"PAH",212,1,133,0)="on auditing for the following fields in order for them to be displayed "
^DIC(9.4,60,22,13,"PAH",212,1,134,0)="in this report. (Fields added to this report by this patch are indicated"
^DIC(9.4,60,22,13,"PAH",212,1,135,0)="with a ""*"" in front of the field name)."
^DIC(9.4,60,22,13,"PAH",212,1,136,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,137,0)="a. For the PATIENT file (#2), turn on auditing for:"
^DIC(9.4,60,22,13,"PAH",212,1,138,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,139,0)="STREET ADDRESS [LINE 1] field (#.111)"
^DIC(9.4,60,22,13,"PAH",212,1,140,0)="ZIP+4 field (#.1112)"
^DIC(9.4,60,22,13,"PAH",212,1,141,0)="STREET ADDRESS [LINE 2] field (#.112)"
^DIC(9.4,60,22,13,"PAH",212,1,142,0)="STREET ADDRESS [LINE 3] field (#.113)"
^DIC(9.4,60,22,13,"PAH",212,1,143,0)="CITY field (#.114)"
^DIC(9.4,60,22,13,"PAH",212,1,144,0)="STATE field (#.115)"
^DIC(9.4,60,22,13,"PAH",212,1,145,0)="ZIP CODE field (#.116)"
^DIC(9.4,60,22,13,"PAH",212,1,146,0)="* BAD ADDRESS INDICATOR field (#.121)"
^DIC(9.4,60,22,13,"PAH",212,1,147,0)="* TEMPORARY ADDRESS ACTIVE? field (#.12105)"
^DIC(9.4,60,22,13,"PAH",212,1,148,0)="TEMPORARY STREET [LINE 1] field (#.1211)"
^DIC(9.4,60,22,13,"PAH",212,1,149,0)="TEMPORARY ZIP+4 field (#.12112)"
^DIC(9.4,60,22,13,"PAH",212,1,150,0)="TEMPORARY STREET [LINE 2] field (#.1212)"
^DIC(9.4,60,22,13,"PAH",212,1,151,0)="TEMPORARY STREET [LINE 3] field (#.1213)"
^DIC(9.4,60,22,13,"PAH",212,1,152,0)="TEMPORARY CITY field (#.1214)"
^DIC(9.4,60,22,13,"PAH",212,1,153,0)="TEMPORARY STATE field (#.1215)"
^DIC(9.4,60,22,13,"PAH",212,1,154,0)="TEMPORARY ZIP CODE field (#.1216)"
^DIC(9.4,60,22,13,"PAH",212,1,155,0)="* TEMPORARY ADDRESS START DATE field (#.1217)"
^DIC(9.4,60,22,13,"PAH",212,1,156,0)="* TEMPORARY ADDRESS END DATE field (#.1218)"
^DIC(9.4,60,22,13,"PAH",212,1,157,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,158,0)="b. For the PHARMACY PATIENT file (#55), turn on auditing for:"
^DIC(9.4,60,22,13,"PAH",212,1,159,0)="* MAIL field (#.03)"
^DIC(9.4,60,22,13,"PAH",212,1,160,0)="* MAIL STATUS EXPIRATION DATE field (#.05)"
^DIC(9.4,60,22,13,"PAH",212,1,161,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,162,0)="10. By request of a pharmacy workgroup, two new codes were added to the"
^DIC(9.4,60,22,13,"PAH",212,1,163,0)="PRESCRIPTION file (#52) HOLD REASON field (#99):"
^DIC(9.4,60,22,13,"PAH",212,1,164,0)="                                '7' FOR BAD ADDRESS; "
^DIC(9.4,60,22,13,"PAH",212,1,165,0)="                                '8' FOR PER PATIENT REQUEST; "
^DIC(9.4,60,22,13,"PAH",212,1,166,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,168,0)="11. A Bad Address Reporting Main Menu [PSO BAI REPORT] option is added "
^DIC(9.4,60,22,13,"PAH",212,1,169,0)="under the Output Reports [PSO OUTPUTS] option which includes the"
^DIC(9.4,60,22,13,"PAH",212,1,170,0)="following:"
^DIC(9.4,60,22,13,"PAH",212,1,171,0)="a. Bad Address Suspended List [PSO BAI SUSPENDED] option"
^DIC(9.4,60,22,13,"PAH",212,1,172,0)="This option identifies prescriptions for veterans with a BAI Condition"
^DIC(9.4,60,22,13,"PAH",212,1,173,0)="giving the opportunity to be proactive regarding prescriptions that when"
^DIC(9.4,60,22,13,"PAH",212,1,174,0)="Printed or Pulled Early from Suspense, would be unable to be mailed."
^DIC(9.4,60,22,13,"PAH",212,1,175,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,176,0)="b. List Prescriptions Not Mailed [PSO BAI NOT MAILED] option  "
^DIC(9.4,60,22,13,"PAH",212,1,177,0)="This option provides a report of prescriptions with a routing of Mail that"
^DIC(9.4,60,22,13,"PAH",212,1,178,0)="were not mailed due to a bad address. This is based on the last label"
^DIC(9.4,60,22,13,"PAH",212,1,179,0)="activity entry being flagged as a bad address and a route other than"
^DIC(9.4,60,22,13,"PAH",212,1,180,0)="""WINDOW"". If the address is corrected and a label reprinted, this"
^DIC(9.4,60,22,13,"PAH",212,1,181,0)="prescription would no longer show on the report."
^DIC(9.4,60,22,13,"PAH",212,1,182,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,183,0)="12. The View Prescriptions [PSO VIEW] option is changed to show Bad "
^DIC(9.4,60,22,13,"PAH",212,1,184,0)="Address Indicated if BAI flag is set and no active temporary address. "
^DIC(9.4,60,22,13,"PAH",212,1,185,0)="Example:"
^DIC(9.4,60,22,13,"PAH",212,1,186,0)="VIEW PRESCRIPTION:    713449A     ACETAMINOPHEN 325MG TAB  "
^DIC(9.4,60,22,13,"PAH",212,1,187,0)=" "
^DIC(9.4,60,22,13,"PAH",212,1,188,0)="                         "
^DIC(9.4,60,22,13,"PAH",212,1,189,0)="Rx View (Active)              Aug 30, 2006@18:44:09          Page:    1 "
^DIC(9.4,60,22,13,"PAH",212,1,190,0)="of    5 "
^DIC(9.4,60,22,13,"PAH",212,1,191,0)="OUTPATIENT,ONE ** BAD ADDRESS INDICATED-(UNDELIVERABLE)"
^DIC(9.4,60,22,13,"PAH",212,1,192,0)="  PID: 666-00-0146                                 Ht(cm): _______ "
^DIC(9.4,60,22,13,"PAH",212,1,193,0)="(______)   "
^DIC(9.4,60,22,13,"PAH",212,1,194,0)="  DOB: DEC 00,1953 (52)                             Wt(kg): _______ "
^DIC(9.4,60,22,13,"PAH",212,1,195,0)="(______)   "
^DIC(9.4,60,22,13,"PAH",213,0)="239 SEQ #219^3061122.223131^1"
^DIC(9.4,60,22,13,"PAH",213,1,0)="^^295^295^3061122"
^DIC(9.4,60,22,13,"PAH",213,1,1,0)="The following describes all of the changes included in this patch:"
^DIC(9.4,60,22,13,"PAH",213,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,3,0)="1.  For Remedy Ticket 130112:"
^DIC(9.4,60,22,13,"PAH",213,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,5,0)="After installation of patch PSO*7*226, it was reported that the activity"
^DIC(9.4,60,22,13,"PAH",213,1,6,0)="log entries generated by the patch were confusing. A large part of patch"
^DIC(9.4,60,22,13,"PAH",213,1,7,0)="PSO*7*226 was to cancel any erroneously billed copays and to define any"
^DIC(9.4,60,22,13,"PAH",213,1,8,0)="missing IBQ nodes on the prescription using the SC/EI answers stored on"
^DIC(9.4,60,22,13,"PAH",213,1,9,0)="the ICD node.  For those prescriptions where the IBQ node was defined, an"
^DIC(9.4,60,22,13,"PAH",213,1,10,0)="activity log entry was created with a reason of ""RETURNED"".  For those"
^DIC(9.4,60,22,13,"PAH",213,1,11,0)="prescriptions where copay was cancelled, a copay activity log was"
^DIC(9.4,60,22,13,"PAH",213,1,12,0)="generated. The following are examples of those types of entries made by"
^DIC(9.4,60,22,13,"PAH",213,1,13,0)="PSO*7*226."
^DIC(9.4,60,22,13,"PAH",213,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,15,0)="Activity Log Example:"
^DIC(9.4,60,22,13,"PAH",213,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,17,0)="  1   11/28/05    X-INTERFACE    ORIGINAL       PHARMACIST,ONE"
^DIC(9.4,60,22,13,"PAH",213,1,18,0)="    Comments: Prescription sent to external interface."
^DIC(9.4,60,22,13,"PAH",213,1,19,0)="  2   11/28/05    RETURNED       ORIGINAL       POSTMASTER"
^DIC(9.4,60,22,13,"PAH",213,1,20,0)="    Comments:  BKGD CIDC UPDATE"
^DIC(9.4,60,22,13,"PAH",213,1,21,0)="  3   11/29/05    X-INTERFACE    REFILL 1       PHARMACIST,TWO"
^DIC(9.4,60,22,13,"PAH",213,1,22,0)="    Comments: Prescription sent to external interface."
^DIC(9.4,60,22,13,"PAH",213,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,24,0)="Copay Activity Log Example:"
^DIC(9.4,60,22,13,"PAH",213,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,26,0)="  1   02/01/06    COPAY RESET          ORIGINAL       PHARMACIST,ONE"
^DIC(9.4,60,22,13,"PAH",213,1,27,0)="    Comment:-BKGD CIDC COPAY CANCEL  Old value=Copay   New value=No Copay"
^DIC(9.4,60,22,13,"PAH",213,1,28,0)="  2   02/01/06    REMOVE COPAY CHARGE  ORIGINAL       PHARMACIST,ONE"
^DIC(9.4,60,22,13,"PAH",213,1,29,0)="    Comment: RX EDITED -BKGD CIDC COPAY CANCEL"
^DIC(9.4,60,22,13,"PAH",213,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,31,0)="To eliminate any confusion, patch PSO*7*239 provides an Activity Log "
^DIC(9.4,60,22,13,"PAH",213,1,32,0)="Correction process/Clean-up routine.  This routine will take the activity"
^DIC(9.4,60,22,13,"PAH",213,1,33,0)="log entries created by patch PSO*7*226, move them to the copay activity"
^DIC(9.4,60,22,13,"PAH",213,1,34,0)="log, and then subsequently will delete the activity log entries.  Also,"
^DIC(9.4,60,22,13,"PAH",213,1,35,0)="the comment on the copay activity log entries where copay was cancelled as"
^DIC(9.4,60,22,13,"PAH",213,1,36,0)="well as those entries moved to the copay activity log will be changed to"
^DIC(9.4,60,22,13,"PAH",213,1,37,0)="""CIDC CLEANUP"".  The activity log will be resequenced to eliminate any"
^DIC(9.4,60,22,13,"PAH",213,1,38,0)="missing nodes, and the copay activity log will be resequenced to insert"
^DIC(9.4,60,22,13,"PAH",213,1,39,0)="the new entries by date and time.  The following are examples of the"
^DIC(9.4,60,22,13,"PAH",213,1,40,0)="updated entries:"
^DIC(9.4,60,22,13,"PAH",213,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,42,0)="  -Note that sequence two from the above example was removed and the"
^DIC(9.4,60,22,13,"PAH",213,1,43,0)="   third sequence was moved up."
^DIC(9.4,60,22,13,"PAH",213,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,45,0)="  1   11/28/05    X-INTERFACE    ORIGINAL       PHARMACIST,ONE"
^DIC(9.4,60,22,13,"PAH",213,1,46,0)="    Comments: Prescription sent to external interface."
^DIC(9.4,60,22,13,"PAH",213,1,47,0)="  2   11/28/05    X-INTERFACE    REFILL 1       PHARMACIST,TWO"
^DIC(9.4,60,22,13,"PAH",213,1,48,0)="    Comments: Prescription sent to external interface."
^DIC(9.4,60,22,13,"PAH",213,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,50,0)="  -The next entry shows an Activity log entry moved to Copay Activity log:"
^DIC(9.4,60,22,13,"PAH",213,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,52,0)="  1   11/28/05    COPAY RESET       ORIGINAL         POSTMASTER"
^DIC(9.4,60,22,13,"PAH",213,1,53,0)="    Comment: CIDC CLEANUP"
^DIC(9.4,60,22,13,"PAH",213,1,54,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,55,0)="  -The following shows a cancelled Copay Activity Log entry comment"
^DIC(9.4,60,22,13,"PAH",213,1,56,0)="  updated to ""CIDC CLEANUP:"
^DIC(9.4,60,22,13,"PAH",213,1,57,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,58,0)="  1   02/01/06    COPAY RESET          ORIGINAL       POSTMASTER"
^DIC(9.4,60,22,13,"PAH",213,1,59,0)="    Comment: CIDC CLEANUP  Old value=Copay   New value=No Copay"
^DIC(9.4,60,22,13,"PAH",213,1,60,0)="  2   02/01/06    REMOVE COPAY CHARGE  ORIGINAL       POSTMASTER"
^DIC(9.4,60,22,13,"PAH",213,1,61,0)="    Comment: CIDC CLEANUP  "
^DIC(9.4,60,22,13,"PAH",213,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,63,0)="This patch provides a listing of all prescriptions where the activity log"
^DIC(9.4,60,22,13,"PAH",213,1,64,0)="was updated by the Clean-up routine, a means of checking the status of the"
^DIC(9.4,60,22,13,"PAH",213,1,65,0)="Clean-up routine, and a means of stopping the Clean-up job if needed.  A"
^DIC(9.4,60,22,13,"PAH",213,1,66,0)="detailed description of these functions is located in the Technical"
^DIC(9.4,60,22,13,"PAH",213,1,67,0)="description."
^DIC(9.4,60,22,13,"PAH",213,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,69,0)="When installing this patch, the activity log Clean-up portion of this"
^DIC(9.4,60,22,13,"PAH",213,1,70,0)="patch is optional.  However, it is highly recommended that it be run for "
^DIC(9.4,60,22,13,"PAH",213,1,71,0)="consistency and maintainability."
^DIC(9.4,60,22,13,"PAH",213,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,73,0)="Once the Clean-up routine has completed a mailman message will be sent to "
^DIC(9.4,60,22,13,"PAH",213,1,74,0)="the user who installed the patch.  The following is an example:"
^DIC(9.4,60,22,13,"PAH",213,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,76,0)="    Subj: Outpatient Pharmacy PSO*7*239 CIDC ACTIVITY LOGS CORRECTION  "
^DIC(9.4,60,22,13,"PAH",213,1,77,0)="    [#200121] 03/06/06@13:56  4 lines"
^DIC(9.4,60,22,13,"PAH",213,1,78,0)="    From: PSO*7*239 CIDC ACTIVITY LOGS CORRECTION  In 'IN' basket.   Page"
^DIC(9.4,60,22,13,"PAH",213,1,79,0)="    1 *New*"
^DIC(9.4,60,22,13,"PAH",213,1,80,0)="    "
^DIC(9.4,60,22,13,"PAH",213,1,81,0)="-------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",213,1,82,0)="    The CIDC ACTIVITY LOGS CORRECTION job for the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",213,1,83,0)="    patch (PSO*7*239) started MAR 06, 2006@13:56:04"
^DIC(9.4,60,22,13,"PAH",213,1,84,0)="    and completed MAR 06, 2006@13:56:04."
^DIC(9.4,60,22,13,"PAH",213,1,85,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,86,0)="    Enter message action (in IN basket): Ignore//"
^DIC(9.4,60,22,13,"PAH",213,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,88,0)="2. The following issues were found during unit testing for backdoor "
^DIC(9.4,60,22,13,"PAH",213,1,89,0)="Outpatient Pharmacy orders, and the corrections are included in this"
^DIC(9.4,60,22,13,"PAH",213,1,90,0)="patch. "
^DIC(9.4,60,22,13,"PAH",213,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,92,0)="A.  When a prescriptions with an exempt patient status is renewed and the"
^DIC(9.4,60,22,13,"PAH",213,1,93,0)="user changes the value of service connected (SC), the default value was"
^DIC(9.4,60,22,13,"PAH",213,1,94,0)="stored instead of the changed value.  This only occurred for the SC"
^DIC(9.4,60,22,13,"PAH",213,1,95,0)="prompt.  The renew process has been modified to store the changed value."
^DIC(9.4,60,22,13,"PAH",213,1,96,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,97,0)="B.  When prescription information was stored when the RX Patient Status "
^DIC(9.4,60,22,13,"PAH",213,1,98,0)="was exempt from copay, the IBQ node was being stored needlessly.  This"
^DIC(9.4,60,22,13,"PAH",213,1,99,0)="patch will remove the functionality that stored this node."
^DIC(9.4,60,22,13,"PAH",213,1,100,0)="                                           "
^DIC(9.4,60,22,13,"PAH",213,1,101,0)="C.  For a patient defined as SC<50 but had a null SC percentage value "
^DIC(9.4,60,22,13,"PAH",213,1,102,0)="defined, backdoor Outpatient Pharmacy was asking the SC prompt but not"
^DIC(9.4,60,22,13,"PAH",213,1,103,0)="storing the answers. The SC prompt is only displayed for those"
^DIC(9.4,60,22,13,"PAH",213,1,104,0)="prescriptions that the Scheduling DBIA #1579 and/or the Integrated "
^DIC(9.4,60,22,13,"PAH",213,1,105,0)="Billing (IB) DBIA #125 determines that it should be asked.  Upon release"
^DIC(9.4,60,22,13,"PAH",213,1,106,0)="of the fill, a ""PRESCRIPTION QUESTIONS REVIEW NEEDED"" mailman message"
^DIC(9.4,60,22,13,"PAH",213,1,107,0)="requesting entry of the SC field was sent to holders of the PSO COPAY"
^DIC(9.4,60,22,13,"PAH",213,1,108,0)="key.  Because this functionality uses the same checking mechanism as"
^DIC(9.4,60,22,13,"PAH",213,1,109,0)="non-exempt new orders, the following functions were affected by this"
^DIC(9.4,60,22,13,"PAH",213,1,110,0)="change:  copies, renews and edits that create a new order. This patch will"
^DIC(9.4,60,22,13,"PAH",213,1,111,0)="store the SC answer for null SC percentage values."
^DIC(9.4,60,22,13,"PAH",213,1,112,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,113,0)="D.  The SC prompt was not asked in Computerized Patient Record System "
^DIC(9.4,60,22,13,"PAH",213,1,114,0)="(CPRS), but was asked in backdoor Outpatient Pharmacy. No default answer"
^DIC(9.4,60,22,13,"PAH",213,1,115,0)="was shown in backdoor due to the question not being asked in CRPS.  This"
^DIC(9.4,60,22,13,"PAH",213,1,116,0)="occurred for any SC percentage that the SDCO22 API (#1579) returned a"
^DIC(9.4,60,22,13,"PAH",213,1,117,0)="value that indicated to not ask the SC question but IB returned a flag"
^DIC(9.4,60,22,13,"PAH",213,1,118,0)="that indicated that the SC question should be asked.  This problem occurs"
^DIC(9.4,60,22,13,"PAH",213,1,119,0)="for a variety of SC percentages based on how the patient's eligibility is"
^DIC(9.4,60,22,13,"PAH",213,1,120,0)="defined in enrollment.  This patch will tell CPRS to ask SC for this"
^DIC(9.4,60,22,13,"PAH",213,1,121,0)="scenario."
^DIC(9.4,60,22,13,"PAH",213,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,123,0)="E.  It was found that edits made to SC and/or EI's during COMPLETE ORDERS"
^DIC(9.4,60,22,13,"PAH",213,1,124,0)="FROM OERR [PSO LMOE FINISH] option and the finish function in the PATIENT"
^DIC(9.4,60,22,13,"PAH",213,1,125,0)="PRESCRIPTION PROCESSING [PSO LM BACKDOOR ORDERS] option were not reflected"
^DIC(9.4,60,22,13,"PAH",213,1,126,0)="in CPRS.  With the CIDC patches, a new standardized segment was created to"
^DIC(9.4,60,22,13,"PAH",213,1,127,0)="pass SC, EI's and ICD-9 diagnosis codes and use of the old segment was"
^DIC(9.4,60,22,13,"PAH",213,1,128,0)="discontinued. When the CPRS CIDC switch is off, CPRS is looking at the old"
^DIC(9.4,60,22,13,"PAH",213,1,129,0)="segment for updated orders. This patch adds the functionality to send both"
^DIC(9.4,60,22,13,"PAH",213,1,130,0)="ZSC and ZCL segments."
^DIC(9.4,60,22,13,"PAH",213,1,131,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,132,0)="F.  When using the edit function in the PATIENT PRESCRIPTION PROCESSING"
^DIC(9.4,60,22,13,"PAH",213,1,133,0)="option [PSO LM BACKDOOR ORDERS], the total number of entries in the ICD"
^DIC(9.4,60,22,13,"PAH",213,1,134,0)="DIAGNOSIS multiple (#52311) was being defined as one number less than it"
^DIC(9.4,60,22,13,"PAH",213,1,135,0)="should have been.  For example, eight diagnosis codes entered but the "
^DIC(9.4,60,22,13,"PAH",213,1,136,0)="multiple shows seven as the total number of entries for the multiple.  The"
^DIC(9.4,60,22,13,"PAH",213,1,137,0)="diagnosis codes were displayed correctly to the user.  This patch will"
^DIC(9.4,60,22,13,"PAH",213,1,138,0)="store the correct number of entries when edits are performed."
^DIC(9.4,60,22,13,"PAH",213,1,139,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,140,0)="G.  The PSOHLNE3 API IA (#4666) was defining an activity log entry that "
^DIC(9.4,60,22,13,"PAH",213,1,141,0)="stated ""Clinical Indicators and SC/EI's were updated from a CPRS e-sig "
^DIC(9.4,60,22,13,"PAH",213,1,142,0)="edit..."" for all prescriptions passed through the API.  Also, it was "
^DIC(9.4,60,22,13,"PAH",213,1,143,0)="needlessly defining a copay activity log entry for supply items and"
^DIC(9.4,60,22,13,"PAH",213,1,144,0)="investigational drugs.   Last, it was storing a copay activity log entry"
^DIC(9.4,60,22,13,"PAH",213,1,145,0)="(copay to no copay) that was set erroneously when the provider edits"
^DIC(9.4,60,22,13,"PAH",213,1,146,0)="SC/EI's during sign of a verbal/telephone order leaving the prescription"
^DIC(9.4,60,22,13,"PAH",213,1,147,0)="as no copay.  This API is used to pass data from CPRS to OP when a verbal"
^DIC(9.4,60,22,13,"PAH",213,1,148,0)="or telephone order is signed in CPRS when the CPRS CIDC Switch is on.  "
^DIC(9.4,60,22,13,"PAH",213,1,149,0)="This patch limits the setting of the activity log to only those"
^DIC(9.4,60,22,13,"PAH",213,1,150,0)="prescriptions where SC, EI's and/or ICD's were changed during sign order."
^DIC(9.4,60,22,13,"PAH",213,1,151,0)="And, it eliminates setting the copay activity log for supply items and"
^DIC(9.4,60,22,13,"PAH",213,1,152,0)="investigational drugs as well as eliminating the erroneous ""copay to no "
^DIC(9.4,60,22,13,"PAH",213,1,153,0)="copay"" activity log entry."
^DIC(9.4,60,22,13,"PAH",213,1,154,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,155,0)="H.  The RESET COPAY STATUS/CANCEL CHARGES option [PSOCP RESET COPAY "
^DIC(9.4,60,22,13,"PAH",213,1,156,0)="STATUS] was overlaying the previously stored diagnosis code when storing"
^DIC(9.4,60,22,13,"PAH",213,1,157,0)="updated information.  Also, the default answer for SC was not being"
^DIC(9.4,60,22,13,"PAH",213,1,158,0)="displayed for SC<50% patients.  This patch corrects these issues."
^DIC(9.4,60,22,13,"PAH",213,1,159,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,160,0)="I.  When the CPRS CIDC switch is turned on, the B cross reference was "
^DIC(9.4,60,22,13,"PAH",213,1,161,0)="not being defined in the ICD DIAGNOSIS field (#311) in PENDING OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",213,1,162,0)="ORDERS file (#52.41).  For telephone/verbal orders signed in CPRS and "
^DIC(9.4,60,22,13,"PAH",213,1,163,0)="CPRS renewals, the B cross reference was not being defined in the ICD"
^DIC(9.4,60,22,13,"PAH",213,1,164,0)="DIAGNOSIS field (#52311) in PRESCRIPTION file (#52).  This was not"
^DIC(9.4,60,22,13,"PAH",213,1,165,0)="reported as an issue, but the correction is being made in this patch."
^DIC(9.4,60,22,13,"PAH",213,1,166,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,167,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,168,0)="Technical Descriptions:"
^DIC(9.4,60,22,13,"PAH",213,1,169,0)="======================="
^DIC(9.4,60,22,13,"PAH",213,1,170,0)="1.  For Remedy Ticket 130112:"
^DIC(9.4,60,22,13,"PAH",213,1,171,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,172,0)="A.  A snapshot of the ACTIVITY LOG sub-file (#40) and the COPAY "
^DIC(9.4,60,22,13,"PAH",213,1,173,0)="ACTIVITY LOG sub-file (#107) will be stored in ^XTMP(""PSOCIDC7"") node,"
^DIC(9.4,60,22,13,"PAH",213,1,174,0)="and will be available for 90 days."
^DIC(9.4,60,22,13,"PAH",213,1,175,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,176,0)="B.  The ""BKGD CIDC UPDATE"" activity log entry will be removed and the "
^DIC(9.4,60,22,13,"PAH",213,1,177,0)="ACTIVITY LOG sub-file (#40) will be re-subscripted to eliminate the"
^DIC(9.4,60,22,13,"PAH",213,1,178,0)="missing node. The removed entry will be inserted in the COPAY ACTIVITY LOG"
^DIC(9.4,60,22,13,"PAH",213,1,179,0)="sub-file (#107).  The date given in the old activity log entry will be"
^DIC(9.4,60,22,13,"PAH",213,1,180,0)="used as the COPAY ACTIVITY LOG field (#.01) for the new entry. The copay"
^DIC(9.4,60,22,13,"PAH",213,1,181,0)="activity log will be sorted by dates within the existing entries and"
^DIC(9.4,60,22,13,"PAH",213,1,182,0)="including the new entry, then they will be stored back into the COPAY"
^DIC(9.4,60,22,13,"PAH",213,1,183,0)="ACTIVITY LOG sub-file (#107). The comment for the new copay activity log"
^DIC(9.4,60,22,13,"PAH",213,1,184,0)="entry as well as any existing copay activity log entries will be changed"
^DIC(9.4,60,22,13,"PAH",213,1,185,0)="to state ""CIDC CLEANUP"" instead of ""BKGD CIDC UPDATE""."
^DIC(9.4,60,22,13,"PAH",213,1,186,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,187,0)="C.  Because the copay to no copay or vice versa information was not "
^DIC(9.4,60,22,13,"PAH",213,1,188,0)="recorded in the old Activity log entry, those values can only reflect the "
^DIC(9.4,60,22,13,"PAH",213,1,189,0)="current state of the prescription, and it's thought that they should not"
^DIC(9.4,60,22,13,"PAH",213,1,190,0)="be stored on the new entry."
^DIC(9.4,60,22,13,"PAH",213,1,191,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,192,0)="D.  To print the report of all prescriptions updated by the Clean-up "
^DIC(9.4,60,22,13,"PAH",213,1,193,0)="routine, type the following from the programmer's prompt using the print "
^DIC(9.4,60,22,13,"PAH",213,1,194,0)="device that you prefer."
^DIC(9.4,60,22,13,"PAH",213,1,195,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,196,0)="     >D RPT^PSOCIDC9"
^DIC(9.4,60,22,13,"PAH",213,1,197,0)="      DEVICE: HOME//     UCX/TELNET     RIGHT MARGIN:80//"
^DIC(9.4,60,22,13,"PAH",213,1,198,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,199,0)="    Patch PSO*7*239 - Corrected Activity and Copay Activity logs"
^DIC(9.4,60,22,13,"PAH",213,1,200,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,201,0)="     Note that this report reflects all prescriptions where the activity"
^DIC(9.4,60,22,13,"PAH",213,1,202,0)="     and/or copay activity logs were corrected. For detailed information,"
^DIC(9.4,60,22,13,"PAH",213,1,203,0)="     please view the activity and copay activity log on the prescription."
^DIC(9.4,60,22,13,"PAH",213,1,204,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,205,0)="     Date printed: MAR 6,2006@14:09:25                       Page: 1"
^DIC(9.4,60,22,13,"PAH",213,1,206,0)="     ==============================================================="
^DIC(9.4,60,22,13,"PAH",213,1,207,0)="     PATIENT NAME     (SSN)       DIV          RX# "
^DIC(9.4,60,22,13,"PAH",213,1,208,0)="     ---------------  -------  --------------  ------------"
^DIC(9.4,60,22,13,"PAH",213,1,209,0)="     PATIENT,ONE      (B3453)  TROY, NY        200037"
^DIC(9.4,60,22,13,"PAH",213,1,210,0)="     BPATIENT,TWO     (B0033)  TROY, NY        200049"
^DIC(9.4,60,22,13,"PAH",213,1,211,0)="     BPATIENT,TWO     (B0033)  TROY, NY        200050"
^DIC(9.4,60,22,13,"PAH",213,1,212,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,213,0)="E.  The following is an example of a status query for the Clean-up "
^DIC(9.4,60,22,13,"PAH",213,1,214,0)="routine, and it must be run from programmer's mode:"
^DIC(9.4,60,22,13,"PAH",213,1,215,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,216,0)="     >D STATUS^PSOCIDC7"
^DIC(9.4,60,22,13,"PAH",213,1,217,0)="    "
^DIC(9.4,60,22,13,"PAH",213,1,218,0)="      Currently processing:"
^DIC(9.4,60,22,13,"PAH",213,1,219,0)="            Date being processed > Nov 3, 2005"
^DIC(9.4,60,22,13,"PAH",213,1,220,0)="                            RX # > 1375666"
^DIC(9.4,60,22,13,"PAH",213,1,221,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,222,0)="F.  A stop function has been provided in case the system needs to be"
^DIC(9.4,60,22,13,"PAH",213,1,223,0)="shut down for an emergency or other reason.  Then when the system is back"
^DIC(9.4,60,22,13,"PAH",213,1,224,0)="up and you are ready you may restart the job, it will resume where it"
^DIC(9.4,60,22,13,"PAH",213,1,225,0)="left off.  You may restart by entering D ^PSOCIDC7 at the programmer's"
^DIC(9.4,60,22,13,"PAH",213,1,226,0)="prompt.  The following is an example:"
^DIC(9.4,60,22,13,"PAH",213,1,227,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,228,0)="     >D STOP^PSOCIDC7"
^DIC(9.4,60,22,13,"PAH",213,1,229,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,230,0)="      Outpatient Activity Logs Correction Job - set to STOP Soon"
^DIC(9.4,60,22,13,"PAH",213,1,231,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,232,0)="      Check Status to be sure it has stopped and is not running..."
^DIC(9.4,60,22,13,"PAH",213,1,233,0)="        "
^DIC(9.4,60,22,13,"PAH",213,1,234,0)="                   (D STATUS^PSOCIDC7)"
^DIC(9.4,60,22,13,"PAH",213,1,235,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,236,0)="G.  The Clean-up routine can be executed from the programmer's "
^DIC(9.4,60,22,13,"PAH",213,1,237,0)="prompt instead of through the patch installation.  Also, restarting the"
^DIC(9.4,60,22,13,"PAH",213,1,238,0)="Clean-up routine after using the stop function described above is "
^DIC(9.4,60,22,13,"PAH",213,1,239,0)="performed in the same manner.  Below is an example how to perform this "
^DIC(9.4,60,22,13,"PAH",213,1,240,0)="function:"
^DIC(9.4,60,22,13,"PAH",213,1,241,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,242,0)="     >D ^PSOCIDC7"
^DIC(9.4,60,22,13,"PAH",213,1,243,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,244,0)="     ****************** SELECT RUN OPTION ******************"
^DIC(9.4,60,22,13,"PAH",213,1,245,0)="     Do you want to run the activity logs correction process? Y or N// YES"
^DIC(9.4,60,22,13,"PAH",213,1,246,0)="     Enter when to Queue the CIDC ACTIVITY LOGS CORRECTION job to run in "
^DIC(9.4,60,22,13,"PAH",213,1,247,0)="     date@time format:  NOW//"
^DIC(9.4,60,22,13,"PAH",213,1,248,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,249,0)="     ==================================================="
^DIC(9.4,60,22,13,"PAH",213,1,250,0)="     Queuing background job for CIDC ACTIVITY LOGS CORRECTION..."
^DIC(9.4,60,22,13,"PAH",213,1,251,0)="     Start time: Month day, year@time"
^DIC(9.4,60,22,13,"PAH",213,1,252,0)="     ==================================================="
^DIC(9.4,60,22,13,"PAH",213,1,253,0)="     *** Task #NNNNN Queued! ***"
^DIC(9.4,60,22,13,"PAH",213,1,254,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,255,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,256,0)="2. The following correlates to the items described in number two in the"
^DIC(9.4,60,22,13,"PAH",213,1,257,0)="Functional Description section:"
^DIC(9.4,60,22,13,"PAH",213,1,258,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,259,0)="A. The renew process has been modified to store the changed value"
^DIC(9.4,60,22,13,"PAH",213,1,260,0)="for SC in the PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",213,1,261,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,262,0)="B. This patch will remove all of the functionality that stored the"
^DIC(9.4,60,22,13,"PAH",213,1,263,0)="unnecessary IBQ node."
^DIC(9.4,60,22,13,"PAH",213,1,264,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,265,0)="C.  Outpatient was modified to store the SC value for patients with a null"
^DIC(9.4,60,22,13,"PAH",213,1,266,0)="SC percentage which eliminates the sending of a ""PRESCRIPTION QUESTIONS"
^DIC(9.4,60,22,13,"PAH",213,1,267,0)="REVIEW NEEDED"" Mailman message."
^DIC(9.4,60,22,13,"PAH",213,1,268,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,269,0)="D.  The check for the PSOSCMX variable was restored to the PSOCP"
^DIC(9.4,60,22,13,"PAH",213,1,270,0)="routine.  "
^DIC(9.4,60,22,13,"PAH",213,1,271,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,272,0)="E.  This patch adds the functionality to send both ZSC and ZCL segments to"
^DIC(9.4,60,22,13,"PAH",213,1,273,0)="CPRS. The ZSC passes SC/EI's only.  The ZCL node passes SC, EI's, and"
^DIC(9.4,60,22,13,"PAH",213,1,274,0)="ICD-9 Diagnosis codes."
^DIC(9.4,60,22,13,"PAH",213,1,275,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,276,0)="F.  This patch will correctly store the third and fourth piece of the zero"
^DIC(9.4,60,22,13,"PAH",213,1,277,0)="node of the ICD DIAGNOSIS multiple (#52311) of PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",213,1,278,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,279,0)="G.  The PSOHLNE3 API IA (#4666) was changed to only store entries in the "
^DIC(9.4,60,22,13,"PAH",213,1,280,0)="ACTIVITY LOG multiple (#40) when SC, EI's, and/or ICD's were edited.  "
^DIC(9.4,60,22,13,"PAH",213,1,281,0)="For supply items and investigational drugs, no copay activity log entries "
^DIC(9.4,60,22,13,"PAH",213,1,282,0)="will be stored.  Also, it was modified to prevent storage of a copay"
^DIC(9.4,60,22,13,"PAH",213,1,283,0)="activity log entry (copay to no copay) that was set erroneously when the"
^DIC(9.4,60,22,13,"PAH",213,1,284,0)="provider edits SC/EI's during sign of a verbal/telephone order leaving the"
^DIC(9.4,60,22,13,"PAH",213,1,285,0)="prescription as no copay."
^DIC(9.4,60,22,13,"PAH",213,1,286,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,287,0)="H.  The RESET COPAY STATUS/CANCEL CHARGES [PSOCP RESET COPAY STATUS] "
^DIC(9.4,60,22,13,"PAH",213,1,288,0)="option has been modified to not overlay the previously stored "
^DIC(9.4,60,22,13,"PAH",213,1,289,0)="ICD-9 Diagnosis code with a null value and to display previously entered"
^DIC(9.4,60,22,13,"PAH",213,1,290,0)="SC values as a default answer."
^DIC(9.4,60,22,13,"PAH",213,1,291,0)=" "
^DIC(9.4,60,22,13,"PAH",213,1,292,0)="I.  The B cross reference will be set for the ICD DIAGNOSIS field (#311)"
^DIC(9.4,60,22,13,"PAH",213,1,293,0)="in PENDING OUTPATIENT ORDERS file (#52.41) and in the ICD DIAGNOSIS field"
^DIC(9.4,60,22,13,"PAH",213,1,294,0)="(#52311) in PRESCRIPTION file (#52) for CPRS renewals/verbal/telephone "
^DIC(9.4,60,22,13,"PAH",213,1,295,0)="orders."
^DIC(9.4,60,22,13,"PAH",214,0)="238 SEQ #220^3061122.223406^1"
^DIC(9.4,60,22,13,"PAH",214,1,0)="^^5^5^3061122"
^DIC(9.4,60,22,13,"PAH",214,1,1,0)="THIS PATCH WILL FIX TWO PROBLEMS."
^DIC(9.4,60,22,13,"PAH",214,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",214,1,3,0)="PROBLEM 1: AN ERROR OCCURS WHEN DISCONTINUING ALL PRESCRIPTIONS FOR A"
^DIC(9.4,60,22,13,"PAH",214,1,4,0)="PATIENT."
^DIC(9.4,60,22,13,"PAH",214,1,5,0)="PROBLEM 2: REINSTATED DRUG DOSAGES DISPLAY ON OTHER PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",215,0)="201 SEQ #221^3061122.2236^1"
^DIC(9.4,60,22,13,"PAH",215,1,0)="^^207^207^3061122"
^DIC(9.4,60,22,13,"PAH",215,1,1,0)="This Outpatient Pharmacy patch is part of the Patient Financial Services"
^DIC(9.4,60,22,13,"PAH",215,1,2,0)="System (PFSS) project.  PFSS patches are being released on various"
^DIC(9.4,60,22,13,"PAH",215,1,3,0)="schedules.  Some patch functionality will not be active until a new PFSS"
^DIC(9.4,60,22,13,"PAH",215,1,4,0)="switch is activated during final implementation. PFSS will initially be"
^DIC(9.4,60,22,13,"PAH",215,1,5,0)="implemented at select pilot sites ONLY."
^DIC(9.4,60,22,13,"PAH",215,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,7,0)="The purpose of the PFSS project is to prepare the Veterans Health "
^DIC(9.4,60,22,13,"PAH",215,1,8,0)="Information Systems and Technology Architecture (VistA) environment for"
^DIC(9.4,60,22,13,"PAH",215,1,9,0)="the implementation of a Commercial Off-The-Shelf (COTS) billing "
^DIC(9.4,60,22,13,"PAH",215,1,10,0)="replacement system.  The project consists of the implementation of the "
^DIC(9.4,60,22,13,"PAH",215,1,11,0)="billing replacement system, business process improvements, and "
^DIC(9.4,60,22,13,"PAH",215,1,12,0)="enhancements to VistA to support integration with the COTS billing"
^DIC(9.4,60,22,13,"PAH",215,1,13,0)="replacement system.  Significant changes to VistA legacy systems and "
^DIC(9.4,60,22,13,"PAH",215,1,14,0)="ancillary packages are necessary."
^DIC(9.4,60,22,13,"PAH",215,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,16,0)="Some of the PFSS software components are not operational until the PFSS "
^DIC(9.4,60,22,13,"PAH",215,1,17,0)="On/Off Switch, distributed with patch IB*2*260, is set to ""ON"".  The "
^DIC(9.4,60,22,13,"PAH",215,1,18,0)="ability for the local site to set the switch to ""ON"" will be provided at "
^DIC(9.4,60,22,13,"PAH",215,1,19,0)="the appropriate time with the release of a subsequent Integrated Billing "
^DIC(9.4,60,22,13,"PAH",215,1,20,0)="patch."
^DIC(9.4,60,22,13,"PAH",215,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,22,0)="For more information about the PFSS project, review the documentation "
^DIC(9.4,60,22,13,"PAH",215,1,23,0)="accompanying this patch and refer to the following website: "
^DIC(9.4,60,22,13,"PAH",215,1,24,0)="http://vista.domain.ext/billreplace/."
^DIC(9.4,60,22,13,"PAH",215,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,26,0)="This Outpatient Pharmacy patch, PSO*7*201 provides the functionality"
^DIC(9.4,60,22,13,"PAH",215,1,27,0)="needed to support the PFSS project.  Note that this patch depends on"
^DIC(9.4,60,22,13,"PAH",215,1,28,0)="patches PSN*4*103 and PSS*1*92 to provide the new Charge Description"
^DIC(9.4,60,22,13,"PAH",215,1,29,0)="Master (CDM) functionality.  The CDM provides Service Codes for each drug,"
^DIC(9.4,60,22,13,"PAH",215,1,30,0)="supply item, etc. to uniquely identify them to the new COTS billing"
^DIC(9.4,60,22,13,"PAH",215,1,31,0)="system.  This information is passed via IB Application Program Interface"
^DIC(9.4,60,22,13,"PAH",215,1,32,0)="(API) calls, which is explained in the Technical Description."
^DIC(9.4,60,22,13,"PAH",215,1,33,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,34,0)="Functional Description:"
^DIC(9.4,60,22,13,"PAH",215,1,35,0)="======================="
^DIC(9.4,60,22,13,"PAH",215,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,37,0)="Outpatient Pharmacy was modified to check the status of the PFSS "
^DIC(9.4,60,22,13,"PAH",215,1,38,0)="switch.  If the PFSS switch is not activated, the current Integrated "
^DIC(9.4,60,22,13,"PAH",215,1,39,0)="Billing (IB) billing process will continue.  If the PFSS switch is"
^DIC(9.4,60,22,13,"PAH",215,1,40,0)="activated, prescription and copay information will be passed to the new"
^DIC(9.4,60,22,13,"PAH",215,1,41,0)="COTS billing system for final copay assessments and billing via IB."
^DIC(9.4,60,22,13,"PAH",215,1,42,0)="As is currently the case with IB, the exchange of information will take"
^DIC(9.4,60,22,13,"PAH",215,1,43,0)="place in the background with no user impact."
^DIC(9.4,60,22,13,"PAH",215,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,45,0)="Upon entering a new prescription order, copying, renewing, or editing "
^DIC(9.4,60,22,13,"PAH",215,1,46,0)="an order that causes a new order to be created, a PFSS Account Reference"
^DIC(9.4,60,22,13,"PAH",215,1,47,0)="will be requested at finish from IB. This reference is used to uniquely"
^DIC(9.4,60,22,13,"PAH",215,1,48,0)="identify the prescription in the COTS billing system."
^DIC(9.4,60,22,13,"PAH",215,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,50,0)="At prescription release, a unique charge identifier will be requested "
^DIC(9.4,60,22,13,"PAH",215,1,51,0)="from IB, and it will serve to uniquely identify the fill in IB.  Next, a"
^DIC(9.4,60,22,13,"PAH",215,1,52,0)="charge message will be sent to the COTS billing system via IB.  This"
^DIC(9.4,60,22,13,"PAH",215,1,53,0)="includes the release of Consolidated Mail Outpatient Pharmacy (CMOP)"
^DIC(9.4,60,22,13,"PAH",215,1,54,0)="prescriptions and prescriptions released by the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",215,1,55,0)="Automation Interface (OPAI) functionality."
^DIC(9.4,60,22,13,"PAH",215,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,57,0)="For return to stocks, and deletes that perform a return to stock, a charge"
^DIC(9.4,60,22,13,"PAH",215,1,58,0)="credit message will be sent.  "
^DIC(9.4,60,22,13,"PAH",215,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,60,0)="When Service Connection and/or Environmental Indicators are modified"
^DIC(9.4,60,22,13,"PAH",215,1,61,0)="without a change in copay using the Reset Copay Status/Cancel Charges"
^DIC(9.4,60,22,13,"PAH",215,1,62,0)="[PSOCP RESET COPAY STATUS] option, a charge update message will be sent.  "
^DIC(9.4,60,22,13,"PAH",215,1,63,0)="A charge credit message will be sent when copay charges are cancelled.  "
^DIC(9.4,60,22,13,"PAH",215,1,64,0)="When the fill is changed to copay, no message will be sent because this"
^DIC(9.4,60,22,13,"PAH",215,1,65,0)="change is considered to be for the future fills."
^DIC(9.4,60,22,13,"PAH",215,1,66,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,67,0)="No messaging will take place for discontinued orders.  When a "
^DIC(9.4,60,22,13,"PAH",215,1,68,0)="discontinued order is reinstated, the previously obtained PFSS Account "
^DIC(9.4,60,22,13,"PAH",215,1,69,0)="Reference will be used."
^DIC(9.4,60,22,13,"PAH",215,1,70,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,71,0)="In order to maintain the display of the ""$"" sign on the Medication "
^DIC(9.4,60,22,13,"PAH",215,1,72,0)="Profile screen that indicates the prescription is eligible for copay, IB"
^DIC(9.4,60,22,13,"PAH",215,1,73,0)="will continue to be utilized for the copay eligibility assessment that is"
^DIC(9.4,60,22,13,"PAH",215,1,74,0)="performed at finish.  Also, the Outpatient Pharmacy and IB copay"
^DIC(9.4,60,22,13,"PAH",215,1,75,0)="evaluations performed at release for Service Connection, Environmental "
^DIC(9.4,60,22,13,"PAH",215,1,76,0)="Indicators, Drug Enforcement Agency (DEA) special handling (supply items"
^DIC(9.4,60,22,13,"PAH",215,1,77,0)="and investigational drugs), income exempt, and RX Patient Status checks"
^DIC(9.4,60,22,13,"PAH",215,1,78,0)="have not changed and will continue to be used.  However, the final copay"
^DIC(9.4,60,22,13,"PAH",215,1,79,0)="billing determination will be performed by the COTS billing system, and"
^DIC(9.4,60,22,13,"PAH",215,1,80,0)="the final decision is based on the above information, interfacility copay"
^DIC(9.4,60,22,13,"PAH",215,1,81,0)="information, and current IB billing rules.  There will be no return"
^DIC(9.4,60,22,13,"PAH",215,1,82,0)="messaging from the COTS billing system to Outpatient Pharmacy."
^DIC(9.4,60,22,13,"PAH",215,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,84,0)="When Days Supply is edited on a released prescription, a charge update"
^DIC(9.4,60,22,13,"PAH",215,1,85,0)="message will be sent to the COTS billing system, and it is understood that"
^DIC(9.4,60,22,13,"PAH",215,1,86,0)="the COTS billing system will pick up the latest charge update."
^DIC(9.4,60,22,13,"PAH",215,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,88,0)="Last, a new CHARGE LOCATION field (#1007) was added to the OUTPATIENT "
^DIC(9.4,60,22,13,"PAH",215,1,89,0)="SITE file (#59).  This field will be used by the COTS billing system "
^DIC(9.4,60,22,13,"PAH",215,1,90,0)="to group charges by division.  Upon installation and before the PFSS "
^DIC(9.4,60,22,13,"PAH",215,1,91,0)="switch is turned on, the user will need to enter an Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",215,1,92,0)="charge location in the HOSPITAL LOCATION file (#44), and afterward define"
^DIC(9.4,60,22,13,"PAH",215,1,93,0)="this location in the new CHARGE LOCATION field (#1007) in the OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",215,1,94,0)="SITE file (#59).  The Site Parameter Enter/Edit [PSO SITE PARAMETERS]"
^DIC(9.4,60,22,13,"PAH",215,1,95,0)="option may be used to define the CHARGE LOCATION in the OUTPATIENT "
^DIC(9.4,60,22,13,"PAH",215,1,96,0)="SITE file (#59).  A charge location should be defined for each division in"
^DIC(9.4,60,22,13,"PAH",215,1,97,0)="the OUTPATIENT SITE file (#59). It is suggested that this field be"
^DIC(9.4,60,22,13,"PAH",215,1,98,0)="coordinated with the Medical Center's billing office and the activation of"
^DIC(9.4,60,22,13,"PAH",215,1,99,0)="the PFSS functionality.  If at least one division has a CHARGE LOCATION"
^DIC(9.4,60,22,13,"PAH",215,1,100,0)="defined, that value will be passed to the COTS billing system for all "
^DIC(9.4,60,22,13,"PAH",215,1,101,0)="division having prescriptions filled. If the CHARGE LOCATION is not"
^DIC(9.4,60,22,13,"PAH",215,1,102,0)="defined for any division and the PFSS switch is turned on, the"
^DIC(9.4,60,22,13,"PAH",215,1,103,0)="prescription information will not pass to IB or the COTS billing system."
^DIC(9.4,60,22,13,"PAH",215,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,105,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,106,0)="Technical Description:"
^DIC(9.4,60,22,13,"PAH",215,1,107,0)="======================"
^DIC(9.4,60,22,13,"PAH",215,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,109,0)="At FINISH of the prescription fill:"
^DIC(9.4,60,22,13,"PAH",215,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,111,0)="1. The new IB API #4664 GETACCT^IBBAPI will be called to request a PFSS"
^DIC(9.4,60,22,13,"PAH",215,1,112,0)="ACCOUNT REFERENCE and it will be stored in the PRESCRIPTION file (#52) on"
^DIC(9.4,60,22,13,"PAH",215,1,113,0)="the fill level. For original fills, it will be stored in the PFSS ACCOUNT"
^DIC(9.4,60,22,13,"PAH",215,1,114,0)="REFERENCE field (#125), and for refills it will be stored in the PFSS"
^DIC(9.4,60,22,13,"PAH",215,1,115,0)="ACCOUNT REFERENCE field (#21). These references uniquely identify the"
^DIC(9.4,60,22,13,"PAH",215,1,116,0)="prescription to the COTS billing system."
^DIC(9.4,60,22,13,"PAH",215,1,117,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,118,0)="2. The array of data passed using the GETACCT^IBBAPI call encompasses all "
^DIC(9.4,60,22,13,"PAH",215,1,119,0)="of the minimum required data elements as stated in the PFSS SRS-SDD IBB "
^DIC(9.4,60,22,13,"PAH",215,1,120,0)="Generic API document.  The following outlines data passed from "
^DIC(9.4,60,22,13,"PAH",215,1,121,0)="Outpatient Pharmacy:"
^DIC(9.4,60,22,13,"PAH",215,1,122,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,123,0)="  $$GETACCT^IBBAPI(VAR1,VAR2,VAR3,VAR4,.ARR1,,,.ARR4,.ARR5,VAR5,,)"
^DIC(9.4,60,22,13,"PAH",215,1,124,0)="    Where:  "
^DIC(9.4,60,22,13,"PAH",215,1,125,0)="      VAR1 = Patient Identifier (Patient IEN)  "
^DIC(9.4,60,22,13,"PAH",215,1,126,0)="      VAR2 = PFSS Account Reference  "
^DIC(9.4,60,22,13,"PAH",215,1,127,0)="      VAR3 = HL7 Event Code          "
^DIC(9.4,60,22,13,"PAH",215,1,128,0)="      VAR4 = Application Location Reference"
^DIC(9.4,60,22,13,"PAH",215,1,129,0)="      ARR1 = ARR1(2) Patient Class, ARR1(3) Patient Location,"
^DIC(9.4,60,22,13,"PAH",215,1,130,0)="                  ARR1(7) Attending Physician, ARR1(44) Admit "
^DIC(9.4,60,22,13,"PAH",215,1,131,0)="                  Date/Time (Fill Date), ARR1(50) Alternant Visit"
^DIC(9.4,60,22,13,"PAH",215,1,132,0)="                  ID (Prescription IEN)"
^DIC(9.4,60,22,13,"PAH",215,1,133,0)="      ARR4 = ARR4(n,3) Diagnoses Code, ARR4(n,6) Diagnosis Type "
^DIC(9.4,60,22,13,"PAH",215,1,134,0)="      ARR5 = ARR5(n,2) Type"
^DIC(9.4,60,22,13,"PAH",215,1,135,0)="      VAR5 = Medical Center Division"
^DIC(9.4,60,22,13,"PAH",215,1,136,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,137,0)="3. After IB returns the PFSS ACCOUNT REFERENCE to Outpatient Pharmacy,"
^DIC(9.4,60,22,13,"PAH",215,1,138,0)="IB will pass the GETACCT information to the COTS billing system via the"
^DIC(9.4,60,22,13,"PAH",215,1,139,0)="VistA Data Extraction Framework (VDEF) and will store the returned PFSS"
^DIC(9.4,60,22,13,"PAH",215,1,140,0)="Account Number external value in the PFSS ACCOUNT file (#375)."
^DIC(9.4,60,22,13,"PAH",215,1,141,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,142,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,143,0)="At RELEASE of the prescription fill:"
^DIC(9.4,60,22,13,"PAH",215,1,144,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,145,0)="1. The new IB API # 4665 GETCHGID^IBBAPI will be called to request a PFSS"
^DIC(9.4,60,22,13,"PAH",215,1,146,0)="CHARGE ID.  This information is used to uniquely identify the fill in the"
^DIC(9.4,60,22,13,"PAH",215,1,147,0)="IB and will be stored in Prescription file (#52) on the fill level. For"
^DIC(9.4,60,22,13,"PAH",215,1,148,0)="original fills, it will be stored in the PFSS CHARGE ID field (#126), and"
^DIC(9.4,60,22,13,"PAH",215,1,149,0)="for refills it will be stored in the PFSS CHARGE ID field (#22).  No data"
^DIC(9.4,60,22,13,"PAH",215,1,150,0)="is passed using this API."
^DIC(9.4,60,22,13,"PAH",215,1,151,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,152,0)="2. Next, the new IB API #4665 CHARGE^IBBAPI will be called to pass"
^DIC(9.4,60,22,13,"PAH",215,1,153,0)="prescription and copay information.  This information will be stored in"
^DIC(9.4,60,22,13,"PAH",215,1,154,0)="the PFSS CHARGE CACHE file (#373).  IB will batch the charge information"
^DIC(9.4,60,22,13,"PAH",215,1,155,0)="and pass it on to the COTS billing system via VDEF."
^DIC(9.4,60,22,13,"PAH",215,1,156,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,157,0)="3. The array of data passed using the CHARGE^IBBAPI call encompasses all "
^DIC(9.4,60,22,13,"PAH",215,1,158,0)="of the minimum required data elements as stated in the PFSS SRS-SDD IBB "
^DIC(9.4,60,22,13,"PAH",215,1,159,0)="Generic API document.  The following outlines data passed from Outpatient"
^DIC(9.4,60,22,13,"PAH",215,1,160,0)="Pharmacy:"
^DIC(9.4,60,22,13,"PAH",215,1,161,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,162,0)="     $$CHARGE^IBBAPI(VAR1,VAR2,VAR3,VAR4,.ARR1,,.ARR3,.ARR4,.ARR5,,,)"
^DIC(9.4,60,22,13,"PAH",215,1,163,0)="       Where:"
^DIC(9.4,60,22,13,"PAH",215,1,164,0)="         VAR1 = Patient Identifier (Patient IEN)              "
^DIC(9.4,60,22,13,"PAH",215,1,165,0)="         VAR2 = PFSS Account Reference  "
^DIC(9.4,60,22,13,"PAH",215,1,166,0)="         VAR3 = Charge Type               "
^DIC(9.4,60,22,13,"PAH",215,1,167,0)="         VAR4 = Unique Charge ID (PFSS Charge ID)"
^DIC(9.4,60,22,13,"PAH",215,1,168,0)="         ARR1 = ARR1(4) Transaction Date (Fill Date), ARR1(7) Transaction"
^DIC(9.4,60,22,13,"PAH",215,1,169,0)="                  Code, ARR1(10) Transaction Quantity, ARR1(13) Department"
^DIC(9.4,60,22,13,"PAH",215,1,170,0)="                  Code, ARR1(18) Patient Copay Status, ARR1(21) Ordered by"
^DIC(9.4,60,22,13,"PAH",215,1,171,0)="                  Code, ARR1(22) Unit Cost, ARR1(29) NDC_"";""_Generic"
^DIC(9.4,60,22,13,"PAH",215,1,172,0)="                  Name, ARR1(31) Copay Transaction Type"
^DIC(9.4,60,22,13,"PAH",215,1,173,0)="         ARR3 = ARR3(n,3) Diagnoses Code, ARR3(n,6) Diagnosis Type"
^DIC(9.4,60,22,13,"PAH",215,1,174,0)="         ARR4 = ARR4(n,2) Type"
^DIC(9.4,60,22,13,"PAH",215,1,175,0)="         ARR5 = ARR5(1) Quantity_"";;""_Days Supply, ARR5(17) Refills "
^DIC(9.4,60,22,13,"PAH",215,1,176,0)="                  Dispensed (Fill Number), ARR5(18) Date of Most Recent"
^DIC(9.4,60,22,13,"PAH",215,1,177,0)="                  Fill (Release Date), ARR5(31) DEA, Special Handling"
^DIC(9.4,60,22,13,"PAH",215,1,178,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,179,0)="4. There will be no return messaging from the COTS billing system to "
^DIC(9.4,60,22,13,"PAH",215,1,180,0)="Outpatient Pharmacy.  Note that IB will combine the data passed in the"
^DIC(9.4,60,22,13,"PAH",215,1,181,0)="GETACCT and CHARGE APIs to form the charge message that will ultimately"
^DIC(9.4,60,22,13,"PAH",215,1,182,0)="be passed to the COTS billing system via VDEF."
^DIC(9.4,60,22,13,"PAH",215,1,183,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,184,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,185,0)="CHARGE LOCATION additions:"
^DIC(9.4,60,22,13,"PAH",215,1,186,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,187,0)="1. In the OUTPATIENT SITE file (#59), a new CHARGE LOCATION field "
^DIC(9.4,60,22,13,"PAH",215,1,188,0)="(#1007) was added, and this field is a pointer to HOSPITAL LOCATION file "
^DIC(9.4,60,22,13,"PAH",215,1,189,0)="(#44)."
^DIC(9.4,60,22,13,"PAH",215,1,190,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,191,0)="2. The Site Parameter Enter/Edit [PSO SITE PARAMETERS] option input"
^DIC(9.4,60,22,13,"PAH",215,1,192,0)="template PSO SITE was modified to accommodate entry of the new CHARGE"
^DIC(9.4,60,22,13,"PAH",215,1,193,0)="LOCATION field (#1007)."
^DIC(9.4,60,22,13,"PAH",215,1,194,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,195,0)="3. If a CHARGE LOCATION is not defined for a particular division, the "
^DIC(9.4,60,22,13,"PAH",215,1,196,0)="system will loop through all divisions in the OUTPATIENT SITE file (#59) "
^DIC(9.4,60,22,13,"PAH",215,1,197,0)="and will use the first CHARGE LOCATION it finds.  When none of the"
^DIC(9.4,60,22,13,"PAH",215,1,198,0)="divisions have a CHARGE LOCATION defined, the prescription will not be "
^DIC(9.4,60,22,13,"PAH",215,1,199,0)="passed to IB or the COTS billing system.  This issue will be addressed in"
^DIC(9.4,60,22,13,"PAH",215,1,200,0)="a subsequent phase of the PFSS project.  Until that time, it is imperative"
^DIC(9.4,60,22,13,"PAH",215,1,201,0)="that CHARGE LOCATION are defined for each division."
^DIC(9.4,60,22,13,"PAH",215,1,202,0)=" "
^DIC(9.4,60,22,13,"PAH",215,1,203,0)="The Integration Agreement (IA) #4732 was created to facilitate "
^DIC(9.4,60,22,13,"PAH",215,1,204,0)="modifications being made by IB for interfacility copay.  It will be used "
^DIC(9.4,60,22,13,"PAH",215,1,205,0)="in the background to return the pharmacist, person who last edited the "
^DIC(9.4,60,22,13,"PAH",215,1,206,0)="prescription fill, and the value of the IB SERVICE/SECTION field (#1003) "
^DIC(9.4,60,22,13,"PAH",215,1,207,0)="from the OUTPATIENT SITE file (#59)."
^DIC(9.4,60,22,13,"PAH",216,0)="245 SEQ #222^3061122.234429^1"
^DIC(9.4,60,22,13,"PAH",216,1,0)="^^30^30^3061122"
^DIC(9.4,60,22,13,"PAH",216,1,1,0)="This patch adds three new Outpatient Pharmacy Application Programming"
^DIC(9.4,60,22,13,"PAH",216,1,2,0)="Interfaces (APIs)."
^DIC(9.4,60,22,13,"PAH",216,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",216,1,4,0)="The first API (DIQ) requires five parameters to be passed in and data"
^DIC(9.4,60,22,13,"PAH",216,1,5,0)="from the PRESCRIPTION file (#52) will be returned.  This API will invoke"
^DIC(9.4,60,22,13,"PAH",216,1,6,0)="the EN^DIQ1 FileMan call and data will be returned to the calling"
^DIC(9.4,60,22,13,"PAH",216,1,7,0)="application as specified in the EN^DIQ1 FileMan documentation."
^DIC(9.4,60,22,13,"PAH",216,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",216,1,9,0)="The second API (STATUS) requires three parameters to be passed in and data"
^DIC(9.4,60,22,13,"PAH",216,1,10,0)="from the STATUS field (#100) from the PRESCRIPTION file (#52) is"
^DIC(9.4,60,22,13,"PAH",216,1,11,0)="returned.  This API will invoke the FIELD^DID FileMan call and data will"
^DIC(9.4,60,22,13,"PAH",216,1,12,0)="be returned to the calling application as specified in the FIELD^DID"
^DIC(9.4,60,22,13,"PAH",216,1,13,0)="FileMan documentation."
^DIC(9.4,60,22,13,"PAH",216,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",216,1,15,0)="The third API (DIC) has three parameters and retrieves information "
^DIC(9.4,60,22,13,"PAH",216,1,16,0)="specific to the PRESCRIPTION file (#52).  This API will invoke the ^DIC "
^DIC(9.4,60,22,13,"PAH",216,1,17,0)="FileMan call and data will be returned to the calling application as "
^DIC(9.4,60,22,13,"PAH",216,1,18,0)="specified in the ^DIC FileMan documentation."
^DIC(9.4,60,22,13,"PAH",216,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",216,1,20,0)="For more information, please see Forum DBIA 4858, or the Pharmacy"
^DIC(9.4,60,22,13,"PAH",216,1,21,0)="Re-Engineering (PRE) API Manual."
^DIC(9.4,60,22,13,"PAH",216,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",216,1,23,0)="This patch also corrects a problem with the PROF^PSO52API API.  The first"
^DIC(9.4,60,22,13,"PAH",216,1,24,0)="node of data returned is meant to return both the PRESCRIPTION NUMBER and"
^DIC(9.4,60,22,13,"PAH",216,1,25,0)="it's IEN.  Currently, the IEN is not returned.  This patch will correct"
^DIC(9.4,60,22,13,"PAH",216,1,26,0)="the problem."
^DIC(9.4,60,22,13,"PAH",216,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",216,1,28,0)="This patch also corrects a problem with the PSO^PSO53 API.  Currently "
^DIC(9.4,60,22,13,"PAH",216,1,29,0)="there is an undefined error when the API is run.  This patch will correct "
^DIC(9.4,60,22,13,"PAH",216,1,30,0)="the problem and ensure the functionality of the PSO^PSO53 API call."
^DIC(9.4,60,22,13,"PAH",217,0)="253 SEQ #223^3061227.142805^1"
^DIC(9.4,60,22,13,"PAH",217,1,0)="^^9^9^3061227"
^DIC(9.4,60,22,13,"PAH",217,1,1,0)="1) HD149502 - Patient instructions from the first patient will incorrectly"
^DIC(9.4,60,22,13,"PAH",217,1,2,0)="display for the second patient when you are about to delete the patient"
^DIC(9.4,60,22,13,"PAH",217,1,3,0)="instructions for the second patient."
^DIC(9.4,60,22,13,"PAH",217,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",217,1,5,0)="2) HD147655 - Reinstate Issue:"
^DIC(9.4,60,22,13,"PAH",217,1,6,0)="When you have 2 Clozapine drugs ordered, one as active and one as "
^DIC(9.4,60,22,13,"PAH",217,1,7,0)="discontinued, you wish to reinstate the discontinued drug.  At this point "
^DIC(9.4,60,22,13,"PAH",217,1,8,0)="the active drug will incorrectly become discontinued when you have "
^DIC(9.4,60,22,13,"PAH",217,1,9,0)="decided to ""^"" out of the application."
^DIC(9.4,60,22,13,"PAH",218,0)="250 SEQ #224^3061227.144115^1"
^DIC(9.4,60,22,13,"PAH",218,1,0)="^^110^110^3061227"
^DIC(9.4,60,22,13,"PAH",218,1,1,0)="This patch will produce a tally report in the form of a Mailman message "
^DIC(9.4,60,22,13,"PAH",218,1,2,0)="for all prescriptions with missing expiration dates and prescriptions that"
^DIC(9.4,60,22,13,"PAH",218,1,3,0)="are past their expiration dates but have an active status.  It also "
^DIC(9.4,60,22,13,"PAH",218,1,4,0)="contains corrections for two remedy tickets."
^DIC(9.4,60,22,13,"PAH",218,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,6,0)="1.  The tally report will be sent to the person who installs the patch at "
^DIC(9.4,60,22,13,"PAH",218,1,7,0)="the site and to management on FORUM via the MailMan utility. It will be"
^DIC(9.4,60,22,13,"PAH",218,1,8,0)="used to determine if a national patch needs to be created for correcting"
^DIC(9.4,60,22,13,"PAH",218,1,9,0)="this issue."
^DIC(9.4,60,22,13,"PAH",218,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,11,0)="During installation of this patch, the user may select to run the tally "
^DIC(9.4,60,22,13,"PAH",218,1,12,0)="immediately or queue it to run at a later date and time. Should it be "
^DIC(9.4,60,22,13,"PAH",218,1,13,0)="necessary to stop the job for emergency or to know the status of the job,"
^DIC(9.4,60,22,13,"PAH",218,1,14,0)="a status and stop function is provided."
^DIC(9.4,60,22,13,"PAH",218,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,16,0)="To stop the job, log into programmer's mode and type the D STOP^PSOTEXP1 "
^DIC(9.4,60,22,13,"PAH",218,1,17,0)="at the command prompt.  The following is an example:"
^DIC(9.4,60,22,13,"PAH",218,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,19,0)="     >D STOP^PSOTEXP1                "
^DIC(9.4,60,22,13,"PAH",218,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,21,0)="     TALLY MISSING EXPIRATION DATES Job - set to STOP Soon"
^DIC(9.4,60,22,13,"PAH",218,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,23,0)="     Check Status to be sure it has stopped and is not running..."
^DIC(9.4,60,22,13,"PAH",218,1,24,0)="          (D STATUS^PSOTEXP1)"
^DIC(9.4,60,22,13,"PAH",218,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,26,0)="To check the status of the TALLY MISSING EXPIRATION DATES job, log "
^DIC(9.4,60,22,13,"PAH",218,1,27,0)="into programmer's mode and type D STATUS^PSOTEXP1 at the command prompt.  "
^DIC(9.4,60,22,13,"PAH",218,1,28,0)="The following is an example:"
^DIC(9.4,60,22,13,"PAH",218,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,30,0)="     >D STATUS^PSOTEXP1              "
^DIC(9.4,60,22,13,"PAH",218,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,32,0)="     Currently processing:"
^DIC(9.4,60,22,13,"PAH",218,1,33,0)="     Date being processed > Dec 09, 2005"
^DIC(9.4,60,22,13,"PAH",218,1,34,0)="                     RX # > 3011493"
^DIC(9.4,60,22,13,"PAH",218,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,36,0)="To restart the job, the patch must be re-installed."
^DIC(9.4,60,22,13,"PAH",218,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,38,0)="The following is an example of the MailMan message that will be sent to"
^DIC(9.4,60,22,13,"PAH",218,1,39,0)="management and the user who installs the patch:"
^DIC(9.4,60,22,13,"PAH",218,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,41,0)="Subj: Outpatient Pharmacy PSO*7*250 TALLY MISSING EXPIRATION DATES"
^DIC(9.4,60,22,13,"PAH",218,1,42,0)="[#144218]"
^DIC(9.4,60,22,13,"PAH",218,1,43,0)="10/25/06@09:55  12 lines"
^DIC(9.4,60,22,13,"PAH",218,1,44,0)="From: PSO*7*250 TALLY MISSING EXPIRATION DATES  In 'IN' basket.   Page 1  "
^DIC(9.4,60,22,13,"PAH",218,1,45,0)="*New*"
^DIC(9.4,60,22,13,"PAH",218,1,46,0)="------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",218,1,47,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,48,0)="The TALLY MISSING EXPIRATION DATES job for the Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",218,1,49,0)="patch (PSO*7*250) started OCT 25, 2006@09:55:22"
^DIC(9.4,60,22,13,"PAH",218,1,50,0)="and completed OCT 25, 2006@09:55:27."
^DIC(9.4,60,22,13,"PAH",218,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,52,0)="Excel comma delimited data below, five headings, one data line"
^DIC(9.4,60,22,13,"PAH",218,1,53,0)="Note that an institution of 999999999 denotes one was not found during "
^DIC(9.4,60,22,13,"PAH",218,1,54,0)="run."
^DIC(9.4,60,22,13,"PAH",218,1,55,0)=",,,,,,Total Active Rx's"
^DIC(9.4,60,22,13,"PAH",218,1,56,0)=",Before v7 Install,Before v7 Install,After v7 Install,After v7 "
^DIC(9.4,60,22,13,"PAH",218,1,57,0)="Install,,With"
^DIC(9.4,60,22,13,"PAH",218,1,58,0)=",Tot Active Rx's,Tot Inactive,Tot Active,Tot Inactive,Total "
^DIC(9.4,60,22,13,"PAH",218,1,59,0)="Rx's,Expiration"
^DIC(9.4,60,22,13,"PAH",218,1,60,0)=",Missing Expired,Rx's Missing,Rx's Missing,Rx's Missing,Missing,Date of "
^DIC(9.4,60,22,13,"PAH",218,1,61,0)="T-1"
^DIC(9.4,60,22,13,"PAH",218,1,62,0)="Institution,Date,Expired Date,Expired Date,Expired Date,Expired Date,Day"
^DIC(9.4,60,22,13,"PAH",218,1,63,0)="500,1,4,1,2,8,340                                                         "
^DIC(9.4,60,22,13,"PAH",218,1,64,0)="    "
^DIC(9.4,60,22,13,"PAH",218,1,65,0)="Enter message action (in IN basket): Ignore//"
^DIC(9.4,60,22,13,"PAH",218,1,66,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,67,0)="2.  Remedy tickets 166505 and 166485 related to patch PSO*7*239:"
^DIC(9.4,60,22,13,"PAH",218,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,69,0)="A.  It was reported that for two sites the CIDC Activity Log Clean-up"
^DIC(9.4,60,22,13,"PAH",218,1,70,0)="process did not complete, no error was recorded, and no MailMan message"
^DIC(9.4,60,22,13,"PAH",218,1,71,0)="was received stating the job completed.  It was found that the problem"
^DIC(9.4,60,22,13,"PAH",218,1,72,0)="resulted from a prescription being locked by another process for an"
^DIC(9.4,60,22,13,"PAH",218,1,73,0)="extended amount of time which resulted in the CIDC Clean-up process"
^DIC(9.4,60,22,13,"PAH",218,1,74,0)="stopping.  For consistency in the routines at all sites, the modification"
^DIC(9.4,60,22,13,"PAH",218,1,75,0)="to correct this issue is being included in this patch.  If your site "
^DIC(9.4,60,22,13,"PAH",218,1,76,0)="received the MailMan message stating that the CIDC ACTIVITY LOGS "
^DIC(9.4,60,22,13,"PAH",218,1,77,0)="CORRECTION job completed, no action should be taken.  Otherwise after "
^DIC(9.4,60,22,13,"PAH",218,1,78,0)="installation of this patch, run the CIDC Clean-up routine from"
^DIC(9.4,60,22,13,"PAH",218,1,79,0)="programmer's mode to complete the process:"
^DIC(9.4,60,22,13,"PAH",218,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,81,0)="    >D ^PSOCIDC7"
^DIC(9.4,60,22,13,"PAH",218,1,82,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,83,0)="The clean-up routine will store any prescription that cannot be locked"
^DIC(9.4,60,22,13,"PAH",218,1,84,0)="for correction.  The completion mailman message was modified to notate "
^DIC(9.4,60,22,13,"PAH",218,1,85,0)="whether such problems occurred.  If there is not a notation stating "
^DIC(9.4,60,22,13,"PAH",218,1,86,0)="prescriptions were locked, no further action is needed.  Otherwise "
^DIC(9.4,60,22,13,"PAH",218,1,87,0)="from the programmer's prompt type the following to print a report:"
^DIC(9.4,60,22,13,"PAH",218,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,89,0)="    >D LOCKED^PSOCIDC9"
^DIC(9.4,60,22,13,"PAH",218,1,90,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,91,0)="The prescriptions on the locked prescription report may be individually "
^DIC(9.4,60,22,13,"PAH",218,1,92,0)="corrected manually by typing the following at the programmer's prompt:"
^DIC(9.4,60,22,13,"PAH",218,1,93,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,94,0)="    >D FIXONE^PSOCIDC9"
^DIC(9.4,60,22,13,"PAH",218,1,95,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,96,0)="The prescription number will be prompted, and a message stating that the"
^DIC(9.4,60,22,13,"PAH",218,1,97,0)="activity logs were corrected will be displayed.  If the manual clean-up"
^DIC(9.4,60,22,13,"PAH",218,1,98,0)="process still cannot lock the prescription in order to correct the"
^DIC(9.4,60,22,13,"PAH",218,1,99,0)="activity logs, a message stating such will be displayed.  Otherwise, a"
^DIC(9.4,60,22,13,"PAH",218,1,100,0)="message will be displayed that no corrections are needed.  Each"
^DIC(9.4,60,22,13,"PAH",218,1,101,0)="prescription completed is notated as such and reprinting the"
^DIC(9.4,60,22,13,"PAH",218,1,102,0)="LOCKED^PSOCIDC9 report will show ""completed"" after each one."
^DIC(9.4,60,22,13,"PAH",218,1,103,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,104,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,105,0)="B.  It was reported that an error occurred when the RPT^PSOCIDC9 report"
^DIC(9.4,60,22,13,"PAH",218,1,106,0)="was queued to a printer.  This patch corrects the queuing of the report to"
^DIC(9.4,60,22,13,"PAH",218,1,107,0)="a printer.  To generate the report of all prescriptions affected by the"
^DIC(9.4,60,22,13,"PAH",218,1,108,0)="clean-up process, enter the following at the programmer's prompt:"
^DIC(9.4,60,22,13,"PAH",218,1,109,0)=" "
^DIC(9.4,60,22,13,"PAH",218,1,110,0)="    >D RPT^PSOCIDC9"
^DIC(9.4,60,22,13,"PAH",219,0)="258 SEQ #225^3061227.144639^1"
^DIC(9.4,60,22,13,"PAH",219,1,0)="^^68^68^3061227"
^DIC(9.4,60,22,13,"PAH",219,1,1,0)="This patch contains the first quarter enhancements for the Outpatient"
^DIC(9.4,60,22,13,"PAH",219,1,2,0)="Pharmacy V. 7.0 package. It provides the following updates to"
^DIC(9.4,60,22,13,"PAH",219,1,3,0)="functionality:"
^DIC(9.4,60,22,13,"PAH",219,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,5,0)="1. The Action Profile (132 COLUMN PRINTOUT) [PSO ACTION PROFILE] option is"
^DIC(9.4,60,22,13,"PAH",219,1,6,0)="modified to provide the following functionality:"
^DIC(9.4,60,22,13,"PAH",219,1,7,0)="   a. It will print only the last 4 digits of the Social Security Number"
^DIC(9.4,60,22,13,"PAH",219,1,8,0)="      (SSN) instead of the full 9 digits."
^DIC(9.4,60,22,13,"PAH",219,1,9,0)="   b. The Prescription status of ""Suspended"" will now print as"
^DIC(9.4,60,22,13,"PAH",219,1,10,0)="      ""Active/Susp"". This change is also shared with the Application"
^DIC(9.4,60,22,13,"PAH",219,1,11,0)="      Program Interface (API) number 1281, provided to Computerized"
^DIC(9.4,60,22,13,"PAH",219,1,12,0)="      Patient Record System (CPRS) V. 1.0 to return ""Active/Susp"" instead"
^DIC(9.4,60,22,13,"PAH",219,1,13,0)="      of ""Suspended""."
^DIC(9.4,60,22,13,"PAH",219,1,14,0)="   c. As a result of the installation of patch PSO*7*233, if a bad address"
^DIC(9.4,60,22,13,"PAH",219,1,15,0)="      is indicated, ""BAD ADDRESS INDICATED-"" followed by the reason"
^DIC(9.4,60,22,13,"PAH",219,1,16,0)="      (""UNDELIVERABLE"", ""HOMELESS"", or ""OTHER"") was being printed. Once"
^DIC(9.4,60,22,13,"PAH",219,1,17,0)="      PSO*7*258 is installed, ""**BAD ADDRESS INDICATED**"" will be printed"
^DIC(9.4,60,22,13,"PAH",219,1,18,0)="      but will not be followed by the reason."
^DIC(9.4,60,22,13,"PAH",219,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,20,0)="2. The Medication Profile [PSO P] option will now print the last 4 digits"
^DIC(9.4,60,22,13,"PAH",219,1,21,0)="of the SSN instead of the full 9 digits."
^DIC(9.4,60,22,13,"PAH",219,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,23,0)="3. When finishing a pending order using the Patient Prescription"
^DIC(9.4,60,22,13,"PAH",219,1,24,0)="Processing [PSO LM BACKDOOR ORDERS] option or using the Complete Orders"
^DIC(9.4,60,22,13,"PAH",219,1,25,0)="from OERR [PSO LMOE FINISH] option, the following changes were"
^DIC(9.4,60,22,13,"PAH",219,1,26,0)="made:"
^DIC(9.4,60,22,13,"PAH",219,1,27,0)="   a. The provider comments are displayed in the first screen. When the"
^DIC(9.4,60,22,13,"PAH",219,1,28,0)="      following prompt is displayed:"
^DIC(9.4,60,22,13,"PAH",219,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,30,0)="      Copy Provider Comments into the Patient Instructions? No//"
^DIC(9.4,60,22,13,"PAH",219,1,31,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,32,0)="      the user has to scroll the screen up to know what the provider"
^DIC(9.4,60,22,13,"PAH",219,1,33,0)="      comments are. To avoid this problem, the provider comments are"
^DIC(9.4,60,22,13,"PAH",219,1,34,0)="      displayed along with this prompt."
^DIC(9.4,60,22,13,"PAH",219,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,36,0)="   b. A problem was reported with the calculated quantity for the drug"
^DIC(9.4,60,22,13,"PAH",219,1,37,0)="      Clozapine. A patient safety incident (PSI-06-146) was entered. The"
^DIC(9.4,60,22,13,"PAH",219,1,38,0)="      solution provided is as follows:"
^DIC(9.4,60,22,13,"PAH",219,1,39,0)="      If the drug has possible dosages defined, a quantity can be"
^DIC(9.4,60,22,13,"PAH",219,1,40,0)="      calculated. If this quantity is less than the quantity placed in"
^DIC(9.4,60,22,13,"PAH",219,1,41,0)="      CPRS, the calculated quantity will be displayed. Otherwise, the"
^DIC(9.4,60,22,13,"PAH",219,1,42,0)="      quantity placed in CPRS will be displayed. If there are no possible"
^DIC(9.4,60,22,13,"PAH",219,1,43,0)="      dosages defined then a quantity cannot be calculated and the message"
^DIC(9.4,60,22,13,"PAH",219,1,44,0)="      ""Unable to calculate the quantity, enter a quantity"" is displayed to"
^DIC(9.4,60,22,13,"PAH",219,1,45,0)="      the user in the ListMan message bar as a warning of a possible"
^DIC(9.4,60,22,13,"PAH",219,1,46,0)="      quantity issue. For Clozapine orders, since Outpatient Pharmacy"
^DIC(9.4,60,22,13,"PAH",219,1,47,0)="      might change the days supply and quantity placed in CPRS, the days"
^DIC(9.4,60,22,13,"PAH",219,1,48,0)="      supply and quantity have been added to the existing refill message."
^DIC(9.4,60,22,13,"PAH",219,1,49,0)="      Here is an example of an order placed in CPRS with a days supply"
^DIC(9.4,60,22,13,"PAH",219,1,50,0)="      of 60 and a quantity of 60 for a patient eligible for 28 days"
^DIC(9.4,60,22,13,"PAH",219,1,51,0)="      supply:"
^DIC(9.4,60,22,13,"PAH",219,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,53,0)="      (6)     Issue Date: OCT 26,2006        (7) Fill Date: OCT 27,2006"
^DIC(9.4,60,22,13,"PAH",219,1,54,0)="     Patient Eligible for 28 Day Sup. or 14 Day with 1 refill or 7 Day"
^DIC(9.4,60,22,13,"PAH",219,1,55,0)="     with 3 refill"
^DIC(9.4,60,22,13,"PAH",219,1,56,0)="      (8)    Days Supply: 28                (9)   QTY (TAB): 28"
^DIC(9.4,60,22,13,"PAH",219,1,57,0)="            Provider ordered 0 refills, days supply of 60 and a qty of 60"
^DIC(9.4,60,22,13,"PAH",219,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,60,0)="4. After the release of patch PSO*7*233 some issues were identified and"
^DIC(9.4,60,22,13,"PAH",219,1,61,0)="are being corrected in this patch:"
^DIC(9.4,60,22,13,"PAH",219,1,62,0)="   a. If a hold reason of ""8 (PER PATIENT REQUEST)"" or ""99 (OTHER--SEE"
^DIC(9.4,60,22,13,"PAH",219,1,63,0)="      COMMENTS)"" was entered, some options were displaying reason ""7 (BAD"
^DIC(9.4,60,22,13,"PAH",219,1,64,0)="      ADDRESS)"" instead. This patch corrects that problem."
^DIC(9.4,60,22,13,"PAH",219,1,65,0)=" "
^DIC(9.4,60,22,13,"PAH",219,1,66,0)="   b. The function call $$CHKRX^PSOBAI was missing a value on some quit"
^DIC(9.4,60,22,13,"PAH",219,1,67,0)="      statements. Although the affected lines of code should never be"
^DIC(9.4,60,22,13,"PAH",219,1,68,0)="      encountered, this patch corrects the problem."
^DIC(9.4,60,22,13,"PAH",220,0)="255 SEQ #226^3061228.073451^1"
^DIC(9.4,60,22,13,"PAH",220,1,0)="^^8^8^3061228"
^DIC(9.4,60,22,13,"PAH",220,1,1,0)="This patch will correct certain scenarios where bottle labels printed "
^DIC(9.4,60,22,13,"PAH",220,1,2,0)="through the OPAI External Dispense machines have a slightly different "
^DIC(9.4,60,22,13,"PAH",220,1,3,0)="drug name than when sent to CMOP or printed locally.  Two new drug name "
^DIC(9.4,60,22,13,"PAH",220,1,4,0)="fields, VA LABEL NAME & VA PRINT NAME, will be sent in the OPAI HL7 "
^DIC(9.4,60,22,13,"PAH",220,1,5,0)="segments to the External Dispense Machines."
^DIC(9.4,60,22,13,"PAH",220,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",220,1,7,0)="Also will correct the Method of Pickup field in RXE.8 to send when all"
^DIC(9.4,60,22,13,"PAH",220,1,8,0)="alpha characters."
^DIC(9.4,60,22,13,"PAH",221,0)="259 SEQ #227^3061228.073625^1"
^DIC(9.4,60,22,13,"PAH",221,1,0)="^^11^11^3061228"
^DIC(9.4,60,22,13,"PAH",221,1,1,0)="This patch will correct 5 problems."
^DIC(9.4,60,22,13,"PAH",221,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",221,1,3,0)="Problem 1: Users are able to delete released refills without returning to"
^DIC(9.4,60,22,13,"PAH",221,1,4,0)="           stock."
^DIC(9.4,60,22,13,"PAH",221,1,5,0)="Problem 2: A released refill may still allow for deletion."
^DIC(9.4,60,22,13,"PAH",221,1,6,0)="Problem 3: Error occurs when deleting suspended refills using menu option"
^DIC(9.4,60,22,13,"PAH",221,1,7,0)="           Change Suspense Date."
^DIC(9.4,60,22,13,"PAH",221,1,8,0)="Problem 4: The Return Medication to Stock option is not deleting the"
^DIC(9.4,60,22,13,"PAH",221,1,9,0)="           refill."
^DIC(9.4,60,22,13,"PAH",221,1,10,0)="Problem 5: Prevent OPAI from updating a refill node via Auto-Release"
^DIC(9.4,60,22,13,"PAH",221,1,11,0)="           when the refill node was deleted."
^DIC(9.4,60,22,13,"PAH",222,0)="254 SEQ #228^3070627.232609^1"
^DIC(9.4,60,22,13,"PAH",222,1,0)="^^66^66^3070627"
^DIC(9.4,60,22,13,"PAH",222,1,1,0)="For the Health Insurance Portability and Accountability Act (HIPAA)"
^DIC(9.4,60,22,13,"PAH",222,1,2,0)="National Provider Identifier (NPI) project, this patch will create and"
^DIC(9.4,60,22,13,"PAH",222,1,3,0)="populate the new NPI INSTITUTION field (#101) in the OUTPATIENT SITE file"
^DIC(9.4,60,22,13,"PAH",222,1,4,0)="(#59). This patch will also change the Site Parameter Enter/Edi [PSO SITE"
^DIC(9.4,60,22,13,"PAH",222,1,5,0)="PARAMETERS] option to allow the user to edit this new field as shown"
^DIC(9.4,60,22,13,"PAH",222,1,6,0)="below:"
^DIC(9.4,60,22,13,"PAH",222,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,8,0)="       NAME: ALBANY// "
^DIC(9.4,60,22,13,"PAH",222,1,9,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,10,0)="       ..."
^DIC(9.4,60,22,13,"PAH",222,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,12,0)="       Select CPRS ORDERING INSTITUTION:"
^DIC(9.4,60,22,13,"PAH",222,1,13,0)="       RELATED INSTITUTION: ALBANY// "
^DIC(9.4,60,22,13,"PAH",222,1,14,0)="       NPI INSTITUTION: ALBANY// "
^DIC(9.4,60,22,13,"PAH",222,1,15,0)="   "
^DIC(9.4,60,22,13,"PAH",222,1,16,0)="       ..."
^DIC(9.4,60,22,13,"PAH",222,1,17,0)="  "
^DIC(9.4,60,22,13,"PAH",222,1,18,0)="When this patch is installed, the information in this field will be "
^DIC(9.4,60,22,13,"PAH",222,1,19,0)="automatically populated through a post-install routine. The correct"
^DIC(9.4,60,22,13,"PAH",222,1,20,0)="institution will be identified using the existing NCPDP NUMBER field"
^DIC(9.4,60,22,13,"PAH",222,1,21,0)="(#1008) in the OUTPATIENT SITE file (#59), along with a list of"
^DIC(9.4,60,22,13,"PAH",222,1,22,0)="pre-defined NPI numbers, which should match to NPI numbers previously "
^DIC(9.4,60,22,13,"PAH",222,1,23,0)="assigned to each institution by the KERNEL V. 8.0 patch XU*8*410."
^DIC(9.4,60,22,13,"PAH",222,1,24,0)="   "
^DIC(9.4,60,22,13,"PAH",222,1,25,0)="The PSO SITE input template is being changed to include this new field."
^DIC(9.4,60,22,13,"PAH",222,1,26,0)="Therefore, the user will be able to manually add/edit/delete the NPI"
^DIC(9.4,60,22,13,"PAH",222,1,27,0)="INSTITUTION field through the Site Parameter Enter/Edit [PSO SITE"
^DIC(9.4,60,22,13,"PAH",222,1,28,0)="PARAMETERS] option."
^DIC(9.4,60,22,13,"PAH",222,1,29,0)="  "
^DIC(9.4,60,22,13,"PAH",222,1,30,0)="**************************************************************************"
^DIC(9.4,60,22,13,"PAH",222,1,31,0)="NOTE: All active outpatient sites MUST have an NPI INSTITUTION assigned."
^DIC(9.4,60,22,13,"PAH",222,1,32,0)="This is very important for sites currently performing third party"
^DIC(9.4,60,22,13,"PAH",222,1,33,0)="electronic billing (ePharmacy) because the NPI number will replace the "
^DIC(9.4,60,22,13,"PAH",222,1,34,0)="previous NCPDP (National Council for Prescription Drug Programs) number "
^DIC(9.4,60,22,13,"PAH",222,1,35,0)="used to identify the dispensing pharmacy. "
^DIC(9.4,60,22,13,"PAH",222,1,36,0)="**************************************************************************"
^DIC(9.4,60,22,13,"PAH",222,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,38,0)="For active sites that do not have an NPI INSTITUTION assigned after the"
^DIC(9.4,60,22,13,"PAH",222,1,39,0)="installation of this patch, using the Site Parameter Enter/Edit [PSO SITE"
^DIC(9.4,60,22,13,"PAH",222,1,40,0)="PARAMETERS] option enter the correct institution for each site. In order"
^DIC(9.4,60,22,13,"PAH",222,1,41,0)="to help you identify which sites have and which ones have not been "
^DIC(9.4,60,22,13,"PAH",222,1,42,0)="assigned an NPI INSTITUTION, the post-install routine will generate a "
^DIC(9.4,60,22,13,"PAH",222,1,43,0)="Mailman message which will be sent to the user installing the patch as "
^DIC(9.4,60,22,13,"PAH",222,1,44,0)="well as all the holders of the PSORPH security key. Below is an example"
^DIC(9.4,60,22,13,"PAH",222,1,45,0)="of the Mailman message:"
^DIC(9.4,60,22,13,"PAH",222,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,47,0)="Subj: NPI INSTITUTION POPULATION [#93686] 08/01/06@16:16  20 lines"
^DIC(9.4,60,22,13,"PAH",222,1,48,0)="From: PATCH PSO*7*254  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",222,1,49,0)="-----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",222,1,50,0)="PSO*7*254 POST-INSTALL - POPULATES NPI INSTITUTION FIELD (#101)"
^DIC(9.4,60,22,13,"PAH",222,1,51,0)="                         IN THE OUTPATIENT SITE FILE (#59)"
^DIC(9.4,60,22,13,"PAH",222,1,52,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,53,0)="Please, validate that the NPI INSTITUTION assignment below is correct for "
^DIC(9.4,60,22,13,"PAH",222,1,54,0)="each active DIVISION. If not, please use the Site Parameter Enter/Edit [PSO"
^DIC(9.4,60,22,13,"PAH",222,1,55,0)="SITE PARAMETERS] option and assign the correct NPI INSTITUTION."
^DIC(9.4,60,22,13,"PAH",222,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",222,1,57,0)="------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",222,1,58,0)="DIVISION(SITE#)        NPI#        NPI INSTITUTION"
^DIC(9.4,60,22,13,"PAH",222,1,59,0)="------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",222,1,60,0)="ALBANY(500)            9999854880  ALBANY"
^DIC(9.4,60,22,13,"PAH",222,1,61,0)="LEAVENWORTH(686)       9999813538  LEAVENWORTH, KS"
^DIC(9.4,60,22,13,"PAH",222,1,62,0)="SIDNEY CLINIC(442GC)               NO SITE# OR NCPDP# FOUND FOR DIVISION"
^DIC(9.4,60,22,13,"PAH",222,1,63,0)="TROY(514)                          NO NPI# FOUND FOR THIS DIVISION"
^DIC(9.4,60,22,13,"PAH",222,1,64,0)="GREELEY CLINIC(442GD)  9999591232  GREELEY CBOC"
^DIC(9.4,60,22,13,"PAH",222,1,65,0)="  "
^DIC(9.4,60,22,13,"PAH",222,1,66,0)="TOTAL: 5 Division(s)."
^DIC(9.4,60,22,13,"PAH",223,0)="252 SEQ #229^3070629.210624^1"
^DIC(9.4,60,22,13,"PAH",223,1,0)="^^35^35^3070629"
^DIC(9.4,60,22,13,"PAH",223,1,1,0)="This patch includes two new routines, PSO52EX and PSO52B.  It also"
^DIC(9.4,60,22,13,"PAH",223,1,2,0)="enhances functionality and resolves two problems in PSO52API."
^DIC(9.4,60,22,13,"PAH",223,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",223,1,4,0)="PSO52EX is a new routine containing two Application Programmer Interfaces"
^DIC(9.4,60,22,13,"PAH",223,1,5,0)="(APIs).  The first API is named EXTRACT.  EXTRACT retrieves data from the"
^DIC(9.4,60,22,13,"PAH",223,1,6,0)="""AL"" and ""AM"" cross references within the PRESCRIPTION file (#52).  "
^DIC(9.4,60,22,13,"PAH",223,1,7,0)="EXTRACT requires three parameters: SDATE, EDATE, and LIST.  SDATE is the"
^DIC(9.4,60,22,13,"PAH",223,1,8,0)="start date to retrieve data from.  EDATE is the end date to retrieve data"
^DIC(9.4,60,22,13,"PAH",223,1,9,0)="from.  LIST is the name that is used to subscript the returned data into a"
^DIC(9.4,60,22,13,"PAH",223,1,10,0)="^TMP global.  Once these values are set by the user, EXTRACT will then"
^DIC(9.4,60,22,13,"PAH",223,1,11,0)="extract all original fill information.  If a selected patient also has"
^DIC(9.4,60,22,13,"PAH",223,1,12,0)="refill or partial fill information on record, that information will also"
^DIC(9.4,60,22,13,"PAH",223,1,13,0)="be returned and subscripted accordingly.  The output is stored on the ^TMP"
^DIC(9.4,60,22,13,"PAH",223,1,14,0)="global.  The second API is named REF.  REF also requires the same three"
^DIC(9.4,60,22,13,"PAH",223,1,15,0)="parameters: SDATE, EDATE, and LIST.  It will retrieve information stored"
^DIC(9.4,60,22,13,"PAH",223,1,16,0)="on the ""AD"" cross reference in the PRESCRIPTION file (#52) and return it"
^DIC(9.4,60,22,13,"PAH",223,1,17,0)="to the ^TMP global. Refer to Forum DBIA 4902 for complete information."
^DIC(9.4,60,22,13,"PAH",223,1,18,0)=" "
^DIC(9.4,60,22,13,"PAH",223,1,19,0)="PSO52B is a new routine that contains a number of subroutines that have "
^DIC(9.4,60,22,13,"PAH",223,1,20,0)="been moved from PSO52API.  This was done to ensure that PSO52API will "
^DIC(9.4,60,22,13,"PAH",223,1,21,0)="continue to be within Programming Standards and Conventions (SAC) routine "
^DIC(9.4,60,22,13,"PAH",223,1,22,0)="size limits.  PSO52B also enhances the RX^PSO52API component by retrieving"
^DIC(9.4,60,22,13,"PAH",223,1,23,0)="International Classification of Diseases (ICD) information from the"
^DIC(9.4,60,22,13,"PAH",223,1,24,0)="PRESCRIPTION file (#52).  The user now has the option to pass in ""ICD"" in"
^DIC(9.4,60,22,13,"PAH",223,1,25,0)="the NODE parameter of the RX^PSO52API call and retrieve information"
^DIC(9.4,60,22,13,"PAH",223,1,26,0)="specific to the patient(s) concerning their ICD. Refer to the Application"
^DIC(9.4,60,22,13,"PAH",223,1,27,0)="Programmer Interface (API) manual for further instruction on the use of"
^DIC(9.4,60,22,13,"PAH",223,1,28,0)="this API."
^DIC(9.4,60,22,13,"PAH",223,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",223,1,30,0)="This patch also corrects two other issues within PSO52API.  Currently   if"
^DIC(9.4,60,22,13,"PAH",223,1,31,0)="the user passes in only an end date, the API will error.  This patch will"
^DIC(9.4,60,22,13,"PAH",223,1,32,0)="correct this problem.  Also, when ""O"" is passed in the NODE parameter to"
^DIC(9.4,60,22,13,"PAH",223,1,33,0)="retrieve the ORDERABLE ITEM field (#39.2) from the PRESCRIPTION file"
^DIC(9.4,60,22,13,"PAH",223,1,34,0)="(#52), the code will now return data as stated in the API manual without"
^DIC(9.4,60,22,13,"PAH",223,1,35,0)="representing the field number in its ^TMP global subscript."
^DIC(9.4,60,22,13,"PAH",224,0)="243 SEQ #230^3070904.225626^1"
^DIC(9.4,60,22,13,"PAH",224,1,0)="^^76^76^3070904"
^DIC(9.4,60,22,13,"PAH",224,1,1,0)="Remote Data Interoperability (RDI) functionality includes receiving data"
^DIC(9.4,60,22,13,"PAH",224,1,2,0)="from the Health Data Repository (HDR) in order to perform order checking"
^DIC(9.4,60,22,13,"PAH",224,1,3,0)="against outpatient prescription and allergy data from remote VA or"
^DIC(9.4,60,22,13,"PAH",224,1,4,0)="Department of Defense (DoD) facilities."
^DIC(9.4,60,22,13,"PAH",224,1,5,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,6,0)="When RDI is turned on (by the Computerized Patient Record System (CPRS)"
^DIC(9.4,60,22,13,"PAH",224,1,7,0)="patch OR*3*238), the RDI order checking checks the current drug being "
^DIC(9.4,60,22,13,"PAH",224,1,8,0)="ordered for duplicate drugs, duplicate drug classes, drug-drug"
^DIC(9.4,60,22,13,"PAH",224,1,9,0)="interactions, and drug allergies."
^DIC(9.4,60,22,13,"PAH",224,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,12,0)="This patch contains the following changes for RDI order checking:"
^DIC(9.4,60,22,13,"PAH",224,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,14,0)="1. Prescriptions with a status of ""DELETED"" in the STATUS field (#100) in"
^DIC(9.4,60,22,13,"PAH",224,1,15,0)="the PRESCRIPTION file (#52) from a remote facility should not be included"
^DIC(9.4,60,22,13,"PAH",224,1,16,0)="in order checks. This patch filters out DELETED remote prescriptions."
^DIC(9.4,60,22,13,"PAH",224,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,18,0)="2. Some older prescriptions do not have an expiration date in the "
^DIC(9.4,60,22,13,"PAH",224,1,19,0)="EXPIRATION DATE field (#26) of the PRESCRIPTION file (#52). This patch"
^DIC(9.4,60,22,13,"PAH",224,1,20,0)="restricts prescriptions with a missing expiration date from being used in"
^DIC(9.4,60,22,13,"PAH",224,1,21,0)="remote order checks unless the ISSUE DATE (#1) field of the PRESCRIPTION"
^DIC(9.4,60,22,13,"PAH",224,1,22,0)="file (#52) is within the past year."
^DIC(9.4,60,22,13,"PAH",224,1,23,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,24,0)="3. Drugs not matched to the National Drug file were not performing remote "
^DIC(9.4,60,22,13,"PAH",224,1,25,0)="order checks. These drugs could have a drug class defined. This patch "
^DIC(9.4,60,22,13,"PAH",224,1,26,0)="adds the remote order check for drug class when orders are placed for "
^DIC(9.4,60,22,13,"PAH",224,1,27,0)="locally defined drugs."
^DIC(9.4,60,22,13,"PAH",224,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,29,0)="4. When Adverse Reaction Tracking (ART) patch GMRA*4*26 is installed at a"
^DIC(9.4,60,22,13,"PAH",224,1,30,0)="site, this patch adds the display of LOCAL, REMOTE SITE(S), or LOCAL AND"
^DIC(9.4,60,22,13,"PAH",224,1,31,0)="REMOTE SITE(S) to allergy order checks to indicate whether the allergy"
^DIC(9.4,60,22,13,"PAH",224,1,32,0)="entry originated at the local site or it came from a remote site. For"
^DIC(9.4,60,22,13,"PAH",224,1,33,0)="backdoor outpatient pharmacy, currently only the drug class code and not"
^DIC(9.4,60,22,13,"PAH",224,1,34,0)="the drug class name is displayed for an allergy drug class order check."
^DIC(9.4,60,22,13,"PAH",224,1,35,0)="This patch adds the display of the class name."
^DIC(9.4,60,22,13,"PAH",224,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,37,0)="Example:"
^DIC(9.4,60,22,13,"PAH",224,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,39,0)="A Drug-Allergy Reaction exists for this medication and/or class!"
^DIC(9.4,60,22,13,"PAH",224,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,41,0)="Drug: AMOXICILLIN 250MG CAP"
^DIC(9.4,60,22,13,"PAH",224,1,42,0)="Drug Class: AM110 PENICILLIN-G RELATED PENICILLINS (LOCAL)"
^DIC(9.4,60,22,13,"PAH",224,1,43,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,44,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,45,0)="5. When the VUID field (#99.99) of the VA PRODUCT file (#50.68) of a"
^DIC(9.4,60,22,13,"PAH",224,1,46,0)="remote prescription is inactive, every order being placed incorrectly"
^DIC(9.4,60,22,13,"PAH",224,1,47,0)="displayed a duplicate drug order check. This patch corrects that problem."
^DIC(9.4,60,22,13,"PAH",224,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,49,0)="6. Remote order checking against remote discontinued or expired outpatient"
^DIC(9.4,60,22,13,"PAH",224,1,50,0)="prescriptions is changed to perform the order check if the remote "
^DIC(9.4,60,22,13,"PAH",224,1,51,0)="prescription was expired or discontinued in the last 30 days instead of "
^DIC(9.4,60,22,13,"PAH",224,1,52,0)="within the last 120 days."
^DIC(9.4,60,22,13,"PAH",224,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,54,0)="7. During testing of RDI, a problem was discovered with the order checks"
^DIC(9.4,60,22,13,"PAH",224,1,55,0)="involving remote allergy classes. Not all of the remote allergies were"
^DIC(9.4,60,22,13,"PAH",224,1,56,0)="being retrieved from the HDR. A change was made to use a different"
^DIC(9.4,60,22,13,"PAH",224,1,57,0)="Application Program Interface (API) to the allergy package that does "
^DIC(9.4,60,22,13,"PAH",224,1,58,0)="retrieve the remote data."
^DIC(9.4,60,22,13,"PAH",224,1,59,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,60,0)="8. An issue with too many false positive order checks was discovered when "
^DIC(9.4,60,22,13,"PAH",224,1,61,0)="doing allergy order checks on certain drug classes. Analgesics, as a"
^DIC(9.4,60,22,13,"PAH",224,1,62,0)="class, were performing order checks across all members. For example: class"
^DIC(9.4,60,22,13,"PAH",224,1,63,0)="CN101 was generating an order check for class CN102. This patch corrects"
^DIC(9.4,60,22,13,"PAH",224,1,64,0)="this problem by ensuring that allergy Analgesic class order checks only"
^DIC(9.4,60,22,13,"PAH",224,1,65,0)="match against the specific 5-character class if the class begins with "
^DIC(9.4,60,22,13,"PAH",224,1,66,0)="""CN10""."
^DIC(9.4,60,22,13,"PAH",224,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,68,0)="9. One feature of RDI is the notification to the user when processing "
^DIC(9.4,60,22,13,"PAH",224,1,69,0)="orders that only local data is being used if the remote data is "
^DIC(9.4,60,22,13,"PAH",224,1,70,0)="unavailable. Several sites reported issues with this mechanism. This "
^DIC(9.4,60,22,13,"PAH",224,1,71,0)="patch corrects this problem by performing the check for remote data "
^DIC(9.4,60,22,13,"PAH",224,1,72,0)="availability upon entering the patient's chart, rather than on each order."
^DIC(9.4,60,22,13,"PAH",224,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",224,1,74,0)="10. The list of remote allergies is added to allergy/adverse reaction "
^DIC(9.4,60,22,13,"PAH",224,1,75,0)="portion of the Medication Profile. If a patient has the same allergy"
^DIC(9.4,60,22,13,"PAH",224,1,76,0)="information from several remote sites, it will only be listed once."
^DIC(9.4,60,22,13,"PAH",225,0)="200 SEQ #231^3070904.230855^1"
^DIC(9.4,60,22,13,"PAH",225,1,0)="^^255^255^3070904"
^DIC(9.4,60,22,13,"PAH",225,1,1,0)=" This patch contains the FY 2007 Quarter 2 Outpatient Pharmacy V. 7.0"
^DIC(9.4,60,22,13,"PAH",225,1,2,0)="enhancements. "
^DIC(9.4,60,22,13,"PAH",225,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,5,0)="***** NOTE TO SITES USING AUTOMATED FILLING EQUIPMENT *****"
^DIC(9.4,60,22,13,"PAH",225,1,6,0)="Please ensure that your vendor is aware of the changes being made by this "
^DIC(9.4,60,22,13,"PAH",225,1,7,0)="patch. There are changes (described below) that affect both the HEALTH "
^DIC(9.4,60,22,13,"PAH",225,1,8,0)="LEVEL SEVEN (HL7) messages (content of fields only - no new fields are"
^DIC(9.4,60,22,13,"PAH",225,1,9,0)="added) and the laser label stream."
^DIC(9.4,60,22,13,"PAH",225,1,10,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,11,0)="If you are using automated dispensing equipment that relies on "
^DIC(9.4,60,22,13,"PAH",225,1,12,0)="the data stream sent to the laser labels port, you have 2 options:"
^DIC(9.4,60,22,13,"PAH",225,1,13,0)="  1. Implement the Outpatient Automation Interface (OPAI) (available with"
^DIC(9.4,60,22,13,"PAH",225,1,14,0)="     released patch PSO*7*156) or "
^DIC(9.4,60,22,13,"PAH",225,1,15,0)="  2. Contact your vendor to make adjustments based on the new data stream."
^DIC(9.4,60,22,13,"PAH",225,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,18,0)="Outpatient Pharmacy Automation Interface (OPAI) enhancements: "
^DIC(9.4,60,22,13,"PAH",225,1,19,0)="-------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,20,0)="1. Modified to use the new commercial warning label source to send the"
^DIC(9.4,60,22,13,"PAH",225,1,21,0)="warning label text to the automated filling equipment. The OPAI WARNING"
^DIC(9.4,60,22,13,"PAH",225,1,22,0)="LABEL SOURCE field (#16.2) in the PHARMACY SYSTEM file (#59.7) must be set"
^DIC(9.4,60,22,13,"PAH",225,1,23,0)="to ""N"" for ""New"" to send the warning labels from the new commercial data"
^DIC(9.4,60,22,13,"PAH",225,1,24,0)="source to OPAI. It can be set by using the Pharmacy System Parameters Edit"
^DIC(9.4,60,22,13,"PAH",225,1,25,0)="[PSS SYS EDIT] option."
^DIC(9.4,60,22,13,"PAH",225,1,26,0)=" Example:"
^DIC(9.4,60,22,13,"PAH",225,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,28,0)="Select OPTION NAME: PSS SYS EDIT       Pharmacy System Parameters Edit"
^DIC(9.4,60,22,13,"PAH",225,1,29,0)="Pharmacy System Parameters Edit"
^DIC(9.4,60,22,13,"PAH",225,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,31,0)="PMIS PRINTER: L8150$PRT// "
^DIC(9.4,60,22,13,"PAH",225,1,32,0)="PMIS LANGUAGE: English// "
^DIC(9.4,60,22,13,"PAH",225,1,33,0)="WARNING LABEL SOURCE: NEW// "
^DIC(9.4,60,22,13,"PAH",225,1,34,0)="CMOP WARNING LABEL SOURCE: NEW//"
^DIC(9.4,60,22,13,"PAH",225,1,35,0)="OPAI WARNING LABEL SOURCE: ?"
^DIC(9.4,60,22,13,"PAH",225,1,36,0)="     Enter ""N"" for NEW to use commercial data source for OPAI warning "
^DIC(9.4,60,22,13,"PAH",225,1,37,0)="labels."
^DIC(9.4,60,22,13,"PAH",225,1,38,0)="     Choose from: "
^DIC(9.4,60,22,13,"PAH",225,1,39,0)="       N        NEW"
^DIC(9.4,60,22,13,"PAH",225,1,40,0)="OPAI WARNING LABEL SOURCE: N  NEW"
^DIC(9.4,60,22,13,"PAH",225,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,42,0)="   a. The warning text is sent as one record per warning."
^DIC(9.4,60,22,13,"PAH",225,1,43,0)="   b. The text is sent in English or Spanish depending on the patient's"
^DIC(9.4,60,22,13,"PAH",225,1,44,0)="      other language settings. "
^DIC(9.4,60,22,13,"PAH",225,1,45,0)="   c. If the DEA, SPECIAL HDLG field (#3) in the DRUG file (#50) begins"
^DIC(9.4,60,22,13,"PAH",225,1,46,0)="      with numbers 1,2,3,4, or 5, the NO TRANSFER warning text from the RX"
^DIC(9.4,60,22,13,"PAH",225,1,47,0)="      CONSULT file (#54) entry number 20 is automatically sent as one of"
^DIC(9.4,60,22,13,"PAH",225,1,48,0)="      the first 5 warnings when the OPAI WARNING LABEL SOURCE is set to "
^DIC(9.4,60,22,13,"PAH",225,1,49,0)="      ""New""."
^DIC(9.4,60,22,13,"PAH",225,1,50,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,51,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,52,0)="2. If the BAD ADDRESS INDICATOR (BAI) field (#.121) of the PATIENT file"
^DIC(9.4,60,22,13,"PAH",225,1,53,0)="(#2) is set and the routing is WINDOW, the text ""VAB"" concatenated with"
^DIC(9.4,60,22,13,"PAH",225,1,54,0)="the BAI code is sent in the Address field of the PID segment of the HL7"
^DIC(9.4,60,22,13,"PAH",225,1,55,0)="message to the filling equipment."
^DIC(9.4,60,22,13,"PAH",225,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,57,0)="Here are some examples of this field:"
^DIC(9.4,60,22,13,"PAH",225,1,58,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,59,0)="When the permanent address is active:"
^DIC(9.4,60,22,13,"PAH",225,1,60,0)="PADD-1~PADD-2~SPRING~TX~77379~~P~PADD-3~201^~~""""~""""~~~N|""""|||||||"
^DIC(9.4,60,22,13,"PAH",225,1,61,0)="|"
^DIC(9.4,60,22,13,"PAH",225,1,62,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,63,0)="When the temporary address is active:"
^DIC(9.4,60,22,13,"PAH",225,1,64,0)="PADD-1~PADD-2~SPRING~TX~77379~~P~PADD-3~201^~~""""~""""~~~N^TADD-1~TADD-2 "
^DIC(9.4,60,22,13,"PAH",225,1,65,0)="TADD-3~PLANO~TX~12345~~C~~""""~~~"
^DIC(9.4,60,22,13,"PAH",225,1,66,0)="^HL(772,10388,""IN"",2,0)=20070223&""""|""""|||||||||"
^DIC(9.4,60,22,13,"PAH",225,1,67,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,68,0)="When the address is flagged as BAI:"
^DIC(9.4,60,22,13,"PAH",225,1,69,0)="PADD-1~PADD-2~SPRING~TX~77379~~VAB1~PADD-3~201^~~""""~""""~~~N|""""||||||"
^DIC(9.4,60,22,13,"PAH",225,1,70,0)="|||"
^DIC(9.4,60,22,13,"PAH",225,1,71,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,72,0)="""VAB1"" - indicates Bad Address Indicator and 1 is for UNDELIVERABLE (2 for"
^DIC(9.4,60,22,13,"PAH",225,1,73,0)="HOMELESS, 3 for OTHER)"
^DIC(9.4,60,22,13,"PAH",225,1,74,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,75,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,76,0)="Laser Label enhancements:"
^DIC(9.4,60,22,13,"PAH",225,1,77,0)="-------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,78,0)="1. Print the last 4 digits of the Social Security Number (SSN) instead of"
^DIC(9.4,60,22,13,"PAH",225,1,79,0)="the last 6 digits."
^DIC(9.4,60,22,13,"PAH",225,1,80,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,81,0)="2. Change the name on the mailing label back to Last name,First name"
^DIC(9.4,60,22,13,"PAH",225,1,82,0)="format."
^DIC(9.4,60,22,13,"PAH",225,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,84,0)="3. On the Pharmacy Fill Card portion of the label, replace the text "
^DIC(9.4,60,22,13,"PAH",225,1,85,0)="""Mfr ___________________"" with:"
^DIC(9.4,60,22,13,"PAH",225,1,86,0)="   a. NDC/MFR_______________ for non-ePharmacy sites"
^DIC(9.4,60,22,13,"PAH",225,1,87,0)="   b. NDC nnnnn-nnnn-nn for ePharmacy sites "
^DIC(9.4,60,22,13,"PAH",225,1,88,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,89,0)="4. Signature log enhancements:"
^DIC(9.4,60,22,13,"PAH",225,1,90,0)="   a. Print current date at top"
^DIC(9.4,60,22,13,"PAH",225,1,91,0)="   b. Do not print user name (if more than 1 prescription was included to"
^DIC(9.4,60,22,13,"PAH",225,1,92,0)="      be signed, the user name could be different for each one)."
^DIC(9.4,60,22,13,"PAH",225,1,93,0)="   c. Correct the spacing and continuation paging issues if one or more "
^DIC(9.4,60,22,13,"PAH",225,1,94,0)="      of the prescriptions has been discontinued before printing the "
^DIC(9.4,60,22,13,"PAH",225,1,95,0)="      signature log."
^DIC(9.4,60,22,13,"PAH",225,1,96,0)="   d. Add a barcode to enable scanning to remove the patient's name from "
^DIC(9.4,60,22,13,"PAH",225,1,97,0)="      the Bingo Board."
^DIC(9.4,60,22,13,"PAH",225,1,98,0)="   e. Add as much of the drug name as will fit on the label."
^DIC(9.4,60,22,13,"PAH",225,1,99,0)="   f. Add hidden action ""RS"" for Reprint Signature log to the prescription"
^DIC(9.4,60,22,13,"PAH",225,1,100,0)="      profile screen."
^DIC(9.4,60,22,13,"PAH",225,1,101,0)="   g. While printing original labels (not reprint of the signature log), "
^DIC(9.4,60,22,13,"PAH",225,1,102,0)="      if all of the fills have a routing of mail, the signature log will"
^DIC(9.4,60,22,13,"PAH",225,1,103,0)="      not be printed."
^DIC(9.4,60,22,13,"PAH",225,1,104,0)="   h. The line ""Relationship_________________ Counseled? _____"" is changed"
^DIC(9.4,60,22,13,"PAH",225,1,105,0)="      to ""Relation_____ Counseling Refused__ Accepted__""."
^DIC(9.4,60,22,13,"PAH",225,1,106,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,107,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,108,0)="5. When a fill is released, if the BAI is no longer set or there is an "
^DIC(9.4,60,22,13,"PAH",225,1,109,0)="active temporary address, the ""B"" is removed from the status column of "
^DIC(9.4,60,22,13,"PAH",225,1,110,0)="the patient profile. (This is removed by making an additional entry in "
^DIC(9.4,60,22,13,"PAH",225,1,111,0)="the label log. The ""B"" comes from the ""last"" entry having a bad address "
^DIC(9.4,60,22,13,"PAH",225,1,112,0)="condition at the time the label printed)."
^DIC(9.4,60,22,13,"PAH",225,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,114,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,116,0)="To address E3R 19820, the following code changes are included in this "
^DIC(9.4,60,22,13,"PAH",225,1,117,0)="patch:"
^DIC(9.4,60,22,13,"PAH",225,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,119,0)="1. Add the capability to tie a ScripTalk printer to regular Pharmacy"
^DIC(9.4,60,22,13,"PAH",225,1,120,0)="label printer(s) to control where the ScripTalk labels print for"
^DIC(9.4,60,22,13,"PAH",225,1,121,0)="multi-divisional sites. The new SCRIPTALK PRINT DEVICE MAPPING multiple"
^DIC(9.4,60,22,13,"PAH",225,1,122,0)="(#47) in PHARMACY SYSTEM file (#59.7) has been created to store this"
^DIC(9.4,60,22,13,"PAH",225,1,123,0)="information in Pharmacy Data Management patch PSS*1*122. The multiple"
^DIC(9.4,60,22,13,"PAH",225,1,124,0)="contains PRINTER TO BE MAPPED field (#.01) and SCRIPTALK DEVICE field"
^DIC(9.4,60,22,13,"PAH",225,1,125,0)="(#.02)."
^DIC(9.4,60,22,13,"PAH",225,1,126,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,127,0)="The added functionality works in conjunction with the existing ScripTalk "
^DIC(9.4,60,22,13,"PAH",225,1,128,0)="divisional functionality, so a divisional ScripTalk device must be"
^DIC(9.4,60,22,13,"PAH",225,1,129,0)="defined.  If no mapping is defined in the new fields, ScripTalk labels"
^DIC(9.4,60,22,13,"PAH",225,1,130,0)="will continue to print on the printer defined for the division.  If"
^DIC(9.4,60,22,13,"PAH",225,1,131,0)="a pharmacy printer is mapped to a ScripTalk printer, the ScripTalk label"
^DIC(9.4,60,22,13,"PAH",225,1,132,0)="will automatically be printed on the mapped ScripTalk printer."
^DIC(9.4,60,22,13,"PAH",225,1,133,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,135,0)="2. Modify the ScripTalk Device Definition Enter/Edit [PSO SCRIPTALK"
^DIC(9.4,60,22,13,"PAH",225,1,136,0)="DEVICE DEF'N] option to allow definition of printer mapping for "
^DIC(9.4,60,22,13,"PAH",225,1,137,0)="ScripTalk devices.  The user will be prompted to define the ScripTalk "
^DIC(9.4,60,22,13,"PAH",225,1,138,0)="printer by division or by printer mapping.  After selecting D for "
^DIC(9.4,60,22,13,"PAH",225,1,139,0)="division, the divisional definition has not changed.  After selecting "
^DIC(9.4,60,22,13,"PAH",225,1,140,0)="P for printer mapping, the user will be prompted ""LABEL PRINTER TO BE"
^DIC(9.4,60,22,13,"PAH",225,1,141,0)="MAPPED"". The device entered into this field corresponds to the label"
^DIC(9.4,60,22,13,"PAH",225,1,142,0)="printer selected during Pharmacy login and/or the printer selected during"
^DIC(9.4,60,22,13,"PAH",225,1,143,0)="print from suspense functions. Next, ""SCRIPTALK DEVICE"" will be prompted,"
^DIC(9.4,60,22,13,"PAH",225,1,144,0)="and this field should contain the ScripTalk printer to be mapped to the"
^DIC(9.4,60,22,13,"PAH",225,1,145,0)="regular label printer."
^DIC(9.4,60,22,13,"PAH",225,1,146,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,147,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,148,0)="MISCELLANEOUS ENHANCEMENTS:"
^DIC(9.4,60,22,13,"PAH",225,1,149,0)="---------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,150,0)="1. A new field FINISH DATE/TIME field (#38.3) is added to the"
^DIC(9.4,60,22,13,"PAH",225,1,151,0)="PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",225,1,152,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,153,0)="2. When using the Print from Suspense File [PSO PNDLBL] option, if the"
^DIC(9.4,60,22,13,"PAH",225,1,154,0)="routing is not WINDOW and the BAD ADDRESS INDICATOR (#.121) field of the"
^DIC(9.4,60,22,13,"PAH",225,1,155,0)="PATIENT file (#2) is set (value of 1=UNDELIVERABLE, 2=HOMELESS, 3=OTHER)"
^DIC(9.4,60,22,13,"PAH",225,1,156,0)="and the patient does not have an active temporary address, the"
^DIC(9.4,60,22,13,"PAH",225,1,157,0)="prescription fill will not be sent to automated filling equipment and/or"
^DIC(9.4,60,22,13,"PAH",225,1,158,0)="to the label printer. Also, if the fill's routing is mail and the "
^DIC(9.4,60,22,13,"PAH",225,1,159,0)="patient's MAIL field (#.03) in the PHARMACY PATIENT file (#55) is set to"
^DIC(9.4,60,22,13,"PAH",225,1,160,0)="""DO NOT MAIL"" and the current date is before the MAIL STATUS EXPIRATION"
^DIC(9.4,60,22,13,"PAH",225,1,161,0)="DATE field (#.05) in the PHARMACY PATIENT file (#55), the label will not"
^DIC(9.4,60,22,13,"PAH",225,1,162,0)="print and the fill will not be sent to the automated filling equipment."
^DIC(9.4,60,22,13,"PAH",225,1,163,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,164,0)="The first time a prescription is not sent/label printed, a MailMan message"
^DIC(9.4,60,22,13,"PAH",225,1,165,0)="will be generated to the user who queued the print from suspense and the"
^DIC(9.4,60,22,13,"PAH",225,1,166,0)="members of the PSO EXTERNAL DISPENSE ALERTS mail group. An entry will also"
^DIC(9.4,60,22,13,"PAH",225,1,167,0)="be set in the PRESCRIPTION file (#52) activity log."
^DIC(9.4,60,22,13,"PAH",225,1,168,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,169,0)="Example activity log entry:"
^DIC(9.4,60,22,13,"PAH",225,1,170,0)="---------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,171,0)="Activity Log:"
^DIC(9.4,60,22,13,"PAH",225,1,172,0)="#   Date        Reason         Rx Ref           Initiator Of Activity"
^DIC(9.4,60,22,13,"PAH",225,1,173,0)="====================================================================="
^DIC(9.4,60,22,13,"PAH",225,1,174,0)="1   02/19/07    SUSPENSE       ORIGINAL         OPPHARMACIST,ONE"
^DIC(9.4,60,22,13,"PAH",225,1,175,0)="Comments: RX not printed from suspense due to BAD ADDRESS INDICATOR"
^DIC(9.4,60,22,13,"PAH",225,1,176,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,177,0)="- or -"
^DIC(9.4,60,22,13,"PAH",225,1,178,0)="Comments: RX not printed from suspense due to DO NOT MAIL"
^DIC(9.4,60,22,13,"PAH",225,1,179,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,180,0)="Example MailMan message:"
^DIC(9.4,60,22,13,"PAH",225,1,181,0)="------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,182,0)="Subj: 500 BAD ADDRESS SUSPENSE NOT PRINTED  [#169828] 02/26/07@07:30  11"
^DIC(9.4,60,22,13,"PAH",225,1,183,0)="lines"
^DIC(9.4,60,22,13,"PAH",225,1,184,0)="From: OUTPATIENT PHARMACY PACKAGE  In 'IN' basket.   Page 1"
^DIC(9.4,60,22,13,"PAH",225,1,185,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,186,0)="-----"
^DIC(9.4,60,22,13,"PAH",225,1,187,0)="The following prescriptions with a routing of mail were not printed/sent "
^DIC(9.4,60,22,13,"PAH",225,1,188,0)="to"
^DIC(9.4,60,22,13,"PAH",225,1,189,0)="external interface due to the BAD ADDRESS INDICATOR being set and no "
^DIC(9.4,60,22,13,"PAH",225,1,190,0)="active"
^DIC(9.4,60,22,13,"PAH",225,1,191,0)="temporary address or patient has an active MAIL status of DO NOT MAIL:"
^DIC(9.4,60,22,13,"PAH",225,1,192,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,193,0)="OPPATIENT,ONE   000001234   (BAD ADDRESS INDICATOR)"
^DIC(9.4,60,22,13,"PAH",225,1,194,0)="  100002608  (1)  A AND Z OINTMENT"
^DIC(9.4,60,22,13,"PAH",225,1,195,0)="  100002609  (0)  ASPIRIN 325MG TABS"
^DIC(9.4,60,22,13,"PAH",225,1,196,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,197,0)="OPPATIENT,FOUR   000004321   (DO NOT MAIL)"
^DIC(9.4,60,22,13,"PAH",225,1,198,0)="  100002654A  (0)  BACITRACIN OINTMENT 1OZ"
^DIC(9.4,60,22,13,"PAH",225,1,199,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,200,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,201,0)="3. Modify the report from the Bad Address Suspended List [PSO BAI "
^DIC(9.4,60,22,13,"PAH",225,1,202,0)="SUSPENDED] option to allow printing by more than one division and also "
^DIC(9.4,60,22,13,"PAH",225,1,203,0)="include prescriptions suspended for Consolidated Mail Outpatient Pharmacy "
^DIC(9.4,60,22,13,"PAH",225,1,204,0)="(CMOP). This report was also changed to not prompt for a start date."
^DIC(9.4,60,22,13,"PAH",225,1,205,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,206,0)="Example:"
^DIC(9.4,60,22,13,"PAH",225,1,207,0)="--------"
^DIC(9.4,60,22,13,"PAH",225,1,208,0)="Select OPTION NAME: PSO BAI SUSPENDED     Bad Address Suspended List"
^DIC(9.4,60,22,13,"PAH",225,1,209,0)="Bad Address Suspended List"
^DIC(9.4,60,22,13,"PAH",225,1,210,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,211,0)="This option shows unprinted suspended prescriptions for patients who have "
^DIC(9.4,60,22,13,"PAH",225,1,212,0)="the"
^DIC(9.4,60,22,13,"PAH",225,1,213,0)="BAD ADDRESS INDICATOR set in the PATIENT file and no active temporary "
^DIC(9.4,60,22,13,"PAH",225,1,214,0)="address."
^DIC(9.4,60,22,13,"PAH",225,1,215,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,216,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,217,0)="Ending suspense date: T+3  (MAR 01, 2007)"
^DIC(9.4,60,22,13,"PAH",225,1,218,0)="Outpatient Pharmacy software - Version 7.0"
^DIC(9.4,60,22,13,"PAH",225,1,219,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,220,0)="Division:    EXT  500  "
^DIC(9.4,60,22,13,"PAH",225,1,221,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,222,0)="          You are logged on under the EXT division."
^DIC(9.4,60,22,13,"PAH",225,1,223,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,224,0)="Select LABEL PRINTER: HOME//   GENERIC INCOMING TELNET"
^DIC(9.4,60,22,13,"PAH",225,1,225,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,226,0)="OK to assume label alignment is correct? YES// "
^DIC(9.4,60,22,13,"PAH",225,1,227,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,228,0)="Bingo Board Display: OUTPATIENT//   "
^DIC(9.4,60,22,13,"PAH",225,1,229,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,230,0)="   You are logged in under the EXT division."
^DIC(9.4,60,22,13,"PAH",225,1,231,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,232,0)="Print only those Rx's suspended for this division? Yes// NO"
^DIC(9.4,60,22,13,"PAH",225,1,233,0)="DEVICE: HOME//   GENERIC INCOMING TELNET"
^DIC(9.4,60,22,13,"PAH",225,1,234,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,235,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,236,0)="Suspense bad address report - division = ALL                       PAGE: 1"
^DIC(9.4,60,22,13,"PAH",225,1,237,0)="for suspense dates through MAR 01, 2007"
^DIC(9.4,60,22,13,"PAH",225,1,238,0)="--------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",225,1,239,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,240,0)="OPPATIENT,TEN   (00-0187)      "
^DIC(9.4,60,22,13,"PAH",225,1,241,0)="MAR 01, 2007    Rx#: 301054     CIMETIDINE 200MG TAB"
^DIC(9.4,60,22,13,"PAH",225,1,242,0)="MAR 01, 2007    Rx#: 301055     COAL TAR 5% GEL 3 OZ TUBE"
^DIC(9.4,60,22,13,"PAH",225,1,243,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,244,0)="OPPATIENT,FIVE   (00-0773)        "
^DIC(9.4,60,22,13,"PAH",225,1,245,0)="FEB 27, 2007    Rx#: 100002655  BACITRACIN OINTMENT 1OZ"
^DIC(9.4,60,22,13,"PAH",225,1,246,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,247,0)="End of Report."
^DIC(9.4,60,22,13,"PAH",225,1,248,0)="Press Return to continue: "
^DIC(9.4,60,22,13,"PAH",225,1,249,0)=" "
^DIC(9.4,60,22,13,"PAH",225,1,250,0)="4. As per the request of Computerized Patient Record System (CPRS)"
^DIC(9.4,60,22,13,"PAH",225,1,251,0)="package the following were added to the Applications Program Interface"
^DIC(9.4,60,22,13,"PAH",225,1,252,0)="(API) PSOHCSUM:"
^DIC(9.4,60,22,13,"PAH",225,1,253,0)="   a. PLACER ORDER # field (#39.3) of the PRESCRIPTION file (#52)."
^DIC(9.4,60,22,13,"PAH",225,1,254,0)="   b. Letter ""R"" when the original fill is returned to stock."
^DIC(9.4,60,22,13,"PAH",225,1,255,0)="For more details please see the IA (Integration Agreement) #330."
^DIC(9.4,60,22,13,"PAH",226,0)="263 SEQ #232^3070904.235004^1"
^DIC(9.4,60,22,13,"PAH",226,1,0)="^^15^15^3070904"
^DIC(9.4,60,22,13,"PAH",226,1,1,0)="This patch will correct the following issues."
^DIC(9.4,60,22,13,"PAH",226,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",226,1,3,0)="Problem:  HD15266"
^DIC(9.4,60,22,13,"PAH",226,1,4,0)="------------------"
^DIC(9.4,60,22,13,"PAH",226,1,5,0)="An undefined error occurs when a single character is entered in the "
^DIC(9.4,60,22,13,"PAH",226,1,6,0)="PSO RESET COPAY option."
^DIC(9.4,60,22,13,"PAH",226,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",226,1,8,0)="Problem:  HD151887"
^DIC(9.4,60,22,13,"PAH",226,1,9,0)="------------------"
^DIC(9.4,60,22,13,"PAH",226,1,10,0)="the EDIT PROVIDER option does not allow editing of SERVICE/SECTION or "
^DIC(9.4,60,22,13,"PAH",226,1,11,0)="PERSON CLASS for Fee Basis providers."
^DIC(9.4,60,22,13,"PAH",226,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",226,1,13,0)="Problem:  HD158732"
^DIC(9.4,60,22,13,"PAH",226,1,14,0)="------------------"
^DIC(9.4,60,22,13,"PAH",226,1,15,0)="There is a discrepancy between fields in EDIT PROVIDER and VIEW PROVIDER."
^DIC(9.4,60,22,13,"PAH",227,0)="261 SEQ #233^3070905.001028^1"
^DIC(9.4,60,22,13,"PAH",227,1,0)="^^43^43^3070905"
^DIC(9.4,60,22,13,"PAH",227,1,1,0)="This patch is part of the third quarter enhancements release for"
^DIC(9.4,60,22,13,"PAH",227,1,2,0)="the Outpatient Pharmacy V. 7.0 package."
^DIC(9.4,60,22,13,"PAH",227,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,4,0)="As per the Health Data Repository (HDR) request, thirteen new data fields"
^DIC(9.4,60,22,13,"PAH",227,1,5,0)="were added to the current Outpatient Pharmacy Vista Data Extraction"
^DIC(9.4,60,22,13,"PAH",227,1,6,0)="Framework (VDEF) HEALTH LEVEL SEVEN (HL7) message that sends prescription"
^DIC(9.4,60,22,13,"PAH",227,1,7,0)="information to the HDR."
^DIC(9.4,60,22,13,"PAH",227,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,9,0)="This patch affects the background HL7 processing only; users will not see"
^DIC(9.4,60,22,13,"PAH",227,1,10,0)="any functional changes."
^DIC(9.4,60,22,13,"PAH",227,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,12,0)="For more information on the addition of the thirteen new data fields,"
^DIC(9.4,60,22,13,"PAH",227,1,13,0)="please refer to Appendix D of the Outpatient Pharmacy V. 7.0 Technical"
^DIC(9.4,60,22,13,"PAH",227,1,14,0)="Manual / Security Guide that is being updated with this patch."
^DIC(9.4,60,22,13,"PAH",227,1,15,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,16,0)="This patch also corrects the problem of a VDEF message not being sent to"
^DIC(9.4,60,22,13,"PAH",227,1,17,0)="the HDR when a refill is deleted from a prescription as a result of the"
^DIC(9.4,60,22,13,"PAH",227,1,18,0)="refill being returned to stock."
^DIC(9.4,60,22,13,"PAH",227,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,20,0)="**** VERY IMPORTANT ****"
^DIC(9.4,60,22,13,"PAH",227,1,21,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,22,0)="You must suspend the VDEF Request Queue before installing this patch and"
^DIC(9.4,60,22,13,"PAH",227,1,23,0)="then re-enable it after installation of the patch. Keep in mind that the"
^DIC(9.4,60,22,13,"PAH",227,1,24,0)="suspension of the VDEF Request Queue will not prevent any new requests in"
^DIC(9.4,60,22,13,"PAH",227,1,25,0)="Outpatient Pharmacy VDEF Domain application from being added to the VDEF"
^DIC(9.4,60,22,13,"PAH",227,1,26,0)="Request Queue, it will only delay the building of these VDEF HL7 messages"
^DIC(9.4,60,22,13,"PAH",227,1,27,0)="until the VDEF Request Queue is enabled again. The steps for doing that"
^DIC(9.4,60,22,13,"PAH",227,1,28,0)="are outlined in the Installation Instructions section."
^DIC(9.4,60,22,13,"PAH",227,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,31,0)="MISCELLANEOUS FIXES:"
^DIC(9.4,60,22,13,"PAH",227,1,32,0)="--------------------"
^DIC(9.4,60,22,13,"PAH",227,1,33,0)="1. The hidden action ""RS"" for Reprint Signature log that was sent in"
^DIC(9.4,60,22,13,"PAH",227,1,34,0)="patch PSO*7*200, was overwriting the action ""OTH"" for Other OP Actions,"
^DIC(9.4,60,22,13,"PAH",227,1,35,0)="making the OTH action unavailable. The post-install routine PSOP261"
^DIC(9.4,60,22,13,"PAH",227,1,36,0)="included in this patch (PSO*7*261) fixes this."
^DIC(9.4,60,22,13,"PAH",227,1,37,0)=" "
^DIC(9.4,60,22,13,"PAH",227,1,38,0)="2. An undefined error was identified by a site that went live with Remote"
^DIC(9.4,60,22,13,"PAH",227,1,39,0)="Data Interoperability (RDI) patches. A common variable was being killed by"
^DIC(9.4,60,22,13,"PAH",227,1,40,0)="another package. The fix is to save the value of the variable before"
^DIC(9.4,60,22,13,"PAH",227,1,41,0)="making the call to retrieve remote allergy data and to restore the"
^DIC(9.4,60,22,13,"PAH",227,1,42,0)="variable to the saved value once control is returned to the calling"
^DIC(9.4,60,22,13,"PAH",227,1,43,0)="routine."
^DIC(9.4,60,22,13,"PAH",228,0)="265 SEQ #234^3070905.003646^1"
^DIC(9.4,60,22,13,"PAH",228,1,0)="^^5^5^3070905"
^DIC(9.4,60,22,13,"PAH",228,1,1,0)="PSI-07-029 patch fix"
^DIC(9.4,60,22,13,"PAH",228,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",228,1,3,0)="Corrects undefined filing errors for NON-VA Meds when an embedded"
^DIC(9.4,60,22,13,"PAH",228,1,4,0)="semi-colon is entered in either the Dosag field or the Schedule field in"
^DIC(9.4,60,22,13,"PAH",228,1,5,0)="CPRS as free form text."
^DIC(9.4,60,22,13,"PAH",229,0)="249 SEQ #235^3070905.004624^1"
^DIC(9.4,60,22,13,"PAH",229,1,0)="^^3^3^3070905"
^DIC(9.4,60,22,13,"PAH",229,1,1,0)="Cancel date"
^DIC(9.4,60,22,13,"PAH",229,1,2,0)="Scriptalk issue"
^DIC(9.4,60,22,13,"PAH",229,1,3,0)="Fileman API"
^DIC(9.4,60,22,13,"PAH",230,0)="267 SEQ #236^3070905.005108^1"
^DIC(9.4,60,22,13,"PAH",230,1,0)="^^57^57^3070905"
^DIC(9.4,60,22,13,"PAH",230,1,1,0)="This patch enhances the functionality of PSODI, PSO59, and PSO52EX."
^DIC(9.4,60,22,13,"PAH",230,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,3,0)="PSODI contains a new Application Programmer Interface (API) named GET1."
^DIC(9.4,60,22,13,"PAH",230,1,4,0)="This API will invoke the $$GET1^DIQ FileMan Database Server (DBS) call and"
^DIC(9.4,60,22,13,"PAH",230,1,5,0)="is to be used as an extrinsic function.  GET1 has five parameters:"
^DIC(9.4,60,22,13,"PAH",230,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,7,0)="   PSOFILE: FILE OR SUBFILE NUMBER TO RETRIEVE DATA FROM [REQUIRED]"
^DIC(9.4,60,22,13,"PAH",230,1,8,0)="   PSOIEN: IEN TO RETRIEVE DATA FROM [REQUIRED] "
^DIC(9.4,60,22,13,"PAH",230,1,9,0)="   PSOFIELD: FIELD TO RETRIEVE DATA FROM [REQUIRED] "
^DIC(9.4,60,22,13,"PAH",230,1,10,0)="   PSOFLAGS: CONTROLS THE PROCESSING OF DATA RETURNED [OPTIONAL] "
^DIC(9.4,60,22,13,"PAH",230,1,11,0)="   PSOWORD: RETURN OF WORD PROCESSING FIELDS [REQUIRED only with word "
^DIC(9.4,60,22,13,"PAH",230,1,12,0)="   processing fields]"
^DIC(9.4,60,22,13,"PAH",230,1,13,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,14,0)="If a file access error is encountered, the calling application will have"
^DIC(9.4,60,22,13,"PAH",230,1,15,0)="""0^FILE ACCESS ERROR"" returned.  If a FileMan error has occurred, the"
^DIC(9.4,60,22,13,"PAH",230,1,16,0)="calling application will have ""0^FILEMAN UNABLE TO PROCESS REQUEST"""
^DIC(9.4,60,22,13,"PAH",230,1,17,0)="returned.  A successful data retrieval will return in the format ""1^(FIELD"
^DIC(9.4,60,22,13,"PAH",230,1,18,0)="DATA)"".  When retrieving data from a word processing field, an array name"
^DIC(9.4,60,22,13,"PAH",230,1,19,0)="must be passed in to PSOWORD.  Once the word processing field is returned,"
^DIC(9.4,60,22,13,"PAH",230,1,20,0)="it will then populate an array as defined by PSOWORD and the calling"
^DIC(9.4,60,22,13,"PAH",230,1,21,0)="application will have ""1^(PSOWORD)"" returned.  If there is no data in the"
^DIC(9.4,60,22,13,"PAH",230,1,22,0)="Word Processing field, the calling application will have ""1^"" returned,"
^DIC(9.4,60,22,13,"PAH",230,1,23,0)="and the array defined by PSOWORD will be empty."
^DIC(9.4,60,22,13,"PAH",230,1,24,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,25,0)="Please see the VA FileMan Programmer Manual V. 22.0 for $$GET1^DIQ input"
^DIC(9.4,60,22,13,"PAH",230,1,26,0)="definitions and DBIA 4858 for further description."
^DIC(9.4,60,22,13,"PAH",230,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,28,0)="PSO59 retrieves data from the OUTPATIENT SITE file (#59) and has three "
^DIC(9.4,60,22,13,"PAH",230,1,29,0)="parameters: PSOIEN (optional), PSOTXT (optional), and LIST (required).  "
^DIC(9.4,60,22,13,"PAH",230,1,30,0)="While PSOIEN and PSOTXT are both labeled as optional, PSO59 requires that "
^DIC(9.4,60,22,13,"PAH",230,1,31,0)="either parameter be passed in or no data will be returned.  PSOIEN is the "
^DIC(9.4,60,22,13,"PAH",230,1,32,0)="internal entry number (IEN) of a site, PSOTXT is a free text entry that "
^DIC(9.4,60,22,13,"PAH",230,1,33,0)="works as a search parameter, and LIST is the subscript name used in the "
^DIC(9.4,60,22,13,"PAH",230,1,34,0)="^TMP global. The new functionality now allows the user to pass in ""??"" to "
^DIC(9.4,60,22,13,"PAH",230,1,35,0)="retrieve all divisions in the file and subscripts them accordingly.  If "
^DIC(9.4,60,22,13,"PAH",230,1,36,0)="both an IEN and ""??"" are passed in, PSO59 will ignore the ""??"" and return"
^DIC(9.4,60,22,13,"PAH",230,1,37,0)="data specific to the IEN.  "
^DIC(9.4,60,22,13,"PAH",230,1,38,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,39,0)="Please refer to DBIA 4827 for further description on PSO59."
^DIC(9.4,60,22,13,"PAH",230,1,40,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,41,0)="PSO52EX contains a new Application Programmer Interface (API) named "
^DIC(9.4,60,22,13,"PAH",230,1,42,0)="ARXREF. This API is to be used as an extrinsic function call and requires"
^DIC(9.4,60,22,13,"PAH",230,1,43,0)="three parameters: PSODATE, PSOIEN, and PSOFILL.  PSODATE is the RELEASED "
^DIC(9.4,60,22,13,"PAH",230,1,44,0)="DATE/TIME field (#31) and PSOIEN is the internal entry number from the "
^DIC(9.4,60,22,13,"PAH",230,1,45,0)="PRESCRIPTION file (#52).  PSOFILL is the fill number of prescription (0 "
^DIC(9.4,60,22,13,"PAH",230,1,46,0)="for Original Fill, 1 for Refill #1, 2 for Refill #2, etc.).  The user can"
^DIC(9.4,60,22,13,"PAH",230,1,47,0)="set a local variable equal to the return value of ARXREF. If the return"
^DIC(9.4,60,22,13,"PAH",230,1,48,0)="value equals:"
^DIC(9.4,60,22,13,"PAH",230,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,50,0)="   0 (zero) = Data does not exist in the ""AR"" cross reference, indicating"
^DIC(9.4,60,22,13,"PAH",230,1,51,0)="   the fill was not dispensed from the Consolidated Mail Outpatient"
^DIC(9.4,60,22,13,"PAH",230,1,52,0)="   Pharmacy (CMOP)."
^DIC(9.4,60,22,13,"PAH",230,1,53,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,54,0)="   1 (one) = Data does exist in the ""AR"" cross reference, indicating the"
^DIC(9.4,60,22,13,"PAH",230,1,55,0)="   fill was dispensed from the CMOP."
^DIC(9.4,60,22,13,"PAH",230,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",230,1,57,0)="Please refer to DBIA 4902 for further description on PSO52EX."
^DIC(9.4,60,22,13,"PAH",231,0)="268 SEQ #237^3070905.011234^1"
^DIC(9.4,60,22,13,"PAH",231,1,0)="^^155^155^3070905"
^DIC(9.4,60,22,13,"PAH",231,1,1,0)="This patch is part of the third quarter enhancements release for the"
^DIC(9.4,60,22,13,"PAH",231,1,2,0)="Outpatient Pharmacy V. 7.0 package."
^DIC(9.4,60,22,13,"PAH",231,1,3,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,4,0)="1. With the deployment of Cache version 5, it was discovered that the"
^DIC(9.4,60,22,13,"PAH",231,1,5,0)="   short lock timeout values could generate a lock failure. Patch"
^DIC(9.4,60,22,13,"PAH",231,1,6,0)="   DI*22*147, which has already been released, provided a solution to"
^DIC(9.4,60,22,13,"PAH",231,1,7,0)="   resolve this issue and future lock issues."
^DIC(9.4,60,22,13,"PAH",231,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,9,0)="   This patch instituted a new default lock timeout of three seconds based"
^DIC(9.4,60,22,13,"PAH",231,1,10,0)="   on a global node setting of ^DD(""DILOCKTM"")=3."
^DIC(9.4,60,22,13,"PAH",231,1,11,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,12,0)="   In order to avoid the lock issue in Outpatient Pharmacy, this patch"
^DIC(9.4,60,22,13,"PAH",231,1,13,0)="   modifies all routines that currently use a lock timeout value of less"
^DIC(9.4,60,22,13,"PAH",231,1,14,0)="   than 3 seconds to check for the node ^DD(""DILOCKTM"") and to use the"
^DIC(9.4,60,22,13,"PAH",231,1,15,0)="   value defined there, otherwise the lock timeout value is set to a"
^DIC(9.4,60,22,13,"PAH",231,1,16,0)="   default value of 3 seconds."
^DIC(9.4,60,22,13,"PAH",231,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,18,0)="2. PSI-06-186  - Changing dispense drug and SIG"
^DIC(9.4,60,22,13,"PAH",231,1,19,0)="   When finishing a new order using the Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",231,1,20,0)="   [PSO LM BACKDOOR ORDERS] option, and answering ""NO"" to the prompt"
^DIC(9.4,60,22,13,"PAH",231,1,21,0)="   ""Is this correct? YES//"", the software allows the option to edit"
^DIC(9.4,60,22,13,"PAH",231,1,22,0)="   the dispense drug. It allows you to select any active drug from the"
^DIC(9.4,60,22,13,"PAH",231,1,23,0)="   DRUG file (#50) and accept the order even though the entered SIG is"
^DIC(9.4,60,22,13,"PAH",231,1,24,0)="   incorrect. This patch will not list all the active drugs for selection"
^DIC(9.4,60,22,13,"PAH",231,1,25,0)="   during dispense drug edit, but will list only those drugs that are tied"
^DIC(9.4,60,22,13,"PAH",231,1,26,0)="   to that orderable item in the DRUG file (#50)."
^DIC(9.4,60,22,13,"PAH",231,1,27,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,28,0)="   When the dispense drug is changed the software prompts ""Do You want to"
^DIC(9.4,60,22,13,"PAH",231,1,29,0)="   Edit the SIG?  NO//."" To read the current SIG you may have to scroll"
^DIC(9.4,60,22,13,"PAH",231,1,30,0)="   the screen up. This patch will now display the current SIG along with"
^DIC(9.4,60,22,13,"PAH",231,1,31,0)="   the prompt ""Do You want to Edit the SIG? YES//."""
^DIC(9.4,60,22,13,"PAH",231,1,32,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,33,0)="   A similar modification is also done in this patch for editing an"
^DIC(9.4,60,22,13,"PAH",231,1,34,0)="   existing prescription and the dispense drug is changed, to display the"
^DIC(9.4,60,22,13,"PAH",231,1,35,0)="   current SIG along with the prompt ""Do You want to Edit the SIG? YES//."""
^DIC(9.4,60,22,13,"PAH",231,1,36,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,37,0)="   When finishing a pending order through the backdoor, the software"
^DIC(9.4,60,22,13,"PAH",231,1,38,0)="   allows the option to edit the orderable item and select a different"
^DIC(9.4,60,22,13,"PAH",231,1,39,0)="   dispense drug, but does not prompt you to change the SIG. This can"
^DIC(9.4,60,22,13,"PAH",231,1,40,0)="   lead to incorrect SIG. This patch will now prompt the question"
^DIC(9.4,60,22,13,"PAH",231,1,41,0)="   ""Do You want to Edit the SIG? YES//."""
^DIC(9.4,60,22,13,"PAH",231,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,43,0)="3. This patch adds SERVICE REJECT to the current list of selection for"
^DIC(9.4,60,22,13,"PAH",231,1,44,0)="   the Nature of Order prompt."
^DIC(9.4,60,22,13,"PAH",231,1,45,0)="   Example:"
^DIC(9.4,60,22,13,"PAH",231,1,46,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,47,0)="   Nature of Order: WRITTEN// ?"
^DIC(9.4,60,22,13,"PAH",231,1,48,0)="   Choose from:"
^DIC(9.4,60,22,13,"PAH",231,1,49,0)="   1            WRITTEN     W"
^DIC(9.4,60,22,13,"PAH",231,1,50,0)="   2            VERBAL     V"
^DIC(9.4,60,22,13,"PAH",231,1,51,0)="   3            TELEPHONED     P"
^DIC(9.4,60,22,13,"PAH",231,1,52,0)="   4            SERVICE CORRECTION     S"
^DIC(9.4,60,22,13,"PAH",231,1,53,0)="   5            POLICY     I"
^DIC(9.4,60,22,13,"PAH",231,1,54,0)="   6            DUPLICATE     D"
^DIC(9.4,60,22,13,"PAH",231,1,55,0)="   12           SERVICE REJECT     R"
^DIC(9.4,60,22,13,"PAH",231,1,56,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,57,0)="4. PSI-06-184 - Enhancements for No Allergy Assessment"
^DIC(9.4,60,22,13,"PAH",231,1,58,0)="   The following changes are included to make the pharmacist aware/act on"
^DIC(9.4,60,22,13,"PAH",231,1,59,0)="   prescriptions if they're being entered/finished for a patient with no"
^DIC(9.4,60,22,13,"PAH",231,1,60,0)="   allergy assessment:"
^DIC(9.4,60,22,13,"PAH",231,1,61,0)="   a. Within the profile information, display ""No Allergy Assessment"""
^DIC(9.4,60,22,13,"PAH",231,1,62,0)="      next to the allergy header (like ""NKA"" currently shows)"
^DIC(9.4,60,22,13,"PAH",231,1,63,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,64,0)="   b. At the same spot where checking for bad address, add a check for"
^DIC(9.4,60,22,13,"PAH",231,1,65,0)="      no allergy assessment and provide a message to the user. (When the"
^DIC(9.4,60,22,13,"PAH",231,1,66,0)="      user continues on, he could choose EA to enter allergy information,"
^DIC(9.4,60,22,13,"PAH",231,1,67,0)="      stop with that patient, or continue on with ordering or finishing)."
^DIC(9.4,60,22,13,"PAH",231,1,68,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,69,0)="   c. On the profile header, on the right side of the line with patient"
^DIC(9.4,60,22,13,"PAH",231,1,70,0)="      name where <A> currently shows in reverse video if the patient has"
^DIC(9.4,60,22,13,"PAH",231,1,71,0)="      any allergy/adverse reaction information on file, show  <NO ALLERGY"
^DIC(9.4,60,22,13,"PAH",231,1,72,0)="      ASSESSMENT> in reverse video if no assessment has been done."
^DIC(9.4,60,22,13,"PAH",231,1,73,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,74,0)="   d. If the pharmacist proceeds with drug entry for a patient with no"
^DIC(9.4,60,22,13,"PAH",231,1,75,0)="      allergy assessment, prompt to intervene just as if there had been an"
^DIC(9.4,60,22,13,"PAH",231,1,76,0)="      allergy reaction and treat this like a critical interaction. (i.e."
^DIC(9.4,60,22,13,"PAH",231,1,77,0)="      require them to choose to continue processing and if so, prompt for"
^DIC(9.4,60,22,13,"PAH",231,1,78,0)="      an intervention."
^DIC(9.4,60,22,13,"PAH",231,1,79,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,80,0)="      Note: When flagging is available in backdoor Outpatient Pharmacy for"
^DIC(9.4,60,22,13,"PAH",231,1,81,0)="      pending orders, procedurally sites can choose to flag pending orders"
^DIC(9.4,60,22,13,"PAH",231,1,82,0)="      for patients awaiting an allergy assessment."
^DIC(9.4,60,22,13,"PAH",231,1,83,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,84,0)="5. The patient's eligibility will be displayed before prompting for"
^DIC(9.4,60,22,13,"PAH",231,1,85,0)="   patient status when finishing prescriptions or entering new orders (to"
^DIC(9.4,60,22,13,"PAH",231,1,86,0)="   ensure that the proper entry from the RX PATIENT STATUS file (#53) is"
^DIC(9.4,60,22,13,"PAH",231,1,87,0)="   being selected. This is stored in the PATIENT STATUS field (#3) of the"
^DIC(9.4,60,22,13,"PAH",231,1,88,0)="   PHARMACY PATIENT file (#55)):"
^DIC(9.4,60,22,13,"PAH",231,1,89,0)="   a. In the Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",231,1,90,0)="      option, redisplay the eligibility just before prompting for patient"
^DIC(9.4,60,22,13,"PAH",231,1,91,0)="      status."
^DIC(9.4,60,22,13,"PAH",231,1,92,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,93,0)="   b. In the Complete Orders from OERR [PSO LMOE FINISH] option, after"
^DIC(9.4,60,22,13,"PAH",231,1,94,0)="      displaying patient name, display eligibility and prompt for patient"
^DIC(9.4,60,22,13,"PAH",231,1,95,0)="      status."
^DIC(9.4,60,22,13,"PAH",231,1,96,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,97,0)="   c. In both options, use RX PATIENT STATUS: for the prompt instead of"
^DIC(9.4,60,22,13,"PAH",231,1,98,0)="      PATIENT STATUS:"
^DIC(9.4,60,22,13,"PAH",231,1,99,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,100,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,101,0)="Example 1 - Patient Prescription Processing:"
^DIC(9.4,60,22,13,"PAH",231,1,102,0)="Select Action: Next Screen// NO   New Order"
^DIC(9.4,60,22,13,"PAH",231,1,103,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,104,0)="Eligibility: SERVICE CONNECTED 50% to 100%     SC%: 60"
^DIC(9.4,60,22,13,"PAH",231,1,105,0)="RX PATIENT STATUS: AUTH ABS -96//"
^DIC(9.4,60,22,13,"PAH",231,1,106,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,107,0)="Example 2 - Complete Orders from OERR:"
^DIC(9.4,60,22,13,"PAH",231,1,108,0)="Select By:  (PA/RT/PR/CL/E): PATIENT// ROUTE"
^DIC(9.4,60,22,13,"PAH",231,1,109,0)="Route:  (W/M/C/E): WINDOW// MAIL"
^DIC(9.4,60,22,13,"PAH",231,1,110,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,112,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,113,0)="          OPPATIENT,ONE (666-00-0777)"
^DIC(9.4,60,22,13,"PAH",231,1,114,0)="     No Allergy Assessment!"
^DIC(9.4,60,22,13,"PAH",231,1,115,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,116,0)="Eligibility: NSC"
^DIC(9.4,60,22,13,"PAH",231,1,117,0)="RX PATIENT STATUS: OPT NSC//"
^DIC(9.4,60,22,13,"PAH",231,1,118,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,119,0)="6. In the Patient Prescription Processing [PSO LM BACKDOOR ORDERS]"
^DIC(9.4,60,22,13,"PAH",231,1,120,0)="   option, if the Patient Update ""PU"" action is chosen and the PATIENT"
^DIC(9.4,60,22,13,"PAH",231,1,121,0)="   STATUS is changed to a new one, when returning to the option and"
^DIC(9.4,60,22,13,"PAH",231,1,122,0)="   choosing ""NO"" for New Order, the default PATIENT STATUS displayed is"
^DIC(9.4,60,22,13,"PAH",231,1,123,0)="   the one before the PU change was done. This patch makes a correction"
^DIC(9.4,60,22,13,"PAH",231,1,124,0)="   to refresh the PATIENT STATUS before displaying the default."
^DIC(9.4,60,22,13,"PAH",231,1,125,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,126,0)="7. When selecting a patient in the Patient Prescription Processing [PSO"
^DIC(9.4,60,22,13,"PAH",231,1,127,0)="   LM BACKDOOR ORDERS] option or the Complete Orders from OERR [PSO LMOE"
^DIC(9.4,60,22,13,"PAH",231,1,128,0)="   FINISH] option, if Remote Data Interoperability (RDI) is turned on, a"
^DIC(9.4,60,22,13,"PAH",231,1,129,0)="   check has been added to check for the ability to access remote data."
^DIC(9.4,60,22,13,"PAH",231,1,130,0)="   If a problem has been detected with accessing remote data, the patient"
^DIC(9.4,60,22,13,"PAH",231,1,131,0)="   selection will display ""Remote data not available - Only local order"
^DIC(9.4,60,22,13,"PAH",231,1,132,0)="   checks processed."" once per patient rather than for each individual"
^DIC(9.4,60,22,13,"PAH",231,1,133,0)="   order."
^DIC(9.4,60,22,13,"PAH",231,1,134,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,135,0)="8. If the MAIL STATUS EXPIRATION DATE field (#.05) in the PHARMACY PATIENT"
^DIC(9.4,60,22,13,"PAH",231,1,136,0)="   file (#55) is less than today, the MAIL field (#.03) displays on"
^DIC(9.4,60,22,13,"PAH",231,1,137,0)="   the patient profile as if it is still active. This patch adds the"
^DIC(9.4,60,22,13,"PAH",231,1,138,0)="   display of the MAIL STATUS EXPIRATION DATE field next to the MAIL"
^DIC(9.4,60,22,13,"PAH",231,1,139,0)="   field on the patient profile for MAIL settings of Do Not Mail, Local -"
^DIC(9.4,60,22,13,"PAH",231,1,140,0)="   Regular Mail and Local - Certified Mail if the mail status is expired."
^DIC(9.4,60,22,13,"PAH",231,1,141,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,142,0)="9. Following the installation of patch PSO*7*200, a site noticed that 6"
^DIC(9.4,60,22,13,"PAH",231,1,143,0)="   digits of the social security number were printing when using the new"
^DIC(9.4,60,22,13,"PAH",231,1,144,0)="   hidden ""RS"" action to reprint the signature log. This patch changes it"
^DIC(9.4,60,22,13,"PAH",231,1,145,0)="   to 4 digits to match the rest of the labels."
^DIC(9.4,60,22,13,"PAH",231,1,146,0)=" "
^DIC(9.4,60,22,13,"PAH",231,1,147,0)="10. In patch PSO*7*200, functionality was provided to use the new"
^DIC(9.4,60,22,13,"PAH",231,1,148,0)="    commercial warning label to send prescriptions to the automated"
^DIC(9.4,60,22,13,"PAH",231,1,149,0)="    filling equipment. One site reported a problem when using the old"
^DIC(9.4,60,22,13,"PAH",231,1,150,0)="    warning labels, that the HEALTH LEVEL SEVEN (HL7) message sent to"
^DIC(9.4,60,22,13,"PAH",231,1,151,0)="    Optifill was causing an error. This happens when the label text length"
^DIC(9.4,60,22,13,"PAH",231,1,152,0)="    is greater than 512 characters. To prevent this error, this patch"
^DIC(9.4,60,22,13,"PAH",231,1,153,0)="    ensures that the label text length sent does not exceed 245 "
^DIC(9.4,60,22,13,"PAH",231,1,154,0)="    characters. If the label text length exceeds 245 characters, then the"
^DIC(9.4,60,22,13,"PAH",231,1,155,0)="    additional text will be parsed and sent in additional messages."
^DIC(9.4,60,22,13,"PAH",232,0)="273 SEQ #238^3071212.201604^1"
^DIC(9.4,60,22,13,"PAH",232,1,0)="^^13^13^3071212"
^DIC(9.4,60,22,13,"PAH",232,1,1,0)="This patch enhances the functionality of PSO59."
^DIC(9.4,60,22,13,"PAH",232,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",232,1,3,0)="PSO59 retrieves data from the OUTPATIENT SITE file (#59) and has three "
^DIC(9.4,60,22,13,"PAH",232,1,4,0)="parameters: PSOIEN (optional), PSOTXT (optional), and LIST (required).  "
^DIC(9.4,60,22,13,"PAH",232,1,5,0)="While PSOIEN and PSOTXT are both labeled as optional, PSO59 requires that "
^DIC(9.4,60,22,13,"PAH",232,1,6,0)="either parameter be passed in or no data will be returned.  PSOIEN is the "
^DIC(9.4,60,22,13,"PAH",232,1,7,0)="internal entry number (IEN) of a site, PSOTXT is a free text entry that "
^DIC(9.4,60,22,13,"PAH",232,1,8,0)="works as a search parameter, and LIST is the subscript name used in the "
^DIC(9.4,60,22,13,"PAH",232,1,9,0)="^TMP global.  This routine will now return field values for the NPI "
^DIC(9.4,60,22,13,"PAH",232,1,10,0)="INSTITUTION field (#101) and NCPDP NUMBER field (#1008) from the "
^DIC(9.4,60,22,13,"PAH",232,1,11,0)="OUTPATIENT SITE file (#59)."
^DIC(9.4,60,22,13,"PAH",232,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",232,1,13,0)="Please refer to DBIA 4827 for further description on PSO59."
^DIC(9.4,60,22,13,"PAH",233,0)="278 SEQ #239^3071212.205515^1"
^DIC(9.4,60,22,13,"PAH",233,1,0)="^^11^11^3071212"
^DIC(9.4,60,22,13,"PAH",233,1,1,0)="In backdoor pharmacy, when placing a new order, renewing an existing"
^DIC(9.4,60,22,13,"PAH",233,1,2,0)="Order, or copying an order to a new order, if a patient is eligible for"
^DIC(9.4,60,22,13,"PAH",233,1,3,0)="COMBAT VET (CV), the default answer to the prompt ""Was treatment related"
^DIC(9.4,60,22,13,"PAH",233,1,4,0)="to Combat"" is currently presented as Null. This patch will change the"
^DIC(9.4,60,22,13,"PAH",233,1,5,0)="default answer, currently Null, to 'Yes'."
^DIC(9.4,60,22,13,"PAH",233,1,6,0)=" "
^DIC(9.4,60,22,13,"PAH",233,1,7,0)="Note:"
^DIC(9.4,60,22,13,"PAH",233,1,8,0)=" "
^DIC(9.4,60,22,13,"PAH",233,1,9,0)="When finishing a pending order the current functionality related to the"
^DIC(9.4,60,22,13,"PAH",233,1,10,0)="CV question will remain the same, i.e., the default answer will be set to"
^DIC(9.4,60,22,13,"PAH",233,1,11,0)="either 'Yes' or 'No' depending on what is being marked by the provider."
^DIC(9.4,60,22,13,"PAH",234,0)="260^3071212.214901^1"
^DIC(9.4,60,22,13,"PAH",235,0)="264 SEQ #241^3071212.215207^1"
^DIC(9.4,60,22,13,"PAH",235,1,0)="^^157^157^3071212"
^DIC(9.4,60,22,13,"PAH",235,1,1,0)="The FY07 Q4 Enhancement Release includes the following PSO enhancements:"
^DIC(9.4,60,22,13,"PAH",235,1,2,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,3,0)="1. Internet Refill Automation and Reporting"
^DIC(9.4,60,22,13,"PAH",235,1,4,0)="   a. Internet Refill Automation Job"
^DIC(9.4,60,22,13,"PAH",235,1,5,0)="      Added a new Automate Internet Refill [PSO AUTO REFILL INITIALIZE]"
^DIC(9.4,60,22,13,"PAH",235,1,6,0)="      option to the Maintenance (Outpatient Pharmacy) [PSO MAINTENANCE]"
^DIC(9.4,60,22,13,"PAH",235,1,7,0)="      menu that allows the sites to schedule/un-schedule a background job"
^DIC(9.4,60,22,13,"PAH",235,1,8,0)="      to automatically process refill requests placed via the Internet. It"
^DIC(9.4,60,22,13,"PAH",235,1,9,0)="      requires the PSOAUTRF key and generates MailMan messages by division"
^DIC(9.4,60,22,13,"PAH",235,1,10,0)="      to holders of the PSOAUTRF key with details of Not-Filled refills,"
^DIC(9.4,60,22,13,"PAH",235,1,11,0)="      unsuccessful runs, count of refills processed successfully, etc."
^DIC(9.4,60,22,13,"PAH",235,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,13,0)="      Note: The new PSOAUTRF security key is transported in this patch and"
^DIC(9.4,60,22,13,"PAH",235,1,14,0)="            should be assigned to the appropriate personnel to setup the"
^DIC(9.4,60,22,13,"PAH",235,1,15,0)="            above job."
^DIC(9.4,60,22,13,"PAH",235,1,16,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,17,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,18,0)="      Example: If the patient is marked as dead, the following message is"
^DIC(9.4,60,22,13,"PAH",235,1,19,0)="               generated:"
^DIC(9.4,60,22,13,"PAH",235,1,20,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,21,0)="      Subj: ALBANY Internet Refills Not Processed List,  [#104161]"
^DIC(9.4,60,22,13,"PAH",235,1,22,0)="      08/10/07@09:12 11 lines"
^DIC(9.4,60,22,13,"PAH",235,1,23,0)="      From: POSTMASTER  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,60,22,13,"PAH",235,1,24,0)="      ------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",235,1,25,0)="      Internet Refills Not Processed Report for the ALBANY Division."
^DIC(9.4,60,22,13,"PAH",235,1,26,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,27,0)="      The following refill requests were not processed:"
^DIC(9.4,60,22,13,"PAH",235,1,28,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,29,0)="      Patient: OPPATIENT,SEVEN   SSN: 0000"
^DIC(9.4,60,22,13,"PAH",235,1,30,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,31,0)="      Rx #: 100002461  (REF #1)  Qty: 2"
^DIC(9.4,60,22,13,"PAH",235,1,32,0)="      Drug: ASPIRIN 650MG SUPPOSITORIES"
^DIC(9.4,60,22,13,"PAH",235,1,33,0)="      Reason: Patient Died on AUG 10, 2007"
^DIC(9.4,60,22,13,"PAH",235,1,34,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,35,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,36,0)="   b. Added two new fields, PROCESS AUTO REFILLS FOR INPAT field (#2030)"
^DIC(9.4,60,22,13,"PAH",235,1,37,0)="      and PROCESS AUTO REFILLS FOR CNH field (#2035), to the OUTPATIENT"
^DIC(9.4,60,22,13,"PAH",235,1,38,0)="      SITE file (#59) to allow the sites to process/not to process refills"
^DIC(9.4,60,22,13,"PAH",235,1,39,0)="      for inpatients and CNH patients for the scheduled job defined in"
^DIC(9.4,60,22,13,"PAH",235,1,40,0)="      item 1.a above. It will process these refills only if the site has"
^DIC(9.4,60,22,13,"PAH",235,1,41,0)="      flagged these fields as YES."
^DIC(9.4,60,22,13,"PAH",235,1,42,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,43,0)="      The Site Parameter Enter/Edit [PSO SITE PARAMETERS] option is also"
^DIC(9.4,60,22,13,"PAH",235,1,44,0)="      modified to include these two new fields."
^DIC(9.4,60,22,13,"PAH",235,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,46,0)="   c. Added a new LOGIN DATE field (#11) to the PRESCRIPTION REFILL"
^DIC(9.4,60,22,13,"PAH",235,1,47,0)="      REQUEST file (#52.43) to capture the date and time the refill"
^DIC(9.4,60,22,13,"PAH",235,1,48,0)="      request was made."
^DIC(9.4,60,22,13,"PAH",235,1,49,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,50,0)="   d. Added a new Internet Refill Report [PSO INTERNET REFILL REPORT]"
^DIC(9.4,60,22,13,"PAH",235,1,51,0)="      option, to the Output Reports [PSO OUTPUTS] menu that generates"
^DIC(9.4,60,22,13,"PAH",235,1,52,0)="      reports by division, detail, or summary of internet refills sorted"
^DIC(9.4,60,22,13,"PAH",235,1,53,0)="      by Patient, Date, or Result."
^DIC(9.4,60,22,13,"PAH",235,1,54,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,55,0)="2. Modified the Barcode Batch Prescription Entry [PSO BATCH BARCODE] and"
^DIC(9.4,60,22,13,"PAH",235,1,56,0)="   Process Internet Refills [PSO INTERNET REFILLS] options to provide"
^DIC(9.4,60,22,13,"PAH",235,1,57,0)="   separate prompts to Allow refills for inpatient and Allow refills for"
^DIC(9.4,60,22,13,"PAH",235,1,58,0)="   Contract Nursing Home (CNH) instead of a single prompt that applies to"
^DIC(9.4,60,22,13,"PAH",235,1,59,0)="   both."
^DIC(9.4,60,22,13,"PAH",235,1,60,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,61,0)="3. If the REGISTRATION package V. 5.3 patch DG*5.3*688 that introduces the"
^DIC(9.4,60,22,13,"PAH",235,1,62,0)="   COUNTRY field to the PATIENT file (#2) is installed, then:"
^DIC(9.4,60,22,13,"PAH",235,1,63,0)="  a. for Local Mail-outs with foreign addresses, the address information"
^DIC(9.4,60,22,13,"PAH",235,1,64,0)="     on the laser label mailing label is replaced with"
^DIC(9.4,60,22,13,"PAH",235,1,65,0)="     *** FOREIGN ADDRESS ***."
^DIC(9.4,60,22,13,"PAH",235,1,66,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,67,0)="  b. In print from suspense, if the address is foreign and the routing is"
^DIC(9.4,60,22,13,"PAH",235,1,68,0)="     not ""window"", the label will not print nor will the prescription be"
^DIC(9.4,60,22,13,"PAH",235,1,69,0)="     sent to automated filling equipment. The fill will remain on suspense"
^DIC(9.4,60,22,13,"PAH",235,1,70,0)="     until it is pulled early, or the routing is changed to window, or the"
^DIC(9.4,60,22,13,"PAH",235,1,71,0)="     address is changed."
^DIC(9.4,60,22,13,"PAH",235,1,72,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,73,0)="4. Added a new Queue CMOP Prescription [PSO RX QUEUE CMOP] option to the"
^DIC(9.4,60,22,13,"PAH",235,1,74,0)="   Suspense Functions [PSO PND] menu, Pharmacist Menu [PSO USER1] and"
^DIC(9.4,60,22,13,"PAH",235,1,75,0)="   Pharmacy Technician's Menu [PSO USER2] menu, to manually queue"
^DIC(9.4,60,22,13,"PAH",235,1,76,0)="   prescription to Consolidated Mail Outpatient Pharmacy (CMOP)."
^DIC(9.4,60,22,13,"PAH",235,1,77,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,78,0)="5. The software is modified to check if the Provider has a DEA number in"
^DIC(9.4,60,22,13,"PAH",235,1,79,0)="   the DEA# field (#53.2) or a VA number in the VA# field (#53.3) of the"
^DIC(9.4,60,22,13,"PAH",235,1,80,0)="   NEW PERSON file (#200) and the YSCL AUTHORIZED key to order clozapine"
^DIC(9.4,60,22,13,"PAH",235,1,81,0)="   drug. Previously, the check was only for the DEA#. If the ordering"
^DIC(9.4,60,22,13,"PAH",235,1,82,0)="   provider does not have the DEA# or the VA#, the order cannot be placed"
^DIC(9.4,60,22,13,"PAH",235,1,83,0)="   and user will see the message 'Provider must have a DEA# or VA# to"
^DIC(9.4,60,22,13,"PAH",235,1,84,0)="   write prescriptions for clozapine'. Also, if the provider does not hold"
^DIC(9.4,60,22,13,"PAH",235,1,85,0)="   the YSCL AUTHORIZED key, the message 'Provider must hold YSCL"
^DIC(9.4,60,22,13,"PAH",235,1,86,0)="   AUTHORIZED key to write prescriptions for clozapine' is displayed."
^DIC(9.4,60,22,13,"PAH",235,1,87,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,88,0)="   Note: The YSCL AUTHORIZED key was transported in the MENTAL HEALTH V."
^DIC(9.4,60,22,13,"PAH",235,1,89,0)="         5.01 patch YS*5.01*90 and should be assigned to the appropriate"
^DIC(9.4,60,22,13,"PAH",235,1,90,0)="         provider to write prescriptions for clozapine."
^DIC(9.4,60,22,13,"PAH",235,1,91,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,92,0)="6. The View Provider [PSO PROVIDER INQUIRE] option is modified to display"
^DIC(9.4,60,22,13,"PAH",235,1,93,0)="   the NPI field (#41.99) of the NEW PERSON file (#200)."
^DIC(9.4,60,22,13,"PAH",235,1,94,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,95,0)="7. Changes to the Patient Information (Profile) Screen"
^DIC(9.4,60,22,13,"PAH",235,1,96,0)=" a. The PATIENT STATUS field (#3) of the PHARMACY PATIENT file (#55) is"
^DIC(9.4,60,22,13,"PAH",235,1,97,0)="    added to the Patient Information screen. It will be displayed after"
^DIC(9.4,60,22,13,"PAH",235,1,98,0)="    the patient's eligibility."
^DIC(9.4,60,22,13,"PAH",235,1,99,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,100,0)="    Example:"
^DIC(9.4,60,22,13,"PAH",235,1,101,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,102,0)="    Patient Information        Aug 10, 2007@10:04:09       Page: 1 of 2"
^DIC(9.4,60,22,13,"PAH",235,1,103,0)="    OPPATIENT,SEVEN"
^DIC(9.4,60,22,13,"PAH",235,1,104,0)="                                                            <A>"
^DIC(9.4,60,22,13,"PAH",235,1,105,0)="    PID: 000-12-3456                        Ht(cm): _______ (______)"
^DIC(9.4,60,22,13,"PAH",235,1,106,0)="    DOB: DEC 1,1950 (56)                    Wt(kg): _______ (______)"
^DIC(9.4,60,22,13,"PAH",235,1,107,0)="    SEX: MALE"
^DIC(9.4,60,22,13,"PAH",235,1,108,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,109,0)="    Eligibility: NSC, VA PENSION"
^DIC(9.4,60,22,13,"PAH",235,1,110,0)="    RX PATIENT STATUS: OPT NSC"
^DIC(9.4,60,22,13,"PAH",235,1,111,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,112,0)="    Disabilities: POST-TRAUMATIC STRESS DISORDER-100% (SC),"
^DIC(9.4,60,22,13,"PAH",235,1,113,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,114,0)="    2222 CENTRAL AVE"
^DIC(9.4,60,22,13,"PAH",235,1,115,0)="                                                  HOME PHONE:"
^DIC(9.4,60,22,13,"PAH",235,1,116,0)="    ALBANY                                        CELL PHONE:"
^DIC(9.4,60,22,13,"PAH",235,1,117,0)="                                                  WORK PHONE:"
^DIC(9.4,60,22,13,"PAH",235,1,118,0)="    Prescription Mail Delivery: Regular Mail"
^DIC(9.4,60,22,13,"PAH",235,1,119,0)="    Cannot use safety caps."
^DIC(9.4,60,22,13,"PAH",235,1,120,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,121,0)="    Allergies"
^DIC(9.4,60,22,13,"PAH",235,1,122,0)="        Verified: PENICILLIN,"
^DIC(9.4,60,22,13,"PAH",235,1,123,0)="    +         Enter ?? for more actions"
^DIC(9.4,60,22,13,"PAH",235,1,124,0)="    EA  Enter/Edit Allergy/ADR Data         PU  Patient Record Update"
^DIC(9.4,60,22,13,"PAH",235,1,125,0)="    DD  Detailed Allergy/ADR List           EX  Exit Patient List"
^DIC(9.4,60,22,13,"PAH",235,1,126,0)="    Select Action: Next Screen//"
^DIC(9.4,60,22,13,"PAH",235,1,127,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,128,0)=" b. Change the existing 'PHONE:' label to 'HOME PHONE:', and also display"
^DIC(9.4,60,22,13,"PAH",235,1,129,0)="    the PHONE NUMBER [CELLULAR] field (#.134) and the PHONE NUMBER [WORK]"
^DIC(9.4,60,22,13,"PAH",235,1,130,0)="    field (#.132) of the PATIENT file (#2). The work and cell phone"
^DIC(9.4,60,22,13,"PAH",235,1,131,0)="    fields can be maintained via the PATIENT UPDATE (PU) action and the"
^DIC(9.4,60,22,13,"PAH",235,1,132,0)="    Update Patient Record [PSO PAT] option."
^DIC(9.4,60,22,13,"PAH",235,1,133,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,134,0)="8. Added a new hidden ListMan 'CM' action to the Medication Profile called"
^DIC(9.4,60,22,13,"PAH",235,1,135,0)="   Manual Queue to CMOP [PSO LM QUEUE TO CMOP] to the PSO HIDDEN ACTIONS"
^DIC(9.4,60,22,13,"PAH",235,1,136,0)="   #2 PROTOCOL, to manually queue selected prescriptions to CMOP."
^DIC(9.4,60,22,13,"PAH",235,1,137,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,138,0)="9. Added a new column showing the B/D/F (Bad Address Indicator/ Do Not"
^DIC(9.4,60,22,13,"PAH",235,1,139,0)="   Mail/ Foreign Address) to the Log of Suspended Rx's by Day (this"
^DIC(9.4,60,22,13,"PAH",235,1,140,0)="   Division) [PSO PNDLOG] option."
^DIC(9.4,60,22,13,"PAH",235,1,141,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,142,0)="10. Modified Bad Address Suspended List [PSO BAI SUSPENDED] option to"
^DIC(9.4,60,22,13,"PAH",235,1,143,0)="    include the prompt either B/D/F or 'ALL' in the unprinted suspended"
^DIC(9.4,60,22,13,"PAH",235,1,144,0)="    prescriptions report."
^DIC(9.4,60,22,13,"PAH",235,1,145,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,146,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,147,0)="MISCELLANEOUS FIXES:"
^DIC(9.4,60,22,13,"PAH",235,1,148,0)="-------------------"
^DIC(9.4,60,22,13,"PAH",235,1,149,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,150,0)="1. With the release of PSO*7*260, a line of code was missing from the"
^DIC(9.4,60,22,13,"PAH",235,1,151,0)="   View Prescription [PSO VIEW] option that displays Dosage, Verb,"
^DIC(9.4,60,22,13,"PAH",235,1,152,0)="   Dispense Unit, Noun, Route, and Schedule. This patch restores this"
^DIC(9.4,60,22,13,"PAH",235,1,153,0)="   functionality."
^DIC(9.4,60,22,13,"PAH",235,1,154,0)=" "
^DIC(9.4,60,22,13,"PAH",235,1,155,0)="2. The field description of the REFILL INACTIVE DRUG RXS field (#.111) of"
^DIC(9.4,60,22,13,"PAH",235,1,156,0)="   the OUTPATIENT SITE file (#59) has a typo. It is corrected to"
^DIC(9.4,60,22,13,"PAH",235,1,157,0)="   'prescription'."
^DIC(9.4,60,22,13,"PAH",236,0)="285 SEQ #242^3071212.225306^1"
^DIC(9.4,60,22,13,"PAH",236,1,0)="^^15^15^3071212"
^DIC(9.4,60,22,13,"PAH",236,1,1,0)="This patch has enhancements which extend the capabilities of the Veterans"
^DIC(9.4,60,22,13,"PAH",236,1,2,0)="Health Information Systems and Technology Architecture (VistA) electronic"
^DIC(9.4,60,22,13,"PAH",236,1,3,0)="pharmacy (ePharmacy) system.  "
^DIC(9.4,60,22,13,"PAH",236,1,4,0)=" "
^DIC(9.4,60,22,13,"PAH",236,1,5,0)="This patch modifies the Outpatient Pharmacy (OP) V. 7.0 application in the"
^DIC(9.4,60,22,13,"PAH",236,1,6,0)="following areas:"
^DIC(9.4,60,22,13,"PAH",236,1,7,0)=" "
^DIC(9.4,60,22,13,"PAH",236,1,8,0)="1.  For the Reject Information screen under the Third Party Payer "
^DIC(9.4,60,22,13,"PAH",236,1,9,0)="Rejects - Worklist [PSO REJECTS WORKLIST] option, the hidden action PL "
^DIC(9.4,60,22,13,"PAH",236,1,10,0)="for Print List is changed to PT for consistency with other Outpatient "
^DIC(9.4,60,22,13,"PAH",236,1,11,0)="Pharmacy options.  "
^DIC(9.4,60,22,13,"PAH",236,1,12,0)=" "
^DIC(9.4,60,22,13,"PAH",236,1,13,0)="2.  The ePharmacy Medication Profile (View Only) [PSO PMP] option is "
^DIC(9.4,60,22,13,"PAH",236,1,14,0)="changed to display discontinued prescriptions that do not have a cancel "
^DIC(9.4,60,22,13,"PAH",236,1,15,0)="date defined."
^DIC(9.4,60,22,13,"PAH",237,0)="283 SEQ #243^3080203.220537^1"
^DIC(9.4,60,22,13,"PAH",237,1,0)="^^131^131^3080203"
^DIC(9.4,60,22,13,"PAH",237,1,1,0)="Problems have been reported with the expiration date of prescriptions."
^DIC(9.4,60,22,13,"PAH",237,1,2,0)="In some cases the date is not present and other cases have a wrong date."
^DIC(9.4,60,22,13,"PAH",237,1,3,0)="Furthermore, most of the prescriptions with such problem are not in sync"
^DIC(9.4,60,22,13,"PAH",237,1,4,0)="with Computerized Patient Record System (CPRS) V. 3.0 and/or Health "
^DIC(9.4,60,22,13,"PAH",237,1,5,0)="Data Repository (HDR) in regards to their status. This patch will "
^DIC(9.4,60,22,13,"PAH",237,1,6,0)="identify "
^DIC(9.4,60,22,13,"PAH",237,1,7,0)="and report a tally of how many prescriptions have such problem. A "
^DIC(9.4,60,22,13,"PAH",237,1,8,0)="follow-up"
^DIC(9.4,60,22,13,"PAH",237,1,9,0)="patch (PSO*7*293) will subsequently be released to fix these "
^DIC(9.4,60,22,13,"PAH",237,1,10,0)="prescriptions."
^DIC(9.4,60,22,13,"PAH",237,1,11,0)="  "
^DIC(9.4,60,22,13,"PAH",237,1,12,0)="The count of prescriptions with this problem will be broken down into five"
^DIC(9.4,60,22,13,"PAH",237,1,13,0)="different groups:"
^DIC(9.4,60,22,13,"PAH",237,1,14,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,15,0)="GROUP 1: Prescriptions with a null expiration date."
^DIC(9.4,60,22,13,"PAH",237,1,16,0)="   "
^DIC(9.4,60,22,13,"PAH",237,1,17,0)="GROUP 2: Expired prescriptions that are active in CPRS or with an "
^DIC(9.4,60,22,13,"PAH",237,1,18,0)="         expiration date greater than 366 days."
^DIC(9.4,60,22,13,"PAH",237,1,19,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,20,0)="GROUP 3: Prescriptions past their expiration date that are active in"
^DIC(9.4,60,22,13,"PAH",237,1,21,0)="         Outpatient Pharmacy."
^DIC(9.4,60,22,13,"PAH",237,1,22,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,23,0)="GROUP 4: Deleted prescriptions. These prescriptions don't necessarily"
^DIC(9.4,60,22,13,"PAH",237,1,24,0)="         have a problem, however they will be resend to HDR."
^DIC(9.4,60,22,13,"PAH",237,1,25,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,26,0)="OTHER  : Prescriptions with database inconsistencies, such as NO PATIENT,"
^DIC(9.4,60,22,13,"PAH",237,1,27,0)="         NO DRUG or NO ISSUE DATE are being counted for informational "
^DIC(9.4,60,22,13,"PAH",237,1,28,0)="         purpose only."
^DIC(9.4,60,22,13,"PAH",237,1,29,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,30,0)="The process to count these prescriptions will start right after the patch"
^DIC(9.4,60,22,13,"PAH",237,1,31,0)="is installed. If it is necessary to stop, restart the job or to know the"
^DIC(9.4,60,22,13,"PAH",237,1,32,0)="status of the job, run the following command in programmer mode:"
^DIC(9.4,60,22,13,"PAH",237,1,33,0)="   "
^DIC(9.4,60,22,13,"PAH",237,1,34,0)=">D ^PSO283PI              "
^DIC(9.4,60,22,13,"PAH",237,1,35,0)="  "
^DIC(9.4,60,22,13,"PAH",237,1,36,0)="Expiration Date problem tally patch for Outpatient Pharmacy prescriptions"
^DIC(9.4,60,22,13,"PAH",237,1,37,0)="========================================================================="
^DIC(9.4,60,22,13,"PAH",237,1,38,0)="     Current status: RUNNING (Last Rx IEN: 2587430)"
^DIC(9.4,60,22,13,"PAH",237,1,39,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,40,0)="     Select one of the following:"
^DIC(9.4,60,22,13,"PAH",237,1,41,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,42,0)="          SP        STOP TALLY JOB"
^DIC(9.4,60,22,13,"PAH",237,1,43,0)="          VW        VIEW PARTIAL TALLY JOB RESULTS"
^DIC(9.4,60,22,13,"PAH",237,1,44,0)="          QT        QUIT"
^DIC(9.4,60,22,13,"PAH",237,1,45,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,46,0)="(SP)Stop,(VW)View,(QT)Quit: VIEW//  VIEW PARTIAL TALLY JOB RESULTS"
^DIC(9.4,60,22,13,"PAH",237,1,47,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,48,0)=" "
^DIC(9.4,60,22,13,"PAH",237,1,49,0)="Expiration Date clean up job for Outpatient Pharmacy prescriptions"
