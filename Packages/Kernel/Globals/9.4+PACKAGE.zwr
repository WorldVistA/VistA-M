^DIC(9.4,120,22,12,"PAH",152,0)="162^3200824.161748^65"
^DIC(9.4,120,22,12,"PAH",152,1,0)="^^2^2^3200824"
^DIC(9.4,120,22,12,"PAH",152,1,1,0)="Please see the IVM*2.0*162 patch description for detailed information "
^DIC(9.4,120,22,12,"PAH",152,1,2,0)="regarding this patch"
^DIC(9.4,120,22,12,"PAH",153,0)="195 SEQ #160^3200923.110323^65"
^DIC(9.4,120,22,12,"PAH",153,1,0)="^^5^5^3200923"
^DIC(9.4,120,22,12,"PAH",153,1,1,0)="This patch corrects the following issue:"
^DIC(9.4,120,22,12,"PAH",153,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",153,1,3,0)="An Undefined error occurs in tag SRCOFMT of routine IVMCM3"
^DIC(9.4,120,22,12,"PAH",153,1,4,0)="when the SOURCE OF INCOME TEST (#.23) field in the ANNUAL"
^DIC(9.4,120,22,12,"PAH",153,1,5,0)="MEANS TEST (#408.31) file is equal to 5 (HEC-Old) or 6 (VOA)."
^DIC(9.4,120,22,12,"PAH",154,0)="194^3201208.082756^17"
^DIC(9.4,120,22,12,"PAH",154,1,0)="^^2^2^3201208"
^DIC(9.4,120,22,12,"PAH",154,1,1,0)="Please see the IVM*2*194 patch description for detailed information "
^DIC(9.4,120,22,12,"PAH",154,1,2,0)="regarding this patch."
^DIC(9.4,120,22,12,"PAH",155,0)="187b^3210427"
^DIC(9.4,120,22,12,"PAH",155,1,0)="^^5^5^3210427"
^DIC(9.4,120,22,12,"PAH",155,1,1,0)="Backup of IVM*2.0*187 on Apr 27, 2021"
^DIC(9.4,120,22,12,"PAH",155,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",155,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,120,22,12,"PAH",155,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,120,22,12,"PAH",155,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,120,22,12,"PAH",156,0)="187 SEQ #165^3210427.090806^17"
^DIC(9.4,120,22,12,"PAH",156,1,0)="^^13^13^3210427"
^DIC(9.4,120,22,12,"PAH",156,1,1,0)="Patch IVM*2.0*187 addresses 2 issues:"
^DIC(9.4,120,22,12,"PAH",156,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",156,1,3,0)="        1.Multiple sites reported an issue when trying to update a"
^DIC(9.4,120,22,12,"PAH",156,1,4,0)="          patients address in Vista. When the code is processing the PID"
^DIC(9.4,120,22,12,"PAH",156,1,5,0)="          segment, which contains the address information of an HL7 Z05"
^DIC(9.4,120,22,12,"PAH",156,1,6,0)="          message, it sets variable FORADDR equal to 1 if the residential"
^DIC(9.4,120,22,12,"PAH",156,1,7,0)="          address is a foreign address. When evaluating the permanent"
^DIC(9.4,120,22,12,"PAH",156,1,8,0)="          county address, FORADDR still equals 1 because it never gets"
^DIC(9.4,120,22,12,"PAH",156,1,9,0)="          reset."
^DIC(9.4,120,22,12,"PAH",156,1,10,0)=" "
^DIC(9.4,120,22,12,"PAH",156,1,11,0)="        2.Site receives an <UNDEFINED>SET+16^DGMTAUD error when"
^DIC(9.4,120,22,12,"PAH",156,1,12,0)="          processing an incoming HL7 Z10 (Income Test Transmission)"
^DIC(9.4,120,22,12,"PAH",156,1,13,0)="          message."
^DIC(9.4,120,22,12,"PAH",157,0)="196^3210701.113103^17"
