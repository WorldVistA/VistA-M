^DIC(9.4,3,22,21,"PAH",187,1,52,0)="  "
^DIC(9.4,3,22,21,"PAH",187,1,53,0)=" The software for this patch is not being distributed through the"
^DIC(9.4,3,22,21,"PAH",187,1,54,0)=" National Patch Module.  This patch along with patches DG*5.3*447"
^DIC(9.4,3,22,21,"PAH",187,1,55,0)=" and SD*5.3*262 "
^DIC(9.4,3,22,21,"PAH",187,1,56,0)=" are being released in a single KIDS software distribution with Patch "
^DIC(9.4,3,22,21,"PAH",187,1,57,0)=" YS*5.01*71. This patch only includes the informational portion of"
^DIC(9.4,3,22,21,"PAH",187,1,58,0)=" XU*8.0*234."
^DIC(9.4,3,22,21,"PAH",187,1,59,0)="  "
^DIC(9.4,3,22,21,"PAH",187,1,60,0)=" Please refer to the 'Software and Documentation Retrieval' and "
^DIC(9.4,3,22,21,"PAH",187,1,61,0)=" 'Installation Instructions' sections of the YS*5.01*71 patch"
^DIC(9.4,3,22,21,"PAH",187,1,62,0)=" description for the instructions on how to acquire, install, and "
^DIC(9.4,3,22,21,"PAH",187,1,63,0)=" implement the patch software."
^DIC(9.4,3,22,21,"PAH",188,0)="230 SEQ #195^3020710^1"
^DIC(9.4,3,22,21,"PAH",188,1,0)="^^2^2^3020710"
^DIC(9.4,3,22,21,"PAH",188,1,1,0)="See patch XU*8*230 in the National Patch Module on FORUM for complete"
^DIC(9.4,3,22,21,"PAH",188,1,2,0)="information on this patch."
^DIC(9.4,3,22,21,"PAH",189,0)="228 SEQ #196^3020814^1"
^DIC(9.4,3,22,21,"PAH",189,1,0)="^^60^60^3020814"
^DIC(9.4,3,22,21,"PAH",189,1,1,0)="NOIS: SLC-0202-52313"
^DIC(9.4,3,22,21,"PAH",189,1,2,0)="Problem: The Body Surface Area calculation in XLFMSMT returned the wrong"
^DIC(9.4,3,22,21,"PAH",189,1,3,0)="values.  A check of the Web for BSA showed that the formula had been"
^DIC(9.4,3,22,21,"PAH",189,1,4,0)="entered switching the powers."
^DIC(9.4,3,22,21,"PAH",189,1,5,0)="Fix: Enter the formula correctly.  Sample value  BSA(100,43) = 1.00"
^DIC(9.4,3,22,21,"PAH",189,1,6,0)=""
