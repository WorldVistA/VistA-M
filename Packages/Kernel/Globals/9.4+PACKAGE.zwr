^DIC(9.4,85,22,1.5,"PAH",9,0)="33 SEQ #31^3011210^1"
^DIC(9.4,85,22,1.5,"PAH",9,1,0)="^^67^67^3011210"
^DIC(9.4,85,22,1.5,"PAH",9,1,1,0)="Patch VAQ*1.5*33"
^DIC(9.4,85,22,1.5,"PAH",9,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",9,1,3,0)="NOIS SBY-0801-31431, FAV-1001-70165, COS-1001-40729, MAR-1001-20783"
^DIC(9.4,85,22,1.5,"PAH",9,1,4,0)="Test Site: Salisbury, NC; Fayetteville, AR; Columbus, OH"
^DIC(9.4,85,22,1.5,"PAH",9,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",9,1,6,0)="This patch checks PDX requests from remote sites to ensure that the remote"
^DIC(9.4,85,22,1.5,"PAH",9,1,7,0)="site is not flagged as Closed in the Domain file.  If the Domain file shows"
^DIC(9.4,85,22,1.5,"PAH",9,1,8,0)="that the site is closed, then the request is ignored, the message is"
^DIC(9.4,85,22,1.5,"PAH",9,1,9,0)="deleted from the server basket, and a message is sent to the members of the"
^DIC(9.4,85,22,1.5,"PAH",9,1,10,0)="group G.VAQ PDX ERRORS to inform them of this."
^DIC(9.4,85,22,1.5,"PAH",9,1,11,0)=""
^DIC(9.4,85,22,1.5,"PAH",9,1,12,0)="NOIS WBP-0596-21007"
^DIC(9.4,85,22,1.5,"PAH",9,1,13,0)="Test Site: Wilkes Barre, PA"
^DIC(9.4,85,22,1.5,"PAH",9,1,14,0)=""
^DIC(9.4,85,22,1.5,"PAH",9,1,15,0)="This patch ensures that incoming PDX messages are deleted from the server"
^DIC(9.4,85,22,1.5,"PAH",9,1,16,0)="basket, whether they processed successfully or errored out."
^DIC(9.4,85,22,1.5,"PAH",9,1,17,0)=""
^DIC(9.4,85,22,1.5,"PAH",9,1,18,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",9,1,19,0)="is at a minimum.  It has no patch pre-requisites."
^DIC(9.4,85,22,1.5,"PAH",9,1,20,0)="=========================================================================="
