^DIC(9.4,73,22,9,"PAH",19,1,121,0)="This patch introduces no new routines."
^DIC(9.4,73,22,9,"PAH",19,1,122,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",19,1,123,0)=" "
^DIC(9.4,73,22,9,"PAH",19,1,124,0)="INSTALLATION:"
^DIC(9.4,73,22,9,"PAH",19,1,125,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",19,1,126,0)="is at a minimum.  It requires patch AFJX*5.1*29 and *30."
^DIC(9.4,73,22,9,"PAH",19,1,127,0)="The post-init for this patch will take approximately 1/2 hour for every"
^DIC(9.4,73,22,9,"PAH",19,1,128,0)="400,000 records in file ^AFJ(537010."
^DIC(9.4,73,22,9,"PAH",19,1,129,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,73,22,9,"PAH",19,1,130,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,73,22,9,"PAH",19,1,131,0)="    affected routine(s).  "
^DIC(9.4,73,22,9,"PAH",19,1,132,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,73,22,9,"PAH",19,1,133,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,73,22,9,"PAH",19,1,134,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,73,22,9,"PAH",19,1,135,0)="    Users may be on the system."
^DIC(9.4,73,22,9,"PAH",19,1,136,0)="5.  On the KIDS:Installation menu, use the following options to install"
^DIC(9.4,73,22,9,"PAH",19,1,137,0)="    the Transport Global."
^DIC(9.4,73,22,9,"PAH",19,1,138,0)="       Verify Checksums in Transport Global"
^DIC(9.4,73,22,9,"PAH",19,1,139,0)="       Print Transport Global"
^DIC(9.4,73,22,9,"PAH",19,1,140,0)="       Compare Transport Global to Current System"
^DIC(9.4,73,22,9,"PAH",19,1,141,0)="       Backup a Transport Global"
^DIC(9.4,73,22,9,"PAH",19,1,142,0)="       Install Package(s)"
^DIC(9.4,73,22,9,"PAH",19,1,143,0)=" Select INSTALL NAME:   AFJX*5.1*31   Loaded from Distribution <date/time>"
^DIC(9.4,73,22,9,"PAH",19,1,144,0)="                        ==========="
^DIC(9.4,73,22,9,"PAH",19,1,145,0)=" Install Questions:"
^DIC(9.4,73,22,9,"PAH",19,1,146,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,73,22,9,"PAH",19,1,147,0)="                                                       =="
^DIC(9.4,73,22,9,"PAH",19,1,148,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,73,22,9,"PAH",19,1,149,0)="                                                                       =="
^DIC(9.4,73,22,9,"PAH",19,1,150,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,73,22,9,"PAH",19,1,151,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,73,22,9,"PAH",19,1,152,0)=" Enter a '^' to abort the install."
^DIC(9.4,73,22,9,"PAH",19,1,153,0)=" "
^DIC(9.4,73,22,9,"PAH",19,1,154,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,73,22,9,"PAH",19,1,155,0)="                ------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",19,1,156,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if"
^DIC(9.4,73,22,9,"PAH",19,1,157,0)="    necessary."
^DIC(9.4,73,22,9,"PAH",19,1,158,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",20,0)="32 SEQ #27^3021025^1"
^DIC(9.4,73,22,9,"PAH",20,1,0)="^^73^73^3021025"
^DIC(9.4,73,22,9,"PAH",20,1,1,0)="Patch AFJX*5.1*32"
^DIC(9.4,73,22,9,"PAH",20,1,2,0)=" "
^DIC(9.4,73,22,9,"PAH",20,1,3,0)="NOIS CAH-0602-31615 (Remedy Ticket HD8220/CHG2653)"
^DIC(9.4,73,22,9,"PAH",20,1,4,0)="Test Site: Central Alabama HCS; Birmingham, AL"
^DIC(9.4,73,22,9,"PAH",20,1,5,0)=""
^DIC(9.4,73,22,9,"PAH",20,1,6,0)="If the NETWORK,HEALTH EXCHANGE user has been terminated, the requesting"
^DIC(9.4,73,22,9,"PAH",20,1,7,0)="user never sees the results of a query after processing the alert.  This"
^DIC(9.4,73,22,9,"PAH",20,1,8,0)="patch makes it possible for the requesting user to see the results."
^DIC(9.4,73,22,9,"PAH",20,1,9,0)=""
^DIC(9.4,73,22,9,"PAH",20,1,10,0)="Instead of sending two messages in response to a user query (one with the"
^DIC(9.4,73,22,9,"PAH",20,1,11,0)="requested information to the NETWORK,HEALTH EXCHANGE user; the other to a"
^DIC(9.4,73,22,9,"PAH",20,1,12,0)="server which alerts the requesting user to it), this patch sends just one"
^DIC(9.4,73,22,9,"PAH",20,1,13,0)="message to both.  The process is thus simplified."
^DIC(9.4,73,22,9,"PAH",20,1,14,0)=""
^DIC(9.4,73,22,9,"PAH",20,1,15,0)="The two-message process also sometimes causes problems because of timing"
^DIC(9.4,73,22,9,"PAH",20,1,16,0)="issues.  A user can be alerted that the request has been completed, but"
^DIC(9.4,73,22,9,"PAH",20,1,17,0)="when the user tries to view the results, it can't be found.  This is"
^DIC(9.4,73,22,9,"PAH",20,1,18,0)="because MailMan hasn't yet delivered the first message to the"
^DIC(9.4,73,22,9,"PAH",20,1,19,0)="NETWORK,HEALTH EXCHANGE user.  This patch and its one-message process"
^DIC(9.4,73,22,9,"PAH",20,1,20,0)="makes it impossible for this to happen."
^DIC(9.4,73,22,9,"PAH",20,1,21,0)=""
^DIC(9.4,73,22,9,"PAH",20,1,22,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,73,22,9,"PAH",20,1,23,0)="is at a minimum.  It requires patch AFJX*5.1*31."
^DIC(9.4,73,22,9,"PAH",20,1,24,0)="=========================================================================="
^DIC(9.4,73,22,9,"PAH",20,1,25,0)=" "
^DIC(9.4,73,22,9,"PAH",20,1,26,0)="ROUTINES:"
^DIC(9.4,73,22,9,"PAH",20,1,27,0)="The second line of the routine now looks like:"
^DIC(9.4,73,22,9,"PAH",20,1,28,0)="       ;;5.1;Network Health Exchange;**[patch list]**;Jan 23, 1996"
^DIC(9.4,73,22,9,"PAH",20,1,29,0)=" "
^DIC(9.4,73,22,9,"PAH",20,1,30,0)="             Before        After"
^DIC(9.4,73,22,9,"PAH",20,1,31,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,73,22,9,"PAH",20,1,32,0)="-----------------------------------------------------------------"
^DIC(9.4,73,22,9,"PAH",20,1,33,0)="AFJXALRT   12200940     11647156     6,15,17,23,31,32"
^DIC(9.4,73,22,9,"PAH",20,1,34,0)="AFJXSFAL    2271216      2275636     31,32"
^DIC(9.4,73,22,9,"PAH",20,1,35,0)="AFJXWCPD    5587435         2914     32"
^DIC(9.4,73,22,9,"PAH",20,1,36,0)="* Checksums produced by CHECK^XTSUMBLD"
