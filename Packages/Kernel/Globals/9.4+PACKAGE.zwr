^DIC(9.4,48,22,5.28,"PAH",657,1,37,0)="VSE-6208: BB - VistA - Updating Special Needs and Preferences is saving "
^DIC(9.4,48,22,5.28,"PAH",657,1,38,0)="          the proxy user instead of the original requestor"
^DIC(9.4,48,22,5.28,"PAH",657,1,39,0)="VSE-6386: MD - VistA - Correct issue where SDES GET CLIN AVAILABILITY "
^DIC(9.4,48,22,5.28,"PAH",657,1,40,0)="          does not return a time zone offset"
^DIC(9.4,48,22,5.28,"PAH",657,1,41,0)="VSE-6399: DS - VistA - Modify SDES CREATE CLINIC and SDES EDIT CLINIC to "
^DIC(9.4,48,22,5.28,"PAH",657,1,42,0)="          specify which stop code is inactive"
^DIC(9.4,48,22,5.28,"PAH",657,1,43,0)="VSE-6405: JS - VistA - Modify SDES GET CLINIC INFO2 to return Provider "
^DIC(9.4,48,22,5.28,"PAH",657,1,44,0)="          IEN as an output object"
^DIC(9.4,48,22,5.28,"PAH",657,1,45,0)="VSE-6421: BF - VistA - Modify documentation for SDES DISPOSITION APPT REQ "
^DIC(9.4,48,22,5.28,"PAH",657,1,46,0)="          to update DISPBY to the User IEN"
^DIC(9.4,48,22,5.28,"PAH",657,1,47,0)="VSE-6424: TB - VistA - Rewrite SDES CREATE LAST SELECTED PAT in the SDES2 "
^DIC(9.4,48,22,5.28,"PAH",657,1,48,0)="          namespace"
^DIC(9.4,48,22,5.28,"PAH",657,1,49,0)="VSE-6425: LB VistA - Modify SDES CREATE APPOINTMENTS to pull PID from the "
^DIC(9.4,48,22,5.28,"PAH",657,1,50,0)="          request if there is no PID sent in"
^DIC(9.4,48,22,5.28,"PAH",657,1,51,0)="VSE-6428: AP - VistA - Modify SDES CANCEL APPOINTMENT 2 to store ""O"" not "
^DIC(9.4,48,22,5.28,"PAH",657,1,52,0)="          ""OPEN"""
^DIC(9.4,48,22,5.28,"PAH",657,1,53,0)="VSE-6429: AP - VistA - Modify SDES UNDO NOSHOW to update the status with "
^DIC(9.4,48,22,5.28,"PAH",657,1,54,0)="          ""C"" for Closed"
^DIC(9.4,48,22,5.28,"PAH",657,1,55,0)="VSE-6435: AP - VistA - Modify SDES NOSHOW to store ""O"" instead of OPEN"
^DIC(9.4,48,22,5.28,"PAH",657,1,56,0)="VSE-6438: LB - VistA - The SDCANCEL option needs to be modified to "
^DIC(9.4,48,22,5.28,"PAH",657,1,57,0)="          prevent the ""ST"" record from being created when user erroneously"
^DIC(9.4,48,22,5.28,"PAH",657,1,58,0)="          enters a date that is not defined in the availability."
^DIC(9.4,48,22,5.28,"PAH",657,1,59,0)="VSE-6443: JS - Modify the GETDPROIEN Tag of SDECVVS to pull the default "
^DIC(9.4,48,22,5.28,"PAH",657,1,60,0)="          provider from provider multiple of the HOSPITAL LOCATION."
^DIC(9.4,48,22,5.28,"PAH",657,1,61,0)="VSE-6509: TB - VistA: Create a new RPC to get recall disposition"
^DIC(9.4,48,22,5.28,"PAH",657,1,62,0)="          reasons from 403.56 "
^DIC(9.4,48,22,5.28,"PAH",657,1,63,0)="VSE-6608: LB - VistA: Modify Wait Time Standard calculations "
^DIC(9.4,48,22,5.28,"PAH",657,1,64,0)="VSE-6836: MD - VistA: SDES GET CLINICS BY CLIN LIST is throwing an error"
^DIC(9.4,48,22,5.28,"PAH",657,1,65,0)="VSE-6977: BF - VistA: Modify SDES2 EDIT CLINIC to allow editing of length"
^DIC(9.4,48,22,5.28,"PAH",657,1,66,0)="          of appointment."
^DIC(9.4,48,22,5.28,"PAH",657,1,67,0)="VSE-6978: BF - VistA: Correct SDES2 CREATE CLINIC to allow length of"
^DIC(9.4,48,22,5.28,"PAH",657,1,68,0)="          appt in multiples of 10 up to 240"
^DIC(9.4,48,22,5.28,"PAH",657,1,69,0)=" "
