^DIC(9.4,93,22,21,"PAH",152,0)="191 SEQ #166^3150310.13372^17"
^DIC(9.4,93,22,21,"PAH",152,1,0)="^^2^2^3150310"
^DIC(9.4,93,22,21,"PAH",152,1,1,0)="Patch DVBA*2.7*191 corrects an undefined error that occurs when queueing "
