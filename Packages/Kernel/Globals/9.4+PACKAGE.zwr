^DIC(9.4,100,22,15,"PAH",50,1,21,0)="  <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",50,1,22,0)="   "
^DIC(9.4,100,22,15,"PAH",50,1,23,0)="                                  Checksum Values"
^DIC(9.4,100,22,15,"PAH",50,1,24,0)="   "
