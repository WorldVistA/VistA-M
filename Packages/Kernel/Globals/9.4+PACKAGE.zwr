^DIC(9.4,96,22,1.2,"PAH",23,0)="41 SEQ #40^3050401^1"
^DIC(9.4,96,22,1.2,"PAH",23,1,0)="^^260^260^3050401"
^DIC(9.4,96,22,1.2,"PAH",23,1,1,0)=" General Information"
^DIC(9.4,96,22,1.2,"PAH",23,1,2,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",23,1,3,0)=" The purpose of this patch is for Dental Record Manager to comply with "
^DIC(9.4,96,22,1.2,"PAH",23,1,4,0)=" the ICD-9 changes in the LEX*2.0*31 patch.  The following Dental ICD-9"
^DIC(9.4,96,22,1.2,"PAH",23,1,5,0)=" codes are being inactivated and must be removed from the Dental CPT"
^DIC(9.4,96,22,1.2,"PAH",23,1,6,0)=" Code Mapping table:"
^DIC(9.4,96,22,1.2,"PAH",23,1,7,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,8,0)=" 521.1     Excessive attrition"
^DIC(9.4,96,22,1.2,"PAH",23,1,9,0)=" 521.2     Abrasion"
^DIC(9.4,96,22,1.2,"PAH",23,1,10,0)=" 521.3     Erosion"
^DIC(9.4,96,22,1.2,"PAH",23,1,11,0)=" 521.4     Pathological resorption"
^DIC(9.4,96,22,1.2,"PAH",23,1,12,0)=" 523.2     Gingival recession"
^DIC(9.4,96,22,1.2,"PAH",23,1,13,0)=" 524.2     Anomalies of dental arch relationship"
^DIC(9.4,96,22,1.2,"PAH",23,1,14,0)=" 524.3     Anomalies of tooth position"
^DIC(9.4,96,22,1.2,"PAH",23,1,15,0)=" 524.5     Dentofacial functional abnormalities"
^DIC(9.4,96,22,1.2,"PAH",23,1,16,0)=" 524.8     Other specified dentofacial anomalies"
^DIC(9.4,96,22,1.2,"PAH",23,1,17,0)=" 525.2     Atrophy of edentulous alveolar ridge"
^DIC(9.4,96,22,1.2,"PAH",23,1,18,0)=" 528.7     Other disturbances of oral epithelium, including tongue"
^DIC(9.4,96,22,1.2,"PAH",23,1,19,0)="   "
^DIC(9.4,96,22,1.2,"PAH",23,1,20,0)=" The patch installation process should take be less than 5 minutes."
^DIC(9.4,96,22,1.2,"PAH",23,1,21,0)=" The post installation process may take a few minutes to process the"
^DIC(9.4,96,22,1.2,"PAH",23,1,22,0)=" changes to the DENTAL CPT CODE MAPPING (#228) data.  "
^DIC(9.4,96,22,1.2,"PAH",23,1,23,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,24,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,25,0)=" ENHANCEMENTS TO THE DRM APPLICATION"
^DIC(9.4,96,22,1.2,"PAH",23,1,26,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",23,1,27,0)=" A. A new mail group DENTV ADA CODE MAPPING will be sent with this patch."
^DIC(9.4,96,22,1.2,"PAH",23,1,28,0)="     This mail group will be used in future patches that modify the ADA"
^DIC(9.4,96,22,1.2,"PAH",23,1,29,0)="     Master table to notify users of the changes."
^DIC(9.4,96,22,1.2,"PAH",23,1,30,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,31,0)=" B. The DENTAL CPT CODE MAPPING table has been changed so that any"
^DIC(9.4,96,22,1.2,"PAH",23,1,32,0)="    references to inactivated ICD-9 codes have been replaced or removed."
^DIC(9.4,96,22,1.2,"PAH",23,1,33,0)="    Changes to the national mapping table were made by the Dental Coding"
^DIC(9.4,96,22,1.2,"PAH",23,1,34,0)="    Group members.  The following changes may occur:"
^DIC(9.4,96,22,1.2,"PAH",23,1,35,0)="    "
^DIC(9.4,96,22,1.2,"PAH",23,1,36,0)="    CODE     REMOVE ICD-9     REPLACE and/or ADD ICD-9"
^DIC(9.4,96,22,1.2,"PAH",23,1,37,0)="    -----    -------------    -----------------------------------"
^DIC(9.4,96,22,1.2,"PAH",23,1,38,0)="    D0340    524.5            524.21 524.22 524.23 524.24 524.25"
^DIC(9.4,96,22,1.2,"PAH",23,1,39,0)="    D4270    523.2            523.23"
^DIC(9.4,96,22,1.2,"PAH",23,1,40,0)="    D4271    523.2            523.24"
^DIC(9.4,96,22,1.2,"PAH",23,1,41,0)="    D7111    521.4            521.42"
^DIC(9.4,96,22,1.2,"PAH",23,1,42,0)="    D7286    528.7            528.79"
^DIC(9.4,96,22,1.2,"PAH",23,1,43,0)="    D7287    528.7            528.79"
^DIC(9.4,96,22,1.2,"PAH",23,1,44,0)="    D7290    524.3            524.31 524.32 524.33 524.34 524.35"
