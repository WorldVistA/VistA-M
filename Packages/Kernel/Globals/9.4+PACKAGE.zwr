^DIC(9.4,4,22,2,"PAH",22,1,74,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",22,1,75,0)="7.  This is a repeat of the information provided in patch XM*7.1*193."
^DIC(9.4,4,22,2,"PAH",22,1,76,0)="If you use the MailMan option for transferring VistA email messages via"
^DIC(9.4,4,22,2,"PAH",22,1,77,0)="disk/tape to another site, you will have problems if the SEND field"
^DIC(9.4,4,22,2,"PAH",22,1,78,0)="setting for the TAPE entry in the Communications Protocol file is wrong."
^DIC(9.4,4,22,2,"PAH",22,1,79,0)="The SEND field for the TAPE entry must be set to:"
^DIC(9.4,4,22,2,"PAH",22,1,80,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,81,0)="SEND: W XMSG,! ; S XMTRAN=""S: ""_XMSG D TRAN^XMC1"
^DIC(9.4,4,22,2,"PAH",22,1,82,0)="            =="
^DIC(9.4,4,22,2,"PAH",22,1,83,0)="Most of the entries we have found for this don't have the "",!"" following"
^DIC(9.4,4,22,2,"PAH",22,1,84,0)="the ""W XMSG"".  Without the "",!"" you don't get the line feed at the end of"
^DIC(9.4,4,22,2,"PAH",22,1,85,0)="each line. This causes a buffer overflow when you try to receive the"
^DIC(9.4,4,22,2,"PAH",22,1,86,0)="message.  Please look at your entry, and edit, if necessary:"
^DIC(9.4,4,22,2,"PAH",22,1,87,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,88,0)="Using FileMan:"
^DIC(9.4,4,22,2,"PAH",22,1,89,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,90,0)="Select OPTION: ENTER OR EDIT FILE ENTRIES  "
^DIC(9.4,4,22,2,"PAH",22,1,91,0)="               ====="
^DIC(9.4,4,22,2,"PAH",22,1,92,0)="INPUT TO WHAT FILE: COMMUNICATIONS PROTOCOL// <press enter>"
^DIC(9.4,4,22,2,"PAH",22,1,93,0)="EDIT WHICH FIELD: ALL// SEND"
^DIC(9.4,4,22,2,"PAH",22,1,94,0)="                        ===="
^DIC(9.4,4,22,2,"PAH",22,1,95,0)="THEN EDIT FIELD: <press enter>"
^DIC(9.4,4,22,2,"PAH",22,1,96,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,97,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,98,0)="Select COMMUNICATIONS PROTOCOL NAME: TAPE"
^DIC(9.4,4,22,2,"PAH",22,1,99,0)="                                     ===="
^DIC(9.4,4,22,2,"PAH",22,1,100,0)="SEND: W XMSG ; S XMTRAN=""S: ""_XMSG D TRAN^XMC1  Replace MSG With MSG,!"
^DIC(9.4,4,22,2,"PAH",22,1,101,0)="                                                        ===      ====="
^DIC(9.4,4,22,2,"PAH",22,1,102,0)="  Replace <press enter>"
^DIC(9.4,4,22,2,"PAH",22,1,103,0)="          ============="
^DIC(9.4,4,22,2,"PAH",22,1,104,0)="   W XMSG,! ; S XMTRAN=""S: ""_XMSG D TRAN^XMC1"
^DIC(9.4,4,22,2,"PAH",22,1,105,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,106,0)="Select COMMUNICATIONS PROTOCOL NAME:"
^DIC(9.4,4,22,2,"PAH",22,1,107,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,108,0)="8. The Kernel Systems Manual tells you how to set up HFS (Host File Server)"
^DIC(9.4,4,22,2,"PAH",22,1,109,0)="devices.  (In v8, Chapter 18 on Host Files is pages 229-232.)  If your site"
^DIC(9.4,4,22,2,"PAH",22,1,110,0)="is using an HFS device to send mail to and receive mail from another site,"
^DIC(9.4,4,22,2,"PAH",22,1,111,0)="your settings should deviate from the recommendations in the manual as"
^DIC(9.4,4,22,2,"PAH",22,1,112,0)="follows:"
^DIC(9.4,4,22,2,"PAH",22,1,113,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,114,0)="Using FileMan:"
^DIC(9.4,4,22,2,"PAH",22,1,115,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,116,0)="Select OPTION: ENTER OR EDIT FILE ENTRIES  "
^DIC(9.4,4,22,2,"PAH",22,1,117,0)="               ====="
^DIC(9.4,4,22,2,"PAH",22,1,118,0)="INPUT TO WHAT FILE: COMMUNICATIONS PROTOCOL// DEVICE  "
^DIC(9.4,4,22,2,"PAH",22,1,119,0)="                                              ======"
^DIC(9.4,4,22,2,"PAH",22,1,120,0)="EDIT WHICH FIELD: ALL// ASK HOST FILE"
^DIC(9.4,4,22,2,"PAH",22,1,121,0)="                        ========"
^DIC(9.4,4,22,2,"PAH",22,1,122,0)="THEN EDIT FIELD: ASK HFS I/O OPERATION"
^DIC(9.4,4,22,2,"PAH",22,1,123,0)="                 ======="
^DIC(9.4,4,22,2,"PAH",22,1,124,0)="THEN EDIT FIELD: <press enter>"
^DIC(9.4,4,22,2,"PAH",22,1,125,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,126,0)="Select DEVICE NAME: HFS        <=== Yours may be different"
^DIC(9.4,4,22,2,"PAH",22,1,127,0)="                    ==="
^DIC(9.4,4,22,2,"PAH",22,1,128,0)="ASK HOST FILE: YES//           <=== Must be YES"
^DIC(9.4,4,22,2,"PAH",22,1,129,0)="ASK HFS I/O OPERATION: YES//   <=== Must be YES"
^DIC(9.4,4,22,2,"PAH",22,1,130,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,131,0)="ASK HOST FILE should be set to YES, so that you will be prompted for"
^DIC(9.4,4,22,2,"PAH",22,1,132,0)="""HOST FILE NAME:"".  The site creating the host file could accept the default"
^DIC(9.4,4,22,2,"PAH",22,1,133,0)="or select a name.  The site reading the host file would enter the name of"
^DIC(9.4,4,22,2,"PAH",22,1,134,0)="the file from the sending site."
^DIC(9.4,4,22,2,"PAH",22,1,135,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,136,0)="ASK HFS I/O OPERATION should be set to YES, so that you will be prompted"
^DIC(9.4,4,22,2,"PAH",22,1,137,0)="""INPUT/OUTPUT OPERATION:"".  The site creating the host file would answer"
^DIC(9.4,4,22,2,"PAH",22,1,138,0)="""NEW"", and the site reading the host file would answer ""READONLY""."
^DIC(9.4,4,22,2,"PAH",22,1,139,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,140,0)="This is what it should look like when you use the options:"
^DIC(9.4,4,22,2,"PAH",22,1,141,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,142,0)="Option: Sequential Media Queue Transmission [XMS-SEQ-TRANSMIT]"
^DIC(9.4,4,22,2,"PAH",22,1,143,0)="          "
^DIC(9.4,4,22,2,"PAH",22,1,144,0)="This option lets you select only those queues which have messages.  If"
^DIC(9.4,4,22,2,"PAH",22,1,145,0)="you can't select a queue, it either doesn't exist or it has no messages."
^DIC(9.4,4,22,2,"PAH",22,1,146,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,147,0)="Select DOMAIN NAME: DOMAIN.EXT                       1 msgs"
^DIC(9.4,4,22,2,"PAH",22,1,148,0)="DEVICE: HOME// HFS  DISK FILE"
^DIC(9.4,4,22,2,"PAH",22,1,149,0)="HOST FILE NAME: TMP.TMP//FORUM.DAT           INPUT/OUTPUT OPERATION: ?"
^DIC(9.4,4,22,2,"PAH",22,1,150,0)="Enter one of the following host file input/ouput operation:"
^DIC(9.4,4,22,2,"PAH",22,1,151,0)="                R = READONLY"
^DIC(9.4,4,22,2,"PAH",22,1,152,0)="                N = NEWVERSION"
^DIC(9.4,4,22,2,"PAH",22,1,153,0)="               RW = READ/WRITE"
^DIC(9.4,4,22,2,"PAH",22,1,154,0)="                                             INPUT/OUTPUT OPERATION: N"
^DIC(9.4,4,22,2,"PAH",22,1,155,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,156,0)="Dumping messages now ... Messages dumped: 1"
^DIC(9.4,4,22,2,"PAH",22,1,157,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,158,0)="Option: Sequential Media Message Reception [XMR-SEQ-RECEIVE]"
^DIC(9.4,4,22,2,"PAH",22,1,159,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,160,0)="DEVICE: HOME// HFS  DISK FILE"
^DIC(9.4,4,22,2,"PAH",22,1,161,0)="HOST FILE NAME: TMP.TMP//FORUM.DAT           INPUT/OUTPUT OPERATION: R"
^DIC(9.4,4,22,2,"PAH",22,1,162,0)=""
^DIC(9.4,4,22,2,"PAH",22,1,163,0)="Messages received: 1"
^DIC(9.4,4,22,2,"PAH",22,1,164,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",23,0)="24 SEQ #23^3040330^1"
^DIC(9.4,4,22,2,"PAH",23,1,0)="^^237^237^3040330"
^DIC(9.4,4,22,2,"PAH",23,1,1,0)="Patch XM*8.0*24"
^DIC(9.4,4,22,2,"PAH",23,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,3,0)="!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
^DIC(9.4,4,22,2,"PAH",23,1,4,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,5,0)="                             ATTENTION!"
^DIC(9.4,4,22,2,"PAH",23,1,6,0)="   You should enter a MAIL GROUP for the new bulletin XM RELAY ATTEMPTED."
^DIC(9.4,4,22,2,"PAH",23,1,7,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,8,0)="   Non-VA sites should read the patch description carefully.  Non-VA sites"
^DIC(9.4,4,22,2,"PAH",23,1,9,0)="                 will need to set new fields manually."
^DIC(9.4,4,22,2,"PAH",23,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,11,0)="!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
^DIC(9.4,4,22,2,"PAH",23,1,12,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,13,0)="NOIS: MWV-0104-22303, TUC-0104-62259, MAD-0104-42234, PAL-0204-60051"
^DIC(9.4,4,22,2,"PAH",23,1,14,0)="Test Sites: FORUM; Martinsburg, WV; Martinez, CA; Palo Alto, CA; FO-Hines;"
^DIC(9.4,4,22,2,"PAH",23,1,15,0)="            Madison, WI; FO-Albany; Central Alabama HCS; Montana HCS;"
^DIC(9.4,4,22,2,"PAH",23,1,16,0)="            Columbus, OH"
^DIC(9.4,4,22,2,"PAH",23,1,17,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,18,0)="Recently, a MailMan site unwittingly acted as a relay for a non-VA site"
^DIC(9.4,4,22,2,"PAH",23,1,19,0)="sending a message containing the MyDoom virus to another non-VA site.  To"
^DIC(9.4,4,22,2,"PAH",23,1,20,0)="correct this, MailMan will no longer relay mail from a non-VA site to a"
^DIC(9.4,4,22,2,"PAH",23,1,21,0)="non-VA site.  This patch is about trying to prevent spammers and virus"
^DIC(9.4,4,22,2,"PAH",23,1,22,0)="propagators from sending their email through your site and from disguising"
^DIC(9.4,4,22,2,"PAH",23,1,23,0)="their messages to appear to be coming from your site."
^DIC(9.4,4,22,2,"PAH",23,1,24,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,25,0)="Let's be clear here.  We're talking about when a site connects to your"
^DIC(9.4,4,22,2,"PAH",23,1,26,0)="site, and says, hi, I've got some messages for you.  For instance, if the"
^DIC(9.4,4,22,2,"PAH",23,1,27,0)="site is AOL, it will say, HELO AOL.COM.  Your site says ""Hey, wassup?""."
^DIC(9.4,4,22,2,"PAH",23,1,28,0)="The other site says I've got a message from so-and-so, to FRED@YAHOO.COM."
^DIC(9.4,4,22,2,"PAH",23,1,29,0)="Before this patch, MailMan would say, OK, and accept the message and"
^DIC(9.4,4,22,2,"PAH",23,1,30,0)="relay it on to FRED@YAHOO.COM.  Now, however, MailMan will say, I'm sorry"
^DIC(9.4,4,22,2,"PAH",23,1,31,0)="but I'm not going to relay this message and act as a stooge for you - do"
^DIC(9.4,4,22,2,"PAH",23,1,32,0)="it yourself.  Here's an example.  (I'm using AOL and Yahoo just because"
^DIC(9.4,4,22,2,"PAH",23,1,33,0)="they're familiar.  I'm not suggesting that they are part of the problem.)"
^DIC(9.4,4,22,2,"PAH",23,1,34,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,35,0)="11:24:48 R: HELO AOL.COM                           <--- from outside site"
^DIC(9.4,4,22,2,"PAH",23,1,36,0)="11:24:48 S: 250 OK DOMAIN.EXT [8.0,DUP,SER,FTP]  <--- through FORUM"
^DIC(9.4,4,22,2,"PAH",23,1,37,0)="11:24:48 Waiting for input"
^DIC(9.4,4,22,2,"PAH",23,1,38,0)="11:24:48 R: MAIL FROM:<WILMA@AOL.COM>"
^DIC(9.4,4,22,2,"PAH",23,1,39,0)="11:24:48 S: 250 OK Message-ID:9979753@DOMAIN.EXT"
^DIC(9.4,4,22,2,"PAH",23,1,40,0)="11:24:48 Waiting for input"
^DIC(9.4,4,22,2,"PAH",23,1,41,0)="11:24:48 R: RCPT TO:<FRED@YAHOO.COM>               <--- to an outside user"
^DIC(9.4,4,22,2,"PAH",23,1,42,0)="11:24:48 S: 550 Relaying denied.                   <--- No way!"
^DIC(9.4,4,22,2,"PAH",23,1,43,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,44,0)="If WILMA at AOL sends you a message at your site, and you want to forward"
^DIC(9.4,4,22,2,"PAH",23,1,45,0)="the message on to FRED@YAHOO.COM, that's fine.  This patch will not prevent"
^DIC(9.4,4,22,2,"PAH",23,1,46,0)="you from doing that.  That's something completely different from what this"
^DIC(9.4,4,22,2,"PAH",23,1,47,0)="patch is designed to prevent."
^DIC(9.4,4,22,2,"PAH",23,1,48,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,49,0)="This patch adds a new bulletin which will notify the POSTMASTER any time"
^DIC(9.4,4,22,2,"PAH",23,1,50,0)="MailMan refuses to relay a message.  You are encouraged to add a mail group"
^DIC(9.4,4,22,2,"PAH",23,1,51,0)="to the bulletin to notify additional responsible persons."
^DIC(9.4,4,22,2,"PAH",23,1,52,0)="Here's the bulletin:"
^DIC(9.4,4,22,2,"PAH",23,1,53,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,54,0)="NAME: XM RELAY ATTEMPTED           SUBJECT: Potential SPAM or VIRUS stopped"
^DIC(9.4,4,22,2,"PAH",23,1,55,0)="  RETENTION DAYS: 7"
^DIC(9.4,4,22,2,"PAH",23,1,56,0)=" MESSAGE:   A site calling itself |1| attempted to relay a message from: |3|"
^DIC(9.4,4,22,2,"PAH",23,1,57,0)=" to:   |2| through this site."
^DIC(9.4,4,22,2,"PAH",23,1,58,0)="  "
^DIC(9.4,4,22,2,"PAH",23,1,59,0)=" This attempt was denied."
^DIC(9.4,4,22,2,"PAH",23,1,60,0)="  "
^DIC(9.4,4,22,2,"PAH",23,1,61,0)=" By far the most important thing that a service provider can do to reduce"
^DIC(9.4,4,22,2,"PAH",23,1,62,0)=" spam or viruses is to ensure that any mail servers in operation accept only"
^DIC(9.4,4,22,2,"PAH",23,1,63,0)=" outgoing mail from machines within their own domains.  This prohibits SMTP"
^DIC(9.4,4,22,2,"PAH",23,1,64,0)=" relaying, denying spammers and virus propagators a necessary component of"
^DIC(9.4,4,22,2,"PAH",23,1,65,0)=" anonymity."
^DIC(9.4,4,22,2,"PAH",23,1,66,0)="MAIL GROUP: POSTMASTER"
^DIC(9.4,4,22,2,"PAH",23,1,67,0)=" DESCRIPTION:   This bulletin is sent when MailMan prevents an outside site"
^DIC(9.4,4,22,2,"PAH",23,1,68,0)=" from relaying a message to an outside site through this site."
^DIC(9.4,4,22,2,"PAH",23,1,69,0)="PARAMETER: 1"
^DIC(9.4,4,22,2,"PAH",23,1,70,0)=" DESCRIPTION:   The name of the site attempting to relay the message through"
^DIC(9.4,4,22,2,"PAH",23,1,71,0)=" this site."
^DIC(9.4,4,22,2,"PAH",23,1,72,0)="PARAMETER: 2"
^DIC(9.4,4,22,2,"PAH",23,1,73,0)=" DESCRIPTION:   The intended recipient of the message."
^DIC(9.4,4,22,2,"PAH",23,1,74,0)="PARAMETER: 3"
^DIC(9.4,4,22,2,"PAH",23,1,75,0)=" DESCRIPTION:   The envelope from of the message."
^DIC(9.4,4,22,2,"PAH",23,1,76,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,77,0)="This patch adds two new fields to the MAILMAN SITE PARAMETERS (#4.3) file:"
^DIC(9.4,4,22,2,"PAH",23,1,78,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,79,0)="STANDARD DATA DICTIONARY #4.3 -- MAILMAN SITE PARAMETERS FILE"
^DIC(9.4,4,22,2,"PAH",23,1,80,0)="STORED IN ^XMB(1,  (1 ENTRY)"
^DIC(9.4,4,22,2,"PAH",23,1,81,0)="DATA     NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,2,"PAH",23,1,82,0)="ELEMENT  TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,2,"PAH",23,1,83,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",23,1,84,0)="4.3,40   PREVENT MESSAGE RELAY? 4;1 SET"
^DIC(9.4,4,22,2,"PAH",23,1,85,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,86,0)="                           '1' FOR YES;"
^DIC(9.4,4,22,2,"PAH",23,1,87,0)="                           '0' FOR NO;"
^DIC(9.4,4,22,2,"PAH",23,1,88,0)="         LAST EDITED:      FEB 09, 2004"
^DIC(9.4,4,22,2,"PAH",23,1,89,0)="         HELP-PROMPT:      Should message relaying be prevented?"
^DIC(9.4,4,22,2,"PAH",23,1,90,0)="         DESCRIPTION:      Answer YES if you want to prevent outside sites"
^DIC(9.4,4,22,2,"PAH",23,1,91,0)="                           from sending mail through your site to other"
^DIC(9.4,4,22,2,"PAH",23,1,92,0)="                           outside sites.  Spammers and Virus propagators"
^DIC(9.4,4,22,2,"PAH",23,1,93,0)="                           use this technique to disguise the source of"
^DIC(9.4,4,22,2,"PAH",23,1,94,0)="                           their mail, and to make it appear to come from"
^DIC(9.4,4,22,2,"PAH",23,1,95,0)="                           a trusted source, namely your site."
^DIC(9.4,4,22,2,"PAH",23,1,96,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,97,0)="                           Answer NO if you want your site to act as a"
^DIC(9.4,4,22,2,"PAH",23,1,98,0)="                           relay site for anyone."
^DIC(9.4,4,22,2,"PAH",23,1,99,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,100,0)="                           It is strongly recommended that you answer YES"
^DIC(9.4,4,22,2,"PAH",23,1,101,0)="                           to prevent your site from unwittingly relaying"
^DIC(9.4,4,22,2,"PAH",23,1,102,0)="                           destructive mail."
^DIC(9.4,4,22,2,"PAH",23,1,103,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,104,0)="                           If you answer YES, you should define your"
^DIC(9.4,4,22,2,"PAH",23,1,105,0)="                           ""inside"" sites in the MY DOMAIN (field #41)"
^DIC(9.4,4,22,2,"PAH",23,1,106,0)="                           multiple, so that MailMan can distinguish them"
^DIC(9.4,4,22,2,"PAH",23,1,107,0)="                           from outside sites."
^DIC(9.4,4,22,2,"PAH",23,1,108,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,109,0)="                           Note: This does NOT prevent users from"
^DIC(9.4,4,22,2,"PAH",23,1,110,0)="                           receiving mail from outside sites.  It also"
^DIC(9.4,4,22,2,"PAH",23,1,111,0)="                           does NOT prevent users from forwarding mail to"
^DIC(9.4,4,22,2,"PAH",23,1,112,0)="                           outside sites.  Such uses are perfectly OK."
^DIC(9.4,4,22,2,"PAH",23,1,113,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,114,0)="4.3,41   MY DOMAINS             4.1;0 Multiple #4.341"
^DIC(9.4,4,22,2,"PAH",23,1,115,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,116,0)="4.341,.01  MY DOMAINS             0;1 FREE TEXT (Multiply asked)"
^DIC(9.4,4,22,2,"PAH",23,1,117,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,118,0)="           INPUT TRANSFORM:  K:$L(X)>30!($L(X)<3) X"
^DIC(9.4,4,22,2,"PAH",23,1,119,0)="           LAST EDITED:      FEB 09, 2004"
^DIC(9.4,4,22,2,"PAH",23,1,120,0)="           HELP-PROMPT:      Answer must be 3-30 characters in length."
^DIC(9.4,4,22,2,"PAH",23,1,121,0)="           DESCRIPTION:      If you answered YES to PREVENT MESSAGE"
^DIC(9.4,4,22,2,"PAH",23,1,122,0)="                             RELAYING? (field #40), to stop your site from"
^DIC(9.4,4,22,2,"PAH",23,1,123,0)="                             relaying messages from outside sites through"
^DIC(9.4,4,22,2,"PAH",23,1,124,0)="                             your site to other outside sites, you may add"
^DIC(9.4,4,22,2,"PAH",23,1,125,0)="                             entries here, in order to define what is an"
^DIC(9.4,4,22,2,"PAH",23,1,126,0)="                             ""inside"" site, or sites whose messages your"
^DIC(9.4,4,22,2,"PAH",23,1,127,0)="                             site is willing to relay."
^DIC(9.4,4,22,2,"PAH",23,1,128,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,129,0)="                             For example, if your site is a VA site, then"
^DIC(9.4,4,22,2,"PAH",23,1,130,0)="                             other VA sites are ""inside"" sites, and your"
^DIC(9.4,4,22,2,"PAH",23,1,131,0)="                             site should relay mail for them.  So, any"
^DIC(9.4,4,22,2,"PAH",23,1,132,0)="                             site whose domain name ends in "".DOMAIN.EXT"" is"
^DIC(9.4,4,22,2,"PAH",23,1,133,0)="                             an ""inside"" site.  So VA sites should have"
^DIC(9.4,4,22,2,"PAH",23,1,134,0)="                             only one record in this multiple, and it"
^DIC(9.4,4,22,2,"PAH",23,1,135,0)="                             should be "".DOMAIN.EXT""."
^DIC(9.4,4,22,2,"PAH",23,1,136,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,137,0)="                             The default, if there are no entries in this"
^DIC(9.4,4,22,2,"PAH",23,1,138,0)="                             multiple, is your site's domain name."
^DIC(9.4,4,22,2,"PAH",23,1,139,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,140,0)="                             MailMan will check the site name of any site"
^DIC(9.4,4,22,2,"PAH",23,1,141,0)="                             which connects to it, and identifies itself"
^DIC(9.4,4,22,2,"PAH",23,1,142,0)="                             in the SMTP HELO <sitename> command.  If the"
^DIC(9.4,4,22,2,"PAH",23,1,143,0)="                             sitename ends in any of the entries in this"
^DIC(9.4,4,22,2,"PAH",23,1,144,0)="                             multiple, then any mail coming from that site"
^DIC(9.4,4,22,2,"PAH",23,1,145,0)="                             through your site to other sites, will be"
^DIC(9.4,4,22,2,"PAH",23,1,146,0)="                             accepted and relayed onward."
^DIC(9.4,4,22,2,"PAH",23,1,147,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,148,0)="                             If the sitename does not end in any of the"
^DIC(9.4,4,22,2,"PAH",23,1,149,0)="                             entries in this multiple, then messages will"
^DIC(9.4,4,22,2,"PAH",23,1,150,0)="                             only be accepted that are addressed to"
^DIC(9.4,4,22,2,"PAH",23,1,151,0)="                             recipients whose sitenames end in one of the"
^DIC(9.4,4,22,2,"PAH",23,1,152,0)="                             entries in this multiple.  Otherwise, the"
^DIC(9.4,4,22,2,"PAH",23,1,153,0)="                             site will receive an error message telling it"
^DIC(9.4,4,22,2,"PAH",23,1,154,0)="                             that relaying is denied, and messages will"
^DIC(9.4,4,22,2,"PAH",23,1,155,0)="                             not be accepted for relaying onward."
^DIC(9.4,4,22,2,"PAH",23,1,156,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,157,0)="           CROSS-REFERENCE:  4.341^B"
^DIC(9.4,4,22,2,"PAH",23,1,158,0)="                             1)= S ^XMB(1,DA(1),4.1,""B"",$E(X,1,30),DA)="""""
^DIC(9.4,4,22,2,"PAH",23,1,159,0)="                             2)= K ^XMB(1,DA(1),4.1,""B"",$E(X,1,30),DA)"
^DIC(9.4,4,22,2,"PAH",23,1,160,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,161,0)="The post-init routine, ^XMYP24, will populate these fields for VA sites."
^DIC(9.4,4,22,2,"PAH",23,1,162,0)="Specifically, PREVENT MESSAGE RELAYING? (#40) will be set to YES, and"
^DIC(9.4,4,22,2,"PAH",23,1,163,0)=""".DOMAIN.EXT"" will be added to the MY DOMAIN (#41) multiple.  Non-VA sites"
^DIC(9.4,4,22,2,"PAH",23,1,164,0)="will have to populate these fields manually if they want to prevent message"
^DIC(9.4,4,22,2,"PAH",23,1,165,0)="relaying.  Routine ^XMYP24 will be deleted once it has run."
^DIC(9.4,4,22,2,"PAH",23,1,166,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,167,0)="Option XMKSP [MailMan Site Parameters] and Help Frame"
^DIC(9.4,4,22,2,"PAH",23,1,168,0)="XM-I-S-SITE PARAMETERS-REMOTE have been modified to include the new fields."
^DIC(9.4,4,22,2,"PAH",23,1,169,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,170,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",23,1,171,0)="is at a minimum. It requires patch XM*8.0*6.  This patch will take less"
^DIC(9.4,4,22,2,"PAH",23,1,172,0)="than one minute to install."
^DIC(9.4,4,22,2,"PAH",23,1,173,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,174,0)="IMPORTANT NOTE TO NON-VA SITES:"
^DIC(9.4,4,22,2,"PAH",23,1,175,0)="This patch is only active for VA sites.  VA sites are sites whose domain"
^DIC(9.4,4,22,2,"PAH",23,1,176,0)="name ends in "".DOMAIN.EXT"".  This patch will have absolutely no effect at"
^DIC(9.4,4,22,2,"PAH",23,1,177,0)="non-VA sites.  If you want to prevent MailMan at your non-VA site from"
^DIC(9.4,4,22,2,"PAH",23,1,178,0)="acting as an unwitting relay, you must edit fields 40 and 41 in file 4.3."
^DIC(9.4,4,22,2,"PAH",23,1,179,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",23,1,180,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,181,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",23,1,182,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",23,1,183,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",23,1,184,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,185,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",23,1,186,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",23,1,187,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",23,1,188,0)="XMR1          11104837        13422146        6,24"
^DIC(9.4,4,22,2,"PAH",23,1,189,0)="XMYP24        * NEW *           138765        24"
^DIC(9.4,4,22,2,"PAH",23,1,190,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",23,1,191,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,192,0)="This patch introduces routine ^XMYP24, which will be deleted once the"
^DIC(9.4,4,22,2,"PAH",23,1,193,0)="post-init has run."
^DIC(9.4,4,22,2,"PAH",23,1,194,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",23,1,195,0)=" "
^DIC(9.4,4,22,2,"PAH",23,1,196,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",23,1,197,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",23,1,198,0)="is at a minimum. It requires patch XM*8.0*6.  This patch will take less"
^DIC(9.4,4,22,2,"PAH",23,1,199,0)="than 1 minute to install."
^DIC(9.4,4,22,2,"PAH",23,1,200,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",23,1,201,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",23,1,202,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",23,1,203,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",23,1,204,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",23,1,205,0)="4.  Users may be on the system.  You do not need to stop TaskMan or the"
^DIC(9.4,4,22,2,"PAH",23,1,206,0)="    background filer."
^DIC(9.4,4,22,2,"PAH",23,1,207,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",23,1,208,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",23,1,209,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",23,1,210,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",23,1,211,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",23,1,212,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",23,1,213,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",23,1,214,0)=" Select INSTALL NAME:    XM*8.0*24     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",23,1,215,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",23,1,216,0)=" Install Questions for XM*8.0*24"
^DIC(9.4,4,22,2,"PAH",23,1,217,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,218,0)=" Incoming Files:"
^DIC(9.4,4,22,2,"PAH",23,1,219,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,220,0)="   4.3       MAILMAN SITE PARAMETERS  (Partial Definition)"
^DIC(9.4,4,22,2,"PAH",23,1,221,0)=" Note:  You already have the 'MAILMAN SITE PARAMETERS' File."
^DIC(9.4,4,22,2,"PAH",23,1,222,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,223,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,4,22,2,"PAH",23,1,224,0)="                                                                   ==="
^DIC(9.4,4,22,2,"PAH",23,1,225,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",23,1,226,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",23,1,227,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",23,1,228,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",23,1,229,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",23,1,230,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",23,1,231,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",23,1,232,0)=""
^DIC(9.4,4,22,2,"PAH",23,1,233,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",23,1,234,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",23,1,235,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",23,1,236,0)="7.  Enter a MAIL GROUP for the new bulletin XM RELAY ATTEMPTED."
^DIC(9.4,4,22,2,"PAH",23,1,237,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",24,0)="25 SEQ #24^3040702^1"
^DIC(9.4,4,22,2,"PAH",24,1,0)="^^77^77^3040702"
^DIC(9.4,4,22,2,"PAH",24,1,1,0)="Patch XM*8.0*25"
^DIC(9.4,4,22,2,"PAH",24,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,3,0)="NOIS: none"
^DIC(9.4,4,22,2,"PAH",24,1,4,0)="Test Site: Martinez HCS, Puget Sound HCS"
^DIC(9.4,4,22,2,"PAH",24,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,6,0)="This patch adds TCP/IP service for Cache/VMS.  All sites should install"
^DIC(9.4,4,22,2,"PAH",24,1,7,0)="this patch."
^DIC(9.4,4,22,2,"PAH",24,1,8,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,9,0)="Blood Bank Clearance: 3/23/2004"
^DIC(9.4,4,22,2,"PAH",24,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,11,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch XU*8*25 contains "
^DIC(9.4,4,22,2,"PAH",24,1,12,0)="changes to a package referenced in VHA IO SEPG SOP 192-023 ""Review of VISTA "
^DIC(9.4,4,22,2,"PAH",24,1,13,0)="Patches for Effects on VISTA Blood Bank Software . This patch does not "
^DIC(9.4,4,22,2,"PAH",24,1,14,0)="alter or modify any VistA Blood Bank software design safeguards or safety "
^DIC(9.4,4,22,2,"PAH",24,1,15,0)="critical elements functions."
^DIC(9.4,4,22,2,"PAH",24,1,16,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,17,0)="RISK ANALYSIS: Changes made by patch XU*8*25 have no effect on Blood Bank "
^DIC(9.4,4,22,2,"PAH",24,1,18,0)="software functionality, therefore RISK is none."
^DIC(9.4,4,22,2,"PAH",24,1,19,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,20,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",24,1,21,0)="is at a minimum.  It requires MailMan patch XM*8.0*19."
^DIC(9.4,4,22,2,"PAH",24,1,22,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",24,1,23,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,24,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",24,1,25,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",24,1,26,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",24,1,27,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,28,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",24,1,29,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",24,1,30,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",24,1,31,0)="XMJBN         10845646        11255537        25"
^DIC(9.4,4,22,2,"PAH",24,1,32,0)="XMRUCX         1139164         1512174        6,19,25"
^DIC(9.4,4,22,2,"PAH",24,1,33,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",24,1,34,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,35,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",24,1,36,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",24,1,37,0)=" "
^DIC(9.4,4,22,2,"PAH",24,1,38,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",24,1,39,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",24,1,40,0)="is at a minimum.  It requires MailMan patch XM*8.0*19."
^DIC(9.4,4,22,2,"PAH",24,1,41,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",24,1,42,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",24,1,43,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",24,1,44,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",24,1,45,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",24,1,46,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",24,1,47,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",24,1,48,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",24,1,49,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",24,1,50,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",24,1,51,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",24,1,52,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",24,1,53,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",24,1,54,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",24,1,55,0)=" Select INSTALL NAME:    XM*8.0*19     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",24,1,56,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",24,1,57,0)=" Install Questions for XM*8.0*19"
^DIC(9.4,4,22,2,"PAH",24,1,58,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,59,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",24,1,60,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",24,1,61,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",24,1,62,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",24,1,63,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",24,1,64,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",24,1,65,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",24,1,66,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,67,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",24,1,68,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",24,1,69,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",24,1,70,0)=""
^DIC(9.4,4,22,2,"PAH",24,1,71,0)="7.  Cache/VMS Sites: Add something like this to your VMS TCPIP script:"
^DIC(9.4,4,22,2,"PAH",24,1,72,0)="$!-------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",24,1,73,0)="$! for Cache"
^DIC(9.4,4,22,2,"PAH",24,1,74,0)="$! assign  'f$trnlnm(""SYS$NET"")' SYS$NET"
^DIC(9.4,4,22,2,"PAH",24,1,75,0)="$! ccontrol session <configname> ""-U"" ""<namespace>"" ""CACHEVMS^XMRUCX"""
^DIC(9.4,4,22,2,"PAH",24,1,76,0)="$!-------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",24,1,77,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",25,0)="18 SEQ #25^3040702^1"
^DIC(9.4,4,22,2,"PAH",25,1,0)="^^2^2^3040702"
^DIC(9.4,4,22,2,"PAH",25,1,1,0)="See patch XM*8*18 in the National Patch Module on FORUM for complete"
^DIC(9.4,4,22,2,"PAH",25,1,2,0)="information on this patch."
^DIC(9.4,4,22,2,"PAH",26,0)="27 SEQ #26^3041029^1"
^DIC(9.4,4,22,2,"PAH",26,1,0)="^^4^4^3041029"
^DIC(9.4,4,22,2,"PAH",26,1,1,0)=" "
^DIC(9.4,4,22,2,"PAH",26,1,2,0)="DIQUIET Variable is not NEWED or KILLED in the Mail Manager Routines. As "
^DIC(9.4,4,22,2,"PAH",26,1,3,0)="part of a preventative measure, the DIQUIET variable is being NEWed in "
^DIC(9.4,4,22,2,"PAH",26,1,4,0)="the Mailman routines."
^DIC(9.4,4,22,2,"PAH",27,0)="28 SEQ #27^3050212^1"
^DIC(9.4,4,22,2,"PAH",27,1,0)="^^2^2^3050212"
^DIC(9.4,4,22,2,"PAH",27,1,1,0)=" "
^DIC(9.4,4,22,2,"PAH",27,1,2,0)="Scheduling an option to P-MESSAGE"
^DIC(9.4,4,22,2,"PAH",28,0)="26 SEQ #28^3050611^1"
^DIC(9.4,4,22,2,"PAH",28,1,0)="^^4^4^3050611"
^DIC(9.4,4,22,2,"PAH",28,1,1,0)="If you stay in user menu while selecting P-MESSAGE and then go to "
^DIC(9.4,4,22,2,"PAH",28,1,2,0)="another application with the DEVICE prompt, the XMQUIET variable is not "
^DIC(9.4,4,22,2,"PAH",28,1,3,0)="killed.  Therefore, the 'Subject' and the subsequent questions are not "
^DIC(9.4,4,22,2,"PAH",28,1,4,0)="asked (version 3 changes)."
^DIC(9.4,4,22,2,"PAH",29,0)="30 SEQ #30^3050611^1"
^DIC(9.4,4,22,2,"PAH",29,1,0)="^^1^1^3050611"
^DIC(9.4,4,22,2,"PAH",29,1,1,0)="Delivery queue clogged by very large messages"
^DIC(9.4,4,22,2,"PAH",30,0)="35 SEQ #32^3051202^1"
^DIC(9.4,4,22,2,"PAH",30,1,0)="^^1^1^3051202"
^DIC(9.4,4,22,2,"PAH",30,1,1,0)="Close ALL OGC domains (with the ""RC-<something>.GC.DOMAIN.EXT"" format)."
^DIC(9.4,4,22,2,"PAH",31,0)="34 SEQ #33^3060112^1"
^DIC(9.4,4,22,2,"PAH",31,1,0)="^^1^1^3060112"
^DIC(9.4,4,22,2,"PAH",31,1,1,0)="Undefined error at Q+12^XMXUTIL3."
^DIC(9.4,4,22,2,"PAH",32,0)="33 SEQ #34^3060112^1"
^DIC(9.4,4,22,2,"PAH",32,1,0)="^^1^1^3060112"
^DIC(9.4,4,22,2,"PAH",32,1,1,0)="Corrects XM*8*26"
^DIC(9.4,4,22,2,"PAH",33,0)="36 SEQ #36^3060711^1"
^DIC(9.4,4,22,2,"PAH",33,1,0)="^^1^1^3060711"
^DIC(9.4,4,22,2,"PAH",33,1,1,0)="Allow a non-human user to send bulletins."
^DIC(9.4,4,22,2,"PAH",34,0)="41 SEQ #38^3090924.124323^17"
^DIC(9.4,4,22,2,"PAH",34,1,0)="^^5^5^3090924"
^DIC(9.4,4,22,2,"PAH",34,1,1,0)="There are two fixes in this patch: The first issue concerns an error "
^DIC(9.4,4,22,2,"PAH",34,1,2,0)="message when trying to secure a KIDS build in Packman.  The second"
^DIC(9.4,4,22,2,"PAH",34,1,3,0)="issue occurs while using the XMXAPI's, the variable DIERR is being"
^DIC(9.4,4,22,2,"PAH",34,1,4,0)="leaked which could cause other issues in Fileman if it is not "
^DIC(9.4,4,22,2,"PAH",34,1,5,0)="cleaned up."
^DIC(9.4,4,22,2,"PAH",35,0)="40 SEQ #39^3100830.172654^17"
^DIC(9.4,4,22,2,"PAH",35,1,0)="^^4^4^3100830"
^DIC(9.4,4,22,2,"PAH",35,1,1,0)="This patch will prevent users from adding themselves as their"
^DIC(9.4,4,22,2,"PAH",35,1,2,0)="own surrogate, correct the Mailman Developers Guide so "
^DIC(9.4,4,22,2,"PAH",35,1,3,0)="the documentation is accurate regarding the API XMXAPIG,"
^DIC(9.4,4,22,2,"PAH",35,1,4,0)="and inactivate the domain LRN.DOMAIN.EXT."
^DIC(9.4,4,22,2,"PAH",36,0)="44 SEQ #40^3120829.114113^17"
^DIC(9.4,4,22,2,"PAH",36,1,0)="^^3^3^3120829"
^DIC(9.4,4,22,2,"PAH",36,1,1,0)="This patch updates the Mailman TCPIP entry point to handle"
^DIC(9.4,4,22,2,"PAH",36,1,2,0)="instances where the software is run on Linux based Operating "
^DIC(9.4,4,22,2,"PAH",36,1,3,0)="Systems."
^DIC(9.4,4,22,2,"PAH",37,0)="45 SEQ #41^3140129.150149^17"
^DIC(9.4,4,22,2,"PAH",37,1,0)="^^6^6^3140129"
^DIC(9.4,4,22,2,"PAH",37,1,1,0)=" "
^DIC(9.4,4,22,2,"PAH",37,1,2,0)="This patch will address the following issues:"
^DIC(9.4,4,22,2,"PAH",37,1,3,0)="1. Mailman returns an error ""may not be real person"""
^DIC(9.4,4,22,2,"PAH",37,1,4,0)="2. Partial message is being delivered due to multiple"
^DIC(9.4,4,22,2,"PAH",37,1,5,0)="message parts that come through from different servers at different times."
^DIC(9.4,4,22,2,"PAH",37,1,6,0)="3. Compile errors on the $ZC command."
^DIC(9.4,4,22,2,"PAH",38,0)="47 SEQ #42^3160108.115455^54"
^DIC(9.4,4,22,2,"PAH",38,1,0)="^^25^25^3160108"
^DIC(9.4,4,22,2,"PAH",38,1,1,0)="Patch XM*8.0*47 addresses five issues:"
^DIC(9.4,4,22,2,"PAH",38,1,2,0)=" "
^DIC(9.4,4,22,2,"PAH",38,1,3,0)="1. When using the Mailman extrinsic function $$MG^XMBGRP to create a new "
^DIC(9.4,4,22,2,"PAH",38,1,4,0)="mail group, if the organizer's DUZ is only 4 digits, and those 4 digits "
^DIC(9.4,4,22,2,"PAH",38,1,5,0)="match with the last 4 of the SSN of any person in the New Person(#200) "
^DIC(9.4,4,22,2,"PAH",38,1,6,0)="file, the call will fail and the mail group will not be created."
^DIC(9.4,4,22,2,"PAH",38,1,7,0)=" "
^DIC(9.4,4,22,2,"PAH",38,1,8,0)="2. When using the Mailman API SENDMSG^XMXAPI, if the subject line is "
^DIC(9.4,4,22,2,"PAH",38,1,9,0)="under 3 characters or over 65 characters the API will fail and the "
^DIC(9.4,4,22,2,"PAH",38,1,10,0)="message will not be sent. When using the Mailman application to send a "
^DIC(9.4,4,22,2,"PAH",38,1,11,0)="message, subject lines are automatically truncated. The code changes will "
^DIC(9.4,4,22,2,"PAH",38,1,12,0)="duplicate this functionality."
^DIC(9.4,4,22,2,"PAH",38,1,13,0)=" "
^DIC(9.4,4,22,2,"PAH",38,1,14,0)="3. An entry in the BULLETIN(3.6) file named XM DOMAIN ADDED makes several "
^DIC(9.4,4,22,2,"PAH",38,1,15,0)="references to the NOIS system which is no longer used. In an effort to "
^DIC(9.4,4,22,2,"PAH",38,1,16,0)="correct this issue and avoid future issues, the name NOIS will be "
^DIC(9.4,4,22,2,"PAH",38,1,17,0)="replaced with the more generic term ""trouble ticket."""
^DIC(9.4,4,22,2,"PAH",38,1,18,0)=" "
^DIC(9.4,4,22,2,"PAH",38,1,19,0)="4. Two Mailman API's have been confirmed to be functioning incorrectly. "
^DIC(9.4,4,22,2,"PAH",38,1,20,0)="The COPYAMT^XMXSEC1 API does not properly count the number of lines in a "
^DIC(9.4,4,22,2,"PAH",38,1,21,0)="mail message. The OPTEDIT^XMXSEC2 API does not properly check if a "
^DIC(9.4,4,22,2,"PAH",38,1,22,0)="message text or message subject line can be edited."
^DIC(9.4,4,22,2,"PAH",38,1,23,0)=" "
^DIC(9.4,4,22,2,"PAH",38,1,24,0)="5. Mailman API QX^XMXUTIL3 is not properly displaying a list of users "
^DIC(9.4,4,22,2,"PAH",38,1,25,0)="that are either current or not current in reading a message."
^DIC(9.4,4,22,2,"PAH",39,0)="48 SEQ #43^3160115.152931^54"
^DIC(9.4,4,22,2,"PAH",39,1,0)="^^2^2^3160115"
^DIC(9.4,4,22,2,"PAH",39,1,1,0)="In preparation for the VA's transition from IPv4 to IPv6 the MailMan "
^DIC(9.4,4,22,2,"PAH",39,1,2,0)="package will require modifications to make it IPv6 ready."
^DIC(9.4,4,22,2,"PAH",40,0)="49 SEQ #44^3190103.165822^54"
^DIC(9.4,4,22,2,"PAH",40,1,0)="^^4^4^3190103"
^DIC(9.4,4,22,2,"PAH",40,1,1,0)="The variable DIRUT is being left in the partition when reports use the "
^DIC(9.4,4,22,2,"PAH",40,1,2,0)="P-MESSAGE device.  This can result in inappropriate program execution as"
^DIC(9.4,4,22,2,"PAH",40,1,3,0)="well as being a SAC standard violation.  This patch corrects this"
^DIC(9.4,4,22,2,"PAH",40,1,4,0)="deficiency."
^DIC(9.4,4,22,2,"PAH",41,0)="51 SEQ #45^3240417.115012^89"
^DIC(9.4,4,22,2,"PAH",41,1,0)="^^4^4^3240417"
^DIC(9.4,4,22,2,"PAH",41,1,1,0)="Patch XM*8.0*51 addresses an issue with two MailMan commands."
^DIC(9.4,4,22,2,"PAH",41,1,2,0)="MailMan needs to be updated to disable the EXPN and VRFY commands."
^DIC(9.4,4,22,2,"PAH",41,1,3,0)="     There is no configuration option to tune SMTP commands in MailMan."
^DIC(9.4,4,22,2,"PAH",41,1,4,0)="     This impacts all VistA sites that enable the MailMan service."
^DIC(9.4,4,22,2,"PAH",42,0)="52 SEQ #46^3240517.102213^89"
^DIC(9.4,4,22,2,"PAH",42,1,0)="^^2^2^3240517"
^DIC(9.4,4,22,2,"PAH",42,1,1,0)="This Mailman patch XM*8.0*52 - sets LOCKS for options, and Audit for"
^DIC(9.4,4,22,2,"PAH",42,1,2,0)="fields.  Please refer to the description in Forum Patch."
^DIC(9.4,4,22,2,"PAH",43,0)="54 SEQ #47^3260327.104135^90"
^DIC(9.4,4,22,2,"PAH",43,1,0)="^^2^2^3260327"
^DIC(9.4,4,22,2,"PAH",43,1,1,0)="This patch includes a single routine containing read-only calls to "
^DIC(9.4,4,22,2,"PAH",43,1,2,0)="support the VistA System Monitor Operations Dashboard."
