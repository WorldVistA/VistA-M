^DIC(9.4,14,22,5.9,"PAH",125,1,91,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,92,0)="MODIFIED OPTIONS:"
^DIC(9.4,14,22,5.9,"PAH",125,1,93,0)="================"
^DIC(9.4,14,22,5.9,"PAH",125,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,95,0)="NAME: LRAC DISCHARGE         MENU TEXT: Patient Lab Discharge Summary "
^DIC(9.4,14,22,5.9,"PAH",125,1,96,0)="(Manual)"
^DIC(9.4,14,22,5.9,"PAH",125,1,97,0)="  TYPE: run routine "
^DIC(9.4,14,22,5.9,"PAH",125,1,98,0)="   DESCRIPTION:   THIS OPTION PRINTS IN THE INTERIM FORMAT.  The report "
^DIC(9.4,14,22,5.9,"PAH",125,1,99,0)="prints site codes for tests and prints a separate page(s) at the end of the "
^DIC(9.4,14,22,5.9,"PAH",125,1,100,0)="report which lists the performing lab name, address and site code.  This option "
^DIC(9.4,14,22,5.9,"PAH",125,1,101,0)="will print interim reports for a selected patient within a given time period.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,102,0)="The printout will go inverse date order.  This report will output all tests "
^DIC(9.4,14,22,5.9,"PAH",125,1,103,0)="for the time period specified.  This option will only print verified results.   "
^DIC(9.4,14,22,5.9,"PAH",125,1,104,0)="  ROUTINE: CUM^LRRP2"
^DIC(9.4,14,22,5.9,"PAH",125,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,106,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,107,0)="NAME: LRAC PT     MENU TEXT: Reprint cumulative on a given patient"
^DIC(9.4,14,22,5.9,"PAH",125,1,108,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",125,1,109,0)=" DESCRIPTION:   THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT. The report "
^DIC(9.4,14,22,5.9,"PAH",125,1,110,0)="prints site codes for tests and prints a separate page(s) at the end of the "
^DIC(9.4,14,22,5.9,"PAH",125,1,111,0)="report which lists the performing lab name, address and site code.  This option "
^DIC(9.4,14,22,5.9,"PAH",125,1,112,0)="will print interim reports for a selected patient within a given time period.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,113,0)="The printout will go inverse date order.  This report will output all tests "
^DIC(9.4,14,22,5.9,"PAH",125,1,114,0)="for the time period specified.  This option will only print verified results."
^DIC(9.4,14,22,5.9,"PAH",125,1,115,0)="  ROUTINE: CUM^LRRP2"
^DIC(9.4,14,22,5.9,"PAH",125,1,116,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,118,0)="NAME: LRAC LOC     MENU TEXT: Reprint cumulative on a given location"
^DIC(9.4,14,22,5.9,"PAH",125,1,119,0)="  TYPE: run routine "
^DIC(9.4,14,22,5.9,"PAH",125,1,120,0)=" DESCRIPTION:   THIS OPTION NOW PRINTS IN THE INTERIM FORMAT. The report "
^DIC(9.4,14,22,5.9,"PAH",125,1,121,0)="prints site codes for tests and prints a separate page(s) at the end of the "
^DIC(9.4,14,22,5.9,"PAH",125,1,122,0)="report which lists the performing lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,123,0)="  This option reports all verified results from one location for one day."
^DIC(9.4,14,22,5.9,"PAH",125,1,124,0)="  ROUTINE: CUMSGLE^LRRS "
^DIC(9.4,14,22,5.9,"PAH",125,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,127,0)="NAME: LRAC LOC-LOC     MENU TEXT: Reprint cumulative from location to "
^DIC(9.4,14,22,5.9,"PAH",125,1,128,0)="location"
^DIC(9.4,14,22,5.9,"PAH",125,1,129,0)="  TYPE: run routine "
^DIC(9.4,14,22,5.9,"PAH",125,1,130,0)=" DESCRIPTION:   THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT.  The report"
^DIC(9.4,14,22,5.9,"PAH",125,1,131,0)="prints site codes for tests and prints a separate page(s) at the end of the"
^DIC(9.4,14,22,5.9,"PAH",125,1,132,0)="report which lists the performing lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,133,0)="Detailed report format for all data for one day sorted by location. This option"
^DIC(9.4,14,22,5.9,"PAH",125,1,134,0)="will only print verified results.  The date chosen for this report is the"
^DIC(9.4,14,22,5.9,"PAH",125,1,135,0)="collection date.  If a test is ordered on one day and verified on the next "
^DIC(9.4,14,22,5.9,"PAH",125,1,136,0)="day,you must select the order date to see the report with this option."
^DIC(9.4,14,22,5.9,"PAH",125,1,137,0)="  ROUTINE: CUM^LRRS"
^DIC(9.4,14,22,5.9,"PAH",125,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,140,0)="NAME: LRAC 1 PAGE     MENU TEXT: Reprint a permanent page from cumulative"
^DIC(9.4,14,22,5.9,"PAH",125,1,141,0)="  TYPE: run routine  "
^DIC(9.4,14,22,5.9,"PAH",125,1,142,0)=" DESCRIPTION:   THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT.  The report"
^DIC(9.4,14,22,5.9,"PAH",125,1,143,0)="prints site codes for tests and prints a separate page(s) at the end of the"
^DIC(9.4,14,22,5.9,"PAH",125,1,144,0)="report which lists the performing lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,145,0)="This option will print interim reports for a selected patient within a "
^DIC(9.4,14,22,5.9,"PAH",125,1,146,0)="given time period.  The printout will go inverse date order.  This report will "
^DIC(9.4,14,22,5.9,"PAH",125,1,147,0)="output all tests for the time period specified.  This option will only print "
^DIC(9.4,14,22,5.9,"PAH",125,1,148,0)="verified results.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,149,0)="  ROUTINE: CUM^LRRP2 "
^DIC(9.4,14,22,5.9,"PAH",125,1,150,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,151,0)="NAME: LRAC MANUAL     MENU TEXT: Manual queuing of cumulative"
^DIC(9.4,14,22,5.9,"PAH",125,1,152,0)="  TYPE: run routine      "
^DIC(9.4,14,22,5.9,"PAH",125,1,153,0)=" DESCRIPTION:   THIS OPTION PRINTS IN THE INTERIM REPORT FORMAT.  The "
^DIC(9.4,14,22,5.9,"PAH",125,1,154,0)="report prints site codes for tests and prints a separate page(s) at the end"
^DIC(9.4,14,22,5.9,"PAH",125,1,155,0)="of the report which lists the performing lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,156,0)="This option will print interim reports for a selected patient within a "
^DIC(9.4,14,22,5.9,"PAH",125,1,157,0)="given time period.  The printout will go inverse date order.  This report will "
^DIC(9.4,14,22,5.9,"PAH",125,1,158,0)="output all tests for the time period specified.  This option will only print "
^DIC(9.4,14,22,5.9,"PAH",125,1,159,0)="verified results.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,160,0)="  ROUTINE: CUM^LRRP2"
^DIC(9.4,14,22,5.9,"PAH",125,1,161,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,162,0)="NAME: LRAC FULL PATIENT SUMMARY     MENU TEXT: Print a full patient summary"
^DIC(9.4,14,22,5.9,"PAH",125,1,163,0)="TYPE: run routine    "
^DIC(9.4,14,22,5.9,"PAH",125,1,164,0)="DESCRIPTION:   Prints a full patient summary using the interim report "
^DIC(9.4,14,22,5.9,"PAH",125,1,165,0)="format.  It simply captures all lab data on a patient and prints the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,166,0)="lab sites and addresses on a separate page(s).  "
^DIC(9.4,14,22,5.9,"PAH",125,1,167,0)="ROUTINE: SUM^LRACM2"
^DIC(9.4,14,22,5.9,"PAH",125,1,168,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,169,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,170,0)="NAME: LRRD      MENU TEXT: Interim report by provider"
^DIC(9.4,14,22,5.9,"PAH",125,1,171,0)="TYPE: run routine      "
^DIC(9.4,14,22,5.9,"PAH",125,1,172,0)="DESCRIPTION:   This option is used to obtain all data on one day for "
^DIC(9.4,14,22,5.9,"PAH",125,1,173,0)="selected providers.  All providers may be selected or a range of providers "
^DIC(9.4,14,22,5.9,"PAH",125,1,174,0)="(this may be helpful if obtaining reports for all providers but you wish to "
^DIC(9.4,14,22,5.9,"PAH",125,1,175,0)="split the load between multiple printers).  Multiple selections are allowed for"
^DIC(9.4,14,22,5.9,"PAH",125,1,176,0)="selecting specific providers.  All reports are sorted by provider name. If no "
^DIC(9.4,14,22,5.9,"PAH",125,1,177,0)="results are available for a provider, the option will print the provider's name"
^DIC(9.4,14,22,5.9,"PAH",125,1,178,0)="followed by the next provider's name.  This option is an alternative to "
^DIC(9.4,14,22,5.9,"PAH",125,1,179,0)="having the Interim report tasked to the taskmanager.  Only verified results will"
^DIC(9.4,14,22,5.9,"PAH",125,1,180,0)="be printed.  This option is not part of the cumulative report and should not "
^DIC(9.4,14,22,5.9,"PAH",125,1,181,0)="be charted.  The date chosen for this report is the collection date.  If a "
^DIC(9.4,14,22,5.9,"PAH",125,1,182,0)="test is ordered on one day and verified on the next, you have to select the "
^DIC(9.4,14,22,5.9,"PAH",125,1,183,0)="order date to see the report.  The report prints site codes for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,184,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,185,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,186,0)="lab name, address and site code. "
^DIC(9.4,14,22,5.9,"PAH",125,1,187,0)="ROUTINE: LRRD"
^DIC(9.4,14,22,5.9,"PAH",125,1,188,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,189,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,190,0)="NAME: LRRD BY MD     MENU TEXT: Interim reports for 1 provider (manual queue)"
^DIC(9.4,14,22,5.9,"PAH",125,1,191,0)="TYPE: run routine    "
^DIC(9.4,14,22,5.9,"PAH",125,1,192,0)="DESCRIPTION:   This option reports all verified results for one day for "
^DIC(9.4,14,22,5.9,"PAH",125,1,193,0)="one provider.  The user will request the date and provider.  This option will "
^DIC(9.4,14,22,5.9,"PAH",125,1,194,0)="only print verified results.  The date requested should be the date the lab "
^DIC(9.4,14,22,5.9,"PAH",125,1,195,0)="work was collected.  This option is to be used for information only and should "
^DIC(9.4,14,22,5.9,"PAH",125,1,196,0)="not be charted.  The report prints site codes for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,197,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,198,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,199,0)="lab name, address and site code.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,200,0)="ROUTINE: SINGLE^LRRD"
^DIC(9.4,14,22,5.9,"PAH",125,1,201,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,202,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,203,0)="NAME: LRRP3     MENU TEXT: Interim report for chosen tests"
^DIC(9.4,14,22,5.9,"PAH",125,1,204,0)="TYPE: run routine              "
^DIC(9.4,14,22,5.9,"PAH",125,1,205,0)="DESCRIPTION:   This report will display results in inverse date order.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,206,0)="The option allows the user to select a specific test or panel of tests for a"
^DIC(9.4,14,22,5.9,"PAH",125,1,207,0)=" specified time period.  Regardless of whether the orders have been purged, "
^DIC(9.4,14,22,5.9,"PAH",125,1,208,0)="the results may be displayed.  The report should not be charted.  The report"
^DIC(9.4,14,22,5.9,"PAH",125,1,209,0)="prints site codes for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,210,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,211,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,212,0)="lab name, address and site code.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,213,0)="ROUTINE: LRRP3"
^DIC(9.4,14,22,5.9,"PAH",125,1,214,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,215,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,216,0)="NAME: LRRP2     MENU TEXT: Interim report  "
^DIC(9.4,14,22,5.9,"PAH",125,1,217,0)="TYPE: run routine   "
^DIC(9.4,14,22,5.9,"PAH",125,1,218,0)="DESCRIPTION:   This option will print or display interim reports for a"
^DIC(9.4,14,22,5.9,"PAH",125,1,219,0)="selected patient, within a given time period.  The printout will go in "
^DIC(9.4,14,22,5.9,"PAH",125,1,220,0)="inverse date order.  This report will output all tests for the time period "
^DIC(9.4,14,22,5.9,"PAH",125,1,221,0)="specified.  If no results are available, the option will ask for another "
^DIC(9.4,14,22,5.9,"PAH",125,1,222,0)="patient.  This option will only print verified results.  The report prints"
^DIC(9.4,14,22,5.9,"PAH",125,1,223,0)="site codes for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,224,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,225,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,226,0)="lab name, address and site code.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,227,0)="ROUTINE: LRRP2         "
^DIC(9.4,14,22,5.9,"PAH",125,1,228,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,229,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,230,0)="NAME: LRRS     MENU TEXT: Interim reports by location (manual queue)"
^DIC(9.4,14,22,5.9,"PAH",125,1,231,0)="TYPE: run routine             "
^DIC(9.4,14,22,5.9,"PAH",125,1,232,0)="DESCRIPTION:   Detailed report format for all data for one day sorted by"
^DIC(9.4,14,22,5.9,"PAH",125,1,233,0)="location.  This option is an alternative to having the Interim report "
^DIC(9.4,14,22,5.9,"PAH",125,1,234,0)="tasked to the taskmanager.  For tasking, see option LRTASK DAILY INTERIM 1.  If "
^DIC(9.4,14,22,5.9,"PAH",125,1,235,0)="no results are available for a location, the option will print out the "
^DIC(9.4,14,22,5.9,"PAH",125,1,236,0)="location heading followed by the next location heading.  This option will only "
^DIC(9.4,14,22,5.9,"PAH",125,1,237,0)="print verified results, is not part of the cumulative report and should not be"
^DIC(9.4,14,22,5.9,"PAH",125,1,238,0)=" charted.  The date chosen for this report is the collection date.  If a "
^DIC(9.4,14,22,5.9,"PAH",125,1,239,0)="test is ordered on one day and verified on the next day, you must select the "
^DIC(9.4,14,22,5.9,"PAH",125,1,240,0)="order date to see the report with this option.  The report prints site codes"
^DIC(9.4,14,22,5.9,"PAH",125,1,241,0)="for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,242,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,243,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,244,0)="lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,245,0)="ROUTINE: LRRS12"
^DIC(9.4,14,22,5.9,"PAH",125,1,246,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,247,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,248,0)="NAME: LRRSP     MENU TEXT: Interim report for selected tests as ordered"
^DIC(9.4,14,22,5.9,"PAH",125,1,249,0)="TYPE: run routine          "
^DIC(9.4,14,22,5.9,"PAH",125,1,250,0)="DESCRIPTION:   Detailed report format for an individual patient.  Report "
^DIC(9.4,14,22,5.9,"PAH",125,1,251,0)="is done for selected tests as they are ordered.  If the orders have been "
^DIC(9.4,14,22,5.9,"PAH",125,1,252,0)="purged, the results will not be found because the result look-up is dependent "
^DIC(9.4,14,22,5.9,"PAH",125,1,253,0)="on the orders.  This option allows the user to select a specific test or panel, "
^DIC(9.4,14,22,5.9,"PAH",125,1,254,0)="or select the ""ANY"" test default which will output all the verified tests for"
^DIC(9.4,14,22,5.9,"PAH",125,1,255,0)="that patient during the time period specified.  If no results are available,"
^DIC(9.4,14,22,5.9,"PAH",125,1,256,0)="the option will ask for another patient.  This option will only print "
^DIC(9.4,14,22,5.9,"PAH",125,1,257,0)="verified results and should be used for information only.  The option should"
^DIC(9.4,14,22,5.9,"PAH",125,1,258,0)="not be charted.    The report prints site codes for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,259,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,260,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,261,0)="lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,262,0)="ROUTINE: LRRSP "
^DIC(9.4,14,22,5.9,"PAH",125,1,263,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,264,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,265,0)="NAME: LRRS BY LOC     MENU TEXT: Interim reports for 1 location (manual queue)"
^DIC(9.4,14,22,5.9,"PAH",125,1,266,0)="TYPE: run routine              "
^DIC(9.4,14,22,5.9,"PAH",125,1,267,0)="DESCRIPTION:   This option reports all verified results from one location "
^DIC(9.4,14,22,5.9,"PAH",125,1,268,0)="for one day.  The user will request the date and location.  This option will "
^DIC(9.4,14,22,5.9,"PAH",125,1,269,0)="only print verified results.  This option is to be used for information only "
^DIC(9.4,14,22,5.9,"PAH",125,1,270,0)="and should not be charted.    The report prints site codes for tests.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,271,0)="You will be asked if you would like to print an address page.  The address page"
^DIC(9.4,14,22,5.9,"PAH",125,1,272,0)="prints on a separate page(s) at the end of the report and lists the performing"
^DIC(9.4,14,22,5.9,"PAH",125,1,273,0)="lab name, address and site code."
^DIC(9.4,14,22,5.9,"PAH",125,1,274,0)="ROUTINE: SINGLE^LRRS"
^DIC(9.4,14,22,5.9,"PAH",125,1,275,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,276,0)="NAME: LRTASK CUM    MENU TEXT: TASK THE CUMULATIVE TO RUN EACH NITE"
^DIC(9.4,14,22,5.9,"PAH",125,1,277,0)="  TYPE: run routine             "
^DIC(9.4,14,22,5.9,"PAH",125,1,278,0)=" DESCRIPTION:   THIS OPTION NOW PRINTS IN THE INTERIM REPORT FORMAT.  The"
^DIC(9.4,14,22,5.9,"PAH",125,1,279,0)=" report prints site codes for tests and prints a separate page(s) at the "
^DIC(9.4,14,22,5.9,"PAH",125,1,280,0)="end of the report which lists the performing lab name, address and site code.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,281,0)="This function is automatically run by the TaskManager.  This is the daily "
^DIC(9.4,14,22,5.9,"PAH",125,1,282,0)="interim cumulative report.  "
^DIC(9.4,14,22,5.9,"PAH",125,1,283,0)="  ROUTINE: AIDQ^LRRP2                   "
^DIC(9.4,14,22,5.9,"PAH",125,1,284,0)="  SCHEDULING RECOMMENDED: YES"
^DIC(9.4,14,22,5.9,"PAH",125,1,285,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,286,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,287,0)="Testing Sites:"
^DIC(9.4,14,22,5.9,"PAH",125,1,288,0)="=============="
^DIC(9.4,14,22,5.9,"PAH",125,1,289,0)="Detroit VAMC"
^DIC(9.4,14,22,5.9,"PAH",125,1,290,0)="Little Rock VAMC"
^DIC(9.4,14,22,5.9,"PAH",125,1,291,0)="Asheville VAMC"
^DIC(9.4,14,22,5.9,"PAH",125,1,292,0)="Bay Pines VAMC"
^DIC(9.4,14,22,5.9,"PAH",125,1,293,0)="Muskogee VAMC"
^DIC(9.4,14,22,5.9,"PAH",125,1,294,0)="VISN 2"
^DIC(9.4,14,22,5.9,"PAH",125,1,295,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,296,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",125,1,297,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",125,1,298,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",125,1,299,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",125,1,300,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",125,1,301,0)=" "
