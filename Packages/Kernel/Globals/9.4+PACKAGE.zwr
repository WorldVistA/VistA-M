^DIC(9.4,175,22,2,"PAH",233,0)="341^3231201.124646^89"
^DIC(9.4,175,22,2,"PAH",233,1,0)="^^1^1^3231201"
^DIC(9.4,175,22,2,"PAH",233,1,1,0)="VA patch 341 (companion to ISI patch 110) -- ISI Rad; replaces VistARad"
^DIC(9.4,175,22,2,"PAH",234,0)="353^3240125.115347^89"
^DIC(9.4,175,22,2,"PAH",235,0)="348 SEQ #252^3240201.164552^89"
^DIC(9.4,175,22,2,"PAH",236,0)="334^3241017.104649^89"
^DIC(9.4,175,22,2,"PAH",236,1,0)="^^2^2^3241017"
^DIC(9.4,175,22,2,"PAH",236,1,1,0)="     "
^DIC(9.4,175,22,2,"PAH",236,1,2,0)="MAG*3.0*334 is a patch that provides fixes to VistA Imaging Clinical Display.  "
^DIC(9.4,175,22,2,"PAH",237,0)="350^3241030.124325^89"
^DIC(9.4,175,22,2,"PAH",237,1,0)="^^11^11^3241030"
^DIC(9.4,175,22,2,"PAH",237,1,1,0)="A problem was caused by patch MAG*3.0*226 (October 2019) which changed"
^DIC(9.4,175,22,2,"PAH",237,1,2,0)="the way that Clinical Capture stored DICOM images."
^DIC(9.4,175,22,2,"PAH",237,1,3,0)=" "
^DIC(9.4,175,22,2,"PAH",237,1,4,0)="Instead of saving them as DICOM objects, they were stored as raw JPEG"
^DIC(9.4,175,22,2,"PAH",237,1,5,0)="images with a *.DCM extension.  These images need to be converted to"
^DIC(9.4,175,22,2,"PAH",237,1,6,0)="DICOM and stored as proper DICOM objects.  The previously stored JPEG"
^DIC(9.4,175,22,2,"PAH",237,1,7,0)="images need to be renamed using the *.JPG extension."
^DIC(9.4,175,22,2,"PAH",237,1,8,0)=" "
^DIC(9.4,175,22,2,"PAH",237,1,9,0)="These changes must be performed on both Tier-1 and Tier-2 storage."
^DIC(9.4,175,22,2,"PAH",237,1,10,0)=" "
^DIC(9.4,175,22,2,"PAH",237,1,11,0)="This patch corrects this problem."
^DIC(9.4,175,22,2,"PAH",238,0)="357^3241115.142627^89"
^DIC(9.4,175,22,2,"PAH",238,1,0)="^^13^13^3241115"
