^DIC(9.4,3,22,21,"PAH",115,1,79,0)="  "
^DIC(9.4,3,22,21,"PAH",115,1,80,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,81,0)=" "
^DIC(9.4,3,22,21,"PAH",115,1,82,0)="Installation Instruction:"
^DIC(9.4,3,22,21,"PAH",115,1,83,0)="========================"
