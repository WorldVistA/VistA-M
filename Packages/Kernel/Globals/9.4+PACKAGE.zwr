^DIC(9.4,227,0)="VISTA PACKAGE SIZING^A1VS^VISTA PACKAGE SIZING UTILITY"
^DIC(9.4,227,20,0)="^9.402P^^"
^DIC(9.4,227,22,0)="^9.49I^1^1"
^DIC(9.4,227,22,1,0)="1.0"
^DIC(9.4,227,22,1,"PAH",1,0)="0^3170209.153211^54"
^DIC(9.4,227,22,1,"PAH",1,1,0)="^^2^2^3170209"
^DIC(9.4,227,22,1,"PAH",1,1,1,0)="This build is the initial installation release of the VistA Package "
^DIC(9.4,227,22,1,"PAH",1,1,2,0)="Sizing Utility."
^DIC(9.4,227,22,1,"PAH","B",0,1)=""
^DIC(9.4,227,22,"B","1.0",1)=""
^DIC(9.4,227,"VERSION")=1
^DIC(9.4,228,0)="REAL TIME LOCATION SYSTEM^VIAA^REAL TIME LOCATION SYSTEM"
^DIC(9.4,228,20,0)="^9.402P^^"
^DIC(9.4,228,22,0)="^9.49I^1^1"
^DIC(9.4,228,22,1,0)="1.0"
^DIC(9.4,228,22,1,"PAH",0)="^9.4901^5^5"
^DIC(9.4,228,22,1,"PAH",1,0)="1^3160907^66475"
^DIC(9.4,228,22,1,"PAH",1,1,0)="^^8^8^3160907"
^DIC(9.4,228,22,1,"PAH",1,1,1,0)="This Real Time Location System (RTLS) patch provides the foundation"
^DIC(9.4,228,22,1,"PAH",1,1,2,0)="for the interface between WaveMark and legacy VistA packages by creating"
^DIC(9.4,228,22,1,"PAH",1,1,3,0)="an application proxy user and a common menu that will contain"
^DIC(9.4,228,22,1,"PAH",1,1,4,0)="future Remote Procedure Calls (RPC) for multiple packages and files in"
^DIC(9.4,228,22,1,"PAH",1,1,5,0)="VistA. The menu option will be assigned as secondary menu to the"
^DIC(9.4,228,22,1,"PAH",1,1,6,0)="application proxy user created. The RPC menu exported by this patch may be"
^DIC(9.4,228,22,1,"PAH",1,1,7,0)="expanded in future patches with other new RPC lists for other VistA "
^DIC(9.4,228,22,1,"PAH",1,1,8,0)="packages."
^DIC(9.4,228,22,1,"PAH",2,0)="1 SEQ #2^3170313.150128^54"
^DIC(9.4,228,22,1,"PAH",2,1,0)="^^8^8^3170313"
^DIC(9.4,228,22,1,"PAH",2,1,1,0)="This Real Time Location System (RTLS) patch provides the foundation"
^DIC(9.4,228,22,1,"PAH",2,1,2,0)="for the interface between WaveMark and legacy VistA packages by creating"
^DIC(9.4,228,22,1,"PAH",2,1,3,0)="an application proxy user and a common menu that will contain"
^DIC(9.4,228,22,1,"PAH",2,1,4,0)="future Remote Procedure Calls (RPC) for multiple packages and files in"
^DIC(9.4,228,22,1,"PAH",2,1,5,0)="VistA. The menu option will be assigned as secondary menu to the"
^DIC(9.4,228,22,1,"PAH",2,1,6,0)="application proxy user created. The RPC menu exported by this patch may be"
^DIC(9.4,228,22,1,"PAH",2,1,7,0)="expanded in future patches with other new RPC lists for other VistA "
^DIC(9.4,228,22,1,"PAH",2,1,8,0)="packages."
^DIC(9.4,228,22,1,"PAH",3,0)="4 SEQ #3^3170313.150502^54"
^DIC(9.4,228,22,1,"PAH",3,1,0)="^^9^9^3170313"
^DIC(9.4,228,22,1,"PAH",3,1,1,0)="This Real Time Location System (RTLS) patch supports the interface "
^DIC(9.4,228,22,1,"PAH",3,1,2,0)="with WaveMark with new functionality for the Catheterization Lab which"
^DIC(9.4,228,22,1,"PAH",3,1,3,0)="involves the following VistA packages:"
^DIC(9.4,228,22,1,"PAH",3,1,4,0)=" "
^DIC(9.4,228,22,1,"PAH",3,1,5,0)="- IFCAP/GIP: obtaining item master updates for WaveMark from IFCAP."
^DIC(9.4,228,22,1,"PAH",3,1,6,0)="Setting par values from WaveMark into GIP, and setting the quantity"
^DIC(9.4,228,22,1,"PAH",3,1,7,0)="on-hand in GIP."
^DIC(9.4,228,22,1,"PAH",3,1,8,0)="- Employee/Patient: retrieving employee (file #200) and patient (file #2)"
^DIC(9.4,228,22,1,"PAH",3,1,9,0)="information for WaveMark."
^DIC(9.4,228,22,1,"PAH",4,0)="3 SEQ #5^3171201.124556^54"
^DIC(9.4,228,22,1,"PAH",4,1,0)="^^16^16^3171201"
^DIC(9.4,228,22,1,"PAH",4,1,1,0)="This build supports the RTLS interface between Intelligent Insites"
^DIC(9.4,228,22,1,"PAH",4,1,2,0)="and the VistA Engineering files #6914 and #6928. A list of remote"
^DIC(9.4,228,22,1,"PAH",4,1,3,0)="procedure calls (RPC) is exported with this patch as part of the"
^DIC(9.4,228,22,1,"PAH",4,1,4,0)="interface. The RPC list will be added to the common VistA option"
^DIC(9.4,228,22,1,"PAH",4,1,5,0)="'VIAA01 RTLS RPC MENU'. At the post-init phase, the patch checks and if"
^DIC(9.4,228,22,1,"PAH",4,1,6,0)="needed completes the set ups for a web server and a web service used to "
^DIC(9.4,228,22,1,"PAH",4,1,7,0)="communicate with RTLS."
^DIC(9.4,228,22,1,"PAH",4,1,8,0)=" "
^DIC(9.4,228,22,1,"PAH",4,1,9,0)="The new file PENDING RTLS EVENTS, #6930, is exported with this patch in "
^DIC(9.4,228,22,1,"PAH",4,1,10,0)="order to hold Engineering changes momentarily while they are sent to "
^DIC(9.4,228,22,1,"PAH",4,1,11,0)="RTLS. Once the changes are transmitted, the file is cleaned up."
^DIC(9.4,228,22,1,"PAH",4,1,12,0)=" "
^DIC(9.4,228,22,1,"PAH",4,1,13,0)="The changes from Engineering files are transmitted to RTLS via the option "
^DIC(9.4,228,22,1,"PAH",4,1,14,0)="VIAA MAKE A WEB CALL TO MULE. This option should be scheduled to run in "
^DIC(9.4,228,22,1,"PAH",4,1,15,0)="TaskMan periodically. See the patch description in Forum for additional "
^DIC(9.4,228,22,1,"PAH",4,1,16,0)="details on how to set it up."
^DIC(9.4,228,22,1,"PAH",5,0)="6 SEQ #6^3180706.143604^54"
^DIC(9.4,228,22,1,"PAH",5,1,0)="^^3^3^3180706"
^DIC(9.4,228,22,1,"PAH",5,1,1,0)="This patch addresses one issue about a syntactically incorrect error "
^DIC(9.4,228,22,1,"PAH",5,1,2,0)="occurring in the interface with the EQUIPMENT INV. FILE #6914 via the"
^DIC(9.4,228,22,1,"PAH",5,1,3,0)="Decision Support System (DSS) GUI AbovePAR (APAR) system."
^DIC(9.4,228,22,1,"PAH","B",1,1)=""
