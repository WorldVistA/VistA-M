^DIC(9.4,82,22,2,"PAH",38,0)="38 SEQ #39^3021025^1"
^DIC(9.4,82,22,2,"PAH",38,1,0)="^^26^26^3021025"
^DIC(9.4,82,22,2,"PAH",38,1,1,0)="!! NOTE: !!  Health care facilities do not have the CMOP NATIONAL "
^DIC(9.4,82,22,2,"PAH",38,1,2,0)="SITE file (#552), the CMOP MASTER DATABASE file (#552.4), nor the CMOP"
^DIC(9.4,82,22,2,"PAH",38,1,3,0)="OPERATIONS file (#554) and the installation will generate an error that"
^DIC(9.4,82,22,2,"PAH",38,1,4,0)="can be ignored for health care facilities."
^DIC(9.4,82,22,2,"PAH",38,1,5,0)=" "
^DIC(9.4,82,22,2,"PAH",38,1,6,0)="The errors reported are:"
^DIC(9.4,82,22,2,"PAH",38,1,7,0)=" "
^DIC(9.4,82,22,2,"PAH",38,1,8,0)="** ERROR IN DATA DICTIONARY FOR FILE # 552 **"
^DIC(9.4,82,22,2,"PAH",38,1,9,0)="Data Dictionary not installed; Partial DD/File does not exist."
^DIC(9.4,82,22,2,"PAH",38,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",38,1,11,0)="** ERROR IN DATA DICTIONARY FOR FILE # 552.4 **"
^DIC(9.4,82,22,2,"PAH",38,1,12,0)="Data Dictionary not installed; Partial DD/File does not exist."
^DIC(9.4,82,22,2,"PAH",38,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",38,1,14,0)="** ERROR IN DATA DICTIONARY FOR FILE # 554 **"
^DIC(9.4,82,22,2,"PAH",38,1,15,0)="Data Dictionary not installed; Partial DD/File does not exist."
^DIC(9.4,82,22,2,"PAH",38,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",38,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",38,1,18,0)="This patch is being distributed to support the Veteran Affairs/Department"
^DIC(9.4,82,22,2,"PAH",38,1,19,0)="of Defense (VA/DoD) Consolidated Mail Outpatient Pharmacy (CMOP) "
^DIC(9.4,82,22,2,"PAH",38,1,20,0)="Interface project.  The modifications contained herein allow VA CMOPs to"
^DIC(9.4,82,22,2,"PAH",38,1,21,0)="exchange prescription orders and fulfillment data with DoD Medical"
^DIC(9.4,82,22,2,"PAH",38,1,22,0)="Treatment Facilities. A new DOD CMOP INTERFACE [PSX DOD CMOP INTERFACE]"
^DIC(9.4,82,22,2,"PAH",38,1,23,0)="option and new key PSXDOD and several new fields are being added "
^DIC(9.4,82,22,2,"PAH",38,1,24,0)="to support the changes needed.  See Appendix C of the CMOP Technical"
^DIC(9.4,82,22,2,"PAH",38,1,25,0)="manual for further information on the data exchange process and the HL7 "
^DIC(9.4,82,22,2,"PAH",38,1,26,0)="segment definitions."
^DIC(9.4,82,22,2,"PAH",39,0)="43 SEQ #40^3021108^1"
^DIC(9.4,82,22,2,"PAH",39,1,0)="^^11^11^3021108"
^DIC(9.4,82,22,2,"PAH",39,1,1,0)="Problem:  The information form that prints from Consolidated Mail "
^DIC(9.4,82,22,2,"PAH",39,1,2,0)="Outpatient Pharmacy (CMOP) may display the copay status incorrectly at"
^DIC(9.4,82,22,2,"PAH",39,1,3,0)="times. (e.g. it may say ""NO COPAY"" but when the fill is released, no"
^DIC(9.4,82,22,2,"PAH",39,1,4,0)="exemptions from copay can be found so the status is changed to copay.)"
^DIC(9.4,82,22,2,"PAH",39,1,5,0)="The copay status is not being determined correctly for each fill of a "
^DIC(9.4,82,22,2,"PAH",39,1,6,0)="CMOP prescription."
^DIC(9.4,82,22,2,"PAH",39,1,7,0)=" "
^DIC(9.4,82,22,2,"PAH",39,1,8,0)="Resolution:  Modified code to determine the current copay status for each "
^DIC(9.4,82,22,2,"PAH",39,1,9,0)="fill which includes the same checking that is done at label print and "
^DIC(9.4,82,22,2,"PAH",39,1,10,0)="prescription release. (Prior to patch PSO*7*71, the copay status was only "
^DIC(9.4,82,22,2,"PAH",39,1,11,0)="re-evaluated for new prescriptions and renewals, not for each refill)."
^DIC(9.4,82,22,2,"PAH",40,0)="44 SEQ #41^3030301^1"
^DIC(9.4,82,22,2,"PAH",40,1,0)="^^4^4^3030301"
^DIC(9.4,82,22,2,"PAH",40,1,1,0)="Problem:  The [PSX START BACKGROUND FILER] Start/Stop Background "
^DIC(9.4,82,22,2,"PAH",40,1,2,0)="Filer option was erroring out."
^DIC(9.4,82,22,2,"PAH",40,1,3,0)=" "
^DIC(9.4,82,22,2,"PAH",40,1,4,0)="Resolution:  Modified code to correct error."
^DIC(9.4,82,22,2,"PAH",41,0)="46 SEQ #42^3031107^1"
^DIC(9.4,82,22,2,"PAH",41,1,0)="^^2^2^3031107"
^DIC(9.4,82,22,2,"PAH",41,1,1,0)="This patch will correct an Archive problem due to the entry of Month/Year"
^DIC(9.4,82,22,2,"PAH",41,1,2,0)="being entered as Month/Day"
^DIC(9.4,82,22,2,"PAH",42,0)="41 SEQ #43^3031107^1"
^DIC(9.4,82,22,2,"PAH",42,1,0)="^^151^151^3031107"
^DIC(9.4,82,22,2,"PAH",42,1,1,0)="NOTE:"
^DIC(9.4,82,22,2,"PAH",42,1,2,0)="Facilities are required to have installed PSO*7*126."
^DIC(9.4,82,22,2,"PAH",42,1,3,0)="There is a partner patch that is being distributed previous to PSX*2*41."
^DIC(9.4,82,22,2,"PAH",42,1,4,0)="The partner patch is Outpatient Pharmacy V. 7.0 PSO*7*126. This will be"
^DIC(9.4,82,22,2,"PAH",42,1,5,0)="tested in the environmental checking phase of the installation and not in"
^DIC(9.4,82,22,2,"PAH",42,1,6,0)="the KIDs required patches section. Consolidated Mail Outpatient Pharmacy"
^DIC(9.4,82,22,2,"PAH",42,1,7,0)="(CMOP) hosts are not required to install PSO*7*126. There is also a"
^DIC(9.4,82,22,2,"PAH",42,1,8,0)="companion ORDER ENTRY / RESULTS REPORTING (OERR) patch OR*3*183 that is"
^DIC(9.4,82,22,2,"PAH",42,1,9,0)="needed to complete the locking and ownership/protection of prescriptions"
^DIC(9.4,82,22,2,"PAH",42,1,10,0)="across the VistA applications."
^DIC(9.4,82,22,2,"PAH",42,1,11,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,12,0)="NOTE:"
^DIC(9.4,82,22,2,"PAH",42,1,13,0)="CMOP hosts will see the expected following error messages as the software"
^DIC(9.4,82,22,2,"PAH",42,1,14,0)="will be installing data fields for the facilities in files that the CMOP"
^DIC(9.4,82,22,2,"PAH",42,1,15,0)="hosts do not have."
^DIC(9.4,82,22,2,"PAH",42,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,17,0)="       Installing Data Dictionaries:"
^DIC(9.4,82,22,2,"PAH",42,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,19,0)="       ** ERROR IN DATA DICTIONARY FOR FILE # 550 **"
^DIC(9.4,82,22,2,"PAH",42,1,20,0)="       Data Dictionary not installed; Partial DD/File does not exist"
^DIC(9.4,82,22,2,"PAH",42,1,21,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,22,0)="       ** ERROR IN DATA DICTIONARY FOR FILE # 550.1 **"
^DIC(9.4,82,22,2,"PAH",42,1,23,0)="       Data Dictionary not installed; Partial DD/File does not exist"
^DIC(9.4,82,22,2,"PAH",42,1,24,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,25,0)="       ** ERROR IN DATA DICTIONARY FOR FILE # 550.2 **"
^DIC(9.4,82,22,2,"PAH",42,1,26,0)="       Data Dictionary not installed; Partial DD/File does not exist"
^DIC(9.4,82,22,2,"PAH",42,1,27,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,28,0)="CMOP hosts may ignore a portion of the installation instructions as they"
^DIC(9.4,82,22,2,"PAH",42,1,29,0)="pertain to functionalities found only at the remote facilities."
^DIC(9.4,82,22,2,"PAH",42,1,30,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,31,0)="NOTE: If you have batches (transmissions) that you are planning to"
^DIC(9.4,82,22,2,"PAH",42,1,32,0)="re-transmit, do so prior to installing PSX*2*41. The Re-transmit CMOP"
^DIC(9.4,82,22,2,"PAH",42,1,33,0)="Data [PSXR RETRANSMIT] option has been re-coded to match the new data"
^DIC(9.4,82,22,2,"PAH",42,1,34,0)="architecture being used in PSX*2*41 and will not be able to resend batches"
^DIC(9.4,82,22,2,"PAH",42,1,35,0)="prior to installation of PSX*2*41."
^DIC(9.4,82,22,2,"PAH",42,1,36,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,37,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,38,0)="1. Problem: Controlled Substance (CS) and Non-Controlled Substance"
^DIC(9.4,82,22,2,"PAH",42,1,39,0)="(NON-CS) prescriptions are being mixed into the same batches when the"
^DIC(9.4,82,22,2,"PAH",42,1,40,0)="recovery process is cleaning up a broken transmission. The original"
^DIC(9.4,82,22,2,"PAH",42,1,41,0)="recovery process was written when there was only one type of prescription"
^DIC(9.4,82,22,2,"PAH",42,1,42,0)="being sent and it includes remnants of the previous transmission in"
^DIC(9.4,82,22,2,"PAH",42,1,43,0)="the current transmission."
^DIC(9.4,82,22,2,"PAH",42,1,44,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,45,0)="Solution: The recovery process has been re-written to reset the"
^DIC(9.4,82,22,2,"PAH",42,1,46,0)="prescriptions to a state as if they were just queued waiting for"
^DIC(9.4,82,22,2,"PAH",42,1,47,0)="transmission."
^DIC(9.4,82,22,2,"PAH",42,1,48,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,49,0)="2. Problem: There have been instances where the prescriptions of two"
^DIC(9.4,82,22,2,"PAH",42,1,50,0)="patients have been merged into the same HL7 order in the CMOP RX QUEUE"
^DIC(9.4,82,22,2,"PAH",42,1,51,0)="file (#550.1)."
^DIC(9.4,82,22,2,"PAH",42,1,52,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,53,0)="Solution: The use of the CMOP RX QUEUE file (#550.1) has been redesigned"
^DIC(9.4,82,22,2,"PAH",42,1,54,0)="to be only used in the building of the HL7 order messages and it is"
^DIC(9.4,82,22,2,"PAH",42,1,55,0)="cleared out prior to and after each transmission. The access to the CMOP"
^DIC(9.4,82,22,2,"PAH",42,1,56,0)="RX QUEUE file (#550.1) is locked by the transmission job when it"
^DIC(9.4,82,22,2,"PAH",42,1,57,0)="first starts up and is released as the last step as the transmission"
^DIC(9.4,82,22,2,"PAH",42,1,58,0)="finishes."
^DIC(9.4,82,22,2,"PAH",42,1,59,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,60,0)="3. Problem: Several sites have reported that they were not able to"
^DIC(9.4,82,22,2,"PAH",42,1,61,0)="re-direct the scheduling of their transmissions to another"
^DIC(9.4,82,22,2,"PAH",42,1,62,0)="Consolidated Mail Outpatient Pharmacy (CMOP). There are several fields"
^DIC(9.4,82,22,2,"PAH",42,1,63,0)="within the scheduling that have a database required criteria set. This"
^DIC(9.4,82,22,2,"PAH",42,1,64,0)="makes it difficult for the software to clear them and reset them."
^DIC(9.4,82,22,2,"PAH",42,1,65,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,66,0)="Solution: The scheduling of transmissions has been redesigned to use the"
^DIC(9.4,82,22,2,"PAH",42,1,67,0)="Kernel Option Scheduling and its utilities. This streamlines the user"
^DIC(9.4,82,22,2,"PAH",42,1,68,0)="input and control of the scheduling of the transmissions. Transmissions"
^DIC(9.4,82,22,2,"PAH",42,1,69,0)="must now be scheduled no closer than two hours apart."
^DIC(9.4,82,22,2,"PAH",42,1,70,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,71,0)="4. Problem: The beginning message number within a transmission sometimes"
^DIC(9.4,82,22,2,"PAH",42,1,72,0)="differs from the notation within the message."
^DIC(9.4,82,22,2,"PAH",42,1,73,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,74,0)="Solution: The use of the CMOP RX QUEUE file (#550.1) has been redesigned."
^DIC(9.4,82,22,2,"PAH",42,1,75,0)="It is now cleared out prior to each transmission and each transmission"
^DIC(9.4,82,22,2,"PAH",42,1,76,0)="now starts with the number one."
^DIC(9.4,82,22,2,"PAH",42,1,77,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,78,0)="5. Enhancement: Other Language - Data elements in the HL7 messages are"
^DIC(9.4,82,22,2,"PAH",42,1,79,0)="being activated that will enable the SIG and PMI sheets to be printed in"
^DIC(9.4,82,22,2,"PAH",42,1,80,0)="another language. This is in co-ordination with the emerging Outpatient"
^DIC(9.4,82,22,2,"PAH",42,1,81,0)="Pharmacy V. 7.0 'Other Language' patch PSO*7*117."
^DIC(9.4,82,22,2,"PAH",42,1,82,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,83,0)="6. Problem: It is possible to create duplicate active prescriptions"
^DIC(9.4,82,22,2,"PAH",42,1,84,0)="through the renewal and copy prescription functions if the prescription"
^DIC(9.4,82,22,2,"PAH",42,1,85,0)="is a part of a currently running CMOP transmission."
^DIC(9.4,82,22,2,"PAH",42,1,86,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,87,0)="Solution: The transmission software has been modified so that the"
^DIC(9.4,82,22,2,"PAH",42,1,88,0)="setting of prescription status flags occurs in a manner that will keep"
^DIC(9.4,82,22,2,"PAH",42,1,89,0)="the renewal and copy functions from accessing prescriptions that are"
^DIC(9.4,82,22,2,"PAH",42,1,90,0)="being loaded into a CMOP transmission. A prescription may be locked by a"
^DIC(9.4,82,22,2,"PAH",42,1,91,0)="user and if so that prescription is skipped and a ""RX OERR/CPRS Locked"""
^DIC(9.4,82,22,2,"PAH",42,1,92,0)="error is itemized with other correctable prescription errors and sent to"
^DIC(9.4,82,22,2,"PAH",42,1,93,0)="the holders of the ""PSXMAIL"" key."
^DIC(9.4,82,22,2,"PAH",42,1,94,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,95,0)="7. Problem: A prescription that has been sent to CMOP, not filled, and"
^DIC(9.4,82,22,2,"PAH",42,1,96,0)="then is canceled locally is selectable for resubmission to the CMOP and"
^DIC(9.4,82,22,2,"PAH",42,1,97,0)="generates a program error when being processed."
^DIC(9.4,82,22,2,"PAH",42,1,98,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,99,0)="Solution: The software has been amended to not allow the resubmission of"
^DIC(9.4,82,22,2,"PAH",42,1,100,0)="prescriptions when that particular fill for resubmission has been"
^DIC(9.4,82,22,2,"PAH",42,1,101,0)="canceled."
^DIC(9.4,82,22,2,"PAH",42,1,102,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,103,0)="8. E3R 18029 It is possible for the remote sites to input more "
^DIC(9.4,82,22,2,"PAH",42,1,104,0)="information into the NARRATIVE REFILLABLE RX (#1004), NARRATIVE"
^DIC(9.4,82,22,2,"PAH",42,1,105,0)="NON-REFILLABLE RX (#1005), and NARRATIVE FOR COPAY DOCUMENT (#1006) text"
^DIC(9.4,82,22,2,"PAH",42,1,106,0)="fields in the Outpatient Site file (#59), than can be printed at the"
^DIC(9.4,82,22,2,"PAH",42,1,107,0)="CMOPs."
^DIC(9.4,82,22,2,"PAH",42,1,108,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,109,0)="Solution: The transmission process will now load only up to seven lines"
^DIC(9.4,82,22,2,"PAH",42,1,110,0)="(80 characters per line) of information from each of these fields. The"
^DIC(9.4,82,22,2,"PAH",42,1,111,0)="following warning message is also sent to the facility CMOP users when a"
^DIC(9.4,82,22,2,"PAH",42,1,112,0)="transmission has had to limit the number of lines being sent to the CMOP."
^DIC(9.4,82,22,2,"PAH",42,1,113,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,114,0)="Subj: >>WARNING<< CMOP Outpatient Site narrative Instructions [#140709]"
^DIC(9.4,82,22,2,"PAH",42,1,115,0)="05/16/03@15:21  8 lines"
^DIC(9.4,82,22,2,"PAH",42,1,116,0)="From: Smith,John  In 'IN' basket.   Page 1"
^DIC(9.4,82,22,2,"PAH",42,1,117,0)="--------------------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",42,1,118,0)="The following Outpatient Site file (#59) narrative field(s) exceed seven "
^DIC(9.4,82,22,2,"PAH",42,1,119,0)="lines."
^DIC(9.4,82,22,2,"PAH",42,1,120,0)="This exceeds CMOP limits."
^DIC(9.4,82,22,2,"PAH",42,1,121,0)="Lines beyond seven are not being sent to the CMOP."
^DIC(9.4,82,22,2,"PAH",42,1,122,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,123,0)="Outpatient Site: TROY"
^DIC(9.4,82,22,2,"PAH",42,1,124,0)="NARRATIVE REFILLABLE RX     36 lines"
^DIC(9.4,82,22,2,"PAH",42,1,125,0)="NARRATIVE NON REFILLABLE RX     49 lines"
^DIC(9.4,82,22,2,"PAH",42,1,126,0)="NARRATIVE FOR COPAY DOCUMENT     16 lines"
^DIC(9.4,82,22,2,"PAH",42,1,127,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,128,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,129,0)="9. Problem: It has been found that during the building of a transmission"
^DIC(9.4,82,22,2,"PAH",42,1,130,0)="other VistA applications are able to perform edits, refills, copies, and"
^DIC(9.4,82,22,2,"PAH",42,1,131,0)="deletions of prescriptions that are being loaded into the CMOP"
^DIC(9.4,82,22,2,"PAH",42,1,132,0)="transmission."
^DIC(9.4,82,22,2,"PAH",42,1,133,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,134,0)="Solution: The use of a new integration agreement with Order Entry /"
^DIC(9.4,82,22,2,"PAH",42,1,135,0)="Results Reporting (OE/RR) version 3 provides a way to let CMOP identify "
^DIC(9.4,82,22,2,"PAH",42,1,136,0)="the prescriptions that are being transmitted so that they will not be"
^DIC(9.4,82,22,2,"PAH",42,1,137,0)="processed by other VistA applications. A related OE/RR patch OR*3*183 has"
^DIC(9.4,82,22,2,"PAH",42,1,138,0)="been released that will complete the ability for CMOP to identify the"
^DIC(9.4,82,22,2,"PAH",42,1,139,0)="prescriptions."
^DIC(9.4,82,22,2,"PAH",42,1,140,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,141,0)="10. Problem: Prescriptions have been processed to the CMOPs when they "
^DIC(9.4,82,22,2,"PAH",42,1,142,0)="should have dropped out of CMOP processing because of the patient's "
^DIC(9.4,82,22,2,"PAH",42,1,143,0)="mailing status."
^DIC(9.4,82,22,2,"PAH",42,1,144,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,145,0)="Solution: The code has been changed so that the prescriptions are dropped "
^DIC(9.4,82,22,2,"PAH",42,1,146,0)="out of CMOP suspense for patients who have an incompatable mailing status "
^DIC(9.4,82,22,2,"PAH",42,1,147,0)="for CMOP processing."
^DIC(9.4,82,22,2,"PAH",42,1,148,0)=" "
^DIC(9.4,82,22,2,"PAH",42,1,149,0)="NOTE: There have been several fields added to the CMOP SYSTEM file (#550)"
^DIC(9.4,82,22,2,"PAH",42,1,150,0)="and the CMOP TRANSMISSION file (#550.2) to support the changes listed"
^DIC(9.4,82,22,2,"PAH",42,1,151,0)="for this patch."
^DIC(9.4,82,22,2,"PAH",43,0)="49 SEQ #44^3031231^1"
^DIC(9.4,82,22,2,"PAH",43,1,0)="^^5^5^3031231"
^DIC(9.4,82,22,2,"PAH",43,1,1,0)="Problem: Patch PSX*2*41 is sending NTE|5 segments that it shouldn't. This"
^DIC(9.4,82,22,2,"PAH",43,1,2,0)="problem was not uncovered at the testing sites."
^DIC(9.4,82,22,2,"PAH",43,1,3,0)=" "
^DIC(9.4,82,22,2,"PAH",43,1,4,0)="Resolution: The code has been modified to correct the array carrying the"
^DIC(9.4,82,22,2,"PAH",43,1,5,0)="list of NTE|5 segments."
^DIC(9.4,82,22,2,"PAH",44,0)="52 SEQ #45^3040521^1"
^DIC(9.4,82,22,2,"PAH",44,1,0)="^^4^4^3040521"
^DIC(9.4,82,22,2,"PAH",44,1,1,0)="Remove mail message when there is a mail status change and the RX is "
^DIC(9.4,82,22,2,"PAH",44,1,2,0)="suspended locally."
^DIC(9.4,82,22,2,"PAH",44,1,3,0)="When there is a test patient (ssn=000-00) put ""Test Patient"" under the "
^DIC(9.4,82,22,2,"PAH",44,1,4,0)="Data Field heading of the mail message instead of ""Patient Address""."
^DIC(9.4,82,22,2,"PAH",45,0)="50 SEQ #46^3040521^1"
^DIC(9.4,82,22,2,"PAH",45,1,0)="^^87^87^3040521"
^DIC(9.4,82,22,2,"PAH",45,1,1,0)="The Chief Business Office (CBO) is requesting modifications to several"
^DIC(9.4,82,22,2,"PAH",45,1,2,0)="Veterans Health Information Systems and Technology Architecture (VistA)"
^DIC(9.4,82,22,2,"PAH",45,1,3,0)="packages to support implementation of VHA Directive 2002-049 - ""Combat"
^DIC(9.4,82,22,2,"PAH",45,1,4,0)="Veterans Are Eligible For Medical Services For 2-Years After Separation"
^DIC(9.4,82,22,2,"PAH",45,1,5,0)="From Military Service Notwithstanding Lack Of Evidence For Service"
^DIC(9.4,82,22,2,"PAH",45,1,6,0)="Connection"", which iterates VA's policy to provide medical care and other"
^DIC(9.4,82,22,2,"PAH",45,1,7,0)="medical services to combat veterans despite the absence of proof of"
^DIC(9.4,82,22,2,"PAH",45,1,8,0)="service connection."
^DIC(9.4,82,22,2,"PAH",45,1,9,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,10,0)="Software to support the Combat Veteran (CV) initiative is being developed"
^DIC(9.4,82,22,2,"PAH",45,1,11,0)="and introduced in a phased implementation strategy. The reason for this"
^DIC(9.4,82,22,2,"PAH",45,1,12,0)="type of deployment is due to the complexity of the functionality and the"
^DIC(9.4,82,22,2,"PAH",45,1,13,0)="number of product line dependencies. Phase I: Combat Veteran Interim"
^DIC(9.4,82,22,2,"PAH",45,1,14,0)="Solution (CVIS) was a VistA only solution that involved development in"
^DIC(9.4,82,22,2,"PAH",45,1,15,0)="the Integrated Billing (IB) and Registration/Enrollment product lines."
^DIC(9.4,82,22,2,"PAH",45,1,16,0)="It provided the logic to identify those veterans who met the criteria for"
^DIC(9.4,82,22,2,"PAH",45,1,17,0)="the combat veteran eligibility and provided billing reports"
^DIC(9.4,82,22,2,"PAH",45,1,18,0)="cross-referenced against this identifier to aid in the copayment billing"
^DIC(9.4,82,22,2,"PAH",45,1,19,0)="process. Phase II of this initiative will involve multiple product lines"
^DIC(9.4,82,22,2,"PAH",45,1,20,0)="and additional VistA only development. The main goals of Phase II will be"
^DIC(9.4,82,22,2,"PAH",45,1,21,0)="to fully automate the copayment billing processing of combat vets based on"
^DIC(9.4,82,22,2,"PAH",45,1,22,0)="episode of care by providing the appropriate questions at check-out as"
^DIC(9.4,82,22,2,"PAH",45,1,23,0)="supplied by CPRS."
^DIC(9.4,82,22,2,"PAH",45,1,24,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,25,0)="Product lines that have a stake in Phase II development include"
^DIC(9.4,82,22,2,"PAH",45,1,26,0)="Enrollment/Registration (VistA), IB, Outpatient Pharmacy, Consolidated"
^DIC(9.4,82,22,2,"PAH",45,1,27,0)="Mail Outpatient Pharmacy (CMOP), CPRS/TIU, Patient Care Encounter (PCE),"
^DIC(9.4,82,22,2,"PAH",45,1,28,0)="Ambulatory Care, Event Capture, Scheduling and PTF. The National Patient"
^DIC(9.4,82,22,2,"PAH",45,1,29,0)="Care Database (NPCD) will also require modifications to capture workload"
^DIC(9.4,82,22,2,"PAH",45,1,30,0)="reporting. The patches are listed below in the order that they must be"
^DIC(9.4,82,22,2,"PAH",45,1,31,0)="installed:"
^DIC(9.4,82,22,2,"PAH",45,1,32,0)="Outpatient Pharmacy"
^DIC(9.4,82,22,2,"PAH",45,1,33,0)="    PSO*7*157"
^DIC(9.4,82,22,2,"PAH",45,1,34,0)="    PSX*2*50"
^DIC(9.4,82,22,2,"PAH",45,1,35,0)="PCE/PTF/Event Capture/Scheduling  - PIMS Host file"
^DIC(9.4,82,22,2,"PAH",45,1,36,0)="    PX*1.0*130"
^DIC(9.4,82,22,2,"PAH",45,1,37,0)="    SD*5.3*325"
^DIC(9.4,82,22,2,"PAH",45,1,38,0)="    DG*5.3*565"
^DIC(9.4,82,22,2,"PAH",45,1,39,0)="    EC*2.0*54"
^DIC(9.4,82,22,2,"PAH",45,1,40,0)="Integrated Billing"
^DIC(9.4,82,22,2,"PAH",45,1,41,0)="    IB*2.0*247"
^DIC(9.4,82,22,2,"PAH",45,1,42,0)="CPRS"
^DIC(9.4,82,22,2,"PAH",45,1,43,0)="    OR*3.0*190"
^DIC(9.4,82,22,2,"PAH",45,1,44,0)="Product Features"
^DIC(9.4,82,22,2,"PAH",45,1,45,0)="There are three main areas addressed by this enhancement:"
^DIC(9.4,82,22,2,"PAH",45,1,46,0)="a. Identification/Notification of a CV Status veteran seeking medical care"
^DIC(9.4,82,22,2,"PAH",45,1,47,0)="   - The clinical applications shall obtain the CV Status for those"
^DIC(9.4,82,22,2,"PAH",45,1,48,0)="     veterans who qualify as such per the directive."
^DIC(9.4,82,22,2,"PAH",45,1,49,0)="   - The CV Status identification shall be displayed to the appropriate"
^DIC(9.4,82,22,2,"PAH",45,1,50,0)="     audience (pharmacist, clinician providing care, intake personnel,"
^DIC(9.4,82,22,2,"PAH",45,1,51,0)="     schedulers, etc.)."
^DIC(9.4,82,22,2,"PAH",45,1,52,0)="   - Provider shall be able to identify whether care provided CV veteran"
^DIC(9.4,82,22,2,"PAH",45,1,53,0)="     was for a condition potentially related to combat service in the same"
^DIC(9.4,82,22,2,"PAH",45,1,54,0)="     manner as identification of exposure related care; care for SC"
^DIC(9.4,82,22,2,"PAH",45,1,55,0)="     conditions, etc."
^DIC(9.4,82,22,2,"PAH",45,1,56,0)="b. Assistance in the communication of a treatment being determined as"
^DIC(9.4,82,22,2,"PAH",45,1,57,0)="   Combat Related"
^DIC(9.4,82,22,2,"PAH",45,1,58,0)="   - Provide a means for the billing and pharmacy software package to"
^DIC(9.4,82,22,2,"PAH",45,1,59,0)="     identify these patients and services provided care for a combat"
^DIC(9.4,82,22,2,"PAH",45,1,60,0)="     related condition."
^DIC(9.4,82,22,2,"PAH",45,1,61,0)="c. Automatically precludes inpatient and outpatient medical care,"
^DIC(9.4,82,22,2,"PAH",45,1,62,0)="   prescription and Long-term care copayments for CV Status veterans whose"
^DIC(9.4,82,22,2,"PAH",45,1,63,0)="   treatment/service has been deemed combat related."
^DIC(9.4,82,22,2,"PAH",45,1,64,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,65,0)="This is the Consolidated Mail Outpatient Pharmacy (CMOP) patch PSX*2*50,"
^DIC(9.4,82,22,2,"PAH",45,1,66,0)="that provides the functionality changes to accommodate the new copay"
^DIC(9.4,82,22,2,"PAH",45,1,67,0)="classification called ""Combat Veteran""."
^DIC(9.4,82,22,2,"PAH",45,1,68,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,69,0)="As part of the Combat Veteran II project, Outpatient Pharmacy V. 7.0 patch"
^DIC(9.4,82,22,2,"PAH",45,1,70,0)="PSO*7*157, introduced the COMBAT VETERAN field (#122) to the PRESCRIPTION"
^DIC(9.4,82,22,2,"PAH",45,1,71,0)="file (#52). This new COMBAT VETERAN field (#122) of the PRESCRIPTION file"
^DIC(9.4,82,22,2,"PAH",45,1,72,0)="(#52) stores the data related to the copay exemption question, ""Is this"
^DIC(9.4,82,22,2,"PAH",45,1,73,0)="Rx potentially for treatment related to Combat?""."
^DIC(9.4,82,22,2,"PAH",45,1,74,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,75,0)="During CMOP transmission of prescriptions, if a prescription is deemed"
^DIC(9.4,82,22,2,"PAH",45,1,76,0)="""Billable"", the software does a check on the following copay exemption"
^DIC(9.4,82,22,2,"PAH",45,1,77,0)="fields of the PRESCRIPTION file (#52):"
^DIC(9.4,82,22,2,"PAH",45,1,78,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,79,0)="117          MILITARY SEXUAL TRAUMA"
^DIC(9.4,82,22,2,"PAH",45,1,80,0)="118          AGENT ORANGE EXPOSURE"
^DIC(9.4,82,22,2,"PAH",45,1,81,0)="119          IONIZING RADIATION EXPOSURE"
^DIC(9.4,82,22,2,"PAH",45,1,82,0)="120          ENVIRONMENTAL CONTAMINANT"
^DIC(9.4,82,22,2,"PAH",45,1,83,0)="121          HEAD AND/OR NECK CANCER"
^DIC(9.4,82,22,2,"PAH",45,1,84,0)="122          COMBAT VETERAN"
^DIC(9.4,82,22,2,"PAH",45,1,85,0)=" "
^DIC(9.4,82,22,2,"PAH",45,1,86,0)="If the prescription is identified as copay exempt, the software will"
^DIC(9.4,82,22,2,"PAH",45,1,87,0)="transmit ""Not Billable"" to CMOP."
^DIC(9.4,82,22,2,"PAH",46,0)="47 SEQ #47^3040802^1"
^DIC(9.4,82,22,2,"PAH",46,1,0)="^^2^2^3040802"
^DIC(9.4,82,22,2,"PAH",46,1,1,0)="This patch will display the the Date Shipped in PSX RX INQUIRY in an "
^DIC(9.4,82,22,2,"PAH",46,1,2,0)="external format."
^DIC(9.4,82,22,2,"PAH",47,0)="45 SEQ #48^3040802^1"
^DIC(9.4,82,22,2,"PAH",47,1,0)="^^80^80^3040802"
^DIC(9.4,82,22,2,"PAH",47,1,1,0)="NOTE: This patch addresses the Centralized Mail Outpatient Pharmacy / "
^DIC(9.4,82,22,2,"PAH",47,1,2,0)="Department of Defense (CMOP/DoD) functionalities. Facilities will see no "
^DIC(9.4,82,22,2,"PAH",47,1,3,0)="impact on their systems."
^DIC(9.4,82,22,2,"PAH",47,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,5,0)="!! NOTE: !!  For health care facilities that do not have the CMOP MASTER "
^DIC(9.4,82,22,2,"PAH",47,1,6,0)="DATABASE file (#552.4), this installation will generate the following "
^DIC(9.4,82,22,2,"PAH",47,1,7,0)="error that can be ignored."
^DIC(9.4,82,22,2,"PAH",47,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,9,0)="** ERROR IN DATA DICTIONARY FOR FILE # 552.4 **"
^DIC(9.4,82,22,2,"PAH",47,1,10,0)="Data Dictionary not installed; Partial DD/File does not exist."
^DIC(9.4,82,22,2,"PAH",47,1,11,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,12,0)="1)  Problem: Internet ftp processes are sometimes interrupted or "
^DIC(9.4,82,22,2,"PAH",47,1,13,0)="terminated in the middle of transmission leaving partial files deposited "
^DIC(9.4,82,22,2,"PAH",47,1,14,0)="on the target system. These are not the full files and if processed will "
^DIC(9.4,82,22,2,"PAH",47,1,15,0)="result in  incomplete data sets."
^DIC(9.4,82,22,2,"PAH",47,1,16,0)="   "
^DIC(9.4,82,22,2,"PAH",47,1,17,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",47,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,19,0)="Code has been put in place to test the integrity of the received patient "
^DIC(9.4,82,22,2,"PAH",47,1,20,0)="data files and the sequencing of segments within the files. Files failing "
^DIC(9.4,82,22,2,"PAH",47,1,21,0)="the tests are not processed."
^DIC(9.4,82,22,2,"PAH",47,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,23,0)="2)      Problem: Criteria of checking the integrity of the patient orders "
^DIC(9.4,82,22,2,"PAH",47,1,24,0)="was coded in the original 2.3.1 HL7 transmissions but was dropped when "
^DIC(9.4,82,22,2,"PAH",47,1,25,0)="Vitria Businessware started performing the conversions to HL7 2.1."
^DIC(9.4,82,22,2,"PAH",47,1,26,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,27,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",47,1,28,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,29,0)="Code has been put in place to perform the integrity checking of the "
^DIC(9.4,82,22,2,"PAH",47,1,30,0)="patient orders in the current HL7 2.1 format as received from Vitria "
^DIC(9.4,82,22,2,"PAH",47,1,31,0)="Businessware."
^DIC(9.4,82,22,2,"PAH",47,1,32,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,33,0)="3)      Problem: The VA internal wan between Leavenworth and Charleston "
^DIC(9.4,82,22,2,"PAH",47,1,34,0)="would drop causing the files to be lost that were to be delivered to the "
^DIC(9.4,82,22,2,"PAH",47,1,35,0)="DoD ""Outbox"" for their pickup."
^DIC(9.4,82,22,2,"PAH",47,1,36,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,37,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",47,1,38,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,39,0)="Code has been put in place that tests the success of the placement of the "
^DIC(9.4,82,22,2,"PAH",47,1,40,0)="files and if they were not placed they are stored for later placement "
^DIC(9.4,82,22,2,"PAH",47,1,41,0)="when the wide area network is back in proper operation."
^DIC(9.4,82,22,2,"PAH",47,1,42,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,43,0)="4)      Problem: The naming of the DoD files contains a Julian date with "
^DIC(9.4,82,22,2,"PAH",47,1,44,0)="a four digit time. There have been occasions when the time had no "
^DIC(9.4,82,22,2,"PAH",47,1,45,0)="seconds, or multiples of 10 seconds. The trailing zeros representing "
^DIC(9.4,82,22,2,"PAH",47,1,46,0)="seconds were being dropped."
^DIC(9.4,82,22,2,"PAH",47,1,47,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,48,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",47,1,49,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,50,0)="The code has been modified to insure trailing zeros are included."
^DIC(9.4,82,22,2,"PAH",47,1,51,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,52,0)="5)      Problem: The resending of release data to the sites generates an "
^DIC(9.4,82,22,2,"PAH",47,1,53,0)="undefined error."
^DIC(9.4,82,22,2,"PAH",47,1,54,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,55,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",47,1,56,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,57,0)="A variable named AGNCH was corrected to be AGNCY."
^DIC(9.4,82,22,2,"PAH",47,1,58,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,59,0)="6)      Problem: The date transmitted element in DoD $XMIT segments is in"
^DIC(9.4,82,22,2,"PAH",47,1,60,0)="HL7 format while transmissions from VA facilities is in a FileMan "
^DIC(9.4,82,22,2,"PAH",47,1,61,0)="(FM)format. This causes bad date data in the CMOP host files."
^DIC(9.4,82,22,2,"PAH",47,1,62,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,63,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",47,1,64,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,65,0)="The DoD VistA import software has been modified to convert the HL7 format "
^DIC(9.4,82,22,2,"PAH",47,1,66,0)="to FM format before handing the files to the CMOP host software."
^DIC(9.4,82,22,2,"PAH",47,1,67,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,68,0)="7)      Problem: Patch PSX*2*38 introduced an 'E' index on the RX INDEX "
^DIC(9.4,82,22,2,"PAH",47,1,69,0)="field (#40) of the RX NUMBER multiple field (#1) in the CMOP MASTER "
^DIC(9.4,82,22,2,"PAH",47,1,70,0)="DATABASE file (#552.4). The presence of this new index caused confusion "
^DIC(9.4,82,22,2,"PAH",47,1,71,0)="for FileMan and it would do lookups first in the 'E' index instead of the "
^DIC(9.4,82,22,2,"PAH",47,1,72,0)="'B' index of the RX NUMBER multiple. This would present the user entries "
^DIC(9.4,82,22,2,"PAH",47,1,73,0)="other than what they were looking for."
^DIC(9.4,82,22,2,"PAH",47,1,74,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,75,0)="Resolution: The 'E' index is to be removed from the file."
^DIC(9.4,82,22,2,"PAH",47,1,76,0)=" "
^DIC(9.4,82,22,2,"PAH",47,1,77,0)="NOTE: If a CMOP has modified the RX INDEX field (#40) locally they will "
^DIC(9.4,82,22,2,"PAH",47,1,78,0)="need to be able to re-do their modifications after the installation. This "
^DIC(9.4,82,22,2,"PAH",47,1,79,0)="installation will remove the field entirely and then put it back with the "
^DIC(9.4,82,22,2,"PAH",47,1,80,0)="official distribution definition without an 'E' index."
^DIC(9.4,82,22,2,"PAH",48,0)="51 SEQ #49^3050311^1"
^DIC(9.4,82,22,2,"PAH",48,1,0)="^^19^19^3050311"
^DIC(9.4,82,22,2,"PAH",48,1,1,0)="1)      Problem: The retransmission of a batch failed to complete the "
^DIC(9.4,82,22,2,"PAH",48,1,2,0)="updating of prescription statuses in Prescription file #52 and RX "
^DIC(9.4,82,22,2,"PAH",48,1,3,0)="Suspense file #52.5"
^DIC(9.4,82,22,2,"PAH",48,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",48,1,5,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",48,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",48,1,7,0)="Code has been put in place to complete the updating of prescriptions "
^DIC(9.4,82,22,2,"PAH",48,1,8,0)="statuses in Prescription file #52 and RX Suspense file #52.5 for "
^DIC(9.4,82,22,2,"PAH",48,1,9,0)="retransmissions."
^DIC(9.4,82,22,2,"PAH",48,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",48,1,11,0)="2)      Problem: The controlling data is stored in ^XTMP and is subject "
^DIC(9.4,82,22,2,"PAH",48,1,12,0)="to a periodic KERNEL job that clears out the ^XTMP global after midnight "
^DIC(9.4,82,22,2,"PAH",48,1,13,0)="if the job extends beyond midnight. That has occurred and the job shut "
^DIC(9.4,82,22,2,"PAH",48,1,14,0)="down."
^DIC(9.4,82,22,2,"PAH",48,1,15,0)=" "
^DIC(9.4,82,22,2,"PAH",48,1,16,0)="Resolution:"
^DIC(9.4,82,22,2,"PAH",48,1,17,0)=" "
^DIC(9.4,82,22,2,"PAH",48,1,18,0)="The parameter in the ^XTMP setting has been set to protect the global for "
^DIC(9.4,82,22,2,"PAH",48,1,19,0)="two days."
^DIC(9.4,82,22,2,"PAH",49,0)="57 SEQ #50^3050525^1"
^DIC(9.4,82,22,2,"PAH",49,1,0)="^^3^3^3050525"
^DIC(9.4,82,22,2,"PAH",49,1,1,0)="Missing CMOP multiples."
^DIC(9.4,82,22,2,"PAH",49,1,2,0)=" "
^DIC(9.4,82,22,2,"PAH",49,1,3,0)="Error when site street address is not completed."
^DIC(9.4,82,22,2,"PAH",50,0)="48 SEQ #51^3060525^1"
^DIC(9.4,82,22,2,"PAH",50,1,0)="^^103^103^3060525"
^DIC(9.4,82,22,2,"PAH",50,1,1,0)="This project involves six different applications that have been significantly"
^DIC(9.4,82,22,2,"PAH",50,1,2,0)="changed to enable VA Medical Centers to perform third party electronic billing"
^DIC(9.4,82,22,2,"PAH",50,1,3,0)="for prescriptions. "
^DIC(9.4,82,22,2,"PAH",50,1,4,0)=" "
^DIC(9.4,82,22,2,"PAH",50,1,5,0)="Below is a list of all the applications involved in this project along with"
^DIC(9.4,82,22,2,"PAH",50,1,6,0)="their patch number:"
^DIC(9.4,82,22,2,"PAH",50,1,7,0)="  "
^DIC(9.4,82,22,2,"PAH",50,1,8,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,82,22,2,"PAH",50,1,9,0)="   -----------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",50,1,10,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*148"
^DIC(9.4,82,22,2,"PAH",50,1,11,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*276"
^DIC(9.4,82,22,2,"PAH",50,1,12,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*90"
^DIC(9.4,82,22,2,"PAH",50,1,13,0)="   CONSOLIDATED MAIL OUTPATIENT PHARMACY (CMOP) V. 2.0  PSX*2*48"
^DIC(9.4,82,22,2,"PAH",50,1,14,0)="   ACCOUNTS RECEIVABLE (AR) V. 4.5                      PRCA*4.5*230"
^DIC(9.4,82,22,2,"PAH",50,1,15,0)="   ELECTRONIC CLAIMS MANAGEMENT ENGINE (ECME) V. 1.0    BPS*1*1"
^DIC(9.4,82,22,2,"PAH",50,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",50,1,17,0)="Veterans Health Information Systems and Technology Architecture (VistA) "
^DIC(9.4,82,22,2,"PAH",50,1,18,0)="software applications and infrastructure were enhanced, in order to allow the"
^DIC(9.4,82,22,2,"PAH",50,1,19,0)="electronic transmission of outpatient pharmacy prescription claims (WINDOW and"
^DIC(9.4,82,22,2,"PAH",50,1,20,0)="MAIL fills) to third party payers via the network connections available"
^DIC(9.4,82,22,2,"PAH",50,1,21,0)="through the Austin Automation Center (AAC). VistA will be enhanced to receive"
^DIC(9.4,82,22,2,"PAH",50,1,22,0)="electronic adjudicated responses from the third party payers, which include"
^DIC(9.4,82,22,2,"PAH",50,1,23,0)="real-time processing for Drug Review Utilization and Refill Too Soon rejects."
^DIC(9.4,82,22,2,"PAH",50,1,24,0)="Reject information will be displayed to the pharmacist as the prescription is"
^DIC(9.4,82,22,2,"PAH",50,1,25,0)="being processed. The pharmacist will have the capability to take the"
^DIC(9.4,82,22,2,"PAH",50,1,26,0)="appropriate action to ensure patient safety or to override the reject and"
^DIC(9.4,82,22,2,"PAH",50,1,27,0)="resubmit the claim to the payer for payment. When a status of ""PAYABLE"" is"
^DIC(9.4,82,22,2,"PAH",50,1,28,0)="returned by the payer for a released prescription, VistA will automatically "
^DIC(9.4,82,22,2,"PAH",50,1,29,0)="create the bill in IB, authorize it and immediately create the receivable in"
^DIC(9.4,82,22,2,"PAH",50,1,30,0)="the AR application. Since the exact amount being paid by the payer is known,"
^DIC(9.4,82,22,2,"PAH",50,1,31,0)="a decrease adjustment will be automatically generated and applied so that the"
^DIC(9.4,82,22,2,"PAH",50,1,32,0)="receivable is equal to the net amount due from the payer."
^DIC(9.4,82,22,2,"PAH",50,1,33,0)=" "
^DIC(9.4,82,22,2,"PAH",50,1,34,0)="The system also provides electronic payment matching capability (for"
^DIC(9.4,82,22,2,"PAH",50,1,35,0)="electronically billable outpatient pharmacy prescriptions) using the existing"
^DIC(9.4,82,22,2,"PAH",50,1,36,0)="Electronic Data Interchange (EDI) Lockbox functionality which processes other"
^DIC(9.4,82,22,2,"PAH",50,1,37,0)="electronic payments from third party payers. This real-time electronic claims"
^DIC(9.4,82,22,2,"PAH",50,1,38,0)="processing capability will be provided in accordance with the Healthcare"
^DIC(9.4,82,22,2,"PAH",50,1,39,0)="Insurance Portability and Accountability Act (HIPAA), EDI transactions and "
^DIC(9.4,82,22,2,"PAH",50,1,40,0)="the National Council for Prescription Drug Programs (NCPDP) mandated format "
^DIC(9.4,82,22,2,"PAH",50,1,41,0)="standards, specifically NCPDP Telecommunication Standard V. 5.1. Additional "
^DIC(9.4,82,22,2,"PAH",50,1,42,0)="functionality delivered with this project includes: "
^DIC(9.4,82,22,2,"PAH",50,1,43,0)=" "
^DIC(9.4,82,22,2,"PAH",50,1,44,0)="   . Auto-Release/Outpatient Pharmacy Automation Interface (OPAI) Integration."
^DIC(9.4,82,22,2,"PAH",50,1,45,0)="   . Back-billing capability to allow electronic billing of claims from within "
^DIC(9.4,82,22,2,"PAH",50,1,46,0)="     the IB application."
^DIC(9.4,82,22,2,"PAH",50,1,47,0)="   . Capability to MOVE a group of subscribers from one insurance plan to "
^DIC(9.4,82,22,2,"PAH",50,1,48,0)="     another while automatically ""expiring"" the old plan, which is a major"
^DIC(9.4,82,22,2,"PAH",50,1,49,0)="     time saver."
^DIC(9.4,82,22,2,"PAH",50,1,50,0)="   . Pharmacy Dispensed As Written (DAW) prescription processing."
^DIC(9.4,82,22,2,"PAH",50,1,51,0)="  "
^DIC(9.4,82,22,2,"PAH",50,1,52,0)="Overview of the Process:"
^DIC(9.4,82,22,2,"PAH",50,1,53,0)="  "
^DIC(9.4,82,22,2,"PAH",50,1,54,0)="When a prescription is about to be filled and dispensed by the pharmacy, the "
^DIC(9.4,82,22,2,"PAH",50,1,55,0)="OP application submits the prescription to the new ECME application. ECME then"
^DIC(9.4,82,22,2,"PAH",50,1,56,0)="contacts IB to verify whether or not the prescription is electronically"
^DIC(9.4,82,22,2,"PAH",50,1,57,0)="billable. If so, ECME gathers the information necessary to generate a NCPDP"
^DIC(9.4,82,22,2,"PAH",50,1,58,0)="claim. The claim information is passed to the VistA Health Level Seven (HL7)"
^DIC(9.4,82,22,2,"PAH",50,1,59,0)="package. The HL7 package then sends the billing information to the AAC, where"
^DIC(9.4,82,22,2,"PAH",50,1,60,0)="it is routed to the corresponding third party insurance via Emdeon (formerly"
^DIC(9.4,82,22,2,"PAH",50,1,61,0)="WebMD)."
^DIC(9.4,82,22,2,"PAH",50,1,62,0)="  "
^DIC(9.4,82,22,2,"PAH",50,1,63,0)="Once the payer processes the information, the response coming back from the"
^DIC(9.4,82,22,2,"PAH",50,1,64,0)="payer is passed back to the site that made the request, and the information"
^DIC(9.4,82,22,2,"PAH",50,1,65,0)="is stored in the ECME package. If the third party payer accepted the claim,"
^DIC(9.4,82,22,2,"PAH",50,1,66,0)="the adjudicated information is passed along to IB. If the claim was rejected"
^DIC(9.4,82,22,2,"PAH",50,1,67,0)="the problem can be worked on and a new claim can be submitted to the payer."
^DIC(9.4,82,22,2,"PAH",50,1,68,0)="  "
^DIC(9.4,82,22,2,"PAH",50,1,69,0)="For electronically billable CMOP prescription processing, the third party"
^DIC(9.4,82,22,2,"PAH",50,1,70,0)="claim is sent before the prescription information is transmitted to the"
^DIC(9.4,82,22,2,"PAH",50,1,71,0)="CMOP facility to be filled. Once the adjudicating response is electronically "
^DIC(9.4,82,22,2,"PAH",50,1,72,0)="received from the third party payer, if there are no Drug Utilization Review"
^DIC(9.4,82,22,2,"PAH",50,1,73,0)="or Refill Too Soon rejects, the prescription is then transmitted to the CMOP "
^DIC(9.4,82,22,2,"PAH",50,1,74,0)="facility. When the CMOP center sends the dispensing information back to VistA,"
^DIC(9.4,82,22,2,"PAH",50,1,75,0)="the National Drug Code (NDC) information is checked against the NDC sent to "
^DIC(9.4,82,22,2,"PAH",50,1,76,0)="the third party payer and, if different, a new claim is generated in the "
^DIC(9.4,82,22,2,"PAH",50,1,77,0)="background and is sent to the third party payer. In case the CMOP facility "
^DIC(9.4,82,22,2,"PAH",50,1,78,0)="indicates that it is unable to fill a ""PAYABLE  prescription fill, a reversal"
^DIC(9.4,82,22,2,"PAH",50,1,79,0)="is automatically submitted to the third party payer for the corresponding "
^DIC(9.4,82,22,2,"PAH",50,1,80,0)="fill."
^DIC(9.4,82,22,2,"PAH",50,1,81,0)="   "
^DIC(9.4,82,22,2,"PAH",50,1,82,0)="This patch modifies the CMOP application to submit electronic claims for "
^DIC(9.4,82,22,2,"PAH",50,1,83,0)="prescriptions that are transmitted to CMOP centers to be filled and dispensed "
^DIC(9.4,82,22,2,"PAH",50,1,84,0)="remotely. All the prescriptions ready to be included on the batch to be"
^DIC(9.4,82,22,2,"PAH",50,1,85,0)="transmitted to CMOP are first transmitted to the third party insurance. Once"
^DIC(9.4,82,22,2,"PAH",50,1,86,0)="this step is completed, the system waits 60 seconds before the actual"
^DIC(9.4,82,22,2,"PAH",50,1,87,0)="transmission to CMOP starts. This process will affect the existing CMOP"
^DIC(9.4,82,22,2,"PAH",50,1,88,0)="functionality in two ways: "
^DIC(9.4,82,22,2,"PAH",50,1,89,0)="   "
^DIC(9.4,82,22,2,"PAH",50,1,90,0)=" 1) If a response from the third party payer is not received by the time the "
^DIC(9.4,82,22,2,"PAH",50,1,91,0)="    prescription is ready to be transmitted to CMOP, the prescription is"
^DIC(9.4,82,22,2,"PAH",50,1,92,0)="    skipped and remains in the queue for the next CMOP transmission. A Mailman"
^DIC(9.4,82,22,2,"PAH",50,1,93,0)="    message containing all the prescriptions in this category is generated at "
^DIC(9.4,82,22,2,"PAH",50,1,94,0)="    the end of the process and it is transmitted to all the holders of the "
^DIC(9.4,82,22,2,"PAH",50,1,95,0)="    PSXMAIL security key. If no users on the system have this key, the Mailman"
^DIC(9.4,82,22,2,"PAH",50,1,96,0)="    message is sent to all the users holding the PSXCMOPMGR security key."
^DIC(9.4,82,22,2,"PAH",50,1,97,0)=" "
^DIC(9.4,82,22,2,"PAH",50,1,98,0)=" 2) If the third party payer rejects the claim due to a DUR (Drug Utilization"
^DIC(9.4,82,22,2,"PAH",50,1,99,0)="    Review) or a 'REFILL TOO SOON' reject, the prescription is not sent to"
^DIC(9.4,82,22,2,"PAH",50,1,100,0)="    CMOP and remains in the queue to be transmitted in the next CMOP "
^DIC(9.4,82,22,2,"PAH",50,1,101,0)="    transmission. The prescription will not be transmitted to CMOP until the"
^DIC(9.4,82,22,2,"PAH",50,1,102,0)="    reject is resolved by the user through the Outpatient Pharmacy V. 7.0 "
^DIC(9.4,82,22,2,"PAH",50,1,103,0)="    application. No message is generated for prescriptions in this category."
^DIC(9.4,82,22,2,"PAH",51,0)="62 SEQ #52^3060923^1"
^DIC(9.4,82,22,2,"PAH",51,1,0)="^^28^28^3060923"
^DIC(9.4,82,22,2,"PAH",51,1,1,0)="This patch supports the National Council for Prescription Drug Programs (NCPDP) "
^DIC(9.4,82,22,2,"PAH",51,1,2,0)="standard which was adopted under the Healthcare Insurance Portability and "
^DIC(9.4,82,22,2,"PAH",51,1,3,0)="Accountability Act (HIPAA) for pharmacy claims. This patch is one of six to be"
^DIC(9.4,82,22,2,"PAH",51,1,4,0)="released.  Three patches will be released in a KIDS multi-build distribution "
^DIC(9.4,82,22,2,"PAH",51,1,5,0)="containing: BPS*1*3, PSO*7*247, and IB*2*342.  Three patches will be released"
^DIC(9.4,82,22,2,"PAH",51,1,6,0)="individually and they are: PRCA*4.5*247, PSX*2*62, and PSS*1*115."
^DIC(9.4,82,22,2,"PAH",51,1,7,0)=" "
^DIC(9.4,82,22,2,"PAH",51,1,8,0)="Enhancements included in the release of the six patches are a new option that "
^DIC(9.4,82,22,2,"PAH",51,1,9,0)="will enable the user to reopen a closed Electronic Claims Management Engine"
^DIC(9.4,82,22,2,"PAH",51,1,10,0)="(ECME) claim; updates to the Rx Activity Log; and permanent storage of Claims"
^DIC(9.4,82,22,2,"PAH",51,1,11,0)="activity information as reported by the ECME Billing Events Report."
^DIC(9.4,82,22,2,"PAH",51,1,12,0)=" "
^DIC(9.4,82,22,2,"PAH",51,1,13,0)="This patch modifies the CMOP application in the following ways:"
^DIC(9.4,82,22,2,"PAH",51,1,14,0)=" "
^DIC(9.4,82,22,2,"PAH",51,1,15,0)="1) The process responsible for transmitting of prescriptions to the "
^DIC(9.4,82,22,2,"PAH",51,1,16,0)="   Consolidated Mailout Outpatient Pharmacy (CMOP) facilities was changed to"
^DIC(9.4,82,22,2,"PAH",51,1,17,0)="   perform the following check: "
^DIC(9.4,82,22,2,"PAH",51,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",51,1,19,0)="   For ePharmacy prescriptions only, before a fill can be transmitted to "
^DIC(9.4,82,22,2,"PAH",51,1,20,0)="   the CMOP facility, the previous fill cannot be pending to be filled at"
^DIC(9.4,82,22,2,"PAH",51,1,21,0)="   the CMOP facility. For example, before transmitting refill 1 to the "
^DIC(9.4,82,22,2,"PAH",51,1,22,0)="   CMOP facility, the software will check if the original is currently"
^DIC(9.4,82,22,2,"PAH",51,1,23,0)="   being filled by CMOP. If so, the refill 1 will be held until the "
^DIC(9.4,82,22,2,"PAH",51,1,24,0)="   original fill process is completed by the CMOP facility. "
^DIC(9.4,82,22,2,"PAH",51,1,25,0)=" "
^DIC(9.4,82,22,2,"PAH",51,1,26,0)="2) Changed the second line of the routine PSXVND by adding the patch"
^DIC(9.4,82,22,2,"PAH",51,1,27,0)="   numbers 1 and 2 to the list of patches. These patch numbers were"
^DIC(9.4,82,22,2,"PAH",51,1,28,0)="   unintentionally removed by patch PSX*2*48."
^DIC(9.4,82,22,2,"PAH",52,0)="61 SEQ #53^3060923^1"
^DIC(9.4,82,22,2,"PAH",52,1,0)="^^15^15^3060923"
^DIC(9.4,82,22,2,"PAH",52,1,1,0)="This patch contains an Application Program Interface (API) that will be "
^DIC(9.4,82,22,2,"PAH",52,1,2,0)="used by calling applications that currently do direct global reads or "
^DIC(9.4,82,22,2,"PAH",52,1,3,0)="writes to the CMOP SYSTEM file (#550). Since this file is being replaced "
^DIC(9.4,82,22,2,"PAH",52,1,4,0)="as part of the Pharmacy Re-engineering project, any direct M-based global "
^DIC(9.4,82,22,2,"PAH",52,1,5,0)="reads or writes to this file must be replaced by calling the APIs provided "
^DIC(9.4,82,22,2,"PAH",52,1,6,0)="in this patch. When the new data source is in place, the calling "
^DIC(9.4,82,22,2,"PAH",52,1,7,0)="applications will not be required to make any changes, because these APIs "
^DIC(9.4,82,22,2,"PAH",52,1,8,0)="will be flexible enough to retrieve the requested data from the new data "
^DIC(9.4,82,22,2,"PAH",52,1,9,0)="source, when the time comes."
^DIC(9.4,82,22,2,"PAH",52,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",52,1,11,0)="This API replaces the following integration agreements:"
^DIC(9.4,82,22,2,"PAH",52,1,12,0)=" "
^DIC(9.4,82,22,2,"PAH",52,1,13,0)="DBIA #  Affected Package(s)"
^DIC(9.4,82,22,2,"PAH",52,1,14,0)="---------------------------"
^DIC(9.4,82,22,2,"PAH",52,1,15,0)="2199    CPRS"
^DIC(9.4,82,22,2,"PAH",53,0)="54 SEQ #54^3070627.22152^1"
^DIC(9.4,82,22,2,"PAH",53,1,0)="^^142^142^3070627"
^DIC(9.4,82,22,2,"PAH",53,1,1,0)="As part of the Outpatient Pharmacy V. 7.0 Laser Labels Phase II project, "
^DIC(9.4,82,22,2,"PAH",53,1,2,0)="a new commercial data source is utilized to provide warning label source"
^DIC(9.4,82,22,2,"PAH",53,1,3,0)="information. The new warning labels are enabled for printing on the laser "
^DIC(9.4,82,22,2,"PAH",53,1,4,0)="labels when the WARNING LABEL SOURCE field (#16) of the PHARMACY SYSTEM"
^DIC(9.4,82,22,2,"PAH",53,1,5,0)="file (#59.7) is set to ""N"" for ""New"". Parameters for using the new "
^DIC(9.4,82,22,2,"PAH",53,1,6,0)="warning labels are set using the Pharmacy System Parameters Edit [PSS SYS "
^DIC(9.4,82,22,2,"PAH",53,1,7,0)="EDIT] option."
^DIC(9.4,82,22,2,"PAH",53,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,9,0)="For the Consolidated Mail Outpatient Pharmacy (CMOP) to utilize the new "
^DIC(9.4,82,22,2,"PAH",53,1,10,0)="warning labels, this patch uses a new CMOP WARNING LABEL SOURCE field "
^DIC(9.4,82,22,2,"PAH",53,1,11,0)="(#16.1) in the PHARMACY SYSTEM file (#59.7), also set by using the "
^DIC(9.4,82,22,2,"PAH",53,1,12,0)="Pharmacy System Parameters Edit [PSS SYS EDIT] option. This should be set"
^DIC(9.4,82,22,2,"PAH",53,1,13,0)="to ""N"" for ""New"" to send the new warnings to CMOP. This field is added by "
^DIC(9.4,82,22,2,"PAH",53,1,14,0)="patch PSS*1*120."
^DIC(9.4,82,22,2,"PAH",53,1,15,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,16,0)="If the BAD ADDRESS INDICATOR field (#.121) in the PATIENT file (#2) is set"
^DIC(9.4,82,22,2,"PAH",53,1,17,0)="and there is no active temporary address for the patient, the fill will"
^DIC(9.4,82,22,2,"PAH",53,1,18,0)="appear on the CMOP reject log and will remain in suspense, but unmarked"
^DIC(9.4,82,22,2,"PAH",53,1,19,0)="for CMOP. It will print when the local print from suspense is done to be "
^DIC(9.4,82,22,2,"PAH",53,1,20,0)="filled locally."
^DIC(9.4,82,22,2,"PAH",53,1,21,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,23,0)="**************** NOTE ***************************************************"
^DIC(9.4,82,22,2,"PAH",53,1,24,0)="As the CMOP side also had to make programming changes, verify that the"
^DIC(9.4,82,22,2,"PAH",53,1,25,0)="CMOP that your site sends to can receive the new warning label format."
^DIC(9.4,82,22,2,"PAH",53,1,26,0)="Then after setting the CMOP WARNING LABEL SOURCE field (#16.1) to ""New"","
^DIC(9.4,82,22,2,"PAH",53,1,27,0)="send a small batch and verify that it was received and able to be"
^DIC(9.4,82,22,2,"PAH",53,1,28,0)="processed successfully. (As of the release of this patch, only the Bedford"
^DIC(9.4,82,22,2,"PAH",53,1,29,0)="CMOP was not yet ready to receive the new format)."
^DIC(9.4,82,22,2,"PAH",53,1,30,0)="**************************************************************************"
^DIC(9.4,82,22,2,"PAH",53,1,31,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,32,0)="This patch adds the sending of the INTEGRATION CONTROL NUMBER field "
^DIC(9.4,82,22,2,"PAH",53,1,33,0)="(#991.01) from the PATIENT file (#2) if it is a national number. This "
^DIC(9.4,82,22,2,"PAH",53,1,34,0)="number is concatenated with the letter ""V"" and the ICN CHECKSUM field"
^DIC(9.4,82,22,2,"PAH",53,1,35,0)="(#991.02) from the PATIENT file (#2) and is sent as the 18th subscript of"
^DIC(9.4,82,22,2,"PAH",53,1,36,0)="the PID segment. (See example under item 1 below)."
^DIC(9.4,82,22,2,"PAH",53,1,37,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,38,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,39,0)="When the CMOP WARNING LABEL SOURCE is ""New"", the format and/or content of"
^DIC(9.4,82,22,2,"PAH",53,1,40,0)="the following segments will be changed:"
^DIC(9.4,82,22,2,"PAH",53,1,41,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,42,0)="1. For the Patient Identification (PID) segment, the Patient Medication"
^DIC(9.4,82,22,2,"PAH",53,1,43,0)="Instruction (PMI) preference will be sent as ""ENG"" for English or ""SPA"""
^DIC(9.4,82,22,2,"PAH",53,1,44,0)="for Spanish instead of the current numeric values."
^DIC(9.4,82,22,2,"PAH",53,1,45,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,46,0)="   Example:"
^DIC(9.4,82,22,2,"PAH",53,1,47,0)="PID||000007890^1^M11||OPPATIENT^ONE||||12345 S MAIN ST^ADDRESS |"
^DIC(9.4,82,22,2,"PAH",53,1,48,0)="LINE2^MADISON ^WI^53705|(000)555-1212|SPA||1011007381V739824"
^DIC(9.4,82,22,2,"PAH",53,1,49,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,50,0)="2. Currently, the first part of the English language medication "
^DIC(9.4,82,22,2,"PAH",53,1,51,0)="instruction (SIG) is sent in the RX1 segment and continuations are sent in"
^DIC(9.4,82,22,2,"PAH",53,1,52,0)="NTE|7 segments. Additional fields added to the NTE|7| segment when the "
^DIC(9.4,82,22,2,"PAH",53,1,53,0)="new|"
^DIC(9.4,82,22,2,"PAH",53,1,54,0)="warning source flag is set are:"
^DIC(9.4,82,22,2,"PAH",53,1,55,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,56,0)="NTE|7|RX NUMBER|LANGUAGE CODE|NUMBER|TEXT  (TEXT is up to 100 characters |"
^DIC(9.4,82,22,2,"PAH",53,1,57,0)="per NTE|7| segment) "
^DIC(9.4,82,22,2,"PAH",53,1,58,0)="Where: "
^DIC(9.4,82,22,2,"PAH",53,1,59,0)="       RX NUMBER is the external prescription number from the PRESCRIPTION"
^DIC(9.4,82,22,2,"PAH",53,1,60,0)="         file (#52). "
^DIC(9.4,82,22,2,"PAH",53,1,61,0)="       LANGUAGE CODE will be ""ENG"" for English or ""SPA"" for Spanish. "
^DIC(9.4,82,22,2,"PAH",53,1,62,0)="       NUMBER is a sequence number for the SIG lines starting at 1 for"
^DIC(9.4,82,22,2,"PAH",53,1,63,0)="         each different language code."
^DIC(9.4,82,22,2,"PAH",53,1,64,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,65,0)="   Example:"
^DIC(9.4,82,22,2,"PAH",53,1,66,0)="RX1|500-300993-1||||||90|D0132^DOXEPIN HCL 25MG CAP^L|||11|"
^DIC(9.4,82,22,2,"PAH",53,1,67,0)="20061122|11| |20071123|20061122|300993||TAKE TWO CAPSULES MOUTH THREE"
^DIC(9.4,82,22,2,"PAH",53,1,68,0)="TIMES A DAY FOR 7 D AYS, THEN TAKE ONE CAPSULE"
^DIC(9.4,82,22,2,"PAH",53,1,69,0)="NTE|7|300993|ENG|1|TWICE A DAY FOR 7 DAYS, THEN TAKE ONE CAPSULE AT |"
^DIC(9.4,82,22,2,"PAH",53,1,70,0)="BEDTIME FOR 7 DAYS, THEN TAKE"
^DIC(9.4,82,22,2,"PAH",53,1,71,0)="NTE|7|300993|ENG|2|ONE CAPSULE EVERY OTHER DAY FOR 7 DAYS |"
^DIC(9.4,82,22,2,"PAH",53,1,72,0)="NTE|7|300993|SPA|1|TAKE DOS CAPSULES MOUTH THREE TIMES A DAY PARA 7 DIAS, "
^DIC(9.4,82,22,2,"PAH",53,1,73,0)="|"
^DIC(9.4,82,22,2,"PAH",53,1,74,0)="THEN TAKE UNO CAPSULE"
^DIC(9.4,82,22,2,"PAH",53,1,75,0)="NTE|7|300993|SPA|2|TWICE A DAY PARA 7 DIAS, THEN TAKE UNO CAPSULE AT |"
^DIC(9.4,82,22,2,"PAH",53,1,76,0)="BEDTIME PARA 7 DIAS, THEN"
^DIC(9.4,82,22,2,"PAH",53,1,77,0)="NTE|7|300993|SPA|3|TAKE UNO CAPSULE EVERY OTHER DAY PARA 7 DIAS |"
^DIC(9.4,82,22,2,"PAH",53,1,78,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,79,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,80,0)="3. Instead of sending warning label numbers in the ZX1 segment, the "
^DIC(9.4,82,22,2,"PAH",53,1,81,0)="warning label text will be sent in the new NTE|11|segments."
^DIC(9.4,82,22,2,"PAH",53,1,82,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,83,0)="Note: A maximum of 5 warning labels can be printed, so only the first 5 "
^DIC(9.4,82,22,2,"PAH",53,1,84,0)="for a drug will be sent to CMOP. If the patient has a PMI Language "
^DIC(9.4,82,22,2,"PAH",53,1,85,0)="Preference other than English, the first 5 warning labels in each "
^DIC(9.4,82,22,2,"PAH",53,1,86,0)="language will be sent."
^DIC(9.4,82,22,2,"PAH",53,1,87,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,88,0)="The fields for the new warning labels are: "
^DIC(9.4,82,22,2,"PAH",53,1,89,0)="NTE|11|RX NUMBER|LANGUAGE CODE|RECORD NUMBER|WARNING LABEL TEXT|"
^DIC(9.4,82,22,2,"PAH",53,1,90,0)="Where: "
^DIC(9.4,82,22,2,"PAH",53,1,91,0)="       RX NUMBER is the external prescription number from the  "
^DIC(9.4,82,22,2,"PAH",53,1,92,0)="         PRESCRIPTION file (#52). "
^DIC(9.4,82,22,2,"PAH",53,1,93,0)="       LANGUAGE CODE will be ""ENG"" for English or ""SPA"" for Spanish. "
^DIC(9.4,82,22,2,"PAH",53,1,94,0)="       RECORD NUMBER is either the internal entry number from the RX "
^DIC(9.4,82,22,2,"PAH",53,1,95,0)="         CONSULT file (#54) or the internal entry number from the WARNING"
^DIC(9.4,82,22,2,"PAH",53,1,96,0)="         LABEL-ENGLISH file (#50.625) followed by an ""N"" when the LANGUAGE"
^DIC(9.4,82,22,2,"PAH",53,1,97,0)="         CODE is ""ENG"" or the internal entry number from the WARNING"
^DIC(9.4,82,22,2,"PAH",53,1,98,0)="         LABEL-SPANISH file (#50.626) followed by an ""N"" when the LANGUAGE"
^DIC(9.4,82,22,2,"PAH",53,1,99,0)="         CODE is ""SPA"". "
^DIC(9.4,82,22,2,"PAH",53,1,100,0)="       WARNING LABEL TEXT is the complete text of the specified warning "
^DIC(9.4,82,22,2,"PAH",53,1,101,0)="         number (maximum length is 200 characters). "
^DIC(9.4,82,22,2,"PAH",53,1,102,0)="   "
^DIC(9.4,82,22,2,"PAH",53,1,103,0)="   Example: "
^DIC(9.4,82,22,2,"PAH",53,1,104,0)="ZX1|300993|514^TROY|M|1|(1of12)|WHITE,ELAINE|1|(***/***)|20061122|1|1|1|30"
^DIC(9.4,82,22,2,"PAH",53,1,105,0)="|"
^DIC(9.4,82,22,2,"PAH",53,1,106,0)="|500"
^DIC(9.4,82,22,2,"PAH",53,1,107,0)="-5294709|SCL50|UNKNOWN|"
^DIC(9.4,82,22,2,"PAH",53,1,108,0)="NTE|11|300993|ENG|1N|May cause drowsiness.  Alcohol may intensify this |"
^DIC(9.4,82,22,2,"PAH",53,1,109,0)="effect. Use care when operating a car or dangerous machines."
^DIC(9.4,82,22,2,"PAH",53,1,110,0)="NTE|11|300993|ENG|62N|May cause dizziness|"
^DIC(9.4,82,22,2,"PAH",53,1,111,0)="NTE|11|300993|ENG|11N|Avoid prolonged or excessive exposure to direct |"
^DIC(9.4,82,22,2,"PAH",53,1,112,0)="and/or ar"
^DIC(9.4,82,22,2,"PAH",53,1,113,0)="tificial sunlight while taking this medication."
^DIC(9.4,82,22,2,"PAH",53,1,114,0)="NTE|11|300993|ENG|61N|May cause blurred vision|"
^DIC(9.4,82,22,2,"PAH",53,1,115,0)="NTE|11|300993|ENG|13N|It is very important that you take or use this |"
^DIC(9.4,82,22,2,"PAH",53,1,116,0)="exactly as directed.  Do not skip doses or discontinue unless directed by"
^DIC(9.4,82,22,2,"PAH",53,1,117,0)="your doctor."
^DIC(9.4,82,22,2,"PAH",53,1,118,0)="NTE|11|300993|SPA|1N|Puede causar somnolencia. El alcohol puede |"
^DIC(9.4,82,22,2,"PAH",53,1,119,0)="intensificar es te efecto. Tenga cuidado cuando conduzca veh!culos"
^DIC(9.4,82,22,2,"PAH",53,1,120,0)="automotores u opere maquinar ia peligrosa."
^DIC(9.4,82,22,2,"PAH",53,1,121,0)="NTE|11|300993|SPA|62N|Puede causar mareo.|"
^DIC(9.4,82,22,2,"PAH",53,1,122,0)="NTE|11|300993|SPA|11N|Evite exponerse excesivamente o por per!odos |"
^DIC(9.4,82,22,2,"PAH",53,1,123,0)="prolongados a los rayos solares directos y/o artificiales mientras tome"
^DIC(9.4,82,22,2,"PAH",53,1,124,0)="este medicamento."
^DIC(9.4,82,22,2,"PAH",53,1,125,0)="NTE|11|300993|SPA|61N|Puede causar visi""n borrosa.|"
^DIC(9.4,82,22,2,"PAH",53,1,126,0)="NTE|11|300993|SPA|13N|Es muy importante que lo tome o lo use exactamente |"
^DIC(9.4,82,22,2,"PAH",53,1,127,0)="seg#n las indicaciones. No omita ninguna dosis ni lo deje de usar a menos"
^DIC(9.4,82,22,2,"PAH",53,1,128,0)="que lo mande el mdico."
^DIC(9.4,82,22,2,"PAH",53,1,129,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,130,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,131,0)="Also included in this patch is a fix for several Remedy tickets regarding "
^DIC(9.4,82,22,2,"PAH",53,1,132,0)="a null subscript when a prescription was discontinued during transmission."
^DIC(9.4,82,22,2,"PAH",53,1,133,0)="If the prescription was discontinued, the CMOP TRANSMISSION file (#550.2)"
^DIC(9.4,82,22,2,"PAH",53,1,134,0)="reference for that prescription is cleaned up."
^DIC(9.4,82,22,2,"PAH",53,1,135,0)=" "
^DIC(9.4,82,22,2,"PAH",53,1,136,0)="Also added to this patch is the check for the value of the PROJ 112/SHAD"
^DIC(9.4,82,22,2,"PAH",53,1,137,0)="field (#122.01) in the PRESCRIPTION file (#52) as an additional"
^DIC(9.4,82,22,2,"PAH",53,1,138,0)="Environmental Indicator check to determine whether to send a copay or no "
^DIC(9.4,82,22,2,"PAH",53,1,139,0)="copay indicator to CMOP. The patch that creates this new field, PSO*7*225,"
^DIC(9.4,82,22,2,"PAH",53,1,140,0)="will be released along with Computerized Patient Record System (CPRS)"
^DIC(9.4,82,22,2,"PAH",53,1,141,0)="GUI27. The added check in this patch will have no effect until PSO*7*225 "
^DIC(9.4,82,22,2,"PAH",53,1,142,0)="is installed."
^DIC(9.4,82,22,2,"PAH",54,0)="58 SEQ #55^3071212.205312^1"
^DIC(9.4,82,22,2,"PAH",54,1,0)="^^20^20^3071212"
^DIC(9.4,82,22,2,"PAH",54,1,1,0)="This patch checks for the BAD ADDRESS INDICATOR field (#.121) of the"
^DIC(9.4,82,22,2,"PAH",54,1,2,0)="PATIENT file (#2) being set or for the patient having a foreign address"
^DIC(9.4,82,22,2,"PAH",54,1,3,0)="when queueing transactions to Consolidated Mail Outpatient Pharmacy"
^DIC(9.4,82,22,2,"PAH",54,1,4,0)="(CMOP). If found, the fill stays on suspense for CMOP, but only prints the"
^DIC(9.4,82,22,2,"PAH",54,1,5,0)="reject MailMan message the first time for the fill. The reject MailMan"
^DIC(9.4,82,22,2,"PAH",54,1,6,0)="message is sent to holders of the PSXMAIL key and the person who queued"
^DIC(9.4,82,22,2,"PAH",54,1,7,0)="the CMOP transmission. An entry is made into the PRESCRIPTION file (#52) "
^DIC(9.4,82,22,2,"PAH",54,1,8,0)="activity log the first time the fill cannot be transmitted due to one of "
^DIC(9.4,82,22,2,"PAH",54,1,9,0)="these two conditions."
^DIC(9.4,82,22,2,"PAH",54,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",54,1,11,0)="This patch corrects the numbering of refills in the RX REFERENCE field "
^DIC(9.4,82,22,2,"PAH",54,1,12,0)="(#.04) of the ACTIVITY LOG multiple (#52.3) of the PRESCRIPTION file"
^DIC(9.4,82,22,2,"PAH",54,1,13,0)="(#52). A number 6 in the  field should mean a partial and any refills "
^DIC(9.4,82,22,2,"PAH",54,1,14,0)="greater than the 5th refill should be stored as 1 plus the actual refill "
^DIC(9.4,82,22,2,"PAH",54,1,15,0)="number. "
^DIC(9.4,82,22,2,"PAH",54,1,16,0)=" "
^DIC(9.4,82,22,2,"PAH",54,1,17,0)="This patch also removes a call to a routine that is not used (related to "
^DIC(9.4,82,22,2,"PAH",54,1,18,0)="Outpatient Pharmacy V. 6.0 sending information to the CLINICAL INFO"
^DIC(9.4,82,22,2,"PAH",54,1,19,0)="RESOURCE NETWORK (CIRN) package). Outpatient Pharmacy will be removed as a"
^DIC(9.4,82,22,2,"PAH",54,1,20,0)="subscriber to Data Base Integration Agreement (DBIA) 2382."
^DIC(9.4,82,22,2,"PAH",55,0)="63 SEQ #56^3071212.214756^1"
^DIC(9.4,82,22,2,"PAH",55,1,0)="^^24^24^3071212"
^DIC(9.4,82,22,2,"PAH",55,1,1,0)="The general purpose of this patch is to meet the requirements in support "
^DIC(9.4,82,22,2,"PAH",55,1,2,0)="of the Phase 4 ePharmacy enhancements. This patch is one of five to be "
^DIC(9.4,82,22,2,"PAH",55,1,3,0)="released.  Three patches will be released in the KIDS multi-build "
^DIC(9.4,82,22,2,"PAH",55,1,4,0)="distribution, BPS PSO IB BUNDLE 2.0, containing: BPS*1*5, IB*2*363,"
^DIC(9.4,82,22,2,"PAH",55,1,5,0)="PSO*7*260.  PSX*2*63 and PSS*1*127 will be released as stand-alone "
^DIC(9.4,82,22,2,"PAH",55,1,6,0)="patches. The recommended order for installing the patches is to install"
^DIC(9.4,82,22,2,"PAH",55,1,7,0)="the stand-alone patch first and multi-build must be installed afterwards."
^DIC(9.4,82,22,2,"PAH",55,1,8,0)="since there is a implementation dependency between the multi-build "
^DIC(9.4,82,22,2,"PAH",55,1,9,0)="distribution and the stand-alone patch.  For more specific instructions "
^DIC(9.4,82,22,2,"PAH",55,1,10,0)="please refer to the installation steps provided in each of the stand-alone"
^DIC(9.4,82,22,2,"PAH",55,1,11,0)="patches."
^DIC(9.4,82,22,2,"PAH",55,1,12,0)=" "
^DIC(9.4,82,22,2,"PAH",55,1,13,0)="The software changes distributed by this patch are exclusively for"
^DIC(9.4,82,22,2,"PAH",55,1,14,0)="supporting the Electronic Claims Management Engine (ECME) application for"
^DIC(9.4,82,22,2,"PAH",55,1,15,0)="the ePharmacy/ECME Enhancements project (BPS*1*4). There is no functional"
^DIC(9.4,82,22,2,"PAH",55,1,16,0)="impact to the Consolidated Mailout Outpatient Pharmacy (CMOP) application."
^DIC(9.4,82,22,2,"PAH",55,1,17,0)="The change is technical in nature and is explained below:"
^DIC(9.4,82,22,2,"PAH",55,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",55,1,19,0)="  The PSXBPSRP routine was created to replace the BPSCEAR routine, which"
^DIC(9.4,82,22,2,"PAH",55,1,20,0)="  was previously used by ECME to run the CMOP/ECME Activity Report [BPS "
^DIC(9.4,82,22,2,"PAH",55,1,21,0)="RPT"
^DIC(9.4,82,22,2,"PAH",55,1,22,0)="  CMOP/ECME ACTIVITY] option. This option will be changed to call the "
^DIC(9.4,82,22,2,"PAH",55,1,23,0)="  PSXBPSRP routine instead. This call is supported by the Database"
^DIC(9.4,82,22,2,"PAH",55,1,24,0)="  Integration Agreement #4968."
^DIC(9.4,82,22,2,"PAH",56,0)="64 SEQ #57^3080722.074046^1"
^DIC(9.4,82,22,2,"PAH",56,1,0)="^^31^31^3080722"
^DIC(9.4,82,22,2,"PAH",56,1,1,0)="Overview of Remedy Ticket(s):"
^DIC(9.4,82,22,2,"PAH",56,1,2,0)="-----------------------------"
^DIC(9.4,82,22,2,"PAH",56,1,3,0)="Problem: HD200299"
^DIC(9.4,82,22,2,"PAH",56,1,4,0)="----------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",56,1,5,0)="If the Pharmacy Site instruction(s) exceed seven lines a warning"
^DIC(9.4,82,22,2,"PAH",56,1,6,0)="message will be generated and sent to the CMOP Managers.  This"
^DIC(9.4,82,22,2,"PAH",56,1,7,0)="mail message that is sent includes the following line:"
^DIC(9.4,82,22,2,"PAH",56,1,8,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,9,0)="Lines beyond seven are not being sent to the CMOP."
^DIC(9.4,82,22,2,"PAH",56,1,10,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,11,0)="The word ""beyond"" is mis-spelled ""beyound""."
^DIC(9.4,82,22,2,"PAH",56,1,12,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,13,0)="Problem: HD225944"
^DIC(9.4,82,22,2,"PAH",56,1,14,0)="----------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",56,1,15,0)="While using the option Scheduled Non-CS Transmission (PSXR SCHEDULED"
^DIC(9.4,82,22,2,"PAH",56,1,16,0)="NON-CS TRANS) the possibility exists to receive the following error:"
^DIC(9.4,82,22,2,"PAH",56,1,17,0)="<COMMAND>GETDATA+13^PSXRPPL"
^DIC(9.4,82,22,2,"PAH",56,1,18,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,19,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,20,0)="Resolution: HD200299"
^DIC(9.4,82,22,2,"PAH",56,1,21,0)="----------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",56,1,22,0)="The word ""beyound"" has been changed to ""beyond"""
^DIC(9.4,82,22,2,"PAH",56,1,23,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,24,0)="Resolution: HD225944"
^DIC(9.4,82,22,2,"PAH",56,1,25,0)="----------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",56,1,26,0)="The program PSXMISC1 will be modified to return a value to the calling"
^DIC(9.4,82,22,2,"PAH",56,1,27,0)="Routine.  This will allow the Scheduled Non-CS Transmission to"
^DIC(9.4,82,22,2,"PAH",56,1,28,0)="continue without error."
^DIC(9.4,82,22,2,"PAH",56,1,29,0)=" "
^DIC(9.4,82,22,2,"PAH",56,1,30,0)="The following is a list of the routines included in this patch.  "
^DIC(9.4,82,22,2,"PAH",56,1,31,0)="The second line of each of these routines now looks like: "
^DIC(9.4,82,22,2,"PAH",57,0)="66 SEQ #58^3090421.162049^17"
^DIC(9.4,82,22,2,"PAH",57,1,0)="^^27^27^3090421"
^DIC(9.4,82,22,2,"PAH",57,1,1,0)="This patch is one of four patches that enhance ePharmacy, which provides "
^DIC(9.4,82,22,2,"PAH",57,1,2,0)="limited support to Tricare and Active Duty outpatient pharmacy billing."
^DIC(9.4,82,22,2,"PAH",57,1,3,0)=" "
^DIC(9.4,82,22,2,"PAH",57,1,4,0)="Below is a list of all the applications involved in this project along "
^DIC(9.4,82,22,2,"PAH",57,1,5,0)="with their associated patch number:"
^DIC(9.4,82,22,2,"PAH",57,1,6,0)=" "
^DIC(9.4,82,22,2,"PAH",57,1,7,0)="       APPLICATION/VERSION                                  PATCH"
^DIC(9.4,82,22,2,"PAH",57,1,8,0)="     --------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",57,1,9,0)=" 1.  CONSOLIDATED MAIL OUTPATIENT PHARMCY (CMOP) V. 2.0   PSX*2*66"
^DIC(9.4,82,22,2,"PAH",57,1,10,0)=" 2.  OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*287"
^DIC(9.4,82,22,2,"PAH",57,1,11,0)=" 3.  ELECTRONIC CLAIMS MANAGEMENT ENGINE (ECME) V. 1.0    BPS*1*6"
^DIC(9.4,82,22,2,"PAH",57,1,12,0)=" 4.  INTEGRATED BILLING (IB) V. 2.0                       IB*2*383"
^DIC(9.4,82,22,2,"PAH",57,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",57,1,14,0)="All four patches are being released separately with a requirement that "
^DIC(9.4,82,22,2,"PAH",57,1,15,0)="they be installed in the order outlined above.  There are no other "
^DIC(9.4,82,22,2,"PAH",57,1,16,0)="dependencies between these patches, except that Tricare/Active Duty "
^DIC(9.4,82,22,2,"PAH",57,1,17,0)="billing will not be supported by ePharmacy until all 4 patches are "
^DIC(9.4,82,22,2,"PAH",57,1,18,0)="installed."
^DIC(9.4,82,22,2,"PAH",57,1,19,0)=" "
^DIC(9.4,82,22,2,"PAH",57,1,20,0)="This patch modifies the Consolidated Mail Outpatient Pharmacy v2.0"
^DIC(9.4,82,22,2,"PAH",57,1,21,0)="application.  "
^DIC(9.4,82,22,2,"PAH",57,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",57,1,23,0)="For Tricare prescriptions, CMOP background processing was modified to"
^DIC(9.4,82,22,2,"PAH",57,1,24,0)="retain prescriptions in suspense when the third party claim remains in an "
^DIC(9.4,82,22,2,"PAH",57,1,25,0)="ECME 'IN PROGESS' status or when it is flagged as non-billable. These "
^DIC(9.4,82,22,2,"PAH",57,1,26,0)="prescriptions will be listed on the existing MailMan message "
^DIC(9.4,82,22,2,"PAH",57,1,27,0)="with a subject line of 'ePharmacy - CMOP Not TRANSMITTED Rx List'."
^DIC(9.4,82,22,2,"PAH",58,0)="65 SEQ #59^3090714.090959^17"
^DIC(9.4,82,22,2,"PAH",58,1,0)="^^405^405^3090714"
^DIC(9.4,82,22,2,"PAH",58,1,1,0)="This patch has enhancements which extend the capabilities of the Veterans "
^DIC(9.4,82,22,2,"PAH",58,1,2,0)="Health Information Systems and Technology Architecture (VistA) electronic "
^DIC(9.4,82,22,2,"PAH",58,1,3,0)="pharmacy (ePharmacy) billing system.  Below is a list of all the "
^DIC(9.4,82,22,2,"PAH",58,1,4,0)="applications involved in this project along with their patch number:"
^DIC(9.4,82,22,2,"PAH",58,1,5,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,6,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,82,22,2,"PAH",58,1,7,0)="   --------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",58,1,8,0)="   CONSOLIDATED MAIL OUTPATIENT PHARMACY (CMOP) V. 2.0  PSX*2*65"
^DIC(9.4,82,22,2,"PAH",58,1,9,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*131"
^DIC(9.4,82,22,2,"PAH",58,1,10,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*289"
^DIC(9.4,82,22,2,"PAH",58,1,11,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*384"
^DIC(9.4,82,22,2,"PAH",58,1,12,0)="   ELECTRONIC CLAIMS MANAGEMENT ENGINE (ECME) V. 1.0    BPS*1*7"
^DIC(9.4,82,22,2,"PAH",58,1,13,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,14,0)="The last three patches (PSO*7*289, IB*2*384 and BPS*1*7) will be released "
^DIC(9.4,82,22,2,"PAH",58,1,15,0)="in the Kernel Installation and Distribution System (KIDS) multi-build "
^DIC(9.4,82,22,2,"PAH",58,1,16,0)="distribution BPS PSO IB BUNDLE 3.0.  Patches PSX*2*65 and PSS*1*131 will "
^DIC(9.4,82,22,2,"PAH",58,1,17,0)="be released as stand-alone patches.  Since there is an implementation "
^DIC(9.4,82,22,2,"PAH",58,1,18,0)="dependency between the multi-build distribution and the stand-alone "
^DIC(9.4,82,22,2,"PAH",58,1,19,0)="patches, PSX*2*65 and PSS*1*131 must be installed prior to the "
^DIC(9.4,82,22,2,"PAH",58,1,20,0)="installation of the multi-build.  For more specific instructions please "
^DIC(9.4,82,22,2,"PAH",58,1,21,0)="refer to the installation steps provided in each of the patches."
^DIC(9.4,82,22,2,"PAH",58,1,22,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,23,0)="All sites should install these patches regardless of whether or not they "
^DIC(9.4,82,22,2,"PAH",58,1,24,0)="have been activated for ePharmacy by the Central Business Office (CBO).  "
^DIC(9.4,82,22,2,"PAH",58,1,25,0)="After the installation of these patches, the activation status of the "
^DIC(9.4,82,22,2,"PAH",58,1,26,0)="site will not be impacted.  As before, activation of the ePharmacy "
^DIC(9.4,82,22,2,"PAH",58,1,27,0)="product will require instructions provided by the CBO.  Sites are not to "
^DIC(9.4,82,22,2,"PAH",58,1,28,0)="activate unless instructed specifically by the CBO."
^DIC(9.4,82,22,2,"PAH",58,1,29,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,30,0)="This patch modifies the CMOP v2.0 application as described"
^DIC(9.4,82,22,2,"PAH",58,1,31,0)="below:"
^DIC(9.4,82,22,2,"PAH",58,1,32,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,33,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,34,0)="1.      A modification was made to allow for CMOP Suspense Date Rx's "
^DIC(9.4,82,22,2,"PAH",58,1,35,0)="picked up after midnight to be sent to ECME appropriately. When the CMOP "
^DIC(9.4,82,22,2,"PAH",58,1,36,0)="transmission starts, all Rx's in the suspense file are evaluated to see "
^DIC(9.4,82,22,2,"PAH",58,1,37,0)="if they should be submitted to ECME first and if so are submitted. Then "
^DIC(9.4,82,22,2,"PAH",58,1,38,0)="the system re-evaluates the suspense file to pull the latest list of Rx's "
^DIC(9.4,82,22,2,"PAH",58,1,39,0)="to send to CMOP using the current date and time. When the CMOP evaluation "
^DIC(9.4,82,22,2,"PAH",58,1,40,0)="runs past midnight, any Rx's with the suspense dates changed to that day "
^DIC(9.4,82,22,2,"PAH",58,1,41,0)="are sent to CMOP. However, since the ECME submission ran before midnight, "
^DIC(9.4,82,22,2,"PAH",58,1,42,0)="those Rx's would not have been sent. This modification will re-check the "
^DIC(9.4,82,22,2,"PAH",58,1,43,0)="Rx's in suspense for the new date after the CMOP transmission completes "
^DIC(9.4,82,22,2,"PAH",58,1,44,0)="in order to pick up Rx's that need to be sent to ECME after midnight."
^DIC(9.4,82,22,2,"PAH",58,1,45,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,46,0)="2.      New functionality was added to prevent prescriptions from being "
^DIC(9.4,82,22,2,"PAH",58,1,47,0)="filled/sent to CMOP when a host processing error occurs when a claim is "
^DIC(9.4,82,22,2,"PAH",58,1,48,0)="submitted through ECME. The host processing errors are identified by "
^DIC(9.4,82,22,2,"PAH",58,1,49,0)="reject codes M6, M8, NN, and 99. The following conditions apply when this "
^DIC(9.4,82,22,2,"PAH",58,1,50,0)="scenario occurs."
^DIC(9.4,82,22,2,"PAH",58,1,51,0)="a.      The transmission of the Rx/fill will be delayed 1 day in hopes "
^DIC(9.4,82,22,2,"PAH",58,1,52,0)="that the host processing issues will be resolved."
^DIC(9.4,82,22,2,"PAH",58,1,53,0)="b.      An activity log entry will be defined to state the date/time "
^DIC(9.4,82,22,2,"PAH",58,1,54,0)="along with a comment stating that the Rx/fill was left in suspense hold "
^DIC(9.4,82,22,2,"PAH",58,1,55,0)="due to a host processing error."
^DIC(9.4,82,22,2,"PAH",58,1,56,0)="c.      This added functionality does not include the Pull Early from "
^DIC(9.4,82,22,2,"PAH",58,1,57,0)="Suspense function."
^DIC(9.4,82,22,2,"PAH",58,1,58,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,59,0)="3.      New functionality was added to the Print from Suspense File [PSO "
^DIC(9.4,82,22,2,"PAH",58,1,60,0)="PNDLBL] option to prevent prescriptions from being pulled early from "
^DIC(9.4,82,22,2,"PAH",58,1,61,0)="suspense until 3/4 of the days supply of the Rx/fill has elapsed."
^DIC(9.4,82,22,2,"PAH",58,1,62,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,63,0)="4.      The 'CMOP/ECME Activity Report' [BPS RPT CMOP/ECME ACTIVITY] has "
^DIC(9.4,82,22,2,"PAH",58,1,64,0)="been modified. "
^DIC(9.4,82,22,2,"PAH",58,1,65,0)="a.      The CMOP-STATUS column will display 'D' for Dispense or 'T' for "
^DIC(9.4,82,22,2,"PAH",58,1,66,0)="Transmit instead of partially spelling out the status."
^DIC(9.4,82,22,2,"PAH",58,1,67,0)="b.      A prompt will be added to select detailed or summary "
^DIC(9.4,82,22,2,"PAH",58,1,68,0)="information.  Detailed information will reflect what is currently "
^DIC(9.4,82,22,2,"PAH",58,1,69,0)="displayed.  Summary information will shorten the batch header section of "
^DIC(9.4,82,22,2,"PAH",58,1,70,0)="the report."
^DIC(9.4,82,22,2,"PAH",58,1,71,0)="c.      A prompt will be added to select a list of patients (or ^ALL).  "
^DIC(9.4,82,22,2,"PAH",58,1,72,0)="Only patients on the list will be included in the detail."
^DIC(9.4,82,22,2,"PAH",58,1,73,0)="d.      The division prompt will be modified to be consistent with other "
^DIC(9.4,82,22,2,"PAH",58,1,74,0)="ECME options, i.e., the selection prompt will show 'A ALL DIVISIONS' "
^DIC(9.4,82,22,2,"PAH",58,1,75,0)="first, 'S SELECT DIVISIONS' second, and will roll into particular "
^DIC(9.4,82,22,2,"PAH",58,1,76,0)="divisions if the user selects an 'S'."
^DIC(9.4,82,22,2,"PAH",58,1,77,0)="e.      A prompt will be added to select released, unreleased, or all "
^DIC(9.4,82,22,2,"PAH",58,1,78,0)="prescriptions."
^DIC(9.4,82,22,2,"PAH",58,1,79,0)="f.      Detailed reports will only display information from batches that "
^DIC(9.4,82,22,2,"PAH",58,1,80,0)="have ECME Rxs."
^DIC(9.4,82,22,2,"PAH",58,1,81,0)="g.      Header information will be centered. "
^DIC(9.4,82,22,2,"PAH",58,1,82,0)="5."
^DIC(9.4,82,22,2,"PAH",58,1,83,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,84,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,85,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,86,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,87,0)="This patch addresses the following New Service Request (NSR):"
^DIC(9.4,82,22,2,"PAH",58,1,88,0)="-------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",58,1,89,0)="There is no NSR associated with this patch."
^DIC(9.4,82,22,2,"PAH",58,1,90,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,91,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,92,0)="This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,82,22,2,"PAH",58,1,93,0)="----------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",58,1,94,0)="There is no Remedy Tickets associated with this patch."
^DIC(9.4,82,22,2,"PAH",58,1,95,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,96,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,97,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,98,0)="Overview of Remedy Ticket(s):"
^DIC(9.4,82,22,2,"PAH",58,1,99,0)="-----------------------------"
^DIC(9.4,82,22,2,"PAH",58,1,100,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,101,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,102,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,103,0)="Components Sent With Patch"
^DIC(9.4,82,22,2,"PAH",58,1,104,0)="--------------------------"
^DIC(9.4,82,22,2,"PAH",58,1,105,0)="The following is a list of files included in this patch:"
^DIC(9.4,82,22,2,"PAH",58,1,106,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,107,0)="                                          UP    SEND  DATA"
^DIC(9.4,82,22,2,"PAH",58,1,108,0)="                                          DATE  SEC.  COMES  SITE   RSLV"
^DIC(9.4,82,22,2,"PAH",58,1,109,0)="FILE #        NAME                        DD    CODE  W/FILE DATA   PTS"
^DIC(9.4,82,22,2,"PAH",58,1,110,0)="-----------------------------------------------------------------------"
^DIC(9.4,82,22,2,"PAH",58,1,111,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,112,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,113,0)="The following is a list of files deleted in this patch:"
^DIC(9.4,82,22,2,"PAH",58,1,114,0)=" "
^DIC(9.4,82,22,2,"PAH",58,1,115,0)="FILE #        NAME"
