^DIC(9.4,11,22,5.03,"PAH",26,1,154,0)="Enter the Device you want to print the Install messages."
^DIC(9.4,11,22,5.03,"PAH",26,1,155,0)="You can queue the install by enter a 'Q' at the device prompt."
