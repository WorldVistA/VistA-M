^DIC(9.4,4,22,1,"PAH",109,1,3,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",109,1,4,0)="Test Site:  FORUM"
^DIC(9.4,4,22,1,"PAH",109,1,5,0)="Exempt from the 'date purge' any messages in the transmit queues or the"
^DIC(9.4,4,22,1,"PAH",109,1,6,0)="server baskets."
^DIC(9.4,4,22,1,"PAH",109,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",109,1,8,0)="NOIS: BUT-0600-20499"
^DIC(9.4,4,22,1,"PAH",109,1,9,0)="Test Site:  Butler, PA"
^DIC(9.4,4,22,1,"PAH",109,1,10,0)="During the MESSAGE file integrity check, if a message subject is >65, then"
^DIC(9.4,4,22,1,"PAH",109,1,11,0)="truncate it; <3, pad it with ""...""."
^DIC(9.4,4,22,1,"PAH",109,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",109,1,13,0)="NOTE: This patch should be installed during off hours, when user activity"
