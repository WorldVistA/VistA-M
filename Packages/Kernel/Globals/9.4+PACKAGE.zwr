^DIC(9.4,11,22,5.03,"PAH",31,1,134,0)=" E3R #17914, PROVIDER CONTACT NUMBERS ON MANIFEST"
^DIC(9.4,11,22,5.03,"PAH",31,1,135,0)=" E3R #17904, LEDI BETWEEN VA AND DOD SITES"
^DIC(9.4,11,22,5.03,"PAH",31,1,136,0)=" E3R #18036, UNABLE TO PURGE SHIPPING MANIFESTS"
