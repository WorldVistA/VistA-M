^DIC(9.4,3,22,21,"PAH",296,0)="299 SEQ #307^3050525^1"
^DIC(9.4,3,22,21,"PAH",297,0)="348 SEQ #308^3050611^1"
^DIC(9.4,3,22,21,"PAH",298,0)="360 SEQ #309^3050611^1"
^DIC(9.4,3,22,21,"PAH",298,1,0)="^^2^2^3050611"
^DIC(9.4,3,22,21,"PAH",298,1,1,0)="See patch XU*8*360 in the National Patch Module on FORUM for complete"
