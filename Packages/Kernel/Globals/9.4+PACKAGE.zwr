^DIC(9.4,42,22,7,"PAH",103,1,60,0)="Post-Installation Instructions:"
^DIC(9.4,42,22,7,"PAH",103,1,61,0)="-------------------------------"
^DIC(9.4,42,22,7,"PAH",103,1,62,0)="N/A"
^DIC(9.4,42,22,7,"PAH",104,0)="98^3170726.131954^54"
^DIC(9.4,42,22,7,"PAH",105,0)="121 SEQ #110^3171127.122028^54"
^DIC(9.4,42,22,7,"PAH",105,1,0)="^^4^4^3171127"
^DIC(9.4,42,22,7,"PAH",105,1,1,0)=" Patch GMTS*2.7*121 addresses the following issue:"
^DIC(9.4,42,22,7,"PAH",105,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",105,1,3,0)=" 1.      Ad Hoc Health Summary Menu [GMTS HS ADHOC] is providing inaccurate"
^DIC(9.4,42,22,7,"PAH",105,1,4,0)="         results on the occurrence limit."
^DIC(9.4,42,22,7,"PAH",106,0)="120 SEQ #111^3171127.1346^54"
^DIC(9.4,42,22,7,"PAH",107,0)="113^3171227.135752^54"
^DIC(9.4,42,22,7,"PAH",107,1,0)="^^2^2^3171227"
^DIC(9.4,42,22,7,"PAH",107,1,1,0)="Clinical Reminders component output standardization."
^DIC(9.4,42,22,7,"PAH",107,1,2,0)=""
^DIC(9.4,42,22,7,"PAH",108,0)="94^3180925.15393^54"
^DIC(9.4,42,22,7,"PAH",109,0)="126 SEQ #114^3190401.170107^54"
^DIC(9.4,42,22,7,"PAH",109,1,0)="^^5^5^3190401"
^DIC(9.4,42,22,7,"PAH",109,1,1,0)="The Office of Spinal Cord Injury/Disorder (SCI/D) is requesting to "
^DIC(9.4,42,22,7,"PAH",109,1,2,0)="decommission the VistA Spinal Cord Dysfunction (SCD) application and "
^DIC(9.4,42,22,7,"PAH",109,1,3,0)="data. The VistA SCD application and stored data will be removed from "
^DIC(9.4,42,22,7,"PAH",109,1,4,0)="VA's inventory of applications. Therefore, all Health Summary "
^DIC(9.4,42,22,7,"PAH",109,1,5,0)="references to the SCD application will be removed."
^DIC(9.4,42,22,7,"PAH",110,0)="125 SEQ #115^3190708.164306^65"
^DIC(9.4,42,22,7,"PAH",110,1,0)="^^2^2^3190708"
^DIC(9.4,42,22,7,"PAH",110,1,1,0)="The purpose of this build is to implement two new Health Summary "
^DIC(9.4,42,22,7,"PAH",110,1,2,0)="components. Please see the patch description for a full description."
^DIC(9.4,42,22,7,"PAH",111,0)="127 SEQ #116^3190722.1658^65"
^DIC(9.4,42,22,7,"PAH",111,1,0)="^^6^6^3190722"
^DIC(9.4,42,22,7,"PAH",111,1,1,0)="This patch will resolve the following issues in the Health summary "
^DIC(9.4,42,22,7,"PAH",111,1,2,0)="package:"
^DIC(9.4,42,22,7,"PAH",111,1,3,0)=" "
^DIC(9.4,42,22,7,"PAH",111,1,4,0)="1. INC3453605 - If a user attempts to use the Health Summary component "
^DIC(9.4,42,22,7,"PAH",111,1,5,0)="Med Reconciliation (MRR1) on a patient with a quick order with the "
^DIC(9.4,42,22,7,"PAH",111,1,6,0)="quantity missing the error <SUBSCRIPT>OPTDISP+11^GMTSPST1 occurs"
^DIC(9.4,42,22,7,"PAH",112,0)="131 SEQ #117^3191113.141809^65"
^DIC(9.4,42,22,7,"PAH",112,1,0)="^^2^2^3191113"
^DIC(9.4,42,22,7,"PAH",112,1,1,0)="The Health Summary report Essential Med List for Review does not exit "
^DIC(9.4,42,22,7,"PAH",112,1,2,0)="properly when a user viewing the report enters a ""^"" to exit the report."
^DIC(9.4,42,22,7,"PAH",113,0)="129 SEQ #118^3200106.090053^65"
^DIC(9.4,42,22,7,"PAH",113,1,0)="^^3^3^3200106"
^DIC(9.4,42,22,7,"PAH",113,1,1,0)="The purpose of this patch is to support patch SOW*3.0*65 (which will "
^DIC(9.4,42,22,7,"PAH",113,1,2,0)="completely decommission the Social Work (SOW) package from VistA) and "
^DIC(9.4,42,22,7,"PAH",113,1,3,0)="remove all Social Work GMTS code and components."
^DIC(9.4,42,22,7,"PAH",114,0)="130 SEQ #119^3200211.095319^65"
^DIC(9.4,42,22,7,"PAH",114,1,0)="^^1^1^3200211"
^DIC(9.4,42,22,7,"PAH",114,1,1,0)="Please see patch description on Forum for detailed instructions."
^DIC(9.4,42,22,7,"PAH",115,0)="132 SEQ #120^3200311.112331^65"
^DIC(9.4,42,22,7,"PAH",115,1,0)="^^1^1^3200311"
^DIC(9.4,42,22,7,"PAH",115,1,1,0)="THIS PATCH ADDRESSES THE INCORRECT CALL TO THE API OEL^PSOORRL (IA 2400)."
^DIC(9.4,42,22,7,"PAH",116,0)="67^3200624.121401^65"
^DIC(9.4,42,22,7,"PAH",116,1,0)="^^3^3^3200624"
^DIC(9.4,42,22,7,"PAH",116,1,1,0)="This patch will install new national components that are released with "
^DIC(9.4,42,22,7,"PAH",116,1,2,0)="CPRS version 31 (OR*3*377). Refer to the patch description for the list "
^DIC(9.4,42,22,7,"PAH",116,1,3,0)="of components."
^DIC(9.4,42,22,7,"PAH",117,0)="135 SEQ #123^3200923.104956^65"
^DIC(9.4,42,22,7,"PAH",117,1,0)="^^1^1^3200923"
^DIC(9.4,42,22,7,"PAH",117,1,1,0)="CORRECT DOD RX'S NOT DISPLAYING ON EMLR REPORT"
^DIC(9.4,42,22,7,"PAH",118,0)="134^3201112.17522^17"
^DIC(9.4,42,22,7,"PAH",118,1,0)="^^3^3^3201112"
^DIC(9.4,42,22,7,"PAH",118,1,1,0)="This patch will install new national components that are released with "
^DIC(9.4,42,22,7,"PAH",118,1,2,0)="CPRS version 31MA (OR*3*519). Refer to the patch description for the list "
^DIC(9.4,42,22,7,"PAH",118,1,3,0)="of components."
^DIC(9.4,42,22,7,"PAH",119,0)="136b^3210504"
^DIC(9.4,42,22,7,"PAH",119,1,0)="^^5^5^3210504"
^DIC(9.4,42,22,7,"PAH",119,1,1,0)="Backup of GMTS*2.7*136 on May 04, 2021"
^DIC(9.4,42,22,7,"PAH",119,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",119,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,42,22,7,"PAH",119,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,42,22,7,"PAH",119,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,42,22,7,"PAH",120,0)="136 SEQ #125^3210504.155642^17"
^DIC(9.4,42,22,7,"PAH",120,1,0)="^^6^6^3210504"
^DIC(9.4,42,22,7,"PAH",120,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,42,22,7,"PAH",120,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",120,1,3,0)="1.  In CPRS, selecting the Reports tab> Clinical Reports> Laboratory> "
^DIC(9.4,42,22,7,"PAH",120,1,4,0)="    Blood Transfusion Report produces a report that lists units per"
^DIC(9.4,42,22,7,"PAH",120,1,5,0)="    date as one (1) less than they should be when the number of units"
^DIC(9.4,42,22,7,"PAH",120,1,6,0)="    is greater than one (1)."
^DIC(9.4,42,22,7,"PAH",121,0)="122b^3210504"
^DIC(9.4,42,22,7,"PAH",121,1,0)="^^5^5^3210504"
^DIC(9.4,42,22,7,"PAH",121,1,1,0)="Backup of PCE STANDARDIZATION 1.0, PX*1.0*211, PXRM*2.0*42, GMT"
^DIC(9.4,42,22,7,"PAH",121,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",121,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,42,22,7,"PAH",121,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,42,22,7,"PAH",121,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,42,22,7,"PAH",122,0)="122^3210504.15573^17"
^DIC(9.4,42,22,7,"PAH",122,1,0)="^^14^14^3210504"
^DIC(9.4,42,22,7,"PAH",122,1,1,0)="This patch supports PCE standardization."
^DIC(9.4,42,22,7,"PAH",122,1,2,0)=""
^DIC(9.4,42,22,7,"PAH",122,1,3,0)="To take full advantage of the PCE standardization work, changes to VistA"
^DIC(9.4,42,22,7,"PAH",122,1,4,0)="applications that use PCE data are required. These applications include"
^DIC(9.4,42,22,7,"PAH",122,1,5,0)="Clinical Reminders, Health Summary, Problem List, and Order Entry/Results"
^DIC(9.4,42,22,7,"PAH",122,1,6,0)="Reporting. To make it easier for sites, the builds for PCE (PX*1.0*211),"
^DIC(9.4,42,22,7,"PAH",122,1,7,0)="Clinical Reminders (PXRM*2.0*42), Health Summary (GMTS*2.7*122), Problem List"
^DIC(9.4,42,22,7,"PAH",122,1,8,0)="(GMPL*2.0*53), and Order Entry/Results Reporting (OR*3.0*501) are being"
^DIC(9.4,42,22,7,"PAH",122,1,9,0)="distributed in a multi-package build named PCE STANDARDIZATION 1.0."
^DIC(9.4,42,22,7,"PAH",122,1,10,0)=" "
^DIC(9.4,42,22,7,"PAH",122,1,11,0)="For detailed information and installation instructions, please see the PCE"
^DIC(9.4,42,22,7,"PAH",122,1,12,0)="Standardization 1.0 Installation Guide."
^DIC(9.4,42,22,7,"PAH",122,1,13,0)=""
^DIC(9.4,42,22,7,"PAH",122,1,14,0)=""
^DIC(9.4,42,22,7,"PAH",123,0)="142 SEQ #127^3220727.132446^86"
^DIC(9.4,42,22,7,"PAH",123,1,0)="^^6^6^3220727"
^DIC(9.4,42,22,7,"PAH",123,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,42,22,7,"PAH",123,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",123,1,3,0)="1.  In CPRS on the Reports tab when selecting Surgery Clinical reports,"
^DIC(9.4,42,22,7,"PAH",123,1,4,0)="    Surgery case statuses may display ABORTED when they are actually"
^DIC(9.4,42,22,7,"PAH",123,1,5,0)="    COMPLETED. When this occurs, the VistA Surgery package correctly"
^DIC(9.4,42,22,7,"PAH",123,1,6,0)="    displays case status."
^DIC(9.4,42,22,7,"PAH",124,0)="141^3220825.122543^86"
^DIC(9.4,42,22,7,"PAH",124,1,0)="^^2^2^3220825"
^DIC(9.4,42,22,7,"PAH",124,1,1,0)="This patch distributes a new health summary component for sexual "
^DIC(9.4,42,22,7,"PAH",124,1,2,0)="orientation. Please see the patch description for a full explanation."
^DIC(9.4,42,22,7,"PAH",125,0)="115^3221005.145507^89"
^DIC(9.4,42,22,7,"PAH",125,1,0)="^^2^2^3221005"
^DIC(9.4,42,22,7,"PAH",125,1,1,0)="Please refer to the patch description for contents and a detailed "
^DIC(9.4,42,22,7,"PAH",125,1,2,0)="description."
^DIC(9.4,42,22,7,"PAH",126,0)="138 SEQ #130^3221101.124118^90"
^DIC(9.4,42,22,7,"PAH",126,1,0)="^^6^6^3221101"
^DIC(9.4,42,22,7,"PAH",126,1,1,0)="This patch addresses the following issue(s):"
^DIC(9.4,42,22,7,"PAH",126,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",126,1,3,0)="Unverified Laboratory Microbiology results are displayed in the "
^DIC(9.4,42,22,7,"PAH",126,1,4,0)="Microbiology Ad Hoc Health Summary Report."
^DIC(9.4,42,22,7,"PAH",126,1,5,0)=" "
^DIC(9.4,42,22,7,"PAH",126,1,6,0)="See patch description on FORUM for specific details."
^DIC(9.4,42,22,7,"PAH",127,0)="144^3231026.094607^89"
^DIC(9.4,42,22,7,"PAH",127,1,0)="^^2^2^3231026"
^DIC(9.4,42,22,7,"PAH",127,1,1,0)="Refer to the patch description for an explanation of the changes included "
^DIC(9.4,42,22,7,"PAH",127,1,2,0)="in this patch."
^DIC(9.4,42,22,7,"PAH",128,0)="145^3231122.115557^89"
^DIC(9.4,42,22,7,"PAH",128,1,0)="^^12^12^3231122"
^DIC(9.4,42,22,7,"PAH",128,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,42,22,7,"PAH",128,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",128,1,3,0)="1. With the introduction of PARK functionality (CPRS 32B release), and"
^DIC(9.4,42,22,7,"PAH",128,1,4,0)="once the Park functionality is enabled, the Health Summary Type of"
^DIC(9.4,42,22,7,"PAH",128,1,5,0)="Essential Med List for Review needs to be able to display ""Active/Parked"""
^DIC(9.4,42,22,7,"PAH",128,1,6,0)="as a status. These changes in Health Summary routines, along with changes"
^DIC(9.4,42,22,7,"PAH",128,1,7,0)="in patch PSO*7.0*712, will allow the Essential Med List for Review to be"
^DIC(9.4,42,22,7,"PAH",128,1,8,0)="able to display ""Active/Parked"" when the prescription is in a Parked "
^DIC(9.4,42,22,7,"PAH",128,1,9,0)="status."
^DIC(9.4,42,22,7,"PAH",128,1,10,0)=" "
^DIC(9.4,42,22,7,"PAH",128,1,11,0)="2. INC18892605: Essential Med List, Non-VA medications instructions print"
^DIC(9.4,42,22,7,"PAH",128,1,12,0)="the old directions first and the new directions second."
^DIC(9.4,42,22,7,"PAH",129,0)="139 SEQ #133^3250407.122739^90"
^DIC(9.4,42,22,7,"PAH",129,1,0)="^^4^4^3250407"
^DIC(9.4,42,22,7,"PAH",129,1,1,0)="This patch will address the following issue:"
^DIC(9.4,42,22,7,"PAH",129,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",129,1,3,0)="Complex Non-VA med orders do not display correctly with Health Summary"
^DIC(9.4,42,22,7,"PAH",129,1,4,0)="Component MRT2."
^DIC(9.4,42,22,7,"PAH",130,0)="152 SEQ #134^3260316.124705^90"
^DIC(9.4,42,22,7,"PAH",130,1,0)="^^8^8^3260316"
^DIC(9.4,42,22,7,"PAH",130,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,42,22,7,"PAH",130,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",130,1,3,0)="1. INC39104376 - GMTS-1447 - In CPRS, the printout display does not match "
^DIC(9.4,42,22,7,"PAH",130,1,4,0)="the display in the reports tab for the MRT2 Health Summary Report."
^DIC(9.4,42,22,7,"PAH",130,1,5,0)="   Duplicates: INC38680134 "
^DIC(9.4,42,22,7,"PAH",130,1,6,0)=" "
^DIC(9.4,42,22,7,"PAH",130,1,7,0)="2. INC32167156 - GMTS-1272 - Remote Outpatient RXS on hold at Central "
^DIC(9.4,42,22,7,"PAH",130,1,8,0)="Alabama HCS not displaying on Essential Med. List for Review."
^DIC(9.4,42,22,7,"PAH",131,0)="147^3260327.111838^90"
^DIC(9.4,42,22,7,"PAH",131,1,0)="^^7^7^3260327"
^DIC(9.4,42,22,7,"PAH",131,1,1,0)="This patch addresses two issues:"
^DIC(9.4,42,22,7,"PAH",131,1,2,0)=" - A truncation issue with the Pce Immunizations [IM] component"
^DIC(9.4,42,22,7,"PAH",131,1,3,0)=" - The components for Education Topics, Exams, and Health Factors were "
^DIC(9.4,42,22,7,"PAH",131,1,4,0)="   modified to use the PROMPT CAPTION instead of the generic MAGNITUDE"
^DIC(9.4,42,22,7,"PAH",131,1,5,0)="   or MEASUREMENT label."
^DIC(9.4,42,22,7,"PAH",131,1,6,0)=" "
^DIC(9.4,42,22,7,"PAH",131,1,7,0)="Refer to the patch description for a detailed explanation."
