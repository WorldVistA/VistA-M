^DIC(9.4,60,22,13,"PAH",414,1,142,0)="Patches for this installation are combined in host file"
^DIC(9.4,60,22,13,"PAH",414,1,143,0)="IB_2_568_PRCA_PSO_BUNDLE_T1.KID"
^DIC(9.4,60,22,13,"PAH",414,1,144,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,145,0)="Installation of this host file should be coordinated among the packages"
^DIC(9.4,60,22,13,"PAH",414,1,146,0)="affected since only one installation is necessary."
^DIC(9.4,60,22,13,"PAH",414,1,147,0)=" "
^DIC(9.4,60,22,13,"PAH",414,1,148,0)="The patches are:"
^DIC(9.4,60,22,13,"PAH",414,1,149,0)=" "
