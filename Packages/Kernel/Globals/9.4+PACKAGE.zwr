^DIC(9.4,4,22,1,"PAH",101,0)="130 SEQ #126^3000626^1"
^DIC(9.4,4,22,1,"PAH",101,1,0)="^^104^104^3000626"
^DIC(9.4,4,22,1,"PAH",101,1,1,0)="Patch XM*7.1*130"
^DIC(9.4,4,22,1,"PAH",101,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,3,0)="NOIS: MON-1099-51059, HOU-0100-72381"
^DIC(9.4,4,22,1,"PAH",101,1,4,0)="Test Site: Montana HCS"
^DIC(9.4,4,22,1,"PAH",101,1,5,0)="When creating a PackMan message, and you decide to abort it while selecting"
^DIC(9.4,4,22,1,"PAH",101,1,6,0)="recipients, MailMan ignores you and continues on.  MailMan has now been"
^DIC(9.4,4,22,1,"PAH",101,1,7,0)="taught to listen better."
^DIC(9.4,4,22,1,"PAH",101,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,9,0)="E3R: 3029, 6336, 7402"
^DIC(9.4,4,22,1,"PAH",101,1,10,0)="Test Site: Bronx, NY"
^DIC(9.4,4,22,1,"PAH",101,1,11,0)="Allow anyone to forward a priority message to a mail group, if the site"
^DIC(9.4,4,22,1,"PAH",101,1,12,0)="so chooses.  A new field has been added to file 4.3, MAILMAN SITE PARAMETERS,"
^DIC(9.4,4,22,1,"PAH",101,1,13,0)="and option XMKSP, MailMan Site Parameters, has been updated to include it."
^DIC(9.4,4,22,1,"PAH",101,1,14,0)="Here's the new field:"
^DIC(9.4,4,22,1,"PAH",101,1,15,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,16,0)="STANDARD DATA DICTIONARY #4.3 -- MAILMAN SITE PARAMETERS FILE"
^DIC(9.4,4,22,1,"PAH",101,1,17,0)="STORED IN ^XMB(1,  (1 ENTRY)"
^DIC(9.4,4,22,1,"PAH",101,1,18,0)="DATA     NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",101,1,19,0)="ELEMENT  TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",101,1,20,0)="-----------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",101,1,21,0)="4.3,21   FORWARD PRIORITY MAIL TO GROUP 2;1 SET"
^DIC(9.4,4,22,1,"PAH",101,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,23,0)="                           '0' FOR NO; "
^DIC(9.4,4,22,1,"PAH",101,1,24,0)="                           '1' FOR YES; "
^DIC(9.4,4,22,1,"PAH",101,1,25,0)="         HELP-PROMPT:      Let users forward priority messages to mail"
^DIC(9.4,4,22,1,"PAH",101,1,26,0)="                           groups? "
^DIC(9.4,4,22,1,"PAH",101,1,27,0)="         DESCRIPTION:      Enter YES is you wish to allow users to forward"
^DIC(9.4,4,22,1,"PAH",101,1,28,0)="                           priority messages to mail groups.  "
^DIC(9.4,4,22,1,"PAH",101,1,29,0)="  "
^DIC(9.4,4,22,1,"PAH",101,1,30,0)="                           Enter NO if you don't.  (This is the default.) "
^DIC(9.4,4,22,1,"PAH",101,1,31,0)="                           Then only the message originator or anyone with"
^DIC(9.4,4,22,1,"PAH",101,1,32,0)="                           the XM GROUP PRIORITY key may forward priority"
^DIC(9.4,4,22,1,"PAH",101,1,33,0)="                           messages to mail groups.  "
^DIC(9.4,4,22,1,"PAH",101,1,34,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,35,0)="*Note: If you do nothing with this new field, then this patch will not"
^DIC(9.4,4,22,1,"PAH",101,1,36,0)="change MailMan's behavior with regard to the forwarding of priority messages."
^DIC(9.4,4,22,1,"PAH",101,1,37,0)="Only if you answer YES will the behavior change as described above."
^DIC(9.4,4,22,1,"PAH",101,1,38,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,39,0)="E3R: 7137"
^DIC(9.4,4,22,1,"PAH",101,1,40,0)="Test Site: Bronx, NY"
^DIC(9.4,4,22,1,"PAH",101,1,41,0)="Improve QD searches to deal with a mixture of upper and lower case."
^DIC(9.4,4,22,1,"PAH",101,1,42,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,43,0)="E3R: 7506"
^DIC(9.4,4,22,1,"PAH",101,1,44,0)="Test Site: Bronx, NY"
^DIC(9.4,4,22,1,"PAH",101,1,45,0)="Add institution and title info to Help:User Information.  Such info will"
^DIC(9.4,4,22,1,"PAH",101,1,46,0)="be displayed if it exists and if the user's and site's preferences are set"
^DIC(9.4,4,22,1,"PAH",101,1,47,0)="to display them."
^DIC(9.4,4,22,1,"PAH",101,1,48,0)=""
^DIC(9.4,4,22,1,"PAH",101,1,49,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",101,1,50,0)="is at a minimum.  It requires MailMan patches XM*7.1*110, XM*7.1*120,"
^DIC(9.4,4,22,1,"PAH",101,1,51,0)="and XM*7.1*128."
^DIC(9.4,4,22,1,"PAH",101,1,52,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",101,1,53,0)=""
