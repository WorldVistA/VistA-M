^DIC(9.4,47,22,5.9,"PAH",544,0)="719 SEQ #630^3060923^1"
^DIC(9.4,47,22,5.9,"PAH",545,0)="726 SEQ #631^3060923^1"
^DIC(9.4,47,22,5.9,"PAH",546,0)="673^3060923^1"
^DIC(9.4,47,22,5.9,"PAH",546,1,0)="^^2^2^3060923"
^DIC(9.4,47,22,5.9,"PAH",546,1,1,0)="Please refer to patch DG*5.3*673 in the National Patch Module for a "
^DIC(9.4,47,22,5.9,"PAH",546,1,2,0)="complete description of this patch."
^DIC(9.4,47,22,5.9,"PAH",547,0)="727 SEQ #633^3060923^1"
^DIC(9.4,47,22,5.9,"PAH",548,0)="696 SEQ #634^3060923.020344^1"
^DIC(9.4,47,22,5.9,"PAH",548,1,0)="^^4^4^3060923"
^DIC(9.4,47,22,5.9,"PAH",548,1,1,0)="This patch fixes a problem with the combat vet field used in screen 801"
^DIC(9.4,47,22,5.9,"PAH",548,1,2,0)="in the PTF Load/Edit option, fixes the transmission date on retransmitted"
^DIC(9.4,47,22,5.9,"PAH",548,1,3,0)="transactions, permits closing a record when the patient has a single"
^DIC(9.4,47,22,5.9,"PAH",548,1,4,0)="legal name, and refines the handling of the PTF census date file."
^DIC(9.4,47,22,5.9,"PAH",549,0)="717 SEQ #635^3061122.191739^1"
^DIC(9.4,47,22,5.9,"PAH",550,0)="720 SEQ #636^3061122.213144^1"
^DIC(9.4,47,22,5.9,"PAH",550,1,0)="^^3^3^3061122"
^DIC(9.4,47,22,5.9,"PAH",550,1,1,0)="  This patch permits deleting patient's middle name or suffix and "
^DIC(9.4,47,22,5.9,"PAH",550,1,2,0)=" the multiple birth indicator (MBI).  It also will not consider an MBI"
^DIC(9.4,47,22,5.9,"PAH",550,1,3,0)=" change as part of a possible catastrophic edit."
^DIC(9.4,47,22,5.9,"PAH",551,0)="689 SEQ #637^3061122.221452^1"
^DIC(9.4,47,22,5.9,"PAH",551,1,0)="^^2^2^3061122"
^DIC(9.4,47,22,5.9,"PAH",551,1,1,0)="Please refer to patch DG*5.3*689 in the National Patch Module for a "
^DIC(9.4,47,22,5.9,"PAH",551,1,2,0)="complete description of this patch."
^DIC(9.4,47,22,5.9,"PAH",552,0)="656 SEQ #638^3061122.222605^1"
^DIC(9.4,47,22,5.9,"PAH",552,1,0)="^^1^1^3061122"
^DIC(9.4,47,22,5.9,"PAH",552,1,1,0)="Add Field Triggers for ORU~Z07s"
^DIC(9.4,47,22,5.9,"PAH",553,0)="716 SEQ #639^3061122.22394^1"
^DIC(9.4,47,22,5.9,"PAH",553,1,0)="^^1^1^3061122"
^DIC(9.4,47,22,5.9,"PAH",553,1,1,0)="See the Patch Description in the Forum Patch Module for DG*5.3*716."
^DIC(9.4,47,22,5.9,"PAH",554,0)="708 SEQ #641^3061122.230208^1"
^DIC(9.4,47,22,5.9,"PAH",554,1,0)="^^1^1^3061122"
^DIC(9.4,47,22,5.9,"PAH",554,1,1,0)="Undefined MERGE+39 Pgm DGENUPL4"
^DIC(9.4,47,22,5.9,"PAH",555,0)="721 SEQ #642^3061122.231353^1"
^DIC(9.4,47,22,5.9,"PAH",556,0)="659^3061122.233959^1"
^DIC(9.4,47,22,5.9,"PAH",556,1,0)="^^1^1^3061122"
^DIC(9.4,47,22,5.9,"PAH",556,1,1,0)="IRR Method and Help Text Updates"
^DIC(9.4,47,22,5.9,"PAH",557,0)="728 SEQ #644^3061122.234313^1"
^DIC(9.4,47,22,5.9,"PAH",557,1,0)="^^12^12^3061122"
^DIC(9.4,47,22,5.9,"PAH",557,1,1,0)="Add ^ to file 408.31 field .23-SOURCE OF INCOME TEST and"
^DIC(9.4,47,22,5.9,"PAH",557,1,2,0)="field 2-PRIMARY INCOME TEST FOR YEAR"
^DIC(9.4,47,22,5.9,"PAH",557,1,3,0)="to maintain data integrity of the records in the Annual Means Test File"
^DIC(9.4,47,22,5.9,"PAH",557,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",557,1,5,0)="There are sites that are editing two fields using Fileman to allow"
^DIC(9.4,47,22,5.9,"PAH",557,1,6,0)="tests to be modified that should not be edited.  These fields are"
^DIC(9.4,47,22,5.9,"PAH",557,1,7,0)="PRIMARY INCOME TEST FOR YEAR (field 2) and SOURCE OF INCOME TEST"
^DIC(9.4,47,22,5.9,"PAH",557,1,8,0)="(field #.23) in the Annual Means Test file #408.31.  Some of the MT"
^DIC(9.4,47,22,5.9,"PAH",557,1,9,0)="Reverasals in IVM 2.9 are due to manual editing of these records at"
^DIC(9.4,47,22,5.9,"PAH",557,1,10,0)="the sites.  The only way to block the users from editing these"
^DIC(9.4,47,22,5.9,"PAH",557,1,11,0)="two fields is to change the data dictioanry to make the fields"
^DIC(9.4,47,22,5.9,"PAH",557,1,12,0)="un-editable."
^DIC(9.4,47,22,5.9,"PAH",558,0)="650^3061211.155625^1"
^DIC(9.4,47,22,5.9,"PAH",558,1,0)="^^2^2^3061211"
^DIC(9.4,47,22,5.9,"PAH",558,1,1,0)="Please refer to patch DG*5.3*650 in the National Patch Module for a"
