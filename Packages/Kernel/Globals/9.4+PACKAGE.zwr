^DIC(9.4,4,22,1,"PAH",99,1,114,0)="XMYPOSTC has no user callable entry points."
^DIC(9.4,4,22,1,"PAH",99,1,115,0)="XMYPRE7  has no user callable entry points."
^DIC(9.4,4,22,1,"PAH",99,1,116,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",99,1,117,0)=" "
^DIC(9.4,4,22,1,"PAH",99,1,118,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",99,1,119,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",99,1,120,0)="is at a minimum.  It requires MailMan patch XM*7.1*110."
^DIC(9.4,4,22,1,"PAH",99,1,121,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",99,1,122,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",99,1,123,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",99,1,124,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",99,1,125,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",99,1,126,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,1,"PAH",99,1,127,0)="    but you should stop the background filer."
^DIC(9.4,4,22,1,"PAH",99,1,128,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",99,1,129,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",99,1,130,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",99,1,131,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",99,1,132,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",99,1,133,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",99,1,134,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",99,1,135,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",99,1,136,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",99,1,137,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",99,1,138,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",99,1,139,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",99,1,140,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",99,1,141,0)=" Select INSTALL NAME:    XM*7.1*127     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",99,1,142,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",99,1,143,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",99,1,144,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",99,1,145,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",99,1,146,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",99,1,147,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",99,1,148,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",99,1,149,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",99,1,150,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",99,1,151,0)=""
^DIC(9.4,4,22,1,"PAH",99,1,152,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,1,"PAH",99,1,153,0)="                ------------------"
^DIC(9.4,4,22,1,"PAH",99,1,154,0)="6.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",99,1,155,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",99,1,156,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",99,1,157,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",99,1,158,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",99,1,159,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",99,1,160,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",100,0)="129 SEQ #125^3000626^1"
^DIC(9.4,4,22,1,"PAH",100,1,0)="^^57^57^3000626"
