^DIC(9.4,53,22,20,"PAH",63,1,1,0)="PRCA*4.5*117"
^DIC(9.4,53,22,20,"PAH",64,0)="124 SEQ #94^2980831^1"
^DIC(9.4,53,22,20,"PAH",64,1,0)="^^1^1^2980831"
^DIC(9.4,53,22,20,"PAH",64,1,1,0)="New IRS OFFSET LETTER 9/1/98"
^DIC(9.4,53,22,20,"PAH",65,0)="111 SEQ #95^2980831^1"
^DIC(9.4,53,22,20,"PAH",65,1,0)="^^1^1^2980831"
^DIC(9.4,53,22,20,"PAH",65,1,1,0)="Decrease adjustments to CHAMPVA bills"
^DIC(9.4,53,22,20,"PAH",66,0)="120 SEQ #96^2980831^1"
^DIC(9.4,53,22,20,"PAH",66,1,0)="^^7^7^2980831"
^DIC(9.4,53,22,20,"PAH",66,1,1,0)="Write-off documents for tort feasor were being reported under "
^DIC(9.4,53,22,20,"PAH",66,1,2,0)="transaction type 04.  It should be reported under transaction"
^DIC(9.4,53,22,20,"PAH",66,1,3,0)="type 23."
^DIC(9.4,53,22,20,"PAH",66,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",66,1,5,0)="When using the function $$CLO^PRCAFN to see when a bill has been closed "
^DIC(9.4,53,22,20,"PAH",66,1,6,0)="out, that the ""close-out"" date gets changed to the date of the"
^DIC(9.4,53,22,20,"PAH",66,1,7,0)="new transaction if an old closed-out bill has been updated."
^DIC(9.4,53,22,20,"PAH",67,0)="126 SEQ #97^2980923^1"
^DIC(9.4,53,22,20,"PAH",67,1,0)="^^1^1^2980923"
^DIC(9.4,53,22,20,"PAH",67,1,1,0)="This enhancement will exclude DMC referrals from the IRS offset process."
^DIC(9.4,53,22,20,"PAH",68,0)="118 SEQ #99^2981016^1"
^DIC(9.4,53,22,20,"PAH",68,1,0)="^^2^2^2981016"
^DIC(9.4,53,22,20,"PAH",68,1,1,0)="This patch corrects the following error when transmitting CCPC statements:"
^DIC(9.4,53,22,20,"PAH",68,1,2,0)="<UNDEF>ERROR+6^RCCPCML"
^DIC(9.4,53,22,20,"PAH",69,0)="123 SEQ #100^2981026^1"
^DIC(9.4,53,22,20,"PAH",69,1,0)="^^2^2^2981026"
^DIC(9.4,53,22,20,"PAH",69,1,1,0)="This build fixes the problem with adjustments to CHAMPVA THIRD PARTY not"
^DIC(9.4,53,22,20,"PAH",69,1,2,0)="going to FMS."
^DIC(9.4,53,22,20,"PAH",70,0)="122 SEQ #101^2981026^1"
^DIC(9.4,53,22,20,"PAH",70,1,0)="^^1^1^2981026"
^DIC(9.4,53,22,20,"PAH",70,1,1,0)="Regional Counsel transmission problems."
^DIC(9.4,53,22,20,"PAH",71,0)="119 SEQ #102^2981105^1"
^DIC(9.4,53,22,20,"PAH",71,1,0)="^^3^3^2981105"
^DIC(9.4,53,22,20,"PAH",71,1,1,0)="This patch will remove MISC vendor codes from the FMS Billing Documents"
^DIC(9.4,53,22,20,"PAH",71,1,2,0)="(BDs).  They will be replaced by either a vendor ID or a newly defined"
^DIC(9.4,53,22,20,"PAH",71,1,3,0)="generic vendor ID, depending on the type of bill."
^DIC(9.4,53,22,20,"PAH",72,0)="116 SEQ #104^2981119^1"
^DIC(9.4,53,22,20,"PAH",72,1,0)="^^1^1^2981119"
^DIC(9.4,53,22,20,"PAH",72,1,1,0)="CCPC transmission problem and added disclaimer"
^DIC(9.4,53,22,20,"PAH",73,0)="131 SEQ #105^2981229^1"
^DIC(9.4,53,22,20,"PAH",73,1,0)="^^1^1^2981229"
^DIC(9.4,53,22,20,"PAH",73,1,1,0)="CHAMPUS THIRD PARTY DECREASES"
^DIC(9.4,53,22,20,"PAH",74,0)="108 SEQ #98^2981230^1"
^DIC(9.4,53,22,20,"PAH",74,1,0)="^^1^1^2981230"
^DIC(9.4,53,22,20,"PAH",74,1,1,0)="Patch for DMC functionality"
^DIC(9.4,53,22,20,"PAH",75,0)="135 SEQ #107^2990201^1"
^DIC(9.4,53,22,20,"PAH",75,1,0)="^^5^5^2990201"
^DIC(9.4,53,22,20,"PAH",75,1,1,0)="This patch will change the fiscal year on the WR and SV documents"
^DIC(9.4,53,22,20,"PAH",75,1,2,0)="generated by the AR Data Collector on October 1 of each year."
^DIC(9.4,53,22,20,"PAH",75,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",75,1,4,0)="It will also change the default fund of 0160A1 displayed on the"
^DIC(9.4,53,22,20,"PAH",75,1,5,0)="215 report to the fund the user enters during the audit process."
^DIC(9.4,53,22,20,"PAH",76,0)="133 SEQ #108^2990210^1"
^DIC(9.4,53,22,20,"PAH",76,1,0)="^^3^3^2990210"
^DIC(9.4,53,22,20,"PAH",76,1,1,0)="This build addresses two separate problems."
^DIC(9.4,53,22,20,"PAH",76,1,2,0)="1. DMC transmissions missing state."
^DIC(9.4,53,22,20,"PAH",76,1,3,0)="2. CCPC transmission message exceeding 32 k in size."
^DIC(9.4,53,22,20,"PAH",77,0)="137 SEQ #109^2990303^1"
^DIC(9.4,53,22,20,"PAH",77,1,0)="^^3^3^2990303"
^DIC(9.4,53,22,20,"PAH",77,1,1,0)="This build will cause a warning message to appear when the user is"
^DIC(9.4,53,22,20,"PAH",77,1,2,0)="entering a payment on a receipt and the payment amount is greater than the"
^DIC(9.4,53,22,20,"PAH",77,1,3,0)="outstanding balance on a bill."
^DIC(9.4,53,22,20,"PAH",78,0)="109 SEQ #110^2990417^1"
^DIC(9.4,53,22,20,"PAH",78,1,0)="^^6^6^2990417"
^DIC(9.4,53,22,20,"PAH",78,1,1,0)="(AR) package: when a user views a 1081 vendor bill with multiple"
^DIC(9.4,53,22,20,"PAH",78,1,2,0)="items via the Display Pending Bill [PRCA BIL PRNT] option,"
^DIC(9.4,53,22,20,"PAH",78,1,3,0)="the date for each item doesn't show, and instead of showing"
^DIC(9.4,53,22,20,"PAH",78,1,4,0)="the total amount for each item, the total amount of the bill"
^DIC(9.4,53,22,20,"PAH",78,1,5,0)="is displayed for each item."
^DIC(9.4,53,22,20,"PAH",78,1,6,0)=" "
^DIC(9.4,53,22,20,"PAH",79,0)="127 SEQ #111^2990417^1"
^DIC(9.4,53,22,20,"PAH",79,1,0)="^^1^1^2990417"
^DIC(9.4,53,22,20,"PAH",79,1,1,0)="Payments in full on bills referred to Regional Counsel."
^DIC(9.4,53,22,20,"PAH",80,0)="125 SEQ #112^2990417^1"
^DIC(9.4,53,22,20,"PAH",80,1,0)="^^22^22^2990417"
^DIC(9.4,53,22,20,"PAH",80,1,1,0)="This patch fixes the following two problems:"
^DIC(9.4,53,22,20,"PAH",80,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",80,1,3,0)=" I. TYPO IN BILL COMMENT LOG MENU"
^DIC(9.4,53,22,20,"PAH",80,1,4,0)="    A. NOIS: WPB-0798-3028"
^DIC(9.4,53,22,20,"PAH",80,1,5,0)="    B. OPTION: Bill Comment Log [PRCA BILL COMMENT]"
^DIC(9.4,53,22,20,"PAH",80,1,6,0)="    C. ROUTINE: PRCAM"
^DIC(9.4,53,22,20,"PAH",80,1,7,0)="    D. DESCRIPTION/RESOLUTION"
^DIC(9.4,53,22,20,"PAH",80,1,8,0)="       1.  The word 'BREIF' has been changed to 'BRIEF'"
^DIC(9.4,53,22,20,"PAH",80,1,9,0)="       2.  Are you SURE this BREIF COMMENT should appear on the patient"
^DIC(9.4,53,22,20,"PAH",80,1,10,0)="           statement? NO// "
^DIC(9.4,53,22,20,"PAH",80,1,11,0)=" "
^DIC(9.4,53,22,20,"PAH",80,1,12,0)="II. AR PRINT PROFILE GENERATES AN ERROR"
^DIC(9.4,53,22,20,"PAH",80,1,13,0)="    A. NOIS: BIG-1298-7023 / STX-1098-70478"
^DIC(9.4,53,22,20,"PAH",80,1,14,0)="    B. OPTION: Profile of Accounts Receivable [PRCAC PROFILE]"
^DIC(9.4,53,22,20,"PAH",80,1,15,0)="    C. ROUTINE: PRCAPRO"
^DIC(9.4,53,22,20,"PAH",80,1,16,0)="    D. DESCRIPTION/RESOLUTION"
^DIC(9.4,53,22,20,"PAH",80,1,17,0)="       1.  Users reported errors when printing from Profiles of Account"
^DIC(9.4,53,22,20,"PAH",80,1,18,0)="           Receivables after the instillation of PRCA*4.5*108. This occurs"
^DIC(9.4,53,22,20,"PAH",80,1,19,0)="           only when the reports are queued."
^DIC(9.4,53,22,20,"PAH",80,1,20,0)="       2.  The variable PRCABN is not defined when the report is "
^DIC(9.4,53,22,20,"PAH",80,1,21,0)="           queued to print. This UNDEF occurs in routine PRCADR2."
^DIC(9.4,53,22,20,"PAH",80,1,22,0)="           The variable PRCABN has been added to the ZTSAVE array."
^DIC(9.4,53,22,20,"PAH",81,0)="134 SEQ #113^2990417^1"
^DIC(9.4,53,22,20,"PAH",81,1,0)="^^4^4^2990417"
^DIC(9.4,53,22,20,"PAH",81,1,1,0)=" This patch corrects a problem with AR Transaction Listing Report [PRCA"
^DIC(9.4,53,22,20,"PAH",81,1,2,0)=" REPT AR TRANSACTION LIST] option where 'terminated by fiscal office',"
^DIC(9.4,53,22,20,"PAH",81,1,3,0)=" 'terminate by compromise' and 'waived in full' types of transactions were"
^DIC(9.4,53,22,20,"PAH",81,1,4,0)=" showing the wrong amounts."
^DIC(9.4,53,22,20,"PAH",82,0)="139 SEQ #114^2990417^1"
^DIC(9.4,53,22,20,"PAH",82,1,0)="^^6^6^2990417"
^DIC(9.4,53,22,20,"PAH",82,1,1,0)="This patch will add a new mail group that will receive the electronic"
^DIC(9.4,53,22,20,"PAH",82,1,2,0)="reports generated by the AR Data Collector."
^DIC(9.4,53,22,20,"PAH",82,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",82,1,4,0)="This patch will also change the logic in the Bad Debt Report to roll"
^DIC(9.4,53,22,20,"PAH",82,1,5,0)="over the totals from the prior fiscal year instead of resetting the"
^DIC(9.4,53,22,20,"PAH",82,1,6,0)="values to 0 at the start of each fiscal year."
^DIC(9.4,53,22,20,"PAH",83,0)="136 SEQ #115^2990510^1"
^DIC(9.4,53,22,20,"PAH",83,1,0)="^^7^7^2990510"
^DIC(9.4,53,22,20,"PAH",83,1,1,0)="This BUILD corrects a problem with the revenue source code for CHAMPUS"
^DIC(9.4,53,22,20,"PAH",83,1,2,0)="PATIENT, CHAMPUS THIRD PARTY and CHAMPUS bills. With these changes, the"
^DIC(9.4,53,22,20,"PAH",83,1,3,0)="revenue source code will be set correctly for inpatient, outpatient and"
^DIC(9.4,53,22,20,"PAH",83,1,4,0)="other CHAMPUS bills."
^DIC(9.4,53,22,20,"PAH",83,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",83,1,6,0)="This BUILD also changes the data dictionary for the FISCAL YEAR field in"
^DIC(9.4,53,22,20,"PAH",83,1,7,0)="file 433."
^DIC(9.4,53,22,20,"PAH",84,0)="102 SEQ #116^2990510^1"
^DIC(9.4,53,22,20,"PAH",84,1,0)="^^1^1^2990510"
^DIC(9.4,53,22,20,"PAH",84,1,1,0)="RECEIVABLE CODES PROMPT IS SUPPOSED TO APPEAR ON 1080/1081 BILLS ONLY"
^DIC(9.4,53,22,20,"PAH",85,0)="143 SEQ #117^2990622^1"
^DIC(9.4,53,22,20,"PAH",85,1,0)="^^7^7^2990622"
^DIC(9.4,53,22,20,"PAH",85,1,1,0)="Fixes the following:"
^DIC(9.4,53,22,20,"PAH",85,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",85,1,3,0)="1. Account forwarded to DMC display in Account Profile."
^DIC(9.4,53,22,20,"PAH",85,1,4,0)="2. Status Listing for Bills option showing bills referred to regional"
^DIC(9.4,53,22,20,"PAH",85,1,5,0)="counsel on all statuses."
^DIC(9.4,53,22,20,"PAH",85,1,6,0)="3. When auditing a bill and bill is rejected for the FMS Vendor ID,"
^DIC(9.4,53,22,20,"PAH",85,1,7,0)="following bill will display same error."
^DIC(9.4,53,22,20,"PAH",86,0)="130 SEQ #118^2990622^1"
^DIC(9.4,53,22,20,"PAH",86,1,0)="^^1^1^2990622"
^DIC(9.4,53,22,20,"PAH",86,1,1,0)="Patch PRCA*4.5*130- Interest and Administration Charges Enhancement"
^DIC(9.4,53,22,20,"PAH",87,0)="140 SEQ #119^2990622^1"
^DIC(9.4,53,22,20,"PAH",87,1,0)="^^2^2^2990622"
^DIC(9.4,53,22,20,"PAH",87,1,1,0)="This build contains the changes to include the DFN in the CCPC"
^DIC(9.4,53,22,20,"PAH",87,1,2,0)="transmission."
^DIC(9.4,53,22,20,"PAH",88,0)="142 SEQ #120^2990622^1"
^DIC(9.4,53,22,20,"PAH",88,1,0)="^^1^1^2990622"
^DIC(9.4,53,22,20,"PAH",88,1,1,0)="This build corrects several Y2K problems reported during testing."
^DIC(9.4,53,22,20,"PAH",89,0)="98 SEQ #121^2990719^1"
^DIC(9.4,53,22,20,"PAH",89,1,0)="^^2^2^2990719"
^DIC(9.4,53,22,20,"PAH",89,1,1,0)="Add the vendor id MCCFVALUE to the CR, SV, and WR documents sent to"
^DIC(9.4,53,22,20,"PAH",89,1,2,0)="FMS."
^DIC(9.4,53,22,20,"PAH",90,0)="145 SEQ #122^2990803^1"
^DIC(9.4,53,22,20,"PAH",90,1,0)="^^3^3^2990803"
^DIC(9.4,53,22,20,"PAH",90,1,1,0)="This patch will correct the problem with building the IRS pre-offset"
^DIC(9.4,53,22,20,"PAH",90,1,2,0)="code sheets."
^DIC(9.4,53,22,20,"PAH",90,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",91,0)="144 SEQ #123^2990914^1"
^DIC(9.4,53,22,20,"PAH",91,1,0)="^^12^12^2990914"
^DIC(9.4,53,22,20,"PAH",91,1,1,0)="This build contains changes to RCAMINS1 for NOIS MEM-0699-71134 and PRCAFN"
^DIC(9.4,53,22,20,"PAH",91,1,2,0)="for NOIS RIC-0299-21543. It also updated the data dictionary for the"
^DIC(9.4,53,22,20,"PAH",91,1,3,0)="following fields:"
^DIC(9.4,53,22,20,"PAH",91,1,4,0)="   ORIGINAL AMOUNT (#3) in the ACCOUNTS RECEIVABLE file (#430)"
^DIC(9.4,53,22,20,"PAH",91,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",91,1,6,0)="   FY ORIGINAL AMOUNT (#430.01,7) in the ACCOUNTS RECEIVABLE fle (#430)"
^DIC(9.4,53,22,20,"PAH",91,1,7,0)=" "
^DIC(9.4,53,22,20,"PAH",91,1,8,0)="   BILL NUMBER (#.03) in the AR TRANSACTIONS file (#433)"
^DIC(9.4,53,22,20,"PAH",91,1,9,0)=" "
^DIC(9.4,53,22,20,"PAH",91,1,10,0)="   PATIENT NAME OR BILL NUMBER (#.09) in the TRANSACTION multiple of the"
^DIC(9.4,53,22,20,"PAH",91,1,11,0)=" "
^DIC(9.4,53,22,20,"PAH",91,1,12,0)="   AR BATCH PAYMENT file (#344)"
^DIC(9.4,53,22,20,"PAH",92,0)="103 SEQ #124^2990914^1"
^DIC(9.4,53,22,20,"PAH",92,1,0)="^^1^1^2990914"
^DIC(9.4,53,22,20,"PAH",92,1,1,0)="This patch merges the OIG extract with the AR Data Collector."
^DIC(9.4,53,22,20,"PAH",93,0)="121 SEQ #125^2990914^1"
^DIC(9.4,53,22,20,"PAH",93,1,0)="^^32^32^2990914"
^DIC(9.4,53,22,20,"PAH",93,1,1,0)="Patch install must be coordinated with changes to DMC/AAC databases."
^DIC(9.4,53,22,20,"PAH",93,1,2,0)="Change will extend the length of field separator called HOSPITAL ID on"
^DIC(9.4,53,22,20,"PAH",93,1,3,0)="monthly transmission from 6 characters to 10 characters.  (The DMC field"
^DIC(9.4,53,22,20,"PAH",93,1,4,0)="called HOSPITAL ID = ien of VistA's AR DEBTOR file [#340].)"
^DIC(9.4,53,22,20,"PAH",93,1,5,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,6,0)="Second fix is made to correct undefined error that can occur during the"
^DIC(9.4,53,22,20,"PAH",93,1,7,0)="building of the weekly transmission message.  See line UPDATE+2 in routine"
^DIC(9.4,53,22,20,"PAH",93,1,8,0)="RCDMC90."
^DIC(9.4,53,22,20,"PAH",93,1,9,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,10,0)="Third fix is to no longer exclude bills where the patient has active  "
^DIC(9.4,53,22,20,"PAH",93,1,11,0)="insurance on the day that the receivable was created."
^DIC(9.4,53,22,20,"PAH",93,1,12,0)="See line PROC(DEBTOR,QUIT)+37 in routine RCDMC90."
^DIC(9.4,53,22,20,"PAH",93,1,13,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,14,0)="Fourth fix in routine RCDMC90 is an extrinsic function to check whether"
^DIC(9.4,53,22,20,"PAH",93,1,15,0)="the debtor's address is unknown or invalid.  Based off of this check, an"
^DIC(9.4,53,22,20,"PAH",93,1,16,0)="error message is created indicating if the account was referred on the"
^DIC(9.4,53,22,20,"PAH",93,1,17,0)="Monthly or Weekly updates to DMC. A zero balance is sent to DMC if the"
^DIC(9.4,53,22,20,"PAH",93,1,18,0)="Weekly update was created. See line TOTAL+8."
^DIC(9.4,53,22,20,"PAH",93,1,19,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,20,0)="Fifth fix in routine RCDMC90 is to check the validity of the phone number"
^DIC(9.4,53,22,20,"PAH",93,1,21,0)="and to correct the phone number if it contains anything other than 7 or 10"
^DIC(9.4,53,22,20,"PAH",93,1,22,0)="numeric. See line TOTAL+17."
^DIC(9.4,53,22,20,"PAH",93,1,23,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,24,0)="Routine RCDMC90S: beginning in PROC+8, added extrinsic function to check the "
^DIC(9.4,53,22,20,"PAH",93,1,25,0)="validity of the debtor and code to generate an error MailMan message."
^DIC(9.4,53,22,20,"PAH",93,1,26,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,27,0)="Routine RCDMC90U: At COMPILE+32, added a conditional quit in the FOR"
^DIC(9.4,53,22,20,"PAH",93,1,28,0)="loop to ensure a proper end of file encounter."
^DIC(9.4,53,22,20,"PAH",93,1,29,0)=""
^DIC(9.4,53,22,20,"PAH",93,1,30,0)="Second change to RCDMC90U: Added ERROR subroutine section to generate a"
^DIC(9.4,53,22,20,"PAH",93,1,31,0)="MailMan message that is called from routine RCDMC90 fourth fix."
^DIC(9.4,53,22,20,"PAH",93,1,32,0)=""
^DIC(9.4,53,22,20,"PAH",94,0)="78 SEQ #126^2991002^1"
^DIC(9.4,53,22,20,"PAH",94,1,0)="^^1^1^2991002"
^DIC(9.4,53,22,20,"PAH",94,1,1,0)="This is a maintenance patch resolving several AR NOIS entries."
^DIC(9.4,53,22,20,"PAH",95,0)="88 SEQ #127^2991019^1"
^DIC(9.4,53,22,20,"PAH",95,1,0)="^^6^6^2991019"
^DIC(9.4,53,22,20,"PAH",95,1,1,0)="AR cleanup of pointers to file 442."
^DIC(9.4,53,22,20,"PAH",95,1,2,0)="This patch will clean up the data in the PAT REF # subfield of the"
^DIC(9.4,53,22,20,"PAH",95,1,3,0)="FISCAL YEAR fields of files 430 Accounts Receivable and 433 AR Trans-"
^DIC(9.4,53,22,20,"PAH",95,1,4,0)="action. It will also clean up the PAT REF # cross references."
^DIC(9.4,53,22,20,"PAH",95,1,5,0)="The patch will queue the job in the background and will"
^DIC(9.4,53,22,20,"PAH",95,1,6,0)="send the patch installer a message when the job has run to completion."
^DIC(9.4,53,22,20,"PAH",96,0)="107 SEQ #128^2991019^1"
^DIC(9.4,53,22,20,"PAH",96,1,0)="^^25^25^2991019"
^DIC(9.4,53,22,20,"PAH",96,1,1,0)="This patch addresses several NOIS messages."
^DIC(9.4,53,22,20,"PAH",96,1,2,0)="  "
^DIC(9.4,53,22,20,"PAH",96,1,3,0)=" 1. RC Possible Referral Listing [PRCAL REFER DC] option with patch can"
^DIC(9.4,53,22,20,"PAH",96,1,4,0)="now"
^DIC(9.4,53,22,20,"PAH",96,1,5,0)=" be queued through TASKMAN if the option has the SCHEDULING RECOMMENDED"
^DIC(9.4,53,22,20,"PAH",96,1,6,0)=" field set in the option."
^DIC(9.4,53,22,20,"PAH",96,1,7,0)=" NOIS MWV-1098-20422"
^DIC(9.4,53,22,20,"PAH",96,1,8,0)="  "
^DIC(9.4,53,22,20,"PAH",96,1,9,0)=" 2. The List of Patients with ADDRESS UKNOWN [RCAM ADDRESS UNKNOWN] option"
^DIC(9.4,53,22,20,"PAH",96,1,10,0)=" will have the mispelling of UNKNOWN corrected. "
^DIC(9.4,53,22,20,"PAH",96,1,11,0)=" NOIS COS-0499-43134"
^DIC(9.4,53,22,20,"PAH",96,1,12,0)="  "
^DIC(9.4,53,22,20,"PAH",96,1,13,0)=" 3. The loop in option Audit an Electronic Bill [PRCAA AUDIT] will not"
^DIC(9.4,53,22,20,"PAH",96,1,14,0)="exit"
^DIC(9.4,53,22,20,"PAH",96,1,15,0)=" when an error is encountered due to FMS accounting elements or VENDOR ID"
^DIC(9.4,53,22,20,"PAH",96,1,16,0)=" missing. Instead, the loop through the bills will continue."
^DIC(9.4,53,22,20,"PAH",96,1,17,0)=" NOIS WPB-1198-31810"
^DIC(9.4,53,22,20,"PAH",96,1,18,0)="  "
^DIC(9.4,53,22,20,"PAH",96,1,19,0)=" 4. The OBR report will not error with an UNDEF at BUILDRPT^RCFMOBR2 when"
^DIC(9.4,53,22,20,"PAH",96,1,20,0)=" looking for the Institution file entry for the site."
^DIC(9.4,53,22,20,"PAH",96,1,21,0)=" MAR-0599-22714"
^DIC(9.4,53,22,20,"PAH",96,1,22,0)=" "
^DIC(9.4,53,22,20,"PAH",96,1,23,0)=" 5. The TRANSACTION PROFILE [PRCAC TRANS PROFILE] will show the correct"
^DIC(9.4,53,22,20,"PAH",96,1,24,0)="person in the PROCESSED BY field."
^DIC(9.4,53,22,20,"PAH",96,1,25,0)=" GNH-0598-40732"
^DIC(9.4,53,22,20,"PAH",97,0)="114 SEQ #129^2991019^1"
^DIC(9.4,53,22,20,"PAH",97,1,0)="^^2^2^2991019"
^DIC(9.4,53,22,20,"PAH",97,1,1,0)="This patch contains functionality for the lockbox and the new"
^DIC(9.4,53,22,20,"PAH",97,1,2,0)="deposit/payment processing projects."
^DIC(9.4,53,22,20,"PAH",98,0)="132 SEQ #130^2991210^1"
^DIC(9.4,53,22,20,"PAH",98,1,0)="^^1^1^2991210"
^DIC(9.4,53,22,20,"PAH",98,1,1,0)="Patch to link AR debtor file (#340) with Patient Merge software."
^DIC(9.4,53,22,20,"PAH",99,0)="147 SEQ #131^2991210^1"
^DIC(9.4,53,22,20,"PAH",99,1,0)="^^4^4^2991210"
^DIC(9.4,53,22,20,"PAH",99,1,1,0)="This KIDS build addresses NOIS MUR-0699-32403 REGIONAL COUNSEL SERVER"
^DIC(9.4,53,22,20,"PAH",99,1,2,0)="PROBLEMS. It also addresses a problem with the date for the IRS code"
^DIC(9.4,53,22,20,"PAH",99,1,3,0)="sheets identified in Y2K testing. It also addresses a problem with the"
^DIC(9.4,53,22,20,"PAH",99,1,4,0)="control point in the Set Up Old Bills option."
^DIC(9.4,53,22,20,"PAH",100,0)="148 SEQ #132^2991210^1"
^DIC(9.4,53,22,20,"PAH",100,1,0)="^^1^1^2991210"
^DIC(9.4,53,22,20,"PAH",100,1,1,0)="This patch is a follow up patch to the lockbox patch 114."
^DIC(9.4,53,22,20,"PAH",101,0)="150 SEQ #133^3000306^1"
^DIC(9.4,53,22,20,"PAH",101,1,0)="^^2^2^3000306"
^DIC(9.4,53,22,20,"PAH",101,1,1,0)="This patch fixes the problem with the lockbox automatic processing"
^DIC(9.4,53,22,20,"PAH",101,1,2,0)="generating a checksum error if the sequences are received out of order."
^DIC(9.4,53,22,20,"PAH",102,0)="149 SEQ #134^3000405^1"
^DIC(9.4,53,22,20,"PAH",102,1,0)="^^2^2^3000405"
^DIC(9.4,53,22,20,"PAH",102,1,1,0)="This build addresses several NOIS entries in patch PRCA*4.5*149. For more"
^DIC(9.4,53,22,20,"PAH",102,1,2,0)="information please see NPM."
^DIC(9.4,53,22,20,"PAH",103,0)="152 SEQ #135^3000417^1"
^DIC(9.4,53,22,20,"PAH",103,1,0)="^^1^1^3000417"
^DIC(9.4,53,22,20,"PAH",103,1,1,0)="Patient accounts under $25 and over 180 days old."
^DIC(9.4,53,22,20,"PAH",104,0)="155 SEQ #136^3000711^1"
^DIC(9.4,53,22,20,"PAH",104,1,0)="^^2^2^3000711"
^DIC(9.4,53,22,20,"PAH",104,1,1,0)="Patch for transmitting TOP 'close-out' documents to close out IRS records"
^DIC(9.4,53,22,20,"PAH",104,1,2,0)="sent to TOP."
^DIC(9.4,53,22,20,"PAH",105,0)="154 SEQ #137^3000711^1"
^DIC(9.4,53,22,20,"PAH",105,1,0)="^^1^1^3000711"
^DIC(9.4,53,22,20,"PAH",105,1,1,0)="Test version - 6/19/2000"
^DIC(9.4,53,22,20,"PAH",106,0)="158 SEQ #138^3000816^1"
^DIC(9.4,53,22,20,"PAH",106,1,0)="^^3^3^3000816"
^DIC(9.4,53,22,20,"PAH",106,1,1,0)="This patch corrects a problem with assigning billing numbers.  It"
^DIC(9.4,53,22,20,"PAH",106,1,2,0)="also removes an option in conjunction with the removal of the IRS"
^DIC(9.4,53,22,20,"PAH",106,1,3,0)="code sheets in patch PRCA*4.5*155."
^DIC(9.4,53,22,20,"PAH",107,0)="153 SEQ #139^3000824^1"
^DIC(9.4,53,22,20,"PAH",107,1,0)="^^3^3^3000824"
^DIC(9.4,53,22,20,"PAH",107,1,1,0)="This patch changes the logic used to add and exempt interest,"
^DIC(9.4,53,22,20,"PAH",107,1,2,0)="admin, and penalty charges.  It corrects problems with the"
^DIC(9.4,53,22,20,"PAH",107,1,3,0)="payment posting module."
^DIC(9.4,53,22,20,"PAH",108,0)="156 SEQ #140^3001004^1"
^DIC(9.4,53,22,20,"PAH",108,1,0)="^^2^2^3001004"
^DIC(9.4,53,22,20,"PAH",108,1,1,0)="This patch will send Interest, Administrative, Marshal Fee, and"
^DIC(9.4,53,22,20,"PAH",108,1,2,0)="Court Cost Charges to FMS on the SV and WR documents."
^DIC(9.4,53,22,20,"PAH",109,0)="157 SEQ #141^3001004^1"
^DIC(9.4,53,22,20,"PAH",109,1,0)="^^5^5^3001004"
^DIC(9.4,53,22,20,"PAH",109,1,1,0)="This patch changes the fund for ineligible hospital bills.  If"
^DIC(9.4,53,22,20,"PAH",109,1,2,0)="an ineligible bill is created before Oct 1, 1992 or after"
^DIC(9.4,53,22,20,"PAH",109,1,3,0)="Sep 30, 2000, the ineligible bill will be recorded in fund 3220."
^DIC(9.4,53,22,20,"PAH",109,1,4,0)="Otherwise, it will be treated as a non-accrued bill and recorded"
^DIC(9.4,53,22,20,"PAH",109,1,5,0)="in fund 5287."
^DIC(9.4,53,22,20,"PAH",110,0)="160 SEQ #142^3001004^1"
^DIC(9.4,53,22,20,"PAH",110,1,0)="^^1^1^3001004"
^DIC(9.4,53,22,20,"PAH",110,1,1,0)="CCPC patient statement problems and amount of deposit field in 344.1 fixes"
^DIC(9.4,53,22,20,"PAH",111,0)="162 SEQ #143^3001106^1"
^DIC(9.4,53,22,20,"PAH",111,1,0)="^^1^1^3001106"
^DIC(9.4,53,22,20,"PAH",111,1,1,0)="This patch will correct problems with patient account discrepancies."
^DIC(9.4,53,22,20,"PAH",112,0)="164 SEQ #144^3010103^1"
^DIC(9.4,53,22,20,"PAH",112,1,0)="^^2^2^3010103"
^DIC(9.4,53,22,20,"PAH",112,1,1,0)="This patch will remove the duplicated posting of deposit 269296"
^DIC(9.4,53,22,20,"PAH",112,1,2,0)="made on November 14, 2000."
^DIC(9.4,53,22,20,"PAH",113,0)="163 SEQ #145^3010103^1"
^DIC(9.4,53,22,20,"PAH",113,1,0)="^^1^1^3010103"
^DIC(9.4,53,22,20,"PAH",113,1,1,0)="Patch to screen out Pseudo-SSN's from being referred to DMC."
^DIC(9.4,53,22,20,"PAH",114,0)="166 SEQ #146^3010103^1"
^DIC(9.4,53,22,20,"PAH",114,1,0)="^^2^2^3010103"
^DIC(9.4,53,22,20,"PAH",114,1,1,0)="Patch to stop interest and admin for sites whose statements were delayed"
^DIC(9.4,53,22,20,"PAH",114,1,2,0)="by the duplicate lockbox receipt problem."
^DIC(9.4,53,22,20,"PAH",115,0)="141 SEQ #147^3010202^1"
^DIC(9.4,53,22,20,"PAH",115,1,0)="^^1^1^3010202"
^DIC(9.4,53,22,20,"PAH",115,1,1,0)="TOP (Treasury Offset Program) Referral:  Patch PRCA*4.5*141"
^DIC(9.4,53,22,20,"PAH",116,0)="165 SEQ #148^3010202^1"
^DIC(9.4,53,22,20,"PAH",116,1,0)="^^1^1^3010202"
^DIC(9.4,53,22,20,"PAH",116,1,1,0)="This build is for various NOISes corrected by PRCA*4.5*165"
^DIC(9.4,53,22,20,"PAH",117,0)="151 SEQ #149^3010228^1"
^DIC(9.4,53,22,20,"PAH",117,1,0)="^^3^3^3010228"
^DIC(9.4,53,22,20,"PAH",117,1,1,0)="This build introduces the CLAIMS MATCHING REPORT which lists third party"
^DIC(9.4,53,22,20,"PAH",117,1,2,0)="bills for a specified date range or single bill with the matching first"
^DIC(9.4,53,22,20,"PAH",117,1,3,0)="party debts."
^DIC(9.4,53,22,20,"PAH",118,0)="168 SEQ #150^3010228^1"
^DIC(9.4,53,22,20,"PAH",118,1,0)="^^2^2^3010228"
^DIC(9.4,53,22,20,"PAH",118,1,1,0)="This patch will fix a problem with the way write offs store the"
^DIC(9.4,53,22,20,"PAH",118,1,2,0)="interest and admin charges written off."
^DIC(9.4,53,22,20,"PAH",119,0)="167 SEQ #151^3010517^1"
^DIC(9.4,53,22,20,"PAH",119,1,0)="^^3^3^3010517"
^DIC(9.4,53,22,20,"PAH",119,1,1,0)="This is the KIDS distribution for patch PRCA*4.5*167, Diagnostic "
^DIC(9.4,53,22,20,"PAH",119,1,2,0)="Measures Phase IV. This is an accompanying patch. The main patch"
^DIC(9.4,53,22,20,"PAH",119,1,3,0)="for this project is IB*2.0*123 (Integrated Billing)."
^DIC(9.4,53,22,20,"PAH",120,0)="169 SEQ #152^3010529^1"
^DIC(9.4,53,22,20,"PAH",120,1,0)="^^2^2^3010529"
^DIC(9.4,53,22,20,"PAH",120,1,1,0)="This patch will fix account discrepancies caused by the wrong"
^DIC(9.4,53,22,20,"PAH",120,1,2,0)="date being used on exemption transactions."
^DIC(9.4,53,22,20,"PAH",121,0)="171 SEQ #153^3010926^1"
^DIC(9.4,53,22,20,"PAH",121,1,0)="^^3^3^3010926"
^DIC(9.4,53,22,20,"PAH",121,1,1,0)="This is the KIDS distribution for patch PRCA*4.5*171, Diagnostic Measures"
^DIC(9.4,53,22,20,"PAH",121,1,2,0)="Updates. This is an accompanying patch. The main patch for this release is"
^DIC(9.4,53,22,20,"PAH",121,1,3,0)="IB*2.0*159 (Integrated Billing)."
^DIC(9.4,53,22,20,"PAH",122,0)="172 SEQ #154^3011121^1"
^DIC(9.4,53,22,20,"PAH",122,1,0)="^^1^1^3011121"
^DIC(9.4,53,22,20,"PAH",122,1,1,0)="This patch will fix several discrepancies within the AR package."
^DIC(9.4,53,22,20,"PAH",123,0)="170 SEQ #155^3011210^1"
^DIC(9.4,53,22,20,"PAH",123,1,0)="^^2^2^3011210"
^DIC(9.4,53,22,20,"PAH",123,1,1,0)="This patch contains functionality to implement the HSIF Fund for"
^DIC(9.4,53,22,20,"PAH",123,1,2,0)="the Millenium Bill."
^DIC(9.4,53,22,20,"PAH",124,0)="174 SEQ #156^3020315^1"
^DIC(9.4,53,22,20,"PAH",124,1,0)="^^10^10^3020315"
^DIC(9.4,53,22,20,"PAH",124,1,1,0)="This patch fixes the problem with the AR Data Collections Report and FMS"
^DIC(9.4,53,22,20,"PAH",124,1,2,0)="rejecting the data due to a negative value being sent by the HSIFVALUE."
^DIC(9.4,53,22,20,"PAH",124,1,3,0)="This is due to old bills being included in the calculation of the report. "
^DIC(9.4,53,22,20,"PAH",124,1,4,0)="This patch fix, ignores the old bills and they are not included in the"
^DIC(9.4,53,22,20,"PAH",124,1,5,0)="calculations, avoiding the negative balance in HSIFVALUE."
^DIC(9.4,53,22,20,"PAH",124,1,6,0)=" "
^DIC(9.4,53,22,20,"PAH",124,1,7,0)="Other problems fixed with this patch are correction of the Domain name "
^DIC(9.4,53,22,20,"PAH",124,1,8,0)="when sending AR reports, incorrect amount displaying on the Agent Cashier's"
^DIC(9.4,53,22,20,"PAH",124,1,9,0)="screen and the ability to regenerate the OIG report if it is not a "
^DIC(9.4,53,22,20,"PAH",124,1,10,0)="quarterly month."
^DIC(9.4,53,22,20,"PAH",125,0)="177 SEQ #157^3020327^1"
^DIC(9.4,53,22,20,"PAH",125,1,0)="^^8^8^3020327"
^DIC(9.4,53,22,20,"PAH",125,1,1,0)="This patch will reverse the duplicate deposits processed by Lockbox."
^DIC(9.4,53,22,20,"PAH",125,1,2,0)="The following deposits will be removed:"
^DIC(9.4,53,22,20,"PAH",125,1,3,0)="    Deposit: 269623        Transmission Date: 3/14/02"
^DIC(9.4,53,22,20,"PAH",125,1,4,0)="    Deposit: 269624        Transmission Date: 3/14/02"
^DIC(9.4,53,22,20,"PAH",125,1,5,0)="    Deposit: 269625        Transmission Date: 3/14/02"
^DIC(9.4,53,22,20,"PAH",125,1,6,0)="    Deposit: 269626        Transmission Date: 3/14/02"
^DIC(9.4,53,22,20,"PAH",125,1,7,0)="    Deposit: 269630        Transmission Date: 3/15/02"
^DIC(9.4,53,22,20,"PAH",125,1,8,0)="    Deposit: 269631        Transmission Date: 3/15/02"
^DIC(9.4,53,22,20,"PAH",126,0)="178 SEQ #158^3020423^1"
^DIC(9.4,53,22,20,"PAH",126,1,0)="^^3^3^3020423"
^DIC(9.4,53,22,20,"PAH",126,1,1,0)="This patch fixes the MCCF/HSIF TR documents from being rejected in FMS due"
^DIC(9.4,53,22,20,"PAH",126,1,2,0)="to the AR package not sending a valid transaction category that is"
^DIC(9.4,53,22,20,"PAH",126,1,3,0)="acceptable by the FMS programs."
^DIC(9.4,53,22,20,"PAH",127,0)="176^3020927^1"
^DIC(9.4,53,22,20,"PAH",127,1,0)="^9.49011^2^2^3020928^"
^DIC(9.4,53,22,20,"PAH",127,1,1,0)="CHANGES IN 430.2 FILE REQUIRED BY IB PACKAGE"
^DIC(9.4,53,22,20,"PAH",127,1,2,0)="MODIFICATION OF TRANDESC^RCCPCPS1 API CALL"
^DIC(9.4,53,22,20,"PAH",128,0)="182 SEQ #160^3021008^1"
^DIC(9.4,53,22,20,"PAH",128,1,0)="^^3^3^3021008"
^DIC(9.4,53,22,20,"PAH",128,1,1,0)="NDB Collections are not being updated with the HSIF dollar amounts from "
^DIC(9.4,53,22,20,"PAH",128,1,2,0)="the sites.  This patch modifies the monthly AR data collection process so "
^DIC(9.4,53,22,20,"PAH",128,1,3,0)="that the HSIF amounts are included in the data sent to the NDB."
^DIC(9.4,53,22,20,"PAH",129,0)="181^3021220^1"
^DIC(9.4,53,22,20,"PAH",129,1,0)="^^1^1^3021220"
^DIC(9.4,53,22,20,"PAH",129,1,1,0)="GEOGRAPHIC MEANS TEST, PART 2"
^DIC(9.4,53,22,20,"PAH",130,0)="189 SEQ #162^3030301^1"
^DIC(9.4,53,22,20,"PAH",130,1,0)="^^1^1^3030301"
^DIC(9.4,53,22,20,"PAH",130,1,1,0)="REGIONAL COUNSEL ENHANCEMENT"
^DIC(9.4,53,22,20,"PAH",131,0)="180 SEQ #163^3030329^1"
^DIC(9.4,53,22,20,"PAH",131,1,0)="^^1^1^3030329"
^DIC(9.4,53,22,20,"PAH",131,1,1,0)="API FOR IB IN SETTLEMENT"
^DIC(9.4,53,22,20,"PAH",132,0)="186 SEQ #164^3030329^1"
^DIC(9.4,53,22,20,"PAH",132,1,0)="^^20^20^3030329"
^DIC(9.4,53,22,20,"PAH",132,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",132,1,2,0)="This patch addresses the following NOISs:"
^DIC(9.4,53,22,20,"PAH",132,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",132,1,4,0)="MON-0202-51360 <UNDEF> BILL+3^RCDPRTP0 ERROR while using the Claims"
^DIC(9.4,53,22,20,"PAH",132,1,5,0)="Matching Report Option."
^DIC(9.4,53,22,20,"PAH",132,1,6,0)="  "
^DIC(9.4,53,22,20,"PAH",132,1,7,0)="SLC-0602-52580 ERROR: BILL+3^RCDPRTP0 while using the Claims Matching"
^DIC(9.4,53,22,20,"PAH",132,1,8,0)="Report Option."
^DIC(9.4,53,22,20,"PAH",132,1,9,0)=" "
^DIC(9.4,53,22,20,"PAH",132,1,10,0)="IRO-0502-40037 Claims Matching Report Subscript Error - the error "
^DIC(9.4,53,22,20,"PAH",132,1,11,0)="occurred every time the patient was not in the debtor file.  Code"
^DIC(9.4,53,22,20,"PAH",132,1,12,0)="was modified to check to see if the patient was in the debtor file."
^DIC(9.4,53,22,20,"PAH",132,1,13,0)=" "
^DIC(9.4,53,22,20,"PAH",132,1,14,0)="CHY-0502-52969 W+8~DIR error when using P-MESSAGE - the problem existed "
^DIC(9.4,53,22,20,"PAH",132,1,15,0)="in the option Claims Matching Report [RCDP CLAIMS MATCH] if the report is "
^DIC(9.4,53,22,20,"PAH",132,1,16,0)="queued.  The Taskman variable ZTQUEUED was being Killed in RCDPRTP."
^DIC(9.4,53,22,20,"PAH",132,1,17,0)=" "
^DIC(9.4,53,22,20,"PAH",132,1,18,0)="The variable ZTQUEUED is used to check whether or not a job is running in "
^DIC(9.4,53,22,20,"PAH",132,1,19,0)="the background (IF $D(ZTQUEUED)). It is controlled within Taskman and"
^DIC(9.4,53,22,20,"PAH",132,1,20,0)="should not be killed in a routine."
^DIC(9.4,53,22,20,"PAH",133,0)="187 SEQ #165^3030329^1"
^DIC(9.4,53,22,20,"PAH",133,1,0)="^^4^4^3030329"
^DIC(9.4,53,22,20,"PAH",133,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",133,1,2,0)="1. OKL-0902-70880  ACCOUNT REFERRING TO TOP/NO STATEMENTS"
^DIC(9.4,53,22,20,"PAH",133,1,3,0)="2. MAR-1102-20444  CCPC-Failed Trans. Station 641 Perry Point. MD"
^DIC(9.4,53,22,20,"PAH",133,1,4,0)="3. LON-0103-60496  Military Bills referred to TOP"
^DIC(9.4,53,22,20,"PAH",134,0)="190 SEQ #166^3030329^1"
^DIC(9.4,53,22,20,"PAH",134,1,0)="^^1^1^3030329"
^DIC(9.4,53,22,20,"PAH",134,1,1,0)="HIPAA Confidential Communications, the AR part."
^DIC(9.4,53,22,20,"PAH",135,0)="188 SEQ #167^3030417^1"
^DIC(9.4,53,22,20,"PAH",135,1,0)="^^3^3^3030417"
^DIC(9.4,53,22,20,"PAH",135,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",135,1,2,0)="1. TUC-1102-60505  EDITING FMS ACCTG ELEMENTS"
^DIC(9.4,53,22,20,"PAH",135,1,3,0)="2. WAS-0802-21469  Error ~%DSM-E-STRLEN~"
^DIC(9.4,53,22,20,"PAH",136,0)="194 SEQ #168^3030430^1"
^DIC(9.4,53,22,20,"PAH",136,1,0)="^^4^4^3030430"
^DIC(9.4,53,22,20,"PAH",136,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",136,1,2,0)="This emergency patch addresses one issue. The issue is pertaining to new"
^DIC(9.4,53,22,20,"PAH",136,1,3,0)="behavior introduced in patch PRCA*4.5*188 which prevented the entry of"
^DIC(9.4,53,22,20,"PAH",136,1,4,0)="some Fund codes based on the category of a bill."
^DIC(9.4,53,22,20,"PAH",137,0)="183 SEQ #169^3030628^1"
^DIC(9.4,53,22,20,"PAH",137,1,0)="^^1^1^3030628"
^DIC(9.4,53,22,20,"PAH",137,1,1,0)="Accounts Receivable API  for My HealtheVet"
^DIC(9.4,53,22,20,"PAH",138,0)="193 SEQ #170^3030802^1"
^DIC(9.4,53,22,20,"PAH",138,1,0)="^^6^6^3030802"
^DIC(9.4,53,22,20,"PAH",138,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",138,1,2,0)="This patch addresses 2 issues. The first issue is regarding the "
^DIC(9.4,53,22,20,"PAH",138,1,3,0)="""Bad Debt Write-Off (Plus)"" line in the Bad Debt report not updating"
^DIC(9.4,53,22,20,"PAH",138,1,4,0)="correctly. The second issue concerns patient balance discrepancies"
^DIC(9.4,53,22,20,"PAH",138,1,5,0)="that appear on the Statement Discrepancy Listing report even though"
^DIC(9.4,53,22,20,"PAH",138,1,6,0)="the accounts are actually in balance."
^DIC(9.4,53,22,20,"PAH",139,0)="197 SEQ #171^3030821^1"
^DIC(9.4,53,22,20,"PAH",139,1,0)="^^3^3^3030821"
^DIC(9.4,53,22,20,"PAH",139,1,1,0)="Change logic to generate 1 mailman message to ALL recipients of the AR "
^DIC(9.4,53,22,20,"PAH",139,1,2,0)="Supervisor List, rather than a separate mailman message for each "
^DIC(9.4,53,22,20,"PAH",139,1,3,0)="recipient."
^DIC(9.4,53,22,20,"PAH",140,0)="191 SEQ #172^3030924^1"
^DIC(9.4,53,22,20,"PAH",140,1,0)="^^2^2^3030924"
^DIC(9.4,53,22,20,"PAH",140,1,1,0)="This patch contains all of the date changes to comply with the new End"
^DIC(9.4,53,22,20,"PAH",140,1,2,0)="of Month EOAM for the ARDC, Bad Debt, and OIG reports."
^DIC(9.4,53,22,20,"PAH",141,0)="204 SEQ #173^3030924^1"
^DIC(9.4,53,22,20,"PAH",141,1,0)="^^2^2^3030924"
^DIC(9.4,53,22,20,"PAH",141,1,1,0)="This patch adds the functionality of holding transmissions to FMS of new "
^DIC(9.4,53,22,20,"PAH",141,1,2,0)="documents created after the EOAM."
^DIC(9.4,53,22,20,"PAH",142,0)="203 SEQ #174^3030924^1"
^DIC(9.4,53,22,20,"PAH",142,1,0)="^^1^1^3030924"
^DIC(9.4,53,22,20,"PAH",142,1,1,0)="The patch enables support for the new Point Accounts."
^DIC(9.4,53,22,20,"PAH",143,0)="207 SEQ #175^3030924^1"
^DIC(9.4,53,22,20,"PAH",143,1,0)="^^5^5^3030924"
^DIC(9.4,53,22,20,"PAH",143,1,1,0)="Sets effective date of the Point Accounts changes to 9/26/03 (except the"
^DIC(9.4,53,22,20,"PAH",143,1,2,0)="effective date for the ARDC  functionality which remains 10/1/03)."
^DIC(9.4,53,22,20,"PAH",143,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",143,1,4,0)="FMS Documents, resubmitted before 10/1/03 will also not contain Point "
^DIC(9.4,53,22,20,"PAH",143,1,5,0)="Accounts funds."
^DIC(9.4,53,22,20,"PAH",144,0)="173^3031023^1"
^DIC(9.4,53,22,20,"PAH",144,1,0)="^^4^4^3031023"
^DIC(9.4,53,22,20,"PAH",144,1,1,0)="Third Party EDI Lockbox Patch PRCA*4.5*173 (Accounts Receivable component)"
^DIC(9.4,53,22,20,"PAH",144,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",144,1,3,0)="Please refer to the patch description in the National Patch module and"
^DIC(9.4,53,22,20,"PAH",144,1,4,0)="the users documentation for detailed information about this patch."
^DIC(9.4,53,22,20,"PAH",145,0)="195 SEQ #177^3031023^1"
^DIC(9.4,53,22,20,"PAH",145,1,0)="^^7^7^3031023"
^DIC(9.4,53,22,20,"PAH",145,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",145,1,2,0)="This patch addresses 2 issues. The first issue is regarding no "
^DIC(9.4,53,22,20,"PAH",145,1,3,0)="transmission received for station #641, VA Maryland Health Care dated"
^DIC(9.4,53,22,20,"PAH",145,1,4,0)="03/15/2003 after they ran the Transmit CCPC Messages [RCCPC TRANSMIT] "
^DIC(9.4,53,22,20,"PAH",145,1,5,0)="option. The second issue is that site receives the same transmission error"
^DIC(9.4,53,22,20,"PAH",145,1,6,0)="message T404W almost every single month from Austin when they attempt "
^DIC(9.4,53,22,20,"PAH",145,1,7,0)="to transmit a build file that takes over 24 hours to complete."
^DIC(9.4,53,22,20,"PAH",146,0)="205 SEQ #178^3031107^1"
^DIC(9.4,53,22,20,"PAH",146,1,0)="^^7^7^3031107"
^DIC(9.4,53,22,20,"PAH",146,1,1,0)="This patch creates a header record for the AR electronic message"
^DIC(9.4,53,22,20,"PAH",146,1,2,0)="which gets transmitted to the OIG."
^DIC(9.4,53,22,20,"PAH",146,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",146,1,4,0)="The header record will include the following:"
^DIC(9.4,53,22,20,"PAH",146,1,5,0)="1. The total number of extract messages that will be transmitted to Austin."
^DIC(9.4,53,22,20,"PAH",146,1,6,0)="2. The sequential message number of the message itself"
^DIC(9.4,53,22,20,"PAH",146,1,7,0)="   (i.e., ""message 5 of 21"")."
^DIC(9.4,53,22,20,"PAH",147,0)="209 SEQ #179^3040131^1"
^DIC(9.4,53,22,20,"PAH",147,1,0)="^^1^1^3040131"
^DIC(9.4,53,22,20,"PAH",147,1,1,0)="MY HEALTH-E-VET ENHANCEMENT"
^DIC(9.4,53,22,20,"PAH",148,0)="211 SEQ #180^3040131^1"
^DIC(9.4,53,22,20,"PAH",148,1,0)="^^10^10^3040131"
^DIC(9.4,53,22,20,"PAH",148,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",148,1,2,0)="A site reported that there have been three issues found since the install"
^DIC(9.4,53,22,20,"PAH",148,1,3,0)="of PRCA*4.5*203. The first issue is that the Revenue Sources Code for"
^DIC(9.4,53,22,20,"PAH",148,1,4,0)="Pharmacy bills don't print and it appears to happen when the category is"
^DIC(9.4,53,22,20,"PAH",148,1,5,0)="RX CO-PAYMENT/NSC VET.  The second issue indicates that Pharmacy First "
^DIC(9.4,53,22,20,"PAH",148,1,6,0)="Party bills are being deposited into a fund of 5287.3 while the patch"
^DIC(9.4,53,22,20,"PAH",148,1,7,0)="description in PRCA*4.5*203 states that the New Point Accounts for "
^DIC(9.4,53,22,20,"PAH",148,1,8,0)="pharmacy bill should be 5287.1.  The third issue is that the old closed"
^DIC(9.4,53,22,20,"PAH",148,1,9,0)="receipts (FY03) prior to the installation of PRCA*4.5*203 are reporting"
^DIC(9.4,53,22,20,"PAH",148,1,10,0)="funds for the New Point Accounts and they print in the 215 report."
^DIC(9.4,53,22,20,"PAH",149,0)="196 SEQ #181^3040131^1"
^DIC(9.4,53,22,20,"PAH",149,1,0)="^^7^7^3040131"
^DIC(9.4,53,22,20,"PAH",149,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",149,1,2,0)="This patch addresses two issues. The first issue is regarding two"
^DIC(9.4,53,22,20,"PAH",149,1,3,0)="users who were able to exempt interest/admin. charges on the same bill"
^DIC(9.4,53,22,20,"PAH",149,1,4,0)="at the same time through the Administrative Cost Adjustment [PRCAF ADJ"
^DIC(9.4,53,22,20,"PAH",149,1,5,0)="ADMIN] option. The second issue is about the receipt profile that"
^DIC(9.4,53,22,20,"PAH",149,1,6,0)="didn't show the last person's initials when he/she edited the receipt"
^DIC(9.4,53,22,20,"PAH",149,1,7,0)="by using EP Edit Payment under the Receipt Processing."
^DIC(9.4,53,22,20,"PAH",150,0)="198 SEQ #182^3040302^1"
^DIC(9.4,53,22,20,"PAH",150,1,0)="^^14^14^3040302"
^DIC(9.4,53,22,20,"PAH",150,1,1,0)="The Patient Name Standardization patch DG*5.3*244 introduces changes "
^DIC(9.4,53,22,20,"PAH",150,1,2,0)="to the patient look up logic which implement ""fuzzy"" lookup functionality."
^DIC(9.4,53,22,20,"PAH",150,1,3,0)="This allows pick lists to return entries beyond those that match the "
^DIC(9.4,53,22,20,"PAH",150,1,4,0)="user's input exactly. With the fuzzy lookups in place a bill number"
^DIC(9.4,53,22,20,"PAH",150,1,5,0)="such as K301EL2 may also return patients whose names begin with KEL."
^DIC(9.4,53,22,20,"PAH",150,1,6,0)="This had an unexpected result on the AR options when the user"
^DIC(9.4,53,22,20,"PAH",150,1,7,0)="entered bill numbers."
^DIC(9.4,53,22,20,"PAH",150,1,8,0)="   "
^DIC(9.4,53,22,20,"PAH",150,1,9,0)="A flag variable DPTNOFZY has been implemented to allow the suppression"
^DIC(9.4,53,22,20,"PAH",150,1,10,0)="of fuzzy lookups in DG*5.3*244. A flag variable DPTNOFZK has been added"
^DIC(9.4,53,22,20,"PAH",150,1,11,0)="to prevent the flag variable DPTNOFZY from being killed within the AR"
^DIC(9.4,53,22,20,"PAH",150,1,12,0)="process in DG*5.3*541. Patch PRCA*4.5*198 has been created to set the"
^DIC(9.4,53,22,20,"PAH",150,1,13,0)="flag variables at the various points where selection of bill numbers or"
^DIC(9.4,53,22,20,"PAH",150,1,14,0)="patients occurs."
^DIC(9.4,53,22,20,"PAH",151,0)="214 SEQ #183^3040302^1"
^DIC(9.4,53,22,20,"PAH",151,1,0)="^^6^6^3040302"
^DIC(9.4,53,22,20,"PAH",151,1,1,0)="This patch addresses two issues.  The first issue is regarding the payment"
^DIC(9.4,53,22,20,"PAH",151,1,2,0)="amount listed in the Electronic Remittance Advices (ERA) messages that is"
^DIC(9.4,53,22,20,"PAH",151,1,3,0)="not equal to the amount for the Electronic Funds Transfer (EFT). The EFT"
^DIC(9.4,53,22,20,"PAH",151,1,4,0)="can be referenced for the ERA payment that the payer has paid for a bill."
^DIC(9.4,53,22,20,"PAH",151,1,5,0)="The second issue concerns an undefined error when processing an EDI"
^DIC(9.4,53,22,20,"PAH",151,1,6,0)="LOCKBOX receipt."
^DIC(9.4,53,22,20,"PAH",152,0)="216 SEQ #184^3040427^1"
^DIC(9.4,53,22,20,"PAH",152,1,0)="^^4^4^3040427"
^DIC(9.4,53,22,20,"PAH",152,1,1,0)="This build contains the code to store the patient name in the ELECTRONIC"
^DIC(9.4,53,22,20,"PAH",152,1,2,0)="REMITTANCE FILE (#344.4) for both valid and invalid bills.  Previously,"
^DIC(9.4,53,22,20,"PAH",152,1,3,0)="only invalid bills would store this data.  This change is needed to"
^DIC(9.4,53,22,20,"PAH",152,1,4,0)="support automatic payment verification in the e-Payment Phase 2 patch."
^DIC(9.4,53,22,20,"PAH",153,0)="215 SEQ #185^3040507^1"
^DIC(9.4,53,22,20,"PAH",153,1,0)="^^1^1^3040507"
^DIC(9.4,53,22,20,"PAH",153,1,1,0)="BAD DEBT REPORT CORRECTION"
^DIC(9.4,53,22,20,"PAH",154,0)="206 SEQ #186^3040702^1"
^DIC(9.4,53,22,20,"PAH",154,1,0)="^^4^4^3040702"
^DIC(9.4,53,22,20,"PAH",154,1,1,0)="This patch modifies Patient Statements that are transmitted from the"
^DIC(9.4,53,22,20,"PAH",154,1,2,0)="sites to the Austin Automation Center (AAC).  The account number on"
^DIC(9.4,53,22,20,"PAH",154,1,3,0)="these statements currently contains the patient's SSN.  The patch"
^DIC(9.4,53,22,20,"PAH",154,1,4,0)="replaces the SSN portion of the account number with the patient's DNF."
^DIC(9.4,53,22,20,"PAH",155,0)="212 SEQ #187^3040802^1"
^DIC(9.4,53,22,20,"PAH",155,1,0)="^^9^9^3040802"
^DIC(9.4,53,22,20,"PAH",155,1,1,0)="The first issue is regarding an Electronic Remittance Advice (ERA) for "
^DIC(9.4,53,22,20,"PAH",155,1,2,0)="the Electronic Funds Transfer (EFT) deposits appearing on the Unapplied"
^DIC(9.4,53,22,20,"PAH",155,1,3,0)="EFT Deposits Report which indicated it was not being processed although  "
^DIC(9.4,53,22,20,"PAH",155,1,4,0)="the receipt document showed it was entered on line."
^DIC(9.4,53,22,20,"PAH",155,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",155,1,6,0)="The second issue shows the [PRCAD MAS COMPLETE] option and the"
^DIC(9.4,53,22,20,"PAH",155,1,7,0)="[PRCAD MAS INCOMPLETE] option working incorrectly. Site received the  "
^DIC(9.4,53,22,20,"PAH",155,1,8,0)="output which appeared that it found all the bills without screening"
^DIC(9.4,53,22,20,"PAH",155,1,9,0)="out their services.  "
^DIC(9.4,53,22,20,"PAH",156,0)="192 SEQ #188^3040903^1"
^DIC(9.4,53,22,20,"PAH",156,1,0)="^^1^1^3040903"
^DIC(9.4,53,22,20,"PAH",156,1,1,0)="Change references to CHAMPUS to TRICARE."
^DIC(9.4,53,22,20,"PAH",157,0)="201 SEQ #189^3040903^1"
^DIC(9.4,53,22,20,"PAH",157,1,0)="^^2^2^3040903"
^DIC(9.4,53,22,20,"PAH",157,1,1,0)="This patch will implement CBO data extraction logic for"
^DIC(9.4,53,22,20,"PAH",157,1,2,0)="the Boston Allocation Resource Center."
^DIC(9.4,53,22,20,"PAH",158,0)="208 SEQ #190^3040903^1"
^DIC(9.4,53,22,20,"PAH",159,0)="222 SEQ #191^3040917^1"
^DIC(9.4,53,22,20,"PAH",159,1,0)="^^2^2^3040917"
^DIC(9.4,53,22,20,"PAH",159,1,1,0)="Contains small fixes to problems found in the later stages of testing for"
^DIC(9.4,53,22,20,"PAH",159,1,2,0)="e-Payments enhancements patch PRCA*4.5*208."
^DIC(9.4,53,22,20,"PAH",160,0)="220 SEQ #192^3040924^1"
^DIC(9.4,53,22,20,"PAH",160,1,0)="^^3^3^3040924"
^DIC(9.4,53,22,20,"PAH",160,1,1,0)="This patch implements new point accounts 528705-528709 and 528710"
^DIC(9.4,53,22,20,"PAH",160,1,2,0)="It also changes point accounts 5287.1 to 528701,  5287.3 to 528704 and"
^DIC(9.4,53,22,20,"PAH",160,1,3,0)="5287.4 to 528704."
^DIC(9.4,53,22,20,"PAH",161,0)="202^3041029^1"
^DIC(9.4,53,22,20,"PAH",161,1,0)="^^230^230^3041029"
^DIC(9.4,53,22,20,"PAH",161,1,1,0)="PATCH OVERVIEW"
^DIC(9.4,53,22,20,"PAH",161,1,2,0)="---------------"
^DIC(9.4,53,22,20,"PAH",161,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,4,0)="The Healthcare Insurance Portability and Accountability Act National "
^DIC(9.4,53,22,20,"PAH",161,1,5,0)="Council for Prescription Drug Programs (HIPAA NCPDP) initiative, whose "
^DIC(9.4,53,22,20,"PAH",161,1,6,0)="ultimate goal is to provide functionality allowing electronic "
^DIC(9.4,53,22,20,"PAH",161,1,7,0)="transmission of Outpatient Pharmacy (OP) prescription claims to payers "
^DIC(9.4,53,22,20,"PAH",161,1,8,0)="and the receipt of claim responses (including drug utilization review "
^DIC(9.4,53,22,20,"PAH",161,1,9,0)="responses and warnings) on a real-time basis, is being developed and "
^DIC(9.4,53,22,20,"PAH",161,1,10,0)="introduced in a phased implementation strategy. This deployment strategy "
^DIC(9.4,53,22,20,"PAH",161,1,11,0)="was utilized due to the complexity of the functionality and the number of "
^DIC(9.4,53,22,20,"PAH",161,1,12,0)="product line dependencies."
^DIC(9.4,53,22,20,"PAH",161,1,13,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,14,0)="The first release of this two part implementation is BPS*1*0, comprised "
^DIC(9.4,53,22,20,"PAH",161,1,15,0)="of the new Electronic Claims Management Engine (ECME) package (in the BPS "
^DIC(9.4,53,22,20,"PAH",161,1,16,0)="namespace), plus the patches PSS*1*81, IB*2.0*223, IB*2.0*251, and "
^DIC(9.4,53,22,20,"PAH",161,1,17,0)="PRCA*4.5*202, which are listed here in order of installation. BPS*1*0 is "
^DIC(9.4,53,22,20,"PAH",161,1,18,0)="a dormant release that only allows each site to perform preliminary setup "
^DIC(9.4,53,22,20,"PAH",161,1,19,0)="work and to confirm that the software does not adversely affect other "
^DIC(9.4,53,22,20,"PAH",161,1,20,0)="packages."
^DIC(9.4,53,22,20,"PAH",161,1,21,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,22,0)="There are two main areas addressed by BPS*1*0:"
^DIC(9.4,53,22,20,"PAH",161,1,23,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,24,0)="a. Registration of the Pharmacy with the Vitria BusinessWare IE."
^DIC(9.4,53,22,20,"PAH",161,1,25,0)="b. The Insurance Matching of Group Plans with Pharmacy Plans"
^DIC(9.4,53,22,20,"PAH",161,1,26,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,27,0)="Following the installation of BPS*1*0, each site must register their "
^DIC(9.4,53,22,20,"PAH",161,1,28,0)="pharmacy with Vitria and match applicable insurance group plans using the "
^DIC(9.4,53,22,20,"PAH",161,1,29,0)="insurance matching screens. These processes are detailed in the HIPAA "
^DIC(9.4,53,22,20,"PAH",161,1,30,0)="NCPDP CONNECTION FOR EDI PHARMACY INSTALLATION GUIDE and the MATCH GROUP "
^DIC(9.4,53,22,20,"PAH",161,1,31,0)="PLANS WITH PHARMACY PLANS document. Both of these documents are located "
^DIC(9.4,53,22,20,"PAH",161,1,32,0)="on the anonymous directory. It is very important that the IRM or person "
^DIC(9.4,53,22,20,"PAH",161,1,33,0)="installing the patch at each facility provide a copy of these documents "
^DIC(9.4,53,22,20,"PAH",161,1,34,0)="to its ADPAC(s) and any other relevant staff who will be responsible for "
^DIC(9.4,53,22,20,"PAH",161,1,35,0)="registering their pharmacy with Vitria and completing the insurance "
^DIC(9.4,53,22,20,"PAH",161,1,36,0)="matching process."
^DIC(9.4,53,22,20,"PAH",161,1,37,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,38,0)="At a later date, additional HIPAA NCPDP patches will be released to "
^DIC(9.4,53,22,20,"PAH",161,1,39,0)="activate all of the HIPAA NCPDP functionality. Until that time, sites "
^DIC(9.4,53,22,20,"PAH",161,1,40,0)="will not be able to electronically submit claims utilizing this new "
^DIC(9.4,53,22,20,"PAH",161,1,41,0)="functionality."
^DIC(9.4,53,22,20,"PAH",161,1,42,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,43,0)="The HIPAA NCPDP project was created in response to a Chief Business "
^DIC(9.4,53,22,20,"PAH",161,1,44,0)="Office (CBO) request for modifications to several Veterans Health "
^DIC(9.4,53,22,20,"PAH",161,1,45,0)="Information Systems and Technology Architecture (VistA) software "
^DIC(9.4,53,22,20,"PAH",161,1,46,0)="applications in accordance with HIPAA Electronic Data Interchange (EDI) "
^DIC(9.4,53,22,20,"PAH",161,1,47,0)="transactions and NCPDP mandated format standards, specifically the NCPDP "
^DIC(9.4,53,22,20,"PAH",161,1,48,0)="Telecommunication Standard v.5.1."
^DIC(9.4,53,22,20,"PAH",161,1,49,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,50,0)="The specific functionality for this patch is listed below."
^DIC(9.4,53,22,20,"PAH",161,1,51,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,52,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,53,0)="Functional Description"
^DIC(9.4,53,22,20,"PAH",161,1,54,0)="-----------------------"
^DIC(9.4,53,22,20,"PAH",161,1,55,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,56,0)="The patch PRCA*4.5*202 represents the Accounts Receivable portion of the "
^DIC(9.4,53,22,20,"PAH",161,1,57,0)="NCPDP-Pharmacy Connection project. It modifies the EDI Lockbox "
^DIC(9.4,53,22,20,"PAH",161,1,58,0)="functionality by adding the ability to manually process EOB related to"
^DIC(9.4,53,22,20,"PAH",161,1,59,0)="NCPDP claims."
^DIC(9.4,53,22,20,"PAH",161,1,60,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,61,0)="The patch modifies Accounts Receivable (AR) users interface to make it"
^DIC(9.4,53,22,20,"PAH",161,1,62,0)="possible to select bills by entering NCPDP Prescription/Service Reference"
^DIC(9.4,53,22,20,"PAH",161,1,63,0)="Numbers."
^DIC(9.4,53,22,20,"PAH",161,1,64,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,65,0)="When working with ""Receipt Processing"" [RCDP RECEIPT PROCESSING] and "
^DIC(9.4,53,22,20,"PAH",161,1,66,0)="""Link Payment to Account"" [RCDP LINK PAYMENT TO ACCOUNT] menu options,"
^DIC(9.4,53,22,20,"PAH",161,1,67,0)="users normally enter the Bill Number or the Patient Name corresponding to"
^DIC(9.4,53,22,20,"PAH",161,1,68,0)="the processed payment."
^DIC(9.4,53,22,20,"PAH",161,1,69,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,70,0)="The users prompt to that input is:"
^DIC(9.4,53,22,20,"PAH",161,1,71,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,72,0)="PATIENT NAME OR BILL NUMBER:"
^DIC(9.4,53,22,20,"PAH",161,1,73,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,74,0)="Although the prompt is asking for a Patient Name or a Bill Number, "
^DIC(9.4,53,22,20,"PAH",161,1,75,0)="there are some other types of data that may be entered to identify "
^DIC(9.4,53,22,20,"PAH",161,1,76,0)="the corresponding bill. Previously the choices were:"
^DIC(9.4,53,22,20,"PAH",161,1,77,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,78,0)="- Tricare Authorization Number;"
^DIC(9.4,53,22,20,"PAH",161,1,79,0)="- Prescription Number. "
^DIC(9.4,53,22,20,"PAH",161,1,80,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,81,0)="This patch adds one more type of data that can be entered to identify a "
^DIC(9.4,53,22,20,"PAH",161,1,82,0)="Bill. The ""ECME Number"", the Prescription/Service Reference Number, "
^DIC(9.4,53,22,20,"PAH",161,1,83,0)="indicated in the NCPDP Electronic Claim, can now be entered to identify "
^DIC(9.4,53,22,20,"PAH",161,1,84,0)="the bill."
^DIC(9.4,53,22,20,"PAH",161,1,85,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,86,0)="The help text for the above user's prompt has been modified to provide "
^DIC(9.4,53,22,20,"PAH",161,1,87,0)="a better explanation of the expected input:"
^DIC(9.4,53,22,20,"PAH",161,1,88,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,89,0)="PATIENT NAME OR BILL NUMBER: ?"
^DIC(9.4,53,22,20,"PAH",161,1,90,0)="     Enter one of following: Patient Name, Bill No, Tricare Authorization "
^DIC(9.4,53,22,20,"PAH",161,1,91,0)="No,"
^DIC(9.4,53,22,20,"PAH",161,1,92,0)="     ECME Rx Reference Number or Prescription Number."
^DIC(9.4,53,22,20,"PAH",161,1,93,0)="PATIENT NAME OR BILL NUMBER: "
^DIC(9.4,53,22,20,"PAH",161,1,94,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,95,0)="If the users input is not a Bill Number and not a Patient Name, and is "
^DIC(9.4,53,22,20,"PAH",161,1,96,0)="recognized as a Tricare Authorization Number, Prescription Number or a"
^DIC(9.4,53,22,20,"PAH",161,1,97,0)="ECME Number, the subsequent user's prompt will be respectively:"
^DIC(9.4,53,22,20,"PAH",161,1,98,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,99,0)="Is this TRICARE reference number - 123456? No//"
^DIC(9.4,53,22,20,"PAH",161,1,100,0)="Is this prescription number - 123456? No//"
^DIC(9.4,53,22,20,"PAH",161,1,101,0)="Is this ECME Rx reference number - 123456? No//"
^DIC(9.4,53,22,20,"PAH",161,1,102,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,103,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,104,0)="Technical Description"
^DIC(9.4,53,22,20,"PAH",161,1,105,0)="----------------------"
^DIC(9.4,53,22,20,"PAH",161,1,106,0)="The patch modifies the procedure PNORBILL^RCDPURED, which is called from "
^DIC(9.4,53,22,20,"PAH",161,1,107,0)="the Data Dictionary of the file #344 (sub-file #344.01). It calls the IB "
^DIC(9.4,53,22,20,"PAH",161,1,108,0)="procedure REC^IBRFN, which was also modified by this project (patch "
^DIC(9.4,53,22,20,"PAH",161,1,109,0)="IB*2.0*223) to support ECME Numbers."
^DIC(9.4,53,22,20,"PAH",161,1,110,0)="To provide a more clear users interface, the IB procedure REC^IBRFN will "
^DIC(9.4,53,22,20,"PAH",161,1,111,0)="be returning a flag - the second formal parameter by reference,"
^DIC(9.4,53,22,20,"PAH",161,1,112,0)="indicating, how the users input was recognized: Tricare Authorization "
^DIC(9.4,53,22,20,"PAH",161,1,113,0)="Number, Prescription Number, or the ECME Number. The consequent users "
^DIC(9.4,53,22,20,"PAH",161,1,114,0)="prompt will indicate that. "
^DIC(9.4,53,22,20,"PAH",161,1,115,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,116,0)="Routine RCDPESR1 modifies the EDI LockBox AR functionality to "
^DIC(9.4,53,22,20,"PAH",161,1,117,0)="add capability of matching ECME number to IB bill automatically."
^DIC(9.4,53,22,20,"PAH",161,1,118,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,119,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,120,0)="ROUTINES SENT WITH PATCH"
^DIC(9.4,53,22,20,"PAH",161,1,121,0)="------------------------"
^DIC(9.4,53,22,20,"PAH",161,1,122,0)="The following is a list of the routines included in this patch."
^DIC(9.4,53,22,20,"PAH",161,1,123,0)="The second line of each of these routines now looks like:"
^DIC(9.4,53,22,20,"PAH",161,1,124,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,125,0)=" ;;4.5;Accounts Receivable;**[patch list]**;Mar 20, 1995"
^DIC(9.4,53,22,20,"PAH",161,1,126,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,127,0)="                CHECK^XTSUMBLD results"
^DIC(9.4,53,22,20,"PAH",161,1,128,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,129,0)=" Routine     Before Patch  After Patch  Patch List"
^DIC(9.4,53,22,20,"PAH",161,1,130,0)=" -------     ------------  -----------  ----------"
^DIC(9.4,53,22,20,"PAH",161,1,131,0)=" PRCASVC3        1629668     1748043     158,202"
^DIC(9.4,53,22,20,"PAH",161,1,132,0)=" RCDPESR1        13660919    14225614    173,214,208,202"
^DIC(9.4,53,22,20,"PAH",161,1,133,0)=" RCDPURED        8549824     9425617     114,169,174,196,202"
^DIC(9.4,53,22,20,"PAH",161,1,134,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,135,0)="      Total number of routines - 3"
^DIC(9.4,53,22,20,"PAH",161,1,136,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,137,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,138,0)="DATA DICTIONARIES SUMMARY"
^DIC(9.4,53,22,20,"PAH",161,1,139,0)="-------------------------"
^DIC(9.4,53,22,20,"PAH",161,1,140,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,141,0)="The following is a list of the DD changes included in this patch."
^DIC(9.4,53,22,20,"PAH",161,1,142,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,143,0)=" File #      Field #    Name"
^DIC(9.4,53,22,20,"PAH",161,1,144,0)=" ----------  -------  ------------------------------"
^DIC(9.4,53,22,20,"PAH",161,1,145,0)=" 344                   AR BATCH PAYMENT"
^DIC(9.4,53,22,20,"PAH",161,1,146,0)=" 344.01                TRANSACTION  (sub-file)"
^DIC(9.4,53,22,20,"PAH",161,1,147,0)="              .09      PATIENT NAME OR BILL NUMBER"
^DIC(9.4,53,22,20,"PAH",161,1,148,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,149,0)="      Total number of modified files - 1"
^DIC(9.4,53,22,20,"PAH",161,1,150,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,151,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,152,0)="SOFTWARE AND DOCUMENTATION RETRIEVAL"
^DIC(9.4,53,22,20,"PAH",161,1,153,0)="===================================="
^DIC(9.4,53,22,20,"PAH",161,1,154,0)="The software for this patch is being distributed in host file "
^DIC(9.4,53,22,20,"PAH",161,1,155,0)="BPS_1_0.KID.  The host file will contain seven KIDS builds."
^DIC(9.4,53,22,20,"PAH",161,1,156,0)="The builds contained in the BPS 1.0 multi-package distribution are:"
^DIC(9.4,53,22,20,"PAH",161,1,157,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,158,0)="     Package                    Patches"
^DIC(9.4,53,22,20,"PAH",161,1,159,0)="     -------                    ----------------------"
^DIC(9.4,53,22,20,"PAH",161,1,160,0)="     ECME                       BPS*1.0*1"
^DIC(9.4,53,22,20,"PAH",161,1,161,0)="     Pharmacy Data Management   PSS*1.0*81"
^DIC(9.4,53,22,20,"PAH",161,1,162,0)="     Integrated Billing         IB*2.0*223, IB*2.0*251"
^DIC(9.4,53,22,20,"PAH",161,1,163,0)="     Accounts Receivable        PRCA*4.5*202"
^DIC(9.4,53,22,20,"PAH",161,1,164,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,165,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,166,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,53,22,20,"PAH",161,1,167,0)="=========================="
^DIC(9.4,53,22,20,"PAH",161,1,168,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,169,0)="1. Use VA FileMan to add the new domain, EPHARMACY.VITRIA-EDI.AAC.DOMAIN.EXT, "
^DIC(9.4,53,22,20,"PAH",161,1,170,0)="to the DOMAIN file (#4.2). The installation instructions are included in "
^DIC(9.4,53,22,20,"PAH",161,1,171,0)="the patch description for the XM*DBA*160 patch. This domain must be in "
^DIC(9.4,53,22,20,"PAH",161,1,172,0)="place before the installation of the IB*2*251 patch that is included in "
^DIC(9.4,53,22,20,"PAH",161,1,173,0)="the BPS 1.0 Master Build."
^DIC(9.4,53,22,20,"PAH",161,1,174,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,175,0)="2. Download the KIDS file BPS_1_0.KID via FTP. This file needs to be "
^DIC(9.4,53,22,20,"PAH",161,1,176,0)="retrieved in ASCII format."
^DIC(9.4,53,22,20,"PAH",161,1,177,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,178,0)="3. Review mapped sets for the PSS*, IB*, and PRCA*namespaces.  If the "
^DIC(9.4,53,22,20,"PAH",161,1,179,0)="routines are mapped, they should be removed from the mapped set at this "
^DIC(9.4,53,22,20,"PAH",161,1,180,0)="time."
^DIC(9.4,53,22,20,"PAH",161,1,181,0)="  "
^DIC(9.4,53,22,20,"PAH",161,1,182,0)="4. From the Kernel Installation & Distribution System menu, select the "
^DIC(9.4,53,22,20,"PAH",161,1,183,0)="Installation menu."
^DIC(9.4,53,22,20,"PAH",161,1,184,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,185,0)="5.  From this menu, select the Load a Distribution option. When prompted "
^DIC(9.4,53,22,20,"PAH",161,1,186,0)="for a file name, enter "
^DIC(9.4,53,22,20,"PAH",161,1,187,0)="the directory name where you FTPd the build, followed by BPS_1_0. In our "
^DIC(9.4,53,22,20,"PAH",161,1,188,0)="example, the file name is USER$:[ANONYMOUS]BPS_1_0.KID. Determine the "
^DIC(9.4,53,22,20,"PAH",161,1,189,0)="location where you stored your build to decide the correct file name "
^DIC(9.4,53,22,20,"PAH",161,1,190,0)="entry."
^DIC(9.4,53,22,20,"PAH",161,1,191,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,192,0)="6. At the ""Want to Continue with Load? YES//"" prompt, enter YES."
^DIC(9.4,53,22,20,"PAH",161,1,193,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,194,0)="7. At the ""Want to RUN the Environment Check Routine: YES//"" prompt, "
^DIC(9.4,53,22,20,"PAH",161,1,195,0)="answer YES."
^DIC(9.4,53,22,20,"PAH",161,1,196,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,197,0)="8. From this menu, the installer may select to use the following options:"
^DIC(9.4,53,22,20,"PAH",161,1,198,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,199,0)="(When prompted for INSTALL NAME, enter BPS 1.0)"
^DIC(9.4,53,22,20,"PAH",161,1,200,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,201,0)="    a. Backup a Transport Global - This option will create a backup "
^DIC(9.4,53,22,20,"PAH",161,1,202,0)="message of any routines exported with the patch. It will NOT backup any "
^DIC(9.4,53,22,20,"PAH",161,1,203,0)="other changes such as DDs or templates."
^DIC(9.4,53,22,20,"PAH",161,1,204,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,205,0)="    b. Compare Transport Global to Current System - This option will "
^DIC(9.4,53,22,20,"PAH",161,1,206,0)="allow you to view all changes that will be made when the patch is "
^DIC(9.4,53,22,20,"PAH",161,1,207,0)="installed. It compares all components of the patch (routines, DDs, "
^DIC(9.4,53,22,20,"PAH",161,1,208,0)="templates, etc.)."
^DIC(9.4,53,22,20,"PAH",161,1,209,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,210,0)="    c. Verify Checksums in Transport Global - This option will ensure the "
^DIC(9.4,53,22,20,"PAH",161,1,211,0)="integrity of the routines that are in the transport global."
^DIC(9.4,53,22,20,"PAH",161,1,212,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,213,0)="9. At the ""Select Installation Option:"" prompt, enter 6 Install Package(s)"
^DIC(9.4,53,22,20,"PAH",161,1,214,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,215,0)="10. At the ""Select INSTALL NAME:"" prompt, enter BPS 1.0."
^DIC(9.4,53,22,20,"PAH",161,1,216,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,217,0)="11. When prompted, ""Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,53,22,20,"PAH",161,1,218,0)="Install? YES//"" respond NO."
^DIC(9.4,53,22,20,"PAH",161,1,219,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,220,0)="12. When prompted, ""Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,53,22,20,"PAH",161,1,221,0)="YES//"" respond NO."
^DIC(9.4,53,22,20,"PAH",161,1,222,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,223,0)="13. When prompted, ""Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,53,22,20,"PAH",161,1,224,0)="Protocols? YES//"" respond NO."
^DIC(9.4,53,22,20,"PAH",161,1,225,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,226,0)="14. When prompted, ""Device:Home//"" respond with the correct device and DO "
^DIC(9.4,53,22,20,"PAH",161,1,227,0)="NOT queue this to P-Message."
^DIC(9.4,53,22,20,"PAH",161,1,228,0)=" "
^DIC(9.4,53,22,20,"PAH",161,1,229,0)="15. If routines were unmapped as part of step 3, they should be returned "
^DIC(9.4,53,22,20,"PAH",161,1,230,0)="to the mapped set once the installation has run to completion. "
^DIC(9.4,53,22,20,"PAH",162,0)="138^3041029^1"
^DIC(9.4,53,22,20,"PAH",162,1,0)="^^6^6^3041029"
^DIC(9.4,53,22,20,"PAH",162,1,1,0)="Medicare Remittance Advice (MRA) - AR patch."
^DIC(9.4,53,22,20,"PAH",162,1,2,0)="This patch defines two new data elements in file PRCA(430,D0,13). Field "
^DIC(9.4,53,22,20,"PAH",162,1,3,0)="131: Medicare Contractual Adjustment and field 132: Medicare "
^DIC(9.4,53,22,20,"PAH",162,1,4,0)="Unreimbursable Expense. "
^DIC(9.4,53,22,20,"PAH",162,1,5,0)="In addition this patch makes changes to the Bad Debt Report and to the "
^DIC(9.4,53,22,20,"PAH",162,1,6,0)="FMS SV document."
^DIC(9.4,53,22,20,"PAH",163,0)="218 SEQ #195^3041111^1"
^DIC(9.4,53,22,20,"PAH",163,1,0)="^^1^1^3041111"
^DIC(9.4,53,22,20,"PAH",163,1,1,0)="HVE III AR PATCH"
^DIC(9.4,53,22,20,"PAH",164,0)="217 SEQ #196^3041228^1"
^DIC(9.4,53,22,20,"PAH",164,1,0)="^^9^9^3041228"
^DIC(9.4,53,22,20,"PAH",164,1,1,0)="This patch addresses 2 issues."
^DIC(9.4,53,22,20,"PAH",164,1,2,0)="  "
^DIC(9.4,53,22,20,"PAH",164,1,3,0)="The first issue is regarding the Customizing option under the Agent Cashier"
^DIC(9.4,53,22,20,"PAH",164,1,4,0)="Receipt Processing Option that was losing the customization features when"
^DIC(9.4,53,22,20,"PAH",164,1,5,0)="a user was at site running a multi-node system."
^DIC(9.4,53,22,20,"PAH",164,1,6,0)=" "
^DIC(9.4,53,22,20,"PAH",164,1,7,0)="The second issue is regarding a subscript error occurred at line"
^DIC(9.4,53,22,20,"PAH",164,1,8,0)="EN+14^RCCPCBJ when there is no any AR CCPC statement available for"
^DIC(9.4,53,22,20,"PAH",164,1,9,0)="transmission."
^DIC(9.4,53,22,20,"PAH",165,0)="221 SEQ #197^3050212^1"
^DIC(9.4,53,22,20,"PAH",165,1,0)="^^7^7^3050212"
^DIC(9.4,53,22,20,"PAH",165,1,1,0)="This patch addresses 2 issues. The first issue is regarding a problem when"
^DIC(9.4,53,22,20,"PAH",165,1,2,0)="a bill was entered in lowercase letters, it would pull up the incorrect "
^DIC(9.4,53,22,20,"PAH",165,1,3,0)="patient and not the bill that site entered."
^DIC(9.4,53,22,20,"PAH",165,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",165,1,5,0)="The second issue is regarding an undefined error when the payment on a"
^DIC(9.4,53,22,20,"PAH",165,1,6,0)="receipt has an EEOB Worklist decrease adjustment associated with it in the"
^DIC(9.4,53,22,20,"PAH",165,1,7,0)="Receipt Processing [RCDP RECEIPT PROCESSING] option."
^DIC(9.4,53,22,20,"PAH",166,0)="226 SEQ #198^3050311^1"
^DIC(9.4,53,22,20,"PAH",166,1,0)="^^13^13^3050311"
^DIC(9.4,53,22,20,"PAH",166,1,1,0)="This patch addresses 2 issues."
^DIC(9.4,53,22,20,"PAH",166,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",166,1,3,0)="The first issue is incorrect coding in routine RCBEUBIL.  This is not"
^DIC(9.4,53,22,20,"PAH",166,1,4,0)="causing an error and it doesn't appear to have caused any incorrect data"
^DIC(9.4,53,22,20,"PAH",166,1,5,0)="in the past but the change is needed to safeguard against any future"
^DIC(9.4,53,22,20,"PAH",166,1,6,0)="problems."
^DIC(9.4,53,22,20,"PAH",166,1,7,0)=" "
^DIC(9.4,53,22,20,"PAH",166,1,8,0)="The second issue is incorrect coding in routine RCBEUTR1.  The code is"
^DIC(9.4,53,22,20,"PAH",166,1,9,0)="looking at file #433 instead of #430.  If a contractual adjustment is"
^DIC(9.4,53,22,20,"PAH",166,1,10,0)="made, a Modified Billing Document is being sent to FMS instead of the"
^DIC(9.4,53,22,20,"PAH",166,1,11,0)="correct Write Off Document.  This problem only affects bills with a "
^DIC(9.4,53,22,20,"PAH",166,1,12,0)="category of 30 (tricare) or 32 (tricare third party) AND using a "
^DIC(9.4,53,22,20,"PAH",166,1,13,0)="contractual adjustment."
^DIC(9.4,53,22,20,"PAH",167,0)="227 SEQ #199^3050311^1"
^DIC(9.4,53,22,20,"PAH",167,1,0)="^^1^1^3050311"
^DIC(9.4,53,22,20,"PAH",167,1,1,0)="Patch to fix errors caused by bad records."
^DIC(9.4,53,22,20,"PAH",168,0)="159 SEQ #200^3050311^1"
^DIC(9.4,53,22,20,"PAH",168,1,0)="^^7^7^3050311"
^DIC(9.4,53,22,20,"PAH",168,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",168,1,2,0)="This patch will allow integrated sites to have multiple domains for"
^DIC(9.4,53,22,20,"PAH",168,1,3,0)="regional counsels."
^DIC(9.4,53,22,20,"PAH",168,1,4,0)="This redirects Vista transmissions to Regional Counsel to new RC addresses"
^DIC(9.4,53,22,20,"PAH",168,1,5,0)="for regular transmissions and Death Notifications."
^DIC(9.4,53,22,20,"PAH",168,1,6,0)=" "
^DIC(9.4,53,22,20,"PAH",168,1,7,0)="This patch also fixes and undefined error in routine RCRCREC."
^DIC(9.4,53,22,20,"PAH",169,0)="228 SEQ #201^3050813^1"
^DIC(9.4,53,22,20,"PAH",169,1,0)="^^1^1^3050813"
^DIC(9.4,53,22,20,"PAH",169,1,1,0)="Phase II, Part 1 of IB/AR Data Extract.  Changes as of 6/23/05."
^DIC(9.4,53,22,20,"PAH",170,0)="184 SEQ #202^3050905^1"
^DIC(9.4,53,22,20,"PAH",170,1,0)="^^6^6^3050905"
^DIC(9.4,53,22,20,"PAH",170,1,1,0)="This patch fixes the problem of setting the correct fiscal year for the "
^DIC(9.4,53,22,20,"PAH",170,1,2,0)="first few days of the new FY that fall in September. This patch also sets"
^DIC(9.4,53,22,20,"PAH",170,1,3,0)="the beginning Fiscal Year (BFY) for all 528701 - 528710 transactions"
^DIC(9.4,53,22,20,"PAH",170,1,4,0)="to ""05"".  This will be the BFY for all 5287 funds regardless or the FY."
^DIC(9.4,53,22,20,"PAH",170,1,5,0)="This patch also fixes the reversal date for the Account Receivable End"
^DIC(9.4,53,22,20,"PAH",170,1,6,0)="of Accounting Month processing and some misc. documentation changes."
^DIC(9.4,53,22,20,"PAH",171,0)="225 SEQ #203^3050924^1"
^DIC(9.4,53,22,20,"PAH",171,1,0)="^^5^5^3050924"
^DIC(9.4,53,22,20,"PAH",171,1,1,0)="This patch addresses 2 issues. The first issue is about the letters for"
^DIC(9.4,53,22,20,"PAH",171,1,2,0)="the CWT PROCEEDS and PARKING FEES bills which are not being generated so"
^DIC(9.4,53,22,20,"PAH",171,1,3,0)="vendors can not receive the notices about their bills. The second issue is"
^DIC(9.4,53,22,20,"PAH",171,1,4,0)="about the letter format which the address is printing too low to appear in"
^DIC(9.4,53,22,20,"PAH",171,1,5,0)="the envelope window."
^DIC(9.4,53,22,20,"PAH",172,0)="223 SEQ #204^3050924^1"
^DIC(9.4,53,22,20,"PAH",172,1,0)="^^20^20^3050924"
^DIC(9.4,53,22,20,"PAH",172,1,1,0)="Description:"
^DIC(9.4,53,22,20,"PAH",172,1,2,0)="==========="
^DIC(9.4,53,22,20,"PAH",172,1,3,0)=" "
^DIC(9.4,53,22,20,"PAH",172,1,4,0)="This patch contains 2 enhancements and resolves 1 NOIS."
^DIC(9.4,53,22,20,"PAH",172,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",172,1,6,0)="The Chief Business Office has requested additional enhancements to the"
^DIC(9.4,53,22,20,"PAH",172,1,7,0)="software that transmits the Patient Statements from the VAMC to the AAC."
^DIC(9.4,53,22,20,"PAH",172,1,8,0)=" "
^DIC(9.4,53,22,20,"PAH",172,1,9,0)=" "
^DIC(9.4,53,22,20,"PAH",172,1,10,0)="Description of enhancements:"
^DIC(9.4,53,22,20,"PAH",172,1,11,0)="---------------------------"
^DIC(9.4,53,22,20,"PAH",172,1,12,0)="1. Remove the ""In Part"" and ""In Full"" wording from the patient statements. "
^DIC(9.4,53,22,20,"PAH",172,1,13,0)="2. Identify patients to the AAC with will require larger print (font) on"
^DIC(9.4,53,22,20,"PAH",172,1,14,0)="   their billing statement."
^DIC(9.4,53,22,20,"PAH",172,1,15,0)=" "
^DIC(9.4,53,22,20,"PAH",172,1,16,0)=" "
^DIC(9.4,53,22,20,"PAH",172,1,17,0)=""
^DIC(9.4,53,22,20,"PAH",172,1,18,0)="This patch addresses the following NOIS message(s):"
^DIC(9.4,53,22,20,"PAH",172,1,19,0)="---------------------------------------------------"
^DIC(9.4,53,22,20,"PAH",172,1,20,0)="1. WIM-0402-20728"
^DIC(9.4,53,22,20,"PAH",173,0)="224 SEQ #205^3050924^1"
^DIC(9.4,53,22,20,"PAH",173,1,0)="^^4^4^3050924"
^DIC(9.4,53,22,20,"PAH",173,1,1,0)="This patch addresses one issues. The problem is that valid debts in"
^DIC(9.4,53,22,20,"PAH",173,1,2,0)="patient accounts which are not referred to TOP (Treasury Offset Program)"
^DIC(9.4,53,22,20,"PAH",173,1,3,0)="for collection when a repayment plan is established for one or more bills "
^DIC(9.4,53,22,20,"PAH",173,1,4,0)="but not all bills."
^DIC(9.4,53,22,20,"PAH",174,0)="234 SEQ #206^3051115^1"
^DIC(9.4,53,22,20,"PAH",174,1,0)="^^2^2^3051115"
^DIC(9.4,53,22,20,"PAH",174,1,1,0)="This patch reschedules the historical CBO extracts as one month of data "
^DIC(9.4,53,22,20,"PAH",174,1,2,0)="per extract."
^DIC(9.4,53,22,20,"PAH",175,0)="236 SEQ #207^3051202^1"
^DIC(9.4,53,22,20,"PAH",175,1,0)="^^2^2^3051202"
^DIC(9.4,53,22,20,"PAH",175,1,1,0)="This patch suspends new DMC and TOP referrals, through 2/28/06, for those"
^DIC(9.4,53,22,20,"PAH",175,1,2,0)="veterans affected by Hurricane Katrina."
^DIC(9.4,53,22,20,"PAH",176,0)="237 SEQ #208^3051221^1"
^DIC(9.4,53,22,20,"PAH",176,1,0)="^^10^10^3051221"
^DIC(9.4,53,22,20,"PAH",176,1,1,0)="This patch exempts interest and administrative charges "
^DIC(9.4,53,22,20,"PAH",176,1,2,0)="for Katrina affected veterans, calculated from 9/1/05"
^DIC(9.4,53,22,20,"PAH",176,1,3,0)="to patch installation. It also suspends the addition of"
^DIC(9.4,53,22,20,"PAH",176,1,4,0)="new interest and administrative charges for Katrina"
^DIC(9.4,53,22,20,"PAH",176,1,5,0)="affected patients. It also suspends the printing of CCPC"
^DIC(9.4,53,22,20,"PAH",176,1,6,0)="statements for those affected by Katrina."
^DIC(9.4,53,22,20,"PAH",176,1,7,0)="This patch also adds code to run the postinit to exempt "
^DIC(9.4,53,22,20,"PAH",176,1,8,0)="interest and administrative charges for newly flagged Katrina"
^DIC(9.4,53,22,20,"PAH",176,1,9,0)="patients. This will run prior to the TOP, DMC and CCPC statements"
^DIC(9.4,53,22,20,"PAH",176,1,10,0)="are generated."
^DIC(9.4,53,22,20,"PAH",177,0)="238 SEQ #209^3051221^1"
^DIC(9.4,53,22,20,"PAH",177,1,0)="^^4^4^3051221"
^DIC(9.4,53,22,20,"PAH",177,1,1,0)="This patch addresses two issues. The first is regarding the current fiscal"
^DIC(9.4,53,22,20,"PAH",177,1,2,0)="year 06 setting to the 5287 accounts which caused TR and OP documents "
^DIC(9.4,53,22,20,"PAH",177,1,3,0)="to be rejected in FMS.  The second is about an undefined error at line "
^DIC(9.4,53,22,20,"PAH",177,1,4,0)="DEC+8 in routine RCXFMST1 when processing receipts for EDI Lockbox."
^DIC(9.4,53,22,20,"PAH",178,0)="239 SEQ #210^3060213^1"
^DIC(9.4,53,22,20,"PAH",178,1,0)="^^5^5^3060213"
^DIC(9.4,53,22,20,"PAH",178,1,1,0)="Patch PRCA*4.5*239 contains modifications to the Bad Debt Report."
^DIC(9.4,53,22,20,"PAH",178,1,2,0)="These modifications were recommended by a management audit conducted"
^DIC(9.4,53,22,20,"PAH",178,1,3,0)="by the Systems Quality Assurance Service at the Austin"
^DIC(9.4,53,22,20,"PAH",178,1,4,0)="Automation Center.  Please refer to the patch description for"
^DIC(9.4,53,22,20,"PAH",178,1,5,0)="a concise list of enhancements included in this patch."
^DIC(9.4,53,22,20,"PAH",179,0)="242 SEQ #211^3060213^1"
^DIC(9.4,53,22,20,"PAH",179,1,0)="^^16^16^3060213"
^DIC(9.4,53,22,20,"PAH",179,1,1,0)="This patch contains a new option, the Emergency Response Report."
^DIC(9.4,53,22,20,"PAH",179,1,2,0)="This report has been placed under the Management Reports ... [PRCAD MANAGEMENT REPORT MENU] menu, located under the Report Menu"
^DIC(9.4,53,22,20,"PAH",179,1,3,0)="for Accounts Receivable ... [PRCAD REPORT MENU] menu option,"
^DIC(9.4,53,22,20,"PAH",179,1,4,0)="which is under the Clerk's AR Menu ... [PRCA CLERK MENU]."
^DIC(9.4,53,22,20,"PAH",179,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",179,1,6,0)="Sites should run this report to get a detailed or summary display"
^DIC(9.4,53,22,20,"PAH",179,1,7,0)="of the amount of funds that will be suspended due to Katrina"
^DIC(9.4,53,22,20,"PAH",179,1,8,0)="affected patients at their sites. The summary report will list, for the"
^DIC(9.4,53,22,20,"PAH",179,1,9,0)="site, the total balance (principle + Interest + administrative)"
^DIC(9.4,53,22,20,"PAH",179,1,10,0)="amounts of all of the affected veterans, the number of affected"
^DIC(9.4,53,22,20,"PAH",179,1,11,0)="veterans and the average amount suspended per veteran."
^DIC(9.4,53,22,20,"PAH",179,1,12,0)="The detailed listing will display, by affected veteran, the bills"
^DIC(9.4,53,22,20,"PAH",179,1,13,0)="whose payments are currently suspended until Feb 28, 2006"
^DIC(9.4,53,22,20,"PAH",179,1,14,0)="the principle amount, the interest and administrative amounts,"
^DIC(9.4,53,22,20,"PAH",179,1,15,0)="and the total amount per bill and total amount per patient."
^DIC(9.4,53,22,20,"PAH",179,1,16,0)=" "
^DIC(9.4,53,22,20,"PAH",180,0)="240 SEQ #212^3060308^1"
^DIC(9.4,53,22,20,"PAH",180,1,0)="^^9^9^3060308"
^DIC(9.4,53,22,20,"PAH",180,1,1,0)="This patch fixes 2 errors:"
^DIC(9.4,53,22,20,"PAH",180,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",180,1,3,0)="     1.An error in routine RCXVDC5 that caused the refill date of"
^DIC(9.4,53,22,20,"PAH",180,1,4,0)="       prescriptions to not transmit."
^DIC(9.4,53,22,20,"PAH",180,1,5,0)="     2.An error in routine RCXVDEQ that prevented some transactions and"
^DIC(9.4,53,22,20,"PAH",180,1,6,0)="       bills from transmitting to the ARC."
^DIC(9.4,53,22,20,"PAH",180,1,7,0)=" "
^DIC(9.4,53,22,20,"PAH",180,1,8,0)="It also queues the Active Bill transmission to the ARC at 8pm on the "
^DIC(9.4,53,22,20,"PAH",180,1,9,0)="date of the installation."
^DIC(9.4,53,22,20,"PAH",181,0)="231 SEQ #213^3060410^1"
^DIC(9.4,53,22,20,"PAH",181,1,0)="^^4^4^3060410"
^DIC(9.4,53,22,20,"PAH",181,1,1,0)="This patch addresses 1 issue. This change will allow the Revenue Source "
^DIC(9.4,53,22,20,"PAH",181,1,2,0)="code to contain alphanumeric characters as well as numbers in any of the"
^DIC(9.4,53,22,20,"PAH",181,1,3,0)="four positions.  The code is entered using the Enter/Edit Revenue Source"
^DIC(9.4,53,22,20,"PAH",181,1,4,0)="Code [PRCA FMS RSC ENTER/EDIT] option."
^DIC(9.4,53,22,20,"PAH",182,0)="229 SEQ #214^3060410^1"
^DIC(9.4,53,22,20,"PAH",183,0)="241 SEQ #215^3060504^1"
^DIC(9.4,53,22,20,"PAH",183,1,0)="^^7^7^3060504"
^DIC(9.4,53,22,20,"PAH",183,1,1,0)="Patch PRCA*4.5*241 is the last in a series of patches that will"
^DIC(9.4,53,22,20,"PAH",183,1,2,0)="adjust the accounts of veterans affected by Hurricane Katrina."
^DIC(9.4,53,22,20,"PAH",183,1,3,0)="This patch will exempt interest charges added to these veterans'"
^DIC(9.4,53,22,20,"PAH",183,1,4,0)="accounts between 8/29/06 and 2/28/06, and cancel all co-payment"
^DIC(9.4,53,22,20,"PAH",183,1,5,0)="charges billed to these veterans in this same period.  Integrated"
^DIC(9.4,53,22,20,"PAH",183,1,6,0)="Billing patch IB*2*340 must be installed before this patch can be"
^DIC(9.4,53,22,20,"PAH",183,1,7,0)="installed."
^DIC(9.4,53,22,20,"PAH",184,0)="230 SEQ #216^3060525^1"
^DIC(9.4,53,22,20,"PAH",184,1,0)="^^4^4^3060525"
^DIC(9.4,53,22,20,"PAH",184,1,1,0)="HIPAA NCPDP Global project"
^DIC(9.4,53,22,20,"PAH",184,1,2,0)=" "
^DIC(9.4,53,22,20,"PAH",184,1,3,0)="supports the electronic transmission outpatient prescription claims and "
^DIC(9.4,53,22,20,"PAH",184,1,4,0)="billing collection and management."
^DIC(9.4,53,22,20,"PAH",185,0)="246 SEQ #217^3060608^1"
^DIC(9.4,53,22,20,"PAH",185,1,0)="^^4^4^3060608"
^DIC(9.4,53,22,20,"PAH",185,1,1,0)="Patch PRCA*4.5*246 re-enables two Katrina-related functions"
^DIC(9.4,53,22,20,"PAH",185,1,2,0)="that became inactive on 4/30/06.  They are the option"
^DIC(9.4,53,22,20,"PAH",185,1,3,0)="Emergency Response Report and the patch PRCA*4.5*241"
^DIC(9.4,53,22,20,"PAH",185,1,4,0)="post-initialization process."
^DIC(9.4,53,22,20,"PAH",186,0)="243 SEQ #218^3060608^1"
^DIC(9.4,53,22,20,"PAH",186,1,0)="^^3^3^3060608"
^DIC(9.4,53,22,20,"PAH",186,1,1,0)="This patch adds four new fields to the VISTA IB-AR extract."
^DIC(9.4,53,22,20,"PAH",186,1,2,0)="It also fixes a subscript error when using the option:"
^DIC(9.4,53,22,20,"PAH",186,1,3,0)="[PRCAF ADJ ADMIN] Admisistrative Cost Adjustment."
^DIC(9.4,53,22,20,"PAH",187,0)="232 SEQ #219^3060923^1"
^DIC(9.4,53,22,20,"PAH",187,1,0)="^^1^1^3060923"
^DIC(9.4,53,22,20,"PAH",187,1,1,0)="AR IB EXTRACT PHASE II PART 2"
^DIC(9.4,53,22,20,"PAH",188,0)="235 SEQ #220^3060923^1"
^DIC(9.4,53,22,20,"PAH",188,1,0)="^^2^2^3060923"
^DIC(9.4,53,22,20,"PAH",188,1,1,0)="The Chief Business Office has requested a patch to correct the audit"
^DIC(9.4,53,22,20,"PAH",188,1,2,0)="problem when billing CHAMPVA Other Health Insurance."
^DIC(9.4,53,22,20,"PAH",189,0)="247 SEQ #221^3060923^1"
^DIC(9.4,53,22,20,"PAH",189,1,0)="^^13^13^3060923"
^DIC(9.4,53,22,20,"PAH",189,1,1,0)="This patch supports the National Council for Prescription Drug Programs "
^DIC(9.4,53,22,20,"PAH",189,1,2,0)="(NCPDP) standard which was adopted under the Healthcare Insurance"
^DIC(9.4,53,22,20,"PAH",189,1,3,0)="Portability and Accountability Act (HIPAA) for pharmacy claims. This patch"
^DIC(9.4,53,22,20,"PAH",189,1,4,0)="is one of six to be released.  Three patches will be released in a KIDS"
^DIC(9.4,53,22,20,"PAH",189,1,5,0)="multi-build distribution containing: BPS*1*3, PSO*7*247, and IB*2*342.  "
^DIC(9.4,53,22,20,"PAH",189,1,6,0)="Three patches will be released individually and they are: PRCA*4.5*247,"
^DIC(9.4,53,22,20,"PAH",189,1,7,0)="PSX*2*62, and PSS*1*115."
^DIC(9.4,53,22,20,"PAH",189,1,8,0)=" "
^DIC(9.4,53,22,20,"PAH",189,1,9,0)="Enhancements included in the release of the six patches are a new option "
^DIC(9.4,53,22,20,"PAH",189,1,10,0)="that will enable the user to reopen a closed Electronic Claims Management"
^DIC(9.4,53,22,20,"PAH",189,1,11,0)="Engine (ECME) claim; updates to the Rx Activity Log; and permanent storage"
^DIC(9.4,53,22,20,"PAH",189,1,12,0)="of Claims activity information as reported by the ECME Billing Events"
^DIC(9.4,53,22,20,"PAH",189,1,13,0)="Report."
^DIC(9.4,53,22,20,"PAH",190,0)="244 SEQ #222^3061227.143049^1"
^DIC(9.4,53,22,20,"PAH",190,1,0)="^^11^11^3061227"
^DIC(9.4,53,22,20,"PAH",190,1,1,0)="This patch addresses 4 issues. The first issue is that site requested to"
^DIC(9.4,53,22,20,"PAH",190,1,2,0)="limit the credit card number which is printed on the patient's receipt"
^DIC(9.4,53,22,20,"PAH",190,1,3,0)="for security issue. The second issue is about the software that calculates"
^DIC(9.4,53,22,20,"PAH",190,1,4,0)="an estimate for what a patient will be charged for prescriptions that are"
^DIC(9.4,53,22,20,"PAH",190,1,5,0)="awaiting release was not updated to correctly reflect the new $8 copay"
^DIC(9.4,53,22,20,"PAH",190,1,6,0)="amount."
^DIC(9.4,53,22,20,"PAH",190,1,7,0)=" "
^DIC(9.4,53,22,20,"PAH",190,1,8,0)="The third issue indicates an undefined error that site received when they"
^DIC(9.4,53,22,20,"PAH",190,1,9,0)="queued the report to P-MESSAGE in the EFT Deposit Reconciliation Report."
^DIC(9.4,53,22,20,"PAH",190,1,10,0)="The fourth issue contains the same error occurring in the same report "
^DIC(9.4,53,22,20,"PAH",190,1,11,0)="above when site queued the report to a spool."
^DIC(9.4,53,22,20,"PAH",191,0)="248 SEQ #223^3070629.190413^1"
^DIC(9.4,53,22,20,"PAH",191,1,0)="^^1^1^3070629"
^DIC(9.4,53,22,20,"PAH",191,1,1,0)="CBO Data Extract NPI enhancement"
^DIC(9.4,53,22,20,"PAH",192,0)="245 SEQ #224^3070905.013229^1"
^DIC(9.4,53,22,20,"PAH",192,1,0)="^^5^5^3070905"
^DIC(9.4,53,22,20,"PAH",192,1,1,0)="This patch is being released in conjunction with the Pharmacy "
^DIC(9.4,53,22,20,"PAH",192,1,2,0)="Reengineering Encapsulation effort. While no new functionality for the "
^DIC(9.4,53,22,20,"PAH",192,1,3,0)="Integrated Billing package is released with this patch, all direct global "
^DIC(9.4,53,22,20,"PAH",192,1,4,0)="references to the Outpatient Pharmacy files have been replaced by this "
^DIC(9.4,53,22,20,"PAH",192,1,5,0)="effort."
^DIC(9.4,53,22,20,"PAH",193,0)="251 SEQ #225^3071212.210157^1"
^DIC(9.4,53,22,20,"PAH",194,0)="250 SEQ #226^3071212.210652^1"
^DIC(9.4,53,22,20,"PAH",194,1,0)="^^6^6^3071212"
^DIC(9.4,53,22,20,"PAH",194,1,1,0)="This patch is being implemented in support of the Automated Service "
^DIC(9.4,53,22,20,"PAH",194,1,2,0)="Connected Designation (ASCD) project. The ASCD project has a Recovered "
^DIC(9.4,53,22,20,"PAH",194,1,3,0)="Cost Report where they want to look for bills and payments for encounters "
^DIC(9.4,53,22,20,"PAH",194,1,4,0)="that have had their Service Connected status changed by the ASCD options. "
^DIC(9.4,53,22,20,"PAH",194,1,5,0)="This project has requested access to the Accounts Receivable (AR) package "
^DIC(9.4,53,22,20,"PAH",194,1,6,0)="data in support of this report."
^DIC(9.4,53,22,20,"PAH",195,0)="255 SEQ #227^3071212.223827^1"
^DIC(9.4,53,22,20,"PAH",195,1,0)="^^2^2^3071212"
^DIC(9.4,53,22,20,"PAH",195,1,1,0)="This patch will update the deposit ticket number series with"
^DIC(9.4,53,22,20,"PAH",195,1,2,0)="""569""xxx for the EDI Lockbox process."
^DIC(9.4,53,22,20,"PAH",196,0)="256 SEQ #228^3080526.155035^1"
^DIC(9.4,53,22,20,"PAH",196,1,0)="^^3^3^3080526"
^DIC(9.4,53,22,20,"PAH",196,1,1,0)="This patch is addressing the issue regarding all the Third Party bills"
^DIC(9.4,53,22,20,"PAH",196,1,2,0)="associated with only revenue codes for pharmacy that are missed in"
^DIC(9.4,53,22,20,"PAH",196,1,3,0)="the CBO AR Data Extract process."
^DIC(9.4,53,22,20,"PAH",197,0)="249 SEQ #229^3080722.073828^1"
^DIC(9.4,53,22,20,"PAH",197,1,0)="^^8^8^3080722"
^DIC(9.4,53,22,20,"PAH",197,1,1,0)="This patch addresses 5 issues. The first issue is regarding the OBR"
^DIC(9.4,53,22,20,"PAH",197,1,2,0)="(AR/FMS) data that has been incorrectly deleted in the OBR Reconciliation"
^DIC(9.4,53,22,20,"PAH",197,1,3,0)="report. The secondary issue is about the coding error in routine RCDPEX32."
^DIC(9.4,53,22,20,"PAH",197,1,4,0)="The third issue is regarding the billing information that was missing in"
^DIC(9.4,53,22,20,"PAH",197,1,5,0)="the transmission message that is sent to the department of Justice or"
^DIC(9.4,53,22,20,"PAH",197,1,6,0)="Regional Counsel. The fourth issue is regarding the <UNDEFINED> error at"
^DIC(9.4,53,22,20,"PAH",197,1,7,0)="line Q3+2^PRCASVC when returns a bill's FMS fund code. The last issue"
^DIC(9.4,53,22,20,"PAH",197,1,8,0)="is about the SSN showing on the reprint of the statements at site."
^DIC(9.4,53,22,20,"PAH",198,0)="254 SEQ #230^3080722.0753^1"
^DIC(9.4,53,22,20,"PAH",198,1,0)="^^1^1^3080722"
^DIC(9.4,53,22,20,"PAH",198,1,1,0)="eClaims Plus Iteration 3, phase 2 (the AR part of phase 2)"
^DIC(9.4,53,22,20,"PAH",199,0)="252 SEQ #231^3090420.160618^1"
^DIC(9.4,53,22,20,"PAH",199,1,0)="^^1^1^3090420"
^DIC(9.4,53,22,20,"PAH",199,1,1,0)="Updates to the EEOB Worklist."
^DIC(9.4,53,22,20,"PAH",200,0)="253 SEQ #232^3090420.160737^1"
^DIC(9.4,53,22,20,"PAH",200,1,0)="^^20^20^3090420"
^DIC(9.4,53,22,20,"PAH",200,1,1,0)="This build is for the PRCA*4.5*253 patch which is for the ""Hold Debt to"
^DIC(9.4,53,22,20,"PAH",200,1,2,0)="DMC"" project. This will provide an enhancement to help avoid inappropriate"
^DIC(9.4,53,22,20,"PAH",200,1,3,0)="debt referrals to Debt Management Center (DMC) for veterans who are either"
^DIC(9.4,53,22,20,"PAH",200,1,4,0)="Service Connection (SC) 50% to 100% or in receipt of a VA pension."
^DIC(9.4,53,22,20,"PAH",200,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",200,1,6,0)="This patch will modify the existing VistA AR application to:"
^DIC(9.4,53,22,20,"PAH",200,1,7,0)="    a.  Enhance the existing VistA software DMC logic to exclude DMC"
^DIC(9.4,53,22,20,"PAH",200,1,8,0)="        eligible debts associated with veterans who are SC 50% to 100% or"
^DIC(9.4,53,22,20,"PAH",200,1,9,0)="        in receipt of VA pension from being referred to the DMC."
^DIC(9.4,53,22,20,"PAH",200,1,10,0)="    b.  Introduce a new ""DMC Debt Valid"" field in the Accounts Receivable"
^DIC(9.4,53,22,20,"PAH",200,1,11,0)="        application."
^DIC(9.4,53,22,20,"PAH",200,1,12,0)="    c.  Create a new report option in AR for Veterans who are SC 50% to"
^DIC(9.4,53,22,20,"PAH",200,1,13,0)="        100% or in receipt of a VA pension."
^DIC(9.4,53,22,20,"PAH",200,1,14,0)="    d.  Create a new report option in AR to assist the AR Supervisors in"
^DIC(9.4,53,22,20,"PAH",200,1,15,0)="        reviewing the processing of the bills for Veterans who are SC 50%"
^DIC(9.4,53,22,20,"PAH",200,1,16,0)="        to 100% or in receipt of VA pension."
^DIC(9.4,53,22,20,"PAH",200,1,17,0)="    e.  Create a new report option in AR to assist users in focusing on"
^DIC(9.4,53,22,20,"PAH",200,1,18,0)="        reviewing the legitimacy of bills where the veteran has a Rated"
^DIC(9.4,53,22,20,"PAH",200,1,19,0)="        Disability change during a given time period and is neither SC 50%"
^DIC(9.4,53,22,20,"PAH",200,1,20,0)="        to 100% nor in receipt of VA Pension."
^DIC(9.4,53,22,20,"PAH",201,0)="257 SEQ #233^3090421.160034^17"
^DIC(9.4,53,22,20,"PAH",201,1,0)="^^36^36^3090421"
^DIC(9.4,53,22,20,"PAH",201,1,1,0)="This patch is being implemented in support of the ""AR Changes for Deposit"
^DIC(9.4,53,22,20,"PAH",201,1,2,0)="Ticket Number"" project. This is an enhancement to the Accounts Receivable"
^DIC(9.4,53,22,20,"PAH",201,1,3,0)="(AR) System to allow for 9 Digit Deposit Ticket Numbers and to prevent"
^DIC(9.4,53,22,20,"PAH",201,1,4,0)="users from entering Deposit Ticket Numbers beginning with 669."
^DIC(9.4,53,22,20,"PAH",201,1,5,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,6,0)="This change is a result of a mandate by the Department of Treasury to use"
^DIC(9.4,53,22,20,"PAH",201,1,7,0)="their contracted bank for all credit card processing.  To prevent a loss"
^DIC(9.4,53,22,20,"PAH",201,1,8,0)="in revenue for these credit card transactions, the VA must comply with the"
^DIC(9.4,53,22,20,"PAH",201,1,9,0)="Treasury mandate and be able to accept the new deposit number schema from"
^DIC(9.4,53,22,20,"PAH",201,1,10,0)="the Treasury contracted bank.  This is a high priority project to prevent"
^DIC(9.4,53,22,20,"PAH",201,1,11,0)="loss of revenue and ensure veteran satisfaction by continuing to allow"
^DIC(9.4,53,22,20,"PAH",201,1,12,0)="them to pay their first party bills using credit cards"
^DIC(9.4,53,22,20,"PAH",201,1,13,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,14,0)="This patch will modify the existing VistA AR application to do the"
^DIC(9.4,53,22,20,"PAH",201,1,15,0)="following:"
^DIC(9.4,53,22,20,"PAH",201,1,16,0)="     a. Expand field length to 9 digits for deposit ticket number to"
^DIC(9.4,53,22,20,"PAH",201,1,17,0)="        accommodate new unique sequence to prevent duplication of deposit"
^DIC(9.4,53,22,20,"PAH",201,1,18,0)="        ticket numbers."
^DIC(9.4,53,22,20,"PAH",201,1,19,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,20,0)="        Note: 9-digit deposit ticket numbers will only be allowed for"
^DIC(9.4,53,22,20,"PAH",201,1,21,0)="        payments processed through the AR Automatic Payment Processing"
^DIC(9.4,53,22,20,"PAH",201,1,22,0)="        Server. Manual entry will continue to be limited to 6 digits."
^DIC(9.4,53,22,20,"PAH",201,1,23,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,24,0)="     b. Remove the ability for sites to create local deposit tickets that"
^DIC(9.4,53,22,20,"PAH",201,1,25,0)="        begin with the 669 prefix as it is reserved for electronic check"
^DIC(9.4,53,22,20,"PAH",201,1,26,0)="        deposit tickets."
^DIC(9.4,53,22,20,"PAH",201,1,27,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,28,0)="No changes were required to allow the 9-digit deposit ticket numbers to be"
^DIC(9.4,53,22,20,"PAH",201,1,29,0)="displayed in the AR Options and Report, or for the interface which send"
^DIC(9.4,53,22,20,"PAH",201,1,30,0)="this data to the FMS system."
^DIC(9.4,53,22,20,"PAH",201,1,31,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,32,0)="Additional documentation on this project can be found in the project"
^DIC(9.4,53,22,20,"PAH",201,1,33,0)="notebook for ""AR Changes for Deposit Ticket Number"" which is in the VA"
^DIC(9.4,53,22,20,"PAH",201,1,34,0)="Health IT (VHIT) Project Repository (TSPR). The link is:"
^DIC(9.4,53,22,20,"PAH",201,1,35,0)=" "
^DIC(9.4,53,22,20,"PAH",201,1,36,0)="      http://tspr.vista.domain.ext/warboard/anotebk.asp?proj=1274"
^DIC(9.4,53,22,20,"PAH",202,0)="258 SEQ #234^3090813.155343^17"
^DIC(9.4,53,22,20,"PAH",203,0)="219 SEQ #235^3091022.104929^17"
^DIC(9.4,53,22,20,"PAH",203,1,0)="^^5^5^3091022"
^DIC(9.4,53,22,20,"PAH",203,1,1,0)="This patch addresses two related issues that involve the patient statement"
^DIC(9.4,53,22,20,"PAH",203,1,2,0)="print functionality. First, the third statement is now printed when"
^DIC(9.4,53,22,20,"PAH",203,1,3,0)="necessary even if there has been no activity except interest/admin"
^DIC(9.4,53,22,20,"PAH",203,1,4,0)="charges.  Second, the messages from option [PRCA ACCOUNT CHECK] have"
^DIC(9.4,53,22,20,"PAH",203,1,5,0)="been adjusted to be consistent with the above."
^DIC(9.4,53,22,20,"PAH",204,0)="259 SEQ #236^3091118.095607^17"
^DIC(9.4,53,22,20,"PAH",204,1,0)="^^3^3^3091118"
^DIC(9.4,53,22,20,"PAH",204,1,1,0)="This patch addresses 1 issue."
^DIC(9.4,53,22,20,"PAH",204,1,2,0)="The issue pertains to ex-employee bills that are not sent to TOP"
^DIC(9.4,53,22,20,"PAH",204,1,3,0)="because the third letter is not printed if the bill is less than $25."
^DIC(9.4,53,22,20,"PAH",205,0)="233 SEQ #237^3100504.095131^17"
^DIC(9.4,53,22,20,"PAH",205,1,0)="^^5^5^3100504"
^DIC(9.4,53,22,20,"PAH",205,1,1,0)="This patch addresses two issues. The first is about that site requested to"
^DIC(9.4,53,22,20,"PAH",205,1,2,0)="enter a bill for more than the unit cost limit of 999999 in the NEW BILL"
^DIC(9.4,53,22,20,"PAH",205,1,3,0)="(ENTER) option. The second is about that site asked to remove the veteran"
^DIC(9.4,53,22,20,"PAH",205,1,4,0)="name and a portion of SSN from the message subject line due to the new"
^DIC(9.4,53,22,20,"PAH",205,1,5,0)="security posture of the VA."
^DIC(9.4,53,22,20,"PAH",206,0)="268 SEQ #238^3100610.100025^17"
^DIC(9.4,53,22,20,"PAH",206,1,0)="^^1^1^3100610"
^DIC(9.4,53,22,20,"PAH",206,1,1,0)="ESTIMATED RX COPAY FIX"
^DIC(9.4,53,22,20,"PAH",207,0)="128 SEQ #106^3100809.113729^17"
^DIC(9.4,53,22,20,"PAH",207,1,0)="^^2^2^3100809"
^DIC(9.4,53,22,20,"PAH",207,1,1,0)="Warning for unapplied amount."
^DIC(9.4,53,22,20,"PAH",207,1,2,0)="NOIS PRO-0998-10071"
^DIC(9.4,53,22,20,"PAH",208,0)="272 SEQ #239^3100921.150727^17"
^DIC(9.4,53,22,20,"PAH",208,1,0)="^^4^4^3100921"
^DIC(9.4,53,22,20,"PAH",208,1,1,0)="This patch addresses 1 issue:"
^DIC(9.4,53,22,20,"PAH",208,1,2,0)="1. Some bills in the Office of the Inspector General (OIG) extract "
^DIC(9.4,53,22,20,"PAH",208,1,3,0)="   of the Accounts Receivable Data Collector (ARDC) are reported "
^DIC(9.4,53,22,20,"PAH",208,1,4,0)="   in the wrong General Ledger (GL) number and need to be corrected."
^DIC(9.4,53,22,20,"PAH",209,0)="274 SEQ #240^3101214.105322^17"
^DIC(9.4,53,22,20,"PAH",209,1,0)="^^2^2^3101214"
^DIC(9.4,53,22,20,"PAH",209,1,1,0)="Incorrect Station Numbers on Tricare claims are leading to rejections at"
^DIC(9.4,53,22,20,"PAH",209,1,2,0)="Financial Management System (FMS)."
^DIC(9.4,53,22,20,"PAH",210,0)="262 SEQ #241^3110104.143432^17"
^DIC(9.4,53,22,20,"PAH",210,1,0)="^^4^4^3110104"
^DIC(9.4,53,22,20,"PAH",210,1,1,0)="This patch addresses 2 issues. The first issue is regarding missing"
^DIC(9.4,53,22,20,"PAH",210,1,2,0)="batches when running the CBO Data Extract process. The second issue is"
^DIC(9.4,53,22,20,"PAH",210,1,3,0)="about a local array not being killed properly in the RCDPE Exception"
^DIC(9.4,53,22,20,"PAH",210,1,4,0)="Process option."
^DIC(9.4,53,22,20,"PAH",211,0)="263 SEQ #242^3110120.132222^17"
^DIC(9.4,53,22,20,"PAH",211,1,0)="^^7^7^3110120"
^DIC(9.4,53,22,20,"PAH",211,1,1,0)="This patch will correct references for Revenue Codes charges and "
^DIC(9.4,53,22,20,"PAH",211,1,2,0)="Prosthetics data information when transmitting bills to Regional Counsel "
^DIC(9.4,53,22,20,"PAH",211,1,3,0)="(RC)."
^DIC(9.4,53,22,20,"PAH",211,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",211,1,5,0)="This patch will also fix a display format problem for the Transactions "
^DIC(9.4,53,22,20,"PAH",211,1,6,0)="section of the Profile of Accounts Receivable option. The changes will "
^DIC(9.4,53,22,20,"PAH",211,1,7,0)="let the display easier to read by the viewer."
^DIC(9.4,53,22,20,"PAH",212,0)="273 SEQ #243^3110404.142322^17"
^DIC(9.4,53,22,20,"PAH",213,0)="261 SEQ #244^3110407.101216^17"
^DIC(9.4,53,22,20,"PAH",213,1,0)="^^3^3^3110407"
^DIC(9.4,53,22,20,"PAH",213,1,1,0)="This patch will fix a line tag with a wrong routine name when queuing an "
^DIC(9.4,53,22,20,"PAH",213,1,2,0)="AR - Print ERA Discrepancy Report from the EEOB Worklist [RCDPE EDI "
^DIC(9.4,53,22,20,"PAH",213,1,3,0)="LOCKBOX WORKLIST]."
^DIC(9.4,53,22,20,"PAH",214,0)="264 SEQ #245^3110428.16151^17"
^DIC(9.4,53,22,20,"PAH",214,1,0)="^^6^6^3110428"
^DIC(9.4,53,22,20,"PAH",214,1,1,0)="This patch addresses two issues.  The first issue is regarding the EEOB"
^DIC(9.4,53,22,20,"PAH",214,1,2,0)="WORKLIST option showing the unrelated Explanation of Benefit (EOB) results"
^DIC(9.4,53,22,20,"PAH",214,1,3,0)="on a selected electronic remittance advice (ERA)."
^DIC(9.4,53,22,20,"PAH",214,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",214,1,5,0)="The second issue is about the ""***Trans # xxxxxxxx REQUST QUEUED ***"""
^DIC(9.4,53,22,20,"PAH",214,1,6,0)="message incorrectly appearing in the Brief Account Profile option."
^DIC(9.4,53,22,20,"PAH",215,0)="270 SEQ #246^3110526.111659^17"
^DIC(9.4,53,22,20,"PAH",215,1,0)="^^1^1^3110526"
^DIC(9.4,53,22,20,"PAH",215,1,1,0)="E-Billing Iteration 4, enhancement 6, Preserve claim#"
^DIC(9.4,53,22,20,"PAH",216,0)="269^3110901.101424^17"
^DIC(9.4,53,22,20,"PAH",216,1,0)="^^1^1^3110901"
^DIC(9.4,53,22,20,"PAH",216,1,1,0)="FMS 5010 CHANGES"
^DIC(9.4,53,22,20,"PAH",217,0)="271^3111102.120245^17"
^DIC(9.4,53,22,20,"PAH",217,1,0)="^^1^1^3111102"
^DIC(9.4,53,22,20,"PAH",217,1,1,0)="ePharmacy Phase 5 - NCPDP D.0"
^DIC(9.4,53,22,20,"PAH",218,0)="276 SEQ #250^3120112.140615^17"
^DIC(9.4,53,22,20,"PAH",219,0)="275^3120221.144205^17"
^DIC(9.4,53,22,20,"PAH",219,1,0)="^^241^241^3120221"
^DIC(9.4,53,22,20,"PAH",219,1,1,0)="This Integrated Billing (IB) patch expands the HIPAA 5010 "
^DIC(9.4,53,22,20,"PAH",219,1,2,0)="enhancements "
^DIC(9.4,53,22,20,"PAH",219,1,3,0)="introduced in patch IB*2.0*432."
^DIC(9.4,53,22,20,"PAH",219,1,4,0)=" "
^DIC(9.4,53,22,20,"PAH",219,1,5,0)="The intent of this patch is to:"
^DIC(9.4,53,22,20,"PAH",219,1,6,0)="1. Modify the Third Party Joint Inquiry option [IBJ THIRD PARTY JOINT"
^DIC(9.4,53,22,20,"PAH",219,1,7,0)="   INQUIRY] to allow up to 10 characters of an inactive claim number to"
^DIC(9.4,53,22,20,"PAH",219,1,8,0)="   display."
^DIC(9.4,53,22,20,"PAH",219,1,9,0)=" "
^DIC(9.4,53,22,20,"PAH",219,1,10,0)="2. Modify the Full Account Profile option [PRCAY FULL ACCOUNT PROFILE] to"
^DIC(9.4,53,22,20,"PAH",219,1,11,0)="   allow up to 10 characters of an inactive claim number to display."
^DIC(9.4,53,22,20,"PAH",219,1,12,0)=" "
^DIC(9.4,53,22,20,"PAH",219,1,13,0)="3. Create the processes to support the receipt, storage and display of"
^DIC(9.4,53,22,20,"PAH",219,1,14,0)="   Medicare deductible information from Trailblazer Health care"
^DIC(9.4,53,22,20,"PAH",219,1,15,0)="   Enterprise."
^DIC(9.4,53,22,20,"PAH",219,1,16,0)=" "
^DIC(9.4,53,22,20,"PAH",219,1,17,0)="4. Create a new option called the Medicare Deductible Alert Worklist [PRCA"
^DIC(9.4,53,22,20,"PAH",219,1,18,0)="   MDA Worklist] from which users can view Medicare deductible "
^DIC(9.4,53,22,20,"PAH",219,1,19,0)="   information."
^DIC(9.4,53,22,20,"PAH",219,1,20,0)=" "
^DIC(9.4,53,22,20,"PAH",219,1,21,0)=" "
^DIC(9.4,53,22,20,"PAH",219,1,22,0)="Patch Components"
^DIC(9.4,53,22,20,"PAH",219,1,23,0)="================"
^DIC(9.4,53,22,20,"PAH",219,1,24,0)="<Additional patch components can be added alphabetically if needed.>"
