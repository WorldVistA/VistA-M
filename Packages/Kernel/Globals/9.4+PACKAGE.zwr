^DIC(9.4,60,22,13,"PAH",584,1,131,0)="  - When presented with a suggestion the user is given 3 options: (A)ccept,"
^DIC(9.4,60,22,13,"PAH",584,1,132,0)="    (F)orget or (E)xit:"
^DIC(9.4,60,22,13,"PAH",584,1,133,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,134,0)="    ACCEPT - Accepts the suggested VistA Provider and matches it to the eRx"
^DIC(9.4,60,22,13,"PAH",584,1,135,0)="    FORGET - Forgets this suggested VistA Provider so that it is not "
^DIC(9.4,60,22,13,"PAH",584,1,136,0)="             presented again in the future to any user"
^DIC(9.4,60,22,13,"PAH",584,1,137,0)="    EXIT   - Exits and proceed to match the VistA Provider manually"
^DIC(9.4,60,22,13,"PAH",584,1,138,0)=" "
^DIC(9.4,60,22,13,"PAH",584,1,139,0)="    If more than one suggestion exists, then a 4th option is included: (N)ext:"
^DIC(9.4,60,22,13,"PAH",584,1,140,0)=" "
