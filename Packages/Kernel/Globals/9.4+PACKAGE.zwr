^DIC(9.4,14,22,5.9,"PAH",110,0)="262 SEQ #208^3010423^1"
^DIC(9.4,14,22,5.9,"PAH",110,1,0)="^^193^193^3010423"
^DIC(9.4,14,22,5.9,"PAH",110,1,1,0)="VISTA Laboratory Package patch LR*5.2*262 contains no changes to software"
^DIC(9.4,14,22,5.9,"PAH",110,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,14,22,5.9,"PAH",110,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,5,0)="DESCRIPTION"
^DIC(9.4,14,22,5.9,"PAH",110,1,6,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",110,1,7,0)="This patch will address a fix to the Lab Universal Interface Auto Download"
^DIC(9.4,14,22,5.9,"PAH",110,1,8,0)="requested in E3R #13785 - LRPHMAN & LRPHEXCPT BOTH SENDING HL7 MESSAGE."
^DIC(9.4,14,22,5.9,"PAH",110,1,9,0)="During development of patch LA*5.2*57, it was determined that the software"
^DIC(9.4,14,22,5.9,"PAH",110,1,10,0)="logic in the collection list receipt process was not submitting all"
^DIC(9.4,14,22,5.9,"PAH",110,1,11,0)="accessions on a lab order to the Lab Universal Interface Auto Download."
^DIC(9.4,14,22,5.9,"PAH",110,1,12,0)="Routine LRPHITEM was only submitting the accession associated with the "
^DIC(9.4,14,22,5.9,"PAH",110,1,13,0)="last test on a Lab order to the auto download process. This patch corrects"
^DIC(9.4,14,22,5.9,"PAH",110,1,14,0)="this logic error. It will now scan all tests on a given order and submit"
^DIC(9.4,14,22,5.9,"PAH",110,1,15,0)="to the auto download process those accessions associated with the lab order."
^DIC(9.4,14,22,5.9,"PAH",110,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,18,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,19,0)="ASSOCIATED E3R'S"
^DIC(9.4,14,22,5.9,"PAH",110,1,20,0)="----------------"
^DIC(9.4,14,22,5.9,"PAH",110,1,21,0)="#13785 - LRPHMAN & LRPHEXCPT BOTH SENDING HL7 MESSAGE"
^DIC(9.4,14,22,5.9,"PAH",110,1,22,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,23,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,24,0)="TEST SITES"
^DIC(9.4,14,22,5.9,"PAH",110,1,25,0)="----------"
^DIC(9.4,14,22,5.9,"PAH",110,1,26,0)=" Asheville VAMC"
^DIC(9.4,14,22,5.9,"PAH",110,1,27,0)=" Boston HCS"
^DIC(9.4,14,22,5.9,"PAH",110,1,28,0)=" Central Plains HCS"
^DIC(9.4,14,22,5.9,"PAH",110,1,29,0)=" Indianapolis VAMC"
^DIC(9.4,14,22,5.9,"PAH",110,1,30,0)=" Milwaukee VAMC"
^DIC(9.4,14,22,5.9,"PAH",110,1,31,0)=" San Antonio VAMC"
^DIC(9.4,14,22,5.9,"PAH",110,1,32,0)=" San Diego VAMC"
^DIC(9.4,14,22,5.9,"PAH",110,1,33,0)=" Tennessee Valley HCS"
^DIC(9.4,14,22,5.9,"PAH",110,1,34,0)=" Upstate New York HCS "
^DIC(9.4,14,22,5.9,"PAH",110,1,35,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,36,0)="  "
^DIC(9.4,14,22,5.9,"PAH",110,1,37,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",110,1,38,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",110,1,39,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",110,1,40,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",110,1,41,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",110,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,43,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",110,1,44,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",110,1,45,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",110,1,46,0)="   LR262            N/A            4332130        **262**(deleted by Kernel)"
^DIC(9.4,14,22,5.9,"PAH",110,1,47,0)="   LRPHITEM         14270617       12142394       **121,198,208,202,221,262**"
^DIC(9.4,14,22,5.9,"PAH",110,1,48,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,49,0)="List of preceding patches: 221"
^DIC(9.4,14,22,5.9,"PAH",110,1,50,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",110,1,51,0)="  "
^DIC(9.4,14,22,5.9,"PAH",110,1,52,0)="************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",110,1,53,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,54,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",110,1,55,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",110,1,56,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,57,0)="  The install time for this patch is less than 5 minutes. This patch"
^DIC(9.4,14,22,5.9,"PAH",110,1,58,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",110,1,59,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",110,1,60,0)="  The install will disable several Lab option as specified in #7 below."
^DIC(9.4,14,22,5.9,"PAH",110,1,61,0)="  Building and receipting of collection lists should not be occurring"
^DIC(9.4,14,22,5.9,"PAH",110,1,62,0)="  within the Laboratory package."
^DIC(9.4,14,22,5.9,"PAH",110,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,65,0)="NOTE: Kernel patches must be current on the target system"
^DIC(9.4,14,22,5.9,"PAH",110,1,66,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",110,1,67,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,68,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",110,1,69,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",110,1,70,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,72,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",110,1,73,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,74,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",110,1,75,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",110,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,77,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",110,1,78,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",110,1,79,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,80,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",110,1,81,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",110,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,83,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",110,1,84,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",110,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,86,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",110,1,87,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",110,1,88,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",110,1,89,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",110,1,90,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",110,1,91,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,92,0)="      If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,14,22,5.9,"PAH",110,1,93,0)="      prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,14,22,5.9,"PAH",110,1,94,0)="      option at this time.  You may also compare the routines in your"
^DIC(9.4,14,22,5.9,"PAH",110,1,95,0)="      production account to the routines in the patch by using the 'Compare"
^DIC(9.4,14,22,5.9,"PAH",110,1,96,0)="      a Transport Global to Current System' option."
^DIC(9.4,14,22,5.9,"PAH",110,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,98,0)="  7.  The install will disable the following Lab options during patch"
^DIC(9.4,14,22,5.9,"PAH",110,1,99,0)="      installation."
^DIC(9.4,14,22,5.9,"PAH",110,1,100,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,101,0)="      Receipt of routine lab collection from wards [LRPHEXCPT]"
^DIC(9.4,14,22,5.9,"PAH",110,1,102,0)="      Itemized routine lab collection [LRPHITEM]"
^DIC(9.4,14,22,5.9,"PAH",110,1,103,0)="      Add to collection list [LRPHMAN]"
^DIC(9.4,14,22,5.9,"PAH",110,1,104,0)="  "
^DIC(9.4,14,22,5.9,"PAH",110,1,105,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",110,1,106,0)="      and select the package 'LR*5.2*262'.  When prompted 'Want to"
^DIC(9.4,14,22,5.9,"PAH",110,1,107,0)="      DISABLE Scheduled Options, Menu Options, and Protocols? YES//',"
^DIC(9.4,14,22,5.9,"PAH",110,1,108,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",110,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,110,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",110,1,111,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,112,0)=" 10. Routine LR262 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",110,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,114,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,115,0)="POST-INSTALLATION INSTRUCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",110,1,116,0)="==============================="
^DIC(9.4,14,22,5.9,"PAH",110,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,118,0)="NONE"
^DIC(9.4,14,22,5.9,"PAH",110,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,120,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,121,0)="************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",110,1,122,0)="Installation example:"
^DIC(9.4,14,22,5.9,"PAH",110,1,123,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,124,0)="Select INSTALL NAME:    LR*5.2*262     Loaded from Distribution  6/8/00@11:32:29"
^DIC(9.4,14,22,5.9,"PAH",110,1,125,0)="     => LR*5.2*262"
^DIC(9.4,14,22,5.9,"PAH",110,1,126,0)=" "
^DIC(9.4,14,22,5.9,"PAH",110,1,127,0)="This Distribution was loaded on Jun 08, 2000@11:32:29 with header of"
^DIC(9.4,14,22,5.9,"PAH",110,1,128,0)="   LR*5.2*262"
^DIC(9.4,14,22,5.9,"PAH",110,1,129,0)="   It consisted of the following Install(s):"
^DIC(9.4,14,22,5.9,"PAH",110,1,130,0)="     LR*5.2*262"
