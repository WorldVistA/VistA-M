^DIC(9.4,127,0)="SURGERY^SR^SURGICAL DATA COLLECTION AND OPERATIONS SCHEDULING"
^DIC(9.4,127,1,0)="^9.41A^5^5^3181217^^^^"
^DIC(9.4,127,1,1,0)="The DHCP Surgery package is used to enter/edit and display information"
^DIC(9.4,127,1,2,0)="related to the Surgical Service.  It will track surgical cases, provide"
^DIC(9.4,127,1,3,0)="useful management reports, and produce the necessary documentation for"
^DIC(9.4,127,1,4,0)="all surgical cases."
^DIC(9.4,127,1,5,0)=" "
