^DIC(9.4,14,22,5.9,"PAH",226,1,136,0)="LRHY PATIENT WAIT TIME          run routine             NEW      "
^DIC(9.4,14,22,5.9,"PAH",226,1,137,0)="LRHY PHLEBOTOMY LOG             run routine             NEW        "
