^DIC(9.4,127,"DEV")="MICHAEL MONTALI/B'HAM ISC"
^DIC(9.4,127,"DIE",0)="^9.47^^0"
^DIC(9.4,127,"EX",0)="^9.432^2^2"
^DIC(9.4,127,"EX",1,0)="SRCS"
^DIC(9.4,127,"EX",2,0)="SRA"
^DIC(9.4,127,"INIT")="SROPOST"
^DIC(9.4,127,"PRE")="SROPRE"
^DIC(9.4,127,"VERSION")="3.0"
^DIC(9.4,128,0)="ONCOLOGY^ONC^Oncology treatment tracking & tumor registry package."
^DIC(9.4,128,1,0)="^^10^10^2960924^^^^"
^DIC(9.4,128,1,1,0)="The Oncology package, which is known as the Tumor Registry Automation"
^DIC(9.4,128,1,2,0)="Program (TRAP), is a comprehensive program for automating the hospital"
^DIC(9.4,128,1,3,0)="tumor registry.  It is unique among tumor registry programs in supporting"
^DIC(9.4,128,1,4,0)="all requirements of the American College of Surgeons and the National"
^DIC(9.4,128,1,5,0)="Cancer Institute's Surveillance, Epidemiology, and End Results (SEER) "
^DIC(9.4,128,1,6,0)="Program and providing interactive edits for all data elements.  It features "
^DIC(9.4,128,1,7,0)="flexibility in accommodating expanded data sets for medical oncology,"
^DIC(9.4,128,1,8,0)="radiation therapy, and surgery, and for satisfying local needs and special"
^DIC(9.4,128,1,9,0)="research studies.  It also features a transparent approach for encoding"
^DIC(9.4,128,1,10,0)="and decoding ICD-O and SNOMED nomenclatures.  "
