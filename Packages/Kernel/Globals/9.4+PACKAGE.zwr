^DIC(9.4,96,22,1.2,"PAH",23,1,98,0)="    "
^DIC(9.4,96,22,1.2,"PAH",23,1,99,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,100,0)=" SYSTEM ACCESS DURING INSTALLATION"
^DIC(9.4,96,22,1.2,"PAH",23,1,101,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",23,1,102,0)=" Installation of this patch does not require users to be off of the "
^DIC(9.4,96,22,1.2,"PAH",23,1,103,0)=" system.  However, all Dental users should not use the DRM GUI option "
^DIC(9.4,96,22,1.2,"PAH",23,1,104,0)=" while the patch is being installed.  All Dental users MUST close any "
^DIC(9.4,96,22,1.2,"PAH",23,1,105,0)=" open DRM GUI application prior to the patch being installed.  Once the "
^DIC(9.4,96,22,1.2,"PAH",23,1,106,0)=" patch has completed the users can use the DRM application."
^DIC(9.4,96,22,1.2,"PAH",23,1,107,0)="  "
^DIC(9.4,96,22,1.2,"PAH",23,1,108,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,109,0)=" POST-INSTALLATION PROCESS"
^DIC(9.4,96,22,1.2,"PAH",23,1,110,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",23,1,111,0)=" The post-install routine will remove inactivated ICD-9's and add new"
^DIC(9.4,96,22,1.2,"PAH",23,1,112,0)=" ICD-9 codes to the DENTAL CPT CODE MAPPING (#228) table.  "
^DIC(9.4,96,22,1.2,"PAH",23,1,113,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,114,0)=" It will also verify that the Condition field in file 228.2 matches the"
^DIC(9.4,96,22,1.2,"PAH",23,1,115,0)=" TP Condition field in file 228, and if not, then change the data for "
^DIC(9.4,96,22,1.2,"PAH",23,1,116,0)=" file 228.2.  This part of the post-installation will be queued off in"
^DIC(9.4,96,22,1.2,"PAH",23,1,117,0)=" the background."
^DIC(9.4,96,22,1.2,"PAH",23,1,118,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,119,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,120,0)=" NOIS ADDRESSED BY THIS PATCH"
^DIC(9.4,96,22,1.2,"PAH",23,1,121,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",23,1,122,0)=" n/a"
^DIC(9.4,96,22,1.2,"PAH",23,1,123,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,124,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,125,0)=" REQUIRED BUILDS:  LEX*2.0*31"
^DIC(9.4,96,22,1.2,"PAH",23,1,126,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,127,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,128,0)=" TEST SITES             SYSTEM                        ALPHA/BETA"
^DIC(9.4,96,22,1.2,"PAH",23,1,129,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,130,0)=" El Paso                                              ALPHA"
^DIC(9.4,96,22,1.2,"PAH",23,1,131,0)=" White River Junction                                 BETA"
^DIC(9.4,96,22,1.2,"PAH",23,1,132,0)=" Louisville                                           BETA"
^DIC(9.4,96,22,1.2,"PAH",23,1,133,0)=" Milwaukee                                            BETA"
^DIC(9.4,96,22,1.2,"PAH",23,1,134,0)=" Minneapolis                                          BETA"
^DIC(9.4,96,22,1.2,"PAH",23,1,135,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,136,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,137,0)=" ROUTINE SUMMARY"
^DIC(9.4,96,22,1.2,"PAH",23,1,138,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,139,0)=" Second line of routines will look like:"
^DIC(9.4,96,22,1.2,"PAH",23,1,140,0)=" ;;1.2;DENTAL;<patch list>;AUG 10, 2001"
^DIC(9.4,96,22,1.2,"PAH",23,1,141,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,142,0)="   Routine   Before Patch  After Patch  Patch List"
^DIC(9.4,96,22,1.2,"PAH",23,1,143,0)="   --------  ------------  -----------  ------------------------"
^DIC(9.4,96,22,1.2,"PAH",23,1,144,0)="   DENTV041      n/a        12568280     41"
^DIC(9.4,96,22,1.2,"PAH",23,1,145,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,146,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,147,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,148,0)=" INSTALLATION INSTRUCTIONS FOR DENT*1.2*41"
^DIC(9.4,96,22,1.2,"PAH",23,1,149,0)=" ======================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,150,0)=" This patch can be installed while users are on the system."
^DIC(9.4,96,22,1.2,"PAH",23,1,151,0)=" The installation time should take less than 5 minutes."
^DIC(9.4,96,22,1.2,"PAH",23,1,152,0)="   "
^DIC(9.4,96,22,1.2,"PAH",23,1,153,0)=" 1. Load the KIDS build from the mail message."
^DIC(9.4,96,22,1.2,"PAH",23,1,154,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,155,0)=" 2. For DSM sites review your mapped set.  Disable any of the above"
^DIC(9.4,96,22,1.2,"PAH",23,1,156,0)="    routines if necessary."
^DIC(9.4,96,22,1.2,"PAH",23,1,157,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,158,0)=" 3. From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,96,22,1.2,"PAH",23,1,159,0)="    the Installation menu."
^DIC(9.4,96,22,1.2,"PAH",23,1,160,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,161,0)=" 4. Use Load a Distribution and enter Dent_1_2P41.kid when prompted"
^DIC(9.4,96,22,1.2,"PAH",23,1,162,0)="    for a Host file.  You may need to attach a directory name"
^DIC(9.4,96,22,1.2,"PAH",23,1,163,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,164,0)=" 5. You may elect to use the following options (when prompted for "
^DIC(9.4,96,22,1.2,"PAH",23,1,165,0)="    INSTALL NAME, enter DENT*1.2*41)"
^DIC(9.4,96,22,1.2,"PAH",23,1,166,0)="    a. Backup a Transport Global"
^DIC(9.4,96,22,1.2,"PAH",23,1,167,0)="    b. Compare Transport Global to Current System"
^DIC(9.4,96,22,1.2,"PAH",23,1,168,0)="    c. Verify Checksums in Transport Global"
^DIC(9.4,96,22,1.2,"PAH",23,1,169,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,170,0)=" 6. Use the Install Package(s) option and select package DENT*1.2*41"
^DIC(9.4,96,22,1.2,"PAH",23,1,171,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,172,0)=" 7. For the install prompts, enter either Yes or No depending upon the"
^DIC(9.4,96,22,1.2,"PAH",23,1,173,0)="    normal practice at your facility.  "
^DIC(9.4,96,22,1.2,"PAH",23,1,174,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,175,0)=" Enter the Coordinator for Mail Group 'DENTV ADA CODE MAPPING':[Name]"
^DIC(9.4,96,22,1.2,"PAH",23,1,176,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,177,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,96,22,1.2,"PAH",23,1,178,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,96,22,1.2,"PAH",23,1,179,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,180,0)=" 8. AXP/DSM Sites - After the patch has been installed, rebuild your "
^DIC(9.4,96,22,1.2,"PAH",23,1,181,0)="    map set, if necessary"
^DIC(9.4,96,22,1.2,"PAH",23,1,182,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,183,0)="========================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,184,0)="                        POST-INSTALLATION PROCESS"
^DIC(9.4,96,22,1.2,"PAH",23,1,185,0)="========================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,186,0)="1. Forward any Mailman messages generated during the post-installation."
^DIC(9.4,96,22,1.2,"PAH",23,1,187,0)="   The post-install may generate a Mailman message if changes were made"
^DIC(9.4,96,22,1.2,"PAH",23,1,188,0)="   to the ADA Master table that were not part of the Dental Coding "
^DIC(9.4,96,22,1.2,"PAH",23,1,189,0)="   Group's recommended changes.  These would include removing inactive"
^DIC(9.4,96,22,1.2,"PAH",23,1,190,0)="   ICD-9 codes that were added by the site and not known to the group."
^DIC(9.4,96,22,1.2,"PAH",23,1,191,0)="   The Mailman message will be sent to the user loading the patch and "
^DIC(9.4,96,22,1.2,"PAH",23,1,192,0)="   must be forwarded to a Dental Administrator for evaluation."
^DIC(9.4,96,22,1.2,"PAH",23,1,193,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,194,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,195,0)="2. Add Members to the new Mail Group."
^DIC(9.4,96,22,1.2,"PAH",23,1,196,0)="   A new mail group has been added called DENTV ADA CODE MAPPING.  "
^DIC(9.4,96,22,1.2,"PAH",23,1,197,0)="   Please add members to this mail group.  These should be individuals"
^DIC(9.4,96,22,1.2,"PAH",23,1,198,0)="   who will be responsible for evaluating changes to the ADA Master table"
^DIC(9.4,96,22,1.2,"PAH",23,1,199,0)="   within Dental Record Manager.  A good candidate for a member would be"
^DIC(9.4,96,22,1.2,"PAH",23,1,200,0)="   the dental administrator for DRM in the Dental Service."
^DIC(9.4,96,22,1.2,"PAH",23,1,201,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,202,0)="   This is an example of adding a member to this mail group.  "
^DIC(9.4,96,22,1.2,"PAH",23,1,203,0)="   There are several Kernel options that allow the adding of members to a "
^DIC(9.4,96,22,1.2,"PAH",23,1,204,0)="   mail group including using Fileman.  This example just shows one of "
^DIC(9.4,96,22,1.2,"PAH",23,1,205,0)="   those options display:"
^DIC(9.4,96,22,1.2,"PAH",23,1,206,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,207,0)="   Select MAIL GROUP NAME: DENTV ADA CODE MAPPING"
^DIC(9.4,96,22,1.2,"PAH",23,1,208,0)="                           ------------------"
^DIC(9.4,96,22,1.2,"PAH",23,1,209,0)="   Select MEMBER: [add the name of the person to become a member]"
^DIC(9.4,96,22,1.2,"PAH",23,1,210,0)="     TYPE:"
^DIC(9.4,96,22,1.2,"PAH",23,1,211,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,212,0)=" "
^DIC(9.4,96,22,1.2,"PAH",23,1,213,0)=" ========================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,214,0)="                           SAMPLE INSTALLATION"
^DIC(9.4,96,22,1.2,"PAH",23,1,215,0)=" ========================================================================"
^DIC(9.4,96,22,1.2,"PAH",23,1,216,0)=" Select Installation Option: INstall Package(s)"
^DIC(9.4,96,22,1.2,"PAH",23,1,217,0)=" Select INSTALL NAME: DENT*1.2*41 Loaded from Distribution 10/13/04@13:32"
^DIC(9.4,96,22,1.2,"PAH",23,1,218,0)="     => DENT*1.2*41T1  ;Created on Oct 13, 2004@13:31:32"
^DIC(9.4,96,22,1.2,"PAH",23,1,219,0)="  "
