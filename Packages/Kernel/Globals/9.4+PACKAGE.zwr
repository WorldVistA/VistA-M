^DIC(9.4,100,22,15,"PAH",50,1,26,0)="  ------------       ------------        -----------         ----------"
^DIC(9.4,100,22,15,"PAH",50,1,27,0)="      YSGAFHL7            5831582            5842715         43,81"
^DIC(9.4,100,22,15,"PAH",50,1,28,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,29,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,30,0)=""
^DIC(9.4,100,22,15,"PAH",50,1,31,0)="  Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",50,1,32,0)="  =========================="
^DIC(9.4,100,22,15,"PAH",50,1,33,0)="        1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,100,22,15,"PAH",50,1,34,0)="           option will load the KIDS package in this message onto your"
^DIC(9.4,100,22,15,"PAH",50,1,35,0)="           system."
^DIC(9.4,100,22,15,"PAH",50,1,36,0)="        2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",50,1,37,0)="           system. You now need to use KIDS to install the Transport"
^DIC(9.4,100,22,15,"PAH",50,1,38,0)="           global. On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,100,22,15,"PAH",50,1,39,0)="           following options:"
^DIC(9.4,100,22,15,"PAH",50,1,40,0)="  "
^DIC(9.4,100,22,15,"PAH",50,1,41,0)="                Print Transport Global"
^DIC(9.4,100,22,15,"PAH",50,1,42,0)="                Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",50,1,43,0)="                Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",50,1,44,0)="                Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",50,1,45,0)="  "
^DIC(9.4,100,22,15,"PAH",50,1,46,0)="        3. Installation of this patch should be at off peak hours."
^DIC(9.4,100,22,15,"PAH",50,1,47,0)="        4. Users may remain on the system."
^DIC(9.4,100,22,15,"PAH",50,1,48,0)="        5. Installation will take less than five minutes."
^DIC(9.4,100,22,15,"PAH",50,1,49,0)="           this patch requires no additional memory space."
^DIC(9.4,100,22,15,"PAH",50,1,50,0)="        6. From the 'Installation Menu' of the KIDS menu, run the option "
^DIC(9.4,100,22,15,"PAH",50,1,51,0)="           'Install Package(s)' Select the package 'YS*5.01*81' and proceed"
^DIC(9.4,100,22,15,"PAH",50,1,52,0)="           with install."
^DIC(9.4,100,22,15,"PAH",50,1,53,0)="        7. When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,100,22,15,"PAH",50,1,54,0)="           YES//', respond NO."
^DIC(9.4,100,22,15,"PAH",50,1,55,0)="        8. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,100,22,15,"PAH",50,1,56,0)="           and Protocols? YES//', respond NO."
^DIC(9.4,100,22,15,"PAH",51,0)="87 SEQ #70^3041015^1"
^DIC(9.4,100,22,15,"PAH",51,1,0)="^^147^147^3041015"
^DIC(9.4,100,22,15,"PAH",51,1,1,0)="This patch replaces the Mental Health option Usage Statistics [YSMUSE] with "
^DIC(9.4,100,22,15,"PAH",51,1,2,0)="a new Mental Health option Mental Health Test Usage Server [YS TEST USAGE]."
^DIC(9.4,100,22,15,"PAH",51,1,3,0)="This is a server option to be used only by the members of the National Mental "
^DIC(9.4,100,22,15,"PAH",51,1,4,0)="Health Strategic Healthcare Group (MHSHG) to determine the annual "
^DIC(9.4,100,22,15,"PAH",51,1,5,0)="psychological test instrument usage at a site."
^DIC(9.4,100,22,15,"PAH",51,1,6,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,7,0)="This patch contains one new server option Mental Health Test Usage Server [YS "
^DIC(9.4,100,22,15,"PAH",51,1,8,0)="TEST USAGE] and one new routine YSTUSE.  Option Usage Statistics [YSMUSE] "
^DIC(9.4,100,22,15,"PAH",51,1,9,0)="and routine YTSTAT are deleted during installation of the patch."
^DIC(9.4,100,22,15,"PAH",51,1,10,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,11,0)="The server option Mental Health Test Usage Server [YS TEST USAGE] is "
^DIC(9.4,100,22,15,"PAH",51,1,12,0)="activated by a mail message.  The mail message invokes the routine YSTUSE "
^DIC(9.4,100,22,15,"PAH",51,1,13,0)="which returns the results of the psychological test instrument usage at the "
^DIC(9.4,100,22,15,"PAH",51,1,14,0)="site the mail message is sent to.  "
^DIC(9.4,100,22,15,"PAH",51,1,15,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,16,0)="This is an example to invoke the server to create the mail message."
^DIC(9.4,100,22,15,"PAH",51,1,17,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,18,0)="Select OPTION NAME: XMUSER       MailMan Menu"
^DIC(9.4,100,22,15,"PAH",51,1,19,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,20,0)="VA MailMan 8.0 service for XXXX.XXXX_X@MHCVSS.FO-ALBANY.DOMAIN.EXT"
^DIC(9.4,100,22,15,"PAH",51,1,21,0)="You last used MailMan: 09/14/04@17:01"
^DIC(9.4,100,22,15,"PAH",51,1,22,0)="You have 2 new messages."
^DIC(9.4,100,22,15,"PAH",51,1,23,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,24,0)=""
^DIC(9.4,100,22,15,"PAH",51,1,25,0)="   NML    New Messages and Responses"
^DIC(9.4,100,22,15,"PAH",51,1,26,0)="   RML    Read/Manage Messages"
^DIC(9.4,100,22,15,"PAH",51,1,27,0)="   SML    Send a Message"
^DIC(9.4,100,22,15,"PAH",51,1,28,0)="          Query/Search for Messages"
^DIC(9.4,100,22,15,"PAH",51,1,29,0)="   AML    Become a Surrogate (SHARED,MAIL or Other)"
