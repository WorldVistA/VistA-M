^DIC(9.4,35,22,3,"PAH",472,1,0)="^^2^2^3210909"
^DIC(9.4,35,22,3,"PAH",472,1,1,0)="Care Management Decommission - Removes code from CPRS for Care"
^DIC(9.4,35,22,3,"PAH",472,1,2,0)="management."
^DIC(9.4,35,22,3,"PAH",473,0)="563 SEQ #479^3210929.14493^17"
^DIC(9.4,35,22,3,"PAH",473,1,0)="^^20^20^3210929"
^DIC(9.4,35,22,3,"PAH",473,1,1,0)="1. INC18693308 - CPRS NOW DOSE ISSUE IN CLINIC INFUSIONS"
^DIC(9.4,35,22,3,"PAH",473,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",473,1,3,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",473,1,4,0)="   -------"
^DIC(9.4,35,22,3,"PAH",473,1,5,0)="In CPRS, when using the clinic infusions (BCMA for outpatients, IV) "
^DIC(9.4,35,22,3,"PAH",473,1,6,0)="ordering pathway, when ordering an IV and then clicking the ""give "
^DIC(9.4,35,22,3,"PAH",473,1,7,0)="additional dose now"" button, upon signing the order the now dose never "
^DIC(9.4,35,22,3,"PAH",473,1,8,0)="actually gets ordered. "
^DIC(9.4,35,22,3,"PAH",473,1,9,0)="This is a glitch in the system. This ""now"" function works in clinic "
^DIC(9.4,35,22,3,"PAH",473,1,10,0)="medications (BCMA for outpatients, unit dose) as well as IVs for non-BCMA "
^DIC(9.4,35,22,3,"PAH",473,1,11,0)="units but appears broke in clinic infusions."
^DIC(9.4,35,22,3,"PAH",473,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",473,1,13,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",473,1,14,0)="   ----------"
^DIC(9.4,35,22,3,"PAH",473,1,15,0)="Routine ORCSEND is modified to allow order dialog 'CLINIC OR PAT FLUID "
^DIC(9.4,35,22,3,"PAH",473,1,16,0)="OE' to work the same as dialog 'PSJI OR PAT FLUID OE' when determining if "
^DIC(9.4,35,22,3,"PAH",473,1,17,0)="PSJI^ORCSEND3 should be executed.  After this patch, when an order that "
^DIC(9.4,35,22,3,"PAH",473,1,18,0)="is for package PSJ and uses DIALOG 'CLINIC OR PAT FLUID OE' processing "
^DIC(9.4,35,22,3,"PAH",473,1,19,0)="will continue through PSJI^ORCSEND3 and the NOW order will be created "
^DIC(9.4,35,22,3,"PAH",473,1,20,0)="when signing of the order."
^DIC(9.4,35,22,3,"PAH",474,0)="568 SEQ #480^3210929.145003^17"
^DIC(9.4,35,22,3,"PAH",475,0)="567 SEQ #481^3211006.173329^17"
^DIC(9.4,35,22,3,"PAH",475,1,0)="^^4^4^3211006"
^DIC(9.4,35,22,3,"PAH",475,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",475,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",475,1,3,0)="The prompts of an existing order dialog cannot be edited after the"
^DIC(9.4,35,22,3,"PAH",475,1,4,0)="install of OR*3.0*556."
^DIC(9.4,35,22,3,"PAH",476,0)="559^3211104.093822^17"
^DIC(9.4,35,22,3,"PAH",476,1,0)="^^2^2^3211104"
^DIC(9.4,35,22,3,"PAH",476,1,1,0)="Add ORAM as an Additional Prefix in the Package file entry for ORDER "
^DIC(9.4,35,22,3,"PAH",476,1,2,0)="ENTRY/RESULTS REPORTING."
^DIC(9.4,35,22,3,"PAH",477,0)="498^3211207.151119^17"
^DIC(9.4,35,22,3,"PAH",478,0)="571 SEQ #485^3211214.104121^17"
^DIC(9.4,35,22,3,"PAH",478,1,0)="^^1^1^3211214"
^DIC(9.4,35,22,3,"PAH",478,1,1,0)="See patch description for full information."
^DIC(9.4,35,22,3,"PAH",479,0)="574 SEQ #486^3220105.121157^17"
^DIC(9.4,35,22,3,"PAH",479,1,0)="^^5^5^3220105"
^DIC(9.4,35,22,3,"PAH",479,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",479,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",479,1,3,0)="In the History of Actions Taken section of the Patient Record Flag (PRF) "
^DIC(9.4,35,22,3,"PAH",479,1,4,0)="display in CPRS, the Site ID should reflect the STATION NUMBER (#99) "
^DIC(9.4,35,22,3,"PAH",479,1,5,0)="field of the INSTITUTION (#4) file, not the internal entry number."
^DIC(9.4,35,22,3,"PAH",480,0)="572 SEQ #487^3220110.145552^17"
^DIC(9.4,35,22,3,"PAH",480,1,0)="^^33^33^3220110"
^DIC(9.4,35,22,3,"PAH",480,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,35,22,3,"PAH",480,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",480,1,3,0)="1. INC19397308 - MEDICATION RELEASED FROM HOLD NOT SHOWING NURSE "
^DIC(9.4,35,22,3,"PAH",480,1,4,0)="                 VERIFIED IN BCMA"
^DIC(9.4,35,22,3,"PAH",480,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",480,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",480,1,7,0)="Problem:"
^DIC(9.4,35,22,3,"PAH",480,1,8,0)="--------"
^DIC(9.4,35,22,3,"PAH",480,1,9,0)="After a medication is released from hold and is verified by a nurse in "
^DIC(9.4,35,22,3,"PAH",480,1,10,0)="CPRS, the medication is not showing in BCMA as being nurse verified.  In "
^DIC(9.4,35,22,3,"PAH",480,1,11,0)="BCMA, after being nurse verified, the medication is still showing *** in "
^DIC(9.4,35,22,3,"PAH",480,1,12,0)="the Ver column of the Coversheet, Unit Dose, and IV tabs."
^DIC(9.4,35,22,3,"PAH",480,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",480,1,14,0)="Resolution:"
^DIC(9.4,35,22,3,"PAH",480,1,15,0)="-----------"
^DIC(9.4,35,22,3,"PAH",480,1,16,0)="The issue is due to not sending an HL7 message for nurse verification.  "
^DIC(9.4,35,22,3,"PAH",480,1,17,0)="This occurs because the processing quits out when the order action is not "
^DIC(9.4,35,22,3,"PAH",480,1,18,0)="a change (XX) or new (NW).  When the medication has put on hold and then "
^DIC(9.4,35,22,3,"PAH",480,1,19,0)="released off hold, the action of the nurse to verify it is a Release Hold "
^DIC(9.4,35,22,3,"PAH",480,1,20,0)="(RL) action and fails to continue to the code that sends the message.  "
^DIC(9.4,35,22,3,"PAH",480,1,21,0)="The correction is to modify routine ORCSEND to move the quit logic to "
^DIC(9.4,35,22,3,"PAH",480,1,22,0)="after the message is sent for the pharmacy package."
^DIC(9.4,35,22,3,"PAH",480,1,23,0)=" "
^DIC(9.4,35,22,3,"PAH",480,1,24,0)="Technical Resolution:"
^DIC(9.4,35,22,3,"PAH",480,1,25,0)="---------------------"
^DIC(9.4,35,22,3,"PAH",480,1,26,0)="Routine ORCSEND is modified to move the quit logic and conditionally call "
^DIC(9.4,35,22,3,"PAH",480,1,27,0)="VER^ORMBLDPS for package PS only when the action is NW, XX, or RL."
^DIC(9.4,35,22,3,"PAH",480,1,28,0)=" "
^DIC(9.4,35,22,3,"PAH",480,1,29,0)="The quit in line VR+6^ORCSEND is commented out, that quit is then added "
^DIC(9.4,35,22,3,"PAH",480,1,30,0)="after line VR+9^ORCSEND. Line VR+9^ORCSEND is changed from 'I "
^DIC(9.4,35,22,3,"PAH",480,1,31,0)="$$NMSP^ORCD(ORPKG)=""PS"" D VER^ORMBLDPS(ORIFN) Q' to 'I "
^DIC(9.4,35,22,3,"PAH",480,1,32,0)="$$NMSP^ORCD(ORPKG)=""PS""&(ORX=""NW!(ORX=""XX"")!(ORX=""RL"")) D "
^DIC(9.4,35,22,3,"PAH",480,1,33,0)="VER^ORMBLDPS(ORIFN) Q'"
^DIC(9.4,35,22,3,"PAH",481,0)="564 SEQ #491^3220223.110206^84"
^DIC(9.4,35,22,3,"PAH",481,1,0)="^^1^1^3220223"
^DIC(9.4,35,22,3,"PAH",481,1,1,0)="See the patch description for full information."
^DIC(9.4,35,22,3,"PAH",482,0)="580 SEQ #492^3220303.14593^17"
^DIC(9.4,35,22,3,"PAH",482,1,0)="^^43^43^3220303"
^DIC(9.4,35,22,3,"PAH",482,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",482,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,3,0)="1. CPRS - Wrong Message on Cancelled Order"
^DIC(9.4,35,22,3,"PAH",482,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,6,0)="Associated ticket(s):"
^DIC(9.4,35,22,3,"PAH",482,1,7,0)="====================="
^DIC(9.4,35,22,3,"PAH",482,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,9,0)="1. INC20497278 - CPRS - Wrong Message on Cancelled Order"
^DIC(9.4,35,22,3,"PAH",482,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,11,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,13,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",482,1,14,0)="=================="
^DIC(9.4,35,22,3,"PAH",482,1,15,0)="N/A"
^DIC(9.4,35,22,3,"PAH",482,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,17,0)="Participating Test Sites:"
^DIC(9.4,35,22,3,"PAH",482,1,18,0)="========================="
^DIC(9.4,35,22,3,"PAH",482,1,19,0)="TBD"
^DIC(9.4,35,22,3,"PAH",482,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,22,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,35,22,3,"PAH",482,1,23,0)="==========================================="
^DIC(9.4,35,22,3,"PAH",482,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,25,0)="1. CPRS - Wrong Message on Cancelled Order."
^DIC(9.4,35,22,3,"PAH",482,1,26,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,27,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",482,1,28,0)="   -------"
^DIC(9.4,35,22,3,"PAH",482,1,29,0)="In CPRS, placed an order and then cancelled it.  Attempt to sign the "
^DIC(9.4,35,22,3,"PAH",482,1,30,0)="order and you'll get the message ""order has been signed"".  The reason "
^DIC(9.4,35,22,3,"PAH",482,1,31,0)="should say, this order has been cancelled."
^DIC(9.4,35,22,3,"PAH",482,1,32,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,33,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",482,1,34,0)="   ----------"
^DIC(9.4,35,22,3,"PAH",482,1,35,0)="Modify routine ORCACT01 so display the message ""This order has been "
^DIC(9.4,35,22,3,"PAH",482,1,36,0)="canceled!"" when the SIGNATURE STATUS for the ORDER ACTION sub record of "
^DIC(9.4,35,22,3,"PAH",482,1,37,0)="the order being signed is 5.  "
^DIC(9.4,35,22,3,"PAH",482,1,38,0)=" "
^DIC(9.4,35,22,3,"PAH",482,1,39,0)="   Technical Resolution:"
^DIC(9.4,35,22,3,"PAH",482,1,40,0)="   ---------------------"
^DIC(9.4,35,22,3,"PAH",482,1,41,0)="The value of 5 for the SIGNATURE STATUS field is 'NOT REQUIRED due to "
^DIC(9.4,35,22,3,"PAH",482,1,42,0)="cancel/lapse'.  At line ES+7^ORCACT01 add code:"
^DIC(9.4,35,22,3,"PAH",482,1,43,0)="I X=5 S ERROR=""This order has been canceled!"" Q ;p580"
^DIC(9.4,35,22,3,"PAH",483,0)="578 SEQ #493^3220411.144411^86"
^DIC(9.4,35,22,3,"PAH",483,1,0)="^^4^4^3220411"
^DIC(9.4,35,22,3,"PAH",483,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",483,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",483,1,3,0)="Duplicate order checking might display an incorrect dispense drug against "
^DIC(9.4,35,22,3,"PAH",483,1,4,0)="pending clinic medications."
^DIC(9.4,35,22,3,"PAH",484,0)="585 SEQ #494^3220427.103435^86"
^DIC(9.4,35,22,3,"PAH",484,1,0)="^^5^5^3220427"
^DIC(9.4,35,22,3,"PAH",484,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",484,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",484,1,3,0)="When viewing Laboratory result alerts in CPRS and VistA as well as on"
^DIC(9.4,35,22,3,"PAH",484,1,4,0)="some CPRS Laboratory reports, abnormal flags display next to test results"
^DIC(9.4,35,22,3,"PAH",484,1,5,0)="with no spacing between the results and flags. (Example: POSITIVEH)"
^DIC(9.4,35,22,3,"PAH",485,0)="455^3220706.155928^86"
^DIC(9.4,35,22,3,"PAH",486,0)="538 SEQ #496^3220817.170458^86"
^DIC(9.4,35,22,3,"PAH",487,0)="558^3220825.122542^86"
^DIC(9.4,35,22,3,"PAH",487,1,0)="^^3^3^3220825"
^DIC(9.4,35,22,3,"PAH",487,1,1,0)="The purpose of this patch is to export the report for patient "
^DIC(9.4,35,22,3,"PAH",487,1,2,0)="demographics, along with the supporting code, to add self identified "
^DIC(9.4,35,22,3,"PAH",487,1,3,0)="gender. See the patch description for a full descriptions."
^DIC(9.4,35,22,3,"PAH",488,0)="569^3220920.221458^90"
^DIC(9.4,35,22,3,"PAH",489,0)="405^3221005.145508^89"
^DIC(9.4,35,22,3,"PAH",489,1,0)="^^13^13^3221005"
^DIC(9.4,35,22,3,"PAH",489,1,1,0)="This patch is part of a combined build, made up of the following nine "
^DIC(9.4,35,22,3,"PAH",489,1,2,0)="patches:"
^DIC(9.4,35,22,3,"PAH",489,1,3,0)="       "
^DIC(9.4,35,22,3,"PAH",489,1,4,0)="        GMRA*4.0*51    SUPPORT FOR CPRS V32"
^DIC(9.4,35,22,3,"PAH",489,1,5,0)="        GMTS*2.7*115   SUPPORT FOR CPRS V32"
^DIC(9.4,35,22,3,"PAH",489,1,6,0)="        OR*3.0*405     CPRS V32"
^DIC(9.4,35,22,3,"PAH",489,1,7,0)="        PSB*3.0*93     CPRS V32 BCMA CHANGES"
^DIC(9.4,35,22,3,"PAH",489,1,8,0)="        PSO*7.0*441    PARK-A-PRESCRIPTION MODIFICATIONS"
^DIC(9.4,35,22,3,"PAH",489,1,9,0)="        PX*1.0*217     Immunization Calculation Engine (ICE) interface"
^DIC(9.4,35,22,3,"PAH",489,1,10,0)="        PXRM*2.0*65    Reminder changes for VIMM"
^DIC(9.4,35,22,3,"PAH",489,1,11,0)="        TIU*1.0*289    CPRS V32 MODIFICATIONS"
^DIC(9.4,35,22,3,"PAH",489,1,12,0)="        PSJ*5.0*399    CPRS32 - INDICATIONS"
^DIC(9.4,35,22,3,"PAH",489,1,13,0)="        YS*5.01*211    CPRS V32B MENTAL HEALTH DLL"
^DIC(9.4,35,22,3,"PAH",490,0)="591 SEQ #500^3221025.140116^90"
^DIC(9.4,35,22,3,"PAH",490,1,0)="^^6^6^3221025"
^DIC(9.4,35,22,3,"PAH",490,1,1,0)="The Health Data Repository (HDR) system will now require the 'client "
^DIC(9.4,35,22,3,"PAH",490,1,2,0)="name' field to be populated for all requests. The purpose of this patch "
^DIC(9.4,35,22,3,"PAH",490,1,3,0)="is to add this information to the requests sent from the Order "
^DIC(9.4,35,22,3,"PAH",490,1,4,0)="Entry/Results Reporting package to HDR. These requests are necessary for "
^DIC(9.4,35,22,3,"PAH",490,1,5,0)="performing functions such as remote order checking on outpatient "
^DIC(9.4,35,22,3,"PAH",490,1,6,0)="prescriptions and allergies."
^DIC(9.4,35,22,3,"PAH",491,0)="594 SEQ #501^3221227.095802^90"
^DIC(9.4,35,22,3,"PAH",491,1,0)="^^3^3^3221227"
^DIC(9.4,35,22,3,"PAH",491,1,1,0)="This patch will correct a <SUBSCRIPT>RESETID+7^ORCDPS error that can"
^DIC(9.4,35,22,3,"PAH",491,1,2,0)="occur while editing quick orders while using the Update Meds Quick"
^DIC(9.4,35,22,3,"PAH",491,1,3,0)="Orders for indication prompt [ORCM UPD INDICATION QO] option."
^DIC(9.4,35,22,3,"PAH",492,0)="599 SEQ #502^3230109.173037^89"
^DIC(9.4,35,22,3,"PAH",492,1,0)="^^2^2^3230109"
^DIC(9.4,35,22,3,"PAH",492,1,1,0)="This patch will temporarily remove the requirement for indication. This "
^DIC(9.4,35,22,3,"PAH",492,1,2,0)="should only impact copy to new order actions."
^DIC(9.4,35,22,3,"PAH",493,0)="597^3230228.130742^89"
^DIC(9.4,35,22,3,"PAH",494,0)="598^3230323.121006^89"
^DIC(9.4,35,22,3,"PAH",494,1,0)="^^2^2^3230323"
^DIC(9.4,35,22,3,"PAH",494,1,1,0)="Emergency GUI release. Please see the patch description for the full "
^DIC(9.4,35,22,3,"PAH",494,1,2,0)="information."
^DIC(9.4,35,22,3,"PAH",495,0)="596 SEQ #505^3230323.122136^89"
^DIC(9.4,35,22,3,"PAH",495,1,0)="^^1^1^3230323"
^DIC(9.4,35,22,3,"PAH",495,1,1,0)="Please see FORUM for a complete description of OR*3.0*596."
^DIC(9.4,35,22,3,"PAH",496,0)="577 SEQ #506^3230414.1123^90"
^DIC(9.4,35,22,3,"PAH",496,1,0)="^^2^2^3230414"
^DIC(9.4,35,22,3,"PAH",496,1,1,0)="This patch addresses four defects, please look to the patch description"
^DIC(9.4,35,22,3,"PAH",496,1,2,0)="for specific technical details."
^DIC(9.4,35,22,3,"PAH",497,0)="602 SEQ #507^3230523.093855^89"
^DIC(9.4,35,22,3,"PAH",497,1,0)="^^2^2^3230523"
^DIC(9.4,35,22,3,"PAH",497,1,1,0)="The purpose of this build is to revert ORMPS2. See the patch description "
^DIC(9.4,35,22,3,"PAH",497,1,2,0)="for additional information."
^DIC(9.4,35,22,3,"PAH",498,0)="593^3230601.092636^89"
^DIC(9.4,35,22,3,"PAH",498,1,0)="^^2^2^3230601"
^DIC(9.4,35,22,3,"PAH",498,1,1,0)="Please refer to the patch description for detailed information about the "
^DIC(9.4,35,22,3,"PAH",498,1,2,0)="contents."
^DIC(9.4,35,22,3,"PAH",499,0)="499^3230629.170402^89"
^DIC(9.4,35,22,3,"PAH",499,1,0)="^^1^1^3230629"
^DIC(9.4,35,22,3,"PAH",499,1,1,0)="See FORUM for patch description."
^DIC(9.4,35,22,3,"PAH",500,0)="588^3231026.09383^89"
^DIC(9.4,35,22,3,"PAH",501,0)="607 SEQ #511^3231206.154054^89"
^DIC(9.4,35,22,3,"PAH",501,1,0)="^^1^1^3231206"
^DIC(9.4,35,22,3,"PAH",501,1,1,0)="See FORUM for patch description details."
^DIC(9.4,35,22,3,"PAH",502,0)="605 SEQ #512^3240116.18152^89"
^DIC(9.4,35,22,3,"PAH",502,1,0)="^^6^6^3240116"
^DIC(9.4,35,22,3,"PAH",502,1,1,0)="This patch address the following issue:"
^DIC(9.4,35,22,3,"PAH",502,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",502,1,3,0)="MOCHA duplicate order check displaying ""UNRELEASED"" on a released "
^DIC(9.4,35,22,3,"PAH",502,1,4,0)="prescription (Active, Discontinued, etc.), which is misleading."
^DIC(9.4,35,22,3,"PAH",502,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",502,1,6,0)="See the patch description for additional information."
^DIC(9.4,35,22,3,"PAH",503,0)="614 SEQ #514^3240221.101323^89"
^DIC(9.4,35,22,3,"PAH",504,0)="600 SEQ #515^3240304.101314^89"
^DIC(9.4,35,22,3,"PAH",504,1,0)="^^7^7^3240304"
^DIC(9.4,35,22,3,"PAH",504,1,1,0)="The patch addresses two (2) issues"
^DIC(9.4,35,22,3,"PAH",504,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",504,1,3,0)="1. Reformat complications message, removing embedded line breaks in"
^DIC(9.4,35,22,3,"PAH",504,1,4,0)="message text that caused lower portion to be obscured"
^DIC(9.4,35,22,3,"PAH",504,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",504,1,6,0)="2. Update AntiCoagulate Splash Screen with features added to CPRS Splash"
^DIC(9.4,35,22,3,"PAH",504,1,7,0)="Screen"
^DIC(9.4,35,22,3,"PAH",505,0)="603 SEQ #516^3240401.155433^89"
^DIC(9.4,35,22,3,"PAH",505,1,0)="^^76^76^3240401"
^DIC(9.4,35,22,3,"PAH",505,1,1,0)="Description:"
^DIC(9.4,35,22,3,"PAH",505,1,2,0)="This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",505,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,4,0)="1. In CPRS, the action of ""Change Release Event"" can be done on clinic"
^DIC(9.4,35,22,3,"PAH",505,1,5,0)="medications."
^DIC(9.4,35,22,3,"PAH",505,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,7,0)="2. In CPRS, Lab Overview (Collected Specimen) results are returned in "
^DIC(9.4,35,22,3,"PAH",505,1,8,0)="wrong sort order by collection dates."
^DIC(9.4,35,22,3,"PAH",505,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,11,0)="Installation Instructions:"
^DIC(9.4,35,22,3,"PAH",505,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,13,0)="1.  Choose the PackMan message containing this build. Then select "
^DIC(9.4,35,22,3,"PAH",505,1,14,0)="    the INSTALL/CHECK MESSAGE PackMan option to load the build."
^DIC(9.4,35,22,3,"PAH",505,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,16,0)="2.  From the Kernel Installation and Distribution System Menu, "
^DIC(9.4,35,22,3,"PAH",505,1,17,0)="    select the Installation Menu.  From this menu, "
^DIC(9.4,35,22,3,"PAH",505,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,19,0)="    A.  Select the Verify Checksums in Transport Global "
^DIC(9.4,35,22,3,"PAH",505,1,20,0)="        option to confirm the integrity of the routines that "
^DIC(9.4,35,22,3,"PAH",505,1,21,0)="        are in the transport global. When prompted for the "
^DIC(9.4,35,22,3,"PAH",505,1,22,0)="        INSTALL NAME enter the patch name. "
^DIC(9.4,35,22,3,"PAH",505,1,23,0)="        (OR*3.0*603)"
^DIC(9.4,35,22,3,"PAH",505,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,25,0)="        NOTE: Using <spacebar><enter> will not bring up a "
^DIC(9.4,35,22,3,"PAH",505,1,26,0)="              Multi-Package build even if it was loaded "
^DIC(9.4,35,22,3,"PAH",505,1,27,0)="              immediately before this step. It will only "
^DIC(9.4,35,22,3,"PAH",505,1,28,0)="              bring up the last patch in the build."
^DIC(9.4,35,22,3,"PAH",505,1,29,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,30,0)="    B. Select the Backup a Transport Global option to create"
^DIC(9.4,35,22,3,"PAH",505,1,31,0)="       a backup message. You must use this option and specify "
^DIC(9.4,35,22,3,"PAH",505,1,32,0)="       what to backup; the entire Build or just Routines."
^DIC(9.4,35,22,3,"PAH",505,1,33,0)="       The backup message can be used to restore the routines"
^DIC(9.4,35,22,3,"PAH",505,1,34,0)="       and components of the build to the pre-patch condition."
^DIC(9.4,35,22,3,"PAH",505,1,35,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,36,0)="         i.  At the Installation option menu, select Backup "
^DIC(9.4,35,22,3,"PAH",505,1,37,0)="             a Transport Global."
^DIC(9.4,35,22,3,"PAH",505,1,38,0)="         ii. At the Select INSTALL NAME prompt, enter your "
^DIC(9.4,35,22,3,"PAH",505,1,39,0)="             build OR*3.0*603."
^DIC(9.4,35,22,3,"PAH",505,1,40,0)="         iii. When prompted for the following, enter ""R"" for "
^DIC(9.4,35,22,3,"PAH",505,1,41,0)="              Routines or ""B"" for Build."
^DIC(9.4,35,22,3,"PAH",505,1,42,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,43,0)="               Select one of the following:"
^DIC(9.4,35,22,3,"PAH",505,1,44,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,45,0)="                      B         Build"
^DIC(9.4,35,22,3,"PAH",505,1,46,0)="                      R         Routines"
^DIC(9.4,35,22,3,"PAH",505,1,47,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,48,0)="                Enter response: Build"
^DIC(9.4,35,22,3,"PAH",505,1,49,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,50,0)="         iv.  When prompted ""Do you wish to secure your build? "
^DIC(9.4,35,22,3,"PAH",505,1,51,0)="              NO//"", press <enter> and take the default response "
^DIC(9.4,35,22,3,"PAH",505,1,52,0)="              of ""NO""."
^DIC(9.4,35,22,3,"PAH",505,1,53,0)="         v.   When prompted with, ""Send mail to: Last name, First "
^DIC(9.4,35,22,3,"PAH",505,1,54,0)="              Name"", press <enter> to take default recipient. Add "
^DIC(9.4,35,22,3,"PAH",505,1,55,0)="              any additional recipients."
^DIC(9.4,35,22,3,"PAH",505,1,56,0)="         vi.  When prompted with ""Select basket to send to: IN//"", "
^DIC(9.4,35,22,3,"PAH",505,1,57,0)="              press <enter> and take the default IN mailbox or select "
^DIC(9.4,35,22,3,"PAH",505,1,58,0)="              a different mailbox."
^DIC(9.4,35,22,3,"PAH",505,1,59,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,60,0)="    C. You may also elect to use the following options: "
^DIC(9.4,35,22,3,"PAH",505,1,61,0)="         i. Print Transport Global - This option will allow "
^DIC(9.4,35,22,3,"PAH",505,1,62,0)="            you to view the components of the KIDS build."
^DIC(9.4,35,22,3,"PAH",505,1,63,0)="        ii. Compare Transport Global to Current System - This "
^DIC(9.4,35,22,3,"PAH",505,1,64,0)="            option will allow you to view all changes that will "
^DIC(9.4,35,22,3,"PAH",505,1,65,0)="            be made when this patch is installed.  It compares "
^DIC(9.4,35,22,3,"PAH",505,1,66,0)="            all of the components of this patch, such as "
^DIC(9.4,35,22,3,"PAH",505,1,67,0)="            routines, DDs, templates, etc."
^DIC(9.4,35,22,3,"PAH",505,1,68,0)=" "
^DIC(9.4,35,22,3,"PAH",505,1,69,0)="    D. Select the Install Package(s) option and choose the "
^DIC(9.4,35,22,3,"PAH",505,1,70,0)="       patch to install. "
^DIC(9.4,35,22,3,"PAH",505,1,71,0)="         i. If prompted 'Want KIDS to Rebuild Menu Trees Upon "
^DIC(9.4,35,22,3,"PAH",505,1,72,0)="            Completion of Install? NO//', answer NO."
^DIC(9.4,35,22,3,"PAH",505,1,73,0)="        ii. When prompted 'Want KIDS to INHIBIT LOGONs during the "
^DIC(9.4,35,22,3,"PAH",505,1,74,0)="            install? NO//', answer NO."
^DIC(9.4,35,22,3,"PAH",505,1,75,0)="       iii. When prompted 'Want to DISABLE Scheduled Options, Menu "
^DIC(9.4,35,22,3,"PAH",505,1,76,0)="            Options, and Protocols? NO//', answer NO."
^DIC(9.4,35,22,3,"PAH",506,0)="612 SEQ #518^3240506.120251^89"
^DIC(9.4,35,22,3,"PAH",506,1,0)="^^4^4^3240506"
^DIC(9.4,35,22,3,"PAH",506,1,1,0)="This patch will address the following issue: "
^DIC(9.4,35,22,3,"PAH",506,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",506,1,3,0)="It was reported that when a provider ordered acetaminophen IV and then"
^DIC(9.4,35,22,3,"PAH",506,1,4,0)="ordered PO, a duplicate drug therapy alert did not populate (HITPS-10794)."
^DIC(9.4,35,22,3,"PAH",507,0)="604 SEQ #519^3240506.120321^89"
^DIC(9.4,35,22,3,"PAH",507,1,0)="^^7^7^3240506"
^DIC(9.4,35,22,3,"PAH",507,1,1,0)="This patch addresses three issues:"
^DIC(9.4,35,22,3,"PAH",507,1,2,0)="1. IV order admin time editing not going to CPRS."
^DIC(9.4,35,22,3,"PAH",507,1,3,0)="2. Add new override reason."
^DIC(9.4,35,22,3,"PAH",507,1,4,0)="3. Corrected the spelling of 'UDPATE' to 'UPDATE' in the parameter 'ORWPCE"
^DIC(9.4,35,22,3,"PAH",507,1,5,0)="ASK ENCOUNTER UPDATE' in the field 'VALUE TERM'."
^DIC(9.4,35,22,3,"PAH",507,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",507,1,7,0)="For additional information, please see the patch description."
^DIC(9.4,35,22,3,"PAH",508,0)="620 SEQ #520^3240726.104125^89"
^DIC(9.4,35,22,3,"PAH",508,1,0)="^^6^6^3240726"
^DIC(9.4,35,22,3,"PAH",508,1,1,0)="The Purpose of this patch is to address VIA OR Consult Error. This is "
^DIC(9.4,35,22,3,"PAH",508,1,2,0)="error is causing VistA to crash. The error is due to improper use of the "
^DIC(9.4,35,22,3,"PAH",508,1,3,0)="consult Remote procedure (RPC) by not passing a Patient record number "
^DIC(9.4,35,22,3,"PAH",508,1,4,0)="DFN. Without a DFN the program crashes causing errors in VistA. This "
^DIC(9.4,35,22,3,"PAH",508,1,5,0)="error is being called when the consult tab is being shown when a patient "
^DIC(9.4,35,22,3,"PAH",508,1,6,0)="isn't selected. It will tell the use that they are missing DFN"
^DIC(9.4,35,22,3,"PAH",509,0)="601^3240726.104346^89"
^DIC(9.4,35,22,3,"PAH",509,1,0)="^^8^8^3240726"
^DIC(9.4,35,22,3,"PAH",509,1,1,0)="Multidivisional sites have requested that the list of lab tests shown in "
^DIC(9.4,35,22,3,"PAH",509,1,2,0)="the Lab Test and Anatomic Pathology order dialogs is filtered. After "
^DIC(9.4,35,22,3,"PAH",509,1,3,0)="installation of this patch, tests that are associated with one or more "
^DIC(9.4,35,22,3,"PAH",509,1,4,0)="institutions/divisions are only shown to users who are logged in to one "
^DIC(9.4,35,22,3,"PAH",509,1,5,0)="of those institutions/divisions. This will prevent users from ordering a "
^DIC(9.4,35,22,3,"PAH",509,1,6,0)="test that cannot be processed at their local facility."
^DIC(9.4,35,22,3,"PAH",509,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",509,1,8,0)="Refer to the patch description for full details."
^DIC(9.4,35,22,3,"PAH",510,0)="466 SEQ #522^3240801.144459^89"
^DIC(9.4,35,22,3,"PAH",510,1,0)="^^4^4^3240801"
^DIC(9.4,35,22,3,"PAH",510,1,1,0)="This patch will address the following issue:  "
^DIC(9.4,35,22,3,"PAH",510,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",510,1,3,0)="Cancelling an unsigned order in the Computerized Patient Record System"
^DIC(9.4,35,22,3,"PAH",510,1,4,0)="does not record who and when it was cancelled."
^DIC(9.4,35,22,3,"PAH",511,0)="606^3240808.173421^89"
^DIC(9.4,35,22,3,"PAH",512,0)="610 SEQ #525^3240903.103724^89"
^DIC(9.4,35,22,3,"PAH",512,1,0)="^^10^10^3240903"
^DIC(9.4,35,22,3,"PAH",512,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",512,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",512,1,3,0)="1. In CPRS, personal quick order processed a prescription order on an "
^DIC(9.4,35,22,3,"PAH",512,1,4,0)="inactivated drug for outpatient."
^DIC(9.4,35,22,3,"PAH",512,1,5,0)=" "
^DIC(9.4,35,22,3,"PAH",512,1,6,0)="2. In CPRS, Lab Overview, Pending Lab Orders, and Lab Orders (All) Exceed "
^DIC(9.4,35,22,3,"PAH",512,1,7,0)="Max Occurrence Limit."
^DIC(9.4,35,22,3,"PAH",512,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",512,1,9,0)="3. In CPRS, Lab Overview, Pending Lab Orders, and Lab Orders (All) return "
^DIC(9.4,35,22,3,"PAH",512,1,10,0)="results outside of given date range."
^DIC(9.4,35,22,3,"PAH",513,0)="608^3240903.104729^89"
^DIC(9.4,35,22,3,"PAH",514,0)="622 SEQ #526^3240910.173213^89"
^DIC(9.4,35,22,3,"PAH",514,1,0)="^^1^1^3240910"
^DIC(9.4,35,22,3,"PAH",514,1,1,0)="This will release a new context menu for the SalesForce CRM application."
^DIC(9.4,35,22,3,"PAH",515,0)="535 SEQ #527^3241030.124951^89"
^DIC(9.4,35,22,3,"PAH",515,1,0)="^^26^26^3241030"
^DIC(9.4,35,22,3,"PAH",515,1,1,0)="This patch introduces the following modifications:"
^DIC(9.4,35,22,3,"PAH",515,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,3,0)="1. This patch creates a new Glucophage/Metformin Order Check that uses an"
^DIC(9.4,35,22,3,"PAH",515,1,4,0)="estimated Glomerular Filtration Rate (eGFR) calculation instead of using"
^DIC(9.4,35,22,3,"PAH",515,1,5,0)="the Serum Creatinine as the current Order Check does."
^DIC(9.4,35,22,3,"PAH",515,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,7,0)="2. A problem was discovered in the Computerized Patient Record System"
^DIC(9.4,35,22,3,"PAH",515,1,8,0)="(CPRS) v31b release with the display of ordering providers in the alert"
^DIC(9.4,35,22,3,"PAH",515,1,9,0)="list. This patch will correct this issue."
^DIC(9.4,35,22,3,"PAH",515,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,11,0)="3. The Care Management Package has been decommissioned. There are"
^DIC(9.4,35,22,3,"PAH",515,1,12,0)="remaining API calls to Care Management routines in the Order"
^DIC(9.4,35,22,3,"PAH",515,1,13,0)="Entry/Results Reporting (OE/RR) package. This patch removes those API"
^DIC(9.4,35,22,3,"PAH",515,1,14,0)="calls."
^DIC(9.4,35,22,3,"PAH",515,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,16,0)="4. It adds a new option to allow sites to edit the ORDER CHECK OVERRIDE"
^DIC(9.4,35,22,3,"PAH",515,1,17,0)="REASONS (#100.04) file."
^DIC(9.4,35,22,3,"PAH",515,1,18,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,19,0)="5. It corrects the display of the patient's name in the View Patient"
^DIC(9.4,35,22,3,"PAH",515,1,20,0)="Notifications alert detail dialog."
^DIC(9.4,35,22,3,"PAH",515,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,22,0)="6. It corrects an Integration Control Registrations (ICR) documentation"
^DIC(9.4,35,22,3,"PAH",515,1,23,0)="issue recently discovered during development activities."
^DIC(9.4,35,22,3,"PAH",515,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",515,1,25,0)="7. It adds a new entry to the ORDER CHECK OVERRIDE REASONS (#100.04)"
^DIC(9.4,35,22,3,"PAH",515,1,26,0)="file."
^DIC(9.4,35,22,3,"PAH",516,0)="628^3250116.095551^89"
^DIC(9.4,35,22,3,"PAH",516,1,0)="^^1^1^3250116"
^DIC(9.4,35,22,3,"PAH",516,1,1,0)="Please see OR*3.0*628 on FORUM for a complete description."
^DIC(9.4,35,22,3,"PAH",517,0)="629 SEQ #529^3250324.123139^90"
^DIC(9.4,35,22,3,"PAH",517,1,0)="^^2^2^3250324"
^DIC(9.4,35,22,3,"PAH",517,1,1,0)="Please refer to the patch description for detailed information about this "
^DIC(9.4,35,22,3,"PAH",517,1,2,0)="release."
^DIC(9.4,35,22,3,"PAH",518,0)="618^3250324.135231^90"
^DIC(9.4,35,22,3,"PAH",518,1,0)="^^1^1^3250324"
^DIC(9.4,35,22,3,"PAH",518,1,1,0)="Create a report to display OTP Medication Dispense information."
^DIC(9.4,35,22,3,"PAH",519,0)="586 SEQ #533^3250529.074454^90"
^DIC(9.4,35,22,3,"PAH",519,1,0)="^^6^6^3250529"
^DIC(9.4,35,22,3,"PAH",519,1,1,0)=" "
^DIC(9.4,35,22,3,"PAH",519,1,2,0)="This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",519,1,3,0)="1.INC30866117- VISTAOR-36875 -Mumps error <UNDEFINED>RMK^DGRPD"
^DIC(9.4,35,22,3,"PAH",519,1,4,0)="2.INC26012459- VISTAOR-33839 -Mumps error SUBSCRIPT>ACT+3^ORQ20"
^DIC(9.4,35,22,3,"PAH",519,1,5,0)="3.INC28417583- VISTAOR-35385 -Mumps error <UNDEFINED>RPT+14^ORWRP"
^DIC(9.4,35,22,3,"PAH",519,1,6,0)="4.INC25496568- VISTAOR-35194 -Unable to print from CPRS"
^DIC(9.4,35,22,3,"PAH",520,0)="535b^3250723.131134^90"
^DIC(9.4,35,22,3,"PAH",520,1,0)="^^5^5^3250723"
^DIC(9.4,35,22,3,"PAH",520,1,1,0)="Backup of OR*3.0*535 on Oct 30, 2024"
^DIC(9.4,35,22,3,"PAH",520,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",520,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,35,22,3,"PAH",520,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",520,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,35,22,3,"PAH",521,0)="609 SEQ #535^3250731.100511^90"
^DIC(9.4,35,22,3,"PAH",521,1,0)="^^10^10^3250731"
^DIC(9.4,35,22,3,"PAH",521,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",521,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",521,1,3,0)="1. INC26544844 - Provider Role Tool transfers an order but the "
^DIC(9.4,35,22,3,"PAH",521,1,4,0)="ORDER REQUIRES ELEC SIGNATURE"
^DIC(9.4,35,22,3,"PAH",521,1,5,0)="notification sent by Audio RENEWAL goes to original provider"
^DIC(9.4,35,22,3,"PAH",521,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",521,1,7,0)="2. INC17990929 - CPRS Provider NPI Display Issue"
^DIC(9.4,35,22,3,"PAH",521,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",521,1,9,0)="3. INC30979000 - ORB3 RECIP NOTIFICATIONS"
^DIC(9.4,35,22,3,"PAH",521,1,10,0)="not displaying correct information"
^DIC(9.4,35,22,3,"PAH",522,0)="626^3251119.084848^90"
^DIC(9.4,35,22,3,"PAH",522,1,0)="^^7^7^3251119"
^DIC(9.4,35,22,3,"PAH",522,1,1,0)="This patch, along with other patches, adds Pharmacogenomic (PGx) order"
^DIC(9.4,35,22,3,"PAH",522,1,2,0)="checking to medication orders entered through Inpatient Medications,"
^DIC(9.4,35,22,3,"PAH",522,1,3,0)="Outpatient Pharmacy and Computerized Patient Record System (CPRS). A "
^DIC(9.4,35,22,3,"PAH",522,1,4,0)="patient's genomic test results will be retrieved from the Health Data"
^DIC(9.4,35,22,3,"PAH",522,1,5,0)="Repository (HDR), and along with the prospective drug(s) of a medication"
^DIC(9.4,35,22,3,"PAH",522,1,6,0)="order is sent to the vendor to retrieve interactions between the patient's"
^DIC(9.4,35,22,3,"PAH",522,1,7,0)="genes and the prospective drug(s)."
^DIC(9.4,35,22,3,"PAH",523,0)="625 SEQ #537^3260210.130445^90"
^DIC(9.4,35,22,3,"PAH",523,1,0)="^^14^14^3260210"
^DIC(9.4,35,22,3,"PAH",523,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",523,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",523,1,3,0)="1.INC29145882 -VISTAOR-37982 -Clinic infusion medication are displayed in "
^DIC(9.4,35,22,3,"PAH",523,1,4,0)="the ""Infusions"" package as "
^DIC(9.4,35,22,3,"PAH",523,1,5,0)="opposed to ""Clinic Infusions"" in CPRS."
^DIC(9.4,35,22,3,"PAH",523,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",523,1,7,0)="2.INC26174672 - VISTAOR-33937 - Multiple VIS Sheets Not Showing."
^DIC(9.4,35,22,3,"PAH",523,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",523,1,9,0)="3.INC28822263 -VISTAOR-35454 -Mumps error <COMMAND>OUT+5^ORMPS1"
^DIC(9.4,35,22,3,"PAH",523,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",523,1,11,0)="4.INC31681077- VISTAOR-37164 - HITPS-11291- R3 - (CMS)Bug in Medication "
^DIC(9.4,35,22,3,"PAH",523,1,12,0)="Package - Vista/CPRS "
^DIC(9.4,35,22,3,"PAH",523,1,13,0)="        Duplicate(s): INC32306932, INC32507532, INC33118775, INC33589172, "
^DIC(9.4,35,22,3,"PAH",523,1,14,0)="INC35017564, INC37580925."
^DIC(9.4,35,22,3,"PAH",524,0)="617 SEQ #538^3260316.125742^90"
^DIC(9.4,35,22,3,"PAH",524,1,0)="^^12^12^3260316"
^DIC(9.4,35,22,3,"PAH",524,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,35,22,3,"PAH",524,1,2,0)="1. INC31115306 - VISTAOR-36624 - Anticoagulation Management Tool software "
^DIC(9.4,35,22,3,"PAH",524,1,3,0)="reverting dosing matrix to previous value."
^DIC(9.4,35,22,3,"PAH",524,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",524,1,5,0)="2. INC32051845 - VISTAOR-36623 - Anti-coagulation Management Tool (AMT) "
^DIC(9.4,35,22,3,"PAH",524,1,6,0)="needs to be rebuilt with a newer version of broker."
^DIC(9.4,35,22,3,"PAH",524,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",524,1,8,0)="3. INC35910518 - VISTAOR-38601 - ""floating point value"" Error when adding"
^DIC(9.4,35,22,3,"PAH",524,1,9,0)="new warfarin patient to the Anticoagulation Management Tool."
^DIC(9.4,35,22,3,"PAH",524,1,10,0)=" "
^DIC(9.4,35,22,3,"PAH",524,1,11,0)="4. N/A - VISTAOR-38467 - ICR 10060 Violation - direct global read "
^DIC(9.4,35,22,3,"PAH",524,1,12,0)="^VA(200,IEN,0) in ORAM1"
^DIC(9.4,35,22,3,"PAH",525,0)="508^3260508.090034^90"
^DIC(9.4,35,22,3,"PAH",525,1,0)="^^5^5^3260508"
^DIC(9.4,35,22,3,"PAH",525,1,1,0)="The purpose of this build is to deliver the Order Entry/Results Reporting "
^DIC(9.4,35,22,3,"PAH",525,1,2,0)="changes for the CPRS v33CON - Congressional Mandates release."
^DIC(9.4,35,22,3,"PAH",525,1,3,0)=" "
^DIC(9.4,35,22,3,"PAH",525,1,4,0)="Please refer to the patch description and any release notes for a "
^DIC(9.4,35,22,3,"PAH",525,1,5,0)="complete description of the functionality changes. "
