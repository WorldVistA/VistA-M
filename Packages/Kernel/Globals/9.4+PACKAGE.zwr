^DIC(9.4,4,22,1,"PAH",162,0)="191 SEQ #187^3010802^1"
^DIC(9.4,4,22,1,"PAH",162,1,0)="^^56^56^3010802"
^DIC(9.4,4,22,1,"PAH",162,1,1,0)="Patch XM*7.1*191"
