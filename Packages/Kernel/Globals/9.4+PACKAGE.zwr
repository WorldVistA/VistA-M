^DIC(9.4,114,22,30,"PAH",0)="^9.4901^162^162"
^DIC(9.4,114,22,30,"PAH",1,0)="5 SEQ #4^2960823^1"
^DIC(9.4,114,22,30,"PAH",1,1,0)="^^4^4^2960823"
^DIC(9.4,114,22,30,"PAH",1,1,1,0)="Fee Basis patch FB*3.5*5.  This patch contains the output "
^DIC(9.4,114,22,30,"PAH",1,1,2,0)="transform on three fields, PLACE OF SERVICE (162.03,30), HCFA"
^DIC(9.4,114,22,30,"PAH",1,1,3,0)="TYPE OF SERVICE (162.03,31) and DISCHARGE TYPE (162.7,29).  Also "
^DIC(9.4,114,22,30,"PAH",1,1,4,0)="included in this patch are two routines; FBPAID and FBAACCB0."
^DIC(9.4,114,22,30,"PAH",2,0)="7 SEQ #6^2970122^1"
^DIC(9.4,114,22,30,"PAH",2,1,0)="^^1^1^2970122"
^DIC(9.4,114,22,30,"PAH",2,1,1,0)="Fee Basis patch seven."
^DIC(9.4,114,22,30,"PAH",3,0)="8 SEQ #7^2970528^1"
^DIC(9.4,114,22,30,"PAH",3,1,0)="^^1^1^2970528"
^DIC(9.4,114,22,30,"PAH",3,1,1,0)="UNAUTHORIZED CLAIM UPDATE STATUS/YR 2000"
^DIC(9.4,114,22,30,"PAH",4,0)="9 SEQ #8^2971007^1"
^DIC(9.4,114,22,30,"PAH",4,1,0)="^^9^9^2971007"
^DIC(9.4,114,22,30,"PAH",4,1,1,0)="Enhancement to maintain socio-economic characteristics of vendors for"
^DIC(9.4,114,22,30,"PAH",4,1,2,0)="Federal Procurement Data System (FPDS) reporting."
^DIC(9.4,114,22,30,"PAH",4,1,3,0)=" o BUSINESS TYPE (FPDS) and SOCIOECONOMIC GROUP (FPDS) fields added to"
^DIC(9.4,114,22,30,"PAH",4,1,4,0)="   FEE BASIS VENDOR file."
^DIC(9.4,114,22,30,"PAH",4,1,5,0)=" o Existing vendor edit options modified to include the new fields."
^DIC(9.4,114,22,30,"PAH",4,1,6,0)=" o New vendor edit option to just update the new fields for existing"
^DIC(9.4,114,22,30,"PAH",4,1,7,0)="   vendors."
^DIC(9.4,114,22,30,"PAH",4,1,8,0)=" o New List Vendors Without FPDS Data option to report vendors with a"
^DIC(9.4,114,22,30,"PAH",4,1,9,0)="   blank BUSINESS TYPE (FPDS)."
^DIC(9.4,114,22,30,"PAH",5,0)="10 SEQ #9^2971118^1"
^DIC(9.4,114,22,30,"PAH",5,1,0)="^^4^4^2971118"
^DIC(9.4,114,22,30,"PAH",5,1,1,0)="Enhancement to include socio-economic data in Vendor MRA messages."
^DIC(9.4,114,22,30,"PAH",5,1,2,0)=" o Modified C1 and C4 Batch Types to include data elements."
^DIC(9.4,114,22,30,"PAH",5,1,3,0)=" o Added new action 'F' (FPDS-Only) for Vendor MRA messages."
^DIC(9.4,114,22,30,"PAH",5,1,4,0)=" o Post-Init queues MRA messages for vendors with data."
^DIC(9.4,114,22,30,"PAH",6,0)="11 SEQ #10^2980318^1"
^DIC(9.4,114,22,30,"PAH",6,1,0)="^^1^1^2980318"
^DIC(9.4,114,22,30,"PAH",6,1,1,0)="Examines and corrects FEE BASIS ID CARD AUDIT (#161.83) file data."
^DIC(9.4,114,22,30,"PAH",7,0)="12 SEQ #11^2980330^1"
^DIC(9.4,114,22,30,"PAH",7,1,0)="^^1^1^2980330"
^DIC(9.4,114,22,30,"PAH",7,1,1,0)="YEAR 2000 Renovations."
^DIC(9.4,114,22,30,"PAH",8,0)="14^2981007^1"
^DIC(9.4,114,22,30,"PAH",8,1,0)="^^4^4^2981007"
^DIC(9.4,114,22,30,"PAH",8,1,1,0)="FEE BASIS Extract for the Health Eligibility Center (HEC-Atlanta)."
^DIC(9.4,114,22,30,"PAH",8,1,2,0)=" 1) New routine to build HL7 ZFE segments for FEE authorization data."
^DIC(9.4,114,22,30,"PAH",8,1,3,0)=" 2) New mumps cross-references to call IVMPLOG when File 161 edited."
^DIC(9.4,114,22,30,"PAH",8,1,4,0)=" 3) Post-Install to log existing FEE BASIS PATIENTS in daily transmission."
^DIC(9.4,114,22,30,"PAH",9,0)="15 SEQ #13^2981214^1"
^DIC(9.4,114,22,30,"PAH",9,1,0)="^^2^2^2981214"
^DIC(9.4,114,22,30,"PAH",9,1,1,0)="Validate CNH 0168 Code Sheets to ensure that the required Data of Last"
^DIC(9.4,114,22,30,"PAH",9,1,2,0)="Assessment field has been populated for applicable vendors."
^DIC(9.4,114,22,30,"PAH",10,0)="13 SEQ #14^2990316^1"
^DIC(9.4,114,22,30,"PAH",10,1,0)="^^8^8^2990316"
^DIC(9.4,114,22,30,"PAH",10,1,1,0)="State Home Program Enhancement"
^DIC(9.4,114,22,30,"PAH",10,1,2,0)=" 1. State Home Main Menu added."
^DIC(9.4,114,22,30,"PAH",10,1,3,0)=" 2. Four options added for entry/edit of State Home authorizations."
^DIC(9.4,114,22,30,"PAH",10,1,4,0)=" 3. Active Authorization Report option added."
^DIC(9.4,114,22,30,"PAH",10,1,5,0)=" 4. The sort order of authorizations listed to the screen for all FEE"
^DIC(9.4,114,22,30,"PAH",10,1,6,0)="    programs has been changed to list the later From Dates first."
^DIC(9.4,114,22,30,"PAH",10,1,7,0)=" 5. Veteran MRA modified to support State Home authorizations and multiple"
^DIC(9.4,114,22,30,"PAH",10,1,8,0)="    MRAs for veteran."
^DIC(9.4,114,22,30,"PAH",11,0)="16 SEQ #15^2990322^1"
^DIC(9.4,114,22,30,"PAH",11,1,0)="^^1^1^2990322"
^DIC(9.4,114,22,30,"PAH",11,1,1,0)="Add new API for determining if patient has any FEE authorizations."
^DIC(9.4,114,22,30,"PAH",12,0)="17 SEQ #16^2990329^1"
^DIC(9.4,114,22,30,"PAH",12,1,0)="^^2^2^2990329"
^DIC(9.4,114,22,30,"PAH",12,1,1,0)="Fix Enter CNH Payment to prevent an undefined variable error that can"
^DIC(9.4,114,22,30,"PAH",12,1,2,0)="occur after FileMan v22 is installed."
^DIC(9.4,114,22,30,"PAH",13,0)="18 SEQ #17^2990603^1"
^DIC(9.4,114,22,30,"PAH",13,1,0)="^^2^2^2990603"
^DIC(9.4,114,22,30,"PAH",13,1,1,0)="Fixes MRA purge options so veteran MRAs in PENDING status are not"
^DIC(9.4,114,22,30,"PAH",13,1,2,0)="inappropriately deleted."
^DIC(9.4,114,22,30,"PAH",14,0)="4^2991003^1"
^DIC(9.4,114,22,30,"PAH",14,1,0)="^^1^1^2991003"
^DIC(9.4,114,22,30,"PAH",14,1,1,0)=" o Use Medicare's RBRVS fee schedule for outpatient and ancillary payment."
^DIC(9.4,114,22,30,"PAH",15,0)="20^3000612^1"
^DIC(9.4,114,22,30,"PAH",15,1,0)="^^1^1^3000612"
^DIC(9.4,114,22,30,"PAH",15,1,1,0)="Add RBRVS physician fee schedule for calendar year 2000 to the software."
^DIC(9.4,114,22,30,"PAH",16,0)="21 SEQ #20^3000626^1"
^DIC(9.4,114,22,30,"PAH",16,1,0)="^^3^3^3000626"
^DIC(9.4,114,22,30,"PAH",16,1,1,0)=" o Improve validation checks for the Multiple Payment Entry option."
^DIC(9.4,114,22,30,"PAH",16,1,2,0)=" o Fix several options to show the description of a CPT Modifier even when"
^DIC(9.4,114,22,30,"PAH",16,1,3,0)="   the modifier value can have more than one meaning."
^DIC(9.4,114,22,30,"PAH",17,0)="23 SEQ #21^3010103^1"
^DIC(9.4,114,22,30,"PAH",17,1,0)="^^12^12^3010103"
^DIC(9.4,114,22,30,"PAH",17,1,1,0)="This patch will address two separate issues."
^DIC(9.4,114,22,30,"PAH",17,1,2,0)=""
^DIC(9.4,114,22,30,"PAH",17,1,3,0)="1.  It will add the Mail Code (#5.5) field to the FEE BASIS SITE PARAMETERS "
^DIC(9.4,114,22,30,"PAH",17,1,4,0)="    (#161.4) file.  This will allow the sites to edit and update this field"
^DIC(9.4,114,22,30,"PAH",17,1,5,0)="    to insure that the correct Mail Code appears in the upper right hand"
^DIC(9.4,114,22,30,"PAH",17,1,6,0)="    corner of their Unauthorized Claim letters."
^DIC(9.4,114,22,30,"PAH",17,1,7,0)=""
^DIC(9.4,114,22,30,"PAH",17,1,8,0)="2.  Several of the Fee Basis letters will be updated to use the Name"
^DIC(9.4,114,22,30,"PAH",17,1,9,0)="    Standardization API to insure that the veteran's name appears correctly"
^DIC(9.4,114,22,30,"PAH",17,1,10,0)="    on letters that could go outside of the VHA."
^DIC(9.4,114,22,30,"PAH",17,1,11,0)=""
^DIC(9.4,114,22,30,"PAH",17,1,12,0)=""
^DIC(9.4,114,22,30,"PAH",18,0)="24 SEQ #22^3010103^1"
^DIC(9.4,114,22,30,"PAH",18,1,0)="^^4^4^3010103"
^DIC(9.4,114,22,30,"PAH",18,1,1,0)="This patch adds the following codes to the software:"
^DIC(9.4,114,22,30,"PAH",18,1,2,0)=" o New Purpose of Visit Code: CHIROPRACTIC CARE (75)"
^DIC(9.4,114,22,30,"PAH",18,1,3,0)=" o New Participation Code: DOCTOR OF CHIROPRACTIC (15)"
^DIC(9.4,114,22,30,"PAH",18,1,4,0)=" o New Specialty Code: CHIROPRACTIC (53)"
^DIC(9.4,114,22,30,"PAH",19,0)="22 SEQ #23^3010227^1"
^DIC(9.4,114,22,30,"PAH",19,1,0)="^^2^2^3010227"
^DIC(9.4,114,22,30,"PAH",19,1,1,0)="Enhancement patch to add 12 purpose of visit codes for use with the"
^DIC(9.4,114,22,30,"PAH",19,1,2,0)="Medical Fee (Outpatient) program."
^DIC(9.4,114,22,30,"PAH",20,0)="25 SEQ #24^3010228^1"
^DIC(9.4,114,22,30,"PAH",20,1,0)="^^1^1^3010228"
^DIC(9.4,114,22,30,"PAH",20,1,1,0)="CORRECT %DT, %DT(0) ERRORS AND PRINTING PROBLEMS"
^DIC(9.4,114,22,30,"PAH",21,0)="29^3010430^1"
^DIC(9.4,114,22,30,"PAH",21,1,0)="^^1^1^3010430"
^DIC(9.4,114,22,30,"PAH",21,1,1,0)="Add RBRVS physician fee schedule for calendar year 2001 to the software."
^DIC(9.4,114,22,30,"PAH",22,0)="19 SEQ #26^3010625^1"
^DIC(9.4,114,22,30,"PAH",22,1,0)="^^9^9^3010625"
^DIC(9.4,114,22,30,"PAH",22,1,1,0)="Modifications to Fee Basis to handle merge of entries in PATIENT (#2)."
^DIC(9.4,114,22,30,"PAH",22,1,2,0)=" 1. Update cross-references that depend on a patient ien, so they will be"
^DIC(9.4,114,22,30,"PAH",22,1,3,0)="    updated when the patient is changed."
^DIC(9.4,114,22,30,"PAH",22,1,4,0)=" 2. Add a special patient merge routine for FEE BASIS to handle files that"
^DIC(9.4,114,22,30,"PAH",22,1,5,0)="    are dinumed with the PATIENT file, free-text pointers, and internal"
^DIC(9.4,114,22,30,"PAH",22,1,6,0)="    entry numbers (iens) sent to the AAC."
^DIC(9.4,114,22,30,"PAH",22,1,7,0)=" 3. Update the FBAA PAID SERVER to check for merged patients."
^DIC(9.4,114,22,30,"PAH",22,1,8,0)=" 4. Perform a one-time task to identify previously merged patients and"
^DIC(9.4,114,22,30,"PAH",22,1,9,0)="    update FEE Basis data accordingly."
^DIC(9.4,114,22,30,"PAH",23,0)="26 SEQ #27^3010710^1"
^DIC(9.4,114,22,30,"PAH",23,1,0)="^^1^1^3010710"
^DIC(9.4,114,22,30,"PAH",23,1,1,0)="REMOVE OBSOLETE FEE BASIS MENU OPTIONS, ROUTINES, AND INPUT TEMPLATE"
