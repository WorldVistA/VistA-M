^DIC(9.4,3,22,21,"PAH",86,1,22,0)="      so you will need to disable mapping for the affected routine. "
^DIC(9.4,3,22,21,"PAH",86,1,23,0)="     "
^DIC(9.4,3,22,21,"PAH",86,1,24,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",86,1,25,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",86,1,26,0)="     "
^DIC(9.4,3,22,21,"PAH",86,1,27,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",86,1,28,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",86,1,29,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",86,1,30,0)="      options:"
^DIC(9.4,3,22,21,"PAH",86,1,31,0)="      "
