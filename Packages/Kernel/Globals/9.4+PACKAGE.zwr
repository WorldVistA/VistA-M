^DIC(9.4,4,22,1,"PAH",149,1,43,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",149,1,44,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",149,1,45,0)=" Select INSTALL NAME:    XM*7.1*181    Loaded from Distribution  <date/time>"
