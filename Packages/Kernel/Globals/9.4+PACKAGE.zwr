^DIC(9.4,14,22,5.9,"PAH",129,1,53,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",129,1,54,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",129,1,55,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",129,1,56,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",129,1,57,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",129,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",129,1,59,0)="                    Checksum       Checksum"
