^DIC(9.4,3,22,21,"PAH",153,1,11,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",153,1,12,0)="============================="
^DIC(9.4,3,22,21,"PAH",153,1,13,0)="Clearance - Nov. 2, 2000 "
^DIC(9.4,3,22,21,"PAH",153,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,15,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",153,1,16,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",153,1,17,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",153,1,18,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",153,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,20,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",153,1,21,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",153,1,22,0)="XLFDT         4356861   4357199    **71,120,166,168,179**"
^DIC(9.4,3,22,21,"PAH",153,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,24,0)="List of preceding patches: 168"
^DIC(9.4,3,22,21,"PAH",153,1,25,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",153,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,27,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",153,1,28,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",153,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,30,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",153,1,31,0)=">>>Taskman does not need to be stopped."
^DIC(9.4,3,22,21,"PAH",153,1,32,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,33,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",153,1,34,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",153,1,35,0)="     "
^DIC(9.4,3,22,21,"PAH",153,1,36,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",153,1,37,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",153,1,38,0)="     "
^DIC(9.4,3,22,21,"PAH",153,1,39,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",153,1,40,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",153,1,41,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",153,1,42,0)="      options:"
^DIC(9.4,3,22,21,"PAH",153,1,43,0)="      "
^DIC(9.4,3,22,21,"PAH",153,1,44,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",153,1,45,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",153,1,46,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",153,1,47,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",153,1,48,0)="     "
^DIC(9.4,3,22,21,"PAH",153,1,49,0)="  4.  Users can remain on the system."
^DIC(9.4,3,22,21,"PAH",153,1,50,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",153,1,51,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",153,1,52,0)="      TASKMAN can remain running."
^DIC(9.4,3,22,21,"PAH",153,1,53,0)="      Option: Place Taskman in a WAIT State"
^DIC(9.4,3,22,21,"PAH",153,1,54,0)=""
^DIC(9.4,3,22,21,"PAH",153,1,55,0)="     "
^DIC(9.4,3,22,21,"PAH",153,1,56,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",153,1,57,0)="      option:"
^DIC(9.4,3,22,21,"PAH",153,1,58,0)="        Install Package(s)  'XU*8.0*179'"
^DIC(9.4,3,22,21,"PAH",153,1,59,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",153,1,60,0)="         "
^DIC(9.4,3,22,21,"PAH",153,1,61,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO "
^DIC(9.4,3,22,21,"PAH",153,1,62,0)="        "
^DIC(9.4,3,22,21,"PAH",153,1,63,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",153,1,64,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",153,1,65,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",153,1,66,0)="     "
^DIC(9.4,3,22,21,"PAH",153,1,67,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",153,1,68,0)=""
