^DIC(9.4,59,22,5,"PAH",206,0)="100 SEQ #206^3090928.152816^17"
^DIC(9.4,59,22,5,"PAH",206,1,0)="^^16^16^3090928"
^DIC(9.4,59,22,5,"PAH",206,1,1,0)=" "
^DIC(9.4,59,22,5,"PAH",206,1,2,0)="1.  National Drug File data update patches make a call to an ADVERSE REACTION"
^DIC(9.4,59,22,5,"PAH",206,1,3,0)="TRACKING routine, UPDATE^GMRAUTL2, to update the PATIENT ALLERGIES file"
^DIC(9.4,59,22,5,"PAH",206,1,4,0)="(#120.8) when entries in the VA PRODUCT file (#50.68) are assigned to a"
^DIC(9.4,59,22,5,"PAH",206,1,5,0)="new class.  Consolidated Mail Outpatient Pharmacies (CMOPs) typically do"
^DIC(9.4,59,22,5,"PAH",206,1,6,0)="not have the ADVERSE REACTION TRACKING application installed, so this call"
^DIC(9.4,59,22,5,"PAH",206,1,7,0)="generates a <NOROUTINE> error.  It causes no problems with the update"
^DIC(9.4,59,22,5,"PAH",206,1,8,0)="process but it is an irritation.  This patch adds a check before"
^DIC(9.4,59,22,5,"PAH",206,1,9,0)="calling this routine."
^DIC(9.4,59,22,5,"PAH",206,1,10,0)=" "
^DIC(9.4,59,22,5,"PAH",206,1,11,0)="2.  In some cases, the header node of the ACTIVE INGREDIENTS multiple"
^DIC(9.4,59,22,5,"PAH",206,1,12,0)="field (#14) in the VA PRODUCT file (#50.68) was not being set.  This"
^DIC(9.4,59,22,5,"PAH",206,1,13,0)="patch sets those nodes."
^DIC(9.4,59,22,5,"PAH",206,1,14,0)=" "
^DIC(9.4,59,22,5,"PAH",206,1,15,0)="3.  The write and delete protection on the DRUG UNITS file (#50.607) was"
^DIC(9.4,59,22,5,"PAH",206,1,16,0)="not set.  This patch sets those protections."
^DIC(9.4,59,22,5,"PAH",207,0)="218^3091005.162855^17"
^DIC(9.4,59,22,5,"PAH",207,1,0)="^^18^18^3091005"
^DIC(9.4,59,22,5,"PAH",207,1,1,0)=" "
