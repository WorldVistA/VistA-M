^DIC(9.4,48,22,5.28,"PAH",491,1,33,0)="  Xref-AEVENT2"
^DIC(9.4,48,22,5.28,"PAH",491,1,34,0)=".04    STATUS"
^DIC(9.4,48,22,5.28,"PAH",491,1,35,0)="  Xref-AEVENT3"
^DIC(9.4,48,22,5.28,"PAH",491,1,36,0)=".06    PRECEPTOR TEAM POSITION"
^DIC(9.4,48,22,5.28,"PAH",491,1,37,0)="  Xref-AEVENT4"
^DIC(9.4,48,22,5.28,"PAH",491,1,38,0)=" "
^DIC(9.4,48,22,5.28,"PAH",491,1,39,0)="TEAM POSITION FILE (#404.57)"
^DIC(9.4,48,22,5.28,"PAH",491,1,40,0)=".04    POSSIBLE PRIMARY PRACTITIONER?"
^DIC(9.4,48,22,5.28,"PAH",491,1,41,0)="  FIELD INDEX: AE (#208)"
