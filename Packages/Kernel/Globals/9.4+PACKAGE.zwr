^DIC(9.4,181,22,"B","1.0",1)=""
^DIC(9.4,181,"VERSION")="1.0"
^DIC(9.4,182,0)="PHARMACY^PS^OUTPATIENT LABELS, PROFILE, INVENTORY, PRESCRIPTIONS"
^DIC(9.4,182,5)="BIRMINGHAM"
^DIC(9.4,182,7)=""
^DIC(9.4,182,22,0)="^9.49I^1^1"
^DIC(9.4,182,22,1,0)="1.0^3011107^3011231^1"
^DIC(9.4,182,22,1,1,0)="^^13^13^3011231"
^DIC(9.4,182,22,1,1,1,0)="A site reported a problem where a one-time order could not be discontinued"
^DIC(9.4,182,22,1,1,2,0)="by the provider because it was expired due to the start and stop date"
^DIC(9.4,182,22,1,1,3,0)="being the same. However, the medication still displayed in Bar Code"
^DIC(9.4,182,22,1,1,4,0)="Medication Administration (BCMA) V. 1.0 because of the 12-hour rule for"
^DIC(9.4,182,22,1,1,5,0)="displaying one-time orders on the Virtual Due List.  This patch corrects"
^DIC(9.4,182,22,1,1,6,0)="this problem by changing the way the stop date for one-time orders is"
^DIC(9.4,182,22,1,1,7,0)="calculated. There will be a ward parameter, system parameter and the"
^DIC(9.4,182,22,1,1,8,0)="standard calculation. The hierarchy will be to check the one-time ward"
^DIC(9.4,182,22,1,1,9,0)="parameter first, if not defined, check the system parameter.  If the"
^DIC(9.4,182,22,1,1,10,0)="system parameter is not defined, the system will use the continuous order"
^DIC(9.4,182,22,1,1,11,0)="parameters to determine the stop date, rather than the start and stop date"
^DIC(9.4,182,22,1,1,12,0)="being equal.  Then, when BCMA marks the medication as 'Given', Inpatient"
^DIC(9.4,182,22,1,1,13,0)="Medications will expire the order. NOIS# BUT-0501-20609"
^DIC(9.4,182,22,"B","1.0",1)=""
^DIC(9.4,182,"DEV")="XAK,MJK/ALBANY GK-AMC/BHM"
^DIC(9.4,182,"VERSION")="1.0"
