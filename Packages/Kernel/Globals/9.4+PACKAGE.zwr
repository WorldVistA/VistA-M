^DIC(9.4,48,22,5.28,"PAH",582,1,119,0)="5) Jira #VSE-787: Prompt scheduler to verify patient contact information."
^DIC(9.4,48,22,5.28,"PAH",582,1,120,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,121,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,122,0)="Prompt the schedule to verify auto-filled patient contact information "
^DIC(9.4,48,22,5.28,"PAH",582,1,123,0)="when creating a video appointment from VS, so that appointment "
^DIC(9.4,48,22,5.28,"PAH",582,1,124,0)="information is sent to the right email/number."
^DIC(9.4,48,22,5.28,"PAH",582,1,125,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,126,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,127,0)="Scheduler is prompted to confirm that the auto-filled email address/phone "
^DIC(9.4,48,22,5.28,"PAH",582,1,128,0)="number(s) in the Make Video Visit window is correct."
^DIC(9.4,48,22,5.28,"PAH",582,1,129,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,130,0)="6) Jira #VSE-788: Add zip code field to Make Video Visit screen."
^DIC(9.4,48,22,5.28,"PAH",582,1,131,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,132,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,133,0)="Display patient's zip code on the Make Video Visit screen to know "
^DIC(9.4,48,22,5.28,"PAH",582,1,134,0)="patient's location."
^DIC(9.4,48,22,5.28,"PAH",582,1,135,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,136,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,137,0)="Patient's zip code is displayed on the Make Video Visit screen."
^DIC(9.4,48,22,5.28,"PAH",582,1,138,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,139,0)="7) Jira #VSE-789: Include option to receive Video Visit Service (VVS)"
^DIC(9.4,48,22,5.28,"PAH",582,1,140,0)="link via text."
^DIC(9.4,48,22,5.28,"PAH",582,1,141,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,142,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,143,0)="Indicate when making a video appointment from VS that the "
^DIC(9.4,48,22,5.28,"PAH",582,1,144,0)="patient/provider prefers to receive the video link via email, text "
^DIC(9.4,48,22,5.28,"PAH",582,1,145,0)="message, or both."
^DIC(9.4,48,22,5.28,"PAH",582,1,146,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,147,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,148,0)="Added ability to indicate a patient's preferred contact method (email or "
^DIC(9.4,48,22,5.28,"PAH",582,1,149,0)="SMS)."
^DIC(9.4,48,22,5.28,"PAH",582,1,150,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,151,0)="8) Jira #VSE-792: Update tooltips to reflect most-used name for RM Grid."
^DIC(9.4,48,22,5.28,"PAH",582,1,152,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,153,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,154,0)="Tool buttons tooltips display ""Wait List"" instead of ""RM Grid"" or "
^DIC(9.4,48,22,5.28,"PAH",582,1,155,0)="""Facility/Default View"" (e.g. ""Export Wait List"")"
^DIC(9.4,48,22,5.28,"PAH",582,1,156,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,157,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,158,0)="Renamed each to accurate label."
^DIC(9.4,48,22,5.28,"PAH",582,1,159,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,160,0)="9) Jira #VSE-793: Consolidate Appointment window to one tab."
^DIC(9.4,48,22,5.28,"PAH",582,1,161,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,162,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,163,0)="View/New Appointment modal dialog displays a single tab."
^DIC(9.4,48,22,5.28,"PAH",582,1,164,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,165,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,166,0)="Consolidated Appointment window to one tab."
^DIC(9.4,48,22,5.28,"PAH",582,1,167,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,168,0)="10) Jira #VSE-794: Update expand/collapse icon on time slot viewer."
^DIC(9.4,48,22,5.28,"PAH",582,1,169,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,170,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,171,0)="Time Slot Viewer expand/collapse icon opposes behavior."
^DIC(9.4,48,22,5.28,"PAH",582,1,172,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,173,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,174,0)="Display correct icons when collapsed and expanded."
^DIC(9.4,48,22,5.28,"PAH",582,1,175,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,176,0)="11) Jira #VSE-795: Loading dialog has duplicate word."
^DIC(9.4,48,22,5.28,"PAH",582,1,177,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,178,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,179,0)="Clicking a Pending Appointment displays ""Loading Clinic Schedule"
^DIC(9.4,48,22,5.28,"PAH",582,1,180,0)="Schedule"". "
^DIC(9.4,48,22,5.28,"PAH",582,1,181,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,182,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,183,0)="Renamed to ""Loading Clinic Schedule""."
^DIC(9.4,48,22,5.28,"PAH",582,1,184,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,185,0)="12) Jira #VSE-801: Improve error handling on Make VVS Appointment."
^DIC(9.4,48,22,5.28,"PAH",582,1,186,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,187,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,188,0)="Improve error handling for ICN Error, Access Error, and Timeout/VVS "
^DIC(9.4,48,22,5.28,"PAH",582,1,189,0)="system down error."
^DIC(9.4,48,22,5.28,"PAH",582,1,190,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,191,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,192,0)="A window was created to handle errors so that the system message box is "
^DIC(9.4,48,22,5.28,"PAH",582,1,193,0)="not required to display errors to users."
^DIC(9.4,48,22,5.28,"PAH",582,1,194,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,195,0)="13) Jira #VSE-802: Error Window."
^DIC(9.4,48,22,5.28,"PAH",582,1,196,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,197,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,198,0)="Create a window to handle errors so that the system message box is not "
^DIC(9.4,48,22,5.28,"PAH",582,1,199,0)="required to display errors to users."
^DIC(9.4,48,22,5.28,"PAH",582,1,200,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,201,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,202,0)="A window was created to handle errors so that the system message box is "
^DIC(9.4,48,22,5.28,"PAH",582,1,203,0)="not required to display errors to users."
^DIC(9.4,48,22,5.28,"PAH",582,1,204,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,205,0)="14) Jira #VSE-804: Add contact method preferences to VVS Make Appointment "
^DIC(9.4,48,22,5.28,"PAH",582,1,206,0)="screen - Patient."
^DIC(9.4,48,22,5.28,"PAH",582,1,207,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,208,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,209,0)="Add ability to indicate a patient's preferred contact method (email or "
^DIC(9.4,48,22,5.28,"PAH",582,1,210,0)="SMS)."
^DIC(9.4,48,22,5.28,"PAH",582,1,211,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,212,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,213,0)="Email for patient is no longer required. Email or SMS is acceptable. Add "
^DIC(9.4,48,22,5.28,"PAH",582,1,214,0)="a message explaining that email and/or SMS will be sent if contact info "
^DIC(9.4,48,22,5.28,"PAH",582,1,215,0)="is provided."
^DIC(9.4,48,22,5.28,"PAH",582,1,216,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,217,0)="15) Jira #VSE-805: Add contact method preferences to VVS make appointment "
^DIC(9.4,48,22,5.28,"PAH",582,1,218,0)="screen - Provider."
^DIC(9.4,48,22,5.28,"PAH",582,1,219,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,220,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,221,0)="Add ability to indicate a provider's preferred contact method (email or "
^DIC(9.4,48,22,5.28,"PAH",582,1,222,0)="SMS)."
^DIC(9.4,48,22,5.28,"PAH",582,1,223,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,224,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,225,0)="For providers, email is the required method of communication. If there is "
^DIC(9.4,48,22,5.28,"PAH",582,1,226,0)="a cell phone number, then an SMS will be sent in addition to the email. "
^DIC(9.4,48,22,5.28,"PAH",582,1,227,0)="This behavior will be described in a text label."
^DIC(9.4,48,22,5.28,"PAH",582,1,228,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,229,0)="16) Jira #VSE-861: Formalize JSON Return Errors."
^DIC(9.4,48,22,5.28,"PAH",582,1,230,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,231,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,232,0)="Fix JSON returns to follow new JSON return pattern."
^DIC(9.4,48,22,5.28,"PAH",582,1,233,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,234,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,235,0)="JSON returns follow new JSON return pattern."
^DIC(9.4,48,22,5.28,"PAH",582,1,236,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,237,0)="17) Jira #VSE-863 - Updates/corrections to PtCSch code."
^DIC(9.4,48,22,5.28,"PAH",582,1,238,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,239,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,240,0)="Updates/corrections to PtCSch code based on work done as part of VSE-737"
^DIC(9.4,48,22,5.28,"PAH",582,1,241,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,242,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,243,0)="VS GUI was updated to utilize the optimized VistA RPCs associated with the"
^DIC(9.4,48,22,5.28,"PAH",582,1,244,0)="work done in a prior sprint related to VSE-737 and released in SD*5.3*785."
^DIC(9.4,48,22,5.28,"PAH",582,1,245,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,246,0)="18) Jira #VSE-876: Develop option to identify stuck MRTCs and disposition."
^DIC(9.4,48,22,5.28,"PAH",582,1,247,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,248,0)="Problem: "
^DIC(9.4,48,22,5.28,"PAH",582,1,249,0)="A new menu option is needed to clean up those MRTC children where the "
^DIC(9.4,48,22,5.28,"PAH",582,1,250,0)="parent has been dispositioned and closed, but the child was left open."
^DIC(9.4,48,22,5.28,"PAH",582,1,251,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,252,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,253,0)="A new menu option, SDEC MRTC CHILD CLEANUP (""Stuck MRTC child cleanup "
^DIC(9.4,48,22,5.28,"PAH",582,1,254,0)="tool"") was created. The tool will go through all open return to clinic "
^DIC(9.4,48,22,5.28,"PAH",582,1,255,0)="requests that are MRTCs with a PID less than or equal to the date-90 days "
^DIC(9.4,48,22,5.28,"PAH",582,1,256,0)="(or user entered date which is no sooner than -90 days). If the Parent "
^DIC(9.4,48,22,5.28,"PAH",582,1,257,0)="is closed and dispositioned the child request will be closed and "
^DIC(9.4,48,22,5.28,"PAH",582,1,258,0)="assigned the disposition based on the parents disposition."
^DIC(9.4,48,22,5.28,"PAH",582,1,259,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,260,0)="19) Jira #VSE-875: Update GUI logic for MRTC PIDs so that they are static "
^DIC(9.4,48,22,5.28,"PAH",582,1,261,0)="based on parent PID."
^DIC(9.4,48,22,5.28,"PAH",582,1,262,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,263,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,264,0)="MRTC PID dates should NOT be based on appointment made. PID should be "
^DIC(9.4,48,22,5.28,"PAH",582,1,265,0)="static."
^DIC(9.4,48,22,5.28,"PAH",582,1,266,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,267,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,268,0)="MRTC PIDs are static based on parent PID."
^DIC(9.4,48,22,5.28,"PAH",582,1,269,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,270,0)="20) Jira #VSE-876 - Develop option to identify stuck MRTCs and "
^DIC(9.4,48,22,5.28,"PAH",582,1,271,0)="disposition."
^DIC(9.4,48,22,5.28,"PAH",582,1,272,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,273,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,274,0)="A new menu option is needed to clean up those Multiple Return to Clinic "
^DIC(9.4,48,22,5.28,"PAH",582,1,275,0)="(MRTC) children where the parent has been dispositioned and closed, but "
^DIC(9.4,48,22,5.28,"PAH",582,1,276,0)="the child was left open."
^DIC(9.4,48,22,5.28,"PAH",582,1,277,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,278,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,279,0)="A new menu option, SDEC MRTC CHILD CLEANUP (""Stuck MRTC child cleanup "
^DIC(9.4,48,22,5.28,"PAH",582,1,280,0)="tool"") was created. The Tool will go through all open return to clinic "
^DIC(9.4,48,22,5.28,"PAH",582,1,281,0)="requests that are MRTCs with a PID less than or equal to the date-90 days "
^DIC(9.4,48,22,5.28,"PAH",582,1,282,0)="(or user entered date which is no sooner than -90 days). If the Parent "
^DIC(9.4,48,22,5.28,"PAH",582,1,283,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,284,0)="21) Jira #VSE-877: Update screens where buttons/fields/words are cut off."
^DIC(9.4,48,22,5.28,"PAH",582,1,285,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,286,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,287,0)="Content is cut off in GUI screens."
^DIC(9.4,48,22,5.28,"PAH",582,1,288,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,289,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,290,0)="Updated screens where content was cut off."
^DIC(9.4,48,22,5.28,"PAH",582,1,291,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,292,0)="22) Jira #VSE-884: Update GUI so that request already "
^DIC(9.4,48,22,5.28,"PAH",582,1,293,0)="dispositioned/canceled is not dispositioned again."
^DIC(9.4,48,22,5.28,"PAH",582,1,294,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,295,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,296,0)="Update GUI so that an MRTC request already dispositioned is not "
^DIC(9.4,48,22,5.28,"PAH",582,1,297,0)="dispositioned again when MRTCs are dispositioned in bulk."
^DIC(9.4,48,22,5.28,"PAH",582,1,298,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,299,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,300,0)="GUI was updated so that an already dispositioned MRTC request is not "
^DIC(9.4,48,22,5.28,"PAH",582,1,301,0)="dispositioned again."
^DIC(9.4,48,22,5.28,"PAH",582,1,302,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,303,0)="23) Jira #VSE-886 - Formalize JSON Return Errors - SDEC RPCs."
^DIC(9.4,48,22,5.28,"PAH",582,1,304,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,305,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,306,0)="There needs to be a unified way to log errors and return JSON "
^DIC(9.4,48,22,5.28,"PAH",582,1,307,0)="formatted data objects to the VS GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,308,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,309,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,310,0)="Two new Application Program Interfaces (APIs) were created in VistA. One"
^DIC(9.4,48,22,5.28,"PAH",582,1,311,0)="if for logging errors and the other for reporting back data. The Error API"
^DIC(9.4,48,22,5.28,"PAH",582,1,312,0)="standardized the text for the return messages and also allows additional"
^DIC(9.4,48,22,5.28,"PAH",582,1,313,0)="information to be added to the standard messages if needed. The Data API"
^DIC(9.4,48,22,5.28,"PAH",582,1,314,0)="will always return and object, even if there were no corresponding records"
^DIC(9.4,48,22,5.28,"PAH",582,1,315,0)="found."
^DIC(9.4,48,22,5.28,"PAH",582,1,316,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,317,0)="24) Jira #VSE-942: Fix null reference error when using Hotkeys for "
^DIC(9.4,48,22,5.28,"PAH",582,1,318,0)="switching Calendar's View style."
^DIC(9.4,48,22,5.28,"PAH",582,1,319,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,320,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,321,0)="The GUI occasionally crashes when trying to update the calendar after a "
^DIC(9.4,48,22,5.28,"PAH",582,1,322,0)="user enters shift + either D, W, M or T. These correspond to the hotkeys "
^DIC(9.4,48,22,5.28,"PAH",582,1,323,0)="used in the GUI for quickly switching the calendar between the Day, Week, "
^DIC(9.4,48,22,5.28,"PAH",582,1,324,0)="Month and Timeline views. "
^DIC(9.4,48,22,5.28,"PAH",582,1,325,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,326,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,327,0)="Added null check to the HotKeyEvents method to avoid null reference "
^DIC(9.4,48,22,5.28,"PAH",582,1,328,0)="exception."
^DIC(9.4,48,22,5.28,"PAH",582,1,329,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,330,0)="25) Jira #VSE-946: Formalize JSON Return Errors."
^DIC(9.4,48,22,5.28,"PAH",582,1,331,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,332,0)="Problem: Fix JSON returns created over last several sprints to follow new "
^DIC(9.4,48,22,5.28,"PAH",582,1,333,0)="JSON return pattern."
^DIC(9.4,48,22,5.28,"PAH",582,1,334,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,335,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,336,0)="Updated error messages for JSON RPC calls to use new VSE error window."
^DIC(9.4,48,22,5.28,"PAH",582,1,337,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,338,0)="26) Jira #VSE-1016 - Add CHECK-IN STEP STATUS field to 409.84."
^DIC(9.4,48,22,5.28,"PAH",582,1,339,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,340,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,341,0)="To support CTO's work on VSIP, we need to add a check-in step status "
^DIC(9.4,48,22,5.28,"PAH",582,1,342,0)="field to the appointment file."
^DIC(9.4,48,22,5.28,"PAH",582,1,343,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,344,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,345,0)="The new CHECK-IN STEP STATUS (#3) multiple was added to the SDEC "
^DIC(9.4,48,22,5.28,"PAH",582,1,346,0)="APPOINTMENT (#409.84) file. This multiple has 2 fields: CHECK-IN STEP "
^DIC(9.4,48,22,5.28,"PAH",582,1,347,0)="STATUS (#.01) and DATE/TIME ENTERED (#1)."
^DIC(9.4,48,22,5.28,"PAH",582,1,348,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,349,0)="27) Jira #VSE-1017 - Create SDES RPC to set value CS(IEN, value)."
^DIC(9.4,48,22,5.28,"PAH",582,1,350,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,351,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,352,0)="Create a SDES RPC to set the check-in step status in the newly created "
^DIC(9.4,48,22,5.28,"PAH",582,1,353,0)="check-in step status file (VSE-1016) by SDEC APPOINTMENT file IEN. Ensure "
^DIC(9.4,48,22,5.28,"PAH",582,1,354,0)="this can only be done for non-cancelled appointments."
^DIC(9.4,48,22,5.28,"PAH",582,1,355,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,356,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,357,0)="The new SDES EDIT CHECK-IN ENTRY RPC was created and will return it data "
^DIC(9.4,48,22,5.28,"PAH",582,1,358,0)="in JSON format."
^DIC(9.4,48,22,5.28,"PAH",582,1,359,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,360,0)="28) Jira #VSE-1020 - Create SDES RPC to get value CS(IEN)."
^DIC(9.4,48,22,5.28,"PAH",582,1,361,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,362,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,363,0)="Create a SDES RPC to get the check-in step status in the newly created "
^DIC(9.4,48,22,5.28,"PAH",582,1,364,0)="check-in step status multiple (VSE-1016) by SDEC APPOINTMENT file IEN and "
^DIC(9.4,48,22,5.28,"PAH",582,1,365,0)="the check-in step status IEN. Return JSON of the check-in step status "
^DIC(9.4,48,22,5.28,"PAH",582,1,366,0)="entry and date/time entry. If it doesn't exist in that multiple, return "
^DIC(9.4,48,22,5.28,"PAH",582,1,367,0)="null/0."
^DIC(9.4,48,22,5.28,"PAH",582,1,368,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,369,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,370,0)="The new SDES GET CHECK-IN STATUS RPC was created and will return it data "
^DIC(9.4,48,22,5.28,"PAH",582,1,371,0)="in JSON format."
^DIC(9.4,48,22,5.28,"PAH",582,1,372,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,373,0)="29) Jira #VSE-1022 - Create new pre-checkin status file."
^DIC(9.4,48,22,5.28,"PAH",582,1,374,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,375,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,376,0)="Create new check-in step status file with a field to track the check in "
^DIC(9.4,48,22,5.28,"PAH",582,1,377,0)="statuses."
^DIC(9.4,48,22,5.28,"PAH",582,1,378,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,379,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,380,0)="The new SDEC CHECK-IN STEP STATUS (#409.842) file was created to store "
^DIC(9.4,48,22,5.28,"PAH",582,1,381,0)="the necessary statuses related to checkins."
^DIC(9.4,48,22,5.28,"PAH",582,1,382,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,383,0)="30) Jira #VSE-1128 - Update RPC SDES Get Appointment List By Patient."
^DIC(9.4,48,22,5.28,"PAH",582,1,384,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,385,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,386,0)="Additional pieces of data need to be returned to assist processing in the "
^DIC(9.4,48,22,5.28,"PAH",582,1,387,0)="VS GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,388,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,389,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,390,0)="The needed data was identified in VistA and the SDES GET APPT LIST BY PAT "
^DIC(9.4,48,22,5.28,"PAH",582,1,391,0)="JSON was updated to include this data in the JSON object returned to VS"
^DIC(9.4,48,22,5.28,"PAH",582,1,392,0)="GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,393,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,394,0)="31) Jira #VSE-1129 - Update RPC SDES Get Appointment List By Clinic."
^DIC(9.4,48,22,5.28,"PAH",582,1,395,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,396,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,397,0)="Additional pieces of data need to be returned to assist processing in the "
^DIC(9.4,48,22,5.28,"PAH",582,1,398,0)="VS GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,399,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,400,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,401,0)="The needed data was identified in VistA and the SDES APPT BY CLINIC JSON "
^DIC(9.4,48,22,5.28,"PAH",582,1,402,0)="was updated to include this data in the JSON object returned to VS GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,403,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,404,0)="32) Jira #VSE-1130 - Update RPC SDES Get Appointment."
^DIC(9.4,48,22,5.28,"PAH",582,1,405,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,406,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,407,0)="Additional pieces of data need to be returned to assist processing in the "
^DIC(9.4,48,22,5.28,"PAH",582,1,408,0)="VS GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,409,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,410,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,411,0)="The needed data was identified in VistA and the SDES GET APPT JSON was"
^DIC(9.4,48,22,5.28,"PAH",582,1,412,0)="updated to include this data in the JSON object returned to VS GUI."
^DIC(9.4,48,22,5.28,"PAH",582,1,413,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,414,0)="33) Jira #VSE-1114 - Ad-hoc execution for Test Save Multiple User"
^DIC(9.4,48,22,5.28,"PAH",582,1,415,0)="Preference Configurations."
^DIC(9.4,48,22,5.28,"PAH",582,1,416,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,417,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,418,0)="Create RPC to get all check-in statuses for an appt in the check-in step"
^DIC(9.4,48,22,5.28,"PAH",582,1,419,0)="status multiple."
^DIC(9.4,48,22,5.28,"PAH",582,1,420,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,421,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,422,0)="A new RPC, SDES GET CHECK-IN STATUSES, has been created to retrieve all"
^DIC(9.4,48,22,5.28,"PAH",582,1,423,0)="check-in statuses associated with an appointment."
^DIC(9.4,48,22,5.28,"PAH",582,1,424,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,425,0)="34) Jira #VSE-1115 - Ad-hoc execution for Test Updates/corrections to "
^DIC(9.4,48,22,5.28,"PAH",582,1,426,0)="PtCSch code."
^DIC(9.4,48,22,5.28,"PAH",582,1,427,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,428,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,429,0)="Create RPC to add a new entry to the new check-in step status file"
^DIC(9.4,48,22,5.28,"PAH",582,1,430,0)="(409.842)."
^DIC(9.4,48,22,5.28,"PAH",582,1,431,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,432,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,433,0)="A new RPC, SDES CREATE CHECK-IN ENTRY, has been created to add a new"
^DIC(9.4,48,22,5.28,"PAH",582,1,434,0)="entry(status) to the new check-in step status file."
^DIC(9.4,48,22,5.28,"PAH",582,1,435,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,436,0)="35) Jira #VSE-1116 - Add CHECK-IN STEP STATUS field to 409.84."
^DIC(9.4,48,22,5.28,"PAH",582,1,437,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,438,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,439,0)="Create RPC to edit entry in 409.842 (check-in step status file)."
^DIC(9.4,48,22,5.28,"PAH",582,1,440,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,441,0)="Resolution: "
^DIC(9.4,48,22,5.28,"PAH",582,1,442,0)="A new RPC, SDES EDIT CHECK-IN ENTRY, has been created to edit"
^DIC(9.4,48,22,5.28,"PAH",582,1,443,0)="entries(statuses) in the new check-in step status file."
^DIC(9.4,48,22,5.28,"PAH",582,1,444,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,445,0)="36) Jira #VSE-1117 - Create SDES RPC to set value CS(IEN, value)."
^DIC(9.4,48,22,5.28,"PAH",582,1,446,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,447,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,448,0)="Create RPC to get all check-in entries in the check-in step status file."
^DIC(9.4,48,22,5.28,"PAH",582,1,449,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,450,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,451,0)="A new RPC, SDES GET ALL CHECK-IN ENTRIES, has been created to retrieve"
^DIC(9.4,48,22,5.28,"PAH",582,1,452,0)="all the entries from the new check-in step status file."
^DIC(9.4,48,22,5.28,"PAH",582,1,453,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,454,0)="37) Jira #VSE-1118 - Update ""Print the Patient Letter."" message to new "
^DIC(9.4,48,22,5.28,"PAH",582,1,455,0)="format."
^DIC(9.4,48,22,5.28,"PAH",582,1,456,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,457,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",582,1,458,0)="Create RPC to get a single entry from the check-in step status file"
^DIC(9.4,48,22,5.28,"PAH",582,1,459,0)="(409.842)."
^DIC(9.4,48,22,5.28,"PAH",582,1,460,0)=" "
^DIC(9.4,48,22,5.28,"PAH",582,1,461,0)="Resolution:"
^DIC(9.4,48,22,5.28,"PAH",582,1,462,0)="A new RPC, SDES GET CHECK-IN ENTRY, has been created to retrieve a single"
^DIC(9.4,48,22,5.28,"PAH",582,1,463,0)="entry from the new check-in step status file."
^DIC(9.4,48,22,5.28,"PAH",583,0)="775b^3210812"
^DIC(9.4,48,22,5.28,"PAH",583,1,0)="^^5^5^3210812"
^DIC(9.4,48,22,5.28,"PAH",583,1,1,0)="Backup of SD*5.3*775 on Aug 12, 2021"
^DIC(9.4,48,22,5.28,"PAH",583,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",583,1,3,0)="Warning:  Installing this backup patch message will install older versions"
