^DIC(9.4,11,22,5.03,"PAH",45,1,103,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,104,0)="New Service Requests (NSRs):"
^DIC(9.4,11,22,5.03,"PAH",45,1,105,0)="=============================="
^DIC(9.4,11,22,5.03,"PAH",45,1,106,0)="NSR# 20131009: Employ laboratory autoverification in the Veterans Health "
^DIC(9.4,11,22,5.03,"PAH",45,1,107,0)="Administration. "
^DIC(9.4,11,22,5.03,"PAH",45,1,108,0)=" "
^DIC(9.4,11,22,5.03,"PAH",45,1,109,0)="Test Sites:"
^DIC(9.4,11,22,5.03,"PAH",45,1,110,0)="==========="
