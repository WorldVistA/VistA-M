^DIC(9.4,163,22,1,"PAH",199,1,0)="^^2^2^3061122"
^DIC(9.4,163,22,1,"PAH",199,1,1,0)="Report on and optionally fix mismatched ID notes. Report on parent notes "
^DIC(9.4,163,22,1,"PAH",199,1,2,0)="that may not be an id note."
^DIC(9.4,163,22,1,"PAH",200,0)="217 SEQ #204^3061122.234714^1"
^DIC(9.4,163,22,1,"PAH",200,1,0)="^^2^2^3061122"
^DIC(9.4,163,22,1,"PAH",200,1,1,0)="Change TIU AUTHORIZATION RPC to not allow deletion of a Parent ID note if "
^DIC(9.4,163,22,1,"PAH",200,1,2,0)="it has a Child."
^DIC(9.4,163,22,1,"PAH",201,0)="211^3061211.162605^1"
^DIC(9.4,163,22,1,"PAH",201,1,0)="^^2^2^3061211"
^DIC(9.4,163,22,1,"PAH",201,1,1,0)="The description of this patch may be found in the National Patch Module"
^DIC(9.4,163,22,1,"PAH",201,1,2,0)="under TIU*1*211."
^DIC(9.4,163,22,1,"PAH",202,0)="220^3061227.144555^1"
^DIC(9.4,163,22,1,"PAH",202,1,0)="^^1^1^3061227"
^DIC(9.4,163,22,1,"PAH",202,1,1,0)="See patch description in the National Patch Module."
^DIC(9.4,163,22,1,"PAH",203,0)="210 SEQ #207^3061227.144729^1"
^DIC(9.4,163,22,1,"PAH",203,1,0)="^^7^7^3061227"
^DIC(9.4,163,22,1,"PAH",203,1,1,0)="This patch will add a parameter to the TIU PARAMETERS file (8925.99) "
^DIC(9.4,163,22,1,"PAH",203,1,2,0)="called LENGTH OF SIGNER ALERT PERIOD. This parameter will be used to "
^DIC(9.4,163,22,1,"PAH",203,1,3,0)="determine how far back the TIU NIGHTLY TASK should search when looking "
^DIC(9.4,163,22,1,"PAH",203,1,4,0)="for documents needing a signature. Input transforms for fields START OF "
^DIC(9.4,163,22,1,"PAH",203,1,5,0)="ADD SGNR ALERT PERIOD and END OF ADD SGNR ALERT PERIOD in file 8925.99 "
^DIC(9.4,163,22,1,"PAH",203,1,6,0)="were not working properly and were corrected. It also correctS an "
^DIC(9.4,163,22,1,"PAH",203,1,7,0)="undefined error in routine TIUSRVPT."
^DIC(9.4,163,22,1,"PAH",204,0)="190 SEQ #208^3061228.073734^1"
^DIC(9.4,163,22,1,"PAH",205,0)="223 SEQ #209^3070629.210829^1"
^DIC(9.4,163,22,1,"PAH",205,1,0)="^^2^2^3070629"
^DIC(9.4,163,22,1,"PAH",205,1,1,0)="The description of this patch may be found in the National Patch Module "
