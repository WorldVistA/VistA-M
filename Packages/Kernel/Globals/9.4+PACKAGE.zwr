^DIC(9.4,14,22,5.9,"PAH",42,1,332,0)=" LRPEND     LRPEND+10           """""
^DIC(9.4,14,22,5.9,"PAH",42,1,333,0)="            LRPEND+37           """""
^DIC(9.4,14,22,5.9,"PAH",42,1,334,0)=" LRQC       LRQC+3              Changed to display 4-digit year date."
^DIC(9.4,14,22,5.9,"PAH",42,1,335,0)=" LRRP5      DATE+3              Changed to display 4 digit year date."
^DIC(9.4,14,22,5.9,"PAH",42,1,336,0)="            INIT+2              """""
^DIC(9.4,14,22,5.9,"PAH",42,1,337,0)=" LRRP6      LRRP6+38            dd/mm/yyyy"
^DIC(9.4,14,22,5.9,"PAH",42,1,338,0)="            LRRP6+42"
^DIC(9.4,14,22,5.9,"PAH",42,1,339,0)=" LRRP6A1    LRRP6A1+15          dd/mm/yyyy"
^DIC(9.4,14,22,5.9,"PAH",42,1,340,0)=" LRRP6B1    LRRP6B1+12          dd/mm/yyyy"
^DIC(9.4,14,22,5.9,"PAH",42,1,341,0)=" LRSMAC     LRSMAC+39           Replaced call to LRAFUNC1 date/time "
^DIC(9.4,14,22,5.9,"PAH",42,1,342,0)="                                function to Kernel date/time calls."
^DIC(9.4,14,22,5.9,"PAH",42,1,343,0)=" LROW2RP    DATE               Added an ""F"" to the %DT flags for 'date of"
^DIC(9.4,14,22,5.9,"PAH",42,1,344,0)="                               order prompt."
^DIC(9.4,14,22,5.9,"PAH",42,1,345,0)=" LRSORA2    PRTEST+5           Changed to display 4-digit year date."
^DIC(9.4,14,22,5.9,"PAH",42,1,346,0)=" LRSORC1A   PRINT+23           Formatting for the extra 2 century"
^DIC(9.4,14,22,5.9,"PAH",42,1,347,0)="                               characters."
^DIC(9.4,14,22,5.9,"PAH",42,1,348,0)="            PRNTST+9"
^DIC(9.4,14,22,5.9,"PAH",42,1,349,0)="            COM+8"
^DIC(9.4,14,22,5.9,"PAH",42,1,350,0)=" LRSORD1A   PRINT+23           Formatting for the extra 2 century"
^DIC(9.4,14,22,5.9,"PAH",42,1,351,0)="                               characters."
^DIC(9.4,14,22,5.9,"PAH",42,1,352,0)="            PRNTST+9"
^DIC(9.4,14,22,5.9,"PAH",42,1,353,0)="            COM+8"
^DIC(9.4,14,22,5.9,"PAH",42,1,354,0)=" LRSTOPC                       OBSOLETE ROUTINE - deleted"
^DIC(9.4,14,22,5.9,"PAH",42,1,355,0)=" LRTOCOST   LRTOCOST+5         Replaced call to LRAFUNC1 date/time"
^DIC(9.4,14,22,5.9,"PAH",42,1,356,0)="                               function to"
^DIC(9.4,14,22,5.9,"PAH",42,1,357,0)="            LRTOCOST+7         Kernel date/time calls."
^DIC(9.4,14,22,5.9,"PAH",42,1,358,0)="            LRTOCOST+8         """""
^DIC(9.4,14,22,5.9,"PAH",42,1,359,0)="            LRTOCOST+56        """""
^DIC(9.4,14,22,5.9,"PAH",42,1,360,0)="            LRTOCOST+74        """""
^DIC(9.4,14,22,5.9,"PAH",42,1,361,0)=" LRTSTSET   LRTSTSET+25        """""
^DIC(9.4,14,22,5.9,"PAH",42,1,362,0)=" LRTT5      LRTT5+38           """""
^DIC(9.4,14,22,5.9,"PAH",42,1,363,0)="            LRTT5+54           """""
^DIC(9.4,14,22,5.9,"PAH",42,1,364,0)=" LRTT5R1    LRTT5R1+27         """""
^DIC(9.4,14,22,5.9,"PAH",42,1,365,0)=" LRU        T                  Added description of functionality to line"
^DIC(9.4,14,22,5.9,"PAH",42,1,366,0)="                               tag."
^DIC(9.4,14,22,5.9,"PAH",42,1,367,0)="            A                  Added description of functionality to line"
^DIC(9.4,14,22,5.9,"PAH",42,1,368,0)="                               tag, expand to 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,369,0)="            D                  Added description of functionality to line"
^DIC(9.4,14,22,5.9,"PAH",42,1,370,0)="                               tag, expand to 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,371,0)="            DA                 Added description of functionality to line"
^DIC(9.4,14,22,5.9,"PAH",42,1,372,0)="                               tag, expand to 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,373,0)="            DT                 Checks if LRSS=""BB"". If not, expands to 4"
^DIC(9.4,14,22,5.9,"PAH",42,1,374,0)="                               digit year.  Selected Blood Bank internal"
^DIC(9.4,14,22,5.9,"PAH",42,1,375,0)="                               displays are not modified due to current"
^DIC(9.4,14,22,5.9,"PAH",42,1,376,0)="                               FDA constraints."
^DIC(9.4,14,22,5.9,"PAH",42,1,377,0)="            V+3                Kill new variables."
^DIC(9.4,14,22,5.9,"PAH",42,1,378,0)=" LRUA       LRUA+3             Change call to D^LRU to newly created line"
^DIC(9.4,14,22,5.9,"PAH",42,1,379,0)="                               tag DATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,380,0)="            LRUA+8             Change call to D^LRU to newly created line"
^DIC(9.4,14,22,5.9,"PAH",42,1,381,0)="                               tag DATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,382,0)="            DATE               New line tag, returns date/time in 4 digit"
^DIC(9.4,14,22,5.9,"PAH",42,1,383,0)="                               year format."
^DIC(9.4,14,22,5.9,"PAH",42,1,384,0)=" LRUDEL     D                  Change call to D^LRU to newly created line"
^DIC(9.4,14,22,5.9,"PAH",42,1,385,0)="                               tag DATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,386,0)="            REST+5             Change call to D^LRU to newly created line"
^DIC(9.4,14,22,5.9,"PAH",42,1,387,0)="                               tag DATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,388,0)="            REST+6             Change call to D^LRU to newly created line"
^DIC(9.4,14,22,5.9,"PAH",42,1,389,0)="                               tag DATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,390,0)="            DATE               New line tag, returns date in eye-readable"
^DIC(9.4,14,22,5.9,"PAH",42,1,391,0)="                               month format w/ 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,392,0)=" LRUER      P                  Rename variable T to LRDATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,393,0)="            P+2                Rename variable T to LRDATE, format output"
^DIC(9.4,14,22,5.9,"PAH",42,1,394,0)="                               to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,395,0)="            H+1                Format output to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,396,0)="            H1                 Rename variable T to LRDATE, format output"
^DIC(9.4,14,22,5.9,"PAH",42,1,397,0)="                               to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,398,0)=" LRUMD      W+1                Rename variable T(1) to LRDATE, expand to 4"
^DIC(9.4,14,22,5.9,"PAH",42,1,399,0)="                               digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,400,0)="            W+3                Rename variable T(1) to LRDATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,401,0)=" LRUMDM     W+3                Rename variable from T(1) to LRDATE, expand"
^DIC(9.4,14,22,5.9,"PAH",42,1,402,0)="                               to 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,403,0)="            W+5                Rename variable from T(1) to LRDATE, format"
^DIC(9.4,14,22,5.9,"PAH",42,1,404,0)="                               output to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,405,0)=" LRUMDP     W+1                Rename variable from T(1) to LRDATE, expand"
^DIC(9.4,14,22,5.9,"PAH",42,1,406,0)="                               to 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,407,0)="            W+2                Rename variable from T(1) to LRDATE."
^DIC(9.4,14,22,5.9,"PAH",42,1,408,0)=" LRUP       LRUP+3             Update the LRAFUNC1 to XLFDT call."
^DIC(9.4,14,22,5.9,"PAH",42,1,409,0)=" LRUPT      FIX+2              Rename variable from Y to LRDATE, expand to"
^DIC(9.4,14,22,5.9,"PAH",42,1,410,0)="                               4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,411,0)="            FIX+4              Rename variable from Y to LRDATE, format"
^DIC(9.4,14,22,5.9,"PAH",42,1,412,0)="                               output to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,413,0)="            A                  Rename variable from Y to LRDATE, format"
^DIC(9.4,14,22,5.9,"PAH",42,1,414,0)="                               output to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,415,0)="            LIST+3             Format output to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,416,0)="            MORE+1             Rename variable Y to LRDATE, format output"
^DIC(9.4,14,22,5.9,"PAH",42,1,417,0)="                               to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,418,0)="            HDR                Format output to accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,419,0)=" LRUTL      STF+7              Update the LRAFUNC1 to XLFDT call."
^DIC(9.4,14,22,5.9,"PAH",42,1,420,0)=" LRUTT      W+1                Expand to 4 digit year, format output to"
^DIC(9.4,14,22,5.9,"PAH",42,1,421,0)="                               accommodate 4 digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,422,0)=" LRVER1     LRVER1+19          Replaced call to LRAFUNC1 date/time"
^DIC(9.4,14,22,5.9,"PAH",42,1,423,0)="                               function to"
^DIC(9.4,14,22,5.9,"PAH",42,1,424,0)="                               Kernel date/time calls."
^DIC(9.4,14,22,5.9,"PAH",42,1,425,0)=" LRVER2     LRVER2+13          Display 4-digit date."
^DIC(9.4,14,22,5.9,"PAH",42,1,426,0)="            LRVER2+27          """""
^DIC(9.4,14,22,5.9,"PAH",42,1,427,0)=" LRVR2      LRVR2+13           Display 4-digit date."
^DIC(9.4,14,22,5.9,"PAH",42,1,428,0)="            LRVR2+25           """""
^DIC(9.4,14,22,5.9,"PAH",42,1,429,0)="            LRVR2+26           Changed to Kernel Date/time call"
^DIC(9.4,14,22,5.9,"PAH",42,1,430,0)=" LRWLST12   C3                 Changed $$CDHTFM^LRAFUNC1 to $$HTFM^XLFDT."
^DIC(9.4,14,22,5.9,"PAH",42,1,431,0)=" LRWRKIN1   X+16               Adjust column display to accommodate"
^DIC(9.4,14,22,5.9,"PAH",42,1,432,0)="                               displaying"
^DIC(9.4,14,22,5.9,"PAH",42,1,433,0)="            X+24               4-digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,434,0)=" LRWRKINC   HED+5              Adjust column header to accommodate"
^DIC(9.4,14,22,5.9,"PAH",42,1,435,0)="                               displaying"
^DIC(9.4,14,22,5.9,"PAH",42,1,436,0)="            HED+11             4-digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,437,0)=" LRWU4     LRWU4+2             Set Kernel variable DT using approved call"
^DIC(9.4,14,22,5.9,"PAH",42,1,438,0)="           LRWU4+3             $$DT^XLFDT."
^DIC(9.4,14,22,5.9,"PAH",42,1,439,0)="           AC2+2               Added ""P"" to %DT variable, assume past"
^DIC(9.4,14,22,5.9,"PAH",42,1,440,0)="                               dates."
^DIC(9.4,14,22,5.9,"PAH",42,1,441,0)="           AC4+2               Display accession date with 4-digit year."
^DIC(9.4,14,22,5.9,"PAH",42,1,442,0)=" LRX       DD                  Changed to display 4-digit year date."
^DIC(9.4,14,22,5.9,"PAH",42,1,443,0)="           DT+3                Used Kernel Date/Time call."
^DIC(9.4,14,22,5.9,"PAH",42,1,444,0)="           DDOLD               Provide backward compatible format for"
^DIC(9.4,14,22,5.9,"PAH",42,1,445,0)="                               labels."
^DIC(9.4,14,22,5.9,"PAH",42,1,446,0)="           DTOLD               Provide call to return 2 digit date."
^DIC(9.4,14,22,5.9,"PAH",42,1,447,0)="           Y2K                 Call to return dd/mm/yyyy Date/Time"
