^DIC(9.4,73,22,9,"PAH",15,1,13,0)=" ============"
^DIC(9.4,73,22,9,"PAH",15,1,14,0)="    BIG-1100-72033, COS-1000-42266, OKL-1199-70066"
^DIC(9.4,73,22,9,"PAH",15,1,15,0)="            Number of sites reported that Old messages of"
^DIC(9.4,73,22,9,"PAH",15,1,16,0)="    Postmaster baskets have been accumulating and not being"
^DIC(9.4,73,22,9,"PAH",15,1,17,0)="    deleted.  This patch would clean up these 3 server"
^DIC(9.4,73,22,9,"PAH",15,1,18,0)="    baskets (AFJXSERVER, AFJXNHDONE and AFJXNETP) and would"
^DIC(9.4,73,22,9,"PAH",15,1,19,0)="    only leave the 7 day most current messages."
^DIC(9.4,73,22,9,"PAH",15,1,20,0)=" "
