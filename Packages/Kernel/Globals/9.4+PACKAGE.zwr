^DIC(9.4,77,22,17,"PAH",220,1,60,0)="Mail Groups Associated:"
^DIC(9.4,77,22,17,"PAH",220,1,61,0)="-----------------------"
^DIC(9.4,77,22,17,"PAH",220,1,62,0)="None."
^DIC(9.4,77,22,17,"PAH",220,1,63,0)=" "
^DIC(9.4,77,22,17,"PAH",220,1,64,0)="Options Associated:"
^DIC(9.4,77,22,17,"PAH",220,1,65,0)="-------------------"
^DIC(9.4,77,22,17,"PAH",220,1,66,0)="None."
^DIC(9.4,77,22,17,"PAH",220,1,67,0)=" "
^DIC(9.4,77,22,17,"PAH",220,1,68,0)="Protocols Associated:"
^DIC(9.4,77,22,17,"PAH",220,1,69,0)="---------------------"
^DIC(9.4,77,22,17,"PAH",220,1,70,0)="PSJ LM FINISH"
^DIC(9.4,77,22,17,"PAH",220,1,71,0)="PSJ LM IV SELECT ORDER"
^DIC(9.4,77,22,17,"PAH",220,1,72,0)="PSJ LM IV NEW SELECT ORDER"
^DIC(9.4,77,22,17,"PAH",220,1,73,0)="PSJ LM NEW SELECT ORDER"
