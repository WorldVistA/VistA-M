^DIC(9.4,44,22,0)="^9.49I^3^2"
^DIC(9.4,44,22,2.6,0)="2.5^2921125^2960613"
^DIC(9.4,44,22,2.6,"PAH",0)="^9.4901^7^7"
^DIC(9.4,44,22,2.6,"PAH",1,0)="11 SEQ #11^2960923^1"
^DIC(9.4,44,22,2.6,"PAH",1,1,0)="^^40^40^2960923"
^DIC(9.4,44,22,2.6,"PAH",1,1,1,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,2,0)=" Enhancements: "
^DIC(9.4,44,22,2.6,"PAH",1,1,3,0)=" -------------"
^DIC(9.4,44,22,2.6,"PAH",1,1,4,0)=" The Consult/Request Tracking package will now support quick orders.  This"
^DIC(9.4,44,22,2.6,"PAH",1,1,5,0)=" patch will provide an option to modify existing Consult/Request Tracking"
^DIC(9.4,44,22,2.6,"PAH",1,1,6,0)=" protocols into quick orders. The new option exported is Setup"
^DIC(9.4,44,22,2.6,"PAH",1,1,7,0)=" Consult/Request Quick Order Protocols [GMRC QUICK ORDER SETUP] and this"
^DIC(9.4,44,22,2.6,"PAH",1,1,8,0)=" will be an item on the Consult/Request Management [GMRC MGR] menu."
^DIC(9.4,44,22,2.6,"PAH",1,1,9,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,10,0)=" With this functionality, sites will now have the ability to pre-define"
^DIC(9.4,44,22,2.6,"PAH",1,1,11,0)=" much of the dialog encountered during ordering. "
^DIC(9.4,44,22,2.6,"PAH",1,1,12,0)=" Sites may now: "
^DIC(9.4,44,22,2.6,"PAH",1,1,13,0)=" 1) Pre-define how service will be rendered (inpatient or outpatient)"
^DIC(9.4,44,22,2.6,"PAH",1,1,14,0)=" 2) Pre-define a reason for request (may be presented for editing or"
^DIC(9.4,44,22,2.6,"PAH",1,1,15,0)="    automatically entered)"
^DIC(9.4,44,22,2.6,"PAH",1,1,16,0)=" 3) Pre-define urgency of request"
^DIC(9.4,44,22,2.6,"PAH",1,1,17,0)=" 4) Pre-define place of consultation"
^DIC(9.4,44,22,2.6,"PAH",1,1,18,0)=" 5) Designate specific requests to bypass the ATTENTION: prompt"
^DIC(9.4,44,22,2.6,"PAH",1,1,19,0)=" 6) Designate certain requests as not requiring a PROVISIONAL DIAGNOSIS"
^DIC(9.4,44,22,2.6,"PAH",1,1,20,0)=" "
^DIC(9.4,44,22,2.6,"PAH",1,1,21,0)=" These enhancements will function only if an individual procedure or"
^DIC(9.4,44,22,2.6,"PAH",1,1,22,0)=" consult protocols is placed on an add orders screen. These protocols are"
^DIC(9.4,44,22,2.6,"PAH",1,1,23,0)=" in the namespace GMRCR or GMRCT.   These protocols can be created by"
^DIC(9.4,44,22,2.6,"PAH",1,1,24,0)=" using the Setup Consult/Request Protocols [GMRC SETUP PROTOCOLS] option."
^DIC(9.4,44,22,2.6,"PAH",1,1,25,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,26,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,27,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,28,0)=" The patch will also provide a new field in the REQUEST SERVICES(123.5)"
^DIC(9.4,44,22,2.6,"PAH",1,1,29,0)=" file called DAYS BEFORE PURGE (.06). This field control the number of"
^DIC(9.4,44,22,2.6,"PAH",1,1,30,0)=" days that a completed consult or procedure order for that service will"
^DIC(9.4,44,22,2.6,"PAH",1,1,31,0)=" remain in the ORDER (100) file before being purged. For those services"
^DIC(9.4,44,22,2.6,"PAH",1,1,32,0)=" not having an entry in the field, orders will be maintained for 180 days."
^DIC(9.4,44,22,2.6,"PAH",1,1,33,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,34,0)="  "
^DIC(9.4,44,22,2.6,"PAH",1,1,35,0)=" The GMRC SETUP REQUEST SERVICE input template on file 123.5 has been"
^DIC(9.4,44,22,2.6,"PAH",1,1,36,0)=" modified to include the new parameter for editing when setting up a new"
^DIC(9.4,44,22,2.6,"PAH",1,1,37,0)=" service."
^DIC(9.4,44,22,2.6,"PAH",1,1,38,0)=" "
^DIC(9.4,44,22,2.6,"PAH",1,1,39,0)=" This will now be seen when using the Setup Consult/Request Services [GMRC"
^DIC(9.4,44,22,2.6,"PAH",1,1,40,0)=" SETUP REQUEST SERVICES] option."
^DIC(9.4,44,22,2.6,"PAH",2,0)="12^2970312^1"
^DIC(9.4,44,22,2.6,"PAH",2,1,0)="^^2^2^2970312"
^DIC(9.4,44,22,2.6,"PAH",2,1,1,0)="The description of this build can be found under GMRC*2.5*12 of the National "
^DIC(9.4,44,22,2.6,"PAH",2,1,2,0)="Patch Module."
^DIC(9.4,44,22,2.6,"PAH",3,0)="13^2970708^1"
^DIC(9.4,44,22,2.6,"PAH",3,1,0)="^^2^2^2970708"
^DIC(9.4,44,22,2.6,"PAH",3,1,1,0)="The description of this build can be viewed under patch GRMC*2.5*13 in the "
^DIC(9.4,44,22,2.6,"PAH",3,1,2,0)="National Patch Module."
^DIC(9.4,44,22,2.6,"PAH",4,0)="14^2980120^1"
^DIC(9.4,44,22,2.6,"PAH",4,1,0)="^^12^12^2980120"
^DIC(9.4,44,22,2.6,"PAH",4,1,1,0)="This patch installs protocols and routines which will be used by patch"
^DIC(9.4,44,22,2.6,"PAH",4,1,2,0)="OR*2.5*49 to allow CPRS to order consults for the services defined in the"
^DIC(9.4,44,22,2.6,"PAH",4,1,3,0)="Consults/Request Tracking package."
^DIC(9.4,44,22,2.6,"PAH",4,1,4,0)=" "
^DIC(9.4,44,22,2.6,"PAH",4,1,5,0)="This patch includes the following Protocols:"
^DIC(9.4,44,22,2.6,"PAH",4,1,6,0)="   GMRC EVSEND OR"
^DIC(9.4,44,22,2.6,"PAH",4,1,7,0)="   GMRC ORDERABLE ITEM UPDATE"
^DIC(9.4,44,22,2.6,"PAH",4,1,8,0)="   GMRC RECEIVE"
^DIC(9.4,44,22,2.6,"PAH",4,1,9,0)=" "
^DIC(9.4,44,22,2.6,"PAH",4,1,10,0)="along with the routines:"
^DIC(9.4,44,22,2.6,"PAH",4,1,11,0)="   GMRCPOST"
^DIC(9.4,44,22,2.6,"PAH",4,1,12,0)="   GMRCPOS1"
^DIC(9.4,44,22,2.6,"PAH",5,0)="16 SEQ #15^2980220^1"
^DIC(9.4,44,22,2.6,"PAH",5,1,0)="^^2^2^2980220"
^DIC(9.4,44,22,2.6,"PAH",5,1,1,0)="You can view the description of this patch in the National Patch Module "
^DIC(9.4,44,22,2.6,"PAH",5,1,2,0)="under the description of patch GMRC*2.5*16."
^DIC(9.4,44,22,2.6,"PAH",6,0)="15 SEQ #16^2980616^1"
^DIC(9.4,44,22,2.6,"PAH",6,1,0)="^^2^2^2980616"
^DIC(9.4,44,22,2.6,"PAH",6,1,1,0)="You can view the description of this patch in the National Patch Module "
^DIC(9.4,44,22,2.6,"PAH",6,1,2,0)="under the description of patch GMRC*2.5*15."
^DIC(9.4,44,22,2.6,"PAH",7,0)="17^2980831^1"
^DIC(9.4,44,22,2.6,"PAH","B",12,2)=""
^DIC(9.4,44,22,2.6,"PAH","B",13,3)=""
^DIC(9.4,44,22,2.6,"PAH","B",14,4)=""
^DIC(9.4,44,22,2.6,"PAH","B",17,7)=""
^DIC(9.4,44,22,2.6,"PAH","B","11 SEQ #11",1)=""
^DIC(9.4,44,22,2.6,"PAH","B","15 SEQ #16",6)=""
^DIC(9.4,44,22,2.6,"PAH","B","16 SEQ #15",5)=""
^DIC(9.4,44,22,3,0)="3.0^3051119^2990416^1"
^DIC(9.4,44,22,3,1,0)="^9.54^1^1^3240517^"
^DIC(9.4,44,22,3,1,1,0)="Consult/Request Tracking and Resulting Package. Version 3.0."
^DIC(9.4,44,22,3,"PAH",0)="^9.4901^129^129"
^DIC(9.4,44,22,3,"PAH",1,0)="1^2990416^1"
^DIC(9.4,44,22,3,"PAH",1,1,0)="^^171^171^2990416"
^DIC(9.4,44,22,3,"PAH",1,1,1,0)="Consult/Request Tracking and Resulting Package. Version 3.0."
^DIC(9.4,44,22,3,"PAH",1,1,2,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,3,0)="This build represents the starting point for tracking NOIS for Version"
^DIC(9.4,44,22,3,"PAH",1,1,4,0)="3.0.  All of the routines that were distributed in the released 3.0"
^DIC(9.4,44,22,3,"PAH",1,1,5,0)="version of CONSULT/REQUEST TRACKING were inadvertantly distributed with"
^DIC(9.4,44,22,3,"PAH",1,1,6,0)=" ""3.0T9;CONSULT/REQUEST TRACKING"" in the second line, rather than"
^DIC(9.4,44,22,3,"PAH",1,1,7,0)=" ""3.0;CONSULT/REQUEST TRACKING"""
^DIC(9.4,44,22,3,"PAH",1,1,8,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,9,0)=" All of the routines are redistributed in this build with the following"
^DIC(9.4,44,22,3,"PAH",1,1,10,0)="version and patch information in the second line:"
^DIC(9.4,44,22,3,"PAH",1,1,11,0)=" ;;3.0;CONSULT/REQUEST TRACKING;**1**;"
^DIC(9.4,44,22,3,"PAH",1,1,12,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,13,0)="The following routines also have added changes which correct errors found"
^DIC(9.4,44,22,3,"PAH",1,1,14,0)="in the interim at test sites and reported on local NOIS, as opposed to the"
^DIC(9.4,44,22,3,"PAH",1,1,15,0)="National NOIS system.  The local test site NOIS's that have been resolved"
^DIC(9.4,44,22,3,"PAH",1,1,16,0)="in this build will not be made part of the National NOIS system.  Any"
^DIC(9.4,44,22,3,"PAH",1,1,17,0)="local NOIS that is not fixed in this build, will move to the National NOIS"
^DIC(9.4,44,22,3,"PAH",1,1,18,0)="system, and the National Patch Module management process."
^DIC(9.4,44,22,3,"PAH",1,1,19,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,20,0)="   GMRC513U - Used to error when the patients location was not defined in"
^DIC(9.4,44,22,3,"PAH",1,1,21,0)="              the order "
^DIC(9.4,44,22,3,"PAH",1,1,22,0)="   GMRCADC -  Corrects the loop for Selecting an item from an alert"
^DIC(9.4,44,22,3,"PAH",1,1,23,0)="   GMRCQCST - Fixes an STS+5^GMRCQCST error by initializing the counter."
^DIC(9.4,44,22,3,"PAH",1,1,24,0)="   GMRCSLDT - Fixes DOB display in header."
^DIC(9.4,44,22,3,"PAH",1,1,25,0)="   GMRCSLM1 - Changes the status displayed in List manager to 99 (No"
^DIC(9.4,44,22,3,"PAH",1,1,26,0)="              status) if its not defined in the consult record."
^DIC(9.4,44,22,3,"PAH",1,1,27,0)="   GMRCT -    Removed logic that was stopping notifications to be sent to"
^DIC(9.4,44,22,3,"PAH",1,1,28,0)="              the notification users, logic matches 2.5 now."
^DIC(9.4,44,22,3,"PAH",1,1,29,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,30,0)=" The following routines were changed to call one location for message"
^DIC(9.4,44,22,3,"PAH",1,1,31,0)=" handling which now displays the message, and asks the user to press"
^DIC(9.4,44,22,3,"PAH",1,1,32,0)=" return to continue.  This was in response to sites saying they could not"
^DIC(9.4,44,22,3,"PAH",1,1,33,0)=" see the message being returned because it scrolled off too fast."
^DIC(9.4,44,22,3,"PAH",1,1,34,0)="   GMRC101C"
^DIC(9.4,44,22,3,"PAH",1,1,35,0)="   GMRCA1"
^DIC(9.4,44,22,3,"PAH",1,1,36,0)="   GMRCADC"
^DIC(9.4,44,22,3,"PAH",1,1,37,0)="   GMRCAFRD"
^DIC(9.4,44,22,3,"PAH",1,1,38,0)="   GMRCAR"
^DIC(9.4,44,22,3,"PAH",1,1,39,0)="   GMRCASV"
^DIC(9.4,44,22,3,"PAH",1,1,40,0)="   GMRCEDT1"
^DIC(9.4,44,22,3,"PAH",1,1,41,0)="   GMRCEDT2"
^DIC(9.4,44,22,3,"PAH",1,1,42,0)="   GMRCMCP"
^DIC(9.4,44,22,3,"PAH",1,1,43,0)="   GMRCP513"
^DIC(9.4,44,22,3,"PAH",1,1,44,0)="   GMRCPR0"
^DIC(9.4,44,22,3,"PAH",1,1,45,0)="   GMRCR"
^DIC(9.4,44,22,3,"PAH",1,1,46,0)="   GMRCR06"
^DIC(9.4,44,22,3,"PAH",1,1,47,0)="   GMRCSLDT"
^DIC(9.4,44,22,3,"PAH",1,1,48,0)="   GMRCSLM"
^DIC(9.4,44,22,3,"PAH",1,1,49,0)="   GMRCSLM2"
^DIC(9.4,44,22,3,"PAH",1,1,50,0)="   GMRCSLM3"
^DIC(9.4,44,22,3,"PAH",1,1,51,0)="   GMRCSSP"
^DIC(9.4,44,22,3,"PAH",1,1,52,0)="   GMRCSTU"
^DIC(9.4,44,22,3,"PAH",1,1,53,0)="   GMRCTIU"
^DIC(9.4,44,22,3,"PAH",1,1,54,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,55,0)="The following routine added clean-up of variables:"
^DIC(9.4,44,22,3,"PAH",1,1,56,0)="   GMRCHL7"
^DIC(9.4,44,22,3,"PAH",1,1,57,0)="   GMRCHL7A"
^DIC(9.4,44,22,3,"PAH",1,1,58,0)="   GMRCMER"
^DIC(9.4,44,22,3,"PAH",1,1,59,0)="   GMRCP"
^DIC(9.4,44,22,3,"PAH",1,1,60,0)="   GMRCTIU"
^DIC(9.4,44,22,3,"PAH",1,1,61,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,62,0)="The following routine was deleted from site in error when V1 was"
^DIC(9.4,44,22,3,"PAH",1,1,63,0)="installed:"
^DIC(9.4,44,22,3,"PAH",1,1,64,0)="   GMRCA2"
^DIC(9.4,44,22,3,"PAH",1,1,65,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,66,0)="The following routine has the latest purge logic for removing the order"
^DIC(9.4,44,22,3,"PAH",1,1,67,0)="from CPRS, but leaves the consult in the Consult package:"
^DIC(9.4,44,22,3,"PAH",1,1,68,0)="   GMRCPURG"
^DIC(9.4,44,22,3,"PAH",1,1,69,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,70,0)="The following routine has changes to support the GUI Consults application:"
^DIC(9.4,44,22,3,"PAH",1,1,71,0)="   GMRCGUIA"
^DIC(9.4,44,22,3,"PAH",1,1,72,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,73,0)="This patch also contains one input template:"
^DIC(9.4,44,22,3,"PAH",1,1,74,0)="   GMRC SETUP REQUEST SERVICE for FILE #123.5 which had an extra field as"
^DIC(9.4,44,22,3,"PAH",1,1,75,0)="   its last prompt, which should not have been in the list."
^DIC(9.4,44,22,3,"PAH",1,1,76,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,77,0)=" "
^DIC(9.4,44,22,3,"PAH",1,1,78,0)=" ROUTINE SUMMARY:"
^DIC(9.4,44,22,3,"PAH",1,1,79,0)=" ================"
^DIC(9.4,44,22,3,"PAH",1,1,80,0)=" The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,44,22,3,"PAH",1,1,81,0)=" second line of each of these routine(s) will look like:"
