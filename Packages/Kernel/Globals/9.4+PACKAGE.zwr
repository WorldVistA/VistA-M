^DIC(9.4,5,22,13,"PAH",9,1,111,0)="XDR VERIFY ALL"
^DIC(9.4,5,22,13,"PAH",9,1,112,0)="XDR VIEW DUPLICATE RECORD"
^DIC(9.4,5,22,13,"PAH",9,1,113,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,114,0)="The menu option Duplicate Resolution System [XDR MAIN MENU] will appear as"
^DIC(9.4,5,22,13,"PAH",9,1,115,0)="a sub-menu on the Application Utilities menu [XTMENU]."
^DIC(9.4,5,22,13,"PAH",9,1,116,0)="The menu option Operations [XDR OPERATIONS MENU] will appear as a sub-menu"
^DIC(9.4,5,22,13,"PAH",9,1,117,0)="on the [XDR MAIN MENU]."
^DIC(9.4,5,22,13,"PAH",9,1,118,0)="The menu option Utilities [XDR UTILITIES MENU] will appear as a sub-menu"
^DIC(9.4,5,22,13,"PAH",9,1,119,0)="on the [XDR MAIN MENU]."
^DIC(9.4,5,22,13,"PAH",9,1,120,0)="The menu option Manager Utilities [XDR MANAGER UTILITIES] will appear as a"
^DIC(9.4,5,22,13,"PAH",9,1,121,0)="sub-menu on the [XDR MAIN MENU]."
^DIC(9.4,5,22,13,"PAH",9,1,122,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,123,0)="Post-init information:"
^DIC(9.4,5,22,13,"PAH",9,1,124,0)="================"
^DIC(9.4,5,22,13,"PAH",9,1,125,0)="This patch does not contain a post-init routine."
^DIC(9.4,5,22,13,"PAH",9,1,126,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,127,0)="NOIS Messages Covered:"
^DIC(9.4,5,22,13,"PAH",9,1,128,0)="===================="
^DIC(9.4,5,22,13,"PAH",9,1,129,0)="There are three NOIS calls, all with a Referred, Awaiting Patch status."
^DIC(9.4,5,22,13,"PAH",9,1,130,0)="These all have to do with sites wanting to merge patient records.  The"
^DIC(9.4,5,22,13,"PAH",9,1,131,0)="release of this patch will serve to close these calls.  The NOIS calls"
^DIC(9.4,5,22,13,"PAH",9,1,132,0)="are:"
^DIC(9.4,5,22,13,"PAH",9,1,133,0)="       CAS-0797-12438, duplicate pts and pt demo missing"
^DIC(9.4,5,22,13,"PAH",9,1,134,0)="       SPO-0298-51628, HOW TO MERGE DUPLICATE ENTRIES"
^DIC(9.4,5,22,13,"PAH",9,1,135,0)="       NYN-0398-11634, Site needs help with Duplicate Resolution"
^DIC(9.4,5,22,13,"PAH",9,1,136,0)=" "
