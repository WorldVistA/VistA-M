^DIC(9.4,13,22,9,"PAH",10,1,49,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,13,22,9,"PAH",10,1,50,0)="-------------------------------------------------- "
^DIC(9.4,13,22,9,"PAH",10,1,51,0)="Software is being released as a host file and documentation describing"
^DIC(9.4,13,22,9,"PAH",10,1,52,0)="the new functionality introduced by this patch is available."
^DIC(9.4,13,22,9,"PAH",10,1,53,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,54,0)="The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,13,22,9,"PAH",10,1,55,0)="This transmits the files from the first available server. Sites may "
^DIC(9.4,13,22,9,"PAH",10,1,56,0)="also elect to retrieve files directly from a specific server. "
^DIC(9.4,13,22,9,"PAH",10,1,57,0)="Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,13,22,9,"PAH",10,1,58,0)="Secure Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory "
^DIC(9.4,13,22,9,"PAH",10,1,59,0)="at the following OI Field Offices:"
^DIC(9.4,13,22,9,"PAH",10,1,60,0)="   "
^DIC(9.4,13,22,9,"PAH",10,1,61,0)="Hines:                  fo-hines.domain.ext    "
^DIC(9.4,13,22,9,"PAH",10,1,62,0)="Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,13,22,9,"PAH",10,1,63,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,64,0)="Software                  File Name                   SFTP Mode"
^DIC(9.4,13,22,9,"PAH",10,1,65,0)="----------------------------------------------------------------------"
^DIC(9.4,13,22,9,"PAH",10,1,66,0)="VPR*1*8 & DI*22.2*9       DI_222_9_VPR_1_8.KID        ASCII"
^DIC(9.4,13,22,9,"PAH",10,1,67,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,68,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,69,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,13,22,9,"PAH",10,1,70,0)="at: http://www.domain.ext/vdl/ "
^DIC(9.4,13,22,9,"PAH",10,1,71,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,72,0)="Title                          File Name                 SFTP Mode"
