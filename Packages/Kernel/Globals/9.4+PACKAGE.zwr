^DIC(9.4,52,22,28,"PAH",23,1,0)="^^6^6^2961108"
^DIC(9.4,52,22,28,"PAH",23,1,1,0)="A fixes to couple of nois messages and an E3R regarding print/display"
^DIC(9.4,52,22,28,"PAH",23,1,2,0)="of a P.O./R.R. scrolls off the screen, and Unobligated Amendment"
^DIC(9.4,52,22,28,"PAH",23,1,3,0)="prints to a Wrong Printer."
^DIC(9.4,52,22,28,"PAH",23,1,4,0)="And the last one also in Amendments Module regarding a '?' entered"
^DIC(9.4,52,22,28,"PAH",23,1,5,0)="in response to AUTHORITY prompt which displayed a couple of"
^DIC(9.4,52,22,28,"PAH",23,1,6,0)="conflicting help messages.                                                     "
^DIC(9.4,52,22,28,"PAH",24,0)="68^2961108^1"
^DIC(9.4,52,22,28,"PAH",24,1,0)="^^1^1^2961108"
^DIC(9.4,52,22,28,"PAH",24,1,1,0)="This is the new Request for Quotation module of IFCAP 5.0."
^DIC(9.4,52,22,28,"PAH",25,0)="90^2961123^1"
^DIC(9.4,52,22,28,"PAH",25,1,0)="^^1^1^2961123"
^DIC(9.4,52,22,28,"PAH",25,1,1,0)="Minor bugs in single routines."
^DIC(9.4,52,22,28,"PAH",26,0)="57^2961207^1"
