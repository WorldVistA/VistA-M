^DIC(9.4,163,22,1,"PAH",206,0)="216 SEQ #210^3070904.233923^1"
^DIC(9.4,163,22,1,"PAH",206,1,0)="^^1^1^3070904"
^DIC(9.4,163,22,1,"PAH",206,1,1,0)="Fix boilerplate ""TRY"" function and prompts in TIU REVIEW SCREEN MRT."
^DIC(9.4,163,22,1,"PAH",207,0)="215 SEQ #211^3070905.004706^1"
^DIC(9.4,163,22,1,"PAH",207,1,0)="^^10^10^3070905"
^DIC(9.4,163,22,1,"PAH",207,1,1,0)="When using Copy to create a new document, the print name from the "
^DIC(9.4,163,22,1,"PAH",207,1,2,0)="origingal document is the print name for the newly created document.  "
^DIC(9.4,163,22,1,"PAH",207,1,3,0)="Since the print name is what is displayed in CPRS this causes a problem."
^DIC(9.4,163,22,1,"PAH",207,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",207,1,5,0)=" "
^DIC(9.4,163,22,1,"PAH",207,1,6,0)="Prohibit Edit, Delete, Amend of TIU Surgery documents in TIU LM or CPRS."
^DIC(9.4,163,22,1,"PAH",207,1,7,0)="Change error message when trying to delete Interdisciplinary Parent Note "
^DIC(9.4,163,22,1,"PAH",207,1,8,0)="that has kids."
^DIC(9.4,163,22,1,"PAH",207,1,9,0)=" "
^DIC(9.4,163,22,1,"PAH",207,1,10,0)="Prohibit Edit or Send Back of uncosinged documents."
^DIC(9.4,163,22,1,"PAH",208,0)="205 SEQ #212^3070905.005442^1"
^DIC(9.4,163,22,1,"PAH",208,1,0)="^^1^1^3070905"
