^DIC(9.4,14,22,5.9,"PAH",50,0)="200 SEQ #148^2980725^1"
^DIC(9.4,14,22,5.9,"PAH",50,1,0)="^^3^3^2980725"
^DIC(9.4,14,22,5.9,"PAH",50,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",50,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",50,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",51,0)="192 SEQ #149^2980725^1"
^DIC(9.4,14,22,5.9,"PAH",51,1,0)="^^3^3^2980725"
^DIC(9.4,14,22,5.9,"PAH",51,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",51,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",51,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",52,0)="195 SEQ #150^2980831^1"
^DIC(9.4,14,22,5.9,"PAH",52,1,0)="^^3^3^2980831"
^DIC(9.4,14,22,5.9,"PAH",52,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",52,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",52,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",53,0)="188 SEQ #151^2980831^1"
^DIC(9.4,14,22,5.9,"PAH",53,1,0)="^^3^3^2980831"
^DIC(9.4,14,22,5.9,"PAH",53,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",53,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",53,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",54,0)="175 SEQ #152^2980831^1"
^DIC(9.4,14,22,5.9,"PAH",54,1,0)="^^4^4^2980831"
^DIC(9.4,14,22,5.9,"PAH",54,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",54,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",54,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",54,1,4,0)="Installation for all sites."
^DIC(9.4,14,22,5.9,"PAH",55,0)="161 SEQ #153^2980923^1"
^DIC(9.4,14,22,5.9,"PAH",55,1,0)="^^680^680^2980923"
^DIC(9.4,14,22,5.9,"PAH",55,1,1,0)=" This patch to the Laboratory package does not contain any changes to"
^DIC(9.4,14,22,5.9,"PAH",55,1,2,0)=" the VISTA BLOOD BANK Software as defined by VHA DIRECTIVE 97-033"
^DIC(9.4,14,22,5.9,"PAH",55,1,3,0)=" titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",55,1,4,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,5,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,6,0)=" This patch will address enhancements and fixes to Lab label printing."
^DIC(9.4,14,22,5.9,"PAH",55,1,7,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,8,0)="   1. The ability to designate label stock on a printer by printer basis"
^DIC(9.4,14,22,5.9,"PAH",55,1,9,0)="      is available. This is used for printing with the Intermec label"
^DIC(9.4,14,22,5.9,"PAH",55,1,10,0)="      printers. This patch supports 1x2, 15/16X3, and 10 part 2.4x4"
^DIC(9.4,14,22,5.9,"PAH",55,1,11,0)="      label stock."
^DIC(9.4,14,22,5.9,"PAH",55,1,12,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,13,0)="   2. Support exists for the following bar code symbologies:"
^DIC(9.4,14,22,5.9,"PAH",55,1,14,0)="        Code 39"
^DIC(9.4,14,22,5.9,"PAH",55,1,15,0)="        Code 39 with check digit"
^DIC(9.4,14,22,5.9,"PAH",55,1,16,0)="        Code 128 bar code"
^DIC(9.4,14,22,5.9,"PAH",55,1,17,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,18,0)="      The bar code symbology used can be designated on an accession area"
^DIC(9.4,14,22,5.9,"PAH",55,1,19,0)="      basis. See the BAR CODE PRINT field (#5) in the ACCESSION file (#68)."
^DIC(9.4,14,22,5.9,"PAH",55,1,20,0)="      The set of codes for this field has been expanded to allow designating"
^DIC(9.4,14,22,5.9,"PAH",55,1,21,0)="      a specific symbology. See item #23 below for the effect of this field"
^DIC(9.4,14,22,5.9,"PAH",55,1,22,0)="      when using the Intermec label printers."
^DIC(9.4,14,22,5.9,"PAH",55,1,23,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,24,0)="   3. Support exists for bar coding the short/long identifier on labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,25,0)="      The label software will now check the field TYPE OF ACCESSION NUMBER"
^DIC(9.4,14,22,5.9,"PAH",55,1,26,0)="      (#.092) to determine the identifier to bar code. If a short identifier"
^DIC(9.4,14,22,5.9,"PAH",55,1,27,0)="      (accession number) is selected it will be formatted as determined in"
^DIC(9.4,14,22,5.9,"PAH",55,1,28,0)="      item #4 below. If it is a long identifier the Laboratory Unique"
^DIC(9.4,14,22,5.9,"PAH",55,1,29,0)="      Identifier (UID) will be printed. Formats in the Intermec label routines"
^DIC(9.4,14,22,5.9,"PAH",55,1,30,0)="      have been adjusted to handle the increased length of the bar code"
^DIC(9.4,14,22,5.9,"PAH",55,1,31,0)="      printed."
^DIC(9.4,14,22,5.9,"PAH",55,1,32,0)="      NOIS PRO-1096-11923, MAN-0196-10924, BRK-0696-11519"
^DIC(9.4,14,22,5.9,"PAH",55,1,33,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,34,0)="   4. The ability to designate the length of a short identifier (accession"
^DIC(9.4,14,22,5.9,"PAH",55,1,35,0)="      number) when it is selected to be bar coded on an accession label is"
^DIC(9.4,14,22,5.9,"PAH",55,1,36,0)="      supported. When the accession number is less than the number specified,"
^DIC(9.4,14,22,5.9,"PAH",55,1,37,0)="      it will be padded with zeros. See the description for the BAR CODE PAD"
^DIC(9.4,14,22,5.9,"PAH",55,1,38,0)="      field (#5.1) in the ACCESSION file (#68) for additional information and"
^DIC(9.4,14,22,5.9,"PAH",55,1,39,0)="      examples."
^DIC(9.4,14,22,5.9,"PAH",55,1,40,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,41,0)="   5. Support for local label routines on a printer or accession area basis"
^DIC(9.4,14,22,5.9,"PAH",55,1,42,0)="      is available. To designate local label routines on a printer by printer"
^DIC(9.4,14,22,5.9,"PAH",55,1,43,0)="      basis see the section on POST-INSTALLATION INSTRUCTIONS item #1."
^DIC(9.4,14,22,5.9,"PAH",55,1,44,0)="      To designate local label routines on an accession area basis see the"
^DIC(9.4,14,22,5.9,"PAH",55,1,45,0)="      section on POST-INSTALLATION INSTRUCTIONS item #2 and complete the"
^DIC(9.4,14,22,5.9,"PAH",55,1,46,0)="      fields ALTERNATE LABEL ENTRY (#5.2) and ALTERNATE LABEL ROUTINE (#5.3)"
^DIC(9.4,14,22,5.9,"PAH",55,1,47,0)="      in the ACCESSION file (#68)."
^DIC(9.4,14,22,5.9,"PAH",55,1,48,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,49,0)="   6. The ability to print test urgencies on a label exists. Sites can"
^DIC(9.4,14,22,5.9,"PAH",55,1,50,0)="      designate on an individual urgency basis if the urgency is to print."
^DIC(9.4,14,22,5.9,"PAH",55,1,51,0)="      The urgency that is printed will be the highest urgency of all the"
^DIC(9.4,14,22,5.9,"PAH",55,1,52,0)="      tests on the accession. The highest urgency is determined as the"
^DIC(9.4,14,22,5.9,"PAH",55,1,53,0)="      urgency with the lowest internal entry number in the URGENCY file"
^DIC(9.4,14,22,5.9,"PAH",55,1,54,0)="      (#62.05). Sites can designate a 1-5 character abbreviation that will"
^DIC(9.4,14,22,5.9,"PAH",55,1,55,0)="      be printed as the urgency. See the section on POST-INSTALLATION"
^DIC(9.4,14,22,5.9,"PAH",55,1,56,0)="      INSTRUCTIONS item #3."
^DIC(9.4,14,22,5.9,"PAH",55,1,57,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,58,0)="   7. The Reprint accession label(s) option [LRLABXT] has been enhanced to"
^DIC(9.4,14,22,5.9,"PAH",55,1,59,0)="      allow printing selected accessions."
^DIC(9.4,14,22,5.9,"PAH",55,1,60,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,61,0)="   8. The Print future collection labels option [LRUFCL] has been enhanced"
^DIC(9.4,14,22,5.9,"PAH",55,1,62,0)="      to allow selection of a range of collection types. The collection type"
^DIC(9.4,14,22,5.9,"PAH",55,1,63,0)="      WARD COLLECT is now selectable. A user can select one or more types"
^DIC(9.4,14,22,5.9,"PAH",55,1,64,0)="      when printing future collection labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,65,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,66,0)="   9. Fixed the null subscript error in array variable LRBAR when the"
^DIC(9.4,14,22,5.9,"PAH",55,1,67,0)="      variable LRAA was undefined."
^DIC(9.4,14,22,5.9,"PAH",55,1,68,0)="      NOIS GRJ-0395-50211"
^DIC(9.4,14,22,5.9,"PAH",55,1,69,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,70,0)="  10. Fixed printing of information in the wrong fields on the Intermec 4100"
^DIC(9.4,14,22,5.9,"PAH",55,1,71,0)="      10-part labels. There was an extra carriage return being sent to the"
^DIC(9.4,14,22,5.9,"PAH",55,1,72,0)="      printer which was moving the accession and other information into the"
^DIC(9.4,14,22,5.9,"PAH",55,1,73,0)="      wrong fields."
^DIC(9.4,14,22,5.9,"PAH",55,1,74,0)="      NOIS BUF-0695-13329"
^DIC(9.4,14,22,5.9,"PAH",55,1,75,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,76,0)="  11. Fix an undefined variable error, usually LRAN, when printing test labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,77,0)="      All standard required lab variables will be defined when printing test"
^DIC(9.4,14,22,5.9,"PAH",55,1,78,0)="      labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,79,0)="      NOIS BAN-1097-11647, DAY-0497-42491, GRJ-0796-50216"
^DIC(9.4,14,22,5.9,"PAH",55,1,80,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,81,0)="  12. Fixed formatting the SSN on the 10-part label. There was an extra"
^DIC(9.4,14,22,5.9,"PAH",55,1,82,0)="      carriage return being sent to the printer which was moving the SSN"
^DIC(9.4,14,22,5.9,"PAH",55,1,83,0)="      into the next field."
^DIC(9.4,14,22,5.9,"PAH",55,1,84,0)="      NOIS BIG-0596-71566"
^DIC(9.4,14,22,5.9,"PAH",55,1,85,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,86,0)="  13. Fixed a problem in the Reprint accession label(s) option [LRLABXT]"
^DIC(9.4,14,22,5.9,"PAH",55,1,87,0)="      in which a user, after selecting the label device, would encounter"
^DIC(9.4,14,22,5.9,"PAH",55,1,88,0)="      a ""Device Unavailable"" message. This error was caused by the opening,"
^DIC(9.4,14,22,5.9,"PAH",55,1,89,0)="      closing, and reopening of the label device."
^DIC(9.4,14,22,5.9,"PAH",55,1,90,0)="      NOIS PRO-0196-10343"
^DIC(9.4,14,22,5.9,"PAH",55,1,91,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,92,0)="  14. Adjusted the label field positioning. Position of the field on label"
^DIC(9.4,14,22,5.9,"PAH",55,1,93,0)="      was near the edge which left little room for variation in label stock"
^DIC(9.4,14,22,5.9,"PAH",55,1,94,0)="      positioning."
^DIC(9.4,14,22,5.9,"PAH",55,1,95,0)="      NOIS GRJ-1095-52265"
^DIC(9.4,14,22,5.9,"PAH",55,1,96,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,97,0)="  15. When the list of tests are printed on accession labels the software"
^DIC(9.4,14,22,5.9,"PAH",55,1,98,0)="      attempts to print as many test abbreviations as will fit within the"
^DIC(9.4,14,22,5.9,"PAH",55,1,99,0)="      dimensions of the label. Some of the label formats, specifically the"
^DIC(9.4,14,22,5.9,"PAH",55,1,100,0)="      formats used on the Intermec printers, did not use all of the space."
^DIC(9.4,14,22,5.9,"PAH",55,1,101,0)="      This resulted in a shortened test list. The label software has been"
^DIC(9.4,14,22,5.9,"PAH",55,1,102,0)="      adjusted to use the full amount of space available for the test list."
^DIC(9.4,14,22,5.9,"PAH",55,1,103,0)="      This varies with the different label sizes and formats."
^DIC(9.4,14,22,5.9,"PAH",55,1,104,0)="      The list of tests will be formatted such that a "";"" separates each "
^DIC(9.4,14,22,5.9,"PAH",55,1,105,0)="      test abbreviation. If all of the accession tests can not print on the"
^DIC(9.4,14,22,5.9,"PAH",55,1,106,0)="      label due to lack of space then the list will be truncated. Truncation"
^DIC(9.4,14,22,5.9,"PAH",55,1,107,0)="      will be indicated by the characters ""..."" at the end of the label test"
^DIC(9.4,14,22,5.9,"PAH",55,1,108,0)="      list."
^DIC(9.4,14,22,5.9,"PAH",55,1,109,0)="      NOIS ASH-1095-33536, BAY-0796-30672, MRN-0296-41708, WBP-0795-22054"
^DIC(9.4,14,22,5.9,"PAH",55,1,110,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,111,0)="  16. Fixed the location not printing on 1x2 and 10 part labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,112,0)="      NOIS ASH-0795-30288, FHM-0396-50465, SHR-0696-70850"
^DIC(9.4,14,22,5.9,"PAH",55,1,113,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,114,0)="  17. Fixed an undefined error, variables LRAN and LRACC, when printing"
^DIC(9.4,14,22,5.9,"PAH",55,1,115,0)="      future collection labels."
^DIC(9.4,14,22,5.9,"PAH",55,1,116,0)="      NOIS MAN-0196-11087"
^DIC(9.4,14,22,5.9,"PAH",55,1,117,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,118,0)="  18. Changed the setting of variables LRBAR0/LRBAR1 to values returned by"
^DIC(9.4,14,22,5.9,"PAH",55,1,119,0)="      a supported call to KERNEL (PSET^%ZISP) for bar code on (IOBARON)/bar"
^DIC(9.4,14,22,5.9,"PAH",55,1,120,0)="      code off (IOBAROFF) characteristics."
^DIC(9.4,14,22,5.9,"PAH",55,1,121,0)="      NOIS SPO-0696-50319"
^DIC(9.4,14,22,5.9,"PAH",55,1,122,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,123,0)="  19. Provided the ability to designate label type and label routine on a"
^DIC(9.4,14,22,5.9,"PAH",55,1,124,0)="      printer by printer basis. See the section on the POST-INSTALLATION"
^DIC(9.4,14,22,5.9,"PAH",55,1,125,0)="      INSTRUCTIONS item #1."
^DIC(9.4,14,22,5.9,"PAH",55,1,126,0)="      NOIS AMA-0297-71215"
^DIC(9.4,14,22,5.9,"PAH",55,1,127,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,128,0)="  20. To conform to VistA Programming Standards and Conventions (SAC),"
^DIC(9.4,14,22,5.9,"PAH",55,1,129,0)="      The following changes have been made:"
^DIC(9.4,14,22,5.9,"PAH",55,1,130,0)="      "
^DIC(9.4,14,22,5.9,"PAH",55,1,131,0)="      a. W * was changed to W $C() in the label routines."
^DIC(9.4,14,22,5.9,"PAH",55,1,132,0)="         NOIS FNC-0697-31993"
^DIC(9.4,14,22,5.9,"PAH",55,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",55,1,134,0)="      b. Routine LRLABLD was changed to use an approved DBIA (#2469) when"
^DIC(9.4,14,22,5.9,"PAH",55,1,135,0)="         determining a user's default lab label printer. If a printer is"
^DIC(9.4,14,22,5.9,"PAH",55,1,136,0)="         associated with the user's home device by entering a printer in"
^DIC(9.4,14,22,5.9,"PAH",55,1,137,0)="         the LAB LABEL PRINTER field (#101) in the DEVICE (#3.5) file, then"
^DIC(9.4,14,22,5.9,"PAH",55,1,138,0)="         this printer becomes the default label printer instead of LABLABEL."
^DIC(9.4,14,22,5.9,"PAH",55,1,139,0)="         It had been using a direct global read of global %ZIS."
^DIC(9.4,14,22,5.9,"PAH",55,1,140,0)=""
^DIC(9.4,14,22,5.9,"PAH",55,1,141,0)="      c. Routine LRPHLIST was changed to use the supported DBIA #10091 call. "
^DIC(9.4,14,22,5.9,"PAH",55,1,142,0)="         If the user has no institution defined in the NEW PERSON (#200) file,"
^DIC(9.4,14,22,5.9,"PAH",55,1,143,0)="         this call is used to determine the user's default institution, "
^DIC(9.4,14,22,5.9,"PAH",55,1,144,0)="         It had been using a direct global read of global XMB."
^DIC(9.4,14,22,5.9,"PAH",55,1,145,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,146,0)="  21. The Print future collection labels option [LRUFCL] was not determining"
^DIC(9.4,14,22,5.9,"PAH",55,1,147,0)="      the collection sample correctly. The collection sample is now derived"
^DIC(9.4,14,22,5.9,"PAH",55,1,148,0)="      from the COLLECTION SAMPLE field (#3) in the SPECIMEN # multiple "
^DIC(9.4,14,22,5.9,"PAH",55,1,149,0)="      field (#1) of the LAB ORDER ENTRY file (#69)."
^DIC(9.4,14,22,5.9,"PAH",55,1,150,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,151,0)="  22. Lab routine selection:"
^DIC(9.4,14,22,5.9,"PAH",55,1,152,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,153,0)="      a. The label routine selection is backward compatible with previous"
^DIC(9.4,14,22,5.9,"PAH",55,1,154,0)="         logic. The software determines a label routine by the value of the"
^DIC(9.4,14,22,5.9,"PAH",55,1,155,0)="         LABEL TYPE field (#302) in the LABORATORY SITE file (#69.9)."
^DIC(9.4,14,22,5.9,"PAH",55,1,156,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,157,0)="      b. If a site defines label devices in the LABEL DEVICE multiple field"
^DIC(9.4,14,22,5.9,"PAH",55,1,158,0)="         (#360) of the LABORATORY SITE file (#69.9), the label routine will"
^DIC(9.4,14,22,5.9,"PAH",55,1,159,0)="         be determined as follows:"
^DIC(9.4,14,22,5.9,"PAH",55,1,160,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,161,0)="         If an accession area is not defined (test/future order labels) then"
^DIC(9.4,14,22,5.9,"PAH",55,1,162,0)="         the accession area designated by DEFAULT ACCESSION AREA field (#.06)"
^DIC(9.4,14,22,5.9,"PAH",55,1,163,0)="         within LABEL DEVICE multiple field (#360) of the LABORATORY SITE"
^DIC(9.4,14,22,5.9,"PAH",55,1,164,0)="         file (#69.9) for following selection logic is used."
^DIC(9.4,14,22,5.9,"PAH",55,1,165,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,166,0)="         If an alternate label routine for the accession area is designated"
^DIC(9.4,14,22,5.9,"PAH",55,1,167,0)="         then the label routine designated by fields ALTERNATE LABEL"
^DIC(9.4,14,22,5.9,"PAH",55,1,168,0)="         ENTRY (#5.2) and ALTERNATE LABEL ROUTINE (#5.3) of the"
^DIC(9.4,14,22,5.9,"PAH",55,1,169,0)="         ACCESSION file (#68) is used."
^DIC(9.4,14,22,5.9,"PAH",55,1,170,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,171,0)="         Otherwise if site has designated an alternate label routine for the"
^DIC(9.4,14,22,5.9,"PAH",55,1,172,0)="         device then the label routine designated by fields ALTERNATE LABEL"
^DIC(9.4,14,22,5.9,"PAH",55,1,173,0)="         ENTRY (#.04) and ALTERNATE LABEL ROUTINE (#.05) within LABEL DEVICE"
^DIC(9.4,14,22,5.9,"PAH",55,1,174,0)="         multiple field (#360) of the LABORATORY SITE file (#69.9) is used."
^DIC(9.4,14,22,5.9,"PAH",55,1,175,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,176,0)="         Otherwise if the printer is designated as an Intermec 4100 by the"
^DIC(9.4,14,22,5.9,"PAH",55,1,177,0)="         PRINTER TYPE field (#.02) of the LABEL DEVICE multiple field (#360)"
^DIC(9.4,14,22,5.9,"PAH",55,1,178,0)="         of the LABORATORY SITE file (#69.9), the label routine is determined"
^DIC(9.4,14,22,5.9,"PAH",55,1,179,0)="         by the LABEL STOCK field (#.03) of the LABEL DEVICE multiple field"
^DIC(9.4,14,22,5.9,"PAH",55,1,180,0)="         (#360) of LABORATORY SITE file (#69.9) as follows:"
^DIC(9.4,14,22,5.9,"PAH",55,1,181,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,182,0)="            1        15/16X3       --> routine LRLABELC"
^DIC(9.4,14,22,5.9,"PAH",55,1,183,0)="            2        1X2           --> routine LRLABELA"
^DIC(9.4,14,22,5.9,"PAH",55,1,184,0)="            3        2.5X4 10 PART --> routine LRLABELB"
^DIC(9.4,14,22,5.9,"PAH",55,1,185,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,186,0)="      c. If none of the conditions checked in b. above apply then the label"
^DIC(9.4,14,22,5.9,"PAH",55,1,187,0)="         routine designated in a. above is used."
^DIC(9.4,14,22,5.9,"PAH",55,1,188,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,189,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,190,0)="  23. Intermec 4100 label format assignments:"
^DIC(9.4,14,22,5.9,"PAH",55,1,191,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,192,0)="      F0     - Reserved by manufacturer"
^DIC(9.4,14,22,5.9,"PAH",55,1,193,0)="      F1     - Presently not used (Unavailable on 4100BA models)"
^DIC(9.4,14,22,5.9,"PAH",55,1,194,0)="      F2     - Presently not used (Unavailable on 4100BA models)"
^DIC(9.4,14,22,5.9,"PAH",55,1,195,0)="      F3     - 1x2 Plain Label (Old Style)"
^DIC(9.4,14,22,5.9,"PAH",55,1,196,0)="      F4     - 1x2 Code 39 Label (Old Style)"
^DIC(9.4,14,22,5.9,"PAH",55,1,197,0)="      F5     - 1x2 Code 39/128 - UID"
^DIC(9.4,14,22,5.9,"PAH",55,1,198,0)="      F6     - Presently not used"
^DIC(9.4,14,22,5.9,"PAH",55,1,199,0)="      F7     - 15/16x3 Plain Label (Old Style)"
^DIC(9.4,14,22,5.9,"PAH",55,1,200,0)="      F8     - 15/16x3 Code 39 (Old Style)"
^DIC(9.4,14,22,5.9,"PAH",55,1,201,0)="      F9     - 15/16x3 Code 39/128 - UID"
^DIC(9.4,14,22,5.9,"PAH",55,1,202,0)="      F10    - Presently not used"
^DIC(9.4,14,22,5.9,"PAH",55,1,203,0)="      F11    - Presently not used"
^DIC(9.4,14,22,5.9,"PAH",55,1,204,0)="      F12    - 10 Part Code 39 (Old Style)"
^DIC(9.4,14,22,5.9,"PAH",55,1,205,0)="      F13    - 10 Part Code 39/128 - UID"
^DIC(9.4,14,22,5.9,"PAH",55,1,206,0)="      F14    - Presently not used - Reserved for LEDI shipping labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,207,0)="      F15    - Presently not used - Reserved for LEDI shipping labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,208,0)="      F16    - Presently not used - Reserved for LEDI shipping labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,209,0)="      F17    - Presently not used - Reserved for LEDI shipping labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,210,0)="      F18    - Presently not used - Reserved for LEDI shipping labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,211,0)="      F19    - Presently not used - Reserved for LEDI shipping labels"
^DIC(9.4,14,22,5.9,"PAH",55,1,212,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,213,0)="      Note: Formats F4, F8, and F12 print the bar code with a check digit."
^DIC(9.4,14,22,5.9,"PAH",55,1,214,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,215,0)="  24. Intermec format selection:"
^DIC(9.4,14,22,5.9,"PAH",55,1,216,0)="      Note: This is based on the printer being designated as Intermec printer,"
^DIC(9.4,14,22,5.9,"PAH",55,1,217,0)="            that is when the PRINTER TYPE field (#.02) in the LABEL DEVICE"
^DIC(9.4,14,22,5.9,"PAH",55,1,218,0)="            multiple field (#360) of the LABORATORY SITE file (#69.9)"
^DIC(9.4,14,22,5.9,"PAH",55,1,219,0)="            equals 1 and the value of the BAR CODE PRINT field (#5) in the"
^DIC(9.4,14,22,5.9,"PAH",55,1,220,0)="            ACCESSION file (#68) is as listed in the below table:"
^DIC(9.4,14,22,5.9,"PAH",55,1,221,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,222,0)="                               Intermec 4100"
^DIC(9.4,14,22,5.9,"PAH",55,1,223,0)="                    1x2 label     15/16X3    10 part label"
^DIC(9.4,14,22,5.9,"PAH",55,1,224,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,225,0)="                0     F3            F7          F12"
^DIC(9.4,14,22,5.9,"PAH",55,1,226,0)="                1     F4            F8          F12"
^DIC(9.4,14,22,5.9,"PAH",55,1,227,0)="      BAR CODE  2     F5            F9          F13"
^DIC(9.4,14,22,5.9,"PAH",55,1,228,0)="      PRINT     3     F5            F9          F13"
^DIC(9.4,14,22,5.9,"PAH",55,1,229,0)="                4     F5            F9          F13"
^DIC(9.4,14,22,5.9,"PAH",55,1,230,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,231,0)="      BAR CODE PRINT set of code: 0 - NONE"
^DIC(9.4,14,22,5.9,"PAH",55,1,232,0)="                                  1 - YES (Code 39 with check digit)"
^DIC(9.4,14,22,5.9,"PAH",55,1,233,0)="                                  2 - Code39"
^DIC(9.4,14,22,5.9,"PAH",55,1,234,0)="                                  3 - Code39 with check digit"
^DIC(9.4,14,22,5.9,"PAH",55,1,235,0)="                                  4 - Code128"
^DIC(9.4,14,22,5.9,"PAH",55,1,236,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,237,0)="      NOTE: The site will need to program the Intermec 4100 printer for those"
^DIC(9.4,14,22,5.9,"PAH",55,1,238,0)="            formats which will be used based on label stock and bar code"
^DIC(9.4,14,22,5.9,"PAH",55,1,239,0)="            symbology selected."
^DIC(9.4,14,22,5.9,"PAH",55,1,240,0)="            Example: Site is using 1x2 labels and has specified BAR CODE"
^DIC(9.4,14,22,5.9,"PAH",55,1,241,0)="                     PRINT of 0,1, or 4 for various accession areas."
^DIC(9.4,14,22,5.9,"PAH",55,1,242,0)="                     The Intermec 4100 printer would need to be"
^DIC(9.4,14,22,5.9,"PAH",55,1,243,0)="                     downloaded with formats F3, F4, and F5."
^DIC(9.4,14,22,5.9,"PAH",55,1,244,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,245,0)="  "
^DIC(9.4,14,22,5.9,"PAH",55,1,246,0)=" Associated NOIS"
^DIC(9.4,14,22,5.9,"PAH",55,1,247,0)="  ---------------"
^DIC(9.4,14,22,5.9,"PAH",55,1,248,0)="  AMA-0297-71215"
^DIC(9.4,14,22,5.9,"PAH",55,1,249,0)="  ASH-0795-30288"
^DIC(9.4,14,22,5.9,"PAH",55,1,250,0)="  ASH-1095-33536"
^DIC(9.4,14,22,5.9,"PAH",55,1,251,0)="  BAN-1097-11647"
^DIC(9.4,14,22,5.9,"PAH",55,1,252,0)="  BAY-0796-30672"
^DIC(9.4,14,22,5.9,"PAH",55,1,253,0)="  BIG-0596-71566"
^DIC(9.4,14,22,5.9,"PAH",55,1,254,0)="  BRK-0696-11519"
^DIC(9.4,14,22,5.9,"PAH",55,1,255,0)="  BUF-0695-13329"
^DIC(9.4,14,22,5.9,"PAH",55,1,256,0)="  DAY-0497-42491"
^DIC(9.4,14,22,5.9,"PAH",55,1,257,0)="  FHM-0396-50465"
^DIC(9.4,14,22,5.9,"PAH",55,1,258,0)="  FNC-0697-31993"
^DIC(9.4,14,22,5.9,"PAH",55,1,259,0)="  GRJ-0395-50211"
^DIC(9.4,14,22,5.9,"PAH",55,1,260,0)="  GRJ-1095-52265"
^DIC(9.4,14,22,5.9,"PAH",55,1,261,0)="  GRJ-0796-50216"
^DIC(9.4,14,22,5.9,"PAH",55,1,262,0)="  MAN-0196-10924"
^DIC(9.4,14,22,5.9,"PAH",55,1,263,0)="  MAN-0196-11087"
^DIC(9.4,14,22,5.9,"PAH",55,1,264,0)="  MRN-0296-41708"
^DIC(9.4,14,22,5.9,"PAH",55,1,265,0)="  PRO-0196-10343"
^DIC(9.4,14,22,5.9,"PAH",55,1,266,0)="  PRO-1096-11923"
^DIC(9.4,14,22,5.9,"PAH",55,1,267,0)="  SHR-0696-70850"
