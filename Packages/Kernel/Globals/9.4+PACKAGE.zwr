^DIC(9.4,33,22,1.4,"PAH",45,1,73,0)="                                                       =="
^DIC(9.4,33,22,1.4,"PAH",45,1,74,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,33,22,1.4,"PAH",45,1,75,0)="                                                                       =="
^DIC(9.4,33,22,1.4,"PAH",45,1,76,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,33,22,1.4,"PAH",45,1,77,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,33,22,1.4,"PAH",45,1,78,0)=" Enter a '^' to abort the install."
^DIC(9.4,33,22,1.4,"PAH",45,1,79,0)=""
^DIC(9.4,33,22,1.4,"PAH",45,1,80,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,33,22,1.4,"PAH",45,1,81,0)="                ------------------"
^DIC(9.4,33,22,1.4,"PAH",45,1,82,0)="7. Startup all Logical Links and incoming and outgoing filers. Use the "
^DIC(9.4,33,22,1.4,"PAH",45,1,83,0)=" "
^DIC(9.4,33,22,1.4,"PAH",45,1,84,0)="     Filer and Link Management Options ->"
^DIC(9.4,33,22,1.4,"PAH",45,1,85,0)="         RA     Restart/Start All Links and Filers"
^DIC(9.4,33,22,1.4,"PAH",45,1,86,0)="   (Note: Links which do not have ""autostart"" enabled will need to"
^DIC(9.4,33,22,1.4,"PAH",45,1,87,0)="          be restarted manually)"
^DIC(9.4,33,22,1.4,"PAH",45,1,88,0)="   "
^DIC(9.4,33,22,1.4,"PAH",45,1,89,0)="8. DSM Sites: If you previously disabled an HL7 UCX Service for this"
