^DIC(9.4,175,22,2,"PAH",141,0)="211^3180803.162713^54"
^DIC(9.4,175,22,2,"PAH",141,1,0)="^^12^12^3180803"
^DIC(9.4,175,22,2,"PAH",141,1,1,0)="VistA Imaging Capture 211"
^DIC(9.4,175,22,2,"PAH",141,1,2,0)="This patch fixes 2 issues."
^DIC(9.4,175,22,2,"PAH",141,1,3,0)="First:  when trying to Batch Capture multiple images,"
^DIC(9.4,175,22,2,"PAH",141,1,4,0)="sometimes an error will occur when the application is processing"
^DIC(9.4,175,22,2,"PAH",141,1,5,0)="single page PDF files.  The PDF file will not be captured, and not"
^DIC(9.4,175,22,2,"PAH",141,1,6,0)="included in the Image Group."
^DIC(9.4,175,22,2,"PAH",141,1,7,0)="Second: When Closing the Capture application, sometimes an error"
^DIC(9.4,175,22,2,"PAH",141,1,8,0)="will occur, and the application will not close.  The user must"
^DIC(9.4,175,22,2,"PAH",141,1,9,0)="use Taskmanager to 'kill' the application."
^DIC(9.4,175,22,2,"PAH",141,1,10,0)="This error occurs when trying to remove all images from the "
^DIC(9.4,175,22,2,"PAH",141,1,11,0)="user's \temp folder when the user does not have permission to"
^DIC(9.4,175,22,2,"PAH",141,1,12,0)="delete from that folder."
^DIC(9.4,175,22,2,"PAH",142,0)="198^3180906.154713^54"
^DIC(9.4,175,22,2,"PAH",142,1,0)="^^10^10^3180906"
^DIC(9.4,175,22,2,"PAH",142,1,1,0)="VistA Imaging Patch 198 - BackGround Processor (BP)"
^DIC(9.4,175,22,2,"PAH",142,1,2,0)="This patch fixes the memory leak issue in the "
^DIC(9.4,175,22,2,"PAH",142,1,3,0)="Thumbnail/Abstract maker."
^DIC(9.4,175,22,2,"PAH",142,1,4,0)="Fixes an issue in the Verifier.  The Verifier"
^DIC(9.4,175,22,2,"PAH",142,1,5,0)="was not checking the Operational Staus of TIER 2 Locations"
^DIC(9.4,175,22,2,"PAH",142,1,6,0)="and was checking Off-Line Locations for Images."
^DIC(9.4,175,22,2,"PAH",142,1,7,0)="Also,  this Patch will be a Full Install of the Background"
^DIC(9.4,175,22,2,"PAH",142,1,8,0)="Processor and all utility applications.  "
^DIC(9.4,175,22,2,"PAH",142,1,9,0)="When Patch 198 KIDs is installed,  BP Client versions"
^DIC(9.4,175,22,2,"PAH",142,1,10,0)="135, 196, 198 will all be supported."
^DIC(9.4,175,22,2,"PAH",143,0)="199^3180906.15481^54"
^DIC(9.4,175,22,2,"PAH",143,1,0)="^^7^7^3180906"
^DIC(9.4,175,22,2,"PAH",143,1,1,0)="VistA Imaging V3.0 - Path 199 VistA RAD"
^DIC(9.4,175,22,2,"PAH",143,1,2,0)=" "
