^DIC(9.4,4,22,1,"PAH",59,1,54,0)="5.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",59,1,55,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",60,0)="92 SEQ #85^2991003^1"
^DIC(9.4,4,22,1,"PAH",60,1,0)="^^55^55^2991003"
^DIC(9.4,4,22,1,"PAH",60,1,1,0)="Patch XM*7.1*92"
^DIC(9.4,4,22,1,"PAH",60,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,3,0)="Test Site:  FORUM"
^DIC(9.4,4,22,1,"PAH",60,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,5,0)="This patch improves the display of the local message queue delivery status"
^DIC(9.4,4,22,1,"PAH",60,1,6,0)="provided by option XMMGR-CHECK-BACKGROUND-FILER."
^DIC(9.4,4,22,1,"PAH",60,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,8,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",60,1,9,0)="It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",60,1,10,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",60,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,12,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",60,1,13,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",60,1,14,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",60,1,15,0)=" "
^DIC(9.4,4,22,1,"PAH",60,1,16,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",60,1,17,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",60,1,18,0)="--------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",60,1,19,0)="XMUT5          5739686         4497129        50,92"
^DIC(9.4,4,22,1,"PAH",60,1,20,0)="XMUT5B         2644064         1096729        50,92"
^DIC(9.4,4,22,1,"PAH",60,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",60,1,23,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",60,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",60,1,25,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",60,1,26,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",60,1,27,0)="It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",60,1,28,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",60,1,29,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",60,1,30,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",60,1,31,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",60,1,32,0)="3.  You do not need to stop TaskMan or the background filers."
^DIC(9.4,4,22,1,"PAH",60,1,33,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",60,1,34,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",60,1,35,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",60,1,36,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",60,1,37,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",60,1,38,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",60,1,39,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",60,1,40,0)=" Select INSTALL NAME:    XM*7.1*92     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",60,1,41,0)="                         ========="
^DIC(9.4,4,22,1,"PAH",60,1,42,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",60,1,43,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",60,1,44,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",60,1,45,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",60,1,46,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",60,1,47,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",60,1,48,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",60,1,49,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",60,1,50,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,51,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",60,1,52,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",60,1,53,0)=""
^DIC(9.4,4,22,1,"PAH",60,1,54,0)="5.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",60,1,55,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",61,0)="93 SEQ #86^2991003^1"
^DIC(9.4,4,22,1,"PAH",61,1,0)="^^147^147^2991003"
^DIC(9.4,4,22,1,"PAH",61,1,1,0)="   *** It is VERY IMPORTANT that you READ the information in this PATCH. ***"
^DIC(9.4,4,22,1,"PAH",61,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,3,0)="Patch XM*7.1*93"
^DIC(9.4,4,22,1,"PAH",61,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,5,0)="NOIS:  KAN-0999-40493"
^DIC(9.4,4,22,1,"PAH",61,1,6,0)="Test Site:  Kansas City, MO"
^DIC(9.4,4,22,1,"PAH",61,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,8,0)="There seem to be some bogus cross references left over from previous"
^DIC(9.4,4,22,1,"PAH",61,1,9,0)="incarnations of MailMan."
^DIC(9.4,4,22,1,"PAH",61,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,11,0)="The only official whole-file cross references on the MESSAGE file are what"
^DIC(9.4,4,22,1,"PAH",61,1,12,0)="you see below. If you see others, they are either bogus or they are local"
^DIC(9.4,4,22,1,"PAH",61,1,13,0)="modifications.  This patch shows you and deletes the known bogus cross"
^DIC(9.4,4,22,1,"PAH",61,1,14,0)="references.  If you see other cross references, and are unsure whether they"
^DIC(9.4,4,22,1,"PAH",61,1,15,0)="are bogus or whether they are local modifications, please log a NOIS."
^DIC(9.4,4,22,1,"PAH",61,1,16,0)="Do not delete anything without consulting Customer Service."
^DIC(9.4,4,22,1,"PAH",61,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,18,0)="------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",61,1,19,0)="If your site is pre-patch XM*7.1*50, this is what you should see when you"
^DIC(9.4,4,22,1,"PAH",61,1,20,0)="do the following:"
^DIC(9.4,4,22,1,"PAH",61,1,21,0)=">D ^%G"
^DIC(9.4,4,22,1,"PAH",61,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,23,0)="Global ^DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,24,0)="        DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,25,0)="^DD(3.9,0,""IX"",""AI"",3.9,9) = "
^DIC(9.4,4,22,1,"PAH",61,1,26,0)="^DD(3.9,0,""IX"",""B"",3.9,.01) = "
^DIC(9.4,4,22,1,"PAH",61,1,27,0)="^DD(3.9,0,""IX"",""C"",3.9,1) =      <-- exists, but never used."
^DIC(9.4,4,22,1,"PAH",61,1,28,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,29,0)="Pre-patch XM*7.1*50, you should see no xrefs after the ""B"" xref:"
^DIC(9.4,4,22,1,"PAH",61,1,30,0)=">D ^%G"
^DIC(9.4,4,22,1,"PAH",61,1,31,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,32,0)="Global ^XMB(3.9,""C"":"
^DIC(9.4,4,22,1,"PAH",61,1,33,0)="        XMB(3.9,""C"":"
^DIC(9.4,4,22,1,"PAH",61,1,34,0)="Global ^                         <-- nothing!"
^DIC(9.4,4,22,1,"PAH",61,1,35,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,36,0)="------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",61,1,37,0)="If your site is post-patch XM*7.1*50, this is what you should see when you"
^DIC(9.4,4,22,1,"PAH",61,1,38,0)="do the following:"
^DIC(9.4,4,22,1,"PAH",61,1,39,0)=">D ^%G"
^DIC(9.4,4,22,1,"PAH",61,1,40,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,41,0)="Global ^DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,42,0)="        DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,43,0)="^DD(3.9,0,""IX"",""AI"",3.9,9) = "
^DIC(9.4,4,22,1,"PAH",61,1,44,0)="^DD(3.9,0,""IX"",""AL"",3.914,4) =   <-- new with patch XM*7.1*50"
^DIC(9.4,4,22,1,"PAH",61,1,45,0)="^DD(3.9,0,""IX"",""AW"",3.914,2) =   <-- new with patch XM*7.1*50"
^DIC(9.4,4,22,1,"PAH",61,1,46,0)="^DD(3.9,0,""IX"",""B"",3.9,.01) = "
^DIC(9.4,4,22,1,"PAH",61,1,47,0)="^DD(3.9,0,""IX"",""C"",3.9,31) =     <-- new with patch XM*7.1*50"
^DIC(9.4,4,22,1,"PAH",61,1,48,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,49,0)="Post-patch XM*7.1*50, you should see no xrefs after the ""C"" xref:"
^DIC(9.4,4,22,1,"PAH",61,1,50,0)="Global ^XMB(3.9,""D"":"
^DIC(9.4,4,22,1,"PAH",61,1,51,0)="        XMB(3.9,""D"":"
^DIC(9.4,4,22,1,"PAH",61,1,52,0)="Global ^                         <-- nothing!"
^DIC(9.4,4,22,1,"PAH",61,1,53,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,54,0)="------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",61,1,55,0)="This is what some pre-patch XM*7.1*50 sites see:"
^DIC(9.4,4,22,1,"PAH",61,1,56,0)=">D ^%G"
^DIC(9.4,4,22,1,"PAH",61,1,57,0)=""
^DIC(9.4,4,22,1,"PAH",61,1,58,0)="Global ^DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,59,0)="        DD(3.9,0,""IX"""
^DIC(9.4,4,22,1,"PAH",61,1,60,0)="^DD(3.9,0,""IX"",""AI"",3.9,9) = "
^DIC(9.4,4,22,1,"PAH",61,1,61,0)="^DD(3.9,0,""IX"",""B"",3.9,.01) = "
^DIC(9.4,4,22,1,"PAH",61,1,62,0)="^DD(3.9,0,""IX"",""C"",3.9,1) = "
^DIC(9.4,4,22,1,"PAH",61,1,63,0)="^DD(3.9,0,""IX"",""I"",3.9,9) =      <-- bogus!  This appears to be a precursor"
^DIC(9.4,4,22,1,"PAH",61,1,64,0)="                                     to the ""AI"" xref, and was never properly"
^DIC(9.4,4,22,1,"PAH",61,1,65,0)="                                     deleted."
^DIC(9.4,4,22,1,"PAH",61,1,66,0)=""
