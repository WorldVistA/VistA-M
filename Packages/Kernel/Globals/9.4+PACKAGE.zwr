^DIC(9.4,14,22,5.9,"PAH",132,1,71,0)="         65.03,.04   (Location) (Note: Most recent entry is"
^DIC(9.4,14,22,5.9,"PAH",132,1,72,0)="                                 reported here)"
^DIC(9.4,14,22,5.9,"PAH",132,1,73,0)=" "
^DIC(9.4,14,22,5.9,"PAH",132,1,74,0)="      Specimen Data"
^DIC(9.4,14,22,5.9,"PAH",132,1,75,0)="         63.01,.01   (Date/Time Specimen Taken)"
^DIC(9.4,14,22,5.9,"PAH",132,1,76,0)="         63.01,.03   (Date Report Completed)"
^DIC(9.4,14,22,5.9,"PAH",132,1,77,0)="         63.01,.01   (Date/Time Specimen Taken)"
^DIC(9.4,14,22,5.9,"PAH",132,1,78,0)="         63.01,10    (ABO Interpretation)"
^DIC(9.4,14,22,5.9,"PAH",132,1,79,0)="         63.01,2.9   (DIRECT AHG INTERPRETATION)"
^DIC(9.4,14,22,5.9,"PAH",132,1,80,0)="         63.01,2.1   (DIRECT AHG(POLYSPECIFIC))"
^DIC(9.4,14,22,5.9,"PAH",132,1,81,0)="         63.01,2.4   (Anti-IgC)"
^DIC(9.4,14,22,5.9,"PAH",132,1,82,0)="         63.01,2.6   (ANTI-COMPLEMENT)"
^DIC(9.4,14,22,5.9,"PAH",132,1,83,0)="         63.01,11    (RH Interpretation)"
^DIC(9.4,14,22,5.9,"PAH",132,1,84,0)="         63.01,6     (Antibody Screen Interpretation)"
^DIC(9.4,14,22,5.9,"PAH",132,1,85,0)="         63.199,.01  (Specimen Comment)"
^DIC(9.4,14,22,5.9,"PAH",132,1,86,0)="         63.01,2.91  (DIRECT AHG TEST COMMENT)"
^DIC(9.4,14,22,5.9,"PAH",132,1,87,0)="         63.012,.01  (ELUATE ANTIBODY)"
^DIC(9.4,14,22,5.9,"PAH",132,1,88,0)="         63.46,.01   (SERUM ANTIBODY)"
^DIC(9.4,14,22,5.9,"PAH",132,1,89,0)="         63.46,.02   (ANTIBODY COMMENT)"
^DIC(9.4,14,22,5.9,"PAH",132,1,90,0)="         63.48,.01   (ANTIBODY SCREEN COMMENT)"
^DIC(9.4,14,22,5.9,"PAH",132,1,91,0)=" "
