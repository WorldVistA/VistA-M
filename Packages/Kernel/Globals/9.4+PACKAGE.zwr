^DIC(9.4,3,22,21,"PAH",112,1,3,0)="MAR-1099-21847  This patch should address the performance problems in Taskman "
^DIC(9.4,3,22,21,"PAH",112,1,4,0)="TAM-1099-31772  caused by patch XU*8*118."
^DIC(9.4,3,22,21,"PAH",112,1,5,0)="NTH-0999-72794  STL-1099-40458  MAR-1099-23207  SDC-1099-60815  WRJ-0899-13025"
^DIC(9.4,3,22,21,"PAH",112,1,6,0)="STX-1099-72163"
^DIC(9.4,3,22,21,"PAH",112,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",112,1,8,0)="SHR-1099-71855  ZISUTL   The UNDEF in %ZIS5 has been fixed."
^DIC(9.4,3,22,21,"PAH",112,1,9,0)="CON-0999-12912  WRJ-0999-12571  BED-0999-12380"
^DIC(9.4,3,22,21,"PAH",112,1,10,0)=""
^DIC(9.4,3,22,21,"PAH",112,1,11,0)="HIN-1099-41741  ZTMGRSET Updated the list of OS types to show"
^DIC(9.4,3,22,21,"PAH",112,1,12,0)="                VAX DSV(V7) and Cache."
^DIC(9.4,3,22,21,"PAH",112,1,13,0)="                "
^DIC(9.4,3,22,21,"PAH",112,1,14,0)="ZIS6     Add the task time and $H to the slot data"
^DIC(9.4,3,22,21,"PAH",112,1,15,0)="ZISTCPS  Has a fix for a change in Cache between 2.1.6 and 3.1"
^DIC(9.4,3,22,21,"PAH",112,1,16,0)="XUTMKA   New, To look for devices that are having problems."
^DIC(9.4,3,22,21,"PAH",112,1,17,0)=""
