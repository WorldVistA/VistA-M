^DIC(9.4,11,22,5.03,"PAH",3,1,252,0)=" "
^DIC(9.4,11,22,5.03,"PAH",3,1,253,0)="Install Questions for LA*5.2*23"
^DIC(9.4,11,22,5.03,"PAH",3,1,254,0)=" "
