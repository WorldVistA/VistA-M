^DIC(9.4,48,22,5.28,"PAH",104,1,0)="^^5^5^2981007"
^DIC(9.4,48,22,5.28,"PAH",104,1,1,0)="This patch corrects the division name that displays for add/edits on the"
^DIC(9.4,48,22,5.28,"PAH",104,1,2,0)="Outpatient Encounter Status Update Report."
