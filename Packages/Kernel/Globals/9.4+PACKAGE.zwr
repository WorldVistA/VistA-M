^DIC(9.4,14,22,5.9,"PAH",213,1,245,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",213,1,246,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",213,1,247,0)="This patch may be loaded with users on the system.  You may wish to"
^DIC(9.4,14,22,5.9,"PAH",213,1,248,0)="install it during non-peak hours.  Installation will take less than 1 "
^DIC(9.4,14,22,5.9,"PAH",213,1,249,0)="minute.  It is recommended to disable the Anatomic Pathology [LRAP] option"
^DIC(9.4,14,22,5.9,"PAH",213,1,250,0)="at the ""DISABLE Scheduled Options, Menu Options, and Protocols?"" prompt."
^DIC(9.4,14,22,5.9,"PAH",213,1,251,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,252,0)="1.  Use the INSTALL/CHECK MESSAGE option on the Packman Menu.  "
^DIC(9.4,14,22,5.9,"PAH",213,1,253,0)="  "
^DIC(9.4,14,22,5.9,"PAH",213,1,254,0)="2.  From the Kernel Installation and Distribution System (KIDS) Menu, "
^DIC(9.4,14,22,5.9,"PAH",213,1,255,0)="    select the Installation menu.  "
^DIC(9.4,14,22,5.9,"PAH",213,1,256,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,257,0)="3.  From the Installation menu, you may select to use the following "
^DIC(9.4,14,22,5.9,"PAH",213,1,258,0)="    options (when prompted for INSTALL NAME, enter LR*5.2*315): "
^DIC(9.4,14,22,5.9,"PAH",213,1,259,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,260,0)="    a.  Backup a Transport Global "
^DIC(9.4,14,22,5.9,"PAH",213,1,261,0)="    b.  Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",213,1,262,0)="    c.  Print Transport Global "
^DIC(9.4,14,22,5.9,"PAH",213,1,263,0)="    d.  Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",213,1,264,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,265,0)="4.  Use the Install Package(s) option and select the package LR*5.2*315."
^DIC(9.4,14,22,5.9,"PAH",213,1,266,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,267,0)="5.  When prompted 'Want KIDS to INHIBIT LOGONs during the install? NO//',"
^DIC(9.4,14,22,5.9,"PAH",213,1,268,0)="    respond NO."
^DIC(9.4,14,22,5.9,"PAH",213,1,269,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,270,0)="6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,14,22,5.9,"PAH",213,1,271,0)="    Protocols? YES//', Anatomic Pathology [LRAP] option."
^DIC(9.4,14,22,5.9,"PAH",213,1,272,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,273,0)=" Note: Routine LR315 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",213,1,274,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,275,0)="Installation Example:"
^DIC(9.4,14,22,5.9,"PAH",213,1,276,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",213,1,277,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,278,0)="Select Installation Option: 6  Install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",213,1,279,0)="Select INSTALL NAME:    LR*5.2*315     Loaded from Distribution  "
^DIC(9.4,14,22,5.9,"PAH",213,1,280,0)="10/18/08@16:48:47"
^DIC(9.4,14,22,5.9,"PAH",213,1,281,0)="      => LR*5.2*315"
^DIC(9.4,14,22,5.9,"PAH",213,1,282,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,283,0)=" This Distribution was loaded on Oct 18, 2008@16:48:47 with header of"
^DIC(9.4,14,22,5.9,"PAH",213,1,284,0)="    LR*5.2*315"
^DIC(9.4,14,22,5.9,"PAH",213,1,285,0)="    It consisted of the following Install(s):"
^DIC(9.4,14,22,5.9,"PAH",213,1,286,0)="      LR*5.2*315"
^DIC(9.4,14,22,5.9,"PAH",213,1,287,0)=" Checking Install for Package LR*5.2*315"
^DIC(9.4,14,22,5.9,"PAH",213,1,288,0)=" Will first run the Environment Check Routine, LR315"
