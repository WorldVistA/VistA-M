^DIC(9.4,96,22,1.2,1,1,0)="This  build contains two KIDS builds:"
^DIC(9.4,96,22,1.2,1,2,0)="  DENT*1.2*31 and DSIC 1.2"
^DIC(9.4,96,22,1.2,"PAH",0)="^9.4901^62^62"
^DIC(9.4,96,22,1.2,"PAH",1,0)="20 SEQ #19^2960819^1"
^DIC(9.4,96,22,1.2,"PAH",1,1,0)="^^1^1^2960819"
^DIC(9.4,96,22,1.2,"PAH",1,1,1,0)="Dental Version 1.2 Patch 20."
^DIC(9.4,96,22,1.2,"PAH",2,0)="21 SEQ #20^2961029^1"
^DIC(9.4,96,22,1.2,"PAH",2,1,0)="^^1^1^2961029"
^DIC(9.4,96,22,1.2,"PAH",2,1,1,0)="This is Dental Patch 21."
^DIC(9.4,96,22,1.2,"PAH",3,0)="22 SEQ #21^2970321^1"
^DIC(9.4,96,22,1.2,"PAH",3,1,0)="^^2^2^2970321"
^DIC(9.4,96,22,1.2,"PAH",3,1,1,0)="This is patch 22 of Dental Version 1.2.  This patch is the final clean up of"
^DIC(9.4,96,22,1.2,"PAH",3,1,2,0)="file 3, 6, and 16.  It'll delete any old routines that reference these files."
^DIC(9.4,96,22,1.2,"PAH",4,0)="23 SEQ #22^2971118^1"
^DIC(9.4,96,22,1.2,"PAH",4,1,0)="^^171^171^2971118"
^DIC(9.4,96,22,1.2,"PAH",4,1,1,0)="Patch 15 should be installed before patch 23.                             "
^DIC(9.4,96,22,1.2,"PAH",4,1,2,0)="                                                                          "
^DIC(9.4,96,22,1.2,"PAH",4,1,3,0)="This patch will fix the following: "
^DIC(9.4,96,22,1.2,"PAH",4,1,4,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,5,0)=" 1) NOIS BRX-0897-11424  DENTEC+2 DENTEC UNDEF ERROR "
^DIC(9.4,96,22,1.2,"PAH",4,1,6,0)="                                                                        "
^DIC(9.4,96,22,1.2,"PAH",4,1,7,0)="    ROUTINE MODIFIED: DENTEC                                              "
^DIC(9.4,96,22,1.2,"PAH",4,1,8,0)=" "
^DIC(9.4,96,22,1.2,"PAH",4,1,9,0)="    OPTION: Treatment Data Enter/Edit (Line By Line) [DENTTREAT LINE EDIT]"
^DIC(9.4,96,22,1.2,"PAH",4,1,10,0)="    An undefined error of the variable DA occurs when the user tries to "
^DIC(9.4,96,22,1.2,"PAH",4,1,11,0)="    delete the whole treatment data entry during the re-edit process in"
^DIC(9.4,96,22,1.2,"PAH",4,1,12,0)="    the option Treatment Data Enter/Edit (Line By Line) [DENTTREAT LINE"
^DIC(9.4,96,22,1.2,"PAH",4,1,13,0)="    EDIT].  The following is a sample screen capture reproducing the  "
^DIC(9.4,96,22,1.2,"PAH",4,1,14,0)="    error: "
^DIC(9.4,96,22,1.2,"PAH",4,1,15,0)="                                                                          "
^DIC(9.4,96,22,1.2,"PAH",4,1,16,0)="    Select Dental Activity Option: 3  Treatment Data Enter/Edit (Line By "
^DIC(9.4,96,22,1.2,"PAH",4,1,17,0)="Line) "
^DIC(9.4,96,22,1.2,"PAH",4,1,18,0)="You may select a treatment date by entering the patient's name or SSN, the"
^DIC(9.4,96,22,1.2,"PAH",4,1,19,0)="provider's number or the treatment date (without time).  "
^DIC(9.4,96,22,1.2,"PAH",4,1,20,0)="Select DENTAL TREATMENT (AMIS) DATE: N   OCT 17, 1997@11:14:06"
^DIC(9.4,96,22,1.2,"PAH",4,1,21,0)="  Are you adding 'OCT 17, 1997@11:14:06' as"
^DIC(9.4,96,22,1.2,"PAH",4,1,22,0)="    a new DENTAL TREATMENT (AMIS) (the 123RD)? Y  (Yes)"
^DIC(9.4,96,22,1.2,"PAH",4,1,23,0)="   DENTAL TREATMENT (AMIS) STATION.DIVISION: 578                       "
^DIC(9.4,96,22,1.2,"PAH",4,1,24,0)="   DENTAL TREATMENT (AMIS) DENTAL PROVIDER: DUCK,DONALD        2345"
^DIC(9.4,96,22,1.2,"PAH",4,1,25,0)=" "
