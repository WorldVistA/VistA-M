^DIC(9.4,14,22,5.9,"PAH",286,1,498,0)="   LR*5.2*479"
^DIC(9.4,14,22,5.9,"PAH",286,1,499,0)="   It consisted of the following Install(s):"
^DIC(9.4,14,22,5.9,"PAH",286,1,500,0)="     LR*5.2*479"
^DIC(9.4,14,22,5.9,"PAH",286,1,501,0)=" "
