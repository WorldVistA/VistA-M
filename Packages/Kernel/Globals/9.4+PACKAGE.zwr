^DIC(9.4,4,22,1,"PAH",84,0)="107 SEQ #109^3000229^1"
^DIC(9.4,4,22,1,"PAH",84,1,0)="^^194^194^3000229"
^DIC(9.4,4,22,1,"PAH",84,1,1,0)="Patch XM*7.1*107"
^DIC(9.4,4,22,1,"PAH",84,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,3,0)="Y2K Waiver Exemption ID: Y2KWE0024"
^DIC(9.4,4,22,1,"PAH",84,1,4,0)="This patch may be installed at any time during the Y2K Moratorium (including"
^DIC(9.4,4,22,1,"PAH",84,1,5,0)="the 12/15/1999 thru 1/15/2000 Y2K lockdown). "
^DIC(9.4,4,22,1,"PAH",84,1,6,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,7,0)="NOIS: ANN-1199-42486"
^DIC(9.4,4,22,1,"PAH",84,1,8,0)="Test Site:  Ann Arbor, MI"
^DIC(9.4,4,22,1,"PAH",84,1,9,0)="Circular relay domains create an allocation error.  MailMan now recognizes"
^DIC(9.4,4,22,1,"PAH",84,1,10,0)="when a domain has a relay domain, which has a relay domain, which... circles"
^DIC(9.4,4,22,1,"PAH",84,1,11,0)="back to itself.  MailMan lets the user know what's wrong. "
^DIC(9.4,4,22,1,"PAH",84,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,13,0)="NOIS: ANN-1199-42486, BIL-1199-31104"
^DIC(9.4,4,22,1,"PAH",84,1,14,0)="Test Sites:  Ann Arbor, MI; Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",84,1,15,0)="A typo causes an abort in APIs HDR^XMA0 and PR2^XMA0.  Typo is fixed."
^DIC(9.4,4,22,1,"PAH",84,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,17,0)="NOIS: DAY-1199-41994, WAS-1199-20590"
^DIC(9.4,4,22,1,"PAH",84,1,18,0)="Test Site: Madison, WI"
^DIC(9.4,4,22,1,"PAH",84,1,19,0)="Sometimes, when a user becomes a surrogate, his own (not the surrogate's)"
^DIC(9.4,4,22,1,"PAH",84,1,20,0)="messages are displayed.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",84,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,22,0)="NOIS:  LAS-1299-60664"
^DIC(9.4,4,22,1,"PAH",84,1,23,0)="Test Site:  Las Vegas, NV"
^DIC(9.4,4,22,1,"PAH",84,1,24,0)="Message addressed to G.<space>@<local site name> invokes the space-bar recall"
^DIC(9.4,4,22,1,"PAH",84,1,25,0)="for mail group.  This ""feature"" is now disabled."
^DIC(9.4,4,22,1,"PAH",84,1,26,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,27,0)="NOIS:  MAD-1299-42404"
^DIC(9.4,4,22,1,"PAH",84,1,28,0)="Test Site:  Madison, WI"
^DIC(9.4,4,22,1,"PAH",84,1,29,0)="Non-MailMan systems, such as MS Exchange, do not recognize I:<recipient>,"
^DIC(9.4,4,22,1,"PAH",84,1,30,0)="and return error messages when recipients are addressed as info-only."
^DIC(9.4,4,22,1,"PAH",84,1,31,0)="MailMan now leaves off the ""I:"" when sending messages to info-only recipients"
^DIC(9.4,4,22,1,"PAH",84,1,32,0)="on non-MailMan systems."
^DIC(9.4,4,22,1,"PAH",84,1,33,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,34,0)="NOIS: WAS-1199-20590, BRX-1199-10383"
^DIC(9.4,4,22,1,"PAH",84,1,35,0)="Test Sites: Washington, DC; Madison, WI; Bronx, NY"
^DIC(9.4,4,22,1,"PAH",84,1,36,0)="Sites have noticed sometimes, when becoming the Postmaster, MailMan informs"
^DIC(9.4,4,22,1,"PAH",84,1,37,0)="them that the last user to become the Postmaster was someone who is not a"
^DIC(9.4,4,22,1,"PAH",84,1,38,0)="valid Postmaster surrogate.  When a package sets XMDUZ=.5 and then sends a"
^DIC(9.4,4,22,1,"PAH",84,1,39,0)="message using ^XMD, MailMan records that use as ""last used MailMan"".  It"
^DIC(9.4,4,22,1,"PAH",84,1,40,0)="shouldn't.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",84,1,41,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,42,0)="E3R:  12385"
^DIC(9.4,4,22,1,"PAH",84,1,43,0)="Test Site:  Tampa, FL; Albany, NY"
^DIC(9.4,4,22,1,"PAH",84,1,44,0)="This patch lets an authorized user send a limited broadcast message to a"
^DIC(9.4,4,22,1,"PAH",84,1,45,0)="subset of local users.  A subset might include all users who have a certain"
^DIC(9.4,4,22,1,"PAH",84,1,46,0)="primary menu or who belong to a certain division, or any other way that users"
^DIC(9.4,4,22,1,"PAH",84,1,47,0)="in the NEW PERSON file might be categorized."
^DIC(9.4,4,22,1,"PAH",84,1,48,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,49,0)="Users authorized to send limited broadcasts are the POSTMASTER, any holder"
^DIC(9.4,4,22,1,"PAH",84,1,50,0)="of the XMSTAR key, and any holder of the new key, XMSTAR LIMITED."
^DIC(9.4,4,22,1,"PAH",84,1,51,0)="The XMSTAR and XMSTAR LIMITED keys are mutually exclusive."
^DIC(9.4,4,22,1,"PAH",84,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,53,0)="Limited broadcast types are predefined in the new LIMITED BROADCAST multiple"
^DIC(9.4,4,22,1,"PAH",84,1,54,0)="of file 4.3, the MAILMAN SITE PARAMETERS file:"
^DIC(9.4,4,22,1,"PAH",84,1,55,0)="50        LIMITED BROADCAST (Multiple-4.32), [5;0]"
^DIC(9.4,4,22,1,"PAH",84,1,56,0)="          .01  LIMITED BROADCAST (MF), [0;1]"
^DIC(9.4,4,22,1,"PAH",84,1,57,0)="          1    POINTED TO FILE (RNJ9,3), [0;2]"
^DIC(9.4,4,22,1,"PAH",84,1,58,0)="          2    NEW PERSON FILE XREF (RF), [0;3]"
^DIC(9.4,4,22,1,"PAH",84,1,59,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,60,0)="The multiple will be loaded with 4 limited broadcasts by the post init:"
^DIC(9.4,4,22,1,"PAH",84,1,61,0)="LIMITED BROADCAST     POINTED TO FILE            NEW PERSON FILE XREF"
^DIC(9.4,4,22,1,"PAH",84,1,62,0)="-----------------     ----------------------     --------------------"
^DIC(9.4,4,22,1,"PAH",84,1,63,0)="DIVISION               4   (institution)         ""AH"""
^DIC(9.4,4,22,1,"PAH",84,1,64,0)="KEY                   19.1 (security key)        ""AB"""
^DIC(9.4,4,22,1,"PAH",84,1,65,0)="PRIMARY MENU          19   (option)              ""AP"""
^DIC(9.4,4,22,1,"PAH",84,1,66,0)="SERVICE/SECTION       49   (service/section)     ""E"""
^DIC(9.4,4,22,1,"PAH",84,1,67,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,68,0)="The cross references listed in the NEW PERSON FILE XREF field enable MailMan"
^DIC(9.4,4,22,1,"PAH",84,1,69,0)="to quickly identify the users who should receive the limited broadcast"
^DIC(9.4,4,22,1,"PAH",84,1,70,0)="messages.  In support of this patch, Kernel patch XU*8.0*135 adds a"
^DIC(9.4,4,22,1,"PAH",84,1,71,0)="new whole-file cross reference (""AH"", on the DIVISION field) to the NEW"
^DIC(9.4,4,22,1,"PAH",84,1,72,0)="PERSON file.  This new cross reference enables a limited broadcast by DIVISION. "
^DIC(9.4,4,22,1,"PAH",84,1,73,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,74,0)="You may add more limited broadcasts to the multiple, if you wish."
^DIC(9.4,4,22,1,"PAH",84,1,75,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,76,0)="Using another new field in file 4.3, you may set a limited broadcast default"
^DIC(9.4,4,22,1,"PAH",84,1,77,0)="choice, which is displayed whenever someone goes to send a limited broadcast."
^DIC(9.4,4,22,1,"PAH",84,1,78,0)="51        LIMITED BROADCAST DEFAULT, [0;20]"
^DIC(9.4,4,22,1,"PAH",84,1,79,0)="The post-init will set this field to DIVISION.  You may change it if you wish."
^DIC(9.4,4,22,1,"PAH",84,1,80,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,81,0)="The option XMKSP Edit MailMan Site Parameters is updated to include the new"
^DIC(9.4,4,22,1,"PAH",84,1,82,0)="fields."
^DIC(9.4,4,22,1,"PAH",84,1,83,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,84,0)="Additional fixes in this patch:"
^DIC(9.4,4,22,1,"PAH",84,1,85,0)="- MailMan now recognizes when a message has only 'latered' recipients.  When"
^DIC(9.4,4,22,1,"PAH",84,1,86,0)="forwarding or sending messages which have only 'latered' recipients, MailMan"
^DIC(9.4,4,22,1,"PAH",84,1,87,0)="did not recognize those recipients and issued an error message. This patch"
^DIC(9.4,4,22,1,"PAH",84,1,88,0)="corrects that. "
^DIC(9.4,4,22,1,"PAH",84,1,89,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,90,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",84,1,91,0)="minimum.  It requires Kernel patch XU*8.0*135 and MailMan patches XM*7.1*74,"
^DIC(9.4,4,22,1,"PAH",84,1,92,0)="XM*7.1*94, XM*7.1*99, XM*7.1*102, XM*7.1*103, XM*7.1*104, XM*7.1*105,"
^DIC(9.4,4,22,1,"PAH",84,1,93,0)="and XM*7.1*106."
^DIC(9.4,4,22,1,"PAH",84,1,94,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",84,1,95,0)=""
^DIC(9.4,4,22,1,"PAH",84,1,96,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",84,1,97,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",84,1,98,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",84,1,99,0)=" "
^DIC(9.4,4,22,1,"PAH",84,1,100,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",84,1,101,0)="Name          Checksum        Checksum        Patch List"
