^DIC(9.4,59,22,5,"PAH",294,0)="296 SEQ #294^3120104.091035^17"
^DIC(9.4,59,22,5,"PAH",294,1,0)="^^25^25^3120104"
^DIC(9.4,59,22,5,"PAH",294,1,1,0)="This patch is part of the Copayment enhancement project and it will be "
^DIC(9.4,59,22,5,"PAH",294,1,2,0)="released along with the Integrated Billing patch IB*2*456 and the Accounts"
^DIC(9.4,59,22,5,"PAH",294,1,3,0)="Receivable package (PRCA*4.5*278). "
^DIC(9.4,59,22,5,"PAH",294,1,4,0)=" "
^DIC(9.4,59,22,5,"PAH",294,1,5,0)="This patch contains changes to the Inquire to National Files [PSNACT] and "
^DIC(9.4,59,22,5,"PAH",294,1,6,0)="Inquire to VA Product Info For Local Drug [PSNLOOK] options to include"
^DIC(9.4,59,22,5,"PAH",294,1,7,0)="the display of the new fields. Below are some screen captures of how the "
^DIC(9.4,59,22,5,"PAH",294,1,8,0)="new fields will display to the screen for both options:"
^DIC(9.4,59,22,5,"PAH",294,1,9,0)=" "
^DIC(9.4,59,22,5,"PAH",294,1,10,0)="   Example #1:"
^DIC(9.4,59,22,5,"PAH",294,1,11,0)="         ..."
^DIC(9.4,59,22,5,"PAH",294,1,12,0)="         Reduced Co-pay: None "
^DIC(9.4,59,22,5,"PAH",294,1,13,0)=" "
^DIC(9.4,59,22,5,"PAH",294,1,14,0)="   Example #2:"
^DIC(9.4,59,22,5,"PAH",294,1,15,0)="         ..."
^DIC(9.4,59,22,5,"PAH",294,1,16,0)="         Reduced Co-pay: Start Date: 01/01/2012     Stop Date: 06/30/2012"
^DIC(9.4,59,22,5,"PAH",294,1,17,0)="                         Start Date: 01/01/2013     Stop Date:  "
^DIC(9.4,59,22,5,"PAH",294,1,18,0)=" "
^DIC(9.4,59,22,5,"PAH",294,1,19,0)=" "
^DIC(9.4,59,22,5,"PAH",294,1,20,0)="Also, this patch adds the component $$REDCOP to the routine PSNAPIS, "
^DIC(9.4,59,22,5,"PAH",294,1,21,0)="supported by Integration Control Registration (ICR) #2531, to return the"
^DIC(9.4,59,22,5,"PAH",294,1,22,0)="existence of reduced copayment for a VA Product on a given date."
^DIC(9.4,59,22,5,"PAH",294,1,23,0)=" "
^DIC(9.4,59,22,5,"PAH",294,1,24,0)="Updates to these new fields will happen automatically via the monthly "
^DIC(9.4,59,22,5,"PAH",294,1,25,0)="National Drug File (NDF) Data Update patches."
