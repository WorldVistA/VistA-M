^DIC(9.4,14,22,5.9,"PAH",278,1,749,0)=" "
^DIC(9.4,14,22,5.9,"PAH",278,1,750,0)="Select General Parameter Tools <TEST ACCOUNT> Option: LV  List Values for "
^DIC(9.4,14,22,5.9,"PAH",278,1,751,0)="a Selected Parameter"
^DIC(9.4,14,22,5.9,"PAH",278,1,752,0)="Select PARAMETER DEFINITION NAME: ORWOR CATEGORY SEQUENCE     Orders"
^DIC(9.4,14,22,5.9,"PAH",278,1,753,0)="Category Sequence"
^DIC(9.4,14,22,5.9,"PAH",278,1,754,0)=" "
