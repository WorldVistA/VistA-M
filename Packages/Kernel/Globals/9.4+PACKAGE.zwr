^DIC(9.4,4,22,1,"PAH",80,0)="111 SEQ #105^3000204^1"
^DIC(9.4,4,22,1,"PAH",80,1,0)="^^64^64^3000204"
^DIC(9.4,4,22,1,"PAH",80,1,1,0)="Patch XM*7.1*111"
^DIC(9.4,4,22,1,"PAH",80,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",80,1,3,0)="Y2K Waiver Request ID#:  Y2KW0001        Y2K Waiver Status: Approved"
^DIC(9.4,4,22,1,"PAH",80,1,4,0)="This patch may be installed during the Y2K Moratorium, either BEFORE 12/15/99"
^DIC(9.4,4,22,1,"PAH",80,1,5,0)="or AFTER 1/15/2000. This patch MAY NOT be installed between 12/15/1999 and"
^DIC(9.4,4,22,1,"PAH",80,1,6,0)="1/15/2000 (the Y2K Lockdown Period). "
^DIC(9.4,4,22,1,"PAH",80,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",80,1,8,0)="NOIS: RIC-1299-20703"
^DIC(9.4,4,22,1,"PAH",80,1,9,0)="Test Site:  Richmond, VA"
^DIC(9.4,4,22,1,"PAH",80,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",80,1,11,0)="A typo in routine ^XMUT2 caused the large message report to always start with"
^DIC(9.4,4,22,1,"PAH",80,1,12,0)="the first message in the message global, even if the user chose a different"
^DIC(9.4,4,22,1,"PAH",80,1,13,0)="message.  This patch fixes that.  This patch also changes the starting"
^DIC(9.4,4,22,1,"PAH",80,1,14,0)="parameter from message number to message date.  We're doing this because"
^DIC(9.4,4,22,1,"PAH",80,1,15,0)="message numbers can be recycled."
^DIC(9.4,4,22,1,"PAH",80,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",80,1,17,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",80,1,18,0)="It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",80,1,19,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",80,1,20,0)=""
