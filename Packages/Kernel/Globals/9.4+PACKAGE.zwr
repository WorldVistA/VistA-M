^DIC(9.4,4,22,1,"PAH",131,1,28,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",131,1,29,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,1,"PAH",131,1,30,0)="It requires MailMan patch XM*7.1*162."
^DIC(9.4,4,22,1,"PAH",131,1,31,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",131,1,32,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
