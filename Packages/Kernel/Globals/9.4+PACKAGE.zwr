^DIC(9.4,14,22,5.9,"PAH",153,1,169,0)="  "
^DIC(9.4,14,22,5.9,"PAH",153,1,170,0)="See LABORATORY POINT OF CARE (POC) INTERFACE INSTALLATION AND USER GUIDE"
^DIC(9.4,14,22,5.9,"PAH",153,1,171,0)="    PATCH LA*5.2*67 AND PATCH LR*5.2*290  Version 5.2  JUNE 2005"
^DIC(9.4,14,22,5.9,"PAH",154,0)="257 SEQ #252^3050625^1"
^DIC(9.4,14,22,5.9,"PAH",154,1,0)="^^257^257^3050625"
^DIC(9.4,14,22,5.9,"PAH",154,1,1,0)="Blood Bank Clearance:"
^DIC(9.4,14,22,5.9,"PAH",154,1,2,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",154,1,3,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*257 does not"
^DIC(9.4,14,22,5.9,"PAH",154,1,4,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,14,22,5.9,"PAH",154,1,5,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",154,1,6,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,7,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*257 does not alter"
^DIC(9.4,14,22,5.9,"PAH",154,1,8,0)="or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",154,1,9,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",154,1,10,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,11,0)="RISK ANALYSIS: Changes made by patch LR*5.2*257 have no effect on Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",154,1,12,0)="software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",154,1,13,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,14,0)="VALIDATION REQUIREMENTS BY OPTION:  Because of the nature of the changes made,"
^DIC(9.4,14,22,5.9,"PAH",154,1,15,0)="no specific validation requirements exist as a result of installation of this"
^DIC(9.4,14,22,5.9,"PAH",154,1,16,0)="patch."
^DIC(9.4,14,22,5.9,"PAH",154,1,17,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,18,0)="This patch provides the ability to print an Antimicrobial Trend Report by"
^DIC(9.4,14,22,5.9,"PAH",154,1,19,0)="division.  There are three new additions to the LAB DATA (#63) file-"
^DIC(9.4,14,22,5.9,"PAH",154,1,20,0)="one new field for the ""CH"" subscript and two new fields for the ""MI"" subscript."
^DIC(9.4,14,22,5.9,"PAH",154,1,21,0)="These fields will be used to capture the ordering location and institution"
^DIC(9.4,14,22,5.9,"PAH",154,1,22,0)="during accessioning.  In the MICROBIOLOGY (#63.05) sub-file of the LAB DATA "
^DIC(9.4,14,22,5.9,"PAH",154,1,23,0)="(#63) file, the new fields are REQUESTING LOC/DIV (#63.05,.111) and"
^DIC(9.4,14,22,5.9,"PAH",154,1,24,0)="ACCESSIONING INSTITUTION (#63.05,.112).  In the CHEM, HEM, TOX, RIA, SER,"
^DIC(9.4,14,22,5.9,"PAH",154,1,25,0)="etc. (#63.04) sub-file of the LAB DATA (#63) file, the new field is"
^DIC(9.4,14,22,5.9,"PAH",154,1,26,0)="ACCESSIONING INSTITUTION (#63.04,.112).  In the CHEM, HEM, TOX, RIA, SER, etc."
^DIC(9.4,14,22,5.9,"PAH",154,1,27,0)="(#63.04) sub-file of the LAB DATA (#63) file, the REQUESTING LOC/DIV"
^DIC(9.4,14,22,5.9,"PAH",154,1,28,0)="(#63.04,.111) field is modified to remove the screen on INSTITUTION file (#4)"
^DIC(9.4,14,22,5.9,"PAH",154,1,29,0)="since sites need to be able to point to entries in the INSTITUTION file (#4)"
^DIC(9.4,14,22,5.9,"PAH",154,1,30,0)="that are not VA facilities such as DoD and commercial/civilian facilities."
^DIC(9.4,14,22,5.9,"PAH",154,1,31,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,32,0)="ALB-0600-50112/HD0000000069278:"
^DIC(9.4,14,22,5.9,"PAH",154,1,33,0)="Patch LR*5.2*257 also corrects two typographical errors. The query portion of"
^DIC(9.4,14,22,5.9,"PAH",154,1,34,0)="the Microbiology Trend Entry routine has two typographical errors. The word"
^DIC(9.4,14,22,5.9,"PAH",154,1,35,0)="misspelled as susceptability should be susceptibility. Also, the misspelled"
^DIC(9.4,14,22,5.9,"PAH",154,1,36,0)="word procede should be proceed."
^DIC(9.4,14,22,5.9,"PAH",154,1,37,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,38,0)="MODIFIED OPTION"
^DIC(9.4,14,22,5.9,"PAH",154,1,39,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",154,1,40,0)="NAME: LRMITS                      MENU TEXT: Microbiology Trend Report"
^DIC(9.4,14,22,5.9,"PAH",154,1,41,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",154,1,42,0)="  HELP FRAME: LRMITS OPTION       PACKAGE: LAB SERVICE"
^DIC(9.4,14,22,5.9,"PAH",154,1,43,0)="DESCRIPTION:  The antimicrobial trend report is used to compare counts of"
^DIC(9.4,14,22,5.9,"PAH",154,1,44,0)="organisms and patterns of antibiotic susceptibility.  Different types of"
^DIC(9.4,14,22,5.9,"PAH",154,1,45,0)="reports can be generated.  The types of reports are categorized by: organism,"
^DIC(9.4,14,22,5.9,"PAH",154,1,46,0)="specimen, collection sample, patient, physician, and location.  Specific"
^DIC(9.4,14,22,5.9,"PAH",154,1,47,0)="criteria can be applied to all report types.  Criteria include: specific types"
^DIC(9.4,14,22,5.9,"PAH",154,1,48,0)="of organisms, isolates collected after a specified time from admission, merge"
^DIC(9.4,14,22,5.9,"PAH",154,1,49,0)="criteria, antibiotic patterns, and detailed reports.  These reports can be"
^DIC(9.4,14,22,5.9,"PAH",154,1,50,0)="printed by division or selected divisions."
^DIC(9.4,14,22,5.9,"PAH",154,1,51,0)="  ROUTINE: LRMITS"
^DIC(9.4,14,22,5.9,"PAH",154,1,52,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,53,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,54,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,55,0)="DATA DICTIONARY CHANGES:"
^DIC(9.4,14,22,5.9,"PAH",154,1,56,0)="========================"
^DIC(9.4,14,22,5.9,"PAH",154,1,57,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,58,0)="NEW FIELDS:"
^DIC(9.4,14,22,5.9,"PAH",154,1,59,0)="==========="
^DIC(9.4,14,22,5.9,"PAH",154,1,60,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,61,0)="In the MICROBIOLOGY (#63.05) sub-file of the LAB DATA (#63) file: "
^DIC(9.4,14,22,5.9,"PAH",154,1,62,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,63,0)="63.05,.111      REQUESTING LOC/DIV   0;13         VARIABLE POINTER"
^DIC(9.4,14,22,5.9,"PAH",154,1,64,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,65,0)="                FILE  ORDER  PREFIX    LAYGO  MESSAGE"
^DIC(9.4,14,22,5.9,"PAH",154,1,66,0)="                   44   1    SC(          n   Enter Hospital Location "
^DIC(9.4,14,22,5.9,"PAH",154,1,67,0)="                   4    2    DIC(4,       n   Select appropriate Institution "
^DIC(9.4,14,22,5.9,"PAH",154,1,68,0)="                                         "
^DIC(9.4,14,22,5.9,"PAH",154,1,69,0)="                LAST EDITED:    AUG 04, 2004 "
^DIC(9.4,14,22,5.9,"PAH",154,1,70,0)="                DESCRIPTION:    Enter the hospital location or institution"
^DIC(9.4,14,22,5.9,"PAH",154,1,71,0)="                                ordering this test.  "
^DIC(9.4,14,22,5.9,"PAH",154,1,72,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,73,0)="63.05,.112    ACCESSIONING INSTITUTION 0;14 POINTER TO INSTITUTION FILE (#4)"
^DIC(9.4,14,22,5.9,"PAH",154,1,74,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,75,0)="              LAST EDITED:      AUG 04, 2004 "
^DIC(9.4,14,22,5.9,"PAH",154,1,76,0)="              DESCRIPTION:      This field contains the pointer to the"
^DIC(9.4,14,22,5.9,"PAH",154,1,77,0)="                                institution where the specimen was accessioned."
^DIC(9.4,14,22,5.9,"PAH",154,1,78,0)="                                This field can be blank if LEDI or POC specimen "
^DIC(9.4,14,22,5.9,"PAH",154,1,79,0)="                                is accessioned. The field will be set if an"
^DIC(9.4,14,22,5.9,"PAH",154,1,80,0)="                                actual user accepts the specimen.  "
^DIC(9.4,14,22,5.9,"PAH",154,1,81,0)=""
