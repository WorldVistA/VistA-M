^DIC(9.4,42,4,"B",142.99,5)=""
^DIC(9.4,42,5)="SLC"
^DIC(9.4,42,7)="^^I"
^DIC(9.4,42,9)="^"
^DIC(9.4,42,11)="142^142.99"
^DIC(9.4,42,22,0)="^9.49I^7^1"
^DIC(9.4,42,22,7,0)="2.7^3051119^2960613"
^DIC(9.4,42,22,7,"PAH",0)="^9.4901^131^131"
^DIC(9.4,42,22,7,"PAH",1,0)="8^2960822^1"
^DIC(9.4,42,22,7,"PAH",1,1,0)="^^4^4^2960822"
^DIC(9.4,42,22,7,"PAH",1,1,1,0)="This build contains the routines for the PCE Health Summary components."
^DIC(9.4,42,22,7,"PAH",1,1,2,0)="The routines, excluding GMTSP8, were originally distributed with Health"
^DIC(9.4,42,22,7,"PAH",1,1,3,0)="Summary v2.7, but were modified as a result of alpha/beta and useability"
^DIC(9.4,42,22,7,"PAH",1,1,4,0)="testing"
^DIC(9.4,42,22,7,"PAH",2,0)="3 SEQ #7^2960923^1"
^DIC(9.4,42,22,7,"PAH",2,1,0)="^^19^19^2960923"
^DIC(9.4,42,22,7,"PAH",2,1,1,0)="This patch contains 3 routines that must be installed in conjunction with"
^DIC(9.4,42,22,7,"PAH",2,1,2,0)="patch, LAB*5.2*72, which is changing how the accession numbers are stored."
^DIC(9.4,42,22,7,"PAH",2,1,3,0)=" "
^DIC(9.4,42,22,7,"PAH",2,1,4,0)="With patch LAB*5.2*72, the accession number along with the accession area"
^DIC(9.4,42,22,7,"PAH",2,1,5,0)="and year will be stored in the accession field. The following routines"
^DIC(9.4,42,22,7,"PAH",2,1,6,0)="have been changed to accommodate the printing of the Anatomic Path"
^DIC(9.4,42,22,7,"PAH",2,1,7,0)="Accession numbers as a result of LR*5.2*72."
^DIC(9.4,42,22,7,"PAH",2,1,8,0)=" "
^DIC(9.4,42,22,7,"PAH",2,1,9,0)=" "
^DIC(9.4,42,22,7,"PAH",2,1,10,0)="Routine          Component                      Checksum"
^DIC(9.4,42,22,7,"PAH",2,1,11,0)="-------          --------                       --------"
^DIC(9.4,42,22,7,"PAH",2,1,12,0)="GMTSLRAE         Surgical Pathology  (SP)       11034834"
^DIC(9.4,42,22,7,"PAH",2,1,13,0)="GMTSLREE         Electron Microscopy (EM)       6062333"
^DIC(9.4,42,22,7,"PAH",2,1,14,0)="GMTSLRPE         Cytopathology       (CY)       6384929"
^DIC(9.4,42,22,7,"PAH",2,1,15,0)=" "
^DIC(9.4,42,22,7,"PAH",2,1,16,0)=" "
^DIC(9.4,42,22,7,"PAH",2,1,17,0)="Installation:  Users may remain on the system during installation of this"
^DIC(9.4,42,22,7,"PAH",2,1,18,0)="patch; however, we recommend installing it during non-peak hours to"
^DIC(9.4,42,22,7,"PAH",2,1,19,0)="minimize disruption to the users."
^DIC(9.4,42,22,7,"PAH",3,0)="9 SEQ #8^2961108^1"
^DIC(9.4,42,22,7,"PAH",3,1,0)="^^7^7^2961108"
^DIC(9.4,42,22,7,"PAH",3,1,1,0)="The patch corrects problems reported in the following NOIS:"
^DIC(9.4,42,22,7,"PAH",3,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",3,1,3,0)="     GAI-0996-30232  2ND LEVEL PROCEDURE CODES (Surgery Components)"
^DIC(9.4,42,22,7,"PAH",3,1,4,0)="     TOP-0896-40519  using HS from Third Party Joint (Lab Orders)"
^DIC(9.4,42,22,7,"PAH",3,1,5,0)="     DAN-0596-41443  Other Procedures not displaying on Brief"
^DIC(9.4,42,22,7,"PAH",3,1,6,0)="     PAL-1096-61259  Occurence limit for surg comp"
^DIC(9.4,42,22,7,"PAH",3,1,7,0)="     WIC-1096-42206  Error when running health summary type"
^DIC(9.4,42,22,7,"PAH",4,0)="7 SEQ #9^2961125^1"
^DIC(9.4,42,22,7,"PAH",4,1,0)="^^7^7^2961125"
^DIC(9.4,42,22,7,"PAH",4,1,1,0)="Fixes to HS Utilities, MAX String error"
^DIC(9.4,42,22,7,"PAH",4,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",4,1,3,0)="NOIS:  POR-0995-51855"
^DIC(9.4,42,22,7,"PAH",4,1,4,0)="       MAC-1195-61525"
^DIC(9.4,42,22,7,"PAH",4,1,5,0)="       BRX-0596-1045"
^DIC(9.4,42,22,7,"PAH",4,1,6,0)="       HOT-0396-41244"
^DIC(9.4,42,22,7,"PAH",4,1,7,0)="       BOS-1096-12910"
^DIC(9.4,42,22,7,"PAH",5,0)="13^2970107^1"
^DIC(9.4,42,22,7,"PAH",5,1,0)="^^1^1^2970107"
^DIC(9.4,42,22,7,"PAH",5,1,1,0)="See Patch Module for GMTS*2.7*13."
^DIC(9.4,42,22,7,"PAH",6,0)="10 SEQ #11^2970306^1"
^DIC(9.4,42,22,7,"PAH",6,1,0)="^^7^7^2970306"
^DIC(9.4,42,22,7,"PAH",6,1,1,0)="This patch addresses issues noted in NOIS:"
^DIC(9.4,42,22,7,"PAH",6,1,2,0)=" "
^DIC(9.4,42,22,7,"PAH",6,1,3,0)="PAL-1096-60251"
^DIC(9.4,42,22,7,"PAH",6,1,4,0)="SUX-0996-41769"
^DIC(9.4,42,22,7,"PAH",6,1,5,0)="ISL-1196-50805"
^DIC(9.4,42,22,7,"PAH",6,1,6,0)="E3R 9149"
^DIC(9.4,42,22,7,"PAH",6,1,7,0)="E3R 9347"
^DIC(9.4,42,22,7,"PAH",7,0)="14 SEQ #12^2970528^1"
^DIC(9.4,42,22,7,"PAH",7,1,0)="^^1^1^2970528"
^DIC(9.4,42,22,7,"PAH",7,1,1,0)="Updated Rad/Nuc Med health summary"
^DIC(9.4,42,22,7,"PAH",8,0)="12 SEQ #13^2971006^1"
^DIC(9.4,42,22,7,"PAH",8,1,0)="^^5^5^2971006"
^DIC(9.4,42,22,7,"PAH",8,1,1,0)="This patch installs several routines to support the Progress Notes and"
^DIC(9.4,42,22,7,"PAH",8,1,2,0)="Discharge Summary components of Health Summary, which are compatible with"
^DIC(9.4,42,22,7,"PAH",8,1,3,0)="and rely upon TIU."
^DIC(9.4,42,22,7,"PAH",8,1,4,0)=" "
^DIC(9.4,42,22,7,"PAH",8,1,5,0)="NOTE: This patch may only be installed in an account where TIU exists."
^DIC(9.4,42,22,7,"PAH",9,0)="16 SEQ #14^2971007^1"
^DIC(9.4,42,22,7,"PAH",9,1,0)="^^2^2^2971007"
^DIC(9.4,42,22,7,"PAH",9,1,1,0)="GMTS*2.7*16.  See national patch module for a description of the"
^DIC(9.4,42,22,7,"PAH",9,1,2,0)="changes incorporated in this patch."
^DIC(9.4,42,22,7,"PAH",10,0)="17 SEQ #15^2971007^1"
^DIC(9.4,42,22,7,"PAH",10,1,0)="^^2^2^2971007"
^DIC(9.4,42,22,7,"PAH",10,1,1,0)="Patch GMTS*2.7*17.  Please see the patch description on the "
^DIC(9.4,42,22,7,"PAH",10,1,2,0)="national patch module."
^DIC(9.4,42,22,7,"PAH",11,0)="19 SEQ #16^2971016^1"
^DIC(9.4,42,22,7,"PAH",11,1,0)="^^2^2^2971016"
^DIC(9.4,42,22,7,"PAH",11,1,1,0)="Patch GMTS*2.7*19.  Please see the national patch module for"
^DIC(9.4,42,22,7,"PAH",11,1,2,0)="a complete description of this patch."
^DIC(9.4,42,22,7,"PAH",12,0)="22 SEQ #17^2971118^1"
^DIC(9.4,42,22,7,"PAH",12,1,0)="^^3^3^2971118"
^DIC(9.4,42,22,7,"PAH",12,1,1,0)="This patch contains changes so that the Clinical Reminder and Clinical"
^DIC(9.4,42,22,7,"PAH",12,1,2,0)="Maintenance components will print a trailing ""(E)"" for the last date of"
^DIC(9.4,42,22,7,"PAH",12,1,3,0)="reminders satisified by an historical enocounter."
^DIC(9.4,42,22,7,"PAH",13,0)="23 SEQ #18^2980220^1"
^DIC(9.4,42,22,7,"PAH",13,1,0)="^^3^3^2980220"
^DIC(9.4,42,22,7,"PAH",13,1,1,0)="Health Summary patch GMTS*2.7*23. This patch adds a new Health Summary"
^DIC(9.4,42,22,7,"PAH",13,1,2,0)="component for Clinical Reminders. The name of this component is CLINICAL"
^DIC(9.4,42,22,7,"PAH",13,1,3,0)="REMINDERS SUMMARY, the abbreviation is CRS."
^DIC(9.4,42,22,7,"PAH",14,0)="18 SEQ #19^2980330^1"
^DIC(9.4,42,22,7,"PAH",14,1,0)="^^2^2^2980330"
^DIC(9.4,42,22,7,"PAH",14,1,1,0)="This is health summary patch GMTS*2.7*18.  Please"
^DIC(9.4,42,22,7,"PAH",14,1,2,0)="see the national patch module for a complete description."
^DIC(9.4,42,22,7,"PAH",15,0)="21 SEQ #20^2980330^1"
^DIC(9.4,42,22,7,"PAH",15,1,0)="^^3^3^2980330"
^DIC(9.4,42,22,7,"PAH",15,1,1,0)="This patch correct problem with page lengths longer than the"
^DIC(9.4,42,22,7,"PAH",15,1,2,0)="HFS device they are sent to.  See the GMTS*2.7*21 patch description"
^DIC(9.4,42,22,7,"PAH",15,1,3,0)="on the National Patch Modual."
^DIC(9.4,42,22,7,"PAH",16,0)="24 SEQ #21^2980330^1"
^DIC(9.4,42,22,7,"PAH",16,1,0)="^^3^3^2980330"
^DIC(9.4,42,22,7,"PAH",16,1,1,0)="This is Health Summary (GMTS) patch 24.  Please see the national patch"
^DIC(9.4,42,22,7,"PAH",16,1,2,0)="module for a complete description of the modifications included in this"
^DIC(9.4,42,22,7,"PAH",16,1,3,0)="patch."
^DIC(9.4,42,22,7,"PAH",17,0)="27 SEQ #22^2980417^1"
