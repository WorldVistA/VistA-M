^DIC(9.4,77,22,0)="^9.49I^17^2"
^DIC(9.4,77,22,16,0)="4.5^2941006^2960718"
^DIC(9.4,77,22,16,"PAH",0)="^9.4901^40^40"
^DIC(9.4,77,22,16,"PAH",1,0)="30^2970221^1"
^DIC(9.4,77,22,16,"PAH",1,1,0)="^^14^14^2970221"
^DIC(9.4,77,22,16,"PAH",1,1,1,0)="This build includes changes to address problems where Provider"
^DIC(9.4,77,22,16,"PAH",1,1,2,0)="Comments were being inappropriately copied from one order to another."
^DIC(9.4,77,22,16,"PAH",1,1,3,0)=" "
^DIC(9.4,77,22,16,"PAH",1,1,4,0)="Changes are included in PSIVORA1 to prevent the variable ON55 from"
^DIC(9.4,77,22,16,"PAH",1,1,5,0)="remaining in the partition after taking action on an IV Fluid order"
^DIC(9.4,77,22,16,"PAH",1,1,6,0)="through OE/RR 2.5. This allowed the Provider Comments from the order"
^DIC(9.4,77,22,16,"PAH",1,1,7,0)="defined by ON55 to be copied into new orders under certain conditions."
^DIC(9.4,77,22,16,"PAH",1,1,8,0)=" "
^DIC(9.4,77,22,16,"PAH",1,1,9,0)="Changes are included in PSGMIV, PSGMMIV, PSGMMIVC, and PSJMIV to prevent"
^DIC(9.4,77,22,16,"PAH",1,1,10,0)="the Provider Comments from a recently edited order from being added to an"
^DIC(9.4,77,22,16,"PAH",1,1,11,0)="order currently being edited. This would occur only if the user edited an"
^DIC(9.4,77,22,16,"PAH",1,1,12,0)="order containing Provider Comments, queued an MAR that included that"
^DIC(9.4,77,22,16,"PAH",1,1,13,0)="order, and then edited another order at the exact moment when the 1st"
^DIC(9.4,77,22,16,"PAH",1,1,14,0)="order is printed on the MAR."
^DIC(9.4,77,22,16,"PAH",2,0)="31^2970417^1"
^DIC(9.4,77,22,16,"PAH",2,1,0)="^^11^11^2970417"
^DIC(9.4,77,22,16,"PAH",2,1,1,0)="Partial DD's for ATC CANISTER field 212 of Drug file (#50) and sub-fields"
^DIC(9.4,77,22,16,"PAH",2,1,2,0)=".01 (WARD GROUP FOR ATC CANISTER) and 1 (ATC CANISTER), QUICK CODE field 6"
^DIC(9.4,77,22,16,"PAH",2,1,3,0)="of IV Additives file (#52.6) sub field 6 USUAL IV SOLUTION, and AVERAGE"
^DIC(9.4,77,22,16,"PAH",2,1,4,0)="DRUG COST field 7 of IV Solutions file (#52.7)."
^DIC(9.4,77,22,16,"PAH",2,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",2,1,6,0)="The changes to Drug file (#50) are for NOIS BRK-0197-10549 and"
^DIC(9.4,77,22,16,"PAH",2,1,7,0)="NAS-0197-30947."
^DIC(9.4,77,22,16,"PAH",2,1,8,0)=" "
^DIC(9.4,77,22,16,"PAH",2,1,9,0)="The changes to IV Additives file (#52.6) are for NOIS NCH-0496-40049."
^DIC(9.4,77,22,16,"PAH",2,1,10,0)=" "
^DIC(9.4,77,22,16,"PAH",2,1,11,0)="The changes to IV Solutions file (#52.7) are for NOIS CLE-0696-41676."
^DIC(9.4,77,22,16,"PAH",3,0)="32^2970417^1"
^DIC(9.4,77,22,16,"PAH",3,1,0)="^^24^24^2970417"
^DIC(9.4,77,22,16,"PAH",3,1,1,0)="This build will fix the problems reported below:"
^DIC(9.4,77,22,16,"PAH",3,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",3,1,3,0)="1) Extra Units Dispensed Report [PSJU EUDD] including information outside"
^DIC(9.4,77,22,16,"PAH",3,1,4,0)="of the date range. (MGY-0996-31463)"
^DIC(9.4,77,22,16,"PAH",3,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",3,1,6,0)="2) Unable to enter units dispensed using Enter Units Dispensed [PSJU PLDP]"
^DIC(9.4,77,22,16,"PAH",3,1,7,0)="for pick lists with a future start date/time when all pick list except"
^DIC(9.4,77,22,16,"PAH",3,1,8,0)="ones with a future start date/time have been filed away. (LAK-0696-30468)"
^DIC(9.4,77,22,16,"PAH",3,1,9,0)=" "
^DIC(9.4,77,22,16,"PAH",3,1,10,0)="3) Divide by Zero error at MN+1^PSGPL0. This error occurs"
^DIC(9.4,77,22,16,"PAH",3,1,11,0)="when field #42 (FREQUENCY) of the sub file Unit Dose (#55.06) of"
^DIC(9.4,77,22,16,"PAH",3,1,12,0)="the Pharmacy Patient File (#55) is a zero. (CON-0796-10063,"
^DIC(9.4,77,22,16,"PAH",3,1,13,0)="WHC-0795-10480)"
^DIC(9.4,77,22,16,"PAH",3,1,14,0)=" "
^DIC(9.4,77,22,16,"PAH",3,1,15,0)="4) Pick List hangs when sent to ATC.  The site has the parameter ATC SORT"
^DIC(9.4,77,22,16,"PAH",3,1,16,0)="PARAMETER=ADMIN TIME, the orders causing the pick list to hang are orders"
^DIC(9.4,77,22,16,"PAH",3,1,17,0)="with a schedule type of On Call which have no admin times."
^DIC(9.4,77,22,16,"PAH",3,1,18,0)="(WNY-0197-12396)"
^DIC(9.4,77,22,16,"PAH",3,1,19,0)=" "
^DIC(9.4,77,22,16,"PAH",3,1,20,0)="5) Pick List not calculating correct units needed when orders have a"
^DIC(9.4,77,22,16,"PAH",3,1,21,0)="non-standard schedule (e.g. QAM&NOON). (CTX-0996-70760, NCH-0197-42095)"
^DIC(9.4,77,22,16,"PAH",3,1,22,0)="Another problem reported was when the schedule q.0.d was entered, where"
^DIC(9.4,77,22,16,"PAH",3,1,23,0)="zero is entered instead of the letter o, the software would get stuck in a"
^DIC(9.4,77,22,16,"PAH",3,1,24,0)="loop. (MAT-1294-70289)"
^DIC(9.4,77,22,16,"PAH",4,0)="34 SEQ #33^2970417^1"
^DIC(9.4,77,22,16,"PAH",4,1,0)="^^10^10^2970417"
^DIC(9.4,77,22,16,"PAH",4,1,1,0)="This patch will correct the problems reported below:"
^DIC(9.4,77,22,16,"PAH",4,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",4,1,3,0)="1)  Use @0, but scheduled labels still print on renewed orders."
^DIC(9.4,77,22,16,"PAH",4,1,4,0)="    (SFC-0296-61455)"
^DIC(9.4,77,22,16,"PAH",4,1,5,0)="2)  Additive in wrong bottle on labels. (BAY-1095-32359, GAI-0196-31585,"
^DIC(9.4,77,22,16,"PAH",4,1,6,0)="    ANN-0895-40322)"
^DIC(9.4,77,22,16,"PAH",4,1,7,0)="3)  Q36 IVPB gives labels 12-36-12-36 schedule. (FAR-0596-40861,"
^DIC(9.4,77,22,16,"PAH",4,1,8,0)="    ATG-0796-32093)"
^DIC(9.4,77,22,16,"PAH",4,1,9,0)="4)  Incorrect information printing on label. (FRE-0896-60620,"
^DIC(9.4,77,22,16,"PAH",4,1,10,0)="    BAY-0596-31907)"
^DIC(9.4,77,22,16,"PAH",5,0)="35 SEQ #34^2970417^1"
^DIC(9.4,77,22,16,"PAH",5,1,0)="^^4^4^2970417"
^DIC(9.4,77,22,16,"PAH",5,1,1,0)="This patch will correct the problem where Inpatient Medication orders"
^DIC(9.4,77,22,16,"PAH",5,1,2,0)="for a patient were not D/C'd when the patient was admitted to the"
^DIC(9.4,77,22,16,"PAH",5,1,3,0)="hospital, if the patient had never been admitted before.  (HUN-0197-21624,"
^DIC(9.4,77,22,16,"PAH",5,1,4,0)="SFC-0297-61806)"
^DIC(9.4,77,22,16,"PAH",6,0)="38 SEQ #35^2970625^1"
^DIC(9.4,77,22,16,"PAH",6,1,0)="^^23^23^2970625"
^DIC(9.4,77,22,16,"PAH",6,1,1,0)="This patch will remove the references to the following files:"
^DIC(9.4,77,22,16,"PAH",6,1,2,0)="PROVIDER (#16)"
^DIC(9.4,77,22,16,"PAH",6,1,3,0)="PERSON (#6)"
^DIC(9.4,77,22,16,"PAH",6,1,4,0)="USER (#3)"
^DIC(9.4,77,22,16,"PAH",6,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",6,1,6,0)="Once this patch is installed the option [PSJV PROVIDER PRINT] Active"
^DIC(9.4,77,22,16,"PAH",6,1,7,0)="Provider Report will no longer be available.  This option was provided to"
^DIC(9.4,77,22,16,"PAH",6,1,8,0)="assist sites in making the transition from using the PROVIDER file (#6) to"
^DIC(9.4,77,22,16,"PAH",6,1,9,0)="using the NEW PERSON file (#200) by identifying providers from file 6 and"
^DIC(9.4,77,22,16,"PAH",6,1,10,0)="listing their inactivation date from file 6, inactivation date from file"
^DIC(9.4,77,22,16,"PAH",6,1,11,0)="200, and if the provider was authorized to write med. orders in file 200."
^DIC(9.4,77,22,16,"PAH",6,1,12,0)=" "
^DIC(9.4,77,22,16,"PAH",6,1,13,0)="ROUTINE SUMMARY:"
^DIC(9.4,77,22,16,"PAH",6,1,14,0)="================"
^DIC(9.4,77,22,16,"PAH",6,1,15,0)=" "
^DIC(9.4,77,22,16,"PAH",6,1,16,0)="The following routines are included in this patch.  The second line"
^DIC(9.4,77,22,16,"PAH",6,1,17,0)="of these routines will look like:"
^DIC(9.4,77,22,16,"PAH",6,1,18,0)=" "
^DIC(9.4,77,22,16,"PAH",6,1,19,0)="  ;;4.5; Inpatient Medications ;**[patch list]**;7 OCT 94"
^DIC(9.4,77,22,16,"PAH",6,1,20,0)=" "
^DIC(9.4,77,22,16,"PAH",6,1,21,0)="Routine Name       Before Patch        After Patch     Patch List"
^DIC(9.4,77,22,16,"PAH",6,1,22,0)=" PSGDCCM            3084929             2683467           38"
^DIC(9.4,77,22,16,"PAH",6,1,23,0)=" PSJPRE49           6565728             1604873           38"
^DIC(9.4,77,22,16,"PAH",7,0)="39 SEQ #36^2970708^1"
^DIC(9.4,77,22,16,"PAH",7,1,0)="^^6^6^2970708"
^DIC(9.4,77,22,16,"PAH",7,1,1,0)="This build will fix the problems reported below:"
^DIC(9.4,77,22,16,"PAH",7,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",7,1,3,0)=" 1) A problem was reported after the installation of patch PSJ*4.5*34"
^DIC(9.4,77,22,16,"PAH",7,1,4,0)="    where the OE/RR pointer was not updated when an active IV order was"
^DIC(9.4,77,22,16,"PAH",7,1,5,0)="    edited so that a new IV order was created.  The new IV order retained"
^DIC(9.4,77,22,16,"PAH",7,1,6,0)="    the OE/RR pointer from the edited order."
^DIC(9.4,77,22,16,"PAH",8,0)="40 SEQ #37^2971021^1"
^DIC(9.4,77,22,16,"PAH",8,1,0)="^^8^8^2971021"
^DIC(9.4,77,22,16,"PAH",8,1,1,0)="Associated Patches: (v)OR*2.5*52.  Needs to be installed prior to"
^DIC(9.4,77,22,16,"PAH",8,1,2,0)="installation of PSJ*4.5*40."
^DIC(9.4,77,22,16,"PAH",8,1,3,0)=" "
^DIC(9.4,77,22,16,"PAH",8,1,4,0)="This build will fix the problem reported below:"
^DIC(9.4,77,22,16,"PAH",8,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",8,1,6,0)="1) The site reported changing the Requesting Clinician on a Pharmacy IV"
^DIC(9.4,77,22,16,"PAH",8,1,7,0)="order, however the order retained the original requesting clinician's name"
^DIC(9.4,77,22,16,"PAH",8,1,8,0)="as the requestor.  (NOIS: WPB-0597-32252)"
^DIC(9.4,77,22,16,"PAH",9,0)="33 SEQ #38^2971021^1"
^DIC(9.4,77,22,16,"PAH",9,1,0)="^^6^6^2971021"
^DIC(9.4,77,22,16,"PAH",9,1,1,0)="This build will fix the problem reported below:"
^DIC(9.4,77,22,16,"PAH",9,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",9,1,3,0)=" Start and stop dates not calculating correctly when user goes to finish"
^DIC(9.4,77,22,16,"PAH",9,1,4,0)="pending orders. Orders were placed through OE/RR between 23:00 and 01:00"
^DIC(9.4,77,22,16,"PAH",9,1,5,0)="and default start date/time for the wards was set to closest admin time or"
^DIC(9.4,77,22,16,"PAH",9,1,6,0)="next admin time."
^DIC(9.4,77,22,16,"PAH",10,0)="36 SEQ #39^2971021^1"
^DIC(9.4,77,22,16,"PAH",10,1,0)="^^5^5^2971021"
^DIC(9.4,77,22,16,"PAH",10,1,1,0)="A problem has been reported where an Inpatient IV order was d/c'd and then"
^DIC(9.4,77,22,16,"PAH",10,1,2,0)="a new IV Fluid order was placed and the provider comments from the"
^DIC(9.4,77,22,16,"PAH",10,1,3,0)="d/c'd order were showing up in the order text of the new order."
^DIC(9.4,77,22,16,"PAH",10,1,4,0)=" "
^DIC(9.4,77,22,16,"PAH",10,1,5,0)="This patch will correct this problem."
^DIC(9.4,77,22,16,"PAH",11,0)="44 SEQ #40^2971021^1"
^DIC(9.4,77,22,16,"PAH",11,1,0)="^^9^9^2971021"
^DIC(9.4,77,22,16,"PAH",11,1,1,0)="In order for Drug Accountability/Inventory Interface (DA) to collect Unit"
^DIC(9.4,77,22,16,"PAH",11,1,2,0)="Dose dispensing, returns, extras, and pre-exchange needs data from"
^DIC(9.4,77,22,16,"PAH",11,1,3,0)="Inpatient Medications the routines included in this patch had to be"
^DIC(9.4,77,22,16,"PAH",11,1,4,0)="modified to call the DA routine EN^PSAPSI5. This functionality did not"
^DIC(9.4,77,22,16,"PAH",11,1,5,0)="exist in v2.0 of DA.  This patch should be installed prior to installation"
^DIC(9.4,77,22,16,"PAH",11,1,6,0)="of v3.0 of DA."
^DIC(9.4,77,22,16,"PAH",11,1,7,0)=" "
^DIC(9.4,77,22,16,"PAH",11,1,8,0)="All sites should install this patch.  Drug Accountability/Inventory"
^DIC(9.4,77,22,16,"PAH",11,1,9,0)="Interface v3.0 is not required to install this patch."
^DIC(9.4,77,22,16,"PAH",12,0)="37 SEQ #41^2971118^1"
^DIC(9.4,77,22,16,"PAH",12,1,0)="^^12^12^2971118"
^DIC(9.4,77,22,16,"PAH",12,1,1,0)=" NOIS: REN-0397-60175 reported the following problems: "
^DIC(9.4,77,22,16,"PAH",12,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",12,1,3,0)="1. If an IV order has only one solution and no additive, the admin time "
^DIC(9.4,77,22,16,"PAH",12,1,4,0)="   does not print on the 24 Hour MAR.  "
^DIC(9.4,77,22,16,"PAH",12,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",12,1,6,0)="2. The 24 Hour MAR printed an admin time on the wrong date for orders with"
^DIC(9.4,77,22,16,"PAH",12,1,7,0)="   day of week schedule (MO-FR).  "
^DIC(9.4,77,22,16,"PAH",12,1,8,0)=" "
^DIC(9.4,77,22,16,"PAH",12,1,9,0)="3. The 7 Day MAR did not print the **** on the date not to be given for "
^DIC(9.4,77,22,16,"PAH",12,1,10,0)="   orders with a day of week schedule (MO-FR).  "
^DIC(9.4,77,22,16,"PAH",12,1,11,0)=" "
^DIC(9.4,77,22,16,"PAH",12,1,12,0)="This patch will correct these problems.  "
^DIC(9.4,77,22,16,"PAH",13,0)="43 SEQ #42^2971218^1"
^DIC(9.4,77,22,16,"PAH",13,1,0)="^^12^12^2971218"
^DIC(9.4,77,22,16,"PAH",13,1,1,0)="The ""APSJD"" cross-reference on DATE OF DEATH field (#.351) of the PATIENT"
^DIC(9.4,77,22,16,"PAH",13,1,2,0)="file (#2) calls routine PSJADT, which leaves the local variable D0"
^DIC(9.4,77,22,16,"PAH",13,1,3,0)="undefined.  The San Francisco Office of the Chief Information Officer"
^DIC(9.4,77,22,16,"PAH",13,1,4,0)="(OCIO) Field Office requested that D0, D1, and D2 be added to the list of"
^DIC(9.4,77,22,16,"PAH",13,1,5,0)="variables NEWed at line END+1."
^DIC(9.4,77,22,16,"PAH",13,1,6,0)=" "
^DIC(9.4,77,22,16,"PAH",13,1,7,0)="The FileMan compatibility issue centers around the variable D0 being"
^DIC(9.4,77,22,16,"PAH",13,1,8,0)="defined.  Cross-references may set D0 equal to DA but should not otherwise"
^DIC(9.4,77,22,16,"PAH",13,1,9,0)="alter ordelete D0.  This issue has not been documented in the past but"
^DIC(9.4,77,22,16,"PAH",13,1,10,0)="surfaced with the Merge testing."
^DIC(9.4,77,22,16,"PAH",13,1,11,0)=" "
^DIC(9.4,77,22,16,"PAH",13,1,12,0)="Merge is tentatively scheduled for national release in August, 1997."
^DIC(9.4,77,22,16,"PAH",14,0)="45 SEQ #43^2971218^1"
^DIC(9.4,77,22,16,"PAH",14,1,0)="^^3^3^2971218"
^DIC(9.4,77,22,16,"PAH",14,1,1,0)="Inpatient Medications is updating the use of it's call to ^GMRADPT to look"
^DIC(9.4,77,22,16,"PAH",14,1,2,0)="at piece G instead of piece C for type of reaction, to be in compliance"
^DIC(9.4,77,22,16,"PAH",14,1,3,0)="with the supported call. Piece C is no longer supported after 9/1/97."
^DIC(9.4,77,22,16,"PAH",15,0)="48 SEQ #44^2971218^1"
^DIC(9.4,77,22,16,"PAH",15,1,0)="^^6^6^2971218"
^DIC(9.4,77,22,16,"PAH",15,1,1,0)="A problem was reported where a site was getting an undefined error at"
^DIC(9.4,77,22,16,"PAH",15,1,2,0)="DCOR+2^PSGOECS.  The problem occurs because the code is not checking for"
^DIC(9.4,77,22,16,"PAH",15,1,3,0)="the variable PSGORD to contain an ""O"" and being routed to the wrong file"
^DIC(9.4,77,22,16,"PAH",15,1,4,0)="to check for the order."
^DIC(9.4,77,22,16,"PAH",15,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",15,1,6,0)="This patch corrects this problem"
^DIC(9.4,77,22,16,"PAH",16,0)="41 SEQ #45^2980120^1"
^DIC(9.4,77,22,16,"PAH",16,1,0)="^^15^15^2980120"
^DIC(9.4,77,22,16,"PAH",16,1,1,0)=" 1. A problem was discovered during the installation of Inpatient"
^DIC(9.4,77,22,16,"PAH",16,1,2,0)="Medications V. 5.0 at a test site where IV orders had a status of DC'ed in"
^DIC(9.4,77,22,16,"PAH",16,1,3,0)="Pharmacy, but had a future stop date and a status of active in Order"
^DIC(9.4,77,22,16,"PAH",16,1,4,0)="Entry/Results Reporting (OE/RR). This was found to be the result of a call"
^DIC(9.4,77,22,16,"PAH",16,1,5,0)="made to DCOR^PSIVACT by the Surgery package.  There is an existing"
^DIC(9.4,77,22,16,"PAH",16,1,6,0)="integration agreement with Surgery to allow them to call this entry point."
^DIC(9.4,77,22,16,"PAH",16,1,7,0)="However, the entry point was never updated to call OE/RR to change the"
^DIC(9.4,77,22,16,"PAH",16,1,8,0)="order's stop date and status."
^DIC(9.4,77,22,16,"PAH",16,1,9,0)=" "
^DIC(9.4,77,22,16,"PAH",16,1,10,0)=" 2. An additional problem was discovered at one of our V. 5.0 test sites."
^DIC(9.4,77,22,16,"PAH",16,1,11,0)="When a patient had only IV orders and these orders were auto discontinued"
^DIC(9.4,77,22,16,"PAH",16,1,12,0)="due to a patient movement and the movement was later deleted, the IV"
^DIC(9.4,77,22,16,"PAH",16,1,13,0)="orders were not auto reinstated."
^DIC(9.4,77,22,16,"PAH",16,1,14,0)=" "
^DIC(9.4,77,22,16,"PAH",16,1,15,0)=" This patch will correct these problems."
^DIC(9.4,77,22,16,"PAH",17,0)="46^2980129^1"
^DIC(9.4,77,22,16,"PAH",17,1,0)="^^13^13^2980129"
^DIC(9.4,77,22,16,"PAH",17,1,1,0)="A problem was reported with the default Start/Stop date/time on IV"
^DIC(9.4,77,22,16,"PAH",17,1,2,0)="orders logged in between midnight and 12:30AM.  On an order with a"
^DIC(9.4,77,22,16,"PAH",17,1,3,0)="schedule of NOW that was logged in at 00:09 the Start Date and the Stop"
^DIC(9.4,77,22,16,"PAH",17,1,4,0)="Date showed 1699 for the default.  On an order with a schedule of Q6HR"
^DIC(9.4,77,22,16,"PAH",17,1,5,0)="that was logged in at 00:10 the Start Date showed a default of 1699 and"
^DIC(9.4,77,22,16,"PAH",17,1,6,0)="the Stop Date showed a default of JAN 7,1841 24:00."
^DIC(9.4,77,22,16,"PAH",17,1,7,0)=" "
^DIC(9.4,77,22,16,"PAH",17,1,8,0)="When an order entered thru Order Entry by a Provider was finished by"
^DIC(9.4,77,22,16,"PAH",17,1,9,0)="pharmacy, the default Start Date came up as ""1699"" and the default Stop"
^DIC(9.4,77,22,16,"PAH",17,1,10,0)="Date was Jan 14, 1841  24:00. This error occurs when log in time is the"
^DIC(9.4,77,22,16,"PAH",17,1,11,0)="same as the admin time. "
^DIC(9.4,77,22,16,"PAH",17,1,12,0)=" "
^DIC(9.4,77,22,16,"PAH",17,1,13,0)="This patch corrects these problems."
^DIC(9.4,77,22,16,"PAH",18,0)="42 SEQ #47^2980129^1"
^DIC(9.4,77,22,16,"PAH",18,1,0)="^^4^4^2980129"
^DIC(9.4,77,22,16,"PAH",18,1,1,0)="This patch supports OR*2.5*49, which is the pre-release patch for"
^DIC(9.4,77,22,16,"PAH",18,1,2,0)="Computerized Patient Record System (CPRS) V. 1.0.  This patch provides"
^DIC(9.4,77,22,16,"PAH",18,1,3,0)="several entry points which are used by CPRS in their pre-release"
^DIC(9.4,77,22,16,"PAH",18,1,4,0)="patch."
^DIC(9.4,77,22,16,"PAH",19,0)="51 SEQ #48^2980205^1"
^DIC(9.4,77,22,16,"PAH",19,1,0)="^^15^15^2980205"
^DIC(9.4,77,22,16,"PAH",19,1,1,0)=" 1. A problem was discovered during the installation of Inpatient"
^DIC(9.4,77,22,16,"PAH",19,1,2,0)="Medications V. 5.0 at a test site where IV orders had a status of DC'ed in"
^DIC(9.4,77,22,16,"PAH",19,1,3,0)="Pharmacy, but had a future stop date and a status of active in Order"
^DIC(9.4,77,22,16,"PAH",19,1,4,0)="Entry/Results Reporting (OE/RR). This was found to be the result of a call"
^DIC(9.4,77,22,16,"PAH",19,1,5,0)="made to DCOR^PSIVACT by the Surgery package.  There is an existing"
^DIC(9.4,77,22,16,"PAH",19,1,6,0)="integration agreement with Surgery to allow them to call this entry point."
^DIC(9.4,77,22,16,"PAH",19,1,7,0)="However, the entry point was never updated to call OE/RR to change the"
^DIC(9.4,77,22,16,"PAH",19,1,8,0)="order's stop date and status."
^DIC(9.4,77,22,16,"PAH",19,1,9,0)=" "
^DIC(9.4,77,22,16,"PAH",19,1,10,0)=" 2. An additional problem was discovered at one of our V. 5.0 test sites."
^DIC(9.4,77,22,16,"PAH",19,1,11,0)="When a patient had only IV orders and these orders were auto discontinued"
^DIC(9.4,77,22,16,"PAH",19,1,12,0)="due to a patient movement and the movement was later deleted, the IV"
^DIC(9.4,77,22,16,"PAH",19,1,13,0)="orders were not auto reinstated."
^DIC(9.4,77,22,16,"PAH",19,1,14,0)=" "
^DIC(9.4,77,22,16,"PAH",19,1,15,0)=" This patch will correct these problems."
^DIC(9.4,77,22,16,"PAH",20,0)="47 SEQ #49^2980220^1"
^DIC(9.4,77,22,16,"PAH",20,1,0)="^^9^9^2980220"
^DIC(9.4,77,22,16,"PAH",20,1,1,0)="A problem was reported where when finishing an IV order the site was not"
^DIC(9.4,77,22,16,"PAH",20,1,2,0)="being prompted with all the fields that should have been available for"
^DIC(9.4,77,22,16,"PAH",20,1,3,0)="edit.  The problem was reported after the site installed Pharmacy Data"
^DIC(9.4,77,22,16,"PAH",20,1,4,0)="Management.  The problem was due to the routine PSIVORC2 looking at piece"
^DIC(9.4,77,22,16,"PAH",20,1,5,0)="11 of the zero node of the additive or solution to identify if the"
^DIC(9.4,77,22,16,"PAH",20,1,6,0)="additive or solution was marked for use with IV Fluid orders.  The routine"
^DIC(9.4,77,22,16,"PAH",20,1,7,0)="has been updated to look at piece 13."
^DIC(9.4,77,22,16,"PAH",20,1,8,0)=" "
^DIC(9.4,77,22,16,"PAH",20,1,9,0)="This patch corrects this problem"
^DIC(9.4,77,22,16,"PAH",21,0)="52 SEQ #50^2980220^1"
^DIC(9.4,77,22,16,"PAH",21,1,0)="^^5^5^2980220"
^DIC(9.4,77,22,16,"PAH",21,1,1,0)="A problem was reported at a site where when the physician used the"
^DIC(9.4,77,22,16,"PAH",21,1,2,0)="non-standard schedule of QH during order entry the system would hang"
^DIC(9.4,77,22,16,"PAH",21,1,3,0)="and IRM would have to go in and kill off the job."
^DIC(9.4,77,22,16,"PAH",21,1,4,0)=" "
^DIC(9.4,77,22,16,"PAH",21,1,5,0)="This patch will correct this problem."
^DIC(9.4,77,22,16,"PAH",22,0)="49 SEQ #51^2980318^1"
^DIC(9.4,77,22,16,"PAH",22,1,0)="^^17^17^2980318"
^DIC(9.4,77,22,16,"PAH",22,1,1,0)="A problem was reported where a site was seeing:"
^DIC(9.4,77,22,16,"PAH",22,1,2,0)="     "
^DIC(9.4,77,22,16,"PAH",22,1,3,0)="                     R X   A L L   O R D E R S                 12 orders"
^DIC(9.4,77,22,16,"PAH",22,1,4,0)="     "
^DIC(9.4,77,22,16,"PAH",22,1,5,0)="HUFF,PUFF   321-11-3322        1S/328-D     MAY 25,1945 (52)   Wt      "
^DIC(9.4,77,22,16,"PAH",22,1,6,0)="   Item Ordered                                               Start date"
^DIC(9.4,77,22,16,"PAH",22,1,7,0)="--------------------------------------------------------------------------"
^DIC(9.4,77,22,16,"PAH",22,1,8,0)="1 dc    NOT TO BE GIVEN                                       |12/19/97"
^DIC(9.4,77,22,16,"PAH",22,1,9,0)=" "
^DIC(9.4,77,22,16,"PAH",22,1,10,0)="This resulted from a pharmacy user choosing the dc'd order through"
^DIC(9.4,77,22,16,"PAH",22,1,11,0)="pharmacy options and at the ACTION (L N)? prompt choosing N.  Then the"
^DIC(9.4,77,22,16,"PAH",22,1,12,0)="user was prompted:"
^DIC(9.4,77,22,16,"PAH",22,1,13,0)=" DO YOU WANT TO MARK THIS ORDER AS 'NOT TO BE GIVEN'? No//."
^DIC(9.4,77,22,16,"PAH",22,1,14,0)="The user took the default of no, but the call to RETURN^ORX was still"
^DIC(9.4,77,22,16,"PAH",22,1,15,0)="made."
^DIC(9.4,77,22,16,"PAH",22,1,16,0)=" "
^DIC(9.4,77,22,16,"PAH",22,1,17,0)="This patch corrects this problem."
^DIC(9.4,77,22,16,"PAH",23,0)="53 SEQ #52^2980318^1"
^DIC(9.4,77,22,16,"PAH",23,1,0)="^^6^6^2980318"
^DIC(9.4,77,22,16,"PAH",23,1,1,0)="A problem was reported at a site where the initials of the person entering"
^DIC(9.4,77,22,16,"PAH",23,1,2,0)="an IV order would sometimes appear on the MAR and sometimes they would"
^DIC(9.4,77,22,16,"PAH",23,1,3,0)="not.  The IV orders were being entered by Technicians who did not hold the"
^DIC(9.4,77,22,16,"PAH",23,1,4,0)="PSJ RPHARM security key."
^DIC(9.4,77,22,16,"PAH",23,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",23,1,6,0)="This patch will correct this problem."
^DIC(9.4,77,22,16,"PAH",24,0)="54 SEQ #53^2980318^1"
^DIC(9.4,77,22,16,"PAH",24,1,0)="^^4^4^2980318"
^DIC(9.4,77,22,16,"PAH",24,1,1,0)="An Illegal or invalid argument error at EDIT+2^PSIVEDT was received by a"
^DIC(9.4,77,22,16,"PAH",24,1,2,0)="site."
^DIC(9.4,77,22,16,"PAH",24,1,3,0)=" "
^DIC(9.4,77,22,16,"PAH",24,1,4,0)="This patch will correct this problem."
^DIC(9.4,77,22,16,"PAH",25,0)="50 SEQ #54^2980330^1"
^DIC(9.4,77,22,16,"PAH",25,1,0)="^^1^1^2980330"
^DIC(9.4,77,22,16,"PAH",25,1,1,0)="This patch makes changes to address Y2K issues."
^DIC(9.4,77,22,16,"PAH",26,0)="55^2980430^1"
^DIC(9.4,77,22,16,"PAH",26,1,0)="^^18^18^2980430"
^DIC(9.4,77,22,16,"PAH",26,1,1,0)="When testing Y2K patch, noticed the following problem on Action profiles 1"
^DIC(9.4,77,22,16,"PAH",26,1,2,0)="and 2 (problem occurs on both Action profiles)."
^DIC(9.4,77,22,16,"PAH",26,1,3,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,4,0)="                            UNIT DOSE ACTION PROFILE #1            Page: 2"
^DIC(9.4,77,22,16,"PAH",26,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,6,0)="DOE,JOHN                                NNN-NN-NNNN     01/01/1965"
^DIC(9.4,77,22,16,"PAH",26,1,7,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,8,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,9,0)="No. Action     Drug                            ST Start Stop   Status/Info"
^DIC(9.4,77,22,16,"PAH",26,1,10,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,11,0)="- - - - - - - - - - - - - - - -A C T I V E - - - - - - - - - - - - - - - -"
^DIC(9.4,77,22,16,"PAH",26,1,12,0)="  1  R D N in 0.9% SODIUM CHLORIDE INJ  1000 ML 100 ml/hrC03/2503/28A"
^DIC(9.4,77,22,16,"PAH",26,1,13,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,14,0)="     "
^DIC(9.4,77,22,16,"PAH",26,1,15,0)="  2  R D N ACETAMINOPHEN TABLET                     C  03/25 04/08 A"
^DIC(9.4,77,22,16,"PAH",26,1,16,0)="             Give: 650MG PO Q6HR "
^DIC(9.4,77,22,16,"PAH",26,1,17,0)=" "
^DIC(9.4,77,22,16,"PAH",26,1,18,0)="Solution, schedule type, start and stop dates jams together."
^DIC(9.4,77,22,16,"PAH",27,0)="56^2980604^1"
^DIC(9.4,77,22,16,"PAH",27,1,0)="^^3^3^2980604"
^DIC(9.4,77,22,16,"PAH",27,1,1,0)="This patch will add the option PSJI IVCATEGORY back to the PSJI"
^DIC(9.4,77,22,16,"PAH",27,1,2,0)="SUPERVISOR's menu.  This option was inadvertently deleted with the"
^DIC(9.4,77,22,16,"PAH",27,1,3,0)="install of PHARMACY DATA MANAGEMENT (PDM) V. 1.0."
^DIC(9.4,77,22,16,"PAH",28,0)="57^2980618^1"
^DIC(9.4,77,22,16,"PAH",28,1,0)="^^3^3^2980618"
^DIC(9.4,77,22,16,"PAH",28,1,1,0)="A problem was reported with the Action Profile #1 where if the patient had"
^DIC(9.4,77,22,16,"PAH",28,1,2,0)="5-6 active orders no lines for Additional Medication Orders were printed."
^DIC(9.4,77,22,16,"PAH",28,1,3,0)="This patch corrects this problem."
^DIC(9.4,77,22,16,"PAH",29,0)="58^2980712^1"
^DIC(9.4,77,22,16,"PAH",29,1,0)="^^4^4^2980712"
^DIC(9.4,77,22,16,"PAH",29,1,1,0)="A problem was reported with the report generated by the option [PSJ PDV]"
^DIC(9.4,77,22,16,"PAH",29,1,2,0)="Patients on Specific Drug(s).  If the name of the first drug in the order"
^DIC(9.4,77,22,16,"PAH",29,1,3,0)="was longer than 34 characters it would cause the name, start date, and"
^DIC(9.4,77,22,16,"PAH",29,1,4,0)="stop date columns of data to jam together."
^DIC(9.4,77,22,16,"PAH",30,0)="59^2980923^1"
^DIC(9.4,77,22,16,"PAH",30,1,0)="^^2^2^2980923"
^DIC(9.4,77,22,16,"PAH",30,1,1,0)="This patch is designed to make use of the Application Programmer"
^DIC(9.4,77,22,16,"PAH",30,1,2,0)="Interfaces (APIs) provided by the National Drug file (NDF) application."
^DIC(9.4,77,22,16,"PAH",31,0)="61 SEQ #60^2981007^1"
^DIC(9.4,77,22,16,"PAH",31,1,0)="^^5^5^2981007"
^DIC(9.4,77,22,16,"PAH",31,1,1,0)="Pharmacy Data Management (PDM) creates the ""AUDS"" cross-reference on the"
^DIC(9.4,77,22,16,"PAH",31,1,2,0)="START DATE/TIME field (#10) of the UNIT DOSE subfile (#55.06) of the"
^DIC(9.4,77,22,16,"PAH",31,1,3,0)="PHARMACY PATIENT file (#55).  This patch will ensure that cross-reference"
^DIC(9.4,77,22,16,"PAH",31,1,4,0)="is set when new Unit Dose orders are created and re-index the ""AUDS"""
^DIC(9.4,77,22,16,"PAH",31,1,5,0)="cross-reference for existing orders."
^DIC(9.4,77,22,16,"PAH",32,0)="60 SEQ #61^2981007^1"
^DIC(9.4,77,22,16,"PAH",32,1,0)="^^4^4^2981007"
^DIC(9.4,77,22,16,"PAH",32,1,1,0)="In the routine PSGBRJ, in the section which kills off old labels,"
^DIC(9.4,77,22,16,"PAH",32,1,2,0)="the variable which checks for the type of order was only being set to a 1"
^DIC(9.4,77,22,16,"PAH",32,1,3,0)="or a 2 so IV orders were not being checked to see if old labels should"
^DIC(9.4,77,22,16,"PAH",32,1,4,0)="be killed. This patch corrects this problem."
^DIC(9.4,77,22,16,"PAH",33,0)="64 SEQ #62^2981214^1"
^DIC(9.4,77,22,16,"PAH",33,1,0)="^^23^23^2981214"
^DIC(9.4,77,22,16,"PAH",33,1,1,0)="This patch adds functionality requested in E3R #9551.    "
^DIC(9.4,77,22,16,"PAH",33,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",33,1,3,0)=" When the Patient Information Management System (PIMS) deletes a"
^DIC(9.4,77,22,16,"PAH",33,1,4,0)="patient movement, the medication orders that were discontinued due to the"
^DIC(9.4,77,22,16,"PAH",33,1,5,0)="deletion are automatically reinstated.  A mail message will be sent to"
^DIC(9.4,77,22,16,"PAH",33,1,6,0)="notify affected parties that a patient's medications have been"
^DIC(9.4,77,22,16,"PAH",33,1,7,0)="reinstated. Inpatient Medications V. 4.5 has been modified to include"
^DIC(9.4,77,22,16,"PAH",33,1,8,0)="this functionality."
^DIC(9.4,77,22,16,"PAH",33,1,9,0)="     "
^DIC(9.4,77,22,16,"PAH",33,1,10,0)="* A mail group named PSJ-ORDERS REINSTATED is created by the patch KIDS"
^DIC(9.4,77,22,16,"PAH",33,1,11,0)="build.  The members of this mail group should be providers, nurses,"
^DIC(9.4,77,22,16,"PAH",33,1,12,0)="pharmacist, etc. who need  patient's medication orders have been"
^DIC(9.4,77,22,16,"PAH",33,1,13,0)="automatically reinstated. "
^DIC(9.4,77,22,16,"PAH",33,1,14,0)=" "
^DIC(9.4,77,22,16,"PAH",33,1,15,0)="*  When the medication orders are automatically reinstated due to deletion"
^DIC(9.4,77,22,16,"PAH",33,1,16,0)="of a patient movement, a mail message will be sent to the PSJ-ORDERS"
^DIC(9.4,77,22,16,"PAH",33,1,17,0)="REINSTATED mail group."
^DIC(9.4,77,22,16,"PAH",33,1,18,0)=" "
^DIC(9.4,77,22,16,"PAH",33,1,19,0)="*  The mail message will contain the patient's name, last four digits of"
^DIC(9.4,77,22,16,"PAH",33,1,20,0)="the patient's social security number, current ward location, reason the"
^DIC(9.4,77,22,16,"PAH",33,1,21,0)="orders were reinstated, and a list of orders that were reinstated. The"
^DIC(9.4,77,22,16,"PAH",33,1,22,0)="orders will be listed in the mail message in exact format as a patient"
^DIC(9.4,77,22,16,"PAH",33,1,23,0)="profile."
^DIC(9.4,77,22,16,"PAH",34,0)="65 SEQ #63^2981214^1"
^DIC(9.4,77,22,16,"PAH",34,1,0)="^^18^18^2981214"
^DIC(9.4,77,22,16,"PAH",34,1,1,0)="Decision Support System (DSS) software has made provisions for inclusion"
^DIC(9.4,77,22,16,"PAH",34,1,2,0)="of the stop code field from outpatient clinic's intravenous dispensing"
^DIC(9.4,77,22,16,"PAH",34,1,3,0)="when it is available.  The stop code is derived by DSS from the clinic"
^DIC(9.4,77,22,16,"PAH",34,1,4,0)="location field.  Inpatient Medications V. 4.5 is being modified to pass"
^DIC(9.4,77,22,16,"PAH",34,1,5,0)="the clinic location field to DSS."
^DIC(9.4,77,22,16,"PAH",34,1,6,0)=" "
^DIC(9.4,77,22,16,"PAH",34,1,7,0)="The Inpatient Medications software currently passes intravenous dispensing"
^DIC(9.4,77,22,16,"PAH",34,1,8,0)="data to DSS for DSS extraction, but does not include the clinic location"
^DIC(9.4,77,22,16,"PAH",34,1,9,0)="field.  The passing of this data occurs when an IV label is printed or it"
^DIC(9.4,77,22,16,"PAH",34,1,10,0)="is returned after the label is printed."
^DIC(9.4,77,22,16,"PAH",34,1,11,0)=" "
^DIC(9.4,77,22,16,"PAH",34,1,12,0)="DSS loads this data into a DSS file for later extraction by the vendor."
^DIC(9.4,77,22,16,"PAH",34,1,13,0)="With the installation of this patch, Inpatient Medications V. 4.5 will"
^DIC(9.4,77,22,16,"PAH",34,1,14,0)="begin prompting for the CLINIC LOCATION for Outpatient IV orders entered"
^DIC(9.4,77,22,16,"PAH",34,1,15,0)="from the Inpatient Medications package, storing the clinic location with"
^DIC(9.4,77,22,16,"PAH",34,1,16,0)="the order as it is entered through either Order Entry/Results Reporting"
^DIC(9.4,77,22,16,"PAH",34,1,17,0)="(OE/RR) or Inpatient Medications, and passing this data, when available,"
^DIC(9.4,77,22,16,"PAH",34,1,18,0)="to DSS."
^DIC(9.4,77,22,16,"PAH",35,0)="62 SEQ #64^2990119^1"
^DIC(9.4,77,22,16,"PAH",35,1,0)="^^37^37^2990119"
^DIC(9.4,77,22,16,"PAH",35,1,1,0)="Currently the 7 and 14 day MARs assume a year in the future when the"
^DIC(9.4,77,22,16,"PAH",35,1,2,0)="date is entered as shown below:"
^DIC(9.4,77,22,16,"PAH",35,1,3,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,4,0)="Select Reports Menu Option:  7 Day MAR"
^DIC(9.4,77,22,16,"PAH",35,1,5,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,6,0)="Print BLANK MARs? No//   (No)"
^DIC(9.4,77,22,16,"PAH",35,1,7,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,8,0)="Select TYPE OF SHEETS TO PRINT: BOTH// "
^DIC(9.4,77,22,16,"PAH",35,1,9,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,10,0)="Enter START DATE/TIME for 7 day MAR: 1 1 97  (JAN 01, 2097)"
^DIC(9.4,77,22,16,"PAH",35,1,11,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,12,0)="Select Reports Menu Option: 14  14 Day MAR"
^DIC(9.4,77,22,16,"PAH",35,1,13,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,14,0)="Print BLANK MARs? No//   (No)"
^DIC(9.4,77,22,16,"PAH",35,1,15,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,16,0)="Select TYPE OF SHEETS TO PRINT: BOTH// "
^DIC(9.4,77,22,16,"PAH",35,1,17,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,18,0)="Enter START DATE/TIME for 14 day MAR: 1 1 97  (JAN 01, 2097)"
^DIC(9.4,77,22,16,"PAH",35,1,19,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,20,0)="After this patch is installed the date will be returned as a date in the"
^DIC(9.4,77,22,16,"PAH",35,1,21,0)="current century:"
^DIC(9.4,77,22,16,"PAH",35,1,22,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,23,0)="Select Reports Menu Option: 7  7 Day MAR"
^DIC(9.4,77,22,16,"PAH",35,1,24,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,25,0)="Print BLANK MARs? No//   (No)"
^DIC(9.4,77,22,16,"PAH",35,1,26,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,27,0)="Select TYPE OF SHEETS TO PRINT: BOTH// "
^DIC(9.4,77,22,16,"PAH",35,1,28,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,29,0)="Enter START DATE/TIME for 7 day MAR: 1 1 97  (JAN 01, 1997)"
^DIC(9.4,77,22,16,"PAH",35,1,30,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,31,0)="Select Reports Menu Option: 14  14 Day MAR"
^DIC(9.4,77,22,16,"PAH",35,1,32,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,33,0)="Print BLANK MARs? No//   (No)"
^DIC(9.4,77,22,16,"PAH",35,1,34,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,35,0)="Select TYPE OF SHEETS TO PRINT: BOTH// "
^DIC(9.4,77,22,16,"PAH",35,1,36,0)=" "
^DIC(9.4,77,22,16,"PAH",35,1,37,0)="Enter START DATE/TIME for 14 day MAR: 1 1 97  (JAN 01, 1997)"
^DIC(9.4,77,22,16,"PAH",36,0)="63 SEQ #65^2990201^1"
^DIC(9.4,77,22,16,"PAH",36,1,0)="^^4^4^2990201"
^DIC(9.4,77,22,16,"PAH",36,1,1,0)="A problem was reported where orders entered, verified, and placed on hold"
^DIC(9.4,77,22,16,"PAH",36,1,2,0)="by the nurse that were then taken off hold by the pharmacist were being"
^DIC(9.4,77,22,16,"PAH",36,1,3,0)="automatically verified at that time even though the pharmacist didn't have"
^DIC(9.4,77,22,16,"PAH",36,1,4,0)="auto verify on.  This patch corrects this problem."
^DIC(9.4,77,22,16,"PAH",37,0)="66^2990201^1"
^DIC(9.4,77,22,16,"PAH",37,1,0)="^^9^9^2990201"
^DIC(9.4,77,22,16,"PAH",37,1,1,0)="This patch adds functionality requested in E3R 11366.    "
^DIC(9.4,77,22,16,"PAH",37,1,2,0)=" "
^DIC(9.4,77,22,16,"PAH",37,1,3,0)="The institution name has been added to the following reports:"
^DIC(9.4,77,22,16,"PAH",37,1,4,0)="       7 Day MAR"
^DIC(9.4,77,22,16,"PAH",37,1,5,0)="       14 Day MAR"
^DIC(9.4,77,22,16,"PAH",37,1,6,0)="       24 Hour MAR"
^DIC(9.4,77,22,16,"PAH",37,1,7,0)="       Action Profile #1"
^DIC(9.4,77,22,16,"PAH",37,1,8,0)="       Action Profile #2"
^DIC(9.4,77,22,16,"PAH",37,1,9,0)="       Patient Profile (Extended)"
^DIC(9.4,77,22,16,"PAH",38,0)="67^2990210^1"
^DIC(9.4,77,22,16,"PAH",38,1,0)="^^2^2^2990210"
^DIC(9.4,77,22,16,"PAH",38,1,1,0)="This patch corrects an undefined error that could occur when orders were"
^DIC(9.4,77,22,16,"PAH",38,1,2,0)="auto-reinstated due to a movement being deleted."
^DIC(9.4,77,22,16,"PAH",39,0)="68 SEQ #68^2990316^1"
^DIC(9.4,77,22,16,"PAH",39,1,0)="^^3^3^2990316"
^DIC(9.4,77,22,16,"PAH",39,1,1,0)="The original IV Solution's volume has an upper limit of 4000ml.  This"
^DIC(9.4,77,22,16,"PAH",39,1,2,0)="patch will increase the volume to 9999ml to meet the needs of the sites to"
^DIC(9.4,77,22,16,"PAH",39,1,3,0)="enter solutions with a volume of greater than 4000ml."
^DIC(9.4,77,22,16,"PAH",40,0)="69 SEQ #69^2990329^1"
^DIC(9.4,77,22,16,"PAH",40,1,0)="^^7^7^2990329"
^DIC(9.4,77,22,16,"PAH",40,1,1,0)="1. Patch PSJ*4.5*66 added the institution name to several reports as"
^DIC(9.4,77,22,16,"PAH",40,1,2,0)="requested in E3R #11366.  For integrated sites the institution name"
^DIC(9.4,77,22,16,"PAH",40,1,3,0)="appearing on the reports was the primary institution's name.  After"
^DIC(9.4,77,22,16,"PAH",40,1,4,0)="installation of this patch integrated sites will see the name which was"
^DIC(9.4,77,22,16,"PAH",40,1,5,0)="entered in field INTEGRATED SITE NAME (#17000) from the STATION NUMBER"
^DIC(9.4,77,22,16,"PAH",40,1,6,0)="(TIME SENSITIVE) file (#389.9) on these reports. There will be no change"
^DIC(9.4,77,22,16,"PAH",40,1,7,0)="for non-integrated sites."
^DIC(9.4,77,22,16,"PAH","B",30,1)=""
