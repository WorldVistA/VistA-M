^DIC(9.4,84,"VERSION")="3.0"
^DIC(9.4,85,0)="PATIENT DATA EXCHANGE^VAQ^Module used to manage patient information exchange"
^DIC(9.4,85,1,0)="^^4^4^2930921^^^^"
^DIC(9.4,85,1,1,0)="This module allows medical centers to exchange patient clinical and"
^DIC(9.4,85,1,2,0)="administrative information through the use of MailMan.  Requests can"
^DIC(9.4,85,1,3,0)="be sent to a remote site.  The remote site can process the request and"
^DIC(9.4,85,1,4,0)="a message containing patient information will be returned."
^DIC(9.4,85,4,0)="^9.44PA^19^19"
