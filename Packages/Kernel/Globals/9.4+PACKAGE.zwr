^DIC(9.4,53,22,20,"PAH",260,1,282,0)="Hines:           fo-hines.domain.ext"
^DIC(9.4,53,22,20,"PAH",260,1,283,0)="Salt Lake City:  fo-slc.domain.ext"
^DIC(9.4,53,22,20,"PAH",260,1,284,0)=" "
^DIC(9.4,53,22,20,"PAH",260,1,285,0)="Documentation can also be found on the VA Software Documentation "
