^DIC(9.4,14,22,5.9,"PAH",226,1,141,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,142,0)="Summary of new entries in the Options (File #19):"
^DIC(9.4,14,22,5.9,"PAH",226,1,143,0)="================================================"
^DIC(9.4,14,22,5.9,"PAH",226,1,144,0)="1.  LRHY PATIENT CARD SCAN "
^DIC(9.4,14,22,5.9,"PAH",226,1,145,0)="This option initiates the Howdy process using the greeting from Howdy site"
^DIC(9.4,14,22,5.9,"PAH",226,1,146,0)="file & prints labels."
^DIC(9.4,14,22,5.9,"PAH",226,1,147,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,148,0)="2.  LRHY PHLEBOTOMY LOG"
^DIC(9.4,14,22,5.9,"PAH",226,1,149,0)="This is the log used to track the collector's phlebotomy performance "
^DIC(9.4,14,22,5.9,"PAH",226,1,150,0)="times."
^DIC(9.4,14,22,5.9,"PAH",226,1,151,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,152,0)="3.  LRHY SCAN SPECIMENS INTO LAB"
^DIC(9.4,14,22,5.9,"PAH",226,1,153,0)="This option allows the Receiver to scan collected specimen labels to "
^DIC(9.4,14,22,5.9,"PAH",226,1,154,0)="capture Lab Receipt Time."
^DIC(9.4,14,22,5.9,"PAH",226,1,155,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,156,0)="4.  LRHY TRACK COLLECTION "
^DIC(9.4,14,22,5.9,"PAH",226,1,157,0)="This option is used to display patient specimen collection demographics."
^DIC(9.4,14,22,5.9,"PAH",226,1,158,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,159,0)="5.  LRHY PATIENT WAIT TIME"
^DIC(9.4,14,22,5.9,"PAH",226,1,160,0)="This option displays how long a Patient waits to have a sample drawn."
^DIC(9.4,14,22,5.9,"PAH",226,1,161,0)="     "
^DIC(9.4,14,22,5.9,"PAH",226,1,162,0)="6.  LRHY SITE FILE EDIT"
^DIC(9.4,14,22,5.9,"PAH",226,1,163,0)="This option enables the Keyholder to edit the Howdy site file."
^DIC(9.4,14,22,5.9,"PAH",226,1,164,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,165,0)="7.  LRHY BCE PT CARD SCAN"
^DIC(9.4,14,22,5.9,"PAH",226,1,166,0)="This option enables Howdy to scan the Patient's VIC card when the Patient"
^DIC(9.4,14,22,5.9,"PAH",226,1,167,0)="arrives at the phlebotomy area."
^DIC(9.4,14,22,5.9,"PAH",226,1,168,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,169,0)="8.  LRHY PRINT BCE PPID LABEL "
^DIC(9.4,14,22,5.9,"PAH",226,1,170,0)="Bar Code Expansion (BCE) Compatible - This is the option the collector"
^DIC(9.4,14,22,5.9,"PAH",226,1,171,0)="uses when verifying Positive Patient Identification (PPID) at time of"
^DIC(9.4,14,22,5.9,"PAH",226,1,172,0)="collection.  Each collecting station will have a dedicated PC, scanner and"
^DIC(9.4,14,22,5.9,"PAH",226,1,173,0)="bar code label printer.  Howdy will recognize this person as the collector"
^DIC(9.4,14,22,5.9,"PAH",226,1,174,0)="and date and time of collection.  The collector will scan the patient's"
^DIC(9.4,14,22,5.9,"PAH",226,1,175,0)="VIC card, armband or can type their SSN on their keyboard.  The patient's"
^DIC(9.4,14,22,5.9,"PAH",226,1,176,0)="demographics appear on the screen with the current accessioned orders.  "
^DIC(9.4,14,22,5.9,"PAH",226,1,177,0)="The collector then verifies each specimen in the presence of the patient"
^DIC(9.4,14,22,5.9,"PAH",226,1,178,0)="to assure PPID.  The labels then print and specimens are labeled"
^DIC(9.4,14,22,5.9,"PAH",226,1,179,0)="accordingly."
^DIC(9.4,14,22,5.9,"PAH",226,1,180,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,181,0)="9.  HOWDY MAIN MENU"
^DIC(9.4,14,22,5.9,"PAH",226,1,182,0)="This option provides access to the traditional Howdy Main Menu.  "
^DIC(9.4,14,22,5.9,"PAH",226,1,183,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,184,0)="10. HOWDY BCE MAIN MENU"
^DIC(9.4,14,22,5.9,"PAH",226,1,185,0)="This option provides access to the Howdy BCE Main Menu."
^DIC(9.4,14,22,5.9,"PAH",226,1,186,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,187,0)="Documentation Retrieval:"
^DIC(9.4,14,22,5.9,"PAH",226,1,188,0)="======================="
^DIC(9.4,14,22,5.9,"PAH",226,1,189,0)="Documentation describing the functionality introduced by this patch is "
^DIC(9.4,14,22,5.9,"PAH",226,1,190,0)="available in the [ANONYMOUS.SOFTWARE] directories at the following"
^DIC(9.4,14,22,5.9,"PAH",226,1,191,0)="Internet addresses:"
^DIC(9.4,14,22,5.9,"PAH",226,1,192,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,193,0)=" Preferred or Specific Server     Internet address"
^DIC(9.4,14,22,5.9,"PAH",226,1,194,0)=" ----------------------------     -------------------------"
^DIC(9.4,14,22,5.9,"PAH",226,1,195,0)=" First available ftp server       download.vista.domain.ext  <-- preferred"
^DIC(9.4,14,22,5.9,"PAH",226,1,196,0)=" Albany                           ftp.fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",226,1,197,0)=" Hines                            ftp.fo-hines.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",226,1,198,0)=" Salt Lake City                   ftp.fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",226,1,199,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,200,0)=" Below is a list of the documentation files related to this patch and "
^DIC(9.4,14,22,5.9,"PAH",226,1,201,0)=" available via the FTP sites listed above."
^DIC(9.4,14,22,5.9,"PAH",226,1,202,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,203,0)=" Document File Description          File Name           FTP Mode"
^DIC(9.4,14,22,5.9,"PAH",226,1,204,0)=" -------------------------------    -------------       --------------"
^DIC(9.4,14,22,5.9,"PAH",226,1,205,0)=" Howdy Computerized Login Process   LR_52_405_UM.PDF    binary"
^DIC(9.4,14,22,5.9,"PAH",226,1,206,0)=" User Manual   "
^DIC(9.4,14,22,5.9,"PAH",226,1,207,0)=" Howdy Computerized Login Process   LR_52_405_TM.PDF    binary"
^DIC(9.4,14,22,5.9,"PAH",226,1,208,0)=" Technical Manual       "
^DIC(9.4,14,22,5.9,"PAH",226,1,209,0)=" Howdy Computerized Login Process   LR_52_405_IG.PDF    binary"
^DIC(9.4,14,22,5.9,"PAH",226,1,210,0)=" Installation Guide"
^DIC(9.4,14,22,5.9,"PAH",226,1,211,0)=" Howdy Computerized Login Process   LR_52_405_RN.PDF    binary"
^DIC(9.4,14,22,5.9,"PAH",226,1,212,0)=" Release Notes"
^DIC(9.4,14,22,5.9,"PAH",226,1,213,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,214,0)=" After this patch is released, the updated manuals may also be retrieved "
^DIC(9.4,14,22,5.9,"PAH",226,1,215,0)=" from the Internet at http://www.domain.ext/vdl"
^DIC(9.4,14,22,5.9,"PAH",226,1,216,0)="                 "
^DIC(9.4,14,22,5.9,"PAH",226,1,217,0)=" Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",226,1,218,0)=" =========="
^DIC(9.4,14,22,5.9,"PAH",226,1,219,0)=" To be determined."
^DIC(9.4,14,22,5.9,"PAH",226,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,221,0)=" VISTA Software Application Requirements:"
^DIC(9.4,14,22,5.9,"PAH",226,1,222,0)=" ======================================="
^DIC(9.4,14,22,5.9,"PAH",226,1,223,0)=" Prior to installing VistA Howdy Computerized Phlebotomy Login "
^DIC(9.4,14,22,5.9,"PAH",226,1,224,0)=" Process, the following required software applications must be installed:"
^DIC(9.4,14,22,5.9,"PAH",226,1,225,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,226,0)=" Software Applications          Versions:"
^DIC(9.4,14,22,5.9,"PAH",226,1,227,0)=" ---------------------          --------"
^DIC(9.4,14,22,5.9,"PAH",226,1,228,0)=" Kernel                           8.0"
^DIC(9.4,14,22,5.9,"PAH",226,1,229,0)=" VistA Laboratory                 5.2"
^DIC(9.4,14,22,5.9,"PAH",226,1,230,0)=" VA FileMan                      22.0"
^DIC(9.4,14,22,5.9,"PAH",226,1,231,0)=" VA Mailman                       7.1 or greater"
^DIC(9.4,14,22,5.9,"PAH",226,1,232,0)=" Kernel Toolkit                   7.3"
^DIC(9.4,14,22,5.9,"PAH",226,1,233,0)="    "
^DIC(9.4,14,22,5.9,"PAH",226,1,234,0)=" INSTALLATION INSTRUCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",226,1,235,0)=" ========================="
^DIC(9.4,14,22,5.9,"PAH",226,1,236,0)=" The install time for this patch should take less than 5 minutes.  It is "
^DIC(9.4,14,22,5.9,"PAH",226,1,237,0)=" best if this patch is installed outside of normal working hours."
^DIC(9.4,14,22,5.9,"PAH",226,1,238,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,239,0)=" NOTE:  MailMan and Kernel patches must be current on the target system "
^DIC(9.4,14,22,5.9,"PAH",226,1,240,0)=" to avoid problems loading and installing this patch."
^DIC(9.4,14,22,5.9,"PAH",226,1,241,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,242,0)="  1. Use the 'INSTALL/CHECK MESSAGE' option of your PackMan menu to load "
^DIC(9.4,14,22,5.9,"PAH",226,1,243,0)="the KIDS distribution onto your system."
^DIC(9.4,14,22,5.9,"PAH",226,1,244,0)="   "
^DIC(9.4,14,22,5.9,"PAH",226,1,245,0)="  2. On the 'Kernel Installation & Distribution System' Menu (KIDS), "
^DIC(9.4,14,22,5.9,"PAH",226,1,246,0)="select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",226,1,247,0)="   "
^DIC(9.4,14,22,5.9,"PAH",226,1,248,0)="     From this menu you may choose the following options prior to "
^DIC(9.4,14,22,5.9,"PAH",226,1,249,0)="installing this patch:"
^DIC(9.4,14,22,5.9,"PAH",226,1,250,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,251,0)="     - Backup a Transport Global - this option creates a backup message "
^DIC(9.4,14,22,5.9,"PAH",226,1,252,0)="of any routines exported with the patch. It does NOT backup any other"
^DIC(9.4,14,22,5.9,"PAH",226,1,253,0)="changes, such as data dictionaries or templates."
^DIC(9.4,14,22,5.9,"PAH",226,1,254,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,255,0)="     - Compare Transport Global to Current System - this option allows "
^DIC(9.4,14,22,5.9,"PAH",226,1,256,0)="you to view all changes that are made when the patch is installed. It"
^DIC(9.4,14,22,5.9,"PAH",226,1,257,0)="compares all components of the patch (routines, DDs, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",226,1,258,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,259,0)="     -  Verify Checksums in Transport Global - this option allows you to "
^DIC(9.4,14,22,5.9,"PAH",226,1,260,0)="ensure the integrity of the routine that is in the transport global."
^DIC(9.4,14,22,5.9,"PAH",226,1,261,0)="   "
^DIC(9.4,14,22,5.9,"PAH",226,1,262,0)="  3. Use the 'Install Package(s)' option under the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",226,1,263,0)="  "
^DIC(9.4,14,22,5.9,"PAH",226,1,264,0)="     When prompted for INSTALL NAME, enter: LR*5.2*405."
^DIC(9.4,14,22,5.9,"PAH",226,1,265,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,266,0)="     Install Questions for LR*5.2*405:"
^DIC(9.4,14,22,5.9,"PAH",226,1,267,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,268,0)="     When prompted ""Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",226,1,269,0)="     Install? NO//"", respond NO.  Responding ""Yes"" to the prompt for"
^DIC(9.4,14,22,5.9,"PAH",226,1,270,0)="     rebuilding menu trees can significantly increase install time."
^DIC(9.4,14,22,5.9,"PAH",226,1,271,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,272,0)="     When prompted ""Want KIDS to INHIBIT LOGONs during the install? NO//"","
^DIC(9.4,14,22,5.9,"PAH",226,1,273,0)="     respond NO."
^DIC(9.4,14,22,5.9,"PAH",226,1,274,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,275,0)="     When prompted ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",226,1,276,0)="     Protocols? NO//"", respond NO."
^DIC(9.4,14,22,5.9,"PAH",226,1,277,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,278,0)="  4. Verify that the installation of the patch completed correctly by "
^DIC(9.4,14,22,5.9,"PAH",226,1,279,0)="using the Kernel Installation & Distribution System [XPD MAIN]"
^DIC(9.4,14,22,5.9,"PAH",226,1,280,0)="options:"
^DIC(9.4,14,22,5.9,"PAH",226,1,281,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,282,0)="        KIDS 'Utilities...' [XPD UTILITY] option 'Install File Print' [XPD"
^DIC(9.4,14,22,5.9,"PAH",226,1,283,0)="        PRINT INSTALL FILE] and selecting this patch (LR*5.2*405)."
^DIC(9.4,14,22,5.9,"PAH",227,0)="413 SEQ #326^3120227.14303^17"
^DIC(9.4,14,22,5.9,"PAH",227,1,0)="^^17^17^3120227"
^DIC(9.4,14,22,5.9,"PAH",227,1,1,0)="This patch is a VM patch that addresses 3 issues related to the"
^DIC(9.4,14,22,5.9,"PAH",227,1,2,0)="Anatomic Pathology area of the Lab package."
^DIC(9.4,14,22,5.9,"PAH",227,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",227,1,4,0)="1.       When using option LRAPMOD (Print path modifications) an "
^DIC(9.4,14,22,5.9,"PAH",227,1,5,0)="<UNDEFINED> error is encountered."
^DIC(9.4,14,22,5.9,"PAH",227,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",227,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",227,1,8,0)="2.       Any date in the EXPIRATION DATE FIELD (#3) of the PERSON CLASS"
^DIC(9.4,14,22,5.9,"PAH",227,1,9,0)="multiple (#200.05) of the NEW PERSON file (#200) for a provider"
^DIC(9.4,14,22,5.9,"PAH",227,1,10,0)="will create a situation whereby that provider will not be able to"
^DIC(9.4,14,22,5.9,"PAH",227,1,11,0)="verify/electronically sign Anatomic Pathology reports.  This happens"
^DIC(9.4,14,22,5.9,"PAH",227,1,12,0)="even if the date is a future date."
^DIC(9.4,14,22,5.9,"PAH",227,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",227,1,14,0)="3.       If more than one Special Studies is included in an Anatomic "
^DIC(9.4,14,22,5.9,"PAH",227,1,15,0)="Pathology report, the text of the subsequent Special Studies "
^DIC(9.4,14,22,5.9,"PAH",227,1,16,0)="is not stored properly in the TIU document and thus doesn't display"
^DIC(9.4,14,22,5.9,"PAH",227,1,17,0)="in CPRS."
^DIC(9.4,14,22,5.9,"PAH",228,0)="411 SEQ #327^3120829.103232^17"
^DIC(9.4,14,22,5.9,"PAH",228,1,0)="^^11^11^3120829"
^DIC(9.4,14,22,5.9,"PAH",228,1,1,0)="This patch is a VM patch that addresses 3 issues in the Lab package."
^DIC(9.4,14,22,5.9,"PAH",228,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",228,1,3,0)="1.       When trying to accession an order user gets the message ""TEST "
^DIC(9.4,14,22,5.9,"PAH",228,1,4,0)="NAME does not have an appropriate accession area. Order xxxxx IS "
^DIC(9.4,14,22,5.9,"PAH",228,1,5,0)="NOT ACCESSIONED."""
^DIC(9.4,14,22,5.9,"PAH",228,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",228,1,7,0)="2.       The option GROUP DATA REVIEW (LRGVP) does not always show the"
^DIC(9.4,14,22,5.9,"PAH",228,1,8,0)="proper report routing location."
^DIC(9.4,14,22,5.9,"PAH",228,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",228,1,10,0)="3.       <UNDEFINED> error occurs when trying to delete old user-defined"
^DIC(9.4,14,22,5.9,"PAH",228,1,11,0)="patient/test lists. "
^DIC(9.4,14,22,5.9,"PAH",229,0)="415 SEQ #329^3120829.122241^17"
^DIC(9.4,14,22,5.9,"PAH",229,1,0)="^^5^5^3120829"
^DIC(9.4,14,22,5.9,"PAH",229,1,1,0)="This patch is a VM patch that addresses a problem in the Lab package"
^DIC(9.4,14,22,5.9,"PAH",229,1,2,0)="related to accessioning with in-common accession areas. When an"
^DIC(9.4,14,22,5.9,"PAH",229,1,3,0)="""in-common"" accession area is added to an existing accession area, it"
^DIC(9.4,14,22,5.9,"PAH",229,1,4,0)="is possible that data in file #68 (ACCESSION) will be overlaid and 2"
^DIC(9.4,14,22,5.9,"PAH",229,1,5,0)="patients will have the same accession number."
^DIC(9.4,14,22,5.9,"PAH",230,0)="419 SEQ #328^3120829.122251^17"
^DIC(9.4,14,22,5.9,"PAH",230,1,0)="^^3^3^3120829"
^DIC(9.4,14,22,5.9,"PAH",230,1,1,0)="This patch is a VM patch that addresses Patient Safety issue PSPO #2070."
^DIC(9.4,14,22,5.9,"PAH",230,1,2,0)="A lab test ordered through CPRS (Computerized Patient Record System) can"
^DIC(9.4,14,22,5.9,"PAH",230,1,3,0)="be placed on an order for the wrong patient in file #69(LAB ORDER ENTRY)."
^DIC(9.4,14,22,5.9,"PAH",231,0)="382^3120924.152528^17"
^DIC(9.4,14,22,5.9,"PAH",231,1,0)="^^159^159^3120924"
^DIC(9.4,14,22,5.9,"PAH",231,1,1,0)=" Description"
^DIC(9.4,14,22,5.9,"PAH",231,1,2,0)=" ==========="
^DIC(9.4,14,22,5.9,"PAH",231,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,4,0)=" External Commercial Off the Shelf (COTS) applications and Vista "
^DIC(9.4,14,22,5.9,"PAH",231,1,5,0)=" applications that interface with the Laboratory application may"
^DIC(9.4,14,22,5.9,"PAH",231,1,6,0)=" additionally require patient information contained in ADT HL7"
^DIC(9.4,14,22,5.9,"PAH",231,1,7,0)=" messages. This patch contains the components necessary to transmit"
^DIC(9.4,14,22,5.9,"PAH",231,1,8,0)=" patient information, within ADT HL7 messages, to two different receiving"
^DIC(9.4,14,22,5.9,"PAH",231,1,9,0)=" systems: a third party COTS system and the Vista Blood Establishment "
^DIC(9.4,14,22,5.9,"PAH",231,1,10,0)=" Computer System (VBECS). VBECS must be installed prior to installing "
^DIC(9.4,14,22,5.9,"PAH",231,1,11,0)=" this patch."
^DIC(9.4,14,22,5.9,"PAH",231,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,13,0)=" Included in this patch is one routine, LRADT, that builds the ADT HL7 "
^DIC(9.4,14,22,5.9,"PAH",231,1,14,0)=" messages, one HL LOGICAL LINK file (#870) entry named LRADT, two HL7 "
^DIC(9.4,14,22,5.9,"PAH",231,1,15,0)=" APPLICATION PARAMETER file (#771) entries named LRADT and LRADT TRIGGER, "
^DIC(9.4,14,22,5.9,"PAH",231,1,16,0)=" and the following PROTOCOL file (#101) entries:"
^DIC(9.4,14,22,5.9,"PAH",231,1,17,0)="  "
^DIC(9.4,14,22,5.9,"PAH",231,1,18,0)="  LRADT TRIGGER, LRADT-GMRA TRIGGER"
^DIC(9.4,14,22,5.9,"PAH",231,1,19,0)="  LRADT-A01 SERVER, LRADT-A01 CLIENT, VBECS-A01 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,20,0)="  LRADT-A02 SERVER, LRADT-A02 CLIENT, VBECS-A02 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,21,0)="  LRADT-A03 SERVER, LRADT-A03 CLIENT, VBECS-A03 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,22,0)="  LRADT-A04 SERVER, LRADT-A04 CLIENT, VBECS-A04 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,23,0)="  LRADT-A08 SERVER, LRADT-A08 CLIENT "
^DIC(9.4,14,22,5.9,"PAH",231,1,24,0)="  LRADT-A11 SERVER, LRADT-A11 CLIENT, VBECS-A11 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,25,0)="  LRADT-A12 SERVER, LRADT-A12 CLIENT, VBECS-A12 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,26,0)="  LRADT-A13 SERVER, LRADT-A13 CLIENT, VBECS-A13 CLIENT"
^DIC(9.4,14,22,5.9,"PAH",231,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,28,0)=" The LRADT TRIGGER protocol is associated with existing VAFC ADT"
^DIC(9.4,14,22,5.9,"PAH",231,1,29,0)=" event protocols. The LRADT-GMRA TRIGGER protocol is associated with GMRA "
^DIC(9.4,14,22,5.9,"PAH",231,1,30,0)=" protocols triggered when patient allergies are signed or marked "
^DIC(9.4,14,22,5.9,"PAH",231,1,31,0)=" entered in error."
^DIC(9.4,14,22,5.9,"PAH",231,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,33,0)=" Each TRIGGER protocol invokes routine LRADT to build the appropriate ADT "
^DIC(9.4,14,22,5.9,"PAH",231,1,34,0)=" message, which then transmits the message using the CLIENT/SERVER"
^DIC(9.4,14,22,5.9,"PAH",231,1,35,0)=" protocol pair associated with the ADT event."
^DIC(9.4,14,22,5.9,"PAH",231,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,38,0)=" Test Sites"
^DIC(9.4,14,22,5.9,"PAH",231,1,39,0)=" =========="
^DIC(9.4,14,22,5.9,"PAH",231,1,40,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,41,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,42,0)=" Installation Instructions"
^DIC(9.4,14,22,5.9,"PAH",231,1,43,0)=" ========================="
^DIC(9.4,14,22,5.9,"PAH",231,1,44,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,45,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",231,1,46,0)="    option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",231,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,48,0)=" 2. From the Kernel Installation & Distribution System menu, select"
^DIC(9.4,14,22,5.9,"PAH",231,1,49,0)="    the Installation menu."
^DIC(9.4,14,22,5.9,"PAH",231,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,51,0)=" 3. From this menu, select the option Load a Distribution.  When prompted"
^DIC(9.4,14,22,5.9,"PAH",231,1,52,0)="    for a file name, type in the directory where you have stored the host"
^DIC(9.4,14,22,5.9,"PAH",231,1,53,0)="    file, followed by the file name."
^DIC(9.4,14,22,5.9,"PAH",231,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,55,0)=" 4. From this menu, you may select to use the following options"
^DIC(9.4,14,22,5.9,"PAH",231,1,56,0)="    (when prompted for INSTALL NAME, enter LR*5.2*382. "
^DIC(9.4,14,22,5.9,"PAH",231,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,58,0)=" a. Compare Transport Global to Current System - this option will"
^DIC(9.4,14,22,5.9,"PAH",231,1,59,0)="     allow you to view all changes that will be made when the patch"
^DIC(9.4,14,22,5.9,"PAH",231,1,60,0)="     is installed. It compares all components of the patch (routines,"
^DIC(9.4,14,22,5.9,"PAH",231,1,61,0)="     DDs, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",231,1,62,0)="  b. Verify Checksums in Transport Global - this option will ensure"
^DIC(9.4,14,22,5.9,"PAH",231,1,63,0)="     the integrity of the routines that are in the transport global."
^DIC(9.4,14,22,5.9,"PAH",231,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,65,0)=" 5. Use the Install Package(s) option and at the INSTALL NAME prompt,"
^DIC(9.4,14,22,5.9,"PAH",231,1,66,0)="    enter LR*5.2*382."
^DIC(9.4,14,22,5.9,"PAH",231,1,67,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,68,0)=" 6. When prompted to enter a coordinator for the LRADT INTERFACE ADMIN"
^DIC(9.4,14,22,5.9,"PAH",231,1,69,0)="    mail group, enter the person or persons who will be responsible for"
^DIC(9.4,14,22,5.9,"PAH",231,1,70,0)="    these mail groups."
^DIC(9.4,14,22,5.9,"PAH",231,1,71,0)="                                                      "
^DIC(9.4,14,22,5.9,"PAH",231,1,72,0)=" 7. At the prompt ""TCP/IP address, enter the address of the system that"
^DIC(9.4,14,22,5.9,"PAH",231,1,73,0)="    will be receiving the ADT messages created by LAB ADT interface."
^DIC(9.4,14,22,5.9,"PAH",231,1,74,0)="  "
^DIC(9.4,14,22,5.9,"PAH",231,1,75,0)=" 8. At the prompt ""Port"", enter the port associated with the TCP/IP "
^DIC(9.4,14,22,5.9,"PAH",231,1,76,0)="     address of the third party system that will be receiving the ADT "
^DIC(9.4,14,22,5.9,"PAH",231,1,77,0)="     messages created by the LAB ADT interface."
^DIC(9.4,14,22,5.9,"PAH",231,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,79,0)=" 9. When prompted ""Want KIDS to INHIBIT LOGONs during the install? YES//"""
^DIC(9.4,14,22,5.9,"PAH",231,1,80,0)="    respond NO."
^DIC(9.4,14,22,5.9,"PAH",231,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,82,0)=" 10. When prompted ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",231,1,83,0)="     Protocols? YES//"" respond NO."
^DIC(9.4,14,22,5.9,"PAH",231,1,84,0)="  "
^DIC(9.4,14,22,5.9,"PAH",231,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",231,1,86,0)=" Example Installation:"
^DIC(9.4,14,22,5.9,"PAH",231,1,87,0)=" ====================="
^DIC(9.4,14,22,5.9,"PAH",231,1,88,0)=" "
