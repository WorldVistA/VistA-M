^DIC(9.4,4,22,1,"PAH",48,1,5,0)="If the postmaster has no remote message transmit queues, then MailMan aborts"
^DIC(9.4,4,22,1,"PAH",48,1,6,0)="during the global checker (^XMUT4), and during user setup (^XMVVITAE)."
^DIC(9.4,4,22,1,"PAH",48,1,7,0)="This patch fixes that."
