^DIC(9.4,3,22,21,"PAH",59,1,66,0)="XQ1                 11899807  **1,15,59,67** 11798740 **1,15,59,67,46**"
^DIC(9.4,3,22,21,"PAH",59,1,67,0)="XQ12                17600046  **9,20**      16945386  **9,20,46**"
^DIC(9.4,3,22,21,"PAH",59,1,68,0)="XQ33                 9007179  **49,73**      9049114  **49,73,46**"
^DIC(9.4,3,22,21,"PAH",59,1,69,0)="XQ41                 9107783  (no patches)   9203288  **46**"
^DIC(9.4,3,22,21,"PAH",59,1,70,0)="XQ71                13240707  (no patches)  13242248  **46**"
