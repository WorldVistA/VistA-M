^DIC(9.4,162,22,"B","1.0",1)=""
^DIC(9.4,162,"DEV")="JER/SLC"
^DIC(9.4,162,"VERSION")="1.0"
^DIC(9.4,163,0)="TEXT INTEGRATION UTILITIES^TIU^Text Integration Utilities "
^DIC(9.4,163,1,0)="^9.41A^3^3^3240517^^^"
^DIC(9.4,163,1,1,0)="This package is designed to manage the capture, retention, retrieval and "
^DIC(9.4,163,1,2,0)="processing of any patient-visit-oriented document.  Its first version will "
^DIC(9.4,163,1,3,0)="support Discharge Summaries, Progress Notes, and Consult Results."
^DIC(9.4,163,5)="SALT LAKE ISC"
^DIC(9.4,163,7)="^^I"
^DIC(9.4,163,20,0)="^9.402P^^"
^DIC(9.4,163,22,0)="^9.49I^1^1"
^DIC(9.4,163,22,1,0)="1.0^3051119^2971006^1"
^DIC(9.4,163,22,1,1,0)="^9.54^28^28^3240517^^"
^DIC(9.4,163,22,1,1,1,0)="TEXT INTEGRATION UTILITIES v1.0"
^DIC(9.4,163,22,1,1,2,0)=" "
^DIC(9.4,163,22,1,1,3,0)="Text Integration Utilities (TIU) is a collection of software tools that"
^DIC(9.4,163,22,1,1,4,0)="manage clinical documents in a standardized way. The initial release of"
^DIC(9.4,163,22,1,1,5,0)="Version 1.0 includes Discharge Summary and Progress Notes. TIU replaces"
^DIC(9.4,163,22,1,1,6,0)="the previous versions of these DHCP packages, while incorporating all of"
^DIC(9.4,163,22,1,1,7,0)="the functionality of them."
^DIC(9.4,163,22,1,1,8,0)=" "
^DIC(9.4,163,22,1,1,9,0)="Benefits of TIU"
^DIC(9.4,163,22,1,1,10,0)=" "
^DIC(9.4,163,22,1,1,11,0)="+ Ability to view and manipulate clinical documents from a single program"
^DIC(9.4,163,22,1,1,12,0)="+ Upload capability for many types of documents"
^DIC(9.4,163,22,1,1,13,0)="+ Improved searching and retrieving capabilities across documents"
^DIC(9.4,163,22,1,1,14,0)="+ Less duplication of effort for clinicians, managers, and other staff"
^DIC(9.4,163,22,1,1,15,0)="+ Boilerplate support"
^DIC(9.4,163,22,1,1,16,0)="+ Links to the Computerized Patient Record System (CPRS), Authorization/"
^DIC(9.4,163,22,1,1,17,0)="  Subscription Utility (ASU), Incomplete Record Tracking (IRT), and"
^DIC(9.4,163,22,1,1,18,0)="  interfacility document transfer"
^DIC(9.4,163,22,1,1,19,0)=" "
^DIC(9.4,163,22,1,1,20,0)="Costs"
^DIC(9.4,163,22,1,1,21,0)=" "
^DIC(9.4,163,22,1,1,22,0)="+ Planning your Document and User Class hierarchies."
^DIC(9.4,163,22,1,1,23,0)="+ Setting up the Document hierarchy so that your current Progress Notes"
^DIC(9.4,163,22,1,1,24,0)="  can be converted into the new TIU structure"
^DIC(9.4,163,22,1,1,25,0)="+ Setting up and populating the User Classes (ASU)"
^DIC(9.4,163,22,1,1,26,0)="+ Setting up the Upload Utilities and other TIU parameters"
^DIC(9.4,163,22,1,1,27,0)="+ Converting existing progress notes and discharge summaries to TIU"
^DIC(9.4,163,22,1,1,28,0)="+ Switching Progress Notes and Discharge Summary menus to TIU menus"
^DIC(9.4,163,22,1,"PAH",0)="^9.4901^328^328"
^DIC(9.4,163,22,1,"PAH",1,0)="1^2980227^1"
^DIC(9.4,163,22,1,"PAH",1,1,0)="^^188^188^2980227"
^DIC(9.4,163,22,1,"PAH",1,1,1,0)="Description:"
^DIC(9.4,163,22,1,"PAH",1,1,2,0)="==========="
^DIC(9.4,163,22,1,"PAH",1,1,3,0)="PATCH 1: This patch resolves a number of problems with the Remote"
^DIC(9.4,163,22,1,"PAH",1,1,4,0)="Procedure Calls which support CPRS, the scoping of demographic variables,"
^DIC(9.4,163,22,1,"PAH",1,1,5,0)="and one of the cross-references supporting the query by Service, which"
^DIC(9.4,163,22,1,"PAH",1,1,6,0)="have been reported since release of TIU."
^DIC(9.4,163,22,1,"PAH",1,1,7,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,8,0)="The following routines are included in this distribution:"
^DIC(9.4,163,22,1,"PAH",1,1,9,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,10,0)=" 1. Routine:   TIUDEV"
^DIC(9.4,163,22,1,"PAH",1,1,11,0)="               Added ZTSAVE(""OR*"") to the list of variables to be"
^DIC(9.4,163,22,1,"PAH",1,1,12,0)="               saved in the call to ^%ZTLOAD for queued output."
^DIC(9.4,163,22,1,"PAH",1,1,13,0)="               This was done to prevent an UNDEF error when queuing"
^DIC(9.4,163,22,1,"PAH",1,1,14,0)="               output from the Notes and Summaries Tabs of the CPRS"
^DIC(9.4,163,22,1,"PAH",1,1,15,0)="               Chart."
^DIC(9.4,163,22,1,"PAH",1,1,16,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,17,0)=" 2. Routines:  TIUEDI2         TIUEDIT"
^DIC(9.4,163,22,1,"PAH",1,1,18,0)="               Modified TIUEDI2 to prevent prompting inappropriately"
^DIC(9.4,163,22,1,"PAH",1,1,19,0)="               for the user to edit an unsaved note, for which they"
^DIC(9.4,163,22,1,"PAH",1,1,20,0)="               are not listed as the person by whom the note was"
^DIC(9.4,163,22,1,"PAH",1,1,21,0)="               entered.  Modified TIUEDIT to assure that demographic"
^DIC(9.4,163,22,1,"PAH",1,1,22,0)="                variables are scoped appropriately between patients"
^DIC(9.4,163,22,1,"PAH",1,1,23,0)="               during successive entry of multiple TIU documents."
^DIC(9.4,163,22,1,"PAH",1,1,24,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,25,0)=" 3. Routine:   TIULA2"
^DIC(9.4,163,22,1,"PAH",1,1,26,0)="               - Modified the display of titles to indicate the title"
^DIC(9.4,163,22,1,"PAH",1,1,27,0)="                 for which an addendum has been entered, and to pre-"
^DIC(9.4,163,22,1,"PAH",1,1,28,0)="                 pend a ""+"" when a document has addenda, or a ""*"" when"
^DIC(9.4,163,22,1,"PAH",1,1,29,0)="                 a document is an unsigned ""STAT"" document."
^DIC(9.4,163,22,1,"PAH",1,1,30,0)="               - Modified the selection code to allow multiple"
^DIC(9.4,163,22,1,"PAH",1,1,31,0)="                 selection at any '^' TO STOP prompt, and to support"
^DIC(9.4,163,22,1,"PAH",1,1,32,0)="                 the selection of an indefinite number of notes,"
^DIC(9.4,163,22,1,"PAH",1,1,33,0)="                 without resulting in a STRLEN error, which had been"
^DIC(9.4,163,22,1,"PAH",1,1,34,0)="                 reported by WPB when a range of approximately 200"
^DIC(9.4,163,22,1,"PAH",1,1,35,0)="                 notes was selected."
^DIC(9.4,163,22,1,"PAH",1,1,36,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,37,0)=" 4. Routine:   TIULG   WPB NOIS COS-0797-N0060"
^DIC(9.4,163,22,1,"PAH",1,1,38,0)="               Modified the BADSIG subroutine to print the message:"
^DIC(9.4,163,22,1,"PAH",1,1,39,0)="               < [TITLE] SAVED - WITHOUT SIGNATURE >"
^DIC(9.4,163,22,1,"PAH",1,1,40,0)="               when the user elects not to sign the note on exit"
^DIC(9.4,163,22,1,"PAH",1,1,41,0)="               from the entry or edit function, rather than echoing"
^DIC(9.4,163,22,1,"PAH",1,1,42,0)="               a message indicating how to enter their electronic"
^DIC(9.4,163,22,1,"PAH",1,1,43,0)="               signature code using the User's Toolbox option."
^DIC(9.4,163,22,1,"PAH",1,1,44,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,45,0)=" 5. Routine:   TIULX"
^DIC(9.4,163,22,1,"PAH",1,1,46,0)="               Modified the CWAD subroutine to assure that the"
^DIC(9.4,163,22,1,"PAH",1,1,47,0)="                variable GMRPQT is appropriately scoped, prior to"
^DIC(9.4,163,22,1,"PAH",1,1,48,0)="               calling PAT^GMRPNOR1 to get the string indicating"
^DIC(9.4,163,22,1,"PAH",1,1,49,0)="               which CWAD indicators were on file for the current"
^DIC(9.4,163,22,1,"PAH",1,1,50,0)="               patient, and setting the variable VALMBCK=""R"" to"
^DIC(9.4,163,22,1,"PAH",1,1,51,0)="               assure that the Notes and Summaries Tabs of the"
^DIC(9.4,163,22,1,"PAH",1,1,52,0)="               CPRS chart are properly refreshed on return from"
^DIC(9.4,163,22,1,"PAH",1,1,53,0)="               a call to this subroutine."
^DIC(9.4,163,22,1,"PAH",1,1,54,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,55,0)=" 6. Routine:   TIUPEFIX"
^DIC(9.4,163,22,1,"PAH",1,1,56,0)="               Modified the STUFREC subroutine to assure that the"
^DIC(9.4,163,22,1,"PAH",1,1,57,0)="               appropriate status is computed when resolving upload"
^DIC(9.4,163,22,1,"PAH",1,1,58,0)="               errors."
^DIC(9.4,163,22,1,"PAH",1,1,59,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,60,0)=" 7. Routine:   TIUPRD"
^DIC(9.4,163,22,1,"PAH",1,1,61,0)="               Modified the Print Driver to ensure that all documents"
^DIC(9.4,163,22,1,"PAH",1,1,62,0)="               identified in a call to the routine do exist, and are"
^DIC(9.4,163,22,1,"PAH",1,1,63,0)="               not merely artifacts of corrupt cross-reference entries"
^DIC(9.4,163,22,1,"PAH",1,1,64,0)="               left by disconnect errors, or other interrupted"
^DIC(9.4,163,22,1,"PAH",1,1,65,0)="               processes."
^DIC(9.4,163,22,1,"PAH",1,1,66,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,67,0)=" 8. Routine:   TIURA"
^DIC(9.4,163,22,1,"PAH",1,1,68,0)="               Added a NEW command at the line tag PRINTX to scope"
^DIC(9.4,163,22,1,"PAH",1,1,69,0)="               the variable IOSTBM appropriately, and allow printing"
^DIC(9.4,163,22,1,"PAH",1,1,70,0)="               of documents to VA FileMan's Browser device."
^DIC(9.4,163,22,1,"PAH",1,1,71,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,72,0)=" 9. Routine:   TIURC"
^DIC(9.4,163,22,1,"PAH",1,1,73,0)="               Fixed the COPY function to assure that the appropriate"
^DIC(9.4,163,22,1,"PAH",1,1,74,0)="               visit location was being recorded for the ""destination"""
^DIC(9.4,163,22,1,"PAH",1,1,75,0)="               note, rather than copying the visit location from the"
^DIC(9.4,163,22,1,"PAH",1,1,76,0)="               ""source"" note."
^DIC(9.4,163,22,1,"PAH",1,1,77,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,78,0)="10. Routine:   TIURD1"
^DIC(9.4,163,22,1,"PAH",1,1,79,0)="               Modified to resolve a number of issues with reassign-"
^DIC(9.4,163,22,1,"PAH",1,1,80,0)="               ment of addenda (particularly following signature),"
^DIC(9.4,163,22,1,"PAH",1,1,81,0)="               including the scrambling of signature blocks when"
^DIC(9.4,163,22,1,"PAH",1,1,82,0)="               addenda were swapped with, or moved to replace their"
^DIC(9.4,163,22,1,"PAH",1,1,83,0)="               originals."
^DIC(9.4,163,22,1,"PAH",1,1,84,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,85,0)="11. Routines:  TIUSRV          TIUSRVD"
^DIC(9.4,163,22,1,"PAH",1,1,86,0)="               TIUSRVLL        TIUSRVLO"
^DIC(9.4,163,22,1,"PAH",1,1,87,0)="               TIUSRVP"
^DIC(9.4,163,22,1,"PAH",1,1,88,0)="               These routines, which primarily support TIU's Remote"
^DIC(9.4,163,22,1,"PAH",1,1,89,0)="               Procedure Calls, were modified to fix several issues"
^DIC(9.4,163,22,1,"PAH",1,1,90,0)="               that were identified during implementation of CPRS"
^DIC(9.4,163,22,1,"PAH",1,1,91,0)="               v1.0T12 at WPB, as follows:"
^DIC(9.4,163,22,1,"PAH",1,1,92,0)="               - TIUSRV: the variable VALMAR needed to be scoped"
^DIC(9.4,163,22,1,"PAH",1,1,93,0)="                 using the NEW command to avoid collision with the"
^DIC(9.4,163,22,1,"PAH",1,1,94,0)="                 variable's value in the calling environment,"
^DIC(9.4,163,22,1,"PAH",1,1,95,0)="               - TIUSRVD: the variables VAIN and VADM were scoped"
^DIC(9.4,163,22,1,"PAH",1,1,96,0)="                 using the NEW command to avoid leaving demographic"
^DIC(9.4,163,22,1,"PAH",1,1,97,0)="                 and inpatient variables around between successive"
^DIC(9.4,163,22,1,"PAH",1,1,98,0)="                 patients. The subroutine TRAVERSE was modified to"
^DIC(9.4,163,22,1,"PAH",1,1,99,0)="                 filter inactive titles from the list when composing"
^DIC(9.4,163,22,1,"PAH",1,1,100,0)="                 a new note using the CPRS GUI."
^DIC(9.4,163,22,1,"PAH",1,1,101,0)="               - TIUSRVLL: Added a condition to assure that UNSIGNED"
^DIC(9.4,163,22,1,"PAH",1,1,102,0)="                 addenda are included in the list of notes presented"
^DIC(9.4,163,22,1,"PAH",1,1,103,0)="                 to an author using the Review Progress Notes option."
^DIC(9.4,163,22,1,"PAH",1,1,104,0)="               - TIUSRVLO: Modified date limit computation to assure"
^DIC(9.4,163,22,1,"PAH",1,1,105,0)="                 that both upper and lower bounds are inclusive (e.g.,"
^DIC(9.4,163,22,1,"PAH",1,1,106,0)="                 from TODAY to TODAY will get all of today's notes),"
^DIC(9.4,163,22,1,"PAH",1,1,107,0)="                 when accessed through CPRS (this was already true"
^DIC(9.4,163,22,1,"PAH",1,1,108,0)="                 within TIU itself)."
^DIC(9.4,163,22,1,"PAH",1,1,109,0)="               - TIUSRVP: Modified the VALIDATE function for evaluating"
^DIC(9.4,163,22,1,"PAH",1,1,110,0)="                 electronic signatures passed from a client application"
^DIC(9.4,163,22,1,"PAH",1,1,111,0)="                 to exclude a match when the user's es is NULL, and the"
^DIC(9.4,163,22,1,"PAH",1,1,112,0)="                 string passed from the calling application is NULL."
^DIC(9.4,163,22,1,"PAH",1,1,113,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,114,0)=" Routine Summary: "
^DIC(9.4,163,22,1,"PAH",1,1,115,0)=" ================"
^DIC(9.4,163,22,1,"PAH",1,1,116,0)=" The following is a list of the routines included in this patch.  The "
^DIC(9.4,163,22,1,"PAH",1,1,117,0)=" second line of each of these routines will look like: "
^DIC(9.4,163,22,1,"PAH",1,1,118,0)="  "
^DIC(9.4,163,22,1,"PAH",1,1,119,0)=" <tab>;;1.0;TEXT INTEGRATION UTILITIES;**[Patch List]**;Jun 20, 1997 "
^DIC(9.4,163,22,1,"PAH",1,1,120,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,121,0)="  Routine Name         Before Patch    After Patch     Patch List"
^DIC(9.4,163,22,1,"PAH",1,1,122,0)="  ============         ============    ===========     =========="
^DIC(9.4,163,22,1,"PAH",1,1,123,0)="  TIUDEV                 663743          715912            1"
^DIC(9.4,163,22,1,"PAH",1,1,124,0)="  TIUEDI2               2954081         3117146            1"
^DIC(9.4,163,22,1,"PAH",1,1,125,0)="  TIUEDIT              15928365        16237072            1"
^DIC(9.4,163,22,1,"PAH",1,1,126,0)="  TIULA2               11422552        11932899            1"
^DIC(9.4,163,22,1,"PAH",1,1,127,0)="  TIULG                 2290558         2618361            1"
^DIC(9.4,163,22,1,"PAH",1,1,128,0)="  TIULX                 3630728         3681078            1"
^DIC(9.4,163,22,1,"PAH",1,1,129,0)="  TIUPEFIX              8681313         8870198            1"
^DIC(9.4,163,22,1,"PAH",1,1,130,0)="  TIUPRD                3348806         3379168            1"
^DIC(9.4,163,22,1,"PAH",1,1,131,0)="  TIURA                15894554        15915703            1"
^DIC(9.4,163,22,1,"PAH",1,1,132,0)="  TIURC                15436202        15421240            1"
^DIC(9.4,163,22,1,"PAH",1,1,133,0)="  TIURD1               20613578        19512855            1"
^DIC(9.4,163,22,1,"PAH",1,1,134,0)="  TIUSRV               15487391        15503668            1"
^DIC(9.4,163,22,1,"PAH",1,1,135,0)="  TIUSRVD               4955592         5082369            1"
^DIC(9.4,163,22,1,"PAH",1,1,136,0)="  TIUSRVLL              6543081         6594347            1"
^DIC(9.4,163,22,1,"PAH",1,1,137,0)="  TIUSRVLO              8206046         8457918            1"
^DIC(9.4,163,22,1,"PAH",1,1,138,0)="  TIUSRVP               8220630         8488903            1"
^DIC(9.4,163,22,1,"PAH",1,1,139,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,140,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,141,0)="Data Dictionary: "
^DIC(9.4,163,22,1,"PAH",1,1,142,0)="==============="
^DIC(9.4,163,22,1,"PAH",1,1,143,0)="This patch also exports a partial DD for the .01 field of file 8925,"
^DIC(9.4,163,22,1,"PAH",1,1,144,0)="with a correction to the KILL LOGIC for the ASVC2 Cross-reference on"
^DIC(9.4,163,22,1,"PAH",1,1,145,0)="that field."
^DIC(9.4,163,22,1,"PAH",1,1,146,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,147,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,148,0)="Input Templates:"
^DIC(9.4,163,22,1,"PAH",1,1,149,0)="==============="
^DIC(9.4,163,22,1,"PAH",1,1,150,0)="The input templates TIU ENTER/EDIT PROGRESS NOTE and TIUZ ENTER/EDIT"
^DIC(9.4,163,22,1,"PAH",1,1,151,0)="PN were modified to allow editing of expected cosigner, whenever one"
^DIC(9.4,163,22,1,"PAH",1,1,152,0)="may have been designated.  These templates formerly only asked for"
^DIC(9.4,163,22,1,"PAH",1,1,153,0)="expected cosigner when the author was known to require one.  This"
^DIC(9.4,163,22,1,"PAH",1,1,154,0)="prohibited editing of mis-designated cosigners for notes that were"
^DIC(9.4,163,22,1,"PAH",1,1,155,0)="captured through the upload process.  "
^DIC(9.4,163,22,1,"PAH",1,1,156,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,157,0)=" "
^DIC(9.4,163,22,1,"PAH",1,1,158,0)="Installation Instructions: "
^DIC(9.4,163,22,1,"PAH",1,1,159,0)="=========================="
^DIC(9.4,163,22,1,"PAH",1,1,160,0)="This patch may be installed with users on the system; however, it"
^DIC(9.4,163,22,1,"PAH",1,1,161,0)="should be installed at a non-peak time to minimize disruption to"
^DIC(9.4,163,22,1,"PAH",1,1,162,0)="the users. Installation of this patch will take less than 2 minutes.  "
^DIC(9.4,163,22,1,"PAH",1,1,163,0)="   "
^DIC(9.4,163,22,1,"PAH",1,1,164,0)="1. Use the INSTALL/CHECK MESSAGE option on the Packman Menu.  "
^DIC(9.4,163,22,1,"PAH",1,1,165,0)="  "
^DIC(9.4,163,22,1,"PAH",1,1,166,0)="2. Review your mapped set.  If any of the routines listed in this "
^DIC(9.4,163,22,1,"PAH",1,1,167,0)="   patch are mapped, they should be removed from the mapped set at "
^DIC(9.4,163,22,1,"PAH",1,1,168,0)="   this time, along with TIUXRC* and TIUEPN*, which include the"
^DIC(9.4,163,22,1,"PAH",1,1,169,0)="   code for compiled cross-references and input template effected"
^DIC(9.4,163,22,1,"PAH",1,1,170,0)="   by this patch.  "
^DIC(9.4,163,22,1,"PAH",1,1,171,0)="   "
^DIC(9.4,163,22,1,"PAH",1,1,172,0)="3. From the Kernel Installation and Distribution System (KIDS) Menu, "
^DIC(9.4,163,22,1,"PAH",1,1,173,0)="   select the Installation menu.  "
^DIC(9.4,163,22,1,"PAH",1,1,174,0)="   "
^DIC(9.4,163,22,1,"PAH",1,1,175,0)="4. From the Installation menu, you may elect to use the following "
^DIC(9.4,163,22,1,"PAH",1,1,176,0)="   options (when prompted for INSTALL NAME, enter TIU*1.0*1): "
^DIC(9.4,163,22,1,"PAH",1,1,177,0)="   a.  Backup a Transport Global "
^DIC(9.4,163,22,1,"PAH",1,1,178,0)="   b.  Compare Transport Global to Current System "
^DIC(9.4,163,22,1,"PAH",1,1,179,0)="   c.  Verify Checksums in Transport Global "
^DIC(9.4,163,22,1,"PAH",1,1,180,0)="   "
^DIC(9.4,163,22,1,"PAH",1,1,181,0)="5. Use the Install Package(s) option and select the package TIU*1.0*1."
^DIC(9.4,163,22,1,"PAH",1,1,182,0)="  "
^DIC(9.4,163,22,1,"PAH",1,1,183,0)="6. When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,163,22,1,"PAH",1,1,184,0)="   Protocols? YES//', respond YES, and DISABLE the TIU* Options and"
^DIC(9.4,163,22,1,"PAH",1,1,185,0)="   Protocols."
^DIC(9.4,163,22,1,"PAH",1,1,186,0)="  "
^DIC(9.4,163,22,1,"PAH",1,1,187,0)="7. If routines were unmapped as part of step 2, they should be returned "
^DIC(9.4,163,22,1,"PAH",1,1,188,0)="   to the mapped set once the installation has run to completion."
^DIC(9.4,163,22,1,"PAH",2,0)="6 SEQ #1^2971127^1"
^DIC(9.4,163,22,1,"PAH",2,1,0)="^^3^3^2971127"
^DIC(9.4,163,22,1,"PAH",2,1,1,0)=" This patch fixes a String Too Long error in Document Definition Action"
^DIC(9.4,163,22,1,"PAH",2,1,2,0)=" CREATE. This problem was communicated in a local NOIS message in Seattle."
^DIC(9.4,163,22,1,"PAH",2,1,3,0)=" It has not been reported as a national NOIS."
^DIC(9.4,163,22,1,"PAH",3,0)="3 SEQ #5^2980227^1"
^DIC(9.4,163,22,1,"PAH",3,1,0)="^^142^142^2980227"
^DIC(9.4,163,22,1,"PAH",3,1,1,0)="PATCH 3: This patch fixes a number of problems with the batch upload"
^DIC(9.4,163,22,1,"PAH",3,1,2,0)="facilities of TIU, including the alerts and options for filing error"
^DIC(9.4,163,22,1,"PAH",3,1,3,0)="resolution. It also fixes a discrepancy in the estimated time to"
^DIC(9.4,163,22,1,"PAH",3,1,4,0)="completion computed by the Progress Notes conversion."
^DIC(9.4,163,22,1,"PAH",3,1,5,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,6,0)="The following routines are included in this distribution:"
^DIC(9.4,163,22,1,"PAH",3,1,7,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,8,0)=" 1. Routine:   TIUADD"
^DIC(9.4,163,22,1,"PAH",3,1,9,0)="               Changed line ADDENDUM+9 to exit the subroutine when"
^DIC(9.4,163,22,1,"PAH",3,1,10,0)="               the user isn't authorized to add an addendum to the"
^DIC(9.4,163,22,1,"PAH",3,1,11,0)="               selected record. This is the appropriate behavior, and"
^DIC(9.4,163,22,1,"PAH",3,1,12,0)="               will also prevent a rare UNDEF error at ADDENDUM+17^TIUADD"
^DIC(9.4,163,22,1,"PAH",3,1,13,0)="               that had been observed at several test sites."
^DIC(9.4,163,22,1,"PAH",3,1,14,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,15,0)=" 2. Routine:   TIUCHLP"
^DIC(9.4,163,22,1,"PAH",3,1,16,0)="               Modified the GETPAT and GETPN subroutines to accom-"
^DIC(9.4,163,22,1,"PAH",3,1,17,0)="               modate the changes to the filing error resolution"
^DIC(9.4,163,22,1,"PAH",3,1,18,0)="               approach for BOTH the alerts and the option to"
^DIC(9.4,163,22,1,"PAH",3,1,19,0)="               Review Upload Filing Events."
^DIC(9.4,163,22,1,"PAH",3,1,20,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,21,0)=" 3. Routine:   TIULC"
^DIC(9.4,163,22,1,"PAH",3,1,22,0)="               Changed line REQVER+2 to recognize when the requirement"
^DIC(9.4,163,22,1,"PAH",3,1,23,0)="               for verification has been satisfied for a given record,"
^DIC(9.4,163,22,1,"PAH",3,1,24,0)="               and not impose the requirement inappropriately. Coincides"
^DIC(9.4,163,22,1,"PAH",3,1,25,0)="               with changes to TIUT to assure that the release logic, and"
^DIC(9.4,163,22,1,"PAH",3,1,26,0)="               signature alerts are always executed appropriately."
^DIC(9.4,163,22,1,"PAH",3,1,27,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,28,0)=" 4. Routine:   TIULC1"
^DIC(9.4,163,22,1,"PAH",3,1,29,0)="               Added a function POSTSIGN, to identify the Post-signature"
^DIC(9.4,163,22,1,"PAH",3,1,30,0)="               action for a given document definition, and enforce its"
^DIC(9.4,163,22,1,"PAH",3,1,31,0)="               inheritance."
^DIC(9.4,163,22,1,"PAH",3,1,32,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,33,0)=" 5. Routine:   TIUMOVE                              NOIS: PUG-0997-50895"
^DIC(9.4,163,22,1,"PAH",3,1,34,0)="               Modified the MAIN subroutine to prevent an error reported"
^DIC(9.4,163,22,1,"PAH",3,1,35,0)="               by Puget Sound and Central Texas, where repetitive upload"
^DIC(9.4,163,22,1,"PAH",3,1,36,0)="               of single documents through the option for direct entry of"
^DIC(9.4,163,22,1,"PAH",3,1,37,0)="               a Discharge Summary was occasionally resulting in a mis-"
^DIC(9.4,163,22,1,"PAH",3,1,38,0)="               match to the patient."
^DIC(9.4,163,22,1,"PAH",3,1,39,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,40,0)=" 6. Routine:   TIUPEVNT                             NOIS: PUG-0997-50895"
^DIC(9.4,163,22,1,"PAH",3,1,41,0)="               Modified to help assure that changes to TIUMOVE are"
^DIC(9.4,163,22,1,"PAH",3,1,42,0)="               reflected appropriately in the handling of upload filer"
^DIC(9.4,163,22,1,"PAH",3,1,43,0)="               errors."
^DIC(9.4,163,22,1,"PAH",3,1,44,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,45,0)=" 7. Routine:   TIUPNCV7"
^DIC(9.4,163,22,1,"PAH",3,1,46,0)="               Modified the SETVAR subroutine to correct the"
^DIC(9.4,163,22,1,"PAH",3,1,47,0)="               computation of estimated time remaining."
^DIC(9.4,163,22,1,"PAH",3,1,48,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,49,0)=" 8. Routine:   TIUPUTC"
^DIC(9.4,163,22,1,"PAH",3,1,50,0)="               Modified the GETREC subroutine to prevent a"
^DIC(9.4,163,22,1,"PAH",3,1,51,0)="               <NULLSUBSCR> error when a caption is not associated"
^DIC(9.4,163,22,1,"PAH",3,1,52,0)="               with any particular field in the target file."
^DIC(9.4,163,22,1,"PAH",3,1,53,0)="  "
^DIC(9.4,163,22,1,"PAH",3,1,54,0)=" 9. Routine:   TIUPUTPN"
^DIC(9.4,163,22,1,"PAH",3,1,55,0)="               Modified to assure that notes that have been released from"
^DIC(9.4,163,22,1,"PAH",3,1,56,0)="               the DRAFT state are not overwritten when subsequent"
^DIC(9.4,163,22,1,"PAH",3,1,57,0)="               information is uploaded for the same title and visit (an"
^DIC(9.4,163,22,1,"PAH",3,1,58,0)="               addendum will be added instead)."
^DIC(9.4,163,22,1,"PAH",3,1,59,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,60,0)="10. Routine:   TIUPUTU"
^DIC(9.4,163,22,1,"PAH",3,1,61,0)="               Modified the CANEDIT function to exclude overwriting"
^DIC(9.4,163,22,1,"PAH",3,1,62,0)="               any Discharge Summary record that had proceeded beyond"
^DIC(9.4,163,22,1,"PAH",3,1,63,0)="               release from draft, whether the release event was"
^DIC(9.4,163,22,1,"PAH",3,1,64,0)="               successfully recorded or not."
^DIC(9.4,163,22,1,"PAH",3,1,65,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,66,0)="11. Routine:   TIURE"
^DIC(9.4,163,22,1,"PAH",3,1,67,0)="               Modified the FILERR subroutine to accommodate the"
^DIC(9.4,163,22,1,"PAH",3,1,68,0)="               changes to the error resolution approach when the"
^DIC(9.4,163,22,1,"PAH",3,1,69,0)="               option to Review Upload Filing Events is in use."
^DIC(9.4,163,22,1,"PAH",3,1,70,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,71,0)="12. Routine:   TIURS"
^DIC(9.4,163,22,1,"PAH",3,1,72,0)="               Modified the ES subroutine to prevent prompting multiply"
^DIC(9.4,163,22,1,"PAH",3,1,73,0)="               to ""Print this Note? NO//"" when an addendum is added for"
^DIC(9.4,163,22,1,"PAH",3,1,74,0)="               cosigner's comments. Also changed ES subroutine to respond"
^DIC(9.4,163,22,1,"PAH",3,1,75,0)="               appropriately when the /ES/ block elements contain a semi-"
^DIC(9.4,163,22,1,"PAH",3,1,76,0)="               colon, preventing a COMMAND error. Implemented the post-"
^DIC(9.4,163,22,1,"PAH",3,1,77,0)="               signature action supported by changes in TIULC1."
^DIC(9.4,163,22,1,"PAH",3,1,78,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,79,0)="13. Routine:   TIUT                                  NOIS: PUG-0997-51130"
^DIC(9.4,163,22,1,"PAH",3,1,80,0)="               Modified the VERIFY subroutine to stuff DUZ for field"
^DIC(9.4,163,22,1,"PAH",3,1,81,0)="               1306 (VERIFIED BY), whereas it was stuffing DT. Also"
^DIC(9.4,163,22,1,"PAH",3,1,82,0)="               modified the RELEASE subroutine to assure that the release"
^DIC(9.4,163,22,1,"PAH",3,1,83,0)="               logic is executed when an uploaded document fails to be"
^DIC(9.4,163,22,1,"PAH",3,1,84,0)="               filed initially, and is subsequently filed using the"
^DIC(9.4,163,22,1,"PAH",3,1,85,0)="               options or alerts for filing error correction."
^DIC(9.4,163,22,1,"PAH",3,1,86,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,87,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,88,0)=" Routine Summary: "
^DIC(9.4,163,22,1,"PAH",3,1,89,0)=" ================"
^DIC(9.4,163,22,1,"PAH",3,1,90,0)=" The following is a list of the routines included in this patch.  The "
^DIC(9.4,163,22,1,"PAH",3,1,91,0)=" second line of each of these routines will look like: "
^DIC(9.4,163,22,1,"PAH",3,1,92,0)="  "
^DIC(9.4,163,22,1,"PAH",3,1,93,0)=" <tab>;;1.0;TEXT INTEGRATION UTILITIES;**[Patch List]**;Jun 20, 1997 "
^DIC(9.4,163,22,1,"PAH",3,1,94,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,95,0)="  Routine Name         Before Patch    After Patch     Patch List"
^DIC(9.4,163,22,1,"PAH",3,1,96,0)="  ============         ============    ===========     =========="
^DIC(9.4,163,22,1,"PAH",3,1,97,0)="  TIUADD                 7939178         7989408            3"
^DIC(9.4,163,22,1,"PAH",3,1,98,0)="  TIUCHLP                5315023         5741332            3"
^DIC(9.4,163,22,1,"PAH",3,1,99,0)="  TIULC                  8062118         8116087            3"
^DIC(9.4,163,22,1,"PAH",3,1,100,0)="  TIULC1                 5470005         5678356            3"
^DIC(9.4,163,22,1,"PAH",3,1,101,0)="  TIUMOVE                6394806         6445124            3"
^DIC(9.4,163,22,1,"PAH",3,1,102,0)="  TIUPEVNT              12440029        12489033            3"
^DIC(9.4,163,22,1,"PAH",3,1,103,0)="  TIUPNCV7               5344754         5294994            3"
^DIC(9.4,163,22,1,"PAH",3,1,104,0)="  TIUPUTC               11775034        11993374            3"
^DIC(9.4,163,22,1,"PAH",3,1,105,0)="  TIUPUTPN               6063243         6063169            3"
^DIC(9.4,163,22,1,"PAH",3,1,106,0)="  TIUPUTU                5268373         5381409            3"
^DIC(9.4,163,22,1,"PAH",3,1,107,0)="  TIURE                  6411729         6529651            3"
^DIC(9.4,163,22,1,"PAH",3,1,108,0)="  TIURS                  9109901         9376324            3"
^DIC(9.4,163,22,1,"PAH",3,1,109,0)="  TIUT                   6965722         6971292            3"
^DIC(9.4,163,22,1,"PAH",3,1,110,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,111,0)=" "
^DIC(9.4,163,22,1,"PAH",3,1,112,0)="Installation Instructions: "
^DIC(9.4,163,22,1,"PAH",3,1,113,0)="=========================="
^DIC(9.4,163,22,1,"PAH",3,1,114,0)="This patch may be installed with users on the system; however, it"
^DIC(9.4,163,22,1,"PAH",3,1,115,0)="should be installed at a non-peak time to minimize disruption to"
^DIC(9.4,163,22,1,"PAH",3,1,116,0)="the users. Installation of this patch will take less than 2 minutes.  "
^DIC(9.4,163,22,1,"PAH",3,1,117,0)="   "
^DIC(9.4,163,22,1,"PAH",3,1,118,0)="1. Use the INSTALL/CHECK MESSAGE option on the Packman Menu.  "
^DIC(9.4,163,22,1,"PAH",3,1,119,0)="  "
^DIC(9.4,163,22,1,"PAH",3,1,120,0)="2. Review your mapped set.  If any of the routines listed in this "
^DIC(9.4,163,22,1,"PAH",3,1,121,0)="   patch are mapped, they should be removed from the mapped set at "
^DIC(9.4,163,22,1,"PAH",3,1,122,0)="   this time, along with TIUXRC* and TIUEPN*, which include the"
^DIC(9.4,163,22,1,"PAH",3,1,123,0)="   code for compiled cross-references and input template effected"
^DIC(9.4,163,22,1,"PAH",3,1,124,0)="   by this patch.  "
^DIC(9.4,163,22,1,"PAH",3,1,125,0)="   "
^DIC(9.4,163,22,1,"PAH",3,1,126,0)="3. From the Kernel Installation and Distribution System (KIDS) Menu, "
^DIC(9.4,163,22,1,"PAH",3,1,127,0)="   select the Installation menu.  "
^DIC(9.4,163,22,1,"PAH",3,1,128,0)="   "
^DIC(9.4,163,22,1,"PAH",3,1,129,0)="4. From the Installation menu, you may elect to use the following "
^DIC(9.4,163,22,1,"PAH",3,1,130,0)="   options (when prompted for INSTALL NAME, enter TIU*1.0*3): "
^DIC(9.4,163,22,1,"PAH",3,1,131,0)="   a.  Backup a Transport Global "
^DIC(9.4,163,22,1,"PAH",3,1,132,0)="   b.  Compare Transport Global to Current System "
^DIC(9.4,163,22,1,"PAH",3,1,133,0)="   c.  Verify Checksums in Transport Global "
^DIC(9.4,163,22,1,"PAH",3,1,134,0)="   "
^DIC(9.4,163,22,1,"PAH",3,1,135,0)="5. Use the Install Package(s) option and select the package TIU*1.0*3."
^DIC(9.4,163,22,1,"PAH",3,1,136,0)="  "
^DIC(9.4,163,22,1,"PAH",3,1,137,0)="6. When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,163,22,1,"PAH",3,1,138,0)="   Protocols? YES//', respond YES, and DISABLE the TIU* Options and"
^DIC(9.4,163,22,1,"PAH",3,1,139,0)="   Protocols."
^DIC(9.4,163,22,1,"PAH",3,1,140,0)="  "
^DIC(9.4,163,22,1,"PAH",3,1,141,0)="7. If routines were unmapped as part of step 2, they should be returned "
^DIC(9.4,163,22,1,"PAH",3,1,142,0)="   to the mapped set once the installation has run to completion."
^DIC(9.4,163,22,1,"PAH",4,0)="2^2980227^1"
^DIC(9.4,163,22,1,"PAH",4,1,0)="^^26^26^2980227"
^DIC(9.4,163,22,1,"PAH",4,1,1,0)="Changes were made to 10 Document Definition routines fixing minor errors"
^DIC(9.4,163,22,1,"PAH",4,1,2,0)="and closing a small loophole which permitted users to edit objects and"
^DIC(9.4,163,22,1,"PAH",4,1,3,0)="possibly make them ambiguous."
^DIC(9.4,163,22,1,"PAH",4,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",4,1,5,0)="Problems fixed:"
^DIC(9.4,163,22,1,"PAH",4,1,6,0)=" "
^DIC(9.4,163,22,1,"PAH",4,1,7,0)="1.  Messages ""Deleted"" and ""NOT Deleted"" wrapped when user deleted entry"
^DIC(9.4,163,22,1,"PAH",4,1,8,0)="from Document Definition file.  Messages are now written on following"
^DIC(9.4,163,22,1,"PAH",4,1,9,0)="line."
^DIC(9.4,163,22,1,"PAH",4,1,10,0)=" "
^DIC(9.4,163,22,1,"PAH",4,1,11,0)="2.  If user entered a name like AGE (which happens to be the abbreviation"
^DIC(9.4,163,22,1,"PAH",4,1,12,0)="of an object) as a new Document Definition, say, under option Sort"
^DIC(9.4,163,22,1,"PAH",4,1,13,0)="Document Definitions, it was not accepted.  This was to prevent entering"
^DIC(9.4,163,22,1,"PAH",4,1,14,0)="ambiguous objects, but was too restrictive since the user may plan to make"
^DIC(9.4,163,22,1,"PAH",4,1,15,0)="AGE say, a Title, in which case it doesn't create an ambiguous object. AGE"
^DIC(9.4,163,22,1,"PAH",4,1,16,0)="is now accepted except under option Create Objects."
^DIC(9.4,163,22,1,"PAH",4,1,17,0)=" "
^DIC(9.4,163,22,1,"PAH",4,1,18,0)="3.  If user entered Document Definition using Fileman with name like DOB"
^DIC(9.4,163,22,1,"PAH",4,1,19,0)="(which happens to be the abbreviation of an object) and no other fields,"
^DIC(9.4,163,22,1,"PAH",4,1,20,0)="user could edit it under Basics from the Sort option, and give it type"
^DIC(9.4,163,22,1,"PAH",4,1,21,0)="Object.  This creates an ambiguous object (if DOB is in boilerplate text,"
^DIC(9.4,163,22,1,"PAH",4,1,22,0)="code doesn't know whether to use original object PATIENT DATE OF BIRTH, or"
^DIC(9.4,163,22,1,"PAH",4,1,23,0)="new object DOB).  User can no longer edit type of DOB to object."
^DIC(9.4,163,22,1,"PAH",4,1,24,0)=" "
^DIC(9.4,163,22,1,"PAH",4,1,25,0)="4.  When using hidden action Print List (PL), neither P-MESSAGE nor"
^DIC(9.4,163,22,1,"PAH",4,1,26,0)="BROWSER worked as a device.  They work now."
^DIC(9.4,163,22,1,"PAH",5,0)="5 SEQ #3^2980227^1"
^DIC(9.4,163,22,1,"PAH",5,1,0)="^^5^5^2980227"
^DIC(9.4,163,22,1,"PAH",5,1,1,0)="This build fixes Document Definition code that gave users the erroneous"
^DIC(9.4,163,22,1,"PAH",5,1,2,0)="message NO OWNER when they tried to activate Titles whose boilerplate text"
^DIC(9.4,163,22,1,"PAH",5,1,3,0)="contained objects with no owner.  Users also received this erroneous"
^DIC(9.4,163,22,1,"PAH",5,1,4,0)="message when TRYing such a Title.  The problem is fixed and users now"
^DIC(9.4,163,22,1,"PAH",5,1,5,0)="receive the message: BAD/INACTIVE OBJECT IN BOILERPLATE TEXT."
^DIC(9.4,163,22,1,"PAH",6,0)="8 SEQ #6^2980227^1"
^DIC(9.4,163,22,1,"PAH",6,1,0)="^^1^1^2980227"
^DIC(9.4,163,22,1,"PAH",6,1,1,0)="The description of this build can be found in the National Patch Module."
