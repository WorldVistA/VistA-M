^DIC(9.4,163,22,1,"PAH",212,0)="221 SEQ #216^3070905.013717^1"
^DIC(9.4,163,22,1,"PAH",212,1,0)="^^6^6^3070905"
^DIC(9.4,163,22,1,"PAH",212,1,1,0)="Problem 1 - when there are 2 appointments in the same day an uploaded "
