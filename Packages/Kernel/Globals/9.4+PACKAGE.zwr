^DIC(9.4,14,22,5.9,"PAH",175,0)="361 SEQ #273^3060807^1"
^DIC(9.4,14,22,5.9,"PAH",175,1,0)="^^1^1^3060807"
^DIC(9.4,14,22,5.9,"PAH",175,1,1,0)="ADDING NEW LAB TEST WITH DOUBLE QUOTES"
^DIC(9.4,14,22,5.9,"PAH",176,0)="343 SEQ #274^3060807^1"
^DIC(9.4,14,22,5.9,"PAH",176,1,0)="^^304^304^3060807"
^DIC(9.4,14,22,5.9,"PAH",176,1,1,0)="Blood Bank Team Coordination"
^DIC(9.4,14,22,5.9,"PAH",176,1,2,0)="============================"
^DIC(9.4,14,22,5.9,"PAH",176,1,3,0)="VISTA Laboratory Package patch LR*5.2*343 contains changes to software "
^DIC(9.4,14,22,5.9,"PAH",176,1,4,0)="controlled by VHA DIRECTIVE 2004-058, titled VISTA BLOOD BANK SOFTWARE. "
^DIC(9.4,14,22,5.9,"PAH",176,1,5,0)="Changes include: "
^DIC(9.4,14,22,5.9,"PAH",176,1,6,0)=" File #69.9 (Laboratory Site)"
^DIC(9.4,14,22,5.9,"PAH",176,1,7,0)="    Field #150.3 (CANCEL ON ADMIT) - Removed"
^DIC(9.4,14,22,5.9,"PAH",176,1,8,0)="    Field #150.4 (CANCEL ON DISCHARGE) - Removed"
^DIC(9.4,14,22,5.9,"PAH",176,1,9,0)="    Field #150.5 (CANCEL ON SPECIALTY TRANSFER) - Removed"
^DIC(9.4,14,22,5.9,"PAH",176,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,11,0)="All of the above changes have been reviewed by the VISTA Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",176,1,12,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",176,1,13,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",176,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,15,0)="RISK ANALYSIS: Changes made by patch LR*5.2*343 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",176,1,16,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",176,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,18,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*343 does not "
^DIC(9.4,14,22,5.9,"PAH",176,1,19,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",176,1,20,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",176,1,21,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,22,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 0 routines and "
^DIC(9.4,14,22,5.9,"PAH",176,1,23,0)="1 file identified in Veterans Health Administration (VHA) Directive "
^DIC(9.4,14,22,5.9,"PAH",176,1,24,0)="2004-058, group B listing. The changes have no effect on Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",176,1,25,0)="functionality or medical device control functions. There is no adverse "
^DIC(9.4,14,22,5.9,"PAH",176,1,26,0)="potential to sites."
^DIC(9.4,14,22,5.9,"PAH",176,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,28,0)="VALIDATION REQUIREMENTS BY OPTION: "
^DIC(9.4,14,22,5.9,"PAH",176,1,29,0)="There are no validation requirements for this patch."
^DIC(9.4,14,22,5.9,"PAH",176,1,30,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,31,0)="MINIMAL TEST CASE SCENARIOS BY OPTION, INCLUSIVE OF ALL CONTROL FUNCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",176,1,32,0)="There are no test case scenarios for this patch."
^DIC(9.4,14,22,5.9,"PAH",176,1,33,0)="************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",176,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,35,0)="Remove the LABORATORY package's rules for managing laboratory order "
^DIC(9.4,14,22,5.9,"PAH",176,1,36,0)="auto-discontinuance on admission, transfer, or discharge events and let "
^DIC(9.4,14,22,5.9,"PAH",176,1,37,0)="the existing rules in the OERR (ORDER ENTRY RESULTS REPORTING) package "
^DIC(9.4,14,22,5.9,"PAH",176,1,38,0)="handle the order auto-discontinuance process."
^DIC(9.4,14,22,5.9,"PAH",176,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,40,0)="The LABORATORY package's process that is used to decide if an order "
^DIC(9.4,14,22,5.9,"PAH",176,1,41,0)="should be discontinued when a patient move event is triggered will be "
^DIC(9.4,14,22,5.9,"PAH",176,1,42,0)="disabled.  This business rule is already being handled by the OERR "
^DIC(9.4,14,22,5.9,"PAH",176,1,43,0)="package and the Lab's business rules do not perform all of the needed "
^DIC(9.4,14,22,5.9,"PAH",176,1,44,0)="checks that the OERR package performs.  For example, the Lab's process "
^DIC(9.4,14,22,5.9,"PAH",176,1,45,0)="does not check that a new movement is actually tied to the current "
^DIC(9.4,14,22,5.9,"PAH",176,1,46,0)="admission.  An edit of a patient movement can result in erroneous auto "
^DIC(9.4,14,22,5.9,"PAH",176,1,47,0)="discontinue of a patient's laboratory orders.  OERR also provides checks "
^DIC(9.4,14,22,5.9,"PAH",176,1,48,0)="in the software to establish whether the patient event is new or an edit "
^DIC(9.4,14,22,5.9,"PAH",176,1,49,0)="to an existing event."
^DIC(9.4,14,22,5.9,"PAH",176,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,51,0)="The Lab's process has caused erroneous auto discontinuance of laboratory "
^DIC(9.4,14,22,5.9,"PAH",176,1,52,0)="orders because it does not check if a new movement is actually tied to "
^DIC(9.4,14,22,5.9,"PAH",176,1,53,0)="the patient's current admission.  In the case outlined by the Patient "
^DIC(9.4,14,22,5.9,"PAH",176,1,54,0)="Safety Issue (PSI) report it appeared that a user deleted and re-entered "
^DIC(9.4,14,22,5.9,"PAH",176,1,55,0)="a movement for a prior admission to make a correction.  Since it was a "
^DIC(9.4,14,22,5.9,"PAH",176,1,56,0)="new movement the Lab code executed and the orders were discontinued.  "
^DIC(9.4,14,22,5.9,"PAH",176,1,57,0)="This problem would especially impact sites with patients that are "
^DIC(9.4,14,22,5.9,"PAH",176,1,58,0)="transferred from the acute hospital to the nursing home."
^DIC(9.4,14,22,5.9,"PAH",176,1,59,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,60,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,61,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,62,0)="Technical Description"
^DIC(9.4,14,22,5.9,"PAH",176,1,63,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",176,1,64,0)="When the DGPM MOVEMENT EVENTS of the PROTOCOL file (#101) is triggered "
^DIC(9.4,14,22,5.9,"PAH",176,1,65,0)="the LR7O MOVEMENT EVENT protocol may be called (if it is an item of the "
^DIC(9.4,14,22,5.9,"PAH",176,1,66,0)="DGPM MOVEMENT EVENTS protocol).  In this situation the business rule "
^DIC(9.4,14,22,5.9,"PAH",176,1,67,0)="processing in the LABORATORY package fails to make all of the needed "
^DIC(9.4,14,22,5.9,"PAH",176,1,68,0)="checks to properly determine if the order should be discontinued.  If "
^DIC(9.4,14,22,5.9,"PAH",176,1,69,0)="Lab's logic discontinues the order there will be no order for OERR to "
^DIC(9.4,14,22,5.9,"PAH",176,1,70,0)="apply its more detailed set of business rules against when the OERR code "
^DIC(9.4,14,22,5.9,"PAH",176,1,71,0)="is called from the patient movement event."
^DIC(9.4,14,22,5.9,"PAH",176,1,72,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,73,0)="Lab will no longer perform any package-level checks for order "
^DIC(9.4,14,22,5.9,"PAH",176,1,74,0)="auto-discontinuance based on patient movements.  These checks will be "
^DIC(9.4,14,22,5.9,"PAH",176,1,75,0)="performed by the OERR package.  This change is accomplished by:"
^DIC(9.4,14,22,5.9,"PAH",176,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,77,0)="Deletion of PROTOCOL file (#101) entries:"
^DIC(9.4,14,22,5.9,"PAH",176,1,78,0)="         LR7O MOVEMENT EVENT and LR7O MOVEMENT EVENT TASK"
^DIC(9.4,14,22,5.9,"PAH",176,1,79,0)="Deletion of routine LR7OEVNT"
^DIC(9.4,14,22,5.9,"PAH",176,1,80,0)="Deletion of the following Data Dictionary for LABORATORY SITE file "
^DIC(9.4,14,22,5.9,"PAH",176,1,81,0)="(#69.9):"
^DIC(9.4,14,22,5.9,"PAH",176,1,82,0)="    CANCEL ON ADMIT field (#150.3)"
^DIC(9.4,14,22,5.9,"PAH",176,1,83,0)="    CANCEL ON DISCHARGE field (#150.4)"
^DIC(9.4,14,22,5.9,"PAH",176,1,84,0)="    CANCEL ON SPECIALTY TRANSFER field (#150.5)"
^DIC(9.4,14,22,5.9,"PAH",176,1,85,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,86,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,87,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,88,0)="New Service Request:"
^DIC(9.4,14,22,5.9,"PAH",176,1,89,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",176,1,90,0)="#20050802 -- Remove Lab Package Options to DC Order on Patient Movement"
^DIC(9.4,14,22,5.9,"PAH",176,1,91,0)=" "
^DIC(9.4,14,22,5.9,"PAH",176,1,92,0)=" "
