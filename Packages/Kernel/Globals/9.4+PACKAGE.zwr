^DIC(9.4,4,22,1,"PAH",138,0)="169 SEQ #163^3010319^1"
^DIC(9.4,4,22,1,"PAH",138,1,0)="^^70^70^3010319"
^DIC(9.4,4,22,1,"PAH",138,1,1,0)="Patch XM*7.1*169"
^DIC(9.4,4,22,1,"PAH",138,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",138,1,3,0)="Test Site:  Beckley, WV"
^DIC(9.4,4,22,1,"PAH",138,1,4,0)="NOIS: BEC-0201-21992"
^DIC(9.4,4,22,1,"PAH",138,1,5,0)="When receiving mail from a site, make sure the site's name is in upper case."
^DIC(9.4,4,22,1,"PAH",138,1,6,0)="Otherwise, MailMan might not find it in the DOMAIN file."
^DIC(9.4,4,22,1,"PAH",138,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",138,1,8,0)="NOTE: This patch requires MailMan patch XM*7.1*158."
^DIC(9.4,4,22,1,"PAH",138,1,9,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",138,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",138,1,11,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",138,1,12,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",138,1,13,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",138,1,14,0)=" "
^DIC(9.4,4,22,1,"PAH",138,1,15,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",138,1,16,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",138,1,17,0)="------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",138,1,18,0)="XMR0B          8051092         8083120        4,6,13,34,42,62,50,158,169"
