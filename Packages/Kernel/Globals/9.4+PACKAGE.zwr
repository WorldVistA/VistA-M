^DIC(9.4,149,22,15,"PAH",1,1,1,0)="Update to server message processing."
^DIC(9.4,149,22,15,"PAH",2,0)="7 SEQ #9^2980511^1"
^DIC(9.4,149,22,15,"PAH",2,1,0)="^^1^1^2980511"
^DIC(9.4,149,22,15,"PAH",2,1,1,0)="Miscellaneous corrections."
^DIC(9.4,149,22,15,"PAH",3,0)="10^2980831^1"
^DIC(9.4,149,22,15,"PAH",3,1,0)="^^34^34^2980831"
^DIC(9.4,149,22,15,"PAH",3,1,1,0)=" This patch accomplishes the following:"
^DIC(9.4,149,22,15,"PAH",3,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,3,0)=" 1.  Corrects errors in Patch ABSV*4*7, including a missing routine,"
^DIC(9.4,149,22,15,"PAH",3,1,4,0)="checksum. "
^DIC(9.4,149,22,15,"PAH",3,1,5,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,6,0)=" 2.  Deletes two mail groups left in Patch ABSV*4.0*7 "
^DIC(9.4,149,22,15,"PAH",3,1,7,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,8,0)=" 3.  Corrects the UNSCHEDULED,VOLUNTEER meal ticket print."
^DIC(9.4,149,22,15,"PAH",3,1,9,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,10,0)=" 4.  System will now assume all dates are past dates."
^DIC(9.4,149,22,15,"PAH",3,1,11,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,12,0)="5.  Prohibits the deletion of combination assignments except during the"
^DIC(9.4,149,22,15,"PAH",3,1,13,0)="month of October."
^DIC(9.4,149,22,15,"PAH",3,1,14,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,15,0)=" 6.  When merging two timecards, the system will now prompt to another."
^DIC(9.4,149,22,15,"PAH",3,1,16,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,17,0)=" 7.  Adds two new reports to the Timekeeping Reports Menu.  Both reports"
^DIC(9.4,149,22,15,"PAH",3,1,18,0)="provide monthly data by organization.  One report prints all organizations"
^DIC(9.4,149,22,15,"PAH",3,1,19,0)="for one month, the other prints up to 10 organizations for the time period"
^DIC(9.4,149,22,15,"PAH",3,1,20,0)="requested."
^DIC(9.4,149,22,15,"PAH",3,1,21,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,22,0)=" 8.  Corrects an error caused when a volunteer tries to log in without a"
^DIC(9.4,149,22,15,"PAH",3,1,23,0)="valid combination assignment."
^DIC(9.4,149,22,15,"PAH",3,1,24,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,25,0)=" 9.  Gives a warning when the birth date entered is less than five years"
^DIC(9.4,149,22,15,"PAH",3,1,26,0)="old.  Questions user on the validity of the date."
^DIC(9.4,149,22,15,"PAH",3,1,27,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,28,0)=" 10. Adds an ID Number field to all transmission related occasional hours"
^DIC(9.4,149,22,15,"PAH",3,1,29,0)="printouts."
^DIC(9.4,149,22,15,"PAH",3,1,30,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,31,0)=" 11. Allows user to print a list of the sign-in codes for all active"
^DIC(9.4,149,22,15,"PAH",3,1,32,0)="volunteers in the system."
^DIC(9.4,149,22,15,"PAH",3,1,33,0)=" "
^DIC(9.4,149,22,15,"PAH",3,1,34,0)=" 12. Changes the program to complete the conversion to the year 2000."
^DIC(9.4,149,22,15,"PAH",4,0)="12^2981214^1"
^DIC(9.4,149,22,15,"PAH",4,1,0)="^^2^2^2981214"
^DIC(9.4,149,22,15,"PAH",4,1,1,0)="This patch corrects a 'syntax' error which occurs when print VAVS"
^DIC(9.4,149,22,15,"PAH",4,1,2,0)="Representative labels for station number containing an alpha character."
^DIC(9.4,149,22,15,"PAH",5,0)="14 SEQ #13^2990201^1"
^DIC(9.4,149,22,15,"PAH",5,1,0)="^^1^1^2990201"
^DIC(9.4,149,22,15,"PAH",5,1,1,0)="Voluntary Service Directory File Data Update"
^DIC(9.4,149,22,15,"PAH",6,0)="13 SEQ #14^2990303^1"
^DIC(9.4,149,22,15,"PAH",6,1,0)="^^7^7^2990303"
^DIC(9.4,149,22,15,"PAH",6,1,1,0)="This patch corrects the following problems:"
^DIC(9.4,149,22,15,"PAH",6,1,2,0)="  1.  Failure to clean-up incomplete entries in the Daily Log File"
^DIC(9.4,149,22,15,"PAH",6,1,3,0)="      (503330.1)"
^DIC(9.4,149,22,15,"PAH",6,1,4,0)="  2.  Assumes past date when entering award date information."
^DIC(9.4,149,22,15,"PAH",6,1,5,0)="  3.  Adds Data Dictionary changes for files 503336, 503339.2,"
^DIC(9.4,149,22,15,"PAH",6,1,6,0)="and 503339.3."
^DIC(9.4,149,22,15,"PAH",6,1,7,0)="  4.  Corrects Label Printing Problems"
^DIC(9.4,149,22,15,"PAH",7,0)="15 SEQ #15^2990602^1"
^DIC(9.4,149,22,15,"PAH",7,1,0)="^^21^21^2990602"
^DIC(9.4,149,22,15,"PAH",7,1,1,0)="This patch corrects the following problems:"
^DIC(9.4,149,22,15,"PAH",7,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,3,0)="  1.  Adds Support for National Veterans Games"
^DIC(9.4,149,22,15,"PAH",7,1,4,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,5,0)="  2.  Corrects problem with labels for National Directory"
^DIC(9.4,149,22,15,"PAH",7,1,6,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,7,0)="  3.  Adds routine to clear National Directory"
^DIC(9.4,149,22,15,"PAH",7,1,8,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,9,0)="  4.  Assumes user has privileges when job is queued."
^DIC(9.4,149,22,15,"PAH",7,1,10,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,11,0)="  5.  Allows user to automatically schedule auto log-in transfer to"
^DIC(9.4,149,22,15,"PAH",7,1,12,0)="occur daily."
^DIC(9.4,149,22,15,"PAH",7,1,13,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,14,0)="  6.  Allows user to selectively shutdown auto log-in terminals.  For this"
^DIC(9.4,149,22,15,"PAH",7,1,15,0)="option to work, the terminal MUST be defined in the DEVICE file."
^DIC(9.4,149,22,15,"PAH",7,1,16,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,17,0)="  7.  Adds fields to Site Parameters to prevent asking LUNCH question"
^DIC(9.4,149,22,15,"PAH",7,1,18,0)="during auto log-in on Saturdays, Sundays and Holidays selectively."
^DIC(9.4,149,22,15,"PAH",7,1,19,0)=" "
^DIC(9.4,149,22,15,"PAH",7,1,20,0)="  8.  When halting auto log-in terminals for multiple divisions, the"
^DIC(9.4,149,22,15,"PAH",7,1,21,0)="'site' question is asked each time."
^DIC(9.4,149,22,15,"PAH",8,0)="16 SEQ #16^2990602^1"
^DIC(9.4,149,22,15,"PAH",8,1,0)="^^1^1^2990602"
^DIC(9.4,149,22,15,"PAH",8,1,1,0)="Voluntary Service Directory File Data Update"
^DIC(9.4,149,22,15,"PAH",9,0)="17 SEQ #17^2990914^1"
^DIC(9.4,149,22,15,"PAH",9,1,0)="^^2^2^2990914"
^DIC(9.4,149,22,15,"PAH",9,1,1,0)="This patch updates the Sex field of the master to the new ages for boys"
^DIC(9.4,149,22,15,"PAH",9,1,2,0)="and girls."
^DIC(9.4,149,22,15,"PAH",10,0)="19 SEQ #18^3000229^1"
^DIC(9.4,149,22,15,"PAH",10,1,0)="^^3^3^3000229"
^DIC(9.4,149,22,15,"PAH",10,1,1,0)="This patch lowers the limit of time cards per message from 1000 to 300,"
^DIC(9.4,149,22,15,"PAH",10,1,2,0)="and corrects the processing of termination dates when the year of the"
^DIC(9.4,149,22,15,"PAH",10,1,3,0)="termination ends in 00."
^DIC(9.4,149,22,15,"PAH",11,0)="20 SEQ #19^3000313^1"
^DIC(9.4,149,22,15,"PAH",11,1,0)="^^2^2^3000313"
^DIC(9.4,149,22,15,"PAH",11,1,1,0)="This patch corrects an error in patch 19 which inadvertantly converted a"
^DIC(9.4,149,22,15,"PAH",11,1,2,0)="date of 0000 to 3000000 (Year 2000 with no month and day)"
^DIC(9.4,149,22,15,"PAH",12,0)="21 SEQ #20^3000405^1"
^DIC(9.4,149,22,15,"PAH",12,1,0)="^^2^2^3000405"
^DIC(9.4,149,22,15,"PAH",12,1,1,0)="This patch distributes the updated SERVER routine to correct the problem"
^DIC(9.4,149,22,15,"PAH",12,1,2,0)="created in patch 19"
^DIC(9.4,149,22,15,"PAH",13,0)="18 SEQ #21^3000626^1"
^DIC(9.4,149,22,15,"PAH",13,1,0)="^^26^26^3000626"
^DIC(9.4,149,22,15,"PAH",13,1,1,0)="This patch accomplishes the following actions:"
^DIC(9.4,149,22,15,"PAH",13,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,3,0)="1.  Enhanced label printing, including the ability to skip used label"
^DIC(9.4,149,22,15,"PAH",13,1,4,0)="positions on a page."
^DIC(9.4,149,22,15,"PAH",13,1,5,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,6,0)="2.  Dissemination of the master listing of Representatives and Deputies,"
^DIC(9.4,149,22,15,"PAH",13,1,7,0)="including their areas of jurisdiction and appropriate label printing"
^DIC(9.4,149,22,15,"PAH",13,1,8,0)="options."
^DIC(9.4,149,22,15,"PAH",13,1,9,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,10,0)="3.  Addition of an edit during the 'roll up' process to validate"
^DIC(9.4,149,22,15,"PAH",13,1,11,0)="combinations on the time card to the current master record."
^DIC(9.4,149,22,15,"PAH",13,1,12,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,13,0)="4.  Makes corrections suggested by Kernel Team when calling %ZIS."
^DIC(9.4,149,22,15,"PAH",13,1,14,0)="Specifically, changing Q:POP to I POP D HOME^%ZIS QUIT"
^DIC(9.4,149,22,15,"PAH",13,1,15,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,16,0)="5.  Corrects code that prevented printing of meal tickets on weekends and"
^DIC(9.4,149,22,15,"PAH",13,1,17,0)="holidays when requested by the user."
^DIC(9.4,149,22,15,"PAH",13,1,18,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,19,0)="6.  Corrects $Random problem in ABSVLS1 identified in NOIS: DAY-0400-41214"
^DIC(9.4,149,22,15,"PAH",13,1,20,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,21,0)="7.  Added feature to Single and Multiple posting options to notify user"
^DIC(9.4,149,22,15,"PAH",13,1,22,0)="that a volunteer has been terminated.  Previously the user could not even"
^DIC(9.4,149,22,15,"PAH",13,1,23,0)="see volunteers who were terminated."
^DIC(9.4,149,22,15,"PAH",13,1,24,0)=" "
^DIC(9.4,149,22,15,"PAH",13,1,25,0)="8.  Limits the number of Master Records (TT88's) per message to 150."
^DIC(9.4,149,22,15,"PAH",13,1,26,0)="Potential overflow problem in Austin."
^DIC(9.4,149,22,15,"PAH",14,0)="22 SEQ #22^3001012^1"
^DIC(9.4,149,22,15,"PAH",14,1,0)="^^3^3^3001012"
^DIC(9.4,149,22,15,"PAH",14,1,1,0)="This patch accomplishes the following actions:"
^DIC(9.4,149,22,15,"PAH",14,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",14,1,3,0)="Update of the National Officials file (503334.1) data."
^DIC(9.4,149,22,15,"PAH",15,0)="24 SEQ #23^3010103^1"
^DIC(9.4,149,22,15,"PAH",15,1,0)="^^3^3^3010103"
^DIC(9.4,149,22,15,"PAH",15,1,1,0)="This patch accomplishes the following actions:"
^DIC(9.4,149,22,15,"PAH",15,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",15,1,3,0)="Update of the National Officials file (503334.1) data."
^DIC(9.4,149,22,15,"PAH",16,0)="23 SEQ #24^3010202^1"
^DIC(9.4,149,22,15,"PAH",16,1,0)="^^13^13^3010202"
^DIC(9.4,149,22,15,"PAH",16,1,1,0)="This patch contains:"
^DIC(9.4,149,22,15,"PAH",16,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",16,1,3,0)="The files and data and necessary to support the National Voluntary Service"
^DIC(9.4,149,22,15,"PAH",16,1,4,0)="Directory."
^DIC(9.4,149,22,15,"PAH",16,1,5,0)=" "
^DIC(9.4,149,22,15,"PAH",16,1,6,0)="Correction to the Zip Code label program to sort by the standard 5 digit"
^DIC(9.4,149,22,15,"PAH",16,1,7,0)="Zip Code required by the USPS for bulk mail."
^DIC(9.4,149,22,15,"PAH",16,1,8,0)=" "
^DIC(9.4,149,22,15,"PAH",16,1,9,0)="Corrected an error found in posting the Last Award Date in the data"
^DIC(9.4,149,22,15,"PAH",16,1,10,0)="received from the Austin Automation Center."
^DIC(9.4,149,22,15,"PAH",16,1,11,0)=" "
^DIC(9.4,149,22,15,"PAH",16,1,12,0)="Allow the user the option to print single or multiple, collated or"
^DIC(9.4,149,22,15,"PAH",16,1,13,0)="uncollated labels."
^DIC(9.4,149,22,15,"PAH",17,0)="25 SEQ #25^3010926^1"
^DIC(9.4,149,22,15,"PAH",17,1,0)="^^1^1^3010926"
^DIC(9.4,149,22,15,"PAH",17,1,1,0)="Voluntary Donation Module to Volunteer Timekeeping Package"
^DIC(9.4,149,22,15,"PAH",18,0)="26 SEQ #26^3011016^1"
^DIC(9.4,149,22,15,"PAH",18,1,0)="^^3^3^3011016"
^DIC(9.4,149,22,15,"PAH",18,1,1,0)="This patch will permit LAYGO access to the GPF/DONATION (503342) file for "
^DIC(9.4,149,22,15,"PAH",18,1,2,0)="adding entries, without the need for specific LAYGO access through part "
^DIC(9.4,149,22,15,"PAH",18,1,3,0)="III of Kernel."
^DIC(9.4,149,22,15,"PAH",19,0)="28 SEQ #27^3011106^1"
^DIC(9.4,149,22,15,"PAH",19,1,0)="^^2^2^3011106"
^DIC(9.4,149,22,15,"PAH",19,1,1,0)="This patch will add the 135V - VETERANS HISTORY VOLUNTARY SERVICE - VHVS "
^DIC(9.4,149,22,15,"PAH",19,1,2,0)="entry into file 503332."
^DIC(9.4,149,22,15,"PAH",20,0)="29 SEQ #28^3020506^1"
^DIC(9.4,149,22,15,"PAH",20,1,0)="^^3^3^3020506"
^DIC(9.4,149,22,15,"PAH",20,1,1,0)="Corrects the use of the "","" is the FR and TO strings in print templates."
^DIC(9.4,149,22,15,"PAH",20,1,2,0)=" "
^DIC(9.4,149,22,15,"PAH",20,1,3,0)="This option also deletes access to the National Officials File."
^DIC(9.4,149,22,15,"PAH",21,0)="30 SEQ #29^3020528^1"
^DIC(9.4,149,22,15,"PAH",21,1,0)="^^2^2^3020528"
^DIC(9.4,149,22,15,"PAH",21,1,1,0)="This patch corrects sorting on report by organization, where the "
^DIC(9.4,149,22,15,"PAH",21,1,2,0)="organization contains a "",""."
^DIC(9.4,149,22,15,"PAH",22,0)="31 SEQ #30^3030329^1"
^DIC(9.4,149,22,15,"PAH",22,1,0)="^^458^458^3030329"
^DIC(9.4,149,22,15,"PAH",22,1,1,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,2,0)="This patch is part of the migration from the VistA-based Voluntary"
^DIC(9.4,149,22,15,"PAH",22,1,3,0)="TimeKeeping package to the web-based Voluntary Service System (VSS)."
^DIC(9.4,149,22,15,"PAH",22,1,4,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,5,0)="This patch installs routines, options, other components, and file 503339.5"
^DIC(9.4,149,22,15,"PAH",22,1,6,0)="VOLUNTARY MIGRATION LOG. These are all new and will allow the site to"
^DIC(9.4,149,22,15,"PAH",22,1,7,0)="send information used to set up a new station in VSS, to check existing"
^DIC(9.4,149,22,15,"PAH",22,1,8,0)="VTK data, and to print error reports of the data validation."
^DIC(9.4,149,22,15,"PAH",22,1,9,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,10,0)="A companion patch, ABSV*4.0*32, contains the option that sends the data to"
^DIC(9.4,149,22,15,"PAH",22,1,11,0)="the new system."
^DIC(9.4,149,22,15,"PAH",22,1,12,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,13,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,14,0)="PATCH DEPENDENCIES:"
^DIC(9.4,149,22,15,"PAH",22,1,15,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,16,0)="None."
^DIC(9.4,149,22,15,"PAH",22,1,17,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,18,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,19,0)="No NOISs or E3Rs are addressed by this patch."
^DIC(9.4,149,22,15,"PAH",22,1,20,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,21,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,22,0)="ROUTINE SUMMARY:"
^DIC(9.4,149,22,15,"PAH",22,1,23,0)="================"
^DIC(9.4,149,22,15,"PAH",22,1,24,0)=" The following is a list of the routines that are included in this"
^DIC(9.4,149,22,15,"PAH",22,1,25,0)=" patch.  The second line of each of these routines now looks like:"
^DIC(9.4,149,22,15,"PAH",22,1,26,0)="        ;;4.0;VOLUNTARY TIMEKEEPING;*31*;Jul 1994"
^DIC(9.4,149,22,15,"PAH",22,1,27,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,28,0)="Routine Name    Before Patch    After Patch     Patch List"
^DIC(9.4,149,22,15,"PAH",22,1,29,0)="============    ============    ===========     =========="
^DIC(9.4,149,22,15,"PAH",22,1,30,0)="ABSVM           N/A             15748896        31"
^DIC(9.4,149,22,15,"PAH",22,1,31,0)="ABSVM1          N/A             3639237         31"
^DIC(9.4,149,22,15,"PAH",22,1,32,0)="ABSVMHV1        N/A             17163056        31"
^DIC(9.4,149,22,15,"PAH",22,1,33,0)="ABSVMLC1        N/A             703152          31"
^DIC(9.4,149,22,15,"PAH",22,1,34,0)="ABSVMLC2        N/A             559992          31"
^DIC(9.4,149,22,15,"PAH",22,1,35,0)="ABSVMLC3        N/A             759900          31"
^DIC(9.4,149,22,15,"PAH",22,1,36,0)="ABSVMRV1        N/A             10324879        31"
^DIC(9.4,149,22,15,"PAH",22,1,37,0)="ABSVMS1         N/A             9693434         31"
^DIC(9.4,149,22,15,"PAH",22,1,38,0)="ABSVMUT1        N/A             8407468         31"
^DIC(9.4,149,22,15,"PAH",22,1,39,0)="ABSVMVV1        N/A             12548749        31"
^DIC(9.4,149,22,15,"PAH",22,1,40,0)="ABSVMVV2        N/A             11698483        31"
^DIC(9.4,149,22,15,"PAH",22,1,41,0)="ABSVMVV3        N/A             7742190         31"
^DIC(9.4,149,22,15,"PAH",22,1,42,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,43,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,44,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,149,22,15,"PAH",22,1,45,0)="========================="
^DIC(9.4,149,22,15,"PAH",22,1,46,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,47,0)="This patch should take less than 1 minute to load."
^DIC(9.4,149,22,15,"PAH",22,1,48,0)=" - No existing data is changed during patch installation."
^DIC(9.4,149,22,15,"PAH",22,1,49,0)=" - No options need to be disabled."
^DIC(9.4,149,22,15,"PAH",22,1,50,0)=" - None of these routines are or will be mapped."
^DIC(9.4,149,22,15,"PAH",22,1,51,0)=" - Users can be on the system when this patch loads."
^DIC(9.4,149,22,15,"PAH",22,1,52,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,53,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,149,22,15,"PAH",22,1,54,0)="    option will load the KIDS package onto your system."
^DIC(9.4,149,22,15,"PAH",22,1,55,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,56,0)=" 2. From the Kernel Installation and Distribution System (KIDS) menu,"
^DIC(9.4,149,22,15,"PAH",22,1,57,0)="    you may elect to use the following options:"
^DIC(9.4,149,22,15,"PAH",22,1,58,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,59,0)="    a.  Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,149,22,15,"PAH",22,1,60,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,149,22,15,"PAH",22,1,61,0)="        transport global."
^DIC(9.4,149,22,15,"PAH",22,1,62,0)="    b.  Print Transport Global - this option will allow you to view"
^DIC(9.4,149,22,15,"PAH",22,1,63,0)="        the components of the KIDS build."
^DIC(9.4,149,22,15,"PAH",22,1,64,0)="    c.  Backup a Transport Global - this options doesn't need to be"
^DIC(9.4,149,22,15,"PAH",22,1,65,0)="        run because all of the routines in this patch are new."
^DIC(9.4,149,22,15,"PAH",22,1,66,0)="    d.  Compare Transport Global to Current System - this options doesn't"
^DIC(9.4,149,22,15,"PAH",22,1,67,0)="        need to be run because all components in this patch are new."
^DIC(9.4,149,22,15,"PAH",22,1,68,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,69,0)=" 3. Use the Install Package(s) option and select the package"
^DIC(9.4,149,22,15,"PAH",22,1,70,0)="    ABSV*4.0*31."
^DIC(9.4,149,22,15,"PAH",22,1,71,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,72,0)=" 4. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,149,22,15,"PAH",22,1,73,0)="    Install? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",22,1,74,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,75,0)=" 5. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,149,22,15,"PAH",22,1,76,0)="    Install? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",22,1,77,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,78,0)=" 6. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,149,22,15,"PAH",22,1,79,0)="    and Protocols? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",22,1,80,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,81,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,82,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,83,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,84,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,85,0)="        Voluntary Service Staff Instructions for patch ABSV*4*31"
^DIC(9.4,149,22,15,"PAH",22,1,86,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,87,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,88,0)=" After patch ABSV*4*31 is installed at a site, the Voluntary Service staff"
^DIC(9.4,149,22,15,"PAH",22,1,89,0)=" can begin the data cleansing process. The Systems Implementation (SI)"
^DIC(9.4,149,22,15,"PAH",22,1,90,0)=" group will give specific instructions to the Voluntary Service staff"
^DIC(9.4,149,22,15,"PAH",22,1,91,0)=" regarding the timing and other particulars of the migration."
^DIC(9.4,149,22,15,"PAH",22,1,92,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,93,0)=" This process will start when the patch is received by the site and should"
^DIC(9.4,149,22,15,"PAH",22,1,94,0)=" be completed not later than 2 weeks before the sites scheduled conversion"
^DIC(9.4,149,22,15,"PAH",22,1,95,0)=" date."
^DIC(9.4,149,22,15,"PAH",22,1,96,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,97,0)=" The patch installs a new menu on the Volunteer Timekeeping Activity menu."
^DIC(9.4,149,22,15,"PAH",22,1,98,0)=" The new menu looks like this:"
^DIC(9.4,149,22,15,"PAH",22,1,99,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,100,0)=" Voluntary Data Migration Menu"
^DIC(9.4,149,22,15,"PAH",22,1,101,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,102,0)="   PREP   Prepare for Transition to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,103,0)="   VAL    Validate Existing Data"
^DIC(9.4,149,22,15,"PAH",22,1,104,0)="   PRNT   Print Results of Data Validation"
^DIC(9.4,149,22,15,"PAH",22,1,105,0)="   VOL    Master Volunteer Edit"
^DIC(9.4,149,22,15,"PAH",22,1,106,0)="   DAIL   Daily Time Edit"
^DIC(9.4,149,22,15,"PAH",22,1,107,0)="   OCC    Occasional Hours Edit"
^DIC(9.4,149,22,15,"PAH",22,1,108,0)="   SEND   Send Voluntary Data to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,109,0)="       **> Locked with ABSV MIGRATION"
^DIC(9.4,149,22,15,"PAH",22,1,110,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,111,0)=" (Note: the Send option will appear only after patch 32 is installed.)"
^DIC(9.4,149,22,15,"PAH",22,1,112,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,113,0)=" This menu is locked with the already existing ABSV MGR Security Key; so,"
^DIC(9.4,149,22,15,"PAH",22,1,114,0)=" only holders of that key will be able to run these options."
^DIC(9.4,149,22,15,"PAH",22,1,115,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,116,0)=" Briefly,"
^DIC(9.4,149,22,15,"PAH",22,1,117,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,118,0)="   PREP option does some initial setup for your site and sends information"
^DIC(9.4,149,22,15,"PAH",22,1,119,0)=" that is used to establish your site on the VSS centralized server.  Run"
^DIC(9.4,149,22,15,"PAH",22,1,120,0)=" this option once only."
^DIC(9.4,149,22,15,"PAH",22,1,121,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,122,0)="   VAL option checks your existing data and creates a report of entries"
^DIC(9.4,149,22,15,"PAH",22,1,123,0)=" that contain inconsistent data that can be corrected before the data is"
^DIC(9.4,149,22,15,"PAH",22,1,124,0)=" sent to the new system.  This option can be run as often as you like."
^DIC(9.4,149,22,15,"PAH",22,1,125,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,126,0)="   PRNT option displays the results of the Validate option.  It can be run"
^DIC(9.4,149,22,15,"PAH",22,1,127,0)=" as often as you like."
^DIC(9.4,149,22,15,"PAH",22,1,128,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,129,0)="   VOL option allows the user to edit all the fields they need to correct"
^DIC(9.4,149,22,15,"PAH",22,1,130,0)=" a problem with the Volunteer information."
^DIC(9.4,149,22,15,"PAH",22,1,131,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,132,0)="   DAIL option allows the user to edit all the fields they need to correct"
^DIC(9.4,149,22,15,"PAH",22,1,133,0)=" a problem with Regular Hours information."
^DIC(9.4,149,22,15,"PAH",22,1,134,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,135,0)="   OCC option allows the user to edit all the fields they need to correct"
^DIC(9.4,149,22,15,"PAH",22,1,136,0)=" a problem with Occasional Hours information."
^DIC(9.4,149,22,15,"PAH",22,1,137,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,138,0)="   SEND option sends the data to the new system.  It should be run only once"
^DIC(9.4,149,22,15,"PAH",22,1,139,0)=" unless SI instructs you to run it again."
^DIC(9.4,149,22,15,"PAH",22,1,140,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,141,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,142,0)=" PREPARE FOR  TRANSITION TO VSS"
^DIC(9.4,149,22,15,"PAH",22,1,143,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,144,0)=" VSS will contain information about your Voluntary Service.  If your site is"
^DIC(9.4,149,22,15,"PAH",22,1,145,0)=" multi-divisional, it will contain information about each division to which"
^DIC(9.4,149,22,15,"PAH",22,1,146,0)=" Volunteer Hours are recorded.  Most of the information about your Voluntary"
^DIC(9.4,149,22,15,"PAH",22,1,147,0)=" Service and its staff will entered by Voluntary Service personnel using the"
^DIC(9.4,149,22,15,"PAH",22,1,148,0)=" new VSS web interface.  However, some data is needed for initial setup of"
^DIC(9.4,149,22,15,"PAH",22,1,149,0)=" your site.  The main purpose of the Prepare for Transition to VSS option is"
^DIC(9.4,149,22,15,"PAH",22,1,150,0)=" to gather this preliminary information and to send it to the people who will"
^DIC(9.4,149,22,15,"PAH",22,1,151,0)=" do the initial data entry."
^DIC(9.4,149,22,15,"PAH",22,1,152,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,153,0)=" Following is the dialog you will see when running this option."
^DIC(9.4,149,22,15,"PAH",22,1,154,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,155,0)=" Select Voluntary Data Migration Menu Option: Prepare for Transition to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,156,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,157,0)=" You are starting the process that will move "
^DIC(9.4,149,22,15,"PAH",22,1,158,0)=" Voluntary Timekeeping data to the new "
^DIC(9.4,149,22,15,"PAH",22,1,159,0)=" Voluntary Service System application."
^DIC(9.4,149,22,15,"PAH",22,1,160,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,161,0)=" First, information about your site will be collected."
^DIC(9.4,149,22,15,"PAH",22,1,162,0)=" Your Volunteer Daily Time file will be scanned to find "
^DIC(9.4,149,22,15,"PAH",22,1,163,0)=" all sites referenced.  This will take some time."
^DIC(9.4,149,22,15,"PAH",22,1,164,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,165,0)=" Done."
^DIC(9.4,149,22,15,"PAH",22,1,166,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,167,0)=" Your primary site number is 605"
^DIC(9.4,149,22,15,"PAH",22,1,168,0)=" Hours are recorded to the following sites:"
^DIC(9.4,149,22,15,"PAH",22,1,169,0)="                    605"
^DIC(9.4,149,22,15,"PAH",22,1,170,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,171,0)=" The option has looked through your Volunteer Daily Time file and identified"
^DIC(9.4,149,22,15,"PAH",22,1,172,0)=" all the sites (or institutions) to which regular volunteer hours have been"
^DIC(9.4,149,22,15,"PAH",22,1,173,0)=" recorded since 10/1/1996.  Displayed are your primary station number and"
^DIC(9.4,149,22,15,"PAH",22,1,174,0)=" the station numbers of all the sites for which hours were found."
^DIC(9.4,149,22,15,"PAH",22,1,175,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,176,0)=" If this information appears to be incorrect, answer the following question"
^DIC(9.4,149,22,15,"PAH",22,1,177,0)=" ""NO"" and contact SI for further instructions.  Otherwise, answer ""YES"" and"
^DIC(9.4,149,22,15,"PAH",22,1,178,0)=" proceed."
^DIC(9.4,149,22,15,"PAH",22,1,179,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,180,0)=" Is this site information correct? YES"
^DIC(9.4,149,22,15,"PAH",22,1,181,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,182,0)=" Now an entry for your site is made in a new file that was installed on your"
^DIC(9.4,149,22,15,"PAH",22,1,183,0)=" system by patch 31, the Voluntary Migration Log file.  The data recorded"
^DIC(9.4,149,22,15,"PAH",22,1,184,0)=" when running the migration options is stored in this file."
^DIC(9.4,149,22,15,"PAH",22,1,185,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,186,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,187,0)=" Making an entry in the Voluntary Migration Log file."
^DIC(9.4,149,22,15,"PAH",22,1,188,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,189,0)=" You will be asked for information about each station to which hours are"
^DIC(9.4,149,22,15,"PAH",22,1,190,0)=" recorded.  In this example, only one station is involved.  If your"
^DIC(9.4,149,22,15,"PAH",22,1,191,0)=" multi-divisional site has more than one station, answer the questions for"
^DIC(9.4,149,22,15,"PAH",22,1,192,0)=" each station even if the answers are the same."
^DIC(9.4,149,22,15,"PAH",22,1,193,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,194,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,195,0)="                    Add information for Station Number 605"
^DIC(9.4,149,22,15,"PAH",22,1,196,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,197,0)=" STATION NAME: Loma Linda Test"
^DIC(9.4,149,22,15,"PAH",22,1,198,0)=" VISN: 22"
^DIC(9.4,149,22,15,"PAH",22,1,199,0)=" STREET ADDRESS LINE 1: 1 Hospital Way"
^DIC(9.4,149,22,15,"PAH",22,1,200,0)=" STREET ADDRESS LINE 2: <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,201,0)=" CITY: Loma Linda"
^DIC(9.4,149,22,15,"PAH",22,1,202,0)=" STATE: CA"
^DIC(9.4,149,22,15,"PAH",22,1,203,0)=" ZIP CODE: 99999"
^DIC(9.4,149,22,15,"PAH",22,1,204,0)=" USER ADMIN'S LAST NAME: Boss"
^DIC(9.4,149,22,15,"PAH",22,1,205,0)=" USER ADMIN'S FIRST NAME: Big"
^DIC(9.4,149,22,15,"PAH",22,1,206,0)=" USER ADMIN'S MIDDLE NAME: B."
^DIC(9.4,149,22,15,"PAH",22,1,207,0)=" USER ADMIN'S NT USERNAME: vhamaster\vhaisfbossb"
^DIC(9.4,149,22,15,"PAH",22,1,208,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,209,0)=" The first seven questions are self-explanatory.  "
^DIC(9.4,149,22,15,"PAH",22,1,210,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,211,0)=" The questions about the User Administrator refer to the lead person at"
^DIC(9.4,149,22,15,"PAH",22,1,212,0)=" your site. That person will be responsible for entering site data and"
^DIC(9.4,149,22,15,"PAH",22,1,213,0)=" setting up other local users.  Often, it will be the Voluntary Service"
^DIC(9.4,149,22,15,"PAH",22,1,214,0)=" Chief."
^DIC(9.4,149,22,15,"PAH",22,1,215,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,216,0)=" It is very important that this person's NT Username is entered correctly."
^DIC(9.4,149,22,15,"PAH",22,1,217,0)=" You must enter both the domain and the username separated by a ""\""."
^DIC(9.4,149,22,15,"PAH",22,1,218,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,219,0)=" Next you are asked for the e-mail address of the recipient of this"
^DIC(9.4,149,22,15,"PAH",22,1,220,0)=" information.  The message is sent via MailMan to a Microsoft Exchange"
^DIC(9.4,149,22,15,"PAH",22,1,221,0)=" address.  SI will provide you with the necessary e-mail address. You can"
^DIC(9.4,149,22,15,"PAH",22,1,222,0)=" also send the message to local MailMan recipients.  In the following"
^DIC(9.4,149,22,15,"PAH",22,1,223,0)=" example, John Smith is the user."
^DIC(9.4,149,22,15,"PAH",22,1,224,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,225,0)=" Your local IRM must assure that mail can be sent successfully to the"
^DIC(9.4,149,22,15,"PAH",22,1,226,0)=" domain.ext domain.  The sending of this message will be a test of that"
^DIC(9.4,149,22,15,"PAH",22,1,227,0)=" domain, which will also be used when the actual data is sent."
^DIC(9.4,149,22,15,"PAH",22,1,228,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,229,0)=" Sending a message containing information about your site."
^DIC(9.4,149,22,15,"PAH",22,1,230,0)=" Enter a Recipient of the Institution Creation message: first.last@domain.ext"
^DIC(9.4,149,22,15,"PAH",22,1,231,0)=" Enter a Recipient of the Institution Creation message:"
^DIC(9.4,149,22,15,"PAH",22,1,232,0)="                                SMITH,JOHN (use your own name here)"
^DIC(9.4,149,22,15,"PAH",22,1,233,0)=" Enter a Recipient of the Institution Creation message: <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,234,0)=" Message sent.  Message number: 8250639"
^DIC(9.4,149,22,15,"PAH",22,1,235,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,236,0)=" This completes the preparatory option on the MUMPS system.  SI will"
^DIC(9.4,149,22,15,"PAH",22,1,237,0)=" contact you after your site has been initialized on VSS and the new"
^DIC(9.4,149,22,15,"PAH",22,1,238,0)=" system is ready to recieve your data.  "
^DIC(9.4,149,22,15,"PAH",22,1,239,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,240,0)=" You can now proceed with the review of your local data."
^DIC(9.4,149,22,15,"PAH",22,1,241,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,242,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,243,0)=" VALIDATE EXISTING DATA:"
^DIC(9.4,149,22,15,"PAH",22,1,244,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,245,0)="   PREP   Prepare for Transition to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,246,0)="   VAL    Validate Existing Data"
^DIC(9.4,149,22,15,"PAH",22,1,247,0)="   PRNT   Print Results of Data Validation"
^DIC(9.4,149,22,15,"PAH",22,1,248,0)="   VOL    Master Volunteer Edit"
^DIC(9.4,149,22,15,"PAH",22,1,249,0)="   DAIL   Daily Time Edit"
^DIC(9.4,149,22,15,"PAH",22,1,250,0)="   OCC    Occasional Hours Edit"
^DIC(9.4,149,22,15,"PAH",22,1,251,0)="   SEND   Send Voluntary Data to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,252,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,253,0)=" Select Voluntary Data Migration Menu Option: Validate Existing Data"
^DIC(9.4,149,22,15,"PAH",22,1,254,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,255,0)=" Data that will be moved to the new Voluntary Service System database"
^DIC(9.4,149,22,15,"PAH",22,1,256,0)=" will now be checked for consistency."
^DIC(9.4,149,22,15,"PAH",22,1,257,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,258,0)=" The result will be recorded in the Voluntary Migration Log File."
^DIC(9.4,149,22,15,"PAH",22,1,259,0)=" You will have the opportunity to print these results."
^DIC(9.4,149,22,15,"PAH",22,1,260,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,261,0)=" The data validation process will review all of the entries that will be"
^DIC(9.4,149,22,15,"PAH",22,1,262,0)=" moved from your VistA VTK system to the new VSS server.  A report will be"
^DIC(9.4,149,22,15,"PAH",22,1,263,0)=" made containing each entry that has incorrect or inconsistent data."
^DIC(9.4,149,22,15,"PAH",22,1,264,0)=" You can use that report to correct entries so that a complete set of data"
^DIC(9.4,149,22,15,"PAH",22,1,265,0)=" is moved to the new system."
^DIC(9.4,149,22,15,"PAH",22,1,266,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,267,0)=" Entries that are reported as containing a problem will not be migrated to"
^DIC(9.4,149,22,15,"PAH",22,1,268,0)=" the new system unless the problem is corrected in your data."
^DIC(9.4,149,22,15,"PAH",22,1,269,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,270,0)=" Because there are many records involved, running this option may take some"
^DIC(9.4,149,22,15,"PAH",22,1,271,0)=" time.  Particularly time consuming will be the validation of the Volunteer"
^DIC(9.4,149,22,15,"PAH",22,1,272,0)=" Regular Hours."
^DIC(9.4,149,22,15,"PAH",22,1,273,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,274,0)=" A dialog indicating progress is presented as the validation goes on.  When"
^DIC(9.4,149,22,15,"PAH",22,1,275,0)=" the check of each file is done, the number of entries with errors is"
^DIC(9.4,149,22,15,"PAH",22,1,276,0)=" displayed."
^DIC(9.4,149,22,15,"PAH",22,1,277,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,278,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,279,0)=" Do you want to proceed? YES"
^DIC(9.4,149,22,15,"PAH",22,1,280,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,281,0)=" Creating list of all Volunteers with hours after Sept. 30, 1996."
^DIC(9.4,149,22,15,"PAH",22,1,282,0)=" Done."
^DIC(9.4,149,22,15,"PAH",22,1,283,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,284,0)=" Creating lists of valid Organization, Service, Schedule, and Award Codes."
^DIC(9.4,149,22,15,"PAH",22,1,285,0)=" Done."
^DIC(9.4,149,22,15,"PAH",22,1,286,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,287,0)=" Validating entries in the Volunteer Organization Codes File."
^DIC(9.4,149,22,15,"PAH",22,1,288,0)=" Errors Found in Organization Codes: 1"
^DIC(9.4,149,22,15,"PAH",22,1,289,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,290,0)=" Validating entries in the Service Assignment Codes File."
^DIC(9.4,149,22,15,"PAH",22,1,291,0)=" Errors found in Service Assignment Codes: 1"
^DIC(9.4,149,22,15,"PAH",22,1,292,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,293,0)=" Validating Occasional Hours."
^DIC(9.4,149,22,15,"PAH",22,1,294,0)=" Errors found in Occasional Hours: 12"
^DIC(9.4,149,22,15,"PAH",22,1,295,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,296,0)=" Validating Regular Hours."
^DIC(9.4,149,22,15,"PAH",22,1,297,0)=" THIS WILL TAKE SOME TIME."
^DIC(9.4,149,22,15,"PAH",22,1,298,0)=" Errors found in Regular Hours: 1"
^DIC(9.4,149,22,15,"PAH",22,1,299,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,300,0)=" Validating Volunteer data."
^DIC(9.4,149,22,15,"PAH",22,1,301,0)=" THIS WILL TAKE SONE TIME."
^DIC(9.4,149,22,15,"PAH",22,1,302,0)=" Errors found in Volunteer data: 6"
^DIC(9.4,149,22,15,"PAH",22,1,303,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,304,0)=" The data checking on your system is complete!"
^DIC(9.4,149,22,15,"PAH",22,1,305,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,306,0)=" After the validation finishes, you can immediately print the results."
^DIC(9.4,149,22,15,"PAH",22,1,307,0)=" Whether you print it at this time or not, the information on incorrect"
^DIC(9.4,149,22,15,"PAH",22,1,308,0)=" entries is stored and can be printed at any later time. "
^DIC(9.4,149,22,15,"PAH",22,1,309,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,310,0)=" Do you want to print the results now? YES"
^DIC(9.4,149,22,15,"PAH",22,1,311,0)=" DEVICE: HOME//<RET>VIRTUAL CONNECTION    Right Margin: 80//<RET> "
^DIC(9.4,149,22,15,"PAH",22,1,312,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,313,0)=" The error reports are grouped by type and indicate the record number (IEN)"
^DIC(9.4,149,22,15,"PAH",22,1,314,0)=" of the record that contains the problem.  For the volunteers, the name of"
^DIC(9.4,149,22,15,"PAH",22,1,315,0)=" the volunteer is also shown to help in identification."
^DIC(9.4,149,22,15,"PAH",22,1,316,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,317,0)=" This completes the data validation option.  This option can be rerun with"
^DIC(9.4,149,22,15,"PAH",22,1,318,0)=" results reflecting the status of your data at the time it is rerun."
^DIC(9.4,149,22,15,"PAH",22,1,319,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,320,0)=" You do not, however, need to rerun the option just to view the results of"
^DIC(9.4,149,22,15,"PAH",22,1,321,0)=" a prior run.  You can print previous results."
^DIC(9.4,149,22,15,"PAH",22,1,322,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,323,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,324,0)=" PRINT RESULTS OF DATA VALIDATION:"
^DIC(9.4,149,22,15,"PAH",22,1,325,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,326,0)="   PREP   Prepare for Transition to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,327,0)="   VAL    Validate Existing Data"
^DIC(9.4,149,22,15,"PAH",22,1,328,0)="   PRNT   Print Results of Data Validation"
^DIC(9.4,149,22,15,"PAH",22,1,329,0)="   VOL    Master Volunteer Edit"
^DIC(9.4,149,22,15,"PAH",22,1,330,0)="   DAIL   Daily Time Edit"
^DIC(9.4,149,22,15,"PAH",22,1,331,0)="   OCC    Occasional Hours Edit"
^DIC(9.4,149,22,15,"PAH",22,1,332,0)="   SEND   Send Voluntary Data to VSS"
^DIC(9.4,149,22,15,"PAH",22,1,333,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,334,0)=" Select Voluntary Data Migration Menu Option: Print Results of Data Validation"
^DIC(9.4,149,22,15,"PAH",22,1,335,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,336,0)=" You can print results of the Examination of Existing Data "
^DIC(9.4,149,22,15,"PAH",22,1,337,0)=" by selecting the date/time that the examination was done."
^DIC(9.4,149,22,15,"PAH",22,1,338,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,339,0)=" Note that the validation results are stored by date and time run.  The"
^DIC(9.4,149,22,15,"PAH",22,1,340,0)=" simplest way to  choose the results to print is to input the date that the"
^DIC(9.4,149,22,15,"PAH",22,1,341,0)=" validation was run.  In the following example, the results of validation run"
^DIC(9.4,149,22,15,"PAH",22,1,342,0)=" ""TODAY"" are requested.  You select the specific set of data validated to"
^DIC(9.4,149,22,15,"PAH",22,1,343,0)=" print.  In this example, the results for Regular and Occasional Hours are"
^DIC(9.4,149,22,15,"PAH",22,1,344,0)=" selected."
^DIC(9.4,149,22,15,"PAH",22,1,345,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,346,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,347,0)=" Select VALIDATION RESULTS TIME RUN: TODAY   OCT 04, 2002"
^DIC(9.4,149,22,15,"PAH",22,1,348,0)="     1   10-4-2002@18:14:10    Organizations   NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,349,0)="     2   10-4-2002@18:14:11    Services   NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,350,0)="     3   10-4-2002@18:14:11    Occasional Hours   NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,351,0)="     4   10-4-2002@18:14:11    Regular Hours   NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,352,0)="     5   10-4-2002@18:14:23    Volunteers   NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,353,0)=" CHOOSE 1-5: 4  10-4-2002@18:14:11    Regular Hours  NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,354,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,355,0)=" Do you want to select another result to print? YES"
^DIC(9.4,149,22,15,"PAH",22,1,356,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,357,0)=" Select VALIDATION RESULTS TIME RUN: T   OCT 04, 2002"
^DIC(9.4,149,22,15,"PAH",22,1,358,0)="     1   10-4-2002@18:14:10    Organizations     NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,359,0)="     2   10-4-2002@18:14:11    Services     NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,360,0)="     3   10-4-2002@18:14:11    Occasional Hours     NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,361,0)="     4   10-4-2002@18:14:11    Regular Hours     NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,362,0)="     5   10-4-2002@18:14:23    Volunteers     NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,363,0)=" CHOOSE 1-5: 3  10-4-2002@18:14:11  Occasional Hours  NO, ONLY VALIDATION DONE"
^DIC(9.4,149,22,15,"PAH",22,1,364,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,365,0)=" Do you want to select another result to print? NO"
^DIC(9.4,149,22,15,"PAH",22,1,366,0)=" DEVICE: HOME//   VIRTUAL CONNECTION    Right Margin: 80// "
^DIC(9.4,149,22,15,"PAH",22,1,367,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,368,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,369,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,370,0)=" CORRECTING DATA:"
^DIC(9.4,149,22,15,"PAH",22,1,371,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,372,0)=" You are requested to run the data validation option weeks before the actual"
^DIC(9.4,149,22,15,"PAH",22,1,373,0)=" switch to the new system so that you have the opportunity to correct invalid"
^DIC(9.4,149,22,15,"PAH",22,1,374,0)=" records.  Corrected records will be migrated to the new system while those"
^DIC(9.4,149,22,15,"PAH",22,1,375,0)=" remaining with an error will be rejected."
^DIC(9.4,149,22,15,"PAH",22,1,376,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,377,0)=" The method of correction will depend on the problem.  In some cases, you"
^DIC(9.4,149,22,15,"PAH",22,1,378,0)=" will have to contact volunteers; in others, you will have to refer to paper"
^DIC(9.4,149,22,15,"PAH",22,1,379,0)=" records.  When the necessary information is obtained, you will usually be"
^DIC(9.4,149,22,15,"PAH",22,1,380,0)=" able to use the existing VTK options to make the change.  You can also use"
^DIC(9.4,149,22,15,"PAH",22,1,381,0)=" the three options supplied in this patch: Master Volunteer Edit , Daily Time"
^DIC(9.4,149,22,15,"PAH",22,1,382,0)=" Edit, Occasional Hours Edit. If you cannot use the normal options, contact"
^DIC(9.4,149,22,15,"PAH",22,1,383,0)=" your local IRM.  If your local IRM cannot resolve the issue they should file"
^DIC(9.4,149,22,15,"PAH",22,1,384,0)=" a NOIS report and NVS will assist in getting the problem resolved."
^DIC(9.4,149,22,15,"PAH",22,1,385,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,386,0)=" Following is an example of correcting Volunteer data.  Copied below is a"
^DIC(9.4,149,22,15,"PAH",22,1,387,0)=" line from the validation report run above:"
^DIC(9.4,149,22,15,"PAH",22,1,388,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,389,0)=" Volunteer record #3418 with Name MAYO,MARION has incorrect sex data."
^DIC(9.4,149,22,15,"PAH",22,1,390,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,391,0)=" A volunteer with record number 3418 in the Voluntary Master file whose name"
^DIC(9.4,149,22,15,"PAH",22,1,392,0)=" is Marion Mayo somehow has incorrect information in the SEX field.  It is"
^DIC(9.4,149,22,15,"PAH",22,1,393,0)=" unimportant how that erroneous data got there.  Suppose you determine that"
^DIC(9.4,149,22,15,"PAH",22,1,394,0)=" Marion is a woman.  Correct the error by using the Register/Edit Volunteer"
^DIC(9.4,149,22,15,"PAH",22,1,395,0)=" in Master File option:"
^DIC(9.4,149,22,15,"PAH",22,1,396,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,397,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,398,0)=" Select Master File Maintenance Menu Option: Register/Edit Volunteer in"
^DIC(9.4,149,22,15,"PAH",22,1,399,0)=" Master File"
^DIC(9.4,149,22,15,"PAH",22,1,400,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,401,0)=" Select Volunteer Name: `3418  MAYO,MARION"
^DIC(9.4,149,22,15,"PAH",22,1,402,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,403,0)=" Note: the volunteer is selected by putting an accent grave (`) in front of"
^DIC(9.4,149,22,15,"PAH",22,1,404,0)=" the entry number from the error report.  This method should work for any"
^DIC(9.4,149,22,15,"PAH",22,1,405,0)=" data you are correcting, regardless of file.  In this case, you could have"
^DIC(9.4,149,22,15,"PAH",22,1,406,0)=" also used the name."
^DIC(9.4,149,22,15,"PAH",22,1,407,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,408,0)=" Do you wish to Add/Edit Volunteer specific data? YES//<RET>   (YES)"
^DIC(9.4,149,22,15,"PAH",22,1,409,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,410,0)=" NICKNAME: <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,411,0)=" PSEUDO INDICATOR: <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,412,0)=" SOCIAL SECURITY NUMBER: 999-99-9999// <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,413,0)=" STREET ADDRESS #1: 1 Main St.// <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,414,0)=" STREET ADDRESS #2: <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,415,0)=" CITY: MORENO VALLEY// <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,416,0)=" STATE: CALIFORNIA// <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,417,0)=" ZIP CODE: 92553// <RET>"
^DIC(9.4,149,22,15,"PAH",22,1,418,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,419,0)=" Here the source of the error is clear.  Somehow a ""Z"" was input into the"
^DIC(9.4,149,22,15,"PAH",22,1,420,0)=" SEX field.  The data validation option identified this as being incorrect."
^DIC(9.4,149,22,15,"PAH",22,1,421,0)=" Here, it is corrected to F for Female."
^DIC(9.4,149,22,15,"PAH",22,1,422,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,423,0)=" SEX: Z// F  Female, 21 and over"
^DIC(9.4,149,22,15,"PAH",22,1,424,0)=" BIRTH DATE: JUL 1970// ^"
^DIC(9.4,149,22,15,"PAH",22,1,425,0)=" Do you wish to continue to the next section? YES// NO  (NO)"
^DIC(9.4,149,22,15,"PAH",22,1,426,0)=" Do you need to transmit this record to Austin? YES// NO  (NO)"
^DIC(9.4,149,22,15,"PAH",22,1,427,0)="                           <  No Action Taken>"
^DIC(9.4,149,22,15,"PAH",22,1,428,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,429,0)=" Now, Marion's entry and the entries of the Regular Hours that she worked"
^DIC(9.4,149,22,15,"PAH",22,1,430,0)=" can be sent to the new system."
^DIC(9.4,149,22,15,"PAH",22,1,431,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,432,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,433,0)=" Documentation:"
^DIC(9.4,149,22,15,"PAH",22,1,434,0)=" --------------------"
^DIC(9.4,149,22,15,"PAH",22,1,435,0)="  The ABSV_4_31ig.pdf, can be obtained from the ANONYMOUS.SOFTWARE"
^DIC(9.4,149,22,15,"PAH",22,1,436,0)="  directory at one of the OI Field Offices.  The preferred method is to FTP"
^DIC(9.4,149,22,15,"PAH",22,1,437,0)="  the file from DOWNLOAD.VISTA.DOMAIN.EXT, which will transmit the file from"
^DIC(9.4,149,22,15,"PAH",22,1,438,0)="  the first available server. Alternatively, site may elect to retrieve the"
^DIC(9.4,149,22,15,"PAH",22,1,439,0)="  file from a specific OI Field Office.  The documentation can be read via"
^DIC(9.4,149,22,15,"PAH",22,1,440,0)="  the Adobe Acrobat Reader browser program. The .PDF file are binary file and"
^DIC(9.4,149,22,15,"PAH",22,1,441,0)="  must be transferred using binary file transfer tools."
^DIC(9.4,149,22,15,"PAH",22,1,442,0)="     "
^DIC(9.4,149,22,15,"PAH",22,1,443,0)="  IO FIELD OFFICE   FTP Address                   DIRECTORY"
^DIC(9.4,149,22,15,"PAH",22,1,444,0)="  ---------------   -----------------             -----------------"
^DIC(9.4,149,22,15,"PAH",22,1,445,0)="  Hines             FTP.FO-HINES.DOMAIN.EXT       [ANONYMOUS.SOFTWARE]"
^DIC(9.4,149,22,15,"PAH",22,1,446,0)="  Albany            FTP.FO-ALBANY.DOMAIN.EXT      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,149,22,15,"PAH",22,1,447,0)="  Salt Lake         FTP.FO-SLC.DOMAIN.EXT         [ANONYMOUS.SOFTWARE]"
^DIC(9.4,149,22,15,"PAH",22,1,448,0)="  "
^DIC(9.4,149,22,15,"PAH",22,1,449,0)=" "
^DIC(9.4,149,22,15,"PAH",22,1,450,0)="     Files                 Description                Block Count"
^DIC(9.4,149,22,15,"PAH",22,1,451,0)="   ---------------      ------------------------    --------------"
^DIC(9.4,149,22,15,"PAH",22,1,452,0)="   ABSV_4_31ig.pdf      Installation Guide (PDF)         "
^DIC(9.4,149,22,15,"PAH",22,1,453,0)=""
^DIC(9.4,149,22,15,"PAH",22,1,454,0)="     "
^DIC(9.4,149,22,15,"PAH",22,1,455,0)=" If you have further questions on obtaining the PDF files, please contact"
^DIC(9.4,149,22,15,"PAH",22,1,456,0)=" the CIO National Help desk at 1-888-596-4357, and ask for the Fiscal"
^DIC(9.4,149,22,15,"PAH",22,1,457,0)=" Management Team."
^DIC(9.4,149,22,15,"PAH",22,1,458,0)=""
^DIC(9.4,149,22,15,"PAH",23,0)="33 SEQ #31^3030430^1"
^DIC(9.4,149,22,15,"PAH",23,1,0)="^^211^211^3030430"
^DIC(9.4,149,22,15,"PAH",23,1,1,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,2,0)="This patch is part of the migration from the VistA-based Voluntary"
^DIC(9.4,149,22,15,"PAH",23,1,3,0)="TimeKeeping package to the web-based Voluntary Service System (VSS)."
^DIC(9.4,149,22,15,"PAH",23,1,4,0)="It is a patch for ABSV*4.0*31.  It will add the missing Service Codes,"
^DIC(9.4,149,22,15,"PAH",23,1,5,0)="170A and 270A-E.  It also excludes data from any Game site; stations"
^DIC(9.4,149,22,15,"PAH",23,1,6,0)="700, 701, 702,and 575W.  For consolidated stations, the user will be"
^DIC(9.4,149,22,15,"PAH",23,1,7,0)="prompted to send or not send data for each site.  This will allow them "
^DIC(9.4,149,22,15,"PAH",23,1,8,0)="to exclude Voluntary Time Keeping data for old site numbers. "
^DIC(9.4,149,22,15,"PAH",23,1,9,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,10,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,11,0)="This patch installs routines, other components, and file 503339.5"
^DIC(9.4,149,22,15,"PAH",23,1,12,0)="VOLUNTARY MIGRATION LOG. These are all updates, originally installed"
^DIC(9.4,149,22,15,"PAH",23,1,13,0)="with patch ABSV*4.0*31, and will allow the site to check existing"
^DIC(9.4,149,22,15,"PAH",23,1,14,0)="VTK data, and to print error reports of the data validation."
^DIC(9.4,149,22,15,"PAH",23,1,15,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,16,0)="After installing this patch, you need to re-run the 'Prepare for Transition"
^DIC(9.4,149,22,15,"PAH",23,1,17,0)=" to VSS' option under the 'Voluntary Data Migration Menu'."
^DIC(9.4,149,22,15,"PAH",23,1,18,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,19,0)="A companion patch, ABSV*4.0*32, contains the option that sends the data to"
^DIC(9.4,149,22,15,"PAH",23,1,20,0)="the new system."
^DIC(9.4,149,22,15,"PAH",23,1,21,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,22,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,23,0)="PATCH DEPENDENCIES:"
^DIC(9.4,149,22,15,"PAH",23,1,24,0)=" ABSV*4.0*31"
^DIC(9.4,149,22,15,"PAH",23,1,25,0)="  "
^DIC(9.4,149,22,15,"PAH",23,1,26,0)="NOIS:"
^DIC(9.4,149,22,15,"PAH",23,1,27,0)=" NHM-0303-12436 = Service Code 170A missing"
^DIC(9.4,149,22,15,"PAH",23,1,28,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,29,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,30,0)="ROUTINE SUMMARY:"
^DIC(9.4,149,22,15,"PAH",23,1,31,0)="================"
^DIC(9.4,149,22,15,"PAH",23,1,32,0)=" The following is a list of the routines that are included in this"
^DIC(9.4,149,22,15,"PAH",23,1,33,0)=" patch.  The second line of each of these routines now looks like:"
^DIC(9.4,149,22,15,"PAH",23,1,34,0)="        ;;4.0;VOLUNTARY TIMEKEEPING;*31*;Jul 1994"
^DIC(9.4,149,22,15,"PAH",23,1,35,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,36,0)="Routine Name    Before Patch    After Patch     Patch List"
^DIC(9.4,149,22,15,"PAH",23,1,37,0)="============    ============    ===========     =========="
^DIC(9.4,149,22,15,"PAH",23,1,38,0)="ABSVM           15748896        17148928        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,39,0)="ABSVM1           3639237         2810664        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,40,0)="ABSVMHV1        17163056        17609281        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,41,0)="ABSVMLC1          703152         1046809        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,42,0)="ABSVMLC2          559992          918431        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,43,0)="ABSVMS1          9693434         9910965        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,44,0)="ABSVMUT1         8407468         8467551        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,45,0)="ABSVMVV1        12548749        12661211        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,46,0)="ABSVMVV2        11698483        11297170        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,47,0)="ABSVMVV3         7742190         8199323        31,33"
^DIC(9.4,149,22,15,"PAH",23,1,48,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,49,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,50,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,149,22,15,"PAH",23,1,51,0)="========================="
^DIC(9.4,149,22,15,"PAH",23,1,52,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,53,0)="This patch should take less than 1 minute to load."
^DIC(9.4,149,22,15,"PAH",23,1,54,0)=" - No existing data is changed during patch installation."
^DIC(9.4,149,22,15,"PAH",23,1,55,0)=" - None of these routines are or will be mapped."
^DIC(9.4,149,22,15,"PAH",23,1,56,0)=" - Users can be on the system when this patch loads."
^DIC(9.4,149,22,15,"PAH",23,1,57,0)=" - Voluntary Service should not be using the 'Voluntary Data Migration"
^DIC(9.4,149,22,15,"PAH",23,1,58,0)="   Menu'"
^DIC(9.4,149,22,15,"PAH",23,1,59,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,60,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,149,22,15,"PAH",23,1,61,0)="    option will load the KIDS package onto your system."
^DIC(9.4,149,22,15,"PAH",23,1,62,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,63,0)=" 2. From the Kernel Installation and Distribution System (KIDS) menu,"
^DIC(9.4,149,22,15,"PAH",23,1,64,0)="    you may elect to use the following options:"
^DIC(9.4,149,22,15,"PAH",23,1,65,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,66,0)="    a.  Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,149,22,15,"PAH",23,1,67,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,149,22,15,"PAH",23,1,68,0)="        transport global."
^DIC(9.4,149,22,15,"PAH",23,1,69,0)="    b.  Print Transport Global - this option will allow you to view"
^DIC(9.4,149,22,15,"PAH",23,1,70,0)="        the components of the KIDS build."
^DIC(9.4,149,22,15,"PAH",23,1,71,0)="    c.  Backup a Transport Global - this options doesn't need to be"
^DIC(9.4,149,22,15,"PAH",23,1,72,0)="        run because all of the routines in this patch are new."
^DIC(9.4,149,22,15,"PAH",23,1,73,0)="    d.  Compare Transport Global to Current System - this options doesn't"
^DIC(9.4,149,22,15,"PAH",23,1,74,0)="        need to be run because all components in this patch are new."
^DIC(9.4,149,22,15,"PAH",23,1,75,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,76,0)=" 3. Use the Install Package(s) option and select the package"
^DIC(9.4,149,22,15,"PAH",23,1,77,0)="    ABSV*4.0*33."
^DIC(9.4,149,22,15,"PAH",23,1,78,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,79,0)=" 4. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,149,22,15,"PAH",23,1,80,0)="    Install? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",23,1,81,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,82,0)=" 5. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,149,22,15,"PAH",23,1,83,0)="    Install? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",23,1,84,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,85,0)=" 6. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,149,22,15,"PAH",23,1,86,0)="    and Protocols? YES//', respond YES."
^DIC(9.4,149,22,15,"PAH",23,1,87,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,88,0)="    Enter options you wish to mark as 'Out Of Order': ABSV MIGRATION MENU       "
^DIC(9.4,149,22,15,"PAH",23,1,89,0)="    Voluntary Data Migration Menu"
^DIC(9.4,149,22,15,"PAH",23,1,90,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,91,0)="    Enter options you wish to mark as 'Out Of Order': "
^DIC(9.4,149,22,15,"PAH",23,1,92,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,93,0)="    Enter protocols you wish to mark as 'Out Of Order':"
^DIC(9.4,149,22,15,"PAH",23,1,94,0)=" "
^DIC(9.4,149,22,15,"PAH",23,1,95,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,96,0)="  "
^DIC(9.4,149,22,15,"PAH",23,1,97,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,98,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,99,0)="         Voluntary Service Staff Instructions for patch ABSV*4*31 "
^DIC(9.4,149,22,15,"PAH",23,1,100,0)="  "
^DIC(9.4,149,22,15,"PAH",23,1,101,0)="  "
^DIC(9.4,149,22,15,"PAH",23,1,102,0)="  After patch ABSV*4*33 is installed at a site, you need to delete the"
^DIC(9.4,149,22,15,"PAH",23,1,103,0)="  entry in the VOLUNTARY MIGRATION LOG file.  You are going to need"
^DIC(9.4,149,22,15,"PAH",23,1,104,0)="  FileMan access for this, IRM should be able to help you.  There should"
^DIC(9.4,149,22,15,"PAH",23,1,105,0)="  only be one entry in this file, your site station number. After deleting"
^DIC(9.4,149,22,15,"PAH",23,1,106,0)="  it, you need to re-run the 'Prepare for Transition to VSS' option under"
^DIC(9.4,149,22,15,"PAH",23,1,107,0)="  the 'Voluntary Data Migration Menu'.  Please refer to patch ABSV*4.0*31"
^DIC(9.4,149,22,15,"PAH",23,1,108,0)="  documentation."
^DIC(9.4,149,22,15,"PAH",23,1,109,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,110,0)="          VA FileMan Version 22.0"
^DIC(9.4,149,22,15,"PAH",23,1,111,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,112,0)="          Enter or Edit File Entries"
^DIC(9.4,149,22,15,"PAH",23,1,113,0)="          Print File Entries"
^DIC(9.4,149,22,15,"PAH",23,1,114,0)="          Search File Entries"
^DIC(9.4,149,22,15,"PAH",23,1,115,0)="          Modify File Attributes"
^DIC(9.4,149,22,15,"PAH",23,1,116,0)="          Inquire to File Entries"
^DIC(9.4,149,22,15,"PAH",23,1,117,0)="          Utility Functions ..."
^DIC(9.4,149,22,15,"PAH",23,1,118,0)="          Data Dictionary Utilities ..."
^DIC(9.4,149,22,15,"PAH",23,1,119,0)="          Transfer Entries"
^DIC(9.4,149,22,15,"PAH",23,1,120,0)="          Other Options ..."
^DIC(9.4,149,22,15,"PAH",23,1,121,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,122,0)="Select VA FileMan Option: ENTER or Edit File Entries"
^DIC(9.4,149,22,15,"PAH",23,1,123,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,124,0)="INPUT TO WHAT FILE: VOLUNTARY MIGRATION LOG// "
^DIC(9.4,149,22,15,"PAH",23,1,125,0)="EDIT WHICH FIELD: ALL// "
^DIC(9.4,149,22,15,"PAH",23,1,126,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,127,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,128,0)="Select VOLUNTARY MIGRATION LOG SITE NUMBER:    662"
^DIC(9.4,149,22,15,"PAH",23,1,129,0)="SITE NUMBER: 662// @"
^DIC(9.4,149,22,15,"PAH",23,1,130,0)="   SURE YOU WANT TO DELETE THE ENTIRE '662' VOLUNTARY MIGRATION LOG? Y  (Yes)"
^DIC(9.4,149,22,15,"PAH",23,1,131,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,132,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,133,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,134,0)="The following is a dialog of the 'Prepare for Transition to VSS' option:"
^DIC(9.4,149,22,15,"PAH",23,1,135,0)="  "
^DIC(9.4,149,22,15,"PAH",23,1,136,0)="  Voluntary Data Migration Menu "
^DIC(9.4,149,22,15,"PAH",23,1,137,0)="  "
^DIC(9.4,149,22,15,"PAH",23,1,138,0)="    PREP   Prepare for Transition to VSS "
^DIC(9.4,149,22,15,"PAH",23,1,139,0)="    VAL    Validate Existing Data "
^DIC(9.4,149,22,15,"PAH",23,1,140,0)="    PRNT   Print Results of Data Validation "
^DIC(9.4,149,22,15,"PAH",23,1,141,0)="    VOL    Master Volunteer Edit "
^DIC(9.4,149,22,15,"PAH",23,1,142,0)="    DAIL   Daily Time Edit "
^DIC(9.4,149,22,15,"PAH",23,1,143,0)="    OCC    Occasional Hours Edit"
^DIC(9.4,149,22,15,"PAH",23,1,144,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,145,0)=" Select Voluntary Data Migration Menu Option: Prepare for Transition to VSS"
^DIC(9.4,149,22,15,"PAH",23,1,146,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,147,0)=" You are starting the process that will move "
^DIC(9.4,149,22,15,"PAH",23,1,148,0)=" Voluntary Timekeeping data to the new "
^DIC(9.4,149,22,15,"PAH",23,1,149,0)=" Voluntary Service System application."
^DIC(9.4,149,22,15,"PAH",23,1,150,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,151,0)=" First, information about your site will be collected."
^DIC(9.4,149,22,15,"PAH",23,1,152,0)=" Your Volunteer Daily Time file will be scanned to find "
^DIC(9.4,149,22,15,"PAH",23,1,153,0)=" all sites referenced.  This will take some time."
^DIC(9.4,149,22,15,"PAH",23,1,154,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,155,0)=" Done."
^DIC(9.4,149,22,15,"PAH",23,1,156,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,157,0)=" Your primary site number is 605"
^DIC(9.4,149,22,15,"PAH",23,1,158,0)=" Hours are recorded to the following sites:"
^DIC(9.4,149,22,15,"PAH",23,1,159,0)="                    605"
^DIC(9.4,149,22,15,"PAH",23,1,160,0)="                    702"
^DIC(9.4,149,22,15,"PAH",23,1,161,0)="                    999"
^DIC(9.4,149,22,15,"PAH",23,1,162,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,163,0)=" The next section will allow you to designate which of the above sites"
^DIC(9.4,149,22,15,"PAH",23,1,164,0)=" you want data sent from.  Your primary site will default to 'YES' "
^DIC(9.4,149,22,15,"PAH",23,1,165,0)=" Any Games site,(700, 701, 702, or 575W), will default to 'NO'."
^DIC(9.4,149,22,15,"PAH",23,1,166,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,167,0)=" Do you want to continue? YES"
^DIC(9.4,149,22,15,"PAH",23,1,168,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,169,0)=" Making an entry in the Voluntary Migration Log file."
^DIC(9.4,149,22,15,"PAH",23,1,170,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,171,0)=" (You will be asked for information about each station to which hours are"
^DIC(9.4,149,22,15,"PAH",23,1,172,0)=" recorded.  In this example, multiple stations are involved. One is a Games"
^DIC(9.4,149,22,15,"PAH",23,1,173,0)=" station and another is a test site.  Only the primary station has data that"
^DIC(9.4,149,22,15,"PAH",23,1,174,0)=" the user wants to migrate."
^DIC(9.4,149,22,15,"PAH",23,1,175,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,176,0)=" It is also, recommended that you use the station name from the institution"
^DIC(9.4,149,22,15,"PAH",23,1,177,0)=" file.)"
^DIC(9.4,149,22,15,"PAH",23,1,178,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,179,0)="                    Add information for Station Number 605"
^DIC(9.4,149,22,15,"PAH",23,1,180,0)=" STATION NAME: Loma Linda Test"
^DIC(9.4,149,22,15,"PAH",23,1,181,0)=" VISN: 22"
^DIC(9.4,149,22,15,"PAH",23,1,182,0)=" STREET ADDRESS LINE 1: 1 Hospital Way"
^DIC(9.4,149,22,15,"PAH",23,1,183,0)=" STREET ADDRESS LINE 2: <RET>"
^DIC(9.4,149,22,15,"PAH",23,1,184,0)=" CITY: Loma Linda"
^DIC(9.4,149,22,15,"PAH",23,1,185,0)=" STATE: CA"
^DIC(9.4,149,22,15,"PAH",23,1,186,0)=" ZIP CODE: 99999"
^DIC(9.4,149,22,15,"PAH",23,1,187,0)=" USER ADMIN'S LAST NAME: Boss"
^DIC(9.4,149,22,15,"PAH",23,1,188,0)=" USER ADMIN'S FIRST NAME: Big"
^DIC(9.4,149,22,15,"PAH",23,1,189,0)=" USER ADMIN'S MIDDLE NAME: B."
^DIC(9.4,149,22,15,"PAH",23,1,190,0)=" USER ADMIN'S NT USERNAME: vhamaster\vhaisfbossb"
^DIC(9.4,149,22,15,"PAH",23,1,191,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,192,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,193,0)="                    Add information for Station Number 702"
^DIC(9.4,149,22,15,"PAH",23,1,194,0)=" Send this Station's Data?: NO"
^DIC(9.4,149,22,15,"PAH",23,1,195,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,196,0)="                    Add information for Station Number 999"
^DIC(9.4,149,22,15,"PAH",23,1,197,0)=" Send this Station's Data?: YES// NO"
^DIC(9.4,149,22,15,"PAH",23,1,198,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,199,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,200,0)=" Sending a message containing information about your site."
^DIC(9.4,149,22,15,"PAH",23,1,201,0)=" Enter a Recipient of the Institution Creation message: first.last@domain.ext"
^DIC(9.4,149,22,15,"PAH",23,1,202,0)=" Enter a Recipient of the Institution Creation message:"
^DIC(9.4,149,22,15,"PAH",23,1,203,0)="                                SMITH,JOHN (use your own name here)"
^DIC(9.4,149,22,15,"PAH",23,1,204,0)=" Enter a Recipient of the Institution Creation message: <RET>"
^DIC(9.4,149,22,15,"PAH",23,1,205,0)=" Message sent.  Message number: 8250639"
^DIC(9.4,149,22,15,"PAH",23,1,206,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,207,0)=""
^DIC(9.4,149,22,15,"PAH",23,1,208,0)="  If you have any questions or need assistance with this patch please contact"
^DIC(9.4,149,22,15,"PAH",23,1,209,0)="  the CIO National Help desk at 1-888-596-4357, and ask for the Fiscal"
^DIC(9.4,149,22,15,"PAH",23,1,210,0)="  Management Team."
^DIC(9.4,149,22,15,"PAH",23,1,211,0)=""
^DIC(9.4,149,22,15,"PAH",24,0)="35 SEQ #34^3030802^1"
^DIC(9.4,149,22,15,"PAH",24,1,0)="^^74^74^3030802"
^DIC(9.4,149,22,15,"PAH",24,1,1,0)="This patch should be installed at all sites, even if your site has"
^DIC(9.4,149,22,15,"PAH",24,1,2,0)="already migrated to the web-based Voluntary Service System (VSS)."
^DIC(9.4,149,22,15,"PAH",24,1,3,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,4,0)="ABSV*4.0*35 is a patch for patch ABSV*4.0*33.  It will correct a problem"
^DIC(9.4,149,22,15,"PAH",24,1,5,0)="of missing volunteer's hours for sites where the ien is greater than 999999"
^DIC(9.4,149,22,15,"PAH",24,1,6,0)="in the VOLUNTEER DAILY TIME file. It also address the problem of corrupted"
^DIC(9.4,149,22,15,"PAH",24,1,7,0)="data in the VOLUNTARY MASTER file and corruption in Print Template"
^DIC(9.4,149,22,15,"PAH",24,1,8,0)="ABSVM PARKING EXPORT for the VOLUNTARY MASTER file, 503330."
^DIC(9.4,149,22,15,"PAH",24,1,9,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,10,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,11,0)="PATCH DEPENDENCIES:"
^DIC(9.4,149,22,15,"PAH",24,1,12,0)=" ABSV*4.0*33"
^DIC(9.4,149,22,15,"PAH",24,1,13,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,14,0)="NOIS:"
^DIC(9.4,149,22,15,"PAH",24,1,15,0)=" NYH-0603-11946"
^DIC(9.4,149,22,15,"PAH",24,1,16,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,17,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,18,0)="ROUTINE SUMMARY:"
^DIC(9.4,149,22,15,"PAH",24,1,19,0)="================"
^DIC(9.4,149,22,15,"PAH",24,1,20,0)=" The following is a list of the routines that are included in this"
^DIC(9.4,149,22,15,"PAH",24,1,21,0)=" patch.  The second line of each of these routines now looks like:"
^DIC(9.4,149,22,15,"PAH",24,1,22,0)="        ;;4.0;VOLUNTARY TIMEKEEPING;*31*;Jul 1994"
^DIC(9.4,149,22,15,"PAH",24,1,23,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,24,0)="Routine Name    Before Patch    After Patch     Patch List"
^DIC(9.4,149,22,15,"PAH",24,1,25,0)="============    ============    ===========     ============"
^DIC(9.4,149,22,15,"PAH",24,1,26,0)="ABSVMHV1        17609281        17425691        **31,33,35**"
^DIC(9.4,149,22,15,"PAH",24,1,27,0)="ABSVMVV2        11297170        11722394        **31,33,35**"
^DIC(9.4,149,22,15,"PAH",24,1,28,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,29,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,30,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,149,22,15,"PAH",24,1,31,0)="========================="
^DIC(9.4,149,22,15,"PAH",24,1,32,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,33,0)="This patch should take less than 1 minute to load."
^DIC(9.4,149,22,15,"PAH",24,1,34,0)=" - No existing data is changed during patch installation."
^DIC(9.4,149,22,15,"PAH",24,1,35,0)=" - None of these routines are or will be mapped."
^DIC(9.4,149,22,15,"PAH",24,1,36,0)=" - Users can be on the system when this patch loads."
^DIC(9.4,149,22,15,"PAH",24,1,37,0)=" - Voluntary Service should not be using the 'Voluntary Data Migration"
^DIC(9.4,149,22,15,"PAH",24,1,38,0)="   Menu'"
^DIC(9.4,149,22,15,"PAH",24,1,39,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,40,0)=" 1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,149,22,15,"PAH",24,1,41,0)="    option will load the KIDS package onto your system."
^DIC(9.4,149,22,15,"PAH",24,1,42,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,43,0)=" 2. From the Kernel Installation and Distribution System (KIDS) menu,"
^DIC(9.4,149,22,15,"PAH",24,1,44,0)="    you may elect to use the following options:"
^DIC(9.4,149,22,15,"PAH",24,1,45,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,46,0)="    a.  Verify Checksums in Transport Global - this option will allow"
^DIC(9.4,149,22,15,"PAH",24,1,47,0)="        you to ensure the integrity of the routines that are in the"
^DIC(9.4,149,22,15,"PAH",24,1,48,0)="        transport global."
^DIC(9.4,149,22,15,"PAH",24,1,49,0)="    b.  Print Transport Global - this option will allow you to view"
^DIC(9.4,149,22,15,"PAH",24,1,50,0)="        the components of the KIDS build."
^DIC(9.4,149,22,15,"PAH",24,1,51,0)="    c.  Backup a Transport Global - this options doesn't need to be"
^DIC(9.4,149,22,15,"PAH",24,1,52,0)="        run because all of the routines in this patch are new."
^DIC(9.4,149,22,15,"PAH",24,1,53,0)="    d.  Compare Transport Global to Current System - this options doesn't"
^DIC(9.4,149,22,15,"PAH",24,1,54,0)="        need to be run because all components in this patch are new."
^DIC(9.4,149,22,15,"PAH",24,1,55,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,56,0)=" 3. Use the Install Package(s) option and select the package"
^DIC(9.4,149,22,15,"PAH",24,1,57,0)="    ABSV*4.0*35."
^DIC(9.4,149,22,15,"PAH",24,1,58,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,59,0)=" 4. When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,149,22,15,"PAH",24,1,60,0)="    Install? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",24,1,61,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,62,0)=" 5. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,149,22,15,"PAH",24,1,63,0)="    Install? YES//', respond NO."
^DIC(9.4,149,22,15,"PAH",24,1,64,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,65,0)=" 6. When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,149,22,15,"PAH",24,1,66,0)="    and Protocols? YES//', respond YES."
^DIC(9.4,149,22,15,"PAH",24,1,67,0)=""
^DIC(9.4,149,22,15,"PAH",24,1,68,0)="    Enter options you wish to mark as 'Out Of Order': ABSV MIGRATION MENU       "
^DIC(9.4,149,22,15,"PAH",24,1,69,0)="    Voluntary Data Migration Menu"
^DIC(9.4,149,22,15,"PAH",24,1,70,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,71,0)="    Enter options you wish to mark as 'Out Of Order': "
^DIC(9.4,149,22,15,"PAH",24,1,72,0)=" "
^DIC(9.4,149,22,15,"PAH",24,1,73,0)="    Enter protocols you wish to mark as 'Out Of Order':"
^DIC(9.4,149,22,15,"PAH",24,1,74,0)=""
