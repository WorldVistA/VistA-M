^DIC(9.4,3,22,21,"PAH",546,1,1,0)="This patch fixes the following menu options"
^DIC(9.4,3,22,21,"PAH",546,1,2,0)="List Unreferenced Menu Options [XQ LIST UNREFERENCED OPTIONS] "
^DIC(9.4,3,22,21,"PAH",546,1,3,0)="Delete Unreferenced Options  [XQ UNREF'D OPTIONS].  Currently,"
^DIC(9.4,3,22,21,"PAH",546,1,4,0)="when running these options, the option names starting with numbers"
^DIC(9.4,3,22,21,"PAH",546,1,5,0)="do not appear on the list.  Code was modified in routine XQ33 to include"
^DIC(9.4,3,22,21,"PAH",546,1,6,0)="options whose names start with numbers."
