^DIC(9.4,11,22,5.03,"PAH",33,1,179,0)="===================="
^DIC(9.4,11,22,5.03,"PAH",33,1,180,0)=" "
^DIC(9.4,11,22,5.03,"PAH",33,1,181,0)="See LABORATORY POINT OF CARE (POC) INTERFACE INSTALLATION AND USER GUIDE"
^DIC(9.4,11,22,5.03,"PAH",33,1,182,0)="    PATCH LA*5.2*67 AND PATCH LR*5.2*290  Version 5.2  JUNE 2005"
^DIC(9.4,11,22,5.03,"PAH",34,0)="72 SEQ #54^3060614^1"
^DIC(9.4,11,22,5.03,"PAH",34,1,0)="^^201^201^3060614"
^DIC(9.4,11,22,5.03,"PAH",34,1,1,0)="Blood Bank Team Coordination"
^DIC(9.4,11,22,5.03,"PAH",34,1,2,0)="============================"
^DIC(9.4,11,22,5.03,"PAH",34,1,3,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*72 does not "
^DIC(9.4,11,22,5.03,"PAH",34,1,4,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA "
^DIC(9.4,11,22,5.03,"PAH",34,1,5,0)="DIRECTIVE 2004-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,11,22,5.03,"PAH",34,1,6,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,7,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*72 does not "
^DIC(9.4,11,22,5.03,"PAH",34,1,8,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,11,22,5.03,"PAH",34,1,9,0)="elements functions."
^DIC(9.4,11,22,5.03,"PAH",34,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,11,0)="RISK ANALYSIS: Changes made by patch LA*5.2*72 have no effect on Blood "
^DIC(9.4,11,22,5.03,"PAH",34,1,12,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",34,1,13,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,14,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,11,22,5.03,"PAH",34,1,15,0)="made, no specific validation requirements exist as a result of "
^DIC(9.4,11,22,5.03,"PAH",34,1,16,0)="installation of this patch. "
^DIC(9.4,11,22,5.03,"PAH",34,1,17,0)="************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",34,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,19,0)="Sites reported errors logged in the error trap when receiving lab results "
^DIC(9.4,11,22,5.03,"PAH",34,1,20,0)="back from another VA host lab via Lab Electronic Data Interchange (LEDI):"
^DIC(9.4,11,22,5.03,"PAH",34,1,21,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,22,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,23,0)="$ZE= <UNDEFINED>PRDID+11^LA7VIN5A"
^DIC(9.4,11,22,5.03,"PAH",34,1,24,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,25,0)=" . I $P(LA7PRDID,LA7CS,LA7I+2)=""99VA4"" S "
^DIC(9.4,11,22,5.03,"PAH",34,1,26,0)="LA74=$$LKUP^XUAF4($P(LA7PRDID,LA7CS,I))"
^DIC(9.4,11,22,5.03,"PAH",34,1,27,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,28,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,29,0)="The following portion of code in PRDID^LA7VIN5A has been changed to "
^DIC(9.4,11,22,5.03,"PAH",34,1,30,0)="reference the correct variable (LA7I instead of I): "
^DIC(9.4,11,22,5.03,"PAH",34,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,32,0)="**PREVIOUS CODE**"
^DIC(9.4,11,22,5.03,"PAH",34,1,33,0)="F LA7I=1,4 D  Q:LA74                                                   "
^DIC(9.4,11,22,5.03,"PAH",34,1,34,0)=". I $P(LA7PRDID,LA7CS,LA7I+2)=""99VA4"" S "
^DIC(9.4,11,22,5.03,"PAH",34,1,35,0)="LA74=$$LKUP^XUAF4($P(LA7PRDID,LA7CS,I))"
^DIC(9.4,11,22,5.03,"PAH",34,1,36,0)=". I 'LA74 S LA74=$$LKUP^XUAF4($P(LA7PRDID,LA7CS,I+1))                  "
^DIC(9.4,11,22,5.03,"PAH",34,1,37,0)=". I 'LA74 S LA74=$$FINDSITE^LA7VHLU2($P(LA7PRDID,LA7CS),1,1)           "
^DIC(9.4,11,22,5.03,"PAH",34,1,38,0)=". I 'LA74 S LA74=$$FINDSITE^LA7VHLU2($P(LA7SFAC,LA7CS),1,1)"
^DIC(9.4,11,22,5.03,"PAH",34,1,39,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,41,0)="**NEW CODE**"
^DIC(9.4,11,22,5.03,"PAH",34,1,42,0)="F LA7I=1,4 D  Q:LA74"
^DIC(9.4,11,22,5.03,"PAH",34,1,43,0)=". I $P(LA7PRDID,LA7CS,LA7I+2)=""99VA4"" S "
^DIC(9.4,11,22,5.03,"PAH",34,1,44,0)="LA74=$$LKUP^XUAF4($P(LA7PRDID,LA7CS,LA7I))"
^DIC(9.4,11,22,5.03,"PAH",34,1,45,0)=". I 'LA74 S LA74=$$LKUP^XUAF4($P(LA7PRDID,LA7CS,LA7I+1))"
^DIC(9.4,11,22,5.03,"PAH",34,1,46,0)=". I 'LA74 S LA74=$$FINDSITE^LA7VHLU2($P(LA7PRDID,LA7CS),1,1)"
^DIC(9.4,11,22,5.03,"PAH",34,1,47,0)=". I 'LA74 S LA74=$$FINDSITE^LA7VHLU2($P(LA7SFAC,LA7CS),1,1)"
^DIC(9.4,11,22,5.03,"PAH",34,1,48,0)=" "
