^DIC(9.4,115,22,2,"PAH",80,0)="98 SEQ #81^3090423.114609^17"
^DIC(9.4,115,22,2,"PAH",80,1,0)="^^1^1^3090423"
^DIC(9.4,115,22,2,"PAH",80,1,1,0)="RADIOLOGY ORDER FILE CLEANUP"
^DIC(9.4,115,22,2,"PAH",81,0)="70 SEQ #82^3090423.134405^17"
^DIC(9.4,115,22,2,"PAH",81,1,0)="^^16^16^3090423"
^DIC(9.4,115,22,2,"PAH",81,1,1,0)=" The installation of the Project 112/Shipboard Hazard and Defense (SHAD) "
^DIC(9.4,115,22,2,"PAH",81,1,2,0)=" clinical application enhancements will provide sites of the ability to "
^DIC(9.4,115,22,2,"PAH",81,1,3,0)=" collect and store SHAD exposure information related to provided medical "
^DIC(9.4,115,22,2,"PAH",81,1,4,0)=" care, and to share that information with PCE. Further modifications will "
^DIC(9.4,115,22,2,"PAH",81,1,5,0)=" include a change of the Environmental Contaminants (EC) label to be "
^DIC(9.4,115,22,2,"PAH",81,1,6,0)=" Southwest Asia Condition (SWAC). All internal values for ""EC"" will remain"
^DIC(9.4,115,22,2,"PAH",81,1,7,0)=" and only external values will be modified to SWAC."
^DIC(9.4,115,22,2,"PAH",81,1,8,0)="  "
^DIC(9.4,115,22,2,"PAH",81,1,9,0)=" Some changes will be noticeable to the user community due to the "
^DIC(9.4,115,22,2,"PAH",81,1,10,0)=" modifications made for this project.  New prompts will be displayed and "
^DIC(9.4,115,22,2,"PAH",81,1,11,0)=" screen/report formatting will occur.  The new PRIMARY DX RELATED TO "
^DIC(9.4,115,22,2,"PAH",81,1,12,0)=" SHAD field (#100) of the RAD/NUC MED ORDERS file (#75.1) will appear"
^DIC(9.4,115,22,2,"PAH",81,1,13,0)=" on Radiology Reports. No additional processing time should be noticed as"
^DIC(9.4,115,22,2,"PAH",81,1,14,0)=" a result of these modifications. The Southwest Asia Condition label will "
^DIC(9.4,115,22,2,"PAH",81,1,15,0)=" appear on reports and screen prompts in place of the Environmental "
^DIC(9.4,115,22,2,"PAH",81,1,16,0)=" Contaminants label."
