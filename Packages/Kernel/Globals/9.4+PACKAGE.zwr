^DIC(9.4,83,5)="BIRMINGHAM"
^DIC(9.4,83,7)=""
^DIC(9.4,83,11)="58.8^58.89"
^DIC(9.4,83,22,0)="^9.49I^16^2"
^DIC(9.4,83,22,2,0)="2.0^2941207^2960718"
^DIC(9.4,83,22,16,0)="3.0^3051119^2970408^1"
^DIC(9.4,83,22,16,1,0)="^^22^22^3051119"
^DIC(9.4,83,22,16,1,1,0)="     The Controlled Substances software will monitor and track the receipt,"
^DIC(9.4,83,22,16,1,2,0)="inventory, and dispensing of controlled substances.  Automation of the"
^DIC(9.4,83,22,16,1,3,0)="narcotic inventory process will permit pharmacists and inspectors to"
^DIC(9.4,83,22,16,1,4,0)="perform vault inventories utilizing portable bar code readers.  Monthly (or"
^DIC(9.4,83,22,16,1,5,0)="more frequent) inspections can be conducted by management, with"
^DIC(9.4,83,22,16,1,6,0)="discrepancies in stock levels automatically identified.  This software"
^DIC(9.4,83,22,16,1,7,0)="package addresses a Congressional material weakness for Drug"
^DIC(9.4,83,22,16,1,8,0)="Accountability."
^DIC(9.4,83,22,16,1,9,0)=" "
^DIC(9.4,83,22,16,1,10,0)="NEW FUNCTIONS"
^DIC(9.4,83,22,16,1,11,0)=" "
^DIC(9.4,83,22,16,1,12,0)="o Batch Order Entry process"
^DIC(9.4,83,22,16,1,13,0)=" "
^DIC(9.4,83,22,16,1,14,0)="o Electronic Signature"
^DIC(9.4,83,22,16,1,15,0)=" "
^DIC(9.4,83,22,16,1,16,0)="o Nurse Dispensing with a Radio Frequency Device"
^DIC(9.4,83,22,16,1,17,0)=" "
^DIC(9.4,83,22,16,1,18,0)="o HL7 Interface to Narcotic Dispensing Equipment"
^DIC(9.4,83,22,16,1,19,0)=" "
^DIC(9.4,83,22,16,1,20,0)="o Electronic Error & Enhancement Requests (E3Rs)"
^DIC(9.4,83,22,16,1,21,0)=" "
^DIC(9.4,83,22,16,1,22,0)="o Other Enhancements"
^DIC(9.4,83,22,16,"PAH",0)="^9.4901^78^78"
^DIC(9.4,83,22,16,"PAH",1,0)="1^2971007^1"
^DIC(9.4,83,22,16,"PAH",1,1,0)="^^1^1^2971007"
^DIC(9.4,83,22,16,"PAH",1,1,1,0)="MODIFICATION TO - GREEN SHEET READY FOR PICKUP LOG"
^DIC(9.4,83,22,16,"PAH",2,0)="6 SEQ #2^2971021^1"
^DIC(9.4,83,22,16,"PAH",2,1,0)="^^2^2^2971021"
^DIC(9.4,83,22,16,"PAH",2,1,1,0)="Routine modified to interface with Drug Accountability/Inventory"
^DIC(9.4,83,22,16,"PAH",2,1,2,0)="Interface (DA) Version 3 to be released in 1997."
^DIC(9.4,83,22,16,"PAH",3,0)="4 SEQ #3^2971127^1"
^DIC(9.4,83,22,16,"PAH",3,1,0)="^^2^2^2971127"
^DIC(9.4,83,22,16,"PAH",3,1,1,0)="When drugs are returned to pharmacy, the drug inventory balance will"
^DIC(9.4,83,22,16,"PAH",3,1,2,0)="decrement automatically for the NAOU/Ward."
^DIC(9.4,83,22,16,"PAH",4,0)="2 SEQ #4^2980112^1"
^DIC(9.4,83,22,16,"PAH",4,1,0)="^^7^7^2980112"
^DIC(9.4,83,22,16,"PAH",4,1,1,0)="This build contains modifications to the routines PSDAPU and PSDIPOST."
^DIC(9.4,83,22,16,"PAH",4,1,2,0)="Pharmacy Data Management (PDM) V. 1.0 will provide the routine ^PSSGIU for"
^DIC(9.4,83,22,16,"PAH",4,1,3,0)="flagging drugs. This function was previously done using an Inpatient"
^DIC(9.4,83,22,16,"PAH",4,1,4,0)="Medications routine ^PSGIU.  "
^DIC(9.4,83,22,16,"PAH",4,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",4,1,6,0)="This patch (PSD*3*2) is designed to work with or without installation of"
^DIC(9.4,83,22,16,"PAH",4,1,7,0)="Pharmacy Data Management V. 1.0."
^DIC(9.4,83,22,16,"PAH",5,0)="5^2980112^1"
^DIC(9.4,83,22,16,"PAH",5,1,0)="^^5^5^2980112"
^DIC(9.4,83,22,16,"PAH",5,1,1,0)="This patch corrects a problem when using the Not Given, Return to Stock"
^DIC(9.4,83,22,16,"PAH",5,1,2,0)="option [PSD NURSE NOT GIVEN].  The software was not working consistently"
^DIC(9.4,83,22,16,"PAH",5,1,3,0)="when an attempt was made to return a drug to a different NAOU from the one"
^DIC(9.4,83,22,16,"PAH",5,1,4,0)="it was dispensed from.  The current design of the software should not"
^DIC(9.4,83,22,16,"PAH",5,1,5,0)="allow a return to a different NAOU. "
^DIC(9.4,83,22,16,"PAH",6,0)="8 SEQ #6^2980403^1"
^DIC(9.4,83,22,16,"PAH",6,1,0)="^^2^2^2980403"
^DIC(9.4,83,22,16,"PAH",6,1,1,0)="The routines were modified to address the Year 2000 compliance issues"
^DIC(9.4,83,22,16,"PAH",6,1,2,0)="regarding dates. All VA FORM'S will now display the year as four digits."
^DIC(9.4,83,22,16,"PAH",7,0)="9 SEQ #7^2980428^1"
^DIC(9.4,83,22,16,"PAH",7,1,0)="^^1^1^2980428"
^DIC(9.4,83,22,16,"PAH",7,1,1,0)="Modified routine to eliminate the UNDEFINED ERROR for EXP."
^DIC(9.4,83,22,16,"PAH",8,0)="3^2980712^1"
^DIC(9.4,83,22,16,"PAH",8,1,0)="^^9^9^2980712"
^DIC(9.4,83,22,16,"PAH",8,1,1,0)=" "
^DIC(9.4,83,22,16,"PAH",8,1,2,0)="This patch contains modifications to two options, Send Inspections"
^DIC(9.4,83,22,16,"PAH",8,1,3,0)="Inventory TRAKKER Data to DHCP [PSD IRL INSP DATA] and Send Vault TRAKKER"
^DIC(9.4,83,22,16,"PAH",8,1,4,0)="Inventory Data to DHCP [PSD IRL INV DATA]. It removes the check for the"
^DIC(9.4,83,22,16,"PAH",8,1,5,0)="PSDMGR security key when using this option and corrects a problem of the"
^DIC(9.4,83,22,16,"PAH",8,1,6,0)="dispensing site being left undefined."
^DIC(9.4,83,22,16,"PAH",8,1,7,0)=" "
^DIC(9.4,83,22,16,"PAH",8,1,8,0)="Also, the CS IRL PROGRAM file (#58.88) is modified to send an end of "
^DIC(9.4,83,22,16,"PAH",8,1,9,0)="transmission message to DHCP, to correct a problem with OpenM sites."
^DIC(9.4,83,22,16,"PAH",9,0)="7 SEQ #9^2981007^1"
^DIC(9.4,83,22,16,"PAH",9,1,0)="^^1^1^2981007"
^DIC(9.4,83,22,16,"PAH",9,1,1,0)="Correct balances on the Activity report."
^DIC(9.4,83,22,16,"PAH",10,0)="10^2990201^1"
^DIC(9.4,83,22,16,"PAH",10,1,0)="^^1^1^2990201"
^DIC(9.4,83,22,16,"PAH",10,1,1,0)="PROBLEM WITH RELEASE FUNCTION #2."
^DIC(9.4,83,22,16,"PAH",11,0)="11 SEQ #11^2990316^1"
^DIC(9.4,83,22,16,"PAH",11,1,0)="^^3^3^2990316"
^DIC(9.4,83,22,16,"PAH",11,1,1,0)="This is an enhancement patch to check prescription status before"
^DIC(9.4,83,22,16,"PAH",11,1,2,0)="posting/releasing for sites running Controlled Substances Version 3.0"
^DIC(9.4,83,22,16,"PAH",11,1,3,0)="and Outpatient Pharmacy Version 7.0."
^DIC(9.4,83,22,16,"PAH",12,0)="13 SEQ #12^2990420^1"
^DIC(9.4,83,22,16,"PAH",12,1,0)="^^1^1^2990420"
^DIC(9.4,83,22,16,"PAH",12,1,1,0)="User received an $ZE= <UNDEFINED>LOOP+16^PSDFIL2"
^DIC(9.4,83,22,16,"PAH",13,0)="19 SEQ #13^2990622^1"
^DIC(9.4,83,22,16,"PAH",13,1,0)="^^3^3^2990622"
^DIC(9.4,83,22,16,"PAH",13,1,1,0)="  This patch corrects an undefined error in routine PSDFIL2. The problem"
^DIC(9.4,83,22,16,"PAH",13,1,2,0)=" was originally addressed in patch PSD*3*13. However, this patch created"
^DIC(9.4,83,22,16,"PAH",13,1,3,0)=" another problem, and has since been marked as entered in error."
^DIC(9.4,83,22,16,"PAH",14,0)="12 SEQ #14^2990622^1"
^DIC(9.4,83,22,16,"PAH",14,1,0)="^^2^2^2990622"
^DIC(9.4,83,22,16,"PAH",14,1,1,0)=" "
^DIC(9.4,83,22,16,"PAH",14,1,2,0)="NOIS call PTH-0897-21047; OKL-0998-71256; NCH-1197-41081"
^DIC(9.4,83,22,16,"PAH",15,0)="15 SEQ #15^2990719^1"
^DIC(9.4,83,22,16,"PAH",15,1,0)="^^4^4^2990719"
^DIC(9.4,83,22,16,"PAH",15,1,1,0)="The option Outpatient Rx's [PSD OUTPATIENT] has been enhanced to alert the"
^DIC(9.4,83,22,16,"PAH",15,1,2,0)="pharmacist that a prescription has been canceled and prompts to determine"
^DIC(9.4,83,22,16,"PAH",15,1,3,0)="whether the medication should be released and controlled substances"
^DIC(9.4,83,22,16,"PAH",15,1,4,0)="balances updated."
^DIC(9.4,83,22,16,"PAH",16,0)="16 SEQ #16^2991003^1"
^DIC(9.4,83,22,16,"PAH",16,1,0)="^^9^9^2991003"
^DIC(9.4,83,22,16,"PAH",16,1,1,0)=" Due to the placement of locks on globals when updating balances, the "
^DIC(9.4,83,22,16,"PAH",16,1,2,0)=" time frame between the initial balance changes and the actual"
^DIC(9.4,83,22,16,"PAH",16,1,3,0)=" locking of the global can result in other users accessing similar "
^DIC(9.4,83,22,16,"PAH",16,1,4,0)=" options that also change the balances. The result is erroneous data"
^DIC(9.4,83,22,16,"PAH",16,1,5,0)=" being stored in the drugs balance."
^DIC(9.4,83,22,16,"PAH",16,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",16,1,7,0)=" Resolution: The locks on several options have been moved up to the point"
^DIC(9.4,83,22,16,"PAH",16,1,8,0)=" where the drug is first selected. This will ensure no other balance"
^DIC(9.4,83,22,16,"PAH",16,1,9,0)=" adjustments will be made to that drug until the user is finished with it."
^DIC(9.4,83,22,16,"PAH",17,0)="17 SEQ #17^2991003^1"
^DIC(9.4,83,22,16,"PAH",17,1,0)="^^4^4^2991003"
^DIC(9.4,83,22,16,"PAH",17,1,1,0)="  When the Controlled Subs AMIS report is executed, if a drug is found"
^DIC(9.4,83,22,16,"PAH",17,1,2,0)=" that has a cost of zero, a message prints showing the drug's cost was"
^DIC(9.4,83,22,16,"PAH",17,1,3,0)=" zero. The report does not specify which transaction or date. The"
^DIC(9.4,83,22,16,"PAH",17,1,4,0)=" report is being re-worked for more detail."
^DIC(9.4,83,22,16,"PAH",18,0)="18 SEQ #18^2991210^1"
^DIC(9.4,83,22,16,"PAH",18,1,0)="^^1^1^2991210"
^DIC(9.4,83,22,16,"PAH",18,1,1,0)=" Cannot send reports to the terminal screen."
^DIC(9.4,83,22,16,"PAH",19,0)="23 SEQ #19^3000229^1"
^DIC(9.4,83,22,16,"PAH",19,1,0)="^^2^2^3000229"
^DIC(9.4,83,22,16,"PAH",19,1,1,0)=" The release of DI*22*2 causes checks for $T after a DIC call to be "
^DIC(9.4,83,22,16,"PAH",19,1,2,0)=" invalid."
^DIC(9.4,83,22,16,"PAH",20,0)="20 SEQ #20^3000229^1"
^DIC(9.4,83,22,16,"PAH",20,1,0)="^^9^9^3000229"
^DIC(9.4,83,22,16,"PAH",20,1,1,0)="Problem"
^DIC(9.4,83,22,16,"PAH",20,1,2,0)="======="
^DIC(9.4,83,22,16,"PAH",20,1,3,0)="The terminology for the description of a priority order is not consistent."
^DIC(9.4,83,22,16,"PAH",20,1,4,0)="The orders are described as ""emergency"", ""unscheduled"" or ""priority""."
^DIC(9.4,83,22,16,"PAH",20,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",20,1,6,0)="Solution"
^DIC(9.4,83,22,16,"PAH",20,1,7,0)="========"
^DIC(9.4,83,22,16,"PAH",20,1,8,0)="The consensus is to use ""priority"" for the description of these orders."
^DIC(9.4,83,22,16,"PAH",20,1,9,0)="The use of ""emergency"" and ""unscheduled"" will be replaced by ""priority""."
^DIC(9.4,83,22,16,"PAH",21,0)="21 SEQ #21^3000516^1"
^DIC(9.4,83,22,16,"PAH",21,1,0)="^^29^29^3000516"
^DIC(9.4,83,22,16,"PAH",21,1,1,0)="This patch is part of the CMOP - Controlled Substance Rxs enhancements."
^DIC(9.4,83,22,16,"PAH",21,1,2,0)="It modifies functions within he Controlled Substances application"
^DIC(9.4,83,22,16,"PAH",21,1,3,0)="to support the transmission of controlled substance prescriptions to the"
^DIC(9.4,83,22,16,"PAH",21,1,4,0)="Consolidated Mail Outpatient Pharmacy facilities."
^DIC(9.4,83,22,16,"PAH",21,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",21,1,6,0)="This patch will be installed in conjunction with three other patches"
^DIC(9.4,83,22,16,"PAH",21,1,7,0)="(PSX*2*23, PSO*7*33, and PSS*1*28). Refer to the CMOP - Controlled"
^DIC(9.4,83,22,16,"PAH",21,1,8,0)="Substance Rxs Installation Guide for installation instructions."
^DIC(9.4,83,22,16,"PAH",21,1,9,0)=" "
^DIC(9.4,83,22,16,"PAH",21,1,10,0)="The Installation Guide for the CMOP - Controlled Substance Rxs project can"
^DIC(9.4,83,22,16,"PAH",21,1,11,0)="be obtained on the VISTA Consolidated Mail Outpatient Pharmacy web page.  "
^DIC(9.4,83,22,16,"PAH",21,1,12,0)="The address is http://vista2.domain.ext/cmop/."
^DIC(9.4,83,22,16,"PAH",21,1,13,0)=" "
^DIC(9.4,83,22,16,"PAH",21,1,14,0)="The Installation Guide is also available on the ANONYMOUS.SOFTWARE"
^DIC(9.4,83,22,16,"PAH",21,1,15,0)="directory at one of the following Office of Information (OI) Field"
^DIC(9.4,83,22,16,"PAH",21,1,16,0)="Offices."
^DIC(9.4,83,22,16,"PAH",21,1,17,0)="The file name is CMOPCS_IG.PDF."
^DIC(9.4,83,22,16,"PAH",21,1,18,0)=" "
^DIC(9.4,83,22,16,"PAH",21,1,19,0)="OI FIELD OFFICE                FTP ADDRESS             DIRECTORY"
^DIC(9.4,83,22,16,"PAH",21,1,20,0)="===============                ===========             ========="
^DIC(9.4,83,22,16,"PAH",21,1,21,0)="Albany                         152.127.1.5             anonymous.software"
^DIC(9.4,83,22,16,"PAH",21,1,22,0)="Hines                          152.129.1.110           anonymous.software"
^DIC(9.4,83,22,16,"PAH",21,1,23,0)="Salt Lake City                 152.131.2.1             anonymous.software"
^DIC(9.4,83,22,16,"PAH",21,1,24,0)=" "
^DIC(9.4,83,22,16,"PAH",21,1,25,0)="Controlled Substance Modifications in Support of CMOP-Controlled Substance"
^DIC(9.4,83,22,16,"PAH",21,1,26,0)="Rxs: The Outpatient Rx's option [PSD OUTPATIENT] was modified to prevent"
^DIC(9.4,83,22,16,"PAH",21,1,27,0)="the releasing of a controlled substance if the CMOP status is transmitted,"
^DIC(9.4,83,22,16,"PAH",21,1,28,0)="dispensed or retransmitted. Controlled substance prescriptions with the"
^DIC(9.4,83,22,16,"PAH",21,1,29,0)="status of 'Not dispensed' shall be releasable."
^DIC(9.4,83,22,16,"PAH",22,0)="22 SEQ #22^3000516^1"
^DIC(9.4,83,22,16,"PAH",22,1,0)="^^6^6^3000516"
^DIC(9.4,83,22,16,"PAH",22,1,1,0)=" There are two problems with the Inspector's Log by Rec'd Date [PSD INSP"
^DIC(9.4,83,22,16,"PAH",22,1,2,0)=" LOG BY RECD DATE] option."
^DIC(9.4,83,22,16,"PAH",22,1,3,0)=" "
^DIC(9.4,83,22,16,"PAH",22,1,4,0)=" The problems stem from the DRUG ACCOUNTABILITY STATS file (#58.8) ORDER "
^DIC(9.4,83,22,16,"PAH",22,1,5,0)=" STATUS (#10) field. This field's cross reference is used as a basis for"
^DIC(9.4,83,22,16,"PAH",22,1,6,0)=" the report."
^DIC(9.4,83,22,16,"PAH",23,0)="25 SEQ #23^3000525^1"
^DIC(9.4,83,22,16,"PAH",23,1,0)="^^6^6^3000525"
^DIC(9.4,83,22,16,"PAH",23,1,1,0)=" When a drug was signed out for a patient from an incorrect ward, returned"
^DIC(9.4,83,22,16,"PAH",23,1,2,0)=" to that ward, and then signed out for the correct ward, problems occur in"
^DIC(9.4,83,22,16,"PAH",23,1,3,0)=" the Record Defective Dose [PSD NURSE DEFECTIVE DOSE], Delayed Sign Out"
^DIC(9.4,83,22,16,"PAH",23,1,4,0)=" Dose for Patient [PSD NURSE DELAYED DISPENSE], Sign Out Dose for Patient"
^DIC(9.4,83,22,16,"PAH",23,1,5,0)=" [PSD NURSE DISPENSING], Not Given, Return to Stock [PSD NURSE NOT GIVEN],"
^DIC(9.4,83,22,16,"PAH",23,1,6,0)=" Record Delayed Wastage, [PSD NURSE WASTE] options."
^DIC(9.4,83,22,16,"PAH",24,0)="14 SEQ #24^3000525^1"
^DIC(9.4,83,22,16,"PAH",24,1,0)="^^2^2^3000525"
^DIC(9.4,83,22,16,"PAH",24,1,1,0)=" When the Daily Activity Log (in lieu of VA FORM 10-2320) [PSD DAILY LOG]"
^DIC(9.4,83,22,16,"PAH",24,1,2,0)=" option is executed, an undefined variable error occurs."
^DIC(9.4,83,22,16,"PAH",25,0)="26 SEQ #25^3000612^1"
^DIC(9.4,83,22,16,"PAH",25,1,0)="^^8^8^3000612"
^DIC(9.4,83,22,16,"PAH",25,1,1,0)=" When the Rx (Prescription) Outpatient Dispensing Report [PSD RX "
^DIC(9.4,83,22,16,"PAH",25,1,2,0)=" DISPENSING REPORT] option is generated, data is being excluded for"
^DIC(9.4,83,22,16,"PAH",25,1,3,0)=" some transactions because there is more than one entry with the"
^DIC(9.4,83,22,16,"PAH",25,1,4,0)=" exact date and time. The reports initial search base is one the date"
^DIC(9.4,83,22,16,"PAH",25,1,5,0)=" and time, therefore only the first record will be checked."
^DIC(9.4,83,22,16,"PAH",25,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",25,1,7,0)=" The solution is to expand the loop to check other factors such as the"
^DIC(9.4,83,22,16,"PAH",25,1,8,0)=" pharmacy location or drug."
^DIC(9.4,83,22,16,"PAH",26,0)="28 SEQ #26^3000711^1"
^DIC(9.4,83,22,16,"PAH",26,1,0)="^^12^12^3000711"
^DIC(9.4,83,22,16,"PAH",26,1,1,0)=" When the inspector's log is printed, items marked as perpetual inventory"
^DIC(9.4,83,22,16,"PAH",26,1,2,0)=" are excluded from the report. This patch will allow items marked as"
^DIC(9.4,83,22,16,"PAH",26,1,3,0)=" perpetual inventory to be included on the report if the order status is"
^DIC(9.4,83,22,16,"PAH",26,1,4,0)=" also marked as ""DELIVERED - ACTIVELY ON NAOU""."
^DIC(9.4,83,22,16,"PAH",26,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",26,1,6,0)=" Another problem corrected by this patch is with the process of marking"
^DIC(9.4,83,22,16,"PAH",26,1,7,0)=" a green sheet completed. If the user selects the completion status ""OTHER "
^DIC(9.4,83,22,16,"PAH",26,1,8,0)=" - REFERRED TO PHARMACY SUPERVISOR"", and enters an up-arrow ('^') at the"
^DIC(9.4,83,22,16,"PAH",26,1,9,0)=" prompt for entering a referred reason the system creates an error. The"
^DIC(9.4,83,22,16,"PAH",26,1,10,0)=" error is that the entry in the DRUG ACCOUNTABILITY TRANSACTION (#58.81)"
^DIC(9.4,83,22,16,"PAH",26,1,11,0)=" file will be upgraded to the selected order and completion statuses, the"
^DIC(9.4,83,22,16,"PAH",26,1,12,0)=" entry in the DRUG ACCOUNTABILITY ORDERS (#58.8) will remain as it was. "
^DIC(9.4,83,22,16,"PAH",27,0)="24 SEQ #27^3001004^1"
^DIC(9.4,83,22,16,"PAH",27,1,0)="^^26^26^3001004"
^DIC(9.4,83,22,16,"PAH",27,1,1,0)="Problem:"
^DIC(9.4,83,22,16,"PAH",27,1,2,0)="======="
^DIC(9.4,83,22,16,"PAH",27,1,3,0)="In Outpatient Pharmacy when Rx refills are returned to stock the refill"
^DIC(9.4,83,22,16,"PAH",27,1,4,0)="is deleted. This deletion is not reflected in Controlled Substances "
^DIC(9.4,83,22,16,"PAH",27,1,5,0)="and thus reports and Rx balances are not reflecting these changes."
^DIC(9.4,83,22,16,"PAH",27,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",27,1,7,0)="Solution:"
^DIC(9.4,83,22,16,"PAH",27,1,8,0)="========"
^DIC(9.4,83,22,16,"PAH",27,1,9,0)="An API for Outpatient Pharmacy will be developed by Controlled Substances "
^DIC(9.4,83,22,16,"PAH",27,1,10,0)="developers. This API will be called by Outpatient Pharmacy each time a "
^DIC(9.4,83,22,16,"PAH",27,1,11,0)="refill is returned to stock. The API will decide whether the RX is a"
^DIC(9.4,83,22,16,"PAH",27,1,12,0)="controlled substance and store this information in order to inform users"
^DIC(9.4,83,22,16,"PAH",27,1,13,0)="of the Controlled Substances package of the status of an Rx refill."
^DIC(9.4,83,22,16,"PAH",27,1,14,0)="Outpatient Pharmacy patch PSO*7*40 contains the API."
^DIC(9.4,83,22,16,"PAH",27,1,15,0)=" "
^DIC(9.4,83,22,16,"PAH",27,1,16,0)="Problem:"
^DIC(9.4,83,22,16,"PAH",27,1,17,0)="======="
^DIC(9.4,83,22,16,"PAH",27,1,18,0)="In some instances, two different personnel can release a CS script within"
^DIC(9.4,83,22,16,"PAH",27,1,19,0)="moments of each other. This cause confusion and errors in the drug's"
^DIC(9.4,83,22,16,"PAH",27,1,20,0)="balance."
^DIC(9.4,83,22,16,"PAH",27,1,21,0)=" "
^DIC(9.4,83,22,16,"PAH",27,1,22,0)="Solution:"
^DIC(9.4,83,22,16,"PAH",27,1,23,0)="========"
^DIC(9.4,83,22,16,"PAH",27,1,24,0)="When a user selects a prescription, the global is instantly locked. Anyone"
^DIC(9.4,83,22,16,"PAH",27,1,25,0)="else trying to alter data in that prescription will be shown a message that"
^DIC(9.4,83,22,16,"PAH",27,1,26,0)="informs them that another user is editing that prescription."
^DIC(9.4,83,22,16,"PAH",28,0)="27 SEQ #28^3001106^1"
^DIC(9.4,83,22,16,"PAH",28,1,0)="^^15^15^3001106"
^DIC(9.4,83,22,16,"PAH",28,1,1,0)="There is a problem in the Sign Out Dose for Patient [PSD NURSE DISPENSING] "
^DIC(9.4,83,22,16,"PAH",28,1,2,0)="option."
^DIC(9.4,83,22,16,"PAH",28,1,3,0)=" "
^DIC(9.4,83,22,16,"PAH",28,1,4,0)="The problem is in the part where the system displays the doses signed out"
^DIC(9.4,83,22,16,"PAH",28,1,5,0)="in the last 'X' hours. Although the user is signing out the dose for a   "
^DIC(9.4,83,22,16,"PAH",28,1,6,0)="particular ward, the program loops through each ward on file looking for "
^DIC(9.4,83,22,16,"PAH",28,1,7,0)="the drug. It will show all the doses signed out. When it finds an entry  "
^DIC(9.4,83,22,16,"PAH",28,1,8,0)="that doesn't match the selected ward, an error message is generated.     "
^DIC(9.4,83,22,16,"PAH",28,1,9,0)=" "
^DIC(9.4,83,22,16,"PAH",28,1,10,0)="This error message restricts the user from returning a drug to one"
^DIC(9.4,83,22,16,"PAH",28,1,11,0)="NAOU if it has been signed out by another. This also creates a problem"
^DIC(9.4,83,22,16,"PAH",28,1,12,0)="by updating the balance in both wards."
^DIC(9.4,83,22,16,"PAH",28,1,13,0)=" "
^DIC(9.4,83,22,16,"PAH",28,1,14,0)="The solution to this is to remove the checking on every ward, and just   "
^DIC(9.4,83,22,16,"PAH",28,1,15,0)="concentrate on the one at hand. "
^DIC(9.4,83,22,16,"PAH",29,0)="32 SEQ #29^3010515^1"
^DIC(9.4,83,22,16,"PAH",29,1,0)="^^11^11^3010515"
^DIC(9.4,83,22,16,"PAH",29,1,1,0)="1) When using the Hold a CS Drug (No Inventory Update) [PSD DEST NON-CS"
^DIC(9.4,83,22,16,"PAH",29,1,2,0)="   DRUG] option, it was reported that the system is erroring out after "
^DIC(9.4,83,22,16,"PAH",29,1,3,0)="   the user enters a semicolon "";"" as part of the text for the COMMENTS"
^DIC(9.4,83,22,16,"PAH",29,1,4,0)="   field (#14) in the CS DESTRUCTION file (#58.86). This patch fixes "
^DIC(9.4,83,22,16,"PAH",29,1,5,0)="   this problem."
^DIC(9.4,83,22,16,"PAH",29,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",29,1,7,0)="2) On the Balance Adjustment Report [PSD BALANCE ADJUSTMENT REVIEW]"
^DIC(9.4,83,22,16,"PAH",29,1,8,0)="   option, if more than one adjustment to the inventory were taking place"
^DIC(9.4,83,22,16,"PAH",29,1,9,0)="   at the same moment, currently the report does not include all such"
^DIC(9.4,83,22,16,"PAH",29,1,10,0)="   adjustments. This patch insures all adjustments are included in the"
^DIC(9.4,83,22,16,"PAH",29,1,11,0)="   report."
^DIC(9.4,83,22,16,"PAH",30,0)="33 SEQ #30^3010625^1"
^DIC(9.4,83,22,16,"PAH",30,1,0)="^^9^9^3010625"
^DIC(9.4,83,22,16,"PAH",30,1,1,0)=" When the Add Existing Green Sheets at Setup [PSD EXISTING GS] option"
^DIC(9.4,83,22,16,"PAH",30,1,2,0)=" is executed, the user is not asked to identify if the 10-2638 form has"
^DIC(9.4,83,22,16,"PAH",30,1,3,0)=" been printed. This flag is identified by the following field:"
^DIC(9.4,83,22,16,"PAH",30,1,4,0)=" "
^DIC(9.4,83,22,16,"PAH",30,1,5,0)=" FILE: DRUG ACCOUNTABILITY TRANSACTION (#58.81)"
^DIC(9.4,83,22,16,"PAH",30,1,6,0)=" FIELD: PRINTED 2638 (#103)"
^DIC(9.4,83,22,16,"PAH",30,1,7,0)=" "
^DIC(9.4,83,22,16,"PAH",30,1,8,0)=" To correct the problem, the field has been added to the questions which"
^DIC(9.4,83,22,16,"PAH",30,1,9,0)=" the user is required to answer."
^DIC(9.4,83,22,16,"PAH",31,0)="30 SEQ #31^3011231^1"
^DIC(9.4,83,22,16,"PAH",31,1,0)="^^65^65^3011231"
^DIC(9.4,83,22,16,"PAH",31,1,1,0)="This patch addresses the problems with updating balances and releasing"
^DIC(9.4,83,22,16,"PAH",31,1,2,0)="controlled substances outpatient prescriptions."
^DIC(9.4,83,22,16,"PAH",31,1,3,0)="  "
^DIC(9.4,83,22,16,"PAH",31,1,4,0)=" The functionality format is as follows:"
^DIC(9.4,83,22,16,"PAH",31,1,5,0)="  "
^DIC(9.4,83,22,16,"PAH",31,1,6,0)="1. If a controlled substances prescription fill has been released, but the"
^DIC(9.4,83,22,16,"PAH",31,1,7,0)="   balance NOT adjusted for that specific fill (fill not posted) in the "
^DIC(9.4,83,22,16,"PAH",31,1,8,0)="   Controlled Substances (CS) V. 3.0 package, the user will be able to"
^DIC(9.4,83,22,16,"PAH",31,1,9,0)="   post that prescription fill to adjust the controlled substances balance"
^DIC(9.4,83,22,16,"PAH",31,1,10,0)="   for that drug item."
^DIC(9.4,83,22,16,"PAH",31,1,11,0)="  "
^DIC(9.4,83,22,16,"PAH",31,1,12,0)="2. If a controlled substances prescription fill has been released and"
^DIC(9.4,83,22,16,"PAH",31,1,13,0)="   posted (balance adjusted), the Controlled Substances V. 3.0 package "
^DIC(9.4,83,22,16,"PAH",31,1,14,0)="   will not allow any further actions to be taken on that fill. "
^DIC(9.4,83,22,16,"PAH",31,1,15,0)="   In other words, a user will only be able to post (balance adjust) "
^DIC(9.4,83,22,16,"PAH",31,1,16,0)="   a specific controlled substances fill only once."
^DIC(9.4,83,22,16,"PAH",31,1,17,0)="  "
^DIC(9.4,83,22,16,"PAH",31,1,18,0)="3. When returning to stock a controlled substances prescription fill"
^DIC(9.4,83,22,16,"PAH",31,1,19,0)="   through the Outpatient Pharmacy V. 7.0 software, the software will"
^DIC(9.4,83,22,16,"PAH",31,1,20,0)="   first check to see if the user holds the PSDMGR key. If yes, the user"
^DIC(9.4,83,22,16,"PAH",31,1,21,0)="   will be able to return the controlled substances prescription fill"
^DIC(9.4,83,22,16,"PAH",31,1,22,0)="   to stock and also to update the drug balance in the Controlled "
^DIC(9.4,83,22,16,"PAH",31,1,23,0)="   Substances V. 3.0 package. If no, the user will NOT be able to return "
^DIC(9.4,83,22,16,"PAH",31,1,24,0)="   the controlled substances prescription fill to stock OR update the "
^DIC(9.4,83,22,16,"PAH",31,1,25,0)="   drug balance in the CS package. An electronic signature will be "
^DIC(9.4,83,22,16,"PAH",31,1,26,0)="   required to return a controlled substances prescription to stock and "
^DIC(9.4,83,22,16,"PAH",31,1,27,0)="   to update the drug balance. "
^DIC(9.4,83,22,16,"PAH",31,1,28,0)="   "
^DIC(9.4,83,22,16,"PAH",31,1,29,0)="   The user will now be able to post and/or release a partial fill for a "
^DIC(9.4,83,22,16,"PAH",31,1,30,0)="   Consolidated Mail Outpatient Pharmacy prescription."
^DIC(9.4,83,22,16,"PAH",31,1,31,0)=" "
^DIC(9.4,83,22,16,"PAH",31,1,32,0)="4. Users will now be able to post and/or release controlled substances"
^DIC(9.4,83,22,16,"PAH",31,1,33,0)="   prescriptions with a status of DISCONTINUED  from the Controlled "
^DIC(9.4,83,22,16,"PAH",31,1,34,0)="   Substances V. 3.0 package.Posting and/or releasing through the "
^DIC(9.4,83,22,16,"PAH",31,1,35,0)="   Controlled Substances V. 3.0 package for prescriptions with"
^DIC(9.4,83,22,16,"PAH",31,1,36,0)="   the statuses of DELETED, DISCONTINUED BY PROVIDER and DISCONTINUED "
^DIC(9.4,83,22,16,"PAH",31,1,37,0)="   (EDIT) will not be allowed."
^DIC(9.4,83,22,16,"PAH",31,1,38,0)=" "
^DIC(9.4,83,22,16,"PAH",31,1,39,0)="5. If a prescription fill has been returned to stock, and later processed "
^DIC(9.4,83,22,16,"PAH",31,1,40,0)="   again for dispensing, the user will be able to post and/or release the "
^DIC(9.4,83,22,16,"PAH",31,1,41,0)="   prescription fill through the Controlled Substances V. 3.0 package as "
^DIC(9.4,83,22,16,"PAH",31,1,42,0)="   long as the new fill date is greater than the return to stock date."
^DIC(9.4,83,22,16,"PAH",31,1,43,0)=" "
^DIC(9.4,83,22,16,"PAH",31,1,44,0)="6. The Daily Activity Log (in lieu of VA FORM 10-2320) [PSD DAILY LOG] "
^DIC(9.4,83,22,16,"PAH",31,1,45,0)="   option has been enhanced to clearly identify prescriptions that have "
^DIC(9.4,83,22,16,"PAH",31,1,46,0)="   been returned to stock. "
^DIC(9.4,83,22,16,"PAH",31,1,47,0)="   "
^DIC(9.4,83,22,16,"PAH",31,1,48,0)="7. When an item is received into the Controlled Substances V. 3.0 package "
^DIC(9.4,83,22,16,"PAH",31,1,49,0)="   after already being received by procurement/supply, the system does "
^DIC(9.4,83,22,16,"PAH",31,1,50,0)="   not check to see if the incoming item is stocked in the pharmacy "
^DIC(9.4,83,22,16,"PAH",31,1,51,0)="   location. This creates problems with the correct items because a "
^DIC(9.4,83,22,16,"PAH",31,1,52,0)="   balance adjustment cannot be performed on the non-stocked item. "
^DIC(9.4,83,22,16,"PAH",31,1,53,0)="   The solution to this is to check to ensure the item is stocked in the "
^DIC(9.4,83,22,16,"PAH",31,1,54,0)="   selected pharmacy location."
^DIC(9.4,83,22,16,"PAH",31,1,55,0)=" "
^DIC(9.4,83,22,16,"PAH",31,1,56,0)="8. When using the Outpatient Rx's [PSD OUTPATIENT] option, it was reported"
^DIC(9.4,83,22,16,"PAH",31,1,57,0)="   that the system errors out with an illegal number when the user enters"
^DIC(9.4,83,22,16,"PAH",31,1,58,0)="   an entry such as ""501-400E097"" at the ""Enter/Wand PRESCRIPTION"
^DIC(9.4,83,22,16,"PAH",31,1,59,0)="   number"" prompt. This patch corrects this problem."
^DIC(9.4,83,22,16,"PAH",31,1,60,0)=" "
^DIC(9.4,83,22,16,"PAH",31,1,61,0)="9. It was reported that the Suremed machine is displaying the Internal"
^DIC(9.4,83,22,16,"PAH",31,1,62,0)="   Entry Number (IEN) of the patient instead of the Social Security Number"
^DIC(9.4,83,22,16,"PAH",31,1,63,0)="   (SSN). Currently, the third piece of the PID segment of the HL7 message"
^DIC(9.4,83,22,16,"PAH",31,1,64,0)="   is set to the IEN. This patch ensures that the patient's SSN is sent in"
^DIC(9.4,83,22,16,"PAH",31,1,65,0)="   the third piece of the PID segment of the HL7 message."
^DIC(9.4,83,22,16,"PAH",32,0)="37 SEQ #32^3020204^1"
^DIC(9.4,83,22,16,"PAH",32,1,0)="^^3^3^3020204"
^DIC(9.4,83,22,16,"PAH",32,1,1,0)=" This patch removes an erroneous message that is generated in the "
^DIC(9.4,83,22,16,"PAH",32,1,2,0)=" Controlled Substances package. The message does not contain any"
^DIC(9.4,83,22,16,"PAH",32,1,3,0)=" useful information for the user, therefore it has been removed."
^DIC(9.4,83,22,16,"PAH",33,0)="41 SEQ #33^3030520^1"
^DIC(9.4,83,22,16,"PAH",33,1,0)="^^26^26^3030520"
^DIC(9.4,83,22,16,"PAH",33,1,1,0)="The Office of the Medical Inspector, in collaboration with the Narcotics "
^DIC(9.4,83,22,16,"PAH",33,1,2,0)="Diversion Advisory Group, requested development of tools to support and"
^DIC(9.4,83,22,16,"PAH",33,1,3,0)="monitor Pharmacy Service Schedule II narcotics inventory management to be"
^DIC(9.4,83,22,16,"PAH",33,1,4,0)="distributed to all medical centers.  This enhancement includes a new"
^DIC(9.4,83,22,16,"PAH",33,1,5,0)="standalone CS Monitoring Menu [PSD NM MENU] option containing reports"
^DIC(9.4,83,22,16,"PAH",33,1,6,0)="derived from VA FileMan templates used during site visits that were found"
^DIC(9.4,83,22,16,"PAH",33,1,7,0)="to be valuable in assisting sites with the monitoring of Schedule II"
^DIC(9.4,83,22,16,"PAH",33,1,8,0)="narcotics prescriptions.  These reports also allow for the monitoring of"
^DIC(9.4,83,22,16,"PAH",33,1,9,0)="controlled substance schedules C-II through C-V.  "
^DIC(9.4,83,22,16,"PAH",33,1,10,0)="  "
^DIC(9.4,83,22,16,"PAH",33,1,11,0)="This patch includes a new standalone menu option entitled CS Monitoring"
^DIC(9.4,83,22,16,"PAH",33,1,12,0)="Menu [PSD NM MENU] option that will not be attached to a menu. IRM"
^DIC(9.4,83,22,16,"PAH",33,1,13,0)="support personnel will need to assign the menu to the Narcotics Inspectors"
^DIC(9.4,83,22,16,"PAH",33,1,14,0)="and Pharmacy Managers at the site.  "
^DIC(9.4,83,22,16,"PAH",33,1,15,0)="  "
^DIC(9.4,83,22,16,"PAH",33,1,16,0)="Kernel's Option Access by user [XUOPTWHO] option will be attached to the CS"
^DIC(9.4,83,22,16,"PAH",33,1,17,0)="Monitoring Menu [PSD NM MENU] option upon patch installation. The"
^DIC(9.4,83,22,16,"PAH",33,1,18,0)="following new options are brought in with the menu: "
^DIC(9.4,83,22,16,"PAH",33,1,19,0)="    "
^DIC(9.4,83,22,16,"PAH",33,1,20,0)="     CS Application Security Key Report [PSD NM SECURITY KEY] option"
^DIC(9.4,83,22,16,"PAH",33,1,21,0)="     CS Balance Adjustments Report [PSD NM CS ADJ] option"
^DIC(9.4,83,22,16,"PAH",33,1,22,0)="     CS RXs by Same Person Report [PSD NM RX SAME PERSON] option"
^DIC(9.4,83,22,16,"PAH",33,1,23,0)="     Label Reprint for CS RXs Report [PSD NM RX REPRINT] option"
^DIC(9.4,83,22,16,"PAH",33,1,24,0)="     Partial Request for CS RXs Report [PSD NM RX PARTIAL] option"
^DIC(9.4,83,22,16,"PAH",33,1,25,0)="     Patients Without VA Visit Report [PSD NM RX WITHOUT VA] option"
^DIC(9.4,83,22,16,"PAH",33,1,26,0)="   "
^DIC(9.4,83,22,16,"PAH",34,0)="40 SEQ #34^3030802^1"
^DIC(9.4,83,22,16,"PAH",34,1,0)="^^21^21^3030802"
^DIC(9.4,83,22,16,"PAH",34,1,1,0)="Pharmacy Benefits Management (PBM) Strategic Healthcare Group in"
^DIC(9.4,83,22,16,"PAH",34,1,2,0)="collaboration with the Drug Enforcement Administration (DEA), requested"
^DIC(9.4,83,22,16,"PAH",34,1,3,0)="the development of the first Public Key Infrastructure (PKI) VistA pilot"
^DIC(9.4,83,22,16,"PAH",34,1,4,0)="project, named Electronic Prescription Order Entry for Schedule II"
^DIC(9.4,83,22,16,"PAH",34,1,5,0)="Controlled Substances. The objective is to develop an electronic order"
^DIC(9.4,83,22,16,"PAH",34,1,6,0)="entry system for Schedule II controlled substances using digital"
^DIC(9.4,83,22,16,"PAH",34,1,7,0)="signatures. To make this project viable, modifications to the following"
^DIC(9.4,83,22,16,"PAH",34,1,8,0)="packages were identified:"
^DIC(9.4,83,22,16,"PAH",34,1,9,0)="National Drug File (NDF) V. 4.0"
^DIC(9.4,83,22,16,"PAH",34,1,10,0)="Computerized Patient Record System (CPRS) V. 1.0"
^DIC(9.4,83,22,16,"PAH",34,1,11,0)="Pharmacy Data Management (PDM) V. 1.0"
^DIC(9.4,83,22,16,"PAH",34,1,12,0)="Outpatient Pharmacy (OP) V. 7.0"
^DIC(9.4,83,22,16,"PAH",34,1,13,0)="Controlled Substances (CS) V. 3.0"
^DIC(9.4,83,22,16,"PAH",34,1,14,0)=" "
^DIC(9.4,83,22,16,"PAH",34,1,15,0)="This is the CS patch, which provides two new options entitled Digitally"
^DIC(9.4,83,22,16,"PAH",34,1,16,0)="Signed CS Orders Report [PSD DIGITALLY SIGNED ORDERS] and Digitally Signed"
^DIC(9.4,83,22,16,"PAH",34,1,17,0)="OP Released Rx Report [PSD DIG. SIGNED RELEASED RX] that will be added to"
^DIC(9.4,83,22,16,"PAH",34,1,18,0)="the Production Reports [PSD PRODUCTION REPORTS] menu. Once DEA's"
^DIC(9.4,83,22,16,"PAH",34,1,19,0)="regulations are revised and PKI can be fully implemented nationally, sites"
^DIC(9.4,83,22,16,"PAH",34,1,20,0)="that choose to activate the PKI functionality can use this option to"
^DIC(9.4,83,22,16,"PAH",34,1,21,0)="retrieve digitally signed orders for controlled substances."
^DIC(9.4,83,22,16,"PAH",35,0)="39 SEQ #35^3031121^1"
^DIC(9.4,83,22,16,"PAH",35,1,0)="^^30^30^3031121"
^DIC(9.4,83,22,16,"PAH",35,1,1,0)=" When the user uses the Return Medication to Stock [PSO RETURNED STOCK]"
^DIC(9.4,83,22,16,"PAH",35,1,2,0)=" option to return a controlled substance to stock, the Controlled "
^DIC(9.4,83,22,16,"PAH",35,1,3,0)=" Substances 3.0 package is accessed to update the drug balance. During"
^DIC(9.4,83,22,16,"PAH",35,1,4,0)=" this process, the problems detailed below can occur."
^DIC(9.4,83,22,16,"PAH",35,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",35,1,6,0)=" 1. After updating the balances in Controlled Substances 3.0, the "
^DIC(9.4,83,22,16,"PAH",35,1,7,0)=" Outpatient Pharmacy 7.0 software requires the user to enter comments"
^DIC(9.4,83,22,16,"PAH",35,1,8,0)=" concerning the transaction. If the user exits the program at this point,"
^DIC(9.4,83,22,16,"PAH",35,1,9,0)=" the item is not marked as returned to stock in the Prescription file"
^DIC(9.4,83,22,16,"PAH",35,1,10,0)=" (#52), therefore it can be selected again, and the balances updated in"
^DIC(9.4,83,22,16,"PAH",35,1,11,0)=" Controlled Substances 3.0 again."
^DIC(9.4,83,22,16,"PAH",35,1,12,0)=" "
^DIC(9.4,83,22,16,"PAH",35,1,13,0)=" The solution for this is for an additional check on the transaction before"
^DIC(9.4,83,22,16,"PAH",35,1,14,0)=" allowing updating of balances in Controlled Substances 3.0."
^DIC(9.4,83,22,16,"PAH",35,1,15,0)=" "
^DIC(9.4,83,22,16,"PAH",35,1,16,0)=" 2. The second issue related to this process is that when the Controlled"
^DIC(9.4,83,22,16,"PAH",35,1,17,0)=" Substances 3.0 software is updating the balances, the name of the "
^DIC(9.4,83,22,16,"PAH",35,1,18,0)=" dispensing site is retained. If the user then exits the Outpatient "
^DIC(9.4,83,22,16,"PAH",35,1,19,0)=" Pharmacy 7.0 software, and accesses the Controlled Substances 3.0"
^DIC(9.4,83,22,16,"PAH",35,1,20,0)=" software, the user is not prompted for the name of the dispensing site."
^DIC(9.4,83,22,16,"PAH",35,1,21,0)=" "
^DIC(9.4,83,22,16,"PAH",35,1,22,0)=" The solution for this is to not retain the name of the dispensing"
^DIC(9.4,83,22,16,"PAH",35,1,23,0)=" site."
^DIC(9.4,83,22,16,"PAH",35,1,24,0)=" "
^DIC(9.4,83,22,16,"PAH",35,1,25,0)=" 3. The third issue of this patch is on fills returned to stock, then"
^DIC(9.4,83,22,16,"PAH",35,1,26,0)=" re-issued. Controlled Substances 3.0 will not allow the release of "
^DIC(9.4,83,22,16,"PAH",35,1,27,0)=" the new fill."
^DIC(9.4,83,22,16,"PAH",35,1,28,0)=" "
^DIC(9.4,83,22,16,"PAH",35,1,29,0)=" The solution for this is to add additional checks on the prescription"
^DIC(9.4,83,22,16,"PAH",35,1,30,0)=" to ensure it is not the fill that was previously returned to stock."
^DIC(9.4,83,22,16,"PAH",36,0)="42 SEQ #36^3040302^1"
^DIC(9.4,83,22,16,"PAH",36,1,0)="^^2^2^3040302"
^DIC(9.4,83,22,16,"PAH",36,1,1,0)="This patch will correct problems in NOIS(s) ISB-0903-31237 and "
^DIC(9.4,83,22,16,"PAH",36,1,2,0)="POR-0503-51185."
^DIC(9.4,83,22,16,"PAH",37,0)="44 SEQ #37^3040302^1"
^DIC(9.4,83,22,16,"PAH",37,1,0)="^^1^1^3040302"
^DIC(9.4,83,22,16,"PAH",37,1,1,0)="MODIFICATION OF 'DR' STRING IN ROUTINE PSDSTK FOR LIQUID USEAGE."
^DIC(9.4,83,22,16,"PAH",38,0)="47 SEQ #38^3040802^1"
^DIC(9.4,83,22,16,"PAH",38,1,0)="^^1^1^3040802"
^DIC(9.4,83,22,16,"PAH",38,1,1,0)="RETURN ORIGINAL FUNCTIONALITY OF PSD STOCK C/S DRUGS OPTION"
^DIC(9.4,83,22,16,"PAH",39,0)="46 SEQ #39^3040802^1"
^DIC(9.4,83,22,16,"PAH",39,1,0)="^^1^1^3040802"
^DIC(9.4,83,22,16,"PAH",39,1,1,0)="Drug Receipt History reporting issue, Green Sheet Printing issues"
^DIC(9.4,83,22,16,"PAH",40,0)="45 SEQ #40^3041124^1"
^DIC(9.4,83,22,16,"PAH",40,1,0)="^^2^2^3041124"
^DIC(9.4,83,22,16,"PAH",40,1,1,0)="Mult Posting of Partials, Changes in two routines to reflect the usage of "
^DIC(9.4,83,22,16,"PAH",40,1,2,0)="DBIA 2621"
^DIC(9.4,83,22,16,"PAH",41,0)="50 SEQ #41^3041124^1"
^DIC(9.4,83,22,16,"PAH",41,1,0)="^^2^2^3041124"
^DIC(9.4,83,22,16,"PAH",41,1,1,0)="This patch will correct the problem of the same person being"
^DIC(9.4,83,22,16,"PAH",41,1,2,0)="entered as the witness and the nurse that signed out the dose."
^DIC(9.4,83,22,16,"PAH",42,0)="36 SEQ #42^3050118^1"
^DIC(9.4,83,22,16,"PAH",42,1,0)="^^4^4^3050118"
^DIC(9.4,83,22,16,"PAH",42,1,1,0)=" When the Balance Adjustment Report [PSD BALANCE ADJUSTMENT REVIEW] is"
^DIC(9.4,83,22,16,"PAH",42,1,2,0)=" sent to a printer and not queued, the report prints to the user's"
^DIC(9.4,83,22,16,"PAH",42,1,3,0)=" screen instead."
^DIC(9.4,83,22,16,"PAH",42,1,4,0)=" "
^DIC(9.4,83,22,16,"PAH",43,0)="55 SEQ #43^3050506^1"
^DIC(9.4,83,22,16,"PAH",43,1,0)="^^2^2^3050506"
^DIC(9.4,83,22,16,"PAH",43,1,1,0)="This patch will correct the problem of the Outpatient Dispensing Report "
^DIC(9.4,83,22,16,"PAH",43,1,2,0)="not printing to a printer."
^DIC(9.4,83,22,16,"PAH",44,0)="51 SEQ #44^3050611^1"
^DIC(9.4,83,22,16,"PAH",44,1,0)="^^3^3^3050611"
^DIC(9.4,83,22,16,"PAH",44,1,1,0)="This patch will correct the problems identified in NOIS calls"
^DIC(9.4,83,22,16,"PAH",44,1,2,0)=" SBY-0904-30620 ERROR - MSG+1^PSDORD4"
^DIC(9.4,83,22,16,"PAH",44,1,3,0)=" PRE-1004-60136 PROBLEM SCANNING DRUG FOR SIGN OUT FOR PT"
^DIC(9.4,83,22,16,"PAH",45,0)="57 SEQ #45^3050709^1"
^DIC(9.4,83,22,16,"PAH",45,1,0)="^^3^3^3050709"
^DIC(9.4,83,22,16,"PAH",45,1,1,0)="This patch will correct the problem of the Controlled"
^DIC(9.4,83,22,16,"PAH",45,1,2,0)="Substance Nurse Shift Log not being consistant with "
^DIC(9.4,83,22,16,"PAH",45,1,3,0)="the Controlled Substance Inspectors Log."
^DIC(9.4,83,22,16,"PAH",46,0)="58 SEQ #46^3050709^1"
^DIC(9.4,83,22,16,"PAH",46,1,0)="^^2^2^3050709"
^DIC(9.4,83,22,16,"PAH",46,1,1,0)="This patch will correct to problem of allowing users to select an"
^DIC(9.4,83,22,16,"PAH",46,1,2,0)="inactive NAOU if the user does not hold the PSJ RNURSE key."
^DIC(9.4,83,22,16,"PAH",47,0)="48 SEQ #47^3050813^1"
^DIC(9.4,83,22,16,"PAH",47,1,0)="^^2^2^3050813"
^DIC(9.4,83,22,16,"PAH",47,1,1,0)="This patch will correct to problems that are encountered"
^DIC(9.4,83,22,16,"PAH",47,1,2,0)="when a controlled substance is returned and then reissued."
^DIC(9.4,83,22,16,"PAH",48,0)="53 SEQ #48^3050813^1"
^DIC(9.4,83,22,16,"PAH",48,1,0)="^^7^7^3050813"
^DIC(9.4,83,22,16,"PAH",48,1,1,0)="This patch will modify the Controlled Substance Balances report created "
^DIC(9.4,83,22,16,"PAH",48,1,2,0)="with menu option Verify Count [PSD NURSE ONLINE COUNT].  This report "
^DIC(9.4,83,22,16,"PAH",48,1,3,0)="errors out if all the drugs in the NAOU have a balance of zero.  This "
^DIC(9.4,83,22,16,"PAH",48,1,4,0)="patch will also modify menu options Record Delayed Wastage [PSD NURSE"
^DIC(9.4,83,22,16,"PAH",48,1,5,0)="WASTE] and Not Given, Return to Stock [PSD NURSE NOT GIVEN].  These two"
^DIC(9.4,83,22,16,"PAH",48,1,6,0)="options are calling code in each other's routines which is creating an"
^DIC(9.4,83,22,16,"PAH",48,1,7,0)="infinite loop."
^DIC(9.4,83,22,16,"PAH",49,0)="56 SEQ #49^3060525^1"
^DIC(9.4,83,22,16,"PAH",49,1,0)="^^1^1^3060525"
^DIC(9.4,83,22,16,"PAH",49,1,1,0)="DRUG BALANCE NOT UPDATED ON NAOU"
^DIC(9.4,83,22,16,"PAH",50,0)="60 SEQ #50^3060807^1"
^DIC(9.4,83,22,16,"PAH",50,1,0)="^^3^3^3060807"
^DIC(9.4,83,22,16,"PAH",50,1,1,0)="This patch will correct the problem of an old greensheet being"
^DIC(9.4,83,22,16,"PAH",50,1,2,0)="selected when a drug IEN is entered and it matches an old "
^DIC(9.4,83,22,16,"PAH",50,1,3,0)="pharmacy dispencing number."
^DIC(9.4,83,22,16,"PAH",51,0)="63 SEQ #51^3070627.213416^1"
^DIC(9.4,83,22,16,"PAH",51,1,0)="^^2^2^3070627"
^DIC(9.4,83,22,16,"PAH",51,1,1,0)="Modifies PSD COST REPORTS, PSD NAOU BALANCE REPORT and PSD NURSE TRANSFER "
^DIC(9.4,83,22,16,"PAH",51,1,2,0)="GS."
^DIC(9.4,83,22,16,"PAH",52,0)="59 SEQ #52^3070905.000915^1"
^DIC(9.4,83,22,16,"PAH",52,1,0)="^^5^5^3070905"
^DIC(9.4,83,22,16,"PAH",52,1,1,0)="This patch will correct two problems.  The first problem deals with"
^DIC(9.4,83,22,16,"PAH",52,1,2,0)="some PSD variables lingering after exiting the application "
^DIC(9.4,83,22,16,"PAH",52,1,3,0)="resulting in the wrong selection of the master or satellite vault."
^DIC(9.4,83,22,16,"PAH",52,1,4,0)="The second problem is a result of two users being able to process"
^DIC(9.4,83,22,16,"PAH",52,1,5,0)="the same controlled substance request at the same time."
^DIC(9.4,83,22,16,"PAH",53,0)="66 SEQ #53^3070905.011256^1"
^DIC(9.4,83,22,16,"PAH",53,1,0)="^^13^13^3070905"
^DIC(9.4,83,22,16,"PAH",53,1,1,0)="With the deployment of Cache version 5, it was discovered that the short"
^DIC(9.4,83,22,16,"PAH",53,1,2,0)="lock timeout values could generate a lock failure. Patch DI*22*147, which"
^DIC(9.4,83,22,16,"PAH",53,1,3,0)="has already been released, provided a solution to resolve this issue and"
^DIC(9.4,83,22,16,"PAH",53,1,4,0)="future lock issues."
^DIC(9.4,83,22,16,"PAH",53,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",53,1,6,0)="This patch instituted a new default lock timeout of three seconds based on"
^DIC(9.4,83,22,16,"PAH",53,1,7,0)="a global node setting of ^DD(""DILOCKTM"")=3."
^DIC(9.4,83,22,16,"PAH",53,1,8,0)=" "
^DIC(9.4,83,22,16,"PAH",53,1,9,0)="In order to avoid the lock issue in Controlled Substances, this patch"
^DIC(9.4,83,22,16,"PAH",53,1,10,0)="modifies all routines that currently use a lock timeout value of less than"
^DIC(9.4,83,22,16,"PAH",53,1,11,0)="3 seconds to check for the node ^DD(""DILOCKTM"") and to use the value"
^DIC(9.4,83,22,16,"PAH",53,1,12,0)="defined there, otherwise the lock timeout value is set to a default value"
^DIC(9.4,83,22,16,"PAH",53,1,13,0)="of 3 seconds."
^DIC(9.4,83,22,16,"PAH",54,0)="62 SEQ #54^3071212.213643^1"
^DIC(9.4,83,22,16,"PAH",54,1,0)="^^28^28^3071212"
^DIC(9.4,83,22,16,"PAH",54,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,83,22,16,"PAH",54,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,3,0)="1.  129499     PSDGSRV1        undefined error"
^DIC(9.4,83,22,16,"PAH",54,1,4,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,5,0)="When completing a greensheet and the user includes a "";"" semicolon at the"
^DIC(9.4,83,22,16,"PAH",54,1,6,0)="""REASON TURN IN FOR DESTROY:"" or ""REASON RETURNED TO STOCK:"" prompts, a"
^DIC(9.4,83,22,16,"PAH",54,1,7,0)="$ZE= <SYNTAX> BR+1^DIE0 error is generated."
^DIC(9.4,83,22,16,"PAH",54,1,8,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,9,0)="2.   68785     PSDPAT1         Transferring of Controlled Substances "
^DIC(9.4,83,22,16,"PAH",54,1,10,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,11,0)="When a controlled substance is transferred from one NAOU to another NAOU,"
^DIC(9.4,83,22,16,"PAH",54,1,12,0)="the Activity Report [PSD NURSE DISP REPORT] does not include the transfer"
^DIC(9.4,83,22,16,"PAH",54,1,13,0)="if the receipt date is different then the transfer date."
^DIC(9.4,83,22,16,"PAH",54,1,14,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,15,0)="3.  136028     Pharmacist able to fill expired order."
^DIC(9.4,83,22,16,"PAH",54,1,16,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,17,0)="This patch will prevent the pharmacist from filling expired orders."
^DIC(9.4,83,22,16,"PAH",54,1,18,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,19,0)="4.  161718     Pharmacist can't order an inactive drug on NAOU"
^DIC(9.4,83,22,16,"PAH",54,1,20,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,21,0)="It also allows a pharmacist to see inactive drugs on the lookup."
^DIC(9.4,83,22,16,"PAH",54,1,22,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,23,0)="5.  158898     PSD DEST Drugs Report does not work properly."
^DIC(9.4,83,22,16,"PAH",54,1,24,0)=" "
^DIC(9.4,83,22,16,"PAH",54,1,25,0)="If the first date in the ""AD"" cross reference of file #58.86 (call it Y) "
^DIC(9.4,83,22,16,"PAH",54,1,26,0)="is after the last date in the ""AC"" cross reference (call it X) and"
^DIC(9.4,83,22,16,"PAH",54,1,27,0)="the starting date for the report falls between the two dates"
^DIC(9.4,83,22,16,"PAH",54,1,28,0)="(X < starting date <Y)then an <UNDEFINED> error occurs."
^DIC(9.4,83,22,16,"PAH",55,0)="65 SEQ #55^3080203.22242^1"
^DIC(9.4,83,22,16,"PAH",55,1,0)="^^17^17^3080203"
^DIC(9.4,83,22,16,"PAH",55,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,83,22,16,"PAH",55,1,2,0)=" 1. HD169083 - Vault Setup"
^DIC(9.4,83,22,16,"PAH",55,1,3,0)="  In Controlled Substances, under the Site Parameters option (PSD SITE),"
^DIC(9.4,83,22,16,"PAH",55,1,4,0)="  the user is unable to add an inpatient site."
^DIC(9.4,83,22,16,"PAH",55,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",55,1,6,0)=" 2. HD98252 - Daily Activity Log does not record change on CS  invoice"
^DIC(9.4,83,22,16,"PAH",55,1,7,0)="  After a Drug Accountability Verified Invoice has been edited, the Daily"
^DIC(9.4,83,22,16,"PAH",55,1,8,0)="  Activity report does not properly display Drug Accountability"
^DIC(9.4,83,22,16,"PAH",55,1,9,0)="  adjustments correctly.."
^DIC(9.4,83,22,16,"PAH",55,1,10,0)="  "
^DIC(9.4,83,22,16,"PAH",55,1,11,0)=" 3. HD168800 - Inventory  issued  to NAOU somehow was doubled by Nurse"
^DIC(9.4,83,22,16,"PAH",55,1,12,0)="  The Ward Nurse used the PSD REC GS option to accept an update from"
^DIC(9.4,83,22,16,"PAH",55,1,13,0)="  Pharmacy, during this acceptance the inventory was doubled from 10"
^DIC(9.4,83,22,16,"PAH",55,1,14,0)="  units to 20 even though only 10  units were involved. Pharmacy was able"
^DIC(9.4,83,22,16,"PAH",55,1,15,0)="  to correct the problem and present inventories reflect actual"
^DIC(9.4,83,22,16,"PAH",55,1,16,0)="  inventory. This is caused by two users being allowed to access the same"
^DIC(9.4,83,22,16,"PAH",55,1,17,0)="  greensheet at the same time."
^DIC(9.4,83,22,16,"PAH",56,0)="64 SEQ #56^3090421.140155^17"
^DIC(9.4,83,22,16,"PAH",56,1,0)="^^5^5^3090421"
^DIC(9.4,83,22,16,"PAH",56,1,1,0)="When a PCA/Syringe is already signed out to a patient and that"
^DIC(9.4,83,22,16,"PAH",56,1,2,0)="green sheet and patient are trasnferred to another NAOU, the "
^DIC(9.4,83,22,16,"PAH",56,1,3,0)="quantity is subtracted from the sending NAOU and added to the"
^DIC(9.4,83,22,16,"PAH",56,1,4,0)="receiving NAOU even though it has already been signed out to"
^DIC(9.4,83,22,16,"PAH",56,1,5,0)="the patient."
^DIC(9.4,83,22,16,"PAH",57,0)="67 SEQ #57^3090422.114408^17"
^DIC(9.4,83,22,16,"PAH",57,1,0)="^^3^3^3090422"
^DIC(9.4,83,22,16,"PAH",57,1,1,0)="Returned to Stock does not accept quantity and PS Order Entry error."
^DIC(9.4,83,22,16,"PAH",57,1,2,0)="This patch also correct the pending order report problem for digitally"
^DIC(9.4,83,22,16,"PAH",57,1,3,0)="signed order."
^DIC(9.4,83,22,16,"PAH",58,0)="69 SEQ #58^3100621.091401^17"
^DIC(9.4,83,22,16,"PAH",58,1,0)="^^47^47^3100621"
^DIC(9.4,83,22,16,"PAH",58,1,1,0)="The FY10 Q2 Enhancement Release includes the following."
^DIC(9.4,83,22,16,"PAH",58,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,3,0)="Pharmacy Legacy Quarterly Enhancements (PLQE) subcommittee recommended the"
^DIC(9.4,83,22,16,"PAH",58,1,4,0)="creation of a new security key named PSD TECH ADV that will allow"
^DIC(9.4,83,22,16,"PAH",58,1,5,0)="Controlled Substances (CS) V. 3.0 package technicians to perform functions"
^DIC(9.4,83,22,16,"PAH",58,1,6,0)="currently controlled by the pharmacist key and/or on the pharmacist menu."
^DIC(9.4,83,22,16,"PAH",58,1,7,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,8,0)="This patch creates this new security key PSD TECH ADV, adds the following"
^DIC(9.4,83,22,16,"PAH",58,1,9,0)="options from the pharmacist menu to the Technician (CS Pharmacy) Menu [PSD"
^DIC(9.4,83,22,16,"PAH",58,1,10,0)="PHARM TECH], and allows the holders of this new key to perform these"
^DIC(9.4,83,22,16,"PAH",58,1,11,0)="additional functions."
^DIC(9.4,83,22,16,"PAH",58,1,12,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,13,0)="a. All options under the Receipts Into Pharmacy [PSD RECEIPTS MENU] menu."
^DIC(9.4,83,22,16,"PAH",58,1,14,0)="     Receiving [PSD RECEIVING]"
^DIC(9.4,83,22,16,"PAH",58,1,15,0)="     Purchase Order Review [PSD PURCHASE ORDER REVIEW]"
^DIC(9.4,83,22,16,"PAH",58,1,16,0)="     Control Point Transaction Review [PSD CP TRANSACTION REVIEW]"
^DIC(9.4,83,22,16,"PAH",58,1,17,0)="     Drug Receipt History [PSD DRUG RECEIPT HISTORY]"
^DIC(9.4,83,22,16,"PAH",58,1,18,0)="     Invoice Review (Prime Vendor) [PSD PV INVOICE REVIEW]"
^DIC(9.4,83,22,16,"PAH",58,1,19,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,20,0)="b. All options under the Dispensing Menu [PSD DISPENSING MENU]."
^DIC(9.4,83,22,16,"PAH",58,1,21,0)="     Print CS Dispensing Worksheet [PSD WORKSHEET PRINT]"
^DIC(9.4,83,22,16,"PAH",58,1,22,0)="     Fill/Dispense CS Orders from Worksheet [PSD WORKSHEET DISPENSING]"
^DIC(9.4,83,22,16,"PAH",58,1,23,0)="     Dispensing/Receiving Report (VA FORM 10-2321) [PSD PRINT 2321]"
^DIC(9.4,83,22,16,"PAH",58,1,24,0)="     Green Sheet - Print (VA FORM 10-2638) [PSD PRINT 2638]"
^DIC(9.4,83,22,16,"PAH",58,1,25,0)="     Reprint Reports Menu [PSD REPRINT MENU] menu"
^DIC(9.4,83,22,16,"PAH",58,1,26,0)="        Reprint Disp/Receiving Report (VA FORM 10-2321)"
^DIC(9.4,83,22,16,"PAH",58,1,27,0)="        Green Sheet Reprint (VA FORM 10-2638)"
^DIC(9.4,83,22,16,"PAH",58,1,28,0)="        Dispensing Worksheet Reprint"
^DIC(9.4,83,22,16,"PAH",58,1,29,0)="        Label Reprint for Dispensing Drug"
^DIC(9.4,83,22,16,"PAH",58,1,30,0)="        Reprint Transfer Between NAOUs (VA FORM 10-2321)"
^DIC(9.4,83,22,16,"PAH",58,1,31,0)="     Pharmacy Dispense without (VA FORM 10-2638) [PSD DISPENSE W/O GS]"
^DIC(9.4,83,22,16,"PAH",58,1,32,0)="     Label for Dispensing (Barcode) [PSD LABEL DRUG/NUMBER]"
^DIC(9.4,83,22,16,"PAH",58,1,33,0)="     Narcotic Dispensing Equipment Orders [PSD DISPENSE TO NDES]"
^DIC(9.4,83,22,16,"PAH",58,1,34,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,35,0)="c. The following options under the Destructions Menu [PSD DESTROY MENU]."
^DIC(9.4,83,22,16,"PAH",58,1,36,0)="     Hold a CS Drug (No Inventory Update) [PSD DEST NON-CS DRUG]"
^DIC(9.4,83,22,16,"PAH",58,1,37,0)="     Non-VA Drug Placed on Hold for Destruction [PSD DEST TEXT DRUG]"
^DIC(9.4,83,22,16,"PAH",58,1,38,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,39,0)="d. The following options were also added to the Technician (CS Pharmacy)"
^DIC(9.4,83,22,16,"PAH",58,1,40,0)="   Menu [PSD PHARM TECH]."
^DIC(9.4,83,22,16,"PAH",58,1,41,0)="     Manufacturer, Lot #, and Exp. Date - Enter/Edit [PSD MFG/LOT/EXP DATE"
^DIC(9.4,83,22,16,"PAH",58,1,42,0)="     EDIT]"
^DIC(9.4,83,22,16,"PAH",58,1,43,0)="     Outpatient Rx's [PSD OUTPATIENT]"
^DIC(9.4,83,22,16,"PAH",58,1,44,0)=" "
^DIC(9.4,83,22,16,"PAH",58,1,45,0)="    Note: The CS technician will be allowed to perform all the"
^DIC(9.4,83,22,16,"PAH",58,1,46,0)="          functionalities of the Outpatient Rx's [PSD OUTPATIENT] option"
^DIC(9.4,83,22,16,"PAH",58,1,47,0)="          except the releasing of a prescription."
^DIC(9.4,83,22,16,"PAH",59,0)="68 SEQ #59^3100923.103709^17"
^DIC(9.4,83,22,16,"PAH",59,1,0)="^^21^21^3100923"
^DIC(9.4,83,22,16,"PAH",59,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,83,22,16,"PAH",59,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",59,1,3,0)="1. HD67437 - BAC-1101-40568  Change in count & inability to track"
^DIC(9.4,83,22,16,"PAH",59,1,4,0)="   The Activity Report [PSD NURSE DISP REPORT] option does not print"
^DIC(9.4,83,22,16,"PAH",59,1,5,0)="   the correct drug balances."
^DIC(9.4,83,22,16,"PAH",59,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",59,1,7,0)="2. HD114292 - Activity report for transferred doesn't show activity"
^DIC(9.4,83,22,16,"PAH",59,1,8,0)="              until next day"
^DIC(9.4,83,22,16,"PAH",59,1,9,0)="   The ""Activity Report"" [PSD NURSE DISP REPORT] option for the NAOUs"
^DIC(9.4,83,22,16,"PAH",59,1,10,0)="   (Narcotics Area Of Use) does not reflect the Greensheet information"
^DIC(9.4,83,22,16,"PAH",59,1,11,0)="   for the transferred to ward but omits that information for the"
^DIC(9.4,83,22,16,"PAH",59,1,12,0)="   transferred from ward."
^DIC(9.4,83,22,16,"PAH",59,1,13,0)=" "
^DIC(9.4,83,22,16,"PAH",59,1,14,0)="3. HD343422 - Option displays wrong drug w/ PSD NURSE DISPENSING"
^DIC(9.4,83,22,16,"PAH",59,1,15,0)="   The ""Sign Out Dose for Patient"" [PSD NURSE DISPENSING] option returns"
^DIC(9.4,83,22,16,"PAH",59,1,16,0)="   the incorrect drug when scanned in and the incorrect drug is displayed."
^DIC(9.4,83,22,16,"PAH",59,1,17,0)=" "
^DIC(9.4,83,22,16,"PAH",59,1,18,0)="4. HD355446 - <undefined>DRUG+18^PSDRF *NAOU"
^DIC(9.4,83,22,16,"PAH",59,1,19,0)="   User receives an error when using the Sign Out Dose For Patient [PSD"
^DIC(9.4,83,22,16,"PAH",59,1,20,0)="   NURSE DISPENSING] option and enters a Pharmacy Dispensing # "
^DIC(9.4,83,22,16,"PAH",59,1,21,0)="  (Greensheet) that has a dispense date greater than one year old."
^DIC(9.4,83,22,16,"PAH",60,0)="71 SEQ #60^3110428.161621^17"
^DIC(9.4,83,22,16,"PAH",60,1,0)="^^52^52^3110428"
^DIC(9.4,83,22,16,"PAH",60,1,1,0)="Patch PSD*3.0*71 addresses two (2) issues."
^DIC(9.4,83,22,16,"PAH",60,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",60,1,3,0)="1. The recently released patch PSD*3*69 introduced a new key PSD TECH ADV,"
^DIC(9.4,83,22,16,"PAH",60,1,4,0)="   intended to allow a Controlled Substances technician access to some of"
^DIC(9.4,83,22,16,"PAH",60,1,5,0)="   the Pharmacist's menu as described in the PSD*3*69 patch description."
^DIC(9.4,83,22,16,"PAH",60,1,6,0)="   Some users have expressed concerns related to the Outpatient Rx's [PSD"
^DIC(9.4,83,22,16,"PAH",60,1,7,0)="   OUTPATIENT] option because the new PSD TECH ADV key was supposed to"
^DIC(9.4,83,22,16,"PAH",60,1,8,0)="   allow the posting of the transaction but not allow the release of the"
^DIC(9.4,83,22,16,"PAH",60,1,9,0)="   prescription. This patch will now allow a holder of the PSD TECH ADV"
^DIC(9.4,83,22,16,"PAH",60,1,10,0)="   key to perform all the functionalities of the Outpatient Rx's [PSD "
^DIC(9.4,83,22,16,"PAH",60,1,11,0)="   OUTPATIENT] option EXCEPT releasing prescriptions."
^DIC(9.4,83,22,16,"PAH",60,1,12,0)=" "
^DIC(9.4,83,22,16,"PAH",60,1,13,0)="2. The use of the PSD TECH ADV key was extended to grant its holder"
^DIC(9.4,83,22,16,"PAH",60,1,14,0)="   access to the options listed below. These options are available on the"
^DIC(9.4,83,22,16,"PAH",60,1,15,0)="   Technician (CS Pharmacy) Menu [PSD PHARM TECH]."
^DIC(9.4,83,22,16,"PAH",60,1,16,0)=" "
^DIC(9.4,83,22,16,"PAH",60,1,17,0)="      Complete Green Sheet [PSD COMPLETE GS]"
^DIC(9.4,83,22,16,"PAH",60,1,18,0)="      Destroyed Drugs Report [PSD DEST DRUGS REPORT]"
^DIC(9.4,83,22,16,"PAH",60,1,19,0)="      DEA Form 41 Destroyed Drugs Report [PSD DESTROY DEA41]"
^DIC(9.4,83,22,16,"PAH",60,1,20,0)="      Destructions Holding Report [PSD DESTRUCTION HOLDING]"
^DIC(9.4,83,22,16,"PAH",60,1,21,0)="      Add Existing Green Sheets at Setup [PSD EXISTING GS]"
^DIC(9.4,83,22,16,"PAH",60,1,22,0)="      Green Sheet Transfer Between NAOUs Report [PSD GS TRANSFER (NAOU)"
^DIC(9.4,83,22,16,"PAH",60,1,23,0)="        REPORT]"
^DIC(9.4,83,22,16,"PAH",60,1,24,0)="      Transfer Drugs between Dispensing Sites [PSD TRANSFER VAULT DRUGS]"
^DIC(9.4,83,22,16,"PAH",60,1,25,0)=" "
^DIC(9.4,83,22,16,"PAH",60,1,26,0)="   Once the patch is installed, the options on the Technician (CS "
^DIC(9.4,83,22,16,"PAH",60,1,27,0)="   Pharmacy) Menu [PSD PHARM TECH] will be similar to the list below."
^DIC(9.4,83,22,16,"PAH",60,1,28,0)=" "
^DIC(9.4,83,22,16,"PAH",60,1,29,0)="     Select Technician (CS Pharmacy) Menu Option: "
^DIC(9.4,83,22,16,"PAH",60,1,30,0)=" "
^DIC(9.4,83,22,16,"PAH",60,1,31,0)="             Print CS Dispensing Worksheet"
^DIC(9.4,83,22,16,"PAH",60,1,32,0)="             Fill/Dispense CS Orders from Worksheet"
^DIC(9.4,83,22,16,"PAH",60,1,33,0)="             Green Sheet Ready for Pickup Log"
^DIC(9.4,83,22,16,"PAH",60,1,34,0)="             Pick Up Green Sheet"
^DIC(9.4,83,22,16,"PAH",60,1,35,0)="             Complete Green Sheet"
^DIC(9.4,83,22,16,"PAH",60,1,36,0)="             Green Sheet History"
^DIC(9.4,83,22,16,"PAH",60,1,37,0)="             Add Existing Green Sheets at Setup"
^DIC(9.4,83,22,16,"PAH",60,1,38,0)="             Green Sheet Transfer Between NAOUs Report"
^DIC(9.4,83,22,16,"PAH",60,1,39,0)="             CS Order Entry For Ward"
^DIC(9.4,83,22,16,"PAH",60,1,40,0)="             Receipt of Controlled Substance from Pharmacy"
^DIC(9.4,83,22,16,"PAH",60,1,41,0)="             Daily Activity Log (in lieu of VA FORM 10-2320)"
^DIC(9.4,83,22,16,"PAH",60,1,42,0)="             List On-Hand Amounts"
^DIC(9.4,83,22,16,"PAH",60,1,43,0)="      TD     Transfer Drugs between Dispensing Sites"
^DIC(9.4,83,22,16,"PAH",60,1,44,0)="      TR     Transfer Drugs between Dispensing Sites Report"
^DIC(9.4,83,22,16,"PAH",60,1,45,0)="             Receipts Into Pharmacy ..."
^DIC(9.4,83,22,16,"PAH",60,1,46,0)="             Dispensing Menu ..."
^DIC(9.4,83,22,16,"PAH",60,1,47,0)="             Destructions Menu ..."
^DIC(9.4,83,22,16,"PAH",60,1,48,0)="             Destroyed Drugs Report"
^DIC(9.4,83,22,16,"PAH",60,1,49,0)="             DEA Form 41 Destroyed Drugs Report"
^DIC(9.4,83,22,16,"PAH",60,1,50,0)="             Destructions Holding Report"
^DIC(9.4,83,22,16,"PAH",60,1,51,0)="             Manufacturer, Lot #, and Exp. Date - Enter/Edit"
^DIC(9.4,83,22,16,"PAH",60,1,52,0)="             Outpatient Rx's"
^DIC(9.4,83,22,16,"PAH",61,0)="76^3130614.085941^17"
^DIC(9.4,83,22,16,"PAH",61,1,0)="^^14^14^3130614"
^DIC(9.4,83,22,16,"PAH",61,1,1,0)="The e-Prescribing of Controlled Substances (ePCS) project, which is "
^DIC(9.4,83,22,16,"PAH",61,1,2,0)="scheduled to be released later this year, will provide enhanced "
^DIC(9.4,83,22,16,"PAH",61,1,3,0)="functionality to allow for the electronic prescribing of controlled"
^DIC(9.4,83,22,16,"PAH",61,1,4,0)="substances while meeting Drug Enforcement Administration's regulations and"
^DIC(9.4,83,22,16,"PAH",61,1,5,0)="requirements."
^DIC(9.4,83,22,16,"PAH",61,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",61,1,7,0)="In preparation for this project, new security key PSDRPH is being added "
^DIC(9.4,83,22,16,"PAH",61,1,8,0)="in this patch. This key authorizes pharmacists to finish/verify digitally"
^DIC(9.4,83,22,16,"PAH",61,1,9,0)="signed Schedule II-V Controlled Substance (CS) orders placed via"
^DIC(9.4,83,22,16,"PAH",61,1,10,0)="COMPUTERIZED PATIENT RECORD SYSTEM (CPRS) V. 3.0. It should be assigned"
^DIC(9.4,83,22,16,"PAH",61,1,11,0)="only to registered pharmacists working with Schedule II-V drugs."
^DIC(9.4,83,22,16,"PAH",61,1,12,0)=" "
^DIC(9.4,83,22,16,"PAH",61,1,13,0)="The assignment of security key PSDRPH may be done at any time after the "
^DIC(9.4,83,22,16,"PAH",61,1,14,0)="release of this patch to begin the setup process required for ePCS."
^DIC(9.4,83,22,16,"PAH",62,0)="73^3130614.090224^17"
^DIC(9.4,83,22,16,"PAH",62,1,0)="^^169^169^3130614"
^DIC(9.4,83,22,16,"PAH",62,1,1,0)="This patch is being released as part of the DEA e-Prescribing of "
^DIC(9.4,83,22,16,"PAH",62,1,2,0)="Controlled Substances (CS) project using Public Key Infrastructure (PKI)"
^DIC(9.4,83,22,16,"PAH",62,1,3,0)="to satisfy requirements requested by the Drug Enforcement Administration"
^DIC(9.4,83,22,16,"PAH",62,1,4,0)="(DEA)."
^DIC(9.4,83,22,16,"PAH",62,1,5,0)="The applications involved in this project along with their patch "
^DIC(9.4,83,22,16,"PAH",62,1,6,0)="numbers are listed below and the same order should be followed when"
^DIC(9.4,83,22,16,"PAH",62,1,7,0)="installing the patches."
^DIC(9.4,83,22,16,"PAH",62,1,8,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,9,0)="   APPLICATION                                            PATCH"
^DIC(9.4,83,22,16,"PAH",62,1,10,0)="   -----------------------------------------------------------------"
^DIC(9.4,83,22,16,"PAH",62,1,11,0)="   KERNEL V. 8.0                                          XU*8*580"
^DIC(9.4,83,22,16,"PAH",62,1,12,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                  PSS*1*166"
^DIC(9.4,83,22,16,"PAH",62,1,13,0)="   COMPUTERIZED PATIENT RECORD SYSTEM (CPRS) V. 3.0       OR*3*306"
^DIC(9.4,83,22,16,"PAH",62,1,14,0)="   CONTROLLED SUBSTANCES (CS) V. 3.0                      PSD*3*73"
^DIC(9.4,83,22,16,"PAH",62,1,15,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                        PSO*7*391"
^DIC(9.4,83,22,16,"PAH",62,1,16,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,17,0)="Note: Patches PSO*7*391 and PSD*3*73 are being released in the Kernel "
^DIC(9.4,83,22,16,"PAH",62,1,18,0)="      Installation and Distribution System (KIDS) multi-build distribution"
^DIC(9.4,83,22,16,"PAH",62,1,19,0)="      CPRSV29_PSO_PSD. "
^DIC(9.4,83,22,16,"PAH",62,1,20,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,21,0)="The following modifications and enhancements are included in this patch"
^DIC(9.4,83,22,16,"PAH",62,1,22,0)="(PSD*3*73):"
^DIC(9.4,83,22,16,"PAH",62,1,23,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,24,0)="1. Digitally Signed CS Orders Report [PSD DIGITALLY SIGNED ORDERS]"
^DIC(9.4,83,22,16,"PAH",62,1,25,0)="   --------------------------------------------------------------"
^DIC(9.4,83,22,16,"PAH",62,1,26,0)="   a) This option is modified to allow the selection of specific CS"
^DIC(9.4,83,22,16,"PAH",62,1,27,0)="      Schedules when running the report as seen below:"
^DIC(9.4,83,22,16,"PAH",62,1,28,0)="  "
^DIC(9.4,83,22,16,"PAH",62,1,29,0)="      ..."
^DIC(9.4,83,22,16,"PAH",62,1,30,0)="   "
^DIC(9.4,83,22,16,"PAH",62,1,31,0)="      Sort By: Drug// ?"
^DIC(9.4,83,22,16,"PAH",62,1,32,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,33,0)="      Enter a code from the list."
^DIC(9.4,83,22,16,"PAH",62,1,34,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,35,0)="           Select one of the following:"
^DIC(9.4,83,22,16,"PAH",62,1,36,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,37,0)="             D         Drug"
^DIC(9.4,83,22,16,"PAH",62,1,38,0)="             PR        Provider"
^DIC(9.4,83,22,16,"PAH",62,1,39,0)="             PA        Patient"
^DIC(9.4,83,22,16,"PAH",62,1,40,0)="             S         Schedule"
^DIC(9.4,83,22,16,"PAH",62,1,41,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,42,0)="      Sort By: Drug// Schedule"
^DIC(9.4,83,22,16,"PAH",62,1,43,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,44,0)="      Select controlled substance schedule(s)"
^DIC(9.4,83,22,16,"PAH",62,1,45,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,46,0)="        Select one of the following:"
^DIC(9.4,83,22,16,"PAH",62,1,47,0)="    "
^DIC(9.4,83,22,16,"PAH",62,1,48,0)="             1         SCHEDULE II"
^DIC(9.4,83,22,16,"PAH",62,1,49,0)="             2         SCHEDULES III - V"
^DIC(9.4,83,22,16,"PAH",62,1,50,0)="             3         SCHEDULES II - V"
