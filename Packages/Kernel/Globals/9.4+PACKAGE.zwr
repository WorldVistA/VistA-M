^DIC(9.4,4,22,1,"PAH",91,0)="123 SEQ #116^3000502^1"
^DIC(9.4,4,22,1,"PAH",91,1,0)="^^63^63^3000502"
^DIC(9.4,4,22,1,"PAH",91,1,1,0)="Patch XM*7.1*123"
^DIC(9.4,4,22,1,"PAH",91,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",91,1,3,0)="NOIS: PUG-0300-50243"
^DIC(9.4,4,22,1,"PAH",91,1,4,0)="Test Site:  Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",91,1,5,0)="Fix a string length error which occurs when receiving network mail."
^DIC(9.4,4,22,1,"PAH",91,1,6,0)="A long sender string combined with a long subject can push a message's zero"
^DIC(9.4,4,22,1,"PAH",91,1,7,0)="node beyond 255 chars and cause the error.  This patch prevents that"
^DIC(9.4,4,22,1,"PAH",91,1,8,0)="error from occuring."
^DIC(9.4,4,22,1,"PAH",91,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",91,1,10,0)="This patch also improves the background filer checker.  It tells you if"
^DIC(9.4,4,22,1,"PAH",91,1,11,0)="the background filers have been shut down, and how to restart them."
^DIC(9.4,4,22,1,"PAH",91,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",91,1,13,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",91,1,14,0)="is at a minimum.  It requires MailMan patches XM*7.1*107 and XM*7.1*112."
^DIC(9.4,4,22,1,"PAH",91,1,15,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",91,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",91,1,17,0)="ROUTINES:"
