^DIC(9.4,100,22,15,"PAH",31,1,360,0)="   ------------       ------------        -----------         ----------"
^DIC(9.4,100,22,15,"PAH",31,1,361,0)="   YSGAFAPI               N/A                 1326501         53"
^DIC(9.4,100,22,15,"PAH",31,1,362,0)="   YSMTI                  N/A                 9401597         53"
^DIC(9.4,100,22,15,"PAH",31,1,363,0)="   YSMTI0                 N/A                 3775566         53"
^DIC(9.4,100,22,15,"PAH",31,1,364,0)="   YSMTI1                 N/A                 8825610         53"
