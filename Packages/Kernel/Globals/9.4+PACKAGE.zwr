^DIC(9.4,191,"VERSION")="1.0"
^DIC(9.4,192,0)="VISTALINK^XOBV^VistaLink"
^DIC(9.4,192,20,0)="^9.402P^^"
^DIC(9.4,192,22,0)="^9.49I^3^3"
^DIC(9.4,192,22,1,0)="1.0^3120508^3031121^1"
^DIC(9.4,192,22,1,1,0)="^^35^35^3120508"
^DIC(9.4,192,22,1,1,1,0)="This build contains TCP/IP transport functionality that enables"
^DIC(9.4,192,22,1,1,2,0)="synchronous communication from the following:"
^DIC(9.4,192,22,1,1,3,0)="   1) from non-M based systems to M-based VistA servers"
^DIC(9.4,192,22,1,1,4,0)="   2) from M VistA servers to non-M systems (typically Java/J2EE based"
^DIC(9.4,192,22,1,1,5,0)="      systems)"
^DIC(9.4,192,22,1,1,6,0)=" "
^DIC(9.4,192,22,1,1,7,0)="The communications are in the form of requests. For requests received by"
^DIC(9.4,192,22,1,1,8,0)="the M-based system, the VISTALINK package contains a Request Manager to"
^DIC(9.4,192,22,1,1,9,0)="manage these requests. Requests are forwarded to the appropriate Request"
^DIC(9.4,192,22,1,1,10,0)="Handler."
^DIC(9.4,192,22,1,1,11,0)=" "
^DIC(9.4,192,22,1,1,12,0)="The VISTALINK package contains two native request handlers. One handles "
^DIC(9.4,192,22,1,1,13,0)="system-type requests, like client heartbeats and close socket requests. "
^DIC(9.4,192,22,1,1,14,0)="The other handler processes RPC requests."
^DIC(9.4,192,22,1,1,15,0)=" "
^DIC(9.4,192,22,1,1,16,0)="Other packages can also supply handlers. For example, VISTALINK SECURITY"
^DIC(9.4,192,22,1,1,17,0)="(XOBS) supplies a handler that is used to process VistA security-related"
^DIC(9.4,192,22,1,1,18,0)="requests."
^DIC(9.4,192,22,1,1,19,0)=" "
^DIC(9.4,192,22,1,1,20,0)="VISTALINK allows the following request formats:"
^DIC(9.4,192,22,1,1,21,0)="   1) XML and conform to a XML Schema "
^DIC(9.4,192,22,1,1,22,0)="   2) a proprietary format (package must supply a proprietary parser)"
^DIC(9.4,192,22,1,1,23,0)="   3) both 1 and 2"
^DIC(9.4,192,22,1,1,24,0)=" "
^DIC(9.4,192,22,1,1,25,0)="VISTALINK also supplies a Java/J2EE component that allows developers of"
^DIC(9.4,192,22,1,1,26,0)="Java applications to make synchronous requests on the M server and for M"
^DIC(9.4,192,22,1,1,27,0)="applications to make synchronous requests of Java/J2EE application"
^DIC(9.4,192,22,1,1,28,0)="servers. The Java/J2EE side implements the J2EE Connector Architecture"
^DIC(9.4,192,22,1,1,29,0)="v1.0 framework (J2CA)."
^DIC(9.4,192,22,1,1,30,0)=" "
^DIC(9.4,192,22,1,1,31,0)="** NOTE: As of 7/2005, VISTALINK only supports Java to M communication."
^DIC(9.4,192,22,1,1,32,0)=" "
^DIC(9.4,192,22,1,1,33,0)="Finally, VISTALINK contains a number of library calls available to "
^DIC(9.4,192,22,1,1,34,0)="other packages for developing a request handler if needed. (Currently, "
^DIC(9.4,192,22,1,1,35,0)="only VISTALINK SECURITY is allowed to use these calls.)"
^DIC(9.4,192,22,1,"PAH",0)="^9.4901^2^2"
^DIC(9.4,192,22,1,"PAH",1,0)="1^3030330^990"
^DIC(9.4,192,22,1,"PAH",1,1,0)="^^4^4^3030330"
^DIC(9.4,192,22,1,"PAH",1,1,1,0)="This build contains the M side software for the Foundations Toolbox."
^DIC(9.4,192,22,1,"PAH",1,1,2,0)=" "
^DIC(9.4,192,22,1,"PAH",1,1,3,0)=" "
^DIC(9.4,192,22,1,"PAH",1,1,4,0)="This build requires that the M XML Parser 1.1 be installed in the account."
^DIC(9.4,192,22,1,"PAH",2,0)="1 SEQ #1^3040924^1"
^DIC(9.4,192,22,1,"PAH",2,1,0)="^^5^5^3040924"
^DIC(9.4,192,22,1,"PAH",2,1,1,0)=" This patch will set the RPC Broker variable XWBOS in VistALink routine"
^DIC(9.4,192,22,1,"PAH",2,1,2,0)=" XOBVSKT which is used in TCP/IP socket processes."
^DIC(9.4,192,22,1,"PAH",2,1,3,0)=" "
^DIC(9.4,192,22,1,"PAH",2,1,4,0)=" Setting this variable is necessary to accomodate remote procedure calls "
^DIC(9.4,192,22,1,"PAH",2,1,5,0)=" that test for this variable directly."
^DIC(9.4,192,22,1,"PAH","B",1,1)=""
^DIC(9.4,192,22,1,"PAH","B","1 SEQ #1",2)=""
^DIC(9.4,192,22,2,0)="1.5^3050909^3060608^1"
^DIC(9.4,192,22,2,1,0)="^^37^37^3060608"
^DIC(9.4,192,22,2,1,1,0)="This build contains TCP/IP transport functionality that enables"
^DIC(9.4,192,22,2,1,2,0)="synchronous communication from the following:"
^DIC(9.4,192,22,2,1,3,0)="   1) from non-M based systems to M-based VistA servers"
^DIC(9.4,192,22,2,1,4,0)="   2) from M VistA servers to non-M systems (typically Java/J2EE based"
^DIC(9.4,192,22,2,1,5,0)="      systems)"
^DIC(9.4,192,22,2,1,6,0)=" "
^DIC(9.4,192,22,2,1,7,0)="The communications are in the form of requests. For requests received by"
^DIC(9.4,192,22,2,1,8,0)="the M-based system, the VISTALINK package contains a Request Manager to"
^DIC(9.4,192,22,2,1,9,0)="manage these requests. Requests are forwarded to the appropriate Request"
