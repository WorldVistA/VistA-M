^DIC(9.4,3,22,21,"PAH",80,1,50,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",80,1,51,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",80,1,52,0)=""
^DIC(9.4,3,22,21,"PAH",80,1,53,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",80,1,54,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",80,1,55,0)="      "
^DIC(9.4,3,22,21,"PAH",80,1,56,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",80,1,57,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",80,1,58,0)="      "
^DIC(9.4,3,22,21,"PAH",80,1,59,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",80,1,60,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",80,1,61,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",80,1,62,0)="      options:"
^DIC(9.4,3,22,21,"PAH",80,1,63,0)="      "
