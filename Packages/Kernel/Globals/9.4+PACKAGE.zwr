^DIC(9.4,100,22,15,"PAH",102,0)="173 SEQ #131^3210409.102647^17"
^DIC(9.4,100,22,15,"PAH",102,1,0)="^^3^3^3210409"
^DIC(9.4,100,22,15,"PAH",102,1,1,0)="This build inactivates the ""I9"" instruments, as they have been superseded "
^DIC(9.4,100,22,15,"PAH",102,1,2,0)="by the C-SSRS screener.  The C-SSRS has been set so that it must be "
^DIC(9.4,100,22,15,"PAH",102,1,3,0)="completed in one session.  New versions of the PROMIS29 are added."
^DIC(9.4,100,22,15,"PAH",103,0)="175b^3210420"
^DIC(9.4,100,22,15,"PAH",103,1,0)="^^5^5^3210420"
^DIC(9.4,100,22,15,"PAH",103,1,1,0)="Backup of YS*5.01*175 on Apr 20, 2021"
^DIC(9.4,100,22,15,"PAH",103,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",103,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,100,22,15,"PAH",103,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,100,22,15,"PAH",103,1,5,0)="Please verify with the Development Team that it is safe to install."
