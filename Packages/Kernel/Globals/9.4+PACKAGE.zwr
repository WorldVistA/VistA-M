^DIC(9.4,14,22,5.9,"PAH",206,1,72,0)="NORTH CHICAGO, IL"
^DIC(9.4,14,22,5.9,"PAH",206,1,73,0)="OKLAHOMA CITY, OK"
^DIC(9.4,14,22,5.9,"PAH",206,1,74,0)="PHILADELPHIA, PA"
