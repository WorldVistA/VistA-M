^DIC(9.4,115,22,2,"PAH",122,1,3,0)="installation instructions for RA*5.0*135 before installing this patch."
^DIC(9.4,115,22,2,"PAH",123,0)="143 SEQ #128^3180601.162316^54"
^DIC(9.4,115,22,2,"PAH",123,1,0)="^^4^4^3180601"
^DIC(9.4,115,22,2,"PAH",123,1,1,0)="This patch will resolve the following issues in the RADIOLOGY/NUCLEAR "
^DIC(9.4,115,22,2,"PAH",123,1,2,0)="MEDICINE (RA) package:"
^DIC(9.4,115,22,2,"PAH",123,1,3,0)=" "
^DIC(9.4,115,22,2,"PAH",123,1,4,0)="1) RA REPORTS SHOW INCORRECT COMMENTS"
^DIC(9.4,115,22,2,"PAH",124,0)="147 SEQ #129^3180803.150642^54"
^DIC(9.4,115,22,2,"PAH",124,1,0)="^^1^1^3180803"
^DIC(9.4,115,22,2,"PAH",124,1,1,0)="2018 MAINT OF RADIOLOGY FILE #73.2 (RADIOLOGY CPT BY PROCEDURE TYPE)"
^DIC(9.4,115,22,2,"PAH",125,0)="145 SEQ #130^3180907.121955^54"
^DIC(9.4,115,22,2,"PAH",125,1,0)="^^2^2^3180907"
^DIC(9.4,115,22,2,"PAH",125,1,1,0)="This patch will address the following issue:"
^DIC(9.4,115,22,2,"PAH",125,1,2,0)="RA18589477FY18 - Multiple errors in error trap. <UNDEFINED>EN1+63^RAO7RO"
^DIC(9.4,115,22,2,"PAH",126,0)="144 SEQ #131^3180907.131717^54"
^DIC(9.4,115,22,2,"PAH",126,1,0)="^^20^20^3180907"
^DIC(9.4,115,22,2,"PAH",126,1,1,0)="NTP release report (VAQ) message sent to PACS."
^DIC(9.4,115,22,2,"PAH",126,1,2,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,3,0)="Remove old HLO query code for previous NTP vendor. "
^DIC(9.4,115,22,2,"PAH",126,1,4,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,5,0)="'Add Exam to Last Visit' erroneous report"
^DIC(9.4,115,22,2,"PAH",126,1,6,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,7,0)="Reject HL7 report (ORU) with inactive DX codes passed."
^DIC(9.4,115,22,2,"PAH",126,1,8,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,9,0)="Remove redundant GENERATE^HLMA call."
^DIC(9.4,115,22,2,"PAH",126,1,10,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,11,0)="Registered request printer pulled from exam's imaging location (previously"
^DIC(9.4,115,22,2,"PAH",126,1,12,0)="pulled from the order's imaging location)."
^DIC(9.4,115,22,2,"PAH",126,1,13,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,14,0)="Remove RAPX var check from printer logic."
^DIC(9.4,115,22,2,"PAH",126,1,15,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,16,0)="Remove conditions for duplicate procedure to print exam information on "
^DIC(9.4,115,22,2,"PAH",126,1,17,0)="the registered request"
^DIC(9.4,115,22,2,"PAH",126,1,18,0)=" "
^DIC(9.4,115,22,2,"PAH",126,1,19,0)="Strip site prefix from accession number received in ORU if SSAN is "
^DIC(9.4,115,22,2,"PAH",126,1,20,0)="disabled."
^DIC(9.4,115,22,2,"PAH",127,0)="149 SEQ #132^3181004.172644^54"
^DIC(9.4,115,22,2,"PAH",127,1,0)="^^3^3^3181004"
^DIC(9.4,115,22,2,"PAH",127,1,1,0)="The purpose of this patch is to address the issue of the Weight Date not "
