^DIC(9.4,49,22,10,"PAH",134,1,4,0)=" OKL-1001-73313 [IBJD FOLLOW-UP FIRST PARTY] incorrect Data (0 to n Range)"
^DIC(9.4,49,22,10,"PAH",135,0)="231 SEQ #202^3030813^1"
^DIC(9.4,49,22,10,"PAH",135,1,0)="^^1^1^3030813"
^DIC(9.4,49,22,10,"PAH",135,1,1,0)="REMOTE INSURANCE QUERY FIX/UPDATE"
^DIC(9.4,49,22,10,"PAH",136,0)="221 SEQ #203^3030821^1"
^DIC(9.4,49,22,10,"PAH",136,1,0)="^^2^2^3030821"
^DIC(9.4,49,22,10,"PAH",136,1,1,0)="This patch adds new Occurence Codes and Occurrence Span Codes"
^DIC(9.4,49,22,10,"PAH",136,1,2,0)="to file 399.1."
^DIC(9.4,49,22,10,"PAH",137,0)="229 SEQ #204^3030912^1"
^DIC(9.4,49,22,10,"PAH",137,1,0)="^^8^8^3030912"
^DIC(9.4,49,22,10,"PAH",137,1,1,0)="This patch updates the Information/Warning records in file #361."
^DIC(9.4,49,22,10,"PAH",137,1,2,0)="Ref. NOIS FGH-0203-31133"
^DIC(9.4,49,22,10,"PAH",137,1,3,0)="Routine:  IB20P229, a database conversion routine."
^DIC(9.4,49,22,10,"PAH",137,1,4,0)="  "
^DIC(9.4,49,22,10,"PAH",137,1,5,0)="This patch also fixes a display problem with the Contact Date"
^DIC(9.4,49,22,10,"PAH",137,1,6,0)="and Call Ref. No. on the IBCN PATIENT INSURANCE screens."
^DIC(9.4,49,22,10,"PAH",137,1,7,0)="Ref. NOIS BAY-0403-32311"
^DIC(9.4,49,22,10,"PAH",137,1,8,0)="Routine: IBCNSP0"
^DIC(9.4,49,22,10,"PAH",138,0)="226 SEQ #205^3030912^1"
^DIC(9.4,49,22,10,"PAH",138,1,0)="^^20^20^3030912"
^DIC(9.4,49,22,10,"PAH",138,1,1,0)="This patch adds some error trapping code to avoid a problem in the"
^DIC(9.4,49,22,10,"PAH",138,1,2,0)="Claims Manager interface that could cause users to be forcibly logged"
^DIC(9.4,49,22,10,"PAH",138,1,3,0)="out.  "
^DIC(9.4,49,22,10,"PAH",138,1,4,0)=" "
^DIC(9.4,49,22,10,"PAH",138,1,5,0)="ASSOCIATED NOIS:"
^DIC(9.4,49,22,10,"PAH",138,1,6,0)="================"
^DIC(9.4,49,22,10,"PAH",138,1,7,0)="1. PRE-0902-60489        Claims Manager  freezing screen "
^DIC(9.4,49,22,10,"PAH",138,1,8,0)="      DUB-0303-31898     <READ>READ+27^IBCIUT3"
^DIC(9.4,49,22,10,"PAH",138,1,9,0)="      ASH-0103-30446     ib error when going to claimsmanager"
^DIC(9.4,49,22,10,"PAH",138,1,10,0)="  "
^DIC(9.4,49,22,10,"PAH",138,1,11,0)="TECHNICAL:"
^DIC(9.4,49,22,10,"PAH",138,1,12,0)="=========="
^DIC(9.4,49,22,10,"PAH",138,1,13,0)="1.  Changes are made to routines IBCIUT3 and IBCIUT4."
^DIC(9.4,49,22,10,"PAH",138,1,14,0)="    IBCIUT3"
^DIC(9.4,49,22,10,"PAH",138,1,15,0)="      A new subroutine, ERRTRP, releases the tcp/ip port and creates the"
^DIC(9.4,49,22,10,"PAH",138,1,16,0)="      message ""A SYSTEM ERROR HAS BEEN DETECTED AT THE FOLLOWING LOCATION""."
^DIC(9.4,49,22,10,"PAH",138,1,17,0)="      A new level is pushed on the error trap stack and the $ETRAP system"
^DIC(9.4,49,22,10,"PAH",138,1,18,0)="      variable is set to call the new ERRTRP subroutine."
^DIC(9.4,49,22,10,"PAH",138,1,19,0)="    IBCIUT4"
^DIC(9.4,49,22,10,"PAH",138,1,20,0)="      A new error type, ""Fatal System Error"" is added to the P1 function."
^DIC(9.4,49,22,10,"PAH",139,0)="224 SEQ #206^3030912^1"
^DIC(9.4,49,22,10,"PAH",139,1,0)="^^12^12^3030912"
^DIC(9.4,49,22,10,"PAH",139,1,1,0)="Special Mid-Year FY03 Stop Codes Update"
^DIC(9.4,49,22,10,"PAH",139,1,2,0)="======================================="
^DIC(9.4,49,22,10,"PAH",139,1,3,0)=""
^DIC(9.4,49,22,10,"PAH",139,1,4,0)="CODE   DESCRIPTIONS                                   BILLABLE TYPE *           "
^DIC(9.4,49,22,10,"PAH",139,1,5,0)="----   ----------------------------------------       -------------"
^DIC(9.4,49,22,10,"PAH",139,1,6,0)="161    PHARMACY TRANSITION CARE                             N"
^DIC(9.4,49,22,10,"PAH",139,1,7,0)="179    HOME TELEVIDEO CARE                                  N"
^DIC(9.4,49,22,10,"PAH",139,1,8,0)="220    VISOR (VISUAL IMPAIRMENT OUTPATIENT PROGRAM)         N"
^DIC(9.4,49,22,10,"PAH",139,1,9,0)="683    NONVIDEO HOME TELEHEALTH MONITOR ONLY (NONCOUNT)     N"
^DIC(9.4,49,22,10,"PAH",139,1,10,0)="684    NONVIDEO HOME TELEHEALTH INTERVENTION                N"
^DIC(9.4,49,22,10,"PAH",139,1,11,0)=""
^DIC(9.4,49,22,10,"PAH",139,1,12,0)="* N = Nonbillable"
^DIC(9.4,49,22,10,"PAH",140,0)="238 SEQ #207^3030912^1"
^DIC(9.4,49,22,10,"PAH",140,1,0)="^^8^8^3030912"
^DIC(9.4,49,22,10,"PAH",140,1,1,0)="This patch addresses an issue where the ELECTRONIC PLAN TYPE field was not"
^DIC(9.4,49,22,10,"PAH",140,1,2,0)="available for editing in the Move Subscribers to a Different Plan option."
^DIC(9.4,49,22,10,"PAH",140,1,3,0)="ASSOCIATED NOIS:"
^DIC(9.4,49,22,10,"PAH",140,1,4,0)="================"
^DIC(9.4,49,22,10,"PAH",140,1,5,0)="    "
^DIC(9.4,49,22,10,"PAH",140,1,6,0)="1. PUG-0403-50885  Electronic Type not included when moving Ins Plans"
^DIC(9.4,49,22,10,"PAH",140,1,7,0)=" "
^DIC(9.4,49,22,10,"PAH",140,1,8,0)="Routine: IBCNSUR2"
^DIC(9.4,49,22,10,"PAH",141,0)="235 SEQ #208^3030924^1"
^DIC(9.4,49,22,10,"PAH",141,1,0)="^^4^4^3030924"
^DIC(9.4,49,22,10,"PAH",141,1,1,0)="This patch updates the unbilled amounts report to generate according to "
^DIC(9.4,49,22,10,"PAH",141,1,2,0)="the new EOAM schedule.  Changes in routines IBJDE, IBTUBO and IBTUBOU have"
^DIC(9.4,49,22,10,"PAH",141,1,3,0)="been made to accommodate the changes as well as changes to the INPUT VARIABLE"
^DIC(9.4,49,22,10,"PAH",141,1,4,0)="section of file 351.7 DIAGNOSTIC MEASURES REPORTS."
^DIC(9.4,49,22,10,"PAH",142,0)="184^3030924^1"
^DIC(9.4,49,22,10,"PAH",142,1,0)="^^2^2^3030924"
^DIC(9.4,49,22,10,"PAH",142,1,1,0)="This is the build for the electronic Insurance Identification and "
^DIC(9.4,49,22,10,"PAH",142,1,2,0)="Verification project (also referred to as eIIV and IIV)."
^DIC(9.4,49,22,10,"PAH",143,0)="242 SEQ #210^3030924^1"
^DIC(9.4,49,22,10,"PAH",144,0)="210^3030924^1"
^DIC(9.4,49,22,10,"PAH",144,1,0)="^^4^4^3030924"
^DIC(9.4,49,22,10,"PAH",144,1,1,0)="Code Set Versioning, the IB part. Phase 1."
^DIC(9.4,49,22,10,"PAH",144,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",144,1,3,0)="Please see the National Patch Module for details"
^DIC(9.4,49,22,10,"PAH",144,1,4,0)="of the enhancements included in this patch."
^DIC(9.4,49,22,10,"PAH",145,0)="205 SEQ #213^3031023^1"
^DIC(9.4,49,22,10,"PAH",145,1,0)="^^3^3^3031023"
^DIC(9.4,49,22,10,"PAH",145,1,1,0)="This patch adds an additional prompt to the Third Party Follow-up report"
^DIC(9.4,49,22,10,"PAH",145,1,2,0)="to allow the generation of the report from the date of care to the date"
^DIC(9.4,49,22,10,"PAH",145,1,3,0)="the report is run."
^DIC(9.4,49,22,10,"PAH",146,0)="135^3031023^1"
^DIC(9.4,49,22,10,"PAH",146,1,0)="^^6^6^3031023"
^DIC(9.4,49,22,10,"PAH",146,1,1,0)="Third Party EDI Lockbox patch IB*2.0*135 (Integrated Billing component)"
^DIC(9.4,49,22,10,"PAH",146,1,2,0)=" "
^DIC(9.4,49,22,10,"PAH",146,1,3,0)="This patch is being released as part of a build that also includes patch"
^DIC(9.4,49,22,10,"PAH",146,1,4,0)="PRCA*4.5*173.  Please refer to the patch description in the National Patch"
^DIC(9.4,49,22,10,"PAH",146,1,5,0)="module and the users documentation for patch PRCA*4.5*173 for detailed"
^DIC(9.4,49,22,10,"PAH",146,1,6,0)="information about this patch."
^DIC(9.4,49,22,10,"PAH",147,0)="236 SEQ #215^3031023^1"
^DIC(9.4,49,22,10,"PAH",147,1,0)="^^1^1^3031023"
^DIC(9.4,49,22,10,"PAH",147,1,1,0)="INTERIM ADDRESS ENHANCEMENT"
^DIC(9.4,49,22,10,"PAH",148,0)="246 SEQ #212^3031023^1"
^DIC(9.4,49,22,10,"PAH",148,1,0)="^^12^12^3031023"
^DIC(9.4,49,22,10,"PAH",148,1,1,0)="IIV Update for Individually Accept method in the Insurance Buffer "
^DIC(9.4,49,22,10,"PAH",148,1,2,0)="acceptance process."
^DIC(9.4,49,22,10,"PAH",148,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",148,1,4,0)="This patch fixes a problem identified in the IB Insurance Buffer "
^DIC(9.4,49,22,10,"PAH",148,1,5,0)="Individually Accept action.  Under certain circumstances the problem may "
^DIC(9.4,49,22,10,"PAH",148,1,6,0)="result in incorrect filing of information from the Insurance Buffer.  "
^DIC(9.4,49,22,10,"PAH",148,1,7,0)="This "
^DIC(9.4,49,22,10,"PAH",148,1,8,0)="action was released with IB*2*184, therefore this patch should be "
^DIC(9.4,49,22,10,"PAH",148,1,9,0)="installed as soon after IB*2*184 as is practicable."
^DIC(9.4,49,22,10,"PAH",148,1,10,0)="            "
^DIC(9.4,49,22,10,"PAH",148,1,11,0)="* NOTE: This patch must be installed by October 7, 2003, in order to meet "
^DIC(9.4,49,22,10,"PAH",148,1,12,0)="* the HIPAA compliance date for use of the software by October 16, 2003. "
^DIC(9.4,49,22,10,"PAH",149,0)="248 SEQ #216^3031107^1"
^DIC(9.4,49,22,10,"PAH",149,1,0)="^^6^6^3031107"
^DIC(9.4,49,22,10,"PAH",149,1,1,0)="This patch corrects the unbilled amounts report from generating"
^DIC(9.4,49,22,10,"PAH",149,1,2,0)="again on the first of the month with the other DM reports.  It also"
^DIC(9.4,49,22,10,"PAH",149,1,3,0)="corrects the IBT RE-GENERATE UNBILLED AMOUNTS REPORT.  The end date for"
^DIC(9.4,49,22,10,"PAH",149,1,4,0)="the report for months prior to September 2003 will display as the last day"
^DIC(9.4,49,22,10,"PAH",149,1,5,0)="of the calendar month.  Those months after September 2003 will use the"
^DIC(9.4,49,22,10,"PAH",149,1,6,0)="EOAM date for that month."
^DIC(9.4,49,22,10,"PAH",150,0)="234 SEQ #217^3031107^1"
^DIC(9.4,49,22,10,"PAH",150,1,0)="^^1^1^3031107"
^DIC(9.4,49,22,10,"PAH",150,1,1,0)="COMBAT VETERANS INTERIM SOLUTION - PHASE I"
^DIC(9.4,49,22,10,"PAH",151,0)="254 SEQ #218^3031126^1"
^DIC(9.4,49,22,10,"PAH",151,1,0)="^^2^2^3031126"
^DIC(9.4,49,22,10,"PAH",151,1,1,0)="This patch fixes the transmission of the Diagnostic Measures reports"
^DIC(9.4,49,22,10,"PAH",151,1,2,0)="for future runs."
^DIC(9.4,49,22,10,"PAH",152,0)="227 SEQ #219^3031231^1"
^DIC(9.4,49,22,10,"PAH",152,1,0)="^^3^3^3031231"
^DIC(9.4,49,22,10,"PAH",152,1,1,0)="This patch corrects the problem of bills reflecting that they are "
^DIC(9.4,49,22,10,"PAH",152,1,2,0)="referred to Regional Counsel, when they are no longer referred, on the "
^DIC(9.4,49,22,10,"PAH",152,1,3,0)="Third Party Follow-up Report."
^DIC(9.4,49,22,10,"PAH",153,0)="217 SEQ #220^3031231^1"
^DIC(9.4,49,22,10,"PAH",153,1,0)="^^236^236^3031231"
^DIC(9.4,49,22,10,"PAH",153,1,1,0)="This patch corrects a problem with Means Test reminder letters, fixes"
^DIC(9.4,49,22,10,"PAH",153,1,2,0)="an <UNDEF> error which could occur in IBT OUTPUT MCCR/UR SUMMARY, modifies"
^DIC(9.4,49,22,10,"PAH",153,1,3,0)="the SUPRESS BULLETIN field of the IBCE MESSAGES SERVER option and fixes"
^DIC(9.4,49,22,10,"PAH",153,1,4,0)="an <UNDEF> error in the IBT SEND TEST UNBILLED MESS option.  "
^DIC(9.4,49,22,10,"PAH",153,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,6,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,7,0)="ASSOCIATED E3R(s):"
^DIC(9.4,49,22,10,"PAH",153,1,8,0)="=================="
^DIC(9.4,49,22,10,"PAH",153,1,9,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,10,0)="N/A"
^DIC(9.4,49,22,10,"PAH",153,1,11,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,12,0)="ASSOCIATED NOIS:"
^DIC(9.4,49,22,10,"PAH",153,1,13,0)="================"
^DIC(9.4,49,22,10,"PAH",153,1,14,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,15,0)="1. SHE-0801-51284     Cat C reminder letters printing"
^DIC(9.4,49,22,10,"PAH",153,1,16,0)="2. COA-0403-21056     <UNDEF> MAIN+2^IBTOSUM2 in MCCR/UR SUMMARY REPORT"
^DIC(9.4,49,22,10,"PAH",153,1,17,0)="3. SBY-0403-30897     Claims Waiting Austin Acknowledgement"
^DIC(9.4,49,22,10,"PAH",153,1,18,0)="4. BRX-0403-12417     BULL1+4^IBTUBUL:1, %DSM-E-UNDEF, undefined variable"
^DIC(9.4,49,22,10,"PAH",153,1,19,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,20,0)="NOIS OVERVIEW:"
^DIC(9.4,49,22,10,"PAH",153,1,21,0)="=============="
^DIC(9.4,49,22,10,"PAH",153,1,22,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,23,0)="1. SHE-0801-51284     Cat C reminder letters printing "
^DIC(9.4,49,22,10,"PAH",153,1,24,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,25,0)="   Problem:"
^DIC(9.4,49,22,10,"PAH",153,1,26,0)="   --------"
^DIC(9.4,49,22,10,"PAH",153,1,27,0)="       With DG*5.3*326, Category C veterans and those Pending Adjudication and "
^DIC(9.4,49,22,10,"PAH",153,1,28,0)="   having agreed to pay the deductible, and whose Means Test is more recent"
^DIC(9.4,49,22,10,"PAH",153,1,29,0)="   than 10/5/99, will no longer be subject to an annual MT.  However, if the"
^DIC(9.4,49,22,10,"PAH",153,1,30,0)="   site has the Income Test Reminder Letters option turned on, these now"
^DIC(9.4,49,22,10,"PAH",153,1,31,0)="   exempt patients are included in the output.  Since they are no longer"
^DIC(9.4,49,22,10,"PAH",153,1,32,0)="   subject to MT, their copay status will remain unchanged.  As such, they"
^DIC(9.4,49,22,10,"PAH",153,1,33,0)="   should no longer be included in those patients due for a reminder.  "
^DIC(9.4,49,22,10,"PAH",153,1,34,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,35,0)="   Resolution:"
^DIC(9.4,49,22,10,"PAH",153,1,36,0)="   -----------"
^DIC(9.4,49,22,10,"PAH",153,1,37,0)="   This patch corrects the issue by checking the veteran's status and "
^DIC(9.4,49,22,10,"PAH",153,1,38,0)="   removing them from the Means Test reminder list if they meet the"
^DIC(9.4,49,22,10,"PAH",153,1,39,0)="   criteria mentioned above."
^DIC(9.4,49,22,10,"PAH",153,1,40,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,41,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,42,0)="2. COA-0403-21056     <UNDEF> MAIN+2^IBTOSUM2 in MCCR/UR SUMMARY REPORT"
^DIC(9.4,49,22,10,"PAH",153,1,43,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,44,0)="   Problem:"
^DIC(9.4,49,22,10,"PAH",153,1,45,0)="   --------"
^DIC(9.4,49,22,10,"PAH",153,1,46,0)="   When running the IBT OUTPUT MCCR/UR SUMMARY option for a date range that"
^DIC(9.4,49,22,10,"PAH",153,1,47,0)="   contains no Claims Tracking entry that is ACTIVE, INSURED and BILLABLE,"
^DIC(9.4,49,22,10,"PAH",153,1,48,0)="   an undefined error would occur.  The printing function expected to find"
^DIC(9.4,49,22,10,"PAH",153,1,49,0)="   a value in the counter IBCNT(3,0) but if no records were selected "
^DIC(9.4,49,22,10,"PAH",153,1,50,0)="   during the search, the counter was never set."
^DIC(9.4,49,22,10,"PAH",153,1,51,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,52,0)="   Resolution:"
^DIC(9.4,49,22,10,"PAH",153,1,53,0)="   -----------"
^DIC(9.4,49,22,10,"PAH",153,1,54,0)="   The counter array variable IBCNT(3,0) is initialized to zero prior"
^DIC(9.4,49,22,10,"PAH",153,1,55,0)="   to the record search."
^DIC(9.4,49,22,10,"PAH",153,1,56,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,57,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,58,0)="3. SBY-0403-30897     Claims Waiting Austin Acknowledgement"
^DIC(9.4,49,22,10,"PAH",153,1,59,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,60,0)="   Problem:"
^DIC(9.4,49,22,10,"PAH",153,1,61,0)="   --------"
^DIC(9.4,49,22,10,"PAH",153,1,62,0)="   When acknowledgment messages or status update messages are received"
^DIC(9.4,49,22,10,"PAH",153,1,63,0)="   from Austin, they are delivered to the S.IBCE MESSAGES SERVER"
^DIC(9.4,49,22,10,"PAH",153,1,64,0)="   option.  Because there is no specific SERVER MAIL GROUP defined for "
^DIC(9.4,49,22,10,"PAH",153,1,65,0)="   this option, and the SUPRESS BULLETIN field is NULL (the default is"
^DIC(9.4,49,22,10,"PAH",153,1,66,0)="   to send), a message is sent to the default MAIL GROUP defined in the"
^DIC(9.4,49,22,10,"PAH",153,1,67,0)="   XQSERVER Bulletin (file 3.6).  This is GENERALLY a mail group called "
^DIC(9.4,49,22,10,"PAH",153,1,68,0)="   XQSERVER but it may have some other name.  If this MAIL GROUP "
^DIC(9.4,49,22,10,"PAH",153,1,69,0)="   specified in the XQSERVER Bulletin suddenly has NO active members (for "
^DIC(9.4,49,22,10,"PAH",153,1,70,0)="   whatever reason), the incoming messages will be RECEIVED, but the IBCE "
^DIC(9.4,49,22,10,"PAH",153,1,71,0)="   MESSAGES SERVER is not served.  The server option is listed as a"
^DIC(9.4,49,22,10,"PAH",153,1,72,0)="   recipient but server action was not processed due to a security"
^DIC(9.4,49,22,10,"PAH",153,1,73,0)="   violation."
^DIC(9.4,49,22,10,"PAH",153,1,74,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,75,0)="   Resolution:"
^DIC(9.4,49,22,10,"PAH",153,1,76,0)="   -----------"
^DIC(9.4,49,22,10,"PAH",153,1,77,0)="   The issue could be resolved on a local basis by making sure that there"
^DIC(9.4,49,22,10,"PAH",153,1,78,0)="   is always a member of whichever mail group is specified by the XQSERVER"
^DIC(9.4,49,22,10,"PAH",153,1,79,0)="   bulletin.  However, to avoid the problem altogether, this patch will"
^DIC(9.4,49,22,10,"PAH",153,1,80,0)="   set the SUPRESS BULLETIN field of the S.IBCE MESSAGES SERVER option"
^DIC(9.4,49,22,10,"PAH",153,1,81,0)="   to YES.  The bulletin only announces that there has been server"
^DIC(9.4,49,22,10,"PAH",153,1,82,0)="   activity. It is not necessary for actual distribution of the incoming"
^DIC(9.4,49,22,10,"PAH",153,1,83,0)="   reports so suppressing the bulletin will have no detrimental effect."
^DIC(9.4,49,22,10,"PAH",153,1,84,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,85,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,86,0)=" 4. BRX-0403-12417     BULL1+4^IBTUBUL:1, %DSM-E-UNDEF, undefined variable"
^DIC(9.4,49,22,10,"PAH",153,1,87,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,88,0)="   Problem:"
^DIC(9.4,49,22,10,"PAH",153,1,89,0)="   --------"
^DIC(9.4,49,22,10,"PAH",153,1,90,0)="   When running the option IBT SEND TEST UNBILLED MESS, a software error"
^DIC(9.4,49,22,10,"PAH",153,1,91,0)="   is logged because the TESTV subroutine fails to initialize the "
^DIC(9.4,49,22,10,"PAH",153,1,92,0)="   IBUNB(""EPISM-A"") variable.  This problem only occurs for the TEST"
^DIC(9.4,49,22,10,"PAH",153,1,93,0)="   messages and not for the real messages."
^DIC(9.4,49,22,10,"PAH",153,1,94,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,95,0)="   Resolution:"
^DIC(9.4,49,22,10,"PAH",153,1,96,0)="   -----------"
^DIC(9.4,49,22,10,"PAH",153,1,97,0)="   The missing variable is initialized so that the TEST message"
^DIC(9.4,49,22,10,"PAH",153,1,98,0)="   function can be utilized."
^DIC(9.4,49,22,10,"PAH",153,1,99,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,100,0)="TECHNICAL:"
^DIC(9.4,49,22,10,"PAH",153,1,101,0)="=========="
^DIC(9.4,49,22,10,"PAH",153,1,102,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,103,0)="1.  SHE-0801-51284     Cat C reminder letters printing"
^DIC(9.4,49,22,10,"PAH",153,1,104,0)="    Changes are made to routines: IBARXEL, IBARXEL1"
^DIC(9.4,49,22,10,"PAH",153,1,105,0)="    The function $$BIL^DGMTUB(X,Y) is called and the veteran is"
^DIC(9.4,49,22,10,"PAH",153,1,106,0)="    either sent a letter or not sent a letter based on the result."
^DIC(9.4,49,22,10,"PAH",153,1,107,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,108,0)="2.  COA-0403-21056     <UNDEF> MAIN+2^IBTOSUM2 in MCCR/UR SUMMARY REPORT"
^DIC(9.4,49,22,10,"PAH",153,1,109,0)="    The initialization of the IBCNT array is modified in the RPT section"
^DIC(9.4,49,22,10,"PAH",153,1,110,0)="    of routine IBTOSUM.  The code S IBCNT(3,0)=0 is added."
^DIC(9.4,49,22,10,"PAH",153,1,111,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,112,0)="3.  SBY-0403-30897     Claims Waiting Austin Acknowledgement"
^DIC(9.4,49,22,10,"PAH",153,1,113,0)="    The SUPRESS BULLETIN field (#224) of the OPTION file (#19) for"
^DIC(9.4,49,22,10,"PAH",153,1,114,0)="    option IBCE MESSAGES SERVER is set to the value Y."
^DIC(9.4,49,22,10,"PAH",153,1,115,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,116,0)="4.  BRX-0403-12417     BULL1+4^IBTUBUL:1, %DSM-E-UNDEF, undefined variable"
^DIC(9.4,49,22,10,"PAH",153,1,117,0)="    The TESTV subroutine of IBTUBUL is modified to contain the line:"
^DIC(9.4,49,22,10,"PAH",153,1,118,0)="    S IBUNB(""EPISM-A"")=11111.     "
^DIC(9.4,49,22,10,"PAH",153,1,119,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,120,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,121,0)="PARTICIPATING TEST SITES:"
^DIC(9.4,49,22,10,"PAH",153,1,122,0)="========================="
^DIC(9.4,49,22,10,"PAH",153,1,123,0)="TBD"
^DIC(9.4,49,22,10,"PAH",153,1,124,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,125,0)="ROUTINE SUMMARY "
^DIC(9.4,49,22,10,"PAH",153,1,126,0)="==============="
^DIC(9.4,49,22,10,"PAH",153,1,127,0)="The following is a list of the routines included in this patch.  "
^DIC(9.4,49,22,10,"PAH",153,1,128,0)="The second line of each of these routines now looks like: "
^DIC(9.4,49,22,10,"PAH",153,1,129,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,130,0)="  <tab>;;2.0;INTEGRATED BILLING;**[PATCH LIST]**;21-MAR-94"
^DIC(9.4,49,22,10,"PAH",153,1,131,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,132,0)="                       CHECK^XTSUMBLD results"
^DIC(9.4,49,22,10,"PAH",153,1,133,0)="Routine name      Before Patch        After Patch       Patch List"
^DIC(9.4,49,22,10,"PAH",153,1,134,0)="============      ============        ===========       ==========="
^DIC(9.4,49,22,10,"PAH",153,1,135,0)="IB20P217                   N/A            1138089       217"
^DIC(9.4,49,22,10,"PAH",153,1,136,0)="IBARXEL                5496758            5804553       34,139,206,217"
^DIC(9.4,49,22,10,"PAH",153,1,137,0)="IBARXEL1               7127873            7529363       34,199,217"
^DIC(9.4,49,22,10,"PAH",153,1,138,0)="IBTOSUM                8582961            8533948       118,133,217"
^DIC(9.4,49,22,10,"PAH",153,1,139,0)="IBTUBUL                6667983            6686239       19,123,159,217"
^DIC(9.4,49,22,10,"PAH",153,1,140,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,141,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,142,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,49,22,10,"PAH",153,1,143,0)="========================="
^DIC(9.4,49,22,10,"PAH",153,1,144,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,145,0)=" This patch can be installed at any time, however, the IB MT NIGHT COMP"
^DIC(9.4,49,22,10,"PAH",153,1,146,0)=" job should not be running."
^DIC(9.4,49,22,10,"PAH",153,1,147,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,148,0)=" If installed during the normal workday it is recommended that the"
^DIC(9.4,49,22,10,"PAH",153,1,149,0)=" following menu options (File #19) be disabled to prevent possible"
^DIC(9.4,49,22,10,"PAH",153,1,150,0)=" conflicts while running the KIDS Install. Other VISTA users will not"
^DIC(9.4,49,22,10,"PAH",153,1,151,0)=" be affected."
^DIC(9.4,49,22,10,"PAH",153,1,152,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,153,0)="    Reprint Single Income Test Reminder Letter [IB RX REPRINT REMINDER]"
^DIC(9.4,49,22,10,"PAH",153,1,154,0)="    MCCR/UR Summary Report [IBT OUTPUT MCCR/UR SUMMARY]"
^DIC(9.4,49,22,10,"PAH",153,1,155,0)="    Send Test Unbilled Amounts Bulletin [IBT SEND TEST UNBILLED MESS]"
^DIC(9.4,49,22,10,"PAH",153,1,156,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,157,0)=" Install time - less than 2 minutes."
^DIC(9.4,49,22,10,"PAH",153,1,158,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,159,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,160,0)=" 1.  LOAD TRANSPORT GLOBAL "
^DIC(9.4,49,22,10,"PAH",153,1,161,0)="     ---------------------"
^DIC(9.4,49,22,10,"PAH",153,1,162,0)="     Choose the PackMan message containing this patch and invoke the "
^DIC(9.4,49,22,10,"PAH",153,1,163,0)="     INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,49,22,10,"PAH",153,1,164,0)="                               "
^DIC(9.4,49,22,10,"PAH",153,1,165,0)=" 2.  DISABLE ROUTINE MAPPING   (DSM for open VMS sites only)"
^DIC(9.4,49,22,10,"PAH",153,1,166,0)="     -----------------------"
^DIC(9.4,49,22,10,"PAH",153,1,167,0)="     Disable routine mapping on all systems for the routines listed in"
^DIC(9.4,49,22,10,"PAH",153,1,168,0)="     the routine summary"
^DIC(9.4,49,22,10,"PAH",153,1,169,0)="     NOTE:  If the routines included in this patch are not currently in"
^DIC(9.4,49,22,10,"PAH",153,1,170,0)="     your mapped routine set, please skip this step."
^DIC(9.4,49,22,10,"PAH",153,1,171,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,172,0)=" 3.  START UP KIDS "
^DIC(9.4,49,22,10,"PAH",153,1,173,0)="     -------------"
^DIC(9.4,49,22,10,"PAH",153,1,174,0)="     Start up the Kernel Installation and Distribution System Menu "
^DIC(9.4,49,22,10,"PAH",153,1,175,0)="     [XPD MAIN]: "
^DIC(9.4,49,22,10,"PAH",153,1,176,0)="                         "
^DIC(9.4,49,22,10,"PAH",153,1,177,0)="           Edits and Distribution ...  "
^DIC(9.4,49,22,10,"PAH",153,1,178,0)="           Utilities ..."
^DIC(9.4,49,22,10,"PAH",153,1,179,0)="           Installation ...  "
^DIC(9.4,49,22,10,"PAH",153,1,180,0)="                                   "
^DIC(9.4,49,22,10,"PAH",153,1,181,0)="     Select Kernel Installation & Distribution System Option: INStallation"
^DIC(9.4,49,22,10,"PAH",153,1,182,0)="                                                              ---"
^DIC(9.4,49,22,10,"PAH",153,1,183,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,184,0)="     1      Load a Distribution"
^DIC(9.4,49,22,10,"PAH",153,1,185,0)="     2      Verify Checksums in Transport Global"
^DIC(9.4,49,22,10,"PAH",153,1,186,0)="     3      Print Transport Global"
^DIC(9.4,49,22,10,"PAH",153,1,187,0)="     4      Compare Transport Global to Current System"
^DIC(9.4,49,22,10,"PAH",153,1,188,0)="     5      Backup a Transport Global"
^DIC(9.4,49,22,10,"PAH",153,1,189,0)="     6      Install Package(s)"
^DIC(9.4,49,22,10,"PAH",153,1,190,0)="            Restart Install of Package(s)"
^DIC(9.4,49,22,10,"PAH",153,1,191,0)="            Unload a Distribution"
^DIC(9.4,49,22,10,"PAH",153,1,192,0)="     "
^DIC(9.4,49,22,10,"PAH",153,1,193,0)=" 4.  From this menu, you may elect to use the following options"
^DIC(9.4,49,22,10,"PAH",153,1,194,0)="     (When prompted for the INSTALL NAME, enter IB*2.0*217):"
^DIC(9.4,49,22,10,"PAH",153,1,195,0)="     "
^DIC(9.4,49,22,10,"PAH",153,1,196,0)="     a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,49,22,10,"PAH",153,1,197,0)="         message of any routines exported with this patch. It will"
^DIC(9.4,49,22,10,"PAH",153,1,198,0)="         not backup any other changes such as DD's or templates."
^DIC(9.4,49,22,10,"PAH",153,1,199,0)="     b.  Compare Transport Global to Current System - This option"
^DIC(9.4,49,22,10,"PAH",153,1,200,0)="         will allow you to view all changes that will be made when"
^DIC(9.4,49,22,10,"PAH",153,1,201,0)="         this patch is installed.  It compares all components of this"
^DIC(9.4,49,22,10,"PAH",153,1,202,0)="         patch (routines, DD's, templates, etc.)."
^DIC(9.4,49,22,10,"PAH",153,1,203,0)="     c.  Verify Checksums in Transport Global - This option will"
^DIC(9.4,49,22,10,"PAH",153,1,204,0)="         allow you to ensure the integrity of the routines that are"
^DIC(9.4,49,22,10,"PAH",153,1,205,0)="         in the transport global."
^DIC(9.4,49,22,10,"PAH",153,1,206,0)="                   "
^DIC(9.4,49,22,10,"PAH",153,1,207,0)=" 5.  Use the Install Package(s) option and select the package IB*2.0*217."
^DIC(9.4,49,22,10,"PAH",153,1,208,0)=" "
^DIC(9.4,49,22,10,"PAH",153,1,209,0)="     a.  When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,49,22,10,"PAH",153,1,210,0)="         install? YES//', answer NO."
^DIC(9.4,49,22,10,"PAH",153,1,211,0)="     b.  When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,49,22,10,"PAH",153,1,212,0)="         Options, and Protocols? YES//' answer YES."
^DIC(9.4,49,22,10,"PAH",153,1,213,0)="     c.  When prompted 'Enter options you wish to mark as 'Out of"
^DIC(9.4,49,22,10,"PAH",153,1,214,0)="         Order':' Enter the following:       "
^DIC(9.4,49,22,10,"PAH",153,1,215,0)="           IB RX REPRINT REMINDER"
^DIC(9.4,49,22,10,"PAH",153,1,216,0)="           IBT OUTPUT MCCR/UR SUMMARY"
^DIC(9.4,49,22,10,"PAH",153,1,217,0)="           IBT SEND TEST UNBILLED MESS"
^DIC(9.4,49,22,10,"PAH",153,1,218,0)="            "
^DIC(9.4,49,22,10,"PAH",153,1,219,0)="     d.  When prompted 'Enter protocols you wish to mark as 'Out of"
^DIC(9.4,49,22,10,"PAH",153,1,220,0)="         Order': Enter the following: (press return) "
^DIC(9.4,49,22,10,"PAH",153,1,221,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,222,0)=" 7.  REBUILD MAPPED ROUTINES(S)  (DSM for Open VMS sites only)"
^DIC(9.4,49,22,10,"PAH",153,1,223,0)="     --------------------------"
^DIC(9.4,49,22,10,"PAH",153,1,224,0)="     Optional - Include the routines distributed with this patch in the"
^DIC(9.4,49,22,10,"PAH",153,1,225,0)="     mapped routine set."
^DIC(9.4,49,22,10,"PAH",153,1,226,0)="                    "
^DIC(9.4,49,22,10,"PAH",153,1,227,0)="     NOTE: This step is only necessary if you performed step 2 or if you "
^DIC(9.4,49,22,10,"PAH",153,1,228,0)="     wish to include the routines in your mapped set."
^DIC(9.4,49,22,10,"PAH",153,1,229,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,230,0)=" 8.  DELETE PRE-INIT ROUTINE"
^DIC(9.4,49,22,10,"PAH",153,1,231,0)="     ------------------------"
^DIC(9.4,49,22,10,"PAH",153,1,232,0)="     You may delete the IB20P217 routine from your system after successful"
^DIC(9.4,49,22,10,"PAH",153,1,233,0)="     installation of this patch."
^DIC(9.4,49,22,10,"PAH",153,1,234,0)="  "
^DIC(9.4,49,22,10,"PAH",153,1,235,0)="INSTALLATION EXAMPLE:"
^DIC(9.4,49,22,10,"PAH",153,1,236,0)="---------------------"
^DIC(9.4,49,22,10,"PAH",154,0)="230 SEQ #221^3031231^1"
^DIC(9.4,49,22,10,"PAH",154,1,0)="^^4^4^3031231"
^DIC(9.4,49,22,10,"PAH",154,1,1,0)="This patch changes the value in the print preview screen, BILL TOTAL "
^DIC(9.4,49,22,10,"PAH",154,1,2,0)="field and the TOTAL CHARGE field in the printed form. The value is "
^DIC(9.4,49,22,10,"PAH",154,1,3,0)="changed from the amount due to the total charges not including any "
^DIC(9.4,49,22,10,"PAH",154,1,4,0)="offset.   "
^DIC(9.4,49,22,10,"PAH",155,0)="256 SEQ #222^3031231^1"
^DIC(9.4,49,22,10,"PAH",155,1,0)="^^1^1^3031231"
^DIC(9.4,49,22,10,"PAH",155,1,1,0)="IB*2.0*256 IB INSURANCE API TEST VERSION 6"
^DIC(9.4,49,22,10,"PAH",156,0)="253 SEQ #223^3040131^1"
^DIC(9.4,49,22,10,"PAH",156,1,0)="^^2^2^3040131"
^DIC(9.4,49,22,10,"PAH",156,1,1,0)="This patch does an automatic update of the CY 2004 Medicare Deductible"
^DIC(9.4,49,22,10,"PAH",156,1,2,0)="and the Pension Copay Threshold amounts."
^DIC(9.4,49,22,10,"PAH",157,0)="255 SEQ #224^3040131^1"
^DIC(9.4,49,22,10,"PAH",157,1,0)="^^3^3^3040131"
^DIC(9.4,49,22,10,"PAH",157,1,1,0)="FIX RX COPAY EXEMPTION FOR IVM - The upload of an IVM Converted Means "
^DIC(9.4,49,22,10,"PAH",157,1,2,0)="Test (ORU~Z06) will be modified to no longer re-calculate the COPAY "
^DIC(9.4,49,22,10,"PAH",157,1,3,0)="INCOME EXEMPTION STATUS (#.04) field in the BILLING PATIENT (#354) File."
^DIC(9.4,49,22,10,"PAH",158,0)="215 SEQ #225^3040131^1"
^DIC(9.4,49,22,10,"PAH",158,1,0)="^^1^1^3040131"
^DIC(9.4,49,22,10,"PAH",158,1,1,0)="OIG/IVM 60-DAY BILL DROP"
^DIC(9.4,49,22,10,"PAH",159,0)="216 SEQ #226^3040302^1"
^DIC(9.4,49,22,10,"PAH",159,1,0)="^^1^1^3040302"
^DIC(9.4,49,22,10,"PAH",159,1,1,0)="FIX FOR AUG-0103-31330, ADMIT/DISCHARGE HOUR FOR OUTPATIENT BILLS"
^DIC(9.4,49,22,10,"PAH",160,0)="237 SEQ #227^3040302^1"
^DIC(9.4,49,22,10,"PAH",160,1,0)="^^2^2^3040302"
^DIC(9.4,49,22,10,"PAH",160,1,1,0)="This patch adds patient information to an INTEGRATED BILLING BACKGROUND"
^DIC(9.4,49,22,10,"PAH",160,1,2,0)="ERROR message."
^DIC(9.4,49,22,10,"PAH",161,0)="252 SEQ #228^3040302^1"
^DIC(9.4,49,22,10,"PAH",161,1,0)="^^6^6^3040302"
^DIC(9.4,49,22,10,"PAH",161,1,1,0)="This patch addresses the following NOIS message(s):"
^DIC(9.4,49,22,10,"PAH",161,1,2,0)="---------------------------------------------------"
^DIC(9.4,49,22,10,"PAH",161,1,3,0)="POR-0903-52494         BUFFER FILE PROBLEMS"
^DIC(9.4,49,22,10,"PAH",161,1,4,0)="BAY-1003-30706         Critical Message received from IIV"
^DIC(9.4,49,22,10,"PAH",161,1,5,0)="LOU-0903-42302         IIV Payer Link Report /column"
^DIC(9.4,49,22,10,"PAH",161,1,6,0)="UNY-1003-12260         <NULLSUBSCR>VALID+5^IBCNEUT4"
^DIC(9.4,49,22,10,"PAH",162,0)="245 SEQ #229^3040302^1"
^DIC(9.4,49,22,10,"PAH",162,1,0)="^^1^1^3040302"
^DIC(9.4,49,22,10,"PAH",162,1,1,0)="Reasonable Charges version 2.0.  Charge effective date 12/19/03."
^DIC(9.4,49,22,10,"PAH",163,0)="262 SEQ #230^3040302^1"
^DIC(9.4,49,22,10,"PAH",164,0)="175 SEQ #231^3040303^1"
^DIC(9.4,49,22,10,"PAH",164,1,0)="^^1^1^3040303"
^DIC(9.4,49,22,10,"PAH",164,1,1,0)="Add Tortiously Liable and Interagency Rates for January 2004."
^DIC(9.4,49,22,10,"PAH",165,0)="239 SEQ #232^3040330^1"
^DIC(9.4,49,22,10,"PAH",165,1,0)="^^2^2^3040330"
^DIC(9.4,49,22,10,"PAH",165,1,1,0)="Care Units are displaying incorrectly on the Insurance Company Provider"
^DIC(9.4,49,22,10,"PAH",165,1,2,0)="ID Maintenance screen."
^DIC(9.4,49,22,10,"PAH",166,0)="225 SEQ #234^3040330^1"
^DIC(9.4,49,22,10,"PAH",166,1,0)="^^3^3^3040330"
^DIC(9.4,49,22,10,"PAH",166,1,1,0)="This patch implements the following change to the Integrated Billing"
^DIC(9.4,49,22,10,"PAH",166,1,2,0)="package:  Plan comments will now carry over when subscribers are moved"
^DIC(9.4,49,22,10,"PAH",166,1,3,0)="from one insurance plan to another."
^DIC(9.4,49,22,10,"PAH",167,0)="228 SEQ #233^3040330^1"
^DIC(9.4,49,22,10,"PAH",167,1,0)="^^1^1^3040330"
^DIC(9.4,49,22,10,"PAH",167,1,1,0)="ENHANCEMENT FOR BILLING AWARENESS PTF"
^DIC(9.4,49,22,10,"PAH",168,0)="261 SEQ #235^3040427^1"
^DIC(9.4,49,22,10,"PAH",168,1,0)="^^5^5^3040427"
^DIC(9.4,49,22,10,"PAH",168,1,1,0)="This patch resolves the problem reported in LEB-0104-20959"
^DIC(9.4,49,22,10,"PAH",168,1,2,0)="Incorrect total in PATIENT PHARMACY COPAY CAP REPORT."
^DIC(9.4,49,22,10,"PAH",168,1,3,0)="The improper formatting of numbers larger than 999.99 was"
^DIC(9.4,49,22,10,"PAH",168,1,4,0)="causing inaccurate data to be displayed to the user."
^DIC(9.4,49,22,10,"PAH",168,1,5,0)="The code is modified to format and display correctly now."
^DIC(9.4,49,22,10,"PAH",169,0)="265 SEQ #236^3040427^1"
^DIC(9.4,49,22,10,"PAH",169,1,0)="^^2^2^3040427"
^DIC(9.4,49,22,10,"PAH",169,1,1,0)="This build contains changes to add and populate fields in the EXPLANATION"
^DIC(9.4,49,22,10,"PAH",169,1,2,0)="OF BENEFITS file (#361.1) needed for e-payments Phase II processing."
^DIC(9.4,49,22,10,"PAH",170,0)="270 SEQ #237^3040521^1"
^DIC(9.4,49,22,10,"PAH",170,1,0)="^^1^1^3040521"
^DIC(9.4,49,22,10,"PAH",170,1,1,0)="Reasonable Charges v2.1"
^DIC(9.4,49,22,10,"PAH",171,0)="259 SEQ #238^3040521^1"
^DIC(9.4,49,22,10,"PAH",171,1,0)="^^2^2^3040521"
^DIC(9.4,49,22,10,"PAH",171,1,1,0)="This KIDS Build will transport patch IB*2.0*259, The Pharmacy Co-pay Cap "
^DIC(9.4,49,22,10,"PAH",171,1,2,0)="Summary Report, to the field."
^DIC(9.4,49,22,10,"PAH",172,0)="250 SEQ #239^3040702^1"
^DIC(9.4,49,22,10,"PAH",172,1,0)="^^5^5^3040702"
^DIC(9.4,49,22,10,"PAH",172,1,1,0)="This patch addresses two issues: the Hospital Reviews [IBT EDIT REVIEWS] "
^DIC(9.4,49,22,10,"PAH",172,1,2,0)="option has been modified so that the ward is displayed even if the "
^DIC(9.4,49,22,10,"PAH",172,1,3,0)="patient is admitted and discharged on the same day, and the Queue Means"
^DIC(9.4,49,22,10,"PAH",172,1,4,0)="Test Compilation of Charges [IB MT NIGHT COMP] option has been modified to"
^DIC(9.4,49,22,10,"PAH",172,1,5,0)="respect both date and time."
^DIC(9.4,49,22,10,"PAH",173,0)="263 SEQ #240^3040702^1"
^DIC(9.4,49,22,10,"PAH",173,1,0)="^^8^8^3040702"
^DIC(9.4,49,22,10,"PAH",173,1,1,0)="This patch corrects a problem in the CLAIMS STATUS AWAITING RESOLUTION"
^DIC(9.4,49,22,10,"PAH",173,1,2,0)="option where a <NULSUBSCR> error ocurred when trying to view an EOB"
^DIC(9.4,49,22,10,"PAH",173,1,3,0)="and none existed."
^DIC(9.4,49,22,10,"PAH",173,1,4,0)="See NOIS SBY-0104-30665."
^DIC(9.4,49,22,10,"PAH",173,1,5,0)="This patch also corrects a second issue where active insurance"
^DIC(9.4,49,22,10,"PAH",173,1,6,0)="company names were not listed when entering data into the"
^DIC(9.4,49,22,10,"PAH",173,1,7,0)="insurance buffer."
^DIC(9.4,49,22,10,"PAH",173,1,8,0)="See NOIS MIN-0104-41017"
^DIC(9.4,49,22,10,"PAH",174,0)="247 SEQ #241^3040702^1"
^DIC(9.4,49,22,10,"PAH",174,1,0)="^^1^1^3040702"
^DIC(9.4,49,22,10,"PAH",174,1,1,0)="COMBAT VETERAN PHASE II"
^DIC(9.4,49,22,10,"PAH",175,0)="257 SEQ #242^3040702^1"
^DIC(9.4,49,22,10,"PAH",175,1,0)="^^9^9^3040702"
^DIC(9.4,49,22,10,"PAH",175,1,1,0)="The Type of Visit file (357.69) holds a list of E&M codes (a subset of "
^DIC(9.4,49,22,10,"PAH",175,1,2,0)="CPT codes). Generally a quantity of 1 is all that is allowed for these "
^DIC(9.4,49,22,10,"PAH",175,1,3,0)="codes. There are cases, however, when this quantity should not be limited "
^DIC(9.4,49,22,10,"PAH",175,1,4,0)="to one. Therefore, there needs to be a field that will serve as a flag. "
^DIC(9.4,49,22,10,"PAH",175,1,5,0)="The field being added is the .06 field. It will have a value of 0 if the "
^DIC(9.4,49,22,10,"PAH",175,1,6,0)="quantity is to be restricted to one and a value of 1 if it allows a "
^DIC(9.4,49,22,10,"PAH",175,1,7,0)="quantity of greater than one. Using the flag this way means that current "
^DIC(9.4,49,22,10,"PAH",175,1,8,0)="entries that do not have a value for this flag will default to allowing a "
^DIC(9.4,49,22,10,"PAH",175,1,9,0)="quantity of only 1."
^DIC(9.4,49,22,10,"PAH",176,0)="243 SEQ #243^3040802^1"
^DIC(9.4,49,22,10,"PAH",176,1,0)="^^10^10^3040802"
^DIC(9.4,49,22,10,"PAH",176,1,1,0)="Patch IB*2.0*243 fixes 3 items."
^DIC(9.4,49,22,10,"PAH",176,1,2,0)="(1) Two separate fields in the BILL/CLAIMS file (#399), #204 and #450,"
^DIC(9.4,49,22,10,"PAH",176,1,3,0)="are both named FORM LOCATOR 2.  The fields are renamed and two input"
^DIC(9.4,49,22,10,"PAH",176,1,4,0)="templates (IB SCREEN8, IB SCREEN82) are recompiled."
^DIC(9.4,49,22,10,"PAH",176,1,5,0)="(2) If a user selects a bill to cancel but changes their mind and enters"
^DIC(9.4,49,22,10,"PAH",176,1,6,0)="""no"" at the end, a message displays ""<NO ACTION TAKEN>"" but the ""DATE"
^DIC(9.4,49,22,10,"PAH",176,1,7,0)="BILL CANCELLED"" and ""BILL CANCELLED BY"" fields are populated anyway."
^DIC(9.4,49,22,10,"PAH",176,1,8,0)="(3) A user noted that the Integrated Billing Technical Manual did not"
^DIC(9.4,49,22,10,"PAH",176,1,9,0)="include the IBAM and IBAT globals in the journalling instructions."
^DIC(9.4,49,22,10,"PAH",176,1,10,0)="This patch announces a correction to the manual."
^DIC(9.4,49,22,10,"PAH",177,0)="244 SEQ #244^3040802^1"
^DIC(9.4,49,22,10,"PAH",177,1,0)="^^3^3^3040802"
^DIC(9.4,49,22,10,"PAH",177,1,1,0)="This patch corrects a situation which allows the IB DM EXTRACT DATE file"
^DIC(9.4,49,22,10,"PAH",177,1,2,0)="to become corrupted.  It also corrects a situation where the Subscriber ID"
^DIC(9.4,49,22,10,"PAH",177,1,3,0)="is saved with hyphens still embedded in the number."
^DIC(9.4,49,22,10,"PAH",178,0)="241 SEQ #245^3040802^1"
^DIC(9.4,49,22,10,"PAH",178,1,0)="^^10^10^3040802"
^DIC(9.4,49,22,10,"PAH",178,1,1,0)=" Error handling code was added to the IB CANCEL BILL process to "
^DIC(9.4,49,22,10,"PAH",178,1,2,0)=" recognize the error indicator being passed back by AR and to display "
^DIC(9.4,49,22,10,"PAH",178,1,3,0)=" the following warning message: ""Please note: PRCA was unable to determine"
^DIC(9.4,49,22,10,"PAH",178,1,4,0)=" if a payment has been posted"""
^DIC(9.4,49,22,10,"PAH",178,1,5,0)=" "
^DIC(9.4,49,22,10,"PAH",178,1,6,0)="A new RATE TYPE of INELIGIBLE is added to the RATE TYPE file "
^DIC(9.4,49,22,10,"PAH",178,1,7,0)="(#399.3) pointing to the ACCOUNTS RECEIVABLE CATEGORY: INELIGIBLE HOSP."
^DIC(9.4,49,22,10,"PAH",178,1,8,0)="New Rate Schedules of INELIG-OPT and INELIG-INPT are added to file"
^DIC(9.4,49,22,10,"PAH",178,1,9,0)="#363 - RATE SCHEDULE."
^DIC(9.4,49,22,10,"PAH",178,1,10,0)=" These will be added with the post init routine IBYP241."
^DIC(9.4,49,22,10,"PAH",179,0)="269^3040802^1"
^DIC(9.4,49,22,10,"PAH",179,1,0)="^^2^2^3040802"
^DIC(9.4,49,22,10,"PAH",179,1,1,0)="Add ability to process IVM close case/converted Pharmacy Exemption tests "
^DIC(9.4,49,22,10,"PAH",179,1,2,0)="via Z06 transmissions from the EDB."
^DIC(9.4,49,22,10,"PAH",180,0)="272 SEQ #247^3040903^1"
^DIC(9.4,49,22,10,"PAH",181,0)="240 SEQ #248^3040903^1"
^DIC(9.4,49,22,10,"PAH",181,1,0)="^^2^2^3040903"
^DIC(9.4,49,22,10,"PAH",181,1,1,0)="Remove references to CHAMPUS."
^DIC(9.4,49,22,10,"PAH",181,1,2,0)="Fix <UNDEFINED>YR+6^IBAECU by correcting code in IBECEA3."
^DIC(9.4,49,22,10,"PAH",182,0)="222 SEQ #249^3040903^1"
^DIC(9.4,49,22,10,"PAH",182,1,0)="^^1^1^3040903"
^DIC(9.4,49,22,10,"PAH",182,1,1,0)="MEANS TEST DATE PROBLEM"
^DIC(9.4,49,22,10,"PAH",183,0)="233 SEQ #250^3040903^1"
^DIC(9.4,49,22,10,"PAH",183,1,0)="^^2^2^3040903"
^DIC(9.4,49,22,10,"PAH",183,1,1,0)="This patch will implement CBOC data extraction logic for"
^DIC(9.4,49,22,10,"PAH",183,1,2,0)="the Boston Allocation Resource Center."
^DIC(9.4,49,22,10,"PAH",184,0)="274 SEQ #251^3040917^1"
^DIC(9.4,49,22,10,"PAH",184,1,0)="^^2^2^3040917"
^DIC(9.4,49,22,10,"PAH",184,1,1,0)="This patch will use the NEW command to limit the scope of the"
^DIC(9.4,49,22,10,"PAH",184,1,2,0)="DIQUIET variable."
^DIC(9.4,49,22,10,"PAH",185,0)="273 SEQ #252^3040917^1"
^DIC(9.4,49,22,10,"PAH",185,1,0)="^^4^4^3040917"
^DIC(9.4,49,22,10,"PAH",185,1,1,0)="Several Trigger type cross references throughout IB files have"
^DIC(9.4,49,22,10,"PAH",185,1,2,0)="an old Mumps function $Next.  This is an outdated form and needs"
^DIC(9.4,49,22,10,"PAH",185,1,3,0)="to be revised.  By recompiling the trigger code with FileMan v22"
^DIC(9.4,49,22,10,"PAH",185,1,4,0)="the old code will be replaced with current standards."
^DIC(9.4,49,22,10,"PAH",186,0)="268 SEQ #253^3040917^1"
^DIC(9.4,49,22,10,"PAH",186,1,0)="^^2^2^3040917"
^DIC(9.4,49,22,10,"PAH",186,1,1,0)="This patch will add one new entry to file 361.2."
^DIC(9.4,49,22,10,"PAH",186,1,2,0)="The entry is: R0S0 - PRF GVT WEBMD/PAYER INFO/EDIT"
^DIC(9.4,49,22,10,"PAH",187,0)="282 SEQ #254^3041015^1"
^DIC(9.4,49,22,10,"PAH",187,1,0)="^^1^1^3041015"
^DIC(9.4,49,22,10,"PAH",187,1,1,0)="Contains the EDI Enhancements (HIPAA) provider ID worksheet."
^DIC(9.4,49,22,10,"PAH",188,0)="284 SEQ #255^3041015^1"
^DIC(9.4,49,22,10,"PAH",188,1,0)="^^3^3^3041015"
^DIC(9.4,49,22,10,"PAH",188,1,1,0)="This patch modifies the 'Sender' name used by the IIV STATISTICAL REPORT"
^DIC(9.4,49,22,10,"PAH",188,1,2,0)="when mailing the report to the IBCNE IIV MESSAGE mail group."
^DIC(9.4,49,22,10,"PAH",188,1,3,0)="The name is changed from ""IB IIV INTERFACE"" to ""IIV INTERFACE (IB)""."
^DIC(9.4,49,22,10,"PAH",189,0)="232 SEQ #256^3041015^1"
^DIC(9.4,49,22,10,"PAH",189,1,0)="^^1^1^3041015"
^DIC(9.4,49,22,10,"PAH",189,1,1,0)="EDI/ENHANCEMENTS HIPAA COMPLIANCE"
^DIC(9.4,49,22,10,"PAH",190,0)="280 SEQ #257^3041015^1"
^DIC(9.4,49,22,10,"PAH",190,1,0)="^^2^2^3041015"
^DIC(9.4,49,22,10,"PAH",190,1,1,0)="Follow up patch for problems found late in testing patch IB*2.0*232"
^DIC(9.4,49,22,10,"PAH",190,1,2,0)="for EDI Enhancements."
^DIC(9.4,49,22,10,"PAH",191,0)="266^3041015^1"
^DIC(9.4,49,22,10,"PAH",191,1,0)="^^1^1^3041015"
^DIC(9.4,49,22,10,"PAH",191,1,1,0)="CODE TEXT DESCRIPTORS"
^DIC(9.4,49,22,10,"PAH",192,0)="283 SEQ #259^3041029^1"
^DIC(9.4,49,22,10,"PAH",192,1,0)="^^2^2^3041029"
^DIC(9.4,49,22,10,"PAH",192,1,1,0)="CSA screen performance enhancements and improve message handling of "
^DIC(9.4,49,22,10,"PAH",192,1,2,0)="entries in file 361 - IB BILL STATUS MESSAGE."
^DIC(9.4,49,22,10,"PAH",193,0)="223^3041029^1"
^DIC(9.4,49,22,10,"PAH",193,1,0)="^^309^309^3041029"
^DIC(9.4,49,22,10,"PAH",193,1,1,0)="PATCH OVERVIEW"
^DIC(9.4,49,22,10,"PAH",193,1,2,0)="---------------"
^DIC(9.4,49,22,10,"PAH",193,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,4,0)="The Healthcare Insurance Portability and Accountability Act National "
^DIC(9.4,49,22,10,"PAH",193,1,5,0)="Council for Prescription Drug Programs (HIPAA NCPDP) initiative, whose "
^DIC(9.4,49,22,10,"PAH",193,1,6,0)="ultimate goal is to provide functionality allowing electronic "
^DIC(9.4,49,22,10,"PAH",193,1,7,0)="transmission of Outpatient Pharmacy (OP) prescription claims to payers "
^DIC(9.4,49,22,10,"PAH",193,1,8,0)="and the receipt of claim responses (including drug utilization review "
^DIC(9.4,49,22,10,"PAH",193,1,9,0)="responses and warnings) on a real-time basis, is being developed and "
^DIC(9.4,49,22,10,"PAH",193,1,10,0)="introduced in a phased implementation strategy. This deployment strategy "
^DIC(9.4,49,22,10,"PAH",193,1,11,0)="was utilized due to the complexity of the functionality and the number of "
^DIC(9.4,49,22,10,"PAH",193,1,12,0)="product line dependencies."
^DIC(9.4,49,22,10,"PAH",193,1,13,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,14,0)="The first release of this two part implementation is BPS*1*0, comprised "
^DIC(9.4,49,22,10,"PAH",193,1,15,0)="of the new Electronic Claims Management Engine (ECME) package (in the BPS "
^DIC(9.4,49,22,10,"PAH",193,1,16,0)="namespace), plus the patches PSS*1*81, IB*2.0*223, IB*2.0*251, and "
^DIC(9.4,49,22,10,"PAH",193,1,17,0)="PRCA*4.5*202, which are listed here in order of installation. BPS*1*0 is "
^DIC(9.4,49,22,10,"PAH",193,1,18,0)="a dormant release that only allows each site to perform preliminary setup "
^DIC(9.4,49,22,10,"PAH",193,1,19,0)="work and to confirm that the software does not adversely affect other "
^DIC(9.4,49,22,10,"PAH",193,1,20,0)="packages."
^DIC(9.4,49,22,10,"PAH",193,1,21,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,22,0)="There are two main areas addressed by BPS*1*0:"
^DIC(9.4,49,22,10,"PAH",193,1,23,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,24,0)="a. Registration of the Pharmacy with the Vitria BusinessWare IE."
^DIC(9.4,49,22,10,"PAH",193,1,25,0)="b. The Insurance Matching of Group Plans with Pharmacy Plans"
^DIC(9.4,49,22,10,"PAH",193,1,26,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,27,0)="Following the installation of BPS*1*0, each site must register their "
^DIC(9.4,49,22,10,"PAH",193,1,28,0)="pharmacy with Vitria and match applicable insurance group plans using the "
^DIC(9.4,49,22,10,"PAH",193,1,29,0)="insurance matching screens. These processes are detailed in the HIPAA "
^DIC(9.4,49,22,10,"PAH",193,1,30,0)="NCPDP CONNECTION FOR EDI PHARMACY INSTALLATION GUIDE and the MATCH GROUP "
^DIC(9.4,49,22,10,"PAH",193,1,31,0)="PLANS WITH PHARMACY PLANS document. Both of these documents are located "
^DIC(9.4,49,22,10,"PAH",193,1,32,0)="on the anonymous directory. It is very important that the IRM or person "
^DIC(9.4,49,22,10,"PAH",193,1,33,0)="installing the patch at each facility provide a copy of these documents "
^DIC(9.4,49,22,10,"PAH",193,1,34,0)="to its ADPAC(s) and any other relevant staff who will be responsible for "
^DIC(9.4,49,22,10,"PAH",193,1,35,0)="registering their pharmacy with Vitria and completing the insurance "
^DIC(9.4,49,22,10,"PAH",193,1,36,0)="matching process."
^DIC(9.4,49,22,10,"PAH",193,1,37,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,38,0)="At a later date, additional HIPAA NCPDP patches will be released to "
^DIC(9.4,49,22,10,"PAH",193,1,39,0)="activate all of the HIPAA NCPDP functionality. Until that time, sites "
^DIC(9.4,49,22,10,"PAH",193,1,40,0)="will not be able to electronically submit claims utilizing this new "
^DIC(9.4,49,22,10,"PAH",193,1,41,0)="functionality."
^DIC(9.4,49,22,10,"PAH",193,1,42,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,43,0)="The HIPAA NCPDP project was created in response to a Chief Business "
^DIC(9.4,49,22,10,"PAH",193,1,44,0)="Office (CBO) request for modifications to several Veterans Health "
^DIC(9.4,49,22,10,"PAH",193,1,45,0)="Information Systems and Technology Architecture (VistA) software "
^DIC(9.4,49,22,10,"PAH",193,1,46,0)="applications in accordance with HIPAA Electronic Data Interchange (EDI) "
^DIC(9.4,49,22,10,"PAH",193,1,47,0)="transactions and NCPDP mandated format standards, specifically the NCPDP "
^DIC(9.4,49,22,10,"PAH",193,1,48,0)="Telecommunication Standard v.5.1."
^DIC(9.4,49,22,10,"PAH",193,1,49,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,50,0)="The specific functionality for this patch is listed below."
^DIC(9.4,49,22,10,"PAH",193,1,51,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,52,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,53,0)="Functional Description"
^DIC(9.4,49,22,10,"PAH",193,1,54,0)="----------------------"
^DIC(9.4,49,22,10,"PAH",193,1,55,0)="This patch adds the necessary enhancements to the Integrated Billing "
^DIC(9.4,49,22,10,"PAH",193,1,56,0)="package to support NCPDP (National Council for Prescription Drug Programs)"
^DIC(9.4,49,22,10,"PAH",193,1,57,0)="billing of pharmacy claims via the Outpatient Pharmacy package."
^DIC(9.4,49,22,10,"PAH",193,1,58,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,59,0)="The features are:"
^DIC(9.4,49,22,10,"PAH",193,1,60,0)="  "
^DIC(9.4,49,22,10,"PAH",193,1,61,0)="1. When a patient is issued medication via Outpatient Pharmacy, "
^DIC(9.4,49,22,10,"PAH",193,1,62,0)="Outpatient Pharmacy will check with Integrated Billing (IB) to determine "
^DIC(9.4,49,22,10,"PAH",193,1,63,0)="if the prescription is NCPDP billable to a third party payer. The patient"
^DIC(9.4,49,22,10,"PAH",193,1,64,0)="must have active, reimbursable insurance that covers prescriptions as"
^DIC(9.4,49,22,10,"PAH",193,1,65,0)="specified in the patient's group policy coverage limitations.  The "
^DIC(9.4,49,22,10,"PAH",193,1,66,0)="prescription must not be for OTC or research medications and must not be "
^DIC(9.4,49,22,10,"PAH",193,1,67,0)="related to SC (Service Connected), AO (Agent Orange), IR (Ionizing"
^DIC(9.4,49,22,10,"PAH",193,1,68,0)="Radiation), EC (Environmental Contaminants), HNC (Head/Neck Cancer), CV"
^DIC(9.4,49,22,10,"PAH",193,1,69,0)="(Combat Veteran), or MST (Military Sexual Trauma)."
^DIC(9.4,49,22,10,"PAH",193,1,70,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,71,0)="2.  A check will be done to see if the site's Claims Tracking module is "
^DIC(9.4,49,22,10,"PAH",193,1,72,0)="turned on for prescriptions.  When it is, the appropriate information "
^DIC(9.4,49,22,10,"PAH",193,1,73,0)="will be entered into that module in IB.  To ensure that the Autobiller "
^DIC(9.4,49,22,10,"PAH",193,1,74,0)="does not bill the prescription on a paper claim until the electronic "
^DIC(9.4,49,22,10,"PAH",193,1,75,0)="transmission can be processed, the EARLIEST AUTOBILL DATE will be set for "
^DIC(9.4,49,22,10,"PAH",193,1,76,0)="60 days into the future.  If the claim is not processed or resolved in "
^DIC(9.4,49,22,10,"PAH",193,1,77,0)="pharmacy within 60 days, then a paper claim will be automatically "
^DIC(9.4,49,22,10,"PAH",193,1,78,0)="generated."
^DIC(9.4,49,22,10,"PAH",193,1,79,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,80,0)="3.  If the bill for the prescription is approved by the third party "
^DIC(9.4,49,22,10,"PAH",193,1,81,0)="insurance carrier for payment, Outpatient Pharmacy will make a second "
^DIC(9.4,49,22,10,"PAH",193,1,82,0)="call to IB.  At that time, IB will create a bill in the BILL/CLAIMS "
^DIC(9.4,49,22,10,"PAH",193,1,83,0)="(#399) file for the amount of the total charge.  The bill will be "
^DIC(9.4,49,22,10,"PAH",193,1,84,0)="automatically authorized and passed to Accounts Receivable (AR).  IB will "
^DIC(9.4,49,22,10,"PAH",193,1,85,0)="have AR automatically audit the receivable and post a decrease adjustment "
^DIC(9.4,49,22,10,"PAH",193,1,86,0)="so that the amount of the outstanding receivable will be equal to the "
^DIC(9.4,49,22,10,"PAH",193,1,87,0)="amount of payment expected from the payer."
^DIC(9.4,49,22,10,"PAH",193,1,88,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,89,0)="4.  If a prescription bill is rejected, Outpatient Pharmacy will make a "
^DIC(9.4,49,22,10,"PAH",193,1,90,0)="second call to IB.  Assuming Claims Tracking is active for prescriptions, "
^DIC(9.4,49,22,10,"PAH",193,1,91,0)="IB will check to make sure the prescription is in Claims Tracking.  The "
^DIC(9.4,49,22,10,"PAH",193,1,92,0)="Claims Tracking entry will be picked up by the Autobiller to ensure "
^DIC(9.4,49,22,10,"PAH",193,1,93,0)="proper follow-up is done."
^DIC(9.4,49,22,10,"PAH",193,1,94,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,95,0)="5.  If a prescription bill is reversed in Outpatient Pharmacy, both the "
^DIC(9.4,49,22,10,"PAH",193,1,96,0)="bill and receivable will be cancelled."
^DIC(9.4,49,22,10,"PAH",193,1,97,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,98,0)="6.  To support claims other than Reimbursable Insurance for Veterans, IB "
^DIC(9.4,49,22,10,"PAH",193,1,99,0)="will ask for both the Administrative Fee and Dispensing Fee when a rate "
^DIC(9.4,49,22,10,"PAH",193,1,100,0)="schedule adjustment is entered.  These are optional and will be sent in "
^DIC(9.4,49,22,10,"PAH",193,1,101,0)="the NCPDP transmission."
^DIC(9.4,49,22,10,"PAH",193,1,102,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,103,0)="7.  To assist with the posting of payments, the API used to look "
^DIC(9.4,49,22,10,"PAH",193,1,104,0)="up bills to post payments in the Accounts Receivable package has "
^DIC(9.4,49,22,10,"PAH",193,1,105,0)="been updated to allow for input of the ECME number."
^DIC(9.4,49,22,10,"PAH",193,1,106,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,107,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,108,0)="Technical Description"
^DIC(9.4,49,22,10,"PAH",193,1,109,0)="---------------------"
^DIC(9.4,49,22,10,"PAH",193,1,110,0)="IB20P223 is an environment check to ensure that the site has 4 national "
^DIC(9.4,49,22,10,"PAH",193,1,111,0)="rate types defined.  If the rate types are not defined, a site will need "
^DIC(9.4,49,22,10,"PAH",193,1,112,0)="to defined them prior to install.  The 4 rate types are:"
^DIC(9.4,49,22,10,"PAH",193,1,113,0)="         CHAMPUS (or TRICARE)"
^DIC(9.4,49,22,10,"PAH",193,1,114,0)="         CHAMPUS REIMB. INS. (or TRICARE REIMB. INS.)"
^DIC(9.4,49,22,10,"PAH",193,1,115,0)="         CHAMPVA"
^DIC(9.4,49,22,10,"PAH",193,1,116,0)="         CHAMPVA REIMB. INS."
^DIC(9.4,49,22,10,"PAH",193,1,117,0)="If your site does not have the exact spelling as shown above, you should "
^DIC(9.4,49,22,10,"PAH",193,1,118,0)="contact EVS for assistance.  Your site may have them defined but the "
^DIC(9.4,49,22,10,"PAH",193,1,119,0)="names may have been changed."
^DIC(9.4,49,22,10,"PAH",193,1,120,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,121,0)="This routine also has a post install that will add two reasons not "
^DIC(9.4,49,22,10,"PAH",193,1,122,0)="billable.  They are:"
^DIC(9.4,49,22,10,"PAH",193,1,123,0)="         HEAD/NECK CANCER"
^DIC(9.4,49,22,10,"PAH",193,1,124,0)="         COMBAT VETERAN"
^DIC(9.4,49,22,10,"PAH",193,1,125,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,126,0)="IBCRCC has an optional parameter in the RATECHG line tag of FEE.  If this "
^DIC(9.4,49,22,10,"PAH",193,1,127,0)="parameter is passed by reference, the API will return any Administrative "
^DIC(9.4,49,22,10,"PAH",193,1,128,0)="Fee and Dispensing Fee amounts for the Rate Schedule."
^DIC(9.4,49,22,10,"PAH",193,1,129,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,130,0)="IBCREE has been modified to capture the Administrative Fee and Dispensing "
^DIC(9.4,49,22,10,"PAH",193,1,131,0)="Fee, if appropriate.  The Rate Schedule adjustment must have an amount "
^DIC(9.4,49,22,10,"PAH",193,1,132,0)="added in the calculation of the adjustment for the fee questions to be "
^DIC(9.4,49,22,10,"PAH",193,1,133,0)="asked."
^DIC(9.4,49,22,10,"PAH",193,1,134,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,135,0)="IBCRU3 has been modified to add a new entry point to look up the event "
^DIC(9.4,49,22,10,"PAH",193,1,136,0)="pointer based on a rate type."
^DIC(9.4,49,22,10,"PAH",193,1,137,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,138,0)="IBJTCA1 is included to add enhancements to the Third Party Joint Inquiry "
^DIC(9.4,49,22,10,"PAH",193,1,139,0)="to display new information that relates to ECME claims."
^DIC(9.4,49,22,10,"PAH",193,1,140,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,141,0)="IBNCPDP is the main API routine to be used by Outpatient Pharmacy.  All "
^DIC(9.4,49,22,10,"PAH",193,1,142,0)="new APIs will be supported with this routine."
^DIC(9.4,49,22,10,"PAH",193,1,143,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,144,0)="IBNCPDP1 will handle the initial call by Outpatient Pharmacy.  This "
^DIC(9.4,49,22,10,"PAH",193,1,145,0)="routine will load the prescription information to Claims Tracking, look "
^DIC(9.4,49,22,10,"PAH",193,1,146,0)="up insurance information, verify active pharmacy coverage and return the "
^DIC(9.4,49,22,10,"PAH",193,1,147,0)="necessary billing information so that a NCPDP claim can be produced."
^DIC(9.4,49,22,10,"PAH",193,1,148,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,149,0)="IBNCPDP2 will handle all response information sent from Outpatient "
^DIC(9.4,49,22,10,"PAH",193,1,150,0)="Pharmacy.  This routine will create bills, authorize bills, audit bills, "
^DIC(9.4,49,22,10,"PAH",193,1,151,0)="adjust bills, cancel bills and ensure that the claims are updated in "
^DIC(9.4,49,22,10,"PAH",193,1,152,0)="Claims Tracking."
^DIC(9.4,49,22,10,"PAH",193,1,153,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,154,0)="IBNCPDP3 will handle Average Wholesale Pricing updates."
^DIC(9.4,49,22,10,"PAH",193,1,155,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,156,0)="IBNCPCPU will be a utility routine for all the NCPDP billing needs in IB."
^DIC(9.4,49,22,10,"PAH",193,1,157,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,158,0)="IBRFN has been updated to allow for input of an ECME number when posting "
^DIC(9.4,49,22,10,"PAH",193,1,159,0)="payments in the Accounts Receivable package.  The API for AR will now "
^DIC(9.4,49,22,10,"PAH",193,1,160,0)="return the type of lookup found."
^DIC(9.4,49,22,10,"PAH",193,1,161,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,162,0)="IBRUTL is being included to suppress the third party billing bulletin when"
^DIC(9.4,49,22,10,"PAH",193,1,163,0)="a first party bill goes on hold for third party billing and the bill has"
^DIC(9.4,49,22,10,"PAH",193,1,164,0)="already been billed using the ECME software."
^DIC(9.4,49,22,10,"PAH",193,1,165,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,166,0)="IBTUTL1 has been modified to accept an additional optional parameter in "
^DIC(9.4,49,22,10,"PAH",193,1,167,0)="the REFILL line tag for the EARLIEST AUTOBILL DATE.  If the new parameter "
^DIC(9.4,49,22,10,"PAH",193,1,168,0)="is specified in the call, that date will be used instead of the existing "
^DIC(9.4,49,22,10,"PAH",193,1,169,0)="functionality."
^DIC(9.4,49,22,10,"PAH",193,1,170,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,171,0)="    "
^DIC(9.4,49,22,10,"PAH",193,1,172,0)="COMPONENTS SENT WITH PATCH"
^DIC(9.4,49,22,10,"PAH",193,1,173,0)="--------------------------"
^DIC(9.4,49,22,10,"PAH",193,1,174,0)=" The following is a list of the routine(s) included in this patch.  "
^DIC(9.4,49,22,10,"PAH",193,1,175,0)=" The second line of each of these routine(s) will look like:"
^DIC(9.4,49,22,10,"PAH",193,1,176,0)="    "
^DIC(9.4,49,22,10,"PAH",193,1,177,0)="   <tab>;;2.0;INTEGRATED BILLING;**[patch list]**;21-MAR-94"
^DIC(9.4,49,22,10,"PAH",193,1,178,0)="   "
^DIC(9.4,49,22,10,"PAH",193,1,179,0)="                  CHECK^XTSUMBLD results"
^DIC(9.4,49,22,10,"PAH",193,1,180,0)="    "
^DIC(9.4,49,22,10,"PAH",193,1,181,0)="   Routine     Before Patch  After Patch  Patch List"
^DIC(9.4,49,22,10,"PAH",193,1,182,0)="   -------     ------------  -----------  ----------"
^DIC(9.4,49,22,10,"PAH",193,1,183,0)=" * IB20P223           N/A        2185163  223"
^DIC(9.4,49,22,10,"PAH",193,1,184,0)="   IBCRCC         7424137        7476482  52,80,106,138,245,223"
^DIC(9.4,49,22,10,"PAH",193,1,185,0)="   IBCREE        20456836       21593159  52,106,115,223"
^DIC(9.4,49,22,10,"PAH",193,1,186,0)="   IBCRU3         5450420        6652039  52,106,223"
^DIC(9.4,49,22,10,"PAH",193,1,187,0)="   IBJTCA1       16164807       16640403  39,80,106,137,223"
^DIC(9.4,49,22,10,"PAH",193,1,188,0)="   IBNCPDP            N/A         355298  223"
^DIC(9.4,49,22,10,"PAH",193,1,189,0)="   IBNCPDP1           N/A       13353250  223"
^DIC(9.4,49,22,10,"PAH",193,1,190,0)="   IBNCPDP2           N/A       16386559  223"
^DIC(9.4,49,22,10,"PAH",193,1,191,0)="   IBNCPDP3           N/A         758252  223"
^DIC(9.4,49,22,10,"PAH",193,1,192,0)="   IBNCPDPU           N/A        8111193  223"
^DIC(9.4,49,22,10,"PAH",193,1,193,0)="   IBRFN          4021093        6787815  52,130,183,223"
^DIC(9.4,49,22,10,"PAH",193,1,194,0)="   IBRUTL         3925983        4993649  70,82,132,142,176,179,202,223"
^DIC(9.4,49,22,10,"PAH",193,1,195,0)="   IBTUTL1        5460777        6092014  13,223"
^DIC(9.4,49,22,10,"PAH",193,1,196,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,197,0)="      Total number of routines - 13"
^DIC(9.4,49,22,10,"PAH",193,1,198,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,199,0)=" "
^DIC(9.4,49,22,10,"PAH",193,1,200,0)="   * NOTE: THIS ROUTINE WILL BE AUTOMATICALLY DELETED AFTER INSTALL."
^DIC(9.4,49,22,10,"PAH",193,1,201,0)=" "
