^DIC(9.4,100,22,15,"PAH",56,1,293,0)="  ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",56,1,294,0)="  ================"
^DIC(9.4,100,22,15,"PAH",56,1,295,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,296,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,100,22,15,"PAH",56,1,297,0)="  of each of these routines now looks like:"
^DIC(9.4,100,22,15,"PAH",56,1,298,0)="  <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30,1994"
^DIC(9.4,100,22,15,"PAH",56,1,299,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,300,0)="                              Checksum Values"
^DIC(9.4,100,22,15,"PAH",56,1,301,0)=" "
