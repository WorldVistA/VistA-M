^DIC(9.4,48,22,5.28,"PAH",108,1,1,0)="This patch provides the capability to display and capture Global"
^DIC(9.4,48,22,5.28,"PAH",108,1,2,0)="Assessment of Function (GAF) Scores and related data during appointment"
^DIC(9.4,48,22,5.28,"PAH",108,1,3,0)="check-out.  All new GAF data will be passed to the Mental Health system"
^DIC(9.4,48,22,5.28,"PAH",108,1,4,0)="through Mental Health provided API's."
^DIC(9.4,48,22,5.28,"PAH",109,0)="158 SEQ #147^2981125^1"
^DIC(9.4,48,22,5.28,"PAH",109,1,0)="^^9^9^2981125"
^DIC(9.4,48,22,5.28,"PAH",109,1,1,0)=" *** NOTE:  This patch should be loaded during non-peak hours to minimize"
^DIC(9.4,48,22,5.28,"PAH",109,1,2,0)="     disruption to users. "
^DIC(9.4,48,22,5.28,"PAH",109,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",109,1,4,0)=" Scheduling calls ListManager incorrectly, causing some terminal"
^DIC(9.4,48,22,5.28,"PAH",109,1,5,0)=" emulators to become trapped outside the scrolling region. This"
^DIC(9.4,48,22,5.28,"PAH",109,1,6,0)=" problem was noted in NOIS message LAK-0798-31437. It affects the"
^DIC(9.4,48,22,5.28,"PAH",109,1,7,0)=" options Edit Outpatient Encounter [SCENI OP ENCOUNTER EDIT] and"
^DIC(9.4,48,22,5.28,"PAH",109,1,8,0)=" Correct Incomplete Encounters [SCENI IEMM ERROR CORRECTION]. The"
^DIC(9.4,48,22,5.28,"PAH",109,1,9,0)=" routine SCENIA2 has been modified to fix this defect. "
^DIC(9.4,48,22,5.28,"PAH",110,0)="155 SEQ #148^2981125^1"
^DIC(9.4,48,22,5.28,"PAH",110,1,0)="^^1^1^2981125"
^DIC(9.4,48,22,5.28,"PAH",110,1,1,0)="Encounter 'Action Required' Report NOIS issues."
