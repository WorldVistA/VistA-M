^DIC(9.4,96,22,1.2,"PAH",4,1,73,0)="ERROR-- Bed section must be blank if patient category is OPT, NHC or DOM."
^DIC(9.4,96,22,1.2,"PAH",4,1,74,0)="ERROR-- Patient category must be Class I-VI (9-17) for spot check/pre-auth"
^DIC(9.4,96,22,1.2,"PAH",4,1,75,0)="exam."
^DIC(9.4,96,22,1.2,"PAH",4,1,76,0)="ERROR-- Patient category and type of service code are incompatible."
^DIC(9.4,96,22,1.2,"PAH",4,1,77,0)="ERROR-- You are not allowed to mark both the screening/complete and"
^DIC(9.4,96,22,1.2,"PAH",4,1,78,0)="evaluation fields."
^DIC(9.4,96,22,1.2,"PAH",4,1,79,0)="ERROR-- Patient education must be blank if prophy is marked."
^DIC(9.4,96,22,1.2,"PAH",4,1,80,0)=" "
