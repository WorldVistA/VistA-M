^DIC(9.4,11,22,5.03,"PAH",35,0)="66 SEQ #55^3090421.140608^17"
^DIC(9.4,11,22,5.03,"PAH",35,1,0)="^^428^428^3090421"
^DIC(9.4,11,22,5.03,"PAH",35,1,1,0)=" Blood Bank Team Coordination"
^DIC(9.4,11,22,5.03,"PAH",35,1,2,0)=" ============================"
^DIC(9.4,11,22,5.03,"PAH",35,1,3,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*66 does not contain"
^DIC(9.4,11,22,5.03,"PAH",35,1,4,0)=" any changes to the VISTA BLOOD BANK Software as defined by VHA DIRECTIVE"
^DIC(9.4,11,22,5.03,"PAH",35,1,5,0)=" 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,11,22,5.03,"PAH",35,1,6,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,7,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*66 does not alter or"
^DIC(9.4,11,22,5.03,"PAH",35,1,8,0)=" modify any software design safeguards or safety critical elements functions."
^DIC(9.4,11,22,5.03,"PAH",35,1,9,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,10,0)=" RISK ANALYSIS: Changes made by patch LA*5.2*66 have no effect on Blood Bank"
^DIC(9.4,11,22,5.03,"PAH",35,1,11,0)=" software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",35,1,12,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,13,0)=" VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes made,"
^DIC(9.4,11,22,5.03,"PAH",35,1,14,0)=" no specific validation requirements exist as a result of installation of this"
^DIC(9.4,11,22,5.03,"PAH",35,1,15,0)=" patch."
^DIC(9.4,11,22,5.03,"PAH",35,1,16,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,17,0)=" ************************************************************************"
^DIC(9.4,11,22,5.03,"PAH",35,1,18,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,19,0)=" This patch upgrades the Lab Universal Interface (UI) from VistA's Health Level"
^DIC(9.4,11,22,5.03,"PAH",35,1,20,0)=" Seven (HL) v1.5 to HL v1.6 including the use of v1.6 TCP/IP functionality.  It"
^DIC(9.4,11,22,5.03,"PAH",35,1,21,0)=" supports the current Lab UI HL7 Interface Specifications based on the HL7"
^DIC(9.4,11,22,5.03,"PAH",35,1,22,0)=" Standard V2.2."
^DIC(9.4,11,22,5.03,"PAH",35,1,23,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,24,0)=" The current UI interface using the HL v1.5 interface will continue to function"
^DIC(9.4,11,22,5.03,"PAH",35,1,25,0)=" after patch installation.  The transition to the HL V1.6 interface can be"
^DIC(9.4,11,22,5.03,"PAH",35,1,26,0)=" accomplished after patch installation on a connection by connection basis."
^DIC(9.4,11,22,5.03,"PAH",35,1,27,0)=" When possible, switching from the old interface to the new interface should be"
^DIC(9.4,11,22,5.03,"PAH",35,1,28,0)=" done on a per instrument basis instead of all instruments at once.  Follow the"
^DIC(9.4,11,22,5.03,"PAH",35,1,29,0)=" post installation instructions to convert an interface to the HL V1.6"
^DIC(9.4,11,22,5.03,"PAH",35,1,30,0)=" interface."
^DIC(9.4,11,22,5.03,"PAH",35,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,32,0)="    Note: New Generic Instrument Manager (GIM) software must be obtained"
^DIC(9.4,11,22,5.03,"PAH",35,1,33,0)="          from the vendor in order for this new interface to work."
^DIC(9.4,11,22,5.03,"PAH",35,1,34,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,35,0)=" Before the release of this patch lab instruments interfaced through TCP/IP were"
^DIC(9.4,11,22,5.03,"PAH",35,1,36,0)=" using a non-supported modification of an HL7 routine.  This patch will allow"
^DIC(9.4,11,22,5.03,"PAH",35,1,37,0)=" sites to interface their automated testing devices via supported TCP/IP"
^DIC(9.4,11,22,5.03,"PAH",35,1,38,0)=" functionality and will allow the sites to manage these interfaces using the HL7"
^DIC(9.4,11,22,5.03,"PAH",35,1,39,0)=" v1.6 package's tools."
^DIC(9.4,11,22,5.03,"PAH",35,1,40,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,41,0)=" HL7 messages are HL7 version 2.2 and the messaging is composed of ORM~O01 and"
^DIC(9.4,11,22,5.03,"PAH",35,1,42,0)=" ORU~R01 messages.  Messaging uses original acknowledgement mode.  ORM messages"
^DIC(9.4,11,22,5.03,"PAH",35,1,43,0)=" use ""LA7LAB"" as the Sending Application and ""LA7UIx"" as the Receiving"
^DIC(9.4,11,22,5.03,"PAH",35,1,44,0)=" Application.  ORU messages use ""LA7UIx"" as the Sending Application and ""LA7LAB"""
^DIC(9.4,11,22,5.03,"PAH",35,1,45,0)=" as the Receiving Application."
^DIC(9.4,11,22,5.03,"PAH",35,1,46,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,47,0)=" The PROTOCOL (#101), HL7 APPLICATION PARAMETER (#771), HL LOGICAL LINK (#870)"
^DIC(9.4,11,22,5.03,"PAH",35,1,48,0)=" and LA7 MESSAGE PARAMETER (#62.48) files each have ten entries using a naming"
^DIC(9.4,11,22,5.03,"PAH",35,1,49,0)=" convention that contains ""LA7UIx"" (where ""x"" is an integer) such as ""LA7UI1"
^DIC(9.4,11,22,5.03,"PAH",35,1,50,0)=" ORU-R01 EVENT 2.2"" and ""LA7UI1.""  This convention allows the site to interface"
^DIC(9.4,11,22,5.03,"PAH",35,1,51,0)=" with multiple generic instrument managers."
^DIC(9.4,11,22,5.03,"PAH",35,1,52,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,53,0)=" To setup an auto-instrument, the MESSAGE CONFIGURATION field (#8) of the AUTO"
^DIC(9.4,11,22,5.03,"PAH",35,1,54,0)=" INSTRUMENT file (#62.4) must be set to the appropriate LA7 MESSAGE PARAMETER"
^DIC(9.4,11,22,5.03,"PAH",35,1,55,0)=" file (#62.48) entry (ie LA7UI1).  Also, the FILE BUILD ENTRY field (#93) should"
^DIC(9.4,11,22,5.03,"PAH",35,1,56,0)=" equal ""EN"" and the FILE BUILD ROUTINE field (#94) should equal ""LA7UID""."
^DIC(9.4,11,22,5.03,"PAH",35,1,57,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,58,0)=" In order to send/receive messages the configuration needs to be set ACTIVE via"
^DIC(9.4,11,22,5.03,"PAH",35,1,59,0)=" its STATUS field (#2) of LA7 MESSAGE PARAMETER file (#62.48).  The"
^DIC(9.4,11,22,5.03,"PAH",35,1,60,0)=" configuration must also specify which routine is used to process messages in"
^DIC(9.4,11,22,5.03,"PAH",35,1,61,0)=" LA7 MESSAGE PARAMETER file (#62.48) PROCESS DOWNLOAD field (#6) which should be"
^DIC(9.4,11,22,5.03,"PAH",35,1,62,0)=" set to ""D EN^LA7UIO"" for Lab Universal Interfaces."
^DIC(9.4,11,22,5.03,"PAH",35,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,64,0)="   AUTO INSTRUMENT (#62.4)"
^DIC(9.4,11,22,5.03,"PAH",35,1,65,0)="     MESSAGE CONFIGURATION (#8) = LA7 MESSAGE PARAMETER entry (ie LA7UI1)"
^DIC(9.4,11,22,5.03,"PAH",35,1,66,0)="     FILE BUILD ENTRY (#93) = EN"
^DIC(9.4,11,22,5.03,"PAH",35,1,67,0)="     FILE BUILD ROUTINE (#94) = LA7UID"
^DIC(9.4,11,22,5.03,"PAH",35,1,68,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,69,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,70,0)="   LA7 MESSAGE PARAMETER (#62.48)"
^DIC(9.4,11,22,5.03,"PAH",35,1,71,0)="     STATUS (#2) = ACTIVE"
^DIC(9.4,11,22,5.03,"PAH",35,1,72,0)="     PROCESS DOWNLOAD (#6) = D EN^LA7UIO"
^DIC(9.4,11,22,5.03,"PAH",35,1,73,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,75,0)=" 1)  The v1.5 interface constructed ORM message segments that were not in"
^DIC(9.4,11,22,5.03,"PAH",35,1,76,0)=" compliance with the HL7 standard.  Previously an ORC segment was followed by"
^DIC(9.4,11,22,5.03,"PAH",35,1,77,0)=" one or more OBR segments.  The HL7 standard specifies that ORC/OBR segments"
^DIC(9.4,11,22,5.03,"PAH",35,1,78,0)=" should exist as a pair so in this interface each ordered test will be sent in"
^DIC(9.4,11,22,5.03,"PAH",35,1,79,0)=" the ORM message as an ORC/OBR segment pair.  Example:"
^DIC(9.4,11,22,5.03,"PAH",35,1,80,0)="   PID..."
^DIC(9.4,11,22,5.03,"PAH",35,1,81,0)="   PV1..."
^DIC(9.4,11,22,5.03,"PAH",35,1,82,0)="   ORC..."
^DIC(9.4,11,22,5.03,"PAH",35,1,83,0)="   OBR..."
^DIC(9.4,11,22,5.03,"PAH",35,1,84,0)="   ORC..."
^DIC(9.4,11,22,5.03,"PAH",35,1,85,0)="   OBR..."
^DIC(9.4,11,22,5.03,"PAH",35,1,86,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,88,0)=" 2)  HL7 message data is now checked for conflicts with HL7 delimiters.  If data"
^DIC(9.4,11,22,5.03,"PAH",35,1,89,0)=" conflicts with the message's delimiters then the data with be escape encoded"
^DIC(9.4,11,22,5.03,"PAH",35,1,90,0)=" according to HL7 rules."
^DIC(9.4,11,22,5.03,"PAH",35,1,91,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,93,0)=" 3)  In an ORM message, OBR-18 is constructed as an HL7 string data type.  The"
^DIC(9.4,11,22,5.03,"PAH",35,1,94,0)=" HL7 v1.5 interface constructed it as a coded element (CE) data type."
^DIC(9.4,11,22,5.03,"PAH",35,1,95,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,96,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,97,0)=" 4)  For Lab UI messages, if the specimen received does not match the HL7 0070"
^DIC(9.4,11,22,5.03,"PAH",35,1,98,0)=" table, an interface error message will be created unless the specimen is"
^DIC(9.4,11,22,5.03,"PAH",35,1,99,0)=" related to the LAB CONTROL NAME file (#62.3)."
^DIC(9.4,11,22,5.03,"PAH",35,1,100,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,101,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,102,0)=" 5)  For Lab UI messages, any units/reference ranges received from an instrument"
^DIC(9.4,11,22,5.03,"PAH",35,1,103,0)=" are discarded as the units/reference ranges from the associated LABORATORY TEST"
^DIC(9.4,11,22,5.03,"PAH",35,1,104,0)=" file (#60) are used."
^DIC(9.4,11,22,5.03,"PAH",35,1,105,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,106,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,107,0)=" 6)  For Lab UI messages, abnormal flags received from an instrument are not"
^DIC(9.4,11,22,5.03,"PAH",35,1,108,0)=" stored."
^DIC(9.4,11,22,5.03,"PAH",35,1,109,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,110,0)=" 7)  The Lab UI Auto Download process (routine LA7ADL) is changed to support the"
^DIC(9.4,11,22,5.03,"PAH",35,1,111,0)=" FileMan system wide lock timeout via supported API LOCK^DILF."
^DIC(9.4,11,22,5.03,"PAH",35,1,112,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,113,0)=" 8. To provide for data entry consistency, results received via this"
^DIC(9.4,11,22,5.03,"PAH",35,1,114,0)=" interface are validated against the input transform for the data field"
^DIC(9.4,11,22,5.03,"PAH",35,1,115,0)=" used to store the test results. Test results received from an instrument"
^DIC(9.4,11,22,5.03,"PAH",35,1,116,0)=" that do not conform to the input transform for the related Lab Data Name"
^DIC(9.4,11,22,5.03,"PAH",35,1,117,0)=" will be rejected."
^DIC(9.4,11,22,5.03,"PAH",35,1,118,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,119,0)=" If SET OF CODES is utilized as the data type for a particular interfaced"
^DIC(9.4,11,22,5.03,"PAH",35,1,120,0)=" test, the internally stored code needs to be brought into alignment with"
^DIC(9.4,11,22,5.03,"PAH",35,1,121,0)=" what the instrument is reporting. If the instrument sends a result that"
^DIC(9.4,11,22,5.03,"PAH",35,1,122,0)=" does not match what is entered in the SET OF CODES that result is"
^DIC(9.4,11,22,5.03,"PAH",35,1,123,0)=" considered not to be verifiable data."
^DIC(9.4,11,22,5.03,"PAH",35,1,124,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,125,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,126,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,127,0)=" Associated Remedy:"
^DIC(9.4,11,22,5.03,"PAH",35,1,128,0)=" ==============="
^DIC(9.4,11,22,5.03,"PAH",35,1,129,0)=" HD0000000192820  lab DI at Lyons is not working Resolution:"
^DIC(9.4,11,22,5.03,"PAH",35,1,130,0)="                  Resolved by site."
^DIC(9.4,11,22,5.03,"PAH",35,1,131,0)="                  thru UI No software changes required."
^DIC(9.4,11,22,5.03,"PAH",35,1,132,0)=" HD0000000069104  NETWORKING DATA INNOVATIONS INSTRUMENT MGR"
^DIC(9.4,11,22,5.03,"PAH",35,1,133,0)=" HD0000000069215  LAB DI - migrate from v1.5 to v1.6 TCP"
^DIC(9.4,11,22,5.03,"PAH",35,1,134,0)=" HD0000000069217  Slow DHCP processing of lab instrument data"
^DIC(9.4,11,22,5.03,"PAH",35,1,135,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,136,0)=" Associated E3R:"
^DIC(9.4,11,22,5.03,"PAH",35,1,137,0)=" ==============="
^DIC(9.4,11,22,5.03,"PAH",35,1,138,0)=" N/A"
^DIC(9.4,11,22,5.03,"PAH",35,1,139,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,140,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,141,0)=" Test Sites"
^DIC(9.4,11,22,5.03,"PAH",35,1,142,0)=" =========="
^DIC(9.4,11,22,5.03,"PAH",35,1,143,0)="  MILWAUKEE, WI -VAMC (large)"
^DIC(9.4,11,22,5.03,"PAH",35,1,144,0)="  NEW JERSEY HCS (large, integrated)"
^DIC(9.4,11,22,5.03,"PAH",35,1,145,0)="  TUCSON, AZ -VAMC (large)"
^DIC(9.4,11,22,5.03,"PAH",35,1,146,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,147,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,148,0)=" NEW OPTION:"
^DIC(9.4,11,22,5.03,"PAH",35,1,149,0)=" ========"
^DIC(9.4,11,22,5.03,"PAH",35,1,150,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,151,0)="   [LA7 UI SETUP]     Lab Universal Interface Setup"
^DIC(9.4,11,22,5.03,"PAH",35,1,152,0)="     Allows configuring Lab Universal Interface entries (LA7UI*) in the"
^DIC(9.4,11,22,5.03,"PAH",35,1,153,0)="     LAB MESSAGE PARAMETER file (#62.48) and corresponding entries in the"
^DIC(9.4,11,22,5.03,"PAH",35,1,154,0)="     AUTO INSTRUMENT file (#62.4) which use the Lab Universal Interface."
^DIC(9.4,11,22,5.03,"PAH",35,1,155,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,156,0)="   This option is attached to menu option Lab Universal Interface Menu"
^DIC(9.4,11,22,5.03,"PAH",35,1,157,0)="   [LA7 MAIN MENU]."
^DIC(9.4,11,22,5.03,"PAH",35,1,158,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,159,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,160,0)=" PROTOCOLS:"
^DIC(9.4,11,22,5.03,"PAH",35,1,161,0)=" =========="
^DIC(9.4,11,22,5.03,"PAH",35,1,162,0)=" The following protocols are new:"
^DIC(9.4,11,22,5.03,"PAH",35,1,163,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,164,0)="    LA7UI ORM-O01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,165,0)="       ORM event driver for Lab Universal Interface (HL7 v1.6 upgrade)"
^DIC(9.4,11,22,5.03,"PAH",35,1,166,0)="       using HL7 messaging v2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,167,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,168,0)="    LA7UI ORM-O01 SUBS 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,169,0)="       ORM subscriber for Lab Universal Interface (HL7 v1.6 upgrade) using"
^DIC(9.4,11,22,5.03,"PAH",35,1,170,0)="       HL7 messaging v2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,171,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,172,0)="    LA7UI ORU-R01 SUBS 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,173,0)="       ORU subscriber for Lab Universal Interface (HL7 v1.6 upgrade) using"
^DIC(9.4,11,22,5.03,"PAH",35,1,174,0)="       HL7 messaging v2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,175,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,176,0)="    The following are ORU event drivers for Lab Universal Interface (HL7"
^DIC(9.4,11,22,5.03,"PAH",35,1,177,0)="    v1.6 upgrade) using HL7 messaging v2.2 :"
^DIC(9.4,11,22,5.03,"PAH",35,1,178,0)="      LA7UI1 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,179,0)="      LA7UI2 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,180,0)="      LA7UI3 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,181,0)="      LA7UI4 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,182,0)="      LA7UI5 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,183,0)="      LA7UI6 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,184,0)="      LA7UI7 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,185,0)="      LA7UI8 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,186,0)="      LA7UI9 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,187,0)="      LA7UI10 ORU-R01 EVENT 2.2"
^DIC(9.4,11,22,5.03,"PAH",35,1,188,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,189,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,190,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,191,0)=" Documentation Retrieval:"
^DIC(9.4,11,22,5.03,"PAH",35,1,192,0)=" ========================"
^DIC(9.4,11,22,5.03,"PAH",35,1,193,0)="  Documentation is available on the ANONYMOUS.SOFTWARE directory at one of"
^DIC(9.4,11,22,5.03,"PAH",35,1,194,0)="  the following Office of Information (OI) Field Offices.  Sites may"
^DIC(9.4,11,22,5.03,"PAH",35,1,195,0)="  retrieve documentation in one of the following ways:"
^DIC(9.4,11,22,5.03,"PAH",35,1,196,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,197,0)="  1.  The preferred method is to FTP the files from:"
^DIC(9.4,11,22,5.03,"PAH",35,1,198,0)="            download.vista.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",35,1,199,0)="      which will transmit the files from the first available FTP server."
^DIC(9.4,11,22,5.03,"PAH",35,1,200,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,201,0)="  2.  Sites may also elect to retrieve documentation directly from a"
^DIC(9.4,11,22,5.03,"PAH",35,1,202,0)="      specific server as follows:"
^DIC(9.4,11,22,5.03,"PAH",35,1,203,0)="         Albany          ftp.fo-albany.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",35,1,204,0)="         Hines           ftp.fo-hines.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",35,1,205,0)="         Salt Lake City  ftp.fo-slc.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",35,1,206,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,207,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,208,0)="      The documentation distribution includes:"
^DIC(9.4,11,22,5.03,"PAH",35,1,209,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,210,0)=" File Name          Contents                       Retrieval Formats"
^DIC(9.4,11,22,5.03,"PAH",35,1,211,0)=" ---------          --------                       -----------------"
^DIC(9.4,11,22,5.03,"PAH",35,1,212,0)=" LAB_52_LA66_INSTALL_USER_GUIDE.doc"
^DIC(9.4,11,22,5.03,"PAH",35,1,213,0)="                    Laboratory UI HL V1.6 Upgrade"
^DIC(9.4,11,22,5.03,"PAH",35,1,214,0)="                    Installation and User Guide"
^DIC(9.4,11,22,5.03,"PAH",35,1,215,0)="                    Patch LA*5.2*66                BINARY"
^DIC(9.4,11,22,5.03,"PAH",35,1,216,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,217,0)=" LAB_52_LA66_INSTALL_USER_GUIDE.pdf"
^DIC(9.4,11,22,5.03,"PAH",35,1,218,0)="                    Laboratory UI HL V1.6 Upgrade"
^DIC(9.4,11,22,5.03,"PAH",35,1,219,0)="                    Installation and User Guide"
^DIC(9.4,11,22,5.03,"PAH",35,1,220,0)="                    Patch LA*5.2*66                BINARY"
^DIC(9.4,11,22,5.03,"PAH",35,1,221,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,222,0)=" LAB_52_LA66_HL7_SPECIFICATIONS.doc"
^DIC(9.4,11,22,5.03,"PAH",35,1,223,0)="                    Laboratory UI HL V1.6 Upgrade"
^DIC(9.4,11,22,5.03,"PAH",35,1,224,0)="                    Installation and User Guide"
^DIC(9.4,11,22,5.03,"PAH",35,1,225,0)="                    Patch LA*5.2*66                BINARY"
^DIC(9.4,11,22,5.03,"PAH",35,1,226,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,227,0)=" LAB_52_LA66_HL7_SPECIFICATIONS.pdf"
^DIC(9.4,11,22,5.03,"PAH",35,1,228,0)="                    Laboratory UI HL V1.6 Upgrade"
^DIC(9.4,11,22,5.03,"PAH",35,1,229,0)="                    Installation and User Guide"
^DIC(9.4,11,22,5.03,"PAH",35,1,230,0)="                    Patch LA*5.2*66                BINARY"
^DIC(9.4,11,22,5.03,"PAH",35,1,231,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,232,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,233,0)="  3.  Documentation can also be retrieved from the VistA Documentation"
^DIC(9.4,11,22,5.03,"PAH",35,1,234,0)="      Library (VDL) at  http://www.domain.ext/vdl/"
^DIC(9.4,11,22,5.03,"PAH",35,1,235,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,236,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,237,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,238,0)=" INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",35,1,239,0)=" ========================="
^DIC(9.4,11,22,5.03,"PAH",35,1,240,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,241,0)="   The install time for this patch is less than 2 minutes.  This patch"
^DIC(9.4,11,22,5.03,"PAH",35,1,242,0)="   should be installed when Laboratory users are off the system."
^DIC(9.4,11,22,5.03,"PAH",35,1,243,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,244,0)="   The Lab Universal Interface Auto Download should be shutdown before"
^DIC(9.4,11,22,5.03,"PAH",35,1,245,0)="   installing this patch.  This can be done via the Start/Stop Auto"
^DIC(9.4,11,22,5.03,"PAH",35,1,246,0)="   Download Background Job [LA7 ADL START/STOP] menu option."
^DIC(9.4,11,22,5.03,"PAH",35,1,247,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,248,0)="   The KIDS environment check determines if the Lab UI Auto Download"
^DIC(9.4,11,22,5.03,"PAH",35,1,249,0)="   process is currently running:"
^DIC(9.4,11,22,5.03,"PAH",35,1,250,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,251,0)="     If it is running it will be automatically shutdown during patch"
^DIC(9.4,11,22,5.03,"PAH",35,1,252,0)="     installation and automatically restarted after patch installation."
^DIC(9.4,11,22,5.03,"PAH",35,1,253,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,254,0)="     If the Lab UI Auto Download process is not running at patch"
^DIC(9.4,11,22,5.03,"PAH",35,1,255,0)="     installation time then KIDS will take no action with the Lab UI Auto"
^DIC(9.4,11,22,5.03,"PAH",35,1,256,0)="     download process."
^DIC(9.4,11,22,5.03,"PAH",35,1,257,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,258,0)="   After patch installation is complete, check the status of the Lab UI"
^DIC(9.4,11,22,5.03,"PAH",35,1,259,0)="   Auto Download process using the option Start/Stop Auto Download"
^DIC(9.4,11,22,5.03,"PAH",35,1,260,0)="   Background Job [LA7 ADL START/STOP] and configure to normal"
^DIC(9.4,11,22,5.03,"PAH",35,1,261,0)="   operational setting (see step 6 below)."
^DIC(9.4,11,22,5.03,"PAH",35,1,262,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,263,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,264,0)="   Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",35,1,265,0)="   The installation should NOT be queued."
^DIC(9.4,11,22,5.03,"PAH",35,1,266,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,267,0)="    Note: Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",35,1,268,0)="          Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",35,1,269,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,270,0)="   1.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",35,1,271,0)="       option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",35,1,272,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,273,0)="   2.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",35,1,274,0)="       select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",35,1,275,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,276,0)="   3.  Use the 'Verify Checksum in Transport Global' option and verify"
^DIC(9.4,11,22,5.03,"PAH",35,1,277,0)="       that all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",35,1,278,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,279,0)="   4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",35,1,280,0)="       options:"
^DIC(9.4,11,22,5.03,"PAH",35,1,281,0)="         Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",35,1,282,0)="         Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",35,1,283,0)="         Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",35,1,284,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,285,0)="   5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",35,1,286,0)="       and select the package 'LA*5.2*66'."
^DIC(9.4,11,22,5.03,"PAH",35,1,287,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,288,0)="       When prompted"
^DIC(9.4,11,22,5.03,"PAH",35,1,289,0)="         'Want KIDS to Rebuild Menu Trees Upon Completion of Install?'"
^DIC(9.4,11,22,5.03,"PAH",35,1,290,0)="       choose 'NO'.  Note: Responding ""Yes"" to the prompt for rebuilding"
^DIC(9.4,11,22,5.03,"PAH",35,1,291,0)="       menu trees can significantly increase install time."
^DIC(9.4,11,22,5.03,"PAH",35,1,292,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,293,0)="       When prompted"
^DIC(9.4,11,22,5.03,"PAH",35,1,294,0)="          'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,11,22,5.03,"PAH",35,1,295,0)="       choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",35,1,296,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,297,0)="       When prompted"
^DIC(9.4,11,22,5.03,"PAH",35,1,298,0)="           'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,11,22,5.03,"PAH",35,1,299,0)="            Protocols?  YES//'"
^DIC(9.4,11,22,5.03,"PAH",35,1,300,0)="       choose 'NO' unless the site has additional laboratory options that"
^DIC(9.4,11,22,5.03,"PAH",35,1,301,0)="       should be disabled during install."
^DIC(9.4,11,22,5.03,"PAH",35,1,302,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,303,0)="   6. If the Lab Universal Interface Auto Download process was stopped"
^DIC(9.4,11,22,5.03,"PAH",35,1,304,0)="      manually, restart it via the Start/Stop Auto Download Background"
^DIC(9.4,11,22,5.03,"PAH",35,1,305,0)="      Job [LA7 ADL START/STOP] menu option."
^DIC(9.4,11,22,5.03,"PAH",35,1,306,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,307,0)="      If the process was stopped by the KIDS install itself, the process"
^DIC(9.4,11,22,5.03,"PAH",35,1,308,0)="      will restart automatically."
^DIC(9.4,11,22,5.03,"PAH",35,1,309,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,310,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,311,0)="   Note: Routine LA66 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",35,1,312,0)=" "
^DIC(9.4,11,22,5.03,"PAH",35,1,313,0)=" "
