^DIC(9.4,192,22,2,"PAH",1,0)="1 SEQ #1^3061122.191156^1"
^DIC(9.4,192,22,2,"PAH",1,1,0)="^^2^2^3061122"
^DIC(9.4,192,22,2,"PAH",1,1,1,0)="For complete information, see the patch description for patch XOBV*1.5*1"
