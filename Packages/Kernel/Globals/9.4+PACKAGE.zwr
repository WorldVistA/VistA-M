^DIC(9.4,4,22,1,"PAH",74,1,6,0)="Test Site:  Wilmington, DE"
^DIC(9.4,4,22,1,"PAH",74,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",74,1,8,0)="Adds two checks to the API, $$ENT^XMA2R, which replies to a message."
^DIC(9.4,4,22,1,"PAH",74,1,9,0)="One check makes sure the message exists, and the other check makes sure"
^DIC(9.4,4,22,1,"PAH",74,1,10,0)="the message has recipients."
^DIC(9.4,4,22,1,"PAH",74,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",74,1,12,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",74,1,13,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",74,1,14,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",74,1,15,0)=""
