^DIC(9.4,73,22,9,"PAH",11,1,2,0)=" Subject:"
^DIC(9.4,73,22,9,"PAH",11,1,3,0)="    Correction of mismatch component and removal "
^DIC(9.4,73,22,9,"PAH",11,1,4,0)="      of additional unrelated information"
^DIC(9.4,73,22,9,"PAH",11,1,5,0)=" "
