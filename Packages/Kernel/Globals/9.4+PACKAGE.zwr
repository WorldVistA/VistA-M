^DIC(9.4,164,22,1,"PAH",221,0)="247 SEQ #218^3210809.105043^17"
^DIC(9.4,164,22,1,"PAH",221,1,0)="^^2^2^3210809"
^DIC(9.4,164,22,1,"PAH",221,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,164,22,1,"PAH",221,1,2,0)="under PSS*1.0*247."
^DIC(9.4,164,22,1,"PAH",222,0)="252^3220119.155246^17"
^DIC(9.4,164,22,1,"PAH",223,0)="255 SEQ #220^3220202.110435^17"
^DIC(9.4,164,22,1,"PAH",223,1,0)="^^4^4^3220202"
^DIC(9.4,164,22,1,"PAH",223,1,1,0)="This patch will fix the following:"
^DIC(9.4,164,22,1,"PAH",223,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",223,1,3,0)="Some prescriptions for DEA Schedule II medication are allowed to be "
^DIC(9.4,164,22,1,"PAH",223,1,4,0)="entered for greater than a 30 days supply."
^DIC(9.4,164,22,1,"PAH",224,0)="257 SEQ #221^3220321.192638^86"
^DIC(9.4,164,22,1,"PAH",224,1,0)="^^49^49^3220321"
^DIC(9.4,164,22,1,"PAH",224,1,1,0)="FDA Medication Guide Automatic Printing functionality  "
^DIC(9.4,164,22,1,"PAH",224,1,2,0)="includes 2 patches which must be installed in the following order: "
^DIC(9.4,164,22,1,"PAH",224,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,4,0)="1. PSS*1*257 - Vista patch that updates the Pharmacy System File "
^DIC(9.4,164,22,1,"PAH",224,1,5,0)="   (File#59.7) FDA MED GUIDE SERVER URL field (Field 100) with the new"
^DIC(9.4,164,22,1,"PAH",224,1,6,0)="   secure CMOP SharePoint URL."
^DIC(9.4,164,22,1,"PAH",224,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,8,0)="2. PSO*7*665 - Information only patch that contains instructions to  "
^DIC(9.4,164,22,1,"PAH",224,1,9,0)="   update the FDA Med Guide Automatic Printing Java Application "
^DIC(9.4,164,22,1,"PAH",224,1,10,0)="   Component installed on servers to work with the new CMOP SharePoint"
^DIC(9.4,164,22,1,"PAH",224,1,11,0)="   URL. "
^DIC(9.4,164,22,1,"PAH",224,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,14,0)="If your site is currently utilizing the FDA Med Guide Auto Printing "
^DIC(9.4,164,22,1,"PAH",224,1,15,0)="the updated Java Application Components included in "
^DIC(9.4,164,22,1,"PAH",224,1,16,0)="this release, must be installed immediately following the installation "
^DIC(9.4,164,22,1,"PAH",224,1,17,0)="of PSS*1*257. Failure to do so will disable Automatic printing "
^DIC(9.4,164,22,1,"PAH",224,1,18,0)="functionality until the updated Java Application Component software is "
^DIC(9.4,164,22,1,"PAH",224,1,19,0)="installed. "
^DIC(9.4,164,22,1,"PAH",224,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,21,0)="***If your site does not utilize the FDA Med Guide Auto  "
^DIC(9.4,164,22,1,"PAH",224,1,22,0)="Printing software, you only need to install Vista patch PSS*1*257  "
^DIC(9.4,164,22,1,"PAH",224,1,23,0)="and no further action on PSO*7*665 is necessary.*** "
^DIC(9.4,164,22,1,"PAH",224,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,25,0)="**************************************************************************"
^DIC(9.4,164,22,1,"PAH",224,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,27,0)="The previous SharePoint address is hard-coded and stored in the Pharmacy "
^DIC(9.4,164,22,1,"PAH",224,1,28,0)="System File (File #59.7) FDA MED GUIDE SERVER URL field (Field #100). "
^DIC(9.4,164,22,1,"PAH",224,1,29,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,30,0)="This patch will update the Pharmacy System File (File #59.7) FDA MED "
^DIC(9.4,164,22,1,"PAH",224,1,31,0)="GUIDE SERVER URL field (Field #100) with the new secure VA Share URL."
^DIC(9.4,164,22,1,"PAH",224,1,32,0)="Post-init routine PSS257P will change the FDA MED GUIDE SERVER URL field "
^DIC(9.4,164,22,1,"PAH",224,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,34,0)="from this: "
^DIC(9.4,164,22,1,"PAH",224,1,35,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,36,0)="""https://vaww.vashare.domain.ext/sites/PBMNat/FDAMedGuides/"" "
^DIC(9.4,164,22,1,"PAH",224,1,37,0)="to this: "
^DIC(9.4,164,22,1,"PAH",224,1,38,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,39,0)="file://v12.domain.ext/v12/PBM/Workgroup/VistA_MedGuides/"
^DIC(9.4,164,22,1,"PAH",224,1,40,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,41,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,42,0)="Patch PS0*7.0*665 (Automatic Printing) will be released at the same time "
^DIC(9.4,164,22,1,"PAH",224,1,43,0)="as this patch, PSS*1*257"
^DIC(9.4,164,22,1,"PAH",224,1,44,0)="Information only patches contain instructions to retrieve the "
^DIC(9.4,164,22,1,"PAH",224,1,45,0)="necessary files and documentation to update the Java Application "
^DIC(9.4,164,22,1,"PAH",224,1,46,0)="Component software to make this URL work with the system. "
^DIC(9.4,164,22,1,"PAH",224,1,47,0)=" "
^DIC(9.4,164,22,1,"PAH",224,1,48,0)="This patch (PSS*1*257) only makes the file update and does not alter any "
^DIC(9.4,164,22,1,"PAH",224,1,49,0)="VistA functionality. "
^DIC(9.4,164,22,1,"PAH",225,0)="256 SEQ #222^3220421.165503^86"
^DIC(9.4,164,22,1,"PAH",225,1,0)="^^42^42^3220421"
^DIC(9.4,164,22,1,"PAH",225,1,1,0)="This patch will resolve the following issues:"
^DIC(9.4,164,22,1,"PAH",225,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,3,0)="1. INC20326718 - Edit Orderable Items [PSS EDIT ORDERABLE ITEMS] menu "
^DIC(9.4,164,22,1,"PAH",225,1,4,0)="inappropriately jumps with use of an up carat ""^"" and a question mark "
^DIC(9.4,164,22,1,"PAH",225,1,5,0)="""?"". It was reported that the issue started occurring after the "
^DIC(9.4,164,22,1,"PAH",225,1,6,0)="indication fields were added (i.e. PSS*1*204)."
^DIC(9.4,164,22,1,"PAH",225,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,9,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,164,22,1,"PAH",225,1,10,0)="-----------------------------"
^DIC(9.4,164,22,1,"PAH",225,1,11,0)="N/A"
^DIC(9.4,164,22,1,"PAH",225,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,14,0)="Additional Information:"
^DIC(9.4,164,22,1,"PAH",225,1,15,0)="-----------------------"
^DIC(9.4,164,22,1,"PAH",225,1,16,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,164,22,1,"PAH",225,1,17,0)="INC20326718"
^DIC(9.4,164,22,1,"PAH",225,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,20,0)="Problem:"
^DIC(9.4,164,22,1,"PAH",225,1,21,0)="--------"
^DIC(9.4,164,22,1,"PAH",225,1,22,0)="It was reported by the Sacramento VA Medical Center that the Edit "
^DIC(9.4,164,22,1,"PAH",225,1,23,0)="Orderable Items [PSS EDIT ORDERABLE ITEMS] menu inappropriately jumps "
^DIC(9.4,164,22,1,"PAH",225,1,24,0)="several prompts with use of an up carat ""^"" and a question mark ""?"". "
^DIC(9.4,164,22,1,"PAH",225,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,27,0)="Resolution:"
^DIC(9.4,164,22,1,"PAH",225,1,28,0)="-----------"
^DIC(9.4,164,22,1,"PAH",225,1,29,0)="The following changes were made to address the issue:"
^DIC(9.4,164,22,1,"PAH",225,1,30,0)="1) Fix the logic so it does not inappropriately jump several prompts with "
^DIC(9.4,164,22,1,"PAH",225,1,31,0)="use of an up carat ""^"" and a question mark ""?"". "
^DIC(9.4,164,22,1,"PAH",225,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",225,1,34,0)="Technical Resolution:"
^DIC(9.4,164,22,1,"PAH",225,1,35,0)="---------------------"
^DIC(9.4,164,22,1,"PAH",225,1,36,0)="The following changes were made to address the issue:"
^DIC(9.4,164,22,1,"PAH",225,1,37,0)="1) Routine PSSPOIMO was updated in the DIR tag to move the 4 indication "
^DIC(9.4,164,22,1,"PAH",225,1,38,0)="fields (14, 13, 14.1, and 14.2) added with PSO*7*204 and PSO*7*242 to the "
^DIC(9.4,164,22,1,"PAH",225,1,39,0)="DR string variable.  This will resolve the issue of the indicator fields "
^DIC(9.4,164,22,1,"PAH",225,1,40,0)="displaying after the user enters an up carat ""^"" to quit out of the "
^DIC(9.4,164,22,1,"PAH",225,1,41,0)="option. In addition, the logic was updated in the DIR tag to not skip "
^DIC(9.4,164,22,1,"PAH",225,1,42,0)="prompts if a question mark is used for the help text."
^DIC(9.4,164,22,1,"PAH",226,0)="187^3221005.144954^89"
^DIC(9.4,164,22,1,"PAH",226,1,0)="^^14^14^3221005"
^DIC(9.4,164,22,1,"PAH",226,1,1,0)="The Computerized Patient Record System (CPRS) Graphical User Interface "
^DIC(9.4,164,22,1,"PAH",226,1,2,0)="(GUI) v32 is an enhancement release. This patch (PSS*1*187) is a part of "
^DIC(9.4,164,22,1,"PAH",226,1,3,0)="that enhancement release."
^DIC(9.4,164,22,1,"PAH",226,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",226,1,5,0)="This patch provides the needed functionalities to support the following "
^DIC(9.4,164,22,1,"PAH",226,1,6,0)="NSRs:"
^DIC(9.4,164,22,1,"PAH",226,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",226,1,8,0)="20090509: Park a Prescription"
^DIC(9.4,164,22,1,"PAH",226,1,9,0)="20100101: Indication on all Prescriptions and Medication Orders"
^DIC(9.4,164,22,1,"PAH",226,1,10,0)="20170512: Complex Non-VA Med Orders"
^DIC(9.4,164,22,1,"PAH",226,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",226,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",226,1,13,0)="For a complete listing of patches included in this release, please refer "
^DIC(9.4,164,22,1,"PAH",226,1,14,0)="to the CPRS GUI v32 Release Notes."
^DIC(9.4,164,22,1,"PAH",227,0)="258 SEQ #224^3230228.124131^89"
^DIC(9.4,164,22,1,"PAH",227,1,0)="^^2^2^3230228"
^DIC(9.4,164,22,1,"PAH",227,1,1,0)="This patch will update the PPSN web service to a more secure protocol:"
^DIC(9.4,164,22,1,"PAH",227,1,2,0)="""encrypt_only_tlsv12""."
^DIC(9.4,164,22,1,"PAH",228,0)="260^3231103.094946^89"
^DIC(9.4,164,22,1,"PAH",229,0)="261 SEQ #226^3231206.153839^89"
^DIC(9.4,164,22,1,"PAH",229,1,0)="^^1^1^3231206"
^DIC(9.4,164,22,1,"PAH",229,1,1,0)="See FORUM patch description."
^DIC(9.4,164,22,1,"PAH",230,0)="259 SEQ #227^3240325.095613^89"
^DIC(9.4,164,22,1,"PAH",230,1,0)="^^9^9^3240325"
^DIC(9.4,164,22,1,"PAH",230,1,1,0)="Computerized Patient Record System (CPRS) v33 MOE will address NSR "
^DIC(9.4,164,22,1,"PAH",230,1,2,0)="20090602: Addition of a Function to Enter Stop and Start Dates for "
^DIC(9.4,164,22,1,"PAH",230,1,3,0)="Inpatient Medications in CPRS."
^DIC(9.4,164,22,1,"PAH",230,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",230,1,5,0)="This patch is the preparation patch for the installation of CPRS v33 MOE. "
^DIC(9.4,164,22,1,"PAH",230,1,6,0)="It gives pharmacy informatics the ability to define one-time "
^DIC(9.4,164,22,1,"PAH",230,1,7,0)="administration schedules that should be excluded from the Start/Stop "
^DIC(9.4,164,22,1,"PAH",230,1,8,0)="functionality in CPRS. The exclusion schedules can be defined at system "
^DIC(9.4,164,22,1,"PAH",230,1,9,0)="or division level."
^DIC(9.4,164,22,1,"PAH",231,0)="239 SEQ #228^3240726.103627^89"
^DIC(9.4,164,22,1,"PAH",231,1,0)="^^1^1^3240726"
^DIC(9.4,164,22,1,"PAH",231,1,1,0)="See FORUM for patch description details."
^DIC(9.4,164,22,1,"PAH",232,0)="253^3241017.104833^89"
^DIC(9.4,164,22,1,"PAH",233,0)="266 SEQ #230^3241030.124838^89"
^DIC(9.4,164,22,1,"PAH",233,1,0)="^^2^2^3241030"
^DIC(9.4,164,22,1,"PAH",233,1,1,0)="Please review FORUM's Patch Module description and installation "
^DIC(9.4,164,22,1,"PAH",233,1,2,0)="instructions before installing this patch."
^DIC(9.4,164,22,1,"PAH",234,0)="264 SEQ #231^3250430.095229^90"
^DIC(9.4,164,22,1,"PAH",234,1,0)="^^2^2^3250430"
^DIC(9.4,164,22,1,"PAH",234,1,1,0)="Please review FORUM's Patch Module description and installation "
^DIC(9.4,164,22,1,"PAH",234,1,2,0)="instructions before installing this patch."
^DIC(9.4,164,22,1,"PAH",235,0)="254 SEQ #232^3250529.074029^90"
^DIC(9.4,164,22,1,"PAH",235,1,0)="^^2^2^3250529"
^DIC(9.4,164,22,1,"PAH",235,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,164,22,1,"PAH",235,1,2,0)="under PSS*1*254."
^DIC(9.4,164,22,1,"PAH",236,0)="262 SEQ #233^3260120.072931^90"
^DIC(9.4,164,22,1,"PAH",236,1,0)="^^7^7^3260120"
^DIC(9.4,164,22,1,"PAH",236,1,1,0)="This patch, along with other patches, adds Pharmacogenomic (PGx) order"
^DIC(9.4,164,22,1,"PAH",236,1,2,0)="checking to medication orders entered through Inpatient Medications,"
^DIC(9.4,164,22,1,"PAH",236,1,3,0)="Outpatient Pharmacy and Computerized Patient Record System (CPRS). A "
^DIC(9.4,164,22,1,"PAH",236,1,4,0)="patient's genomic test results will be retrieved from the Health Data"
^DIC(9.4,164,22,1,"PAH",236,1,5,0)="Repository (HDR), and along with the prospective drug(s) of a medication"
^DIC(9.4,164,22,1,"PAH",236,1,6,0)="order is sent to the vendor to retrieve interactions between the patient's"
^DIC(9.4,164,22,1,"PAH",236,1,7,0)="genes and the prospective drug(s)."
^DIC(9.4,164,22,1,"PAH",237,0)="268 SEQ #234^3260327.111444^90"
^DIC(9.4,164,22,1,"PAH",237,1,0)="^^20^20^3260327"
^DIC(9.4,164,22,1,"PAH",237,1,1,0)="This patch includes the following updates required for the upgrade from"
^DIC(9.4,164,22,1,"PAH",237,1,2,0)="First Databank (FDB) MedKnowledge Framework (Fwk) version 3.3 to version"
^DIC(9.4,164,22,1,"PAH",237,1,3,0)="4.5. It also includes a fix for a possible undefined error when running"
^DIC(9.4,164,22,1,"PAH",237,1,4,0)="the Check PEPS Services Setup [PSS CHECK PEPS SERVICES SETUP] Option."
^DIC(9.4,164,22,1,"PAH",237,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",237,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",237,1,7,0)="(1) The Dosing Order checks are updated to show General Dosing Range"
^DIC(9.4,164,22,1,"PAH",237,1,8,0)="    messaging information when applicable. There are some scenarios where"
^DIC(9.4,164,22,1,"PAH",237,1,9,0)="    that information should display but does not."
^DIC(9.4,164,22,1,"PAH",237,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",237,1,11,0)="(2) Updates the DESCRIPTION and HELP-PROMPT of the DOSING CHECK FREQUENCY"
^DIC(9.4,164,22,1,"PAH",237,1,12,0)="    (#11) Field of the ADMINISTRATION SCHEDULE (#51.1) File."
^DIC(9.4,164,22,1,"PAH",237,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",237,1,14,0)="(3) Adds a description to the SYNONYM (#51.242) Subfile of the DOSE "
^DIC(9.4,164,22,1,"PAH",237,1,15,0)="    UNITS (#51.24) File."
^DIC(9.4,164,22,1,"PAH",237,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",237,1,17,0)="(4) Fixes an error that sometimes occurs when running the Check PEPS"
^DIC(9.4,164,22,1,"PAH",237,1,18,0)="    Services Setup [PSS CHECK PEPS SERVICES SETUP] Option, located under"
^DIC(9.4,164,22,1,"PAH",237,1,19,0)="    the Peps Services [PSS PEPS SERVICES] Menu Option, located under the"
^DIC(9.4,164,22,1,"PAH",237,1,20,0)="    Pharmacy Data Management [PSS MGR] Menu Option."
^DIC(9.4,164,22,1,"PAH","B",1,18)=""
