^DIC(9.4,5,22,13,"PAH",7,1,66,0)="========================================================================= "
^DIC(9.4,5,22,13,"PAH",7,1,67,0)="Installation:"
^DIC(9.4,5,22,13,"PAH",7,1,68,0)=" 1.  DSM sites- These routines aren't usually mapped "
^DIC(9.4,5,22,13,"PAH",7,1,69,0)="     so you will probably not have to disable mapping."
^DIC(9.4,5,22,13,"PAH",7,1,70,0)="     "
^DIC(9.4,5,22,13,"PAH",7,1,71,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,5,22,13,"PAH",7,1,72,0)="     option will load the KIDS package onto your system."
^DIC(9.4,5,22,13,"PAH",7,1,73,0)="     "
^DIC(9.4,5,22,13,"PAH",7,1,74,0)=" 3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,5,22,13,"PAH",7,1,75,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,5,22,13,"PAH",7,1,76,0)="     On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",7,1,77,0)="     options:"
^DIC(9.4,5,22,13,"PAH",7,1,78,0)="      "
^DIC(9.4,5,22,13,"PAH",7,1,79,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,5,22,13,"PAH",7,1,80,0)="         Print Transport Global"
^DIC(9.4,5,22,13,"PAH",7,1,81,0)="         Compare Transport Global to Current System"
^DIC(9.4,5,22,13,"PAH",7,1,82,0)="         Backup a Transport Global"
^DIC(9.4,5,22,13,"PAH",7,1,83,0)="     "
^DIC(9.4,5,22,13,"PAH",7,1,84,0)=" 4.  Users can remain on the system. "
^DIC(9.4,5,22,13,"PAH",7,1,85,0)="     "
^DIC(9.4,5,22,13,"PAH",7,1,86,0)=" 5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,5,22,13,"PAH",7,1,87,0)="     option:"
^DIC(9.4,5,22,13,"PAH",7,1,88,0)="        Install Package(s)  'XU*8.0*??'"
^DIC(9.4,5,22,13,"PAH",7,1,89,0)="                             ========="
^DIC(9.4,5,22,13,"PAH",7,1,90,0)=""
^DIC(9.4,5,22,13,"PAH",7,1,91,0)=" 6.  DSM/MSM Sites - Move the following two routines to the MGR account."
^DIC(9.4,5,22,13,"PAH",7,1,92,0)="        ZTP1"
^DIC(9.4,5,22,13,"PAH",7,1,93,0)="        ZTPP"
^DIC(9.4,5,22,13,"PAH",7,1,94,0)="     In the MGR account rename the routines."
^DIC(9.4,5,22,13,"PAH",7,1,95,0)="        ZL ZTP1 ZS %ZTP1"
^DIC(9.4,5,22,13,"PAH",7,1,96,0)="        ZL ZTPP ZS %ZTPP"
^DIC(9.4,5,22,13,"PAH",7,1,97,0)=""
^DIC(9.4,5,22,13,"PAH",7,1,98,0)=" 7.  OpenM Sites - Just rename the routines."
^DIC(9.4,5,22,13,"PAH",7,1,99,0)="        ZL ZTP1 ZS %ZTP1"
^DIC(9.4,5,22,13,"PAH",7,1,100,0)="        ZL ZTPP ZS %ZTPP"
^DIC(9.4,5,22,13,"PAH",7,1,101,0)=""
^DIC(9.4,5,22,13,"PAH",7,1,102,0)=" ========================================================================="
^DIC(9.4,5,22,13,"PAH",7,1,103,0)=""
^DIC(9.4,5,22,13,"PAH",8,0)="25 SEQ #16^2980527^1"
^DIC(9.4,5,22,13,"PAH",8,1,0)="^^1^1^2980527"
^DIC(9.4,5,22,13,"PAH",8,1,1,0)="VPM-MISC FIXES; SEE PATCH MODULE FOR DETAILS"
^DIC(9.4,5,22,13,"PAH",9,0)="23^2981016^1"
^DIC(9.4,5,22,13,"PAH",9,1,0)="^^278^278^2981016"
^DIC(9.4,5,22,13,"PAH",9,1,1,0)="Associated patches:    DI*21*41"
^DIC(9.4,5,22,13,"PAH",9,1,2,0)="                       DI*21*42 "
^DIC(9.4,5,22,13,"PAH",9,1,3,0)="                       PSJ*4.5*43"
^DIC(9.4,5,22,13,"PAH",9,1,4,0)="                       DG*5.3*156"
^DIC(9.4,5,22,13,"PAH",9,1,5,0)="                       IMR*2.1*2"
^DIC(9.4,5,22,13,"PAH",9,1,6,0)="                       IB*2*94"
^DIC(9.4,5,22,13,"PAH",9,1,7,0)="                       IB*2*97"
^DIC(9.4,5,22,13,"PAH",9,1,8,0)="                       LR*5.2*205"
^DIC(9.4,5,22,13,"PAH",9,1,9,0)="Associated package:    NDBI v 1.0"
^DIC(9.4,5,22,13,"PAH",9,1,10,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,11,0)="Subject:  XT*7.3*23 Duplicate Record Merge:  Patient Merge"
^DIC(9.4,5,22,13,"PAH",9,1,12,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,13,0)="Category:"
^DIC(9.4,5,22,13,"PAH",9,1,14,0)="       - Enhancement (Mandatory)"
^DIC(9.4,5,22,13,"PAH",9,1,15,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,16,0)="Description:"
^DIC(9.4,5,22,13,"PAH",9,1,17,0)="========="
^DIC(9.4,5,22,13,"PAH",9,1,18,0)="Patient Merge provides an automated method to eliminate duplicate patient"
^DIC(9.4,5,22,13,"PAH",9,1,19,0)="records within the VISTA database.  It is an operational implementation of"
^DIC(9.4,5,22,13,"PAH",9,1,20,0)="the Duplicate Resolution Utilities released to the field with Toolkit"
^DIC(9.4,5,22,13,"PAH",9,1,21,0)="version 7.2.  The overall process consists of the search for potential"
^DIC(9.4,5,22,13,"PAH",9,1,22,0)="duplicate record pairs, review and verification of those pairs, and the"
^DIC(9.4,5,22,13,"PAH",9,1,23,0)="merge process.  The search and identification of potential duplicate"
^DIC(9.4,5,22,13,"PAH",9,1,24,0)="records performs comparisons on key fields in the PATIENT file.  (This is"
^DIC(9.4,5,22,13,"PAH",9,1,25,0)="a long process and can exceed 100 hours.)  When evaluated as a potential"
^DIC(9.4,5,22,13,"PAH",9,1,26,0)="duplicate, the pair is entered into file 15 (Duplicate Record File) and is"
^DIC(9.4,5,22,13,"PAH",9,1,27,0)="available for review and verification.  The review allows for two levels"
^DIC(9.4,5,22,13,"PAH",9,1,28,0)="of review; a primary reviewer - focussing on patient demographics - and an"
^DIC(9.4,5,22,13,"PAH",9,1,29,0)="ancillary reviewer - focussing on ancillary service data.  Once verified,"
^DIC(9.4,5,22,13,"PAH",9,1,30,0)="the merge process can be initiated.  (This is a long process and can"
^DIC(9.4,5,22,13,"PAH",9,1,31,0)="exceed 15 hours.)"
^DIC(9.4,5,22,13,"PAH",9,1,32,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,33,0)="Software and a complete set of documentation (Release Notes, Installation"
^DIC(9.4,5,22,13,"PAH",9,1,34,0)="Guide, User Manual, and Technical Manual) may be obtained using FTP from"
^DIC(9.4,5,22,13,"PAH",9,1,35,0)="the appropriate Customer Service directory:"
^DIC(9.4,5,22,13,"PAH",9,1,36,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,37,0)="       IRM FIELD OFFICE        FTP ADDRESS     DIRECTORY"
^DIC(9.4,5,22,13,"PAH",9,1,38,0)="       ============================================================="
^DIC(9.4,5,22,13,"PAH",9,1,39,0)="       ALBANY                  152.127.1.5     anonymous.software"
^DIC(9.4,5,22,13,"PAH",9,1,40,0)="       HINES                   152.129.1.110   anonymous.software"
^DIC(9.4,5,22,13,"PAH",9,1,41,0)="       SALT LAKE               152.131.2.1     anonymous.software"
^DIC(9.4,5,22,13,"PAH",9,1,42,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,43,0)="Release Notes file name:       xt_73_p23_rn.pdf"
^DIC(9.4,5,22,13,"PAH",9,1,44,0)="Installation Guide file name:  xt_73_p23_ig.pdf"
^DIC(9.4,5,22,13,"PAH",9,1,45,0)="User Manual file name:         xt_73_p23_um.pdf"
^DIC(9.4,5,22,13,"PAH",9,1,46,0)="Technical Manual file name:    xt_73_p23_tm.pdf"
^DIC(9.4,5,22,13,"PAH",9,1,47,0)="Software file name:    XT73_23.KID"
^DIC(9.4,5,22,13,"PAH",9,1,48,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,49,0)="File Information:"
^DIC(9.4,5,22,13,"PAH",9,1,50,0)="============"
^DIC(9.4,5,22,13,"PAH",9,1,51,0)="This patch contains three new files and changes to the existing files."
^DIC(9.4,5,22,13,"PAH",9,1,52,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,53,0)="DUPLICATE RECORD       ^VA(15,"
^DIC(9.4,5,22,13,"PAH",9,1,54,0)="This file contains information about duplicate records in any file defined"
^DIC(9.4,5,22,13,"PAH",9,1,55,0)="in the two variable pointer fields; RECORD1 and RECORD2 (.01 and .02)."
^DIC(9.4,5,22,13,"PAH",9,1,56,0)="The status of an entry in this file may be 'potential duplicate,"
^DIC(9.4,5,22,13,"PAH",9,1,57,0)="unverified', 'verified, not a duplicate', or 'verified duplicate'."
^DIC(9.4,5,22,13,"PAH",9,1,58,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,59,0)="DUPLICATE RESOLUTION   ^VA(15.1,"
^DIC(9.4,5,22,13,"PAH",9,1,60,0)="This file is used to handle duplicate checking and merging of files that"
^DIC(9.4,5,22,13,"PAH",9,1,61,0)="have entries in the Duplicate Record File.  It is meant to provide the"
^DIC(9.4,5,22,13,"PAH",9,1,62,0)="overall control information that would be used to first identify"
^DIC(9.4,5,22,13,"PAH",9,1,63,0)="duplicates within a file, e.g. Patient File, and then to merge the"
^DIC(9.4,5,22,13,"PAH",9,1,64,0)="entries."
^DIC(9.4,5,22,13,"PAH",9,1,65,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,66,0)="XDR MERGE PROCESS      ^VA(15.2,       New file."
^DIC(9.4,5,22,13,"PAH",9,1,67,0)="When a merge process is set up, all its information is stored in this"
^DIC(9.4,5,22,13,"PAH",9,1,68,0)="file.  Once a merge process has completed, that entry may be purged using"
^DIC(9.4,5,22,13,"PAH",9,1,69,0)="the Purge Merge Process File option in the managers menu."
^DIC(9.4,5,22,13,"PAH",9,1,70,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,71,0)="XDR REPOINTED ENTRY    ^VA(15.3,       New file."
^DIC(9.4,5,22,13,"PAH",9,1,72,0)="This file is used to record the entry number of the FROM record that is"
^DIC(9.4,5,22,13,"PAH",9,1,73,0)="merged into the TO record.  This can be used for FileMan to determine"
^DIC(9.4,5,22,13,"PAH",9,1,74,0)="which entries were merged, so the IEN of the FROM record will not be"
^DIC(9.4,5,22,13,"PAH",9,1,75,0)="reused."
^DIC(9.4,5,22,13,"PAH",9,1,76,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,77,0)="MERGE IMAGES           ^XDRM           New file."
^DIC(9.4,5,22,13,"PAH",9,1,78,0)="File 15.4 stores an image of the pairs of entries in files that were"
^DIC(9.4,5,22,13,"PAH",9,1,79,0)="merged immediately prior to the actual merge.  In addition, there is also"
^DIC(9.4,5,22,13,"PAH",9,1,80,0)="a record of the locations of pointer values that were changed during the"
^DIC(9.4,5,22,13,"PAH",9,1,81,0)="merge process."
^DIC(9.4,5,22,13,"PAH",9,1,82,0)=" "
^DIC(9.4,5,22,13,"PAH",9,1,83,0)="Option Information:"
^DIC(9.4,5,22,13,"PAH",9,1,84,0)="==============="
^DIC(9.4,5,22,13,"PAH",9,1,85,0)="This patch contains 27 options:"
^DIC(9.4,5,22,13,"PAH",9,1,86,0)="XDR ADD VERIFIED DUPS"
^DIC(9.4,5,22,13,"PAH",9,1,87,0)="XDR ANCILLARY REVIEW"
^DIC(9.4,5,22,13,"PAH",9,1,88,0)="XDR APPROVE FOR MERGE"
^DIC(9.4,5,22,13,"PAH",9,1,89,0)="XDR CHECK MERGE PROCESS STATUS"
^DIC(9.4,5,22,13,"PAH",9,1,90,0)="XDR CHECK PAIR"
^DIC(9.4,5,22,13,"PAH",9,1,91,0)="XDR DISPLAY SEARCH STATUS"
^DIC(9.4,5,22,13,"PAH",9,1,92,0)="XDR EDIT DUP RECORD STATUS"
^DIC(9.4,5,22,13,"PAH",9,1,93,0)="XDR EDIT DUP RESOLUTION FILE"
^DIC(9.4,5,22,13,"PAH",9,1,94,0)="XDR FIND POTENTIAL DUPLICATES"
^DIC(9.4,5,22,13,"PAH",9,1,95,0)="XDR MAIN MENU  (Locked with XDR key)"
^DIC(9.4,5,22,13,"PAH",9,1,96,0)="XDR MANAGER UTILITIES  (Locked with XDRMGR key)"
^DIC(9.4,5,22,13,"PAH",9,1,97,0)="XDR MERGE READY DUPLICATES"
^DIC(9.4,5,22,13,"PAH",9,1,98,0)="XDR OPERATIONS MENU"
^DIC(9.4,5,22,13,"PAH",9,1,99,0)="XDR PRELIMINARY SCAN"
^DIC(9.4,5,22,13,"PAH",9,1,100,0)="XDR PRELIMINARY SCAN LIST"
^DIC(9.4,5,22,13,"PAH",9,1,101,0)="XDR PRINT LIST"
^DIC(9.4,5,22,13,"PAH",9,1,102,0)="XDR PURGE"
^DIC(9.4,5,22,13,"PAH",9,1,103,0)="XDR PURGE2"
