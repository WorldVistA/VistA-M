^DIC(9.4,14,22,5.9,"PAH",100,1,221,0)="     Select MAIL GROUP NAME: EPI"
^DIC(9.4,14,22,5.9,"PAH",100,1,222,0)="          1   EPI  "
^DIC(9.4,14,22,5.9,"PAH",100,1,223,0)="          2   EPI-REPORT  "
^DIC(9.4,14,22,5.9,"PAH",100,1,224,0)="     CHOOSE 1-2: 1  EPI"
^DIC(9.4,14,22,5.9,"PAH",100,1,225,0)="     Select REMOTE MEMBER: S.HL V16 SERVER@DEV// XXX@Q-EPI.DOMAIN.EXT"
^DIC(9.4,14,22,5.9,"PAH",100,1,226,0)="       Are you adding 'XXX@Q-EPI.DOMAIN.EXT' as a new REMOTE MEMBER (the"
^DIC(9.4,14,22,5.9,"PAH",100,1,227,0)="     2ND for this MAIL GROUP)? No// Y"
^DIC(9.4,14,22,5.9,"PAH",100,1,228,0)="       (Yes)"
