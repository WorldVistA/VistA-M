^DIC(9.4,5,22,13,"PAH",29,1,3,0)="                Fixed to check that each routine exisits first."
^DIC(9.4,5,22,13,"PAH",29,1,4,0)="                "
^DIC(9.4,5,22,13,"PAH",29,1,5,0)="TAM-0599-32232  XINDX9  Fixed to correctly ID this bad code."
^DIC(9.4,5,22,13,"PAH",29,1,6,0)="WPB-0498-32337"
