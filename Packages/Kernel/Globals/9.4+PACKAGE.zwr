^DIC(9.4,14,22,5.9,"PAH",179,1,144,0)=""
^DIC(9.4,14,22,5.9,"PAH",179,1,145,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,146,0)="ROUTINE SUMMARY"
^DIC(9.4,14,22,5.9,"PAH",179,1,147,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",179,1,148,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",179,1,149,0)="  of each of these routines now looks like:"
^DIC(9.4,14,22,5.9,"PAH",179,1,150,0)="  <tab> ;;5.2;LAB SERVICE;<patchlist>;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",179,1,151,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,152,0)="                    Checksum       Checksum"
^DIC(9.4,14,22,5.9,"PAH",179,1,153,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,14,22,5.9,"PAH",179,1,154,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,14,22,5.9,"PAH",179,1,155,0)="   LR329            N/A            5595661        **329** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",179,1,156,0)="   LROC             9241387        7783203        **121,295,329**"
^DIC(9.4,14,22,5.9,"PAH",179,1,157,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,158,0)=" List of preceding patches: 295"
^DIC(9.4,14,22,5.9,"PAH",179,1,159,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",179,1,160,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,161,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,162,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",179,1,163,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",179,1,164,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",179,1,165,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",179,1,166,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",179,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,168,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,169,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",179,1,170,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",179,1,171,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,172,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",179,1,173,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",179,1,174,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,175,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,176,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",179,1,177,0)="        option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",179,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,179,0)="  2.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",179,1,180,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",179,1,181,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,182,0)="  3.  From this menu, you may then elect to use the following options"
^DIC(9.4,14,22,5.9,"PAH",179,1,183,0)="      (when prompted for the INSTALL NAME, enter LR*5.2*329):"
^DIC(9.4,14,22,5.9,"PAH",179,1,184,0)="        a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",179,1,185,0)="        b. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",179,1,186,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",179,1,187,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",179,1,188,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,189,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",179,1,190,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",179,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,192,0)="  4.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",179,1,193,0)="      and select the package 'LR*5.2*329'."
^DIC(9.4,14,22,5.9,"PAH",179,1,194,0)=""
^DIC(9.4,14,22,5.9,"PAH",179,1,195,0)="      When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",179,1,196,0)="      Install? YES//' choose 'NO'. Responding 'Yes' to the prompt for "
^DIC(9.4,14,22,5.9,"PAH",179,1,197,0)="      rebuilding menu trees can significantly increase install time."
^DIC(9.4,14,22,5.9,"PAH",179,1,198,0)=""
^DIC(9.4,14,22,5.9,"PAH",179,1,199,0)="      When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//"
^DIC(9.4,14,22,5.9,"PAH",179,1,200,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",179,1,201,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,202,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,14,22,5.9,"PAH",179,1,203,0)="      and Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",179,1,204,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,205,0)="      During install KIDS will place the Purge old orders & accessions"
^DIC(9.4,14,22,5.9,"PAH",179,1,206,0)="      option [LROC] out of order."
^DIC(9.4,14,22,5.9,"PAH",179,1,207,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,208,0)=" Note: Routine LR329 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",179,1,209,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,210,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,211,0)="INSTALLATION EXAMPLE"
^DIC(9.4,14,22,5.9,"PAH",179,1,212,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",179,1,213,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,214,0)="Select Installation Option:"
^DIC(9.4,14,22,5.9,"PAH",179,1,215,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,216,0)="Select Kernel Installation & Distribution System Option:  Installation"
^DIC(9.4,14,22,5.9,"PAH",179,1,217,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,218,0)="Select Installation Option: 6  Install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",179,1,219,0)="Select INSTALL NAME: LR*5.2*329  Loaded from Distribution  4/11/05@16:15:44"
^DIC(9.4,14,22,5.9,"PAH",179,1,220,0)="     => LR*5.2*329"
^DIC(9.4,14,22,5.9,"PAH",179,1,221,0)=" "
^DIC(9.4,14,22,5.9,"PAH",179,1,222,0)="This Distribution was loaded on Apr 11, 2005@16:15:44 with header of"
^DIC(9.4,14,22,5.9,"PAH",179,1,223,0)="   LR*5.2*329"
^DIC(9.4,14,22,5.9,"PAH",179,1,224,0)="   It consisted of the following Install(s):"
^DIC(9.4,14,22,5.9,"PAH",179,1,225,0)="     LR*5.2*329"
^DIC(9.4,14,22,5.9,"PAH",179,1,226,0)="Checking Install for Package LR*5.2*329"
^DIC(9.4,14,22,5.9,"PAH",179,1,227,0)="Will first run the Environment Check Routine, LR329"
^DIC(9.4,14,22,5.9,"PAH",179,1,228,0)=" "
