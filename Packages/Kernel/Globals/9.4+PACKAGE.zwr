^DIC(9.4,14,22,5.9,"PAH",127,0)="300 SEQ #225^3030204^1"
^DIC(9.4,14,22,5.9,"PAH",127,1,0)="^^224^224^3030204"
^DIC(9.4,14,22,5.9,"PAH",127,1,1,0)="VISTA Laboratory Package patch LR*5.2*300 contains no changes to software"
^DIC(9.4,14,22,5.9,"PAH",127,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,14,22,5.9,"PAH",127,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,4,0)="Patch LR*5.2*300 corrects the following defects:"
^DIC(9.4,14,22,5.9,"PAH",127,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,6,0)="1. NOIS BAY-1202-31189, PRO-1202-11453, SFC-1202-61678 reported an"
^DIC(9.4,14,22,5.9,"PAH",127,1,7,0)="undefined variable LRPRTPG in routine LRRP2 when printing laboratory"
^DIC(9.4,14,22,5.9,"PAH",127,1,8,0)="interim reports via CPRS. The variable LRPRTPG is now defined when a"
^DIC(9.4,14,22,5.9,"PAH",127,1,9,0)="user selects to print interim reports via CPRS."
^DIC(9.4,14,22,5.9,"PAH",127,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,11,0)="2. NOIS MAN-1202-11246, PHI-1202-21644 reported an undefined variable"
^DIC(9.4,14,22,5.9,"PAH",127,1,12,0)="PNM in routine LRRP2 when printing laboratory cumulative reports via"
^DIC(9.4,14,22,5.9,"PAH",127,1,13,0)="option TASK THE CUMULATIVE TO RUN EACH NITE [LRTASK CUM]. The undefined"
^DIC(9.4,14,22,5.9,"PAH",127,1,14,0)="variable is caused by the software attempting to print the list of"
^DIC(9.4,14,22,5.9,"PAH",127,1,15,0)="performing laboratories after the reports had completed. The logic has"
^DIC(9.4,14,22,5.9,"PAH",127,1,16,0)="been corrected to print the list with each interim report."
^DIC(9.4,14,22,5.9,"PAH",127,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,18,0)="3. NOIS SFC-1202-61678 reported an undefined variable LRIDT in routine"
^DIC(9.4,14,22,5.9,"PAH",127,1,19,0)="LRRP2 when printing interim reports via option Interim Report [LRRP2]."
^DIC(9.4,14,22,5.9,"PAH",127,1,20,0)="The undefined variable is caused by the user aborting printing when"
^DIC(9.4,14,22,5.9,"PAH",127,1,21,0)="selecting starting and ending date ranges for the report. The software"
^DIC(9.4,14,22,5.9,"PAH",127,1,22,0)="was not detecting user aborting. The logic has been corrected to return"
^DIC(9.4,14,22,5.9,"PAH",127,1,23,0)="the user to the select patient prompt when aborting from date range"
^DIC(9.4,14,22,5.9,"PAH",127,1,24,0)="selection."
^DIC(9.4,14,22,5.9,"PAH",127,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",127,1,26,0)="  "
^DIC(9.4,14,22,5.9,"PAH",127,1,27,0)="ASSOCIATED NOIS"
^DIC(9.4,14,22,5.9,"PAH",127,1,28,0)="---------------"
