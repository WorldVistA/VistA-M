^DIC(9.4,100,22,15,"PAH",45,1,73,0)="   ================"
^DIC(9.4,100,22,15,"PAH",45,1,74,0)="   The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",45,1,75,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,76,0)="   <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",45,1,77,0)=" "
