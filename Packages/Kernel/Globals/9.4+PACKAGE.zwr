^DIC(9.4,14,22,5.9,"PAH",213,1,297,0)=" Install Questions for LR*5.2*315"
^DIC(9.4,14,22,5.9,"PAH",213,1,298,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,299,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,300,0)=" "
^DIC(9.4,14,22,5.9,"PAH",213,1,301,0)=" Want KIDS to INHIBIT LOGONs during the install? NO// "
