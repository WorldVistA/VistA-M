^DIC(9.4,4,22,1,"PAH",78,0)="106 SEQ #103^2991123^1"
^DIC(9.4,4,22,1,"PAH",78,1,0)="^^75^75^2991123"
^DIC(9.4,4,22,1,"PAH",78,1,1,0)="Patch XM*7.1*106"
^DIC(9.4,4,22,1,"PAH",78,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,3,0)="Y2K Waiver Exemption ID: Y2KWE0010"
^DIC(9.4,4,22,1,"PAH",78,1,4,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,5,0)="NOIS:  IVM-1099-31783, IVM-1099-33078"
^DIC(9.4,4,22,1,"PAH",78,1,6,0)="Test Site:  HEC, Atlanta, GA"
^DIC(9.4,4,22,1,"PAH",78,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,8,0)="There seems to be a problem with getting a lock sometimes, when attempting to"
^DIC(9.4,4,22,1,"PAH",78,1,9,0)="file a message into or delete a message from a basket.  This patch removes"
^DIC(9.4,4,22,1,"PAH",78,1,10,0)="MailMan's locks, and lets FileMan handle the locking.  If FileMan can't get"
^DIC(9.4,4,22,1,"PAH",78,1,11,0)="the lock, MailMan will keep calling Fileman until FileMan succeeds."
^DIC(9.4,4,22,1,"PAH",78,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,13,0)="Also in this patch:"
^DIC(9.4,4,22,1,"PAH",78,1,14,0)="^XMXBSKT  - When resequencing messages in a basket, use local create date."
^DIC(9.4,4,22,1,"PAH",78,1,15,0)="^XMXSEND  - Additional code to ensure message recycling functions correctly."
^DIC(9.4,4,22,1,"PAH",78,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,17,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",78,1,18,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",78,1,19,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",78,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,21,0)="ROUTINES:"
