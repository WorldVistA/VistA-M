^DIC(9.4,14,22,5.9,"PAH",97,1,427,0)="                 Relinking NATIONAL VA LAB CODES TO WKLD CODE"
^DIC(9.4,14,22,5.9,"PAH",97,1,428,0)="                                   LR*5.2*243"
^DIC(9.4,14,22,5.9,"PAH",97,1,429,0)=" "
^DIC(9.4,14,22,5.9,"PAH",97,1,430,0)=" "
