^DIC(9.4,13,22,7,"PAH",31,1,83,0)="Clarksburg, WV"
^DIC(9.4,13,22,7,"PAH",31,1,84,0)="CIOFO-Birmingham "
^DIC(9.4,13,22,7,"PAH",31,1,85,0)=" "
^DIC(9.4,13,22,7,"PAH",31,1,86,0)="Routine Summary: "
^DIC(9.4,13,22,7,"PAH",31,1,87,0)="================"
