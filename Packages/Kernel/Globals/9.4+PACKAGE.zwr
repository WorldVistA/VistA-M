^DIC(9.4,96,22,1.2,"PAH",36,1,1,0)=" General Information"
^DIC(9.4,96,22,1.2,"PAH",36,1,2,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",36,1,3,0)=" This patch contains fixes and enhancements to Dental Record Manager "
^DIC(9.4,96,22,1.2,"PAH",36,1,4,0)=" Plus primarily in the area of note generation and the Cover page plus"
^DIC(9.4,96,22,1.2,"PAH",36,1,5,0)=" an easy to recognize flag when a patient has a pending consult.  VA "
^DIC(9.4,96,22,1.2,"PAH",36,1,6,0)=" requirements to default Combat Veteran status if appropriate and to "
^DIC(9.4,96,22,1.2,"PAH",36,1,7,0)=" change the service connected EC flag to SWAC have been included."
^DIC(9.4,96,22,1.2,"PAH",36,1,8,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,9,0)="(T-4 build revisions)"
^DIC(9.4,96,22,1.2,"PAH",36,1,10,0)=" An undefined error was discovered in Clarksberg where the variable DFN"
^DIC(9.4,96,22,1.2,"PAH",36,1,11,0)="(Patient IEN was undefined),and the variable VAIP(""D"") was not set to a"
^DIC(9.4,96,22,1.2,"PAH",36,1,12,0)="date (FM format) from the .01 field of file #9000010. Routine DENTVTP2 was"
^DIC(9.4,96,22,1.2,"PAH",36,1,13,0)="revised appropriately."
^DIC(9.4,96,22,1.2,"PAH",36,1,14,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,15,0)="(T-5 build revisions)"
^DIC(9.4,96,22,1.2,"PAH",36,1,16,0)="Recent Dental Activity on GUI Cover Page not filing last known dates "
^DIC(9.4,96,22,1.2,"PAH",36,1,17,0)="correctly.  Pointer set to a date instead of an ien.  Now points to "
^DIC(9.4,96,22,1.2,"PAH",36,1,18,0)="the ien.age"
^DIC(9.4,96,22,1.2,"PAH",36,1,19,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,20,0)=" There is no NSR associated with this patch."
^DIC(9.4,96,22,1.2,"PAH",36,1,21,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,22,0)=" This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,96,22,1.2,"PAH",36,1,23,0)=" ----------------------------------------------------"
^DIC(9.4,96,22,1.2,"PAH",36,1,24,0)=" Oklahoma City  HD242867 - The current perio chart is not being brought "
^DIC(9.4,96,22,1.2,"PAH",36,1,25,0)=" into the signature page."
^DIC(9.4,96,22,1.2,"PAH",36,1,26,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,27,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,28,0)=" The following is a list of files included in this patch:"
^DIC(9.4,96,22,1.2,"PAH",36,1,29,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,30,0)="                                      UP    SEND  DATA                "
^DIC(9.4,96,22,1.2,"PAH",36,1,31,0)="                                      DATE  SEC.  COMES  SITE   RSLV  "
^DIC(9.4,96,22,1.2,"PAH",36,1,32,0)=" FILE #  NAME                         DD    CODE  W/FILE DATA   PTS "
^DIC(9.4,96,22,1.2,"PAH",36,1,33,0)=" --------------------------------------------------------------------"
^DIC(9.4,96,22,1.2,"PAH",36,1,34,0)=" 228.8       DENTAL CODING CHECKS     YES   YES   YES    OVER   NO  "
^DIC(9.4,96,22,1.2,"PAH",36,1,35,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,36,0)=" "
^DIC(9.4,96,22,1.2,"PAH",36,1,37,0)=" The following is a list of fields included in this patch:"
