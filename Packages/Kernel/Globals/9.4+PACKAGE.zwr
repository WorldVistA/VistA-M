^DIC(9.4,48,22,5.28,"PAH",675,0)="882 SEQ #734^3240930.175257^89"
^DIC(9.4,48,22,5.28,"PAH",675,1,0)="^^6^6^3240930"
^DIC(9.4,48,22,5.28,"PAH",675,1,1,0)="This patch fixes an issue that causes an error in the VistA error trap"
^DIC(9.4,48,22,5.28,"PAH",675,1,2,0)="when an appointment for a consult can't be made because the consult status"
^DIC(9.4,48,22,5.28,"PAH",675,1,3,0)="is not either active or pending. The appointment is rejected and an HL7 "
^DIC(9.4,48,22,5.28,"PAH",675,1,4,0)="NAK message is returned to HSRM, but then the code doesn't quit as it"
^DIC(9.4,48,22,5.28,"PAH",675,1,5,0)="should. As a result, the code continues into a block of code that should"
^DIC(9.4,48,22,5.28,"PAH",675,1,6,0)="Jnot run and that code results in the error: <UNDEFINED>MAKE+39^SDCCRSEN1"
^DIC(9.4,48,22,5.28,"PAH",676,0)="887 SEQ #735^3240930.175336^89"
^DIC(9.4,48,22,5.28,"PAH",676,1,0)="^^60^60^3240930"
