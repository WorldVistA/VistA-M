^DIC(9.4,48,22,5.28,"PAH",132,1,1,0)="CLINIC LIST OPTION CREATES AN ILLEGAL NUMBER ERROR"
^DIC(9.4,48,22,5.28,"PAH",133,0)="150^2990602^1"
^DIC(9.4,48,22,5.28,"PAH",133,1,0)="^^7^7^2990602"
^DIC(9.4,48,22,5.28,"PAH",133,1,1,0)="VHA Directive 98-058, ""Sexual Trauma Counseling Care and Services"""
^DIC(9.4,48,22,5.28,"PAH",133,1,2,0)="requires that VHA provide care and counseling to veterans determined to"
^DIC(9.4,48,22,5.28,"PAH",133,1,3,0)="have been a victim of sexual trauma while the veteran was serving on"
^DIC(9.4,48,22,5.28,"PAH",133,1,4,0)="active duty.  This patch will focus on the data collection for this"
^DIC(9.4,48,22,5.28,"PAH",133,1,5,0)="directive."
^DIC(9.4,48,22,5.28,"PAH",133,1,6,0)=" "
^DIC(9.4,48,22,5.28,"PAH",133,1,7,0)="This is the Scheduling portion of the patch.  See REGISTRATION DG*5.3*195"
^DIC(9.4,48,22,5.28,"PAH",134,0)="192 SEQ #172^2990622^1"
^DIC(9.4,48,22,5.28,"PAH",134,1,0)="^^1^1^2990622"
^DIC(9.4,48,22,5.28,"PAH",134,1,1,0)="'Clinic Waiting Time' extract"
^DIC(9.4,48,22,5.28,"PAH",135,0)="194 SEQ #173^2990626^1"
^DIC(9.4,48,22,5.28,"PAH",135,1,0)="^^1^1^2990626"
^DIC(9.4,48,22,5.28,"PAH",135,1,1,0)="ACRP report issues"
^DIC(9.4,48,22,5.28,"PAH",136,0)="179 SEQ #174^2990626^1"
^DIC(9.4,48,22,5.28,"PAH",136,1,0)="^^7^7^2990626"
^DIC(9.4,48,22,5.28,"PAH",136,1,1,0)="This patch address NOIS OKL-1098-72014. It corrects a possible error"
^DIC(9.4,48,22,5.28,"PAH",136,1,2,0)="in the Clinic Next Available Appt. Monitoring Report [SDOQM CLINIC"
^DIC(9.4,48,22,5.28,"PAH",136,1,3,0)="NEXT AVAIL REPORT]. This error would occur if the clinic"
^DIC(9.4,48,22,5.28,"PAH",136,1,4,0)="availability grid is not current for the selected clinic."
^DIC(9.4,48,22,5.28,"PAH",136,1,5,0)="The change in the routine remaps the clinic availability grids used"
^DIC(9.4,48,22,5.28,"PAH",136,1,6,0)="in the report if they are not present. Clinic Next Available Appointment"
^DIC(9.4,48,22,5.28,"PAH",136,1,7,0)="Monitoring Report correction."
^DIC(9.4,48,22,5.28,"PAH",137,0)="195 SEQ #175^2990803^1"
^DIC(9.4,48,22,5.28,"PAH",137,1,0)="^^6^6^2990803"
^DIC(9.4,48,22,5.28,"PAH",137,1,1,0)=" "
^DIC(9.4,48,22,5.28,"PAH",137,1,2,0)="This patch contains tools to help the user evaluate and convert PC Attending"
^DIC(9.4,48,22,5.28,"PAH",137,1,3,0)="assignments to PC Practitioner assignments.  It also provides a report to"
^DIC(9.4,48,22,5.28,"PAH",137,1,4,0)="evaluate the existing preceptor relationship.  These relationships will be"
^DIC(9.4,48,22,5.28,"PAH",137,1,5,0)="compared to the new business rules for Primary Care provider and Associate"
^DIC(9.4,48,22,5.28,"PAH",137,1,6,0)="Provider."
^DIC(9.4,48,22,5.28,"PAH",138,0)="198 SEQ #176^2990914^1"
^DIC(9.4,48,22,5.28,"PAH",138,1,0)="^^1^1^2990914"
^DIC(9.4,48,22,5.28,"PAH",138,1,1,0)="Modify Workload Closeout dates for FY2000 and Re-flag unsent NPCDB activity"
^DIC(9.4,48,22,5.28,"PAH",139,0)="200 SEQ #178^2991002^1"
^DIC(9.4,48,22,5.28,"PAH",139,1,0)="^^1^1^2991002"
^DIC(9.4,48,22,5.28,"PAH",139,1,1,0)="Mark unsent FY1999 Q1 & Q2 NPCDB activity for transmission"
^DIC(9.4,48,22,5.28,"PAH",140,0)="203 SEQ #179^2991003^1"
^DIC(9.4,48,22,5.28,"PAH",140,1,0)="^^1^1^2991003"
^DIC(9.4,48,22,5.28,"PAH",140,1,1,0)="See patch SD*5.3*203 in the NPM for complete information on this patch."
^DIC(9.4,48,22,5.28,"PAH",141,0)="177^2991003^1"
^DIC(9.4,48,22,5.28,"PAH",141,1,0)="^^1^1^2991003"
^DIC(9.4,48,22,5.28,"PAH",141,1,1,0)="This build contains changes to the PCMM software for patch SD*5.3*177."
^DIC(9.4,48,22,5.28,"PAH",142,0)="170 SEQ #181^2991003^1"
^DIC(9.4,48,22,5.28,"PAH",142,1,0)="^^1^1^2991003"
^DIC(9.4,48,22,5.28,"PAH",142,1,1,0)="Routine SDLTP Incorrectly setting FileMan Variable"
^DIC(9.4,48,22,5.28,"PAH",143,0)="205^2991123^1"
^DIC(9.4,48,22,5.28,"PAH",143,1,0)="^^36^36^2991123"
^DIC(9.4,48,22,5.28,"PAH",143,1,1,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,2,0)="Description:"
^DIC(9.4,48,22,5.28,"PAH",143,1,3,0)="==========="
^DIC(9.4,48,22,5.28,"PAH",143,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,5,0)="This patch is an emergency patch to address critical issues.  It does not"
^DIC(9.4,48,22,5.28,"PAH",143,1,6,0)="require a waiver."
^DIC(9.4,48,22,5.28,"PAH",143,1,7,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,8,0)="1.  Since loading Fileman 22, some sites are not able to lookup patients"
^DIC(9.4,48,22,5.28,"PAH",143,1,9,0)="using the Patient Assignment form in the PCMM client; the lookup returns"
^DIC(9.4,48,22,5.28,"PAH",143,1,10,0)="no patients if it encounters an irregular data dictionary while building"
^DIC(9.4,48,22,5.28,"PAH",143,1,11,0)="the list.  This patch restricts the cross-references the underlying"
^DIC(9.4,48,22,5.28,"PAH",143,1,12,0)="Fileman lookup will use to avoid potential irregularities."
^DIC(9.4,48,22,5.28,"PAH",143,1,13,0)="[NOIS: MRN-1099-40037, STL-0999-42707, ANC-0999-52492, WAS-0999-21980,"
^DIC(9.4,48,22,5.28,"PAH",143,1,14,0)="SDC-0999-61114, LOM-0999-60895, REN-1099-60336]"
^DIC(9.4,48,22,5.28,"PAH",143,1,15,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,16,0)="2.  The KIDS build for this patch re-exports DG*5.3*239, a patch which"
^DIC(9.4,48,22,5.28,"PAH",143,1,17,0)="was included in the SD*5.3*177 KIDS build, but without instructions to"
^DIC(9.4,48,22,5.28,"PAH",143,1,18,0)="update national package tracking.  DG*5.3*239 is included in this build,"
^DIC(9.4,48,22,5.28,"PAH",143,1,19,0)="without modification, except KIDS will perform the update which was"
^DIC(9.4,48,22,5.28,"PAH",143,1,20,0)="missed."
^DIC(9.4,48,22,5.28,"PAH",143,1,21,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,22,0)="3.  GUI Multiple Assignment StringList(0) error.  Server code in"
^DIC(9.4,48,22,5.28,"PAH",143,1,23,0)="SD*5.3*177 introduced an error which caused most client users to receive a"
^DIC(9.4,48,22,5.28,"PAH",143,1,24,0)="StringList error when attempting Patient Multiple Assignments.  The"
^DIC(9.4,48,22,5.28,"PAH",143,1,25,0)="erroneous code has been removed.  [NOIS: PUG-1099-50905, SDC-1099-61954,"
^DIC(9.4,48,22,5.28,"PAH",143,1,26,0)="SUX-1099-41704, BIR-1099-31652, FTL-1099-52214, NCH-1099-42392]"
^DIC(9.4,48,22,5.28,"PAH",143,1,27,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,28,0)="4.  Client/server synchronization verification [RPC: SCMC VERIFY C/S"
^DIC(9.4,48,22,5.28,"PAH",143,1,29,0)="SYNC], which was enforced with SD*5.3*177, was creating unnecessary"
^DIC(9.4,48,22,5.28,"PAH",143,1,30,0)="entries in files 404.45 and 404.46.  Extraneous entries will be removed."
^DIC(9.4,48,22,5.28,"PAH",143,1,31,0)="The RPC will be adjusted to avoid creating future extraneous entries.  "
^DIC(9.4,48,22,5.28,"PAH",143,1,32,0)=" "
^DIC(9.4,48,22,5.28,"PAH",143,1,33,0)="5. If a patient death is entered through the option DEATH ENTRY, no PCMM"
^DIC(9.4,48,22,5.28,"PAH",143,1,34,0)="information is included in the PATIENT HAS EXPIRED mailman bulletin.  This"
^DIC(9.4,48,22,5.28,"PAH",143,1,35,0)="patch will include the information in the bulletin.  [NOIS:"
^DIC(9.4,48,22,5.28,"PAH",143,1,36,0)="BAY-0999-30405, DAN-0999-41617, CLL-1099-40444]"
^DIC(9.4,48,22,5.28,"PAH",144,0)="167 SEQ #183^2991123^1"
^DIC(9.4,48,22,5.28,"PAH",144,1,0)="^^2^2^2991123"
^DIC(9.4,48,22,5.28,"PAH",144,1,1,0)="This patch addresses a combination of different NOISes using the same"
^DIC(9.4,48,22,5.28,"PAH",144,1,2,0)="scheduling routines."
^DIC(9.4,48,22,5.28,"PAH",145,0)="206 SEQ #186^2991215^1"
^DIC(9.4,48,22,5.28,"PAH",145,1,0)="^^1^1^2991215"
^DIC(9.4,48,22,5.28,"PAH",145,1,1,0)="Next Available Appointment Wait Time"
^DIC(9.4,48,22,5.28,"PAH",146,0)="168 SEQ #187^3000125^1"
^DIC(9.4,48,22,5.28,"PAH",146,1,0)="^^1^1^3000125"
^DIC(9.4,48,22,5.28,"PAH",146,1,1,0)="Scheduling output issues"
^DIC(9.4,48,22,5.28,"PAH",147,0)="211^3000204^1"
^DIC(9.4,48,22,5.28,"PAH",147,1,0)="^^1^1^3000204"
^DIC(9.4,48,22,5.28,"PAH",147,1,1,0)="See the national patch module for details."
^DIC(9.4,48,22,5.28,"PAH",148,0)="209 SEQ #189^3000229^1"
^DIC(9.4,48,22,5.28,"PAH",148,1,0)="^^14^14^3000229"
^DIC(9.4,48,22,5.28,"PAH",148,1,1,0)="This build contains the changes necessary to perform three checks in the PCMM"
^DIC(9.4,48,22,5.28,"PAH",148,1,2,0)="GUI patient lookup."
^DIC(9.4,48,22,5.28,"PAH",148,1,3,0)=""
^DIC(9.4,48,22,5.28,"PAH",148,1,4,0)="PCMM GUI lookup will now check for the existance of patients with duplicate"
^DIC(9.4,48,22,5.28,"PAH",148,1,5,0)="last name and last four of their SSN.  A message dialog box will be displayed"
^DIC(9.4,48,22,5.28,"PAH",148,1,6,0)="if one is found."
^DIC(9.4,48,22,5.28,"PAH",148,1,7,0)=""
^DIC(9.4,48,22,5.28,"PAH",148,1,8,0)="After the selection of the patient PCMM will now check for the existance of"
^DIC(9.4,48,22,5.28,"PAH",148,1,9,0)="means test information.  If a means test is required a message dialog box will"
^DIC(9.4,48,22,5.28,"PAH",148,1,10,0)="be displayed."
^DIC(9.4,48,22,5.28,"PAH",148,1,11,0)=""
^DIC(9.4,48,22,5.28,"PAH",148,1,12,0)="During the patient lookup, when the list of patients is displayed for selection,"
^DIC(9.4,48,22,5.28,"PAH",148,1,13,0)="any patient that is an employee will have their SSN and date of birth screened."
^DIC(9.4,48,22,5.28,"PAH",148,1,14,0)="The word sensitive will replace the respective information."
