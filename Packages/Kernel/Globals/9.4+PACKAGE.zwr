^DIC(9.4,14,22,5.9,"PAH",226,1,76,0)="This patch addresses the following Patient Safety Issues (PSIs):"
^DIC(9.4,14,22,5.9,"PAH",226,1,77,0)="==============================================================="
^DIC(9.4,14,22,5.9,"PAH",226,1,78,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",226,1,79,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,80,0)="Data Dictionary Changes:"
^DIC(9.4,14,22,5.9,"PAH",226,1,81,0)="======================="
^DIC(9.4,14,22,5.9,"PAH",226,1,82,0)="This patch installs the following two new files:"
^DIC(9.4,14,22,5.9,"PAH",226,1,83,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,84,0)="HOWDY SITE FILE (#69.86): This file is used to run the Howdy software"
^DIC(9.4,14,22,5.9,"PAH",226,1,85,0)="and to reflect the site's business rules."
^DIC(9.4,14,22,5.9,"PAH",226,1,86,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,87,0)="FILE #   FIELD #    FIELD NAME                 NEW/MODIFIED item(s)"
^DIC(9.4,14,22,5.9,"PAH",226,1,88,0)="-------- ---------  -----------------          --------------------"
^DIC(9.4,14,22,5.9,"PAH",226,1,89,0)="69.86   .01         NAME                                NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,90,0)="        2           LAB TEST (TO EXCLUDE)               NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,91,0)="        4           COLLECTION SAMPLE (TO EXCLUDE)      NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,92,0)="        6           SITE SPECIMEN (TO EXCLUDE)          NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,93,0)="        8           COLLECTION TYPES (TO EXCLUDE)       NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,94,0)="        10          PRINTERS                            NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,95,0)="        11          ORDER LABEL ROUTINE                 NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,96,0)="        12          FW ORDER LABELS                     NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,97,0)="        16          EXCLUDE CLINICS                     NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,98,0)="        18          CHECK FOR FUTURE ORDERS             NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,99,0)="        20          CHECK FOR PAST ORDERS               NEW"
