^DIC(9.4,73,22,9,"PAH",15,1,80,0)="                        Of Order':   AFJXNHEX REQUEST"
^DIC(9.4,73,22,9,"PAH",15,1,81,0)="                                     ================"
^DIC(9.4,73,22,9,"PAH",15,1,82,0)=" "
