^DIC(9.4,14,22,5.9,"PAH",207,1,333,0)="VBEC PRE-CONVERSION UTILITIES  Utilities used prior to the data conversion"
^DIC(9.4,14,22,5.9,"PAH",207,1,334,0)="VBEC PRINT SQL/VISTA MATCHES   Matched Blood Bank data report"
^DIC(9.4,14,22,5.9,"PAH",207,1,335,0)="VBEC SITE PARAMETER ENTER/EDIT Enter/Edit Site Parameter Data "
^DIC(9.4,14,22,5.9,"PAH",207,1,336,0)="VBEC STANDARD ANTIBODIES       Standard Antigens and Antibodies Print"
^DIC(9.4,14,22,5.9,"PAH",207,1,337,0)="VBEC STANDARD TRANS. REACTIONS Standard Transfusion Reactions Print"
^DIC(9.4,14,22,5.9,"PAH",207,1,338,0)="VBEC TRANS. REACTION UTILITIES Utilities that manipulate Trans. Reaction "
^DIC(9.4,14,22,5.9,"PAH",207,1,339,0)="data"
^DIC(9.4,14,22,5.9,"PAH",207,1,340,0)="VBEC UNDO ANTIBODY/ANTIGEN     Undo all antibody/antigen matches"
