^DIC(9.4,108,22,0)="^9.49I^6^1"
^DIC(9.4,108,22,2,0)="2.0^3051119^2960822"
^DIC(9.4,108,22,2,"PAH",0)="^9.4901^3^3"
^DIC(9.4,108,22,2,"PAH",1,0)="5^2960822^1"
^DIC(9.4,108,22,2,"PAH",1,1,0)="^^46^46^2960822"
^DIC(9.4,108,22,2,"PAH",1,1,1,0)="Patch 5 provides the following:"
^DIC(9.4,108,22,2,"PAH",1,1,2,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,3,0)="Routine:   NOIS:             Fix:"
^DIC(9.4,108,22,2,"PAH",1,1,4,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,5,0)="QAPCOPY    DAY-0496-41627    Recreate 'AB' (full file) index on field"
^DIC(9.4,108,22,2,"PAH",1,1,6,0)="                             within multiple (authorized editors). Failure"
^DIC(9.4,108,22,2,"PAH",1,1,7,0)="                             to recreate 'AB' index prevented authorized"
^DIC(9.4,108,22,2,"PAH",1,1,8,0)="                             editors from editing the copied survey."
^DIC(9.4,108,22,2,"PAH",1,1,9,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,10,0)="QAPPTUSR   LEX-1195-42218    Prevent users from printing hard copy of"
^DIC(9.4,108,22,2,"PAH",1,1,11,0)="                             surveys while the survey is still under"
^DIC(9.4,108,22,2,"PAH",1,1,12,0)="                             development."
^DIC(9.4,108,22,2,"PAH",1,1,13,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,14,0)="QAPSCRN1   DAY-0496-40265    Eliminate undefined variable QAPCNT that"
^DIC(9.4,108,22,2,"PAH",1,1,15,0)="                             occurred at SUSPEND^QAPSCRN1 when the user"
^DIC(9.4,108,22,2,"PAH",1,1,16,0)="                             timed out on the first question in the"
^DIC(9.4,108,22,2,"PAH",1,1,17,0)="                             survey."
^DIC(9.4,108,22,2,"PAH",1,1,18,0)="QAPUTIL2   ----              TRAP^QAPUTIL2 errored with UNDEFined"
^DIC(9.4,108,22,2,"PAH",1,1,19,0)="                             variable, FILEDA, when testing UNDEFined"
^DIC(9.4,108,22,2,"PAH",1,1,20,0)="                             variable, QAPCNT, error in QAPSCRN1."
^DIC(9.4,108,22,2,"PAH",1,1,21,0)="   "
^DIC(9.4,108,22,2,"PAH",1,1,22,0)="New Checksums:"
^DIC(9.4,108,22,2,"PAH",1,1,23,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,24,0)="QAPCOPY   value = 8115210"
^DIC(9.4,108,22,2,"PAH",1,1,25,0)="QAPPTUSR  value = 6033850"
^DIC(9.4,108,22,2,"PAH",1,1,26,0)="QAPSCRN1  value = 19389275"
^DIC(9.4,108,22,2,"PAH",1,1,27,0)="QAPUTIL2  value = 13751688"
^DIC(9.4,108,22,2,"PAH",1,1,28,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,29,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,30,0)="Requirements:  "
^DIC(9.4,108,22,2,"PAH",1,1,31,0)="  "
^DIC(9.4,108,22,2,"PAH",1,1,32,0)="There are no special requirements for installation. However, it is"
^DIC(9.4,108,22,2,"PAH",1,1,33,0)="recommended that options QAP PARTICIPANT MENU and QAP SURVEY "
^DIC(9.4,108,22,2,"PAH",1,1,34,0)="MANAGEMENT MENU be disabled for the few moments needed to run"
^DIC(9.4,108,22,2,"PAH",1,1,35,0)="the KIDS install of this distribution."
^DIC(9.4,108,22,2,"PAH",1,1,36,0)=" "
^DIC(9.4,108,22,2,"PAH",1,1,37,0)=" "
^DIC(9.4,108,22,2,"PAH",1,1,38,0)="User Impact:"
^DIC(9.4,108,22,2,"PAH",1,1,39,0)=" "
^DIC(9.4,108,22,2,"PAH",1,1,40,0)="Users may be affected if they are in the process of responding to a survey"
^DIC(9.4,108,22,2,"PAH",1,1,41,0)="or printing hard copy or copying a survey. The impact is from the old"
^DIC(9.4,108,22,2,"PAH",1,1,42,0)="version of the routine not being found since the new version is now"
^DIC(9.4,108,22,2,"PAH",1,1,43,0)="present (after the users process looked up the old version directory"
^DIC(9.4,108,22,2,"PAH",1,1,44,0)="location).  The likelihood of this occurrance is quite small.  The user"
^DIC(9.4,108,22,2,"PAH",1,1,45,0)="will need to restart their survey and should be able to pick up where they"
^DIC(9.4,108,22,2,"PAH",1,1,46,0)="left off."
^DIC(9.4,108,22,2,"PAH",2,0)="6^2961017^1"
^DIC(9.4,108,22,2,"PAH",2,1,0)="^^24^24^2961017"
^DIC(9.4,108,22,2,"PAH",2,1,1,0)="This is Patch 6 to Survey Generator v 2.0.  It provides:"
^DIC(9.4,108,22,2,"PAH",2,1,2,0)=" "
^DIC(9.4,108,22,2,"PAH",2,1,3,0)="Routine:   NOIS:             Fix:"
^DIC(9.4,108,22,2,"PAH",2,1,4,0)=" "
^DIC(9.4,108,22,2,"PAH",2,1,5,0)="QAPDEM1    DAY-0796-40387    Prevent UNDEF error in a case where an "
^DIC(9.4,108,22,2,"PAH",2,1,6,0)="                             application lookup routine is invoked in"
^DIC(9.4,108,22,2,"PAH",2,1,7,0)="                             place of DIC lookup and Y is not set to"
^DIC(9.4,108,22,2,"PAH",2,1,8,0)="                             -1 when an error occurred in the lookup."
^DIC(9.4,108,22,2,"PAH",2,1,9,0)="                             This occurred when the demographic was a "
^DIC(9.4,108,22,2,"PAH",2,1,10,0)="                             pointer to a file that pointed to another"
^DIC(9.4,108,22,2,"PAH",2,1,11,0)="                             file and the application lookup routine was "
^DIC(9.4,108,22,2,"PAH",2,1,12,0)="                             on the first file."
^DIC(9.4,108,22,2,"PAH",2,1,13,0)=" "
^DIC(9.4,108,22,2,"PAH",2,1,14,0)="           BRX-1195-11059    Demographic questions in free text format "
^DIC(9.4,108,22,2,"PAH",2,1,15,0)="                             were supposed to be limited to a length of"
^DIC(9.4,108,22,2,"PAH",2,1,16,0)="                             from 1 to 40 characters; not 3 to 40.  The "
^DIC(9.4,108,22,2,"PAH",2,1,17,0)="                             DIR(0) was set to a limit of 3 to 40; even"
^DIC(9.4,108,22,2,"PAH",2,1,18,0)="                             though the DD is set to handle 1 to 40."
^DIC(9.4,108,22,2,"PAH",2,1,19,0)=" "
^DIC(9.4,108,22,2,"PAH",2,1,20,0)="QAPPT1     DAY-1195-40313    Users were unable to print a copy of the"
^DIC(9.4,108,22,2,"PAH",2,1,21,0)="                             incomplete survey with their answers, as "
^DIC(9.4,108,22,2,"PAH",2,1,22,0)="                             documented on page 63 of the Users Guide."
^DIC(9.4,108,22,2,"PAH",2,1,23,0)="                             This fix allows the intended use of the"
^DIC(9.4,108,22,2,"PAH",2,1,24,0)="                             ""Print A Copy For Yourself""  option."
^DIC(9.4,108,22,2,"PAH",3,0)="8 SEQ #6^3240506.120506^89"
^DIC(9.4,108,22,2,"PAH",3,1,0)="^^1^1^3240506"
^DIC(9.4,108,22,2,"PAH",3,1,1,0)="DISABLING SURVEY GENERATOR PACKAGE"
