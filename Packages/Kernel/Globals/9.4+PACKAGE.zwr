^DIC(9.4,52,22,29,"PAH",102,1,0)="^^11^11^3090422"
^DIC(9.4,52,22,29,"PAH",102,1,1,0)="NEW CHARGE CARD VENDOR (US BANK)"
^DIC(9.4,52,22,29,"PAH",102,1,2,0)="   - Modify Inactivate Expired Charge cards option task for card"
^DIC(9.4,52,22,29,"PAH",102,1,3,0)="     4486 inactivation"
^DIC(9.4,52,22,29,"PAH",102,1,4,0)="   - Create miscellaneous PC reports:"
^DIC(9.4,52,22,29,"PAH",102,1,5,0)="       Citibank cards on file with no US Bank replacement card"
^DIC(9.4,52,22,29,"PAH",102,1,6,0)="       All active Citibank cards with NO new US Bank replacement #"
^DIC(9.4,52,22,29,"PAH",102,1,7,0)="       All inactive Citibank cards with new US Bank replacement #"
