^DIC(9.4,3,22,21,"PAH",208,1,30,0)="this routine now look like: "
^DIC(9.4,3,22,21,"PAH",208,1,31,0)="  "
^DIC(9.4,3,22,21,"PAH",208,1,32,0)="  <tab>;;8.0;KERNEL;**[patch list]**;Jul 10, 1995 "
