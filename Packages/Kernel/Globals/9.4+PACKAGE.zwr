^DIC(9.4,3,22,21,"PAH",128,1,0)="^^1^1^3000502"
^DIC(9.4,3,22,21,"PAH",128,1,1,0)="See XU*8.0*152 in the National Patch Module on FORUM for details."
^DIC(9.4,3,22,21,"PAH",129,0)="143^3000525^1"
^DIC(9.4,3,22,21,"PAH",129,1,0)="^^1^1^3000525"
^DIC(9.4,3,22,21,"PAH",129,1,1,0)="RUM for OpenM/Cache."
^DIC(9.4,3,22,21,"PAH",130,0)="158 SEQ #135^3000612^1"
^DIC(9.4,3,22,21,"PAH",130,1,0)="^^1^1^3000612"
^DIC(9.4,3,22,21,"PAH",130,1,1,0)="See XU*8.0*158 in the National Patch Module on FORUM for details."
^DIC(9.4,3,22,21,"PAH",131,0)="153 SEQ #136^3000626^1"
^DIC(9.4,3,22,21,"PAH",131,1,0)="^^86^86^3000626"
^DIC(9.4,3,22,21,"PAH",131,1,1,0)="1.  ISL-0797-50726."
^DIC(9.4,3,22,21,"PAH",131,1,2,0)="    Site discovered that when a user attempts to logon and the PROHIBITED"
^DIC(9.4,3,22,21,"PAH",131,1,3,0)="    TIMES FOR SIGN-ON(file #200 and field #15) has been set with a time"
^DIC(9.4,3,22,21,"PAH",131,1,4,0)="    range that the user may not sign-on, an invalid message is displayed"
^DIC(9.4,3,22,21,"PAH",131,1,5,0)="    to the user.  Display has been revised as follows:"
^DIC(9.4,3,22,21,"PAH",131,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,7,0)="OLD - Good morning JOSHUA"
^DIC(9.4,3,22,21,"PAH",131,1,8,0)="           You last signed on today at 09:00"
^DIC(9.4,3,22,21,"PAH",131,1,9,0)="      Device:_TNT0001"
^DIC(9.4,3,22,21,"PAH",131,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,11,0)="      VERIFY CODE MUST be changed before continued use."
^DIC(9.4,3,22,21,"PAH",131,1,12,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,13,0)="      ACCESS CODE:"
^DIC(9.4,3,22,21,"PAH",131,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,16,0)="NEW - Good morning JOSHUA"
^DIC(9.4,3,22,21,"PAH",131,1,17,0)="           You last signed on today at 09:00"
^DIC(9.4,3,22,21,"PAH",131,1,18,0)="      Device:_TNT0001"
^DIC(9.4,3,22,21,"PAH",131,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,20,0)="      SMITH,JOSHUA M. you are NOT AUTHORIZED to access the system during"
^DIC(9.4,3,22,21,"PAH",131,1,21,0)="      the hours of 10:00 am thru 1:30 pm.  Please try before 10:00 am or"
^DIC(9.4,3,22,21,"PAH",131,1,22,0)="      after 1:30 pm."
^DIC(9.4,3,22,21,"PAH",131,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,24,0)="      ACCESS CODE:"
^DIC(9.4,3,22,21,"PAH",131,1,25,0)=" "
^DIC(9.4,3,22,21,"PAH",131,1,26,0)=" "
