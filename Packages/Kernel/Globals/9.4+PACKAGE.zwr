^DIC(9.4,8,22,14,"PAH",72,1,1,0)="This patch prevents a runtime error from occurring when the user enters "
^DIC(9.4,8,22,14,"PAH",72,1,2,0)="""??"" during the ICD Code Inquiry [ICD INQUIRY] menu option."
^DIC(9.4,8,22,14,"PAH",73,0)="95^3181004.160438^54"
^DIC(9.4,8,22,14,"PAH",74,0)="96^3181206.175528^54"
^DIC(9.4,8,22,14,"PAH",74,1,0)="^^1^1^3181206"
^DIC(9.4,8,22,14,"PAH",74,1,1,0)="This patch provides the annual update to the MS-DRG Grouper (v36)."
^DIC(9.4,8,22,14,"PAH",75,0)="100^3190926.115155^65"
^DIC(9.4,8,22,14,"PAH",76,0)="97^3191113.144539^65"
