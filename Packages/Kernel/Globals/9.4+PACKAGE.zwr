^DIC(9.4,77,22,17,"PAH",359,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,77,22,17,"PAH",360,0)="417 SEQ #361^3210812.142503^17"
^DIC(9.4,77,22,17,"PAH",360,1,0)="^^31^31^3210812"
^DIC(9.4,77,22,17,"PAH",360,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,77,22,17,"PAH",360,1,2,0)="==========================================="
^DIC(9.4,77,22,17,"PAH",360,1,3,0)=" "
^DIC(9.4,77,22,17,"PAH",360,1,4,0)="1.      INC17067067 VISTA Inpatient Pharmacy error with clinic orders and "
^DIC(9.4,77,22,17,"PAH",360,1,5,0)="stop dates"
^DIC(9.4,77,22,17,"PAH",360,1,6,0)=" "
^DIC(9.4,77,22,17,"PAH",360,1,7,0)="   Problem:"
^DIC(9.4,77,22,17,"PAH",360,1,8,0)="   -------"
^DIC(9.4,77,22,17,"PAH",360,1,9,0)="   The issue is seen with ""outpatients"" and unit dose clinic medications. "
^DIC(9.4,77,22,17,"PAH",360,1,10,0)="   The function to specify number of doses in the stop date field is   "
^DIC(9.4,77,22,17,"PAH",360,1,11,0)="   Calculating incorrect; it is one dose short. "
^DIC(9.4,77,22,17,"PAH",360,1,12,0)=" "
^DIC(9.4,77,22,17,"PAH",360,1,13,0)="   When entering a dose limit for an outpatient unit dose clinic "
^DIC(9.4,77,22,17,"PAH",360,1,14,0)="   medication,  the stop date calculated is at the date/time of the last"
^DIC(9.4,77,22,17,"PAH",360,1,15,0)="   dose to be administered.  That last dose cannot be administered at the"
^DIC(9.4,77,22,17,"PAH",360,1,16,0)="   time the order is defined to stop.  The stop date/time should be"
^DIC(9.4,77,22,17,"PAH",360,1,17,0)="   calculated to be after the last dose to be administered."
^DIC(9.4,77,22,17,"PAH",360,1,18,0)="   "
^DIC(9.4,77,22,17,"PAH",360,1,19,0)="   Resolution:"
^DIC(9.4,77,22,17,"PAH",360,1,20,0)="   ----------"
^DIC(9.4,77,22,17,"PAH",360,1,21,0)="   Modify routines PSGDL & PSJORP2 so that the date/time of the first "
^DIC(9.4,77,22,17,"PAH",360,1,22,0)="   dose is used to determine the stop date/time using the dose limit "
^DIC(9.4,77,22,17,"PAH",360,1,23,0)="   entered.  Prior to this patch the outpatient clinic order was using "
^DIC(9.4,77,22,17,"PAH",360,1,24,0)="   the current time to calculate the dose limit entered to get the stop "
^DIC(9.4,77,22,17,"PAH",360,1,25,0)="   date/time which would come up with one dose less than the dose limit "
^DIC(9.4,77,22,17,"PAH",360,1,26,0)="   entered.  This patch makes the outpatient dose limit function the "
^DIC(9.4,77,22,17,"PAH",360,1,27,0)="   same as for an inpatient clinic med is entered when the INPATIENT "
^DIC(9.4,77,22,17,"PAH",360,1,28,0)="   WARD PARAMETERS (File #59.6) field DEFAULT START DATE CALCULATION "
^DIC(9.4,77,22,17,"PAH",360,1,29,0)="   is set to 2.  With this patch inpatient clinic meds will calculate "
^DIC(9.4,77,22,17,"PAH",360,1,30,0)="   out the to the correct dose limit entered regardless of the DEFAULT "
^DIC(9.4,77,22,17,"PAH",360,1,31,0)="   START DATE CALCULATION parameter value."
^DIC(9.4,77,22,17,"PAH",361,0)="419b^3210823"
