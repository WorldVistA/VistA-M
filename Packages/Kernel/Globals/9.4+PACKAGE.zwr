^DIC(9.4,35,22,3,"PAH",450,0)="542b^3210429"
^DIC(9.4,35,22,3,"PAH",450,1,0)="^^5^5^3210429"
^DIC(9.4,35,22,3,"PAH",450,1,1,0)="Backup of OR*3.0*542 on Apr 29, 2021"
^DIC(9.4,35,22,3,"PAH",450,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",450,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,35,22,3,"PAH",450,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",450,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,35,22,3,"PAH",451,0)="542 SEQ #463^3210429.1422^17"
^DIC(9.4,35,22,3,"PAH",451,1,0)="^^4^4^3210429"
^DIC(9.4,35,22,3,"PAH",451,1,1,0)=" "
^DIC(9.4,35,22,3,"PAH",451,1,2,0)="The patch modifies the ORPRF routine and adds a new ORPRFHST routine to "
^DIC(9.4,35,22,3,"PAH",451,1,3,0)="display the history of active patient records flags in a pop-up window "
^DIC(9.4,35,22,3,"PAH",451,1,4,0)="associated with the Flag button in CPRS."
^DIC(9.4,35,22,3,"PAH",452,0)="501b^3210504"
^DIC(9.4,35,22,3,"PAH",452,1,0)="^^5^5^3210504"
^DIC(9.4,35,22,3,"PAH",452,1,1,0)="Backup of PCE STANDARDIZATION 1.0, PX*1.0*211, PXRM*2.0*42, GMT"
^DIC(9.4,35,22,3,"PAH",452,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",452,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,35,22,3,"PAH",452,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",452,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,35,22,3,"PAH",453,0)="501^3210504.155731^17"
^DIC(9.4,35,22,3,"PAH",453,1,0)="^^26^26^3210504"
^DIC(9.4,35,22,3,"PAH",453,1,1,0)="To take full advantage of the PCE standardization work, changes to VistA"
^DIC(9.4,35,22,3,"PAH",453,1,2,0)="applications that use PCE data are required. These applications include"
^DIC(9.4,35,22,3,"PAH",453,1,3,0)="Clinical Reminders, Health Summary, Problem List, and Order Entry/Results"
^DIC(9.4,35,22,3,"PAH",453,1,4,0)="Reporting. To make it easier for sites, the builds for PCE (PX*1.0*211),"
^DIC(9.4,35,22,3,"PAH",453,1,5,0)="Clinical Reminders (PXRM*2.0*42), Health Summary (GMTS*2.7*122), Problem List"
^DIC(9.4,35,22,3,"PAH",453,1,6,0)="(GMPL*2.0*53), and Order Entry/Results Reporting (OR*3.0*501) are being"
^DIC(9.4,35,22,3,"PAH",453,1,7,0)="distributed in a multi-package build named PCE STANDARDIZATION 1.0."
^DIC(9.4,35,22,3,"PAH",453,1,8,0)=""
^DIC(9.4,35,22,3,"PAH",453,1,9,0)="For detailed information and installation instructions, please see the PCE"
^DIC(9.4,35,22,3,"PAH",453,1,10,0)="Standardization 1.0 Installation Guide."
^DIC(9.4,35,22,3,"PAH",453,1,11,0)=""
^DIC(9.4,35,22,3,"PAH",453,1,12,0)="In the documentation for DATA2PCE the description of the variable PPEDIT,"
^DIC(9.4,35,22,3,"PAH",453,1,13,0)="which is one of the input parameters to DATA2PCE is:"
^DIC(9.4,35,22,3,"PAH",453,1,14,0)=""
^DIC(9.4,35,22,3,"PAH",453,1,15,0)="PPEDIT"
^DIC(9.4,35,22,3,"PAH",453,1,16,0)="(Optional) If an existing encounter already has a Primary Provider and you"
^DIC(9.4,35,22,3,"PAH",453,1,17,0)="want to edit it set this to 1."
^DIC(9.4,35,22,3,"PAH",453,1,18,0)=""
^DIC(9.4,35,22,3,"PAH",453,1,19,0)="Although it was documented, DATA2PCE did not actually enforce this, the"
^DIC(9.4,35,22,3,"PAH",453,1,20,0)="primary provider could be edited even when PPEDIT did not equal 1. DATA2PCE"
^DIC(9.4,35,22,3,"PAH",453,1,21,0)="was changed in PX*1.0*211 to work as documented. After that change, internal"
^DIC(9.4,35,22,3,"PAH",453,1,22,0)="testing found that the primary provider could no longer be edited from CPRS."
^DIC(9.4,35,22,3,"PAH",453,1,23,0)="The cause of this was tracked to the way CPRS was calling DATA2PCE, it was not"
^DIC(9.4,35,22,3,"PAH",453,1,24,0)="properly passing the PPEDIT parameter. The call to DATA2PCE in the routine"
^DIC(9.4,35,22,3,"PAH",453,1,25,0)="ORWPCE1 was corrected. "
^DIC(9.4,35,22,3,"PAH",453,1,26,0)=""
^DIC(9.4,35,22,3,"PAH",454,0)="550b^3210506"
^DIC(9.4,35,22,3,"PAH",454,1,0)="^^5^5^3210506"
^DIC(9.4,35,22,3,"PAH",454,1,1,0)="Backup of OR*3.0*550 on May 06, 2021"
^DIC(9.4,35,22,3,"PAH",454,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",454,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,35,22,3,"PAH",454,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",454,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,35,22,3,"PAH",455,0)="550 SEQ #465^3210506.100744^17"
^DIC(9.4,35,22,3,"PAH",455,1,0)="^^19^19^3210506"
^DIC(9.4,35,22,3,"PAH",455,1,1,0)="1.      PDMP AoD Health Summary not always displaying manual PDMP notes "
^DIC(9.4,35,22,3,"PAH",455,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",455,1,3,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",455,1,4,0)="   -------"
^DIC(9.4,35,22,3,"PAH",455,1,5,0)="   The PDMP ADHOC Health Summary report is supposed to display PDMP "
^DIC(9.4,35,22,3,"PAH",455,1,6,0)="   queries that were initiated from within CPRS as well as manual queries"
^DIC(9.4,35,22,3,"PAH",455,1,7,0)="   (if the manual PDMP query was documented in the standard PDMP progress"
^DIC(9.4,35,22,3,"PAH",455,1,8,0)="   note). However, if a patient never had a query initiated within CPRS"
^DIC(9.4,35,22,3,"PAH",455,1,9,0)="   (by using the PDMP query button), their manual queries are not showing"
^DIC(9.4,35,22,3,"PAH",455,1,10,0)="   on the HS report, even though they were documented in the PDMP progress"
^DIC(9.4,35,22,3,"PAH",455,1,11,0)="   note."
^DIC(9.4,35,22,3,"PAH",455,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",455,1,13,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",455,1,14,0)="   ----------"
^DIC(9.4,35,22,3,"PAH",455,1,15,0)="   Routine ORPDMPHS is modified to not quit when the patient has no data "
^DIC(9.4,35,22,3,"PAH",455,1,16,0)="   in the PDMP QUERY LOG (#101.62).  Instead, processing will bypass"
^DIC(9.4,35,22,3,"PAH",455,1,17,0)="   displaying the data in PDMP QUERY LOG when no data exists for the"
^DIC(9.4,35,22,3,"PAH",455,1,18,0)="   patient and allowing the data for manually entered PDMP notes to be"
^DIC(9.4,35,22,3,"PAH",455,1,19,0)="   displayed."
^DIC(9.4,35,22,3,"PAH",456,0)="548b^3210601"
^DIC(9.4,35,22,3,"PAH",456,1,0)="^^5^5^3210601"
^DIC(9.4,35,22,3,"PAH",456,1,1,0)="Backup of OR*3.0*548 on Jun 01, 2021"
^DIC(9.4,35,22,3,"PAH",456,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",456,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,35,22,3,"PAH",456,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,35,22,3,"PAH",456,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,35,22,3,"PAH",457,0)="548 SEQ #466^3210601.165414^17"
^DIC(9.4,35,22,3,"PAH",457,1,0)="^^41^41^3210601"
^DIC(9.4,35,22,3,"PAH",457,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,35,22,3,"PAH",457,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,3,0)="1. Inactivated orderable items can be selected in the option Enter/edit "
^DIC(9.4,35,22,3,"PAH",457,1,4,0)="QO restrictions"
^DIC(9.4,35,22,3,"PAH",457,1,5,0)="   "
^DIC(9.4,35,22,3,"PAH",457,1,6,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,7,0)="Associated ticket(s):"
^DIC(9.4,35,22,3,"PAH",457,1,8,0)="====================="
^DIC(9.4,35,22,3,"PAH",457,1,9,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,10,0)="1. INC16882015 - Inactivated orderable items can be selected in the "
^DIC(9.4,35,22,3,"PAH",457,1,11,0)="option Enter/edit QO restrictions"
^DIC(9.4,35,22,3,"PAH",457,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,13,0)="Associated NSR(s):"
^DIC(9.4,35,22,3,"PAH",457,1,14,0)="=================="
^DIC(9.4,35,22,3,"PAH",457,1,15,0)="N/A"
^DIC(9.4,35,22,3,"PAH",457,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,17,0)="Participating Test Sites:"
^DIC(9.4,35,22,3,"PAH",457,1,18,0)="========================="
^DIC(9.4,35,22,3,"PAH",457,1,19,0)="TBD"
^DIC(9.4,35,22,3,"PAH",457,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,21,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,22,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,35,22,3,"PAH",457,1,23,0)="==========================================="
^DIC(9.4,35,22,3,"PAH",457,1,24,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,25,0)="1.      Inactivated orderable items can be selected in the option "
^DIC(9.4,35,22,3,"PAH",457,1,26,0)="Enter/edit QO restrictions "
^DIC(9.4,35,22,3,"PAH",457,1,27,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,28,0)="   Problem:"
^DIC(9.4,35,22,3,"PAH",457,1,29,0)="   -------"
^DIC(9.4,35,22,3,"PAH",457,1,30,0)="   Inactivated pharmacy or lab orderable items can be selected when using "
^DIC(9.4,35,22,3,"PAH",457,1,31,0)="   the option Enter/edit QO restrictions. It was also found that the 'SR"
^DIC(9.4,35,22,3,"PAH",457,1,32,0)="   Search/replace orderables' option also displays inactive Orderable "
^DIC(9.4,35,22,3,"PAH",457,1,33,0)="   Items to replace orderable items."
^DIC(9.4,35,22,3,"PAH",457,1,34,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,35,0)=" "
^DIC(9.4,35,22,3,"PAH",457,1,36,0)="   Resolution:"
^DIC(9.4,35,22,3,"PAH",457,1,37,0)="   ----------"
^DIC(9.4,35,22,3,"PAH",457,1,38,0)="   Routine ORCMEDT6 is modified to display that inactive Orderable Items "
^DIC(9.4,35,22,3,"PAH",457,1,39,0)="   (OI) are inactive. It will also display that inactive OIs are"
^DIC(9.4,35,22,3,"PAH",457,1,40,0)="   inactive on the 'Search for:' and 'Replace with:' prompts in option"
^DIC(9.4,35,22,3,"PAH",457,1,41,0)="   Search/replace orderables."
