^DIC(9.4,111,22,1,"PAH",47,0)="58 SEQ #48^2980831^1"
^DIC(9.4,111,22,1,"PAH",48,0)="52^2981104^1"
^DIC(9.4,111,22,1,"PAH",48,1,0)="^^3^3^2981104"
^DIC(9.4,111,22,1,"PAH",48,1,1,0)="This build is part of the overall patch SD*5.3*149, and provides the"
^DIC(9.4,111,22,1,"PAH",48,1,2,0)="capability to display and capture Global Assessment of Function (GAF)"
^DIC(9.4,111,22,1,"PAH",48,1,3,0)="scores and related data during appointment check out."
^DIC(9.4,111,22,1,"PAH",49,0)="59 SEQ #50^2981229^1"
^DIC(9.4,111,22,1,"PAH",49,1,0)="^^7^7^2981229"
^DIC(9.4,111,22,1,"PAH",49,1,1,0)=" A single VISIT (#9000010) is pointed to by two main OUTPATIENT"
^DIC(9.4,111,22,1,"PAH",49,1,2,0)=" ENCOUNTERs (#409.68), when there should only be one. This is now"
^DIC(9.4,111,22,1,"PAH",49,1,3,0)=" addressed using LOCK. This problem was noted in NOIS message"
^DIC(9.4,111,22,1,"PAH",49,1,4,0)=" HUN-0598-22218. Some of the most important discussions of this"
^DIC(9.4,111,22,1,"PAH",49,1,5,0)=" problem occurred in FORUM mail message #27819009 : ""Huntington"
^DIC(9.4,111,22,1,"PAH",49,1,6,0)=" problem with dup. Outpatient Encounters"". The routine PXKMAIN has"
^DIC(9.4,111,22,1,"PAH",49,1,7,0)=" been modified to fix this defect. "
^DIC(9.4,111,22,1,"PAH",50,0)="55 SEQ #51^2990119^1"
^DIC(9.4,111,22,1,"PAH",50,1,0)="^^3^3^2990119"
^DIC(9.4,111,22,1,"PAH",50,1,1,0)="PCE patch 55, PX*1.0*55, clinical reminders. This patch adds a wildcard"
^DIC(9.4,111,22,1,"PAH",50,1,2,0)="to the IGNORE ON N/A field. See the National Patch Module for a complete"
^DIC(9.4,111,22,1,"PAH",50,1,3,0)="description."
^DIC(9.4,111,22,1,"PAH",51,0)="62 SEQ #52^2990201^1"
^DIC(9.4,111,22,1,"PAH",51,1,0)="^^6^6^2990201"
^DIC(9.4,111,22,1,"PAH",51,1,1,0)=" PCE Help Text says ""Provider"" when it should say ""Diagnosis"" or"
^DIC(9.4,111,22,1,"PAH",51,1,2,0)=" ""Procedure"". This problem was noted in NOIS message PUG-1098-51770. "
^DIC(9.4,111,22,1,"PAH",51,1,3,0)=" It affects the protocols Check Out Interview [PXCE ADD/EDIT"
^DIC(9.4,111,22,1,"PAH",51,1,4,0)=" INTERVIEW], Check Out Interview [PXCE INTERVIEW] and Check Out"
^DIC(9.4,111,22,1,"PAH",51,1,5,0)=" Interview [PXCE SDAM INTERVIEW]. The routines PXBHLP3 and PXBHLP4"
^DIC(9.4,111,22,1,"PAH",51,1,6,0)=" have been modified to fix this defect. "
^DIC(9.4,111,22,1,"PAH",52,0)="33 SEQ #53^2990322^1"
^DIC(9.4,111,22,1,"PAH",52,1,0)="^^1^1^2990322"
^DIC(9.4,111,22,1,"PAH",52,1,1,0)="See National Patch Module for description."
^DIC(9.4,111,22,1,"PAH",53,0)="66 SEQ #54^2990329^1"
^DIC(9.4,111,22,1,"PAH",53,1,0)="^^1^1^2990329"
^DIC(9.4,111,22,1,"PAH",53,1,1,0)="PCE Code mapping and immunization fix for the 1999 COPT code update"
^DIC(9.4,111,22,1,"PAH",54,0)="34 SEQ #55^2990417^1"
^DIC(9.4,111,22,1,"PAH",54,1,0)="^^22^22^2990417"
^DIC(9.4,111,22,1,"PAH",54,1,1,0)="  1. PCE sometimes crashes when editing cancelled appointments for"
^DIC(9.4,111,22,1,"PAH",54,1,2,0)="     which a visit still exists. This problem was noted in NOIS"
^DIC(9.4,111,22,1,"PAH",54,1,3,0)="     messages BOS-0397-11896, PRO-0397-10568, HOU-0998-71834 and"
^DIC(9.4,111,22,1,"PAH",54,1,4,0)="     DAY-0898-41893. It affects the options PCE Encounter Data Entry"
^DIC(9.4,111,22,1,"PAH",54,1,5,0)="     - Supervisor [PXCE ENCOUNTER ENTRY SUPER], PCE Encounter Data"
^DIC(9.4,111,22,1,"PAH",54,1,6,0)="     Entry and Delete [PXCE ENCOUNTER ENTRY & DELETE], PCE Encounter"
^DIC(9.4,111,22,1,"PAH",54,1,7,0)="     Data Entry [PXCE ENCOUNTER DATA ENTRY] and PCE Encounter Data"
^DIC(9.4,111,22,1,"PAH",54,1,8,0)="     Entry without Delete [PXCE ENCOUNTER ENTRY NO DELETE]. The"
^DIC(9.4,111,22,1,"PAH",54,1,9,0)="     routine PXCESDAM has been modified to fix this defect. "
^DIC(9.4,111,22,1,"PAH",54,1,10,0)=" "
^DIC(9.4,111,22,1,"PAH",54,1,11,0)="  2. It has been pointed out that PCE should not allow the user to"
^DIC(9.4,111,22,1,"PAH",54,1,12,0)="     edit an encounter that has been cancelled, in cases where the"
^DIC(9.4,111,22,1,"PAH",54,1,13,0)="     visit no longer exists. This problem was noted in NOIS message"
^DIC(9.4,111,22,1,"PAH",54,1,14,0)="     TAM-0397-32584. It affects the options PCE Encounter Data Entry"
^DIC(9.4,111,22,1,"PAH",54,1,15,0)="     [PXCE ENCOUNTER DATA ENTRY], PCE Encounter Data Entry and Delete"
^DIC(9.4,111,22,1,"PAH",54,1,16,0)="     [PXCE ENCOUNTER ENTRY & DELETE], PCE Encounter Data Entry"
^DIC(9.4,111,22,1,"PAH",54,1,17,0)="     without Delete [PXCE ENCOUNTER ENTRY NO DELETE] and PCE"
^DIC(9.4,111,22,1,"PAH",54,1,18,0)="     Encounter Data Entry - Supervisor [PXCE ENCOUNTER ENTRY SUPER]. "
^DIC(9.4,111,22,1,"PAH",54,1,19,0)="     It also affects the protocols MCCR SITE PARAMETER EDIT [MAF MCCR"
^DIC(9.4,111,22,1,"PAH",54,1,20,0)="     SITE PARM PROTOCOL], Group 1 Edit [MAF IB SITE PARM GROUP 1] and"
^DIC(9.4,111,22,1,"PAH",54,1,21,0)="     Group 2 Edit [MAF IB SITE PARM GROUP 2]. The routine PXCESDAM"
^DIC(9.4,111,22,1,"PAH",54,1,22,0)="     has been modified to fix this defect. "
^DIC(9.4,111,22,1,"PAH",55,0)="64^2990419^1"
^DIC(9.4,111,22,1,"PAH",55,1,0)="^^3^3^2990419"
^DIC(9.4,111,22,1,"PAH",55,1,1,0)="Open 90 day GAF score window to allow entry of new GAF scores within the"
^DIC(9.4,111,22,1,"PAH",55,1,2,0)="window.  This patchis carried as part of the SD*5.3*175 KID's"
^DIC(9.4,111,22,1,"PAH",55,1,3,0)="distribution."
^DIC(9.4,111,22,1,"PAH",56,0)="46 SEQ #57^2990427^1"
^DIC(9.4,111,22,1,"PAH",56,1,0)="^^3^3^2990427"
^DIC(9.4,111,22,1,"PAH",56,1,1,0)="PCE patch 46, PX*1.0*46, clinical reminders. This patch adds a new"
^DIC(9.4,111,22,1,"PAH",56,1,2,0)="option that lets sites share reminder definitions. See the National"
^DIC(9.4,111,22,1,"PAH",56,1,3,0)="Patch Module for a complete description."
^DIC(9.4,111,22,1,"PAH",57,0)="56^2990602^1"
^DIC(9.4,111,22,1,"PAH",57,1,0)="^^7^7^2990602"
^DIC(9.4,111,22,1,"PAH",57,1,1,0)="VHA Directive 98-058, ""Sexual Trauma Counseling Care and Services"""
^DIC(9.4,111,22,1,"PAH",57,1,2,0)="requires that VHA provide care and counseling to veterans determined to"
^DIC(9.4,111,22,1,"PAH",57,1,3,0)="have been a victim of sexual trauma while the veteran was serving on"
^DIC(9.4,111,22,1,"PAH",57,1,4,0)="active duty.  This patch will focus on the data collection for this"
^DIC(9.4,111,22,1,"PAH",57,1,5,0)="directive."
^DIC(9.4,111,22,1,"PAH",57,1,6,0)=" "
^DIC(9.4,111,22,1,"PAH",57,1,7,0)="This is the PCE portion of the overall patch.  See DG*5.3*195"
^DIC(9.4,111,22,1,"PAH",58,0)="61 SEQ #59^2990602^1"
^DIC(9.4,111,22,1,"PAH",58,1,0)="^^19^19^2990602"
^DIC(9.4,111,22,1,"PAH",58,1,1,0)="  1. Some sites have reported 'subscript too long' errors when"
^DIC(9.4,111,22,1,"PAH",58,1,2,0)="     running PCE reports, even though the reports meet standards. "
^DIC(9.4,111,22,1,"PAH",58,1,3,0)="     The subscripts have been shortened to make this less likely. "
^DIC(9.4,111,22,1,"PAH",58,1,4,0)="     This problem was noted in NOIS messages BYN-0998-10088 and"
^DIC(9.4,111,22,1,"PAH",58,1,5,0)="     ISA-1098-11607. It affects the options PCE Encounter Summary"
^DIC(9.4,111,22,1,"PAH",58,1,6,0)="     [PXRR PCE ENCOUNTER SUMMARY], Diagnosis Ranked by Frequency"
^DIC(9.4,111,22,1,"PAH",58,1,7,0)="     [PXRR MOST FREQUENT DIAGNOSES], Location Encounter Counts [PXRR"
^DIC(9.4,111,22,1,"PAH",58,1,8,0)="     LOCATION ENCOUNTER COUNTS], Patient Activity by Location [PXRR"
^DIC(9.4,111,22,1,"PAH",58,1,9,0)="     PATIENT ACTIVITY BY LOC] and Provider Encounter Counts [PXRR"
^DIC(9.4,111,22,1,"PAH",58,1,10,0)="     PROVIDER ENCOUNTER COUNTS]. The routines PXRRFDD, PXRRLCD,"
^DIC(9.4,111,22,1,"PAH",58,1,11,0)="     PXRRPRD, PXRRWLD and PXRRPAD have been modified to fix this"
^DIC(9.4,111,22,1,"PAH",58,1,12,0)="     defect. "
^DIC(9.4,111,22,1,"PAH",58,1,13,0)=" "
^DIC(9.4,111,22,1,"PAH",58,1,14,0)="  2. The PCE Encounter Summary report does not properly handle"
^DIC(9.4,111,22,1,"PAH",58,1,15,0)="     encounters having multiple providers. This problem was noted in"
^DIC(9.4,111,22,1,"PAH",58,1,16,0)="     NOIS messages PRO-0898-10847 and MIN-1198-41070. It affects the"
^DIC(9.4,111,22,1,"PAH",58,1,17,0)="     option PCE Encounter Summary [PXRR PCE ENCOUNTER SUMMARY]. The"
^DIC(9.4,111,22,1,"PAH",58,1,18,0)="     routines PXRRWLD, PXRRWLPR, PXRRWLS2, PXRRWLSA and PXRRWLSE have"
^DIC(9.4,111,22,1,"PAH",58,1,19,0)="     been modified to fix this defect. "
^DIC(9.4,111,22,1,"PAH",59,0)="53^2990719^1"
^DIC(9.4,111,22,1,"PAH",59,1,0)="^^3^3^2990719"
^DIC(9.4,111,22,1,"PAH",59,1,1,0)="PCE patch 53, PX*1.0*53, clinical reminders. This patch adds data caching"
^DIC(9.4,111,22,1,"PAH",59,1,2,0)="to improve performance. See the National Patch Module for a complete"
^DIC(9.4,111,22,1,"PAH",59,1,3,0)="description."
^DIC(9.4,111,22,1,"PAH",60,0)="77 SEQ #61^2990720^1"
^DIC(9.4,111,22,1,"PAH",60,1,0)="^^1^1^2990720"
^DIC(9.4,111,22,1,"PAH",60,1,1,0)="PCE DATABASE API'S -V CPT ONLY"
^DIC(9.4,111,22,1,"PAH",61,0)="63 SEQ #62^2990914^1"
^DIC(9.4,111,22,1,"PAH",61,1,0)="^^3^3^2990914"
^DIC(9.4,111,22,1,"PAH",61,1,1,0)="PCE patch 63, PX*1.0*63, clinical reminders. This patch adds a new report "
^DIC(9.4,111,22,1,"PAH",61,1,2,0)="function REMINDERS DUE REPORT."
^DIC(9.4,111,22,1,"PAH",61,1,3,0)="See the National Patch Module for a complete description."
^DIC(9.4,111,22,1,"PAH",62,0)="76 SEQ #63^2990914^1"
^DIC(9.4,111,22,1,"PAH",62,1,0)="^^5^5^2990914"
^DIC(9.4,111,22,1,"PAH",62,1,1,0)="While Visit Tracking, namespace VSIT, went out as a distinct package, it is"
^DIC(9.4,111,22,1,"PAH",62,1,2,0)="now consolidated with PX and should have as its Parent Package, PCE "
^DIC(9.4,111,22,1,"PAH",62,1,3,0)="PATIENT CARE ENCOUNTER.  That means future patches to routines in the "
^DIC(9.4,111,22,1,"PAH",62,1,4,0)="VSIT namespace should be sent out under PX* and the second line for any "
^DIC(9.4,111,22,1,"PAH",62,1,5,0)="patched VSIT routines will now reflect the new ownership.  "
^DIC(9.4,111,22,1,"PAH",63,0)="85 SEQ #64^3000313^1"
^DIC(9.4,111,22,1,"PAH",64,0)="73 SEQ #65^3000313^1"
^DIC(9.4,111,22,1,"PAH",64,1,0)="^^1^1^3000313"
^DIC(9.4,111,22,1,"PAH",64,1,1,0)="CPT MODIFIERS"
^DIC(9.4,111,22,1,"PAH",65,0)="74 SEQ #66^3000405^1"
^DIC(9.4,111,22,1,"PAH",65,1,0)="^^2^2^3000405"
^DIC(9.4,111,22,1,"PAH",65,1,1,0)="Changes for the MST field in PCE for the DATA2PCE, PXCA API's and the Data"
^DIC(9.4,111,22,1,"PAH",65,1,2,0)="entry option."
^DIC(9.4,111,22,1,"PAH",66,0)="83 SEQ #67^3000405^1"
^DIC(9.4,111,22,1,"PAH",66,1,0)="^^1^1^3000405"
^DIC(9.4,111,22,1,"PAH",66,1,1,0)="PCE file allows LAYGO to file 200"
^DIC(9.4,111,22,1,"PAH",67,0)="88 SEQ #68^3000417^1"
^DIC(9.4,111,22,1,"PAH",68,0)="72 SEQ #69^3000501^1"
^DIC(9.4,111,22,1,"PAH",68,1,0)="^^4^4^3000501"
^DIC(9.4,111,22,1,"PAH",68,1,1,0)="PCE Report does not recognize events which occurred at non-VA sites."
^DIC(9.4,111,22,1,"PAH",68,1,2,0)="Also, this patch addresses the issue of when a user sends a PCE Report"
^DIC(9.4,111,22,1,"PAH",68,1,3,0)="to the printer queue, the user's default editor type reverts to a"
^DIC(9.4,111,22,1,"PAH",68,1,4,0)="line editor."
^DIC(9.4,111,22,1,"PAH",69,0)="70 SEQ #70^3000502^1"
