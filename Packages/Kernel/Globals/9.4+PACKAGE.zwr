^DIC(9.4,3,22,21,"PAH",452,0)="574 SEQ #469^3120313.121216^17"
^DIC(9.4,3,22,21,"PAH",452,1,0)="^^6^6^3120313"
^DIC(9.4,3,22,21,"PAH",452,1,1,0)="This patch changes the minimum verify code lenght for service accounts"
^DIC(9.4,3,22,21,"PAH",452,1,2,0)="(User Class = CONNECTOR PROXY) from 8 to 12 characters."
^DIC(9.4,3,22,21,"PAH",452,1,3,0)=" "
^DIC(9.4,3,22,21,"PAH",452,1,4,0)="It also provides a new report as two options (inquire-style and"
^DIC(9.4,3,22,21,"PAH",452,1,5,0)="report-style). The report provides details about connector proxy "
^DIC(9.4,3,22,21,"PAH",452,1,6,0)="service accounts to help with account management."
^DIC(9.4,3,22,21,"PAH",453,0)="566 SEQ #470^3120329.183512^17"
^DIC(9.4,3,22,21,"PAH",453,1,0)="^^48^48^3120329"
^DIC(9.4,3,22,21,"PAH",453,1,1,0)="This patch was created to support Outpatient Pharmacy in printing Food"
^DIC(9.4,3,22,21,"PAH",453,1,2,0)="and Drug Administration (FDA) Medication Guide documents using a Java"
^DIC(9.4,3,22,21,"PAH",453,1,3,0)="application. These documents are in Adobe Portable Document Format (.pdf),"
^DIC(9.4,3,22,21,"PAH",453,1,4,0)="which is a file format not supported by VistA."
^DIC(9.4,3,22,21,"PAH",453,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",453,1,6,0)="A new field, WINDOWS NETWORK PRINTER NAME (#75), is being added to the"
^DIC(9.4,3,22,21,"PAH",453,1,7,0)="DEVICE file (#3.5). This field will be used to store the Windows network"
^DIC(9.4,3,22,21,"PAH",453,1,8,0)="printer name, which VistA passes on to a Java Application responsible"
^DIC(9.4,3,22,21,"PAH",453,1,9,0)="for printing FDA Medication Guide documents."
^DIC(9.4,3,22,21,"PAH",453,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",453,1,11,0)="New field in the DEVICE file (#3.5) - WINDOWS NETWORK PRINTER NAME (#75)"
^DIC(9.4,3,22,21,"PAH",453,1,12,0)="------------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",453,1,13,0)="3.5,75        WINDOWS NETWORK PRINTER NAME WIN;1 FREE TEXT"
^DIC(9.4,3,22,21,"PAH",453,1,14,0)=" "
^DIC(9.4,3,22,21,"PAH",453,1,15,0)="              INPUT TRANSFORM: K:$L(X)>50!($L(X)<5) X"
^DIC(9.4,3,22,21,"PAH",453,1,16,0)="              LAST EDITED:     AUG 23, 2011 "
^DIC(9.4,3,22,21,"PAH",453,1,17,0)="              HELP-PROMPT:     Answer must be 5-50 characters in length. "
^DIC(9.4,3,22,21,"PAH",453,1,18,0)="              DESCRIPTION:     This is the Windows network name for the"
^DIC(9.4,3,22,21,"PAH",453,1,19,0)="                               printer (e.g., '\\vhaistfpc4\IST-HP4525-1')."
^DIC(9.4,3,22,21,"PAH",453,1,20,0)="                               It is used by Windows applications that"
^DIC(9.4,3,22,21,"PAH",453,1,21,0)="                               interact with VistA and need a printer "
^DIC(9.4,3,22,21,"PAH",453,1,22,0)="                               identified for output purposes. "
^DIC(9.4,3,22,21,"PAH",453,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",453,1,24,0)="The new field can be edited via the Edit All Device Fields [XUDEVEDITALL] "
^DIC(9.4,3,22,21,"PAH",453,1,25,0)="option under the Kernel Device Management options as seen below:"
^DIC(9.4,3,22,21,"PAH",453,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",453,1,27,0)="   Select Device Edit Option:  Edit All Device Fields"
^DIC(9.4,3,22,21,"PAH",453,1,28,0)=" "
^DIC(9.4,3,22,21,"PAH",453,1,29,0)="   Select DEVICE NAME: FDAMGPRT      FDA MG Printer       _TNA1316:     "
^DIC(9.4,3,22,21,"PAH",453,1,30,0)="   NAME: FDAMGPRT// "
^DIC(9.4,3,22,21,"PAH",453,1,31,0)="   LOCATION OF TERMINAL: Pharmacy// "
^DIC(9.4,3,22,21,"PAH",453,1,32,0)="   Select MNEMONIC: "
^DIC(9.4,3,22,21,"PAH",453,1,33,0)="   ..."
^DIC(9.4,3,22,21,"PAH",453,1,34,0)="   TELNET PORT: "
^DIC(9.4,3,22,21,"PAH",453,1,35,0)="   REMOTE PRINTER NAME: "
^DIC(9.4,3,22,21,"PAH",453,1,36,0)="   WINDOWS NETWORK PRINTER NAME: ??"
^DIC(9.4,3,22,21,"PAH",453,1,37,0)="     This is the Windows network name for the printer (e.g., "
^DIC(9.4,3,22,21,"PAH",453,1,38,0)="     '\\vhaistfpc4\IST-HP4525-1'). It is used by Windows applications that "
^DIC(9.4,3,22,21,"PAH",453,1,39,0)="     interact with VistA and need a printer identified for output purposes."
^DIC(9.4,3,22,21,"PAH",453,1,40,0)="   "
^DIC(9.4,3,22,21,"PAH",453,1,41,0)="   WINDOWS NETWORK PRINTER NAME: \\vhaistfpc4\IST-HP4525-9"
^DIC(9.4,3,22,21,"PAH",453,1,42,0)="   LAB LABEL PRINTER:"
^DIC(9.4,3,22,21,"PAH",453,1,43,0)="   ..."
^DIC(9.4,3,22,21,"PAH",453,1,44,0)="   "
^DIC(9.4,3,22,21,"PAH",453,1,45,0)="There was a problem with the HTTP Toolkit API $$GETURL^XTHC10. It was"
^DIC(9.4,3,22,21,"PAH",453,1,46,0)="modifying the array variable IO, which could cause issues for the calling"
^DIC(9.4,3,22,21,"PAH",453,1,47,0)="routine. The NEW command was placed for the IO variable inside the XTHC10"
^DIC(9.4,3,22,21,"PAH",453,1,48,0)="routine to resolve this problem."
^DIC(9.4,3,22,21,"PAH",454,0)="591 SEQ #471^3120410.15153^17"
