^DIC(9.4,49,22,10,"PAH",553,0)="638^3201208.082724^17"
^DIC(9.4,49,22,10,"PAH",554,0)="685^3201218.152446^17"
^DIC(9.4,49,22,10,"PAH",554,1,0)="^^13^13^3201218"
^DIC(9.4,49,22,10,"PAH",554,1,1,0)="IB*2.0*685 (Integrated Billing) is bundled with DG*5.3*1025 "
^DIC(9.4,49,22,10,"PAH",554,1,2,0)="(Registration) in host file."
^DIC(9.4,49,22,10,"PAH",554,1,3,0)=" "
^DIC(9.4,49,22,10,"PAH",554,1,4,0)="The SHRPE product makes enhancements to the Registration (patch "
^DIC(9.4,49,22,10,"PAH",554,1,5,0)="DG*5.3*1025) to implement reports that would help Registration and Billing"
^DIC(9.4,49,22,10,"PAH",554,1,6,0)="users to identify patients that were treated under Other Than Honorable"
^DIC(9.4,49,22,10,"PAH",554,1,7,0)="authority and provide details about eligibility changes and VA care"
^DIC(9.4,49,22,10,"PAH",554,1,8,0)="provided to these patients. The reports are developed in DG namespace  but"
^DIC(9.4,49,22,10,"PAH",554,1,9,0)="need to be available to both Registration and Integrated billing users."
^DIC(9.4,49,22,10,"PAH",554,1,10,0)=" "
^DIC(9.4,49,22,10,"PAH",554,1,11,0)="The billing users of the [IB OUTPUT PATIENT REPORT MENU] menu need access "
^DIC(9.4,49,22,10,"PAH",554,1,12,0)="to REGISTRATION menu options [DG OTH FSM ELIG. CHANGE REPORT] and [DG OTH "
^DIC(9.4,49,22,10,"PAH",554,1,13,0)="FSM DETAIL REPORT] from patch DG*5.3*1025."
^DIC(9.4,49,22,10,"PAH",555,0)="692 SEQ #628^3201231.140028^65"
^DIC(9.4,49,22,10,"PAH",555,1,0)="^^2^2^3201231"
^DIC(9.4,49,22,10,"PAH",555,1,1,0)="Patch IB*2.0*692 addresses the annual updates for the Pharmacy Copay"
^DIC(9.4,49,22,10,"PAH",555,1,2,0)="Thresholds."
