^DIC(9.4,4,22,1,"PAH",43,1,513,0)="XMXSEC       $$ACCESS    May user access message?"
^DIC(9.4,4,22,1,"PAH",43,1,514,0)="             $$ANSWER    May user answer message?"
^DIC(9.4,4,22,1,"PAH",43,1,515,0)="             $$BCAST     Is this a broadcast message?"
^DIC(9.4,4,22,1,"PAH",43,1,516,0)="             $$CLOSED    Is this message closed?"
^DIC(9.4,4,22,1,"PAH",43,1,517,0)="             $$CONFID    Is this message confidential?"
^DIC(9.4,4,22,1,"PAH",43,1,518,0)="             $$CONFIRM   Is this message confirm receipt requested?"
^DIC(9.4,4,22,1,"PAH",43,1,519,0)="             $$COPY      May user copy message?"
^DIC(9.4,4,22,1,"PAH",43,1,520,0)="             $$DELETE    May user delete message?"
^DIC(9.4,4,22,1,"PAH",43,1,521,0)="             $$FORWARD   May user forward message?"
^DIC(9.4,4,22,1,"PAH",43,1,522,0)="             $$INFO      Is this message information only?"
^DIC(9.4,4,22,1,"PAH",43,1,523,0)="             $$LATER     May user later message?"
^DIC(9.4,4,22,1,"PAH",43,1,524,0)="             $$MOVE      May user save/filter message?"
^DIC(9.4,4,22,1,"PAH",43,1,525,0)="             $$ORIGIN8R  Did user send this message?"
^DIC(9.4,4,22,1,"PAH",43,1,526,0)="             $$POSTPRIV  Does user have postmaster privilege?"
^DIC(9.4,4,22,1,"PAH",43,1,527,0)="             $$PRIORITY  Is this message priority?"
^DIC(9.4,4,22,1,"PAH",43,1,528,0)="             $$READ      May user read message?"
^DIC(9.4,4,22,1,"PAH",43,1,529,0)="             $$REPLY     May user reply to message?"
^DIC(9.4,4,22,1,"PAH",43,1,530,0)="             $$RPRIV     Does surrogate have read privilege?"
^DIC(9.4,4,22,1,"PAH",43,1,531,0)="             $$RWPRIV    Does surrogate have read/write privilege?"
^DIC(9.4,4,22,1,"PAH",43,1,532,0)="             $$SEND      May user send a message?"
^DIC(9.4,4,22,1,"PAH",43,1,533,0)="             $$SURRACC   May surrogate access message?"
^DIC(9.4,4,22,1,"PAH",43,1,534,0)="             $$SURRCONF  May surrogate *not* access message?"
^DIC(9.4,4,22,1,"PAH",43,1,535,0)="             $$WPRIV     Does surrogate have write privilege?"
^DIC(9.4,4,22,1,"PAH",43,1,536,0)="             $$ZCLOSED   Is this message closed?"
^DIC(9.4,4,22,1,"PAH",43,1,537,0)="             $$ZCONFID   Is this message confidential?"
^DIC(9.4,4,22,1,"PAH",43,1,538,0)="             $$ZCONFIRM  Is this message confirm receipt requested?"
^DIC(9.4,4,22,1,"PAH",43,1,539,0)="             $$ZINFO     Is this message information only?"
^DIC(9.4,4,22,1,"PAH",43,1,540,0)="             $$ZORIGIN8  Did user send this message?"
^DIC(9.4,4,22,1,"PAH",43,1,541,0)="             $$ZPOSTPRV  Does user have postmaster privilege?"
^DIC(9.4,4,22,1,"PAH",43,1,542,0)="             $$ZPRI      Is this message priority?"
^DIC(9.4,4,22,1,"PAH",43,1,543,0)="XMXSEC1      $$COPYAMT   May the copy contain the requested responses?"
^DIC(9.4,4,22,1,"PAH",43,1,544,0)="             $$COPYLIMS  Get the site's copy limits."
^DIC(9.4,4,22,1,"PAH",43,1,545,0)="             $$COPYRECP  May the copy be sent to the original's recipients?"
^DIC(9.4,4,22,1,"PAH",43,1,546,0)="             $$PAKMAN    Is this a PackMan message?"
^DIC(9.4,4,22,1,"PAH",43,1,547,0)="             CHKLINES    May this message be sent to a remote site?"
^DIC(9.4,4,22,1,"PAH",43,1,548,0)="             CHKMSG      Is message really there & may user access it?"
^DIC(9.4,4,22,1,"PAH",43,1,549,0)="             GETRESTR    Get restrictions on what user may do with message"
^DIC(9.4,4,22,1,"PAH",43,1,550,0)="             OPTGRP      What may user do at basket/message group level?"
