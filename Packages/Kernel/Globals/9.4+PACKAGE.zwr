^DIC(9.4,100,22,15,"PAH",42,0)="72^3011016^1"
^DIC(9.4,100,22,15,"PAH",42,1,0)="^^101^101^3011016"
^DIC(9.4,100,22,15,"PAH",42,1,1,0)="This patch addresses the following issue in the Mental Health software. "
^DIC(9.4,100,22,15,"PAH",42,1,2,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,3,0)=" 1. In the MH INSTRUMENT file (#601) field OPERATIONAL (#32), data value"
^DIC(9.4,100,22,15,"PAH",42,1,4,0)="    has been changed from null to ""N"" in the following instruments CES,"
^DIC(9.4,100,22,15,"PAH",42,1,5,0)="    FES, GES, WES, CPI, FIRO, SII, MYER, MCMI, MMPR and the M168.  This"
^DIC(9.4,100,22,15,"PAH",42,1,6,0)="    field when SET to ""N"" indicates that the instrument is NOT operational."
^DIC(9.4,100,22,15,"PAH",42,1,7,0)="    This allows the instrument to remain in the data base but can NOT be"
^DIC(9.4,100,22,15,"PAH",42,1,8,0)="    USED."
^DIC(9.4,100,22,15,"PAH",42,1,9,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,10,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,11,0)="    Test Site(s): Salt Lake City, UT "
^DIC(9.4,100,22,15,"PAH",42,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,13,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,14,0)="    ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",42,1,15,0)="    ================"
^DIC(9.4,100,22,15,"PAH",42,1,16,0)="    The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",42,1,17,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,18,0)="    <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",42,1,19,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,20,0)="                                     Checksum Values"
^DIC(9.4,100,22,15,"PAH",42,1,21,0)="    Routine Name    Before Patch        After Patch     Patch List"
^DIC(9.4,100,22,15,"PAH",42,1,22,0)="    ------------    ------------        -----------     -----------"
^DIC(9.4,100,22,15,"PAH",42,1,23,0)="    NO ROUTINES EXPORTED WITH THIS PATCH        "
^DIC(9.4,100,22,15,"PAH",42,1,24,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,25,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,26,0)="  "
^DIC(9.4,100,22,15,"PAH",42,1,27,0)="   SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",42,1,28,0)="   ==================="
^DIC(9.4,100,22,15,"PAH",42,1,29,0)="   "
^DIC(9.4,100,22,15,"PAH",42,1,30,0)="   The following software and documentation files are exported as part of"
^DIC(9.4,100,22,15,"PAH",42,1,31,0)="   this patch:"
^DIC(9.4,100,22,15,"PAH",42,1,32,0)="  "
^DIC(9.4,100,22,15,"PAH",42,1,33,0)="    File Name               Contents                      Retrieval Format"
^DIC(9.4,100,22,15,"PAH",42,1,34,0)="    ---------               --------                      ----------------"
^DIC(9.4,100,22,15,"PAH",42,1,35,0)="    YS_501_72.KID           YS*5.01*72 KIDS build               ASCII"
^DIC(9.4,100,22,15,"PAH",42,1,36,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,37,0)="   The software files are available on one of the following OI Field"
^DIC(9.4,100,22,15,"PAH",42,1,38,0)="   Offices' ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",42,1,39,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,40,0)="   All sites are encouraged to use their FTP capability to obtain these "
^DIC(9.4,100,22,15,"PAH",42,1,41,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",42,1,42,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",42,1,43,0)="   are located."
^DIC(9.4,100,22,15,"PAH",42,1,44,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,45,0)="      OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,100,22,15,"PAH",42,1,46,0)="      ===============    ===========                ========="
^DIC(9.4,100,22,15,"PAH",42,1,47,0)="      ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",42,1,48,0)="      HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",42,1,49,0)="      SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",42,1,50,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,51,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,52,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",42,1,53,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",42,1,54,0)="   This patch should be installed during 'OFF PEAK' hours when few or no "
^DIC(9.4,100,22,15,"PAH",42,1,55,0)="   users are on the system.  Installation of the patch will take less than"
^DIC(9.4,100,22,15,"PAH",42,1,56,0)="   5 minutes."
^DIC(9.4,100,22,15,"PAH",42,1,57,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,58,0)="   1.  START UP KIDS"
^DIC(9.4,100,22,15,"PAH",42,1,59,0)="       From the KERNEL Installation and Distribution Systems (KIDS)"
^DIC(9.4,100,22,15,"PAH",42,1,60,0)="       Menu, select the Installation menu [XPD INSTALLATION MENU]:  "
^DIC(9.4,100,22,15,"PAH",42,1,61,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,62,0)="          Edits and Distribution ..."
^DIC(9.4,100,22,15,"PAH",42,1,63,0)="          Utilities ..."
^DIC(9.4,100,22,15,"PAH",42,1,64,0)="          Installation ..."
^DIC(9.4,100,22,15,"PAH",42,1,65,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,66,0)="   2.  SELECT INSTALLATION OPTION"
^DIC(9.4,100,22,15,"PAH",42,1,67,0)="       Select Installation Option:  Load a Distribution"
^DIC(9.4,100,22,15,"PAH",42,1,68,0)="       Enter a Host File: YS_501_72.KID"
^DIC(9.4,100,22,15,"PAH",42,1,69,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,70,0)="       This Distribution contains Transport Globals for the following"
^DIC(9.4,100,22,15,"PAH",42,1,71,0)="       Package(s):         YS*5.01*72"
^DIC(9.4,100,22,15,"PAH",42,1,72,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,73,0)="       Use INSTALL NAME: YS*5.01*72 to install the Distribution."
^DIC(9.4,100,22,15,"PAH",42,1,74,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,75,0)="       NOTE:  The following are OPTIONAL:"
^DIC(9.4,100,22,15,"PAH",42,1,76,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,77,0)="       a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,100,22,15,"PAH",42,1,78,0)="           message of any routines exported with this patch. It will not"
^DIC(9.4,100,22,15,"PAH",42,1,79,0)="           backup any other changes, such as DDs or templates."
^DIC(9.4,100,22,15,"PAH",42,1,80,0)="       b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,100,22,15,"PAH",42,1,81,0)="       a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,100,22,15,"PAH",42,1,82,0)="           message of any routines exported with this patch. It will not"
^DIC(9.4,100,22,15,"PAH",42,1,83,0)="           backup any other changes, such as DDs or templates."
^DIC(9.4,100,22,15,"PAH",42,1,84,0)="       b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,100,22,15,"PAH",42,1,85,0)="           allow you to view all changes that will be made when this patch"
^DIC(9.4,100,22,15,"PAH",42,1,86,0)="           is installed.  It compares all components of this patch"
^DIC(9.4,100,22,15,"PAH",42,1,87,0)="           (routines, DDs, templates, etc.)."
^DIC(9.4,100,22,15,"PAH",42,1,88,0)="       c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,100,22,15,"PAH",42,1,89,0)="           you to ensure the integrity of the routines that are in the"
^DIC(9.4,100,22,15,"PAH",42,1,90,0)="           transport global."
^DIC(9.4,100,22,15,"PAH",42,1,91,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,92,0)="   3.  SELECT INSTALLATION OPTION: Install Package(s)"
^DIC(9.4,100,22,15,"PAH",42,1,93,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,94,0)="       Select KIDS OPTION:  INSTALL PACKAGE(S)"
^DIC(9.4,100,22,15,"PAH",42,1,95,0)="       Select INSTALL NAME: YS*5.01*72"
^DIC(9.4,100,22,15,"PAH",42,1,96,0)=" "
^DIC(9.4,100,22,15,"PAH",42,1,97,0)="   4.  When asked ""Want KIDS to INHIBIT LOGONS during the install? Yes//"","
^DIC(9.4,100,22,15,"PAH",42,1,98,0)="       respond ""NO""."
^DIC(9.4,100,22,15,"PAH",42,1,99,0)=""
^DIC(9.4,100,22,15,"PAH",42,1,100,0)="   5.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,100,22,15,"PAH",42,1,101,0)="       Protocols? YES//, respond ""NO""."
^DIC(9.4,100,22,15,"PAH",43,0)="67^3011106^1"
^DIC(9.4,100,22,15,"PAH",43,1,0)="^^175^175^3011106"
^DIC(9.4,100,22,15,"PAH",43,1,1,0)="Patch YS*5.01*67 COTS ASI-MV introduces the required components necessary to"
^DIC(9.4,100,22,15,"PAH",43,1,2,0)="install and run the Commercial Off the Shelf (COTS) Addiction Severity Index"
^DIC(9.4,100,22,15,"PAH",43,1,3,0)="Multimedia Version (ASI-MV) software product."
^DIC(9.4,100,22,15,"PAH",43,1,4,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,5,0)="The Mental Health ASI-MV, Vista version, is a software product that is the"
^DIC(9.4,100,22,15,"PAH",43,1,6,0)="result of the combination of a commercial (COTS) multimedia application"
^DIC(9.4,100,22,15,"PAH",43,1,7,0)="(ASIMV) and a VA-developed interface to the VistA database (YSASIMV). The"
^DIC(9.4,100,22,15,"PAH",43,1,8,0)="ASI-MV is a patient self-administered psychological instrument that can be"
^DIC(9.4,100,22,15,"PAH",43,1,9,0)="used to gather patient data directly from the patient. Both the clinician"
^DIC(9.4,100,22,15,"PAH",43,1,10,0)="and the patient interact with the ASI-MV. The clinician logs on to VistA,"
^DIC(9.4,100,22,15,"PAH",43,1,11,0)="initializes program parameters, and enters patient demographic info. The"
^DIC(9.4,100,22,15,"PAH",43,1,12,0)="patient then responds to questions presented by the multimedia interface."
^DIC(9.4,100,22,15,"PAH",43,1,13,0)="The clinician needs not be present during the time when the patient is"
^DIC(9.4,100,22,15,"PAH",43,1,14,0)="responding to questions. After the patient completes the interview, the"
^DIC(9.4,100,22,15,"PAH",43,1,15,0)="clinician starts the interface (YSASIMV) again, to upload the interview"
^DIC(9.4,100,22,15,"PAH",43,1,16,0)="data to VistA."
^DIC(9.4,100,22,15,"PAH",43,1,17,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,18,0)="SecureDesktop is a software module that restricts user (patient) access to "
^DIC(9.4,100,22,15,"PAH",43,1,19,0)="the Windows desktop, to task-switching functions, and to other programs on"
^DIC(9.4,100,22,15,"PAH",43,1,20,0)="the workstation, while the patient responds to the interview. This module "
^DIC(9.4,100,22,15,"PAH",43,1,21,0)="implements the bulk of security countermeasures for the ASI-MV system."
^DIC(9.4,100,22,15,"PAH",43,1,22,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,23,0)="The patch contains the following additions and modifications to the VistA"
^DIC(9.4,100,22,15,"PAH",43,1,24,0)="Mental Health software:"
^DIC(9.4,100,22,15,"PAH",43,1,25,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,26,0)="Data in the ASI QUICK FORM file (#604.66), REQUIRED field (#11) has been"
^DIC(9.4,100,22,15,"PAH",43,1,27,0)="changed from '1' to a Null value making the following questions to be "
^DIC(9.4,100,22,15,"PAH",43,1,28,0)="non-required for scoring the ASI: M10, M11, E23, E24, L31, L32, F37, F38,"
^DIC(9.4,100,22,15,"PAH",43,1,29,0)="P21 and P22.  This process will be performed by the post routine YS67."
^DIC(9.4,100,22,15,"PAH",43,1,30,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,31,0)="The ADDICTION SEVERITY INDEX file (#604) fields CLASS (#.04) and CONTACT CODE "
^DIC(9.4,100,22,15,"PAH",43,1,32,0)="(#.07) have a new selection code, ""For ASI-MV""."
^DIC(9.4,100,22,15,"PAH",43,1,33,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,34,0)="The ADDICTION SEVERITY INDEX file (#604) fields ELECTRONICALLY SIGNED "
^DIC(9.4,100,22,15,"PAH",43,1,35,0)="(#.51) and E SIGNATURE INTERVIEWER (#.52) data attributes have been changed"
^DIC(9.4,100,22,15,"PAH",43,1,36,0)="to allow these fields data to be edited."
^DIC(9.4,100,22,15,"PAH",43,1,37,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,38,0)="Two new entries have been added to the ASI NARRATIVE file (#604.68).  "
^DIC(9.4,100,22,15,"PAH",43,1,39,0)="The two new narrative reports are the ASI-MV ITEM REPORT and the ASI-MV"
^DIC(9.4,100,22,15,"PAH",43,1,40,0)="NARRATIVE."
^DIC(9.4,100,22,15,"PAH",43,1,41,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,42,0)="The routine YSASNAR has been modified to produce the ASI-MV ITEM REPORT and "
^DIC(9.4,100,22,15,"PAH",43,1,43,0)="the ASI-MV NARRATIVE."
^DIC(9.4,100,22,15,"PAH",43,1,44,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,45,0)="The new option YS BROKER [YS BROKER] contains the context necessary"
^DIC(9.4,100,22,15,"PAH",43,1,46,0)="to interface the ASI-MV to VistA."
^DIC(9.4,100,22,15,"PAH",43,1,47,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,48,0)="A Remote Procedure YTAPI NEW ASI has been created."
^DIC(9.4,100,22,15,"PAH",43,1,49,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,50,0)="The new routine YTAPI8 allows silent additions to the ADDICTION SEVERITY INDEX "
^DIC(9.4,100,22,15,"PAH",43,1,51,0)="file (#604)."
^DIC(9.4,100,22,15,"PAH",43,1,52,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,53,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,54,0)="   Test Site(s): Boston Health Care System, MA"
^DIC(9.4,100,22,15,"PAH",43,1,55,0)="                 Puget Sound Health Care System, WA"
^DIC(9.4,100,22,15,"PAH",43,1,56,0)="                 Salt Lake City, UT"
^DIC(9.4,100,22,15,"PAH",43,1,57,0)="                 VA Health Care Network Upstate New York System, NY"
^DIC(9.4,100,22,15,"PAH",43,1,58,0)="                 White City, OR"
^DIC(9.4,100,22,15,"PAH",43,1,59,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,60,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,61,0)="   Routine Summary"
^DIC(9.4,100,22,15,"PAH",43,1,62,0)="   ==============="
^DIC(9.4,100,22,15,"PAH",43,1,63,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,64,0)="   The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",43,1,65,0)="   "
^DIC(9.4,100,22,15,"PAH",43,1,66,0)="   <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",43,1,67,0)="    "
^DIC(9.4,100,22,15,"PAH",43,1,68,0)="                                Checksum Values"
^DIC(9.4,100,22,15,"PAH",43,1,69,0)="    "
^DIC(9.4,100,22,15,"PAH",43,1,70,0)="   Routine Name       Before Patch        After Patch      Patch List"
^DIC(9.4,100,22,15,"PAH",43,1,71,0)="   ------------       ------------        -----------      ----------"
^DIC(9.4,100,22,15,"PAH",43,1,72,0)="   YS67                    N/A                 182239      67 (Deleted by Kids)"
^DIC(9.4,100,22,15,"PAH",43,1,73,0)="   YSASNAR                11561066           11815417      24,30,37,38,44"
^DIC(9.4,100,22,15,"PAH",43,1,74,0)="                                                           55,67"
^DIC(9.4,100,22,15,"PAH",43,1,75,0)="   YTAPI8                  N/A                3139609      67"
^DIC(9.4,100,22,15,"PAH",43,1,76,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,77,0)="   SOFTWARE RETRIEVAL:"
^DIC(9.4,100,22,15,"PAH",43,1,78,0)="   ==================="
^DIC(9.4,100,22,15,"PAH",43,1,79,0)="   "
^DIC(9.4,100,22,15,"PAH",43,1,80,0)="   The following software and documentation files are exported as part of"
^DIC(9.4,100,22,15,"PAH",43,1,81,0)="   this patch:"
^DIC(9.4,100,22,15,"PAH",43,1,82,0)="  "
^DIC(9.4,100,22,15,"PAH",43,1,83,0)="    File Name               Contents                      Retrieval Format"
^DIC(9.4,100,22,15,"PAH",43,1,84,0)="    ---------               --------                      ----------------"
^DIC(9.4,100,22,15,"PAH",43,1,85,0)="    YS_501_67.KID           YS*5.01*67 KIDS build               ASCII"
^DIC(9.4,100,22,15,"PAH",43,1,86,0)="    YS_501_67.ZIP                                               BINARY"
^DIC(9.4,100,22,15,"PAH",43,1,87,0)="     - YS50167_ASIMV.EXE          ASI-MV Interface Executable"
^DIC(9.4,100,22,15,"PAH",43,1,88,0)="     - YS50167_SecureDesktop.EXE  Secure Desktop Executable"
^DIC(9.4,100,22,15,"PAH",43,1,89,0)="     - YS50167_KeyboardHook.DLL   Keyboard Hook DLL used by Secure Desktop"
^DIC(9.4,100,22,15,"PAH",43,1,90,0)="     - YSASIMV_IGUM.PDF     YS*5.01*67 ASI-MV Installation Guide"
^DIC(9.4,100,22,15,"PAH",43,1,91,0)="                                              User Manual"
^DIC(9.4,100,22,15,"PAH",43,1,92,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,93,0)="   The software files are available on one of the following OI Field"
^DIC(9.4,100,22,15,"PAH",43,1,94,0)="   Offices' ANONYMOUS.SOFTWARE directories."
^DIC(9.4,100,22,15,"PAH",43,1,95,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,96,0)="   All sites are encouraged to use their FTP capability to obtain these "
^DIC(9.4,100,22,15,"PAH",43,1,97,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,100,22,15,"PAH",43,1,98,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,100,22,15,"PAH",43,1,99,0)="   are located."
^DIC(9.4,100,22,15,"PAH",43,1,100,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,101,0)="      OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,100,22,15,"PAH",43,1,102,0)="      ===============    ===========                ========="
^DIC(9.4,100,22,15,"PAH",43,1,103,0)="      ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",43,1,104,0)="      HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",43,1,105,0)="      SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,100,22,15,"PAH",43,1,106,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,107,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,108,0)="   Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",43,1,109,0)="   =========================="
^DIC(9.4,100,22,15,"PAH",43,1,110,0)="   This patch should be installed during 'OFF PEAK' hours when few or no users"
^DIC(9.4,100,22,15,"PAH",43,1,111,0)="   are on the system.  Installation of the patch will take less than 5 minutes."
^DIC(9.4,100,22,15,"PAH",43,1,112,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,113,0)="   1.  START UP KIDS"
^DIC(9.4,100,22,15,"PAH",43,1,114,0)="       From the KERNEL Installation and Distribution Systems (KIDS)"
^DIC(9.4,100,22,15,"PAH",43,1,115,0)="       Menu, select the Installation menu [XPD INSTALLATION MENU]:  "
^DIC(9.4,100,22,15,"PAH",43,1,116,0)="          Installation"
^DIC(9.4,100,22,15,"PAH",43,1,117,0)="          Edits and Distribution ..."
^DIC(9.4,100,22,15,"PAH",43,1,118,0)="          Utilities ..."
^DIC(9.4,100,22,15,"PAH",43,1,119,0)="          Installation ..."
^DIC(9.4,100,22,15,"PAH",43,1,120,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,121,0)="   2.  SELECT INSTALLATION OPTION"
^DIC(9.4,100,22,15,"PAH",43,1,122,0)="       Select Installation Option:  Load a Distribution"
^DIC(9.4,100,22,15,"PAH",43,1,123,0)="       Enter a Host File: YS_501_67.KID"
^DIC(9.4,100,22,15,"PAH",43,1,124,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,125,0)="       This Distribution contains Transport Globals for the following"
^DIC(9.4,100,22,15,"PAH",43,1,126,0)="       Package(s):         YS*5.01*67"
^DIC(9.4,100,22,15,"PAH",43,1,127,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,128,0)="       Use INSTALL NAME: YS*5.01*67 to install the Distribution."
^DIC(9.4,100,22,15,"PAH",43,1,129,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,130,0)="       NOTE:  The following are OPTIONAL:"
^DIC(9.4,100,22,15,"PAH",43,1,131,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,132,0)="       a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,100,22,15,"PAH",43,1,133,0)="           message of any routines exported with this patch. It will not"
^DIC(9.4,100,22,15,"PAH",43,1,134,0)="           backup any other changes, such as DDs or templates."
^DIC(9.4,100,22,15,"PAH",43,1,135,0)="       b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,100,22,15,"PAH",43,1,136,0)="           allow you to view all changes that will be made when this patch"
^DIC(9.4,100,22,15,"PAH",43,1,137,0)="           is installed.  It compares all components of this patch"
^DIC(9.4,100,22,15,"PAH",43,1,138,0)="           (routines, DDs, templates, etc.)."
^DIC(9.4,100,22,15,"PAH",43,1,139,0)="       c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,100,22,15,"PAH",43,1,140,0)="           you to ensure the integrity of the routines that are in the"
^DIC(9.4,100,22,15,"PAH",43,1,141,0)="           transport global."
^DIC(9.4,100,22,15,"PAH",43,1,142,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,143,0)="   3.  SELECT INSTALLATION OPTION: Install Package(s)"
^DIC(9.4,100,22,15,"PAH",43,1,144,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,145,0)="       Select KIDS OPTION:  INSTALL PACKAGE(S)"
^DIC(9.4,100,22,15,"PAH",43,1,146,0)="       Select INSTALL NAME: YS*5.01*67"
^DIC(9.4,100,22,15,"PAH",43,1,147,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,148,0)="   4.  When prompted ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,100,22,15,"PAH",43,1,149,0)="       Install? Yes//"", respond ""NO""."
^DIC(9.4,100,22,15,"PAH",43,1,150,0)="  "
^DIC(9.4,100,22,15,"PAH",43,1,151,0)="   5.  When asked ""Want KIDS to INHIBIT LOGONS during the install? Yes//"","
^DIC(9.4,100,22,15,"PAH",43,1,152,0)="       respond ""NO""."
^DIC(9.4,100,22,15,"PAH",43,1,153,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,154,0)="   6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,100,22,15,"PAH",43,1,155,0)="       Protocols? YES//, respond YES.  When prompted to select the options"
^DIC(9.4,100,22,15,"PAH",43,1,156,0)="       you would like to place out of order, enter the following:"
^DIC(9.4,100,22,15,"PAH",43,1,157,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,158,0)="       Addiction Severity Index [YSAS ASI USER MENU]"
^DIC(9.4,100,22,15,"PAH",43,1,159,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,160,0)="   7.  Retrieve and open the file:  YS_501_67.ZIP"
^DIC(9.4,100,22,15,"PAH",43,1,161,0)="  "
^DIC(9.4,100,22,15,"PAH",43,1,162,0)="   8.  Place the MENTAL HEALTH ADDICTION SEVERITY INDEX MULTIMEDIA VERSION"
^DIC(9.4,100,22,15,"PAH",43,1,163,0)="       (ASI-MV) INSTALLATION AND USER GUIDE in a location that can be"
^DIC(9.4,100,22,15,"PAH",43,1,164,0)="       accessed by ASI-MV users."
^DIC(9.4,100,22,15,"PAH",43,1,165,0)="  "
^DIC(9.4,100,22,15,"PAH",43,1,166,0)="   9.  Please refer to the POST INSTALLATION INSTRUCTIONS section of the"
^DIC(9.4,100,22,15,"PAH",43,1,167,0)="       MENTAL HEALTH ADDICTION SEVERITY INDEX MULTIMEDIA VERSION (ASI-MV)"
^DIC(9.4,100,22,15,"PAH",43,1,168,0)="       INSTALLATION AND USER GUIDE to install the COTS ASI-MV software,"
^DIC(9.4,100,22,15,"PAH",43,1,169,0)="       YS50167_ASIMV.EXE, YS50167_SecureDesktop.EXE and"
^DIC(9.4,100,22,15,"PAH",43,1,170,0)="       YS50167_KeyboardHook.DLL."
^DIC(9.4,100,22,15,"PAH",43,1,171,0)=""
^DIC(9.4,100,22,15,"PAH",43,1,172,0)="  10.  Place the option YS BROKER [YS BROKER] on the Mental Health users"
^DIC(9.4,100,22,15,"PAH",43,1,173,0)="       secondary menu."
^DIC(9.4,100,22,15,"PAH",43,1,174,0)=" "
^DIC(9.4,100,22,15,"PAH",43,1,175,0)="  11.  Routine YS67 will be deleted after successful patch installation."
^DIC(9.4,100,22,15,"PAH",44,0)="73 SEQ #63^3020327^1"
^DIC(9.4,100,22,15,"PAH",45,0)="71^3020626^1"
^DIC(9.4,100,22,15,"PAH",45,1,0)="^^199^199^3020626"
^DIC(9.4,100,22,15,"PAH",45,1,1,0)="Associated patches: (v)SD*5.3*262 install with patch       `YS*5.01*71'"
^DIC(9.4,100,22,15,"PAH",45,1,2,0)="                    (v)XU*8*234   install with patch       `YS*5.01*71'"
^DIC(9.4,100,22,15,"PAH",45,1,3,0)="                    (v)DG*5.3*447 install with patch       `YS*5.01*71'"
^DIC(9.4,100,22,15,"PAH",45,1,4,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,5,0)="Patch YS*5.01*71 introduces the Mental Health Assistant Graphical User"
^DIC(9.4,100,22,15,"PAH",45,1,6,0)="Interface to VISTA."
^DIC(9.4,100,22,15,"PAH",45,1,7,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,8,0)="The Mental Health Assistant (MHA) is a graphical user interface for the"
^DIC(9.4,100,22,15,"PAH",45,1,9,0)="most frequently used options within the VistA Mental Health Package,"
^DIC(9.4,100,22,15,"PAH",45,1,10,0)="viz., psychological testing, the Addiction Severity Index (ASI), and"
^DIC(9.4,100,22,15,"PAH",45,1,11,0)="the Global Assessment of Functioning (GAF)."
^DIC(9.4,100,22,15,"PAH",45,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,13,0)="All previous tests completed by the selected patient are listed on the"
^DIC(9.4,100,22,15,"PAH",45,1,14,0)="Test Results tab.  A text report is shown for the selected test, and"
^DIC(9.4,100,22,15,"PAH",45,1,15,0)="graphs of numeric scores are available across all instances of a given"
^DIC(9.4,100,22,15,"PAH",45,1,16,0)="test."
^DIC(9.4,100,22,15,"PAH",45,1,17,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,18,0)="The Order Tests tab enables the user to specify the staff person"
^DIC(9.4,100,22,15,"PAH",45,1,19,0)="ordering the test and to select from among the tests available to the"
^DIC(9.4,100,22,15,"PAH",45,1,20,0)="person who ordered the test.  Three data entry modes are available:"
^DIC(9.4,100,22,15,"PAH",45,1,21,0)="(1)  Staff entry is optimized for the entry of staff rating data (e.g.,"
^DIC(9.4,100,22,15,"PAH",45,1,22,0)="     the AIMS), which requires the user to see the test questions and"
^DIC(9.4,100,22,15,"PAH",45,1,23,0)="     answers."
^DIC(9.4,100,22,15,"PAH",45,1,24,0)="(2)  Clerk entry is optimized for transcribing test data from paper"
^DIC(9.4,100,22,15,"PAH",45,1,25,0)="     answer sheets."
^DIC(9.4,100,22,15,"PAH",45,1,26,0)="(3)  Patient entry is optimized for on-line testing of patients.  The"
^DIC(9.4,100,22,15,"PAH",45,1,27,0)="     patient entry option contains security features to prevent"
^DIC(9.4,100,22,15,"PAH",45,1,28,0)="     unattended patients from using the PC in unauthorized ways."
^DIC(9.4,100,22,15,"PAH",45,1,29,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,30,0)="The ASI tab lists all previous ASI interviews and makes it easy to view"
^DIC(9.4,100,22,15,"PAH",45,1,31,0)="either the item report or narrative report for a selected interview."
^DIC(9.4,100,22,15,"PAH",45,1,32,0)="To help with ASI performance measure compliance, the interval since the"
^DIC(9.4,100,22,15,"PAH",45,1,33,0)="last interview is displayed.  New views of ASI data are the ""Domain"
^DIC(9.4,100,22,15,"PAH",45,1,34,0)="Scores"" and ""Item Trends"" buttons, which present graphical and tabular"
^DIC(9.4,100,22,15,"PAH",45,1,35,0)="data across multiple interviews.  The Domain Scores button gives the"
^DIC(9.4,100,22,15,"PAH",45,1,36,0)="user the opportunity to see either problem severity ratings or"
^DIC(9.4,100,22,15,"PAH",45,1,37,0)="evaluation factor scores.  The Item Trends button displays responses to"
^DIC(9.4,100,22,15,"PAH",45,1,38,0)="selected individual items.  It is hoped that these data views will help"
^DIC(9.4,100,22,15,"PAH",45,1,39,0)="with treatment planning and treatment outcome monitoring.  A user-"
^DIC(9.4,100,22,15,"PAH",45,1,40,0)="friendly interface for entering interview data is provided.  This tab"
^DIC(9.4,100,22,15,"PAH",45,1,41,0)="enables staff to quickly enter data, to easily jump from one item to"
^DIC(9.4,100,22,15,"PAH",45,1,42,0)="another, and to enter free text comments at any time.  This tab should"
^DIC(9.4,100,22,15,"PAH",45,1,43,0)="greatly reduce data entry time, whether transcribing interview results"
^DIC(9.4,100,22,15,"PAH",45,1,44,0)="from a paper form or entering them on-line during an interview."
^DIC(9.4,100,22,15,"PAH",45,1,45,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,46,0)="The GAF tab affords the user an easy way to enter GAF ratings and to"
^DIC(9.4,100,22,15,"PAH",45,1,47,0)="see previous ratings, which are graphed to indicate trends.  When"
^DIC(9.4,100,22,15,"PAH",45,1,48,0)="entering a new rating, the rating is associated with the GAF rating"
^DIC(9.4,100,22,15,"PAH",45,1,49,0)="criteria.  It is hoped this association will increase the reliability"
^DIC(9.4,100,22,15,"PAH",45,1,50,0)="of ratings and reduce inter-rater variability in the assignment of GAF"
^DIC(9.4,100,22,15,"PAH",45,1,51,0)="ratings."
^DIC(9.4,100,22,15,"PAH",45,1,52,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,53,0)="The patch contains one option, a data change to the PAI entry in the MH"
^DIC(9.4,100,22,15,"PAH",45,1,54,0)="MULTIPLE SCORING (#601.6) file, a data change to the MMPI2, AUDC and"
^DIC(9.4,100,22,15,"PAH",45,1,55,0)="the DOMG entries in the MH INSTRUMENT (#601) file, 16 routines and 28"
^DIC(9.4,100,22,15,"PAH",45,1,56,0)="Remote Procedures."
^DIC(9.4,100,22,15,"PAH",45,1,57,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,58,0)="The new non-menu option YS BROKER1 [YS BROKER1] contains the context"
^DIC(9.4,100,22,15,"PAH",45,1,59,0)="necessary to interface the MHA GUI to VistA."
^DIC(9.4,100,22,15,"PAH",45,1,60,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,61,0)="             E3R#:   16712"
^DIC(9.4,100,22,15,"PAH",45,1,62,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,63,0)="  Associated NOIS:   None"
^DIC(9.4,100,22,15,"PAH",45,1,64,0)="     Test Site(s):   Minneapolis VAMC, MN"
^DIC(9.4,100,22,15,"PAH",45,1,65,0)="                     Salt Lake City HCS, UT"
^DIC(9.4,100,22,15,"PAH",45,1,66,0)="                     VA Health Care Network Upstate New York"
^DIC(9.4,100,22,15,"PAH",45,1,67,0)="                     VA N. Florida/S. Georgia Veterans HCS"
^DIC(9.4,100,22,15,"PAH",45,1,68,0)="                     VA North Texas HCS"
^DIC(9.4,100,22,15,"PAH",45,1,69,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,70,0)=" "
^DIC(9.4,100,22,15,"PAH",45,1,71,0)=" "
