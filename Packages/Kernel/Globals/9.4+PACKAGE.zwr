^DIC(9.4,33,22,1.4,"PAH",35,1,209,0)=" HLCSORAT         5245857         5441831       57"
^DIC(9.4,33,22,1.4,"PAH",35,1,210,0)=" HLCSRPT3        10792707        10830740       50,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,211,0)=" HLCSTCP          4469052         5152314       19,43,49,57"
^DIC(9.4,33,22,1.4,"PAH",35,1,212,0)=" HLCSTCP1         4899040         4965932       19,43,57"
