^DIC(9.4,48,22,5.28,"PAH",684,1,4,0)="VSE-8421: BB - VistA: VistA: Create a new RPC to return the consecutive "
^DIC(9.4,48,22,5.28,"PAH",684,1,5,0)="          timeslots to ISS"
^DIC(9.4,48,22,5.28,"PAH",684,1,6,0)="VSE-8773: MB - VistA: Time zone offset issue on last day of daylight"
