^DIC(9.4,44,22,3,"PAH",22,0)="23 SEQ #22^3020116^1"
^DIC(9.4,44,22,3,"PAH",22,1,0)="^^1^1^3020116"
^DIC(9.4,44,22,3,"PAH",22,1,1,0)="Build can be found on the National Patch Module under Patch GMRC*3.0*23."
^DIC(9.4,44,22,3,"PAH",23,0)="22^3020408^1"
^DIC(9.4,44,22,3,"PAH",23,1,0)="^^2^2^3020408"
^DIC(9.4,44,22,3,"PAH",23,1,1,0)="This BUILD includes the Inter-facility Consults enhancement. See the "
^DIC(9.4,44,22,3,"PAH",23,1,2,0)="National Patch Module for full details."
