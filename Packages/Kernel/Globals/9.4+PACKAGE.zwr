^DIC(9.4,3,22,21,"PAH",127,1,69,0)="List of preceding patches: 20, 127"
^DIC(9.4,3,22,21,"PAH",127,1,70,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",127,1,71,0)=""
^DIC(9.4,3,22,21,"PAH",127,1,72,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",127,1,73,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",127,1,74,0)=""
^DIC(9.4,3,22,21,"PAH",127,1,75,0)=">>>Users may remain on the system.  STOP TASKMAN. <<<"
^DIC(9.4,3,22,21,"PAH",127,1,76,0)=""
^DIC(9.4,3,22,21,"PAH",127,1,77,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",127,1,78,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",127,1,79,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,80,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",127,1,81,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",127,1,82,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,83,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",127,1,84,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",127,1,85,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",127,1,86,0)="      options:"
^DIC(9.4,3,22,21,"PAH",127,1,87,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,88,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",127,1,89,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",127,1,90,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",127,1,91,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",127,1,92,0)="         "
^DIC(9.4,3,22,21,"PAH",127,1,93,0)=" 4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",127,1,94,0)="     non-peak time."
^DIC(9.4,3,22,21,"PAH",127,1,95,0)="     STOP TASKMAN. D STOP^ZTMKU"
^DIC(9.4,3,22,21,"PAH",127,1,96,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,97,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",127,1,98,0)="      option:"
^DIC(9.4,3,22,21,"PAH",127,1,99,0)="         Install Package(s)  'XU*8.0*136'"
^DIC(9.4,3,22,21,"PAH",127,1,100,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",127,1,101,0)="                              "
^DIC(9.4,3,22,21,"PAH",127,1,102,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",127,1,103,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",127,1,104,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",127,1,105,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,106,0)="  8.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",127,1,107,0)="      Cache Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",127,1,108,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",127,1,109,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",127,1,110,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,111,0)="ZIS2"
^DIC(9.4,3,22,21,"PAH",127,1,112,0)="ZIS6"
^DIC(9.4,3,22,21,"PAH",127,1,113,0)="ZOSVONT"
^DIC(9.4,3,22,21,"PAH",127,1,114,0)="ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",127,1,115,0)="ZTLOAD3"
^DIC(9.4,3,22,21,"PAH",127,1,116,0)="ZTM"
^DIC(9.4,3,22,21,"PAH",127,1,117,0)="ZTM0"
^DIC(9.4,3,22,21,"PAH",127,1,118,0)="ZTM5"
^DIC(9.4,3,22,21,"PAH",127,1,119,0)="ZTM6"
^DIC(9.4,3,22,21,"PAH",127,1,120,0)="ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",127,1,121,0)="ZTMON"
^DIC(9.4,3,22,21,"PAH",127,1,122,0)="ZTMS"
^DIC(9.4,3,22,21,"PAH",127,1,123,0)="ZTMS1"
^DIC(9.4,3,22,21,"PAH",127,1,124,0)="ZTMS3"
^DIC(9.4,3,22,21,"PAH",127,1,125,0)="ZTMS4"
^DIC(9.4,3,22,21,"PAH",127,1,126,0)="ZTMS7"
^DIC(9.4,3,22,21,"PAH",127,1,127,0)=""
^DIC(9.4,3,22,21,"PAH",127,1,128,0)="      "
^DIC(9.4,3,22,21,"PAH",127,1,129,0)="  9.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",127,1,130,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",127,1,131,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",127,1,132,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",127,1,133,0)="      Patch number to load: 136"
^DIC(9.4,3,22,21,"PAH",127,1,134,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",127,1,135,0)="       "
^DIC(9.4,3,22,21,"PAH",127,1,136,0)=" 10.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",127,1,137,0)=" 11.  Restart TASKMAN or remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",127,1,138,0)=""
^DIC(9.4,3,22,21,"PAH",127,1,139,0)=""
^DIC(9.4,3,22,21,"PAH",127,1,140,0)="========================================================================="
