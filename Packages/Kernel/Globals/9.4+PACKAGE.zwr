^DIC(9.4,103,22,16,"PAH",6,0)="9 SEQ #8^3180103.172901^54"
^DIC(9.4,103,22,16,"PAH",6,1,0)="^^8^8^3180103"
^DIC(9.4,103,22,16,"PAH",6,1,1,0)="This patch corrects the following issue:"
^DIC(9.4,103,22,16,"PAH",6,1,2,0)=" "
^DIC(9.4,103,22,16,"PAH",6,1,3,0)="If a nurse has changed service positions (for example: from Licensed "
^DIC(9.4,103,22,16,"PAH",6,1,4,0)="Practical Nurse (LPN) to Registered Nurse (RN), the former service "
^DIC(9.4,103,22,16,"PAH",6,1,5,0)="position might be listed on the Intake/Output 24 Hours Itemized "
^DIC(9.4,103,22,16,"PAH",6,1,6,0)="Shift Report.  This issue will occur when the previous service position "
^DIC(9.4,103,22,16,"PAH",6,1,7,0)="for a nurse is filed at a lower internal entry number (IEN) than the "
^DIC(9.4,103,22,16,"PAH",6,1,8,0)="current service position's IEN in the Nurs Position Control (#211.8) file."
