^DIC(9.4,14,22,5.9,"PAH",43,1,118,0)="               Mar 26, 1998@14:02:18"
^DIC(9.4,14,22,5.9,"PAH",44,0)="191 SEQ #142^2980428^1"
^DIC(9.4,14,22,5.9,"PAH",44,1,0)="^^3^3^2980428"
^DIC(9.4,14,22,5.9,"PAH",44,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",44,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",44,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",45,0)="208 SEQ #143^2980428^1"
^DIC(9.4,14,22,5.9,"PAH",45,1,0)="^^1^1^2980428"
^DIC(9.4,14,22,5.9,"PAH",45,1,1,0)="This patch fixes comment problems during receipt of specimens from wards."
^DIC(9.4,14,22,5.9,"PAH",46,0)="189 SEQ #144^2980428^1"
^DIC(9.4,14,22,5.9,"PAH",46,1,0)="^^3^3^2980428"
^DIC(9.4,14,22,5.9,"PAH",46,1,1,0)="This is a patch for VISTA Laboratory Software, version 5.2."
^DIC(9.4,14,22,5.9,"PAH",46,1,2,0)="A detailed description of this patch is included in the patch"
^DIC(9.4,14,22,5.9,"PAH",46,1,3,0)="distribution message."
^DIC(9.4,14,22,5.9,"PAH",47,0)="205 SEQ #145^2980527^1"
^DIC(9.4,14,22,5.9,"PAH",47,1,0)="^^1^1^2980527"
^DIC(9.4,14,22,5.9,"PAH",47,1,1,0)="Required for special processing of file 63 for Patient Merge."
^DIC(9.4,14,22,5.9,"PAH",48,0)="210^2980712^1"
^DIC(9.4,14,22,5.9,"PAH",48,1,0)="^^220^220^2980725^"
^DIC(9.4,14,22,5.9,"PAH",48,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,2,0)="Description: "
^DIC(9.4,14,22,5.9,"PAH",48,1,3,0)="============"
^DIC(9.4,14,22,5.9,"PAH",48,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,5,0)=" Patch LR*5.2*210 VISTA BLOOD BANK SOFTWARE V5.2 DEVICE PRODUCT LABELING"
^DIC(9.4,14,22,5.9,"PAH",48,1,6,0)=" STATEMENT"
^DIC(9.4,14,22,5.9,"PAH",48,1,7,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,8,0)=" April 10, 1998"
^DIC(9.4,14,22,5.9,"PAH",48,1,9,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,10,0)=" VISTA Laboratory Package patch LR*5.2*210 contains changes to software"
^DIC(9.4,14,22,5.9,"PAH",48,1,11,0)=" controlled by VHA DIRECTIVE 97-033, titled VISTA BLOOD BANK SOFTWARE"
^DIC(9.4,14,22,5.9,"PAH",48,1,12,0)=" VERSION 5.2.  Change includes:"
^DIC(9.4,14,22,5.9,"PAH",48,1,13,0)=" LROS was modified to display the Patient Care Encounter (PCE) visit"
^DIC(9.4,14,22,5.9,"PAH",48,1,14,0)=" number when one exists."
^DIC(9.4,14,22,5.9,"PAH",48,1,15,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,16,0)=" The above change has been reviewed by the VISTA Blood Bank Developer and"
^DIC(9.4,14,22,5.9,"PAH",48,1,17,0)=" found to have no impact on the VISTA BLOOD BANK SOFTWARE version 5.2"
^DIC(9.4,14,22,5.9,"PAH",48,1,18,0)=" control functions."
^DIC(9.4,14,22,5.9,"PAH",48,1,19,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,20,0)=" PROBLEM:   Sites have requested a means to verify CPT code capture.  It"
^DIC(9.4,14,22,5.9,"PAH",48,1,21,0)=" was determined that displaying the PCE visit number when viewing the"
^DIC(9.4,14,22,5.9,"PAH",48,1,22,0)=" Order/Test Status for a patient would assist sites in verifying their"
^DIC(9.4,14,22,5.9,"PAH",48,1,23,0)=" data."
^DIC(9.4,14,22,5.9,"PAH",48,1,24,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,25,0)=" RISK ANALYSIS:   Changes made by patch LR*5.2*210 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",48,1,26,0)=" Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",48,1,27,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,28,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS:  Patch LR*5.2*210 does not"
^DIC(9.4,14,22,5.9,"PAH",48,1,29,0)=" alter or modify any software design safeguards or safety critical"
^DIC(9.4,14,22,5.9,"PAH",48,1,30,0)=" elements functions."
^DIC(9.4,14,22,5.9,"PAH",48,1,31,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,32,0)=" POTENTIAL IMPACT ON SITES:  This patch contains changes to a routine"
^DIC(9.4,14,22,5.9,"PAH",48,1,33,0)=" identified in Veterans Health Administration (VHA) Directive 97-033. The"
^DIC(9.4,14,22,5.9,"PAH",48,1,34,0)=" changes have no effect in Blood Bank functionality or medical device"
^DIC(9.4,14,22,5.9,"PAH",48,1,35,0)=" control functions. There is no adverse potential to sites."
^DIC(9.4,14,22,5.9,"PAH",48,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,37,0)=" VALIDATION REQUIREMENTS BY OPTION:  There are no required validation"
^DIC(9.4,14,22,5.9,"PAH",48,1,38,0)=" scenarios to be completed by sites after installing LR*5.2*210."
^DIC(9.4,14,22,5.9,"PAH",48,1,39,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,40,0)=" ============================="
^DIC(9.4,14,22,5.9,"PAH",48,1,41,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,42,0)=" This patch is the regular release of additional National Laboratory Test"
^DIC(9.4,14,22,5.9,"PAH",48,1,43,0)=" Codes (WKLD CODES). It contains the requested additional prefix and"
^DIC(9.4,14,22,5.9,"PAH",48,1,44,0)=" suffix codes required to identify ordered test and test results."
^DIC(9.4,14,22,5.9,"PAH",48,1,45,0)=" LR*5.2*210 Patch Description:"
^DIC(9.4,14,22,5.9,"PAH",48,1,46,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,47,0)=" This patch contains updates of WKLD CODES stored in WKLD CODE file (#64)."
^DIC(9.4,14,22,5.9,"PAH",48,1,48,0)=" These codes are also known as National Laboratory Test codes. The added"
^DIC(9.4,14,22,5.9,"PAH",48,1,49,0)=" codes represent those codes requested, by various sources, to identify"
^DIC(9.4,14,22,5.9,"PAH",48,1,50,0)=" ordered tests and results. If you wish to print the new additional WKLD"
^DIC(9.4,14,22,5.9,"PAH",48,1,51,0)=" CODES, use FileMan Print sorted by numbers. Begin with number 2990, end"
^DIC(9.4,14,22,5.9,"PAH",48,1,52,0)=" with 99999. Select caption print for the print fields."
^DIC(9.4,14,22,5.9,"PAH",48,1,53,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,54,0)=" This patch contains updates of suffix codes stored in WKLD SUFFIX CODES"
^DIC(9.4,14,22,5.9,"PAH",48,1,55,0)=" file (#64.2). These codes were requested, by various sources, to identify"
^DIC(9.4,14,22,5.9,"PAH",48,1,56,0)=" methods used to determine results of ordered tests."
^DIC(9.4,14,22,5.9,"PAH",48,1,57,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,58,0)=" This patch contains updates of manufacturers stored in WKLD INSTRUMENT"
^DIC(9.4,14,22,5.9,"PAH",48,1,59,0)=" MANUFACTURER file (#64.3). This file is a reference file used to group"
^DIC(9.4,14,22,5.9,"PAH",48,1,60,0)=" WKLD CODE SUFFIX codes by manufacturer."
^DIC(9.4,14,22,5.9,"PAH",48,1,61,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,62,0)=" In addition to new NLT Codes the options Order/test status [LROS] and"
^DIC(9.4,14,22,5.9,"PAH",48,1,63,0)=" Review by order number [LRCENLKUP] have been enhanced to display the"
^DIC(9.4,14,22,5.9,"PAH",48,1,64,0)=" Visit number returned by the PCE interface for Laboratory CPT code"
^DIC(9.4,14,22,5.9,"PAH",48,1,65,0)=" capture. The number displayed corresponds to the internal entry number"
^DIC(9.4,14,22,5.9,"PAH",48,1,66,0)=" for the VISIT (#9000010) file. This number maybe useful when verifying"
^DIC(9.4,14,22,5.9,"PAH",48,1,67,0)=" Laboratory CPT workload capture. The VISIT file pointer is free text and"
^DIC(9.4,14,22,5.9,"PAH",48,1,68,0)=" each individual pointer number is separated by a semi-colon. CPT workload"
^DIC(9.4,14,22,5.9,"PAH",48,1,69,0)=" is only captured for patients seen on outpatient status. CPT codes are"
^DIC(9.4,14,22,5.9,"PAH",48,1,70,0)=" captured for ordered tests only. There is no relationship between"
^DIC(9.4,14,22,5.9,"PAH",48,1,71,0)=" accessioned/verified and CPT workload capture. CPT workload capture is"
^DIC(9.4,14,22,5.9,"PAH",48,1,72,0)=" based on entries in the LAB ORDER ENTRY (#69) file ONLY."
^DIC(9.4,14,22,5.9,"PAH",48,1,73,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,74,0)=" Ordered tests must be linked via NATIONAL VA LAB CODE field (#64) of the"
^DIC(9.4,14,22,5.9,"PAH",48,1,75,0)=" LABORATORY TEST file (#60). All CPT codes associated with the linked NLT"
^DIC(9.4,14,22,5.9,"PAH",48,1,76,0)=" Code will be passed to the PCE interface."
^DIC(9.4,14,22,5.9,"PAH",48,1,77,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,78,0)=" The new print option NLT Monthly Workload Detail [LR CAP ELROY] is also"
^DIC(9.4,14,22,5.9,"PAH",48,1,79,0)=" provided. This FileMan print option allows the user to select"
^DIC(9.4,14,22,5.9,"PAH",48,1,80,0)=" institution/division, date range and NLT codes. The report will print"
^DIC(9.4,14,22,5.9,"PAH",48,1,81,0)=" sub-total by NLT code with grand total for the report period. This report"
^DIC(9.4,14,22,5.9,"PAH",48,1,82,0)=" maybe useful when reviewing data stored in LAB MONTHLY WORKLOADS file"
^DIC(9.4,14,22,5.9,"PAH",48,1,83,0)=" (#67.9) for workload trends by specific NLT Codes."
^DIC(9.4,14,22,5.9,"PAH",48,1,84,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,85,0)=" Note: When selecting Institution use literal name (i.e. Long Beach), not"
^DIC(9.4,14,22,5.9,"PAH",48,1,86,0)=" station number (.i.e. 600)."
^DIC(9.4,14,22,5.9,"PAH",48,1,87,0)=" NOTE: Data is stored in the LAB MONTHLY WORKLOADS file by month only."
^DIC(9.4,14,22,5.9,"PAH",48,1,88,0)=" There aren't any daily totals stored in this file."
^DIC(9.4,14,22,5.9,"PAH",48,1,89,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,90,0)=" The Post install procedure will make some corrections to your database if"
^DIC(9.4,14,22,5.9,"PAH",48,1,91,0)=" appropriate. This is a list of possible corrections required by your"
^DIC(9.4,14,22,5.9,"PAH",48,1,92,0)=" systems. If corrections are made, they will be displayed during the"
^DIC(9.4,14,22,5.9,"PAH",48,1,93,0)=" install. They are also stored in the Install file for review."
^DIC(9.4,14,22,5.9,"PAH",48,1,94,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,95,0)=" If the install is successful please remove the routine LR210 from your"
^DIC(9.4,14,22,5.9,"PAH",48,1,96,0)=" system."
^DIC(9.4,14,22,5.9,"PAH",48,1,97,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,98,0)=" NLT Name                    Old Number   New Number   New Name"
^DIC(9.4,14,22,5.9,"PAH",48,1,99,0)=" Gliadin Ab IgA              84295.3103   89589.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,100,0)=" Gliadin Ab IgG              84140.3103   89635.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,101,0)=" Gliadin Ab Panel            82435.3103   89637.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,102,0)=" Specimen Collection Time    82373.3103   89359.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,103,0)=" Rh (D) Typing               86087.0000   86088.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,104,0)=" CD62L                       86601.0000   86682.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,105,0)=" CDw124                      86670.0000   86683.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,106,0)=" Rh Typing                   86714.0000   86712.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,107,0)=" Plateletpheresis            86728.0000   86739.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,108,0)=" Drug Dependant Ab           89110.0000   84466.0000  X*Drug Dependant"
^DIC(9.4,14,22,5.9,"PAH",48,1,109,0)=" HLA DR                      89079.0000   89569.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,110,0)=" Glaidin Ab IgA              84295.0000   84028.0000  X*Glaidin Ab"
^DIC(9.4,14,22,5.9,"PAH",48,1,111,0)=" X*Hepatitis C RNA           97485.0000   87419.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,112,0)=" HIV Viral Load Ultra        98497.0000   87423.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,113,0)=" Smooth Muscle Ab            98589.0000   87379.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,114,0)=" Norchlordiazeposide         81030.0000   81411.0000"
^DIC(9.4,14,22,5.9,"PAH",48,1,115,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,116,0)="     Reference NOIS:  N/A"
^DIC(9.4,14,22,5.9,"PAH",48,1,117,0)="     "
^DIC(9.4,14,22,5.9,"PAH",48,1,118,0)="     Reporting Site:  N/A"
^DIC(9.4,14,22,5.9,"PAH",48,1,119,0)="   "
^DIC(9.4,14,22,5.9,"PAH",48,1,120,0)="     Testing Site(s): Long Beach, CA, Milwaukee, WI, Brockton, MA"
^DIC(9.4,14,22,5.9,"PAH",48,1,121,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,122,0)=" -----------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",48,1,123,0)="  Software Availability:"
^DIC(9.4,14,22,5.9,"PAH",48,1,124,0)="   "
^DIC(9.4,14,22,5.9,"PAH",48,1,125,0)="  This patch is available from one of the CIO Field Offices listed below."
^DIC(9.4,14,22,5.9,"PAH",48,1,126,0)="  All VAMC's are encouraged to use their FTP capability to obtain the"
^DIC(9.4,14,22,5.9,"PAH",48,1,127,0)="  software from the appropriate directory."
^DIC(9.4,14,22,5.9,"PAH",48,1,128,0)="   "
^DIC(9.4,14,22,5.9,"PAH",48,1,129,0)="  CIO Field Office           FTP Address             Directory"
^DIC(9.4,14,22,5.9,"PAH",48,1,130,0)="  ----------------          -------------        -----------------"
^DIC(9.4,14,22,5.9,"PAH",48,1,131,0)="  Hines                     152.129.1.110        anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",48,1,132,0)="  Albany                    152.127.1.5          anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",48,1,133,0)="  Salt Lake                 152.131.2.1          anonymous.software"
^DIC(9.4,14,22,5.9,"PAH",48,1,134,0)="   "
^DIC(9.4,14,22,5.9,"PAH",48,1,135,0)="  File Name:LR52_210.KID"
^DIC(9.4,14,22,5.9,"PAH",48,1,136,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,137,0)="    ROUTINE SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",48,1,138,0)="    ================="
^DIC(9.4,14,22,5.9,"PAH",48,1,139,0)="   "
^DIC(9.4,14,22,5.9,"PAH",48,1,140,0)="    The second line of the routine now looks like:"
^DIC(9.4,14,22,5.9,"PAH",48,1,141,0)="   "
^DIC(9.4,14,22,5.9,"PAH",48,1,142,0)="    <tab>     ;;5.2;LAB SERVICE;**[patch list]**; Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",48,1,143,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,144,0)="  Checksum Values"
^DIC(9.4,14,22,5.9,"PAH",48,1,145,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,146,0)="  Routine Name   Before Patch   After Patch    Patch List "
^DIC(9.4,14,22,5.9,"PAH",48,1,147,0)="  ------------   ------------   -----------   -----------"
^DIC(9.4,14,22,5.9,"PAH",48,1,148,0)=" LR210              NA           13528777         210  "
^DIC(9.4,14,22,5.9,"PAH",48,1,149,0)=" LRCE            12940981        13197719     28,76,103,121"
^DIC(9.4,14,22,5.9,"PAH",48,1,150,0)="                                                153,210"
^DIC(9.4,14,22,5.9,"PAH",48,1,151,0)=" LROS            14491271        14423120     121,153,210"
^DIC(9.4,14,22,5.9,"PAH",48,1,152,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,153,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,154,0)="    Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",48,1,155,0)="    =========================="
^DIC(9.4,14,22,5.9,"PAH",48,1,156,0)=" The Laboratory Information Manager (LIM) should be informed of/coordinate"
^DIC(9.4,14,22,5.9,"PAH",48,1,157,0)=" the installation this patch. This patch contains important codes required"
^DIC(9.4,14,22,5.9,"PAH",48,1,158,0)=" for Laboratory Management Index Program (LMIP) reporting and Laboratory"
^DIC(9.4,14,22,5.9,"PAH",48,1,159,0)=" Electronic Data Interchange (LEDI) implementation."
^DIC(9.4,14,22,5.9,"PAH",48,1,160,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,161,0)=" All users may remain on the system. Laboratory users should be idle (no"
^DIC(9.4,14,22,5.9,"PAH",48,1,162,0)=" accessioning or verifying). The LAB interface routine does not need to"
^DIC(9.4,14,22,5.9,"PAH",48,1,163,0)=" be stopped. The Universal Interface does not need to be stopped. The"
^DIC(9.4,14,22,5.9,"PAH",48,1,164,0)=" Health Level Seven Lower Level Protocols (HL7 LLPs) do not need to be"
^DIC(9.4,14,22,5.9,"PAH",48,1,165,0)=" stopped."
^DIC(9.4,14,22,5.9,"PAH",48,1,166,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,167,0)=" The installation of this patch takes less than 10 minutes."
^DIC(9.4,14,22,5.9,"PAH",48,1,168,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,169,0)="   1.  START FROM KERNEL "
^DIC(9.4,14,22,5.9,"PAH",48,1,170,0)="       From the KERNEL Installation and Distribution Systems (KIDS)"
^DIC(9.4,14,22,5.9,"PAH",48,1,171,0)="       Menu, select the Installation menu [XPD INSTALLATION MENU]:  "
^DIC(9.4,14,22,5.9,"PAH",48,1,172,0)="            Installation"
^DIC(9.4,14,22,5.9,"PAH",48,1,173,0)="            Edits and Distribution ...  "
^DIC(9.4,14,22,5.9,"PAH",48,1,174,0)="            Utilities ...  "
^DIC(9.4,14,22,5.9,"PAH",48,1,175,0)="            Installation ...  "
^DIC(9.4,14,22,5.9,"PAH",48,1,176,0)="      "
^DIC(9.4,14,22,5.9,"PAH",48,1,177,0)="   2.  SELECT INSTALLATION OPTION "
^DIC(9.4,14,22,5.9,"PAH",48,1,178,0)="       Select Installation Option:  Load a Distribution "
^DIC(9.4,14,22,5.9,"PAH",48,1,179,0)="       Enter a Host File: LR52_210.KID"
^DIC(9.4,14,22,5.9,"PAH",48,1,180,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,181,0)="       This Distribution contains Transport Globals for the following "
^DIC(9.4,14,22,5.9,"PAH",48,1,182,0)="       Package(s): LR*5.2*210"
^DIC(9.4,14,22,5.9,"PAH",48,1,183,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,184,0)="       Want to RUN the Environment Check Routine? YES// "
^DIC(9.4,14,22,5.9,"PAH",48,1,185,0)="          LR*5.2*210"
^DIC(9.4,14,22,5.9,"PAH",48,1,186,0)="       Will first run the Environment Check Routine, LR210"
^DIC(9.4,14,22,5.9,"PAH",48,1,187,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,188,0)="       Use INSTALL NAME: LR*5.2*210  to install the Distribution.  "
^DIC(9.4,14,22,5.9,"PAH",48,1,189,0)="       "
^DIC(9.4,14,22,5.9,"PAH",48,1,190,0)="       NOTE:  The following are OPTIONAL:"
^DIC(9.4,14,22,5.9,"PAH",48,1,191,0)="     "
^DIC(9.4,14,22,5.9,"PAH",48,1,192,0)="      a.  Backup a Transport Global - This option will create a backup "
^DIC(9.4,14,22,5.9,"PAH",48,1,193,0)="           message of any routines exported with this patch. It will not "
^DIC(9.4,14,22,5.9,"PAH",48,1,194,0)="           backup any other changes, such as DDs or templates.  "
^DIC(9.4,14,22,5.9,"PAH",48,1,195,0)="      b.  Compare Transport Global to Current System - This is not"
^DIC(9.4,14,22,5.9,"PAH",48,1,196,0)="           recommended.  The reported data is misleading."
^DIC(9.4,14,22,5.9,"PAH",48,1,197,0)="      c.  Verify Checksums in Transport Global - This option will allow "
^DIC(9.4,14,22,5.9,"PAH",48,1,198,0)="           you to ensure the integrity of the routines that are in the "
^DIC(9.4,14,22,5.9,"PAH",48,1,199,0)="           transport global.  "
^DIC(9.4,14,22,5.9,"PAH",48,1,200,0)="      "
^DIC(9.4,14,22,5.9,"PAH",48,1,201,0)="   3.  Use the install name LR*5.2*210 "
^DIC(9.4,14,22,5.9,"PAH",48,1,202,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,203,0)=" Note: If installation is successful, remove the routine LR210 from your"
^DIC(9.4,14,22,5.9,"PAH",48,1,204,0)=" system."
^DIC(9.4,14,22,5.9,"PAH",48,1,205,0)="  "
^DIC(9.4,14,22,5.9,"PAH",48,1,206,0)="   4. No routine mapping adjustments are required"
^DIC(9.4,14,22,5.9,"PAH",48,1,207,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,208,0)="Routine Information:"
^DIC(9.4,14,22,5.9,"PAH",48,1,209,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",48,1,210,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,211,0)="Routine Name:"
^DIC(9.4,14,22,5.9,"PAH",48,1,212,0)="  - LRCE"
^DIC(9.4,14,22,5.9,"PAH",48,1,213,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,214,0)="Routine Name:"
^DIC(9.4,14,22,5.9,"PAH",48,1,215,0)="  - LROS"
^DIC(9.4,14,22,5.9,"PAH",48,1,216,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,217,0)="Routine Name:"
^DIC(9.4,14,22,5.9,"PAH",48,1,218,0)="  - LR210"
^DIC(9.4,14,22,5.9,"PAH",48,1,219,0)=" "
^DIC(9.4,14,22,5.9,"PAH",48,1,220,0)="=========================================================================="
