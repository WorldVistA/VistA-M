^DIC(9.4,171,22,2,1,0)="^^1^1^3051119"
^DIC(9.4,171,22,2,1,1,0)="RUM V2.0"
^DIC(9.4,171,22,2,"PAH",0)="^9.4901^3^3"
^DIC(9.4,171,22,2,"PAH",1,0)="1 SEQ #1^3050311^1"
^DIC(9.4,171,22,2,"PAH",1,1,0)="^^1^1^3050311"
^DIC(9.4,171,22,2,"PAH",1,1,1,0)="Patch 1 for RUM v2.0"
^DIC(9.4,171,22,2,"PAH",2,0)="2^3140115.164335^17"
^DIC(9.4,171,22,2,"PAH",2,1,0)="^^1^1^3140115"
^DIC(9.4,171,22,2,"PAH",2,1,1,0)="Patch KMPR*2*2"
^DIC(9.4,171,22,2,"PAH",3,0)="4^3160829.131103^54"
^DIC(9.4,171,22,2,"PAH","B",2,2)=""
^DIC(9.4,171,22,2,"PAH","B",4,3)=""
^DIC(9.4,171,22,2,"PAH","B","1 SEQ #1",1)=""
