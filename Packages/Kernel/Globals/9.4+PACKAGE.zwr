^DIC(9.4,77,22,17,"PAH",358,0)="418 SEQ #360^3210716.085543^17"
^DIC(9.4,77,22,17,"PAH",358,1,0)="^^50^50^3210716"
^DIC(9.4,77,22,17,"PAH",358,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,77,22,17,"PAH",358,1,2,0)="  "
^DIC(9.4,77,22,17,"PAH",358,1,3,0)="1) INC16771491 - Activity Log shows wrong 'Changed from' value when Stop"
^DIC(9.4,77,22,17,"PAH",358,1,4,0)="                 Date/Time field is edited and Order is DC'd"
^DIC(9.4,77,22,17,"PAH",358,1,5,0)="  "
^DIC(9.4,77,22,17,"PAH",358,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,77,22,17,"PAH",358,1,7,0)="--------------------------------------------"
^DIC(9.4,77,22,17,"PAH",358,1,8,0)="1) INC16771491 - Activity Log shows wrong 'Changed From' value when Stop"
^DIC(9.4,77,22,17,"PAH",358,1,9,0)="                 Date/Time field is edited and Order is DC'd"
^DIC(9.4,77,22,17,"PAH",358,1,10,0)="  "
^DIC(9.4,77,22,17,"PAH",358,1,11,0)="Problem: "
^DIC(9.4,77,22,17,"PAH",358,1,12,0)="-------"
^DIC(9.4,77,22,17,"PAH",358,1,13,0)="The Togus VA Medical Center reported a problem with the Activity Log after"
^DIC(9.4,77,22,17,"PAH",358,1,14,0)="editing the Stop Date/Time on an IV order using the Inpatient Order Entry [PSJ"
^DIC(9.4,77,22,17,"PAH",358,1,15,0)="OE] option. After they edited the Stop Date/Time field if correctly created a"
^DIC(9.4,77,22,17,"PAH",358,1,16,0)="new order, however the Activity log for the original/discontinued order showed"
^DIC(9.4,77,22,17,"PAH",358,1,17,0)="a 'Changed From' value equal to the new Stop Date/Time entered by the user"
^DIC(9.4,77,22,17,"PAH",358,1,18,0)="instead of the original Stop Date/Time before the order was edited. Below is a"
^DIC(9.4,77,22,17,"PAH",358,1,19,0)="capture of the Activity Log display showing the problem:"
^DIC(9.4,77,22,17,"PAH",358,1,20,0)=" "
^DIC(9.4,77,22,17,"PAH",358,1,21,0)="  ..."
^DIC(9.4,77,22,17,"PAH",358,1,22,0)="  #  MMM DD,YYYY HH:MM:SS EDIT                      USER,NAME"
^DIC(9.4,77,22,17,"PAH",358,1,23,0)="     Comment: Order discontinued due to edit"
^DIC(9.4,77,22,17,"PAH",358,1,24,0)=" "
^DIC(9.4,77,22,17,"PAH",358,1,25,0)="            Field: 'STOP DATE/TIME'"
^DIC(9.4,77,22,17,"PAH",358,1,26,0)="     Changed from: 'MMM DD,YYYY HH:MM'     <<< New Stop Date/Time (wrong)"
^DIC(9.4,77,22,17,"PAH",358,1,27,0)="               To: 'MMM DD,YYYY HH:MM'     <<< Current Date/Time (correct)"
^DIC(9.4,77,22,17,"PAH",358,1,28,0)="  ..."
^DIC(9.4,77,22,17,"PAH",358,1,29,0)=" "
^DIC(9.4,77,22,17,"PAH",358,1,30,0)="Resolution:"
^DIC(9.4,77,22,17,"PAH",358,1,31,0)="----------"
^DIC(9.4,77,22,17,"PAH",358,1,32,0)="After a few tests it was identified that the software was indeed using the"
^DIC(9.4,77,22,17,"PAH",358,1,33,0)="wrong value for the Stop Date/Time when recording the 'Changed From' value in"
^DIC(9.4,77,22,17,"PAH",358,1,34,0)="the Activity log of the original/discontinued order when the Stop Date/Time"
^DIC(9.4,77,22,17,"PAH",358,1,35,0)="was edited by the user. A change was made to use the original Stop Date/Time"
^DIC(9.4,77,22,17,"PAH",358,1,36,0)="value from the orignial order instead of using the new Stop Date/Time entered"
^DIC(9.4,77,22,17,"PAH",358,1,37,0)="by the user for the new order."
^DIC(9.4,77,22,17,"PAH",358,1,38,0)="  "
^DIC(9.4,77,22,17,"PAH",358,1,39,0)="Technical Resolution:"
^DIC(9.4,77,22,17,"PAH",358,1,40,0)="--------------------"
^DIC(9.4,77,22,17,"PAH",358,1,41,0)="The Activity Log entry is recorded by the code in STOP^PSIVORAL. It used the"
^DIC(9.4,77,22,17,"PAH",358,1,42,0)="value in the P(3) array variable to compare against the value in the order to"
^DIC(9.4,77,22,17,"PAH",358,1,43,0)="identify whether the field had been changed or not and also used this value to"
^DIC(9.4,77,22,17,"PAH",358,1,44,0)="record the 'Changed from' value in case it determines it was changed. The"
^DIC(9.4,77,22,17,"PAH",358,1,45,0)="problem happened because the value in the P(3) array variable contained the"
^DIC(9.4,77,22,17,"PAH",358,1,46,0)="Stop Date/Time value for the new order and not the original value (before the"
^DIC(9.4,77,22,17,"PAH",358,1,47,0)="user edited). The code was changed to use the value from the ORIGINAL STOP"
^DIC(9.4,77,22,17,"PAH",358,1,48,0)="DATE field (#116) in the IV sub-file (#55.01) in the PHARMACY PATIENT file"
^DIC(9.4,77,22,17,"PAH",358,1,49,0)="(#55) for DC'd orders as the 'Changed From' value instead of the value in the"
^DIC(9.4,77,22,17,"PAH",358,1,50,0)="P(3) array variable."
^DIC(9.4,77,22,17,"PAH",359,0)="417b^3210812"
^DIC(9.4,77,22,17,"PAH",359,1,0)="^^5^5^3210812"
^DIC(9.4,77,22,17,"PAH",359,1,1,0)="Backup of PSJ*5.0*417 on Aug 12, 2021"
^DIC(9.4,77,22,17,"PAH",359,1,2,0)=" "
^DIC(9.4,77,22,17,"PAH",359,1,3,0)="Warning:  Installing this backup patch message will install older versions"
