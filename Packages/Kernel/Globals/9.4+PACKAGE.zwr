^DIC(9.4,14,22,5.9,"PAH",286,1,118,0)="Additional Information:"
^DIC(9.4,14,22,5.9,"PAH",286,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,120,0)="N/A "
^DIC(9.4,14,22,5.9,"PAH",286,1,121,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,123,0)="New Service Requests (NSRs):"
^DIC(9.4,14,22,5.9,"PAH",286,1,124,0)="--------------------------------------------   "
^DIC(9.4,14,22,5.9,"PAH",286,1,125,0)="#20140511 "
^DIC(9.4,14,22,5.9,"PAH",286,1,126,0)=" The Anatomic Pathology (AP) laboratory service needs a mechanism for "
^DIC(9.4,14,22,5.9,"PAH",286,1,127,0)=" clinicians to provide required patient-specific, procedure-specific, and "
^DIC(9.4,14,22,5.9,"PAH",286,1,128,0)=" specimen-specific information to facilitate specimen processing by "
^DIC(9.4,14,22,5.9,"PAH",286,1,129,0)=" pathologists. This mechanism must be in place for use by the specimen "
^DIC(9.4,14,22,5.9,"PAH",286,1,130,0)=" labeling application in order to generate a primary specimen label that "
^DIC(9.4,14,22,5.9,"PAH",286,1,131,0)=" positively identifies the specimen and accurately associates it with the "
^DIC(9.4,14,22,5.9,"PAH",286,1,132,0)=" patient."
^DIC(9.4,14,22,5.9,"PAH",286,1,133,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,134,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,14,22,5.9,"PAH",286,1,135,0)="---------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,136,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",286,1,137,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,139,0)="CA SDM Ticket(s) & Overview:"
^DIC(9.4,14,22,5.9,"PAH",286,1,140,0)="--------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,141,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,142,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",286,1,143,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,144,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,145,0)="Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",286,1,146,0)="---------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,147,0)="AP Dialogs w/OR*3.0*405:"
^DIC(9.4,14,22,5.9,"PAH",286,1,148,0)="  North Florida/South Georgia Veterans Health System (Gainesville, FL)"
^DIC(9.4,14,22,5.9,"PAH",286,1,149,0)="  Edward Hines Jr. VA Hospital"
^DIC(9.4,14,22,5.9,"PAH",286,1,150,0)="  Philadelphia VA Medical Center"
^DIC(9.4,14,22,5.9,"PAH",286,1,151,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,152,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,153,0)="-------"
^DIC(9.4,14,22,5.9,"PAH",286,1,154,0)=" Sub files 60.0216611,.01 (AOE CPRS SCREEN) and 60.12166,.01 (AOE SCREEN) "
^DIC(9.4,14,22,5.9,"PAH",286,1,155,0)=" in the LABORAOTRY TEST file (#60) were erroneously released with the"
^DIC(9.4,14,22,5.9,"PAH",286,1,156,0)=" distribution of patch LR*5.2*462."
^DIC(9.4,14,22,5.9,"PAH",286,1,157,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,158,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,159,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,160,0)=" These two fields will be removed from the data dictionary with the LR479 "
^DIC(9.4,14,22,5.9,"PAH",286,1,161,0)=" post-install routine."
^DIC(9.4,14,22,5.9,"PAH",286,1,162,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,163,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,164,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,165,0)="Sub file 69.321661,.01 (VFD AOE) in the LAB ORDER ENTRY file (#69) was "
^DIC(9.4,14,22,5.9,"PAH",286,1,166,0)="erroneously released with the distribution of patch LR*5.2*462."
^DIC(9.4,14,22,5.9,"PAH",286,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,168,0)="Resoultion:"
^DIC(9.4,14,22,5.9,"PAH",286,1,169,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,170,0)=" This field will be removed form the data dictionary with the LR479 "
^DIC(9.4,14,22,5.9,"PAH",286,1,171,0)=" post-install routine."
^DIC(9.4,14,22,5.9,"PAH",286,1,172,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,173,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,174,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,175,0)=" Specimen Login in VistA does not assign correct accession number when "
^DIC(9.4,14,22,5.9,"PAH",286,1,176,0)=" using the new accession process added to the AP Specimen Log In option "
^DIC(9.4,14,22,5.9,"PAH",286,1,177,0)=" with patch LR*5.2*462. The order number entered at this point was created"
^DIC(9.4,14,22,5.9,"PAH",286,1,178,0)=" using the new AP Order Dialog in CPRS. The accession area assigned to the"
^DIC(9.4,14,22,5.9,"PAH",286,1,179,0)=" Laboratory test in file 60 was not being honored and only SURGICAL "
^DIC(9.4,14,22,5.9,"PAH",286,1,180,0)=" PATHOLOGY (SP) and CYTOLOGY (CY) accession areas were being utilized."
^DIC(9.4,14,22,5.9,"PAH",286,1,181,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,182,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,183,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,184,0)=" Routine modifications were made to honor the correct accession area as"
^DIC(9.4,14,22,5.9,"PAH",286,1,185,0)=" defined in the Laboratory test file in association with the division"
^DIC(9.4,14,22,5.9,"PAH",286,1,186,0)=" of the user accessioning the order."
^DIC(9.4,14,22,5.9,"PAH",286,1,187,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,188,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,189,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,190,0)=" Practitioner field in CPRS displays '0' if Surgeon/Physician is blank in "
^DIC(9.4,14,22,5.9,"PAH",286,1,191,0)=" VistA - Backdoor order only."
^DIC(9.4,14,22,5.9,"PAH",286,1,192,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,193,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,194,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,195,0)=" Routine modifications were made to correct the storage of a zero when no"
^DIC(9.4,14,22,5.9,"PAH",286,1,196,0)=" Surgeon/Physician was entered during the accessioning process. "
^DIC(9.4,14,22,5.9,"PAH",286,1,197,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,198,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,199,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,200,0)=" Lock login process of AP Orders via Accessioning menu - Post Release"
^DIC(9.4,14,22,5.9,"PAH",286,1,201,0)=" LR479."
^DIC(9.4,14,22,5.9,"PAH",286,1,202,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,203,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,204,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,205,0)=" Option Accessioning tests ordered by ward order entry [LROE] has been"
^DIC(9.4,14,22,5.9,"PAH",286,1,206,0)=" modified to not allow Anatomic Pathology orders to be processed. The "
^DIC(9.4,14,22,5.9,"PAH",286,1,207,0)=" user will see the following message before exiting the option:"
^DIC(9.4,14,22,5.9,"PAH",286,1,208,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,209,0)="    This is an Anatomic Path order                         "
^DIC(9.4,14,22,5.9,"PAH",286,1,210,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,211,0)="    Must use 'Log-in, anat path' Option to accession this Order           "
^DIC(9.4,14,22,5.9,"PAH",286,1,212,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,213,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,214,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,215,0)=" AP Backdoor order from VistA displays Send Patient to Lab as default "
^DIC(9.4,14,22,5.9,"PAH",286,1,216,0)=" Collection Status."
^DIC(9.4,14,22,5.9,"PAH",286,1,217,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,218,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,219,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,220,0)=" Routine modifications were made to change the default from SP Send "
^DIC(9.4,14,22,5.9,"PAH",286,1,221,0)=" Patient to WC Ward Collect."
^DIC(9.4,14,22,5.9,"PAH",286,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,223,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,224,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,225,0)=" Backdoor AP Order from VistA does not display patient location in CPRS."
^DIC(9.4,14,22,5.9,"PAH",286,1,226,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,227,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,228,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,229,0)=" Routine modifications were made to pass the correct pointer to CPRS so "
^DIC(9.4,14,22,5.9,"PAH",286,1,230,0)=" that the ordering location will be reflected correctly."
^DIC(9.4,14,22,5.9,"PAH",286,1,231,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,232,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,233,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,234,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,235,0)=" Error <SUBSCRIPT>AP+2^LRXREF is being triggered during AP Specimen "
^DIC(9.4,14,22,5.9,"PAH",286,1,236,0)=" Log-in accessioning of orders created in CPRS. There was code in the "
^DIC(9.4,14,22,5.9,"PAH",286,1,237,0)=" routine that was trying to continue the accessioning process even if the "
^DIC(9.4,14,22,5.9,"PAH",286,1,238,0)=" test being accessioned did not have an accession area defined that "
^DIC(9.4,14,22,5.9,"PAH",286,1,239,0)=" matched the division of the accessioning person. The default lookup was "
^DIC(9.4,14,22,5.9,"PAH",286,1,240,0)=" expecting to find an SP for Surgical Pathology or a CY for Cytopathology "
^DIC(9.4,14,22,5.9,"PAH",286,1,241,0)=" accession area abbreviations. If a site has changed these abbreviations "
^DIC(9.4,14,22,5.9,"PAH",286,1,242,0)=" to something other than SP and CY the <SUBSCRIPT> error would be "
^DIC(9.4,14,22,5.9,"PAH",286,1,243,0)=" triggered."
^DIC(9.4,14,22,5.9,"PAH",286,1,244,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,245,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,246,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,247,0)=" Routine modifications were made to remove the default accession area "
^DIC(9.4,14,22,5.9,"PAH",286,1,248,0)=" logic and replace it with code that will exit the user with the following"
^DIC(9.4,14,22,5.9,"PAH",286,1,249,0)=" message:"
^DIC(9.4,14,22,5.9,"PAH",286,1,250,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,251,0)="[ TISSUE EXAM]  DOES NOT HAVE AN APPROPRIATE ACCESSION AREA DEFINED       "
^DIC(9.4,14,22,5.9,"PAH",286,1,252,0)="                                 Log-in Aborted"
^DIC(9.4,14,22,5.9,"PAH",286,1,253,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,254,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,255,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,256,0)=" The VLE AP project is unable to acquire an ICR with $$DEFAULT^ORWLRAP1."
^DIC(9.4,14,22,5.9,"PAH",286,1,257,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,258,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,259,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,260,0)=" This API was removed from the input transform of the .01 field of file "
^DIC(9.4,14,22,5.9,"PAH",286,1,261,0)=" 69.73."
^DIC(9.4,14,22,5.9,"PAH",286,1,262,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,263,0)="        DD: 69.73:.01"
^DIC(9.4,14,22,5.9,"PAH",286,1,264,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,265,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,266,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,267,0)=" The builder blocks had three misspellings (erosioin,technnique and SLide)"
^DIC(9.4,14,22,5.9,"PAH",286,1,268,0)=" for selectable values."
^DIC(9.4,14,22,5.9,"PAH",286,1,269,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,270,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,271,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,272,0)=" The patch has a post install sub-routine SPELL^LR479 that will search for"
^DIC(9.4,14,22,5.9,"PAH",286,1,273,0)=" strings that equal ""erosioin"", ""technnique"" or ""SLide"" within the 69.73"
^DIC(9.4,14,22,5.9,"PAH",286,1,274,0)=" file and set them to ""erosion"" and ""technique"" respectively."
^DIC(9.4,14,22,5.9,"PAH",286,1,275,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,276,0)="        Routine: LR479"
^DIC(9.4,14,22,5.9,"PAH",286,1,277,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,278,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,279,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",286,1,280,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",286,1,281,0)=" For the Urology,Prostate dialog Right Testis specimen the builder block "
^DIC(9.4,14,22,5.9,"PAH",286,1,282,0)=" ""Submission Type"" should be ""Specimen Type"" and ""Specimen Submission"" "
^DIC(9.4,14,22,5.9,"PAH",286,1,283,0)=" should be ""Submission Type""."
^DIC(9.4,14,22,5.9,"PAH",286,1,284,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,285,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",286,1,286,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",286,1,287,0)=" The patch has a post install sub-routine TITLE^LR479 that will search for"
^DIC(9.4,14,22,5.9,"PAH",286,1,288,0)=" a builder block with a value of ""Orchiectomy"" and if the builder block "
^DIC(9.4,14,22,5.9,"PAH",286,1,289,0)=" title reads ""Submission Type"" it will be changed to ""Specimen Type"" and "
^DIC(9.4,14,22,5.9,"PAH",286,1,290,0)=" the second builder block title will be set to ""Submission Type""."
^DIC(9.4,14,22,5.9,"PAH",286,1,291,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,292,0)="        Routine: LR479"
^DIC(9.4,14,22,5.9,"PAH",286,1,293,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,294,0)=" Documentation Retrieval Instructions:"
^DIC(9.4,14,22,5.9,"PAH",286,1,295,0)=" ------------------------------------- "
^DIC(9.4,14,22,5.9,"PAH",286,1,296,0)=" Software will be released via a PackMan message. "
^DIC(9.4,14,22,5.9,"PAH",286,1,297,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,298,0)=" The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,14,22,5.9,"PAH",286,1,299,0)=" This transmits the files from the first available server. Sites may "
^DIC(9.4,14,22,5.9,"PAH",286,1,300,0)=" also elect to retrieve files directly from a specific server. "
^DIC(9.4,14,22,5.9,"PAH",286,1,301,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,302,0)=" Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,14,22,5.9,"PAH",286,1,303,0)=" Secure File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",286,1,304,0)=" directory at the following OI Field Offices:"
^DIC(9.4,14,22,5.9,"PAH",286,1,305,0)="    "
^DIC(9.4,14,22,5.9,"PAH",286,1,306,0)=" Albany:                 fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",286,1,307,0)=" Hines:                  fo-hines.domain.ext    "
^DIC(9.4,14,22,5.9,"PAH",286,1,308,0)=" Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",286,1,309,0)="    "
^DIC(9.4,14,22,5.9,"PAH",286,1,310,0)=" Title/File Name                       FTP Mode"
^DIC(9.4,14,22,5.9,"PAH",286,1,311,0)=" -------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,312,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",286,1,313,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,314,0)=" Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,14,22,5.9,"PAH",286,1,315,0)=" at:"
^DIC(9.4,14,22,5.9,"PAH",286,1,316,0)=" http://www4.domain.ext/vdl/"
^DIC(9.4,14,22,5.9,"PAH",286,1,317,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,318,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,319,0)="Patch Installation:"
^DIC(9.4,14,22,5.9,"PAH",286,1,320,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,321,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,322,0)=" Pre/Post Installation Overview:"
^DIC(9.4,14,22,5.9,"PAH",286,1,323,0)=" -------------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,324,0)=" N/A "
^DIC(9.4,14,22,5.9,"PAH",286,1,325,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,326,0)=" Pre-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",286,1,327,0)=" ------------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,328,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",286,1,329,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,330,0)=" Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",286,1,331,0)=" --------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,332,0)=" This patch may be installed with users on the system although it is "
^DIC(9.4,14,22,5.9,"PAH",286,1,333,0)=" strongly recommended that it be installed during non-peak hours when "
^DIC(9.4,14,22,5.9,"PAH",286,1,334,0)=" LAB usage is at a minimum. This patch should take less than 5 minutes to"
^DIC(9.4,14,22,5.9,"PAH",286,1,335,0)="install."
^DIC(9.4,14,22,5.9,"PAH",286,1,336,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,337,0)=" This installation will install the components necessary to support the "
^DIC(9.4,14,22,5.9,"PAH",286,1,338,0)=" CPRS AP Order Dialog future functionality that is being released with"
^DIC(9.4,14,22,5.9,"PAH",286,1,339,0)=" OR*3.0*405."
^DIC(9.4,14,22,5.9,"PAH",286,1,340,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,341,0)=" 1.  Choose the PackMan message containing this patch."
^DIC(9.4,14,22,5.9,"PAH",286,1,342,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,343,0)=" 2.  Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,14,22,5.9,"PAH",286,1,344,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,345,0)=" 3.  From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,14,22,5.9,"PAH",286,1,346,0)="     the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,14,22,5.9,"PAH",286,1,347,0)="     following options. When prompted for the INSTALL NAME enter the "
^DIC(9.4,14,22,5.9,"PAH",286,1,348,0)="     patch LR*5.2*479:"
^DIC(9.4,14,22,5.9,"PAH",286,1,349,0)="     a.  Backup a Transport Global - This option will create a backup"
^DIC(9.4,14,22,5.9,"PAH",286,1,350,0)="         message of any routines exported with this patch. It will not"
^DIC(9.4,14,22,5.9,"PAH",286,1,351,0)="         backup any other changes such as DDs or templates."
^DIC(9.4,14,22,5.9,"PAH",286,1,352,0)="     b.  Compare Transport Global to Current System - This option will"
^DIC(9.4,14,22,5.9,"PAH",286,1,353,0)="         allow you to view all changes that will be made when this patch"
^DIC(9.4,14,22,5.9,"PAH",286,1,354,0)="         is installed.  It compares all components of this patch"
^DIC(9.4,14,22,5.9,"PAH",286,1,355,0)="         (routines, DDs, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",286,1,356,0)="     c.  Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,14,22,5.9,"PAH",286,1,357,0)="         you to ensure the integrity of the routines that are in the"
^DIC(9.4,14,22,5.9,"PAH",286,1,358,0)="         transport global."
^DIC(9.4,14,22,5.9,"PAH",286,1,359,0)="      "
^DIC(9.4,14,22,5.9,"PAH",286,1,360,0)=" 4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,14,22,5.9,"PAH",286,1,361,0)="     choose the patch to install."
^DIC(9.4,14,22,5.9,"PAH",286,1,362,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,363,0)=" 5.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",286,1,364,0)="     Install? NO//'     "
^DIC(9.4,14,22,5.9,"PAH",286,1,365,0)="     Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",286,1,366,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,367,0)=" 6.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,14,22,5.9,"PAH",286,1,368,0)="     NO//'"
^DIC(9.4,14,22,5.9,"PAH",286,1,369,0)="     Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",286,1,370,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,371,0)=" 7.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,14,22,5.9,"PAH",286,1,372,0)="     and Protocols? NO//' "
^DIC(9.4,14,22,5.9,"PAH",286,1,373,0)="     Respond: NO"
^DIC(9.4,14,22,5.9,"PAH",286,1,374,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,375,0)=" 8.  If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,14,22,5.9,"PAH",286,1,376,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,377,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,378,0)=" Post-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",286,1,379,0)=" -------------------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,380,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",286,1,381,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,382,0)=" Back-Out Procedure:"
^DIC(9.4,14,22,5.9,"PAH",286,1,383,0)=" -------------------"
^DIC(9.4,14,22,5.9,"PAH",286,1,384,0)=" The build does not make any changes that would affect the operational "
^DIC(9.4,14,22,5.9,"PAH",286,1,385,0)=" state of the software and platform settings."
^DIC(9.4,14,22,5.9,"PAH",286,1,386,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,387,0)="1. Back-Out Strategy"
^DIC(9.4,14,22,5.9,"PAH",286,1,388,0)="     During installation, if the option to back up routines was run as "
^DIC(9.4,14,22,5.9,"PAH",286,1,389,0)="     directed, 'Backup a Transport Global', then routines have the ability"
^DIC(9.4,14,22,5.9,"PAH",286,1,390,0)="     to be restored from the ""backup"" MailMan message that was generated."
^DIC(9.4,14,22,5.9,"PAH",286,1,391,0)="     However, the KIDS installation process does not perform a restore of "
^DIC(9.4,14,22,5.9,"PAH",286,1,392,0)="     other VistA components, such as data dictionary, cross-reference, and"
^DIC(9.4,14,22,5.9,"PAH",286,1,393,0)="     template changes, etc. "
^DIC(9.4,14,22,5.9,"PAH",286,1,394,0)="     Prior to attempting a back-out of the software, please contact the VA"
^DIC(9.4,14,22,5.9,"PAH",286,1,395,0)="     Help Desk at 1-855-673-4357 for support or assistance."
^DIC(9.4,14,22,5.9,"PAH",286,1,396,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,397,0)="     a.  Back-Out Considerations"
^DIC(9.4,14,22,5.9,"PAH",286,1,398,0)="         The LIM and the Chief of Pathology have the authority to order "
^DIC(9.4,14,22,5.9,"PAH",286,1,399,0)="the"
^DIC(9.4,14,22,5.9,"PAH",286,1,400,0)="         back-out."
^DIC(9.4,14,22,5.9,"PAH",286,1,401,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,402,0)="     b.  Back-Out Criteria"
^DIC(9.4,14,22,5.9,"PAH",286,1,403,0)="         Criteria for a back-out includes, but are not limited, to the"
^DIC(9.4,14,22,5.9,"PAH",286,1,404,0)="         following:"
^DIC(9.4,14,22,5.9,"PAH",286,1,405,0)="         i. Failed baseline testing."
^DIC(9.4,14,22,5.9,"PAH",286,1,406,0)="         ii. Non-recoverable software error."
^DIC(9.4,14,22,5.9,"PAH",286,1,407,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,408,0)="     c.  Back-Out Risks"
^DIC(9.4,14,22,5.9,"PAH",286,1,409,0)="     No back-out risks have been determined at this time."
^DIC(9.4,14,22,5.9,"PAH",286,1,410,0)="     d.  Authority for Back-Out"
^DIC(9.4,14,22,5.9,"PAH",286,1,411,0)="         The LIM, the Lab Manager, and the Chief of Pathology have the"
^DIC(9.4,14,22,5.9,"PAH",286,1,412,0)="         authority to request and approve the back-out and accept the"
^DIC(9.4,14,22,5.9,"PAH",286,1,413,0)="         risks."
^DIC(9.4,14,22,5.9,"PAH",286,1,414,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,415,0)="2. Rollback Procedure"
^DIC(9.4,14,22,5.9,"PAH",286,1,416,0)="    The LR*5.2*479 build as well as any installed dependent patch changes "
^DIC(9.4,14,22,5.9,"PAH",286,1,417,0)="    that follow these releases need to be taken out in reverse of the"
^DIC(9.4,14,22,5.9,"PAH",286,1,418,0)="    order in which they were installed; routines and data dictionary"
^DIC(9.4,14,22,5.9,"PAH",286,1,419,0)="    modifications and populated data must also be rolled back in reverse"
^DIC(9.4,14,22,5.9,"PAH",286,1,420,0)="    order."
^DIC(9.4,14,22,5.9,"PAH",286,1,421,0)="    Please contact the VA Help Desk at 1-855-763-4357 for support or "
^DIC(9.4,14,22,5.9,"PAH",286,1,422,0)="    assistance regarding roll-back procedures."
^DIC(9.4,14,22,5.9,"PAH",286,1,423,0)="     "
^DIC(9.4,14,22,5.9,"PAH",286,1,424,0)="     a.  Rollback Considerations"
^DIC(9.4,14,22,5.9,"PAH",286,1,425,0)="         No rollback considerations have been determined at this time."
^DIC(9.4,14,22,5.9,"PAH",286,1,426,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,427,0)="     b.  Rollback Criteria"
^DIC(9.4,14,22,5.9,"PAH",286,1,428,0)="         The only criteria for a rollback that has been determined at this"
^DIC(9.4,14,22,5.9,"PAH",286,1,429,0)="         time is that the installation failed baseline testing."
^DIC(9.4,14,22,5.9,"PAH",286,1,430,0)="     "
^DIC(9.4,14,22,5.9,"PAH",286,1,431,0)="     c.  Rollback Risks"
^DIC(9.4,14,22,5.9,"PAH",286,1,432,0)="         The only risk determined at this time is the possibility of"
^DIC(9.4,14,22,5.9,"PAH",286,1,433,0)="         downtime which would only effect the users of the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",286,1,434,0)="         package."
^DIC(9.4,14,22,5.9,"PAH",286,1,435,0)="  "
^DIC(9.4,14,22,5.9,"PAH",286,1,436,0)="     d.  Authority for Rollback"
^DIC(9.4,14,22,5.9,"PAH",286,1,437,0)="         The LIM, the Lab Manager, and the Chief of Pathology have the"
^DIC(9.4,14,22,5.9,"PAH",286,1,438,0)="         authority to require the rollback and accept the risks."
^DIC(9.4,14,22,5.9,"PAH",286,1,439,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,440,0)="     e.  Rollback Procedure"
^DIC(9.4,14,22,5.9,"PAH",286,1,441,0)="         The need for a rollback is highly unlikely, however if it is"
^DIC(9.4,14,22,5.9,"PAH",286,1,442,0)="         required, please contact the Product Support team for"
^DIC(9.4,14,22,5.9,"PAH",286,1,443,0)="         assistance. The rollback procedure will require Lab downtime and"
^DIC(9.4,14,22,5.9,"PAH",286,1,444,0)="         a reinstall of any previous KIDS versions."
^DIC(9.4,14,22,5.9,"PAH",286,1,445,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,446,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,447,0)=" Example of Captured Installation:"
^DIC(9.4,14,22,5.9,"PAH",286,1,448,0)=" =================================="
^DIC(9.4,14,22,5.9,"PAH",286,1,449,0)=" "
^DIC(9.4,14,22,5.9,"PAH",286,1,450,0)="Enter message action (in IN basket): Ignore// Xtract KIDS"
^DIC(9.4,14,22,5.9,"PAH",286,1,451,0)=" "
