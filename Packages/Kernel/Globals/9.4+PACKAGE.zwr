^DIC(9.4,85,22,1.5,"PAH",7,0)="30 SEQ #29^3011121^1"
^DIC(9.4,85,22,1.5,"PAH",7,1,0)="^^84^84^3011121"
^DIC(9.4,85,22,1.5,"PAH",7,1,1,0)="        * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * "
^DIC(9.4,85,22,1.5,"PAH",7,1,2,0)="        This patch requires PDX patch VAQ*1.5*22.  KIDS will not check"
^DIC(9.4,85,22,1.5,"PAH",7,1,3,0)="          for the existence of this patch, because it pre-dates KIDS."
^DIC(9.4,85,22,1.5,"PAH",7,1,4,0)="              The site is responsible for performing the check."
^DIC(9.4,85,22,1.5,"PAH",7,1,5,0)="        * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * "
^DIC(9.4,85,22,1.5,"PAH",7,1,6,0)=""
^DIC(9.4,85,22,1.5,"PAH",7,1,7,0)="Patch VAQ*1.5*30"
^DIC(9.4,85,22,1.5,"PAH",7,1,8,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,9,0)="NOIS CHY-0201-51534, ASH-0501-32739, CPH-0501-40775, BHS-0601-10382,"
^DIC(9.4,85,22,1.5,"PAH",7,1,10,0)="     HIN-0701-42706, OKL-0701-70784"
^DIC(9.4,85,22,1.5,"PAH",7,1,11,0)="Test Sites: Oklahoma City, OK; Asheville, NC; Central Plains HCS"
^DIC(9.4,85,22,1.5,"PAH",7,1,12,0)=""
^DIC(9.4,85,22,1.5,"PAH",7,1,13,0)="This patch prevents the sending of PDX messages to closed domains in two"
^DIC(9.4,85,22,1.5,"PAH",7,1,14,0)="ways."
^DIC(9.4,85,22,1.5,"PAH",7,1,15,0)=""
^DIC(9.4,85,22,1.5,"PAH",7,1,16,0)="1. Prevents the addition of closed domains to outgoing groups:"
^DIC(9.4,85,22,1.5,"PAH",7,1,17,0)="Screens are placed on 2 fields in the REMOTE FACILITY multiple"
^DIC(9.4,85,22,1.5,"PAH",7,1,18,0)="in file 394.83, VAQ - OUTGOING GROUP.  The fields are .01 REMOTE FACILITY"
^DIC(9.4,85,22,1.5,"PAH",7,1,19,0)="and .02 REMOTE DOMAIN.  For both of these, the DOMAIN file is checked"
^DIC(9.4,85,22,1.5,"PAH",7,1,20,0)="to ensure that the domain is not closed.  If it is, the screen fails"
^DIC(9.4,85,22,1.5,"PAH",7,1,21,0)="and you are prevented from adding the remote facility to the outgoing group."
^DIC(9.4,85,22,1.5,"PAH",7,1,22,0)=""
^DIC(9.4,85,22,1.5,"PAH",7,1,23,0)="2. Removes closed domains from outgoing groups:"
^DIC(9.4,85,22,1.5,"PAH",7,1,24,0)="When PDX messages to outgoing groups are being built, the DOMAIN file is"
^DIC(9.4,85,22,1.5,"PAH",7,1,25,0)="checked to ensure that the domain is not closed.  If it is, the remote"
^DIC(9.4,85,22,1.5,"PAH",7,1,26,0)="facility is deleted from the outgoing group, and the PDX message is not"
^DIC(9.4,85,22,1.5,"PAH",7,1,27,0)="sent to that domain."
^DIC(9.4,85,22,1.5,"PAH",7,1,28,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,29,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",7,1,30,0)="is at a minimum.  It requires PDX patch VAQ*1.5*22.  KIDS will not check"
^DIC(9.4,85,22,1.5,"PAH",7,1,31,0)="for the existence of this patch, because it pre-dates KIDS.  The site is"
^DIC(9.4,85,22,1.5,"PAH",7,1,32,0)="responsible for performing the check."
^DIC(9.4,85,22,1.5,"PAH",7,1,33,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",7,1,34,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,35,0)="ROUTINES:"
^DIC(9.4,85,22,1.5,"PAH",7,1,36,0)="The second line of the routine now looks like:"
^DIC(9.4,85,22,1.5,"PAH",7,1,37,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",7,1,38,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,39,0)="             Before        After"
^DIC(9.4,85,22,1.5,"PAH",7,1,40,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,85,22,1.5,"PAH",7,1,41,0)="-----------------------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",7,1,42,0)="VAQREQ03    3858669      4459512     22,30"
^DIC(9.4,85,22,1.5,"PAH",7,1,43,0)="VAQREQ05    4065406      4263629     30"
^DIC(9.4,85,22,1.5,"PAH",7,1,44,0)="VAQXRF2     2617277      3203802     30"
^DIC(9.4,85,22,1.5,"PAH",7,1,45,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,85,22,1.5,"PAH",7,1,46,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,47,0)="This patch introduces no new routines."
^DIC(9.4,85,22,1.5,"PAH",7,1,48,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",7,1,49,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,50,0)="INSTALLATION:"
^DIC(9.4,85,22,1.5,"PAH",7,1,51,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",7,1,52,0)="is at a minimum.  It requires PDX patch VAQ*1.5*22.  KIDS will not check"
^DIC(9.4,85,22,1.5,"PAH",7,1,53,0)="for the existence of this patch, because it pre-dates KIDS.  The site is"
^DIC(9.4,85,22,1.5,"PAH",7,1,54,0)="responsible for performing the check."
^DIC(9.4,85,22,1.5,"PAH",7,1,55,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,85,22,1.5,"PAH",7,1,56,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the"
^DIC(9.4,85,22,1.5,"PAH",7,1,57,0)="    affected routine(s).  "
^DIC(9.4,85,22,1.5,"PAH",7,1,58,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option."
^DIC(9.4,85,22,1.5,"PAH",7,1,59,0)="    This loads the patch into a Transport Global on your system.  "
^DIC(9.4,85,22,1.5,"PAH",7,1,60,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,85,22,1.5,"PAH",7,1,61,0)="    Users may be on the system."
^DIC(9.4,85,22,1.5,"PAH",7,1,62,0)="5.  On the KIDS:Installation menu, use the following options to install"
^DIC(9.4,85,22,1.5,"PAH",7,1,63,0)="    the Transport Global."
^DIC(9.4,85,22,1.5,"PAH",7,1,64,0)="       Verify Checksums in Transport Global"
^DIC(9.4,85,22,1.5,"PAH",7,1,65,0)="       Print Transport Global"
^DIC(9.4,85,22,1.5,"PAH",7,1,66,0)="       Compare Transport Global to Current System"
^DIC(9.4,85,22,1.5,"PAH",7,1,67,0)="       Backup a Transport Global"
^DIC(9.4,85,22,1.5,"PAH",7,1,68,0)="       Install Package(s)"
^DIC(9.4,85,22,1.5,"PAH",7,1,69,0)=" Select INSTALL NAME:   VAQ*1.5*30   Loaded from Distribution <date/time>"
^DIC(9.4,85,22,1.5,"PAH",7,1,70,0)="                        =========="
^DIC(9.4,85,22,1.5,"PAH",7,1,71,0)=" Install Questions:"
^DIC(9.4,85,22,1.5,"PAH",7,1,72,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,85,22,1.5,"PAH",7,1,73,0)="                                                       =="
^DIC(9.4,85,22,1.5,"PAH",7,1,74,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,85,22,1.5,"PAH",7,1,75,0)="                                                                       =="
^DIC(9.4,85,22,1.5,"PAH",7,1,76,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,85,22,1.5,"PAH",7,1,77,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,85,22,1.5,"PAH",7,1,78,0)=" Enter a '^' to abort the install."
^DIC(9.4,85,22,1.5,"PAH",7,1,79,0)=" "
^DIC(9.4,85,22,1.5,"PAH",7,1,80,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,85,22,1.5,"PAH",7,1,81,0)="                ------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",7,1,82,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if"
^DIC(9.4,85,22,1.5,"PAH",7,1,83,0)="    necessary."
^DIC(9.4,85,22,1.5,"PAH",7,1,84,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",8,0)="34 SEQ #30^3011210^1"
^DIC(9.4,85,22,1.5,"PAH",8,1,0)="^^86^86^3011210"
^DIC(9.4,85,22,1.5,"PAH",8,1,1,0)="Patch VAQ*1.5*34"
^DIC(9.4,85,22,1.5,"PAH",8,1,2,0)=" "
^DIC(9.4,85,22,1.5,"PAH",8,1,3,0)="NOIS BIR-1101-31486"
^DIC(9.4,85,22,1.5,"PAH",8,1,4,0)="Test Site: Birmingham, AL"
^DIC(9.4,85,22,1.5,"PAH",8,1,5,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,6,0)="Patch VAQ*1.5*30 exposed a problem which was not caught during its"
^DIC(9.4,85,22,1.5,"PAH",8,1,7,0)="extensive testing period.  It was not caught until it was released."
^DIC(9.4,85,22,1.5,"PAH",8,1,8,0)="We're very sorry about that."
^DIC(9.4,85,22,1.5,"PAH",8,1,9,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,10,0)="It is evidenced by the following:"
^DIC(9.4,85,22,1.5,"PAH",8,1,11,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,12,0)=">D ^%G"
^DIC(9.4,85,22,1.5,"PAH",8,1,13,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,14,0)="Global ^VAT(394.86"
^DIC(9.4,85,22,1.5,"PAH",8,1,15,0)="        VAT(394.86"
^DIC(9.4,85,22,1.5,"PAH",8,1,16,0)="^VAT(394.86,0) = VAQ - AUTO-NUMBERING^394.86^1^1"
^DIC(9.4,85,22,1.5,"PAH",8,1,17,0)="^VAT(394.86,1,0) = 1"
^DIC(9.4,85,22,1.5,"PAH",8,1,18,0)="^VAT(394.86,1,1) = 390"
^DIC(9.4,85,22,1.5,"PAH",8,1,19,0)="^VAT(394.86,1,2) = ""1""  <----- corrupted"
^DIC(9.4,85,22,1.5,"PAH",8,1,20,0)="^VAT(394.86,1,3) = 8"
^DIC(9.4,85,22,1.5,"PAH",8,1,21,0)="^VAT(394.86,""B"",1,1) = "
^DIC(9.4,85,22,1.5,"PAH",8,1,22,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,23,0)="and by:"
^DIC(9.4,85,22,1.5,"PAH",8,1,24,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,25,0)="Global ^VAT(394.62,466"
^DIC(9.4,85,22,1.5,"PAH",8,1,26,0)="        VAT(394.62,466"
^DIC(9.4,85,22,1.5,"PAH",8,1,27,0)="^VAT(394.62,466,0) = ""1""  <----- corrupted"
^DIC(9.4,85,22,1.5,"PAH",8,1,28,0)="  ..."
^DIC(9.4,85,22,1.5,"PAH",8,1,29,0)="^VAT(394.62,""B"",""""""1"""""",466) =  <----- corrupted"
^DIC(9.4,85,22,1.5,"PAH",8,1,30,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,31,0)="This patch fixes that, and cleans up the corruption in file 394.86."
^DIC(9.4,85,22,1.5,"PAH",8,1,32,0)="It can't fix PDXs which were adversely affected.  It can't fix file 394.62."
^DIC(9.4,85,22,1.5,"PAH",8,1,33,0)="The PDXs will have to be resent, or the data entered manually, if necessary."
^DIC(9.4,85,22,1.5,"PAH",8,1,34,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,35,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,85,22,1.5,"PAH",8,1,36,0)="is at a minimum.  It requires patch VAQ*1.5*30."
^DIC(9.4,85,22,1.5,"PAH",8,1,37,0)="=========================================================================="
^DIC(9.4,85,22,1.5,"PAH",8,1,38,0)=" "
^DIC(9.4,85,22,1.5,"PAH",8,1,39,0)="ROUTINES:"
^DIC(9.4,85,22,1.5,"PAH",8,1,40,0)="The second line of the routine now looks like:"
^DIC(9.4,85,22,1.5,"PAH",8,1,41,0)="       ;;1.5;PATIENT DATA EXCHANGE;**[patch list]**;NOV 17, 1993"
^DIC(9.4,85,22,1.5,"PAH",8,1,42,0)=" "
^DIC(9.4,85,22,1.5,"PAH",8,1,43,0)="             Before        After"
^DIC(9.4,85,22,1.5,"PAH",8,1,44,0)="Name       Checksum     Checksum     Patch List"
^DIC(9.4,85,22,1.5,"PAH",8,1,45,0)="-----------------------------------------------------------------"
^DIC(9.4,85,22,1.5,"PAH",8,1,46,0)="VAQFILE1    4265693      4507302     22,34"
^DIC(9.4,85,22,1.5,"PAH",8,1,47,0)="VAQPRE34    * NEW *       148728     34"
^DIC(9.4,85,22,1.5,"PAH",8,1,48,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,85,22,1.5,"PAH",8,1,49,0)=""
^DIC(9.4,85,22,1.5,"PAH",8,1,50,0)="This patch introduces the following new routine:"
^DIC(9.4,85,22,1.5,"PAH",8,1,51,0)="VAQPRE34 - pre-init has no user-callable entry points"
