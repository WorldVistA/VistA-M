^DIC(9.4,140,22,20,"PAH",1,1,30,0)="RMPR29C      7821428     7921291"
^DIC(9.4,140,22,20,"PAH",1,1,31,0)="RMPR6        20477861    20520152"
^DIC(9.4,140,22,20,"PAH",1,1,32,0)="RMPR29A      17059538    17069195"
^DIC(9.4,140,22,20,"PAH",1,1,33,0)="RMPRSTK      15195669    14968768"
^DIC(9.4,140,22,20,"PAH",1,1,34,0)=" "
^DIC(9.4,140,22,20,"PAH",1,1,35,0)="  INSTALLATION:"
^DIC(9.4,140,22,20,"PAH",1,1,36,0)=" "
^DIC(9.4,140,22,20,"PAH",1,1,37,0)="   1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,140,22,20,"PAH",1,1,38,0)="option will load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",1,1,39,0)=" "
^DIC(9.4,140,22,20,"PAH",1,1,40,0)="   2. Answer NO to the question: 'Shall I preserve what is on disk in a"
^DIC(9.4,140,22,20,"PAH",1,1,41,0)="separate back-up message ?'"
^DIC(9.4,140,22,20,"PAH",1,1,42,0)=" "
^DIC(9.4,140,22,20,"PAH",1,1,43,0)="   3. The patch has now been loaded into a Transport global on your"
^DIC(9.4,140,22,20,"PAH",1,1,44,0)="system. You now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",1,1,45,0)=" "
^DIC(9.4,140,22,20,"PAH",1,1,46,0)="  4.  From the 'Installation' menu, use the option 'Verify Checksums 'in"
^DIC(9.4,140,22,20,"PAH",1,1,47,0)="the Transport Global' and verify that all routines have the correct"
^DIC(9.4,140,22,20,"PAH",1,1,48,0)="checksum."
^DIC(9.4,140,22,20,"PAH",1,1,49,0)=" "
^DIC(9.4,140,22,20,"PAH",1,1,50,0)="   5. On the KIDS menu, under the 'Installation' menu, use the option"
^DIC(9.4,140,22,20,"PAH",1,1,51,0)="'Install Package(s)'. Select the package 'RMPR*3.0*13' and proceed with"
^DIC(9.4,140,22,20,"PAH",1,1,52,0)="installation."
^DIC(9.4,140,22,20,"PAH",2,0)="14^2960924^1"
^DIC(9.4,140,22,20,"PAH",2,1,0)="^^21^21^2960924"
^DIC(9.4,140,22,20,"PAH",2,1,1,0)="Routine RMPRSTL was obmitted from Patch RMPR*3*13."
^DIC(9.4,140,22,20,"PAH",2,1,2,0)="This patch contains routine RMPRSTL."
^DIC(9.4,140,22,20,"PAH",2,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",2,1,4,0)="It is very important to install this patch prior to the end of"
^DIC(9.4,140,22,20,"PAH",2,1,5,0)="the quarter to assure that Prosthetics will report accurate information."
^DIC(9.4,140,22,20,"PAH",2,1,6,0)=" "
^DIC(9.4,140,22,20,"PAH",2,1,7,0)="INSTALLATION:"
^DIC(9.4,140,22,20,"PAH",2,1,8,0)=" "
^DIC(9.4,140,22,20,"PAH",2,1,9,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,140,22,20,"PAH",2,1,10,0)="option will load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",2,1,11,0)=" "
^DIC(9.4,140,22,20,"PAH",2,1,12,0)="2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,140,22,20,"PAH",2,1,13,0)="system. You now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",2,1,14,0)=" "
^DIC(9.4,140,22,20,"PAH",2,1,15,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums 'in"
^DIC(9.4,140,22,20,"PAH",2,1,16,0)="the Transport Global' and verify that all routines have the correct"
^DIC(9.4,140,22,20,"PAH",2,1,17,0)="checksum."
^DIC(9.4,140,22,20,"PAH",2,1,18,0)=" "
^DIC(9.4,140,22,20,"PAH",2,1,19,0)="4. On the KIDS menu, under the 'Installation' menu, use the option"
^DIC(9.4,140,22,20,"PAH",2,1,20,0)="'Install Package(s)'. Select the package 'RMPR*3.0*14' and proceed with"
^DIC(9.4,140,22,20,"PAH",2,1,21,0)="installation."
^DIC(9.4,140,22,20,"PAH",3,0)="15^2960924^1"
^DIC(9.4,140,22,20,"PAH",3,1,0)="^^31^31^2960924"
^DIC(9.4,140,22,20,"PAH",3,1,1,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,2,0)="1.  Reprint Option, PCR    Reprint a Purchase Card Form has been "
^DIC(9.4,140,22,20,"PAH",3,1,3,0)="modified to allow a closed VISA transaction to be reprinted."
^DIC(9.4,140,22,20,"PAH",3,1,4,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,5,0)="2.  Purchasing Option, EDPC   Edit Purchase Card Transaction has "
^DIC(9.4,140,22,20,"PAH",3,1,6,0)="been modified to allow editing the Bank Authorization Number "
^DIC(9.4,140,22,20,"PAH",3,1,7,0)="after the VISA transaction has been closed."
^DIC(9.4,140,22,20,"PAH",3,1,8,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,9,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,10,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,11,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,12,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,13,0)="Checksum   After Install"
^DIC(9.4,140,22,20,"PAH",3,1,14,0)="RMPR4P21   18707942"
^DIC(9.4,140,22,20,"PAH",3,1,15,0)="RMPR4EPC   1452962    "
^DIC(9.4,140,22,20,"PAH",3,1,16,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,17,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,18,0)="INSTALLATION:"
^DIC(9.4,140,22,20,"PAH",3,1,19,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,20,0)="   1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option"
^DIC(9.4,140,22,20,"PAH",3,1,21,0)="will load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",3,1,22,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,23,0)="   2. The patch has now been loaded into a Transport global on your system."
^DIC(9.4,140,22,20,"PAH",3,1,24,0)="You now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",3,1,25,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,26,0)="  3.  From the 'Installation' menu, use the option 'Verify Checksums 'in the"
^DIC(9.4,140,22,20,"PAH",3,1,27,0)="Transport Global' and verify that all routines have the correct checksum."
^DIC(9.4,140,22,20,"PAH",3,1,28,0)=" "
^DIC(9.4,140,22,20,"PAH",3,1,29,0)="  4. On the KIDS menu, under the 'Installation' menu, use the option 'Install"
^DIC(9.4,140,22,20,"PAH",3,1,30,0)="Package(s)'. Select the package 'RMPR*3.0*15' and proceed with installation."
^DIC(9.4,140,22,20,"PAH",3,1,31,0)=" "
^DIC(9.4,140,22,20,"PAH",4,0)="12^2960924^1"
^DIC(9.4,140,22,20,"PAH",4,1,0)="^^117^117^2960924"
^DIC(9.4,140,22,20,"PAH",4,1,1,0)="The HCPCS Coding Work Group and EP has just completed "
^DIC(9.4,140,22,20,"PAH",4,1,2,0)="the final review of the HCPCS functionality."
^DIC(9.4,140,22,20,"PAH",4,1,3,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,4,0)="This patch will bring in new functionality consistent "
^DIC(9.4,140,22,20,"PAH",4,1,5,0)="with private sector coding standards.  This is also the "
^DIC(9.4,140,22,20,"PAH",4,1,6,0)="coding system used by MCCR for billing purposes and "
^DIC(9.4,140,22,20,"PAH",4,1,7,0)="will be utilized by DSS.  It is imperative that we use "
^DIC(9.4,140,22,20,"PAH",4,1,8,0)="a coding system that is consistent throughout the DVA "
^DIC(9.4,140,22,20,"PAH",4,1,9,0)="system for accountability of information.  This is why "
^DIC(9.4,140,22,20,"PAH",4,1,10,0)="this patch RMPR*3*12 was developed."
^DIC(9.4,140,22,20,"PAH",4,1,11,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,12,0)="This information will also be used to capture data "
^DIC(9.4,140,22,20,"PAH",4,1,13,0)="reported on AMIS, and will ultimately be part of an "
^DIC(9.4,140,22,20,"PAH",4,1,14,0)="AMIS replacement system."
^DIC(9.4,140,22,20,"PAH",4,1,15,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,16,0)="This patch brings in a new server option and server "
^DIC(9.4,140,22,20,"PAH",4,1,17,0)="routine.  You will need to create a new Mail Group "
^DIC(9.4,140,22,20,"PAH",4,1,18,0)="called RMPR SERVER, and assign the Chief of Prosthetics "
^DIC(9.4,140,22,20,"PAH",4,1,19,0)="as a member.  Members of this mail group will receive a "
^DIC(9.4,140,22,20,"PAH",4,1,20,0)="message that the server has been activated."
^DIC(9.4,140,22,20,"PAH",4,1,21,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,22,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,23,0)="Patch Dependencies"
^DIC(9.4,140,22,20,"PAH",4,1,24,0)="------------------"
^DIC(9.4,140,22,20,"PAH",4,1,25,0)="The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",4,1,26,0)="RMPR*3*3"
^DIC(9.4,140,22,20,"PAH",4,1,27,0)="RMPR*3*13"
^DIC(9.4,140,22,20,"PAH",4,1,28,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,29,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,30,0)="Installation Overview"
^DIC(9.4,140,22,20,"PAH",4,1,31,0)="---------------------"
^DIC(9.4,140,22,20,"PAH",4,1,32,0)="If installed during the normal work day it is "
^DIC(9.4,140,22,20,"PAH",4,1,33,0)="recommended that the following menu options (File #19) "
^DIC(9.4,140,22,20,"PAH",4,1,34,0)="and all of their descendants be disabled to prevent "
^DIC(9.4,140,22,20,"PAH",4,1,35,0)="possible conflicts.  Other DHCP users will not be affected."
^DIC(9.4,140,22,20,"PAH",4,1,36,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,37,0)="RMPR OFFICICAL"
^DIC(9.4,140,22,20,"PAH",4,1,38,0)="RMPR CLERK"
^DIC(9.4,140,22,20,"PAH",4,1,39,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,40,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",4,1,41,0)="------------"
^DIC(9.4,140,22,20,"PAH",4,1,42,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",4,1,43,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,44,0)="Installation"
^DIC(9.4,140,22,20,"PAH",4,1,45,0)="------------"
^DIC(9.4,140,22,20,"PAH",4,1,46,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,47,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option will"
^DIC(9.4,140,22,20,"PAH",4,1,48,0)="load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",4,1,49,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,50,0)="2. The patch has now been loaded into a Transport global on your system. You"
^DIC(9.4,140,22,20,"PAH",4,1,51,0)="now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",4,1,52,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,53,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums 'in the"
^DIC(9.4,140,22,20,"PAH",4,1,54,0)="Transport Global' and verify that all routines have the correct checksum."
^DIC(9.4,140,22,20,"PAH",4,1,55,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,56,0)="4. On the KIDS menu, under the 'Installation' menu, use the option 'Install"
^DIC(9.4,140,22,20,"PAH",4,1,57,0)="Package(s)'. Select the package 'RMPR*3.0*12' and proceed with installation."
^DIC(9.4,140,22,20,"PAH",4,1,58,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,59,0)="Creat Mail Group"
^DIC(9.4,140,22,20,"PAH",4,1,60,0)="----------------"
^DIC(9.4,140,22,20,"PAH",4,1,61,0)="      Use VA FileMan to add the Mail Group:"
^DIC(9.4,140,22,20,"PAH",4,1,62,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,63,0)="      *Note: This Mail Group must have a real user in the MEMBER field."
^DIC(9.4,140,22,20,"PAH",4,1,64,0)=">D P^DI"
^DIC(9.4,140,22,20,"PAH",4,1,65,0)="   ------"
^DIC(9.4,140,22,20,"PAH",4,1,66,0)="  VA FileMan 21.0"
^DIC(9.4,140,22,20,"PAH",4,1,67,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,68,0)="  Select OPTION: ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,140,22,20,"PAH",4,1,69,0)="                 --------------------------"
^DIC(9.4,140,22,20,"PAH",4,1,70,0)="  INPUT TO WHAT FILE: MAIL GROUP    (XX entries)"
^DIC(9.4,140,22,20,"PAH",4,1,71,0)="                      ----------"
^DIC(9.4,140,22,20,"PAH",4,1,72,0)="  EDIT WHICH FIELD: ALL// <return>"
^DIC(9.4,140,22,20,"PAH",4,1,73,0)="                          --------"
^DIC(9.4,140,22,20,"PAH",4,1,74,0)=" "
^DIC(9.4,140,22,20,"PAH",4,1,75,0)="  Select MAIL GROUP NAME: RMPR SERVER"
^DIC(9.4,140,22,20,"PAH",4,1,76,0)="                          -----------"
^DIC(9.4,140,22,20,"PAH",4,1,77,0)="  Are you adding 'RMPR SERVER' as a new MAIL GROUP (the XXX)? Y  (Yes)"
^DIC(9.4,140,22,20,"PAH",4,1,78,0)=""
^DIC(9.4,140,22,20,"PAH",4,1,79,0)="   MAIL GROUP COORDINATOR: <enter a coordinator>"
^DIC(9.4,140,22,20,"PAH",4,1,80,0)="Select MEMBER: LNAME,FNAME <== Enter a real user here"
^DIC(9.4,140,22,20,"PAH",4,1,81,0)="   Are you adding 'LNAME,FNAME' as a new MEM (the X for this MAIL GROUP)?"
^DIC(9.4,140,22,20,"PAH",4,1,82,0)="    Y (Yes)"
^DIC(9.4,140,22,20,"PAH",4,1,83,0)="    -"
^DIC(9.4,140,22,20,"PAH",4,1,84,0)="   Select MEMBER:  <return>"
^DIC(9.4,140,22,20,"PAH",4,1,85,0)="                   --------"
^DIC(9.4,140,22,20,"PAH",4,1,86,0)="     DESCRIPTION:  <return>"
^DIC(9.4,140,22,20,"PAH",4,1,87,0)="                   --------"
^DIC(9.4,140,22,20,"PAH",4,1,88,0)="      1> This Mail Group is used to alert Prosthetic Service Chiefs"
^DIC(9.4,140,22,20,"PAH",4,1,89,0)="        -----------------------------------------------------------"
^DIC(9.4,140,22,20,"PAH",4,1,90,0)="      2>that the National Data Extract Server has been activated, by who,"
^DIC(9.4,140,22,20,"PAH",4,1,91,0)="        -----------------------------------------------------------------"
^DIC(9.4,140,22,20,"PAH",4,1,92,0)="      3>and for what dates."
^DIC(9.4,140,22,20,"PAH",4,1,93,0)="        -------------------"
^DIC(9.4,140,22,20,"PAH",4,1,94,0)="      4>"
^DIC(9.4,140,22,20,"PAH",4,1,95,0)="     EDIT Option: <return>"
^DIC(9.4,140,22,20,"PAH",4,1,96,0)="     TYPE: pu  public"
^DIC(9.4,140,22,20,"PAH",4,1,97,0)="           --"
^DIC(9.4,140,22,20,"PAH",4,1,98,0)="     ORGANIZER: <enter a organizer>"
^DIC(9.4,140,22,20,"PAH",4,1,99,0)="                ------------------"
^DIC(9.4,140,22,20,"PAH",4,1,100,0)="     COORDINATOR: LNAME,FNAME// <return>"
^DIC(9.4,140,22,20,"PAH",4,1,101,0)="                  -----------"
^DIC(9.4,140,22,20,"PAH",4,1,102,0)="     Select AUTHORIZED SENDER:   <return>"
^DIC(9.4,140,22,20,"PAH",4,1,103,0)="                                 --------"
^DIC(9.4,140,22,20,"PAH",4,1,104,0)="     ALLOW SELF ENROLLMENT?: n  NO"
^DIC(9.4,140,22,20,"PAH",4,1,105,0)="                             -"
^DIC(9.4,140,22,20,"PAH",4,1,106,0)="     REFERENCE COUNT:  <return>"
^DIC(9.4,140,22,20,"PAH",4,1,107,0)="                       --------"
^DIC(9.4,140,22,20,"PAH",4,1,108,0)="     LAST REFERENCED: <return>"
^DIC(9.4,140,22,20,"PAH",4,1,109,0)="                      --------"
^DIC(9.4,140,22,20,"PAH",4,1,110,0)="     RESTRICTIONS: 0  UNRESTRICTED"
^DIC(9.4,140,22,20,"PAH",4,1,111,0)="                   -"
^DIC(9.4,140,22,20,"PAH",4,1,112,0)="   Select MEMBER GROUP NAME: <return>"
^DIC(9.4,140,22,20,"PAH",4,1,113,0)="                             --------"
^DIC(9.4,140,22,20,"PAH",4,1,114,0)="   Select REMOTE MEMBERS: <return>"
^DIC(9.4,140,22,20,"PAH",4,1,115,0)="                         ---------"
^DIC(9.4,140,22,20,"PAH",4,1,116,0)="   Select DISTRIBUTION LIST:  <return>"
^DIC(9.4,140,22,20,"PAH",4,1,117,0)="                              --------"
^DIC(9.4,140,22,20,"PAH",5,0)="16^2960924^1"
^DIC(9.4,140,22,20,"PAH",5,1,0)="^^41^41^2960924"
^DIC(9.4,140,22,20,"PAH",5,1,1,0)="When Prosthetics is using GIP, option Issue From Stock does not prompt"
^DIC(9.4,140,22,20,"PAH",5,1,2,0)="for HCPCS code.  This patch will add the functionality to sites"
^DIC(9.4,140,22,20,"PAH",5,1,3,0)="using GIP."
^DIC(9.4,140,22,20,"PAH",5,1,4,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,5,0)="Reference  NOIS CLA-0996-21207."
^DIC(9.4,140,22,20,"PAH",5,1,6,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,7,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,8,0)="Patch Dependencies"
^DIC(9.4,140,22,20,"PAH",5,1,9,0)="------------------"
^DIC(9.4,140,22,20,"PAH",5,1,10,0)="The following patch MUST BE INSTALLED prior to loading this patch;"
^DIC(9.4,140,22,20,"PAH",5,1,11,0)="                  RMPR*3*12"
^DIC(9.4,140,22,20,"PAH",5,1,12,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,13,0)="Installation Overview"
^DIC(9.4,140,22,20,"PAH",5,1,14,0)="---------------------"
^DIC(9.4,140,22,20,"PAH",5,1,15,0)="If installed during the normal work day it is"
^DIC(9.4,140,22,20,"PAH",5,1,16,0)="recommended that the following menu options (File #19)"
^DIC(9.4,140,22,20,"PAH",5,1,17,0)="and all their descendants be disabled to prevent"
^DIC(9.4,140,22,20,"PAH",5,1,18,0)="possible conflicts.. Other DHCP users will not be affected."
^DIC(9.4,140,22,20,"PAH",5,1,19,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,20,0)="RMPR OFFICIAL"
^DIC(9.4,140,22,20,"PAH",5,1,21,0)="RMPR CLERK"
^DIC(9.4,140,22,20,"PAH",5,1,22,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",5,1,23,0)="-------------"
^DIC(9.4,140,22,20,"PAH",5,1,24,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",5,1,25,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,26,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,27,0)="INSTALLATION:"
^DIC(9.4,140,22,20,"PAH",5,1,28,0)="-------------"
^DIC(9.4,140,22,20,"PAH",5,1,29,0)="  1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,140,22,20,"PAH",5,1,30,0)="option will load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",5,1,31,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,32,0)="  2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,140,22,20,"PAH",5,1,33,0)="system. You now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",5,1,34,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,35,0)="  3.  From the 'Installation' menu, use the option 'Verify Checksums 'in"
^DIC(9.4,140,22,20,"PAH",5,1,36,0)="the Transport Global' and verify that the routine RMPRSTK has the correct"
^DIC(9.4,140,22,20,"PAH",5,1,37,0)="checksum."
^DIC(9.4,140,22,20,"PAH",5,1,38,0)=" "
^DIC(9.4,140,22,20,"PAH",5,1,39,0)="  4. On the KIDS menu, under the 'Installation' menu, use the option"
^DIC(9.4,140,22,20,"PAH",5,1,40,0)="'Install Package(s)'. Select the package 'RMPR*3.0*16' and proceed with"
^DIC(9.4,140,22,20,"PAH",5,1,41,0)="installation."
^DIC(9.4,140,22,20,"PAH",6,0)="17^2961002^1"
^DIC(9.4,140,22,20,"PAH",6,1,0)="^^2^2^2961002"
^DIC(9.4,140,22,20,"PAH",6,1,1,0)="This has only one input template RMPRE2319 for file 660."
^DIC(9.4,140,22,20,"PAH",6,1,2,0)="This will allow editing HCPCS in 2319 record."
^DIC(9.4,140,22,20,"PAH",7,0)="18^2961115^1"
^DIC(9.4,140,22,20,"PAH",7,1,0)="^^34^34^2961115"
^DIC(9.4,140,22,20,"PAH",7,1,1,0)="Patch Dependencies"
^DIC(9.4,140,22,20,"PAH",7,1,2,0)="------------------"
^DIC(9.4,140,22,20,"PAH",7,1,3,0)="The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",7,1,4,0)="RMPR*3*12"
^DIC(9.4,140,22,20,"PAH",7,1,5,0)="XM*DBA*104 "
^DIC(9.4,140,22,20,"PAH",7,1,6,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,7,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,8,0)=" Installation Overview"
^DIC(9.4,140,22,20,"PAH",7,1,9,0)=" ---------------------"
^DIC(9.4,140,22,20,"PAH",7,1,10,0)="All users may be on the system while this patch is loaded."
^DIC(9.4,140,22,20,"PAH",7,1,11,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,12,0)="Install Time"
^DIC(9.4,140,22,20,"PAH",7,1,13,0)="------------"
^DIC(9.4,140,22,20,"PAH",7,1,14,0)="The estimated install time is 2 minutes or less."
^DIC(9.4,140,22,20,"PAH",7,1,15,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,16,0)="Installation"
^DIC(9.4,140,22,20,"PAH",7,1,17,0)="------------"
^DIC(9.4,140,22,20,"PAH",7,1,18,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,19,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option l"
^DIC(9.4,140,22,20,"PAH",7,1,20,0)="load the KIDS package in this message onto your system."
^DIC(9.4,140,22,20,"PAH",7,1,21,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,22,0)="2. The patch has now been loaded into a Transport global on your system. You"
^DIC(9.4,140,22,20,"PAH",7,1,23,0)="now need to use KIDS to install the Transport global."
^DIC(9.4,140,22,20,"PAH",7,1,24,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,25,0)="3.  From the 'Installation' menu, use the option 'Verify Checksums 'in the"
^DIC(9.4,140,22,20,"PAH",7,1,26,0)="Transport Global' and verify that all routines have the correct checksum."
^DIC(9.4,140,22,20,"PAH",7,1,27,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,28,0)="4. On the KIDS menu, under the 'Installation' menu, use the option 'Install"
^DIC(9.4,140,22,20,"PAH",7,1,29,0)="Package(s)'. Select the package 'RMPR*3.0*18' and proceed with installation."
^DIC(9.4,140,22,20,"PAH",7,1,30,0)=" "
^DIC(9.4,140,22,20,"PAH",7,1,31,0)=" Verify Mail Group "
^DIC(9.4,140,22,20,"PAH",7,1,32,0)="----------------"
^DIC(9.4,140,22,20,"PAH",7,1,33,0)="Please verify that mail group RMPR SERVER is on your system, and the Chief of"
^DIC(9.4,140,22,20,"PAH",7,1,34,0)="Prosthetics is a member."
^DIC(9.4,140,22,20,"PAH",8,0)="19^2961205^1"
^DIC(9.4,140,22,20,"PAH",8,1,0)="^^87^87^2961205"
^DIC(9.4,140,22,20,"PAH",8,1,1,0)="Description:"
^DIC(9.4,140,22,20,"PAH",8,1,2,0)="========================"
^DIC(9.4,140,22,20,"PAH",8,1,3,0)="This patch was developed in response to the Eligibility Refom"
^DIC(9.4,140,22,20,"PAH",8,1,4,0)="introduced by PL-104-262."
^DIC(9.4,140,22,20,"PAH",8,1,5,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,6,0)="This patch will add the new public law as a choice when you add a"
^DIC(9.4,140,22,20,"PAH",8,1,7,0)="disability code."
^DIC(9.4,140,22,20,"PAH",8,1,8,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,9,0)="You will find when you select OPT/NSC under PATIENT CATEGORY, and"
^DIC(9.4,140,22,20,"PAH",8,1,10,0)="then prompted for SPECIAL CATEGORY a forth item has been added,"
^DIC(9.4,140,22,20,"PAH",8,1,11,0)="ELIGIBILITY REFORM.  Even though Eligibility Reform is suitable for"
^DIC(9.4,140,22,20,"PAH",8,1,12,0)="both Special Legislation and Eligibility Reform, you should select"
^DIC(9.4,140,22,20,"PAH",8,1,13,0)="Eligibility Reform so the transactions can be separated for trending"
^DIC(9.4,140,22,20,"PAH",8,1,14,0)="analysis."
^DIC(9.4,140,22,20,"PAH",8,1,15,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,16,0)="Example:"
^DIC(9.4,140,22,20,"PAH",8,1,17,0)=" TYPE OF TRANSACTION: INITIAL ISSUE//"
^DIC(9.4,140,22,20,"PAH",8,1,18,0)=" PATIENT CATEGORY: SC/OP// ?"
^DIC(9.4,140,22,20,"PAH",8,1,19,0)="      Enter the Patient Category for this issue."
^DIC(9.4,140,22,20,"PAH",8,1,20,0)="      Choose from:"
^DIC(9.4,140,22,20,"PAH",8,1,21,0)="        1        SC/OP"
^DIC(9.4,140,22,20,"PAH",8,1,22,0)="        2        SC/IP"
^DIC(9.4,140,22,20,"PAH",8,1,23,0)="        3        NSC/IP"
^DIC(9.4,140,22,20,"PAH",8,1,24,0)="        4        NSC/OP"
^DIC(9.4,140,22,20,"PAH",8,1,25,0)=" PATIENT CATEGORY: SC/OP// 4  NSC/OP"
^DIC(9.4,140,22,20,"PAH",8,1,26,0)=" SPECIAL CATEGORY: ?"
^DIC(9.4,140,22,20,"PAH",8,1,27,0)="      Enter the patient's Special Category if applicable."
^DIC(9.4,140,22,20,"PAH",8,1,28,0)="      Choose from:"
^DIC(9.4,140,22,20,"PAH",8,1,29,0)="        1        SPECIAL LEGISLATION"
^DIC(9.4,140,22,20,"PAH",8,1,30,0)="         2        A&A"
^DIC(9.4,140,22,20,"PAH",8,1,31,0)="             3        PHC"
^DIC(9.4,140,22,20,"PAH",8,1,32,0)="            4        ELIGIBILITY REFORM"
^DIC(9.4,140,22,20,"PAH",8,1,33,0)=" SPECIAL CATEGORY: 4  ELIGIBILITY REFORM"
^DIC(9.4,140,22,20,"PAH",8,1,34,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,35,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,36,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,37,0)=" "
^DIC(9.4,140,22,20,"PAH",8,1,38,0)="  Patch Dependencies:"
^DIC(9.4,140,22,20,"PAH",8,1,39,0)="  ======================="
^DIC(9.4,140,22,20,"PAH",8,1,40,0)="  The following patches MUST BE INSTALLED prior to loading this patch:"
^DIC(9.4,140,22,20,"PAH",8,1,41,0)="  RMPR*3*3"
^DIC(9.4,140,22,20,"PAH",8,1,42,0)="  RMPR*3*12"
^DIC(9.4,140,22,20,"PAH",8,1,43,0)="  RMPR*3*15"
