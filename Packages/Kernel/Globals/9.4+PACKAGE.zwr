^DIC(9.4,47,22,5.9,"PAH",84,0)="155 SEQ #162^2980423^1"
^DIC(9.4,47,22,5.9,"PAH",84,1,0)="^^6^6^2980423"
^DIC(9.4,47,22,5.9,"PAH",84,1,1,0)="This KIDS build is created to send out a new cross reference on the Date of"
^DIC(9.4,47,22,5.9,"PAH",84,1,2,0)="Death field.  This new cross reference will call an Outpatient Pharmacy"
^DIC(9.4,47,22,5.9,"PAH",84,1,3,0)="routine (APSOD^PSOCAN3(DA))."
^DIC(9.4,47,22,5.9,"PAH",84,1,4,0)="This code will discontinue all active prescriptions when a date of death is"
^DIC(9.4,47,22,5.9,"PAH",84,1,5,0)="entered for a patient.  This new xref is used with version 7.0 of Outpatient"
^DIC(9.4,47,22,5.9,"PAH",84,1,6,0)="Pharmacy."
^DIC(9.4,47,22,5.9,"PAH",85,0)="184 SEQ #163^2980430^1"
