^DIC(9.4,4,22,1,"PAH",87,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",87,1,3,0)="NOIS: SHR-0200-72671"
^DIC(9.4,4,22,1,"PAH",87,1,4,0)="Test Site:  Shreveport, LA"
^DIC(9.4,4,22,1,"PAH",87,1,5,0)="Fix a typo that causes the status of a server message to remain ""hand off"
