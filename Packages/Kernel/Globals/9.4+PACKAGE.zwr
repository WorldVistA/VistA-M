^DIC(9.4,4,22,1,"PAH",17,1,323,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",18,0)="45 SEQ #39^2970528^1"
^DIC(9.4,4,22,1,"PAH",18,1,0)="^^46^46^2970528"
^DIC(9.4,4,22,1,"PAH",18,1,1,0)="MailMan patch XM*7.1*45 contains the following bug fix:"
^DIC(9.4,4,22,1,"PAH",18,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",18,1,3,0)="E3R:        9706"
^DIC(9.4,4,22,1,"PAH",18,1,4,0)="Rtns:       ^XMA5,^XMHIG"
^DIC(9.4,4,22,1,"PAH",18,1,5,0)="Option:     XMHELPGROUP"
^DIC(9.4,4,22,1,"PAH",18,1,6,0)="Test Sites: Fort Meade, Brockton"
^DIC(9.4,4,22,1,"PAH",18,1,7,0)="When a user deletes a mail group, references to it from other mail groups"
^DIC(9.4,4,22,1,"PAH",18,1,8,0)="are not deleted.  When a user gets help on a mail group which has a"
^DIC(9.4,4,22,1,"PAH",18,1,9,0)="non-existent mail group as a member, MailMan bombs.  This patch will keep"
^DIC(9.4,4,22,1,"PAH",18,1,10,0)="MailMan from bombing and will delete non-existent mail group references"
^DIC(9.4,4,22,1,"PAH",18,1,11,0)="during mail group inquiry."
^DIC(9.4,4,22,1,"PAH",18,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",18,1,13,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",18,1,14,0)="This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",18,1,15,0)="minimum.  You should put the XMUSER Option out of order."
^DIC(9.4,4,22,1,"PAH",18,1,16,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",18,1,17,0)=" "
^DIC(9.4,4,22,1,"PAH",18,1,18,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",18,1,19,0)="1.  If any of these routines is mapped (on systems which allow mapping),"
^DIC(9.4,4,22,1,"PAH",18,1,20,0)="    disable mapping for the affected routine(s)."
^DIC(9.4,4,22,1,"PAH",18,1,21,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads"
^DIC(9.4,4,22,1,"PAH",18,1,22,0)="    the patch into a Transport Global on your system."
^DIC(9.4,4,22,1,"PAH",18,1,23,0)="3.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",18,1,24,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",18,1,25,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",18,1,26,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",18,1,27,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",18,1,28,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",18,1,29,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",18,1,30,0)="4.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",18,1,31,0)="    other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",18,1,32,0)="5.  AXP Sites, after patch has installed, rebuild your map set."
^DIC(9.4,4,22,1,"PAH",18,1,33,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",18,1,34,0)="  "
^DIC(9.4,4,22,1,"PAH",18,1,35,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",18,1,36,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",18,1,37,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",18,1,38,0)=" "
^DIC(9.4,4,22,1,"PAH",18,1,39,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",18,1,40,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,1,"PAH",18,1,41,0)="----------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",18,1,42,0)="XMA5           1197080         11192062       31,45"
^DIC(9.4,4,22,1,"PAH",18,1,43,0)="XMHIG          * new *          4741088       45"
^DIC(9.4,4,22,1,"PAH",18,1,44,0)=""
^DIC(9.4,4,22,1,"PAH",18,1,45,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",18,1,46,0)="============================================================================"
^DIC(9.4,4,22,1,"PAH",19,0)="41 SEQ #40^2970528^1"
^DIC(9.4,4,22,1,"PAH",19,1,0)="^^48^48^2970528"
^DIC(9.4,4,22,1,"PAH",19,1,1,0)="MailMan patch XM*7.1*41 contains the following bug fixes and enhancements:"
^DIC(9.4,4,22,1,"PAH",19,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",19,1,3,0)="NOIS:       IND-0297-42072"
^DIC(9.4,4,22,1,"PAH",19,1,4,0)="Rtn:        ^XMGAPI2"
^DIC(9.4,4,22,1,"PAH",19,1,5,0)="Test Site:  Indianapolis,IN"
^DIC(9.4,4,22,1,"PAH",19,1,6,0)="Returns info for broadcast message now, instead of returning error stating that"
^DIC(9.4,4,22,1,"PAH",19,1,7,0)="user is not sender or recipient.  Returns message type correctly now. "
^DIC(9.4,4,22,1,"PAH",19,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",19,1,9,0)="Note correct definition for the following variable:"
^DIC(9.4,4,22,1,"PAH",19,1,10,0)="       L(""SENDER"")     - sender's name"
^DIC(9.4,4,22,1,"PAH",19,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",19,1,12,0)="Returns 4 new variables:"
^DIC(9.4,4,22,1,"PAH",19,1,13,0)="       L(""SENDER DUZ"") - sender's DUZ (null if remote)"
^DIC(9.4,4,22,1,"PAH",19,1,14,0)="       L(""BSKT IEN"")   - basket IEN"
^DIC(9.4,4,22,1,"PAH",19,1,15,0)="       L(""DATE FM"")    - date sent, in FileMan format (null if uncertain)"
^DIC(9.4,4,22,1,"PAH",19,1,16,0)="       L(""BROADCAST"")  - 1 if message was broadcast; 0 otherwise"
^DIC(9.4,4,22,1,"PAH",19,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",19,1,18,0)="Please correct/include in documentation in 'MailMan V.7.1 Programmer Reference"
^DIC(9.4,4,22,1,"PAH",19,1,19,0)="Manual' pages 14-16."
^DIC(9.4,4,22,1,"PAH",19,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",19,1,21,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",19,1,22,0)="This patch may be installed with users on the system."
^DIC(9.4,4,22,1,"PAH",19,1,23,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",19,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",19,1,25,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",19,1,26,0)="1.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads"
^DIC(9.4,4,22,1,"PAH",19,1,27,0)="    the patch into a Transport Global on your system."
^DIC(9.4,4,22,1,"PAH",19,1,28,0)="2.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",19,1,29,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",19,1,30,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",19,1,31,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",19,1,32,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",19,1,33,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",19,1,34,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",19,1,35,0)="3.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,4,22,1,"PAH",19,1,36,0)="    other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,4,22,1,"PAH",19,1,37,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",19,1,38,0)="  "
^DIC(9.4,4,22,1,"PAH",19,1,39,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",19,1,40,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",19,1,41,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",19,1,42,0)=" "
