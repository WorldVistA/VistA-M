^DIC(9.4,14,22,5.9,"PAH",181,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,150,0)=" List of preceding patches: 303"
^DIC(9.4,14,22,5.9,"PAH",181,1,151,0)=" Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,14,22,5.9,"PAH",181,1,152,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,153,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,154,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",181,1,155,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",181,1,156,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",181,1,157,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",181,1,158,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",181,1,159,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,160,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,161,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",181,1,162,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",181,1,163,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,164,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",181,1,165,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",181,1,166,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,168,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",181,1,169,0)="        option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",181,1,170,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,171,0)="  2.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",181,1,172,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",181,1,173,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,174,0)="  3.  From this menu, you may then elect to use the following options"
^DIC(9.4,14,22,5.9,"PAH",181,1,175,0)="      (when prompted for the INSTALL NAME, enter LR*5.2*346):"
^DIC(9.4,14,22,5.9,"PAH",181,1,176,0)="        a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",181,1,177,0)="        b. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",181,1,178,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",181,1,179,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",181,1,180,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,181,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",181,1,182,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",181,1,183,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,184,0)="   4.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",181,1,185,0)="      and select the package 'LR*5.2*346'."
^DIC(9.4,14,22,5.9,"PAH",181,1,186,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,187,0)="      When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",181,1,188,0)="      Install? YES//' choose 'NO'. Responding 'Yes' to the prompt for"
^DIC(9.4,14,22,5.9,"PAH",181,1,189,0)="      rebuilding menu trees can significantly increase install time."
^DIC(9.4,14,22,5.9,"PAH",181,1,190,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,191,0)="      When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//"
^DIC(9.4,14,22,5.9,"PAH",181,1,192,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",181,1,193,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,194,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,14,22,5.9,"PAH",181,1,195,0)="      and Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",181,1,196,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,197,0)="      During install KIDS will place the LR LAB SERVER option [LRLABSERVER]"
^DIC(9.4,14,22,5.9,"PAH",181,1,198,0)="      out of order."
^DIC(9.4,14,22,5.9,"PAH",181,1,199,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,200,0)=" Note: Routine LR346 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",181,1,201,0)=" "
^DIC(9.4,14,22,5.9,"PAH",181,1,202,0)=" "
