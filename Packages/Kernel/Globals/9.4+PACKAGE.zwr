^DIC(9.4,155,22,1,"PAH",15,1,1,0)="LEX*2.0*15 CORRECTIONS TO LEXICON PACKAGE UTILITIES"
^DIC(9.4,155,22,1,"PAH",15,1,2,0)="This patch contains correction to faults in routines LEXA1,LEXA4 and LEXU"
