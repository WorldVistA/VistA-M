^DIC(9.4,47,22,5.9,"PAH",452,1,1,0)="This patch repairs certain Patient Record Flag displays when"
^DIC(9.4,47,22,5.9,"PAH",452,1,2,0)="patient lookups are done from within ScreenMan."
^DIC(9.4,47,22,5.9,"PAH",453,0)="564^3041111^1"
^DIC(9.4,47,22,5.9,"PAH",454,0)="615 SEQ #536^3041111^1"
^DIC(9.4,47,22,5.9,"PAH",454,1,0)="^^3^3^3041111"
^DIC(9.4,47,22,5.9,"PAH",454,1,1,0)="This patch concerns a situation where an incomplete patient record"
^DIC(9.4,47,22,5.9,"PAH",454,1,2,0)="is temporarily created when adding a new patient, and incorrect"
^DIC(9.4,47,22,5.9,"PAH",454,1,3,0)="text in the definition of an option. "
^DIC(9.4,47,22,5.9,"PAH",455,0)="625 SEQ #537^3041124^1"
^DIC(9.4,47,22,5.9,"PAH",456,0)="582 SEQ #538^3041124^1"
^DIC(9.4,47,22,5.9,"PAH",456,1,0)="^^4^4^3041124"
^DIC(9.4,47,22,5.9,"PAH",456,1,1,0)="1. Due to sites experiencing performance issues, modifications were made "
^DIC(9.4,47,22,5.9,"PAH",456,1,2,0)="   to have tasks removed from Taskman after completion."
^DIC(9.4,47,22,5.9,"PAH",456,1,3,0)="2. Modification to prevent duplicate ISO bulletins and log entries "
^DIC(9.4,47,22,5.9,"PAH",456,1,4,0)="   created during the addition of a spouse or dependant."
^DIC(9.4,47,22,5.9,"PAH",457,0)="478^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",457,1,0)="^^1^1^3041228"
^DIC(9.4,47,22,5.9,"PAH",457,1,1,0)="Add Clinical Reminder index cross-references to PTF."
^DIC(9.4,47,22,5.9,"PAH",458,0)="598 SEQ #544^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",459,0)="568^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",460,0)="637^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",461,0)="600 SEQ #540^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",461,1,0)="^^1^1^3041228"
^DIC(9.4,47,22,5.9,"PAH",461,1,1,0)="This patch is concerned with identifying test patients."
^DIC(9.4,47,22,5.9,"PAH",462,0)="605 SEQ #541^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",462,1,0)="^^2^2^3041228"
^DIC(9.4,47,22,5.9,"PAH",462,1,1,0)="This patch will incorporate the changes required by the FEE BASIS "
^DIC(9.4,47,22,5.9,"PAH",462,1,2,0)="Encapsulation Project.  No functionality will be introduced."
^DIC(9.4,47,22,5.9,"PAH",463,0)="604 SEQ #542^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",463,1,0)="^^2^2^3041228"
^DIC(9.4,47,22,5.9,"PAH",463,1,1,0)="Patient Safety issue regarding iens with decimals; "
^DIC(9.4,47,22,5.9,"PAH",463,1,2,0)="routines with undefined variables"
^DIC(9.4,47,22,5.9,"PAH",464,0)="617^3041228^1"
^DIC(9.4,47,22,5.9,"PAH",465,0)="485 SEQ #547^3050118^1"
^DIC(9.4,47,22,5.9,"PAH",465,1,0)="^^5^5^3050118"
^DIC(9.4,47,22,5.9,"PAH",465,1,1,0)="Patch is in support of Pub. L. 107-103, section 505."
^DIC(9.4,47,22,5.9,"PAH",465,1,2,0)="This patch will add new fields to the patient file and new options"
^DIC(9.4,47,22,5.9,"PAH",465,1,3,0)="that will allow the tracking of Fugitive Felon Information as provided"
^DIC(9.4,47,22,5.9,"PAH",465,1,4,0)="by the appropriate sources and provides both reporting and inquiry "
^DIC(9.4,47,22,5.9,"PAH",465,1,5,0)="mechanisms."
^DIC(9.4,47,22,5.9,"PAH",466,0)="628 SEQ #548^3050118^1"
^DIC(9.4,47,22,5.9,"PAH",467,0)="570 SEQ #549^3050118^1"
^DIC(9.4,47,22,5.9,"PAH",467,1,0)="^^13^13^3050118"
^DIC(9.4,47,22,5.9,"PAH",467,1,1,0)="This patch is in support of the Billing Replacement - Encapsulation "
^DIC(9.4,47,22,5.9,"PAH",467,1,2,0)="Project.  The objective of this project is to standardize existing VistA "
^DIC(9.4,47,22,5.9,"PAH",467,1,3,0)="Integrated Billing and Accounts Receivable functionality so that a new "
^DIC(9.4,47,22,5.9,"PAH",467,1,4,0)="COTS billing/AR product may be effectively integrated into the VistA "
^DIC(9.4,47,22,5.9,"PAH",467,1,5,0)="suite. This will be accomplished by replacing direct IB and AR touch "
^DIC(9.4,47,22,5.9,"PAH",467,1,6,0)="points with standard authorized API's available to all VistA packages. "
^DIC(9.4,47,22,5.9,"PAH",467,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",467,1,8,0)="This patch will replace all current direct access of Insurance "
^DIC(9.4,47,22,5.9,"PAH",467,1,9,0)="Information in the VistA Registration package with a new API call.  Code "
^DIC(9.4,47,22,5.9,"PAH",467,1,10,0)="which had been retrieving insurance information from either the INSURANCE "
^DIC(9.4,47,22,5.9,"PAH",467,1,11,0)="File (#36) or the INSURANCE TYPE sub-file (#2.312) of the PATIENT File "
^DIC(9.4,47,22,5.9,"PAH",467,1,12,0)="(#2), has been modified to use the $$INSUR^IBBAPI API call originally "
^DIC(9.4,47,22,5.9,"PAH",467,1,13,0)="released with patch IB*2*256, IB INSURANCE API."
^DIC(9.4,47,22,5.9,"PAH",468,0)="632 SEQ #550^3050118^1"
^DIC(9.4,47,22,5.9,"PAH",469,0)="621 SEQ #551^3050118^1"
^DIC(9.4,47,22,5.9,"PAH",469,1,0)="^^3^3^3050118"
^DIC(9.4,47,22,5.9,"PAH",469,1,1,0)="This patch provides a list"
^DIC(9.4,47,22,5.9,"PAH",469,1,2,0)="of records with bad SSNs, fixes the sort template for NPTF reports,"
^DIC(9.4,47,22,5.9,"PAH",469,1,3,0)="and reformats the attending MD name in HL7 segments. "
^DIC(9.4,47,22,5.9,"PAH",470,0)="623 SEQ #552^3050118^1"
^DIC(9.4,47,22,5.9,"PAH",470,1,0)="^^3^3^3050118"
^DIC(9.4,47,22,5.9,"PAH",470,1,1,0)="This patch introduces software changes for NOIS issues reported within the"
^DIC(9.4,47,22,5.9,"PAH",470,1,2,0)="Patient Records Flag module that is part of the Registration V. 5.3 "
^DIC(9.4,47,22,5.9,"PAH",470,1,3,0)="package."
^DIC(9.4,47,22,5.9,"PAH",471,0)="626 SEQ #553^3050204^1"
^DIC(9.4,47,22,5.9,"PAH",472,0)="563^3050204^1"
^DIC(9.4,47,22,5.9,"PAH",472,1,0)="^^1^1^3050204"
^DIC(9.4,47,22,5.9,"PAH",472,1,1,0)="Date of Death Enhancements"
^DIC(9.4,47,22,5.9,"PAH",473,0)="639 SEQ #555^3050204^1"
^DIC(9.4,47,22,5.9,"PAH",473,1,0)="^^3^3^3050204"
^DIC(9.4,47,22,5.9,"PAH",473,1,1,0)="OBSOLETE PROTOCOL CLEANUP"
^DIC(9.4,47,22,5.9,"PAH",473,1,2,0)="Refer to patch DG*5.3*639 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",473,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",474,0)="646 SEQ #556^3050204^1"
^DIC(9.4,47,22,5.9,"PAH",475,0)="585 SEQ #557^3050212^1"
^DIC(9.4,47,22,5.9,"PAH",476,0)="584 SEQ #558^3050311^1"
^DIC(9.4,47,22,5.9,"PAH",477,0)="609 SEQ #559^3050401^1"
^DIC(9.4,47,22,5.9,"PAH",477,1,0)="^^3^3^3050401"
^DIC(9.4,47,22,5.9,"PAH",477,1,1,0)="PTF problem with Rendering Provider for CPT updates. Inactive providers "
^DIC(9.4,47,22,5.9,"PAH",477,1,2,0)="with inactive date later than CPT record date are not allowed as valid"
^DIC(9.4,47,22,5.9,"PAH",477,1,3,0)="provider."
^DIC(9.4,47,22,5.9,"PAH",478,0)="633 SEQ #560^3050401^1"
^DIC(9.4,47,22,5.9,"PAH",478,1,0)="^^3^3^3050401"
^DIC(9.4,47,22,5.9,"PAH",478,1,1,0)="Display Bad Address Indicator at patient lookup."
^DIC(9.4,47,22,5.9,"PAH",478,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",478,1,3,0)="Report."
^DIC(9.4,47,22,5.9,"PAH",479,0)="610 SEQ #561^3050401^1"
^DIC(9.4,47,22,5.9,"PAH",480,0)="627 SEQ #562^3050401^1"
^DIC(9.4,47,22,5.9,"PAH",480,1,0)="^^13^13^3050401"
^DIC(9.4,47,22,5.9,"PAH",480,1,1,0)="This patch concerns a situation where the patient record has a large "
^DIC(9.4,47,22,5.9,"PAH",480,1,2,0)="number of aliases. The  HL7 message to update the MPI was being built"
^DIC(9.4,47,22,5.9,"PAH",480,1,3,0)="incorrectly and causing an exception on the MPI in cases where the patient"
^DIC(9.4,47,22,5.9,"PAH",480,1,4,0)="record has several aliases.  The MPI was then not able to process the"
^DIC(9.4,47,22,5.9,"PAH",480,1,5,0)="message and update the record.  "
^DIC(9.4,47,22,5.9,"PAH",480,1,6,0)="                          AND"
^DIC(9.4,47,22,5.9,"PAH",480,1,7,0)="The MPI DQ Team requests that the ALIAS SSN (2.01,1) field be added to "
^DIC(9.4,47,22,5.9,"PAH",480,1,8,0)="the Display Remote Patient Data Query [RG REMOTE PDAT DISPLAY] Option. "
^DIC(9.4,47,22,5.9,"PAH",480,1,9,0)="                          AND"
^DIC(9.4,47,22,5.9,"PAH",480,1,10,0)="The VDEF / Standardized Messaging team request that when the APID build"
^DIC(9.4,47,22,5.9,"PAH",480,1,11,0)="process is called from the VDEF process, any ""HL7 special characters"" that"
^DIC(9.4,47,22,5.9,"PAH",480,1,12,0)="could be found in patient street address data, be encoded to HL7"
^DIC(9.4,47,22,5.9,"PAH",480,1,13,0)="standards."
^DIC(9.4,47,22,5.9,"PAH",481,0)="622 SEQ #563^3050401^1"
^DIC(9.4,47,22,5.9,"PAH",481,1,0)="^^5^5^3050401"
^DIC(9.4,47,22,5.9,"PAH",481,1,1,0)="This patch will remove any duplicate race entries in the 2.02 multiple"
^DIC(9.4,47,22,5.9,"PAH",481,1,2,0)="of the patient file, and will ensure that when data is imported "
^DIC(9.4,47,22,5.9,"PAH",481,1,3,0)="using the Register Once Messaging (ROM) query during registration,"
^DIC(9.4,47,22,5.9,"PAH",481,1,4,0)="that entries in the Race and Ethnicity multiples are dynamically "
^DIC(9.4,47,22,5.9,"PAH",481,1,5,0)="numbered."
^DIC(9.4,47,22,5.9,"PAH",482,0)="642 SEQ #565^3050426^1"
^DIC(9.4,47,22,5.9,"PAH",482,1,0)="^^1^1^3050426"
^DIC(9.4,47,22,5.9,"PAH",482,1,1,0)="This patch disables old VIC prompts in Registration."
^DIC(9.4,47,22,5.9,"PAH",483,0)="629 SEQ #566^3050426^1"
^DIC(9.4,47,22,5.9,"PAH",483,1,0)="^^3^3^3050426"
^DIC(9.4,47,22,5.9,"PAH",483,1,1,0)="This patch facilitates using the VIC card in mag readers, no longer"
^DIC(9.4,47,22,5.9,"PAH",483,1,2,0)="displays messages on ""missing"" patients, and allows PTF Fee Basis "
^DIC(9.4,47,22,5.9,"PAH",483,1,3,0)="records to close."
^DIC(9.4,47,22,5.9,"PAH",484,0)="638 SEQ #567^3050426^1"
^DIC(9.4,47,22,5.9,"PAH",484,1,0)="^^10^10^3050426"
^DIC(9.4,47,22,5.9,"PAH",484,1,1,0)="Patient catastrophic edits."
^DIC(9.4,47,22,5.9,"PAH",484,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",484,1,3,0)="1.  Two or more edits (name, ssn, dob, or sex) during the Registration "
^DIC(9.4,47,22,5.9,"PAH",484,1,4,0)="process create alert to those holding the DG CATASTROPHIC EDIT key."
^DIC(9.4,47,22,5.9,"PAH",484,1,5,0)="2.  Alerts retained for 365 days."
^DIC(9.4,47,22,5.9,"PAH",484,1,6,0)="3.  Alert allows patient information displayed with collected data on "
^DIC(9.4,47,22,5.9,"PAH",484,1,7,0)="review and catastrophic edit status."
^DIC(9.4,47,22,5.9,"PAH",484,1,8,0)="4.  Report displays alert information (going back one year) on "
^DIC(9.4,47,22,5.9,"PAH",484,1,9,0)="catatastrophic edits (alerts posted, alerts reviewed, and alerts "
^DIC(9.4,47,22,5.9,"PAH",484,1,10,0)="determined to be catastrophic)."
^DIC(9.4,47,22,5.9,"PAH",485,0)="640 SEQ #568^3050506^1"
^DIC(9.4,47,22,5.9,"PAH",485,1,0)="^^3^3^3050506"
^DIC(9.4,47,22,5.9,"PAH",485,1,1,0)="This patch updates the PTF AUSTIN ERROR CODES file #45.64 and "
^DIC(9.4,47,22,5.9,"PAH",485,1,2,0)="corrects the output transform for the CONFIDENTIAL ADDRESS COUNTY "
^DIC(9.4,47,22,5.9,"PAH",485,1,3,0)="field #.14111 in the patient file."
^DIC(9.4,47,22,5.9,"PAH",486,0)="618 SEQ #569^3050506^1"
^DIC(9.4,47,22,5.9,"PAH",486,1,0)="^^2^2^3050506"
^DIC(9.4,47,22,5.9,"PAH",486,1,1,0)="Cleans up dangling PATIENT RELATIONS file # 408.12 that have a bad"
^DIC(9.4,47,22,5.9,"PAH",486,1,2,0)="pointer to a bad patient or person record (field #.01 or #.03 or both)"
^DIC(9.4,47,22,5.9,"PAH",487,0)="643 SEQ #570^3050506^1"
^DIC(9.4,47,22,5.9,"PAH",487,1,0)="^^2^2^3050506"
^DIC(9.4,47,22,5.9,"PAH",487,1,1,0)="This patch is to modify the census routines to include care provided at "
^DIC(9.4,47,22,5.9,"PAH",487,1,2,0)="non-VA facilities."
^DIC(9.4,47,22,5.9,"PAH",488,0)="614 SEQ #571^3050506^1"
^DIC(9.4,47,22,5.9,"PAH",488,1,0)="^^5^5^3050506"
^DIC(9.4,47,22,5.9,"PAH",488,1,1,0)="1. Prevent sending blank message to Austin"
^DIC(9.4,47,22,5.9,"PAH",488,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",488,1,3,0)="2. Expand DG1 segment in HL7 RAI/MDS packet to include up to 13 diagnosis"
^DIC(9.4,47,22,5.9,"PAH",488,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",488,1,5,0)="3. Error during the Process Dicom Images on DIG1 with a broker error."
^DIC(9.4,47,22,5.9,"PAH",489,0)="620 SEQ #572^3050611^1"
^DIC(9.4,47,22,5.9,"PAH",490,0)="651 SEQ #573^3050625^1"
^DIC(9.4,47,22,5.9,"PAH",490,1,0)="^^6^6^3050625"
^DIC(9.4,47,22,5.9,"PAH",490,1,1,0)="Add asterisks to identify Insurance Buffer entries back into Screen 5"
^DIC(9.4,47,22,5.9,"PAH",490,1,2,0)="of the Patient Load/Edit Screens.  This makes use of a new field added"
^DIC(9.4,47,22,5.9,"PAH",490,1,3,0)="to the return from Insurance Encapsulation API."
^DIC(9.4,47,22,5.9,"PAH",490,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",490,1,5,0)="The IN1 and IN2 HL7 segment builders are modified to use the Insurance "
^DIC(9.4,47,22,5.9,"PAH",490,1,6,0)="Encapsulation API."
^DIC(9.4,47,22,5.9,"PAH",491,0)="645 SEQ #574^3050625^1"
^DIC(9.4,47,22,5.9,"PAH",491,1,0)="^^2^2^3050625"
^DIC(9.4,47,22,5.9,"PAH",491,1,1,0)="The patch will modify the PTF transmission message to "
^DIC(9.4,47,22,5.9,"PAH",491,1,2,0)="  include up to 13 diagnoses from the PTF."
^DIC(9.4,47,22,5.9,"PAH",492,0)="670 SEQ #575^3050709^1"
^DIC(9.4,47,22,5.9,"PAH",492,1,0)="^^6^6^3050709"
^DIC(9.4,47,22,5.9,"PAH",492,1,1,0)="Add asterisks to identify Insurance Buffer entries back into Screen 5"
^DIC(9.4,47,22,5.9,"PAH",492,1,2,0)="of the Patient Load/Edit Screens.  This makes use of a new field added"
^DIC(9.4,47,22,5.9,"PAH",492,1,3,0)="to the return from Insurance Encapsulation API."
^DIC(9.4,47,22,5.9,"PAH",492,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",492,1,5,0)="The IN1 and IN2 HL7 segment builders are modified to use the Insurance"
^DIC(9.4,47,22,5.9,"PAH",492,1,6,0)="Encapsulation API."
^DIC(9.4,47,22,5.9,"PAH",493,0)="641 SEQ #576^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",493,1,0)="^^4^4^3050813"
^DIC(9.4,47,22,5.9,"PAH",493,1,1,0)="This patch addresses the patient name lookup, cleans up variables left"
^DIC(9.4,47,22,5.9,"PAH",493,1,2,0)="in the symbol table, allows the creation of VIC cards for patients without"
^DIC(9.4,47,22,5.9,"PAH",493,1,3,0)="a first name, backs out the changes to the CUM ADC totals on the BSR, and"
^DIC(9.4,47,22,5.9,"PAH",493,1,4,0)="creates cross-reference entries for test patients.  "
^DIC(9.4,47,22,5.9,"PAH",494,0)="630 SEQ #577^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",495,0)="636 SEQ #578^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",495,1,0)="^^2^2^3050813"
^DIC(9.4,47,22,5.9,"PAH",495,1,1,0)="This patch corrects a problem when coding the 501 or MAS screen in"
^DIC(9.4,47,22,5.9,"PAH",495,1,2,0)="  the Load/Edit PTF Data [DG PTF SCREEN] option."
^DIC(9.4,47,22,5.9,"PAH",496,0)="665 SEQ #579^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",497,0)="666 SEQ #580^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",498,0)="662 SEQ #581^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",498,1,0)="^^2^2^3050813"
^DIC(9.4,47,22,5.9,"PAH",498,1,1,0)="This patch fixes a problem with transmitting HL7 messages for outpatients,"
^DIC(9.4,47,22,5.9,"PAH",498,1,2,0)="and corrects a system error when transmitting PTF census records to AAC."
^DIC(9.4,47,22,5.9,"PAH",499,0)="624^3050813^1"
^DIC(9.4,47,22,5.9,"PAH",499,1,0)="^^1^1^3050813"
^DIC(9.4,47,22,5.9,"PAH",499,1,1,0)="1010 EZ PHASE 3.0"
^DIC(9.4,47,22,5.9,"PAH",500,0)="647 SEQ #583^3050905^1"
^DIC(9.4,47,22,5.9,"PAH",500,1,0)="^^4^4^3050905"
^DIC(9.4,47,22,5.9,"PAH",500,1,1,0)="This patch corrects a problem when timing out while registering collateral"
^DIC(9.4,47,22,5.9,"PAH",500,1,2,0)="patients, when adding a patient using Fileman and updating the name"
^DIC(9.4,47,22,5.9,"PAH",500,1,3,0)="components, and when processing address data returned from the query"
^DIC(9.4,47,22,5.9,"PAH",500,1,4,0)="to the last site treated. "
^DIC(9.4,47,22,5.9,"PAH",501,0)="649 SEQ #584^3050924^1"
