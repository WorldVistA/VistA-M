^DIC(9.4,175,22,1,"PAH",2,1,0)="^^47^47^3010906"
^DIC(9.4,175,22,1,"PAH",2,1,1,0)="This patch identifies possible integrity problems in the Imaging and"
^DIC(9.4,175,22,1,"PAH",2,1,2,0)="associated parent report files."
^DIC(9.4,175,22,1,"PAH",2,1,3,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,4,0)="Routines included:"
^DIC(9.4,175,22,1,"PAH",2,1,5,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,6,0)="MAGGSQI   value = 20833776"
^DIC(9.4,175,22,1,"PAH",2,1,7,0)="MAGICRPT  value = 16785993"
^DIC(9.4,175,22,1,"PAH",2,1,8,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,9,0)="Menu options exported:"
^DIC(9.4,175,22,1,"PAH",2,1,10,0)="NAME: MAG DB IQ"
^DIC(9.4,175,22,1,"PAH",2,1,11,0)="  MENU TEXT: Imaging Database Integrity Checker Menu"
^DIC(9.4,175,22,1,"PAH",2,1,12,0)="  TYPE: menu                            CREATOR: BARRIOS,LUCILLE"
^DIC(9.4,175,22,1,"PAH",2,1,13,0)="  PACKAGE: IMAGING"
^DIC(9.4,175,22,1,"PAH",2,1,14,0)=" DESCRIPTION:   Menu optons to start the scanning of the Imaging database."
^DIC(9.4,175,22,1,"PAH",2,1,15,0)="ITEM: MAG_IC_RPT_GM                     SYNONYM: GM"
^DIC(9.4,175,22,1,"PAH",2,1,16,0)="ITEM: MAG_IC_RPT_QA                     SYNONYM: QA"
^DIC(9.4,175,22,1,"PAH",2,1,17,0)="ITEM: MAG_IC_SCAN                       SYNONYM: SC"
^DIC(9.4,175,22,1,"PAH",2,1,18,0)="  TIMESTAMP: 58681,42457"
^DIC(9.4,175,22,1,"PAH",2,1,19,0)="  UPPERCASE MENU TEXT: IMAGING DATABASE INTEGRITY CHE"
^DIC(9.4,175,22,1,"PAH",2,1,20,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,21,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,22,0)="NAME: MAG_IC_RPT_GM"
^DIC(9.4,175,22,1,"PAH",2,1,23,0)="  MENU TEXT: Integrity Report on Global Moves"
^DIC(9.4,175,22,1,"PAH",2,1,24,0)="  TYPE: run routine                     CREATOR: BARRIOS,LUCILLE"
^DIC(9.4,175,22,1,"PAH",2,1,25,0)="  PACKAGE: IMAGING"
^DIC(9.4,175,22,1,"PAH",2,1,26,0)=" DESCRIPTION:   Report from Imaging Integrity Check, limited to items"
^DIC(9.4,175,22,1,"PAH",2,1,27,0)="requrired"
^DIC(9.4,175,22,1,"PAH",2,1,28,0)=" for Central Office."
^DIC(9.4,175,22,1,"PAH",2,1,29,0)="  ROUTINE: RPT^MAGICRPT(""CO"")"
^DIC(9.4,175,22,1,"PAH",2,1,30,0)="  UPPERCASE MENU TEXT: INTEGRITY REPORT ON GLOBAL MOVE"
^DIC(9.4,175,22,1,"PAH",2,1,31,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,32,0)="NAME: MAG_IC_RPT_QA"
^DIC(9.4,175,22,1,"PAH",2,1,33,0)="  MENU TEXT: Comprehensive Image Integrity Report"
^DIC(9.4,175,22,1,"PAH",2,1,34,0)="  TYPE: run routine                     CREATOR: BARRIOS,LUCILLE"
^DIC(9.4,175,22,1,"PAH",2,1,35,0)="  PACKAGE: IMAGING"
^DIC(9.4,175,22,1,"PAH",2,1,36,0)=" DESCRIPTION:   Report from Imaging Integrity Check, including all items"
^DIC(9.4,175,22,1,"PAH",2,1,37,0)=" required for Quality Assurance."
^DIC(9.4,175,22,1,"PAH",2,1,38,0)="  ROUTINE: RPT^MAGICRPT(""QA"")"
^DIC(9.4,175,22,1,"PAH",2,1,39,0)="  UPPERCASE MENU TEXT: COMPREHENSIVE IMAGE INTEGRITY"
^DIC(9.4,175,22,1,"PAH",2,1,40,0)=" "
^DIC(9.4,175,22,1,"PAH",2,1,41,0)="NAME: MAG_IC_SCAN"
^DIC(9.4,175,22,1,"PAH",2,1,42,0)="  MENU TEXT: Scan Database for Integrity Issues"
^DIC(9.4,175,22,1,"PAH",2,1,43,0)="  TYPE: run routine                     CREATOR: BARRIOS,LUCILLE"
^DIC(9.4,175,22,1,"PAH",2,1,44,0)="  PACKAGE: IMAGING                      X ACTION PRESENT: YES"
^DIC(9.4,175,22,1,"PAH",2,1,45,0)=" DESCRIPTION:   Menu option to scan the Imaging database."
^DIC(9.4,175,22,1,"PAH",2,1,46,0)="  EXIT ACTION: K MAGN100,MAGZ,VALID     ROUTINE: RPT^MAGGSQI()"
^DIC(9.4,175,22,1,"PAH",2,1,47,0)="  UPPERCASE MENU TEXT: SCAN DATABASE FOR INTEGRITY IS"
^DIC(9.4,175,22,1,"PAH",3,0)="4^3010906^1"
^DIC(9.4,175,22,1,"PAH",3,1,0)="^^23^23^3010906"
^DIC(9.4,175,22,1,"PAH",3,1,1,0)="Build for MAG*2.5*4 patch.  "
^DIC(9.4,175,22,1,"PAH",3,1,2,0)=" "
^DIC(9.4,175,22,1,"PAH",3,1,3,0)="Clinical workstation software has been modified to block the display of"
^DIC(9.4,175,22,1,"PAH",3,1,4,0)="images which areOn of Quiestionable Integrity (QI) due to possible"
^DIC(9.4,175,22,1,"PAH",3,1,5,0)="miss-associated images on the database."
^DIC(9.4,175,22,1,"PAH",3,1,6,0)=" "
^DIC(9.4,175,22,1,"PAH",3,1,7,0)="A further prevent mechanism has been added to the workstation capture"
^DIC(9.4,175,22,1,"PAH",3,1,8,0)="software to disable accidental attachment of an image for one patient to"
^DIC(9.4,175,22,1,"PAH",3,1,9,0)="an existing TIU note of another patient. The software will require the"
^DIC(9.4,175,22,1,"PAH",3,1,10,0)="selection of an existing TIU note for the patient whose images are being"
^DIC(9.4,175,22,1,"PAH",3,1,11,0)="captured. If a selection was made on a non-existing note then the ""OK"""
^DIC(9.4,175,22,1,"PAH",3,1,12,0)="button on the display will be disabled, leaving only the Cancel or Help"
^DIC(9.4,175,22,1,"PAH",3,1,13,0)="button for possible selection. "
^DIC(9.4,175,22,1,"PAH",3,1,14,0)=" "
^DIC(9.4,175,22,1,"PAH",3,1,15,0)="Contains the following routines:"
^DIC(9.4,175,22,1,"PAH",3,1,16,0)=" "
^DIC(9.4,175,22,1,"PAH",3,1,17,0)="MAGGNTI   value = 9207655"
^DIC(9.4,175,22,1,"PAH",3,1,18,0)="MAGGTIA   value = 10457801"
^DIC(9.4,175,22,1,"PAH",3,1,19,0)="MAGGTIA2  value = 4308773"
^DIC(9.4,175,22,1,"PAH",3,1,20,0)="MAGGTIG   value = 11774320"
^DIC(9.4,175,22,1,"PAH",3,1,21,0)="MAGGTII   value = 5456481"
^DIC(9.4,175,22,1,"PAH",3,1,22,0)="MAGGTRAI  value = 8632417"
^DIC(9.4,175,22,1,"PAH",3,1,23,0)="MAGGTRPT  value = 11812366"
^DIC(9.4,175,22,1,"PAH",4,0)="5^3011210^1"
^DIC(9.4,175,22,1,"PAH",4,1,0)="^^29^29^3011210"
^DIC(9.4,175,22,1,"PAH",4,1,1,0)="Imaging patch for Patient Safety; this patch will block the display of"
^DIC(9.4,175,22,1,"PAH",4,1,2,0)="associated Radiology reports if the image entry has a questionable"
^DIC(9.4,175,22,1,"PAH",4,1,3,0)="integrity issue.  The Verifier software has been modified to perform a"
^DIC(9.4,175,22,1,"PAH",4,1,4,0)="database integrity check on all Image file entries as well as verify image"
^DIC(9.4,175,22,1,"PAH",4,1,5,0)="file migration. It also allow integrity checking of the TEXT files and the"
^DIC(9.4,175,22,1,"PAH",4,1,6,0)="sorting mechanism has been modified to allow more flexibility."
^DIC(9.4,175,22,1,"PAH",4,1,7,0)=" "
^DIC(9.4,175,22,1,"PAH",4,1,8,0)="Routine MAGICRPT is being deleted and a new routine MAGCRPT has been"
^DIC(9.4,175,22,1,"PAH",4,1,9,0)="created to do database scanning; this routine has been corrected to handle"
^DIC(9.4,175,22,1,"PAH",4,1,10,0)="a null value for the DFN variable."
^DIC(9.4,175,22,1,"PAH",4,1,11,0)=" "
^DIC(9.4,175,22,1,"PAH",4,1,12,0)="Routine MAGIPOS5 is a post routine and will be deleted at the end of the"
^DIC(9.4,175,22,1,"PAH",4,1,13,0)="KIDS install. "
^DIC(9.4,175,22,1,"PAH",4,1,14,0)=" "
^DIC(9.4,175,22,1,"PAH",4,1,15,0)="MAGBAPI   value = 6095017"
