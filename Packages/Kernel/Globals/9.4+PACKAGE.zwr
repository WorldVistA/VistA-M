^DIC(9.4,47,22,5.9,"PAH",308,0)="437 SEQ #387^3020423^1"
^DIC(9.4,47,22,5.9,"PAH",308,1,0)="^^1^1^3020423"
^DIC(9.4,47,22,5.9,"PAH",308,1,1,0)="Change priority rule for priority group 3."
^DIC(9.4,47,22,5.9,"PAH",309,0)="411^3020423^1"
^DIC(9.4,47,22,5.9,"PAH",309,1,0)="^^7^7^3020423"
^DIC(9.4,47,22,5.9,"PAH",309,1,1,0)="This patch is in response to Item #22 in the Rossio Report.  In the area"
^DIC(9.4,47,22,5.9,"PAH",309,1,2,0)="of Means Test (MT) Deficiencies, Item #22 required that the Veterans"
^DIC(9.4,47,22,5.9,"PAH",309,1,3,0)="Health Administration (VHA) identify best practices for means testing and"
^DIC(9.4,47,22,5.9,"PAH",309,1,4,0)="acquiring veterans' signatures at the local level and explore the"
^DIC(9.4,47,22,5.9,"PAH",309,1,5,0)="promulgation of these best practices throughout the system.  This patch"
^DIC(9.4,47,22,5.9,"PAH",309,1,6,0)="adds a site controllable parameter to post a means test completion"
^DIC(9.4,47,22,5.9,"PAH",309,1,7,0)="bulletin to a local mail group."
^DIC(9.4,47,22,5.9,"PAH",310,0)="332 SEQ #389^3020506^1"
^DIC(9.4,47,22,5.9,"PAH",310,1,0)="^^2^2^3020506"
^DIC(9.4,47,22,5.9,"PAH",310,1,1,0)="Please see Patch DG*5.3*332 in the National Patch Module for description of "
^DIC(9.4,47,22,5.9,"PAH",310,1,2,0)="this Build."
^DIC(9.4,47,22,5.9,"PAH",311,0)="412 SEQ #390^3020516^1"
^DIC(9.4,47,22,5.9,"PAH",311,1,0)="^^2^2^3020516"
^DIC(9.4,47,22,5.9,"PAH",311,1,1,0)="Distribution of mail group for the Austin web-based Missing Patient"
