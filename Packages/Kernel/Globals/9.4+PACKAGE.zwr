^DIC(9.4,100,22,15,"PAH",56,1,322,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,323,0)="         Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",56,1,324,0)="         =========================="
^DIC(9.4,100,22,15,"PAH",56,1,325,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,326,0)="  NOTE: This KIDS install does not place any options out of service"
^DIC(9.4,100,22,15,"PAH",56,1,327,0)="        during the install and no existing user options are affected."
^DIC(9.4,100,22,15,"PAH",56,1,328,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,329,0)="        The site should answer ""NO"" to all three questions."
^DIC(9.4,100,22,15,"PAH",56,1,330,0)="            Note: You may not receive all three prompts at your site."
^DIC(9.4,100,22,15,"PAH",56,1,331,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,332,0)="        ""Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,100,22,15,"PAH",56,1,333,0)="         Install? YES// NO"""
^DIC(9.4,100,22,15,"PAH",56,1,334,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,335,0)="        ""Want KIDS to INHIBIT LOGONs during the install? YES// NO"""
^DIC(9.4,100,22,15,"PAH",56,1,336,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,337,0)="        ""Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,100,22,15,"PAH",56,1,338,0)="         Protocols?"
^DIC(9.4,100,22,15,"PAH",56,1,339,0)="         YES// NO"""
^DIC(9.4,100,22,15,"PAH",56,1,340,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,341,0)="         1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",56,1,342,0)="            This option will load the KIDS package in this message onto"
^DIC(9.4,100,22,15,"PAH",56,1,343,0)="            your system."
^DIC(9.4,100,22,15,"PAH",56,1,344,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,345,0)="         2. The patch has now been loaded into a Transport global on"
^DIC(9.4,100,22,15,"PAH",56,1,346,0)="            your system. You now need to use KIDS to install the"
^DIC(9.4,100,22,15,"PAH",56,1,347,0)="            Transport global."
^DIC(9.4,100,22,15,"PAH",56,1,348,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,349,0)="            On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,100,22,15,"PAH",56,1,350,0)="            following options:"
^DIC(9.4,100,22,15,"PAH",56,1,351,0)="                Print Transport Global"
^DIC(9.4,100,22,15,"PAH",56,1,352,0)="                Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",56,1,353,0)="                Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",56,1,354,0)="                Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",56,1,355,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,356,0)="         3. Users may remain on the system, installation may be done at"
^DIC(9.4,100,22,15,"PAH",56,1,357,0)="            any time except during the time scheduled for the Clozapine"
^DIC(9.4,100,22,15,"PAH",56,1,358,0)="            roll-up."
^DIC(9.4,100,22,15,"PAH",56,1,359,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,360,0)="         4. No options need to be placed out of service."
^DIC(9.4,100,22,15,"PAH",56,1,361,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,362,0)="         5. Installation time is less than 2 minutes during off peak"
^DIC(9.4,100,22,15,"PAH",56,1,363,0)="            hours and less than 5 minutes during peak hours."
^DIC(9.4,100,22,15,"PAH",56,1,364,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,365,0)="         6. Installation of this patch requires no additional memory"
^DIC(9.4,100,22,15,"PAH",56,1,366,0)="            space."
^DIC(9.4,100,22,15,"PAH",56,1,367,0)=" "
^DIC(9.4,100,22,15,"PAH",56,1,368,0)="         7. From the 'Installation Menu' of the KIDS menu, run the"
^DIC(9.4,100,22,15,"PAH",56,1,369,0)="            option:"
^DIC(9.4,100,22,15,"PAH",56,1,370,0)="            'Install Package(s)' Select the package 'YS*5.01*90 and"
^DIC(9.4,100,22,15,"PAH",56,1,371,0)="            proceed with the install."
^DIC(9.4,100,22,15,"PAH",57,0)="82 SEQ #76^3070904.233744^1"
^DIC(9.4,100,22,15,"PAH",57,1,0)="^^6^6^3070904"
^DIC(9.4,100,22,15,"PAH",57,1,1,0)="This patch fixes the problem with undefined errors occurring when"
^DIC(9.4,100,22,15,"PAH",57,1,2,0)="displaying incomplete Seclusion/Restraint (S/R) record"
^DIC(9.4,100,22,15,"PAH",57,1,3,0)="Information via YSSR ENTRY and YSSR RELEASE options and removes "
^DIC(9.4,100,22,15,"PAH",57,1,4,0)="leftover nodes from a previous restructuring of file 604."
^DIC(9.4,100,22,15,"PAH",57,1,5,0)="It also corrects a problem whereby GAF scores are not always"
^DIC(9.4,100,22,15,"PAH",57,1,6,0)="seen in the Encounter dialogue of CPRS."
^DIC(9.4,100,22,15,"PAH",58,0)="85^3080203.221717^1"
^DIC(9.4,100,22,15,"PAH",58,1,0)="^^486^486^3080203"
^DIC(9.4,100,22,15,"PAH",58,1,1,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,2,0)="The Veterans Health Administration (VHA) Action Agenda for implementing the "
^DIC(9.4,100,22,15,"PAH",58,1,3,0)="President's New Freedom Commission on Mental Health recommendations regarding "
^DIC(9.4,100,22,15,"PAH",58,1,4,0)="the use of information technology to enhance the care of Mental Health patients"
^DIC(9.4,100,22,15,"PAH",58,1,5,0)="states, ""VHA should make the integration of MHA and HealtheVet Desktop (HeVD) "
^DIC(9.4,100,22,15,"PAH",58,1,6,0)="an explicit goal and should provide the OI with sufficient resources to "
^DIC(9.4,100,22,15,"PAH",58,1,7,0)="accomplish this goal in collaboration with the Mental Health Strategic "
^DIC(9.4,100,22,15,"PAH",58,1,8,0)="Healthcare Group (MHSHG) Informatics Section.  The integration should "
^DIC(9.4,100,22,15,"PAH",58,1,9,0)="eliminate the need for Mental Health clinicians to change applications.  "
^DIC(9.4,100,22,15,"PAH",58,1,10,0)="Further, the integration should make appropriate Mental Health assessment "
^DIC(9.4,100,22,15,"PAH",58,1,11,0)="tools available to clinicians outside Mental Health (e.g., depression and "
^DIC(9.4,100,22,15,"PAH",58,1,12,0)="alcohol screening instruments should be made available to primary care "
^DIC(9.4,100,22,15,"PAH",58,1,13,0)="clinicians)."""
^DIC(9.4,100,22,15,"PAH",58,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,15,0)="This revision of MHA creates a closer integration with CPRS, by placing the MHA"
^DIC(9.4,100,22,15,"PAH",58,1,16,0)="GUI on the CPRS Tools Menu.  Additionally, functionality was created to allow "
^DIC(9.4,100,22,15,"PAH",58,1,17,0)="a site to place an individual instrument on the Tools menu, allowing widespread"
^DIC(9.4,100,22,15,"PAH",58,1,18,0)="access to that specific instrument without having to issue the menu for the MHP"
^DIC(9.4,100,22,15,"PAH",58,1,19,0)="to all clinicians."
^DIC(9.4,100,22,15,"PAH",58,1,20,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,21,0)="Additional functionality that strengthens the tie to the patient's medical "
^DIC(9.4,100,22,15,"PAH",58,1,22,0)="record is the creation of a progress note in CPRS when an instrument is "
^DIC(9.4,100,22,15,"PAH",58,1,23,0)="completed through MHA."
^DIC(9.4,100,22,15,"PAH",58,1,24,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,25,0)="Furthermore, MHA maintains and strengthens its ties to the Clinical Reminders "
^DIC(9.4,100,22,15,"PAH",58,1,26,0)="program, which allows for the presentation of specific instruments through "
^DIC(9.4,100,22,15,"PAH",58,1,27,0)="reminder dialogs to all clinicians who resolve reminders."
^DIC(9.4,100,22,15,"PAH",58,1,28,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,29,0)="Clinical reminders has also developed a new patch, PXRM*2.0*6 that allows "
^DIC(9.4,100,22,15,"PAH",58,1,30,0)="reminders to work with the new MHA file structure.   YS*5.01*85 should be "
^DIC(9.4,100,22,15,"PAH",58,1,31,0)="installed just before PXRM*2*6.  If YS*5.01*85 is installed without "
^DIC(9.4,100,22,15,"PAH",58,1,32,0)="PXRM*2*6, reminders will not be able to recognize MHA instruments "
^DIC(9.4,100,22,15,"PAH",58,1,33,0)="administered after the file structure changes with YS*5.01*85."
^DIC(9.4,100,22,15,"PAH",58,1,34,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,35,0)="Additionally, the files of the MHP have been restructured to initiate the "
^DIC(9.4,100,22,15,"PAH",58,1,36,0)="migration toward re-engineering and placing MHA as a component of HealtheVet "
^DIC(9.4,100,22,15,"PAH",58,1,37,0)="Desktop when it is implemented."
^DIC(9.4,100,22,15,"PAH",58,1,38,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,39,0)="To better meet the needs of clinicians and patients in different programs, "
^DIC(9.4,100,22,15,"PAH",58,1,40,0)="particularly non-traditional settings, MHA can now run in a standalone mode to"
^DIC(9.4,100,22,15,"PAH",58,1,41,0)="administer instruments offline for later uploading to VistA."
^DIC(9.4,100,22,15,"PAH",58,1,42,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,43,0)="VistA Mental Health Assistant NEW features in MHA3:"
^DIC(9.4,100,22,15,"PAH",58,1,44,0)="---------------------------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,45,0)="1.  M: Completely re-organized VistA Mental Health database files to "
^DIC(9.4,100,22,15,"PAH",58,1,46,0)="    simplify migration to HDR. "
^DIC(9.4,100,22,15,"PAH",58,1,47,0)="     "
^DIC(9.4,100,22,15,"PAH",58,1,48,0)="2.  GUI: MHA3 must be invoked from the CPRS Tools menu, for interaction with "
^DIC(9.4,100,22,15,"PAH",58,1,49,0)="    VistA and patient selection. Patient-selection is done entirely by"
^DIC(9.4,100,22,15,"PAH",58,1,50,0)="    interaction with CPRS. "
^DIC(9.4,100,22,15,"PAH",58,1,51,0)="     "
^DIC(9.4,100,22,15,"PAH",58,1,52,0)="3.  GUI: MHA3 can run in standalone mode, but only for administering offline "
^DIC(9.4,100,22,15,"PAH",58,1,53,0)="    tests-which later must be uploaded to VistA."
^DIC(9.4,100,22,15,"PAH",58,1,54,0)="  "
^DIC(9.4,100,22,15,"PAH",58,1,55,0)="4.  GUI: MHA3 allows the CPRS Tools menu to invoke any number of single types "
^DIC(9.4,100,22,15,"PAH",58,1,56,0)="    of instruments, without the need to go directly to the MHA3 Main form. For "
^DIC(9.4,100,22,15,"PAH",58,1,57,0)="    instance, a CAGE menu item can be added to the Tools menu, which would "
^DIC(9.4,100,22,15,"PAH",58,1,58,0)="    invoke only a CAGE data entry form. "
^DIC(9.4,100,22,15,"PAH",58,1,59,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,60,0)="5.  GUI: Major functionality (GAF, ASI, Results, etc.) is now presented on "
^DIC(9.4,100,22,15,"PAH",58,1,61,0)="    individual forms, as opposed to as tabs on one main form. "
^DIC(9.4,100,22,15,"PAH",58,1,62,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,63,0)="6.  GUI: MHA3 now provides a new Battery Wizard form to simplify creating "
^DIC(9.4,100,22,15,"PAH",58,1,64,0)="    batteries of instruments."
^DIC(9.4,100,22,15,"PAH",58,1,65,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,66,0)="7.  There is a new & improved SecureDesktop component that now uses stronger "
^DIC(9.4,100,22,15,"PAH",58,1,67,0)="    code to prevent hacking. "
^DIC(9.4,100,22,15,"PAH",58,1,68,0)="     "
^DIC(9.4,100,22,15,"PAH",58,1,69,0)="8.  ""Clerk entry"" data-entry-mode form for psych tests has been removed. "
^DIC(9.4,100,22,15,"PAH",58,1,70,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,71,0)="9.  All completed administrations now automatically generate a progress note "
^DIC(9.4,100,22,15,"PAH",58,1,72,0)="    for review in CPRS."
^DIC(9.4,100,22,15,"PAH",58,1,73,0)="     "
^DIC(9.4,100,22,15,"PAH",58,1,74,0)="10. All test scores are now saved in VistA, instead of calculated on-the-fly. "
^DIC(9.4,100,22,15,"PAH",58,1,75,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,76,0)="11. There is now a hospital Location associated with an administered "
^DIC(9.4,100,22,15,"PAH",58,1,77,0)="    instrument, for progress notes purposes. "
^DIC(9.4,100,22,15,"PAH",58,1,78,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,79,0)="12. The accompanying MHA3 help file is supplied only for describing the "
^DIC(9.4,100,22,15,"PAH",58,1,80,0)="    functions of the ASI Manager forms. All other tests and interview have "
^DIC(9.4,100,22,15,"PAH",58,1,81,0)="    built-in help that is retrieved directly from the MHP when using the "
^DIC(9.4,100,22,15,"PAH",58,1,82,0)="    ""Description"" pop-up menu function in the Instrument Manager. "
^DIC(9.4,100,22,15,"PAH",58,1,83,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,84,0)="13. MHA3 now recreates a debug log file named ""mha3_debug.log"" for each MHA3 "
^DIC(9.4,100,22,15,"PAH",58,1,85,0)="    session. This file can be emailed to developers to assist in remote "
^DIC(9.4,100,22,15,"PAH",58,1,86,0)="    debugging. No patient-identifying data is collected in this file. "
^DIC(9.4,100,22,15,"PAH",58,1,87,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,88,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,89,0)="This patch contains 23 new Mental Health files, 58 new Mental Health"
^DIC(9.4,100,22,15,"PAH",58,1,90,0)="Remote Procedures, 57 new Mental Health routines, 1 option, 2 Protocols, "
^DIC(9.4,100,22,15,"PAH",58,1,91,0)="1 HL7 application parameter and 1 HL logical link."
^DIC(9.4,100,22,15,"PAH",58,1,92,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,93,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,94,0)="  23 New Mental Health files to be released in this patch:"
^DIC(9.4,100,22,15,"PAH",58,1,95,0)="  --------------------------------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,96,0)="  MH TESTS AND SURVEYS file (#601.71)"
^DIC(9.4,100,22,15,"PAH",58,1,97,0)="  -----------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,98,0)="  This file defines the interviews, surveys and tests available in the Mental"
^DIC(9.4,100,22,15,"PAH",58,1,99,0)="  Health Assistant. Attributes of the instruments include authoring credits,"
^DIC(9.4,100,22,15,"PAH",58,1,100,0)="  target populations, normative samples and copyright information. Actions"
^DIC(9.4,100,22,15,"PAH",58,1,101,0)="  available including privileging, reporting of full item content and"
^DIC(9.4,100,22,15,"PAH",58,1,102,0)="  transmission to the Mental Health National Database are also specified. "
^DIC(9.4,100,22,15,"PAH",58,1,103,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,104,0)="  Entries may be made through the provided Mental Health Authoring software. "
^DIC(9.4,100,22,15,"PAH",58,1,105,0)="  Direct entry through Fileman or the programmer prompt is prohibited."
^DIC(9.4,100,22,15,"PAH",58,1,106,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,107,0)="  MH QUESTIONS file (#601.72)"
^DIC(9.4,100,22,15,"PAH",58,1,108,0)="  ---------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,109,0)="  This file contains a listing of all questions for all Psychological "
^DIC(9.4,100,22,15,"PAH",58,1,110,0)="  Interviews, Surveys and Tests.  This allows usage of questions by multiple "
^DIC(9.4,100,22,15,"PAH",58,1,111,0)="  instruments. Each question can also linked to an entry in the MH "
^DIC(9.4,100,22,15,"PAH",58,1,112,0)="  INTRODUCTIONS file (#601.73), the MH CHOICES file (#601.75), the MH "
^DIC(9.4,100,22,15,"PAH",58,1,113,0)="  CHOICETYPES file (#601.751) and the Hint field (#8) in the MH QUESTIONS "
^DIC(9.4,100,22,15,"PAH",58,1,114,0)="  file (#601.72). "
^DIC(9.4,100,22,15,"PAH",58,1,115,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,116,0)="  MH INTRODUCTIONS file (#601.73)"
^DIC(9.4,100,22,15,"PAH",58,1,117,0)="  -------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,118,0)="  This file contains the introductory information given at the beginning of "
^DIC(9.4,100,22,15,"PAH",58,1,119,0)="  each instrument or at the beginning of a new section of an instrument. The "
^DIC(9.4,100,22,15,"PAH",58,1,120,0)="  introduction text motivates, gives instructions and sets the frame for the "
^DIC(9.4,100,22,15,"PAH",58,1,121,0)="  task the patient must complete. The same introduction text can be used by "
^DIC(9.4,100,22,15,"PAH",58,1,122,0)="  multiple instruments."
^DIC(9.4,100,22,15,"PAH",58,1,123,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,124,0)="  MH RESPONSE TYPES file (#601.74)"
^DIC(9.4,100,22,15,"PAH",58,1,125,0)="  --------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,126,0)="  This file contains what type of response from the user is required for a "
^DIC(9.4,100,22,15,"PAH",58,1,127,0)="  question.  Response types contained in the file include MCHOICE (multiple "
^DIC(9.4,100,22,15,"PAH",58,1,128,0)="  choice), Integers, Strings, Dates, Memos and Currency.  These entries are "
^DIC(9.4,100,22,15,"PAH",58,1,129,0)="  pointed to the MH QUESTIONS file (#601.72)."
^DIC(9.4,100,22,15,"PAH",58,1,130,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,131,0)="  MH CHOICES file (#601.75)"
^DIC(9.4,100,22,15,"PAH",58,1,132,0)="  -------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,133,0)="  This file contains the individual selections possible in a multiple choice "
^DIC(9.4,100,22,15,"PAH",58,1,134,0)="  question.  Examples are Yes or No, True or False, 1.  Abraham Lincoln, 2."
^DIC(9.4,100,22,15,"PAH",58,1,135,0)="  George Washington, 3. George W. Bush or 4. Richard Nixon. For instruments "
^DIC(9.4,100,22,15,"PAH",58,1,136,0)="  first defined in the legacy system MH INSTRUMENT file (#601), a single "
^DIC(9.4,100,22,15,"PAH",58,1,137,0)="  character is specified for a multiple choice answer.  If George Washington "
^DIC(9.4,100,22,15,"PAH",58,1,138,0)="  was the choice selected the legacy value would be 2.  "
^DIC(9.4,100,22,15,"PAH",58,1,139,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,140,0)="  Choices are pointed to by the MH CHOICETYPES file (#601.751) which is a "
^DIC(9.4,100,22,15,"PAH",58,1,141,0)="  collection of choices.  Choices are referenced in the MH ANSWERS file "
^DIC(9.4,100,22,15,"PAH",58,1,142,0)="  (#601.85) as a pointer to the full response."
^DIC(9.4,100,22,15,"PAH",58,1,143,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,144,0)="  MH CHOICETYPES file (#601.751)"
^DIC(9.4,100,22,15,"PAH",58,1,145,0)="  ------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,146,0)="  This file contains a collection of choices from MH CHOICES file (#601.75) "
^DIC(9.4,100,22,15,"PAH",58,1,147,0)="  and their display sequence.  This allows sets of choices to be specified by "
^DIC(9.4,100,22,15,"PAH",58,1,148,0)="  the MH QUESTIONS file (#601.72).  An example of an entry would be: 1. True "
^DIC(9.4,100,22,15,"PAH",58,1,149,0)="  2. False 3. Undecided  Each multiple choice question must specify a "
^DIC(9.4,100,22,15,"PAH",58,1,150,0)="  ChoiceType. In this way a ChoiceType can be used by multiple instruments "
^DIC(9.4,100,22,15,"PAH",58,1,151,0)="  and multiple questions."
^DIC(9.4,100,22,15,"PAH",58,1,152,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,153,0)="  MH INSTRUMENT CONTENT file (#601.76)"
^DIC(9.4,100,22,15,"PAH",58,1,154,0)="  ------------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,155,0)="  This file specifies which entries from the MH QUESTIONS file (#601.72) are "
^DIC(9.4,100,22,15,"PAH",58,1,156,0)="  parts of which instrument in the MH TESTS AND SURVEYS file (#601.71).  It is "
^DIC(9.4,100,22,15,"PAH",58,1,157,0)="  the ""table of contents"" for an interview, survey or test. Also specified are "
^DIC(9.4,100,22,15,"PAH",58,1,158,0)="  the sequence of questions and display attributes for the introductions, "
^DIC(9.4,100,22,15,"PAH",58,1,159,0)="  questions and choices.  Display attributes can be bold, underlined and font"
^DIC(9.4,100,22,15,"PAH",58,1,160,0)="  size for the introductions, questions and choices."
^DIC(9.4,100,22,15,"PAH",58,1,161,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,162,0)="  MH BATTERIES file (#601.77)"
^DIC(9.4,100,22,15,"PAH",58,1,163,0)="  ---------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,164,0)="  This file contains a list of interview, survey and test order sets."
^DIC(9.4,100,22,15,"PAH",58,1,165,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,166,0)="  MH BATTERY CONTENTS file (#601.78)"
^DIC(9.4,100,22,15,"PAH",58,1,167,0)="  ----------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,168,0)="  Ties the entries in the MH BATTERY CONTENTS file (#601.78) to the "
^DIC(9.4,100,22,15,"PAH",58,1,169,0)="  instruments in the MH TESTS AND SURVEYS file (#601.71). "
^DIC(9.4,100,22,15,"PAH",58,1,170,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,171,0)="  MH BATTERY USERS file (#601.781)"
^DIC(9.4,100,22,15,"PAH",58,1,172,0)="  --------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,173,0)="  This file contains a list of all interviews, surveys and tests associated "
^DIC(9.4,100,22,15,"PAH",58,1,174,0)="  with an entry in the MH BATTERIES file (#601.77).  The order of presentation "
^DIC(9.4,100,22,15,"PAH",58,1,175,0)="  of the interviews, surveys and tests within a battery and which battery "
^DIC(9.4,100,22,15,"PAH",58,1,176,0)="  belongs to which user in the NEW PERSON file (#200) is also specified."
^DIC(9.4,100,22,15,"PAH",58,1,177,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,178,0)="  MH SKIPPED QUESTIONS file (#601.79)"
^DIC(9.4,100,22,15,"PAH",58,1,179,0)="  -----------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,180,0)="  This file specifies the questions to be skipped (by question IEN) if a rule "
^DIC(9.4,100,22,15,"PAH",58,1,181,0)="  is met for a given question in a given instrument."
^DIC(9.4,100,22,15,"PAH",58,1,182,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,183,0)="  MH SECTIONS file (#601.81)"
^DIC(9.4,100,22,15,"PAH",58,1,184,0)="  --------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,185,0)="  This file specifies sections within an interview, survey and test. The first "
^DIC(9.4,100,22,15,"PAH",58,1,186,0)="  MH QUESTIONS file (#601.72) is specified along with captions (tab and "
^DIC(9.4,100,22,15,"PAH",58,1,187,0)="  overall). Display characteristics can also be set."
^DIC(9.4,100,22,15,"PAH",58,1,188,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,189,0)="  MH RULES file (#601.82)"
^DIC(9.4,100,22,15,"PAH",58,1,190,0)="  -----------------------"
^DIC(9.4,100,22,15,"PAH",58,1,191,0)="  This file contains the rules used in administering an interview, survey or "
^DIC(9.4,100,22,15,"PAH",58,1,192,0)="  test. A rule is an action that is performed when a specified question is "
^DIC(9.4,100,22,15,"PAH",58,1,193,0)="  answered in a specified manner. An example of a rule would be to enter 'Not"
^DIC(9.4,100,22,15,"PAH",58,1,194,0)="  applicable' to the Question, ""Are you pregnant?"" if the patient has had a"
^DIC(9.4,100,22,15,"PAH",58,1,195,0)="  hysterectomy. Rules are complex logic based entries that enables the user to"
^DIC(9.4,100,22,15,"PAH",58,1,196,0)="  create complex scripts."
^DIC(9.4,100,22,15,"PAH",58,1,197,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,198,0)="  MH INSTRUMENTRULES file (#601.83)"
^DIC(9.4,100,22,15,"PAH",58,1,199,0)="  ---------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,200,0)="  This file ties together an instrument in the MH TESTS AND SURVEYS file "
^DIC(9.4,100,22,15,"PAH",58,1,201,0)="  (#601.71), a question in the MH QUESTIONS file (#601.72) and a rule in the "
^DIC(9.4,100,22,15,"PAH",58,1,202,0)="  MH RULES file (#601.82). This allows a rule to be used in multiple "
^DIC(9.4,100,22,15,"PAH",58,1,203,0)="  instruments and for different questions."
^DIC(9.4,100,22,15,"PAH",58,1,204,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,205,0)="  MH ADMINISTRATIONS file (#601.84)"
^DIC(9.4,100,22,15,"PAH",58,1,206,0)="  ---------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,207,0)="  The MH ADMINISTRATIONS file (#601.84) contains the data collected during "
^DIC(9.4,100,22,15,"PAH",58,1,208,0)="  the administration of a specified instrument from the MH TESTS AND SURVEYS "
^DIC(9.4,100,22,15,"PAH",58,1,209,0)="  file (#601.71) given to a patient at a specific date and time. For each "
^DIC(9.4,100,22,15,"PAH",58,1,210,0)="  administration of a specified instrument from the MH TESTS AND SURVEYS file "
^DIC(9.4,100,22,15,"PAH",58,1,211,0)="  (#601.71) there will be an entry in this file. "
^DIC(9.4,100,22,15,"PAH",58,1,212,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,213,0)="  An entry in this file does not store the results of the instrument's "
^DIC(9.4,100,22,15,"PAH",58,1,214,0)="  administration but is an index to the instrument's administration. The entry "
^DIC(9.4,100,22,15,"PAH",58,1,215,0)="  indicates whether the instrument has been completed, who ordered the "
^DIC(9.4,100,22,15,"PAH",58,1,216,0)="  instrument, how many questions were answered and if the test has been "
^DIC(9.4,100,22,15,"PAH",58,1,217,0)="  electronically signed."
^DIC(9.4,100,22,15,"PAH",58,1,218,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,219,0)="  MH ANSWERS file (#601.85)"
^DIC(9.4,100,22,15,"PAH",58,1,220,0)="  -------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,221,0)="  When a patient answers a question, the results are stored in this file. An "
^DIC(9.4,100,22,15,"PAH",58,1,222,0)="  entry for each question answered, in each administration is stored. Each "
^DIC(9.4,100,22,15,"PAH",58,1,223,0)="  entry  has an MH ADMINISTRATON ID field(#.01) of the MH ADMINISTRATION file "
^DIC(9.4,100,22,15,"PAH",58,1,224,0)="  (#601.84), a Question NUMBER field (#.01) of the MH QUESTIONS file (601.72) "
^DIC(9.4,100,22,15,"PAH",58,1,225,0)="  and the response."
^DIC(9.4,100,22,15,"PAH",58,1,226,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,227,0)="  MH SCALEGROUPS file (#601.86)"
^DIC(9.4,100,22,15,"PAH",58,1,228,0)="  -----------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,229,0)="  ScaleGroups are collections of MH SCALES file (#601.87) that are logically "
^DIC(9.4,100,22,15,"PAH",58,1,230,0)="  displayed together. Information needed to graph the scales are stored here."
^DIC(9.4,100,22,15,"PAH",58,1,231,0)="  This includes the ordinate title, minimum and maximum values, graph "
^DIC(9.4,100,22,15,"PAH",58,1,232,0)="  increments and grid lines.  "
^DIC(9.4,100,22,15,"PAH",58,1,233,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,234,0)="  All scales need to be associated with a MH SCALEGROUP to be displayed. MH "
^DIC(9.4,100,22,15,"PAH",58,1,235,0)="  SCALEGROUPS file (#601.86) and MH SCALES file (#601.87) allow multiple "
^DIC(9.4,100,22,15,"PAH",58,1,236,0)="  scoring possibilities within a single instrument."
^DIC(9.4,100,22,15,"PAH",58,1,237,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,238,0)="  MH SCALES file (#601.87)"
^DIC(9.4,100,22,15,"PAH",58,1,239,0)="  ------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,240,0)="  A MH SCALE is one dimension of measurement in an instrument. An example may "
^DIC(9.4,100,22,15,"PAH",58,1,241,0)="  simply be a TOTAL as in a spelling test or multiple scales in a personality "
^DIC(9.4,100,22,15,"PAH",58,1,242,0)="  disorder instrument (depression, anxiety, thought disorder etc.). Each scale "
^DIC(9.4,100,22,15,"PAH",58,1,243,0)="  has at least one associated entry in the MH SCALEGROUP file (#601.86) and an "
^DIC(9.4,100,22,15,"PAH",58,1,244,0)="  entry in the MH SCORING KEYS file (#601.91)."
^DIC(9.4,100,22,15,"PAH",58,1,245,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,246,0)="  MH DISPLAY file (#601.88)"
^DIC(9.4,100,22,15,"PAH",58,1,247,0)="  -------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,248,0)="  This file contains the entries to set the Windows display attributes for "
^DIC(9.4,100,22,15,"PAH",58,1,249,0)="  the MH QUESTIONS file (#601.72), MH INTRODUCTIONS file (#601.73) and the "
^DIC(9.4,100,22,15,"PAH",58,1,250,0)="  MH RESPONSE TYPES file (#601.74). Windows display attributes include fonts, "
^DIC(9.4,100,22,15,"PAH",58,1,251,0)="  bolding, underline, colors and columns."
^DIC(9.4,100,22,15,"PAH",58,1,252,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,253,0)="  MH CHOICEIDENTIFIERS file (#601.89)"
^DIC(9.4,100,22,15,"PAH",58,1,254,0)="  -----------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,255,0)="  This file specifies the displayed numeric options that go along with a "
^DIC(9.4,100,22,15,"PAH",58,1,256,0)="  multiple choice item.  Choice type identifiers can be numbered starting from "
^DIC(9.4,100,22,15,"PAH",58,1,257,0)="  one, from zero or remain unnumbered."
^DIC(9.4,100,22,15,"PAH",58,1,258,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,259,0)="  MH SCORING KEYS file (#601.91)"
^DIC(9.4,100,22,15,"PAH",58,1,260,0)="  ------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,261,0)="  This file contains the scoring keys.  The scoring keys are the ""answer "
^DIC(9.4,100,22,15,"PAH",58,1,262,0)="  sheet"" for the specified scale entry in the MH SCALES file (#601.87).  When "
^DIC(9.4,100,22,15,"PAH",58,1,263,0)="  an answer the matches the Target value (ie, is correct) a specified value is "
^DIC(9.4,100,22,15,"PAH",58,1,264,0)="  added to the score.  An example would be: if the question is ""How much is 5 "
^DIC(9.4,100,22,15,"PAH",58,1,265,0)="  plus 3"", the target value would be 8 and 10 points would be added to the "
^DIC(9.4,100,22,15,"PAH",58,1,266,0)="  total score (grade) in a ten question test to make a possible score of 1"
^DIC(9.4,100,22,15,"PAH",58,1,267,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,268,0)="  MH RESULTS file(#601.92)"
^DIC(9.4,100,22,15,"PAH",58,1,269,0)="  ______________________________"
^DIC(9.4,100,22,15,"PAH",58,1,270,0)="  This file contains results of the scored output of completed"
^DIC(9.4,100,22,15,"PAH",58,1,271,0)="  instruments."
^DIC(9.4,100,22,15,"PAH",58,1,272,0)="  "
^DIC(9.4,100,22,15,"PAH",58,1,273,0)="  MH REPORT file (#601.93)"
^DIC(9.4,100,22,15,"PAH",58,1,274,0)="  ------------------------------"
^DIC(9.4,100,22,15,"PAH",58,1,275,0)="  This file contains the reporting format for a specified instrument. Input"
^DIC(9.4,100,22,15,"PAH",58,1,276,0)="  into this file must be entered only through the Mental Health Editor software."
^DIC(9.4,100,22,15,"PAH",58,1,277,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,278,0)=" "
^DIC(9.4,100,22,15,"PAH",58,1,279,0)="             E3R#: None   "
^DIC(9.4,100,22,15,"PAH",58,1,280,0)="  "
^DIC(9.4,100,22,15,"PAH",58,1,281,0)="  Associated NOIS: HD68109/BAC-0704-40498    ASI e-sign while editing "
^DIC(9.4,100,22,15,"PAH",58,1,282,0)="                   HD68006/CLE-0504-40649    Interviewer cannot sign ASI in "
^DIC(9.4,100,22,15,"PAH",58,1,283,0)="                                             GUI "
^DIC(9.4,100,22,15,"PAH",58,1,284,0)="                   HD67955/COA-0404-20702    Cannot sign ASI using MHA "
^DIC(9.4,100,22,15,"PAH",58,1,285,0)="                   HD67709/BHS-0304-10794    Error - Null subscript at "
^DIC(9.4,100,22,15,"PAH",58,1,286,0)="                                             QTEP+6^YSASNAR "
^DIC(9.4,100,22,15,"PAH",58,1,287,0)="                   HD67885/MAC-0204-61794    Mental Health Assistant - "
^DIC(9.4,100,22,15,"PAH",58,1,288,0)="                                             can't get to old tests "
^DIC(9.4,100,22,15,"PAH",58,1,289,0)="                   HD67881/COA-0204-21407    MHA freezes during cross checks "
^DIC(9.4,100,22,15,"PAH",58,1,290,0)="                   HD67870/TNV-0204-30263    Co-signer ignored within ASI "
^DIC(9.4,100,22,15,"PAH",58,1,291,0)="                   HD67841/OKL-0104-71087    MH Assistant accessible w/o keys "
^DIC(9.4,100,22,15,"PAH",58,1,292,0)=" "
