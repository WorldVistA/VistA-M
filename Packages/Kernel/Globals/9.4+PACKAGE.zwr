^DIC(9.4,60,22,12,"PAH",15,1,0)="^^1^1^2980403"
^DIC(9.4,60,22,12,"PAH",15,1,1,0)="See the patch description PSO*6*168."
^DIC(9.4,60,22,12,"PAH",16,0)="169 SEQ #168^2980622^1"
^DIC(9.4,60,22,12,"PAH",16,1,0)="^^1^1^2980622"
^DIC(9.4,60,22,12,"PAH",16,1,1,0)="See the patch description PSO*6*169."
^DIC(9.4,60,22,12,"PAH",17,0)="170 SEQ #169^2980712^1"
^DIC(9.4,60,22,12,"PAH",17,1,0)="^^1^1^2980712"
^DIC(9.4,60,22,12,"PAH",17,1,1,0)="See the patch description PSO*6*170."
^DIC(9.4,60,22,12,"PAH",18,0)="173 SEQ #170^2980923^1"
^DIC(9.4,60,22,12,"PAH",18,1,0)="^^4^4^2980923"
^DIC(9.4,60,22,12,"PAH",18,1,1,0)=" "
^DIC(9.4,60,22,12,"PAH",18,1,2,0)="This patch contains modifications required by the implementation of the"
^DIC(9.4,60,22,12,"PAH",18,1,3,0)="NATIONAL DRUG FILE (NDF) package's APIs and the MailMan package's file"
^DIC(9.4,60,22,12,"PAH",18,1,4,0)="changes contained in patch XM*7.1*50."
^DIC(9.4,60,22,12,"PAH",19,0)="174 SEQ #171^2981119^1"
^DIC(9.4,60,22,12,"PAH",19,1,0)="^^1^1^2981119"
^DIC(9.4,60,22,12,"PAH",19,1,1,0)="See the patch description PSO*6*174."
^DIC(9.4,60,22,12,"PAH",20,0)="177 SEQ #172^2981229^1"
^DIC(9.4,60,22,12,"PAH",20,1,0)="^^2^2^2981229"
^DIC(9.4,60,22,12,"PAH",20,1,1,0)="This patch corrects a problem created by PSO*6*174.  If an Rx with at"
^DIC(9.4,60,22,12,"PAH",20,1,2,0)="least one refill is placed on hold, an undifined error will occur."
^DIC(9.4,60,22,12,"PAH",21,0)="172 SEQ #173^2990223^1"
^DIC(9.4,60,22,12,"PAH",21,1,0)="^^25^25^2990223"
^DIC(9.4,60,22,12,"PAH",21,1,1,0)="This patch addresses several problems reported via NOIS: "
^DIC(9.4,60,22,12,"PAH",21,1,2,0)=" 1) CLE-0397-41373 describes a situation where editing the QTY field (#7)"
^DIC(9.4,60,22,12,"PAH",21,1,3,0)="    or the QTY field (# 52.1,1 refill quantity) results in an update of"
^DIC(9.4,60,22,12,"PAH",21,1,4,0)="    the CURRENT INVENTORY field (#50) in the DRUG file (#50). The software"
^DIC(9.4,60,22,12,"PAH",21,1,5,0)="    was modified to prevent updating the CURRENT INVENTORY during edit."
^DIC(9.4,60,22,12,"PAH",21,1,6,0)=" "
^DIC(9.4,60,22,12,"PAH",21,1,7,0)=" 2) GNH-0298-42078 reports that when attempting to change the suspense"
^DIC(9.4,60,22,12,"PAH",21,1,8,0)="    date for a patient's Rxs using the Change Suspense Date [PSO PNDCHG]"
^DIC(9.4,60,22,12,"PAH",21,1,9,0)="    option, the lookup fails to find the patient's name.  The lookup"
^DIC(9.4,60,22,12,"PAH",21,1,10,0)="    involved did not include a necessary CMOP cross reference.  The cross"
^DIC(9.4,60,22,12,"PAH",21,1,11,0)="    reference has been included."
^DIC(9.4,60,22,12,"PAH",21,1,12,0)=" "
^DIC(9.4,60,22,12,"PAH",21,1,13,0)="3)  NAN-0498-41811 depicts a condition where an Rx written for a"
^DIC(9.4,60,22,12,"PAH",21,1,14,0)="    controlled substance had a one year expiration date rather than the"
^DIC(9.4,60,22,12,"PAH",21,1,15,0)="    required limit of 6 months. A check has been inserted and the"
^DIC(9.4,60,22,12,"PAH",21,1,16,0)="    expiration date of 6 months is forced on controlled substances."
^DIC(9.4,60,22,12,"PAH",21,1,17,0)=" "
^DIC(9.4,60,22,12,"PAH",21,1,18,0)="4)  A medical center using Outpatient Version 7.0 noticed that the cancel"
^DIC(9.4,60,22,12,"PAH",21,1,19,0)="    date from an Rx being renewed was transferred to the renewed Rx."
^DIC(9.4,60,22,12,"PAH",21,1,20,0)="    Research disclosed (also for V 6.0) that this was only happening if"
^DIC(9.4,60,22,12,"PAH",21,1,21,0)="    the Rx being renewed was already canceled before the renewing action"
^DIC(9.4,60,22,12,"PAH",21,1,22,0)="    was taken. If, as is normal, the Rx status was changed to cancel"
^DIC(9.4,60,22,12,"PAH",21,1,23,0)="    DURING the renewing action, the cancel date was not transferred to the"
^DIC(9.4,60,22,12,"PAH",21,1,24,0)="    new Rx. The code was modified to delete the old cancel date during"
^DIC(9.4,60,22,12,"PAH",21,1,25,0)="    renewals."
^DIC(9.4,60,22,12,"PAH",22,0)="156 SEQ #174^2990316^1"
^DIC(9.4,60,22,12,"PAH",22,1,0)="^^3^3^2990316"
^DIC(9.4,60,22,12,"PAH",22,1,1,0)="PSO*6.0*156 provides an interface between Outpatient Pharmacy V 6.0 and"
^DIC(9.4,60,22,12,"PAH",22,1,2,0)="CIRN V 1.0. The event points within the OP software calls an entry point"
^DIC(9.4,60,22,12,"PAH",22,1,3,0)="provided by the CIRN package, EN^RGEQ(""RX"",IRXN)."
^DIC(9.4,60,22,12,"PAH",23,0)="176 SEQ #175^2990316^1"
^DIC(9.4,60,22,12,"PAH",23,1,0)="^^6^6^2990316"
^DIC(9.4,60,22,12,"PAH",23,1,1,0)="This patch makes a functional change to the Partial Prescription [PSO"
^DIC(9.4,60,22,12,"PAH",23,1,2,0)="RXPAR] option.  Partial prescriptions will be prohibited if a prescription"
^DIC(9.4,60,22,12,"PAH",23,1,3,0)="has a ""canceled"", ""non-verified"", or ""pending"" status. "
^DIC(9.4,60,22,12,"PAH",23,1,4,0)=" "
^DIC(9.4,60,22,12,"PAH",23,1,5,0)="This change is consistent with updated functionality"
^DIC(9.4,60,22,12,"PAH",23,1,6,0)="included in Outpatient Pharmacy V. 7.0."
^DIC(9.4,60,22,12,"PAH","B",153,1)=""
^DIC(9.4,60,22,12,"PAH","B",154,2)=""
