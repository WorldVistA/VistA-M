^DIC(9.4,186,22,2,"PAH",2,1,0)="^^2^2^3071212"
^DIC(9.4,186,22,2,"PAH",2,1,1,0)="This build fixes several Clinical Case Registries problems and implements "
^DIC(9.4,186,22,2,"PAH",2,1,2,0)="several enhancements."
