^DIC(9.4,48,22,5.28,"PAH",308,0)="386 SEQ #355^3050924^1"
^DIC(9.4,48,22,5.28,"PAH",308,1,0)="^^6^6^3050924"
^DIC(9.4,48,22,5.28,"PAH",308,1,1,0)="The direct reference to the INJURING PARTIES INSURANCE company field, "
^DIC(9.4,48,22,5.28,"PAH",308,1,2,0)="located in the DISPOSITION multiple of the PATIENT file, has been "
^DIC(9.4,48,22,5.28,"PAH",308,1,3,0)="removed. This field must be encapsulated from direct reference and is not "
^DIC(9.4,48,22,5.28,"PAH",308,1,4,0)="available via an API. After installation of this patch, the option "
^DIC(9.4,48,22,5.28,"PAH",308,1,5,0)="SDPATIENT [Patient Profile MAS] will display ""UNSUPPORTED"" for the "
^DIC(9.4,48,22,5.28,"PAH",308,1,6,0)="Injurinng Parties Insurance Company."
^DIC(9.4,48,22,5.28,"PAH",309,0)="383 SEQ #356^3050924^1"
