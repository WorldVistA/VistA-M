^DIC(9.4,60,22,13,"PAH",625,1,511,0)="10. RxRenewalResponse Message Types under SQ"
^DIC(9.4,60,22,13,"PAH",625,1,512,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,513,0)="   The search query option MESSAGE TYPE has been modified. Upon entering"
^DIC(9.4,60,22,13,"PAH",625,1,514,0)="   certain message types (RE and CX) as listed below, the user will be"
^DIC(9.4,60,22,13,"PAH",625,1,515,0)="   prompted to enter the corresponding RESPONSE TYPE as indicated. In this"
^DIC(9.4,60,22,13,"PAH",625,1,516,0)="   prompt, users have the option to choose ALL to view all response types for"
^DIC(9.4,60,22,13,"PAH",625,1,517,0)="   the message type selected or select a specific response type as shown below."
^DIC(9.4,60,22,13,"PAH",625,1,518,0)="   For additional details on this new change, please refer to the user manual"
^DIC(9.4,60,22,13,"PAH",625,1,519,0)="   documentation."
^DIC(9.4,60,22,13,"PAH",625,1,520,0)="   "
^DIC(9.4,60,22,13,"PAH",625,1,521,0)="   SEARCH BY: 7  MESSAGE TYPE"
^DIC(9.4,60,22,13,"PAH",625,1,522,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,523,0)="   MESSAGE TYPE: RE  RXRENEWALRESPONSE"
^DIC(9.4,60,22,13,"PAH",625,1,524,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,525,0)="   RESPONSE TYPE: ALL// ?"
^DIC(9.4,60,22,13,"PAH",625,1,526,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,527,0)="   Enter a response type from the list."
^DIC(9.4,60,22,13,"PAH",625,1,528,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,529,0)="     Select one of the following:"
^DIC(9.4,60,22,13,"PAH",625,1,530,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,531,0)="          ALL       ALL"
^DIC(9.4,60,22,13,"PAH",625,1,532,0)="          A         APPROVED"
^DIC(9.4,60,22,13,"PAH",625,1,533,0)="          AWC       APPROVED WITH CHANGES"
^DIC(9.4,60,22,13,"PAH",625,1,534,0)="          D         DENIED"
^DIC(9.4,60,22,13,"PAH",625,1,535,0)="          DNP       DENIED, NEW RX TO FOLLOW"
^DIC(9.4,60,22,13,"PAH",625,1,536,0)="          R         REPLACE"
^DIC(9.4,60,22,13,"PAH",625,1,537,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,538,0)="    . . ."
^DIC(9.4,60,22,13,"PAH",625,1,539,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,540,0)="    MESSAGE TYPE: CX  RXCHANGERESPONSE"
^DIC(9.4,60,22,13,"PAH",625,1,541,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,542,0)="    RESPONSE TYPE: ALL// ?"
^DIC(9.4,60,22,13,"PAH",625,1,543,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,544,0)="    Enter a response type from the list."
^DIC(9.4,60,22,13,"PAH",625,1,545,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,546,0)="     Select one of the following:"
^DIC(9.4,60,22,13,"PAH",625,1,547,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,548,0)="          ALL       ALL"
^DIC(9.4,60,22,13,"PAH",625,1,549,0)="          A         APPROVED"
^DIC(9.4,60,22,13,"PAH",625,1,550,0)="          AWC       APPROVED WITH CHANGES"
^DIC(9.4,60,22,13,"PAH",625,1,551,0)="          D         DENIED"
^DIC(9.4,60,22,13,"PAH",625,1,552,0)="          V         VALIDATED"
^DIC(9.4,60,22,13,"PAH",625,1,553,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,554,0)="     Furthermore, the RXCHANGEREQUEST MESSAGE TYPE search has been altered. "
^DIC(9.4,60,22,13,"PAH",625,1,555,0)="     When the user inputs CR (RXCHANGEREQUEST) in the message type prompt, "
^DIC(9.4,60,22,13,"PAH",625,1,556,0)="     they will be prompted to enter the CHANGE REQUEST CODE. In this prompt,"
^DIC(9.4,60,22,13,"PAH",625,1,557,0)="     users can choose to either view all CHANGE REQUEST CODE or pick a"
^DIC(9.4,60,22,13,"PAH",625,1,558,0)="     specific CHANGE REQUEST CODE as shown below. Please refer the user manual"
^DIC(9.4,60,22,13,"PAH",625,1,559,0)="     documentation for further information regarding this new change."
^DIC(9.4,60,22,13,"PAH",625,1,560,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,561,0)="     MESSAGE TYPE: CR  RXCHANGEREQUEST"
^DIC(9.4,60,22,13,"PAH",625,1,562,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,563,0)="       Select one of the following:"
^DIC(9.4,60,22,13,"PAH",625,1,564,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,565,0)="          ALL       ALL"
^DIC(9.4,60,22,13,"PAH",625,1,566,0)="          D         DUE (Drug Use Evaluation) "
^DIC(9.4,60,22,13,"PAH",625,1,567,0)="          G         Generic Substitution"
^DIC(9.4,60,22,13,"PAH",625,1,568,0)="          OS        Out of Stock"
^DIC(9.4,60,22,13,"PAH",625,1,569,0)="          P         Prior Authorization Required"
^DIC(9.4,60,22,13,"PAH",625,1,570,0)="          S         Script Clarification"
^DIC(9.4,60,22,13,"PAH",625,1,571,0)="          T         Therapeutic Interchange/Substitution"
^DIC(9.4,60,22,13,"PAH",625,1,572,0)="          U         Prescriber Authorization"
^DIC(9.4,60,22,13,"PAH",625,1,573,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,574,0)="      CHANGE REQUEST CODE: ALL//"
^DIC(9.4,60,22,13,"PAH",625,1,575,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,576,0)="11.Search by Remove Reason codes"
^DIC(9.4,60,22,13,"PAH",625,1,577,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,578,0)="   The search query option MESSAGE TYPE has been modified. Upon entering"
^DIC(9.4,60,22,13,"PAH",625,1,579,0)="   certain eRx Status (RM and RJ) as listed below, the user will be prompted"
^DIC(9.4,60,22,13,"PAH",625,1,580,0)="   to enter the corresponding REMOVAL or REJECT REASON CODE as indicated. In"
^DIC(9.4,60,22,13,"PAH",625,1,581,0)="   this prompt, users have the option to choose ALL to view all REMOVAL or"
^DIC(9.4,60,22,13,"PAH",625,1,582,0)="   REJECT REASON CODE or select a specific response type as shown below. For"
^DIC(9.4,60,22,13,"PAH",625,1,583,0)="   additional details on this new change, please refer to the user manual "
^DIC(9.4,60,22,13,"PAH",625,1,584,0)="   documentation."
^DIC(9.4,60,22,13,"PAH",625,1,585,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,586,0)="    . . ."
^DIC(9.4,60,22,13,"PAH",625,1,587,0)="    SEARCH BY: 5  ERX STATUS"
^DIC(9.4,60,22,13,"PAH",625,1,588,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,589,0)="    ERX STATUS: RM       REMOVED"
^DIC(9.4,60,22,13,"PAH",625,1,590,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,591,0)="    REMOVAL REASON CODE: ALL// ?"
^DIC(9.4,60,22,13,"PAH",625,1,592,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,593,0)="    Enter the code associated with this action. Answer must be 1-10 "
^DIC(9.4,60,22,13,"PAH",625,1,594,0)="    characters in length."
^DIC(9.4,60,22,13,"PAH",625,1,595,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,596,0)="    Answer with ERX SERVICE REASON CODES, or NUMBER"
^DIC(9.4,60,22,13,"PAH",625,1,597,0)="    Do you want the entire ERX SERVICE REASON CODES List? Y  (Yes)"
^DIC(9.4,60,22,13,"PAH",625,1,598,0)="     Choose from:"
^DIC(9.4,60,22,13,"PAH",625,1,599,0)="     216  REM01     Drug out of stock or on backorder and unavailable for "
^DIC(9.4,60,22,13,"PAH",625,1,600,0)="                    processing"
^DIC(9.4,60,22,13,"PAH",625,1,601,0)="     217  REM02     Patient was not able to pick up"
^DIC(9.4,60,22,13,"PAH",625,1,602,0)="     218  REM03     Prescription canceled by Provider"
^DIC(9.4,60,22,13,"PAH",625,1,603,0)="     219  REM04     Prescription processed manually"
^DIC(9.4,60,22,13,"PAH",625,1,604,0)="     220  REM05     Provider will cancel this eRx and submit another"
^DIC(9.4,60,22,13,"PAH",625,1,605,0)="     221  REM06     Unable to mail prescription and patient unable to pick up"
^DIC(9.4,60,22,13,"PAH",625,1,606,0)="     222  REM07     Unable to contact patient"
^DIC(9.4,60,22,13,"PAH",625,1,607,0)="     223  REM08     Unable to contact provider"
^DIC(9.4,60,22,13,"PAH",625,1,608,0)="     224  REM91     Undefined system error"
^DIC(9.4,60,22,13,"PAH",625,1,609,0)="     225  REM92     Other"
^DIC(9.4,60,22,13,"PAH",625,1,610,0)="     1556 REM09     ERX Issue not resolved-Provider contacted"
^DIC(9.4,60,22,13,"PAH",625,1,611,0)="   "
^DIC(9.4,60,22,13,"PAH",625,1,612,0)="    REMOVAL REASON CODE: ALL// "
^DIC(9.4,60,22,13,"PAH",625,1,613,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,614,0)="    . . ."
^DIC(9.4,60,22,13,"PAH",625,1,615,0)="    SEARCH BY: 5  ERX STATUS"
^DIC(9.4,60,22,13,"PAH",625,1,616,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,617,0)="    ERX STATUS: RJ       REJECTED"
^DIC(9.4,60,22,13,"PAH",625,1,618,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,619,0)="    REJECT REASON CODE: ALL// ?"
^DIC(9.4,60,22,13,"PAH",625,1,620,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,621,0)="    Enter the code associated with this action. Answer must be 1-10 "
^DIC(9.4,60,22,13,"PAH",625,1,622,0)="    characters in length."
^DIC(9.4,60,22,13,"PAH",625,1,623,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,624,0)="    Answer with ERX SERVICE REASON CODES, or NUMBER"
^DIC(9.4,60,22,13,"PAH",625,1,625,0)="    Do you want the entire ERX SERVICE REASON CODES List? Y  (Yes)"
^DIC(9.4,60,22,13,"PAH",625,1,626,0)="     Choose from:"
^DIC(9.4,60,22,13,"PAH",625,1,627,0)="     203      PTT01     Patient not eligible"
^DIC(9.4,60,22,13,"PAH",625,1,628,0)="     204      PTT02     Cannot resolve Patient"
^DIC(9.4,60,22,13,"PAH",625,1,629,0)="     205      PVD01     Provider not eligible"
^DIC(9.4,60,22,13,"PAH",625,1,630,0)="     206      PVD02     Cannot resolve Provider"
^DIC(9.4,60,22,13,"PAH",625,1,631,0)="     207      DRU01     Not eligible for refills"
^DIC(9.4,60,22,13,"PAH",625,1,632,0)="     208      DRU02     Non-formulary drug"
^DIC(9.4,60,22,13,"PAH",625,1,633,0)="     209      DRU03     Duplicate Prescription found for this Patient"
^DIC(9.4,60,22,13,"PAH",625,1,634,0)="     210      DRU04     Invalid Quantity"
^DIC(9.4,60,22,13,"PAH",625,1,635,0)="     211      DRU05     Duplicate therapeutic class"
^DIC(9.4,60,22,13,"PAH",625,1,636,0)="     212      DRU06     CS prescription written/issue date has problems"
^DIC(9.4,60,22,13,"PAH",625,1,637,0)="     213      ERR01     Multiple errors, please contact the Pharmacy "
^DIC(9.4,60,22,13,"PAH",625,1,638,0)="     214      ERR02     Incorrect Pharmacy"
^DIC(9.4,60,22,13,"PAH",625,1,639,0)="     215      ERR03     Issues with prescription, please contact the pharmacy"
^DIC(9.4,60,22,13,"PAH",625,1,640,0)="     1557     PVD03     Missing/bad digital signature on inbound CS ERX"
^DIC(9.4,60,22,13,"PAH",625,1,641,0)="     1558     PVD04     Prescriber's CS credential is not appropriate"
^DIC(9.4,60,22,13,"PAH",625,1,642,0)="     1559     PTT03     Patient's mailing address is missing/mismatched"
^DIC(9.4,60,22,13,"PAH",625,1,643,0)="     1560     ERR99     Other"
^DIC(9.4,60,22,13,"PAH",625,1,644,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,645,0)="    REJECT REASON CODE: ALL// "
^DIC(9.4,60,22,13,"PAH",625,1,646,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,647,0)="12.Provider Auto-Validation for CS Drugs"
^DIC(9.4,60,22,13,"PAH",625,1,648,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,649,0)="   The Provider Auto-Validation functionality released with patch PSO*7*700"
^DIC(9.4,60,22,13,"PAH",625,1,650,0)="   (see item #5) will now be extended to digitally signed (indicating "
^DIC(9.4,60,22,13,"PAH",625,1,651,0)="   Controlled Substance) eRx's as well. The only additional check performed"
^DIC(9.4,60,22,13,"PAH",625,1,652,0)="   for auto-validating is that the VA provider must have a valid DEA# on file"
^DIC(9.4,60,22,13,"PAH",625,1,653,0)="   that matches the DEA# sent with the eRx. "
^DIC(9.4,60,22,13,"PAH",625,1,654,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,655,0)="13.Ability to Un-Process VistA Rx with a DELETED status"
^DIC(9.4,60,22,13,"PAH",625,1,656,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,657,0)="   Sometimes an eRx prescriptions that have already been transmitted to CMOP"
^DIC(9.4,60,22,13,"PAH",625,1,658,0)="   must be un-processed so it can go back to the eRx Holding Queue. Therefore,"
^DIC(9.4,60,22,13,"PAH",625,1,659,0)="   an exception was implemented in the software to allow non-CS eRx "
^DIC(9.4,60,22,13,"PAH",625,1,660,0)="   prescriptions with a DELETED status to be un-processed even after they have"
^DIC(9.4,60,22,13,"PAH",625,1,661,0)="   been transmitted to CMOP."
^DIC(9.4,60,22,13,"PAH",625,1,662,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,663,0)="14.Allow Un-Accept and Re-Accept of Approved eRx Renewals"
^DIC(9.4,60,22,13,"PAH",625,1,664,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,665,0)="   When a Renewal request is Approved by the outside prescriber the eRx will "
^DIC(9.4,60,22,13,"PAH",625,1,666,0)="   got straight to the Pending Order without stopping at the eRx Holding Queue"
^DIC(9.4,60,22,13,"PAH",625,1,667,0)="   first. The software will now allow the user to Un-Accept such records and "
^DIC(9.4,60,22,13,"PAH",625,1,668,0)="   send them back to the eRx Holding Queue so an issue (e.g., Eligibility"
^DIC(9.4,60,22,13,"PAH",625,1,669,0)="   verification, etc.) can be worked on there. Once the issue has been "
^DIC(9.4,60,22,13,"PAH",625,1,670,0)="   resolved the user will be able to re-accept the record without having to"
^DIC(9.4,60,22,13,"PAH",625,1,671,0)="   perform any matches or validations."
^DIC(9.4,60,22,13,"PAH",625,1,672,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,673,0)="15.Park Functionality in the eRx Holding Queue"
^DIC(9.4,60,22,13,"PAH",625,1,674,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,675,0)="   The Park functionality released by the patch PSO*7*441, released back in"
^DIC(9.4,60,22,13,"PAH",625,1,676,0)="   September of 2022 has now been implemented in the eRx Holding Queue. If the"
^DIC(9.4,60,22,13,"PAH",625,1,677,0)="   site has the Park functionality turned ON the user will be able to select"
^DIC(9.4,60,22,13,"PAH",625,1,678,0)="   PARK as an option for the PICKUP ROUTING besides MAIL or WINDOW, as shown"
^DIC(9.4,60,22,13,"PAH",625,1,679,0)="   below:"
^DIC(9.4,60,22,13,"PAH",625,1,680,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,681,0)="    eRx Refills: 3"
^DIC(9.4,60,22,13,"PAH",625,1,682,0)="    # OF REFILLS:  (0-3): 3// "
^DIC(9.4,60,22,13,"PAH",625,1,683,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,684,0)="         Select one of the following:"
^DIC(9.4,60,22,13,"PAH",625,1,685,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,686,0)="              M         MAIL"
^DIC(9.4,60,22,13,"PAH",625,1,687,0)="              W         WINDOW"
^DIC(9.4,60,22,13,"PAH",625,1,688,0)="              P         PARK"
^DIC(9.4,60,22,13,"PAH",625,1,689,0)="    "
^DIC(9.4,60,22,13,"PAH",625,1,690,0)="    PICKUP ROUTING: M//"
^DIC(9.4,60,22,13,"PAH",625,1,691,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,692,0)="16.No auto-match if Provider is inactive"
^DIC(9.4,60,22,13,"PAH",625,1,693,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,694,0)="   A check was added to prevent an inactive VistA provider from being auto-"
^DIC(9.4,60,22,13,"PAH",625,1,695,0)="   matched to the eRx even if the NPI matches. Furthermore, if the inactive"
^DIC(9.4,60,22,13,"PAH",625,1,696,0)="   VistA Provider is a suggestion it will be automatically forgotten."
^DIC(9.4,60,22,13,"PAH",625,1,697,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,698,0)="17.Patient, Provider and Drug/SIG auto-matching based on suggestions"
^DIC(9.4,60,22,13,"PAH",625,1,699,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,700,0)="   The auto-matching functionality is being further enhanced to utilize "
^DIC(9.4,60,22,13,"PAH",625,1,701,0)="   current VistA suggestions for Patient, Provider and Drug/SIG. For Patient "
^DIC(9.4,60,22,13,"PAH",625,1,702,0)="   and Provider if no auto-match was found the software will look for any "
^DIC(9.4,60,22,13,"PAH",625,1,703,0)="   existing suggestion and will auto-match to the latest VistA suggestion on"
^DIC(9.4,60,22,13,"PAH",625,1,704,0)="   file. In the case of Drug/SIG it will be greatly improved by matching not"
^DIC(9.4,60,22,13,"PAH",625,1,705,0)="   only the dispense drug but all fields from the suggested VistA Rx (if one"
^DIC(9.4,60,22,13,"PAH",625,1,706,0)="   exists), exactly as if the user accepted the suggestion manually."
^DIC(9.4,60,22,13,"PAH",625,1,707,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,708,0)="18.Updates to existing Accept(AC) action in Single eRx View/Display screen"
^DIC(9.4,60,22,13,"PAH",625,1,709,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,710,0)="   The existing Accept(AC) action in the Single eRx View/Display screen will"
^DIC(9.4,60,22,13,"PAH",625,1,711,0)="   automatically try perform the validation (AV) for Patient (except for MbM),"
^DIC(9.4,60,22,13,"PAH",625,1,712,0)="   Provider and Drug as well, if needed, before accepting the eRx. This"
^DIC(9.4,60,22,13,"PAH",625,1,713,0)="   action will still perform all the checks necessary by each individual"
^DIC(9.4,60,22,13,"PAH",625,1,714,0)="   record match and will display the result for validating each match"
^DIC(9.4,60,22,13,"PAH",625,1,715,0)="   separately."
^DIC(9.4,60,22,13,"PAH",625,1,716,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,717,0)="   Note: Please, refer to the user documentation for more detailed "
^DIC(9.4,60,22,13,"PAH",625,1,718,0)="         information about this new functionality."
^DIC(9.4,60,22,13,"PAH",625,1,719,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,720,0)="19.Ability to change the Hold code w/out Un-holding an eRx"
^DIC(9.4,60,22,13,"PAH",625,1,721,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,722,0)="   Users will now be able to switch the Hold code for an eRx on Hold for a"
^DIC(9.4,60,22,13,"PAH",625,1,723,0)="   different Hold code without having to un-hold the eRx. Once the user"
^DIC(9.4,60,22,13,"PAH",625,1,724,0)="   selects the Hold (H) action to hold an eRx already on software will inform"
^DIC(9.4,60,22,13,"PAH",625,1,725,0)="   them the eRx is already on hold and will ask if they want to change the"
^DIC(9.4,60,22,13,"PAH",625,1,726,0)="   Hold code, as shown below:"
^DIC(9.4,60,22,13,"PAH",625,1,727,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,728,0)="    Select Action: Next Screen// H   Hold  "
^DIC(9.4,60,22,13,"PAH",625,1,729,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,730,0)="    This eRx is already in a 'HOLD' status."
^DIC(9.4,60,22,13,"PAH",625,1,731,0)="    Would you like to change the hold status and comments? NO// YES"
^DIC(9.4,60,22,13,"PAH",625,1,732,0)="   "
^DIC(9.4,60,22,13,"PAH",625,1,733,0)="    Select HOLD reason code: HAL       NO PATIENT ALLERGY ASSESSMENT"
^DIC(9.4,60,22,13,"PAH",625,1,734,0)="    Additional Comments (Optional): ASSIGNING CORRECT HOLD CODE"
^DIC(9.4,60,22,13,"PAH",625,1,735,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,736,0)="20.First-In-First-Out (FIFO) processing for Complete Orders from OERR [PSO "
^DIC(9.4,60,22,13,"PAH",625,1,737,0)="   LMOE FINISH] option"
^DIC(9.4,60,22,13,"PAH",625,1,738,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,739,0)="   A FIFO order algorithm has been implemented for this option for users that"
^DIC(9.4,60,22,13,"PAH",625,1,740,0)="   hold the newly created PSO ERX WORKLOAD RPH security key. Once the user "
^DIC(9.4,60,22,13,"PAH",625,1,741,0)="   holding this key enters the option they will be prompted for the Clinic"
^DIC(9.4,60,22,13,"PAH",625,1,742,0)="   they want to finish Pending Orders for and then if they want to process"
^DIC(9.4,60,22,13,"PAH",625,1,743,0)="   Flagged orders only. After answering these two prompts the option will "
^DIC(9.4,60,22,13,"PAH",625,1,744,0)="   automatically select the patient with the oldest record for the user to work"
^DIC(9.4,60,22,13,"PAH",625,1,745,0)="   on. The user will not be able to move to the next patient unless all the"
^DIC(9.4,60,22,13,"PAH",625,1,746,0)="   current patient's pending orders are either finished or flagged. "
^DIC(9.4,60,22,13,"PAH",625,1,747,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,748,0)="   Note: Please, refer to the user documentation for more detailed "
^DIC(9.4,60,22,13,"PAH",625,1,749,0)="         information about this new functionality."
^DIC(9.4,60,22,13,"PAH",625,1,750,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,751,0)="21.eRx Prescriber Order Number in the Print"
^DIC(9.4,60,22,13,"PAH",625,1,752,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,753,0)="   The incoming prescriber order number will be displayed in Print (P) under"
^DIC(9.4,60,22,13,"PAH",625,1,754,0)="   the PRESCRIPTION INFORMATION section, as shown below:"
^DIC(9.4,60,22,13,"PAH",625,1,755,0)="   ... "
^DIC(9.4,60,22,13,"PAH",625,1,756,0)="   *************************PRESCRIPTION INFORMATION*************************"
^DIC(9.4,60,22,13,"PAH",625,1,757,0)="   Prescriber Order #: ECWIA-9382026-211005-828"
^DIC(9.4,60,22,13,"PAH",625,1,758,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,759,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,760,0)="22.Page breaking in the Print"
^DIC(9.4,60,22,13,"PAH",625,1,761,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,762,0)="   The Print (P) action will now page break one page at time instead of"
^DIC(9.4,60,22,13,"PAH",625,1,763,0)="   displaying the entire information, which forced the user to scroll up using"
^DIC(9.4,60,22,13,"PAH",625,1,764,0)="   the terminal scrolling capability."
^DIC(9.4,60,22,13,"PAH",625,1,765,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,766,0)="23.Allow Change Requests for eRx currently on Hold and Responses"
^DIC(9.4,60,22,13,"PAH",625,1,767,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,768,0)="   Two changes are being made to the Change Request (EC Action) functionality:"
^DIC(9.4,60,22,13,"PAH",625,1,769,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,770,0)="   a) The Change Request (EC) action will be allowed to be run on eRx's that"
^DIC(9.4,60,22,13,"PAH",625,1,771,0)="      are currently on Hold.  "
^DIC(9.4,60,22,13,"PAH",625,1,772,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,773,0)="   b) The Change Request (EC) action will be allowed to be run Response eRx's."
^DIC(9.4,60,22,13,"PAH",625,1,774,0)="      Before, the EC action was restricted to the NewRx records only. "
^DIC(9.4,60,22,13,"PAH",625,1,775,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,776,0)="24. RxChangeRequest 'Therapeutic Interchange/Subst.' reason message templates"
^DIC(9.4,60,22,13,"PAH",625,1,777,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,778,0)="   The CHANGE REQUEST CODE for 'Therapeutic Interchange/Substitution' has been"
^DIC(9.4,60,22,13,"PAH",625,1,779,0)="   updated to allow the pharmacist/technician to choose a reason code linked"
^DIC(9.4,60,22,13,"PAH",625,1,780,0)="   to a pre-made question template in the <RxChangeRequest> <ReasonText>"
^DIC(9.4,60,22,13,"PAH",625,1,781,0)="   field. The user will be prompted to choose a CHANGE REQUEST SUB-CODE from"
^DIC(9.4,60,22,13,"PAH",625,1,782,0)="   the options provided, as shown below."
^DIC(9.4,60,22,13,"PAH",625,1,783,0)="   . . ."
^DIC(9.4,60,22,13,"PAH",625,1,784,0)="       Select one of the following:"
^DIC(9.4,60,22,13,"PAH",625,1,785,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,786,0)="          D         DUE (Drug Use Evaluation) "
^DIC(9.4,60,22,13,"PAH",625,1,787,0)="          G         Generic Substitution"
^DIC(9.4,60,22,13,"PAH",625,1,788,0)="          OS        Out of Stock"
^DIC(9.4,60,22,13,"PAH",625,1,789,0)="          P         Prior Authorization Required"
^DIC(9.4,60,22,13,"PAH",625,1,790,0)="          S         Script Clarification"
^DIC(9.4,60,22,13,"PAH",625,1,791,0)="          T         Therapeutic Interchange/Substitution"
^DIC(9.4,60,22,13,"PAH",625,1,792,0)="          U         Prescriber Authorization"
^DIC(9.4,60,22,13,"PAH",625,1,793,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,794,0)="     CHANGE REQUEST CODE: T  Therapeutic Interchange/Substitution"
^DIC(9.4,60,22,13,"PAH",625,1,795,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,796,0)="       DSC - Days Supply Change"
^DIC(9.4,60,22,13,"PAH",625,1,797,0)="       FMC - Formulary Change"
^DIC(9.4,60,22,13,"PAH",625,1,798,0)="        "
^DIC(9.4,60,22,13,"PAH",625,1,799,0)="     CHANGE REQUEST SUB-CODE: DSC  Days Supply Change"
^DIC(9.4,60,22,13,"PAH",625,1,800,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,801,0)="    ==[ WRAP ]==[INSERT ]======< NOTE TO PROVIDER >=[Press <PF1>H for help]==="
^DIC(9.4,60,22,13,"PAH",625,1,802,0)="    Pharmacy would like to dispense this medication for 90 days of supply"
^DIC(9.4,60,22,13,"PAH",625,1,803,0)="    instead 30 days. Please approve the 90-days option below or Cancel Rx and"
^DIC(9.4,60,22,13,"PAH",625,1,804,0)="    send a replacement."
^DIC(9.4,60,22,13,"PAH",625,1,805,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,806,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,807,0)="    <=======T=======T=======T======T======T=======T=======T======T=====T>====="
^DIC(9.4,60,22,13,"PAH",625,1,808,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,809,0)="25.MbM Only: Auto-Holds for Pt. Eligibility and Non-Allergy Assessment "
^DIC(9.4,60,22,13,"PAH",625,1,810,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,811,0)="   Upon arrival from the eRx Hub the eRx will be checked whether the VistA"
^DIC(9.4,60,22,13,"PAH",625,1,812,0)="   Patient was auto-matched or not. If it was successfully matched, the "
^DIC(9.4,60,22,13,"PAH",625,1,813,0)="   software  will then check if the patient is eligible for ChampVA Rx"
^DIC(9.4,60,22,13,"PAH",625,1,814,0)="   benefit, if not, the software will automatically hold the eRx with an HEL "
^DIC(9.4,60,22,13,"PAH",625,1,815,0)="   (PATIENT ELIGIBILITY ISSUE). If eligible, the software will then check if"
^DIC(9.4,60,22,13,"PAH",625,1,816,0)="   the patient has an Allergy Assessment on file, if not, the software will"
^DIC(9.4,60,22,13,"PAH",625,1,817,0)="   automatically hold the eRx with an HAL (NO PATIENT ALLERGY ASSESSMENT)."
^DIC(9.4,60,22,13,"PAH",625,1,818,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,819,0)="26.Menu changes to the Single eRx View/Display Screen "
^DIC(9.4,60,22,13,"PAH",625,1,820,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,821,0)="   The bottom menu for the eRx Single eRx View/Display Screen was modified"
^DIC(9.4,60,22,13,"PAH",625,1,822,0)="   to increase the listing area by 2 lines. Only 3 actions will be available"
^DIC(9.4,60,22,13,"PAH",625,1,823,0)="   in the main menu: VD-VALIDATE PATIENT, VM-VALIDATE PROVIDER AND VD-VALIDATE"
^DIC(9.4,60,22,13,"PAH",625,1,824,0)="   DRUG/SIG. The actions P-Print, RJ-Reject and UH-Un Hold eRx were move to"
^DIC(9.4,60,22,13,"PAH",625,1,825,0)="   the Hidden actions section, as seen below:"
^DIC(9.4,60,22,13,"PAH",625,1,826,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,827,0)="   Main actions menu:"
^DIC(9.4,60,22,13,"PAH",625,1,828,0)="   -----------------"
^DIC(9.4,60,22,13,"PAH",625,1,829,0)="     +         Enter ?? for more actions                                        "
^DIC(9.4,60,22,13,"PAH",625,1,830,0)="     "
^DIC(9.4,60,22,13,"PAH",625,1,831,0)="     VP VALIDATE PATIENT     VM VALIDATE PROVIDER   VD VALIDATE DRUG/SIG"
^DIC(9.4,60,22,13,"PAH",625,1,832,0)="     H  Hold                 RM Remove eRx          AC Validate & Accept eRx"
^DIC(9.4,60,22,13,"PAH",625,1,833,0)="     Select Action: Next Screen// "
^DIC(9.4,60,22,13,"PAH",625,1,834,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,835,0)="   Hidden actions menu:"
^DIC(9.4,60,22,13,"PAH",625,1,836,0)="   -------------------"
^DIC(9.4,60,22,13,"PAH",625,1,837,0)="   Select Action: Next Screen// ??"
^DIC(9.4,60,22,13,"PAH",625,1,838,0)="   The following actions are also available:"
^DIC(9.4,60,22,13,"PAH",625,1,839,0)="   +    Next Screen      Q   Quit                VO   View Original eRx"
^DIC(9.4,60,22,13,"PAH",625,1,840,0)="   -    Previous Screen  AD  Add Comment         VRQ  View Request eRx"
^DIC(9.4,60,22,13,"PAH",625,1,841,0)="   UP  Up a Line         ACK Acknowledge         VRE  View Response eRx"
^DIC(9.4,60,22,13,"PAH",625,1,842,0)="   DN  Down a Line       SH  Status History      REC  Resend Change Request"
^DIC(9.4,60,22,13,"PAH",625,1,843,0)="   FS  First Screen      HL  View History Log    AC   Validate & Accept eRx"
^DIC(9.4,60,22,13,"PAH",625,1,844,0)="   LS  Last Screen       EC  eRx Change Request  H    Hold"
^DIC(9.4,60,22,13,"PAH",625,1,845,0)="   GO  Go to Page        PA  Patient Allergies   P    Print"
^DIC(9.4,60,22,13,"PAH",625,1,846,0)="   RD  Re Display Screen UR  Un Remove eRx       RJ   Reject"
^DIC(9.4,60,22,13,"PAH",625,1,847,0)="   PS  Print Screen      JO  Jump to OP          RM   Remove eRx"
^DIC(9.4,60,22,13,"PAH",625,1,848,0)="   PL  Print List        UX  Un Process eRx      UH   Un Hold"
^DIC(9.4,60,22,13,"PAH",625,1,849,0)="   SL  Search List       PN  Patient Progr. Note VSR  View Suggested Rx"
^DIC(9.4,60,22,13,"PAH",625,1,850,0)="   ADPL Auto Display(On/Off) AU  View Audit Log"
^DIC(9.4,60,22,13,"PAH",625,1,851,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,852,0)="27.New View Suggested Rx (VSR) action"
^DIC(9.4,60,22,13,"PAH",625,1,853,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,854,0)="   A new hidden action VSR was added to the eRx Single eRx View/Display hidden"
^DIC(9.4,60,22,13,"PAH",625,1,855,0)="   menu. This option will allow the user to view the VistA Rx that was used"
^DIC(9.4,60,22,13,"PAH",625,1,856,0)="   to suggest populate the prescription information for the current eRx. It "
^DIC(9.4,60,22,13,"PAH",625,1,857,0)="   will invoke the same layout from the View Prescription [PSO VIEW] option."
^DIC(9.4,60,22,13,"PAH",625,1,858,0)="   Once the user selects VSR and there's a Suggested VistA Rx that was used"
^DIC(9.4,60,22,13,"PAH",625,1,859,0)="   to populate the eRx, the user will receive the following notice before"
^DIC(9.4,60,22,13,"PAH",625,1,860,0)="   their are taken to viewing the suggested VistA Rx:"
^DIC(9.4,60,22,13,"PAH",625,1,861,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,862,0)="     Select Action: Next Screen//   VSR  "
^DIC(9.4,60,22,13,"PAH",625,1,863,0)="   "
^DIC(9.4,60,22,13,"PAH",625,1,864,0)="    _____________________________NOTICE______________________________________   "
^DIC(9.4,60,22,13,"PAH",625,1,865,0)="                                   "
^DIC(9.4,60,22,13,"PAH",625,1,866,0)="    You will be taken to the VistA prescription that was used to pre-populate"
^DIC(9.4,60,22,13,"PAH",625,1,867,0)="    the Drug fields (Product/SIG/Qty/Days Supply/# of Refills/Substitution)"
^DIC(9.4,60,22,13,"PAH",625,1,868,0)="    for this eRx (aka, 'Suggested VistA Rx'). This VistA Rx may or may not be"
^DIC(9.4,60,22,13,"PAH",625,1,869,0)="    for the same patient in this eRx being processed."
^DIC(9.4,60,22,13,"PAH",625,1,870,0)="    _________________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,871,0)="    Type <Enter> to continue or '^' to exit:  "
^DIC(9.4,60,22,13,"PAH",625,1,872,0)="                                                                                "
^DIC(9.4,60,22,13,"PAH",625,1,873,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,874,0)="28.New value for ACTION on SUGGESTION prompt: (V) VIEW RX"
^DIC(9.4,60,22,13,"PAH",625,1,875,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,876,0)="   The suggestion prompt for the Drug/Sig will now offer a new option VIEW RX"
^DIC(9.4,60,22,13,"PAH",625,1,877,0)="   (V) to allow the user to view the VistA Rx information before accepting it."
^DIC(9.4,60,22,13,"PAH",625,1,878,0)="   If the user select V a notice will be displayed before taking the user to"
^DIC(9.4,60,22,13,"PAH",625,1,879,0)="   view the Suggested VistA Rx detail, as shown below:"
^DIC(9.4,60,22,13,"PAH",625,1,880,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,881,0)="                                                     |Sugg. 1 of 1 - 12/12/24|"
^DIC(9.4,60,22,13,"PAH",625,1,882,0)="   ERX MED                               VISTA MED   |From Rx#: 9999999      |"
^DIC(9.4,60,22,13,"PAH",625,1,883,0)="   ___________________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,884,0)="   Drug: DOXYCYCLINE HYCLATE 100MG TAB    |Drug: DOXYCYCLINE HYCLATE 100MG TAB"
^DIC(9.4,60,22,13,"PAH",625,1,885,0)="   Substitution? YES    Renewals? YES     |"
^DIC(9.4,60,22,13,"PAH",625,1,886,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,887,0)="   SIG:                                   |SIG:"
^DIC(9.4,60,22,13,"PAH",625,1,888,0)="    TAKE ONE TABLET BY MOUTH TWICE DAILY  | TAKE ONE TABLET BY MOUTH TWICE "
^DIC(9.4,60,22,13,"PAH",625,1,889,0)="    AS DIRECTED BY PROVIDER AFTER SURGERY | DAILY"
^DIC(9.4,60,22,13,"PAH",625,1,890,0)="   _______________________________________|___________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,891,0)="   Quantity: 28                           |Quantity: 28"
^DIC(9.4,60,22,13,"PAH",625,1,892,0)="   Dispense Unit:                         |Dispense Unit: TAB"
^DIC(9.4,60,22,13,"PAH",625,1,893,0)="   _______________________________________|__________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,894,0)="   Days Supply: 14     Refills: 0         |Days Supply: 14     Refills: 11"
^DIC(9.4,60,22,13,"PAH",625,1,895,0)="   _______________________________________|__________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,896,0)="   ACTION on SUGGESTION: (A)CCEPT  (V)IEW RX  (F)ORGET  (E)XIT: EXIT// V"
^DIC(9.4,60,22,13,"PAH",625,1,897,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,898,0)="    _____________________________NOTICE______________________________________   "
^DIC(9.4,60,22,13,"PAH",625,1,899,0)="                                   "
^DIC(9.4,60,22,13,"PAH",625,1,900,0)="    You will be taken to the VistA Rx#9999999 that was entered in the past "
^DIC(9.4,60,22,13,"PAH",625,1,901,0)="    for the same Product (NDC/SIG/Qty/Days Supply/# of Refills/Substitution) "
^DIC(9.4,60,22,13,"PAH",625,1,902,0)="    for a different eRx. This VistA Rx may or may not be for the same patient"
^DIC(9.4,60,22,13,"PAH",625,1,903,0)="    in this eRx being processed."
^DIC(9.4,60,22,13,"PAH",625,1,904,0)="    _________________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,905,0)="    Type <Enter> to continue or '^' to exit:  "
^DIC(9.4,60,22,13,"PAH",625,1,906,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,907,0)="29.VistA Prescriber Class displayed on Single eRx and Pending Order"
^DIC(9.4,60,22,13,"PAH",625,1,908,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,909,0)="   The VistA Provider Class will now be displayed in the eRx Holding Queue"
^DIC(9.4,60,22,13,"PAH",625,1,910,0)="   as well as when viewing an eRx Pending Order, as shown below:"
^DIC(9.4,60,22,13,"PAH",625,1,911,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,912,0)="    Name: TEST,PROVIDER MD              |Name: TEST,PROVIDER              "
^DIC(9.4,60,22,13,"PAH",625,1,913,0)="    NPI : 123456789  Phone: 9999999999  |NPI : 123456789  Phone: 9999999999 "
^DIC(9.4,60,22,13,"PAH",625,1,914,0)="    DEA : XX9999999                     |DEA :                           "
^DIC(9.4,60,22,13,"PAH",625,1,915,0)="    Clinic: Wellness Clinic Inc.        |Class: PHYSICIAN                "
^DIC(9.4,60,22,13,"PAH",625,1,916,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,917,0)="30.New Next Drug (ND) hidden action"
^DIC(9.4,60,22,13,"PAH",625,1,918,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,919,0)="   The Next Drug (ND) hidden action was introduced to facilitate the user "
^DIC(9.4,60,22,13,"PAH",625,1,920,0)="   navigation to the Drug Validation screen for the actionable eRx from a "
^DIC(9.4,60,22,13,"PAH",625,1,921,0)="   single patient. This new action will work from two different screens in the"
^DIC(9.4,60,22,13,"PAH",625,1,922,0)="   eRx Holding Queue:"
^DIC(9.4,60,22,13,"PAH",625,1,923,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,924,0)="     a) eRx Single Patient Queue: if the user types ""ND"" in this screen it "
^DIC(9.4,60,22,13,"PAH",625,1,925,0)="        will take the user to the Drug Validation directly for the first "
^DIC(9.4,60,22,13,"PAH",625,1,926,0)="        actionable eRx for the current patient."
^DIC(9.4,60,22,13,"PAH",625,1,927,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,928,0)="     b) Drug Validation: if the user types ""ND"" in this screen it will"
^DIC(9.4,60,22,13,"PAH",625,1,929,0)="        take the user to the Drug Validation screen for the next (based on"
^DIC(9.4,60,22,13,"PAH",625,1,930,0)="        eRx Received Date/Time) actionable eRx for the patient. If the "
^DIC(9.4,60,22,13,"PAH",625,1,931,0)="        patient has only one actionable eRx it will stay in the same eRx."
^DIC(9.4,60,22,13,"PAH",625,1,932,0)="        If they current eRx is the last eRx on file for the patient it will"
^DIC(9.4,60,22,13,"PAH",625,1,933,0)="        loop back to the first eRx."
^DIC(9.4,60,22,13,"PAH",625,1,934,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,935,0)="31.Indication functionality added to eRx Holding Queue"
^DIC(9.4,60,22,13,"PAH",625,1,936,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,937,0)="   When matching the VistA Drug the user will now be prompted to also enter"
^DIC(9.4,60,22,13,"PAH",625,1,938,0)="   the Indication. This functionality was only available in CPRS, Complete"
^DIC(9.4,60,22,13,"PAH",625,1,939,0)="   Orders from OERR [PSO LMOE FINISH] and Patient Prescription Processing"
^DIC(9.4,60,22,13,"PAH",625,1,940,0)="   [PSO LM BACKDOOR ORDERS] options and it is now being extended to the eRx"
^DIC(9.4,60,22,13,"PAH",625,1,941,0)="   Holding Queue Processing [PSO ERX QUEUE PROCESSING] option as well. "
^DIC(9.4,60,22,13,"PAH",625,1,942,0)="   If the patient record includes Indication, the user will now see the"
^DIC(9.4,60,22,13,"PAH",625,1,943,0)="   Indication shown on the Single eRx View/Display landing page."
^DIC(9.4,60,22,13,"PAH",625,1,944,0)="   The Indication field will be displayed in the Single eRx View/Display"
^DIC(9.4,60,22,13,"PAH",625,1,945,0)="   screen as well as in the Drug Validation screen, where it can be edited."
^DIC(9.4,60,22,13,"PAH",625,1,946,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,947,0)="   Note: Please, refer to the user documentation for more detailed "
^DIC(9.4,60,22,13,"PAH",625,1,948,0)="         information about this new functionality."
^DIC(9.4,60,22,13,"PAH",625,1,949,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,950,0)="32.Added RRE and CRE error codes under CCR Filter"
^DIC(9.4,60,22,13,"PAH",625,1,951,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,952,0)="   The two error codes listed below have been added under CCR Filter. This"
^DIC(9.4,60,22,13,"PAH",625,1,953,0)="   will enable technicians to monitor and examine the RxChangeRequest/"
^DIC(9.4,60,22,13,"PAH",625,1,954,0)="   RxRenewalRequest sent either by the VA eRx hub software or by the outside"
^DIC(9.4,60,22,13,"PAH",625,1,955,0)="   prescribers."
^DIC(9.4,60,22,13,"PAH",625,1,956,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,957,0)="   CRE RxChangeRequest Inbound Error      "
^DIC(9.4,60,22,13,"PAH",625,1,958,0)="   RRE RxRenewalRequest Inbound Error"
^DIC(9.4,60,22,13,"PAH",625,1,959,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,960,0)="33.Patient DOB check on Edit and Accept Validation warning"
^DIC(9.4,60,22,13,"PAH",625,1,961,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,962,0)="   When editing or accepting validating the VistA patient, if there the DOB of"
^DIC(9.4,60,22,13,"PAH",625,1,963,0)="   the eRx Patient does not match the DOB of the VistA Patient, the warning "
^DIC(9.4,60,22,13,"PAH",625,1,964,0)="   below will be displayed:"
^DIC(9.4,60,22,13,"PAH",625,1,965,0)="     "
^DIC(9.4,60,22,13,"PAH",625,1,966,0)="    Editing:"
^DIC(9.4,60,22,13,"PAH",625,1,967,0)="    *****************************   WARNING(S)  *****************************"
^DIC(9.4,60,22,13,"PAH",625,1,968,0)="    Patient DOB mismatch (eRx: 01/01/1950 | VistA: 06/16/1936)"
^DIC(9.4,60,22,13,"PAH",625,1,969,0)="    *************************************************************************"
^DIC(9.4,60,22,13,"PAH",625,1,970,0)="    Would you like to use this patient? NO// "
^DIC(9.4,60,22,13,"PAH",625,1,971,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,972,0)="    Validating:"
^DIC(9.4,60,22,13,"PAH",625,1,973,0)="    *****************************   WARNING(S)  *****************************"
^DIC(9.4,60,22,13,"PAH",625,1,974,0)="    Patient DOB mismatch (eRx: 01/01/1950 | VistA: 06/16/1936)"
^DIC(9.4,60,22,13,"PAH",625,1,975,0)="    *************************************************************************"
^DIC(9.4,60,22,13,"PAH",625,1,976,0)="    Would you like to mark this patient as VALIDATED?"
^DIC(9.4,60,22,13,"PAH",625,1,977,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,978,0)="34.Memorize the VistA patient when eRx is selected (<SPACE BAR>)"
^DIC(9.4,60,22,13,"PAH",625,1,979,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,980,0)="   When the user selects an eRx that has a VistA Patient matched to it, the "
^DIC(9.4,60,22,13,"PAH",625,1,981,0)="   VistA patient will now be memorized as the last patient accessed by the"
^DIC(9.4,60,22,13,"PAH",625,1,982,0)="   user, therefore when the user type <SPACE BAR> at a VistA PATIENT prompt,"
^DIC(9.4,60,22,13,"PAH",625,1,983,0)="   it will automatically select the VistA Patient matched to the eRx."
^DIC(9.4,60,22,13,"PAH",625,1,984,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,985,0)="35.HFF for Un-Accept and Un-Remove will now ask for Future Fill Date"
^DIC(9.4,60,22,13,"PAH",625,1,986,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,987,0)="   When Un-Accepting or Un-Removing an eRx and selecting the hold code HFF "
^DIC(9.4,60,22,13,"PAH",625,1,988,0)="   (HOLD FOR FUTURE FILL) the software was not prompting the user to select"
^DIC(9.4,60,22,13,"PAH",625,1,989,0)="   a 'Future Fill Hold Date', which indicates when the eRx should be"
^DIC(9.4,60,22,13,"PAH",625,1,990,0)="   automatically be un-held. This was causing the eRx to be unheld immediately"
^DIC(9.4,60,22,13,"PAH",625,1,991,0)="   after being put on hold. This will be fixed with this patch."
^DIC(9.4,60,22,13,"PAH",625,1,992,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,993,0)="36.IAS (Include All Statuses) action extended to Rx Medication Queue as well"
^DIC(9.4,60,22,13,"PAH",625,1,994,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,995,0)="   The IAS action that was only available at the eRx Single Patient Queue will"
^DIC(9.4,60,22,13,"PAH",625,1,996,0)="   now be available in the Rx Medication Queue as well. This action is used to"
^DIC(9.4,60,22,13,"PAH",625,1,997,0)="   indicate that all eRx statuses should be included in the list and it will"
^DIC(9.4,60,22,13,"PAH",625,1,998,0)="   behave as such for the Rx Medication Queue as well."
^DIC(9.4,60,22,13,"PAH",625,1,999,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1000,0)="37.eRx Prescriber Phone # displayed on Pending Order and Active Rx"
^DIC(9.4,60,22,13,"PAH",625,1,1001,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1002,0)="   The eRx Prescriber Phone # will now be displayed for the eRx Pending Order"
^DIC(9.4,60,22,13,"PAH",625,1,1003,0)="   as well as for an ACTIVE eRx prescription."
^DIC(9.4,60,22,13,"PAH",625,1,1004,0)="   Pending order:"
^DIC(9.4,60,22,13,"PAH",625,1,1005,0)="   -------------"
^DIC(9.4,60,22,13,"PAH",625,1,1006,0)="    Name: TEST,PROVIDER MD             |Name: TEST,PROVIDER              "
^DIC(9.4,60,22,13,"PAH",625,1,1007,0)="    NPI : xxxxxxxxxx Phone: 9999999999 |NPI : xxxxxxxxxxx  Phone: 9999999999"
^DIC(9.4,60,22,13,"PAH",625,1,1008,0)="    DEA : XX9999999                    |DEA :                            "
^DIC(9.4,60,22,13,"PAH",625,1,1009,0)="    Clinic: BFS - Gastroenterology      |Class: NURSE PRACTITIONER        "
^DIC(9.4,60,22,13,"PAH",625,1,1010,0)="   Active order:"
^DIC(9.4,60,22,13,"PAH",625,1,1011,0)="   ------------"
^DIC(9.4,60,22,13,"PAH",625,1,1012,0)="    eRx HT: (cm)()                  eRx WT: (kg)()                              "
^DIC(9.4,60,22,13,"PAH",625,1,1013,0)="    "
^DIC(9.4,60,22,13,"PAH",625,1,1014,0)="    eRx Provider: xxxxxxxxxxxxxx                          DEA: xxxxxxxxxx"
^DIC(9.4,60,22,13,"PAH",625,1,1015,0)="    eRx Phone: xxxxxxxxxx                                 NPI: xxxxxxxxxx"
^DIC(9.4,60,22,13,"PAH",625,1,1016,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1017,0)="38.VistA Drug Edit capability on the Single eRx View/Display screen"
^DIC(9.4,60,22,13,"PAH",625,1,1018,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1019,0)="   When viewing the eRx int he Single eRx View/Display screen the users will"
^DIC(9.4,60,22,13,"PAH",625,1,1020,0)="   now be able to edit the drug fields. Before, this capability was only"
^DIC(9.4,60,22,13,"PAH",625,1,1021,0)="   available in the Validate Drug (VD action) screen. This will allow users"
^DIC(9.4,60,22,13,"PAH",625,1,1022,0)="   to do quick edits such as Indication or Patient Instructions field without"
^DIC(9.4,60,22,13,"PAH",625,1,1023,0)="   having to go into the Validate Drug screen. The edit can be done "
^DIC(9.4,60,22,13,"PAH",625,1,1024,0)="   exclusively by typing the # of the field the user intends to edit, if #1"
^DIC(9.4,60,22,13,"PAH",625,1,1025,0)="   (Drug) is selected the user will be prompt to edit all other fields as"
^DIC(9.4,60,22,13,"PAH",625,1,1026,0)="   well. This sample shows #'s before each editable field:"
^DIC(9.4,60,22,13,"PAH",625,1,1027,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,1028,0)="      DRUG AUTO-MATCHED | VALIDATED by rrrrrrr   on 11/2/24@14:55:54"
^DIC(9.4,60,22,13,"PAH",625,1,1029,0)="   __________________________________________________________________________"
^DIC(9.4,60,22,13,"PAH",625,1,1030,0)="   Drug: Suprep Bowel Prep Kit 1.6 g-17|1)Drug: COLON ELECTROLYTE LAVAGE ORAL"
^DIC(9.4,60,22,13,"PAH",625,1,1031,0)="         g-17.5 g/177 mL liquid        |        SOLN KIT                        "
^DIC(9.4,60,22,13,"PAH",625,1,1032,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1033,0)="   Drug Form: LIQUID DOSAGE FORM       |        *** NON-FORMULARY ***           "
^DIC(9.4,60,22,13,"PAH",625,1,1034,0)="   Substitution? YES    Renewals? YES  |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1035,0)="   SIG:                                |SIG:                                    "
^DIC(9.4,60,22,13,"PAH",625,1,1036,0)="    354 ml orally 177 ml evening before| TAKE 1 KIT BY MOUTH EVERY MORNING      "
^DIC(9.4,60,22,13,"PAH",625,1,1037,0)="    and 177 morning of colonoscopy     |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1038,0)="   Prescriber Drug Use Evaluation:     |       Verb: TAKE                       "
^DIC(9.4,60,22,13,"PAH",625,1,1039,0)="    None                               |2)   Dosage: 1 KIT                      "
^DIC(9.4,60,22,13,"PAH",625,1,1040,0)="                                       |      Route: ORAL                       "
^DIC(9.4,60,22,13,"PAH",625,1,1041,0)="                                       |   Schedule: QAM                        "
^DIC(9.4,60,22,13,"PAH",625,1,1042,0)="                                       |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1043,0)="                                       |3)Patient Instructions:                 "
^DIC(9.4,60,22,13,"PAH",625,1,1044,0)="                                       |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1045,0)="   Provider Notes/Comments:            |4)Provider Comments:                 "
^DIC(9.4,60,22,13,"PAH",625,1,1046,0)="                                       |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1047,0)="                                       |5)Pat. Status: SC                       "
^DIC(9.4,60,22,13,"PAH",625,1,1048,0)="                                       |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1049,0)="   Quantity: 354                       |6)Quantity: 33                          "
^DIC(9.4,60,22,13,"PAH",625,1,1050,0)="   Dispense Unit: MILLILITER           |  Dispense Unit: TAB                    "
^DIC(9.4,60,22,13,"PAH",625,1,1051,0)="   Qty Qualifier: Original Quantity    |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1052,0)="   Days Supply: 1      Refills: 0      |7)Days Supply: 33     8)Refills: 11     "
^DIC(9.4,60,22,13,"PAH",625,1,1053,0)="                                       |9)Routing: MAIL                         "
^DIC(9.4,60,22,13,"PAH",625,1,1054,0)="                                       |10)Clinic: CWM/NO/PHARM/INBOUND ERX     "
^DIC(9.4,60,22,13,"PAH",625,1,1055,0)="   Written: 07/23/24  Effective:       |                                        "
^DIC(9.4,60,22,13,"PAH",625,1,1056,0)="   Primary Dx:                         |11)Indications:                         "
^DIC(9.4,60,22,13,"PAH",625,1,1057,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,1058,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1059,0)="39.After AV it will go back to Single eRx View/Display (VAMC's only)"
^DIC(9.4,60,22,13,"PAH",625,1,1060,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1061,0)="   A small change was made to streamline the processing of eRx's. Once the"
^DIC(9.4,60,22,13,"PAH",625,1,1062,0)="   user accepts validation (AV action) for a patient, provider or drug, the"
^DIC(9.4,60,22,13,"PAH",625,1,1063,0)="   software will take them automatically to the Single eRx View/Display"
^DIC(9.4,60,22,13,"PAH",625,1,1064,0)="   screen. This ways they don't have to type ""^"" or <ENTER>'s in order to"
^DIC(9.4,60,22,13,"PAH",625,1,1065,0)="   go back to the Single eRx View/Display screen."
^DIC(9.4,60,22,13,"PAH",625,1,1066,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1067,0)="40.Default for Copy PATIENT INSTRUCTIONS from Rx#12345? Y// changed to 'NO'"
^DIC(9.4,60,22,13,"PAH",625,1,1068,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1069,0)="   When accepting a VistA Drug suggestion for an eRx, the software prompts the"
^DIC(9.4,60,22,13,"PAH",625,1,1070,0)="   user if they also want to copy the Patient Instructions from the suggested"
^DIC(9.4,60,22,13,"PAH",625,1,1071,0)="   VistA Rx if it has this field populated. The default for this prompt was"
^DIC(9.4,60,22,13,"PAH",625,1,1072,0)="   'YES' and it is being changed to 'NO'."
^DIC(9.4,60,22,13,"PAH",625,1,1073,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1074,0)="41.Jump to eRx (JE) action modification at the Patient level"
^DIC(9.4,60,22,13,"PAH",625,1,1075,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1076,0)="   The Jump to eRx (JE) action used to jump from Backdoor Pharmacy back to the"
^DIC(9.4,60,22,13,"PAH",625,1,1077,0)="   eRx Holding Queue is being modified to included all variations of the eRx"
^DIC(9.4,60,22,13,"PAH",625,1,1078,0)="   Patient that are matched to the same VistA Patient. Instead of jumping to"
^DIC(9.4,60,22,13,"PAH",625,1,1079,0)="   the eRx Single Patient Queue the user will now be taken to the eRx"
^DIC(9.4,60,22,13,"PAH",625,1,1080,0)="   Medication Queue with the VistA Patient filter automatically set with the"
^DIC(9.4,60,22,13,"PAH",625,1,1081,0)="   patient that was selected in Backdoor Pharmacy. Therefore, the list items"
^DIC(9.4,60,22,13,"PAH",625,1,1082,0)="   will include all eRx's from all eRx Patients that have been matched to the"
^DIC(9.4,60,22,13,"PAH",625,1,1083,0)="   VistA Patient. "
^DIC(9.4,60,22,13,"PAH",625,1,1084,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1085,0)="42.DEA Nightly Update Job w/ Data from DEA/DOJ"
^DIC(9.4,60,22,13,"PAH",625,1,1086,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1087,0)="   A new menu option called DEA Number Nightly Update with DEA/DOJ Data [PSO"
^DIC(9.4,60,22,13,"PAH",625,1,1088,0)="   DEA/DOJ NIGHTLY DATA UPD] is being created by this patch. This option is"
^DIC(9.4,60,22,13,"PAH",625,1,1089,0)="   used for automatically updating the Kernel DEA NUMBERS file (#8991.9) with"
^DIC(9.4,60,22,13,"PAH",625,1,1090,0)="   the latest prescriber DEA information from DEA/DOJ database. It will run"
^DIC(9.4,60,22,13,"PAH",625,1,1091,0)="   nightly and it will update DEA data for entries that are 30 days or less"
^DIC(9.4,60,22,13,"PAH",625,1,1092,0)="   from expiring. This new option will be added to the list of options that"
^DIC(9.4,60,22,13,"PAH",625,1,1093,0)="   can be edited via the existing Queue Background Jobs [PSO AUTOQUEUE JOBS]"
^DIC(9.4,60,22,13,"PAH",625,1,1094,0)="   option."
^DIC(9.4,60,22,13,"PAH",625,1,1095,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1096,0)="43.Patient address will ignore differences between similar words"
^DIC(9.4,60,22,13,"PAH",625,1,1097,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1098,0)="   The patient address comparison between eRx and VistA patients is being "
^DIC(9.4,60,22,13,"PAH",625,1,1099,0)="   enhanced to recognize and ignore these differences listed below by not"
^DIC(9.4,60,22,13,"PAH",625,1,1100,0)="   reversing the video if these are the only difference between the addresses:"
^DIC(9.4,60,22,13,"PAH",625,1,1101,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1102,0)="      DR   =  DRIVE               APT  =  APARTMENT         STE  =  SUITE"
^DIC(9.4,60,22,13,"PAH",625,1,1103,0)="      AVE  =  AVENUE              W    =  WEST              S    =  SOUTH"
^DIC(9.4,60,22,13,"PAH",625,1,1104,0)="      ST   =  STREET              NW   =  NORTHWEST         SW   =  SOUTHWEST"
^DIC(9.4,60,22,13,"PAH",625,1,1105,0)="      HGWY =  HIGHWAY             NE   =  NORTHEAST         SE   =  SOUTHEAST"
^DIC(9.4,60,22,13,"PAH",625,1,1106,0)="      BLVD =  BOULEVARD           CT   =  COURT             RD   =  ROAD"
^DIC(9.4,60,22,13,"PAH",625,1,1107,0)="      TER  =  TERRACE             PKY  =  PARKWAY"
^DIC(9.4,60,22,13,"PAH",625,1,1108,0)="   "
^DIC(9.4,60,22,13,"PAH",625,1,1109,0)="44.Conversion issue with Patient Weight when prescriber sent in g (grams)"
^DIC(9.4,60,22,13,"PAH",625,1,1110,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1111,0)="   When the outside prescriber sent in a patient weight in grams (g) the"
^DIC(9.4,60,22,13,"PAH",625,1,1112,0)="   software was not making the proper conversion to kilograms and it was"
^DIC(9.4,60,22,13,"PAH",625,1,1113,0)="   displaying the value in grams with a 'kg' indication in the Patient"
^DIC(9.4,60,22,13,"PAH",625,1,1114,0)="   Validation scree, as shown below:"
^DIC(9.4,60,22,13,"PAH",625,1,1115,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,1116,0)="          Weight(kg): 107161.2                   |Weight(kg): 107.95            "
^DIC(9.4,60,22,13,"PAH",625,1,1117,0)="          "
^DIC(9.4,60,22,13,"PAH",625,1,1118,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,1119,0)="   After fix:"
^DIC(9.4,60,22,13,"PAH",625,1,1120,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,1121,0)="          Weight(kg): 107.16                     |Weight(kg): 107.95     "
^DIC(9.4,60,22,13,"PAH",625,1,1122,0)="   ..."
^DIC(9.4,60,22,13,"PAH",625,1,1123,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1124,0)="45.HFF (Hold for Future Fill) will now set the Effective Date if none"
^DIC(9.4,60,22,13,"PAH",625,1,1125,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1126,0)="   If an eRx is received without an Effective Date value and No Refills and"
^DIC(9.4,60,22,13,"PAH",625,1,1127,0)="   the user decides to hold it with a future fill date (HFF), if the date "
^DIC(9.4,60,22,13,"PAH",625,1,1128,0)="   entered by the user is more than 30 days from eRx Written Date the software"
^DIC(9.4,60,22,13,"PAH",625,1,1129,0)="   will set the Effective Date on the eRx with the future date entered by the"
^DIC(9.4,60,22,13,"PAH",625,1,1130,0)="   user when placing the eRx on Hold with the HFF code."
^DIC(9.4,60,22,13,"PAH",625,1,1131,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1132,0)="46.CAO status will automatically be set with CAA (MbM only)"
^DIC(9.4,60,22,13,"PAH",625,1,1133,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1134,0)="   When a cancelation is received from the outside prescriber and the eRx"
^DIC(9.4,60,22,13,"PAH",625,1,1135,0)="   status is set to CAO (CANCEL PROCESS COMPLETE) the software will "
^DIC(9.4,60,22,13,"PAH",625,1,1136,0)="   automatically set it to CAA (CANCEL REQUEST ACKNOWLEDGED) for Meds-by-Mail"
^DIC(9.4,60,22,13,"PAH",625,1,1137,0)="   sites. The reason is because the volume of CAO records at Meds-by-Mail"
^DIC(9.4,60,22,13,"PAH",625,1,1138,0)="   makes it impossible to acknowledge them manually one by one."
^DIC(9.4,60,22,13,"PAH",625,1,1139,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1140,0)="47.Cancelations of RxRenewal and RxChange were not DCing Pending/Active Order"
^DIC(9.4,60,22,13,"PAH",625,1,1141,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1142,0)="   When a RxRenewal or Rx Change response had been processed from the eRx "
^DIC(9.4,60,22,13,"PAH",625,1,1143,0)="   Holding queue and were either on the Pending or Active order queue and the"
^DIC(9.4,60,22,13,"PAH",625,1,1144,0)="   outside prescriber sent in a cancellation for the renewal or accepted"
^DIC(9.4,60,22,13,"PAH",625,1,1145,0)="   change request the software was failing to proper cancel (DC) the pending"
^DIC(9.4,60,22,13,"PAH",625,1,1146,0)="   or active order for the corresponding medication. This issue is being "
^DIC(9.4,60,22,13,"PAH",625,1,1147,0)="   addressed by this patch."
^DIC(9.4,60,22,13,"PAH",625,1,1148,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1149,0)="48.Allergies compare between eRx and VistA were Case Sensitive"
^DIC(9.4,60,22,13,"PAH",625,1,1150,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1151,0)="   When comparing incoming list of allergies from the external prescriber with"
^DIC(9.4,60,22,13,"PAH",625,1,1152,0)="   the list of VistA allergies the software was performing a case sensitive"
^DIC(9.4,60,22,13,"PAH",625,1,1153,0)="   comparison. In other words, if the outside prescriber sent in 'Tomato' and"
^DIC(9.4,60,22,13,"PAH",625,1,1154,0)="   in VistA we had 'TOMATO' it would reverse the video on both because it"
^DIC(9.4,60,22,13,"PAH",625,1,1155,0)="   assumed them to be different. This issue is being addressed by this patch."
^DIC(9.4,60,22,13,"PAH",625,1,1156,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1157,0)="49.Update to the Pharmacist Enter/Edit [PSO RPH] option"
^DIC(9.4,60,22,13,"PAH",625,1,1158,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1159,0)="   Previously this option was used to allocated and de-allocate the PSORPH key"
^DIC(9.4,60,22,13,"PAH",625,1,1160,0)="   that identifies a user as a pharmacist on the system. It is now being "
^DIC(9.4,60,22,13,"PAH",625,1,1161,0)="   modified to allow allocation and de-allocation of the following eRx keys:"
^DIC(9.4,60,22,13,"PAH",625,1,1162,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1163,0)="     PSO ERX WORKLOAD TECH "
^DIC(9.4,60,22,13,"PAH",625,1,1164,0)="     PSO ERX WORKLOAD RPH "
^DIC(9.4,60,22,13,"PAH",625,1,1165,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1166,0)="   These keys are mostly used by MbM to flag a user as a workload processing"
^DIC(9.4,60,22,13,"PAH",625,1,1167,0)="   technician or pharmacist, which prevents them from skipping orders, "
^DIC(9.4,60,22,13,"PAH",625,1,1168,0)="   effectively imposing a FIFO (First-In-First-Out) processing of incoming"
^DIC(9.4,60,22,13,"PAH",625,1,1169,0)="   eRx and Pending orders."
^DIC(9.4,60,22,13,"PAH",625,1,1170,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1171,0)="50.New option for Batch Change Request and VistA Drug Replacement"
^DIC(9.4,60,22,13,"PAH",625,1,1172,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1173,0)="   The new option Batch eRx Change Request/VistA Drug Replacement [PSO ERX "
^DIC(9.4,60,22,13,"PAH",625,1,1174,0)="   BATCH CH REQ/DRUG SWAP] placed under the Supervisor Functions [PSO"
^DIC(9.4,60,22,13,"PAH",625,1,1175,0)="   SUPERVISOR] menu option. It is used to perform two distinct tasks:"
^DIC(9.4,60,22,13,"PAH",625,1,1176,0)="  "
^DIC(9.4,60,22,13,"PAH",625,1,1177,0)="    Submission of Multiple eRx Change Requests"
^DIC(9.4,60,22,13,"PAH",625,1,1178,0)="    Replacement of the Vista Dispense Drug on finished prescriptions (MbM only)"
^DIC(9.4,60,22,13,"PAH",625,1,1179,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1180,0)="   The user will respond few prompts, specific to the task they want to"
^DIC(9.4,60,22,13,"PAH",625,1,1181,0)="   perform, a list will be presented before the user actually perform the"
^DIC(9.4,60,22,13,"PAH",625,1,1182,0)="   update. The Replacement of the VistA Dispense Drug is available to MbM "
^DIC(9.4,60,22,13,"PAH",625,1,1183,0)="   (Meds-by-Mail) only users. For more information about this option please"
^DIC(9.4,60,22,13,"PAH",625,1,1184,0)="   review the user documentation released along with this patch."
^DIC(9.4,60,22,13,"PAH",625,1,1185,0)="   "
^DIC(9.4,60,22,13,"PAH",625,1,1186,0)="51.eRx Pending Order Suggested FILL DATE auto calculation "
^DIC(9.4,60,22,13,"PAH",625,1,1187,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1188,0)="   Currently, the Fill Date field for an eRx Pending Order is always set to "
^DIC(9.4,60,22,13,"PAH",625,1,1189,0)="   the current date. In some cases this is not ideal because the patient might "
^DIC(9.4,60,22,13,"PAH",625,1,1190,0)="   still have enough medication to last a few more days and a future fill "
^DIC(9.4,60,22,13,"PAH",625,1,1191,0)="   date, based on the last fill for the medication might be more appropriate. "
^DIC(9.4,60,22,13,"PAH",625,1,1192,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1193,0)="   The algorithm will auto calculate the suggested Fill Date using the "
^DIC(9.4,60,22,13,"PAH",625,1,1194,0)="   following logic: "
^DIC(9.4,60,22,13,"PAH",625,1,1195,0)="     Requirement: "
^DIC(9.4,60,22,13,"PAH",625,1,1196,0)="       - A previous prescription for the exact same drug must be found on the "
^DIC(9.4,60,22,13,"PAH",625,1,1197,0)="         patient's profile "
^DIC(9.4,60,22,13,"PAH",625,1,1198,0)="       - The SIG from the previous prescription must match exactly with the "
^DIC(9.4,60,22,13,"PAH",625,1,1199,0)="         SIG for the new eRx Pending Order "
^DIC(9.4,60,22,13,"PAH",625,1,1200,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1201,0)="     Suggested Future Fill Date: "
^DIC(9.4,60,22,13,"PAH",625,1,1202,0)="       - If Last Fill is Released and the Release Date + Days Supply results "
^DIC(9.4,60,22,13,"PAH",625,1,1203,0)="         in a future date, this futures date suggested as the Fill Date for "
^DIC(9.4,60,22,13,"PAH",625,1,1204,0)="         the eRx Pending Order.  "
^DIC(9.4,60,22,13,"PAH",625,1,1205,0)="       - If the CMOP Transmission status for the Last Fill is TRANSMITTED or"
^DIC(9.4,60,22,13,"PAH",625,1,1206,0)="         RE-TRANSMITTED, the Fill Date for the eRx Pending Order will be"
^DIC(9.4,60,22,13,"PAH",625,1,1207,0)="         today's date + Days Supply for the Suspended fill.  "
^DIC(9.4,60,22,13,"PAH",625,1,1208,0)="       - If Last Fill is Suspended with a future Fill Date this future date"
^DIC(9.4,60,22,13,"PAH",625,1,1209,0)="         will be suggested as the Fill Date for the eRx Pending Order.  "
^DIC(9.4,60,22,13,"PAH",625,1,1210,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1211,0)="52.Added three (3) Remove Reason codes to the ERX SERVICE REASON CODES "
^DIC(9.4,60,22,13,"PAH",625,1,1212,0)="   FILE #52.45."
^DIC(9.4,60,22,13,"PAH",625,1,1213,0)="   -----------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,1214,0)="   The three codes are:"
^DIC(9.4,60,22,13,"PAH",625,1,1215,0)="   REM81       Prior Authorization Denied"
^DIC(9.4,60,22,13,"PAH",625,1,1216,0)="   REM82       No Community Care Authorization for this Prescription"
^DIC(9.4,60,22,13,"PAH",625,1,1217,0)="   REM83       Patient Not Found in Local VA Database"
^DIC(9.4,60,22,13,"PAH",625,1,1218,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1219,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,1220,0)="Test Sites: "
^DIC(9.4,60,22,13,"PAH",625,1,1221,0)="----------"
^DIC(9.4,60,22,13,"PAH",625,1,1222,0)="Central Texas VAMC, Temple TX"
^DIC(9.4,60,22,13,"PAH",625,1,1223,0)="Meds-By-Mail"
^DIC(9.4,60,22,13,"PAH",626,0)="772 SEQ #655^3250804.10304^90"
^DIC(9.4,60,22,13,"PAH",626,1,0)="^^239^239^3250804"
^DIC(9.4,60,22,13,"PAH",626,1,1,0)="--------------------------------------------------------------------- "
^DIC(9.4,60,22,13,"PAH",626,1,2,0)="POP-10707 4.2A: Add Baseline Standard Version to View/Edit ASAP"
^DIC(9.4,60,22,13,"PAH",626,1,3,0)="Definitions Option"
^DIC(9.4,60,22,13,"PAH",626,1,4,0)="-----------------------------------------------------------------------"
