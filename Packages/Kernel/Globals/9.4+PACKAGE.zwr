^DIC(9.4,167,22,1,"PAH",1,1,0)="^^1^1^2981112"
^DIC(9.4,167,22,1,"PAH",1,1,1,0)="See Patch Description for details."
^DIC(9.4,167,22,1,"PAH",2,0)="2^2990201^1"
^DIC(9.4,167,22,1,"PAH",3,0)="3 SEQ #3^2990803^1"
^DIC(9.4,167,22,1,"PAH",3,1,0)="^^1^1^2990803"
^DIC(9.4,167,22,1,"PAH",3,1,1,0)="Editing and Address Issues"
^DIC(9.4,167,22,1,"PAH",4,0)="4 SEQ #4^3000125^1"
^DIC(9.4,167,22,1,"PAH",4,1,0)="^^1^1^3000125"
^DIC(9.4,167,22,1,"PAH",4,1,1,0)="PRINTING ISSUE"
^DIC(9.4,167,22,1,"PAH",5,0)="5 SEQ #5^3000125^1"
^DIC(9.4,167,22,1,"PAH",5,1,0)="^^3^3^3000125"
^DIC(9.4,167,22,1,"PAH",5,1,1,0)="Modifcations for the National Database project as well as modifications "
^DIC(9.4,167,22,1,"PAH",5,1,2,0)="needed to implement the NDB project reporting requirements and other "
^DIC(9.4,167,22,1,"PAH",5,1,3,0)="NOIS and E3R's"
^DIC(9.4,167,22,1,"PAH",6,0)="9 SEQ #6^3000229^1"
^DIC(9.4,167,22,1,"PAH",6,1,0)="^^1^1^3000229"
^DIC(9.4,167,22,1,"PAH",6,1,1,0)="Print Log from Union Menu Correction"
^DIC(9.4,167,22,1,"PAH",7,0)="7 SEQ #7^3000405^1"
^DIC(9.4,167,22,1,"PAH",7,1,0)="^^1^1^3000405"
^DIC(9.4,167,22,1,"PAH",7,1,1,0)="Multifacility Enhancements"
^DIC(9.4,167,22,1,"PAH",8,0)="6 SEQ #8^3000501^1"
^DIC(9.4,167,22,1,"PAH",9,0)="8 SEQ #9^3010529^1"
^DIC(9.4,167,22,1,"PAH",9,1,0)="^^3^3^3010529"
^DIC(9.4,167,22,1,"PAH",9,1,1,0)="This patch contains modifications for the Electronic submission of CA1/CA2"
^DIC(9.4,167,22,1,"PAH",9,1,2,0)="Claims to the Department of Labor (DOL) via the Austin Automation Center (AAC)."
^DIC(9.4,167,22,1,"PAH",9,1,3,0)="This is patch OOPS*1.0*8"
^DIC(9.4,167,22,1,"PAH",10,0)="10 SEQ #10^3010529^1"
^DIC(9.4,167,22,1,"PAH",10,1,0)="^^6^6^3010529"
^DIC(9.4,167,22,1,"PAH",10,1,1,0)="This patch contains 2 enhancements and date error checking."
^DIC(9.4,167,22,1,"PAH",10,1,2,0)=""
^DIC(9.4,167,22,1,"PAH",10,1,3,0)="This patch contains enhancements requested by union representatives to assure"
^DIC(9.4,167,22,1,"PAH",10,1,4,0)="that employees have read and understood the employee bill of rights and to "
^DIC(9.4,167,22,1,"PAH",10,1,5,0)="send a bulletin to the union with additional incident information provided the"
^DIC(9.4,167,22,1,"PAH",10,1,6,0)="employee has provided their consent."
^DIC(9.4,167,22,1,"PAH",11,0)="11 SEQ #11^3010906^1"
^DIC(9.4,167,22,1,"PAH",11,1,0)="^^2^2^3010906"
^DIC(9.4,167,22,1,"PAH",11,1,1,0)="This patch contains the enhancements required to implement the Needlestick"
^DIC(9.4,167,22,1,"PAH",11,1,2,0)="Act (HR 5178) in ASISTS."
^DIC(9.4,167,22,1,"PAH",12,0)="12 SEQ #12^3011106^1"
^DIC(9.4,167,22,1,"PAH",12,1,0)="^^3^3^3011106"
^DIC(9.4,167,22,1,"PAH",12,1,1,0)="This patch contains changes to the OOPS DOL MANUAL XMIT DATA, "
^DIC(9.4,167,22,1,"PAH",12,1,2,0)="ASISTS OWCP CHARGEBACK CODES File(#2263.6) and National Data Base "
^DIC(9.4,167,22,1,"PAH",12,1,3,0)="transmission routines OOPSNDB and OOPSNDBX."
