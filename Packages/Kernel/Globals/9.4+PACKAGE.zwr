^DIC(9.4,85,22,1.5,"PAH",4,1,87,0)=" "
^DIC(9.4,85,22,1.5,"PAH",4,1,88,0)=" "
^DIC(9.4,85,22,1.5,"PAH",4,1,89,0)="."
