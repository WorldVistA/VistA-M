^DIC(9.4,48,22,5.28,"PAH",641,1,6,0)="VSE-4496: AP - VistA: Modify SDES CREATE APPOINTMENTS to not allow"
^DIC(9.4,48,22,5.28,"PAH",641,1,7,0)="          creation of appointment from a dispositioned appointment request"
^DIC(9.4,48,22,5.28,"PAH",641,1,8,0)="VSE-4961: BB - VistA: Remove the lock on Clinics when trying to schedule "
^DIC(9.4,48,22,5.28,"PAH",641,1,9,0)="          appointments"
^DIC(9.4,48,22,5.28,"PAH",641,1,10,0)="VSE-5038: BF - VistA: Modify SDBUILD to not allow a user to delete clinic "
^DIC(9.4,48,22,5.28,"PAH",641,1,11,0)="          availability if there are existing appointments"
^DIC(9.4,48,22,5.28,"PAH",641,1,12,0)="          *** SD*5.3*843 v4 - Deployed to revert to a Pre-843 status. ***"
^DIC(9.4,48,22,5.28,"PAH",641,1,13,0)="VSE-5100: JS - VistA: Close open requests for deceased veterans"
^DIC(9.4,48,22,5.28,"PAH",641,1,14,0)="VSE-5109: MD - VistA: Modify SDES CREATE VET SCHED APPT to set the request"
^DIC(9.4,48,22,5.28,"PAH",641,1,15,0)="          institution to the clinic institution"
^DIC(9.4,48,22,5.28,"PAH",641,1,16,0)="VSE-5160: JS - I-0001568 VistA Option for Open Veteran Requests"
^DIC(9.4,48,22,5.28,"PAH",641,1,17,0)="VSE-5163: BB - VistA: Modify SDES CREATE APPOINTMENTS to set the Mission"
^DIC(9.4,48,22,5.28,"PAH",641,1,18,0)="          Act Eligible flag  "
^DIC(9.4,48,22,5.28,"PAH",641,1,19,0)="VSE-5170: AP - VistA: Update SDES GET PATIENT FLAGS to return only flags "
^DIC(9.4,48,22,5.28,"PAH",641,1,20,0)="          in active status"
^DIC(9.4,48,22,5.28,"PAH",641,1,21,0)="VSE-5180: BB - VistA: Modify SDES PATIENT SEARCH RPC to return Local, "
^DIC(9.4,48,22,5.28,"PAH",641,1,22,0)="          National, and Sensitive Patient flags"
^DIC(9.4,48,22,5.28,"PAH",641,1,23,0)="VSE-5189: LB - VistA: Modify SDES EDIT CLINIC AVAILABILITY to return an"
^DIC(9.4,48,22,5.28,"PAH",641,1,24,0)="          error if the user does not enter a date"
^DIC(9.4,48,22,5.28,"PAH",641,1,25,0)="VSE-5281: JS - VistA: Add EAS Tracking Number to the appointment request "
^DIC(9.4,48,22,5.28,"PAH",641,1,26,0)="          object for consults"
^DIC(9.4,48,22,5.28,"PAH",641,1,27,0)="VSE-5282: BF - VistA: Modify SDES GET MISSION ACT ELIG RPC to point to "
^DIC(9.4,48,22,5.28,"PAH",641,1,28,0)="          SDESMISSIONELG"
^DIC(9.4,48,22,5.28,"PAH",641,1,29,0)="VSE-5249: LB - RTC order in CPRS has been discontinued by Provider and "
^DIC(9.4,48,22,5.28,"PAH",641,1,30,0)="          the RTC remains in VSE"
^DIC(9.4,48,22,5.28,"PAH",641,1,31,0)="VSE-5339: LB - VistA: VetText & TMP: Check the Validation of the "
^DIC(9.4,48,22,5.28,"PAH",641,1,32,0)="          Appointment Request"
^DIC(9.4,48,22,5.28,"PAH",641,1,33,0)="VSE-5451: LB - VistA: Block & Move of Recall Appointment returns invalid "
^DIC(9.4,48,22,5.28,"PAH",641,1,34,0)="          appointment type"
^DIC(9.4,48,22,5.28,"PAH",641,1,35,0)="VSE-5455: LB - VistA: VistA: Create a post install routine to report on "
