^DIC(9.4,3,22,21,"PAH",132,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,20,0)="Checksums:   CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",132,1,21,0)="=========="
^DIC(9.4,3,22,21,"PAH",132,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,23,0)="Rtn Nm    Chksum Before     Chksum After          Patch List"
^DIC(9.4,3,22,21,"PAH",132,1,24,0)="===================================================================="
^DIC(9.4,3,22,21,"PAH",132,1,25,0)="XQALERT1       30892967         30893715       20,65,114,123,125"
^DIC(9.4,3,22,21,"PAH",132,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,28,0)="Installation Instruction:"
^DIC(9.4,3,22,21,"PAH",132,1,29,0)="========================"
^DIC(9.4,3,22,21,"PAH",132,1,30,0)="1. Users are allowed to be on the system during the Installation."
^DIC(9.4,3,22,21,"PAH",132,1,31,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,32,0)="2. Routine mapping is NOT recommended for these routines.  If you"
^DIC(9.4,3,22,21,"PAH",132,1,33,0)="are using routine mapping, review your mapped set and ensure that"
^DIC(9.4,3,22,21,"PAH",132,1,34,0)="these routines are NOT in your mapped routine set before proceeding"
^DIC(9.4,3,22,21,"PAH",132,1,35,0)="and rebuild your map set afterward before reactivating TaskMan."
^DIC(9.4,3,22,21,"PAH",132,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,37,0)="3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,3,22,21,"PAH",132,1,38,0)="loads the patch into a Transport Global onto your system."
^DIC(9.4,3,22,21,"PAH",132,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,40,0)="4. You Do Not need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",132,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,43,0)="5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,3,22,21,"PAH",132,1,44,0)="   following options to install the Transport Global:"
^DIC(9.4,3,22,21,"PAH",132,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,46,0)="  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",132,1,47,0)="  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",132,1,48,0)="  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",132,1,49,0)="  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",132,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,51,0)="  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",132,1,52,0)="             INSTALL NAME:  XU*8.0*164"
^DIC(9.4,3,22,21,"PAH",132,1,53,0)="                            =========="
^DIC(9.4,3,22,21,"PAH",132,1,54,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,55,0)="  Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",132,1,56,0)="                                                        =="
^DIC(9.4,3,22,21,"PAH",132,1,57,0)="  Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,3,22,21,"PAH",132,1,58,0)="  Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",132,1,59,0)="                   ==   "
^DIC(9.4,3,22,21,"PAH",132,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,61,0)="6. DSM/AXP Sites - Answer NO to the question ""Want to MOVE routines"
^DIC(9.4,3,22,21,"PAH",132,1,62,0)="   to other CPUs?"""
^DIC(9.4,3,22,21,"PAH",132,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",132,1,64,0)="7. DSM/AXP Sites: If the routines were unmapped per STEP #2, the"
^DIC(9.4,3,22,21,"PAH",132,1,65,0)="   mapped set should be rebuilt once the installation has run to"
^DIC(9.4,3,22,21,"PAH",132,1,66,0)="   completion."
^DIC(9.4,3,22,21,"PAH",133,0)="165 SEQ #139^3000816^1"
^DIC(9.4,3,22,21,"PAH",133,1,0)="^^77^77^3000816"
^DIC(9.4,3,22,21,"PAH",133,1,1,0)="This is the replacement patch for XU*8*138.  If patch XU*8*138 has been loaded"
^DIC(9.4,3,22,21,"PAH",133,1,2,0)="this patch should fix the changes that XU*8*138 made to the cross references"
^DIC(9.4,3,22,21,"PAH",133,1,3,0)="of file 200."
^DIC(9.4,3,22,21,"PAH",133,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,5,0)="This Kernel patch allows users to be validated through the"
^DIC(9.4,3,22,21,"PAH",133,1,6,0)="traditional Access and Verify Codes on their home systems and then carry"
^DIC(9.4,3,22,21,"PAH",133,1,7,0)="that authentication to other systems where they may not be entered in the"
^DIC(9.4,3,22,21,"PAH",133,1,8,0)="New Person File (NPF).  A packet of information is carried with the user"
^DIC(9.4,3,22,21,"PAH",133,1,9,0)="to the system being visited, and that information is then entered in the"
^DIC(9.4,3,22,21,"PAH",133,1,10,0)="NPF so that a trace to the original authentication can be made.  No Access"
^DIC(9.4,3,22,21,"PAH",133,1,11,0)="and Verify codes are, however, entered in the NPF so that the visitor may"
^DIC(9.4,3,22,21,"PAH",133,1,12,0)="not log in.  He or she will only see that information provided by the CPRS"
^DIC(9.4,3,22,21,"PAH",133,1,13,0)="foreign views software.  A bulletin, XUVISIT, will be sent when an entry"
^DIC(9.4,3,22,21,"PAH",133,1,14,0)="is made in the New person File if the site has assigned a valid mail group"
^DIC(9.4,3,22,21,"PAH",133,1,15,0)="to the bulletin.  The software defines a new multiple in the NPF called"
^DIC(9.4,3,22,21,"PAH",133,1,16,0)="""VISITED FROM"" which stores the information brought from the home system."
^DIC(9.4,3,22,21,"PAH",133,1,17,0)="There is a new SORT and PRINT template to show NPF entries that have been"
^DIC(9.4,3,22,21,"PAH",133,1,18,0)="VISITORS to a site.  XUS VISIT USER."
^DIC(9.4,3,22,21,"PAH",133,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,20,0)="The Sign-on log has new fields to record the remote site and remote ien of a"
^DIC(9.4,3,22,21,"PAH",133,1,21,0)="visitor.  A new Print template XUSEC REMOTE ACCESS and sort template "
^DIC(9.4,3,22,21,"PAH",133,1,22,0)="XUSEC REMOTE ACCESS to print just entries from remote users."
^DIC(9.4,3,22,21,"PAH",133,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,24,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",133,1,25,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",133,1,26,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",133,1,27,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",133,1,28,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,29,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",133,1,30,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",133,1,31,0)="XUESSO1           n/a   4118958    **165**"
^DIC(9.4,3,22,21,"PAH",133,1,32,0)="XUS1         10153593  10540362    **9,59,111,165**"
^DIC(9.4,3,22,21,"PAH",133,1,33,0)="XUSCLEAN      6583467   6966234    **13,59,165**"
^DIC(9.4,3,22,21,"PAH",133,1,34,0)="XUSRB         5880708   6041270    **11,16,28,32,59,70,82,109,115,165**"
^DIC(9.4,3,22,21,"PAH",133,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,36,0)="List of preceding patches: 111, 115"
^DIC(9.4,3,22,21,"PAH",133,1,37,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",133,1,38,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,39,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",133,1,40,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",133,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,42,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",133,1,43,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,44,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",133,1,45,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",133,1,46,0)="     "
^DIC(9.4,3,22,21,"PAH",133,1,47,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",133,1,48,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",133,1,49,0)="     "
^DIC(9.4,3,22,21,"PAH",133,1,50,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",133,1,51,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",133,1,52,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",133,1,53,0)="      options:"
^DIC(9.4,3,22,21,"PAH",133,1,54,0)="      "
^DIC(9.4,3,22,21,"PAH",133,1,55,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",133,1,56,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",133,1,57,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",133,1,58,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",133,1,59,0)="     "
^DIC(9.4,3,22,21,"PAH",133,1,60,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",133,1,61,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",133,1,62,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",133,1,63,0)="      With the Users on the system there is a small chance that a user would"
^DIC(9.4,3,22,21,"PAH",133,1,64,0)="      get a CLOBER/NOSOURCE error."
^DIC(9.4,3,22,21,"PAH",133,1,65,0)=""
^DIC(9.4,3,22,21,"PAH",133,1,66,0)="     "
^DIC(9.4,3,22,21,"PAH",133,1,67,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",133,1,68,0)="      option:"
^DIC(9.4,3,22,21,"PAH",133,1,69,0)="        Install Package(s)  'XU*8.0*165'"
^DIC(9.4,3,22,21,"PAH",133,1,70,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",133,1,71,0)="                             "
^DIC(9.4,3,22,21,"PAH",133,1,72,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",133,1,73,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",133,1,74,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",133,1,75,0)="     "
^DIC(9.4,3,22,21,"PAH",133,1,76,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",133,1,77,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",134,0)="159 SEQ #141^3000816^1"
^DIC(9.4,3,22,21,"PAH",135,0)="163 SEQ #142^3000816^1"
^DIC(9.4,3,22,21,"PAH",135,1,0)="^^88^88^3000816"
^DIC(9.4,3,22,21,"PAH",135,1,1,0)="1.  HOU-1099-72362."
^DIC(9.4,3,22,21,"PAH",135,1,2,0)="    Option SYNC FLAG FILE CONTROL [XUTM SYNC] does not appear to allow"
^DIC(9.4,3,22,21,"PAH",135,1,3,0)="    users to remove old entries in the Task SYNC FLAG file ^%ZISL(14.8,."
^DIC(9.4,3,22,21,"PAH",135,1,4,0)="    Routine ZTMS2 and XUTMSYNC has been revised to correct this problem. "
^DIC(9.4,3,22,21,"PAH",135,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,7,0)="Test Sites:"
^DIC(9.4,3,22,21,"PAH",135,1,8,0)="==========="
^DIC(9.4,3,22,21,"PAH",135,1,9,0)="Houston, TX  -  580"
^DIC(9.4,3,22,21,"PAH",135,1,10,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,12,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",135,1,13,0)="================"
^DIC(9.4,3,22,21,"PAH",135,1,14,0)="The following routine(s) are included in this patch.  The second line of"
^DIC(9.4,3,22,21,"PAH",135,1,15,0)="each routine will look like:"
^DIC(9.4,3,22,21,"PAH",135,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,17,0)="            <tab>;;8.0;KERNEL;**[Patch List]**;07/10/95"
^DIC(9.4,3,22,21,"PAH",135,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,19,0)="Checksums:   CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",135,1,20,0)="=========="
^DIC(9.4,3,22,21,"PAH",135,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,22,0)="Rtn Nm    Chksum Before     Chksum After          Patch List"
^DIC(9.4,3,22,21,"PAH",135,1,23,0)="===================================================================="
^DIC(9.4,3,22,21,"PAH",135,1,24,0)="ZTMS2           5847661     6602171        2,18,23,36,67,118,127,163"
^DIC(9.4,3,22,21,"PAH",135,1,25,0)="XUTMSYNC         655698      655786                  163"
^DIC(9.4,3,22,21,"PAH",135,1,26,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,28,0)="Installation Instruction:"
^DIC(9.4,3,22,21,"PAH",135,1,29,0)="========================"
^DIC(9.4,3,22,21,"PAH",135,1,30,0)="1. Users are allowed to be on the system during the Installation."
^DIC(9.4,3,22,21,"PAH",135,1,31,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,32,0)="2. Routine mapping is NOT recommended for these routines.  If you"
^DIC(9.4,3,22,21,"PAH",135,1,33,0)="are using routine mapping, review your mapped set and ensure that"
^DIC(9.4,3,22,21,"PAH",135,1,34,0)="these routines are NOT in your mapped routine set before proceeding"
^DIC(9.4,3,22,21,"PAH",135,1,35,0)="and rebuild your map set afterward before reactivating TaskMan."
^DIC(9.4,3,22,21,"PAH",135,1,36,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,37,0)="3. Use the ""INSTALL/CHECK MESSAGE"" option on the PackMan menu.  This"
^DIC(9.4,3,22,21,"PAH",135,1,38,0)="loads the patch into a Transport Global onto your system."
^DIC(9.4,3,22,21,"PAH",135,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,40,0)="4. STOP TASKMAN and STOP other background filers.  ""DO STOP^ZTMKU"""
^DIC(9.4,3,22,21,"PAH",135,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,43,0)="5. On the KIDS menu, select the ""Installation"" menu and use the"
^DIC(9.4,3,22,21,"PAH",135,1,44,0)="   following options to install the Transport Global:"
^DIC(9.4,3,22,21,"PAH",135,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,46,0)="  Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",135,1,47,0)="  Print Transport Global"
^DIC(9.4,3,22,21,"PAH",135,1,48,0)="  Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",135,1,49,0)="  Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",135,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,51,0)="  Install Package(s)"
^DIC(9.4,3,22,21,"PAH",135,1,52,0)="             INSTALL NAME:  XU*8.0*163"
^DIC(9.4,3,22,21,"PAH",135,1,53,0)="                            =========="
^DIC(9.4,3,22,21,"PAH",135,1,54,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,55,0)="  Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",135,1,56,0)="                                                        =="
^DIC(9.4,3,22,21,"PAH",135,1,57,0)="  Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,3,22,21,"PAH",135,1,58,0)="  Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",135,1,59,0)="                   ==   "
^DIC(9.4,3,22,21,"PAH",135,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,61,0)="6. DSM/AXP Sites - Answer NO to the question ""Want to MOVE routines"
^DIC(9.4,3,22,21,"PAH",135,1,62,0)="   to other CPUs?"""
^DIC(9.4,3,22,21,"PAH",135,1,63,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,64,0)="7. DSM/AXP Sites: If the routines were unmapped per STEP #2, the"
^DIC(9.4,3,22,21,"PAH",135,1,65,0)="   mapped set should be rebuilt once the installation has run to"
^DIC(9.4,3,22,21,"PAH",135,1,66,0)="   completion."
^DIC(9.4,3,22,21,"PAH",135,1,67,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,68,0)="8. After installing this patch:"
^DIC(9.4,3,22,21,"PAH",135,1,69,0)="   OpenM Sites - you donot need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",135,1,70,0)="   DSM/MSM Sites - you need to move a total of 1 routine from your"
^DIC(9.4,3,22,21,"PAH",135,1,71,0)="   production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",135,1,72,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,73,0)="   ZTMS2"
^DIC(9.4,3,22,21,"PAH",135,1,74,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,75,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,76,0)="9. And in the manager account,  (Openm sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",135,1,77,0)="   all sites:"
^DIC(9.4,3,22,21,"PAH",135,1,78,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,79,0)="   DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",135,1,80,0)="   Select the System"
^DIC(9.4,3,22,21,"PAH",135,1,81,0)="   Patch number to load: 163"
^DIC(9.4,3,22,21,"PAH",135,1,82,0)="                         ==="
^DIC(9.4,3,22,21,"PAH",135,1,83,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,84,0)="10.DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",135,1,85,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,86,0)=" "
^DIC(9.4,3,22,21,"PAH",135,1,87,0)="11.Restart TASKMAN with ""D RESTART^ZTMB.  DSM sites this may"
^DIC(9.4,3,22,21,"PAH",135,1,88,0)="   require a privileged user."
^DIC(9.4,3,22,21,"PAH",136,0)="166 SEQ #143^3000816^1"
^DIC(9.4,3,22,21,"PAH",136,1,0)="^^60^60^3000816"
^DIC(9.4,3,22,21,"PAH",136,1,1,0)="In working with the RAI/MDS folks a problem was found in how the FMTHL7"
^DIC(9.4,3,22,21,"PAH",136,1,2,0)="and HL7TFM API's of XLFDT worked.  This has been fixed."
^DIC(9.4,3,22,21,"PAH",136,1,3,0)="FM stores midnight as 3000803.24 and HL7 standard requires it to be sent"
^DIC(9.4,3,22,21,"PAH",136,1,4,0)="as 200008040000-0800  i.e. Midnight of the night extending from Aug 3 to"
^DIC(9.4,3,22,21,"PAH",136,1,5,0)="Aug 4, 2000. "
^DIC(9.4,3,22,21,"PAH",136,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,7,0)="Also a new routine XLFCRC to compute CRC's, both 16 and 32 bit."
^DIC(9.4,3,22,21,"PAH",136,1,8,0)="See DBIA 3156 for details."
^DIC(9.4,3,22,21,"PAH",136,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,10,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",136,1,11,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",136,1,12,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",136,1,13,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",136,1,14,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,15,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",136,1,16,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",136,1,17,0)="XLFCRC            n/a    568962    **166**"
^DIC(9.4,3,22,21,"PAH",136,1,18,0)="XLFDT         4050775   4352260    **71,120,166**"
^DIC(9.4,3,22,21,"PAH",136,1,19,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,20,0)="List of preceding patches: 120"
^DIC(9.4,3,22,21,"PAH",136,1,21,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",136,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,23,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",136,1,24,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",136,1,25,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,26,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",136,1,27,0)=">>>Taskman may remain running."
^DIC(9.4,3,22,21,"PAH",136,1,28,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,29,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",136,1,30,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",136,1,31,0)="     "
^DIC(9.4,3,22,21,"PAH",136,1,32,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",136,1,33,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",136,1,34,0)="     "
^DIC(9.4,3,22,21,"PAH",136,1,35,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",136,1,36,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",136,1,37,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",136,1,38,0)="      options:"
^DIC(9.4,3,22,21,"PAH",136,1,39,0)="      "
^DIC(9.4,3,22,21,"PAH",136,1,40,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",136,1,41,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",136,1,42,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",136,1,43,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",136,1,44,0)="     "
^DIC(9.4,3,22,21,"PAH",136,1,45,0)="  4.  Users can remain on the system."
^DIC(9.4,3,22,21,"PAH",136,1,46,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",136,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",136,1,48,0)="     "
^DIC(9.4,3,22,21,"PAH",136,1,49,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",136,1,50,0)="      option:"
^DIC(9.4,3,22,21,"PAH",136,1,51,0)="        Install Package(s)  'XU*8.0*166'"
^DIC(9.4,3,22,21,"PAH",136,1,52,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",136,1,53,0)="                             "
^DIC(9.4,3,22,21,"PAH",136,1,54,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",136,1,55,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",136,1,56,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",136,1,57,0)="     "
^DIC(9.4,3,22,21,"PAH",136,1,58,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",136,1,59,0)="  "
^DIC(9.4,3,22,21,"PAH",136,1,60,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",137,0)="167 SEQ #144^3000816^1"
^DIC(9.4,3,22,21,"PAH",138,0)="151 SEQ #145^3000824^1"
^DIC(9.4,3,22,21,"PAH",138,1,0)="^^66^66^3000824"
^DIC(9.4,3,22,21,"PAH",138,1,1,0)="IVM-0400-31566"
^DIC(9.4,3,22,21,"PAH",138,1,2,0)="An option queued in the option scheduling file that didn't have a "
^DIC(9.4,3,22,21,"PAH",138,1,3,0)="rescheduling frequency would not have the ZTQPARAM variable or other "
^DIC(9.4,3,22,21,"PAH",138,1,4,0)="parameters available. This was because the entry was deleted from the "
^DIC(9.4,3,22,21,"PAH",138,1,5,0)="option schedule file before the variables were set-up.  The fix was to set-"
^DIC(9.4,3,22,21,"PAH",138,1,6,0)="up the variables first."
^DIC(9.4,3,22,21,"PAH",138,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,8,0)="It has been found in testing at Bay Pines that if the call to the DNS times "
^DIC(9.4,3,22,21,"PAH",138,1,9,0)="out the XLFNSLK routine fails to close the device used to call the DNS. "
^DIC(9.4,3,22,21,"PAH",138,1,10,0)="This causes the calling routine to get an error.  Fix to see that on a time-"
^DIC(9.4,3,22,21,"PAH",138,1,11,0)="out the device is closed."
^DIC(9.4,3,22,21,"PAH",138,1,12,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,13,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",138,1,14,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",138,1,15,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",138,1,16,0)=" ;;8.0;KERNEL;<patchlist>;June 25, 1999"
^DIC(9.4,3,22,21,"PAH",138,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,18,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",138,1,19,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",138,1,20,0)="XLFNSLK       7523173   7558282    **142,151**"
^DIC(9.4,3,22,21,"PAH",138,1,21,0)="XQ1          11958439  11902300    **1,15,59,67,46,151**"
^DIC(9.4,3,22,21,"PAH",138,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,23,0)="List of preceding patches: 46, 142"
^DIC(9.4,3,22,21,"PAH",138,1,24,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",138,1,25,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,26,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",138,1,27,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",138,1,28,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,29,0)=">>>Do not allow users to log in to the system during installation."
^DIC(9.4,3,22,21,"PAH",138,1,30,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,31,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",138,1,32,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",138,1,33,0)="     "
^DIC(9.4,3,22,21,"PAH",138,1,34,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",138,1,35,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",138,1,36,0)="     "
^DIC(9.4,3,22,21,"PAH",138,1,37,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",138,1,38,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",138,1,39,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",138,1,40,0)="      options:"
^DIC(9.4,3,22,21,"PAH",138,1,41,0)="      "
^DIC(9.4,3,22,21,"PAH",138,1,42,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",138,1,43,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",138,1,44,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",138,1,45,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",138,1,46,0)="     "
^DIC(9.4,3,22,21,"PAH",138,1,47,0)="  4.  Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",138,1,48,0)="      users are on the system and the possibility of some CLOBER/NOSOURCE"
^DIC(9.4,3,22,21,"PAH",138,1,49,0)="      errors is acceptable, then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",138,1,50,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",138,1,51,0)="      Option: Place Taskman in a WAIT State"
^DIC(9.4,3,22,21,"PAH",138,1,52,0)="     "
^DIC(9.4,3,22,21,"PAH",138,1,53,0)="  5.  Use ""D ^XPDKRN"" then:"
^DIC(9.4,3,22,21,"PAH",138,1,54,0)="        Install Package(s)  'XU*8.0*151'"
^DIC(9.4,3,22,21,"PAH",138,1,55,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",138,1,56,0)="                             "
^DIC(9.4,3,22,21,"PAH",138,1,57,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",138,1,58,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",138,1,59,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",138,1,60,0)="     "
^DIC(9.4,3,22,21,"PAH",138,1,61,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",138,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",138,1,63,0)="  7.  Allow users to sign-on."
^DIC(9.4,3,22,21,"PAH",138,1,64,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",138,1,65,0)="      Option: Remove Taskman from WAIT State"
^DIC(9.4,3,22,21,"PAH",138,1,66,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",139,0)="162 SEQ #146^3000905^1"
^DIC(9.4,3,22,21,"PAH",139,1,0)="^^108^108^3000905"
^DIC(9.4,3,22,21,"PAH",139,1,1,0)="*** Note there are routines that need to moved as part of this patch."
^DIC(9.4,3,22,21,"PAH",139,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",139,1,3,0)=" BRX-0999-10965  The error trap doesn't record any data for stack overflow"
^DIC(9.4,3,22,21,"PAH",139,1,4,0)="                 of allocation errors.  Before on a allocation error"
^DIC(9.4,3,22,21,"PAH",139,1,5,0)="                 we would call the M vendors error trap.  The current "
^DIC(9.4,3,22,21,"PAH",139,1,6,0)="                 vendors error trap tries to set variables and also gets"
^DIC(9.4,3,22,21,"PAH",139,1,7,0)="                 an error.  The fix to this problem was to do a exclusive"
^DIC(9.4,3,22,21,"PAH",139,1,8,0)="                 kill to get some room and then record the error."
^DIC(9.4,3,22,21,"PAH",139,1,9,0)="                 For stack overflow error we pop the stack back 8"
^DIC(9.4,3,22,21,"PAH",139,1,10,0)="                 levels so we have some room for our DO's."
^DIC(9.4,3,22,21,"PAH",139,1,11,0)="                 "
^DIC(9.4,3,22,21,"PAH",139,1,12,0)="BAY-0600-31579   When adding a HUNT GROUP device to the IO queue the"
^DIC(9.4,3,22,21,"PAH",139,1,13,0)="MIN-0600-41387   device type wasn't added at the top level.  This would"
^DIC(9.4,3,22,21,"PAH",139,1,14,0)="                 cause errors at I2+2^%ZTMS1.  Fixed to set the correct"
^DIC(9.4,3,22,21,"PAH",139,1,15,0)="                 node.  ZTM4"
^DIC(9.4,3,22,21,"PAH",139,1,16,0)="                 "
^DIC(9.4,3,22,21,"PAH",139,1,17,0)="ISL-1199-51207   When trying to restore the variables on a Cache system"
^DIC(9.4,3,22,21,"PAH",139,1,18,0)="                 XTER2 would get an error.  The special Cache data item"
^DIC(9.4,3,22,21,"PAH",139,1,19,0)="                 from $ZU(56) is stored.  This was fixed by changing the"
^DIC(9.4,3,22,21,"PAH",139,1,20,0)="                 name from OpenM_ZU to $ZU(... then %ZTER saves it because "
^DIC(9.4,3,22,21,"PAH",139,1,21,0)="                 XTER2 already knows not to restore anything that starts "
^DIC(9.4,3,22,21,"PAH",139,1,22,0)="                 with a ""$""."
^DIC(9.4,3,22,21,"PAH",139,1,23,0)="                 "
^DIC(9.4,3,22,21,"PAH",139,1,24,0)="NVS call         The new Taskman parameter Balance interval was not getting"
^DIC(9.4,3,22,21,"PAH",139,1,25,0)="                 picked up correctly.  Fixed to get the right data. ZTM5"
^DIC(9.4,3,22,21,"PAH",139,1,26,0)="                 "
^DIC(9.4,3,22,21,"PAH",139,1,27,0)="Request from the Mailman developer to save off data in ZTLOAD so user can"
^DIC(9.4,3,22,21,"PAH",139,1,28,0)="queue reports to p-message.  Change to ZTLOAD1."
^DIC(9.4,3,22,21,"PAH",139,1,29,0)="    "
^DIC(9.4,3,22,21,"PAH",139,1,30,0)="For standard VA systems the new routine ZUSET will rename the correct ZU*"
^DIC(9.4,3,22,21,"PAH",139,1,31,0)="routine to ZU for the site."
^DIC(9.4,3,22,21,"PAH",139,1,32,0)="             "
^DIC(9.4,3,22,21,"PAH",139,1,33,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",139,1,34,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",139,1,35,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",139,1,36,0)=" ;;8.0;KERNEL;<patchlist>;JUL 10, 1995"
^DIC(9.4,3,22,21,"PAH",139,1,37,0)=""
^DIC(9.4,3,22,21,"PAH",139,1,38,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",139,1,39,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",139,1,40,0)="ZTER         18980475  18198227    **8,18,32,24,36,63,73,79,86,112,118,162**"
^DIC(9.4,3,22,21,"PAH",139,1,41,0)="ZTER1         4369079   4369129    **18,24,36,49,112,162**"
^DIC(9.4,3,22,21,"PAH",139,1,42,0)="ZTLOAD1       6808427   6923394    **112,118,127,162**"
^DIC(9.4,3,22,21,"PAH",139,1,43,0)="ZTM4          2164226   2223405    **1,118,127,162**"
^DIC(9.4,3,22,21,"PAH",139,1,44,0)="ZTM5          4417939   4418054    **24,36,118,127,136,162**"
^DIC(9.4,3,22,21,"PAH",139,1,45,0)="ZTMS          5488776   5607220    **2,18,24,36,67,94,118,127,136,162**"
^DIC(9.4,3,22,21,"PAH",139,1,46,0)="ZUMSM         3349196   3457106    **13,42,49,94,107,162**"
^DIC(9.4,3,22,21,"PAH",139,1,47,0)="ZUONT         1992793   2038011    **34,94,118,162**"
^DIC(9.4,3,22,21,"PAH",139,1,48,0)="ZUSET             n/a    751876    **162**"
^DIC(9.4,3,22,21,"PAH",139,1,49,0)="ZUVXD         4517687   4620305    **13,24,84,94,118,162**"
^DIC(9.4,3,22,21,"PAH",139,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",139,1,51,0)="List of preceding patches: 107, 118, 136"
^DIC(9.4,3,22,21,"PAH",139,1,52,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",139,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",139,1,54,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",139,1,55,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",139,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",139,1,57,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",139,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",139,1,59,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",139,1,60,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",139,1,61,0)="     "
^DIC(9.4,3,22,21,"PAH",139,1,62,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",139,1,63,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",139,1,64,0)="     "
^DIC(9.4,3,22,21,"PAH",139,1,65,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",139,1,66,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",139,1,67,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",139,1,68,0)="      options:"
^DIC(9.4,3,22,21,"PAH",139,1,69,0)="      "
^DIC(9.4,3,22,21,"PAH",139,1,70,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",139,1,71,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",139,1,72,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",139,1,73,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",139,1,74,0)="     "
^DIC(9.4,3,22,21,"PAH",139,1,75,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",139,1,76,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",139,1,77,0)="      This patch can not be queued. "
^DIC(9.4,3,22,21,"PAH",139,1,78,0)="     "
^DIC(9.4,3,22,21,"PAH",139,1,79,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",139,1,80,0)="      option:"
^DIC(9.4,3,22,21,"PAH",139,1,81,0)="        Install Package(s)  'XU*8.0*162'"
^DIC(9.4,3,22,21,"PAH",139,1,82,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",139,1,83,0)="                             "
^DIC(9.4,3,22,21,"PAH",139,1,84,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",139,1,85,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",139,1,86,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",139,1,87,0)="     "
^DIC(9.4,3,22,21,"PAH",139,1,88,0)="  6.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",139,1,89,0)="      Cache Sites - you don't need to move anything, skip this step. "
^DIC(9.4,3,22,21,"PAH",139,1,90,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",139,1,91,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",139,1,92,0)="      "
^DIC(9.4,3,22,21,"PAH",139,1,93,0)="ZTER"
^DIC(9.4,3,22,21,"PAH",139,1,94,0)="ZTER1"
^DIC(9.4,3,22,21,"PAH",139,1,95,0)="ZTLOAD1"
^DIC(9.4,3,22,21,"PAH",139,1,96,0)="ZTM4"
^DIC(9.4,3,22,21,"PAH",139,1,97,0)="ZTM5"
^DIC(9.4,3,22,21,"PAH",139,1,98,0)="ZTMS"
^DIC(9.4,3,22,21,"PAH",139,1,99,0)="      "
^DIC(9.4,3,22,21,"PAH",139,1,100,0)="  7.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",139,1,101,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",139,1,102,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",139,1,103,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",139,1,104,0)="      Patch number to load: 162"
^DIC(9.4,3,22,21,"PAH",139,1,105,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",139,1,106,0)="       "
^DIC(9.4,3,22,21,"PAH",139,1,107,0)="  8.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",139,1,108,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",140,0)="168 SEQ #147^3001004^1"
^DIC(9.4,3,22,21,"PAH",140,1,0)="^^58^58^3001004"
^DIC(9.4,3,22,21,"PAH",140,1,1,0)="When placed in production the change in HL7 to call the XLFDT routine for "
^DIC(9.4,3,22,21,"PAH",140,1,2,0)="HL7 to FileMan date conversion exposed an existing bug in the HL7TFM code."
^DIC(9.4,3,22,21,"PAH",140,1,3,0)="This patch corrects that problem."
^DIC(9.4,3,22,21,"PAH",140,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,5,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",140,1,6,0)="============================="
^DIC(9.4,3,22,21,"PAH",140,1,7,0)="Clearance - Sept. 7, 2000"
^DIC(9.4,3,22,21,"PAH",140,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,9,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",140,1,10,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",140,1,11,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",140,1,12,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",140,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,14,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",140,1,15,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",140,1,16,0)="XLFDT         4352260   4356861    **71,120,166,168**"
^DIC(9.4,3,22,21,"PAH",140,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,18,0)="List of preceding patches: 166"
^DIC(9.4,3,22,21,"PAH",140,1,19,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",140,1,20,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,21,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",140,1,22,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",140,1,23,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,24,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",140,1,25,0)=">>>Taskman may remain running."
^DIC(9.4,3,22,21,"PAH",140,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,27,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",140,1,28,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",140,1,29,0)="     "
^DIC(9.4,3,22,21,"PAH",140,1,30,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",140,1,31,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",140,1,32,0)="     "
^DIC(9.4,3,22,21,"PAH",140,1,33,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",140,1,34,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",140,1,35,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",140,1,36,0)="      options:"
^DIC(9.4,3,22,21,"PAH",140,1,37,0)="      "
^DIC(9.4,3,22,21,"PAH",140,1,38,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",140,1,39,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",140,1,40,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",140,1,41,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",140,1,42,0)="     "
^DIC(9.4,3,22,21,"PAH",140,1,43,0)="  4.  Users can remain on the system."
^DIC(9.4,3,22,21,"PAH",140,1,44,0)="      This patch can be queued and installed at any time."
^DIC(9.4,3,22,21,"PAH",140,1,45,0)=""
^DIC(9.4,3,22,21,"PAH",140,1,46,0)="     "
^DIC(9.4,3,22,21,"PAH",140,1,47,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",140,1,48,0)="      option:"
^DIC(9.4,3,22,21,"PAH",140,1,49,0)="        Install Package(s)  'XU*8.0*168'"
^DIC(9.4,3,22,21,"PAH",140,1,50,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",140,1,51,0)="                             "
^DIC(9.4,3,22,21,"PAH",140,1,52,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",140,1,53,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",140,1,54,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",140,1,55,0)="     "
^DIC(9.4,3,22,21,"PAH",140,1,56,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",140,1,57,0)="      "
^DIC(9.4,3,22,21,"PAH",140,1,58,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",141,0)="170 SEQ #148^3001004^1"
^DIC(9.4,3,22,21,"PAH",141,1,0)="^^93^93^3001004"
^DIC(9.4,3,22,21,"PAH",141,1,1,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,2,0)="**** Users will need to be off the system during this install ****"
^DIC(9.4,3,22,21,"PAH",141,1,3,0)="**** Taskman will need to be in a wait state during this install ****"
^DIC(9.4,3,22,21,"PAH",141,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,5,0)="                 !!!  WARNING!!!"
^DIC(9.4,3,22,21,"PAH",141,1,6,0)="NT sites need to install patch XU*8*162 and XU*8*170 TOGETHER"
^DIC(9.4,3,22,21,"PAH",141,1,7,0)="Make sure you have Patch XU*8.0*162 and XU*8.0*170 before going any"
^DIC(9.4,3,22,21,"PAH",141,1,8,0)="further. XU*8*162 is required for this patch but there is a problem with"
^DIC(9.4,3,22,21,"PAH",141,1,9,0)="routine ZUONT which has big impact on NT sites. After installing patch"
^DIC(9.4,3,22,21,"PAH",141,1,10,0)="XU*8*162, no users are allowed on the system."
^DIC(9.4,3,22,21,"PAH",141,1,11,0)="To avoid the problem:"
^DIC(9.4,3,22,21,"PAH",141,1,12,0)="Inhibit log on and install patch XU*8.0*162 per instructions make sure you"
^DIC(9.4,3,22,21,"PAH",141,1,13,0)="have a session logged in at programmer mode and immediately install patch"
^DIC(9.4,3,22,21,"PAH",141,1,14,0)="170 per instructions in this patch. Allow users back in the system."
^DIC(9.4,3,22,21,"PAH",141,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,16,0)="CMH-0800-N3105"
^DIC(9.4,3,22,21,"PAH",141,1,17,0)="Patch XU*8*162 made a call to $$AVJ^%ZOSF in place of $$AVJ^%ZOSV in ZUONT."
^DIC(9.4,3,22,21,"PAH",141,1,18,0)="This caused a NOLINE error.  Fixed to make the correct call. This affects "
^DIC(9.4,3,22,21,"PAH",141,1,19,0)="Cache sites only."
^DIC(9.4,3,22,21,"PAH",141,1,20,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,21,0)="MVW-0800-22126, NJH-0800-22956, TAM-0800-32655, CLA-0800-22898"
^DIC(9.4,3,22,21,"PAH",141,1,22,0)="MAC-0900-60221"
^DIC(9.4,3,22,21,"PAH",141,1,23,0)="Patch XU*8*151 did fix the use of the ZTQPARAM variable or other "
^DIC(9.4,3,22,21,"PAH",141,1,24,0)="parameters available if the scheduled option didn't have a re-queue frequence "
^DIC(9.4,3,22,21,"PAH",141,1,25,0)="but if the option was on a schedule it broke the re-schedule.  "
^DIC(9.4,3,22,21,"PAH",141,1,26,0)="This patch fixes the re-scheduling.  As part of the post INIT it will go"
^DIC(9.4,3,22,21,"PAH",141,1,27,0)="thru the Scheduled options (file 19.2) an reschedule any that have a past "
^DIC(9.4,3,22,21,"PAH",141,1,28,0)="date to run."
^DIC(9.4,3,22,21,"PAH",141,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,30,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",141,1,31,0)="============================="
^DIC(9.4,3,22,21,"PAH",141,1,32,0)="Clearance - Sept. 8, 2000"
^DIC(9.4,3,22,21,"PAH",141,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,34,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",141,1,35,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",141,1,36,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",141,1,37,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",141,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,39,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",141,1,40,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",141,1,41,0)="XQ1          11902300  12116128    **1,15,59,67,46,151,170**"
^DIC(9.4,3,22,21,"PAH",141,1,42,0)="XUTMPCH           n/a    930054    **170**"
^DIC(9.4,3,22,21,"PAH",141,1,43,0)="ZUONT         2038011   2038331    **34,94,118,162,170**"
^DIC(9.4,3,22,21,"PAH",141,1,44,0)="ZUSET          751876   1042105    **162,170**"
^DIC(9.4,3,22,21,"PAH",141,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,46,0)="List of preceding patches: 151, 162"
^DIC(9.4,3,22,21,"PAH",141,1,47,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",141,1,48,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,49,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",141,1,50,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",141,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,52,0)=">>>Do not allow users to log in to the system during installation."
^DIC(9.4,3,22,21,"PAH",141,1,53,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,54,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",141,1,55,0)="      so you will need to disable mapping for the affected routines. "
^DIC(9.4,3,22,21,"PAH",141,1,56,0)="     "
^DIC(9.4,3,22,21,"PAH",141,1,57,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",141,1,58,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",141,1,59,0)="     "
^DIC(9.4,3,22,21,"PAH",141,1,60,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",141,1,61,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",141,1,62,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",141,1,63,0)="      options:"
^DIC(9.4,3,22,21,"PAH",141,1,64,0)="      "
^DIC(9.4,3,22,21,"PAH",141,1,65,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",141,1,66,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",141,1,67,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",141,1,68,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",141,1,69,0)="     "
^DIC(9.4,3,22,21,"PAH",141,1,70,0)="  4.  Inhibit users from login into the system. "
^DIC(9.4,3,22,21,"PAH",141,1,71,0)="      Get all current users off the system or they will get an EDITED"
^DIC(9.4,3,22,21,"PAH",141,1,72,0)="      error when they return to the menu system."
^DIC(9.4,3,22,21,"PAH",141,1,73,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",141,1,74,0)="      Stop BACKGROUND task or they will get an EDITED error when done."
^DIC(9.4,3,22,21,"PAH",141,1,75,0)="     "
^DIC(9.4,3,22,21,"PAH",141,1,76,0)="  5.  Use ""D ^XPDKRN"" then:"
^DIC(9.4,3,22,21,"PAH",141,1,77,0)="        Install Package(s)  'XU*8.0*170'"
^DIC(9.4,3,22,21,"PAH",141,1,78,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",141,1,79,0)="                             "
^DIC(9.4,3,22,21,"PAH",141,1,80,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",141,1,81,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",141,1,82,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",141,1,83,0)="                                                                        "
^DIC(9.4,3,22,21,"PAH",141,1,84,0)="        This routine will rename the correct routine to ZU for you."
^DIC(9.4,3,22,21,"PAH",141,1,85,0)="        Rename ZUONT to ZU, OK? No//  >>>>Cache sites answer YES"
^DIC(9.4,3,22,21,"PAH",141,1,86,0)="                                      >>>>DSM sites answer NO"
^DIC(9.4,3,22,21,"PAH",141,1,87,0)="     "
^DIC(9.4,3,22,21,"PAH",141,1,88,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",141,1,89,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,90,0)="  7.  Allow users to sign-on."
^DIC(9.4,3,22,21,"PAH",141,1,91,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",141,1,92,0)=" "
^DIC(9.4,3,22,21,"PAH",141,1,93,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",142,0)="150 SEQ #149^3001012^1"
^DIC(9.4,3,22,21,"PAH",142,1,0)="^^75^75^3001012"
^DIC(9.4,3,22,21,"PAH",142,1,1,0)="This patch is in support of the following Broker NOIS"
^DIC(9.4,3,22,21,"PAH",142,1,2,0)="ISW-1299-21488, ISW-1299-22382"
^DIC(9.4,3,22,21,"PAH",142,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,4,0)="This patch also adds a new field to the new person file under the Division"
^DIC(9.4,3,22,21,"PAH",142,1,5,0)="field.  This new field is Default and is used by the GUI log-on to select"
^DIC(9.4,3,22,21,"PAH",142,1,6,0)="one division to pre-select.  This is only needed for users that have more "
^DIC(9.4,3,22,21,"PAH",142,1,7,0)="than one division."
^DIC(9.4,3,22,21,"PAH",142,1,8,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,9,0)="This patch updates the EDIT AN EXISTING USER form.  This form was also"
^DIC(9.4,3,22,21,"PAH",142,1,10,0)="changed by patch XU*8*134 (Name Standardization)"
^DIC(9.4,3,22,21,"PAH",142,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,12,0)="This patch also provides support for the Broker User Info properties."
^DIC(9.4,3,22,21,"PAH",142,1,13,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,14,0)="MIW-0500-42196 XUS1   Patch XU*8*165 broke the auto sign-in (single sign-in)."
^DIC(9.4,3,22,21,"PAH",142,1,15,0)="                      The routine was already in this patch so the fix was"
^DIC(9.4,3,22,21,"PAH",142,1,16,0)="                      added to the routine."
^DIC(9.4,3,22,21,"PAH",142,1,17,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,18,0)="Blood Bank Team Coordination:"
^DIC(9.4,3,22,21,"PAH",142,1,19,0)="============================="
^DIC(9.4,3,22,21,"PAH",142,1,20,0)="Clearance - August 17,2000"
^DIC(9.4,3,22,21,"PAH",142,1,21,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,22,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",142,1,23,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",142,1,24,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",142,1,25,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",142,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",142,1,27,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",142,1,28,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",142,1,29,0)="XUS1         10540362  10615522    **9,59,111,165,150**"
^DIC(9.4,3,22,21,"PAH",142,1,30,0)="XUSER         1616062   2107735    **75,97,99,150**"
^DIC(9.4,3,22,21,"PAH",142,1,31,0)="XUSRB         6041270   6120921    **11,16,28,32,59,70,82,109,115,165,150**"
^DIC(9.4,3,22,21,"PAH",142,1,32,0)="XUSRB2         783689   1351749    **115,150**"
^DIC(9.4,3,22,21,"PAH",142,1,33,0)="XUSRB4            n/a   1401530    **150**"
